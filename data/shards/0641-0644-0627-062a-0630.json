{"poems":[[37,"أأطلال دار من سعاد بيلبن","https://www.aldiwan.net/poem38818.html","الطويل"],[37,"عجبت لبرئي منك يا عز بعدما","https://www.aldiwan.net/poem39170.html","الطويل"],[53,"أبا حسن إن حبل المطال","https://www.aldiwan.net/poem62909.html","المتقارب"],[72,"أأرحل من مصر وطيب نعيمها","https://www.aldiwan.net/poem42799.html","الطويل"],[64,"تصدى وللحي الجميع رحيل","https://www.aldiwan.net/poem52316.html","الطويل"],[47,"متى لاح برق أو بدا طلل قفر","https://www.aldiwan.net/poem63556.html","الطويل"],[63,"هي الدنيا وزينتها الشباب","https://www.aldiwan.net/poem51797.html","الوافر"],[71,"لي بالمعرة شمس","https://www.aldiwan.net/poem29113.html","المجتث"],[71,"وعادت دمشق فوق ما كان حسنها","https://www.aldiwan.net/poem29224.html","الطويل"],[69,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29347","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[111,"تهد العمر رائعة المنون","https://www.poetsgate.com/ViewPoem.aspx?id=523",""],[139,"نعم أذكرتني حين هبت صبا نجد","https://www.aldiwan.net/poem49118.html","الطويل"],[164,"قوامك مثل معتدل القناة","https://www.aldiwan.net/poem59052.html","الوافر"],[215,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[253,"خليلي لوما في الصناعة او ذرا","https://www.aldiwan.net/poem1321.html",""],[276,"هي العيس نوليها الحنين فتسعد","https://www.aldiwan.net/poem52091.html","البسيط"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[358,"علام فدتك النفس تجفو وتهجر","https://www.aldiwan.net/poem40348.html","الطويل"],[368,"تأوبني هم مع الليل منصب","https://www.aldiwan.net/poem1719.html","الطويل"],[369,"بما عن من شكوى زمان تعرضا","https://www.aldiwan.net/poem60860.html","الطويل"],[371,"رضيت به مولى ولم يرضني عبدا","https://www.aldiwan.net/poem17188.html","الطويل"],[371,"تقول وحادي الفقر يزعج مرقدي","https://www.aldiwan.net/poem17309.html","الطويل"],[371,"قضى نحبه الصوم بعد المطال","https://www.aldiwan.net/poem17310.html","المتقارب"],[463,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[469,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[469,"ما سرت عن جلق أبغي البديل بها","https://www.aldiwan.net/poem3222.html","عموديه"],[487,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[556,"على مثل هذا اليوم تحنى الرواجب","https://www.aldiwan.net/poem48099.html","الطويل"],[2071,"","https://poetry.dctabudhabi.ae/diwan/poem/122420","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109342","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53181","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27602","البسيط"],[2820,"","https://poetry.dctabudhabi.ae/diwan/poem/29524","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132699","الطويل"],[3341,"","https://poetry.dctabudhabi.ae/diwan/poem/139075",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45773","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91293","الطويل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76447","المتقارب"],[3961,"","https://poetry.dctabudhabi.ae/diwan/poem/198338","الطويل"],[4684,"غرور قط","https://www.poetsgate.com/ViewPoem.aspx?id=201489",""],[5431,"فلا تُذهبِ الأيام لهوا ومتعة","https://www.poetsgate.com/ViewPoem.aspx?id=188654",""],[5596,"سمائل المذهلة","https://www.poetsgate.com/ViewPoem.aspx?id=206486",""],[5727,"وداع","https://www.poetsgate.com/ViewPoem.aspx?id=206473",""],[6068,"يعذلني أناس في هواها -07-","https://www.poetsgate.com/ViewPoem.aspx?id=175894",""],[463,"أدمعكَ أمْ عارضٌ ممطرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60076&r=&rc=132",""]],"verses":[["فَلا تُذكِراهُ الحاجِبِيَّةَ إِنَّهُ","مَتى تُذكِراهُ الحاجِبِيَّةَ يَحزَنِ",0,"ن",1,0],["فَلا تَذاكُرا عِندي عُقَيبةَ إِنني","تَبينُ إِذا بَانَت عُقَيبَةُ روحي",1,"ح",2,0],["فلا تذهبن إلى هذه","فلستَ لعقليَ بالقامر",2,"ر",1,0],["فَلا تَذكُروها لِلنَسيمِ فَإِنَّهُ","لِأَمثالِها مِن نَفحَةِ الرَوضِ سارِقُ",3,"ق",1,0],["فلا تُذْعِنَنْ للخطبِ آدكَ ثِقلُهُ","فمِثلُكَ للأمرِ العظيم حَمُولُ",4,"ل",1,0],["فَلا تَذكُرا عَهدَ التَصابي فَإِنَّهُ","تَقَضّى وَلَم نَشعُر بِهِ ذَلِكَ العَصرُ",5,"ر",1,0],["فلا تذهَبْ بك الأطماعُ واذهِبْ","كؤوسكَ لي فقد حانَ الذَّهابُ",6,"ب",1,0],["فلا تذمُّوه إني","أدرى بشمسِ بلادي",7,"ي",1,0],["فلا تذكروا عندي معابدَ دينكُمْ","فما قصباتُ السَّبْقِ إلاّ لمعبدي",8,"د",2,0],["فلا تَذْكُرُوا ما كانَ بالأمْسِ منهمُ","فذاكَ لأَحْقادِ السُّيُوفِ مُثِيرُ",9,"ر",1,0],["فلا تذكرنه بعدها لا تجرعت","عجوزك إلا أدمعا بعد أدمع",10,"ع",1,0],["فلا تذكري فنَّ هذا الفتى","بل الحيوانيةَ الخاسئهْ",11,"ه",1,0],["فلا تذهب فديتك من خليل","وان أبقيت للحمد الثمين",12,"ن",1,0],["فلا تُذهبنَّ العمرَ من غير طائلٍ","ولا تشغلنَ الفكر في غير ما يجدي",13,"د",2,0],["فلا تذكر ملوكا قد تقضت","بأحقاب مواض سالفات",14,"ت",1,0],["فلا تذكروا نجداً أو الخيف بعدها","تسامت مغانيها عن الخيف أو نجد",15,"د",1,0],["فلا تذكروا عهدى بسخط ولا رضا","تناسيت أو أنسيت ما كان من عهدي",15,"د",2,0],["فلا تذكراها في الملام فانما","يهيج غرامي ان الام وتذكرا",16,"ر",2,0],["فَلا تذكرا يا صاحبي لها الحمى","وَلا جيرة فَلو الغوير فأنجدوا",17,"د",3,0],["فلا تذهب في الحب يشبه مذهبي","ولا ملة فيه تقاس بملتي",18,"ي",1,0],["فَلا تَذكرن أَمراً تَغيَّبَ أَمرُهُ","وَلا تُنكرنَ فَضلاً بِهِ أَنتَ أَخبَرُ",19,"ر",1,0],["فَلا تَذهَبُ الأَحسابُ مِن عُقرِ دارِنا","وَلَكِنَّ أَشباحاً مِنَ المالِ تَذهَبُ",20,"ب",1,0],["فلا تُذْكِراني عَهْدَ نجدٍ وأهلَه","إذا الرّيحُ هَبّتْ أو إذا البرقُ أَوْمضا",21,"ض",2,0],["فَلا تَذكُروا وَفداً عَلى آلِ بَرمَكٍ","فَلَو لَحِقوا ذا الجودَ كانوا لَهُ وَفدا",22,"د",2,0],["فَلا تَذكُرَنَّ الدَهرَ إِلّا بِصالِحٍ","وَإِيّاكُمُ وَالدَهرَ فَالصُلحُ لِلدَهرِ",23,"ر",1,0],["فَلا تَذكُرَنَّ عُهودَ الوِصالِ","فَعَهدي بِها وَاللَيالي لَيالِ",24,"ل",1,0],["فلا تذكرون لقلبي السلو","وَ إن كان ذاك كما يُذكَرُ",25,"ر",1,0],["فلا تذكروا لي ماضياً جلُّ همهٍ","نضيجُ قديدٍ أو شواءٌ ملهوج",26,"ج",1,0],["فلا تذمن ضداً حيث تصحبه","والفضل لولا وجود الضد ما عرفا",27,"ف",2,0],["فلا تذهبن في الذاهبين لأجل أن","تشاجرت الأسماء فهي وفاقيه",28,"ي",2,0],["فَلا تَذكُروا قربى الرّسول لِتدفعوا","مُنازعكم يوماً فنحن الأقاربُ",29,"ب",1,0],["فلا تذكروا ما كان منَّا ومنكُمُ","ففي ذكرِ ما قد كانَ مشيُ التساؤُكِ",30,"ك",1,0],["فلا تذرني كما رام العدى هملا","فحسب قلبي منهم نار اخدود",31,"د",1,0],["فلا تذكر لديه سوى حسام","ورمح أو سماح أو نوال",32,"ل",1,0],["فلا تذّمنّ دهراً لستَ تعرفه","فالدهر من شهدتْ بالملك فطرته",33,"ت",2,0],["فَلا تَذكُر أَباكَ العَبدَ وَاِفخَر","بِأُمٍّ لَستَ مُكرِمَها وَخالِ",34,"ل",1,0],["فلا تذكرا يوم الغدير فبشره","بطول الأسى يوم الفعيلة بدلا",35,"ل",2,0],["فلا تذكر صحابته بسوء","ودع ما قد جرى ودع السؤالا",36,"ل",2,0],["فَلا تَذكروا لي ما حَوى ملك تَبع","وَما أَحرزاه عَبد شَمس وَحَمير",37,"ر",1,0],["فلا تذكرا لي دُون قَصدي مخاوفاً","فَمن عُوِّدَ الأَهوالَ يَلقى الدمادما",38,"م",2,0],["فَلا تَذبَلي غصن أَيامه","بحجرك غضا ألا فاحذري",39,"ر",2,0],["فلا تذكرنهم بالسؤال مصابهم","فإن حياة الرّزء أن يتذكّرا",40,"ر",2,0],["فلا تذر الحزين يعيش (يكّاً)","وصل يا خلّ تكتمل (الدّبارة )",41,"ر",2,0],["فلا تُذهبِ الأيام لهوا ومتعة","فما فاز بالفردوس من كان لاهيا",42,"ي",2,0],["فلا تذهل ب( مذهلة ) عروس","جلوت جمالها الضافي لُبابا",43,"ب",2,0],["فلا تذكرْ بِغيرِ الشوقِ وجهِي","صَدُوقُ الحبِّ تُبْكِيهِ الطُّلولُ",44,"ل",1,0],["فلا تذهب بعيدا عن حماها","حمى سوريّة أهوى رباها",45,"ا",3,0],["فلا تذكرونَ لقلبي السُّلوَّ","إنْ كانَ ذاكَ كما يذكرُ",46,"ر",1,0]]}