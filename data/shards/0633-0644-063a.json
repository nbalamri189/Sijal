{"poems":[[259,"قلب معذب","https://www.aldiwan.net/poem36216.html","مجزوء الرمل"],[556,"قل لعيني لا تملا الدموعا","https://www.aldiwan.net/poem47711.html","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53120","الكامل"],[3187,"","https://poetry.dctabudhabi.ae/diwan/poem/138775",""],[3886,"","https://poetry.dctabudhabi.ae/diwan/poem/130556","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66156","الرمل"],[3271,"في وادي النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=103534",""],[6196,"موعدُ العمرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83044&r=&rc=0",""]],"verses":[["سَلْ غريمي كم دموعٍ","لم تصحح ما أساء",0,"ا",2,0],["سلِّ غيري فليس كلُّ جَزوعٍ","عضّه الرُّزءُ كان مثلي جَزوعا",1,"ع",2,0],["سل غير وَانٍ عنه وَانَ وخيله","تحت السوابغ داميات الأنسر",2,"ر",1,0],["سَل غالباً ما بالُ غلبِ كُماتِها","ذّلت وليس الذُّلّ من عاداتِها",3,"ت",3,1],["سل غارب الرمح المثقف ان ترم","عن عزمتي خبرا وحدّ حسامي",4,"م",2,0],["سَلْ غَرامي والهَوَى سَلْ مَدْمَعِي","سَلْ جَوىً احْرَقَ حَباتِ الفاادْ",5,"د",1,0],["سلْ غادة اليابان كيفَ أهاجها","في الروع عن ضافي الثياب تُشمّرُ",6,"ر",1,0],["سَلْ غُربةَ القلبِ هل يبقى الزّمانُ بِنا","أفقاً تبعثَرَ في أشتاتِهِ الشَّفَقُ؟",7,"ق",1,0]]}