],[90,"الزهَاوي","https://www.poetsgate.com/ViewPoem.aspx?id=179155",""],[90,"عقابيل داء","https://www.poetsgate.com/ViewPoem.aspx?id=179142",""],[54,"فأيرُ عليِّ له ألة ٌ","https://www.poetsgate.com/ViewPoem.aspx?id=13986",""],[54,"لَئِنْ كُنتَ لا تُولي يداً دُونَ إِمْرة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=14285",""],[45,"متى تَسألي عَن عَهْدِهِ تَجِدِيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31643",""],[45,"ألما يكف في طللي زرود","https://www.poetsgate.com/ViewPoem.aspx?id=31622",""],[45,"بَاتَ عَهْدُ الصّبَا وَباقي جَديدِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31632",""],[91,"شاعر الشهور","https://www.poetsgate.com/ViewPoem.aspx?id=53070",""],[91,"فقيد الوطنية","https://www.poetsgate.com/ViewPoem.aspx?id=52964",""],[35,"على خالدٍ أصبحتُ أبكي لخالدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=22136",""],[28,"كم من مناد والشريفان دونه","https://www.poetsgate.com/ViewPoem.aspx?id=21089",""],[28,"جزى الله عني في الأمور مجاشعا","https://www.poetsgate.com/ViewPoem.aspx?id=2461",""],[51,"يا رجلاً أوفى على كلُّ رجلْ","https://www.poetsgate.com/ViewPoem.aspx?id=30258",""],[51,"ما أنس لا أنس هنداً آخر الحقبِ","https://www.poetsgate.com/ViewPoem.aspx?id=26853",""],[12,"أقيموا بني أمي صدورَ مطيَّكمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=8986&r=&rc=0",""],[105,"أكل متوجٍ يحمي البلادا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54885&r=&rc=55",""],[31,"طربتَ، وردّ من تهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18895&r=&rc=158",""],[31,"إحرجي وتأثمي،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19045&r=&rc=308",""],[88,"اذا شئت ان تسرى بكافرة الصوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19534&r=&rc=37",""],[66,"تَوِسّدَ في الفَلا أيدي المَطايا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19705&r=&rc=10",""]],"verses":[["فَأَينَ مِنَ الداءِ إِفراقُهُ","وَأَينَ مِنَ القَلبِ سُلوانُهُ",0,"ن",2,0],["فَأَينَ تَسَرُّعُهُ لِلنِضالِ","وهَبّاتُهُ لِلطِوالِ اللِدانِ",1,"ن",1,0],["فَأَينَ مِنَ الدَهرِ اِستِماعُ ظُلامَتي","إِذا نُظِرَت أَيّامُهُ في المَظالِمِ",2,"م",1,0],["فَأَيُّ مُنىً لَم يَسُمها نَوالي","وَأَيُّ عُلىً لَم يَطَأها اِعتِزامي",3,"م",2,0],["فَأَينَ كَموسى وَالرِماحُ شَوارِعٌ","إِلى الطَعنِ وَالبيضُ الرِقاقُ تَجولُ",4,"ل",1,0],["فَأَيُّ حَياً بِأَرضِكِ لِلغَوادي","وَأَيُّ بِلىً بِرَبعِكِ لِلَّيالي",5,"ي",1,0],["فَأَينَ رُخمُ الرِقابِ الغُلبِ رافِعَةً","دونَ العُلى وَقِراعُ الأَذرُعِ الفُتُلِ",6,"ل",1,0],["فَأَينَ المُلوكُ الأَقدَمونَ تَسانَدوا","إِلى جِذمِ أَحسابٍ كِرامِ المَعارِقِ",7,"ق",1,0],["فَأَينَ قِوامُ الدينِ لِلخَطبِ يَعتَري","وَلِلدَهرِ يَغدو بِالأَذى وَيَروعُ",8,"ع",1,0],["فَأَينَ بَنو أُمَّ المَكارِمِ وَالنَدى","وَآلُ الجِيادِ الغُرِّ وَالجامِلِ الدَثرِ",9,"ر",1,0],["فَأَينَ الجِيادُ المُلجَماتُ عَلى الوَحى","سِراعاً إِلى نَقعِ الصَريخِ المُنَدَّدِ",10,"د",1,0],["فَأَينَ مُلوكُنا الماضونَ قِدماً","أَعَدّوا لِلنَوائِبِ وَاِستَعَدّوا",11,"د",3,0],["فَأَينَ مُسابِقُ الأَجالِ طَعناً","يَعودُ وَرُمحُهُ رَيّانُ وَردُ",11,"د",1,0],["فَأَينَ كُفاةُ القُطرِ في كُلِّ أَزمَةٍ","وَأَينَ المَلاجي مِنهُمُ وَالمَغاوِثُ",12,"ث",1,0],["فَأَينَ النُفوسُ الآبِياتُ مُليحَةً","مِنَ الضَيمِ وَالأَيدي الطِوالُ الغَوالِبُ",13,"ب",1,0],["فَأَينَ الفَيالِقُ مَجرورَةً","وَقَد عَضَّلَ اللَقَمُ اللاحِبُ",14,"ب",1,0],["فَأَينَ الظِّباءُ العِينُ وَالرَّشأُ الَّذي","يُلاعِبُها طَوراً وَطوراً تُلاعِبُهْ",15,"ب",2,0],["فأَيُّنا أَظهَرُ سُكرا وَما","عاثَتْ يَدٌ فينا بِأَقداحِ",16,"ح",1,0],["فإِيهاً بَني الإِسلامِ إِنَّ وَراءَكُم","وَقائِعَ يُلحِقنَ الذُّرا بِالمَناسِمِ",17,"م",1,0],["فَأَيْنَ مِثْلُ أَبي في العُرْبِ قاطِبَةً","وَمَنْ كَخاليَ في صُيّابَةِ الَعَجِم",18,"م",1,0],["فَأَيَّ أَرْوَعَ مِنّي نَبَهَّتْ هِمَمي","وَأَيَّ شَأْوٍ مِنَ العَلْياءِ أَلْتَمسُ",19,"س",1,0],["فَأَيَّ لِئامٍ كُنْتُمُ في رِعايَتي","وَأَيَّ كَريمٍ في الجَزاءِ أَكونُ",20,"ن",1,0],["فأينَ الخِيامُ التي ظُلِّلَتْ","بسُمْرٍ أُلاحِظُ فيها المَنُونا",21,"ن",2,0],["فإيهٍ أبا الشّدّادِ إنّ وراءَنا","أحاديثَ تُرْوى بَعْدَنا في المَعاشِرِ",22,"ر",1,0],["فأينَ الجِيادُ الجُرْدُ تَخْطو إِلى العِدا","على عَلَقٍ تَرْوَى بهِ الأرضُ مائِرِ",22,"ر",1,0],["فأينَ ومِثلي لا يَغُشُّكَ ماجِدٌ","نَصولُ بهِ كالعَضْبِ مُحتَضِناً عَضْبا",23,"ب",2,0],["فأيّامُكَ الخُضْرُ الحَواشي كأنّها","منَ الحُسْنِ تَفْويفُ الرِّداءِ المُسَهَّمِ",24,"م",1,0],["فأيُّ مكانٍ ليس يصلح مسلخ","وكل مكانٍ، ربما بات مدبغا؟",25,"غ",2,0],["فأيْمِنْ بمَشْحونٍ منَ الفُلْكِ سابِحٍ","لهُ باخْتيارِ اللهِ حطٌّ وإيساقُ",26,"ق",1,0],["فأيُّ اصْطبار لمْ تُحَلَّ عُقودُه","وأيّ فؤادٍ بعْدُ لمْ يتصدّعِ",27,"ع",1,0],["فَأَيُّ دَيْرٍ بِغَيْرِ غَيْر","وَأَيْنُّ خَمْرٍ بِلاَ دِنَانِ",28,"ن",1,0],["فأيْقَظَهُ قلْبٌ خَفوقٌ ومُقْلَةٌ","تَجودُ بدُرٍّ ذائِبٍ غيرِ جامِدِ",29,"د",1,0],["فَإِيّاكَ وَالمَيتاتِ لا تَأكُلَنَّها","وَلا تَأخُذَن سَهماً حَديداً لِتَفصِدا",30,"د",2,0],["فَأَيَّةَ أَرضٍ لا أَتَيتُ سَراتَها","وَأَيَّةُ أَرضٍ لَم أَجُبها بِمَرحَلِ",31,"ل",1,0],["فَأَيَّ فَلاحِ الدَهرِ يَرجو سَراتُنا","إِذا نَحنُ فيما نابَ لَم نَتَفَضَّلِ",31,"ل",1,0],["فَأَياديهِ إِذا ما أُنكِرَت","إِنَّما تُنكِرُها عَينُ الحَسَد",32,"د",1,0],["فَأَينَ كانَ الشَآمِيّونَ كانَ لَها","عَيشٌ جَديدٌ وَفَضلٌ لَيسَ يَحتَجِبُ",33,"ب",1,0],["فَأَيادي مُبارِزُ الدينِ أَدنى","لِثَرائي وَعَزمُهُ لانتِصاري",34,"ي",1,0],["فَأَينَ ثَناءٌ يَهرَمُ الدَهرُ كِبرَةً","وَحِليَتُهُ في الغابِرينَ شَبابُ",35,"ب",1,0],["فَأَينَ الَّذي كانَت مَعَدٌّ تَنوبُهُ","وَيَحتَمِلُ الأَعباءَ ثُمَّ يَقولُها",36,"ل",3,0],["فَأَيُّنَا قَابَلَ النُّعْمَى بِسَيِّئَةٍ","فَإِنَّنَا مُلْزِمُوهُ أَنْكَرَ الْحُرَمِ",37,"م",1,0],["فَأَيُّهُمُ الزَينُ وَسطَ المَلا","عَطِيَّةُ أَم صالِحُ الأَحوَلُ",38,"ل",1,0],["فَأَيُّ إِناءٍ لَم يَفِض عِندَ مَلئِهِ","وَأَيُّ بَخيلٍ لَم يُنِل ساعَةَ الوَفرِ",39,"ر",1,0],["فَأَيرُ عَلِيٍّ لَهُ آلَةٌ","وَفَقحَةُ عَمرٍ لَهُ دَبَّه",40,"ه",1,1],["فَأَيقَنتُ أَن البَينَ قَد جَدَّ جِدُّهُ","وَأَنَّ الَّتي أَرجو مِنَ الحَيّ لا هيا",41,"ي",2,0],["فَأَيقَنَ قَلبي أَنَّني تابِعٌ أَبي","وَغائِلَتي غَولُ القُرونِ الأَوائِلِ",42,"ل",1,0],["فاياك أن تغير فيهم فكلهم","يجرّ إلى قرصيه نار المواقد",43,"د",1,0],["فأين أباة الضيم من آل يعرب","ألم يأتِ منهم ناصرٌ ومُعين",44,"ن",1,0],["فأيّان جان الطرف لم يَرْءَ غيره","إذا كان في ألحاظه غير مبلِس",45,"س",1,0],["فأيّ اعتقادٍ مانعٌ من أخوّة","بها قال أنجيل كما قال قرآن",46,"ن",1,0],["فَإِيّاكَ لا تَبدُر إِلَيكَ قَصيدَةٌ","تُغَنّي بِها الرُكبانُ في الغَربِ وَالشَرقِ",47,"ق",1,0],["فَأَيهاتَ أَيهاتَ العَقيقُ وَمَن بِهِ","وَأَيهاتَ وَصلٌ بِالعَقيقِ تُواصِلُه",48,"ل",2,0],["فَأَينَ بَنو القَعقاعِ عَن ذَودِ فَرتَنى","وَعَن أَصلِ ذاكَ القِنِّ أَن يَتَقَسَّما",49,"م",2,0],["فَأَيَّ أَوانٍ لا تَجِئني مَنِيَّتي","بِقَصدٍ مِنَ المَعروفِ لا أَتَعَجَّبِ",50,"ب",1,0],["فأية أرحام يُعاذُ بفضلها","وأيةُ أرحام يؤدى نصيبها",51,"ب",3,0],["فأين بلاء الدين عنا وعنكم","لكل أكف حاقِنات ضريبها",51,"ب",3,0],["فأين سواكم أين لا أين مذهب","وهل ليلة قَمْراء ناجٍ طليبُها",51,"ب",3,0],["فأي مزور نحن أم أي زائر","إذا الكُوم باءت بالرذية والرهْبِ",52,"ب",1,1],["فأيَّ فتى دين ودنيا تلمست","بدَبْر حَنِيناء المنايا فدُلتِ",53,"ت",1,0],["فأي أمرىء أنت أي أمرىء","إذا الزجر لم يستدر الزجورا",54,"ر",2,1],["فإياكم وداهية نآدى","أظلتكم بعارضها المُخيلِ",55,"ل",1,1],["فإياكم وداهية نآدى","نجد بها وأنتم تلعبونا",56,"ن",2,1],["فأيَّا ما يكنْ يكُ هو منا","بايْدٍ ما وَبَطْنَ وما يدينا",57,"ن",2,1],["فأي عمارة كالحي بكر","إذا اللزبات لقبت السنينا",58,"ن",2,0],["فَأيا ما يَكُن يَكُ وَهُوَ مِنَّا","بِأيد ما وَبَطنَ وَمَا يَدِينَا",59,"ن",2,0],["فأيّ فتىً لاقَت شَعُوبُ ومَدرَةٍ","وأيّ هِزَبرٍ في فليبِكَ دَلّتِ",60,"ت",1,0],["فَأَيقَنتُ أَن لاعِزَّ بَعدي لِعاشِقٍ","وَأَنَّ يَدي مِمّا عَلِقتُ بِهِ صِفرُ",61,"ر",1,0],["فأيَّ فخارٍ أوَّل لا يجده","وأيَّ فخارٍ آخر لا يجيده",62,"د",2,0],["فأيامك الأعياد عائدةٌ لمن","رَجاك ومنْ عاداك بالفطر والنحر",63,"ر",1,0],["فأيقنت الورى خصباً وقالوا","وقوع الغيث من خصب الزمان",64,"ن",1,0],["فَأَينَ ذاتُكَ عَنّي حَيثُ كُنتُ أرى","فَقَد تَبَيَّنَ ذاتي حَيثُ لا أَيني",65,"ن",2,0],["فَأَينَ وَجهُكَ مَقصوداً بِناظِرَتي","في باطِنِ القَلبِ أَم في ناظِرِ العَينِ",65,"ن",1,0],["فأيُّ عدلٍ وفَضْلٍ في قضيته","إذا تجاثَى بنو الجُلَّى على الرُّكبِ",66,"ب",1,0],["فأيسرُ إشفاقي من الماء أنني","أمرُّ به في الكوز مرَّ المُجانبِ",67,"ب",1,0],["فأيَّةَ دارٍ للعدا شاء جَاسَها","وأيةَ أرضٍ للعدا شاء دَوّخا",68,"خ",2,0],["فائزاً قِدْحُه على حاسديه","ظاهراً حقُّه على جُحَّادِهْ",69,"د",2,0],["فأين هُبلتَ تهرب من هجائي","وأين هبلتَ تهرب من قصيدي",70,"د",2,0],["فأين محمد أم أين عيسى","أليسا مثلهم تحت الصعيدِ",70,"د",1,0],["فأيَّةُ آياتي وأيُّ أدلّتي","تدل على التخنيث يا ابن أبي عمرو",71,"ر",2,0],["فأي قِرىً تَقرِي الليالي ضيوفَها","وقد عَطلت ما عَطَّلتْ من عِشاره",72,"ر",2,0],["فأيُّ أموالكَ لم تعطنا","وأي أنوارِك لم تُقبس",73,"س",1,0],["فأيها المُلْقي عليَّ الأحْلُسا","شمسُ الضُّحى أبرعُ من أن تُطْمسا",74,"س",2,0],["فأينَ لي عنكَ أقلني أو فقل","حمّلتني ما ليس في وسعِ البُزُل",75,"ل",1,0],["فأيقنَ كلُّنا أنْ سوفَ تحمي","جُرامتَها بشوكتها النخيل",76,"ل",1,0],["فأين منك الحياءُ قل لي","يا كلبُ والكلب لا يقولُ",77,"ل",1,0],["فَإِيّاكَ لا أَقذِفكَ وَيحَكَ إِنَّني","أَصُكُّ بِصَخرٍ في رُؤوسِ صِمادِ",78,"د",1,0],["فَأَيُّ شَيءٍ تَشتاقُ فيهِ","فَقُلتُ ما سَرَّني وَساء",79,"ا",2,0],["فَأَيقَظَتها مِن رَقدَةٍ بَعدَ رَقدَةٍ","وَأَنهَضَتها مِن كَبوَةٍ تِلوَ كَبوَةِ",80,"ه",1,0],["فَأَينَما سِرتُ صَوتُ بُشرى","وَكَيفَما مِلُ طَيفُ نورِ",81,"ر",1,0],["فَأَينَ شِعرُكَ يَسري مَع نَسائِمِهِ","وَأَينَ سِحرُكَ يَجري في سَواقيهِ",82,"ي",2,0],["فَأَينَ حَلاواتُ الرَسائِلِ بَينَنا","وَأَينَ أَماراتُ المَحَبَّةِ وَالوُدِّ",83,"د",1,0],["فَأَيَّمتُ نِسواناً وَأَيتَمتُ آلَدَةً","وَعُدتُ كَما أَبدَأتُ وَاللَيلُ أَليَلُ",84,"ل",1,0],["فأيّ غِنَاءٍ لهذي الحياة","وهذا الصِّراعِ العنيفِ الشَّديدْ",85,"د",1,0],["فأَيْنَ الأَماني وأَلْحانُها","وأَينَ الكؤوسُ وأَينَ الشَّرابْ",86,"ب",1,0],["فَأَيُّ مَعَدٍّ كانَ فَيءَ رِماحِهِم","كَما قَد أَفَأنا وَالمُفاخِرُ يُنصِفُ",87,"ف",1,0],["فَأَيُّ فُؤادٍ لا يَذوبُ لِما أَرى","وَأَيُّ عُيونٍ لا تَجودُ فَتَدمَعُ",88,"ع",1,0],["فأين مضى القوم الألى أَرهفوا الظبى","وأين تولى قائدو الضمَّر القبِّ",89,"ب",1,0],["فأين رجال فيك كانوا مشائخاً","إليهم يحث الطالبون النواجيا",90,"ي",2,0],["فأين روبرس منه إذ ييمها","وأين سيمور منه إذ يوافيها",91,"ي",3,0],["فَإيهٍ يا بَناتِ الشِعرِ إ