{"poems":[[53,"قلت لقوم سادة قادة","https://www.aldiwan.net/poem62869.html","السريع"],[53,"مسقم عن سقم جفن","https://www.aldiwan.net/poem66696.html","مجزوء الرمل"],[51,"مؤنس كان لي هلك","https://www.aldiwan.net/poem64267.html","مجزوء الخفيف"],[82,"إلى متى منكم هجري وإقصائي","https://www.aldiwan.net/poem31577.html","البسيط"],[54,"يا إمام الهدى ويا أحكم الناس","https://www.aldiwan.net/poem27265.html","الخفيف"],[82,"إلى متى منكمُ هجري وإقصائي","https://www.poetsgate.com/ViewPoem.aspx?id=2931",""],[214,"علقته أسمرا حلو القوام وكم","https://www.aldiwan.net/poem13563.html","البسيط"],[240,"مدحك لا يستطيعه البشر","https://www.aldiwan.net/poem32019.html","المنسرح"],[259,"لا تلمني","https://www.aldiwan.net/poem24962.html","مجزوء الرمل"],[259,"ظالم يامن قلاني","https://www.aldiwan.net/poem36221.html","مجزوء الرمل"],[276,"ألف التذكر مبدئا ومعيدا","https://www.aldiwan.net/poem52063.html","الكامل"],[353,"لست أنسى لمشيبي","https://www.aldiwan.net/poem20101.html","مجزوء الرمل"],[422,"رمى ولم يرم عن قوس ولا وتر","https://www.aldiwan.net/poem54110.html","البسيط"],[463,"لعل الركب أن خلصوا نجيا","https://www.aldiwan.net/poem55813.html","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63912","السريع"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102285","المنسرح"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77305","الرمل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45580","الخفيف"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65974","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94256","الطويل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101234","الخفيف"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104893","البسيط"],[4691,"مُؤنثَة ٌ أحْلامُهُ ومُذَكّرَة ْ","https://www.poetsgate.com/ViewPoem.aspx?id=125543",""],[4578,"قد زف كأس التهاني بالصفا وسعى","https://www.poetsgate.com/ViewPoem.aspx?id=49470",""],[5725,"لاتنر لي ايها البدر طريقا","https://www.poetsgate.com/ViewPoem.aspx?id=179413",""]],"verses":[["مؤنَّثي الخَلْق لهم أعينٌ","دلالُها بادٍ وتفتيرها",0,"ر",3,0],["مُؤْنِسي في كل حالٍ","مُسعِدي في كل فَنّ",1,"ن",1,0],["مُؤنِسٌ كانَ لي هَلَك","وَالسَبيلُ الَّتي سَلَك",2,"ك",1,1],["مُؤنِّبي في رَصينِ الحلم حين هَفَا","لم يَهْفُ حلميَ إلّا عند هيفاءِ",3,"ا",2,0],["مُؤنِسٌ يَومَ لَذَّةٍ وَنَديمٌ","وَهوَ في حَومَةِ الوَغى لَيثُ غابِ",4,"ب",1,0],["مُؤْنِبِي في رصينِ الحلم حين هَفَا","لم يهتف حلمي إلا عند هيفاء",5,"ا",2,0],["مؤنث الجفن الا ان مقلته","تزري اذا ما رنت بالصارم الذكر",6,"ر",1,0],["مُؤَنَّثِ الزِيِّ في لَواحِظِهِ","مِن غُنجِ عَينيهِ صارِمٌ ذَكَرُ",7,"ر",1,0],["مُؤْنِسي في وحدتي يا","رَبِّ بي حَقِّقْ مناهُ",8,"ا",2,0],["مؤنسي في الود، أسرعْ","منك وجْدٌ، اعتراني",9,"ن",2,0],["مَونلاي جئتك وَالخطوب وَجوهها","سود وَلَولا الفقر لمتك سودا",10,"د",2,0],["مُؤْنِسي بَاقيَ عُمْرِي","وَضَجِيعي عِنْدَ لَحْدِي",11,"ي",1,0],["مؤنَّث الطَّرف ما زالت لواحظه","تسطو وتفتك فتك الصَّارم الذكر",12,"ر",1,0],["مؤنّثةُ الثرى والماءُ يُعدِي","بحسن طباعها القدرَ الجريَّا",13,"ي",2,0],["مُؤنِّبي في وَصْفِ عبّاسِ","أنَّبتَ فيه أوصفَ الناس",14,"س",1,1],["مؤنث بذي كعين عبلى","نجلاء حرّة حماة حبلى",15,"ل",2,0],["مؤنث الدل كاسر جفنه الس","ساجي على نصل صارم ذكر",16,"ر",1,0],["مَوِّن الأَوقافَ أَشبع جوعَها","إِنَّها مِن حِقبَةٍ لَم تَأكُلِ",17,"ل",1,0],["مؤنِساً ربعه بِطول أَنيني","وَهُوَ لي موحش بِطول السُكوتِ",18,"ت",1,0],["مؤنتها عند الاله ومهرها","ومنها تحوز الحور حور الأرائك",19,"ك",1,0],["مؤنة شهر الصوم خفت واثقلت","بما حملته من متاعها متنى",20,"ن",2,1],["مؤنسي العلم والكتاب الجليس","لم يرقني من الأنام انيس",21,"س",1,1],["مؤنث الطرف منك أمضى","شبا من الصارم المذكر",22,"ر",1,0],["مؤنثة أحلامه ومذكرة","تزاوجها الأشعار في عرس محبرة",23,"ر",2,1],["مؤنث اللحظ والألفاظ ذكرني","عهد النواسي في ما سن وابتدعا",24,"ع",2,0],["مؤنس العشاق رفقا لاتطل","قد انسْنا غيرك اليوم عشيقا",25,"ق",2,0]]}