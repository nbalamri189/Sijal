{"poems":[[108,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[266,"متى يستفيق الدهر من غفلانه","https://www.aldiwan.net/poem38140.html","الطويل"],[275,"أغنى التقى عن برقع وخباء","https://www.aldiwan.net/poem35588.html","الكامل"],[303,"لو رأيت الكأس والوجه الصبيحا","https://www.aldiwan.net/poem36853.html","عموديه"],[457,"صح واني نسيمنا باعتلاله","https://www.aldiwan.net/poem13878.html","الخفيف"],[484,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[556,"سائل بيثرب هل ثوى الركب","https://www.aldiwan.net/poem48101.html","أحذ الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80219","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126914","الخفيف"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61278","الكامل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118768","الرمل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29272","الرمل"],[4259,"","https://poetry.dctabudhabi.ae/diwan/poem/145346","الكامل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146753","الخفيف"],[4966,"أبى","https://www.poetsgate.com/ViewPoem.aspx?id=196967",""],[5185,"المزار ( إلى إيما )","https://www.poetsgate.com/ViewPoem.aspx?id=118746",""],[5491,"معنى البطولة","https://www.poetsgate.com/ViewPoem.aspx?id=197209",""],[5582,"هَلْ مِنْ مُجِيدٍ لِي بِأَنْباءِ","https://www.poetsgate.com/ViewPoem.aspx?id=186648",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5770,"الفجر موعده اقترب","https://www.poetsgate.com/ViewPoem.aspx?id=178700",""],[5956,"قررتُ معها أن أستقرَّ","https://www.poetsgate.com/ViewPoem.aspx?id=182055",""],[6035,"كارِهة.. ! .","https://www.poetsgate.com/ViewPoem.aspx?id=174226",""],[5190,"للأرض وجهٌ آخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78324&r=&rc=37",""]],"verses":[["وإلى فَلسطينَ الشهيد","ةِ قَدْ أشَارُوا من بعيد",0,"د",1,0],["والى فقدت الصبر فيه ولا فتى","من الدهر صبار على فتكاته",1,"ت",2,0],["وإلى فرنسا احمِل شكاوى أُمَّتي","فنفوسُنا يَئست من البرحاء",2,"ا",2,0],["وَأَليفينِ كما شاءَ الهوى","وَالصِبا جُنَّتْ به حباً وَجُنْ",3,"ن",1,0],["وإِلى فكرتي التبدُّه والتمليط","في الشعر مَعْ صحيح ارتجالِه",4,"ل",2,0],["وإلى فرنسا بالخصوص عداوة","لك ما رأوا للود منك نسيما",5,"م",2,0],["وَإِلى فَخارِ المُلكِ أُصدِرُها","كَلِماً تَسيرُ بِذِكرِها الكُتْبُ",6,"ب",1,0],["وَاليفَتي مِن سَخطِهِ","جَفلى تَحاذرى أَرقَما",7,"م",2,0],["وأليف العلا ومذ فقدته","فهي شجوا تنوح كالورقاء",8,"ا",2,0],["وَأَليفِ غصنٍ لا يُفارقُه","صبُّ الفُؤاد بِهِ متيَّمُهُ",9,"م",2,1],["وإلى فيصلَ عبدُ الله أهدا","نيَ والتاريخ تذكارٌ بهيج",10,"ج",1,0],["وَأَليفٌ سامَرَ اللَيلَ عَلى","ذِكرِ عَهدٍ مِن عُهودِ الغائِبين",11,"ن",1,0],["وأليف قلبي شوقه","قد فات إحصائي ألوفه",12,"ف",2,0],["وأليفاي فيك ريا وأروي","وحليفاي فيك زق وكوب",13,"ب",1,0],["وإلى فناءٍ كل شىءٍ سائرٌ","زورٌ هى الدنيا سرابٌ زخرفُ",14,"ف",1,0],["وإلى فِنائكِ تستعد رحالنا","وعلى جداركِ تُكتب الأشعار",15,"ر",1,0],["وإلى فلسطينَ الحبيبةِ تنتهي","فينا الدروبُ يؤجُهُنَّ زئيرُ",16,"ر",1,0],["وَإِلَى فَلاحٍ كَمْ قَطَعْتُ وَكَمْ","جاوَزْتُ مِنْ غاياتِ بَيْداءِ",17,"ا",2,0],["وإلى ( فتْح ِاللهِ ) نِعْمَ الفتى الحرُّ","ونِعْمَ المَزارُ ( جَمّاعينُ )",18,"ن",1,0],["وإلى فلسطين التي ان","تفضت ومارت بالغضب",19,"ب",1,0],["وإلى فمي ترمي النظر ‏","فلثمتها وحضنتُها طول العُمُرْ",20,"ر",1,0],["وإلى فؤادك لن أعود حبيبةً","لوْ جئتني مُستغفراً توّابا",21,"ب",2,0],["وإلى فقيرٍ قد يبيتُ على الطِّوى","لكنَّهُ للهِ دوماً شاكرُ",22,"ر",1,0]]}