id=128813",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5431,"فبشرى لك صنعاء بشراكِ في غدٍ...","https://www.poetsgate.com/ViewPoem.aspx?id=197406",""],[5444,"قبلة الأشواق والإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=205445",""],[5459,"نصر وخُسر","https://www.poetsgate.com/ViewPoem.aspx?id=214873",""],[5512,"الأب والبنون ..","https://www.poetsgate.com/ViewPoem.aspx?id=207955",""],[5536,"إهداء إلى كل امرأه ( المطلقه )","https://www.poetsgate.com/ViewPoem.aspx?id=37058",""],[5596,"جامعة نزوى","https://www.poetsgate.com/ViewPoem.aspx?id=206686",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5701,"يا صاحب السيف الذي","https://www.poetsgate.com/ViewPoem.aspx?id=164598",""],[5720,"المعلِّم","https://www.poetsgate.com/ViewPoem.aspx?id=200150",""],[5770,"خمسون عاما","https://www.poetsgate.com/ViewPoem.aspx?id=178689",""],[5771,"شُكرًا","https://www.poetsgate.com/ViewPoem.aspx?id=189157",""],[5771,"وجهٌ ثُلاثيُّ الأوجاع","https://www.poetsgate.com/ViewPoem.aspx?id=189540",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5842,"تَقَبَّلْ دُعائي / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=137917",""],[5845,"لكَ الحمدُ حمداً نستلذُّ به ذكراً","https://www.poetsgate.com/ViewPoem.aspx?id=15449",""],[5894,"كل الحواسد راعوا ما أنا فيه","https://www.poetsgate.com/ViewPoem.aspx?id=131407",""],[5909,"نغماً أراقتْ معدني الأسماءُ","https://www.poetsgate.com/ViewPoem.aspx?id=210236",""],[5937,"لاهوتُ الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=211812",""],[5953,"عاذلتي في الشيب لو تعلم ما","https://www.poetsgate.com/ViewPoem.aspx?id=93807",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[6093,"تَبْعِيْضٌ","https://www.poetsgate.com/ViewPoem.aspx?id=204801",""],[6093,"ذات موصدة","https://www.poetsgate.com/ViewPoem.aspx?id=204990",""],[6106,"ما بين الهجرة والهجمة على سيد الخلق صلى الله عليه","https://www.poetsgate.com/ViewPoem.aspx?id=6303",""],[520,"أعندك ان وجدي واكتئابي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577433",""],[463,"أبلغْ بها أمنية َ الطالبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59982&r=&rc=38",""],[6256,"المعارف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65931&r=&rc=19",""],[5190,"مسافر من زمان العولمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78311&r=&rc=24",""],[572,"ما تَرَى في الصبوحِ أيّدَكَ اللّه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9212&r=&rc=69",""]],"verses":[["وَصَنَعتُمُ فَعَرَفتُ قَدرَ صَنيعِكُم","وَلَرُبَّما غَلِطَ الطَريقَ المُصنِعُ",0,"ع",1,0],["وَصَنَعتُ ما ثَلَمَ الوَقارَ صَنيعُهُ","مِمّا عَراني مِن جَوى البُرحاءِ",1,"ا",2,0],["وَصُنِ اللِّسَانَ عَنِ الْقَبِيحِ فَرُبَّمَا","يَمْضِي اللِّسَانُ بِحَيْثُ يَنْبُو الْمنْصَلُ",2,"ل",1,0],["وَصَنَعتُم صَنَعَ اللَهُ لَكُم","فَوقَ ما يَصنَعُهُ الخِلُّ الأَبَر",3,"ر",1,0],["وَصَنيعَةٍ قَد باتَ غَيرُكَ نائِماً","عَنها وَجَفنُكَ ساهِرٌ ما غَمَّضا",4,"ض",2,0],["وَصِنوَيَّ لا أَنسى مُعاوِيَةَ الَّذي","لَهُ مِن سَراةِ الحَرَّتَينِ وُفودُها",5,"د",3,0],["وَصُنُوفَ إِخْوَانٍ بِهِمْ","ضَمَّ الْحِمَى لِلذَّوْدِ شَمْلَهْ",6,"ل",2,0],["وَصُنّا نِساءً نَحنَ أَولى بِصَونِها","رَجَعنَ وَلَم تُكشَف لَهُنَّ سَتائِرُ",7,"ر",1,0],["وَصِناعَتي ضَربُ السُيوفِ وَإِنَّني","مُتَعَرِّضٌ في الشِعرِ بِالشُعَراءِ",8,"ا",2,0],["وصنو أبٍ قد صانَ نقطة خالها","فيا حرباً من خالها ثم عمّها",9,"م",3,0],["وصنتِ خدّاً كساه خالقه ال","حسنَ فصعّرْتهِ عن الصَعَرِ",10,"ر",1,0],["وصُنْ قدرَ نفس عندها عَصبِيَّةٌ","تُريها بحقٍّ أنّ تأميلك الوَفْر",11,"ر",1,0],["وصُنْ حُرَّاً بذلتَ لهُ العطايا","فقد شانَ ابتذالُك منه بَذْلك",12,"ك",1,0],["وصنّي يومَ سلمك إنَّ صوني","يسرُّك يوم حربك بابتذالي",13,"ل",2,0],["وَصَنَعتَ مِن أَسيافِهِم وَدُروعِهِم","لِرِقابِهِم وَزُنودِهِم أَغلالا",14,"ل",2,0],["وصنعت ما بلغت يدا","ك وحبذا منك الصنيع",15,"ع",1,0],["وصن اليدين عن الدماء فإنها","في البغى أوخم ما يكون المرتع",16,"ع",1,0],["وَصُنتُها مِن جانِبَي","مَرقَدِها بِسُترَتي",17,"ي",1,0],["وَصُن لُغَةً يَحُقُّ لَها الصِيانُ","فَخَيرُ مَظاهِرِ الأُمِّ البَيانُ",18,"ن",1,0],["وَصُنِ المَحاسِنَ عَن قُلو","بٍ لا يَدَينِ لَها بِجُندِك",19,"ك",1,0],["وَصُنِ الحُسامَ وَلا تُذِلهُ فَإِنَّهُ","يَشكو يَمينَكَ وَالجَماجِمُ تَشهَدُ",20,"د",1,0],["وصنعُ الليالي ما عدتكَ سِهامُها","وإنْ أجحفتْ بالعالمين جزيلُ",21,"ل",1,0],["وَصَنَعتُ في العَرَبِ الصَنائِعَ عِندَهُم","مِن رِفدِ طُلّابٍ وَفَكِّ عُناةِ",22,"ه",1,0],["وَصُنعُ اللَهِ فيكَ أَزالَ عَنّا","تَرَجُّحَ ذَلِكَ الحَدَثِ الجَليلِ",23,"ل",1,0],["وَصَنائِعٌ لَكَ سَوفَ تَترُكُها النَوى","وَكَأَنَّما هِيَ أَرسُمٌ وَرُبوعُ",24,"ع",1,0],["وصُنوفُ أَنبِذَةٍ إذا عاينَتها","عاينتَ أفراحَ النُفوسِ كَوامِلا",25,"ل",2,0],["وصنيعةً سَمِعَ الملوكُ بِفَضلِها","والجودُ يُسمَعُ والصنَّائعُ تُشهِرُ",26,"ر",1,0],["وصُنْتُ عُقودَ المَدحِ من كلِّ مُمْسِكٍ","يَهونُ عليه دُرُّها وفَريدُها",27,"د",3,0],["وَصُن مِنكَ ماءَ الوَجهِ لا تَبذُلَنَّهُ","وَلا تَسألِ الأَرذالَ فَضلَ الرَغائِبِ",28,"ب",1,0],["وَصُنوفُ اللَذاتِ مِن كُلِّ لَونٍ","وَالفَنا مُقبِلٌ إِلَينا سَريعُ",29,"ع",1,0],["وَصُنِ المَحامِدَ ما اِستَطَعتَ فَإِنَّها","في الوَزنِ تَرجُحُ بَذلَ كُلِّ نَوالِ",30,"ل",1,0],["وَصَنيعَةٍ لَكَ ثَيِّبٍ أَهدَيتَها","وَهيَ الكَعابُ لِعائِذٍ بِكَ مُصرِمِ",31,"م",1,0],["وَصَنيعَةٍ لَكَ قَد كَتَمتَ جَزيلَها","فَأَبى تَضَوُّعُها الَّذي لا يُكتَمُ",32,"م",1,0],["وصُنْتُم مَجدَكم عن كلِّ عادٍ","بكلِّ غَضَنْفَرٍ يحمِي العَرينا",33,"ن",2,0],["وَصُنْتَهُ عَلَماً للحقِّ تَحفظُهُ","لا يحفظُ العِرضَ مَن لا يحفظُ العَلَمَا",34,"م",2,0],["وصنعتُمُ الصّنعَ الجميل كرامةً","لمهاجرين همُ الفريقُ الأمثلُ",35,"ل",1,0],["وَصَنيعُ مِثلِكَ عِندَ مِثلي ذِكرُهُ","في الأَصلِ حينَ تَغيبُ ذو آصارِ",36,"ر",1,0],["وصناديدُ قُرَيْش سَقاها","حَتْفَها سَقْيَ اللِّقاحِ السِّقايا",37,"ي",2,0],["وصُن مَشِيبَكَ عن فِعلٍ تُشَانُ بِهِ","فكلُّ ذِي صَبْوَةٍ بالشَّيبِ مَعْذُولُ",38,"ل",1,0],["وصُنْتَ منه إلى ما لم تَصُنْه يَدٌ","سِواكَ من كلّ راعٍ ثَمّ مَرعيّ",39,"ي",1,0],["وَصِن في الشَرخِ نَفسَكَ عَن غَوانٍ","يَزُرنَ مَعَ الكَواكِبِ مُعتِماتِ",40,"ت",1,0],["وصُنْتَ عِيالَهُمْ إذْ كُلُّ عَينٍ","تَعُدّ سَوَادَ ناظِرِها عِيالا",41,"ل",2,0],["وصُنَّ أزاهرَ ما نوَّرَتْ","بهنَّ الغصونُ لغير الشفاهْ",42,"ه",1,0],["وصنتُ لهاتَه عن كل لغوٍ","له خدّ الفتى العربي يندَى",43,"د",2,0],["وَصَنَعْتِ أبطال البِلا","دِ، الذَّائِدين عن الحُدود",44,"د",1,0],["وصن بقية هذا العمر في كيس","فان دهرك لو فكرت كيسان",45,"ن",1,0],["وصنائع الأحلام أنفس مفخرا","من كل مفخرة يسود كرامها",46,"م",3,0],["وصناديدُ قُرَيْش سَقاها","حَتْفَها سَقْيَ اللِّقاحِ السِّقابا",47,"ب",2,0],["وصُنتُ كَّل دُعاةِ الحقِّ عن زَيغٍ","والمُصلحينَ الهداةَ ، العُجْمَ والعَرَبا",48,"ب",2,0],["وصن ضحكة الأطفال يا ربّ إنّها","إذا غرّدت في موحش الرمل أعشبا",49,"ب",2,0],["وصن كلّ زرع أن ينازع خصبه","هجير وريح – لا ترقّ – حطوم",50,"م",1,0],["وصن الحب للحبيب وان خا","ن فجدران ذي الخيانة تهدم",51,"م",1,0],["وصن الوقار فلا تخفف مجدك ال","موروث واحمله على اثقاله",52,"ل",2,0],["وصنوف الحاجات ترفع في أي","دي صفوف الأملاك للقهار",53,"ر",1,0],["وصنه في حجاب القلب مثلي","يظل له بقلبينا علوق",54,"ق",1,0],["وصن المال وفرق طرَفا","منه فالمرضىُّ منهم مَنْ بَذَلْ",55,"ل",1,0],["وصنعتِ شيخاً من غُلام","يَحبو على بابِ السِّنِين",56,"ن",1,0],["وَصَنائِعاً غُرّاً أَفَدنَ مَنائِحاً","عوناً وَلَدنَ مَدائِحاً أَبكارا",57,"ر",2,0],["وَصِنواكَ لا تَعصِ اِبنَ عَمِّكَ مِنهُما","وَكُن غَيرَ مَأمورٍ إِلى السِلمِ أَميَلا",58,"ل",2,0],["وصنت المسلمين له","فلا خوف ولا عَدَم",59,"م",1,0],["وصنت سمعك عن قول أجشّمه","وهو الدُّجى أن يعير الشمس أنوارا",60,"ر",2,0],["وصُنتُهُ بعدما وفَّيتُ واجِبَهُ","بالسَّمع أُوسعُه حِفظاً وتكرارا",60,"ر",2,0],["وصنعاء في ملك الإمام وماله","بذاك يد تحميك عنها ولا رجل",61,"ل",1,0],["وصنفت شيئا عنه قد كنت في غنا","به في الاناشخت وفي الأرض أسخب",62,"ب",1,0],["وصنف تصنيفا علمت بأنه","بما زينت منه له النفس معجب",62,"ب",1,0],["وَصُنِ التالدَ مَجداً وَعِزّاً","إِنَّ عَجزاً أَن تَصونَ الطَريفا",63,"ف",2,0],["وَصُنّا بِأَنواعِ الحَريرِ جُسُومَها","وَمَلبَسُنا صُوفُ الرُعَينا وَخامُها",64,"م",3,0],["وصنعاءُ أنّت لموتٍ بتعزٍ","وحرّق فيحا ضِرامٌ شَبوبُ",65,"ب",1,0],["وصنيعُ الأيام طورا سعود","ونحوسٌ والنحسُ شر صنيع",66,"ع",1,0],["وصنت النفس عن مدح وذمّ","وترداد إلى السفل الرعاع",67,"ع",1,0],["وصنتُ نفسي عن هوى غيرِهِ","من روضِ خَدَّيْهِ بوشيٍ مَصون",68,"ن",1,0],["وصنائعٌ ألبستها منْ صَنْعَةٍ","حُللاً منمقةً كوشيٍ عَبقرِي",69,"ر",2,0],["وَصِنّينُ ما زالَ جارَ السَماءِ","وَما زالَتِ الهَضَباتُ الأُخَر",70,"ر",1,0],["وصُنْه عن سقْينا إن أغارُ به","وسَقِّه واسقِني من فضل مَشْربه",71,"ب",2,0],["وصنوف الأنعام من رائحات","سارحات ونافرات الوحوش",72,"ش",1,0],["وَصُنتَني عَن مَعشَرٍ أَجباسِ","مافيهِمِ سَمحٌ وَلا مُؤاسِ",73,"س",1,0],["وَصُنتَني عَنِ الأَكُفِّ","الجَعدَةِ الشِحاحِ",74,"ح",1,0],["وصنا القوافي عن سواك ولا أرى","لغيرك يا ليث العلا يصلح العقد",75,"د",1,0],["وَصن ماء وَجهي عَن زَمان معاند","وصل حبل انسى فالغَريب غَريب",76,"ب",1,0],["وَصنوه عمر ماصنوه عمر","سامي الذَوائِب واقى العرض بالمال",77,"ل",1,0],["وَصن ماءَ وَجهي عَنسؤال مذلة","بفضلك واشملني لدى العسر باليسر",78,"ر",1,0],["وصن ماء وَجهي عَن مقام مذلة","وَحصنه من جور الطغاة اذا جاروا",79,"ر",3,0],["وصناعةٌ تُنسيك صنعاءً بما","وشَّاه مبتدعاً وما أنشاه",80,"ا",2,0],["وَصُنتَ بِها حَرَمَ اللهِ وال","حِجازَ وَكَعبَتَهُ عَن أَذاها",81,"ا",3,0],["وَصن سرّه والعيب واِنشر ثناءه","وَصله دوالاً بالزيارة والكتبِ",82,"ب",1,0],["وَصُن برداءِ الإصطناع جمالها","ليزهى عَلى أترابها ذيله سحبا",83,"ب",2,0],["وصُنتُ أنقاضي","عن معول النسيان",84,"ن",1,0],["وَصنوه سَميّ هَذا الداعي","وَكُلّ مَن يَعشَق بِالسَماعِ",85,"ع",1,0],["وَصُن مَنازِلَهُم مِن هَطلِ دامِعَةٍ","وَخَلِّها لِتِلالِ المَنزِلِ البالي",86,"ل",2,0],["وصِناعَتي عَربِيَّةٌ وكأنَّني","ألقَى بأكثرِ ما صَنَعتُ الرُّوما",87,"م",2,0],["وصنه من الصحب الذين تظنهم","ذوي حشمةٍ للنار من شأنها اللفح",88,"ح",1,0],["وصن حُرَّ ماء الوجه منك صيانةً","فلا خير في وجهٍ يُرقرَقُ ماؤه",89,"ا",3,0],["وصن بطنك واحفظه","عن سحت وشبهات",90,"ت",1,0],["وصُنْتَ العِلْمَ والفتوى بِهَدْي","يبعد عن منابرها العَجُولا",91,"ل",2,0],["وصنوه حيدرة الكرّار مَنْ","باهَى به الرحمنُ أملاكَ السَّما",92,"ا",1,0],["وصنعتم في أنصباء المواشي","ما روتْهُ فيها لنا الأخيار",93,"ر",1,0],["وصنوي في 