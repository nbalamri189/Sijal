","الطويل"],[456,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[456,"تراك ترى غدوا أو أصيلا","https://www.aldiwan.net/poem56078.html","الوافر"],[456,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[456,"يا قلب من أين على فترة","https://www.aldiwan.net/poem56272.html","السريع"],[456,"أبلغ بها أمنية الطالب","https://www.aldiwan.net/poem56275.html","السريع"],[461,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[477,"وخز اليراع كوخز الرمح في الألم","https://www.aldiwan.net/poem37183.html","البسيط"],[498,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[498,"رقمت في معارفي الأشياء","https://www.aldiwan.net/poem38098.html","الخفيف"],[513,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[527,"أتطلب الحقيقه","https://www.aldiwan.net/poem37289.html","منهوك المنسرح"],[527,"أود بأن أعيش لنشر علم","https://www.aldiwan.net/poem37509.html","الوافر"],[549,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[556,"وجدت كنزا هنا هو البركه","https://www.aldiwan.net/poem33508.html","المنسرح"],[556,"يا قلب أحبابنا جسمي بهم بالي","https://www.aldiwan.net/poem34245.html","البسيط"],[565,"ما ترى في الصبوح أيدك الله","https://www.aldiwan.net/poem69743.html","الخفيف"],[573,"نعم المشوق وأنعم المعشوق","https://www.aldiwan.net/poem3046.html","الكامل"],[577,"رجواك في الله لاتخطأ مراميه","https://www.aldiwan.net/poem56780.html","البسيط"]],"verses":[["وَصَنَعتُمُ فَعَرَفتُ قَدرَ صَنيعِكُم","وَلَرُبَّما غَلِطَ الطَريقَ المُصنِعُ",0,"ع",1,0],["وَصَنَعتُ ما ثَلَمَ الوَقارَ صَنيعُهُ","مِمّا عَراني مِن جَوى البُرحاءِ",1,"ا",2,0],["وَصُنِ اللِّسَانَ عَنِ الْقَبِيحِ فَرُبَّمَا","يَمْضِي اللِّسَانُ بِحَيْثُ يَنْبُو الْمنْصَلُ",2,"ل",1,0],["وَصَنَعتُم صَنَعَ اللَهُ لَكُم","فَوقَ ما يَصنَعُهُ الخِلُّ الأَبَر",3,"ر",1,0],["وَصَنيعَةٍ قَد باتَ غَيرُكَ نائِماً","عَنها وَجَفنُكَ ساهِرٌ ما غَمَّضا",4,"ض",2,0],["وَصِنوَيَّ لا أَنسى مُعاوِيَةَ الَّذي","لَهُ مِن سَراةِ الحَرَّتَينِ وُفودُها",5,"د",3,0],["وَصُنُوفَ إِخْوَانٍ بِهِمْ","ضَمَّ الْحِمَى لِلذَّوْدِ شَمْلَهْ",6,"ل",2,0],["وَصُنّا نِساءً نَحنَ أَولى بِصَونِها","رَجَعنَ وَلَم تُكشَف لَهُنَّ سَتائِرُ",7,"ر",1,0],["وَصِناعَتي ضَربُ السُيوفِ وَإِنَّني","مُتَعَرِّضٌ في الشِعرِ بِالشُعَراءِ",8,"ا",2,0],["وصنو أبٍ قد صانَ نقطة خالها","فيا حرباً من خالها ثم عمّها",9,"م",3,0],["وصنتِ خدّاً كساه خالقه ال","حسنَ فصعّرْتهِ عن الصَعَرِ",10,"ر",1,0],["وصُنْ قدرَ نفس عندها عَصبِيَّةٌ","تُريها بحقٍّ أنّ تأميلك الوَفْر",11,"ر",1,0],["وصُنْ حُرَّاً بذلتَ لهُ العطايا","فقد شانَ ابتذالُك منه بَذْلك",12,"ك",1,0],["وصنّي يومَ سلمك إنَّ صوني","يسرُّك يوم حربك بابتذالي",13,"ي",1,0],["وَصَنَعتَ مِن أَسيافِهِم وَدُروعِهِم","لِرِقابِهِم وَزُنودِهِم أَغلالا",14,"ل",2,0],["وصنعت ما بلغت يدا","ك وحبذا منك الصنيع",15,"ع",1,0],["وصن اليدين عن الدماء فإنها","في البغى أوخم ما يكون المرتع",16,"ع",1,0],["وَصُنتُها مِن جانِبَي","مَرقَدِها بِسُترَتي",17,"ي",1,0],["وَصُن لُغَةً يَحُقُّ لَها الصِيانُ","فَخَيرُ مَظاهِرِ الأُمِّ البَيانُ",18,"ن",1,0],["وَصُنِ المَحاسِنَ عَن قُلو","بٍ لا يَدَينِ لَها بِجُندِك",19,"ك",1,0],["وَصُنِ الحُسامَ وَلا تُذِلهُ فَإِنَّهُ","يَشكو يَمينَكَ وَالجَماجِمُ تَشهَدُ",20,"د",1,0],["وصنعُ الليالي ما عدتكَ سِهامُها","وإنْ أجحفتْ بالعالمين جزيلُ",21,"ل",1,0],["وَصَنَعتُ في العَرَبِ الصَنائِعَ عِندَهُم","مِن رِفدِ طُلّابٍ وَفَكِّ عُناةِ",22,"ه",1,0],["وَصُنعُ اللَهِ فيكَ أَزالَ عَنّا","تَرَجُّحَ ذَلِكَ الحَدَثِ الجَليلِ",23,"ل",1,0],["وَصَنائِعٌ لَكَ سَوفَ تَترُكُها النَوى","وَكَأَنَّما هِيَ أَرسُمٌ وَرُبوعُ",24,"ع",1,0],["وصُنوفُ أَنبِذَةٍ إذا عاينَتها","عاينتَ أفراحَ النُفوسِ كَوامِلا",25,"ل",2,0],["وصنيعةً سَمِعَ الملوكُ بِفَضلِها","والجودُ يُسمَعُ والصنَّائعُ تُشهِرُ",26,"ر",1,0],["وصُنْتُ عُقودَ المَدحِ من كلِّ مُمْسِكٍ","يَهونُ عليه دُرُّها وفَريدُها",27,"د",3,0],["وَصُن مِنكَ ماءَ الوَجهِ لا تَبذُلَنَّهُ","وَلا تَسألِ الأَرذالَ فَضلَ الرَغائِبِ",28,"ب",1,0],["وَصُنوفُ اللَذاتِ مِن كُلِّ لَونٍ","وَالفَنا مُقبِلٌ إِلَينا سَريعُ",29,"ع",1,0],["وَصُنِ المَحامِدَ ما اِستَطَعتَ فَإِنَّها","في الوَزنِ تَرجُحُ بَذلَ كُلِّ نَوالِ",30,"ل",1,0],["وَصَنيعَةٍ لَكَ ثَيِّبٍ أَهدَيتَها","وَهيَ الكَعابُ لِعائِذٍ بِكَ مُصرِمِ",31,"م",1,0],["وَصَنيعَةٍ لَكَ قَد كَتَمتَ جَزيلَها","فَأَبى تَضَوُّعُها الَّذي لا يُكتَمُ",32,"م",1,0],["وصُنْتُم مَجدَكم عن كلِّ عادٍ","بكلِّ غَضَنْفَرٍ يحمِي العَرينا",33,"ن",2,0],["وَصُنْتَهُ عَلَماً للحقِّ تَحفظُهُ","لا يحفظُ العِرضَ مَن لا يحفظُ العَلَمَا",34,"م",2,0],["وصنعتُمُ الصّنعَ الجميل كرامةً","لمهاجرين همُ الفريقُ الأمثلُ",35,"ل",1,0],["وَصَنيعُ مِثلِكَ عِندَ مِثلي ذِكرُهُ","في الأَصلِ حينَ تَغيبُ ذو آصارِ",36,"ر",1,0],["وصناديدُ قُرَيْش سَقاها","حَتْفَها سَقْيَ اللِّقاحِ السِّقايا",37,"ي",2,0],["وصُن مَشِيبَكَ عن فِعلٍ تُشَانُ بِهِ","فكلُّ ذِي صَبْوَةٍ بالشَّيبِ مَعْذُولُ",38,"ل",1,0],["وصُنْتَ منه إلى ما لم تَصُنْه يَدٌ","سِواكَ من كلّ راعٍ ثَمّ مَرعيّ",39,"ي",1,0],["وَصِن في الشَرخِ نَفسَكَ عَن غَوانٍ","يَزُرنَ مَعَ الكَواكِبِ مُعتِماتِ",40,"ت",1,0],["وصُنْتَ عِيالَهُمْ إذْ كُلُّ عَينٍ","تَعُدّ سَوَادَ ناظِرِها عِيالا",41,"ل",2,0],["وصُنَّ أزاهرَ ما نوَّرَتْ","بهنَّ الغصونُ لغير الشفاهْ",42,"ه",1,0],["وصنتُ لهاتَه عن كل لغوٍ","له خدّ الفتى العربي يندَى",43,"د",2,0],["وَصَنَعْتِ أبطال البِلا","دِ، الذَّائِدين عن الحُدود",44,"د",1,0],["وصناديدُ قُرَيْش سَقاها","حَتْفَها سَقْيَ اللِّقاحِ السِّقابا",45,"ب",2,0],["وصُنتُ كَّل دُعاةِ الحقِّ عن زَيغٍ","والمُصلحينَ الهداةَ ، العُجْمَ والعَرَبا",46,"ب",2,0],["وصن الحب للحبيب وان خا","ن فجدران ذي الخيانة تهدم",47,"م",1,0],["وصن الوقار فلا تخفف مجدك ال","موروث واحمله على اثقاله",48,"ل",2,0],["وصنوف الحاجات ترفع في أي","دي صفوف الأملاك للقهار",49,"ر",1,0],["وصنه في حجاب القلب مثلي","يظل له بقلبينا علوق",50,"ق",1,0],["وصن المال وفرق طرَفا","منه فالمرضىُّ منهم مَنْ بَذَلْ",51,"ل",1,0],["وصنعتِ شيخاً من غُلام","يَحبو على بابِ السِّنِين",52,"ن",1,0],["وَصَنائِعاً غُرّاً أَفَدنَ مَنائِحاً","عوناً وَلَدنَ مَدائِحاً أَبكارا",53,"ر",2,0],["وَصِنواكَ لا تَعصِ اِبنَ عَمِّكَ مِنهُما","وَكُن غَيرَ مَأمورٍ إِلى السِلمِ أَميَلا",54,"ل",2,0],["وصنت المسلمين له","فلا خوف ولا عَدَم",55,"م",1,0],["وصنت سمعك عن قول أجشّمه","وهو الدُّجى أن يعير الشمس أنوارا",56,"ر",2,0],["وصُنتُهُ بعدما وفَّيتُ واجِبَهُ","بالسَّمع أُوسعُه حِفظاً وتكرارا",56,"ر",2,0],["وصنعاء في ملك الإمام وماله","بذاك يد تحميك عنها ولا رجل",57,"ل",1,0],["وصنفت شيئا عنه قد كنت في غنا","به في الاناشخت وفي الأرض أسخب",58,"ب",1,0],["وصنف تصنيفا علمت بأنه","بما زينت منه له النفس معجب",58,"ب",1,0],["وَصُنِ التالدَ مَجداً وَعِزّاً","إِنَّ عَجزاً أَن تَصونَ الطَريفا",59,"ف",2,0],["وَصُنّا بِأَنواعِ الحَريرِ جُسُومَها","وَمَلبَسُنا صُوفُ الرُعَينا وَخامُها",60,"م",3,0],["وصنعاءُ أنّت لموتٍ بتعزٍ","وحرّق فيحا ضِرامٌ شَبوبُ",61,"ب",1,0],["وصنيعُ الأيام طورا سعود","ونحوسٌ والنحسُ شر صنيع",62,"ع",1,0],["وصنت النفس عن مدح وذمّ","وترداد إلى السفل الرعاع",63,"ع",1,0],["وصنتُ نفسي عن هوى غيرِهِ","من روضِ خَدَّيْهِ بوشيٍ مَصون",64,"ن",1,0],["وصنائعٌ ألبستها منْ صَنْعَةٍ","حُللاً منمقةً كوشيٍ عَبقرِي",65,"ر",2,0],["وَصِنّينُ ما زالَ جارَ السَماءِ","وَما زالَتِ الهَضَباتُ الأُخَر",66,"ر",1,0],["وصُنْه عن سقْينا إن أغارُ به","وسَقِّه واسقِني من فضل مَشْربه",67,"ب",2,0],["وصنوف الأنعام من رائحات","سارحات ونافرات الوحوش",68,"ش",1,0],["وَصُنتَني عَن مَعشَرٍ أَجباسِ","مافيهِمِ سَمحٌ وَلا مُؤاسِ",69,"س",1,0],["وَصُنتَني عَنِ الأَكُفِّ","الجَعدَةِ الشِحاحِ",70,"ح",1,0],["وصنا القوافي عن سواك ولا أرى","لغيرك يا ليث العلا يصلح العقد",71,"د",1,0],["وَصن ماء وَجهي عَن زَمان معاند","وصل حبل انسى فالغَريب غَريب",72,"ب",1,0],["وَصنوه عمر ماصنوه عمر","سامي الذَوائِب واقى العرض بالمال",73,"ل",1,0],["وَصن ماءَ وَجهي عَنسؤال مذلة","بفضلك واشملني لدى العسر باليسر",74,"ر",1,0],["وصن ماء وَجهي عَن مقام مذلة","وَحصنه من جور الطغاة اذا جاروا",75,"ر",3,0],["وصناعةٌ تُنسيك صنعاءً بما","وشَّاه مبتدعاً وما أنشاه",76,"ا",2,0],["وَصُنتَ بِها حَرَمَ اللهِ وال","حِجازَ وَكَعبَتَهُ عَن أَذاها",77,"ا",3,0],["وَصن سرّه والعيب واِنشر ثناءه","وَصله دوالاً بالزيارة والكتبِ",78,"ب",1,0],["وَصُن برداءِ الإصطناع جمالها","ليزهى عَلى أترابها ذيله سحبا",79,"ب",2,0],["وصُنتُ أنقاضي","عن معول النسيان",80,"ن",1,0],["وَصنوه سَميّ هَذا الداعي","وَكُلّ مَن يَعشَق بِالسَماعِ",81,"ع",1,0],["وَصُن مَنازِلَهُم مِن هَطلِ دامِعَةٍ","وَخَلِّها لِتِلالِ المَنزِلِ البالي",82,"ي",1,0],["وصِناعَتي عَربِيَّةٌ وكأنَّني","ألقَى بأكثرِ ما صَنَعتُ الرُّوما",83,"م",2,0],["وصنه من الصحب الذين تظنهم","ذوي حشمةٍ للنار من شأنها اللفح",84,"ح",1,0],["وصن حُرَّ ماء الوجه منك صيانةً","فلا خير في وجهٍ يُرقرَقُ ماؤه",85,"ا",3,0],["وصن بطنك واحفظه","عن سحت وشبهات",86,"ت",1,0],["وصُنْتَ العِلْمَ والفتوى بِهَدْي","يبعد عن منابرها العَجُولا",87,"ل",2,0],["وصنوه حيدرة الكرّار مَنْ","باهَى به الرحمنُ أملاكَ السَّما",88,"ا",1,0],["وصنعتم في أنصباء المواشي","ما روتْهُ فيها لنا الأخيار",89,"ر",1,0],["وصنوي في الشباب حليف تقوى","له سَمْتُ الشيوخ وَهَدْيُ مهدي",90,"ي",1,0],["وصنْتُ حتّى عن الأوْهامِ سِرَّهُمُ","فليتَ شِعري بِما استَوْجَبْتُ هَجْرَهُمُ",91,"م",1,0],["وصنائِعُ المعروفِ كالوسمِيِّ ذَا","من قَطره نبتٌ وهذا جوهَرُ",92,"ر",1,0],["وصنتها عن شرار الناس قاطبة","صون الجنين لدى الإنفاق بالبدر",93,"ر",1,0],["وصن سرَّنا في سكرنا عن حودنا","وإن أنكرَت عيناك شيئاً فسامحنا",94,"ن",2,0],["وصُنْتَ بوارق الأُمراءِ عن أَنْ","تَمُدَّ لها الخطوبُ طويلَ باعِ",95,"ع",1,0],["وصُنتُه عن أيادي الخائنين كما","جعلتَ جودَك عنه رهنَ إعطاءِ",96,"ا",2,0],["وصِنْوُ عُلاهُ ناصِرُ الدَّولَةِ الَّذِي","يفوزُ لَهُ فِي كُلِّ مكرُمَةٍ قِدْحُ",97,"ح",1,0],["وصن بك وجهيَ عمّن سواك","فما مثل وجهِيَ يُستبذَلُ",98,"ل",1,0],["وصن بالصبر قلبَك وهو سيفٌ","قراعُ الهمّ يملؤه فلولا",99,"ل",2,0],["وصُنْها وكرِّمْ نُزْلَها إنّ بيتَها","كبيتك في أُفقْ السماء المشيَّدِ",100,"د",1,0],["وصُنتَ وجهي بعد ما شفَّني","من مائه المنزَفُ والناضبُ",101,"ب",1,0],["وصنتَ وما حَسَّنَ من ذكرِهِ","عن دنَسِ القادحِ والقاصبِ",102,"ب",1,0],["وصن ذا الذي من قلبك والذي","يضمانه فخذاك عن أن يبادرا",103,"ر",2,0],["وصنت نفسي عن ذكر اللئام فما","أولى الظما بي إذا ما الري من كرم",104,"م",1,0],["وصنْ بنيَّ العينَ لا تنظرْ بها","إِلاَّ مُباحاً وبه الشَّرعُ أَتَى",105,"ا",1,0],["وصُنْ حُقوقَ النَّاسِ لا تعبَثْ بها","بذلك السَّطرُ على اللَّوحِ جَرَى",105,"ا",1,0],["وصُنِ الذَّيْلَ واصْلِحِ المَيْلَ واف