مك كي (...)","https://www.poetsgate.com/ViewPoem.aspx?id=199882",""],[4796,"اللغة الفريدة","https://www.poetsgate.com/ViewPoem.aspx?id=34720",""],[4859,"لك أرنو","https://www.poetsgate.com/ViewPoem.aspx?id=208066",""],[4961,"في ظلال ِ الصَّدق ِ تُنْتَخَبُ الجواهر","https://www.poetsgate.com/ViewPoem.aspx?id=58865",""],[5077,"نصٌّ من الحبّ القديم ..","https://www.poetsgate.com/ViewPoem.aspx?id=36887",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5190,"في ذكرى ملحمة العبور","https://www.poetsgate.com/ViewPoem.aspx?id=9716",""],[5302,"إني أحبك يا نجود","https://www.poetsgate.com/ViewPoem.aspx?id=200779",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5376,"قفْ ودِّعِ الكفرَ فالإسلامُ في نهم","https://www.poetsgate.com/ViewPoem.aspx?id=188508",""],[5387,"أنا والليل","https://www.poetsgate.com/ViewPoem.aspx?id=53149",""],[5457,"كرهت كتابةَ الأشعار","https://www.poetsgate.com/ViewPoem.aspx?id=213116",""],[5459,"تَقَدَّمْ..!","https://www.poetsgate.com/ViewPoem.aspx?id=200257",""],[327,"ما الناس إلا في رماقٍ وصالح","https://www.poetsgate.com/ViewPoem.aspx?id=3861",""],[5729,"أفنيت عمري","https://www.poetsgate.com/ViewPoem.aspx?id=203996",""],[5809,"الدر اليتيم","https://www.poetsgate.com/ViewPoem.aspx?id=205569",""],[5897,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=156535",""],[5897,"إليك ...أمي","https://www.poetsgate.com/ViewPoem.aspx?id=157276",""],[5906,"أوتار حائرة","https://www.poetsgate.com/ViewPoem.aspx?id=188311",""],[5939,"بوريو","https://www.poetsgate.com/ViewPoem.aspx?id=185514",""],[5973,"عام بانسيه ٍ ليس يمضي حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=13764",""],[6189,"بيان للجماهير المحتشدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83593&r=&rc=60",""],[6072,"رُحى الحُب والحرب !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85442&r=&rc=29",""],[6265,"المهاجرة اليمنية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84177&r=&rc=0",""]],"verses":[["فَإِن أَمُت مِن دونِها يَمضي الرَدى","بِمُعذِرٍ في السَعيِ لا بِمُعذَرِ",0,"ر",1,0],["فإنّ أميرَ المُؤمنينَ وجارَهُ","بِعَلياءَ لا يَسْمو لَها القَمَرانِ",1,"ن",1,0],["فإنْ أمْدَحْ إماماً أو هُماماً","فَلا جاهاً أرومُ ولا نَوالا",2,"ل",2,0],["فَإِن أُمسِ مَكروباً فَيا رُبَّ بَهمَةٍ","كَشَفتُ إِذا ما اِسوَدَّ وَجهُ جَبانِ",3,"ن",1,0],["فَإِنَّ أَميرَ المُؤمِنينَ حَباكُمُ","بِمُستَبصِرٍ في الدينِ زَينِ المَساجِدِ",4,"د",1,0],["فَإِنَّ اِمرَأً يَرجو الفَلاحَ وَقَد رَأى","سَواماً وَحَيّاً بِالأُفاقَةِ جاهِلُ",5,"ل",1,0],["فَإِنَّ اِمرَأً لا يَنتَهي عَن غَوايَةٍ","إِذا ما اِشتَهَتها نَفسُهُ لَجَهولُ",6,"ل",1,0],["فَأَنامِلٌ أَبَداً تُشي","رُ وَأَعيُنٌ أَبَداً تُغامِز",7,"ز",1,0],["فَإِن أَمرَض فَما مَرِضَ اِصطِباري","وَإِن أُحمَم فَما حُمَّ اِعتِزامي",8,"م",2,0],["فإنَّ امرَءاً لم يرزأ الحقُّ مالَهُ","ولم يفتقِرْ عن ثروةٍ للئيمُ",9,"م",1,0],["فَإِنَّ اِمرِأً يَغتابُني لَم أَطَأ لَهُ","حَريماً وَلَم تَنهاهُ عَنّي أَقارِبُه",10,"ب",2,0],["فَإِنَّ أَميرَ المُؤمِنينَ مُحيطَةٌ","يَداهُ بِأَهلِ الأَرضِ مِن كُلِّ مَرصَدِ",11,"د",1,0],["فَإِنَّ اِمرَأً يَسعى يُخَبِّبُ زَوجَتي","كَساعٍ إِلى أُسدِ الشَرى يَستَبيلُها",12,"ل",3,0],["فَإِنَّ أَمامَكِ المَهدِيَّ يَهدي","بِهِ الرَحمَنُ مَن خَشِيَ الضَلالا",13,"ل",2,0],["فَإِن أَمِنوا كَفّي فَما أَمِنوا فَمي","وَإِن ثَلِموا حَدّي فَما ثَلِموا عِرضي",14,"ض",2,0],["فَإِن أُمسِ مِن وَصلِ الكَواعِبِ آيِساً","فَآخِرُ آمالِ العِبادِ إِلى الياسِ",15,"س",1,0],["فَإِن أُمسِ مَطروقَ الفُؤادِ بِسَلوَةٍ","كَأَنَّ عَلى رَأسي مِنَ الشَيبِ أَغرابا",16,"ب",2,0],["فإنَّ أمَّارَتِي بالسُّوءِ ما اتَّعَظَتْ","مِنْ جَهْلِهَا بنذيرِ الشِّيْبِ وَالهَرَمِ",17,"م",1,0],["فَإِنِ اِمتَنَعتَ فَلا مُواتَرَةٌ","حَسبي كِتابٌ مِنكَ في الدَهرِ",18,"ر",1,0],["فَإِن أُمسِ لا تُخشى لِسَيفِيَ فِتكَةٌ","فَلا تَأمَنَن يا فَضلُ فِتكَ لِساني",19,"ن",2,0],["فأَنا مَا زلتُ في","فَجْرِ شبابي أَو ضُحَاهْ",20,"ا",2,0],["فإِن أَمسَيتُ مُكتبئاً حَزيناً","كَثيرَ الهَمِّ يَشهَدُني الحِذارُ",21,"ر",1,1],["فإِنْ أُمْسِي قَدْ أَنْكَرْتُ جِسْمِي وَقُوّتي","وأدرَكَني ما يُدْرِكُ المَرْءَ في العُمْرِ",22,"ر",1,1],["فانَّ أمرَّ ما أدْمَى كِفاحاً","طُعونُ الخائِفينَ مِن النجاح",23,"ح",1,0],["فإن أمس مكروباً فيا ربّ بهمة","كشَفتُ إذا ما اسْوَدّ وَجْهُ الجَبانِ",24,"ن",1,0],["فَإنّ امْرَأً يَغْتَابُني لَمْ أطَأ لَهُ","حَرِيماً، ولا تَنْهَاهُ عَنّي أقارِبُهْ",25,"ب",2,0],["فإنّ امْرَاً يَسْعَى يُخَبّبُ زَوْجَتي،","كَساعٍ إلى أُسْدِ الثّرَى يَسْتَبيلُها",26,"ل",3,0],["فَإِن اِمتِداحي غَير مَن هُوَ أَهلَهُ","حَيائِيَ مِن أَعضاي انزحها نَزحا",27,"ح",2,0],["فَإِنَّا مَتى ما نَمرِها بِسُيوفِنا","نُجالِح فَنَعرُك مِن نَشاءُ بِكَلكَلِ",28,"ل",1,0],["فَإِن أَمُت فَقَد تَناهَت لَذَّتي","وَكُلُّ شَيءٍ بَلَغَ الحَدَّ اِنتَهى",29,"ا",1,0],["فَاَنا مُذ حَلَّ تَعسي","فَرَّ حَظّي من يَدي",30,"ي",1,0],["فَأَنا ما زالَ حُبّي","نامِياً أَبقى جَريح",31,"ح",1,0],["فَإِن أُمسِ مَغلوباً فَغَيرُ مُؤَنِّبٍ","عَليكَ وَإِن أَجزَع فَغَيرُ مُؤَبِّخ",32,"خ",1,0],["فإن امتزاج الماء بالنار ناقل","طبائعها للاعتدال المناسب",33,"ب",1,0],["فأنا من الإهمالِ وَردٌ ذابلٌ","لكنَّ عَرفي لم يزل مخزونا",34,"ن",2,0],["فإن أَمْكَنَتْ بِأَيادِي الْمَكِينِ","فَما زِلْتُ أَعْرِفُ مَعْرُوفَها",35,"ف",3,0],["فَإِن أَمكَنتني فرصةٌ لتطلّبٍ","بِقلبٍ وجسمٍ لستُ عنهُ أحيدُ",36,"د",1,0],["فَأَنّ اِمرأً أَبدى الشَناءَةَ وَجهُهُ","فَإِنّي بِعَوراتِ العَدُوِّ بَصيرُ",37,"ر",1,0],["فَإِن أمدح عُلاك فَلي لِسان","بِهِ نَفثت فَصاحتهُ فَصاحا",38,"ح",2,0],["فإن أُمسٍ مكروبَ الفؤاد حزينَه","أُعاقرُ من دَرِّ الصبابةِ منهجا",39,"ج",2,0],["فأنا مملوك بشير السعد","أمير المجد وذا نسبي",40,"ب",2,0],["فأَنا ما تَلَوْتُ مَدْحَكَ إِلا","وإِبو طاهِرٍ مُحِبُّكَ تالِ",41,"ل",1,0],["فإن أمسكتْ بُقْيَا عليك وحشمةً","تبرّعتَ سعياً في زوال احتشامِها",42,"م",3,0],["فإنْ أمسيتُ بدراً في مَقامٍ","فأنت الشمس من غير ارْتيابِ",43,"ب",1,0],["فإن أمات سروري فرطُ غَدْرهُم","فالدهر نشوانُ من فضلي ومن كلِمي",44,"م",2,0],["فأنا ما بين رؤية ذا","فرط إنعامٍ من المفضال",45,"ل",1,0],["فَإِنَّ اِمرَأً في مَعشَرٍ غَيرِ قَومِهِ","ضَعيفُ الكَلامِ شَخصُهُ مُتَضائِلُ",46,"ل",1,0],["فَأَنا مُحِبُّكَ ما حييتُ","وَشاكِرٌ أَبَداً لِشاكِرُ",47,"ر",1,0],["فإن أمكنت كانت بكل جميلة","وإن وجبت جلت عن العرض الأدنى",48,"ن",2,0],["فَإِن أُمسِ قَد لاحَ فِيَّ المَشي","بُ أُمَّ البَنينِ فَقَد أَذكُرُ",49,"ر",1,0],["فإن أمدحنْه يُخصِب الغيث بلدتى","إلى أن أرى كل الفصول ربيعا",50,"ع",2,0],["فإن أمدحنْ ربَّ حرصٍ وإفكٍ","بذرتُ حبوبي بأرض السبخ",51,"خ",1,0],["فان أُمسِ قَد بُدِّلتُ حِلماً وشيبةً","مشيبيَ من بعدِ التَّبَختُر دالِفُ",52,"ف",1,0],["فأنا مُتعَبٌ مُعَنَّىً إلى أن","تَتَفَانى الأيّام أو أتفانى",53,"ن",2,0],["فإن امرأ أنتم حوله","تحفون قبته بالقباب",54,"ب",1,0],["فَإِنَّ اِمتِداحي غَيرَكُم كَهِجائكُم","وَذَلِكَ مِنّي إِن تَحرَّيتَهُ عَتبُ",55,"ب",1,0],["فان أمور الملك أضحى مدارها","عليه كما دارت على قُطبها الرحا",56,"ح",2,0],["فَإِن أُمسِ شَيخاً بِالرَجيعِ وَوِلدَةً","وَتُصبِحُ قَومي دونَ دارِهِمُ مِصرُ",57,"ر",1,0],["فَأَنا مُفحَمٌ عَلى أَنَّ خَيلي","لا تُجارى في حَلبَةِ الشُعَراءِ",58,"ا",2,0],["فأنا ما عشتُ أعرِفُها","أبداً من حيثُ أنكِرُها",59,"ر",3,0],["فإنّ امرأً ناجى الثّمانين عمره","بعيد نجاة النّفّس من مخلب الفنا",60,"ن",2,0],["فإن أمطر استحيتِ الغادياتُ","ونادت لأنت الحيا الماطر",61,"ر",1,0],["فإنا منكحو العُزَّاب منا","بهن لأن يبيتوا معرسينا",62,"ن",2,0],["فأنا مولع بحب بلادي","وبها بات منتهى إيماني",63,"ن",2,0],["فإنَّ امرءاً سرَ الموفَّق قربُهُ","وفارقهُ طوعاً لَغيرُ موفّقِ",64,"ق",1,0],["فإن أمير المؤمنين وفعلهُ","لكالدهر لا عارُ بما فعل الدهرُ",65,"ر",1,0],["فَأَنامِلٌ مِن ذا تُباشِرُ صُدغَه","وَمَراشِفٌ مِن ذا تُقَبِّلُ أَخمَصَه",66,"ه",1,0],["فإن أَمير الوقت بالأَمر قائِم","وَأَنتَ جَليس السوء في زي هامانا",67,"ن",2,0],["فَإِنَّ أَميرَ المُؤمِنينَ وَإِن نَأى","فَبِالقُربِ مِنّا مَن يَحوطُ وَيَكنفُ",68,"ف",1,0],["فَإِنَّ أَميرَ المؤمِنينَ بِنَفسِهِ","أَتاكُم وَإِلّا نَفسَهُ فَخيارُها",69,"ر",3,0],["فإنا منكم كما","أنتمُ بيضة البلد",70,"د",1,0],["فإنِ امْتَرَى ذو ومِرْيَةٍ فلعلّه","لم يَدْرِ كيف مَطَالِعُ الوِجدان",71,"ن",1,0],["فأنا ما دمتُ فهي مُولها","حيثُ لم أنفكَ فيه مُغرما",72,"م",2,0],["فأنا من بعدكم حلفَ الضنا","لم تذقْ عيناي في الليل هجودا",73,"د",2,0],["فانَّ أمرأ القيس بن حُجْرٍ بعلمكم","دعا صَاحبَيْه يومَ سِقْطِ اللِّوى قِفَا",74,"ف",2,0],["فَإِن أَمُت حَتفَ أَنفي لا أَمُت كَمَداً","عَلى الطِعانِ وَقُصرُ العاجِزِ الكَمِدُ",75,"د",1,0],["فإن أمسِ في قطر من الأرض إنّ لي","بريدَ اشتهارٍ في مناكبها يسري",76,"ر",2,0],["فإِن أَمت في هواها فَهيَ مالكتي","وما لعبدٍ على مولاه من قَوَدِ",77,"د",1,0],["فَإِن أُمسِ قَد أَقوَت مِن العلم حَضرَتي","وَأَصبَحتُ نَفضاً هامِداً بَينَ أَنقاضِ",78,"ض",1,0],["فَإِن أَمسَى بِرَوضَتِهِ وَحِيداً","كَمَا في العِلم مَنصِبُهُ وَحِيدُ",79,"د",1,0],["فأنا مددت الكف أرجوك العطا","وأنا لفضلك أفقر الفقراء",80,"ا",2,0],["فأنا مثلها أروم مطاراً","غير أن الجناح مني كسير",81,"ر",1,0],["فإن امت مت رغدا ليس يزعجني","نوح وغذيت صحبي الوحش من بدني",82,"ن",2,0],["فأنا مخلص للهوى لست أبغى","إن جفاني الحبيب أن أتسلّى",83,"ل",2,0],["فإن أمسك فإن العيش حلوٌ","إلي كأنه عسلٌ مشوب",84,"ب",1,1],["فإن أَمارتي بالسوء ما اِتعظت","وَساعدتها بسعي في الخطا قدمي",85,"م",2,0],["فَإِن أَمَّارتني بِالسوء ما اتعظت","عَن فعلها بِالَّذي قَد جاءَ مِن حكم",86,"م",1,0],["فإن أمام الحق قد حان وقته","وقد ملأت ظلما وجوراً وحسدا",87,"د",2,0],["فإن أمت فالموت لي خيرة","من قبل أن أهذي ولا أدري",88,"ر",2,0],["فَإِنَّ أمينَ الغَيبِ يَحصر صَدره","مِراراً وَيَستَحيي الحَبيبُ فَيصفحُ",89,"ح",1,0],["فَأنا ممن دَرَى الدّنيا وَرَاح","خلياني",90,"ي",1,0],["فان أمر الملك للقريب","وانه يكون بالترتيب",91,"ب",1,0],["فَإِن أَمُت سكرةً فَاللَه أَكرمُ بي","وَإِن أَعش جاهلاً حَقَّ العُلا وَجَبا",92,"ب",2,0],["فأنامل الأفراح تج","ري فوقها ألمًا دفينا",93,"ن",2,0],["فإن ا من أبهج الأطوار","من لي بأن أعطى به أوطاري",94,"ي",1,0],["فأنا منك في سرور وهم","ولذا أنت صاحبي وغريمي",95,"م",2,0],["فإن أمسِ فيكم زاهداً بعد رغبةٍ","فبعد اختيارٍ كان في وصلكم زهدي",96,"د",2,0],["فأنا من بعدهم كلف","مُستَهامُ القلبِ في شُغُلِ",97,"ل",1,0],["فإن أمكمُ كانت مُلعنّةً","تُمري الخلايا وترعى غائبَ البُهم",98,"م",1,0],["فَإِنَّا مَنيلا جُزَافاً غَرَرنا","بِوَعدٍ وَلَكِنَّنا ما بَرَرنا",99,"ن",2,0],["فأَنا مُرشدٌ خُطاكَ إلى خص","مِك أَقضي بذاكَ بعض الوفاءِ",100,"ا",2,0],["فأنا من ذا وهذي","في سموم وحميم",101,"م",1,0],["فأنا 