{"poems":[[55,"أتحسب سوء الظن يجرح في فكري","https://www.aldiwan.net/poem30426.html","الطويل"],[65,"أصاخ إلى الواشي فلباه إذ دعا","https://www.aldiwan.net/poem46191.html","الطويل"],[57,"أداري الناس عما بي","https://www.aldiwan.net/poem26556.html","الهزج"],[79,"أشارت غداة البين من خلل السجف","https://www.aldiwan.net/poem35976.html","الطويل"],[79,"إذا ما غرست الخير في ابن جدار","https://www.aldiwan.net/poem36428.html","الطويل"],[37,"ألم تربع فتخبرك الطلول","https://www.aldiwan.net/poem39107.html","الوافر"],[37,"أصادرة حجاج كعب ومالك","https://www.aldiwan.net/poem39124.html","الطويل"],[74,"دع الخوض في الكلم الجاحظي","https://www.aldiwan.net/poem19147.html","المتقارب"],[53,"سقيتن يا منزلات الهوى","https://www.aldiwan.net/poem8117.html","المتقارب"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[34,"إلى القرم الذي كانت يداه","https://www.aldiwan.net/poem27736.html","الوافر"],[30,"غنمنا فقيما إذ فقيم غنيمة","https://www.aldiwan.net/poem5521.html","الطويل"],[2,"تبين خليلي هل ترى من ظعائن","https://www.aldiwan.net/poem25003.html","الطويل"],[2,"صحا القلب عن سلمى وأقصر باطله","https://www.aldiwan.net/poem25063.html","الطويل"],[51,"جمعت من الدنيا وحزت ومنيتا","https://www.aldiwan.net/poem10833.html","الطويل"],[82,"تدرعت صبري جنة للنوائب","https://www.aldiwan.net/poem31551.html","الطويل"],[46,"على مثلها من أربع وملاعب","https://www.aldiwan.net/poem30579.html","الطويل"],[33,"ألا يا هند قد زودت قلبي","https://www.aldiwan.net/poem42512.html","الوافر"],[41,"طربت وشاقك البرق اليماني","https://www.aldiwan.net/poem53730.html","الوافر"],[52,"يطوف العفاة بأبوابه","https://www.aldiwan.net/poem62252.html","المتقارب"],[52,"ونبئت قوما بهم جنة","https://www.aldiwan.net/poem62253.html","المتقارب"],[52,"ألا يا نفس المسك الذي","https://www.aldiwan.net/poem63800.html","الهزج"],[7,"كليني لهم يا أميمة ناصب","https://www.aldiwan.net/poem2017.html","الطويل"],[48,"إذا ما غضوب غاضبت كل ريبة","https://www.aldiwan.net/poem22817.html","الطويل"],[108,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[52,"أبَى طَلَلٌ بِالجِزْعِ أَنْ يتكلما","https://www.poetsgate.com/ViewPoem.aspx?id=31087",""],[147,"كفى الدين عزا ما قضاه لك الدهر","https://www.aldiwan.net/poem11758.html","الطويل"],[164,"سهام مقاها فاحذروها صوائب","https://www.aldiwan.net/poem59016.html","البسيط"],[199,"غشيت بعفرى أو برجلتها ربعا","https://www.aldiwan.net/poem54401.html","الطويل"],[234,"أغيب ولي مهجة لا يزال","https://www.aldiwan.net/poem51116.html","البسيط"],[240,"لنا صاحب قالص ظله","https://www.aldiwan.net/poem31903.html","المتقارب"],[285,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[287,"إذا ما غاب شخصك عن عياني","https://www.aldiwan.net/poem32374.html","الوافر"],[287,"ألا هل إلى باب البريد سبيل","https://www.aldiwan.net/poem32669.html","الطويل"],[327,"أتصرم أم تواصلك النجود","https://www.aldiwan.net/poem56354.html","الوافر"],[354,"متى منا محب مدعينا","https://www.aldiwan.net/poem15978.html","الوافر"],[368,"أشاقتك أظعان بجفن يبنبم","https://www.aldiwan.net/poem1707.html","الطويل"],[369,"أقلا عند طيتي المقالا","https://www.aldiwan.net/poem60808.html","الوافر"],[369,"زمان قليل من بنيه نجيب","https://www.aldiwan.net/poem60998.html","الطويل"],[408,"أيا وجد أبقيت حتى على صبري","https://www.aldiwan.net/poem46745.html","الطويل"],[422,"تنفس عن وجد توقد جمره","https://www.aldiwan.net/poem54071.html","الطويل"],[457,"وعصفورة للتوت تشدو موقعا","https://www.aldiwan.net/poem13893.html","الطويل"],[466,"إذا ما غزوتم معلمين فراوحوا","https://www.aldiwan.net/poem15096.html","الطويل"],[469,"رأى وقفة البين خطباً فطيعاً","https://www.aldiwan.net/poem3503.html","عموديه"],[482,"أعن أرض الغميم لمحت نارا","https://www.aldiwan.net/poem15207.html","الوافر"],[534,"على عصر الشبيبة كل حين","https://www.aldiwan.net/poem37469.html","الوافر"],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198607","الوافر"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126768","الوافر"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126862","الوافر"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103067","الطويل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34412","الطويل"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34771","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62484","الطويل"],[1177,"","https://poetry.dctabudhabi.ae/diwan/poem/28382","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56204","الطويل"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79457","الطويل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137848",""],[1418,"","https://poetry.dctabudhabi.ae/diwan/poem/114836","الطويل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115977","الطويل"],[1576,"","https://poetry.dctabudhabi.ae/diwan/poem/205762","الطويل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46459","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77343","الطويل"],[2253,"","https://poetry.dctabudhabi.ae/diwan/poem/115136","الطويل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21460","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106870","المتقارب"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93580","الطويل"],[2508,"","https://poetry.dctabudhabi.ae/diwan/poem/205973","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129887","الطويل"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113853","الوافر"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103508","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65330","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132783","الطويل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121675","الوافر"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203545","الوافر"],[3488,"","https://poetry.dctabudhabi.ae/diwan/poem/28824","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/63009","الطويل"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103622","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48320","الطويل"],[3527,"","https://poetry.dctabudhabi.ae/diwan/poem/97670","الطويل"],[3619,"","https://poetry.dctabudhabi.ae/diwan/poem/33114","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110034","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133164","الطويل"],[1372,"فديتُ غزالاً راقني دُرُّ شعرهِ","https://www.poetsgate.com/ViewPoem.aspx?id=15808",""],[5367,"وِداد","https://www.poetsgate.com/ViewPoem.aspx?id=197454",""],[5376,"بنو قومي أنا منهم وأنِّي","https://www.poetsgate.com/ViewPoem.aspx?id=197598",""],[5430,"وداعا سماحة الشيخ","https://www.poetsgate.com/ViewPoem.aspx?id=1444",""],[5431,"وأعشقه وأعشقها عيوبه","https://www.poetsgate.com/ViewPoem.aspx?id=186133",""],[5431,"ويرقص حول بركاني..","https://www.poetsgate.com/ViewPoem.aspx?id=191417",""],[5956,"فقاعة متغطرسة","https://www.poetsgate.com/ViewPoem.aspx?id=192425",""],[6364,"قبر في المرج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82466&r=&rc=5",""]],"verses":[["إِذا ما غَضِبنا كادَتِ الأَرضُ تَنطَوي","حِفاظاً وَيَرمي الأُفقُ بِالأَنجُمِ الزُهرِ",0,"ر",1,0],["إذا ما غَسَلْتُ العارَ عنّي لمْ أُبَلْ","نِداءَ زَعيمِ الحَيّ بَشَّرَ أو نَعى",1,"ع",2,0],["إِذا ما غَضِبَ العاشِ","قُ فَالغايَةُ أَن يَرضى",2,"ا",1,0],["إذا ما غرَسْنَ الوعْدَ في روضَةِ الهَوى","جَنَيْتُ علَى أغْصانِهِ ثمَرَ الخُلْفِ",3,"ف",1,0],["إذا ما غرَسْتَ الخيْرَ في ابْنِ جِدارِ","ظَفِرْتَ بكَنْزٍ منْهُ تحْتَ جِدارِ",4,"ر",1,1],["إِذا ما غالِيَ الحَمدِ اِشتراهُ","فَما إِن يَستَقِلُّ وَلا يُقيلُ",5,"ل",1,0],["إِذا ما غَدا يَهتَزُّ لِلمَجدِ وَالنَدى","أَشَمُّ كَغُصنِ البانَةِ المُتَوَرِّقِ",6,"ق",1,0],["إذا ما غرقت بمثل ابن بحر","وجدت النجاة بمثل ابن شطّ",7,"ط",1,0],["إذا ما غدونَ لِطافَ الخصورِ","خفافَ الصدورِ ثِقالَ الخُطا",8,"ا",1,0],["إذا ما غدا الغادي إليه فإنه","على ثقةٍ أنْ ليس في الطير أشأمُ",9,"م",1,0],["إِذا ما غالِيَ الحَمدِ اِشتَراهُ","فَما إِن يَستَقيلَ وَلا يُقيلُ",10,"ل",1,0],["إِذا ما غَدا مِن مَنزِلٍ سَهَّلَت لَهُ","سَنابِكُهُ صُمَّ الصُوى وَمَناسِمُه",11,"م",2,0],["إِذا ما غَشوا الحَدّادَ فَرَّقَ بَينَهُم","جِفانٌ مِنَ الشيزى وَراءَ جِفانِ",12,"ن",1,0],["إِذا ما غَدَونا نَبتَغي الصَيدَ مَرَّةً","مَتى نَرَهُ فَإِنَّنا لا نُخاتِلُه",13,"ل",2,0],["إِذا ما غُبِنتَ الفَضلَ في الدينِ لَم تُبَل","وَإِن كانَ في الدُنيا قَطَبتَ وَبالَيتا",14,"ت",2,0],["إذا ما غَزَوْا في الرّومِ كان دخولُهُمْ","بطونَ الخلايا في مُتون السّلاهِبِ",15,"ب",1,0],["إِذا ما غَدا أَغدى كَريمَةَ مالِهِ","هَدِيّاً وَلَو زُفَّت لِأَلأَمِ خاطِبِ",16,"ب",1,0],["إِذا ما غِبتِ كادَ إِلَيكِ قَلبي","فَدَتكِ النَفسُ مِن شَوقٍ يَطيرُ",17,"ر",1,0],["إِذا ما غِبتُ عَنهُم أَوعَدوني","وَإِن ضارَستُهُم كَرِهوا قِراني",18,"ن",2,0],["إِذا ما غَضِبنا غَضبَةً مُضَرِيَّةً","هَتَكنا حِجابَ الشَمسِ أَو تُمطِرَ الدَما",19,"م",2,0],["إِذا ما غَزا بَشَّرَت طَيرُهُ","بِفَتحٍ وَبَشَّرَنا بِالنِعَم",20,"م",1,0],["إِذا ما غَبتَ لَم أَغفُ","وَلَم أَسمَع وَلَم أُبصِر",21,"ر",1,0],["إِذا ماغَزوا بِالجَيشِ حَلَّقَ فَوقَهُم","عَصائِبُ طَيرٍ تَهتَدي بِعَصائِبِ",22,"ب",1,0],["إِذا ما غَضوبٌ غاضَبَت كُلَّ رَيبَةٍ","وَكانَت لَميسٌ لا تَقِرُّ عَلى اللَمسِ",23,"س",1,1],["إذا ما غفوا فهْيَ نعم الوسادُ","ونعم الوِطاءُ، ونعم الغطاء",24,"ا",2,0],["إذا ما غضبنا غضبة ٍ مضرية ً","هَتَكْنَا حِجَابَ الشَّمْسِ أوْ تُمطِر",25,"م",3,0],["إِذا ما غَمامٌ خَصَّ أَرضاً بِغَيثِهِ","هَمى هاطِلاً في كُلِّ قُطرٍ لَها قَطرُ",26,"ر",1,0],["إذا ما غزا في موكب سار قبله","من النصر والفتح المبين مواكب",27,"ب",1,0],["إِذا ما غَلا غالَيتَهُ غَيرَ ظالِمٍ","وَلَم تَستَطِع لِلمَجدِ ظُلماً وَلا بَتعا",28,"ع",2,0],["إذا ما غدتْ لك عندي يدٌ","تعاظَم في الفضل تأثِيرها",29,"ر",3,0],["إِذا ما غَدَونا إِلى بابِهِ","غَدَونا بِطاناً وَرُحنا خِماصا",30,"ص",2,0],["إِذا ما غَدَوْنا عَلَى لَذَةٍ","فَحَظُّ مُفارِقَنا الأَنْقَصُ",31,"ص",1,0],["إِذا ما غابَ شَخصُكَ عَن عِياني","رَثى لي حاسِدي مِمّا أُعاني",32,"ن",2,1],["إِذا ما غِياثُ الدينِ غاثَ بِجودِهِ","جَرَت فَوقَ أُكمِ المُعتَفينَ سُيولُ",33,"ل",1,0],["إِذا ما غَزا غازي الأَعادي فَكُلُّهُم","بُغاثٌ عَلَيها بِالبُزاةِ يَصولُ",33,"ل",1,0],["إِذا ما غِبتُ عَنهُم أَوعَدوني","وَأَيُّ الناسِ يَقتُلُهُ الوَعيدُ",34,"د",1,0],["إِذا ما غابَ في الظَلماءِ رُحنا","بِلا ضَوءٍ وَإِن آبَ اِغَتَدَينا",35,"ن",2,0],["إِذا ما غَدا لَم يُسقِطِ الخَوفُ رُمحَهُ","وَلَم يَشهَدِ الهَيجا بِأَلوَثَ مُعصِمِ",36,"م",1,0],["إذا ما غَبَّ رِفْدُكَ صار عِبْئاً","وخيرُ الأْمرِ أحمَدُهُ مَآلا",37,"ل",2,0],["إذا ما غدا في سَرْجه وهْو قُعدَةٌ","فإنّ فؤادي المُستهامَ جَنيب",38,"ب",1,0],["إذا ما غَزت ألحاظُه قلْبَ عاشقٍ","تعودُ سريعاً بالْغَنيمةِ والنَّصر",39,"ر",1,0],["إذا ما غزا معروفه النكر مَرَّةً","فلله مغزاه وبالله نصره",40,"ر",2,0],["إِذا ما غدت تزقو حكى لك صوتها","صريرَ اهتزازِ التختِ في ليلة الوصل",41,"ل",1,0],["إذا ما غزوتم مُعْلمين فراوحوا","بني دارمٍ بين الظُّبى والمخائل",42,"ل",1,1],["إذا ما غربنَ شموسَ القبا","ب فلا وهب الله شمساً طلوعاً",43,"ع",2,0],["اِذا ما غاضَ دمعٌ فاضَ دمعٌ","يَسُحُّ على مرابِعها انهمارا",44,"ر",2,0],["إذا ما غَابَ يَلْمِزُهُ أُناسٌ","وهُمْ عِنْدَ الْحُضُورِ لَهُ سُجودُ",45,"د",1,0],["إِذَا مَا غِبْتَ غاَبَ النُّورُ عَنَّا","فَأَنْتَ الْبَدْرُ غَيَّبَهُ الأُفُولُ",46,"ل",1,0],["إذا ما غِبتَ أيّاماً لأمرٍ","فَما نَسِيَت لكَ الأحبابُ ذِكرا",47,"ر",2,0],["إذا ما غابَ عن عينيّ يوماً","وقلبي في مودّته مقيمُ",48,"م",1,0],["إذا ما غشاها أسبل الستر دونه","فتُسفر عن وضع به سفراته",49,"ت",2,0],["إِذا ما غَزا وَالحَربُ قَد شَهِدَت لَهُ","تَرى اللَيثَ مِن بأسِ الشُجاعِ مُلدَّغا",50,"غ",2,0],["إذا ما غدا الطلاّب للعلم ما لهم","من الحظّ إلاّ ما يدوّن في الكتب",51,"ب",1,1],["إذا ما غدت تجري كزورق عسجد","ففي الجو بحر إن جرت فيه راكدُ",52,"د",1,0],["إِذا ما غَنمنا مَغنَماً كانَ قِسمَةً","وَلَم نَتَّبِع رَأيَ الشَّحيحِ المتارِكِ",53,"ك",1,0],["إذا ما غشا الأهوال وانقض واثباً","على الجيش قالوا ما الدريد وعنترُ",54,"ر",1,0],["إذا ما غدا للشعرِ يُغري بنظمِهِ","غدوتُ لعقدِ الدمعِ أغري بنثرِهِ",55,"ر",2,0],["اذا ما غض عنك الليث طرفا","فليس لك الامان من الشبول",56,"ل",1,0],["إذا ما غَضِبنا غَضبةً مُضَرِيَّةً","هتكنا حِجابَ الشمسِ أو قَطَرَت دما",57,"م",2,0],["إذا ما غزونا بلدةً عزَّ قومُها","أعَدنا عزيزَ القومِ وهوَ ذليلُ",58,"ل",1,0],["إذا ما غفرت الذنب يوماً لصاحب","فلست معيداً ما حييت له ذكرا",59,"ر",2,1],["إِذا ما غَزَونا أَرض آل عَنيزةٍ","غَزت مَعناً عُقبانها وَنُسورَها",60,"ه",2,1],["إِذا ما غَزا أَرضَ العُداةِ تَنَكَّسَت","مَعالِمُها ذُلّاً فَهُنَّ أَسافِلُ",61,"ل",1,0],["إذا ما غدَت طلابةُ العلم مالها","من العلمِ إلّا ما يخلّدُ في الكتبِ",62,"ب",1,1],["إِذا ما غَدا يَوماً رأَيت غَيايَةً","مِنَ الطَّير يَنظُرنَ الَّذي هُوَ صانِعُ",63,"ع",1,0],["إذا ما غنمت وأما غرمت","سواءً جلا وجهك المبسمُ",64,"م",1,0],["إِذا ما غَزا فَالكَون يَرجف خيفة","وَتَهتَز مِنهُ الأَرض وَالحَجر الصَلد",65,"د",1,0],["إذا ما غدت طلابة العلم تبتغي","من العلم يوماً ما يخلد في الكتب",66,"ب",1,1],["إذا ما غرابُ البين لاح فقل له","ترفّق رماكَ اللّه يا طيرُ بالبُعدِ",67,"د",1,1],["إذا ما غاب قاضي مصر عنها","وقالوا من لها والقول صدق",68,"ق",1,1],["إذا ما غَدَونا نبتَغي الصَيدَ أسمَحت","لنا نَفسُهُ إلّا تُريق لَهُ دما",69,"م",2,0],["إذا ما غدا في زيّه مُتنكّرا","غزالٌ به زادت جوالبُ تهيامي",70,"ي",1,1],["إذا ما غروب الدمع جفت من البكا","فذائب أحشائي يمد المئاقيا",71,"ي",2,0],["إذا ما غاب مَن أهْواهُ عَنِّي","فإنَّ لِقاءَه عندي كِتابُ",72,"ب",1,1],["إذا ما غاب فالأوطانُ حقُّ","ولو أني ملكتُ بلاد بُصرى",73,"ر",2,0],["إِذا ما غَدَوتُم عامِدينَ لِأَرضِنا","بَنِي عامِرٍ فَاِستَظهِروا بِالمَرائِرِ",74,"ر",1,1],["اذا ما غدا مثلَ الحديدِ فؤادُهُ","فوالعصر انَّ الاشقينَ لفي خُسْرِ",75,"ر",1,0],["إذا ما غراب الليل مدّ جناحه","عليّ وغطاني بريش قوادم",76,"م",1,1],["إذا ما غَمامٌ سارَ أو علَمٌ رَسا","فمِنْكَ النّدى والحِلْمُ أرْجى وأرْجَحُ",77,"ح",1,0],["إِذا ما غَدا فيها غدوّاً كأنّهم","نجومُ سماءٍ بينهنّ هِلالها",78,"ل",3,0],["إِذا ما غابَ نَجمٌ آبَ نَجمٌ","أَغَرُّ نَرى لِطَلعَتِهِ اِبتِساما",79,"م",2,0],["إذا ما غَشِيتَ الفُحشَ والعار يا فتى","عَجِبتُ لأرضٍ أَنَّها لا تَزَلزَلُ",80,"ل",1,0],["إذا ما غشاه الليل بات مسهداً","يحن على الألاف بالأمس في النادي",81,"د",2,0],["إذا ما غدا للشعرِ يُغري بنظمِهِ","غدوتُ للعقدِ الدمعِ أغري بنثرِهِ",82,"ر",2,0],["إذا ما غَشانا يا حبيبتيَ النَّوى","فلنْ تَجِدي عن عهْدِنا مُتَمَلِّلا",83,"ل",2,0],["إذا ما غبْت ُعنها بارتحالٍ","تلازمني ويقتلني اصطبارُ",84,"ر",1,0],["إذا ما غبت عن نظرٍ","ففي الفتوى لكم أثرُ",85,"ر",1,0],["إذا ماغاب عني طرف عين","أتوق له ..وأحسبها عقوبةْ!",86,"ب",2,0],["إذا ماغاب عن عيني قليلا","أذوق السم أجرعه زؤاما",87,"م",2,0],["إذا ما غرّد \"النحوي\" فنوحوا","وطيروا إنّ بيته في الكبولِ",88,"ل",1,0],["إذا ما غفا قلبي أهاب به صدى","ليالٍ تلاشت في المآسي الدوائرِ",89,"ر",1,0]]}