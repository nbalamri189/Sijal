 وولاء","https://www.poetsgate.com/ViewPoem.aspx?id=209113",""],[5605,"مصائب حب","https://www.poetsgate.com/ViewPoem.aspx?id=159789",""],[5625,"حوار حبيبين تحت الدمار","https://www.poetsgate.com/ViewPoem.aspx?id=182887",""],[5628,"حب فوق العادة","https://www.poetsgate.com/ViewPoem.aspx?id=179814",""],[5703,"الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=216044",""],[5725,"حفظتك في قلبي عراقا مبجلا","https://www.poetsgate.com/ViewPoem.aspx?id=179745",""],[4623,"دعوني فاني لست أخشى من العين (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146684",""],[5829,"وقلب العاشقين هنا يذوب","https://www.poetsgate.com/ViewPoem.aspx?id=210213",""],[5853,"أفول شعر الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=175720",""],[5897,"همسة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=156356",""],[5897,"على جناح أمنية","https://www.poetsgate.com/ViewPoem.aspx?id=156541",""],[5937,"الثُّقب الأسود","https://www.poetsgate.com/ViewPoem.aspx?id=214121",""],[5953,"عبد عين العيون يا ذا الأمير","https://www.poetsgate.com/ViewPoem.aspx?id=93811",""],[5957,"أحبكَ أكثر مما مضى","https://www.poetsgate.com/ViewPoem.aspx?id=119167",""],[5977,"منهل الحب","https://www.poetsgate.com/ViewPoem.aspx?id=213084",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""],[6068,"ويَوْم لَا كَيَوْم أَحُلّ بُوحَي -08-","https://www.poetsgate.com/ViewPoem.aspx?id=175806",""],[6125,"هي الحبُّ المُعَتَّقُ في دِمَائي","https://www.poetsgate.com/ViewPoem.aspx?id=210959",""],[6125,"متى تأتين ؟","https://www.poetsgate.com/ViewPoem.aspx?id=210961",""],[6147,"رقاد في جوف الجنون","https://www.poetsgate.com/ViewPoem.aspx?id=213050",""],[6152,"حبك عالمي الأروع","https://www.poetsgate.com/ViewPoem.aspx?id=204685",""],[6152,"حبكِ نقي الضياء","https://www.poetsgate.com/ViewPoem.aspx?id=208664",""],[6152,"أنتِ مسك الختام","https://www.poetsgate.com/ViewPoem.aspx?id=213163",""],[5355,"عن الحبّ الذي ولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87125&r=&rc=20",""],[5957,"فحبكَ عندي فراتٌ ونيلٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82451&r=&rc=90",""],[6247,"الحياة التفات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80275&r=&rc=14",""],[454,"إكسير الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82636&r=&rc=0",""],[6345,"يؤرقني الضياعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78671&r=&rc=42",""]],"verses":[["فحبّهُمْ عِصْمَةُ كُلِّ مُتَّقٍ","وهُمْ مَصابيحُ الهُدى لمَنْ غَوى",0,"ا",1,0],["فَحَبَستُ فيها الرَكبَ أَحدُس فيُ","جُلِّ الأُمورِ وَكُنتُ ذا حَدسِ",1,"س",1,0],["فَحُبُّ عُلاَكَ إيمَانِي وَعَقْدِي","وَشُكْرُ نَدَاكَ دِينِي وَانْتِحَالِي",2,"ل",2,0],["فَحَبّاتُ القُلوبِ تَسوقُ شُكراً","إِلَيكَ بِقَدرِ حَبّاتِ الغِلالِ",3,"ل",1,0],["فَحُبّاً أَيُّهَا الوْطَنَانِ إِنَّي","وَسِيط الْعِقْدِ فِي هَذَا النِّظَامِ",4,"م",1,0],["فحبّ سواه في الأفواه جارٍ","ولكن حبّه بلغ الشغافا",5,"ف",2,0],["فحبكم فرضٌ على قلبه","وقلبهُ من خجلٍ واجب",6,"ب",1,0],["فحبَّذا في البلادِ ما جمعت","في الحسنِ من عينها وحاجبها",7,"ه",2,0],["فحبذا رفدك المعنى","وحبَّذا وقتنا المريع",8,"ع",1,0],["فحبذا اللغز من فاتح","ودك لي من بعد إغفالك",9,"ك",1,0],["فحبَّذا برّه رضاعاً","وحبَّذا رأيه كفاله",10,"ل",2,0],["فحبَّذا من جوارِ خير","أفادَ قصدي جواد خيل",11,"ل",1,0],["فحبَّذا لمادحيه الندى","وأنعمُ الله ورضوانه",12,"ن",2,0],["فحبَّذا السطور في المهارق","منقوطة الأحرف بالبنادق",13,"ق",1,0],["فحُبَّ به جسماً إلى الأرض إذ هوى","وحُبَّ به روحاً إلى الله تعرجُ",14,"ج",1,0],["فَحَبا بِكُلِّ مَسَرَّةٍ","قَلبَ المُحِبِّ وَطَرفَهُ",15,"ف",2,0],["فحبذا الفن وحبذا","اغاني نادره",16,"ر",2,0],["فَحُبُّ الجَبانِ النَفسَ أَورَدَهُ التُقى","وَحُبُّ الشُجاعِ النَفسَ أَورَدَهُ الحَربا",17,"ب",2,0],["فَحُبُّكَ أَغشاني بِلاداً بَغيضَةً","إِلَيَّ وَرومِيّاً بِعَمّانَ أَقشَرا",18,"ر",2,1],["فحبُستَ خِلالَها بمسوَّماتٍ","يَشُقُّ على الجنائبِ ما تُسامُ",19,"م",1,0],["فَحُبُّ المَرءِ طولَ العُمرِ جَهلٌ","وَقِسمَتَهُ عَلى هَذا المِثالِ",20,"ل",1,0],["فَحُبُّكَ في قَلبي وَذِكرُكَ في فَمي","وَشَخصُكَ في عَيني وَلَفظُكَ في أُذني",21,"ن",2,0],["فَحَبَّذا العاصي وَطيبُ شِعبِه","وَمائِهِ المُسَلسَلِ المُجَعَّدِ",22,"د",1,0],["فحبُّهُ رحمةٌ علينا","وسبُّهُ نقمةٌ عليهمْ",23,"م",1,0],["فَحَبَّذا نُطفَةٌ تَنساغُ بارِدَةٌ","مِن مَنهَلٍ طامِحِ الآذِيَّ سَلسالِ",24,"ل",1,0],["فَحُبُّكِ في قَلبي مُقيمٌ مُصَوَّرٌ","وَحُبُّكِ في الأَحشاءِ وَسطَ ضَميرُها",25,"ر",3,0],["فَحُبُّكِ أَنساني الشَرابَ وَبَردَهُ","وَحُبُّكِ أَبكاني بِكُلِّ مَكانِ",26,"ن",1,1],["فَحُبّي لَها حُبٌّ تَمَكَّنَ في الحَشا","فَما إِن أَرى حُبّاً يَكونُ لَهُ مِثلُ",27,"ل",1,0],["فَحبابها الأَرواح قَد","وَثبت إِلَيك كَما وَثَب",28,"ب",1,0],["فَحَبَاهَا بِرّاً تَوَهَّمَتِ النَّا","سُ به أنَّما السِّبَاء هِداءُ",29,"ا",2,0],["فَحُبَيٌّ فَالثَغرُ فَالصَفحُ فَالأَج","دَادُ قُفرٌ فالكُورُ كُورُ أُثالِ",30,"ل",1,0],["فحبَّذا تلك من سهل وأودية","وحبذا هضب الأوطان من هضب",31,"ب",1,0],["فَحبذا أَنتَ من حسناء فاتنة","وَحبذا منك تلك الأعين النجل",32,"ل",1,0],["فَحَبَاكَ رَبُّكَ بِالْجَمِيلِ كَرَامَةً","لِجَزِيلِ مَا أَوْلَيْتَ أُمَّةَ أَحْمَدِ",33,"د",1,0],["فَحُبُورُهَا بِقِرَانِ أَكْبَرِ وُلْدِهَا","رَدَّ النُّفُوسَ وَقدْ مُلِئنَ حُبُورَا",34,"ر",2,0],["فحباها وَحْدَةً ما عرفتْ","في الهَوى حدّاً لأقصى بلدينْ",35,"ن",1,0],["فحبذا هُوَ من سَاق نعمت بِهِ","وَإِن تعرض فِيهِ ذكر عرقوب",36,"ب",1,0],["فحبذا لغزك من فاتح","ودك لي من بعد اغفالك",37,"ك",1,0],["فحبتْه بالمُتَع الروائعِ كلِّها","ورَمَت عليه جمالَها ألوانا",38,"ن",2,0],["فحُبُّ الجَبَانِ النّفْسَ أوْرَدَهُ البَقَا","وَحُبُّ الشّجاعِ الحرْبَ أوْرَدهُ الحرْبَا",39,"ب",2,0],["فَحَباكَ الَّذي بَراكَ بِأَلطا","فٍ تَوالى مِن أَنفَسِ الأَلطافِ",40,"ف",1,0],["فَحَبسٌ ذا الثَناءُ عَلَيكَ إِنّي","وَجَدتُكَ في مَحَبَّتِهِ عَريقا",41,"ق",2,0],["فحبي حبي والهوى ذلك الهوى","لدي وودي فيكم ذلك الودُّ",42,"د",1,0],["فحب سواه في الاحشاء داء","وغرس وداده في القلب نامى",43,"م",2,0],["فحبي عذرى ثم عذري واضح","فيا عاذلي تب لا تلم عاشقا تبلى",44,"ل",2,0],["فحب الورى الإسلام قد مازج الدما","وقد خالط الامشاج واللحم والأشلا",45,"ل",2,0],["فحبّ خديعة لمكان رفق","متى ما زال ذمّك من قريب",46,"ب",1,0],["فَحَباهُم برّاً وبُرءاً فَعادوا","وَهُم م