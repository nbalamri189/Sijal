//www.poetsgate.com/ViewPoem.aspx?id=185033",""],[4727,"ألا ليت حكام الجزائر نسوةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215839",""],[4578,"غرامي بالعذارى البيض أسمى","https://www.poetsgate.com/ViewPoem.aspx?id=49520",""],[3271,"من نار السكينة","https://www.poetsgate.com/ViewPoem.aspx?id=128739",""],[585,"سمعت صريف الباب وهو يسبح","https://www.poetsgate.com/ViewPoem.aspx?id=161931",""],[585,"خلا المجال وأودى الشاعر العلم","https://www.poetsgate.com/ViewPoem.aspx?id=161942",""],[585,"لك الله من منقض قصرٍ لدى القفر","https://www.poetsgate.com/ViewPoem.aspx?id=161871",""],[5147,"سبرت مقاييس العراق فلاح لي","https://www.poetsgate.com/ViewPoem.aspx?id=166736",""],[5151,"نبيذان من ثغر","https://www.poetsgate.com/ViewPoem.aspx?id=189984",""],[5183,"الحشايا","https://www.poetsgate.com/ViewPoem.aspx?id=186615",""],[5183,"سَعد وسُعَيد","https://www.poetsgate.com/ViewPoem.aspx?id=180217",""],[5183,"إلى الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=180189",""],[5183,"وادي الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=180171",""],[5219,"إلى ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=197095",""],[5277,"أتدرين","https://www.poetsgate.com/ViewPoem.aspx?id=185290",""],[5277,"رسائلُ عشقٍ بغدادية..4","https://www.poetsgate.com/ViewPoem.aspx?id=191525",""],[5302,"ما أعذب العشق","https://www.poetsgate.com/ViewPoem.aspx?id=200599",""],[5302,"سأمضي","https://www.poetsgate.com/ViewPoem.aspx?id=200676",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5442,"دع الصب يدمع منه المآقيا","https://www.poetsgate.com/ViewPoem.aspx?id=114761",""],[5595,"إنّ العراقَ أبيّ ٌ أينما ذهبوا","https://www.poetsgate.com/ViewPoem.aspx?id=144531",""],[5605,"مصائب حب","https://www.poetsgate.com/ViewPoem.aspx?id=159789",""],[5691,"شرفة الأيام...","https://www.poetsgate.com/ViewPoem.aspx?id=206875",""],[5701,"رفيع القدر حيانا","https://www.poetsgate.com/ViewPoem.aspx?id=164703",""],[5722,"الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=12690",""],[5790,"دنوت وقد أبدى الكرى منه ما أبدى","https://www.poetsgate.com/ViewPoem.aspx?id=111995",""],[5956,"عِشْ مَعَ النباتِ والجمادِ","https://www.poetsgate.com/ViewPoem.aspx?id=184145",""],[6031,"هِيَ الدارُ تَستسقيكَ مَدْمَعَكَ الجاري","https://www.poetsgate.com/ViewPoem.aspx?id=46266",""],[6032,"ترنيمة عشق إلهية","https://www.poetsgate.com/ViewPoem.aspx?id=181501",""],[6069,"بعزمك أيها الملك العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=105705",""],[6086,"ذات همة !!","https://www.poetsgate.com/ViewPoem.aspx?id=29238",""],[6234,"الربيع الفاتن في نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6538&r=&rc=5",""],[406,"نقش على حائط الجراح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63257&r=&rc=76",""],[6300,"عروس أنتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82838&r=&rc=9",""],[5190,"بلادي لم تزل للنور نبعاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85060&r=&rc=135",""],[5190,"عندما تعاتبني ابنتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78339&r=&rc=52",""],[572,"وََمَثّلَهُ لِي المُنّى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9268&r=&rc=125",""]],"verses":[["وَأَبصَرتُ أَدنى صاحِبيَّ يَهُزُّهُ","عَلى طَرَبٍ مِيلُ السَّوالِفِ قُودُ",0,"د",1,0],["وأُبْصِرُ خامِلاً يَجْفو نَبيهاً","وأسْمَعُ عالِماً يَشكو جَهولا",1,"ل",2,0],["وأبْصَرَتِ التّوْديعَ حقّاً فلَمْ تُطِقْ","غَداتَئِذٍ كتْماً لبَعْضِ الذي تُخْفي",2,"ف",2,0],["وأبْصَرْتُ رسْمي رَسْماً مَحيلا","وأبْصرْتُ وصْفيَ وصْفاً مُعارا",3,"ر",2,0],["وأبْصَرْتُمُ نورَ النّبوّةِ ساطِعاً","قدِ اكْتَنَفَ التّرْبَ المقدَّسَ واللّحْدا",4,"د",2,0],["وأبْصَرَ سَيْفُ المُلْكِ رُؤْيا فأصْبَحَتْ","لتَذْكارِها تَرْتاعُ منْهُ الجَوارِحُ",5,"ح",1,0],["وَأَبصَرتَ أُنسَ الزُهدِ في وَحشَةِ البِلى","وَشاهَدتَ وَجهَ الشَيخِ وَهوَ مُنيرُ",6,"ر",1,0],["وَأَبْصَرَ فِي تَرَائِبِهِ صُدُوعاً","عَلَى دَخَلٍ يَعِزُّ لَهَا الْتِئَامُ",7,"م",1,0],["وَأَبصَرتُ سَلمى بينَ بُردَي مَراجِلِ","وأَبراد عَصبٍ مِن مُهَلهَلةِ اليَمَن",8,"ن",1,0],["وَأَبصَرتُهُم حَتَّى رَأَيتُ قِيانَهُم","هَتَكنَ السُتورَ وَاِنتَزَعنَ الأَواخيا",9,"ي",2,0],["وَأَبصَرنُ أَنَّ النَقعَ صارَت نِطافُهُ","فِراشاً وَأَنَّ البَقلَ ذاوٍ وَيابِسُ",10,"س",1,0],["وأبصَرَتِ الأبصار شَمْسَ هداية","وأشرقت الأرجاءُ من زُهر رفدِهِ",11,"د",2,0],["وأبصرَ المسكَ وبدرَ الدُّجى","فقالَ ذا خالِي وهذا أخي",12,"ي",1,0],["وأبصر فيما تحت صدغيه من سناً","خيالي خلوقاً تحت محراب مسجد",13,"د",1,0],["وأبصر في إقصارهِ عنك رُشدَهُ","بعاقبةٍ من رأيه المُتعقَّبِ",14,"ب",1,0],["وأبصرتُ في خدَّيْهِ ماءً وخضرةً","فما أملح المرعى وما أعذب الوِرْدا",15,"د",2,0],["وَأَبصَرنَ إِذ أَجلَينَ عَن كُلِّ تَولَبٍ","أَبا الشِبلِ بَينَ الغَيضِ وَالفَيضِ ماثِلا",16,"ل",2,0],["وَأَبصَرتُ لِصّاً عَلى الزاوِيَه","كَثيرَ التَلَفُّتِ نَحوَ القُصور",17,"ر",1,0],["وَأَبصَرتُ شَخصاً كَثيرَ الحَذَر","فَرُحتُ أَبُثُّ لَهُ لَوعَتي",17,"ي",1,0],["وَأَبصَرَ النَصلَ تُخفيهِ أَنامِلُها","فَراحَ يَركُضُ نَحوَ البابِ مُنذَعِرا",18,"ر",2,0],["وابصر ومضا نائيا وهوغامض","واسمع همسا دانيا وهو مبهم",19,"م",1,0],["وَأَبصَرتَ إِسكَندَراً في المَلا","قَشيبَ العُلا في الشَبابِ النَضِر",20,"ر",1,0],["وَأَبصَرَ مِنكَ الرِزقَ وَالرِزقُ مُطمِعٌ","وَأَبصَرَ مِنهُ المَوتَ وَالمَوتُ هائِلُ",21,"ل",1,0],["وَأَبصَرَ مِن زَرقاءِ جَوٍّ لِأَنَّني","إِذا نَظَرَت عَينايَ ساواهُما عِلمي",22,"م",2,0],["وأبصر ما فَوَّتْنَ نفسي وأُسرتِي","فغرَّمَها حتى دهور الشبائبِ",23,"ب",1,0],["وَأَبصِر كَيفَ تَنبو بِالأَعادي","مَناكِبُها إِذا قُرِعَت صَفاتي",24,"ت",2,0],["وَأَبصَرَ جِسمي أَنَّ خَصرَكِ ناحِلٌ","فَحاكاهُ لَكِن زادَني دِقَّةَ المَعنى",25,"ن",2,0],["وأبصرتَ حُمْرَ دموعِ الجفونِ","لقلتَ تَعَلّقَ منها العلق",26,"ق",1,0],["وأبْصَرهُ مُعاويةٌ فَجَلَّى","سَرِيرَةَ نفسهِ النَّظرُ الحديدُ",27,"د",1,0],["وَأَبصَرتُ دَهراً لا يَقُومُ لِأَهلِهِ","عَلى ما أَحَبُّوا فاسِدٌ يَتَحَوَّلُ",28,"ل",1,0],["وأبْصَرَتِ الذّوَابِلُ منه عَدْلاً","فأصْبَحَ في عَوَامِلِها اعْتِدالا",29,"ل",2,0],["وأبصر الشمس حين تبدو","أشعة الشمس كالنُضار",30,"ر",1,0],["وأبصرتُ من حولها الكائناتِ","جوانحَ تهفو إلى ضَمِّها",31,"ه",2,0],["وأُبْصرتَ إلَّا أمَّةً من محمد","تَنازَعَها الميكادُ غصباً ووَلهمُ",32,"م",1,0],["وأبْصَرَتْ عيناكِ ظلَّ الخريف","يُجللُ الأرض ويغشَى الفضا",33,"ض",2,0],["وَأَبْصَرَتْ أَمَهَا عَبُوساً","يَشُوبُ آمَاقَهَا احْمِرَارْ",34,"ر",1,0],["وأبصر نفس الدموع","وأضحك حين يشاء القضاء",35,"ا",2,0],["وَأُبْصِرُ القَوْمَ يَوْمَ الرَّوْعِ قَدْ حُشِدُوا","لِلْمَوتِ يَجْتَاحُ أَوْ لِلنَّصْرِ وَالغَلَبِ",36,"ب",1,0],["وأَبْصَر فِيه النِّيلُ خَيْرَ مُمَلَّكٍ","تَجِلُّ مَسَاعِيه وتَصْفُو مَشَارِبُه",37,"ب",2,0],["وأبصرتَ عيسَى ينشُرُ الرفْقَ والرضا","ويستَلُّ أحقادَ القلوبِ وينزِعُ",38,"ع",1,0],["وأبصرتُ ما أهوى على مثلهِ العمى","وأُسمعتُ ما أهوى على مثلهِ الوَقْرا",39,"ر",2,0],["وابصرت بعد طول البحث غايتها","فاذعنت لهواها أيّ إذعان",40,"ن",1,0],["وأبصرت إلاّ أمة محمد","تنازعها المكياد غصبا وولهم",41,"م",1,0],["وأبصرت روضاً هائج النبت كظه","وجلله شوك عليه طويل",42,"ل",1,0],["وأبصرتَها وسطَ البيوتِ كأنها","إذا بَرقَتْ في عارض الصبحِ أعْبَلُ",43,"ل",1,0],["وأبصرت جودك الآمالُ فابتدرت","على همامٍ عليِّ القدر والهممِ",44,"م",1,0],["وأبصرت الغرائب في فرنسا","وراقتني بلاد البرتغالِ",45,"ل",1,0],["وَأَبصارُهُم تَسمو لِبُعدِ مَحَلِّهِ","فَصَعِدو وَصَوّب هَل تُحِسُّ بِمِثلِهِ",46,"ه",1,0],["وَأَبْصَرْتُ مِنْ وَجْهِه في الظَّلامِ","بِكُلِّ مَكانٍ بِلَيْلٍ نَهَارَا",47,"ر",2,0],["وأَبصرتك عيوني والهدى نهجٌ","والحقُّ ينصر والبهتانُ قد غُلبا",48,"ب",2,0],["وأُبصر شمس غُرَّته إذا ما","تَراءتْ بين أَفْلاكِ الجُيوب",49,"ب",1,0],["وأَبْصَرَ كيف تُتْحِفه الليالي","بأوقاتِ الخَلاعة والتَّصابي",50,"ب",2,0],["وأُبصر ذاك الثغر يُشرق نورُه","وتبدو القُصور البيض منه وتلمع",51,"ع",1,0],["وأبصرتَ كيف تذوبُ النفوس","وتَنَهلُّ في صورة الأَدْمُع",52,"ع",1,0],["وأبصرت الضرير على نجاة","فقده من النجاة إلى الحريق",53,"ق",1,0],["وأبصروا جسمه يذوب ضنى","فقيل سحر قد شاع في جسده",54,"د",2,0],["وأبصرت غصناً ظمآن منطرحاً","فما رأت فيه إلا بعض أسقامي",55,"م",2,0],["وأبصرها العقلُ مُستَنفرات","فمدَّ جناحيهِ خوفاً وطارا",56,"ر",2,0],["وأبصرتُ أمثالَ الدمى يكتنفنني","فقلتُ أهذي الشهبُ أم شبهُ الشهبِ",57,"ب",1,0],["وأبصرَ بعدَ ذلكَ من قريبٍ","جيوشَ الصبحِ تمرحُ في الربوعِ",58,"ع",1,0],["وأبصرتُ وجهاً قلتُ لمّا رأيتُه","ألا ليت شعري ما تقول العواذلُ",59,"ل",1,0],["وأبصرت فيزوف الأشم وناره","فسبحان من يرمى إلى الماء بالجمر",60,"ر",1,0],["وَأَبصَرتُ وَجهَكَ هذا الصَباحَ","يَطفو عَلَيهِ صَباحٌ أَغَرّ",61,"ر",1,0],["وَأَبصَرَ حَيَّةً طَلَعَت عَلَيهِ","مِنَ الأَدغالِ مِثلَ التُربِ سَمرا",62,"ر",2,0],["وَأَبصَرَ غَلواءَ بَينَ الزُهورِ","كَحَوّاءَ بَينَ شَهيِّ الثَمَر",63,"ر",1,0],["وَأُبصِرُ ما لا تَراهُ العيونُ","فَأَطويهِ كَاللَهِ في ذاتِيَه",64,"ي",2,0],["وأبصرت الكبرى فتاة خويلد","ومن فوقه ظلل الغمام مرفع",65,"ع",1,0],["وأبصرت ما جرت عليه فعاله","ولا شك أن الظلم للذل يعقب",66,"ب",1,0],["وأبصارهم ترنو إلى قبلة الهدى","تصعدها أنى غدت وتصوب",66,"ب",1,0],["وأبصرتُ صُبحَ الوصل من وجهك الذي","بَدَا تحتَ شعر خلتُهُ ليلةَ الهَجر",67,"ر",1,0],["وَأَبْصَرَهُ علَى التَّوْفِيقِ وَقْفاً","يُقَرْطِسُ حينَ يَنْزَعُ فِي الرَّمِيِّ",68,"ي",1,0],["وابصارنا لا ترى في الضياء","وتبصر في الحلكة الداجية",69,"ي",2,0],["وَأَبصَرتهُ عطلاً مُفضض جيدهُ","فَحليتهُ مِن دَمع عَيني بِعقيان",70,"ن",1,0],["وأبصر غادةً من آل سام","على الباقين من أولاد حام",71,"م",1,0],["وأبْصرَ داراً لو ثوى الخير ساعة","بها لنأى عن أهلها وتغرّبا",72,"ب",2,0],["وأبصره العذول كما تراه","بما قاسى شديد الاضطراب",73,"ب",1,0],["وأبصرتُ كُثْباناً يميسُ يمينُها","غصونٌ ومن فوق الغصونِ بُدورُ",74,"ر",1,0],["وأَبصَرَ بحرَ الموتِ طَمَّ عُبابُهُ","وفاضَتْ نواحِيهِ وجاشَتْ غوارِبُهْ",75,"ب",2,0],["وأبْصَرَتْ مقلتي فيما ترى عَجَباً","وراءه لاقتضابِ الشعر ميدانُ",76,"ن",1,0],["وأبصرتْ ما خطَّ من أشياخها","بأساً وحلماً منك في غلامِها",77,"م",3,0],["وأبصر نَعماءهم نازحين","وبابُ لواحظِهِ مقفَلُ",78,"ل",1,0],["وأبصرت فيه وليداً مناك","وقد يصدق الظنُّ بالخائل",79,"ل",1,0],["وأبصر رشدَه ابنُ أخٍ شقيقٍ","فطاوع أمرَنا بعد الشِّقاقِ",80,"ق",1,0],["وأبصرَ الحظُّ الطريقَ فاهتدى","إليّ وهو أبلهُ البصائرِ",81,"ر",1,0],["وأبصر اليومَ غداً","فلم يَرِدْ إل