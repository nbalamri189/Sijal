ُ وتحطبُ",109,"ب",1,0],["وَأُبصِرُ الشَرَّ وَأَربابَهُ","يَهوونَ مِن أَعلى إِلى ساحِقِ",110,"ق",1,0],["وأبصرت نفسي في دياري مغربا","بعيداً عن الأحباب والصحب نائيا",111,"ي",2,0],["وأبصرتني من بعيد أناجي","جمالك في نشوة الشاعر",112,"ر",1,0],["وَأَبصَرني ما كانَ تحتَ غطائهِ","فَلاحت ليَ الأسرارُ واِنكشف الجهلُ",113,"ل",1,0],["وابصر أشرعة جاريات","على اليم لماعة في الأثير",114,"ر",1,0],["وابصر جسمي حسن خصرك ناحلاً","فحاكاهُ لكن زادَ في رقةِ المعنى",115,"ن",2,0],["وَأَبصَرَ الناسُ قَصدَ وَجههم","وملّكت أُمّة أخايرها",116,"ر",3,0],["وَأَبصَرتُ نار المازِنِيَّاتِ موهِناً","بِعَلياءَ يُثنى دونَها الطَّرفُ رانِيا",117,"ي",2,0],["وأبصرت البنود منكسات","تقاصر في الفضاء وتستطيل",118,"ل",1,0],["وأبصر منها حية لان مسها","وفي نابها سمّ يساور لينها",119,"ن",3,0],["وأبصر قبل موتي في رحاب","بطيبتكم تطيب لكل راحل",120,"ل",1,0],["وَأَبصَروا مِن عَيبِها أَنَّها","فَتّانَةٌ تَدعو إِلى النارِ",121,"ر",1,0],["وأبصر جسمي حسن خصرك ناحلاً","فحاكاه لكن زاد في دقة المعنى",122,"ن",2,0],["وأبصار سكرن فلا انطباقٌ","ترف به الغداة ولا انفتاح",123,"ح",1,0],["وأبصَارُها صَوناً تُغَضُّ وتُخطَفُ","كما تُنصَلُ الأرماحُ ثُمَّ تُرَكَّبُ",124,"ب",1,0],["وَأَبصَرنا الَّذي يُعطي","وَشاهَدنا الَّذي يَقري",125,"ر",2,0],["وابصر الجدول الصافي تعانقه","فيحٌ إذا تمتريها درتِ الشهدا",126,"د",2,0],["وابصر الناس من يفري ذوي مهل","صاف وعزّ وأحلام وأعراق",127,"ق",1,0],["وأبصرتُ ما أقوى القُوى من جرائمي","وعاينتُ ظهراً أثقلتهُ الجرائرُ",128,"ر",1,0],["وابصر جيشهم في البر بحرا","من الانجاد حاسرة الجواشن",129,"ن",1,0],["وأبصرتُ أبطالَ الحروبِ كأنهم","من الطود بأساً لا يروعهمُ الذعر",130,"ر",1,0],["وأبصرنَ كيف تُراقُ العلا","وتَسبقُ فيها المنايا العِلَل",131,"ل",1,0],["وأُبصِرُ مِنهُ البَدرَ في الأَرضِ ماشياً","وَمَن ذا الَّذي يَستخدِمُ البَدرَ بِالمَشي",132,"ي",1,0],["وأبصرته في ربقة الاسر مثخنا","واشلاؤكم من حوله ما لها حصر",133,"ر",1,0],["وأُبصر فيه مختلف البرايا","كأني جالس في سينماء",134,"ا",2,0],["وأبصرت نقصاً فيه لكنني له","رجوت من الأيام تقويم أخلاق",135,"ق",1,0],["وأبصر دونه العقبات كثرا","من المتصنعين الزائفينا",1