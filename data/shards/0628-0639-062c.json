{"poems":[[55,"قعد الراضون بالذل فقم","https://www.aldiwan.net/poem29750.html","الرمل"],[55,"لمن الحدوج تهزهن الأنيق","https://www.aldiwan.net/poem29959.html","الكامل"],[0,"ألا عم صباحاً أيها الطلل البالي","https://www.aldiwan.net/poem51.html","الطويل"],[53,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[104,"أدموع النساء والأطفال","https://www.aldiwan.net/poem33120.html","الخفيف"],[50,"","https://poetry.dctabudhabi.ae/diwan/poem/4279","المجتث"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1913","الطويل"],[53,"أنَّى هجوتَ بني ثوابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=26855",""],[255,"يروحي نسيم هب من أرض طيبة","https://www.aldiwan.net/poem15055.html","الطويل"],[342,"تعارض أسماء الركاب عشية","https://www.aldiwan.net/poem45433.html","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111503","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111424","الخفيف"],[5732,"يا فزعة المظيوم","https://www.poetsgate.com/ViewPoem.aspx?id=177835",""],[5850,"تُعارِضُ أسماءُ الرِّكابَ عَشِيّة","https://www.poetsgate.com/ViewPoem.aspx?id=19702",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""]],"verses":[["بِعَجاجٍ يَملَأُ الأُفقَ دُجىً","وَطِعانٍ يَخضُبُ الأَرضَ بِدَم",0,"م",1,0],["بَعَجَ الغَمامَ بِدَعوَةٍ مَسموعَةٍ","فَأَجابَهُ شَرقُ البَوارِقِ مُغدِقُ",1,"ق",1,0],["بِعَجلَزَةٍ قَد أَترَزَ الجَريُ لَحمَه","كَميتٍ كَأَنَّها هِراوَةُ مِنوالِ",2,"ل",1,0],["بعُجَارِمٍ يشفي الفقا","حَ إذا شَغَبْنَ من السَّغابهْ",3,"ب",2,0],["بعجاجٍ تُثيره تَرَكَ الدنيا","ظلاماً وشمسها في الزوالِ",4,"ل",1,0],["بِعَجرَدٍ وَعِبادٍ","وَالوالِبِيِّ الهِجانِ",5,"ن",1,0],["بِعَجلَزَةٍ قَد أَترَزَ الجَريُ لَحمَها","كَميتٍ كَأَنَّها هِراوَةُ مِنوالِ",6,"ل",1,0],["بعُجَارِمٍ يشفي الفقا","حَ إذا سَغَبْنَ من السَّغابهْ",7,"ب",2,0],["بعجزي وسوء الحظ أصبحتُ مبعداً","وذلك أنَّ اللَه ما قدَّرَ القُربا",8,"ب",2,0],["بَعَجتُ إِلَيهِ البَطنَ ثُمَّ اِنتَصَحتُهُ","وَما كُلُّ مَن يُلقى إِلَيهِ بِصالِحِ",9,"ح",1,0],["بعجالها انقلبت تفر بساقةٍ","ذعرت لذياك اللهيب المتجلي",10,"ل",2,0],["بِعجالٍ قد ستِّرَت في خِيامٍ","وخُيُولٍ في الحندَقُوقِ الجَزِيلِ",11,"ل",1,0],["بعج ودخان تقاذفه الاطواب","مثل الرعد من مرزمات السحايب",12,"ب",1,0],["بعجتُ إليهِ البطنَ ثمَّ انتصحتهُ","وما كُلُّ ما يُلقى إليْهِ بِصالِحِ",13,"ح",1,0],["بعجزي أعاني من شجون كثيرة","وأحزن لما لا أمد أياديا",14,"ي",2,0]]}