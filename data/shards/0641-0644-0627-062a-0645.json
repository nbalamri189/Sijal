{"poems":[[79,"إذا صرفت نحو وجه حسن","https://www.aldiwan.net/poem35982.html","الرجز"],[44,"عد من الرحمن فضلا ونعمة","https://www.aldiwan.net/poem50330.html","الطويل"],[85,"ظلالكم تندو وموردكم عذب","https://www.aldiwan.net/poem54337.html","الطويل"],[47,"أذم إليك تغليس الدجون","https://www.aldiwan.net/poem66667.html","الوافر"],[63,"ينافسني في الشعر والشعر كاسد","https://www.aldiwan.net/poem51701.html","الطويل"],[60,"حسين إذا كنت في بلدة","https://www.aldiwan.net/poem31146.html","المتقارب"],[51,"لعمرك ما الدنيا بدار بقاء","https://www.aldiwan.net/poem10314.html","الطويل"],[46,"رأيت العلا معمورة بك دارها","https://www.aldiwan.net/poem29982.html","الطويل"],[52,"ألا قل لتلك المالكية أصحبي","https://www.aldiwan.net/poem64863.html","الطويل"],[48,"حياة وموت وانتظار قيامة","https://www.aldiwan.net/poem23509.html","الطويل"],[48,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16679","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67335","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142053","المجتث"],[85,"ظلالكم تندو وموردكم عذب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=57164&r=&rc=9",""],[138,"تطاول ليلي بهم وصب","https://www.aldiwan.net/poem20978.html","المتقارب"],[147,"مساعيك لا تحصى فتدرك بالعد","https://www.aldiwan.net/poem11749.html","الطويل"],[164,"دمعي على الخد مثل الدر ينتثر","https://www.aldiwan.net/poem58847.html","الكامل"],[170,"لرجله عندي يد إذ خطت","https://www.aldiwan.net/poem47083.html","السريع"],[185,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[190,"إذا سبك الوغد اللئيم مسبة","https://www.aldiwan.net/poem44114.html","الطويل"],[202,"حدائق الحسن تغري السهد بالحدق","https://www.aldiwan.net/poem51912.html","البسيط"],[203,"سعوا بيننا حتى لقد كنت راضيا","https://www.aldiwan.net/poem45575.html","الطويل"],[216,"ألا فاستمع يا نجل يحيى مقالتي","https://www.aldiwan.net/poem37865.html","الطويل"],[234,"إليك مدت رقابها العرب","https://www.aldiwan.net/poem51240.html","المنسرح"],[240,"وعدت بأن تنفذ لي حصيرا","https://www.aldiwan.net/poem31925.html","الوافر"],[275,"فؤادك در والقلوب زجاج","https://www.aldiwan.net/poem35055.html","الطويل"],[371,"فلا تمكن الأيام من أن تمسني","https://www.aldiwan.net/poem17211.html","الطويل"],[398,"إذا رأيت امرءا في حال عسرته","https://www.aldiwan.net/poem53460.html","البسيط"],[422,"تذكر عهدا بالحمى قد تقدما","https://www.aldiwan.net/poem53977.html","الطويل"],[435,"لا والمحيا وصباح الجبين","https://www.aldiwan.net/poem40242.html","السريع"],[463,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[473,"يا شادنا ليس يدري","https://www.aldiwan.net/poem60527.html","المجتث"],[558,"عزمت على صرم فلما أبى الهوى","https://www.aldiwan.net/poem68362.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38830","الطويل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138069",""],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96670","المتقارب"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76905","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53070","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27843","المجتث"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18055","الوافر"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82973","البسيط"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10442","الوافر"],[3017,"","https://poetry.dctabudhabi.ae/diwan/poem/117142","المتقارب"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100840","الطويل"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71344","المتقارب"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71337","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89197","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216523","المجتث"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34587","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94704","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73198","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133123","الطويل"],[4723,"ابتهال","https://www.poetsgate.com/ViewPoem.aspx?id=63307",""],[4888,"في ظلِّ مكتبتي","https://www.poetsgate.com/ViewPoem.aspx?id=207731",""],[4119,"يشيم هواكم مقلتي فتصوب","https://www.poetsgate.com/ViewPoem.aspx?id=16068",""],[5057,"عِش مع الحب","https://www.poetsgate.com/ViewPoem.aspx?id=197177",""],[1043,"خلود الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=89105",""],[5376,"أيا مُلهمي بالشعرِ ما قلْتُ عابثا","https://www.poetsgate.com/ViewPoem.aspx?id=197708",""],[5431,"تزوّدْ بالعفاف تعشْ أميرا ...","https://www.poetsgate.com/ViewPoem.aspx?id=200333",""],[5431,"ارفق بقلبه .....","https://www.poetsgate.com/ViewPoem.aspx?id=210357",""],[5582,"قِفَا بِالرُّسُومِ الخَوالِي القِفارِ","https://www.poetsgate.com/ViewPoem.aspx?id=63523",""],[5616,"الصقر","https://www.poetsgate.com/ViewPoem.aspx?id=205772",""],[6148,"نصائح غالية","https://www.poetsgate.com/ViewPoem.aspx?id=203066",""],[138,"تَطاولَ ليلي بهمٍّ وَصِبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17326&r=&rc=0",""]],"verses":[["فلا تُمِلْ قلْبَكَ ما اسْطَعْتَ لهُ","فالقَلْبُ كالحائِطِ إنْ مالَ وقَعْ",0,"ع",1,0],["فَلا تَمنَعَن ذا حاجَةٍ جاءَ طالِباً","فَإِنَّكَ لا تَدري مَتى أَنتَ راغِبُ",1,"ب",1,0],["فلا تمطوا دَيْنَ المُعَلَّل عن غنى","فجانبكم سهلٌ ومنزلكم رَحْبُ",2,"ب",1,0],["فَلا تَمزُج بِماءِ المُزنِ كَأسي","وَعَدِّ بِها إِلى الماءِ المَعينِ",3,"ن",1,0],["فلا تمنحوا منه الكرامَ قلائداً","فليسَ من الحَصباءِ تُهدَى القَلائِدُ",4,"د",1,0],["فَلا تَمرَحَنَّ لِأَوزارِها","وَلا تَضجَرَنَّ لِأَوصابِها",5,"ب",3,0],["فَلا تَمشِ يَوماً في ثِيابِ مَخيلَةٍ","فَإِنَّكَ مِن طينٍ خُلِقتَ وَماءِ",6,"ا",2,0],["فَلا تُمكِنَنَّ المَطلَ مِن ذِمَّةِ النَدى","فَبِئسَ أَخو الأَيدي الغِرارِ وَجارُها",7,"ر",3,0],["فَلا تُمسِكيني بِالهَوانِ فَإِنَّني","عَنِ الهوَنِ ظَعّانٌ لِقَصدِ المُلَحَّبِ",8,"ب",1,0],["فَلا تَمهَرا الدُنيا المُروءَةَ إِنَّها","تُفارِقُ أَهليها فِراقَ لِعانِ",9,"ن",1,0],["فَلا تَمدَحاني يَمينَ الثَناءِ","فَأَحسَنُ مِن ذاكَ أَن تَهجُواني",10,"ن",2,0],["فلا تمْنَعَنْ حِرْباءَهُ من صِلائِهِ","بشارِقِ أسْيافٍ يُضِئْنَ حِداد",11,"د",1,0],["فلا تَمنُّوا لِقَاحَ الحَرْبِ واقتَعِدُوا","إنَّ أَخَا الحَرْبِ أصْدَى اللّونِ مَشْعُولُ",12,"ل",1,0],["فلا تمنّ عليه","زار الترابُ ترابا",13,"ب",2,0],["فلا تمطلوا دين المعلل عن غنى","فجانبكم سهل ومنزلكم رحب",14,"ب",1,0],["فَلا تُمسِكُنَّ بِأَيديكُمُ","بُعَيدَ الأُنوفِ بعَجبِ الذَنَب",15,"ب",1,0],["فَلا تُمهِلَنَّ مُظهِراً لَكَ طاعَةً","فَإِنّي أَراهُ مُضمِراً ضِدَّ ما يُبدي",16,"د",2,0],["فلا تمد إِلى فضلٍ لديك رجا","إِلا وعاد لما يقضي به الوطرُ",17,"ر",1,0],["فلا تمتّعتُ بحُريّتي","إن لم أعامِلْهُ برقِّ الأبَد",18,"د",1,0],["فَلاَ تَمنَحِينى البُخلِ مِنكِ وتَعجَلِى","عَلَىَّ بِأمرٍ لَم يَكُن بِذُنُوبِ",19,"ب",1,0],["فلا تمتعض منها وطامن لها الحشا","ولا تمتليء غيظا وقل عضّني كلب",20,"ب",1,0],["فلا تمدّنَّ باعَ العُجْبِ إنَّ لها","عُقبى تؤجِّجُ نارَ الضَّغْنِ والحنق",21,"ق",1,0],["فلا تمكنِ الواشينَ من ذاتِ بيننا","فليسَ لهم غيرَ التفرقِ مطلبُ",22,"ب",1,0],["فلا تمدحن النفس تزكية لها","فمدحُ الفتى في نفسهِ ليس ينفعُ",23,"ع",1,0],["فلا تَمَشَّى بأهله زمنٌ","إلاّ بما تَشْتهي وتَرْتَقب",24,"ب",1,0],["فَلا تُمسِك يَدَيكَ عَليهِ ضَنّاً","فَكَم لَكَ في جَهَنَّمَ مِن حَصيرِ",25,"ر",1,0],["فلا تمزجنَّ الخلَّ بالخمرِ راغباً","بإصلاحهِ إنَّ الفسادَ مزاج",26,"ج",1,0],["فَلا تُمكِنِ الأَيّامَ مِن أَن تَمَسّني","فَمَهما تَمَسَّ الحُرَّ تَمسَسهُ بِالضُرِّ",27,"ر",1,1],["فَلا تَمنَّ لَهُ أَن يَستَفيدَ غِنىً","فَاِنَّهُ بِاِنتِقالِ الحالِ يَنتَقِلُ",28,"ل",1,0],["فلا تمنعاني وقفةً أَنا سائل","بها الدَّارَ عن حيٍّ نأى أين يمَّما",29,"م",2,0],["فلا تمل يوماً إلى غيرهِ","يا قلب إن كنت من الصادقين",30,"ن",1,0],["فلا تُميلَنّ الليا","لي ظلَّك المعتدلا",31,"ل",2,0],["فَلا تَمَكَّنهُ مِنّي","مادُمتَ تَحتَ الوَلاءِ",32,"ا",2,0],["فَلا تُمكِني الهِجرانَ مِن ذاتِ بَينِنا","فَيَغنى صَديقٌ عَن لِقاءِ صَديقِ",33,"ق",1,0],["فَلا تَمحُ مِن قَلبي هَواهُ وَحبّهُ","سواءٌ جَفاني أَم حَبَاني وصالهُ",34,"ه",1,0],["فلا تمنحى لألاء ضوئك أخرقا","فكم غاض فطرق في الرمال الصرائم",35,"م",1,0],["فَلا تَمنحِ الشعرَ إلّا مهنّا","سليل محمّد محض البحارِ",36,"ر",1,0],["فَلا تمكّن في قلبٍ هَواك وَكَم","لك استرق به حرا وَكَم ملكا",37,"ك",2,0],["فلا تمنعاني نسمة فمع الصبا","نوافح من تلك الديار نوافح",38,"ح",1,0],["فلا تمتُ حتفَ أنفٍ","فلستُ فيها بنكِس",39,"س",1,0],["فَلا تُمنَي بِمَطروقٍ إِذا ما","سَرى في القَومِ أَصبَحَ مُستَكينا",40,"ن",2,0],["فَلا تَمَنَّ لَه حالا يُسرُّ بها","فَإِنَّهُ بِاِنتِقالِ الحالِ يَنتَقِلُ",41,"ل",1,0],["فَلا تَمذُل بِسِرِّكَ كُلُّ سِرٍّ","إِذا ما جاوَزَ الإِثنَينِ فاشي",42,"ي",1,1],["فلا تمتنع فيه من مأكل","سوى الملح أو حامص من شراب",43,"ب",1,0],["فلا تمددي لمياء حبلا ظننته","مصونا غداة الجذب عن كل جاذب",44,"ب",1,0],["فلاَ تَمْزِجَنْ بِدَمِي عَبْرَتِي","وَرِيقُكَ لي بِالكُؤُوسِ امْزِجِ",45,"ج",1,0],["فَلاَ تَمْزِجَنْهَا فَهْيَ بِالْمَزْجِ حُرِّمَتْ","وَلَوْ جُلِيَتْ صِرْفاً عَلَيْهِمْ لَحَلَّتِ",46,"ت",1,0],["فلا تمنع صديقك منك فضلاً","فما يدريك في الأفضال غيري",47,"ي",1,0],["فلا تمرّي ببالي","ولا أمر ببالك",48,"ك",1,0],["فلا تمت الأشياء بعد محمدٍ","ولا زال شملُ الملك فيها مبددا",49,"د",2,0],["فلا تمنع الأقدام مني إليكمُ","ولو كان حولي ألف خطبٍ منازعِ",50,"ع",1,0],["فلا تمنع ذوي فقرٍ زكاةً","فإنَّ زكاةَ حُسنكِ أن يعارا",51,"ر",2,0],["فلا تمنعوها مستحقاً وبادروا","بإخراجها تجدوا النماءَ موافيا",52,"ي",2,0],["فلا تمش ِ في الظلماء ِ مشْيةَ واهم ٍ","كأشْعثَ في الدهماء ِ جُرِّدَ مالُهُ",53,"ل",2,0],["فلا تمحوهُ أدْراجُ ال","غِيابِ وهذهِ الحِقَبُ",54,"ب",1,0],["فلا تمنعيها من قوامك هزة","فيحظى بها غصن سواك رطيب",55,"ب",1,0],["فلا تمايزُنا الأنسابُ دونَ تُقىً","ولا يؤاخَذُ شخصٌ بالذي اعتقدَا",56,"د",2,0],["فلا تمنحي لألاء ضوئك أخرقا","فكم غاض قَطْرٌ في الرمال الصرائمِ",57,"م",1,0],["فلا تمْتعضْ من قولِ حقٍ مخافةً","فما قولةُ الاحقاقِ تخشى بواعثا",58,"ث",2,0],["فلا تملءْ خوابي الرزق بؤسا","فلن يُؤتى سوى المكتوبِ كدحُ",59,"ح",1,0],["فلا.. تمتهن تنقيطَ ماليس واضحا","ولاتقتفِ الأسرار إنْ جئت مصحفه",60,"ف",2,0],["فَلا تَمْنَحْ الشِّعْرَ إِلاَّ مُهَنَّا","سَلِيلَ مُحمَّدِ مَحْضَ النِّجارِ",61,"ر",1,0],["فلا تمر العراق يشد ازرا","ولا بردى ولا النيل القراح",62,"ح",1,0],["فلا تمدد يديك لغير رب","فرب الناس لا يألوك فضلا",63,"ل",2,0],["فلا تُمْسكُنَّ بأَيديكُمو","بُعيدَ الأنوف بعجْبِ الذَّنَبْ",64,"ب",1,0]]}