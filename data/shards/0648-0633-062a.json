{"poems":[[93,"عمر قطعت مداه قبل أوان","https://www.aldiwan.net/poem11222.html","الكامل"],[88,"صاح إن الخطوب في غليان","https://www.aldiwan.net/poem44456.html","الخفيف"],[88,"أيها الأنجم التي قد رأينا","https://www.aldiwan.net/poem45031.html","الخفيف"],[72,"خليلي من مصر قفا نبك في السبك","https://www.aldiwan.net/poem19441.html","الطويل"],[51,"قدم الفطر صاحبا مودودا","https://www.aldiwan.net/poem11442.html","الخفيف"],[51,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[91,"سيرت في فجر الحياة سفينتي","https://www.aldiwan.net/poem62730.html","عموديه"],[89,"عاث هذا المنون يسرف فينا","https://www.aldiwan.net/poem44774.html","الخفيف"],[89,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[89,"بعد اني اردى فاهبط رمسي","https://www.aldiwan.net/poem44926.html","الخفيف"],[89,"إن تأييد نهضة العلم مجد","https://www.aldiwan.net/poem44933.html","الكامل"],[85,"يا مليكا شاد فينا","https://www.aldiwan.net/poem7362.html","مجزوء الرمل"],[45,"أجدر وأخلق أن ترن عوائدي","https://www.aldiwan.net/poem63548.html","الكامل"],[61,"عش مدى الدهر يا أبا إسحاق","https://www.aldiwan.net/poem51505.html","الخفيف"],[49,"ستباشر الأجداث وحدك","https://www.aldiwan.net/poem62062.html","مجزوء الكامل"],[66,"وستة أصناف حملهن بأرجل","https://www.aldiwan.net/poem38422.html","الطويل"],[80,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[44,"أرض مصردة وأخرى تثجم منها","https://www.aldiwan.net/poem30363.html","الكامل"],[44,"أقشيب ربعهم أراك دريسا","https://www.aldiwan.net/poem30481.html","الكامل"],[90,"نامي جياع الشعب نامي","https://www.aldiwan.net/poem59037.html","عموديه"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/86022","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[90,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""],[31,"ودعْ لبابة َ قبلَ أن تترحلا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19018&r=&rc=281",""],[113,"أنت النبي لا كذب","https://www.aldiwan.net/poem41968.html","مجزوء الرجز"],[115,"ما رضينا","https://www.aldiwan.net/poem24047.html","الرمل"],[142,"سطا جيش أهواء على من بكم لاذا","https://www.aldiwan.net/poem4459.html","الطويل"],[197,"سائلوه متى يفيق الذي جن","https://www.aldiwan.net/poem45613.html","الخفيف"],[229,"يوم أراك به فلست أصومه","https://www.aldiwan.net/poem44567.html","الكامل"],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[233,"ما ذقت قط أمر من أمري","https://www.aldiwan.net/poem31602.html","الطويل"],[269,"بمحمد خطر المحامد يعظم","https://www.aldiwan.net/poem52125.html","الكامل"],[278,"صرت بين الصادين يا بن المجلي","https://www.aldiwan.net/poem60731.html","الطويل"],[311,"إذا ما كنت ملتمسا لرزق","https://www.aldiwan.net/poem59506.html","الوافر"],[326,"أمل لا يزال فوق المرام","https://www.aldiwan.net/poem54962.html","الخفيف"],[340,"مرقص ضاحك يحف به البشر","https://www.aldiwan.net/poem55323.html","الخفيف"],[346,"وكان سداد الباب عن مسلك الهوى","https://www.aldiwan.net/poem20080.html","الطويل"],[397,"وهج الحب","https://www.aldiwan.net/poem6703.html","عموديه"],[399,"يا دار سلمى بسفح ذي سلم","https://www.aldiwan.net/poem46982.html","المنسرح"],[400,"إلى كم أداري عاذلي ومفندي","https://www.aldiwan.net/poem33969.html","الطويل"],[403,"حكم المنية في البرية جاري","https://www.aldiwan.net/poem50178.html","الكامل"],[436,"أي شراع لأي بحر","https://www.aldiwan.net/poem34854.html","مخلع البسيط"],[456,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[459,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[466,"وستر له منظر مونق","https://www.aldiwan.net/poem59805.html","المتقارب"],[466,"وستر لصاحبه نيقة","https://www.aldiwan.net/poem59806.html","المتقارب"],[512,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[513,"الحمد لله الذي","https://www.aldiwan.net/poem12285.html","مجزوء الرجز"],[556,"جسد في هوى المليح عليل","https://www.aldiwan.net/poem34252.html","الخفيف"],[556,"لمتى تموه بالمهاة وبالرشا","https://www.aldiwan.net/poem34430.html","الكامل"],[565,"مالك موفور فما باله اكسبك","https://www.aldiwan.net/poem69501.html","السريع"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"إنني من عتقائك","https://www.aldiwan.net/poem3042.html","مجزوء الرمل"],[573,"نحافة الغصن غيظ من تثنيكا","https://www.aldiwan.net/poem3044.html","البسيط"]],"verses":[["وَسَتَذْكُرُ الضَّادُ اعْتِزَازَ بَيَانِهَا","بِكَ مَا جَرَتْ ذِكْرَى أَمِيرِ بَيَانِ",0,"ن",1,0],["وستبدو أم النجوم رءوماً","يتدانى من نورها الفرقدان",1,"ن",1,0],["وستبقى الذكرى لكم ذات رمز","هو تعظيمكم بخفض الرءوس",2,"س",1,0],["وستر فؤادِي أن أقلام بدركم","سرورٌ لذي ودٍّ وغيظٌ لذي محك",3,"ك",1,0],["وستبقى عليهما ويعُودا","ن كما أنت مُشْتَهٍ أن يعودا",4,"د",2,0],["وستسلاه بالتّقادُمِ لا بلْ","بالأُسَى بل بصاحبٍ مُعْتاض",5,"ض",1,0],["وَسَتَلتَقي روحي وَروحِكَ بَعدَما","تَفنى الهَياكِلُ في الإِلَهِ السامي",6,"ي",1,0],["وستبقى برغم موتك حيا","ما توالت بعد السنين السنونا",7,"ن",2,0],["وستصفو لي الاصا","ئل في مضر والبكر",8,"ر",1,0],["وستبقى نجومها بازغات","ثم تمنى بعد البزوغ بطمس",9,"س",1,0],["وسترقى به على ما لديها","من رقيّ فانها تستعد",10,"د",1,0],["وستكسو مصر ثوبا","يبهر الدنيا جميل",11,"ل",1,0],["وَسَتَرتُ عَيبَهُمُ وَكُنتُ مُجاهِداً","مَن رامَ نَقصَهُمُ بِكُلِّ تَجاهُدِ",12,"د",1,0],["وستور كأنهن ربيع","شرق النور من حيا رقراق",13,"ق",1,0],["وَسَتَستَجِدُّ بِكَ البِلى","وَسَتُخلِقُ الأَيّامُ عَهدَك",14,"ك",1,0],["وستة أصناف حملهن بأرجل","لأن طوال السبق بالحمل أجدر",15,"ر",1,1],["وستبكيكَ بعد موتي القوافي","في نياح من لفظها معنويِّ",16,"ي",1,0],["وَسَتَذكُرونَ غَداً صَنائِعَ مالِكٍ","إِن جَلَّ خَطبٌ أَو تُدوفَعَ مَغرَمُ",17,"م",1,0],["وَسَتُشكَرُ النُعمى الَّتي صُنِعَت وَلا","نِعَمٌ كَنُعمى أَنقَذَت مِن بوسى",18,"س",2,0],["وﭐستفرِشِي صُمَّ الحَصَى","وَتَلَحَّفي ظُلَلَ الغَمَامِ",19,"م",1,0],["وستبكين طول عمرك بعدي","وستبكين بكرة وعشيا",20,"ي",2,0],["وَسَتَهْدِينَ هَدْيَ أُمِّكِ في أَقْ","وَمِ نَهْجٍ لِفُضْلَيَاتِ النِّسَاءِ",21,"ا",2,0],["وستَحمَدون قصائداً مهما عَلَتْ","قَدْراً فَقدْر أبى عليٍّ أرفَعَ",22,"ع",1,0],["وکسْتَنْكَحَ النَّوْمُ الَّذِينَ نَخَافُهُمْ،","ورمى الكرى بوابهم، فتخبلا",23,"ل",2,0],["وستر برهان على","خدر الخفايا قد ضرب",24,"ب",1,0],["وستبقى كَعْبَةُ الحُبِّ لنا","مَعْبَدًا، نَتْلُو نَشِيجًا وأَنينا",25,"ن",2,0],["وستركم يبدي المحاسن والسنا","ويخفي خناً للسوء والشر جباذا",26,"ذ",2,0],["وستعرْ لي وقتاً طويلاً فإني","أجد الوقتَ في الهوى لا يطولُ",27,"ل",1,0],["وسترت حتى نم دمعي بالهى","وأبر دمع العاشقين نمومه",28,"م",2,0],["وَسَتَظهَرُ التُركُ الصِغار الأَعيُن ال","دُلف الأُنوفِ مُدَمِّروا البُلدانِ",29,"ن",1,0],["وَسَتَعلَمونَ مَنِ الغَبينُ إِذا","فارَقتُكُم وَعَرَفتُمُ قَدري",30,"ي",1,0],["وَستكثر القَتلى وَينسفك الدم","فَبحقه صَلوا عليه وَسلموا",31,"م",3,0],["وَسَتأْتِي الْفاءَانِ فَقْدُكَ بَلْ فَقْ","رُكَ إِثْرَ الْحاءَيْنِ حُرْفٍ وَحَتْفٍ",32,"ف",1,0],["وستر لا تغيره الليالي","بحادثة من النقصان تجري",33,"ر",2,0],["وستفنى الدنيا وتجري النهايا","ت وتطوى صحائف الأيام",34,"م",1,0],["وستغدون في القريب ضحايا","ها ويتلو توجع ونواح",35,"ح",1,0],["وَسِتْراً علَى السِّتْرِ الرَّفِيعِ بَهاؤهُ","بهِ وَيَزينُ السيفَ حُسْنُ نِجادِهِ",36,"د",2,0],["وستدري بأننا قَدْ تَعِبن","وعَطِشْنا، والماءُ في أيدينا",37,"ن",2,0],["وسَتَرُوا مِن عُلاكَ ما عَلِمُوا","وهيَ لعمرْي نارٌ على عَلَم",38,"م",1,0],["وستراً على هذا النظام فإنه","كثير الحيا من ذهنك المتوقد",39,"د",1,0],["وَسترتها بِتَواضعي فَتطلَّعت","أَعناقها تَعلو عَلى الأَستارِ",40,"ر",1,0],["وسِتْرَ صَوْنٍ لوجهِ مولىً","بِهِ رعى اللهُ كلَّ سِتْرِ",41,"ر",1,0],["وستةُ أيام الدوامِ بهائمٌ","منصَّفةٌ إلقاحُهن حِيالُ",42,"ل",1,0],["وستملكُ الدُّنيا تملُّكَ قابضٍ","وتُطيعُكَ الحمراءُ والبيضاءُ",43,"ا",2,0],["وَسِترٍ لَهُ مَنظَرٌ مونِقٌ","وُجوهُ تَصاويرُهُ تُشرِقُ",44,"ق",1,1],["وَسِترٍ لِصاحِبِهِ نيقَةٌ","فَسَلَّمَهُ اللَهُ ما أَحذَقَه",45,"ق",2,1],["وستضْحَكُ البيضُ الظُّبا بأكفّهم","ضحك البُروقِ بعارضٍ هتّانِ",46,"ن",1,0],["وستهم سياسة","صبت على الغز الهنا",47,"ن",2,0],["وستور تماط عن وجه حقٍّ","فيحق الرجاء والتأميل",48,"ل",1,0],["وستائر الأوهام عنه تحولت","والصبح أسفر وانقضى وقت العشا",49,"ش",2,0],["وَسَتُّهَا تَعْلَمُ مَنْ تَشْتَهِي","مِنَّا وَإِنْ مَالَتْ إِلَى الدِّرًهَمِ",50,"م",1,0],["وسترى ذلك في كتابي","فيما ترى من مقبل الأبواب",51,"ب",1,0],["وسترى قصتهم في باب","أفرده من بعد في كتابي",51,"ي",1,0],["وسترى في قتله احتجاجا","من بعد هذا يوضح المنهاجا",51,"ج",2,0],["وستبدو معجزاتٌ","شاهداتٌ بولائِكْ",52,"ك",1,0],["وستلْقَى العِزَّ صفواً","خَالصاً مِنْ خُلصَائِكْ",52,"ك",1,0],["وستُبدي فيَّ ما تُضْ","مِرُه من حُسنِ رَائِكْ",52,"ك",1,0],["وسَتَقْضِي لي بإِذْن","اللهِ ذَا قَبْلَ اقْتِضَائِكْ",52,"ك",1,0],["وسترُ ليلةِ وصلٍ بات يستُرنا","حتَّى ابتسمتُ فعاد السِّترُ مَهْتُوكا",53,"ك",2,0]]}