etsgate.com/ViewPoem.aspx?id=209111",""],[5459,"إنذار","https://www.poetsgate.com/ViewPoem.aspx?id=202224",""],[5542,"من أعماق القلب","https://www.poetsgate.com/ViewPoem.aspx?id=10052",""],[5596,"غزة فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=205674",""],[5616,"إلى ممثلة","https://www.poetsgate.com/ViewPoem.aspx?id=205251",""],[5660,"يا قُنبُلُةَ الهَجرِ انفَجِري","https://www.poetsgate.com/ViewPoem.aspx?id=37065",""],[2546,"صرمتْ أسماءُ حبلي فانصرمْ","https://www.poetsgate.com/ViewPoem.aspx?id=17461",""],[5776,"خاتمٌ بلا إصبع","https://www.poetsgate.com/ViewPoem.aspx?id=199329",""],[5818,"ستترك الدنيا وراءك","https://www.poetsgate.com/ViewPoem.aspx?id=193195",""],[5897,"همسات لحظة","https://www.poetsgate.com/ViewPoem.aspx?id=156243",""],[5897,"منصة العرفان","https://www.poetsgate.com/ViewPoem.aspx?id=157484",""],[5897,"من وحي ال21","https://www.poetsgate.com/ViewPoem.aspx?id=158793",""],[5923,"في العيد","https://www.poetsgate.com/ViewPoem.aspx?id=146240",""],[5953,"ألا يا رجال الحق بالحق أبشروا","https://www.poetsgate.com/ViewPoem.aspx?id=93852",""],[5956,"سيغرد القلب الحنونُ بعودتكْ","https://www.poetsgate.com/ViewPoem.aspx?id=193305",""],[5957,"لا تيأس يا ابن العرب..","https://www.poetsgate.com/ViewPoem.aspx?id=11423",""],[6152,"يا ليل","https://www.poetsgate.com/ViewPoem.aspx?id=201869",""],[5309,"ذلك البدر كنت ادري مصيره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573542",""],[520,"شغل الزمان بما تقول وتفعل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577611",""],[6160,"صَقيعٌ لنبوءةٍ عارِية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87101&r=&rc=18",""],[6177,"معراج العاشقين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79590&r=&rc=26",""],[2944,"ابكِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86014&r=&rc=3",""],[572,"مَالُكَ موفورٌ فما بالُهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9465&r=&rc=322",""]],"verses":[["وَسَتَذْكُرُ الضَّادُ اعْتِزَازَ بَيَانِهَا","بِكَ مَا جَرَتْ ذِكْرَى أَمِيرِ بَيَانِ",0,"ن",1,0],["وستبدو أم النجوم رءوماً","يتدانى من نورها الفرقدان",1,"ن",1,0],["وستبقى الذكرى لكم ذات رمز","هو تعظيمكم بخفض الرءوس",2,"س",1,0],["وستر فؤادِي أن أقلام بدركم","سرورٌ لذي ودٍّ وغيظٌ لذي محك",3,"ك",1,0],["وستبقى عليهما ويعُودا","ن كما أنت مُشْتَهٍ أن يعودا",4,"د",2,0],["وستسلاه بالتّقادُمِ لا بلْ","بالأُسَى بل بصاحبٍ مُعْتاض",5,"ض",1,0],["وَسَتَلتَقي روحي وَروحِكَ بَعدَما","تَفنى الهَياكِلُ في الإِلَهِ السامي",6,"م",2,0],["وستبقى برغم موتك حيا","ما توالت بعد السنين السنونا",7,"ن",2,0],["وستصفو لي الاصا","ئل في مضر والبكر",8,"ر",1,0],["وستبقى نجومها بازغات","ثم تمنى بعد البزوغ بطمس",9,"س",1,0],["وسترقى به على ما لديها","من رقيّ فانها تستعد",10,"د",1,0],["وستكسو مصر ثوبا","يبهر الدنيا جميل",11,"ل",1,0],["وَسَتَرتُ عَيبَهُمُ وَكُنتُ مُجاهِداً","مَن رامَ نَقصَهُمُ بِكُلِّ تَجاهُدِ",12,"د",1,0],["وستور كأنهن ربيع","شرق النور من حيا رقراق",13,"ق",1,0],["وَسَتَستَجِدُّ بِكَ البِلى","وَسَتُخلِقُ الأَيّامُ عَهدَك",14,"ك",1,0],["وستة أصناف حملهن بأرجل","لأن طوال السبق بالحمل أجدر",15,"ر",1,1],["وستبكيكَ بعد موتي القوافي","في نياح من لفظها معنويِّ",16,"ي",1,0],["وَسَتَذكُرونَ غَداً صَنائِعَ مالِكٍ","إِن جَلَّ خَطبٌ أَو تُدوفَعَ مَغرَمُ",17,"م",1,0],["وَسَتُشكَرُ النُعمى الَّتي صُنِعَت وَلا","نِعَمٌ كَنُعمى أَنقَذَت مِن بوسى",18,"س",2,0],["وﭐستفرِشِي صُمَّ الحَصَى","وَتَلَحَّفي ظُلَلَ الغَمَامِ",19,"م",1,0],["وستبكين طول عمرك بعدي","وستبكين بكرة وعشيا",20,"ي",2,0],["وَسَتَهْدِينَ هَدْيَ أُمِّكِ في أَقْ","وَمِ نَهْجٍ لِفُضْلَيَاتِ النِّسَاءِ",21,"ا",2,0],["وستعرف الدنيا وتعرف أنّه","شعب على سحق الطغاة معوّد",22,"د",1,0],["وستَحمَدون قصائداً مهما عَلَتْ","قَدْراً فَقدْر أبى عليٍّ أرفَعَ",23,"ع",1,0],["وکسْتَنْكَحَ النَّوْمُ الَّذِينَ نَخَافُهُمْ،","ورمى الكرى بوابهم، فتخبلا",24,"ل",2,0],["وستر برهان على","خدر الخفايا قد ضرب",25,"ب",1,0],["وستبقى كَعْبَةُ الحُبِّ لنا","مَعْبَدًا، نَتْلُو نَشِيجًا وأَنينا",26,"ن",2,0],["وستركم يبدي المحاسن والسنا","ويخفي خناً للسوء والشر جباذا",27,"ذ",2,0],["وستعرْ لي وقتاً طويلاً فإني","أجد الوقتَ في الهوى لا يطولُ",28,"ل",1,0],["وسترت حتى نم دمعي بالهى","وأبر دمع العاشقين نمومه",29,"م",2,0],["وَسَتَظهَرُ التُركُ الصِغار الأَعيُن ال","دُلف الأُنوفِ مُدَمِّروا البُلدانِ",30,"ن",1,0],["وَسَتَعلَمونَ مَنِ الغَبينُ إِذا","فارَقتُكُم وَعَرَفتُمُ قَدري",31,"ر",2,0],["وَستكثر القَتلى وَينسفك الدم","فَبحقه صَلوا عليه وَسلموا",32,"م",3,0],["وَسَتأْتِي الْفاءَانِ فَقْدُكَ بَلْ فَقْ","رُكَ إِثْرَ الْحاءَيْنِ حُرْفٍ وَحَتْفٍ",33,"ف",1,0],["وستر لا تغيره الليالي","بحادثة من النقصان تجري",34,"ر",2,0],["وستفنى الدنيا وتجري النهايا","ت وتطوى صحائف الأيام",35,"م",1,0],["وستغدون في القريب ضحايا","ها ويتلو توجع ونواح",36,"ح",1,0],["وَسِتْراً علَى السِّتْرِ الرَّفِيعِ بَهاؤهُ","بهِ وَيَزينُ السيفَ حُسْنُ نِجادِهِ",37,"د",2,0],["وستدري بأننا قَدْ تَعِبن","وعَطِشْنا، والماءُ في أيدينا",38,"ن",2,0],["وسَتَرُوا مِن عُلاكَ ما عَلِمُوا","وهيَ لعمرْي نارٌ على عَلَم",39,"م",1,0],["وستراً على هذا النظام فإنه","كثير الحيا من ذهنك المتوقد",40,"د",1,0],["وَسترتها بِتَواضعي فَتطلَّعت","أَعناقها تَعلو عَلى الأَستارِ",41,"ر",1,0],["وسِتْرَ صَوْنٍ لوجهِ مولىً","بِهِ رعى اللهُ كلَّ سِتْرِ",42,"ر",1,0],["وستةُ أيام الدوامِ بهائمٌ","منصَّفةٌ إلقاحُهن حِيالُ",43,"ل",1,0],["وستملكُ الدُّنيا تملُّكَ قابضٍ","وتُطيعُكَ الحمراءُ والبيضاءُ",44,"ا",2,0],["وَسِترٍ لَهُ مَنظَرٌ مونِقٌ","وُجوهُ تَصاويرُهُ تُشرِقُ",45,"ق",1,1],["وَسِترٍ لِصاحِبِهِ نيقَةٌ","فَسَلَّمَهُ اللَهُ ما أَحذَقَه",46,"ق",2,1],["وستضْحَكُ البيضُ الظُّبا بأكفّهم","ضحك البُروقِ بعارضٍ هتّانِ",47,"ن",1,0],["وستهم سياسة","صبت على الغز الهنا",48,"ن",2,0],["وستور تماط عن وجه حقٍّ","فيحق الرجاء والتأميل",49,"ل",1,0],["وستائر الأوهام عنه تحولت","والصبح أسفر وانقضى وقت العشا",50,"ش",2,0],["وَسَتُّهَا تَعْلَمُ مَنْ تَشْتَهِي","مِنَّا وَإِنْ مَالَتْ إِلَى الدِّرًهَمِ",51,"م",1,0],["وسترى ذلك في كتابي","فيما ترى من مقبل الأبواب",52,"ب",1,0],["وسترى قصتهم في باب","أفرده من بعد في كتابي",52,"ي",1,0],["وسترى في قتله احتجاجا","من بعد هذا يوضح المنهاجا",52,"ج",2,0],["وستبدو معجزاتٌ","شاهداتٌ بولائِكْ",53,"ك",1,0],["وستلْقَى العِزَّ صفواً","خَالصاً مِنْ خُلصَائِكْ",53,"ك",1,0],["وستُبدي فيَّ ما تُضْ","مِرُه من حُسنِ رَائِكْ",53,"ك",1,0],["وسَتَقْضِي لي بإِذْن","اللهِ ذَا قَبْلَ اقْتِضَائِكْ",53,"ك",1,0],["وسترُ ليلةِ وصلٍ بات يستُرنا","حتَّى ابتسمتُ فعاد السِّترُ مَهْتُوكا",54,"ك",2,0],["وستجتني خير الفوائد مثلما","يبنيك موطنك العزيز تفيد",55,"د",1,0],["وَسَتنجلي عَنها غَياهبُ كربةٍ","حلَّت بِها وَالكل عَنها نائم",56,"م",1,0],["وَستأخذ الأولى وتبلغ ما تَشا","عَمّا قَليل وَالزَمان خَديم",57,"م",1,0],["وَسَتنجلي عَنهُ المِياه وَيَكتَسي","حلَلاً مِن الرَوض البَهيج الناضر",58,"ر",1,0],["وستَسمو بكَ المراتبُ حتّى","تنتهي رفعةً لنيلِ الحِجابَهْ",59,"ب",2,0],["وستر الذي أخفيته من سريرة","لدى الحشر أن أبدى سرائري الحشر",60,"ر",1,0],["وستصبح الواحات جنات إذا","سار البخار بها وساد نظامه",61,"م",2,0],["وسَتُورٍ رادِفاتٍ أزفات","مدَى الطّرفِ مَداها",62,"ه",2,1],["وستيةٍ من صبي","بالغ حد العشاري",63,"ر",2,0],["وَست الأَعضاءِ وَستُّ الكُلِّ","قَد خلقوا بِسَعيهم مِن أَجلي",64,"ي",1,0],["وستر على قوم ضعاف مَدَدْتهُ","يُوارون قبل القبر إنْ غِبْتُ في القبر",65,"ر",1,0],["وستعطفوا الله لي صفحاً ومغفرة","لأنني متُّ مأثوماً وما تبتُ",66,"ت",1,0],["وسِتْرُ أَمْرٍ قدْ سارَ سائرُهُ","في كلِّ مصرٍ مِنْ كَشْفِه أَفْتَحْ",67,"ح",1,0],["وسترا وركنا في الحوادث مرتضا","ودمنا بكم في نعمة وسلامة",68,"ه",1,0],["وستر حال وهدى ومعرفة","وخشية بالمكرمات مردفة",69,"ه",1,0],["وسترا واحسانا يدوم ونظرة","بعطف به احراز ما يردف الامل",70,"ل",1,0],["وستّة بدون ما لها أثر","تنصب الاسم ثمّ ترفع الخبر",71,"ر",1,0],["وستّة من الضروب سائره","بالاختلاف وهو أصل الدائره",72,"ه",1,0],["وستة مطلقة موصوله","بلا خروج أو به معموله",72,"ه",1,0],["وستَّرنَ ما يبدين إلاّ شواهداً","محاجرَ سوداً أو بَنانا مُطرَّفا",73,"ف",2,0],["وستَغتدي لك أو غَدت","عن صاحبِ الأمرِ النيابه",74,"ب",2,0],["وستبقى كما عرفناك تزدادُ","مع العُمْرِ جودةً كالحُمَيَّا",75,"ي",2,0],["وَسَتَملِكُ الحَرَمَ الشَريفَ وَيَنتَمي","لِلِوائِكَ المَنصورِ دونَ مِراءِ",76,"ا",2,0],["وسترت وجهها عن النظر","بساعدٍ حلّ عقد مصطبري",77,"ي",1,1],["وستنقاد إلى أمرك عن","كثب أقطارها أيَّ انقياد",78,"د",1,0],["وَسَتكَ الخُطوبُ بِأَحداثِها","فَما كُنتَ مِنهُنَّ بِالسالِمِ",79,"م",1,0],["وستور مسدلاتٍ","وجماع عند ضم",80,"م",1,0],["وستر لعربان عيادة مدنف","وتغسيل ميت ثم دفن الملحد",81,"د",1,0],["وستبقين مديداً","وتوالين عديدا مقبلينا",82,"ن",2,0],["وَستبدي يا أَبا المَهدي ما","يَذهب الفكرة مِن بُقراط داد",83,"د",1,0],["وستر اللَه مسبول علينا","وعين اللَه ناظرة إلينا",84,"ن",2,0],["وستَّةٌ ونصفُ نَجمُ المِرزَمِ","خَمسٌ ونصفٌ للظليم فآعلَمِ",85,"م",1,0],["وَسِتَّةً عِندَ البُطَينِ ضَيقَا","فَذَا قياسٌ واكدٌ تَحَقَّقَا",86,"ق",2,0],["وَسِتُّ إلاّ رُبعَ في بَتَّاءِ","وَخَمسَةٌ وَنِصفُ بِالسَّوَاءِ",87,"ا",2,0],["وستدركين بجدهم ما تنشد","ين موفقين من الاله تعالى",88,"ل",2,0],["وسترديكم سمومي","وستلقيكم رياحي",89,"ح",2,0],["وستره هذا الذي جدده","الآصفي حسبما نشهده",90,"ه",1,0],["وسترت الهوا خمسين عاماً","يساترني واستره استتارا",91,"ر",2,0],["وستلتقي شيخوختانا بعد ذا","وغداً رداي سيلتقي برداها",92,"ا",3,0],["وستة أسباب تحريك البنا","تخلص في اللفظ مما سكنا",93,"ن",2,0],["وستة أذرع في الجري قسها","خلال قوائم نصف بَطيّ",94,"ي",1,0],["وست إذا ما استدامت","فاني بها دمت حيا",95,"ي",2,1],["وستنظري حسنى إدارته التي","فيها تقرّي للأمير وتشهدي",96,"د",2,0],["وَسَتذكر الأَجيالُ صن","عك في الوَرى جيلاً فَجيلا",97,"ل",2,0],["وستلقاني فتنسى كل ما","ذقت من حرب الليالي وأذاها",98,"ا",3,0],["وستٌّ يذلُّ العَزمُ دون احتمالِها","ويذهلُ عنها لبُّ كل لَبيبِ",99,"ب",1,0],["وستستقل فلا تقولوا إنها","صمد الهوان بها فلا استقلالا",100,"ل",2,0],["وَسُتورٍ قَد عُلِّقَت وَدَهالي","زَ طِوالٍ مِن خَلفِ بابٍ حَديدِ",101,"د",1,0],["وسترك يا غفار فاحم به حمى","نسبت لنا واغفر ذنوبي مع نفري",102,"ر",2,0],["وستةٌ تقبح في كل أحدْ","وهي أقبح في ستةٍ تُعَدْ",103,"د",1,0],["وستةٌ ليس لها ثباتُ","ظل الغمام جاء يا ثباتُ",103,"ت",1,0],["وَستراً مِنَ الكَتَّانِ أَسبَلَ فَوقَها","وَزَفسُ اعتَلى تَختَ النُّضَارِ بِعِزَّةِ",104,"ه",1,0],["وَسَتراً عَلى تَقصيرِ ناسِج بَردَها","فَكَم ناسِج بَرداً وَليسَ مُسهَما",105,"م",2,0],["وستنجلي بعد الغموض حقائق","فيها النواصع من فعال نبيل",106,"ل",1,0],["وسترة أو قضيبية ومنها","عراد والقرية والنخيلا",107,"ل",2,0],["وسَتبقى 