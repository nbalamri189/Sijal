ab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84882&r=&rc=23",""],[6355,"الطريق إلى مهجتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66572&r=&rc=32",""],[572,"هاقَدْ كتبتُ فما رَدَدْتَ جَوابِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9160&r=&rc=17",""]],"verses":[["فَاِرجِع إِلى رَسمِ الصَفا","ءِ فَإِنَّهُ إِن عُدتَ عادا",0,"د",2,0],["فأرجوه أن يشرئب","إلى شرفة المطلع",1,"ع",1,0],["فأرْجاؤهُ منْ نورِ وجْهِكَ تزْدَهي","وبَطْحاؤهُ منْ نَوْرِ جودِكَ تُزْهِرُ",2,"ر",1,0],["فارجُ الكَريمَ وَإِن رَأَيتَ جَفاءَهُ","فالعَتبُ مِنهُ والكِرامِ كَريمُ",3,"م",1,0],["فأرجع القهقرى أغنّى","وما سوى الشعر من غناء",4,"ا",2,0],["فَاِرجِع إِلى حَكَمَي قُرَيشٍ إِنَّهُم","أَهلُ النُبُوَّةِ وَالكِتابِ المُنزَلِ",5,"ل",1,0],["فارجع إلى الحقِّ من قُربٍ ومن أمَمٍ","وَلاَ تَمَنَّ مُنَى طفلٍ إذا مرثا",6,"ث",2,0],["فارجع إليهم واتخذ منهمُ","رِدْءاً ففيهم للأريب اتّخاذْ",7,"ذ",1,0],["فارجع وبُقيا أخيك باقيةٌ","واندم وفي الحلم فسحةٌ تسع",8,"ع",1,0],["فَاِرجِعي وَاِسكُبي دُموعُكِ سِرّاً","وَاِمسَحي بِاليَدَينِ ما تَسكُبينَه",9,"ن",2,0],["فارجعي في مهل الى القلب مني","انت لا تخلقين بالتسكاب",10,"ب",1,0],["فَاِرجِعنَ فيهِ لِحِكمَةٍ","أَو جِئنَ فيهِ إِلى اِحتِسابِ",11,"ب",1,0],["فارجع إليَّ فقد تركتَ مشرداً","مستغرقاً في الدمعِ والأتراحِ",12,"ح",1,0],["فَاِرجَحَنَّت في حُسنِ خَلقٍ عَميمٍ","تَتَهادى في مَشيِها كَالحُبابِ",13,"ب",1,0],["فأرجِعه إليك فإنَّ أسمى","خِلالِكَ أن تكون لنا معادا",14,"د",2,0],["فَأرجِعُ مِن حِمَاكَ إلَى نُجُودٍ","وَأمرَحُ مِن هِبَاتِكَ فِي سُهُولِ",15,"ل",1,0],["فارجِعِ السَّيْرِ بَيْنَ بَنْهَا وَأَت","ريبَ وكلٌّ لِشَاطِئ الْبَحْرِ جَارَه",16,"ر",2,0],["فَأَرجو أَن يَكونوا هُم جَوابي","بِلا شَكٍّ إِذا قَرَأوا الكِتابا",17,"ب",2,0],["فَأَرجِعُ لَم أَلُمهُ وَلَم يَلُمني","وَقَد رَضِيَ الضَميرُ عَنِ الضَميرِ",18,"ر",1,0],["فَاِرجَع إِلى مَولاكَ غَيرَ مُدافَعٍ","سُبحانَ مَولاكَ الأَجَلِّ الأَكبَرِ",19,"ر",1,0],["فَاِرجِعي إِن رَجَعتِ عَن رَأيِ سوءٍ","بِهَوىً لَيِّنِ الحَواشي ثَبيتِ",20,"ت",1,0],["فَاِرجِع كَما رَجَعَ الكَريمُ وَلا تَكُن","كَمُقارِفٍ ذَنباً وَلَيسَ بِتائِبِ",21,"ب",1,0],["فأرجعي يا عروس فنّي","صبا يودّ الهوى رجوعَه",22,"ع",2,0],["فَأَرجِعُ خائِباً وَالدَمعُ مِنّي","هَتونٌ مِثلَ تِسكابِ السَحابِ",23,"ب",1,0],["فَارْجِعْ إِلَى المَلِكِ الْعَظِيمِ وَقُلْ لَه","مَاتَ النَّصِيحُ وَعِشْتَ أَنْعَمَ بَالاَ",24,"ل",2,0],["فَارْجَعْ إلى مِصْرَ في أَمْنٍ وَعَافِيَةٍ","وَزُرْ دِمَشْقَ وَزُرْ بَغْدَادَ زُرْ حَلَبَا",25,"ب",2,0],["فارجع الى الله وانظر في سياسته","فأنت من مشرب القرآن ريان",26,"ن",1,0],["فأرجاؤه من نور وجهك تزدهي","وبطحاؤه من نور وجهك تزهر",27,"ر",1,0],["فارجِعِ السَّيْرَ بَيْنَ بِنْها وَأتْ","رِيبَ وكلٌّ لِشاطِىء ِ البَحْر جَارَه",28,"ر",2,0],["فأرجفُ رُعباً كأنَّ الحشا","تَخَطَّفَهُ أجدَلٌ أجدَح",29,"ح",1,0],["فارجع عن الآلات","في جملة الحالات",30,"ت",1,0],["فارجُوه واستمِعُوا له","فيما نَهاكُمْ أو أمرْ",31,"ر",1,0],["فارجوه في العُقْبَي فمن","يرجو سواه فهو خائبْ",32,"ب",1,0],["فارجع عن الذِّنب مختاراً مراجعةً","أو سوف ترجع عنه غير مختار",33,"ر",1,0],["فارجع وراءك مغلوبا فليس لكم","عذر من الله في ذكرى أبي لهب",34,"ب",1,0],["فارجَ الكريمُ إذا اسشترى به غضبٌ","إن الصواعق يأتي بعدها المطرُ",35,"ر",1,0],["فأرجه لا أدرى إلى أين مرجعي","ودمعي على خدي وكفي على قلبي",36,"ب",2,0],["فارجع إِليه فإنه لا يبتلي","من خلقه إِلاّ الأَحبَّ الأَخيرَا",37,"ر",2,0],["فارجع إذا شئت عن ظلم بدأت به","أولا فزد فوق ما أضرمته حطبا",38,"ب",2,0],["فأرجع إلى الله وأقنع تستفد شرفا","أليس رزقك فيما قاله دركه",39,"ك",2,0],["فأرجفوا بي وظنوا","أني ضللت المسالك",40,"ك",1,0],["فارجعتهم سود الوجوه كما اتوا","وتم لك الفتح الذي أنت تطلب",41,"ب",1,0],["فارجع لنا مسلّماً مصالحا","مصافحاً كفّاً تراه صالحا",42,"ح",2,0],["فأرجِعُ منها موحشاً وتشوقُني","رياضٌ موشاةٌ وموجٌ مفضَّض",43,"ض",1,0],["فَأَرْجَأتَ ما رجَّوْهُ عَن حِكمَةٍ قضَتْ","بِإِحكامِها في أوْسَطِ الحُرُمِ السَّرْدِ",44,"د",1,0],["فأَرْجع أدراجي وَلَوْ شِئتُ خاض بي","لقُبّتها طرْفي جنابَتُها القَبّا",45,"ب",2,0],["فاِرجع بودِّك عَن قَريبٍ طالِباً","عذراً على رغم العدوِّ جَميلا",46,"ل",2,0],["فأَرجفوا أَنَّني سالٍ وما عَلِموا","بأَنَّ نارَ الهوى في القَلب مُستَعِرَه",47,"ر",2,0],["فارجع إلى اللَه في سر وفي علن","واترك هواك وهيء الزاد للسفر",48,"ر",1,0],["فارج مولاك ولا تيأس وإن","حل خطب وأمور عسرت",49,"ت",1,0],["فارجِعْ وراءك يا حَسو","دُ فما الأسافِلُ كالأعالي",50,"ل",2,0],["فارْجُ خيراً فكلُّ سَهْمٍ سديدٍ","خارجٌ من حنيّةٍ عوجاء",51,"ا",2,0],["فأرجى اليوم كشف كربه","ورفع مابي من شرور",52,"ر",1,0],["فأرجو سواك لكشف ضرى","ولستب أخاف إلا النافع الضار",53,"ر",1,0],["فارجعْ إلى اللهِ وثِقْ بالذِي","وَافاكَ في الصّادِقِ من وَعْدِهِ",54,"د",2,0],["فَاِرجعْ بِيَأسِكَ لَستَ أَوَّلَ آمِرٍ","شَقَّ الغَرَامُ عصَاهُ بالعصيانِ",55,"ن",1,0],["فأرجعُ عن نعماك في ألف درهم","أُزيلُ بها فَقري وأغني بها أهلي",56,"ل",2,0],["فأرجعُ عنك مُنْقَلِباً بخير","وأحْمَدُ من مكارمك انقلابي",57,"ب",2,0],["فارجِعْ عنِ الوادي فإِنَّ مياهَهُ","مما يُشَبُّ بها غليلُ الهيمِ",58,"م",1,0],["فارجِعْ الى فضلِ الحُكومةِ بينَنا","هذي الدفاتِرُ والمحابرُ تشهَدُ",59,"د",1,0],["فأرجعُ شُمَّاتِ الأعادي برقَّتي","أخِلاَّء صدقٍ وجدهمْ يتَضَرمُ",60,"م",1,0],["فَاِرجِعا بِالمَلامِ لا تُبلياهُ","لي فَشُؤمي مُثَقَّلٌ بِالرَصاصِ",61,"ص",1,0],["فَاِرجِع عَنِ الهَجرِ الَّذي لِمَصيِفِهِ","حُرٌّ فَطَلُّ رَبيعِ وَصلي بارِدُ",62,"د",1,0],["فارجع لود كامل متقدس","واطرح هوى متضعضع الأركان",63,"ن",1,0],["فارجعْ لربِّكَ لا تُؤمِّلْ غيرهُ","لا بدَّ توليكَ العنايةَ نُصرتُهْ",64,"ت",2,0],["فارجع لعادتك الكريمة منعماً","أولا فقل لي ماعدا مما بدا",65,"د",2,0],["فَاِرجِعوا مِنّا فُلولاً وَاِهربوا","لِظِفارٍ لَيسَ يُؤويكُم ظَفارُ",66,"ر",1,0],["فَارجِ الظَّلاَمِ وَهَادِي الأَنَامِ","وَالوَصِيِّ صَاحِبِهِ وَالبَتُولِ",67,"ل",1,0],["فارجُمْ بِنجْمِ الكاسِ شي","طانَ الكآبَةِ فَهْوَ مارِدْ",68,"د",1,0],["فارجِعْ إلى الإنصاف واعلمْ أنَّه","أولى بذي الأَلْبَاب والأحسابِ",69,"ب",1,0],["فارجع كما جئت ليطمئنوا","وليأمنوا من الذي قد ظنوا",70,"ن",3,0],["فارجع إِلى مصرَ فقد شَفَّها","إِليكَ شوقٌ وشَجَاها ادِّكار",71,"ر",1,0],["فَأرجو له التوفيق والفوز في غدٍ","ويُجزى بإحسانٍ بيوم حسابِ",72,"ب",1,0],["فارجعْ إلى الله وألقِ الهوى","إنّ الهوى في النارِ مأواهُ",73,"ا",2,0],["فأرجعتها عطلى تجر شراكها","رجوع امرئٍ عن مؤمل الصيد 