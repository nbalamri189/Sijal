ا","https://www.aldiwan.net/poem33573.html","الطويل"],[558,"كيف أخشى من اللعين اللاهي","https://www.aldiwan.net/poem33635.html","الخفيف"],[558,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[558,"نزل الحديد فكان سيفا قاضبا","https://www.aldiwan.net/poem34972.html","الكامل"],[575,"على خاطري يا شغله منك أشغال","https://www.aldiwan.net/poem3029.html","الطويل"],[575,"ليل وصل منيرة أقماره","https://www.aldiwan.net/poem3059.html","الخفيف"],[587,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"]],"verses":[["بِأَسمائِكَ الحُسنى الَّتي بَعضُ وَصفِها","لِعِزَّتِها يَستَغرِقُ النَثرَ وَالنَظما",0,"م",2,0],["بِاسْماعيلَ ثمّ أخيهِ قَيْسٍ","صَبِرُ التصبُّرِ منْ أجَلِّ عِلاجِها",1,"ه",2,1],["باسِلَةُ الوَقعِ سَرابيلُها","بيضٌ إِلى جانِبِهِ الظاهِرِ",2,"ر",1,0],["بِأَسيلٍ صَدقٍ يُثَقِّفُهُ","فيهِنَّ لا نابِياً وَلا مَأطَورا",3,"ر",2,0],["بَأسٌ كَما صالَ الهِزَبرُ إِزاءُهُ","جودٌ كَما جادَ الخِضَّمُ الخِضرِمُ",4,"م",1,0],["بِأَسوَدَ مُلتَفِّ الغَدائِرِ وارِدٍ","وَذي أُشُرٍ تَشوقُهُ وَتَشوصُ",5,"ص",1,0],["بِأَسحَمَ زَحّافٍ كَأَنَّ اِرتِجازُهُ","تَوَعُّدُ أَجمالٍ لَهُنَّ قَراقِرُ",6,"ر",1,0],["باسلٌ لم تزده إلا ثباتاً","غمرات رمته بالأهوال",7,"ل",1,0],["بِاسْميْكُمَا تَوَّجْتِ فِي سِفْرِ العُلَى","طِرْساً خَلا إِلاَّ مِنْ العُنْوَانِ",8,"ن",1,0],["بِأَسهُمِ لَفظٍ لَم تُرَكَّب نِصالُها","وَأَسيافِ لَحظٍ ماجَلَتها الصَياقِلُ",9,"ل",1,0],["باسط كفيه لطلاَّبه","فهو الورى وهي البسيطان",10,"ن",1,0],["بإسماعيل ابْتدئ الأيادي","وإبراهيم اخْتتم النوالا",11,"ل",2,0],["باسطُ الوجهِ ضاحكُ السن بسَّا","مٌ على حين كُرْهِهِ والرّضاءِ",12,"ا",2,0],["بأسُ الأميرِ وأبطالٌ مُدَجَّجَةٌ","وكلُّ أجردَ مَلْحُوفٍ ومَلْبون",13,"ن",1,0],["بِأَسفَلِ ذاتِ الدَبرِ أُفرِدَ خَشفُها","فَقَد وَلِهَت يَومَينِ فَهيَ خَلوجُ",14,"ج",1,0],["بِأَسرَعَ وِرداً مِنهُمُ نَحوَ دارِهِ","وَلا ناهِلٌ وافى الجَوابِيَ عَن عَشرِ",15,"ر",1,0],["بِأَسفَلِ ذي بيضٍ كَأَنَّ حُمولَها","نَخيلُ القُرى وَالأَثأَبُ المُتَناوِحُ",16,"ح",1,0],["بِأَسيافٍ لَنا مُتَوارَثاتٍ","كَشُهبانٍ بِأَيدي مُصطَلينا",17,"ن",2,0],["بِأَسحَمَ مِن هَيجِ الذِراعَينِ أَتأَقَت","مَسايِلَهُ حَتّى بَلَغنَ المَناجِيا",18,"ي",2,0],["باسِطُ عَدلٍ عَلى الأَعداءِ لَو عَصِبوا","بِغَيرِهِ لَتَوَخّى الجورَ أَو حافا",19,"ف",2,0],["باسِطُ رَوضٍ تَجري يَنابِعُهُ","مِن مُرجَحِنِّ الغَمامِ مُنسَجِمِه",20,"م",2,0],["بأسٌ كَصَرْفِ الدَّهرِ أشرفَ فاعتدَى","وندىً كَصَوْبِ المُزْنِ صُوِّبَ فانهمَى",21,"م",2,0],["بأسد غدت بيض الصوارم في الوغى","وسمر القنا آجامها والجداولا",22,"ل",2,0],["بِأُسْدٍ لاتَحِيدُ عن المَنايا","إذا اعتقَلَت قَنا الخطِّ اعتِقالا",23,"ل",2,0],["بَأسٌ يُذَلَّكُ صَعبُ الحادِثاتِ بِهِ","فَأَصبَحَ الدَهرُ يَشكو شِدَّةَ التَعَبِ",24,"ب",1,0],["بِأُسودٍ بيضِ الوُجوهِ طِوالِ ال","باعِ شُمِّ الأُنوفِ غُلبِ الرِقابِ",25,"ب",1,0],["باسِطُ العَدلِ في البِلاد","آلُ غازي بنَ أُرتُقِ",26,"ق",1,0],["باسطاً نحوه يديه بلهفٍ","حارصاً أن يمر من كفيه",27,"ه",1,0],["بأُسدِ وغىً كم قيل عوجوا نُصرْتمُ","على الموت من حرب العداة فعاجوا",28,"ج",3,0],["بَأسٌ تُفَلُّ بِهِ الصُفوفُ وَتَحتَهُ","رَأيٌ تُفَلُّ بِهِ العُقولُ رَزينُ",29,"ن",1,0],["بِإِسحَقَ بنِ اِبراهيمَ أَضحَت","سَماءُ الجودِ تَنهَمِرُ اِنهِمارا",30,"ر",2,0],["بِأَسمَحَ مِن غُرِّ الغَمامِ سَماحَةً","وَأَشجَعَ مِن صَرفِ الزَمانِ وَأَنجَدِ",31,"د",1,0],["بَأساً قَليلِيّاً وَبَأسَ تَكَرُّمٍ","جَمٍّ وَبَأسَ قَريحَةِ مَولودا",32,"د",2,0],["باسِطاً بِالنَدى سَحائِبَ كَفٍّ","بِنَداها أَمسى حَبيبٌ حَبيبا",33,"ب",2,0],["باسمِ إلهِ الخلْقِ هذا ما اشترى","محمدٌ بنُ يونسَ بن سُنْقُرا",34,"ر",2,1],["بِاِسمِ الإِلَهِ تَحيَّةٌ لِمُتَيَّمِ","تُهدى إِلى حَسَنِ القَوامِ مُكَرَّمِ",35,"م",1,1],["باسمِ الذي جَعلَ البيانَ أمانةً","أقضِي الحُقوقَ وأُكرِمُ الآثارا",36,"ر",2,0],["بَأْسُ رسولِ اللَّهِ في صَحْبِهِ","ما أَعظَمَ البأسَ وما أكْبَرا",37,"ر",2,0],["بِاِسمِ الإِلَهِ المَلِكِ الرَحمَنِ","ذي العِزِّ وَالقُدرَةِ وَالسُلطانِ",38,"ن",1,1],["بِأَسيافٍ لَكُم أَودى","حُسَينٌ وَهوَ ظَمآنُ",39,"ن",1,0],["بأسْيافِ ذاكَ البَغْي أوّلَ سَلَّهَا","أُصِيبَ عليٌّ لا بسيْفِ ابنِ ملجم",40,"م",1,0],["باسمِها الخالدِ امتشقتُ حُسامي","بيدٍ تخفضُ الحظوظَ وتُعلي",41,"ي",1,0],["بِأَسمَرَ مِن رِماحِ الخَطِّ لَدنٍ","وَأَبيَضَ صارِمٍ ذَكَرٍ يَمانِ",42,"ن",1,0],["باسمُ الزَّهْرِ عاطِرُ النَّشْرِ هَامِي ال","قَطْرِ وَانِي الصَّبَا عَلِيلُ الْمَهَاةِ",43,"ه",1,0],["بَأْسٌ بِلا يَأْسٍ وَحَزْ","مٌ فِي النزَالِ بِلا لَمَمْ",44,"م",1,0],["بَأْسٌ وَمَا أَحْلاَهُ فِي مُتَكَرِّمٍ","عَنْ لُوثَةِ المُتَصَلِّفِ المُتَحَامِقِ",45,"ق",1,0],["بَاسِماً أَوْ مُقَطِّباً عَنْ مُحَيَّا","بَارِزِ العَارِضَيْنِ فَوْقَ الهَادِي",46,"د",2,0],["بِاسْمِ المَلِيكَةِ فِي الأَزَاهِرْ","ذَاتِ الجَلاَلَةِ وَالبَهَاءْ",47,"ا",2,1],["بأس هزبر غوثان","وجود غيم ملآن",48,"ن",1,0],["باسم الصلاح يشوِّهو","ن جمال دين محمد",49,"د",1,0],["بَاسِمٌ أنت للضيوف، وأحلى","مَا بِه يُكْرَمُ الضيوفُ ابتسام",50,"م",1,0],["باسم الصليب أو الهلا","ل على الرقاب تحكما",51,"م",2,0],["باسم الحضارةِ والتعميرِ قد دَخَلوا","وما هُموَ غيرُ سفَّاكٍ ومُخْتَلِسِ",52,"س",1,0],["باسمِها صار قائدًا كلُّ مَنْ يُحْلُ","بُ شاةً، وصار كسرى مقُودا",53,"د",2,0],["باسمها ثلَّتِ العروشَ قريشٌ","وغدا أهلُها ملوكًا صِيدا",53,"د",2,0],["بِاسْمِه يَظْفَرون بالمال والجَا","هِ ويَقْضِي كلُّ امرئ آرابه",54,"ب",2,0],["بَاسِمَ الثغر قبل أن يفتح البا","ب، لمن زار يفتح الأحضانا",55,"ن",2,0],["باسمه أمْسَى يسُوسُ الأرض مَنْ","يحلبُ النوقَ، ومَنْ يرعى الشِّيَاه",56,"ا",2,0],["بإسماعيل ثم أخيه قيس","تأذن ليل همي بانبلاج",57,"ج",1,1],["باسمي يوشون الخيانة","يسفحون دمي . بزندي",58,"د",2,0],["باسم من تنطقون؟ تخشون ماذا؟","من يغذي نبوءة الكاذبينا؟",59,"ن",2,0],["باسم قيسٍ تهذين كل مساءٍ","فوق ناري ستخبزين دقيقي",60,"ق",2,0],["باسم ابنِ سَعدونَ فَاضتْ حرقةٌ طُويَتْ","دَهْراً وأعلَنَ شجوٌ كانَ يكتَتِم",61,"م",1,0],["باسم النظامات لاقت حتفَها أممٌ","للفوضوية تشكو تلْكم النظما",62,"م",2,0],["باسم \" الفرات \" وتنظيمٍ له خُلقتْ","دوائرٌ لم يَبِنْ من سعيها أثَر",63,"ر",1,0],["بأسمائك الحسنى التي بعض وصفه","بعزتها يستغرق النثر والنظما",64,"م",2,0],["بأسماعكم وقر وقد رحت شاكيا","وحاشا ففي سمع الثرى وحده الوقر",65,"ر",1,0],["بأسيافٍ لنا متوارثاتٍ","كشهبانٍ بأيدي مصلتينا",66,"ن",2,0],["بِأَسْرَعَ مِنْهَا فِي الحِكَايَةِ وَال