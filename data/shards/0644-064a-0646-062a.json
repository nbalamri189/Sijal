يل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131090",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131196",""],[3813,"","https://poetry.dctabudhabi.ae/diwan/poem/105688","البسيط"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2535","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111401","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111395","الوافر"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44905","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94553","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94474","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94555","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94363","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136489",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72347","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120469","الوافر"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67438","البسيط"],[4679,"لعمرك إن كل الناس رهنٌ","https://www.poetsgate.com/ViewPoem.aspx?id=142754",""],[4683,"عصر شبابي في الهوى عذبا صفا","https://www.poetsgate.com/ViewPoem.aspx?id=166757",""],[4882,"إن البلاغة في النهرين تزدحم","https://www.poetsgate.com/ViewPoem.aspx?id=34801",""],[4960,"السَّيِّد النُّبْل","https://www.poetsgate.com/ViewPoem.aspx?id=214474",""],[4994,"وجه واحد في مرايا القلب","https://www.poetsgate.com/ViewPoem.aspx?id=209098",""],[5409,"أهزةٌ أيقظت من روعها البلدا","https://www.poetsgate.com/ViewPoem.aspx?id=155458",""],[5410,"رسالة خاصة","https://www.poetsgate.com/ViewPoem.aspx?id=140759",""],[5480,"الجيره","https://www.poetsgate.com/ViewPoem.aspx?id=30870",""],[5582,"لَئِنْ تُخْفِ ما بِكَ أَوْ تَصْبِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=187009",""],[5794,"غرور الشعر ..","https://www.poetsgate.com/ViewPoem.aspx?id=122796",""],[5309,"سلام على ذكر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""],[6228,"نعم سأنساك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85968&r=&rc=5",""]],"verses":[["لَئِن تَرامَت بِكَ الأَعوادُ مُعجِلَةً","عَنِ الدِيارِ إِلى مُزوَرَّةِ الخالي",0,"ل",2,0],["لَئِن تَكُ كَفّي ما تُطاوِعُ باعَه","فَلي في وَراءِ الكَفِّ قَلبٌ مُذَرَّبُ",1,"ب",1,0],["لَئِن تَكُ قَد عُمِّرتَ دَهراً لَقَد بَكى","عَلَيكَ مَعَ الباكي خَلائِقُ أَربَعُ",2,"ع",1,0],["لِيَنْتَشِرْ بَعْدَ طَيٍِّ ذَلِكَ الْعَلَمُ","وَلْيَنْتَعِشْ أَمَلٌ يَكْبُو بِهِ الألمُ",3,"م",1,1],["لِينتَتِجُوهَا فِتنَةً بَعدَ فِتنضةٍ","فَيفتَصِلُوا أفلاَءَها ثُمَّ يَربُبُوا",4,"ب",3,0],["لئنْ تفرَّدَ بالعلياءِ سؤدده","لقدْ تفرَّدَ بالآدابِ شاعره",5,"ر",2,0],["لئن تخيَّرت في السادات مثلك لي","لقد تخيَّرت مختار بن مختار",6,"ر",1,0],["لئن تمَّ عشقي في ملاحتهِ لقد","تعشَّقت بدراً في الملاح تماما",7,"م",2,0],["لئن تَصيَّدَني ظبيٌ بمقلته","لقد تَصيدُ الظِّبا من قَبْله الأسدا",8,"د",2,0],["لئن تحكمتِ الأعداء فيك لقّد","حَكمتَ فيهم ظُبا الهندية البُتُر",9,"ر",1,0],["لئن تصدَّى لنابَي حيَّةٍ ذكرٍ","نضناضة لا يبلُّ الدهر من لدغه",10,"غ",2,0],["لَئِن تَكُ أَترَعتَ القُلوبَ مَحبَّةً","فَإِنَّكَ لَم تُخلَق لِغَيرِ المَحَبَّةِ",11,"ه",1,0],["لَئِن تَكُ لِلتاريخ وَاللَهِ زينَةٌ","فَما زينَةُ التاريخِ إِلّا مَفاخِرُه",12,"ر",2,0],["لَئِن تَباهى بِكَ الدينُ الحَنيفُ لَكَم","تَقَوَّمَت بِكَ لِلإِسلامِ أَركانُ",13,"ن",1,0],["لَئِن تَمَشّى البِلى تَحتَ التُرابِ بِهِ","لا يُؤكَلُ اللَيثُ إِلّا وَهوَ أَشلاءُ",14,"ا",2,0],["لَئِن تَرَكنَ ضُمَيراً عَن مَيامِنِنا","لَيَحدُثَنَّ لِمَن وَدَّعتُهُم نَدَمُ",15,"م",1,0],["لَئِن تَكُ طَيِّئٌ كانَت لِئاماً","فَأَلأَمُها رَبيعَةُ أَو بَنوهُ",16,"و",2,1],["لَئِن تَمَّ الفِداءُ كَما رَجَونا","بِيُمنِكَ بَعدَ مُكثٍ وَاِنتِظارِ",17,"ر",1,0],["لَئِن تَفرَكَّ عِلجَةُ آلِ زَيدٍ","وَيُعوِزكَ المُرَقَّقُ وَالصِنابُ",18,"ب",1,1],["لئن تأخّرَ عنه كلُّ ذي هممٍ","فاللّه قَدّمَ منه في العلى قدما",19,"م",2,0],["لئن تزاحمنا بساحاته","فالموْردُ العذبُ كثير الزحام",20,"م",1,0],["لُيِّنَت مُزنُها فَكانَت رِهاماً","وَسَجَت ريحُها فَكانَت نَسيما",21,"م",2,0],["لَئِن تَكُ هاشِمٌ أَسِفَت عَلَيهِ","لَقَد كَرِهَت أُمَيَّةُ أَن يَزولا",22,"ل",2,0],["لَئِن تَخَلَّيتُ مِن لَهوي وَمِن سَكَني","لَقَد تَأَهَّلتُ مِن هَمّي وَأَحزاني",23,"ن",2,0],["لِينٌ تُساسُ بهِ الخُطوبُ وشِدّةٌ","والنّصْلُ شدّةُ بأسه في لِينه",24,"ن",2,0],["لئن تركن ضميراً عن ميامننا","ليحدثنّ لمن ودّعنهم ندم",25,"م",1,0],["لَئِن تَكُ كَفّي ما تُطاوِعُ باعَها","فَلي في وَراءِ الكَفِّ قَلبٌ مُذَرَّبُ",26,"ب",1,0],["لَئِنْ تَنْزِلِي دَارَ الْفنَاءِ وَحِيدَةً","فَلاَ كَانَ قَلْبِي فِي الْهَوَى قَلْبَ أَرْوَعِ",27,"ع",1,0],["ليَّنت لي كل شيءٍ بعد قسوتِه","فالعظمُ لي مخَّةٌ والجذعُ إغريض",28,"ض",1,0],["لئن تَك عاهلَ الفُصحى المفَدَّى","فحَسبي: أنَّني بعضُ الجنود",29,"د",1,0],["لئن تَكُ في حَزِيرَانَ جَمَالاً","فما عقمت، ولا قَلَّ الرجال",30,"ل",1,0],["لئن تكُ كفي ما تطاوَلَ باعُها","فلي من وراء الكف قلبٌ مُدرّب",31,"ب",1,0],["لئن تكن خُدَعٌ ساءتْ عواقبها","فكم أنارتْ طريقاً مُظلِماً خُدَع",32,"ع",1,0],["لَئِنْ تَفْرَكْكَ عِلجَةُ آلِ زَيْدٍ","وَيُعْوِزْكَ المُرَقَّقُ وَالصِّنابُ",33,"ب",1,1],["لئن تَصيَّدَني ظبيٌ بمثلته","لقد تَصيدُ الظِّبا من قَبْله الأسدا",34,"د",2,0],["لئن تك في بغداد يا دهر مذنباً","على ففي بيروتَ كم لك من عذر",35,"ر",1,0],["لئنْ تشمتِ الأعداء يا بنتَ مالكٍ","فإن ودادي مثلما كانَ يعهدُ",36,"د",1,0],["لَئِن تَكُ لِمِّتِى شَعثَت زَمَاناً","ودَامَ الدُّهنُ في بِعضِ التَّلاَمِ",37,"م",1,1],["لَيَّنتَهُ وَلَوَيتَهُ فَتُراثُهُ","بَينَ اللَيانِ يَضيعُ وَاللَيّانِ",38,"ن",1,0],["لَئِن تَكُ نارُ البَغضِ تَلظى بِعَينِه","فَفي قَلبِهِ النُوّار لِلحُبِّ مزودُ",39,"د",1,0],["لئن تولّى حميداً","بكلّ مدحٍ وشكر",40,"ر",1,0],["لئن تكُ زلاتُ الكبارِ كبيرة","فأكبرُ منها من عَفا وأقالها",41,"ل",3,0],["لئن تسألِ العشّاقَ عن دمعاتهم","أروكَ على صفرِ الوجوهِ انهمالها",41,"ل",3,0],["لئن تكشُفي عمّا سمعتِ خفوقَهُ","ترَي أسداً بينَ الضّلوعِ مقيَّدا",42,"د",2,0],["لئن تَعودي تُعيدي مانهيمُ بهِ","إياكِ نعبدُ بَعدَ اللهِ إياك",43,"ك",1,0],["لَئِنْ تَمَلْمَلْتَ في جُنْحِ الدُّجَى أَرَقاً","فَسَوْفَ تَنْعَمُ في الفِرْدَوْسِ مُتَّدِعا",44,"ع",2,0],["لئن ترني والهمُّ أَثقلَ كاهلي","أطوف عليه خلتني رجلاً همّا",45,"م",2,0],["لئن تَطْلُب الأيّامُ منه بثَأْرِها","لقد قتَل الأيّامَ من عِلْمِه قَتْلا",46,"ل",2,0],["لئن تفقَّهتَ هات قُل لي","فليسَ لي بالخِلافِ خبرُ",47,"ر",1,0],["لئن تولَّوا فليسَ بي رمقٌ","أحسّ فيه بفجعةِ الفَقدِ",48,"د",1,0],["لئِنْ تنقَلْتُ من دارٍ إلى دارِ","وصِرْتَ بعدَ ثواءٍ رَهْنَ أسفارِ",49,"ر",1,1],["لئن تقَرَّبْتُم إلى عِزَّةٍ","فقدْ يعودُ البدرُ بعد المحاق",50,"ق",1,0],["لئن تأخرعني فيض جودكم","إلى مدى فيما أعتاض عن وطني",51,"ن",2,0],["لئِنْ تناهى بِهِمْ أُفْقٌ فَشَطَّ بِهِمْ","لَشَدَّ مَا حَمَلَتْهُمْ نحوَكَ الهِمَمُ",52,"م",1,0],["لَئِنْ تُنُوسِيَ تحرِيمُ المُحَرَّمِ لي","سَعْياً لعَجْلانَ مَا أَمَّنت لي رَجَبا",53,"ب",2,0],["لَئِنْ توهَّمَهُ الأَعداءُ لي نُكَباً","أَنْحَتْ عليَّ لقد عُوِّضْتُها رُتَبا",53,"ب",2,0],["لئن تلبس السلوان عنهم مؤملا","من اللَه عفواً عنك يعفو ويمحك",54,"ك",1,0],["لئن تذوقت سما أنت واضعه","فيما طهوت فهذا السم أزهاري",55,"ر",2,0],["لَيَنتَزِعَن أَرماحَنا فَأَزالَهُ","أَبو حَنَشٍ عَن ظَهرِ شَقّاءَ صِلدِمِ",56,"م",1,0],["لينت قاسية القلوب بخطبة","أصغى إليها المجمع المشهود",57,"د",1,0],["لئنْ تَكُ غيرَ صادقةٍ بمدحي","لقد صَدَقَتْ بإخلاصِ الطَّوايا",58,"ا",3,0],["لَئِنْ تَكُن كَدَّرَتْ عيشَ الحزينِ فقد","نالت مَقاماً بهِ عيشُ النَّزيلِ صَفا",59,"ف",2,0],["لئن تَكُنْ أرضُهُ أدنَى بِلادِكما","فتِلكَ أُسٌّ عليهِ البيتُ قد عَمَرا",60,"ر",2,0],["لئِن تَكُنْ نَظْرةٌ جَرَّتْ لهُ ضَررَاً","مُنذُ القديمِ فتلكَ اليومَ تَنفَعُهُ",61,"ع",2,0],["لئن تأخَّرَ في أيَّامِهِ زَمناً","فقد تَقدَّمَ في أجيالهِ رُتَبا",62,"ب",2,0],["لَئنْ تَكُنْ عن سَوادِ العينِ غائبةً","فإنَّها في سَوادِ القلبِ قد طَلَعَتْ",63,"ت",1,0],["لَئنْ تَسَربلتُ من عُجْبي بهِ حُللاً","فقد تَعلَّمتُ من ألطافِهِ خُلُقا",64,"ق",2,0],["لَئِنْ تكُنْ عينُ تلكَ الشَّمسِ غائبةً","فقد أقامَت علينا رايةَ الشَفَقِ",65,"ق",1,0],["لَئِنْ ترَكَتْكَ هِمَّتُهُ لضُعفٍ","فإنّ أباهُ لم يَترُك أباكا",66,"ك",2,0],["لئِن تكُ صُورةٌ جَمَعَتْ فأوعَت","فإنَّ التِبرَ أشبَهُ بالرَّمادِ",67,"د",1,0],["لَئِن تَبذُلوا فيهِ النَفيسَ فَغَيرُكُم","لِإِحرازِهِ هَلَكَ النُفوسَ تَجَشَّما",68,"م",2,0],["لَئِن تباعدنَ أشباحٌ وأشباحُ","فما تباعدنَ أرواحٌ وأرواحُ",69,"ح",1,1],["لَئِن تكُ غبتَ عن دارٍ ستفنى","ففي الفردوسِ صارَ لكَ الخُلودُ",70,"د",1,0],["لئن تكُن كِمدَت منهُ محَاسنُهُ","فليس يغشى سَنَا أَقوَالهِ كَمدُ",71,"د",1,0],["لَئنْ تواصَوْا بمنع الحقّ بينهُمُ","وقَصْدُهُمْ بيَ إضرار وإرْداءُ",72,"د",3,0],["لئن تبسم ثغري","فما تبسم قلبي",73,"ب",2,0],["لئن تستشفوا مهجتي لرأيتمُ","ولائي فيها وهو شخصٌ مصوَّر",74,"ر",1,0],["لئن تخليت عن أهلي وعن سكني","فقد تأهلت من نعماء وُدِّهِم",75,"م",1,0],["لئن تتركوه إلى غيره","فلا عذر للآثم العامد",76,"د",1,0],["لين ترم السمايا","ما ينرعى مرعاه",77,"ا",2,0],["لئن تكن المنية أجر فضل","فقد وفيِّت قسطك للمعالي",78,"ل",2,0],["لِينتظم الشمل الشتيت بِقُربكم","وَتغفي أَجفان أَضر بِها السهَر",79,"ر",1,0],["لِيَنتَهِبوا مالي وَدون انتهابه","حُسامٌ رَقيق الشَفرَتين خَشيب",80,"ب",1,0],["لَئنْ تَقَدَّمَ قَوْمٌ عَصْرَ سَيِّدِنا","فَكَمْ تَقَدَّمَ خَيْرَ المُرْسَلينَ نبي",81,"ب",2,1],["لئن ترني يوماً أكلم راضياً","اقاربه طوراً وطوراً اجانبه",82,"ب",2,1],["لئن تفاخرت يا عادا ويا مضرا","لا يعرف الترب لا عادا ولا مضرا",83,"ر",2,0],["لَئِن تَرَكتُ الرّاحَ جانَبتَني","ما كانَ حُبّيكَ عَلى الرّاحِ",84,"ح",1,0],["لئن تظلم بعدهم النوادي","ولم يدر المساء من الصباح",85,"ح",1,0],["لئن تصابيتُ فالتقوى مَنهنهةٌ","وقد تُرى صبوات الشيخ احْيانا",86,"ن",2,0],["لَئِن تَقَدّمت أَبناءَ الكِرامِ بِه","لَقَد تَقَدّم آباءَ اللِّئام بكا",87,"ك",2,0],["لئن تجلَّى أخو مجدٍ بسؤددِه","وزانَه في البرايا طيبُ محتدِه",88,"ه",1,0],["لئنْ تنصبي تمثالَهُ علَم الهُدَى","فكمْ لهداهُ في القُلوبِ هياكل",89,"ل",1,0],["لئن تنشديهِ نشدتِ الكمال","وسِرتِ إلى المثلِ الأرفع",90,"ع",1,0],["لَئِن تَمَّت فَوا أَسَفا","وَلَم تَخَرَب فَوا عَجَبا",91,"ب",2,0],["لئن تركت ليلى السهاد لناظري","فكم جلبت ليلى الرقاد لمقلتي",92,"ي",1,0],["لئن تجمّعت في ثغري وليتك لو","لأجعلنّك بحَدّ البيض ذا فرق",93,"ق",1,0],["لينتقمنّ اللهُ من كلّ فاجِرٍ","بكم ليس إلا لِلنَّذالَة والغَدْر",94,"ر",1,0],["لئن تأخرت عن مفروض خدمته","تحشماً فضميري غير متهم",95,"م",1,1],["لَئِن