{"poems":[[88,"دمعة من دموع عهد الشباب","https://www.aldiwan.net/poem10372.html","الخفيف"],[95,"تحية أيها القتلى وتسليماً","https://www.aldiwan.net/poem11387.html","البسيط"],[95,"أبيت والسيف يعلو الرأس تسليماً","https://www.aldiwan.net/poem11419.html","البسيط"],[4,"طافت أسيماء بالرحال فقد","https://www.aldiwan.net/poem21147.html","المنسرح"],[49,"يا حسرة ما أكاد أحملها","https://www.aldiwan.net/poem25170.html","المنسرح"],[74,"قدمت كالسيف إلى غمده","https://www.aldiwan.net/poem18559.html","السريع"],[74,"قد آثر القوم من بيروت همهم","https://www.aldiwan.net/poem18616.html","البسيط"],[74,"يا شاهر اللحظ حبي فيك مشهور","https://www.aldiwan.net/poem18695.html","البسيط"],[80,"قل لمن جمع العلم","https://www.aldiwan.net/poem14201.html","مجزوء الرمل"],[45,"شغلي عن الربع أن أسائله","https://www.aldiwan.net/poem10614.html","المنسرح"],[46,"ليس الوقوف بكفء شوقك فانزل","https://www.aldiwan.net/poem30386.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54963","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54620","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[275,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[275,"حبي الخليفة مولانا ومولاك","https://www.aldiwan.net/poem35652.html","البسيط"],[302,"نفسي الفداء لمقتول على ظمأ","https://www.aldiwan.net/poem32948.html","البسيط"],[325,"عاد العزيز فاهلا","https://www.aldiwan.net/poem67227.html","المجتث"],[327,"بان الخليط فقلبي اليوم مختلس","https://www.aldiwan.net/poem56356.html","البسيط"],[354,"الفيلسوف بيعينه أنا والذي","https://www.aldiwan.net/poem15786.html","الكامل"],[369,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[409,"هو الهوى فاصطبر فيه لما يجب","https://www.aldiwan.net/poem34153.html","البسيط"],[422,"نبهت الورقاء ذات الجناح","https://www.aldiwan.net/poem54157.html","الطويل"],[509,"ما لي إلى وصل الحبيب سبيل","https://www.aldiwan.net/poem38410.html","الكامل"],[543,"قد أثرتم لواعجا وشجونا","https://www.aldiwan.net/poem47587.html","عموديه"],[543,"ثلاث شهور بل ثلاث دهور","https://www.aldiwan.net/poem48177.html","عموديه"],[567,"وجبت زيارة تربة مبرورة","https://www.aldiwan.net/poem52588.html","الكامل"],[580,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138200",""],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62534","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59067","البسيط"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35381","السريع"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137862",""],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102071","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123140","البسيط"],[2029,"","https://poetry.dctabudhabi.ae/diwan/poem/123734","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48203","السريع"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177824","السريع"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111148","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93676","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137147",""],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102503","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129832","الرمل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83240","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65980","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204593","الكامل"],[2954,"","https://poetry.dctabudhabi.ae/diwan/poem/138923",""],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82809","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89372","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108418",""],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101236","الخفيف"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36434","الدوبيت"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36678","الدوبيت"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81690","الكامل"],[4992,"بطل العلقي","https://www.poetsgate.com/ViewPoem.aspx?id=6009",""],[5266,"الفارس","https://www.poetsgate.com/ViewPoem.aspx?id=210744",""],[308,"سلوا الدموع فإن الصب مشغول","https://www.poetsgate.com/ViewPoem.aspx?id=118851",""],[5353,"قيامة الوطن المدجج بالعويل","https://www.poetsgate.com/ViewPoem.aspx?id=212241",""],[5409,"يا زماني كأنما كل أيا","https://www.poetsgate.com/ViewPoem.aspx?id=155266",""],[2229,"أُعِيدُُها هيفا بربّ الفَلَقِ","https://www.poetsgate.com/ViewPoem.aspx?id=49795",""],[5533,"أنَّاتٌ وأَوْجَاع","https://www.poetsgate.com/ViewPoem.aspx?id=177396",""],[5691,"أوهام...!","https://www.poetsgate.com/ViewPoem.aspx?id=206529",""],[5704,"ثَمِلُ الجفون","https://www.poetsgate.com/ViewPoem.aspx?id=191156",""],[5736,"اثنان","https://www.poetsgate.com/ViewPoem.aspx?id=203858",""],[402,"أبيت والسيف يعلو الرأس تسليما","https://www.poetsgate.com/ViewPoem.aspx?id=36201",""],[5916,"أيُّهَا الْسَارِحُ","https://www.poetsgate.com/ViewPoem.aspx?id=190588",""],[5956,"الطائرة المنكوبة","https://www.poetsgate.com/ViewPoem.aspx?id=193917",""],[5970,"قد أثقلت ذات قلبي اليوم شكواه","https://www.poetsgate.com/ViewPoem.aspx?id=130621",""],[5974,"بارق الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=215428",""],[2944,"شكوى العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86015&r=&rc=4",""]],"verses":[["قَد أَثارَ المُحَمَّدانِ دَفيناً","في فُؤادي وَقَد أَطارا صَوابي",0,"ب",2,0],["قَدْ أَثَّمُوا وَكَمْ مِنْ مُثْلَةٍ نَزَلَتْ","بَالأَبْرِيَاءِ وَبِالأَبْرَارِ تَأْثِيمَا",1,"م",2,0],["قَدْ أَثمُوكُمْ وكَمْ مِنْ مُثْلَهٍ نَزَلَتْ","بِالأَبْرِياءِ وَبِالأَبْرَارِ تَأْثِيمَا",2,"م",2,0],["قَد آثَرَت فِرقَةَ البُغاءِ وَقَد","كانَت تُراعي مُلَمَّعاً شَبَبا",3,"ب",2,0],["قَد أَثَّرَ الدَهرُ في مَحاسِنِها","تَعرِفُها تارَةً وَتَجهَلُها",4,"ل",3,0],["قد أثرت فيك ليالي السرى","ما أثر السيف بإفرنده",5,"د",2,0],["قد آثر القوم من بيروت همهمُ","وضاعفت سكراتي وقفة النقد",6,"د",1,1],["قد أثرت ما يسرّ الدّين أحرفها","وللحروف كما قد قيل تأثير",7,"ر",1,0],["قَد أَثَبناكَ فَهَلّا","جلبَ الشِعرَ ثَوابهْ",8,"ب",2,0],["قد أثّر القيظ في محاسنه","وفاح ريح العبير من عرقِهْ",9,"ق",2,0],["قَد أَثقَبَ الحَسَنُ بنُ وَهبٍ في النَدى","ناراً جَلَت إِنسانَ عَينِ المُجتَلي",10,"ل",2,0],["قدْ أَثْبَتَتْ يَقْظتَهَا لِلعُلَى","بَعْدَكِ ذَاتُ الخِدْرِ فِي مِصْرِ",11,"ر",1,0],["قَدْ أَثْقَلَتْنَأ قُيودٌ لاَ نُهُوضَ بِهَا","وَإِنْ يَكُ صَائِغُ قَدْ صَاغَهَا ذَهَبَا",12,"ب",2,0],["قَدْ أَثْبَتَتْهَا مِصْرُ بَيْنَ عُيُونِها","فَالحَالُ مُتَّصِلٌ بِالاسِتقْبَالِ",13,"ل",1,0],["قَدَّ أَثواب البِلى عَن","هُ وَفي الفِردَوسِ أَثوى",14,"و",2,0],["قد أثارَ الغُبارَ في وَجْهِ مَيْمُو","نٍ وَعَفَّى عَلَى فَتَى ذُبْيانِ",15,"ن",1,0],["قد أثخنوا هذي وتِلكَ ودنّسوا","قُدسَ الشّعائرِ والدّموعُ سجام",16,"م",1,0],["قد أثبتَتها من الأجيالِ أربعةٌ","وعشرةٌ وهي منذُ الخلقِ مجراك",17,"ك",1,0],["قد أثكلَت بضعةَ المختارِ فاطمةً","وأَوجَعت قلب خَيرِ الأوصياءِ علي",18,"ل",2,0],["قَد أَثَرَ البُعدُ فيها","وَمالَ بِالأَجسامِ",19,"م",1,0],["قَد أَثَّرَ النِسعٌ فيها وَهِيَ مُسنَفَةٌ","كَما يُؤَثِّرُ في العادِيَّةِ المَرَسُ",20,"س",1,0],["قَد أَثبَتَ التَصديقَ نَفيُ تَصَوُّري","مَعنىً سِواهُ بِالتَصَوُّرِ يوصَفُ",21,"ف",1,0],["قد أثمرَتْ وَرْدةٌ حَمْراءَ طالعةً","تَجْني على الكَفِّ إن أهويتَ تَجْنيها",22,"ي",3,0],["قد أثمرت كل بدر لا نظير له","من نوره تستمد الشمس والشهب",23,"ب",1,0],["قد أثبت الوُدُّ بقلبي له","محبة لم يمحها قط ماح",24,"ح",1,0],["قد اثر الوفا بعد الفنا","مذ شاع اني في هواك قتيل",25,"ل",1,0],["قَد أثَرتُم لواعِجاً وَشُجونَا","وَهوىً كَان فِي النُّفُوسِ دَفينَا",26,"ن",2,1],["قَدَ أثنى عليهِ شاهداً ومؤَيِّدا","عظيمٌ بِجَمعٍ كان ثَمَّ غَفَيرِ",27,"ر",1,0],["قد أثبَتَ التَّاريخُ فيها أنَّهُ","في منزلِ الأبرارِ يوسُفُ ثابِتُ",28,"ت",1,0],["قد أَثْقَلتْ ظهرِي وقدّ","تْ بالْحَيَا أَدِيمي",29,"م",2,0],["قد آثرت لو كان ذاك نصيبنا","ولضيفنا أجر العليل المكتتب",30,"ب",1,0],["قد آثروا ديناً رَضي المولى ولم","تأخذهم فيه حميّة جاهلِ",31,"ل",1,0],["قد اثقلتِني ذنُوبٌ لَيْسَ يحصرُهَا","سَمْتُ الثوَابِ فلم تُحْصَرْ ولم تُطَقِ",32,"ق",1,0],["قَد أَثقلَت ظَهري ذُنوبٌ طَمَت","مَولايَ أَنقِذني فَإِنّي غَريق",33,"ق",1,0],["قد اثتني من حبيب","ذي وداد طاب اصلا",34,"ل",2,0],["قد أثقلت ظهري المسا","وي وامتلت صحفي بشر",35,"ر",1,0],["قد أثبت نحو هذا الكون حكمته","وللمُدبّر في تصريفه حكَم",36,"م",1,0],["قد أثبتت أنهارها خبر الصفا","وروت أحاديث الشذا الأزهار",37,"ر",1,0],["قد أَثَّرتْ هيبتُه في الورى","وأثَّرتْ في الحجَرِ الصَّلْدِ",38,"د",1,0],["قد أثقلت ظهري ذنوب فانثنى","بونيها عن كل حد مقعدا",39,"د",2,0],["قد آثروا الدنيا ولذة عيشها ال","فاني على الجنات والرضوان",40,"ن",1,0],["قد أثبتوا العلم والآراء مزلقة","مازل ثابتهم خطواً ولا ارتعدا",41,"د",2,0],["قَد آثر الدين أَن يَحمي فَقحمها","حَيث اِستَقام القَنا الخَطي وَاشتبكا",42,"ك",2,0],["قد اثكل الفصحى فصرح بيانها","جزعاً عليه تصدعت شرفاته",43,"ت",2,0],["قد أثبت الفخر في أنسابنا شرفا","فاستكف بالبحر لا تسأل عن الوشل",44,"ل",1,0],["قد أثارت عثيراً بشبههُ","نثر سلك فوق بسطٍ ينصُبُ",45,"ب",1,0],["قَد أَثمَرَت أَشجارُهُ وَنَخيلُهُ","ثَمَراً جَواهِرُهُ تُضيءُ المُنحَنى",46,"ن",2,0],["قد أثروا دنياهم فهي التي","أقصى قصاراها إلى اضمحلال",47,"ل",1,0],["قد أثقلوه من القيود بمرهق","وأحاط فيه من العداة سياج",48,"ج",1,0],["قد آثره طاها بالعلم","وبالأسرار له استأثر",49,"ر",1,0],["قَد أَثقَلَتني السَيِّئاتُ وَما لها","في العَدِّ مِن حصرٍ وَلا إِحصاءِ",50,"ا",2,0],["قد أثمرت أرض المنى بمسرة","لما همت من جوده المزن",51,"ن",1,0],["قد اثر المطر الصبيب بكفه","فكأَنها غصن من الاغصان",52,"ن",1,0],["قد أثارت همي جيوش الرزايا","وأسالت من مقلتي الدموعا",53,"ع",2,0],["قَد أَثَّرَ لِلكؤوس فيها دَورُ","فاِرضوا عَمَلي بِما اِقتَضاهُ الدَورُ",54,"ر",1,0],["قَد أَثَّرَ هَجرُ ليلَةٍ واحِدَةٍ","يا وَيليَ إِن طالَ مَدى الهجرانِ",55,"ن",1,0],["قد أَثقلتها نُهَّدٌ أَضْحَتْ بها","قبل الوجى تمشي كما يمشي الوجي",56,"ج",2,0],["قد أثقَلَ الأعداءَ من ضرباتهِ","فغَدَت تفرُّ وتلعنُ الأسلافا",57,"ف",2,0],["قد آثرت عيش النفوس حياتُه","هو كوثر التاريخ آثر فارتقى",58,"ق",2,0],["قد أثقلتني على ضعفي الذنوب وما","لي في سوى جاهك المقبول تأميل",59,"ل",1,0],["قد أثخنتني سهامٌ لا يُعَدُّ لها","عدُّ ، ودون خطايَ الموت قد نزَلا",60,"ل",2,0],["قد أثرت الحروب في كل أرضٍ","ووضعت الأغلال في كل جيد",61,"د",1,0],["قد أثمرت بكلّ خير مغدق","من دونها في القدر تاج المفرق",62,"ق",1,0],["قد أَثْقلَ القَلْبَ أنَّاتٌ وأَوْجَاعُ","ما عادَ يَحْملُهَا صَدْرٌ وأَضْلاعُ",63,"ع",1,1],["قدْ آثَرَ السَّيْرَ الوَئيدَ على","شوْكِ القَتادِ طوالَ أعْوامِهْ",64,"م",2,0],["قَدْ أَثْمَلَتْ وَلِهًا مِنْ كأْسِهَا سَكَرًا","للهِ كمْ سَكَبَتْ مِنْ خَمْرِهَا عَلَلاَ",65,"ل",2,0],["قد أثمل الراحُ روحَينا بكوثره","والناي ينبضُ من أنفاسِ مولايا",66,"ا",3,0],["قد أثموكم وكم من مثلة نزلت","بالأبرياء وبالبرار تأثيما",67,"م",2,0],["قَدْ أثَارَ الْحُبُّ أخْبَارَ الْهَوى","عَنْ مَيُوْلٍ رَاحَ يَمْشِيْ فيْ دَلالِ",68,"ل",1,0],["قد آثرتْه بعمرها لكنّه","لم يستفد من عمره أو عمرها",69,"ه",2,0],["قد أثقلت ذات قلبي اليوم شكواه","ولم ترق ولم ترحمه دنياه",70,"ا",2,1],["قد أثملت من شذاها كل ذائقة","فهام كأس المنى بالخمر والتّيه",71,"ه",1,0],["قد أثقلوه من القيود بمرهفٍ","وأحاط فيه من العداة سياج",72,"ج",1,0]]}