https://www.poetsgate.com/ViewPoem.aspx?id=14298",""],[82,"ما أغمدَ العضبُ حتى جُرّد الذكرُ","https://www.poetsgate.com/ViewPoem.aspx?id=3241",""],[53,"ذادَ عن مُقْلِتي لذيذَ المنامِ","https://www.poetsgate.com/ViewPoem.aspx?id=30516",""],[113,"إن الوزير أدام الله دولته","https://www.aldiwan.net/poem16293.html","البسيط"],[123,"يا أيها المنصور بأسك رحمة","https://www.aldiwan.net/poem4364.html","الكامل"],[147,"بك اقتضى الدين دينا كان قد وجبا","https://www.aldiwan.net/poem11722.html","البسيط"],[147,"إن لم أقل فيك ما يردي العدى كمدا","https://www.aldiwan.net/poem11753.html","البسيط"],[164,"لك خارقات عوائد لن تعرفا","https://www.aldiwan.net/poem58902.html","الكامل"],[201,"أيهذا الشاعر المغ","https://www.aldiwan.net/poem39872.html","مجزوء الرمل"],[214,"يا حبذا جلق الفيحا وناديها","https://www.aldiwan.net/poem13364.html","البسيط"],[215,"مات رشدي مات آها ثم آه","https://www.aldiwan.net/poem46636.html","الرمل"],[244,"لمقامك التعظيم والتبجيل","https://www.aldiwan.net/poem23840.html","الكامل"],[275,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[287,"نجم القاضي الشرف الفلكي","https://www.aldiwan.net/poem32682.html","المتدارك"],[303,"أجارك الله هذا الحلف والجار","https://www.aldiwan.net/poem36816.html","عموديه"],[333,"هات الدموع فأنت شاعر","https://www.aldiwan.net/poem55048.html","مجزوء الكامل"],[333,"أبنجواي من رقيق النشيد","https://www.aldiwan.net/poem55060.html","الخفيف"],[371,"لم نستلب عرضك المغتاب نأكله","https://www.aldiwan.net/poem17362.html","البسيط"],[376,"وأخ مسه نزولي عليه","https://www.aldiwan.net/poem57511.html","الخفيف"],[415,"قد كنت أسمع لكن خلته مثلا","https://www.aldiwan.net/poem31866.html","البسيط"],[416,"طرقتك زائرة فحي خيالها","https://www.aldiwan.net/poem67473.html","الكامل"],[454,"لم تغن عن هفوات النفس آداب","https://www.aldiwan.net/poem980.html",""],[458,"أيار كاد يذوب عطرا سابغا","https://www.aldiwan.net/poem61325.html","الكامل"],[463,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[463,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[463,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[469,"بين حزني وحسنه اليوسفي","https://www.aldiwan.net/poem3166.html","عموديه"],[482,"أعيا العواذل ما عندي من الكلف","https://www.aldiwan.net/poem15214.html","البسيط"],[567,"قف فوق رابية تجاه المسجد","https://www.aldiwan.net/poem52889.html","الكامل"],[580,"سافر فوجه العيد سافر","https://www.aldiwan.net/poem3070.html","مجزوء الكامل"],[629,"","https://poetry.dctabudhabi.ae/diwan/poem/100589","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48833","البسيط"],[969,"","https://poetry.dctabudhabi.ae/diwan/poem/145615","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119958","الكامل"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75734","البسيط"],[1204,"","https://poetry.dctabudhabi.ae/diwan/poem/123658","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64832","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64551","الخفيف"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115960","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111803","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2010,"","https://poetry.dctabudhabi.ae/diwan/poem/143782","الكامل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42443","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77339","البسيط"],[2446,"","https://poetry.dctabudhabi.ae/diwan/poem/21209","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93952","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100775","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67976","الكامل"],[3625,"","https://poetry.dctabudhabi.ae/diwan/poem/204080","الخفيف"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66368","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131030",""],[3986,"","https://poetry.dctabudhabi.ae/diwan/poem/20924",""],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86372","الكامل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33070","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33661","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120513","الرمل"],[4691,"هيفاء ردّي لمن أنحلته ِ عُمُرا ً !!","https://www.poetsgate.com/ViewPoem.aspx?id=60737",""],[5064,"إِنّ عيني حبيبتي بلقِيسُ","https://www.poetsgate.com/ViewPoem.aspx?id=199094",""],[3271,"مرثية غصن الزيتون","https://www.poetsgate.com/ViewPoem.aspx?id=103533",""],[585,"صوتٌ تجاوب بين الهمس والعلن","https://www.poetsgate.com/ViewPoem.aspx?id=161884",""],[5121,"طِفْلَتِي","https://www.poetsgate.com/ViewPoem.aspx?id=49544",""],[5431,"هذا فراق بيني وبينك ...","https://www.poetsgate.com/ViewPoem.aspx?id=190986",""],[5443,"حسرةٌ وعتابٌ","https://www.poetsgate.com/ViewPoem.aspx?id=185146",""],[5459,"المتخم","https://www.poetsgate.com/ViewPoem.aspx?id=190892",""],[5956,"إياك أن تنسي مُحبَّك خالدا","https://www.poetsgate.com/ViewPoem.aspx?id=182041",""],[5956,"حمْداً لِخالقِ فيصلِ","https://www.poetsgate.com/ViewPoem.aspx?id=194670",""],[6142,"لم تغن يوم حنين كثرة لبني ال","https://www.poetsgate.com/ViewPoem.aspx?id=155716",""]],"verses":[["لَم تَغِب عَن سَوادِ قَلبي وَإِن غِب","تَ مُعَنّى نَوائِبٍ وَصُؤوفِ",0,"ف",1,0],["لَمْ تُغْمَدِ الأَسْيَافُ مِنْ وَهَنٍ بِهَا","لِكِنْ نُفُوسٌ أُجِّلَتْ وَدِمَاءُ",1,"ا",2,0],["لَمْ تَغْفَلي حَقَّ الفَقِيرِ","وَلَمْ تَسُومِيهِ السُّؤَالْ",2,"ل",1,0],["لَم تَغدُ بِالمَلبونِ عِندَ فِطامِهِ","يَوماً وَلا بِمُطَجَّنَ القُلقاسِ",3,"س",1,0],["لم تُغلِق الشهوةُ أبوابَها","إلا أبتْ زُلفاهُ أن يُحجَبا",4,"ب",2,0],["لم تَغْنَ تلك الدارُ من بعدهمْ","بمثلِ ذاك القَصَبِ الخَرْعبِ",5,"ب",1,0],["لم تغاروا لغَيْرتي فتركْتُمْ","حُرماتِي لمَنْ أحَلَّ حرامي",6,"م",2,0],["لَم تَغِب عَن مِثلِ هَذا ال","يَومِ إِلّا لِبَلِيَّه",7,"ي",2,0],["لَم تُغادِر قَلَماً في راحَةٍ","دَولَةٌ ما عَرَفَت إِلّا الحِرابا",8,"ب",2,0],["لَم تُغذَ بِالمِسكِ وَلا الغَوالي","تَرضى مِنَ الأَدهانِ بِالأَبوالِ",9,"ل",1,0],["لم تُغْن عنك ضوامِرٌ أعناقُها","عاسلنَ عاليةَ القَنَا المتزعزِعِ",10,"ع",1,0],["لَم تَغلُ وَهيَ غَداةَ البَيعِ مُثمِنَةٌ","إِنَّ الرَخيصَ الَّذي يُلغى هُوَ الغالي",11,"ل",2,0],["لَم تُغِبَّ الخِتانَ أُمُّ مُوَيسٍ","أَنَّها لَم تَجِد كِرا الخَتّانَه",12,"ن",2,0],["لَم تَغِب عَن سِوى عُيوني فَقَلبي","شاكِرٌ عَن عُلاكَ وَالطَرفُ شاكِ",13,"ك",1,0],["لَم تُغْنِ عَنهُ غِياضٌ مِن قَناً وظُبىً","حمرُ الحماليق فيها أُسْدُها الهُصُرُ",14,"ر",1,0],["لِمَ تُغمِدِ السَيفَ الَّذي قُلِّدتَهُ","حَتّى تَمَنّى نَصلُهُ أَن يُغمَدا",15,"د",2,0],["لَم تَغربي يا ذَكاء ال","جَمال عنّيَ فتره",16,"ر",2,0],["لِم تَغَضَّبتَ عَلى عَب","دِكَ في خَطبٍ يَسيرِ",17,"ر",1,0],["لِم تَغَضَّبتَ عَلى عَب","دِكَ ذي الطَوعِ الشَفيقِ",18,"ق",1,0],["لم تغَيِّرْكَ من زمانِكَ دنيا","وحياةٌ بأهلها تتقلّبْ",19,"ب",1,0],["لَم تَغفِلِ القَولَ أَيّامٌ تُحاوِرُني","كَم ذَكَّرَتني فَأَلفَت غَيرَ مُذَكِّرِ",20,"ر",1,0],["لَمْ تُغْنِ مِنْكَ شَمَائِلُ وَفَضَائِلُ","وَاسْمٌ بِهِ عُوِّذْتَ يَا تَوْفِيقُ",21,"ق",1,1],["لَمْ تَغْتَرِبْ وَمَكَانُهَا","فِي قُرْبِهِ أَسْمَى مَكَانِ",22,"ن",1,0],["لَمْ تَغْلُ فِي مَدْحِ الْعَظِيمِ","وَلَمْ تُضِعْ جَهْدَ الصَّغِيرِ",23,"ر",1,0],["لم تغادرنا على مشتبه","في التفاصيل ولا طي الجمل",24,"ل",1,0],["لم تُغْذَ بالمَلْبونِ عِنْدَ فِطامِهِ","يوماً ، ولا بمطجَّنَ القلقاسِ",25,"س",1,0],["لم تُغْنِ عنه غياضٌ من قناً وظُباً","حمرُ الحماليق فيها أسدها الهصُرُ",26,"ر",1,0],["لم تغاروا لغيرتي فتركتُم","حرماني لمن أحلَّ حرامي",27,"م",2,0],["لَم تَغنِ عَنهُ الحُصون البيض إِذ طَلعت","سود الرَزايا عَلَيهِ اليَوم وَالقلل",28,"ل",1,0],["لم تغنِهِم تلكَ الدواوينُ التي","حضرت وَهُم عن فهمِها غِيّابُ",29,"ب",1,0],["لَم تُغنِ فيها عَنِ المُثرينَ ثَروَتُهُم","بَل ذو الحَليلَةِ مِنهُم يَحسُدُ العَزَبا",30,"ب",2,0],["لَم تُغنِ عَنهُم رِماحٌ قَلَّ مانِعُها","إِذا رَأَت ثُغَرَ الأَبطالِ أَن تَرِدا",31,"د",2,0],["لم تغتنمها فرصةً بحضورهم","بل قلتَ يرجع آمنا من خوفا",32,"ف",2,0],["لم تغيّب شاعرا إلّا","ووافته المنيّه",33,"ه",1,0],["لم تغن والله عن فقري بها فقري","كلا ولا رجعت درا قوافيها",34,"ي",3,0],["لم تغب عني وإن كنت هنالك","في نعيم هو طيف من خيالك",35,"ك",1,0],["لم تغب عني وإن كنت هنالك","في نعيم هو طيفٌ",35,"ف",1,0],["لم تغن عنه شمر ولكم فنى","منهم شباب في الوغى وكهول",36,"ل",1,0],["لم تغتصب أرضاً ولم تسفك دماً","بإعادةِ الميراثِ وهو مبرّر",37,"ر",1,0],["لَم تُغنِ عَنِ الأَبطالِ إِذا","ما صَمَّمَ مَسرودُ الشكَكِ",38,"ك",1,0],["لم تغن كثرتُكم عنكم كأنكمُ","على المزيد ولا أرقام أصفار...",39,"ر",1,0],["لم تغنك الدنيا بما أع","طتك من شرف المتاع",40,"ع",1,0],["لم تغرر به الحياة ولم يعبأ","بسيف يرديه أو تهديد",41,"د",1,0],["لَم تَغدُ يُمناكَ لِلأَقلامِ حامِلَةً","إِلّا أَعادَت بِلا شَكٍّ أَبا لَهَبِ",42,"ب",1,0],["لِم تغرَّبت قلت قال رسول ال","لَهِ والقول منه نصحٌ ونجحُ",43,"ح",1,0],["لم تُغنِ نجدتُهُم إذ حانَ يَومُهُمُ","عنْهم ولم تَحمهم من سطوةِ النُّوَبِ",44,"ب",1,0],["لَم تَغشَها مِمّا تَخافُ عَظيمَةٌ","إِلّا أَجالَ لَها الأُمورَ مَجالَها",45,"ل",3,0],["لم تغن عن هفوات النفس آداب","مهما سمت فلها سلب وإيجاب",46,"ب",1,1],["لم تغنه هذي الموائد كلها","عن وحيك المتحجب الظمآن",47,"ن",1,0],["لم تغمِز الأطماعُ لي جانباً","ولا أمالت مِنّةٌ كاهلي",48,"ل",2,0],["لم تغلُ في وصفك معْ طولها","بل وَجدَ الشعرُ مقالاً فقالْ",49,"ل",1,0],["لم تغيِّر رأيَهم في لمِّ شَعثي","غِيَرُ الدهرِ وفي سدّ اختلالي",50,"ل",2,0],["لم تغادر لحاظ ذا الغادر ال","مقلة صبراً للمستهام الوفي",51,"ي",1,0],["لم تُغنِني السابريّات الدَلامُى وما","تَخِذْتُ مِن جُنَنٍ تَحمي ومِن حَجَفِ",52,"ف",1,0],["لم تُغْوِهِ الدُّنيا فكانَ نَصيبُهُ","نَصَبَ العِبادةِ لا نِصابَ العَسْجَدِ",53,"د",1,0],["لم تَغْن في الأَسْفارِ عنها","إِنَّها زَادُ المُسافِرْ",54,"ر",1,0],["لم تغن عني عدتي","منها العذاب ولا عديدي",55,"د",2,0],["لم تغن عدلك عن شورى هداتهم","هذي التجاريب والإيثار والدأب",56,"ب",1,0],["لم تغل حين الشتاء منه","بالبر في بيته القدور",57,"ر",1,0],["لم تغلط الأيام في تسويده","لكن بحق ساد واستحقاقِ",58,"ق",1,0],["لَم تغن انصله عنه وَمنصله","وَلا الوقاية بالاتراس وَالدرق",59,"ق",1,0],["