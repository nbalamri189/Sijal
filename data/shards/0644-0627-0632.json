ps://www.aldiwan.net/poem36199.html","الخفيف"],[52,"يا رب أبق ولي دولة هاشم","https://www.aldiwan.net/poem26574.html","الكامل"],[67,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[75,"يا خير ملتحف بالمجد والكرم","https://www.aldiwan.net/poem69038.html","البسيط"],[48,"يا قمرا أبرزه مأتم","https://www.aldiwan.net/poem10787.html","السريع"],[48,"وعظتك واعظة القتير","https://www.aldiwan.net/poem63373.html","مجزوء الكامل"],[48,"يا معرضا نفسي الفداء","https://www.aldiwan.net/poem64363.html","مجزوء الكامل"],[48,"ألا كل بصري يرى أنما العلى","https://www.aldiwan.net/poem66154.html","الطويل"],[48,"لا والتفات الظباء بالمقل","https://www.aldiwan.net/poem66275.html","المنسرح"],[19,"عيني لا بد من سكب وتهمال","https://www.aldiwan.net/poem360.html",""],[19,"أبا دليجة من لحي مفرد","https://www.aldiwan.net/poem361.html",""],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20248","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42605","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42505","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42562","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42694","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42653","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42493","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54511","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55134","الكامل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43859","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54280","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54248","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54240","البسيط"],[77,"ذكروا العهود فهاج من أشجاني","https://www.poetsgate.com/ViewPoem.aspx?id=34168",""],[77,"عجبا لوجد لا يلين شديده","https://www.poetsgate.com/ViewPoem.aspx?id=33817",""],[84,"أما الرياح بجو عاصم","https://www.poetsgate.com/ViewPoem.aspx?id=26356",""],[45,"يا ابنَ حَمْدُونَ بنِ إسْماعيل","https://www.poetsgate.com/ViewPoem.aspx?id=31612",""],[51,"الحمدُ لله الذي","https://www.poetsgate.com/ViewPoem.aspx?id=30425",""],[51,"يا رُبَّ لهفانَ على صنيعَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=29481",""],[24,"أمن نوارَ عرفتَ المنزلَ الخلقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10874&r=&rc=15",""]],"verses":[["لا زِمٌ شُرعَةَ الوَفاءِ يَرى حِف","ظَ التَصافي ديناً مِنَ الأَديانِ",0,"ن",1,0],["لا زِلتَ تَلبَسُ كُلَّ عا","مٍ واعِدٍ بِبُلوغِ عامِ",1,"م",1,0],["لا زَعزَعَتكَ الخُطوبُ يا جَبَلُ","وَبِالعِدا حَلَّ لا بِكَ العِلَلُ",2,"ل",1,1],["لا زِلتَ تَجنُبُ مِن سُيوفِكَ في العِدى","نَحراً يَخُبُّ وَراءَهُ التَشريقُ",3,"ق",1,0],["لا زالَ زائِرُ قَبرِهِ في عَبرَةٍ","تَنعى البَقاءَ إِلَيهِ وَاِستِعبارِ",4,"ر",1,0],["لا زِلتَ تَملِكُ وَالأَحداثُ راغمَةٌ","عِناقَ غُصنِ الأَماني غَيرِ مَخضودِ",5,"د",1,0],["لا زالَ مُرتَجِزُ الرعودِ مُجَلجِلٌ","هَزِجُ البَوارِقِ مُجلِبُ الضَوضاءِ",6,"ا",2,0],["لازالَ تَنطُفُ فَوقَهُ قِطَعُ الحَيا","بِمُجَلجِلٍ يَدَعُ الصُخورَ رَواءَ",7,"ا",2,0],["لا زالَ تُرْضِعُهُ أفاوِيقَ الحَيا","وَطْفاءُ يُنْتِجُها الصَّبا لِتَمامِ",8,"م",1,0],["لا زالَ شَمْلُ المَعالي منكَ مُنتَظِماً","ودامَ صَرْفُ اللّيالي عنْكَ في شُغُلِ",9,"ل",1,0],["لا زِلْتَ تُلْقِحُ آمالاً وتُنْتِجُها","مَواهِبٌ يَمْتَريها كُلُّ مَحْروبِ",10,"ب",1,0],["لا زالَ مُرتَجِزُ الغَمامِ برَبْعِها","غَدَقاً وخَفّاقُ النّسيمِ سَقيما",11,"م",2,0],["لا زال يَنْضَحُ قبْرَهُ دَمُ قارِحٍ","يَحْبو لدَيْهِ وديمَةٌ وَطْفاءُ",12,"ا",2,0],["لا زالَ مَمدودَ الرِّواقِ علَيكُما","ظِلٌّ يَقيلُ العِزُّ فيهِ صَفيقُ",13,"ق",1,0],["لا زِلْتُما مُتَوَشِّحَيْنِ بِدَوْلَةٍ","مُرْخًى ذَوائِبها عَلى النَّعماءِ",14,"ا",2,0],["لازلْتَ تخْتالُ للنّعْماءِ في حُلَلٍ","عليْك اللهُ يُبْديها ويُخْفِيها",15,"ي",3,0],["لازالَ صُنْعُ اللهِ مجْنوباً الى","مثْواكَ يُهْدي البِشْرَ والتّأنِيسا",16,"س",2,0],["لازِلْتَ للدّينِ عِزّاً","مؤمّناً كلَّ خِيفَةْ",17,"ف",2,0],["لاَزَالَ شَمْلُ الْمَعَانِي فيَّ مُجْتَمِعاً","وَالنَّصْرُ وَالْفَتْحُ فِي مَغْنَاي إِلْفَيْنِ",18,"ن",1,0],["لاَ زِلْتَ تُبْدِي وَجْهَ كُلِّ غَرِيبَةٍ","يُمْلِي بَدِيعَ حَدِيثِهَا الْمَلَوَانِ",19,"ن",1,0],["لاَزَالَ فِي عِزَّةٍ تَصْفُو مَوَارِدُهَا","مُبَلَّغاً كُلَّ مَا يَرْجُوهُ مِنْ أَمَلِ",20,"ل",1,0],["لاَزِلْتَ نُوراً يُهْتَدى بِضِيائِهِ","مَنْ جَنّهُ لِلرَّوْعِ لَيْلٌ حَالِكُ",21,"ك",1,0],["لازالَتِ العيسُ ترْوي كلَّ شارِدَةٍ","عنْ مُنْتداكَ بمِلْءِ السّمْعِ والبصَرِ",22,"ر",1,0],["لازالَ ذِكْرُكَ في البسيطَةِ دائِماً","سَيُرى على كَتِدِ الزّمانِ حَميدُهُ",23,"د",2,0],["لازالَ سعْيُكَ في الخِلافَةِ ناجِحاً","تَسْتَمْطِرُ الدّنْيا مَهَبَّ رِياحِهِ",24,"ح",2,0],["لازالَ مُلْكُكَ سامِياً في عِزّةٍ","تَسْتَصْحِبُ الإمْساءَ والإصْباحا",25,"ح",2,0],["لازِلْتَ والشّارِبُ منْ خَسَّةٍ","والرّيقُ منْ حامِضِ نارَنْجِ",26,"ج",1,0],["لا زالَ بَدْراً في سَماءِ خِلافَةٍ","ما لاحَ بَدْرٌ في الظّلامِ الدّاجي",27,"ي",1,0],["لا زالَ مَحْروسَ المَثابةِ ما غَدا","بَيْتُ الإلاهِ مَثابَةَ الحُجّاجِ",28,"ج",1,0],["لازَالتِ الريحُ تُزجي كُلَّ ذي لَجَبٍ","غَيثاً إِذا ما وَنَتهُ ديمةٌ دَفَقا",29,"ق",2,0],["لا زالَ تاجُ المُلكِ فَوقَ جَبينِهِ","تَحتَ الهِلالِ يَزينُ ذاكَ المَفرِقا",30,"ق",2,0],["لا زِلتُما فَرعَينِ في دَوحَةٍ","تُظِلُّ مَن رَجّى وَمَن أَمَّلا",31,"ل",2,0],["لا زالَ ربعُكَ لِلوُفودِ مَحَطَّةً","أَبَداً وُجودُكَ كَهفَ كُلِّ مُؤَمّلِ",32,"ل",1,0],["لا زِلتُ مَمدودَ البَقا حَتّى تَرى","عيسى بِعيسى في الوَرى مُستَنصِرا",33,"ر",2,0],["لا زالَ بَدراً طالِعاً نَيِّراً","يَكشِفُ مِن آمالِنا الحِندِسا",34,"س",2,0],["لا زالَ جَدُّكَ بِالأَعداءِ يَصرَعُهُم","إِن كانَ بَينَ جُدودِ الناسِ مُصطَرَعُ",35,"ع",1,0],["لا زِلتَ تَفتَرِشَ السُرورَ حَدائِقاً","فيهِ وَتَلتَحِفُ النَعيمَ ظِلالا",36,"ل",2,0],["لا زِلتَ رافِعَ رايَةٍ","تُضحي السُعودُ لَها جُنود",37,"د",1,0],["لا زال ثبتاً متيناً","إلى قيام الساعه",38,"ع",2,0],["لاَ زَالَ بَيْنُكَ مَا مَرَّتْ بِهِ حِقَبٌ","حَلِيفَ نُجْحٍ وَإقْبَالٍ وَعُمْرَانِ",39,"ن",1,0],["لا زال نصرُك كلَّما استنجدتَهُ","لمهمّ دينك عائداً موصولا",40,"ل",2,0],["لا زلتَ تطلع غُرَّةً","كالشمس في وقت الدلوكُ",41,"ك",1,0],["لا زلتَ مولّى للملوكِ مؤملاً","وحلاك للإسلام مفخر دهرِهِ",42,"ر",2,0],["لا زلت للإسلام ستراً كلما","أمّ الحجيج البيت ذا الأستار",43,"ر",1,0],["لا زلتَ عامُك كلُّه في غبطةٍ","لُقِّيتَ منها نَضْرَةً وسرورا",44,"ر",2,0],["لا زلتَ محروساً بعين كلاءةٍ","ما دام عين الشمس تعشي من نَظَرْ",45,"ر",1,0],["لا زلتَ شمس خلافة أبناؤه","مثل البدور بمرقب العلياءِ",46,"ا",2,0],["لا زلت شمساً في سماء خلافة","وهلالك الأسمى يتم ويكملُ",47,"ل",1,0],["لا زلت يا وطن الإسلام منتصراً","بالجيش يزحف من أبنائك الأمنا",48,"ن",2,0],["لا زلت مشمول الجنا","ب من من الحقيقة بالرعاية",49,"ا",3,0],["لا زِلتِ في غَلَلٍ يَسُرُّكِ ناقِعٍ","وَظِلالِ أَخضَرَ ناعِمِ الأَغصانِ",50,"ن",1,0],["لا زالَ مُلكُكُمُ وَأَنتُم أَهلُهُ","وَالنَصرُ ما خَلَدَ الجِبالُ مُخَلَّدا",51,"د",2,0],["لازالَ يَطرِقُ مَنبِجاً","في كُلِّ غادِيَةٍ تَحِيَّه",52,"ي",2,0],["لازِلتَ مَغدُوَّ الثَرى مَطروقَهُ","بِسَحابَةٍ مَجرورَةِ الأَذيالِ",53,"ل",1,0],["لا زالَ كَعبٌ يَستَهِلُّ دُموعَهُ","لِلهالِكينَ مُجَدَّعاً لا يَسمَعُ",54,"ع",1,1],["لا زلت ذا عمرٍ به لا ترى","إلاَّ صنيعَ الخيرِ محسوبا",55,"ب",2,0],["لا زلْت ذا السِّرَّينِ في ألقابهِ","هذا عطا يخفى وهذا منصب",56,"ب",1,0],["لا زال سارٍ نور بيتهمُ ولا","عدِمَ النزيلُ وسامع أبياته",57,"ت",2,0],["لا زالَ بابك للمغلوب جانبه","وواجد الهمّ باب النصر والفرَج",58,"ج",1,0],["لا زال بين عتيقٍ","من عيده وجديد",59,"د",1,0],["لا زلت ما سارت الرُّكبان ممتدحاً","لعمره وبيوت الشعر تعمير",60,"ر",1,0],["لا زالت في الدهرِ كما تبتغي","وفوق ما تبغي من الدَّهر",61,"ر",1,0],["لا زال ملك صلاح الدين مصرٌّ على","إرث من العمر ماشي العدل بالنور",62,"ر",1,0],["لا زلتَ مقصود الهبات ممتعاً","بالعمرِ تبني المكرمات وتعمر",63,"ر",1,0],["لا زال كالزهرة من بشرِهِ","وبالندى للحرِّ كالمشتري",64,"ي",1,0],["لا زلت في الخضر عيش ذي أملٍ","عداكَ والحاسدون في الباس",65,"س",1,0],["لا زلت دانِي الجود في القدرِ عن","عدوّ وافيه على الأمس",66,"س",1,0],["لا زلتَ تملي وتملأ الحلو من كلمٍ","بذكرهنَّ لسان الذوق لمَّاظ",67,"ظ",1,0],["لا زلت ممتدحاً منِّي بنظمِ فتىً","في المادحين فلا يثنيه معروف",68,"ف",1,0],["لا زلت أنشد قولي فيك من قدمٍ","وأنت بالخلعةِ الزهراء محفوف",69,"ف",1,0],["لا زالَ حظُّك من دنيا وآخرةٍ","ميسراً وحظوظ الناس تعترك",70,"ك",1,0],["لا زال مثلي كلّ شاكر نعمةٍ","يدعو بطول بقاك أو يدعوكا",71,"ك",2,0],["لا زلت مقصود الحمى بقصائدٍ","أصبحت عصمة أمرها وثمالها",72,"ل",3,0],["لا زالَ بابك مخدوماً بأربعةٍ","يمنٍ ونجحٍ ومختارٍ وإقبال",73,"ل",1,0],["لا زلت كالنجم تنويراً لداجية","زيناً لمطّلعٍ رشداً لضلاَّل",74,"ل",1,0],["لا زلت ذا فضلٍ يطلّ على الورَى","وعلى الكواكب من عليّ ومن علُ",75,"ل",1,0],["لا زال قلبيَ رافضيّ تصبُّرٍ","أسفاً عليك ومدمعي متوالي",76,"ل",2,0],["لا زلت ذا ذكرٍ كثير السُّرى","بكلّ أرض وندى لا يريم",77,"م",1,0],["لا زلت ملثوم الثرى شائداً","أركان جدٍ غير مثلوم",78,"م",1,0],["لا زالَ مهدِي اليتيم من درر ال","مدح يراكم ثمال أيتامه",79,"م",2,0],["لا زلت بالحال أهنا ما أكون به","وقبلها كنت للأحوال أنعى ما",80,"م",2,0],["لا زال مثل السرج في نصره","وسعده في فم باغٍ لجام",81,"م",1,0],["لا زالَ بابك ظله فوق الرجا","ونزيله التأييد والتمكين",82,"ن",1,0],["لا زلت يا كعبة المعروف تمنحني","من كسوةٍ لي بها في المدح أركان",83,"ن",1,0],["لا زال مدحك كلّ شهر روضة","يعزى لمصرَ وكلّ شيءٍ منتهى",84,"ه",2,0],["لا زلتَ مسموع الثنا ذا مننِ","جائِلة دائرة في الألسن",85,"ن",1,0],["لا زلت تنسخ نيروزاً مُعوَّلُهُ","على الذي فيك من صفحٍ وإغضاءِ",86,"ا",2,0],["لا زلت شَفْعَ الراح إنكما","سَكَنُ القلوبِ ومُنتهى الطلبِ",87,"ب",1,0],["لا زالَ يَقْدَحُ وَرْيُهُ","في صدره أبداً قُحابَهْ",88,"ب",2,0],["لا زلتَ مَنْ لا سَيْفُهُ ناكلٌ","قِدْماً ومن لا بحرُه ناضبُ",89,"ب",1,0],["لا زال من والى الإمام وَوُدَّهُ","يحيا ومن عاداه يلقى معطبا",90,"ب",2,0],["لا زلتُمُ من كل عيشٍ صالحٍ","أبداً بحيث دِماثُهُ وفِسَاحُه",91,"ح",2,0],["لا زال شمْلَ اجْتِمَاعٍ شَمْلُ أمرِكما","وشمْلُ أمْر الأعادِي شَمْلَ تَبْدِيدِ",92,"د",1,0],["لا زلتَ أبيضَ غُرَّةٍ وأَيادِ",