{"poems":[[55,"أيا مظهر الهجران والمضمر الحبا","https://www.aldiwan.net/poem26545.html","الطويل"],[45,"أيا مظهر الهجران والمضمر الحبا","https://www.aldiwan.net/poem11436.html","الطويل"],[69,"أتهزأ بي لما أجد وتلعب","https://www.aldiwan.net/poem28601.html","الطويل"],[105,"أرى الناس في مصر شتى القلوب","https://www.aldiwan.net/poem43129.html","المتقارب"],[46,"إذا كف صل أفعوان فما له","https://www.aldiwan.net/poem22114.html","الطويل"],[121,"ليالي سلمى ترتقي لي وتراقيا","https://www.aldiwan.net/poem23827.html","الطويل"],[160,"مكانك في الحشا مني مكين","https://www.aldiwan.net/poem59022.html","الوافر"],[169,"يا ساهر الطرف من خوف ومن وجل","https://www.aldiwan.net/poem1652.html",""],[169,"إلى كم مداراة العدى واحترامها","https://www.aldiwan.net/poem1663.html",""],[185,"عسى يبلى العذول ببعض ما بي","https://www.aldiwan.net/poem14126.html","الوافر"],[297,"دعاه على سهل الغرام وصعبه","https://www.aldiwan.net/poem33016.html","الطويل"],[297,"أشمس سناها في الدجنة بازغ","https://www.aldiwan.net/poem33222.html","الطويل"],[353,"دعوني بين ندمان وساقي","https://www.aldiwan.net/poem40026.html","الوافر"],[458,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[458,"قفا نضويكما بالغمر نسأل","https://www.aldiwan.net/poem56264.html","الوافر"],[495,"سل الملك الكريم إلام تبني","https://www.aldiwan.net/poem9760.html","الوافر"],[515,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[558,"تجلت لنا ذات وفعل بدا واسم","https://www.aldiwan.net/poem34074.html","الطويل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["وَلَو ذُقتِ ما أَلقى وَخامَرَكِ الأَذى","لَسَرَّكِ أَن أَهدا وَأَن لا أَرى كَربا",0,"ب",2,0],["وَلَو ذُقتَ ما أَلقى وَلَو مَسَّكَ الهَوى","لَسَرَّكَ أَن أَهدى وَلَم تَرَبي كَربا",1,"ب",2,0],["ولو ذقتُم طيبَ القناعةِ مُتَّمُ","عليها ولكنْ بدرُها يُتهيَّبُ",2,"ب",1,0],["وَلوذوا بِرُكنٍ شَديدِ القُوى","مِنَ الصَبرِ عِندَ اِشتِدادِ الكُرَبْ",3,"ب",1,0],["وَلَو ذَهَبَت عَينا هِزَبرٍ مُساوِرٍ","لَما راعَ ضَأناً في المَراتِعِ أَو سِربا",4,"ب",2,0],["ولو ذُقْتُ فاها قلت هذا معتق","عتيق من التجار للنفس سابيا",5,"ي",2,0],["ولوذوا بالخضوع فقد أظلت","رماح لا يبل لها طعين",6,"ن",1,0],["وَلَو ذَكَرتُ مُلوكاً مِن أُبُوَّتِكُم","مَضَوا تَرَكتُ مُلوكَ الأَرضِ في خَجَلِ",7,"ل",1,0],["ولَوذوا بِبيضِ المَشرَفِيَّةِ إِنَّها","لَها عِزَّةٌ قَعساءُ وافٍ ذِمامُها",8,"م",3,0],["ولو ذهبتْ لنِلْتُ أجَلَّ منها","لكَوْني تحتَ ظِلِّ أبى تُراب",9,"ب",1,0],["وَلَو ذُقتُما ما ذاقَ من لاعج الهوى","لأَيقنتُما أَنَّ العذابَ بعَذبِهِ",10,"ب",2,0],["وَلَو ذاقَ طعم الحبِّ من لامَ لم يكن","ليمضَغَ أَعراضَ المحبّين ماضِغُ",11,"غ",1,0],["وَلوذوا بِالصَبابة وَالتَصابي","عَلى وفق الخَلاعة باِتِّفاقِ",12,"ق",1,0],["ولو ذهبتْ وراءَ الشمس غربا","شفتْ أكبادَها من كلِّ ضِغْنِ",13,"ن",1,0],["ولُوذَاً مُسنَدَيْن بجنب طَودٍ","من المعروف علاي الهضبِ عاتي",14,"ي",1,0],["ولو ذوبتني ما كنت إلا","ولاءً أو دعاءً أو ثناء",15,"ا",2,0],["ولو ذهب المحاق به عرفنا","برؤيتك الحلال من الحرام",16,"م",1,0],["ولو ذكروا حول الحطيم صفاتها","لزال عن البيت العتيق بها الحطم",17,"م",1,0],["ولو ذهبت أن أعدّ ما له","في الفضل أو أحكي لكم أفعاله",18,"ه",1,0]]}