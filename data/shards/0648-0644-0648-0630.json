{"poems":[[57,"أيا مظهر الهجران والمضمر الحبا","https://www.aldiwan.net/poem26545.html","الطويل"],[47,"أيا مظهر الهجران والمضمر الحبا","https://www.aldiwan.net/poem11436.html","الطويل"],[71,"أتهزأ بي لما أجد وتلعب","https://www.aldiwan.net/poem28601.html","الطويل"],[107,"أرى الناس في مصر شتى القلوب","https://www.aldiwan.net/poem43129.html","المتقارب"],[48,"إذا كف صل أفعوان فما له","https://www.aldiwan.net/poem22114.html","الطويل"],[125,"ليالي سلمى ترتقي لي وتراقيا","https://www.aldiwan.net/poem23827.html","الطويل"],[164,"مكانك في الحشا مني مكين","https://www.aldiwan.net/poem59022.html","الوافر"],[173,"يا ساهر الطرف من خوف ومن وجل","https://www.aldiwan.net/poem1652.html",""],[173,"إلى كم مداراة العدى واحترامها","https://www.aldiwan.net/poem1663.html",""],[189,"عسى يبلى العذول ببعض ما بي","https://www.aldiwan.net/poem14126.html","الوافر"],[302,"دعاه على سهل الغرام وصعبه","https://www.aldiwan.net/poem33016.html","الطويل"],[302,"أشمس سناها في الدجنة بازغ","https://www.aldiwan.net/poem33222.html","الطويل"],[358,"دعوني بين ندمان وساقي","https://www.aldiwan.net/poem40026.html","الوافر"],[463,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[463,"قفا نضويكما بالغمر نسأل","https://www.aldiwan.net/poem56264.html","الوافر"],[500,"سل الملك الكريم إلام تبني","https://www.aldiwan.net/poem9760.html","الوافر"],[520,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[563,"تجلت لنا ذات وفعل بدا واسم","https://www.aldiwan.net/poem34074.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122623","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48896","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48808","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48834","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63858","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37986","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70846","الطويل"],[966,"","https://poetry.dctabudhabi.ae/diwan/poem/146418","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59425","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72296","البسيط"],[2327,"","https://poetry.dctabudhabi.ae/diwan/poem/123662","الطويل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101719","الوافر"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105404","الطويل"],[2630,"","https://poetry.dctabudhabi.ae/diwan/poem/107320","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204590","الطويل"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117033","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62740","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91247","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91220","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216815","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111462","المتقارب"],[4852,"رجل إهداء","https://www.poetsgate.com/ViewPoem.aspx?id=214441",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5431,"على لوحٍ بنور الله يُسقى...","https://www.poetsgate.com/ViewPoem.aspx?id=200032",""],[5739,"فرحة بخيل ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131229",""],[5939,"أفيقي!","https://www.poetsgate.com/ViewPoem.aspx?id=180000",""],[5953,"سئمت المقام بنادي حلب","https://www.poetsgate.com/ViewPoem.aspx?id=93858",""],[5309,"قضيت العمر في سكر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573569",""]],"verses":[["وَلَو ذُقتِ ما أَلقى وَخامَرَكِ الأَذى","لَسَرَّكِ أَن أَهدا وَأَن لا أَرى كَربا",0,"ب",2,0],["وَلَو ذُقتَ ما أَلقى وَلَو مَسَّكَ الهَوى","لَسَرَّكَ أَن أَهدى وَلَم تَرَبي كَربا",1,"ب",2,0],["ولو ذقتُم طيبَ القناعةِ مُتَّمُ","عليها ولكنْ بدرُها يُتهيَّبُ",2,"ب",1,0],["وَلوذوا بِرُكنٍ شَديدِ القُوى","مِنَ الصَبرِ عِندَ اِشتِدادِ الكُرَبْ",3,"ب",1,0],["وَلَو ذَهَبَت عَينا هِزَبرٍ مُساوِرٍ","لَما راعَ ضَأناً في المَراتِعِ أَو سِربا",4,"ب",2,0],["ولو ذُقْتُ فاها قلت هذا معتق","عتيق من التجار للنفس سابيا",5,"ي",2,0],["ولوذوا بالخضوع فقد أظلت","رماح لا يبل لها طعين",6,"ن",1,0],["وَلَو ذَكَرتُ مُلوكاً مِن أُبُوَّتِكُم","مَضَوا تَرَكتُ مُلوكَ الأَرضِ في خَجَلِ",7,"ل",1,0],["ولَوذوا بِبيضِ المَشرَفِيَّةِ إِنَّها","لَها عِزَّةٌ قَعساءُ وافٍ ذِمامُها",8,"م",3,0],["ولو ذهبتْ لنِلْتُ أجَلَّ منها","لكَوْني تحتَ ظِلِّ أبى تُراب",9,"ب",1,0],["وَلَو ذُقتُما ما ذاقَ من لاعج الهوى","لأَيقنتُما أَنَّ العذابَ بعَذبِهِ",10,"ب",2,0],["وَلَو ذاقَ طعم الحبِّ من لامَ لم يكن","ليمضَغَ أَعراضَ المحبّين ماضِغُ",11,"غ",1,0],["وَلوذوا بِالصَبابة وَالتَصابي","عَلى وفق الخَلاعة باِتِّفاقِ",12,"ق",1,0],["ولو ذهبتْ وراءَ الشمس غربا","شفتْ أكبادَها من كلِّ ضِغْنِ",13,"ن",1,0],["ولُوذَاً مُسنَدَيْن بجنب طَودٍ","من المعروف علاي الهضبِ عاتي",14,"ت",2,0],["ولو ذوبتني ما كنت إلا","ولاءً أو دعاءً أو ثناء",15,"ا",2,0],["ولو ذهب المحاق به عرفنا","برؤيتك الحلال من الحرام",16,"م",1,0],["ولو ذكروا حول الحطيم صفاتها","لزال عن البيت العتيق بها الحطم",17,"م",1,0],["ولو ذهبت أن أعدّ ما له","في الفضل أو أحكي لكم أفعاله",18,"ه",1,0],["ولو ذَهبا بِعُمرِ العَودِ هانا","على الباكينَ أو عُمرِ الحُوار",19,"ر",1,0],["ولو ذاق في دنياه ما ذقت شاعر","سواك لما أملى كتاباً ولا أمضى",20,"ض",2,0],["ولو ذكر المحروم ما أنت زارع","لما فاته بعض الذي أنت حاصد",21,"د",1,0],["ولو ذهبوا بالرفق في الأرض أصبحتْ","تمدُّ لهم أطرافَها وتزيد",22,"د",1,0],["ولوذا بالقناعةِ إِنَّ فيها","بماءِ وجوهِنا حِرْزاً حريزا",23,"ز",2,0],["وَلَو ذُكِرَت أَهلُ المَفاخِرِ وَالعُلى","عَلى مَنهَجِ التّفضيلِ فَهوَ خَطيرُها",24,"ر",3,0],["ولو ذو سقامٍ ذاقها في سقامةٍ","لعاينتَه يسْعَى بجسم صحيح",25,"ح",1,0],["ولو ذرعوها بالذراع لما انتهت","فما تنقضي يا ليل أو ينقضي نحبي",26,"ي",1,0],["ولوذي بطلق الوجه بالخير مرسل","وبالخير أمار واللخير صانع",27,"ع",1,0],["ولو ذنوبي ملء الأرض قاطبة","تجاوز اللّه عنها لي به وعفا",28,"ف",2,0],["ولو ذابها ثم انشقا طيب عرفها","وقصا حديثاً للأسيف المعلل",29,"ل",1,0],["ولو ذاق الهوى بقراط يوما","لضلّ بطبه عنه السبيل",30,"ل",1,0],["ولو ذقت منه بعض ما ذقته لما","عذلت وأيقنت الملامة مأثما",31,"م",2,0],["وَلَو ذُقتَ رَشفاً من لَذِيذِ رُضابِها","لأصبَحتَ نَشوَاناً طَريحاً مُعَربِدا",32,"د",2,0],["ولو ذاقه الأعشى وحُكِّم في الطلا","وفيه لقال الفضل للمتأخر",33,"ر",1,0],["ولو ذاقها يوما عبوس مقطب","لكان ببشر وجهه يتهلل",34,"ل",1,0],["ولو ذاقَ المَذلّةَ من نَميرٍ","أصابَ بني عُقيلٍ بالتّجَنّي",35,"ن",2,0],["وَلو ذاق طَعم الذوق في الحُب لَم يَمل","إِلى سَلب إِيجابٍ وَإِيجابِ سالب",36,"ب",1,0],["وَلو ذاقَ الهَوى وَهوى وَلاقى","كما أَلقى وَكَم يَنأى مبيدي",37,"د",2,0],["ولوذي بأيك يفئ الهوى","إلى ظله ويميل النظر",38,"ر",1,0],["ولَوذَميَةَ المُجتَباةَ وَمَن","بِها هامَ زَفسُ شَجاً وَاقتَرَن",39,"ن",1,0],["ولَو ذَميَةٌ أَرطَمِيسُ قَلَتها","وَلضم تَعدُ مِن بَعدُ أَن جَندَلَتها",39,"ه",2,0],["ولو ..ذَكَرْتُ مِن القرآنِ قد \"وَسعَتْ\"","هل بعد ذلك للأوصافِ مِن سَعَةِ !؟",40,"ه",1,0],["ولو ذو الرشا اعتاض الرشاء ات","تقى لظى فما للهي تجدي العذاب لهاء",41,"ا",2,0],["ولو ذاقت شفاه الدهر شعري","لما عرفت سوى الأشعار نطقا",42,"ق",2,0],["ولو ذهب صمتي .. على شفة ردي.","هآبه الصنديد من شر ٍ يخيل.",43,"ل",1,0],["ولُوذِي من اليأسِ في دِفءِ حِضني","فقلبُكَ ثَمَّ اهتدى مُستَقَرَّهْ",44,"ر",2,0],["ولوذوا بها إخوتي كلكم","فكل مقيم بها مكتسب",45,"ب",1,0],["وَلَو ذاقوا الَّذي عاناهُ","لَم يَرموهُ بِالنُّكرِ",46,"ر",1,0]]}