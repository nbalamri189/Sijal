{"poems":[[79,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138600",""],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136378",""],[5561,"هو خيرةٌ من خيرةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193807",""],[5869,"اعذب الألفاظ","https://www.poetsgate.com/ViewPoem.aspx?id=57075",""]],"verses":[["اللّهُ تُخَيّرَ يُوسُفَ منْ","غُرَرِ الأمْلاكِ هُدىً وتُقَى",0,"ق",2,0],["الله تهجم خيل القوم ضابحةً","على حريمٍ عليها الروح لن يلجا",1,"ج",2,0],["الله تعالى له المحامد طرا","برٌّ ورؤوف على العباد ورحمان",2,"ن",1,0],["اللهَ تعبدُ مؤمناً متيقنا","أن لا إلهَ سواهُ رباً باريا",3,"ي",2,0],["اللهُ تَهْتَزُّ أَرْوَاحٌ لَهَيْبَتِهَا","وَتَرْتَقِي وهْي جَذْلىَ فِي مَرَاقِيهَا",4,"ي",3,0],["اللهُ تَبْتَسِمُ الآمَالُ يُشْرِقُ فِي","أَرْوَاحِنَا النُّورُ إِنْ نَادَى مُنَادِيهَا",4,"ي",3,0],["اللهُ تَسْمُو نُفُوسُ الهَائِمِينَ بِهَا","وَيَنْتَشِي كُلُّ صَبٍّ عِنْدَ حَادِيهَا",4,"ي",3,0]]}