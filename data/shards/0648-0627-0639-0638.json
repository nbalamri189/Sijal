ما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5064,"زيدِي اغترَابِي","https://www.poetsgate.com/ViewPoem.aspx?id=199107",""],[3749,"رفاهية الشهم اقتحام العظائم","https://www.poetsgate.com/ViewPoem.aspx?id=134962",""],[5183,"وادي الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=180171",""],[5277,"هجاءُ البدر","https://www.poetsgate.com/ViewPoem.aspx?id=192282",""],[592,"أقول لعمري ما لهذا حقيقةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=128718",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5465,"إن الحمامةَ يوم الشعب من حضن","https://www.poetsgate.com/ViewPoem.aspx?id=98439",""],[5587,"- جَدُّ الحُسَينِ","https://www.poetsgate.com/ViewPoem.aspx?id=196781",""],[5659,"بهجر الحبيب تكون الكروب","https://www.poetsgate.com/ViewPoem.aspx?id=200458",""],[5809,"أسف","https://www.poetsgate.com/ViewPoem.aspx?id=205397",""],[5956,"بطولة الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=192291",""],[6031,"مَعَاهِدُهُمْ بالأبْرقَيْنِ هَوَامِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=46280",""],[6100,"سلهمة طفوله","https://www.poetsgate.com/ViewPoem.aspx?id=52596",""],[6102,"صراحة مفرطة ...","https://www.poetsgate.com/ViewPoem.aspx?id=184430",""],[6142,"كم البيض بالأغماد حرى شفارها","https://www.poetsgate.com/ViewPoem.aspx?id=155749",""],[119,"إلهي مسني كرب عظيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55614&r=&rc=11",""],[6259,"لنفسكِ لم لا عذر قد نفدَ العذرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59410&r=&rc=58",""]],"verses":[["وَأَعظَمُ ما أَلفَيتُ شَجواً وَلَوعَةً","عِتابُ أَخٍ فَلَّ الزَمانُ بِهِ حَدّي",0,"د",2,0],["وَأَعظَمُ ما أُلاقي أَنَّ دَهري","يَعُدُّ مَحاسِني لي مِن ذُنوبِ",1,"ب",1,0],["وَأَعظَمُ مِن عُبابِ البَحرِ حِرصٌ","عَلى الأَرزاقِ أَركَبَنا العُبابا",2,"ب",2,0],["وَأَعْظِمْ بِهِ مِنْ عَازِمٍ حَازِمٍ","ثَبَتٍ عَلَى الأَحْدَاثِ مَاضٍ هُمَامْ",3,"م",1,0],["وَأَعظَمُ ما رُميتُ به فَجُوعاً","كتابٌ جاءَ مِن فَجٍ عَميقِ",4,"ق",1,0],["وأعظم تخليداً لذكراك منهم","فعائلك الغرّاء والخلق الأسنى",5,"ن",2,0],["وَأَعظَمُ ماكانَت هُمومُكَ تَنجَلي","وَأَصعَبُ ماكانَ الزَمانُ يَهونُ",6,"ن",1,0],["وَأَعظَمُ أَعداءِ الرِجالِ ثِقاتُها","وَأَهوَنُ مَن عادَيتَهُ مَن تُحارِبِ",7,"ب",1,0],["وأعظمهمْ ذمّاً لها وأشدُّهم","بها شعفاً قوم طوالُ القلانِسِ",8,"س",1,0],["وَأَعظَمَ حُزني أَنَّ خَطبَكِ بَعدَهُ","مَصائِبُ شَتّى لَم تَقَع وَخُطوبُ",9,"ب",1,0],["وأعظمُ ما بِي أنّني بفضائلي","حُرِمْتُ وما لي غيرَهُنَّ ذَرائِعُ",10,"ع",1,0],["وَأَعظَمُ مِمّا خَصَّني مِن أَذاتِهِ","عَلَيَّ بِقَولٍ صادِقٍ غَيرَ كاذِبِ",11,"ب",1,0],["وَأَعظَمُ خُطَّةٍ وَمُبينُ غَبنٍ","سُموطُ الدُرِّ تُهدى بِالزُجاجِ",12,"ج",1,0],["وَأَعظَمتَ ما أَعظَمَتهُ اليَهو","دُ تُصَلّي لِقِبلَتِهِم أَو تَحُج",13,"ج",1,0],["وَأَعظَمُ غُنيَةً في كُلِّ يَومٍ","وَأَصدَقُ عِندَ مُختَلِفِ القِتالِ",14,"ل",1,0],["وَأَعظَمُ الإِثمِ بَعدَ الشِركِ نَعلَمُهُ","في كُلِّ نَفسٍ عَماها عَن مَساويها",15,"ي",3,0],["وَأَعظَمُ آثارِ الأَنامِ بَقيَّةً","تُغَيّرُهُ أَيّامُهُ بِطُموسِ",16,"س",1,0],["وأعْظَمُ حادثٍ فَرَسٌ كَريمٌ","يكُونُ مَلِيكُهُ رجُلاً شَحيحا",17,"ح",2,0],["وَأَعظَمَ أَقدَماً وأَصغَرَ أَسؤُقاً","وَأَعظَمَ أَفواهاً وَأَرحَبَ مِنخَرا",18,"ر",2,0],["وَأَعظَمَ بَطناً تَحتَ دِرعٍ تَخَالُهُ","إذَا حُشِيَ التَبِّيَّ زِقّتاً مُقَيَّرا",18,"ر",2,0],["وأعظم بخطب فيه للمجد شقوة","وَفي جسد العلياء منه نحول",19,"ل",1,0],["وأعْظَمَ جُمْهُوراً مِنَ الخَيْلِ خَلْفَهُ","جَمَاهِيرُ يَحْمِلْنَ الوَشيجَ المُقَصَّدَا",20,"د",2,0],["وَأَعْظَمُ مَا تَرْجُوهُ مَا لا تَنَالُهُ","وَأَكْثَرُ مَنْ تَلْقَاهُ مَنْ لا يُوَافِقُ",21,"ق",1,0],["وَأَعْظَمَ نَفْسَ الفَتَاةِ وَبَأْ","ساً بِهَا فِي الصَّنَادِيدِ لَمْ يَعْهَدِ",22,"د",1,0],["وَأَعظَمُ مِن ذاكَ قَتلُ الوصِيِّ","وَذَبحُ الحُسَينُ وَسَمُّ الحَسَن",23,"ن",1,0],["وأعْظَمُ أَخْلاقِ الفَتَى هِمَّةُ الفَتَى","وعَزْمٌ حَدِيدُ النَّصل لا يَتَزَعْزَع",24,"ع",1,0],["وأعظمُ ما جرّ خطب الزمان","ملائكةٌ تُبلى بالبشر",25,"ر",1,0],["وأعظم خبر من بيننا دايم يشاع","أبو بكر..أرث أصيل أبو بكر\"!",26,"ر",1,0],["واعظمه الصديق في كل محفل","وكان له عن رأفة مثل والد",27,"د",1,0],["واعظمقوة للمرء حيا","وميتا ان تساعده القلوب",28,"ب",1,1],["وَأَعظَمَ أَهلُ مِصرٍ ما رَأَوهُ","فَصارَ حَديثُهُ لِلقَومِ شُغلا",29,"ل",2,0],["واعظٌ بالحال ما أنصحه","فتأملهُ تعاين عِبَرَا",30,"ر",2,0],["وأعظم من هذا وذلك كلِّه","عذابُ لظىً ما لامرىءٍ فيه من الصبر",31,"ر",1,0],["وأعظمِهم ملكا وأكبر همةً","وأصْلبهم عودا وأَلْيَنهم عِطْفا",32,"ف",2,0],["وأعظم ما بي من هواها افتراقنا","وكتمانُنا للحبّ والشمل جامع",33,"ع",1,0],["وأعظمُ منهما خطرا وضُرّا","مجالسةُ الثقيل وصوم آب",34,"ب",1,0],["وأعظمُ كظم الغيظ حرّ مكاتم","هوى في الحشا بين الجوانح والحجب",35,"ب",1,0],["وَأعظِم بِها ناراً بِها قَد تقطّعت","سَلاسِلهُ مِن بعدِ تَقييدهِ دَهرا",36,"ر",2,0],["وَأعظمُ كلِّ المُؤمنين هدايةً","أَشدّهمُ حبّاً له وبهِ بِرّا",36,"ر",2,0],["وَأَعظمُ كلّ الكافرين ضلالةً","أَشدّهمُ بُغضاً له وبهِ كُفرا",36,"ر",2,0],["وَأَعظَمُها دينُ النبيّ محمّدٍ","هوَ النِعمةُ العُظمى هو المنّةُ الكُبرى",37,"ر",2,0],["وَأَعظمُها شَرّاً مدارسُ في القرى","وَفي البدوِ والأمصارِ قد نُشِرت نشرا",37,"ر",2,0],["وأعظمُ شاهدي منها عليها","بأنَّ جمالَها للعينِ باد",38,"د",1,0],["وأَعظمُ سؤلي أَن أراك وصلتَه","وأَغنَيْتَه بالجُود قبل التكلُّم",39,"م",1,0],["وأَعظُم الُّرزْءِ عِندي أَن أُصاب بما","ينأَى بِه عنِّيَ الخُلاّن والخلل",40,"ل",1,0],["وَأَعْظِمْ بِذَاتِ الْعَبِيرْ","صَلاَةِ الْقَدِيرِ الْمُرِيدْ",41,"د",1,0],["وأعظم ما تمنى به شيمة الفتى","وضيع بألقاب الأمير يلقب",42,"ب",1,0],["وأَعظَمُ مَا تُشاهِدُهُ مَنَاباً","إذا ما قامَ بالنُّوَبِ العِظَامِ",43,"م",1,0],["وَأَعظَمُ ما أَلقاهُ أَنّيَ لَم أَجِد","لِقَلبي سلوّاً عَنكُمُ بِسِواكُمُ",44,"م",1,0],["وَأَعظَمُ الوجدِ دَمع غَيرُ مُمتَنِعٍ","عَلى المُحِبِّ وَصَبرٌ قُفلُهُ أَشِبُ",45,"ب",1,0],["وأَعظمُهم لدى البأساء يُسراً","وأَسمحُهم إذا ما جاد يُمنى",46,"ن",2,0],["وأعظمُ ما لاقيتُ في الحب أنني","إذا ما التقينا لا أطيق كلاما",47,"م",2,1],["وَأَعظمَ اللّه أجرَ العالمين فَقد","دَهاهمُ فيك رزءٌ غير محسورِ",48,"ر",1,0],["وَأَعظَمُهم قدراً وَأَفخَمهم ثنا","وَأَطهرهم عرضاً وَأَزكاهم نسبا",49,"ب",2,0],["وَأَعظُمُها مُبَتَّلَةٌ رِواءٌ","وَذو عُكَنٍ وَإِن طَعِمَت خَضيدُ",50,"د",1,0],["وأعظَمُ ممّا نِلْتَ ما ستنالُه","من العزِّ إنّ الألْفَ يَبدأُ من فَرْد",51,"د",1,0],["وأعظَمُ مِمّا نِلْتَ ما ستَنالُه","فَمبْدأُ ألفٍ حين يُحسَبُ من فَرد",52,"د",1,0],["وَأَعظَمُ حَسرَةٍ أَنّي بِدائي","أَموتُ وَفي فُؤادي مِنهُ حَسرَه",53,"ر",2,0],["وأعظمُ مَفقودٍ عَلى العاشِق الكَرى","إِذا لَم يَكُن إِلا الكَرى يَجمع الشَّملا",54,"ل",2,0],["وأعظمها وأجزل","فربك ذو العطيات",55,"ت",1,0],["وأعظمُ منها حُرْمةً دَمُ مسلمٍ","إراقتُه ظُلْمٌ وجُرْمٌ مُؤَصَّلُ",56,"ل",1,0],["وأعظم ما يلقى الفتى من زمانه","فوات كرام عند فرط غرام",57,"م",1,0],["وأعظمها فؤاد طار شوقاً","إلى بلد بها عضدي وزندي",58,"د",2,0],["وأعظَمُ مِن قَطْعِ اليَمينِ على الفَتى","صنيعَةُ برِّ نالَها مِنْ يَدَيْ دَني",59,"ي",1,0],["وَأَعظَمُ ما بي يا مُحَمَّدُ أَنَّنا","بِأَرضٍ وَفيما بَينَنا البُعدُ وَالهَجرُ",60,"ر",1,0],["وأعظمُ جهلٍ جهلُهُم قَدْرَك الَّذي","يُعدُّ ويرجى للأمور العظائم",61,"م",1,0],["واعظٌ إنْ وعظ الناس اهتدت","لسبيل الرشد من بعد العمى",62,"م",2,0],["وأعظِمْ بها دهياء وهي عظيمة","إذا اكتنف الضرغامَ بالذل غابه",63,"ب",2,0],["واعظم ما أراني الدهر جوراً","يعادي عن مقام العارفينا",64,"ن",2,0],["واعظم اجري ان الاقي منيَّتي","فكيف وهذا شان وجدي وصبوتي",65,"ي",1,0],["وأَعْظَمَ فِي الضَّلالَةِ من صليبٍ","وأَعْلَى فِي الكتائِبِ من لِواءِ",66,"ا",2,0],["وأَعْظمُ تأْنيساً لدَهْرِي منَ المُنى","وأَوْحَشُ مِنهُ من فتى الجُبِّ فِي الجُبِّ",67,"ب",1,0],["وأعظم داء بالحبيب إذا ابتلى","وأكثر لاجيه ببين حبيب",68,"ب",1,0],["وأَعظم علة علل الخطايا","ومن يبلى بعلات كواها",69,"ا",3,0],["وأعظمه ما حكاه الأنام","قصائد كالحب لا تذبل",70,"ل",1,0],["واعْظِمِ الوالِدَيْنِ سرًّا وجهراً","منهُما بصُلْحِ الشُؤُنِ الدُّعاءُ",71,"ا",2,0],["وأعظم ما ألاقي منك أني","أدوم على الوفاء ولست تدري",72,"ر",2,0],["وَأَعظَمَهُم بَأساً وَأَمنَعَهُم حِمىً","وَأَصدَقهُم قيلا وَأَحمَدَهُم إسما",73,"م",2,0],["وأعْظَمُ مُسْتَفادٍ مِنْ عِهادٍ","تَواصُلُنا بأَصْنافِ الدُّعاءِ",74,"ا",2,0],["وأعظمُ ما يُلاقيهِ قرينٌ","وأشجى أنْ يفارقه قرينُ",75,"ن",1,0],["وأعظم الكل إرشادي لدين هدىً","طريقة الحق نور الشرع والدين",76,"ن",1,0],["وأعظموا إنكاره على السلف","وحذروه غب ذاك فانصرف",77,"ف",1,0],["وأَعظمُ دائِي أَنَّني لستُ أَشْتَفِي","وأَيْسَرُ صَبْرِي أَنَّني لسْتُ أَشْتكِي",78,"ك",2,0],["وأَعظمُ فَخْرِه أَنَّ جدِّيَ عبدُه","فصارَ إِلى ابن الابْنِ بالرِّق فَخْرهُ",79,"ر",2,0],["وأعظم به يوم الجدال مناظراً","إذا قال لم يترك مقالاً لقائل",80,"ل",1,0],["وأعظم داء الحر في العيش أنه","يرى الأمر لا يرضى فيه فيداري",81,"ر",2,0],["وأعظم ما يرمي القلوب بمحرق","وتهمي له سحب الجفون سحالها",82,"ل",3,0],["وأعظم ما يلقى من الدهر فادحٌ","رمى شمل آل المصطفى بالتفرق",83,"ق",1,0],["وأعظم مفقود من الناس آخذ","عن الأهل نأياً حاله ليس يعرف",84,"ف",1,0],["وأعظم بلوى من تعرض للهوى","معاودةُ الشكوى لمن ليس يسعدُ",85,"د",1,0],["وَأعْظَمُهُ وَأدْهَاهُ لَهِيباً","إذَا مَا هَاجَ شَوْقِي لِلْبَيَانِ",86,"ن",1,0],["وأعظَمُ ما أخشى وأحذر خطبَه","دوامي أسيراً عندَه وبقائِي",87,"ي",1,0],["وأعظمها إذهابُ كل معاندٍ","ومغداه من بعد الترفع بالحسر",88,"ر",1,0],["وَأَعظَمِهم يَوم القِيامِ شَفاعَةٍ","فَأَنتَ شَفيعٌ سيّدي لَم تَنلِ الرَّدّا",89,"د",2,0],["وأعظم شي حملهم فتياتكم","إلى الشام تطوي البيد قذفاً على قذف",90,"ف",1,0],["وأعظمها انفرادي ليس ترضى","مراجعتي ولا يجد رجوعي",91,"ع",2,0],["وأعظم العالمين قدرا","ما بين خاف وبين بادي",92,"د",2,0],["وَأعْظَمُهُمْ فَخْراً وَأوْسَعَهُمْ غِنىً","وَأقْرَبُ مِنْ حِلْمٍ وَأبْعَدُ عِنْ غَدْرِ",93,"ر",1,0],["وأعظم أحلاما واقوى مهابة","وأرعب أعلاما وأرشق أسهما",94,"م",2,0],["وَأَعظَمُها أَنَّ الزَمانَ يَسومُني","وُقوفاً عَلى أَبوابِ مَن هُوَ دوني",95,"ي",1,0],["وأعظم ما ساء من صرفه","وفاة أبي بكر الحنبلي",96,"ل",2,0],["وأعظم أحداث الزمان رزية","بكتها الصخور الصم وهي جلامد",97,"د",1,0],["وَأَعظَمُ من ذا أَنَّ شِعرِيَ مُعرَبٌ","فَصيحٌ وَأنِّي حينَ أَنطِقُ أَعجَمُ",98,"م",1,0],["وأعظم بر بر من سبب الرضا","وأعطى الرضا والقرب بالسببية",99,"ه",1,0],["وأعظم ما يشجي الغيور سفورها","وأعظم منه أن تسب وتسلبا",100,"ب",2,0],["وأعظم بخطب زعزع العرش وانحنى","له الفلك الدوار محدوباً ظهرا",101,"ر",2,0],["وأعظم ما يشجي الغيور دخولها","إلى مجلس ما بارح اللهو والخمرا",101,"ر",2,0],["وَأَعْظَمَ سُلْطَانٍ حَوَى المَجْدَ وَالعُلاَ","وَكَانَ لَهُ فِي دُرَّةِ العِزِّ مُرْتَقَى",102,"ق",2,0],["وَأَعْظَمُهَا القُرْآنُ لاَ شَكَّ إِنَّهُ","لَبَاقٍ مُحِيلُ الشَّكِّ وَالقَوْلِ بِالْجَحْدِ",103,"د",1,0],["وأعظم بها معجزات كالبحار جرت","لو رام يحصر شخص بعضها وقفا",104,"ف",2,0],["وأعظم شيءٍ أن كفَّك لم يقمْ","بها عرضُ الدنيا وكلُّكَ جوهر",105,"ر",1,0],["وأعظم سيد فيكم يُفادَى","بعُشرِ فداءِ أشعثَ تعلمونا",106,"ن",2,0],["وأعظمُ كلِّ رسل اللَه طراً","وأكرم من سما ندب كريم",107,"م",1,0],["وأعظم منه في الدنيا عناء","عداوة غير ذي حسب ودين",108,"ن",1,0],["وأعظم الناس عند الناس منزلة","وأبعد الناس من عيب ومن وهن",109,"ن",1,0],["وأعظِمْ بِهَا والبُرجُ يَكفِتُ ذَيَلَهَا","كَجَالِسَةٍ قَسْعَاً وكُرسِيُّهَا طَودُ",110,"د",1,0],["وأعظمها على نشوب روحي","تقعقع في اللهات وفي التريب",111,"ب",1,0],["وأعظم خطب زلزل العرش وقعه","وأذهل لب المرضعات عن الولد",112,"د",1,0],["وأعظم ما جرى ما ليس يقضى","بأعظم منه في الملكوت مجرى",113,"ر",2,0],["وَأَعظَمُ من هذا وَذاكَ مُصيبَةٌ","قَضى النَحبَ فيها المُصطَفى وَأَقارِبه",114,"ب",2,0],["وأعظم فخري أن أتيه بذكره","إذا قلت إني عبد أيامك الغرّ",115,"ر",1,0],["وأعظم فادح ملك","به والليل معتكر الظلام",116,"م",1,0],["وأعظم ما بي أنني لست فاهماً","لصمتك معنى عنده يكشف العسر",117,"ر",1,0],["وأعظم ذنبي إن قلبي في الهوى","مشاعره مقرونةٌ بوفائه",118,"ا",3,0],["وأعظم شيءٍ أن يرى الحر حقه","وقد فقد الأنصار في كف غاصب",119,"ب",1,0],["واعظم وسد وارحم وعُد وانعم وجد","واسلم ودمٍ بسعادة لك تخدمُ",120,"م",1,0],["وَأَعظَمُ مِن هذا عَلَيَّ مُصيبَةً","إِذا ذَكَرَتها النَفسُ طالَ زَفيرُها",121,"ر",3,0],["وأعظم ما رج العوالم والهدى","وزلزل قلب الدين حتى تفطرا",122,"ر",2,0],["وَأَعظَمُهُم حِلماً وَعَفواً وَهِمَّةً","وَأَخلاقُ أَملاكٍ أَلَذُّ مِنَ الشّهدِ",123,"د",1,0],["وَأَعظَمُهُم عِندَ الحِفاظِ حَفِيظَةً","وَأَكثَرُهُم عِندَ الإِلهِ تَعَبُّدا",124,"د",2,0],["وأعظم من هذينِ والله أنني","أخافُ بألا نَلْتقي آخرَ الدهر",125,"ر",1,0],["وأعظمُ ما هدّ ركن الجلاد","وأوهن عظماً ومزّق جلدا",126,"د",2,0],["وَأَعظَمُ كُلِّ خَلقِ اللَهِ قَدراً","وَأَكرَمُهُم وَأَطهَرُهُم نِطاقا",127,"ق",2,0],["وأعظم جبَّارٍ على الله فريةً","وما مفترٍ طاغٍ كآخر ناسك",128,"ك",1,0],["وَأعظم الكُل قرآن بِهِ قصص","وَحكمة وَمَواعيظ وَأَخبار",129,"ر",1,0],["وأعظم مادها علياء فهر","رزايا زدن أحشاها استعارا",130,"ر",2,0],["وأعظمُ ما بُليتُ به وأدهى","غلامٌ جاء من ظهري شقيّا",131,"ي",2,0],["واعظم رزء فقد اصطباره","وان كثرت ارزاؤه ومصائبه",132,"ب",2,0],["واعظم ما قاسى خدور عقائل","بها لم يطف غير الملائك طائف",133,"ف",1,0],["وأعظم من حبي لعينيك لهفتي","إلى مثل أعلى من الطهر والقدسِ",134,"س",1,1],["وأعظمُ الخطوب والدَواهي","دخولُهم على عدو اللَه",135,"ه",1,1],["وأعظم ما قاسيت بعد فراقكم","قروح أطالت لي جوى وشجونا",136,"ن",2,1],["وأعظم من نحته النيب قدراً","وأشرف من به الرحمن باهي",137,"ا",3,0],["وأعظمُ مكسوب الفتى مِنْ زمانِه","عدوُّ منافٍ أو صديقٌ منافسُ",138,"س",1,0],["وَأَعظم ما يمض النَفس ندّ","يفارقه من الأَحباب ندُّ",139,"د",1,0],["وأعظم ما ضيعت صحبي ومن يعش","بغير صحاب لم يعش ناعم البال",140,"ل",1,0],["وأعظم ما رأته من الرزايا","شماتة كل جبار عنيد",141,"د",1,0],["وأعظم عيب بالفتى خلف وعده","وشأن الفتى في وعده ليس يخلف",142,"ف",1,0],["وأعظم خطب للعيون أسالها","دما عن حشاشات لها قد أذابهما",143,"م",2,0],["واعظم فادح أشجى لوياً","وقلب الدين فيه شجى قريح",144,"ح",1,0],["وَأَعظَمَ الناسِ عَفواً عِندَ مَقدَرةٍ","وَلَيثَ غابٍ عَلى أَعدائِهِ ضارِ",145,"ر",1,0],["واعظم شيءٍ عترة الوحي أدخلت","سبايا على من فيهم نال للملك",146,"ك",1,0],["وأعظم بنفسك أن تكون معظماً","ممن يجل أماثلاً وأعاظما",147,"م",2,0],["وأعظم خطب لا تقوم بحمله","متون الجبال الراسيات العظائم",148,"م",1,0],["وأعظم من ذا ان رقيت مناكباً","له قد تسامى مجدها واحترامها",149,"م",3,0],["وأَعظمُ بلوائي تَشَفّي حواسدٍ","وأَطماعُ أَعداءٍ على محني تعدو",150,"د",2,0],["وأعظمُ من ذا وذا كله","بلاءً وويلاً لمن فكَّرا",151,"ر",2,0],["وأعظم بها حرية زِيدَ قَدْرُها","لدن فُقِدت، أو قيل في السجن تُفقَدُ",152,"د",1,0],["وَأَعظَمَ بِخالٍ في شَقيقِ خُدودِه","لَدى مِسكِ صِدغٍ عَمَّ بِالنَشرِ قائِحُه",153,"ح",2,0],["واعظم برزء دهى الكائنات","فاسكب منها الدموع الغزارا",154,"ر",2,0],["وأعظم ما بي من جوىً وصبابةً","صدوح حمام بالشجاء تغردا",155,"د",2,0],["وَأَعظَمَ فِينا الرُزءَ لَمّا تَخَيَّرَت","يَدَاهُ كَرِيماً وَهوَ في المجدِ كامِلُه",156,"ل",2,0],["وَأَعظِم إِلهِي أَجرَ إِخوانِهِ الأُلى","لَهُم طَولُ مَجدٍ طالَ في الفَضلِ طائِلُه",156,"ل",2,0],["واعظم ما يعطي المفكر عبرة","أسى تحته تبدو المهابة والقدجر",157,"ر",1,0],["وأعظم هاتيك المدارس رغبةً","عن الخير ما تتلى به الصلوات",158,"ت",1,0],["وأعظم من مصيبات الليالي","علي وصرفها خل خؤون",159,"ن",1,1],["وَأَعظَمُ ما في الأَمرِ أَنّي صائِرٌ","إِلى عادِلٍ في الحُكمِ لَيسَ يَجورُ",160,"ر",1,0],["وَأَعظَمُ مِن هذَينِ شَأناً سَتَغتَدي","بِها رَجُلاً فَوقَ الرِجالِ لِذالِكا",161,"ك",2,0],["وأعظم ما يرى الإنسان قسرا","حبيبا لا يواصله الكلاما",162,"م",2,0],["وأعظمُها فقد الحبيب وعزّةُ ال","لّقاءِ ولا وصل به رغم حسّادي",163,"د",2,0],["وأعظم من عند العظائم يرتجى","حوى الشرف الاسمى فليس يضاهى",164,"ا",3,0],["وأعظم من يدعى الى ربه به","وأعرق من في المجد والجدّ أعرقا",165,"ق",2,0],["وأعظم الكل وفداً حال صبيته","ما بين ظامٍ ومطوي الحشا سغب",166,"ب",1,0],["وأعظم خطب قد أطل فدك من","رواسي علاكم شاهقاً بعد شاهق",167,"ق",1,0],["وأعظم خطبٍ أذاب الحشا","وأجج بين الضلوع التهابا",168,"ب",2,0],["وأعظم ما يدمي المدامع ذكره","ويودع في الأحشاء ما يصدع الصخرا",169,"ر",2,0],["وأعظمُها تَبقى مثالَ سخافةٍ","وتُحقَرُ طولَ الدهرِ بين المواكبط",170,"ب",2,0],["وأعظم غبن أن يرى الملك مغصياً","على شر أرضٍ من بلادك مفرد",171,"د",1,0],["وأعظم ما بي أنني غير واجدٍ","نظيراً اباريه وقرناً ابارزه",172,"ه",1,0],["وأعظم شيءٍ ترى شامتاً","يزيد وتسمع شتم الخطيب",173,"ب",1,0],["وأعظمُ ما لقيتُ غداةَ جَّد","الفراقُ شماتَة الحُساد فينا",174,"ن",2,0],["وأعظم داء الحب إني أشتكي","إليكَ وانتَ الداء لو كنتَ تُنصف",175,"ف",1,0],["وأعظمُ ما ألقى شَماتة عاذلي","وصَدكّ إي والشوق أدهى وأفظع",176,"ع",1,0],["وأعظم ما لاقيتُ قولَ معنّشفي","صبوتَ إليه سهوتَ عن المجد",177,"د",1,0],["وأعظمُ يا رزينَ الحلم من أن","تهيل لحلمكَ الارزاءُ كثبا",178,"ب",2,0],["وأعظمُ من ذا وذا عاذلٌ","يَشك بسمعي سهمَ الملام",179,"م",1,0],["وأعظم تسليمي وأقصى مودتي","لمن خلّف الرحمن في البر والبحر",180,"ر",1,0],["وأعظمها رضى الرب تعالى","ورؤيته بتنزيهٍ إرادي",181,"د",2,0],["وأعظمُ شيءٍ يذيبُ الحَشا","ويقدحُ في القلب منها استعارُ",182,"ر",1,0],["واعظم ما يصبى الفؤاد ثناؤه","وذكر معاليه الذ من الشهد",183,"د",1,0],["وأعظم يومٍ يوم سارت بجعفرٍ","متونُ ركابٍ منه تحمل طيبا",184,"ب",2,0],["واعظاً ما قال كفراً","في الذي صدقاً أبانه",185,"ن",2,0],["وأَعظمُ دَاءٍ رُؤْيَة ُ الْعينِ ثائباً","يُحاولُ عِتقاً والقطيعُ يردُهُ",186,"ه",1,1],["واعظم ما منه بليت بليتي","بخفة أعمالي بكفة ميزاني",187,"ن",2,0],["وأعظم الهمِّ أن يلقى معذبّهُ","ليستعيدَ أماناً غالهُ القلقُ !",188,"ق",1,0],["وأعظم مجلى من مجالي شؤنه","لدى حالتي جمع وفرق ومعهما",189,"م",2,0],["وأَعْظَمُ الشَّوْقِ شَوْقٌ لا انتهَاءَ لَهُ","فَصَيِّرِيني بهِ مُعطًى وَمُستلَبَا",190,"ب",2,0],["وأعظم أهل الفضل من ساد بالقوى","فقاد بسبق الطبع أقوى الأعاظم",191,"م",1,0],["وأعظم للفاروق عزماً ونهضة","غداتئذ والدين في الموقف الداني",192,"ن",2,0],["وأعظمُ ما أخافُ على فؤادي","من الإشراكِ والخلقِ المغالي",193,"ل",2,0],["وأعظم مما قاله الكسم والذي","روى عنه في المعصوم دراًَ منضدا",194,"د",2,0],["وأعظم من هذا فجوراً وفريةً","مقالته الفحشا فسحقاً له سحقا",195,"ق",2,0],["وأعظم من هذا ضلالا وفريةً","مقالته الشنعاء بمن أظهر الحقا",195,"ق",2,0],["وأعظم من هذا التجازف قوله","وتحجيره الرحمن أن يرحم الخلقا",195,"ق",2,0],["وأعظم من هذا حمايتهم لهم","إلى المشهد المعروف للكفر يفتعل",196,"ل",1,0],["وأعظم من هذا معادات بعضهم","لبعض على جهل بما كان ينتحل",196,"ل",1,0],["وأعظم به شعراً حوى كل نصرةٍ","لأنصار دين الله أعظم به نصرا",197,"ر",2,0],["وأعظم الناس عند الله منزلةً","وأبعد الناس من عجز ومن أفن",198,"ن",1,0],["وَ أَعْظَمُ الخَلْقِ جَاءَ اليَوْمَ مَوْلِدُهُ","وَ البَدْرُ يَنْعَمُ إِذْ فِيهِ سَرَائِرُهُ",199,"ر",2,0],["وأعظم من ذاك قلب قريح","ووجد شديد وجسم يذوب",200,"ب",1,0],["وأعظمُ ما يلاقي المرءُ حقاً","جحودُ الفضلِ من شخصٍ قريبِ",201,"ب",1,1],["وأعظم ما نراه في الحروبِ","مقاومة لدى شعب الجنوبِ",202,"ب",1,1],["وأَعظمُ شَيءٍ أنَّ شِمْراً لَهُ على","جَنَاجِن صَدْرِ ابنِ النبيِّ مَقَاعِدُ",203,"د",1,0],["واعظم قصيد البعض مايعجب الكل","حتى قصيد الحب عنا تخلا",204,"ل",2,0],["وَأَعظَمُ ما تُبدِيهِ فِي المَوتِ وِقفَةٌ","وَأَفصَحُ ما تُهدِي لِمَن نَكَصَ الزَّجرُ",205,"ر",1,0],["وأعظم من أشجاه فقد شقيقه","لذلك في أعضاه بان انكسارها",206,"ر",3,0],["وأعظم من غدا والناس سكرى","بدولته تلوذ الأنبياء",207,"ا",2,0],["وأعظم ما بي يا محمدُ أننا","بأرض وفيها بينا البعد والهجرُ",208,"ر",1,0]]}