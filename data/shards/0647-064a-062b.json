{"poems":[[50,"يا بني النقص والعبر","https://www.aldiwan.net/poem63405.html","مجزوء الخفيف"],[382,"قف نبك نفسا عجبها بمماتها","https://www.aldiwan.net/poem66907.html","الكامل"],[435,"لاق المدامة بالمسرة لاقي","https://www.aldiwan.net/poem40041.html","الكامل"],[447,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[519,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145890","الرجز"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111271","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137294",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[4861,"من القلب","https://www.poetsgate.com/ViewPoem.aspx?id=33707",""],[4927,"ضِيم الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=80798",""],[4973,"ثورة الاحرار","https://www.poetsgate.com/ViewPoem.aspx?id=189430",""],[5436,"لبيك يا علم العراق ( عادل العاني )","https://www.poetsgate.com/ViewPoem.aspx?id=30629",""],[5829,"رحلة في تضاريس الجسد","https://www.poetsgate.com/ViewPoem.aspx?id=181380",""],[6019,"شيٌ من الحرمان","https://www.poetsgate.com/ViewPoem.aspx?id=204932",""],[6093,"الأحواز","https://www.poetsgate.com/ViewPoem.aspx?id=195046",""]],"verses":[["هَيثُ لا تُضرَبُ القِبا","بُ عَلَيكُم وَلا الحَجَر",0,"ر",1,0],["هي ثالث القمرين إلّا أنها","فوق السماء تحل في أبياتها",1,"ت",3,0],["هي ثمرةٌ جاءت إلى حجرٍ وإن","كانت تحاكي الدر بالإشراقِ",2,"ق",1,0],["هي ثلمة وقعت ولا جبر لها","أبدا وشنع مكارم لا يرفع",3,"ع",1,0],["هي ثمَّ أشكالُ السّعادةِ والشّقا","وهمُ نتائجُ تلكُمُ الأشكالِ",4,"ل",1,0],["هيَ ثَمان من لَيال مرّت","لَنا بِها لَذيذَة ما مَرَّت",5,"ت",1,0],["هيَ ثورةٌ سيَنحَني","لهَا الذليلُ الخانِعُ",6,"ع",1,0],["هي ثلمة في ديننا واللَه لا","تنسد ما طال الزمان بها إلى",7,"ل",2,0],["هي ثالث القمرين بل هي غادة","بسطت محاسنها لسان الشاكر",8,"ر",1,0],["هِي ثُلُثَا الدُّنيَا وَكُلِّ الخَلقِ","شَمَالِهَا وَالغَربِ ثُمَّ الشَّرقِ",9,"ق",1,0],["هي ثلاث أيام من بعد الوعد","بس أنا احسبها ثلاث من السنين",10,"ن",1,0],["هِيْ ثَوْرَةٌ سُوْرِيَّةٌ مَنْصُوْرَةٌ","مَحْرُوْسَةٌ حُرِسَتْ بِهَا السَّرَّاْءُ",11,"ا",2,0],["هي ثورةُ الأحرار ِ اعظمُ ثورة ٍ","قامت لصون ُ كرامةَ الانسان",12,"ن",1,0],["هيَ \" ثورةُ العشرينَ \" دقَّتْ طبلَها","فليهربِ الأشرارُ من \" بَغدانِ \"",13,"ن",1,0],["هي ثورة بين الضلوع تفجرت","وعتت على قلبي فأوهن وانتشى",14,"ش",2,1],["هي ثورة الفرحِ الذي صالحتُهُ","في القلب لا ترضى به الاحزانُ",15,"ن",1,0],["هِيَ ثورةٌ طَالَ انتظارُ مَخاضِهَا","فأتَى الوَلِيْدُ كآيةِ الإعجَازِ",16,"ز",1,0]]}