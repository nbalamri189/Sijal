d=68955",""],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[5187,"نداء القدس","https://www.poetsgate.com/ViewPoem.aspx?id=29241",""],[5206,"الرد على منكر علم الحِكمة","https://www.poetsgate.com/ViewPoem.aspx?id=187403",""],[5277,"عشّاقُ الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=194588",""],[5363,"يا باعث الأشجان","https://www.poetsgate.com/ViewPoem.aspx?id=144151",""],[5449,"عن القصيدة الفاضلة","https://www.poetsgate.com/ViewPoem.aspx?id=188871",""],[5533,"جاءَ البَشير","https://www.poetsgate.com/ViewPoem.aspx?id=186841",""],[243,"مفضوحة لم تبق طي خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=50474",""],[5686,"يا قدس جئنا","https://www.poetsgate.com/ViewPoem.aspx?id=203544",""],[6093,"يا أيها العربي","https://www.poetsgate.com/ViewPoem.aspx?id=191866",""],[6093,"لن تغرس الغرس حتى تجرح الأرضا","https://www.poetsgate.com/ViewPoem.aspx?id=213562",""],[6093,"تأملات في الكون","https://www.poetsgate.com/ViewPoem.aspx?id=215207",""],[5309,"ألشعر عاطفة بروحك تلمع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573519",""],[6318,"الفجر الدامي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66161&r=&rc=11",""]],"verses":[["وَالنَصلُ عَيني وَالسِنانُ أُذني","وَأُمِّيَ الدِرعُ وَلَم تَلِدني",0,"ن",2,0],["والنّصْرُ باليَدِ مِنِّي واللِّسانِ معاً","ومَنْ لَوى عنكَ جِيداً فهْوَ مَخذولُ",1,"ل",1,0],["وَالنَصرُ مِن جُلَسائِهِ دونَ الوَرى","وَالسَعدُ وَالإِقبالُ مِن أَعوانِهِ",2,"ن",2,0],["وَالنَّصْرُ يُضْحِكُ كُلَّ مَبْسِمِ غُرَّةٍ","وَالْفَتْحُ مَعْقُودٌ بِكُلِّ سَبِيبِ",3,"ب",1,0],["وَالنَصرَ جاراً لا يُحاوِلُ نُقلَةً","وَالصُنعَ رَهناً لا يُريدُ فِكاكا",4,"ك",2,0],["والنصيحُ الصريحُ نُصحاً إذا ما","جمعوا بين رائبٍ وحليبِ",5,"ب",1,0],["وَالنَصرُ غُرَّتُهُ الطَلائِعُ في الوَغى","وَالتابِعونَ مِنَ الخَميسِ حُجولُ",6,"ل",1,0],["وَالنُصحُ مُتَّهَمٌ وَإِن","نَثَرَتهُ كَالدُرِّ الشِفاهُ",7,"ا",2,0],["وَالنِصفُ مِنّي مَتى سَمَحتُ بِهِ","مَعَ اِقتِداري تَطَوُّلاً أَهَبُه",8,"ب",2,0],["وَالنَصرُ حَولَكَ حائِماً","وَصُدورُ ضِدِّكَ حامِيَه",9,"م",3,0],["وَالنَصلُ يَعمَلُ إِخلاصاً بِجَوهَرِهِ","لا بِاِتِّكالٍ عَلى شَحذٍ مِنَ القَينِ",10,"ن",1,0],["والنصرُ ليسَ يُبِينُ حقَّ بَيانِهِ","إلاّ إذا لَقِيَ الكثيرَ قليل",11,"ل",1,0],["وَالنَّصْرُ نَصْرٌ لِلْكَرَامَةِ","وَالسَّلامَةِ وَالأَمَانِ",12,"ن",1,0],["وَالنَّصَارَى فِئةٌ يَوْمَئِذٍ","لمْ تكُنْ فِيهِمْ مِنَ المِعْشارِ عُشْرَا",13,"ر",2,0],["وَالنُّصْحُ مَا زَادَهُ قَبُولاً","كَالصِّدْقِ مِنْ جَانِبِ النَّصِيحِ",14,"ح",1,0],["والنصرُ طوعُ العُرْبٍ، ما","عَقَدوا على النصر الخناصر",15,"ر",1,0],["والنصر في كل الحروب يحفه","واللَه للعبد التقي نصير",16,"ر",1,0],["والنصحُ لله والإِحتما له","ما ثم شيء يسقط احتمالَهُ",17,"ل",2,0],["والنصر والفتح المبين أمامها","في كل معترك ويوم لقاء",18,"ا",2,0],["والنصر والفتح المبين على العدى","وخيار عيش في خيار زمان",19,"ن",1,0],["والنصب فيهما لناصب لفي","واحذفهما لجازم كلم يقف",20,"ف",1,0],["والنصرُ والعِزّ قِريناك ما","رُمْتَ عدوّاً فلك اللهُ جار",21,"ر",1,0],["وَالنَصلُ قَد خَضَبَ النَجيعُ بِياضَهُ","وَالنَقعُ قَد صَبَغَ النَهارَ سَوادُهُ",22,"د",2,0],["والنصرُ من وثّابةٍ نهّابةٍ","بين الكتائب كاللظى في الغيل",23,"ل",1,0],["وَالنُّصْحُ مُطَّرَحٌ مُذالٌ مَحْضُهُ","إِنْ كانَ يُمْكِنُ ناصِحاً أَنْ يَمْحَضا",24,"ض",2,0],["والنُصح للإخوانِ","من أَعظمِ الإحسانِ",25,"ن",1,0],["وَالنصحُ فيهم والتناهي بَينهم","عَن منكرٍ كَقَتيرِها المرضونِ",26,"ن",1,0],["وَالنَصر وَالفَوز المُخَلّد عزّه","رفعت لَنا راياته بَينَ الوَرى",27,"ر",2,0],["والنَصرُ مازال رَبُّ العَرْشِ ضامِنَه","لِمنْ عليه بلا اسْتحقاقِه بُغياً",28,"ي",2,0],["والنُّصْحُ قُرْطٌ ربّما يَجِدُ الفتَى","في السّمْعِ مَحْمَلَه البَهِيَّ ثَقيلا",29,"ل",2,0],["وَالنَصرُ قالَ إِذا أَتاني نَجدَةً","فَبِنَفسِهِ يكفي بِغَيرِ عَساكِرِ",30,"ر",1,0],["والنصّ مثلُ الشمسِ لا يَخْفَى ولا","يضْحي بغيمِ عنادِكم محجوبا",31,"ب",2,0],["والنصر فيك له والخير أجمعه","وإنَّما أنتَ يا منصور منصور",32,"ر",1,0],["والنصر والإقبال بعض جنده","إذا سطا أو إن رمى أو إن غزا",33,"ا",1,0],["والنَّصرُ مُتَّصِلٌ والفَتْحُ مُقْتَبَلٌ","سارٍ فَمُدَّلِجٌ غادٍ فَمُبْتَكِرُ",34,"ر",1,0],["والنصرُ يُشْرِقُ فِي ظُبى أَسيافِها","والفَتْحُ يَلْمَعُ فِي ذُرى أَرْماحِها",35,"ح",3,0],["والنصرُ مُنْسِلُكُمْ والحربُ مُرْضِعُكُمْ","وشامِخُ العِزِّ والعَلْيا لكمْ كَنَفُ",36,"ف",1,0],["والنَّصْرِ من سَعيِ أَعمامٍ لَهُ فُطرُوا","لِنَصرِ ذي العَرْشِ فِي بَدْرٍ وَفِي أُحُدِهْ",37,"د",2,0],["والنصر يلمع من ظبى أسيافه","والفتح يعلم من ذرى أعلامه",38,"م",2,0],["والنصفُ تَنخُر فيه حُمىًّ","رِفقُها بي مُستحيل",39,"ل",1,0],["والنّصرُ منه وحده","إنْ خان نُصَّارٌ وخاموا",40,"م",3,0],["وَالنّصلُ لولا حدُّه وغِرارُه","ما كنتَ حاملَه ليومِ جِلادِ",41,"د",1,0],["والنَّصْرُ إِرْثُكَ عَنْ أَبٍ","قَدْ كَان لِلإِسْلاَمِ نَاصِر",42,"ر",1,0],["وَالنَصر بَين يَديك يَسعى بِالمُنى","وَيَطوف حَولك في الهَنا فُرسانه",43,"ن",2,0],["وَالنَصر الكامل وَالربحِ","وَالحلم الشامل وَالنصحِ",44,"ح",1,0],["وَالنَصر يَسعى خَلفه وَأَمامه","وَعَلى اليَمين وَفي اليَسار عَلانيه",45,"ن",3,0],["والنّصرُ والتأييدُ قد حفَّا به","فهما له من أسعد الإخوانِ",46,"ن",1,0],["والنصر للجند الذي","أعددته أبداً مصاحبْ",47,"ب",1,0],["والنصارى في الذي ليس لهم","فيه نفع لم يكونوا سببا",48,"ب",2,0],["والنصرُ أقبل فاتحاً أبوابَه","لهما وقال لجوا ببابي واصْعدوا",49,"د",3,0],["والنصر صح لدى الامام وحزبه","والقهر حلَّ على حماة الباطل",50,"ل",1,0],["والنصح منكم لم يفدْ إلاّ الغوى","وكأنّه لصدا الفؤاد صقالُ",51,"ل",1,0],["والنصر كم قد لاح تحت لواك مذ","في كفك الصمصام يا مولاي رنْ",52,"ن",1,0],["والنصر تخفق فوق القوم رايته","يعينه من علاك العدل والكرم",53,"م",1,0],["والنّصح يثمر بقلب المعتمر","والنّصح مقبول من صافي الضّمير",54,"ر",1,0],["والنصب والرفع ومع نصب ظهر","وإن يكن فاعل فعل استتر",55,"ر",1,0],["والنصب والجر بذين تين","ثقل وخفّف منهما النونين",55,"ن",1,0],["والنصب باد في سوى فعل الألف","والجزم بالحذف لكل قد ألف",55,"ف",1,0],["والنصب للمنجرّ بعد الحذف","نقلا كما تنصبه بالحذف",55,"ف",1,0],["والنصب حتم إن على اسم قدما","مخصوص فعل نحو إن وحيثما",55,"م",2,0],["والنصب أن تخلو من الجزء ومن","شطر ومن نهك وزائد زكن",56,"ن",1,0],["وَالنُّصحُ فِي غَيرِ إناهُ ضَائِعُ","وَحَزمُكَ الحِصنُ الحَصِينُ المَانِعُ",57,"ع",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه العزيز القاهر",58,"ر",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه القدير القادر",58,"ر",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه العلي قدره",58,"ه",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه اللطيف بالعباد",58,"د",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه الحليم المجمل",58,"ل",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه الكريم المبتدع",58,"ع",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه المعز ناصره",58,"ه",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه المكون المديد",58,"د",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه الحفيظ الباعث",58,"ث",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه الحبيب المنتقم",58,"م",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه هو المحصي الوكيل",58,"ل",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه هو المفتاح",58,"ح",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه الخبير في القدم",58,"م",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه هو الغفار",58,"ر",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه المجيب المغني",58,"ي",1,0],["والنصر والتفريج والفتح القريب","اللّه لا إله إلا هو له",58,"ه",1,0],["والنصر والتفريج والفتح القريب","اللّه لا إله إلا هو في",58,"ي",1,0],["والنصر والتفريج والفتح القريب","اللّه لا إله إلا وهو لم",58,"م",1,0],["والنصر والتفريج والفتح القريب","اللّه لا إله إلا هو ما",58,"م",2,0],["والنصر والتفريج والفتح القريب","اللّه اللّه له الحمد على",58,"ل",2,0],["والنصر والتفريج والفتح القريب","اللّه اللّه جميل الستر",58,"ر",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه الملي بالكرم",58,"م",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه مقيم شرعته",58,"ه",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه له اخلاصي",58,"ي",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه إليه رغبتي",58,"ي",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه إليه أنظر",58,"ر",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه مقامي يعلمه",58,"ه",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه شديد البطش لم",58,"م",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه هو الشديد",58,"د",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه على العرش استوى",58,"ت",3,0],["والنصر والتفريج والفتح القريب","اللّه اللّه هو المعاين",58,"ن",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه به خصم يهون",58,"ن",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه المبر المنعم",58,"م",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه إليه أصرف",58,"ف",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه به الكون نشا",58,"ش",2,0],["والنصر والتفريج والفتح القريب","اللّه اللّه إليه أبتهل",58,"ل",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه به اعتصم",58,"م",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه بكل ما تجب",58,"ب",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه بشاهد الوجود",58,"د",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه يعز السلطنه",58,"ه",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه إليه أصعد",58,"د",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه بحق رحمتك",58,"ك",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه دنا مني الأجل",58,"ل",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه الجواد المسعف",58,"ف",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه المثيب المجزل",58,"ل",1,0],["والنصر والتفريج والفتح القريب","اللّه اللّه بالاسم الأعظم",58,"م",1,0],["والنصر والتفريج والفتح القريب","وافتح لي اللهم من آمالي",58,"ي",1,0],["والنصب أن تنصب لل","ذات أشراك الحيل",59,"ل",1,0],["والنصر له دايم ينادي","ويْعيش زايد نجمه سْعود",60,"د",1,0],["والنصر له فِيْ كلّ وادي","يا حرّ صايد هوب مصيود",60,"د",1,0],["والنصر يضحك تحت رايته كما","ضحك الربيع لعارض مدرار",61,"ر",1,0],["والنص في اطلاقه ما ضاقا","عن نفيه ذرعا ولا خناقا",62,"ق",2,0],["والنصر يهدى اليه ألويةً","يخفِق فيها النجاح والظَّفر",63,"ر",1,0],["والنصر حيثُ ترى هلالَ لوائهِ","لك طالعاً وسط العجاجة طالعُ",64,"ع",1,0],["والنَّصلُ في نَصْرِ المُكَرَّم رائع","في أَنفُسٍ ممن عصاه شَعاعِ",65,"ع",1,0],["والنصرُ رائدُهُ والعزّ عاضِدُهُ","والسعدُ ساعدهُ والشملُ ملتئِمُ",66,"م",1,0],["والنصرُ بالفتحِ قد وافتْ بشائِرُهُ","بجلقٍ وكُفينا البأسَ في رجبِ",67,"ب",