.poetsgate.com/ViewPoem.aspx?id=192384",""],[5956,"كلكم ذوقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=194455",""],[5956,"عاشت مضحيةً","https://www.poetsgate.com/ViewPoem.aspx?id=203447",""],[6023,"وفقي انجادٍ وإنصاف","https://www.poetsgate.com/ViewPoem.aspx?id=123895",""],[6034,"خطب ألم فسار في الآفاق","https://www.poetsgate.com/ViewPoem.aspx?id=169608",""],[6102,"ريما","https://www.poetsgate.com/ViewPoem.aspx?id=184167",""],[5309,"بلادي هوى الدنيا ومأوى الغرائب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573554",""],[6202,"خواطر صائم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86720&r=&rc=21",""],[6202,"دنيا عجائب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86721&r=&rc=22",""],[5957,"الموت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82384&r=&rc=18",""]],"verses":[["وَفَقَأتُ عَينَ البُخلِ مُذ كَثُرَت","بِنَداكَ عِندي الأَينُقُ البُزُلُ",0,"ل",1,0],["وَفُقتَ بِشَوكِ أَخمَصِكَ العَوالي","وَيَلقى المَرءُ لِلغَمِّ اِنفِراجا",1,"ج",2,0],["وَفُقتُ ساكِنَةَ الأبْياتِ مِنْ وَبَرٍ","بِها وَنَازِلَةَ الأمْصارِ مِنْ مَدَرِ",2,"ر",1,0],["وَفَّق اللَهُ مَليكاً","لي يَرى قَتلي صَوابا",3,"ب",2,0],["وَفَقيهِ قَومٍ ظَلَّ يَرصُدُ فِقهَهُ","لِمَكيدَةٍ أَو مُستَحَلِّ طَلاقِ",4,"ق",1,0],["وَفَقَّأَ عَينَي غالِبٍ عِندَ كيرِهِ","نَوازي شَرارِ القَينِ حينَ يُطيرُها",5,"ر",3,0],["وَفَقَّأتُ عَينَي غالِبٍ عِندَ كيرِهِ","وَأَقلَعتُ عَن أَنفِ الفَرَزدَقِ أَجدَعا",6,"ع",2,0],["وفقَّأ فيها الغيثُ من سابيائه","دوالح وأفقن النجوم البواجسا",7,"س",2,1],["وفقهتهمُ إن كنت حقًّا مصححاً","وكانوا حديثاً في الأنام مغلّطا",8,"ط",2,0],["وفَقْدُ الشَّبابِ الموتُ يوجد طعْمُهُ","صُراحاً وطعمُ الموتِ بالموتِ يُفْقدُ",9,"د",1,0],["وفقت بمطراب العشيّاتِ والضحى","فظِلْتُ أسحُّ الدمعَ وهْيَ ترنَّمُ",10,"م",1,1],["وفَّقَ اللَّه بين هذين حتى","عاينا بالصلاح مَنْ يَعنيه",11,"ي",2,0],["وَفَقَدْتُ قلباً همُّهُ أَنْ","يستوي في الأُفقِ بدْرِي",12,"ر",2,0],["وَفَقَدْتُ كفًّا في الحَيَاةِ","يصُدُّ عنِّي كلَّ شرِّ",12,"ر",1,0],["وَفَقَدْتُ وجهاً لا يُعَبِّسُهُ","سوى حَزَني وضُرِّي",12,"ر",2,0],["وَفَقَدْتُ نفساً لا تَني عنْ","صوْن أَفراحي وبِشْرِي",12,"ر",2,0],["وَفَقَدْتُ رُكني في الحَيَاةِ","ورايَتي وعمادَ قصْرِي",12,"ر",2,0],["وَفَّقَكَ اللَهُ لِلسَدادِ وَلا","زِلتَ مَعَ الحَقِّ تَقتَفي أَثَرَه",13,"ر",2,0],["وَفِقدانِ إِلفٍ جَفَوتُ الكَرى","وَعِفتُ السُرورَ لِفِقدانِهِ",14,"ن",2,0],["وَفَقدُكَ أَجدَرُ مِن أَن تُبَرَّ","وَشَتمُكَ أَولى مِنَ التَكنِيَه",15,"ن",3,0],["وفَقْدُ الثلجِ في إبَّانِ قَيْظٍ","تَذُوبُ له الصخورُ الصُّمُّ وَهْجا",16,"ج",2,0],["وَفُقتَهُم بِخِلالٍ قَد خُصِصتَ بِها","لَولا الخُصوصُ تَساوى العودُ وَالحَطَبُ",17,"ب",1,0],["وفقيراً يرى الغنَى والأماني","في اعتصامِ النفوس بالكبرياءِ",18,"ا",2,0],["وفقيرٍ مُعْسِرٍ قد صانَهُ","من مهين الفقر بالمال المهان",19,"ن",1,0],["وفقدُ الأمن أيسرُ ما رأينا","وهولُ القتلِ أهونُ ما لقينا",20,"ن",2,0],["وفُقدانَ المروءةِ والوفاءِ","أيذبحُه ذووه على العياءِ",21,"ا",2,0],["وَفَقدُ أُناسٍ لا أَخافُ عُيونَهُم","قَرَونِيَ مِن أَخلافِهِم حَلَباً مَخضا",22,"ض",2,0],["وَفَقَدتُهُ فَتَماسَكَت","نَفسي عَلى زَفَراتِ",23,"ت",1,0],["وفَقيهاً أفكارُهُ شِدْنَ للنّعْ","مانِ ما لم يَشِدْهُ شعرُ زِيادِ",24,"د",1,0],["وَفَّقَنِي اللهُ إلى خِدْمَةٍ","أَقْضِي بِهَا مِنْ حَقَّهِ مَا وَجَبْ",25,"ب",1,0],["وُفّقَ عَبدُ الغنيّ حينَ مَضى","وَلَم يَبِع دينَهُ بِدُنياهُ",26,"ا",2,0],["وَفَّقَني اللَهُ كَما","وُفِّقتَ حينَ اِختَبَرَك",27,"ك",1,0],["وفقدك لاقتراب الحشر نوع","من الاشراط في أخرى القرون",28,"ن",1,0],["وفقحة ٍ كالحوت في ابتلاعها","يعجز بيتُ المال عن إشباعها",29,"ع",3,1],["وفَقْدُ الشَّبابِ الموتُ، يوجد طعْمُهُ","فصادَف قَتَّالَ الطُّغاة ِ بمَرْصَدٍ",30,"د",1,0],["وَفَقت الآخرين وَلَم","تَفتك السادة الأَول",31,"ل",1,0],["وفقد الأم أصعبه وهذا","حقيقة أمره حر الحريق",32,"ق",1,0],["وفقدُ الفتى صِنوَه فادحٌ","على الحزن في مثله لايلامُ",33,"م",1,0],["وفقد حبيب جاوز الحد بعده","فلا كتب تأتي إليَّ ولا رسل",34,"ل",1,0],["وفقت زادك رب العرش توفيقا","يبقى عليك وإيمانا وتصديقا",35,"ق",2,1],["وفقدت إخواني الذين أحبّهم","ولبست بعدهمُ أرث لباس",36,"س",1,0],["وَفقيرُ الأعمالِ والمالِ والحا","لِ فَقيرٌ في ضمنهِ فقراءُ",37,"ا",2,0],["وَفِقارٌ مُوَثَّقٌ وَضُلوعٌ","نافِجاتُ الحِجابِ وَالحَيزومِ",38,"م",1,0],["وفقدت أهلي والصديق وقد غدا","دمعي حميمي والسهاد ضجيعي",39,"ع",2,0],["وفقد خشوع للفوائد جالب","وأعظم من فقديه فقد تأسفي",40,"ف",2,0],["وُفِّقْتُمُ فُقْتُمُ صَعِدْتُمْ","أُيِّدْتُمُ صِنْتُمُ سَعِدْتًمْ",41,"م",1,0],["وفقيرٌ لِغَنىً حاسدٌ","وغنىٌ يستذلَّ الفقراء",42,"ا",2,0],["وفّقت للخير حيث السير لاح له","سناء وجهٍ بنور القرب منكشف",43,"ف",1,0],["وُفِّقتَ حين رَفضتَ ألأَمَ منزلٍ","ورقيتَ من عُليا الجنان ذُراها",44,"ا",3,0],["وَفَقّوسةٍ مُصفرّةِ اللّونِ أُنبِتَت","بِسبخةِ زور فهيَ مرٌّ مَذاقها",45,"ه",2,1],["وفقد الهدى عند الورى لا يفيد من","غدا عنه بل يجزى بلا وجه حجة",46,"ه",1,0],["وَفَّقَ اللَهُ عاقِلاً قَدَّرَ العَي","شَ فَرَأسُ المَعيشَةِ التَقديرُ",47,"ر",1,1],["وفقَدتُ الوَجدَ فيها والأَسى","فتَألَّمتُ لفقدانِ الألَم",48,"م",1,0],["وفقت الرسل والأبرار طرّاً","بغيرتك التي فيها ولدتِ",49,"ت",1,0],["وفقت مناسك النساك طرّاً","سهرت ثم صليت وصمتِ",49,"ت",1,0],["وفق وسدد واصلح ما بطن أو ظهر","واختم بخير إذا حان الظعن والسفر",50,"ر",1,0],["وفقده الأشعار والفرائد","وجمع ما يقيمه شواهد",51,"د",1,0],["وفَقَدْتُ منه فرائداً وفوائداً","ومكارماً ومغانماً وهباتا",52,"ت",2,0],["وفَقَدْتُ مستند الرجال إذا روت","عنه الثقات مكارم الأَخلاق",53,"ق",1,0],["وفَقَدتُ صبري بعدهم","لا ذاقَ من أهواه فقدا",54,"د",2,0],["وُفِّقت للفعل الجميل وصنعه","إنَّ الموفّق للجميل موفَّق",55,"ق",1,0],["وفقني اللهم حج البيت وأق","بل ما سعيت وما عليه أؤسس",56,"س",1,0],["وفقني اللَه توباتٍ إليك بها","أدنو ولا تجعلني من بها شسعا",57,"ع",2,0],["وفقني اللَه اعمالا رضيت بها","مرضاتك اللهم يا مولاي مرضاتي",58,"ت",2,0],["وفقر شامل وغنى","ومنجاة ومنهدف",59,"ف",1,0],["وفقر عم كل النا","س عند الصدمة الأولى",60,"ا",1,0],["وفقيرٍ عَصَفَ المَحْلُ به","شامَ نُعْماهُ فأعْطى وبَذَلْ",61,"ل",1,1],["وفُقْتَ بني النَّدى والبأسِ حتى","حَسوداك الصَّوارِمُ والغَمامُ",62,"م",1,0],["وفقيهٍ بدا فعاينت منهُ","وجهَ سوء أليَّ غير حبيب",63,"ب",1,1],["وفقدْنا تلكَ الوُجوهَ فمِتْنا","ووَجَدْنا منها البُدورَ فطِبْنَا",64,"ن",2,0],["وفقدت السلو فقد