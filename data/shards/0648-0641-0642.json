{"poems":[[53,"أمبلغي ما أطلب الغزل","https://www.aldiwan.net/poem29910.html","الكامل"],[53,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[63,"الشعر سحر وعندي من روائعه","https://www.aldiwan.net/poem45855.html","البسيط"],[55,"إنما الذنب لكف","https://www.aldiwan.net/poem26537.html","مجزوء الرمل"],[86,"كم ذا يكابد عاشق ويلاقي","https://www.aldiwan.net/poem10915.html","الكامل"],[27,"أزرت ديار الحي أم لا تزورها","https://www.aldiwan.net/poem5767.html","الطويل"],[27,"أقمنا وربتنا الديار ولا أرى","https://www.aldiwan.net/poem5798.html","الطويل"],[37,"وفقأ فيها الغيث من سابيائه","https://www.aldiwan.net/poem7218.html","الطويل"],[72,"تعشقته ظبي الكناس إذا عطا","https://www.aldiwan.net/poem19139.html","الطويل"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"وفقت بمطراب العشيات والضحى","https://www.aldiwan.net/poem66073.html","الطويل"],[51,"شهر نسك قرينه يوم لهو","https://www.aldiwan.net/poem66715.html","الخفيف"],[92,"يا موت قد مزقت صدري","https://www.aldiwan.net/poem38940.html","مجزوء الكامل"],[45,"قل للوزير الذي مناقبه","https://www.aldiwan.net/poem63613.html","المنسرح"],[45,"أثيل العقيق إلى بانه","https://www.aldiwan.net/poem66677.html","المتقارب"],[45,"غناؤك يورثك التزنيه","https://www.aldiwan.net/poem66861.html","المتقارب"],[61,"رأيت الناس ذا جود ومنع","https://www.aldiwan.net/poem51747.html","الوافر"],[66,"ما هبت الريح إلا هزني الطرب","https://www.aldiwan.net/poem40984.html","البسيط"],[97,"أنت حي برغمِ عاد الفناء","https://www.aldiwan.net/poem24382.html","الخفيف"],[80,"أخذت سفاقس منك عهد أمان","https://www.aldiwan.net/poem31263.html","الكامل"],[105,"جرى سعدا ومر بنا يمينا","https://www.aldiwan.net/poem42092.html","الوافر"],[105,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[52,"ومما شجاني بارق لاح موهنا","https://www.aldiwan.net/poem26880.html","الطويل"],[52,"ولقد غدوت على طمر","https://www.aldiwan.net/poem27191.html","مجزوء الكامل"],[46,"غير مجد في ملتي واعتقادي","https://www.aldiwan.net/poem23625.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54576","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[51,"وفقحة ٍ كالحوت في ابتلاعها","https://www.poetsgate.com/ViewPoem.aspx?id=29509",""],[51,"أخفُّ مناطاً في الرقاب وأوْكَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=25837",""],[110,"تناهى عنده الأمل","https://www.aldiwan.net/poem16299.html","مجزوء الوافر"],[116,"فراق الوالدين لذي كمال","https://www.aldiwan.net/poem41700.html","الوافر"],[143,"يروح ويغدو علينا الحمام","https://www.aldiwan.net/poem58402.html","المتقارب"],[161,"علي لها أن لا انام ولا أسلو","https://www.aldiwan.net/poem59084.html","الطويل"],[161,"وفقت زادك رب العرش توفيقا","https://www.aldiwan.net/poem59189.html","الوافر"],[187,"قد شفني حنف مع الإفلاس","https://www.aldiwan.net/poem43696.html","الكامل"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[196,"منع النوم طارقات الهموم","https://www.aldiwan.net/poem54415.html","الخفيف"],[211,"رحلوا بقلبي ساعة التوديع","https://www.aldiwan.net/poem13392.html","الكامل"],[232,"إليك رسول الله أشكو تخلفي","https://www.aldiwan.net/poem44580.html","الطويل"],[238,"وصلي وصلتم كما وصلتم","https://www.aldiwan.net/poem18098.html","مخلع البسيط"],[242,"يا بني الفقر سلاما عاطرا","https://www.aldiwan.net/poem45752.html","الرمل"],[260,"من بحر حمدي لرب المنح مغترفي","https://www.aldiwan.net/poem35943.html","البسيط"],[298,"تفديك لو قبل المنون فداها","https://www.aldiwan.net/poem33083.html","الكامل"],[306,"وفقوسة مصفرة اللون أنبتت","https://www.aldiwan.net/poem56455.html","الطويل"],[326,"سؤالك يا هذا سؤال معاند","https://www.aldiwan.net/poem52139.html","الطويل"],[339,"وفق الله عاقلا قدر العيش","https://www.aldiwan.net/poem68765.html","الخفيف"],[372,"نكرت معرفتي لما حكم","https://www.aldiwan.net/poem57166.html","الرمل"],[378,"سموت الأنبيا يا بكر علما","https://www.aldiwan.net/poem66898.html","الوافر"],[392,"رضوان لا زلت راضي بالقضا والقدر","https://www.aldiwan.net/poem54573.html","عموديه"],[404,"أحسن ما يبدي به الكلام","https://www.aldiwan.net/poem33344.html","الرجز"],[417,"ما لي أفارق كل يوم صاحبا","https://www.aldiwan.net/poem53942.html","الكامل"],[417,"ما لي أودع كل يوم صباحا","https://www.aldiwan.net/poem54093.html","الكامل"],[417,"قلب يذوب عليك وجدا","https://www.aldiwan.net/poem54142.html","مجزوء الكامل"],[417,"طرف يراعي النجم وهو مؤرق","https://www.aldiwan.net/poem54166.html","الكامل"],[442,"العذل يقلق والصبابة تلبس","https://www.aldiwan.net/poem14308.html","الكامل"],[442,"ليت الكفان الذي إن مت لي صنعا","https://www.aldiwan.net/poem14333.html","البسيط"],[442,"حتى متى أنا حي بين أموات","https://www.aldiwan.net/poem14438.html","البسيط"],[442,"عزاء يا بني شرف","https://www.aldiwan.net/poem14463.html","مجزوء الوافر"],[444,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[462,"وفقير عصف المحل به","https://www.aldiwan.net/poem15697.html","الرمل"],[462,"فضلت تهاني الأيام طرا","https://www.aldiwan.net/poem16096.html","الوافر"],[465,"وفقيه بدا فعاينت منه","https://www.aldiwan.net/poem3125.html","عموديه"],[501,"ما طوى الركب شقة الأرض يوما","https://www.aldiwan.net/poem38090.html","الخفيف"],[516,"خطبتني الخطوب بالهم لما","https://www.aldiwan.net/poem12295.html","الخفيف"],[539,"دعاني من ذكر السقام دعانيا","https://www.aldiwan.net/poem47498.html","عموديه"],[539,"إبتسم فالحياة تبدي ابتساما","https://www.aldiwan.net/poem47943.html","عموديه"],[552,"صبرت ومثلك لا يجزع","https://www.aldiwan.net/poem47722.html","المتقارب"],[552,"أتمضي كذا أيدي الردى بالمصاعب","https://www.aldiwan.net/poem48057.html","الكامل"],[559,"شعورك والإدراك فعل الذي خلق","https://www.aldiwan.net/poem34308.html","الطويل"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[576,"راح رسولي وجاءني عاشق","https://www.aldiwan.net/poem3045.html","المنسرح"],[576,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[587,"وفقيه كالبدر زار بليل","https://www.aldiwan.net/poem17659.html","الخفيف"]],"verses":[["وَفَقَأتُ عَينَ البُخلِ مُذ كَثُرَت","بِنَداكَ عِندي الأَينُقُ البُزُلُ",0,"ل",1,0],["وَفُقتَ بِشَوكِ أَخمَصِكَ العَوالي","وَيَلقى المَرءُ لِلغَمِّ اِنفِراجا",1,"ج",2,0],["وَفُقتُ ساكِنَةَ الأبْياتِ مِنْ وَبَرٍ","بِها وَنَازِلَةَ الأمْصارِ مِنْ مَدَرِ",2,"ر",1,0],["وَفَّق اللَهُ مَليكاً","لي يَرى قَتلي صَوابا",3,"ب",2,0],["وَفَقيهِ قَومٍ ظَلَّ يَرصُدُ فِقهَهُ","لِمَكيدَةٍ أَو مُستَحَلِّ طَلاقِ",4,"ق",1,0],["وَفَقَّأَ عَينَي غالِبٍ عِندَ كيرِهِ","نَوازي شَرارِ القَينِ حينَ يُطيرُها",5,"ر",3,0],["وَفَقَّأتُ عَينَي غالِبٍ عِندَ كيرِهِ","وَأَقلَعتُ عَن أَنفِ الفَرَزدَقِ أَجدَعا",6,"ع",2,0],["وفقَّأ فيها الغيثُ من سابيائه","دوالح وأفقن النجوم البواجسا",7,"س",2,1],["وفقهتهمُ إن كنت حقًّا مصححاً","وكانوا حديثاً في الأنام مغلّطا",8,"ط",2,0],["وفَقْدُ الشَّبابِ الموتُ يوجد طعْمُهُ","صُراحاً وطعمُ الموتِ بالموتِ يُفْقدُ",9,"د",1,0],["وفقت بمطراب العشيّاتِ والضحى","فظِلْتُ أسحُّ الدمعَ وهْيَ ترنَّمُ",10,"م",1,1],["وفَّقَ اللَّه بين هذين حتى","عاينا بالصلاح مَنْ يَعنيه",11,"ي",2,0],["وَفَقَدْتُ قلباً همُّهُ أَنْ","يستوي في الأُفقِ بدْرِي",12,"ر",2,0],["وَفَقَدْتُ كفًّا في الحَيَاةِ","يصُدُّ عنِّي كلَّ شرِّ",12,"ر",1,0],["وَفَقَدْتُ وجهاً لا يُعَبِّسُهُ","سوى حَزَني وضُرِّي",12,"ر",2,0],["وَفَقَدْتُ نفساً لا تَني عنْ","صوْن أَفراحي وبِشْرِي",12,"ر",2,0],["وَفَقَدْتُ رُكني في الحَيَاةِ","ورايَتي وعمادَ قصْرِي",12,"ر",2,0],["وَفَّقَكَ اللَهُ لِلسَدادِ وَلا","زِلتَ مَعَ الحَقِّ تَقتَفي أَثَرَه",13,"ر",2,0],["وَفِقدانِ إِلفٍ جَفَوتُ الكَرى","وَعِفتُ السُرورَ لِفِقدانِهِ",14,"ن",2,0],["وَفَقدُكَ أَجدَرُ مِن أَن تُبَرَّ","وَشَتمُكَ أَولى مِنَ التَكنِيَه",15,"ن",3,0],["وفَقْدُ الثلجِ في إبَّانِ قَيْظٍ","تَذُوبُ له الصخورُ الصُّمُّ وَهْجا",16,"ج",2,0],["وَفُقتَهُم بِخِلالٍ قَد خُصِصتَ بِها","لَولا الخُصوصُ تَساوى العودُ وَالحَطَبُ",17,"ب",1,0],["وفقيراً يرى الغنَى والأماني","في اعتصامِ النفوس بالكبرياءِ",18,"ا",2,0],["وفقيرٍ مُعْسِرٍ قد صانَهُ","من مهين الفقر بالمال المهان",19,"ن",1,0],["وفقدُ الأمن أيسرُ ما رأينا","وهولُ القتلِ أهونُ ما لقينا",20,"ن",2,0],["وفُقدانَ المروءةِ والوفاءِ","أيذبحُه ذووه على العياءِ",21,"ا",2,0],["وَفَقدُ أُناسٍ لا أَخافُ عُيونَهُم","قَرَونِيَ مِن أَخلافِهِم حَلَباً مَخضا",22,"ض",2,0],["وَفَقَدتُهُ فَتَماسَكَت","نَفسي عَلى زَفَراتِ",23,"ت",1,0],["وفَقيهاً أفكارُهُ شِدْنَ للنّعْ","مانِ ما لم يَشِدْهُ شعرُ زِيادِ",24,"د",1,0],["وَفَّقَنِي اللهُ إلى خِدْمَةٍ","أَقْضِي بِهَا مِنْ حَقَّهِ مَا وَجَبْ",25,"ب",1,0],["وُفّقَ عَبدُ الغنيّ حينَ مَضى","وَلَم يَبِع دينَهُ بِدُنياهُ",26,"ا",2,0],["وَفَّقَني اللَهُ كَما","وُفِّقتَ حينَ اِختَبَرَك",27,"ك",1,0],["وفقحة ٍ كالحوت في ابتلاعها","يعجز بيتُ المال عن إشباعها",28,"ع",3,1],["وفَقْدُ الشَّبابِ الموتُ، يوجد طعْمُهُ","فصادَف قَتَّالَ الطُّغاة ِ بمَرْصَدٍ",29,"د",1,0],["وَفَقت الآخرين وَلَم","تَفتك السادة الأَول",30,"ل",1,0],["وفقد الأم أصعبه وهذا","حقيقة أمره حر الحريق",31,"ق",1,0],["وفقدُ الفتى صِنوَه فادحٌ","على الحزن في مثله لايلامُ",32,"م",1,0],["وفقد حبيب جاوز الحد بعده","فلا كتب تأتي إليَّ ولا رسل",33,"ل",1,0],["وفقت زادك رب العرش توفيقا","يبقى عليك وإيمانا وتصديقا",34,"ق",2,1],["وفقدت إخواني الذين أحبّهم","ولبست بعدهمُ أرث لباس",35,"س",1,0],["وَفقيرُ الأعمالِ والمالِ والحا","لِ فَقيرٌ في ضمنهِ فقراءُ",36,"ا",2,0],["وَفِقارٌ مُوَثَّقٌ وَضُلوعٌ","نافِجاتُ الحِجابِ وَالحَيزومِ",37,"م",1,0],["وفقدت أهلي والصديق وقد غدا","دمعي حميمي والسهاد ضجيعي",38,"ع",2,0],["وفقد خشوع للفوائد جالب","وأعظم من فقديه فقد تأسفي",39,"ف",2,0],["وُفِّقْتُمُ فُقْتُمُ صَعِدْتُمْ","أُيِّدْتُمُ صِنْتُمُ سَعِدْتًمْ",40,"م",1,0],["وفقيرٌ لِغَنىً حاسدٌ","وغنىٌ يستذلَّ الفقراء",41,"ا",2,0],["وفّقت للخير حيث السير لاح له","سناء وجهٍ بنور القرب منكشف",42,"ف",1,0],["وُفِّقتَ حين رَفضتَ ألأَمَ منزلٍ","ورقيتَ من عُليا الجنان ذُراها",43,"ا",3,0],["وَفَقّوسةٍ مُصفرّةِ اللّونِ أُنبِتَت","بِسبخةِ زور فهيَ مرٌّ مَذاقها",44,"ه",2,1],["وفقد الهدى عند الورى لا يفيد من","غدا عنه بل يجزى بلا وجه حجة",45,"ه",1,0],["وَفَّقَ اللَهُ عاقِلاً قَدَّرَ العَي","شَ فَرَأسُ المَعيشَةِ التَقديرُ",46,"ر",1,1],["وفقَدتُ الوَجدَ فيها والأَسى","فتَألَّمتُ لفقدانِ الألَم",47,"م",1,0],["وفقت الرسل والأبرار طرّاً","بغيرتك التي فيها ولدتِ",48,"ت",1,0],["وفقت مناسك النساك طرّاً","سهرت ثم صليت وصمتِ",48,"ت",1,0],["وفق وسدد واصلح ما بطن أو ظهر","واختم بخير إذا حان الظعن والسفر",49,"ر",1,0],["وفقده الأشعار والفرائد","وجمع ما يقيمه شواهد",50,"د",1,0],["وفَقَدْتُ منه فرائداً وفوائداً","ومكارماً ومغانماً وهباتا",51,"ت",2,0],["وفَقَدْتُ مستند الرجال إذا روت","عنه الثقات مكارم الأَخلاق",52,"ق",1,0],["وفَقَدتُ صبري بعدهم","لا ذاقَ من أهواه فقدا",53,"د",2,0],["وُفِّقت للفعل الجميل وصنعه","إنَّ الموفّق للجميل موفَّق",54,"ق",1,0],["وفقني اللهم حج البيت وأق","بل ما سعيت وما عليه أؤسس",55,"س",1,0],["وفقني اللَه توباتٍ إليك بها","أدنو ولا تجعلني من بها شسعا",56,"ع",2,0],["وفقني اللَه اعمالا رضيت بها","مرضاتك اللهم يا مولاي مرضاتي",57,"ت",2,0],["وفقر شامل وغنى","ومنجاة ومنهدف",58,"ف",1,0],["وفقر عم كل النا","س عند الصدمة الأولى",59,"ا",1,0],["وفقيرٍ عَصَفَ المَحْلُ به","شامَ نُعْماهُ فأعْطى وبَذَلْ",60,"ل",1,1],["وفُقْتَ بني النَّدى والبأسِ حتى","حَسوداك الصَّوارِمُ والغَمامُ",61,"م",1,0],["وفقيهٍ بدا فعاينت منهُ","وجهَ سوء أليَّ غير حبيب",62,"ب",1,1],["وفقدْنا تلكَ الوُجوهَ فمِتْنا","ووَجَدْنا منها البُدورَ فطِبْنَا",63,"ن",2,0],["وفقدت السلو فقد رقادي","فتراني مراقب السرحان",64,"ن",1,0],["وفَقرُ نفُوسٍ لو هُمُ يعلَمُونَه","بِحقٍّ لَدام الطَّرفُ منهُمُ دامِيا",65,"ي",2,0],["وَفقَ ما شئتَ كلُّنا نتَمَشَّى","ولدَى ما تُحِبُّ نَبقى قِياما",66,"م",2,0],["وفقدُ النّساءِ كفقدِ الرّجال","يحزّ إذا حزّ أو يقطعُ",67,"ع",1,0],["وَفقدُ الصَّديقِ المَحض صَعْبٌ فَكيفَ بي","وفقدي صديقاً من أجلّ أقاربي",68,"ب",2,0],["وفق من خمار النفس وابق به له","تَصِر صاحياً صحواً شديداً على طلق",69,"ق",1,0],["وفقه الهوى فرض على القوم درسه","وكم ناله شيخ وكهل ويافع",70,"ع",1,0],["وفقتُهمْ بالكمالِ وليعلم ال","خلقُ بأَنَّ الكمالَ بي فَائِقْ",71,"ق",1,0],["وفَقِيهُ النَّوالِ يُلْقِي عَطَايَا","ه عَلَى الْخَلْقِ والغَمامُ الْمُعِيدُ",72,"د",1,0],["وَفَقِيهٍ كَالبَدْرِ زَارَ بِلَيْلٍ","فَجَلا نُورُهُ الدُّجَى إِذْ تَجَلَّى",73,"ل",2,1]]}