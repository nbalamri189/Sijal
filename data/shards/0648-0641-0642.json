{"poems":[[55,"أمبلغي ما أطلب الغزل","https://www.aldiwan.net/poem29910.html","الكامل"],[55,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[65,"الشعر سحر وعندي من روائعه","https://www.aldiwan.net/poem45855.html","البسيط"],[57,"إنما الذنب لكف","https://www.aldiwan.net/poem26537.html","مجزوء الرمل"],[88,"كم ذا يكابد عاشق ويلاقي","https://www.aldiwan.net/poem10915.html","الكامل"],[29,"أزرت ديار الحي أم لا تزورها","https://www.aldiwan.net/poem5767.html","الطويل"],[29,"أقمنا وربتنا الديار ولا أرى","https://www.aldiwan.net/poem5798.html","الطويل"],[39,"وفقأ فيها الغيث من سابيائه","https://www.aldiwan.net/poem7218.html","الطويل"],[74,"تعشقته ظبي الكناس إذا عطا","https://www.aldiwan.net/poem19139.html","الطويل"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[53,"وفقت بمطراب العشيات والضحى","https://www.aldiwan.net/poem66073.html","الطويل"],[53,"شهر نسك قرينه يوم لهو","https://www.aldiwan.net/poem66715.html","الخفيف"],[94,"يا موت قد مزقت صدري","https://www.aldiwan.net/poem38940.html","مجزوء الكامل"],[47,"قل للوزير الذي مناقبه","https://www.aldiwan.net/poem63613.html","المنسرح"],[47,"أثيل العقيق إلى بانه","https://www.aldiwan.net/poem66677.html","المتقارب"],[47,"غناؤك يورثك التزنيه","https://www.aldiwan.net/poem66861.html","المتقارب"],[63,"رأيت الناس ذا جود ومنع","https://www.aldiwan.net/poem51747.html","الوافر"],[68,"ما هبت الريح إلا هزني الطرب","https://www.aldiwan.net/poem40984.html","البسيط"],[99,"أنت حي برغمِ عاد الفناء","https://www.aldiwan.net/poem24382.html","الخفيف"],[82,"أخذت سفاقس منك عهد أمان","https://www.aldiwan.net/poem31263.html","الكامل"],[107,"جرى سعدا ومر بنا يمينا","https://www.aldiwan.net/poem42092.html","الوافر"],[107,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[54,"ومما شجاني بارق لاح موهنا","https://www.aldiwan.net/poem26880.html","الطويل"],[54,"ولقد غدوت على طمر","https://www.aldiwan.net/poem27191.html","مجزوء الكامل"],[48,"غير مجد في ملتي واعتقادي","https://www.aldiwan.net/poem23625.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54576","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[111,"تهد العمر رائعة المنون","https://www.poetsgate.com/ViewPoem.aspx?id=523",""],[53,"وفقحة ٍ كالحوت في ابتلاعها","https://www.poetsgate.com/ViewPoem.aspx?id=29509",""],[53,"أخفُّ مناطاً في الرقاب وأوْكَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=25837",""],[113,"تناهى عنده الأمل","https://www.aldiwan.net/poem16299.html","مجزوء الوافر"],[119,"فراق الوالدين لذي كمال","https://www.aldiwan.net/poem41700.html","الوافر"],[146,"يروح ويغدو علينا الحمام","https://www.aldiwan.net/poem58402.html","المتقارب"],[164,"علي لها أن لا انام ولا أسلو","https://www.aldiwan.net/poem59084.html","الطويل"],[164,"وفقت زادك رب العرش توفيقا","https://www.aldiwan.net/poem59189.html","الوافر"],[190,"قد شفني حنف مع الإفلاس","https://www.aldiwan.net/poem43696.html","الكامل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[199,"منع النوم طارقات الهموم","https://www.aldiwan.net/poem54415.html","الخفيف"],[214,"رحلوا بقلبي ساعة التوديع","https://www.aldiwan.net/poem13392.html","الكامل"],[235,"إليك رسول الله أشكو تخلفي","https://www.aldiwan.net/poem44580.html","الطويل"],[241,"وصلي وصلتم كما وصلتم","https://www.aldiwan.net/poem18098.html","مخلع البسيط"],[245,"يا بني الفقر سلاما عاطرا","https://www.aldiwan.net/poem45752.html","الرمل"],[263,"من بحر حمدي لرب المنح مغترفي","https://www.aldiwan.net/poem35943.html","البسيط"],[301,"تفديك لو قبل المنون فداها","https://www.aldiwan.net/poem33083.html","الكامل"],[309,"وفقوسة مصفرة اللون أنبتت","https://www.aldiwan.net/poem56455.html","الطويل"],[329,"سؤالك يا هذا سؤال معاند","https://www.aldiwan.net/poem52139.html","الطويل"],[342,"وفق الله عاقلا قدر العيش","https://www.aldiwan.net/poem68765.html","الخفيف"],[375,"نكرت معرفتي لما حكم","https://www.aldiwan.net/poem57166.html","الرمل"],[381,"سموت الأنبيا يا بكر علما","https://www.aldiwan.net/poem66898.html","الوافر"],[395,"رضوان لا زلت راضي بالقضا والقدر","https://www.aldiwan.net/poem54573.html","عموديه"],[407,"أحسن ما يبدي به الكلام","https://www.aldiwan.net/poem33344.html","الرجز"],[420,"ما لي أفارق كل يوم صاحبا","https://www.aldiwan.net/poem53942.html","الكامل"],[420,"ما لي أودع كل يوم صباحا","https://www.aldiwan.net/poem54093.html","الكامل"],[420,"قلب يذوب عليك وجدا","https://www.aldiwan.net/poem54142.html","مجزوء الكامل"],[420,"طرف يراعي النجم وهو مؤرق","https://www.aldiwan.net/poem54166.html","الكامل"],[445,"العذل يقلق والصبابة تلبس","https://www.aldiwan.net/poem14308.html","الكامل"],[445,"ليت الكفان الذي إن مت لي صنعا","https://www.aldiwan.net/poem14333.html","البسيط"],[445,"حتى متى أنا حي بين أموات","https://www.aldiwan.net/poem14438.html","البسيط"],[445,"عزاء يا بني شرف","https://www.aldiwan.net/poem14463.html","مجزوء الوافر"],[447,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[464,"وفقير عصف المحل به","https://www.aldiwan.net/poem15697.html","الرمل"],[464,"فضلت تهاني الأيام طرا","https://www.aldiwan.net/poem16096.html","الوافر"],[467,"وفقيه بدا فعاينت منه","https://www.aldiwan.net/poem3125.html","عموديه"],[503,"ما طوى الركب شقة الأرض يوما","https://www.aldiwan.net/poem38090.html","الخفيف"],[518,"خطبتني الخطوب بالهم لما","https://www.aldiwan.net/poem12295.html","الخفيف"],[541,"دعاني من ذكر السقام دعانيا","https://www.aldiwan.net/poem47498.html","عموديه"],[541,"إبتسم فالحياة تبدي ابتساما","https://www.aldiwan.net/poem47943.html","عموديه"],[554,"صبرت ومثلك لا يجزع","https://www.aldiwan.net/poem47722.html","المتقارب"],[554,"أتمضي كذا أيدي الردى بالمصاعب","https://www.aldiwan.net/poem48057.html","الكامل"],[561,"شعورك والإدراك فعل الذي خلق","https://www.aldiwan.net/poem34308.html","الطويل"],[561,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[578,"راح رسولي وجاءني عاشق","https://www.aldiwan.net/poem3045.html","المنسرح"],[578,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[589,"وفقيه كالبدر زار بليل","https://www.aldiwan.net/poem17659.html","الخفيف"],[1163,"","https://poetry.dctabudhabi.ae/diwan/poem/28933","الطويل"]],"verses":[["وَفَقَأتُ عَينَ البُخلِ مُذ كَثُرَت","بِنَداكَ عِندي الأَينُقُ البُزُلُ",0,"ل",1,0],["وَفُقتَ بِشَوكِ أَخمَصِكَ العَوالي","وَيَلقى المَرءُ لِلغَمِّ اِنفِراجا",1,"ج",2,0],["وَفُقتُ ساكِنَةَ الأبْياتِ مِنْ وَبَرٍ","بِها وَنَازِلَةَ الأمْصارِ مِنْ مَدَرِ",2,"ر",1,0],["وَفَّق اللَهُ مَليكاً","لي يَرى قَتلي صَوابا",3,"ب",2,0],["وَفَقيهِ قَومٍ ظَلَّ يَرصُدُ فِقهَهُ","لِمَكيدَةٍ أَو مُستَحَلِّ طَلاقِ",4,"ق",1,0],["وَفَقَّأَ عَينَي غالِبٍ عِندَ كيرِهِ","نَوازي شَرارِ القَينِ حينَ يُطيرُها",5,"ر",3,0],["وَفَقَّأتُ عَينَي غالِبٍ عِندَ كيرِهِ","وَأَقلَعتُ عَن أَنفِ الفَرَزدَقِ أَجدَعا",6,"ع",2,0],["وفقَّأ فيها الغيثُ من سابيائه","دوالح وأفقن النجوم البواجسا",7,"س",2,1],["وفقهتهمُ إن كنت حقًّا مصححاً","وكانوا حديثاً في الأنام مغلّطا",8,"ط",2,0],["وفَقْدُ الشَّبابِ الموتُ يوجد طعْمُهُ","صُراحاً وطعمُ الموتِ بالموتِ يُفْقدُ",9,"د",1,0],["وفقت بمطراب العشيّاتِ والضحى","فظِلْتُ أسحُّ الدمعَ وهْيَ ترنَّمُ",10,"م",1,1],["وفَّقَ اللَّه بين هذين حتى","عاينا بالصلاح مَنْ يَعنيه",11,"ي",2,0],["وَفَقَدْتُ قلباً همُّهُ أَنْ","يستوي في الأُفقِ بدْرِي",12,"ر",2,0],["وَفَقَدْتُ كفًّا في الحَيَاةِ","يصُدُّ عنِّي كلَّ شرِّ",12,"ر",1,0],["وَفَقَدْتُ وجهاً لا يُعَبِّسُهُ","سوى حَزَني وضُرِّي",12,"ر",2,0],["وَفَقَدْتُ نفساً لا تَني عنْ","صوْن أَفراحي وبِشْرِي",12,"ر",2,0],["وَفَقَدْتُ رُكني في الحَيَاةِ","ورايَتي وعمادَ قصْرِي",12,"ر",2,0],["وَفَّقَكَ اللَهُ لِلسَدادِ وَلا","زِلتَ مَعَ الحَقِّ تَقتَفي أَثَرَه",13,"ر",2,0],["وَفِقدانِ إِلفٍ جَفَوتُ الكَرى","وَعِفتُ السُرورَ لِفِقدانِهِ",14,"ن",2,0],["وَفَقدُكَ أَجدَرُ مِن أَن تُبَرَّ","وَشَتمُكَ أَولى مِنَ التَكنِيَه",15,"ن",3,0],["وفَقْدُ الثلجِ في إبَّانِ قَيْظٍ","تَذُوبُ له الصخورُ الصُّمُّ وَهْجا",16,"ج",2,0],["وَفُقتَهُم بِخِلالٍ قَد خُصِصتَ بِها","لَولا الخُصوصُ تَساوى العودُ وَالحَطَبُ",17,"ب",1,0],["وفقيراً يرى الغنَى والأماني","في اعتصامِ النفوس بالكبرياءِ",18,"ا",2,0],["وفقيرٍ مُعْسِرٍ قد صانَهُ","من مهين الفقر بالمال المهان",19,"ن",1,0],["وفقدُ الأمن أيسرُ ما رأينا","وهولُ القتلِ أهونُ ما لقينا",20,"ن",2,0],["وفُقدانَ المروءةِ والوفاءِ","أيذبحُه ذووه على العياءِ",21,"ا",2,0],["وَفَقدُ أُناسٍ لا أَخافُ عُيونَهُم","قَرَونِيَ مِن أَخلافِهِم حَلَباً مَخضا",22,"ض",2,0],["وَفَقَدتُهُ فَتَماسَكَت","نَفسي عَلى زَفَراتِ",23,"ت",1,0],["وفَقيهاً أفكارُهُ شِدْنَ للنّعْ","مانِ ما لم يَشِدْهُ شعرُ زِيادِ",24,"د",1,0],["وَفَّقَنِي اللهُ إلى خِدْمَةٍ","أَقْضِي بِهَا مِنْ حَقَّهِ مَا وَجَبْ",25,"ب",1,0],["وُفّقَ عَبدُ الغنيّ حينَ مَضى","وَلَم يَبِع دينَهُ بِدُنياهُ",26,"ا",2,0],["وَفَّقَني اللَهُ كَما","وُفِّقتَ حينَ اِختَبَرَك",27,"ك",1,0],["وفقدك لاقتراب الحشر نوع","من الاشراط في أخرى القرون",28,"ن",1,0],["وفقحة ٍ كالحوت في ابتلاعها","يعجز بيتُ المال عن إشباعها",29,"ع",3,1],["وفَقْدُ الشَّبابِ الموتُ، يوجد طعْمُهُ","فصادَف قَتَّالَ الطُّغاة ِ بمَرْصَدٍ",30,"د",1,0],["وَفَقت الآخرين وَلَم","تَفتك السادة الأَول",31,"ل",1,0],["وفقد الأم أصعبه وهذا","حقيقة أمره حر الحريق",32,"ق",1,0],["وفقدُ الفتى صِنوَه فادحٌ","على الحزن في مثله لايلامُ",33,"م",1,0],["وفقد حبيب جاوز الحد بعده","فلا كتب تأتي إليَّ ولا رسل",34,"ل",1,0],["وفقت زادك رب العرش توفيقا","يبقى عليك وإيمانا وتصديقا",35,"ق",2,1],["وفقدت إخواني الذين أحبّهم","ولبست بعدهمُ أرث لباس",36,"س",1,0],["وَفقيرُ الأعمالِ والمالِ والحا","لِ فَقيرٌ في ضمنهِ فقراءُ",37,"ا",2,0],["وَفِقارٌ مُوَثَّقٌ وَضُلوعٌ","نافِجاتُ الحِجابِ وَالحَيزومِ",38,"م",1,0],["وفقدت أهلي والصديق وقد غدا","دمعي حميمي والسهاد ضجيعي",39,"ع",2,0],["وفقد خشوع للفوائد جالب","وأعظم من فقديه فقد تأسفي",40,"ف",2,0],["وُفِّقْتُمُ فُقْتُمُ صَعِدْتُمْ","أُيِّدْتُمُ صِنْتُمُ سَعِدْتًمْ",41,"م",1,0],["وفقيرٌ لِغَنىً حاسدٌ","وغنىٌ يستذلَّ الفقراء",42,"ا",2,0],["وفّقت للخير حيث السير لاح له","سناء وجهٍ بنور القرب منكشف",43,"ف",1,0],["وُفِّقتَ حين رَفضتَ ألأَمَ منزلٍ","ورقيتَ من عُليا الجنان ذُراها",44,"ا",3,0],["وَفَقّوسةٍ مُصفرّةِ اللّونِ أُنبِتَت","بِسبخةِ زور فهيَ مرٌّ مَذاقها",45,"ه",2,1],["وفقد الهدى عند الورى لا يفيد من","غدا عنه بل يجزى بلا وجه حجة",46,"ه",1,0],["وَفَّقَ اللَهُ عاقِلاً قَدَّرَ العَي","شَ فَرَأسُ المَعيشَةِ التَقديرُ",47,"ر",1,1],["وفقَدتُ الوَجدَ فيها والأَسى","فتَألَّمتُ لفقدانِ الألَم",48,"م",1,0],["وفقت الرسل والأبرار طرّاً","بغيرتك التي فيها ولدتِ",49,"ت",1,0],["وفقت مناسك النساك طرّاً","سهرت ثم صليت وصمتِ",49,"ت",1,0],["وفق وسدد واصلح ما بطن أو ظهر","واختم بخير إذا حان الظعن والسفر",50,"ر",1,0],["وفقده الأشعار والفرائد","وجمع ما يقيمه شواهد",51,"د",1,0],["وفَقَدْتُ منه فرائداً وفوائداً","ومكارماً ومغانماً وهباتا",52,"ت",2,0],["وفَقَدْتُ مستند الرجال إذا روت","عنه الثقات مكارم الأَخلاق",53,"ق",1,0],["وفَقَدتُ صبري بعدهم","لا ذاقَ من أهواه فقدا",54,"د",2,0],["وُفِّقت للفعل الجميل وصنعه","إنَّ الموفّق للجميل موفَّق",55,"ق",1,0],["وفقني اللهم حج البيت وأق","بل ما سعيت وما عليه أؤسس",56,"س",1,0],["وفقني اللَه توباتٍ إليك بها","أدنو ولا تجعلني من بها شسعا",57,"ع",2,0],["وفقني اللَه اعمالا رضيت بها","مرضاتك اللهم يا مولاي مرضاتي",58,"ت",2,0],["وفقر شامل وغنى","ومنجاة ومنهدف",59,"ف",1,0],["وفقر عم كل النا","س عند الصدمة الأولى",60,"ا",1,0],["وفقيرٍ عَصَفَ المَحْلُ به","شامَ نُعْماهُ فأعْطى وبَذَلْ",61,"ل",1,1],["وفُقْتَ بني النَّدى والبأسِ حتى","حَسوداك الصَّوارِمُ والغَمامُ",62,"م",1,0],["وفقيهٍ بدا فعاينت منهُ","وجهَ سوء أليَّ غير حبيب",63,"ب",1,1],["وفقدْنا تلكَ الوُجوهَ فمِتْنا","ووَجَدْنا منها البُدورَ فطِبْنَا",64,"ن",2,0],["وفقدت السلو فقد رقادي","فتراني مراقب السرحان",65,"ن",1,0],["وفَقرُ نفُوسٍ لو هُمُ يعلَمُونَه","بِحقٍّ لَدام الطَّرفُ منهُمُ دامِيا",66,"ي",2,0],["وَفقَ ما شئتَ كلُّنا نتَمَشَّى","ولدَى ما تُحِبُّ نَبقى قِياما",67,"م",2,0],["وفقدُ النّساءِ كفقدِ الرّجال","يحزّ إذا حزّ أو يقطعُ",68,"ع",1,0],["وَفقدُ الصَّديقِ المَحض صَعْبٌ فَكيفَ بي","وفقدي صديقاً من أجلّ أقاربي",69,"ب",2,0],["وفق من خمار النفس وابق به له","تَصِر صاحياً صحواً شديداً على طلق",70,"ق",1,0],["وفقه الهوى فرض على القوم درسه","وكم ناله شيخ وكهل ويافع",71,"ع",1,0],["وفقتُهمْ بالكمالِ وليعلم ال","خلقُ بأَنَّ الكمالَ بي فَائِقْ",72,"ق",1,0],["وف