2,"قَريباً يا حبيبي سوْفَ تُمْطِرْ","https://www.poetsgate.com/ViewPoem.aspx?id=184821",""],[5688,"سلّم لربك","https://www.poetsgate.com/ViewPoem.aspx?id=200911",""],[5691,"بيادق","https://www.poetsgate.com/ViewPoem.aspx?id=206042",""],[5703,"دموع ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=210731",""],[5830,"سَلامٌ لِعَيْنَيْنِ","https://www.poetsgate.com/ViewPoem.aspx?id=201123",""],[5937,"مأوى العطور","https://www.poetsgate.com/ViewPoem.aspx?id=211811",""],[5956,"شقاء الشوق ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181907",""],[5956,"سُهيلة تحتل تخت سواها","https://www.poetsgate.com/ViewPoem.aspx?id=182534",""],[5956,"فتش عن العفيفة","https://www.poetsgate.com/ViewPoem.aspx?id=184330",""],[5956,"وكنتُ أعي التوائي في الصعودِ","https://www.poetsgate.com/ViewPoem.aspx?id=186211",""],[6142,"هي المضامير إن توجف مذاكيها","https://www.poetsgate.com/ViewPoem.aspx?id=155708",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""],[6152,"حياة روحي","https://www.poetsgate.com/ViewPoem.aspx?id=204437",""],[5309,"يؤمن بالأوهام غر جهول","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573898",""],[520,"فلا تقل غرة الدنيا مطامعها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577545",""],[6218,"يقرّبُ حبُّ الناس حتفي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77480&r=&rc=66",""],[119,"إلهي مسني كرب عظيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55614&r=&rc=11",""],[5126,"صورة منّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87799&r=&rc=14",""]],"verses":[["فَلا تَقرَبَنَّ الغابَ يَحميهِ لَيثُهُ","وَدَع جانِباً وَعراً عَلى مَن يَحُلُّهُ",0,"ل",2,0],["فَلا تَقرِنا ظَنّي بِظَنِّ مُسَفَّهٍ","يَظُنُّ بِوَقعِ الأَثرِ في غُرَّةِ البَدرِ",1,"ر",1,0],["فَلا تَقبَلي يا عَذبَةَ الرِّيقِ ما حَكى","عَذولٌ وَلا تُرعي المَسامِعَ واشِيا",2,"ي",2,0],["فَلاَ تَقْنَ مَا يَفْنَى تَعِشْ وَادِعَ الْحَشَا","أبى الدَّهْرُ أَنْ يُبْقِي عَلَى الدَّثِرِ الفَانِي",3,"ن",2,0],["فَلا تَقْنَ ما يَجْني علَيْكَ ذَهابُهُ","وإنْ كان مُعْتَدّاً بهِ ضُرَّ مُعْتَدي",4,"د",2,0],["فلا تقسه بغير أدباً","وهل تقاس المعطار بالتفله",5,"ل",2,0],["فَلا تَقبَلوا ضَربَ الفَرَزدَقِ إِنَّهُ","هُوَ الزيفُ يَنفي ضَربَهُ كُلُّ ناقِدِ",6,"د",1,0],["فَلا تَقنَعِ العامَ في دارِهِم","وَلا أُستَهَدُّ وَلا أُنكَلُ",7,"ل",1,0],["فلا تقربَا هذا النسيمَ فإنَّه","إذا هبَّ كان الموت أيسر خطبه",8,"ه",1,0],["فلا تقرنوه بالخليليّ آكلاً","فحاشكمُ أن تقربوا المنّ بالأذى",9,"ذ",2,0],["فلا تَقْبَلنَّ أماديحَه","حرامٌ نِكَاحُ بناتِ الأخِ",10,"خ",1,0],["فلا تَقْبَلُوا ذاك التفارق واحْذَروا","شَبَاه ولو أمسى مُسجّىً على نعش",11,"ش",1,0],["فلا تَقْدرْ بقدركَ لي نوالاً","ولا قَدرِي فتحقِرُ ما تُنيل",12,"ل",1,0],["فَلا تَقعُدَن عَن طِلابِ العُلى","وَتعذِل بِلادَكَ إِذ تَعذِلُ",13,"ل",1,0],["فَلا تَقبَلوا لِلدَمعِ عَنّي رِوايَةً","فَلَيسَ عَلى سِرِّ الهَوى بِأَمينِ",14,"ن",1,0],["فَلا تَقرَعوا بِالعَتبِ قَلبي فَإِنَّهُ","وَحَقِّكُمُ مِثلُ الزُجاجِ صَديعُ",15,"ع",1,0],["فَلا تَقتُلكَ شَهوَتُهُ وَزِنها","كَما تَزِنُ الطَعامَ أَوِ الشَرابا",16,"ب",2,0],["فلا تقبلي ما قيلَ عني لديكمُ","فان تخاليطَ الوُشاةِ فُنونُ",17,"ن",1,0],["فَلا تَقبَلوا مِنهُ أَباعِرَ تُشتَرى","بِوَكسٍ وَلا سوداً تَصِحُّ فُسولُها",18,"ل",3,0],["فلا تقولي : يا لهذا الفتى","أخبر عني المنحنى والغدير",19,"ر",1,0],["فَلا تَقرَبا مِني وَأَنتَ صَديقَهُ","فَإِنَّ الَّذي بَينَ القُلوبِ بَعيدُ",20,"د",1,0],["فلا تقطعوا عنّا سطورَ رسالةٍ","تُمَثِّلُ لي أشخاصَكُمْ في سماعها",21,"ع",3,0],["فَلا تَقتُليني إِن رَأَيتِ صَبابَتي","إِلَيكِ فَإِنّي لا يَحِلُّ لَكُم قَتلي",22,"ل",2,0],["فَلا تَقتُليني بِالصُدودِ وَبِالقِلى","وَمِثلُكِ يا لَيلى يَرِقُّ وَيَرحَمُ",23,"م",1,0],["فَلا تَقتُليني أُمَّ مالِكَ عَنوَةً","وَأَنتِ عَلى عُتقي الغَداةَ قَديرُ",24,"ر",1,0],["فَلا تَقبُروني إِنَّ قَبري مُحَرَّمٌ","عَلَيكُم وَلَكِن خامِري أُمَّ عامِرِ",25,"ر",1,1],["فلا تَقْبَلْ مِنَ النُّوَّابِ عُذْراً","ولا النُّظَّارِ فِيما يُهْمِلُونا",26,"ن",2,0],["فلا تَقْبَلْ عَفاف المَرْ حَتَّى","تَرَى أتْباعَهُ مُتَعَفِّفِينا",26,"ن",2,0],["فَلا تَقتُلهُ بِالسَيفِ","وَزَوِّجهُ بِعَبّاسَه",27,"س",2,0],["فَلا تُقِرُّ بِمَجدٍ لِاِمرِئٍ أَبَداً","إِن كُنتَ بِاللَهِ رَبَّ النَيّراتِ تُقِرّ",28,"ر",1,0],["فَلا تَقبَلَن ما يُخبِرونَكَ ضِلَّةً","إِذا لَم يُؤَيِّد ما أَتوكَ بِهِ العَقلُ",29,"ل",1,0],["فَلا تُقرِ هَمَّ النَفسِ عَجزاً عَنِ القِرى","وَأَدلِج إِذا ما الرَكبُ مالَ طُلاهُ",30,"ل",3,0],["فلا تقفوا بحريَّاتِ شَعْبٍ","وآمالٍ له للمجدِ تصْبو",31,"ب",2,0],["فلا تقولن بغت مروانُ","ووطأ الملك لها العدوانُ",32,"ن",1,0],["فَلا تَقْعُدَنْ لِلدَّهْرِ تَنْظُرُ غِبَّهُ","عَلَى حَسْرَةٍ فَاللَّهُ مُعْطٍ وَمَانِعُ",33,"ع",1,0],["فَلاَ تَقْلبَا لي من حياتيَ صفحَةٌ","وإن كُتبتْ بالمِسْكِ أذْفَرَ ذاكيا",34,"ي",2,0],["فلا تقن ما يجني عليك ذهابه","وإن كان معتدا به ضر معتد",35,"د",1,0],["فلا تقنطوا من غاية المجد لا يرى","لها العقل إمكانا فقد ينبع الصخر",36,"ر",1,0],["فَلا تَقعُدَن عَن سَعيِ ما قَد وَرِثتَهُ","وَما اِسطَعتَ مِن خَيرٍ لِنَفسِكَ فَاِزدَدِ",37,"د",1,0],["فَلا تَقعُدَنَّ عَلى زَخَّةٍ","وَتُضمِرَ في القَلبِ وَجداً وَخيفا",38,"ف",2,0],["فلا تقطع حبال الغوث عني","ابا العلمين يا شيخ العواجز",39,"ز",1,0],["فلا تقطع ابا الفتيان حبلي","وخذ بيدي وكن فضلا ظهيري",40,"ر",2,0],["فلا تقعدن حلس البطالة غافلا","ولا ترغبن في العجز يوما عن الطلب",41,"ب",1,0],["فلا تقطعن حبلي ولا تجعل الجفا","نصيبي وإن ضيقت رحب الفلا وزرا",42,"ر",2,0],["فَلاَ تَقُل في بُطئِهِ فِيمَ ذَا","وَلاَ تَقُل في نَقصِهِ ذَا لِمَه",43,"ه",1,0],["فَلا تَقبَلَنَّ الدَهرَ ما عِشتَ خُطَّةً","تُسَبُّ بِها إِمّا هَبَطتَ المَواسِما",44,"م",2,0],["فلا تقطِفنّ ثمارَ المُنى","فبئسَ عُصارةُ أعنابها",45,"ب",3,0],["فلا تقبلوها منه يعلم بانها","أكفُّ الندى لا تنثنى حين تمتدُّ",46,"د",1,0],["فلا تقطعن حبل التواصل بينكم","وابق على العهد القديم المراسما",47,"م",2,0],["فلا تقعدنكم دونه ضعف همة","فدون العلا يستسهل المركب الصعب",48,"ب",1,0],["فلا تقيس أحمدا بغيره","فليس بلق الخيل مثل الحمر",49,"ر",1,0],["فَلا تَقطَعَن ما بَينَنا مِن مَوَدَّةٍ","وَقُربى وَخَلِّ الشِعرَ فَالشِعرُ كاسِدُ",50,"د",1,0],["فَلا تَقعُدَن مُحبَنظِئاً خَوفَ مِيتَةٍ","سَتَأتي فَما تَلقى جَواداً مُخَلَّدا",51,"د",2,0],["فلا تقسه بمن لاقيت ان له","سيفا ي