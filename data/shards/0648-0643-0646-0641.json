{"poems":[[90,"أرى للروح بالبدن اتصالا","https://www.aldiwan.net/poem45062.html","الوافر"],[87,"وجدت الحياة طريق الزمر","https://www.aldiwan.net/poem8073.html","المتقارب"],[45,"أيا خدد الله ورد الخدود","https://www.aldiwan.net/poem9535.html","المتقارب"],[60,"العلم زين فكن للعلم مكتسبا","https://www.aldiwan.net/poem30998.html","البسيط"],[82,"ألا كم تسمع الزمن العتابا","https://www.aldiwan.net/poem31566.html","الوافر"],[50,"تمتع بالخمورِ وباللواط","https://www.aldiwan.net/poem66612.html","الوافر"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[92,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[132,"وإن شئت استباحة كل أمر","https://www.aldiwan.net/poem50575.html","الوافر"],[132,"أرى الدنيا وزخرفها غرورا","https://www.aldiwan.net/poem50617.html","الطويل"],[189,"أرى الشر طبع نفوس الأنام","https://www.aldiwan.net/poem14667.html","المتقارب"],[190,"إذا كنت في معشر نازلا","https://www.aldiwan.net/poem43199.html","المتقارب"],[203,"عرش بطول مدار السبعة الشهب","https://www.aldiwan.net/poem45349.html","البسيط"],[242,"ألا قل لمن يبغي إلى العز منفذا","https://www.aldiwan.net/poem18189.html","الطويل"],[266,"تباعد عن دنئ دنيوي","https://www.aldiwan.net/poem38350.html","الوافر"],[302,"ألا هل درت من أقصدت أسهم الهلك","https://www.aldiwan.net/poem33202.html","الطويل"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[382,"نصحتك نصحا قل من شأنه النصح","https://www.aldiwan.net/poem66888.html","الطويل"],[396,"ياطالبا للوصيه","https://www.aldiwan.net/poem54448.html","عموديه"],[469,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[473,"دع ماء وجهك فيه لا ترقه فما","https://www.aldiwan.net/poem59938.html","البسيط"],[534,"أرى عمر هذا الشخص في الأصل قدره","https://www.aldiwan.net/poem37350.html","الطويل"],[563,"نحن معاني الوجود فيه","https://www.aldiwan.net/poem33671.html","مخلع البسيط"],[563,"خذوا علمكم بالله لا تتأخروا","https://www.aldiwan.net/poem34489.html","الطويل"],[569,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[572,"رأيت تتابع الأعمال أجدى","https://www.aldiwan.net/poem69610.html","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70911","المنسرح"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119326","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112959","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112751","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112735","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112860","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112818","الطويل"],[1695,"","https://poetry.dctabudhabi.ae/diwan/poem/144208","المتقارب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28026","الوافر"],[2236,"","https://poetry.dctabudhabi.ae/diwan/poem/203577","الوافر"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102505","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83211","الوافر"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113874","الرجز"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112301","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86292","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91959","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92112","الوافر"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132115","المتقارب"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117950","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131196",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114418","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135186","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95331","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81718","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133065","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58179","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57984","الطويل"],[4927,"الْعُشَّاْقُ وَ الطُّغَاْةُ","https://www.poetsgate.com/ViewPoem.aspx?id=29728",""],[4927,"الْحُبُّ وَ الْوُشَاْة","https://www.poetsgate.com/ViewPoem.aspx?id=29735",""],[5038,"فم الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=188382",""],[3749,"من لم يسل عنك فلا تسألن","https://www.poetsgate.com/ViewPoem.aspx?id=134964",""],[5277,"هجاءُ البدر","https://www.poetsgate.com/ViewPoem.aspx?id=192282",""],[5431,"لتروي قيظ أفكارٍ عطاشِ","https://www.poetsgate.com/ViewPoem.aspx?id=198371",""],[5550,"يا ابن الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=211770",""],[5550,"لماذا","https://www.poetsgate.com/ViewPoem.aspx?id=211905",""],[5720,"بنورِ العلم","https://www.poetsgate.com/ViewPoem.aspx?id=200302",""],[572,"رأيتُ تَتَبُهَ الأَعمالِ أَجدَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9376&r=&rc=233",""]],"verses":[["وكن في المُطربات فتىً طروباً","فإن الناس أطربُها الكريم",0,"م",1,0],["وَكُن في الطَريقِ عَفيفَ الخُطا","شَريفَ السَماعِ كَريمَ النَظَر",1,"ر",1,0],["وَكُن فارِقاً بَينَ دَعوى أَرَدتُ","وَدَعوى فَعَلتُ بِشَأوٍ بَعيدِ",2,"د",1,0],["وَكُن فَتىً ماسِكاً مَحَضَ التُّقى وَرِعاً","لَلدّينِ مُغتَنِماً لِلعِلمِ مُفتَرِسا",3,"س",2,0],["وكن في جانبِ التحريض ناراً","تزيدُ بنفحةِ الرّيحِ التهابا",4,"ب",2,0],["وكن في اللهو مهتوكاً خليّاً","سليمَ الحلمِ محلولَ الرباطِ",5,"ط",1,0],["وكن في طريق الاستقامة حاذرا","كمين الاعادي فالشجاع حذور",6,"ر",1,0],["وكنْ فيما اندفَعْتَ شِعارَ جيلٍ","حثيثِ الخطو يأبَى الإرتجاعا",7,"ع",2,0],["وكنْ في الأمر ذَا فَهمِ وحِلم","ولا تظهر لشانيك الخضُوعا",8,"ع",2,0],["وكنْ في الحلم رضوَى لا تبالى","وكُنْ للثقل محتملا ضَليعَا",8,"ع",2,0],["وكنْ في اللهِ مجتهداً مطيعَا","له فيما يشاءُ ومُستجيرَا",9,"ر",2,0],["وكن في حياتك كالمُبتغِي","من السوق زادا لبُعْد المَرام",10,"م",1,0],["وكن فطنا عند ذي المشكلات","وكن سامعا فاضلا عاقلا",11,"ل",2,0],["وكنَّ في مضضٍ لم يألها وأجاً","واليومَ طبْنَ ولولا أنتَ لم تطبِ",12,"ب",1,0],["وَكُنْ فِي حُزُونِ الدِّينِ تُكْسَ بِعِزَّةٍ","فَإِنَّ أَعَزَّ النَّبْتِ مَا كَانَ عُوَّذَا",13,"ذ",2,0],["وكن فيما ابتليت به حليف صبر","فإن الداء يسهل بالعلاج",14,"ج",1,0],["وَكُن في صُروف الدَهر كالذهب الَّذي","يَزيدُ عياراً كلَّما زيد في السَبكِ",15,"ك",1,0],["وكن في أحاديث الصفات وآيها","على مذهب الأسلاف حيث السلامة",16,"ه",1,0],["وكن في سلوك الإبن كلك أعيناً","تراقبه فالسيل أوله رشح",17,"ح",1,0],["وكن في الخير راغب فعلا وقولا ونيه","وقم بحق الأقارب وكل جار وصاحب",18,"ب",1,0],["وكنفت جدولَ سيفهِ","لا بالأصمّ ولا المهنَّد",19,"د",1,0],["وَكُن فَتىً وَزَنَ الدُنيا بِهِمَّتِهِ","فَما يَفي حُبُّها بِالذُلِّ لِلناسِ",20,"س",1,0],["وكُنْ فَطِناً تَظْفَرْ بما رُمْتَ حَلَّهُ","وإلا فَكُنْ عَنْ حَلِّ ذا الرَّمْزِ مُعْرِضا",21,"ض",2,0],["وكن فهيماً وعَى كلامي","وعدِّ عن كل ما تعيه",22,"ي",2,0],["وكن فيكون الشيء يوجد نسبة","إليه بلا استقلاله حين يؤمر",23,"ر",1,0],["وكن فيهمو ذا سيرةٍ عمرية","فانك عنهم سوف والله تسأل",24,"ل",1,0],["وَكُنْ فِي كُلِّ ذَاكَ عَلَى يَقِيْنٍ","بِأَنَّ الصَّرْفَ يَحْدُثُ بَعْدَ سَاعَهْ",25,"ع",2,0],["وكن فتىً مستغْفِراً ما انْجلت","غياهبُ الليل وبانت يَراحْ",26,"ح",1,0],["وكن في شديد الباس للناس رحمة","أعف نطاسي يرى الفسق موبقا",27,"ق",2,0],["وكن في حسن آداب وحب","ولاحظ مع محبتك الجلاله",28,"ل",2,0],["وكن في الدنا والاخرى يا سيدي له","وِق الضر واحفظه من الهول والسقم",29,"م",1,0],["وكن في كل حال وارحمن يا","اله العرش أن دهمت حروب",30,"ب",1,0],["وكن في جميع الدهر يا سيدي له","وعمم له اصلا وفرعا واهله",31,"ل",2,0],["وكن في خضوع ما استطعت لفتية","أنابوا له واستعذبوا نهج سنة",32,"ه",1,0],["وكن في دفاع الأذى ناظراً","إليها إذا ركبت مركبا",33,"ب",2,0],["وكن في القلبِ منه تكن إماماً","إذا تدعو جحا حجةُ النزال",34,"ل",1,0],["وكن في ذي المذاهب مالكياً","مدينياً وسنياً متينا",35,"ن",2,1],["وكن فانياً مستهتراً في مرادنا","فما نال لذّة وصلنا معرض عنا",36,"ن",2,0],["وَكُن فَذّاً تُثيرُ التُربَ مِنها","وَبِالتُرنوقِ خَصِّبْ مَشجِراتِ",37,"ت",1,0],["وكن فتى يسعى إلى الأسعاد","ولا تكن مثل ابن عبد الهادي",38,"ي",1,0],["وَكُن فَطِناً يا مَن مَلَكَتَ عنانها","إِذا جَمَحَت مادَت بهَا الأرضُ جانبَا",39,"ب",2,0],["وَكُن في الخَير معواناً لِخَلق","فَتَخفِق بَالثَنا لَكَ كُل رايَه",40,"ا",3,0],["وَكُن فَطناً اخالب ذَكِيّاً","عَن التَصريحِ تَكفيكَ الكِنايَه",40,"ا",3,0],["وَكُن في الناس مثلَ الناس دوماً","جَميلَ الذكر مَألوفَ الخصال",41,"ل",1,0],["وكن في اللَه ذا نفع وضرٍّ","ولا تخش الخواطر إن حكمتا",42,"ت",2,0],["وكن في المسير كنحل القفير","فما تستريح ولا تفتر",43,"ر",1,0],["وكن في الحياة كليث الفلاة","فإن الضعيف بها يخسرُ",43,"ر",1,0],["وكن فيمن تركت قرير عين","فإن الكأس في يد خير ساقي",44,"ق",2,0],["وكن في الأسى جلدا فقبلي قد قضى","غطاريف لا ينفكّ يبكيهم العصر",45,"ر",1,0],["وكُن فيما أتيتَ لنا مُطيعاً","كأنكَ في الذي تأتي ترانا",46,"ن",2,0],["وكن في أموري كلِّها لي دائماً","فعلمك بي كافٍ لك الخلقُ والأمرُ",47,"ر",1,0],["وكنف الراعي كنيفا للغنم","تعنى حظيرة وزيد قد عجم",48,"م",1,0],["وكنْ في مديحِ المصطفى كمدبّجٍ","يقلّب كفَّيْهِ بخيطٍ مُوَصَّل",49,"ل",1,0],["وكن فيهم كميتٍ في امتثالٍ","وأفن النفس طوعاً في رضاهم",50,"م",1,0],["وكن فتًى معتَبراً بما مضى","كَيْلا تكونَ عبرةً لمن بَغَى",51,"غ",2,0],["وكن فاعلَ التقوى وممِنَّ سَعى بها","ونفسَك عن كلِّ المكارهِ صَابِها",52,"ب",3,0],["وَكُنْ فِي الْحُبِّ شَهْماً أَلْمَعِياًّ","وَلاْ تَسْقُطْ عَلَىْ أُمِّ الدِّمَاْغِ",53,"غ",1,0],["وَكُنْ فِي الْحُبِّº وَ الْبَغْضَاْءِ شَهْماً","كَرِيْماً عَاْشِقاً دُوْنَ انْكِمَاْشِ",54,"ش",1,0],["وَكُنْ في كُلِّ حادِثَةٍ صَبوراً","إذا ما عَزَّ في الدُّنْيا النّصيبُ",55,"ب",1,0],["وكن فتى لم تدعه حاجة","إلى امتهان النفس إلا نفر",56,"ر",1,0],["وكنْ فطِناً ولا تجهرْ بقولٍ","جزافاً , فالخلاصُ من المحالِ",57,"ل",1,0],["وكن في جوهر الأفكار متنا","ولاتطمح لمرتبة الحواشي",58,"ش",2,0],["وكُنْ في كلِّ أمْر ذا كِفاح","وَ صبْر منْ حَديدٍ واعْتزام",59,"م",1,0],["وكُنْ في العَيْش عونًا لليَتامى","وفكرْ في الذين بلا طعام",59,"م",1,0],["وكنْ في مسيركَ دوما جلودًا","فلا يدْركُ المجدَ غير الجَلود",60,"د",1,0],["وكنْ في ساحةِ الهيجاءِ جَلْدَاً","تناضلُ .. للوصول إلى الكمالِ",61,"ل",1,0],["وكن في كلّ ذاكَ على يقينٍ","بأنَّ الصدقَ يحدثُ بعدَ سَاعَهْ",62,"ع",2,0]]}