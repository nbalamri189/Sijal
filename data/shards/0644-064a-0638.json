{"poems":[[90,"علام حرمنا منذ حين تلاقيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19520&r=&rc=23",""],[141,"الحمد لله ولي الحمد","https://www.aldiwan.net/poem67916.html","الرجز"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[369,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[422,"أبا مصطفى زوجت بالخير والهنا","https://www.aldiwan.net/poem53884.html","الطويل"],[443,"أقيموا عمود الدين للّه تسعدوا","https://www.aldiwan.net/poem2621.html","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112928","الوافر"],[1718,"","https://poetry.dctabudhabi.ae/diwan/poem/44755","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27956","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205057","الوافر"],[3145,"","https://poetry.dctabudhabi.ae/diwan/poem/128318","الكامل"],[4680,"قمرٌ يُطلّ بوجهه ويغيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=192912",""],[5072,"قلب ٌ غزاها","https://www.poetsgate.com/ViewPoem.aspx?id=51897",""],[5072,"نجاة الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=52564",""],[5277,"ظلُّ وجهِها","https://www.poetsgate.com/ViewPoem.aspx?id=192545",""],[5431,"الحب دربٌ آمنٌ","https://www.poetsgate.com/ViewPoem.aspx?id=201942",""],[5431,"استنساخ!","https://www.poetsgate.com/ViewPoem.aspx?id=202923",""],[5431,"إقرأ ....","https://www.poetsgate.com/ViewPoem.aspx?id=206810",""],[5431,"قصيدة وجودية ...","https://www.poetsgate.com/ViewPoem.aspx?id=207830",""],[5842,"يا أيها المسجون في عشق الأنا / محمد حسام الدين دوي","https://www.poetsgate.com/ViewPoem.aspx?id=136246",""],[5943,"هديل الخير","https://www.poetsgate.com/ViewPoem.aspx?id=53803",""],[6318,"السهم الأخير وفتىًُ يفَجَّر نفسَهَّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66168&r=&rc=18",""],[6344,"غُرباء يُعاندون الخطوات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87965&r=&rc=5",""]],"verses":[["ليظهر إلا في سوى الشعر باكيا","ركبت بحور الشعر رهواً ومائجاً",0,"ا",1,0],["لِيُظهِرَ اللَهُ بِذاكَ الدينا","وَقَد جُعِلنا قَبلُ مُشرِكينا",1,"ن",2,0],["ليظهرَ كونُ الفضلِ في الناس كلّهم","بِنسبةِ جزءِ الجزءِ من فضلهم نزرا",2,"ر",2,0],["ليظلَّ كُلُّ من أنامِلهِ","بمَحلّهِ المَخْصوصِ يَتّسِم",3,"م",1,0],["ليظهَرَ فيه الله أسرار جدِّه","وقد لاح للأبصار ما فيه من سنا",4,"ن",2,0],["ليظهر أن الحق حقّ محمد","وكلّ بني بالذي قلت يشهد",5,"د",1,0],["ليظهر فضلكم فينا","ونحسن فيكم القالا",6,"ل",2,0],["لِيَظَلَّ الفرعُ مِنّي ظاهِراً","وَيَروِّي الأَصلَ مِنّي العَطَشا",7,"ش",2,0],["ليظهر آياتٍ ويبدي عجائبا","لناظره حتى إذا ما انتهى فاء",8,"ا",2,0],["ليظهر للورى أني غبي","وفكري إن يرم نظما كليل",9,"ل",1,0],["ليظلّ قلبي من مخافة بيتكم","مثل الجناح معلقا في نفنف",10,"ف",1,0],["ليظلّ يذكي بي لواعجَ لهفةٍ","ما دام ينبض بالفؤاد وجيبُ",11,"ب",1,0],["ليظل َّ يبكي في هواك َ وفي يدي","قلم ٌ به حبر ُ الهموم ِ مُدامُها",12,"م",3,0],["لِيَظَل َّ يبتسم ُ الجمال ُ على يدي","وذهول ُ شعري في شُروقِك ِ مذهل ُ",13,"ل",1,0],["لي ظلُّ وجهك أتلوه وقد كبرتْ","من عشقِ كلّ ظلالٍ فيك مرساها",14,"ا",3,0],["ليظلّ ربا حاكما","جعل الرعيّة في شيعْ",15,"ع",1,0],["ليظلّ محفورا كلوحٍ خالدٍ","في كلّ أمشاج الهوى يترسخُ",16,"خ",1,0],["ليظلّ نعلي في الثرى متفرّدا","والرأس في جوزائه متباعدا !!",17,"د",2,0],["ليظلّ في جُزُر الهوى أبدا","وبشطّك النوري لا يلحق!",18,"ق",1,0],["ليظلّ في قيعان نائية","مقلى على وجدٍ هو الأصدق",18,"ق",1,0],["ليظلّ في عليائه متمسكاً","بخيوطها والوهم لا يتحقق",19,"ق",1,0],["-ليظلَّ سجنَ شعوبنا-","إلا كريمٌ مستطيعْ",20,"ع",1,0],["ليظَلَّ يَشْهَدُ أن أمّتنا هَوَتْ","وغَفَتْ وأطْبَقَ فوْقَ ذلك غيْهَبُ",21,"ب",1,0],["لِيَظَلَّ وَاحِدُهُمْ يَمُرُّ لِوَحْدِهِ","وَيَرَاهُ فِي عَينِ التَّلَفُّتِ أَلْفَا",22,"ف",2,0]]}