{"poems":[[88,"علام حرمنا منذ حين تلاقيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19520&r=&rc=23",""],[138,"الحمد لله ولي الحمد","https://www.aldiwan.net/poem67916.html","الرجز"],[190,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[365,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[417,"أبا مصطفى زوجت بالخير والهنا","https://www.aldiwan.net/poem53884.html","الطويل"],[438,"أقيموا عمود الدين للّه تسعدوا","https://www.aldiwan.net/poem2621.html","الطويل"]],"verses":[["ليظهر إلا في سوى الشعر باكيا","ركبت بحور الشعر رهواً ومائجاً",0,"ا",1,0],["لِيُظهِرَ اللَهُ بِذاكَ الدينا","وَقَد جُعِلنا قَبلُ مُشرِكينا",1,"ن",2,0],["ليظهرَ كونُ الفضلِ في الناس كلّهم","بِنسبةِ جزءِ الجزءِ من فضلهم نزرا",2,"ر",2,0],["ليظلَّ كُلُّ من أنامِلهِ","بمَحلّهِ المَخْصوصِ يَتّسِم",3,"م",1,0],["ليظهَرَ فيه الله أسرار جدِّه","وقد لاح للأبصار ما فيه من سنا",4,"ن",2,0],["ليظهر أن الحق حقّ محمد","وكلّ بني بالذي قلت يشهد",5,"د",1,0]]}