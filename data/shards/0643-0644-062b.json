{"poems":[[53,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[46,"هل أثر من ديارهم دعس","https://www.aldiwan.net/poem30492.html","المنسرح"],[327,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[469,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129542","المديد"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82253","السريع"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104975","الرجز"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136921",""],[5952,"أيها الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=202282",""],[5952,"ما ودَّعَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=203725",""],[6093,"دَعِ التماسَ الهوى مِنْ ظبية الآس (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176196",""]],"verses":[["كلُّ ثفر فله شُحنته","هكذا كان قَضى من شَحنه",0,"ن",2,0],["كُلُّ ثَمينٍ مِنَ الثَوابِ بِهِ","غَيرُ ثَنائي فَإِنَّهُ بَخسُ",1,"س",1,0],["كُلُّ ثاوٍ يَثوي لِحينَ المَنايا","كَجَزورٍ حَبَستَها بِعِقالِ",2,"ل",1,0],["كلِّ ثاني السيف لحظاً وهوىً","وشقيقِ الروح قدّاً وتثنّي",3,"ن",2,0],["كل ثوب أنت لابسه","يستحيك الدهر من قصره",4,"ر",2,0],["كلثمُ أَنتِ الهَمُّ يا كَلثَمُ","وَأَنتمُ دائي الَّذي أَكتُمُ",5,"م",1,1],["كل ثنائي عن معانيه التي","جلَّت وإن كانت من السحر أدق",6,"ق",1,0],["كلُّ ثوبٍ على صغيرٍ جديدٌ","ما خلا ثوبه العتيق الحقيرا",7,"ر",2,0],["كل ثاوٍ لنا ثوىْ فوق جَمرٍ","كل عالٍ لنا يخر نزولا",8,"ل",2,0],[".كلُ ثَديٍ قدْ قَسْا قَبْلاً نَضَا","فلتقلْ لي قسوةً من أرضعك!",9,"ك",1,0],["5. كلثومةُ الخدِّ إنْ تَفْتَرَّ ضاحكةً","يفْترَّ ثَغْرُ اللمى عنْ عِقْدِ المَاسِ",10,"س",1,0]]}