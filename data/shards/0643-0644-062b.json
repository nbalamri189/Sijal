{"poems":[[51,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[44,"هل أثر من ديارهم دعس","https://www.aldiwan.net/poem30492.html","المنسرح"],[320,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[462,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"]],"verses":[["كلُّ ثفر فله شُحنته","هكذا كان قَضى من شَحنه",0,"ن",2,0],["كُلُّ ثَمينٍ مِنَ الثَوابِ بِهِ","غَيرُ ثَنائي فَإِنَّهُ بَخسُ",1,"س",1,0],["كُلُّ ثاوٍ يَثوي لِحينَ المَنايا","كَجَزورٍ حَبَستَها بِعِقالِ",2,"ل",1,0],["كلِّ ثاني السيف لحظاً وهوىً","وشقيقِ الروح قدّاً وتثنّي",3,"ي",1,0]]}