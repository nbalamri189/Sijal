{"poems":[[55,"زار والركب حرام","https://www.aldiwan.net/poem29819.html","مجزوء الرمل"],[90,"مني إلى مصر ذات المجد والحسب","https://www.aldiwan.net/poem44801.html","البسيط"],[94,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[47,"عارضننا أصلا فقلنا الربرب","https://www.aldiwan.net/poem10644.html","الكامل"],[107,"لا اليوم يومك إذ ولدت ولا الغد","https://www.aldiwan.net/poem41933.html","الكامل"],[107,"خلت المنازل منك والأوطان","https://www.aldiwan.net/poem41941.html","الكامل"],[107,"نظم المجد لأبطال الحمى","https://www.aldiwan.net/poem42072.html","الرمل"],[107,"اذكرونا في الملمات الكبر","https://www.aldiwan.net/poem42099.html","الرمل"],[107,"جددوا الذكرى لأهل المشرق","https://www.aldiwan.net/poem42122.html","الرمل"],[107,"سيد الرسل وأم المؤمنين","https://www.aldiwan.net/poem44196.html","الرمل"],[107,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[107,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[17,"لم يقض من حاجة الصبا أربا","https://www.aldiwan.net/poem1189.html",""],[52,"هجر الوساد فبات غير موسد","https://www.aldiwan.net/poem63886.html","الكامل"],[108,"مبايعة الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179496",""],[135,"جاشت إلي النفس في يوم الفزع","https://www.aldiwan.net/poem24001.html","الرجز"],[242,"جاشت بلابلنا وسال واديها","https://www.aldiwan.net/poem19726.html","البسيط"],[280,"وعلى حفصية فهرية","https://www.aldiwan.net/poem25587.html","الرمل"],[287,"رموا الجمار وفي فؤادي منهم","https://www.aldiwan.net/poem32451.html","الكامل"],[287,"تبنى الممالك بالوشيج الأسمر","https://www.aldiwan.net/poem32790.html","الكامل"],[303,"أرى الغناء على شتى طرائقه","https://www.aldiwan.net/poem36249.html","عموديه"],[398,"أنا من شيعة الرضا","https://www.aldiwan.net/poem53655.html","مجزوء الخفيف"],[443,"أرأيت ما صنعت لحاظ الغيد","https://www.aldiwan.net/poem2612.html","الكامل"],[556,"ضمنت مجدك العلا والمساعي","https://www.aldiwan.net/poem47709.html","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63935","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105428","البسيط"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71067","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47154","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104960","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93908","المجتث"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74078","المنسرح"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74067","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109995","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92051","الخفيف"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34548","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94792","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81729","البسيط"],[4830,"رسول الرحمة محمدﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=193598",""],[5183,"روض الاخاء","https://www.poetsgate.com/ViewPoem.aspx?id=180204",""],[5277,"عيونُ حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=192670",""]],"verses":[["جاشَ واديكَ فَسالَ ال","سَيلُ وَالقَومُ نِيامُ",0,"م",1,0],["جاشت كتائبهم كالموج صاخبة","ترغو بمثل هزيم الرعد في السحب",1,"ب",1,0],["جَاشَتْ بهِ الأَحْزانُ إذْ","طَفَحَتْ بِها تِلْكَ الصُّدوعْ",2,"ع",1,0],["جاشوا فَذاكَ الغَورُ مِنهُم سائِلٌ","دُفَعاً وَذاكَ النَجدُ مِنهُم مُعشِبُ",3,"ب",1,0],["جاشت به هِمَمٌ بلغن به المدى","وعلقن بالأقدار وهيَ عِجالُ",4,"ل",1,0],["جَاشَتْ لِفقدِكَ نَفْسُه وطغَى الأَسَى","في قلبهِ فَكأنّه البُرْكانُ",5,"ن",1,0],["جاشَ مِن كلِّ النَّواحي سَيْلُها","فَطغَى السَّيلُ عليهم وطما",6,"م",2,0],["جَاشَ بُركانُ القَضاءِ المُبْرَمِ","فَهْيَ غَرْقَى في العُبابِ المُسْتَعِرْ",7,"ر",1,0],["جاشَتِ الأحداثُ تَسْتَقْصِي المدى","وَارتْمَتْ من كلِّ صَوْبٍ تلتقي",8,"ق",2,0],["جاشتِ النَّفسُ ولجَّتْ رعدةٌ","لم تدع في القلب من رُكنٍ ركينْ",9,"ن",1,0],["جاش فيه كلُّ زخَّارِ القُوى","يرتقِي من لُجّهِ ما يَرتَقي",10,"ي",1,0],["جاشت حَمِيّتُه وقام خليلُهُ","دُونَ العريشِ يَذودُ عنه وَينضَحُ",11,"ح",1,0],["جاشَ مِنَ الكاهِنَينِ إِذ بَرَزوا","أَمواجَ بَحرٍ تُقَمِّصُ الحَدَبا",12,"ب",2,0],["جاشَت جُنودُهُما عَلَيَّ فَلَم أَنَم","وَبَدا وَقَد بَلَغَت بِغَيرِ تَبَدُّدِ",13,"د",1,0],["جاشت بصدري يوم قُلِّد عرشَهُ","ذكرى فراعنة القرون الأولى",14,"ل",2,0],["جاشَت إِلَيَّ النَفسُ في يَومِ الفَزَع","لا تُكثِري ما أَنا بَالنِكسِ الوَرَع",15,"ع",1,1],["جَاشَتْ بَلاَبِلُنَا وَسَالَ وَادِيهَا","يَا رَبِّ كُنْ خَيْرَ وَالٍ لِمُعَانِيهَا",16,"ي",3,1],["جَأشُهُ لَمّا احتَواهُ جَيْشُهُ","صارَ أرْسَى مَوْقِفاً مِنْ أُحُدِ",17,"د",1,0],["جاشَ المَديحُ فَلَم أَجِد أَهلاً لَهُ","أَحَداً سِواهُ فَلَم تَلُمني اللُّوَّمُ",18,"م",1,0],["جاشَت جُيوشُ الشِركِ يَومَ لَقيتَهُم","يَتَدامَرونَ عَلى مُتونِ الضُّمَّرِ",19,"ر",1,0],["جاشتْ به النفسُ، والألفاظُ قاصرةٌ","فأرسلته على عِلاَّته نغما",20,"م",2,0],["جاشَ طبعي بِمَدحِهِ","فَاِستَميلوا لِأَنشُرَه",21,"ر",2,0],["جاشت غواربه بموج مزبدٍ","متلاطم آذيّه بحديد",22,"د",1,0],["جاش وادي حِفاظِهِ فتعدّتْ","زَخْرَةُ المَدِّ مُشرفاتِ التِّلاعِ",23,"ع",1,0],["جاش بحرُ الصنوبريِّ بمعنا","ها وما زال بحرُهُ جيَّاشا",24,"ش",2,0],["جاشَتْ فَأَحْمَى غَلْيُها وَأَحْرَقا","مَنْ ضَلَّ مِنْهاجَ الهُدَى وَضَيَّقا",25,"ق",2,0],["جاشت على آله ما ارتاح واحدهم","من قهر أعداء حتى مات مقهورا",26,"ر",2,0],["جاشتْ به خَطَراتُ فِكْرٍ قد غدا","في غاية التحيير والتقسيمِ",27,"م",1,0],["جَأْشٌ يلين له الحديدُ وصَوْلةٌ","تستوقفُ الضّرغامَ عن أشباله",28,"ل",2,0],["جاشت النفس بالهموم ولكن","سكنت عندما وردنا المدينه",29,"ه",1,1],["جاشت صدور اصطباري","وزاد منها الأزيز",30,"ز",1,0],["جاشَت بِقَلب المحبّ جائشة","تَلظى اِلتياعاً وَلَيسَ تَنطَفئُ",31,"ا",1,0],["جاشَت علينا بالرَعي","ل من الخطوب يلي الرعيلا",32,"ل",2,0],["جاشاكَ تُلفى ابا شروانَ منصرعاً","والناسُ صَرعى لهم فرطُ الأَسى صَرَعا",33,"ع",2,0],["جاش صدري وَكُل صَبريَ لَما","قيل لي أَحمدٌ قَضى بارتحال",34,"ل",1,0],["جاش المزاجُ لها رقصاً على طربٍ","فاهتاج في قعرها رقمٌ بشدراء",35,"ا",2,0],["جَاشَت اسدٌ عَلَى ذِئَابِ الأعَادِي","فَأعِلَّت بِمَا أرَاقَت ظِبَاءُ",36,"ا",2,0],["جاشت خضارم جورها فتملَّكت","غرَقَ النفوس فلا تزال تزمجرُ",37,"ر",1,0],["جاشتْ على أوجه الدنيا عساكرُهُ","وغطَّتِ الأرضَ أنجاداً وغيطانا",38,"ن",2,0],["جاشتْ دواعي الهوى في القلب فالتهبتْ","تلك الجوانحُ شعراً فهو يضطرمُ",39,"م",1,0],["جاشت بها نفس إذا شهدت","صرح الإباء طغى بها المهر",40,"ر",1,0],["جاشتْ بعينيكِ القصائدْ وارتمتْ","تستعذبُ الأضيافَ والزوَّارا",41,"ر",2,0]]}