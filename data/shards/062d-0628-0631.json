كامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72545","السريع"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136392",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120493","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120366","الكامل"],[4679,"الصحف تنطق والمنابر تشهدُ","https://www.poetsgate.com/ViewPoem.aspx?id=142755",""],[4760,"رضوى ..","https://www.poetsgate.com/ViewPoem.aspx?id=35826",""],[4935,"أوصاف أحمد زينت أشعاري","https://www.poetsgate.com/ViewPoem.aspx?id=129535",""],[5030,"سهر","https://www.poetsgate.com/ViewPoem.aspx?id=215698",""],[5194,"وينك ؟","https://www.poetsgate.com/ViewPoem.aspx?id=30880",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[5538,"هب النسيم على محب ناءي","https://www.poetsgate.com/ViewPoem.aspx?id=142626",""],[5596,"شمائل سمائل","https://www.poetsgate.com/ViewPoem.aspx?id=206377",""],[5652,"شفرة الموس","https://www.poetsgate.com/ViewPoem.aspx?id=208679",""],[5690,"فتلوتها ووقفت إجلالاً لها","https://www.poetsgate.com/ViewPoem.aspx?id=172172",""],[5691,"الحبر والورقة","https://www.poetsgate.com/ViewPoem.aspx?id=206386",""],[5718,"الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=213899",""],[5781,"أُمُّ الشَّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=198835",""],[6093,"حَبْرُ المدينةِ","https://www.poetsgate.com/ViewPoem.aspx?id=199237",""]],"verses":[["حبرٌ رأينا يقينَ الجود من يدِه","وأكثرُ الجود في الدنيا حكايات",0,"ت",1,0],["حبر طباق المعالي فيه متضحٌ","فالمال مفترق والمجد ملتئم",1,"م",1,0],["حبر تجاوز حدّ المدح من شرفٍ","كالصبح لا غرّة تحكى ولا رئم",2,"م",1,0],["حبرتها فيها زهراء المعاطف من","أغلى وأنفس ما يهدي المجيدونا",3,"ن",2,0],["حبر له يثني الثناء قصدهُ","وخلفهُ وإثرهُ وعنده",4,"ه",1,0],["حَبَّرْتُ شعري باسمه إنَّ اسمَهُ","في الشِّعْر كالتَّحْبير والتسبيحِ",5,"ح",1,0],["حَبَرت مقالة جمعت فأوعت","وجاءت في سبيل الحق غاية",6,"ا",3,1],["حَبرُ بَني العَباس بَحر العلمِ","قُطبُ رحى الحَرب مَدار السِلمِ",7,"م",1,0],["حبرٌ تَصَدَّرَ لِلنَّوالِ فَلَم يَزَل","يَتلو عليه مِنَ المَدِيحِ دُرُوسا",8,"س",2,0],["حَبْرٌ تَحَقَّقَ فِي عُلاَهُ رَجَاؤُنُا","لَمَا غدَا تَعْنُو لَهُ الأَحْبَارُ",9,"ر",1,0],["حَبْرَ أَحْبَارِنَا الْجَلِيلَ الْمُفَدَّى","دُمْتَ جَاهاً لَنَا وَذخْراً وَمَجْدَا",10,"د",2,1],["حِبْرُ أبي حفصٍ لعابُ الليلِ","كأنه ألوان دُهْم الخيلِ",11,"ل",1,1],["حبر شجاع ضيغم واصل","بحر خضم حين يدعى حسام",12,"م",1,0],["حَبراً فأَخبَرَهُم حَديثاً صادِقاً","عَنهُ وَرَدَّ مَعاشِرَ الحُسّادِ",13,"د",1,0],["حبر يقل لذرة من بحره","ما جهَّزت بورانُ للمأمون",14,"ن",1,0],["حَبرٌ قَد اِنثَلَّ عَرشُ المَجدِ حينَ مَضى","وَاِنهَدَّ مِن بَعدِهِ رُكنُ المُهِماتِ",15,"ت",1,0],["حَبرٌ بَكَت فَضلَهُ المَشهورُ بيعَتُهُ","لَمَّا مَضى وَبَكى الكُرسِي عِنايَتَهُ",16,"ت",2,0],["حَبرٌ لَهُ التَّقوى شِعار لازِمٌ","وَالبِرُّ ثَوبٌ وَالعَفافُ إِزارُ",17,"ر",1,0],["حبر اذا جاد في جد وفي جدل","بحرٌ اذا جاد في عرف ومعروف",18,"ف",1,0],["حبرٌ تمسك بالحديث فلم يزغ","عنه إلى من عاج شر معاج",19,"ج",1,0],["حَبَّرت فيهِ قَصيدَةً أَودَعتُها","مِن مُسنَدِ الأَخبارِ حُسن مَعاني",20,"ن",2,0],["حَبْرَ الْجَزَائِرِ لَا تَنْفَكُّ مُحْتَجِبأ","عَمَّنْ يَمُدُّ إِلَى تَنْكِيدِكُمْ سَبَبَا",21,"ب",2,0],["حَبْرٌ يُبيدُ الحِبْرَ بَعْ","ضُ مَدِيحِهِ والْخُبْرُ يَشْهَدْ",22,"د",1,0],["حَبْرِ الْجَزَائِرِ وَالدُّنْيا بِرُمَّتِها","مَنْ عالَجَ الْعِلْْمَ حَتَّى ذَاعَ وَانْتَشَرَا",23,"ر",2,0],["حَبْرٌ سَبَحْنَا بِبَحْرٍ مِنْ مَعَارِفِهِ","كَمَا بِبَحْرٍ خِضَمٍّ سَبَحَ السَّمَكُ",24,"ك",1,0],["حبرٌ إذا هزَّ البراعَ بنانُهُ","شاهدت منه السِّحر وهوَ حلالُ",25,"ل",1,0],["حبر تدفق بحر علم كلامه","ونظامه باللؤلؤ المكنون",26,"ن",1,0],["حبر الأئمة بحر علم إمامنا النعمان","لا النعمان بن المنذر",27,"ر",1,0],["حبر هو في البحر لا وصف يحيط به","ولا أرى الوصف فيه غير مندرج",28,"ج",1,0],["حبّرتَ زرقاءَ الخميلِ بفضّةٍ","وفتحتَ لي في الموجِ نهجَ سناء",29,"ا",2,0],["حبرة المناظرة المحيط فراسة","بالعلمعلما منه لا تَقليدا",30,"د",2,0],["حَبّرت مِنها يَراعِي حِبراً","للندى زَهوٌ بِها وَسَطَ الندِي",31,"د",2,0],["حَبرٌ لَدَيهِ مَن وَراء النَّهرِ في ال","جِدالِ يَلقى البَحرَ بِالماءِ الوَشَل",32,"ل",1,0],["حَبرٌ لَهُ قَدَمٌ في ال","عُلومِ ذاتُ رُسوخِ",33,"خ",1,0],["حَبْرٌ متى أنفذَتْ في مَدْحِه عُصَبٌ","بضائعَ الفَضلِ يَردُدْها لهم جُدُدا",34,"د",2,0],["حَبّرتُه في بخيلٍ نقشُ دِرْهمِهِ","اللهُ مِن أَعْين السّؤّال يَحْميهِ",35,"ي",2,0],["حبّرتُ فيكمْ برودَ المدحِ مُعْلَمةً","فما حَصَلْتُ على شيءٍ سِوى التّعب",36,"ب",1,0],["حَبرٌ إذا الليلُ آواهُ بحِندِسِهِ","بحرٌ من العلم طامٍ ليس يُنْتَزَفُ",37,"ف",1,0],["حبرتها بدموعٍ مزجهنّ دمٌ","والحزن اضرم في القلب الشجي نارا",38,"ر",2,0],["حبرٌ إذا هزّ اليراع مفاخراً","أذرى بكل مهندٍ رقراقِ",39,"ق",1,0],["حبرٌ سحاب علومهِ","لم يرم يوماً باحتباسه",40,"س",2,0],["حَبَّرْتُهَا فيكَ والأَلفَاظُ هاجِعَةٌ","فَنَابَ ذِكْرُكِ لِي فيها عن الْوَسَنِ",41,"ن",1,0],["حَبْرٌ تَغَايرتِ القوافِي في مدًى","أَوصافُهُ فَكَأَنَّهُنَّ ضَرائِرُ",42,"ر",1,0],["حَبْرٌ لنا من راحتَيْهِ وعِلْمِهِ","غيثانِ كلٌّ منهما هتَّانُ",43,"ن",1,0],["حَبْرٌ إمامٌ أوحدٌ علامةٌ","حاز من العلياءِ أوفى منتهى",44,"ا",1,0],["حبرٌ على الأعداءِ طُرّاً قد علا","ندْبٌ من العافين طُرّاً قد دنا",44,"ا",1,0],["حبّرْتُ ألفاظي فجئتُ بها","حِبَراً الى علاّمةٍ حَبْرِ",45,"ر",1,0],["حبْرٌ رأى حِبرَ الثنا","ء عليه أحسنَ ما تردّى",46,"د",2,0],["حبْرٌ لنا في راحتيهِ سَحابةٌ","ذابَ اللُجينُ بها وسالَ العسجَدُ",47,"د",1,0],["حِبْرٌ له خُطَّ يَراعٌ به","يراعُ خطّيٍّ وخطّار",48,"ر",1,0],["حبّرتُ ما حبّرتُ من مِدَحٍ","فاحتازَها بصوارِمِ الحَبْرِ",49,"ر",1,0],["حبْرٌ حكتْ أمداحُهُ الحِبَرَ التي","فيها أرَتْ صَنعاء صُنعاً مونقا",50,"ق",2,0],["حَبْرٌ توغّل في الفضائِلِ جاهداً","حتى ارتوى من بحرها الملآنِ",51,"ن",1,0],["حبَراتُ فحلٍ راقصتْ ألحاظَه","وحلا بفيه شهدُها المسمومُ",52,"م",1,0],["حَبْرٌ كميٌّ في الجدالِ وفي الوغى","شَهدَ الحُسامُ بفضلهِ والمِقْوَل",53,"ل",1,0],["حَبْرٌ إذا ذلَّ الدَّليلُ بموغِلٍ","شهدتْ بصائبِ قولهِ العُلماءُ",54,"ا",2,0],["حَبْرٌ لهُ تقْواهُ أمْنعُ جُنَّةٍ","وأعَزُّ مُعْتَصمٍ وأشرفُ معْقل",55,"ل",1,0],["حَبْرٌ وبحرٌ ما لجُمَّة فضْلِهِ","وعُبابِ فيْضِ بَنانهِ من ساحِلِ",56,"ل",1,0],["حبرَّتها نقداً غداة منحتها","نقداً فتاهت لاختلافِ نقودها",57,"د",3,0],["حبرٌ يروعُ يراعهُ أعداءه","فعدوّهِ قلقُ الوسادِ مروَّع",58,"ع",1,0],["حبراً كما نشرت يداً متملكٍ","ما حيك من صنائعهِ وزبيده",59,"د",2,0],["حَبْرُ المسَائِلِ سَبّاقُ الأَماثِلِ في","بابِ الفَضَائِلِ في خَبْرٍ وفي خَبَرِ",60,"ر",1,0],["حبر تقضت به الأيام وانصرمت","حتى اغتدى رمس بالثرى أرما",61,"م",2,0],["حبر جليل بالتقى متجمل","ولك الفضائل والكمال شعار",62,"ر",1,0],["حبر جليل حكيم مصقع فطن","وصدره بحر علم بالتقى زخرا",63,"ر",2,0],["حبر جليل وديع مصقع ورع","فمثله ما رأينا الدهر أحبارا",64,"ر",2,0],["حَبرٌ إذا أشكلت عمياءُ أوضحها","طلقُ البشاشَةِ طلقُ الوجهِ وَضّاح",65,"ح",1,0],["حبر له بالشام أعظم موقع","ساق العداء إلى شج حران",66,"ن",1,0],["حَبْرٌ تجرَّد للعلوم وما انثنى","حتّى انثنى ولبوسُها سِرْبالُهُ",67,"ل",2,0],["حبر تواضع للمولى فصار له","به على كل من رام العُلُوّ عُلا",68,"ل",2,0],["حبرت حذاق الحساب بفكرة","تركنهم والوفهم آحاد",69,"د",1,0],["حَبْرٌ فَما بِسِوى المَعارفِ والتُّقى","متعلِّقٌ منه الجنان ومولعُ",70,"ع",1,0],["حبر الشريعة رحب الجانبين إذا","لاذت به الملة البيضاء من حرب",71,"ب",1,0],["حبر يدين بما قد كان جاء بهِ","إِلى النبيّ عن الرحمن جبرينُ",72,"ن",1,0],["حبر يفوهُ بما يرضي الإله ولن","تراه بالهجرِ في النادي بفوّاهِ",73,"ا",2,0],["حبرٌ إذا رصّع القرطاس في دررٍ","منه محا صنع ياقوتٍ وما عملا",74,"ل",2,0],["حبرٌ وان دعي المخلّع كنيةً","فهو الذي من كل ريب سلّما",75,"م",2,0],["حبرٌ جليلٌ فيلسوفٌ فاضلٌ","فيه الكمال سجيّةٌ مغروسة",76,"س",2,0],["حبر لحظاً فكم كمي","وكم دم للكماة قطر",77,"ر",1,0],["حِبْرٌ وبَحْرٌ ساءَلْتُ أَرْشَدَني","وإِنْ سَأَلتُ نَوالاً مِنْهُ أَغْناني",78,"ن",2,0],["حبر الأئمة قطب الوقت من نثرت","كفاه جودا اغدا ينهل كالمطر",79,"ر",1,0],["حبر الايمة فرد الوقت من جمعت","له الفضائل جمعا غير منتقل",80,"ل",1,0],["حبر يلوذ الشرع منه بحاكم","وضحت بنير حكمه الأحكام",81,"م",1,0],["حَبرٌ لقد جَمعَ المكارم والهُدى","أَكرِمْ به في الدينِ مِن مِطران",82,"ن",1,0],["حبر الكسير اذا يحن اليهم","وغنى العديم وامن كل محاذر",83,"ر",1,0],["حبر تسلسل من سلالة ماجد","من بيت مجد شيد بالإيمان",84,"ن",1,0],["حَبْرُ الزَّمَانِ الخَيِّرُ الأزكَى الرِّض