{"poems":[[53,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[53,"لله ثم لك المحل الأعظم","https://www.aldiwan.net/poem29795.html","الكامل"],[86,"ردا كؤوسكما عن شبه مفؤود","https://www.aldiwan.net/poem10500.html","البسيط"],[93,"حي العزيمة والشبابا","https://www.aldiwan.net/poem9790.html","عموديه"],[4,"سفها عذلت وقلت غير مليم","https://www.aldiwan.net/poem21199.html","الكامل"],[72,"ليهن بنو الآمال أنك قادم","https://www.aldiwan.net/poem19670.html","الطويل"],[51,"مذ صرت همي في النوم واليقظه","https://www.aldiwan.net/poem65036.html","المنسرح"],[51,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[91,"دمية حسناء تغري النظرا","https://www.aldiwan.net/poem8870.html","عموديه"],[85,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[85,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[43,"بكيت يا ربع حتى كدت أبكيكا","https://www.aldiwan.net/poem9750.html","البسيط"],[45,"حرمت النجح حرمانا مبينا","https://www.aldiwan.net/poem66798.html","البسيط"],[49,"وعظتك أجداث خفت","https://www.aldiwan.net/poem10848.html","مجزوء الكامل"],[80,"أوميض البرق في الليل البهيم","https://www.aldiwan.net/poem31292.html","الرمل"],[80,"وعظت بلمتك الشائبه","https://www.aldiwan.net/poem31548.html","المتقارب"],[105,"هو مهرجان الله فانظر واخشع","https://www.aldiwan.net/poem43061.html","الكامل"],[67,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[48,"وعظتك واعظة القتير","https://www.aldiwan.net/poem63373.html","مجزوء الكامل"],[46,"وعظت قوما فلم يرعوا إلى عظتي","https://www.aldiwan.net/poem22466.html","البسيط"],[46,"وعظ الزمان فما فهمت عظاته","https://www.aldiwan.net/poem23321.html","الكامل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20251","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16673",""],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202546","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55243","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54904","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54844","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"]],"verses":[["وَعِظامُ البَلاءِ صا","روا عِظاماً بَوالِيا",0,"ي",2,0],["وَعَظُمتَ قَدراً أَن يَروقَكَ مَغنَمٌ","أَو أَن يَصِرَّ عَلى بَنانِكَ دِرهَمُ",1,"م",1,0],["وَعَظَّمَ اللَهُ في عُثمانَ أَجرَكُمُ","في رَحمَةِ اللَهِ أَمسى خَيرَ مَغمودِ",2,"د",1,0],["وَعَظَائِماً لِلشَّرْقِ قَدْ","أَعْنَتْ مِنَ الْغَرْبِ الرِّقَابَا",3,"ب",2,0],["وَعَظيمَةٍ دافَعتُها فَتَحَوَّلَت","عَنّي فَلَم أَدنَس وَصَحَّ أَديمي",4,"م",2,0],["وعظتم وقد أحصيتمُ درجاتها","كما صدحت فوق الغصون الحمائم",5,"م",1,0],["وعظْتُ نفسي فخالفتْ عِظتي","وخالفَ القلبُ فيك من وَعظه",6,"ظ",2,0],["وعظتُك أيها الإنسانُ وعظي","فلا أكُ واعظَ الدّمنِ الخوالي",7,"ي",1,0],["وعظَ اللَّهُ والكتابُ فصممْ","تُ وأقدمت أيما إقدام",8,"م",1,0],["وَعظُمُ الكَونُ لَدَينا جُرمُهُ","وَتَراهُ عِندَها قَد صَغُرا",9,"ر",2,0],["وَعِظامٌ تَتَزَكّى عَنبَراً","مِن ثَناءٍ صِرنَ أَغفالَ الرُموس",10,"س",1,0],["وَعَظَ البُحتُرِيَّ إيوانُ كِسرى","وَشَفَتني القُصورُ مِن عَبدِ شَمسِ",11,"س",1,0],["وَعُظمُ قَدرِكَ في الآفاقِ أَوهَمَني","أَنّي بِقِلَّةِ ما أَثنَيتُ أَهجوكا",12,"ك",2,0],["وَعُظمُ بَلِيَّتي أَلّا أَرى لي","عَلى مَكروهِ دافِعِها مُعينا",13,"ن",2,0],["وَعَظتَكَ أَجداثٌ خُفُت","فيهِنَّ أَجسادٌ سُبُت",14,"ت",1,1],["وعظيم الهولِ لولا آيةٌ","لم يكُنْ راكبُهُ إلّا أثيمْ",15,"م",1,0],["وَعِظْتَ بلمّتك الشائبه","وفقد شبيبتك الذاهبَهْ",16,"ب",2,1],["وَعَظَ اللَبيبُ فَأَينَ مِنّا مَن يَرى","وَدَعا المُهيبُ فَأَينَ فينا مَن يَعي",17,"ع",2,0],["وُعِظْتُمْ فَزِدْتُمْ بالمواعِظِ قَسْوَةً","وَلَيسَ يُفيدُ القدحُ إِن أصلَدَ الزَّندُ",18,"د",1,0],["وَعَظَتكَ واعِظَةُ القَتيرِ","وَنَهَتكَ أُبَّهَةُ الكَبيرِ",19,"ر",1,1],["وَعَظتُ قَوماً فَلَم يُرعوا إِلى عِظَتي","مِثلَ اِمرِىءِ القَيسِ ناجي طائِرَ الوادي",20,"ي",1,1],["وَعَظَ الزَمانُ فَما فَهِمتَ عِظاتِهِ","وَكَأَنَّهُ في صَمتِهِ يَتَكَلَّمُ",21,"م",1,1],["وعظْمِ ما لاقَتْ من العدوِّ","والحربِ في الرَّواحِ والغُدوِّ",22,"و",1,0],["وَعِظامُ الرِجالِ مِن كُلِّ جِنسٍ","في رِضاكُنَّ أَرخَصوا كُلَّ غالي",23,"ل",2,0],["وَعَظَتْكَ أيّامٌ تَمُرُّ","فهل فَهِمْتَ مَقَالَها",24,"ل",3,0],["وعظام تتزكّى عنبرا","من ثناء صرن أغفال النفوس",25,"س",1,0],["وَعَظِيمٌ مِنْكُما المُبْدِ","ئُ شَأْناً وَالمُتِمُّ",26,"م",1,0],["وَعَظِيمُ النَّجَاحِ يَصْدُرُ عَنْ رَأْ","سٍ حَكِيمٍ وَعَنْ فُؤادٍ غَيُورِ",27,"ر",1,0],["وَعَظِيمُ الرِّجَالِ تَعْلمُ مَنْ جَلَّ","عَلَى قَدْرِ مَا تَجِلُّ الأُمُورُ",28,"ر",1,0],["وَعَظَتني الدُنيا مَواعِظَ شَتّى","وَأَقَلُّ العِظاتِ تَكفي اللَبيبا",29,"ب",2,0]]}