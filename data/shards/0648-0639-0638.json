https://www.poetsgate.com/ViewPoem.aspx?id=49465",""],[4915,"واعظ","https://www.poetsgate.com/ViewPoem.aspx?id=212503",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[3271,"أنا شاعر الوادي وعزاف اللظى","https://www.poetsgate.com/ViewPoem.aspx?id=103536",""],[5111,"شَهِيدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212498",""],[5145,"أرأيت من حملوه للتدفين","https://www.poetsgate.com/ViewPoem.aspx?id=108068",""],[5200,"وعظ المشيب فمرحبا","https://www.poetsgate.com/ViewPoem.aspx?id=200804",""],[5307,"دنيا محلا وطرها","https://www.poetsgate.com/ViewPoem.aspx?id=10547",""],[5397,"جمل الثنا بك حقها التفصيل","https://www.poetsgate.com/ViewPoem.aspx?id=157912",""],[5409,"لم تنجب الأيام إلا","https://www.poetsgate.com/ViewPoem.aspx?id=155495",""],[5436,"مناجاة بين بوش وكلبه! ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35272",""],[5457,"من أنا؟","https://www.poetsgate.com/ViewPoem.aspx?id=213314",""],[5582,"أَمِنْ ذِكْرِ أَطْلالٍ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=63500",""],[5725,"او كالذي سال الفؤاد الصادي","https://www.poetsgate.com/ViewPoem.aspx?id=198670",""],[4623,"تركت الهوى بعد طول امتحان ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146692",""],[192,"البحرين","https://www.poetsgate.com/ViewPoem.aspx?id=16374",""],[520,"شغل الزمان بما تقول وتفعل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577611",""]],"verses":[["وَعِظامُ البَلاءِ صا","روا عِظاماً بَوالِيا",0,"ي",2,0],["وَعَظُمتَ قَدراً أَن يَروقَكَ مَغنَمٌ","أَو أَن يَصِرَّ عَلى بَنانِكَ دِرهَمُ",1,"م",1,0],["وَعَظَّمَ اللَهُ في عُثمانَ أَجرَكُمُ","في رَحمَةِ اللَهِ أَمسى خَيرَ مَغمودِ",2,"د",1,0],["وَعَظَائِماً لِلشَّرْقِ قَدْ","أَعْنَتْ مِنَ الْغَرْبِ الرِّقَابَا",3,"ب",2,0],["وَعَظيمَةٍ دافَعتُها فَتَحَوَّلَت","عَنّي فَلَم أَدنَس وَصَحَّ أَديمي",4,"م",2,0],["وعظتم وقد أحصيتمُ درجاتها","كما صدحت فوق الغصون الحمائم",5,"م",1,0],["وعظْتُ نفسي فخالفتْ عِظتي","وخالفَ القلبُ فيك من وَعظه",6,"ظ",2,0],["وعظتُك أيها الإنسانُ وعظي","فلا أكُ واعظَ الدّمنِ الخوالي",7,"ل",2,0],["وعظَ اللَّهُ والكتابُ فصممْ","تُ وأقدمت أيما إقدام",8,"م",1,0],["وَعظُمُ الكَونُ لَدَينا جُرمُهُ","وَتَراهُ عِندَها قَد صَغُرا",9,"ر",2,0],["وَعِظامٌ تَتَزَكّى عَنبَراً","مِن ثَناءٍ صِرنَ أَغفالَ الرُموس",10,"س",1,0],["وَعَظَ البُحتُرِيَّ إيوانُ كِسرى","وَشَفَتني القُصورُ مِن عَبدِ شَمسِ",11,"س",1,0],["وَعُظمُ قَدرِكَ في الآفاقِ أَوهَمَني","أَنّي بِقِلَّةِ ما أَثنَيتُ أَهجوكا",12,"ك",2,0],["وَعُظمُ بَلِيَّتي أَلّا أَرى لي","عَلى مَكروهِ دافِعِها مُعينا",13,"ن",2,0],["وَعَظتَكَ أَجداثٌ خُفُت","فيهِنَّ أَجسادٌ سُبُت",14,"ت",1,1],["وعظيم الهولِ لولا آيةٌ","لم يكُنْ راكبُهُ إلّا أثيمْ",15,"م",1,0],["وَعِظْتَ بلمّتك الشائبه","وفقد شبيبتك الذاهبَهْ",16,"ب",2,1],["وَعَظَ اللَبيبُ فَأَينَ مِنّا مَن يَرى","وَدَعا المُهيبُ فَأَينَ فينا مَن يَعي",17,"ع",2,0],["وُعِظْتُمْ فَزِدْتُمْ بالمواعِظِ قَسْوَةً","وَلَيسَ يُفيدُ القدحُ إِن أصلَدَ الزَّندُ",18,"د",1,0],["وَعَظَتكَ واعِظَةُ القَتيرِ","وَنَهَتكَ أُبَّهَةُ الكَبيرِ",19,"ر",1,1],["وَعَظتُ قَوماً فَلَم يُرعوا إِلى عِظَتي","مِثلَ اِمرِىءِ القَيسِ ناجي طائِرَ الوادي",20,"د",2,1],["وَعَظَ الزَمانُ فَما فَهِمتَ عِظاتِهِ","وَكَأَنَّهُ في صَمتِهِ يَتَكَلَّمُ",21,"م",1,1],["وعظْمِ ما لاقَتْ من العدوِّ","والحربِ في الرَّواحِ والغُدوِّ",22,"و",1,0],["وَعِظامُ الرِجالِ مِن كُلِّ جِنسٍ","في رِضاكُنَّ أَرخَصوا كُلَّ غالي",23,"ل",2,0],["وَعَظَتْكَ أيّامٌ تَمُرُّ","فهل فَهِمْتَ مَقَالَها",24,"ل",3,0],["وعظام تتزكّى عنبرا","من ثناء صرن أغفال النفوس",25,"س",1,0],["وَعَظِيمٌ مِنْكُما المُبْدِ","ئُ شَأْناً وَالمُتِمُّ",26,"م",1,0],["وَعَظِيمُ النَّجَاحِ يَصْدُرُ عَنْ رَأْ","سٍ حَكِيمٍ وَعَنْ فُؤادٍ غَيُورِ",27,"ر",1,0],["وَعَظِيمُ الرِّجَالِ تَعْلمُ مَنْ جَلَّ","عَلَى قَدْرِ مَا تَجِلُّ الأُمُورُ",28,"ر",1,0],["وَعَظَتني الدُنيا مَواعِظَ شَتّى","وَأَقَلُّ العِظاتِ تَكفي اللَبيبا",29,"ب",2,0],["وعظ (البحتري) إيوان (كسرى)","شفتني القصور من (عبد شمس)",30,"س",1,0],["وعظيم علي قولك أني","واجدٌ بعدها بديلا أغرا",31,"ر",2,0],["وعظم حبيباً لا يراك دوامه","وما دمت إلا بالبُكَا لك عظَّما",32,"م",2,0],["وعظيم القدر والحرز المنيعِ","وأبَا الإحسانِ والحسنِ البديعِ",33,"ع",1,0],["وعظت بمصرعهِ الحصوادِثُ عنوةً","ناهيكَ من وعظٍ بغيرِ كلامِ",34,"م",1,0],["وَعَظَتهُم آياتُكَ اللائي حَطَّت","عَن رِجالِ الخِلافَةِ الأَعباءَ",35,"ا",2,0],["وَعَظَّمَ رَبُّ العَرشِ شيمَةَ خُلقِهِ","وَمَن ذايُماري في عُلاهُ وَسَبقِهِ",36,"ه",1,0],["وعظْ بنصحك من ضاقت بمهجتهِ","عن النصيحةِ في طاعاتِنا السبُلُ",37,"ل",1,0],["وعظت ولكن ما اتعظت فضائح","بطرسك تنبي عنك وسط المحاضر",38,"ر",1,0],["وَعَظتني بِجَهلِها فَأَفادت","نِيَ رُشداً وَفاتَ رُشدي هُداها",39,"ا",3,0],["وعَظُمتَ وصْفا في السَّماعِ فمُذْ بَدا","للعينِ خُبْرُك هانتِ الأخبار",40,"ر",1,0],["وعظيمٌ كل ما فيه جميل","كالبيان العذب في المعنى النبيل",41,"ل",1,0],["وَعَظيم دين لا يَقوم بحمله","رضوى وَلا الصخرات من ثهلان",42,"ن",1,0],["وَعَظ اِبنُ الجاموسِ في حَرِّ آبٍ","فَشَكَونا مِن وَعظِهِ الزَمهَريرا",43,"ر",2,1],["وَعظه في كانونَ إِن يَذكُرِ الجن","نةَ يَختار السامِعونَ السَعيرا",43,"ر",2,0],["وعظوا القاضي إذ","بالعدل يسمو ذو المقام",44,"م",1,0],["وَعظَّمَ اللهُ أَجرَ الدينِ فهو شجٍ","وأَلهم الطهرَ عنك الصبرَ فهو كما",45,"م",2,0],["وَعَظيمُ المَلا بِفِعلِكَ راضِ","أَينَما كُنتُ وَالمَحامِدُ تَشكُرُ",46,"ر",1,0],["وَعَظيمُ رَأيِكَ بَثُّهُ فَبِناؤُهُ","مِن ثاقِبِ الفِكرِ اِعتَلى تَشييدُهُ",47,"د",2,0],["وَعَظُمَ حُزنٌ عَلى ما خيفَ مِن تَلَفِ","وَالمَلِكُ لِلخَسفِ قَد أَمسى عَلى شَرَفِ",48,"ف",1,0],["وَعِظهُم بأَنَّ الماءَ بِالعَدلِ قِسمَةٌ","فَلي شِربُ يَومٍ بَعدَهُم وَلَهُم شِربُ",49,"ب",1,0],["وَعَظيمِ المُلكِ قَد أَوعَدَنِي","وَأَتَتنِي دُونَهُ مِنهُ النُّذُرْ",50,"ر",1,0],["وعظيمُ البلاء رفع الرذيل","فالبلاءُ الشديدُ أنْ يُستَعاذا",51,"ذ",2,0],["وعَظَّمتَني في نفس كلّ معاند","فلا زلْتَ في نفس المعالي مُعَظَّما",52,"م",2,0],["وعظَ الشَّيبُ والحوادثُ فيها","وفؤادي ذاك المصرُّ الجسورُ",53,"ر",1,0],["وعظتنا به الخطوبُ فما أع","جبُ إلاَّ من قلة الأفهامِ",54,"م",1,0],["وعظمه في ارتعاش","ومشيه بانكباب",55,"ب",1,0],["وعَظُمْنا طوراً وحالاً وسِرًّا","ومُحِقْنا وجداً وبالشَّوقِ ذُبْنَا",56,"ن",2,0],["وعَظيمٌ فارسٌ شَمْ","خٌ وذو طِمْرَيْنِ راجِلْ",57,"ل",1,0],["وعِظامي أَقلامُ شَوْقي ودَمْعي","حبرُ طَرْسي وبسطَةُ الرِقِّ جلْدِي",58,"د",2,0],["وعِظامي إلى سفينةِ قُرْبي","لِحِماكُمْ وحقَّكمْ ألواحُ",59,"ح",1,0],["وعظِّمِ الخِلَّ الوَفِيَّ باطِناً","وخلِّ بالإِهمالِ قلباً من جَفَا",60,"ا",1,0],["وعظيمة يشكو المخنق ضيقها","وسعت منه بعد ضيق خناقها",61,"ق",3,0],["وعظيماً من البلايا قطيعاً","وغموراً قد ضاعفت أحزاني",62,"ن",2,0],["وعظامي قد بروا","ليت شعري هل دروا",63,"ا",1,0],["وعَظَّمْ بِهِ القسيسَ إِنْ شئتَ خُطوةَ","وكَبِّر بِهِ الشَّمَاسَ إِنْ شِئتَ أَنْ تَعْلا",64,"ل",2,0],["وعظمت أفعاله واشتهرت","في الناس في ذلك لما كثرت",65,"ت",1,0],["وعظائمٌ قد صار أَهونها","بسدادِه ما كان أَهْوَلها",66,"ل",3,0],["وعظيم فضلك قد أقر به الورى","وهل الأعاظم فضلهم مجحود",67,"د",1,0],["وعظ الألى حازوا الثراء ليبذلوا","من تلكم الأموال في خير وبر",68,"ر",1,0],["وعظ القلوب بموته ابن مفضل","ولكم غدا حياً من الوعاظ",69,"ظ",1,1],["وَعَظمُهُ في الغرامِ الضَّربُ يَطحَنُهُ","وَقَبلَهُ لَم يَكُن طَحناً بِمُنجَرِشِ",70,"ش",1,0],["وَعَظْمُ اصْطِبَارِي بِالْقَطِيعَةَ قَدْ وَهَنْ","وَقَلْبي الْمُعَنى قَدْ أَضَرَّ بِهِ الشَّجَنْ",71,"ن",1,0],["وَعَظَتنا فِعالُها لَو عقلنا","فظُباها فينا لها وَقَعاتُ",72,"ت",1,0],["وعظيم رزء في عظيم قدره","إن الرزايا في العظام عظام",73,"م",1,0],["وَعظّمه تعظيماً تحيط بشأنهِ","إِذا ما تجلّى وهوَ في الدست مبتدي",74,"د",2,0],["وعظم الله أجر الصابرين ومن","فيهم أصيب بهذا الفادح الصعب",75,"ب",1,0],["وعظيم بردٍ عظمت","رياحه المرطبهْ",76,"ب",2,0],["وعظم اقتدارات وذكر مآثرٍ","وآيات احكامٍ بها قد تعاظما",77,"م",2,0],["وعظتك واعظة الفتير","ورأيت منقلب الدهور",78,"ر",1,0],["وعظيم الخُلق بوحي جا","ء كذاك له حالي الارج",79,"ج",1,0],["وعظتُهم في النّثر لكنّهم","ما هزّهم للكرم الوعْظُ",80,"ظ",1,0],["وَعَظَّمَ اللهُ مَعْنى لَفْظِها قَسَماً","قَلِّد إِذَا شِئْتَ أَهْلَ الْعِلْمِ أَوْ فَقِسِ",81,"س",1,0],["وعظم أسمائك عجل المدد","والنصر والتفريج والفتح القريب",82,"ب",1,0],["وعظم مقامي يا عظيم معززاً","فحسبي جلالاً أن تكون المجللا",83,"ل",2,0],["وعظتُكِ لو أنِّي أُثبتُ وفي الذي","وعُظتِ به لو ترعوينَ بَلاغُ",84,"غ",1,0],["وعظَّم الناسُ منهم تركَها فغدوا","من غِبطةِ التركِ في حِرصٍ لأجلهمُ",85,"م",1,0],["وعظائم ولطائف","وجلائل ورقائق",86,"ق",1,0],["وعظمَ خلقه في خير ذكر","إلهٌ باريءٌ مُعطى الرجاء",87,"ا",2,0],["وعظيمُ المصاب يشتفُّ ماءَ ال","قلب حتى يعودَ يَبْساً محِيلا",88,"ل",2,0],["وَعَظَتكُم تِلكَ المَصارِعُ حَولَها","لَو أَنَّ مَن سَمِعَ المَواعِظَ يَفهَمُ",89,"م",1,0],["وعظيم صبري أن وحيك ملهمي","صبرا، وعلمك لم يزل منقولا",90,"ل",2,0],["وَعِظْ منك نفسا ما ارعوت لِمُذكِّرِ","ولا وَثِقَتْ من نَاصِحٍ بمقال",91,"ل",1,0],["وَعِظامُ الشُجعانِ فيكَ تُنا","دينا وَأَرواحُهُم حَوالَيكَ سورُ",92,"ر",1,0],["وَعِظهُم وَاِنهَهُم عَن مُنكَراتٍ","وَلا تَدَعِ البُكاءَ إِذا وَعَظتا",93,"ت",2,0],["وعظم الشرع حتى أن داعيه","لا يستطيع له المدعو عصيانا",94,"ن",2,0],["وعظمت رزءاً للرزايا مبديا","وجممت هما للهموم معيدا",95,"د",2,0],["وعَظَّمتَها مولايَ حامدُ نُسخةً","تُخلِّد فيها الصدقَ ضمنَ المهارقِ",96,"ق",1,0],["وَعظِّم أَمرَهُ في كُلِّ حالٍ","تُعَظَّم في الأَنامِ بِكلِّ قَدرِ",97,"ر",1,0],["وعظم في القاضي أجرنا","وأحسن فينا بعده الخلف",98,"ف",1,0],["وعظت سفاهاً قد يرون سفاهة","عظاتي بالقرآن أو بالقصائد",99,"د",1,0],["وعظيم ما ضمَّ المعرف","والمحصب والمخيف",100,"ف",1,0],["وعظت لكن لم أكن متعظا","بشربها بل قلت وصفا مبهجا",101,"ج",2,0],["وعظتم غير أنا قد لهونا","فلم يخطر لكم وعظ ببال",102,"ل",1,0],["وعظم مثواها من اللطف ناسم","يراوحها في كل آن ويغتدي",103,"د",2,0],["وعظت بها أخاً ورثيت مالا","واديت الأمانة والسلام",104,"م",1,0],["وعظَّمَ العلمَ وأهلَ نُسْكهِ","ذُو العقل إن يفحْ عبيرَ مِسكه",105,"ه",1,0],["وعظَ الدهرُ من رأَى كلَّ يَومٍ","نَقْضُهُ في اللجينِ والعِقْيَانِ",106,"ن",1,0],["وَعُظِّلَ الأَدبُ المحرومُ وانتزعتْ","منه دعائمُ كانتْ ذاتَ أَوتادِ",107,"د",1,0],["وعظ اللسان ومذ عتوا عن أمره","طعن السنان فلم تفته عتاتها",108,"ت",3,0],["وعظيم فضلك في الورى","يستوجب الشكر العظيما",109,"م",2,0],["وعظام لعلاكم رضضت","بعتاق الخيل في الجري الشديد",110,"د",1,0],["وعظلم مع ظهمٍ مع أخظ وغظ","رب وخطرفة والوقظ وايتقظا",111,"ظ",2,0],["وعظم حرث وقوس والمظاظ خصا","م والمحارب ظج من أذى بهظ