{"poems":[[53,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[53,"لله ثم لك المحل الأعظم","https://www.aldiwan.net/poem29795.html","الكامل"],[86,"ردا كؤوسكما عن شبه مفؤود","https://www.aldiwan.net/poem10500.html","البسيط"],[93,"حي العزيمة والشبابا","https://www.aldiwan.net/poem9790.html","عموديه"],[4,"سفها عذلت وقلت غير مليم","https://www.aldiwan.net/poem21199.html","الكامل"],[72,"ليهن بنو الآمال أنك قادم","https://www.aldiwan.net/poem19670.html","الطويل"],[51,"مذ صرت همي في النوم واليقظه","https://www.aldiwan.net/poem65036.html","المنسرح"],[51,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[91,"دمية حسناء تغري النظرا","https://www.aldiwan.net/poem8870.html","عموديه"],[85,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[85,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[43,"بكيت يا ربع حتى كدت أبكيكا","https://www.aldiwan.net/poem9750.html","البسيط"],[45,"حرمت النجح حرمانا مبينا","https://www.aldiwan.net/poem66798.html","البسيط"],[49,"وعظتك أجداث خفت","https://www.aldiwan.net/poem10848.html","مجزوء الكامل"],[80,"أوميض البرق في الليل البهيم","https://www.aldiwan.net/poem31292.html","الرمل"],[80,"وعظت بلمتك الشائبه","https://www.aldiwan.net/poem31548.html","المتقارب"],[105,"هو مهرجان الله فانظر واخشع","https://www.aldiwan.net/poem43061.html","الكامل"],[67,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[48,"وعظتك واعظة القتير","https://www.aldiwan.net/poem63373.html","مجزوء الكامل"],[46,"وعظت قوما فلم يرعوا إلى عظتي","https://www.aldiwan.net/poem22466.html","البسيط"],[46,"وعظ الزمان فما فهمت عظاته","https://www.aldiwan.net/poem23321.html","الكامل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20251","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16673",""],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202546","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55243","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54904","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54844","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[85,"سينية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=71542&r=&rc=239",""],[120,"إيه عبد الرحمن أذكيت جمرا","https://www.aldiwan.net/poem49274.html","الخفيف"],[121,"ألا عم صباحاً أيها الربع منعما","https://www.aldiwan.net/poem23818.html","الطويل"],[128,"لا تلومني فمثلى لا يلام","https://www.aldiwan.net/poem50529.html","الرمل"],[133,"شاء الإله حماية الإسلام","https://www.aldiwan.net/poem4216.html","الكامل"],[143,"عاذ بالصفح من أَحب البقاء","https://www.aldiwan.net/poem11716.html","الخفيف"],[150,"دموع على الخدين ترسل مزنها","https://www.aldiwan.net/poem68585.html","الطويل"],[160,"ما أنت في منزل يخشى به الرجل","https://www.aldiwan.net/poem58934.html","البسيط"],[160,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[182,"عرجا في ربوعها وسلاها","https://www.aldiwan.net/poem67021.html","الخفيف"],[185,"عبقت بطيب ثنائك الأقطار","https://www.aldiwan.net/poem14538.html","الكامل"],[211,"أكرموا مطران أو لا تكرموه","https://www.aldiwan.net/poem46305.html","الرمل"],[271,"أعد الوداع فما أراك تراني","https://www.aldiwan.net/poem52062.html","الكامل"],[282,"وعظ ابن الجاموس في حر آب","https://www.aldiwan.net/poem32752.html","الخفيف"],[285,"هذه دار همام","https://www.aldiwan.net/poem39352.html","مجزوء الرمل"],[298,"عج بالمطي على قبر ببلقعة","https://www.aldiwan.net/poem36257.html","عموديه"],[320,"كان عيد الفدا لحظك أوفر","https://www.aldiwan.net/poem67178.html","الخفيف"],[320,"بقبول صومك قد تبسم عيده","https://www.aldiwan.net/poem67216.html","الكامل"],[320,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[366,"أبى الغمض والتمهيد جفناي والجنب","https://www.aldiwan.net/poem17158.html","الطويل"],[367,"مثل عداء بروضات القطا","https://www.aldiwan.net/poem4617.html","الرمل"],[416,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[416,"تذكر عهدا بالحمى قد تقدما","https://www.aldiwan.net/poem53977.html","الطويل"],[458,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[464,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[479,"عجائب الدهر شتى","https://www.aldiwan.net/poem36936.html","المجتث"],[500,"بين طي الحبيب والنشر معنى","https://www.aldiwan.net/poem37750.html","الخفيف"],[500,"لا تشوش لك سرا","https://www.aldiwan.net/poem37924.html","مجزوء الرمل"],[500,"والحواميم وهي أقسام مثلي","https://www.aldiwan.net/poem38024.html","الخفيف"],[500,"أي راح دارت به الأقداح","https://www.aldiwan.net/poem38045.html","الخفيف"],[500,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[515,"إن قلت قد خرست خلاخل ساقها","https://www.aldiwan.net/poem12193.html","الكامل"],[515,"خطبتني الخطوب بالهم لما","https://www.aldiwan.net/poem12295.html","الخفيف"],[558,"إن قوما لم يروا","https://www.aldiwan.net/poem34263.html","مجزوء الرمل"],[559,"تأدب بباب الدير واخلع به النعلا","https://www.aldiwan.net/poem69348.html","الطويل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"شهد اللمى في المرشفين لها","https://www.aldiwan.net/poem3031.html","أحذ الكامل"]],"verses":[["وَعِظامُ البَلاءِ صا","روا عِظاماً بَوالِيا",0,"ي",2,0],["وَعَظُمتَ قَدراً أَن يَروقَكَ مَغنَمٌ","أَو أَن يَصِرَّ عَلى بَنانِكَ دِرهَمُ",1,"م",1,0],["وَعَظَّمَ اللَهُ في عُثمانَ أَجرَكُمُ","في رَحمَةِ اللَهِ أَمسى خَيرَ مَغمودِ",2,"د",1,0],["وَعَظَائِماً لِلشَّرْقِ قَدْ","أَعْنَتْ مِنَ الْغَرْبِ الرِّقَابَا",3,"ب",2,0],["وَعَظيمَةٍ دافَعتُها فَتَحَوَّلَت","عَنّي فَلَم أَدنَس وَصَحَّ أَديمي",4,"م",2,0],["وعظتم وقد أحصيتمُ درجاتها","كما صدحت فوق الغصون الحمائم",5,"م",1,0],["وعظْتُ نفسي فخالفتْ عِظتي","وخالفَ القلبُ فيك من وَعظه",6,"ظ",2,0],["وعظتُك أيها الإنسانُ وعظي","فلا أكُ واعظَ الدّمنِ الخوالي",7,"ي",1,0],["وعظَ اللَّهُ والكتابُ فصممْ","تُ وأقدمت أيما إقدام",8,"م",1,0],["وَعظُمُ الكَونُ لَدَينا جُرمُهُ","وَتَراهُ عِندَها قَد صَغُرا",9,"ر",2,0],["وَعِظامٌ تَتَزَكّى عَنبَراً","مِن ثَناءٍ صِرنَ أَغفالَ الرُموس",10,"س",1,0],["وَعَظَ البُحتُرِيَّ إيوانُ كِسرى","وَشَفَتني القُصورُ مِن عَبدِ شَمسِ",11,"س",1,0],["وَعُظمُ قَدرِكَ في الآفاقِ أَوهَمَني","أَنّي بِقِلَّةِ ما أَثنَيتُ أَهجوكا",12,"ك",2,0],["وَعُظمُ بَلِيَّتي أَلّا أَرى لي","عَلى مَكروهِ دافِعِها مُعينا",13,"ن",2,0],["وَعَظتَكَ أَجداثٌ خُفُت","فيهِنَّ أَجسادٌ سُبُت",14,"ت",1,1],["وعظيم الهولِ لولا آيةٌ","لم يكُنْ راكبُهُ إلّا أثيمْ",15,"م",1,0],["وَعِظْتَ بلمّتك الشائبه","وفقد شبيبتك الذاهبَهْ",16,"ب",2,1],["وَعَظَ اللَبيبُ فَأَينَ مِنّا مَن يَرى","وَدَعا المُهيبُ فَأَينَ فينا مَن يَعي",17,"ع",2,0],["وُعِظْتُمْ فَزِدْتُمْ بالمواعِظِ قَسْوَةً","وَلَيسَ يُفيدُ القدحُ إِن أصلَدَ الزَّندُ",18,"د",1,0],["وَعَظَتكَ واعِظَةُ القَتيرِ","وَنَهَتكَ أُبَّهَةُ الكَبيرِ",19,"ر",1,1],["وَعَظتُ قَوماً فَلَم يُرعوا إِلى عِظَتي","مِثلَ اِمرِىءِ القَيسِ ناجي طائِرَ الوادي",20,"ي",1,1],["وَعَظَ الزَمانُ فَما فَهِمتَ عِظاتِهِ","وَكَأَنَّهُ في صَمتِهِ يَتَكَلَّمُ",21,"م",1,1],["وعظْمِ ما لاقَتْ من العدوِّ","والحربِ في الرَّواحِ والغُدوِّ",22,"و",1,0],["وَعِظامُ الرِجالِ مِن كُلِّ جِنسٍ","في رِضاكُنَّ أَرخَصوا كُلَّ غالي",23,"ل",2,0],["وَعَظَتْكَ أيّامٌ تَمُرُّ","فهل فَهِمْتَ مَقَالَها",24,"ل",3,0],["وعظام تتزكّى عنبرا","من ثناء صرن أغفال النفوس",25,"س",1,0],["وَعَظِيمٌ مِنْكُما المُبْدِ","ئُ شَأْناً وَالمُتِمُّ",26,"م",1,0],["وَعَظِيمُ النَّجَاحِ يَصْدُرُ عَنْ رَأْ","سٍ حَكِيمٍ وَعَنْ فُؤادٍ غَيُورِ",27,"ر",1,0],["وَعَظِيمُ الرِّجَالِ تَعْلمُ مَنْ جَلَّ","عَلَى قَدْرِ مَا تَجِلُّ الأُمُورُ",28,"ر",1,0],["وَعَظَتني الدُنيا مَواعِظَ شَتّى","وَأَقَلُّ العِظاتِ تَكفي اللَبيبا",29,"ب",2,0],["وعظ (البحتري) إيوان (كسرى)","شفتني القصور من (عبد شمس)",30,"س",1,0],["وعظيم علي قولك أني","واجدٌ بعدها بديلا أغرا",31,"ر",2,0],["وعظم حبيباً لا يراك دوامه","وما دمت إلا بالبُكَا لك عظَّما",32,"م",2,0],["وعظيم القدر والحرز المنيعِ","وأبَا الإحسانِ والحسنِ البديعِ",33,"ع",1,0],["وعظت بمصرعهِ الحصوادِثُ عنوةً","ناهيكَ من وعظٍ بغيرِ كلامِ",34,"م",1,0],["وَعَظَتهُم آياتُكَ اللائي حَطَّت","عَن رِجالِ الخِلافَةِ الأَعباءَ",35,"ا",2,0],["وَعَظَّمَ رَبُّ العَرشِ شيمَةَ خُلقِهِ","وَمَن ذايُماري في عُلاهُ وَسَبقِهِ",36,"ه",1,0],["وعظْ بنصحك من ضاقت بمهجتهِ","عن النصيحةِ في طاعاتِنا السبُلُ",37,"ل",1,0],["وعظت ولكن ما اتعظت فضائح","بطرسك تنبي عنك وسط المحاضر",38,"ر",1,0],["وَعَظتني بِجَهلِها فَأَفادت","نِيَ رُشداً وَفاتَ رُشدي هُداها",39,"ا",3,0],["وعَظُمتَ وصْفا في السَّماعِ فمُذْ بَدا","للعينِ خُبْرُك هانتِ الأخبار",40,"ر",1,0],["وعظيمٌ كل ما فيه جميل","كالبيان العذب في المعنى النبيل",41,"ل",1,0],["وَعَظيم دين لا يَقوم بحمله","رضوى وَلا الصخرات من ثهلان",42,"ن",1,0],["وَعَظ اِبنُ الجاموسِ في حَرِّ آبٍ","فَشَكَونا مِن وَعظِهِ الزَمهَريرا",43,"ر",2,1],["وَعظه في كانونَ إِن يَذكُرِ الجن","نةَ يَختار السامِعونَ السَعيرا",43,"ر",2,0],["وعظوا القاضي إذ","بالعدل يسمو ذو المقام",44,"م",1,0],["وَعظَّمَ اللهُ أَجرَ الدينِ فهو شجٍ","وأَلهم الطهرَ عنك الصبرَ فهو كما",45,"م",2,0],["وَعَظيمُ المَلا بِفِعلِكَ راضِ","أَينَما كُنتُ وَالمَحامِدُ تَشكُرُ",46,"ر",1,0],["وَعَظيمُ رَأيِكَ بَثُّهُ فَبِناؤُهُ","مِن ثاقِبِ الفِكرِ اِعتَلى تَشييدُهُ",47,"د",2,0],["وَعَظُمَ حُزنٌ عَلى ما خيفَ مِن تَلَفِ","وَالمَلِكُ لِلخَسفِ قَد أَمسى عَلى شَرَفِ",48,"ف",1,0],["وَعِظهُم بأَنَّ الماءَ بِالعَدلِ قِسمَةٌ","فَلي شِربُ يَومٍ بَعدَهُم وَلَهُم شِربُ",49,"ب",1,0],["وَعَظيمِ المُلكِ قَد أَوعَدَنِي","وَأَتَتنِي دُونَهُ مِنهُ النُّذُرْ",50,"ر",1,0],["وعظيمُ البلاء رفع الرذيل","فالبلاءُ الشديدُ أنْ يُستَعاذا",51,"ذ",2,0],["وعَظَّمتَني في نفس كلّ معاند","فلا زلْتَ في نفس المعالي مُعَظَّما",52,"م",2,0],["وعظَ الشَّيبُ والحوادثُ فيها","وفؤادي ذاك المصرُّ الجسورُ",53,"ر",1,0],["وعظتنا به الخطوبُ فما أع","جبُ إلاَّ من قلة الأفهامِ",54,"م",1,0],["وعظمه في ارتعاش","ومشيه بانكباب",55,"ب",1,0],["وعَظُمْنا طوراً وحالاً وسِرًّا","ومُحِقْنا وجداً وبالشَّوقِ ذُبْنَا",56,"ن",2,0],["وعَظيمٌ فارسٌ شَمْ","خٌ وذو طِمْرَيْنِ راجِلْ",57,"ل",1,0],["وعِظامي أَقلامُ شَوْقي ودَمْعي","حبرُ طَرْسي وبسطَةُ الرِقِّ جلْدِي",58,"د",2,0],["وعِظامي إلى سفينةِ قُرْبي","لِحِماكُمْ وحقَّكمْ ألواحُ",59,"ح",1,0],["وعظِّمِ الخِلَّ الوَفِيَّ باطِناً","وخلِّ بالإِهمالِ قلباً من جَفَا",60,"ا",1,0],["وعظيمة يشكو المخنق ضيقها","وسعت منه بعد ضيق خناقها",61,"ق",3,0],["وعظيماً من البلايا قطيعاً","وغموراً قد ضاعفت أحزاني",62,"ي",1,0],["وعظامي قد بروا","ليت شعري هل دروا",63,"ا",1,0],["وعَظَّمْ بِهِ القسيسَ إِنْ شئتَ خُطوةَ","وكَبِّر بِهِ الشَّمَاسَ إِنْ شِئتَ أَنْ تَعْلا",64,"ل",2,0],["وعظمت أفعاله واشتهرت","في الناس في ذلك لما كثرت",65,"ت",1,0],["وعظائمٌ قد صار أَهونها","بسدادِه ما كان أَهْوَلها",66,"ل",3,0]]}