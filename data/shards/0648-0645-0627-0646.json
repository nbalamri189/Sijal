34","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[106,"حديث خرافة","https://www.poetsgate.com/ViewPoem.aspx?id=179406",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[45,"أكَانَ الصّبا إلاّ خَيالاً مُسَلِّما","https://www.poetsgate.com/ViewPoem.aspx?id=31879",""],[35,"أقولُ ونِضْوِي واقِفٌ عِنْدَ رَمْسِها","https://www.poetsgate.com/ViewPoem.aspx?id=21992",""],[28,"لقد عضت لئام بني فقيم","https://www.poetsgate.com/ViewPoem.aspx?id=21538",""],[3,"ألاَ هلْ أتاها أنَّ يوم عراعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10715&r=&rc=69",""],[92,"تَبَرَّمْتَ بالعيشِ خوفَ الفناءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14572&r=&rc=17",""]],"verses":[["وَما نَحَروا بِخَيفِ مِنىً وَكَبّوا","عَلى الأَذقانِ مُشعَرَةً ذُراها",0,"ا",3,0],["وَما نَهَضَ اِمرُؤٌ بِالحَزمِ إِلّا","وَصادَفَ حِلمَهُ مُلقى الجِرانِ",1,"ن",1,0],["وَما نامَ إِغضاءً عَنِ الدَهرِ صارِمي","وَلَكِنَّني أُبقي عَلى غَيرِ راحِمِ",2,"م",1,0],["وَما نُوَبُ الأَيّامِ إِلّا أَسِنَّةٌ","تَهاوى إِلى أَعمارِنا وَنِصالُ",3,"ل",1,0],["وَما نُطفَةٌ مَشمولَةٌ بِمَجَمَّةٍ","وَعاها صَفاً مِن طامِنِ الطَودِ فارِعُ",4,"ع",1,0],["وَما نَحنُ إِلّا عارِضٌ إِن قَصَدتَهُ","لِجودٍ حَباكَ النائِلَ الغَمرَ بِالقَطرِ",5,"ر",1,0],["وَما نَظَرتَ إِلى الأَيّامِ مُعتَبِراً","إِلّا وَأَعطاكَ كَنزَ العِبرَةِ النَظَرُ",6,"ر",1,0],["وَما نافِعي عِندَ البَعيدِ تَقَرُّبي","وَلا ضائِري عِندَ القَريبِ التَجَنُّبُ",7,"ب",1,0],["وَما نَحنُ أَنتَ وَكُلٌّ إِلى","دُعاءِ العُلى طَرِبٌ مُستَجيبُ",8,"ب",1,0],["وما نَهْنَهَتْني دونَها خَشيَةُ الرّدى","وهَلْ هيَ إلا مُهْجَةٌ وشَعوبُها",9,"ب",3,0],["وما نظَري شَطْرَ الدِّيارِ بنافِعٍ","وأيُّ فَصيحٍ يَرتَجي نَفْعَ أعجَمِ",10,"م",1,0],["وما نِلْتُ إلا نَظْرَةً منْ ورائِها","عَفافي وذَيَّاكَ الحَديثُ المُكَتَّمُ",11,"م",1,0],["وَما نَذِروا حَتّى غَشَينا بُيوتَهُم","بِغَبيَةِ مَوتٍ مُسبَلِ الوَدقِ مُزعِفِ",12,"ف",1,0],["وَما نُصَدِّقُ إِنساناً يُحَدِّثُنا","حَتّى يَجيءَ عَلى قَولٍ بِمِصداقِ",13,"ق",1,0],["وما نظْرَةٌ منّي إليْكَ أعُدُّها","سوَى نعْمَةٍ للّهِ فيَّ كَبيرَهْ",14,"ر",2,0],["وَمَا نَالَتِ الأَشْرَافُ مَا نِلْتَ مِنْ عُلاَ","وَلاَ لَكَ نِدٌّ فِي الْعُلاَ وَالْمَنَاقِبِ",15,"ب",1,0],["وما نَهَى عُمَرٌ في يومِ مَصرعِه","نِساءَ مَخزومَ أن تَبكي بَواكيها",16,"ي",3,0],["وَما نافِعي أَن يَبلُغَ العَرشَ صاحِبي","وَيَنحَطَّ قَدري في الثَرى مِثلَ ما يَعلو",17,"و",1,0],["وَما نافِعي أَنَّ المِياهَ سَوائِحٌ","عِذابٌ وَلَم يُنقع بِهنَّ غَليلُ",18,"ل",1,0],["وَما نَظَرَت عيني إِلى ذي بَشاشَةٍ","مِن الناسِ إِلّا أَنتِ في العَينِ أَملَحُ",19,"ح",1,0],["وَمَا نَظَرَتْ عيْنِي مَعَاهِدَ أُنْسِنَا","سَأَبْكِي وَأَسْتَبْكِي عَلَيْكَ القَوَافِيَا",20,"ي",2,0],["وَمَا نَقَشَتْ مِنْهَا الْبَوَارِقُ مُهْمَلٌ","وَمَا نَقَطَتْ مِنْهَا الْبَنَادِقُ مُعْجَمُ",21,"م",1,0],["وَما نَيلُ المَكارِمِ بِالتَمَنّي","وَلا بِالقَولِ يُبلي الفاعِلونا",22,"ن",2,0],["وما نحن إلاّ الليث شُدَّت قيوده","وأُلقي حياً شبله في فم الذئب",23,"ب",1,0],["وَما نَوَّخوها قَينَكُم آلَ ضَوطَرٍ","لَأَلأَمَ مَن يَحذى عَلى قَدَمٍ نَعلا",24,"ل",2,0],["وَما نَفَعَ المُستَعمَلينَ غُلولُهُم","وَما نَفَعَت أَهلَ العُصاةِ الجَعائِلُ",25,"ل",1,0],["وَما نامَ إِذ باتَ الحَواضِنُ وُلَّهاً","وَهُنَّ سَبايا لِلصُدورِ بَلابِلُ",25,"ل",1,0],["وَما نَحنُ أَعطَينا أُسَيدَةَ حُكمَها","لِعانٍ أُعِضَّت في الحَديدِ سَلاسِلُه",26,"ل",2,0],["وَما نَسَجَت أَسرادَ داوُدَ وَاِبنِهِ","مُضاعَفَةً مِن نَسجِهِ إِذ يُقابِلُ",27,"ل",1,0],["وَما نَحنُ إِلّا وائِلٌ وَمُهَلهَلٌ","صَفاءً وَإِلّا مالِكٌ وَمُتَمِّمُ",28,"م",1,0],["وَما نالَ مَحمِيُّ الرَغائِبِ عَنوَةً","سِوى ما أَقَلَّت في الجُفونِ الحَمائِلُ",29,"ل",1,0],["وَما نِعمَةٌ مَشكورَةٌ قَد صَنَعتُها","إِلى غَيرِ ذي شُكرٍ بِمانِعَتي أُخرى",30,"ر",2,1],["وما نقصتْ محاسنها ولكن","ليحلفَ واصفوها بالثلاث",31,"ث",1,0],["وما نافعي أطراف طرفيَ دونه","إذا كانَ طرف القلب ليس بمطرق",32,"ق",1,0],["وما نافعي تحت الدّجى نصب فيئتي","وقد حيل بين العير والنَزَوان",33,"ن",1,0],["وما نافعي تحت الدجى فمنيتي","وقد حيل بين العير والنزوان",34,"ن",1,0],["وما نَفْرُ نفسٍ من حلول مصيبةٍ","وقد أيقَنَتْ قِدماً بما هو آتِ",35,"ت",1,0],["وَمَا نِلْتُمُ مانلتمُ أنْ جُدِدْتُمُ","ولكن جَدَدْتُمْ والمُضِيعُونَ سُمَّدُ",36,"د",1,0],["وما نسيتُ أبا إسحاقَ مائرنا","تلك الفكاهات سِيقتْ نحوه المِير",37,"ر",1,0],["وما نجمُ رأيي في الخطوبِ بآفلٍ","ولا حينَ تنقضُّ النجومُ بمنقضّ",38,"ض",1,0],["وما نهتْهم عن المرعَى وخامتُه","لكنه أسنقَ الراعين مرعاكا",39,"ك",2,0],["وما نفحاتُ الروض تثنِي على الحيا","بأطيبَ من ذكراكمُ في المحافلِ",40,"ل",1,0],["وما نزل الإصحارَ إلا كقانصٍ","أريبٍ توارى عند بثّ الحبائلِ",40,"ل",1,0],["وَما نالَني مِن أَنعُمِ اللَهِ نِعمَةٌ","وَإِن عَظُمَت إِلّا وَأَنتَ سَفيرُها",41,"ر",3,0],["وما نشوةُ الحبِّ عندَ المحبِّ","وما سِحْرُ ذاك الرَّبيعِ الوليدْ",42,"د",1,0],["وما نمت عن مصر إذا الناس هوموا","يرين الكرى من عينهم بالمعاقد",43,"د",1,0],["وما نألو نهارك ذكريات","ولا برهان غرتك التماحا",44,"ح",2,0],["وَما نَمَّ وَلا هَمَّ","بِبَعضِ الكَيدِ وَالدَسِّ",45,"س",1,0],["وَما نَيلُ المَطالِبِ بِالتَمَنّي","وَلَكِن تُؤخَذُ الدُنيا غِلابا",46,"ب",2,0],["وَما نَجا مِن شِفارِ البيضِ مُنفَلِتٌ","نَجا وَمِنهُنَّ في أَحشائِهِ فَزَعُ",47,"ع",1,0],["وَما نَقَمَ الحُسّادُ إِلّا أَصالَةً","لَدَيكَ وَفِعلاً أَريَحِيّاً مُهَذَّبا",48,"ب",2,0],["وَما نُخِلُّ بِتَقريظٍ نَخُصُّ بِهِ","أَبا مُحَمَّدِهِم شُكراً وَإِحمادا",49,"د",2,0],["وَما نَقَلَت مِنهُ الخِلافَةُ شيمَةً","وَقَد مَكَّنَتهُ عَنوَةً مِن قِيادِها",50,"د",3,0],["وَما نادَيتِني لِلشَوقِ إِلّا","عَجِلتُ بِهِ فَلَبَّيتُ المُنادي",51,"ي",1,0],["وَما نِلتُ مِن جَدوى أَبيهِ وَجَدِّهِ","وَما رَفَعا لي مِن سَناءٍ وَمِن ذِكرِ",52,"ر",1,0],["وَما نَحنُ إِلّا كَالقَضاءِ فَإِنَّنا","ضَرَبنا جَميعَ الناسِ بِالخَيرِ وَالشَرِّ",53,"ر",1,0],["وَما نَكَرنَ الغَداةَ مِن غُصُنٍ","يَحسُنُ في الإِنثِناءِ وَالقَصَفِ",54,"ف",1,0],["وَما نَقَموا إِلّا تَخَرُّقَ مُنعَمٍ","يَطوعُ لَهُم إِحسانُهُ فَيَطولُ",55,"ل",1,0],["وَما نَوَّرَ الرَوضُ الشَآمِيُّ بَل فَتىً","تَبَسَّمَ مِن شَرقِيِّهِ فَتَبَسَّما",56,"م",2,0],["وَما نَقَلَت لَوعَتي لِمَّةٌ","تَنَقَّلُ في حُدثِ أَلوانِها",57,"ن",3,0],["وَما نَهَضَت فُقَيمٌ لِلمَعالي","بِزِندٍ في الفَخارِ وَلا عَديدِ",58,"د",1,0],["وَما نَبا السَيفُ مِن جُبنٍ وَلا دَهَشٍ","عِندَ الإِمامِ وَلَكِن أُخِّرَ القَدَرُ",59,"ر",1,0],["وَما نَحنُ نَبكي غالِباً لَيسَ غَيرُنا","وَلَكِن سَيَبكي غالِباً كُلُّ عايِلِ",60,"ل",1,0],["وما نُبالي بِذَمِّ الأغبياءِ إذا","كانَ اللَّبيبُ من الأقوام يُطرِينا",61,"ن",2,0],["وما نَقَمُوا إلا مَقالَةَ مُعْلنٍ","بأنَّ أبا السِّبْطَينِ خَيْرُ الخَلائفِ",62,"ف",1,0],["وَما نَحسَبُ الصاعاتِ تُقطَعُ مُدَّةً","عَلى أَنَّها فينا سَريعٌ دَبيبُها",63,"ب",3,0],["وَما نالَ عَبدٌ قَطُّ فَضلاً بِقُوَّةٍ","وَلَكِنَّهُ مَنُّ الإِلَهُ وَفَضلُهُ",64,"ل",2,0],["وَما نِلتُ مِن مَأمولِ وَصلِكُمُ رِضى","وَلا ذُقتُ مِن رَوعاتِ هَجرِكُمُ أَمنا",65,"ن",2,0],["وَما نابَ عَنكَ الغَيرُ عِندي وَقَلَّما","يَنوبُ عَنِ الماءِ القَراحِ صَعيدُ",66,"د",1,0],["وَمَأَنتَ وَالفَحصَ عَن شانِها","وَما قَمُّصوكَ بِأَثوابِها",67,"ب",3,0],["وما نَجوتُ بِنَفسي عَنكِ راغِبَةً","وإنّما مَدّ عُمْري قاصرٌ عُمُرَك",68,"ك",1,0],["وما نَوّمَتْ عَزْمَتي بلدةٌ","تُنَبّهُ في الغمر عَجْزَ البليدِ",69,"د",1,0],["وَما نَفعُ مَن قَد ماتَ بِالأَمسِ صادِياً","إِذا ما سَماءُ اليَومِ طالَ اِنهِمارُها",70,"ر",3,0],["وَما نَكبَةٌ فاتَت بِهِ بِعَظيمَةٍ","وَلَكِنَّها مِن أُمَّهاتِ العَظائِمِ",71,"م",1,0],["وما نفاقي وكسادي على","قلبي ولا فكريَ منهُ لمامْ",72,"م",1,0],["وَما نُعمٌ وَلَو عُلِّقتُ نُعماً","بِجازِيَةِ النَوالِ وَلا مُثيبِ",73,"ب",1,0],["وَما نَظَرَت عَيني إِلى وَجهِ قادِمٍ","مِنَ الحَجِّ إِلّا بَلَّ دَمعي رِدائِيا",74,"ي",2,0],["وَما نَظَري مِن نَحوِ نَجدٍ بِنافِعي","أَجَل لا وَلَكِنّي عَلى ذاكَ أَنظُرُ",75,"ر",1,0],["وما نَفْعُ الحياةِ لِكلّ حَيٍّ","إذا ما أصبحت داءً عَقاما",76,"م",2,0],["وما نبغي إذا رُمْنا انتصافاً","إلى شيءٍ سوى الكرمِ احْتِكاما",77,"م",2,0],["وما نَفْعُ الخلافةِ حين تُمسِي","حديثَ خُرافةٍ للهازلينا",78,"ن",2,0],["وما نكبت مواليَها المعالي","كما نكبت مواليَها الدَّنايا",79,"ا",3,0],["وما نَفَعَ النُّفوسَ ولا هَداها","كنُورِ الله خيرِ المُنزِلينا",80,"ن",2,0],["وَما نَكَبَت عَن مَعالي الأُمورِ","عَلى الرَيثِ مِن أَمرِها وَالعَجَلْ",81,"ل",1,0],["وَما نَقَمَت إِلّا الحَنانَ أَثارَهُ","صَريعٌ تَرَدّى وهو حرَّان مُتعَبُ",82,"ب",1,0],["وما نَظرتْ أعينُ الدَّارعين","كأدراعهِ الغالياتِ القِيَمْ",83,"م",1,0],["وما نَسَبٌ بأقربَ من سبيلٍ","يُؤلِّفُ بين أشتاتِ القُلوبِ",84,"ب",1,0],["وما نِلتَ خيراً إذ أتيت ابن مشكمٍ","وكنت امرأ أعمى الهوى لا يرى رشدا",85,"د",2,0],["وَما نكّبَت عَن شاكر بَعد فَيصَلٍ","وَغالَت عَلياً وَاللواعج في الصَدرِ",86,"ر",1,0],["وَما نيلُ مِصرَ قُبَيلَ الشَفى","إِذا نَفَحَت ريحُهُ النافحَه",87,"ح",2,0],["وَما نَسينا مَصرَعَ الكَفورِ","الجاهِلِ المُخَلِّطِ المَغرورِ",88,"ر",1,0],["وَما نالَ مِنها فَهوَ مِنهُ كَمُدَّعٍ","حَقائِقَ أَمرٍ غامِسٍ بِالنَفائِسِ",89,"س",1,0],["وَما نَقْدِيَّةُ السُّلْطَانِ إلاَّ","مَعَ المُسْتَخْدَمِينَ مُجَرَّدِينا",90,"ن",2,0],["وما نَظَرْتَ إليه كلّما جَعَلَتْ","تمْتَدُّ منه برأسِ الفارسِ الخَطِل",91,"ل",1,0],["وما نَقَمُوا إلاّ قديمَ تَشَيُّعي","فنَجّى هِزَبْراً شَدُّهُ المُتَدارك",92,"ك",1,0],["وَما نَسيتُ مَكانَ الآمِرينَ بِذا","مِنَ الوُشاةِ وَلَكِن في فَمي ماءُ",93,"ا",2,0],["وَما نِلتُها حَتّى تَولَّت شَبيبَتي","وَحَتّى نَهاني الهاشِمِيُّ المُغَرَّرُ",94,"ر",1,0],["وَما نَلقاهُمُ إِلّا صَدَرنا","بِرِيٍّ مِنهُمُ وَهُمُ حِرارُ",95,"ر",1,0],["وَما نالَ شَيئاً طالِبٌ بِجَلادَةٍ","وَلَكِن لِقَومٍ حُظوَةٌ وَجُدودُ",96,"د",1,0],["وَما نَحنُ إِلّا كَالخَليطِ الَّذي مَضى","فَرائِسُ دَهرٍ مُخطِئٍ وَمُصيبِ",97,"ب",1,0],["وَما نُوَبُ الأَيّامِ إِلّا كَتائِبٌ","تُبَثُ سَرايا أَو جُيوشٌ تُعَبَّأُ",98,"ب",2,0],["وَما نُفيقُ مِنَ السُكرِ المُحيطِ بِنا","إِلّا إِذا قيلَ هَذا المَوتُ قَد جاءَ",99,"ا",2,0],["وَما نَفَسٌ إِلّا يُباعِدُ مَولِداً","وَيُدني المَنايا لِلنُفوسِ فَتَقرُبُ",100,"ب",1,0],["وَما نالَت خِلافَتَها قُرَيشُ","وَأَرغِمَ سَعدُها إِلّا بِسَعدِ",101,"د",1,0],["وَما نَفَعَ المُبَرِّدَ مِن حَميمٍ","وَصادَت ثَعلَباً نُوَبٌ ضَواري",102,"ي",1,0],["وَما نَفسُ حَسّانَ الَّذي شاعَ جُبنُهُ","بِأَسلَمَ مِن نَفسِ الكَميِّ المُخالِسِ",103,"س",1,0],["وَما نَحُنُ أُم ما بَرايا عالَمٍ كُثُرٍ","في قُدرَةٍ بَعضُها الأَفلاكَ يَبتَلِعُ",104,"ع",1,0],["وَما نَفَعَ الأَوائِلَ مِن قُرَيشٍ","وُلاةَ الحِجرِ ما اِجتَذَبوا وَمَكّوا",105,"ك",3,0],["وَما نَأَتِ القَرابَةُ مِن رِجالٍ","أَبوهُم يافِثٌ وَأَبوكَ سامُ",106,"م",1,0],["وَما نَطَقوا بِهِ تَشبيبَ أَمرٍ","كَما بَدَأَ المَديحَ مُشَبِّبوهُ",107,"ب",3,0],["وَما نالَ الهَجينُ مِنَ المعالي","إِذا خَطَبَ الكَريمَةَ وَاِستَراها",108,"ا",3,0],["وما نَعشُهُ إلا كنَعشٍ وَجَدْتُهُ","أباً لبَناتٍ لا يَخَفنَ من اليُتْمِ",109,"م",1,0],["وما نَغَمُ الأوْتارِ في سمْعِ أُذْنِهِ","بأحْسَنَ صَوْتاً مِن رُغاء سَوامهِ",110,"م",2,0],["وَما نَحَني كَمِنَاحِ العَلُو","قِ ما ترَ مِن غِرَّةٍ تَضرِبِ",111,"ب",1,0],["وَما نالَ ما كانَ يرَجو امرؤٌ","تجنب للعقبات اقتحاما",112,"م",2,0],["وما نَسِيتْ دجلةً إنها","بشطَّيهِ حائمة طائفَه",113,"ف",2,0],["وما نظرَ العشَّاقُ إلَّا لعالمٍ","يُعَظِّمُ في المعشوقِ كلَّ صغيرةِ",114,"ه",1,0],["وما نِلْتُ مِنْكَ النَّصْفَ حتَّى ارْتَمَت بك","المَنايا بسَهْمٍ صائِبِ الوَقْعِ أعْجَفِ",115,"ف",1,0],["وما نَهْنَهَتُ عن طَلَبٍ ولكِنْ","هيَ الأيّامُ لا تُعْطي قِيادا",116,"د",2,0],["وما نلت مالاً قط إلا ومال بي","ولا درهماً إلا ودر بي الهم",117,"م",1,0],["وَما نَطَقَت بِاللَيلِ سارِيَةُ القَطا","وَما صَدَحَت في الصُبحِ غادِيَةُ الكُدرِ",118,"ر",1,0],["وَمَا نِعَمُ الحَيَاةِ وَمَا مُنَاهَا","بِلاَ وَطَنٍ عَزِيزِ الشأْنِ حُرِّ",119,"ر",1,0],["وَما نَزَحَت لِلعَينِ بَعدَكِ عَبرَةٌ","إِذا اِنحَدَرَت قادَت لَها أَخَواتِ",120,"ت",1,1],["وَما نُصِرَ الحَجّاجُ إِلّا بِغَيرِهِ","عَلى كُلِّ يَومٍ مُستَحَرِّ المَلاحِمِ",121,"م",1,0],["وَما نالَ أَصحابُ السَقيفَةِ إِمرَةً","بِدَعوى تُراثٍ بَل بِأَمرِ تِراتِ",122,"ت",1,0],["وما نقولُ لأبطالٍ لنا سَلَفوا","إذا تَهدَّم ما كانُوا يَشيدونَا",123,"ن",2,0],["وما نقولُ لعمرٍو حينَ يسأَلُنا","إن لم نُجِبْ قبلَهُ بالسيفِ غازِينَا",123,"ن",2,0],["وما ندري له معنىً","ولا قائِلُه يدري!",124,"ر",2,0],["وما نَعْصِي نصائحَك الغَوَالي","ولكن كيف يمكن الامتثال؟",125,"ل",1,0],["وَمَا نَوّرَ الرّوْضُ الشآميُّ بَلْ فَتًى","تَبَسّمَ مِنْ شعرْقِيّهِ، فَتَبَسّما",126,"م",2,0],["وما نظرت عيني إلى ذي بشاشة","ٍ من النّاسِ إلاّ وهيَ في العينِ أملحُ",127,"ح",1,0],["وَمَا نهَضَتْ فُقَيْمٌ للمَعَالي،","بِزَنْدٍ في الفخَارِ وعلا عَدِيدِ",128,"د",1,0],["وما نذروا حتى غشينا بيوتهمْ","بغيبة ِ موتٍ مسبلِ الودقِ مزعفِ",129,"ف",1,0],["وما نشوة ُ الحبّ عندَ المحبِّ","وما صرخة ُ القلبِ عندَ الصّدودْ",130,"د",1,0]]}