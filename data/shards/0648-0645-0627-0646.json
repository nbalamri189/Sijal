wan.net/poem68430.html","الطويل"],[559,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[563,"لعمرك ليس فوق الأرض باق","https://www.aldiwan.net/poem52859.html","الوافر"],[565,"أعيدوا لنا التاريخ احيوا لنا الذكرى","https://www.aldiwan.net/poem854.html",""],[576,"كتاب كريم جاءني بعد فترة","https://www.aldiwan.net/poem2721.html","الطويل"],[576,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[576,"رأت منك رائيتي ما تحب","https://www.aldiwan.net/poem3095.html","المتقارب"],[576,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"],[588,"دع للعبرات تنسجم انسجاما","https://www.aldiwan.net/poem11522.html","عموديه"]],"verses":[["وَما نَحَروا بِخَيفِ مِنىً وَكَبّوا","عَلى الأَذقانِ مُشعَرَةً ذُراها",0,"ا",3,0],["وَما نَهَضَ اِمرُؤٌ بِالحَزمِ إِلّا","وَصادَفَ حِلمَهُ مُلقى الجِرانِ",1,"ن",1,0],["وَما نامَ إِغضاءً عَنِ الدَهرِ صارِمي","وَلَكِنَّني أُبقي عَلى غَيرِ راحِمِ",2,"م",1,0],["وَما نُوَبُ الأَيّامِ إِلّا أَسِنَّةٌ","تَهاوى إِلى أَعمارِنا وَنِصالُ",3,"ل",1,0],["وَما نُطفَةٌ مَشمولَةٌ بِمَجَمَّةٍ","وَعاها صَفاً مِن طامِنِ الطَودِ فارِعُ",4,"ع",1,0],["وَما نَحنُ إِلّا عارِضٌ إِن قَصَدتَهُ","لِجودٍ حَباكَ النائِلَ الغَمرَ بِالقَطرِ",5,"ر",1,0],["وَما نَظَرتَ إِلى الأَيّامِ مُعتَبِراً","إِلّا وَأَعطاكَ كَنزَ العِبرَةِ النَظَرُ",6,"ر",1,0],["وَما نافِعي عِندَ البَعيدِ تَقَرُّبي","وَلا ضائِري عِندَ القَريبِ التَجَنُّبُ",7,"ب",1,0],["وَما نَحنُ أَنتَ وَكُلٌّ إِلى","دُعاءِ العُلى طَرِبٌ مُستَجيبُ",8,"ب",1,0],["وما نَهْنَهَتْني دونَها خَشيَةُ الرّدى","وهَلْ هيَ إلا مُهْجَةٌ وشَعوبُها",9,"ب",3,0],["وما نظَري شَطْرَ الدِّيارِ بنافِعٍ","وأيُّ فَصيحٍ يَرتَجي نَفْعَ أعجَمِ",10,"م",1,0],["وما نِلْتُ إلا نَظْرَةً منْ ورائِها","عَفافي وذَيَّاكَ الحَديثُ المُكَتَّمُ",11,"م",1,0],["وَما نَذِروا حَتّى غَشَينا بُيوتَهُم","بِغَبيَةِ مَوتٍ مُسبَلِ الوَدقِ مُزعِفِ",12,"ف",1,0],["وَما نُصَدِّقُ إِنساناً يُحَدِّثُنا","حَتّى يَجيءَ عَلى قَولٍ بِمِصداقِ",13,"ق",1,0],["وما نظْرَةٌ منّي إليْكَ أعُدُّها","سوَى نعْمَةٍ للّهِ فيَّ كَبيرَهْ",14,"ر",2,0],["وَمَا نَالَتِ الأَشْرَافُ مَا نِلْتَ مِنْ عُلاَ","وَلاَ لَكَ نِدٌّ فِي الْعُلاَ وَالْمَنَاقِبِ",15,"ب",1,0],["وما نَهَى عُمَرٌ في يومِ مَصرعِه","نِساءَ مَخزومَ أن تَبكي بَواكيها",16,"ي",3,0],["وَما نافِعي أَن يَبلُغَ العَرشَ صاحِبي","وَيَنحَطَّ قَدري في الثَرى مِثلَ ما يَعلو",17,"و",1,0],["وَما نافِعي أَنَّ المِياهَ سَوائِحٌ","عِذابٌ وَلَم يُنقع بِهنَّ غَليلُ",18,"ل",1,0],["وَما نَظَرَت عيني إِلى ذي بَشاشَةٍ","مِن الناسِ إِلّا أَنتِ في العَينِ أَملَحُ",19,"ح",1,0],["وَمَا نَظَرَتْ عيْنِي مَعَاهِدَ أُنْسِنَا","سَأَبْكِي وَأَسْتَبْكِي عَلَيْكَ القَوَافِيَا",20,"ي",2,0],["وَمَا نَقَشَتْ مِنْهَا الْبَوَارِقُ مُهْمَلٌ","وَمَا نَقَطَتْ مِنْهَا الْبَنَادِقُ مُعْجَمُ",21,"م",1,0],["وَما نَيلُ المَكارِمِ بِالتَمَنّي","وَلا بِالقَولِ يُبلي الفاعِلونا",22,"ن",2,0],["وما نحن إلاّ الليث شُدَّت قيوده","وأُلقي حياً شبله في فم الذئب",23,"ب",1,0],["وَما نَوَّخوها قَينَكُم آلَ ضَوطَرٍ","لَأَلأَمَ مَن يَحذى عَلى قَدَمٍ نَعلا",24,"ل",2,0],["وَما نَفَعَ المُستَعمَلينَ غُلولُهُم","وَما نَفَعَت أَهلَ العُصاةِ الجَعائِلُ",25,"ل",1,0],["وَما نامَ إِذ باتَ الحَواضِنُ وُلَّهاً","وَهُنَّ سَبايا لِلصُدورِ بَلابِلُ",25,"ل",1,0],["وَما نَحنُ أَعطَينا أُسَيدَةَ حُكمَها","لِعانٍ أُعِضَّت في الحَديدِ سَلاسِلُه",26,"ل",2,0],["وَما نَسَجَت أَسرادَ داوُدَ وَاِبنِهِ","مُضاعَفَةً مِن نَسجِهِ إِذ يُقابِلُ",27,"ل",1,0],["وَما نَحنُ إِلّا وائِلٌ وَمُهَلهَلٌ","صَفاءً وَإِلّا مالِكٌ وَمُتَمِّمُ",28,"م",1,0],["وَما نالَ مَحمِيُّ الرَغائِبِ عَنوَةً","سِوى ما أَقَلَّت في الجُفونِ الحَمائِلُ",29,"ل",1,0],["وَما نِعمَةٌ مَشكورَةٌ قَد صَنَعتُها","إِلى غَيرِ ذي شُكرٍ بِمانِعَتي أُخرى",30,"ر",2,1],["وما نقصتْ محاسنها ولكن","ليحلفَ واصفوها بالثلاث",31,"ث",1,0],["وما نافعي أطراف طرفيَ دونه","إذا كانَ طرف القلب ليس بمطرق",32,"ق",1,0],["وما نافعي تحت الدّجى نصب فيئتي","وقد حيل بين العير والنَزَوان",33,"ن",1,0],["وما نافعي تحت الدجى فمنيتي","وقد حيل بين العير والنزوان",34,"ن",1,0],["وما نَفْرُ نفسٍ من حلول مصيبةٍ","وقد أيقَنَتْ قِدماً بما هو آتِ",35,"ت",1,0],["وَمَا نِلْتُمُ مانلتمُ أنْ جُدِدْتُمُ","ولكن جَدَدْتُمْ والمُضِيعُونَ سُمَّدُ",36,"د",1,0],["وما نسيتُ أبا إسحاقَ مائرنا","تلك الفكاهات سِيقتْ نحوه المِير",37,"ر",1,0],["وما نجمُ رأيي في الخطوبِ بآفلٍ","ولا حينَ تنقضُّ النجومُ بمنقضّ",38,"ض",1,0],["وما نهتْهم عن المرعَى وخامتُه","لكنه أسنقَ الراعين مرعاكا",39,"ك",2,0],["وما نفحاتُ الروض تثنِي على الحيا","بأطيبَ من ذكراكمُ في المحافلِ",40,"ل",1,0],["وما نزل الإصحارَ إلا كقانصٍ","أريبٍ توارى عند بثّ الحبائلِ",40,"ل",1,0],["وَما نالَني مِن أَنعُمِ اللَهِ نِعمَةٌ","وَإِن عَظُمَت إِلّا وَأَنتَ سَفيرُها",41,"ر",3,0],["وما نشوةُ الحبِّ عندَ المحبِّ","وما سِحْرُ ذاك الرَّبيعِ الوليدْ",42,"د",1,0],["وما نمت عن مصر إذا الناس هوموا","يرين الكرى من عينهم بالمعاقد",43,"د",1,0],["وما نألو نهارك ذكريات","ولا برهان غرتك التماحا",44,"ح",2,0],["وَما نَمَّ وَلا هَمَّ","بِبَعضِ الكَيدِ وَالدَسِّ",45,"س",1,0],["وَما نَيلُ المَطالِبِ بِالتَمَنّي","وَلَكِن تُؤخَذُ الدُنيا غِلابا",46,"ب",2,0],["وَما نَجا مِن شِفارِ البيضِ مُنفَلِتٌ","نَجا وَمِنهُنَّ في أَحشائِهِ فَزَعُ",47,"ع",1,0],["وَما نَقَمَ الحُسّادُ إِلّا أَصالَةً","لَدَيكَ وَفِعلاً أَريَحِيّاً مُهَذَّبا",48,"ب",2,0],["وَما نُخِلُّ بِتَقريظٍ نَخُصُّ بِهِ","أَبا مُحَمَّدِهِم شُكراً وَإِحمادا",49,"د",2,0],["وَما نَقَلَت مِنهُ الخِلافَةُ شيمَةً","وَقَد مَكَّنَتهُ عَنوَةً مِن قِيادِها",50,"د",3,0],["وَما نادَيتِني لِلشَوقِ إِلّا","عَجِلتُ بِهِ فَلَبَّيتُ المُنادي",51,"د",2,0],["وَما نِلتُ مِن جَدوى أَبيهِ وَجَدِّهِ","وَما رَفَعا لي مِن سَناءٍ وَمِن ذِكرِ",52,"ر",1,0],["وَما نَحنُ إِلّا كَالقَضاءِ فَإِنَّنا","ضَرَبنا جَميعَ الناسِ بِالخَيرِ وَالشَرِّ",53,"ر",1,0],["وَما نَكَرنَ الغَداةَ مِن غُصُنٍ","يَحسُنُ في الإِنثِناءِ وَالقَصَفِ",54,"ف",1,0],["وَما نَقَموا إِلّا تَخَرُّقَ مُنعَمٍ","يَطوعُ لَهُم إِحسانُهُ فَيَطولُ",55,"ل",1,0],["وَما نَوَّرَ الرَوضُ الشَآمِيُّ بَل فَتىً","تَبَسَّمَ مِن شَرقِيِّهِ فَتَبَسَّما",56,"م",2,0],["وَما نَقَلَت لَوعَتي لِمَّةٌ","تَنَقَّلُ في حُدثِ أَلوانِها",57,"ن",3,0],["وَما نَهَضَت فُقَيمٌ لِلمَعالي","بِزِندٍ في الفَخارِ وَلا عَديدِ",58,"د",1,0],["وَما نَبا السَيفُ مِن جُبنٍ وَلا دَهَشٍ","عِندَ الإِمامِ وَلَكِن أُخِّرَ القَدَرُ",59,"ر",1,0],["وَما نَحنُ نَبكي غالِباً لَيسَ غَيرُنا","وَلَكِن سَيَبكي غالِباً كُلُّ عايِلِ",60,"ل",1,0],["وما نُبالي بِذَمِّ الأغبياءِ إذا","كانَ اللَّبيبُ من الأقوام يُطرِينا",61,"ن",2,0],["وما نَقَمُوا إلا مَقالَةَ مُعْلنٍ","بأنَّ أبا السِّبْطَينِ خَيْرُ الخَلائفِ",62,"ف",1,0],["وَما نَحسَبُ الصاعاتِ تُقطَعُ مُدَّةً","عَلى أَنَّها فينا سَريعٌ دَبيبُها",63,"ب",3,0],["وَما نالَ عَبدٌ قَطُّ فَضلاً بِقُوَّةٍ","وَلَكِنَّهُ مَنُّ الإِلَهُ وَفَضلُهُ",64,"ل",2,0],["وَما نِلتُ مِن مَأمولِ وَصلِكُمُ رِضى","وَلا ذُقتُ مِن رَوعاتِ هَجرِكُمُ أَمنا",65,"ن",2,0],["وَما نابَ عَنكَ الغَيرُ عِندي وَقَلَّما","يَنوبُ عَنِ الماءِ القَراحِ صَعيدُ",66,"د",1,0],["وَمَأَنتَ وَالفَحصَ عَن شانِها","وَما قَمُّصوكَ بِأَثوابِها",67,"ب",3,0],["وما نَجوتُ بِنَفسي عَنكِ راغِبَةً","وإنّما مَدّ عُمْري قاصرٌ عُمُرَك",68,"ك",1,0],["وما نَوّمَتْ عَزْمَتي بلدةٌ","تُنَبّهُ في الغمر عَجْزَ البليدِ",69,"د",1,0],["وَما نَفعُ مَن قَد ماتَ بِالأَمسِ صادِياً","إِذا ما سَماءُ اليَومِ طالَ اِنهِمارُها",70,"ر",3,0],["وَما نَكبَةٌ فاتَت بِهِ بِعَظيمَةٍ","وَلَكِنَّها مِن أُمَّهاتِ العَظائِمِ",71,"م",1,0],["وما نفاقي وكسادي على","قلبي ولا فكريَ منهُ لمامْ",72,"م",1,0],["وَما نُعمٌ وَلَو عُلِّقتُ نُعماً","بِجازِيَةِ النَوالِ وَلا مُثيبِ",73,"ب",1,0],["وَما نَظَرَت عَيني إِلى وَجهِ قادِمٍ","مِنَ الحَجِّ إِلّا بَلَّ دَمعي رِدائِيا",74,"ي",2,0],["وَما نَظَري مِن نَحوِ نَجدٍ بِنافِعي","أَجَل لا وَلَكِنّي عَلى ذاكَ أَنظُرُ",75,"ر",1,0],["وما نَفْعُ الحياةِ لِكلّ حَيٍّ","إذا ما أصبحت داءً عَقاما",76,"م",2,0],["وما نبغي إذا رُمْنا انتصافاً","إلى شيءٍ سوى الكرمِ احْتِكاما",77,"م",2,0],["وما نَفْعُ الخلافةِ حين تُمسِي","حديثَ خُرافةٍ للهازلينا",78,"ن",2,0],["وما نكبت مواليَها المعالي","كما نكبت مواليَها الدَّنايا",79,"ا",3,0],["وما نَفَعَ النُّفوسَ ولا هَداها","كنُورِ الله خيرِ المُنزِلينا",80,"ن",2,0],["وَما نَكَبَت عَن مَعالي الأُمورِ","عَلى الرَيثِ مِن أَمرِها وَالعَجَلْ",81,"ل",1,0],["وَما نَقَمَت إِلّا الحَنانَ أَثارَهُ","صَريعٌ تَرَدّى وهو حرَّان مُتعَبُ",82,"ب",1,0],["وما نَظرتْ أعينُ الدَّارعين","كأدراعهِ الغالياتِ القِيَمْ",83,"م",1,0],["وما نَسَبٌ بأقربَ من سبيلٍ","يُؤلِّفُ بين أشتاتِ القُلوبِ",84,"ب",1,0],["وما نِلتَ خيراً إذ أتيت ابن مشكمٍ","وكنت امرأ أعمى الهوى لا يرى رشدا",85,"د",2,0],["وَما نكّبَت عَن شاكر بَعد فَيصَلٍ","وَغالَت عَلياً وَاللواعج في الصَدرِ",86,"ر",1,0],["وَما نيلُ مِصرَ قُبَيلَ الشَفى","إِذا نَفَحَت ريحُهُ النافحَه",87,"ح",2,0],["وَما نَسينا مَصرَعَ الكَفورِ","الجاهِلِ المُخَلِّطِ المَغرورِ",88,"ر",1,0],["وَما نالَ مِنها فَهوَ مِنهُ كَمُدَّعٍ","حَقائِقَ أَمرٍ غامِسٍ بِالنَفائِسِ",89,"س",1,0],["وَما نَقْدِيَّةُ السُّلْطَانِ إلاَّ","مَعَ المُسْتَخْدَمِينَ مُجَرَّدِينا",90,"ن",2,0],["وما نَظَرْتَ إليه كلّما جَعَلَتْ","تمْتَدُّ منه برأسِ الفارسِ الخَطِل",91,"ل",1,0],["وما نَقَمُوا إلاّ قديمَ تَشَيُّعي","فنَجّى هِزَبْراً شَدُّهُ المُتَدارك",92,"ك",1,0],["وَما نَسيتُ مَكانَ الآمِرينَ بِذا","مِنَ الوُشاةِ وَلَكِن في فَمي ماءُ",93,"ا",2,0],["وَما نِلتُها حَتّى تَولَّت شَبيبَتي","وَحَتّى نَهاني الهاشِمِيُّ المُغَرَّرُ",94,"ر",1,0],["وَما نَلقاهُمُ إِلّا صَدَرنا","بِرِيٍّ مِنهُمُ وَهُمُ حِرارُ",95,"ر",1,0],["وَما نالَ شَيئاً طالِبٌ بِجَلادَةٍ","وَلَكِن لِقَومٍ حُظوَةٌ وَجُدودُ",96,"د",1,0],["وَما نَحنُ إِلّا كَالخَليطِ الَّذي مَضى","فَرائِسُ دَهرٍ مُخطِئٍ وَمُصيبِ",97,"ب",1,0],["وَما نُوَبُ الأَيّامِ إِلّا كَتائِبٌ","تُبَثُ سَرايا أَو جُيوشٌ تُعَبَّأُ",98,"ب",2,0],["وَما نُفيقُ مِنَ السُكرِ المُحيطِ بِنا","إِلّا إِذا قيلَ هَذا المَوتُ قَد جاءَ",99,"ا",2,0],["وَما نَفَسٌ إِلّا يُباعِدُ مَولِداً","وَيُدني المَنايا لِلنُفوسِ فَتَقرُبُ",100,"ب",1,0],["وَما نالَت خِلافَتَها قُرَيشُ","وَأَرغِمَ سَعدُها إِلّا بِسَعدِ",101,"د",1,0],["وَما نَفَعَ المُبَرِّدَ مِن حَميمٍ","وَصادَت ثَعلَباً نُوَبٌ ضَواري",102,"ر",2,0],["وَما نَفسُ حَسّانَ الَّذي شاعَ جُبنُهُ","بِأَسلَمَ مِن نَفسِ الكَميِّ المُخالِسِ",103,"س",1,0],["وَما نَحُنُ أُم ما بَرايا عالَمٍ كُثُرٍ","في قُدرَةٍ بَعضُها الأَفلاكَ يَبتَلِعُ",104,"ع",1,0],["وَما نَفَعَ الأَوائِلَ مِن قُرَيشٍ","وُلاةَ الحِجرِ ما اِجتَذَبوا وَمَكّوا",105,"ك",3,0],["وَما نَأَتِ القَرابَةُ مِن رِجالٍ","أَبوهُم يافِثٌ وَأَبوكَ سامُ",106,"م",1,0],["وَما نَطَقوا بِهِ تَشبيبَ أَمرٍ","كَما بَدَأَ المَديحَ مُشَبِّبوهُ",107,"ب",3,0],["وَما نالَ الهَجينُ مِنَ المعالي","إِذا خَطَبَ الكَريمَةَ وَاِستَراها",108,"ا",3,0],["وما نَعشُهُ إلا كنَعشٍ وَجَدْتُهُ","أباً لبَناتٍ لا يَخَفنَ من اليُتْمِ",109,"م",1,0],["وما نَغَمُ الأوْتارِ في سمْعِ أُذْنِهِ","بأحْسَنَ صَوْتاً مِن رُغاء سَوامهِ",110,"م",2,0],["وَما نَحَني كَمِنَاحِ العَلُو","قِ ما ترَ مِن غِرَّةٍ تَضرِبِ",111,"ب",1,0],["وَما نالَ ما كانَ يرَجو امرؤٌ","تجنب للعقبات اقتحاما",112,"م",2,0],["وما نَسِيتْ دجلةً إنها","بشطَّيهِ حائمة طائفَه",113,"ف",2,0],["وما نظرَ العشَّاقُ إلَّا لعالمٍ","يُعَظِّمُ في المعشوقِ كلَّ صغيرةِ",114,"ه",1,0],["وما نِلْتُ مِنْكَ النَّصْفَ حتَّى ارْتَمَت بك","المَنايا بسَهْمٍ صائِبِ الوَقْعِ أعْجَفِ",115,"ف",1,0],["وما نَهْنَهَتُ عن طَلَبٍ ولكِنْ","هيَ الأيّامُ لا تُعْطي قِيادا",116,"د",2,0],["وما نلت مالاً قط إلا ومال بي","ولا درهماً إلا ودر بي الهم",117,"م",1,0],["وَما نَطَقَت بِاللَيلِ سارِيَةُ القَطا","وَما صَدَحَت في الصُبحِ غادِيَةُ الكُدرِ",118,"ر",1,0],["وما نبل الصّلاح على ضعيف","فبعض الذلّ تحسبه صلاحا",119,"ح",2,0],["وَمَا نِعَمُ الحَيَاةِ وَمَا مُنَاهَا","بِلاَ وَطَنٍ عَزِيزِ الشأْنِ حُرِّ",120,"ر",1,0],["وَما نَزَحَت لِلعَينِ بَعدَكِ عَبرَةٌ","إِذا اِنحَدَرَت قادَت لَها أَخَواتِ",121,"ت",1,1],["وَما نُصِرَ الحَجّاجُ إِلّا بِغَيرِهِ","عَلى كُلِّ يَومٍ مُستَحَرِّ المَلاحِمِ",122,"م",1,0],["وَما نالَ أَصحابُ السَقيفَةِ إِمرَةً","بِدَعوى تُراثٍ بَل بِأَمرِ تِراتِ",123,"ت",1,0],["وما نقولُ لأبطالٍ لنا سَلَفوا","إذا تَهدَّم ما كانُوا يَشيدونَا",124,"ن",2,0],["وما نقولُ لعمرٍو حينَ يسأَلُنا","إن لم نُجِبْ قبلَهُ بالسيفِ غازِينَا",124,"ن",2,0],["وما ندري له معنىً","ولا قائِلُه يدري!",125,"ر",2,0],["وما نَعْصِي نصائحَك الغَوَالي","ولكن كيف يمكن الامتثال؟",126,"ل",1,0],["وَمَا نَوّرَ الرّوْضُ الشآميُّ بَلْ فَتًى","تَبَسّمَ مِنْ شعرْقِيّهِ، فَتَبَسّما",127,"م",2,0],["وما نال معنى القلب إلاّ لأنّه","تمرّغ في سكب اللّظى وتقلّبا",128,"ب",2,0],["وما نظرت عيني إلى ذي بشاشة","ٍ من النّاسِ إلاّ وهيَ في العينِ أملحُ",129,"ح",1,0],["وَمَا نهَضَتْ فُقَيْمٌ للمَعَالي،","بِزَنْدٍ في الفخَارِ وعلا عَدِيدِ",130,"د",1,0],["وما نال من إيماني السّمع أنّني","أصلّي لها في غربتي وأصوم",131,"م",1,0],["وما نذروا حتى غشينا بيوتهمْ","بغيبة ِ موتٍ مسبلِ الودقِ مزعفِ",132,"ف",1,0],["وما نشوة ُ الحبّ عندَ المحبِّ","وما صرخة ُ القلبِ عندَ الصّدودْ",133,"د",1,0],["وَما نَحنُ إِلّا كَالنَبات مَثابة","عَلى الأَرض مِنهُ طيب وَخَبيث",134,"ث",1,0],["وما نابهم الا الفضيحة والعنا","وحمل الخطايا والنقائص والقهر",135,"ر",1,0],["وما نحن إلّا الهاجمون على الردى","فنفس الفتى عونٌ له وخصيم",136,"م",1,0],["وما نظمي الأشعار إلا علالة","لو انه سلوا بالقريض يكون",137,"ن",1,0],["وما ندمي إلا على كلفي بكم","فهل لي من تلك الجناية عاذر",138,"ر",1,0],["وما نؤمل في الدنيا وبهجتها","وهي التي بكؤوس الصاب تسقينا",139,"ن",2,0],["وما نيتي إلا رضَى اللّهِ وحْدَه","وسلوة عبدٍ للغُمومِ تَجشَّما",140,"م",2,0],["وَمَا نََظَمتهُ مِن دُرٍّ نَثِيرٍ","ومَا نَثَرَتهُ مِن دُرِّ نَظِيمِ",141,"م",1,0],["وما نعمةٌ إلا أفضتَ لباسَها","على من عهدناه لها غيرَ لبَّاسِ",142,"س",1,0],["وَما نَجا تُركُمانٌ إِذ نَدَبتَ لَهُ","مِن عامِرٍ عُصَباً أَعزِز بِها عُصَبا",143,"ب",2,0],["وَما نالَ هَذا الفَضلَ ماضٍ مِنَ الوَرى","وَإِن نالَهُ آتٍ فَمِنكَ تَعَلَّما",144,"م",2,0],["وَما نَقَصَت عَطاياكَ اللَواتي","عَلَت أَمَلي فَأَسأَلَكَ التَماما",145,"م",2,0],["وما نالني في الله فهو محبتي","وما صائر لي منهم الطعن والسبُّ",146,"ب",1,0],["وما نصر دمع العين لي أن ناصري","هو الناصر بن الأشرف الملك الندب",147,"ب",1,0],["وما نسب الإِنسان إلا فعاله","وافعالك الحسنى بها غاية الفخر",148,"ر",1,0],["وما ناطح الصخر الأصم مميز","ولا اجتر ذو عقل قياد الردى خرطا",149,"ط",2,0],["وما نصحوا السلطان فيك ولا رضوا","بنصرته للحق لمّا تغلبوا",150,"ب",3,0],["وما نسيتُ ولا أنسى اعتصاميَ من","جواره بعُرا الأسبابِ والوُصَلِ",151,"ل",1,0],["وَما نَهَضتُ لَهُ إِلّا وَأَقعَدَني","خذلانُ قَومي وَعَيثُ الدَهرِ في نَشبي",152,"ب",2,0],["وَما ناحَ قُمرِيُّ الحَمامِ وَما دَعا","أَخُو فاقَةٍ وَاستَجلَبَ المَدحَ باذِلُ",153,"ل",1,0],["وَما نالَ مِنّا ذاكَ إِلّا لِأَنَّنا","جَعَلنا لَهُ دِرعاً وَرُمحاً وَمُنصَلا",154,"ل",2,0],["وَما نِيلَ غَدراً بَل أَتى في عِصابَةٍ","قَليلٌ مِنَ الغَدرِ الشَنيعِ اِحتِشامُها",155,"م",3,0],["وَمانِعَ الجارِ جَسّاساً أُتيحَ لَهُ","سَهمُ المَنونِ عَلى عَمدٍ فَلَم يَرُمِ",156,"م",1,0],["وَما نَضا الدِّرعَ حَتّى حازَ حَوزَتَها","قَهراً وَآخى بِها الأًحساءَ مِن أَمَمِ",157,"م",1,0],["وَما نُطفَةٌ صَهباءُ خالصةُ القَذَى","بِحَجلاءَ يَجرِى تحتَ نِيقٍ حَبابُهَا",158,"ب",3,1],["وَمَا نَلتَقى إِلاّ الفُجَاءَةَ بَعدَ ما","نَرى أَنَّ أَدنى عَهدِنا المُتَقادِمُ",159,"م",1,0],["وَمَا نَلتَقى إِلاّ لِماماً عَلَى عِدىً","عِدَادَ الثُّرَيّا وَهىَ مِنكِ الغَنائمُ",159,"م",1,0],["وَما نطقَ المُختارُ قطُّ عَنِ الهوى","وَما بِسوى وَحيٍ لهُ أعملَ الفِكرا",160,"ر",2,0],["وَما نَهيا عنه وما أمَرا بهِ","فَلا سامِعٌ نهياً ولا طائعٌ أمرا",160,"ر",2,0],["وَما نفَروا يومَ الوَغا من عدوِّهم","بَلى في سبيلِ اللَّه قد نَفَروا نفرا",161,"ر",2,0],["وَما نابَهُم حَيُّ فَيَرجِعُ سالِماً","وَلَم يَستَطِع قَومٌ لَما فَتَقوا رَقعا",162,"ع",2,0],["وما نظرتُ لأعضائي وقد بليتْ","إلا حسبتُ ثيابها فوقَها كفنا",163,"ن",2,0],["وما نظرت عيني إلى الشمس ساعةً","من الدهر إلا خلتُها لك تنظرُ",164,"ر",1,0],["وما نالهم في ذاك روع ونالهم","من الله في الدارين اجر ومغنم",165,"م",1,0],["وَما نافِعي أن تَبكيا غيرَ أنّي","أُحبُّ دموعَ البِرِّ والمرءَ وافِيا",166,"ي",2,0],["وما نطُوقٌ ولم يَنْطِق بجارحةٍ","إذا تنغّم فَدَّت حُسْنَه النَّغم",167,"م",1,0],["وما نقصَتْ من وزن حلمك ذَرّةً","بخطبٍ ولا حلَّت لصبرك من عَقْد",168,"د",1,0],["ومَا نقَلْنا فيهِ سوى نبتِ شَطهِ","وما فرشْنا فيهِ سِوى الرمل والصخْرِ",169,"ر",1,0],["وَمَا نَوَّهَ الذِّكْرُ الْحَكِِيمُ بِمَدْحِكُمْ","وَمَا رَاقَ تَدْبِيجُ الْقَرَاطِيسِ بِالصَّمْغِ",170,"غ",1,0],["وَمَا نِيلَ مِنْ جَرَّاكُمُ فَضْلُ رَبِّنَا","وَمَا عَرَّجَ الْبَدْرُ الْمُنِيرُ عَلَى فَرْغِ",170,"غ",1,0],["وَما نافِعي عِندَ الوجوه كَأَنَّها","فَسا الصَخرِ صَخراً أَنَّني صارِمُ العضبِ",171,"ب",1,0],["وما نور هذي الشمس عندي سوى جُدَا","أيادٍ تفيض الجود وهي غمام",172,"م",1,0],["وما نازحات ساجعات بشجوها","ترنح اغصان النقا وترنم",173,"م",1,0],["وما ناقم كالعفو وللذنب بارز","ولا آخذ كالحلم والحقد جائل",174,"ل",1,0],["وَما نالَ مِنهُم في الهَزاهِزِ كُلِّها","فَوارِس هَيجا أَم لُيوث فَوارِسُ",175,"س",1,0],["وَما نَسِيتُ بإهزاجِ الحمامِ ضُحىً","جرْس الحُليّ وَلا وسواسَهُ الهَزِجا",176,"ج",2,0],["وما نَفْعي بعَطْفِك بعد فَوْتٍ","كَرِقّة شامتٍ من بعد دفن",177,"ن",1,0],["وَما نَبَّهَتْ إِلاّ عَلَى ذِي نَباهَةٍ","كَما سُقِي الرَّوْضُ الْخَطِيبُ بِماطِرِ",178,"ر",1,0],["وَما نَوَّهَتْ مِنْكَ الْقَوافِي بِخامِلٍ","وَلكِنْ رَأْيْتُ الشِّعْرَ قَيْدَ الْمَفاخِرِ",178,"ر",1,0],["وَما نَكِرَتْ مِنْ حادِثاتٍ بَرَيْنَنِي","وقَدْ عَلِقَتْ قَبْلِي الرِّجالَ عَلُوقُها",179,"ق",3,0],["وما نجع الدواء وما استفاقوا","لحبهم الدمار على العمار",180,"ر",1,0],["وما ناح في السودان والصين نائح","على ملة أضحت ضحية ذي حقد",181,"د",1,0],["وَما نَكِرَ العشّاق هَجراً ولا قِلىً","فَما طابَ وصلٌ قطُّ لَو لَم يكن هَجرُ",182,"ر",1,0],["وَما نفعُ دارٍ لست تملكُ بابَها","هل السجنُ إلاّ بابُه حين يغلق",183,"ق",1,0],["وما نلته فاعمل به لرياضة","على الفور حتى لا يرى غدر عصيان",184,"ن",1,0],["وما ناهض بالنفس يزداد رتبة","من العلم تسميها كوان مقوت",185,"ت",1,0],["وَما نَزَعَتكَ لِلدُّنيا هَناتٌ","إِلَيها أَعيُنُ الوُزَراءِ صورُ",186,"ر",1,0],["وما نفع مقدام تجهّم حظّه","وفي راحتيه يضحك الصارم الهندي",187,"د",2,0],["وما نحن إلّا سطورُ الكتاب","وأعمارنا هي أرقامُها",188,"ه",2,0],["وما نفع الضخامة في جسوم","إذا أرواحها كانت خرابا",189,"ب",2,0],["وَما نَسيتُ وَلا أَنسى تَحَشُّمَها","وَميسَمُ الحُرِّ عَقلٌ غَيرُ ذي غَلَمِ",190,"م",1,0],["وَما نَشَرتُ فَمَطوِيٌّ وَمُظهِرُهُ","فَمُضمِرٌ لا تَراهُ مُقلَةُ العاشي",191,"ش",2,0],["وَمانَ مَن في غَيرِ مَعناكُم","بِمِدحَةٍ مِنهُ جَرى اللَفظُ",192,"ظ",1,0],["وَما نَفحُ رَوضٍ ذي أَقاحٍ وَحَنوَةٍ","وَذي وَرَقٍ مِن قُلَّةِ الحَزنِ عازِبِ",193,"ب",1,1],["وما نِعمةُ الأقوامِ إلاّ مُناخةٌ","وما الشُّكْرُ إلاّ شَدُّها بِعِقال",194,"ل",1,0],["وما نَفْعي وإن هطَلتْ غُيوثٌ","إذا أخطأْنَ أمكِنةَ المُحول",195,"ل",1,0],["وما نارٌ بأخْمَصِ مُستهامٍ","كنارٍ منه في الكَبِد احتراقا",196,"ق",2,0],["وما نأَتْ دارُ مَن تدنو فواضِلُه","ولم يكُن غائباً مَن شُكرُه حضَرا",197,"ر",2,0],["وما نِيلَ من أُمنيّةٍ ومَنّيةٍ","سِوى ما أتاهُ وعْدُها ووَعيدها",198,"د",3,0],["وما نِلْتَه بُشْرى بما ستَنالُه","إذا الصُّبحُ وافىَ كانتِ الشّمْسُ بَعْده",199,"د",2,0],["وما نال مُلْكاً بالمُنَى ولربّما","تَنبَّهُ للقومِ النِّيامِ جُدود",200,"د",1,0],["وما نقَم الحُسّادُ إلا فضائلاً","تَكشّفَ منهم عن كُبودٍ فَتائت",201,"ت",1,0],["وَما نَهَضَت مِن قَلبِهِ لَكَ رِقَّةٌ","إِذا لَم تَرَ الشَكوى فَذَيلِيَ يَعثَرُ",202,"ر",1,0],["وَما نَفَعَ الباقينَ أَن يَتَأَخَّروا","وَلا اِمتَنَعَ الماضونَ أَن يَتَقَدَّموا",203,"م",3,0],["وَما نَظَرُ الإِنسانِ دُنيا يُحِبُّها","وَلَيسَ لَهُ فيها حَبيبٌ سِوى العَمى",204,"م",2,0],["وَما نافِعي إِلّا الَّتي لَو بَلَغتَها","بَلَغتُ مِنَ الأَيّامِ ما أَتَمَنّاهُ",205,"ه",1,1],["وما نظفَة من مُزْنَةٍ في وَقيعَةٍ","على متن صخر في صفاً خالطت شهْدا",206,"د",2,0],["وما نَظَرتْ مُقْلَتي مُذْ طَغَتْ","إلاَّ وَشَاَهَدَكَ النَّاظِرُ",207,"ر",1,1],["وما نِمتُ فيه غَير أن لَو سَألتَني","من الشُغلِ عَنه قلتُ ما قالَ نائِمُه",208,"م",2,0],["وما ناداك ذوكرب فقال","عسى فرج من المولى القريب",209,"ب",1,0],["وما نسعى الى حرب ولكن","إذا فرضت صبرنا في الحروب",210,"ب",1,0],["وما نصحي بمبذول لكل","فكل أخ له عندي مقام",211,"م",1,0],["وما نراه فاعلاً فيهما","ما قاله وهو الصدوق الوفي",212,"ف",2,0],["وما نقم الأحباب في شرعة الهوى","على سوى أني حفظت وضيعوا",213,"ع",3,0],["وما نظر الدنيا بعين عناية","فسيان فيها عنده العسر واليسر",214,"ر",1,0],["وما نلتَ في دُنياك عِزّاً ورِفعةً","وإن كبُرا إلاّ وقدرُكَ أكبرُ",215,"ر",1,0],["وَما نالَني ضَيمٌ وَلا لانَ جانِبي","وَلا نالَني ضَرٌّ وَلا مَسَّني عُسرُ",216,"ر",1,0],["وَما نَحنُ إِلّا مِثلَ أَفراس حلبةٍ","تَقَدَّمنا شيء وَنَحنُ عَلى الإِثرِ",217,"ر",1,0],["وما نظرتُ إلى ما كان يُبهِجُني","إلاّ شَجاني وآسانِي وأَبْكاني",218,"ن",2,0],["وما نالَ أيَّامَ الحياةِ من الغِنى","عن الفقْرِ في يومِ المَعادِ هو الفَقْرُ",219,"ر",1,0],["وما نُلِطُّ بدَينٍ تدَّعُون به","حتّى يخلِّصَه السّلطانُ والحَكَمُ",220,"م",1,0],["وَما نِلت حَتّى شِبتَ إِلّا عَطِيَّةً","تَقومُ بِها مَصرورةً في رِدائِكا",221,"ك",2,0],["وما نظرت إلاَّ بأدعج فاترٍ","كما استَلَّ ماضٍ يفلق الهام مرهف",222,"ف",1,0],["وما نحن إلاَّ من نوالك سيِّدي","كما أُمطِر الربعُ المحيلُ فسالا",223,"ل",2,0],["وما نَزَلوا غير شمّ الرعان","يُهدّى لها المنجد المغور",224,"ر",1,0],["وما نلنا المنى من السّعي حتَّى","نَزَلْنا في منازله الرِّحاب",225,"ب",1,0],["وما نامَ عن قوم تكفَّل حفظها","وقد باتَ يرعاها بأعين ساهر",226,"ر",1,0],["وما نلتَ مقدار الَّذي أنتَ أهلُهُ","على عظم ما نَوَّلْتَ من رفعة القدر",227,"ر",1,0],["وما نقص اشتياق الصَّبِّ شيئاً","على وجه حكى بدر التمام",228,"م",1,0],["وما نفعت فيهم نصيحة ناصح","وهل نفعت في الجاهلين النصائح",229,"ح",1,0],["وما نلت عما شان بالمجد خالياً","وما زلت بالعلم اللّدنيّ مفعما",230,"م",2,0],["وما نظَرتُم إلى خضوعي","ووفقتي وقفةَ الذليل",231,"ل",1,0],["وَما نَصَرَ اللهُ امْرَءاً أَنْتَ حَرْبُهُ","وَأَنّى لَهُ بِالنَّصْرِ وَاللهُ يَنْصُرُكْ",232,"ك",1,0],["وما نادت الهياء إلّا أجابها","بطعن تحامي منه عمرو وعامر",233,"ر",1,0],["وما نُبالي إذا ما كان مقترباً","منا نداه جميعَ الناسِ لو بعُدوا",234,"د",3,0],["وَمَا نَقَصَتْ منكَ الليالي فَعُوَّدٌ","عَلَيْكَ بِهِ إِلّا الخَطِيئَةَ والإِثْما",235,"م",2,0],["ومانِعِ الجارِ من ضَيْمٍ ومن عَدَمٍ","لَوْ أَنَّهُ من حِمامِ الحَيْنِ يَمْتَنِعُ",236,"ع",1,0],["وَمَا نَثَرَتْهُ عَلَيْكَ السُّعودُ","محاسِنَ تبهَرُ فِيهَا السُّعودا",237,"د",2,0],["وما نام عنهُ عِرْقُ قَحْطَانَ إِذْ فَدى","عُروقَ الثَّرى من غُلَّةِ القَحْطِ بالسُّقْيا",238,"ي",2,0],["ومانُوا يُرَاعُونَ النجُومَ وَقَدْ رَأَتْ","وسائِلُهُمْ أَلّا حِفاظَ وَلا رَعْيا",238,"ي",2,0],["وما نظرتها مقلة غير ما بكت","وما خطرت في القلب إلى أجابها",239,"ب",3,0],["وما نظروا لبارقها وداداً","ولا شغفوا بقرط أو رغاث",240,"ث",1,0],["ومانع الزكاة المال حل به","قحط فلم يُسقَ شؤبوب من المطر",241,"ر",1,0],["ومانوا بالذي قالوا","وداسوا أرضهم بغيا",242,"ا",1,0],["وما نحن إِلاّ من صناديد هاشم","لنا شَمَمٌ تزدانُ منه المعاطِسُ",243,"س",1,0],["وما نزال فكم من زمرة شقيت","دستورها الجهل أو دستورها الودع",244,"ع",1,0],["وما نقطع إلا لحم من عصروا","من الضحايا وأرواح المساكين",245,"ن",1,0],["وما نسمعُ الأنغامَ عزفاً مسلسلاً","ولكنها الأحلامُ صادرةً عنا",246,"ن",2,0],["وما ندرةٌ إلا هديةُ رحمةٍ","إلى الخلقِ فاغتيلَ الحنانُ الذي نَدرَ",247,"ر",1,0],["وما نظري إليك على خُشوعٍ","أمام المعجزاتِ سوى صَلاتي",248,"ت",2,0],["وما نقداته إلا مهوراً","تزَف إلى عزيزات الفنون",249,"ن",1,0],["وما نذمُّ قاطراتِ سُحبِكم","فينا ولا نكفُرُ بانهمالها",250,"ل",3,0],["وما نسلوا للنفر داعين من منى","رعى الله فخرَ الملك للحرثِ والنسلِ",251,"ل",1,0],["وما نسبٌ ما بين جنبيَّ تالدٌ","بغالب ودٍّ بين جنبيَّ طارفِ",252,"ف",1,0],["وما نُطفةٌ حصَّنتها السماءُ","بأرعنَ مَرقاهُ مَستصعَبُ",253,"ب",1,0],["وما نَقضناهُ من طريقٍ","مِن حيثُ رحنا عنه قريبُ",254,"ب",1,0],["وما نشوة من قرقف صرْ خديَّةٍ","تدفَّقُ من ضنْك الجِران مُفدَّم",255,"م",1,0],["وما نظمي الأشعار إلا تعلَّةً","تُريني أقصى ما أحاولُ دانيا",256,"ي",2,0],["وما نفضتْ عنها ثمائل رعيها","من الروض حتى كان بابلُ مرتعا",257,"ع",2,0],["وما نَشْرُ غَنَّاءَ مَطْلولَةٍ","جواثِمُ تَرْغدُ غِرْبانُها",258,"ن",3,0],["وما نهدتمْ إلى غزوٍ فأقعدني","بخس الحظوظ ولا التقصير في الحال",259,"ل",1,0],["ومانعها يا ويله من وعيدها","سيكون بها في الوجه والجنب والورا",260,"ر",2,0],["وما نصر المعالي غير نصل","به في كل حادثةٍ يصول",261,"ل",1,0],["وما نسب الإنسان إلا فعالة","فان لم يكنهُ فهو زينُ المناسب",262,"ب",1,0],["وما نقّطت إلاَّ وهنَّ عرائسٌ","تزفُّ إلى الأفهام زفَّ الحلائل",263,"ل",1,0],["وما نشرتْ تلك الحدائقُ غبطةً","ولكن على لمياءَ شتت جيوبها",264,"ب",3,0],["وما نحن إلا الكرام الأباة","ولا عاش من كان غير أبي",265,"ب",2,0],["وما نضوت لباس الذل عن أملي","حتى جعلت دروع البأس مدرعي",266,"ع",2,0],["وما نَحَتَ الجبابرُ من قصورٍ","وما لبسَ الأكاسِرُ منْ أساورْ",267,"ر",1,0],["وما نالَ الحجاز بكم صَلاحاً","وقد نَالته مِصرٌ والشّآم",268,"م",1,0],["وما نحن إلا روضة كاملية","أياديك يا رب السماح ربابها",269,"ب",3,0],["ومانع أجفاني لذيذ رقادها","يبيع جفوني رقدة أو يعيرها",270,"ر",3,0],["وَمانِح قوم انتَ منهُم مَوَدَّتي","وَمُتَّخِذ مولاكَ مولى فتابِعُه",271,"ع",2,0],["وَما نَزَلتُ بي الحاجاتِ اِلّا","وَفي عَرضي مِنَ الطَمَع الحَياء",272,"ا",2,0],["وَما نُسِب امْرُؤٌ مِنْهُمْ لِبَكْرٍ","ولا عُمَرٍ عَلَى مَرِّ اللّيالي",273,"ل",2,0],["وَما نَلتَقي مِن بَعدِ نأيٍ وَفُرقَةٍ","وَشَحطِ نَوى إِلّا وَجَدتُ لَها بَردا",274,"د",2,0],["وَما نال مِثلَ اليأسِ طالبُ حاجَةٍ","إِذا لَم يَكُن فيها نَجاحٌ لِطالِبِ",275,"ب",1,1],["وما ننجو وباغينا","سريعُ الخَطْوِ غَرْثانُ",276,"ن",1,0],["وما نخشى صُرُوفَ الدّهرِ جَمْعاً","وأنّك من بوائقها حريمُ",277,"م",1,0],["وما نجا منك لا صُغْرٌ ولا كِبَرٌ","ولا شبابٌ ولا شيبٌ ولا هرمُ",278,"م",1,0],["وما نقموا سوى أنّي لديه","شديدُ القربِ مُستَمَعُ المقالِ",279,"ل",1,0],["وما نقموا إلّا التّصامُمَ عنهمُ","وصفحي لهمْ عن آفكٍ بعد آفكِ",280,"ك",1,0],["وما نَقَصَ المقدورُ من حظّ عاقلٍ","بِقدرِ الّذي أَسناه من حظّ مائقِ",281,"ق",1,0],["وما نافعٌ منّا وحشوُ قلوبنا","قبيحٌ من البغضاءِ حسنُ الظّواهرِ",282,"ر",1,0],["وَما نَهَضتمْ بأعباءٍ نهضتُ بها","ولا أحطتمْ بأطرافي وأقطاري",283,"ر",2,0],["وما نافِعِي في هذه الدَّار مرّةً","بناءُ أهاضيبي ورفعُ عِمادِي",284,"د",2,0],["وَما نحنُ إلّا في إسارِ عَدَامةٍ","وعند كَرانا أنّ ذاك وجودُ",285,"د",1,0],["وما نوحُ قُمْرِيٍّ على فرعِ أيكةٍ","يَعُنُّ له ذكرُ الفراقِ فيصدحُ",286,"ح",1,0],["وَما نِلتَه إِلّا بِحَقٍّ أتيتَهُ","وكم نيلَتْ العظمى من الأمر بالغصبِ",287,"ب",1,0],["وَما نِلتُ مِنها نائِلاً غَيرَ أَنَّني","بِشَجوِ المُحِبّينَ الأُلى سَلَفوا قَبلي",288,"ل",2,0],["وَمانِحَةٍ شُرّابَها المُلكَ قَهوَةٍ","مَجوسِيَّةِ الأَنسابِ مُسلِمَةِ البَعلِ",288,"ل",1,0],["وما نور تصديق كظلمة جاحد","ولا ماء معمودية ماء ذي طهر",289,"ر",1,0],["وما نَفعُ الدَّراهمِ مع جَهُولٍ","يُباعُ بدِرهمٍ وقتَ النَّفَاقِ",290,"ق",1,0],["وما نحن من يبغي الفساد ولا الأولى","يضيعون حق الجار إلا الذي إستجرا",291,"ر",2,0],["وما نزهت عيني على وشْي حبره","ولكنَّها قد نُزهَتْ في حبيره",292,"ر",2,0],["ومانِحُ مَنْ جَاءَ يمتارُه","فهم في معاليه لن يمتروا",293,"ر",3,0],["وما ناصَبُوك علَى زعمِهم","ولكنهم نُصِّبوا للنَّصَب",294,"ب",1,0],["وَمَانَعَتْه كمعشوقٍ تمنُّعُه","أَحلى من الشَّهدِ أَو أَحْلَى من الضَّرَبِ",295,"ب",1,0],["وما ناحت على الأغصان تبكي","حمامات هديلا حين هاما",296,"م",2,0]]}