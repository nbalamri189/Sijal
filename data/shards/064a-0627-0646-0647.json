{"poems":[[90,"من مبلغ المنصور عن بغداد","https://www.aldiwan.net/poem45006.html","الكامل"],[91,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[91,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[99,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[71,"أنا في الحب قانع باليسير","https://www.aldiwan.net/poem28994.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85557","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[91,"جف روض المنى وشح الربيع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=567172",""],[132,"يا نهرا سميت بالأصغرين","https://www.aldiwan.net/poem50609.html","السريع"],[240,"طاف يسعى بها على الجلاس","https://www.aldiwan.net/poem31916.html","الخفيف"],[261,"ولقد عهدتك تشتهي","https://www.aldiwan.net/poem48568.html","مجزوء الكامل"],[563,"تب منك حين تقول يا فتاح","https://www.aldiwan.net/poem34679.html","الكامل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203691",""],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205430","السريع"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124679","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132723","الرجز"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32894","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44916","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139587",""],[4814,"شرفة الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=193879",""],[4968,"معزوفة العشق","https://www.poetsgate.com/ViewPoem.aspx?id=208095",""],[5092,"مجدُ العراقِ صدّامُ","https://www.poetsgate.com/ViewPoem.aspx?id=179338",""],[5186,"قالوا: صناعاتنا بارت، فقلت لهم","https://www.poetsgate.com/ViewPoem.aspx?id=156496",""],[5219,"أضنيت قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=193839",""],[5273,"نهد","https://www.poetsgate.com/ViewPoem.aspx?id=28553",""],[5409,"دم ذاكراً فيك يا شعبان من وثبوا","https://www.poetsgate.com/ViewPoem.aspx?id=155253",""],[5413,"سامحيني","https://www.poetsgate.com/ViewPoem.aspx?id=200567",""],[5425,"شَوْقٌ ، أَمْ حَسَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=198953",""],[5463,"نظرة إرتياب","https://www.poetsgate.com/ViewPoem.aspx?id=33839",""],[5493,"على ضفةِ نهرِ الرَّاين","https://www.poetsgate.com/ViewPoem.aspx?id=197039",""],[5542,"قالوا تطرف جيلنا","https://www.poetsgate.com/ViewPoem.aspx?id=10190",""],[5847,"إشراقة وطن","https://www.poetsgate.com/ViewPoem.aspx?id=176962",""],[5851,"سؤال نهر","https://www.poetsgate.com/ViewPoem.aspx?id=175333",""],[5950,"الصمت والمينا ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128119",""],[5956,"من ثمالةِ رحيقِ قصيدةٍ منامية","https://www.poetsgate.com/ViewPoem.aspx?id=213432",""],[243,"يا نهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68172&r=&rc=164",""],[6213,"نهر الأحلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76256&r=&rc=13",""]],"verses":[["يا نهر عيسى أين منك موارد","عذُبت وأين رياضك الخضلات",0,"ت",1,0],["يا نهر طابَقَ لاعدمتك منَهلاً","أين الصَراة تحُفّها الروضات",0,"ت",1,0],["يا نهار الآداب لست عسى العه","د ولا في ضحاك ذاك المتوع",1,"ع",1,0],["يا نهاري كدت ان","تنقضى ما اعجلك",2,"ك",1,0],["يا نهرُ روّيت كل ظامي","فراح ريّان إن يذُق",3,"ق",1,0],["يا نهر لي جذوة بجنبي","هادئة الجمر بالنهار",3,"ر",1,0],["يا نهارَ المشيبِ مَنْ لي وهيها","تَ بليل الشبيبةِ الديجوري",4,"ر",2,0],["يا نهر دجلة أن من حقي البكا","حتى أموت على ضياع بلادي",5,"د",2,0],["يا نهر دجلة أن عيني ماؤها","نزرٌ فليس يبيح نار فؤادي",5,"د",2,0],["يا نهر دجلة فاجر أنت مكانه","واسق المعاهد من ربي ووهاد",5,"د",1,0],["يا نهر دجلة أنت تقنى قوةً","إذ كنت منحدراً من الأطواد",5,"د",1,0],["يا نهر دجلة إنني لمؤمل","أن لا تضن عليَّ بالإسعاد",5,"د",1,0],["يا نهر دجلة أين بغداد التي","كانت لأهل الفضل أكبر ناد",5,"د",1,0],["يا نهر دجلة ما لبغداد غدت","بلداً لكل شناعة وفساد",5,"د",1,0],["يا نهرَ طوسٍ ويا أظلالَ واديها","رسالةُ الشعرِ عني من يؤديها",6,"ي",3,1],["يا نهار الاديب لست على العهد","ولا في ضحاك ذاك المتوع",7,"ع",1,0],["يا نهراً سميتَ بالأصغرين","وأنت أزريتَ على الأصغرِ",8,"ر",1,1],["يا نَهارَ المَشيبِ مَن لي وَهَيها","تَ بِلَيلِ الشَبيبَةِ الديماسِ",9,"س",1,0],["يا نهشة الكلب العقو","ر ونكهة الليث الهصور",10,"ر",1,0],["يا نهر طالوت الذي بليت به","أقوامه ما هذه الألواح",11,"ح",1,0],["يا نهر، قومي في ذهو","ل الطفل في البلد الغريبِ",12,"ب",1,0],["يا نهر، ذنبك في إبائك","بعض مالي من ذنوبِ",12,"ب",1,0],["يا نهر أيامي أما نهلة","تروي الصدى أو جانب ممرع",13,"ع",1,0],["يا نهر أيامي أما آخر","لشقّة العيش التي أقطع",13,"ع",1,0],["يا نهرُ أنتَ خواطرُ الشعراء","تنسابُ مثلَ الماءِ فوقَ الماءِ",14,"ا",1,1],["يا نهرُ كلُّ خميلةٍ تحت الدجى","تهفو اليكَ برعشةٍ خضراءِ",14,"ا",1,0],["يا نهضة الشرق ثقي بفوزة","تدني قص الهم من مرامه",15,"م",2,0],["يا نَهضَةَ المَحبوبِ عَن غَضبَةٍ","يا نِعمَةً قَد آذَنَت بِالرَحيل",16,"ل",1,0],["يا نهر إسفر خيس الكبير","واخيبة القربان والندور",17,"ر",1,0],["يا نَهضةَ السودانِ حيَّتكَ السَما","وَسَقَتكَ ماءَ الوَرد مِلءَ سَحابِها",18,"ب",3,0],["يا نهار الوجود إن عدتَ ليلاً","لرزاياهم سترجع صبحا",19,"ح",2,0],["يَا نهلةً تاهَ في شُطآنها غَدَقٌ","تَستَأنِفُ الغَيثَ إن بَادَت مَواسمُهُ",20,"م",2,0],["يانهر عطرجرى في مرمر العنق","إنّي أخافُ على حِبٍّ من الغرق",21,"ق",1,1],["يا نهرَ دجلةَ ما أسرارُ فرقتنا ؟","حتى كأنا على شطّيكَ أقوامُ",22,"م",1,0],["يا نهضة ظهرت في السيدات، وقد","طال الهجوع وعاف الصحو سادات",23,"ت",1,0],["يا نهلة الظمآن يا قطر الندى","يا غيمة تسقي جديب ربوعنا",24,"ن",2,0],["يا نهدُ كيفَ غزلتَ النورَ في حَلَكي","كالبدرِ تحتَ ظلامَ الليلِ يكتملُ؟",25,"ل",1,0],["يا نهضة جدد الشعب العريق بها","رفيع مجدٍ تهاوت دونه الشهب",26,"ب",1,0],["يا نهاري وليلتي وطعامي","وشرابي وصحتي وسقامي",27,"م",2,1],["يانَهْرُ هَلْ نَقَصَتْ مِنْ زِيْنَةٍ وِغِنَى","أَشْعَارُ مَدْحِكَ أَوْ ظَنُّوا بِتَضْمِينِ",28,"ن",1,0],["يانَهْرُ هَلْ حَسَدٌ مَا شَبَّ في كَبِدِيْ","أَمْ حَرَّ شَوْقِ مِياهِ الطُهْرِ تَرْويني",28,"ن",2,0],["يا نهايات المحبّه ويا بدايات العذاب","يا مسلسل ما قدر يحمل بجوفه قصّتين",29,"ن",1,0],["يَا نهْرُ خُذْنِي فِي خِضَمِّكَ بُرهَةً","فَالقلْبُ بَرًّا مُتعَبٌ وَمٌحَارِبُ",30,"ب",1,0],["يا نهر صحوتنا رأيتك صافيا","وعلى الضفاف رأيت أزهار التقى",31,"ق",2,0],["يانهضة العلم والتأريخ ملحمة","نورا يسطرها بالروح والقلم",32,"م",1,0],["يانهر لا تسأل فمالي حيلة","قلبي أمان واقع بشراك",33,"ك",1,0],["يا نهّام الفجر نوره يفجّ الليل للغربال","وبكره مدري لوين القدر يبغى يمشينا",34,"ن",2,0],["يا نهّام الحديث يقلّب الأوجاع لا من طال","وحنّا حائط المبكى غدت مثله حكاوينا",34,"ن",2,0],["يا نهضةَ الدنيا على أكتافها اْر","تفعتْ وسوف تعود تغزو السُّوقا",35,"ق",2,0],["يا نهر عاد إليك بعد شتاته","صب يفيض الشوق من زفراته",36,"ت",2,1],["يا نهر أين مضى الزمان بأنسه","والمترع المعسول من كاساته",36,"ت",2,0],["يانهر الأحلام توقفْ","أنزلني في أرض الواقعْ",37,"ع",1,1],["يانهر الأحلام تدفق","وتحول عني لأتابع",37,"ع",1,0]]}