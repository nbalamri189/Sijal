{"poems":[[9,"يا لقيس لما لقينا العاما","https://www.aldiwan.net/poem21985.html","الخفيف"],[107,"أمنك فزارة انبعث الغزاة","https://www.aldiwan.net/poem43992.html","الوافر"],[15,"لمن الدار أقفرت بالجناب","https://www.aldiwan.net/poem45282.html","الخفيف"],[102,"استنطاق","https://www.poetsgate.com/ViewPoem.aspx?id=206345",""],[132,"شمر الذيل وبادر للعمل","https://www.aldiwan.net/poem50540.html","الرمل"],[189,"يا سادة قد كملوا","https://www.aldiwan.net/poem14737.html","مجزوء الرجز"],[266,"أعيونهن أم بيض الصفاح","https://www.aldiwan.net/poem38347.html","الرمل"],[358,"ألا خل خلي من يرى الود كلفة","https://www.aldiwan.net/poem40034.html","الطويل"],[371,"أي يوم علا على الأيام","https://www.aldiwan.net/poem17333.html","الخفيف"],[409,"يا فاضلا وافى إلينا شعره","https://www.aldiwan.net/poem33763.html","الرجز"],[484,"يا صاحب الذوق السلي","https://www.aldiwan.net/poem36980.html","مجزوء الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48653","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38371","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37999","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46514","الرجز"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123067","الرمل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88671","الرجز"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60894","البسيط"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131695",""],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131692",""],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84538","الخفيف"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87330","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65950","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94321","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204580","المجتث"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/106581",""],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66487","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110093","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205659",""],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105113","الخفيف"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147302","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120469","الوافر"],[4987,"الجدايل","https://www.poetsgate.com/ViewPoem.aspx?id=49582",""],[5026,"أيقونة على شاشة الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=213509",""],[5465,"أصبح الملك ثابت الأثاث","https://www.poetsgate.com/ViewPoem.aspx?id=98432",""],[5756,"المملكة عندنا غير","https://www.poetsgate.com/ViewPoem.aspx?id=5189",""],[5804,"بشرّوها","https://www.poetsgate.com/ViewPoem.aspx?id=180097",""],[5906,"أُمّة وأئمة","https://www.poetsgate.com/ViewPoem.aspx?id=188216",""],[520,"أعرب اذا ما الخطب لم يعرب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577440",""]],"verses":[["لا نَقيها حَدَّ السُيوفِ وَلا نَأ","لَمُ جوعاً وَلا نُبالي السُهاما",0,"م",2,0],["لإنقاذِ النُّفوسِ من البلايا","تُلِحُّ على مَبَاضِعها الأُساةُ",1,"ه",1,0],["لا نَقي بِالأَحسابِ مالاً وَلَكِن","نَجعَلُ المالَ جُنَّةَ الأَحسابِ",2,"ب",1,0],["لأن قصوراً تحجب الشمس دونها","فلا تعرف الأضواء ماذا تكابد",3,"د",1,0],["لا نقمْ إلا قليلاً عنده","قدرَ يومٍ أو ثلاثٍ أو أَقَلّْ",4,"ل",1,0],["لانقضتْ قوّتُه","ومات غيظاً وأسف",5,"ف",1,0],["لا نقسها بقوافي غيرها","كرمت لفظاً على تلك الشحاح",6,"ح",1,0],["لإن قلّ مَن يَرعى مِن الودِّ حرمةً","فَحَسبك إِبراهيم فَهو الَّذي وَفّى",7,"ف",2,0],["لا نَقولُ الكِرامُ تَعفو وَتُعفى","فَلِجودِ الكِرامِ قَتلُ الكِرامِ",8,"م",1,0],["لا نقله تلاوة لمن به","جنابة فالخلف شاع ذكره",9,"ر",2,0],["لا نقص في ميزانه","والشعر بالميزان",10,"ن",1,0],["لا نقبل الملامَ في اليابانِ","لأنهم أوفى بني الإنسانِ",11,"ن",1,1],["لانَ قَلباً وَجانِباً مَعَ عزٍّ","وَطِباعاً وَإِنَّهُ لَشَديدُ",12,"د",1,0],["لا نَقصَ فيهِ وَلَست فيهِ مُشاركاً","بَل فيكَ دَوماً لَم يَزَل يَزدادُ",13,"د",1,0],["لانقلب القَوم إليك عَنهُ","لِغَيظهم لما لَقوه مِنهُ",14,"ه",1,0],["لان قداً وكذا قلباً فذا","فاق في خَلق وذا في خُلُق",15,"ق",1,0],["لان قضوا قبل اوان موتهم","فالورد قد يذبل والعود ندي",16,"د",2,0],["لأنَّ قومي قومُ التبّعيّ وهَلْ","يا قومَ أجدعُ أنْفي عَامداً بِيَديَ",17,"د",2,0],["لأن قلبي رقيق الطبع بتسمسم","من الشي اللاش للأول مع الثاني",18,"ي",1,0],["لأن قد جاوزت في الجفا الحد","أهل الجمال ما يفعلوا كذيه",19,"ي",2,0],["لانَ قدا وَضآء صلتا وخدا","فَحَكى البدر بهجة وَكَمالا",20,"ل",2,0],["لأنَّ قَيدَ الجاهِ في أطرافِهَا","قَد شُهِرَت لِصَونِهَا أسيافُهَا",21,"ه",2,0],["لأن قعدت في سندس ورفارف","ومالت إِلى قطف القطوف تأيدا",22,"د",2,0],["لانقلب الممكن مستحيلا","أو واجبا لا يقبل التبديلا",23,"ل",2,0],["لأن قصري وهم","والوهم مثل الهباء",24,"ا",2,0],["لان قمت في صحب اساءت مفاخري","فحينا ترى بيض الجواهر في الفحم",25,"م",1,0],["لا نقص فيهم ولا شيءٌ يدنسهم","وحبهم واجب فالزم لحبهم",26,"م",1,0],["لأنقذت احتساباً كلّ ذي حَوَر","هوا به الزهو في إشراك قانصه",27,"ص",2,0],["لا نقدّ بمَهَرُها لكن رِضاكَ بها","فاستقبِلَنها بلا غَبنٍ ولا غَبَنِ",28,"ن",1,0],["لا نقصَ إن قلَّت ولا","مزيد في أن تكثرا",29,"ر",2,0],["لان قداً فكاد يعقد لينا","وجنانا قسى فكان حديدا",30,"د",2,0],["لآن قد علم المحب بأنها","عن دربه في لحظة ستزول",31,"ل",1,0],["لان قطينها طرا يراهم","له جندا وقل ان شئت ولدا",32,"د",2,0],["لانقض ليل مجدوله وخلاه","قلت وش هالظلام اللي غشاني",33,"ن",2,0],["لأنَّ قارعةَ المنفى مُسافرةٌ","في اللاوجود اتَّخذْنا أمَّنا سكَنَا",34,"ن",2,0],["لا نقيلنَّ عبد شمس عثاراً","واقطعنْ كل رَقلة وغراس",35,"س",1,0],["لأن قد المملكة عندنا غير","المحترم يفرض عليك احترامه",36,"م",2,0],["لأنقِّحَنَّ الشعرَ في","ها فالقصائدُ تزدهيها",37,"ي",3,0],["لا نَقبَلُ التَّقسيمَ حَتّى يَستَوي","حَدٌّ سَما بِالأَمسِ فيمَنْ كَبَّروا",38,"ر",3,0],["لأنقضن الهون عن خاطري","نفض سقيط الطل عن منكبي",39,"ب",2,0]]}