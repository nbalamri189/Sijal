ى وَكَأَن","نا اليَومَ في هُدنَةٍ مَعَ الأَزمانِ",0,"ن",1,0],["في حَيثُ تَنزو عَذَباتُ الحُبا","بِالقَومِ حَتّى تَستَطيرَ الحُلوم",1,"م",1,0],["في حَيثُ لا وِردُ العَطاءِ مُصَرَّدٌ","أَبَداً وَلا فِعلُ الزَمانِ مِذَمَّمُ",2,"م",1,0],["في حَيثُ لا يَلَذُّنا","مُعتَنِقٌ وَمُلتَزِم",3,"م",1,0],["في حِمى طولِكَ اِهتَزَزتَ وَأَورَق","تَ قَريبَ الجَنى بِصَوبِ نَداكا",4,"ك",2,0],["في حَيثُ لا طَمعٌ يوماً لِذي طَمَعٍ","في أَن يَعودَ وَلا رُجعى لِمُرتَجِعِ",5,"ع",1,0],["في حَيثُ لا تَنظُرُ تَحتَ نَقعِها","إِلّا عَصيَّ المَوتِ أَو قِراعَها",6,"ع",3,0],["في حَسَبٍ أَصبَحَ وَضّاحُهُ","قَد غَلَبَ الشَمسَ عَلى المَطلَعِ",7,"ع",1,0],["في حَيثُ سُدَّ عَلى الطُيورِ مَجالُها","حَتّى رَعى ما في الوُكورِ الطائِرُ",8,"ر",1,0],["في حَيثُ لا حُكمٌ لِغَيرِ القَنا","وَلا مُطاعٌ غَيرَ داعي الكِفاح",9,"ح",1,0],["فَيُحسَبُ عَيّاً سُكوتُ الحَليمِ","وَيُعطى السَفيهُ حُظوظَ الفِصاحِ",10,"ح",1,0],["في حَيثُ لِلراجي الثَوا","بُ نَدىً وَلِلجاني العِقابُ",11,"ب",1,0],["في حيثُ يَقتَنصُ الأسودَ ضَوارِياً","لَحْظٌ تُمَرِّضُهُ المَهاةُ الخاذِلُ",12,"ل",1,0],["في حَومَةِ الحَربِ الَّتي لا تَشتَكي","غَمَراتِها الأَبطالُ غَيرَ تَغَمغُمِ",13,"م",1,0],["في حيثُ فاخَرَ بالوِزارَةِ فاخِرٌ","كَلاّ وباهَى بالعَلاءِ مُباهِي",14,"ي",1,0],["في حَوْمَة الحرْبِ أسودَ الشّرَى","وفي الظّلامِ سُجَّداً رُكّعا",15,"ع",2,0],["في حَومِ لُجَّةِ آذِيٍّ لَهُ حَدَبٌ","مَن رامَها فارَقَتهُ النَفسُ فَاِعتُلِقا",16,"ق",2,0],["في حَضرَةٍ غابَ صَرفُ الدَهرِ خَشيَتَهُ","عَنها وَنامَ القَطا فيها فَلَم يَثُرِ",17,"ر",1,0],["فِي حَيِّكُمْ لِيَ قَلْبٌ جِدُّ مُرْتَهَنِ","يُحِبُّكُمْ وَبِغَيْرِ الْحُبِّ لَمْ يَدِنِ",18,"ن",1,1],["فَيَحْكِي رَايَةً غَرَّاءَ تَسْعَى","لِتَشْفِي كُلَّ ذِي دَاءٍ دَفِينِ",19,"ن",1,0],["فَيُحَاوِرُ القَهَّارُ غَيْرَ مُمَاذِقٍ","وَيُدَاوِرُ الجَبَّارَ غَيْرَ جَبَانِ",20,"ن",1,0],["فِي حُبِّ مِصْرَ وَفِي ابْتِغَاءِ رُقِيهَا","يَقِظَانَ ذَاكَ الْقَلْبُ وَالأَحْلامُ",21,"م",1,0],["في حُبِّ آلِ المُصطَفى وَوَصِيِّهِ","شُغلٌ عَنِ اللَذاتِ وَالقَيناتِ",22,"ت",1,0],["في حياة جدّو ننعش","عندما نكتب صداق",23,"ق",1,0],["في حاله واللهِ أعظم عِبرةٍ","لله عَبدٌ في القضاء قد اعتبرْ",24,"ر",1,0],["في حَيكُمُ قمرٌ فؤادي أُفْقُهُ","تفديهِ نفسي من قريبٍ نائي",25,"ا",2,0],["فيَحمي بلاد المسلمين من العدى","وينهض كشافاً لهم غُمّة الخطب",26,"ب",1,0],["فيَحظَوْن منها بالنفائس دونهم","ويعطونهم منها السَقيط من الخُرثى",27,"ث",2,0],["في حَومة الإحسان طال صيالكم","حقاً فأنتم أشرف الأبطال",28,"ل",1,0],["فيحمرّ منها في الغَدّية مطلع","ويصفرّ منها في العشيّ مغيب",29,"ب",1,0],["فَيَحمَدُ قِدرَ أَربَدَ مَن عَراها","إِذا ما ذُمَّ أَربابُ اللِحامِ",30,"م",1,0],["في حومة الفيلق الجأواءِ إن ركبتْ","قسر وهيضَلُها الخشخاش إن نَزلوا",31,"ل",3,1],["في حَراجِيحَ كالحِنِيّ مَجَاهِي","ضَ يَخِدنَ الوَجِيفَ وَخدَ النَّعَامِ",32,"م",1,0],["في حسن يوسف في شمائله وفي","مدح ابن يعقوب القرائح تشعر",33,"ر",1,0],["في حمى الشام وفي الدنيا له","نعمٌ زائدةٌ تخجل معنى",34,"ن",2,0],["في حروبٍ لا تُصطَلى لتراتٍ","وقتال بغير ما شَحْناءِ",35,"ا",2,0],["في حِجاهُ وفي نداهُ أمانَا","نِ من الخوف والزمانِ الجديبِ",36,"ب",1,0],["في حَبيرٍ مُنمنَمٍ وعَبيرٍ","وصِحانٍ فسيحةٍ ورِحابِ",37,"ب",1,0],["في حياةٍ من الوزير الذي أضْ","حَى به المُلْكُ مُسْتَقِلَّ العَمُودِ",38,"د",1,0],["فيحق لي في كل ما","لاقيتَني أن أُرفدا",39,"د",2,0],["في حشاه من مخافته","حُرُقاتٌ تلْذع الكبِدا",40,"د",2,0],["فيَحدو به أنْ ليس للحمدِ بائع","يراك وإن أغْلى عليك تُماكسه",41,"س",2,0],["فيُحجمُ عنها العائبونَ مهابةً","وما بهمُ إذ ذاك خوفُ قِصاص",42,"ص",1,0],["في حيث تلقى أنف مجدك شامخاً","ويرى عدوُّك أنفه مجدوعا",43,"ع",2,0],["فيحسبُ قومي ذاك مني تأثُّماً","ومن خشيةِ التقصيرِ أفعلُ ذلكا",44,"ك",2,0],["في حيث يقصرُ باعُ كُلّ مساوِرٍ","دوني ويحْسرُ ناظرُ المتأمّلِ",45,"ل",1,0],["فيحتال بُخلاً لأن يُفْطِروا","على رَفَثِ القولِ دون الطعامِ",46,"م",1,0],["فَيَحارُ بَينَ مَجيإِه وَذَهابِهِ","وَيَحارُ بَينَ أَمامِه وَوَرائِهِ",47,"ه",1,0],["في حَومَةِ المَوتِ وَظِلِّ البِلى","قَدِ يلتَقى السُلطانُ وَالشاعِرُ",48,"ر",1,0],["في حُبِّكَ قَد بَذَلتُ روحي","إِن كُنتَ لِما بَذَلتُ قابِل",49,"ل",1,0],["في حيرةٍ مشبوبةٍ","أَيْنَ اختفى هذا الأَمينْ",50,"ن",1,0],["في حُشَاشَاتِ الطُّيورْ","أَمْ بَكَى خَلْفَ السَّحَابْ",51,"ب",1,0],["في حياتي أنا لاقي","ت صنوف المشكلات",52,"ت",1,1],["فيحل من أقوى المرا","فق والمراشد كل مبرم",53,"م",1,0],["فَيحاءُ أَينَ عَلى جِنانِكِ وَردَةٌ","كانَت بِها الدُنيا تَرِفُّ وَتَعبَقُ",54,"ق",1,0],["في حَسَبٍ أَوْفَى لَهُ جَحْفَلٌ","يَقْدُمُهُ مِنْ رَأْيِهِ جَحْفَلُ",55,"ل",1,0],["فيحرق الصخر ويرثى على","قُلّته يا لك من وكرِ",56,"ر",1,0],["في حُلَّتَيْ حُسْنٍ ووشيٍ فاخرٍ","من لم يَغُضَّ الطرفَ دونَهما غُشِي",57,"ش",2,0],["في حلقِ كلِّ مُكايدٍ منه شجاً","وبصدرِ كُلِّ منابذٍ أُلهوبُ",58,"ب",1,0],["في حُلَّةٍ خَضراءَ نَمنَمَ وَشيَها","حَوكُ الرَبيعِ وَحُلَّةٍ صَفراءِ",59,"ا",2,0],["في حَيثُ لا يُلفي الشَريفُ مُناسِباً","يَحنو عَلَيهِ بِرَأفَةٍ وَتَحَدُّبِ",60,"ب",1,0],["في حُلَّتي حِبرٍ وَرَوضٍ فَاِلتَقى","وَشيانِ وَشيُ رُباً وَوَشيُ بُرودِ",61,"د",1,0],["في حَيثِ يَعتَصِرُ النَدى مِن عودِهِ","وَيُرى مَكانُ السُؤدُدِ المَنشودِ",61,"د",1,0],["في حَلبَةٍ تَضحَكُ عَن بُدورِها","صارَ الرِجالُ شُرُفاً لِسورِها",62,"ر",3,0],["في حُضورِ الفِراقِ عِندَ لِقاءَي","كَ اِحتِراقٌ يَفوقُ كُلَّ اِحتِراقِ",63,"ق",1,1],["في حَيثُ أَطلَقَتِ الشِمالُ عِقالَها","وَدَنا الخَريفُ بِقَطرِهِ المُتَداني",64,"ي",1,0],["في حُمرَةِ الوَردِ شَكلٌ مِن تَلَهُّبِها","وَلِلقَضيبِ نَصيبٌ مِن تَثَنّيها",65,"ي",3,0],["فَيحاءُ مُشرِقَةٌ يَرِقُّ نَسيمُها","ميثٌ تُدَرِّجُهُ الرِياحُ وَأَجزَعُ",66,"ع",1,0],["في حَومَةٍ غَمَرَت أَباكَ بُحورُها","في الجاهِلِيَّةِ كانَ وَالإِسلامِ",67,"م",1,0],["في حاملِ الكأسِ من بَدْرِ الدُّجَى خَلَفٌ","وفي المُدامَةِ من شَمْسِ الضُّحَى عِوَضُ",68,"ض",1,0],["في حُلَلٍ قد شُدَّدَتْ أزرارُها","يَضحكُ في لُجَينِها نُضارُها",69,"ر",3,0],["في حَومَةِ المَوتِ إِذ ثابَت حَلائِبُهُم","لا مُقرِفينَ وَلا عُزلٍ وَلا ميلِ",70,"ل",1,0],["في حَرِّ نيرانِ","لِمَ ذا يَلوم",71,"م",1,0],["في حَضرَةِ المَلِكِ الَّذي","جَعَلَ الصَنائِعَ كَالغُروسِ",72,"س",1,0],["في حُبِّ ذي القُرطَينِ يا لائِمي","لي شاغِلٌ عَن حُبِّ ذاتِ الوِشاح",73,"ح",1,0],["في حبه فَنِيَ الصبا","وشبابُ أيامي جَلِي",74,"ي",1,0],["فيحس لا شيء ينازعه","ويحول عنه الكون إذ ينساق",7