ويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94798","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94786","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94790","الطويل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81948","الطويل"],[4307,"","https://poetry.dctabudhabi.ae/diwan/poem/31539","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120227","الطويل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67575","الرجز"],[4670,"","https://poetry.dctabudhabi.ae/diwan/poem/143602","الوافر"],[4767,"النهج الأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=179919",""],[585,"خذوا بيدي فالدهر جاشت غواربه","https://www.poetsgate.com/ViewPoem.aspx?id=161927",""],[585,"هنا المحفل المشهود بالشعب يزخر","https://www.poetsgate.com/ViewPoem.aspx?id=161897",""],[585,"دعوت وقد أسمعت يا خير قائل","https://www.poetsgate.com/ViewPoem.aspx?id=161902",""],[5189,"ألاَ يا عبدُ ما لك قد غَفِلتا","https://www.poetsgate.com/ViewPoem.aspx?id=190968",""],[5189,"ألا ما لقلبك","https://www.poetsgate.com/ViewPoem.aspx?id=208954",""],[5277,"وما مثلُ العراق","https://www.poetsgate.com/ViewPoem.aspx?id=191713",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5431,"كذلك أعثرنا عليهم ليعلموا ...(الحسين)","https://www.poetsgate.com/ViewPoem.aspx?id=215785",""],[5582,"لِمَنْ بِطُلُولِ الأَبْرَقَيْنِ مُقامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187300",""],[5650,"غوايةُ الموجِ الغَدور","https://www.poetsgate.com/ViewPoem.aspx?id=177956",""],[5691,"عاصمة السماء","https://www.poetsgate.com/ViewPoem.aspx?id=206341",""],[6031,"بِرغمِ العَوَالِي والمُهَنَّدَةِ البُتْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=46342",""],[6068,"خليليّ عوجا لدرعا البلدْ -06-","https://www.poetsgate.com/ViewPoem.aspx?id=175893",""],[6134,"أشمس على الأيدي حملتم وسرتم","https://www.poetsgate.com/ViewPoem.aspx?id=169577",""],[6212,"عيون الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1622&r=&rc=3",""]],"verses":[["فَوَيلٌ عَلى صَبٍّ يُؤَرِّقُ طَرْفَهُ","سُهادٌ يُناغيهِ وَدَمعٌ يُغازِلُهْ",0,"ل",2,0],["فَوَيلٌ لِكِسرى إِن حَلَلتُ بِأَرضِهِ","وَوَيلٌ لِجَيشِ الفُرسِ حينَ أُعَجعِجُ",1,"ج",1,0],["فَوَيحَ مُحِبَّينِ لَم يَلقَيا","سُروراً سِوى نَظَرٍ مِن بَعيدِ",2,"د",1,0],["فويحاً لأهل الرافدين إذ انطووا","على اليأس من نور يشُق الغياهبا",3,"ب",2,0],["فويل له من حاكم صُبَ قلبه","من الجور مطبوعاً على قالب الغدر",4,"ر",1,0],["فَوَيلَكَ مَن لِلحَربِ إِن لَم نَكُن لَها","وَمَن ذا الَّذي يُمسي وَيُضحي لَها تِربا",5,"ب",2,0],["فَوَيلُ اِمِّها مِن خُلَّةٍ لَو تَنَكَّرَت","لِأَعدائِنا أَو صالَحَت مَن نُصالِحُ",6,"ح",1,0],["فويلٌ لمَنْ لم تَشُقْهُ الحياةُ","من صَفْعَةِ العَدَمِ المنتصرْ",7,"ر",1,0],["فويلٌ لمنْ لم تَشُقْهُ الحَيَاةُ","منْ لعنةِ العَدَمِ المنتصرْ",7,"ر",1,0],["فويح المدنف المعمو","د حتى البث يُحرمه",8,"م",2,0],["فَوَيحَ المُتَيَّمِ حَتّى الخَيالُ","إِذا زارَ لَم يَخلُ مِن حائِلِ",9,"ل",1,0],["فَوَيلُ أَبيكَ كَيفَ أَفِنتَ حَتّى","جَعَلتَ الناسَ كُلُّهُمُ خُصوما",10,"م",2,0],["فَوَيلٌ لِشِعرِ أَبي البَرقِ إِن","أَطافَ بِهِ الأَشيَبُ الأَنزَعُ",11,"ع",1,0],["فوَيحَكُما هلاَّ بِشَطْرٍ قَنِعتُما","وأبقَيْتُما لي من مَحاسِنِها شَطرا",12,"ر",2,0],["فَوَيلٌ ثُمَّ وَيلٌ ثُمَّ وَيلٌ","لِجاحِدِ طاعَتي مِن غَيرِ جُرمِ",13,"م",1,0],["فوَيحك هل عَبَرَتْ ساعةٌ","ونفسُك عن زلّةٍ راغبه",14,"ب",2,0],["فَوَيْلِي مِنْ غَرِيبِ الدَّلْ","لِ أَبْلانِي تَحَكُّمُهُ",15,"م",2,0],["فَوَيلُ اِمِّها أُمنِيَّةً لَو تَفَهَّمَت","مَعانِيَها أَو كانَتِ اللُبَّ تُعمِلُ",16,"ل",1,0],["فويحي للقواصفِ من قوافٍ","كأمثالِ القواذفِ باللهيبِ",17,"ب",1,0],["فويحي للأُسودِ إذا استباحت","حِمَى الحَرَميْن أيدي النّاهبينا",18,"ن",2,0],["فَوَيحَ القُلوبِ وَوَيحَ العُيونِ","لِحُزنٍ تَوالى وَخَطبٍ تَمادى",19,"د",2,0],["فوَيْلٌ لِقَوْمٍ مِنْ يَراعٍ كأنّه","خِلالٌ يَرُوعُ الأُسْدَ منه صَرِيرُ",20,"ر",1,0],["فَوَيلي مِنهُ حينَ يُفي","قُ مِن غَمَراتِ سَكرَتِهِ",21,"ت",2,0],["فَوَيلي مِنَ الحُمّى وَوَيلي مِنَ الهَوى","لِأَيِّهِما أَبغي دَواءَ الطَبائِبِ",22,"ب",1,0],["فَوَيحَهُم بِئسَ ما رَبّوا وَما حَضَنوا","فَهيَ الخَديعَةُ وَالأَضغانُ وَالحَسَدُ",23,"د",1,1],["فَوَيحَ النَفسِ مِن أَمَلٍ بَعيدٍ","لِأَيَّةِ غايَةٍ في الأَرضِ تَجري",24,"ر",2,0],["فَوَيهاً وَواهاً لِسَيلِ المَنو","نِ كَم جَرَّ عيراً بِأَحمالِها",25,"ل",3,0],["فَوَيحٌ لِخاطِئَتَي مارِدٍ","تَنُصّانِ في ما لَهُ تَخطُوانِ",26,"ن",1,0],["فَوَيْحَ المَنايا لم يُبْقيّنَ غايَةً","طَلعنَ الثّنايا واطّلعْنَ على النّجْمِ",27,"م",1,0],["فُوَيقَ جُبَيلٍ شامِخِ الرَأسِ لَم تَكُن","لِتَبلُغَهُ حَتّى تَكِلَّ وَتَعمَلا",28,"ل",2,0],["فَوَيلي عَلى العُذّالِ ما يَترُكونَني","بِغَمّي أَما في العاذِلينَ لَبيبُ",29,"ب",1,0],["فَوَيْلُمِّهَا مِنْ نَظْرَةٍ مَضْرَحِيَّةٍ","رُمِيتُ بِهَا مِنْ حَيْثُ وَاجَهَنِي الأَثْلُ",30,"ل",1,0],["فَوَيْلٌ لِهَذَا الدَّهْرِ مَاذَا أَرَادَهُ","إِلَيْنَا وَقَدْ كُنَّا كِرَامَ الْمَحَاصِلِ",31,"ل",1,0],["فويلمها منْ نظرة ٍ مضرجية ٍ","رُمِيتُ بِهَا مِنْ حَيْثُ وَاجَهَنِي الأَثْلُ",32,"ل",1,0],["فُويقَ صدرِكِ من رفق الشبابِ به","أشهى وأعنفُ ما يُعطى لمنتهد",33,"د",1,0],["فَوَيْلُ کمِّهَا مِنْ خُلَّة ٍ لَوْ تَنَكَّرَتْ","لأعَدائِنَا أوْ صَالَحَتْ مَنْ نُصَالِحُ",34,"ح",1,0],["فَوَيحَ اِبنِ أَكمَةَ ماذا يُريد","مِنَ المُرعَشِ الذاهِبِ الأَدرَدِ",35,"د",1,1],["فويلٌ يا تقاليدا تحابي","نفوسا دنست وجه الثريا",36,"ي",2,0],["فويل لم عاداك ما بقى الشقا","أرى مثله في الأشقياء ما بقى حيا",37,"ي",2,0],["فويلك استقل لا تفضحنها بمشهد","من الخلق إن كنت ابن ام كريمة",38,"ه",1,0],["فويلك تدري من تناجيه معرضا","وبين يدي من تنحني غير مخبتِ",38,"ت",1,0],["فَوَيْحَكُما يا واشِيَيْ أُمِّ هَيْثَمٍ","فَفِيمَ إِلى مَنْ جِئتُما تَشيانِ",39,"ن",1,0],["فَوَيْلي على عفراءَ وَيْلٌ كأَنَّهُ","على النَّحْرِ والأحشاء حَدُّ سِنانِ",40,"ن",1,0],["فويحَ المَنايا كيف غالتْه وهْي من","صَنائِعِكم فيما يُخاف ويُحْذَر",41,"ر",1,0],["فَويلٌ لهُ ويلٌ لمن يتّبعونهُ","وَمَن كانَ مِن أعدائِهم فله البُشرى",42,"ر",2,0],["فَوَيلُهَا حرباً ضراراً زَريةً","بها كل دين للأنام كفورُ",43,"ر",1,0],["فويحَ قلبي ما من مرّةٍ صدحتْ","إلا شعرتُ بقلبي بينَ آذاني",44,"ن",2,0],["فويجَ الورى همْ سعرُّوها وبعضهم","لها حطبٌ والبعضُ فيها موقعُ",45,"ع",1,0],["فَوَيلَهُ مِن غَبيٍ بتَّ تطلِبُهُ","وَباتَ نَشوانَ خَمرٍ غَيرَ نشيانِ",46,"ن",1,0],["فويل لمن قد ساقه النحس نحوهم","هم الحتف ان هزوا اللوا والعمائما",47,"م",2,0],["فويح من كان جوّالاً بمقوله","وَما له في مجالِ القولِ متَّسع",48,"ع",1,0],["فَوَيحَها لَذَّةً كَمّ أَعْقَبَتْ نَدَماً","كَواجِدٍ لَذَّةً مِن حَكَّةِ الجَرَبِ",49,"ب",1,0],["فَويلٌ لِأَهل الكُفر شَرّ عِصابة","عَلى قَتل خَير المُرسَلين تَعَصّبوا",50,"ب",3,0],["فويلٌ لهذا ثم ويلٌ لأمه","علينا إذا ما حَركَتهُ حواربهُ",51,"ب",2,0],["فَويحَ العِدا من بأسها إنما سرى","إليها ولم تَشْعُر ردىً وَأداهُمُ",52,"م",1,0],["فويحَ زمانٍ فرّقتَنا صرُوفُه","أكانَ عليهِ في تَفرُّقِنا نَذْرُ",53,"ر",1,0],["فويلك قد كفرتَ ولستَ تَدري","ولم تبرح على هذا مُصِرَّا",54,"ر",2,0],["فويل لم الدافتيه عشيّة","لقد غيبوا تحت الثرى سنة الفجر",55,"ر",1,0],["فويلاه إذ صاح فيدارنا","غراب على غصن من غرب",56,"ب",1,0],["فويل كل غوي في غوايته","وويح من كان عن غي سلامته",57,"ت",2,0],["فويلاً له قد لقي كدحه","ولم يرج يفديه من ذاك فادي",58,"د",2,0],["فويلكم برّوا ولا تحلفوا على ال","روّاج يمينا يكتم العيب فاجرا",59,"ر",2,0],["فويلاه من قبح المشيب وهجره","وآهاً على حسن الشباب ووصلهِ",60,"ل",2,0],["فَوَيْحَ صَبًّ دمعُهُ","بعدَ الفراقِ مَوْرِدُه",61,"د",2,0],["فويحَ دمعٍ إذا ناحَ الحمامُ على","باناتِ سَلْعٍ رأيتُ التربَ تشربُه",62,"ب",2,0],["فَوَيْلٌ ثُمَّ وَيْلٌ ثُمَّ وَيْلُ","لِقاضِي الأَرْضِ منْ قَاضِي السَّماءِ",63,"ا",2,0],["فَويلٌ لِنفسٍ حُلِّئِتْ عَن مَرامِها","وويلٌ لنفسٍ أُعطيتْ ما تمنّتِ",64,"ت",1,0],["فويلاه ويلاه مني ومن","تدليه لما دنا ملفتا",65,"ت",2,0],["فَوَيحَ الرَدى كَيفَ اِنبَرى لِاِختِطافِها","وَلَم تَدُم مُذ مَدَّت يَداهُ أَنامِلُهُ",66,"ل",2,0],["فويحِي من الموت الذي هو واقعٌ","ولِلمَوتِ بابٌ أنت لابُدَّ داخِلُه",67,"ل",2,0],["فويق القذال مدوّرة","كطغراء عبد الحميد المظفر",68,"ر",1,0],["فَوَيْحَهُمْ يومَ للأعلامِ مُلْتَطَمٌ","عليهِمُ وبِهِمْ للجُرْدِ مُلْتَطَأُ",69,"ا",1,0],["فويل ابن سعد أتعس الله جده","ولا ابن زياد وهو أشقى وألأم",70,"م",1,0],["فَوَيحَ دِمَشق الشّام لَم تَحوِ مِثلَهُ","فَلَم تَحوِهِ الدّنيا وَهَذا هوَ الفَخرُ",71,"ر",1,0],["فويلُ امِّها خلَّةٌ لو تدوم","على ما تقول ولا تكذبُ",72,"ب",1,0],["فويل اذا أجني الرجاء وأجتدى","سليم نوال في الانام عسيبا",73,"ب",2,0],["فويلٌ لمن أضحى حليف معاند","ولو بات تحميه صدور السلاجم",74,"م",1,0],["فَوَيحَكَ يا غُرابُ البَينُ ماذا","وَراءَكَ أَيُّ شَيءٍ قَد عَراكا",75,"ك",2,0],["فَوَيلُكَ يا مَلعونُ مِنهُ إِذا سَطا","بِصارِمِهِ يَومَ العَجاجِ وَإِن وَثَب",76,"ب",1,0],["فويل بني مروان ماذا أصابهم","بأيدي بني العباس بالأسر والقتل",77,"ل",1,0],["فويل لززور عندها متكشف","وويل لحق عندها متلئم",78,"م",1,0],["فويعلٌ واسم له سميّ","ومع مفيعيل أخ أخيّ",79,"ي",1,0],["فويلَ القلوبِ إذا ما رَنَوْتَ","وإمَّا شَدَوْتَ فويلَ الجُيوبْ",80,"ب",1,0],["فويلاه كيف الجهل قد بات سائدا","يتيه دلالا عندما الدهر ولاه",81,"ا",2,0],["فويلى عليه لو شفى الويلُ علّةً","ووَاحسرتَا لو كان يُغنى التّحسُّرُ",82,"ر",1,0],["فويلها أي أوتار بها طلبت","وأي طالب وتر خصمها كانا",83,"ن",2,0],["فويلُ القريض لقد أصبحتْ","به أغبياء الورى تدَّعي",84,"ي",1,1],["فويل ثم ويل ثم ويل","لهم مني بمشتد العويل",85,"ل",1,0],["فويل لمقصوص الجناح إِذا رأى","النَواهِض إِذ حلقن وَهُوَ حَسير",86,"ر",1,0],["فويل الغرام الذي ساءنا","وصبرٌ جميلٌ على ما أمر",87,"ر",1,0],["فويحها جنا غراما فسلسلا","وقد آثرا غل الاسار على الفك",88,"ك",1,0],["فويل مكّة من آثار وطأته","وويل أم قريش من جوى الهبَل",89,"ل",1,0],["فويح المسلمين هناك ولّوا","فراراً لا أسميه انهزاما",90,"م",2,0],["فويحك أقدمي يا نفس إني","خلقت لكل مقدمة قدامى",90,"م",2,0],["فَوَيلٌ بِها لِمَن تَكونُ ضَجيعَةً","إِذا ما الثُرَيّا ذَبذَبَت كُلَّ كَوكَبِ",91,"ب",1,0],["فويجي ثم ويحي من","تنائيها ولقياها",92,"ه",2,0],["فويح داعي الفراق كيف به","لشوم بختي على شقاي دعا",93,"ع",2,0],["فويتر المقلة حلو المزاح","أتعبني في حبه واستراح",94,"ح",1,1],["فويح فؤادي ان يكون مراثياً","تخط وتمحى بالدموع سطورها",95,"ر",3,0],["فويح القوافي كم تحوم على المنى","ظماءً وكم عنا تصدّ وتصدف",96,"ف",1,0],["فويح اللي