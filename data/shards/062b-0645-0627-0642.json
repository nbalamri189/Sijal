{"poems":[[94,"أيها الشعب ليتني كنت حطابا","https://www.aldiwan.net/poem38934.html","الخفيف"],[91,"آه يا ليلى خدرك اليوم قبر","https://www.aldiwan.net/poem44665.html","الخفيف"],[68,"ثقتي بغير هواكم لا تحدث","https://www.aldiwan.net/poem38498.html","الكامل"],[82,"أشهاب في دجى الليل ثقب","https://www.aldiwan.net/poem31545.html","الرمل"],[33,"راح صحبي ولم أحي النوارا","https://www.aldiwan.net/poem42529.html","الخفيف"],[50,"يا أيها العاذل دع ملحاتي","https://www.aldiwan.net/poem62460.html","الرجز"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9946","البسيط"],[33,"رَاحَ صَحبي وَلَمْ أُحَيِّ النَّوارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18873&r=&rc=136",""],[115,"الحمد لله على ما الهما","https://www.aldiwan.net/poem2368.html","الرجز"],[185,"يا للرجال هوى أميمة قاتلى","https://www.aldiwan.net/poem58883.html","الكامل"],[286,"اسمع حديثي فإن الصدق مقبول","https://www.aldiwan.net/poem1382.html",""],[305,"أفد الرحيل وليته لم يأفد","https://www.aldiwan.net/poem45492.html","الكامل"],[333,"خطرت كالنسمة السكرى","https://www.aldiwan.net/poem55050.html","مجزوء الرمل"],[409,"ناقضت ما قلت يا جهول","https://www.aldiwan.net/poem33603.html","مخلع البسيط"],[445,"ثم أقدمتهن شعث النواصي","https://www.aldiwan.net/poem34764.html","الخفيف"],[445,"النصر حزبك في الضلالة فاحتكم","https://www.aldiwan.net/poem34807.html","الكامل"],[453,"حبذا والحال داجي الظلم","https://www.aldiwan.net/poem53777.html","الرمل"],[549,"قصائدي في مهب العشق قافلة","https://www.aldiwan.net/poem67245.html","عموديه"],[563,"إن الحروف إشارات المداد فلا","https://www.aldiwan.net/poem33579.html","البسيط"],[563,"عالم الحكمة هذا","https://www.aldiwan.net/poem34558.html","مجزوء الرمل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[608,"","https://poetry.dctabudhabi.ae/diwan/poem/93485","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62531","البسيط"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107216","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72327","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46515","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77886","الكامل"],[2221,"","https://poetry.dctabudhabi.ae/diwan/poem/34831","المجتث"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87318","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2888,"","https://poetry.dctabudhabi.ae/diwan/poem/46729","الكامل"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109887","الكامل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199030","الرجز"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85257","البسيط"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[4434,"","https://poetry.dctabudhabi.ae/diwan/poem/130704","الرجز"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136412",""],[4767,"عودة الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=94471",""],[4859,"أغصان الهنا","https://www.poetsgate.com/ViewPoem.aspx?id=211004",""],[5186,"في ليلة القدر أتاح الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=156523",""],[5866,"مجاراة لقصيدة الشاعر حسن عامر","https://www.poetsgate.com/ViewPoem.aspx?id=182812",""],[5887,"سأل الطبيب","https://www.poetsgate.com/ViewPoem.aspx?id=35336",""],[6102,"حل الأحجية","https://www.poetsgate.com/ViewPoem.aspx?id=183655",""],[6102,"قاومي","https://www.poetsgate.com/ViewPoem.aspx?id=184633",""]],"verses":[["ثمَّ أقضي هناكَ في ظلمةِ اللَّيل","وأُلقي إلى الوُجُودِ بيأسي",0,"س",2,0],["ثم اقضى نحبي عليه فتدنى","ميتتي فوقه اليك رجوعي",1,"ي",1,0],["ثُمَّ اِقتَسَمنا بِالسُرورِ وَأُشرِكَت","في طيبِ بُشرانا النِياقُ الدُلَّثُ",2,"ث",1,0],["ثمّ أقبلتُ إلى الملكِ الذي","مدَّ بالطَّوْلِ على الدنيا طُنُب",3,"ب",1,0],["ثُمَّ أَقبَلتُ رافِعَ الذَيلِ أُخفي ال","وَطءَ أَخشى العُيونَ وَالنُظّارا",4,"ر",2,0],["ثُمَّ اِقتَعِدها باكِرَ الغَداةِ","فَاستَلَّ مِنها مُهَجَ الحَياةِ",5,"ه",1,0],["ثم أَقادَ اللَّهُ من أعْدائهِ","وأَحْكَم النصرَ لأوْليائهِ",6,"ه",1,0],["ثُمَّ اِقتَفوا أَثَري مِن بَعدِ ما عَلِموا","أَنَّ المَنِيَّةَ سَهمٌ غَيرُ مُنصَرِفِ",7,"ف",1,0],["ثُمَّ أَقْبَلْتُ رَافِعَ الذَّيْلِ أُخْفي کلْ","الوطءَ، أخشى العيونَ والنظارا",8,"ر",2,0],["ثُمَّ أَقولُ بَعدُ في المنازِل","مقالَ إيجازٍ بِلفظٍ شامِل",9,"ل",1,0],["ثُمَّ اقتَرَبنَ إِلى المَناهِلِ وانقَضى","زَرعُ المَصِيفِ مِنَ البُطُونِ الضّاهِلِ",10,"ل",1,0],["ثم أقبلوا من سلامي ردَّ عاطرة","تسري إليكم ودوح البان مطلول",11,"ل",1,0],["ثُمَّ اِقتَحَمتُ مُناجِداً وَلَزِمتُهُ","وَفُؤادُهُ زَجِلٌ كَعَزفِ الهُدهُدِ",12,"د",1,0],["ثم أقبلت فأيقظت","هواه فتنهد",13,"د",1,0],["ثم أَقِسْتَ الإِله جهلاً","بحادث حاله يحول",14,"ل",1,0],["ثُمَّ أَقْدَمْتَهُنَّ شُعْثَ النَّوَاصِي","يَتَهادَيْنَ فِي فُضُولِ الدِّلاصِ",15,"ص",1,1],["ثُمَّ اقْتَحَمْتَ الحربَ فِي ضَنْكِ الوَغى","والموتُ فِي عَلَقِ الجَناجِنِ يَقْتَحِمْ",16,"م",1,0],["ثم أقدمت مع العجز ولم","يك هذا لي لو لم ترسم",17,"م",1,0],["ثم اقلبي صفحة أُخري .. سَيُسعدُني","أني ألاقِيكِ في جثماني الثاني",18,"ن",2,0],["ثم اقتضت أنها تبدو معددة","في كثرةٍ باختصارٍ مَرْأَةً رجلا",19,"ل",2,0],["ثم أقوام اعتزال","مُطروا الغيَّ رذاذا",20,"ذ",2,0],["ثم أقامه على البصيرة","بقربه يسمعهم تكبيره",21,"ه",1,0],["ثم اقتفى من بعده منهاجه","صاحبه فأكثر اعوجاجه",21,"ه",1,0],["ثم اقتَدُوا بالأُلى كانوا لكم غُرَرا","ولَيسَ من أُمَّةٍ إلا لها غُرَرُ",22,"ر",1,0],["ثم اقصدنْ بجوار البر طيخة مس","لمٍ تصادف بها رشداً لمغتنم",23,"م",1,0],["ثُمَّ اقصِدِي تِلكَ القِبابَ وباشِري","ذاكَ الجَنابَ بأَلطفِ الإِحسانِ",24,"ن",1,0],["ثم اقتفى فعله الثاني ودام على","الاغضاء عن حقه خوفاً من الفتن",25,"ن",1,0],["ثُم أَقامَت أُمهُ تُرضعه","وَتُطعم الجُند الَّذي يَتبعه",26,"ه",1,0],["ثم اقسم الدائرة المذكوره","مربَّعا كما ترى في الصوره",27,"ه",1,0],["ثم اقرئي منا السَلام عليهم","وَتواجدي عَن وَجدنا وَتنفسي",28,"س",2,0],["ثُمَّ اِقصِفوا الظَهرَ مِنّي","بِالبَشتَباناتِ قَصفا",29,"ف",2,0],["ثم أقام الله منزل الزمر","فيها الأشج العادل البرَّ عمر",30,"ر",1,0],["ثُمَّ اقصُدِ الواقِع إلى مُلُوكِ","وبَرنِيِ البارَ بِلاَ شُكُوكِ",31,"ك",1,0],["ثُمَّ آقصُدِ العَقرَبَ وَالإِكلِيل","تَرَقَّ بِاللَّيلِ بِذَا الدَّلِيل",32,"ل",1,0],["ثُمَّ اِقضِ حَقَّ الوالِدَينِ وَقُم بِما","فَرَضَ الكِتابُ عَلَيكَ مِنهُ وَابدُرِ",33,"ر",1,0],["ثم أقام أود التكيه","من كل ما به لها مزيه",34,"ه",1,0],["ثمَّ اقدَعُوا نفساً غَدَت أَمَّارةً","بالسُوءِ إِنَّ الحَوبَ في الحَوباءِ",35,"ا",2,0],["ثم أقامت هذه الصقالبه","لابن أبي عامرهم بشاطبه",36,"ه",1,0],["ثم اقتفتهم بنو العباس تضربهم","بالمشرفية ضرباً مسرفاً عنفا",37,"ف",2,0],["ثم أقمنا الفجرَ بعد الدّلجَه","وبعده المسير نحو الشِجَّه",38,"ه",1,0],["ثم أقَمنَا لصباحِ الثامنِ","في بلد الله الحرام الآمنِ",38,"ن",1,0],["ثم أقاموا من بني زياد","طفلا صغيرا غير ذى رشاد",39,"د",1,0],["ثم اقضي اليوم في كربة","وفي اعتذار من دموع غزار",40,"ر",1,0],["ثم اقصفي ما شئتِ أعداء السلا","مِ الحاقدين بقوة وتوعدي",41,"د",2,0],["ثم أقسمنا بأن نلقى المنى","وبدكّ اليأس صرنا أمثلة!",42,"ل",2,0],["ثم أقروا منصبا، منصبا،","طال به الخب وصال الجبان",43,"ن",1,0],["ثماً قلطنا بمجلس ريف الادنيني","المجلس اللي مولمةً مباهيره",44,"ر",2,0],["ثم اقترفت من الجرائم رأسها","يوم انتشقت كسائر الناس الهواء",45,"ا",2,0],["ثُمَّ أَقسَمتُ أَنْ أُعِيدَ زَمانًا","عِزَّةُ النَّفسِ نَهجُهُ وَ الكِفاحُ",46,"ح",1,0],["ثُمَّ أَقسَمتُ أَنْ أَرُدَّ شُوَاظًا","صَاعِقَاتٍ مِنَ الجُنُونِ رُدُودا",47,"د",2,0]]}