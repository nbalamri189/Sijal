{"poems":[[57,"تجافى مرفقاي عن الوساد","https://www.aldiwan.net/poem26422.html","الوافر"],[84,"وأزرق اللون كلون السما","https://www.aldiwan.net/poem29410.html","السريع"],[53,"حزني منك يا ابنة الأملاك","https://www.aldiwan.net/poem65829.html","الخفيف"],[60,"أنا للحراب اليها","https://www.aldiwan.net/poem30806.html","مجزوء الرمل"],[54,"يا رب قد أبلاني","https://www.aldiwan.net/poem26628.html","المجتث"],[94,"","https://poetry.dctabudhabi.ae/diwan/poem/66003","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54733","المتقارب"],[119,"لاحظ المسكين بالمدد","https://www.aldiwan.net/poem42010.html","المديد"],[147,"ما نرى للثناء عنك عدولا","https://www.aldiwan.net/poem11801.html","الخفيف"],[164,"العلم بالإجماع معدنه ذهب","https://www.aldiwan.net/poem58716.html","الطويل"],[173,"على م وفي م ظلماً تلحياني","https://www.aldiwan.net/poem1688.html",""],[203,"زهته الملاحة حتى سفر","https://www.aldiwan.net/poem45638.html","المتقارب"],[227,"أغرك صبري وفرط ودادي","https://www.aldiwan.net/poem55464.html","المتقارب"],[236,"سلكت طريق الفقر ظنا بأنني","https://www.aldiwan.net/poem44560.html","الطويل"],[240,"أولعت بالغدر في أيمانها","https://www.aldiwan.net/poem31728.html","الرمل"],[264,"نظم عقد الدعاء در نضيد","https://www.aldiwan.net/poem35737.html","الخفيف"],[264,"قم واستنشق نفح الفرج","https://www.aldiwan.net/poem35830.html","المتدارك"],[266,"حباك عرفا حليها والوشاح","https://www.aldiwan.net/poem38348.html","الخفيف"],[280,"هو الفتح أدنى حوزه المغرب الأقصى","https://www.aldiwan.net/poem25493.html","الطويل"],[309,"قل لأحبابنا بسوح المقام","https://www.aldiwan.net/poem16829.html","الخفيف"],[333,"هو ناي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[409,"تحفة تهدى لمن يهوى عليا","https://www.aldiwan.net/poem33355.html","الرمل"],[422,"لست أنسى الركب بنا","https://www.aldiwan.net/poem53897.html","الرمل"],[422,"ما لها تطوي فيافي الأرض سيرا","https://www.aldiwan.net/poem53994.html","الرمل"],[422,"أعد اللهو فإن اللهو أحمد","https://www.aldiwan.net/poem54100.html","الرمل"],[422,"ألا إن هذا الفؤاد اضطرم","https://www.aldiwan.net/poem54173.html","المتقارب"],[505,"منن الرفاعي الرفيع الهمة","https://www.aldiwan.net/poem37634.html","الكامل"],[564,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[591,"حديث غرامي في هواك قديم","https://www.aldiwan.net/poem17714.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38981","المتدارك"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124610","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55886","الرمل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112943","الطويل"],[1313,"","https://poetry.dctabudhabi.ae/diwan/poem/147080","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110273","السريع"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109430","الطويل"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100110","الطويل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99080","الرمل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100330","الرمل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74197","الكامل"],[3098,"","https://poetry.dctabudhabi.ae/diwan/poem/131896","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130039","الطويل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100172","الرمل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112298","الرمل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103828","المنسرح"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138501",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92012","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85031","المديد"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114135","المتقارب"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135741","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70162","الكامل"],[4048,"","https://poetry.dctabudhabi.ae/diwan/poem/110653","الكامل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136942",""],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102747","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81722","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117290","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133087","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33772","الوافر"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33249","البسيط"],[4830,"كربلا","https://www.poetsgate.com/ViewPoem.aspx?id=207295",""],[4924,"هادم اللذات","https://www.poetsgate.com/ViewPoem.aspx?id=19689",""],[5183,"الشِّْعرَى","https://www.poetsgate.com/ViewPoem.aspx?id=186427",""],[5419,"ولّوا وجودَكم شطره","https://www.poetsgate.com/ViewPoem.aspx?id=32219",""],[5795,"أبيت ومن نفسي لنفسي لائم","https://www.poetsgate.com/ViewPoem.aspx?id=167911",""]],"verses":[["وَباحَ بِسِرِّيَ المَكنونِ عيسى","فَأَصبَحَ وَهوَ مِن حَدَثِ الأَعادي",0,"د",2,0],["وباح في الليل بأسراره","لما رأى الليل نهار الأريب",1,"ب",1,0],["وبأحشائي منك وعدٌ قديم","وهوىً زرعُه على الدهر زاك",2,"ك",1,0],["وَبِأُحدٍ وَحُنَينٍ","ثُمَّ صَولاتٌ تَليها",3,"ي",3,0],["وَباحَ دَمعي بِسِرّي","وَخانَني كِتماني",4,"ن",2,0],["وبأحْضانكَ الرَّحيمةِ يستيقظُ في","نضرة الضَّحوكِ الطَّروبِ",5,"ب",1,0],["وَبَاحَ لَهُمْ مِنْ كُنُوزِ النُّهَى","بِمَا يَسْتَفِزُّ لَهَا الحُسَّدا",6,"د",2,0],["وبإحسان حقيقته","كفها بالمكرمات ندى",7,"د",2,0],["وَبِإِحكامِكَ النَوائِبَ قَسراً","وَبِأَحكامِكَ الَّتي لَن تَميلا",8,"ل",2,0],["وبأحمد المختار فيه أسوةٌ","فالحرُّ من فيه تأسّى واحتسب",9,"ب",1,0],["وَباحَةِ عِزِّ جَبّارٍ أَبَحنا","بِعَشّاتِ القَنا لا بِالعُشانِ",10,"ن",1,0],["وباحَ الصباحُ بأسرارهِ","فحجبتِ الشمسُ وجهَ القمرْ",11,"ر",1,0],["وباح لسان الأسى بغرامي","وشاعت أحاديثه في البلاد",12,"د",1,0],["وباحثت في الفقه الأئمة برهة","وأتقنت في القرآن همزا وتخفيفا",13,"ف",2,0],["وَبِأَحناءِ ضُلوعي زَفرَةٌ","ضاقَ باعُ الصَبرِ عَن كِتمانِها",14,"ن",3,0],["وبإحجام هيبة المجد تلقا","ه قريبَ المنال وهو بعيد",15,"د",1,0],["وبأحمدهم وبمن بدسو","قٍ حلّ لنجدة ذي وهج",16,"ج",1,0],["وبأحداقها ثملنا وللأحداق","سكر من دونه الأقداح",17,"ح",1,0],["وبَاحَتْ بِخَلْعِ المُسْتَبيحِ وأَفْصَحَتْ","وقَدْ فَحَصَتْ عَنْهُ فَمَا أحْمَدَتْ فَحْصَا",18,"ص",2,0],["وبأحشائه من الوجد كالنا","ر في توقد ولهيب اضطرام",19,"م",1,0],["وبأحنائك منّي","ثورةٌ لا تطمئِنُّ",20,"ن",1,0],["وبأُحْدٍ حين شبت نارها","فتية كانت أولى بها صليا",21,"ي",2,0],["وبأحباب مضى عهدي بهم","وبهم وَجْدي وفيهم ولعي",22,"ع",2,0],["وبإحسانكَ رِقّي مالكٌ","قبلَ عِرفانك لي قد كنت حرّا",23,"ر",2,0],["وبأحشائي من الوجد إلى","بارد الرّيقة نار تتوقَّد",24,"د",1,0],["وباحت دموعي بسرّي المصون","وسرّ الصبابة لا يَنْكتِمْ",25,"م",1,0],["وبأحمد الصيادِ قطب الأوليا","لذو التمس من فيض وابله الحيا",26,"ي",2,0],["وباحَ بها نجْلُ الحرالي عنْدما","رأى كتْمه ضعْفاً وتلويحُه غيْنا",27,"ن",2,0],["وَباحتْ بأسْرارِ الرُّبا نَسْمَةُ الصَّبا","وَعطَّر أَقْطارَ القفارِ شَميمُ",28,"م",1,0],["وَبِأَحمدَ طهَ المُختارِ","أَلهادي نور الأَنوارِ",29,"ر",1,0],["وباحوا بالذي هو مستحقٌ","ولم يصم اعتقادهُم الجحود",30,"د",1,0],["وباحشائي لظى الشوق وقد","وجفوني مذ جفاني ترعف",31,"ف",1,0],["وباحوا بأسرار يلذ سماعها","تحير من تروى إليه ومن نقل",32,"ل",1,0],["وباحثتَ عن \"فاظتْ\" وقبليَ قالها","رجالٌ لديهم في العلومِ حظوظُ",33,"ظ",1,0],["وباح للشيخ بنجوى الضمير","فابتهج الشيخ بذاك النصيب",34,"ب",1,0],["وباحت بأسرار المعاني فأعربت","بها عن سليم الطبع صافي المشارب",35,"ب",1,0],["وباح بمكنون الصبابة مدنف","على حمل أعباء الهوى غير قادر",36,"ر",1,0],["وبإحسان تميم","عذت من عظم مصابي",37,"ب",2,0],["وبأحشاه هواه عرَّسا","كلما ليل النوى قد عسعسا",38,"س",2,0],["وَبِأَحمَد المَولى المكرم مَن غَدا","حفظ الحَديث شِعاره وَدثاره",39,"ر",2,0],["وباحت لنا ذات الستور بوصلها","وعم الهنا والأنس كل الأفاضل",40,"ل",1,0],["وباحثة ما غاب وقعُ يراعِها","إذا ذُكِر الكتّاب يوماً وعدِّدوا",41,"د",3,0],["وبأحكام الوفا ما عدلا","وحقوقي يا لنفسي ما رعى",42,"ع",2,0],["وبأحشائي حُسَامٌ مُنتَضى","ضَاقَ عَنهُ ذلك الصّدرُ الرّحيب",43,"ب",1,0],["وباحثٍ جاهدٍ لبغيته","فإنما بحثه على عطبه",44,"ب",2,0],["وباحد من ترى عن أحمد","كافح الأبطال حيث الكل فر",45,"ر",1,0],["وَباحَت بِأَحزانٍ أَباحَت دُموعَها","وَكانَت مصوناتٍ أُبيحت فحلَّت",46,"ت",1,0],["وَبِأَحزابِ التَهَتُّكِ مِن","شُعَراءِ العَصرِ أَو زُمرِهِ",47,"ر",2,0],["وَبَاحَت دُمُوعٌ بِسِرِّ الهَوَى","وَمَا لَذَّةُ الحُبِّ إِلاَّ مُبَاح",48,"ح",1,0],["وبأحيدٍ ووحيدٍ ماحِ","فامحُ بنا باطل كل راحِ",49,"ح",1,0],["وَبِأَحسن الأَلقابِ وَالأَشباهِ قَد","اثنوا عَلَيك باقدس الاسفارِ",50,"ر",1,0],["وبأحنف حلما وسلمان تقى","وبحاتم جوداً وقس منطقا",51,"ق",2,0],["وباحث ثقة دان البيان له","فقلد السمع درا من معانيه",52,"ي",2,0],["وباح باسرار الضمائر مدمع","وما انفك دجمع العين للسر يكشف",53,"ف",1,0],["وبأحرفٍ عَجَم النوى أعوادها","حتَّى لقد ضاهَتْ حروفَ المعجم",54,"م",1,0],["وبأحمدٍ أرجو الشفاعة في غد","فله بها يوم النشور يشار",55,"ر",1,0],["وباحسنٍ والهندوان وليثهم","وصاحب عيد يد الشريف المكمل",56,"ل",1,0],["وباحَ بما يُجمجمُهُ","من الأسرارِ مُكتتمُه",57,"م",2,0],["وباحَ بالسر لما ذاب أكثرُه","شوقاً إليكَ ولما بانَ واحدُه",58,"د",2,0],["وبأُحدٍ حيثُ لولا المُرتضى","لم يكنْ للدينِ داعٍ قد دَعا",59,"ا",1,0],["وباحاول أنسي ولو يصيح الشوق بي هيهات","وباحاول أسلا ولو يصيح القلب ما أخونه",60,"ن",2,0],["وباح عن سر ما دست جرائمه","ومن لديه كما شاءت جرائمه",61,"م",2,0],["وباحةُ المسجدِ الأقصى وواحتُه","غداً تُؤدي بها للخالقِ الخمسُ",62,"س",1,0],["وباح لعينيه الوجود بسرها","ولكن تعامى وانثنى وهو كاتم",63,"م",1,0]]}