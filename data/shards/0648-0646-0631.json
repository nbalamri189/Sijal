//www.aldiwan.net/poem55825.html","الوافر"],[469,"ينادي من الساري إلي ومزعجي","https://www.aldiwan.net/poem60224.html","الطويل"],[480,"ألا بالتعاضد فلنبتد","https://www.aldiwan.net/poem37579.html","المتقارب"],[494,"ونرجس لم يعد مبيضه","https://www.aldiwan.net/poem67401.html","السريع"],[552,"ما أرادت إلا الجفاء ظلوم","https://www.aldiwan.net/poem47245.html","الخفيف"],[552,"خليلي ألا عجتما بالقلائص","https://www.aldiwan.net/poem47739.html","الطويل"],[559,"أنت الذي طول عمري الهم تكفيني","https://www.aldiwan.net/poem33806.html","البسيط"],[559,"ظلمات تقدرت تقديرا","https://www.aldiwan.net/poem34518.html","الخفيف"],[559,"غلب الهوى واستحوذ استحواذا","https://www.aldiwan.net/poem34561.html","الكامل"],[563,"يا من أغار عليه ريح أصفر","https://www.aldiwan.net/poem52543.html","الكامل"],[563,"نحن النصارى آل عيسى المنتمي","https://www.aldiwan.net/poem52748.html","الكامل"],[563,"هذه عروس الزهر نقطها الندى","https://www.aldiwan.net/poem52865.html","الكامل"],[563,"بكى حتى بكيت على بكاه","https://www.aldiwan.net/poem52917.html","الوافر"],[565,"إن نكن يا حبيب بالرغم غبنا","https://www.aldiwan.net/poem861.html",""],[568,"حب الوصي مبرة وصله","https://www.aldiwan.net/poem69546.html","أحذ الكامل"],[576,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"]],"verses":[["وَنَرسُبُ في مَصائِبِها وَنَطفو","لِغَيرِ بَني أَبينا بِالسُرورِ",0,"ر",1,0],["وَنَرقُبُ يَوماً كَأَيّامِها","وَليلَةَ نَحسٍ كَلَيلاتِها",1,"ت",3,0],["وَنَرْجُوا مَزَارَ الطَّيْفِ فِي سِنَةِ الْكَرَى","وَمَنْ لِي بِنَوْمٍ فِيهِ يَسْري خَيَالُهُ",2,"ل",2,0],["وَنُرسِلُ النُكتَةَ مَحبوكَةً","عَن غَيرِنا في الحُسنِ لا تَصدُرُ",3,"ر",1,0],["وَنَرومُ تَعليماً يَكو","نُ لَهُ مِنَ الفَوضى وِقايَه",4,"ا",3,0],["وَنَرفَعُهُ إِلى أَعلى مَكانٍ","كَما رَفَعوهُ أَو نَلقى المَنونا",5,"ن",2,0],["وَنَراها تُفاخِرُ الناسَ بِالأَح","ياءِ فَخراً في الخافِقينَ مُذاعا",6,"ع",2,0],["وَنَرى عَلَيكَ مَخايِلَ ال","خُلَفاءِ إِنصافاً وَرُشدا",7,"د",2,0],["وَنَروى متى نَروي بَدائِعَ لَفظِهِ","وَنَظما إِذا لَم نَروِ يَوماً لَهُ نظما",8,"م",2,0],["وَنَرَاهُ كَالعَهْدِ القَدِيمِ مُصَعِّداً","وَنَرَى لَدَيْهِ تَطَامُنَ البُلْدَانِ",9,"ن",1,0],["وَنَرَى أَنْفُسَ الأَزَاهِرِ غُرّاً","إِذْ نَرَاهَا الأَلْوَانِ",10,"ن",1,0],["وَنَرَى فِي الشَّبَابِ فَضْلاً بِهِ نَمْ","زُجُ بيْنَ التَّحْلِيلِ وَالتَّحْرِيمِ",11,"م",1,0],["وَنَرَى مِنَ التَّصْرِيفِ مَا رَدَّ الوَرى","تُرْباً وَمَا جَمَعَ الهَبَاءَ نُجُومَا",12,"م",2,0],["وَنَرفَعُ مِن صُدورِ شَمَردَلاتٍ","يَصُكُّ وُجوهَها وَهَجٌ أَليمُ",13,"م",1,0],["ونرجس لحظ أرسل الدمع لؤلؤاً","فرشَّ بماءِ الورد روضاً من الوردِ",14,"د",1,0],["ونركب من عزمنا مركباً","ونرقى وإن صَعُب المُرتقى",15,"ق",2,0],["ونُرجف في البلاد بكل رُعبٍ","يهُزّ فرائص الأمن ارتجافا",16,"ف",2,0],["ونرجو ومن سيف الردى في رجائنا","جِراحات يأس ما لهنّ أروش",17,"ش",1,0],["وَنَرهَبُ أَن نَزورَكُمُ عُيوناً","مُصانَعَةً لِأَهلِكِ وَاِرتِقابا",18,"ب",2,0],["وَنَرى كَلامَكِ لَو يُنالُ بِغِرَّةٍ","وَدُنوَّ دارِكِ لَو عَلِمتِ خُلودا",19,"د",2,0],["وَنَرمي بِأَمرٍ لانُطيقُ اِحتِمالَهُ","إِلى قَرمِنا وَالقَرمُ بِالأَمرِ أَقوَمُ",20,"م",1,0],["ونرى مجدك الحليّ وجدوَا","ك فتملا العيون شحماً ولحما",21,"م",2,0],["ونرى مكارِهَنا مخلَّدةً","والعمرُ يذهب فانياً عَدَدُهْ",22,"د",2,0],["ونرجسٍ كالثغور مبتسمٍ","له دموعُ المحدِّقِ الشاكي",23,"ي",1,1],["ونرجسٌ باتَ ساري الطلِّ يضربُهُ","وأقحوان منيرُ النورِ ريَّان",24,"ن",1,0],["وَنَرجِسٍ كَالرَقيبِ يَرنو","وَلَيسَ ما يَقتَضي رَقيبا",25,"ب",2,0],["وَِن روحِهِ لا فَيضِ أَموالِهِ","إِنَّ هِباتِ الروحِ أَسمى الهِبات",26,"ت",1,0],["وَنَرشُفُها فَنَرشُفُ ريقَ خَودٍ","وَنَنشُقُها فَنَنشُقُ ريحَ عِطرِ",27,"ر",1,0],["وَنَراهُ عِندَ مُصابِهِ","أَولى بِباكٍ أَو عَذير",28,"ر",1,0],["وَنَرتَبِطُ السَوابِقَ مُقرَباتٍ","وَما يُنجينَ مِن خَبَبِ اللَيالي",29,"ل",2,0],["وَنَرمي نَواصيها مِنِ اِسمِكَ في الوَغى","بِأَنفَذَ مِن نُشّابِنا وَمِنَ النَبلِ",30,"ل",1,0],["ونرقى بك اليوم فوق الجميع","ومالي عمانراه عدولُ",31,"ل",1,0],["وَنَرتَجي مِن سَيبِ آلائِهِ","ما تَرتَجيهِ مِصرُ مِن نَيلِها",32,"ل",3,0],["ونرجس كأنه","شهل العيون رانيه",33,"ي",2,0],["ونريد شباناً بمصر استعصموا","ومضوا يصدون الغريب العادي",34,"د",2,0],["ونريد أطفالاً إذا ما أُرضعوا","فرضاعهم وطنية بسهادِ",34,"د",1,0],["ونَرقبُ سِرْباً في الخدورِ عُقولنا","مبدّدةٌ للبين بين عقائِلِه",35,"ل",2,0],["ونَرى يَمينَكَ والمُنى في لَثمِها","في كلّ أُفْقٍ بالجنودِ تُنادي",36,"د",2,0],["وَنَرُدُّ عَادِيَةَ الْخَمِيسِ بِأَنْفُسٍ","عَلِمَتْ بِأَنَّ مِنَ الْحَيَاةِ هَوَانَا",37,"ن",2,0],["ونرجسُنا ناظرٌ ناضرٌ","ولا يرجعُ الطرفُ عنْ هائلِ",38,"ل",1,0],["وَنَرى أَنَّنا عَرَفناكَ بِالنَع","تِ بِظَنٍّ وَما قُتِلنا يَقينا",39,"ن",2,0],["ونَراهُ يَستبِقُ المطالعَ صاعداً","حتّى يَمُرَّ من السّماكِ بمطلعِ",40,"ع",1,0],["ونرى الغُواةَ المُبطلين وإن همو","زَادوا على عدِد الرّمالِ قليلا",41,"ل",2,0],["وَنَرمي بِهِ حادِثاتِ الزَمانِ","إِذا ما رَمَتنا بِأَمرٍ نُكُرْ",42,"ر",1,0],["ونردّد الأَلحانَ بينَ شجيَّةٍ","تُمري مدامعَنا وبيْن عِذابِ",43,"ب",1,0],["وَنَردَّ عَنكَ النازِلات","مسابقين إِلى الحمام",44,"م",1,0],["وَنَرى صَنعَةً تُخَبِّرُ عَن خا","لِقِنا أَنَّهُ لَطيفٌ حَكيمُ",45,"م",1,0],["وَنَرجِسٍ قَد حُفَّ بِالوَردِ","في خَدِّ مَن قَد لَجَّ في البُعدِ",46,"د",1,1],["وَنَركَبُ في الفَريدِ إِلى النَدامى","وَفي الديباجِ لِلحَربِ الحِبارِ",47,"ر",1,0],["وَنَرى مُباشَرَةَ التُرابِ مَهانَةً","وَإِلَيهِ تَرجِعُ هَذِهِ الأَبشارُ",48,"ر",1,0],["وَنَرومُ دُنيانا وَما كَلِفٌ بِها","إِلّا الفَنيقُ وَيَظَلُّ وَهوَ مُسَدَّمُ",49,"م",1,0],["ونرسل العين نرعاه هنا وهنا","وما يبين لنا من أين مطلع",50,"ع",1,0],["ونرْعى مواثيقَ الوفاءِ كما رَعَتْ","أوائِلُنا لسنا على البذلِ نندَمُ",51,"م",1,0],["وَنَرَى بِهِ الكِبْرَ الصَّحيحَ يَرُوعُنَا","بالمَحْمَدَات وَلاَ نَرَى اسْتِكْبَارَا",52,"ر",2,0],["ونرفَعِ الأدبَ السمح","والبيان الُّلبابا",53,"ب",2,0],["ونَرْجع للْحُسْنَى كَمَا كَانَ عَهْدُنا","فَلاَ نَشْتَكِي هَمّاً ولا نَتَوجَّع",54,"ع",1,0],["ونركن للدنيا اغترارا بلهوها","وحسبك من يرجو الوفاء من الغدر",55,"ر",1,0],["ونرجو مزار الطيف في سنة الكرى","ومن لي بنوم فيه يسري خياله",56,"ل",2,0],["ونرمي الضحايا ونسقي الحقول","دما يبعث الموسم الأرغدا",57,"د",2,0],["ونرى سرّية الآتي كما","تقرأ البرق نبوءات البوادي",58,"د",2,0],["ونرى أصل \" عامر \" تربة الأر","ض و\" سعدا \" نرى النجوم أصوله",59,"ل",2,0],["ونريد أن نسقي الفنون رفيعةً","تجدي وليست طلسماً متحجرا",60,"ر",2,0],["ونَرىَ الصيانَةَ للدمُوع رجُولةً","حتى يُرَ ى سببٌ إلى التضييع",61,"ع",1,0],["ونرى شتاتَ جهودِنا وصفوفنا","ليست على شيءٍ من التنظيم",62,"م",1,0],["ونراك جباراً يكونُ لفكره","في المعضلات مردُّ كلِّ جسيم",62,"م",1,0],["ونرجو ومن سيف الردى في رجائنا","جراحات بأس مالهن أروش",63,"ش",1,0],["ونرجع أمّة ترجى وتخشى","وإن كره الزعانف والطّغا",64,"غ",2,0],["وَ نرى سباعَ الطيرِ تنقرُ أعيناً","وَتَجُرُّ أَعْضَاءً لَهُمْ وَضُلُوَعا",65,"ع",2,0],["وَنَرى الفَضل فيكَ وَالمَجد إِرثاً","وَعَلَيك الوَقار وَقفاً وَحَبسا",66,"س",2,0],["ونرجسي عين","ثغيره عطري",67,"ي",1,0],["ونرى الحماقة اطلقت اصحابها","والعقل ها هو للفحول عقال",68,"ل",1,0],["ونرى فئاما يزعمون أصالة","يحكي البكور العكس والاصال",68,"ل",1,0],["ونرجس فوقها يسطو بلحظته","على فؤاد طويل البث قرحان",69,"ن",1,0],["ونرسله في الجو صرخة آيسٍ","يجاوبها قصف الرعود الغواشم",70,"م",1,0],["ونرجس كاسف والعين ضاحكةٌ","يا حبذا نرجس لهفان جذلان",71,"ن",1,0],["ونروض أنفسنا بما","يعلى الفضائلُ والسلامْ",72,"م",1,0],["ونرى من الصنعِ البديع","حرية تُرضي العمومْ",72,"م",1,0],["ونرقى وبين الصخرتين مناظر","تمثل ما بين الغدير إلى البحر",73,"ر",1,0],["وَنَرْجِسٌ لِلْنَّسِيمِ مُعْتَنِقُ","يَسْهَرُ طَبْعاً وَما بِهِ أَرَقُ",74,"ق",1,1],["ونرجسٌ مفتّحٌ جفونُه","محدّقٌ عيونه كالمنتظر",75,"ر",1,0],["وَنَرومُ العَزاءَ عَنكَ فتَبدو","أَلف ذِكرى تَأتي بِأَلفِ ذِمامِ",76,"م",1,0],["وَنَرفَعُ لِلحَضارةِ كُلَّ صَرحٍ","تَمرُّ بِهِ السَّحائبُ إِذ تَسيرُ",77,"ر",1,0],["وَنَرشُفُ لِلأَفواهِ جاماً مُمسَّكاً","وَنَلثمُ لِلجاماتِ ثَغراً منضَّدا",78,"د",2,0],["ونرى النبت على الغبراء لم","ينم إلا حسبما يبلي البذور",79,"ر",1,0],["ونرى الناس تساوى خلقها","فوق هذي الأرض ةغدا وغيور",79,"ر",1,0],["ونرى الأقمار يكسو ضوؤها","قذر النفس كما يكسو الطهور",79,"ر",1,0],["ونرجو لها حسن القبول لعلها","تعود لمثواها معظمة القدر",80,"ر",1,0],["وَنَرَشُّ الأَرضَ تَلاحينا","حَلوى المعلَّل",81,"ل",1,0],["ونرجسه أعينٌ لُحْظُها","سواكِن والأُقحوانُ 