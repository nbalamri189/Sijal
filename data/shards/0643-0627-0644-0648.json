{"poems":[[95,"ويح الفقيرات الجميلات من","https://www.aldiwan.net/poem11136.html","السريع"],[32,"ما هاج عينيك من الأطلال","https://www.aldiwan.net/poem29544.html","الرجز"],[53,"شغل المحب عن الرسوم","https://www.aldiwan.net/poem66332.html","مجزوء الكامل"],[93,"زعم المرء إنما هو رب","https://www.aldiwan.net/poem62799.html","عموديه"],[47,"ريح الشمال أتت بريح شمال","https://www.aldiwan.net/poem65636.html","الكامل"],[63,"جاءت مولعة الكواهل","https://www.aldiwan.net/poem51489.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42543","الكامل"],[93,"الإله الثرثار","https://www.poetsgate.com/ViewPoem.aspx?id=53349",""],[124,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[203,"خداك يا ذات العيون","https://www.aldiwan.net/poem45625.html","مجزوء الكامل"],[285,"لئن عداني زمان عن لقائكم","https://www.aldiwan.net/poem60782.html","البسيط"],[307,"يا صاحب القبة الخضراء","https://www.aldiwan.net/poem65690.html","البسيط"],[333,"هات الدموع فأنت شاعر","https://www.aldiwan.net/poem55048.html","مجزوء الكامل"],[409,"أحسن ما يبدي به الكلام","https://www.aldiwan.net/poem33344.html","الرجز"],[411,"عدل قطوبك بالبشاشة يعتدل","https://www.aldiwan.net/poem49490.html","الكامل"],[454,"الحكم للعمل","https://www.aldiwan.net/poem1013.html",""],[463,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[480,"هل تعرف المنزل بالأهيل","https://www.aldiwan.net/poem1825.html","السريع"],[568,"يتفيهق الغمر المغمر مسهبا","https://www.aldiwan.net/poem13615.html","الكامل"],[580,"لام العذول على هواك وفندا","https://www.aldiwan.net/poem2960.html","الكامل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110497","البسيط"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39029","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119990","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59295","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59196","الكامل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101994","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56241","الرجز"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111891","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108995","البسيط"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131335","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2938,"","https://poetry.dctabudhabi.ae/diwan/poem/204557","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200396","الكامل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103901","البسيط"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103617","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66455","الكامل"],[3645,"","https://poetry.dctabudhabi.ae/diwan/poem/99284","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85152","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135570","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116048","الكامل"],[4888,"في ظل وطن","https://www.poetsgate.com/ViewPoem.aspx?id=207742",""],[5005,"خلف المساء","https://www.poetsgate.com/ViewPoem.aspx?id=198696",""],[4119,"أشبا سيوف الهند أم عيناك","https://www.poetsgate.com/ViewPoem.aspx?id=16201",""],[585,"يا ليل هل فرجٌ لي حان أو فلق","https://www.poetsgate.com/ViewPoem.aspx?id=161885",""],[5121,"الْمُسْتَلْقِيَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=213628",""],[5127,"حديثُ النفس","https://www.poetsgate.com/ViewPoem.aspx?id=177309",""],[5145,"البين فرق بين جفني والكرى","https://www.poetsgate.com/ViewPoem.aspx?id=108235",""],[5168,"حجتلي شكد عليك","https://www.poetsgate.com/ViewPoem.aspx?id=33617",""],[5168,"يالعندك جمال من الجمال اكثر","https://www.poetsgate.com/ViewPoem.aspx?id=92218",""],[5186,"الروح والريحانة الفيحاء","https://www.poetsgate.com/ViewPoem.aspx?id=156506",""],[5187,"صامدٌ أيها الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=37392",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5376,"مال الغبيط من الأهواء في المهج","https://www.poetsgate.com/ViewPoem.aspx?id=188318",""],[5605,"ملحمة المسيلة","https://www.poetsgate.com/ViewPoem.aspx?id=160024",""],[5720,"عاصِفةُ الحَزْم","https://www.poetsgate.com/ViewPoem.aspx?id=199941",""],[5725,"قالوا","https://www.poetsgate.com/ViewPoem.aspx?id=194072",""],[5809,"مكيال","https://www.poetsgate.com/ViewPoem.aspx?id=205567",""],[5873,"الجمال الأخاذ","https://www.poetsgate.com/ViewPoem.aspx?id=215304",""],[5912,"رباعيات 1","https://www.poetsgate.com/ViewPoem.aspx?id=205011",""],[6093,"خَالِد","https://www.poetsgate.com/ViewPoem.aspx?id=198602",""],[6093,"إن الغياب عن الغياب حضور","https://www.poetsgate.com/ViewPoem.aspx?id=200516",""],[6093,"هذي القصائد بعض ما في الأفئدة","https://www.poetsgate.com/ViewPoem.aspx?id=207201",""],[6125,"أَهوَى اللِّقَاءَ وأشتَهِي القُرْبَا","https://www.poetsgate.com/ViewPoem.aspx?id=210722",""],[454,"الحكم للعمل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82643&r=&rc=7",""]],"verses":[["كَالوَرْدِ لا يَعْصِمُهُ شَوْكُهُ","إِذَا دَنَتْ مِنْهُ يَدٌ جَائِرَهْ",0,"ر",2,0],["كَالوَحيِ في سَواعِدِ الحَوالي","بَينَ النَقا وَالأَجرَعِ المِحلالِ",1,"ل",1,0],["كالوالد البرِّ الرؤو","فِ بنا وكالأُمِّ الرؤوم",2,"م",1,0],["كَالوَردِ الَّتي تُحِبُّ شَذاها","وَالبَعوضُ الَّذي تَخافُ أَذاهُ",3,"ا",2,0],["كَالوالِهِ المَجنونِ إِلّا أَنَّ في","شَحمِ الجُنوبِ فَضيلَةً لِهُزالِ",4,"ل",1,0],["كالوَرِد زالَ وماؤُه","عَبِقُ الرَّوائحِ غيرُ زَائِل",5,"ل",1,0],["كَالْوَرْدِ خَدَّاً والْبَنَفْسَجِ طُرَّةً","والْغُصْنِ قَدَّاً والْغَزَالَةِ مَلْفَتَا",6,"ت",2,0],["كالورود التي تحبّ شذاها","والبعوض الذي تخاف أذاه",7,"ا",2,0],["كالورد أما ذوت يوماً غلائله","ذكى فصار به عنهن غنيان",8,"ن",1,0],["كالوردِ إلا أنهُ","يحميهِ لحظُ النرجسِ",9,"س",1,0],["كَالوَرْدِ نَشْراً وَلكِنْ مِنْ سَجِيَّتِهِ","أَنْ لَيْسَ يَبْرَحُ غَضّاً كُلَّما قُطِفا",10,"ف",2,0],["كالوالدين حنونٌ كلّه كرمٌ","للمؤمنين وحصنٌ ما له بددُ",11,"د",1,0],["كالواحة السجواء في","أَحشائها سر الهجير",12,"ر",1,0],["كالوزن والمعنى إذا ما ائتلفا","واللفظ مع لفظ يرى مؤتلفا",13,"ف",2,0],["كالوَردِ فيهِ عُفوصَةٌ ومرارَةٌ","وهو الذَّكِيُّ النّاضِرُ المُتَيسِّمُ",14,"م",1,0],["كالورد يغفو على كف الندى فإذ","كف النسائم مسته انتشى جذلا",15,"ل",2,0],["كالوحي لو أني خُلقتُ مَلَكاً","طرتُ به لكن خُلِقتُ بَشَرا",16,"ر",2,0],["كَالوَقفِ لا وَقرٌ بِها هَزمُها","بِالشِرعِ كَالخَشرَمِ ذي الأَزمَلِ",17,"ل",1,0],["كَالوَعدِ يَقوى المُخلِفونَ بِحَملِهِ","وَيَهابُ عُهدَةَ عَقدِهِ مَن يُنجِزُ",18,"ز",1,0],["كالْوَرْدِ خدّاً والهِلالِ تَباعُداً","والظَّبْي جِيداً والقَضِيبِ تأَوُّداً",19,"د",2,0],["كالورد نضدَّهُ في روضهِ سحراً","درُّ الندى أو كراح كُلِّلت حَبَبا",20,"ب",2,0],["كالوَرْدِ وَجْنَتُهُ والشَّهْدِ رِيقَتُهُ","والسِّلْكِ مَبْسِمُهُ والمِسْكِ ريَّاهُ",21,"ا",2,0],["كالورد خدا والوردُ غضّ","والغصن قداً والغصنُ ناعم",22,"م",1,0],["كَالْوَرْدِ خَداً وَالغَزَالِ لَوَاحِظًا","وَالْغُصْنِ قَداً وَالْهِلاَلِ جَبِينَا",23,"ن",2,0],["كَالْوَرْدِ خَدّاً وَالغَزَالَةِ بَهْجَةً","وَالغُصْنِ قَدّاً وَالغَزَالِ تَشَرُّداَ",24,"د",2,0],["كالورق يهطل فيض أنملهم","فالخصب يوجد حيثما نزلوا",25,"ل",3,0],["كالوادي المستحكمِ المستنسبِ","في العمق والوسع الشهي للمضربِ",26,"ب",1,0],["كالوردِ بين شقائقِ النعمان تحت","سرادقِ النعمان تحت لواءِ",27,"ا",2,0],["كالورد يعطى من الجنَّان نهلتَه","فيشربُ الشوكُ منها حين يعطاها",28,"ا",3,0],["كالوزّ والأَغْنامِ والفراخِ","أَنواعُها من صَنْعَةِ الطَّبَّاخِ",29,"خ",1,0],["كَالوَجهِ وَاليَدِ والأصَابِعِ وَالَّذِي","أبداً يَسُوؤكُمُ بِلاَ كِتمَانِ",30,"ن",1,0],["كَالوَصفِ بِالمعنَى سِوَى الأفعالِ مَا","إن بَينَ ذَينِكَ قَطُّ مِن فُرقَانِ",30,"ن",1,0],["كالورد وجنته والبدر طلعته","والغصن قامته والمسك رياه",31,"ه",1,0],["كالورد إذ يخفى يفوح عبيره","والشوك يؤلم مثبتاً لوجوده",32,"ه",1,0],["كالوفر تحويه بعد فقر","والفقر يأتيك بعد وفر",33,"ر",1,0],["كالوشم في أذرع كالوحي في صحف","كالخيل في حلل أفضت لاجلال",34,"ل",1,0],["كالورد غِبَّ ظماه باكره الندى","جفّت أسافله وأعلاه ندي",35,"د",2,0],["كالوا نجوم من اقتدى فعليهم","يبكي الهدى وشعائر الإيمان",36,"ن",1,0],["كالواو صدغ على خديث منعطف","لكنه بوصال قط ما عطفا",37,"ف",2,0],["كالورد والمؤنث الذي خفى","لون له وظهر الريح صفا",38,"ف",2,0],["كَالوَقتِ وَالوُجُودِ مَع سِوَاهُ","لأَنهُ لِذَاتِهِ سَاوَاهُ",39,"ه",1,0],["كالوَردِ أوّلُهُ بزَهرٍ مُونقٍ","يأتي وآخِرُه بماءٍ مُمتَعِ",40,"ع",1,0],["كالوَردِ يَعصِرُ للمُحِبِّ رحيقَهُ","والشَّوكِ يشحَذُ للعَدُوِّ نُصُولا",41,"ل",2,0],["كالوعد في قلب الغريب وقد درى","أن الليالي قادمات بالرزأ",42,"ا",1,0],["كالوشي إلا أنها قد نزهت","في نسجها عن شيمة الحواك",43,"ك",1,0],["كالورد يملأ منك الطرف من كثبٍ","حسناً وينفح منه النشر ينتشق",44,"ق",1,0],["كَالْوَرْدِ أَلْقَتْ غُصْنَهَا الْمُسْتَلْقِيَةْ","حَتَّى أَثَارَتْ فِي الْحَرِيرِ الْأَنْدِيَة",45,"ي",2,1],["كالوشمِ إلا أنَّها مِن جذوةٍ","تطفو وترسب في الفؤادِ الذاكي",46,"ك",2,0],["كالورد أحمر ثم إن قطرته","خلطع الرداء وعاد أبيض أزهرا",47,"ر",2,0],["كالو مو حلو وبطبعه بذات","واتحذر اذا خاملك يغدر",48,"ر",1,0],["كالولي شكثر قبلك عرف ناس","بس فنك تكله بطبعه ينكر",48,"ر",1,0],["كالولك عراقي شو دلالك زاد","تره مو كل عراقي عالصبر يكدر",49,"ر",1,0],["كالوردة الحمراء، بدء جهودها،","فإذا بها نسرينة صفراء",50,"ا",2,0],["كالوَمْضِ يَجمعُنا المَصيرُ بِصَيحَةٍ","ومَشاعرٌ تُغني عَن التّبيانِ",51,"ن",1,0],["كالوردة الحمراء فاح عبيرها","وتمايلت في منظر فتان",52,"ن",1,0],["كالوردِ ناديةٌ والقطرُ يعشقُها","وفي خمائلِها طيبٌ من الأرجِ",53,"ج",1,0],["كالورد يسحر من ألوان بهجته","من هام بالورد في عشق لماضيها",54,"ي",3,0],["كالوا على الحوثيِّ جُمَّ سعيرِهم","فتحوَّلتْ تلك الوجوُهُ .. رَمادا",55,"د",2,0],["كالو ابغداد هزة ومادريت","بالي مشدوه ابجميل اوصافة",56,"ف",2,1],["كالوا لنا مابهِ الآلامُ والحَزَنُ","ياليتهم طفَّفوا المكيالَ اذ وزنوا",57,"ن",3,1],["كالورد حين الصبح بلّلَ-ه الندى","تذكي الرياحُ أريجه النفّاذا",58,"ذ",2,0],["كالوردِ يَشهَقُ في الكُثبانِ مُبتسمًا","عِطرًا يفوحُ وطِيبُ النّشرِ مَجناهُ",59,"ا",2,0],["كالوَردِ مَرَّ بِهِ النَّسيمُ مُسَلِّمَا","فتعطرَتْ بعَبيرهِ دُورُ الحِمَى",60,"م",2,0],["كالوردِ مهما طالَ أمر غيابِهِ","ستنوبُ عن شخصِ الورودِ عُطُورُ",61,"ر",1,0],["كالورد يحسبه الجهول مبسطا","لكن أجزاء الورود معقدة",62,"د",2,0],["كَالوَردِ كَالمَاءِ الزُّلالِ جَرَى","فَوَق الأرَائِكِ نِعمَ مَا صُبَّا",63,"ب",2,0],["كالورد يغفو على كف الندى فإذا","كف النسائم مسته انتشى جذلا",64,"ل",2,0]]}