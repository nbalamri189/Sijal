{"poems":[[87,"بالله يا نسمات النيل في السحر","https://www.aldiwan.net/poem63666.html","البسيط"],[366,"أيد الله دولة أنت فيها","https://www.aldiwan.net/poem68092.html","الخفيف"],[438,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[463,"دع بين جِلدي والعظام مكانا","https://www.aldiwan.net/poem55851.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86688","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70948","المديد"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93943","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62762","الكامل"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20623","الكامل"]],"verses":[["دَع بَعدَ ريقَةِ مَن تَهوى وَمَنطِقِهِ","ما قيلَ في الكَأسِ أَو ما قيلَ في الوَتَرِ",0,"ر",1,0],["دَع بَديع اِبن حجة وَابن هاني","وَالصَفى الحلى وَتِلكَ الجُموع",1,"ع",1,0],["دِعبِلةٌ هوجاءُ ذات ميسمٍ","تعوّذت به إذاً وسْمُ الفَلا",2,"ا",1,0],["دعْ بين جِلدي والعظام مكانا","يسعُ الغرام ويحملُ الأحزانا",3,"ن",2,1],["دع با الجديد","ومزق با وجه",4,"ه",1,1],["دعْ بني دنياكَ لا شفَعُوا","لامرئٍ يوماً ولا نفعوا",5,"ع",3,1],["دع باب أنسك دون واش مرتجا","إن كان صفو مدير كاسك مرتجا",6,"ج",2,1],["دَعْ بينَ أثوابي وبينَ وِسادي","شَبَحاً يَصُدُّ فوارسي وجِيادي",7,"د",2,1],["دَع بَعضَ أَكلِكَ رُبَّ آكِلٍ أَكلَةٍ","يَوماً سَيَلفِظُها إِذا هُوَ لاكَها",8,"ه",2,1]]}