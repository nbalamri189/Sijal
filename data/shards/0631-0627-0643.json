"https://poetry.dctabudhabi.ae/diwan/poem/40112","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125800","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90831","الرمل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28776","الخفيف"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22810","الوافر"],[4657,"","https://poetry.dctabudhabi.ae/diwan/poem/140150",""],[4750,"الرفيق","https://www.poetsgate.com/ViewPoem.aspx?id=180412",""],[4750,"ون ابن جدلان","https://www.poetsgate.com/ViewPoem.aspx?id=180423",""],[3464,"هنيئاً يا معالي في مطالك","https://www.poetsgate.com/ViewPoem.aspx?id=158762",""],[669,"راكبا نحو المدينة جرة","https://www.poetsgate.com/ViewPoem.aspx?id=18393",""],[4942,"الشهيد مصطفى العذاري","https://www.poetsgate.com/ViewPoem.aspx?id=188938",""],[5212,"شموخُ العلم","https://www.poetsgate.com/ViewPoem.aspx?id=212107",""],[4045,"هنيئا أمير المؤمنين لك الظّفر","https://www.poetsgate.com/ViewPoem.aspx?id=200278",""],[5351,"الشعب العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=202103",""],[5397,"توارى محيا الشمس منك بحاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157938",""],[5439,"قد عزمنا على الصبوح فبادر","https://www.poetsgate.com/ViewPoem.aspx?id=181698",""],[5536,"أنا وعشتار!!","https://www.poetsgate.com/ViewPoem.aspx?id=37059",""],[5582,"نَبا عضبُ السلوّ نبا","https://www.poetsgate.com/ViewPoem.aspx?id=63457",""],[5596,"السحمية","https://www.poetsgate.com/ViewPoem.aspx?id=206361",""],[5616,"جمعة حسين","https://www.poetsgate.com/ViewPoem.aspx?id=203500",""],[5690,"قم ودع الغرب أن الشرق ناداكا","https://www.poetsgate.com/ViewPoem.aspx?id=172169",""],[5751,"هوانا الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=215016",""],[5957,"وأنا جئتُ إليكم","https://www.poetsgate.com/ViewPoem.aspx?id=180652",""],[5988,"صحيحٌ ودَّ لو أمسى عليلا","https://www.poetsgate.com/ViewPoem.aspx?id=99718",""],[6069,"بعزمك أيها الملك العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=105705",""],[6093,"إليْكَ يا بَحْرُ طِفْلُ الشَّامِ قَدْ هَرَبَا","https://www.poetsgate.com/ViewPoem.aspx?id=177749",""],[549,"الفارس والصهيل المكسر","https://www.poetsgate.com/ViewPoem.aspx?id=203001",""],[6124,"أمسيات","https://www.poetsgate.com/ViewPoem.aspx?id=105842",""],[6144,"النشال","https://www.poetsgate.com/ViewPoem.aspx?id=21684",""],[6229,"شواظ جحيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65205&r=&rc=29",""],[6237,"سوزان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77873&r=&rc=15",""]],"verses":[["راكِباً ظَهراً مِنَ الغِي","يِ مُسيمٌ وَمُسامُ",0,"م",1,0],["رَآكَ أَشرَفَ مَمدوحٍ لِمُمتَدِحٍ","وَخَيرُ مَن شَرَعَت فيهِ يَدُ الأَمَلِ",1,"ل",1,0],["رَآكَ لِكُلِّ ما يَأتيهِ أَهلاً","وَأَنتَ أَحَقُّ ذَوداً بِالمِراعِ",2,"ع",1,0],["راكِباً صَهوَةَ الخِطارِ عَقيداً","لِبَناتِ الفَلا يَجُبنَ الأَرضا",3,"ض",2,0],["راكِباً رَأسَهُ طَريداً شَريداً","لا يُبالي بِشِرعَةٍ أَو ذِمامِ",4,"م",1,0],["راكعاً ساجداً لهُ","ليس يألُو تَقُرُّبا",5,"ب",2,0],["رآكم الله والسلطان حزبهما","فاستعمر الملك منكم خير عمار",6,"ر",1,0],["رآك وقوماً أشبهوكَ نفايةً","إماطتُها عند الأماثل أمثلُ",7,"ل",1,0],["رآك تحب السجع حتى تظنه","هو الحسن لا ما جاء من جودة الطبع",8,"ع",1,1],["راكِبَ البَحرِ أَمَوجٌ ما تَرى","أَم كِتابُ الدَهرِ أَم صُحفُ القَدَر",9,"ر",1,0],["راكِبٌ ما شاءَ مِن أَطرافِهِ","لا يُرى مِن مَركَبٍ ذي عُدَواء",10,"ا",2,0],["رَآكَ إِن وَقَفوا في الأَمرِ تَسبِقُهُم","هَدياً وَإِن خَمَدوا في الرَأيِ تَلتَهِبُ",11,"ب",1,0],["رَآكَ اللَهُ أَولى الناسِ طُرّاً","بِأَعوادِ الخِلافَةِ وَالسَلامِ",12,"م",1,0],["راكِبُ الريحِ قاهِرُ الجِنِّ وَالإِن","سِ بِسُلطانِهِ مُذِلُّ الأَعادي",13,"د",2,0],["راكِبُ الأَيّامِ يَجري عَلَيها","وَلَهُ مِنهُنَّ يَومٌ حَرونُ",14,"ن",1,1],["رآك بالقلب لا بالعين من جَزَعٍ","في دَسْتِ مُلْكِ عليه هَيْبةُ العِظَمِ",15,"م",1,0],["رآك وأنتَ مبتسمٌ كضارٍ","تثاءَبَ عن نواجذه شتيمِ",16,"م",1,0],["راكِبٌ لِلأُمورِ في حَلبَةِ الأَي","يامِ لِلمُنجِياتِ أَو لِلحُتوفِ",17,"ف",1,0],["رَآكَ سَديدَ الرَأيِ وَالرُمحِ في الوَغى","تَأَزَّرُ بِالإِقدامِ فيهِ وَتَرتَدي",18,"د",2,0],["رَآكَ فَقرَّتْ عَينُهُ وترافدَتْ","تَحيّاتُهُ تَلقَاكَ زُهْراً نَواضِرا",19,"ر",2,0],["رَاكعاً ساجِداً يُسبِّحُ مَولا","هُ ويُزجِي التَّهليلَ والتّكبيرا",20,"ر",2,0],["رَآكَ شَوكَ قَتادٍ لَيسَ يَمكِنُهُ","وَلَو رَآكَ غَضيضَ النَبتِ لَاِبتَقَلَك",21,"ك",1,0],["رَآكَ بِبَثَّ فَلَم يَلتَفِت","إِلَيكَ وَقالَ كَذاكَ اِدأَبِ",22,"ب",1,0],["رَآكنَّ فيهِ وحيَّا بهِ","فلم أدْرِ حاجتَه للنظرْ",23,"ر",1,0],["راكِباً يَطْلُبُ المَنونَ ذُرَى عِشْ","رِينَ لم يَدْرِ كيْفَ مَعنى الرّكوب",24,"ب",1,0],["رَاكِباً مَتْنَ النَّوَى لمَّا نوَى","ضَارِباً بَيْنَ غَدٍ وَالامْسِ سِتْرَا",25,"ر",2,0],["راكبي الجوِّ، قد ركبتم ذلولا","لا وهادًا خشيتمو، أو هضابا",26,"ب",2,0],["راكعٌ، قائمٌ، على الأرض جاث","فوقها في تَبَتُّل وإِنَابة",27,"ب",2,0],["راكب اللي كنه السيل النحاوي","لاصختبه. من خيار المزن.؟.؟.؟. ديمه",28,"م",2,1],["راكَلْتُهُ ، والعِدا ترمي مَقاتِلَهُ","خِرْقَ النَّشاشيبِ في ذي شُمْرُجٍ عاري",29,"ر",2,0],["راكَ للعشاقِ قبراً فهلْ","فيكَ من العشاقِ إلا عظامْ",30,"م",1,0],["رَآكَ الأَعاضي حينَ قُلِّتَ حَربَهُم","أَخا عَزَماتٍ فَاِستَكانوا إِلى الصُلحِ",31,"ح",1,0],["رَآكَ بِعَيْنِ اللُّبِّ أَبْعَدَ فِي الْعُلى","وَأَسْعَدَ مِنْ زُهْرِ النُّجُومِ الْبَواهِرِ",32,"ر",1,0],["رَآكَ العادِلُ المَلِكُ المُفَدّى","وَلِيّاً لَم يَكُن مُذ كانَ داجا",33,"ج",2,0],["راكبُ الجدّ حازمٌ لا ترى","منهُ المَطايا مجرورة الأرسانِ",34,"ن",1,0],["راكنات بالاعتيادِ إِلَيها","في اِجتلابٍ لِنَفعها واِجتنابِ",35,"ب",1,0],["رآك خليلُك نور الشموس","وظنوك في الهند نار المجوس",36,"س",1,0],["رآك فاهتز خفّاقٌ بأضلعه","ورتلت شفتاه سورة الألم",37,"م",1,0],["راكِبٌ رَدعَهُ كَحاطِبِ لَيلٍ","يُخطِئُ الأَمرَ كُلَّهُ أَو يُصيبُه",38,"ب",2,0],["رآك أميرُ المؤمنين لحكمةٍ","من الله أهلاً للعلا والترفُعِ",39,"ع",1,0],["رآكَ اللَّهُ مَوضعَها فكانَت","وحُقَّ لما رآهُ أن يَكونا",40,"ن",2,0],["رآك المبدعون وهم حيارى","بأنك فيهم قدحٌ ورِيُّ",41,"ي",1,0],["رَاكِدَ ليلٍ تحتَ شمسٍ تَسري","ضِدّان فيها اتّفقا لأمرِ",42,"ر",1,0],["راكباً في مركبٍ أرَّخْتُه","إركَبوا فيه بخيرٍ آمنينْ",43,"ن",1,0],["راكب من سوابق العزم خيلاً","أمِنَتْ في سباقهن العثارا",44,"ر",2,0],["رَآكَ أَحَقَّ النّاسِ بالإِمْرَةِ الَّتي","يَمازِجُ فِيها جَوْهَرَ الْمُلْكِ جَوْهَرُكْ",45,"ك",1,0],["رآكَ ملءَ ثيابِ الدّينِ واسعةً","فجاءَ منها لترعاهُ بِتِمْثَالِ",46,"ل",1,0],["راكعٌ ساجدٌ أَصَمُّ سميعٌ","أَخرسٌ ناطقٌ حقيرٌ جليلُ",47,"ل",1,0],["رآكَ جديراً أن يباهِيَ خَلْقَهُ","ويُحْيِي بكَ الأَملاكَ فِي غابِرِ الدَّهْرِ",48,"ر",1,0],["رآك أعفَّهم بالغيب سرّاً","وأفرسَهم على ظهرِ الجدالِ",49,"ل",1,0],["رآك وأنت حسرتهُ بعينٍ","كعين الطِّرفِ ماطلها العليقُ",50,"ق",1,0],["رآك الإمامُ كفئَها وقِوامَها","فسيقت وما إلا علاك لها مَهْرُ",51,"ر",1,0],["راكبُ العزّ في مفاوزها اليَهْ","ماءِ سارٍ لا يركب التغريرا",52,"ر",2,0],["رآك كمُلتَ فظنَّ الكمالَ","لكلّ فتىً رامَهُ يقدِرُ",53,"ر",1,0],["رآك وميِّتُ الآمال حيٌّ","بجودك والندَى الأعمى بصيرُ",54,"ر",1,0],["رآك بهَدْيِهِ فجزاك خيراً","وقد يتفرَّسُ الرجلُ البصيرُ",54,"ر",1,0],["رآك دون الناس أولى بالذي","بالغ فيهِ من ثناء واجتهدْ",55,"د",1,0],["راكبُها وهو على ظهرها","موطَّأَ الجنبِ قليلُ السهادْ",56,"د",1,0],["رآكَ اِمامُ سَيْفاً مُهَنَّداً","اذا كما انتضاهُ كان في الضرب ماضيا",57,"ي",2,0],["رآك بحراً فرقاه إلى جبل","ومن رأى قبلها بحراً على جبل",58,"ل",1,0],["راكب الخيل عاريات إلى ال","حرب أشم العرنين يعلو أشما",59,"م",2,0],["رَآكَ غايَةَ آمالي فَما بَرِحَت","تَسعى لِياليهِ حَتّى نِلتُ آمالي",60,"ل",2,0],["رآكَ بعدَ النّوى ليلاً فعادلَهُ","عُمرُ الشّبيبةِ غضّاً وهْوَ مُكتَحِلُ",61,"ل",1,0],["رَآكَ رَبُّكَ أَهلاً إِذ حَباكَ بِها","فَاِبقَ وَدُم بِسُرورٍ ناعِماً فيها",62,"ي",3,0],["رآك جَديراً بِالمَعالي فَساقَها","إِلَيكَ عَلى رَغم الحَسود المفنّد",63,"د",1,0],["رآكَ مُضطَرّاً بِلا قُوَّةٍ","فمنَّ بالقُوَّةِ واختارَ لَكْ",64,"ك",1,0],["راكعٌ أنت ساجدٌ تسبق الغر","ر الميامين رُكَّعاً وسجودا",65,"د",2,0],["رآك خليلاك اللَّذانِ تَقَادَمَت","عُهُودُهُما يَوماً فَمَا عَرَفَاني",66,"ن",2,0],["راكب كف البازيار المدلج","نبل الفنا من قُبَّر وأقبج",67,"ج",1,0],["راكِبَ الوَجناءِ عَرِّج بِي إِلى","ناحِلِ الخَصرِ وَمَيَّادِ القَوَامِ",68,"م",1,0],["راكبهُ رائع وغادٍ","يهزُّ بالريح والبروقِ",69,"ق",1,0],["رَأكَ مَليكُ الكَون تَحيي عَبيدُهُ","وَتَجذُب بِاللُطف الخَفيّ القبائِلا",70,"ل",2,0],["رَأَكَ مَليكُ المَجد بَينَ رِجالِهِ","حُساماً عَلَيهِ لِلفَخار حمائِلُ",71,"ل",1,0],["رَأَكَ المَجدُ في الأَبراجِ بَدراً","بِمنزلهِ السُعودُ لَها نَزولُ",72,"ل",1,0],["راكِضةً إليَّ في جلبابِها","مازِجةً ماذيَّها بِصابِها",73,"ه",2,0],["رآك مكان النَّجم في رأس باذخٍ","تمكّن في فرع العُلى وتَبَحْبَحا",74,"ح",2,0],["رآك لقصده أهلاً، وأنى","يرجى الغيث من غير السحاب؟",75,"ب",1,1],["رآك له ظهيراً صار يغنى","به دون البطانة والظهاره",76,"ر",2,0],["رآكَ تفرَّعت من دوحةٍ","زكا في العُلى طيب أعراقِها",77,"ق",3,0],["راكباً ريحَها بمُنجرِدٍ","خانت لريحُ جَرَيَهُ فكبا",78,"ب",2,0],["راكدٌ مثلُ صفحةِ الماءِ أوْرَى","عن ذَكاءٍ كالنارِ في الإبراق",79,"ق",1,0],["راكعاً ساجداً إلى بيت حان","لا صلاة فيه ولا تكبير",80,"ر",1,0],["رآك أهلاً لهذا الملك تحرس ما","استرعاك منه فألقى بالمقاليد",81,"د",1,0],["رآك بنو لبنان اعرق اهله","بمنسبك العالي كريم المناسب",82,"ب",1,0],["راك امير المؤمنين مدبراً","عزوماً وما غير النهى لك مذهب",83,"ب",1,0],["رآكَ الحوتُ تشملهُ بفضلٍ","فكابرَه فى محاسنهِ الغزالا",84,"ل",2,0],["رآك فى دنياه بل دينه","عوناً على الأيام للمسلم",85,"م",1,0],["رآك الدهر أهلا للمعالي","فحيى بالسرور وما يليه",86,"ي",2,0],["رآك محلا للعلا فأحلها","لديك كما يهوى العلا وله الشكر",87,"ر",1,0],["راكابد الزمن الخؤون وجيشه","وأصول صول الفارس السَّباق",88,"ق",1,0],["راكب الدهر لا يراه سويا","بل ذلولا طورا وطورا شموسا",89,"س",2,0],["راكِباً فَوقَ المُشاةِ","لابِساً ثَوبَ البِهاءِ",90,"ا",2,0],["راكضاً خلفه متى تركب الخيل","وما يشتكي من الأتعاب",91,"ب",1,0],["راكِباً في الضيمِ لي ظَه","رَ عِنادٍ وَلِجاجِ",92,"ج",1,0],["رآك ابوها ارذل القوم عنده","واسقط نفساً في العباد واحقرا",93,"ر",2,0],["رآك اتخذت النجم للنعل موطئا","فأرعد شأن الحاسدين وأبرقا",94,"ق",2,0],["رآك مَليكُ مِصرٍ خيرَ كُفءٍ","وَخَيرَ مَنِ اِستَحَقَّ وَلا مِراءَ",95,"ا",2,0],["رآكَ أَحقَ بالتأميلِ منهم","وأَولى بالحِيَاطَةِ والذيَادِ",96,"د",1,0],["راكب الريح إذا قيس إلى","خطوك الواني سلحفاة كسير",97,"ر",1,0],["راكَ مِن بَينِهِم صالِحاً","لَهُ فَوَلّاك بِنَصّ صُراح",98,"