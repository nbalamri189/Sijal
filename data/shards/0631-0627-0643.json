{"poems":[[55,"زار والركب حرام","https://www.aldiwan.net/poem29819.html","مجزوء الرمل"],[55,"أحظى الملوك من الأيام والدول","https://www.aldiwan.net/poem29908.html","البسيط"],[55,"طلاب العز من شيم الشجاع","https://www.aldiwan.net/poem30155.html","الوافر"],[55,"عند قلبي علاقة ما تقضى","https://www.aldiwan.net/poem30174.html","الخفيف"],[88,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[53,"جعل الله مهربا وامتطى الليل مركبا","https://www.aldiwan.net/poem8650.html","مجزوء الخفيف"],[53,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[53,"تأمل أبا عبد الإله فإنه","https://www.aldiwan.net/poem66003.html","الطويل"],[87,"رآك تحب السجع حتى تظنه","https://www.aldiwan.net/poem7551.html","الطويل"],[87,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[87,"يا فرنسا نلت أسباب السماء","https://www.aldiwan.net/poem63728.html","الكامل"],[47,"نحن الفداء فمأخوذ ومرتقب","https://www.aldiwan.net/poem10890.html","البسيط"],[30,"ألستم عائجين بنا لعنا","https://www.aldiwan.net/poem5607.html","الوافر"],[51,"المنايا تجوس كل البلاد","https://www.aldiwan.net/poem62044.html","الخفيف"],[51,"راكب الأيام يجري عليها","https://www.aldiwan.net/poem65329.html","المديد"],[82,"أعطيت حكمك في الأيام فاحتكم","https://www.aldiwan.net/poem31290.html","البسيط"],[82,"خلعت على بنيات الكروم","https://www.aldiwan.net/poem31295.html","الوافر"],[46,"نطقت مقلة الفتى الملهوف","https://www.aldiwan.net/poem29715.html","الخفيف"],[46,"سرت تستجير الدمع خوف نوى غد","https://www.aldiwan.net/poem30547.html","الطويل"],[107,"أبا الفضل أقبل وارفع الصوت شاكرا","https://www.aldiwan.net/poem44043.html","الطويل"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[48,"ربيت شبلا فلما إن غدا أسدا","https://www.aldiwan.net/poem23106.html","البسيط"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16691","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[108,"زورق في الفضاء","https://www.poetsgate.com/ViewPoem.aspx?id=179453",""],[108,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[111,"راكب اللي كنه السيل النحاوي","https://www.poetsgate.com/ViewPoem.aspx?id=8391",""],[27,"هَلْ تَعْرِفُ الدَّارَ قَفْراً لاَ أَنِيسَ بِهَا","https://www.poetsgate.com/ViewPoem.aspx?id=18373",""],[202,"حرمت يا ليل علينا المنام","https://www.aldiwan.net/poem45347.html","السريع"],[238,"قدمت بهاء الدين أسعد مقدم","https://www.aldiwan.net/poem32119.html","الطويل"],[283,"جرى لك بالتوفيق أيمن طائر","https://www.aldiwan.net/poem60716.html","الطويل"],[285,"وأهيف لحظه بالسحر ناجا","https://www.aldiwan.net/poem32838.html","الوافر"],[308,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[308,"عظم الأجر عن عظيم المصاب","https://www.aldiwan.net/poem56609.html","الكامل"],[331,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[331,"ألقت عليك الليالي ثوبها البالي","https://www.aldiwan.net/poem55038.html","البسيط"],[341,"ليس شيء مما يدبره العاقل","https://www.aldiwan.net/poem68640.html","الوافر"],[372,"سقى الله بغداداً وساكنها الحيا","https://www.aldiwan.net/poem4294.html","الطويل"],[374,"تعود أن يحول وأن يخونا","https://www.aldiwan.net/poem57082.html","الوافر"],[380,"ألا يا أيها الخل الوفي","https://www.aldiwan.net/poem59168.html","الوافر"],[412,"ما هاج هذا الشوق غير الذكر","https://www.aldiwan.net/poem32594.html","الرجز"],[419,"سر بحفظ الله وارجع سالما","https://www.aldiwan.net/poem53920.html","الرمل"],[419,"شرب القوم من لماك عقارا","https://www.aldiwan.net/poem54115.html","الخفيف"],[427,"عذلت امرءا في عشقه ليس يعذرك","https://www.aldiwan.net/poem26460.html","الطويل"],[435,"تقلب الدهر من حال إلى حال","https://www.aldiwan.net/poem12337.html","البسيط"],[435,"قل لفخر الأئمة العلم العا","https://www.aldiwan.net/poem12363.html","الخفيف"],[442,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[460,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[460,"أيا سكر الزمان متى تفيق","https://www.aldiwan.net/poem56099.html","الوافر"],[460,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[460,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[460,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[460,"فكاكك أيها القلب الأسير","https://www.aldiwan.net/poem56202.html","الوافر"],[460,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[460,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[463,"أقمت عماد الدين حتى رفعته","https://www.aldiwan.net/poem16023.html","الطويل"],[466,"أنظر إلى الغيث ما أعطتك راحته","https://www.aldiwan.net/poem3119.html","عموديه"],[466,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[495,"يا من إذا خفت فيه العذل آمنني","https://www.aldiwan.net/poem67334.html","البسيط"],[516,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[555,"شغلي عن الدار أبكيها وأرثيها","https://www.aldiwan.net/poem68403.html","البسيط"]],"verses":[["راكِباً ظَهراً مِنَ الغِي","يِ مُسيمٌ وَمُسامُ",0,"م",1,0],["رَآكَ أَشرَفَ مَمدوحٍ لِمُمتَدِحٍ","وَخَيرُ مَن شَرَعَت فيهِ يَدُ الأَمَلِ",1,"ل",1,0],["رَآكَ لِكُلِّ ما يَأتيهِ أَهلاً","وَأَنتَ أَحَقُّ ذَوداً بِالمِراعِ",2,"ع",1,0],["راكِباً صَهوَةَ الخِطارِ عَقيداً","لِبَناتِ الفَلا يَجُبنَ الأَرضا",3,"ض",2,0],["راكِباً رَأسَهُ طَريداً شَريداً","لا يُبالي بِشِرعَةٍ أَو ذِمامِ",4,"م",1,0],["راكعاً ساجداً لهُ","ليس يألُو تَقُرُّبا",5,"ب",2,0],["رآكم الله والسلطان حزبهما","فاستعمر الملك منكم خير عمار",6,"ر",1,0],["رآك وقوماً أشبهوكَ نفايةً","إماطتُها عند الأماثل أمثلُ",7,"ل",1,0],["رآك تحب السجع حتى تظنه","هو الحسن لا ما جاء من جودة الطبع",8,"ع",1,1],["راكِبَ البَحرِ أَمَوجٌ ما تَرى","أَم كِتابُ الدَهرِ أَم صُحفُ القَدَر",9,"ر",1,0],["راكِبٌ ما شاءَ مِن أَطرافِهِ","لا يُرى مِن مَركَبٍ ذي عُدَواء",10,"ا",2,0],["رَآكَ إِن وَقَفوا في الأَمرِ تَسبِقُهُم","هَدياً وَإِن خَمَدوا في الرَأيِ تَلتَهِبُ",11,"ب",1,0],["رَآكَ اللَهُ أَولى الناسِ طُرّاً","بِأَعوادِ الخِلافَةِ وَالسَلامِ",12,"م",1,0],["راكِبُ الريحِ قاهِرُ الجِنِّ وَالإِن","سِ بِسُلطانِهِ مُذِلُّ الأَعادي",13,"د",2,0],["راكِبُ الأَيّامِ يَجري عَلَيها","وَلَهُ مِنهُنَّ يَومٌ حَرونُ",14,"ن",1,1],["رآك بالقلب لا بالعين من جَزَعٍ","في دَسْتِ مُلْكِ عليه هَيْبةُ العِظَمِ",15,"م",1,0],["رآك وأنتَ مبتسمٌ كضارٍ","تثاءَبَ عن نواجذه شتيمِ",16,"م",1,0],["راكِبٌ لِلأُمورِ في حَلبَةِ الأَي","يامِ لِلمُنجِياتِ أَو لِلحُتوفِ",17,"ف",1,0],["رَآكَ سَديدَ الرَأيِ وَالرُمحِ في الوَغى","تَأَزَّرُ بِالإِقدامِ فيهِ وَتَرتَدي",18,"د",2,0],["رَآكَ فَقرَّتْ عَينُهُ وترافدَتْ","تَحيّاتُهُ تَلقَاكَ زُهْراً نَواضِرا",19,"ر",2,0],["رَاكعاً ساجِداً يُسبِّحُ مَولا","هُ ويُزجِي التَّهليلَ والتّكبيرا",20,"ر",2,0],["رَآكَ شَوكَ قَتادٍ لَيسَ يَمكِنُهُ","وَلَو رَآكَ غَضيضَ النَبتِ لَاِبتَقَلَك",21,"ك",1,0],["رَآكَ بِبَثَّ فَلَم يَلتَفِت","إِلَيكَ وَقالَ كَذاكَ اِدأَبِ",22,"ب",1,0],["رَآكنَّ فيهِ وحيَّا بهِ","فلم أدْرِ حاجتَه للنظرْ",23,"ر",1,0],["راكِباً يَطْلُبُ المَنونَ ذُرَى عِشْ","رِينَ لم يَدْرِ كيْفَ مَعنى الرّكوب",24,"ب",1,0],["رَاكِباً مَتْنَ النَّوَى لمَّا نوَى","ضَارِباً بَيْنَ غَدٍ وَالامْسِ سِتْرَا",25,"ر",2,0],["راكبي الجوِّ، قد ركبتم ذلولا","لا وهادًا خشيتمو، أو هضابا",26,"ب",2,0],["راكعٌ، قائمٌ، على الأرض جاث","فوقها في تَبَتُّل وإِنَابة",27,"ب",2,0],["راكب اللي كنه السيل النحاوي","لاصختبه. من خيار المزن.؟.؟.؟. ديمه",28,"م",2,1],["راكَلْتُهُ ، والعِدا ترمي مَقاتِلَهُ","خِرْقَ النَّشاشيبِ في ذي شُمْرُجٍ عاري",29,"ر",2,0],["راكَ للعشاقِ قبراً فهلْ","فيكَ من العشاقِ إلا عظامْ",30,"م",1,0],["رَآكَ الأَعاضي حينَ قُلِّتَ حَربَهُم","أَخا عَزَماتٍ فَاِستَكانوا إِلى الصُلحِ",31,"ح",1,0],["رَآكَ بِعَيْنِ اللُّبِّ أَبْعَدَ فِي الْعُلى","وَأَسْعَدَ مِنْ زُهْرِ النُّجُومِ الْبَواهِرِ",32,"ر",1,0],["رَآكَ العادِلُ المَلِكُ المُفَدّى","وَلِيّاً لَم يَكُن مُذ كانَ داجا",33,"ج",2,0],["راكبُ الجدّ حازمٌ لا ترى","منهُ المَطايا مجرورة الأرسانِ",34,"ن",1,0],["راكنات بالاعتيادِ إِلَيها","في اِجتلابٍ لِنَفعها واِجتنابِ",35,"ب",1,0],["رآك خليلُك نور الشموس","وظنوك في الهند نار المجوس",36,"س",1,0],["رآك فاهتز خفّاقٌ بأضلعه","ورتلت شفتاه سورة الألم",37,"م",1,0],["راكِبٌ رَدعَهُ كَحاطِبِ لَيلٍ","يُخطِئُ الأَمرَ كُلَّهُ أَو يُصيبُه",38,"ب",2,0],["رآك أميرُ المؤمنين لحكمةٍ","من الله أهلاً للعلا والترفُعِ",39,"ع",1,0],["رآكَ اللَّهُ مَوضعَها فكانَت","وحُقَّ لما رآهُ أن يَكونا",40,"ن",2,0],["رآك المبدعون وهم حيارى","بأنك فيهم قدحٌ ورِيُّ",41,"ي",1,0],["رَاكِدَ ليلٍ تحتَ شمسٍ تَسري","ضِدّان فيها اتّفقا لأمرِ",42,"ر",1,0],["راكباً في مركبٍ أرَّخْتُه","إركَبوا فيه بخيرٍ آمنينْ",43,"ن",1,0],["راكب من سوابق العزم خيلاً","أمِنَتْ في سباقهن العثارا",44,"ر",2,0],["رَآكَ أَحَقَّ النّاسِ بالإِمْرَةِ الَّتي","يَمازِجُ فِيها جَوْهَرَ الْمُلْكِ جَوْهَرُكْ",45,"ك",1,0],["رآكَ ملءَ ثيابِ الدّينِ واسعةً","فجاءَ منها لترعاهُ بِتِمْثَالِ",46,"ل",1,0],["راكعٌ ساجدٌ أَصَمُّ سميعٌ","أَخرسٌ ناطقٌ حقيرٌ جليلُ",47,"ل",1,0],["رآكَ جديراً أن يباهِيَ خَلْقَهُ","ويُحْيِي بكَ الأَملاكَ فِي غابِرِ الدَّهْرِ",48,"ر",1,0],["رآك أعفَّهم بالغيب سرّاً","وأفرسَهم على ظهرِ الجدالِ",49,"ل",1,0],["رآك وأنت حسرتهُ بعينٍ","كعين الطِّرفِ ماطلها العليقُ",50,"ق",1,0],["رآك الإمامُ كفئَها وقِوامَها","فسيقت وما إلا علاك لها مَهْرُ",51,"ر",1,0],["راكبُ العزّ في مفاوزها اليَهْ","ماءِ سارٍ لا يركب التغريرا",52,"ر",2,0],["رآك كمُلتَ فظنَّ الكمالَ","لكلّ فتىً رامَهُ يقدِرُ",53,"ر",1,0],["رآك وميِّتُ الآمال حيٌّ","بجودك والندَى الأعمى بصيرُ",54,"ر",1,0],["رآك بهَدْيِهِ فجزاك خيراً","وقد يتفرَّسُ الرجلُ البصيرُ",54,"ر",1,0],["رآك دون الناس أولى بالذي","بالغ فيهِ من ثناء واجتهدْ",55,"د",1,0],["راكبُها وهو على ظهرها","موطَّأَ الجنبِ قليلُ السهادْ",56,"د",1,0],["رآكَ اِمامُ سَيْفاً مُهَنَّداً","اذا كما انتضاهُ كان في الضرب ماضيا",57,"ي",2,0],["رآك بحراً فرقاه إلى جبل","ومن رأى قبلها بحراً على جبل",58,"ل",1,0],["راكب الخيل عاريات إلى ال","حرب أشم العرنين يعلو أشما",59,"م",2,0],["رَآكَ غايَةَ آمالي فَما بَرِحَت","تَسعى لِياليهِ حَتّى نِلتُ آمالي",60,"ل",2,0],["رآكَ بعدَ النّوى ليلاً فعادلَهُ","عُمرُ الشّبيبةِ غضّاً وهْوَ مُكتَحِلُ",61,"ل",1,0],["رَآكَ رَبُّكَ أَهلاً إِذ حَباكَ بِها","فَاِبقَ وَدُم بِسُرورٍ ناعِماً فيها",62,"ي",3,0]]}