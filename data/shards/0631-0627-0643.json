{"poems":[[53,"زار والركب حرام","https://www.aldiwan.net/poem29819.html","مجزوء الرمل"],[53,"أحظى الملوك من الأيام والدول","https://www.aldiwan.net/poem29908.html","البسيط"],[53,"طلاب العز من شيم الشجاع","https://www.aldiwan.net/poem30155.html","الوافر"],[53,"عند قلبي علاقة ما تقضى","https://www.aldiwan.net/poem30174.html","الخفيف"],[86,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[51,"جعل الله مهربا وامتطى الليل مركبا","https://www.aldiwan.net/poem8650.html","مجزوء الخفيف"],[51,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[51,"تأمل أبا عبد الإله فإنه","https://www.aldiwan.net/poem66003.html","الطويل"],[85,"رآك تحب السجع حتى تظنه","https://www.aldiwan.net/poem7551.html","الطويل"],[85,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[85,"يا فرنسا نلت أسباب السماء","https://www.aldiwan.net/poem63728.html","الكامل"],[45,"نحن الفداء فمأخوذ ومرتقب","https://www.aldiwan.net/poem10890.html","البسيط"],[28,"ألستم عائجين بنا لعنا","https://www.aldiwan.net/poem5607.html","الوافر"],[49,"المنايا تجوس كل البلاد","https://www.aldiwan.net/poem62044.html","الخفيف"],[49,"راكب الأيام يجري عليها","https://www.aldiwan.net/poem65329.html","المديد"],[80,"أعطيت حكمك في الأيام فاحتكم","https://www.aldiwan.net/poem31290.html","البسيط"],[80,"خلعت على بنيات الكروم","https://www.aldiwan.net/poem31295.html","الوافر"],[44,"نطقت مقلة الفتى الملهوف","https://www.aldiwan.net/poem29715.html","الخفيف"],[44,"سرت تستجير الدمع خوف نوى غد","https://www.aldiwan.net/poem30547.html","الطويل"],[105,"أبا الفضل أقبل وارفع الصوت شاكرا","https://www.aldiwan.net/poem44043.html","الطويل"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[46,"ربيت شبلا فلما إن غدا أسدا","https://www.aldiwan.net/poem23106.html","البسيط"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16691","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[106,"زورق في الفضاء","https://www.poetsgate.com/ViewPoem.aspx?id=179453",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[197,"حرمت يا ليل علينا المنام","https://www.aldiwan.net/poem45347.html","السريع"],[233,"قدمت بهاء الدين أسعد مقدم","https://www.aldiwan.net/poem32119.html","الطويل"],[278,"جرى لك بالتوفيق أيمن طائر","https://www.aldiwan.net/poem60716.html","الطويل"],[280,"وأهيف لحظه بالسحر ناجا","https://www.aldiwan.net/poem32838.html","الوافر"],[303,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[303,"عظم الأجر عن عظيم المصاب","https://www.aldiwan.net/poem56609.html","الكامل"],[326,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[326,"ألقت عليك الليالي ثوبها البالي","https://www.aldiwan.net/poem55038.html","البسيط"],[336,"ليس شيء مما يدبره العاقل","https://www.aldiwan.net/poem68640.html","الوافر"],[367,"سقى الله بغداداً وساكنها الحيا","https://www.aldiwan.net/poem4294.html","الطويل"],[369,"تعود أن يحول وأن يخونا","https://www.aldiwan.net/poem57082.html","الوافر"],[374,"ألا يا أيها الخل الوفي","https://www.aldiwan.net/poem59168.html","الوافر"],[406,"ما هاج هذا الشوق غير الذكر","https://www.aldiwan.net/poem32594.html","الرجز"],[413,"سر بحفظ الله وارجع سالما","https://www.aldiwan.net/poem53920.html","الرمل"],[413,"شرب القوم من لماك عقارا","https://www.aldiwan.net/poem54115.html","الخفيف"],[421,"عذلت امرءا في عشقه ليس يعذرك","https://www.aldiwan.net/poem26460.html","الطويل"],[429,"تقلب الدهر من حال إلى حال","https://www.aldiwan.net/poem12337.html","البسيط"],[429,"قل لفخر الأئمة العلم العا","https://www.aldiwan.net/poem12363.html","الخفيف"],[436,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[456,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[456,"أيا سكر الزمان متى تفيق","https://www.aldiwan.net/poem56099.html","الوافر"],[456,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[456,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[456,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[456,"فكاكك أيها القلب الأسير","https://www.aldiwan.net/poem56202.html","الوافر"],[456,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[456,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[459,"أقمت عماد الدين حتى رفعته","https://www.aldiwan.net/poem16023.html","الطويل"],[462,"أنظر إلى الغيث ما أعطتك راحته","https://www.aldiwan.net/poem3119.html","عموديه"],[462,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[491,"يا من إذا خفت فيه العذل آمنني","https://www.aldiwan.net/poem67334.html","البسيط"],[512,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[551,"شغلي عن الدار أبكيها وأرثيها","https://www.aldiwan.net/poem68403.html","البسيط"]],"verses":[["راكِباً ظَهراً مِنَ الغِي","يِ مُسيمٌ وَمُسامُ",0,"م",1,0],["رَآكَ أَشرَفَ مَمدوحٍ لِمُمتَدِحٍ","وَخَيرُ مَن شَرَعَت فيهِ يَدُ الأَمَلِ",1,"ل",1,0],["رَآكَ لِكُلِّ ما يَأتيهِ أَهلاً","وَأَنتَ أَحَقُّ ذَوداً بِالمِراعِ",2,"ع",1,0],["راكِباً صَهوَةَ الخِطارِ عَقيداً","لِبَناتِ الفَلا يَجُبنَ الأَرضا",3,"ض",2,0],["راكِباً رَأسَهُ طَريداً شَريداً","لا يُبالي بِشِرعَةٍ أَو ذِمامِ",4,"م",1,0],["راكعاً ساجداً لهُ","ليس يألُو تَقُرُّبا",5,"ب",2,0],["رآكم الله والسلطان حزبهما","فاستعمر الملك منكم خير عمار",6,"ر",1,0],["رآك وقوماً أشبهوكَ نفايةً","إماطتُها عند الأماثل أمثلُ",7,"ل",1,0],["رآك تحب السجع حتى تظنه","هو الحسن لا ما جاء من جودة الطبع",8,"ع",1,1],["راكِبَ البَحرِ أَمَوجٌ ما تَرى","أَم كِتابُ الدَهرِ أَم صُحفُ القَدَر",9,"ر",1,0],["راكِبٌ ما شاءَ مِن أَطرافِهِ","لا يُرى مِن مَركَبٍ ذي عُدَواء",10,"ا",2,0],["رَآكَ إِن وَقَفوا في الأَمرِ تَسبِقُهُم","هَدياً وَإِن خَمَدوا في الرَأيِ تَلتَهِبُ",11,"ب",1,0],["رَآكَ اللَهُ أَولى الناسِ طُرّاً","بِأَعوادِ الخِلافَةِ وَالسَلامِ",12,"م",1,0],["راكِبُ الريحِ قاهِرُ الجِنِّ وَالإِن","سِ بِسُلطانِهِ مُذِلُّ الأَعادي",13,"د",2,0],["راكِبُ الأَيّامِ يَجري عَلَيها","وَلَهُ مِنهُنَّ يَومٌ حَرونُ",14,"ن",1,1],["رآك بالقلب لا بالعين من جَزَعٍ","في دَسْتِ مُلْكِ عليه هَيْبةُ العِظَمِ",15,"م",1,0],["رآك وأنتَ مبتسمٌ كضارٍ","تثاءَبَ عن نواجذه شتيمِ",16,"م",1,0],["راكِبٌ لِلأُمورِ في حَلبَةِ الأَي","يامِ لِلمُنجِياتِ أَو لِلحُتوفِ",17,"ف",1,0],["رَآكَ سَديدَ الرَأيِ وَالرُمحِ في الوَغى","تَأَزَّرُ بِالإِقدامِ فيهِ وَتَرتَدي",18,"د",2,0],["رَآكَ فَقرَّتْ عَينُهُ وترافدَتْ","تَحيّاتُهُ تَلقَاكَ زُهْراً نَواضِرا",19,"ر",2,0],["رَاكعاً ساجِداً يُسبِّحُ مَولا","هُ ويُزجِي التَّهليلَ والتّكبيرا",20,"ر",2,0],["رَآكَ شَوكَ قَتادٍ لَيسَ يَمكِنُهُ","وَلَو رَآكَ غَضيضَ النَبتِ لَاِبتَقَلَك",21,"ك",1,0],["رَآكَ بِبَثَّ فَلَم يَلتَفِت","إِلَيكَ وَقالَ كَذاكَ اِدأَبِ",22,"ب",1,0],["رَآكنَّ فيهِ وحيَّا بهِ","فلم أدْرِ حاجتَه للنظرْ",23,"ر",1,0],["راكِباً يَطْلُبُ المَنونَ ذُرَى عِشْ","رِينَ لم يَدْرِ كيْفَ مَعنى الرّكوب",24,"ب",1,0],["رَاكِباً مَتْنَ النَّوَى لمَّا نوَى","ضَارِباً بَيْنَ غَدٍ وَالامْسِ سِتْرَا",25,"ر",2,0],["راكبي الجوِّ، قد ركبتم ذلولا","لا وهادًا خشيتمو، أو هضابا",26,"ب",2,0],["راكعٌ، قائمٌ، على الأرض جاث","فوقها في تَبَتُّل وإِنَابة",27,"ب",2,0],["راكَ للعشاقِ قبراً فهلْ","فيكَ من العشاقِ إلا عظامْ",28,"م",1,0],["رَآكَ الأَعاضي حينَ قُلِّتَ حَربَهُم","أَخا عَزَماتٍ فَاِستَكانوا إِلى الصُلحِ",29,"ح",1,0],["رَآكَ بِعَيْنِ اللُّبِّ أَبْعَدَ فِي الْعُلى","وَأَسْعَدَ مِنْ زُهْرِ النُّجُومِ الْبَواهِرِ",30,"ر",1,0],["رَآكَ العادِلُ المَلِكُ المُفَدّى","وَلِيّاً لَم يَكُن مُذ كانَ داجا",31,"ج",2,0],["راكبُ الجدّ حازمٌ لا ترى","منهُ المَطايا مجرورة الأرسانِ",32,"ن",1,0],["راكنات بالاعتيادِ إِلَيها","في اِجتلابٍ لِنَفعها واِجتنابِ",33,"ب",1,0],["رآك خليلُك نور الشموس","وظنوك في الهند نار المجوس",34,"س",1,0],["رآك فاهتز خفّاقٌ بأضلعه","ورتلت شفتاه سورة الألم",35,"م",1,0],["راكِبٌ رَدعَهُ كَحاطِبِ لَيلٍ","يُخطِئُ الأَمرَ كُلَّهُ أَو يُصيبُه",36,"ب",2,0],["رآك أميرُ المؤمنين لحكمةٍ","من الله أهلاً للعلا والترفُعِ",37,"ع",1,0],["رآكَ اللَّهُ مَوضعَها فكانَت","وحُقَّ لما رآهُ أن يَكونا",38,"ن",2,0],["رآك المبدعون وهم حيارى","بأنك فيهم قدحٌ ورِيُّ",39,"ي",1,0],["رَاكِدَ ليلٍ تحتَ شمسٍ تَسري","ضِدّان فيها اتّفقا لأمرِ",40,"ر",1,0],["راكباً في مركبٍ أرَّخْتُه","إركَبوا فيه بخيرٍ آمنينْ",41,"ن",1,0],["راكب من سوابق العزم خيلاً","أمِنَتْ في سباقهن العثارا",42,"ر",2,0],["رَآكَ أَحَقَّ النّاسِ بالإِمْرَةِ الَّتي","يَمازِجُ فِيها جَوْهَرَ الْمُلْكِ جَوْهَرُكْ",43,"ك",1,0],["رآكَ ملءَ ثيابِ الدّينِ واسعةً","فجاءَ منها لترعاهُ بِتِمْثَالِ",44,"ل",1,0],["راكعٌ ساجدٌ أَصَمُّ سميعٌ","أَخرسٌ ناطقٌ حقيرٌ جليلُ",45,"ل",1,0],["رآكَ جديراً أن يباهِيَ خَلْقَهُ","ويُحْيِي بكَ الأَملاكَ فِي غابِرِ الدَّهْرِ",46,"ر",1,0],["رآك أعفَّهم بالغيب سرّاً","وأفرسَهم على ظهرِ الجدالِ",47,"ل",1,0],["رآك وأنت حسرتهُ بعينٍ","كعين الطِّرفِ ماطلها العليقُ",48,"ق",1,0],["رآك الإمامُ كفئَها وقِوامَها","فسيقت وما إلا علاك لها مَهْرُ",49,"ر",1,0],["راكبُ العزّ في مفاوزها اليَهْ","ماءِ سارٍ لا يركب التغريرا",50,"ر",2,0],["رآك كمُلتَ فظنَّ الكمالَ","لكلّ فتىً رامَهُ يقدِرُ",51,"ر",1,0],["رآك وميِّتُ الآمال حيٌّ","بجودك والندَى الأعمى بصيرُ",52,"ر",1,0],["رآك بهَدْيِهِ فجزاك خيراً","وقد يتفرَّسُ الرجلُ البصيرُ",52,"ر",1,0],["رآك دون الناس أولى بالذي","بالغ فيهِ من ثناء واجتهدْ",53,"د",1,0],["راكبُها وهو على ظهرها","موطَّأَ الجنبِ قليلُ السهادْ",54,"د",1,0],["رآكَ اِمامُ سَيْفاً مُهَنَّداً","اذا كما انتضاهُ كان في الضرب ماضيا",55,"ي",2,0],["رآك بحراً فرقاه إلى جبل","ومن رأى قبلها بحراً على جبل",56,"ل",1,0],["راكب الخيل عاريات إلى ال","حرب أشم العرنين يعلو أشما",57,"م",2,0],["رَآكَ غايَةَ آمالي فَما بَرِحَت","تَسعى لِياليهِ حَتّى نِلتُ آمالي",58,"ي",1,0],["رآكَ بعدَ النّوى ليلاً فعادلَهُ","عُمرُ الشّبيبةِ غضّاً وهْوَ مُكتَحِلُ",59,"ل",1,0],["رَآكَ رَبُّكَ أَهلاً إِذ حَباكَ بِها","فَاِبقَ وَدُم بِسُرورٍ ناعِماً فيها",60,"ي",3,0]]}