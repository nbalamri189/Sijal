{"poems":[[47,"قلما لا تتصباني الدمن","https://www.aldiwan.net/poem66660.html","الرمل"],[264,"زدت يا بيروت نورا","https://www.aldiwan.net/poem35790.html","مجزوء الرمل"],[275,"أغنى التقى عن برقع وخباء","https://www.aldiwan.net/poem35588.html","الكامل"],[333,"ابن عمي مات فامضوا","https://www.aldiwan.net/poem54961.html","مجزوء الرمل"],[385,"يا بخيل المقلتين","https://www.aldiwan.net/poem48795.html","مجزوء الرمل"],[463,"طرقت على خطر السرى المركوب","https://www.aldiwan.net/poem56281.html","الكامل"],[520,"يا دار عليك سعد المشتري","https://www.aldiwan.net/poem12135.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86757","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49964","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48210","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204998","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101389","الكامل"],[4755,"ولَقَد رَأَيتُ.. لَقَد رَأَيتُ مُحَالا","https://www.poetsgate.com/ViewPoem.aspx?id=184349",""],[463,"طرقتْ على خطر السرى المركوبِ","https://www.poetsgate.com/ViewPoem.aspx?id=25003",""],[5056,"أبجدية النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=53916",""],[5365,"الوصيّة","https://www.poetsgate.com/ViewPoem.aspx?id=190421",""],[5414,"حوار مع منافق","https://www.poetsgate.com/ViewPoem.aspx?id=12929",""],[5431,"وفؤادي مولّه ما تخلى","https://www.poetsgate.com/ViewPoem.aspx?id=196916",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[5190,"إشارة حمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85037&r=&rc=112",""]],"verses":[["وَعَلى داراتِ خَفّانَ وَقَد","أَخلَفَ الهَيصَمُ ما كانَ يُظَنّ",0,"ن",1,0],["وعلى دعواي عندي","من مزاياه شهاده",1,"د",2,0],["وعلى دِمَشقَ ونهرِها وجِنانِها","وعلى حِمى العربيَّةِ العَرباء",2,"ا",2,0],["وعلى دارك غفران","ونور وأمان",3,"ن",1,0],["وَعَلى دَمعِيَ أَن يُنسيك","نَوء المرزمين",4,"ن",1,0],["وعليّ دون الحاسدين ونَبلِهم","دِرعان من فني ومن تجريبي",5,"ب",2,0],["وعلى دساترها تفور بمائها","فوراً حكى ذيل السحاب الممطر",6,"ر",1,0],["وَعَلى دَعائهم الرَعيةُ أَمّنت","وَقَد اِستجاب دُعاهمُ المَعبود",7,"د",1,0],["وعلى دعائمها سوابقهم","ولها العواسل والظّبا عَمَدُ",8,"د",1,0],["وعلى دَوْحك الحمائمُ في الرا","دِ يهزُّ القلوبَ منها الهديرُ",9,"ر",1,0],["وعلي دمعي في البلا متحجر","حتى ولو وقعت على الأرض السما",10,"م",2,0],["وعلى دجى وفراته قصِرَ الشذى","ما أشبه المقصور بالممدود",11,"د",1,0],["وعَلَى دَمِي غَادَرْتُ أَحمِلُ غُصَّتِي","لا شَيءَ زَادَ _على القَصِيدَةِ_ لا لا",12,"ل",2,0],["وعلى دون الحاسدين ونبلهم","درعان من فطني ومن تجريبي",13,"ب",2,0],["وعلى درب أزاهير الندى","يتجلى موطن العز الأغر",14,"ر",1,0],["وعلى دروب الخير فاسلك لا تكن","منّاعَ خيرٍ أو تكن طمّاعا",15,"ع",2,0],["وعلى دربهم مشينا حشودًا","بخطَى ثابتٍ وعزمٍ وثيق",16,"ق",1,0],["وعلى دوحة العناق تغنى","وفؤادي مولّه ما تخلّى",17,"ل",2,0],["وعلى دموعٍ لو جَرتْ في البيدِ","لانحلّتْ وسار الماءُ فوق الماءِ",18,"ا",2,0],["وعلى دُنُوِّ مَسَافةٍ رُسِمَت لنا","كَادَت تَبُوحُ بِسِرِّهَا الأَعطَارُ",19,"ر",1,0]]}