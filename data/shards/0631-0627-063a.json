{"poems":[[47,"أقصرا ليس شأني الإقصار","https://www.aldiwan.net/poem63558.html","الخفيف"],[202,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[358,"بلغا عني ربوع الصالحيه","https://www.aldiwan.net/poem39576.html","الرمل"],[463,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86972","الخفيف"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73953","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108897","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93865","الرمل"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67593","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102746","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83507","الخفيف"],[5038,"وشم الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=196717",""],[5500,"صفصاف","https://www.poetsgate.com/ViewPoem.aspx?id=188512",""],[5563,"مدعوجة العينين ( نبطية )","https://www.poetsgate.com/ViewPoem.aspx?id=212820",""],[5693,"دائما أنت بقلبي.","https://www.poetsgate.com/ViewPoem.aspx?id=34962",""]],"verses":[["راغِبٌ حينَ يَنطِقُ الوَفدُ عَن عَو","نٍ بِرَأيٍ أَو حُجَّةٍ تُستَعارُ",0,"ر",1,0],["راغبةٌ فيهِ على أنها","عن كلِّ بيتٍ في العُلا تَرغَبُ",1,"ب",1,0],["راغِباً فيما لَدى خالقهِ","مُعرضاً عَن زخرف الدُنيا الدَنيّه",2,"ي",2,0],["راغباً أن تُصْطَفَى من جِدّه","والفكاهاتِ بمدحٍ أو نسيبِ",3,"ب",1,0],["راغب في رَفاهة للأَهالي","بِسَداد في أَمرهم يَتصَرف",4,"ف",1,0],["راغا وزاغا وليس هذا ال","خداع من شيمة الصحاب",5,"ب",1,0],["راغب الخير غاب عني ولكن","خير خير البنين ما غاب عني",6,"ن",2,0],["راغنم الأنس وغن الدما","ليس يحلو الشرب من غير نغم",7,"م",1,0],["راغِبٌ في الفِداءِ بالنَّفسِ والأم","موالِ لو أن حادثاً مدفوعُ",8,"ع",1,0],["رَاغِبِينَ والعَفوُ عِندَ رَسُولِ اللهِ","مأمُولٌ لَم يُخَيَّب رَجَاءُ",9,"ا",2,0],["راغت بك الأهواء عن سنن الهدى","ولأنت عن نهج الشريعة أروغ",10,"غ",1,0],["راغِبٌ في الخُروجِ من دُنياهُ","عَلَّ يَلقاكِ بعدَها في المَآلِ",11,"ل",1,0],["راغتِ الْحسْناءُ لمّا لمتُها","رابَ روعي شزْرُ بنْتٍ تغْضبُ",12,"ب",1,0],["راغت إلي بلحظها وأظنه","مكثار مقو ساذج الأطراف",13,"ف",1,0],["راغبٍ بك خافقٍ ما به رغبتي","في هواك الحال معدومٍ سعدها",14,"د",3,0],["راغبا للوصل فيك","أينما زرت للبّي",15,"ب",2,0]]}