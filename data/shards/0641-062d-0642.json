042","الطويل"],[4525,"","https://poetry.dctabudhabi.ae/diwan/poem/124052","الطويل"],[4534,"","https://poetry.dctabudhabi.ae/diwan/poem/145386","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72406","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120521","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4845,"وللشعر ميزان تسمى عَروضَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=134973",""],[4929,"المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=199256",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5189,"أمنياتٍ","https://www.poetsgate.com/ViewPoem.aspx?id=196815",""],[5277,"حديث البواقي","https://www.poetsgate.com/ViewPoem.aspx?id=204610",""],[592,"ألا قل لذي جهلٍ بكل الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128798",""],[592,"رسائل أخوان الصفا والتودد","https://www.poetsgate.com/ViewPoem.aspx?id=128837",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[592,"إن الأمور التي الأعداء تبديها","https://www.poetsgate.com/ViewPoem.aspx?id=128826",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5413,"إنه الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=200596",""],[5720,"لأجلكَ أُستاذي","https://www.poetsgate.com/ViewPoem.aspx?id=199596",""],[5725,"أعود الخيزران","https://www.poetsgate.com/ViewPoem.aspx?id=210378",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5895,"هَلُمِّى أمَّ معبد خبرينا","https://www.poetsgate.com/ViewPoem.aspx?id=199856",""],[5910,"يا خُلَّةَ النَّفسِ","https://www.poetsgate.com/ViewPoem.aspx?id=206319",""],[5956,"أواصلُ الانجذاب إلى حياتي الجديدة بمدريد","https://www.poetsgate.com/ViewPoem.aspx?id=192079",""],[5956,"الفرق بين العربي وغيره","https://www.poetsgate.com/ViewPoem.aspx?id=192190",""],[5956,"دعاء","https://www.poetsgate.com/ViewPoem.aspx?id=192541",""],[5997,"سَرْجٌ وَأكْحَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=214284",""],[6152,"زائرة للحرم","https://www.poetsgate.com/ViewPoem.aspx?id=204734",""],[5724,"ربيعك للروح كالبلسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55133&r=&rc=0",""],[276,"إليهِ بهِ سبحانهُ أتوسلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59268&r=&rc=7",""],[5567,"المجد بابها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82078&r=&rc=131",""]],"verses":[["فَحُقَّ عَلَيهِمُ شُكرُ اِمتِعاضي","وَما خلقي اِمتِنانٌ بِامتِنانِ",0,"ن",1,0],["فحققت أن الكون باللَه قائم","وأيقنت أن اللَه للكون مبدع",1,"ع",1,0],["فَحَقِق ما أَشفَيتَ مِنهُ وَلَم يبل","وَكان خَلِيلَي عِدَّتي وَجَماليا",2,"ي",2,0],["فَحُقَّ أنْ يُتْلَى لها","لتركَبُنَّ طبقا",3,"ق",2,0],["فحقَّ لمثلي أن يقولَ لمثلها","فديناكَ منْ ربعٍ وإن زدتنا كربَا",4,"ب",2,1],["فَحَقُّ مَنْ حالَتُهُ هذِهِ","أَن يَنظُرَ المَولَى لهُ نَظرَه",5,"ر",2,0],["فحُقّ لسلمى أن تنوح فإنها","من العيش سمّاً ناقعاً تتجرَّع",6,"ع",1,0],["فحقَّرَ الدُّنيا وأزرى بها","وقالَ ما لي أنكرُ الواقعا",7,"ع",2,0],["فحقتْ الهجرة وهي مرّه","ما وصفتْ إلا لنفس حرّه",8,"ه",1,0],["فَحَقَّقْتَ الرَّجَاءَ","وَابْدَأْ مُحْسِناً وَأَكْمِلِ",9,"ل",1,0],["فحقِّقْ لها أمنيةً فيكَ تَستَعضْ","بها عن أمانٍ جمةٍ لم تُحقَّق",10,"ق",1,0],["فحقه حق مصان الحمى","وانما باطلهم في زهوق",11,"ق",1,0],["فحق لنفس أن تجن وأنها","تقطِّع من بعد الحنين أنينَها",12,"ه",2,0],["فحق علينا بل على الناسِ كلهم","مقابلةَ الإنعامِ ذا منكَ بالشكرِ",13,"ر",1,0],["فحقِّق رجائي فيك يا ربّ واكفني","شمات عدوّ أو إساءة صاحب",14,"ب",1,0],["فَحَقِّقْ فِي صَدَاقَتِهِ ظُنُوناً","وَإِنْ أَبْدَتْ ظَوَاهِرُهُ ارْتِيَابَا",15,"ب",2,0],["فحقّق هداك الله أسماءه العلى","ترى الاسم منها جامعاً للبقيّة",16,"ه",1,0],["فحقق رَجائي فيك يا غايَة المنى","وقل أَنتَ منافي الجنان مخلد",17,"د",1,0],["فَحَقِق رَجائي فيك يا غاية المنى","فانت لمن يَرجوك حصن مؤمل",18,"ل",1,0],["فحقُّه أَن أَرصُدَه","من كُلِّ سوءٍ قصدَه",19,"ه",1,0],["فحقّق ظنّنا وَاِختم بخيرٍ","وَعرّفنا نَوالك بالمزيدِ",20,"د",1,0],["فحققت ما قد كنت فيه مشككاً","وعاينت ما قد كان في سر خفية",21,"ه",1,0],["فَحَقَّ لَهُم بِالعِلمِ فَخرٌ وَسودد","وَسَوفَ تَراهُم في كَمالِ سَعادَةِ",22,"ه",1,0],["فَحُقَّ إيثارٍ ما أوتيتَ مِن أَرَبِ","وَجَلَّ مِقدارُ ما وَليتَ مِن رُتَبِ",23,"ب",1,0],["فحقّق منى الفنّ الجميل وأهله","فغيرك لا يسدي ومثلك من يسدي",24,"د",2,0],["فحَقِّقْ مُنتهَى ظَنّي وأظْفِرْ","يَدَيَّ فأنت مَسْؤولي وسُولي",25,"ل",2,0],["فحقّاً أنك المختار حقّاً","حريٌّ في أمانتنا حري",26,"ي",1,0],["فحققه ثم اسلك عليه فإنه","صراط قويم موصل للحقيقة",27,"ه",1,0],["فحقق ما حققته لك واثقاً","به لترى الإِشكال عنك بمعزل",28,"ل",1,0],["فحقٌّ على الأعيان صب دموعها","فقد مات عين الفضل بل شامة المجد",29,"د",1,0],["فحقيق لمثل بغداد أن تفخر","فيه وتفضل الأمصارا",30,"ر",2,0],["فحقَّ لبغداد البكاء وكيف لا","وقد فارقت فخر الوزارة نامقا",31,"ق",2,0],["فحقق رجائي فيك يا رب واكفِني","شماتَ عدوٍّ أو إسائةَ صاحبِ",32,"ب",1,0],["فحقيقٌ إذ تعرّضْتُ الى","عدِّ أوصافِك قصّرْتُ اضطرارا",33,"ر",2,0],["فَحَقَّهُ عَهدُ من لا أنتَ مُتَّهِمٌ","منه السَّدادَ ولا الإيثارُ مُتَّهِمُكْ",34,"ك",1,0],["فَحَقَّاً مَا تَرَكتُ عَلَيْهِ بَعْدي","ثناءً أعْجَزَ المُثنِينَ قَبلي",35,"ل",2,0],["فَحَقَّ للعلمِ أَن يُزْهى بِهِ فَرَحاً","وحقَّ للشعرِ أن يَشْدُو بِهِ طَرَبا",36,"ب",2,0],["فحقّاً إِلَيْكَ رحلْنا المهاري","تُقاسِمُنا جهدَ مَا قَدْ لَقِينا",37,"ن",2,0],["فحقرت أَفعال الرجال استهانة","وطببت آن السم في الماء ينفح",38,"ح",1,0],["فحق الحزن منك فقد قضينا","ونحن بإثركم قصد الكفات",39,"ت",1,0],["فَحَقُّ ذا اليَومَ أَولى","مِن حَقِّ خَمسينَ حاجَه",40,"ج",2,0],["فحقُّ المعالي أن تشُقَّ جُيوبَها","عليهِ وتنْعاهُ المكارمُ والفخرُ",41,"ر",1,0],["فحقّاً لمَلْكِ الحوْزِ يَشكو فِراقَهُ","فعَنْ غابه قد غابَ خيرُ بني الأُسْدِ",42,"د",1,0],["فحقق صورة لك أنت فيها","تجدها الروح حمراء الشفاه",43,"ه",1,0],["فحققوا ما كشفنا عنه واعتبروا","يا عصبة الحق يكفيكم ويكفيني",44,"ن",2,0],["فحقق الأمر والخلق اللذينِ هما","لله وافهم هي الأنوار والظُلَم",45,"م",1,0],["فحققوا يا إخوتي","ما قلته من النظام",46,"م",1,0],["فحقك في عمومك ذا وذا في","خصوصك عند أرباب السعود",47,"د",1,0],["فحققوا القول مني وافهموه ولا","تؤولوه ففي تأويله الداء",48,"ا",2,0],["فحقيقٌ عليّ أن أتلو القر","آن فيهن مُصبَحي ومسائي",49,"ا",2,0],["فحقق ولا تعجل حنانيك واتئد","وقل عل هذا كان إفكاً مزورا",50,"ر",2,0],["فحقق مانؤمل فيك يامن","سما في الخلق والعمل المجيد",51,"د",1,0],["فَحقّاً أُهنّيك يا اِبن الهداة","بيومٍ به كان نصب الأميرِ",52,"ر",1,0],["فحقّ أن نحتفي فيه ونكرمَهُ","فإنّه خيرُ مَن يُرجى من البشرِ",53,"ر",1,0],["فحُقَّ لي ولأمثالي الثّناءُ على","تلك الخِلال الّتِي جَمَّعْتَ في نَسَقِ",54,"ق",1,0],["فحق إذا أزهرن في صحن داره","ودرن على ما حول مرقده دورا",55,"ر",2,0],["فحقيق بأن يرانا وشيكاً","والذي بيننا، فديناه، غلوه",56,"ه",1,0],["فحق الهنا حقاً لها بك لا بها","فأنت إمام قمت أو أنت قاعد",57,"د",1,0],["فَحَقَّ عَلَينا كلّ وَقتٍ","دُعاءٌ عَظيمٌ يُوالى كَثيرا",58,"ر",2,0],["فَحَقُّ العُيونِ عَلى اِبنِ الأَشَج","جِ أَن لا يُفَتَّرُ تَقطارُها",59,"ر",3,0],["فحقيقٌ على الذي مثل هذا","أن يُنحَّى عن البلاد ويُنفى",60,"ف",2,0],["فحق على المضنَى أداءُ حقوقهم","بما أحمر من دمع على الربع سائل",61,"ل",1,0],["فحق له دعوى اجتهاد لأنه","هو البحر علماً زاخر اللج مزبد",62,"د",1,0],["فحقق رجاء ابن الخلوف فقلبه","سليم وحسن الظن فيك أسلم",63,"م",1,0],["فحقق فيك آمالي ووفّر","صلاة مدائحي وأنل مرادي",64,"د",2,0],["فحقق حسن ظني إن ظني","يحقق لي بأنك ذو اقتدار",65,"ر",1,0],["فحقق رجا ابن الخلوف فقلبه","يسلم وحسن الظن لي فيك أسلم",66,"م",1,0],["فَحقيقٌ مقْتى لهَا فهْيَ عُشٌّ","لعَتيقٍ ولأدلَم الرِّجْس نُصْبا",67,"ب",2,0],["فَحَقَ لي الآن أَن أُبدي التَشَكُر عَن","ما قَد أَبانَ مِن الأَلطافِ وَالنِعَمِ",68,"م",1,0],["فحقا لجسمي والهوى لو تنازعا","فؤادي ان يكوي الهوى منه مقودا",69,"د",2,0],["فحق للأكبد أن تشعلا","وحق للأعين أن تهملا",70,"ل",2,0],["فحقيرٌ نوءُ الجفون وما قَد","رُ جفون السحاب والأنواء",71,"ا",2,0],["فحقوقهم مهضومةٌ وديارهُمْ","مجتاحةُ يثوي بها الاقواءُ",72,"ا",2,0],["فحق هنا المولى بمكرمة أتى","بها مجده تبقى إلى آخر الدهر",73,"ر",1,0],["فحقق يا مهيمن فيك ظني","وسهل ما تعسر من أموري",74,"ر",2,0],["فحق أن أرثيه اذ صار عن","نفثة مصدور به صادرا",75,"ر",2,0],["فحقيق لنا بأنا نُهنّا","بولاكم ونشكر الجبّارا",76,"ر",2,0],["فحقّق لأحبابي المقاصد والهنا","وأصحبهمو التوفيق والعز والأمنا",77,"ن",2,0],["فحقُّ نيوزلندا وأُستراليا","بهم أن تشمخا عظماً وكبرا",78,"ر",2,0],["فحقق يا أمين الشرع حقي","بعلم منك عن رأي حميد",79,"د",1,0],["فحقّق حيثُ فسَّرَ لي منامي","وواصلني فنلتُ به مرامي",80,"م",2,0],["فحقِّق يا أخي نظراً إلى من","حمى بيتَ الولايةِ من بعيدِ",81,"د",1,0],["فحقق تنقل إن كنت بالحقٍّ حقه","ولا تعتمد إلا على من له المجد",82,"د",1,0],["فحقي يحلِّيني بما فيّ من قوى","وخلقي يحلِّيني بما يُوصَفُ البشر",83,"ر",1,0],["فحقق مقالاً شائعاً عنك في الملا","بانك قد أصبحت للحي راعيا",84,"ي",2,0],["فحقيقٌ قولي متي قلت أرّخ","كسفت بعدها بدور علوم",85,"م",1,0],["فَحَقِيقَةُ القَدَرِ الَّذِي حَارَ الوَرَى","في شَأنِهِ هوَ قُدرَةُ الرَّحمنِ",86,"ن",1,0],["فَحَقِيقَةُ الأزمَانِ نِسبَةُ حَادِثٍ","لِسِوَاهُ تِلكَ حَقِيقَةُ الأزمَانِ",86,"ن",1,0],["فَحَقِيقَةُ التَّجسِيمِ إن يَكُ عِندكُم","وَصفُ الإِلهش الخَالِقِ الدَّيَّانِ",86,"ن",1,0],["فحُقّ لقلبي أن يطولَ هُيَامُه","وحُقّ لطَرْفي أن يطيرَ منامُه",87,"م",2,0],["فحقيبة الآثار منه قد طفت","بمدامع الأحشاء والآماق",88,"ق",1,0],["فَحَقّاً أَيقَني لا صَبرَ عِندي","عَلَيهِ وَأَنتِ عِزهاةٌ صَبورُ",89,"ر",1,1],["فحق مدحى لهم طول الزمان وما","يفي بمدحي لهم في الشعر وافيه",90,"ي",2,0],["فَحَق لِأَهل المَجد أَن يَفرَحوا بِهِ","فَهَذا لِإِحياء المَجد أَول مَقصود",91,"د",1,0],["فَحقق رَجائي بِالأَماني وَالمُنى","فَإِن زَماني بِالوَفاء يُماطل",92,"ل",1,0],["فحققي القول ثم جوري","أو انصفي واتركي ملامي",93,"م",2,0],["فحق لأعراضها أن تزول","غداة يفارقها الجوهر",94,"ر",1,0],["فحق لها اهدا اللآلي تهانيا","تصاغ عقوداً في حلى النظم والنثر",95,"ر",1,0],["فحقق بتقدير الرواتب قصدنا","فانصافك المأمول غاية اصلها",96,"ل",3,0],["فحقّ لي والعُلا نبكي لفُرقتِهِ","عَنِ الحَبيب وعَن أهلٍ وعن دارِ",97,"ر",1,0],["فحقيق ان أورخه","كاظم بدر معاليها",98,"ي",3,0],["فحقرت نفساً لا تزال حقيرة","وصعرت خدا بالمذ