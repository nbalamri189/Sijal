id=188887",""],[5083,"طيَّاتُ العَبير","https://www.poetsgate.com/ViewPoem.aspx?id=53771",""],[3591,"سعيدة هذا الأسم مثلك فتان","https://www.poetsgate.com/ViewPoem.aspx?id=149424",""],[5156,"ألا أيها القوم المحبون ويحكم","https://www.poetsgate.com/ViewPoem.aspx?id=99144",""],[5174,"اللغة العربية بين الماضي والحاضر","https://www.poetsgate.com/ViewPoem.aspx?id=184935",""],[5190,"النيل يتحدث عن نفسه","https://www.poetsgate.com/ViewPoem.aspx?id=61840",""],[5213,"أصاتت باسمك الناعون جهرا","https://www.poetsgate.com/ViewPoem.aspx?id=170488",""],[5277,"طفوفٌ بغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=199895",""],[1021,"تبدى يملأ الناظر","https://www.poetsgate.com/ViewPoem.aspx?id=47834",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"ألا يا أيها الإنسان سمعا","https://www.poetsgate.com/ViewPoem.aspx?id=128822",""],[592,"سؤال فهل مفت من القوم ينظم","https://www.poetsgate.com/ViewPoem.aspx?id=128819",""],[592,"فليس بنظم مستقم ولم يكن","https://www.poetsgate.com/ViewPoem.aspx?id=128801",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5356,"همسُ اشتياقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=204474",""],[5381,"أعدّ اللهُ للشُّعراءِ ناراً","https://www.poetsgate.com/ViewPoem.aspx?id=214627",""],[5561,"عيد","https://www.poetsgate.com/ViewPoem.aspx?id=192900",""],[5626,"سمائي مثل عشبي","https://www.poetsgate.com/ViewPoem.aspx?id=189719",""],[5689,"هل طي عرفك لي يا نسمة السحر","https://www.poetsgate.com/ViewPoem.aspx?id=143428",""],[5742,"نفح العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=206890",""],[5811,"كتبت وقد أودى بمقلتي البكا","https://www.poetsgate.com/ViewPoem.aspx?id=181474",""],[5850,"عفتْ ذروة ٌ من أهلها فجفيرها","https://www.poetsgate.com/ViewPoem.aspx?id=19707",""],[5855,"الله أعلم أن الروح قد تلفت","https://www.poetsgate.com/ViewPoem.aspx?id=205588",""],[5906,"رسول وآل","https://www.poetsgate.com/ViewPoem.aspx?id=188071",""],[5913,"نجوى نسيم الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=177075",""],[5956,"إذا متّ مغشيّاً عليّ من الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=181919",""],[5956,"الفخر بالابن فراس","https://www.poetsgate.com/ViewPoem.aspx?id=192387",""],[5956,"شهر التأشيرة هو شهر النحس","https://www.poetsgate.com/ViewPoem.aspx?id=192787",""],[6093,"ألم تَرَ أن قلبيَ لا يتوبُ ( الوافر )","https://www.poetsgate.com/ViewPoem.aspx?id=176027",""],[6096,"من دون وداع","https://www.poetsgate.com/ViewPoem.aspx?id=177528",""],[6102,"صَنَم !!","https://www.poetsgate.com/ViewPoem.aspx?id=184433",""],[6127,"البطولة يصنعها فذٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=215168",""],[6142,"أهاشم هل للبيض سلة ثائر","https://www.poetsgate.com/ViewPoem.aspx?id=155748",""],[5001,"جاءت تسيّر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83394&r=&rc=0",""],[6320,"حَائِطُ الشَّجَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83619&r=&rc=0",""],[5190,"وصية شهيد فلسطيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78343&r=&rc=56",""]],"verses":[["فَما وَلَدَت أُمُّ المَكارِمِ مِثلَهُم","كِراماً وَلَم تَغلَط لَهُم بِلَئيمِ",0,"م",1,0],["فَما وَلَدَ الأَجارِبُ مِن تَميمٍ","نَظيرَهُمُ وَلا الشُعرُ الرُقابا",1,"ب",2,0],["فَما وَجَدونا بِالفُروقِ أُشابَةً","وَلا كُشُفاً وَلا دُعينا مَوالِيا",2,"ي",2,0],["فَما وَجِدَت وَجدي بِها أُمُّ واحِدٌ","بِواحِدِها ضُمَّت عَلَيهِ صَفائِحُ",3,"ح",1,0],["فَما وَجَدَت وَجدي بِها أُمُّ واحيدٍ","وَلا وَجَدَ النَهديُّ وَجدي عَلى هِندِ",4,"د",1,1],["فَما وَجَدَتكَ الحَربُ إِذ فُرَّ نابُها","عَلى الأَمرِ نَعّاساً عَلى كُلِّ مَرقَدِ",5,"د",1,0],["فَما وَعَدَ الظَنُّ إِلّا وَفى","وَلا قالَتِ النَفسُ إِلّا فَعَل",6,"ل",1,0],["فَما وَجَدَت كَوَجدي أُمُّ سَقبٍ","أَضَلَّتهُ فَرَجَّعَتِ الحَنينا",7,"ن",2,0],["فَما وَجَدوا فيكَ اِبنَ مَروانَ سَقطَةً","وَلا جَهلَةً في مَأزِقٍ تَستَكينُها",8,"ن",3,0],["فَما وَرَقُ الدُنيا بِباقٍ لِأَهلِهِ","وَلا شِدَّةُ البَلوى بِضَربَةِ لازِمِ",9,"م",1,0],["فَما وَصَلَتنا خُلَّةٌ كَوِصالِها","وَلا مَحَلتنا خُلَّةٌ كَمِحالِها",10,"ل",3,0],["فَمَا وَنَوا لِلحِمَى عَنْ وَاجِبٍ وَبَنَوْا","لِلمَجْدِ فِيهِ طِرَافاً كَانَ مَهدُومَا",11,"م",2,0],["فما وجه حرّ بالبياض يخيفها","ولا وجه عبد بالسواد يروعها",12,"ع",3,0],["فَما وَجَدَ الجيرانُ حَبلَ مُجاشِعٍ","وَفِيّاً وَلا ذا مِرَّةٍ في العَزائِمِ",13,"م",1,0],["فَما وَجَدَ الخِنزيرُ مِثلَ فِعالِنا","وَلا مِثلَ حَوضَينا جِبايَةَ مُجتَبي",14,"ب",2,0],["فَما وَجَدتُ لَكُم نِدّاً يُعادِلُكُم","وَما عَلِمتُ لَكُم في الناسِ مِن خَطَرِ",15,"ر",1,0],["فَما وَجَدوا عَبدَ العَزيزِ مُغَمَّراً","وَلا ذا سِقاطٍ عِندَ أَمرٍ يُحاوِلُه",16,"ل",2,0],["فَما وَجدٌ كَوَجدِكَ يَومَ قُلنا","عَلى رَبعٍ بِناظِرَةَ السَلامُ",17,"م",1,0],["فَمَا وَجَدُوهُمُ إلاَّ أدِيماً","يَرُدُّ مَوَاسِيَ المُتَحَيِفينَا",18,"ن",2,0],["فَما وَنينا وَما خِمنا وَما خَبَروا","مِنّا عِثاراً وَجُلُّ القَومِ قَد عَثَروا",19,"ر",3,0],["فما ورق الحمامة حين أبدت","خفا شجني سوى زرق اليمامهْ",20,"م",2,0],["فَمَا وفائي بِمَدْخُولٍ لكم أبداً","لكنَّه كَوَفَاءِ العِرقِ لِلْعُودِ",21,"د",1,0],["فَما وُجِدَ الإِنسانُ إِلّا لِيُفقَدا","وَما فُقِدَ الإِنسانُ إِلّا لِيوجَدا",22,"د",2,0],["فَما وَجَدتُ في زَمانِيَ رَجُلاً","وَقُلتُ هَل تُحِبُّها فَقالَ لا",23,"ل",2,0],["فَما وَجَدَت بِالمُنتَصى غَيرَ عانَةٍ","عَلى حَشرَجٍ يَضرِبنَهُ بِالحَوافِرِ",24,"ر",1,0],["فَما وَرَدَت روحَ اِمرِئٍ روحُهُ لَهُ","وَلا صَدَرَت عَن باخِلٍ وَهوَ باخِلُ",25,"ل",1,0],["فَما وَجَدَ الشافونَ مِثلَ دِمائِنا","شِفاءً وَلا الساقونَ مِن عَسَلِ النَحلِ",26,"ل",1,0],["فَما وَجَدوا لِلحَقِّ أَقرَبَ مِنهُمُ","وَلا مِثلَ وادي آلَ مَروانَ وادِيا",27,"ي",2,0],["فماؤُهُ مُرَوَّقٌ مُنَطَّفُ","مِثلَ السَّرابِ افتَرَّ عنه النَفْنَف",28,"ف",1,0],["فَما وَجَدتُ عَلى الأَحشاءِ أَوقَدَ مِن","دَمعٍ عَلى وَطَنٍ لي في سِوى وَطَني",29,"ن",2,0],["فَما وَجدُ مَغلوبٍ بِصَنعاءَ موثَقٍ","لِساقَيهِ مِن ثِقلِ الحَديدِ كُهولُ",30,"ل",1,1],["فَما وَجدُ أَعرابيَّةٍ قَذَفَت بِها","صُروفُ النَوى مِن حَيثُ لَم تَكُ ظَنَّتِ",31,"ت",1,1],["فما وجدوه إلا الخيرَ مَحْضاً","ولا اخْتاروه إلا مُوقِنينا",32,"ن",2,0],["فما وجفت تلك القلوبُ ولم تكن","كأخرى لها من هَدَّةِ الرُّعبِ زلزال",33,"ل",1,0],["فَما وَجدُ أَعرابِيَّةٍ بانَ دارُها","فَحَنَّت إِلى بانِ الحِجازِ وَرَندِهِ",34,"د",2,0],["فَما وِردُها إِلّا إِذا ما تَعَرَّضَت","نُجومٌ عَلى آثارِهِنَّ نُجومُ",35,"م",1,0],["فَما وَجَدَت إِلّا مَجَرَّ إِهابِهِ","وَإِلّا إِهاباً بِالقَفِيِّ مُقَدَّدا",36,"د",2,0],["فَما وَجَدتُ بِها شَيئاً أَلوذُ بِهِ","إِلّا الثُمامَ وَإِلّا مَوقِدَ النارِ",37,"ر",1,0],["فَما وُفِّقوا عِندَ إيرادِهِم","وَلا وُفِّقوا عِندَ إِصدارِهِم",38,"م",1,0],["فما وَهبْتِ الذي يَعرِفنَ مِن خِلَقٍ","لكن سمَحتِ بما يُنْكِرْنَ من دُرَرِ",39,"ر",1,0],["فَما وَجدَتُ مِن فِرقَةٍ عَرَبِيَّةٍ","كَفيلاً دَنا مِنّا أَعَزَّ وَأَنصَرا",40,"ر",2,0],["فما وردت روح امرىءٍ روحه له","ولا صدرت عن باخلٍ وهو باخل",41,"ل",1,0],["فَمَا وَلَدَ الأَبْكارُ والعَوْنُ مِثْلَهُ","بِنَجْدٍ ولا أَرْضٍ يَجِفُّ ثَراها",42,"ا",3,0],["فما وقيت وقد جاءته ميتته","وأي نفس بذاك الخطب لم تُجَأ",43,"ا",1,0],["فَمَا وَقَعَتْ عَيْنِي عَلَى غَيْرِ أَحْمَقٍ","غَوِيٍّ يَظُنُّ الْمَجْدَ في الرِّيِّ وَالْغِذَا",44,"ذ",2,0],["فَمَا وَجَدْتُ عَلَى الأَيَّامِ بَاقِيَةً","أَشْهَى إِلَى النَّفْسِ مِنْ حُرِّيَّةِ الْعَمَلِ",45,"ل",1,0],["فَمَا وَرْقَاءُ نَائِحَةٌ","عَلَى التَّرْجِيعِ مِنْ قُمْرِي",46,"ر",2,0],["فماؤُكِ سَلْسَالٌ وطَيْرُك صادِحٌ","وغُصْنُك ريّان ووَادِيك مُمْرع",47,"ع",1,0],["فما ولد الأبكار والعون مثله","بنجدٍ ولا أرضٍ يجف تراهَا",48,"ا",3,0],["فما وجدنا بحكم الله عاصية","لمحض قرباه معدودا من البرر",49,"ر",1,0],["فَما وَحَقك عَن ود زِيارتهُ","لَكن لِيزجر طَرفي وَالسهاد مَعا",50,"ع",2,0],["فما وقفوا ولا رَقُّوا لصَبْر","ولا رفعوا ولا سمعوا صوابي",51,"ب",2,0],["فَمَا وُفِّقتُمُ رَأياً ومَا ِإن","غَرَستُم في مَنَابِتِهَا النَّخِيلا",52,"ل",2,0],["فَما وَخَدَت كُومُ المَطيِّ بِراغِبٍ","وَلا راهِبٍ إِلّا بِمَدحِكُمُ تُحدا",53,"د",2,0],["فَما وَهدَةٌ ما بِها صَعدَةٌ","وَلا عَلَمٌ ما عَلَيهِ عَلَم",54,"م",1,0],["فما وجدت كوجدي أُم خشف","تغيب في مراتعه فضلاّ",55,"ل",2,0],["فَما وَلَدَتني حاضِنٌ حَنَفِيَّةٌ","عبيدِيَّةٌ تَسمُو إِلى الحسَبِ الجَزلِ",56,"ل",1,0],["فَما وَراءَ بَني فَضلٍ فَتَطلُبَهُ","غِنىً لِراجٍ وَلا عِزٌّ لِمُهتَضَمِ",57,"م",1,0],["فَما وَطَني أَرضٌ نَبَتْ بِفضائِلي","وَلَو كانَ فيها العَيشُ أَخضَرَ مُمرَعا",58,"ع",2,0],["فَما وَجَدَت إِلا المَدامِعَ مُؤنِساً","لذلِكَ في كلِّ الظُروفِ تُريقُها",59,"ق",3,0],["فَمَا وُجِدَتْ بِِمَضْيَعَةٍ لَدَيْهِ","وَلَكِنْ صَانَهَا صَوْنَ الْحُلِيِّ",60,"ي",1,0],["فَما وَطِئَ الحَصى مِثلُ اِبنِ سُعدى","وَلا لَبِسَ النِعالَ وَلا اِحتَذاها",61,"ا",3,0],["فَما وَلَدَتكِ مَريَمُ أُمُّ عِيسى","ولا رَبَّاكِ لُقمانُ الحَكِيمُ",62,"م",1,0],["فما وقتِ الآطامُ حلساً دلهمَساً","ولا حَمتِ الآجامُ ليثاً غضَنفرا",63,"ر",2,0],["فما وضَعُوا يوماً تُخوماً لملكِهم","وفي كلِّ فَتحٍ جارفٌ مُتَزاحم",64,"م",1,0],["فما وَقتُ الزّيارةِ مِنكَ هذا","وما كنّا لنأمَلَ أن نُزارا",65,"ر",2,0],["فما وَجدُ الفَرَزدق مِثلَ وَجدي","وقد ذكَرَ الهوى فبكى نوارا",65,"ر",2,0],["فَما ودعوني يوم جد رَحيلهم","وَلا زوّدوني نظرة المتزود",66,"د",1,0],["فَما وَلدت انثى ولا اشتملت عَلى","اجل وأَعلى منه قدرا واجمل",67,"ل",1,0],["فما ولدت في الارضحوا وأدم","بأشرف منه في الوجود وأمجدا",68,"د",2,0],["فَما وَجَد النِّضْوُ الطَّلِيحُ بَمِنْزِلٍ","رَأْى وِرْدَهُ فِي ساحَتَيْهِ وَمَرْعاهُ",69,"ا",2,0],["فما وأبيك بعدك غير طَرف","كليلٍ للرّدى طرفٍ كحيل",70,"ل",1,0],["فَما وَطِئت أَقدامُهم سبلَ عَزمه","وَلا سَلَكوا حزناً أليطاً ولا خبّا",71,"ب",2,0],["فما وثقتم ولا وثقنا","فحربنا طارف تليد",72,"د",1,0],["فَما وَصلُها إِلّا عَلى ذاتِ مِرَّةٍ","يُقَطِّعُ أَعناقَ النَواجي ضَريرُها",73,"ر",3,0],["فَما والاهُمُ إِلّا رَشيدٌ","وَلا عاداهُمُ غَيرُ الغَوِيِّ",74,"ي",1,0],["فما واحدٌ من آل عوفِ بن عامرٍ","بتاركِ مجدٍ أن يَرى فيه واحِدا",75,"د",2,0],["فماؤها ألفراتُ أُبصرُهُ","أُجاجَها والزلالُ أَشكلُها",76,"ل",3,0],["فما وطئته قطُّ أقدامُ بدعةٍ","ولا ضل منه حيث كان سليل",77,"ل",1,0],["فَما وَصفَهُ بِالَّذي","أَذا رُمتَ حَداً حَصَل",78,"ل",1,0],["فما وفى غير دمعي بعد بُعدِكُمُ","ولا شفى غير أماني تمنينا",79,"ن",2,0],["فما وَدْقُهَا إلا رغاء قلائص","لهن بما يهوى الفؤاد وخيد",80,"د",1,0],["فما وَفائِي برثِّ العَهدِ منتَكِثٍ","ولا هَوايَ بواهِي العَقْدِ مُنْصرِمِ",81,"م",1,0],["فما وجدتُ إلى أيَّامه سبباً","إلاَّ وجدتُ إلى نيل الغنى سببا",82,"ب",2,0],["فما وسْوَسَ للهمِّ","بصَدْر الشَّرب شيطان",83,"ن",1,0],["فما وَلَدَتْ أُمُّ المعالي لهم أخاً","وقد خابَ من يرجو نتاج العواقر",84,"ر",1,0],["فما وجدا السلطان مثلك ناصحاً","ولا وجد السلطان مثلك صادقا",85,"ق",2,0],["فما وجد الآباءُ من لطف صنعتها","عى قدم الأحيان ما أنكر الأبنا",86,"ن",2,0],["فما وَجَّهْتَهُ حتى حَكَمْنَا","هُنَالك بالغنيمةِ والإِيابِ",87,"ب",1,0],["فما وَجْدُُ ذِي أَسْرٍ بأَرْضٍ قَصِيَّةٍ","يُبَدَّلُها من أَرْبُعِ ومَغَانِ",88,"ن",1,0],["فما ولدتني يوم ذلك حرّة","ولا قام عني من بني آدم حر",89,"ر",1,0],["فما وهبت إلا وقد سلبت ولا","لنا ضحكت إِلا استحالت فأبكت",90,"ت",1,0],["فما وفت شيمة ملوّنةٌ","تُستنّ في غدرها وتُبتدعُ",91,"ع",1,0],["فما وَجَدُوا مَعْ طُولِ ما اجتهدوا له","فتىً عنه في جُلَّى تنوبُ ينوبُ",92,"ب",1,0],["فما واهِبٌ أبْقَتْ يداهُ ذخيرةً","كمن ما له غير المحامد من ذُخْرِ",93,"ر",1,0],["فما وجَدْتَ لِخَطْبٍ جَلَّ مِنْ ألَمٍ","إلاَّ وعنْديَ أضْعافُ الذي تَجِدُ",94,"د",1,0],["فما وريه أن اظلمَ الدهرُ آفلٌ","ولا رأيهُ أن أشكل الخطبُ فائل",95,"ل",1,0],["فَماؤُنا قَد دَرَّجَتهُ الصَبا","فَصارَ شاذَروانَهُ مِنهُ",96,"ن",2,0],["فما وَفى لي حبيبٌ كنتُ أعشَقُه","ولا صَفا لي خليلٌ كنتُ أُوثِرُهُ",97,"ر",2,0],["فما وجدوا في الناس من عمرُهُ كذا","ولم يك معتوقاً فحيرتهم فينا",98,"ن",2,0],["فَمَا وَحْشِيَّةٌ أَدْمَاءُ تَرْعَى","أَغَنَّ كَعَطْفَهِ الخَلْخَالِ ضَاوِي",99,"ي",1,0],["فَما وَدَّعنَني شُحاً وَجُودا","بِهِن فَما أشَحَّ وَما أضَنّا",100,"ن",2,0],["فَما وافَقُوا في العَدلِ غَيرَ مُوافِقٍ","ولا خالَفوا في الجَورِ غَيرَ مُخالف",101,"ف",1,0],["فَما وَشَمائِلِ الحَسَنِ بنِ مُوسَى","وَمِن حَوبايَ إلاّ غَيرَ باقِ",102,"ق",1,0],["فما وجدُ ظمئان حاد إلى","قرورٍ قرارتهُ أبطحُ",103,"ح",1,0],["فَما وَهَت همة الإِنصاف في زَمَن","حَبوتَنا لحظةً فيهِ بِأَنظار",104,"ر",1,0],["فَما وَجْدُ ثَكْلى أُمِّ فَرْدٍ أصابها","وَجِيُّ رَدىً فيهِ فأصبحَ ثاوِيا",105,"ي",2,0],["فما وردوا ماء السعادة مشربا","ولا كان من طير النجاح 