كَ أو قليلاً مِنْ حَلاكا",183,"ك",2,0],["فما وجدَ الرّنيمُ طريقَ قلْبي","ولكنْ بالنّوى يرْجوهُ حُلْمي",184,"م",2,0],["فَمَا وَجْدي عليها وَجْدُ خَبٍّ","ولا غَمْرٍ ولا غُرٍّ غَريرِ",185,"ر",1,0],["فما وجدت خود سواك صبابة","فما راقني بالغيد غيرك غزلان",186,"ن",1,0],["فما واحد منهم بواف لواحدٍ","وصاحبتي تجزي وفائي لها غدرا",187,"ر",2,0],["فماؤُها العلمُ والأخلاقُ تربتُها","إنْ تُحسنوا الزرعَ يعطِّ لبَّه الثمرُ",188,"ر",1,0],["فَمَا وَجَدتُ لِهَذَا الجِيلِ مِن شَبَهٍ","عَبرَ العُصُورِ بُطُولاتٍ ولا خُلُقَا",189,"ق",2,0],["فما وقع السهام الرقش منه","بأكباد الأنام أشد حرا",190,"ر",2,0],["فما وجدتُ سواكِ تحتوي وجعي","وما لقيتُ سواكِ من تداويني",191,"ن",2,0],["فما واصل جفني النو","م مذ أصبح لي هاجر",192,"ر",1,0],["فما وجه هذا الاعتراض بنفسه","وقد كان معلوماً لدى كل مستهد",193,"د",1,0],["فمأواه السعير غداً ويلقا","هنالك ما يسوء المشركينا",194,"ن",2,0],["فما وجه هذا من كتابٍ وسنة","أجيبوا على هذا السؤال وأفهموا",195,"م",3,0],["فما وجه إطلاق الكلام معمماً","لكل بتسليم لما دق أو جلل",196,"ل",1,0],["فما ورثوا للكذاب من كان يدعي","بأن له شطراً وللمصطفى شطرا",197,"ر",2,0],["فما وجدوا عذراً لمن كان كافراً","ولا وجدوا للمستغيث بهم عذرا",197,"ر",2,0],["فما وصف الرحمن جل جلاله","به نفسه قد كان حقاً مقدما",198,"م",2,0],["فما وصف الرحمن جل جلاله","به نفسه كان الصواب المقدما",198,"م",2,0],["فما وُجِدَتْ والخوفَ يوماً (لحكمةٍ)","ومن لم يَهِبْ سلماً لها فلهُ الإثمُ",199,"م",1,0],["فما وهِنوا ولا باعوا حِماهم","وما ضلّوا كما ضلّ النّصارى",200,"ر",2,0],["فما وقفتَ بدارٍ غيرُ آهلةٍ","إلّا وكانَ لهم ذِكْرٌ وتنهيد",201,"د",1,0],["فَما وَهَنَتْ سُيوفٌ في نِزالٍ","ولا عادَتْ كُفوفٌ خاوياتِ",202,"ت",1,0],["فما وقفت على بشرى تكفكف لي","فوق الخدود دموع اليأس والضجر",203,"ر",1,0],["فما وجدتُ من السلوان منتجعاً","ولا رويتُ من السحبِ الشآبيبِ",204,"ب",1,0],["فما وجدنا ملاذاً دون زخرفِها","ولاقميصَ الشفا من نجلِ يعقوب",204,"ب",1,0],["فما وردت لي نحوكم من رسالةٍ","وحقكم إلا وذاك سوداها",205,"ه",2,0],["فما وَصْلُها إلاّ على ذاتِ مِرّة","ٍ يقطعُ أعناقَ النواحي ضريرها",206,"ر",3,0],["فما وجدت بها طيفاً يكلمني","سوى نواح حمام في أعاليها",207,"ي",3,0],["فَما وَعْدُ رَبِّكَ زَهواً وَ ما","بِقُرآنِ رَبِّكَ هَزوٌ يُصَبْ",208,"ب",1,0],["فما وجدت سوى الساعات أحسبها","لا قرب منها ولا طيفٌ يسليني",209,"ن",2,0],["فما واحد منَا يعيش على السَّوا","ولكن لسوء الفهم يحيا على الغِوى",210,"و",2,0],["فما وجدتُ مثيلاً كاد يشبهكم","حتى الأساطير لم ترسم كما ولدي",211,"د",2,0],["فما وجه هذا النزوح علينا","سوى النحس فيه الردى المكفهرُّ",212,"ر",1,0],["فَمَا وَجَدَ الغريبُ أَعَزَّ منكم","كَأَنَّهُ في مَنازِلِكمْ قَرِيْبُ",213,"ب",1,0],["فما وفائي بعهدي جاءَ عن عَبثٍ","علّمْتَني مُثلاً ....جلّتْ معانيها",214,"ي",3,0],["فَما وَجَدتُ غَيرَ مُنهَزِمٍ","بِظُلمِهِ لِنَفسِهِ ظَلَما",215,"م",2,0],["فما وجدتَ بأهل الحي باقيةً","إلاكِ طوعةَ ما أسمى سجاياها",216,"ا",3,0],["فما وجدت من ضيغم نابه القنا","ولا من فنيق بالقواضب هادر",217,"ر",1,0],["فما وجدتك الا والصبا مزق","وزهرة الحب قد جفت بأشجاري",218,"ر",2,0],["فَمَا وَجَدْتُ لِنَيْلِ الثَّأْرِ خَاصِرَةً","تُزِيحُ عَنْ كَاهِلِي المَنْهُوكِ أَحْزَانِي",219,"ن",2,0],["فما وجَدْتُ سوى نفسي أقدِّمُها","للهِ ، لم يُثنِها عن عزمِها الخطَرُ",220,"ر",1,0]]}