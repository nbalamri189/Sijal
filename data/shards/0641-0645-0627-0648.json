جدوا من الختّان لمسا","ولا شحذ الحديد لهم وسنا",132,"ن",2,0],["فَمَا وَسِعَتْهُ الأرضُ حتى أرَاحَهُ","عن الفِكْرِ في اسْتِعْلامِ شأنِكَ نائِبُ",133,"ب",1,0],["فَما وَلَدَت حَوّاءُ مِن صُلبِ آدَمٍ","وَلا قَبِلَت مِن كُلِّ حَيٍّ قَوابِلُه",134,"ل",2,0],["فما وجد ذي وجد يبيت مسهداً","كوجدي ولا حالي يقاس به حال",135,"ل",1,0],["فما ولهانة فقدت بنيها","تنوح ودأبها أبداً عويل",136,"ل",1,0],["فما وصلت من جو عثير جوده","إلى الأرض إلا وهي قتلى على القتلى",137,"ل",2,0],["فما وسعَ الوجودُ جَلال ربِّي","ولكنْ كان في قلبِ العميدِ",138,"د",1,0],["فما وضع الميزان إلا بأرضه","هنا وبأرض الحشر والشانُ كالشان",139,"ن",1,0],["فما وفى بذاك فحاد عنه","إلى علمٍ يورثه السفودا",140,"د",2,0],["فما وجدنا مصاباً وقع جمرته","يشوي القلوب وفيها يحدث الجزعا",141,"ع",2,0],["فما وهبت الذي يغريك من خلق","لكن سمحت بما تحويه من درر",142,"ر",1,0],["فما وزعتهُ في الصبابة والهوى","ملامة لوام ولا نصح ناصح",143,"ح",1,0],["فما وجدَتْ بناتُ بني نزارٍ","حلائِلَ أسودِينَ وأحمْرينا",144,"ن",2,0],["فَما وَقفت يَداي عَلى كَريم","فَبَرق خلب وَسَراب قاع",145,"ع",1,0],["فما وجدوا طعم الاسنة والظبا","وما نالهم إلا سويقا وسكرا",146,"ر",2,0],["فَما وضعَ المَرء الحَسيب ولا ارتَقى","بِأَدنى الوَرى بيتا إِلى المَنزِل الأَعلى",147,"ل",2,0],["فَما وَاحد في الناس أَصبَح آمِنا","وَما أَن أَرى مِنكَ الغِواية تَنجَلي",148,"ل",2,0],["فما وجلي إن متَّ مستشهداً وإن","حللت بطون الطير أو كنت ملحداً",149,"د",2,0],["فَما وأخذتُهُ بَلْ قلتُ سُكراً","بساطُ الشكر يُطوى بعد نَشر",150,"ر",1,0],["فما وجدُ قلبي من فتور بلحظه","فيالك من ضعف الغرام وضعفه",151,"ف",2,0],["فما وطئت إلا على جُثث العدى","تُقُّ من الأعضاء ما ليس يُجبرُ",152,"ر",1,0],["فما وصلنا سورها إلا وقد","كاد فؤادي بمدى الهم يقد",153,"د",1,0],["فما وطئت إلا على خد سيد","ولا عثرت الا براس متوج",154,"ج",1,0],["فما وجدت مصرٌ على سالفٍ مضى","كما وجدت يوم المصاب به مصر",155,"ر",1,0],["فما وَلَدَتْ أُمّهاتُ الرِّجا","لِ مِثلكَ في العُربِ أَوفى العَجمْ",156,"م",1,0],["فَما وطِئَتْ فيها السيوفُ على طُلى","ولا هجَمَتْ منهُ الرِّياحُ على شِرْبِ",157,"ب",1,0],["فما وثقتْ بالبيدِ حتى تَسَنَّ