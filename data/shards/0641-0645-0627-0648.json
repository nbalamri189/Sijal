{"poems":[[53,"تألق نجدي كأن وميضه","https://www.aldiwan.net/poem29799.html","الطويل"],[53,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[3,"ألا قاتل الله الطلول البوالي","https://www.aldiwan.net/poem120.html",""],[34,"هبيني امرأ إن تحسنى فهو شاكر","https://www.aldiwan.net/poem4877.html","الطويل"],[34,"فما وجدت وجدي بها أم واحيد","https://www.aldiwan.net/poem4883.html","الطويل"],[9,"أترحل من ليلى ولما تزود","https://www.aldiwan.net/poem21924.html","الطويل"],[73,"هي الشمس مغربها في الكلل","https://www.aldiwan.net/poem11950.html","المتقارب"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[35,"سيأتي أمير المؤمنين ودونه","https://www.aldiwan.net/poem38819.html","الطويل"],[35,"لك الويل من عيني خبيب وثابت","https://www.aldiwan.net/poem38830.html","الطويل"],[35,"ألا يا لقومي للنوى وانفتالها","https://www.aldiwan.net/poem39092.html","الطويل"],[93,"أبيت والسيف يعلو الرأس تسليماً","https://www.aldiwan.net/poem11419.html","البسيط"],[88,"يدل على لؤم الغزالة أنها","https://www.aldiwan.net/poem44409.html","الطويل"],[27,"ألا حي ربع المنزل المتقادم","https://www.aldiwan.net/poem4453.html","الطويل"],[27,"عجبت لهاذا الزائر المترقب","https://www.aldiwan.net/poem5662.html","الطويل"],[27,"لجت أمامة في لومي وما علمت","https://www.aldiwan.net/poem5769.html","البسيط"],[27,"إليك كلفنا كل يوم هجيرة","https://www.aldiwan.net/poem5963.html","الطويل"],[27,"متى كان الخيام بذي طلوح","https://www.aldiwan.net/poem5991.html","الوافر"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[23,"زادت هموم فماء العين منحدر","https://www.aldiwan.net/poem21395.html","البسيط"],[72,"قوامك تحت شعرك يا أمامه","https://www.aldiwan.net/poem19681.html","الوافر"],[51,"يا ابن الوزيرين سمعا من أخي طلب","https://www.aldiwan.net/poem10000.html","البسيط"],[91,"فديناك لو ان الردى قبل الفدا","https://www.aldiwan.net/poem8811.html","عموديه"],[91,"يشرب بنت الكرم بعض الناس","https://www.aldiwan.net/poem8974.html","عموديه"],[38,"أحار بن عبد للدموع البوادر","https://www.aldiwan.net/poem7719.html","الطويل"],[43,"قفا تريا ودقي فهاتا المخايل","https://www.aldiwan.net/poem9986.html","الطويل"],[28,"رفعت لهم صوت المنادي فأبصروا","https://www.aldiwan.net/poem5473.html","الطويل"],[28,"لعمري لقد نبهت يا هند ميتا","https://www.aldiwan.net/poem5649.html","الطويل"],[61,"صب بغرات الصبا مكلف","https://www.aldiwan.net/poem51549.html","الرجز"],[44,"أراك أكبرت إدماني على الدمن","https://www.aldiwan.net/poem30331.html","البسيط"],[33,"فما وجد مغلوب بصنعاء موثق","https://www.aldiwan.net/poem25848.html","الطويل"],[33,"فما وجد أعرابية قذفت بها","https://www.aldiwan.net/poem25978.html","الطويل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"إليك أبا سفيان لا الوعد صادق","https://www.aldiwan.net/poem44202.html","الطويل"],[81,"يمثل لي نهج الصراط بوعده","https://www.aldiwan.net/poem61533.html","الطويل"],[22,"عفا الرس والعلياء من أم مالك","https://www.aldiwan.net/poem22014.html","الطويل"],[50,"ألم يأن أن تسلى مودة مهددا","https://www.aldiwan.net/poem63919.html","الطويل"],[7,"عوجوا فحيوا لنعم دمنة الدار","https://www.aldiwan.net/poem1998.html","البسيط"],[46,"إذا دارت الكأس في دارهم","https://www.aldiwan.net/poem23439.html","المتقارب"],[46,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[8,"خليلي عوجا ساعة وتهجرا","https://www.aldiwan.net/poem21785.html","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140818",""],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72229","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147452","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42597","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42727","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54824","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54275","الطويل"],[36,"أحجاج إن الله أعطاك غاية","https://www.poetsgate.com/ViewPoem.aspx?id=15897",""],[110,"لم أنس ليلة إذ مر الكرى غاطا","https://www.aldiwan.net/poem16477.html","البسيط"],[129,"رحلتم والمدامع في انسكاب","https://www.aldiwan.net/poem50663.html","الوافر"],[133,"أقلب لا يزال ولن يزولا","https://www.aldiwan.net/poem54776.html","الوافر"],[144,"علي لها أن أحفظ العهد والودا","https://www.aldiwan.net/poem11743.html","الطويل"],[144,"تفردت بالمجد دون الأمم","https://www.aldiwan.net/poem11809.html","المتقارب"],[161,"إِذا سفك الدماء لديك حلا","https://www.aldiwan.net/poem58931.html","الوافر"],[170,"إليكن عني فانصرفن على مهل","https://www.aldiwan.net/poem1643.html",""],[170,"أنخ فهذي قباب العز والكرم","https://www.aldiwan.net/poem1676.html",""],[183,"زمان الحمى هل من معاد فنطمعا","https://www.aldiwan.net/poem67052.html","الطويل"],[224,"بكت وهي صرعى من هموم تحيقها","https://www.aldiwan.net/poem41892.html","الطويل"],[238,"شربنا من سري يحمدي","https://www.aldiwan.net/poem19758.html","الوافر"],[250,"أتعرف من هنيدة رسم دار","https://www.aldiwan.net/poem2088.html","الوافر"],[263,"بللت علي لا حييت ثوبي","https://www.aldiwan.net/poem68190.html","الطويل"],[271,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[271,"هو الملك تبنيه الجيوش الخضارم","https://www.aldiwan.net/poem35646.html","الطويل"],[271,"أمن عربية تشتاق دارا","https://www.aldiwan.net/poem35647.html","الوافر"],[272,"ذروني أبكي بعد جيرة ثهمد","https://www.aldiwan.net/poem52052.html","الطويل"],[272,"قفا برياض الشعب شعب القرنفل","https://www.aldiwan.net/poem52096.html","الطويل"],[272,"سقاك الحيا الوسمى ربعا تأيدا","https://www.aldiwan.net/poem52098.html","الطويل"],[281,"هبوا طيفكم أعدى على النأي مسراه","https://www.aldiwan.net/poem60774.html","الطويل"],[282,"رعاك الله ذا الأجر الجزيل","https://www.aldiwan.net/poem1383.html",""],[306,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[329,"أقبل على موكب الحيارى","https://www.aldiwan.net/poem54967.html","مخلع البسيط"],[338,"عفت ذروة من أهلها فجفيرها","https://www.aldiwan.net/poem45429.html","الطويل"],[350,"إذا عصم التمسك من ظلال","https://www.aldiwan.net/poem16028.html","الوافر"],[372,"إذا قصد العوفي وجها من العلى","https://www.aldiwan.net/poem57496.html","الطويل"],[378,"نفس غدت قد عصاك أسهلها","https://www.aldiwan.net/poem59283.html","المنسرح"],[378,"وشاحك فخر في الأنام جليل","https://www.aldiwan.net/poem59286.html","الطويل"],[381,"لك الحمد يا من حصل","https://www.aldiwan.net/poem48754.html","مجزوء المتقارب"],[404,"أهلا بها فلقد وافت على ظمإ","https://www.aldiwan.net/poem33377.html","البسيط"],[404,"لعل زمانا بالوصال يجود","https://www.aldiwan.net/poem33976.html","الطويل"],[410,"أجب دواعي الهوى بالأدمع السجم","https://www.aldiwan.net/poem32535.html","البسيط"],[417,"ما غاب بدر دجى منكم ولا غربا","https://www.aldiwan.net/poem53990.html","البسيط"],[417,"بحيث انعطف البان","https://www.aldiwan.net/poem54026.html","الهزج"],[417,"أسرك من باد لعينيك حاضر","https://www.aldiwan.net/poem54066.html","الطويل"],[417,"دعاك أمير المؤمنين وإنما","https://www.aldiwan.net/poem54129.html","الطويل"],[422,"أدرها لنا صرفا ودع مزجها عنا","https://www.aldiwan.net/poem46357.html","الطويل"],[433,"تهز بك الخطوب من الخطاب","https://www.aldiwan.net/poem12383.html","الوافر"],[433,"غناء حمام في معاطف بان","https://www.aldiwan.net/poem12392.html","الطويل"],[438,"أجل قد تمادى الأمر وانصرم العمر","https://www.aldiwan.net/poem2542.html","الطويل"],[442,"عزاء فما نفس على الموت عزت","https://www.aldiwan.net/poem14440.html","الطويل"],[459,"هبت ومنها الخلاب والخدع","https://www.aldiwan.net/poem56139.html","المنسرح"],[459,"تزِل الليالي مرة وتصيب","https://www.aldiwan.net/poem56290.html","الطويل"],[462,"حباه إله العرش جودا ونجدة","https://www.aldiwan.net/poem16115.html","الطويل"],[462,"يا آل جعفر الفياض جودكم","https://www.aldiwan.net/poem16418.html","البسيط"],[465,"لقد سل سيفا والغدار الحمائل","https://www.aldiwan.net/poem3189.html","عموديه"],[469,"يا من إذا سري سرى نحوه","https://www.aldiwan.net/poem59577.html","السريع"],[515,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[559,"تمنيت لي عبدا ثمانون عمره","https://www.aldiwan.net/poem33724.html","الطويل"],[568,"رأيت الرياسة مقرونة","https://www.aldiwan.net/poem69475.html","المتقارب"]],"verses":[["فَما وَلَدَت أُمُّ المَكارِمِ مِثلَهُم","كِراماً وَلَم تَغلَط لَهُم بِلَئيمِ",0,"م",1,0],["فَما وَلَدَ الأَجارِبُ مِن تَميمٍ","نَظيرَهُمُ وَلا الشُعرُ الرُقابا",1,"ب",2,0],["فَما وَجَدونا بِالفُروقِ أُشابَةً","وَلا كُشُفاً وَلا دُعينا مَوالِيا",2,"ي",2,0],["فَما وَجِدَت وَجدي بِها أُمُّ واحِدٌ","بِواحِدِها ضُمَّت عَلَيهِ صَفائِحُ",3,"ح",1,0],["فَما وَجَدَت وَجدي بِها أُمُّ واحيدٍ","وَلا وَجَدَ النَهديُّ وَجدي عَلى هِندِ",4,"د",1,1],["فَما وَجَدَتكَ الحَربُ إِذ فُرَّ نابُها","عَلى الأَمرِ نَعّاساً عَلى كُلِّ مَرقَدِ",5,"د",1,0],["فَما وَعَدَ الظَنُّ إِلّا وَفى","وَلا قالَتِ النَفسُ إِلّا فَعَل",6,"ل",1,0],["فَما وَجَدَت كَوَجدي أُمُّ سَقبٍ","أَضَلَّتهُ فَرَجَّعَتِ الحَنينا",7,"ن",2,0],["فَما وَجَدوا فيكَ اِبنَ مَروانَ سَقطَةً","وَلا جَهلَةً في مَأزِقٍ تَستَكينُها",8,"ن",3,0],["فَما وَرَقُ الدُنيا بِباقٍ لِأَهلِهِ","وَلا شِدَّةُ البَلوى بِضَربَةِ لازِمِ",9,"م",1,0],["فَما وَصَلَتنا خُلَّةٌ كَوِصالِها","وَلا مَحَلتنا خُلَّةٌ كَمِحالِها",10,"ل",3,0],["فَمَا وَنَوا لِلحِمَى عَنْ وَاجِبٍ وَبَنَوْا","لِلمَجْدِ فِيهِ طِرَافاً كَانَ مَهدُومَا",11,"م",2,0],["فما وجه حرّ بالبياض يخيفها","ولا وجه عبد بالسواد يروعها",12,"ع",3,0],["فَما وَجَدَ الجيرانُ حَبلَ مُجاشِعٍ","وَفِيّاً وَلا ذا مِرَّةٍ في العَزائِمِ",13,"م",1,0],["فَما وَجَدَ الخِنزيرُ مِثلَ فِعالِنا","وَلا مِثلَ حَوضَينا جِبايَةَ مُجتَبي",14,"ب",2,0],["فَما وَجَدتُ لَكُم نِدّاً يُعادِلُكُم","وَما عَلِمتُ لَكُم في الناسِ مِن خَطَرِ",15,"ر",1,0],["فَما وَجَدوا عَبدَ العَزيزِ مُغَمَّراً","وَلا ذا سِقاطٍ عِندَ أَمرٍ يُحاوِلُه",16,"ل",2,0],["فَما وَجدٌ كَوَجدِكَ يَومَ قُلنا","عَلى رَبعٍ بِناظِرَةَ السَلامُ",17,"م",1,0],["فَمَا وَجَدُوهُمُ إلاَّ أدِيماً","يَرُدُّ مَوَاسِيَ المُتَحَيِفينَا",18,"ن",2,0],["فَما وَنينا وَما خِمنا وَما خَبَروا","مِنّا عِثاراً وَجُلُّ القَومِ قَد عَثَروا",19,"ر",3,0],["فما ورق الحمامة حين أبدت","خفا شجني سوى زرق اليمامهْ",20,"م",2,0],["فَمَا وفائي بِمَدْخُولٍ لكم أبداً","لكنَّه كَوَفَاءِ العِرقِ لِلْعُودِ",21,"د",1,0],["فَما وُجِدَ الإِنسانُ إِلّا لِيُفقَدا","وَما فُقِدَ الإِنسانُ إِلّا لِيوجَدا",22,"د",2,0],["فَما وَجَدتُ في زَمانِيَ رَجُلاً","وَقُلتُ هَل تُحِبُّها فَقالَ لا",23,"ل",2,0],["فَما وَجَدَت بِالمُنتَصى غَيرَ عانَةٍ","عَلى حَشرَجٍ يَضرِبنَهُ بِالحَوافِرِ",24,"ر",1,0],["فَما وَرَدَت روحَ اِمرِئٍ روحُهُ لَهُ","وَلا صَدَرَت عَن باخِلٍ وَهوَ باخِلُ",25,"ل",1,0],["فَما وَجَدَ الشافونَ مِثلَ دِمائِنا","شِفاءً وَلا الساقونَ مِن عَسَلِ النَحلِ",26,"ل",1,0],["فَما وَجَدوا لِلحَقِّ أَقرَبَ مِنهُمُ","وَلا مِثلَ وادي آلَ مَروانَ وادِيا",27,"ي",2,0],["فماؤُهُ مُرَوَّقٌ مُنَطَّفُ","مِثلَ السَّرابِ افتَرَّ عنه النَفْنَف",28,"ف",1,0],["فَما وَجَدتُ عَلى الأَحشاءِ أَوقَدَ مِن","دَمعٍ عَلى وَطَنٍ لي في سِوى وَطَني",29,"ن",2,0],["فَما وَجدُ مَغلوبٍ بِصَنعاءَ موثَقٍ","لِساقَيهِ مِن ثِقلِ الحَديدِ كُهولُ",30,"ل",1,1],["فَما وَجدُ أَعرابيَّةٍ قَذَفَت بِها","صُروفُ النَوى مِن حَيثُ لَم تَكُ ظَنَّتِ",31,"ت",1,1],["فما وجدوه إلا الخيرَ مَحْضاً","ولا اخْتاروه إلا مُوقِنينا",32,"ن",2,0],["فما وجفت تلك القلوبُ ولم تكن","كأخرى لها من هَدَّةِ الرُّعبِ زلزال",33,"ل",1,0],["فَما وَجدُ أَعرابِيَّةٍ بانَ دارُها","فَحَنَّت إِلى بانِ الحِجازِ وَرَندِهِ",34,"د",2,0],["فَما وِردُها إِلّا إِذا ما تَعَرَّضَت","نُجومٌ عَلى آثارِهِنَّ نُجومُ",35,"م",1,0],["فَما وَجَدَت إِلّا مَجَرَّ إِهابِهِ","وَإِلّا إِهاباً بِالقَفِيِّ مُقَدَّدا",36,"د",2,0],["فَما وَجَدتُ بِها شَيئاً أَلوذُ بِهِ","إِلّا الثُمامَ وَإِلّا مَوقِدَ النارِ",37,"ر",1,0],["فَما وُفِّقوا عِندَ إيرادِهِم","وَلا وُفِّقوا عِندَ إِصدارِهِم",38,"م",1,0],["فما وَهبْتِ الذي يَعرِفنَ مِن خِلَقٍ","لكن سمَحتِ بما يُنْكِرْنَ من دُرَرِ",39,"ر",1,0],["فَما وَجدَتُ مِن فِرقَةٍ عَرَبِيَّةٍ","كَفيلاً دَنا مِنّا أَعَزَّ وَأَنصَرا",40,"ر",2,0],["فما وردت روح امرىءٍ روحه له","ولا صدرت عن باخلٍ وهو باخل",41,"ل",1,0],["فَمَا وَلَدَ الأَبْكارُ والعَوْنُ مِثْلَهُ","بِنَجْدٍ ولا أَرْضٍ يَجِفُّ ثَراها",42,"ا",3,0],["فما وقيت وقد جاءته ميتته","وأي نفس بذاك الخطب لم تُجَأ",43,"ا",1,0],["فَمَا وَقَعَتْ عَيْنِي عَلَى غَيْرِ أَحْمَقٍ","غَوِيٍّ يَظُنُّ الْمَجْدَ في الرِّيِّ وَالْغِذَا",44,"ذ",2,0],["فَمَا وَجَدْتُ عَلَى الأَيَّامِ بَاقِيَةً","أَشْهَى إِلَى النَّفْسِ مِنْ حُرِّيَّةِ الْعَمَلِ",45,"ل",1,0],["فَمَا وَرْقَاءُ نَائِحَةٌ","عَلَى التَّرْجِيعِ مِنْ قُمْرِي",46,"ر",2,0],["فماؤُكِ سَلْسَالٌ وطَيْرُك صادِحٌ","وغُصْنُك ريّان ووَادِيك مُمْرع",47,"ع",1,0],["فما ولد الأبكار والعون مثله","بنجدٍ ولا أرضٍ يجف تراهَا",48,"ا",3,0],["فَما وَحَقك عَن ود زِيارتهُ","لَكن لِيزجر طَرفي وَالسهاد مَعا",49,"ع",2,0],["فما وقفوا ولا رَقُّوا لصَبْر","ولا رفعوا ولا سمعوا صوابي",50,"ب",2,0],["فَمَا وُفِّقتُمُ رَأياً ومَا ِإن","غَرَستُم في مَنَابِتِهَا النَّخِيلا",51,"ل",2,0],["فَما وَخَدَت كُومُ المَطيِّ بِراغِبٍ","وَلا راهِبٍ إِلّا بِمَدحِكُمُ تُحدا",52,"د",2,0],["فَما وَهدَةٌ ما بِها صَعدَةٌ","وَلا عَلَمٌ ما عَلَيهِ عَلَم",53,"م",1,0],["فما وجدت كوجدي أُم خشف","تغيب في مراتعه فضلاّ",54,"ل",2,0],["فَما وَلَدَتني حاضِنٌ حَنَفِيَّةٌ","عبيدِيَّةٌ تَسمُو إِلى الحسَبِ الجَزلِ",55,"ل",1,0],["فَما وَراءَ بَني فَضلٍ فَتَطلُبَهُ","غِنىً لِراجٍ وَلا عِزٌّ لِمُهتَضَمِ",56,"م",1,0],["فَما وَطَني أَرضٌ نَبَتْ بِفضائِلي","وَلَو كانَ فيها العَيشُ أَخضَرَ مُمرَعا",57,"ع",2,0],["فَما وَجَدَت إِلا المَدامِعَ مُؤنِساً","لذلِكَ في كلِّ الظُروفِ تُريقُها",58,"ق",3,0],["فَمَا وُجِدَتْ بِِمَضْيَعَةٍ لَدَيْهِ","وَلَكِنْ صَانَهَا صَوْنَ الْحُلِيِّ",59,"ي",1,0],["فَما وَطِئَ الحَصى مِثلُ اِبنِ سُعدى","وَلا لَبِسَ النِعالَ وَلا اِحتَذاها",60,"ا",3,0],["فَما وَلَدَتكِ مَريَمُ أُمُّ عِيسى","ولا رَبَّاكِ لُقمانُ الحَكِيمُ",61,"م",1,0],["فما وقتِ الآطامُ حلساً دلهمَساً","ولا حَمتِ الآجامُ ليثاً غضَنفرا",62,"ر",2,0],["فما وضَعُوا يوماً تُخوماً لملكِهم","وفي كلِّ فَتحٍ جارفٌ مُتَزاحم",63,"م",1,0],["فما وَقتُ الزّيارةِ مِنكَ هذا","وما كنّا لنأمَلَ أن نُزارا",64,"ر",2,0],["فما وَجدُ الفَرَزدق مِثلَ وَجدي","وقد ذكَرَ الهوى فبكى نوارا",64,"ر",2,0],["فَما ودعوني يوم جد رَحيلهم","وَلا زوّدوني نظرة المتزود",65,"د",1,0],["فَما وَلدت انثى ولا اشتملت عَلى","اجل وأَعلى منه قدرا واجمل",66,"ل",1,0],["فما ولدت في الارضحوا وأدم","بأشرف منه في الوجود وأمجدا",67,"د",2,0],["فَما وَجَد النِّضْوُ الطَّلِيحُ بَمِنْزِلٍ","رَأْى وِرْدَهُ فِي ساحَتَيْهِ وَمَرْعاهُ",68,"ا",2,0],["فما وأبيك بعدك غير طَرف","كليلٍ للرّدى طرفٍ كحيل",69,"ل",1,0],["فَما وَطِئت أَقدامُهم سبلَ عَزمه","وَلا سَلَكوا حزناً أليطاً ولا خبّا",70,"ب",2,0],["فما وثقتم ولا وثقنا","فحربنا طارف تليد",71,"د",1,0],["فَما وَصلُها إِلّا عَلى ذاتِ مِرَّةٍ","يُقَطِّعُ أَعناقَ النَواجي ضَريرُها",72,"ر",3,0],["فَما والاهُمُ إِلّا رَشيدٌ","وَلا عاداهُمُ غَيرُ الغَوِيِّ",73,"ي",1,0],["فما واحدٌ من آل عوفِ بن عامرٍ","بتاركِ مجدٍ أن يَرى فيه واحِدا",74,"د",2,0],["فماؤها ألفراتُ أُبصرُهُ","أُجاجَها والزلالُ أَشكلُها",75,"ل",3,0],["فما وطئته قطُّ أقدامُ بدعةٍ","ولا ضل منه حيث كان سليل",76,"ل",1,0],["فَما وَصفَهُ بِالَّذي","أَذا رُمتَ حَداً حَصَل",77,"ل",1,0],["فما وفى غير دمعي بعد بُعدِكُمُ","ولا شفى غير أماني تمنينا",78,"ن",2,0],["فما وَدْقُهَا إلا رغاء قلائص","لهن بما يهوى الفؤاد وخيد",79,"د",1,0],["فما وَفائِي برثِّ العَهدِ منتَكِثٍ","ولا هَوايَ بواهِي العَقْدِ مُنْصرِمِ",80,"م",1,0],["فما وجدتُ إلى أيَّامه سبباً","إلاَّ وجدتُ إلى نيل الغنى سببا",81,"ب",2,0],["فما وسْوَسَ للهمِّ","بصَدْر الشَّرب شيطان",82,"ن",1,0],["فما وَلَدَتْ أُمُّ المعالي لهم أخاً","وقد خابَ من يرجو نتاج العواقر",83,"ر",1,0],["فما وجدا السلطان مثلك ناصحاً","ولا وجد السلطان مثلك صادقا",84,"ق",2,0],["فما وجد الآباءُ من لطف صنعتها","عى قدم الأحيان ما أنكر الأبنا",85,"ن",2,0],["فما وَجَّهْتَهُ حتى حَكَمْنَا","هُنَالك بالغنيمةِ والإِيابِ",86,"ب",1,0],["فما وَجْدُُ ذِي أَسْرٍ بأَرْضٍ قَصِيَّةٍ","يُبَدَّلُها من أَرْبُعِ ومَغَانِ",87,"ن",1,0],["فما ولدتني يوم ذلك حرّة","ولا قام عني من بني آدم حر",88,"ر",1,0],["فما وهبت إلا وقد سلبت ولا","لنا ضحكت إِلا استحالت فأبكت",89,"ت",1,0],["فما وفت شيمة ملوّنةٌ","تُستنّ في غدرها وتُبتدعُ",90,"ع",1,0],["فما وَجَدُوا مَعْ طُولِ ما اجتهدوا له","فتىً عنه في جُلَّى تنوبُ ينوبُ",91,"ب",1,0],["فما واهِبٌ أبْقَتْ يداهُ ذخيرةً","كمن ما له غير المحامد من ذُخْرِ",92,"ر",1,0],["فما وجَدْتَ لِخَطْبٍ جَلَّ مِنْ ألَمٍ","إلاَّ وعنْديَ أضْعافُ الذي تَجِدُ",93,"د",1,0],["فما وريه أن اظلمَ الدهرُ آفلٌ","ولا رأيهُ أن أشكل الخطبُ فائل",94,"ل",1,0],["فَماؤُنا قَد دَرَّجَتهُ الصَبا","فَصارَ شاذَروانَهُ مِنهُ",95,"ن",2,0],["فما وَفى لي حبيبٌ كنتُ أعشَقُه","ولا صَفا لي خليلٌ كنتُ أُوثِرُهُ",96,"ر",2,0],["فما وجدوا في الناس من عمرُهُ كذا","ولم يك معتوقاً فحيرتهم فينا",97,"ن",2,0],["فَمَا وَحْشِيَّةٌ أَدْمَاءُ تَرْعَى","أَغَنَّ كَعَطْفَهِ الخَلْخَالِ ضَاوِي",98,"ي",1,0]]}