Poem.aspx?id=177835",""],[5732,"البارحه يازبن بالقلب هوجاس","https://www.poetsgate.com/ViewPoem.aspx?id=177848",""],[5739,"روس ٍ تمسس في عمايمها ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131547",""],[5739,"زارع وخرّاف ..!","https://www.poetsgate.com/ViewPoem.aspx?id=145118",""],[5739,"عيال الشياطين ...!","https://www.poetsgate.com/ViewPoem.aspx?id=145120",""],[5748,"بادر الكاس على علم بها","https://www.poetsgate.com/ViewPoem.aspx?id=26163",""],[5749,"جنون البقر وحماق البشر","https://www.poetsgate.com/ViewPoem.aspx?id=28718",""],[5749,"الارض في خطر","https://www.poetsgate.com/ViewPoem.aspx?id=203716",""],[5756,"اقرب الناس","https://www.poetsgate.com/ViewPoem.aspx?id=5436",""],[5792,"يا ظالمة","https://www.poetsgate.com/ViewPoem.aspx?id=180335",""],[5801,"حُب الناس","https://www.poetsgate.com/ViewPoem.aspx?id=188006",""],[5862,"الفعايل أصيله","https://www.poetsgate.com/ViewPoem.aspx?id=34140",""],[5866,"لا والله الا وصلوها مواصيل","https://www.poetsgate.com/ViewPoem.aspx?id=182873",""],[5906,"تشطير .. شطر البيت للدكتور فريد مسعود","https://www.poetsgate.com/ViewPoem.aspx?id=187977",""],[5956,"أخَّرْتُ في أغلى الصحاب قصائدي","https://www.poetsgate.com/ViewPoem.aspx?id=214991",""],[6008,"الصدر ضاق","https://www.poetsgate.com/ViewPoem.aspx?id=59160",""],[6056,"خشف المها","https://www.poetsgate.com/ViewPoem.aspx?id=130384",""],[6115,"الروس نعرفها وندري بالاذيال","https://www.poetsgate.com/ViewPoem.aspx?id=180493",""],[6115,"يرجع على الماضي وعادة حليمه","https://www.poetsgate.com/ViewPoem.aspx?id=181803",""],[6115,"البارحه ضيعت دربي فالطريق البارحه","https://www.poetsgate.com/ViewPoem.aspx?id=196457",""],[658,"نأس فما مصابك كالمصاب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=603756",""],[402,"هل حمى أنتم بنوه يضام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54060&r=&rc=912",""]],"verses":[["نَأسى عَلَيكِ إِذا حُثَّت مُشَعشَعَةً","فينا الشَمولُ وَغَنّانا مُغَنّينا",0,"ن",2,0],["نَأْسَى وَنَيْأَسُ حُزْناً","وَلَيْسَ فِي اليَدِ حِيلَهْ",1,"ل",2,0],["نَأْسَى إِذَا وَدَّعَتْنَا الشَّمْسُ فِي الطَّفَلِ","فَكَيْفَ مَنْ لاَ نُلاَقِيهِ إِلى الأَزَلِ",2,"ل",1,1],["ناسبت في كلِّ عامٍ من عوارفه","مواسمَ الفضل أرويها وترويني",3,"ن",2,0],["نَأسوا الجَرحى أَنّى وُجِدوا","وَنُداوي مِن جَرحِ الزَمَنِ",4,"ن",1,0],["ناسٍ مِنَ الجُودِ ما يجودُ به","وذَاكِرٌ منه كُلَّ ما وَجَدا",5,"د",2,0],["ناسخٌ راسخُ الروا","دِفِ والخصرُ قدْ طفا",6,"ف",2,1],["ناسٌ إِذا نَسَكوا عُدّوا مَلائِكَةً","وَإِن طَغَوا فَهُمُ جِنٌّ عَفاريتُ",7,"ت",1,0],["نَاسِجَاتٌ مُوَشِّيَاتٌ عَطَايَا","هُنَّ سِرّاً وَاللاَّبِسُ النَّمَّامُ",8,"م",1,0],["نَأْسُو بِهِنَّ خلائقاً","دارَتْ عَليْهِنَّ الدَّوائرْ",9,"ر",1,0],["ناسبتْ غُرَّ ثناياه التي","قد صفا جوهرهنَّ القَرْقَف",10,"ف",1,0],["ناسخ بالكتاب امي خط","ليس يحوى لوح الوجود مثاله",11,"ل",2,0],["ناسٌ خلعت الهوى عليهم","إنى لنسيح الهوى أجيد",12,"د",1,0],["ناسٌ سَواسَية يَضْنَى الكريمُ بهمْ","حتى كأنهمُ الأوصاب والسَّقَم",13,"م",1,0],["نأسو برؤياك ما اساء بنا","لا يصلح القرح غير مرهمه",14,"م",2,0],["ناسبتُها وَنَسَبتُ في شِعري بها","فاِعجب لحُسن نَسيبها لنَسيبها",15,"ب",3,0],["ناس لرحلته ناس لنقلته","إلى القبور التي تعيا بها الحيل",16,"ل",1,0],["ناسِجاً لِلدَوح مِن إِستَبرَق","حللاً خضرا وَأُخرى سُندسيّه",17,"ي",2,0],["نأسى على المعدوم من أعراضها","والشأنُ لو متعتَ بالموجود",18,"د",1,0],["ناسياً مذهب الوفاق وما","أنساه إلا اشتغاله بالخلاف",19,"ف",1,0],["ناسياً ما قالهُ بالأمسِ جدٌّ","مدَّ ما هدَّ فجدَّ ما ورِثتا",20,"ت",2,0],["ناسٌ هُمُ الأَعلامُ في أَقوامِهِمْ؛","لكنَّهم مَرِغُوا بِطِينِ ثَرَاها!",21,"ا",3,0],["ناسبت افضل أسرة في مصر بل","في الشام شهرتها أبجل وأشرف",22,"ف",1,0],["نأسَى علَى الدُّنيا وَظاهِرُ عَيشِها","ظِلُّ وَباطِنُهُ المُمَوَّهُ زُخرُفُ",23,"ف",1,0],["ناسٍ لما يَلْزَمُهُ حِفْظُهُ","وهو لما يَنْسىَ الفتى ذاكرُ",24,"ر",1,0],["ناسِياً ثَمَّ لَدَيها أهلَهُ","ذاهِلاً عَن كلِّ خِدنٍ وَخَليل",25,"ل",1,0],["نأسى بمأدُبَة َالأسَى لا خطوَ في","هذي الخطى لا شيءَ في الأشيَاءِ",26,"ا",2,0],["ناس سموا بسمات ساد أيسرها","أحامس الناس لم تطمس لهم سبل",27,"ل",1,1],["ناسٌ وإن عاملتهم فذئابُ","وإذا طلبت نوالهُم فكِلابُ",28,"ب",1,1],["ناسَمْتُه فتَلقَّتْني سمائمُهُ","ليتَ الجَفاء كفاءٌ منه للنِّعَمِ",29,"م",1,0],["ناسوك صومعة الهدى","ماسوك سلسلة العرى",30,"ر",2,0],["ناسَيتُهُم بَغضاءَهُم وَتَرَكتُهُم","وَهُم إِذا ذُكِرَ الصَديقُ أَعادي",31,"د",2,0],["ناسخاً قبله لتوراة موسى","ولسفرِ المسيح بعد زمانِ",32,"ن",1,0],["ناسم الأقدار في أفلاكها","وأخاف الليث في ظل العرين",33,"ن",1,0],["ناسكٌ زِنْدُهُ من السُّهدِ وارٍ","وعن الصلحِ خطوه غيرُ وَانِ",34,"ن",1,0],["ناسخ حقق المحبة عندي","بعذار وسالف ريحاني",35,"ن",2,0],["ناسياً أن لي شباباً أضحي","فيه حُبَّ الهوى بغير تقاة",36,"ه",1,0],["نَاسَبَ هَذَا قَولَهَمُ بلا غَلَط","كُلُّ إنَا يَنضَح بما فيه فَقًط",37,"ط",1,0],["ناسفات بنارها غائصات","في بطون البحار عرضاً وطولا",38,"ل",2,0],["ناسٌ إذا الدّاعي دعا لمُلمّة","لبّاه منهم كلّ أغلب مُخدِر",39,"ر",1,0],["ناسب بنظمك ما بين الزهور تفز","بالمبهجين معاً رصف وتكوين",40,"ن",1,0],["ناسٍ ما هوب لْحَد معلوم","عانيهم ايذا ياهم استرّ",41,"ر",1,0],["ناسي على الشرق الرخى","ما زال في رق وضيق",42,"ق",1,0],["ناست دواليها ثرياتها","أعنابها سبحان من ينضد",43,"د",1,0],["ناسخ برد هذه المنظومة","دامت عليه النعم العظيمة",44,"ه",1,0],["ناسٌ بهم يحيا الغرام وصبرنا","ألفى الفتى شجناً بمن في البان",45,"ن",1,0],["ناسوتُه طاهرٌ والبرَ ناسبهُ","لاهوتهُ ظاهرٌ والسرّ كالعلمِ",46,"م",1,0],["ناسي الأحبة غير من يسلوهم","حكم المقصر غير حكم المقصر",47,"ر",1,1],["ناسياً ما وراءَهُ كُلَّ يومٍ","قادماً في الوَرَى إلى قُدَّامِ",48,"م",1,0],["نأسى على عز الخلافة بعدما","دارت عليه دوائر المقدار",49,"ر",1,0],["ناسبت ما أوتيته من رتبةٍ","وتكافأ العقد البهي وجيده",50,"د",2,0],["ناسِكٌ في اللَيلِ يَدعو وَيُعيد","هامَ وَجداً بِالَّذي صاغَ السَحَر",51,"ر",1,0],["ناسَقني الوصْل فهنَّيتهُ","ميقات موسى فات بالصَّدِّ",52,"د",1,1],["ناسَبَك المِسك في السواد وَفي الر","رِيحِ فأَكرم بِذاكَ مِن نسَبِ",53,"ب",1,0],["ناسمٌ عن أريجٍ مسكٍ زكيِّ","في لماهُ وباسمٌ عن جُمانِ",54,"ن",1,0],["ناسي المعاد بحشره وحسابه","وصراطه وجحيمه وسؤاله",55,"ل",2,0],["ناسٌ بهم يحيا الغرا","م وصبرنا ألفى الفنا",56,"ن",2,0],["ناسٌ، ولكنْ لا أنيسَ بهم","ومدينةٌ، لكن