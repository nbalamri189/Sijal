{"poems":[[88,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[63,"عفر الظباء لدى الكثيب الأعفر","https://www.aldiwan.net/poem51686.html","الكامل"],[15,"يا خليلي اربعا واستخبرا المنزل","https://www.aldiwan.net/poem45251.html","الرمل"],[146,"هل تعرف الحسناء تفخر","https://www.aldiwan.net/poem58354.html","مجزوء الكامل"],[185,"يا صاحبى قفا على الأطلال","https://www.aldiwan.net/poem58842.html","الكامل"],[259,"لا تعاتبني","https://www.aldiwan.net/poem24961.html","مجزوء الرمل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39184","الكامل"],[967,"","https://poetry.dctabudhabi.ae/diwan/poem/33105","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124724","الخفيف"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36549","الدوبيت"],[4767,"سر الكون","https://www.poetsgate.com/ViewPoem.aspx?id=204763",""]],"verses":[["ثُمَّ اِكتُبي فَوقَ لَوحٍ","لِكُلِّ قاصٍ وَداني",0,"ي",1,0],["ثم اكتسَتْ خَفَرَ الحَياء فخبَّرَتْ","وَجَناتُها عن ذِمَّةٍ لم تُخْفَرِ",1,"ر",1,0],["ثُمَّ أَكدى وُدُّهُم أَن أَزمَعوا ال","بَينَ وَالأَيّامُ حالٌ بَعدَ حالِ",2,"ل",1,0],["ثم اكتست بغِلالةٍ","إما عَرارٍ أو شقيقِ",3,"ق",1,0],["ثمَّ اكتَهَلت وكادَ يَفطُرُ ناجِذِى","جَعَلَت تَصُدُّ البُزلُ حَولَ نِزَالى",4,"ل",2,0],["ثم أكْدى في صباهُ","إذ قضى نَحْباً قصيرا",5,"ر",2,0],["ثُمَّ اكْسُ جِسْمَكَ ثَوْبَ مُقْتَصِدٍ","فالدُّرُّ لَيْسَ يُشِيْنُهُ الصَّدَفُ",6,"ف",1,0],["ثُمَّ أَكفَأتُ فَوقَها جَفنَةَ الحَيِّ","وَعَلَّقتُ صَحفَتي في زَبيلِ",7,"ل",1,0],["ثم أكثر من ذكرك الله يصلح","ذكركَ الله منكَ حالا فحالا",8,"ل",2,0],["ثم أكتَروا سبعاً من الجمال","تحملهم في الخبتِ والرمال",9,"ل",1,0],["ثُمَّ اِكتَهل النَبتُ لِصَيفٍ وَلّى","فالآن شتوتُ لا تَسَل حالُك كَيف",10,"ف",1,0],["ثم اكتستْ خُضرَ ثيابٍ بها","ما اصفرَّ منها عاد معشوشبا",11,"ب",2,0]]}