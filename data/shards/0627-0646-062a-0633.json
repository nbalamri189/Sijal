7,"قدرة الله قد قضت والإراده","https://www.aldiwan.net/poem35791.html","الخفيف"],[280,"من منقذي من منقذي عشقه","https://www.aldiwan.net/poem32792.html","الكامل"],[280,"سري بألسنة الدموع يباح","https://www.aldiwan.net/poem32814.html","الكامل"],[303,"دام أفق الوزير ينمي الأهله","https://www.aldiwan.net/poem56436.html","الخفيف"],[326,"يا نديمي هات الأباريق هات","https://www.aldiwan.net/poem55034.html","الخفيف"],[340,"يا شعاع الصباح","https://www.aldiwan.net/poem55362.html","مجزوء الخفيف"],[359,"آل طه ومن يقل آل طه","https://www.aldiwan.net/poem68120.html","الخفيف"],[362,"قسما مني بأيام الصفاء","https://www.aldiwan.net/poem61005.html","الطويل"],[374,"إن تسل عن روميا قل","https://www.aldiwan.net/poem59229.html","مجزوء الرمل"],[374,"بيني وبين المبدعين مرامي","https://www.aldiwan.net/poem59267.html","الكامل"],[374,"الله قد خلق الإنسان مرتسما","https://www.aldiwan.net/poem59268.html","البسيط"],[397,"أنت علمتني !!","https://www.aldiwan.net/poem6744.html","عموديه"],[399,"أذن الندى عن نداء الشعر صماء","https://www.aldiwan.net/poem46909.html","البسيط"],[400,"مولاي قد أحسنتم","https://www.aldiwan.net/poem33347.html","مجزوء الرجز"],[406,"كل يوم فتح مبين ونصر","https://www.aldiwan.net/poem32222.html","الخفيف"],[413,"كف الملام فما يفيد ملامي","https://www.aldiwan.net/poem53993.html","الكامل"],[413,"شرف البصرة مولانا المشير","https://www.aldiwan.net/poem54069.html","الرمل"],[426,"وافى يميس فاخجل الغصن الرطب","https://www.aldiwan.net/poem39900.html","الكامل"],[426,"يا من له روض الفؤاد مكان","https://www.aldiwan.net/poem41036.html","الكامل"],[426,"جد وحدث عن العيون الكحال","https://www.aldiwan.net/poem41401.html","الخفيف"],[434,"هذه الدار والخيام الخيام","https://www.aldiwan.net/poem2543.html","الخفيف"],[436,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[438,"إن المنية في الورى أسباب","https://www.aldiwan.net/poem14436.html","الكامل"],[438,"الرزء أفجع أن نسح دموعا","https://www.aldiwan.net/poem14461.html","الكامل"],[456,"إن تسأليني بعد قومي","https://www.aldiwan.net/poem55856.html","مجزوء الكامل"],[459,"يا بهاء الدهر والدي","https://www.aldiwan.net/poem15369.html","مجزوء الرمل"],[498,"لا تعنف مولها أحمديا","https://www.aldiwan.net/poem37649.html","الخفيف"],[503,"بلا أرواح","https://www.aldiwan.net/poem56763.html","الرمل"],[513,"قصدتك من أرض الحطيم قصائد","https://www.aldiwan.net/poem12029.html","الكامل"],[536,"إن تسل يا شيخ عني","https://www.aldiwan.net/poem47469.html","عموديه"],[556,"أيها اللائم الذي لام جهلا","https://www.aldiwan.net/poem34438.html","الخفيف"],[561,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[573,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"]],"verses":[["إِن تَستَعِضكَ المَعالي بَعدَ ذاكَ فَقَد","أَفحَشنَ في بَدَلٍ مِنهُ وَفي خَلَفِ",0,"ف",1,0],["إِن تَستَعيذوا مِن تَوَسُّطِها","أَعراضَكُم فَكَفى تَطَرُّفُها",1,"ف",3,0],["إِن تَسِر فَوزُ لا أُرِد بَعدَها العَي","شَ وَنَفسي لِبَينِها سَتَبينُ",2,"ن",1,0],["أَنتِ سَلمى هَمُّ نَفسي فَاِذكُري","سَلمُ لا يوجَدُ لِلنَفسِ ثَمَن",3,"ن",1,0],["إِن تَسأَلوا العَقلَ يَقُل عاهِدوا","وَاِستَوثِقوا في عَهدِكُم تَربَحوا",4,"ح",3,0],["إِن تَسأَلي تَغلِباً وَإِخوَتَهُم","يُنبوكِ أَنّي مِن خَيرِهِم نَسَبا",5,"ب",2,1],["إِن تَسأَلي تُنبَي بِأَنّا خِيارُه","وَأَنّا الذُرى مِنها وَأَنّا وَقودُها",6,"د",3,0],["إِن تَستُري المَيتَ عَلى مِثلِهِ","في الناسِ مِن حافٍ وَمِن ناعِلِ",7,"ل",1,0],["أنت سكران خمرةِ النصر فاحذَر","حين تصحو ندامة ولِواما",8,"م",2,0],["إن تسائل عنّا فنحن هباءٌ","ذُرّ من صنعة القوى بِمِذَرّه",9,"ر",2,0],["أَنتَ سَماءٌ وَنَحنُ أَنجُمُها","أَنتَ بِلادٌ وَنَحنُ أَجبُلُها",10,"ل",3,0],["أَنتَ سَحابٌ وَنَحنُ وابِلُهُ","أَنتَ يَمينٌ وَنَحنُ أَنمُلُها",10,"ل",3,0],["إنْ تسخنُ الأدمعُ عيني فقدْ","طالَ لِذاكَ الحرِّ تردادِي",11,"ي",1,0],["إن تسقني في الحشر شربة كوثرٍ","فلقد سقتك مدامعي بغزار",12,"ر",1,0],["إن تستبنْ لك حيلة في الأمر لا","تعجزْ وإنْ لم تستبن لا نجزع",13,"ع",1,0],["أنت سهمٌ لله ما كانَ يخلى","منه أوطان مصر وهي كنانه",14,"ه",1,0],["أنت سميته الأمين وضمخت","بذكراه ندوة الشعراء",15,"ا",2,0],["إن تستتر مني فقد أكبرت","نفسك منّي أهلَ إكبار",16,"ر",1,0],["إن تُسلَّطْ على القلوبِ بلا جُر","م فأحلى مُسَلَّطٍ سلطانا",17,"ن",2,0],["إِن تَسكُنوا الطَودَ صارَ الطَودُ قُبلَتَنا","أَو تَهبِطوا البيدَ لَم نَعشَق سِوى البيدِ",18,"د",1,0],["أنت سعد في المعالي","لست فيها بسُعَيْدِ",19,"د",1,0],["إن تسل عن حسبي أو نسبي","فهما مدحي أباك المرسلا",20,"ل",2,0],["إِن تَسأَلي عَن مِصرَ حَوّاءِ القُرى","وَقَرارَةِ التاريخِ وَالآثارِ",21,"ر",1,1],["إِن تَسَل أَينَ قُبورُ العُظَما","فَعَلى الأَفواهِ أَو في الأَنفُسِ",22,"س",1,0],["أَنتِ سَطرٌ وَمَجدُ مِصرَ كِتابٌ","كَيفَ سامَ البِلى كِتابَكَ فَضّا",23,"ض",2,0],["إِن تَسَلني عَن الشَبابِ المُوَلّى","فَهُوَ القارِظُ اِنتَظَرتُ إِيابَه",24,"ب",2,0],["إِن تَسَلنا تُخبَر بِخَيرِ أُناسٍ","غابَ عَنهُم مَحمودُ عَدلِكَ حينا",25,"ن",2,0],["إِن تَسأَلِ الأَشياخَ مِن آلِ مازِنٍ","تُرَدَّ إِلى عِلجٍ كَثيرِ القَوادِحِ",26,"ح",1,1],["إنْ تَسْرِ كان لك النَّجاحُ مُصاحباً","أو تَبْقَ كان لك السُّرورُ نَديما",27,"م",2,0],["أنت سَعدُ العُفاةِ يا ابْنَ سعيدٍ","وكَفاهم بأن تُطاوِلَ سَعدا",28,"د",2,0],["إنْ تسألِ السِّلمَ تَسْلَمْ من صَوارِمِه","أو تُؤثِرِ الحربَ تَرجِعْ عنه مَحروبا",29,"ب",2,0],["أَنتَ سَيَخلو المَكانُ مِنكَ كَما","أَخلاهُ مَن كانَ فيهِ قَبلُ لَكا",30,"ك",2,0],["إِن تُساعِد بِها فَكَم مِن أَيادٍ","لَكَ فِكري لِشُكرِها مَشحوذُ",31,"ذ",1,0],["إِن تَسقِني ماءَ الملا","مِ سَقَيتُكَ اِسمَ أَبي دُلامَه",32,"م",2,0],["أَنتَ سُؤلي وَإِن بَخِلتَ بِسُؤلي","وَرَجائي وَإِن قَطَعتَ رَجائي",33,"ا",3,1],["إِن تَسعَ نَحوَكَ مِن أَقصى الشَآمِ فَقَد","سَعَت إِلى المَلِكِ المَنصورِ مِن صورِ",34,"ر",1,0],["أَنتَ سِرُّ النَبِيِّ وَالصِنوُ وَاِبنُ ال","عَمِّ وَالصِهرُ وَالأَخُ المُستَجادُ",35,"د",1,0],["أنت سرٌّ تعبت في","ه العقول البشريه",36,"ي",2,0],["إِن تَستَبِثهُ تَجِد عُراماً","مِن مُستَباثٍ لِمُستَبيثِ",37,"ث",1,0],["إِن تَسألوا فَالجهلُ داءُ بلادِكُم","وَمِن البليّةِ أَن تَموتَ بِدائِها",38,"ا",3,0],["أنتَ سِرُّ اللَّهِ في الخَلْقِ وَالسِّر","رُ عَلَى العُمْيِ أشَدُّ احْتِجَابا",39,"ب",2,0],["إنّ تستَّرْتَ عن عِياني فما حي","لةُ عينيك في الخيالِ المُطيف",40,"ف",1,0],["إن تَسَلْنَا ففَريقٌ ظاعِنٌ","وليالينا بنا عيسٌ تَخِدْ",41,"د",1,0],["إِن تَسأَلِ العَقلَ لا يوجِدكَ مِن خَبَرٍ","عَنِ الأَوائِلِ إِلّا أَنَّهُم هَلَكوا",42,"ك",3,0],["إن تسالم بها فتلك أَغانٍ","أَو تحارب بها فتلك نصول",43,"ل",1,0],["أَنتَ سر المَكانَ وَالكَون وَالده","رِ وسر الحَياة في الغبراء",44,"ا",2,0],["إن تسألِ الخمَّارَ قال هُمُو","عُشاقُ فَنٍّ أهل آدابِ",45,"ب",1,0],["إِن تَسأَلي تُنبَي بِأَنّا خِيارُها","وَأَنّا الذُرى مِنها وَأَنّا وَقودُها",46,"د",3,0],["إِنْ تَسْأَلوا النُّخَبَ الْكِرَامَ بِهِ","عدُّوهُ بَيْنَ أَجَلِّهِمْ قدْرَا",47,"ر",2,0],["إِنْ تَسْتَوَوْا خُلُقاً وَخَلْقاً أَمَا","لِلْمُجِدِّ فِيكُمْ أَظْهَرُ السِّرِّ",48,"ر",1,0],["إِنْ تَسْتَطِعْ فَاشْرَبْ مِنَ الدَّمِ خَمْرَةً","وَاجْعَل جَمَاجِمَ عَابِدِيكَ نِعَالاَ",49,"ل",2,0],["أَنْ تَسْتعِيدَ مِنْ عِزِّهَا مَا مَضى","وَهْيَ لَهُ أَهْلٌ فَهَلْ مِنْ عَجَبْ",50,"ب",1,0],["إِنْ تَسْتَزِيدُوهُ فَفِي قَابِلٍ","يَسْمَعُ مِنْهُ كُلُّكُمْ مَا أَحَبْ",50,"ب",1,0],["إِنْ تَسْتَطِعْ أَنْقِذْ فَتَاكْ","بِجَمِيعِ مَا مَلَكَتْ يَدَاكْ",51,"ك",1,1],["إِنْ تَسِيرُوا بِنَعْشِهِ فِي جَلاَلٍ","لَمْ يُشَاهَدْ فِي مَوْكِبٍ مَشْهُودِ",52,"د",1,0],["إِنْ تسمَّعْنَ نَبْأَةً غِبْنَ في الرِيحِ","كَسِرٍ يُصانُ بالكتِمانِ",53,"ن",1,0],["إن تسرفوا في الاتهام، جنيتمو","أنتم على القطر الشقيق الجار",54,"ر",1,0],["إنْتسْرِ، فالجُزُرُ الحرامُ مُبَاحَةٌ","أو تُرْسِ، فالشُّطْآنُ في استسلام",55,"م",1,0],["إن تسألوا عني: إلى من أنتمي؟","فإلى رعاة النوق والأغنام",56,"م",1,0],["إنْ تسألِ العربيَّ الحرَّ عن وطنٍ","أو ملَّةٍ قال: إنَّ الجَدَّ عدنان",57,"ن",1,0],["أنتَ سِرُّ الله في الخَلْقِ وَالسِّ","ر على العمى أشد احتجابا",58,"ب",2,0],["أنتِ سلمى – وُليِّتِ مُلكاً فسوسيه","برفقٍ بحَق من وَلاّك",59,"ك",1,0],["أنت سرور الكائنات شؤون","بك دارت أيامها والليالي",60,"ل",2,0],["إن تُسئل العلياءُ عن نفسها","نقلْ أبو القاسمِ بى أعلمُ",61,"م",1,0],["أَنتَ سَيفُ اللَهِ الَّذي لَيسَ يَحتا","جُ غَداةَ الوَغى إِلى إِرهافِ",62,"ف",1,0],["إِن تَسَخَّطتُ أَو رَضيتُ فَسِيّا","ن لَعَمري رِضايَ وَالتَسخيطُ",63,"ط",1,0],["إن تسلني فأنا ابن","الريب مذ كنت صبيا",64,"ي",2,0],["إن تسترنّ الجسم عنا قد بقت","منه علوم بثها لن تسترا",65,"ر",2,0],["أن تستحيل نسيماً","ونفحة من حنان",66,"ن",1,0],["إنّ تسليمكم عليّ بشير","بالجميل النضير من أيامي",67,"ي",1,0],["إن تسأل اليوم كيف حالي","بدارة الوجد والخفوق",68,"ق",1,0],["أَنتَ سَليلُ الصِدق نبت الشَرف","في قَلبِك الخافِق قَلب البِلاد",69,"د",1,0],["إن تُسَلِّم على الغَريبِ فَسَلِّم","في ظِلالِ السُيوفِ وَالمُرّان",70,"ن",1,0],["أنت سُؤْلي الذي اقترحتُ وهل بع","دَكَ لي في الْبَرِيَّة استعصام",71,"م",1,0],["إن تسفكي باللحظِ ظلما دمي","فقد يُصيب الليثَ عينُ الرشَا",72,"ش",2,0],["إِن تَسعَ فيها كانَ سَعيُكَ مَق","بولاًعَلى العَينينِ وَالراسِ",73,"س",1,0],["إنْ تَسْأَلِ الأَحْبَابَ عَنْ نُزُلِي","فَهَا أَنَا أَنْعَمُ فِي جَنَّتِهِ",74,"ت",2,0],["إن تسألي جحجبى وإخوتَها","تُخبِرك أني من خيرِهم نسبا",75,"ب",2,1],["إنّ تسليمنا إلى الله أمسى","سُلَّم الارتِقا لأوج السعاده",76,"د",2,0],["إِن تَستَلِذَّ عَذابَنا فَقُلوبُنا","في جَنَّةٍ بِعَذابِها تَتَلَذَّذُ",77,"ذ",1,0],["إِن تَسمَحوا بِوِصالِكُم لِيَ تَربَحوا","أَجراً كَبيراً وَالسَماحُ رَباحُ",78,"ح",1,0],["أَنتَ سلمانُ آلِ بيت حسينٍ","وَبحقٍّ حللتَ فيهِم محلّه",79,"ل",2,0],["أنت سكرى بخمرة الشع","ر ينساب حنينا مرفّه الآهات",80,"ت",1,0],["انت سحر حلال","وحياتي فتون",81,"ن",1,0],["أَنتَ سيف عَلى عداك وَلكِن","فيكَ حُلم وَما لِفَضلِكَ حَدّ",82,"د",1,0],["إن تَسلْني عن زماني وأنا","ذو اخْتبارٍ لبنيهِ وابتلاء",83,"ا",2,0],["إن تُسَلْ عن رومِيا قل","جنةُ الفردوس لكنْ",84,"ن",1,1],["أنتِ سماء اللَه أنتِ عرشه","أنت علامة قَدره المتسامي",85,"م",2,0],["إن تستجر بحمى أذيال سلطتِها","في موقف الدين تنجُ من أذى النِقم",86,"م",1,0],["أنتِ سلوايَ كلَّما رُمْتُ بُعْدا","كان ما رُمْتُ نَيْلَهُ المُسْتَحيلا",87,"ل",2,0],["إنْ تَسْتمِحْ قيل كلٌّ في السّؤال وإنْ","عاتبتَ قيل بذيّ القول هجّاءُ",88,"ا",2,0],["إن تسألوا يا سيدي","عن وجه ضعف السند",89,"د",1,0],["أنت سيف الإسلامِ حقّاً فلا فَلْ","لَ غِرَارَيْكَ أيّها السيفُ دهرُ",90,"ر",1,0],["إنْ تسألنْ عنِّي فإني لم أزلْ","بمشقَّة الإِنجاد والإِتْهام",91,"م",1,0],["أنتَ سيفٌ صارِمٌ في يده","وسحابٌ من أياديه مطير",92,"ر",1,0],["إنْ تَسلْ عمَّن بغى في حكمه","فقتيلٌ من ظباه وأسير",92,"ر",1,0],["إن تسئل العليا فبدرٌ مشرقٌ","أو تطلب الجدوى فغيث منسكب",93,"ب",1,0],["ان تسألوا عن حال صب مغرم","فالنوم ليس تذوقه العينان",94,"ن",1,0],["ان تساعد فجد برد منامي","رب يوم احظى بطيف الخيال",95,"ل",1,0],["إن تسالم تسلم وأنى تحارب","تحترب عن رؤوسها الأجسام",96,"م",1,0],["إِنْ تُسعِدِ اليومَ أَشجاني نوائِحُهُ","فكم وكمْ ساعَدَتْ شَجْوي سَواجِعُهُ",97,"ع",2,0],["إِن تسألوا كيف الشهيد فهذه","صفة الشهيد فأحمد الأَواب",98,"ب",1,0],["إن تسمعوني تحمدوني عواقبا","ذهن الحليم فلا يزال مريعا",99,"ع",2,0],["إن تسأليني بعد قو","مي كيف أوجدني الزمانُ",100,"ن",1,1],["أنتَ سَيفٌ بالنُّهى والعِلْ","مِ والمعروفِ حالِ",101,"ل",1,0],["أنت سلَّكتنا الطريق إلى الل","هِ طريقاً في السير مصطفويّا",102,"ي",2,0],["إنْ تسَلْهُم عن حقّك أو حقوق","الناسِ فيهم قالوا لك باعتدادِ",103,"د",1,0],["إن تسألا عما لقيت فإنني","لا مخفق أملي ولا كذاب",104,"ب",1,0],["إن تَسَل يا شيخُ عنِّي","إنَّني عبدُ اللطيفِ",105,"ف",1,1],["إن تساوى في الخلق بين مليح","وقبيح أخطأت في التقييس",106,"س",1,0],["إِن تَستَزيدوا أَزِد لَكُم عَلى عَجَلٍ","سَيفِيَ ذا يُبدي مِن غمدِهِ ظَهَرا",107,"ر",2,0],["إِنْ تسَلْ عنه أَو تَسَلْه إِذا جئ","تَ إِليْه فَهْو الرَّشِيدُ وجَعْفَرْ",108,"ر",1,0]]}