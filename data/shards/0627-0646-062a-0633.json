https://www.poetsgate.com/ViewPoem.aspx?id=35100",""],[5809,"ايراق","https://www.poetsgate.com/ViewPoem.aspx?id=205108",""],[5809,"الكامل","https://www.poetsgate.com/ViewPoem.aspx?id=205338",""],[5829,"نشيد المرشدات","https://www.poetsgate.com/ViewPoem.aspx?id=161992",""],[5848,"مع المحبه لتركي رويع","https://www.poetsgate.com/ViewPoem.aspx?id=48979",""],[5848,"أغرق","https://www.poetsgate.com/ViewPoem.aspx?id=53458",""],[5897,"إليها","https://www.poetsgate.com/ViewPoem.aspx?id=162002",""],[5956,"بهدْي العقل","https://www.poetsgate.com/ViewPoem.aspx?id=184521",""],[5970,"ودع حبيب القلب يوم المولد","https://www.poetsgate.com/ViewPoem.aspx?id=130617",""],[6019,"موج قصيدة ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=53046",""],[6032,"تسابيح القرب","https://www.poetsgate.com/ViewPoem.aspx?id=181510",""],[6068,"وعليك من قلبي السلامْ -05-","https://www.poetsgate.com/ViewPoem.aspx?id=175822",""],[6082,"التحدّي","https://www.poetsgate.com/ViewPoem.aspx?id=60781",""],[3304,"حواء أم جنية البحر","https://www.poetsgate.com/ViewPoem.aspx?id=135617",""],[6102,"فارسية","https://www.poetsgate.com/ViewPoem.aspx?id=184546",""],[6102,"وهم الحب","https://www.poetsgate.com/ViewPoem.aspx?id=185329",""],[5355,"عن الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87229&r=&rc=54",""],[3099,"أنتَ سماءٌ ويدي أرضها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59177&r=&rc=1",""],[2638,"ممرضتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87859&r=&rc=16",""],[6301,"نشيد أُمِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80680&r=&rc=44",""],[6317,"أ معلّمي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86080&r=&rc=3",""],[6337,"واهاً لسحركِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81412&r=&rc=24",""]],"verses":[["إِن تَستَعِضكَ المَعالي بَعدَ ذاكَ فَقَد","أَفحَشنَ في بَدَلٍ مِنهُ وَفي خَلَفِ",0,"ف",1,0],["إِن تَستَعيذوا مِن تَوَسُّطِها","أَعراضَكُم فَكَفى تَطَرُّفُها",1,"ف",3,0],["إِن تَسِر فَوزُ لا أُرِد بَعدَها العَي","شَ وَنَفسي لِبَينِها سَتَبينُ",2,"ن",1,0],["أَنتِ سَلمى هَمُّ نَفسي فَاِذكُري","سَلمُ لا يوجَدُ لِلنَفسِ ثَمَن",3,"ن",1,0],["إِن تَسأَلوا العَقلَ يَقُل عاهِدوا","وَاِستَوثِقوا في عَهدِكُم تَربَحوا",4,"ح",3,0],["إِن تَسأَلي تَغلِباً وَإِخوَتَهُم","يُنبوكِ أَنّي مِن خَيرِهِم نَسَبا",5,"ب",2,1],["إِن تَسأَلي تُنبَي بِأَنّا خِيارُه","وَأَنّا الذُرى مِنها وَأَنّا وَقودُها",6,"د",3,0],["إِن تَستُري المَيتَ عَلى مِثلِهِ","في الناسِ مِن حافٍ وَمِن ناعِلِ",7,"ل",1,0],["أنت سكران خمرةِ النصر فاحذَر","حين تصحو ندامة ولِواما",8,"م",2,0],["إن تسائل عنّا فنحن هباءٌ","ذُرّ من صنعة القوى بِمِذَرّه",9,"ر",2,0],["أَنتَ سَماءٌ وَنَحنُ أَنجُمُها","أَنتَ بِلادٌ وَنَحنُ أَجبُلُها",10,"ل",3,0],["أَنتَ سَحابٌ وَنَحنُ وابِلُهُ","أَنتَ يَمينٌ وَنَحنُ أَنمُلُها",10,"ل",3,0],["إنْ تسخنُ الأدمعُ عيني فقدْ","طالَ لِذاكَ الحرِّ تردادِي",11,"د",2,0],["إن تسقني في الحشر شربة كوثرٍ","فلقد سقتك مدامعي بغزار",12,"ر",1,0],["إن تستبنْ لك حيلة في الأمر لا","تعجزْ وإنْ لم تستبن لا نجزع",13,"ع",1,0],["أنت سهمٌ لله ما كانَ يخلى","منه أوطان مصر وهي كنانه",14,"ه",1,0],["أنت سميته الأمين وضمخت","بذكراه ندوة الشعراء",15,"ا",2,0],["إن تستتر مني فقد أكبرت","نفسك منّي أهلَ إكبار",16,"ر",1,0],["إن تُسلَّطْ على القلوبِ بلا جُر","م فأحلى مُسَلَّطٍ سلطانا",17,"ن",2,0],["إِن تَسكُنوا الطَودَ صارَ الطَودُ قُبلَتَنا","أَو تَهبِطوا البيدَ لَم نَعشَق سِوى البيدِ",18,"د",1,0],["أنت سعد في المعالي","لست فيها بسُعَيْدِ",19,"د",1,0],["إن تسل عن حسبي أو نسبي","فهما مدحي أباك المرسلا",20,"ل",2,0],["إِن تَسأَلي عَن مِصرَ حَوّاءِ القُرى","وَقَرارَةِ التاريخِ وَالآثارِ",21,"ر",1,1],["إِن تَسَل أَينَ قُبورُ العُظَما","فَعَلى الأَفواهِ أَو في الأَنفُسِ",22,"س",1,0],["أَنتِ سَطرٌ وَمَجدُ مِصرَ كِتابٌ","كَيفَ سامَ البِلى كِتابَكَ فَضّا",23,"ض",2,0],["إِن تَسَلني عَن الشَبابِ المُوَلّى","فَهُوَ القارِظُ اِنتَظَرتُ إِيابَه",24,"ب",2,0],["إِن تَسَلنا تُخبَر بِخَيرِ أُناسٍ","غابَ عَنهُم مَحمودُ عَدلِكَ حينا",25,"ن",2,0],["إِن تَسأَلِ الأَشياخَ مِن آلِ مازِنٍ","تُرَدَّ إِلى عِلجٍ كَثيرِ القَوادِحِ",26,"ح",1,1],["إنْ تَسْرِ كان لك النَّجاحُ مُصاحباً","أو تَبْقَ كان لك السُّرورُ نَديما",27,"م",2,0],["أنت سَعدُ العُفاةِ يا ابْنَ سعيدٍ","وكَفاهم بأن تُطاوِلَ سَعدا",28,"د",2,0],["إنْ تسألِ السِّلمَ تَسْلَمْ من صَوارِمِه","أو تُؤثِرِ الحربَ تَرجِعْ عنه مَحروبا",29,"ب",2,0],["أَنتَ سَيَخلو المَكانُ مِنكَ كَما","أَخلاهُ مَن كانَ فيهِ قَبلُ لَكا",30,"ك",2,0],["إِن تُساعِد بِها فَكَم مِن أَيادٍ","لَكَ فِكري لِشُكرِها مَشحوذُ",31,"ذ",1,0],["إِن تَسقِني ماءَ الملا","مِ سَقَيتُكَ اِسمَ أَبي دُلامَه",32,"م",2,0],["أَنتَ سُؤلي وَإِن بَخِلتَ بِسُؤلي","وَرَجائي وَإِن قَطَعتَ رَجائي",33,"ا",3,1],["إِن تَسعَ نَحوَكَ مِن أَقصى الشَآمِ فَقَد","سَعَت إِلى المَلِكِ المَنصورِ مِن صورِ",34,"ر",1,0],["أَنتَ سِرُّ النَبِيِّ وَالصِنوُ وَاِبنُ ال","عَمِّ وَالصِهرُ وَالأَخُ المُستَجادُ",35,"د",1,0],["أنت سرٌّ تعبت في","ه العقول البشريه",36,"ي",2,0],["إِن تَستَبِثهُ تَجِد عُراماً","مِن مُستَباثٍ لِمُستَبيثِ",37,"ث",1,0],["إِن تَسألوا فَالجهلُ داءُ بلادِكُم","وَمِن البليّةِ أَن تَموتَ بِدائِها",38,"ا",3,0],["أنتَ سِرُّ اللَّهِ في الخَلْقِ وَالسِّر","رُ عَلَى العُمْيِ أشَدُّ احْتِجَابا",39,"ب",2,0],["إنّ تستَّرْتَ عن عِياني فما حي","لةُ عينيك في الخيالِ المُطيف",40,"ف",1,0],["إن تَسَلْنَا ففَريقٌ ظاعِنٌ","وليالينا بنا عيسٌ تَخِدْ",41,"د",1,0],["إِن تَسأَلِ العَقلَ لا يوجِدكَ مِن خَبَرٍ","عَنِ الأَوائِلِ إِلّا أَنَّهُم هَلَكوا",42,"ك",3,0],["إن تسالم بها فتلك أَغانٍ","أَو تحارب بها فتلك نصول",43,"ل",1,0],["أَنتَ سر المَكانَ وَالكَون وَالده","رِ وسر الحَياة في الغبراء",44,"ا",2,0],["إن تسألِ الخمَّارَ قال هُمُو","عُشاقُ فَنٍّ أهل آدابِ",45,"ب",1,0],["إِن تَسأَلي تُنبَي بِأَنّا خِيارُها","وَأَنّا الذُرى مِنها وَأَنّا وَقودُها",46,"د",3,0],["إِنْ تَسْأَلوا النُّخَبَ الْكِرَامَ بِهِ","عدُّوهُ بَيْنَ أَجَلِّهِمْ قدْرَا",47,"ر",2,0],["إِنْ تَسْتَوَوْا خُلُقاً وَخَلْقاً أَمَا","لِلْمُجِدِّ فِيكُمْ أَظْهَرُ السِّرِّ",48,"ر",1,0],["إِنْ تَسْتَطِعْ فَاشْرَبْ مِنَ الدَّمِ خَمْرَةً","وَاجْعَل جَمَاجِمَ عَابِدِيكَ نِعَالاَ",49,"ل",2,0],["أَنْ تَسْتعِيدَ مِنْ عِزِّهَا مَا مَضى","وَهْيَ لَهُ أَهْلٌ فَهَلْ مِنْ عَجَبْ",50,"ب",1,0],["إِنْ تَسْتَزِيدُوهُ فَفِي قَابِلٍ","يَسْمَعُ مِنْهُ كُلُّكُمْ مَا أَحَبْ",50,"ب",1,0],["إِنْ تَسْتَطِعْ أَنْقِذْ فَتَاكْ","بِجَمِيعِ مَا مَلَكَتْ يَدَاكْ",51,"ك",1,1],["إِنْ تَسِيرُوا بِنَعْشِهِ فِي جَلاَلٍ","لَمْ يُشَاهَدْ فِي مَوْكِبٍ مَشْهُودِ",52,"د",1,0],["إِنْ تسمَّعْنَ نَبْأَةً غِبْنَ في الرِيحِ","كَسِرٍ يُصانُ بالكتِمانِ",53,"ن",1,0],["إن تسرفوا في الاتهام، جنيتمو","أنتم على القطر الشقيق الجار",54,"ر",1,0],["إنْتسْرِ، فالجُزُرُ الحرامُ مُبَاحَةٌ","أو تُرْسِ، فالشُّطْآنُ في استسلام",55,"م",1,0],["إن تسألوا عني: إلى من أنتمي؟","فإلى رعاة النوق والأغنام",56,"م",1,0],["إنْ تسألِ العربيَّ الحرَّ عن وطنٍ","أو ملَّةٍ قال: إنَّ الجَدَّ عدنان",57,"ن",1,0],["أنتَ سِرُّ الله في الخَلْقِ وَالسِّ","ر على العمى أشد احتجابا",58,"ب",2,0],["أنتِ سلمى – وُليِّتِ مُلكاً فسوسيه","برفقٍ بحَق من وَلاّك",59,"ك",1,0],["أنت سوّيت فيني شي ماهو قليل","أمسي بطيفك اللّي هدّني..... وأصبحه",60,"ح",2,0],["أنت سرور الكائنات شؤون","بك دارت أيامها والليالي",61,"ل",2,0],["إن تُسئل العلياءُ عن نفسها","نقلْ أبو القاسمِ بى أعلمُ",62,"م",1,0],["أَنتَ سَيفُ اللَهِ الَّذي لَيسَ يَحتا","جُ غَداةَ الوَغى إِلى إِرهافِ",63,"ف",1,0],["إِن تَسَخَّطتُ أَو رَضيتُ فَسِيّا","ن لَعَمري رِضايَ وَالتَسخيطُ",64,"ط",1,0],["إن تسلني فأنا ابن","الريب مذ كنت صبيا",65,"ي",2,0],["إن تسترنّ الجسم عنا قد بقت","منه علوم بثها لن تسترا",66,"ر",2,0],["أن تستحيل نسيماً","ونفحة من حنان",67,"ن",1,0],["إنّ تسليمكم عليّ بشير","بالجميل النضير من أيامي",68,"ي",1,0],["إن تسأل اليوم كيف حالي","بدارة الوجد والخفوق",69,"ق",1,0],["أَنتَ سَليلُ الصِدق نبت الشَرف","في قَلبِك الخافِق قَلب البِلاد",70,"د",1,0],["إن تُسَلِّم على الغَريبِ فَسَلِّم","في ظِلالِ السُيوفِ وَالمُرّان",71,"ن",1,0],["أنت سُؤْلي الذي اقترحتُ وهل بع","دَكَ لي في الْبَرِيَّة استعصام",72,"م",1,0],["إن تسفكي باللحظِ ظلما دمي","فقد يُصيب الليثَ عينُ الرشَا",73,"ش",2,0],["إِن تَسعَ فيها كانَ سَعيُكَ مَق","بولاًعَلى العَينينِ وَالراسِ",74,"س",1,0],["إنْ تَسْأَلِ الأَحْبَابَ عَنْ نُزُلِي","فَهَا أَنَا أَنْعَمُ فِي جَنَّتِهِ",75,"ت",2,0],["إن تسألي جحجبى وإخوتَها","تُخبِرك أني من خيرِهم نسبا",76,"ب",2,1],["إنّ تسليمنا إلى الله أمسى","سُلَّم الارتِقا لأوج السعاده",77,"د",2,0],["إِن تَستَلِذَّ عَذابَنا فَقُلوبُنا","في جَنَّةٍ بِعَذابِها تَتَلَذَّذُ",78,"ذ",1,0],["إِن تَسمَحوا بِوِصالِكُم لِيَ تَربَحوا","أَجراً كَبيراً وَالسَماحُ رَباحُ",79,"ح",1,0],["أَنتَ سلمانُ آلِ بيت حسينٍ","وَبحقٍّ حللتَ فيهِم محلّه",80,"ل",2,0],["أنت سكرى بخمرة الشع","ر ينساب حنينا مرفّه الآهات",81,"ت",1,0],["انت سحر حلال","وحياتي فتون",82,"ن",1,0],["أَنتَ سيف عَلى عداك وَلكِن","فيكَ حُلم وَما لِفَضلِكَ حَدّ",83,"د",1,0],["إن تَسلْني عن زماني وأنا","ذو اخْتبارٍ لبنيهِ وابتلاء",84,"ا",2,0],["إن تُسَلْ عن رومِيا قل","جنةُ الفردوس لكنْ",85,"ن",1,1],["أنتِ سماء اللَه أنتِ عرشه","أنت علامة قَدره المتسامي",86,"م",2,0],["إن تستجر بحمى أذيال سلطتِها","في موقف الدين تنجُ من أذى النِقم",87,"م",1,0],["أنتِ سلوايَ كلَّما رُمْتُ بُعْدا","كان ما رُمْتُ نَيْلَهُ المُسْتَحيلا",88,"ل",2,0],["إنْ تَسْتمِحْ قيل كلٌّ في السّؤال وإنْ","عاتبتَ قيل بذيّ القول هجّاءُ",89,"ا",2,0],["إن تسألوا يا سيدي","عن وجه ضعف السند",90,"د",1,0],["أنت سيف الإسلامِ حقّاً فلا فَلْ","لَ غِرَارَيْكَ أيّها السيفُ دهرُ",91,"ر",1,0],["إنْ تسألنْ عنِّي فإني لم أزلْ","بمشقَّة الإِنجاد والإِتْهام",92,"م",1,0],["أنتَ سيفٌ صارِمٌ في يده","وسحابٌ من أياديه مطير",93,"ر",1,0],["إنْ تَسلْ عمَّن بغى في حكمه","فقتيلٌ من ظباه وأسير",93,"ر",1,0],["إن تسئل العليا فبدرٌ مشرقٌ","أو تطلب الجدوى فغيث منسكب",94,"ب",1,0],["ان تسألوا عن حال صب مغرم","فالنوم ليس تذوقه العينان",95,"ن",1,0],["ان تساعد فجد برد منامي","رب يوم احظى بطيف الخيال",96,"ل",1,0],["إن تسالم تسلم وأنى تحارب","تحترب عن رؤوسها الأجسام",97,"م",1,0],["إِنْ تُسعِدِ اليومَ أَشجاني نوائِحُهُ","فكم وكمْ ساعَدَتْ شَجْوي سَواجِعُهُ",98,"ع",2,0],["إِن تسألوا كيف الشهيد فهذه","صفة الشهيد فأحمد الأَواب",99,"ب",1,0],["إن تسمعوني تحمدوني عواقبا","ذهن الحليم فلا يزال مريعا",100,"ع",2,0],["إن تسأليني بعد قو","مي كيف أوجدني الزمانُ",101,"ن",1,1],["أنتَ سَيفٌ بالنُّهى والعِلْ","مِ والمعروفِ حالِ",102,"ل",1,0],["أنت سلَّكتنا الطريق إلى الل","هِ طريقاً في السير مصطفويّا",103,"ي",2,0],["إنْ تسَلْهُم عن حقّك أو حقوق","ال