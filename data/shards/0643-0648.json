m/ViewPoem.aspx?id=179506",""],[106,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[77,"يمينا بيانع ورد الخدود","https://www.poetsgate.com/ViewPoem.aspx?id=33808",""],[18,"أليلتنا بذي حسم أنيري","https://www.poetsgate.com/ViewPoem.aspx?id=27758",""],[90,"في الطيارة أو على أبواب المفاوضات","https://www.poetsgate.com/ViewPoem.aspx?id=179078",""],[90,"ذكرى دمشق الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179048",""],[90,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[45,"وراءك عني يا عذول الأشايب","https://www.poetsgate.com/ViewPoem.aspx?id=33108",""],[3,"ألاَ يا دار عبلة ََ بالطوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10778&r=&rc=132",""]],"verses":[["كُؤوسُهُمُ أَسيافُهُم وَخِضابُها","إِذا جَرَّدوها مِن دِماءِ المَعاصِرِ",0,"ر",1,0],["كَوَجدي وَقَد عَرّى الشَبابُ جَوادَه","وَغَيَّرَ لَونَ العارِضَينِ مَشيبُ",1,"ب",1,0],["كَوَحيِ صَحائِفٍ مِن عَهدِ كِسرى","فَأَهداها لِأَعجَمَ طِمطِمِيِّ",2,"ي",1,0],["كَواكِبُ الأرْضِ وأنْوارُها","أضْحَى بهِمْ مَغْرِبُها مَطْلِعا",3,"ع",2,0],["كَواعِبُ تُخْجِلُ حُورَ الحِجالِ","بِيضُ الجُسومِ طِوالُ القُدودْ",4,"د",1,0],["كونوا لَهُم جُنَناً وَذودوا عَنهُمُ","أَشياعَ كُلِّ مُنافِقٍ جَبّارِ",5,"ر",1,0],["كوني كَمِثلِ الَّتي إِذ غابَ وافِدُها","أَهدَت لَهُ مِن بَعيدٍ نَظرَةً جَزَعا",6,"ع",2,0],["كونوا رِجالاً عامِلينَ وَكَذِّبوا","وَالصُبحُ أَبلَجُ حامِلَ المِصباحِ",7,"ح",1,0],["كواكب بت ارعاهنّ حتى","كأني عاشق وهي الذمام",8,"م",1,0],["كَواظِمَ لا يَنطِقنَ إِلّا مَحورَةً","رَجيعَةَ قَولٍ بَعدَ أَن يَتَفَهَّما",9,"م",2,0],["كَوارِثُ أَفْحَشَتْ فتُهِي","بُ الأَرْقَامُ مُحْصِيهَا",10,"ي",3,0],["كُونَا سَعِيدَيْنِ وَاعْتَزَّا بِنَسْلِكُمَا","واسْتَوْفَيَا العِزَّ وَالعَلْيَاءَِ وَالجَاهَا",11,"ا",3,0],["كَوَرْدَةٍ أُكْثِرَ إِرْوَاؤُهَا","فَنَشَأَتْ مَائِيَّةً ذَابِلَهْ",12,"ل",2,0],["كَوَاكِبُ بَيْتِكُمْ نَسَقٌ وَأَدْنَى","إِلَى عَيْنيَّ مِنْهَا نّيِّرَانِ",13,"ن",1,0],["كَوِشَاحِ هَفْهَافٍ تَدَلَّى مِنْ عَلٍ","مُتَحَلِّياً بِالدُّرِّ وَالْعِقْيَانِ",14,"ن",1,0],["كَوَاشِرُ الأَنْيَابِ مَا رَاعَهَا","إِلاَّ ثَنَايَا طَالِعٍ ذِي ابْتِسَامْ",15,"م",1,0],["كُوفِئْتُمُ خَيْراً وَعَادَ بِصَبْرِكُمْ","مُتَجَدِّداً مَا قَوَّضَ الظلاَّمُ",16,"م",1,0],["كُونُوا مَلائِكَ لا جُوعٌ وَلا ظَمَأٌ","وَليَغْلِبْنَ نِظَامَ الخَلْقِ صَبْرُكُمُ",17,"م",1,0],["كوكب قد توقّدا","في سماء من الهدى",18,"د",2,0],["كونوا جميعا في الحياة كأنكم","رجل إذا دهت الدواهي واحد",19,"د",1,0],["كونوا كَيوسُفَ لَمّا جاءَ إِخوَتُهُ","وَاِستَعرَفوا قالَ ما في اليَومِ تَثريبُ",20,"ب",1,0],["كوماً مَهاريسَ مِثلَ الهَضبِ لَو وَرَدَت","ماءَ الفُراتِ لَكادَ البَحرُ يُنتَزِفُ",21,"ف",1,0],["كونوا كما شئتموا نأياً ومقترباً","إنْ لم تكونوا من الدنيا كما شينا",22,"ن",2,0],["كَوَّر شمس النهار فانكدرت","كواكبُ الليل كل منكَدَرِ",23,"ر",1,0],["كوجوه أهل الجنة ابتسمت لنا","مقرونةً بوجوه أهل النار",24,"ر",1,0],["كوكب الصبح هلال ال","أفق والأُفْقُ الشآمُ",25,"م",1,0],["كَوارِثٌ لَو نابَت جِبالاً شَواهِقاً","لَخَرَّت لَها تِلكَ الشَواهِقُ سُجَّدا",26,"د",2,0],["كَوكَبٌ ما كادَ يَبدو في السَما","طالِعاً حَتّى اِختَفى كَالحُلُمِ",27,"م",1,0],["كونوا عَلى حَذَرٍ فَفي هَذا الضُحى","يَأتي إِلَينا قَيصَرُ الأَلمانِ",28,"ن",1,0],["كوني لشيخ قد صبا","الى الجمال عاذره",29,"ر",2,0],["كوكبا كان يرسل الشعر نورا","ثم يرمي به على الآفاق",30,"ق",1,0],["كوكب مظلم يطوف من الشمس حثيثا","بكوكب وقاد",31,"د",1,0],["كون تحركه نواميس له","كانت له منذ القديم لزاما",32,"م",2,0],["كوخ حقير ثم قصر شاهقٍ","ومآتم في جناب الاعراس",33,"س",1,0],["كوكب كله جمال فما ار","وعه في عيون حزب الجمال",34,"ل",1,0],["كوكب يرسل الاشعة بيضا","ء من الشرق وحده في الليالي",34,"ي",1,0],["كونوا كما يبغي الابا","ء على كرامتكم غيارى",35,"ر",2,0],["كونوا جميعاً سادة لنفوسكم","فالعصر هذا سيد الاعصار",36,"ر",1,0],["كوّنها تكوينا","مختلفا تلوينا",37,"ن",2,0],["كوكب الآمان صبح التمنى","كلما همت الخطوب أنارا",38,"ر",2,0],["كونا لدى الله شافعَين له","وسلما نحو ظله الوارف",39,"ف",1,0],["كونوا الجِدارَ الَّذي يَقوى الجِدارُ بِهِ","فَاللَهُ جَعَلَ الإِسلامَ بُنيانا",40,"ن",2,0],["كونُوا جميعَاً يا بَنِيَّ إِذا اعتَرى","خَطْبٌ ولا تتفرقُوا آحادَا",41,"د",2,1],["كُؤوسٌ مِنَ الصَهباءِ تَأبى اِجتِماعَها","إِذا اِنتُشِحَت الهَمَّ في صَدرِ شارِبِ",42,"ب",1,0],["كَواكِبُ شَيبٍ عَلِقنَ الصِبا","فَقَلَّلنَ مِن حُسنِهِ ما كَثُر",43,"ر",1,0],["كَواكِبُ الفَكَّةِ في أُفقِها","دَنَت فَحَفَّت غُرَّةَ البَدرِ",44,"ر",1,0],["كَوارِدِ الخِمسِ شَهرَ القَيظِ جادَ لَهُ","حِسيٌ وَمَدَّ عَلَيهِ ظِلُّهُ السَلَمُ",45,"م",1,0],["كَوُعولِ الهِضابِ رُحنَ وَما يَملِك","نَ إِلّا صُمَّ الرِماحِ قُرونا",46,"ن",2,0],["كَوى الداءَ بِالمُكواةِ حَتّى جَلا بِها","عَنِ القَلبِ عَينَي كُلِّ جِنٍّ وَخابِلِ",47,"ل",1,0],["كَوادٍ بِهِ البَيتُ العَتيقُ تَمُدُّهُ","بُحورٌ طَمَت مِن عَبدِ شَمسٍ وَهاشِمِ",48,"م",1,0],["كَوماءُ تَسحَبُ مِن سُقمٍ مَناسِمَها","كَأَنَّ أَرجُلَها شُدَّت بِأَشراكِ",49,"ك",1,0],["كَواكِبُ القَطرِ إِلّا أَنَّ راحَتُهُ","إِن أَمسَكَ القَطرُ لا تَعبا بِإِمساكِ",49,"ك",1,0],["كوَّةً تنفذ الحفيظة عنها","ويُطلُّ الدهاءُ والخبثُ منها",50,"ه",2,0],["كَونُكَ في صُلبِ أَبينا آدَمٍ","أَهبَطَنا جَمعاً إِلى الأَرضِ",51,"ض",1,0],["كَوامِنُ الحُبِّ قَبلَ كَونِكَ في","أَفئِدَةِ العاشِقينَ لَم تَكُنِ",52,"ن",1,0],["كَواكِبُ الدُنيا السُعودُ الَّتي","بِدَلِّها دَلَّت عَلَيكَ النُحوس",53,"س",1,0],["كَواكِبُ مَجدٍ يَعلَمُ اللَيلُ أَنَّهُ","إِذا نَجَمَت باءَت بِصُغرٍ كَواكِبُه",54,"ب",2,0],["كَواعِبُ أَترابٌ لِغَيداءَ أَصبَحَت","وَلَيسَ لَها في الحُسنِ شَكلٌ وَلا تِربُ",55,"ب",1,0],["كَواعِبُ زارَت في لَيالٍ قَصيرَةٍ","يُخَيَّلنَ لي مِن حُسنِهِنَّ كَواعِبا",56,"ب",2,0],["كَوَسطَي لَيالي الشَهرِ لا مُقسَئِنَّةً","وَلا وَثَبى عَجلى القِيامِ خَروجُ",57,"ج",1,0],["كُوني جميعاً فالتفرُّقُ لم يَزَلْ","مُذْ كانَ من نُذُرِ القضاءِ المُبْرَمِ",58,"م",1,0],["كُوني لمِصرَ حياةً غيرَ هازلةٍ","وَعلِّمِي الجِدَّ شعباً ساءَ محَياهُ",59,"ا",2,0],["كونوا بِهِ أُمَّةً في الدَهرِ واحِدَةً","لا يَنظُرُ الغَربُ يَوماً كَيفَ تَحتَرِبُ",60,"ب",1,0],["كونوا كَأُمِّ المُحسِنينَ سَماحَةً","إِنَّ المُوَفَّقَ بِالمُوَفَّقِ يَقتَدي",61,"د",2,0],["كوكبُ الحقِّ والهدى يَتَلَقَّى","من ذويهِ الهُداةِ نَجماً فنجما",62,"م",2,0],["كُؤوسٌ تُحَيِيها النُفوسُ كَأَنَّها","حَديثُ تَلاقٍ في مَسامِعِ عُشّاقِ",63,"ق",1,0],["كَوني بودّك كَالبَد","ر فَهُوَ يَخفى وَيَظهر",64,"ر",1,0],["كَوَغى القَطا ما يَستَبي","نُ بِهِ المُحَدِّثُ قيلَ قائِل",65,"ل",1,0],["كَواعِبَ أَتراباً تَراخى بِها الهَوى","وَأَخلى لَها مِن ذي السُدَيرِ بَقيعُ",66,"ع",1,0],["كَوَرَقِ المَصحَفِ قَد","أُجرى عَلَيهِ الذَهَبُ",67,"ب",1,0],["كَوماءَ دَهماءَ لا يَجذو القُرادُ بِها","ثَقيلَةِ الوَطءِ لا رَذلٍ وَلا نيبِ",68,"ب",1,0],["كُونُوا مَعِي عَوناً عَلَى الأيَّامِ","لا تَخْذُلُونِي يا بَنِي عرَّامِ",69,"م",1,1],["كوفئتَ عن ذلك الثغرِ المخوفِ فقَدْ","تركتَهُ بالعَوالي جِدَّ مَكفيّ",70,"ي",1,0],["كُؤوسٌ كَالكَواكِبِ دائِراتٌ","مَطالِعُها عَلى الفَلَكِ الأَديمُ",71,"م",1,0],["كواحدٍ بالنساءِ مرتهنٌ","أروَع ما يستفيقُ من غزلِه",72,"ل",2,0],["كوكبُ صبح بدا وقد جعلت","أيدي الثريّا بمغربٍ تجنح",73,"ح",1,0],["كؤوسنا والطلا طلايعُنا","نحيا بها بُكرةً فنحييها",74,"ي",3,0],["كونا كَمَن قالَ لا نُعاتِبُهُ","كُلُّ اِمرِئٍ مُنتَهٍ إِلى أَمَدِ",75,"د",1,0],["كونوا لِمَولاكُم يَداً وَصَلَت يَداً","وَدَعوا الفَسادَ يَعيثُ فيهِ المُفسِدُ",76,"د",1,0],["كَوَيتُ قَوماً بِمِكواتي فَما صَبَروا","عَلى العِقابِ وَقَد دَبّوا بِدَهياءِ",77,"ا",2,0],["كُؤوسٌ مِن أَجَلِّ الراحِ قَدراً","وَلَكِن ما يَزَلنَ مُفَدَّماتِ",78,"ت",1,0],["كوني الثُرَيّا أَو حَضارِ أَو ال","جَوزاءَ أَو كَالشَمسِ لا تَلِدُ",79,"د",1,1],["كوفيَّةُ الإبداعِ بَصْريَّةٌ","لغيرِ كوفيٍّ وبَصْريِّ",80,"ي",1,0],["كوني كَعَهدِكِ بَينَ قَومِكِ إِنَّهُم","تَرَكوكِ غَرقى في الحَديدِ وَفي الدَمِ",81,"م",1,0],["كونٌ جهلت على اِكتَناهٍ أَمرَه","وَجهلت فيه بداءتي وَختامي",82,"م",2,0],["كواكب في المجرّة عائمات","حكت في بحر فسحتها السفينا",83,"ن",2,0],["كونوا من الفادينَ إن عزَّ الفدا","كم في الفداءِ من الخلودِ معاني",84,"ن",2,0],["كَوْكَبٌ كَانَ فِي تَجَلِّيهِ لِلْجَهْلِ","غُرُوبٌ وَلِلْعُلُومِ شُرُوقُ",85,"ق",1,0],["كُونَا سَعِيدَيْنِ الْحَيَاةِ وَاكْمِلاَ","سَعْدَ الحِمَى بِبَنِيكُمُا الأَبْرَارِ",86,"ر",1,0],["كَوَثْبِ صِغَارِ المَهَا الظَّامِئَا","تِ نَفَرْنَ خِفَافاً إِلى مَوْرِد",87,"د",1,0],["كُونِي عَلَى الْعَهْدِ الْعَتِيدِ وَمَا بِنَا",