{"poems":[[75,"وليل أدمنا فيه شرب مدامة","https://www.aldiwan.net/poem11974.html","الطويل"],[49,"أبى غرب هذا الدمع إلا تسرعا","https://www.aldiwan.net/poem25234.html","الطويل"],[49,"لأيكم أذكر","https://www.aldiwan.net/poem25261.html","مجزوء المتقارب"],[94,"أزنبقة السفح ما لي أراك","https://www.aldiwan.net/poem38887.html","المتقارب"],[80,"وليل أدمنا فيه شرب مدامة","https://www.aldiwan.net/poem14274.html","الطويل"],[82,"شددت على صدر الزماع حزامي","https://www.aldiwan.net/poem31296.html","الطويل"],[69,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54289","الطويل"],[114,"ذكرتُ ابنة السعدي ذكرى ودونها","https://www.aldiwan.net/poem759.html",""],[147,"تسد إذا حم الحمام المذاهب","https://www.aldiwan.net/poem11729.html","الطويل"],[164,"أراني الله رأسك يا صلاح","https://www.aldiwan.net/poem58709.html","البسيط"],[228,"ألفيتها ومن التحسر لا تعي","https://www.aldiwan.net/poem41880.html","الكامل"],[369,"أشاكر أنا للأيام أم شاك","https://www.aldiwan.net/poem60816.html","البسيط"],[443,"أقيموا عمود الدين للّه تسعدوا","https://www.aldiwan.net/poem2621.html","الطويل"],[447,"إذا ما مررنا بالمقابر ساعة","https://www.aldiwan.net/poem14447.html","الطويل"],[447,"كوى قلبي الأسى والحزن كيا","https://www.aldiwan.net/poem14492.html","الوافر"],[511,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64003","الوافر"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77452","الوافر"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123441","الرجز"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93146","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27452","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130813",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100248","الوافر"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84473","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48308","الطويل"],[3640,"","https://poetry.dctabudhabi.ae/diwan/poem/141895","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86376","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94556","الوافر"],[4386,"","https://poetry.dctabudhabi.ae/diwan/poem/33811","الوافر"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99101","الوافر"],[5096,"أوجاع دهر","https://www.poetsgate.com/ViewPoem.aspx?id=206535",""],[5206,"حجر الفلاسفة","https://www.poetsgate.com/ViewPoem.aspx?id=187417",""],[5771,"وجهٌ ثُلاثيُّ الأوجاع","https://www.poetsgate.com/ViewPoem.aspx?id=189540",""],[5937,"كوجه الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=211824",""],[5943,"نسيبة إنَّ بقلبي أسى","https://www.poetsgate.com/ViewPoem.aspx?id=34287",""],[5956,"أحببتُكم مِمّا سمِعتُه عنكم","https://www.poetsgate.com/ViewPoem.aspx?id=207929",""],[6134,"مالي أرى اعين الازهار قد ذبلت","https://www.poetsgate.com/ViewPoem.aspx?id=169549",""],[5190,"الببغاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78301&r=&rc=14",""]],"verses":[["فَحُزنا مِنَ اللَذاتِ أَطيَبَ طيبِها","وَلَم يَعرُنا هَمٌّ وَلا عاقَ تَكديرُ",0,"ر",1,0],["فَحُزنِيَ حُزنُ الهائِمينَ مُبَرِّحاً","وَسِرِّيَ سِرُّ العاشِقينَ مُضَيَّعا",1,"ع",2,0],["فَحُزنِيَ لا يَنقَضي","وَدَمعِيَ ما يَفتُرُ",2,"ر",1,0],["فَحُزْني وحُزْنُكِ لا يَبْرَحانِ","أَلِيفَيْنِ رغْمَ الزَّمانِ العصيب",3,"ب",1,0],["فَحُزنا مَنَ اللَذاتِ أَطيَبَ طيبِها","وَلَم يَعدنا هَمٌّ وَلا عاقَ تَكديرُ",4,"ر",1,0],["فَحزبٌ يكفُّ الدهرُ عنهُ عزيمَتي","وحزبٌ تردّ الرومُ عنهُ مَرامي",5,"م",2,0],["فَحُزْتَ كلَّ فَخَارٍ غَيْرَ مُشْتَرَكٍ","وَجُزْتَ كلَّ مَقامٍ غيرَ مُزْدَحَمِ",6,"م",1,0],["فَحْزمٌ كما ترْضى العُلاَ وتواضُعٌ","وعَزْمٌ كما تَرْضَى العُلا وترَفُّعُ",7,"ع",1,0],["فَحَزمُ قُطَيّاتِ إِذِ البالُ صالحٌ","فَكَبشَةَ مَعروفٍ فَغولا فَقادِما",8,"م",2,0],["فَحُزتَ مَدىً قَد عاوَدَت دونَ نَيلِهِ","أَمانِيُّ أَهلِ الأَرضِ وَهيَ لَواغِبُ",9,"ب",1,0],["فحزبُ اللهِ حقهمُ عليه","أكيدٌ مالديه له انطراحُ",10,"ح",1,0],["فَحَزَرتُ أَنَّ الدَهرَ سلَّم طيرها","ليدِ الحِمامِ فَطيرُها لم يرجِع",11,"ع",1,0],["فحُزْ مَحامِدَ تَبقَى في الزَّمانِ به","فأنت من مَعشَرٍ للحَمْدِ مُلاّك",12,"ك",1,0],["فحزبكُم حزب الإله وإنهم","همم الغالبون الشرك والمود أحمد",13,"د",1,0],["فحزنك يا نور الأَباضي بعضه","ليحرق منا معلق الروح لا الجلد",14,"د",1,0],["فحزنك ماطر سيلا جحافا","لديّ وقاصداً غيري إتيا",15,"ي",2,0],["فحزنك قد محا الأحزان عني","وكان لظى وباقي الحزن كيا",15,"ي",2,0],["فَحُزني عَليهِ جَاوَزَ الحَدَّ قَدرُهُ","وَلاَ حُزنَ يَعقُوبٍ وَيوسُف في الجُبِّ",16,"ب",1,0],["فحزتُ به الضياعَ بلا خراجٍ","أفوزُ بربحهنَّ بلا وضيعه",17,"ع",2,0],["فَحزبُ مرين حزبُ اللَهِ يَحمي","حِمى الإِسلام لا يَخشى عِقابا",18,"ب",2,0],["فحزت في إخراجه","راحة نفسي والثنا",19,"ن",2,0],["فحزنه أنحله فكلما هل","يهل ناحلاً محدودبا",20,"ب",2,0],["فحزت به كشفاً فعادت معارفاً","مطالعها في القلب كالأنجم الزُّهر",21,"ر",1,0],["فحزبٌ إلى الملهي وحزب إلى البغا","وجمعٌ إلى كرع الخمور يهرول",22,"ل",1,0],["فحزتَ الجل منه بلا سلاحٍ","فكيف وأنت شاكٍ بالسلاح",23,"ح",1,0],["فحزت كل فخار غير مشتَرك","من المَلائِكة السامين في الأمم",24,"م",1,0],["فحزْمٌ كلَيْثِ الغابِ يحمِي ذِمارَهُ","وعزْمٌ كما قد هُزّ في الرّوْعِ مُنصُلُ",25,"ل",1,0],["فحزعيه فما نظماه قصراً","وبستاناً وروضاً قد تحدق",26,"ق",1,0],["فحزت رهانها في كل مجرى","وفزت هناك بالقدح المعلى",27,"ل",2,0],["فحُز يا طَودَ لبنانٍ هناءً","وفُز بصفاءِ ذا العيش الرغيدِ",28,"د",1,0],["فَحَزمُ الرَأيِ أَن تَدعو بِرَطلٍ","فَتَشرَبُهُ وَتَكسوني قَميصا",29,"ص",2,0],["فحِزْ إرث الزمان وعشْ حميداً","يُناخ ببابك الهمُّ العكوف",30,"ف",1,0],["فحزْتَ غرُورًا جاهدًا في مدارهِ","بعذْلٍ مِنَ الإِكْبَار أغْرى وأنكرا",31,"ر",2,0],["فَحُزْتُ المُلْكَ لِلمَلَكُوْتِ سَيْرًا","بِأَنْوَارٍ رَقَيْتُ بِهَا رُقِيَّا",32,"ي",2,0],["فحُزنُ وجهكَ دون النَّاس مُزدحِمٌ","بكُلِّ مَا تحتوي أبعادها الصُّوَرُ",33,"ر",1,0],["فحزني وحسنكِ ضدان ، لكن","كلانا هوى موطناً فاستَقَرَّهْ",34,"ر",2,0],["فحزنُ الزَّهيَّةِ لايرتضي","دواءً بغير الوفا بالعهودْ",35,"د",1,0],["فحزنتُ مِن أحزانها ورثَيتُها","والشعرُ فاض إليكَ بالإلهامِ",36,"م",1,0],["فحزن يعقوب لايكفي لندبك يا","ندبا تفرد بالاجيال والعصر",37,"ر",1,0],["فحزنتُ .. رغم سعادتي .. حُزنَ الذي","فقدَ الشبابَ وضيَّع المولودا",38,"د",2,0]]}