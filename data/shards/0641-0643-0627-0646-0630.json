{"poems":[[84,"بحياة ما ضمت عرى الأزرار","https://www.aldiwan.net/poem29396.html","الكامل"],[63,"عندي إذا مالروض أصبح ذابلا","https://www.aldiwan.net/poem51487.html","الكامل"],[68,"لم تبغ همتك المحل العالي","https://www.aldiwan.net/poem38695.html","الكامل"],[78,"قالوا شبابك قد مضت أيامه","https://www.aldiwan.net/poem38988.html","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[189,"يا رب بدر بات يرشف مسمعي","https://www.aldiwan.net/poem14133.html","الكامل"],[189,"مقل لأفئدة القلوب أواخي","https://www.aldiwan.net/poem14144.html","الكامل"],[356,"يفلقن لجة آله فأمامها","https://www.aldiwan.net/poem68972.html","البسيط"],[376,"سل من أقام من استقلا","https://www.aldiwan.net/poem57228.html","مجزوء الكامل"],[382,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[385,"وافى الرقيب فقلت لا","https://www.aldiwan.net/poem49216.html","مجزوء الكامل"],[408,"كم ذا يذوب أسى وكم يتجلد","https://www.aldiwan.net/poem46938.html","الكامل"],[415,"وافى كتابك معلنا بملامة","https://www.aldiwan.net/poem32245.html","الكامل"],[447,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[457,"لله ربوة جلق من روضة","https://www.aldiwan.net/poem13852.html","الكامل"],[469,"ولقد نزلت بروضة حزينة","https://www.aldiwan.net/poem3231.html","عموديه"],[487,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[532,"بسمت فأبدت جيدها فتكشفت","https://www.aldiwan.net/poem45997.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44580","الكامل"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123693","الكامل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105472","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46513","الرجز"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79388","الكامل"],[2527,"","https://poetry.dctabudhabi.ae/diwan/poem/17703","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58367","البسيط"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109836","الكامل"],[2957,"","https://poetry.dctabudhabi.ae/diwan/poem/198435","المجتث"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62949","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138703",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146754","الكامل"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99123","البسيط"],[469,"ولقد نزلت بروضة حزنية","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574776",""]],"verses":[["فكأن ذاك النهر فيه مجرة","وكأن ذاك الزهر فيه دراري",0,"ر",2,0],["فكأنَّ ذا صاحٍ يَسيرُ مُقوَّماً","وكأنَّ ذا نَشْوانُ يَخطِرُ مائِلا",1,"ل",2,0],["فَكَأَنَّ ذاكَ اليَومَ رِقدَةِ نائِمٍ","وَكَأَنَّ عَيشي فيهِ طَيفُ خَيالِ",2,"ل",1,0],["فكأنَّ ذاكَ العيشَ ظلُّ غَمامَةٍ","وكأنَّ ذاكَ اللهوَ طَيفُ مَنامِ",3,"م",1,0],["فَكانَ ذا عِوضاً مِن ذاكَ فيهِ بَقي","وَفيكَ مَفخَرُ أَخوالي وَأَعمامي",4,"م",2,0],["فكأنّ ذا يأتي بغُرّة وجهِه","وكأنّ ذا يَمْضي بجَعْدِ أَثيثه",5,"ث",2,0],["فكأنّ ذاك الماءَ ليس بمَوْردي ال","صافي ولا ذاك المُناخَ مُناخي",6,"خ",2,0],["فكأن ذا موسى وذاك بإثره","فرعونُ إلا أنه لم يغرقِ",7,"ق",1,0],["فكَأنَّ ذلكَ دارَ في","خَلَدِ المُديرِ فحثَّ رَطلا",8,"ل",2,0],["فَكَأنَّ ذِكريَ بَذلَهُ","وَنَداهُ كانَ نَدىً وَفَضلا",8,"ل",2,0],["فكأن ذاك الموت عنا نائمٌ","إن هبَّ يَحكمُ حكم قاضٍ قد عدل",9,"ل",1,0],["فَكَأنَ ذا لَيل بَدا","وَكَأن ذا صُبح هَجَم",10,"م",1,0],["فكأن ذِكرى أحمدٍ خطرت لَها","ولِذكِرهِ يَنْدَى الجمادُ الجلْمَدُ",11,"د",1,0],["فكأَنّ ذَاكَ الطِّرسَ أضحَى سَلّةَ ال","حاوي وهَاتِيكَ السّطورُ أَفَاعيَا",12,"ي",2,0],["فكأن ذكرك بعد موتك روضة","جيدت فأصبح نبتها يتضوع",13,"ع",1,0],["فكأنَّ ذا دِرْعٌ وذا وشيٌ وذا","قَدٌّ وذا شادٍ هناك يُشنّف",14,"ف",1,0],["فكأن ذا ثغر وذا خد يحا","وله وذا أبداً عيون تحرس",15,"س",1,0],["فكان ذباب السيف فينا لذيذ","علينا بما أبدى بشبه جمان",16,"ن",1,0],["فكأن ذا ذالٍ خلت من نقطةٍ","وكأنّ ذا دالٍ ونقطة ذال",17,"ل",1,0],["فكان ذاك معجزا للناطق","وكان هذا معجزا للصادق",18,"ق",1,0],["فَكَأَنَّ ذلِكَ كانَ وَجهَ مُهَدِّدٍ","وَكَأَنَّ هذا جاءَ وَجهَ مُبَشِّرِ",19,"ر",1,0],["فكأن ذلك لؤلؤ","في أكؤس المرجان حاصل",20,"ل",1,0],["فكأن ذاك العيش عارض مزنةٍ","ألوت به يوم الرحيل نسيم",21,"م",1,0],["فَكانَ ذاكَ مِن لَطيف مَكرِها","أصلح لا شَك فَسادَ أَمرِها",22,"ه",2,0],["فكأنَّ ذاكَ قَذًى لطرفي مُسْهِرٌ","وكأنَّ هذا فيه سيفٌ قاضبُ",23,"ب",1,0],["فَكَأَنَّ ذلِكَ يَومَ حُمَّ قَضاؤُهُ","رَفَدٌ أُميلَ إِناؤُهُ مِهراقُ",24,"ق",1,0],["فَكانَ ذاكَ الطُّلوعُ داءً","يَرقا إلى السّطحِ منْ ضلوعي",25,"ي",1,0],["فكان ذاك الماء عاشق غصنه","وكان ذاك الغصن فيه جفاء",26,"ا",2,0],["فكان ذاك ولكن","زاد الفؤاد استعارا",27,"ر",2,0],["فكأَن ذلكَ مرُّ طي","فٍ جاء في ألأحلامِ زائرْ",28,"ر",1,0],["فكأن ذاك النعي سهم ميتة","فقضت به لهفي لأم القاسم",29,"م",1,0],["فكان ذا على الفتى وبالا","لم يملكوا لدفعه مجالا",30,"ل",2,0],["فكأن ذا يثني، وذا يدعو، وذا","يبدي الرضا ويبوح بالإحماد",31,"د",1,0],["فكان ذا رمدٌ لج الأساة به","وما اهتدوا أن يداووا عينه فعمي",32,"م",2,0],["فكأَنَّ ذا خدٌّ وذا ثغر يحا","وله وذا أبداً عيون تحرسُ",33,"س",1,0]]}