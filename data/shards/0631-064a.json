ُ القِيانَ إلينا","https://www.poetsgate.com/ViewPoem.aspx?id=30802",""],[51,"يا أخي يا أخا الدماثة والرقة","https://www.poetsgate.com/ViewPoem.aspx?id=25882",""],[105,"ألي في الهوى مالي وللائم العذر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54936&r=&rc=106",""],[105,"كيف القرار ونار الحرب تستعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54896&r=&rc=66",""],[30,"يَا دَارَ مَيَّة َ بَالْخَلْصَاءِ غيَّرَهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20514&r=&rc=8",""],[9,"رِيَاحاً لا تُهِنْهُ إنْ تَمَنّى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17263&r=&rc=10",""],[87,"ما لي وَ للدارِ منْ \" ليلى \" أحييها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23936&r=&rc=198",""],[3,"ريحَ الحجاز بحقِّ منْ أنشاكِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10725&r=&rc=79",""]],"verses":[["ريعَةُ الذَودِ قَد أَمِن","نَ عَلى القُربِ حادِيا",0,"ي",2,0],["رَيّانَ وَالأَيّامُ ظَمآنَةٌ","مِنَ النَدى نَشوانَ بِالبِشرِ",1,"ر",1,0],["رَيُّ الخُدودِ مِنَ المَدامِعِ شاهِدٌ","أَنَّ القُلوبَ مِنَ الغَليلِ صَوادِ",2,"د",1,0],["ريحٌ مِنَ الزَفَراتِ تَعصِفُ في الحَشا","وَوَراءَها مَطَرٌ مِنَ العَبَراتِ",3,"ت",1,0],["رِياضٌ تَشُقُّ عَلَيكَ النَسيمَ","وَلَيلٌ يَمُجُّ عَلَيكَ الضُحى",4,"ا",1,0],["رَيّا الَّتي اُختيرَ لَها","بِذي الأَراكِ مَربَعُ",5,"ع",1,0],["رَيَّا المَعاصِمِ ظَمأى الخَصْرِ لا قِصَرٌ","يَزوي عَليها ولا يُزْري بِها طولُ",6,"ل",1,0],["ريحَ الحِجازِ بِحَقِّ مَن أَنشاكِ","رُدّي السَلامَ وَحَيِّ مَن حَيّاكِ",7,"ك",1,1],["ريمٌ رَمى قاصِداً قَلبي بِمُقلَتِهِ","أَفديهِ مِن قاصِدٍ قَلبي وَأَحميهِ",8,"ي",2,0],["ريحٌ إِذا هَبَّت تَنَسَّمتُها","تَأتي قَريباً عَهدُها بِالحَبيب",9,"ب",1,0],["رياضٌ إذا العافِي اسْتَظَلّ ظِلالَها","فَفيها جَنىً مِلْءَ الأكُفِّ وإيرَاقُ",10,"ق",1,0],["رِياحاً لا تُهِنهُ إِن تَمَنّى","مَعارِفَ مِن شِمالي في رِياحِ",11,"ح",1,1],["رِياضُ الأَزبَكِيَّةِ قَد تَحَلَّت","بِأَنجابٍ كِرامٍ أَنتَ مِنهُم",12,"م",1,1],["رِياضُ أَفِق مِن غَمرَةِ المَوتِ وَاِستَمِع","حَديثَ الوَرى عَن طيبِ ما كُنتَ تَصنَعُ",13,"ع",1,1],["ريحَ الشَمالِ عَساكِ أَن تَتَحَمَّلي","خِدَمي إِلى المَولى الإِمامِ الأَفضَلِ",14,"ل",1,1],["رِيفُ مِصْرَ الخَصِيبِ أَحْدَثْتَ فِيهِ","مَأْثَرَاتٍ يَجْدُرْنَ بِالإِعْجَابِ",15,"ب",1,0],["رِيعَ يَتَامَاهُمْ وَأَطْفَالُهُمْ","وَشُرِّدَتْ نِسَّوتُهُمْ باكِيَهْ",16,"ي",2,0],["ريعت له شم الصروح","وعم أهليها حداده",17,"د",2,0],["رَئِيسُهَا مُحْرِزٌ فِي الْفَضْلِ مَنْزِلَةً","فَاقَتْ مَنَازِلَ أَنْدَادٍ وَأَقْرَانِ",18,"ن",1,0],["رِيَاضَةٌ جَمَّةٌ مَنَافِعُهَا","سِلْماً وَحَرْباً لِلْحَاذِقِ الفَهِمِ",19,"م",1,0],["رِيضَ شَيْطَانِهِ فَلَمْ يَرْجُمِ النَّا","سَ بِسُوءٍ وَلَمْ يَكُنْ بِرَجِيمِ",20,"م",1,0],["رِيعَ الأُولى نَظَرُوا إِلَيْهِ وَأَفْظَعُوا","تِلْكَ الكَرَامَةَ وَانْثَنُوا بِتبَرمِ",21,"م",1,0],["رَيّا العِظامِ وَعثَةِ التَوالي","لَفّاءَ في لينٍ وَفي اِعتِدالِ",22,"ل",1,0],["رِياضَةَ مَخلوجٍ وَكُلُّ قَصيدَةٍ","وَإِن صَعُبَت سَهلٌ عَليَّ عَروضُها",23,"ض",3,0],["ريت زهرك ونوارك","ونجومك الكثيرا",24,"ر",2,0],["ريت من تب قبل منها","عاد يجبرط هو عليها",25,"ه",2,0],["رياض سقاها الفكرُ صوبَ ذكائه","فأخصبَ للورَّاد منها مَريعُها",26,"ع",3,0],["رياض تنسّمنا بها الريح ضحوةً","فنمّت لنا من طيبهنّ بأسرار",27,"ر",1,0],["رياض رَعَتْها النائبات بأذْؤب","من الجَور فأرتاعت ظباء وغِزلان",28,"ن",1,0],["رئاء قديم في الورى شقيت به","قبائل منهم جَمةٌ وشعوب",29,"ب",1,0],["ريحٌ خَريقٌ شَمالٌ أَو يَمانِيَةٌ","تَعتادُهُ مِثلَ سَوفِ الرائِمِ الجَلَدا",30,"د",2,0],["رِئاب الصُّدوع غياث المضو","عِ لامتُك الزُّفَر النَّوْفَلُ",31,"ل",1,1],["رَيُه فِيهِمُ كَرَأي ذَو الثُلَّةِ","في الثَائِجَاتِ جُنحَ الظَّلاَمِ",32,"م",1,0],["رِياحٌ عَفَتهُ وَهيَ أَنفاسُ عاشِقٍ","وَوَبلٌ سَقاهُ وَالجُفونُ غَمائِمُه",33,"م",2,0],["رَيّانِ مَتنِ الصَفحَتَينِ رائِقُه","يَكادُ يَجري مِن قَراهُ دافِقُه",34,"ق",2,0],["رئيسٌ إذا أجريت في المِدَحِ اسمهُ","رأيت المالي كيفَ يجرِي ابْتهاجها",35,"ج",3,0],["رئيسٌ رأى آمالنا وهي تشتكي","من الدهر أسقاماً فقال لها صحي",36,"ح",2,0],["رئيسٌ له في العلى منزلٌ","تزلّ الكواكب عن صرحه",37,"ح",2,0],["رئيسٌ تجلَّى بشره ونواله","فلا الأفق مغبرٌّ ولا العام كالح",38,"ح",1,0],["رئيسٌ وفَى حقّ المعالي فحبذا","مهيبٌ وهوبٌ شاملُ الجود زاهد",39,"د",1,0],["رئيس كما ترضى السيادة والعلى","بهِ زال ذلّ الدهر واشْتدَّ أزره",40,"ر",2,0],["رئيسٌ له رأي كما وضحت ذُكا","وجودٌ كما يهمي الغمام ويهمر",41,"ر",1,0],["رئيس محا وِزْرَ الزمان بجوده","وشدّ لأبناء الرجا مئزراً إزرا",42,"ر",2,0],["رئيس إلى علياه تسري مدائحٌ","مواصلة ليست بذات كلال",43,"ل",1,0],["رئيس بيَدِ القائلين سكونه","ويفضل عن يمنى الغمام شماله",44,"ل",2,0],["رئيس حوى فضل المكارم شخصه","كما حوت الألفاظ أحرفَ يعجم",45,"م",1,0],["رئيسٌ على التحقيق قالت صفاته","لنقَّاده ذا ما يخالط ذاما",46,"م",2,0],["رئيس للعلى طالت يداه","ولم يفخر بذاك ولا اسْتطالا",47,"ل",2,0],["رياض محامدهم غضَّة","والسحب عوارفهم هاميه",48,"ي",2,0],["رَيْحانُهم ذهبٌ على دُررٍ","وشرابُهم دُرٌّ على ذهبِ",49,"ب",1,0],["ريحانُ رُوحٍ مُنْهِبٍ عطرَهُ","والروْحُ إذ ذاك هو الناهبُ",50,"ب",1,0],["ريّاً وسقياً أُعقبت منهما","تلك المغاني شرَّ مُستعقَبِ",51,"ب",1,0],["رِيعَ لها الأحياءُ من هوْلها","وأفزع الأموات في البرزخِ",52,"خ",1,0],["ريحُها وهي حيةٌ ريح ميتٍ","باتَ في القبرِ ثم أبداهُ نبشُ",53,"ش",1,0],["ريقٌ غريضٌ وثغرٌ مِنكَ إغريضُ","هما المُنَى لو يُدنِّي منك تركيضُ",54,"ض",1,1],["ريقة لو تُمجُّ مجاً على الأف","عى لباتت بليلة الملدوغ",55,"غ",1,0],["رياضٌ وجناتٌ يهزُّ ثمارها","ونُوَّارَها غُصنٌ ودِعصٌ مركَّمُ",56,"م",1,0],["رَيْحانةٌ لنديمِها دِرْياقةٌ","لسليمها تَشفي سقامَ سقيمِها",57,"م",3,0],["ريحٌ تَهُبُّ له من أرْيَحيَّته","يهتز للبذل عنها وهو جذلان",58,"ن",1,0],["ريقةٌ كالشَّمولِ طِيباً ونشرٌ","كنسيم الشمال خاضَ الجنانا",59,"ن",2,0],["ريثَ ما استحكمتْ له ثم أدلى","دلوه فاستقى بها غيرَ واني",60,"ن",2,0],["رَيّا وَلَم تَدنُ وَلَم تُهَلَّلِ","مِنها فَمَعقولُكَ كَالمُخَبَّلِ",61,"ل",1,0],["رَيبُ المنونِ إِذا الحَياةُ تَنَكَّرَت","أَدنى لِآمالِ النُفوسِ وَأَقرَبُ",62,"ب",1,0],["ريَّانةٌ مِنْ رَيِّقِ الأَنْداءِ","في الفَجْرِ الوَديعْ",63,"ع",1,0],["ريعَت مِنَ البَرقِ وَفي كَفِّها","بَرقٌ مِنَ القَهوَةِ لَمّاعُ",64,"ع",1,1],["ريحان من يرتشف الرضاب","من بنت العنب",65,"ب",1,0],["ريالان بعد الزوج قد رُتبا لها","وذلك نزر ليس بالعيش يكفل",66,"ل",1,0],["رَيّانُ الصَفحَةِ وَالمَنظَر","ما أَبهى الخُلدَ وَما أَنضَر",67,"ر",1,0],["رَياحينُ الرِياضِ يُمَلُّ مِنها","وَرَيحانُ القَرائِحِ لا يُمَلُّ",68,"ل",1,0],["رَياحينُ في أَنفِ الوَلِيِّ وَما لَها","عَدُوٌّ تَراهُم في مَعاطِسِهِ رَغما",69,"م",2,0],["ريمٌ عَلى القاعِ بَينَ البانِ وَالعَلَمِ","أَحَلَّ سَفكَ دَمي في الأَشهُرِ الحُرُمِ",70,"م",1,1],["ريعَت لَها شَرَفُ الإيوانِ فَاِنصَدَعَت","مِن صَدمَةِ الحَقِّ لا مِن صَدمَةِ القُدُمِ",70,"م",1,0],["رَيّانُ مِن مَجدٍ يَعِز","زُ عَلى القُصورِ مُوَثَّلِ",71,"ل",1,0],["رِياضُ طَوَيتَ قَرناً ما طَوَتهُ","مَعَ المَأمونِ دِجلَةُ وَالفُراتُ",72,"ت",1,0],["رَيّانَ لَو قَذَفَ الَّذي أَسقَيتَهُ","لَجَرى مِنَ المُهَجاتِ بَحرٌ مُزبِدُ",73,"د",1,0],["ريَّانُ من ماء الصِّبا شَرِقٌ بهِ","سكرانُ من خمرِ الملاحةِ منتَشي",74,"ش",2,0],["رِيعَ العدوُّ وقد أحسَّ بِقُرْبِها","فالجنبُ نابٍ والرُقَادُ غِرارُ",75,"ر",1,0],["رَيبُ هَذا الزَمانِ فيهِ عَضوضٌ","وَمُحَيّا الزَمانِ عَنهُ قَطوبُ",76,"ب",1,0],["ريحُ الشَمالِ أَتَت بِريحِ شَمالِ","سَحَراً فَهاجَت ساكِنَ البَلبالِ",77,"ل",1,1],["رِياحٌ عَلى أَعطانِهِ حَيثُ تَلتَقي","عَفا وَخَلا مِن عَهدِهِ المُتَقادِمِ",78,"م",1,0],["رياضُ محَاسنٍ وسنا شموسٍ","وظِلُّ دساكرٍ وجَنى كُرومِ",79,"م",1,0],["ريقاً كريقِ النَّحْلَةِ المُزَعْفَرِ","وجاذَبا مِئزَرَ بَسْلِ المِئزَرِ",80,"ر",1,0],["ريَّا أخَاضَتْنا على ظمإِ الهوى","من وعدِها الممطولِ لَمْعَ سَرابِ",81,"ب",1,0],["رياضٌ كلما سُقِيَتْ سَحاباً","بسَيفِ الدولةِ انتظرَت سَحابا",82,"ب",2,0],["رَيّا رَوادِفُهُنَّ يَل","بَسنَ الخَواتِمَ في الخُصورِ",83,"ر",1,0],["ريعَت لِذَمِّ المَطايا لِلسُرى قَعَدَت","وَأَحذَرَتني مِنَ الأَهوالِ في سَفَري",84,"ر",2,0],["ريقُهُ مُعَتَّقَةٌ","ثَغرُهُ لَها حَبَبُ",85,"ب",1,0],["ريقاً لَوِ اِستاقَهُ الصاحي لَمالَ بِهِ","سُكراً وَلَو رَشَفَ السَكرانُ مِنهُ صَحا",86,"ح",2,0],["ريّ عمري من أكاذيب المنى","وطعامي من عفاف وضمير",87,"ر",1,0],["ريحانة النيل هزت نفسها طرباً","وقدمت لأمير الشعر ريحانا",88,"ن",2,0],["ريحانةٌ في لطيفِ الروح قد غُرِسَتْ","لها النسيمُ الذي تُحيي به النّسما",89,"م",2,0],["رِئْمٌ إِذا ما تَغَزّزَتْ أُسُدٌ","عاجلَهَا دلُّهُ فَذَلَّلَها",90,"ل",3,0],["ريقةُ العيشِ بِها فاخلَع عَلى","شَفَتَيها كُلَّ حينٍ شَفَتَيك",91,"ك",1,0],["ريقها في بقيّةِ الليل مسكٌ","شِيبَ بالرّاحِ منه شهدٌ مَشورُ",92,"ر",1,0],["رِياحٌ كَريحِ العَنبَرِ المَحضِ في النَدى","وَلَكِنَّها يَومَ اللِقاءِ زَعازِعُ",93,"ع",1,0],["رَيحانَةُ الفِتيانِ قَد أَصبَحَت","رَهنَ جَبابينَ وَأَرماسِ",94,"س",1,0],["رَيبُ دَهرٍ أَصَمَّ دونَ العِتابِ","مُرصِدٌ بِالأَوجالِ وَالأَوصابِ",95,"ب",1,1],["رَيّا تُجاذِبُ خَصرَها أَردافُها","وَتَطيبُ نَكهَتُها عَلى اِستِنكاهِ",96,"ه",1,0],["ريحانِ مِن صَبرٍ وَنَصرٍ أَبلَيا","رَبعَيهِ لا ريحا صَباً وَشَمالِ",97,"ل",1,0],["رَيّا إِذا النِعَمُ اِنتَقَلنَ تَخَيَّمَت","وَإِذا نَفَرنَ غَدَت عَلَيكَ أَلوفا",98,"ف",2,0],["رِياضٌ لا يَشِذُّ العُرفُ عَنها","وَلا تَخلو مِنَ الهِمَمِ الرِتاعِ",99,"ع",1,0],["رِيَمٌ أَبَت أَن يَريمَ الحُزنُ لي جَلَداً","وَالعَينُ عَينٌ بِماءِ الشَوقِ تَبتَدِرُ",100,"ر",1,0],["رِيعُوا فَذَلُّوا وَلَو طاشُوا لَوَقَّرَهُم","ضَربٌ يُفَرِّقُ مِنهُم مَجمَعَ اللِّمَمِ",101,"م",1,0],["رَيَّانَةُ الْقَدِّ لَوْ أَنَّ الضَّجِيعَ لَهَا","خَافَ الْعُيُونَ عَلَيْهَا كَادَ يَطْوِيهَا",102,"ي",3,0],["رياضُ مدحِكَ تأكيدُ النعوتِ لها","وأن تخالَفْنَ أبدالٌ منَ الزهرِ",103,"ر",1,0],["رَيّانُ فَضَّضَهُ النَدى ثُمَّ اِنجَلى","عَنهُ فَذَهَّبَ صَفحَتَيهِ أَصيلُ",104,"ل",1,0],["رَيّانَ مِن حقٍّ ومن حُرّيةٍ","والحقُّ للوُرَّادِ أطيبُ مَشرعِ",105,"ع",1,0],["رِيعَ جيشُ الجهلِ لمّا جَرَّدُوا","من سَنَى عرفانِه الجيشَ اللُّهاما",106,"م",2,0],["رِيعَتْ من القومِ الدُّهاةِ بحُوَّلٍ","جمّ المكائِد ماكرٍ مختالِ",107,"ل",1,0],["ريعَت له أُمَمُ النِمالِ وَأَجفَلَت","دُوَلُ الثَعالِبِ مِنهُ وَالذُؤبانِ",108,"ن",1,0],["رَئيسٌ وَذو تاجٍ وَشاعِرُ أُمَّةٍ","وَنابِغَةٌ غَمرٌ وَداهِيَةٌ نُكرُ",109,"ر",1,0],["ريعَت لِمَصرَعِهِ المَشارِقُ إِذ مَشى","فيها النَعِيُّ وَأَجفَلَت إِجفالا",110,"ل",2,0],["ريعَ الحَطيمُ فَأَمسى وَهوَ مُنتَفِضٌ","وَأَقلَقَت يَثرِبَ الأَحزانُ وَالذِكَرُ",111,"ر",1,0],["رِيعَتْ يهودُ فجاءَتْ تَبتَغي حِلفاً","عُودِيَ يَهودُ فنعمَ العهدُ والحلفُ",112,"ف",1,0],["رِيعَتْ شيوخُ