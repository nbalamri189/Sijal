{"poems":[[63,"أثرها وهي تنتعل الظلالا","https://www.aldiwan.net/poem46214.html","الوافر"],[93,"تولوا وقدر لي أن أقيما","https://www.aldiwan.net/poem11384.html","المتقارب"],[72,"لسائل دمعي من هواك جواب","https://www.aldiwan.net/poem18231.html","الطويل"],[45,"تخطى الليالي معشرا لا تعلهم","https://www.aldiwan.net/poem10898.html","الطويل"],[87,"بأي غزال في الخدور تهيم","https://www.aldiwan.net/poem8259.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85602","الطويل"],[100,"نهاية حسناء ريفيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50449",""],[100,"أنسى ان أموت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67669&r=&rc=156",""],[151,"تركنا زهيرا للبقيع فثهمد","https://www.aldiwan.net/poem68579.html","الطويل"],[298,"إلام تطيل نوحك يا حمام","https://www.aldiwan.net/poem33161.html","الوافر"],[349,"برغمي إن خلت منه المذاود","https://www.aldiwan.net/poem20065.html","الوافر"],[404,"إلام أرى عاذلي في تعب","https://www.aldiwan.net/poem34155.html","المتقارب"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["وكابي اللّونِ يغْمُرُهُ نَجيعٌ","فَيَصْدَأُ أو أُجِدَّ لهُ صِقالا",0,"ل",2,0],["وَكَابَدَتْ أَرْزَاءهَا هَازِئاً","صَبُوراً لَقَدْ كُنْتَ حَقّاً حَكِيمَا",1,"م",2,0],["وكابدت في المثنَى من العربِ مشتكِي","كما قيلَ لم تلبس عليه ثياب",2,"ب",1,0],["وَكابَدَ مِن شَكوِ الأَميرِ وَوَعكِهِ","تَباريحَ هَمٍّ يَشغَلُ القَلبَ ناصِبُه",3,"ب",2,0],["وَكَابَدْتُ فِيهَا مَا لَوِ انْقَضَّ بَعْضُهُ","عَلَى جَبَلٍ لانْهَالَ مِنْهُ قَوِيمُ",4,"م",1,0],["وَكابدت في تلك الربوع تعاسةً","وَليلاً تثير الشجوَ أَنجمُه الزهر",5,"ر",1,0],["وكابن سبيل جثت وحدها","تهدّج خلف الضيّاع الشكايا",6,"ا",3,0],["وكآبة الغيم الشّتائي وارتجاف العنكبوت","وأسى بلا اسم … واختناقات بلا اسم أو نعوت",7,"ت",1,0],["وَكابَدَ فيهِ القَلبُ لِلبُعدِ شَجوَهُ","فَأُقسِمُ ما إِن كَدَّرَ البَينُ صَفوَهُ وَما",8,"م",2,0],["وَكابدتُ النَوى عشرين عاماً","وَيَومٌ من نَوى الأَحباب عامُ",9,"م",1,0],["وَكَابَدَتِ البَرادِعُ فَقْدَ حُزْمٍ","فَوَا أَسفِي لِمَفقُودٍ وَفَاقِدْ",10,"د",1,0],["وكابد ضيق مكان به","وضيق المعاش وقبح الرتب",11,"ب",1,0],["وكابن مسعود وكابن الأسود","مقداد وابن ياسر فيمن بدي",12,"ي",1,0]]}