{"poems":[[65,"أثرها وهي تنتعل الظلالا","https://www.aldiwan.net/poem46214.html","الوافر"],[95,"تولوا وقدر لي أن أقيما","https://www.aldiwan.net/poem11384.html","المتقارب"],[74,"لسائل دمعي من هواك جواب","https://www.aldiwan.net/poem18231.html","الطويل"],[47,"تخطى الليالي معشرا لا تعلهم","https://www.aldiwan.net/poem10898.html","الطويل"],[89,"بأي غزال في الخدور تهيم","https://www.aldiwan.net/poem8259.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85602","الطويل"],[102,"نهاية حسناء ريفيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50449",""],[102,"أنسى ان أموت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67669&r=&rc=156",""],[154,"تركنا زهيرا للبقيع فثهمد","https://www.aldiwan.net/poem68579.html","الطويل"],[302,"إلام تطيل نوحك يا حمام","https://www.aldiwan.net/poem33161.html","الوافر"],[353,"برغمي إن خلت منه المذاود","https://www.aldiwan.net/poem20065.html","الوافر"],[409,"إلام أرى عاذلي في تعب","https://www.aldiwan.net/poem34155.html","المتقارب"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83304","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48776","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48558","الطويل"],[869,"","https://poetry.dctabudhabi.ae/diwan/poem/145900","الوافر"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107193","الطويل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93093","الرجز"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[2271,"","https://poetry.dctabudhabi.ae/diwan/poem/216324","الوافر"],[2897,"","https://poetry.dctabudhabi.ae/diwan/poem/122225","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138615",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91771","الطويل"],[3766,"","https://poetry.dctabudhabi.ae/diwan/poem/198811","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131057",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114067","المتقارب"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77183","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77152","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45049","المتقارب"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117245","الكامل"],[592,"ألا فذراني من جهول وغاشم","https://www.poetsgate.com/ViewPoem.aspx?id=128817",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5353,"مخاض من الغيظ","https://www.poetsgate.com/ViewPoem.aspx?id=214898",""],[5431,"كافكا والكابوس الوجودي المرعب....","https://www.poetsgate.com/ViewPoem.aspx?id=199352",""],[5672,"خفاء الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=206399",""],[5672,"كآبة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=206509",""],[5912,"لله أنت","https://www.poetsgate.com/ViewPoem.aspx?id=202326",""],[572,"أخٌ لي كُنتُ أُغبَطُ باعتقادِه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9249&r=&rc=106",""]],"verses":[["وكابي اللّونِ يغْمُرُهُ نَجيعٌ","فَيَصْدَأُ أو أُجِدَّ لهُ صِقالا",0,"ل",2,0],["وَكَابَدَتْ أَرْزَاءهَا هَازِئاً","صَبُوراً لَقَدْ كُنْتَ حَقّاً حَكِيمَا",1,"م",2,0],["وكابدت في المثنَى من العربِ مشتكِي","كما قيلَ لم تلبس عليه ثياب",2,"ب",1,0],["وَكابَدَ مِن شَكوِ الأَميرِ وَوَعكِهِ","تَباريحَ هَمٍّ يَشغَلُ القَلبَ ناصِبُه",3,"ب",2,0],["وَكَابَدْتُ فِيهَا مَا لَوِ انْقَضَّ بَعْضُهُ","عَلَى جَبَلٍ لانْهَالَ مِنْهُ قَوِيمُ",4,"م",1,0],["وَكابدت في تلك الربوع تعاسةً","وَليلاً تثير الشجوَ أَنجمُه الزهر",5,"ر",1,0],["وكابن سبيل جثت وحدها","تهدّج خلف الضيّاع الشكايا",6,"ا",3,0],["وكآبة الغيم الشّتائي وارتجاف العنكبوت","وأسى بلا اسم … واختناقات بلا اسم أو نعوت",7,"ت",1,0],["وَكابَدَ فيهِ القَلبُ لِلبُعدِ شَجوَهُ","فَأُقسِمُ ما إِن كَدَّرَ البَينُ صَفوَهُ وَما",8,"م",2,0],["وَكابدتُ النَوى عشرين عاماً","وَيَومٌ من نَوى الأَحباب عامُ",9,"م",1,0],["وَكَابَدَتِ البَرادِعُ فَقْدَ حُزْمٍ","فَوَا أَسفِي لِمَفقُودٍ وَفَاقِدْ",10,"د",1,0],["وكابد ضيق مكان به","وضيق المعاش وقبح الرتب",11,"ب",1,0],["وكابن مسعود وكابن الأسود","مقداد وابن ياسر فيمن بدي",12,"ي",1,0],["وَكابِر قَومٌ يَنظُرونَ بِأَعيُنٍ","أَلا عَمَهُ الأَلبابَ أَعمى مِنَ العَمى",13,"م",2,0],["وكابر الرأي في سلم وفي فزع","ونافذ الشرط في صلح وتحكيم",14,"م",1,0],["وكابدتها حتى رأى كل مبصر","مكابدتي رسماً لعينيه باديا",15,"ي",2,0],["وكابدنا السُّرى شوقاً إليه","فوافينا الصباح مع الصباح",16,"ح",1,0],["وَكَابنَي أَخِيه أَو فَمَن كابنِ عَمِّهِ","وَمَن كَعَلِيٍّ وابنهِ بَهجَةِ القُطرِ",17,"ر",1,0],["وكابدوا على ظما","حرارة القواضب",18,"ب",1,0],["وكابدت منكَ انواع العنا كبدي","فماتَ صبري وهبَّ الدمعُ يندبهُ",19,"ه",1,0],["وكأبن مباركٍ أو كأبن وهبٍ","وكالقطّان ذي شرفٍ وحال",20,"ل",1,0],["وكابن شجاعٍ البلخيّ ثمّ ال","سمرقنديّ من هو رأس مالي",20,"ل",2,0],["وكابن قيس بهم كن مولما","وليمة شهيرة كالفلق",21,"ق",1,0],["وكابد فيها من طغاة زمانه","مصائب حتى قطع السم أحشاه",22,"ا",2,0],["وَكابدتها قُرباً وَبُعداً وَوَحشةً","وَأُنساً وحالَيْ صحةٍ وَمصاب",23,"ب",1,0],["وَكابدت أَحوالَ المدائن حقبةً","وَجبتُ الفضا في وَهدةٍ وَهضاب",23,"ب",1,0],["وكابول تبكي بل \"كسوفا\" وأهلها","ومئذنةَ شيّدتْ وطفل معذب",24,"ب",1,0],["وكآبة الحسناء أف","عل في النفوس من السرور",25,"ر",1,0],["وكابنِ سلامٍ وابن سلامٍ انجلى","خفيفُهُ من ضدٍّ لمن يتكلَّمُ",26,"م",1,0],["وَكَابنِهِ مَن قَد جَنَى زَهرَةَ ال","خلاَفَةِ يَنأى عَنَ اجنَابِهَا",27,"ب",3,0],["وَكابَد حادِثاتِ الدَهر حَتّى","أَشاب قَذالَه حَدثانِ دَهر",28,"ر",1,0],["وَكابَدتُ لَوعاتَ الهَوى وَشُجونَهُ","وَكَم ذُقتُ شَهداً مِنهُ حيناً وَعَلقَما",29,"م",2,0],["وَكابنِ سَلامَةَ في فَضلِهِ","وَقَد سارَ في الناسِ سَيرَ المَثَل",30,"ل",1,0],["وكابَدَ الشَوقَ بلالٌ وَبَرى","جُثمانَهُ مِنَ السقامِ ما بَرى",31,"ا",1,0],["وكآبة المحزون تظهر حالهُ","والصب إن رام التستر يعلَم",32,"م",1,0],["وكابن معين والبخاري ومسلم","وكل إمامٍ في الحديث وعالم",33,"م",1,0],["وكابرتمو المنقول عن كل عالم","ألا فاسأل الأطفال عن ذا لتعلما",34,"م",2,0],["وكابن المديني والبخاري ومسلم","وكالطبري واللكائي من سما",35,"م",2,0],["وكابن جيج والطحاوي ومن على","مناهجهم من كل من كان ضيغما",35,"م",2,0],["وكابرتُ فيما ازدرى خافقي","وأشعلتُ كلَّ الحنايا هممْ",36,"م",1,0],["وكابوسا به نحيا","يهزّ الكون والفلكا !!",37,"ك",2,0],["وكآبة تشجيك عمن فارقوا","عينيك..آه كآبة العشاق",38,"ق",1,0],["وكآبة تشجيك عمن فارقوا","عينيك..آه كآبة الأشواقِ",39,"ق",1,0],["وكابدت ليلا في تباريح صبوتي","أناجيه أشكو وحدتي وبلائي",40,"ا",3,0],["وكابَدَني ولم أرَ قَطُّ أَحْلَى","من المعشوقِ لفظاً في كِبَادِهْ",41,"د",2,0]]}