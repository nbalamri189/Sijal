{"poems":[[53,"هي سلوة ذهبت بكل غرام","https://www.aldiwan.net/poem29797.html","الكامل"],[77,"يا مصطفى الرحمان والنور الذي","https://www.aldiwan.net/poem36534.html","الكامل"],[71,"سرى والليل مزور الجنوب","https://www.aldiwan.net/poem3944.html","الوافر"],[73,"شحطنا وما بالدار نأي ولا شحط","https://www.aldiwan.net/poem11909.html","الطويل"],[88,"ألا من مبلغ عني زنيما","https://www.aldiwan.net/poem44393.html","الوافر"],[51,"ناشدتك الله في قدري ومنزلتي","https://www.aldiwan.net/poem9222.html","البسيط"],[51,"شحا فاه كالتنين نحوي شحوة","https://www.aldiwan.net/poem61991.html","الطويل"],[49,"شحطت عن ذوي المودات داري","https://www.aldiwan.net/poem63116.html","الخفيف"],[97,"قالت تعال فقلت لبيك","https://www.aldiwan.net/poem25091.html","أحذ الكامل"],[33,"طربت وهاجتك الديار البلاقع","https://www.aldiwan.net/poem25889.html","الطويل"],[50,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[50,"بلغ المرعث في الرحيل","https://www.aldiwan.net/poem64864.html","مجزوء الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16681","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54233","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[77,"هاجتك إذ جئت اللوى فزرودا","https://www.poetsgate.com/ViewPoem.aspx?id=34092",""],[90,"لم تُنْصفوا اصوت من النجف","https://www.poetsgate.com/ViewPoem.aspx?id=178980",""],[90,"ذكرى وعد بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[90,"الدم يتكلم بعد عشرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=179112",""],[108,"سابع المستحيلات","https://www.poetsgate.com/ViewPoem.aspx?id=36761",""],[186,"ترك الأنام الموجبات","https://www.aldiwan.net/poem43476.html","مجزوء الكامل"],[186,"دموع العين أربعة تباع","https://www.aldiwan.net/poem43629.html","الوافر"],[189,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[211,"ما عبقر بقدير أن يصوغ هوى","https://www.aldiwan.net/poem46581.html","البسيط"],[235,"إن كان دينك في الصبابة ديني","https://www.aldiwan.net/poem31741.html","الكامل"],[235,"ألا قل لمفتخر بالمجوس","https://www.aldiwan.net/poem32024.html","المتقارب"],[252,"لنا التهنئات وفرط الجذل","https://www.aldiwan.net/poem1435.html",""],[275,"أما الكثيب فما يطار حماه","https://www.aldiwan.net/poem25463.html","الكامل"],[298,"يا حسنها طويثره","https://www.aldiwan.net/poem36842.html","عموديه"],[305,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[364,"أشبه دهري أبناؤه فهم","https://www.aldiwan.net/poem60655.html","المنسرح"],[437,"فؤاد عصاه صبره وهو طالبه","https://www.aldiwan.net/poem2577.html","الطويل"],[441,"عزاء بني سمح فما قد لقي سمح","https://www.aldiwan.net/poem14443.html","الطويل"],[458,"دعها تكن كالسلف من أخواتها","https://www.aldiwan.net/poem56263.html","البسيط"],[461,"إذا ما غزوتم معلمين فراوحوا","https://www.aldiwan.net/poem15096.html","الطويل"],[493,"ما المال إلا ما أفاد ثناء","https://www.aldiwan.net/poem67427.html","الكامل"],[544,"ثمالة الأمل","https://www.aldiwan.net/poem67253.html","عموديه"],[551,"وثقت بكم حتى خجلت وكم جنت","https://www.aldiwan.net/poem47888.html","الطويل"]],"verses":[["شَحَبَ الزَمانُ عَلَيَّ بَعدَ غَضارَةٍ","وَإِذا نَقَضتُ فَقَد قَضَيتُ تَمامي",0,"م",2,0],["شُحُبُ الجُسومِ تخالُهُمْ إذ أجْهَشوا","باناً بأخْلافِ الدَّموعِ مَجودا",1,"د",2,0],["شَحافاهُ عَنِ الِشعرى فَلاحَت","كَمِصباحٍ تَأَلَّقَ في قَليبِ",2,"ب",1,0],["شَحَطنا وَما بِالدارِ نَأيٌ وَلا شَحطُ","وَشَطَّ بِمَن نَهوى المَزارُ وَما شَطّوا",3,"ط",3,1],["شحاك علي بالنكراء شاح","وكم أغراك بالنبهاء مغر",4,"ر",1,0],["شُحّي عليك اقتضاني العذرَ لا ظمَأٌ","مني إلى مدح أسبابي ولا غَرَثُ",5,"ث",1,0],["شحا فاه كالتنين نحويَ شحوة","فقلت له بالله منك أَعوذُ",6,"ذ",1,1],["شَحِطَت عَن ذَوي المَوَدّاتِ داري","وَالقَراباتِ مِن ذَوي الأَرحامِ",7,"م",1,1],["شحبت كلون المغرب الباكي","وتألقت كالنجم عيناها",8,"ه",2,0],["شَحا فاهُ نُطقاً بِالفُراقِ كَأَنَّهُ","سَليبٌ حَريبٌ خَلفَهُ السِربُ جازِعُ",9,"ع",1,0],["شُحّاً عَلَيهِ وَرَهبَةً مِن يَومِهِ","فَالآنَ أَصبَحَ موقِناً بِذِهابِهِ",10,"ب",2,0],["شَحَطَ المَزارُ بِهِ وَلَو","يَدنو إِلَيكَ شَفاكَ قُربُه",11,"ب",2,0],["شَحّ عليها قَيْنُها أنْ تُرى","مَجْهولَةَ الصّانِعِ لم تُوسَم",12,"م",1,0],["شَحُّوا بِأَنْ تَلِدَ الْمَكارِمُ غَيْرَهُمْ","وَهُمُ عَلَى النَّجَداتِ غَيْرُ شِحاحِ",13,"ح",1,0],["شَحُّوا على مُتَع الحياةِ بلحظةٍ","ومشَوا لِورْدِ الموتِ غيرَ شِحاح",14,"ح",1,0],["شحب الجسوم تخالهم إذا أجهشوا","بانا بأخلاف الدموع مجودا",15,"د",2,0],["شحذتَ له الذهن الذكي توقداً","كما شحذت عضبَ الغِرار قُيونه",16,"ن",2,0],["شَحَنَّا دفَتيهِ بمُغمَضاتٍ","\" كأحداقِ المها مرضى صحاح \"",17,"ح",1,0],["شحنوهم من خائنِ وبذئٍ","ومُريبٍ شحنَ القِطارِ المتاعا",18,"ع",2,0],["شحّيتبي دمع الرموش الضليله","ووقّفتني بين الامل والمحاتات",19,"ت",1,0],["شحوا بميسور النوا","ل على القرابة والمعامل",20,"ل",1,0],["شحذت الناس سبعينا تباعا","كريما لا تريع ولا تراع",21,"ع",1,0],["شَحنوهُ منهُم بشرّ ظروفٍ","حَشوُها الشركُ حشوُها الشحناءُ",22,"ا",2,0],["شحرورةٌ تلك أم روحٌ معطّرةٌ","كأنها في شذاها نفحة الكاس",23,"س",1,0],["شَحَذَت لَياليهِ غِرارَ خَلائِقي","بِصَياقِلٍ مِن صَرفِها وَقُيونِ",24,"ن",1,0],["شَحَذتَ غِراراً وَإِنّي إِخالُ","أَنَّ لِهاديكَ ما تَشحَذُ",25,"ذ",1,0],["شَحنتَ الشَوانيَ بالدارِعينَ","فَجاءَتكَ مُوقِرةً بالنَفَل",26,"ل",1,0],["شَحُّوا بهِنَّ وفيهِمُ حَطَّ النَّدَى","قِدْماً رِحالَتَهُ وَخَطَّ بِنَاهُ",27,"ا",2,0],["شحّتْ فماً كبرعمٍ","مغمضٍ من عبهره",28,"ر",2,0],["شُحّاً بأنفاسٍ تعزّ وأنفس","أُنفٍ وَمعطس همّة يترفّعِ",29,"ع",1,0],["شُحٌّ وجُودٌ في الكفِّ منه غدا","عليهما الحُسنُ وهْو مُنقَسِم",30,"م",1,0],["شحذت له من حد رأيك منصلا","يردّ الرزايا لا تفلّ مضاربه",31,"ب",2,0],["شححنا بما تحوي يدانا لحبها","وليس بنا عما يسيء بنا شح",32,"ح",1,0],["شحذوا المُدَى لك دونها فركبِتَها","تغترُّ حتّى طِرتَ في شَفَراتِها",33,"ت",3,0],["شَحافاهُ يومٌ دارميٌّ ولم يكن","لغير حُشاشاتِ الملوك بآكل",34,"ل",1,0],["شَحَّت عَلى الدُنيا المُلوكُ وَعافَها","مَن لَم يُطِع في حِفظِها الأَهواءَ",35,"ا",2,0],["شحذ الفداء يراعَهُ بكِ وانبرى","يسقيه من حبر الخلود ويكتبُ",36,"ب",1,0],["شَحَذْتُكُمُ سيفاً أصُدُّ به العِدى","وما كان عندي أنّ سيفِيَ جارِحِي",37,"ح",2,0]]}