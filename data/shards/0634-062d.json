,"هُوَ الْإِنْسَانُ","https://www.poetsgate.com/ViewPoem.aspx?id=201880",""],[5186,"\"من \"\"البرج\"\" في كانون والليل خيما","https://www.poetsgate.com/ViewPoem.aspx?id=156441",""],[5189,"البخيل","https://www.poetsgate.com/ViewPoem.aspx?id=191485",""],[5302,"خوفي بأن تنأى","https://www.poetsgate.com/ViewPoem.aspx?id=204917",""],[5376,"يا دارُ عودُ الوردِ لمْ يمسِ","https://www.poetsgate.com/ViewPoem.aspx?id=188503",""],[5387,"أفريقيا","https://www.poetsgate.com/ViewPoem.aspx?id=53789",""],[5413,"المعلقة الضائعة","https://www.poetsgate.com/ViewPoem.aspx?id=208590",""],[5431,"اثم المجرة ...","https://www.poetsgate.com/ViewPoem.aspx?id=202563",""],[5431,"ارفق بقلبه .....","https://www.poetsgate.com/ViewPoem.aspx?id=210357",""],[5458,"حاسب نفسك","https://www.poetsgate.com/ViewPoem.aspx?id=72288",""],[5464,"ليالينا عقيمات ... ولكن","https://www.poetsgate.com/ViewPoem.aspx?id=27774",""],[5574,"غربة","https://www.poetsgate.com/ViewPoem.aspx?id=206024",""],[5582,"شاقَتْكَ هِنْدٌ وَأَمْسَى الحَبْلُ مُنْصَرِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63568",""],[5628,"لقاء في هيروشيما(1)","https://www.poetsgate.com/ViewPoem.aspx?id=178534",""],[5628,"شحوب","https://www.poetsgate.com/ViewPoem.aspx?id=191437",""],[5704,"أم المراثي","https://www.poetsgate.com/ViewPoem.aspx?id=191784",""],[5725,"شحرورة","https://www.poetsgate.com/ViewPoem.aspx?id=195122",""],[5747,"سموم الهجر","https://www.poetsgate.com/ViewPoem.aspx?id=61670",""],[5749,"تمتع وعيش","https://www.poetsgate.com/ViewPoem.aspx?id=60182",""],[5749,"الفكلمة","https://www.poetsgate.com/ViewPoem.aspx?id=132697",""],[402,"أنظر إلى ذاك الجدار الحاجب","https://www.poetsgate.com/ViewPoem.aspx?id=35120",""],[5956,"أهجو أحدَ الأعدقاء ‏","https://www.poetsgate.com/ViewPoem.aspx?id=185613",""],[5956,"الداشرة صاحبةُ اليوم الأسود المتوقَّع","https://www.poetsgate.com/ViewPoem.aspx?id=204358",""],[5957,"شحروري","https://www.poetsgate.com/ViewPoem.aspx?id=207428",""],[6069,"حي كتاباً فضضت خاتمه","https://www.poetsgate.com/ViewPoem.aspx?id=105655",""],[5080,"أشجرت ذاتك في أحشاء تربته","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88137&r=&rc=7",""],[6262,"هل تَرْسُمينَ الآن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80110&r=&rc=8",""]],"verses":[["شَحَبَ الزَمانُ عَلَيَّ بَعدَ غَضارَةٍ","وَإِذا نَقَضتُ فَقَد قَضَيتُ تَمامي",0,"م",2,0],["شُحُبُ الجُسومِ تخالُهُمْ إذ أجْهَشوا","باناً بأخْلافِ الدَّموعِ مَجودا",1,"د",2,0],["شَحافاهُ عَنِ الِشعرى فَلاحَت","كَمِصباحٍ تَأَلَّقَ في قَليبِ",2,"ب",1,0],["شَحَطنا وَما بِالدارِ نَأيٌ وَلا شَحطُ","وَشَطَّ بِمَن نَهوى المَزارُ وَما شَطّوا",3,"ط",3,1],["شحاك علي بالنكراء شاح","وكم أغراك بالنبهاء مغر",4,"ر",1,0],["شُحّي عليك اقتضاني العذرَ لا ظمَأٌ","مني إلى مدح أسبابي ولا غَرَثُ",5,"ث",1,0],["شحا فاه كالتنين نحويَ شحوة","فقلت له بالله منك أَعوذُ",6,"ذ",1,1],["شَحِطَت عَن ذَوي المَوَدّاتِ داري","وَالقَراباتِ مِن ذَوي الأَرحامِ",7,"م",1,1],["شحبت كلون المغرب الباكي","وتألقت كالنجم عيناها",8,"ه",2,0],["شَحا فاهُ نُطقاً بِالفُراقِ كَأَنَّهُ","سَليبٌ حَريبٌ خَلفَهُ السِربُ جازِعُ",9,"ع",1,0],["شُحّاً عَلَيهِ وَرَهبَةً مِن يَومِهِ","فَالآنَ أَصبَحَ موقِناً بِذِهابِهِ",10,"ب",2,0],["شَحَطَ المَزارُ بِهِ وَلَو","يَدنو إِلَيكَ شَفاكَ قُربُه",11,"ب",2,0],["شَحّ عليها قَيْنُها أنْ تُرى","مَجْهولَةَ الصّانِعِ لم تُوسَم",12,"م",1,0],["شَحُّوا بِأَنْ تَلِدَ الْمَكارِمُ غَيْرَهُمْ","وَهُمُ عَلَى النَّجَداتِ غَيْرُ شِحاحِ",13,"ح",1,0],["شَحُّوا على مُتَع الحياةِ بلحظةٍ","ومشَوا لِورْدِ الموتِ غيرَ شِحاح",14,"ح",1,0],["شحب الجسوم تخالهم إذا أجهشوا","بانا بأخلاف الدموع مجودا",15,"د",2,0],["شحذتَ له الذهن الذكي توقداً","كما شحذت عضبَ الغِرار قُيونه",16,"ن",2,0],["شَحَنَّا دفَتيهِ بمُغمَضاتٍ","\" كأحداقِ المها مرضى صحاح \"",17,"ح",1,0],["شحنوهم من خائنِ وبذئٍ","ومُريبٍ شحنَ القِطارِ المتاعا",18,"ع",2,0],["شحّيتبي دمع الرموش الضليله","ووقّفتني بين الامل والمحاتات",19,"ت",1,0],["شحوا بميسور النوا","ل على القرابة والمعامل",20,"ل",1,0],["شحذت الناس سبعينا تباعا","كريما لا تريع ولا تراع",21,"ع",1,0],["شَحنوهُ منهُم بشرّ ظروفٍ","حَشوُها الشركُ حشوُها الشحناءُ",22,"ا",2,0],["شحرورةٌ تلك أم روحٌ معطّرةٌ","كأنها في شذاها نفحة الكاس",23,"س",1,0],["شَحَذَت لَياليهِ غِرارَ خَلائِقي","بِصَياقِلٍ مِن صَرفِها وَقُيونِ",24,"ن",1,0],["شَحَذتَ غِراراً وَإِنّي إِخالُ","أَنَّ لِهاديكَ ما تَشحَذُ",25,"ذ",1,0],["شَحنتَ الشَوانيَ بالدارِعينَ","فَجاءَتكَ مُوقِرةً بالنَفَل",26,"ل",1,0],["شَحُّوا بهِنَّ وفيهِمُ حَطَّ النَّدَى","قِدْماً رِحالَتَهُ وَخَطَّ بِنَاهُ",27,"ا",2,0],["شحّتْ فماً كبرعمٍ","مغمضٍ من عبهره",28,"ر",2,0],["شُحّاً بأنفاسٍ تعزّ وأنفس","أُنفٍ وَمعطس همّة يترفّعِ",29,"ع",1,0],["شُحٌّ وجُودٌ في الكفِّ منه غدا","عليهما الحُسنُ وهْو مُنقَسِم",30,"م",1,0],["شحذت له من حد رأيك منصلا","يردّ الرزايا لا تفلّ مضاربه",31,"ب",2,0],["شححنا بما تحوي يدانا لحبها","وليس بنا عما يسيء بنا شح",32,"ح",1,0],["شحذوا المُدَى لك دونها فركبِتَها","تغترُّ حتّى طِرتَ في شَفَراتِها",33,"ت",3,0],["شَحافاهُ يومٌ دارميٌّ ولم يكن","لغير حُشاشاتِ الملوك بآكل",34,"ل",1,0],["شَحَّت عَلى الدُنيا المُلوكُ وَعافَها","مَن لَم يُطِع في حِفظِها الأَهواءَ",35,"ا",2,0],["شحذ الفداء يراعَهُ بكِ وانبرى","يسقيه من حبر الخلود ويكتبُ",36,"ب",1,0],["شَحَذْتُكُمُ سيفاً أصُدُّ به العِدى","وما كان عندي أنّ سيفِيَ جارِحِي",37,"ح",2,0],["شحذوا سيوف الهند","بيضا والرماح الخط سمرا",38,"ر",2,0],["شحَّ النّدى أن يُسقّيها مُجاجتهُ","فجادها مفعمُ الشُّؤبوبِ مِدرارُ",39,"ر",1,0],["شَحطنا عن نظيفٍ شح","طةً أطْوَلَ ما شَحْطَهْ",40,"ط",2,0],["شَحَّ بِالعَرضِ وَجادَ بِاللُهى","فَحَوى المَجدَ بِما جادَ وَشَح",41,"ح",1,0],["شِحرِيَّةٌ نَشَأَت تُضَمِّخُ أَربُعاً","تَنتابُها بِعَبيرِها المُتَضَوِّعِ",42,"ع",1,0],["شحّ الزمان فجدت جودك","بالنفوس وبالنفائس",43,"س",1,0],["شح الزمان وأظلمت","جنباته وطغت حنادس",43,"س",1,0],["شحطنا وما بالدار نأيٌ ولا شحط","وشط بمن نهوى المزارُ ولا شطوا",44,"ط",3,1],["شحذت بالذكا ذهن غبيّ","أنطقت كل أبكم لا يناجي",45,"ج",2,0],["شَحيحٌ عَلى عِرضِهِ","وَفي مالِهِ مُسرِفُ",46,"ف",1,0],["شحطَ الحبيب فما يطاق مَزارُهُ","فمتى بَعيدُ الدَّار تقربُ دارُهُ",47,"ر",2,1],["شحيحٌ ولكنٍّى بُليت بحُبِّهِ","وأعجبُ شىءٍ أن يُحَبَّ شحيحُ",48,"ح",1,0],["شح الغني بماله فتألبت","فئة عليه أضرها الإعدام",49,"م",1,0],["شَحراً وَعَدواً وَعَينُ غَيرُ غافِلَةٍ","عَنِ الغُبارِ وَظَنّاً أَن سَتُتبَعُ",50,"ع",1,0],["شحرورُ أهلِ الشامِ بلبلُ دوحِها","مَنْ حازَ في فنِّ البديعِ مَعاليا",51,"ي",2,0],["شحّاً فسموهُ بهذا الاسمِ","وصار في الألقاب مثل الوسم",52,"م",1,0],["شحط المزار فلا قرار ونافرت","عيني الهجوع فلا خيالٌ يعتري",53,"ر",2,0],["شحذت شبا عضبي وأطلقت مضربي","وزدتَ صقالا فيَّ رقرَق إفرندي",54,"د",2,0],["شَحطَ المَزارُ فَلا مَزارَ وَنافَرَت","عَيني الهُجودَ فَلا خَيالٌ يَعتَري",55,"ر",2,0],["شح باذرع امرىء القيس وقد","ترك نجله غسيل العلق",56,"ق",1,0],["شح برد كلب صيد وهجا","أربابه ظلما فلم يصدّق",56,"ق",1,0],["شحذت سنان العزم بعد انثلامه","وأرهفت حد الحزن وهو كليل",57,"ل",1,0],["شحنت سفائن الآمال نجحاً","إِذا وَقفت بساحلك السفينُ",58,"ن",1,0],["شحت يه تلك السجون","وارخصته للحود",59,"د",1,0],["شحذت غرار في النفوس وقدست","ذكرى الحجيج إلى هدى العرفان",60,"ن",1,0],["شَحيحَ مِن سَواجيهِ كَريمٌ","يَرى هَجرَ المُحِبِّ مِنَ السَماحِ",61,"ح",1,0],["شح عليه إذ رأى حسنها","وهي بلحم الطير مشحونة",62,"ن",2,0],["شحطتْ برايةً عن رسُومك طِيةٌ","زورآءُ تجنح للمرامِ الأبعدِ",63,"د",1,0],["شحطوا فظلتُ أريق ماء مدامعٍ","بلَّت حمائلَ ذي الرِّقابِ هواتنِ",64,"ن",1,0],["شحط المزار على علياء شامخة","من دون قنتّها يُستنزل المطر",65,"ر",1,0],["شحُومَ عُجُولي قد دَفَعتُ وَسُوقَها","لِتُحرَقَ اَنَّى شادض قَومُكَ هَيكَلا",66,"ل",2,0],["شحذتم لي حد سيف النوى","فلم يدع لي قط من رسم",67,"م",1,0],["شَحْناؤهُ شَحَنَتْ جواريَ فُلْكهِ","جَوْراً ومالَ بهُلكهِ مَلاَّحُهُ",68,"ح",2,0],["شح مطاع وهوى متبع","والعجب بالنفس تأمل ترشد",69,"د",1,0],["شَحَنّا جانِبَ المَلطاطِ مِنّا","بِجَمعٍ لا يَزولُ عَن البِعادِ",70,"د",1,0],["شحرور دوح الكمال بلبله","رقى إلى أوج رفعة وقرى",71,"ر",2,0],["شحذ النصل منه القلبَ حديدٍ","وكذا يشحذ الحديدُ الحديدا",72,"د",2,0],["شحَّتْ على الحملان حاملةً","خيراتِها نَحو العِدَى كرما",73,"م",2,0],["شحوا وجُدتَ وما استوى يوماً بما","قد كان يأتي سافل ونبيل",74,"ل",1,0],["شَحَذوا سيوفَهُمُ الأُباةُ فكُلُّ مَنْ","والاهُ في سَفكِ الدِّما أنْ يتبَعَهْ",75,"ع",2,0],["شحَّتْ على نبضِ الحياةِ عيونُهُ","ُوتدفَقَتْ بالموتِ نهراً أحمرَا",76,"ر",2,0],["شحت علينا حنانا في أمومتِها","وأنكرتنا بها أحنى نواحينا",77,"ن",2,0],["شحت الصدفه تجيبك وآلوفآ أعلن نزوح","والزمن دولاب داير والظلآم آوفى خليل",78,"ل",1,0],["شحتي أبمجدولك علي وأنفهقتي","من غرت(ن) مثل القمر تفرقينه",79,"ن",2,0],["شُحُوْبٌ ثُمَّ يَتْلُوْهُ اصْفِرَارٌ","هَشِيْمٌ رَهْنَ ذَرْوِ الذَّارِيَاتِ",80,"ت",1,0],["شحوب على غض الشباب ومسحة","من الحسن في إطمار بؤس تجسما",81,"م",2,0],["شُحُّ الكفوفِ خطيئةٌ مذمومةٌ","تهوي بصاحِبها بنارِ جهنَّمِ",82,"م",1,0],["شح اللقا ما بيننا وانطفت","نار الهوى والكلف الأعمق",83,"ق",1,0],["شح وفرق بين مستعبد","للشح والمعطاء والمنفق",83,"ق",1,0],["شحذوا السيوفَ لقطع دابرنا","أتت الجموع بوجهها العبسِ",84,"س",1,0],["شحّت مياه النبع . جفَّت أنهرُ","ماتَ القطيع وشحَّ غيثُ في السما",85,"م",2,0],["( شحرور ) وُوريَ و( القرآن معجزةٌ)","تبقى( صحيحُ البخاري ) النحلُ والعسل",86,"ل",1,0],["شحوبٌ على وجه البسيطة أفزعه","يمرّ على حيّ النفوس المجوّعةْ",87,"ع",2,1],["شحوبٌ على وجه القصيدة مربكٌ","كحيرة درويشٍ أضاع تصوّفه !!",88,"ف",2,0],["شحيحٌ قد تناسى ما عليه","وإعجابٌ بتاج الكبرياء",89,"ا",2,0],["شحوبٌ وارتجافُ يدٍ وخطوٌ","لِثِقل ِ همومِهِ إنْ سارَ مالا",90,"ل",2,0],["٤- شحّت فجاد الكرى في طعْنِ أخيلتي","في معقلِ الشّوقِ لم تعلمْ خطاياها",91,"ا",3,0],["شَحُّوا بِأَمْوالِهِمْ فِي العَيْشِ وَاحْتَرَصُوا","حَتَّى أَقامُوا لَها مِنْ بُخْلِهِمْ حَرَما",92,"م",2,0],["شحبتْ جنائنها الجميلةُ فاختفتْ","منها الزهورُ وعطرها الفوّاحُ",93,"ح",1,0],["شحوبٌ يلوّنُ أيّأمنا","فليسَ هنالك َ شئٌ يُثيرْ",94,"ر",1,0],["شَحَّتْ غيومي لم تعُدْ هطَّالةً","أمستْ ينابيعُ الحنان تحرَّمُ",95,"م",1,0],["شحرورتي يبكي المساء لحزنها","واذا شدت كل الطيور تغرّدُ",96,"د",1,0],["شح الوصال وسموم الهجر منصاعه","في وجهة اللي همومه كيف يردعها!!",97,"ع",3,0],["\\شحال من واحد فلحظة طيش","خلى وراه لي ما يرحمو علاش",98,"ش",1,0],["شحال من كلمة تخدع","وتخلط الدنيا عجينة علينا",99,"ن",2,0],["شحال من مول كلمة يتباع","ولعنا كنسو وخزينا",99,"ن",2,0],["شحذت جنادله له أنيابها","وتشبهت أمواجه بمخالب",100,"ب",1,0],["شحذتَ بحيلة كبرى حروفي","لتُمْدَحَ بالسماحة والفُهُومِ",101,"م",1,0],["شحاذة ووضيعة لا تكتفي","مهما تكدِّسْ من جبال فلوسِ",102,"س",1,0],["شحروريْ هذا من نبضي","من عزف فؤاديْ للوتر ِ",103,"ر",1,0],["شح بألفاظه وخاطره","بالدر من كل خاطرٍ أسمح",104,"ح",1,0],["شحذت لحظة وصل، هل ستنكرها؟","وكيف تنكر سكرا عند لحظته",105,"ت",2,0],["شحبتْ مرايا الروحِ من غَبَشِ الرؤى","ويداكِ أبسطُ مِنْ تفاعيلِ القصيده",106,"د",2,0]]}