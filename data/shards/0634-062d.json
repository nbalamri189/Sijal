{"poems":[[53,"هي سلوة ذهبت بكل غرام","https://www.aldiwan.net/poem29797.html","الكامل"],[77,"يا مصطفى الرحمان والنور الذي","https://www.aldiwan.net/poem36534.html","الكامل"],[71,"سرى والليل مزور الجنوب","https://www.aldiwan.net/poem3944.html","الوافر"],[73,"شحطنا وما بالدار نأي ولا شحط","https://www.aldiwan.net/poem11909.html","الطويل"],[88,"ألا من مبلغ عني زنيما","https://www.aldiwan.net/poem44393.html","الوافر"],[51,"ناشدتك الله في قدري ومنزلتي","https://www.aldiwan.net/poem9222.html","البسيط"],[51,"شحا فاه كالتنين نحوي شحوة","https://www.aldiwan.net/poem61991.html","الطويل"],[49,"شحطت عن ذوي المودات داري","https://www.aldiwan.net/poem63116.html","الخفيف"],[97,"قالت تعال فقلت لبيك","https://www.aldiwan.net/poem25091.html","أحذ الكامل"],[33,"طربت وهاجتك الديار البلاقع","https://www.aldiwan.net/poem25889.html","الطويل"],[50,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[50,"بلغ المرعث في الرحيل","https://www.aldiwan.net/poem64864.html","مجزوء الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16681","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54233","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[77,"هاجتك إذ جئت اللوى فزرودا","https://www.poetsgate.com/ViewPoem.aspx?id=34092",""],[90,"لم تُنْصفوا اصوت من النجف","https://www.poetsgate.com/ViewPoem.aspx?id=178980",""],[90,"ذكرى وعد بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[90,"الدم يتكلم بعد عشرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=179112",""]],"verses":[["شَحَبَ الزَمانُ عَلَيَّ بَعدَ غَضارَةٍ","وَإِذا نَقَضتُ فَقَد قَضَيتُ تَمامي",0,"م",2,0],["شُحُبُ الجُسومِ تخالُهُمْ إذ أجْهَشوا","باناً بأخْلافِ الدَّموعِ مَجودا",1,"د",2,0],["شَحافاهُ عَنِ الِشعرى فَلاحَت","كَمِصباحٍ تَأَلَّقَ في قَليبِ",2,"ب",1,0],["شَحَطنا وَما بِالدارِ نَأيٌ وَلا شَحطُ","وَشَطَّ بِمَن نَهوى المَزارُ وَما شَطّوا",3,"ط",3,1],["شحاك علي بالنكراء شاح","وكم أغراك بالنبهاء مغر",4,"ر",1,0],["شُحّي عليك اقتضاني العذرَ لا ظمَأٌ","مني إلى مدح أسبابي ولا غَرَثُ",5,"ث",1,0],["شحا فاه كالتنين نحويَ شحوة","فقلت له بالله منك أَعوذُ",6,"ذ",1,1],["شَحِطَت عَن ذَوي المَوَدّاتِ داري","وَالقَراباتِ مِن ذَوي الأَرحامِ",7,"م",1,1],["شحبت كلون المغرب الباكي","وتألقت كالنجم عيناها",8,"ه",2,0],["شَحا فاهُ نُطقاً بِالفُراقِ كَأَنَّهُ","سَليبٌ حَريبٌ خَلفَهُ السِربُ جازِعُ",9,"ع",1,0],["شُحّاً عَلَيهِ وَرَهبَةً مِن يَومِهِ","فَالآنَ أَصبَحَ موقِناً بِذِهابِهِ",10,"ب",2,0],["شَحَطَ المَزارُ بِهِ وَلَو","يَدنو إِلَيكَ شَفاكَ قُربُه",11,"ب",2,0],["شَحّ عليها قَيْنُها أنْ تُرى","مَجْهولَةَ الصّانِعِ لم تُوسَم",12,"م",1,0],["شَحُّوا بِأَنْ تَلِدَ الْمَكارِمُ غَيْرَهُمْ","وَهُمُ عَلَى النَّجَداتِ غَيْرُ شِحاحِ",13,"ح",1,0],["شَحُّوا على مُتَع الحياةِ بلحظةٍ","ومشَوا لِورْدِ الموتِ غيرَ شِحاح",14,"ح",1,0],["شحب الجسوم تخالهم إذا أجهشوا","بانا بأخلاف الدموع مجودا",15,"د",2,0],["شحذتَ له الذهن الذكي توقداً","كما شحذت عضبَ الغِرار قُيونه",16,"ن",2,0],["شَحَنَّا دفَتيهِ بمُغمَضاتٍ","\" كأحداقِ المها مرضى صحاح \"",17,"ح",1,0],["شحنوهم من خائنِ وبذئٍ","ومُريبٍ شحنَ القِطارِ المتاعا",18,"ع",2,0]]}