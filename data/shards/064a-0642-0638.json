ctabudhabi.ae/diwan/poem/40135","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40081","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77090","الكامل"],[4013,"","https://poetry.dctabudhabi.ae/diwan/poem/113663","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104519","الخفيف"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136405",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139732",""],[5050,"أشجع الناس من الحرب اشتهى","https://www.poetsgate.com/ViewPoem.aspx?id=38206",""],[5111,"غَفْوَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212512",""],[5111,"عَشْتَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=212606",""],[5136,"أضحك النصر مبسم العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=121488",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[5145,"عهد الصبى أين ذاك المشرع الصافي","https://www.poetsgate.com/ViewPoem.aspx?id=108252",""],[5183,"الصاروخ","https://www.poetsgate.com/ViewPoem.aspx?id=180184",""],[5431,"يؤله الفِكْر لكنْ ظلَّ إنسانا","https://www.poetsgate.com/ViewPoem.aspx?id=187644",""],[5542,"صرخة مرصعة بالإخلاص","https://www.poetsgate.com/ViewPoem.aspx?id=10073",""],[5751,"حفل الموت","https://www.poetsgate.com/ViewPoem.aspx?id=214810",""],[402,"حي الجماعة جاوزت","https://www.poetsgate.com/ViewPoem.aspx?id=35455",""],[5786,"يا بارقاً لاحَ من أكتاف كوفانِ","https://www.poetsgate.com/ViewPoem.aspx?id=50655",""],[5956,"لبيكِ يا خطيبتي ثم قرينتي رفاه","https://www.poetsgate.com/ViewPoem.aspx?id=208836",""],[402,"سل القضاء يجب ما كان جهبذه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54022&r=&rc=874",""],[572,"يَقِظٌ يَلمَحُ الخطوبَ بتدبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9215&r=&rc=72",""]],"verses":[["يَقظانُ مُذ ذُمَّ الكَرى ما ناما","قَد بَعَثوهُ شائِماً فَشاما",0,"م",2,0],["يَقظانَ يَخرُجُ في الخُطوبِ وَيَنثَني","وَلُهاهُ لِلكَلمِ اَلرَغيبِ أَواسِ",1,"س",1,0],["يَقْظَانُ لاَ حِفْظُ الثُّغُورِ يَؤُودُهُ","كَلاَّ وَلاَ صَعْبُ الأُمُورِ يَهُولُهُ",2,"ل",2,0],["يَقِظٌ يَكادُ يُريهِ ثاقِبُ فِكرِهِ","في يَومِهِ ما سَوفَ يَأتيهِ غَدا",3,"د",2,0],["يَقظانُ لِلمَجدِ يَحمي ما تَوارَثَهُ","آباؤُهُ الصيدُ مِن فَخرٍ أَبٌ فَأَبُ",4,"ب",1,0],["يَقظٌ يَكادُ يَقولُ عَمّا في غَدٍ","بِبَديهَةٍ أَغنَتهُ أَن يَتَفَكَّرا",5,"ر",2,0],["يَقظانُ لَم يَكتَحِل غَمضاً مُراقَبَةً","لَرابِطِ الجَأشِ مِقدامٍ عَلى الغِرَرِ",6,"ر",1,0],["يَقْظَانَ لا يَرْتَقِي زور إِلَيْهِ وَلا","تُضِلُّهُ الشُّبَهُ المُزْجَاةُ وضالتُّهَمُ",7,"م",1,0],["يُقِظنَ الحِمى وَالرَملُ مِنهُنَّ مَربَعٌ","وَيَشرَبنَ أَلبانَ الهَجانَ النَجائِبِ",8,"ب",1,0],["يَقظٌ في الهَناتِ ذو حركات","لسكون القلوب ذاتِ الوجيبِ",9,"ب",1,0],["يقظانُ مازال تُغْنيه قريحَتُهُ","عن التجاربِ يَلقاهُنَّ والدُّرَبِ",10,"ب",1,0],["يقظانُ فيه تساقُطٌ وتغافُلٌ","إذْ في سواه تسقُّطٌ وتغفُّلُ",11,"ل",1,0],["يقظانُ إنْ نام أو تنبه كال","نار إذا ما حَششتها الضرَّمَا",12,"م",2,0],["يقظانُ من رَوَعٍ وسْنانُ من وَرَعٍ","يا حبَّذا سيِّدٌ يقظانُ وسنان",13,"ن",1,0],["يقظ الناس من كراها تحيي","موكب الشمس طالعاً في جلال",14,"ل",1,0],["يَقظانَ يَنتَخِبُ الكَلامَ كَأَنَّهُ","جَيشٌ لَدَيهِ يُريدُ أَن يَلقى بِهِ",15,"ب",2,0],["يَقَظاتُ المُحِبُّ ساعَةُ بُؤسا","هُ وَنَعماءُ عَيشِهِ في هُجودِه",16,"د",2,0],["يَقَظاتٌ إِذا تَناصَرنَ لِلنا","صِرِ أَوجَبنَ أَن يَعِزَّ نَصيرُه",17,"ر",2,0],["يَقِظٌ إِذا اِعتَرَضَ الخُطوبَ بِرَأيِهِ","تَرَكَ الجَليلَ مِنَ الخُطوبِ دَقيقا",18,"ق",2,0],["يَقَظاتُهُ وَاللَيلُ مُرخٍ سَجفَهُ","تَرَكَت عُيوناً ما لَهُنَّ منامُ",19,"م",1,0],["يَقِظٌ إذا اتَّقَدَتْ عَزائِمُ رَأيِه","أَخمَدْنَ رَأيِ النَّاكبِ المتجبِّرِ",20,"ر",1,0],["يقظانُ ينتجعُ الحتوفَ وقد","جعَلَ السَّبيلَ إلى العُلى الصَّبرا",21,"ر",2,0],["يَقِظٌ قَد رَعى الأَنامَ بِطَرفٍ","رَدَّ عَنهُ الرَدى بِطَرفٍ عَمِيِّ",22,"ي",1,0],["يَقظانُ يُرضيكَ نَجواهُ وَخاطِرُهُ","إِن قالَ أَفهَمَ أَو أَسمَعتَهُ فَهِما",23,"م",2,0],["يَقِظُ الآراءِ مَسلوبُ الكَرى","مُستَجيشُ العَزمِ مَتعوبُ الوَشا",24,"ش",2,0],["يَقظانَ لا يَصبو إِلى خَفقِ الصَبا","وَلا يَلينُ لِلجَنوبِ جانِبا",25,"ب",2,0],["يَقظانُ يَقرَأُ مِن عِنوانِ فِكرَتِهِ","في يَومِهِ ما طَواهُ في الضَميرِ غَدُ",26,"د",1,0],["يَقظانُ مِنهُ عُيونُ الناسِ راقِدَةٌ","وَلَو تَوَعَّدَ أَهلَ الكَهفِ ما رَقَدوا",26,"د",3,0],["يَقظانُ أَلقى في حَبائِلِ عَزمِهِ","شُرُكاً يَصيدُ بِها الكُماةَ الصيدا",27,"د",2,0],["يقظةٌ طاحت بأحلام الكَرَى","وتولّى الليلُ واللَّيل صَدِيق",28,"ق",1,0],["يقظان ينتظر المآب","وَثَوَى يُرَاقب خَلفَ باب",29,"ب",1,0],["يَقِظٌ إذا التبستْ أمورُ زمانه","فلرأيه في لَبْسها إيضاحُ",30,"ح",1,0],["يَقِظٌ إِذا ما المُشكِلاتُ عَرَونَهُ","أَلفَينَهُ المُتَبَسِّمَ البُهلولا",31,"ل",2,0],["يَقِظٌ وَهوَ أَكثَرُ الناسِ إِغضاءً","عَلى نائِلٍ لَهُ مَسروقِ",32,"ق",1,0],["يَقظانُ أَحصَدَتِ التَجارِبُ حَزمَهُ","شَزراً وَثُقِّفَ عَزمُهُ تَثقيفا",33,"ف",2,0],["يَقِظٌ يَخافُ المُشرِكونَ شَذاتَهُ","مُتَواضِعٌ يَعنو لَهُ الجَبّارُ",34,"ر",1,0],["يَقِظٌ ذَكا فَهماً وَأَشرَفَ هِمَّةً","وَكَفاكَ مِن نارٍ بِهِ وَمَنارِ",35,"ر",1,0],["يَقِظِ العَينَينِ وَالرَأَي مَعاً","وَهوَ ماضٍ كَالحُسامِ المِخذَمِ",36,"م",1,0],["يَقظانُ يَلفِظُ نورَهُ","نوراً تَأَلَّقَ وَاِختَفى",37,"ف",2,0],["يَقِظُ الْبَصِيرَةِ لَوْ سَرَتْ في عَيْنِهِ","سِنَةُ الرُّقَادِ فَقَلْبُهُ لَمْ يَرْقُدِ",38,"د",1,0],["يَقْظَى تصَرفُ بِر أَهْ","لِ الْبِرِّ فِي نَهْجِ السَّدَادْ",39,"د",1,0],["يَقِظَيْنِ مُؤْتَمَنَيْنِ عَنْ ثِقَةٍ عَلَى","مَا فِي ذِمَامِهِمَا مِنَ الأمْوَالِ",40,"ل",1,0],["يَقِظٌ لِنَفْعِ الْخَلْقِ عَا","فِي الخلْقِ عَنْ رُوَّامِ ضُرِّكْ",41,"ك",1,0],["يَقِظٌ لِكُلِّ جَلِيلَةٍ وَدَقِيقَةٍ","حَذِرٌ وَلَكِنْ لَيْسَ بِالهَيَّابِ",42,"ب",1,0],["يَقِظٌ يُنَبِّهُ كَامِنَاتِ خِصَالِهِ","تَنْبِيهَ مَعْرِفَةٍ وَخُبْرٍ وَاسِعِ",43,"ع",1,0],["يَقِظٌ عَدَّتِ العُقول ذُكاءً","قَبَساً مِن ذكائِهِ مَشبوبا",44,"ب",2,0],["يَقِظاً كانَ إِن يُصِخ","لِلأَحاديثِ يَنقه",45,"ه",1,1],["يقظانُ لا رعيُهُ الإخوانَ ترجيةٌ","كلا ولا رميهُ الأعَداءَ تنبيض",46,"ض",1,0],["يَقَظَاتُ المُحِبّ ساعَاتُ بُؤسَا","هُ، نُعمَاءُ عَيشُهُ في هُجودِهْ",47,"د",2,0],["يَقظ بِأَعقاب الأُمور كَأَنَّما","جَليت عَلَيهِ حَقائق الأَشياء",48