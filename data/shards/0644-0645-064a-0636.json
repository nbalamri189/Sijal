{"poems":[[93,"يا لعهد الصبا تقضي وشيكا","https://www.aldiwan.net/poem9159.html","الخفيف"],[93,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[93,"يا رئيسي وأوليائي وآلي","https://www.aldiwan.net/poem11467.html","الخفيف"],[88,"للجعفرين شهادة الأبرار","https://www.aldiwan.net/poem45042.html","الكامل"],[72,"يا إماما في مدح علياه صدق","https://www.aldiwan.net/poem18491.html","الخفيف"],[51,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[51,"لم يضحك الشيب في فوديه بل كلحا","https://www.aldiwan.net/poem9421.html","البسيط"],[51,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[51,"ذكر الحبيب فقام فردا","https://www.aldiwan.net/poem11454.html","مجزوء الكامل"],[89,"ذهبت ايام الشباب سراعا","https://www.aldiwan.net/poem44894.html","الخفيف"],[45,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[45,"ماجو خبت وإن نأت ظعنه","https://www.aldiwan.net/poem66814.html","المنسرح"],[49,"عجبا ما ينقضي مني لمن","https://www.aldiwan.net/poem63154.html","الرمل"],[75,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85531","البسيط"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20249","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54891","الخفيف"],[197,"هدم الأنام وجئت انت تشيد","https://www.aldiwan.net/poem45155.html","الكامل"],[235,"يا أخا اللب يا بديع القيل","https://www.aldiwan.net/poem18869.html","الخفيف"],[273,"أذنت أرض العدى بافتتاح","https://www.aldiwan.net/poem25601.html","المديد"],[347,"لما دعاني الهوى من ربة الكلل","https://www.aldiwan.net/poem15862.html","البسيط"],[365,"مثل عداء بروضات القطا","https://www.aldiwan.net/poem4617.html","الرمل"],[388,"واعتقد أن الخلايق أجمعين","https://www.aldiwan.net/poem54434.html","عموديه"],[413,"بارق لاح فأبكاني ابتساما","https://www.aldiwan.net/poem54109.html","الرمل"],[429,"يا بن من شاب في ممارسة الكعك","https://www.aldiwan.net/poem12565.html","الخفيف"],[446,"لم يضن بحبى لك جسمى البالي","https://www.aldiwan.net/poem53807.html","الدوبيت"],[462,"ته على النجم والمحل الأثيرِ","https://www.aldiwan.net/poem3281.html","عموديه"],[466,"لا سلم الله ربي","https://www.aldiwan.net/poem59645.html","المجتث"],[560,"ويلاه من عرس تحول مأتما","https://www.aldiwan.net/poem52772.html","الكامل"]],"verses":[["لم يضق صدرها الرحيب على ما","كلفته بلاجئ أو بجال",0,"ل",1,0],["لَمْ يَضِعْ رَاحِلٌ وَفِي نَفْسِ كُلٍّ","مِنْ بَنِيهَا لَهُ قَرَارٌ مَكِينُ",1,"ن",1,0],["لَمْ يَضِقْ صَدْرُهَا الرَّحِيبُ عَلَى مَا","كُلِّفَتْهُ بِلاَجِيءٍ أَوْ بِجَالِي",2,"ي",1,0],["لم يضحكا مستهزئين من الردى","إلاّ بثغر الصارم البتار",3,"ر",1,0],["لم يضعْ غير نشرها إنما غا","بت وعادت للباب ذا مفتاح",4,"ح",1,0],["لم يَضِرهُ أن لم يكن عربياً","دارهُ قَرْقَرى أو المَرُّوتُ",5,"ت",1,0],["لم يضْحك الشَّيبُ في فَوْدَيهِ بل كلَحَا","سَمِّ القبِيحَ من الأسْماءِ ما قَبُحَا",6,"ح",2,1],["لمْ يضرْهَا أنْ لَمْ يقلْها النُّوَاسي","يُ ولا شَيْخُ بُحْتر بن عَتُودِ",7,"د",1,0],["لم يضْطَجِعْ إلا لِيَعْ","فِر في تراب الأرض خدَّا",8,"د",2,0],["لم يضر رأيي في الحياة فتيلا","انه لا يرى له اشياعا",9,"ع",2,0],["لَم يُضِع مَنهَجَ الصَوابِ وَلَم يَر","مِ بِسَهمٍ في الرَأيِ غَيرِ سَديدِ",10,"د",1,0],["لَم يَضرِبِ الهَرمُزانُ فيهِ وَلا","مارَمَّةٌ خالُهُ وَلا خَتَنُه",11,"ن",2,0],["لَم يَضِر بُخلُ بَخيلٍ غَيرَهُ","فَهُوَ المَغبونُ لَو كانَ فَطِن",12,"ن",1,0],["لم يُضرِموا ناراً لهَيبتِها ولمْ","يَسطَعْ بأكنافِ الفَضاء دُجانها",13,"ن",3,0],["لم يضمن الشعرُ حقاً عنده ليَ في","يوم وأما الَّذي عندي فمضمون",14,"ن",1,0],["لَم يَضِرهُ فُقدانُهُ نورَ عَينَي","هِ إِذا اِعتاضَ عَنهُما بِأَنيسِ",15,"س",1,0],["لَمْ يُضِرْ مَنْ رَمَاكَ مَجْدَكَ لَكِنْ","كَادَ مِنْ جَهْلهِ الْبِلادَ يَضِيرُ",16,"ر",1,0],["لم يضربوا بسيوفهم كي يكسروا","هاماً ولكن قيدَ من يتقيدُ",17,"د",1,0],["لَمْ يَضِرْهُ خَرْمُ التَّعَاقُبِ إِذْ أَبْ","دَى الْمَعَانِي غَرِيبَةَ التَّحْجِيلِ",18,"ل",1,0],["لم يَضِقْ بالصَّوْلِ والطَّوْلِ ذَرْعاً","كيفَ والبأسُ مُؤاخي السّمَاح",19,"ح",1,0],["لَم يَضحَ عَبدٌ بِهِ أَضحى وَمَولاهُ","بِاللُطفِ مِنهُ تَوَلّاهُ وَوَلّاهُ",20,"ه",1,0],["لَمْ يَضِرني وَلَقَد بَلَّعتُهُ","قِطَعَ الغَيظِ بِصَابٍ وَصَبِرْ",21,"ر",1,0],["لم يضروك بشيء لو قذاه","غير بالمكتوب كن ذا انتباه",22,"ه",1,0],["لم يضِمه من زمان طارق","عزّ جاراً وجواراً أنْ يضاما",23,"م",2,0],["لم يضيّقْ مخارجَ الرِّزْقِ قومٌ","وسّعوا في مَداخِلِ الأربابِ",24,"ب",1,0],["لم يضن بحبّى لك جسمى البالي","يا صحّة جسمي ونعيم البال",25,"ل",1,1],["لم يضرْ بلدةً تكون بها فق","دانُ جيشٍ ولا تهدُّم سور",26,"ر",1,0],["لَم يَضحَ حَرّاً فَأَمسى","إِلّا غُلامَ غُلامِ",27,"م",1,0],["لم يضحَكِ المسرورُ يومَ سرورهِ","حتَّى بكَى من بعدهِ وتألَّما",28,"م",2,0]]}