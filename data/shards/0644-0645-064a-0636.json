{"poems":[[95,"يا لعهد الصبا تقضي وشيكا","https://www.aldiwan.net/poem9159.html","الخفيف"],[95,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[95,"يا رئيسي وأوليائي وآلي","https://www.aldiwan.net/poem11467.html","الخفيف"],[90,"للجعفرين شهادة الأبرار","https://www.aldiwan.net/poem45042.html","الكامل"],[74,"يا إماما في مدح علياه صدق","https://www.aldiwan.net/poem18491.html","الخفيف"],[53,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[53,"لم يضحك الشيب في فوديه بل كلحا","https://www.aldiwan.net/poem9421.html","البسيط"],[53,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[53,"ذكر الحبيب فقام فردا","https://www.aldiwan.net/poem11454.html","مجزوء الكامل"],[91,"ذهبت ايام الشباب سراعا","https://www.aldiwan.net/poem44894.html","الخفيف"],[47,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[47,"ماجو خبت وإن نأت ظعنه","https://www.aldiwan.net/poem66814.html","المنسرح"],[51,"عجبا ما ينقضي مني لمن","https://www.aldiwan.net/poem63154.html","الرمل"],[77,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85531","البسيط"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/20249","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54891","الخفيف"],[96,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[203,"هدم الأنام وجئت انت تشيد","https://www.aldiwan.net/poem45155.html","الكامل"],[242,"يا أخا اللب يا بديع القيل","https://www.aldiwan.net/poem18869.html","الخفيف"],[280,"أذنت أرض العدى بافتتاح","https://www.aldiwan.net/poem25601.html","المديد"],[354,"لما دعاني الهوى من ربة الكلل","https://www.aldiwan.net/poem15862.html","البسيط"],[372,"مثل عداء بروضات القطا","https://www.aldiwan.net/poem4617.html","الرمل"],[396,"واعتقد أن الخلايق أجمعين","https://www.aldiwan.net/poem54434.html","عموديه"],[422,"بارق لاح فأبكاني ابتساما","https://www.aldiwan.net/poem54109.html","الرمل"],[438,"يا بن من شاب في ممارسة الكعك","https://www.aldiwan.net/poem12565.html","الخفيف"],[453,"لم يضن بحبى لك جسمى البالي","https://www.aldiwan.net/poem53807.html","الدوبيت"],[469,"ته على النجم والمحل الأثيرِ","https://www.aldiwan.net/poem3281.html","عموديه"],[473,"لا سلم الله ربي","https://www.aldiwan.net/poem59645.html","المجتث"],[567,"ويلاه من عرس تحول مأتما","https://www.aldiwan.net/poem52772.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48876","الخفيف"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122327","الخفيف"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34799","الخفيف"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99973","الخفيف"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123438","البسيط"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26429","البسيط"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66273","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110285","الخفيف"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99076","الرمل"],[2546,"","https://poetry.dctabudhabi.ae/diwan/poem/33979","السريع"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62875","الخفيف"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103828","المنسرح"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45744","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131072",""],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103798","المجتث"],[4108,"","https://poetry.dctabudhabi.ae/diwan/poem/206285","الكامل"],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20958","الرمل"],[4767,"فتوى الإبادة","https://www.poetsgate.com/ViewPoem.aspx?id=178990",""],[5147,"يا حياة الأفراد مهما تعاليت","https://www.poetsgate.com/ViewPoem.aspx?id=166729",""],[307,"عيدٌ تهلُّ كما نهْواكَ يا عيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=213645",""],[5409,"ضمني الحلم ومن أه","https://www.poetsgate.com/ViewPoem.aspx?id=155515",""],[5638,"ملحمة العرب","https://www.poetsgate.com/ViewPoem.aspx?id=199068",""],[5691,"شحرور القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=206593",""],[2546,"واكَبدِي مِنْ زَفَراتِ الضَّنَى","https://www.poetsgate.com/ViewPoem.aspx?id=17471",""],[402,"من عذيري والدمع جارس خين","https://www.poetsgate.com/ViewPoem.aspx?id=36541",""],[5818,"مذهب التجسيم منهاجٌ غررْ","https://www.poetsgate.com/ViewPoem.aspx?id=199975",""],[6120,"الْمَاءُ وَالنِّيرَانُ تَتَّفِقُ!","https://www.poetsgate.com/ViewPoem.aspx?id=215805",""]],"verses":[["لم يضق صدرها الرحيب على ما","كلفته بلاجئ أو بجال",0,"ل",1,0],["لَمْ يَضِعْ رَاحِلٌ وَفِي نَفْسِ كُلٍّ","مِنْ بَنِيهَا لَهُ قَرَارٌ مَكِينُ",1,"ن",1,0],["لَمْ يَضِقْ صَدْرُهَا الرَّحِيبُ عَلَى مَا","كُلِّفَتْهُ بِلاَجِيءٍ أَوْ بِجَالِي",2,"ل",2,0],["لم يضحكا مستهزئين من الردى","إلاّ بثغر الصارم البتار",3,"ر",1,0],["لم يضعْ غير نشرها إنما غا","بت وعادت للباب ذا مفتاح",4,"ح",1,0],["لم يَضِرهُ أن لم يكن عربياً","دارهُ قَرْقَرى أو المَرُّوتُ",5,"ت",1,0],["لم يضْحك الشَّيبُ في فَوْدَيهِ بل كلَحَا","سَمِّ القبِيحَ من الأسْماءِ ما قَبُحَا",6,"ح",2,1],["لمْ يضرْهَا أنْ لَمْ يقلْها النُّوَاسي","يُ ولا شَيْخُ بُحْتر بن عَتُودِ",7,"د",1,0],["لم يضْطَجِعْ إلا لِيَعْ","فِر في تراب الأرض خدَّا",8,"د",2,0],["لم يضر رأيي في الحياة فتيلا","انه لا يرى له اشياعا",9,"ع",2,0],["لَم يُضِع مَنهَجَ الصَوابِ وَلَم يَر","مِ بِسَهمٍ في الرَأيِ غَيرِ سَديدِ",10,"د",1,0],["لَم يَضرِبِ الهَرمُزانُ فيهِ وَلا","مارَمَّةٌ خالُهُ وَلا خَتَنُه",11,"ن",2,0],["لَم يَضِر بُخلُ بَخيلٍ غَيرَهُ","فَهُوَ المَغبونُ لَو كانَ فَطِن",12,"ن",1,0],["لم يُضرِموا ناراً لهَيبتِها ولمْ","يَسطَعْ بأكنافِ الفَضاء دُجانها",13,"ن",3,0],["لم يضمن الشعرُ حقاً عنده ليَ في","يوم وأما الَّذي عندي فمضمون",14,"ن",1,0],["لَم يَضِرهُ فُقدانُهُ نورَ عَينَي","هِ إِذا اِعتاضَ عَنهُما بِأَنيسِ",15,"س",1,0],["لَمْ يُضِرْ مَنْ رَمَاكَ مَجْدَكَ لَكِنْ","كَادَ مِنْ جَهْلهِ الْبِلادَ يَضِيرُ",16,"ر",1,0],["لم يضع في الظلام نورك عن","قلبي فقلبي إلى سناك الدليل",17,"ل",1,0],["لم يضربوا بسيوفهم كي يكسروا","هاماً ولكن قيدَ من يتقيدُ",18,"د",1,0],["لَمْ يَضِرْهُ خَرْمُ التَّعَاقُبِ إِذْ أَبْ","دَى الْمَعَانِي غَرِيبَةَ التَّحْجِيلِ",19,"ل",1,0],["لم يَضِقْ بالصَّوْلِ والطَّوْلِ ذَرْعاً","كيفَ والبأسُ مُؤاخي السّمَاح",20,"ح",1,0],["لَم يَضحَ عَبدٌ بِهِ أَضحى وَمَولاهُ","بِاللُطفِ مِنهُ تَوَلّاهُ وَوَلّاهُ",21,"ه",1,0],["لَمْ يَضِرني وَلَقَد بَلَّعتُهُ","قِطَعَ الغَيظِ بِصَابٍ وَصَبِرْ",22,"ر",1,0],["لم يضروك بشيء لو قذاه","غير بالمكتوب كن ذا انتباه",23,"ه",1,0],["لم يضِمه من زمان طارق","عزّ جاراً وجواراً أنْ يضاما",24,"م",2,0],["لم يضيّقْ مخارجَ الرِّزْقِ قومٌ","وسّعوا في مَداخِلِ الأربابِ",25,"ب",1,0],["لم يضن بحبّى لك جسمى البالي","يا صحّة جسمي ونعيم البال",26,"ل",1,1],["لم يضرْ بلدةً تكون بها فق","دانُ جيشٍ ولا تهدُّم سور",27,"ر",1,0],["لَم يَضحَ حَرّاً فَأَمسى","إِلّا غُلامَ غُلامِ",28,"م",1,0],["لم يضحَكِ المسرورُ يومَ سرورهِ","حتَّى بكَى من بعدهِ وتألَّما",29,"م",2,0],["لم يضع صبرُهُ على الخطب فيها","ما لها من حنوّه وحنانه",30,"ن",2,0],["لم يضق منه وهو ضيف ولكن","رب ضيف بمل منه المقام",31,"م",1,0],["لم يَضِرْها والحمدُ للّه شيءٌ","وانثنَتْ نحو عَزْف نفسي ذَهُولِ",32,"ل",1,1],["لم يَضقْ بالأُمور صَدْراً ولا أَصْ","بَحَ فيها كحائر مَلْهُوز",33,"ز",1,0],["لم يضحك الورد إلا حين أعجبه","زهر الربيع وصوت الطائر الغرد",34,"د",1,1],["لَم يَضحَكِ الوَردُ إِلّا حينَ أَعجَبَهُ","حُسنُ النَباتِ وَصَوتُ الطائِرِ الغَرِدِ",35,"د",1,1],["لم يضرب ابنُ المصطفى فوق البسي","طة قبةً متفيئاً بظلالها",36,"ه",2,1],["لم يضره مُرُّ الأذى وبصبرٍ","واصلوا الهدى نعمتِ الأنبياء",37,"ا",2,0],["لم يضرنا أنا شقينا ومتنا","قد نجونا بعرضنا وكفانا",38,"ن",2,0],["لم يضع من كان إبرا","هيم في الناس رجاه",39,"ا",2,0],["لَم يَضَعِ اللَومُ عَلى عاشِقٍ","شَفرَتَهُ إِلّا اِنتِحابي أَنا",40,"ن",2,0],["لم يضرُّوا الاَّ كاضرارِ عبد ال","لهِ لغواً بزيدهِ المضرُوبِ",41,"ب",1,0],["لم يضطرب في محلها أحدٌ","إلا نبا حدها بمضطربه",42,"ب",2,0],["لَم يَضرب العز في حي سَرادقه","إِلّا وَمَدّ لَه مِن عَزمكم طَنَب",43,"ب",1,0],["لم يضيّع جميل فرد من النا","س فكوفي أولئك الأمناء",44,"ا",2,0],["لم يضحك الروض الا","دموعه المرفضه",45,"ض",2,0],["لم يضربوا طُنُباً لخوفهمُ فهمْ","مثلُ الوعولِ إذا حواها النِّيقُ",46,"ق",1,0],["لَم يَضِرني غَيرَ أَن يَحسُدَني","فَهوَ يَزقو مِثلَ ما يَزقو الضُوَع",47,"ع",1,0],["لَم يضطربْ منه الضمير لِما جرى","ما دامَ من فتوى الضلالة يُؤجَر",48,"ر",1,0],["لم يضيعوا العقول وهي كنوز","في مجاري الظنون والتخييل",49,"ل",1,0],["لم يضرعوا وسقامُ الموت آخذهم","والناسُ بالداءِ معلولٌ وملحودُ",50,"د",1,0],["لم يضع للحب ستراً","لم يقم للعرف وزنا",51,"ن",2,0],["لَمْ يَضِنُّوا بِضِيَاءٍ","أَوْ رَوَاءٍ أَوْ دَوَاءْ",52,"ا",2,0],["لمْ يضعْ مثلَ سواهُ أبَداً","سيْفَهُ في غِمْدِهِ مُسْتَسْلِما",53,"م",2,0],["لم يضعِ اللومُ على عاشقٍ","شفرتَهُ إِلاّ انتحاني أنا",54,"ن",2,0],["لم يضع راحل وفي نفس كل","م بنيها له قرار مكين",55,"ن",1,0],["لمْ يضرّ الدين إلّا أهله","إبتلانا الله مذ عصر التترْ",56,"ر",1,0],["لَمْ يُضفِهَا نُوْرًا تَعَلُّقُهَا","بَلْ صَدرُهَا مَنْ كَانَ يَأْتَلِقُ!",57,"ق",1,0]]}