{"poems":[[55,"سيدي أنت ليس كلل","https://www.aldiwan.net/poem29953.html","مجزوء الخفيف"],[79,"يا حسنها من أربع وديار","https://www.aldiwan.net/poem36462.html","الكامل"],[95,"يا عائداً برعاية الرحمن","https://www.aldiwan.net/poem11169.html","الكامل"],[95,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[45,"جاء نيروزنا وأنت مراده","https://www.aldiwan.net/poem9556.html","الخفيف"],[45,"مالنا كلنا جو يا رسول","https://www.aldiwan.net/poem9980.html","الخفيف"],[51,"لاح شيب الرأس مني فاتضح","https://www.aldiwan.net/poem62030.html","الرمل"],[46,"وأبي المنازل إنها لشجون","https://www.aldiwan.net/poem30334.html","الكامل"],[77,"أقوى المحصب من هاد ومن هيد","https://www.aldiwan.net/poem69092.html","الطويل"],[52,"يا قلب ما لي أراك لا تقر","https://www.aldiwan.net/poem63821.html","المنسرح"],[48,"إن الجديدين قد جربت فعلهما","https://www.aldiwan.net/poem22832.html","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[164,"هموا بحرب ومناهم به الحلم","https://www.aldiwan.net/poem58920.html","البسيط"],[234,"صبر المحب أحق بالإحجام","https://www.aldiwan.net/poem50808.html","الكامل"],[234,"نعم المعين على الوغى في مأزق","https://www.aldiwan.net/poem50885.html","الكامل"],[236,"لولا شذا من نشركم ينشق","https://www.aldiwan.net/poem44579.html","السريع"],[240,"أولعت بالغدر في أيمانها","https://www.aldiwan.net/poem31728.html","الرمل"],[240,"لو بات من يلحي عليك مسهدا","https://www.aldiwan.net/poem32100.html","الكامل"],[369,"لولا رجائي ثانيا للقائه","https://www.aldiwan.net/poem61006.html","الكامل"],[411,"أجرني من دهر أساء جواره","https://www.aldiwan.net/poem49572.html","الطويل"],[449,"عجبا حللوا عذاب النفوس","https://www.aldiwan.net/poem56028.html","عموديه"],[463,"خذ من يدي صفقة الأماني","https://www.aldiwan.net/poem55855.html","مخلع البسيط"],[463,"أفلح قوم إذا دعوا وثبوا","https://www.aldiwan.net/poem56299.html","المنسرح"],[466,"لمعت كتلويح الرداء المسبل","https://www.aldiwan.net/poem15089.html","الكامل"],[469,"لهفي على غصن النقا المتمايل","https://www.aldiwan.net/poem3200.html","عموديه"],[505,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[505,"لي في سماء الحمى الشرقي أقمار","https://www.aldiwan.net/poem38015.html","البسيط"],[519,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[878,"","https://poetry.dctabudhabi.ae/diwan/poem/140215",""],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6760","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48943","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77802","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77739","الكامل"],[1680,"","https://poetry.dctabudhabi.ae/diwan/poem/81898","الخفيف"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26457","الرجز"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76662","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46438","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46469","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101821","الكامل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121186","البسيط"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83209","الكامل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146344","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58342","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200014","الطويل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126280","الكامل"],[3609,"","https://poetry.dctabudhabi.ae/diwan/poem/177983","الرجز"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117946","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86354","الرمل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78198","الكامل"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/18980","البسيط"],[4448,"","https://poetry.dctabudhabi.ae/diwan/poem/31418","البسيط"],[4988,"أحفاد الاجداد","https://www.poetsgate.com/ViewPoem.aspx?id=196636",""],[585,"مهلاً فلست بجاحدٍ أو عات","https://www.poetsgate.com/ViewPoem.aspx?id=161934",""],[5187,"فرسان ميونيخ","https://www.poetsgate.com/ViewPoem.aspx?id=29246",""],[2365,"أيها الطالب أجمل واقتصد","https://www.poetsgate.com/ViewPoem.aspx?id=200664",""],[5226,"القدس .. في القلب","https://www.poetsgate.com/ViewPoem.aspx?id=24251",""],[5320,"بطاقة عضوية","https://www.poetsgate.com/ViewPoem.aspx?id=43258",""],[5410,"فحضارة الإسلام حصن صامد","https://www.poetsgate.com/ViewPoem.aspx?id=73563",""],[5533,"يا غَزَّةُ يا صَوْتَ الأُمَّة","https://www.poetsgate.com/ViewPoem.aspx?id=176419",""],[5650,"امْلأْ فُؤادَكَ بِالْحَبيب","https://www.poetsgate.com/ViewPoem.aspx?id=131222",""],[5674,"الرأي لي","https://www.poetsgate.com/ViewPoem.aspx?id=186942",""],[5691,"معادلة لاتفهم...!","https://www.poetsgate.com/ViewPoem.aspx?id=206848",""],[5704,"القدس لنا","https://www.poetsgate.com/ViewPoem.aspx?id=194471",""],[5725,"ضرباً بهارية الصفاح","https://www.poetsgate.com/ViewPoem.aspx?id=177494",""],[5732,"سود الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=177941",""],[5815,"رفقاً","https://www.poetsgate.com/ViewPoem.aspx?id=190221",""],[5957,"كل حب في حياتي لا يزول","https://www.poetsgate.com/ViewPoem.aspx?id=113357",""],[6124,"معارضة المتنبي","https://www.poetsgate.com/ViewPoem.aspx?id=121833",""],[6128,"معراج القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=213720",""],[6256,"المعارف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65931&r=&rc=19",""],[6346,"مشنقة الحروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83387&r=&rc=3",""],[4734,"تسلم إيديكو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63378&r=&rc=32",""]],"verses":[["فَرَسٌ يَلحَقُ الأَيا","طِلَ مِن نَسلِ لاحِقِ",0,"ق",1,0],["فَرَسا رِهانٍ أحْرَزوا قصَبَ النّدى","والبأسَ في طَلْقٍ وفي مِضْمارِ",1,"ر",1,0],["فَرَسٌ كَمَا حَلُمَ الجُدُودُ مَجُنَّحٌ","قَدْ حَقَّقَتَّهُ يَقْظَةُ الأَزْمَانِ",2,"ن",1,0],["فُرْسَانُهُ وَمِشَاتُهُ وَصُقُورُهُ","أَقْوَى العَتَادِ لِحَوْمَةٍ وَصِدَامِ",3,"م",1,0],["فَرَّسَتنا سَوابِقٌ كُنَّ فيهِ","فارَقَت لِبدَهُ وَفيها طِرادُه",4,"د",2,0],["فَرَسٌ سابِقٌ وَرُمحٌ طَويلٌ","وَدِلاصٌ زُغفٌ وَسَيفٌ صَقيلُ",5,"ل",1,0],["فَرَسولُ اللَهِ أَولى بِالعُلى","وَرَسولُ اللَهِ أَولى بِالمِدَح",6,"ح",1,0],["فُرسانُ مَملَكَةٍ أُسودُ خِلافَةٍ","ظِلُّ الهُدى غابٌ لَها وَعَرينُ",7,"ن",1,0],["فرْسانُ طَعْنٍ تُؤامٍ في الفرائصِ لا","يُنمي وضَرْبٍ دراكٍ في القماحيد",8,"د",1,0],["فُرسانُ حَربٍ إِذا اِلتَقَت بِهِمُ","فيهُم غَناءٌ وَعِندَهُم غِيَرُ",9,"ر",1,0],["فُرسانَ خَيلٍ إِذا خَلَّوا أَعِنَّتَها","لا يُمسِكونَ حِذاراً بِالقَرابيسِ",10,"س",1,0],["فَرَسَتْهُ فَرْسَ الهِزَبْرِ وما تَسْ","مَعُ منها زَأراً ولكِنْ هَريرا",11,"ر",2,0],["فَرَسَمتَ بَعدَكَ لِلعِبادِ حُكومَةً","لا سوقَةٌ فيها وَلا أُمَراءُ",12,"ا",2,0],["فرسان داحس والحنفاء حسبكم","من الرهان جهاد فهو ميدان",13,"ن",1,0],["فرسانها مائة في الأسر ليس يرى","منهم ومنهن إلا اللحظ واللثم",14,"م",1,0],["فُرسانُ أبكار الكلام إذا امتطَوا","رتبَ الخطاب فوارسُ الأقلامِ",15,"م",1,0],["فرس أشم المنكِبين مقابل","يرمي الجنادل مِن يديه بِجندل",16,"ل",1,0],["فرسانه أخنت على فارسٍ","فزال عنها التاج والمنطق",17,"ق",1,0],["فَرَسولُ اللَهِ مِن جُرثومَةٍ","عودُكَ الناضِرُ مِن عيدانِها",18,"ن",3,0],["فَرَسا رِهانٍ رُكِّضا في حَلبَةٍ","فَتَجاوَزا أَمَدَ العَلاءِ وَأَبَعَدا",19,"د",2,0],["فَرسٌ إذا ملكَتْه كَفّي لم أُرعْ","من بُعْدِ مُنتجَعٍ ومن عُدَوائه",20,"ا",3,0],["فرَسْمُكَ جارٍ مُذْ عرَفْتُكَ إنَّهُ","إذا جارَ دَهْرٌ إنَّ عَونَكَ بي جارِ",21,"ر",1,0],["فرسول منهم ينادي بصدق ال","حب والحب شرع خير رئيس",22,"س",1,0],["فُرسان يومِ الهياج منهم","وفيهمُ ألسنُ البيانِ",23,"ن",1,0],["فُرسان يومِ الطعانٍ إن طَعَنوا","بالألسن المشكلاتِ أو ضَرَبوا",24,"ب",3,0],["فرسوم منزلةٍ إلى أسماعه","أحلى وأعذب من رسوم المنزل",25,"ل",1,0],["فرسانَ ملحمةٍ غيوثُ جديبةٍ","أقمارُ داجيةٍ أسودُ جحافل",26,"ل",1,0],["فرس الشجاع وذاته وحسامه","وخصامه نحو الفناء تطارد",27,"د",1,0],["فِرسانُ غيبٍ أبو العَبَّاسِ قائِدُهُم","إلى العُلى وأبو العَبَّاسِ كَرَّارُ",28,"ر",1,0],["فُرسانُ طَعْنٍ وضرْبٍ غيرَ أنّهُمُ","أمضى سِلاحِهم القاماتُ والمُقَلُ",29,"ل",1,0],["فرس يزهى به لل","حسن سرج ولجام",30,"م",1,0],["فَرَسَت بِهِم لَمّا أَتَوا مَحبوبَهُم","مَرسىً لَهُم فيهِ غِنىً وَأَمانُ",31,"ن",1,0],["فَرسا رهانٍ ما جرَوا في حلبة","إلاَّ وطِرفُهم الأغرّ الأَسبق",32,"ق",1,0],["فرسومه بين الملا","وَسَناه فيكم قَد فني",33,"ن",2,0],["فَرَسائِل بِرَسائِل وَوَسائِل","بِوَسائِل جبر يلها القرآن",34,"ن",1,0],["فَرسُ العِزَ تَحْتَ سَرْجِ جَوَادِي","وَرِكَابي عَالٍ وَعَزْمِي لِجَامِي",35,"م",2,0],["فُرسانُهُ الأَنباطُ مِن","مَيسانَ أَهلِ الرِيَبِ",36,"ب",1,0],["فرسا رهان أنتما فتجاريا","لنقول في التقديم والتأخير",37,"ر",1,0],["فُرسانُ قَولي تَتَقيها إِن عَدت","فُرسانُ كُلُ كَتيبة خَضراء",38,"ا",2,0],["فُرسان قَولك خَيلَها منكبة","تَكبو إِذا ذَهَبت إِلى التَعداء",39,"ا",2,0],["فَرِسَالَةُ المَبعُوثِ تَبلِيغُ كَلاَ","مِ المُرسِلِ الدَّاعِي بِلاَ نُقصَانِ",40,"ن",1,0],["فرس كشفت بها الشريعة إنها","عادت إلي بصفقة المغبون",41,"ن",1,0],["فرسان نقع على افراسهم اطم","كأنهم في ظهور الخيل نبت ربا",42,"ب",2,0],["فُرسانُها في طَبلِها","مَع زامِرٍ كَالمُلبِدِ",43,"د",1,0],["فَرَسَيْ رِهانٍ كُنتما يَعْلوكما","رَهَجٌ فما واجَهْتني حتّى بَدا",44,"د",2,0],["فَرَسٌ تَراهُ إذا سَرى","للضّعف يمشي القهقرى",45,"ر",2,1],["فرسمك مرآةٌ ونفسي ولوعة ٌ","بصاحبة المرآة أسألها الوصلا",46,"ل",2,0],["فرست سفينته على الجودى وقي","ل لغيره بعدا حسرت يداكا",47,"ك",2,0],["فرسكة حمراء كالعقيق","هدية جاءتك من صديق",48,"ق",1,1],["فرس العزم إلى الدكن سق","تنجو من كل عناء وكلف",49,"ف",1,0],["فرس العلياء مانفكت جموح","لم ترض ظهراً لمن يركبها",50,"ه",2,0],["فَرَسائِلي البَيضاءَ تَحظى بِاللُقا","يا لَيت سودى بِاللِقاء تَسود",51,"د",1,0],["فُرسانُ ذي الرَحلِ وَالعَرجاءِ وَإِبنَتِها","فِدىً لَهُم رَهطُ رَدّادٍ وَشَدّادِ",52,"د",1,0],["فُرسانُ شَيبانَ لَم يَسمَع بِمِثلِهِم","أَبناءَ كُلِّ كَريمِ النَجلِ صِنديدِ",53,"د",1,0],["فرسان مع شيخان وملوك واجواد","يكفيهم ان للبيض قدرٍ وقيمه",54,"م",2,0],["فرسفت فيها أستخف بثقلها","حتى ارتمت بدداً من الصدمات",55,"ت",1,0],["فرسانُ ثورتِنا قامتْ وطابَ لها","كأسَ الرّدى , نشوةً تُحيي أمانيها",56,"ي",3,1],["فرسانُ ثورتِنا نورٌ إذا انْطلقتْ","نارٌ إذا احْتدمتْ واللهُ حاميها",56,"ي",3,0],["فرسول الموت لا ينظر ذا","حاجة يصدرها إما ورد",57,"د",1,0],["فرسانُ مجدِكِ لم يزالوا في الحِمى","لم يدبروا يوماً ولا هم غابوا",58,"ب",3,0],["فرسان الماضى والحاضر","قد فاز وانفض الشسامر",59,"ر",1,1],["فرسالة الإسلام حُصنُ ثُغُورِها","إنْ رامَ خَطْبٌ أنْ تُطَأطئ هامَها",60,"م",3,0],["فُرْسَانُك كلٌّ من صَحْبٍ","أَدْناهُم قَدْ حازَ القِمَّة",61,"م",2,0],["فَرِسالةُ الْمَولَى تَنَجَّمَ عِطْرُها","تَحتَ السّماءِ وَلم يَكنْ قدْ أَخَّرَهْ",62,"ر",2,0],["فرسمت نبضك في الضلوع حكايةً","قد همتُ شوقاً من صدى قيثاري",63,"ر",2,0],["فرس ،أمازيغ،تتار،شركس","طاجيك،أوزبك،تركمان أو همُ",64,"م",1,0],["فرسانهم خنعت أجوادها ربضت","لله كم وهنت أو شابهت صنما",65,"م",2,0],["فرسان ماوهنوا وهم","اضنوا الصوافن بالضباحِ",66,"ح",1,0],["فرسان ربع عن مطيحه مقفين","وفرسان ضده شاهرين الاسنه",67,"ن",2,0],["فرسمت في وَلَهٍ ظلالَ خميلةٍ","‏‎ فإذا الجنان لقطبها تُدنيكِ‎",68,"ك",1,0],["فرسول الله أهدى مرشدا","لينير الدرب كي تحيا العقول",69,"ل",1,0],["فِرْسَانُ صَهْدِيْ تَسَاقَوْا مِنْ مَقَالِيْدِيْ","إِذْ ضَاعَ مِنِّيْ شَبَابِيْ ، غَادَرَ العُوْدُ",70,"د",1,0],["فرسمت من وحي الحنين قصيدة","وكأنها مسرى الفؤاد إلى النَّغَمْ",71,"م",1,0],["فرسالة التعليم أصبح أمرها","بدداً يُصرّفها الهوى ويصنّف",72,"ف",1,0],["فُرْسَانُهَا في قَدِيمِ العَهدِ طَلْعَتُهُمْ","بُركَانُ حَرْبٍٍ إِذَا مَا ثَارَ بِالحِمَمِ",73,"م",1,0],["فرساننا زين الشبابْ","زين الشباب فرساننا",74,"ن",2,1]]}