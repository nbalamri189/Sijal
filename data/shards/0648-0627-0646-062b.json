{"poems":[[108,"بأيكما أبكي","https://www.shoaraa.com/p12758",""],[53,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[86,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[86,"يا صاحب الروضة الغناء هجت بنا","https://www.aldiwan.net/poem68930.html","البسيط"],[93,"يا عبرة الدهر جاوزت المدى فينا","https://www.aldiwan.net/poem11172.html","البسيط"],[54,"عاذلي لو شئت لم تلم","https://www.aldiwan.net/poem27479.html","المديد"],[30,"ألا أيهذا المنزل الدارس اسلم","https://www.aldiwan.net/poem29526.html","الطويل"],[72,"وقائع حب حار في كرها فكري","https://www.aldiwan.net/poem18705.html","الطويل"],[72,"كل حي قاض عليه زواله","https://www.aldiwan.net/poem19528.html","الخفيف"],[95,"ملحمة النبي","https://www.aldiwan.net/poem60153.html","عموديه"],[51,"أمون من العظعاظ عند مروقها","https://www.aldiwan.net/poem65078.html","الطويل"],[91,"أنا إن أغمض الحمام جفوني","https://www.aldiwan.net/poem62792.html","عموديه"],[92,"يا إله الوجود هذي جراح","https://www.aldiwan.net/poem38885.html","الخفيف"],[85,"كانت النملة تمشي","https://www.aldiwan.net/poem8035.html","مجزوء الرمل"],[85,"قام من علته الشاكي الوصب","https://www.aldiwan.net/poem62920.html","الرمل"],[43,"كفرندي فرند سيفي الجراز","https://www.aldiwan.net/poem9609.html","الخفيف"],[45,"أحرام أن ينجز الموعود","https://www.aldiwan.net/poem63501.html","الخفيف"],[28,"إن تك كلبا من كليب فإنني","https://www.aldiwan.net/poem5367.html","الطويل"],[61,"وجد الحب لي فؤادا علوقا","https://www.aldiwan.net/poem51502.html","الخفيف"],[49,"رأيت الشيب يعدوكا","https://www.aldiwan.net/poem62205.html","الهزج"],[49,"يسلم المرء أخوه","https://www.aldiwan.net/poem63192.html","مجزوء الرمل"],[66,"وغزال غازلته بعد بين","https://www.aldiwan.net/poem39511.html","الكامل"],[66,"خذ من الدهر لي نصيب","https://www.aldiwan.net/poem41371.html","مجزوء الخفيف"],[74,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[52,"أيا وادي الأحباب سقيت واديا","https://www.aldiwan.net/poem26567.html","الطويل"],[52,"مر عيش علي قد كان لذا","https://www.aldiwan.net/poem27057.html","الخفيف"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[46,"يسمون بالجهل عبد الرحيم","https://www.aldiwan.net/poem22499.html","المتقارب"],[46,"عجبت وكم عجب في الزمان","https://www.aldiwan.net/poem23264.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85523","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39648","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54620","البسيط"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199490","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54319","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54208","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[100,"أسمار القرية","https://www.poetsgate.com/ViewPoem.aspx?id=50334",""],[100,"أصيل من الحب","https://www.poetsgate.com/ViewPoem.aspx?id=50336",""],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[90,"جناية الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=178941",""],[54,"عاذِلي ! لو شئتَ لمْ تلمِ","https://www.poetsgate.com/ViewPoem.aspx?id=14488",""],[94,"وانجلت نفسي في النور","https://www.poetsgate.com/ViewPoem.aspx?id=15612",""],[28,"إن تك كلبا من كليب فإنني","https://www.poetsgate.com/ViewPoem.aspx?id=22110",""],[126,"يا خليلي بالركاب سحيراً","https://www.aldiwan.net/poem4101.html","الخفيف"],[128,"أعباس إن الذي بيننا","https://www.aldiwan.net/poem24257.html","المتقارب"],[130,"ذكر الطائر الرياض فغنى","https://www.aldiwan.net/poem67452.html","البسيط"],[165,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[190,"أموا المدينة حيث جل المغنم","https://www.aldiwan.net/poem35107.html","الكامل"],[198,"هات يا ساق هات بنت النخيل","https://www.aldiwan.net/poem39944.html","الخفيف"],[199,"رب ليل أتحفت فيه بأنس","https://www.aldiwan.net/poem51935.html","الخفيف"],[200,"فتكت في الناس أعينها","https://www.aldiwan.net/poem45234.html","المديد"],[211,"بدا يختال كالقمر المفدى","https://www.aldiwan.net/poem13553.html","الوافر"],[224,"بينما كان فتى المستقبل","https://www.aldiwan.net/poem41633.html","الرمل"],[224,"أترى جاءت لكي تصطاد","https://www.aldiwan.net/poem41904.html","مجزوء الرمل"],[224,"حاذر الحب إن في الحب شرا","https://www.aldiwan.net/poem41905.html","الخفيف"],[226,"إنظمى الدر يا سمية إسكندر","https://www.aldiwan.net/poem55204.html","الخفيف"],[226,"لم يدر أن ملامه أغراكا","https://www.aldiwan.net/poem55231.html","الطويل"],[230,"حللت عقد المعاني فاعتلى الكلم","https://www.aldiwan.net/poem50824.html","البسيط"],[238,"يا جميل الصبر لب من دعا","https://www.aldiwan.net/poem19492.html","الرمل"],[271,"سحرا مشى الفتيان مبتسمينا","https://www.aldiwan.net/poem35623.html","الكامل"],[276,"لم يخن في الحب تأويلي","https://www.aldiwan.net/poem25541.html","المديد"],[281,"أترى أبصره مثلي القدح","https://www.aldiwan.net/poem60587.html","المتقارب"],[306,"سما للعلى يقظان عين حديدها","https://www.aldiwan.net/poem56578.html","الطويل"],[321,"بقبول صومك قد تبسم عيده","https://www.aldiwan.net/poem67216.html","الكامل"],[329,"هتف الشاطىء بالمدح","https://www.aldiwan.net/poem55007.html","مجزوء الرمل"],[329,"خطرت كالنسمة السكرى","https://www.aldiwan.net/poem55050.html","مجزوء الرمل"],[329,"رتل البلبل الطروب لحونه","https://www.aldiwan.net/poem55066.html","الخفيف"],[350,"أمرتني بستر كشف غطائي","https://www.aldiwan.net/poem15499.html","الخفيف"],[350,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[354,"أنسمة فاحت بنشر الخزام","https://www.aldiwan.net/poem39801.html","السريع"],[354,"قم بنا أيها الحبيب","https://www.aldiwan.net/poem40222.html","مجزوء الخفيف"],[367,"أما ومنك على أعدائك الطلب","https://www.aldiwan.net/poem17155.html","البسيط"],[367,"أبى الغمض والتمهيد جفناي والجنب","https://www.aldiwan.net/poem17158.html","الطويل"],[367,"لا تحدث سواك نفس بفضل","https://www.aldiwan.net/poem17184.html","الخفيف"],[367,"لكم في زبور الله يا مبلغي الذكر","https://www.aldiwan.net/poem17200.html","الطويل"],[372,"وإذا ما الزمان أعرض عني","https://www.aldiwan.net/poem57126.html","الطويل"],[372,"ما استطاعت أن تهجر المهجورا","https://www.aldiwan.net/poem57455.html","الخفيف"],[430,"لعمرك يا أخا الأشواق أنا","https://www.aldiwan.net/poem40258.html","الوافر"],[433,"ضرب الناس في العلا الأمثالا","https://www.aldiwan.net/poem12373.html","الخفيف"],[433,"ذكر الركب الذي نزحا","https://www.aldiwan.net/poem12393.html","المديد"],[433,"مل من صبوته ما أملا","https://www.aldiwan.net/poem12453.html","الرمل"],[433,"حمل الريح بالأصيل سلامه","https://www.aldiwan.net/poem12719.html","الخفيف"],[440,"وفيهن أضحيت يوم الأضاحي","https://www.aldiwan.net/poem34845.html","المتقارب"],[444,"بعد خلق الأكوان خلقا بديعا","https://www.aldiwan.net/poem56043.html","الخفيف"],[453,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[453,"يا ليالي السفح من عهد الصبا","https://www.aldiwan.net/poem13926.html","الرمل"],[459,"إذا عارض نحو أرض عدل","https://www.aldiwan.net/poem56076.html","المتقارب"],[462,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[469,"باعدت بالبعاد بيني وبينى","https://www.aldiwan.net/poem59601.html","الخفيف"],[480,"صبرا لحكمك صبرا","https://www.aldiwan.net/poem37050.html","المجتث"],[480,"أسائلكم أنا من أي صنف","https://www.aldiwan.net/poem37585.html","الوافر"],[483,"عرج بمنعرج الكثيب الأخضد","https://www.aldiwan.net/poem24364.html","عموديه"],[501,"عرج بعيس القوم يا حاديها","https://www.aldiwan.net/poem37637.html","الكامل"],[515,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[552,"توق ديار الحي فهي المقاتل","https://www.aldiwan.net/poem47325.html","الطويل"],[552,"يا خليلي ومعيني","https://www.aldiwan.net/poem47735.html","مجزوء الرمل"],[559,"ظهرت ذاتي لذاتي","https://www.aldiwan.net/poem34729.html","مجزوء الرمل"],[576,"أوقد الحسن فوق خديك نارا","https://www.aldiwan.net/poem3068.html","الخفيف"],[587,"وما فيه من حسن سوى أن طرفه","https://www.aldiwan.net/poem17481.html","الطويل"]],"verses":[["وأنثر من نظمي عليهم قصائداً","حِضارُ المعاني في سِواها شوارد",0,"د",1,0],["وَاِنثُر عَلى الشَربِ سِمطاً مِن فَواقِعِها","وَاِبنَ الغَمامِ مُسَمّىً بِاِبنَةِ العِنَبِ",1,"ب",1,0],["وَاِنثَنى راجِعاً إِلى شاطِئِ النَه","رِ رُجوعَ الكَمِيِّ غِبَّ اِغتِنامِ",2,"م",1,0],["وَاِنثُر عَلى الغَربِ مِن تِلكَ الحُلى وَأَشِد","بِكُلِّ حُسّانَةَ فينا وَحُسّانِ",3,"ن",1,0],["وَانْثَلَّ مِنْ عِزِّنَا مَا عَزَّ مَطْلَبُهُ","وَانْدَكَّ مِنْ مَجْدِنَا مَا شَادَ بَانِينَا",4,"ن",2,0],["وَاِنثَنَت أَفياءُ نَبعَتِها","عَن نَباتٍ سالَ كَالجُمَمِ",5,"م",1,0],["وَإِن ثَوَّبَ الداعي بِها يا لَخِندِفٍ","فَيا لَكَ مِن داعٍ مُعَزٍّ مُكَرَمِ",6,"م",1,0],["وأن ثناه فاضحٌ حصرَ الورى","وأنَّ ندَاه لا يحاوَل بالحصر",7,"ر",1,0],["وانْثر الدمعَ حول مثواه نثراً","مثل ما ينثر الكلام ارْتجاله",8,"ل",2,0],["وانثنت تضرب الرمال اختيالا","بخطى جاهلية عمياء",9,"ا",2,0],["وانثنت والرياح تجار والرمل","نثير في الأوجة الربداء",9,"ا",2,0],["وإن ثَقفته أنفذته وقدّرت","له ما يوازيه من الأرض مصرعا",10,"ع",2,0],["وَاِنثُري الوَردَ حَولَهُ وَعَلَيهِ","وَاِغرُسي عِندَ قَلبِهِ ياسَمينَه",11,"ن",2,0],["وانثُري الوَرْدَ للثُّلوجِ بدَاداً","واصعقي كلّ بُلبلٍ تَيَّاهِ",12,"ه",1,0],["وَاِنثَنَت تَنظُرُ حَتّى","أَوجَدَ الخَوفُ وَأَعدَم",13,"م",1,0],["وَاِنثُرِ الشِعرَ عَلى الأَبرارِ في","قُدُسِ الساحِ وَعُلوِيِّ الرَحِب",14,"ب",1,0],["وَاِنثَنى عَنِّيَ الرُدَينِيُّ حَتّى","دارَ دَورَ الحُروفِ في هَوّازِ",15,"ز",1,0],["وَاِنثَنَت وِجهَةَ الفِراقِ فَأَرسَل","تُ إِلَيها عَيناً عَلَيها تَجودُ",16,"د",1,0],["وَإِنَّ ثِيابَ المُلكِ في آلِ دارِمٍ","هُمُ وَرِثوها لا كُلَيبُ النَواهِقِ",17,"ق",1,0],["وَإِنَّ ثِيابي مِن ثِيابِ مُحَرِّقٍ","وَلَم أَستَعِرها مِن مُعاعٍ وَناعِقِ",17,"ق",1,0],["وانثَنى الحَاسِدونَ عن سابقٍ من","كَ إلى المَجدِ أن يُرى مَسبوقا",18,"ق",2,0],["وَإِن ثَقُلتَ مَلّوكا","وَعابوكَ وَسَبّوكا",19,"ك",2,0],["وَاِنثَنَوا عَنهُ وَخَلَّو","هُ كَأَن لَم يَعرِفوهُ",20,"و",2,0],["وَاِنثَنى باكِياً يُقَبِّلُ كَفَّي","يَ وَيَهوي طَوراً عَلى القَدَمَينِ",21,"ن",1,0],["وَاِنثَنى غُصنُها الوَريق","فَشَدَت فَوقَهُ الحَمام",22,"م",1,0],["وَاِنثَنى يَمشي بِهِ غُصُنٌ","مِن جَناهُ نَورُ مُبتَسِمِ",23,"م",1,0],["وَإِن ثَقَبَتهُ العَينُ لاقَت قَرارَهُ","تَخالُ الحَصى فيها نُجوماً رَواسِيا",24,"ي",2,0],["وَاِنثَنى عَنّيَّ الشَبابُ وَغودِر","تُ فَريداً مِنَ الأَحِبَةِ فَذّا",25,"ذ",2,0],["وإن ثَبَّتَ الأقدامَ قَرّتْ قرارَهَا","فكانَ الهِدانُ النِّكسُ أوّلَ مُقْدِم",26,"م",1,0],["وَإِنَّ ثُمَوداً أَتَت بَحَرهُم","خُطوبٌ فَما تَرَكَت مِن ثَمَد",27,"د",1,0],["وَإِنَّ ثَبيراً لَهُ خِفَّةٌ","تَبينُ عَلى كِفِّةِ الشائِلِ",28,"ل",1,0],["واِنثَنى منتفضاً","وجثا مستترا",29,"ر",2,0],["وانثنتْ بابتسامةٍ فدعتني","ثم قامت تمشي هناك الهوينا",30,"ن",2,0],["وَانْثُرْ عَلَى الْوَادِي مِنْ عِلْمٍ وَمِنْ أَدْبٍ","فَإِنَّ ذَا الشَّعْبِ يَهْوَى العِلْمَ وَالأَدَبَا",31,"ب",2,0],["وانثر الوردَ علي جموعيَ الغفيرهْ","ضفيرتي تعبث بالغيوم",32,"م",1,0],["وانثُرِ الشِّعْرَ للعروسينِ زَهْراً","وانظمِ الزَّهْرَ للعروسين شِعْرا",33,"ر",2,0],["وانْثُرْ أَزَاهِيراً عَلَى الزَّهْرِ الَّذي","كانَتْ لَه كُلُّ القُلوبِ كِماما",34,"م",2,0],["وانثُرُوها قلائداً وعُقُوداً","تتَحدى قَلائدَ العِقْيانِ",35,"ن",1,0],["وانثنت مثلما يميس عمود","زنبقي تشتمّ أخبار (قائد)",36,"د",1,0],["وانثالت الياعات من حوله","أحلام عشّاق بلا مأوى",37,"و",2,0],["وإن ثيابَ الناس زُرَّت جميعُها","على عاهةٍ إلاّ ثيابَ المؤازر",38,"ر",1,0],["وانثنى \" كالاطار \" يحتضِنُ الصّورةَ","تُزْهَى ، أو جَدْولٍ في كتاب",39,"ب",1,0],["وانثنى الغصن ولولا أنه","حامل ما لم يطقه ما أنثنى",40,"ن",2,0],["وانُثَنَتْ أَفياءُ نَبْعَتِها","عنْ نباتٍ سالَ كالجمِ",41,"م",1,0],["وانثنى يخطب فيهم خطبة","أبلغ المنطق في أعذب جرس",42,"س",1,0],["وإنَّ ثِيَابَ المُلْكِ في آلِ دَارِم","هُمْ وَرِثوهَا. لا كُلَيْبُ الحَّواهِق",43,"ق",1,0],["وانثنى مِعطفُ القَضيب اختيالاً","لِغِناءِ الحَمامَةِ الوَرقاء",44,"ا",2,0],["وَأَنَّ ثَنِيَّةَ رَأسِ الهِجا","بيني وبينك لا تطلع",45,"ع",1,0],["وانثنى يرمُقُ الخَيالَ ويَشدو","من فنونِ الإنشادِ لحناً فلَحنا",46,"ن",2,0],["وَإِن ثَوَت بينَ ضُلوعي زَفرَةٌ","تَملأُ ما بَينَ الرَجا إِلى الرَجا",47,"ا",1,0],["وَاِنثُر بِمدحِهما اللآلئَ واِنظمِ","مَهما اِستطعتَ القول قُل وترنّم",48,"م",1,0],["وانثُرِ الشوكَ أيّها الأرقُ المرُّ","على مضجعِ الدعيّ الملولِ",49,"ل",1,0],["وانثنى الليلُ يَفْضُلُ الصبح حسناً","والدراري يفضُلْنَ فيه الشموسا",50,"س",2,0],["وانثنت عُجباً فلستَ ترى","عاشقاً إلا ويعجُبها",51,"ب",3,0],["وانثرها دموعا كالالآلي","تكاد بجيده ينظمن عقدا",52,"د",2,0],["وَاِنثَنى من وجهِه مُستَعجِلاً","راغِباً في مَشيةِ المُستَعجل",53,"ل",1,0],["وَاِنثَنَت تَلحس سَنّا","رَتَها مُذ أَكَلَتهُ",54,"ه",1,0],["وَاِنثنى هائِماً عَلى نَفسِهِ الثَك","لى فَلَم يُستَفق وَلم يُستقرّا",55,"ر",2,0],["وَاِنثُريهِ فَالدُرُّ دُرٌّ وَإِن لَم","يَدِّخِره تُجّارُهُ في سُلوكِ",56,"ك",1,0],["وَاِنثُر دموعَك في ثَراه صبابَةً","علَّ البكاءَ يُزيلُ بعضَ جواكا",57,"ك",2,0],["وأنَّ ثانِي ما أضمَرْتَه قَدَحٌ","كأنّه مِن بيَاضِ الصُّبحِ ملتئِمُ",58,"م",1,0],["وأنّ ثالثَ ما عَمَّيْتَه شَبَحٌ","يُمحَى بِتيجانِه الأغساقُ والظُّلَمُ",58,"م",1,0],["وَانْثَنَى تَكْنُفُهُ أَنْوَارُهُ","ثُمَّ مَا سَلَّمَ حَتَّى وَدَّعَا",59,"ع",2,0],["وانثُرنَ منها في الصباحِ على الصَّبا","كتناثُرِ الأعلاقِ من أيدينا",60,"ن",2,0],["وانْثَنَتْ تَثْنِي بِمَا صَنَعَتْ","صِدْقَ تَعْويدٍ وَتَعْويلِ",61,"ل",1,0],["وانْثَنَى مُنْكَسِراً مِنْ وَجْدِهِ","بِكَسِيرِ الطَّرْفِ كَالظَّبْيِ سَنَحْ",62,"ح",1,0],["وَأنّ ثيابَ الزورِ عارٌ وعريةٌ","وَربّ أمورٍ كانَ فقداً وُجودها",63,"د",3,0],["وَاِنثُر مَزاياكَ الحِسانُ لَآلِئاً","مِن جَوهَرٍ يَسبي العُقولَ زَهيدُهُ",64,"د",2,0],["وانثَنَت لم تُسعِد الش","ط وللشطّ ابتهال",65,"ل",1,0],["وانثنت ترقبُ مسراها","بمسحور الجفون",66,"ن",1,0],["وانثرى الزهر والرياحين والجل","سان في كل مجمع ترتضينه",67,"ن",2,0],["وَاِنثَنَت عِندَها اِنثَنَت لي إِماماً","سَدرَةُ المُنتَهى إِلَيها وَرائي",68,"ي",1,0],["وَاِنثَنى في بَيتِ كَعبٍ كَعبَةً","أُمَّها طَوعاً لَهُ آلُ عُصَي",69,"ي",1,0],["وَأَنثني مِن لُطف أَلفاظِهِ","كَأَنَّما أَرشف كَأس المُدام",70,"م",1,0],["وَاِنثَنى قالَت الغُصون","كُلّنا في الهَوى سوى",71,"س",3,0],["وَإِنَّ ثَوبَ الَّذي عاداكُمُ كَفَنٌ","كَما بُيوتُ الَّذي عاصاكُمُ تُرَبُ",72,"ب",1,0],["وَإِن ثَموداً تَدَّعى الماءَ كُلَّهُ","فَقُل لِقُدارٍ وَيلَهُ قَد رَغا السَقبُ",73,"ب",1,0],["وَاِنثَنى وَالزَمانُ يُنشِدُ فيهِ","هكَذا تَخدِمُ المُلوكَ السُعودُ",74,"د",1,0],["وَإِنَّ ثُغوراً في يَدَي غَيرِ عامِلٍ","لِمِصرِكَ أَمسَت غَيرَ باسِمَةِ الثَغرِ",75,"ر",1,0],["وانثَنَينا بالمُعجِزاتِ ومِنها","كَرَمٌ يَترُكُ الزَّمانَ كَرِيما",76,"م",2,0],["وانثَنَت تحبِسُ الخيالَ احبسيهِ","أبداً لستُ نائماً فَيزورا",77,"ر",2,0],["وانثر أدمعي سحراً إذا ما","سمعت سويجع الأثلات غنّى",78,"ن",2,0],["وانثنَتْ في غلائلٍ حاكَها الخِصْ","بُ وكانَتْ بجدبِها أَغلالا",79,"ل",2,0],["وانثنت بالنوى عاصية","نون دال من برحا",80,"ح",2,0],["وانثنى الأسمرُ منها غُصُناً","وجرى الأبيضُ فيها جدولا",81,"ل",2,0],["وانثنَى والمدحُ يلويه كما","لوتِ النكباءُ رُمحاً خطِلا",81,"ل",2,0],["وانْثَنى فابْتَنى من المجدِ داراً","نالَ فيها بعزمِهِ ما رامَهْ",82,"م",2,0],["وأَنَّ ثناءَكَ أَزكى وأَذكى","عَلَى الدهر من طِيبِهِ المستجادِ",83,"د",1,0],["وانثنى ممسكا بنجمين مسرو","راً بما ناله شكورا قنوعا",84,"ع",2,0],["وانثنى الفتح ينتحي من أحادي","ث الهوى ممتعاته وقصاره",85,"ر",2,0],["وانثنى ابن القصَّار طوراً يغني","ه يحذقٍ مرقصاً طنباره",85,"ر",2,0],["وانثنى العود به مصطخباً","بالغريضات بضربٍ محكم",86,"م",1,0],["وانثنى ينشرُ منها عذبا","ويضم الغصن كالملتزمِ",86,"م",1,0],["وأن ثلاثتَه واحدٌ","ويزعُم من ردَّ هذا جهِلْ",87,"ل",1,0],["وانْثَنتْ مٍن حَزَنِ الدَّهر به","غُرَرُ الأيامِ سُوداً كالَّيالي",88,"ل",2,0],["وَاِنثَنَت فَاِنثَنى إِلى الحُبِّ قَلبي","وَتَيَقَّنتُ أَنَّهُ حانَ حَيني",89,"ن",2,0],["وانثر عليه دعاء","مما تلوته زهرا",90,"ر",2,0],["وأنثر راية الدستور فيها","لينظرها عيانا كل طرف",91,"ف",1,0],["وانثر على قصر العقيق عقيق دم","عِ صبابة الوجد الكئيب الأكمد",92,"د",1,0],["وانثر إذن درر الدموع على الثرا","واقرأ تحيات الهيام نزيها",93,"ي",3,0],["واِنثَنى القلبُ خافِقاً إذ تجلّى","مُصْلتاً صارِم الهِلالِ المُنيرِ",94,"ر",1,0],["واِنثنَتْ تَقلِبُ الفَلاةَ عليهمِ","بمَداري قوائمٍ كالدَّبورِ",94,"ر",1,0],["وإنّ ثمار الزّرع يُجنى إذا مضى","على الزّرع أزمانٌ وزالتْ حوائلُ",95,"ل",1,0],["واِنثنى الجسمُ لجُرْدِ ال","خيلِ بالعَدْوِ رضيضا",96,"ض",2,0],["وانثنت أغصاننا من","أمره بالنسمات",97,"ت",1,0],["وانْثَنَوا حين أَفرد الملك عنهم","يندُبُون الأَعْمالَ والأَعْمَارَا",98,"ر",2,0],["وَأَنَّ ثَناياهُ نُجُومٌ لِبَدْرِهِ","وهُنَّ لِعقْدِ الحُسْنِ فِيهِ فَرائِدُ",99,"د",1,0]]}