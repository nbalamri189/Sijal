{"poems":[[53,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[86,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[86,"يا صاحب الروضة الغناء هجت بنا","https://www.aldiwan.net/poem68930.html","البسيط"],[93,"يا عبرة الدهر جاوزت المدى فينا","https://www.aldiwan.net/poem11172.html","البسيط"],[54,"عاذلي لو شئت لم تلم","https://www.aldiwan.net/poem27479.html","المديد"],[30,"ألا أيهذا المنزل الدارس اسلم","https://www.aldiwan.net/poem29526.html","الطويل"],[72,"وقائع حب حار في كرها فكري","https://www.aldiwan.net/poem18705.html","الطويل"],[72,"كل حي قاض عليه زواله","https://www.aldiwan.net/poem19528.html","الخفيف"],[95,"ملحمة النبي","https://www.aldiwan.net/poem60153.html","عموديه"],[51,"أمون من العظعاظ عند مروقها","https://www.aldiwan.net/poem65078.html","الطويل"],[91,"أنا إن أغمض الحمام جفوني","https://www.aldiwan.net/poem62792.html","عموديه"],[92,"يا إله الوجود هذي جراح","https://www.aldiwan.net/poem38885.html","الخفيف"],[85,"كانت النملة تمشي","https://www.aldiwan.net/poem8035.html","مجزوء الرمل"],[85,"قام من علته الشاكي الوصب","https://www.aldiwan.net/poem62920.html","الرمل"],[43,"كفرندي فرند سيفي الجراز","https://www.aldiwan.net/poem9609.html","الخفيف"],[45,"أحرام أن ينجز الموعود","https://www.aldiwan.net/poem63501.html","الخفيف"],[28,"إن تك كلبا من كليب فإنني","https://www.aldiwan.net/poem5367.html","الطويل"],[61,"وجد الحب لي فؤادا علوقا","https://www.aldiwan.net/poem51502.html","الخفيف"],[49,"رأيت الشيب يعدوكا","https://www.aldiwan.net/poem62205.html","الهزج"],[49,"يسلم المرء أخوه","https://www.aldiwan.net/poem63192.html","مجزوء الرمل"],[66,"وغزال غازلته بعد بين","https://www.aldiwan.net/poem39511.html","الكامل"],[66,"خذ من الدهر لي نصيب","https://www.aldiwan.net/poem41371.html","مجزوء الخفيف"],[74,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[52,"أيا وادي الأحباب سقيت واديا","https://www.aldiwan.net/poem26567.html","الطويل"],[52,"مر عيش علي قد كان لذا","https://www.aldiwan.net/poem27057.html","الخفيف"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[46,"يسمون بالجهل عبد الرحيم","https://www.aldiwan.net/poem22499.html","المتقارب"],[46,"عجبت وكم عجب في الزمان","https://www.aldiwan.net/poem23264.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85523","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39648","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54620","البسيط"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199490","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54319","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54208","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[90,"جناية الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=178941",""],[54,"عاذِلي ! لو شئتَ لمْ تلمِ","https://www.poetsgate.com/ViewPoem.aspx?id=14488",""],[28,"إن تك كلبا من كليب فإنني","https://www.poetsgate.com/ViewPoem.aspx?id=22110",""]],"verses":[["وَاِنثُر عَلى الشَربِ سِمطاً مِن فَواقِعِها","وَاِبنَ الغَمامِ مُسَمّىً بِاِبنَةِ العِنَبِ",0,"ب",1,0],["وَاِنثَنى راجِعاً إِلى شاطِئِ النَه","رِ رُجوعَ الكَمِيِّ غِبَّ اِغتِنامِ",1,"م",1,0],["وَاِنثُر عَلى الغَربِ مِن تِلكَ الحُلى وَأَشِد","بِكُلِّ حُسّانَةَ فينا وَحُسّانِ",2,"ن",1,0],["وَانْثَلَّ مِنْ عِزِّنَا مَا عَزَّ مَطْلَبُهُ","وَانْدَكَّ مِنْ مَجْدِنَا مَا شَادَ بَانِينَا",3,"ن",2,0],["وَاِنثَنَت أَفياءُ نَبعَتِها","عَن نَباتٍ سالَ كَالجُمَمِ",4,"م",1,0],["وَإِن ثَوَّبَ الداعي بِها يا لَخِندِفٍ","فَيا لَكَ مِن داعٍ مُعَزٍّ مُكَرَمِ",5,"م",1,0],["وأن ثناه فاضحٌ حصرَ الورى","وأنَّ ندَاه لا يحاوَل بالحصر",6,"ر",1,0],["وانْثر الدمعَ حول مثواه نثراً","مثل ما ينثر الكلام ارْتجاله",7,"ل",2,0],["وانثنت تضرب الرمال اختيالا","بخطى جاهلية عمياء",8,"ا",2,0],["وانثنت والرياح تجار والرمل","نثير في الأوجة الربداء",8,"ا",2,0],["وإن ثَقفته أنفذته وقدّرت","له ما يوازيه من الأرض مصرعا",9,"ع",2,0],["وَاِنثُري الوَردَ حَولَهُ وَعَلَيهِ","وَاِغرُسي عِندَ قَلبِهِ ياسَمينَه",10,"ن",2,0],["وانثُري الوَرْدَ للثُّلوجِ بدَاداً","واصعقي كلّ بُلبلٍ تَيَّاهِ",11,"ه",1,0],["وَاِنثَنَت تَنظُرُ حَتّى","أَوجَدَ الخَوفُ وَأَعدَم",12,"م",1,0],["وَاِنثُرِ الشِعرَ عَلى الأَبرارِ في","قُدُسِ الساحِ وَعُلوِيِّ الرَحِب",13,"ب",1,0],["وَاِنثَنى عَنِّيَ الرُدَينِيُّ حَتّى","دارَ دَورَ الحُروفِ في هَوّازِ",14,"ز",1,0],["وَاِنثَنَت وِجهَةَ الفِراقِ فَأَرسَل","تُ إِلَيها عَيناً عَلَيها تَجودُ",15,"د",1,0],["وَإِنَّ ثِيابَ المُلكِ في آلِ دارِمٍ","هُمُ وَرِثوها لا كُلَيبُ النَواهِقِ",16,"ق",1,0],["وَإِنَّ ثِيابي مِن ثِيابِ مُحَرِّقٍ","وَلَم أَستَعِرها مِن مُعاعٍ وَناعِقِ",16,"ق",1,0],["وانثَنى الحَاسِدونَ عن سابقٍ من","كَ إلى المَجدِ أن يُرى مَسبوقا",17,"ق",2,0],["وَإِن ثَقُلتَ مَلّوكا","وَعابوكَ وَسَبّوكا",18,"ك",2,0],["وَاِنثَنَوا عَنهُ وَخَلَّو","هُ كَأَن لَم يَعرِفوهُ",19,"و",2,0],["وَاِنثَنى باكِياً يُقَبِّلُ كَفَّي","يَ وَيَهوي طَوراً عَلى القَدَمَينِ",20,"ن",1,0],["وَاِنثَنى غُصنُها الوَريق","فَشَدَت فَوقَهُ الحَمام",21,"م",1,0],["وَاِنثَنى يَمشي بِهِ غُصُنٌ","مِن جَناهُ نَورُ مُبتَسِمِ",22,"م",1,0],["وَإِن ثَقَبَتهُ العَينُ لاقَت قَرارَهُ","تَخالُ الحَصى فيها نُجوماً رَواسِيا",23,"ي",2,0],["وَاِنثَنى عَنّيَّ الشَبابُ وَغودِر","تُ فَريداً مِنَ الأَحِبَةِ فَذّا",24,"ذ",2,0],["وإن ثَبَّتَ الأقدامَ قَرّتْ قرارَهَا","فكانَ الهِدانُ النِّكسُ أوّلَ مُقْدِم",25,"م",1,0],["وَإِنَّ ثُمَوداً أَتَت بَحَرهُم","خُطوبٌ فَما تَرَكَت مِن ثَمَد",26,"د",1,0],["وَإِنَّ ثَبيراً لَهُ خِفَّةٌ","تَبينُ عَلى كِفِّةِ الشائِلِ",27,"ل",1,0],["واِنثَنى منتفضاً","وجثا مستترا",28,"ر",2,0],["وانثنتْ بابتسامةٍ فدعتني","ثم قامت تمشي هناك الهوينا",29,"ن",2,0],["وَانْثُرْ عَلَى الْوَادِي مِنْ عِلْمٍ وَمِنْ أَدْبٍ","فَإِنَّ ذَا الشَّعْبِ يَهْوَى العِلْمَ وَالأَدَبَا",30,"ب",2,0],["وانثر الوردَ علي جموعيَ الغفيرهْ","ضفيرتي تعبث بالغيوم",31,"م",1,0],["وانثُرِ الشِّعْرَ للعروسينِ زَهْراً","وانظمِ الزَّهْرَ للعروسين شِعْرا",32,"ر",2,0],["وانْثُرْ أَزَاهِيراً عَلَى الزَّهْرِ الَّذي","كانَتْ لَه كُلُّ القُلوبِ كِماما",33,"م",2,0],["وانثُرُوها قلائداً وعُقُوداً","تتَحدى قَلائدَ العِقْيانِ",34,"ن",1,0],["وإن ثيابَ الناس زُرَّت جميعُها","على عاهةٍ إلاّ ثيابَ المؤازر",35,"ر",1,0],["وانثنى \" كالاطار \" يحتضِنُ الصّورةَ","تُزْهَى ، أو جَدْولٍ في كتاب",36,"ب",1,0],["وانثنى الغصن ولولا أنه","حامل ما لم يطقه ما أنثنى",37,"ن",2,0],["وانُثَنَتْ أَفياءُ نَبْعَتِها","عنْ نباتٍ سالَ كالجمِ",38,"م",1,0],["وإنَّ ثِيَابَ المُلْكِ في آلِ دَارِم","هُمْ وَرِثوهَا. لا كُلَيْبُ الحَّواهِق",39,"ق",1,0]]}