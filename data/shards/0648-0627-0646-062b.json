{"poems":[[53,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[86,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[86,"يا صاحب الروضة الغناء هجت بنا","https://www.aldiwan.net/poem68930.html","البسيط"],[93,"يا عبرة الدهر جاوزت المدى فينا","https://www.aldiwan.net/poem11172.html","البسيط"],[54,"عاذلي لو شئت لم تلم","https://www.aldiwan.net/poem27479.html","المديد"],[30,"ألا أيهذا المنزل الدارس اسلم","https://www.aldiwan.net/poem29526.html","الطويل"],[72,"وقائع حب حار في كرها فكري","https://www.aldiwan.net/poem18705.html","الطويل"],[72,"كل حي قاض عليه زواله","https://www.aldiwan.net/poem19528.html","الخفيف"],[95,"ملحمة النبي","https://www.aldiwan.net/poem60153.html","عموديه"],[51,"أمون من العظعاظ عند مروقها","https://www.aldiwan.net/poem65078.html","الطويل"],[91,"أنا إن أغمض الحمام جفوني","https://www.aldiwan.net/poem62792.html","عموديه"],[92,"يا إله الوجود هذي جراح","https://www.aldiwan.net/poem38885.html","الخفيف"],[85,"كانت النملة تمشي","https://www.aldiwan.net/poem8035.html","مجزوء الرمل"],[85,"قام من علته الشاكي الوصب","https://www.aldiwan.net/poem62920.html","الرمل"],[43,"كفرندي فرند سيفي الجراز","https://www.aldiwan.net/poem9609.html","الخفيف"],[45,"أحرام أن ينجز الموعود","https://www.aldiwan.net/poem63501.html","الخفيف"],[28,"إن تك كلبا من كليب فإنني","https://www.aldiwan.net/poem5367.html","الطويل"],[61,"وجد الحب لي فؤادا علوقا","https://www.aldiwan.net/poem51502.html","الخفيف"],[49,"رأيت الشيب يعدوكا","https://www.aldiwan.net/poem62205.html","الهزج"],[49,"يسلم المرء أخوه","https://www.aldiwan.net/poem63192.html","مجزوء الرمل"],[66,"وغزال غازلته بعد بين","https://www.aldiwan.net/poem39511.html","الكامل"],[66,"خذ من الدهر لي نصيب","https://www.aldiwan.net/poem41371.html","مجزوء الخفيف"],[74,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[52,"أيا وادي الأحباب سقيت واديا","https://www.aldiwan.net/poem26567.html","الطويل"],[52,"مر عيش علي قد كان لذا","https://www.aldiwan.net/poem27057.html","الخفيف"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[46,"يسمون بالجهل عبد الرحيم","https://www.aldiwan.net/poem22499.html","المتقارب"],[46,"عجبت وكم عجب في الزمان","https://www.aldiwan.net/poem23264.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85523","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39648","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54620","البسيط"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199490","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54319","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54208","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[90,"جناية الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=178941",""],[54,"عاذِلي ! لو شئتَ لمْ تلمِ","https://www.poetsgate.com/ViewPoem.aspx?id=14488",""],[28,"إن تك كلبا من كليب فإنني","https://www.poetsgate.com/ViewPoem.aspx?id=22110",""],[123,"يا خليلي بالركاب سحيراً","https://www.aldiwan.net/poem4101.html","الخفيف"],[125,"أعباس إن الذي بيننا","https://www.aldiwan.net/poem24257.html","المتقارب"],[127,"ذكر الطائر الرياض فغنى","https://www.aldiwan.net/poem67452.html","البسيط"],[162,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[187,"أموا المدينة حيث جل المغنم","https://www.aldiwan.net/poem35107.html","الكامل"],[195,"هات يا ساق هات بنت النخيل","https://www.aldiwan.net/poem39944.html","الخفيف"],[196,"رب ليل أتحفت فيه بأنس","https://www.aldiwan.net/poem51935.html","الخفيف"],[197,"فتكت في الناس أعينها","https://www.aldiwan.net/poem45234.html","المديد"],[208,"بدا يختال كالقمر المفدى","https://www.aldiwan.net/poem13553.html","الوافر"],[221,"بينما كان فتى المستقبل","https://www.aldiwan.net/poem41633.html","الرمل"],[221,"أترى جاءت لكي تصطاد","https://www.aldiwan.net/poem41904.html","مجزوء الرمل"],[221,"حاذر الحب إن في الحب شرا","https://www.aldiwan.net/poem41905.html","الخفيف"],[223,"إنظمى الدر يا سمية إسكندر","https://www.aldiwan.net/poem55204.html","الخفيف"],[223,"لم يدر أن ملامه أغراكا","https://www.aldiwan.net/poem55231.html","الطويل"],[227,"حللت عقد المعاني فاعتلى الكلم","https://www.aldiwan.net/poem50824.html","البسيط"],[235,"يا جميل الصبر لب من دعا","https://www.aldiwan.net/poem19492.html","الرمل"],[268,"سحرا مشى الفتيان مبتسمينا","https://www.aldiwan.net/poem35623.html","الكامل"],[273,"لم يخن في الحب تأويلي","https://www.aldiwan.net/poem25541.html","المديد"],[278,"أترى أبصره مثلي القدح","https://www.aldiwan.net/poem60587.html","المتقارب"],[303,"سما للعلى يقظان عين حديدها","https://www.aldiwan.net/poem56578.html","الطويل"],[318,"بقبول صومك قد تبسم عيده","https://www.aldiwan.net/poem67216.html","الكامل"],[326,"هتف الشاطىء بالمدح","https://www.aldiwan.net/poem55007.html","مجزوء الرمل"],[326,"خطرت كالنسمة السكرى","https://www.aldiwan.net/poem55050.html","مجزوء الرمل"],[326,"رتل البلبل الطروب لحونه","https://www.aldiwan.net/poem55066.html","الخفيف"],[347,"أمرتني بستر كشف غطائي","https://www.aldiwan.net/poem15499.html","الخفيف"],[347,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[351,"أنسمة فاحت بنشر الخزام","https://www.aldiwan.net/poem39801.html","السريع"],[351,"قم بنا أيها الحبيب","https://www.aldiwan.net/poem40222.html","مجزوء الخفيف"],[364,"أما ومنك على أعدائك الطلب","https://www.aldiwan.net/poem17155.html","البسيط"],[364,"أبى الغمض والتمهيد جفناي والجنب","https://www.aldiwan.net/poem17158.html","الطويل"],[364,"لا تحدث سواك نفس بفضل","https://www.aldiwan.net/poem17184.html","الخفيف"],[364,"لكم في زبور الله يا مبلغي الذكر","https://www.aldiwan.net/poem17200.html","الطويل"],[369,"وإذا ما الزمان أعرض عني","https://www.aldiwan.net/poem57126.html","الطويل"],[369,"ما استطاعت أن تهجر المهجورا","https://www.aldiwan.net/poem57455.html","الخفيف"],[426,"لعمرك يا أخا الأشواق أنا","https://www.aldiwan.net/poem40258.html","الوافر"],[429,"ضرب الناس في العلا الأمثالا","https://www.aldiwan.net/poem12373.html","الخفيف"],[429,"ذكر الركب الذي نزحا","https://www.aldiwan.net/poem12393.html","المديد"],[429,"مل من صبوته ما أملا","https://www.aldiwan.net/poem12453.html","الرمل"],[429,"حمل الريح بالأصيل سلامه","https://www.aldiwan.net/poem12719.html","الخفيف"],[436,"وفيهن أضحيت يوم الأضاحي","https://www.aldiwan.net/poem34845.html","المتقارب"],[441,"بعد خلق الأكوان خلقا بديعا","https://www.aldiwan.net/poem56043.html","الخفيف"],[450,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[450,"يا ليالي السفح من عهد الصبا","https://www.aldiwan.net/poem13926.html","الرمل"],[456,"إذا عارض نحو أرض عدل","https://www.aldiwan.net/poem56076.html","المتقارب"],[459,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[466,"باعدت بالبعاد بيني وبينى","https://www.aldiwan.net/poem59601.html","الخفيف"],[477,"صبرا لحكمك صبرا","https://www.aldiwan.net/poem37050.html","المجتث"],[477,"أسائلكم أنا من أي صنف","https://www.aldiwan.net/poem37585.html","الوافر"],[480,"عرج بمنعرج الكثيب الأخضد","https://www.aldiwan.net/poem24364.html","عموديه"],[498,"عرج بعيس القوم يا حاديها","https://www.aldiwan.net/poem37637.html","الكامل"],[512,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[549,"توق ديار الحي فهي المقاتل","https://www.aldiwan.net/poem47325.html","الطويل"],[549,"يا خليلي ومعيني","https://www.aldiwan.net/poem47735.html","مجزوء الرمل"],[556,"ظهرت ذاتي لذاتي","https://www.aldiwan.net/poem34729.html","مجزوء الرمل"],[573,"أوقد الحسن فوق خديك نارا","https://www.aldiwan.net/poem3068.html","الخفيف"],[584,"وما فيه من حسن سوى أن طرفه","https://www.aldiwan.net/poem17481.html","الطويل"]],"verses":[["وَاِنثُر عَلى الشَربِ سِمطاً مِن فَواقِعِها","وَاِبنَ الغَمامِ مُسَمّىً بِاِبنَةِ العِنَبِ",0,"ب",1,0],["وَاِنثَنى راجِعاً إِلى شاطِئِ النَه","رِ رُجوعَ الكَمِيِّ غِبَّ اِغتِنامِ",1,"م",1,0],["وَاِنثُر عَلى الغَربِ مِن تِلكَ الحُلى وَأَشِد","بِكُلِّ حُسّانَةَ فينا وَحُسّانِ",2,"ن",1,0],["وَانْثَلَّ مِنْ عِزِّنَا مَا عَزَّ مَطْلَبُهُ","وَانْدَكَّ مِنْ مَجْدِنَا مَا شَادَ بَانِينَا",3,"ن",2,0],["وَاِنثَنَت أَفياءُ نَبعَتِها","عَن نَباتٍ سالَ كَالجُمَمِ",4,"م",1,0],["وَإِن ثَوَّبَ الداعي بِها يا لَخِندِفٍ","فَيا لَكَ مِن داعٍ مُعَزٍّ مُكَرَمِ",5,"م",1,0],["وأن ثناه فاضحٌ حصرَ الورى","وأنَّ ندَاه لا يحاوَل بالحصر",6,"ر",1,0],["وانْثر الدمعَ حول مثواه نثراً","مثل ما ينثر الكلام ارْتجاله",7,"ل",2,0],["وانثنت تضرب الرمال اختيالا","بخطى جاهلية عمياء",8,"ا",2,0],["وانثنت والرياح تجار والرمل","نثير في الأوجة الربداء",8,"ا",2,0],["وإن ثَقفته أنفذته وقدّرت","له ما يوازيه من الأرض مصرعا",9,"ع",2,0],["وَاِنثُري الوَردَ حَولَهُ وَعَلَيهِ","وَاِغرُسي عِندَ قَلبِهِ ياسَمينَه",10,"ن",2,0],["وانثُري الوَرْدَ للثُّلوجِ بدَاداً","واصعقي كلّ بُلبلٍ تَيَّاهِ",11,"ه",1,0],["وَاِنثَنَت تَنظُرُ حَتّى","أَوجَدَ الخَوفُ وَأَعدَم",12,"م",1,0],["وَاِنثُرِ الشِعرَ عَلى الأَبرارِ في","قُدُسِ الساحِ وَعُلوِيِّ الرَحِب",13,"ب",1,0],["وَاِنثَنى عَنِّيَ الرُدَينِيُّ حَتّى","دارَ دَورَ الحُروفِ في هَوّازِ",14,"ز",1,0],["وَاِنثَنَت وِجهَةَ الفِراقِ فَأَرسَل","تُ إِلَيها عَيناً عَلَيها تَجودُ",15,"د",1,0],["وَإِنَّ ثِيابَ المُلكِ في آلِ دارِمٍ","هُمُ وَرِثوها لا كُلَيبُ النَواهِقِ",16,"ق",1,0],["وَإِنَّ ثِيابي مِن ثِيابِ مُحَرِّقٍ","وَلَم أَستَعِرها مِن مُعاعٍ وَناعِقِ",16,"ق",1,0],["وانثَنى الحَاسِدونَ عن سابقٍ من","كَ إلى المَجدِ أن يُرى مَسبوقا",17,"ق",2,0],["وَإِن ثَقُلتَ مَلّوكا","وَعابوكَ وَسَبّوكا",18,"ك",2,0],["وَاِنثَنَوا عَنهُ وَخَلَّو","هُ كَأَن لَم يَعرِفوهُ",19,"و",2,0],["وَاِنثَنى باكِياً يُقَبِّلُ كَفَّي","يَ وَيَهوي طَوراً عَلى القَدَمَينِ",20,"ن",1,0],["وَاِنثَنى غُصنُها الوَريق","فَشَدَت فَوقَهُ الحَمام",21,"م",1,0],["وَاِنثَنى يَمشي بِهِ غُصُنٌ","مِن جَناهُ نَورُ مُبتَسِمِ",22,"م",1,0],["وَإِن ثَقَبَتهُ العَينُ لاقَت قَرارَهُ","تَخالُ الحَصى فيها نُجوماً رَواسِيا",23,"ي",2,0],["وَاِنثَنى عَنّيَّ الشَبابُ وَغودِر","تُ فَريداً مِنَ الأَحِبَةِ فَذّا",24,"ذ",2,0],["وإن ثَبَّتَ الأقدامَ قَرّتْ قرارَهَا","فكانَ الهِدانُ النِّكسُ أوّلَ مُقْدِم",25,"م",1,0],["وَإِنَّ ثُمَوداً أَتَت بَحَرهُم","خُطوبٌ فَما تَرَكَت مِن ثَمَد",26,"د",1,0],["وَإِنَّ ثَبيراً لَهُ خِفَّةٌ","تَبينُ عَلى كِفِّةِ الشائِلِ",27,"ل",1,0],["واِنثَنى منتفضاً","وجثا مستترا",28,"ر",2,0],["وانثنتْ بابتسامةٍ فدعتني","ثم قامت تمشي هناك الهوينا",29,"ن",2,0],["وَانْثُرْ عَلَى الْوَادِي مِنْ عِلْمٍ وَمِنْ أَدْبٍ","فَإِنَّ ذَا الشَّعْبِ يَهْوَى العِلْمَ وَالأَدَبَا",30,"ب",2,0],["وانثر الوردَ علي جموعيَ الغفيرهْ","ضفيرتي تعبث بالغيوم",31,"م",1,0],["وانثُرِ الشِّعْرَ للعروسينِ زَهْراً","وانظمِ الزَّهْرَ للعروسين شِعْرا",32,"ر",2,0],["وانْثُرْ أَزَاهِيراً عَلَى الزَّهْرِ الَّذي","كانَتْ لَه كُلُّ القُلوبِ كِماما",33,"م",2,0],["وانثُرُوها قلائداً وعُقُوداً","تتَحدى قَلائدَ العِقْيانِ",34,"ن",1,0],["وإن ثيابَ الناس زُرَّت جميعُها","على عاهةٍ إلاّ ثيابَ المؤازر",35,"ر",1,0],["وانثنى \" كالاطار \" يحتضِنُ الصّورةَ","تُزْهَى ، أو جَدْولٍ في كتاب",36,"ب",1,0],["وانثنى الغصن ولولا أنه","حامل ما لم يطقه ما أنثنى",37,"ن",2,0],["وانُثَنَتْ أَفياءُ نَبْعَتِها","عنْ نباتٍ سالَ كالجمِ",38,"م",1,0],["وإنَّ ثِيَابَ المُلْكِ في آلِ دَارِم","هُمْ وَرِثوهَا. لا كُلَيْبُ الحَّواهِق",39,"ق",1,0],["وانثنى مِعطفُ القَضيب اختيالاً","لِغِناءِ الحَمامَةِ الوَرقاء",40,"ا",2,0],["وَأَنَّ ثَنِيَّةَ رَأسِ الهِجا","بيني وبينك لا تطلع",41,"ع",1,0],["وانثنى يرمُقُ الخَيالَ ويَشدو","من فنونِ الإنشادِ لحناً فلَحنا",42,"ن",2,0],["وَإِن ثَوَت بينَ ضُلوعي زَفرَةٌ","تَملأُ ما بَينَ الرَجا إِلى الرَجا",43,"ا",1,0],["وَاِنثُر بِمدحِهما اللآلئَ واِنظمِ","مَهما اِستطعتَ القول قُل وترنّم",44,"م",1,0],["وانثُرِ الشوكَ أيّها الأرقُ المرُّ","على مضجعِ الدعيّ الملولِ",45,"ل",1,0],["وانثنى الليلُ يَفْضُلُ الصبح حسناً","والدراري يفضُلْنَ فيه الشموسا",46,"س",2,0],["وانثنت عُجباً فلستَ ترى","عاشقاً إلا ويعجُبها",47,"ب",3,0],["وانثرها دموعا كالالآلي","تكاد بجيده ينظمن عقدا",48,"د",2,0],["وَاِنثَنى من وجهِه مُستَعجِلاً","راغِباً في مَشيةِ المُستَعجل",49,"ل",1,0],["وَاِنثَنَت تَلحس سَنّا","رَتَها مُذ أَكَلَتهُ",50,"ه",1,0],["وَاِنثنى هائِماً عَلى نَفسِهِ الثَك","لى فَلَم يُستَفق وَلم يُستقرّا",51,"ر",2,0],["وَاِنثُريهِ فَالدُرُّ دُرٌّ وَإِن لَم","يَدِّخِره تُجّارُهُ في سُلوكِ",52,"ك",1,0],["وَاِنثُر دموعَك في ثَراه صبابَةً","علَّ البكاءَ يُزيلُ بعضَ جواكا",53,"ك",2,0],["وأنَّ ثانِي ما أضمَرْتَه قَدَحٌ","كأنّه مِن بيَاضِ الصُّبحِ ملتئِمُ",54,"م",1,0],["وأنّ ثالثَ ما عَمَّيْتَه شَبَحٌ","يُمحَى بِتيجانِه الأغساقُ والظُّلَمُ",54,"م",1,0],["وَانْثَنَى تَكْنُفُهُ أَنْوَارُهُ","ثُمَّ مَا سَلَّمَ حَتَّى وَدَّعَا",55,"ع",2,0],["وانثُرنَ منها في الصباحِ على الصَّبا","كتناثُرِ الأعلاقِ من أيدينا",56,"ن",2,0],["وانْثَنَتْ تَثْنِي بِمَا صَنَعَتْ","صِدْقَ تَعْويدٍ وَتَعْويلِ",57,"ل",1,0],["وانْثَنَى مُنْكَسِراً مِنْ وَجْدِهِ","بِكَسِيرِ الطَّرْفِ كَالظَّبْيِ سَنَحْ",58,"ح",1,0],["وَأنّ ثيابَ الزورِ عارٌ وعريةٌ","وَربّ أمورٍ كانَ فقداً وُجودها",59,"د",3,0],["وَاِنثُر مَزاياكَ الحِسانُ لَآلِئاً","مِن جَوهَرٍ يَسبي العُقولَ زَهيدُهُ",60,"د",2,0],["وانثَنَت لم تُسعِد الش","ط وللشطّ ابتهال",61,"ل",1,0],["وانثنت ترقبُ مسراها","بمسحور الجفون",62,"ن",1,0],["وانثرى الزهر والرياحين والجل","سان في كل مجمع ترتضينه",63,"ن",2,0],["وَاِنثَنَت عِندَها اِنثَنَت لي إِماماً","سَدرَةُ المُنتَهى إِلَيها وَرائي",64,"ي",1,0],["وَاِنثَنى في بَيتِ كَعبٍ كَعبَةً","أُمَّها طَوعاً لَهُ آلُ عُصَي",65,"ي",1,0],["وَأَنثني مِن لُطف أَلفاظِهِ","كَأَنَّما أَرشف كَأس المُدام",66,"م",1,0],["وَاِنثَنى قالَت الغُصون","كُلّنا في الهَوى سوى",67,"س",3,0],["وَإِنَّ ثَوبَ الَّذي عاداكُمُ كَفَنٌ","كَما بُيوتُ الَّذي عاصاكُمُ تُرَبُ",68,"ب",1,0],["وَإِن ثَموداً تَدَّعى الماءَ كُلَّهُ","فَقُل لِقُدارٍ وَيلَهُ قَد رَغا السَقبُ",69,"ب",1,0],["وَاِنثَنى وَالزَمانُ يُنشِدُ فيهِ","هكَذا تَخدِمُ المُلوكَ السُعودُ",70,"د",1,0],["وَإِنَّ ثُغوراً في يَدَي غَيرِ عامِلٍ","لِمِصرِكَ أَمسَت غَيرَ باسِمَةِ الثَغرِ",71,"ر",1,0],["وانثَنَينا بالمُعجِزاتِ ومِنها","كَرَمٌ يَترُكُ الزَّمانَ كَرِيما",72,"م",2,0],["وانثَنَت تحبِسُ الخيالَ احبسيهِ","أبداً لستُ نائماً فَيزورا",73,"ر",2,0],["وانثر أدمعي سحراً إذا ما","سمعت سويجع الأثلات غنّى",74,"ن",2,0],["وانثنَتْ في غلائلٍ حاكَها الخِصْ","بُ وكانَتْ بجدبِها أَغلالا",75,"ل",2,0],["وانثنت بالنوى عاصية","نون دال من برحا",76,"ح",2,0],["وانثنى الأسمرُ منها غُصُناً","وجرى الأبيضُ فيها جدولا",77,"ل",2,0],["وانثنَى والمدحُ يلويه كما","لوتِ النكباءُ رُمحاً خطِلا",77,"ل",2,0],["وانْثَنى فابْتَنى من المجدِ داراً","نالَ فيها بعزمِهِ ما رامَهْ",78,"م",2,0],["وأَنَّ ثناءَكَ أَزكى وأَذكى","عَلَى الدهر من طِيبِهِ المستجادِ",79,"د",1,0],["وانثنى ممسكا بنجمين مسرو","راً بما ناله شكورا قنوعا",80,"ع",2,0],["وانثنى الفتح ينتحي من أحادي","ث الهوى ممتعاته وقصاره",81,"ر",2,0],["وانثنى ابن القصَّار طوراً يغني","ه يحذقٍ مرقصاً طنباره",81,"ر",2,0],["وانثنى العود به مصطخباً","بالغريضات بضربٍ محكم",82,"م",1,0],["وانثنى ينشرُ منها عذبا","ويضم الغصن كالملتزمِ",82,"م",1,0],["وأن ثلاثتَه واحدٌ","ويزعُم من ردَّ هذا جهِلْ",83,"ل",1,0],["وانْثَنتْ مٍن حَزَنِ الدَّهر به","غُرَرُ الأيامِ سُوداً كالَّيالي",84,"ل",2,0],["وَاِنثَنَت فَاِنثَنى إِلى الحُبِّ قَلبي","وَتَيَقَّنتُ أَنَّهُ حانَ حَيني",85,"ن",2,0],["وانثر عليه دعاء","مما تلوته زهرا",86,"ر",2,0],["وأنثر راية الدستور فيها","لينظرها عيانا كل طرف",87,"ف",1,0],["وانثر على قصر العقيق عقيق دم","عِ صبابة الوجد الكئيب الأكمد",88,"د",1,0],["وانثر إذن درر الدموع على الثرا","واقرأ تحيات الهيام نزيها",89,"ي",3,0],["واِنثَنى القلبُ خافِقاً إذ تجلّى","مُصْلتاً صارِم الهِلالِ المُنيرِ",90,"ر",1,0],["واِنثنَتْ تَقلِبُ الفَلاةَ عليهمِ","بمَداري قوائمٍ كالدَّبورِ",90,"ر",1,0],["وإنّ ثمار الزّرع يُجنى إذا مضى","على الزّرع أزمانٌ وزالتْ حوائلُ",91,"ل",1,0],["واِنثنى الجسمُ لجُرْدِ ال","خيلِ بالعَدْوِ رضيضا",92,"ض",2,0],["وانثنت أغصاننا من","أمره بالنسمات",93,"ت",1,0],["وانْثَنَوا حين أَفرد الملك عنهم","يندُبُون الأَعْمالَ والأَعْمَارَا",94,"ر",2,0],["وَأَنَّ ثَناياهُ نُجُومٌ لِبَدْرِهِ","وهُنَّ لِعقْدِ الحُسْنِ فِيهِ فَرائِدُ",95,"د",1,0]]}