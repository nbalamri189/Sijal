""],[5320,"حى راق","https://www.poetsgate.com/ViewPoem.aspx?id=43263",""],[5351,"موعد الله","https://www.poetsgate.com/ViewPoem.aspx?id=202649",""],[5409,"ذكرت صباً لها كان وفياً","https://www.poetsgate.com/ViewPoem.aspx?id=155366",""],[5409,"وقفت فيك أحيي المجد والحسبا","https://www.poetsgate.com/ViewPoem.aspx?id=155255",""],[5431,"مهما فعلت وكيفما ...","https://www.poetsgate.com/ViewPoem.aspx?id=198603",""],[5431,"دورة الشرّ","https://www.poetsgate.com/ViewPoem.aspx?id=213762",""],[5444,"قبلة الأشواق والإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=205445",""],[5461,"ليه إذا","https://www.poetsgate.com/ViewPoem.aspx?id=8538",""],[5542,"نفحة من بستان الوحي","https://www.poetsgate.com/ViewPoem.aspx?id=10057",""],[5596,"روحُ العوْدة","https://www.poetsgate.com/ViewPoem.aspx?id=206173",""],[5596,"تقريض كتاب دالية المحقق الخليلي","https://www.poetsgate.com/ViewPoem.aspx?id=206711",""],[5626,"مَن يُعطيني فماً ؟","https://www.poetsgate.com/ViewPoem.aspx?id=189692",""],[243,"تحية القرية","https://www.poetsgate.com/ViewPoem.aspx?id=50485",""],[5691,"ترتيلة مقدسية","https://www.poetsgate.com/ViewPoem.aspx?id=206355",""],[5718,"داو القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=214404",""],[5736,"نيفين","https://www.poetsgate.com/ViewPoem.aspx?id=208413",""],[5748,"ربّ ليل أتحفت فيه بأنس","https://www.poetsgate.com/ViewPoem.aspx?id=26155",""],[5847,"ألم وأمل","https://www.poetsgate.com/ViewPoem.aspx?id=6444",""],[5897,"إلى .. اليمن الذي كان سعيداً !","https://www.poetsgate.com/ViewPoem.aspx?id=176758",""],[6013,"يا نسيماً هب مسكاً عبقاً","https://www.poetsgate.com/ViewPoem.aspx?id=181605",""],[6045,"قُبلة من فم الأيّام","https://www.poetsgate.com/ViewPoem.aspx?id=125345",""],[6052,"وقفة على البحر الميت","https://www.poetsgate.com/ViewPoem.aspx?id=35193",""],[6056,"حلايا الحووور","https://www.poetsgate.com/ViewPoem.aspx?id=156712",""],[6070,"ما ضرَّكَ اليومُ لو أنْوارُهُ انطفَأتْ","https://www.poetsgate.com/ViewPoem.aspx?id=188786",""],[6075,"أماني عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=203788",""],[6084,"زارني ليلا وقد نام الرقيب","https://www.poetsgate.com/ViewPoem.aspx?id=170819",""],[6084,"أشرقت شمس الضحى بالغلس","https://www.poetsgate.com/ViewPoem.aspx?id=170846",""],[6089,"يا ابنَ ابتساماتي","https://www.poetsgate.com/ViewPoem.aspx?id=215727",""],[6124,"لما عرفت الحب","https://www.poetsgate.com/ViewPoem.aspx?id=174659",""],[6124,"يا بهي الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=174963",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6268,"إضاءة في خيمة الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82915&r=&rc=1",""],[6273,"وفاء للذكرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78505&r=&rc=3",""],[6324,"اللحن الشريد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87935&r=&rc=0",""]],"verses":[["وأنثر من نظمي عليهم قصائداً","حِضارُ المعاني في سِواها شوارد",0,"د",1,0],["وَاِنثُر عَلى الشَربِ سِمطاً مِن فَواقِعِها","وَاِبنَ الغَمامِ مُسَمّىً بِاِبنَةِ العِنَبِ",1,"ب",1,0],["وَاِنثَنى راجِعاً إِلى شاطِئِ النَه","رِ رُجوعَ الكَمِيِّ غِبَّ اِغتِنامِ",2,"م",1,0],["وَاِنثُر عَلى الغَربِ مِن تِلكَ الحُلى وَأَشِد","بِكُلِّ حُسّانَةَ فينا وَحُسّانِ",3,"ن",1,0],["وَانْثَلَّ مِنْ عِزِّنَا مَا عَزَّ مَطْلَبُهُ","وَانْدَكَّ مِنْ مَجْدِنَا مَا شَادَ بَانِينَا",4,"ن",2,0],["وَاِنثَنَت أَفياءُ نَبعَتِها","عَن نَباتٍ سالَ كَالجُمَمِ",5,"م",1,0],["وَإِن ثَوَّبَ الداعي بِها يا لَخِندِفٍ","فَيا لَكَ مِن داعٍ مُعَزٍّ مُكَرَمِ",6,"م",1,0],["وأن ثناه فاضحٌ حصرَ الورى","وأنَّ ندَاه لا يحاوَل بالحصر",7,"ر",1,0],["وانْثر الدمعَ حول مثواه نثراً","مثل ما ينثر الكلام ارْتجاله",8,"ل",2,0],["وانثنت تضرب الرمال اختيالا","بخطى جاهلية عمياء",9,"ا",2,0],["وانثنت والرياح تجار والرمل","نثير في الأوجة الربداء",9,"ا",2,0],["وإن ثَقفته أنفذته وقدّرت","له ما يوازيه من الأرض مصرعا",10,"ع",2,0],["وَاِنثُري الوَردَ حَولَهُ وَعَلَيهِ","وَاِغرُسي عِندَ قَلبِهِ ياسَمينَه",11,"ن",2,0],["وانثُري الوَرْدَ للثُّلوجِ بدَاداً","واصعقي كلّ بُلبلٍ تَيَّاهِ",12,"ه",1,0],["وَاِنثَنَت تَنظُرُ حَتّى","أَوجَدَ الخَوفُ وَأَعدَم",13,"م",1,0],["وَاِنثُرِ الشِعرَ عَلى الأَبرارِ في","قُدُسِ الساحِ وَعُلوِيِّ الرَحِب",14,"ب",1,0],["وَاِنثَنى عَنِّيَ الرُدَينِيُّ حَتّى","دارَ دَورَ الحُروفِ في هَوّازِ",15,"ز",1,0],["وَاِنثَنَت وِجهَةَ الفِراقِ فَأَرسَل","تُ إِلَيها عَيناً عَلَيها تَجودُ",16,"د",1,0],["وَإِنَّ ثِيابَ المُلكِ في آلِ دارِمٍ","هُمُ وَرِثوها لا كُلَيبُ النَواهِقِ",17,"ق",1,0],["وَإِنَّ ثِيابي مِن ثِيابِ مُحَرِّقٍ","وَلَم أَستَعِرها مِن مُعاعٍ وَناعِقِ",17,"ق",1,0],["وانثَنى الحَاسِدونَ عن سابقٍ من","كَ إلى المَجدِ أن يُرى مَسبوقا",18,"ق",2,0],["وَإِن ثَقُلتَ مَلّوكا","وَعابوكَ وَسَبّوكا",19,"ك",2,0],["وَاِنثَنَوا عَنهُ وَخَلَّو","هُ كَأَن لَم يَعرِفوهُ",20,"و",2,0],["وَاِنثَنى باكِياً يُقَبِّلُ كَفَّي","يَ وَيَهوي طَوراً عَلى القَدَمَينِ",21,"ن",1,0],["وَاِنثَنى غُصنُها الوَريق","فَشَدَت فَوقَهُ الحَمام",22,"م",1,0],["وَاِنثَنى يَمشي بِهِ غُصُنٌ","مِن جَناهُ نَورُ مُبتَسِمِ",23,"م",1,0],["وَإِن ثَقَبَتهُ العَينُ لاقَت قَرارَهُ","تَخالُ الحَصى فيها نُجوماً رَواسِيا",24,"ي",2,0],["وَاِنثَنى عَنّيَّ الشَبابُ وَغودِر","تُ فَريداً مِنَ الأَحِبَةِ فَذّا",25,"ذ",2,0],["وإن ثَبَّتَ الأقدامَ قَرّتْ قرارَهَا","فكانَ الهِدانُ النِّكسُ أوّلَ مُقْدِم",26,"م",1,0],["وَإِنَّ ثُمَوداً أَتَت بَحَرهُم","خُطوبٌ فَما تَرَكَت مِن ثَمَد",27,"د",1,0],["وَإِنَّ ثَبيراً لَهُ خِفَّةٌ","تَبينُ عَلى كِفِّةِ الشائِلِ",28,"ل",1,0],["واِنثَنى منتفضاً","وجثا مستترا",29,"ر",2,0],["وانثنتْ بابتسامةٍ فدعتني","ثم قامت تمشي هناك الهوينا",30,"ن",2,0],["وَانْثُرْ عَلَى الْوَادِي مِنْ عِلْمٍ وَمِنْ أَدْبٍ","فَإِنَّ ذَا الشَّعْبِ يَهْوَى العِلْمَ وَالأَدَبَا",31,"ب",2,0],["وانثر الوردَ علي جموعيَ الغفيرهْ","ضفيرتي تعبث بالغيوم",32,"م",1,0],["وانثُرِ الشِّعْرَ للعروسينِ زَهْراً","وانظمِ الزَّهْرَ للعروسين شِعْرا",33,"ر",2,0],["وانْثُرْ أَزَاهِيراً عَلَى الزَّهْرِ الَّذي","كانَتْ لَه كُلُّ القُلوبِ كِماما",34,"م",2,0],["وانثُرُوها قلائداً وعُقُوداً","تتَحدى قَلائدَ العِقْيانِ",35,"ن",1,0],["وانثنت مثلما يميس عمود","زنبقي تشتمّ أخبار (قائد)",36,"د",1,0],["وانثالت الياعات من حوله","أحلام عشّاق بلا مأوى",37,"و",2,0],["وإن ثيابَ الناس زُرَّت جميعُها","على عاهةٍ إلاّ ثيابَ المؤازر",38,"ر",1,0],["وانثنى \" كالاطار \" يحتضِنُ الصّورةَ","تُزْهَى ، أو جَدْولٍ في كتاب",39,"ب",1,0],["وانثنى الغصن ولولا أنه","حامل ما لم يطقه ما أنثنى",40,"ن",2,0],["وانُثَنَتْ أَفياءُ نَبْعَتِها","عنْ نباتٍ سالَ كالجمِ",41,"م",1,0],["وانثنى يخطب فيهم خطبة","أبلغ المنطق في أعذب جرس",42,"س",1,0],["وإنَّ ثِيَابَ المُلْكِ في آلِ دَارِم","هُمْ وَرِثوهَا. لا كُلَيْبُ الحَّواهِق",43,"ق",1,0],["وانثنى مِعطفُ القَضيب اختيالاً","لِغِناءِ الحَمامَةِ الوَرقاء",44,"ا",2,0],["وَأَنَّ ثَنِيَّةَ رَأسِ الهِجا","بيني وبينك لا تطلع",45,"ع",1,0],["وانثنى يرمُقُ الخَيالَ ويَشدو","من فنونِ الإنشادِ لحناً فلَحنا",46,"ن",2,0],["وَإِن ثَوَت بينَ ضُلوعي زَفرَةٌ","تَملأُ ما بَينَ الرَجا إِلى الرَجا",47,"ا",1,0],["وَاِنثُر بِمدحِهما اللآلئَ واِنظمِ","مَهما اِستطعتَ القول قُل وترنّم",48,"م",1,0],["وانثُرِ الشوكَ أيّها الأرقُ المرُّ","على مضجعِ الدعيّ الملولِ",49,"ل",1,0],["وانثنى الليلُ يَفْضُلُ الصبح حسناً","والدراري يفضُلْنَ فيه الشموسا",50,"س",2,0],["وانثنت عُجباً فلستَ ترى","عاشقاً إلا ويعجُبها",51,"ب",3,0],["وانثرها دموعا كالالآلي","تكاد بجيده ينظمن عقدا",52,"د",2,0],["وَاِنثَنى من وجهِه مُستَعجِلاً","راغِباً في مَشيةِ المُستَعجل",53,"ل",1,0],["وَاِنثَنَت تَلحس سَنّا","رَتَها مُذ أَكَلَتهُ",54,"ه",1,0],["وَاِنثنى هائِماً عَلى نَفسِهِ الثَك","لى فَلَم يُستَفق وَلم يُستقرّا",55,"ر",2,0],["وَاِنثُريهِ فَالدُرُّ دُرٌّ وَإِن لَم","يَدِّخِره تُجّارُهُ في سُلوكِ",56,"ك",1,0],["وَاِنثُر دموعَك في ثَراه صبابَةً","علَّ البكاءَ يُزيلُ بعضَ جواكا",57,"ك",2,0],["وأنَّ ثانِي ما أضمَرْتَه قَدَحٌ","كأنّه مِن بيَاضِ الصُّبحِ ملتئِمُ",58,"م",1,0],["وأنّ ثالثَ ما عَمَّيْتَه شَبَحٌ","يُمحَى بِتيجانِه الأغساقُ والظُّلَمُ",58,"م",1,0],["وَانْثَنَى تَكْنُفُهُ أَنْوَارُهُ","ثُمَّ مَا سَلَّمَ حَتَّى وَدَّعَا",59,"ع",2,0],["وانثُرنَ منها في الصباحِ على الصَّبا","كتناثُرِ الأعلاقِ من أيدينا",60,"ن",2,0],["وانْثَنَتْ تَثْنِي بِمَا صَنَعَتْ","صِدْقَ تَعْويدٍ وَتَعْويلِ",61,"ل",1,0],["وانْثَنَى مُنْكَسِراً مِنْ وَجْدِهِ","بِكَسِيرِ الطَّرْفِ كَالظَّبْيِ سَنَحْ",62,"ح",1,0],["وَأنّ ثيابَ الزورِ عارٌ وعريةٌ","وَربّ أمورٍ كانَ فقداً وُجودها",63,"د",3,0],["وَاِنثُر مَزاياكَ الحِسانُ لَآلِئاً","مِن جَوهَرٍ يَسبي العُقولَ زَهيدُهُ",64,"د",2,0],["وانثَنَت لم تُسعِد الش","ط وللشطّ ابتهال",65,"ل",1,0],["وانثنت ترقبُ مسراها","بمسحور الجفون",66,"ن",1,0],["وانثرى الزهر والرياحين والجل","سان في كل مجمع ترتضينه",67,"ن",2,0],["وَاِنثَنَت عِندَها اِنثَنَت لي إِماماً","سَدرَةُ المُنتَهى إِلَيها وَرائي",68,"ي",1,0],["وَاِنثَنى في بَيتِ كَعبٍ كَعبَةً","أُمَّها طَوعاً لَهُ آلُ عُصَي",69,"ي",1,0],["وَأَنثني مِن لُطف أَلفاظِهِ","كَأَنَّما أَرشف كَأس المُدام",70,"م",1,0],["وَاِنثَنى قالَت الغُصون","كُلّنا في الهَوى سوى",71,"س",3,0],["وَإِنَّ ثَوبَ الَّذي عاداكُمُ كَفَنٌ","كَما بُيوتُ الَّذي عاصاكُمُ تُرَبُ",72,"ب",1,0],["وَإِن ثَموداً تَدَّعى الماءَ كُلَّهُ","فَقُل لِقُدارٍ وَيلَهُ قَد رَغا السَقبُ",73,"ب",1,0],["وَاِنثَنى وَالزَمانُ يُنشِدُ فيهِ","هكَذا تَخدِمُ المُلوكَ السُعودُ",74,"د",1,0],["وَإِنَّ ثُغوراً في يَدَي غَيرِ عامِلٍ","لِمِصرِكَ أَمسَت غَيرَ باسِمَةِ الثَغرِ",75,"ر",1,0],["وانثَنَينا بالمُعجِزاتِ ومِنها","كَرَمٌ يَترُكُ الزَّمانَ كَرِيما",76,"م",2,0],["وانثَنَت تحبِسُ الخيالَ احبسيهِ","أبداً لستُ نائماً فَيزورا",77,"ر",2,0],["وانثر أدمعي سحراً إذا ما","سمعت سويجع الأثلات غنّى",78,"ن",2,0],["وانثنَتْ في غلائلٍ حاكَها الخِصْ","بُ وكانَتْ بجدبِها أَغلالا",79,"ل",2,0],["وانثنت بالنوى عاصية","نون دال من برحا",80,"ح",2,0],["وانثنى الأسمرُ منها غُصُناً","وجرى الأبيضُ فيها جدولا",81,"ل",2,0],["وانثنَى والمدحُ يلويه كما","لوتِ النكباءُ رُمحاً خطِلا",81,"ل",2,0],["وانْثَنى فابْتَنى من المجدِ داراً","نالَ فيها بعزمِهِ ما رامَهْ",82,"م",2,0],["وأَنَّ ثناءَكَ أَزكى وأَذكى","عَلَى الدهر من طِيبِهِ المستجادِ",83,"د",1,0],["وانثنى ممسكا بنجمين مسرو","راً بما ناله شكورا قنوعا",84,"ع",2,0],["وانثنى الفتح ينتحي من أحادي","ث الهوى ممتعاته وقصاره",85,"ر",2,0],["وانثنى ابن القصَّار طوراً يغني","ه يحذقٍ مرقصاً طنباره",85,"ر",2,0],["وانثنى العود به مصطخباً","بالغريضات بضربٍ محكم",86,"م",1,0],["وانثنى ينشرُ منها عذبا","ويضم الغصن كالملتزمِ",86,"م",1,0],["وأن ثلاثتَه واحدٌ","ويزعُم من ردَّ هذا جهِلْ",87,"ل",1,0],["وانْثَنتْ مٍن حَزَنِ الدَّهر به","غُرَرُ الأيامِ سُوداً كالَّيالي",88,"ل",2,0],["وَاِنثَنَت فَاِنثَنى إِلى الحُبِّ قَلبي","وَتَيَقَّنتُ أَنَّهُ حانَ حَيني",89,"ن",2,0],["وانثر عليه دعاء","مما تلوته زهرا",90,"ر",2,0],["وأنثر راية الدستور فيها","لينظرها عيانا كل طرف",91,"ف",1,0],["وانثر على قصر العقيق عقيق دم","عِ صبابة الوجد الكئيب الأكمد",92,"د",1,0],["وانثر إذن درر الدموع على الثرا","واقرأ تحيات الهيام نزيها",93,"ي",3,0],["واِنثَنى القلبُ خافِقاً إذ تجلّى","مُصْلتاً صارِم الهِلالِ المُنيرِ",94,"ر",1,0],["واِنثنَتْ تَقلِبُ الفَلاةَ عليهمِ","بمَداري قوائمٍ كالدَّبورِ",94,"ر",1,0],["وإنّ ثمار الزّرع يُجنى إذا مضى","على الزّرع أزمانٌ وزالتْ حوائلُ",95,"ل",1,0],["واِنثنى الجسمُ لجُرْدِ ال","خيلِ بالعَدْوِ رضيضا",96,"ض",2,0],["وانثنت أغصاننا من","أمره بالنسمات",97,"ت",1,0],["وانْثَنَوا حين أَفرد الملك عنهم","يندُبُون الأَعْمالَ والأَعْمَارَا",98,"ر",2,0],["وَأَنَّ ثَناياهُ نُجُومٌ لِبَدْرِهِ","وهُنَّ لِعقْدِ الحُسْنِ فِيهِ فَرائِدُ",99,"د",1,0],["وانثر دُرَّ دمعي في ثُغُورٍ","بها عِقدٌ من الدُّرِّ النَّظِيمِ",100,"م",1,1],["وَانثنى بعدَها إليك وَحيّا","ك بِمَدح عَلَيهِ بالجدّ أَقدَم",101,"م",1,0],["وَاِنثَنى بَعضُها لِضَرب أَبيه","وَأَذاه وَربْطه بِالحِبال",102,"ل",1,0],["وإن ثار في البدر المنير رأيته","أحال دجاه البدر دقة فرقد",103,"د",1,0],["وإنَّ ثَانِيّةُ خُمْسٌ لِثَالِثِهِ","فافهَمْ فقد لاَحَ للأفهام خَافِيْهِ",104,"ي",2,0],["وانثنى يختال في أعطافهِ","ثَمِلاً يسبي التقيَّ المؤمنا",105,"ن",2,0],["وَأَنثني تيهاً عَلى أَمثالي","وبِالرياحِ قطّ لا أُبالي",106,"ي",1,0],["وانثنى راجعا بأنجم سعي","وجواري الدجى تجر الذيولا",107,"ل",2,0],["وَانْثَنَى عطْف مَائِسِ الشَّجَرِ","تَحْتَ طَيّ الوِشَاحْ",108,"ح",1,0],["وانثنى ساحبا رداء فخار","والدجى لم يفكك الأوزارا",109,"ر",2,0],["وأنثر الدمع في 