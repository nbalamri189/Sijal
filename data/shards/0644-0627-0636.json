{"poems":[[55,"يا قلب ما أطول هذا الغرام","https://www.aldiwan.net/poem29809.html","السريع"],[55,"من رأى البرق بغوري السند","https://www.aldiwan.net/poem30636.html","الرمل"],[53,"عيني هذا ربيع الدمع فاحتشدا","https://www.aldiwan.net/poem62985.html","البسيط"],[53,"مستعبد هيهات إعتاقه","https://www.aldiwan.net/poem65706.html","السريع"],[53,"ألا إن مدحا غدا حلية","https://www.aldiwan.net/poem66436.html","المتقارب"],[93,"لا تسلني عن السماء فما عندي","https://www.aldiwan.net/poem8720.html","عموديه"],[72,"إقرأ سلامي على من لا أسميه","https://www.aldiwan.net/poem42419.html","البسيط"],[91,"الشمس قد طلعت بوجه اروع","https://www.aldiwan.net/poem44622.html","الكامل"],[87,"هل تيم البان فؤاد الحمام","https://www.aldiwan.net/poem63018.html","السريع"],[92,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[8,"دار حي كانت لهم زمن التو","https://www.aldiwan.net/poem21824.html","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30474","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43667","المجتث"],[108,"زيارة طرابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179604",""],[112,"كما كنت","https://www.poetsgate.com/ViewPoem.aspx?id=8398",""],[128,"ما أظلم الوجود يا عبود","https://www.aldiwan.net/poem23776.html","الرجز"],[139,"رأى الواشي تباريحي","https://www.aldiwan.net/poem49020.html","الهزج"],[182,"هد الجوى ركبي","https://www.aldiwan.net/poem50687.html","المواليا"],[203,"بي الهوى إن كنت لم تعرفي","https://www.aldiwan.net/poem45180.html","السريع"],[241,"تعززت بذي العز","https://www.aldiwan.net/poem18832.html","الهزج"],[245,"قدوم ولكن لا أقول سعيد","https://www.aldiwan.net/poem45771.html","الطويل"],[279,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[461,"أيوما مثل يوم الجزع","https://www.aldiwan.net/poem55890.html","مجزوء الوافر"],[461,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[461,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[461,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[461,"هب من زمانك بعض الجد للعب","https://www.aldiwan.net/poem56302.html","البسيط"],[482,"من بطن أمك للجدث","https://www.aldiwan.net/poem37180.html","مجزوء الكامل"],[554,"ما بال حقف بكثيب اللوى","https://www.aldiwan.net/poem47287.html","السريع"],[561,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[565,"إن كنت بالله في دنياك تعتصم","https://www.aldiwan.net/poem52850.html","البسيط"],[690,"","https://poetry.dctabudhabi.ae/diwan/poem/28816","الرجز"],[1081,"","https://poetry.dctabudhabi.ae/diwan/poem/2521","الكامل"]],"verses":[["لا ضائِعٌ في الدَهرِ مِن ذِلَّةٍ","وَلا خَذولُ الرِجلِ يَومَ الزِحام",0,"م",1,0],["لا ضَحا ظِلُّكَمُ يَوماً وَلا","مَطَلَ الإِقبالُ فيكُم ما وَعَد",1,"د",1,0],["لا ضير ألا تكوني روضة أنفاً","أنيقة النور مِبْهاج الأزاهير",2,"ر",1,0],["لا ضرَّهُ ظلمي ولا نابه","إقراحه قلبي وإقلاقه",3,"ق",2,0],["لأضيعُ من ذهبٍ ضبَّبتْ","عجوزٌ به قُلْحَ أسنانِها",4,"ن",3,0],["لا ضَعيفٌ مُستَعبَدٌ لا قَوِيٌّ","مُستَبِّدٌ بَل كُلُّهُم أَكفاءُ",5,"ا",2,0],["لا ضَيمَ يَخشاهُ قَلبي وَالحَبيبُ بِهِ","فَإِنَّ ساكِنَ ذاكَ البَيتِ يَحميهِ",6,"ي",2,0],["لا ضير ان ابكى الدجى عيني فقد","مسح ابتسامك في النهاية ادمعي",7,"ع",2,0],["لا ضَرَبَ المَقدورُ أَحبابَنا","وَلا أَعادينا بِهَذا الحُسام",8,"م",1,0],["لا ضيرَ كلُّ أخي عُشٍّ مفارقُه","وأيُّ عُشٍّ من البازي بمأمون!",9,"ن",1,0],["لا ضِئالٌ وَلا عَواوِيرُ حَمّا","لُونَ يَومَ الخِطابِ للأَثقالِ",10,"ل",1,0],["لا ضيَّعَ اللَّهُ إِلا مَن يُضِيِّعُهُ","ومَن تَخَلَّقَ فِيه غَيْرَ أَخْلاقِي",11,"ق",2,0],["لا ضَيَّعَ اللَهُ أَجري","فَأَيُّ وَجدٍ وَجَدتُه",12,"ت",2,0],["لاَ ضَيفَ أكرمُ من ضيفٍ يجاوركُمْ","بالدارِ، والأهلِ، والأحبابِ مؤتنِسِ",13,"س",1,0],["لاضاقبي حالي ... توضّيت وأذّنت","وصلّيتلك يارب سمعن وطاعه",14,"ع",2,0],["لآض وهو البلبل الغريد","كم مهمه ضاقت به الجنود",15,"د",1,0],["لأضحى في الهوى صَبًّا","وأمسى هائماً معنا",16,"ن",2,0],["لا ضوءَ في المشكاةْ","والعينُ لا تَكْرى",17,"ر",2,0],["لأضعفتني عينُ تلكَ التي","إن نظرتْ في حجرٍ يضعفِ",18,"ف",1,0],["لَأَضْنَانِي وَأَرْدَانِي","سِنَانُ الْغَمِّ بِالرِّكْزِ",19,"ز",1,0],["لأضرابه بيتٌ من اللؤمِ عامرٌ","ومُلكٌ وإن طالَ المدى سيبيدُ",20,"د",1,0],["لا ضَيْرَ بِهِمْ وتَمَضُّره","يُنمَى صُعُداً وتَمَعْددُهُ",21,"د",2,0],["لأضحت في بني عبد ال","رحيم مودتي رَحِما",22,"م",2,0],["لا ضاع من يعتمد الحظُّ به","من قسمةٍ على عميد الرؤسا",23,"س",2,0],["لا ضامه الخوفُ ولا","أطغاه في الأمن البَطَرْ",24,"ر",1,0],["لا ضاع ما بيني وبي","نكِ عهدُها وذِمارُها",25,"ر",3,0],["لا ضاع بل لم يضعْ يومَ أنتصرتَ به","وأنت كالوِرْدِ والأعداءُ كالقَرَبِ",26,"ب",1,0],["لا ضير ويحك أن تقل","من بطن أمك للجدث",27,"ث",1,0],["لا ضامك الدّهرُ ولا زلتَ مِن","نعيمه في منزلٍ آهلِ",28,"ل",1,0],["لا ضحى علمهم من بح","ر علمي قطرة الطل",29,"ل",1,0],["لا ضِيقَ في الدَّهرِ إلا بَعدَهُ فَرَجٌ","ولا شبيبةَ إلاّ بَعدَها هَرَمُ",30,"م",1,0],["لَأَضْرِبَنْ بِذي القَفا قَفا رَجُلْ","وَأَصْبِرِ النَّفْسَ اِبتِغاءَ ما جَمُلْ",31,"ل",1,1],["لا ضَيرَ قَد حَكَّت بِمُرَّةَ بَركَها","وَتَرَكنَ أَشجَعَ مِثلَ خُشبِ الأَثأَبِ",32,"ب",1,0]]}