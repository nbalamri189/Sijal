{"poems":[[55,"يا قلب ما أطول هذا الغرام","https://www.aldiwan.net/poem29809.html","السريع"],[55,"من رأى البرق بغوري السند","https://www.aldiwan.net/poem30636.html","الرمل"],[53,"عيني هذا ربيع الدمع فاحتشدا","https://www.aldiwan.net/poem62985.html","البسيط"],[53,"مستعبد هيهات إعتاقه","https://www.aldiwan.net/poem65706.html","السريع"],[53,"ألا إن مدحا غدا حلية","https://www.aldiwan.net/poem66436.html","المتقارب"],[93,"لا تسلني عن السماء فما عندي","https://www.aldiwan.net/poem8720.html","عموديه"],[72,"إقرأ سلامي على من لا أسميه","https://www.aldiwan.net/poem42419.html","البسيط"],[91,"الشمس قد طلعت بوجه اروع","https://www.aldiwan.net/poem44622.html","الكامل"],[87,"هل تيم البان فؤاد الحمام","https://www.aldiwan.net/poem63018.html","السريع"],[92,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[8,"دار حي كانت لهم زمن التو","https://www.aldiwan.net/poem21824.html","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30474","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43667","المجتث"],[108,"زيارة طرابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179604",""],[112,"كما كنت","https://www.poetsgate.com/ViewPoem.aspx?id=8398",""],[128,"ما أظلم الوجود يا عبود","https://www.aldiwan.net/poem23776.html","الرجز"],[139,"رأى الواشي تباريحي","https://www.aldiwan.net/poem49020.html","الهزج"],[182,"هد الجوى ركبي","https://www.aldiwan.net/poem50687.html","المواليا"],[203,"بي الهوى إن كنت لم تعرفي","https://www.aldiwan.net/poem45180.html","السريع"],[242,"تعززت بذي العز","https://www.aldiwan.net/poem18832.html","الهزج"],[246,"قدوم ولكن لا أقول سعيد","https://www.aldiwan.net/poem45771.html","الطويل"],[280,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[463,"أيوما مثل يوم الجزع","https://www.aldiwan.net/poem55890.html","مجزوء الوافر"],[463,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[463,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[463,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[463,"هب من زمانك بعض الجد للعب","https://www.aldiwan.net/poem56302.html","البسيط"],[484,"من بطن أمك للجدث","https://www.aldiwan.net/poem37180.html","مجزوء الكامل"],[556,"ما بال حقف بكثيب اللوى","https://www.aldiwan.net/poem47287.html","السريع"],[563,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[567,"إن كنت بالله في دنياك تعتصم","https://www.aldiwan.net/poem52850.html","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38343","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119925","الكامل"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69217","الطويل"],[1322,"","https://poetry.dctabudhabi.ae/diwan/poem/28816","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64586","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108790","المجتث"],[1829,"","https://poetry.dctabudhabi.ae/diwan/poem/130585","الكامل"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102727","الكامل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76794","الكامل"],[2322,"","https://poetry.dctabudhabi.ae/diwan/poem/205124","الرمل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106852","الطويل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126227","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93874","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94300","الرجز"],[2808,"","https://poetry.dctabudhabi.ae/diwan/poem/105540","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100288","الكامل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112597","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68001","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74056","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216464",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205712",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59499","الرجز"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2521","الكامل"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103555","الكامل"],[4077,"","https://poetry.dctabudhabi.ae/diwan/poem/198909",""],[4717,"رفقاً خديجة","https://www.poetsgate.com/ViewPoem.aspx?id=199578",""],[4797,"لا ضاقت الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=29429",""],[4829,"ولاد المضا","https://www.poetsgate.com/ViewPoem.aspx?id=36743",""],[4852,"هِمْ .. كيف شئتَ","https://www.poetsgate.com/ViewPoem.aspx?id=215039",""],[4859,"غفوة","https://www.poetsgate.com/ViewPoem.aspx?id=187659",""],[4869,"رساله إلى لوجين .. شطحه","https://www.poetsgate.com/ViewPoem.aspx?id=151714",""],[4916,"زيزوم","https://www.poetsgate.com/ViewPoem.aspx?id=136924",""],[4927,"اِنتظار","https://www.poetsgate.com/ViewPoem.aspx?id=29834",""],[4929,"القدس بوابة العبور إلى المجد","https://www.poetsgate.com/ViewPoem.aspx?id=199179",""],[4958,"على قدر التعلق","https://www.poetsgate.com/ViewPoem.aspx?id=59099",""],[5046,"كأس العالم","https://www.poetsgate.com/ViewPoem.aspx?id=198446",""],[3271,"لم يطب للنبوغ فيك مقام","https://www.poetsgate.com/ViewPoem.aspx?id=103537",""],[5136,"دعه يبكي فمن بكى يستريح","https://www.poetsgate.com/ViewPoem.aspx?id=121548",""],[5145,"سفرت لنا عن سنة البدر","https://www.poetsgate.com/ViewPoem.aspx?id=108134",""],[5362,"خطرت تخف العدو خوف رقيبها","https://www.poetsgate.com/ViewPoem.aspx?id=170379",""],[5374,"تراتيل مؤجلة","https://www.poetsgate.com/ViewPoem.aspx?id=199712",""],[5431,"للقامة السوريةسلطان الأطرش","https://www.poetsgate.com/ViewPoem.aspx?id=183129",""],[5431,"فلسفة الحياة ....","https://www.poetsgate.com/ViewPoem.aspx?id=199987",""],[5431,"قد خُلقنا ملائكا في الطراز","https://www.poetsgate.com/ViewPoem.aspx?id=200154",""],[5573,"ماجور باذن الله يا طيب الفال","https://www.poetsgate.com/ViewPoem.aspx?id=200105",""],[5652,"أجر التصدق ؟","https://www.poetsgate.com/ViewPoem.aspx?id=177801",""],[5764,"قتلتني","https://www.poetsgate.com/ViewPoem.aspx?id=137059",""],[5851,"قلب بحجم الرؤى","https://www.poetsgate.com/ViewPoem.aspx?id=175288",""],[5939,"منذ التقى يوليو ببرد يناير","https://www.poetsgate.com/ViewPoem.aspx?id=179997",""],[5956,"الديمقراطية السوداء","https://www.poetsgate.com/ViewPoem.aspx?id=192214",""],[5964,"ما شأن دارك يا ليلى نناجيها","https://www.poetsgate.com/ViewPoem.aspx?id=181304",""],[5969,"لا تفتحي الباب الذي أوصدته","https://www.poetsgate.com/ViewPoem.aspx?id=198679",""],[6031,"أَتَعْجَبُ من أتَانِكَ حِينَ أَنَّتْ","https://www.poetsgate.com/ViewPoem.aspx?id=46351",""],[6078,"سلافة عشق","https://www.poetsgate.com/ViewPoem.aspx?id=202777",""],[6082,"هامور العشق","https://www.poetsgate.com/ViewPoem.aspx?id=58893",""],[6093,"يَا هَاجِريْ ! عينٌ لبَعْضيَ أنكرتْ ( الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=176195",""],[6097,"كوني \"بُثينَة\"!","https://www.poetsgate.com/ViewPoem.aspx?id=197429",""],[6127,"كنز اليتامى","https://www.poetsgate.com/ViewPoem.aspx?id=190114",""]],"verses":[["لا ضائِعٌ في الدَهرِ مِن ذِلَّةٍ","وَلا خَذولُ الرِجلِ يَومَ الزِحام",0,"م",1,0],["لا ضَحا ظِلُّكَمُ يَوماً وَلا","مَطَلَ الإِقبالُ فيكُم ما وَعَد",1,"د",1,0],["لا ضير ألا تكوني روضة أنفاً","أنيقة النور مِبْهاج الأزاهير",2,"ر",1,0],["لا ضرَّهُ ظلمي ولا نابه","إقراحه قلبي وإقلاقه",3,"ق",2,0],["لأضيعُ من ذهبٍ ضبَّبتْ","عجوزٌ به قُلْحَ أسنانِها",4,"ن",3,0],["لا ضَعيفٌ مُستَعبَدٌ لا قَوِيٌّ","مُستَبِّدٌ بَل كُلُّهُم أَكفاءُ",5,"ا",2,0],["لا ضَيمَ يَخشاهُ قَلبي وَالحَبيبُ بِهِ","فَإِنَّ ساكِنَ ذاكَ البَيتِ يَحميهِ",6,"ي",2,0],["لا ضير ان ابكى الدجى عيني فقد","مسح ابتسامك في النهاية ادمعي",7,"ع",2,0],["لا ضَرَبَ المَقدورُ أَحبابَنا","وَلا أَعادينا بِهَذا الحُسام",8,"م",1,0],["لا ضيرَ كلُّ أخي عُشٍّ مفارقُه","وأيُّ عُشٍّ من البازي بمأمون!",9,"ن",1,0],["لا ضِئالٌ وَلا عَواوِيرُ حَمّا","لُونَ يَومَ الخِطابِ للأَثقالِ",10,"ل",1,0],["لا ضيَّعَ اللَّهُ إِلا مَن يُضِيِّعُهُ","ومَن تَخَلَّقَ فِيه غَيْرَ أَخْلاقِي",11,"ق",2,0],["لا ضَيَّعَ اللَهُ أَجري","فَأَيُّ وَجدٍ وَجَدتُه",12,"ت",2,0],["لاَ ضَيفَ أكرمُ من ضيفٍ يجاوركُمْ","بالدارِ، والأهلِ، والأحبابِ مؤتنِسِ",13,"س",1,0],["لاضاقبي حالي ... توضّيت وأذّنت","وصلّيتلك يارب سمعن وطاعه",14,"ع",2,0],["لآض وهو البلبل الغريد","كم مهمه ضاقت به الجنود",15,"د",1,0],["لأضحى في الهوى صَبًّا","وأمسى هائماً معنا",16,"ن",2,0],["لا ضوءَ في المشكاةْ","والعينُ لا تَكْرى",17,"ر",2,0],["لأضعفتني عينُ تلكَ التي","إن نظرتْ في حجرٍ يضعفِ",18,"ف",1,0],["لَأَضْنَانِي وَأَرْدَانِي","سِنَانُ الْغَمِّ بِالرِّكْزِ",19,"ز",1,0],["لأضرابه بيتٌ من اللؤمِ عامرٌ","ومُلكٌ وإن طالَ المدى سيبيدُ",20,"د",1,0],["لا ضَيْرَ بِهِمْ وتَمَضُّره","يُنمَى صُعُداً وتَمَعْددُهُ",21,"د",2,0],["لأضحت في بني عبد ال","رحيم مودتي رَحِما",22,"م",2,0],["لا ضاع من يعتمد الحظُّ به","من قسمةٍ على عميد الرؤسا",23,"س",2,0],["لا ضامه الخوفُ ولا","أطغاه في الأمن البَطَرْ",24,"ر",1,0],["لا ضاع ما بيني وبي","نكِ عهدُها وذِمارُها",25,"ر",3,0],["لا ضاع بل لم يضعْ يومَ أنتصرتَ به","وأنت كالوِرْدِ والأعداءُ كالقَرَبِ",26,"ب",1,0],["لا ضير ويحك أن تقل","من بطن أمك للجدث",27,"ث",1,0],["لا ضامك الدّهرُ ولا زلتَ مِن","نعيمه في منزلٍ آهلِ",28,"ل",1,0],["لا ضحى علمهم من بح","ر علمي قطرة الطل",29,"ل",1,0],["لا ضِيقَ في الدَّهرِ إلا بَعدَهُ فَرَجٌ","ولا شبيبةَ إلاّ بَعدَها هَرَمُ",30,"م",1,0],["لا ضَيَّع اللَّه سَعياً قَد سَعاهُ وَلا","أَراهُ في الدّهرِ مِن بُؤسٍ وَمِن نِقَمِ",31,"م",1,0],["لا ضير مع وجدان راحته","لو أن صوب الغيث مفتقدُ",32,"د",1,0],["لأُضعِف حُزني يا بُنيّ وَأَوشكت","عَليّ البَواكي بالرنين تَقوم",33,"م",1,0],["لَأَضْرِبَنْ بِذي القَفا قَفا رَجُلْ","وَأَصْبِرِ النَّفْسَ اِبتِغاءَ ما جَمُلْ",34,"ل",1,1],["لا ضد لا أنداد لا مظاهر","بسر لا إله إلا اللّه",35,"ه",1,0],["لا ضيع اللَه بدراً","أضاع في الحب نسكي",36,"ك",2,0],["لأضلُ من جلب القوافي صعبةً","حتى أذلَّ متونها إذلالا",37,"ل",2,0],["لا ضيمَ يأتي والكرامُ وسائلي","لا تسمعُ الأحبابُ وشى عواذلِ",38,"ل",1,0],["لا ضادَ في لفظٍ به شينٌ سوى","ما فيه راءٌ بعد شينٍ تُرسمُ",39,"م",1,0],["لاضطرام البرق قلبي يضطرم","ولمسراه جفوني لم تنم",40,"م",1,1],["لأضجعتُ جنبيَّ الترابَ مطوحاً","بعمري إن العمر كثرٌ متاعبه",41,"ب",2,0],["لا ضعيفٌ ولا قوِىٌّ وحاشا","أن ألاقِى سِوَى التَقَدُّسِ حالاَ",42,"ل",2,0],["لا ضير في سقم يمحي بعافية","تدوم طول المدى واللَه شافيه",43,"ف",3,0],["لا ضير في ضيق الصدور بعده","والقبر فيه فسحة اتساع",44,"ع",1,0],["لا ضير من موتي أسى من بعده","لكن عيشي والحياة عجيب",45,"ب",1,0],["لا ضير لو قد راح ينقض مبرما","مناع ما طلب الهوى أخّاذ",46,"ذ",1,0],["لا ضاربٌ منكم ولا مضروب","أنتم جميعا معشر مغلوب",47,"ب",1,1],["لا ضيرَ إِنْ شَحَّ السحابُ بمائه","فيداه تُمطر عَسْجداً سَحّاحا",48,"ح",2,0],["لا ضاقَ في الأَرض ذرعا كلّ ذي أَمَل","يَرى له في مَجال السعي متّسعا",49,"ع",2,0],["لا ضير بالماضي إذا","دار الزمان فطاب عقبى",50,"ب",2,0],["لا ضير عندي أن تعي","ش إذا انجلى ليل الوساوس",51,"س",1,0],["لأضربنَّ البطلَ المحامي","في حَوْمة الهيجاءِ بالحُسامِ",52,"م",1,0],["لا ضَيرَ قَد حَكَّت بِمُرَّةَ بَركَها","وَتَرَكنَ أَشجَعَ مِثلَ خُشبِ الأَثأَبِ",53,"ب",1,0],["لا ضعضعت أيدي الخطوب لكم","ركنا ولا راعتكم الغير",54,"ر",1,0],["لا ضرب أقوال بأق","وال ضعيفات مناكر",55,"ر",1,0],["لَا ضَلَّكِ الْحُسنُ القَسِيمُ وَلَا خَبَا","مَا حُزْتِهِ لَا عَنْكِ يَوْمَاً يُصْرَفُ",56,"ف",1,0],["لا ضاقت الدنيا عليك وتشاويت ..","خلق الله اللي فالرخا كان واجد",57,"د",1,1],["لاضرب بكفّ(ن) لاصفق كالبرثن","ليث(ن)خبط مل كفْخته مرمومي",58,"م",2,0],["لاضاف ولا ضيّف ونار (أ)وجاره","ماشبّت إلاّ بغايب آ....للحومي",58,"م",2,0],["لا ضلعُكَ المَحنِيُّ يفردُهُ الردى","لو بعد قرنٍ .. أحتويكَ بمفردي",59,"د",2,0],["لأضمَّ روحكِ ثم ألثم خافقاً","أبصرتُ بعد رحيلِه أوجاعي",60,"ي",1,0],["لآضيّقة لبسٍ .. ولآ طلّعة عين","التربيه ماتروح فيهآ خسآره",61,"ر",2,0],["لا ضاق بي ..صدري ..تعلّى بي ..وشام","وصدري ..عن الضيقات .. كل ماله.. يشوم !",62,"م",1,0],["لأَضُمَّكِ ضَمَّةَ مُشْتَاْقٍ","وَيُمَتَّعَ بِالْحُسْنِ النَّظَرُ",63,"ر",1,0],["لا ضيرَ أن تبكِي تآمُر إخوةٍ","إذْ هُمْ بظهرِكَ للخصومِ حِرَابُ",64,"ب",1,0],["لا ضوء فيه ولا ظلا","ل ولا هناك ولا هنا",65,"ن",2,0],["لا ضير أني لم أكن توّاقةً","يوما لنصرٍ من أشاوس يعرُب",66,"ب",1,0],["لا ضجيجٌ ولا اصطخابٌ ولكنْ","هدأةُ الرّوح قد جلاها المنامُ",67,"م",1,0],["لا ضروع الظرا أو لا قطران خا","مرته السرا أو لا مريح",68,"ح",1,0],["لأضاءت الدنيا لسكانها","والليل في باكورة العمر",69,"ر",1,0],["لا ضي