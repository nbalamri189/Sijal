{"poems":[[53,"يا قلب ما أطول هذا الغرام","https://www.aldiwan.net/poem29809.html","السريع"],[53,"من رأى البرق بغوري السند","https://www.aldiwan.net/poem30636.html","الرمل"],[51,"عيني هذا ربيع الدمع فاحتشدا","https://www.aldiwan.net/poem62985.html","البسيط"],[51,"مستعبد هيهات إعتاقه","https://www.aldiwan.net/poem65706.html","السريع"],[51,"ألا إن مدحا غدا حلية","https://www.aldiwan.net/poem66436.html","المتقارب"],[91,"لا تسلني عن السماء فما عندي","https://www.aldiwan.net/poem8720.html","عموديه"],[70,"إقرأ سلامي على من لا أسميه","https://www.aldiwan.net/poem42419.html","البسيط"],[89,"الشمس قد طلعت بوجه اروع","https://www.aldiwan.net/poem44622.html","الكامل"],[85,"هل تيم البان فؤاد الحمام","https://www.aldiwan.net/poem63018.html","السريع"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[8,"دار حي كانت لهم زمن التو","https://www.aldiwan.net/poem21824.html","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30474","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43667","المجتث"],[106,"زيارة طرابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179604",""]],"verses":[["لا ضائِعٌ في الدَهرِ مِن ذِلَّةٍ","وَلا خَذولُ الرِجلِ يَومَ الزِحام",0,"م",1,0],["لا ضَحا ظِلُّكَمُ يَوماً وَلا","مَطَلَ الإِقبالُ فيكُم ما وَعَد",1,"د",1,0],["لا ضير ألا تكوني روضة أنفاً","أنيقة النور مِبْهاج الأزاهير",2,"ر",1,0],["لا ضرَّهُ ظلمي ولا نابه","إقراحه قلبي وإقلاقه",3,"ق",2,0],["لأضيعُ من ذهبٍ ضبَّبتْ","عجوزٌ به قُلْحَ أسنانِها",4,"ن",3,0],["لا ضَعيفٌ مُستَعبَدٌ لا قَوِيٌّ","مُستَبِّدٌ بَل كُلُّهُم أَكفاءُ",5,"ا",2,0],["لا ضَيمَ يَخشاهُ قَلبي وَالحَبيبُ بِهِ","فَإِنَّ ساكِنَ ذاكَ البَيتِ يَحميهِ",6,"ي",2,0],["لا ضير ان ابكى الدجى عيني فقد","مسح ابتسامك في النهاية ادمعي",7,"ع",2,0],["لا ضَرَبَ المَقدورُ أَحبابَنا","وَلا أَعادينا بِهَذا الحُسام",8,"م",1,0],["لا ضيرَ كلُّ أخي عُشٍّ مفارقُه","وأيُّ عُشٍّ من البازي بمأمون!",9,"ن",1,0],["لا ضِئالٌ وَلا عَواوِيرُ حَمّا","لُونَ يَومَ الخِطابِ للأَثقالِ",10,"ل",1,0],["لا ضيَّعَ اللَّهُ إِلا مَن يُضِيِّعُهُ","ومَن تَخَلَّقَ فِيه غَيْرَ أَخْلاقِي",11,"ي",1,0],["لا ضَيَّعَ اللَهُ أَجري","فَأَيُّ وَجدٍ وَجَدتُه",12,"ت",2,0],["لاَ ضَيفَ أكرمُ من ضيفٍ يجاوركُمْ","بالدارِ، والأهلِ، والأحبابِ مؤتنِسِ",13,"س",1,0]]}