{"poems":[[53,"يا قلب ما أطول هذا الغرام","https://www.aldiwan.net/poem29809.html","السريع"],[53,"من رأى البرق بغوري السند","https://www.aldiwan.net/poem30636.html","الرمل"],[51,"عيني هذا ربيع الدمع فاحتشدا","https://www.aldiwan.net/poem62985.html","البسيط"],[51,"مستعبد هيهات إعتاقه","https://www.aldiwan.net/poem65706.html","السريع"],[51,"ألا إن مدحا غدا حلية","https://www.aldiwan.net/poem66436.html","المتقارب"],[91,"لا تسلني عن السماء فما عندي","https://www.aldiwan.net/poem8720.html","عموديه"],[70,"إقرأ سلامي على من لا أسميه","https://www.aldiwan.net/poem42419.html","البسيط"],[89,"الشمس قد طلعت بوجه اروع","https://www.aldiwan.net/poem44622.html","الكامل"],[85,"هل تيم البان فؤاد الحمام","https://www.aldiwan.net/poem63018.html","السريع"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[8,"دار حي كانت لهم زمن التو","https://www.aldiwan.net/poem21824.html","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30474","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43667","المجتث"],[106,"زيارة طرابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179604",""],[122,"ما أظلم الوجود يا عبود","https://www.aldiwan.net/poem23776.html","الرجز"],[133,"رأى الواشي تباريحي","https://www.aldiwan.net/poem49020.html","الهزج"],[176,"هد الجوى ركبي","https://www.aldiwan.net/poem50687.html","المواليا"],[197,"بي الهوى إن كنت لم تعرفي","https://www.aldiwan.net/poem45180.html","السريع"],[235,"تعززت بذي العز","https://www.aldiwan.net/poem18832.html","الهزج"],[239,"قدوم ولكن لا أقول سعيد","https://www.aldiwan.net/poem45771.html","الطويل"],[273,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[456,"أيوما مثل يوم الجزع","https://www.aldiwan.net/poem55890.html","مجزوء الوافر"],[456,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[456,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[456,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[456,"هب من زمانك بعض الجد للعب","https://www.aldiwan.net/poem56302.html","البسيط"],[477,"من بطن أمك للجدث","https://www.aldiwan.net/poem37180.html","مجزوء الكامل"],[549,"ما بال حقف بكثيب اللوى","https://www.aldiwan.net/poem47287.html","السريع"],[556,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[560,"إن كنت بالله في دنياك تعتصم","https://www.aldiwan.net/poem52850.html","البسيط"]],"verses":[["لا ضائِعٌ في الدَهرِ مِن ذِلَّةٍ","وَلا خَذولُ الرِجلِ يَومَ الزِحام",0,"م",1,0],["لا ضَحا ظِلُّكَمُ يَوماً وَلا","مَطَلَ الإِقبالُ فيكُم ما وَعَد",1,"د",1,0],["لا ضير ألا تكوني روضة أنفاً","أنيقة النور مِبْهاج الأزاهير",2,"ر",1,0],["لا ضرَّهُ ظلمي ولا نابه","إقراحه قلبي وإقلاقه",3,"ق",2,0],["لأضيعُ من ذهبٍ ضبَّبتْ","عجوزٌ به قُلْحَ أسنانِها",4,"ن",3,0],["لا ضَعيفٌ مُستَعبَدٌ لا قَوِيٌّ","مُستَبِّدٌ بَل كُلُّهُم أَكفاءُ",5,"ا",2,0],["لا ضَيمَ يَخشاهُ قَلبي وَالحَبيبُ بِهِ","فَإِنَّ ساكِنَ ذاكَ البَيتِ يَحميهِ",6,"ي",2,0],["لا ضير ان ابكى الدجى عيني فقد","مسح ابتسامك في النهاية ادمعي",7,"ع",2,0],["لا ضَرَبَ المَقدورُ أَحبابَنا","وَلا أَعادينا بِهَذا الحُسام",8,"م",1,0],["لا ضيرَ كلُّ أخي عُشٍّ مفارقُه","وأيُّ عُشٍّ من البازي بمأمون!",9,"ن",1,0],["لا ضِئالٌ وَلا عَواوِيرُ حَمّا","لُونَ يَومَ الخِطابِ للأَثقالِ",10,"ل",1,0],["لا ضيَّعَ اللَّهُ إِلا مَن يُضِيِّعُهُ","ومَن تَخَلَّقَ فِيه غَيْرَ أَخْلاقِي",11,"ي",1,0],["لا ضَيَّعَ اللَهُ أَجري","فَأَيُّ وَجدٍ وَجَدتُه",12,"ت",2,0],["لاَ ضَيفَ أكرمُ من ضيفٍ يجاوركُمْ","بالدارِ، والأهلِ، والأحبابِ مؤتنِسِ",13,"س",1,0],["لآض وهو البلبل الغريد","كم مهمه ضاقت به الجنود",14,"د",1,0],["لأضحى في الهوى صَبًّا","وأمسى هائماً معنا",15,"ن",2,0],["لا ضوءَ في المشكاةْ","والعينُ لا تَكْرى",16,"ر",2,0],["لأضعفتني عينُ تلكَ التي","إن نظرتْ في حجرٍ يضعفِ",17,"ف",1,0],["لَأَضْنَانِي وَأَرْدَانِي","سِنَانُ الْغَمِّ بِالرِّكْزِ",18,"ز",1,0],["لأضرابه بيتٌ من اللؤمِ عامرٌ","ومُلكٌ وإن طالَ المدى سيبيدُ",19,"د",1,0],["لا ضَيْرَ بِهِمْ وتَمَضُّره","يُنمَى صُعُداً وتَمَعْددُهُ",20,"د",2,0],["لأضحت في بني عبد ال","رحيم مودتي رَحِما",21,"م",2,0],["لا ضاع من يعتمد الحظُّ به","من قسمةٍ على عميد الرؤسا",22,"س",2,0],["لا ضامه الخوفُ ولا","أطغاه في الأمن البَطَرْ",23,"ر",1,0],["لا ضاع ما بيني وبي","نكِ عهدُها وذِمارُها",24,"ر",3,0],["لا ضاع بل لم يضعْ يومَ أنتصرتَ به","وأنت كالوِرْدِ والأعداءُ كالقَرَبِ",25,"ب",1,0],["لا ضير ويحك أن تقل","من بطن أمك للجدث",26,"ث",1,0],["لا ضامك الدّهرُ ولا زلتَ مِن","نعيمه في منزلٍ آهلِ",27,"ل",1,0],["لا ضحى علمهم من بح","ر علمي قطرة الطل",28,"ل",1,0],["لا ضِيقَ في الدَّهرِ إلا بَعدَهُ فَرَجٌ","ولا شبيبةَ إلاّ بَعدَها هَرَمُ",29,"م",1,0]]}