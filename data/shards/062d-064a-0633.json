{"poems":[[95,"هكذا هكذا نبوغ الرجال","https://www.aldiwan.net/poem11470.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[466,"حي سعد الدين جما مجده","https://www.aldiwan.net/poem15919.html","الرمل"],[1742,"","https://poetry.dctabudhabi.ae/diwan/poem/127850","السريع"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84928","الطويل"],[5732,"ما طاع عذاله","https://www.poetsgate.com/ViewPoem.aspx?id=177911",""]],"verses":[["حَيِّ سَمْعَانَ فَهْوَ أَوَّلُ مَنْ يُذْكَرُ","بِالخَيْرِ فِي بَنَاةِ المَعَالِي",0,"ل",2,0],["حيِّ سماءَ الفرقدينِ وقدِّسي","من تربِكِ الغالي أعزَّ مكانِ",1,"ن",1,0],["حَيِّ سعد الدين جَمّاً مجْدُه","صارِمَ العَزْمةِ ما فيه فَشَلْ",2,"ل",1,1],["حيّ سعيداً جوهرٌ ثابتٌ","وحبُّهُ لي عرضٌ زائلٌ",3,"ل",1,1],["حَيسب نَسيب أَكمل الناس سيرة","إِلَيهِ أَبو الحجاج جد وَمحتد",4,"د",1,0],["حي سلب عقلي وانا فيه ملزوم","موالفه ما والف الجسم للخام",5,"م",1,0]]}