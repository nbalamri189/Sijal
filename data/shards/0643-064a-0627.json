s://www.poetsgate.com/ViewPoem.aspx?id=188165",""],[5121,"إِنْتِعَاش","https://www.poetsgate.com/ViewPoem.aspx?id=52925",""],[5187,"من وحي الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=29701",""],[5277,"ثورةُ الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=198498",""],[5277,"بيتُ الضاد..","https://www.poetsgate.com/ViewPoem.aspx?id=201154",""],[5302,"خوفي بأن تنأى","https://www.poetsgate.com/ViewPoem.aspx?id=204917",""],[307,"عاشق الكعبة","https://www.poetsgate.com/ViewPoem.aspx?id=213651",""],[5351,"تراجيديا","https://www.poetsgate.com/ViewPoem.aspx?id=202052",""],[5376,"كي أعزفَ لحناً للعوْدةْ","https://www.poetsgate.com/ViewPoem.aspx?id=197471",""],[5410,"أمل","https://www.poetsgate.com/ViewPoem.aspx?id=142234",""],[5431,"كي لا تُداس وتُكسرا","https://www.poetsgate.com/ViewPoem.aspx?id=196669",""],[5431,"أصابعه...","https://www.poetsgate.com/ViewPoem.aspx?id=198736",""],[5431,"ياعراق....","https://www.poetsgate.com/ViewPoem.aspx?id=207993",""],[5431,"حسبي بأني وحسبك...","https://www.poetsgate.com/ViewPoem.aspx?id=208733",""],[5459,"همسة صارخة ..","https://www.poetsgate.com/ViewPoem.aspx?id=192854",""],[5512,"رثاء حبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=204150",""],[5652,"انا غازي غزيتك ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=176983",""],[5691,"مأمن الله","https://www.poetsgate.com/ViewPoem.aspx?id=206667",""],[5776,"البُردةُ اليمانيةُ الثالثة","https://www.poetsgate.com/ViewPoem.aspx?id=199545",""],[5897,"صبراً .. دمّاج","https://www.poetsgate.com/ViewPoem.aspx?id=156532",""],[5906,"أوتار حائرة","https://www.poetsgate.com/ViewPoem.aspx?id=188311",""],[5956,"انفتح يا سجن","https://www.poetsgate.com/ViewPoem.aspx?id=192340",""],[5966,"بردة المجد","https://www.poetsgate.com/ViewPoem.aspx?id=158309",""],[5969,"مِنْ لَظى التعياءِ شِعري","https://www.poetsgate.com/ViewPoem.aspx?id=199332",""],[6075,"عرفتك عشفا","https://www.poetsgate.com/ViewPoem.aspx?id=193315",""],[6102,"زيشان","https://www.poetsgate.com/ViewPoem.aspx?id=184170",""],[6275,"سنوات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83611&r=&rc=3",""],[2220,"كبرتُ بملكِ الملكِ إذ كانَ منْ ملكي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11624&r=&rc=498",""]],"verses":[["كيانعِ النَّخْلِ يُبْدي للعيون ضُحىً","طَلْعاً نَضيداً ويُخفْي غَضَّ جُمَّارِ",0,"ر",1,0],["كَي أَنعَمَ بِالكَلامِ مِن غَيرِ وِصالِ","ناجى بِالكَلامِ مِن بَعدِ السَلامِ",1,"م",1,0],["كَيَّالُ خَيْرُ بَقِيَّةٍ","مِمَّنْ بَنَى فِيهِمْ وَشَادْ",2,"د",1,0],["(كي أنمّي إمّسيتي أشتريها)","أعجب العابرين ، أرضى (خليلا)",3,"ل",2,0],["كي أسميّك شريفا أو أرى","فيك مشروع شريف محتمل",4,"ل",1,0],["كَي أَرى الكَأسَ تُربِنا","دُرَراً مِمّا تُرينا",5,"ن",2,0],["كي أربح المولى المسيح بفاقتي","إذ كان حبي للإله بلا مِرا",6,"ر",2,0],["كي أحتوي مُرّي وأريي أغتذي","بل أستقي خمري ولَبْني البائي",7,"ي",1,0],["كي ألاقيهِ به في","وقتِ أهوالِ القِيامَهْ",8,"م",2,0],["كَي أُرى في الشآمِ شَيخاً خَليعاً","في قَميصٍ مِنَ العِراقِ جَديدِ",9,"د",1,0],["كيا بس العود من يحنيه ملتزماً","قضى على كسره هيهات من عائدة",10,"ه",1,0],["كيّاد أضداد مخاصمُهُ","قبل النضال يميته الذعر",11,"ر",1,0],["كَي أحَلِّيهَا بِأحلَى ذِكرِكُمْ","وَأحَاشِي زَيْنَهَا عَنْ عَطَلِ",12,"ل",1,0],["كَي أُداوي القَلبَ مِن بَرحِ الأَسى","إِنَّ صَفوَ الدَهرِ يَوماً مِنهُ رِبحُ",13,"ح",1,0],["كياني كيانُ الحقِِ إذ كنتُ ذا حجى","وفهمٍ وإني ما برحتُ من الملك",14,"ك",1,0],["كي أرى بعضاً من الحُسْنِ الذي","دُونَه الأفكارُ في عجزٍ وعِيّ",15,"ي",1,0],["كي افتديك من المنون لعلها","ترضى واني لي فديتك بالرضا",16,"ض",2,0],["كياسته تَسمو عَل كل حاكِم","وَهَل يَستَوي عاصي الرجال وَناسك",17,"ك",1,0],["كَي أنال الفَخر وَالمَجد الَّذي","فَوقَ أكتاف المَعالي صعدا",18,"د",2,0],["كي أَفزْ منه ببِشْرٍ","يُذهب الحزن ذَهابا",19,"ب",2,0],["كي أود عن سمعه العتابا","واشتكى الاشجان والا وصابا",20,"ب",2,0],["كَي أَبرأَ مِن حَديث سوءٍ فاشِ","هجرانَك آثرتُ بِلا اِستيحاشِ",21,"ش",1,0],["كي ارتقي أوج الكمال والتقي","بجمال حالي من لشأني شانوا",22,"ن",3,0],["كي ألثمَ التُرب بعينٍ أقسمت","بغير ذاك التُرب لا تكتحل",23,"ل",1,0],["(كَيْ أسْتَريحَ وتَنْطفي)","الأشواقُ منْ بَعْدِ احْتِدام",24,"م",1,0],["كي أُبصِرَ الخَطبَ.. كُلِّي كان في بَصَرِي","كي أسمَعَ الصَّوتَ.. كُلِّي كان آذانا",25,"ن",2,0],["كي أصوغَ الكلامَ عقداً ثميناً","مُشرقاً حسنُهُ بدا في يدَيا",26,"ي",2,0],["كيانٌ واحدٌ عزا وجاها","ذوو شأنٍ بأيديهم يُدارُ",27,"ر",1,0],["كَيْ أَسْتَشِفَّ مَجَرَّتِي بِمَنَاهِلِي","لابُدَّ مِنْ كَأْسٍ تَعُبُّ مُحَالِيَا",28,"ل",3,0],["كي أشعرَ أني ممتزجٌ","في قاعِ الواد وأعلاهُ",29,"ا",2,0],["كي أصطفيكِ أنيساً ذا موادعةٍ","فالقلبُ أتعبهُ التحنانُ والسهرُ",30,"ر",1,0],["كي أصطفيكِ ولو بلمحةِ جملةٍ","تسمو على الترنيمِ والإنشادِ",31,"د",1,0],["كي أصطلي نارا بأهواله","بين الخضم الموحش الضيق",32,"ق",1,0],["كِيَانِي في الفِراق ضَئيلُ قَشٍّ","عَلاهُ العَصْفُ ليلاً والهَواءُ",33,"ا",2,0],["كي ألتقي بالموت مقتنعاً","ولينتهي في الأرض تشريدي",34,"د",2,0],["كي أعزفَ لحناً للعوْدةْ","ما زالتْ نفسي مُعتدَّةْ",35,"د",2,1],["كي ألتقي طيفكِ الساري فألثم","وأتقي حسرة تذوي وتُختَزَلُ",36,"ل",1,0],["كي أصطفيه مناضلا","ومعلما ومبشّرا",37,"ر",2,0],["كي أستشفَ بلمسةٍ","حسّية أو خاشعة",38,"ع",2,0],["كي أصيغ الوجود لمعة فكرٍ","يسبق البرق ومضها الخلاقُ",39,"ق",1,0],["كي أستلذّ طويلا","من دون ستري..حبك",40,"ك",1,0],["كَيُّ الْجِرَاحِ يُدَاوِيهَا إِذَا نَزَفَتْ","وَ يُنْعِشُ الْأَرْضَ لَطْمٌ مِنْ يَدِ الْغَدَقِ ..!",41,"ق",1,0],["كي أستظلَّ بِفَيءِ روحِكِ دائماً","وكأنَّها فوقَ القبورِ عريشُ",42,"ش",1,0],["كي أستردَّ رفاتَ لبٍّ تائهٍ","لولا زفيرُ الرُّوحِ منكِ يطيشُ",42,"ش",1,0],["كيان الشعر جيتك ساريٍ ليلي حنين عتاب","ابي ارقى مراقيك الطويله وارقب اركانك",43,"ك",1,1],["كيانٌ صاغه (بلفورُ) عجلاً","ليخدعَ تابعيهِ لو يخورُ",44,"ر",1,0],["كيانٌ وجهُ قادته قبيحٌ","وهمْ في الأرض إفسادٌ كبيرُ",44,"ر",1,0],["كي أسكبَ الروحَ نبضَ قصيدةٍ كُتبتْ","بماء قلبي وإنْ الحبَ أجراها",45,"ا",3,0],["كياننا يا إله الكون ملحمة","بالكاف والنون غيِّرْ وجهه الباكي",46,"ك",2,0],["كَي أَفقَهُ لَحناً تَعزِفُهُ","أنغامُ الحُزنِ عَلى وَتَري",47,"ر",2,0],["كي أدق الآن أعناق العدى","سائراً في أمتي حتى الرجاءْ",48,"ا",2,0],["كي أعتلي في رحابٍ طابَ منْبَرُها","أشكُو وتبكِي على حُزني تَواسيل",49,"ل",1,0],["كَيْ أُريحَ الشِعرَ مِني","قلتُ ما يُخفيهِ صَدري",50,"ر",2,0],["كَيْ أَغْرِسَ الْحُبَّ نَخْلًا","وَأَقْتُلَ الْخَوْفَ شَنْقَا",51,"ق",2,0],["كَي أُمْطِرَ الأشْوَاقَ مِنْ لَهَفِي","وَ أَطُوفَ بِالرَّيحَانِ فَوقَ رُبَى",52,"ب",2,0],["كي أعدو منتشيا وحدي","وغريبا بين الخطرات",53,"ت",1,0],["كياني كيانُ الحقِ إذ كنتُ ذا حجى","وفهمٍ داني ما برحتُ منَ الملكِ",54,"ك",1,0]]}