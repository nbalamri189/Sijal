https://www.poetsgate.com/ViewPoem.aspx?id=185305",""],[6127,"اعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=188289",""],[6148,"توبة","https://www.poetsgate.com/ViewPoem.aspx?id=201777",""],[6152,"الفأل عُمر ثان","https://www.poetsgate.com/ViewPoem.aspx?id=203073",""],[5309,"طلاب الخلد حرر كل واع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573520",""],[520,"هذي مناجاة عبد رق حاسده","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577501",""],[6160,"مَرايا لِعُروَة ابنِ الوَرد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87098&r=&rc=15",""],[5724,"ربيعك للروح كالبلسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55133&r=&rc=0",""],[6189,"نبوءة العمائم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83598&r=&rc=65",""],[6189,"قراءة لعوامل التعرية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83585&r=&rc=52",""],[6211,"الأرضُ تدورُ، الأرض تبحثُ عني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78497&r=&rc=14",""],[6262,"لغةٌ أخرى لمرايا البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80107&r=&rc=5",""],[6277,"الحنين الى الجزيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64461&r=&rc=24",""],[6340,"غادة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85846&r=&rc=11",""],[5190,"الببغاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78301&r=&rc=14",""],[5190,"إشارة حمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85037&r=&rc=112",""]],"verses":[["فَتَشْهَدَ فِي الغَدِ مَا قَدَّمَتْ","مِنَ الخَيْرِ فِي أُولَيات السِّنِينْ",0,"ن",1,0],["فَتَشْهَدُهَا وَتَعْرِفُ سَاكِنِيها","كَأَنَّكَ فِي الدِّيارِ مِنَ الصَّميمِ",1,"م",1,0],["فتشكرك الشكر الذي أنتِ أهله","طَوالَ الليالي خالداً في الدفاتر",2,"ر",1,0],["فتُشْرِب نفسَه حبّ المعالي","وتطعم جسمه منها الطعاما",3,"م",2,0],["فتُشكى وفيما قدّر الله عاذر","لأفعالها لكنها ليس تُعذر",4,"ر",1,0],["فتشدُّونَ لابنِ بؤسَى رِحالاً","وتحطُّونَ لابن نُعمَى رحالا",5,"ل",2,0],["فتشفع لي حرمان حظ بمثله","رماها عن اللَّوماء رام بشاغلِ",6,"ل",1,0],["فَتَشَوَّشَت صُوَرُ المُنى وَتَناثَرَت","كَالزَهرِ بَدَّدَ شَملَها الإِعصارُ",7,"ر",1,0],["فَتَشاءَمَ الرُكّاب وَاِضطَرَبوا","مِمّا أَلَمَّ بِهِم مِنَ الضَرِّ",8,"ر",1,0],["فَتَشَجَّعي وَعَلَيَّ فَاِتَّكِلي","فَأَنا الَّذي يَحميكِ مِن هِنري",8,"ر",2,0],["فَتَّشتُ جَيبَ الفَجرِ عَنها وَالدُجى","وَمَدَدتُ حَتّى لِلكَواكِبِ إِصبَعي",9,"ع",2,0],["فتشظَّى وتلكَ بعضُ شَظَايَا","هُ فَسامِحْ قُنُوطَهُ المتناهي",10,"ي",1,0],["فَتُشرقَ بالدم المسفوك ظلما","وبالوطن العثور ولا قياما",11,"م",2,0],["فتشكو من جراح ما تزول","وكيف يزول ما بلغ الوتينا",12,"ن",2,0],["فَتَّشتُ لَم أَرَ في الزَواجِ كَفاءَةً","كَكَفاءَةِ الأَزواجِ في الأَعمارِ",13,"ر",1,0],["فَتَشابَهُ الخُلُقانِ في إِقدامِهِ","وَتَخالَفا في بَذلِكَ المَأكولا",14,"ل",2,0],["فتش عن الباطن من كتبنا","فظاهر الكتب أضاليل",15,"ل",1,0],["فتَشهَدُ لي على الأَرَقِ الثُّرَيَّا","ويَعْلَمُ ما أُجِنُّ الفَرقدانِ",16,"ن",1,0],["فَتِّش فُؤادي فَأَنتَ ساكِنُهُ","فَليسَ فيهِ سِواكَ مِن بَشَرِ",17,"ر",1,0],["فَتّشتُ ما بين السُّطورِ فلم أَجِدْ","أنّ الأُسودَ بِصَيْدِها تتصدَّقُ",18,"ق",1,0],["فَتِّش الأجداثَ عن تيجانهم","واسْألِ الأحجارَ والصّخرَ المُقاما",19,"م",2,0],["فَتَشابَهَتْ أَسماؤُهُمْ وَصِفاتُهُمْ","وَغَنُوا عَنِ التَّعْرِيفِ بالأَعْلاَمِ",20,"م",1,0],["فَتَّشنَ عَن كُلِّ نَفسٍ","شَرقَ الفَضاءِ وَغَربَه",21,"ب",2,0],["فتشت من بعد الحَريق مَكانه","فوجدت أَنقاضاً وَبعض رماد",22,"د",1,0],["فَتَشوَّفَتْ شَوْقاً إلى نَغَماتِهِ","أفهامُنا وَرَنَتْ إلى آدابِهِ",23,"ب",2,0],["فَتَشَمَّمِي وَرْدَ الْحياةِ فَإِنَّهُ","يَمْضِي ولا يَبْقَى سِوَى الأشْوَاكِ",24,"ك",1,0],["فتشوا في الترب عن عزمته","وعن الإقدام والرأي الرصين",25,"ن",1,0],["فتَّشت ما فتَّشت عن لفظةٍ","نابيةَ فيه فلم أَعثُر",26,"ر",1,0],["فتَّشْتُ بين الناس عن زاهدٍ","فلم تقعْ عيني على واحد",27,"د",1,1],["فتِّشْ عن المعصم ذي السُّوارِ","فتِّشْ عن الأرحام والأصهارِ",28,"ر",1,0],["فتش عن الدرهم والدينارِ","في مصر؛ تعرفْ علَّةَ الدَّمارِ",28,"ر",1,0],["فتشت عند مسيره عن ظله","فوجدته قد غاص في جوف الثرى",29,"ر",2,0],["فتَّشتُ بين المحتفين فلم أجد","إلا طعينًا في الصميم أصيبا",3