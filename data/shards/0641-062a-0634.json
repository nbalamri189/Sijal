{"poems":[[93,"مددت طرافك للائدين","https://www.aldiwan.net/poem11200.html","المتقارب"],[93,"أصول الضاد طيبة الأروم","https://www.aldiwan.net/poem11416.html","الوافر"],[88,"حببت العلا منذ الصبا حب شاعر","https://www.aldiwan.net/poem44989.html","الطويل"],[88,"لدار شنلر في القدس فضل","https://www.aldiwan.net/poem44996.html","الوافر"],[51,"سيشكر رب الناس ما قد فعلته","https://www.aldiwan.net/poem62975.html","الطويل"],[51,"قل لمن ألبس الجمال جمالا","https://www.aldiwan.net/poem65878.html","الخفيف"],[51,"ألا نسيا نفسي حديث البلابلِ","https://www.aldiwan.net/poem65958.html","الطويل"],[91,"قالوا قضى موسى فقلت قد انطوى","https://www.aldiwan.net/poem8827.html","عموديه"],[91,"كانت قبيل العصر مركبة","https://www.aldiwan.net/poem8852.html","عموديه"],[91,"أنا لست بالحسناء أول مولع","https://www.aldiwan.net/poem8980.html","عموديه"],[92,"يا إله الوجود هذي جراح","https://www.aldiwan.net/poem38885.html","الخفيف"],[85,"عرابي كيف أوفيك الملاما","https://www.aldiwan.net/poem7581.html","الوافر"],[85,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[85,"ظلم الرجال نساءهم وتعسفوا","https://www.aldiwan.net/poem63768.html","الكامل"],[43,"في الخد أن عزم الخليط رحيلا","https://www.aldiwan.net/poem10125.html","الكامل"],[62,"يا أيها السائل عن سرنا","https://www.aldiwan.net/poem52232.html","السريع"],[61,"بلاني الحب فيك بما بلاني","https://www.aldiwan.net/poem51417.html","الوافر"],[66,"عزمت يا متلفي على السفر","https://www.aldiwan.net/poem39640.html","المنسرح"],[105,"من هيبة يغضي القريض ويطرق","https://www.aldiwan.net/poem42076.html","الكامل"],[105,"يا بريد النيل إن جئت الشآما","https://www.aldiwan.net/poem42115.html","الرمل"],[67,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[46,"إن يقرب الموت مني","https://www.aldiwan.net/poem22148.html","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85344","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16621","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54198","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[106,"تغريدات الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=179704",""],[106,"المادة","https://www.poetsgate.com/ViewPoem.aspx?id=179426",""],[106,"تراشق القادة","https://www.poetsgate.com/ViewPoem.aspx?id=179639",""],[106,"صاحب ثقيل","https://www.poetsgate.com/ViewPoem.aspx?id=179530",""],[106,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[100,"نهاية حسناء ريفيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50449",""],[90,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[91,"أنا هو","https://www.poetsgate.com/ViewPoem.aspx?id=53080",""],[94,"النبع المسحور","https://www.poetsgate.com/ViewPoem.aspx?id=15631",""],[124,"أفي كل يوم أنت مضنى مروع","https://www.aldiwan.net/poem23779.html","الطويل"],[128,"شمر الذيل وبادر للعمل","https://www.aldiwan.net/poem50540.html","الرمل"],[152,"زائر","https://www.aldiwan.net/poem17106.html","عموديه"],[211,"مرت الأيام والروح الحزين","https://www.aldiwan.net/poem46613.html","الرمل"],[225,"لهف الرياسات على راحل","https://www.aldiwan.net/poem55089.html","السريع"],[225,"كم ساعة آلمني مسها","https://www.aldiwan.net/poem55108.html","السريع"],[235,"بستان جعفر مثله","https://www.aldiwan.net/poem31769.html","مجزوء الكامل"],[235,"هل أنت يا أخت القضيب الناضر","https://www.aldiwan.net/poem31983.html","الرجز"],[239,"الله ربي والحنيفةُ ديني","https://www.aldiwan.net/poem1095.html","الكامل"],[270,"كنت يا أماه أرعى النجما","https://www.aldiwan.net/poem35229.html","الرمل"],[270,"أدمشق أين بنو أمية قولي","https://www.aldiwan.net/poem35651.html","الكامل"],[303,"فتش حشاي تجدها","https://www.aldiwan.net/poem58223.html","المجتث"],[304,"شغف المحب بحب ظبية عامر","https://www.aldiwan.net/poem16891.html","الكامل"],[305,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[371,"دارت عيون في محاجر","https://www.aldiwan.net/poem57443.html","مجزوء الكامل"],[377,"أفأي عين لا ترف وتدمع","https://www.aldiwan.net/poem59345.html","الكامل"],[391,"يا غياث المستغيثين أغث","https://www.aldiwan.net/poem54550.html","عموديه"],[393,"بلغت نفسي مناها","https://www.aldiwan.net/poem53668.html","مجزوء الرمل"],[403,"وافى نظامك وهو خير نظام","https://www.aldiwan.net/poem33424.html","الكامل"],[403,"يا قرير العين في بلده","https://www.aldiwan.net/poem33965.html","الرمل"],[405,"نحن والله في زمان سفيه","https://www.aldiwan.net/poem49439.html","الخفيف"],[432,"نثرن عليه من صدف الخيام","https://www.aldiwan.net/poem12735.html","الوافر"],[458,"قضى دين سعدى طيفها المتأوب","https://www.aldiwan.net/poem56292.html","الطويل"],[461,"وصل الجواد من الجواد","https://www.aldiwan.net/poem16175.html","مجزوء الكامل"],[468,"يا لقومي أما لقتلي ثار","https://www.aldiwan.net/poem60033.html","الخفيف"],[477,"متى حان من شمس النهار غروب","https://www.aldiwan.net/poem15325.html","الطويل"],[479,"قالوا السكوت وما دروا","https://www.aldiwan.net/poem36962.html","مجزوء الكامل"],[479,"طال المدى في خطة الأعراض","https://www.aldiwan.net/poem37181.html","الكامل"],[479,"الدهر دهر والرجال رجال","https://www.aldiwan.net/poem37622.html","الكامل"],[505,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[514,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[515,"هذي مناجاة عبد رق حاسده","https://www.aldiwan.net/poem12097.html","البسيط"],[538,"لله يوم حفه عيدان","https://www.aldiwan.net/poem47605.html","عموديه"],[558,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[558,"أحزاننا بلقائكم أفراح","https://www.aldiwan.net/poem34674.html","الكامل"],[567,"حب علي علو همه","https://www.aldiwan.net/poem69525.html","مجزوء الرجز"]],"verses":[["فَتَشْهَدَ فِي الغَدِ مَا قَدَّمَتْ","مِنَ الخَيْرِ فِي أُولَيات السِّنِينْ",0,"ن",1,0],["فَتَشْهَدُهَا وَتَعْرِفُ سَاكِنِيها","كَأَنَّكَ فِي الدِّيارِ مِنَ الصَّميمِ",1,"م",1,0],["فتشكرك الشكر الذي أنتِ أهله","طَوالَ الليالي خالداً في الدفاتر",2,"ر",1,0],["فتُشْرِب نفسَه حبّ المعالي","وتطعم جسمه منها الطعاما",3,"م",2,0],["فتُشكى وفيما قدّر الله عاذر","لأفعالها لكنها ليس تُعذر",4,"ر",1,0],["فتشدُّونَ لابنِ بؤسَى رِحالاً","وتحطُّونَ لابن نُعمَى رحالا",5,"ل",2,0],["فتشفع لي حرمان حظ بمثله","رماها عن اللَّوماء رام بشاغلِ",6,"ل",1,0],["فَتَشَوَّشَت صُوَرُ المُنى وَتَناثَرَت","كَالزَهرِ بَدَّدَ شَملَها الإِعصارُ",7,"ر",1,0],["فَتَشاءَمَ الرُكّاب وَاِضطَرَبوا","مِمّا أَلَمَّ بِهِم مِنَ الضَرِّ",8,"ر",1,0],["فَتَشَجَّعي وَعَلَيَّ فَاِتَّكِلي","فَأَنا الَّذي يَحميكِ مِن هِنري",8,"ر",2,0],["فَتَّشتُ جَيبَ الفَجرِ عَنها وَالدُجى","وَمَدَدتُ حَتّى لِلكَواكِبِ إِصبَعي",9,"ع",2,0],["فتشظَّى وتلكَ بعضُ شَظَايَا","هُ فَسامِحْ قُنُوطَهُ المتناهي",10,"ي",1,0],["فَتُشرقَ بالدم المسفوك ظلما","وبالوطن العثور ولا قياما",11,"م",2,0],["فتشكو من جراح ما تزول","وكيف يزول ما بلغ الوتينا",12,"ن",2,0],["فَتَّشتُ لَم أَرَ في الزَواجِ كَفاءَةً","كَكَفاءَةِ الأَزواجِ في الأَعمارِ",13,"ر",1,0],["فَتَشابَهُ الخُلُقانِ في إِقدامِهِ","وَتَخالَفا في بَذلِكَ المَأكولا",14,"ل",2,0],["فتش عن الباطن من كتبنا","فظاهر الكتب أضاليل",15,"ل",1,0],["فتَشهَدُ لي على الأَرَقِ الثُّرَيَّا","ويَعْلَمُ ما أُجِنُّ الفَرقدانِ",16,"ن",1,0],["فَتِّش فُؤادي فَأَنتَ ساكِنُهُ","فَليسَ فيهِ سِواكَ مِن بَشَرِ",17,"ر",1,0],["فَتّشتُ ما بين السُّطورِ فلم أَجِدْ","أنّ الأُسودَ بِصَيْدِها تتصدَّقُ",18,"ق",1,0],["فَتِّش الأجداثَ عن تيجانهم","واسْألِ الأحجارَ والصّخرَ المُقاما",19,"م",2,0],["فَتَشابَهَتْ أَسماؤُهُمْ وَصِفاتُهُمْ","وَغَنُوا عَنِ التَّعْرِيفِ بالأَعْلاَمِ",20,"م",1,0],["فَتَّشنَ عَن كُلِّ نَفسٍ","شَرقَ الفَضاءِ وَغَربَه",21,"ب",2,0],["فتشت من بعد الحَريق مَكانه","فوجدت أَنقاضاً وَبعض رماد",22,"د",1,0],["فَتَشوَّفَتْ شَوْقاً إلى نَغَماتِهِ","أفهامُنا وَرَنَتْ إلى آدابِهِ",23,"ب",2,0],["فَتَشَمَّمِي وَرْدَ الْحياةِ فَإِنَّهُ","يَمْضِي ولا يَبْقَى سِوَى الأشْوَاكِ",24,"ك",1,0],["فتشوا في الترب عن عزمته","وعن الإقدام والرأي الرصين",25,"ن",1,0],["فتَّشت ما فتَّشت عن لفظةٍ","نابيةَ فيه فلم أَعثُر",26,"ر",1,0],["فتَّشْتُ بين الناس عن زاهدٍ","فلم تقعْ عيني على واحد",27,"د",1,1],["فتِّشْ عن المعصم ذي السُّوارِ","فتِّشْ عن الأرحام والأصهارِ",28,"ر",1,0],["فتش عن الدرهم والدينارِ","في مصر؛ تعرفْ علَّةَ الدَّمارِ",28,"ر",1,0],["فتشت عند مسيره عن ظله","فوجدته قد غاص في جوف الثرى",29,"ر",2,0],["فتَّشتُ بين المحتفين فلم أجد","إلا طعينًا في الصميم أصيبا",30,"ب",2,0],["فتشتمّ أمس المسجّى ، يعود","وتجترّه من رماد المنايا",31,"ا",3,0],["فتّشتُ عنكِ فلم أجِدْ أثراً","حتى ظننتُ العينَ من حجر",32,"ر",1,0],["فتشجهي وعليّ فاتّكلي","فأنا الذي يحميك من هنري",33,"ر",2,0],["فتّشت عن خوفي فلم ألفه","كيف أرى الخوف وأنت الأمان",34,"ن",1,0],["فتشجيك ذكراها ويصبيك ذكرها","وتشتاق سكناها إذا ضاق موسع",35,"ع",1,0],["فَتِّشِ الناسَ جميعاً هل ترى","غيرَ ذى عابٍ وإن كانَ بَطَلْ",36,"ل",1,0],["فَتَشَاءَمْتُ بَعْدَ فَأْلٍ، وَشَبَّتْ","رَغَبَاتٌ مَكْبُوتَةٌ فِي عِظَامِي",37,"م",2,0],["فتّش جيوبي فتش","يا أيها الطفل",38,"ل",1,0],["فَتَّشتُ لمّا لم أَجِد مُقلَتي","كُفؤاً عنِ الفَضل ليبكي معى",39,"ع",2,0],["فَتَشتُ فيها جاهِداً لم أَجِد","هُنَيهَةً واحدةً صافِيَه",40,"ي",2,0],["فَتَشابَهَت حُسناً أَوا","خِرُ يَومِنا بِأَوائِلِه",41,"ل",2,0],["فَتَّشتُ أَبناءَ الزَمانِ بَعدَما","بَلَوتُهُم طُرّاً بِعَينِ خابِرِ",42,"ر",1,0],["فَتَّشتَ في كتب الديانة باحثا","ومقلبا من أَظهر لبطون",43,"ن",1,0],["فتشوَّقتُ إلى قُبلاتهِ","إنها كانت لجرحى بَلسما",44,"م",2,0],["فتشرّفوا بينَ الملوكِ وشرّفوا","ملكاً تقاصرَ عنهُ باعُ دخيل",45,"ل",1,0],["فتش حشاي تجدها","مخصوصة بك وحدك",46,"ك",1,1],["فتشاهد الأملاك نحو صفيحها","متقبلين لنحو عرش الفاطر",47,"ر",1,0],["فَتشابَه الداهي وَمأمون الحجى","وَالجامدُ العبرات والمتروّعُ",48,"ع",1,0],["فتشهَّرت ثِقةً به","ذا في القبائل والعشائِر",49,"ر",1,0],["فتشفعي في المؤمنين ترحماً","إذ أنت أكبر شافعٍ يتشفَّع",50,"ع",1,0],["فتشفع في أموري كلها","والذي أملت من هذا وذاك",51,"ك",1,0],["فَتَشَفَّيتُ بِهذا ال","مَدحِ في الوَقتِ اِبتَداها",52,"ا",3,0],["فتَّشْتُ عن ألفاظه فوجدته","دُرّاً أتى في قعر بحر طام",53,"م",1,0],["فتشفع لي إلى ملك","كل خير فهو من صفده",54,"د",2,0],["فتَشَكَّلْ بشَكلِهِ يَكُ أحفى","بِكَ إنَّ السّفيهَ صِنْوُ السَّفيهِ",55,"ه",1,0],["فتشهدُ بالقراعِ لنا فلولٌ","بحدٍّ فوق حدّ فيه دامِ",56,"م",1,0],["فتشهد أَني ما عدمتُ فضيلةً","إلى مثلكم مثلي بها يَتَقرَّبُ",57,"ب",1,0],["فَتَشابَها مُتَسابِقَيْنِ","بيومِ مَيْدانٍ ونادِ",58,"د",1,0],["فَتِّشوا عَن دَمي رَطباً","في يَدَي مَن نِقابُها الجُلَّنارُ",59,"ر",1,0],["فتشتاقُه والشوقُ يُضْرِمُ نارَها","اليه وما بينَ الضلوعِ لهيبُ",60,"ب",1,0],["فتشتُ عنه فلم أجد","ه وهكذا معه ذهب",61,"ب",1,0],["فتش على ودي فؤادك تلقه","طللا هنالك قف على الأنقاض",62,"ض",1,0],["فتشجعوا بمعارف وتمولوا","فمعرتان الجهل والإقلال",63,"ل",1,0],["فتشربُ ثمّ تُسقِي من قريضٍ","زلالٍ مثلما ماءُ المَواطرْ",64,"ر",1,0],["فتّشْ عَبيرَ ثَراهُ إن شِئتَ الثّرى","فالدُّرُّ حيثُ به نثَرْنا عتْبَنا",65,"ن",2,0],["فتش تجد لي نصيراً في الذين هفوا","وما نظيرك ممن أنت واجده",66,"د",2,0],["فتَشَرَّفت بِلِقَائِهِ العُظَمَاءُ وَالن","نُبلاء والأَعيَانُ مِن أعيَانِ",67,"ن",1,0],["فتشتُ قبلك في الزمان فلم أجد","لفساد قلبي في الهوى إصلاحا",68,"ح",2,0],["فتشبهوا إن لم تكونوا مثلهم","إن التشبه بالكرام فلاح",69,"ح",1,0],["فَتِّشْ مُحِبِّيْهِ هَلْ تَرَاهُمْ","إِلاَّ ذَوِي ثَرْوَةٍ وَنِعْمَهْ",70,"م",2,0]]}