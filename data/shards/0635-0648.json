tsgate.com/ViewPoem.aspx?id=179224",""],[54,"لمْ يطيقوا أنْ يسمعوا وسمعنا","https://www.poetsgate.com/ViewPoem.aspx?id=14246",""],[45,"الحسناء","https://www.poetsgate.com/ViewPoem.aspx?id=12272",""],[80,"من كان يعذب عندها تعذبني","https://www.poetsgate.com/ViewPoem.aspx?id=3020",""],[51,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[51,"بدرٌ وشمس وَلَدَا كوكبا","https://www.poetsgate.com/ViewPoem.aspx?id=27044",""],[105,"سدوا المسامع إلا أن يقال لكم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55009&r=&rc=179",""],[105,"يا غاديا ببريد الشام ينتحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54966&r=&rc=136",""],[85,"رزق الله أهلَ باريسَ خيراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9523&r=&rc=14",""]],"verses":[["صَوائِبَ مِن نَبلِ العَداوَةِ لَم تَزَل","تَعُطُّ قُلوباً مِن وَراءِ الحِيازِمِ",0,"م",1,0],["صونوا بِها عِرضي وَوَجهي مَعاً","صونَهُما في الزَمَنِ الأَقدَمِ",1,"م",1,0],["صُوَرٌ رائِعَةٌ لا يُرتَجى","نَفعُها مِثلُ تَهاويلِ النَمَط",2,"ط",1,0],["صَوارِمُ أَغمَدتُها في الصَعيدِ","وَفَلَّلَتُ مِنها الظُبى وَالغُروبا",3,"ب",2,0],["صُوَرٌ ضَنَنتُ عَلى العُيونِ بِلَحظِها","أَمسَيتُ أوقِرُها مِنَ البَوغاءِ",4,"ا",2,0],["صونوا يَراعَ عَلِيٍّ في مَتاحِفِكُم","وَشاوِروهُ لَدى الأَرزاءِ وَالنُوَبِ",5,"ب",1,1],["صَوالِجُهُ سُمرُ القَنا وَكُراتُهُ","رُؤوسُ الأَعادي وَالحُصونُ مَلاعِبُه",6,"ب",2,0],["صَوائِبُ ريشُ النَصرِ في جَنَباتِها","لُؤامٌ وَريشُ الطائِشاتِ لُغابُ",7,"ب",1,0],["صَوابِحَ مِن مُزنٍ ثِقالٍ عَوادِياً","دَوالِحَ دُهماً ما خِضاتٍ دُجونها",8,"ن",3,0],["صَوْتُ الكِنَانَةِ فِي يُوبِيلِكَ الذَّهَبِي","صَوْتٌ لَهُ رَجْعَةٌ فِي الْعَالَمِ الْعَرَبي",9,"ب",2,1],["صوغ ورسم ونقوش إلى","ملا يباهي من ضروب البديع",10,"ع",1,0],["صَوْتٌ مِنَ الوَادِي تَجَاوَبَ فِي","تَرْدِيدِهِ الأَسْنَادُ وَالقُنَنُ",11,"ن",1,0],["صَوَّرْتُهُ وَكَأَنَّ صُورَتَهَا بَدَتْ","فِيهِ أَرَاهَا دُونَهُ وَتَرَانِي",12,"ي",1,0],["صُوَرٌ بِعَيْنَيْهِ بَدَتْ وَوَرَاءهَا","صُوَرٌ بَدَتْ لِلنَّيلِ وَالأَهْرَامِ",13,"م",1,0],["صَوْتُهُ فِي مَحَافِلِ الجِيلِ يَعْلُو","وَصَدَاهُ فِي مَسْمَعِ الأجْيَالِ",14,"ل",1,0],["صَوتُ مَضغِ الطَعامِ أَحسَنُ عِندي","مِن غِناءِ القِيانِ بِالعيدانِ",15,"ن",1,0],["صَوافِنُ لا يَعدِلنَ بِالوِردِ غَيرَهُ","وَلكِنَّها في مَورِدَينَ عِدالُها",16,"ل",3,0],["صَوادِيَ الهامِ وَالأحشاءُ خافِقَةٌ","تَناوُلَ اِلهيمِ أَرشافَ الصَهاريجِ",17,"ج",1,0],["صور من أملح الصور","روض هو خد من زهر",18,"ر",1,0],["صوت كأن الغانيا","ت أعرنه هيف الخصور",19,"ر",1,0],["صواعق من سُحب الدخان تدُكّها","وتنسفها نسف الزلازل للهضب",20,"ب",1,0],["صوَّبوها بنادقاً تطلق المو","ت رصاصاً به أبادوا النفوسا",21,"س",2,0],["صوراً تمثّل ذاته وصفاته","حتى يقمن لنا مقام نشوره",22,"ر",2,0],["صُونوهُ لي وارعَوهُ لي واملَؤوا","يديه لي لا بل بما استوجَبا",23,"ب",2,0],["صُورتُه ناعتةٌ خُبْرَه","مُوعِدةٌ بالشَرِّ لا واعِدَهْ",24,"د",2,1],["صوّركِ الماردُ اللعين فأع","طتكِ يداهُ مقابحَ الصُّورِ",25,"ر",1,0],["صونوا خَلاقي كما صنتم نوالكُمُ","عني وإلا فكونوا حاكماً جارا",26,"ر",2,0],["صوتٌ نديٌّ وأنفاسٌ مساعدةٌ","كأنما نَفسٌ منهَن أنفاس",27,"س",1,0],["صوتُها بالقلوب غيرُ رفيق","بل له بالقلوب عُنفٌ وبطشُ",28,"ش",1,0],["صوم غدت عين الخنا مطروفة","فيه وراح لسانه مقطوعا",29,"ع",2,0],["صوتاً تراني مجنوناً أخا كلفٍ","إذا سليمان يوماً قد به نطقا",30,"ق",2,0],["صَوادِقِ عِتقٍ في الرِحالِ كَأَنَّها","مِنَ الجَهدِ أَسرى مَسَّها البُؤسُ وَالفَقرُ",31,"ر",1,0],["صُوَرٌ في نُفوسِنا كائِناتٌ","تَرتَديها الأَفعالُ وَالأَشياءُ",32,"ا",2,0],["صُوَرٌ مُعَدَّدَةٌ لِغَيرِ حَقيقَةٍ","كَالآلِ لاحَ لِمُعطِشٍ في فَدفَدِ",33,"د",1,0],["صودِرَ الكاتِبُ مِنّا وَالخَطيب","مُنِعَت أَلسُنُنا حَتّى الكَلام",34,"م",1,0],["صَوَّرتَ في القِرطاسِ حَتّى الخاطِرا","فَخَلَبَتنا وَسَحَرتَ حَتّى الساحِرا",35,"ر",2,0],["صُوَر وَأَطيافٌ تَلوحُ خَفيفَةً","وَكَأَنَّها صُوَرٌ نَراها في الكَرى",36,"ر",2,0],["صَوتُ المُصَفِّقِ مَوعِدٌ ما بَينَنا","ماذا أَقولُ لَهُم إِذا الديكُ اِستَحَر",37,"ر",1,0],["صُوَرٌ وَآياتٌ تَفيضُ بَشاشَةً","حَتّى كَأَنَّ اللَهَ فيها يَبسُمُ",38,"م",1,0],["صَوتُ سورِيّا الجَميلَه","صَوتُكِ العَذبُ الرَخيم",39,"م",1,1],["صَوتُ سورِيّا الجَميلَه","صَوتُكِ العَذبُ ارَخيم",39,"م",1,0],["صُوَرٌ مِن خُضرَةٍ في نَضرَةٍ","ما رَآها أَحَدٌ إِلّا اِشتَهاها",40,"ا",3,0],["صورَتُها في القَلبِ مَطبوعَةٌ","لا شَيءَ حَتّى المَوتِ يَمحوها",41,"ه",2,0],["صورةٌ للشَّقاءِ دامِعَةُ الطَّرْفِ","ولونٌ يَسُودُ في كلِّ طَرْسِ",42,"س",1,0],["صورَةٌ للوجودِ شوهاءُ لولا","شفقُ الحُسْنِ فوقَ تِلْكَ الخُدودِ",43,"د",1,0],["صَوتُ الحياةِ بضَجَّةٍ","تَسْعَى على شَفَةِ البُحُورْ",44,"ر",1,0],["صوح الزهر في الربيع وأمضى","صامتا يومه الحمام السجوع",45,"ع",1,0],["صور محببة وليس بمنكر","حوج الحياة الى الجمال الاروع",46,"ع",1,0],["صورة النحات الملامح منه","فقرأنا وراءهن الخلالا",47,"ل",2,0],["صوت له شجوه كالسهم منطلق","وربه في ضمير الليل مستتر",48,"ر",1,0],["صور تبسط النفو","س فما اجمل الصور",49,"ر",1,0],["صوّره الله صالحات","وصاغ أجزاءه حياء",50,"ا",2,0],["صوني جمالك عنا إننا بشر","من التراب وهذا الحسن روحاني",51,"ي",1,0],["صُوَرٌ مِن حَقيقَةٍ وَخَيالٍ","هِيَ إِحسانُ فِكرِهِ وَاِبتِداعُه",52,"ع",2,0],["صورَةٌ مُحسَنَةٌ ما تَختَفي","وَمِثالٌ طَيِّبٌ ما يَحتَجِب",53,"ب",1,0],["صَوتُ الشُعوبِ مِنَ الزَئيرِ مُجَمَّعاً","فَإِذا تَفَرَّقَ كانَ بَعضَ نُباحِ",54,"ح",1,0],["صُوَرٌ تُريكَ تَحَرُّكاً","وَالأَصلُ في الصُوَرِ السُكون",55,"ن",1,0],["صَوَّروهُ كَما يَشاؤونَ حَتّى","عَجِبَ الناسُ كَيفَ لَم يُنطِقوهُ",56,"ق",3,0],["صُوَرُ العَمى شَتّى وَأَقبَحُها إِذا","نَظَرَت بِغَيرِ عُيونِهِنَّ الهامُ",57,"م",1,0],["صَوتُ الحَقيقَةِ بَينَ رَع","دِ الجاهِلِيَّةِ وَالهَزيمِ",58,"م",1,0],["صُوني شُعَاعَ الضَّمير واسْتَشْعِرِي","الصَّبْرَ وحُسْنَ العَزَاءِ واحْتَسِبي",59,"ب",2,0],["صَؤولٌ إِذا ما الخوفُ أوعَدَ أهلَهُ","قؤولٌ إِذا التفّتْ عليه المجامِعُ",60,"ع",1,0],["صَوْغٌ من الذهبِ المصَفَّى نَشْرُهُ","مسكٌ إِذا حضرَ النَّدِيَّ تعطَّرَا",61,"ر",2,0],["صَواعِقُ آراءٍ لَوِ اِنقَضَّ بَعضُها","عَلى يَذبُلٍ لَاِنقَضَّ أَو ذابَ جامِدُه",62,"د",2,0],["صَوائِبُ مُزنٍ تَغتَدي مِن شَبائِهٍ","لِأَخلاقِهِ في جودِها وَنَظائِرِ",63,"ر",1,0],["صَوارِمٌ عَن حَدِّ مَأثورِها","خَلَّت إِيادٌ دَيرَ عاقولَها",64,"ل",3,0],["صَوادِفُ جَدَّدنَ بَعدَ الهَوى","مِطالَ الدُي