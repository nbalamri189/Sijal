{"poems":[[33,"لعمري لو أبصرتني يوم بنتم","https://www.aldiwan.net/poem42042.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202536","الرجز"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43911","الطويل"],[215,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[406,"وماذا لو تمادى ؟؟","https://www.aldiwan.net/poem6736.html","عموديه"],[408,"أغير أبي السبط للمصطفى","https://www.aldiwan.net/poem46961.html","المتقارب"],[463,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103102","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54149","البسيط"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99473","السريع"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126922","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66507","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83155","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120433","المتقارب"]],"verses":[["وَكيفَ غَداةَ البَينِ وَجدي وَكَيفَ إِذ","نَأَت دارُكُم عَن شِدَّةِ الوَجدِ آرَقُ",0,"ق",1,0],["وكيْفَ غدُر ابنُ الوليد كيفا","الله أوْفى وأوبرّ سيْفا",1,"ف",2,0],["وكيف غِناءُ الطّيرِ في غير أَيكِها","وقد بَعُدَتْ عنها فِرَاخٌ وأوكارُ",2,"ر",1,0],["وكيف غدوا بهذا الصيف صرعى","لمشئوم الشتات والاغتراب",3,"ب",1,0],["وكيف غدا بالكذب قولكِ مفعم","وعقلك بالأوهام أضحى مغلّفا",4,"ف",2,0],["وكيفَ غدَا حقّه فيكم","ولَم تَبْلُ أعْظمُهُ ضَائِعا",5,"ع",2,0],["وكيف غدا جَنّةً صيفُها","وكانت جحيماً على المرتعِ",6,"ع",1,0],["وكيف غبت بغيب أنت شاهده","ومن سواك وأنت الخلق والأمر",7,"ر",1,0],["وكيف غير حسناً منهما خجلت","شمس الضحى منه في الإشراق والطفل",8,"ل",1,0],["وكيف غنت خمرةٌ لا تسل","غنت فأغنتنا عن الخيش",9,"ش",1,0],["وكيف غدت تستعطف القوم في السبا","وكانت غياثا في حلول النوائب",10,"ب",1,0],["وكيف غدت في نار برق سمائها","مجامر أزهار الربى تنشر النشرا",11,"ر",2,0],["وَكَيفَ غَيَّره ما مَرّ مِن زَمَنٍ","وَمَن تَعاقَبَ مِن عُجم وَمِن عَرَبِ",12,"ب",1,0],["وكيف غرامي ينمو ويربو","وجسمي يشف ضنى ونحولا",13,"ل",2,0]]}