{"poems":[[53,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[53,"قل لمن ألبس الجمال جمالا","https://www.aldiwan.net/poem65878.html","الخفيف"],[463,"من مبلغ عني وإن تعذرت","https://www.aldiwan.net/poem55897.html","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74091","السريع"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199024","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83601","السريع"],[4755,"لَيلٌ.. وصَنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=203125",""]],"verses":[["إن مقام المظلوم عند أبي ال","عباس أضحى مقام منتصف",0,"ف",1,0],["إن مقدارهُ متى تزِنُوهُ","تجدوه من ألفِكُمْ مثقالا",1,"ل",2,0],["إن مقاماً حايدوك دونه","خامدةٌ لا بدّ من ضِرامِها",2,"م",3,0],["أنمّق الشعرَ وَلَكِنَّني","منزّهٌ عَن حرفة الشاعِرِ",3,"ر",1,0],["إن مقال المسلمين اتفقا","أن إله العالمين خلقا",4,"ق",2,0],["أُنمِقُ الشعر كَما يَنبَغي","هديَّةً لِلسَّيِّدِ الأَمجَدِ",5,"د",1,0],["أُنَمِّقُ الحُزنَ مَفتُونًا بِهِ وبِها","كَمَا تُنَمِّقُ أُمٌّ بَهجَةَ الوَلَدِ",6,"د",1,0]]}