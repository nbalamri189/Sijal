{"poems":[[55,"أما لو لم تعاقره العقار","https://www.aldiwan.net/poem30451.html","الوافر"],[88,"ملكتم علي عنان الخطب","https://www.aldiwan.net/poem68863.html","المتقارب"],[39,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[53,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[87,"بحمد الله رب العالمينا","https://www.aldiwan.net/poem63730.html","الوافر"],[64,"على أثلات الواديين سلام","https://www.aldiwan.net/poem52296.html","الطويل"],[63,"شباب المرء ثوب مستعار","https://www.aldiwan.net/poem51666.html","الوافر"],[46,"أيها البرق بت بأعلى البراق","https://www.aldiwan.net/poem30394.html","الخفيف"],[46,"قفوا جددوا من عهدكم بالمعاهد","https://www.aldiwan.net/poem30543.html","الطويل"],[107,"الكون أشرق نضرة ونعيما","https://www.aldiwan.net/poem42064.html","الكامل"],[108,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[102,"مأساة حارس الملك","https://www.poetsgate.com/ViewPoem.aspx?id=50435",""],[280,"أدرك بخيلك خيل الله أندلسا","https://www.aldiwan.net/poem25469.html","البسيط"],[280,"أعمى البصيرة من تقدمه الهوى","https://www.aldiwan.net/poem25561.html","الكامل"],[309,"حييت يا مربع الأحباب","https://www.aldiwan.net/poem16795.html","المديد"],[358,"للجد صورة هزل حليها الأدب","https://www.aldiwan.net/poem40569.html","البسيط"],[447,"رزء بنا حل حتى صار محلولا","https://www.aldiwan.net/poem14473.html","البسيط"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88616","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63835","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62684","الوافر"],[1282,"","https://poetry.dctabudhabi.ae/diwan/poem/105279","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49979","البسيط"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203763","الكامل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113957","الطويل"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99058","الهزج"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71037","السريع"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137935",""],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67195","الرجز"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60853","الكامل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105661","الرمل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65988","الرجز"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132543","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132789","البسيط"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130060","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26118","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86508","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40138","الكامل"],[3984,"","https://poetry.dctabudhabi.ae/diwan/poem/147201","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125827","الطويل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199108","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123501","الخفيف"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33067","الوافر"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81948","الطويل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81916","الطويل"],[4299,"","https://poetry.dctabudhabi.ae/diwan/poem/203767","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139470",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139593",""],[4816,"المعذره","https://www.poetsgate.com/ViewPoem.aspx?id=12851",""],[4869,"فكاهيه","https://www.poetsgate.com/ViewPoem.aspx?id=151635",""],[5212,"مملكة النّمل","https://www.poetsgate.com/ViewPoem.aspx?id=212581",""],[5616,"كواكب","https://www.poetsgate.com/ViewPoem.aspx?id=203426",""],[5641,"همشك ضم من حرفي","https://www.poetsgate.com/ViewPoem.aspx?id=189033",""],[5910,"العدلُ أقْوَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=206276",""],[5956,"إني أمد إليك كل حبالي","https://www.poetsgate.com/ViewPoem.aspx?id=182290",""],[5956,"دكتورنا الهادي مفيدُ الضادِ","https://www.poetsgate.com/ViewPoem.aspx?id=192985",""],[5956,"قلبي على زوجتي السائحة النائحة في إيطاليا والمتفضلين على الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=203551",""],[6031,"أَلاَ هَلْ تجاوَزْتَ الخِباءَ المحجَّبَا","https://www.poetsgate.com/ViewPoem.aspx?id=46274",""],[6242,"على شرفة أبريل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87560&r=&rc=7",""]],"verses":[["هُمُ شُهبٌ إِذا اِتَّقَدوا لِحَربٍ","فَخِرصانُ الرِماحِ لَها شِرارُ",0,"ر",1,0],["هُمُ شَجَّعوني عَلى أَن أَقولَ","وَما كانَ لي بَينَهُم مُضطَرَب",1,"ب",1,0],["هُمُ شَهِدُوا بَدراً وخَيبَرَ بَعدَها","ويومَ حُنَين والدِّمَاءُتَصَبَّبُ",2,"ب",1,0],["هُمْ شَفَوْها من السقام وكانت","حرضاً هالكاً من الأحراض",3,"ض",1,0],["هُمُ شَهَروا أَذىً وَشَهَرتَ حَرباً","فَكُنتَ أَجَلَّ إِقداماً وَضَربا",4,"ا",1,0],["هُمُ شَرعوا أنَّ الجَفاءَ محلَّلٌ","وهمْ حكموا أن الوفاءَ حَرامُ",5,"م",1,0],["هم شجرٌ من التمويهِ أكدَى","فلا ظِلٌّ لدَيْهِ ولاثِمارُ",6,"ر",1,0],["هُم شَليلٌ وَنَشرَةٌ حينَ لُفَّت","في غَداةِ الهَياجِ ساقٌ بِساقِ",7,"ق",1,0],["هُمُ شَغَلوا يَومَيكَ بِالبَأسِ وَالنَدى","وَآتَوكَ زَنداً في العُلى غَيرَ خامِدِ",8,"د",1,0],["هُمْ شاغبوه فكان أعظمَ قُوّةً","وأعزَّ مَنْزِلةً وأشرفَ خِيما",9,"م",2,0],["هم شاركوا الأرباب في ملكوتها","كم صاح صائحهم، وقال: عبادي",10,"د",2,0],["هم شيدوا المجد بما ابيض به","فود عوادي دهرهم حتى غطا",11,"ا",1,0],["هم شياطين ، أنا أعرفهم","حين أسطو ، يدّعون المسكنه",12,"ن",2,0],["هُمْ شِيعَةُ الأَمْرِ وَهْيَ الدَّارُ قَد نُهِكَتْ","دَاءً وَمَا لَمْ تُبَاشِرْ حَسْمَهُ انْتَكَسا",13,"س",2,0],["هُمْ شَمَّرُوا إذ أسْبَلَتْ أضْدادُهُم","شَتّانَ ما الإِسْبَالُ والتشمِيرُ",14,"ر",1,0],["هم شَوَّشوا عيش وادينا","بالظلم والبغي والعدوان",15,"ن",1,0],["هُمُ شُموس المَعالي كَيفَما طَلعوا","وَهُم بُدور اللَيالي حيثما غَربوا",16,"ب",3,0],["هم شيدوا المجد من عقبى أبيك ومن","عقباك واحتملوا الأثقال تحميلا",17,"ل",2,0],["هم شرعوا دون ثغر الرشاد","اراقم سدت مسد الاسل",18,"ل",1,0],["هم شرُّ ما أوعى البغا","يا قطُّ من نُطَفِ السكارى",19,"ر",2,0],["همُ شدُّوا الجِمال ضحاً بجُمْلٍ","وسَارُوا بالجميل وبالجمال",20,"ل",1,0],["هم شرعوا المجد زمان لم تكن","اكرومة بين الورى أو تعرف",21,"ف",1,0],["هم شفعاء العبد في يوم عرضه","هم خلفاء اللّه في أهل أرضه",22,"ه",1,0],["هُمُ شُموسُ ضُحىً حلّت بروجَ عُلىً","وهُم بجور ندىً فيها ليوثُ شَرَى",23,"ر",2,0],["هم شيعة الحق الذي ما بعده","إلا مهاو في الضلالة متلفه",24,"ف",2,0],["هُمُ شَيَّدوا أركانَهُ برماحِهِم","فَما مالَ حَتّى صُرَّعوا كُلَّ مصرَعِ",25,"ع",1,0],["همُ شتّى فسلني عن","همُ ينبيك ذو خبر",26,"ر",1,0],["هُم شُفَعائي يوم بعثي إِذا","ما جَمَّعَتْنا صَيْحَةُ الصائِحِ",27,"ح",1,0],["هم شبُّوا عليك ناراً وإِذ أن","قذتِ منها كانت لهم أتوُّنا",28,"ن",2,0],["هُم شَبَّهُوا المَخلُوقَ بِالخَلاَّقِ عَك","سَ مُشَبِّهِ الخَلاَّقِ بِالإِنسَانِ",29,"ن",1,0],["هم شبهوه بالجماد وليتهم","قد شبهوه بكامل ذي شأن",29,"ن",1,0],["هُم شَيَّدوا دَعوى النبي المُصطفى","لولاهم ما بانَ صدقُ ما دَعا",30,"ع",2,0],["هم شرقوا في سيرهم أم عرّبوا","أم أنجَدوا في بينهم أم اتهموا",31,"م",3,0],["هم شحاح لم يجودوا لي حتى في ثيابي","ثم قالوا هو لا يرضى بستر وحجاب",32,"ب",1,0],["هم شاهدوا الكفار بالتلعثم","هم لقموا الاشرار مال اليتم",33,"م",1,0],["هم شموس العلى نجوم المساعي","مالأقمار سعدهم من غروب",34,"ب",1,0],["هم شفعائي غداة المحشر","بهم جميع المعاصي تغفر",35,"ر",1,0],["همُ شاطروك الهمّ في البؤسِ فاِرعهم","ولا تنسَ ما قد كان في الغرب منهمُ",36,"م",1,0],["هُمُ شَقوَةُ الغَريبِ فَلا بَنى","بِساحَتِهم إِلّا سَروقٌ وَبائِسُ",37,"س",1,0],["هم شهب بيروت المضيئة أن دجت","ظلم الخطوب بنورها لتكشف",38,"ف",1,0],["هُم شَيّدوا صَرْحَ النّفاقِ وَأَوقَدوا","ناراً تَحُشّ بِهم غَداً في المَحشَرِ",39,"ر",1,0],["همُّ شعبي هَمّي وهمُّ بلادي","وشجونُ الوجودِ من أشجاني",40,"ن",2,0],["هم شردونا من فلسطين عنوةً","وبطشك فيهم كان منك ذيادا",41,"د",2,0],["هم شيدوا بيت العلا وأقامه","ذو منعة أعيت على العقبان",42,"ن",1,0],["هم شموس اهتدا نجوم اقتداء","وأسود الهيجاء عند البراز",43,"ز",1,0],["هُمُ شَدّوا القِبابَ وَأَحرَزوها","فَلَو زادوا لَها باباً بِقُفلِ",44,"ل",1,0],["هم شجرة الطوبى هم سدرة النها","هم جنة المأوى ونار لمجرم",45,"م",1,0],["هم شجرة الطوبى وسدرة منتهى","هم جنة المأوى ونارٌ لمجرم",46,"م",1,0],["هم شيعة الحق الذي ما بعده","إلا مهاوي في الضلالة متلفه",47,"ف",2,0],["هم شموس العلا ومنهم شموس ال","أفق والشهب كلها أضواء",48,"ا",2,0],["هم شمس الممالك أين حّلوا","وآل الملك والغرر الوضاح",49,"ح",1,0],["هم شوق ورد وصل الانحسار","ومنك عمدان الوصال مكسرة",50,"ر",2,0],["همّش تراك بتملي اجيوبك اسواط","وتطنيشك يلاعبهم بدور تمحيط",51,"ط",1,0],["هم شايف چفن يشبُگ رضيع ابيوم","مره ابكربلاء وصارت اكثيره",52,"ر",2,0],["هم شجرٌ ونحن لهم ظلال","ونحن الطارئون إذا أرادوا",53,"د",3,0],["همشك ضم من حرفي","ن من هم وَمن شكّ",54,"ك",1,1],["هم شيَّدوا صرْحَ بغيٍ، تحتَه هلكوا","وهم أداروا كؤوسَ الذلِّ تُفْتدَمُ",55,"م",1,0],["هم شرُّ مَن حرموا المَلا من حقهم","فيما يسمَّى الحبَّ غيرَ حلالِ",56,"ل",1,0],["هم شاكرون لنابغٍ أسرى بهم","للسيرِ في يُسرٍ لكل مُرادِ",57,"د",1,0],["هم شرَّعوا السَّرقاتِ رسْميَّاً لها","معَ غيرِ رسميٍّ يُزيل رخاءَها",58,"ا",3,0],["هُمُ شَاطَرُونا العَيْشَ وانفردُوا بِهِ","خبيثاً وأعْطَوْا منه ما كَانَ أَطْيبا",59,"ب",2,0],["همشتَ آمالي دفاتر وحدتي","وركنتَ حباً خائفاً ما أسرعكْ",60,"ك",1,0]]}