{"poems":[[88,"حياكم الله أحيوا العلم والأدبا","https://www.aldiwan.net/poem10917.html","البسيط"],[53,"أبو سليمان لا ترضى طريقته","https://www.aldiwan.net/poem66494.html","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54293","الطويل"],[168,"عفظير إنا اختلفنا","https://www.aldiwan.net/poem67829.html","المجتث"],[255,"عودته أنه يجني وأعتذر","https://www.aldiwan.net/poem14956.html","البسيط"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[308,"أقول والأير ملقى حشو تينته","https://www.aldiwan.net/poem57605.html","البسيط"],[358,"بدا لنا الخال في وردي وجنته","https://www.aldiwan.net/poem40546.html","البسيط"],[473,"غدت إلى ديره ومأواها","https://www.aldiwan.net/poem59533.html","المنسرح"],[484,"قد استجاد عذولي","https://www.aldiwan.net/poem37002.html","المجتث"],[484,"زرت المحل المحلى","https://www.aldiwan.net/poem37030.html","المجتث"],[505,"يا لفتة الظبي من غربي لعلع في","https://www.aldiwan.net/poem38060.html","البسيط"],[541,"قال النبي ولم أجزع يوقرني","https://www.aldiwan.net/poem23854.html","البسيط"],[567,"دعوت شعرك تقريظا وكان على","https://www.aldiwan.net/poem52733.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66785","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38846","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62654","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59229","السريع"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126142","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46508","الرجز"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104466","الرجز"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71033","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27723","البسيط"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126191","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140069",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201750","المجتث"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202999","المتقارب"],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142899","المتقارب"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87408","الرجز"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87449","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112628","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48428","البسيط"],[3617,"","https://poetry.dctabudhabi.ae/diwan/poem/107037","المجتث"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[4679,"تساءلت هرة وكلبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=142776",""],[4732,"ببينك لا بالماضيات القواضب","https://www.poetsgate.com/ViewPoem.aspx?id=173332",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5281,"نزلت للوادي ملاوي ملاوي","https://www.poetsgate.com/ViewPoem.aspx?id=199603",""],[5376,"لا تقرب اليأس في موجاته خطر","https://www.poetsgate.com/ViewPoem.aspx?id=188433",""],[5970,"آمال مصر بهذا القصر مودعة","https://www.poetsgate.com/ViewPoem.aspx?id=130660",""]],"verses":[["فَقالَ قَومٌ وَقَد رَقّوا لِذي أَلَمٍ","يَبكي وَذي أَلَمٍ يَستَقبِلُ العَطَبا",0,"ب",2,0],["فقال قد سجدتْ قبلي ملائكةٌ","لمن سوى اللَّهِ دعوى ذاتَ برهانِ",1,"ن",1,0],["فقال قَضَى قُلْنا قَضَى حاجةَ العُلا","فقال مَضَى قُلنا بغير ضَرِيب",2,"ب",1,0],["فَقالَ قَومٌ يُثَنّى","لِجَمعِنا الهَمزَتَينِ",3,"ن",1,0],["فقال قلبي لطرفي عند فُرقَتِهم","ماذا بدمعك يوم البَينِ تَنتَظرُ",4,"ر",1,0],["فَقال قُرّوا عَينا","ولا شكوتُم أَينا",5,"ن",2,0],["فقال قد مت من رهز أكابده","وهل تروق دفيناً جودة الكفن",6,"ن",1,0],["فَقال قُل في جَمالي يا مُؤرّخه","أَرى بِلال يراعي الفَجر في السحرِ",7,"ر",1,0],["فَقالَ قَلبي لِمَ لَيسَ تَعشَقُها","فَقُلتُ مِثلي مَن لَيسَ يَهواها",8,"ا",3,0],["فقال قل في شعرا","ولو يكون هجائي",9,"ا",3,0],["فقال قل فيه شعرا","فقلت بيت المحلى",10,"ل",2,0],["فقالَ قَدْ وَعدوكَ الوَصلَ مِتْ طَرَباً","فمِتُّ عن كونِ دُنْيائي وآخِرَتي",11,"ت",2,0],["فَقالَ قَولاً رَسولُ اللَهِ مُبتَهِلاً","يا رَبِّ إِن كانَ يَنوي غَيرَ إِخفاري",12,"ر",2,0],["فقالَ قد كانَ ميْتاً قبلَ ذاكَ وقدْ","أحييَتُهُ اليومَ تهذيباً وتزيينا",13,"ن",2,0],["فقال قد جعلت هذا واليا","عليكم فاستمعوا مقاليا",14,"ي",2,0],["فقال قد خلعت إذ أبيتم","نفسي فبايعوا إذا من شئتم",14,"م",1,0],["فقال قد أسرى به في نومه","يرجو مجيء أحد من قومه",14,"ه",1,0],["فقال قد قدم يوم بدر","إلى صناديد رؤوس الكفر",14,"ر",1,0],["فقال قم فاحكم بحكم الله","واحذر من الشك والاشتباه",14,"ه",1,0],["فقال قوم منهم قد ظلما","واعتديا الواجب إذ تقدما",14,"م",2,0],["فقال قد يجوز في المعقول","أن يقتدي الفاضل بالمفضول",14,"ل",1,0],["فقال قولاً خَطَلاً كُلُّه","عند الورى الحافي أو الناعِلِ",15,"ل",1,0],["فَقالَ قَتلت ما أَضحى حَراماً","سَأَجعَلُ عَنهُ قتلتَك الجَزاءا",16,"ا",3,0],["فقال قوم بهما","عقوبة عمَّا صدر",17,"ر",1,0],["فَقَالَ قَدْ صَيَّرْتُهُ عُدَّةً","فَقُلْتُ لاَ يُعْتَدُّ بِالْعَارِضِ",18,"ض",1,0],["فقال قول الخاطيء المهان","ما أحد عن ذلكم نهاني",19,"ي",1,0],["فَقالَ قَيس ناصِحاً يا عَبس","الحَق باد لَيسَ فيهِ لَبس",20,"س",1,0],["فقال قلت إذ أتى الالحان","يا شيخ لم ينطق بذا القرآن",21,"ن",1,0],["فقال قائلهم جِسْمٌ يلوح لنا","للعَيْن أَنّى وعنك الفِكْرُ مقصوراً",22,"ر",2,0],["فقال قائلهم دعواه قد عريتْ","عن الدليل وهذا عين معتقدي",23,"ي",1,0],["فقال قُرَّةُ العيونِ جُودُ","ومِنحَةٌ يمنحها المشهُودُ",24,"د",1,0],["فقال قد اهديت لي سوسنا","أغصانه مشبهة قدي",25,"د",2,0],["فقال قوم خيالٌ","لأهل فارسّ يُنمى",26,"م",2,0],["فقال قد انطفأت نارها","عن قال شعراً ولم يشعر",27,"ر",1,0],["فقال: قضى الحسن قبل الأوان","وقد كان من دهره في أمان",28,"ن",1,0],["فَقال قد اطلتهُ","قُلتُ ولكن ما العمل",29,"ل",1,0],["فَقالِ قم يُقطَعِ المساؤُ","ما بينَنا حيثُما السَمَر",30,"ر",1,0],["فقالَ قيسُ الظالِمُ المجهولُ","لم نَدرِيا حسينُ ما تقولُ",31,"ل",1,0],["فقال قد راحت إلى البستان","لما رأت أخا الفسوق كاذبا",32,"ب",2,0],["فقال قد أتلَفَتْ منكَ الفؤادَ أسىً","فقلتُ إن أتْلَفَتْهُ فهْو مثْواها",33,"ا",3,0],["فقال قد هِمْتَ منْ بعْد السُلوّ بها","فقلت لمْ تَثْنِني إلا ثَناياها",33,"ا",3,0],["فقالَ قدْ كانتِ الآدابُ عاطِلَةً","فقلْتُ هذا الذي بالسّحْرِ حَلّاها",33,"ا",3,0],["فقال قل في شعراً","اني أرى النظم شغلك",34,"ك",1,0],["فقال قروا عينا","ولا شكوتم أنيا",35,"ي",2,0],["فقال قرد كان قريباً","لا تنسيا سيديَّ لولا",36,"ل",2,0],["فقال قضى بالرغم من هاشم فتى","حليف المعالي من لوي بن غالب",37,"ب",1,0],["فقال قد عيل صبري وانتهى جلدي","فقال يكفيك من نفس أمانيها",38,"ي",3,0],["فقالْ: قد صَادفتْ غَاوي بِغَاوي","لكن على الفِطره وأَصل البداوه",39,"ا",3,0],["فقال قلبٌ وما أبديت من مقلي","ماذا عليَّ فما بالقول أنتهر",40,"ر",1,0],["فقال قوم دعوا مصرا فقد هرمت","وها هو الشيب باد في نواصيها",41,"ي",3,0]]}