{"poems":[[87,"راية الموت فوق هام العباد","https://www.aldiwan.net/poem7752.html","الخفيف"],[71,"قاض من السوق أتى","https://www.aldiwan.net/poem29148.html","مجزوء الرجز"],[52,"أنجزي يا سلامة الموعودا","https://www.aldiwan.net/poem63951.html","الخفيف"],[98,"إلى البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66354&r=&rc=30",""],[119,"شيخي أمام الاولياء النجبا","https://www.aldiwan.net/poem41227.html","عموديه"],[147,"هل للخليط المستقل إياب","https://www.aldiwan.net/poem11723.html","الكامل"],[164,"قل لمن الغز السؤال","https://www.aldiwan.net/poem59125.html","مجزوء الخفيف"],[189,"لو كان بالصبر الجميل ملاذه","https://www.aldiwan.net/poem14515.html","الكامل"],[202,"ألف ألا انعم بالمحبة حالا","https://www.aldiwan.net/poem51903.html","الكامل"],[285,"أعطى الشباب من الآراب ما طلبا","https://www.aldiwan.net/poem60775.html","البسيط"],[369,"صوت حمام الأيك عند الصباح","https://www.aldiwan.net/poem60968.html","السريع"],[398,"ألف أمير المؤمنين علي","https://www.aldiwan.net/poem53656.html","الكامل"],[409,"كل ما في الأكوان من آياتك","https://www.aldiwan.net/poem34100.html","الخفيف"],[505,"عرج بعيس القوم يا حاديها","https://www.aldiwan.net/poem37637.html","الكامل"],[563,"ذال الذهاب مقيد طلق الشذا","https://www.aldiwan.net/poem34560.html","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126756","الكامل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89537","البسيط"],[2259,"","https://poetry.dctabudhabi.ae/diwan/poem/144722","الخفيف"],[2274,"","https://poetry.dctabudhabi.ae/diwan/poem/144753","السريع"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132305","الكامل"],[2954,"","https://poetry.dctabudhabi.ae/diwan/poem/138925",""],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136869",""],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133137","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72887","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72504","الرمل"],[3464,"ألفٌ أمعاني من يذكرْ","https://www.poetsgate.com/ViewPoem.aspx?id=158742",""],[4797,"ذالليل كن نجومه شوي واشتات","https://www.poetsgate.com/ViewPoem.aspx?id=132228",""],[4984,"مر عهد","https://www.poetsgate.com/ViewPoem.aspx?id=215823",""],[5076,"قلمي يحاورني","https://www.poetsgate.com/ViewPoem.aspx?id=179336",""],[5121,"نَفْحَة","https://www.poetsgate.com/ViewPoem.aspx?id=215874",""],[5282,"لؤلؤةٌ... وحروف زمرد (٢)","https://www.poetsgate.com/ViewPoem.aspx?id=214080",""],[5397,"ما لهذا الدهر في الغي تمادى","https://www.poetsgate.com/ViewPoem.aspx?id=157914",""],[5755,"جنون الشك والغيره","https://www.poetsgate.com/ViewPoem.aspx?id=133413",""],[6142,"ها هو البرقُ مرودٌ من حديدِ","https://www.poetsgate.com/ViewPoem.aspx?id=155683",""]],"verses":[["ذا لهذا أب وجد إذا ول","لَى أبر الآباء والأجداد",0,"د",1,0],["ذا للوصايا ما يعي","كيفَ يعي في الأقضيهْ",1,"ه",1,0],["ذا لِسانٍ إِذا أَرَدتُ اِعتِذاراً","مِن هَواكُم وَجَدتُهُ مَصفودا",2,"د",2,0],["ذالك أو يهتك الظّلام دياجي","ه وينضو ذاك السّواد الكابي",3,"ب",2,0],["ذا لقب ممن رقى الى العلا","أعظم به شأنا سما ولقبا",4,"ا",1,0],["ذا لِلنَبِيِّ وَذا لِمُنتَجَبِ اِبنِهِ","رَدّا مَشيبَ الحَقِّ وَهوَ شَبابُ",5,"ب",1,0],["ذالك اسم لغادة","يفضح الغصن في الرمال",6,"ل",1,0],["ذالية ابن دريد استهوى بها","قوماً غداةَ نَبتْ به بغداذه",7,"ذ",2,0],["ذال ذؤابة من هويت زمرد","لو طاول المسك الأحم لطالا",8,"ل",2,0],["ذا لا كَمَنْ قَصَّرَتْ فِي الْمَجْدِ هِمَّتُهُ","فَباتَ يَسْتَبْعِدُ الْمَرْمى الَّذِي قَرُبا",9,"ب",2,0],["ذا لمُلوكِ العصرِ فيما أرى","نَهْبٌ وهذا للوجوهِ المِلاح",10,"ح",1,0],["ذالٌ ذُؤابَةُ مجدِهِ فَوق السُهى","راءٌ رَوِيُّ فخارِهِ علويُّ",11,"ي",1,0],["ذا لسان معبر عن فؤاد","مظهر للمراد من كلماتك",12,"ك",1,0],["ذُ المظهر السامي المؤيَّدِ أحمدٌ","شبل البتول حبيبها ببنيها",13,"ي",3,0],["ذالُ الذهابِ مقيِّدٌ طلْقَ الشذا","والنفع منه يزيل داهمة الأذى",14,"ذ",2,1],["ذا لِلعراقِ وذاك لليمن اِستوى","ملكاً فكان أَخاً له وظهيرا",15,"ر",2,0],["ذا للاشعار والعلوم لهذا","ولهذا تطريبنا والغناء",16,"ا",2,0],["ذا لِلمُقيمِ عَلى النَهجِ القَويمِ وَذا","لِكُلِّ باغٍ بِعَهدِ اللَهِ غَدّارِ",17,"ر",1,0],["ذا لهذا ريحانة مثل هذا","ك لهذا من طيب الريحان",18,"ن",1,0],["ذا لُؤلُؤِي ثغْرِه جِسْمُه","ولُؤْلُؤِيُّ الثَّوْبِ قلبي لَواهْ",19,"ا",2,0],["ذا للحواضرِ والبوادي ركائب","من بازلٍ أوجسرةٍ كوماءِ",20,"ا",2,0],["ذالهم يقلبونها الزاي في النطق","كأنهم فوارس الفارسيه",21,"ي",2,0],["ذا لعينيك يا ذي له بنايه وبنه","يالذي زعفرانه ما يشبه بالشنه",22,"ن",2,0],["ذا ليس بالشكوى ولكن عادةٌ","يسلي العليلي تنفس الصعداء",23,"ا",2,0],["ذا للسيوطيَ درٌّ صار منتظما","في سلك ملك شريف دأبه الكرم",24,"م",1,1],["ذا لسان وجنان كان بالذ","كر مشغولا وبالفكر ملي",25,"ل",2,0],["ذالٌ ذو الهمة صاحبها","نوب الأيام به تقهر",26,"ر",1,0],["ذالليل لبسه صمت وفراشه سكات","كنه يشجعني لجر المواويل",27,"ل",1,0],["ذال عهد مضى وعادت عهود","لم يدم وضعها على أي حال",28,"ل",1,0],["ذا لذا خصمٌ لدودٌ إرثُهُ","منكَ في تأجيج تاريخ ِ الاممْ",29,"م",1,0],["ذَا لَحْنُ قَلْبِي عَلَى مَرْجٍ بِخَفْقَتِهِ","غَنَّتْ شُجُونِي وَرَوْضِ الرُّوحِ فِي النّسَقِ",30,"ق",1,0],["ذَالٌ لقومٍ قد مَضَوا نَحوَ الذكاءْ","واحذرْ ذُنوباً مُهلكاتٍ للثَناءْ",31,"ا",2,0],["ذا لحد السيف أعطى نحره","كرما منه وذا بالنفس جادا",32,"د",2,0],["ذالشعر يغريك مير يخون تعبيره","حتى كلام الغزل ما هوب متهادي",33,"د",2,0],["ذا لهذا معبرٌ وسميعٌ","منه فالمستفيدُ عين المفيد",34,"د",1,0]]}