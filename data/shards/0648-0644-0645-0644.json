[5567,"شغف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81761&r=&rc=29",""]],"verses":[["وَلِم لا وَنَحنُ الراجِعانِ مِنَ العُلى","إِلى المَغرَسِ الرَيّانِ وَالسُؤدُدِ الرَغدِ",0,"د",1,0],["وَلِم لا يَضيفُ العُلا مَن لَهُ","غَديرٌ مَعينٌ وَمَرعىً خَصيبُ",1,"ب",1,0],["وَلِم لاَ يَنَالُ السؤُلَ عِنْدَكَ قَاصِدٌ","وَمِثْلُكَ مَنْ لمْ يُخْطِ قَاصِدَهُ غُنْمُ",2,"م",1,0],["وَلِمْ لاَ وَقَدْ حَلَّ الرِّكَابُ بِيَثْرِبٍ","وَبُؤْتُ بِشَحْطِ الدَّارِ مِنْهَا عَلَى رَغْمِ",3,"م",1,0],["وَلِمِلَّةٍ جُنَّتْ فَلَوْ لَمْ تُنْتَدَبْ","لَمْ يُلْفَ مَنْ يُرْقَى وَلاَ مَنْ يَتْفُلُ",4,"ل",1,0],["وَلِمُلْكِكَ الْعُقْبَى وَحَسْبُكَ نَاصِراً","أَن الإلاَْهَ عَدُوُّ مَنْ عَادَاكَا",5,"ك",2,0],["ولم لا وقدْ أحْيا بكَ اللهُ سُنّةً","نُهَلِّلُ في أعْيادِها ونُكَبِّرُ",6,"ر",1,0],["ولِمْ لا ولي قَلْبٌ لبُعْدِكَ خافِقٌ","وجَفْنٌ على حُكْمِ الدّموعِ جَريحُ",7,"ح",1,1],["ولم لم يكن إلا سنينَ قطعتها","رهينَ شكاة لا تزال تعانيها",8,"ي",3,0],["ولم لا ومن نعماه للفكر باعث","على أدبٍ ما مات إلا ليبعثه",9,"ث",2,0],["ولم لا وقد أحييت ذاك تهجّداً","وكم كثرت هاتيك أوصافك الغرّ",10,"ر",1,0],["ولم لا وقد أبصرته متحرّقاً","بفرقة حبّ راحلٍ ليسَ يرجع",11,"ع",1,0],["ولم لم يَسِرْ وافاهُ لا شك طِلْبُه","بغير عناءٍ بادئاً ثم عَقَّبا",12,"ب",2,0],["وَلِمْ لا ولو أُلقيتُ فيه وصخرةً","لوافيت منه القعرَ أوّلَ راسبِ",13,"ب",1,0],["ولمْ لا وهْيَ زَلزلةٌ ولكنْ","بركب الماء لا ركبِ السُّهوبِ",14,"ب",1,0],["ولِمْ لا يُبكِّي من يبيت كأنَّه","سَليمُ أفاعٍ أو سليمُ أساودِ",15,"د",1,0],["ولِمْ لا وخنزير مهينٌ يُهينني","فيُغضِي على لؤمٍ وأُغضي على قَسْر",16,"ر",1,0],["ولمْ لا ولم أقرأه إلا تكشّفتْ","غواشي هُمومي وانتشيتُ بلا خمر",17,"ر",1,0],["ولمْ لا وأثمانُ المعالي لديكُمُ","رِغابُ العطايا والنفوسُ النفائس",18,"س",1,0],["ولمْ لا تَعيرُ ولم تضربُوا","عليها حجابَ بني دَنقَشِ",19,"ش",1,0],["ولمْ لا وفيكم كل فارس بُهمة","يغادر فرسانَ الوغى بالمداحص",20,"ص",1,0],["ولمْ لا وفي الآتي أخو العيش يُجتوَى","وفي الزمن الماضي أخو العيش يُرتَضى",21,"ض",2,0],["ولمْ لَمْ تُخيِّب ظن من قال خائبٌ","وهزَّ لظنّي فيك رأساً وأنغضا",21,"ض",2,0],["ولم لا وقد جرَّأتَ كل مُضاغنٍ","عليَّ فأضحى سيفُه ليَ مُنتضى",21,"ض",2,0],["ولم لا يريع لزرَّاعه","كريمٌ أُثيرَ ومدحٌ زُرِع",22,"ع",1,0],["ولِمْ لا وأنت رحيب الفناء","بِحُرٍّ يُنيخ إليك المُكلُّ",23,"ل",1,0],["ولِمْ لا واعتقادُك في فؤادي","مُساكنُ مهجتي أخرى الليالي",24,"ل",2,0],["ولِمْ لا وقد ألجأتَ ملتمِسَ الجدا","إلى الطلب المذموم والخُلْق والوَغلِ",25,"ل",1,0],["ولمْ لا يُجلُّ امرؤٌ نفسه","وأنت ترى فيه رأياً جميلا",26,"ل",2,0],["ولِمْ لا وقد أصبحتَ للمُلك مِدْرَهاً","وللمجد سُرسُوراً وللدّين مَعْلَمَا",27,"م",2,0],["ولِمْ لا وقد صُوِّرتَ من خير طينةٍ","وأنت بفضلِ الحلم والجودِ عالمُ",28,"م",1,0],["ولِمْ لا وقد أوضحتما لي طريقتي","فأضحى هُداها مُفصِحاً لا يكاتمُ",28,"م",1,0],["ولِمْ لا وقد ألغيتَ شأْني مُخسِّساً","بذلك قَدْرِي مُسْتَخِفّاً به وزني",29,"ن",2,0],["ولم لا وجدَّته نملة","إذا وقفت أو مشت حصَّلت",30,"ت",1,1],["وَلِم لا يَقي الرَحمَنُ حَدَّيكَ ما وَقى","وَتَفليقُهُ هامَ العِدا بِكَ دائِمُ",31,"م",1,0],["ولم لا أصابُ وحربُ البسو","سِ بينَ جفوني وبينَ الوسَن",32,"ن",1,0],["وَلِم لا أُغالي بِالضِياعِ وَقَد دَنا","عَلَيَّ مَداها وَاِستَقامَ اِعوِجاجُها",33,"ج",3,0],["وَلِم لا يُرى ثانيكَ في السُلطَةِ الَّتي","خُصِصتَ بِها ثانيكَ في الجودِ وَالنَدى",34,"د",2,0],["وَلِم لَم يَثُب فيكَ مِن ذَنبِهِ","فَيَأكُلكَ مُحتَسِباً مَن خَريكا",35,"ك",2,0],["وَلِم لا وَقَد حازَت مِنَ الفَضلِ جُملَةً","يُقَصِّرُ عَن أَوصافِها كُلُّ شاعِرِ",36,"ر",1,0],["وَلِم لا وَحِكمَةُ لُقمانَ فيكَ","وَهَيبَةُ كِسرى قَدِ اِستُكمِلا",37,"ل",2,0],["وَلِمْ لا وَآسادُ العرِينِ لِداتُهُ","يَكُونُ له مثلُ الأسودِ زَئيرُ",38,"ر",1,0],["ولملكك العقبى وحسبك ناصرا","إن الإله عدو من عاداكا",39,"ك",2,0],["ولم لا يسيل الشعرُ لُطفاً ورقةً","إذا كان من فَيض القريحة يستقي",40,"ق",2,0],["ولِمْ لا تريع بأريافها","بلاد تسيل بماء مريع ؟",41,"ع",1,0],["ولم لا وأنت السيد السند الذي","عن المصطفى معنى شهدنا به رسما",42,"م",2,0],["وَلِم لا يَذوبُ الشَمعُ وَالنارُ في الشَمعِ","فَيا لِفؤادٍ عزَّ وَجهُ اِصطِبارِهِ",43,"ه",1,0],["وَلِم لا وَقَد حَبّاهُ بالحِفظِ رَبُّهُ","فَلَم تَطغَ عَيناهُ وَلا زاغَ قَلبُهُ",44,"ه",1,0],["ولم لا تزدهي كبراً وتيها","وقد ظهرت وزال الاتساخ",45,"خ",1,0],["ولم لا يترك السوء الأماني","أظل بها وامسي استعين",46,"ن",1,0],["ولِمْ لا تَهَبُ الأَلْفَ","إذا لم تَدْرِ ما العَشْرا",47,"ر",2,0],["ولِمْ لا تُكرِم العبدَ","إذا لم تعرفِ الحُرَّا",47,"ر",2,0],["ولِمْ لا أجُرّ الذَيْل في ساحة الصِبَا","وشَرْخُ شبابي قائمٌ لي بالعذر",48,"ر",1,0],["ولم لا وقد فازت بأكرم نازلٍ","وأعذب بحرٍ بالفضائل طافح",49,"ح",1,0],["وَلِمْ لا وَذكْرُكَ يَرْمِي الْقُلُوبَ","بِأَنْفَذَ مِنْ صائِباتِ السِّهامِ",50,"م",1,0],["وَلِم لا تَكون عَبيداً لِمَن","مَتى اِفتَخَرَت بِالمَعالي شَآها",51,"ا",3,0],["وَلِم لا يُسَرُّ بِهِ المُسلِمونَ","وَقَد صانَ أَموالَهُم وَالحُرَم",52,"م",1,0],["وَلِم لا يُرى ثَغرُهُ كَالحَباب","وَمن فيهِ فيهِ يَمُجُّ المُدامَه",53,"م",2,0],["وَلم لا وَالّذي فيها مليكٌ","تَرى فيه حُلى ملكٍ بأنسِ",54,"س",1,0],["وَلِم لا وَالحضارةُ ملء عصرٍ","جَلاه وَباع مُنشئه المديدُ",55,"د",1,0],["وَلم لا وَقد شاهَت وجوه وَأنقضت","ظُهورٌ وَلَولا بِالنفوس مُرودها",56,"د",3,0],["وَلِم لا أَبذُلُ الإِنصافَ مِنّي","وَأَبلُغُ طاقَتي في الإِنتِصافِ",57,"ف",1,0],["وَلِمْ لا والخَلِيلُ غُلامُ يَحْيى","يُعَاني ذا وَيُرْغِمُ مَنْ يُعَانِدْ",58,"د",1,0],["وَلِم لُمتُمُ الأَبصارَ فيما أَتَت بِهِ","فَإِنّا دَفَعنا عَن قُلوبٍ بِأَبصارِ",59,"ر",1,0],["ولِمْ لا تذلُّ النّائباتُ لِمَنْ أَوَى","إلى خَير منّاعٍ وخير مُحامي",60,"م",2,0],["ولِمْ لا وفي لا في بطن السجون أحبة","لديهم فؤادي في السجون مصاب",61,"ب",1,0],["ولِمْ لا يرتقي دَرَج المعالي","بما يُعطاه من شيمٍ وخِيم",62,"م",1,0],["ولِم لا ينال العُلى ماجد","يمدُّ إلى المجد باعاً طويلا",63,"ل",2,0],["ولِمَ لا اتَّبعت كلام النصوح","وكفكفت دمعك لما جرى",64,"ا",1,0],["ولم لَمْ نكُنْ فِي حمدِكم كَيْفَ شئتُمُ","لكنتُمْ لَنَا فِي الصَّفْحِ عنَّا كَمَا شِينا",65,"ن",2,0],["ولمْ لا يغالطُني في الحسا","ب من عنده أنّ ربّاً نَجَلْ",66,"ل",1,0],["ولم لم تكن لله فيه سريرةٌ","لما راح م نجور الرزايا ممنَّعا",67,"ع",2,0],["ولم لا والصلاح يفوح منهم","ومهما عاهدوا بالعهد يوفوا",68,"ف",3,0],["وَلِمَ لا يَستَحِقُّ الدَهرُ ذَمّاً","يُصَيِّرُ حُرَّ وَجهَ الحَرِّ أَرضا",69,"ض",2,0],["ولم لا وشمك قد سطعت","وألبسك اللّه تاج الوطن",70,"ن",1,0],["ولمْ لا وهو من مَلأَ البَرايا","هُدًى وبه اسْتَنارَ المَشْرِقَانِ",71,"ن",1,0],["ولم لم أجد رمداً إذ نأيت","دعوت عليها بأن ترمدا",72,"د",2,0],["ولم لا وفيك البأس والدين والندى","وفضلك لا يحصى بحصر ولا عد",73,"د",1,0],["ولم لا نبكيه ونندب فقده","وأولاده أيتامه وأرامله",74,"ل",2,0],["ولمْ لا أتِيهُ وأنت الّذي","تَنَخّلَنِي خِبرةً واِصطفاني",75,"ن",2,0],["ولِمْ لا يَحِنّ إلى المخصبا","ت مَن كان في البلد الماحِلِ",76,"ل",1,0],["ولِمْ لا أقيك السّوءَ يوماً وطالما","وقيتَ من الأمر الذُّعاف مَذوقُهُ",77,"ق",2,0],["وَلِمْ لا وأنتَ اِمرؤٌ في الصِّعابِ","إِلى رَأيهِ أبداً نَرْجعُ",78,"ع",1,0],["وَلِمْ لا أَصول وقد صار لي","شعار إمام البرايا شعارا",79,"ر",2,0],["ولِمْ لا يتيهُ زمانٌ رآ","ك فضلاً لأيّامه وَاِفتِخارا",80,"ر",2,0],["ولِمْ لا وما كتبوا زلّةً","عليه وأيُّ اِمرئٍ ما هَفا",81,"ا",1,0],["ولِمْ لا نَقَلْتَ إِليّ السَّقامَ","ويُنْقَلُ عنِّي إِليكَ الشَّفاءُ",82,"ا",2,0],["وَلِمْ لا يَصِحُّ الوَجْدُ فِيكَ ونَاظِري","لِنَسْخَةِ حُسْنٍ مِنْ سَناكَ يُقَابِلُ",83,"ل",1,0],["وَلِمَ لا نُرَجّي كُلِّ فَوزٍ وَما لَنا","سِوى الفَضلِ في جَنبِ الزَمانِ جَرائِمُ",84,"م",1,0],["ولِم لا وَإِنّ الغَدر لَما تمرّدت","شياطينُه وَاِشتدّ بَأس المقاوم",85,"م",1,0],["وَلِم لا وَإِبراهيم بِالفَضل قَد غَدا","رَئيساً لَها في مصر وَاِنتَظَم الحال",86,"ل",1,0],["ولِمْ لا وقد أبْهجتَ عيني بقطعةٍ","هي الروضةُ الغنّاء أطيارُها تشدو",87,"د",2,0],["ولِمْ لاَ وقد أَصْفيتُم لِي طويَّةً","تجلَّتْ لأَربابِ البصائِر والنّظرْ",88,"ر",1,0],["ولم لا وقد درست سوقه","كاطلال اربابه الاقدمينا",89,"ن",2,0],["ولم لا وأنت جمال الرجال","جمال الزمان جمال المعال",90,"ل",1,0],["ولم لا وانت ابن الذي امتد ذكره","إلى غابة من افقها النجم ينجم",91,"م",1,0],["وَلم لا وَهوَ أَنشأنا اِمتِناناً","وَواعِدنا عَلى الحُسنى المَثابا",92,"ب",2,0],["ولِم لا والربيعُ زمانُ بسطٍ","ففيهِ تَكسبُ الأرواحُ أنسا",93,"س",2,0],["ولِمْ لا تسيل العين أو يضرم الحشى","وقد أزمعت للدوح بيض العقائلِ",94,"ل",1,0],["ولمْ لَم تجب أفكارنا من خِبائها","وباعث أنفاسُ الربيع دَعاها",95,"ا",3,0],["ولم لم تكن أجياد أفهامنا إذاً","ملاحاً وأوقات الربيع حُلاها",95,"ا",3,0],["وَلِم لا وَيَنمِيهِ إِلى المَجدِ وَالِدٌ","هُمامٌ بِسَومِ المَكرُمَاتِ مُغالِي",96,"ل",2,0],["ولم لا أنتحيه بسائرات","من الأمثال معوزة المثالِ",97,"ل",1,0],["ولم لا يشعرون بحب صب","يهام شعره في كل وادي",98,"د",2,0],["ولم لا أوقى كل هول ومدحه","مدامي نقلي وادكاري ومؤنسي",99,"س",2,0],["وَلِمْ لاَ وَقَدْ مُدَّتْ أشعَّةُ وَجْهه","بِوَاضِحِ مَوْلاَنَا السَّنِيّ بَهَاؤُهُ",100,"ا",3,0],["ولم لا وقد حازوا بصحبته علا","وفخرا وتعظيما وفضلا متمما",101,"م",2,0],["ولم لا وفيه حل من حل مرتقى","وأنارت به الأكوان في ليلة الإسرا",102,"ر",2,0],["ولم لا وقد سادوا بصحبة من علا","على الرفرف العالي السعيد الطوالع",103,"ع",1,0],["ولم لا وقد حياك في الفتح والضحى","وفي نون والإسر بآي بوارع",103,"ع",1,0],["ولِمْ لا يجوز الأَرض شرقاً ومَغرِباً","ولله في إِعلاء رُتْبته سِرُّ",104,"ر",1,0],["ولم لا نقول اليومَ في العصر إنه","فريدٌ تجلّى في أجلّ المراتب",105,"ب",1,0],["ولم لا وأنتم كل خير لقد بدا","لاجلكم والوصل منكم غنيمتي",106,"ي",1,0],["ولملكٍ أمد في العمر والرز","ق ومدت من ملكه أطنابه",107,"ب",2,0],["ولم لا ولولاهم تلاشت جميعها","ولم يبق منها في الوجود لها سما",108,"م",2,0],["وَلِمُلْكِهِ العُلَمَاءُ صَارُوا شِيعَةً","كَالمَاكِنِي العَالِمِ الرَّقَّاصِ",109,"ص",1,0],["ولم لا يكونُ ونحن اليدا","نِ أنت بفضلك منها اليمينُ",110,"ن",1,0],["وَلِم لا أَشتَكي بَثّي وَحُزني","إِلى مَن لا يَصَمُّ عَنِ النِداءِ",111,"ا",2,0],["ولم لم تكن قد أحكمَت صنعَ نفسها","لما وليت في الطولِ والعرضِ والجسَم",112,"م",1,0],["ولم لا وقد أسلفت كل بديعة","من الفضل قد خطت على صفحة البدر",113,"ر",1,0],["ولم لا وقد أسلفت وداً وخدمة","يكران في ليل الخطايا فيصبح",114,"ح",1,0],["ولم لا يرى وردها يانعاً","وقد سال من فوقها العارض",115,"ض",1,0],["ولم لا وفيهم أحمدُ المصطفى الذي","حوى كلَّ أصلٍ في المحاسن أو فَرعِ",116,"ع",1,0],["ولم لا وقومي بالنجابة في الورى","لقد عرفوا والفخر من كأسهم يحسو",117,"س",2,0],["وَلِمْ لا أملأ الآفاق شكراً","لما أسبغت من نعم جسام",118,"م",1,0],["ولم لا أكن فيها خليعا وانها","هدية من فى المجد أطول باعا",119,"ع",2,0],["ولِم لا وشمسُ الملك والمجد والهُدى","وفَتَّاح أبواب النَّدى والتكرُّم",120,"م",1,0],["وَلمْ لا أُوالي تغلب ابنةِ وائل","متى شئتُ أندى مَرْتعٍ وظِلالِ",121,"ل",1,0],["ولم لم يفدني الدهر الاك صاحباً","كفاني ان قد كنت خيرة اخواني",122,"ن",2,0],["وَلِم لا يُهِينَنَّ العَظائِمَ سَيِّدٌ","كرِيمٌ نماهُ أَكرَمٌ بَعدَ أَكرَمِ",123,"م",1,0],["وَلِم لا وَلي نَفسٌ إِليك نُزوعها","وَبِرُّكَ لي وافٍ وِودُّكَ خالِصُ",124,"ص",1,0],["ولم لا ورب العرش ذاك خليفة","من الله مذ وله قد عاهد العذرا",125,"ر",2,0],["ولِمْ لا تَرى نَبْتَ المدائح نامياً","وكَفُّكَ غَيْثٌ والرّياض الأَفاضل",126,"ل",1,0],["ولم لم يكن مسكا لما كان ريّهُ","غزالا وفي سُود اللّواحظ هنده",127,"د",2,0],["ولم لم أرثه والعلم منه","إلى ركن شديد كان ياوي",128,"ا",3,0],["وَلِم لا وِمِن أَعطافِها وَجُفُونِها","تُهَزّ العَوالي أَو تُسَلُّ القَواضِبُ",129,"ب",1,0],["وَلِمْ لاَ يَذْوبُ العَاشِقُونَ صَبَابَةً","وَوَجْداً وسُلْطَانُ المِلاَحِ لَهُمْ حِبُّ",130,"ب",1,0],["ولم لا يحوز العهد طفلا وقد حوى","رضا الله من ولاه والده طفلا",131,"ل",2,0],["ولم لا منك تغتاظ الأعادي","وهم جِيَفٌ وشمّوا منك ندا",132,"د",2,0],["ولم لا يثور العرب ضد طغاتهم","إذا كان صمت الحر يغري به النذلا",133,"ل",2,0],["ولِمْ لا تُذادُ الآن يا ملِكَ الهُدَى","بسيْفِكَ عن غابِ الأسودِ ذِئابُها",134,"ب",3,0],["ولِمْ لا وقد جاءتْ بأيْمَن صِحّةٍ","يصحُّ بها عمّا يَريبُ اجتِنابُها",134,"ب",3,0],["ولمْ لا يَروقُ السّامعينَ حديثُها","ومنظومُها في عُقْدةِ السّحْرِ نافِثُ",135,"ث",1,0],["ولمْ لا ومن جدْواكَ صوْبُ غَمامةٍ","منَ البِشْرِ تُزْجيها بُروقٌ حَثاحِثُ",135,"ث",1,0],["ولمْ لا وقد وافتْ علامَتُك التي","لها الحُسْنُ في شفعِ الزّيادةِ بالحُسْنى",136,"ن",2,0],["ولمُلْككَ الأعلى مَواهِبُ رحْمَةٍ","ومَكارِمٌ لا تَقْتَضي إهْمالَها",137,"ل",3,0],["ولِمْ لا تُصيبُ وقدْ فوّقَتْها","يَدُ اليوسُفيّ إمامِ الهُدَى",138,"د",2,0],["ولِمْ لا ومِن آثارِكَ الغُرّ أنجُمٌ","ثَوابتُ لا يُخْشى عليْها أُفولُها",139,"ل",3,0],["ولمْ لا تُباهي أفْقَهُ ونجومَهُ","قلائِدُ في لبّاتِها ومناطِقُ",140,"ق",1,0],["وَلِمِلَّةِ الإِسلامِ خَمسُ عَقائِدٍ","وَاللَهُ أَنطَقَني بِها وَهَداني",141,"ن",2,0],["ولم لم ينزه سمعه عن مقالة","بها كم أتاني كاشح وعذول",142,"ل",1,0],["ولم لا وهم في نصر من سبح الحصى","بكفيه والأشجار جاءت له حبوا",143,"و",2,0],["ولم لا وهم من صفوة العلوية ال","أولى لهم بالسبق تعترف الآل",144,"ل",1,0],["ولم لا وعنهم أذهب الرجس ربهم","وطرهم والذكر في ذاك يقنع",145,"ع",1,0],["وَلَم لا مَقيلي لا يَطيبُ وَمَسمَري","وَطَلعَتُهُ الإِصباحُ وَاللَيلُ فاحِمُه",146,"م",2,0],["ولم لا يستضاء بجانبها","وبين ضلوعها بدر التمامِ",147,"م",1,0],["وَلَم لا وَمِن وَشاهُ حِبرُ مُهَذَّب","اِمامٌ لَهُ في الفَضلِ أَعلى المَراتِب",148,"ب",1,0],["وَلِمْ لا تُناكرُني عينُه","وقد علمت كيف إِقرار عيْني",149,"ن",2,0],["وَلِمْ لا تُحيطُ بآفاقِها","وفي يَدِك الصّامِتً القاتلُ",150,"ل",1,0],["وَلِم لا وَقَد ناطَ المُعَظَّمُ بابنِها","وَبابنِ أَياديهِ وِزارَتَهُ الكُبرى",151,"ر",2,0],["وَلِم لا وَهيَ تَجمَعُ كُلَّ حُسنٍ","وَفيها أَلسُنُ الشعَراء كَلَّت",152,"ت",1,0],["وَلِم لا وَفي فَقدِ الأَحِبَّةِ واعِظٌ","لشمَن كانَ ذا قَلبٍ وَمَن كانَ ذا أُذنِ",153,"ن",1,0],["ولم لا وهو حلف للمعالي","ومولى كل احسان وبر",154,"ر",1,0],["ولمْ لا وأنت الماجد السيّد الذي","له مننٌ لم تستطع حملها المننْ",155,"ن",1,0],["ولملم باقي اهدومه ، وداعبني بأنظاره","بعدها غاب عن عيني وروحي تنتحب تشتاق",156,"ق",1,0],["ولملمِ القلبَ أشلاءً مُبعثرةً","فهي الوقودُ اِذا ما الخطْبُ يحتطبُ",157,"ب",1,0],["ولِمْ لا تَحفَظِ المعروف دهراً","وتشْكُرُ مَن سقاكَ مِنَ الزُّلال ؟",158,"ل",1,0],["ولِم لا يا صهيبُ , وأنت شبلٌ","لنصرٍ صانعِ المجد التّليد ؟",159,"د",1,0],["ولمْ لا والتفكّر فرض عينٍ","على ذي اللبّ، دمت له أميرهْ",160,"ر",2,0],["ولم لا تحيط بآفاقها","وفي يدك الصامت القائل",161,"ل",1,0],["ولملموا يا عراقيين َ وحدتكم","فقد تفاقم فينا الخِزْي ُ والفشل ُ",162,"ل",1,0],["ولم لا وأحبابي وسلوة خاطري","سيمنعني عن وصلهم فدفد وعر",163,"ر",1,0],["ولملمِ الوجعَ المسفوحَ من ضجري","واتركْ جهالتَه تقتاتُ مِنسَأتي",164,"ت",2,0],["ولم لا ونيران القرى في ذراهم","تنادي إلى ناديهم العجم والعربا",165,"ب",2,0],["ولملمتُ الصّباحَ بوجهِ أمّي","فلمّا جاءَ أرهقَني غيابَا",166,"ب",2,0],["وَلَملِمْ بَقايا الصَّبْرِ عِنْدَ لِقائِنا","وَكَسَّرْ قَوانيني لتدركَ شهقا",167,"ق",2,0],["ولمْ لا يكونُ الشعرُ سهلا وإنني","أقابلُ وجهًا لمْ يفارقْ جَمالَهُ",168,"ل",2,0],["ولِمْ لا ولولاه لمَا قالَ أبيضٌ","ولا أسْودٌ في هذه الأرض \"أشهد\"",169,"د",1,0],["ولمْ لا وهذا العشقُ في كل لحظةٍ","يصبُّ عليَّ ما يُشيبُ ويُهرمُ",170,"م",1,0],["ولملمَ ليلُنا خبزَ الحَكايا","من الطرقاتِ واستلقى يغني",171,"ن",2,1],["ولَمْلَمَ الشَّرْقُ جُرْحًا كُنْتُ أحْسَبُهُ","قَد ارْعَوَى بِهِ عَنْ غَيٍّ وعَنْ نِقَمِ",172,"م",1,0],["ولم لا تهيم الخلق طرا هوى به","ودارين عن أخلاقه المسك ترويه",173,"ي",2,0],["ولم لا يهيمُ القلب منه صبابةَ","ويصبح عقدُ الدَّمع منّي مُبدّدا",174,"د",2,0],["ولملمَ الليلَ حتى طالَ لِمّتَهُ","وخصَّ منه لرمشِ العين فاكتحَلا",175,"ل",2,0],["ولم لا تعذب الأخلاق منه","وكان ابن الفرات هوى وماء",176,"ا",2,0],["ولم لا وهم صفوة العلوية الأولى","لهم بالسبق تعترف الآل",177,"ل",1,0],["ولملمَ ذاتنا حجرًا عنيدًا","وتاريخًا ومئذنة وهاما",178,"م",2,0],["وَلَمْلِمِينِي ، وَضُمِّي شِقْوَتِي فَلَقَدْ","تَبَعْثَرَتْ فِي مَهَبِّ الرِّيحِ أَشَيَائِي !!",179,"ا",3,0],["ولِمْ لا؟ وما كتبوا زلّة ً","عليهِ وأى ُّ امرىء ٍ ما هفا؟",180,"ا",1,0],["ولملمي ما نسينا في الجهاتِ هوىً","إنْ أسرفَ التيهُ في أضلاعنا طينا",181,"ن",2,0]]}