{"poems":[[53,"عجبت من الأيام إنجازها وعدي","https://www.aldiwan.net/poem30624.html","الطويل"],[53,"طلوع هداه إلينا المغيب","https://www.aldiwan.net/poem30758.html","المتقارب"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[77,"إذا أنا لم أوثر هواي على عزمي","https://www.aldiwan.net/poem36126.html","الطويل"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[77,"باتت نجوم الأفق دون علاكا","https://www.aldiwan.net/poem36385.html","الكامل"],[77,"برابعة الساعات جئت أخبر","https://www.aldiwan.net/poem36505.html","الطويل"],[77,"ولم لا ولي قلب لبعدك خافق","https://www.aldiwan.net/poem36638.html","الطويل"],[83,"سلام على الدنيا جميعا وما فيها","https://www.aldiwan.net/poem54233.html","الطويل"],[72,"ووارثة الألحاظ من حدق المها","https://www.aldiwan.net/poem18449.html","الطويل"],[72,"سقاك وحياك الحيا أيها القبر","https://www.aldiwan.net/poem18739.html","الطويل"],[72,"أذات الحجى إن الحجاب ليمنع","https://www.aldiwan.net/poem19171.html","الطويل"],[51,"رأيت الذي يسعى ليدرك حظه","https://www.aldiwan.net/poem8164.html","الطويل"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"أسالم قد سلمت من العيوب","https://www.aldiwan.net/poem8313.html","الوافر"],[51,"أخالد لا تكذب فلست بخالد","https://www.aldiwan.net/poem61873.html","الطويل"],[51,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[51,"قرأت على أهلي كتابك إذا أتى","https://www.aldiwan.net/poem62922.html","الطويل"],[51,"ألم تسأل اليوم الظباء الكوانس","https://www.aldiwan.net/poem64666.html","الطويل"],[51,"ألا قل لنحويك الأخفش","https://www.aldiwan.net/poem64923.html","المتقارب"],[51,"رمين فؤادي من عيون الوصاوص","https://www.aldiwan.net/poem64935.html","الطويل"],[51,"يبتُ أخو البلوى إذا الخلو غمضا","https://www.aldiwan.net/poem64946.html","الطويل"],[51,"ألا ليس شيبك بالمتزع","https://www.aldiwan.net/poem65398.html","المتقارب"],[51,"أيا من له الشرف المستقل","https://www.aldiwan.net/poem65882.html","المتقارب"],[51,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[51,"إذا أنت أزمعت الصنيعة مرة","https://www.aldiwan.net/poem65931.html","الطويل"],[51,"أبدر السماء وغيث السماء","https://www.aldiwan.net/poem66000.html","المتقارب"],[51,"ليهنك أن أفطرت لا متطلعا","https://www.aldiwan.net/poem66008.html","الطويل"],[51,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[51,"ألا أيها الموسوم باسم وكنية","https://www.aldiwan.net/poem66404.html","الطويل"],[85,"ولم لا وجدته نملة","https://www.aldiwan.net/poem6960.html","المتقارب"],[43,"على قدر أهل العزم تأتي العزائم","https://www.aldiwan.net/poem10524.html","الطويل"],[43,"أتظعن يا قلب مع من ظعن","https://www.aldiwan.net/poem10615.html","المتقارب"],[45,"سفاها تمادى لومها ولجاجها","https://www.aldiwan.net/poem62680.html","الطويل"],[45,"أجرني من الواشي الذي جار واعتدى","https://www.aldiwan.net/poem63484.html","الطويل"],[45,"أتاني كتابك ذاك الذي","https://www.aldiwan.net/poem65225.html","المتقارب"],[81,"إليكم يحن القلب في كل ساعة","https://www.aldiwan.net/poem61381.html","الطويل"],[81,"ولما تبرج خضر البطاح","https://www.aldiwan.net/poem61438.html","المتقارب"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[77,"باتت نجوم الأفق دون علاكا","https://www.poetsgate.com/ViewPoem.aspx?id=34151",""],[90,"الملك حسين","https://www.poetsgate.com/ViewPoem.aspx?id=179040",""],[90,"على كرند","https://www.poetsgate.com/ViewPoem.aspx?id=179017",""],[113,"كشفت حجاب الطمس عن حيطة الأسما","https://www.aldiwan.net/poem41777.html","الطويل"],[148,"ألا فاخش سهم الموت عن كل مرصد","https://www.aldiwan.net/poem68588.html","الطويل"],[148,"أروح على ذكر النبي وأغتدي","https://www.aldiwan.net/poem68602.html","الطويل"],[158,"سماط ما أراه أم مناخ","https://www.aldiwan.net/poem58912.html","الوافر"],[158,"بجود يديك أورقت الغصون","https://www.aldiwan.net/poem59070.html","الوافر"],[227,"إذا لم تعرف الخيرا","https://www.aldiwan.net/poem51010.html","الهزج"],[227,"إذا رحت من سكر غدوت إلى سكر","https://www.aldiwan.net/poem51033.html","الطويل"],[257,"خذا حيث أمت عاديات السوانح","https://www.aldiwan.net/poem35736.html","الطويل"],[278,"بكيتك للبين قبل الحمام","https://www.aldiwan.net/poem60765.html","المتقارب"],[280,"دعا مهجة الصب لا تردعاها","https://www.aldiwan.net/poem32310.html","المتقارب"],[280,"سقت بنت كرمة بنت الكرم","https://www.aldiwan.net/poem32455.html","المتقارب"],[280,"دع الأثلات وآرام رامه","https://www.aldiwan.net/poem32456.html","المتقارب"],[303,"خميس اليمن توج عام خمس","https://www.aldiwan.net/poem56507.html","الوافر"],[303,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[303,"سما للعلى يقظان عين حديدها","https://www.aldiwan.net/poem56578.html","الطويل"],[307,"أأقصد بالملامة قصد غيري","https://www.aldiwan.net/poem50276.html","الوافر"],[346,"برغمي إن خلت منه المذاود","https://www.aldiwan.net/poem20065.html","الوافر"],[364,"ملامكم والحب ضعفان من نار","https://www.aldiwan.net/poem17007.html","الطويل"],[399,"تنبه حظي بعد طول منام","https://www.aldiwan.net/poem46935.html","الطويل"],[400,"أتى من أسير للغريب خطاب","https://www.aldiwan.net/poem34154.html","الطويل"],[413,"جلا في الكأس جالية الهموم","https://www.aldiwan.net/poem54058.html","الوافر"],[413,"فؤاد كطرفك أمسى عليلا","https://www.aldiwan.net/poem54167.html","المتقارب"],[413,"أعادك يا سعد عيد الهوى","https://www.aldiwan.net/poem54181.html","المتقارب"],[436,"ليهن لك العيد الذي بك يهنينا","https://www.aldiwan.net/poem34859.html","الطويل"],[456,"إذا عارض نحو أرض عدل","https://www.aldiwan.net/poem56076.html","المتقارب"],[459,"تمنى مقامي والمطالع ضلة","https://www.aldiwan.net/poem15107.html","الطويل"],[461,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[466,"سأجعل بغضتي للدهر فرضا","https://www.aldiwan.net/poem59922.html","الوافر"],[477,"رأيت الهلال ووجه الأمير","https://www.aldiwan.net/poem37056.html","المتقارب"],[498,"غرامي عن ضميري ترجماني","https://www.aldiwan.net/poem37754.html","الوافر"],[513,"قدومك أفرح قلب الهدى","https://www.aldiwan.net/poem12068.html","المتقارب"],[513,"ترى عند نجم الدين علم بما عندي","https://www.aldiwan.net/poem12071.html","الطويل"],[513,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[549,"أقلا فشأنكما غير شاني","https://www.aldiwan.net/poem47155.html","المتقارب"],[549,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[549,"ألا جنبا قلبي الأذى لا يطيقه","https://www.aldiwan.net/poem47368.html","الطويل"],[549,"صبرت ومثلك لا يجزع","https://www.aldiwan.net/poem47722.html","المتقارب"],[549,"أتتني كما بلغت منية","https://www.aldiwan.net/poem47799.html","المتقارب"],[549,"عرفت الديار كسحق البرود","https://www.aldiwan.net/poem47805.html","المتقارب"],[549,"أراعك ما راعني من ردى","https://www.aldiwan.net/poem48121.html","المتقارب"],[573,"لقد عفت عيشي بعد العفيف","https://www.aldiwan.net/poem2791.html","المتقارب"],[584,"حللت بأحشاء لها منك قاتل","https://www.aldiwan.net/poem17640.html","الطويل"]],"verses":[["وَلِم لا وَنَحنُ الراجِعانِ مِنَ العُلى","إِلى المَغرَسِ الرَيّانِ وَالسُؤدُدِ الرَغدِ",0,"د",1,0],["وَلِم لا يَضيفُ العُلا مَن لَهُ","غَديرٌ مَعينٌ وَمَرعىً خَصيبُ",1,"ب",1,0],["وَلِم لاَ يَنَالُ السؤُلَ عِنْدَكَ قَاصِدٌ","وَمِثْلُكَ مَنْ لمْ يُخْطِ قَاصِدَهُ غُنْمُ",2,"م",1,0],["وَلِمْ لاَ وَقَدْ حَلَّ الرِّكَابُ بِيَثْرِبٍ","وَبُؤْتُ بِشَحْطِ الدَّارِ مِنْهَا عَلَى رَغْمِ",3,"م",1,0],["وَلِمِلَّةٍ جُنَّتْ فَلَوْ لَمْ تُنْتَدَبْ","لَمْ يُلْفَ مَنْ يُرْقَى وَلاَ مَنْ يَتْفُلُ",4,"ل",1,0],["وَلِمُلْكِكَ الْعُقْبَى وَحَسْبُكَ نَاصِراً","أَن الإلاَْهَ عَدُوُّ مَنْ عَادَاكَا",5,"ك",2,0],["ولم لا وقدْ أحْيا بكَ اللهُ سُنّةً","نُهَلِّلُ في أعْيادِها ونُكَبِّرُ",6,"ر",1,0],["ولِمْ لا ولي قَلْبٌ لبُعْدِكَ خافِقٌ","وجَفْنٌ على حُكْمِ الدّموعِ جَريحُ",7,"ح",1,1],["ولم لم يكن إلا سنينَ قطعتها","رهينَ شكاة لا تزال تعانيها",8,"ي",3,0],["ولم لا ومن نعماه للفكر باعث","على أدبٍ ما مات إلا ليبعثه",9,"ث",2,0],["ولم لا وقد أحييت ذاك تهجّداً","وكم كثرت هاتيك أوصافك الغرّ",10,"ر",1,0],["ولم لا وقد أبصرته متحرّقاً","بفرقة حبّ راحلٍ ليسَ يرجع",11,"ع",1,0],["ولم لم يَسِرْ وافاهُ لا شك طِلْبُه","بغير عناءٍ بادئاً ثم عَقَّبا",12,"ب",2,0],["وَلِمْ لا ولو أُلقيتُ فيه وصخرةً","لوافيت منه القعرَ أوّلَ راسبِ",13,"ب",1,0],["ولمْ لا وهْيَ زَلزلةٌ ولكنْ","بركب الماء لا ركبِ السُّهوبِ",14,"ب",1,0],["ولِمْ لا يُبكِّي من يبيت كأنَّه","سَليمُ أفاعٍ أو سليمُ أساودِ",15,"د",1,0],["ولِمْ لا وخنزير مهينٌ يُهينني","فيُغضِي على لؤمٍ وأُغضي على قَسْر",16,"ر",1,0],["ولمْ لا ولم أقرأه إلا تكشّفتْ","غواشي هُمومي وانتشيتُ بلا خمر",17,"ر",1,0],["ولمْ لا وأثمانُ المعالي لديكُمُ","رِغابُ العطايا والنفوسُ النفائس",18,"س",1,0],["ولمْ لا تَعيرُ ولم تضربُوا","عليها حجابَ بني دَنقَشِ",19,"ش",1,0],["ولمْ لا وفيكم كل فارس بُهمة","يغادر فرسانَ الوغى بالمداحص",20,"ص",1,0],["ولمْ لا وفي الآتي أخو العيش يُجتوَى","وفي الزمن الماضي أخو العيش يُرتَضى",21,"ض",2,0],["ولمْ لَمْ تُخيِّب ظن من قال خائبٌ","وهزَّ لظنّي فيك رأساً وأنغضا",21,"ض",2,0],["ولم لا وقد جرَّأتَ كل مُضاغنٍ","عليَّ فأضحى سيفُه ليَ مُنتضى",21,"ض",2,0],["ولم لا يريع لزرَّاعه","كريمٌ أُثيرَ ومدحٌ زُرِع",22,"ع",1,0],["ولِمْ لا وأنت رحيب الفناء","بِحُرٍّ يُنيخ إليك المُكلُّ",23,"ل",1,0],["ولِمْ لا واعتقادُك في فؤادي","مُساكنُ مهجتي أخرى الليالي",24,"ي",1,0],["ولِمْ لا وقد ألجأتَ ملتمِسَ الجدا","إلى الطلب المذموم والخُلْق والوَغلِ",25,"ل",1,0],["ولمْ لا يُجلُّ امرؤٌ نفسه","وأنت ترى فيه رأياً جميلا",26,"ل",2,0],["ولِمْ لا وقد أصبحتَ للمُلك مِدْرَهاً","وللمجد سُرسُوراً وللدّين مَعْلَمَا",27,"م",2,0],["ولِمْ لا وقد صُوِّرتَ من خير طينةٍ","وأنت بفضلِ الحلم والجودِ عالمُ",28,"م",1,0],["ولِمْ لا وقد أوضحتما لي طريقتي","فأضحى هُداها مُفصِحاً لا يكاتمُ",28,"م",1,0],["ولِمْ لا وقد ألغيتَ شأْني مُخسِّساً","بذلك قَدْرِي مُسْتَخِفّاً به وزني",29,"ي",1,0],["ولم لا وجدَّته نملة","إذا وقفت أو مشت حصَّلت",30,"ت",1,1],["وَلِم لا يَقي الرَحمَنُ حَدَّيكَ ما وَقى","وَتَفليقُهُ هامَ العِدا بِكَ دائِمُ",31,"م",1,0],["ولم لا أصابُ وحربُ البسو","سِ بينَ جفوني وبينَ الوسَن",32,"ن",1,0],["وَلِم لا أُغالي بِالضِياعِ وَقَد دَنا","عَلَيَّ مَداها وَاِستَقامَ اِعوِجاجُها",33,"ج",3,0],["وَلِم لا يُرى ثانيكَ في السُلطَةِ الَّتي","خُصِصتَ بِها ثانيكَ في الجودِ وَالنَدى",34,"د",2,0],["وَلِم لَم يَثُب فيكَ مِن ذَنبِهِ","فَيَأكُلكَ مُحتَسِباً مَن خَريكا",35,"ك",2,0],["وَلِم لا وَقَد حازَت مِنَ الفَضلِ جُملَةً","يُقَصِّرُ عَن أَوصافِها كُلُّ شاعِرِ",36,"ر",1,0],["وَلِم لا وَحِكمَةُ لُقمانَ فيكَ","وَهَيبَةُ كِسرى قَدِ اِستُكمِلا",37,"ل",2,0],["وَلِمْ لا وَآسادُ العرِينِ لِداتُهُ","يَكُونُ له مثلُ الأسودِ زَئيرُ",38,"ر",1,0],["ولملكك العقبى وحسبك ناصرا","إن الإله عدو من عاداكا",39,"ك",2,0],["ولم لا يسيل الشعرُ لُطفاً ورقةً","إذا كان من فَيض القريحة يستقي",40,"ق",2,0],["ولِمْ لا تريع بأريافها","بلاد تسيل بماء مريع ؟",41,"ع",1,0],["ولم لا وأنت السيد السند الذي","عن المصطفى معنى شهدنا به رسما",42,"م",2,0],["وَلِم لا يَذوبُ الشَمعُ وَالنارُ في الشَمعِ","فَيا لِفؤادٍ عزَّ وَجهُ اِصطِبارِهِ",43,"ه",1,0],["وَلِم لا وَقَد حَبّاهُ بالحِفظِ رَبُّهُ","فَلَم تَطغَ عَيناهُ وَلا زاغَ قَلبُهُ",44,"ه",1,0],["ولم لا تزدهي كبراً وتيها","وقد ظهرت وزال الاتساخ",45,"خ",1,0],["ولم لا يترك السوء الأماني","أظل بها وامسي استعين",46,"ن",1,0],["ولِمْ لا تَهَبُ الأَلْفَ","إذا لم تَدْرِ ما العَشْرا",47,"ر",2,0],["ولِمْ لا تُكرِم العبدَ","إذا لم تعرفِ الحُرَّا",47,"ر",2,0],["ولِمْ لا أجُرّ الذَيْل في ساحة الصِبَا","وشَرْخُ شبابي قائمٌ لي بالعذر",48,"ر",1,0],["ولم لا وقد فازت بأكرم نازلٍ","وأعذب بحرٍ بالفضائل طافح",49,"ح",1,0],["وَلِمْ لا وَذكْرُكَ يَرْمِي الْقُلُوبَ","بِأَنْفَذَ مِنْ صائِباتِ السِّهامِ",50,"م",1,0],["وَلِم لا تَكون عَبيداً لِمَن","مَتى اِفتَخَرَت بِالمَعالي شَآها",51,"ا",3,0],["وَلِم لا يُسَرُّ بِهِ المُسلِمونَ","وَقَد صانَ أَموالَهُم وَالحُرَم",52,"م",1,0],["وَلِم لا يُرى ثَغرُهُ كَالحَباب","وَمن فيهِ فيهِ يَمُجُّ المُدامَه",53,"م",2,0],["وَلم لا وَالّذي فيها مليكٌ","تَرى فيه حُلى ملكٍ بأنسِ",54,"س",1,0],["وَلِم لا وَالحضارةُ ملء عصرٍ","جَلاه وَباع مُنشئه المديدُ",55,"د",1,0],["وَلم لا وَقد شاهَت وجوه وَأنقضت","ظُهورٌ وَلَولا بِالنفوس مُرودها",56,"د",3,0],["وَلِم لا أَبذُلُ الإِنصافَ مِنّي","وَأَبلُغُ طاقَتي في الإِنتِصافِ",57,"ف",1,0],["وَلِمْ لا والخَلِيلُ غُلامُ يَحْيى","يُعَاني ذا وَيُرْغِمُ مَنْ يُعَانِدْ",58,"د",1,0],["وَلِم لُمتُمُ الأَبصارَ فيما أَتَت بِهِ","فَإِنّا دَفَعنا عَن قُلوبٍ بِأَبصارِ",59,"ر",1,0],["ولِمْ لا تذلُّ النّائباتُ لِمَنْ أَوَى","إلى خَير منّاعٍ وخير مُحامي",60,"ي",1,0],["ولِمْ لا وفي لا في بطن السجون أحبة","لديهم فؤادي في السجون مصاب",61,"ب",1,0],["ولِمْ لا يرتقي دَرَج المعالي","بما يُعطاه من شيمٍ وخِيم",62,"م",1,0],["ولِم لا ينال العُلى ماجد","يمدُّ إلى المجد باعاً طويلا",63,"ل",2,0],["ولِمَ لا اتَّبعت كلام النصوح","وكفكفت دمعك لما جرى",64,"ا",1,0],["ولم لَمْ نكُنْ فِي حمدِكم كَيْفَ شئتُمُ","لكنتُمْ لَنَا فِي الصَّفْحِ عنَّا كَمَا شِينا",65,"ن",2,0],["ولمْ لا يغالطُني في الحسا","ب من عنده أنّ ربّاً نَجَلْ",66,"ل",1,0],["ولم لم تكن لله فيه سريرةٌ","لما راح م نجور الرزايا ممنَّعا",67,"ع",2,0],["ولم لا والصلاح يفوح منهم","ومهما عاهدوا بالعهد يوفوا",68,"ف",3,0],["وَلِمَ لا يَستَحِقُّ الدَهرُ ذَمّاً","يُصَيِّرُ حُرَّ وَجهَ الحَرِّ أَرضا",69,"ض",2,0],["ولم لا وشمك قد سطعت","وألبسك اللّه تاج الوطن",70,"ن",1,0],["ولمْ لا وهو من مَلأَ البَرايا","هُدًى وبه اسْتَنارَ المَشْرِقَانِ",71,"ن",1,0],["ولم لم أجد رمداً إذ نأيت","دعوت عليها بأن ترمدا",72,"د",2,0],["ولم لا وفيك البأس والدين والندى","وفضلك لا يحصى بحصر ولا عد",73,"د",1,0],["ولم لا نبكيه ونندب فقده","وأولاده أيتامه وأرامله",74,"ل",2,0],["ولمْ لا أتِيهُ وأنت الّذي","تَنَخّلَنِي خِبرةً واِصطفاني",75,"ي",1,0],["ولِمْ لا يَحِنّ إلى المخصبا","ت مَن كان في البلد الماحِلِ",76,"ل",1,0],["ولِمْ لا أقيك السّوءَ يوماً وطالما","وقيتَ من الأمر الذُّعاف مَذوقُهُ",77,"ق",2,0],["وَلِمْ لا وأنتَ اِمرؤٌ في الصِّعابِ","إِلى رَأيهِ أبداً نَرْجعُ",78,"ع",1,0],["وَلِمْ لا أَصول وقد صار لي","شعار إمام البرايا شعارا",79,"ر",2,0],["ولِمْ لا يتيهُ زمانٌ رآ","ك فضلاً لأيّامه وَاِفتِخارا",80,"ر",2,0],["ولِمْ لا وما كتبوا زلّةً","عليه وأيُّ اِمرئٍ ما هَفا",81,"ا",1,0],["ولِمْ لا نَقَلْتَ إِليّ السَّقامَ","ويُنْقَلُ عنِّي إِليكَ الشَّفاءُ",82,"ا",2,0],["وَلِمْ لا يَصِحُّ الوَجْدُ فِيكَ ونَاظِري","لِنَسْخَةِ حُسْنٍ مِنْ سَناكَ يُقَابِلُ",83,"ل",1,0]]}