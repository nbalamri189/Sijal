{"poems":[[50,"إذا انتقد الدينار شبهت كفه","https://www.aldiwan.net/poem64410.html","الطويل"],[113,"وبي رشأ غريب الزي","https://www.aldiwan.net/poem16405.html","مجزوء الوافر"],[591,"إذا انتقد الدينار شبهت كفه","https://www.aldiwan.net/poem18001.html","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53169","الرجز"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147329","البسيط"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136869",""],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136867",""],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73109","البسيط"],[4849,"رحلة مع عيونك","https://www.poetsgate.com/ViewPoem.aspx?id=53513",""],[5976,"شياطين الفضا","https://www.poetsgate.com/ViewPoem.aspx?id=32795",""]],"verses":[["بِنَرجِسَةٍ أَضحَت وَقَد طَلَّها النَدى","شَفيقٌ عَلَيها مُجتَنيها مِنَ القَطفِ",0,"ف",1,0],["بِنَرجسه الحَدائق مِنهُ","نَفدي نَرجس الحدق",1,"ق",1,0],["بِنَرْجِسةٍ صَفْراءَ قَدْ طَلَّها النَّدى","يَخافُ عَلَيْهَا مُجْتَنوهَا مِنَ القَطْفِ",2,"ف",1,0],["بنرجس اللحظ حمى","في خدّه ورد الخجل",3,"ل",1,0],["بِنَرْجَسَاتِ هَوَاهَا تَمْتَطِي قَلَماً","مُغَمَّساً بِنُطَافِ الصَّحْوِ مِنْ نَسَبِي!",4,"ب",2,0],["بن رجب شل خل العذب يسمعك بإذنه","قل للذي ما تحملت العنا غير منه",5,"ن",2,1],["بن رجب لا تجي العاذل ولا تستظنه","لا تجي العاذل المسرف عليه ألف لعنه",6,"ن",2,1],["بنَرجسِ اللَّحظِ يحمي وردَ وجنتهِ","فوا عناءً لمن يأتيهِ مُجتَنيا",7,"ي",2,0],["بنروح ديرة مابها حدّ يعرفك","أنتي وأنا في رحلةً مع عيونك",8,"ك",1,0],["بنرفع راية الإسلام .. إلى ما شئت يا ربّي","الا يا ربّ غفرانك .. لعبد ٍ تمّ مضموره .. !!",9,"ر",2,0]]}