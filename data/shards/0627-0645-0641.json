{"poems":[[53,"أترى ديار الحي بال","https://www.aldiwan.net/poem29794.html","مجزوء الكامل"],[42,"أمفندي في حب آل محمد","https://www.aldiwan.net/poem50297.html","الكامل"],[93,"أشفت غليل فؤادك الظمآن","https://www.aldiwan.net/poem11277.html","الكامل"],[51,"أجد بربات الحجال صدودها","https://www.aldiwan.net/poem61836.html","الطويل"],[91,"قال الغراب وقد رأى كلف الورى","https://www.aldiwan.net/poem8788.html","عموديه"],[91,"وهيامهم بالبلبل الصداح","https://www.aldiwan.net/poem8789.html","عموديه"],[91,"لوعة في الضلوع مثل جهنم","https://www.aldiwan.net/poem8809.html","عموديه"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[85,"درجت على الكنز القرون","https://www.aldiwan.net/poem63694.html","مجزوء الكامل"],[45,"أتاركي أنت أم مغرى بتعذيبي","https://www.aldiwan.net/poem10649.html","البسيط"],[45,"يا فضل فيما الصدود والغضب","https://www.aldiwan.net/poem11496.html","المنسرح"],[45,"جعلت فداك الدهر ليس بمنفك","https://www.aldiwan.net/poem65216.html","البسيط"],[66,"ألآل أشرقت في نحور","https://www.aldiwan.net/poem40642.html","المديد"],[69,"أمفارقي طفلا أشبت مفارقي","https://www.aldiwan.net/poem28458.html","الكامل"],[105,"عرف الزمان مصارع الأبطال","https://www.aldiwan.net/poem43391.html","الكامل"],[102,"هل كفر كنه مرجع لي ذكرها","https://www.aldiwan.net/poem33006.html","الكامل"],[75,"هل كان ضمخ بالعبير الريحا","https://www.aldiwan.net/poem69095.html","الكامل"],[48,"لو كان حي وائلا من التلف","https://www.aldiwan.net/poem64417.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39617","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55243","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54942","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54654","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54538","الكامل"],[91,"السر في الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=52996",""],[51,"يبيع الكماة الذائدون دماءهُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=27702",""],[122,"لقائل من هو يا عربيد","https://www.aldiwan.net/poem23711.html","الرجز"],[195,"يا عيد عدت فأين الروض والعود","https://www.aldiwan.net/poem39816.html","البسيط"],[197,"علم الله أنني بك صب","https://www.aldiwan.net/poem45556.html","الخفيف"],[227,"يا عنب المعشوق بالله هل","https://www.aldiwan.net/poem50914.html","السريع"],[268,"أو لم تري يده على أحشائه","https://www.aldiwan.net/poem35401.html","الكامل"],[268,"دعيني أمت حرا يخلده الذكر","https://www.aldiwan.net/poem35633.html","الطويل"],[377,"أذكيت حر الجوى والليل قد بردا","https://www.aldiwan.net/poem49197.html","البسيط"],[406,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[456,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[456,"سلا دار البخيلة بالجناب","https://www.aldiwan.net/poem56296.html","الوافر"],[459,"ضاقت بلاغة أشعاري بما رحبت","https://www.aldiwan.net/poem15395.html","البسيط"],[503,"من تنادي","https://www.aldiwan.net/poem27891.html","المديد"]],"verses":[["أَم فَرَّقَتهُم خِلفَةُ ال","أَيّامِ أَو نَجَعُ الغَمامِ",0,"م",1,0],["أَمُفَنِّدي في حُبِّ آلِ مُحَمَدٍ","حَجَرٌ بفيكَ فَدَع مَلامَكَ أَو زِدِ",1,"د",1,1],["أَمْ فُرْقَةُ الأَوْطَانِ قَدْ أَوْدَتْ بِهِ","وَأَشَدُّ رُزْءٍ فُرْقَةُ الأَوْطَانِ",2,"ن",1,0],["أمفترشَ النعمى التي لست كُفأها","وأكفاؤها هلْكى نيامٌ جُدُودُها",3,"د",3,0],["أَمُفَرِّقَ الأَحبابِ عَن أَحبابِهِم","وَكُكَدِّرَ اللَذات وَالأَفراحِ",4,"ح",1,0],["أَمُفَرِّقَ الأَحبابِ عَن أَحبابِهِم","وَمُكَدِّرَ اللَذات وَالأَفراحِ",5,"ح",1,0],["أَم فَقِدنَ كَما فَقَدتُ شَقيقا","فَلَبِسنَ الدُجى عَلَيهِ حِدادا",6,"ا",1,0],["أَمفَقَدَت أَعيُنُكُم نورَها","أَم غَشِيَت أَرواحَكُم غاشِيَه",7,"ه",1,0],["أَم في مَكانٍ بَينَ ذَ","لِكَ يُدهِشُ المُتَأَمِّلين",8,"ن",1,0],["أَمُفلِتٌ بِكَ مِن زُهدِ المَها هَرَبٌ","مِن مُرهَقٍ بِبَوادي الشَيبِ مَقروبِ",9,"ب",1,0],["أَم فيمَ هِجرانُ هائِمٍ بِكُمُ","تُقصونَهُ دائِباً وَيَقتَرِبُ",10,"ب",1,0],["أَمَ في نَبِيِّ اللَهِ يوسُفَ أَسوَةً","لِمِثلِكَ مَحبوساً عَلى الظُلمِ وَالرِفكِ",11,"ك",1,0],["أَم فُصولٌ مِن خَواطِرِ مَولىً","ذي مَقامٍ في العُلى وَمَقالِ",12,"ل",1,0],["أمفارقي طفلاً أشبْتَ مَفارقي","إذْ كنتَ محبوباً إلى محبوبي",13,"ي",1,1],["أَمُفَطِّرَ الأَكبادِ بِالتَرحالِ","اللَهَ في مُهجٍ عَلَيكَ غَوالِ",14,"ل",1,0],["أمْ في صَباياها وفي رمّانِها","ما يبعثُ المدفونَ من آرابي",15,"ب",2,0],["أمْ فِيكَ تخْتلِجُ الخلائقُ مِرْيَةً","كلاّ وقد وَضَحَ الصّباحُ وُضوحا",16,"ح",2,0],["أُمُّ فُرَيخٍ أَحرَزَتهُ في لَجَف","مُزَغَّبَ الأَلغادِ لَم يَأكُل بِكَف",17,"ف",1,0],["أم في غدٍ تثوي بتلك الطلولْ","ويسحقُ الدهرُ يواقيتَها",18,"ه",2,0],["أم في خزانة صالحٍ","تركوك سهواً فاختُزنْتْ",19,"ت",1,0],["أم في البنوكِ لأزمةٍ","حَلَّتْ بأهلك قد رُهنْتْ",19,"ت",1,0],["أَمْ فِي مُبْتَكَرِ الأَعْم","الِ شَأْواً لا يُؤَمُّ",20,"م",1,0],["أَمْ فِي الضُّحَى فَنَفحْتِ آخرَ مَا","نَفَحَتْهُ ذَابِلَةٌ مِنَ الزَّهْرِ",21,"ر",1,0],["أَمْ فِي الهَجِيرَةِ فَانْحَلَلْتِ كَمَا","شَرِبَ الضِّرَامُ وَحِيدَةَ القَطْرِ",21,"ر",1,0],["أَمْ فِي الزَّوَالِ فَمَغْرِبانِ مَعاً","لِلشَّمْسِ فِي الدُّنْيَا وَفِي خِدْرِ",21,"ر",1,0],["أَمْ فِي الظَّلاَمِ فَزَادَهُ حَلكاً","سِرٌّ رَقِيتِ بِهِ إِلى سرِّ",21,"ر",1,0],["أَمْ فِي تَجَلِّي البَدْرِ مُمْتزِجاً","مِنْكِ انْسَجَى بِكآبَةِ البَدْرِ",21,"ر",1,0],["أَمَفْخَرَةَ الخُدُورِ لَقَدْ تَوَالَتْ","حَوَادِثُ مُذْ رَحَلْتِ وَلَمْ تَؤُوبِي",22,"ب",2,0],["أَمُفَارِقِيِهِ مِنْ أَعِزَّةِ آلِهِ","أَنَّي لَكُمْ وَلَنَا جميلَ عَزَاءِ",23,"ا",2,0],["أمفرق الأحباب عن أحبابهم","ومكدّر اللّذّات واالأفراح",24,"ح",1,0],["أمفترشَ النعمى التي لست كُفأها","وأطفاؤها هلْكى نيام جُدودُها",25,"د",3,0],["أم فارس أم بطل صنديد","لا ذا ولا ذياك يا منكود",26,"د",1,0],["أم في كؤوسكما همّ وتسهيد","يا للتّعاسة لا الأوتار تطربني",27,"ي",1,0],["أم فما أوجبَ القطيعةَ والبغ","ضا وقلبي كما عهدتَ محبُّ",28,"ب",1,0],["أم فيك ما يُحمَد مِن ضَمّه","ولَثْمِ خَدّيه وتعنيقه",29,"ق",2,0],["أم في الظلامِ البدرُ ألبسَ أختَهُ","بُرداً جميلاً من برودِ سمائه",30,"ا",3,0],["أمفديةٌ بالروح أنتِ صبيّةً","من الصبحِ والنُعمَى وشِعري لها ثَغر",31,"ر",1,0],["أَم في الهَوى إِنَّ مِن عفت سَرائِرَهُ","يَجفي وَإِن لا يُلاقي لِلجَفا أَمَدا",32,"د",2,0],["أمْ في العُلا وهي بالعُدوانِ قد عُدمَتْ","وساءَها فَلَحتْ من بعد ما حَمِدَتْ",33,"ت",1,0],["أم فيهمُ مَن لَه في الخَطبِ ضاق به","ذَرعُ الرجالِ يدٌ يسطو بها وفَمُ",33,"م",1,0],["أمُفزِعي أنتَ بفوتِ الغنَى","تلك يدُ الطالي على الأجربِ",34,"ب",1,0],["أمفصِحةٌ فأطمعَ في جوابٍ","وكيف يُجيبُ رَسمٌ في كتابِ",35,"ب",1,0],["أم فيهمُ من لواءُ الحمدِ رايتهُ","ومجلسُ السلمِ للتشريع والسنن",36,"ن",1,0],["أمْ فِداها قوْلُنا اذْ بهِ لا","بسواه تُسْتباحُ المَعالي",37,"ل",2,0]]}