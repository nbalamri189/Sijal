{"poems":[[53,"أترى ديار الحي بال","https://www.aldiwan.net/poem29794.html","مجزوء الكامل"],[42,"أمفندي في حب آل محمد","https://www.aldiwan.net/poem50297.html","الكامل"],[93,"أشفت غليل فؤادك الظمآن","https://www.aldiwan.net/poem11277.html","الكامل"],[51,"أجد بربات الحجال صدودها","https://www.aldiwan.net/poem61836.html","الطويل"],[91,"قال الغراب وقد رأى كلف الورى","https://www.aldiwan.net/poem8788.html","عموديه"],[91,"وهيامهم بالبلبل الصداح","https://www.aldiwan.net/poem8789.html","عموديه"],[91,"لوعة في الضلوع مثل جهنم","https://www.aldiwan.net/poem8809.html","عموديه"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[85,"درجت على الكنز القرون","https://www.aldiwan.net/poem63694.html","مجزوء الكامل"],[45,"أتاركي أنت أم مغرى بتعذيبي","https://www.aldiwan.net/poem10649.html","البسيط"],[45,"يا فضل فيما الصدود والغضب","https://www.aldiwan.net/poem11496.html","المنسرح"],[45,"جعلت فداك الدهر ليس بمنفك","https://www.aldiwan.net/poem65216.html","البسيط"],[66,"ألآل أشرقت في نحور","https://www.aldiwan.net/poem40642.html","المديد"],[69,"أمفارقي طفلا أشبت مفارقي","https://www.aldiwan.net/poem28458.html","الكامل"],[105,"عرف الزمان مصارع الأبطال","https://www.aldiwan.net/poem43391.html","الكامل"],[102,"هل كفر كنه مرجع لي ذكرها","https://www.aldiwan.net/poem33006.html","الكامل"],[75,"هل كان ضمخ بالعبير الريحا","https://www.aldiwan.net/poem69095.html","الكامل"],[48,"لو كان حي وائلا من التلف","https://www.aldiwan.net/poem64417.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39617","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55243","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54942","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54654","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54538","الكامل"],[91,"السر في الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=52996",""],[51,"يبيع الكماة الذائدون دماءهُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=27702",""]],"verses":[["أَم فَرَّقَتهُم خِلفَةُ ال","أَيّامِ أَو نَجَعُ الغَمامِ",0,"م",1,0],["أَمُفَنِّدي في حُبِّ آلِ مُحَمَدٍ","حَجَرٌ بفيكَ فَدَع مَلامَكَ أَو زِدِ",1,"د",1,1],["أَمْ فُرْقَةُ الأَوْطَانِ قَدْ أَوْدَتْ بِهِ","وَأَشَدُّ رُزْءٍ فُرْقَةُ الأَوْطَانِ",2,"ن",1,0],["أمفترشَ النعمى التي لست كُفأها","وأكفاؤها هلْكى نيامٌ جُدُودُها",3,"د",3,0],["أَمُفَرِّقَ الأَحبابِ عَن أَحبابِهِم","وَكُكَدِّرَ اللَذات وَالأَفراحِ",4,"ح",1,0],["أَمُفَرِّقَ الأَحبابِ عَن أَحبابِهِم","وَمُكَدِّرَ اللَذات وَالأَفراحِ",5,"ح",1,0],["أَم فَقِدنَ كَما فَقَدتُ شَقيقا","فَلَبِسنَ الدُجى عَلَيهِ حِدادا",6,"ا",1,0],["أَمفَقَدَت أَعيُنُكُم نورَها","أَم غَشِيَت أَرواحَكُم غاشِيَه",7,"ه",1,0],["أَم في مَكانٍ بَينَ ذَ","لِكَ يُدهِشُ المُتَأَمِّلين",8,"ن",1,0],["أَمُفلِتٌ بِكَ مِن زُهدِ المَها هَرَبٌ","مِن مُرهَقٍ بِبَوادي الشَيبِ مَقروبِ",9,"ب",1,0],["أَم فيمَ هِجرانُ هائِمٍ بِكُمُ","تُقصونَهُ دائِباً وَيَقتَرِبُ",10,"ب",1,0],["أَمَ في نَبِيِّ اللَهِ يوسُفَ أَسوَةً","لِمِثلِكَ مَحبوساً عَلى الظُلمِ وَالرِفكِ",11,"ك",1,0],["أَم فُصولٌ مِن خَواطِرِ مَولىً","ذي مَقامٍ في العُلى وَمَقالِ",12,"ل",1,0],["أمفارقي طفلاً أشبْتَ مَفارقي","إذْ كنتَ محبوباً إلى محبوبي",13,"ي",1,1],["أَمُفَطِّرَ الأَكبادِ بِالتَرحالِ","اللَهَ في مُهجٍ عَلَيكَ غَوالِ",14,"ل",1,0],["أمْ في صَباياها وفي رمّانِها","ما يبعثُ المدفونَ من آرابي",15,"ب",2,0],["أمْ فِيكَ تخْتلِجُ الخلائقُ مِرْيَةً","كلاّ وقد وَضَحَ الصّباحُ وُضوحا",16,"ح",2,0],["أُمُّ فُرَيخٍ أَحرَزَتهُ في لَجَف","مُزَغَّبَ الأَلغادِ لَم يَأكُل بِكَف",17,"ف",1,0],["أم في غدٍ تثوي بتلك الطلولْ","ويسحقُ الدهرُ يواقيتَها",18,"ه",2,0],["أم في خزانة صالحٍ","تركوك سهواً فاختُزنْتْ",19,"ت",1,0],["أم في البنوكِ لأزمةٍ","حَلَّتْ بأهلك قد رُهنْتْ",19,"ت",1,0],["أَمْ فِي مُبْتَكَرِ الأَعْم","الِ شَأْواً لا يُؤَمُّ",20,"م",1,0],["أَمْ فِي الضُّحَى فَنَفحْتِ آخرَ مَا","نَفَحَتْهُ ذَابِلَةٌ مِنَ الزَّهْرِ",21,"ر",1,0],["أَمْ فِي الهَجِيرَةِ فَانْحَلَلْتِ كَمَا","شَرِبَ الضِّرَامُ وَحِيدَةَ القَطْرِ",21,"ر",1,0],["أَمْ فِي الزَّوَالِ فَمَغْرِبانِ مَعاً","لِلشَّمْسِ فِي الدُّنْيَا وَفِي خِدْرِ",21,"ر",1,0],["أَمْ فِي الظَّلاَمِ فَزَادَهُ حَلكاً","سِرٌّ رَقِيتِ بِهِ إِلى سرِّ",21,"ر",1,0],["أَمْ فِي تَجَلِّي البَدْرِ مُمْتزِجاً","مِنْكِ انْسَجَى بِكآبَةِ البَدْرِ",21,"ر",1,0],["أَمَفْخَرَةَ الخُدُورِ لَقَدْ تَوَالَتْ","حَوَادِثُ مُذْ رَحَلْتِ وَلَمْ تَؤُوبِي",22,"ب",2,0],["أَمُفَارِقِيِهِ مِنْ أَعِزَّةِ آلِهِ","أَنَّي لَكُمْ وَلَنَا جميلَ عَزَاءِ",23,"ا",2,0],["أمفرق الأحباب عن أحبابهم","ومكدّر اللّذّات واالأفراح",24,"ح",1,0],["أمفترشَ النعمى التي لست كُفأها","وأطفاؤها هلْكى نيام جُدودُها",25,"د",3,0]]}