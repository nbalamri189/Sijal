{"poems":[[59,"قيل لي قد أسى عليك فلان","https://www.aldiwan.net/poem24688.html","الخفيف"],[53,"أيها المهدي ثناء جميلا شارك التنميق فيه الصواب","https://www.aldiwan.net/poem8504.html","الخفيف"],[53,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[68,"صاحب السيف الصقيل المحلا","https://www.aldiwan.net/poem39637.html","المديد"],[33,"إن من تهوى مع الفجر ظعن","https://www.aldiwan.net/poem41295.html","الرمل"],[33,"شاق قلبي منزل دثرا","https://www.aldiwan.net/poem42510.html","المديد"],[50,"رب ظبي كهلال","https://www.aldiwan.net/poem66281.html","مجزوء الرمل"],[59,"قيل لي قد أسى عليك فلان","https://www.poetsgate.com/ViewPoem.aspx?id=3300",""],[124,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[141,"شاع شعري في سليمى وظهر","https://www.aldiwan.net/poem68001.html","الرمل"],[146,"قالوا وزيران هوى نجم ذا","https://www.aldiwan.net/poem58438.html","السريع"],[228,"نحن عدن وهم مكان مريب","https://www.aldiwan.net/poem39718.html","الخفيف"],[240,"من عذيري فيه وهل من عذير","https://www.aldiwan.net/poem32017.html","الخفيف"],[308,"قال لي لا تفه بميل قوامي","https://www.aldiwan.net/poem57885.html","الخفيف"],[308,"قد سألت النسيم وهو خبير","https://www.aldiwan.net/poem58017.html","الطويل"],[308,"قلت قد شرطوا الحبيب وقد ضاق","https://www.aldiwan.net/poem58033.html","الخفيف"],[353,"قلت قومي لعلنا ننسج العي","https://www.aldiwan.net/poem20699.html","الخفيف"],[385,"من لصب أحشاؤه في التهاب","https://www.aldiwan.net/poem49258.html","الخفيف"],[422,"قال لي صاحبي ونحن بسلع","https://www.aldiwan.net/poem53832.html","الخفيف"],[463,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[484,"ما لسلمي يهزها الخيلاء","https://www.aldiwan.net/poem36923.html","الخفيف"],[543,"لا تعاتبني فلا عتب علي","https://www.aldiwan.net/poem47492.html","عموديه"],[543,"نلت عطفي وحناني","https://www.aldiwan.net/poem47925.html","عموديه"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2444","الخفيف"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130173","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62488","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96751","الرمل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65027","الرمل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64915","الرمل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109256","الكامل"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77857","الرمل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124718","الرمل"],[2598,"","https://poetry.dctabudhabi.ae/diwan/poem/17387","الرمل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140068",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200892","الخفيف"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32929","الخفيف"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136810",""],[5056,"<< هذيانُ شاعر..>>","https://www.poetsgate.com/ViewPoem.aspx?id=33175",""],[5376,"قفْ على الأطلالٍ شوقاً وارتحلْ","https://www.poetsgate.com/ViewPoem.aspx?id=202346",""],[5628,"مغترب يصف حاله","https://www.poetsgate.com/ViewPoem.aspx?id=178540",""],[5770,"صديقي الصامت","https://www.poetsgate.com/ViewPoem.aspx?id=178683",""],[5829,"كل ود","https://www.poetsgate.com/ViewPoem.aspx?id=211081",""]],"verses":[["قُلتُ قَد جاءَني وَأَحدَثَ عُذراً","دِيَةُ الذَنبِ عِندَنا الاِعتِذارُ",0,"ر",1,0],["قلتُ قولاً ليس فيه امتراءٌ","مُونِقاً مُستحسناً لا يعابُ",1,"ب",1,0],["قلتُ قولي له وقال كما قل","ت وفي الحق أن تُشيد مشيدَكْ",2,"ك",1,0],["قُلتُ قُل إِنّي بِرو","حي مُخاطِر",3,"ر",1,0],["قُلتُ قَد صَدَّت فَماذا عِندَكُم","أَحسَنُ الناسِ لِقَلبٍ مُرتَهَن",4,"ن",1,0],["قُلتُ قَد أُعطيتِ مَنزِلَةً","ما أَرى عِندي لَها خَطَرا",5,"ر",2,0],["قلتُ قم تخلط","بالخيرِ خبيثاً وأثاما",6,"م",2,0],["قلت قد جاءني وأحدث عذراً","دية الذنب عندي الإعتذار",7,"ر",1,0],["قلت قردٌ منآل دروين ناشٍ","أخذت منه سورة الصهباء",8,"ا",2,0],["قُلتُ قَولاً لِسُلَيمى مُعجِباً","مِثلَ ما قالَ جَميلٌ وَعُمَر",9,"ر",1,0],["قلتُ قياسٌ ويحْكم زِبْرِجٌ","جوهرُه لا يقبلُ الطابعا",10,"ع",2,0],["قُلتِ قُل بَعدُ وَاِبتَسَمتِ فَشَعَّت","في كِياني مجاهِلٌ وَشُعوبُ",11,"ب",1,0],["قُلتُ قُم فَاِصبَحِ النَدامى عَروساً","عُمِّرَت في الدِنانِ عُمرَ النُسورِ",12,"ر",1,0],["قلت قل للصبا التي قد أشاعت","عنك هذا الحديث بين الغصون",13,"ن",1,0],["قلت قل لي هل ورد خديه غضٌّ","قال قد ضاع نشره قلت مني",14,"ي",1,0],["قلت قد شرطوا الحبيب وقد ضا","ق على الغرام في كل مسلك",15,"ك",1,1],["قُلتُ قُومي لَعلَّنا نَنسُجُ العَيْ","شَ فَقالَتْ وَلِلكلامِ كَلامُ",16,"م",1,1],["قُلتُ قَولاً وَرُبَما كانَ مِما","يَنفث المُستَهام فَصل الخِطاب",17,"ب",1,0],["قلتُ قد كانَ ضامناً أن يفي لي","بعهودي فقال لي قد كانا",18,"ن",2,0],["قلت قم قد يئستْ منّا العلا","فتمطّى يُوسدُ الكفَّ المَطَا",19,"ط",2,0],["قلت قلبي أدرى فنادت فلبى","فحصته فلم تجده خليا",20,"ي",2,0],["قُلتُ قد أفنيتَ جِسمِي قالَ قَد","قلتُ كى تُذهِبَ رُوحي قالَ كَى",21,"ك",2,0],["قلتُ قد كُنتث بِبَيتٍ","مِن أَعاجِيبِ الزَّمانِ",22,"ن",1,0],["قُلتُ قَد يَغفُلُ الرَقيبُ وَتُغفي","شُرطَةٌ أَو يَحينُ مِنها اِنقِلابُ",23,"ب",1,0],["قلت قد كان ذا ولكن سأبقي","ماء وجهي ببيع ماء الدجله",24,"ه",1,0],["قلتُ قد جاوزتُمُ أقداركم","وتطاولتم على طول البشرْ",25,"ر",1,0],["قلت قد ذبتُ اِشتياقاً","قال ذُب واِزدد خبالا",26,"ل",2,0],["قلت قد متّ غراماً","قال مُت واِذهب نكالا",26,"ل",2,0],["قُلْتُ قدْ أَضنَيْتَ جِسمي قالَ قدْ","قُلْتُ كَيْ تَذْهَبَ رُوحي قالَ كيْ",27,"ي",1,0],["قُلْتُ قد أَنْكَرْتُ يَوْمي","قَالَ ما تَعْرِفُ أَمْسَكْ",28,"ك",1,0],["قلت قاضينا ونائبنا لقد","صدقا وهذا كل ما قد قلته",29,"ت",2,0],["قلت قل لي يا ابن المبشر ما شأ","نك من بين من غزاني وشاني",30,"ن",2,0],["قلت قيلا مُستَحيلا","بين لَيلى وَسعاد",31,"د",1,0],["قلت قصدى الشم الخناذيذ منهم","والفحول الأوابد البلغاء",32,"ا",2,0],["قلت قالَ اللهُ لم أجعل لكم","فاعلموا التبحيرَ ديناً يختَجَر",33,"ر",1,0],["قُلتُ قُم صَلِّ فَصَلّى قاعِداً","تَتَغَشّاهُ سَماديرُ السَكَر",34,"ر",1,0],["قلت قبلت النصف يا سيدي","فقال لي ميمونة سهله",35,"ل",2,0],["قلت قد استطيع جذبَ حديدٍ","غير أني لا أجذب الأحجارا",36,"ر",2,0],["قُلتُ قَد قُمتُ عَنكَ قالَ وَمَن لي","مِنكَ يا مَن فَقَدتُهُ بِالقِيامِ",37,"م",1,0],["قلت قول الذي قبلي ونا خلفه اثنيت","كأن بالزيت مصباحي ضوا لك بلا زيت",38,"ت",1,0],["قلتُ:- قاصد .. طامعٌ فينا وراصد","دون سبعٍ في القوافي جاد حائل",39,"ل",1,0],["قلتُ قد راحتْ وإني عاشقٌ","كيف يدنو العشقُ واحاتِ الأجلْ",40,"ل",1,0],["قلتُ قد علّقتُها في حائط ٍ","وتمنيّتُ لها طُولَ الإقامهْ",41,"م",2,0],["قلت:قد حيرتني يا صاحبي","إن هذا الصمت نطقٌ عبقري",42,"ي",1,0],["قلت قد طال التجافي إن بي","لاعجاً قد نال مني قال قدْ",43,"د",1,0]]}