{"poems":[[95,"تولوا وقدر لي أن أقيما","https://www.aldiwan.net/poem11384.html","المتقارب"],[74,"بروحي سيدا ما كان","https://www.aldiwan.net/poem20311.html","مجزوء الوافر"],[53,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[53,"شهر نسك قرينه يوم لهو","https://www.aldiwan.net/poem66715.html","الخفيف"],[47,"أبعد الشباب المنتضى في الذوائب","https://www.aldiwan.net/poem10652.html","الطويل"],[77,"زهر الروض بنت دمع الغمام","https://www.aldiwan.net/poem69020.html","الخفيف"],[77,"أحبب به قنصا إلى متقنص","https://www.aldiwan.net/poem69068.html","الكامل"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/50177","الرجز"],[98,"راكبة الدراجة","https://www.poetsgate.com/ViewPoem.aspx?id=15719",""],[92,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[113,"الهي من يقيل عثار مثلي","https://www.aldiwan.net/poem16679.html","الوافر"],[119,"عقول الورى تاهت بسلطانك الأعلى","https://www.aldiwan.net/poem42204.html","الطويل"],[186,"خاننا فيك حادث الأيام","https://www.aldiwan.net/poem67031.html","البسيط"],[264,"باسمك يا الله ربي ابتدي","https://www.aldiwan.net/poem35938.html","الرجز"],[290,"بلطيف شعرك مصطفى لطيفي غدا","https://www.aldiwan.net/poem39411.html","الكامل"],[309,"بروق الغور تلمع في الدياجي","https://www.aldiwan.net/poem16896.html","الوافر"],[382,"عج بالحمى يا راكب الوجناء","https://www.aldiwan.net/poem66977.html","الكامل"],[396,"الحمدلله مولانا الرحيم الغفور","https://www.aldiwan.net/poem54583.html","عموديه"],[409,"حمام بأغصان الرياض ترنما","https://www.aldiwan.net/poem33421.html","الطويل"],[463,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[505,"ظهر بأعباء الغرام قد انحنى","https://www.aldiwan.net/poem37761.html","الكامل"],[505,"أفيضوا لنا يا أهل أم عبيدة","https://www.aldiwan.net/poem38012.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64589","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80000","الرجز"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124735","الوافر"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109498","الطويل"],[2489,"","https://poetry.dctabudhabi.ae/diwan/poem/111229","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89408","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89150","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89118","الرجز"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216468","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114310","الرمل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101372","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127170","السريع"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54381","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45019","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94532","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72513","المجتث"],[4767,"صباح الفرَج","https://www.poetsgate.com/ViewPoem.aspx?id=178811",""],[4809,"هل في القوم من عمر ؟","https://www.poetsgate.com/ViewPoem.aspx?id=201476",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5150,"مقدمة للحب","https://www.poetsgate.com/ViewPoem.aspx?id=202787",""],[5189,"بإذنِ الواحد الصمد","https://www.poetsgate.com/ViewPoem.aspx?id=211097",""],[592,"ألا بلغا عن جميلاً رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=128827",""],[161,"أخيرا أثلجت","https://www.poetsgate.com/ViewPoem.aspx?id=176767",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["بِلطْفِكَ وَالظَّرْفِ فَكَّهْتَهَا","وَطَيَّبْتَ مَوْرِدَهَا وَالنَّسِيمَا",0,"م",2,0],["بلطفِ النّظم أُبهِجُه","وبالإحسانِ يُبْهِجُني",1,"ن",2,0],["بل طرفُ عينيك أذكى حين تَثْقُبُهُ","للمجد من طرف عينيه إذا لمحا",2,"ح",2,0],["بل طَهوراً نَفَى به درن الآ","ثام والسيئات عن مذنبيه",3,"ي",2,0],["بِلُطفِ تَأَتٍّ مِنكَ ما زالَ ضامِناً","لَنا طاعَةَ العاصي وَسِلمَ المُحارِبِ",4,"ب",1,0],["بل طباع رُكِّبنَ في الفلك الأث","رى ليروي القيعان في كل عام",5,"م",1,0],["بل طيْفُ نازحةٍ تصرّمَ عهدُهَا","إلاّ بقايا وُدِّها المستخلَص",6,"ص",1,0],["بل طعمُه عن طَعمِه ذو بُعْدِ","حتى إذا أسعرَها بالوِقْدِ",7,"د",1,0],["بلطف هذا الجسد الممراح","وخفّة في روحك الصّداح",8,"ح",1,0],["بلطيفٍ من التعابير يجري","في مَدَبٍ من الكلام لطيف",9,"ف",1,0],["بِلَطفك في شَدائِدي اِعتِصامي","وَمَن نَفسي بِعَفوك أَستَجيرُ",10,"ر",1,0],["بلطفك أرشدني إليك فإنها","عقول الورى تاهت بسلطانك الأعلى",11,"ل",2,0],["بَل طَريقٌ نَجوزُها فَتَخَير","لَكَ مِنها زاداً لِدارِ المُقامِ",12,"م",1,0],["بلطف ما جاء به إلينا","مباركاً فينا كما علينا",13,"ن",2,0],["بلطيف شعرك مصطفى لطيفي غدا","نظم ابن قيس حائزاً أعلى الرتب",14,"ب",1,1],["بلطف اللَه كشاف البلايا","تعالى لا يخيب فيه راجي",15,"ج",2,0],["بل طِرت وا أسفا عليك لغائلٍ","يعروك عند مَواقعِ الإيماءِ",16,"ا",2,0],["بل طيها اسرار لم تكتب بطون السطور","فكن له عبد تحظى بالمنح والحبور",17,"ر",1,0],["بلطف طباع يعجز الوصف عنهم","ومن لطفهم هذا النسيم تعلما",18,"م",2,0],["بلطفِك في التدبير شابَ غلامُها","على السيرة المُثلَى وشَبَّ رَبيبُها",19,"ب",3,0],["بلَطيفِ شخصٍ من جَمالِكَ قامَ من","بُحْبوحَةِ النُّورِ الصَّميمِ مُكَوَّنَا",20,"ن",2,0],["بلَطائِفِ المعْنى الَّذي أَودَعْتَهُ","ضمنَ الوُجودِ فصارَ مَعْمورَ البِنا",20,"ن",2,0],["بِلُطفِ مَعانيكُمْ وسِرِّ شٌؤونِكُمْ","وحالٍ به عَطَّرْتُمْ البَرَّ والبَحرا",21,"ر",2,0],["بل طالبوه أيما مطالبة","وصدقوا فيه الظنون الكاذبة",22,"ه",1,0],["بلطفك سيدي فرج وبشرى","وإن عقدت شدائدها الخطوب",23,"ب",1,0],["بلطفها من القوافي نزلت","منزلة الأرواح من أجسادها",24,"د",3,0],["بلطفك صنعتني بشرا سويا","ولم أك كنت من ماءٍ مهين",25,"ن",1,0],["بلطفك يا بدري تملكتَ مهجتي","وصرت أعز الناس عندي واحسنا",26,"ن",2,1],["بل طعنة نجلاء منه غادرت","في كل قلب ضربة اخدودا",27,"د",2,0],["بلطيف رونق ظاهرٍ ذي دولة","ونظيف سر العابد الأواه",28,"ه",1,0],["بلطفها قالت احكم في القلوب لقد","أوتيت سؤلك يا لطفي على قدر",29,"ر",1,0],["بلطفه على المكان والزمن","فاسمع له حسن الثنا من مصر",30,"ر",1,0],["بل طراز من المكارم باق","كلما عده الكرام تعدد",31,"د",1,0],["بَلْ طِلاَبُ اللهِ فِيهِ غُنْيَةٌ","وَطِلاَبُ الغَيْرِ مِنْ فَقْدِ الخَجَلْ",32,"ل",1,0],["بلطتموه فاستقر قراره","وأعدتموه أبلج الجنبات",33,"ت",1,0],["بل طرسه الصبح وألفاظه الش","شهب لها وسط الحشا مطلع",34,"ع",1,0],["بلطيفِ تدبيرٍ يَرِقُّ له","لصفائهِ قلبُ الصّفا الصَّلْدِ",35,"د",1,0],["بِلَطائِفٍ سارَت مَسيرَ الشَمسِ في","أَهلِ البَداوَةِ وَالمَعاقِل وَالحَضَر",36,"ر",1,0],["بلطفك يا رحمان كن خير ناصرٍ","لحضرتهِ العليا وصنها من الغدرِ",37,"ر",1,0],["بلطمه الافق يلفى","بوجنتيه احمرار",38,"ر",1,0],["بلطف ذي اللطف بهم رحمةً","وللجميع خيرَه تمنح",39,"ح",1,0],["بل طائر النورس الحاني بلا أثرٍ","تراه أقلع عن تطوافه الغجري ؟",40,"ر",2,0],["بلطفك في تدمير صنعك ينبرى","على مقتضى أسماء أوصافك العظمى",41,"م",2,0],["بل طموحُ الشعرِ أمرٌ","ليس يُفنى.. كيف أشرحْ..!؟",42,"ح",1,0],["بلطفٍ منك يا رحمنُ إنَّا","هُدِينا للصراطِ المستقيمِ",43,"م",1,0],["بلطف من الولي له وأعانه","على كثرة الأعدا له والمحارب",44,"ب",1,0],["بِلُطْفٍ دَبَّ مُنْسَابًا، تَهَادَى","بِلَيْلٍ سَاكِنِ سُكْنَى المُغَنَّجْ",45,"ج",1,0],["بلطفك الساري بعطف الرحموت","بنورك الساطع في وجه الأثر",46,"ر",1,0]]}