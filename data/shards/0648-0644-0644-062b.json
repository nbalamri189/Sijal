{"poems":[[82,"أجلو عروسا بخدها خجل","https://www.aldiwan.net/poem31369.html","المنسرح"],[82,"يا ليل هجر الحبيب طلت على","https://www.aldiwan.net/poem31525.html","المنسرح"],[108,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[147,"إني وإن كنت في الأقوال محتكما","https://www.aldiwan.net/poem11816.html","البسيط"],[190,"ما استشعر الصبر إلا وهو مجهود","https://www.aldiwan.net/poem43908.html","البسيط"],[234,"قد أغتدي قبل طلوع الفجر","https://www.aldiwan.net/poem51066.html","الرجز"],[266,"وروضة طاب بها المحل","https://www.aldiwan.net/poem38213.html","الرجز"],[385,"تنسمي بالله ريح نجد","https://www.aldiwan.net/poem49209.html","الرجز"],[412,"صددت أن عاد روض الرأس ذا زهر","https://www.aldiwan.net/poem50174.html","البسيط"],[457,"وللثريا ركود فوق أرحلنا","https://www.aldiwan.net/poem13802.html","البسيط"],[580,"حل عقداً كله قبل","https://www.aldiwan.net/poem2936.html","المديد"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122713","المنسرح"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66962","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145777","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96753","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53131","المنسرح"],[2690,"","https://poetry.dctabudhabi.ae/diwan/poem/198349","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[4927,"مؤامرات ومؤتمرات سورية","https://www.poetsgate.com/ViewPoem.aspx?id=79602",""],[5121,"لِلثَّغْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=215144",""],[5956,"بطولة الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=192291",""],[6142,"خلق الوصي طلاع الكون ترتع في","https://www.poetsgate.com/ViewPoem.aspx?id=155726",""]],"verses":[["وللثّرَيّا يدٌ مُخَتَّمَةٌ","منها بناناً خضابُها الغَسَقُ",0,"ق",1,0],["وللثّرَيا جناحُ قاطِعَةٍ","بالخفق منه مسافةَ الجُنحِ",1,"ح",1,0],["وللثقافة تأليف وترجمةٌ","وللغناءِ مزاميرٌ وأَعواد",2,"د",1,0],["وَلِلثَنا نَغَماتٌ في مَسامِعِهِ","لِأَجلِها هَجَرَ الأَوتارَ وَالنَغَما",3,"م",2,0],["وللثريّا شروق في تسنّمها","كأنّها في علوّ الجوّ عنقود",4,"د",1,0],["وللثريّا طمع في البدر","فهي له حيث مضى في الإثْر",5,"ر",1,0],["وللثريا راحة تُشل","والبدر في السير اعتراه الكل",6,"ل",1,0],["وَلِلثُريا رَونَق لَما بَدَت","في جيد زُنجي الدُجى كَالعقد",7,"د",1,0],["وَلِلثُّرَيّا رُكود فَوقَ أَرحلنا","كَأَنَّها قطعة مِن جلدة النَمِرِ",8,"ر",1,0],["وللثريا ركودٌ فوقَ أرْحلِنا","كأنَها قِطْعَةٌ من فَرْوَةِ النَمرِ",9,"ر",1,1],["وللثمي فوقَهُ أَبداً","صوتُ عِقْد حين يَنْتَثِرُ",10,"ر",1,0],["وللثُّرَيّا في الغَربِ حَثحَثَةٌ","كَأنَّها في الوَميضِ قِنديلُ",11,"ل",1,0],["وللثُّغُورِ بذكرى عَدْلِهِ وَلَعٌ","وللقلوبِ لِمَثْوَى حُبِّه لَطَأُ",12,"ا",1,0],["ولِلثَائِرينَ بهَا الحَامِلِين","نُفُوسَاً كِبَاراً على ما ابتلاهَا",13,"ا",3,0],["وللثنايا عذيب لاح بارقه","يا من رأى البرق تبديه الثنايات",14,"ت",1,0],["وللثريَّا ترى في الجوِّ ثجثجةً","تظنُّها في أقاصي الجوِّ قنديلا",15,"ل",2,0],["وللثريا كفّ محببة","لها بوقف الهلال تسوير",16,"ر",1,0],["وَللثُرَيَّا انْهِزَامٌ مِنْ طَوَالِعِهِ","كَأنَّهَا عَذْلٌ حَفَّتْ بِذِي خَبَلِ",17,"ل",1,0],["وللثرى ألقى بها قاذفاً","من بعد ما بالكف عنفاً أماد",18,"د",1,0],["وَلِلثُّوَّاْرِ مَيْدَاْنُ الْمَعَاْلِيْ","وَلِلْعُمَلاْءِ مُؤْتَمَرُ الْجَوَاْرِيْ",19,"ر",2,0],["وَلِلثَّغْرِ لَعْسٌ فِي الْكَلَامِ يَرُزُّه","كَمْنْ يَنْقُشُ الْحَرْفَ الْمُكَحَّلَ حَزُّهُ",20,"ز",2,1],["وللثوارِ ماداموا أرادوا","مراداً أن يفوزوا في الوثوبِ",21,"ب",1,0],["وللثواكل منها ما يشاطرها","بالحزن طوراً وطوراً ما يسليها",22,"ي",3,0]]}