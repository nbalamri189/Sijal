{"poems":[[53,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[53,"يفاخرنا قوم بمن لم يلدهم","https://www.aldiwan.net/poem30608.html","الطويل"],[53,"كان قضاء الإله مكتوبا","https://www.aldiwan.net/poem30741.html","المنسرح"],[51,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[51,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[43,"ما لي كأن اشتياقا ظل يعنف بي","https://www.aldiwan.net/poem10606.html","البسيط"],[45,"عست دمن بالأبرقين خوال","https://www.aldiwan.net/poem65567.html","الكامل"],[28,"ومسجونة قالت وقد سد زوجها","https://www.aldiwan.net/poem5259.html","الطويل"],[75,"شكا ما شكوت الرمح والنصل والسهم","https://www.aldiwan.net/poem69019.html","الطويل"],[46,"أيا ديك عدت من أياديك صيحة","https://www.aldiwan.net/poem23291.html","الطويل"],[170,"أظنك خلت الشوق والنأي أبكاني","https://www.aldiwan.net/poem1684.html",""],[183,"جهد الحزين إذا صرف القضا نزلا","https://www.aldiwan.net/poem67038.html","البسيط"],[200,"أرى الهجر أن تذكر الهجر لي","https://www.aldiwan.net/poem45184.html","المتقارب"],[205,"بدت لوداع والتجمل سترها","https://www.aldiwan.net/poem53273.html","الطويل"],[365,"خطبن وأيمان الكماة المنابر","https://www.aldiwan.net/poem60906.html","الطويل"],[417,"سقاها الهوى من راحة الوجد صرخدا","https://www.aldiwan.net/poem54030.html","الطويل"],[417,"هو البرق مما راعها وشجاها","https://www.aldiwan.net/poem54106.html","الطويل"],[483,"وما حيوان في الرياض ممايلا","https://www.aldiwan.net/poem24324.html","عموديه"],[516,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[552,"ألا عوجا لمجتمع السيال","https://www.aldiwan.net/poem47286.html","البسيط"]],"verses":[["وَما اِفتَرَّ يَومٌ قَطُّ إِلا لَقيتُهُ","بِوَجهٍ جَلِيٍّ أَو بِكَفٍّ مُغَيِّمِ",0,"م",1,0],["وَما اِفتَخَرَت بَعدَ النَبِيِّ بِغيرِهِ","يَدٌ صَفَّقَت يَومَ البَياعِ عَلى يَدِ",1,"د",1,0],["وَما اِفتِراقُ الشُبولِ عَن أَسَدٍ","بِمانِعٍ أَن يَكونَ مَرهوبا",2,"ب",2,0],["وما افتقرتم إلى مدحٍ يزينكُم","تالله يا زينةَ الأيامِ في الحفلِ",3,"ل",1,0],["وما أفعالكم بمفعَّلاتٍ","وقولي في مدائحكم مقولُ",4,"ل",1,0],["وما أفدتُ الغنى فيها ولا ملكت","كفِّي بها ملكاً بالجود مغتبطا",5,"ط",2,0],["وَما آفَتي في خَلَّتي وَبُدُوِّها","سِوى خُلَلٍ لَم تُعطَ فَضلَ خِلالِ",6,"ل",1,0],["وَما أُفُقٌ إِلّا بِهِ مِن حَديثِها","لَها أَثَرٌ يَنمى إِلى كُلِّ مَفخَرِ",7,"ر",1,0],["وما افترقا حتَّى يُقالَ تشابَهَا","بلِ امتزَجَ التركيبُ والدَّمُ واللحمُ",8,"م",1,0],["وَما إِفَتَقَرت يَوماً إِلى موقِدٍ لَها","إِذا قُرِّبَت لِلموقِدينَ الهَشائِمُ",9,"م",1,0],["وَما آفَةُ الشُجعانِ إِلّا اِحتِقارُها","رِجالاً وَكَم صِيدَت صُقُورٌ بِخربانِ",10,"ن",1,0],["وَما أَفيكَ بِها يَوماً وَقَد قَطَرَت","حُمراً لِأَنَّ بِها دونَ الوَفا خَجَلا",11,"ل",2,0],["وما آفةُ النفسِ بعدَ المتاب","غلا الغرورُ بمن يغفرُ",12,"ر",1,0],["وما افتقرت نفسي إذا كان إنما","يلوذ بإخوان التَّديُّنِ فقرُها",13,"ر",3,0],["وما افتَضَّ أبكارَ الفُتوحِ سوى ظُبيً","لأغمادِها هامُ المُلوكِ ضَرائر",14,"ر",1,0],["وما افترَّ عن دُرِّ الثنايا تبسُّماً","من البِشر حتَّى أمطر الكفّ عسجدا",15,"د",2,0],["وما افتقرت في النَّاس من أحدٍ يدٌ","إذا كانَ من عبد الغنيّ غناها",16,"ا",3,0],["وما أفضل الشيخين بين مكانه","وقيت الردى حبا ووقت المنيتي",17,"ت",2,0],["وما افترق الجيشان إلا ورأسه","يميل على غصن من الخط ناعم",18,"م",1,0],["وما اِفتَرقا بهذا العصر إلّا","كما اِفترقتْ يمينٌ مَعْ شمالِ",19,"ل",1,0]]}