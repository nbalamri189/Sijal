{"poems":[[55,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[55,"يفاخرنا قوم بمن لم يلدهم","https://www.aldiwan.net/poem30608.html","الطويل"],[55,"كان قضاء الإله مكتوبا","https://www.aldiwan.net/poem30741.html","المنسرح"],[53,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[53,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[45,"ما لي كأن اشتياقا ظل يعنف بي","https://www.aldiwan.net/poem10606.html","البسيط"],[47,"عست دمن بالأبرقين خوال","https://www.aldiwan.net/poem65567.html","الكامل"],[30,"ومسجونة قالت وقد سد زوجها","https://www.aldiwan.net/poem5259.html","الطويل"],[77,"شكا ما شكوت الرمح والنصل والسهم","https://www.aldiwan.net/poem69019.html","الطويل"],[48,"أيا ديك عدت من أياديك صيحة","https://www.aldiwan.net/poem23291.html","الطويل"],[173,"أظنك خلت الشوق والنأي أبكاني","https://www.aldiwan.net/poem1684.html",""],[186,"جهد الحزين إذا صرف القضا نزلا","https://www.aldiwan.net/poem67038.html","البسيط"],[203,"أرى الهجر أن تذكر الهجر لي","https://www.aldiwan.net/poem45184.html","المتقارب"],[208,"بدت لوداع والتجمل سترها","https://www.aldiwan.net/poem53273.html","الطويل"],[369,"خطبن وأيمان الكماة المنابر","https://www.aldiwan.net/poem60906.html","الطويل"],[422,"سقاها الهوى من راحة الوجد صرخدا","https://www.aldiwan.net/poem54030.html","الطويل"],[422,"هو البرق مما راعها وشجاها","https://www.aldiwan.net/poem54106.html","الطويل"],[487,"وما حيوان في الرياض ممايلا","https://www.aldiwan.net/poem24324.html","عموديه"],[520,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[556,"ألا عوجا لمجتمع السيال","https://www.aldiwan.net/poem47286.html","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86990","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48863","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48823","المتقارب"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48773","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48850","الطويل"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17570","الطويل"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18263","الطويل"],[1459,"","https://poetry.dctabudhabi.ae/diwan/poem/138019",""],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48199","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87336","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76025","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204809","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134026","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65488","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65104","الطويل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107066","الطويل"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74093","الوافر"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26962","البسيط"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32403","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205890","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131025",""],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34682","الهزج"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114455","البسيط"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76466","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125802","المتقارب"],[4177,"","https://poetry.dctabudhabi.ae/diwan/poem/105692","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81706","الطويل"],[5442,"سل الركب هل مروا بجرعاء مالك","https://www.poetsgate.com/ViewPoem.aspx?id=114770",""],[5910,"دعاكَ السُّهدُ والأرقُ العتيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=206954",""]],"verses":[["وَما اِفتَرَّ يَومٌ قَطُّ إِلا لَقيتُهُ","بِوَجهٍ جَلِيٍّ أَو بِكَفٍّ مُغَيِّمِ",0,"م",1,0],["وَما اِفتَخَرَت بَعدَ النَبِيِّ بِغيرِهِ","يَدٌ صَفَّقَت يَومَ البَياعِ عَلى يَدِ",1,"د",1,0],["وَما اِفتِراقُ الشُبولِ عَن أَسَدٍ","بِمانِعٍ أَن يَكونَ مَرهوبا",2,"ب",2,0],["وما افتقرتم إلى مدحٍ يزينكُم","تالله يا زينةَ الأيامِ في الحفلِ",3,"ل",1,0],["وما أفعالكم بمفعَّلاتٍ","وقولي في مدائحكم مقولُ",4,"ل",1,0],["وما أفدتُ الغنى فيها ولا ملكت","كفِّي بها ملكاً بالجود مغتبطا",5,"ط",2,0],["وَما آفَتي في خَلَّتي وَبُدُوِّها","سِوى خُلَلٍ لَم تُعطَ فَضلَ خِلالِ",6,"ل",1,0],["وَما أُفُقٌ إِلّا بِهِ مِن حَديثِها","لَها أَثَرٌ يَنمى إِلى كُلِّ مَفخَرِ",7,"ر",1,0],["وما افترقا حتَّى يُقالَ تشابَهَا","بلِ امتزَجَ التركيبُ والدَّمُ واللحمُ",8,"م",1,0],["وَما إِفَتَقَرت يَوماً إِلى موقِدٍ لَها","إِذا قُرِّبَت لِلموقِدينَ الهَشائِمُ",9,"م",1,0],["وَما آفَةُ الشُجعانِ إِلّا اِحتِقارُها","رِجالاً وَكَم صِيدَت صُقُورٌ بِخربانِ",10,"ن",1,0],["وَما أَفيكَ بِها يَوماً وَقَد قَطَرَت","حُمراً لِأَنَّ بِها دونَ الوَفا خَجَلا",11,"ل",2,0],["وما آفةُ النفسِ بعدَ المتاب","غلا الغرورُ بمن يغفرُ",12,"ر",1,0],["وما افتقرت نفسي إذا كان إنما","يلوذ بإخوان التَّديُّنِ فقرُها",13,"ر",3,0],["وما افتَضَّ أبكارَ الفُتوحِ سوى ظُبيً","لأغمادِها هامُ المُلوكِ ضَرائر",14,"ر",1,0],["وما افترَّ عن دُرِّ الثنايا تبسُّماً","من البِشر حتَّى أمطر الكفّ عسجدا",15,"د",2,0],["وما افتقرت في النَّاس من أحدٍ يدٌ","إذا كانَ من عبد الغنيّ غناها",16,"ا",3,0],["وما أفضل الشيخين بين مكانه","وقيت الردى حبا ووقت المنيتي",17,"ت",2,0],["وما افترق الجيشان إلا ورأسه","يميل على غصن من الخط ناعم",18,"م",1,0],["وما اِفتَرقا بهذا العصر إلّا","كما اِفترقتْ يمينٌ مَعْ شمالِ",19,"ل",1,0],["وَما اِفتَخرت بإسماعيل في ملأٍ","مِن المُلوك عَلى أَضراب برقوق",20,"ق",1,0],["وما أفاد غناءٌ فوق رابيةٍ","ولا أفاد بكاءٌ فوقَ أطلال",21,"ل",1,0],["وما أفضلَ المأزمَ الصعبَ لو","أتى بتجاريبه المأزم",22,"م",1,0],["وما أفضت به الأفواج تترى","إليك وما تمنته الوفود",23,"د",1,0],["وما افتقد الداعي ضحى اليوم جاره","ولا سأل المدعوُّ أين قريني",24,"ن",2,0],["وَما اِفتَقَدَت مِنكَ القَبائِلُ ساعَةً","جَواداً يبدّ الريحَ حِلفَ هِباتِ",25,"ت",1,0],["وما أفتخر الأقوام إلا بفضلنا","وما وجدوا إلا لنا متجشما",26,"م",2,0],["وما أَفعَالُ خيرٍ في حِسَابٍ","مِنَ الإيمانِ مَفروضَ الوِصَالِ",27,"ل",1,0],["وما افتخر الأنام بغير ملك","قديم أو بدينٍ مسلمينا",28,"ن",2,0],["وما افترقنا ونايُ الشوقِ يُطربُنا","فعلاً تميلُ معانِيهِ إِلى الرِّيَبِ",29,"ب",1,0],["وما آفَتي إلا ظلومٌ لنفسِهِ","يرى الحقَّ فَخرأ وَهوَ أقبحُ من سُخرِ",30,"ر",1,0],["وَما اِفتَرَقوا إِلا لعجزِ فُهومِهم","وَلَو أَدرَكوا لَم يُبصِروا فيهِ فارِقا",31,"ق",2,0],["وما أفسدت الا العوام فصيحنا","كذا من عوام الشعر إفساد ذاته",32,"ت",2,0],["وما أفق البلدان إلا منازل","لبدرك بالإسعاد فيها شرائف",33,"ف",1,0],["وما أفاد الذي عانا القريض لكي","يحيك الا العنا في النّظم إذ عانا",34,"ن",2,0],["وما افترّ عند النطق إلا وقد غدت","سوابقُ دمعي في الثّنايا تُسيّرُ",35,"ر",1,0],["وما أفصحت إلا بلابل لوعة","ألا انما المعروف غاضت مناهله",36,"ل",2,0],["وما أفاده المؤرخونا","من حالهم وشأنهم تعيينا",37,"ن",2,0],["وَما اِفتَقرت إِلى عون المَواضي","إِذا كانَت بعزمك تَستَعينُ",38,"ن",1,0],["وَما أُفارِقُ يَوماً مَن أُفارِقُهُ","إِلّا حَسِبتُ فراقي آخِرَ العَهدِ",39,"د",1,0],["وَما أَفسَدَ الإِسلامَ إِلّا عُصابَةٌ","تَأَمَّرَ نَوكاها وَدامَ نَعيمُها",40,"م",3,0],["وما افترقت شعوب الأرض يومًا","كما افترقوا إذا انصرفوا وهاموا",41,"م",3,0],["وما افترقا حتى بني لهما الهوى","بناء على أس الوفاء موطدا",42,"د",2,0],["وما أفهم ما يعني","مغنينا إذا غنى",43,"ن",2,0],["وما افتتنت بأبكاري وإن فتَنَت","ألحاظُ ألفاظِها الأبكارَ من عُونِ",44,"ن",1,0],["وَما اِفتخارك الا بالسجوف وَما","تهتم الا لِتَبديل القَلانيس",45,"س",1,0],["وما افترقت أُمةٌ فرقتين","فباء الجميعُ بغير الضرر",46,"ر",1,0],["وما أفسد الأخلاق إلا معاشر","بتحريكم للشعب والشعب راكد",47,"د",1,0],["وما أفصحَ الوشْحَ التي تشتكي النوى","على حال قُربٍ من خصور لها خُمص",48,"ص",1,0],["وما افتر ثغر النور في نضر الثرى","بمهل أجفان الغوادي السوافك",49,"ك",1,0],["وما أفصحتُ عن حَزَنٍ ولكنْ","خطوبٌ دأبُها الحَيْنُ الخفيُّ",50,"ي",1,0]]}