{"poems":[[53,"ما لذا الداني إلى القلب شحط","https://www.aldiwan.net/poem30161.html","الرمل"],[86,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[51,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[89,"ما الروض بعد البلبل المترنم","https://www.aldiwan.net/poem44605.html","الكامل"],[43,"كفرندي فرند سيفي الجراز","https://www.aldiwan.net/poem9609.html","الخفيف"],[105,"من لي بملء المشرقين بيانا","https://www.aldiwan.net/poem41940.html","الكامل"],[105,"خلق العروبة أن تجد وتدأبا","https://www.aldiwan.net/poem42057.html","الكامل"],[105,"عندي إذا صرع الجنوب سبات","https://www.aldiwan.net/poem42095.html","الكامل"],[105,"بني جذيمة ما في الأمر من عجب","https://www.aldiwan.net/poem43991.html","البسيط"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39659","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142332","الكامل"],[94,"نغمات عودي","https://www.poetsgate.com/ViewPoem.aspx?id=15651",""],[94,"نَغَمات عودي لا تُملُّ لأنها","https://www.poetsgate.com/ViewPoem.aspx?id=15592",""],[133,"أحسن الأيام أيام التلاق","https://www.aldiwan.net/poem49117.html","الرمل"],[135,"سل هم النفس عنها","https://www.aldiwan.net/poem68029.html","مجزوء الرمل"],[187,"يا نبيا لدى الإله عظيما","https://www.aldiwan.net/poem35102.html","الخفيف"],[235,"سل هامة العلياء أبا سلهام","https://www.aldiwan.net/poem19080.html","الكامل"],[252,"لا تخف","https://www.aldiwan.net/poem25016.html","مجزوء الرمل"],[268,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[351,"أنسايم الأحباب من روض الحمى","https://www.aldiwan.net/poem39961.html","الكامل"],[369,"ما لي أرى النائبات شتى","https://www.aldiwan.net/poem57035.html","مخلع البسيط"],[400,"هتف القمري في الروض وغنى","https://www.aldiwan.net/poem33384.html","الرمل"],[400,"فاروعني يا صفي الدين ما","https://www.aldiwan.net/poem33983.html","الرمل"],[413,"كاد أن يقضي سقاما ونحولا","https://www.aldiwan.net/poem54027.html","الرمل"],[462,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[503,"تائية القافلة","https://www.aldiwan.net/poem27889.html","البسيط"],[549,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"]],"verses":[["سَلهُمُ أَو فَسَلِ الرَوعَ بِهِم","يَومَ خِدرُ الشَمسِ بِالنَقعِ يُلَطّ",0,"ط",1,0],["سَلَّهُ رَبُّهُ زَماناً فَأَبلى","ثُمَّ ناداهُ رَبُّهُ فَأَجابا",1,"ب",2,0],["سَلَّهُ اللّه للخطوب من الغَيْ","بِ كَسَلِّ المهنَّدِ الْمغْمُودِ",2,"د",1,0],["سله وان عز واستعلت مراتبه","وكان حداً على الأعداء جلافا",3,"ف",2,0],["سلهم أهم في سلوة من عيشهم","أم إنهم في ضجرة المتبرم",4,"م",1,0],["سَلُّهُ الرَكضُ بَعدَ وَهنٍ بِنَجدٍ","فَتَصَدّى لِلغَيثِ أَهلُ الحِجازِ",5,"ز",1,0],["سَلْها لِتعلمَ أيَّ خَطبٍ خَطبها","إن كُنتَ تَبغِي العِلمَ والعِرفانا",6,"ن",2,0],["سَلْهُمْ عَلى شرَفِ الأُبُوَّةِ هَلْ رَعَوْا","مَا سنَّ مِن أدب الحياةِ وأوجبا",7,"ب",2,0],["سلهم أهُمْ للنّاصحين أَحِبَّةٌ","أم هُمْ خُصومٌ تُتَّقَى وعُداةُ",8,"ه",1,0],["سَلْها وقد رجعتْ حَسْرَى مُذمَّمةً","هل زادها اللَّهُ إلا سُوءَ مُنْقَلَبِ",9,"ب",1,0],["سَلْهُمُ مُسْتَخْبِراً أَنفُسَهُم","هل نَجَتْ أنفُسهُمْ مِن قبضتي",10,"ي",1,0],["سلهم عن الشَّرف الموعود كم غدروا","به كم اجتُرِحَتْ في السلم آثامُ",11,"م",1,0],["سلها وإن صمتت فصمت جلالها","أجلى من التصريح والتنويه",12,"ي",2,0],["سله عن الزمن الخؤون وأهله","تره عليما بالزمان خبيرا",13,"ر",2,0],["سله عن الزمن الخئون وأهله","تَرَه عليماً بالزمان خبيرا",14,"ر",2,0],["سله عما شئتَ فيما شِئتهُ","وتعجّب بعد ذا مما يساقْ",15,"ق",1,0],["سَلِّ هَمَّ النَفسِ عَنها","بِعَلَندَاةٍ عَلاةِ",16,"ه",1,1],["سَلهُ يَعفو عنّي ويَشفي السَقيما","يا رَؤوفاً بِالمُؤمنينَ رَحيما",17,"م",2,0],["سَلْ هَامَةَ الْعَلْيَاءِ أَبَا سَلْهَامِ","مِنْ بِرِّهِ الْمُبْرِي مِنَ الإِعْدَامِ",18,"م",1,1],["سَلْهُ لو أبْدى حنيناً","حينها وصْلي يحينُ",19,"ن",1,0],["سَلها أذاكَ المَجدُ كان حقيقةً","أم زخرُفاً حَبلت بهِ الأوهام",20,"م",1,0],["سَلها أَأَودع طَيّها نَشر الهَنا","بشراً لِيَنشُره السُرور بِما نما",21,"م",2,0],["سَلهُنَّ هَل هنَّ غافِلاتٌ","عَن ذاكَ أم ساقَهنَّ حَينُ",22,"ن",1,0],["سلهم هل ذكروا عيشاً مضى","نلت فيه منهم ما أتمنى",23,"ن",2,0],["سلْه من إفضاله ما رُمْتهُ","كلَّ حين في غبوق وصبوح",24,"ح",1,0],["سَلْهم الفضل فهم أهل له","وسواهم يحسب الفضل فضولا",25,"ل",2,0],["سلهُ إذا أدنته عاطفة الرضى","وحذار منهُ إذا نأى وتنكّرا",26,"ر",2,0],["سَلْها إذاً عنْ شجيرةٍ بلا ظلٍّ","يراودُ العقلَ شكٌّ أنّها نَبْتُ",27,"ت",1,0],["سَلْهُ لتعرفَ غَيْبَهُ","لِمْ باعها لمّا اِشتراها",28,"ا",3,0]]}