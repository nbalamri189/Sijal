{"poems":[[55,"أوما رأيت وقائع الدهر","https://www.aldiwan.net/poem30444.html","الكامل"],[55,"يا حبذا فوق الكثيب الأعفر","https://www.aldiwan.net/poem30452.html","الرجز"],[57,"لا تلمني فما علي ملام","https://www.aldiwan.net/poem26116.html","الخفيف"],[95,"لم تشق نفس أنت مسعدها","https://www.aldiwan.net/poem11086.html","أحذ الكامل"],[95,"عيد تجدد فيه مجد عدنان","https://www.aldiwan.net/poem11223.html","البسيط"],[95,"باعوا المخلد بالحطام الفاني","https://www.aldiwan.net/poem11248.html","الكامل"],[95,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[29,"أمسى فؤادك عند الحي مرهونا","https://www.aldiwan.net/poem4439.html","البسيط"],[91,"نطقت حشاشة محسن تتبرم","https://www.aldiwan.net/poem44897.html","الكامل"],[87,"أما وزهر الأنجم","https://www.aldiwan.net/poem7761.html","مجزوء الرجز"],[64,"بعض التماسك أيها القلب","https://www.aldiwan.net/poem52504.html","أحذ الكامل"],[46,"يا عليلا حشا الجوانح نارا","https://www.aldiwan.net/poem30255.html","السريع"],[48,"يا صاح إن حاورت آخر مشفق","https://www.aldiwan.net/poem22177.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[128,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[139,"بالأمس كان خطيبنا بالنادي","https://www.aldiwan.net/poem49174.html","الكامل"],[164,"أترى النسيم إذا سرى من نجده","https://www.aldiwan.net/poem58724.html","الكامل"],[201,"كفكف بربك دمعك الهتانا","https://www.aldiwan.net/poem39950.html","الكامل"],[266,"لم تشتكي عيناك من علة","https://www.aldiwan.net/poem38198.html","السريع"],[280,"بشراك نصر الله مقتبل","https://www.aldiwan.net/poem25538.html","أحذ الكامل"],[303,"لاح في جنح الظلام","https://www.aldiwan.net/poem36799.html","عموديه"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[369,"إذا الحمام على الأغصان غنانا","https://www.aldiwan.net/poem60616.html","البسيط"],[398,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[463,"عاتبت دهري في الجناية لو وعى","https://www.aldiwan.net/poem56132.html","الكامل"],[469,"لندى يديك ويمن رأيك","https://www.aldiwan.net/poem3314.html","عموديه"],[470,"يا صبر أيوب","https://www.aldiwan.net/poem36227.html","عموديه"],[556,"من ذا الطبيب لأدوائي وأوجاعي","https://www.aldiwan.net/poem47698.html","البسيط"],[580,"هيهات ما حالي كحالك","https://www.aldiwan.net/poem3043.html","مجزوء الرمل"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53763","الخفيف"],[659,"","https://poetry.dctabudhabi.ae/diwan/poem/76566","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101520","البسيط"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39190","المجتث"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48832","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48745","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63871","الخفيف"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128268","البسيط"],[1319,"","https://poetry.dctabudhabi.ae/diwan/poem/128286","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95563","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95496","الكامل"],[2010,"","https://poetry.dctabudhabi.ae/diwan/poem/143782","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110338","الكامل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67931","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106839","الكامل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121192","السريع"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60880","السريع"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99066","الخفيف"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93856","الدوبيت"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93901","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204811","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205023","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204695","الخفيف"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138533",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91936","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216362","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111436","الرمل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69925","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81234","الخفيف"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4618,"","https://poetry.dctabudhabi.ae/diwan/poem/203975","الكامل"],[4767,"حسن الخاتمة","https://www.poetsgate.com/ViewPoem.aspx?id=178993",""],[5072,"زمن","https://www.poetsgate.com/ViewPoem.aspx?id=34351",""],[5088,"قد ذبت غير حشاشة وذماء","https://www.poetsgate.com/ViewPoem.aspx?id=178166",""],[5183,"عالي الجناب","https://www.poetsgate.com/ViewPoem.aspx?id=186607",""],[5324,"مرثيّة الغرم .","https://www.poetsgate.com/ViewPoem.aspx?id=207570",""],[5582,"سَلْ بُرْقَةَ العَلَمَيْنِ ثُمَّ البانا","https://www.poetsgate.com/ViewPoem.aspx?id=187309",""],[5718,"السعادة","https://www.poetsgate.com/ViewPoem.aspx?id=214026",""],[5729,"لمَ تشتكي؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=203995",""],[402,"عيد تجدد فيه مجد عدنان","https://www.poetsgate.com/ViewPoem.aspx?id=36469",""],[402,"باعوا المخلد بالحطام الفاني","https://www.poetsgate.com/ViewPoem.aspx?id=36493",""],[5952,"في يوم مولده","https://www.poetsgate.com/ViewPoem.aspx?id=207804",""],[5956,"أ وَلم تضِق ذرعاً بعَون الناس؟","https://www.poetsgate.com/ViewPoem.aspx?id=215974",""]],"verses":[["لَم تَشتَجِر عَنهِ الرِماحُ وَلا","رَدَّ القَضاءَ بِمالِهِ الدَثرِ",0,"ر",1,0],["لَم تَشعُرِ الهاماتُ عِندَ نِثارِها","بِقَرارِها فَكَأَنَّها لَم تُنثَرِ",1,"ر",1,0],["لَم تُشارِك فيها العُيونُ وَلَم تَش","رَب عَلى ماءِ وَجهِها الأَيّامُ",2,"م",1,0],["لم تشق نفسٌ أنت مسعدها","عرفاً ولم يذمم محمدها",3,"د",3,1],["لَمْ تَشْهَدُونَا وَأَنْتُمْ بَيْنَ أَعْيُنِنَا","وَرُبَّ قَاصٍ عَلَى رَغْمِ النَّوَى دَانِ",4,"ن",1,0],["لَمْ تَشْغَلِ الأَيَّامُ عَتْهَا قَلْبَهُ","بِالزِّينَتَيْنِ المَالِ وَالوِلْدَانِ",5,"ن",1,0],["لَمْ تَشْهِدَ الْعُرْبُ يَوْماً فِي فَوَادِحِهَا","كَذَلِكَ الْيَوْمِ مَشْهُوداً وَلا الْعَجَمُ",6,"م",1,0],["لَم تَشكُروا نَمِراً إِذ فَكَّكُم نَمِرٌ","وَاِبنا قُرَيعٍ مِنَ الحَيِّ اليَمانينا",7,"ن",2,0],["لم تشهد العصر القديمة موكبا","ضخماً كموكب نعشه يتقدم",8,"م",1,0],["لم تشرب الصفراء في","الدّباء أو في الحنتم",9,"م",1,0],["لم تشتهرْ بالشرق عزمتُه","إِلّا ودانَ لحدِّها الغَرْبُ",10,"ب",1,0],["لَم تَشِن وَجهَهُ المَليحَ وَلَكِن","جَعَلَت وَردَ خَدِّهِ جُلَّنارا",11,"ر",2,0],["لَم تَشفِ ذَنبي المَكَّتانِ وَإِنَّ لي","شَفَتَينِ أَخلافَ المَعيشَةِ مَكَّتا",12,"ت",2,0],["لم تشرئبّ قلوبٌ من أضالعها","لغير صوتك أو تنصبّ آذانُ",13,"ن",1,0],["لم تشائي قطرة في جدول","بعد هذا المجد ماذا يرتجى",14,"ج",2,0],["لم تشر إذ بلفور","سامك موطناً دنيا بدين",15,"ن",1,0],["لم تشكُ من ألمٍ ولم تك كبرةً","ما بال نارك حولت لرمادِ",16,"د",1,0],["لم تشتبه سبلى عليَّ ولم أبت","متشكيا منه حرارة فقده",17,"د",2,0],["لَم تَشفِ راحُ الذكرياتِ أوامَنا","فعَسى نبُلُّ من اللقاءِ صدانا",18,"ن",2,0],["لم تشتكي عيناك من علة","يا من غدا إنسان عين الكمال",19,"ل",1,1],["لَم تَشْكُ للرُّحُلِ الطِّوَالِ أذىً","حتَّى شَكَتْكَ الخَيْلُ وَالإبِلُ",20,"ل",1,0],["لم تشمه العينُ إلاّ","فاضَ دمعي بانسجام",21,"م",1,0],["لَم تَشتَرِ الدينَ بِالدُنيا وَلَم تَسِمِ","لَقَد شَرَت بَرَّ لَهوٍ في سَنابِلِهِ",22,"ه",1,0],["لم تَشْتَبِكْ بعدُ أطنابُ الخيامِ لنا","ولا المنازلُ ضَمّتْهم وإيّانا",23,"ن",2,0],["لم تُشفِهِم من أَحمدٍ أَفعالُهُم","بِوَصِيِّهِ الطُهرِ الزكيِّ المفضلِ",24,"ل",1,0],["لم تشفه منك الحياةُ بجهدهِ","فشفاهُ موتُك عاجزاً فتودَّعا",25,"ع",2,0],["لم تشكُ من ألم النوى","حتى ظفرت بذي شفايك",26,"ك",1,0],["لم تشرق الشمس إلا من مشارقه","ولم تغب عنه إلا وهي تبتهل",27,"ل",1,0],["لم تشكروا من نسيمي ما هببتُ به","وليس بعد نسيمي غيرُ زَعزاعِ",28,"ع",1,0],["لم تشتَغِل عنِّي بجه","دكَ في جِهادك واشْتِغَالك",29,"ك",1,0],["لم تشنه لما ألَّحت ولكنْ","بدَّلته بالاحمرار اصفرارا",30,"ر",2,0],["لم تشتعل نار المشيب بمفرقي","حتى أراق الدهر ماء شبابي",31,"ب",2,1],["لم تشرق الشمس الا كي تتوّجها","في مفرَق الشَعر حيث الضوء والظلمُ",32,"م",1,0],["لم تَشْتَغِلْ بالتَّصابِي","إِلّا النُّفوسُ الشَّقيَّهْ",33,"ي",2,0],["لم تشك حَرَّاً ولا برداً طبيعتُه","فصيفه في نواحيه كمشتاه",34,"ا",2,0],["لم تشق مصر بغلّاب كشقوتها","بحاسد لكمُ منكم ومحسود",35,"د",1,0],["لم تُشعْشع في الكاسِ إلا اكتسينا","حُللاً من شُعاعها في الطّاس",36,"س",1,0],["لم تَشْهدِ الأرضُ والأجْيالُ مِن قِدَم","إلاَّكَ مُعجِزَةً دانَتْ لَها الاُمَمُ",37,"م",1,0],["لم تشتكي ألم البلا","ءِ وأنت تنتحل المحبة",38,"ب",2,1],["لم تَشُب مالك الطهور برجس","إنما الرجس للثراء خؤونُ",39,"ن",1,0],["لم تشكُ آمنةٌ به حملا ولا","وضعَا ولا ضَرباً من الأشجانِ",40,"ن",1,0],["لم تشف من كمدٍ، ولم تبرد على","كبدٍ، ولم تمسح جوانب داء",41,"ا",2,0],["لم تشهد الفيحا له","مثلاً ولا طوت القرون",42,"ن",1,0],["لم تَشكُ خيلهُم الوجى من رَوحةٍ","إلاَّ انتَعَلنَ من الدِّماءِ قَتيلا",43,"ل",2,1],["لم تشف منيأس وكم نهكت","جسماً فزال شبابُه النضر",44,"ر",1,0],["لم تشرب الراح ولم تنهب ال","فرصة بالدهر ولم تعشق",45,"ق",1,0],["لم تشرعي نهْدَك ألاَّ أنثنى","يشابه العَسَّالةَ الذبَّلا",46,"ل",2,0],["لم تشيد له الوزارة مجداً","لا ولا قيل رفعت مقداره",47,"ر",2,0],["لَم تَشتَبِه قَطُّ بِهَا جزيرَه","في برِّهِم لأنَّها صغيرَه",48,"ه",1,0],["لمت شعثاً حكومتي وهي ألم","من حكم سواي من به الغم ألم",49,"م",1,1],["لمت شتات الحسن ست جهاته","وتفرقت قصدا لجمع الخمس",50,"س",1,0],["لم تشوّه ثقافة العصر فني","عاش فني ولم يزل عربيا",51,"ي",2,0],["لم تشوه بالصبغ يوما وجوها","جعل الحسن عندهن مقاما",52,"م",2,0],["لم تشوه زخارف العصر فني","حافظٌ فنيَ الأصيلُ جماله",53,"ل",2,0],["لَم تشتر الدين بالدنيا وَلَم تسمِ","بحر الحَياة مديد في سواحله",54,"ه",1,0],["لم تشرق الدنيا بنور جبيبنها","إلا تعجل بالحمام أفولها",55,"ل",3,0],["لم تشغل الأَلبابَ فكرةُ غرةٍ","إِلا جَرى المقدور في تفريغها",56,"غ",3,0],["لم تشتروا السلم بأرواحكم","بل اشتريتم نقمة ثانيةْ",57,"ي",2,0],["لم تَشُقني قَطُّ هَبَّاتُ الهَوى","لَهَباً أَشغَفَ مِن ذا الَّلَهبِ",58,"ب",1,0],["لِم تَشتَكي وَمثال الصَبر يرشدكم","دع مِن تَناءي يَومُّ العالمِ الحنفي",59,"ف",2,0],["لَم تَشدها يَد الفُنون وَلا صا","غَت مُحارِيبها يَد البِناء",60,"ا",2,0],["لَم تَشْتَرِ الدِّينَ بِالدُنْيا ولَم تَسُمِ","وَيا لاََِسْيانَ ساهِي القَلْبِ غافِلِهِ",61,"ه",1,0],["لم تشك مني عسرة ألبستها","لوماً ولا جوراً على ما تحكمُ",62,"م",1,0],["لَم تشتكِ الكفَّ التي","كانت لفاطمَ لاطمة",63,"م",2,0],["لم تشأ أن تردَّ دونَ حياءٍ","حقُّها حقُّها فذاك انتحارُ",64,"ر",1,0],["لم تشف من كمد ولم تبرد","على كبد ولم تمنح جوانب داء",65,"ا",2,0],["لم تشقه في زهوها هذه الدن","يا أتته في مشرق خلاب",66,"ب",1,0],["لم تشجكِ الأشعار حين بعثتها","تنساب كالنسماتِ نحو سماكِ",67,"ك",1,0],["لَمْ تَشْتَكِ مِمَّا أُصِيبَتْ مُهْجَتِي","بِالنَّبْلِ إِلاَّ طَرْفَكِ الفَتَّانا",68,"ن",2,0],["لَمْ تُشْعِلِ الحَرْبَ الضَّرُوسَ لِنَاقَةٍ","لَمْ تَعْتَرِفْ بِالقَتْلِ بِالإِجْرَامِ",69,"م",1,0],["لمَ تشتكي تبكي على أعتابي؟؟","وتظن أن الشوق قاد جوابي ؟؟؟",70,"ب",2,1],["لم تشهدونا وأنتم بين أعينينا","ورب قاص على رغم النوى دان",71,"ن",1,0],["لم تشغل الأيام عنها قلبه","بالزينتين المال والولدان",72,"ن",1,0],["لم تشهد الأرض ميلاداً كما شهدت","في يوم مولده بالتيه تلتحف",73,"ف",1,0],["لم تشرئبَّ على أبيك مهاجِماً","بل قلتَ أنت التاجُ فوق الراسِ",74,"س",1,0]]}