{"poems":[[55,"طلوع هداه إلينا المغيب","https://www.aldiwan.net/poem30758.html","المتقارب"],[79,"أمن جانب الغربي نفحة بارح","https://www.aldiwan.net/poem36643.html","الطويل"],[79,"هو النصر باد للعيون صباحه","https://www.aldiwan.net/poem36646.html","الطويل"],[88,"أطل على الأكوان والخلق تنظر","https://www.aldiwan.net/poem10689.html","الطويل"],[85,"أيا علية الكتاب دعوة منصف","https://www.aldiwan.net/poem54322.html","الطويل"],[29,"ألا إنما تيم لعمرو ومالك","https://www.aldiwan.net/poem4438.html","الطويل"],[29,"قولي لهم يا عبل قد خاب قينكم","https://www.aldiwan.net/poem5945.html","الطويل"],[74,"سرى بشبيه البدر آل هلال","https://www.aldiwan.net/poem19482.html","الطويل"],[93,"أبو غازي السلام عليك منا","https://www.aldiwan.net/poem62706.html","عموديه"],[47,"أحاجيك هل للحب كالدار تجمع","https://www.aldiwan.net/poem64680.html","الطويل"],[47,"رأيتك تنجز ما لم تعد","https://www.aldiwan.net/poem65640.html","المتقارب"],[30,"إذا سومت للبأس أغشى صدورها","https://www.aldiwan.net/poem5119.html","البسيط"],[63,"صدودك علم النوم الصدودا","https://www.aldiwan.net/poem51720.html","الوافر"],[54,"تضمنت لي الحاج","https://www.aldiwan.net/poem27199.html","الهزج"],[50,"أما ونجيبة يهوي","https://www.aldiwan.net/poem62585.html","مجزوء الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39595","الطويل"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[47,"أُحاجِيكَ، هل للحُبّ كالدّارِ تَجمعُ","https://www.poetsgate.com/ViewPoem.aspx?id=31224",""],[164,"ليوم منك والإقبال يجري","https://www.aldiwan.net/poem58985.html","الوافر"],[164,"مكانك في الحشا مني مكين","https://www.aldiwan.net/poem59022.html","الوافر"],[173,"ذريني فضرباً بالمهندة البتر","https://www.aldiwan.net/poem1623.html",""],[215,"سلوا برلين عمن حل فيها","https://www.aldiwan.net/poem46341.html","الوافر"],[240,"تأوبني فأرقني خيال","https://www.aldiwan.net/poem31734.html","الوافر"],[275,"قضى الدهر أن أهواك غير ممتع","https://www.aldiwan.net/poem35621.html","الطويل"],[371,"وكم مطلب أعلقته حبل منعم","https://www.aldiwan.net/poem17759.html","الطويل"],[382,"هو الدهر إن تأمنه يخدعك صاحبه","https://www.aldiwan.net/poem66945.html","الطويل"],[382,"أمانا لقلب طال فيه اعتناؤه","https://www.aldiwan.net/poem66968.html","الطويل"],[409,"أشمس اللقا قد راقني منك مطلع","https://www.aldiwan.net/poem33675.html","الطويل"],[447,"أحسن عزاك فخير الصبر في الجزع","https://www.aldiwan.net/poem14459.html","البسيط"],[463,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[466,"رعى الله نجرا زينبيا تألقت","https://www.aldiwan.net/poem15164.html","الطويل"],[466,"أسى وسرور ناصر ومخذل","https://www.aldiwan.net/poem15268.html","الطويل"],[466,"كأن القنا والمشرفية بالضحى","https://www.aldiwan.net/poem15442.html","الطويل"],[511,"أقول وآنست بالليل نارا","https://www.aldiwan.net/poem2433.html","المتقارب"],[543,"أحن إلى مصر وما أنا من مصر","https://www.aldiwan.net/poem48137.html","عموديه"],[556,"مدحتكم علما بأن مدائحي","https://www.aldiwan.net/poem47385.html","الطويل"],[591,"خذوا قودي من أسير الكلل","https://www.aldiwan.net/poem17697.html","المتقارب"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96977","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130207","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70835","الوافر"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145798","المتقارب"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126591","المتقارب"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122860","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112941","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64464","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49985","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111799","الطويل"],[1665,"","https://poetry.dctabudhabi.ae/diwan/poem/146744","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128009","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100995","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132275","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118369","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69347","الوافر"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69412","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53136","البسيط"],[2370,"","https://poetry.dctabudhabi.ae/diwan/poem/121520","المتقارب"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60982","الطويل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132363","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65956","الطويل"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113839","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204745","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204999","المتقارب"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100852","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130126","البسيط"],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70373","الطويل"],[3287,"","https://poetry.dctabudhabi.ae/diwan/poem/116824","الوافر"],[3348,"","https://poetry.dctabudhabi.ae/diwan/poem/81378","الوافر"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123885","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89235","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62761","الوافر"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20535","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108334",""],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132160","البسيط"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44667","الطويل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199085","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94789","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73218","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136664",""],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76687","المتقارب"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141684","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52136","المتقارب"],[4927,"حَدِيْثُ الدُّمُوْع","https://www.poetsgate.com/ViewPoem.aspx?id=29724",""],[4950,"صرفتُ إلى ربِ الأنامِ مطالبِي","https://www.poetsgate.com/ViewPoem.aspx?id=121805",""],[4980,"خَلَعتُ ثِيَابَ الصَّبرِ","https://www.poetsgate.com/ViewPoem.aspx?id=190630",""],[5046,"بغزة","https://www.poetsgate.com/ViewPoem.aspx?id=201079",""],[5055,"حشد روس الفحول","https://www.poetsgate.com/ViewPoem.aspx?id=101193",""],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[5150,"إلام الصمت يا عرب ..؟؟!!!","https://www.poetsgate.com/ViewPoem.aspx?id=202873",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5736,"عناق","https://www.poetsgate.com/ViewPoem.aspx?id=208230",""],[5770,"إلى وردة","https://www.poetsgate.com/ViewPoem.aspx?id=183281",""],[5790,"ألا واقف في باب مولاه واصلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=111964",""],[5829,"يا تراب المجد","https://www.poetsgate.com/ViewPoem.aspx?id=192052",""],[5914,"إِذا كَانَ أنسى فِي ألتزامي لخلوتي","https://www.poetsgate.com/ViewPoem.aspx?id=190299",""],[5953,"فما ضيق صدر المرء فيما ينوبه","https://www.poetsgate.com/ViewPoem.aspx?id=93870",""],[5956,"أ هذا جزائي؟","https://www.poetsgate.com/ViewPoem.aspx?id=183251",""],[6031,"عَزيزٌ أَمرُنا لَكَ بالتعزِّي","https://www.poetsgate.com/ViewPoem.aspx?id=46290",""],[6259,"خليليَّ هل من رقدة أستعيرها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59381&r=&rc=29",""]],"verses":[["فَما ضَحِكَ الدَهرُ إِلّا إِلَي","كَ مُذ بانَ في حاجِبَيهِ القُطوبُ",0,"ب",1,0],["فَما ضَعْضَعَتْ منْهُ لصَوْلَةِ صادِحِ","ولا ذهَبَتْ منْهُ بحكْمَةِ ناصِحِ",1,"ح",1,0],["فَما ضَلّ مَنْ كانَ الإلهُ دَلِيلُه","وما ذَلّ مَنْ حُسنُ اليَقينِ سِلاحُهُ",2,"ح",2,0],["فَما ضاعَ حَقٌّ لَم يَنَم عَنهُ أَهلُهُ","وَلا نالَهُ في العالَمينَ مُقَصِّرُ",3,"ر",1,0],["فما ضرَّكم أنْ تسمحوا لي بكتبها","فتستجزلوا شكري وتستوجبوا حَمدي",4,"د",2,0],["فَما ضَرَبَت لِلتَيمِ في طَيِّبِ الثَرى","عُروقٌ وَلَم تَنبُت وَريقاً غُصونُها",5,"ن",3,0],["فَما ضَرَّ ما قُلتُم مَهاةً تَصَرَّفَت","بِعَطفِ النَقا تَرعى هُجولَ الدَكادِكِ",6,"ك",1,0],["فما ضرَّ هندٌ لو طرقتُ خيامها","على أنني بالسقمِ طيف خيال",7,"ل",1,0],["فَما ضاقَ الكَلامُ بِنا وَلَكِن","وَجَدنا الحُزنَ أَرخَصُهُ الكَلامُ",8,"م",1,0],["فَما ضَيَّعَ التَبذيرُ حَقّي وَلَم يَزلُ","إِلى جانِبِ التَبذيرِ حَقٌّ مُضَيَّعُ",9,"ع",1,0],["فَما ضَرَّني النَقصُ في هِمَّتي","إِذا كُنتَ تُضعِفُ لي ما أَسَل",10,"ل",1,0],["فَما ضَرَّ إِهلاكُ الكَرائِمِ غالِباً","مِنَ المالِ إِذ وارى شَمائِلَهُ القَبرُ",11,"ر",1,0],["فما ضيَّعْتُ فيه الحِلمَ إلاَّ","لأحفَظَ في الهَوى منه العُهودا",12,"د",2,0],["فَما ضَمَّكَ مِضمارٌ","إِلى الجَريِ فَوَقَّفتا",13,"ت",2,0],["فَما ضَمَّت سَقائِفُهُ","فَطَودُ إِزائِهِ الوَحِدُ",14,"د",1,0],["فما ضفَّر الإكليلَ يوماً بمفرِق","ولا حلَّ منه التاجُ يوماً بمعقِدِ",15,"د",1,0],["فما ضل من كان القرآن دليله","ُوما خاب من سيرَ القرآن يسير",16,"ر",1,0],["فَما ضَيّعَ التّبذيرُ حَقّي،","وَلَمْ يَزَلْ،إلى جانبِ التّبديرِ، حَقٌّ مُضَيَّعُ",17,"ع",1,0],["فما ضيعت حق الله فيه","ولا فرطت في خير واجر",18,"ر",1,0],["فما ضحكت ثغور الروض حتى","بكت فيها السحائب وهي جون",19,"ن",1,0],["فَما ضاقَ عَنهُ الوُسعُ غَيرُ مُطالِبٍ","بِهِ المَرءُ في أَكنافِ بَرٍّ وَلا بَحرِ",20,"ر",1,0],["فما ضمن البقاء له صديق","ينادى لا عدمتك يا فريد",21,"د",1,0],["فَما ضَرَعي وَليسَ بي اِنقِيادٌ","لِإِحسانٍ وَلا شَعَفٌ بِحُسنِ",22,"ن",1,0],["فما ضاع دمعُ الأهلِ والصحبِ في الأسى","وقد كنتَ للأحبابِ غيرَ مضيّع",23,"ع",1,0],["فَما ضاقَ عِندي العُذرُ لَمّا تَعَذَّرا","وَلا ضاعَ مِنّي الشُكرُ لَمّا تَيَسَّرا",24,"ر",2,0],["فما ضاء في جوِّ المحبة كوكبٌ","وقد لاح إلّا أظلمته كواكبه",25,"ب",2,0],["فما ضرها والإثم غلَّلَ ربَّها","إذاً لن يَعيبَ الدرَّ يوماً وِعاؤه",26,"ا",3,0],["فما ضرَّنا إلا بياضُ نهارنا","فإن سواد الليل للقلب أنفع",27,"ع",1,0],["فما ضجيعك بدعا في الفراق ولا","هذا التفرق معدوداً من البدع",28,"ع",1,0],["فما ضرّه خذل الذين وراءه","وقدامه منك الحميَّةُ والنصرُ",29,"ر",1,0],["فماضي السطا أمضى من السيف سورةً","وبادي النهى من أوضح الصبح أوضح",30,"ح",1,0],["فماضٍ بكت عيني لفقد كمالهِ","وباقٍ لما فيه من المجد أجْذَلُ",31,"ل",1,0],["فماضٍ وهاماتُ الرجالِ غُمودُه","وجارٍ وساحاتِ الطُّروسِ مذاهبه",32,"ب",2,0],["فما ضَل من بِهُداك اهتَدى","ولاذلَّ من بذراكَ استجَارا",33,"ر",2,0],["فما ضمَّ قبرٌ غيرَ موتٍ ووَحشَةٍ","وإنَّهما في عِيشةِ الضَّغطِ والقَهرِ",34,"ر",1,0],["فما ضرَّ لو أعظمتُمُ ما أتاكُمُ","فلم يَكُ مُولٍ للجميلِ بآسِفِ",35,"ف",1,0],["فما ضَرَّهُ لو سَمح بِالكَرى","وَلوْ ساعةً بَعْدَ ما قَدْ فَعلْ",36,"ل",1,0],["فما ضر ديواني سواد طروسه","إذا لقيت في الحشر منكم صقالها",37,"ل",3,0],["فما ضر لو صافيتمو ووصلتمو","تعالوا إلى الانصاف نحن وأنتمو",38,"و",1,0],["فما ضر الليالي لو","جزتني الوصل بالهجر",39,"ر",1,0],["فما ضاقَ أفقٌ على فارس","تقحَّمَ بالحُرَّدِ الدُرَّعِ",40,"ع",1,0],["فما ضر حاديهم لا سقاه","على ضماء عارض لو رفق",41,"ق",1,0],["فما ضاق عنك العذر عندي ولا نبا","بعهدك ناب من مغيب ومشهد",42,"د",1,0],["فما ضر من يزوى عن المرتع الردى","ويظفر بالاكل الهنى وبالشهد",43,"د",1,0],["فما ضاق ما وسعت يا واسع العطا","ولا قل ما كثرته من عطية",44,"ه",1,0],["فما ضرعت فيه ولا خشعت لهُ","لتَرضى معاليها وتَبقى أُجورُها",45,"ر",3,0],["فما ضرَّ لو كلمت قلباً مكلماً","وانتَ ترى فيهِ لذاتكَ مثبرا",46,"ر",2,0],["فما ضاقت الدنيا عليك برحبها","ولا باب رزق الله عنك بمغلق",47,"ق",1,0],["فما ضمه غيرى ولاشم ورده","سواى وعفو الله يختم بالمسك",48,"ك",1,0],["فما ضرَّنا أن الليالي تنكرت","لنا حقباً والدهر قد يتنكر",49,"ر",1,0],["فماض بيض مواضيه بنيّ على","فتح كما ألزموه آخر الحال",50,"ل",1,0],["فما ضيعة الاطلال نبكي وانما","نؤبن من اعمارنا كل ضائع",51,"ع",1,0],["فَما ضَرَّ الأَحِبَّةَ لَو أَعانُوا","مُحِبَّهُمُ وَمَنزِلُهُم معانُ",52,"ن",1,0],["فَما ضاقَ نادِيهِ وَلا ذَلَّ جارُهُ","وَلا ضاعَ راجِيهِ وَلا خابَ آمِلُه",53,"ل",2,0],["فما ضممت الذي في العطف من هَيَف","حتى استكنَّ الذي في الطرف من شوس",54,"س",1,0],["فما ضرها مرة لا تعد","وما هدها مرة تهزم",55,"م",1,0],["فما ضرني إلاَّ الذي قد نفعته","ولا حَطَّني إلاّ الذي قد رفعته",56,"ت",2,0],["فما ضرَّ أرباب الغرامِ نُحُولُهُم","ولا وكفُ تهطال ا