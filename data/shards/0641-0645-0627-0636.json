{"poems":[[53,"طلوع هداه إلينا المغيب","https://www.aldiwan.net/poem30758.html","المتقارب"],[77,"أمن جانب الغربي نفحة بارح","https://www.aldiwan.net/poem36643.html","الطويل"],[77,"هو النصر باد للعيون صباحه","https://www.aldiwan.net/poem36646.html","الطويل"],[86,"أطل على الأكوان والخلق تنظر","https://www.aldiwan.net/poem10689.html","الطويل"],[83,"أيا علية الكتاب دعوة منصف","https://www.aldiwan.net/poem54322.html","الطويل"],[27,"ألا إنما تيم لعمرو ومالك","https://www.aldiwan.net/poem4438.html","الطويل"],[27,"قولي لهم يا عبل قد خاب قينكم","https://www.aldiwan.net/poem5945.html","الطويل"],[72,"سرى بشبيه البدر آل هلال","https://www.aldiwan.net/poem19482.html","الطويل"],[91,"أبو غازي السلام عليك منا","https://www.aldiwan.net/poem62706.html","عموديه"],[45,"أحاجيك هل للحب كالدار تجمع","https://www.aldiwan.net/poem64680.html","الطويل"],[45,"رأيتك تنجز ما لم تعد","https://www.aldiwan.net/poem65640.html","المتقارب"],[28,"إذا سومت للبأس أغشى صدورها","https://www.aldiwan.net/poem5119.html","البسيط"],[61,"صدودك علم النوم الصدودا","https://www.aldiwan.net/poem51720.html","الوافر"],[52,"تضمنت لي الحاج","https://www.aldiwan.net/poem27199.html","الهزج"],[48,"أما ونجيبة يهوي","https://www.aldiwan.net/poem62585.html","مجزوء الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39595","الطويل"],[45,"أُحاجِيكَ، هل للحُبّ كالدّارِ تَجمعُ","https://www.poetsgate.com/ViewPoem.aspx?id=31224",""],[158,"ليوم منك والإقبال يجري","https://www.aldiwan.net/poem58985.html","الوافر"],[158,"مكانك في الحشا مني مكين","https://www.aldiwan.net/poem59022.html","الوافر"],[167,"ذريني فضرباً بالمهندة البتر","https://www.aldiwan.net/poem1623.html",""],[209,"سلوا برلين عمن حل فيها","https://www.aldiwan.net/poem46341.html","الوافر"],[233,"تأوبني فأرقني خيال","https://www.aldiwan.net/poem31734.html","الوافر"],[268,"قضى الدهر أن أهواك غير ممتع","https://www.aldiwan.net/poem35621.html","الطويل"],[364,"وكم مطلب أعلقته حبل منعم","https://www.aldiwan.net/poem17759.html","الطويل"],[374,"هو الدهر إن تأمنه يخدعك صاحبه","https://www.aldiwan.net/poem66945.html","الطويل"],[374,"أمانا لقلب طال فيه اعتناؤه","https://www.aldiwan.net/poem66968.html","الطويل"],[400,"أشمس اللقا قد راقني منك مطلع","https://www.aldiwan.net/poem33675.html","الطويل"],[438,"أحسن عزاك فخير الصبر في الجزع","https://www.aldiwan.net/poem14459.html","البسيط"],[456,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[459,"رعى الله نجرا زينبيا تألقت","https://www.aldiwan.net/poem15164.html","الطويل"],[459,"أسى وسرور ناصر ومخذل","https://www.aldiwan.net/poem15268.html","الطويل"],[459,"كأن القنا والمشرفية بالضحى","https://www.aldiwan.net/poem15442.html","الطويل"],[504,"أقول وآنست بالليل نارا","https://www.aldiwan.net/poem2433.html","المتقارب"],[536,"أحن إلى مصر وما أنا من مصر","https://www.aldiwan.net/poem48137.html","عموديه"],[549,"مدحتكم علما بأن مدائحي","https://www.aldiwan.net/poem47385.html","الطويل"],[584,"خذوا قودي من أسير الكلل","https://www.aldiwan.net/poem17697.html","المتقارب"]],"verses":[["فَما ضَحِكَ الدَهرُ إِلّا إِلَي","كَ مُذ بانَ في حاجِبَيهِ القُطوبُ",0,"ب",1,0],["فَما ضَعْضَعَتْ منْهُ لصَوْلَةِ صادِحِ","ولا ذهَبَتْ منْهُ بحكْمَةِ ناصِحِ",1,"ح",1,0],["فَما ضَلّ مَنْ كانَ الإلهُ دَلِيلُه","وما ذَلّ مَنْ حُسنُ اليَقينِ سِلاحُهُ",2,"ح",2,0],["فَما ضاعَ حَقٌّ لَم يَنَم عَنهُ أَهلُهُ","وَلا نالَهُ في العالَمينَ مُقَصِّرُ",3,"ر",1,0],["فما ضرَّكم أنْ تسمحوا لي بكتبها","فتستجزلوا شكري وتستوجبوا حَمدي",4,"ي",1,0],["فَما ضَرَبَت لِلتَيمِ في طَيِّبِ الثَرى","عُروقٌ وَلَم تَنبُت وَريقاً غُصونُها",5,"ن",3,0],["فَما ضَرَّ ما قُلتُم مَهاةً تَصَرَّفَت","بِعَطفِ النَقا تَرعى هُجولَ الدَكادِكِ",6,"ك",1,0],["فما ضرَّ هندٌ لو طرقتُ خيامها","على أنني بالسقمِ طيف خيال",7,"ل",1,0],["فَما ضاقَ الكَلامُ بِنا وَلَكِن","وَجَدنا الحُزنَ أَرخَصُهُ الكَلامُ",8,"م",1,0],["فَما ضَيَّعَ التَبذيرُ حَقّي وَلَم يَزلُ","إِلى جانِبِ التَبذيرِ حَقٌّ مُضَيَّعُ",9,"ع",1,0],["فَما ضَرَّني النَقصُ في هِمَّتي","إِذا كُنتَ تُضعِفُ لي ما أَسَل",10,"ل",1,0],["فَما ضَرَّ إِهلاكُ الكَرائِمِ غالِباً","مِنَ المالِ إِذ وارى شَمائِلَهُ القَبرُ",11,"ر",1,0],["فما ضيَّعْتُ فيه الحِلمَ إلاَّ","لأحفَظَ في الهَوى منه العُهودا",12,"د",2,0],["فَما ضَمَّكَ مِضمارٌ","إِلى الجَريِ فَوَقَّفتا",13,"ت",2,0],["فَما ضَمَّت سَقائِفُهُ","فَطَودُ إِزائِهِ الوَحِدُ",14,"د",1,0],["فما ضفَّر الإكليلَ يوماً بمفرِق","ولا حلَّ منه التاجُ يوماً بمعقِدِ",15,"د",1,0],["فَما ضَيّعَ التّبذيرُ حَقّي،","وَلَمْ يَزَلْ،إلى جانبِ التّبديرِ، حَقٌّ مُضَيَّعُ",16,"ع",1,0],["فما ضيعت حق الله فيه","ولا فرطت في خير واجر",17,"ر",1,0],["فما ضحكت ثغور الروض حتى","بكت فيها السحائب وهي جون",18,"ن",1,0],["فَما ضاقَ عَنهُ الوُسعُ غَيرُ مُطالِبٍ","بِهِ المَرءُ في أَكنافِ بَرٍّ وَلا بَحرِ",19,"ر",1,0],["فما ضمن البقاء له صديق","ينادى لا عدمتك يا فريد",20,"د",1,0],["فَما ضَرَعي وَليسَ بي اِنقِيادٌ","لِإِحسانٍ وَلا شَعَفٌ بِحُسنِ",21,"ن",1,0],["فما ضاع دمعُ الأهلِ والصحبِ في الأسى","وقد كنتَ للأحبابِ غيرَ مضيّع",22,"ع",1,0],["فَما ضاقَ عِندي العُذرُ لَمّا تَعَذَّرا","وَلا ضاعَ مِنّي الشُكرُ لَمّا تَيَسَّرا",23,"ر",2,0],["فما ضاء في جوِّ المحبة كوكبٌ","وقد لاح إلّا أظلمته كواكبه",24,"ب",2,0],["فما ضرها والإثم غلَّلَ ربَّها","إذاً لن يَعيبَ الدرَّ يوماً وِعاؤه",25,"ا",3,0],["فما ضرَّنا إلا بياضُ نهارنا","فإن سواد الليل للقلب أنفع",26,"ع",1,0],["فما ضجيعك بدعا في الفراق ولا","هذا التفرق معدوداً من البدع",27,"ع",1,0],["فما ضرّه خذل الذين وراءه","وقدامه منك الحميَّةُ والنصرُ",28,"ر",1,0],["فماضي السطا أمضى من السيف سورةً","وبادي النهى من أوضح الصبح أوضح",29,"ح",1,0],["فماضٍ بكت عيني لفقد كمالهِ","وباقٍ لما فيه من المجد أجْذَلُ",30,"ل",1,0],["فماضٍ وهاماتُ الرجالِ غُمودُه","وجارٍ وساحاتِ الطُّروسِ مذاهبه",31,"ب",2,0],["فما ضَل من بِهُداك اهتَدى","ولاذلَّ من بذراكَ استجَارا",32,"ر",2,0],["فما ضمَّ قبرٌ غيرَ موتٍ ووَحشَةٍ","وإنَّهما في عِيشةِ الضَّغطِ والقَهرِ",33,"ر",1,0],["فما ضرَّ لو أعظمتُمُ ما أتاكُمُ","فلم يَكُ مُولٍ للجميلِ بآسِفِ",34,"ف",1,0],["فما ضَرَّهُ لو سَمح بِالكَرى","وَلوْ ساعةً بَعْدَ ما قَدْ فَعلْ",35,"ل",1,0]]}