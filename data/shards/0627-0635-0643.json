{"poems":[[2,"عفا من آل فاطمة الجواء","https://www.aldiwan.net/poem25055.html","الوافر"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139979","الطويل"],[5776,"رملٌ يسافرُ بالواحة","https://www.poetsgate.com/ViewPoem.aspx?id=199342",""]],"verses":[["أَصَكَّ مُصَلَّمِ الأُذُنَينِ أَجنى","لَهُ بِالسِيِّ تَنُّومٌ وَآءُ",0,"ا",2,0],["أصكُّ به خدي وأحسبُ وقعه","على وجنتي خطواً هناك يداومه",1,"م",2,0],["أصكّتْ وجهها عجباً","عجوزٌ تنجبُ الفيلقْ",2,"ق",1,0]]}