{"poems":[[79,"سلا هل لديها من مخبرة ذكر","https://www.aldiwan.net/poem36463.html","الطويل"],[95,"عيد تجدد فيه مجد عدنان","https://www.aldiwan.net/poem11223.html","البسيط"],[40,"ألم يسأل الركب الديار العوافيا","https://www.aldiwan.net/poem7821.html","الطويل"],[58,"سلا هل كمجدي أو كفخري لفاخر","https://www.aldiwan.net/poem58600.html","الطويل"],[47,"تصدت لنا دعد وصضت على عمد","https://www.aldiwan.net/poem63549.html","الطويل"],[47,"سلاها كيف ضيعت الوصالا","https://www.aldiwan.net/poem65574.html","البسيط"],[82,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[47,"سَلاها كيْفَ ضَيّعَتِ الوِصَالا","https://www.poetsgate.com/ViewPoem.aspx?id=32096",""],[90,"إذا انقضى مارْتُ فاكسر خلفه الكوزا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19529&r=&rc=32",""],[136,"عوجا العناجيج حتى تسالا الطللا","https://www.aldiwan.net/poem54775.html","البسيط"],[214,"أما وعذاب قلبي في هواها","https://www.aldiwan.net/poem13342.html","الوافر"],[280,"يقر بعيني أن قلبي ما قرا","https://www.aldiwan.net/poem25560.html","الطويل"],[303,"صبا المشتاق لما أن رآها","https://www.aldiwan.net/poem36330.html","عموديه"],[308,"سلاه من كان له عاشقا","https://www.aldiwan.net/poem57935.html","السريع"],[308,"سلا هواها المحب لما","https://www.aldiwan.net/poem58095.html","مخلع البسيط"],[463,"إذا صاح وفد السحب بالريح أوحدا","https://www.aldiwan.net/poem56243.html","الطويل"],[558,"سلاه لم استبقى وصال الكواعب","https://www.aldiwan.net/poem68375.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83308","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202077","المتقارب"],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136779",""],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11998","الطويل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11864","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108964","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118369","الطويل"],[2111,"","https://poetry.dctabudhabi.ae/diwan/poem/119201","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53101","الطويل"],[2447,"","https://poetry.dctabudhabi.ae/diwan/poem/198716","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86307","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123524","الطويل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45986","الطويل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105127","الكامل"],[5002,"لغة الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=202661",""],[5183,"حفظ الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=180286",""],[5183,"سَعد وسُعَيد","https://www.poetsgate.com/ViewPoem.aspx?id=180217",""],[5183,"الخيزران والرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180267",""],[5190,"معلقة الجمال في رد الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=175246",""],[5939,"كأنكِ لم تكوني حلم عمري","https://www.poetsgate.com/ViewPoem.aspx?id=178593",""]],"verses":[["سَلا هلْ لدَيْها من مُخَبّرَةٍ ذِكْرُ","وهلْ أعشَبَ الوادي ونمّ بهِ الزّهْرُ",0,"ر",1,1],["سَلْ أَهْلَ نَجْدٍ وَسَلْ أَهْلَ الحِجَازِ بِهِ","تَسْمَعُ أَحَادِيثَ سُمَّارٍ وَرُكْبَانِ",1,"ن",1,0],["سَلاهِبَ مِن أَولادِ أَعوَجَ فَوقَها","فَوارِسُ قَيسٍ مُشرِعينَ العَوالِيا",2,"ي",2,0],["سَلاَ هَلْ كَمَجْدِي أَوْ كَفَخْري لِفَاخِرٍ","وعِنْدَكُما مِنْ قَبْل أَنْ تَسْأَلا خُبْرُ",3,"ر",1,1],["سَلاها بِمَ اِستَحلَلتِ قَتلَ أَخي هَوىً","صَفا لَكِ مِنهُ ما يُجِنُّ وَما يُبدي",4,"د",2,0],["سَلاها كَيفَ ضَيَّعتِ الوِصالا","وَبَطَّت مِن مَوَدَّتِنا الجِبالا",5,"ل",2,1],["سلاهبُ أهدَوْها إليك ولم يكنْ","جزاءٌ لذاكَ من علاك ولا شكرُ",6,"ر",1,0],["سَلاها كيْفَ ضَيّعَتِ الوِصَالا،","وَبَتّتْ منْ مَودّتِنا الحِبَالا",7,"ل",2,1],["سل اهل باريز عن تموز تلق لهم","يوما به كان مشهودا لباريزا",8,"ز",2,0],["سَلاَهُ عَن أهلِهِ إني بِهِم كَلِفٌ","وإِنَّ عَينَ الوَفَا أن تَسأَلاَ فَسَلا",9,"ل",2,0],["سلاها هل سلا عنها فؤادي","فؤادي هل سلا عنها سلاها",10,"ا",3,0],["سَلاهَا وقَلبي ما سَلاهَا بِحالَةٍ","وَفاءً تَحلاه لِمَ اخْتارَت الخَتْرا",11,"ر",2,0],["سلاها هَلْ سَلَتْ صَبّاً شجياً","فقلبي مذ رآها ما سلاها",12,"ا",3,0],["سلاهُ من كان له عاشقاً","قبلي لأجل العارض الزائرِ",13,"ر",1,1],["سلا هواها المحب لما","ضنت بطيف الكرى وظنتا",14,"ت",2,1],["سلاها سقاها ما يُعيد زمانَها","وعيشاً بها ما كان أحلى وأرغدا",15,"د",2,0],["سَلاهُ لِمَ اِستَبقى وِصالَ الكَواعِبِ","وَقَد دَبَّ رَيعُ الشَيبِ بَينَ الذَوائِبِ",16,"ب",1,1],["سَلا هَل لَدَيهِم مِن حَديثٍ لِقادِمٍ","عَنِ الغَربِ يَروي فيهِ غُلَّةَ هائِمِ",17,"م",1,1],["سَلاهُ لماذا استحَبَّ البعاد","فَصَبَّ عليَّ العذَاب الوبيلا",18,"ل",2,0],["سلاها عن محبٍ ما سلاها","وعن قلبٍ قلته وما قلاها",19,"ا",3,1],["سَلا هَل سَلا عَن رَبَّةِ الخالِ وَاللَمى","مُحِبٌّ غَدا مِن ظُلمِها مُتَظَلِّما",20,"م",2,1],["سَلا هَل سَلا أَو هَل تَقَلَّبَ قَلبُهُ","وَإِلّا فَتُنبي بِالكَآبَةِ كُتبُهُ",21,"ب",2,1],["سلاه خليليَّ الرضوخ لعاشقٍ","سلاه بنيران الهوى وسلاه",22,"ا",2,0],["سلاها هل الماضي من العيش راجع","وزيدا بكاء ان يكن غير راجع",23,"ع",1,0],["سلاها لم اسود الهوى في ابيضاضه","وإلا سلاني كيف بُيِّض مسوِّدي",24,"د",2,1],["سَلاَهُ فإنْ أبصرتماه مُلَجْلَجاً","فلا شك نجم الدين قد غاله الردى",25,"د",2,0],["سلاه لم أهل بجمع خيف","بنبل جفونه حول الجمان",26,"ن",1,0],["سَلا هَل سَلا قَلبي هَواها وَهَل لَهُ","سِواها اِذا اِشتَدَّت عَلَيهِ الوَقائِع",27,"ع",1,0],["سلاهب خلدٍ بنو الخلد كانت","لفيلا الفوارس مانحةً",28,"ه",1,0],["سلاها اذا أبصرتماها تجدّ فى","سراها أهل غير العقيق ملاها",29,"ا",3,0],["سَلا هَل سَلا قَلبي هَواكُم وَخاطِري","وَأَنّي وَما فيهِ سِواكُمُ بِخاطِرِ",30,"ر",1,1],["سل أهل سلع عن أساود فرعها","كما بات من كبد بها ملسوع",31,"ع",1,0],["سلْ أهلها خاضُوا ربوعَ كنوزِها","علماً وفلسفَة ًلها من تْرجَما",32,"م",2,0],["سلاه كيف عض على اللجام","فحلق خلف أجنحة الغرامِ",33,"م",1,1],["سلاه .. سلاه أو دعاه فإنه","أخو همة تأبى له أن يفندا",34,"د",2,0],["سلاها قبل هيمنة المساء","أكانت والحبيب على جفاء",35,"ا",2,1],["سلاها والظلام له صُداء","حواليها ورَجْع من زُقاء",35,"ا",2,0],["سلاها والدجى حيران تهوي","به الأنات في أرض عراء",35,"ا",2,0],["سلاها والحبيب على فراش","كأن وطاءه شوك الفناء",35,"ا",2,0],["سَل أَهلَ مَكَّةَ ، وهْوَ سَاكِنُ أَرضِهَا","عُمراً ، كَمَا لَو كَانَ مِن أَبنَائِهَا",36,"ا",3,0],["سَلاهُ الحُرُّ ثُمَّ نفاهُ هَجْرًا","ولمْ يَكُنِ الهَوَى فيها مُلِيما",37,"م",2,0]]}