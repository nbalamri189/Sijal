{"poems":[[315,"سيدي والظنون فيك جميلة","https://www.aldiwan.net/poem59510.html","الخفيف"],[396,"صلة الأرحام بالعلم الذي","https://www.aldiwan.net/poem54498.html","عموديه"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46524","الرجز"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127075","الرمل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45139","الرمل"]],"verses":[["وهو ظن عن الصواب بعيد","وظلام لم يحسنوا تأويله",0,"ل",2,0],["وهو ظل وهو نور وهدى","وحياة ليس يعروها حمام",1,"م",1,0],["وَهوَ ظَليم كانَ بِاليَمامه","حَديثه باق إِلى القِيامه",2,"ه",1,1],["وهو ظلم والعدى قد أوردوا","من دماه السمر مع بعض الظبى",3,"ا",1,0],["وَهوَ ظَبيٌ فارسي وَرَدا","مِن لَدى كِسرى شَهِنشاهٍ جِهان",4,"ن",1,0]]}