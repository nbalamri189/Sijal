{"poems":[[53,"تكايدنا شنطف","https://www.aldiwan.net/poem65454.html","مجزوء المتقارب"],[71,"أأقتل بين جدك والمزاح","https://www.aldiwan.net/poem28551.html","الوافر"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[202,"لا تصيخن لتشويق النديم","https://www.aldiwan.net/poem51886.html","الرمل"],[422,"على مثله تجري الدموع السواجم","https://www.aldiwan.net/poem54054.html","الطويل"],[473,"عندي تبر عنبي المعدن","https://www.aldiwan.net/poem59553.html","الرجز"],[482,"أعن أرض الغميم لمحت نارا","https://www.aldiwan.net/poem15207.html","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37865","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59427","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96686","الرمل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104814","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53168","الرجز"],[2546,"","https://poetry.dctabudhabi.ae/diwan/poem/33947","المديد"],[2897,"","https://poetry.dctabudhabi.ae/diwan/poem/122225","الرجز"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65489","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132709","الخفيف"],[3298,"","https://poetry.dctabudhabi.ae/diwan/poem/105710","المجتث"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62778","الطويل"],[3927,"","https://poetry.dctabudhabi.ae/diwan/poem/113702","المنسرح"],[4691,"حالة العشاق","https://www.poetsgate.com/ViewPoem.aspx?id=177008",""],[5582,"أَبْدَلَتْهُ النَّوَى بَعْدَ خُرَّدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=186882",""],[6131,"ما أنا إلَّا جرمٌ في القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=189524",""]],"verses":[["أشنطف ما يشتهي","جماعك من يظرف",0,"ف",1,0],["أشنِّفُ مسمعيَّ بدرِّ درٍّ","تناثَرَ مِنْ سحائبِكَ السحاحِ",1,"ح",1,0],["أَشنبٌ أفلجٌ ضليعٌ إذا فا","هَ تَلالا كالنورِ منه البهاءُ",2,"ا",2,0],["أشنأ الغصن إذا ضاهى به","مِعْطَفَ النشوانِ خفَّاقُ النسيم",3,"م",1,0],["أُشَنِّفُ سمعي منك باللؤلؤ الَّذي","يَروقُ ولم ينظِمْه في السِّلْكِ ناظِمُ",4,"م",1,0],["إشن مَرَّ في الحانَةِ لَم يَلحَن","مَحاسِنٌ ما اِجتَمَعتَ لِمُحسِنِ",5,"ن",1,0],["أَشُنُّ بها وقد علمَ الأعادي","بأنّي سوفَ أطرُقُهمْ مُغارا",6,"ر",2,0],["أُشنِّف بِالتمداحِ أَسماعَ سامعٍ","فَيبهجُه مَدحي سُروراً ويطربُ",7,"ب",1,0],["أشنب ساجي اللحاظ أحوى","مهفهف القد باتئاد",8,"د",1,0],["أَشنبُ المبسمِ يَحوي ثغرهُ","عسلاً شيبَ بثجّاجِ النطف",9,"ف",1,0],["أَشنَبُ الثَّغرِ أعذَبُ","رِيقُهُ اَحلَى مِن شِهاد",10,"د",1,0],["أشنب يحكي ريقه","ما تجتنيه النحله",11,"ل",2,0],["إشنَّ ناساً في الهَوى حَدَّثوا","أَحدَثوا نَقضَ المَواثيقِ",12,"ق",1,0],["أشنّ كل غارة شعوا على","من يحمها في مقنب او فيلق",13,"ق",1,0],["أشنُّف السمع والأيدي أشرُّفها","بها ويحظى وتحظى في الإجازة بي",14,"ب",2,0],["اشنب الثغر بالتبسم يجلو","اقحوا ناسقته راح شمول",15,"ل",1,0],["أشنف السمع فيه","واذن خير تعيه",16,"ي",2,0],["أشُنُّ عليهم غارةً تَرِدُ الرّدى","وتَسرجُ أمرَ اللهِ فيهم وتَركَبُ",17,"ب",1,0],["أشْنبُ لم تحكِ برق مبسمهِ","يا برق إلا وفاتَكَ الشَّنَبُ",18,"ب",1,0],["أشنّ غارة َحبٍّ آه منْ شغبي","تُرى أينفعني في صبوتي الشغبُ؟",19,"ب",1,0],["أَشْنَبٌ كالزُّلالِ مُجاجَتُهُ","يُشْدِهُ النَّاظِرِينَ مُجَرَّدُهُ",20,"د",2,0],["أشنُّ السلمَ منْ لوحاتِ قافيتي","وَ أنضُو المَوتَ عنْ أهلي وَعنْ جَاري",21,"ر",2,0]]}