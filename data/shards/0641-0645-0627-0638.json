{"poems":[[53,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[9,"كفى بالذي تولينه لو تجنبا","https://www.aldiwan.net/poem21907.html","الطويل"],[35,"لقد أزمعت للبين هند زيالها","https://www.aldiwan.net/poem39116.html","الطويل"],[30,"لقد جشأت نفسي عشية مشرف","https://www.aldiwan.net/poem29594.html","الطويل"],[37,"ألا هل عم في رأيه متأمل","https://www.aldiwan.net/poem7652.html","الطويل"],[51,"ألا قل لنحويك الأخفش","https://www.aldiwan.net/poem64923.html","المتقارب"],[28,"ألا زعمت عرسي سويدة أنها","https://www.aldiwan.net/poem1243.html",""],[28,"عجبت لأقوام تميم أبوهم","https://www.aldiwan.net/poem5371.html","الطويل"],[66,"نم بسر الروض خفق الرياح","https://www.aldiwan.net/poem41356.html","الرجز"],[80,"إذا البدر يطوى في ربوع البلى لحدا","https://www.aldiwan.net/poem31479.html","الطويل"],[74,"بذات المكارم ذاك الألم","https://www.aldiwan.net/poem13252.html","المتقارب"],[75,"صغائر افعال الملوك عظائم","https://www.aldiwan.net/poem69021.html","الطويل"],[75,"بلى هذه تيماء والأبلق الفرد","https://www.aldiwan.net/poem69089.html","الطويل"],[48,"وأحور ذمي طرقت فنائه","https://www.aldiwan.net/poem63278.html","الطويل"],[50,"أأحزنك الألى ظعنوا فساروا","https://www.aldiwan.net/poem63810.html","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147462","البسيط"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67287","الوافر"],[35,"لَقَدْ أَزْمَعَتْ لِلْبَيْنِ هِنْدٌ زِيَالَهَا","https://www.poetsgate.com/ViewPoem.aspx?id=22073",""],[107,"يا حبذا شادن في ثغره ضرب","https://www.aldiwan.net/poem16399.html","البسيط"],[158,"رثت لنحولي في هواها وذلتي","https://www.aldiwan.net/poem59010.html","الطويل"],[347,"شربت من عين الحياة شربة","https://www.aldiwan.net/poem15596.html","الرجز"],[400,"أقول لمن طال شكواهم","https://www.aldiwan.net/poem33372.html","المتقارب"],[436,"إلى أي ذكر غير ذكرك أرتاح","https://www.aldiwan.net/poem34787.html","الطويل"],[436,"أخو ظمأ يمص حشاه سبع","https://www.aldiwan.net/poem34835.html","الوافر"],[456,"سلا دار البخيلة بالجناب","https://www.aldiwan.net/poem56296.html","الوافر"]],"verses":[["فَما ظَفِرَت مِن نَفسِهِ أُمُّ قَشعَمٍ","بِما ظَفِرَت مِن جِسمِهِ أُمُّ عامِرِ",0,"ر",1,0],["فَما ظَنُّكُم بِاللَيثِ يَحمي عَرينَهُ","نَفى الأُسدَ عَن أَوطانِهِ فَتُهُيِّبا",1,"ب",2,0],["فَما ظَبيَةٌ أَدماءُ واضِحَةُ القَرا","تَنُصُّ إِلى بَردِ الظِلالِ غَزالَها",2,"ل",3,0],["فَما ظَبيَةٌ تَرعى مَساقِطَ رَملَةٍ","كَسا الواكِفُ الغادي لَها وَرَقاً نَضرا",3,"ر",2,0],["فما ظَفِرَ المُجرَى إليهم بِرَأسِهِ","ولا عَذَلَ البَاكِي عَليه المُوَلوِلُ",4,"ل",1,0],["فما ظَنُّكمْ بالتي لم تزم","مُ يا للرجال ولم تُخْشَش",5,"ش",1,0],["فَما ظَلَمَت أَن لا تَنورَ وَخَلفَها","إِذا الجَدبُ أَلقى رَحلَهُ سَيفُ غالِبِ",6,"ب",1,0],["فَما ظَنُّكُم بِاِبنِ الحَوارِيِّ مُصعَبٍ","إِذا اِفتَرَّ عَن أَنيابِهِ غَيرَ ضاحِكِ",7,"ك",1,0],["فَما ظَنَنّا الصُبحَ إِلّا دُجىً","وَلا حَسِبنا اللَيلَ إِلّا صَباح",8,"ح",1,0],["فَما ظَنُّكم في وَصفِنا بِمُملَّك","يَكونُ عليٌّ ذو المَعالي لَهُ عبدا",9,"د",2,0],["فَما ظُلمَةُ الجَهلِ إِلّا عَمىً","وَلا نَبوَةُ الفَهمِ إِلّا صَمَم",10,"م",1,0],["فما ظنُّكم ان أيقظ العرض سيفه","إذا كان هذا فعلَهُ وهو قائم",11,"م",1,0],["فما ظنُّكم لو كان جرَّدَ سيفَهُ","إذا كان هذا بعض ما فَعَل الغِمد",12,"د",1,0],["فَما ظَبيَةٌ تَرعى مَساقِطَ رَوضَةٍ","كَسا الواكِفُ الغادي لَها وَرَقاً خُضرا",13,"ر",2,0],["فَما ظَنَّ الغَداةَ بِحَربِ قَيسٍ","لَوَعرَتِها عَلى الناسِ اِستَعاروا",14,"ر",3,0],["فما ظنونك إذ جندي ملائكة","وجندهم بين طواف وبقال",15,"ل",1,0],["فَما ظَفِرَتْ فوارِسُكُمْ بِبَدْرٍ","وما رَجَعُوا إليكُمْ بالسَّواءِ",16,"ا",2,0],["فَما ظَبْيَة ٌ أَدْمَاءُ واضِحَة ُ القَرَا","تنُضُّ إلى بردِ الظِّلالِ غزالَها",17,"ل",3,0],["فَما ظَفَرت بِما قَد كُنت أَطلبهُ","مِن الدِيار وَكانَ المانع الأَدَب",18,"ب",1,0],["فما ظفرت بالنجح يمنى مماذق","ولا عاد من سعي صدوق بخيبة",19,"ه",1,0],["فَما ظَمِئتُ بَعدَها وَلا غَدَت","عالِقَةً في غَيرِ ساقيها يَدي",20,"ي",1,0],["فما ظلموكم بما نالكم","ولكن أنفسهم يظلمونا",21,"ن",2,0],["فما ظَلَموها قائمينَ بشِبهِها","إذا غَوَّروا تحتَ السَّنَوَّرِ أو لاحوا",22,"ح",3,0],["فما ظَفِرُوا بِمِثْلِكَ نَجْمَ سَعْدٍ","بِهِ لَهُمُ إِلَى الأَمَلِ انْتِهاءُ",23,"ا",2,0],["فما ظَهَروا مُخَاطَبةً بوانٍ","وما ظَفِروا مُضارَبَةً بنابي",24,"ي",1,0]]}