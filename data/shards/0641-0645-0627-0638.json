ttps://www.aldiwan.net/poem56296.html","الوافر"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56569","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46665",""],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64472","الطويل"],[1462,"","https://poetry.dctabudhabi.ae/diwan/poem/96473","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118344","الوافر"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10427","المتقارب"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75865","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100262","الطويل"],[3080,"","https://poetry.dctabudhabi.ae/diwan/poem/96123","الطويل"],[3675,"","https://poetry.dctabudhabi.ae/diwan/poem/37522","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85266","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28648","المجتث"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104922","الطويل"],[5090,"دموعُ العين","https://www.poetsgate.com/ViewPoem.aspx?id=184304",""]],"verses":[["فَما ظَفِرَت مِن نَفسِهِ أُمُّ قَشعَمٍ","بِما ظَفِرَت مِن جِسمِهِ أُمُّ عامِرِ",0,"ر",1,0],["فَما ظَنُّكُم بِاللَيثِ يَحمي عَرينَهُ","نَفى الأُسدَ عَن أَوطانِهِ فَتُهُيِّبا",1,"ب",2,0],["فَما ظَبيَةٌ أَدماءُ واضِحَةُ القَرا","تَنُصُّ إِلى بَردِ الظِلالِ غَزالَها",2,"ل",3,0],["فَما ظَبيَةٌ تَرعى مَساقِطَ رَملَةٍ","كَسا الواكِفُ الغادي لَها وَرَقاً نَضرا",3,"ر",2,0],["فما ظَفِرَ المُجرَى إليهم بِرَأسِهِ","ولا عَذَلَ البَاكِي عَليه المُوَلوِلُ",4,"ل",1,0],["فما ظَنُّكمْ بالتي لم تزم","مُ يا للرجال ولم تُخْشَش",5,"ش",1,0],["فَما ظَلَمَت أَن لا تَنورَ وَخَلفَها","إِذا الجَدبُ أَلقى رَحلَهُ سَيفُ غالِبِ",6,"ب",1,0],["فَما ظَنُّكُم بِاِبنِ الحَوارِيِّ مُصعَبٍ","إِذا اِفتَرَّ عَن أَنيابِهِ غَيرَ ضاحِكِ",7,"ك",1,0],["فَما ظَنَنّا الصُبحَ إِلّا دُجىً","وَلا حَسِبنا اللَيلَ إِلّا صَباح",8,"ح",1,0],["فَما ظَنُّكم في وَصفِنا بِمُملَّك","يَكونُ عليٌّ ذو المَعالي لَهُ عبدا",9,"د",2,0],["فَما ظُلمَةُ الجَهلِ إِلّا عَمىً","وَلا نَبوَةُ الفَهمِ إِلّا صَمَم",10,"م",1,0],["فما ظنُّكم ان أيقظ العرض سيفه","إذا كان هذا فعلَهُ وهو قائم",11,"م",1,0],["فما ظنُّكم لو كان جرَّدَ سيفَهُ","إذا كان هذا بعض ما فَعَل الغِمد",12,"د",1,0],["فَما ظَبيَةٌ تَرعى مَساقِطَ رَوضَةٍ","كَسا الواكِفُ الغادي لَها وَرَقاً خُضرا",13,"ر",2,0],["فَما ظَنَّ الغَداةَ بِحَربِ قَيسٍ","لَوَعرَتِها عَلى الناسِ اِستَعاروا",14,"ر",3,0],["فما ظنونك إذ جندي ملائكة","وجندهم بين طواف وبقال",15,"ل",1,0],["فَما ظَفِرَتْ فوارِسُكُمْ بِبَدْرٍ","وما رَجَعُوا إليكُمْ بالسَّواءِ",16,"ا",2,0],["فَما ظَبْيَة ٌ أَدْمَاءُ واضِحَة ُ القَرَا","تنُضُّ إلى بردِ الظِّلالِ غزالَها",17,"ل",3,0],["فَما ظَفَرت بِما قَد كُنت أَطلبهُ","مِن الدِيار وَكانَ المانع الأَدَب",18,"ب",1,0],["فما ظفرت بالنجح يمنى مماذق","ولا عاد من سعي صدوق بخيبة",19,"ه",1,0],["فَما ظَمِئتُ بَعدَها وَلا غَدَت","عالِقَةً في غَيرِ ساقيها يَدي",20,"د",2,0],["فما ظلموكم بما نالكم","ولكن أنفسهم يظلمونا",21,"ن",2,0],["فما ظَلَموها قائمينَ بشِبهِها","إذا غَوَّروا تحتَ السَّنَوَّرِ أو لاحوا",22,"ح",3,0],["فما ظَفِرُوا بِمِثْلِكَ نَجْمَ سَعْدٍ","بِهِ لَهُمُ إِلَى الأَمَلِ انْتِهاءُ",23,"ا",2,0],["فما ظَهَروا مُخَاطَبةً بوانٍ","وما ظَفِروا مُضارَبَةً بنابي",24,"ب",2,0],["فما ظن منه قائماً فهو مائل","ومن ظن منهم بانياً فهو هادم",25,"م",1,0],["فما ظبيةٌ من ظباءِ العقي","قِ ضلَّ بذاتِ الأَضا خِشفُها",26,"ف",3,0],["فما ظالمي من قبضة القهر خارج","ولام من أليم الأخذ يوماً بمفلت",27,"ت",1,0],["فما ظنُّ ذا الواشي بأروعَ ماجدِ","وبداءَ خَوْدٍ حينَ يَلتَقِيان",28,"ن",1,0],["فما ظنوا لنظم جابروه","كسارى بعد هيضته انجبارا",29,"ر",2,0],["فَما ظَبيَةٌ مِن ظِباءِ الحِسا","ءِ عَيطاءُ تَسمَعُ مِنها بُغاما",30,"م",2,1],["فَما ظَفِرت عَيني بِمَن هُوَ صالِحٌ","سِوى مَن بِهِ بَينَ الأَنامِ تَلقَّبا",31,"ب",2,0],["فما ظفرت منهم بكف مسالم","ولا قلب رعديد ولا بقناً مكدي",32,"د",2,0],["فما ظبية الغر التي هاجت الهوى","ولكنما شبهتها أم واصلِ",33,"ل",1,0],["فما ظنُّهمْ في أَمرِه اليومَ بعدَ ما","تَساوَى له من نَصْرِه السّرُّ والجَهر",34,"ر",1,0],["فما ظالم إلا ويجزي بظلمه","وما محسنٌ إلا يوفي ولا هضم",35,"م",1,0],["فَما ظَفِرتُ بِشَيءٍ","تَزولُ فيهِ عُيوبُك",36,"ك",1,0],["فما ظفرت يوماً بمثلكما يدي","ولا ظفرت يوماً بمثلي يداكما",37,"م",2,0],["فما ظنيت أن العشقَ داءٌ","وما خِلتُ الهوى يوماً يجورُ",38,"ر",1,0]]}