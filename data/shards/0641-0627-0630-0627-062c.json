710,"","https://poetry.dctabudhabi.ae/diwan/poem/205717","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114310","الرمل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44638","الكامل"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17788","الطويل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119380","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123491","الخفيف"],[4291,"","https://poetry.dctabudhabi.ae/diwan/poem/142466","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83486","الكامل"],[4978,"تشعير قطعة لأخناتون","https://www.poetsgate.com/ViewPoem.aspx?id=183244",""],[5057,"زارني في المنام","https://www.poetsgate.com/ViewPoem.aspx?id=198052",""],[5136,"أول الحب في القلوب علوقا","https://www.poetsgate.com/ViewPoem.aspx?id=121626",""],[5212,"مولِدُ التأريخ","https://www.poetsgate.com/ViewPoem.aspx?id=212078",""],[5261,"رمضان الخير","https://www.poetsgate.com/ViewPoem.aspx?id=212889",""],[5493,"غُفرانَكَ اللّهمَّ","https://www.poetsgate.com/ViewPoem.aspx?id=196958",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5672,"قبران","https://www.poetsgate.com/ViewPoem.aspx?id=206554",""],[5689,"ضاقت بمن في ظلها الآجام","https://www.poetsgate.com/ViewPoem.aspx?id=143413",""],[5864,"يا أبي","https://www.poetsgate.com/ViewPoem.aspx?id=190488",""],[5874,"مَوْقفُ الشِّعْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=212191",""],[5897,"لا تعبث بقلب امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=164506",""],[5961,"الدعاء في عرفات","https://www.poetsgate.com/ViewPoem.aspx?id=199815",""],[6068,"كتب الإله على الرجال خسارة","https://www.poetsgate.com/ViewPoem.aspx?id=194948",""],[4442,"بالأعالي فتنت لا بالأسافل","https://www.poetsgate.com/ViewPoem.aspx?id=171204",""],[6160,"على نَوافِذِ الغَيبِ ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87103&r=&rc=20",""],[5377,"إشراق النبوة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79569&r=&rc=25",""],[5126,"صَدْمَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87817&r=&rc=32",""]],"verses":[["فإذا جاءَتْ تحيّاتُ الصَّبا","سجَدَ الدّوْحُ خُشوعاً وركَعْ",0,"ع",1,0],["فإذا جَنَيْتُ بناظِري منْ زَهْرِها","كَتَبَ الهَوى ذَنْباً علَيّ جَنَيْتُهُ",1,"ت",2,0],["فَإِذَا جَعَلْتَ الصَّبْرَ مَفْزَعَ مُعْضِلٍ","عَاجَلْتَ عِلَّتَهُ بِطِبِّ طَبِيبِ",2,"ب",1,0],["فَإِذا جادَتِ الدُجى وَضَعوا القِد","حَ وَجُنَّ التِلاعُ وَالآفاقُ",3,"ق",1,0],["فَإِذَا جَاوَرتْ فِي سَيْرِهَا مِنْ زَهْرَةٍ","هَمَّتْ بِأَخْذِ ذُيُولِهَا وَبِلَثْمِهَا",4,"م",3,0],["فَإِذَا جَرَى ثُمَّ اسْتَوَى فَوْقَ الثَّرَى","ظَهَرَتْ لَهُمْ أُعْجَوبَةَ الإِنْسَانِ",5,"ن",1,0],["فَإِذا جالَستَهُ صَدَّرتَهُ","وَتَنَحَّيتَ لَهُ في الحاشِيَه",6,"ي",2,1],["فَإِذا جوزيتَ قَرضاً فَاِجزِهِ","إِنَّما يَجزي الفَتى لَيسَ الجَمَل",7,"ل",1,0],["فإذا جرَّد اليراع فحدّث","عن سطا كفهِ حديث الجنود",8,"د",1,0],["فإذا جَنَى جانٍ تَغَاضَتْ عَيْنُهُ","عن ذنبه فكأنه ما أذنبا",9,"ب",2,0],["فإذا جاءني رسولُك أحكم","ت أموري بالأكل قبل المجاعه",10,"ع",2,0],["فإذا جَرتْ ريحٌ فطاب نسيمُها","فاعدِلْ مخافة يوم ريح سافيه",11,"ف",3,0],["فَإِذا جاءَ غَيرُهُ أَنكَرَتهُ","فَرَأَينا الحَميدَ غَيرَ حَميدِ",12,"د",1,0],["فَإِذا جاءَ إِلَيهِ ناصِحٌ","شَكَّ في نِيَّتِهِ فَاِنتَهَرَه",13,"ر",2,0],["فَإِذا جَرى ذِكرُ الشُعوبِ بِمَوضِعٍ","شَمَخَت وَطَأطَأَ رَأسَهُ العُثماني",14,"ن",2,0],["فَإِذا جِئتَ وَغابَ ال","ناسُ طُرّاً لا يُهِمُّه",15,"م",2,0],["فإذا جددت فأبلت فأعيت","جاءها حينها بلا ميعاد",16,"د",1,0],["فإذا جئت ملكة تملك البر","رَ بيمنى وباليسار البحارا",17,"ر",2,0],["فَإِذا جَاءَت وَراحَت","زيدَ في البَيتِ وَصيفَه",18,"ف",2,0],["فَإِذا جازَ الثُرَيّا لِلثَرى","جَرَّ كَالطاووسِ ذَيلَ الخُيَلاء",19,"ا",2,0],["فَإِذا جَرى رَشداً وَيُمناً أَمرُكُم","فَاِمشوا بِنورِ العِلمِ فَهوَ زِمامُ",20,"م",1,0],["فَإِذا جَرى مِن غايَةٍ وَجَرَيتَ مِن","أُخرى التَقى شَأواكُما في المَنصِفِ",21,"ف",1,0],["فإذا جرى للمجدِ نالَ صَبوحَه","سبقاً ونالَ الناسُ منه غَبُوقا",22,"ق",2,0],["فإذا جرَت حَبَباً على أَقْدَاحِهِمْ","جعلوكَ رَيحاناً على الأقداح",23,"ح",1,0],["فَإِذا جِئتُ زائِراً حَجَبَت وَج","هَكَ عَنّي كَآبَةٌ وَبُسورُ",24,"ر",1,0],["فإذا جِئتَنَا فجىءْ بنَديمٍ","وسَماعٍ ومجلِسٍ وشَرابِ",25,"ب",1,0],["فإذا جفاكَ الهاجرُ الناسي","وقسا عليكَ المشفقُ الحدِبُ",26,"ب",1,0],["فإِذا جالَ حِمَارٌ مُوحِشٌ","ونَعَامٌ نافِرٌ بَعدَ عَنَن",27,"ن",1,0],["فَإِذَا جَارَتِ المَمَالِكَ فِي تَمْ","جِيدِهِ مَنْ أَحَقُّ بِالتَّمْجِيدِ",28,"د",1,0],["فإذا جفاني الشعرُ يومَ رِثائِهِ","فلقد رثَتْه مآثرٌ ومَساعي",29,"ع",2,0],["فإذا جئت مبكيا فلأنّي","جئتكم من مماتكم ومماتي",30,"ت",2,0],["فإذا جاء غيره أنكرته","فرأينا الحميد غير الحميد",31,"د",1,0],["فإذا جئتنا فجئْ بنديمٍ","وسماعٍ ومجلسٍ وشرابِ",32,"ب",1,0],["فإِذا جهنم جنة وإِذا الأسى","نعمى وإِذ نوب الحياة أغاني",33,"ن",2,0],["فَإِذَا جِئتَهُ نَزَلتَ بِأمنٍ","وأمَانٍ وصَيِّبٍ مِدرَارِ",34,"ر",1,0],["فاذا جحدتُ هواه أو أنكرته","شهدت عليَّ من الهوى آثاره",35,"ر",2,0],["فَإِذا جاءَت المَنِيَّةُ قالَت","حيلَة البُرءِ لَيسَ في البُرءِ حيلَه",36,"ه",1,0],["فإذا جَعَلتَ فِدامها قُدَّامَها","أحرَزتَ من دُنياكَ ما لم تحرز",37,"ز",1,0],["فإذا جلستَ بجانبي فكأَنَّني","قارنتُ من شمس النهار ضُحاها",38,"ا",3,0],["فإذا جاوزت مرتقياً","سدرة الأسرار والقدر",39,"ر",1,0],["فإذا جنّتي سرابٌ وآما","لِيَ بيدٌ تضجُّ بالأهوال",40,"ل",1,0],["فإذا جنبت فما ترعاك والدة","ولم يفض من حناياه عليك أب",41,"ب",1,0],["فَإِذا جَرى دَمعي فَذَلِكَ مِن دَمي","ماءٌ جَرى مِنّي لَكُم وَجَرى لي",42,"ل",2,0],["فَإِذا جَرَت مِنها الدُموعُ فَإِنَّما","تَجري لِسُقيا ذِكرِكَ العَطشانِ",43,"ن",1,0],["فإذا جرى مَرَحاً بميدان الصِّبا","مُهْرُ الهَوى ألجمتهُ بعفَافي",44,"ف",2,0],["فإذا جنيت حقيقة","لقيتني عفواً وعذرا",45,"ر",2,0],["فإذا جادَ فغيثٌ مُمْطِرٌ","وإذا حاربَ فالليث الهصور",46,"ر",1,0],["فإذا جاد فما وبل الحيا","وذا جادل خصماً أفحما",47,"م",2,0],["فإذا جادَ قلتُ حاتمُ طيٍّ","وإذا صالَ قلتُ كعبُ بنُ مامَهْ",48,"م",2,0],["فإِذا جازَ تِسْعَةً وثَلاثاً","جَلَّ عن أَنْ يَحُدَّهُ تَشْبِيهُ",49,"ه",1,0],["فإذا جلت في الصبابة كنت ال","زهر مسا ونكهة ورواء",50,"ا",2,0],["فاذا جَرى لمنُازلٍ وجادلٍ","صُرِعَ الكَميُّ به وحُلَّ المشكل",51,"ل",1,0],["فإذا جارَ كُنتَ قامِعَ طاغيهِ","وإنْ مدَّ جُدْتَ بالإِنْعامِ",52,"م",1,0],["فإذا جَرى للمكْرُماتِ تقاصَر","الهوجُ الزَّعازِعُ والجَوادُ الجَرْشَعُ",53,"ع",1,0],["فإذا جاءَنا بِلا بَلَد ٍ","فَقَناديلُنا لَه ُ بَلَد ُ!",54,"د",1,0],["فإذا جنهم اللي","ل رأوا بِراً وبِشراً",55,"ر",2,0],["فإذا جاءَ أمرُهُ فرَّ منكَ","آخذاً أغْلى ما حَباكَ الكريمُ",56,"م",1,0],["فإذا جفا التُّربَ السحابُ فعنده","ما اِختَرتَ مِن سحٍّ ومِن إطباقِ",57,"ق",1,0],["فإذا جاءهم دليلٌ نفاه","ورمته الفهوم في الإيهام",58,"م",1,0],["فإذ أجابوه إلى التسليم","للحكم بالكتاب والمعلوم",59,"م",1,0],["فإِذا جُدْتَ كان طَلُّك وَبْلا","بالأَيادي وَوَبْلُ غَيرِكَ طَلاًّ",60,"ل",2,0],["فإِذَا جَادَ فالعبيدُ مَوالٍ","وإِذا صَال فالموَالي عَبيدُ",61,"د",1,0],["فإِذا جادَ ما السّحابُ سَحابٌ","وإِذا صَالَ ما الأُسود أُسودُ",62,"د",1,0],["فإذا جئتُ للخروج تحامي","تم كأني أتيتكم للخراج",63,"ج",1,0],["فاذا جئت مهبط الوحي فاندب","من لوي جحا جحاً غير نكس",64,"س",1,0],["فإذا جرى طَلْقاً أضرّ به","نَفَسُ الصبا فتشوَّش اللِّمَمُ",65,"م",1,0],["فإذا جنى المعروفِ في غصن امرئٍ","أفغى أمنتُ على جَناه من الفغى",66,"غ",2,0],["فَإِذا جَعَلتَ دُروبَ فا","رِسَ خَلفَهُم دَرباً فَدَربا",67,"ب",2,0],["فَإِذا جاءَ راغِبٌ","في سَما كبرها سَمَت",68,"ت",1,0],["فإذا جرّد اليمانيّ أو هز","الردينيّ منه زند صليب",69,"ب",1,0],["فإذا جاء الشتا تبدله","بعباء كي تقيني برده",70,"د",2,0],["فإذا جرت ذكراكم","فيها يقوم المقعَدُ",71,"د",1,0],["فَإِذا جَلا لَكَ غُرَّةً في طَرَّةٍ","أَلوى بِقَلبِكَ أَبلَجٌ في أَدعَجِ",72,"ج",1,0],["فَإِذا جَمَعتَ صَفاءَهُ وَصَفاءَها","فَاِقذِف بِكُلِّ مُلِمَّة مِن حالِق",73,"ق",1,0],["فَإِذا جَالَستَهُ لَم","تَدرِ مَن مِنَّا الجَلِيسُ",74,"س",1,0],["فَإِذا جالَ فَلا بَأس بِه","وَحَذار مِنهُ مَهما وَقَفا",75,"ف",2,0],["فإذا جاء حين لقياك فافتح","باب قربي واذن لنا بالزياره",76,"ر",2,0],["فإذا جاءَنا الخريف","فمااخضرَّ بعدُ عود",77,"د",1,0],["فإذا جاءت القريحة بيضا","ء ففضلي اليراعة السوداء",78,"ا",2,0],["فإذا جهلت من امرىء أعراقهُ","وقديمه فانظر إلى ما يصنع",79,"ع",1,0],["فإذا جفتكَ وعنَّفتكَ مَليحةٌ","جاهدْ بنارِ الحبِّ أَيَّ جِهاد",80,"د",1,0],["فَإِذا جَرى وَصف الجَمال وأشربوا","خمر الوصال حلا لهم سكر الثنا",81,"ن",2,0],["فإِذا جرى دمع المنابل بعده","فالشعر مقروح الفؤاد مُوَجَّع",82,"ع",1,0],["فاذا جال فاللحاظ سيوف","واذا مال فالقوام فناة",83,"ه",1,0],["فإذا جاء أمرهُ لم يُؤخَّر","وإذا حُمَّ فالمقدَّرُ دانِ",84,"ن",1,0],["فإذا جاءَ وَعدُه تتوارى","آفلاتٍ ويختفى النَّيِّرانِ",84,"ن",1,0],["فإذا جرى وصفاكما","سبق المثنّى المفرد",85,"د",1,0],["فإِذا جرى ذِكْرُ المُلوك فَعَنْهما","بالفضل أَلسنةُ الزَّمان تُتَرْجم",86,"م",1,0],["فإذا جاء رسولي","فليُجِبْ أو يَدْعُ عبدَه",87,"د",2,0],["فإذا جَرَى وَصْفٌ أَوِ اسْمٌ مطلقٌ","باللَّفْظ فَهْوَ بها إِليه مُواصِلُ",88,"ل",1,0],["فإذا جئتما الديار فعما","حل في بعد أهلها خبراها",89,"ا",3,0],["فإذا جرى ذكر الوصال لها","كادت من الأغماد تنسكب",90,"ب",1,0],["فإذا جلونا من رياضك روضة","بعثت لها نعماك صوب عهاد",91,"د",1,0],["فإذا جهلت الأمر في حاليهما","فدليل ما والاه في تقواهما",92,"م",2,0],["فَإِذا جَمَعتَ مَقَالَتَيهِ أنتَجَا","كَذِباً وزُوراً واضِحَ البُهتَانِ",93,"ن",1,0],["فَإذَا جَعَلتُم لَفظَةَ التَّركِيبِ بال","مَعنَى الصَّحِيحِ أمَارَةَ البُطلاَنِ",93,"ن",1,0],["فاذا جاءَ الأيّان تَجَ","ولَّت منها أزمٌ ذُلُلُ",94,"ل",1,0],["فإِذَا جئت سمّي المُصْطَفى","وهو مثلُ البدرِ يجلو الظُّلَمَا",95,"م",2,0],["فاذا جرى وشَّى الغمامُ طروسَه","وتفتَّحت بسطوره الأكمام",96,"م",1,0],["فإذا جئتم الحما يا رفاقي","بلغوا مالكي سلاما سلاما",97,"م",2,0],["فإذا جاد باللآليء فانظم","وإذا ما أبى فلا إكراها",98,"ه",2,0],["فاذا جرى فيها نسيم صبابة","نثرت ثمار الوجد عبراتها من",99,"ن",1,0],["فاذا جسمي مشلول القوى","وإذا أجنحتي منكسرات",100,"ت",1,0],["فإذا جهلت الفرق","بينهما فدونك فاسألي",101,"ل",2,0],["فاذا جسمت لكانت نجوماً","للدجى الَّا انها لم تجسم",102,"م",1,0],["فإذا جفاه المجدُ عيبت نفسه","وإذا جفاه الجدُّ عيب زمانه",103,"ن",2,0],["فَإِذا جئتهم لِتَخفيف حمل","قوّس الظهرَ أَثقَلوا الأَحمالا",104,"ل",2,0],["فَإِذا جَمَعتَهُم تَقصد غَلطة","تَرقيك مِن نَظر الحَسود إِذا رَنا",105,"ن",2,0],["فإذا جاورتها جاوزتها","غافرًا ما شئت والحب غفور",106,"ر",1,0],["فَإِذَا جَاوَرَ رِيحٌ طَيِّبًا","طَيَّ