em.aspx?id=191666",""],[4767,"رب الفضائل","https://www.poetsgate.com/ViewPoem.aspx?id=178735",""],[4119,"إني لأغنى الناس عن عصبية","https://www.poetsgate.com/ViewPoem.aspx?id=16088",""],[585,"ماذا الجمود وجرعاء الديار دم","https://www.poetsgate.com/ViewPoem.aspx?id=161903",""],[5111,"هَامَانُ يَعْرِفُنِي","https://www.poetsgate.com/ViewPoem.aspx?id=212238",""],[5277,"هي","https://www.poetsgate.com/ViewPoem.aspx?id=192304",""],[5277,"بارودُ الضنى","https://www.poetsgate.com/ViewPoem.aspx?id=206329",""],[5409,"تأتي الحياة فترتدينا برهةً","https://www.poetsgate.com/ViewPoem.aspx?id=155301",""],[5464,"سميرَ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=125410",""],[5582,"أَنَّى يَكُونُ مِنَ الغَرامِ جُحُودُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=186884",""],[5582,"دَعِينِي وَيْكِ عاذِلَتِي دَعِينِي","https://www.poetsgate.com/ViewPoem.aspx?id=187306",""],[5582,"بَكَى وَناحَ غَراماً فِي الهَوَى ناحَا","https://www.poetsgate.com/ViewPoem.aspx?id=186790",""],[5582,"أَضَرَّ بِكَ الوَجْدُ لَمَّا تَمادَى","https://www.poetsgate.com/ViewPoem.aspx?id=63488",""],[5605,"حميمية لقاء..","https://www.poetsgate.com/ViewPoem.aspx?id=159461",""],[5751,"طِفلة الورد","https://www.poetsgate.com/ViewPoem.aspx?id=214766",""],[5751,"رسْمٌ بذاكرةِ اللَّيلَك","https://www.poetsgate.com/ViewPoem.aspx?id=214774",""],[402,"أيبلغ منك سمع المستجيب","https://www.poetsgate.com/ViewPoem.aspx?id=35350",""],[5829,"الى محمد","https://www.poetsgate.com/ViewPoem.aspx?id=153239",""],[5829,"إنه شعبان","https://www.poetsgate.com/ViewPoem.aspx?id=204021",""],[5851,"وعد الغمام للأرض","https://www.poetsgate.com/ViewPoem.aspx?id=175307",""],[5956,"هذي الأنوثة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182150",""],[5956,"ذكرى مهاتفة الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=194648",""],[5956,"غرِّدْ أيا قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=200909",""],[6045,"نبضة ألم ،، وومضة أمل","https://www.poetsgate.com/ViewPoem.aspx?id=176833",""],[520,"العلم مذ كان محتاج الى العلم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577651",""],[5555,"مُعَلَّقَةٌ لِلِاحتِفَاءِ بِالْهَشَاشَةِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87404&r=&rc=0",""],[6317,"هذي الرّبوع بوجهها الخلّاب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86084&r=&rc=0",""]],"verses":[["تنِمُّ إلينا بالسّرورِ مَزاهِرٌ","يُغازِلْنَ أطْرافَ البَنانِ المُخَضَّبِ",0,"ب",1,0],["تَنْميكَ عنْ قدَمٍ في العُرْبِ راسِخةٍ","والطِّرْفُ يُعْرَفُ منْهُ العِتْقُ إنْ صَهَلا",1,"ل",2,0],["تَنْمِيهِ مِنْ أَبْنَاءِ سَعْدٍ أُسْرَةٌ","كَرُمَتْ فَنِعْمَ الْمُنْتَمَى وَالْمُنْتَمِي",2,"م",2,0],["تَنْمِي عُلاَهَا مِنَ الأَنْصَارِ سَادَتُهَا","فِي مَعْشَرٍ ككُعُوبِ الرُّمْحِ مُنْتَظِمِ",3,"م",1,0],["تَنْمِيهِ مِنْ أَبْنَاءِ نَصْرٍ سَادَةٌ","حَاطُوا الْعِبَادَ وَدَمَّرُوا اْلأشْرَاكَا",4,"ك",2,0],["تَنْمِيهِ منْ أبْناءِ نَصْرٍ سادَةٌ","سَنّوا الهُدَى والعَدْلَ والإصْلاحا",5,"ح",2,0],["تنْمي الحميد من الخِصال وتنقي","ما كان منها بالفَخار خَليقا",6,"ق",2,0],["تنمو الزروع بسَقيِه فغِلاله","كل العراق ببعضها يقتات",7,"ت",1,0],["تَنمي كَما تَنمي أَرومَتُها","بِمَحَلِّ أَهلِ المَجدِ وَالفَخرِ",8,"ر",1,0],["تنمّ خدَّاه بقتل الورَى","فخدّه وردٌ ونمَّام",9,"م",1,0],["تنمرتُ للأعداء من دون صاحبي","وحاميتُ عن تاجٍ به أتجمّلُ",10,"ل",1,0],["تَنَمّى بِها اليَعسوبُ حَتّى أَقَرَّها","إِلى مَألَفٍ رَحبِ المَباءَةِ عاسِلِ",11,"ل",1,0],["تُنميهِ مِن كَعبِهِ وَحارِثِهِ","أَملاكُ أُكرومَةٍ وَأَقيالُ",12,"ل",1,0],["تَنميهِ مِن سَلَفَي غَنِيٍّ أُسرَةٌ","بيضُ الوُجوهِ إِلى المَكارِمِ تَنتَمي",13,"م",2,0],["تَنْمي على الأعداءِ عَزْمَتُهُ","والزّندُ أوَّلُ نارِهِ شرَرُ",14,"ر",1,0],["تَنميكَ في قُلَلِ المَكارِمِ وَالعُلى","زُهرٌ لِزُهرِ أُبُوَّةٍ وَجُدودِ",15,"د",1,0],["تَنميهُمُ الدُنيا إِلى صِنهاجَةٍ","وَالدينُ يُنميهُم إِلى الأَنصارِ",16,"ر",1,0],["تُنمى إِلَيهِ مِنَ الحَرائِرِ حُرَّةٌ","تَغنى بِسُؤدُدِ ذاتِها أَن تَنتَمي",17,"م",2,0],["تنميهِ في دُنيا البيانِ رَوائعٌ","منها رواكدُ ما تَرِيمُ وجُفَّلُ",18,"ل",1,0],["تَنَمَّسَ مِنّا بِالدِيانَةِ مَعشَرٌ","وَقَد بَطُلَت عِندَ اللَبيبِ النَوامِسُ",19,"س",1,0],["تَنِمُّ أدْراعٌ بأسْرارِها","وإنْ تُسَلْ عن سِرّها تَكْتُم",20,"م",1,0],["تَنِمُّ بِرَيَّا جَنَّةِ الخُلْدِ رَيَّةٌ","لمن قطفَ الأزهارَ من رَوْضِكَ الغَضِّ",21,"ض",1,0],["تنمرّ الغربُ واحمَّرت مخالبُه","وأرهفت نابَها للفتكِ ذُؤبانُ",22,"ن",1,0],["تنمو الكرامةُ فيها والإباءُ، كما","ينمو على الشَّجر التُّفاحُ والعنب",23,"ب",1,0],["تنمي علاك من الأنصار سادتها","في مفخر ككعوب الرمح منتظم",24,"م",1,0],["تنميه من أبناء سعد أسرة","كرمت فنعم المنتمى والمنتم",25,"م",1,0],["تنُمَّ الشَمال به للجَنوب","ويُنبي به الغاديَ الرائح",26,"ح",1,0],["تنُم بطيب شذاك البلاد","كما الروضُ فاح بأزهاره",27,"ر",2,0],["تنمّر كلّ خوّان لئيم","وتاه النذل واختال الوضيع",28,"ع",1,0],["تَنَمَق طَيها أَيدي النَعامي","وَتَبعثها إِلى ملك الرَبيع",29,"ع",1,0],["تنمُّ ولم تفضّ ولا عجيبٌ","أيحجبُ نفحةَ البدرِ الخِتامُ",30,"م",1,0],["تنميه دوحة سؤدد أغصانها","كل بعنصره الكريم وريقُ",31,"ق",1,0],["تُنمي إِلى أَقصى الخُطوبِ نُفوسُنا","وَتَعيشُ بِالأَمَلِ المُؤَمَّلِ وَالمُنى",32,"ا",1,0],["تنميه صِيدٌ أُسدُ حربٍ ما لهم","إلا القواضب والرماح غَرِيفُ",33,"ف",1,0],["تنمُّ عن جِسمي كما نَمّ عَن","نَفسِي غزيرُ المدمَع المُرسَلِ",34,"ل",1,0],["تنم سناً بالاكتنان سناؤها","وتكمل حاشاها السرار سرورها",35,"ر",3,0],["تنمّ به رياح المسك عرفا","وَشمس الحسن من خلف الخمار",36,"ر",1,0],["تُنْمَى إِلى رَجَبٍ عُلاكَ تَفَرُّداً","وَحُلاكَ طِيبَ شَذىً إلى نِيسانِ",37,"ن",1,0],["تَنْمِيه آباءٌ كِرامٌ لِلعُلى","كَثروا النجوم مَقانِبا ومَناقِبا",38,"ب",2,0],["تُنْمى نِكايَتُهُ في الرُّوم إذْ جعلت","بالقَرْحِ توجعه والجرْح تنكؤُهُ",39,"ا",2,0],["تُنمى الْفُرُوعُ إِلى الأُصُولِ وَخَيْرُها","وَأَجَلُّها فَرْعٌ إِلَيْكَ نَماؤُهُ",40,"ا",3,0],["تَنَمّى بِها اليَعسوبُ حَتّى أَوى بِها","إِلى نُحُتٍ صَفراءَ سُمرٍ عُروقُها",41,"ق",3,0],["تَنْميكَ أَمْلاكٌ يَمانِيَةٌ","بِيضٌ كَدُرِّ العِقْدِ قد نُسِقوا",42,"ق",3,0],["تنمو بلاياه كأن جديدها","بحرٌ يعوم الهالكون بمائه",43,"ا",3,0],["تَنمي بِنَهّاضٍ إِلى حارِكٍ","تَمَّ كَرُكنِ الحَجَرِ الأَصلَدِ",44,"د",1,0],["تنمَّر لي دَهْري فكُنْ أنتَ ناصري","وأسْلَمني حظّي فكنْ أَنتَ مُنجدي",45,"د",2,0],["تَنمّ عليَّ دموع العيون","ولمْ أرى كالدَّمع شيئاً نموما",46,"م",2,0],["تنمح ولم يفارقها حبيبٌ","ولم يك قلبها صباً معنّى",47,"ن",2,0],["تنميه في قلل العلاء عصابة","أخذوا المناقب أوحد عن أوحد",48,"د",1,0],["تنميه في العلياء غرّ مكارم","يغنى بها عن هاشم وهشام",49,"م",1,0],["تنمِي الصنيعةُ في مثلي فسُدَّ بِيَ ال","مهمَّ ما شئت تَحمَدْ فيه ممتحَني",50,"ن",2,0],["تُنمَى العلا من أبي المعالي","إلى عريق الثرى أصيلِ",51,"ل",1,0],["تَنمِي الطروسُ لفضلكم","خبراً وأنتَ تحقِّقُهْ",52,"ق",2,0],["تنِمُّ بما فيها كأنَّ طروسَها","لطائمُ أهدتْها إليك صُحَارُ",53,"ر",1,0],["تَنْميه فتيانُ صَدْقٍ من بني أسدٍ","وآل نصْرٍ وكلٌّ معشَرٌ خُشُنُ",54,"ن",1,0],["تنميه آباؤه الكرام إلى ال","مجد وأجدادهُ المفاضيل",55,"ل",1,0],["تنمَّق عنا محكم الفتح في الحمى","لأهل الحمى يدري بذاك المشاهد",56,"د",1,0],["تنمى لآل عليٍّ وقد","ثريد إمرار دهرٍ غير محسود",57,"د",1,0],["تُنْمى المَعالي لبيتٍ كانَ سيِّدَهُ","حقًّا وينْحَطُّ عن عَلياهُ كلُّ عَلي",58,"ل",2,0],["تنمو قوى الشيء بالتدريج إن رزقت","لطفاً ويقوى شرار الزند بالضرم",59,"م",1,0],["تَنِمُّ عن فَراغِها","كأنَّها مَغارَه",60,"ه",1,0],["تُنمى إِذا اِنتَسَبتْ إِليك وما لها","إِلّاكَ آباءٌ لها وجُدودُ",61,"د",1,0],["تُنمى إِلى الشَمسِ في إِغذائِها وَلَها","مِنَ الرَضاعَةِ في حَرِّ الهَجيرِ أَبُ",62,"ب",1,0],["تنمو الغصون على العروق فليس من","عجب إذا غصن كريم أزهرا",63,"ر",2,0],["تنميكَ أكرم أسرةٍ قد أرضَعت","بِالعلم من درّ الهدى أبناءها",64,"ا",3,0],["تَنِمُّ أَردانُهُ عَليهِ إذا","تَنَفَّسَت في الرّياحِ أَردانُه",65,"ن",2,0],["تَنميهِ هاشِمُهُ وَعَبدُ مَنافِهِ","وَقُصَييُّهُ وَذَبيحُهُ وَكَليمُهُ",66,"م",2,0],["تَنمو الغُصون إِذا جَنى","مِنها المريد الشاطر",67,"ر",1,0],["تُنمِّي ليَ الأشواقَ والذِّكر والأسى","وتُضرمُ في قلبي بتغريدِها حُزنا",68,"ن",2,0],["تنمَّر للفعل الجميل تنمُّراً","ولم يك يوماً عنه بالمتقاعد",69,"د",1,0],["تَنُمُّ بِأَسْرَارِ الْهَوى وَتُتَرْجِمُ","يَسِيرُ فُؤَادِي حَيْثُ سَارَ الْحَبَائِبُ",70,"ب",1,0],["تنمو الحضارة في أرجائها فإذا","فوق الرمال صروح هامُها السحبُ",71,"ب",1,0],["تنميه من آل الرفيل مرازب","شم الأنوف لدى الهياج جحاجحُ",72,"ح",1,0],["تنمى به فى بنى لأىٍ دعائمُها","ومن جُمانة لم تخضَع سواريها",73,"ي",3,0],["تنميهِ من آل نبهان غطارفةٌ","بيضُ الوجوه مطاعيم مطاعينُ",74,"ن",1,0],["تَنمِي مِن الأَعْياصِ فِي مَنِيعِ","مُثْرِي الأُصُول أَيِّدِ الفُرُوعِ",75,"ع",1,0],["تنمر وشمر يا قتيب بن مسلم","فإن تميما ظالم وابن ظالم",76,"م",1,1],["تَنمى بِهِ أَعراقُهُ وَجُدودُهُ","وَمَآثِرُ الأَخوالِ وَالأَعمامِ",77,"م",1,0],["تُنميهِ من حيِّ العُلى أسرةٌ","أحلى من الشهدِ سجاياها",78,"ا",3,0],["تنمى إلى القائم بين الورى","برشدها أو حمل أثقالها",79,"ل",3,0],["تنميه للعلياء هاشمُ","أهلُ ذروتها الرفيعه",80,"ع",2,0],["تنميك من سلف المعالي أسرةٌ","غلبوا على الشرف الكرام الصيدا",81,"د",2,0],["تنميه من علياء هاشم أُسرةٌ","وصل الإِله بعرشه أنسابها",82,"ب",3,0],["تَنمُّ عَلى أَصلِ الفَتى إِن جَهلتَه","خِلال كَما نَمَّ الأَريجُ عَلى الزَهر",83,"ر",1,0],["تنمنم بالاسافل منك وشيا","وتلوى بالاعالي منك رايا",84,"ا",3,0],["تُنميهِ آباءُ صِدقٍ","لِمُحصِناتٍ هِجانِ",85,"ن",1,0],["تَنمى إِلى العرب العرباء مِن مضر","مِن هاشم مِن علي دارَها النَجف",86,"ف",1,0],["تنمى لى العمرَين منه مفاخرٌ","عمرَت بما شاءت له العلياء",87,"ا",2,0],["تنميهِ أَعراقُ صدقٍ حيثُ تنسبهُ","تُضيء سنّتهُ في الحالك الداجي",88,"ج",2,0],["تُنَمِّلُ النُّورَ بِالآيَاتِ مُقْتَطِعَاً","مِنَ الشَّقَاءِ صَبَاحَاتٍ بِلاَ أسَلِ",89,"ل",1,0],["تنم الدموع على سرّه","إذا هو حال كتمانه",90,"ن",2,0],["تنم على الأنام بغير حق","وتأسف أن ترى متصافيين",91,"ن",1,0],["تنمو الغصونِ إذا جنى","منها المزيدُ الشاطر",92,"ر",1,0],["تنم عليه عينُه ولسانُهُ","يكذِب ما في العين والعينُ أَصْدَقُ",93,"ق",1,0],["تنمى لهم يا شبل آساد الشرى","والشبل لا ينمى لغير أسود",94,"د",1,0],["تنمّر فَاِستَأسَدتُ لكِن بِمَأزِقٍ","عَلى غَيرِ صُمِّ المروِ ما وَقَعَت رِجلي",95,"ل",2,0],["تَنمى إِلى خَيرِ الأَنامِ أَرومَة","تَعلو السَنام عُمومَة وَخَؤولا",96,"ل",2,0],["تَنمى إِلى فِرعِ أَبناءَ البَتولِ بِلا","مين وَفَخر وَلا دَعوى بِلا سَنَد",97,"د",1,0],["تَنُمّ عَلى أَيّامِ أُنسٍ بِهِ مَضَت","سَقى عَهدَها المُنهَلُّ مِن وابِلِ القَطرِ",98,"ر",1,0],["تنمر الدهر لي حتى سرقت له","من