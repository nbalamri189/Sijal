{"poems":[[56,"علم وتحكيم وشيب مفارق","https://www.aldiwan.net/poem27519.html","الكامل"],[40,"يمسي ضجيع خريدة ومضاجعي","https://www.aldiwan.net/poem7863.html","الكامل"],[102,"أحزان .. وإصرار","https://www.poetsgate.com/ViewPoem.aspx?id=50332",""],[56,"علمٌ وتحكيمٌ وشيبُ مفارقِ","https://www.poetsgate.com/ViewPoem.aspx?id=14449",""],[131,"شهدن مع النبي مسومات","https://www.aldiwan.net/poem24219.html","الوافر"],[164,"لي في الله حسن ظن جميل","https://www.aldiwan.net/poem59139.html","السريع"],[189,"أقصاه جور البين عن أحبابه","https://www.aldiwan.net/poem14107.html","الكامل"],[309,"كم بقلبي فيك من شجن","https://www.aldiwan.net/poem16838.html","المديد"],[563,"إني أنا فرضه وتقديره","https://www.aldiwan.net/poem34467.html","المنسرح"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77618","الرجز"],[1148,"","https://poetry.dctabudhabi.ae/diwan/poem/146294","الوافر"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35730","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93668","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62889","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108285","البسيط"],[3641,"","https://poetry.dctabudhabi.ae/diwan/poem/202289","الرمل"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/18975","الوافر"],[4578,"بفاتر جفنه فتن البريا","https://www.poetsgate.com/ViewPoem.aspx?id=49617",""],[5364,"بلاد الشام تنخاكم","https://www.poetsgate.com/ViewPoem.aspx?id=177160",""],[6075,"دنياي أنت","https://www.poetsgate.com/ViewPoem.aspx?id=213325",""],[6205,"أشواق الخوابي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88156&r=&rc=8",""],[6285,"هذه الشام لا تقولي كفانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86807&r=&rc=0",""]],"verses":[["نَعَرَ اِبنُ شَكلَةَ بِالعِراقِ وَأَهلِها","فَهَفا إِلَيهِ كُلُّ أَطلَسَ مائِقِ",0,"ق",1,0],["نُعري السُيوفَ فَلا تَزالُ عَوارِياً","حَتّى تَكونَ جُفونَهُنَّ الهامُ",1,"م",1,0],["نعرف الموت الذي يعرفنا","مسنّا قتلا ودسناه قتال",2,"ل",1,0],["نَعَرَ ابنُ شُكْلة َ بالعِراقِ وأَهْلِهِ","فهفا إليهِ كلُّ أطلسَ مائقِ",3,"ق",1,0],["نُعَرِّضُ لِلسُيوفِ بِكُلِّ ثَغرٍ","خُدوداً ما تُعَرَّضُ لِلطامِ",4,"م",1,0],["نعرف الحق ثم نصدف عنه","ونراه ونحن عنه نميل",5,"ل",1,0],["نَعرت نَواعيرُ المياهِ وأُتْرِعت","تلك التِّراعُ وفُضّ فَيْض عُبابه",6,"ب",2,0],["نعرف البطحا وتعرفنا","والصفا والبيت يألفنا",7,"ن",2,0],["نعرفه عند ما نراه ولا","نراه لكن يعم تزويره",8,"ر",2,0],["نَعرف ماذا في المياه نَصنَعُ","نَشربها وَالجَحش بَعدُ يَطلعُ",9,"ع",1,0],["نعرض للطعان إذا التقينا","وجوهاً لا تعرض للطام",10,"م",1,0],["نَعَرَ الشَبابُ بِرَبّةِ البُردِ","فَمَضَت مُخالِفَةً عَنِ القَصدِ",11,"د",1,1],["نَعرف مَفهوم العُلى لَكننا","لَم نَرَ لَولا جَمعهم مصداقها",12,"ق",3,0],["نَعَرَتْ نُجومُ المِرْزَمين بها","وأَضلَّها الدَّبَرَانُ والقَلْبُ",13,"ب",1,0],["نعرّض النفس للبؤسى بقصدهم","كأننا نشتري البؤسى بأثمان",14,"ن",1,0],["نعرف الله وفينا سنة","صلة الرحم وإيفاء الذمم",15,"م",1,0],["نُعَرِّضُ لِلطِعانِ إِذا إِلتَقَينا","وُجوهاً لاتُعَرَّضُ لِلسِبابِ",16,"ب",1,0],["نعرف بالبدايع والمعاني","مآثره التي أضحت جليه",17,"ي",2,0],["نعرف ان النصر آتي وبيتسطّر على الالواح","ونرجع كالجسد واحد ونسترجع مكانتنا",18,"ن",2,0],["نَعْرَى مِنَ الْبُعْدِ الَّذِي","تُطْفِي مَحَبَّتُنَا حَرِيقَه",19,"ق",2,0],["نُعرّي الزهرة الخجلى صباحاً","ونُلبسَها من الأشواقِ زِيّا",20,"ي",2,0],["نعرات ونحن منها براء","هيجت في نفوسنا الأدرانا",21,"ن",2,0]]}