{"poems":[[24,"هل حبل رملة قبل البين مبتور","https://www.aldiwan.net/poem21897.html","البسيط"],[32,"يا دار مية بالخلصاء غيرها","https://www.aldiwan.net/poem29593.html","البسيط"],[4,"راح القطين بهجر بعدما ابتكروا","https://www.aldiwan.net/poem21160.html","البسيط"],[23,"يا آل بكر ألا تنهون جاهلكم","https://www.aldiwan.net/poem21328.html","البسيط"],[74,"بروضة حسن والعذار سياجها","https://www.aldiwan.net/poem18452.html","الطويل"],[15,"لمن جمال قبيل الصبح مزمومه","https://www.aldiwan.net/poem45246.html","البسيط"],[24,"هل حبلُ رملة َ قبلَ البينِ مبتورُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10895&r=&rc=36",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64039","الهزج"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103417","البسيط"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40100","البسيط"]],"verses":[["كَأَنَّ أَظعانَهُم تُحدى مُقَفِّيَةً","نَخلٌ بِعَينَينِ مُلتَفٌّ مَواقيرُ",0,"ر",1,0],["كَأَنَّ أَظعانَ مَيٍّ إِذ رَفَعنَ لَنا","بوَاسِقُ النَخلِ مِن يَبرينَ أَو هَجَرا",1,"ر",2,0],["كَأَنَّ أَظعانَهُم في الصُبحِ غادِيَةً","طَلحُ السَلائِلِ وَسطَ الرَوضِ أَو عُشَرُ",2,"ر",1,0],["كَأَنَّ أَظفارَها شُقِّقنَ مِن حَجَرٍ","فَلَيسَ مِنهُنَّ إِلّا وارِمٌ قاسي",3,"س",2,0],["كأنَّا ظُبا أقلامهِ في طروسهِ","أسنةُ جيشٍ والمداد عجاجها",4,"ج",3,0],["كَأَنَّ أَظعانَهُم نَخلٌ مُوَسَّقَةٌ","سودٌ ذَوائِبُها بِالحَملِ مَكمومَه",5,"م",2,0],["كأَنَّ أظعانَهم تُحْدَى مُقَفِّية ً","نخلٌ نعينينِ ملتفٌ مواقيرُ",6,"ر",1,0],["كأنْ أُظفورُه في الحُضْ","رِ إذ يَطعنُ غُضروفه",7,"ف",2,0],["كأنَّ أظفاره أظفار ذي لبدٍ","بزال للاهب والأجساد جرّاحا",8,"ح",2,0],["كَأَنَّ أَظلالَه وَالشمسُ يَنسَخُها","عَنهُ رِداءان مَطْوِيٌّ ومنشورُ",9,"ر",1,0]]}