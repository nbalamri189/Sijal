{"poems":[[77,"قال لي والدموع تنهل سحبا","https://www.aldiwan.net/poem36360.html","الخفيف"],[77,"هب النسيم معطر الأراج","https://www.aldiwan.net/poem36664.html","الكامل"],[86,"قد مر عام يا سعاد وعام","https://www.aldiwan.net/poem10672.html","الكامل"],[73,"كم ذا أريد ولا أراد","https://www.aldiwan.net/poem11863.html","مجزوء الكامل"],[73,"باعدت بالإعراض غير مباعد","https://www.aldiwan.net/poem11876.html","الكامل"],[93,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[88,"ليس من غاية الحياة البقاء","https://www.aldiwan.net/poem45036.html","الخفيف"],[51,"قد بلينا في دهرنا بملوك","https://www.aldiwan.net/poem7951.html","الخفيف"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"وهب يا واهب الهبات اللواتي","https://www.aldiwan.net/poem8310.html","الخفيف"],[32,"أنا جميل في السنام من معد","https://www.aldiwan.net/poem27732.html","الرجز"],[89,"ما حياة قديمها غير باد","https://www.aldiwan.net/poem44747.html","الخفيف"],[89,"يطلبون الوصول إن عبروه","https://www.aldiwan.net/poem45101.html","الخفيف"],[56,"أما والذي أصفاك مني مودة","https://www.aldiwan.net/poem58574.html","الطويل"],[99,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[61,"نطوي الليالي علما أن ستطوينا","https://www.aldiwan.net/poem51410.html","البسيط"],[61,"رد جفني بسافح الدمع يندى","https://www.aldiwan.net/poem51724.html","الخفيف"],[97,"نفدي النزيل ونكرمن","https://www.aldiwan.net/poem24742.html","مجزوء الكامل"],[44,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[44,"لا عيش أو يتحامى جسمك الوصب","https://www.aldiwan.net/poem30570.html","البسيط"],[74,"أما وخيال قد أطاف وسلما","https://www.aldiwan.net/poem13244.html","الطويل"],[105,"أقبل عليك من الشعوب سلام","https://www.aldiwan.net/poem42067.html","الكامل"],[105,"قل ما أردت فما عليك جناح","https://www.aldiwan.net/poem42081.html","الكامل"],[105,"دعوا الشهيد لشعب ليس ينساه","https://www.aldiwan.net/poem42130.html","البسيط"],[105,"هو الحكم أمضته السيوف القواطع","https://www.aldiwan.net/poem43054.html","الطويل"],[52,"صاح بالوعظ شيب رأس مضي","https://www.aldiwan.net/poem26582.html","الخفيف"],[52,"أي رسم لآل هند ودار","https://www.aldiwan.net/poem27050.html","الخفيف"],[48,"طفلة كالغزال ذات دلال","https://www.aldiwan.net/poem63313.html","الخفيف"],[50,"أراني قد تصابيت","https://www.aldiwan.net/poem64742.html","الهزج"],[50,"ألا يا خاتم الملك","https://www.aldiwan.net/poem64747.html","الهزج"],[46,"غضب الأمير من الملام وهل ترى","https://www.aldiwan.net/poem22842.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85694","المجتث"],[90,"","https://poetry.dctabudhabi.ae/diwan/poem/147231","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39648","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54243","الرمل"],[106,"معترك السباب!","https://www.poetsgate.com/ViewPoem.aspx?id=179427",""],[106,"ظل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179710",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[106,"يا أخت عموريْة!","https://www.poetsgate.com/ViewPoem.aspx?id=179607",""],[32,"أنا جمِيلٌ في السّنامِ الأعظَمِ،","https://www.poetsgate.com/ViewPoem.aspx?id=16005",""],[32,"أنا جدمِيلٌ، والحجازُ وطني،","https://www.poetsgate.com/ViewPoem.aspx?id=16025",""],[101,"يالواءَ الحسنِ أحزابُ الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62457&r=&rc=49",""],[113,"أذوب غراما والحبيب الذي أهوى","https://www.aldiwan.net/poem40429.html","عموديه"],[113,"بباب به الأملاك حطت رحالها","https://www.aldiwan.net/poem42155.html","الطويل"],[140,"يا صحابي واين منى صحبى","https://www.aldiwan.net/poem58430.html","البسيط"],[141,"لو لم يقد نحوك العدى الرغب","https://www.aldiwan.net/poem11737.html","المنسرح"],[141,"ما أدرك الطلبات مثل مصمم","https://www.aldiwan.net/poem11813.html","الكامل"],[196,"أما وقد شردت تلك اليعافير","https://www.aldiwan.net/poem51940.html","البسيط"],[209,"أطوف بأحلامي عليكم لعنى","https://www.aldiwan.net/poem46319.html","الطويل"],[227,"أبكي على ظالم لي غير مغتفر","https://www.aldiwan.net/poem51021.html","البسيط"],[273,"أسرف الدهر فهلا قصدا","https://www.aldiwan.net/poem25585.html","الرمل"],[308,"سيدي والظنون فيك جميلة","https://www.aldiwan.net/poem59510.html","الخفيف"],[340,"آه نفسي إلى متى أتألم","https://www.aldiwan.net/poem55336.html","الخفيف"],[340,"أنا أهواك يا ليلى","https://www.aldiwan.net/poem55339.html","الهزج"],[359,"يا لحبر مضى وأخلى الديارا","https://www.aldiwan.net/poem68103.html","الخفيف"],[362,"هل في عتاب الحادثات غناء","https://www.aldiwan.net/poem61013.html","الكامل"],[377,"أيهذا المعيربي حيث وردي","https://www.aldiwan.net/poem48782.html","الخفيف"],[406,"لهفي لشرخ شبيبتي وزماني","https://www.aldiwan.net/poem31625.html","عموديه"],[426,"لك الهناء بنيل المجد والنعم","https://www.aldiwan.net/poem40798.html","البسيط"],[438,"أريحي الوجا يا ناق ما بعد ذا وجا","https://www.aldiwan.net/poem14299.html","الطويل"],[451,"أبا جرير برغمي أن تخط يدي","https://www.aldiwan.net/poem61678.html","البسيط"],[456,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[456,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[466,"أيها الشاعر مهلا","https://www.aldiwan.net/poem59727.html","مجزوء الرمل"],[481,"نحن الفوارس يوم الشعب ضاحية","https://www.aldiwan.net/poem2074.html","البسيط"],[493,"مولاي إن عدت ولم ترضى لي","https://www.aldiwan.net/poem9774.html","السريع"],[513,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[513,"أناجيك والهم الدخيل مقيم","https://www.aldiwan.net/poem12264.html","الطويل"],[556,"أنا صاحب الأمر الإلهي","https://www.aldiwan.net/poem33662.html","مجزوء الكامل"],[556,"أنا كعبة كل المعاني","https://www.aldiwan.net/poem33830.html","مجزوء الكامل"],[573,"رجع الغرام إلى الحبيب الأول","https://www.aldiwan.net/poem3030.html","الكامل"]],"verses":[["أَنا جَفْنِي الْقَرِيحُ يَرْوِي عَن الأَعْمَشِ","وَالْجَفْنُ مِنْكَ عَنْ مَكْحُولِ",0,"ل",1,0],["أنا جَوهَريُّ اللّفظِ لا عَجَبٌ إذا","جَمْعي مُنَظِّمُها بهَذا التّاجِ",1,"ج",1,0],["إِنّا جَمَعنا لِلجِهادِ صُفوفَنا","سَنَموتُ أَو نَحيا وَنَحنُ كِرامُ",2,"م",1,0],["إِن أَجنِ ذَنباً في الهَوى","خَطَأً فَقَد يَكبو الجَوادُ",3,"د",1,0],["إِن أَجنِهِ خَطَأً فَقَد عاقَبتَني","ظُلماً بِأَبلَغَ مِن عِقابِ العامِدِ",4,"د",1,0],["إِنْ أَجَفَّتْ مِدَادَهُ حُرْقَةٌ فِي النَّفْ","سِ أَجْرَتْهُ دَمْعَةٌ مِنْ يَتِيمِ",5,"م",1,0],["أنا جرّبتهم إلى أن تساوى ال","يوم عندي سبابهم والثناء",6,"ا",2,0],["إن أجدنا في مدحِهم حسدونا","فحُرِمنا منهُمْ ثوابَ الثناءِ",7,"ا",2,0],["أنا جَلْدٌ على عِناد الأَحاظِي","وأبيٌّ أنْ أَرْأمَ النَّكْراءَ",8,"ا",2,0],["أنا جارٌ قريبُ دارٍ وتَجْبي","ني ويَجْبيك نازحٌ مُنتابُ",9,"ب",1,0],["أَنا جَميلٌ في السَنامِ مِن مَعَد","في الذُروَةِ العَلياءِ وَالرُكنِ الأَشَد",10,"د",1,1],["انا جزء من عالم ماله من","آخر ينتهي به او نفاد",11,"د",1,0],["إن أجر المجاهدين كثير","ليس يحصى بالحصر والتعداد",12,"د",1,0],["أُناجِيكَ بالأَوْهَامِ حَتّى كَأنّما","أَرَاكَ بِعَيْنَيْ فِكْرَتي حينَ أَجْلِسُ",13,"س",1,0],["أنا جرحٌ يمشي على قدميه","وخيولي قد هدها الإعياء",14,"ا",2,0],["إن أَجرِ في حُبِّكم جَرْيَ الجوادِ فقد","أضحَت رِحابُ مَساعيكم مَيادينا",15,"ن",2,0],["أنا جَلْدٌ على الخطوبِ ولكنْ","لستُ فيها على جَفائِكَ جَلْدا",16,"د",2,0],["إنا جنود النور من","علم ومن أدب وفن",17,"ن",1,0],["إِن أَجرَمَت لَم تَنَصَّل مِن جَرائِمِها","وَإِن أَساءَت إِلى الأَقوامِ لَم تُلَمِ",18,"م",1,0],["إِنّا جَهِلنا فَخِلناكَ اِعتَلَلتَ وَلا","وَاللَهِ ما اِعتَلَّ إِلاّ المُلكُ وَالأَدَبُ",19,"ب",1,0],["أُناجي ظَلامَ اللَيلِ فيهِ بِلَوعَةٍ","تَحَدَّثَ عَنها الطَيرُ فَجراً فَهَينَما",20,"م",2,0],["إنّا جَهِلْناها وعندكَ عِلْمُها","والجهلُ داءٌ للشُّعوب عُقامُ",21,"م",1,0],["إنّا جُنودُك نبتِني لبلادِنا","مجداً من الأرواحِ والأجسادِ",22,"د",1,0],["إنّا جَهِلْنَا فشقَّ الحِقدُ وَحدَتنا","وأدركَ الخصمُ منّا ما تَمنَّاهُ",23,"ا",2,0],["أناجيلُ رُهبانٍ بأيدي أئِمّةٍ","لهم بيَعٌ من أَعْظُمٍ وصوامِعُ",24,"ع",1,0],["أَنا جاهُ الناسِ الَّذي يَحمِلُ العِب","ءَ وَيُمري بِهِ الزَمانُ البَكِيُّ",25,"ي",1,0],["أَنا جَيشٌ إِذا غَدَوتُ وَحيداً","وَوَحيدٌ في الجَحفَلِ الجَرّارِ",26,"ر",1,0],["أَنا جارٌ لَكُم قَريبٌ وَلَكِن","لَيسَ يُغني لَدَيكِ حَقُّ الجِوارِ",27,"ر",1,0],["أُناجي كُلَّما أَصبَح","تُ جَدواها وَأَمسَيتُ",28,"ت",1,0],["أُناجي شَبَهاً مِنكِ","عَلى التُربِ إِذا اِشتَقتُه",29,"ت",2,0],["أَنا جاهِلٌ إِلّا بِأَمرٍ واحِدٍ","ما عالَمي هاذا بِأَهلِ تَأنُسِ",30,"س",1,0],["إن اِجتماعي بِلَيلى","عما يريب يجلُّ",31,"ل",1,1],["إنا جهدنا فلم نُزَوَّدْ","حتى بنفح من الأريج",32,"ج",1,0],["إنَّ أجسادنا معابرُ أروا","حٍ إلى كلِّ رائع فتَّانِ",33,"ن",1,0],["أَنا جزآنُ آنِفاً جُزء فا","نٍ وَجُزء باقٍ وَأَنتَ المُجَزّي",34,"ي",1,0],["إنْ أجابت دعوة الحبِّ مشت","تعثُرُ الصبوةُ فيها بالحياة",35,"ا",2,0],["إنا جعلنا الحكم عن","وان المثوبة والعقاب",36,"ب",1,0],["إنَّا جنودُك إن تَفُل","شعرًا، فباسمك تستَهلُّه",37,"ل",2,0],["إنَّا جُنودٌ بني النضير، وخَيْبَر","ولَتَلْحَقَّنَّ بني النضيرِ، وخيبرا",38,"ر",2,0],["إِنَّا جعلنا أرضنا للمعتدي","قبرًا، وظِلاٍّ للنزيل ظليلا",39,"ل",2,0],["أنا جمِيلٌ في السّنامِ الأعظَمِ","، الفارِعِ النّاسَ، الأعزّ الأكرم",40,"م",1,1],["أنا جمِيلٌ، والحجازُ وطني،","فيه هوى نفسي، وفيه شجني",41,"ي",1,1],["إنْ أجابت دعوة الحبِّ مشت","تعثُرُ الصبوة ُ فيها بالحياء",42,"ا",2,0],["اناجيك في امري فتزور لاهيا","وشأن غرامي فيك لم يحمل اللهوى",43,"و",2,0],["أناجيه أبغي الفوز منه وإنني","بسطت لعلياه أكف سؤالي",44,"ل",2,0],["إن أُجبْ داعىَ الهوى غيرَ راضٍ","فالصدَى بالنداءِ كُرْهاً يلبِّى",45,"ب",2,0],["إِنَّ أَجَلَّ المُلوكِ كُلِّهِمِ","رَضوا بِهَذا القَضاءِ أَو غَضِبوا",46,"ب",3,0],["إِن أَجدَبوا لاذوا بِغَيثٍ هاطِلٍ","أَو رُوِّعوا عاذوا بِطَودٍ أَيهَمِ",47,"م",1,0],["إنْ أَجْرَعِ الذلَّ من كأسٍ سُقيتُ بها","فَرائِدُ العزِّ إدلاجٌ وتهجير",48,"ر",1,0],["أناجى هواكم كل حين بلهفة","وما أنا عن ذاك الجناب بغائب",49,"ب",1,0],["إنا جميعاً تشارَكْنا دماً وأبا","كما تشاركتِ الأغصانُ بالثمر",50,"ر",1,0],["أنَا جَارُ البَحْرِ إلا أنّ لي","مِنْهُ في حالِ الوُرودِ الثَّمَدا",51,"د",2,0],["أنا جار لكم منعتم حماه","ونهجتم إلى المعالي سبيله",52,"ل",2,0],["انا جسمي لا شك عبد لعقلي","انا عقلي عبدٌ لقلبي المتيم",53,"م",1,0],["أناجي البدر يا ليلى","وما يعروني يعروك",54,"ك",1,0],["اِن أَجدد دائَما عَلَيكَ بِدَمعي","لَم أَجد ذاكَ بعد فَقدِكَ عارا",55,"ر",2,0],["إن أَجزعَ الأحبابَ وَشكُ رحيله","عنّا فلا تُسْرَرْ به الأعداء",56,"ا",2,0],["إِن إِجلالك الغَنيّ لِنَفعٍ","وَاِزدِراء الفَقير لُؤم وَحمق",57,"ق",1,0],["أنا جاره ويد الخطوب قصيرة","عن ان تنال مجاور السلطان",58,"ن",1,0],["إن أجدب الناس والأنواءُ ماسكةٌ","فجود كفيك يغنينا عن الديمِ",59,"م",1,0],["أناجيك إعلاناً وسراً ومن يكن","لديك فمقبول الدعاء فقد نجا",60,"ج",2,0],["إنَّا جميعاً حيارى ركبُ قافلةٍ","تمشى من العدم الأقصى إلى العدمِ",61,"م",1,0],["إن أجهضتْ أمُّ العلا","أو ولَدت لليُتْمِ",62,"م",1,0],["إن أجدبتْ أرضيَ صُبتَ مزنةً","أو أدجنتْ حاليَ لحتَ قَبَسا",63,"س",2,0],["إِن أَجَبناكَ فَنَقصٌ","أَن يُجيبَ العُلوُ سُفلا",64,"ل",2,0],["أنا جدعنا بصفر من أنوفكم","أنفاً أشم فأمسى حق مصطلم",65,"م",1,0],["إن أجتن الغلظة من سيد","فالشوك عند الثمرِ الطيب",66,"ب",1,0],["إن أجدبت أفكارهم أو أخلبت","فأنا الذي قطراته أنهار",67,"ر",1,0],["أناجيك والهم الدخيل مقيم","وأدعوك والصبر الصحيح سقيم",68,"م",1,1],["أنا جاهل لا علم لي","أنا من بعلمي لي يضاهي",69,"ا",3,0],["أنا جفنك المكسور يا","عيني ومنك الجبر داني",70,"ي",1,0],["أَنا جَدُّ أَنصارِ النَّبيِّ لأَنَّني","بالأَشهلِ العينين عبدُ الأَشْهَل",71,"ل",1,0]]}