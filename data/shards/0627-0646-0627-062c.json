وةُ غرام","https://www.poetsgate.com/ViewPoem.aspx?id=185064",""],[5956,"ديمقراطية الدمويِّين","https://www.poetsgate.com/ViewPoem.aspx?id=192364",""],[5956,"إنا جميعاً في الأصول سواء","https://www.poetsgate.com/ViewPoem.aspx?id=192608",""],[5957,"غَرِيبة","https://www.poetsgate.com/ViewPoem.aspx?id=12235",""],[5969,"رَبيعُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=198726",""],[5977,"إنني أمل","https://www.poetsgate.com/ViewPoem.aspx?id=212728",""],[5977,"سلام على تلك القبور وأهلها","https://www.poetsgate.com/ViewPoem.aspx?id=214339",""],[6050,"الشّمسُ تُنسَجُ مِنْ فَم الشُّعراءِ","https://www.poetsgate.com/ViewPoem.aspx?id=103311",""],[6056,"صباح الذوق","https://www.poetsgate.com/ViewPoem.aspx?id=130316",""],[6125,"أحلِّقُ في الدُّجى وحدي","https://www.poetsgate.com/ViewPoem.aspx?id=212879",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""],[5309,"طلاب الخلد حرر كل واع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573520",""],[6187,"الدائرة الحمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82160&r=&rc=4",""],[6201,"بقايا سهر!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87484&r=&rc=8",""],[1583,"عن بلادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73070&r=&rc=27",""],[6215,"شرقيّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84933&r=&rc=7",""],[6239,"الشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75970&r=&rc=21",""],[119,"غريب ضعيف كثير الذنوب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55617&r=&rc=14",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""],[2220,"منْ وافقَ الحقَّ في حكمٍ وفي عملٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11850&r=&rc=719",""],[6336,"المجاهدون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73557&r=&rc=18",""]],"verses":[["أَنا جَفْنِي الْقَرِيحُ يَرْوِي عَن الأَعْمَشِ","وَالْجَفْنُ مِنْكَ عَنْ مَكْحُولِ",0,"ل",1,0],["أنا جَوهَريُّ اللّفظِ لا عَجَبٌ إذا","جَمْعي مُنَظِّمُها بهَذا التّاجِ",1,"ج",1,0],["إِنّا جَمَعنا لِلجِهادِ صُفوفَنا","سَنَموتُ أَو نَحيا وَنَحنُ كِرامُ",2,"م",1,0],["إِن أَجنِ ذَنباً في الهَوى","خَطَأً فَقَد يَكبو الجَوادُ",3,"د",1,0],["إِن أَجنِهِ خَطَأً فَقَد عاقَبتَني","ظُلماً بِأَبلَغَ مِن عِقابِ العامِدِ",4,"د",1,0],["إِنْ أَجَفَّتْ مِدَادَهُ حُرْقَةٌ فِي النَّفْ","سِ أَجْرَتْهُ دَمْعَةٌ مِنْ يَتِيمِ",5,"م",1,0],["أنا جرّبتهم إلى أن تساوى ال","يوم عندي سبابهم والثناء",6,"ا",2,0],["إن أجدنا في مدحِهم حسدونا","فحُرِمنا منهُمْ ثوابَ الثناءِ",7,"ا",2,0],["أنا جَلْدٌ على عِناد الأَحاظِي","وأبيٌّ أنْ أَرْأمَ النَّكْراءَ",8,"ا",2,0],["أنا جارٌ قريبُ دارٍ وتَجْبي","ني ويَجْبيك نازحٌ مُنتابُ",9,"ب",1,0],["أَنا جَميلٌ في السَنامِ مِن مَعَد","في الذُروَةِ العَلياءِ وَالرُكنِ الأَشَد",10,"د",1,1],["انا جزء من عالم ماله من","آخر ينتهي به او نفاد",11,"د",1,0],["إن أجر المجاهدين كثير","ليس يحصى بالحصر والتعداد",12,"د",1,0],["أُناجِيكَ بالأَوْهَامِ حَتّى كَأنّما","أَرَاكَ بِعَيْنَيْ فِكْرَتي حينَ أَجْلِسُ",13,"س",1,0],["أنا جرحٌ يمشي على قدميه","وخيولي قد هدها الإعياء",14,"ا",2,0],["إن أَجرِ في حُبِّكم جَرْيَ الجوادِ فقد","أضحَت رِحابُ مَساعيكم مَيادينا",15,"ن",2,0],["أنا جَلْدٌ على الخطوبِ ولكنْ","لستُ فيها على جَفائِكَ جَلْدا",16,"د",2,0],["إنا جنود النور من","علم ومن أدب وفن",17,"ن",1,0],["إِن أَجرَمَت لَم تَنَصَّل مِن جَرائِمِها","وَإِن أَساءَت إِلى الأَقوامِ لَم تُلَمِ",18,"م",1,0],["إِنّا جَهِلنا فَخِلناكَ اِعتَلَلتَ وَلا","وَاللَهِ ما اِعتَلَّ إِلاّ المُلكُ وَالأَدَبُ",19,"ب",1,0],["أُناجي ظَلامَ اللَيلِ فيهِ بِلَوعَةٍ","تَحَدَّثَ عَنها الطَيرُ فَجراً فَهَينَما",20,"م",2,0],["إنّا جَهِلْناها وعندكَ عِلْمُها","والجهلُ داءٌ للشُّعوب عُقامُ",21,"م",1,0],["إنّا جُنودُك نبتِني لبلادِنا","مجداً من الأرواحِ والأجسادِ",22,"د",1,0],["إنّا جَهِلْنَا فشقَّ الحِقدُ وَحدَتنا","وأدركَ الخصمُ منّا ما تَمنَّاهُ",23,"ا",2,0],["أناجيلُ رُهبانٍ بأيدي أئِمّةٍ","لهم بيَعٌ من أَعْظُمٍ وصوامِعُ",24,"ع",1,0],["أَنا جاهُ الناسِ الَّذي يَحمِلُ العِب","ءَ وَيُمري بِهِ الزَمانُ البَكِيُّ",25,"ي",1,0],["أَنا جَيشٌ إِذا غَدَوتُ وَحيداً","وَوَحيدٌ في الجَحفَلِ الجَرّارِ",26,"ر",1,0],["أَنا جارٌ لَكُم قَريبٌ وَلَكِن","لَيسَ يُغني لَدَيكِ حَقُّ الجِوارِ",27,"ر",1,0],["أُناجي كُلَّما أَصبَح","تُ جَدواها وَأَمسَيتُ",28,"ت",1,0],["أُناجي شَبَهاً مِنكِ","عَلى التُربِ إِذا اِشتَقتُه",29,"ت",2,0],["أَنا جاهِلٌ إِلّا بِأَمرٍ واحِدٍ","ما عالَمي هاذا بِأَهلِ تَأنُسِ",30,"س",1,0],["إن اِجتماعي بِلَيلى","عما يريب يجلُّ",31,"ل",1,1],["إنا جهدنا فلم نُزَوَّدْ","حتى بنفح من الأريج",32,"ج",1,0],["إنَّ أجسادنا معابرُ أروا","حٍ إلى كلِّ رائع فتَّانِ",33,"ن",1,0],["أَنا جزآنُ آنِفاً جُزء فا","نٍ وَجُزء باقٍ وَأَنتَ المُجَزّي",34,"ز",2,0],["إنْ أجابت دعوة الحبِّ مشت","تعثُرُ الصبوةُ فيها بالحياة",35,"ا",2,0],["إنا جعلنا الحكم عن","وان المثوبة والعقاب",36,"ب",1,0],["إنَّا جنودُك إن تَفُل","شعرًا، فباسمك تستَهلُّه",37,"ل",2,0],["إنَّا جُنودٌ بني النضير، وخَيْبَر","ولَتَلْحَقَّنَّ بني النضيرِ، وخيبرا",38,"ر",2,0],["إِنَّا جعلنا أرضنا للمعتدي","قبرًا، وظِلاٍّ للنزيل ظليلا",39,"ل",2,0],["أناجيك يا أخت روحي كما","يناجي الغريب خيال الحمى",40,"م",2,1],["أنا جمرة الغمرات ، ملء جوانحي","همم الشباب تثيرها نزواته",41,"ت",2,0],["أنا جمِيلٌ في السّنامِ الأعظَمِ","، الفارِعِ النّاسَ، الأعزّ الأكرم",42,"م",1,1],["أنا جمِيلٌ، والحجازُ وطني،","فيه هوى نفسي، وفيه شجني",43,"ي",1,1],["إنْ أجابت دعوة الحبِّ مشت","تعثُرُ الصبوة ُ فيها بالحياء",44,"ا",2,0],["اناجيك في امري فتزور لاهيا","وشأن غرامي فيك لم يحمل اللهوى",45,"و",2,0],["أناجيه أبغي الفوز منه وإنني","بسطت لعلياه أكف سؤالي",46,"ل",2,0],["إن أُجبْ داعىَ الهوى غيرَ راضٍ","فالصدَى بالنداءِ كُرْهاً يلبِّى",47,"ب",2,0],["إِنَّ أَجَلَّ المُلوكِ كُلِّهِمِ","رَضوا بِهَذا القَضاءِ أَو غَضِبوا",48,"ب",3,0],["إِن أَجدَبوا لاذوا بِغَيثٍ هاطِلٍ","أَو رُوِّعوا عاذوا بِطَودٍ أَيهَمِ",49,"م",1,0],["إنْ أَجْرَعِ الذلَّ من كأسٍ سُقيتُ بها","فَرائِدُ العزِّ إدلاجٌ وتهجير",50,"ر",1,0],["أناجى هواكم كل حين بلهفة","وما أنا عن ذاك الجناب بغائب",51,"ب",1,0],["إنا جميعاً تشارَكْنا دماً وأبا","كما تشاركتِ الأغصانُ بالثمر",52,"ر",1,0],["أنَا جَارُ البَحْرِ إلا أنّ لي","مِنْهُ في حالِ الوُرودِ الثَّمَدا",53,"د",2,0