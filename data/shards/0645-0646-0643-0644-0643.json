{"poems":[[9,"شاقتك من قتلة أطلالها","https://www.aldiwan.net/poem21944.html","السريع"],[4,"طرب الفؤاد وليته لم يطرب","https://www.aldiwan.net/poem21150.html","الكامل"],[53,"يا من أغار عليه من غلائله","https://www.aldiwan.net/poem65939.html","البسيط"],[53,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[63,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[89,"بقوة العلم تقوى شوكة الأمم","https://www.aldiwan.net/poem8340.html","البسيط"],[107,"ما للسحاب تدفقت أخلافه","https://www.aldiwan.net/poem43119.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54832","الكامل"],[189,"كم رام سلوته العذول فما وعى","https://www.aldiwan.net/poem14574.html","الكامل"],[302,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[369,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[371,"شوقا إلى ذاك الجلال ومجتنى","https://www.aldiwan.net/poem17166.html","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38964","البسيط"],[1006,"","https://poetry.dctabudhabi.ae/diwan/poem/145934","السريع"],[2645,"","https://poetry.dctabudhabi.ae/diwan/poem/130235","المنسرح"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58255","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89314","البسيط"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101372","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81927","الكامل"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123460","الكامل"],[5072,"يا رمزنا أنت قد بعناك","https://www.poetsgate.com/ViewPoem.aspx?id=53759",""],[5206,"أرض الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=187396",""],[5510,"كيد النساء","https://www.poetsgate.com/ViewPoem.aspx?id=205683",""]],"verses":[["مِن كُلِّ كَوماءَ سَحوفٍ إِذا","جَفَّت مِنَ اللَحمِ مُدى الجازِرِ",0,"ر",1,0],["مِن كُلِّ كَهلٍ كَالسِنانِ وَسَيِّدٍ","صَعبِ المَقادَةِ كَالفَنيقِ المُصعَبِ",1,"ب",1,0],["مَنْ كُلُّ كُفءٍ فقيرٌ من فضائلهِ","وكل عافٍ غنيٌّ من فواضلِهِ",2,"ل",2,0],["من كل كَزّ أبى السماح فما","يمنحُ إلا أديمَهُ الحلَمَا",3,"م",2,0],["من كلِّ كَهْلٍ يستطيرُ سِبالُه","لَوْنَيْنِ بينَ أناملِ البَوَّابِ",4,"ب",1,0],["مِنْ كُلِّ كَهْلِ الْحِجَا فِي سِنِّ عَاشِرَةٍ","يَكَادُ مَنْطِقُهُ يَنْهَلُّ بِالْحِكَمِ",5,"م",1,0],["مِن كُلِّ كَفّارِ السَريرَةِ جاحِدٍ","يَبدو الهُدى فَيَصُدُّ عَنهُ وَيُؤفَكُ",6,"ك",1,0],["مِنْ كُلِّ كَفُوءٍ بِالْخِصَالِ","لِذَاتِ أَخْلاَقٍ وَطُهرْ",7,"ر",1,0],["من كلِّ كالحةٍ إذا أَنْحَتْ على","رَضْوى بكَلْكَلها وَهَى وتَضَعْضَعا",8,"ع",2,0],["من كُلِّ كاسرِ جَفنٍ لا هدوَّ له","من الغِرار فخذ أَلغاز وصفهمِ",9,"م",1,0],["من كلِّ كَعْبٍ لها بالكَعْبِ مُختلِطٍ","وكلِّ صَدْرٍ لها في الصَّدْرِ مُنْكَسِر",10,"ر",1,0],["مِن كُلِّ كاتِبِ حَضرَةٍ لَم أَستَفِد","بِلِقائِهِ إِلّا لِقاءَ الحَضرَةِ",11,"ه",1,0],["مِن كلِّ كَلبٍ عَقورٍ بِالفَسادِ سَطا","وَكلّ أَرقم بِالإِفسادِ قد لدغا",12,"غ",2,0],["من كلِّ كرديّ حمارٍ ومن","كلّ عراقيّ نفاه الغلا",13,"ل",2,0],["من كُلّ كَهْلِ مُجَرَّبِ وفَتًى","في الرَّوْعِ ذي نَجْدَةٍ وذي جَلَدِ",14,"د",1,0],["من كُلِّ كرْكيّ تسامى صاعداً","كالمبتغي ذكراً لَدى كيوان",15,"ن",1,0],["من كل كوكب رشدٍ قد أنار به","آفاقَنا مشرقُ المسعى ومَعْلاه",16,"ل",3,0],["من كل كاس يستجد لنفسه","حللا ولكن من جلود عراة",17,"ه",1,0],["من كل كاعبةٍ إذا خطرت","نطق الوشاح وأفحم الحجل",18,"ل",1,0],["منِ كلِّ كأسٍ بالرِّضى متجدِّدٍ","عن كلِّ رَيْبٍ بالهُدى مُتقلِّد",19,"د",1,0],["من كل ِّ كأس ٍ أتَتْنا قطرة ٌ سحقت ْ","عقولَنا .. واشْرَأَب َّ التمر ُ والعنب ُ",20,"ب",1,0],["مَنْ كُلِّ كَاعِبَةٍ لَعُوبٍ بَضَّةٍ","للطَّرفِ قائلَةً إذًا لا تَطْمَعُ",21,"ع",1,0],["من كل كأس قد ملأتَ حكاية","ما عاد كأسي مستساغا يُشرب",22,"ب",1,0]]}