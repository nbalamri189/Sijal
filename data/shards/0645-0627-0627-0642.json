بح الكبْر ...","https://www.poetsgate.com/ViewPoem.aspx?id=209048",""],[5455,"الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=213959",""],[5497,"عزفٌ على العود","https://www.poetsgate.com/ViewPoem.aspx?id=205947",""],[5525,"الوعد","https://www.poetsgate.com/ViewPoem.aspx?id=7282",""],[5525,"ظامي هوى","https://www.poetsgate.com/ViewPoem.aspx?id=989",""],[5526,"مروى في حياتي وغيمه","https://www.poetsgate.com/ViewPoem.aspx?id=193117",""],[5573,"بنت الهبوب","https://www.poetsgate.com/ViewPoem.aspx?id=200349",""],[5582,"( نَفْسُ ) المُتَيَّمِ فِي الصَّبابَةِ شانُها","https://www.poetsgate.com/ViewPoem.aspx?id=63591",""],[5606,"الليالي تكشف الزيف وتبين الوجيه","https://www.poetsgate.com/ViewPoem.aspx?id=197128",""],[1547,"للهِ شبلا أسدٍ خادرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=16733",""],[5638,"رسول الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=199078",""],[5663,"نجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=200904",""],[5664,"اوراق","https://www.poetsgate.com/ViewPoem.aspx?id=46532",""],[5674,"نزيف الشريان مشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=189101",""],[5674,"الحظ العاثر","https://www.poetsgate.com/ViewPoem.aspx?id=207917",""],[5703,"طائر اليأس","https://www.poetsgate.com/ViewPoem.aspx?id=213603",""],[5720,"ذكريات الحب","https://www.poetsgate.com/ViewPoem.aspx?id=207973",""],[5756,"أهل الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=34581",""],[5756,"مدح الشيخ زايد","https://www.poetsgate.com/ViewPoem.aspx?id=8434",""],[2546,"ما أقصرَ اسم الحبِّ يا ويحَ ذا الحبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=17159",""],[5794,"غرور الشعر ..","https://www.poetsgate.com/ViewPoem.aspx?id=122796",""],[5804,"القصيدة القمرية","https://www.poetsgate.com/ViewPoem.aspx?id=184052",""],[5829,"الحائر الصامد / لن أرحل","https://www.poetsgate.com/ViewPoem.aspx?id=175429",""],[5848,"تمتير","https://www.poetsgate.com/ViewPoem.aspx?id=53167",""],[5848,"تحضير الارواح","https://www.poetsgate.com/ViewPoem.aspx?id=48838",""],[5875,"دروب الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=26770",""],[5923,"من مذكرات مراقب امتحان","https://www.poetsgate.com/ViewPoem.aspx?id=149684",""],[5939,"لهفة","https://www.poetsgate.com/ViewPoem.aspx?id=185500",""],[5997,"ريمٌ شرودٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215170",""],[6004,"اذكريني","https://www.poetsgate.com/ViewPoem.aspx?id=33679",""],[6038,"مجرد أوهام 2003","https://www.poetsgate.com/ViewPoem.aspx?id=25701",""],[6115,"اذا جتني الذمّه من اللاش","https://www.poetsgate.com/ViewPoem.aspx?id=180455",""],[1333,"يا أيها المغتر بالله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56036&r=&rc=14",""],[6320,"شَجْوِي الحَزِين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84348&r=&rc=45",""],[6355,"مهد سكينتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66670&r=&rc=130",""]],"verses":[["ما أَقَلَّ اِعتِبارَنا بِالزَمانِ","وَأَشَدَّ اِغتِرارَنا بِالأَماني",0,"ن",2,1],["ما أَقرَبَ الوَجدَ مِن قَلبٍ وَمِن كَبِدٍ","وَأَبعَدَ الأُنسَ مِن دارٍ وَمِن طَلَلِ",1,"ل",1,0],["ما أَقدَرَ اللَهَ أَن يُدني عَلى شَحَطٍ","جيرانَ دِجلَةَ مِن جيرانِ جَيجانا",2,"ن",2,0],["ما أَقبَحَ الدُنيا خِلافَ مُوَدَّعٍ","غَنِيَت بِهِ في حُسنِها تَختالُ",3,"ل",1,0],["مَا أَقْبَلَتْ مُنْقَادَةً بِزِمَامِهَا","بَلْ أَقْبَلَتْ مُنْقَادَةً بِذِمَامِ",4,"م",1,0],["ما أَقَرَّ النَّدى وَمَا أَلْعَبَ النُّو","رَ وَمَا أَجْزعَ الظِّلالَ الْحَوَائِمْ",5,"م",1,0],["ما أَقبحَ العبد أن ينسى وتذكرُه","وأنت باللطف والإحسان تَرعاهُ",6,"ا",2,0],["ما أقدرَ اللهَ أن يدني على شحطٍ","وأن يُقرْبَ بعد البين من نزحا",7,"ح",2,0],["ما أقدر العلمَ أنّ صَيْحته","يُمْعِن منها الخميس في هربه",8,"ب",2,0],["ما أقدر الموت فمن هوله","لم ينجُ لا كسرى ولا تُبَّع",9,"ع",1,0],["ما اقتضى حظّنا بقاءك فينا","واحداً تشمل الأنام ظلاله",10,"ل",2,0],["ما أقبح النَّعماءَ يُكْسَى ثوبَها","وأحسنَ النعماءَ عنه تُستَلبْ",11,"ب",1,0],["ما اقترَح السُّؤْل مثلَكَ ابنَ أبي","بكْرٍ لِمَا نَرْتَجِي من المِنحِ",12,"ح",1,0],["ما اقتنى مثلك دهر ال","سوء إلا حين أفلس",13,"س",1,0],["ما أقْمرَ ابْنا أبدٍ وأشْمسا","لو اسْتعنْتَ في المعاني هِرْمسا",14,"س",2,0],["ما أقبح المطل من أخي كرم","وعيب من قل عيبه شَنِع",15,"ع",1,0],["ما أقرب المعروف من كفه","فلِم أَغَبَّتنيَ أفواقه",16,"ق",2,0],["ما أَقدَرَ اللَهَ أَن يُحَيِّكِ ثانِيَةً","مَعَ الرَبيعِ كَما مِن قَبلُ سِوّاكِ",17,"ك",1,0],["ما أَقبَحَ الإِنسانَ ةَقتُلُ جارَهُ","وَيَقولُ هَذي سُنَّهُ العِمرانِ",18,"ن",1,0],["ما اقتنى مثلك دهر ال","سوءِ إلا حين إفلاسي",19,"ي",1,0],["ما اقبح الجهل فمنه","كل شر ينجم",20,"م",1,0],["ما اِقتَرَضَت مِن بَقلَةٍ","أَوِ اِستَعارَت زَهَرَه",21,"ر",2,0],["ما أَقدَرَ اللَهَ أَن يُخزي خَليقَتَهُ","وَلا يُصَدِّقُ قَوماً في الَّذي زَعَموا",22,"م",3,0],["ما اِقتَصَّ واليسُ في الفَضاءِ وَجا","بانُ وَما سَيَّرا مِنَ النُتَفِ",23,"ف",1,0],["ما أَقشَعَت سَمَواتٌ مِن نَوافِلِهِ","إِلّا وَأَسخَطُنا لِلدَهرِ أَرضانا",24,"ن",2,0],["ما اِقتَسَمَ الناسُ مِن ميراثِ مُقتَسَمٍ","عِندَ التُراثِ إِذا في قَبرِهِ اِنحَدَرا",25,"ر",2,0],["ما أَقرَبَ الشَيءِ الجَديدَ مِنَ البِلى","يَوماً وَأَسرَعَ كُلَّ ما هُوَ آتِ",26,"ت",1,0],["ما أَقرَبَ المَوتَ جَدّا","أَتاكَ يَشتَدُّ شَدّا",27,"د",2,1],["ما أَقطَعَ المَوتَ لِلصَديقِ وَما","أَقرَبَ صَفوَ الدُنيا مِنَ الكَدَرِ",28,"ر",1,0],["ما أَقدَرَ اللَهَ أَن يُغَيِّرَ ما","أَصبَحتَ فيهِ فَكُن عَلى حَذَرِ",28,"ر",1,0],["ما أَقرَبَ الحَينَ مِمَّن لَم يَزَل بَطِراً","وَلَم تَزَل نَفسُهُ توفي عَلى شَرَفِ",29,"ف",1,0],["ما أَقتَلَ الدُنيا لِأَزواجِها","تَعُدُّهُم عَدّاً قَتيلاً قَتيل",30,"ل",1,0],["ما أَقرَبَ المَوتَ مِن أَهلِ الحَياةِ وَما","أَحجى اللَبيبَ بِحُسنِ القَولِ وَالعَمَلِ",31,"ل",1,0],["ما أَقطَعَ الآجالَ لِلآمالِ","وَأَسرَعَ الآمالَ في الآجالِ",32,"ل",1,1],["ما أَقرَبَ المَوتَ مِنّا","تَجاوَزَ اللَهُ عَنّا",33,"ن",2,1],["ما أَقرَبَ المَوتَ في الدُنيا وَأَفظَعَهُ","وَما أَمَرَّ جَنى الدُنيا وَأَحلاهُ",34,"ا",2,0],["ما أَقبَلَت أَوجُهُ اللَذّاتِ سافِرَةً","مُذ أَدبَرَت بِاللِوى أَيّامُنا الأُوَلُ",35,"ل",1,0],["ما أقربَ الحقَّ ممّا يَبتغي عُمَرٌ","لو لم تكنْ لأبٍ للحقِّ صَوَّانِ",36,"ن",1,0],["ما أَقصَرَ اللَيلَ عَلى الراقِدِ","وَأَهوَنَ السَقمَ عَلى العائِدِ",37,"د",1,1],["ما أَقَامَ الصلاةَ مَنْ عَبَدَ الل","هِ وقامتْ بِربِّهَا الأشياءُ",38,"ا",2,0],["ما أَقبَحَ الهَجرَ بِالمُحِبِّ وَما","أَحسَنَ وَصلَ الحَبيبِ لَو عَلِما",39,"م",2,1],["ما أَقرَبَ العَيشَ مِنهُ إِن صَفوتِ لَهُ","وَما أَجَرَّ عَليهِ المَوتَ بِالكَدَرِ",40,"ر",1,0],["ما أَقَلَّ الصَبرَ عَنها بَعدَما","كَثُرَت فينا أَحاديثُ العَرَب",41,"ب",1,0],["ما أَقبَحَ المَينَ قُلتُم لَم يَشِب أَحَدٌ","حَتّى أَتى الشَيبُ إِبراهيمَ عَن أُمَمِ",42,"م",1,1],["ما أَقدَرَ اللَهَ أَن يُدعى بَرِيَّتُهُ","مِن تُربِهِم فَيَعودا كَالَّذي كانوا",43,"ن",3,1],["مَا أَقْرَبَ اليَأسَ مِنْ رَجائي","وَأبعدَ الصَّبرَ مِنْ بُكائي",44,"ي",1,1],["ما أقبح الكذب على الرّفات","والكذب من أراذل الصفات",45,"ت",1,0],["ما أقصر العمر حتى","نضيعه في النضال",46,"ل",1,0],["ما أَقتَلَ اليَأسَ لِأَهلِ الهَوى","لاسِيَّما مِن بَعدِ إِطماعِ",47,"ع",1,0],["ما أَقَلَّ الوَفاءَ ما أَضعَفَ الطا","لِبَ في ذا الزَمانِ وَالمَطلوبا",48,"ب",2,0],["ما أَقطَعَ المَوتَ لِلأَماني","وَالأَمَلِ النازِحِ الطَويلِ",49,"ل",1,0],["ما أقرب الأشياء حين يسوقُها","قدَرٌ وأبعدها إذا لم تُقدَر",50,"ر",1,0],["ما أقصر العمر في الدنيا لنابغةٍ","إذا تطلّعت الدنيا له راحا",51,"ح",2,0],["ما أقبحَ الأحرارَ حو","لَ «السين» تخضع للعبيد",52,"د",1,0],["ما أقذر العرض يلب عاذبا","برأسه الى لئيم المنتحى",53,"ا",1,0],["ماأقبح الإنسان يقتل جاره","ويقول هذي سنّة العمران",54,"ن",1,0],["ما اقتنى مثلك دهر السْ","سُوء إلاّ حين إفلاسي",55,"ي",1,0],["ما أقربَ النُّهزة َ من مُعاجل","وأبعدَ العثرة َ من مُماهل",56,"ل",1,0],["ما أقدر اللّه أن يحييك ثانية","مع الربيع كما من قبل سوّاك",57,"ك",1,0],["ما اقتَرَفتُ الذنوبَ يا قوم إِلا","في هوى مَنْ تطيبُ فيه الذنوبُ",58,"ب",1,0],["ما أقرب الرحمة من مجرم","بالتوبِ أعطى أجر ما أجرما",59,"م",2,0],["ما أقعوا في الهلك أنفسهم عمىٍ","لكن قضاء الله غطّى الأعينا",60,"ن",2,0],["ما اقدر المجد أن يرضيك عن نفر","هم من يديك مكان السيف والدرق",61,"ق",1,0],["ما أقدر الله ان يكفى الاذى رجلا","يبغى عليه فيلقى الأمر محتسبا",62,"ب",2,0],["ما أَقبَحَ الذُلَّ بِالحُرِّ الكَريمِ وَما","أَسوا وَأَقبَحَ مِنهُ العِزُّ بِاللُكَعِ",63,"ع",1,0],["ما أَقلَعوا يَضرِبونَ الأَمرَ