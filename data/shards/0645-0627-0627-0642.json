{"poems":[[53,"ما أقل اعتبارنا بالزمان","https://www.aldiwan.net/poem29740.html","الخفيف"],[53,"نخطو وما خطونا إلا إلى الأجل","https://www.aldiwan.net/poem29884.html","البسيط"],[55,"قالوا خراسان أقصى ما يراد بنا","https://www.aldiwan.net/poem26042.html","البسيط"],[73,"إعجب لحال السرو كيف تحال","https://www.aldiwan.net/poem11939.html","الكامل"],[93,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[93,"أنا في الروض ساهر وهو نائم","https://www.aldiwan.net/poem11410.html","الخفيف"],[83,"هذي العوالم لفظ أنت معناه","https://www.aldiwan.net/poem54231.html","البسيط"],[83,"هذا الصباح صباح الشيب قد وضحا","https://www.aldiwan.net/poem54333.html","الكامل"],[88,"لا يبلغ المرء منتهى أربه","https://www.aldiwan.net/poem45001.html","المنسرح"],[88,"أقوى مصيف القوم والمربع","https://www.aldiwan.net/poem45066.html","السريع"],[72,"كل حي قاض عليه زواله","https://www.aldiwan.net/poem19528.html","الخفيف"],[51,"لقد رأينا عجبا من العجب","https://www.aldiwan.net/poem8315.html","الرجز"],[51,"استقبل المهرجان بالفرح","https://www.aldiwan.net/poem9407.html","المنسرح"],[51,"يرجف القرد بأني","https://www.aldiwan.net/poem64612.html","مجزوء الرمل"],[51,"صد عن الأطلال لما استيأسا","https://www.aldiwan.net/poem64645.html","الرجز"],[51,"هل أنت من مرتجيك مستمع","https://www.aldiwan.net/poem65399.html","المنسرح"],[51,"مستعبد هيهات إعتاقه","https://www.aldiwan.net/poem65706.html","السريع"],[91,"لو كان لي غير قلبي عند مرآك","https://www.aldiwan.net/poem9048.html","عموديه"],[91,"لو أستطيع كتبت بالنيران","https://www.aldiwan.net/poem62773.html","عموديه"],[91,"كيف لا يشتد وسواسي","https://www.aldiwan.net/poem64704.html","مجزوء الرمل"],[89,"تعلموا تعلموا","https://www.aldiwan.net/poem44642.html","مجزوء الرجز"],[85,"مملكة مدبره","https://www.aldiwan.net/poem63766.html","مجزوء الرجز"],[43,"من أية الطرق يأتي نحوك الكرم","https://www.aldiwan.net/poem10572.html","البسيط"],[45,"مرت على عزمها ولم تقف","https://www.aldiwan.net/poem65159.html","المنسرح"],[45,"بالله يا ربع لما ازددت تبيانا","https://www.aldiwan.net/poem66659.html","البسيط"],[28,"من نازع طاعة حتى تكون له","https://www.aldiwan.net/poem5223.html","البسيط"],[49,"إن كنت تطمع في الحياة فهات","https://www.aldiwan.net/poem10393.html","الكامل"],[49,"ما أقرب الموت جدا","https://www.aldiwan.net/poem62058.html","المجتث"],[49,"هل عند أهل القبور من خبر","https://www.aldiwan.net/poem62099.html","المنسرح"],[49,"إن كان لا بد من موت فما كلفي","https://www.aldiwan.net/poem62176.html","البسيط"],[49,"أصبح هذا الناس قالا وقيل","https://www.aldiwan.net/poem63055.html","السريع"],[49,"امهد لنفسك واذكر ساعة الأجل","https://www.aldiwan.net/poem63060.html","البسيط"],[49,"ما أقطع الآجال للآمال","https://www.aldiwan.net/poem63067.html","الرجز"],[49,"ما أقرب الموت منا","https://www.aldiwan.net/poem63162.html","المجتث"],[49,"الدهر ذو دول والموت ذو علل","https://www.aldiwan.net/poem63190.html","البسيط"],[44,"فحواك عين على نجواك يا مذل","https://www.aldiwan.net/poem30389.html","البسيط"],[105,"هم سادة الحرب من شيب وشبان","https://www.aldiwan.net/poem43573.html","البسيط"],[52,"ما أقصر الليل على الراقد","https://www.aldiwan.net/poem27118.html","السريع"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"ما أقبح الهجر بالمحب وما","https://www.aldiwan.net/poem65234.html","المنسرح"],[50,"يا خاتم الملك يا سمعي ويا بصري","https://www.aldiwan.net/poem63811.html","البسيط"],[50,"آب ليلي ليت ليلي لم يأب","https://www.aldiwan.net/poem64814.html","الرمل"],[46,"ما أقبح المين قلتم لم يشب أحد","https://www.aldiwan.net/poem23380.html","البسيط"],[46,"ما أقدر الله أن يدعى بريته","https://www.aldiwan.net/poem23451.html","البسيط"],[76,"ما أقرب اليأس من رجائي","https://www.aldiwan.net/poem39504.html","مخلع البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202529","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202637","المجتث"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12757","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/2893","البسيط"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/117005","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54247","البسيط"],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[91,"الحرب العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=53314",""],[51,"كيف لا يشتد وَسْواسي","https://www.poetsgate.com/ViewPoem.aspx?id=29275",""],[51,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[91,"الفراشة المحتضرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67880&r=&rc=160",""],[153,"أمل نازح ووجد قريب","https://www.aldiwan.net/poem55771.html","الخفيف"],[158,"يزداد هجرا كل ما كلما","https://www.aldiwan.net/poem58866.html","السريع"],[158,"كانت أحادا عند غيرك لا ثنا","https://www.aldiwan.net/poem58919.html","الكامل"],[158,"أرخا أثيث الدجى الجاني على الفلق","https://www.aldiwan.net/poem59000.html","البسيط"],[158,"ما فته حظه من أجل الطلبا","https://www.aldiwan.net/poem59115.html","البسيط"],[167,"إلى م أورد عتباً غير مستمع","https://www.aldiwan.net/poem1637.html",""],[193,"إن الخليط أجدوا البين فانقذفوا","https://www.aldiwan.net/poem54398.html","البسيط"],[202,"ماذا يضر الحبيب لو عطفا","https://www.aldiwan.net/poem53250.html","المنسرح"],[235,"البحر قد أبدى سنا نضرته","https://www.aldiwan.net/poem18084.html","السريع"],[268,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[296,"أنا لست أدري كيف أرثي واحدا","https://www.aldiwan.net/poem36266.html","عموديه"],[296,"حيتك باسمة ثغور الزنبق","https://www.aldiwan.net/poem36840.html","عموديه"],[303,"أحيا قدومك مرعى الجود والجود","https://www.aldiwan.net/poem56574.html","البسيط"],[324,"ما اقبح التزهيد من واعظ","https://www.aldiwan.net/poem44285.html","السريع"],[326,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[369,"ما أقامت إلا لترحل صبري","https://www.aldiwan.net/poem57468.html","البسيط"],[388,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[400,"إني أرى العمر قد تقضى","https://www.aldiwan.net/poem33436.html","مخلع البسيط"],[429,"أيها اللائم لم غي","https://www.aldiwan.net/poem12544.html","مجزوء الرمل"],[429,"رحلوا فالسقام عندي مقيم","https://www.aldiwan.net/poem12718.html","الخفيف"],[436,"حسبي رضاك من الدهر الذي عتبا","https://www.aldiwan.net/poem34821.html","البسيط"],[441,"في إثر سعيد يا أسعد","https://www.aldiwan.net/poem55931.html","عموديه"],[459,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[475,"يا راقد الطرف طرفي في يد السهر","https://www.aldiwan.net/poem15249.html","البسيط"],[477,"غب التحية أنهي","https://www.aldiwan.net/poem36939.html","المجتث"],[493,"قبحا لهذا الزمان ما أربه","https://www.aldiwan.net/poem9768.html","المنسرح"],[549,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[556,"لم يفه يا ذا الوجه فم","https://www.aldiwan.net/poem34084.html","المديد"],[577,"رجواك في الله لاتخطأ مراميه","https://www.aldiwan.net/poem56780.html","البسيط"]],"verses":[["ما أَقَلَّ اِعتِبارَنا بِالزَمانِ","وَأَشَدَّ اِغتِرارَنا بِالأَماني",0,"ن",2,1],["ما أَقرَبَ الوَجدَ مِن قَلبٍ وَمِن كَبِدٍ","وَأَبعَدَ الأُنسَ مِن دارٍ وَمِن طَلَلِ",1,"ل",1,0],["ما أَقدَرَ اللَهَ أَن يُدني عَلى شَحَطٍ","جيرانَ دِجلَةَ مِن جيرانِ جَيجانا",2,"ن",2,0],["ما أَقبَحَ الدُنيا خِلافَ مُوَدَّعٍ","غَنِيَت بِهِ في حُسنِها تَختالُ",3,"ل",1,0],["مَا أَقْبَلَتْ مُنْقَادَةً بِزِمَامِهَا","بَلْ أَقْبَلَتْ مُنْقَادَةً بِذِمَامِ",4,"م",1,0],["ما أَقَرَّ النَّدى وَمَا أَلْعَبَ النُّو","رَ وَمَا أَجْزعَ الظِّلالَ الْحَوَائِمْ",5,"م",1,0],["ما أَقبحَ العبد أن ينسى وتذكرُه","وأنت باللطف والإحسان تَرعاهُ",6,"ا",2,0],["ما أقدرَ اللهَ أن يدني على شحطٍ","وأن يُقرْبَ بعد البين من نزحا",7,"ح",2,0],["ما أقدر العلمَ أنّ صَيْحته","يُمْعِن منها الخميس في هربه",8,"ب",2,0],["ما أقدر الموت فمن هوله","لم ينجُ لا كسرى ولا تُبَّع",9,"ع",1,0],["ما اقتضى حظّنا بقاءك فينا","واحداً تشمل الأنام ظلاله",10,"ل",2,0],["ما أقبح النَّعماءَ يُكْسَى ثوبَها","وأحسنَ النعماءَ عنه تُستَلبْ",11,"ب",1,0],["ما اقترَح السُّؤْل مثلَكَ ابنَ أبي","بكْرٍ لِمَا نَرْتَجِي من المِنحِ",12,"ح",1,0],["ما اقتنى مثلك دهر ال","سوء إلا حين أفلس",13,"س",1,0],["ما أقْمرَ ابْنا أبدٍ وأشْمسا","لو اسْتعنْتَ في المعاني هِرْمسا",14,"س",2,0],["ما أقبح المطل من أخي كرم","وعيب من قل عيبه شَنِع",15,"ع",1,0],["ما أقرب المعروف من كفه","فلِم أَغَبَّتنيَ أفواقه",16,"ق",2,0],["ما أَقدَرَ اللَهَ أَن يُحَيِّكِ ثانِيَةً","مَعَ الرَبيعِ كَما مِن قَبلُ سِوّاكِ",17,"ك",1,0],["ما أَقبَحَ الإِنسانَ ةَقتُلُ جارَهُ","وَيَقولُ هَذي سُنَّهُ العِمرانِ",18,"ن",1,0],["ما اقتنى مثلك دهر ال","سوءِ إلا حين إفلاسي",19,"ي",1,0],["ما اقبح الجهل فمنه","كل شر ينجم",20,"م",1,0],["ما اِقتَرَضَت مِن بَقلَةٍ","أَوِ اِستَعارَت زَهَرَه",21,"ر",2,0],["ما أَقدَرَ اللَهَ أَن يُخزي خَليقَتَهُ","وَلا يُصَدِّقُ قَوماً في الَّذي زَعَموا",22,"م",3,0],["ما اِقتَصَّ واليسُ في الفَضاءِ وَجا","بانُ وَما سَيَّرا مِنَ النُتَفِ",23,"ف",1,0],["ما أَقشَعَت سَمَواتٌ مِن نَوافِلِهِ","إِلّا وَأَسخَطُنا لِلدَهرِ أَرضانا",24,"ن",2,0],["ما اِقتَسَمَ الناسُ مِن ميراثِ مُقتَسَمٍ","عِندَ التُراثِ إِذا في قَبرِهِ اِنحَدَرا",25,"ر",2,0],["ما أَقرَبَ الشَيءِ الجَديدَ مِنَ البِلى","يَوماً وَأَسرَعَ كُلَّ ما هُوَ آتِ",26,"ت",1,0],["ما أَقرَبَ المَوتَ جَدّا","أَتاكَ يَشتَدُّ شَدّا",27,"د",2,1],["ما أَقطَعَ المَوتَ لِلصَديقِ وَما","أَقرَبَ صَفوَ الدُنيا مِنَ الكَدَرِ",28,"ر",1,0],["ما أَقدَرَ اللَهَ أَن يُغَيِّرَ ما","أَصبَحتَ فيهِ فَكُن عَلى حَذَرِ",28,"ر",1,0],["ما أَقرَبَ الحَينَ مِمَّن لَم يَزَل بَطِراً","وَلَم تَزَل نَفسُهُ توفي عَلى شَرَفِ",29,"ف",1,0],["ما أَقتَلَ الدُنيا لِأَزواجِها","تَعُدُّهُم عَدّاً قَتيلاً قَتيل",30,"ل",1,0],["ما أَقرَبَ المَوتَ مِن أَهلِ الحَياةِ وَما","أَحجى اللَبيبَ بِحُسنِ القَولِ وَالعَمَلِ",31,"ل",1,0],["ما أَقطَعَ الآجالَ لِلآمالِ","وَأَسرَعَ الآمالَ في الآجالِ",32,"ل",1,1],["ما أَقرَبَ المَوتَ مِنّا","تَجاوَزَ اللَهُ عَنّا",33,"ن",2,1],["ما أَقرَبَ المَوتَ في الدُنيا وَأَفظَعَهُ","وَما أَمَرَّ جَنى الدُنيا وَأَحلاهُ",34,"ا",2,0],["ما أَقبَلَت أَوجُهُ اللَذّاتِ سافِرَةً","مُذ أَدبَرَت بِاللِوى أَيّامُنا الأُوَلُ",35,"ل",1,0],["ما أقربَ الحقَّ ممّا يَبتغي عُمَرٌ","لو لم تكنْ لأبٍ للحقِّ صَوَّانِ",36,"ن",1,0],["ما أَقصَرَ اللَيلَ عَلى الراقِدِ","وَأَهوَنَ السَقمَ عَلى العائِدِ",37,"د",1,1],["ما أَقَامَ الصلاةَ مَنْ عَبَدَ الل","هِ وقامتْ بِربِّهَا الأشياءُ",38,"ا",2,0],["ما أَقبَحَ الهَجرَ بِالمُحِبِّ وَما","أَحسَنَ وَصلَ الحَبيبِ لَو عَلِما",39,"م",2,1],["ما أَقرَبَ العَيشَ مِنهُ إِن صَفوتِ لَهُ","وَما أَجَرَّ عَليهِ المَوتَ بِالكَدَرِ",40,"ر",1,0],["ما أَقَلَّ الصَبرَ عَنها بَعدَما","كَثُرَت فينا أَحاديثُ العَرَب",41,"ب",1,0],["ما أَقبَحَ المَينَ قُلتُم لَم يَشِب أَحَدٌ","حَتّى أَتى الشَيبُ إِبراهيمَ عَن أُمَمِ",42,"م",1,1],["ما أَقدَرَ اللَهَ أَن يُدعى بَرِيَّتُهُ","مِن تُربِهِم فَيَعودا كَالَّذي كانوا",43,"ن",3,1],["مَا أَقْرَبَ اليَأسَ مِنْ رَجائي","وَأبعدَ الصَّبرَ مِنْ بُكائي",44,"ي",1,1],["ما أقبح الكذب على الرّفات","والكذب من أراذل الصفات",45,"ت",1,0],["ما أقصر العمر حتى","نضيعه في النضال",46,"ل",1,0],["ما أَقتَلَ اليَأسَ لِأَهلِ الهَوى","لاسِيَّما مِن بَعدِ إِطماعِ",47,"ع",1,0],["ما أَقَلَّ الوَفاءَ ما أَضعَفَ الطا","لِبَ في ذا الزَمانِ وَالمَطلوبا",48,"ب",2,0],["ما أَقطَعَ المَوتَ لِلأَماني","وَالأَمَلِ النازِحِ الطَويلِ",49,"ل",1,0],["ما أقرب الأشياء حين يسوقُها","قدَرٌ وأبعدها إذا لم تُقدَر",50,"ر",1,0],["ما أقصر العمر في الدنيا لنابغةٍ","إذا تطلّعت الدنيا له راحا",51,"ح",2,0],["ما أقبحَ الأحرارَ حو","لَ «السين» تخضع للعبيد",52,"د",1,0],["ماأقبح الإنسان يقتل جاره","ويقول هذي سنّة العمران",53,"ن",1,0],["ما اقتنى مثلك دهر السْ","سُوء إلاّ حين إفلاسي",54,"ي",1,0],["ما أقربَ النُّهزة َ من مُعاجل","وأبعدَ العثرة َ من مُماهل",55,"ل",1,0],["ما أقدر اللّه أن يحييك ثانية","مع الربيع كما من قبل سوّاك",56,"ك",1,0],["ما اقتَرَفتُ الذنوبَ يا قوم إِلا","في هوى مَنْ تطيبُ فيه الذنوبُ",57,"ب",1,0],["ما أقرب الرحمة من مجرم","بالتوبِ أعطى أجر ما أجرما",58,"م",2,0],["ما أقعوا في الهلك أنفسهم عمىٍ","لكن قضاء الله غطّى الأعينا",59,"ن",2,0],["ما اقدر المجد أن يرضيك عن نفر","هم من يديك مكان السيف والدرق",60,"ق",1,0],["ما أقدر الله ان يكفى الاذى رجلا","يبغى عليه فيلقى الأمر محتسبا",61,"ب",2,0],["ما أَقبَحَ الذُ