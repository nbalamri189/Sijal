poetsgate.com/ViewPoem.aspx?id=199886",""],[5009,"في ذكرى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=24366",""],[3271,"راهب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=104128",""],[5219,"الرحمة المزجاة","https://www.poetsgate.com/ViewPoem.aspx?id=194855",""],[5277,"صرخةُ العراقيين","https://www.poetsgate.com/ViewPoem.aspx?id=199841",""],[5277,"بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=200588",""],[5338,"معارضة قصيدة بات سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=187941",""],[592,"على الحبر بحر العلم الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128858",""],[5362,"زار مخافة الرقيب غلسا","https://www.poetsgate.com/ViewPoem.aspx?id=170388",""],[5373,"مَنِ الرَّزَّاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=185996",""],[5431,"جميلٌ أنْ يُرى بالحبِ طقسٌ","https://www.poetsgate.com/ViewPoem.aspx?id=185411",""],[5431,"في حب الله ...","https://www.poetsgate.com/ViewPoem.aspx?id=202478",""],[5431,"تسلل ضوئي...","https://www.poetsgate.com/ViewPoem.aspx?id=202580",""],[5725,"آنست ناراً","https://www.poetsgate.com/ViewPoem.aspx?id=193432",""],[402,"بحمدون إن تنشق عليل نسيمها","https://www.poetsgate.com/ViewPoem.aspx?id=36323",""],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""],[469,"محيّكِ أحيا الوجدَ بل اتلفَ الصبّا","https://www.poetsgate.com/ViewPoem.aspx?id=76783",""],[5908,"يا دار علوة حياك الحيا الهطل","https://www.poetsgate.com/ViewPoem.aspx?id=170977",""],[5943,"ملاذك","https://www.poetsgate.com/ViewPoem.aspx?id=34491",""],[5997,"أباكَ","https://www.poetsgate.com/ViewPoem.aspx?id=214261",""],[6191,"ما لن يكتب عنِ المسيحِ الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88108&r=&rc=6",""]],"verses":[["هُوَ الرُزءُ لا يَعدو المَكارِمَ وَالعُلى","صَلومٌ لِأَشرافِ العَلاءِ جَدوعُ",0,"ع",1,0],["هُوَ الرِزقُ مَقَسوماً وَلَيسَ تَنالُهُ","بِبَردِ التَباطي أَو بِحَرِّ الحَثاحِثِ",1,"ث",1,0],["هوَ الرَّبْعُ لا قَوْسي عَلى مَيْعَةِ الصِّبا","مُعَطَّلةٌ فيهِ ولا أسْهُمي مُرْطُ",2,"ط",1,0],["هُوَ الرُزءُ المُبَيِّنُ لا كُباسٌ","عَظيمُ الرَأيِ يَحلُمُ بِالنَعيقِ",3,"ق",1,0],["هُوَ الرِّفْقُ بِالضَّعْفَى وَأَيُّ مَبَرَّةٍ","عَلَى اللهِ مِنْ هَذِي المَبَرَّةِ أَكْرَمُ",4,"م",1,0],["هو الرجل الذي في مصر قامت","له همم تنفّس كل كَرب",5,"ب",1,0],["هو الرشاد الذي يحمي خلافتنا","ويرشد العُرب والأتراك والعجما",6,"م",2,0],["هُوَ الرِجسُ يا أَهلَ المَدينَةِ فَاِحذَروا","مُداخِلَ رِجسٍ بِالخَبيثاتِ عالِمِ",7,"م",1,0],["هُوَ الرَجُلُ الَّذي جَلَبَ اِبنُ سَعدٍ","وَعُثمانٌ مِنَ البَلَدِ الشَآمِ",8,"م",1,0],["هُوَ الرَجُلُ الَّذي حُدِّثتَ عَنهُ","غَريبٌ بَينَ زَمزَمَ وَالمَقامِ",8,"م",1,0],["هو الرفد يتلو الودّ طابَ كلاهما","كما حملت للمحل روحِ الصبا المزنا",9,"ن",2,0],["هو الرجلُ المشْرُوك في جُلِّ مالِهِ","ولكنَّه بالخيْرِ والحمْدِ مفردُ",10,"د",1,0],["هو الرزْءُ لا يسْطيعُ نَهضاً بثِقلهِ","سوى ابنِ يقينٍ عاذ بالله واعتصمْ",11,"م",1,0],["هُوَ الرَكبُ لا رَكبُ النُمَيرِيُّ سالِفاً","وَلا الرَكبُ ما بَينَ النَقا وَالأَناعِمِ",12,"م",1,0],["هُوَ الرَجُلُ الَّذي نَسَبَت قُرَيشٌ","فَصارَ المَجدُ مِنها حَيثُ ضارا",13,"ر",2,0],["هو الربعُ لم يُخْلَق بنوه أعزَّةً","كِراماً ولم تَنبُتْ قناهُ صلابَا",14,"ب",2,0],["هُوَ الراعي وَنَحنُ لَهُ سَوامٌ","وَلَم أَرَ مِثلَهُ راعي سَوامِ",15,"م",1,0],["هُوَ الرَبعُ مِن أَسماءَ وَالعامُ رابِعٌ","لَهُ بِلِوى خَبتٍ فَهَل أَنتَ رابِعُ",16,"ع",1,0],["هو الركب غاديهِ سلامٌ ورائحُهْ","تبلّجَ يُغشِي ناظِرَ الشّمسِ واضِحُهْ",17,"ح",2,1],["هو الركبُ فيه من سَنا الحقِّ لمحةٌ","تَجمَّع ساري النّورِ فيها وسابِحُهْ",17,"ح",2,0],["هو الرمحُ فاطعنْ كيفَ شئتَ بصدره","فلن يَسأمَ الهيجا ولن يتكسَّرا",18,"ر",2,0],["هُوَ الرِزقُ يُجريهِ المَليكُ وَلَن تَرى","أَخا عيشَةٍ بِالحِرصِ يُطعَمُ أَو يُسقى",19,"ق",2,1],["هو الرجلُ القلبُ لا غيرُهُ","فأودِعْنَهُ القبسَ المضرَما",20,"م",2,0],["هُوَ الروضُ أو أَزْهَى من الروض نَضْرَةً","إِذا داعبَتْ وَجْهَ الربيع خَمائِلُهْ",21,"ل",2,0],["هو الروضةُ الغنَّاءُ، طنَّ ذبابُها","ففارقَ مغناها من الطير هاتفُه",22,"ف",2,0],["هوَ الرّجلُ الّذي نسبتْ قريشٌ","فصارَ المجدُ منها حيثُ صارا",23,"ر",2,0],["هو الرفاعي ذو القدر الرفيع فتى","آل البتول اجل القوم عرفانا",24,"ن",2,0],["هو الرفاعي سلطان الرجال ومن","به يثبت عند الخطب مبغوت",25,"ت",1,0],["هو الرحمة العظمى التي جل قدرها","وفجر لليل الكفر قد جاء ماحيا",26,"ي",2,0],["هُو الرَّوضَةُ الغَّنَاءُ والغُرَّةُ التى","بِهَا يَهتَدِى السَّارِى الطَّرِيدُ المُؤرَّقُ",27,"ق",1,0],["هُوَ الرَئيسُ الَّذي لا خَلقَ يَقدُمُهُ","غَداةَ يَحمي عَنِ الأَبطالِ بِالعَلَمِ",28,"م",1,0],["هو الروض النضير وكم نعيم","بساحتهِ وكم فيه تهاني",29,"ن",2,0],["هُوَ الرَتقُ لِلخَطبِ الَّذي جَلَّ فَتقُهُ","هُوَ الغَوثُ بَعدَ اليأسِ أُدرِكَ رِفقُهُ",30,"ه",1,0],["هو الرأس والهادي لآل محمد","فلا زال للسرب الرسول هاديا",31,"ي",2,0],["هو الرُوحُ في بدنِ المكرُماتِ","وبالرُّوحِ يُرجى بقاءُ البدَنْ",32,"ن",1,0],["هو الروح والجسم سجن له","وروحك حر بهذا المجال",33,"ل",1,0],["هو الرحمة المهداة والنعمة التي","بها حبر الرحمن كل موقذ",34,"ذ",1,0],["هو الروض للآداب والذوق يانع","ولولاه أفضى الفضل للجدب والقحط",35,"ط",1,0],["هُوَ الرَحمة المهداة للخلق حبذا","كَريم السَجايا خير باد وَحاضِر",36,"ر",1,0],["هُوَ الرَحمن حولى واِعتصامي","به واليه مبتهلا أَنيب",37,"ب",1,0],["هُوَ الرَّسْمُ لَوْ أَغْنى الْوُقُوفُ عَلَى الرَّسْمِ","هُوَ الْحَزْمُ لَوْلا بُعْدُ عَهْدِكَ بِالْحَزْمِ",38,"م",1,1],["هو الراميك عن أمم وعرض","إِذا مَا الرَّأْيُ قَرْطَسَ في السَّدَادِ",39,"د",1,0],["هَوَ الريمُ لَكِنَّهُ ما يُرامُ","لَدَيهِ يَذُلُّ الهِزَبرُ الهَصورُ",40,"ر",1,0],["هو الرزق إن وافاك سعياً فهينٌ","وإن تاته في عيصةٍ فعويص",41,"ص",1,1],["هو الرب لا رب سواه وكلهم","عبيد وتحت الحكم من غير فارق",42,"ق",1,0],["هو الرمحُ إلّا أنّه غير راعشٍ","هو السّهم لكن لا يَطيشُ ولا يجبي",43,"ب",2,0],["هو الرَّعْشَنُ المجهول أصلاً وحِرفَةً","فهل يصدقنَّ القولُ والقول راعش",44,"ش",1,0],["هُو الربعُ لكنْ غيِّر الدَّمعُ مَغْناهُ","فَلا تُنكِروه إنْ محاهُ وأبلاهُ",45,"ه",1,0],["هو الرأس في كل الضلالات كلها","وأول من شاد الضلال لآخر",46,"ر",1,0],["هوَ الرُّمْحُ إِلا أَنَّه مُتَقَسَّمٌ","ليومِ نَدًى يُرْجى ويَوْمِ طِعانِ",47,"ن",1,0],["هو الراهب المال الذي ليس غيرهُ","من الناس يعطي بعض ما هو واهبه",48,"ب",2,0],["هُوَ الرُّزْءُ أَلْوى بعزمِ القُلوبِ","مُصاباً وَأَوْدى بحُسنِ العزاءِ",49,"ا",2,0],["هو الرزء حتى كل قلب به جمر","وليس لعين لم يفض ماؤها عذر",50,"ر",1,1],["هو الرزء حتى خص ريش القوادم","وخص الخوافي في جناح المكارم",51,"م",1,1],["هو الراكب الدهماءَ تمشي بظهرها","على جَدَدٍ لا يحسد الركبَ راجلُهْ",52,"ل",2,0],["هو الرِّئْبالُ منْ تحتِ العَوالي","ويومَ السَّلْمِ بَسَّامٌ وَدودُ",53,"د",1,0],["هو الروض مخضر الظلال فسيحها","هو الغيث مخضل الأيادي عميمها",54,"م",3,0],["هو الروح المقدس فاق لطفا","خفاه الله من عين الزوال",55,"ل",1,0],["هو الركن الذي أسندت ظهري","إليه فكان أقوى من ثبير",56,"ر",1,0],["هوَ الرّدى يأخذُ مِن بَيننا","إِذْ هَمّ مَنْ شاء بلا ذنْبِ",57,"ب",1,0],["هوَ الرَّدى لَيسَ لَه مَدفعٌ","وَالمَوتُ لا يَقبلُ بذلَ الرّشا",58,"ا",1,0],["هو الروح روح الكل والقلم الذي","به الكل مكتوب له اللوح واضع",59,"ع",1,0],["هو الركبان والحادي","هو السبعون والحادي",60,"د",2,1],["هو الرَّحمَةُ العُظمَى التي أحيَتِ الرُّبَى","إلى أن كسَتْها حُلَةَ السُّندسُ الخُضْرِ",61,"ر",1,0],["هُوَ الرُّكنُ الذي لولاهُ كادتْ","قواعدُ طُورِ لُبنانٍ تَميدُ",62,"د",1,0],["هو الرَّشِيدُ الَّذي رئاستُه","سارَتْ بلا زاجرٍ ولا سَائِقْ",63,"ق",1,0],["هو الرحمن يرحم متقيه","إذا ما صدرهم بالحزن جاشا",64,"ش",2,0],["هوَ الراشد المهديّ وَالمرشد الَّذي","لمصر غَدا في الكَون أَعدَل حاكم",65,"م",1,0],["هو الرأسُ وهْو الناسُ والناسُ دونه","هو الملكُ العدْلُ الذي ليس يبخَسُ",66,"س",1,0],["هو الرُّزء قد ألقى قناعَ تجمُّلي","وأبرز للأشجان حرًّ سَوافحي",67,"ح",2,0],["هو الروض بل أزكى ولولاه ما بدت","محاسنه للناظر المتفرّس",68,"س",1,0],["هو الرحيم هو البر الرحيم هو ال","مولى الكريم الذي بالجود قد عرفا",69,"ف",2,0],["هو الرحمة العظمى التي عم نفعها","جميع الورى ما بين دان وشاسع",70,"ع",1,0],["هو الرحمة العظمى التي عم نفعها","هو العروة الوثقى التي ليس تفصم",71,"م",1,0],["هو الرمح قدّاً واعتدالاً ولحظه","سنان به ما زال قلبي يوخز",72,"ز",1,0],["هو الروض الذي أنشى فروعاً","لها الشيمُ الزواكي العاطراتُ",73,"ت",1,0],["هُوَ الرَّبْعُ أَذْهَبَ عَنّا الْحَزَنْ","بِمَغْناهُ وَصْلُ الْغَزالِ الأَغَنْ",74,"ن",1,1],["هو الرؤف الرحيم المشفق المر","تضى والمنتقى ذو الأفضلية",75,"ي",2,0],["هوالرزء الذي ابتدع الرزايا","وقال لا عين الأعداء نامي",76,"م",2,0],["هُوَ الرَوض انساً وَالنَسيم لَطافةً","هُوَ الطَود حِلماً وَبِهِ اِعتَصَمت اسد",77,"د",1,0],["هُوَ الرَحمَة العُظمى هُوَ النعمة الَّتي","غَدا شُكرها فَرضاً عَلى كُل عاقِلِ",78,"ل",1,0],["هو الرمحُ سلْ عنه فؤادَ حسوده","بما بات يلقى من شبا ذلك الرمح",79,"ح",1,0],["هو الرئيس الذي جلَّت مناقبه","وليس يُنكر ضوءَ الشمس غيرُ عَمي",80,"م",2,0],["هو الروضة الغناءُ أما قريضهُ","فحانُ علومٍ مترعٌ بالبلاغةِ",81,"ه",1,0],["هو الروة الوثقى به الغوث في اللِّقا","كريم عظيم قدره ومكين",82,"ن",1,0],["هو الربع فانثر إِن مررتَ بسفْحِهِ","لآلِئَ دمعٍ من لحاظٍ سواجمِ",83,"م",1,0],["هو الرسول الذي من جاء يطلبه","بعقله فبهذا القدر أكفيه",84,"ف",3,0],["هو الرّؤوف الرحيم جاء","في توبة نصُّها عجيب",85,"ب",1,0],["هو الرسولُ الذي أعلامُهُ بَهَرت","فعمَّتِ الأرضَ نُوراً ساطِعاً وَهُدى",86,"د",2,1],["هو الرسول الذي لاحت دلائله","أبدى وأهدى من السيارة الزهر",87,"ر",1,1],["هو الرّصينُ لم تُزحزِحه عوا","صفُ الحوادثِ كطودٍ قد رسا",88,"ا",1,0],["هو الرزق من ربٍ كفيلٍ وإنها","من اللَه أرزاق على الخلق تقسم",89,"م",1,0],["هو الرضى من عز لبنان به","محتمياً بوائق الايام",90,"م",1,0],["هُوَ الرَفيع الذرى المَشكور نائله","ومن له راحة فاضَت عطاياها",91,"ا",3,0],["هو الروض روض بالمعارف يزدهى","فمالك يا روض المعارف ذابل",92,"ل",1,0],["هُوَ الراقي ذَرى شَرَف","وَأَضحى عالي القَدر",93,"ر",1,0],["هُوَ الراقي ذرى شَرف وَمَجد","وَفي العَلياء مُنقَطع المَثيل",94,"ل",1,0],["هو الروض قد طابت شذا نفحاته","ودلت على طيب الجنى والمغارس",95,"س",1,0],["هو الروح بالعلم أحيى قلوبا","وكم جاهل كاد بالجهل سوى",96,"و",2,0],["هو الروض يشجى السمع ساجع ورقه","ويعرب عن ألحان كل مغرد",97,"د",1,0],["هو الرسول الذي نباه خالقه","وكان آدم بين المآ والطين",98,"ن",1,0],["هو الروح لو خوطب الميت فيه","لأغناه في الحشر عن ناشر",99,"ر",1,0],["هو الرحمة المهداة للناس كلهم","هو المرهم الشافي من الهضم والكسرِ",100,"ر",1,0],["هُوَ الرَوض ريح المَجد مِنهُ يَفوح","لَقَد طابَ جسم من شذاه وَروح",101,"ح",1,1],["هو الرجل المعروف بالصدق