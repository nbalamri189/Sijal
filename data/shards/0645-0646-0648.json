يط"],[430,"وباقة زهر من أقاح منحتها","https://www.aldiwan.net/poem41431.html","الطويل"],[433,"كان لك الله يا أبا الحسن","https://www.aldiwan.net/poem12329.html","المنسرح"],[450,"الجود والمجد","https://www.aldiwan.net/poem973.html",""],[454,"الله في الحب ألحان واضواء","https://www.aldiwan.net/poem61241.html","البسيط"],[459,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[459,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[462,"وصوب حيا جاشت غوارب سيبه","https://www.aldiwan.net/poem16396.html","الطويل"],[465,"هاتيك دراهم وتلك الأربع","https://www.aldiwan.net/poem3193.html","عموديه"],[469,"من واجب المرء ألا","https://www.aldiwan.net/poem59887.html","المجتث"],[483,"نور الحق هداني بفضل عطاني","https://www.aldiwan.net/poem24198.html","عموديه"],[483,"البين في سقر","https://www.aldiwan.net/poem24370.html","عموديه"],[500,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[501,"وحياتكم يا أهل منعرج اللوى","https://www.aldiwan.net/poem37677.html","الكامل"],[501,"آيات تلك الحضرة القدسيه","https://www.aldiwan.net/poem37708.html","الكامل"],[501,"كم نشرنا من طامس وطوينا","https://www.aldiwan.net/poem37722.html","الخفيف"],[501,"قسما بثائرة الغرام المذهل","https://www.aldiwan.net/poem37925.html","الكامل"],[506,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[552,"رضيت بالدون لما لم أجد وزرا","https://www.aldiwan.net/poem47161.html","البسيط"],[559,"هذه كل ظاهر هو فيها","https://www.aldiwan.net/poem33681.html","الخفيف"],[559,"قطع الجهول زمانه بتغزل","https://www.aldiwan.net/poem34311.html","الكامل"],[564,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["مُنُّوا عَلَى الْجَوْفِ بِالأَمَانِي","فَأَنْتُمُ جُمْلَةُ الأَمَانِي",0,"ن",2,0],["مِنْ واصِلٍ للجوعِ لا لرِياضَةٍ","أو لابِسٍ للصّوفِ غيْرِ مُريدِ",1,"د",1,0],["مِن واجِدٍ مُنَقِّرِ المَنامِ","طَريدَ دَهرٍ جائِرِ الأَحكامِ",2,"م",1,1],["مَنْ وَسَّعَ المَوْلَى عَلَيْهِ بِرِزْقِهِ","أَيَضِنُّ بِالدِّينَارِ أَوْ بِالدِّرْهَمِ",3,"م",1,0],["من وجه مولانا النقيب","ووجه مولانا الأمير",4,"ر",1,0],["من وحش نَيَّان أو من وحش ذي بَقَر","أفنى خلائله الأشِلاءُ والطَّرَدُ",5,"د",1,1],["من والدٍ في العلى ومن ولدٍ","قد جاء عن علمه وأعلامه",6,"م",2,0],["من وعيدٍ نما إليَّ عن القا","ضي فما يستقرُّ قلبي وَجيبا",7,"ب",2,0],["من واهَقَ الريحَ وهي جاريةٌ","أَقصر أو كانَ قَصْرَهُ لَغَبُهْ",8,"ب",2,0],["منُّوا عليه وشَيَّدوا من ذكره","وبمثلها رفعوا البيوتَ وشادوا",9,"د",3,0],["من وجهُهُ الوجهُ الجمي","لُ وشخصهُ الشخصُ الجهيرُ",10,"ر",1,0],["منوعٌ وجيزُ المنع غيرُ مدافعٍ","يرى أن وشك المنع أمضى وأصرمُ",11,"م",1,0],["مِنْ وجهها أبداً نهارٌ واضحٌ","من فرعها ليلٌ عليه بهيم",12,"م",1,0],["مِن وَحشِ حَوضى يُراعي الصَيدَ مُبتَقِلاً","كَأَنَّهُ كَوكَبٌ في الجَوِّ مُنَجَرِدُ",13,"د",1,0],["مِن والِدٍ دَنِسٍ وَخالٍ ناقِصٍ","وَحَديثُ سوءٍ فيكُمُ وَقَديمُ",14,"م",1,0],["مَنّوا بِأَسرِهِمِ إِيّاكِ أَنفُسَهُم","فَأَصبَحوا بِتَمَنّيهِم أَساراكِ",15,"ك",1,0],["مِن وَصلِكَ بِالقَليلِ يَرضى","الطَلُّ مِنَ الحَبيبِ وابِل",16,"ل",1,0],["مُنّوا بِها كَرَماً عَلَيَّ فَإِنَّها","مِن أَعظَمِ الأَشياءِ عِندي مَوقِعا",17,"ع",2,0],["مِنْ وراءِ الظَّلامْ","وهديرِ المياهْ",18,"ه",1,0],["مُنوا بِقاسي القَلب لَيسَ يَرحَمُ","وَلَيسَ تَثنيهِ عَلَيهُم رَحِم",19,"م",1,0],["مِن وَراءِ الإِذنِ نالَت ضَيغَماً","لَم يَنَل أَقرانَهُ إِلّا وِجاها",20,"ا",3,0],["مُنَوِّرَةٌ كَالبَدرِ شَمّاءُ كَالسُها","وَتُخفَضُ في حَقٍّ وَعِندَ صَلاةِ",21,"ه",1,0],["مَن وَجَدَ المَذهَبَ عَن قَدرِهِ","لَم يَجِدِ المَذهَبَ عَن قَنسِهِ",22,"س",2,0],["منوعٌ لأطراف الممالك حافظٌ","جَمُوعٌ لأشتاتِ العَلاءِ كَسُوبُ",23,"ب",1,0],["مِن وَراءِ البابِ المُمَنَّعِ وَالسِت","رِ المُطاطا وَالحَجِبِ المَحجوبِ",24,"ب",1,0],["مِن وامِقٍ مُتَشَوِّقٍ أَو آمِلٍ","مُتَشَوِّفٍ أَو راقِبٍ مُتَنَظِّرِ",25,"ر",1,0],["مِن وَراءِ السُجوفِ كُثبانُ رَملٍ","تَتَثَنّى أَفنانُهُنَّ فُنونا",26,"ن",2,0],["مِن واضِحٍ يَقَقٍ وَأَصفَرَ فاقِعٍ","وَمُضَرَّجٍ جَسِدٍ وَأَحمَرَ قانِ",27,"ن",1,0],["مِن واقِفٍ في الهَجرِ لَيسَ بِواقِفٍ","وَمُوَدِّعٍ بِالبَينِ غَيرِ مُوَدِّعِ",28,"ع",1,0],["مِنْ وُجوهٍ مثلِ البدورِ صِباحٍ","وقُدودٍ مثلِ الغُصونِ رِشاقِ",29,"ق",1,0],["مِنْ وَلِيٍّ يَسيرُ في طُرُقِ الوُدْ","دِ ولا يَهْتدَي لِطُرْقِ النِّفاقِ",30,"ق",1,0],["من وجهكِ الحُسنُ اقتنى مُلَحاً","فكأنّها في وَجْهِهِ بِشرُ",31,"ر",1,0],["مَن وَدَّني بِلِسانِهِ وَبِقَلبِهِ","وَأَنالَني بِيَمينِهِ وَشِمالِهِ",32,"ل",2,0],["مَنْ وليَ الحسبةَ يصبرْ على","تعرُّضِ الواقفِ والسائرِ",33,"ر",1,1],["مَنْ وليَ الحسْبةَ يصبرْ على","تعرّضِ الواقفِ والعابرِ",34,"ر",1,1],["مُنُّوا علينا واحضروا","فحضورُكم أصلُ المسرَّهْ",35,"ه",1,0],["مِنْ وَصْفِه الأُسْدُ الضَّوارِي تَدَّعي","والخيلُ تَصْهَلُ والقواضِبُ تَبْرُقُ",36,"ق",1,0],["مَنّوا عَلَيهِم بِالحَياةِ ذَليلَةً","مَحيا الذَليلِ وَمَوتُهُ سِيّانِ",37,"ن",1,0],["من وحيد لأُمِّه وأبيه","جمعوه مفرَّقَ الأَوصال",38,"ل",1,0],["مِن وَحشِ خُبَّةَ أَودَعَتهُ نِيَّةٌ","لِلناطِلِيَّةِ مِن لِوى البَقّارِ",39,"ر",1,0],["من وَبْلِهِ وسَكْوبهِ ومُلِثّهِ","وسَفُوحِهِ ودَلوحِهِ وهَتونه",40,"ن",2,0],["مِن وَصيفٍ بِأَبي ذا","كَ وَبِالأُمِّ وَصيفا",41,"ف",2,0],["مِن وَلَدِ المَهدِيِّ في ذِروَةٍ","مُهَذَّبٍ يَخلِطُ حَزناً بِلين",42,"ن",1,0],["مِن وَحشِ وَجرَةَ مَوشِيٍّ أَكارِعُهُ","طاوي المُصَيرِ كَسَيفِ الصَيقَلِ الفَرَدِ",43,"د",1,0],["مِن وَسَخٍ صاغَ الفَتى رَبُّهُ","فَلا يَقولَنَّ تَوَسَّختُ",44,"ت",1,0],["مَنونَ رِجالٌ خَبِّرونا عَنِ البِلى","وَعادوا إِلَينا بَعدَ رَيبِ مَنونِ",45,"ن",1,1],["مِن وَحشِ أَنبَطَ باتَ مُنكَرِس","حَرِجاً يُعالِجُ مُظلِماً صَخِبا",46,"ب",2,0],["من وجهِهِ نَحْسٌ ومَن قُربِهِ","رِجْسٌ ومن عِرفانِهِ شُومُ",47,"م",1,0],["من وحد العرب حتى صار واترهم","إذا رأى ولد الموتور أخاه",48,"ا",2,0],["من وَتدٍ يكون حين لا سبب","فذلكَ المَقطوعُ حينَ يَنْتسبْ",49,"ب",1,0],["مِن وَليٍّ أو أَخي ثِقَةٍ","أو عَدُوٍّ شاحِطٍ دارا",50,"ر",2,0],["مُنُّوا عَلَيَّ بِوَصْلٍ أَسْتَعِيدُ بِهِ","مِنْ مُهْجَتِي رَمَقَاً يَحْيَا بِهِ الْبَدَنُ",51,"ن",1,0],["مِنْ وَالِدٍ بَرٍّ وَمِنْ بِضْعَةِ","طُهْرٍ أَنَارَا ظُلْمَةَ القَبْرِ",52,"ر",1,0],["مِن وَحشِ أَنبَطَ باتَ مُنكَرِساً","حَرِجاً يُعالِجُ مُظلِماً صَخِبا",53,"ب",2,0],["من وراء التلّ عنَتَّت غابةٌ","من أفاعٍ، وكهوف من عُواء",54,"ا",2,0],["مِنْ وَرَاءِ البَابِ المُمَنَّعِ وَالسّتْ","رِ المُطاطا، وَالحاجبِ المَحجوبِ",55,"ب",1,0],["من وردنا الأفلاك تسبيحة","والصبح والنجمة تكبيرتان",56,"ن",1,0],["من والد أغرى بها الحواسدا","لو خلتُ حالي تبتغي المُساندا",57,"د",2,0],["من وراء التلّ عنّت غابة","من أفاع ، وكهوف من عواء",58,"ا",2,0],["منورد الوَجنات خشية ناظر","أَضحى بِريحان العذار منقبا",59,"ب",2,0],["مَن وَجهُهُ وَحَديث بت أَخلسهُ","لي مِنهُما ما أَشتهاهُ السَمع وَالبَصَر",60,"ر",1,0],["منوا علي بوصل","فقد مرضت فعودوا",61,"د",3,0],["مُنُوا بِأَروع تَتلُوهُ خَضارِمَةٌ","أَماجِدٌ مارَسُوا الهَيجا وَما اِحتَلَمُوا",62,"م",3,0],["مَنُوعانِ ظَلاّمانِ لا يُنصِفانِنِى","بِدَلَّيهما والطَّرفُ قَد خَلَبانِى",63,"ن",2,0],["مَنُوعانِ ظلاّمانِ لا يُنصِفَانِنى","بِدَلَّيهما وَالحُسنِ قَد خَلَبانِى",64,"ن",2,0],["من والدٍ أو ولد أو أخٍ","أو من غريبٍ عنكِ أو صاحِب",65,"ب",1,0],["مَنْ وجهُه بدرٌ ومن لفظُه","دُرٌّ ومن راحُته بحر",66,"ر",1,0],["منوطة أجوافُه","بشَعْرِ شِيب يَقَق",67,"ق",1,0],["من وجد البين منه ضعف عزا","لم يبق في جسمه الذي وجدا",68,"د",2,0],["من وجد البين فيه ضعف عزا","لم يبق من جسمه الذي وجدا",69,"د",2,0],["من واهبٍ لم أدرِ من قَبلِه","أَنَّ المعالي جَمَّةً تُوهَبُ",70,"ب",1,0],["من وجهه الضحاك بشر قد روى","ويمينه تروي حديث عطاء",71,"ا",2,0],["من واو أو ياء أبدلن التا ومن","سين وصاد ثم باء يا فطن",72,"ن",1,0],["من واو أو يا أبدلن الألف","وهاء أو همز كآل المصطفى",72,"ف",2,0],["من واجِب الأَيّامِ تحطيمُهُ","عَلى حِفافِ المَهدِ في المَولِدِ",73,"د",1,0],["من وجوهٍ زاهراتٍ","لم تكدَّرْ بعُبُوسِ",74,"س",1,0],["من ورد أورادٍ لنا قد أوردت","صدر التداني بالمنى قد أسعدت",75,"ت",1,0],["من وَقعَةِ اليرموكِ أو حِطِّين قد","أخذا ضياءً كابتِسامَةِ فيك",76,"ك",1,0],["مِنْ وُلاةٍ شرّفَ اللّه بِهِم","دَهرَهُم مذْ أُوجِدوا والبَشَرا",77,"ر",2,0],["مِن وَجهِهِ تُجنى ثِمارُ الحُسنِ يا","نِعَةً بِما نَهواهُ مِن بُستانِهِ",78,"ن",2,0],["مَنَّ وَما مَنَّ بِمَعروفِهِ","وَلَيسَ مِنهُ المَنُّ مَنونا",79,"ن",2,0],["مِن وَجهِهِ تَخجَلُ شَمسُ الضُحى","في سَعدِها وَالبَدرُ في تِمِّهِ",80,"م",2,0],["من وَراءِ السحْبِ، فوق البح","ر، في يومٍ ومطيرِ",81,"ر",1,1],["منور القلب يخشى اللَه يعبده","ويتقيه بأسرار وإعلان",82,"ن",1,0],["مُنَوَّعُ الحُسنِ ساجِي الطَرفِ مُقلَتُهُ","تُزري بِهارُوتَ أَو تَسبِي بَني ثُعَلِ",83,"ل",1,0],["مِن وُدِّ كُلِّ أَن يَقي","هِ بِما يَعَزُّ وَيَفتَدي",84,"د",2,0],["مِن وَشحِ الرَأيِ تَدبيراً يُصيبُ بِهِ","فَقُل أَن تُخطِئَ المَرمى إِصابَتُهُ",85,"ت",2,0],["مِن واجِدٍ كَرباً عَلى حَبِّهِ","عَن قَلبِهِ لا فُرِّجَ الكَربُ",86,"ب",1,0],["مِن وَجهِهِ وَبَدَت مَيامِن طَيرِهِ","وَمُذ اِحتَسى الأَعدا مدامة ديرِهِ",87,"ه",1,0],["مَن وُلّي الأَحكام بَينَ الوَرى","شَيئانِ مَفروضان في ذمَّتِه",88,"ه",1,1],["مَن وَجْهُه شمسٌ ومَن جاهُه","ظِلٌّ ولكنْ ليس بالزّائل",89,"ل",1,0],["مِن وجههِ لهمُ ومِن يده","شَمسٌ تُضيء وعَارِضٌ يَدِق",90,"ق",1,0],["من وطَنٍ إلى وَطَر","إلى بَعيرٍ قد ضَمُر",91,"ر",1,0],["مِن وَجهِهِ لي قِبلَةٌ","وَمَديحُ دَولَتِهِ قُراني",92,"ن",2,0],["مَن وَصيُّ المُصطَفى عِندَكُمُ","وَوَصِيُّ المُصطَفى مَن يُصطَفى",93,"ف",2,0],["من وشاة شددوا ما بيننا","غير أن البرق عنه ما استقر",94,"ر",1,0],["مِنْ وَجِههِ يطلُعُ نَجمُ المُشتَري","ياقوتُهُ يُثمِرُ شَهْداً فاشْتَرِ",95,"ر",1,1],["مِن وَلَدِ المَهدِيِّ مُهدِيّانِ","قُدّاً عِنانَينِ عَلى عِنانِ",96,"ن",1,0],["من وزير أصْبَحت آراؤه","يسعد السلطان فيها والوزير",97,"ر",1,0],["منّوا ولا تطلُبوا منوني","فإنَّ هجرانَكُم منون",98,"ن",1,0],["منوعة الألوان ما بين أبيض","يلوح كأيام تسامت بعدله",99,"ل",2,0],["من وَرَقٍ راشِحٍ يلوحُ به","أَحْلَكْ حِبْرٍ يكونُ كَالقُطُنِ",100,"ن",1,0],["من وحد الشمل بالجهد العظيم ومن","أعطى الجزيل ولم يمنن بما يهب",101,"ب",1,0],["من وضع أمجد عن بر بملّته","وكذاك يصطحب الأكفاء أكفاء",102,"ا",2,0],["من وارثي العلياء ما اغتصبوا","مجداً ولا ملكوه بالقهرِ",103,"ر",1,0],["منوِّهةٌ إذا انتشرتْ بذكرِي","ولائقةٌ بمجدكِ واعتقادي",104,"د",2,0],["مُنَوِّرِ جُنْح اللَّيْلِ مِنْ قَسَماتِهِ","وكاسفِ شمسِ الصُّبْح في كُلِّ مازقِ",105,"ق",1,0],["من ودِّ قلبك لو نزحتَ قليبهُ","إنَّ الق