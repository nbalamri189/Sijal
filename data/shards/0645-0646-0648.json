{"poems":[[77,"ياساكني مرفأ الشواني","https://www.aldiwan.net/poem36023.html","مخلع البسيط"],[77,"مكناسة جمعت بها زمر العدى","https://www.aldiwan.net/poem36550.html","الكامل"],[86,"من واجد منقر المنام","https://www.aldiwan.net/poem68846.html","الرجز"],[93,"أليوم عيد البائس المتألم","https://www.aldiwan.net/poem11290.html","الكامل"],[88,"أما وقد طلع الرجاء","https://www.aldiwan.net/poem44794.html","مجزوء الكامل"],[37,"من وحش نيان أو من وحش ذي بقر","https://www.aldiwan.net/poem6895.html","البسيط"],[72,"الحمد لله على إنعامه","https://www.aldiwan.net/poem19685.html","المنسرح"],[51,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[51,"بلغ البغاة علي حيث أرادوا","https://www.aldiwan.net/poem61842.html","الكامل"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"وكم من بخيل قد تأدب حيلة","https://www.aldiwan.net/poem66063.html","الطويل"],[51,"قلبي من الطرفِ السقيم سقيم","https://www.aldiwan.net/poem66338.html","الكامل"],[26,"تالله يبقى على الأيام مبتقل","https://www.aldiwan.net/poem24086.html","البسيط"],[29,"صرمت أمامة حبلها ورعوم","https://www.aldiwan.net/poem6063.html","الكامل"],[91,"لو كان لي غير قلبي عند مرآك","https://www.aldiwan.net/poem9048.html","عموديه"],[70,"يا من لعبت به شمول","https://www.aldiwan.net/poem42746.html","مجزوء الدوبيت"],[70,"وحياتكم مازلت مذ فارقتكم","https://www.aldiwan.net/poem42822.html","الكامل"],[92,"اسكني يا جراح","https://www.aldiwan.net/poem38902.html","مجزوء المتدارك"],[85,"استخلف المنصور في وصاته","https://www.aldiwan.net/poem7909.html","الرجز"],[85,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[85,"إلى عرفات الله يا خير زائر","https://www.aldiwan.net/poem63776.html","الطويل"],[43,"أنوك من عبد ومن عرسه","https://www.aldiwan.net/poem9615.html","السريع"],[62,"نصيحكما فيما يقول مريب","https://www.aldiwan.net/poem52505.html","الطويل"],[45,"رقة النور واهتزاز القضيب","https://www.aldiwan.net/poem10892.html","الخفيف"],[45,"هجرت وطيف خيالها لم يهجر","https://www.aldiwan.net/poem63560.html","الكامل"],[45,"هم ألى رائحون أم غادونا","https://www.aldiwan.net/poem66662.html","الخفيف"],[45,"ألا شعرت برحلة الأظعان","https://www.aldiwan.net/poem66685.html","الكامل"],[45,"بين الشقيقة فاللوى فالأجرع","https://www.aldiwan.net/poem64692.html","الكامل"],[61,"عش مدى الدهر يا أبا إسحاق","https://www.aldiwan.net/poem51505.html","الخفيف"],[61,"ألبرق سرى بأعلى البراق","https://www.aldiwan.net/poem51520.html","الخفيف"],[80,"هن الحسان وحربها الهجر","https://www.aldiwan.net/poem31452.html","أحذ الكامل"],[44,"بمحمد صار الزمان محمدا","https://www.aldiwan.net/poem30387.html","الكامل"],[69,"من ولي الحسبة يصبر على","https://www.aldiwan.net/poem28051.html","السريع"],[69,"من ولي الحسبة يصبر","https://www.aldiwan.net/poem28621.html","السريع"],[69,"يا من هم للعين قره","https://www.aldiwan.net/poem28623.html","مجزوء الكامل"],[105,"من هيبة يغضي القريض ويطرق","https://www.aldiwan.net/poem42076.html","الكامل"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[102,"أدموع النساء والأطفال","https://www.aldiwan.net/poem33120.html","الخفيف"],[39,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[75,"متهلل والبدر فوق جبينه","https://www.aldiwan.net/poem69030.html","الكامل"],[48,"اسقني الراح على وجه","https://www.aldiwan.net/poem64407.html","مجزوء الرمل"],[48,"إني لفي شغل عن العاذلين","https://www.aldiwan.net/poem66119.html","السريع"],[7,"يا دار مية بالعلياء فالسند","https://www.aldiwan.net/poem2003.html","البسيط"],[46,"بنت عن الدنيا ولا بنت لي","https://www.aldiwan.net/poem22160.html","السريع"],[46,"منون رجال خبرونا عن البلى","https://www.aldiwan.net/poem23507.html","الطويل"],[19,"حلًت تماضر بعدنا رببا","https://www.aldiwan.net/poem322.html",""],[76,"صحيفة طابعها اللوم","https://www.aldiwan.net/poem38998.html","الرجز"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21002","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42815","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54963","السريع"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2231","الكامل"],[106,"وقفة على طلل","https://www.poetsgate.com/ViewPoem.aspx?id=151389",""],[100,"ابن السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=50328",""],[45,"رِقّةُ النَّوْرِ، وَاهتِزَازُ القَضِيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31567",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""]],"verses":[["مُنُّوا عَلَى الْجَوْفِ بِالأَمَانِي","فَأَنْتُمُ جُمْلَةُ الأَمَانِي",0,"ن",2,0],["مِنْ واصِلٍ للجوعِ لا لرِياضَةٍ","أو لابِسٍ للصّوفِ غيْرِ مُريدِ",1,"د",1,0],["مِن واجِدٍ مُنَقِّرِ المَنامِ","طَريدَ دَهرٍ جائِرِ الأَحكامِ",2,"م",1,1],["مَنْ وَسَّعَ المَوْلَى عَلَيْهِ بِرِزْقِهِ","أَيَضِنُّ بِالدِّينَارِ أَوْ بِالدِّرْهَمِ",3,"م",1,0],["من وجه مولانا النقيب","ووجه مولانا الأمير",4,"ر",1,0],["من وحش نَيَّان أو من وحش ذي بَقَر","أفنى خلائله الأشِلاءُ والطَّرَدُ",5,"د",1,1],["من والدٍ في العلى ومن ولدٍ","قد جاء عن علمه وأعلامه",6,"م",2,0],["من وعيدٍ نما إليَّ عن القا","ضي فما يستقرُّ قلبي وَجيبا",7,"ب",2,0],["من واهَقَ الريحَ وهي جاريةٌ","أَقصر أو كانَ قَصْرَهُ لَغَبُهْ",8,"ب",2,0],["منُّوا عليه وشَيَّدوا من ذكره","وبمثلها رفعوا البيوتَ وشادوا",9,"د",3,0],["من وجهُهُ الوجهُ الجمي","لُ وشخصهُ الشخصُ الجهيرُ",10,"ر",1,0],["منوعٌ وجيزُ المنع غيرُ مدافعٍ","يرى أن وشك المنع أمضى وأصرمُ",11,"م",1,0],["مِنْ وجهها أبداً نهارٌ واضحٌ","من فرعها ليلٌ عليه بهيم",12,"م",1,0],["مِن وَحشِ حَوضى يُراعي الصَيدَ مُبتَقِلاً","كَأَنَّهُ كَوكَبٌ في الجَوِّ مُنَجَرِدُ",13,"د",1,0],["مِن والِدٍ دَنِسٍ وَخالٍ ناقِصٍ","وَحَديثُ سوءٍ فيكُمُ وَقَديمُ",14,"م",1,0],["مَنّوا بِأَسرِهِمِ إِيّاكِ أَنفُسَهُم","فَأَصبَحوا بِتَمَنّيهِم أَساراكِ",15,"ك",1,0],["مِن وَصلِكَ بِالقَليلِ يَرضى","الطَلُّ مِنَ الحَبيبِ وابِل",16,"ل",1,0],["مُنّوا بِها كَرَماً عَلَيَّ فَإِنَّها","مِن أَعظَمِ الأَشياءِ عِندي مَوقِعا",17,"ع",2,0],["مِنْ وراءِ الظَّلامْ","وهديرِ المياهْ",18,"ه",1,0],["مُنوا بِقاسي القَلب لَيسَ يَرحَمُ","وَلَيسَ تَثنيهِ عَلَيهُم رَحِم",19,"م",1,0],["مِن وَراءِ الإِذنِ نالَت ضَيغَماً","لَم يَنَل أَقرانَهُ إِلّا وِجاها",20,"ا",3,0],["مُنَوِّرَةٌ كَالبَدرِ شَمّاءُ كَالسُها","وَتُخفَضُ في حَقٍّ وَعِندَ صَلاةِ",21,"ه",1,0],["مَن وَجَدَ المَذهَبَ عَن قَدرِهِ","لَم يَجِدِ المَذهَبَ عَن قَنسِهِ",22,"س",2,0],["منوعٌ لأطراف الممالك حافظٌ","جَمُوعٌ لأشتاتِ العَلاءِ كَسُوبُ",23,"ب",1,0],["مِن وَراءِ البابِ المُمَنَّعِ وَالسِت","رِ المُطاطا وَالحَجِبِ المَحجوبِ",24,"ب",1,0],["مِن وامِقٍ مُتَشَوِّقٍ أَو آمِلٍ","مُتَشَوِّفٍ أَو راقِبٍ مُتَنَظِّرِ",25,"ر",1,0],["مِن وَراءِ السُجوفِ كُثبانُ رَملٍ","تَتَثَنّى أَفنانُهُنَّ فُنونا",26,"ن",2,0],["مِن واضِحٍ يَقَقٍ وَأَصفَرَ فاقِعٍ","وَمُضَرَّجٍ جَسِدٍ وَأَحمَرَ قانِ",27,"ن",1,0],["مِن واقِفٍ في الهَجرِ لَيسَ بِواقِفٍ","وَمُوَدِّعٍ بِالبَينِ غَيرِ مُوَدِّعِ",28,"ع",1,0],["مِنْ وُجوهٍ مثلِ البدورِ صِباحٍ","وقُدودٍ مثلِ الغُصونِ رِشاقِ",29,"ق",1,0],["مِنْ وَلِيٍّ يَسيرُ في طُرُقِ الوُدْ","دِ ولا يَهْتدَي لِطُرْقِ النِّفاقِ",30,"ق",1,0],["من وجهكِ الحُسنُ اقتنى مُلَحاً","فكأنّها في وَجْهِهِ بِشرُ",31,"ر",1,0],["مَن وَدَّني بِلِسانِهِ وَبِقَلبِهِ","وَأَنالَني بِيَمينِهِ وَشِمالِهِ",32,"ل",2,0],["مَنْ وليَ الحسبةَ يصبرْ على","تعرُّضِ الواقفِ والسائرِ",33,"ر",1,1],["مَنْ وليَ الحسْبةَ يصبرْ على","تعرّضِ الواقفِ والعابرِ",34,"ر",1,1],["مُنُّوا علينا واحضروا","فحضورُكم أصلُ المسرَّهْ",35,"ه",1,0],["مِنْ وَصْفِه الأُسْدُ الضَّوارِي تَدَّعي","والخيلُ تَصْهَلُ والقواضِبُ تَبْرُقُ",36,"ق",1,0],["مَنّوا عَلَيهِم بِالحَياةِ ذَليلَةً","مَحيا الذَليلِ وَمَوتُهُ سِيّانِ",37,"ن",1,0],["من وحيد لأُمِّه وأبيه","جمعوه مفرَّقَ الأَوصال",38,"ل",1,0],["مِن وَحشِ خُبَّةَ أَودَعَتهُ نِيَّةٌ","لِلناطِلِيَّةِ مِن لِوى البَقّارِ",39,"ر",1,0],["من وَبْلِهِ وسَكْوبهِ ومُلِثّهِ","وسَفُوحِهِ ودَلوحِهِ وهَتونه",40,"ن",2,0],["مِن وَصيفٍ بِأَبي ذا","كَ وَبِالأُمِّ وَصيفا",41,"ف",2,0],["مِن وَلَدِ المَهدِيِّ في ذِروَةٍ","مُهَذَّبٍ يَخلِطُ حَزناً بِلين",42,"ن",1,0],["مِن وَحشِ وَجرَةَ مَوشِيٍّ أَكارِعُهُ","طاوي المُصَيرِ كَسَيفِ الصَيقَلِ الفَرَدِ",43,"د",1,0],["مِن وَسَخٍ صاغَ الفَتى رَبُّهُ","فَلا يَقولَنَّ تَوَسَّختُ",44,"ت",1,0],["مَنونَ رِجالٌ خَبِّرونا عَنِ البِلى","وَعادوا إِلَينا بَعدَ رَيبِ مَنونِ",45,"ن",1,1],["مِن وَحشِ أَنبَطَ باتَ مُنكَرِس","حَرِجاً يُعالِجُ مُظلِماً صَخِبا",46,"ب",2,0],["من وجهِهِ نَحْسٌ ومَن قُربِهِ","رِجْسٌ ومن عِرفانِهِ شُومُ",47,"م",1,0],["من وَتدٍ يكون حين لا سبب","فذلكَ المَقطوعُ حينَ يَنْتسبْ",48,"ب",1,0],["مِن وَليٍّ أو أَخي ثِقَةٍ","أو عَدُوٍّ شاحِطٍ دارا",49,"ر",2,0],["مُنُّوا عَلَيَّ بِوَصْلٍ أَسْتَعِيدُ بِهِ","مِنْ مُهْجَتِي رَمَقَاً يَحْيَا بِهِ الْبَدَنُ",50,"ن",1,0],["مِنْ وَالِدٍ بَرٍّ وَمِنْ بِضْعَةِ","طُهْرٍ أَنَارَا ظُلْمَةَ القَبْرِ",51,"ر",1,0],["مِن وَحشِ أَنبَطَ باتَ مُنكَرِساً","حَرِجاً يُعالِجُ مُظلِماً صَخِبا",52,"ب",2,0],["من وحَّد العرب حتى صار واترهم","إذا رأى ولدَ الموتور آخاه",53,"ا",2,0],["من وراء التلّ عنَتَّت غابةٌ","من أفاعٍ، وكهوف من عُواء",54,"ا",2,0],["مِنْ وَرَاءِ البَابِ المُمَنَّعِ وَالسّتْ","رِ المُطاطا، وَالحاجبِ المَحجوبِ",55,"ب",1,0],["من والد أغرى بها الحواسدا","لو خلتُ حالي تبتغي المُساندا",56,"د",2,0]]}