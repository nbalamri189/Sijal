e.com/ViewPoem.aspx?id=161846",""],[3749,"كليني لكر الخيل يا أم مالك","https://www.poetsgate.com/ViewPoem.aspx?id=134957",""],[5121,"بعَيْني","https://www.poetsgate.com/ViewPoem.aspx?id=215142",""],[2365,"قفا صاحبيّ نحىّ الطلل","https://www.poetsgate.com/ViewPoem.aspx?id=200654",""],[5387,"مجنون ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=53112",""],[5436,"لهيب الثأر ماخمدا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177642",""],[5436,"عراق ما بين الأزل والأبد/إسماعيل الصياح","https://www.poetsgate.com/ViewPoem.aspx?id=128302",""],[5509,"محاولات لاصطياد شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=93490",""],[5582,"بريقٌ لاحَ مُؤْتَلِقَا","https://www.poetsgate.com/ViewPoem.aspx?id=63542",""],[5704,"تشطير لنونية المتنبي \" ما كل ما يتمنى المرء يدركه\"","https://www.poetsgate.com/ViewPoem.aspx?id=204264",""],[5725,"ومانعة وصلي","https://www.poetsgate.com/ViewPoem.aspx?id=201752",""],[5804,"لا خيرَ في الخير","https://www.poetsgate.com/ViewPoem.aspx?id=186971",""],[5997,"قيم الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=214222",""],[6092,"إذا المرء لم يغضب له حين يغضب","https://www.poetsgate.com/ViewPoem.aspx?id=99576",""],[6131,"ارْتِدَادُ النُّورْ","https://www.poetsgate.com/ViewPoem.aspx?id=189266",""],[3477,"سلا الدمع على قلبي المعذب هل سلا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612740",""],[5075,"الإسلام هو الحل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82759&r=&rc=5",""],[6324,"نجوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87950&r=&rc=15",""]],"verses":[["فَلا تَخشَ القَطيعَةَ إِنَّ قَلبي","عَليكَ اليَومَ مَأمونٌ أَمينُ",0,"ن",1,0],["فَلا تَخشَ المَنيَّةَ وَاِلقَيَنه","وَدافِع ما اِستَطَعتَ لَها دِفاعا",1,"ع",2,0],["فَلا تُخْزِ في ردٍّ كِرامَ وُجوهِهِمْ","ومهِّدْ لهُمْ منْ بَرِّكَ الرّحْبَ والسّهْلا",2,"ل",2,0],["فَلا تَخافي عَلَينا الفقرَ وَاِنتَظِري","فَضلَ الَّذي بِالغِنى مِن عِندِه نَثِقُ",3,"ق",1,0],["فَلا تُخلِق فُديتَ أَديمَ وَجهي","وَلا تَقطَع مُواصَلَةَ الحَميمِ",4,"م",1,0],["فَلا تَخفَرَن وَاِلتَمِس مَلجَأً","فَقَد عادَ لِلأَوسِ أَديانُها",5,"ن",3,0],["فلا تخشَ ممَّا يوجب الصبرَ مرَّةً","كأنَّك بالنعمى وقد وجب الشكر",6,"ر",1,0],["فلا تَخْلُفْهُمُ في أمر مثلي","خِلافةَ من أُطيبَ وما يَطيبُ",7,"ب",1,0],["فلا تخف للزمان غَوْلاً","يا أيها السيِّدُ السديدُ",8,"د",1,0],["فلا تخشَ من أسهمي قاصداً","ولا تأمَنَّن من العائر",9,"ر",1,0],["فلا تخف تعس الجدود التاعسه","قد كَذّب اللَه النفوس اليائسه",10,"س",2,0],["فلا تخافوا أمنتم أبداً","ما أينع الطلع في بواسقها",11,"ق",3,0],["فلا تَخلْ أنني أخفُّ ولا","أهلعُ صَدَّ الخليل أو رَئما",12,"م",2,0],["فلا تخادِعْني فلستَ الذي","يخدعُ إخوانَ الشياطين",13,"ن",1,0],["فَلا تُخلِفَنَّ الظَنَّ إِنَّكَ وَالنَدى","حَليفا صَفاءٍ في مَحَلِّ مُقامِ",14,"م",1,0],["فَلا تَخطُب بِما تَجري إِلَيهِ","هِجائي فَهوَ أَغلى مِن مَديحي",15,"ح",2,0],["فَلا تَخَلني إِن طِرتُ بِالسُكرِ تائِهاً","أَرومُ بِأَهدابِ النُجومِ تَشَبُّثا",16,"ث",2,0],["فَلا تَخضِبْ مَشيبَكَ لِلغَواني","فَتَغنى عَنهُ ناعِمَةً وتَشقى",17,"ق",2,0],["فَلا تُخزِ أَيّامَهُ الصالِحاتِ","وَما قَد بَنى مِن جَليلِ البِناءِ",18,"ا",2,0],["فلا تُخْلِني مِنْ دعوةٍ أُخْرويَّةٍ","عسى توبةٌ يُرضي الإلهَ نصوحُها",19,"ح",3,0],["فلا تخلفيني ما وعدتِ فإنني","أرى أن خُلْفَ الوعدِ من خلقِ الوغدِ",20,"د",1,0],["فَلا تَخشَهُم وَاِخشُن عَلَيهِم فَإِنَّهُم","إِذا أَمِنوا مِنكَ الصَيالَ أُسودُ",21,"د",1,0],["فلا تَخذُلِ البَدْرَ المُنيرَ الّذي بهِ","سَرَوا فله حَقٌّ على الجودِ لازم",22,"م",1,0],["فلا تخافن يوماً","قيامة وجحيما",23,"م",2,0],["فَلا تَخشَ المَنيَّةَ وَاِلقَيَنها","وَدافِع ما اِستَطَعتَ لَها دِفاعا",24,"ع",2,0],["فَلا تَخشَ سَيفَ الدَولَةِ القَرمَ أَنَّني","سِواكَ إِلى خَلقٍ مِنَ الناسِ راغِبُ",25,"ب",1,0],["فلا تخش ارهاقا وساور ليوثها","بعزم يفض الخطب وهو حسير",26,"ر",1,0],["فلا تخبطن في فهم أحكام عدله","اذا اختلفت أشكالها والمواقع",27,"ع",1,0],["فلا تخشَى من أسهمي قاصداً","ولا تأمَنَّن من العائر",28,"ر",1,0],["فلا تخشَ المنية َ وإقتحمها","ودافع ما استطعتَ لها دفاعاً",29,"ع",2,0],["فلا تخجلنه يا وسيع الحمى ولا","تعاند يا غوث الأنام بفعله",30,"ل",2,0],["فلا تُخبر عن الأمم المواضي","فإنَّكَ قد سقطتَ على الخبيرِ",31,"ر",1,0],["فَلا تَخَشَى صُدُودِي عَنكِ إني","عَلَى بُعدِيَّ عَنكِ إِلَيكِ رَانِ",32,"ن",1,0],["فلا تخشى هُلكاً ما حييت وإن أمتْ","فما أنت إلا خائفٌ تترقبُ",33,"ب",1,0],["فلا تخشى عليه ولا تراعي","فمسدي الخير يجزَي بالنظيرِ",34,"ر",1,0],["فلا تخيب وهب نوالا","يليق بالفضل والجناب",35,"ب",1,0],["فلا تخدعن ما كل دار هي الحما","ولا كل بيضاء الترائب عزة",36,"ه",1,0],["فلا تخشى مني عن ودادك نَبْوةً","فحبك أوْفَى ما حَوَتْه الأضالع",37,"ع",1,0],["فَلا تَخذلي يا أَخت كلَّ فَضيلَةٍ","فَلَيسَ حُسامُ المُستَبدِّ بِقاضِبِ",38,"ب",1,0],["فلا تخافِي عَلَيَّ عاذِلتي","شرُّ الهوى ما يُزيله العَذَلُ",39,"ل",1,0],["فلا تخلني من حسن عطفك واسأل ال","مهيمن رب العرش في سد خلتي",40,"ت",2,0],["فلا تخافي على وَصلٍ معاقبةً","إذ ليسَ يحرمُنا ما مِنهُ أعطانا",41,"ن",2,0],["فلا تَخدَعكَ رقّةُ فاتِناتٍ","لرقّ الحرّ رقَّقنَ الخصُورا",42,"ر",2,0],["فَلا تخلنا يا سيد المرسلين من","عَواطف بر أَو جَميل عَوائد",43,"د",1,0],["فَلا تَخلِ فيهِما رُشداً وَلا حُكماً","وَلا تُطِع مِنهُما خَصماً وَلا حِكَما",44,"م",2,0],["فَلا تَخفضن نَفساً لِمَن أَنتَ فَوقَهُ","وَلا تَرفَعن صَوتاً عَلى من تؤدِّبُ",45,"ب",1,0],["فَلا تَخشَ عَبد اللَهِ سوأ وَلا رَدى","فَكل جَميل لِلكَريمِ مَآب",46,"ب",1,0],["فَلا تَخشَ مِن حُمّى وَلا رُحَضائِها","تُحَبِّبُ إِن زارَت مَضاجِعَهُ غِبّا",47,"ب",2,0],["فَلا تَختَدِع نَفسي بِكَسبِ رَغيبَةٍ","فَلا ساعَفَتها إِن لَوتَها الرَغائِبُ",48,"ب",1,0],["فلا تخشَ يا سِرباً صغيراً لأنه","مقامك في ملك السماء جليل",49,"ل",1,0],["فلا تخش في تقسيمه الحظَّ مارداً","ولو كان بين الناس بالشر نازغا",50,"غ",2,0],["فلا تخشَ يا ديراً سعيداً بأهله","فإلْيَشَعُ الصنديد يرضاك ناووسا",51,"س",2,0],["فلا تخش من عتْبِ إليك موجَّةٌ","وحاشا يوافي سُوحَك اليوم تُبَّع",52,"ع",1,0],["فلا تَخْتَرْ على قصدٍ كَفافاً","فَبَردُ العَيْشِ إنْ أنصَفْتَ فيهِ",53,"ي",2,0],["فلا تَخطُبَنْها إنَّها ضَرَّةُ النُّهى","وبُغيَتُها روحُ البُعولَةِ في المَهرِ",54,"ر",1,0],["فلا تُخِفْ فيك الليالي جانبي","بقاصدِ السهمِ ولا بغائرِ",55,"ر",1,0],["فلا تَخْرقِ الإجماعَ في هَجْرِ مُخلصٍ","سليمِ دَواعي الصَّدْرِ للْخُلَطاءِ",56,"ا",2,0],["فلا تخلهُ ظلماً خصصت بهِ","فالدهر يقضي كذا عليك ولك",57,"ك",1,0],["فَلا تُخالِطهُ فَإِنَّ الفَتى","يَفزَعُ أَن يَخرا لَئِلّا يَجوع",58,"ع",1,0],["فَلا تُخاطِبهُ عَلى لَفظِهِ","فَإِنَّهُ أَجهَلُ مِن نَمرِ",59,"ر",1,0],["فلا تخش إلا الله إن كنت مؤمناً","وإن هاج من بالوهم علته الكلب",60,"ب",1,0],["فَلا تَخش من جحدٍ لنُعماك في الورى","فنُعماك أطواقٌ ونحن حَمامُ",61,"م",1,0],["فلا تَخشَ مِنِّي جفوةً في نصيحةٍ","وَكيفَ وما لِي خشيةٌ من جفائكا",62,"ك",2,0],["فلا تُخبِر بسرِّك كلّ سِرٍّ","إذا ما جاوزَ الإثنين واشِ",63,"ش",1,1],["فلا تخطئُ المرمى سهامُ ظُنونه","ويقرأُ ما في صفحة الغيب بالفكر",64,"ر",1,0],["فلا تَخَلْ أنني أنسى عهودكَ لا","وحقِّ مَنْ بِسهامِ البَيْنِ أصْمانِي",65,"ن",2,0],["فلا تُخيِّب رجاً سُدَّت مذاهِبُه","عمَّن سِواكَ فهذا عينُ مذهبهِ",66,"ب",2,0],["فلا تُخلِني منها فإنَّ وُرودَها","لعَيني وقلبي قُرَّةٌ وقَرارُ",67,"ر",1,1],["فلا تخدعنكم بأشراكها","فيصبح طائركم مقتهر",68,"ر",1,0],["فلا تخدعنك ولا تطربنك","ولا تلهينك صفوف الصفد",69,"د",1,0],["فلا تخزني يا رب واقبل توسلي","بجاه الحبيب المصطفى الأشرف الهمم",70,"م",1,0],["فلا تخيب مديجي وأغثني بغنى","فتى أعانته دنياه وأخراه",71,"ا",2,0],["فلا تخيّب وأول ما ارتجي","من أنعم الدارين يا ابن الكرام",72,"م",1,0],["فلا تخز من أضحى محبا ومادحا","له حسن ظن فيك قد شرح العذرا",73,"ر",2,0],["فلا تخزني يا رب وقبل شفاعتي","فأنت بما أجوه يا بر تعلم",74,"م",1,0],["فلا تخزني يا رب واقبل توسلي","بجاه حبيب جاهه الجاه الأعظم",74,"م",1,0],["فلا تخش كيداً من عدو فإنه","وحقك من سهم القضاء مصاب",75,"ب",1,0],["فَلا تُخْدَعوا عَنْ مذهبِ العشْقِ واسْأَلُوا","فُؤَادي بِهِ فَهْوَ الخبيرُ المُجَرِّبُ",76,"ب",1,0],["فلا تخشَ من داءِ الخُمارِ وعاطِها","هنيئاً مريئاً غيرَ داءٍ مخامرِ",77,"ر",1,0],["فلا تخل عجيبةً أن ترى","الأضواءَ فيه تشبه الأنجما",78,"م",2,0],["فَلا تَخطِبَنَّ بَعدَها حُرَّةً","فَتَثنى بِوَسمٍ عَلى الشارِب",79,"ب",1,0],["فلا تُخلِها من لحْظَةٍ كلَّ ساعةٍ","مُقدّسةٍ تُهْدي بها وتُدامُ",80,"م",1,0],["فَلا تُخرِجوهُ عَن سَجِيَّةِ حِلمِهِ","فَتَكثُرَ في الساعي بِذاكَ ثَواكِلُه",81,"ل",2,0],["فَلا تُخرِجوهُ عَن سَجِيَّةِ حِلمِهِ","فَما هُوَ إِلّا اللَيثُ إِن هَمَّ يَصدُقُ",82,"ق",1,0],["فلا تخيبني فإني مرتج","جداك يا رب النوال والندى",83,"د",2,0],["فلا تخيب أملي يا أملي","فقد أتيت وافدا مسترفدا",83,"د",2,0],["فلا تخالوا ضَلَّة إنهما","فُتات مسك فوق ورد أحمر",84,"ر",1,0],["فلا تخطينْ أرضَ المحافر سهلها","وأوعارها قبل البلاد نصيبُها",85,"ب",3,0],["فَلا تَخَافَ إنَّ فيه الطُّرُق","كَثيرةٌ وَلَيسَ فيهِ رُقّ",86,"ق",1,0],["فلا تخف بعدما عاينت من عجب","ولا تكونن ممن قلبه رجفا",87,"ف",2,0],["فلا تخلني من حاجة إِن حاجتي","لا لفي شجاع منك شهم مقاوم",88,"م",1,0],["فلا تخفْ من حانتي إنها","تهديك للجامع يا تابعي",89,"ع",2,0],["فلا تخش ضغطاً سوف يُخرج لؤلؤاً","فقلت أخافُ الضغط يخرج لي روحي",90,"ي",1,0],["فلا تُخيّب رجاء القاصدين إلى","أبواب فضلك يا من بالوفاء رُجي",91,"ج",2,0],["فلا تخادع مستبداً نفسه","فما يسود اليوم الا حرّها",92,"ر",3,0],["فلا تخلدن إلى راحة","إذا لم تكن من ثمار العنا",93,"ن",2,0],["فلا تخشى الوصل البرئ فإنك","وقعت بلا ريب على الرجل البرز",94,"ز",1,0],["فلا تخدعك أيام تليها","ليالٍ واخشها بيضاً وجونا",95,"ن",2,0],["فَلا تَخشَ القَطيعَةَ إِنّ قَلبِي","عَلَيكَ اليَومَ مُؤتَمَنٌ أَمِينُ",96,"ن",1,0],["فلا تخشين في اللّه لومة لائم","ولا تتوقع سورةً من مخوّف",97,"ف",1,0],["فلا تَخشَيا مِنَّي الملالَ فإنَّ لي","فؤاداً إذا ما قيلَ مَلَّ تَمَلملا",98,"ل",2,0],["فلا تخدعينا بالسراب فإننا","قتَلنا نُهانَا في طِلابِ الحقائقِ",99,"ق",1,0],["فلا تُخيّبْ راجياً لمْ يزَلْ","في كُلّ حال وارِداً مَنْهَلَهْ",100,"ل",2,0],["فَلا تَخف قَطُّ رِزقاً عَنكَ يَنحَسِمُ","قَد قَسم اللَهُ بَينَ الناسِ رِزقَهُم",101,"م",1,0],["فَلا تَخيّبه لِأَمر مَضى","إِن كانَ يا مَولاي خاب العَملْ",102,"ل",1,0],["فلا تخشَ التناقض في كلام","عن الدنيا ورأي في الوجود",103,"د",1,0],["فلا تخَفْ آفةً ولا غِيَرًا","يُمنَى بها في الضمائرِ البشَرُ",104,"ر",1,0],["فلا تخض في حروب بينهم وقعت","عن اجتهاد وكن إن خضت معتذرا",105,"ر",2,0],["فلا تخشين من واشٍ","فعين الحب ترعانا",106,"ن",2,0],["فلا تُخفِ حقداً بالتودُّد إنه","إذا خيَّبَ الله العدوَّ تودَّدا",107,"د",2,0],["فلا تخيب رجائي منك في أمل","غ