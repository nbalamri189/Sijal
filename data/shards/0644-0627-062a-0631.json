ين ماء بها نجلا","ء في وجه روضة مئناف",253,"ف",1,0],["لا ترفعنْ علمَ العلوم بمجهلٍ","فعلوُّ حظك أن تخال جهولا",254,"ل",2,0],["لا تَرِدِ الغَيَّ لِرَيٍّ فَما","مَورِدُهُ صافٍ وَلا حُلوُ",255,"و",1,0],["لا تَرتَجِع عَن سُرورٍ إِن هَمَمتَ بِهِ","فَالدَهرُ لَيسَ يُبالي ما الَّذي صَنَعا",256,"ع",2,0],["لا تَرِدِ البُخلَ ما حَييتَ فَما","فاضَ بِخَيرٍ مُذ كانَ مَورِدُهُ",257,"د",2,1],["لا ترجُ مِنْ بعدِ انقيادكَ للهوى","بُرءاً وقد لبَّيتَ منه الداعيا",258,"ي",2,0],["لاترضَ وجدَكَ في أهلِ الهوى وَسَطا","فأعْذَبُ الحبِّ ما غالبتَهُ وسَطا",259,"ط",2,1],["لا ترهبُ المرمى البعيدَ وغَوْرُه","متباعدُ الأقصى يَهُولُ ونَجْدُه",260,"د",2,0],["لا تركنن لفيلو","ف في الحياة إذا بحث",261,"ث",1,0],["لا ترجعن أحاديثاً وتنتهكوا","منا محارمنا قد تُتَّقى الحرم",262,"م",1,0],["لا ترحم الأعمى وزده ضَعْفةً","إن المريض أحق بالأمراض",263,"ض",1,0],["لا تَرى العَيْبَ إنَّ عَفْوكَ جَمٌّ","فاقْضِ عَفْواً لا تُشْمِتِ العُذَّالا",264,"ل",2,0],["لا ترى النَّاسَ يا بنيَّ صِغاراً","كلُّهم طيَّ طِينهِمْ كُبَراءُ",265,"ا",2,0],["لا ترتضي همته بغاية","إلا إذا امتد بها مضماره",266,"ر",2,0],["لا تَرَى الحَقَّ غَيْرَ إسْنادِكَ العا","لِي وَعَنْ كُلِّ ما سِواهُ تَميلُ",267,"ل",1,0],["لا تَرْهَبِ الباطِلَ إن كُنْتَ في","حَقٍّ وإنْ قَلَّ لَكَ النّاصِرُ",268,"ر",1,1],["لا تركنن لذي الأطماع تحسبه","خلا ففي كمه أفعى يواريها",269,"ي",3,0],["لا تَرنُ نحوي بِهِمَا","فَإِنَّني فَإِنَّني",270,"ي",1,0],["لا تَرى إذ ترَى منَ القومِ إلا","سيِّداً أو مُهَذباً مَشهورا",271,"ر",2,0],["لا تَرى غيرَ طَلقةٍ من جَبينٍ","وابتسامٍ تَفتَرُّ عنه ثُغورُ",272,"ر",1,0],["لا ترى إذ تَرى من القومِ إلا","كلَّ باشا أو قائداً مَشهورا",273,"ر",2,0],["لا تَراهُ إن بَدا شَرٌّ له","في طعامٍ أو شَرابٍ يَفتَكِر",274,"ر",1,0],["لا تَرمِيَنَّ بِحاجَتي وَقَضائِها","ضَرحَ الحِجابِ كَما رَمى بي مَن رَمى",275,"ا",1,0],["لا تَرفَعَن صَوتَكَ يا عبدَ الصَّمَد","إنَّ الصَّوابَ في الأَسَدِّ لا الأشَدّ",276,"د",1,1],["لا تَرى عاشِقاً تَعَلَّقَ لَيلى","وَيُلاقي المَماتَ مِنها رَواحا",277,"ح",2,0],["لا ترفعي زندًا بِمُفرَدهِ","كي لا يميلَ الكوكبُ الأشقى",278,"ق",2,0],["لا تَرضَ لي بِالهوَينا لَستُ صاحِبها","القلُّ لِلقلِّ وَالإعظامُ للعظمِ",279,"م",1,0],["لا تُرتجى منه إيابةُ قادمٍ","هيهات أعوزَ من ردىً قَدّامُ",280,"م",1,0],["لا تراه على منازعةِ الأي","يامِ يسخو لمُفْرِحٍ بنزاعِ",281,"ع",1,0],["لا تُرِدْ فيه وقد أدْ","نَسَنا ثوباً رَحيضا",282,"ض",2,0],["لا تُرعِها سمعاً فإن","ن لها القعاقعِ والأَزيزا",283,"ز",2,0],["لا ترهبَنْ منّي الملالَةَ في الهوى","وَاِرهَبْ مَلالَةَ من لقيتَ وحاذرِ",284,"ر",1,0],["لا تربةٌ إلّا وَفيها للبِلى","خدٌّ أسِيلٌ أو جبينٌ أزهرُ",285,"ر",1,0],["لا ترجُ أن تَنْجُوَ مشياً وقد","بغاك باغٍ واسعُ الوثْبِ",286,"ب",1,0],["لا تَرَيْهِ مجانباً للتصابِي","ليس بِدْعاً صبابةٌ ومشيبُ",287,"ب",1,0],["لا تُرتِعَن لَحمي لِسانَكَ بعدَها","إِنّي أَخافُ عَلَيكَ شَفرَةَ جازِرِ",288,"ر",1,0],["لا ترمها إن كنت تبخل بالنف","س عليها هيهات يحظى البخيل",289,"ل",1,0],["لا ترى من دونه في","خلقه شيئاً مخيفا",290,"ف",2,0],["لا تَرَى الْهَوَى نُزْولاَ","فِيه اللّبيبُ يَرْقَى",291,"ق",2,0],["لا تَرتضي غيرَهُ الدُّنيا لها مَلِكاً","لو كانَ جِبريلُ يأتيها أو الخَضِرُ",292,"ر",1,0],["لاَ تَرُومَنَّ بَعِيْداً","وَارْضَ بِالأَمْرِ المُوَامِ",293,"م",1,0],["لا ترغبي يا ابنة العشرينَ في صِلَتي","إِنَّ الثلاثِينَ هدَّتْ ثُلْثَ أَرْكَاني",294,"ي",1,0],["لا تَرْتَوِي بَعْد فَقْدِه غُلَلي","أَوْ أَرِدَ الْمَوردَ الَّذِي وَرَدا",295,"د",2,0],["لا تَرْقُدَنْ عَنْ ساهرٍ في لَيْلةٍ","مُذْ غَابَ وَجْهُكَ لم يَفُزْ بِصَباحِ",296,"ح",1,0]]}