لكامل"]],"verses":[["لا تَرِدُ الماءَ وَلا","تُطوى بِها المَنازِلُ",0,"ل",1,0],["لا تَرتَعي مُعشِباً مَنابِتُهُ","بيضُ الظُبى وَالعَواسِلُ الذُبُلُ",1,"ل",1,0],["لا تَرقُدَنَّ عَلى الأَذى","وَاِعزُم كَما عَزَمَ اِبنُ موسى",2,"س",2,1],["لا تَرْجُ إلا اللّهَ في شِدّةٍ","وثِقْ بهِ فهْوَ الذي أيّدَكْ",3,"ك",1,1],["لا تُرَى فِي مُلِمَّةٍ بَادِي المَقْ","تَلِ إِلاَّ فِي نُصْرَةِ المَظْلُومِ",4,"م",1,0],["لا ترى فيه ما يسرّك بالصن","عة حسناً ويبهج الأبصارا",5,"ر",2,0],["لا تَرهَبُنَّ وَراءِ ما حَيِيتُ لَكُم","جَهلَ الغُواةِ وَخَلّوهُم وَخَلّوني",6,"ن",2,0],["لأتركنَّ فريداً في التراب غداً","ولو تكثرَ ما بين الورى عدَدِي",7,"د",2,0],["لا ترضينَّ لمن أتاك بضدِّ ما","ترضى لنفسك إنَّ ذلك حُوبُ",8,"ب",1,0],["لا تَرَاها تَعِيثُ عَيْثَ الذئاب ال","طُلْسِ لكنْ تَصِيدُ صَيْدَ الفُهُودِ",9,"د",1,0],["لا تَرى القاسم المؤمَّل إلا","باكرَ الرِّفْد شاكرَ المرْفُودِ",9,"د",1,0],["لا تَرى مُنْشِدَ الشبابِ يَدَ الدَهْ","رِ وتلقى منْ شئتَ من نُشَّادِهْ",10,"د",2,0],["لا ترى خائفَ المَغالة منه","لا ولا آمناً من استطرادِهْ",10,"د",2,0],["لا ترى استطراف علْقٍ طارفٍ","شيمةً منه ولا إلْفَ تلادِ",11,"د",1,0],["لا تَراها هناك تَجْحَظُ عينٌ","لك منها ولا يَدِرُّ وريدُ",12,"د",1,0],["لا ترضَ بالمثل الذي مثَّلْتَهُ","مثلاً ففيه مقالةٌ للزاري",13,"ر",2,0],["لا ترهبوا الدهر إن العرف ناهضُهُ","لكم على الدهر منها خير أنصارِ",14,"ر",1,0],["لأتركن المِسْخ أحدوثةً","سائرة تبقى يد الدهرِ",15,"ر",1,0],["لا ترجُ يا بيهقيُّ إفْراشي","لن يَقبلَ الموت رشوة الراشي",16,"ش",2,1],["لا ترى نرجساً يُشبّه بالور","د إذا ما أدرتَ فكراً ولحظا",17,"ظ",2,1],["لا ترم وصلنا فهذا بنان","قد صبغناه من دم العشاق",18,"ق",1,0],["لا تردَّنَّني إلى ظُلَمِ الكر","خِ وأخلاقِ أهلهِ المرذولهْ",19,"ل",2,0],["لا تراه يخِفُّ للمستخفّا","ت ولا يستكينُ للآلام",20,"م",1,0],["لا ترى نرجساً يشبَّه بالور","دِ إذا ما أردت فكراً وعينا",21,"ن",2,1],["لا ترومي نيكيك ذلك شيءٌ","لم يكن مثلُه وليس يكون",22,"ن",1,0],["لا ترضينَّ برأي نفسِك وحدها","فلرُبَّ خافيةِ عليك وخافيه",23,"ف",3,0],["لا تُراعي يا شُهبُ مِنّا فَإِنّا","ما حَمَلنا إِلَيكِ غَيرَ الوَلاءِ",24,"ا",2,0],["لا تَرقُدوا عَنهُ فَلَيسَ بِراقِدٍ","أَفَتَهجَعون وَقَد طَمى التَيّارُ",25,"ر",1,0],["لا تَركُنَنَّ إِلى الحَياةِ فَإِنَّها","دُنيا هُلوكٌ لِلرِجالِ قَتولُ",26,"ل",1,0],["لا تَرقُبِ النَجمَ في أَمرٍ تُحاوِلُهُ","فَاللَهُ يَفعَلُ لا جَديٌ وَلا حَمَلُ",27,"ل",1,0],["لا ترفُّ الحَيَاةُ فيهِ فلا طيرَ","يغنِّي ولا سَحَابَ يجودُهْ",28,"ه",1,0],["لا ترى بعدها على الارض منهم","غير اشلاء او دم منساب",29,"ب",1,0],["لا ترد للشعور مني حدا","فهو شيء يسمو عن التحديد",30,"د",1,0],["لا ترى اليوم منه الا رمادا","بعد نار من الشعور حراق",31,"ق",1,0],["لا تُرَع أيها البناء المُعلّى","فلمرضى الأطفال فيك شفاء",32,"ا",2,0],["لا ترتقى عن سجل الفخر آيتها","إلا إلى قلم في اللوح يحصيها",33,"ي",3,0],["لا ترى حولي إلا معسرا","حين أُعطِى بشمال ويمين",34,"ن",1,0],["لا تروقنّ نومة الحق للبا","غي فللحق هزة وأنتقام",35,"م",1,0],["لا تَرجُ في الفِتنَة رِفقَ الوَالي","قَد يُدفَع الحُكّامُ بِالأَحوالِ",36,"ل",1,0],["لا تَرهَبُ الطوفانَ في طُغيانِها","لَو قابَلَتهُ وَلا تَهابُ الأَبحُرا",37,"ر",2,0],["لا تَرُدّوا يَدَهُم فارِغَةً","طالِبُ العَونِ لِمِصرٍ لا يُرَد",38,"د",1,0],["لا تُرِق دَمَعاً عَلى الفَنِّ فَلَن","يَعدِمَ الفَنُّ الرُعاةَ الأُمَناء",39,"ا",2,0],["لا تَرى العَينُ مِنهُما أَينَ جالَت","غَيرَ نِقضٍ أَو رِمَّةٍ أَو حُطامَه",40,"م",2,0],["لا تَرى في رِكابِهِ غَيرَ مُثنٍ","بِخَميلٍ وَشاكِرٍ فَضلَ عُرسِ",41,"س",1,0],["لا تَرى غَيرَ وافِدينَ عَلى التا","ريخِ ساعينَ في خُشوعٍ وَنَكسِ",41,"س",1,0],["لا تَروقَنَّ نَومَةُ الحَقِّ لِلبا","غي فَلِلحَقِّ هَبَّةٌ وَاِنتِقامُ",42,"م",1,0],["لا تَرجُ فيهِ وَقاراً لِلرَسولِ فَما","بَينَ البُغاةِ وَبَينَ المُصطَفى رَحِمُ",43,"م",1,0],["لا ترجونَّ صلاح منهمكٍ يُرى","في عينه حسناً مساوى فعِله",44,"ل",2,0],["لَأَترُكَنَّ وُجوهَ الخَيلِ ساهِمَةً","وَالحَربُ أَقوَمُ مِن ساقٍ عَلى قَدَمِ",45,"م",1,0],["لأترعتُمُ الدنيا ندَىً فأفضتُمُ","صنائعَ غُرَّاً لم يصادِفْنَ مصنعَا",46,"ع",2,0],["لا تَرَيهِ عاراً فَما هُوَ بِال","شَيبِ وَلَكِنَّهُ جِلاءُ الشَبابِ",47,"ب",1,0],["لا تِربُهُ الجَذَعُ الَّذي يَعتاقُهُ","وَهنُ الكَلالِ وَلَيسَ كُلَّ القارِحِ",48,"ح",1,0],["لاتَرُزني مُزاوِلاً لِإِختِباري","بَعدَ هَذي البَلوى فَتُنكِرَ مَسّي",49,"س",2,0],["لا تَرهَبَنَّ دُجى الحَنادِسِ بَعدَما","صَدَعَت خِلافَتُهُ بِنورٍ مُشرِقِ",50,"ق",1,0],["لا تُرِد عِندَ مَن تَخَيَّرَ رَأياً","وَإِطلُبِ الرَأيَ عِندَ مَن يَتَظَنّى",51,"ن",2,0],["لا تَركَنَنَّ إِلى الرَجاءِ فَإِنَّهُ","خَدَعَ القُلوبَ وَضَلَّلَ المَعقولا",52,"ل",2,0],["لا تَرتَجِ الخَيرَ عِندَ مَن لا","يَصلُحُ إِلّا عَلى الهَوانِ",53,"ن",1,0],["لا تَراني آخِرَ الدَه","رِ بِتَسآلٍ أَفوهُ",54,"و",2,0],["لا تَرقُدَنَّ لِعَينِكَ السَهَرُ","وَاِنظُر إِلى ما تَصنَعُ العِبَرُ",55,"ر",1,1],["لا تَراني إِذا رَأَيتَ نَقِيِّ ال","خَدِّ أُثني طَرفي إِلى لِحياني",56,"ن",2,0],["لا تَرى عَينُ رَقيبٍ","فيهِ لِلأَقلامِ ثَجّا",57,"ج",2,0],["لا تَرضَ ذاكَ فَتُسخِطَنَّ أَوابِداً","هَزَّتكَ إِلّا أَن تُصيبَكَ مَرهَفا",58,"ف",2,0],["لا تَرثِ لِاِبنِ الأَعمَشِ الكَشخانِ مِن","رُخصِ الإِجارَةِ وَالبَغاءِ لَدَيهِ",59,"ي",2,1],["لا تَركَنَنَّ إِلى الدُنيا وَزُخرُفِها","فَإِنَّ أَوطانَها لَيسَت بِأَوطانِ",60,"ن",1,0],["لا تَرْكَنَنَّ إِلَى النَّمَّامِ إِنَّ لَهُ","خَدْعاً يُفَرِّقُ بَيْنَ الرُّوحِ وَالْبَدَنِ",61,"ن",1,1],["لا تَرْكَنَنَّ إِلَى الزَّمَانِ فَرُبَّمَا","خَدَعَتْ مَخِيلَتُهُ الْفُؤَادَ الْغَافِلا",62,"ل",2,1],["لا تَرى إِلّا الرَمادَ بِهِ","وَمَغاني القِدرِ وَالحُمَما",63,"م",2,0],["لا تَرجِعيني إِلى مَن لَيسَ يَرحَمُني","فَداكِ مَن تُبغِضينَ الحَتفَ وَالسَقما",64,"م",2,0],["لا تَرحَليني بِذَنبٍ أَنتِ صاحِبُهُ","وَصادِقيني صَفاءَ الوُدِّ وَاِستَمِعي",65,"ع",2,0],["لِأَترابِها لَيتَ المُغيرِيَّ إِذ دَنَت","بِهِ دارُهُ مِنّا أَتى فَيُوَدِّعُ",66,"ع",1,0],["لا تركننَّ إلى الوساوسِ واحترِسْ","إنّ الوساوسَ للنُّفوسِ ضلالُ",67,"ل",1,0],["لا تُريدوا بعد شوقي غيرَه","إنّ خيرَ الشّعرِ شعرُ الأحمديْنْ",68,"ن",1,0],["لا ترانا إلى قرارةِ وادٍ","نتحامَى الوغَى ونخشَى الدِّحالا",69,"ل",2,0],["لا تُراعي إِنَّ مِن آياتِهِ","ما يُراعي فيكِ مِن دُنيا وَدينْ",70,"ن",1,0],["لا تُريقوا دَمَ الضَعيفِ عَلَيهِ","وَاِنظُروهُ مِن فَوقِهِ كَيفَ سالا",71,"ل",2,0],["لا تَرْزَئِي زوجَ النبيِّ بأرضِنا","شَيئاً فَ