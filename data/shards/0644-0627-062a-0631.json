/diwan/poem/54260","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54216","الرمل"],[106,"تهنئة بوسام","https://www.poetsgate.com/ViewPoem.aspx?id=179504",""],[106,"الطبيب الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=179681",""],[58,"النفسُ تبكي على الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=10041",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[90,"الدم يتكلم بعد عشرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=179112",""],[45,"أأُخَيّ! نَهْنِهْ دَمْعَكَ المَسْفُوكا","https://www.poetsgate.com/ViewPoem.aspx?id=32149",""],[51,"إبليس إن كنتَ من المُنْظرينْ","https://www.poetsgate.com/ViewPoem.aspx?id=30752",""],[31,"إذهب، وقل للتي لامتْ، وقد علمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18944&r=&rc=207",""],[85,"الله يحكمُ في المداينِ والقُرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9648&r=&rc=138",""]],"verses":[["لا تَرِدُ الماءَ وَلا","تُطوى بِها المَنازِلُ",0,"ل",1,0],["لا تَرتَعي مُعشِباً مَنابِتُهُ","بيضُ الظُبى وَالعَواسِلُ الذُبُلُ",1,"ل",1,0],["لا تَرقُدَنَّ عَلى الأَذى","وَاِعزُم كَما عَزَمَ اِبنُ موسى",2,"س",2,1],["لا تَرْجُ إلا اللّهَ في شِدّةٍ","وثِقْ بهِ فهْوَ الذي أيّدَكْ",3,"ك",1,1],["لا تُرَى فِي مُلِمَّةٍ بَادِي المَقْ","تَلِ إِلاَّ فِي نُصْرَةِ المَظْلُومِ",4,"م",1,0],["لا ترى فيه ما يسرّك بالصن","عة حسناً ويبهج الأبصارا",5,"ر",2,0],["لا تَرهَبُنَّ وَراءِ ما حَيِيتُ لَكُم","جَهلَ الغُواةِ وَخَلّوهُم وَخَلّوني",6,"ن",2,0],["لأتركنَّ فريداً في التراب غداً","ولو تكثرَ ما بين الورى عدَدِي",7,"د",2,0],["لا ترضينَّ لمن أتاك بضدِّ ما","ترضى لنفسك إنَّ ذلك حُوبُ",8,"ب",1,0],["لا تَرَاها تَعِيثُ عَيْثَ الذئاب ال","طُلْسِ لكنْ تَصِيدُ صَيْدَ الفُهُودِ",9,"د",1,0],["لا تَرى القاسم المؤمَّل إلا","باكرَ الرِّفْد شاكرَ المرْفُودِ",9,"د",1,0],["لا تَرى مُنْشِدَ الشبابِ يَدَ الدَهْ","رِ وتلقى منْ شئتَ من نُشَّادِهْ",10,"د",2,0],["لا ترى خائفَ المَغالة منه","لا ولا آمناً من استطرادِهْ",10,"د",2,0],["لا ترى استطراف علْقٍ طارفٍ","شيمةً منه ولا إلْفَ تلادِ",11,"د",1,0],["لا تَراها هناك تَجْحَظُ عينٌ","لك منها ولا يَدِرُّ وريدُ",12,"د",1,0],["لا ترضَ بالمثل الذي مثَّلْتَهُ","مثلاً ففيه مقالةٌ للزاري",13,"ر",2,0],["لا ترهبوا الدهر إن العرف ناهضُهُ","لكم على الدهر منها خير أنصارِ",14,"ر",1,0],["لأتركن المِسْخ أحدوثةً","سائرة تبقى يد الدهرِ",15,"ر",1,0],["لا ترجُ يا بيهقيُّ إفْراشي","لن يَقبلَ الموت رشوة الراشي",16,"ش",2,1],["لا ترى نرجساً يُشبّه بالور","د إذا ما أدرتَ فكراً ولحظا",17,"ظ",2,1],["لا ترم وصلنا فهذا بنان","قد صبغناه من دم العشاق",18,"ق",1,0],["لا تردَّنَّني إلى ظُلَمِ الكر","خِ وأخلاقِ أهلهِ المرذولهْ",19,"ل",2,0],["لا تراه يخِفُّ للمستخفّا","ت ولا يستكينُ للآلام",20,"م",1,0],["لا ترى نرجساً يشبَّه بالور","دِ إذا ما أردت فكراً وعينا",21,"ن",2,1],["لا ترومي نيكيك ذلك شيءٌ","لم يكن مثلُه وليس يكون",22,"ن",1,0],["لا ترضينَّ برأي نفسِك وحدها","فلرُبَّ خافيةِ عليك وخافيه",23,"ف",3,0],["لا تُراعي يا شُهبُ مِنّا فَإِنّا","ما حَمَلنا إِلَيكِ غَيرَ الوَلاءِ",24,"ا",2,0],["لا تَرقُدوا عَنهُ فَلَيسَ بِراقِدٍ","أَفَتَهجَعون وَقَد طَمى التَيّارُ",25,"ر",1,0],["لا تَركُنَنَّ إِلى الحَياةِ فَإِنَّها","دُنيا هُلوكٌ لِلرِجالِ قَتولُ",26,"ل",1,0],["لا تَرقُبِ النَجمَ في أَمرٍ تُحاوِلُهُ","فَاللَهُ يَفعَلُ لا جَديٌ وَلا حَمَلُ",27,"ل",1,0],["لا ترفُّ الحَيَاةُ فيهِ فلا طيرَ","يغنِّي ولا سَحَابَ يجودُهْ",28,"ه",1,0],["لا ترى بعدها على الارض منهم","غير اشلاء او دم منساب",29,"ب",1,0],["لا ترد للشعور مني حدا","فهو شيء يسمو عن التحديد",30,"د",1,0],["لا ترى اليوم منه الا رمادا","بعد نار من الشعور حراق",31,"ق",1,0],["لا تُرَع أيها البناء المُعلّى","فلمرضى الأطفال فيك شفاء",32,"ا",2,0],["لا ترتقى عن سجل الفخر آيتها","إلا إلى قلم في اللوح يحصيها",33,"ي",3,0],["لا ترى حولي إلا معسرا","حين أُعطِى بشمال ويمين",34,"ن",1,0],["لا تروقنّ نومة الحق للبا","غي فللحق هزة وأنتقام",35,"م",1,0],["لا تَرجُ في الفِتنَة رِفقَ الوَالي","قَد يُدفَع الحُكّامُ بِالأَحوالِ",36,"ل",1,0],["لا تَرهَبُ الطوفانَ في طُغيانِها","لَو قابَلَتهُ وَلا تَهابُ الأَبحُرا",37,"ر",2,0],["لا تَرُدّوا يَدَهُم فارِغَةً","طالِبُ العَونِ لِمِصرٍ لا يُرَد",38,"د",1,0],["لا تُرِق دَمَعاً عَلى الفَنِّ فَلَن","يَعدِمَ الفَنُّ الرُعاةَ الأُمَناء",39,"ا",2,0],["لا تَرى العَينُ مِنهُما أَينَ جالَت","غَيرَ نِقضٍ أَو رِمَّةٍ أَو حُطامَه",40,"م",2,0],["لا تَرى في رِكابِهِ غَيرَ مُثنٍ","بِخَميلٍ وَشاكِرٍ فَضلَ عُرسِ",41,"س",1,0],["لا تَرى غَيرَ وافِدينَ عَلى التا","ريخِ ساعينَ في خُشوعٍ وَنَكسِ",41,"س",1,0],["لا تَروقَنَّ نَومَةُ الحَقِّ لِلبا","غي فَلِلحَقِّ هَبَّةٌ وَاِنتِقامُ",42,"م",1,0],["لا تَرجُ فيهِ وَقاراً لِلرَسولِ فَما","بَينَ البُغاةِ وَبَينَ المُصطَفى رَحِمُ",43,"م",1,0],["لا ترجونَّ صلاح منهمكٍ يُرى","في عينه حسناً مساوى فعِله",44,"ل",2,0],["لَأَترُكَنَّ وُجوهَ الخَيلِ ساهِمَةً","وَالحَربُ أَقوَمُ مِن ساقٍ عَلى قَدَمِ",45,"م",1,0],["لأترعتُمُ الدنيا ندَىً فأفضتُمُ","صنائعَ غُرَّاً لم يصادِفْنَ مصنعَا",46,"ع",2,0],["لا تَرَيهِ عاراً فَما هُوَ بِال","شَيبِ وَلَكِنَّهُ جِلاءُ الشَبابِ",47,"ب",1,0],["لا تِربُهُ الجَذَعُ الَّذي يَعتاقُهُ","وَهنُ الكَلالِ وَلَيسَ كُلَّ القارِحِ",48,"ح",1,0],["لاتَرُزني مُزاوِلاً لِإِختِباري","بَعدَ هَذي البَلوى فَتُنكِرَ مَسّي",49,"س",2,0],["لا تَرهَبَنَّ دُجى الحَنادِسِ بَعدَما","صَدَعَت خِلافَتُهُ بِنورٍ مُشرِقِ",50,"ق",1,0],["لا تُرِد عِندَ مَن تَخَيَّرَ رَأياً","وَإِطلُبِ الرَأيَ عِندَ مَن يَتَظَنّى",51,"ن",2,0],["لا تَركَنَنَّ إِلى الرَجاءِ فَإِنَّهُ","خَدَعَ القُلوبَ وَضَلَّلَ المَعقولا",52,"ل",2,0],["لا تَرتَجِ الخَيرَ عِندَ مَن لا","يَصلُحُ إِلّا عَلى الهَوانِ",53,"ن",1,0],["لا تَراني آخِرَ الدَه","رِ بِتَسآلٍ أَفوهُ",54,"و",2,0],["لا تَرقُدَنَّ لِعَينِكَ السَهَرُ","وَاِنظُر إِلى ما تَصنَعُ العِبَرُ",55,"ر",1,1],["لا تَراني إِذا رَأَيتَ نَقِيِّ ال","خَدِّ أُثني طَرفي إِلى لِحياني",56,"ن",2,0],["لا تَرى عَينُ رَقيبٍ","فيهِ لِلأَقلامِ ثَجّا",57,"ج",2,0],["لا تَرضَ ذاكَ فَتُسخِطَنَّ أَوابِداً","هَزَّتكَ إِلّا أَن تُصيبَكَ مَرهَفا",58,"ف",2,0],["لا تَرثِ لِاِبنِ الأَعمَشِ الكَشخانِ مِن","رُخصِ الإِجارَةِ وَالبَغاءِ لَدَيهِ",59,"ي",2,1],["لا تَركَنَنَّ إِلى الدُنيا وَزُخرُفِها","فَإِنَّ أَوطانَها لَيسَت بِأَوطانِ",60,"ن",1,0],["لا تَرْكَنَنَّ إِلَى النَّمَّامِ إِنَّ لَهُ","خَدْعاً يُفَرِّقُ بَيْنَ الرُّوحِ وَالْبَدَنِ",61,"ن",1,1],["لا تَرْكَنَنَّ إِلَى الزَّمَانِ فَرُبَّمَا","خَدَعَتْ مَخِيلَتُهُ الْفُؤَادَ الْغَافِلا",62,"ل",2,1],["لا تَرى إِلّا الرَمادَ بِهِ","وَمَغاني القِدرِ وَالحُمَما",63,"م",2,0],["لا تَرجِعيني إِلى مَن لَيسَ يَرحَمُني","فَداكِ مَن تُبغِضينَ الحَتفَ وَالسَقما",64,"م",2,0],["لا تَرحَليني بِذَنبٍ أَنتِ صاحِبُهُ","وَصادِقيني صَفاءَ الوُدِّ وَاِستَمِعي",65,"ع",2,0],["لِأَترابِها لَيتَ المُغيرِيَّ إِذ دَنَت","بِهِ دارُهُ مِنّا أَتى فَيُوَدِّعُ",66,"ع",1,0],["لا تركننَّ إلى الوساوسِ واحترِسْ","إنّ الوساوسَ للنُّفوسِ ضلالُ",67,"ل",1,0],["لا تُريدوا بعد شوقي غيرَه","إنّ خيرَ الشّعرِ شعرُ الأحمديْنْ",68,"ن",1,0],["لا ترانا إلى قرارةِ وادٍ","نتحامَى الوغَى ونخشَى الدِّحالا",69,"ل",2,0],["لا تُراعي إِنَّ مِن آياتِهِ","ما يُراعي فيكِ مِن دُنيا وَدينْ",70,"ن",1,0],["لا تُريقوا دَمَ الضَعيفِ عَلَيهِ","وَاِنظُروهُ مِن فَوقِهِ كَيفَ سالا",71,"ل",2,0],["لا تَرْزَئِي زوجَ النبيِّ بأرضِنا","شَيئاً فَبِئسَ الزّادُ للمتزوّدِ",72,"د",1,0],["لا تُريدوا من بريدٍ غيرها","إنها من قومكُمْ خير البُرُدْ",73,"د",1,0],["لا تَركَنَنَّ مَعَ الذُنوبِ لِعِزَّةٍ","إِنَّ المُريبَ بِذُعرِهِ مُتَكَفِّنُ",74,"ن",1,1],["لا تَرُدَّنَّ بِالتَنَصُّلِ نَصلَ اللَو","مِ وَاِقلِب لَهُ مِجَنَّ المُجونِ",75,"ن",1,0],["لا ترْجُ عفواً من سواهْ","هو الإلهْ",76,"ه",1,0],["لا تَرعك الخطوب يا ابنةَ مَروا","ن وَلوذي بِاللَه وَالفتيان",77,"ن",1,0],["لا تَرى في فَنائِها آدمياً","وَهِيَ آوت صَوادِحاً وَصلالا",78,"ل",2,0],["لا تَرقُدوا وَجُفونُكُم","مَشحومَةٌ بِحُماةِ",79,"ه",1,0],["لا تَرى في قَتيلِهِ غَيرَ جُرحٍ","كَفَمِ العودِ ضَجَّ عِندَ اللَغوبِ",80,"ب",1,0],["لا تَرى عَيني لَهُ شَبَهاً","غَزِلٌ في الحُبِّ ما حابى",81,"ب",2,0],["لا تَرى شَيئاً عَلى اللَ","هِ مِنَ الأَشياءِ يَخفى",82,"ا",1,0],["لا تَراهُ الدَهرَ إِلّا ثَمِلاً","بَينَ إِبريقٍ وَزِقٍّ وَقَدَح",83,"ح",1,0],["لا تَرى عَينُ المُبينِ بِهِ","ما خَلا الآجالَ مِن بَقرِه",84,"ر",2,0],["لا تَراني يَئِستُ مِن","كَ وَإِن كُنتُ موئِسا",85,"س",2,1],["لا تَركَبَنَّ مِنَ الذُنوبِ خَسيسَها","وَاِعمَد إِذا قارَفتَها لِلأَنبَلِ",86,"ل",1,0],["لا تركبنَّ من الخطايا هيّناً","وإذا ركبت فجاوز القَدرا",87,"ر",2,0],["لا تُرِعِ الطائِرَ يَغذو بَجَّه","يَلتَقِطُ الحَبَّ لِكَي يَمُجُّه",88,"ج",2,1],["لا تَرضَ وَعداً إِن قَدِرتَ عَلى نَداً","وَإِذا وَعَدتَ فَيَسِّرِ الإِنجازا",89,"ز",2,0],["لا تَرهَبَّنَّ مِنَ الظِباءِ كَوادِساً","وَلَو اِنتَشَقنَ مَعَ الصَبَاحِ الكُندُسا",90,"س",2,0],["لا تَرقُدوا فَوقَ الرِحالِ فَإِنَّما","تُرمى النُجومُ بِغَيرِ طَرَفِ الناعِسِ",91,"س",1,1],["لا تُرقِصَنَّ مُهَيراتٍ مَكَرَّمَةً","فَلِلمَهارى قَديماً يُعرَفُ الرَقصُ",92,"ص",1,0],["لا تَرجُوَنَّ أَخاً مِنهُم وَلا وَلَداً","وَإِن رَأَيتَ حَياءً أَسبَغَ العَرَقا",93,"ق",2,0],["لا تَرمُلَنَّ إِلى الدُنِّيا تُحاوِلُها","وَاِصرِف إِلى اللَهِ مُعطيكَ المُنى رَملَك",94,"ك",1,0],["لا تَربَلَنَّ وَكُن رِئبالَ مَأسَدَةٍ","إِنَّ الرَشادَ يُنافي البادِنَ الرَبِلا",95,"ل",2,0],["لا تَركُنَنَّ إِلى الحَياةِ فَإِنَّها","غَدّارَةٌ بِأَخي الوَفاءِ الراكِنِ",96,"ن",1,0],["لا تَرْضَ حتى تَرى يُسراك واطِئةً","على رِكابٍ من الإذهابِ كالشّفَقِ",97,"ق",1,0],["لا تَرى إِلّا أَخا رَجُلٍ","آخِذاً قِرناً فَمُلتَزِمُه",98,"م",2,0],["لا ترجع الرغبات نحو عِراصها","أو ترجعَ الأرواح للأجساد",99,"د",1,0],["لا تَرتَقي بغداد إل","لا إن تكاثرت المكاتب",100,"ب",1,0],["لا ترفعنَّ الصوت ثمة بالبكا","إن القبور ومن بهن هجوع",101,"ع",1,0],["لا ترفع المرء أَقوال يفوه بها","بل يرفع المرء سعي المرء والعمل",102,"ل",1,0],["لا ترج فيها اِمتزاجاً","فَما هناكَ اِمتزاج",103,"ج",1,0],["لا ترجونَّ سُلوّاً","لي بعد هَذا الولوع",104,"ع",1,0],["لا ترى من كثيرهم","حالة اليوم في غد",105,"د",1,0],["لا تَرتَقي أُمَّة حتى يَكون لَها","يوماً على سيِّئ العادات عصيان",106,"ن",1,0],["لا ترى تحتهنَّ غير وجود","من عبابٍ وعالم من ضبابِ",107,"ب",1,0],["لا ترى للنهارِ والليل في وا","ديهِ يوماً من دورةٍ واختلافِ",108,"ف",1,0],["لا تَرى في الصَباحِ لاعِبَ نَردٍ","حَولَهُ لِلرِهانِ جَمٌّ غَفيرُ",109,"ر",1,0],["لا ترضَ منه مبلغ الرعاع","وحصة الأعمى من الشعاع",110,"ع",1,0],["لا تَرْهَبِي قَوْلَ الْوُشاةِ فإِنَّهُمْ","قَدْ أَحْسَنُوا في الْقَوْلِ حِينَ أَساءُوا",111,"ا",1,0],["لا تَرَى غَيْرَ وَاقِفٍ يَسْفَحُ الدَّمْ","عَ وَسَاهٍ لا يَسْتَطِيعُ زَمَاعَا",112,"ع",2,0],["لا تَرْكَنَنَّ إِلَى الِعَدُوِّ فَإِنَّهُ","يَبْغِي سِقَاطَكَ بِالحَدِيثِ الْمُعْجِبِ",113,"ب",1,1],["لا تَرَى بَيْنَها سِوَى عَبْقَرِيٍّ","يَأْلَفُ الطَّعْنَ نَجْدَةً وَارْتِيَاحَا",114,"ح",2,0],["لا تَرَى الْعَيْنُ بَيْنَهُمْ غَيْرَ صَبٍّ","بِسَماعٍ أَوْ هائِمٍ بِفَتاةِ",115,"ه",1,0],["لا تَرَى العَيْنُ فِي جوَانِبِهَا إِلاَّ","ثُقُوباً كَأَنَّهُنَّ كِلامُ",116,"م",1,0],["لاَ تَرَى فِيهِ أَيْنَمَا سِرْتَ إِلاَّ","فَرَحاً شَامِلاً وَأُنْساً وَبِشْرَا",117,"ر",2,0],["لاَ تَرَاهُ إِلاَّ بَشُوشاً وَلاَ تَسْ","مَعُ قَوْلاً يَنِمُّ عَنْ أَحْفَادِ",118,"د",1,0],["لاَ تَرْهَبُ الْجَارَةُ الْحَسْنَاءُ نَظْرتَهُ","كَأَنَّ أَجْفَانَهُ شُدَّتْ إِلَى طَنُبِ",119,"ب",1,0],["لا تَرَى منه غيرَ كَفٍ تُنادِي","حينما عَقَّه لسانُ المَقَالِ",120,"ل",1,0],["لا ترى لفتةً به تجبهُ الذو","قَ ولا لَفظةً تخدش أذْنَا",121,"ن",2,0],["لا ترسُموا للطموح حدّاً","فالمجدُ لا يعرف الحدودا",122,"د",2,0],["لا تَرَى فَوْقَ قِمَّةِ الطَّوْدِ إِلاَّ","بَطَلاً لا يَهَابُ هَوْلَ صِعَابِهْ",123,"ب",2,0],["لا تَرِيموا مكانَكُمْ لا تَرِيموا","ساحةُ المُلْكِ مَوْرِدُ السُؤَال",124,"ل",1,0],["لا تُرَاعِي وفي الكِنَانةِ سَعْدٌ","بَيْنَ أشْبَالِهِ الشِدَادِ الصِلاب",125,"ب",1,0],["لا تَرَى في الظَّلامِ للعِلْم إِلاّ","مُقْفِراتٍ من دُورِهِ دارِساتِ",126,"ت",1,0],["لا ترهَبُوا القومَ في مالٍ وفي عددٍ","إن الفقاقيعَ تطْفُو ثم يَمْضينَا",127,"ن",2,0],["لا ترىَ العينُ به إلاَّ عُلاً","كلّما تسمو له العَيْنُ سَمَا",128,"م",2,0],["لا ترفع الرتبُ الرفيعة خاملاً","كم من وسامٍ فوق صدر جماد!",129,"د",1,0],["لا ترهبَنَّ من المقابر وحشةً","يا صاح؛ فهي كثيرةُ الطُّرَّاق",130,"ق",1,0],["لا تركِنَنَّ إلى الدنيا وما فيها","فالموت لا شك يُفنينا ويُفنيها",131,"ي",3,0],["لا ترى ثَمَّ – غيرَ أن يتركَ الحبُّ","شحوباً – وجهاً علاهُ الشحوب",132,"ب",1,0],["لا تْرهَبَنَّكِ قسوةٌٌ من غاصبٍ","عاتٍ فان الحق بالمرصاد",133,"د",1,0],["لا ترى عينيَ الديارَ ولا تسمعُ","أذني ما لا تُّطيق استماعا",134,"ع",2,0],["لا تَرْكَنَنّ إلى الخُطُوبِ،","فإنّها لَمعٌ يَسُرُّكَ تَارَةً وَيَسُوكا",135,"ك",2,0],["لا ترومي بنيكك ذلك شيءٌ","لم يكن مثلهُ وليس يكونُ",136,"ن",1,0],["لا تَرْحَلِيني بِذَنْبٍ أَنْتِ صاحِبُهُ","وَصَادِقِيني صَفَاءَ الوُدِّ وکسْتَمِعِي",137,"ع",2,0],["لا ترهبُ الوفانَ في طغيانها","لو قابَلَتْه، ولا تهابُ الأَبْحُرا",138,"ر",2,0]]}