{"poems":[[146,"قد حصلنا من الماش كما قي","https://www.aldiwan.net/poem58431.html","البسيط"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205824","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40117","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52154","المقتضب"],[4767,"العيد","https://www.poetsgate.com/ViewPoem.aspx?id=129805",""]],"verses":[["بين ذي عُجمة وآخرَ منقو","صٍ وذي جِنَّةٍ وذي تنميسِ",0,"س",1,0],["بين ذُلّ الهوى وعزّة نفسي","ضاع قلبي فما عرفت التأسى",1,"س",2,1],["بَينَ ذَبٍّ يميتُ عادِيَة الشِّر","كِ وَهبٍّ يَحيا بِهِ المُسلِمونا",2,"ن",2,0],["بين ذا وذاك له","كان مذهبٌ أَمَمُ",3,"م",1,0],["بين ذي المعروف طوراً ثم طوراً","بين أهل الشح والقلبِ الجَحود",4,"د",1,0]]}