{"poems":[[354,"الحق في الخلق خلق","https://www.aldiwan.net/poem15803.html","المجتث"],[354,"صمت اللبيب يزينه","https://www.aldiwan.net/poem15834.html","مجزوء الكامل"],[545,"وبنات نعش يستدرن كأنها","https://www.aldiwan.net/poem56829.html","الكامل"],[563,"تفاخر الماء والهواء","https://www.aldiwan.net/poem35076.html","مخلع البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59043","المواليا"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59048","المواليا"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59040","المواليا"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87328","الرجز"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203551","الرجز"],[5081,"عُذْرَاً نزار","https://www.poetsgate.com/ViewPoem.aspx?id=185578",""],[5183,"الخال","https://www.poetsgate.com/ViewPoem.aspx?id=186611",""],[5431,"وجهٌ له الأنوارحتما تُشرقُ","https://www.poetsgate.com/ViewPoem.aspx?id=187197",""]],"verses":[["وَالنُطقُ في الصَمتِ صَمتُ","وَالصَمتِ في النُطقِ نُطقُ",0,"ق",1,0],["وَالنُطقُ إِن أَخطا الصَوا","بَ بِهِ يُشانُ العاقِلُ",1,"ل",1,0],["وَالنَطعُ يَلمَعُ وَالبطَينُ كَأَنَّهُ","كَبشٌ يطَرِّدُهُ لحَتفٍ تائِرُ",2,"ر",1,0],["والنطق بي لم يكن بغيري","والصوت في الخلق والنداء",3,"ا",2,0],["والنطحْ سيفْ والمجره سَيَّافْ","والأفقْ مُقْلَهْ والصبَاح المِرْوَدْ",4,"د",1,0],["والنطح وَقَّرْ والثريَّا دَانِتْ","والفرعْ مَجَّدْ والحمل لُو عَظّمْ",5,"م",1,0],["والنطح سوسن والزبَانَا رَيْحَانْ","والقطب قُمْرِي والسِّمَاكْ الْبَانْ",6,"ن",1,0],["والنطحْ تابوتْ والثريَّا لولبْ","والقطبْ صَارِي والقلاَعْ السَّرَطَانْ",6,"ن",1,0],["وَالنطق وَالعَقل فَهل صَدقتا","يا ملك الطير بِما ذَكرتا",7,"ت",2,0],["وَالنَّطحُ والعَنَاقُ هُم ذُبَّانُ","يزيدُ نِصفَ غصبَعٍ يا آخوَانُ",8,"ن",1,0],["والنطق في الحكم والبيان","نطق المراد العالم الرباني",9,"ي",1,0],["وَالنُّطْقُ بِالْكَلِمَاتِ لَيْسَ يُمِيتُهَا","يُرْدِى لَهِيبَ الْأَحْرُفِ الْإِهْمَالُ",10,"ل",1,0],["والنطع وردة خد بت تفرشه","أديمها والدم الغضبان يضطرب",11,"ب",1,0],["والنطقُ بستان الرؤى ورحيقها","إمّا المقولة تُزدرى أو تعبقُ",12,"ق",1,0]]}