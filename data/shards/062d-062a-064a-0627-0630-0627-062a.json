{"poems":[[90,"يرزت تميس كخطرة النشوان","https://www.aldiwan.net/poem44446.html","الكامل"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[87,"بينا ضعاف من دجاج الريف","https://www.aldiwan.net/poem8049.html","الرجز"],[64,"قالوا النحاس مثاله بشر","https://www.aldiwan.net/poem52178.html","أحذ الكامل"],[68,"هويته تحت أطمار مشعثة","https://www.aldiwan.net/poem40107.html","البسيط"],[46,"دنف بكى آيات ربع مدنف","https://www.aldiwan.net/poem30401.html","الكامل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42637","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43745","البسيط"],[254,"إن الفؤاد بآل كبشة مدنف","https://www.aldiwan.net/poem2103.html","الكامل"],[369,"بعد الصباح الذي ودعتكم فيه","https://www.aldiwan.net/poem60602.html","البسيط"],[408,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[563,"حوت تعاظم فالتقم","https://www.aldiwan.net/poem34194.html","مجزوء الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25344","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46508","الرجز"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19972","الرجز"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111789","البسيط"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87818","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106995","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75989","الكامل"],[3277,"","https://poetry.dctabudhabi.ae/diwan/poem/125979","البسيط"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105622","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141567","الكامل"],[4767,"فتوى الإبادة","https://www.poetsgate.com/ViewPoem.aspx?id=178990",""],[4767,"مقام الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=179965",""],[4767,"استئثار","https://www.poetsgate.com/ViewPoem.aspx?id=185275",""],[4767,"الوداع المر","https://www.poetsgate.com/ViewPoem.aspx?id=212990",""]],"verses":[["حتى إذا تمّ اللقاء قصدت من","ربوات بكفيّا ظلال جنان",0,"ن",1,0],["حتَّى إذا تمَّت بها الأمور","حفَّت بنا لصيدِها الطيور",1,"ر",1,0],["حَتّى إِذا تَهَلَّلَ الصَباحُ","وَاِقتَبَسَت مِن نورِهِ الأَشباحُ",2,"ح",1,0],["حتى إذا تجت إناثهُم","في البحر قام جنينها وقعد",3,"د",1,0],["حَتّى إِذا تَمَّ مَعنى حُسنِهِ وَبَدا","كَالبَدرِ في التَمِّ أَو كَالشَمسِ في الشَرَفِ",4,"ف",1,0],["حَتّى إِذا تَمَّت فَلَم يُعجِزهُ مِن","أَشلائِها مَذخورَةُ المُتَلَهِّفِ",5,"ف",1,0],["حَتّى إِذا تَمَّ مِيقاتُ الرَّضاعِ لَهُ","حَولَينِ أَصبَحَ ذا أَيدٍ عَلَى الفُطُمِ",6,"م",1,0],["حَتّى إِذا تَمَّ أَمرُ اللَّهِ وَاِجتَمَعَت","لَهُ القبَائِلُ مِن بُعدٍ وَمِن زَمَمِ",6,"م",1,0],["حَتّى إِذا تَمَّ أَمرُ الصُلحِ وَاِنتَظَمَت","بِهِ عُقودُ الأَماني أَيَّ مُنتَظَمِ",6,"م",1,0],["حَتَّى إِذَا تَمَّتْ مَوَاقِيتُهَا","وَزَالَ عَنْهَا الزَّبَدُ الْمَائِرُ",7,"ر",1,0],["حَتّى إِذا تَمَّ ميقاتُ الحَياةِ إِلى","حُكمِ الرَدى فَاِستَوَت أُسدٌ وَآجالُ",8,"ل",1,0],["حَتّى إِذا تَلَعَ النَهارُ وَهاجَني","لِلهَمِّ ذِعلِبَةٌ تُنيفُ وَتَصرِفُ",9,"ف",1,0],["حتّى إذا تَمَّ الفَتْحُ من يَدِه","للمُلْكِ أصْغَى إلى ما قالَ واشيه",10,"ي",2,0],["حتّى إذا تركوه عرياناً على","جذعٍ عتوّاً منهمُ وتجبّرا",11,"ر",2,0],["حتى إذا تمت كتا","بة لوح صدري والرقم",12,"م",1,0],["حتى إذا توافقوا واجتمعوا واحتجّ","ناشدهم بربّهم ليرجعوا",13,"ع",3,0],["حَتَّى إِذا تَوَقَّدَتْ مِنَ الزَرَقْ","حَجْرِيَّةٌ كَالجَمْرِ مِنْ سَنِّ الذَلَقْ",14,"ق",1,0],["حَتّى إِذا تَوَسطا في اللعبِ","جاءَ ابن ميكال بِأَمر عجب",15,"ب",1,0],["حَتّى إِذا تَمَّت لَهُ أَعضاؤُهُ","لَم تَنحَبِس واحِدَةٌ عَلى عَتَب",16,"ب",1,0],["حتى اذا تمَّ ما ابدتهُ اعينها","من الجوى منذراتٍ فيهِ بالسقمِ",17,"م",1,0],["حَتّى إِذا تَمَّ اِختِبارُكِ لِلوَرى","وَسَلَختِ في الماخورِ بِضعَةَ أَشهُرِ",18,"ر",1,0],["حتى إذا توردت وجنتها","زاهية قطفتها بالقبل",19,"ل",1,0],["حَتّى إِذا تُلقي لَها ما فاتَها","أَبصَرت كَيفَ النَفثُ في الأَرواعِ",20,"ع",1,0],["حتى إذا تمَّ في الدنيا تطوُّرُها","طارت إلى منزل في الكون روحانى",21,"ن",2,0],["حتى إذا تطفلت شمس الضحى","على الغروب قيل للسير الوحا",22,"ح",2,0],["حتى إذا تُعتعت أصبح عاصماً","لك أن تزل فتخطى الخرنوفا",23,"ف",2,0],["حتى إذا تم اللقاحُ وأحبِلتْ","تلك الليالي بالذي هو أخطر",24,"ر",1,0],["حتى إذا تَمَّت وطاب معينها","جاءت لتنهلَ عذبَه الأبناء",25,"ا",2,0],["حتى إذا تم البِنا","والأرضُ قاحلها نما",26,"م",2,0],["حتى إذا تم المرادُ وأقبَلَت","تمشي الهوينى في سبيلِ نجاة",27,"ه",1,0]]}