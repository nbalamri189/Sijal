{"poems":[[74,"بدت في رداء الشعر باسمة الثغر","https://www.aldiwan.net/poem18703.html","الطويل"],[53,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[91,"ولما سعى الساعون أن نهجر الوغى","https://www.aldiwan.net/poem45088.html","الطويل"],[87,"يا فرنسا نلت أسباب السماء","https://www.aldiwan.net/poem63728.html","الكامل"],[58,"على هذه كانت تدور النوائب","https://www.aldiwan.net/poem58651.html","الطويل"],[2,"لسلمى بشرقي القنان منازل","https://www.aldiwan.net/poem25022.html","الطويل"],[46,"عفت أربع الحلات للأربع الملد","https://www.aldiwan.net/poem30536.html","الطويل"],[141,"عرفت المنزل الخالي","https://www.aldiwan.net/poem67959.html","الهزج"],[251,"ألا هل فؤادي عن صبا اليوم صافح","https://www.aldiwan.net/poem56331.html","الطويل"],[264,"نهارا تجلى الحق في ليلة السبت","https://www.aldiwan.net/poem35961.html","الطويل"],[445,"أنورك أم أوقدت بالليل نارك","https://www.aldiwan.net/poem34885.html","الطويل"],[514,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138399",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138389",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48778","المتقارب"],[1062,"","https://poetry.dctabudhabi.ae/diwan/poem/204568","الرمل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112808","الوافر"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93132","الوافر"],[1689,"","https://poetry.dctabudhabi.ae/diwan/poem/36211","الطويل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111273","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100266","الوافر"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67600","المتقارب"],[3245,"","https://poetry.dctabudhabi.ae/diwan/poem/143685","المتقارب"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104242","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89376","المجتث"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48442","الطويل"],[3619,"","https://poetry.dctabudhabi.ae/diwan/poem/33115","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117950","الوافر"],[3775,"","https://poetry.dctabudhabi.ae/diwan/poem/102024","الرمل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70106","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86449","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136596",""],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136380",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139524",""],[4728,"خليليّ مرا دار سلمى (فصحى)","https://www.poetsgate.com/ViewPoem.aspx?id=176875",""],[5720,"لسلمان العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=207903",""]],"verses":[["لسلطان مصر الناصر بن محمدٍ","على كلِّ مصرٍ طاعةُ البحر والبرّ",0,"ر",1,0],["لسُلَيْمَانَ وهْوَ في آل وهب","كَسُلَيْمانَ في بني داودِ",1,"د",1,0],["لسلطاننا عبد الحميد سياسة","طريقتها في المعضلات هي المثلى",2,"ل",2,0],["لِسُلَيمانَ بِساطٌ واحِدٌ","وَلَهُم أَلفُ بِساطٍ في الفَضاء",3,"ا",2,0],["لَسَلّمْتُ تَسْليمَ الرِّضَا وتَخِذْتُها","يَداً للرَّدَى ما حَجَّ لِلّهِ راكِبُ",4,"ب",1,0],["لِسَلمى بِشَرقِيِّ القَنانِ مَنازِلُ","وَرَسمٌ بِصَحراءِ اللُبَيَّينِ حائِلُ",5,"ل",1,1],["لِسَلمى سَلامانٍ وَعَمرَةِ عامِرٍ","وَهِندِ بَني هِندٍ وَسُعدى بَني سَعدِ",6,"د",1,0],["لِسَلمى قُرَّةِ العَينِ","وَبِنتِ العَمِّ وَالخالِ",7,"ل",1,0],["لسلمتُ تسليمَ البشاشةِ أوزقا","إليها صدىً من جانبِ القَبر صائحُ",8,"ح",1,0],["لسلطان كلّ العارفين تصرّفٌ","له الحكم فيهم إذ غدا صاحبَ التخت",9,"ت",1,0],["لِسُلطانِ حسنٍ فِي بديع محاسِنٍ","يصيدُ القلوبَ النَّافِرَاتِ نفارَكِ",10,"ك",1,0],["لِسُلَيمى كَأَنَّهُ سَحقُ بُردٍ","زادَهُ قِلَّةُ الأَنيسِ مُحولا",11,"ل",2,0],["لسلامة سلمت بعز فاطمُ","وكذا ابوها دام وهو السالم",12,"م",1,1],["لسليمنا بهم العزاء ومثله","للحزن لا ينقاد او يستسلم",13,"م",1,0],["لسلطانهم أم لدستورها","يثيرون أمتك الراضيه",14,"ي",2,0],["لسليمى ما دعت قمرية","بهديل فوق غصن من غضى",15,"ا",1,0],["لسلمان النضار به تضاعف","وأثمر نخله أيضا بعام",16,"م",1,0],["لسلطانهم بالعلم باللّه سلمت","لعزهم ذلت بنورهم اهتدت",17,"ت",1,0],["لسلمى كم بقلبي من قروح","وفي عيني من عينٍ طفوح",18,"ح",1,1],["لَسلّمت تَسليمَ البشاشَة أَو زَقا","إِلَيها صَدى مِن جانِبِ القَبر صالح",19,"ح",1,0],["لسليل البتول سبط رسول","اللَه نور الإله خير الأنام",20,"م",1,0],["لسلَّم نفسه علقاً نفساً","كسا السلام أبراد الحداد",21,"د",1,0],["لَسَلُّ السيوفِ وشَقُّ الصفوفِ","ونَقضُ التِراتِ وضَربُ القُلَلْ",22,"ل",1,1],["لسل السيوف وشق الصفوف","لنقض الترات وضرب القلل",23,"ل",1,0],["لسلمان ملح في القراءة ظاهر","ولا خير في زاد يكون بلا ملح",24,"ح",1,1],["لسلسبيلك أرّخ","بيت شريف ببرهان",25,"ن",1,1],["لسُلَّتْ من البيضِ الرّقاقِ صِفاحُها","وهُزَّتْ من السُمْرِ الطّوالِ كِعابُها",26,"ب",3,0],["لِسَلمى وَأَسماءَ اللَتَينِ أَكَنَّتا","بِقَلبي كَنينَي لَوعَةٍ وَضَمانِ",27,"ن",1,0],["لسلطان البلاد الآصفي ال","جواد المترع الدلو الدهاق",28,"ق",1,0],["لسليل الصالح الحبر الذي","قد سما هام السما فارتفعا",29,"ع",2,0],["لسليم نصر اللَه ذكرٌ خالِدٌ","في ذا المَقامِ وَنسل خوري المفضلِ",30,"ل",1,1],["لِسَلبِهَا عَنِ الإِلهِ مَالاَ","يَلِيقُ وَاقتِضَائِهَا كمَالاَ",31,"ل",2,0],["لسلت بك البطحاء عن أشياخها","إذ أنت أكرم من نموه سليلا",32,"ل",2,0],["لسَليم الغَرام هل من راقي","أم لليل الِفراق صبحُ تلاقي",33,"ق",2,1],["لسلطاننا عبد الحميد الذي زكت","محامده الحسنى فلا تقبل الحصرا",34,"ر",2,0],["لسلم الندى مَن عاد يُنمى لسلمه","وحرب الهدى من عاد يعزى لحربه",35,"ب",2,0],["لِسَلْمَايَ أسْمَاءٌ بشِعري عَدِيدةٌ","أداري أبَاها حينَ يُروى جَليَّا",36,"ي",2,0],["لسلمانَ العروبةِ .. بالتهاني","نجددُ بيعةَ العهدِ الخصِيبِ",37,"ب",1,0]]}