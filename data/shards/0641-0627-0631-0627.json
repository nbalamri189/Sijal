],[5277,"في عينكِ تاهتْ أشرعتي","https://www.poetsgate.com/ViewPoem.aspx?id=200889",""],[5302,"إني أحبك يا نجود","https://www.poetsgate.com/ViewPoem.aspx?id=200779",""],[5365,"ياشام","https://www.poetsgate.com/ViewPoem.aspx?id=190818",""],[5397,"أبسفح حاجر منك يسفح محجر","https://www.poetsgate.com/ViewPoem.aspx?id=157963",""],[5545,"الروح حيرى","https://www.poetsgate.com/ViewPoem.aspx?id=184778",""],[5628,"شر المصائب","https://www.poetsgate.com/ViewPoem.aspx?id=178705",""],[5691,"قبر","https://www.poetsgate.com/ViewPoem.aspx?id=207069",""],[5691,"باب الخليفة...!","https://www.poetsgate.com/ViewPoem.aspx?id=207262",""],[5720,"النبيُّ الهاشميُّﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=199879",""],[5720,"وطنَ الإباءِ","https://www.poetsgate.com/ViewPoem.aspx?id=205823",""],[5725,"مكائد الغسق","https://www.poetsgate.com/ViewPoem.aspx?id=212224",""],[5815,"تَكَهّفْ","https://www.poetsgate.com/ViewPoem.aspx?id=192613",""],[5861,"أيوب آل البيت","https://www.poetsgate.com/ViewPoem.aspx?id=190702",""],[5879,"هل بدلت أرقام هاتفها؟","https://www.poetsgate.com/ViewPoem.aspx?id=215457",""],[5939,"كلُّ أُنثى تُشبِهُكْ","https://www.poetsgate.com/ViewPoem.aspx?id=178587",""],[5956,"لا تخاليني تاركا","https://www.poetsgate.com/ViewPoem.aspx?id=182147",""],[5956,"بصخرِ العز","https://www.poetsgate.com/ViewPoem.aspx?id=192333",""],[6045,"وجمة غضب ونغمة طرب","https://www.poetsgate.com/ViewPoem.aspx?id=162864",""],[6102,"تَضاد !!","https://www.poetsgate.com/ViewPoem.aspx?id=182736",""],[5309,"في نظام مرصع الأصفاد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573552",""],[6203,"من منفاه يحدّثك!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88022&r=&rc=0",""],[6279,"هِيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78807&r=&rc=25",""],[5190,"الشعر والمشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78334&r=&rc=47",""]],"verses":[["فَأَراني إِذا تَذَكَّرتُ مَن خَلَّ","فتُ خَلفي لَم أَملِكِ الاِنتِحابا",0,"ب",2,0],["فَأَرادَها كَيفَ الدُخو","لُ وَكَيفَ ما يُؤتى لَها",1,"ه",2,0],["فَأَرانا لُقمانَ في مِصرَ حَيّاً","وَحَبانا لِكُلِّ داءٍ دَواءَ",2,"ا",2,0],["فَأَراكَ رَبُّكَ إِذ كَسَرتَ صَليبَهُم","نورَ الهُدى وَعَلِمتَ ما لَم نَعلَمِ",3,"م",1,0],["فأراك حين تَهُزُّ عند ضريبة","في النائبات مصمماً كمطبِّقِ",4,"ق",1,1],["فأَرانيه ناصِري وأباه","وله الحمدُ مُثلْةً شَوْهاءَ",5,"ا",2,0],["فأَراهُ زائداً في حُرقتي","فكأن الماء للنار حَطَبْ",6,"ب",1,0],["فأراك حرماني وقال قوارصٌ","تأتيك أنت لمثلها معتادُ",7,"د",1,0],["فَأَراقَ ماءَ شُؤونِهِ وَلَو أَنَّهُ","في الغادِياتِ أَراقَ ماءَ الغادِيَه",8,"ي",2,0],["فأراه الحَيَاةَ في مُونِقِ الحُسْنِ","وجلّى له خفايا الخلودِ",9,"د",1,0],["فَأَرادَتِ الحَمقاءُ تَع","رِفُ مِن رَسائِلِهِ مَرامَه",10,"م",2,0],["فَأَرادوا لِيَنظُروا دَمعَ فِرعَو","نَ وَفِرعَونُ دَمعُهُ العَنقاءُ",11,"ا",2,0],["فَأَراكَ جَهلَ الشَوقِ بَينَ مَعالِمٍ","مِنها وَجِدَّ الدَمعِ بَينَ مَلاعِبِ",12,"ب",1,0],["فأراه في مَسلَكِ الحبِّ رَحْباً","وأراه في مَسلَكِ الصَّبرِ ضِيقا",13,"ق",2,0],["فَأَرانا وَجهُهُ ال","شَمسَ لَيلا",14,"ل",2,0],["فَأَرانا اللَهُ أَقصى الأَماني","فيهِما إِن جارَ دَهرٌ وَمالا",15,"ل",2,0],["فَأَراهُ الإِلَهُ في ظِلَّها العَز","زَ وَطيبَ الهَنا وَنَيلَ الأَماني",16,"ن",2,0],["فأراك تعبث بي كطفل في السما","ء يصرف الأقدار كيف أرادا",17,"د",2,0],["فَأَرابَ إِحداهُنَّ فَاِلتَفَتَت","وَطئي فَلَمّا أَثبَتَت نَظَرا",18,"ر",2,0],["فَأَراني لا أَرى صَدَداً","عَن وُلوعٍ وَالغَرامُ عَمي",19,"م",2,0],["فَأَراقَ مِن إِبريقِهِ لي شَربَةً","كَالنارِ تُشرِقُ في دُجى ظَلمائِهِ",20,"ا",3,0],["فأراكَهُ سِحر البيانِ مُنَضَّدَاً","بِيَدِ البَلاغَةِ وَهْوَ غيرُ مُنَضَّدِ",21,"د",1,0],["فَأَراكَ تَتبَعُ ما يُذَم","مُ وَلا تَعيجُ بِما حُمِدتا",22,"ت",2,0],["فَآرَاؤُهُ فِي الْمُشْكِلاتِ كَوَاكِبٌ","وَهِمَّاتُهُ فِي الْمُعْضِلاتِ مَنَاصِلُ",23,"ل",1,0],["فَأَرَانَا كيْفَ التَّعَاوُنُ وَالرُّكْ","نَانِ فِيهِ نَزَاهَةٌ وَوِئَامُ",24,"م",1,0],["فَأَراني عِبرَةً أَن","دَمِيَ البَدرُ وَقاحا",25,"ح",2,0],["فأراك تتبع ما يذم","ولا تعيج بما حمدتا",26,"ت",2,0],["فأرَاني حَقِيقَةَ الأَدَبِ المَحضِ","ومَحضَ الإِجلاَلِ والتَّوقِيرِ",27,"ر",1,0],["فَأَراحَها مَن لا يُريحُ جِيادَهُ","حَتّى تُثيرَ بِكُلِّ أَرضٍ عِثيرا",28,"ر",2,0],["فَأَراهُم قَوادِماً في جَناحِ ال","عِزِّ وَالناسُ دونَهُم كَالخَوافي",29,"ف",2,0],["فأراد يرفع من وضعت ومن له","رب السما أضحى عدوا يمقت",30,"ت",1,0],["فأراهم الباري سواك ليذعنوا","وأعاد ملكك في يديك لتشكرا",31,"ر",2,0],["فأراني فيّ قد نزلَت","بكمالٍ آية الحرج",32,"ج",1,0],["فَأَراني كالمليكِ الأعظمِ","مِن سُروري وتُجافيني الهموم",33,"م",1,0],["فَأَراهُ وَلا عُيونَ تَراني","وَيَراني وَلا يَنِمُّ دَخيلُ",34,"ل",1,0],["فأراني مما بلا الصبر عيًّا","أيُّ قلبٍ على الخطوب صبور",35,"ر",1,0],["فأراهم ليهتدوا معجزاتٍ","كافيات للصبر والأيقاظ",36,"ظ",1,0],["فأَراك في دين الجدود مطاعنا","تبدو لَلأول وهلة وبهون",37,"ن",1,0],["فأراه جل جلاله آياته ال","كبرى وليس لما رآه نفاد",38,"د",1,0],["فأراني الآله فيك الذي أملت","فضلا ولم أكن باللاهي",39,"ي",1,0],["فأراها تشفع الأر","قال منها بأرتقاص",40,"ص",1,0],["فأرانا بمغاني","ها الغنى بعد التحاص",40,"ص",1,0],["فأراها إن رنت أو خطرت","في الحشا تفعل أفعال السلاح",41,"ح",1,0],["فأراكِ تنبسطينَ في شرقٍ وفي","غربٍ كما انبسطت قوادمُ أنسُر",42,"ر",1,0],["فأراكما في كفِّها شرعاً","والنضرُ مُكتَسَبٌ من النضرِ",43,"ر",1,0],["فَآراؤُهُ لِلثَغرِ كانَت مَفاتِحاً","فَصِرنَ لَهُ الأَقفالَ مِن كُلِّ صَيلَمِ",44,"م",1,0],["فَأَراحَ قَلبي بِالفُكا","هَةِ لَفظُهُ أَوفى إِراحَه",45,"ح",2,0],["فَأَراهُم مَعَ الوَكالَةِ ما لَم","يَتَأَتّى لِغَيرِهِ بِالأَصالَه",46,"ل",2,0],["فَأَرانا الهَنا بِأُفق الأَماني","مُشرِقاً نور شَمسه في الوُجودِ",47,"د",1,0],["فأراد إيقاظاً له عن زجره","والذوق يدرك ذاكم المعقولا",48,"ل",2,0],["فأراعَ الزمانَ منه جمالٌ","وجَلا كلَّ غيهبٍ إذ تجلّى",49,"ل",2,0],["فأراعوا هذا الزَّمان بجمع","لا أُريعوا من بعدها بالفراق",50,"ق",1,0],["فأّرادَ بُنْيَانَ الرِّئا","سَةِ عِنْدَكُمْ بُنْيَانَ هادم",51,"م",1,0],["فأراها الله أقصى ما تمنَّتْ","وكفاها الخوفَ فيه ووقاها",52,"ا",3,0],["فَأَرانا تَوَرُّداً في اِزرِقاقٍ","كَعَقيقٍ يَشَفُّ عَن لازَوَردِ",53,"د",1,0],["فأراكَ الإلهُ ما تتمنَّى","فيهِمُ إنهُ ولىُّ الرجاء",54,"ا",2,0],["فأراه كله مِنَناً","من إلهي وهو لي إقبال",55,"ل",1,0],["فأراهُ قد أعطى النيابة حقّها","بِسدادهِ وبرأيهِ المستحسنِ",56,"ن",1,0],["فأَراني قَهرُهُ مَلِكاً","دونَهُ الأَملاكُ تُقتَهَرُ",57,"ر",1,0],["فأراكَ ربُّكَ بالهُدى ما ترتجي","لنراكَ تفعلُ كلَّ فعلٍ أرشدِ",58,"د",1,0],["فَأَراها اليَومَ لي قَد أَحدَثَت","خُلُقاً لَيسَ عَلى العَهدِ القُدامِ",59,"م",1,0],["فَأَرُ الخَلا قَد راح يَوم الزينه","وَقَد دَعا فَأراً مِن المَدينه",60,"ه",1,1],["فأَرَانِي الإِلهُ مَا كُنْتُ أَرْجُو","هُ وعُوِّضْتُ أَحْسَنَ الإِعْتياضِ",61,"ض",1,0],["فأراه منها لا يَمَلُّ","كوصلِ حِبٍّ لا يُمَلّ",62,"ل",1,0],["فآراء من عاداه محلولة العرى","وراياته معقودة بعرى النصرِ",63,"ر",1,0],["فَأَراك مَنصور اللواء مظفرا","وَأَرى بِسَيفك من عَصاك مقتلا",64,"ل",2,0],["فَأَراني سُبَحّاً في ذهبٍ","مِن عِذارَيهِ كَما اِصفَرَّ العَشا",65,"ش",2,0],["فآراؤهُ تُرْوَى ورَاياتُه تُرَى","ونُعْماهُ تُرْجى وبُؤْساهُ تُتَّقَى",66,"ق",2,0],["فأراني بوجههِ وثنايا","ه نجوماً طلعنَ وسطَ النهارِ",67,"ر",1,0],["فأراد من حرص على ايمانهم","اقناعهم بالزجر عن تلك الصفه",68,"ف",2,0],["فأرانا شمساً بوجه أبي الها","دي وشمنا به ولا ليلَ بدرا",69,"ر",2,0],["فأراهُنَّ بعد ما كان عَنّي","صُدَّداً أن رأينَ شيبَ قذالي",70,"ل",2,0],["فَأَرانا شِفا العَليلِ بِفَتحٍ","نِعمَ فَتحُ المَولى العَلِيِّ الجَلالِ",71,"ل",1,0],["فأرادت من ذلك الهول أن تس","لم خير الورى إلى أعداها",72,"ا",3,0],["فأراها البلخي وهو صقيل","فاهتدت نفسه بما قد رآها",72,"ا",3,0],["فأراد الله أن يبقيهم ولم","برد الأمى هذا وعمر",73,"ر",1,0],["فأراك في هذا الوجود أشعة","وعقيدة ومآثرا وميولا",74,"ل",2,0],["فارائك النواب كالاطلال","موحشةً تراها",75,"ا",3,0],["فآراؤه يلمعنَ كالبرقِ في الدجى","وآلاؤه منهلَّةٌ تَفْضَحُ المُزْنا",76,"ن",2,0],["فأراك حين تطايرت","تلك النسور فلم تعد",77,"د",1,0],["فأراه عام الفتح موعد ربه","حقّاً كما نطق الكتاب المحكم",78,"م",1,0],["فأراه في النومِ حقاً يقينا","رؤية في دارك الاحساس",79,"س",1,0],["فأراه الظن خيبته","وأرى العلمَ الذي انتفدا",80,"د",2,0],["فأراه ما توعَّده","وأراه ما به وعَدا",80,"د",2,0],["فَأراحَهُم جَهمٌ وَشِيعتُهُ مِنَ الل","ومِ العَنِيفِ وَما قَضوا بِأمَانِ",81,"ن",1,0],["فَأرَادَ مِيرَاثَ الثَّلاَثَةِ مِنهُم","فَعَصَت عَلَيهِ غَايَةَ العِصيَانِ",81,"ن",1,0],["فَأرَادَ تَبدِيلَ المعَانِي إذ هِيَ ال","مَقصُودُ مِن تَعبِيرِ كُلِّ لِسَانِ",81,"ن",1,0],["فأرَادَ تَصحِيحاً لَهَا إذ لَم يَكُن","نَقدُ الزيُوفِ يَرُوجُ فِي الأثمَانِ",81,"ن",1,0],["فَأَراكَ أَقرَبَ ما يُنا","لُ وَأَنتَ أَبعَدُ ما يُنال",82,"ل",1,0],["فأراد السبط مسحاً للدما","ليرى في مقلتيه من رماه",83,"ه",1,0],["فأراشت لنا الليالي سهاما","من صروف النوى فجد جفاها",84,"ا",3,0],["فأراها وفادح الوجد أودى","قبسات تشب حشو حشاها",85,"ا",3,0],["فأرانا الإله صرف الليالي","أبداً عن فنائه مصروفا",86,"ف",2,0],["فآراؤه في الفقه يسطع نورها","وتشهد من إيضاحهن المسالك",87,"ك",1,0],["فآراؤُهُ حَزمٌ وَسِيرَتُهُ هُدىً","وَأَلفاظُهُ نُور وَرُؤيَتُهُ ذِكرَى",88,"ر",2,0],["فأراهم حقائقاً جهلوها","وعليه الحمار أبدى نهيقه",89,"ق",2,0],["فأراد كشف قناعها","عن صبح وجه مسفر",90,"ر",1,0],["فاران قل جبل إلى برصا كذا","كاشغر تركستان عند البوصلة",91,"ه",1,0],["فأراَ وَهِرْاً ألفت حتى","تأكّدَ الحبُّ والودادُ",92,"د",1,0],["فاراقت دمائها وبنته","بجسوم لها ونعم البناء",93,"ا",2,0],["فأراني وقفت في آخر الصفّ","لأهل الهوى انتظاراً لدوري",94,"ر",2,0],["فأرانا الصل في ألفاظه","لدغات مرسلات للمنون",95,"ن",1,0],["فَأَراهُ أَسرَعَ فِيَّ حَتّى أَصبَحَت","بيضاً مُتونُ عَوارِضي مِن أَراحي",96,"ح",2,0],["فأرادَ الثأرَ كي تتبعها","خيبة أخرى لما رامَ وقَد",97,"د",1,0],["فأراق من عينيه مهجته اسى","لما اريق وعاد كالحيران",98,"ن",1,0],["فَأَراهُ عَلى النِزالِ بَطيئاً","وَبِما قَد أَراهُ فيها مُهيبا",99,"ب",2,0],["فَأرادينا بِأَراضينا","أَسدٌ رَبضت بَينَ الأَسَل",100,"ل",1,0],["فأَراقَهُ لمَّا أَتَوهُ بهِ وما","إِن راقَهُ إذ لم يُرِدهُ تَعَمُّدا",101,"د",2,0],["فأراح الفؤاد منه بروح","في جميعي سرى على الإطلاق",102,"ق",1,0],["فأراد أن يرتاح فاستلقي على","عشب بظل شجيرة خضراء",103,"ا",2,0],["فأراه منظرها العجو","ز بل العجوز أجل منظر",104,"ر",1,0],["فأراك بالأنوار وشي بروده","وأراك بالاشجار خضر قبابه",105,"ب",2,0],["فأراكَ مصباحُ الزجاجَةِ رفعَهُ","لإزالةِ التمويهِ والتلبيسِ",106,"س",1,0],["ف