ل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139677",""],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101933","الرمل"],[4702,"تالا والشغالة","https://www.poetsgate.com/ViewPoem.aspx?id=155196",""],[4791,"وقت الرد حان","https://www.poetsgate.com/ViewPoem.aspx?id=37112",""],[4867,"الحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=24203",""],[4927,"أسعد الله مساها","https://www.poetsgate.com/ViewPoem.aspx?id=29614",""],[5409,"نحن في كل غدوةٍ ورواح","https://www.poetsgate.com/ViewPoem.aspx?id=155258",""],[5431,"بات لثم الثغر أحلى","https://www.poetsgate.com/ViewPoem.aspx?id=189563",""],[5461,"ميلت نجمة حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=504",""],[5843,"احزان المواني","https://www.poetsgate.com/ViewPoem.aspx?id=51283",""],[2220,"غادروني بالأثيلِ والنَّقَّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19273&r=&rc=815",""]],"verses":[["كلّما صِحْتُ بها وا كَبِدي","مادَتِ الأرضُ لِما بي دَهَشا",0,"ش",2,0],["كلما صار للكهولة شعري","أنشدوه فعاد أمرد لدنا",1,"ن",2,0],["كُلَّما صَبَّحَت دِيارَ عَدُوٍّ","قالَ تِلكَ الغُيوثُ هَذي السُيولُ",2,"ل",1,0],["كُلَّما صافحتْ يداً من لجينٍ","مَنَحتها أناملاً مِن نضارِ",3,"ر",1,0],["كُلَّما صَفَّقَت وَثَبنَ إِلَيها","كَقِيامِ الشُرطِيِّ عِندَ الإِمامِ",4,"م",1,0],["كُلَّمَا صَوَّرَتْهُ نَفْسِي لِعَيْنِي","قَدَحَ الشَّوْقُ فِي الْفُؤَادِ بِزَنْدِ",5,"د",1,0],["كلّما صاحَ نادبٌ هاج شَكْوا","هُ ومَسَّ الأليمَ من نَدَباته",6,"ت",2,0],["كُلَّمَا صَاحَ بها في طَيْبةٍ","مُسْتَثِيراً رَدَّدتها لاَبَتَاها",7,"ا",3,0],["كلّما صان سرّه","ضجّ في الصدر واحتدم",8,"م",1,0],["كلما صافحت لحاظي دق ال","قلب عطفاً على رقاق الخدود",9,"د",1,0],["كلما صفّق العلا لشهيد","هتف المجد للشهيد الثاني",10,"ن",2,0],["كلّما صُنْتُه اكتِتاما بقلبي","شَفَّ عن مَحْض سرِّه الاكتِتامُ",11,"م",1,0],["كُلَّما صَدَّ تَمادى الحُب بي","قُلت إِذ حارَبَني وَأَحربي",12,"ي",1,0],["كلُّ ما صاغَه خيالُ الظُّنونِ","يتهاوى أمَام فجرِ اليقينِ",13,"ن",1,1],["كلما صَرَّتِ اليراعَةُ سَرَّتْ","بدواءٍ مَحَلُّهُ في الدَّواةِ",14,"ه",1,0],["كلّما صافَحَتْ مسامعَ خَصْمٍ","خفضَتْ منه قدرَهُ وكَلامَهْ",15,"م",2,0],["كُلَّما صُفِّقَت حَكَت لِلنَدامى","ذَهَباً تَحتَ فَضَّةٍ بَيضاءِ",16,"ا",2,0],["كلما صحت من تباريح ما تش","كين مزقت بالصياح ضلوعي",17,"ع",2,0],["كلما صحت شاديا","اقبلت تسمع الغناء",18,"ا",2,0],["كلما صبها الغزال توهم","ت سناها من الغزالة أشرق",19,"ق",1,0],["كُلَّما صُغتُ فيكَ بِكراً مِنَ القَو","لِ أَبَت أَن تُرِيدَ غَيرَكَ بَعلا",20,"ل",2,0],["كلما صرحت بالرشد له","لم يزد في غيه إلا تماد",21,"د",1,0],["كُلَّما صَلَّوا قَسَمنا أَجرَهُ","فَلَها النِصفُ عَلى كُلِّ جَسَد",22,"د",1,0],["كلما صِرْتُ بنفسي خالياً","يتبدّى من غيابات الزمن",23,"ن",1,0],["كلما صوّر الخيال لفكري ال","بين من بعد أُلفة واجتماع",24,"ع",1,0],["كلما صفقت لها الريح غنت","ها على الرقص آله الفرمان",25,"ن",1,0],["كلما صوب فكراً أدركا","خالص الرأي من الرأي المشوب",26,"ب",1,0],["كلما صفوَها حسا كأسُ ذهنٍ","رشفتها من العقول ثغور",27,"ر",1,0],["كلما صالوا على حزب العمى","بالمواضي طعنوا الجمع شتات",28,"ت",1,0],["كل ما صارت قضية غيروها في عجاله","واستفادوا والمواطن في مخابيه الدعاوي",29,"ا",3,0],["كل ماصديت تجرحني بصدّك","الجروح اللِّي لها وين الضمان",30,"ن",1,0],["كلما صحت نوام بادلوها غيرها نوام","تسرشد النعاس والغفوة لافكارهم تنمه",31,"م",2,0],["كُلَّمَاْ صُدَّتْº أَرَاْدَتْ عَوْدَةً","عَلَّهَاْ تَحْمِيْ مِنَ الْعَذْلِ حِمَاْهَاْ",32,"ا",3,0],["كلما صوب الحمام فأصمى","أسرع الدهر في ضماد الجراح",33,"ح",1,0],["كلما صادفت مُرا","بات لثم الثغر أحلى",34,"ل",2,0],["كلما صاح الضمير وون قلب","سالت حروفي على دمعة حبيب",35,"ب",1,0],["كل ماصوته يناديني لقيته","كل ماصوتي يناديله لقاني",36,"ن",2,0],["كلما صنتُ تباريحَ الهوى","فَضَحَ الدّمعُ الجَوَى والأرَقَا",37,"ق",2,0]]}