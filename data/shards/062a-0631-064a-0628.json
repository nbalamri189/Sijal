gate.com/ViewPoem.aspx?id=214969",""],[4914,"بمن أتداوى والدوا معك وسدوا","https://www.poetsgate.com/ViewPoem.aspx?id=170940",""],[5055,"حشد روس الفحول","https://www.poetsgate.com/ViewPoem.aspx?id=101193",""],[5150,"بمن تفكرين ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203780",""],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5431,"انظر بقلبك...","https://www.poetsgate.com/ViewPoem.aspx?id=188240",""],[5431,"طوفان عروبي...","https://www.poetsgate.com/ViewPoem.aspx?id=215568",""],[5442,"نسم آن أن تسري الرفاق إلى الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=114747",""],[5544,"عمان اسعدي","https://www.poetsgate.com/ViewPoem.aspx?id=213441",""],[5561,"الحريّة","https://www.poetsgate.com/ViewPoem.aspx?id=193313",""],[5689,"ترى أنت تهوي غير نفسك في ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=143396",""],[5855,"بوادر دمعك ما تنزف","https://www.poetsgate.com/ViewPoem.aspx?id=186553",""],[5910,"في وصفِ يومٍ حارٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=206236",""],[6142,"كم البيض بالأغماد حرى شفارها","https://www.poetsgate.com/ViewPoem.aspx?id=155749",""]],"verses":[["تَرى بَرَداً يُعدي إِلى القَلبِ بَردُهُ","فَيَنفَعُ مِن قَبلِ المَذاقِ بِحينِ",0,"ن",1,0],["تَرى بيضاً تَشَعشَعُ في لَظاه","قَدِ اِلتَصَقَت بِأَعضادِ الزُنودِ",1,"د",1,0],["تَري بَطَلاً يُلقي الفَوارِسَ ضاحِك","وَيَرجِعُ عَنهُم وَهوَ أَشعَثُ أَغبَرُ",2,"ر",1,0],["تَرى بَعضَنا راكِباً مُدبِراً","وَبَعضاً إِلى ضَربِها مُقبِلينا",3,"ن",2,0],["تَرى بِحِفافَيهِ الرَذايا وَمَتنِهِ","قِياماً يُفَتِّرنَ الصَريفَ المُفَتَّرا",4,"ر",2,0],["تَرى بَينَ الصُفوفِ لَهُنَّ رَشقاً","كَما اِنصاعَ الفَواقُ عنِ الرِصافِ",5,"ف",1,0],["تُرى بَعدَ بِشرٍ يُريكَ الغَمامَ","تَهَلَّلَ بارِقُهُ فَاِستَهَلّ",6,"ل",1,0],["تَرى بَعَرَ الآرامِ في عَرَصاتِه","وَقيعانِها كَأَنَّهُ حَبُّ فُلفُلِ",7,"ل",1,0],["تَرى بَعَرَ الصيرانِ فيهِ وَحَولَهُ","جَديداً وَعامِيّاً كَحَبِّ القَرَنفُلِ",8,"ل",1,0],["ترى بعَرَ الآرام في عرصانها","وقيعانها فكأنه حبّ فُلفل",9,"ل",1,0],["تَرى بَناتكَ في الأَطمارِ جائِعَةً","يَغزِلنَ لِلناسِ ما يَملِكنَ قَطميراً",10,"ر",2,0],["تَرى بِهِ الحُسّادُ مِن سَروِهِ","ناراً عَلى أَكبادِهِم موقَدَه",11,"د",2,0],["تَرى بِعَزمَتِهِ في كُلِّ نائِبَةٍ","بَدراً يُضيءُ ضِياءَ البَدرِ في الظُلَمِ",12,"م",1,0],["تَرى بِثَناياهُ الطَلايِعِ تَلتَقي","عَلى كُلِّ سامي الطَرفِ ضافٍ سَبايِبُه",13,"ب",2,0],["تَرى بَينَ أَحجارِها لِلرَما","دِ كَنَفضِ السَحيقِ مِنَ الإِثمِدِ",14,"د",1,0],["تَرى به الجَمْرَ إذا ما صَفا","يُشرِقُ مِثلَ الذَّهَبِ المُشرِقِ",15,"ق",1,0],["ترى به مَعركةً جِهارا","وقَسطَلاً من حَولِها مُثَارا",16,"ر",2,0],["ترى بينَ عينيهِ من البِشْر أنجماً","تَلوحُ لمُرتادِ السَّماحِ وُفُودُها",17,"د",3,0],["تَرى بِحِفافَيهِ الرَذايا وَمَتنِهِ","قِياماً يُقَطِّعنَ الصَريفَ المُفَتَّرا",18,"ر",2,0],["تَرَى بَيْنَهُمْ يَا فَرَّقَ اللَّهُ بَيْنَهُمْ","لَهِيبَ صِيَاحٍ يَصْعَدُ الْفَلَكَ الْعَالِي",19,"ل",2,0],["ترى بقولي زيدٌ ضاربٌ مثلاً","عمراً أردتَ تجازيني على كذبي",20,"ب",2,0],["تَرى بِهِ وَالنَشاطُ يُلهِبُهُ","ماشِئتَ مِن فَحمَةٍ وَمِن شَرَرِ",21,"ر",1,0],["تَرى بِهِمُ مِن نَضرَةٍ في سَماحَةٍ","طُلوعَ بُدورٍ في اِرتِجاجِ بُحورِ",22,"ر",1,0],["تَرى بِهِ ماءَ نَصلِ السَيفِ مُنسَكِباً","يَجري وَجاحِمَ نارِ البَأسِ مُشتَعِلا",23,"ل",2,0],["تَرى بَني الأَصفَرِ البيضَ الوُجوهِ بِهِ","قَد راعَها السَيفُ فَاِصفَرَّت بِهِ وَجَلا",23,"ل",2,0],["تَرى بِهِمُ مِن هِزَّةٍ في طَلاقَةٍ","لِدانَ العَوالي في بَريقِ الصَوارِمِ",24,"م",1,0],["تَرى بِشرَهُ في أَوانِ اللِقا","جَميلاً وَما بَعدَهُ أَجمَلا",25,"ل",2,0],["تَرى بِدَنَ الأَروى بِها كُلَّ شارِقٍ","لَهُ كُنُنٌ مِن دونِها وَسُلوعُ",26,"ع",1,0],["تَرى بَينَ لَحيَيها إِذا ما تَزَغَّمَت","لُغاماً كَبَيتِ العَنكَبوتِ المُمَدَّدِ",27,"د",1,0],["تَرى بَينَ مَجرى مِرفَقَيهِ وَثيلِهِ","هَواءً كَفَيفاةٍ بَدا أَهلُها قَفرِ",28,"ر",1,0],["تَرى بَينَ أَسنانِها لِلعَشا","إِذا فَتَحَت فَمَها قَرطَمَه",29,"م",2,0],["تَرى بهما أسَدَيْ جَحْفَلٍ","غَداةَ المواكبِ وابنَي جَلا",30,"ا",1,0],["تُريبُ وَسَوفَ يَفتَرِقُ التَريبُ","حَوانا وَالثَرى نَسَبٌ قَريبُ",31,"ب",1,1],["تَرى بَينَ مَوقوصٍ تَغَطمَطَ في الرَدى","وَذي رَغبَةٍ يَرجو الحَياةَ نَحيضُ",32,"ض",1,0],["تَرى بيضاً تَشَعشَعُ في لَظاها","قَدِ اِلتَصَقَت بِأَعضادِ الزُنودِ",33,"د",1,0],["تَري بَطَلاً يُلقي الفَوارِسَ ضاحِكاً","وَيَرجِعُ عَنهُم وَهوَ أَشعَثُ أَغبَرُ",34,"ر",1,0],["تَرَى بَيْنَ سَطْحِ الأَرْضِ وَالْجَوِّ نِسْبَةً","تُشَاكِلُ مَا بَيْنَ السَّحَائِبِ وَالْغُدْرِ",35,"ر",1,0],["تَرى بِهِ الْقَوْمَ صَرْعَى لا حِرَاكَ بِهِمْ","كَأَنَّهُمْ مِنْ عَتِيقِ الْخَمْرِ قَدْ سَقَطُوا",36,"ط",3,0],["تَرى بَعَرَ الآرامِ في عَرَصاتِها","وَقيعانِها كَأَنَّهُ حَبُّ فُلفُلِ",37,"ل",1,0],["تَرى بَينَها مَثوى لِسانٍ كَأَنَّهُ","أَسيرٌ تَلَقَّتهُ السُيوفُ سَليبُ",38,"ب",1,0],["تَرَى بَسْمَةَ الآمالِ في بَسَماتِه","وتَلْمَحُ سِرَّ النُّبْلِ حينَ تُقَابِلُهْ",39,"ل",2,0],["ترى بناتك في الأطمار جائعةً","في لبسهنّ رأيت الفقر مسطورا",40,"ر",2,0],["تَرى بَناتِكَ في الأَطمارِ جائِعَةً","يَغزِلنَ لِلناسِ لا يَملِكنَ قِطميرا*",41,"ر",2,0],["تَرى بهما أسَدَيْ جَحْفَلٍ","وما أجأ إلاّ حِصانٌ ويعبوب",42,"ب",1,0],["ترى بين الوجوه عليه سِيمَا","صلاحٍ ليس يسترها اللثام",43,"م",1,0],["ترَى بِذِرَاعِهِ رِمَماً بَوَالِىَ","وتُلفي فَوقَ عَاتِقِه كَدَانَا",44,"ن",2,0],["تَرى بَذلَهُ بِيَسيرِ السُؤالِ","وَتَمنَعُهُ مِن نِصالِ الأَسَل",45,"ل",1,0],["ترى به حيوان البرّ مصطلحاً","ظبي الكناس يوازي ضيغم الخيس",46,"س",1,0],["تَرى بابَهُ لا يُهتَدى غَيرَ أَنَّهُ","تَرى بَينَ أُذنَيهِ طَريقاً مُعَبَّدا",47,"د",2,0],["ترى بُرَتَيْ سِتَّ وستّين وافياً","تَهابانِ ساقَيْها فَتَنْفَصِمانِ",48,"ن",1,0],["تُرَى بكِ مابي من حبيبٍ فَقَدْتُه","أَبانَتْه عني ناجياتُ الجَوائح",49,"ح",1,0],["ترى بها التين وهو غض","وفوقه حية ذكر",50,"ر",1,0],["ترى بشره قبل القِرى وابتسامه","وكفاً إذا صافحته بالندى يندي",51,"د",2,0],["تَرَى بِهِم مِنْ قَامَةٍ واستِقامَةٍ","رُدَيْنِيَّةً ذُبْلا وهِنْدِيةً دُلْقَا",52,"ق",2,0],["ترى به ذا طرقٍ","بين الورى مختلفه",53,"ف",2,0],["تُرَى بين الطَّلا والشَّخصُ يبدو","لعينَيْها من الحَذَرِ انْقساما",54,"م",2,0],["تَرى بكَفّيْهِ ومِن وجْههِ","بَدْرَ سماءٍ بين بَحرَي سَماح",55,"ح",1,0],["ترَّى بنا حقّاً وخلَّصَ آدماً","وكانت له العذراءُ أمّاً بها استَشْفِ",56,"ف",1,0],["ترى برجليه شقوقاً في كلع","من باريء حيص ودامٍ منسلع",57,"ع",1,0],["تُريبُ رجالَ الحشوِ لَمّا قَمعتُها","كَأَنّي عَلَيهِم أَين كُنتُ رَقيبُ",58,"ب",1,0],["تَرى بابَها سَهلاً لِكُلِّ مُدَفَّع","إِذا أَينَعَت نَخلٌ فَأُغلِقَ بابُها",59,"ب",3,0],["ترى بروضتهِ الغنا العلوم جرى","معقولها بصفا المنقول مقترنا",60,"ن",2,0],["ترى بَنان المُديرِ مختضِباً","من لونِها وهْو غيرُ مختَضِبِ",61,"ب",1,0],["ترى بعضها فى فمي كاللسا","ن وجملتها في يدي كاليد",62,"د",1,0],["تُريبُ الشجاعَ بظلِّ القناةِ","ويتَّهمُ الطرفُ فيها الوظيفا",63,"ف",2,0],["ترى بالنوى الأمرَ الذي لا يرونه","هوىً فيقولون الذي ليس تسمعُ",64,"ع",1,0],["ترى بما تُجهِض من سِخالها","لحماً مَضيغاً ودماءً هَدَرا",65,"ر",2,0],["تُرِي بوجوهٍ أنها بجمالها","تصيدُ وما الأَشراكُ إلا شعورُها",66,"ر",3,0],["تُرى بَرَكاتُ بورِكَ فيهِ بَدري","بِما أَلقاهُ مِن سَهَرٍ وَفِكرِ",67,"ر",1,1],["تَرى بِساطَ الرِفدِ إِن مَدَّهُ","مِن أَوَّلِ القَصدِ إِلى الآخِرِ",68,"ر",1,0],["ترى بعد إظهار المآثر نوره","على عرش قلبي قد تمكن واستوى",69,"ا",1,0],["ترى به كلَّ مِقدامٍ بكلِّ وغىً","يرى حُصولَ الأماني في منيّتِهِ",70,"ت",2,0],["تَرَى بها أَنْظارا","تَظُنُّها نُضَارا",71,"ر",2,0],["تَرَى بِهِ أَخْبارَا","تَدْرَا بِهِ الإنكارا",71,"ر",2,0],["ترى بَرّاً فسيحاً تحتَ ثوبٍ","وبحراً يستقلُّ على جَوادِ",72,"د",1,0],["ترى بها الياقوت وال","جوهرَ والمَخْشَلبا",73,"ب",2,0],["تَرى بَيْضَهم بَعْدَ اللِّقاءِ كأَنَّها","أَحَاطَ بهم مِنْ أَسْهُم القِسِّ قندسُ",74,"س",1,0],["تَرى بالمُحَوَّشِ مِمنَّ حَصَدتَ","من الوَحشِ في كُلِّ فَجِّ حِبالا",75,"ل",2,0],["تَرَى بِالوَهمِ في الإبريقِ مِنها","مُرَوَّقَةً تَدِقُ عنِ العيانِ",76,"ن",1,0],["ترى بأطوارك الأوطار قد طويت","في نشرها بسط ما تطوى به الكتب",77,"ب",1,0],["ترى بيضها بيض السيوف وصفرها","إذا قاربت كفيك صفر العقارب",78,"ب",1,0],["تَرى بَرق ماض في غمام عجاجةٍ","وَسَيل دم بَينَ الربى متدفق",79,"ق",1,0],["ترَى باقِيَتها في أس","فَلِ الجامةِ كالفصِّ",80,"ص",1,0],["تَرى بِكَ سوريا نَصيراً وَمُنجِداً","لِأَعتابِهِ كُلُّ إِمرِءٍ لاذَ وَالتَجى",81,"ج",2,0],["ترى به سرا بدت","احواله منوعه",82,"ع",2,