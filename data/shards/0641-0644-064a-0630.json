{"poems":[[95,"ذنبها أنها رأت","https://www.aldiwan.net/poem9153.html","مجزوء الخفيف"],[90,"وأن أصدق برق أنت شائمه","https://www.aldiwan.net/poem44810.html","البسيط"],[99,"طابت بك الأيام وافرحتاه","https://www.aldiwan.net/poem24380.html","السريع"],[99,"يا شطر نفسي وغرامي الوحيد","https://www.aldiwan.net/poem24986.html","السريع"],[104,"في ثنايا العجاج","https://www.aldiwan.net/poem32914.html","المتدارك"],[48,"أحسن بالواجد من وجده","https://www.aldiwan.net/poem23628.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[133,"شربت كأسي أمام نفسي","https://www.aldiwan.net/poem67449.html","مخلع البسيط"],[147,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[234,"كيف لا تعدم الجسوم القلوبا","https://www.aldiwan.net/poem51239.html","الخفيف"],[302,"يا طود مجد في المكارم راس","https://www.aldiwan.net/poem33242.html","الكامل"],[371,"ورأيت أجسام العداة","https://www.aldiwan.net/poem17261.html","مجزوء الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64847","البسيط"],[1949,"","https://poetry.dctabudhabi.ae/diwan/poem/105300","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47128","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91198","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105259","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45145","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83134","الرمل"],[5691,"سفارة فوق الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=206030",""],[5913,"في غاية الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=177074",""],[5601,"نهر الغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65792&r=&rc=131",""]],"verses":[["فليذب وحده أسى","فهي لم تجن بل هوى",0,"و",2,0],["فَلْيذهب اليأس عنّي خاسئاً أبداً","إني بحبل رجائي اليوم معتصم",1,"م",1,0],["فليذهب الليلُ غفرنَا له","ما دامَ هذا الصبحُ عقبى دجاه",2,"ا",2,0],["فليذهب الماضي البعيد السحيق","فيه صريع للبلى لا يفيق",3,"ق",1,0],["فَليذوقوا الزَعاف","بِالظَبي وَالأَسَل",4,"ل",1,0],["فَليَذْرِفِ الجَفْنُ على جَعْفَرٍ","إذ كانَ لم يُفْتَحْ على نِدّهِ",5,"د",2,0],["فَلْيَذْكُ فِي القَوْمِ الثَّنَاءُ عَلَيْهِمَا","طِيباً كَمَا يَذْكُو نَسِيمُ غَوَالِي",6,"ل",2,0],["فَليُذِعِ الغُصنُ ما يراه","منا اذا أحسنَ الكَلام",7,"م",1,0],["فَليَذهَبوا في الأَرضِ أَو فَليَرجِعوا","فَالأَرضُ واسِعَةٌ وَعَفوُكَ أَوسَعُ",8,"ع",1,0],["فليَذُقْ غيريَ الحياةَ فإنّي","لا أرى للحياة بعدَكَ طيبا",9,"ب",2,0],["فَليذهَب النَغلُ الحَسودُ لما به","وَليحظَ مِمّا رامَه بالياسِ",10,"س",1,0],["فَليَذهَبِ الذَهَبُ الَّذي","قَد كانَ يَذهَبُ بِالكِرامِ",11,"م",1,0],["فلْيَذْكُرِ الثَّالِبُ المَعْوَجُّ مَوْقِفَهُ","على السّراطِ الذي يُؤْذي بمُسْتَرِطِهِ",12,"ط",2,0],["فليذهب الشوق بي ما كنت أوله","من قادته قسراً يد الأشواق فاتبعا",13,"ع",2,0],["فَلْيَذْكُرُوا النِّعَمَ التي عَمَتْهُمُ","اللّهُ يعلم أنهنّ غِزارُ",14,"ر",1,0],["فليذوقوا وَبال ما اجترحوه","وَليعد كلهم بِما كان يَعمل",15,"ل",1,0],["فليذر من كإلاهٍ صدر","برأس المشاة ببأسك خر",16,"ر",1,0],["فليذكرن شرخ الشباب بعامل","حيث المتيم رافل في برده",17,"د",2,0],["فَلي ذِمَّةٌ إِذ كُنتُ أَدعى مُحَمَّداً","وَإِن لَم أَكُن في حالَتي بِمُحَمَّدِ",18,"د",1,0],["فَليذُق ما شاءَ مِنهُ","ما رَعى العَهدَ أَمينُه",19,"ن",2,0],["فلْيَذْكُرْ غَزَّةَ ملْحَمَةً","كيْفَ اسْتَشْرى بهِمُ العَصْفُ",20,"ف",1,0],["فليذهب العذلُ في البيداء منتثراً","ويغرِقُ العذلَ موجُ البحر يضطرب",21,"ب",1,0],["فليذهبوا.. صفقة الاذلال باطلة","وليرقصوا كيفما شاؤوا من الطرب",22,"ب",1,0]]}