{"poems":[[53,"ما زلت أطرق المنازل بالنوى","https://www.aldiwan.net/poem29737.html","الكامل"],[53,"لواعج الشوق تخطيهم وتصميني","https://www.aldiwan.net/poem29744.html","البسيط"],[53,"راح يحول شعاعها","https://www.aldiwan.net/poem29860.html","مجزوء الكامل"],[53,"قمر غاض ضوؤه في المحاق","https://www.aldiwan.net/poem29935.html","الخفيف"],[53,"لك السوابق والأوضاح والغرر","https://www.aldiwan.net/poem30458.html","البسيط"],[3,"حكم سيوفك في رقاب العذل","https://www.aldiwan.net/poem192.html","الكامل"],[93,"يا حسنها قارورة","https://www.aldiwan.net/poem11283.html","مجزوء الكامل"],[88,"ناح الحمام وغرد الشحرور","https://www.aldiwan.net/poem44442.html","الكامل"],[72,"هددتموا بالضنا من ليس يرتدع","https://www.aldiwan.net/poem19165.html","البسيط"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[51,"قلبي من الضيق مما ضم قرقرها","https://www.aldiwan.net/poem64024.html","البسيط"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[51,"أحب كل غادة","https://www.aldiwan.net/poem66035.html","مجزوء الرجز"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[91,"يا ليتما خلق الزمان أصيلا","https://www.aldiwan.net/poem62669.html","عموديه"],[70,"هذا كتابي وهو يط","https://www.aldiwan.net/poem42915.html","مجزوء الكامل"],[78,"بكى المبارك في إثر ابن عباد","https://www.aldiwan.net/poem14208.html","البسيط"],[85,"مال واحتجب","https://www.aldiwan.net/poem63725.html","مجزوء المتدارك"],[56,"أصبحت ملقى في الفراش سقيما","https://www.aldiwan.net/poem58506.html","الكامل"],[62,"للجسم إن داخلته روحه فرع","https://www.aldiwan.net/poem52158.html","البسيط"],[62,"إن الألى ضربوا لنا مثلا","https://www.aldiwan.net/poem52209.html","أحذ الكامل"],[45,"أيها الطالب الطويل عناؤه","https://www.aldiwan.net/poem10201.html","الخفيف"],[45,"من نعمة الصانع الذي صنعك","https://www.aldiwan.net/poem65136.html","الطويل"],[61,"زدني من العذل فيها أيها اللاحي","https://www.aldiwan.net/poem51741.html","البسيط"],[97,"مرت حياتي دون أمنية","https://www.aldiwan.net/poem24923.html","أحذ الكامل"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[80,"أوميض البرق في الليل البهيم","https://www.aldiwan.net/poem31292.html","الرمل"],[80,"أصبحت جذلان طيب العربه","https://www.aldiwan.net/poem31562.html","المنسرح"],[31,"يا أهل بابل ما نفست عليكم","https://www.aldiwan.net/poem41836.html","الكامل"],[50,"ماء الصبابة نار الشوق تحدره","https://www.aldiwan.net/poem62402.html","البسيط"],[46,"ماءنا بالواغل يوما على ال","https://www.aldiwan.net/poem22868.html","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43778","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54283","الكامل"],[94,"السراب المظلم","https://www.poetsgate.com/ViewPoem.aspx?id=15630",""],[51,"وفقحة ٍ كالحوت في ابتلاعها","https://www.poetsgate.com/ViewPoem.aspx?id=29509",""],[88,"ناح الحمام وغرّد الشحرور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19535&r=&rc=38",""],[88,"إياك والبصرَّة المُضنى توطُّنها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19576&r=&rc=79",""],[142,"لو كنت أشفق من خضيب بنان","https://www.aldiwan.net/poem58451.html","الكامل"],[155,"نشوان من خمر الصبا","https://www.aldiwan.net/poem55546.html","مجزوء الكامل"],[164,"لا تركنن إلى الهوى","https://www.aldiwan.net/poem67809.html","مجزوء الكامل"],[185,"لو ذقت حين عتبت أيسر حبه","https://www.aldiwan.net/poem14091.html","الكامل"],[185,"انظر إلى بهجة ذا المنظر","https://www.aldiwan.net/poem14547.html","السريع"],[195,"أطربت أم رفعت لعينك غدوة","https://www.aldiwan.net/poem54404.html","الكامل"],[198,"ومهفهف نبت الشقيق بخده","https://www.aldiwan.net/poem51839.html","الكامل"],[198,"أرض منمنمة وظل سجسج","https://www.aldiwan.net/poem51974.html","الكامل"],[204,"صنم تصور أحسن التصوير","https://www.aldiwan.net/poem53255.html","الكامل"],[223,"كل ما في الحياة أنت فقد","https://www.aldiwan.net/poem41443.html","الخفيف"],[229,"أصبحت أفتك خلق الله بالنظر","https://www.aldiwan.net/poem51067.html","البسيط"],[229,"وصامت الجو بعيد الفرقد","https://www.aldiwan.net/poem51126.html","الكامل"],[270,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[282,"هذا العقيق وهذا الرند والبان","https://www.aldiwan.net/poem32347.html","البسيط"],[285,"حمام قربس أبدى من منافعه","https://www.aldiwan.net/poem39335.html","البسيط"],[305,"ماء الحياة قد اختفى في ظلمة","https://www.aldiwan.net/poem56404.html","الكامل"],[366,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[380,"البدر يغار إذا سفرا","https://www.aldiwan.net/poem48784.html","المتدارك"],[396,"هل بالمنازل إن كلمتها خرسُ","https://www.aldiwan.net/poem587.html",""],[429,"جرى الصفاء بفوار الهنا العذب","https://www.aldiwan.net/poem40791.html","البسيط"],[443,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[458,"من راكب تنجو به ممسوسة","https://www.aldiwan.net/poem55832.html","الكامل"],[458,"ليل السرى مثل نهار المقام","https://www.aldiwan.net/poem55886.html","السريع"],[458,"أقريش لا فلم أراك ولا يد","https://www.aldiwan.net/poem56235.html","الكامل"],[464,"ما لي بألحاظ الظباء يدان","https://www.aldiwan.net/poem3424.html","عموديه"],[468,"ماء عناقيد العنب","https://www.aldiwan.net/poem60483.html","مجزوء الرجز"],[479,"هذي العوائد أشعرت","https://www.aldiwan.net/poem36928.html","مجزوء الكامل"],[479,"عاطني يا تونسي في نخبها","https://www.aldiwan.net/poem37603.html","الرمل"],[514,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[558,"أنا بالله عارف","https://www.aldiwan.net/poem34348.html","مجزوء الخفيف"],[561,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[561,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[567,"من شك في فضل الكميت فبينه","https://www.aldiwan.net/poem69699.html","الكامل"],[575,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"]],"verses":[["ماءٌ كَجيبِ الدِرعِ تَصقُلُهُ الصَبا","وَنَقاً يُدَرِّجُهُ النَسيمُ الواني",0,"ن",2,0],["ماءُ النُقَيبِ وَلَو مِقدارُ مَضمَضَةٍ","شِفاءُ وَجدي وَغَيرُ الماءِ يَشفيني",1,"ي",1,0],["ماءُ الهَجيرِ مُرَقرَقاً","في سُرَّةِ الظِلِّ الظَليلِ",2,"ل",1,0],["ماءُ وُدّي مُصَفَّقٌ لَم أُمازِج","هُ بِرَنقٍ مِنَ الرِيا وَالنِفاقِ",3,"ق",1,0],["ماءٌ كَجيدِ الفَتاةِ الرودِ قابِضَةً","مِنَ الحُلِيِّ عَلى أَثنائِهِ الزَهَرُ",4,"ر",1,0],["ماءُ الحَياةِ بِذِلَّةٍ كَجَهَنَّمٍ","وَجَهَنَّمٌ بِالعِزِّ أَطيَبُ مَنزِلِ",5,"ل",1,0],["مَاءٌ بِهِ تُشْفَى صُدُورُ","الشَّارِبِينَ مِنَ الأَوَامِ",6,"م",1,0],["ماء قد انعكس الضياء بوجهه","وصفا فلاح كأنه بلّور",7,"ر",1,0],["ماءٌ من الجفنِ يغني روح واحدةٍ","كأنما السمّ حقًّا فيه منتقع",8,"ع",1,0],["ماءي شباب ونعمة مُزجا","بماء ذاك الحياء والخفرِ",9,"ر",1,0],["ماء الشباب بخدَّيها إذا سَفَرتْ","جرت به الرَّاح حتى أنت تُبصرها",10,"ر",3,0],["ماء بلا رنقٍ إذا ما استُعرضت","أخلاقُهُ نار بغير نُحاس",11,"س",1,0],["ماء صباها غدق","ونارها تَضرّمُ",12,"م",1,0],["ماءٌ ونارٌ فقدْ غادرْنَ كلَّ فتىً","لا بَسْنَ وهو غزير الدمع حران",13,"ن",1,0],["ماءُ الحَياءِ يَجولُ في وَجَناتِها","فَكَأَنَّ في تِلكَ الكُؤوسِ شَمولا",14,"ل",2,0],["ماءٌ تَدَفَّقَ مِن جُفو","ني فَهوَ مِن نارٍ بِصَدري",15,"ر",2,0],["ماءُ السَماءِ عَلى أَبنائِهِ دُرَرٌ","يا لُجَّةَ البَحرِ دومي ذاتَ إِزبادِ",16,"د",1,0],["ماءُ خَدِّهِ","شَفَّ عَن لَهَب",17,"ب",1,0],["ماءٌ مِنَ العَبَراتِ حَرَّى أرْضُهُ","لَوْ كانَ مِنْ مَطَرٍ لكانَ هَزيما",18,"م",2,0],["ماء ونار هما الأصلان قد جمعا","والطبع بين كلا الضدين مشتركُ",19,"ك",1,0],["ماءٌ ومحٌ صار قشرُهما","كنفاً وواقية من الخلل",20,"ل",1,0],["ماءُ وَجهٍ إِذا تَبَلَّجَ أَعطا","كَ أَماناً مِن نَبوَةِ الدَهرِ ماؤُه",21,"ا",3,0],["ماءَنا بِالصاحِبِ الثَقيلِ وَلَن","يَضيقَ بي في المَحَلِّ ماوَسِعَك",22,"ك",1,0],["ماءُ النَّعيمِ على دِيباجِ وَجنتها","يجولُ بين جَنى وردٍ وتُفَّاحِ",23,"ح",1,0],["ماء ضربت الصخر فانبجسا","وجرى الغداة زلاله العذب",24,"ب",1,0],["ماءٌ ونارٌ منايا الأُسْدِ بينهما","ما سُلّ للضرب إلّا سالَ واضطرما",25,"م",2,0],["ماءُ نعماهُ نميرٌ لا صَرىً","وَمُنَدّاهُ خصيبٌ لا وخيم",26,"م",1,0],["ماءُ عقيقٍ إذا ارتدى زبداً","حَسِبتَ دُرّاً مجُوّفاً حَبَبَه",27,"ب",2,0],["ماءَ الفُراتِ وَطيبَ لَيلٍ بارِدٍ","وَسَماعَ مُنشِدَتَينِ لِاِبنِ هِلالِ",28,"ل",1,0],["ماءُ الصَبابَةِ نارُ الشَوقِ تَحدِرُهُ","فَهَل سَمِعتُم بِماءٍ فاضَ مِن نارِ",29,"ر",1,1],["ماءَنا بِالواغِلِ يَوماً عَلى ال","شَربِ وَلا مِثلي بِالوارِشِ",30,"ش",1,1],["ماءٌ مَهينٌ أَعادَهُ عَلَقاً","بِلُطفِهِ ثُمَّ رَدَّهُ مُضَغا",31,"غ",2,0],["ماء العيونِ على الشهيدِ ذرافِ","لو أنّ فيضاً من معينك كافي",32,"ف",2,1],["ماء ولا ريّ يندي في شمائله","كأنّه القول فاتته معانيه",33,"ي",2,0],["ماء الرجال غاية ارتضاعها","يعوي عبيدُ اللَّه من إضباعها",34,"ع",3,0],["ماء قد انعكس الصفاء بوجهه","وصفا فلاح كأنه بَلور",35,"ر",1,0],["ماء زُعاق وجو قاتم وهوى","نَتن وشدة ُ حر غير مُؤتمَن",36,"ن",1,0],["ماءُ الجداولِ للأكفِّ وإنما","ماء القَليبِ يُنال بالأشطانِ",37,"ن",1,0],["مَاءُ الدَّلالِ شَرابُهُ","وَغِذَاؤُهُ تَرَفُ النَّعِيمِ",38,"م",1,0],["ماءُ الحَياةِ رِوىً وَأَن","نى لِلمُجَلّى بِالرَواءِ",39,"ا",2,0],["ماء يموجُ به النعيم لطافةً","لولا غِلالتُه لفُزْتُ بشُرْبه",40,"ب",2,0],["ماءٌ وروضٌ وغزال حَكَتْ","صورتُه الدُّميةَ كالمرمر",41,"ر",1,0],["ماءٌ تَرَقرَقُ بِالعَشِيِّ مُتونُهُ","فَتَراهُ عَن دَوحِ الرِياحِ يَميلُ",42,"ل",1,0],["ماءُ الشَبِيبَةِ وَالجَمالِ أَرَقّ مِن","صَقلِ الحُسامِ المُنتَضى وَفِرِندِهِ",43,"د",2,0],["ماءٌ له جثَثُ الفوارسِ جَذْوَةٌ","نارٌ لها قممُ الأعادي عرفج",44,"ج",1,0],["ماء البشاشة ضاحك في وجههه","أبداً كوجهِ مبشِّرٍ بسرورِ",45,"ر",1,0],["ماءُ عَينَيكِ فيمَ يَصلُبُ أَحيا","ناً وَيَقسو كَأَنَّ فيهِ سَوايا",46,"ا",3,0],["ماءُ المعالي لذيذ في فمي شَبِم","أحلى وأعذب من رِيق الدُمَى العطِر",47,"ر",1,0],["ماءَ خِضَمّ المَوْج طام مُزْبِدِ","وآسِنِ الطعم قذِيِّ الموردِ",48,"د",1,0],["ماءُ الحياءِ سقاهُ في نضارتِهِ","لولا نقابٌ يقيه سالَ أو سابا",49,"ب",2,0],["ماءُ العُذيبِ وَلَو مِقدارُ مَضمَضَةٍ","يَشفي غَليلَ فُؤادي وَهوَ ظَمآنُ",50,"ن",1,0],["ماء الحشائش بعد الغلي تشربه","عند الصباح ترى ما فيه من حكم",51,"م",1,0],["ماءُ الحياةِ قدِ اِختفى في ظلمةٍ","بَل كلُّ غيبٍ إن عقلتَ ظلامُ",52,"م",1,1],["ماءٌ مِنَ السُحبِ أَشطانُ اليَراعِ غَدَت","تَمتاحُهُ مِن قُلوبٍ هُنَّ كَالقُلُبِ",53,"ب",1,0],["ماء أَنصفهُ مِن يُبصرهُ","إِن حَدَّد في الخَد النَظَرا",54,"ر",2,0],["ماء قصير رِشَاءِ الدَّلو مُؤتَزِراً","بالخَيزُرَانة لا مِلحٌ ولا نَمسُ",55,"س",1,0],["ماءُ تحدر من روض الجنان إلى","روض النعيم بغير البرءِِ لم يثبِ",56,"ب",1,0],["ماء نهر ما له صوت خرير","فاجتلاه فإذا ثم حياض",57,"ض",1,0],["ماء الحياء عليه كيف منعتني","بجفائك المبذولَ من ماعونه",58,"ن",2,0],["ماء الحياءِ الرطب والحسنُ في","وجنته ماءٌ وراحٌ وجامْ",59,"م",1,0],["ماء الأسى متصبب لي لم يَغِضْ","في صحن خدٍّ بالبكاء مُخَدَّدِ",60,"د",1,0],["ماءٌ ونارٌ راح قلبي منه في","نارٍ وعيني منه في طوفانِ",61,"ن",1,0],["ماءُ عَناقيدِ العِنَب","يا صاحِ أَحلى ما شُرِب",62,"ب",1,1],["ماء زلالا خالصا","في اللون يحكي العسجدا",63,"د",2,0],["ماء عين في الأنابيب جرى","نحن والأشجار منه نرتوي",64,"ي",1,0],["ماءُ عينِ الحياةِ نارُ المَنايا","صَرْصَرُ الحادثاتِ حَرُّ بَلاها",65,"ا",3,0],["ماء حق صفا ولا","شيء فيه يخالف",66,"ف",1,0],["ماءَ نَشاصٍ حَلَبَت مِنهُ فَدَر","حَدواءُ تَحدوهُ إِذا الوَبلُ اِنتَثَر",67,"ر",1,0],["ماءُ قَرِيٍّ مَدَّهُ قَرِيُّ","غِبَّ سَماءٍ فَهوَ رَقراقِيُّ",68,"ي",1,0],["ماءٌ تدَّفقَ طاعةً وسلاسَةً","فإذا اسْتُدِرَّ الخُضْرُ مِنْهُ فَنَارُ",69,"ر",1,0],["ماءُ البَشَاشَةِ مِلْءُ صَفحتِه","والقَلْبُ فيه النَّار تَسْتَعر",70,"ر",1,0]]}