َّارِبِينَ مِنَ الأَوَامِ",6,"م",1,0],["ماء قد انعكس الضياء بوجهه","وصفا فلاح كأنه بلّور",7,"ر",1,0],["ماءٌ من الجفنِ يغني روح واحدةٍ","كأنما السمّ حقًّا فيه منتقع",8,"ع",1,0],["ماءي شباب ونعمة مُزجا","بماء ذاك الحياء والخفرِ",9,"ر",1,0],["ماء الشباب بخدَّيها إذا سَفَرتْ","جرت به الرَّاح حتى أنت تُبصرها",10,"ر",3,0],["ماء بلا رنقٍ إذا ما استُعرضت","أخلاقُهُ نار بغير نُحاس",11,"س",1,0],["ماء صباها غدق","ونارها تَضرّمُ",12,"م",1,0],["ماءٌ ونارٌ فقدْ غادرْنَ كلَّ فتىً","لا بَسْنَ وهو غزير الدمع حران",13,"ن",1,0],["ماءُ الحَياءِ يَجولُ في وَجَناتِها","فَكَأَنَّ في تِلكَ الكُؤوسِ شَمولا",14,"ل",2,0],["ماءٌ تَدَفَّقَ مِن جُفو","ني فَهوَ مِن نارٍ بِصَدري",15,"ر",2,0],["ماءُ السَماءِ عَلى أَبنائِهِ دُرَرٌ","يا لُجَّةَ البَحرِ دومي ذاتَ إِزبادِ",16,"د",1,0],["ماءُ خَدِّهِ","شَفَّ عَن لَهَب",17,"ب",1,0],["ماءٌ مِنَ العَبَراتِ حَرَّى أرْضُهُ","لَوْ كانَ مِنْ مَطَرٍ لكانَ هَزيما",18,"م",2,0],["ماء ونار هما الأصلان قد جمعا","والطبع بين كلا الضدين مشتركُ",19,"ك",1,0],["ماءٌ ومحٌ صار قشرُهما","كنفاً وواقية من الخلل",20,"ل",1,0],["ماءُ وَجهٍ إِذا تَبَلَّجَ أَعطا","كَ أَماناً مِن نَبوَةِ الدَهرِ ماؤُه",21,"ا",3,0],["ماءَنا بِالصاحِبِ الثَقيلِ وَلَن","يَضيقَ بي في المَحَلِّ ماوَسِعَك",22,"ك",1,0],["ماءُ النَّعيمِ على دِيباجِ وَجنتها","يجولُ بين جَنى وردٍ وتُفَّاحِ",23,"ح",1,0],["ماء ضربت الصخر فانبجسا","وجرى الغداة زلاله العذب",24,"ب",1,0],["ماءٌ ونارٌ منايا الأُسْدِ بينهما","ما سُلّ للضرب إلّا سالَ واضطرما",25,"م",2,0],["ماءُ نعماهُ نميرٌ لا صَرىً","وَمُنَدّاهُ خصيبٌ لا وخيم",26,"م",1,0],["ماءُ عقيقٍ إذا ارتدى زبداً","حَسِبتَ دُرّاً مجُوّفاً حَبَبَه",27,"ب",2,0],["ماءَ الفُراتِ وَطيبَ لَيلٍ بارِدٍ","وَسَماعَ مُنشِدَتَينِ لِاِبنِ هِلالِ",28,"ل",1,0],["ماءُ الصَبابَةِ نارُ الشَوقِ تَحدِرُهُ","فَهَل سَمِعتُم بِماءٍ فاضَ مِن نارِ",29,"ر",1,1],["ماءَنا بِالواغِلِ يَوماً عَلى ال","شَربِ وَلا مِثلي بِالوارِشِ",30,"ش",1,1],["ماءٌ مَهينٌ أَعادَهُ عَلَقاً","بِلُطفِهِ ثُمَّ رَدَّهُ مُضَغا",31,"غ",2,0],["ماء العيونِ على الشهيدِ ذرافِ","لو أنّ فيضاً من معينك كافي",32,"ف",2,1],["ماء ولا ريّ يندي في شمائله","كأنّه القول فاتته معانيه",33,"ي",2,0],["ماء الرجال غاية ارتضاعها","يعوي عبيدُ اللَّه من إضباعها",34,"ع",3,0],["ماء قد انعكس الصفاء بوجهه","وصفا فلاح كأنه بَلور",35,"ر",1,0],["ماء زُعاق وجو قاتم وهوى","نَتن وشدة ُ حر غير مُؤتمَن",36,"ن",1,0],["ماءُ الجداولِ للأكفِّ وإنما","ماء القَليبِ يُنال بالأشطانِ",37,"ن",1,0],["مَاءُ الدَّلالِ شَرابُهُ","وَغِذَاؤُهُ تَرَفُ النَّعِيمِ",38,"م",1,0],["ماءُ الحَياةِ رِوىً وَأَن","نى لِلمُجَلّى بِالرَواءِ",39,"ا",2,0],["ماء يموجُ به النعيم لطافةً","لولا غِلالتُه لفُزْتُ بشُرْبه",40,"ب",2,0],["ماءٌ وروضٌ وغزال حَكَتْ","صورتُه الدُّميةَ كالمرمر",41,"ر",1,0],["ماءٌ تَرَقرَقُ بِالعَشِيِّ مُتونُهُ","فَتَراهُ عَن دَوحِ الرِياحِ يَميلُ",42,"ل",1,0],["ماءُ الشَبِيبَةِ وَالجَمالِ أَرَقّ مِن","صَقلِ الحُسامِ المُنتَضى وَفِرِندِهِ",43,"د",2,0],["ماءٌ له جثَثُ الفوارسِ جَذْوَةٌ","نارٌ لها قممُ الأعادي عرفج",44,"ج",1,0],["ماء البشاشة ضاحك في وجههه","أبداً كوجهِ مبشِّرٍ بسرورِ",45,"ر",1,0],["ماءُ عَينَيكِ فيمَ يَصلُبُ أَحيا","ناً وَيَقسو كَأَنَّ فيهِ سَوايا",46,"ا",3,0],["ماءُ المعالي لذيذ في فمي شَبِم","أحلى وأعذب من رِيق الدُمَى العطِر",47,"ر",1,0],["ماءَ خِضَمّ المَوْج طام مُزْبِدِ","وآسِنِ الطعم قذِيِّ الموردِ",48,"د",1,0],["ماءُ الحياءِ سقاهُ في نضارتِهِ","لولا نقابٌ يقيه سالَ أو سابا",49,"ب",2,0],["ماءُ العُذيبِ وَلَو مِقدارُ مَضمَضَةٍ","يَشفي غَليلَ فُؤادي وَهوَ ظَمآنُ",50,"ن",1,0],["ماء الحشائش بعد الغلي تشربه","عند الصباح ترى ما فيه من حكم",51,"م",1,0],["ماءُ الحياةِ قدِ اِختفى في ظلمةٍ","بَل كلُّ غيبٍ إن عقلتَ ظلامُ",52,"م",1,1],["ماءٌ مِنَ السُحبِ أَشطانُ اليَراعِ غَدَت","تَمتاحُهُ مِن قُلوبٍ هُنَّ كَالقُلُبِ",53,"ب",1,0],["ماء أَنصفهُ مِن يُبصرهُ","إِن حَدَّد في الخَد النَظَرا",54,"ر",2,0],["ماء قصير رِشَاءِ الدَّلو مُؤتَزِراً","بالخَيزُرَانة لا مِلحٌ ولا نَمسُ",55,"س",1,0],["ماءُ تحدر من روض الجنان إلى","روض النعيم بغير البرءِِ لم يثبِ",56,"ب",1,0],["ماء نهر ما له صوت خرير","فاجتلاه فإذا ثم حياض",57,"ض",1,0],["ماء الحياء عليه كيف منعتني","بجفائك المبذولَ من ماعونه",58,"ن",2,0],["ماء الحياءِ الرطب والحسنُ في","وجنته ماءٌ وراحٌ وجامْ",59,"م",1,0],["ماء الأسى متصبب لي لم يَغِضْ","في صحن خدٍّ بالبكاء مُخَدَّدِ",60,"د",1,0],["ماءٌ ونارٌ راح قلبي منه في","نارٍ وعيني منه في طوفانِ",61,"ن",1,0],["ماءُ عَناقيدِ العِنَب","يا صاحِ أَحلى ما شُرِب",62,"ب",1,1],["ماء زلالا خالصا","في اللون يحكي العسجدا",63,"د",2,0],["ماء عين في الأنابيب جرى","نحن والأشجار منه نرتوي",64,"ي",1,0],["ماءُ عينِ الحياةِ نارُ المَنايا","صَرْصَرُ الحادثاتِ حَرُّ بَلاها",65,"ا",3,0],["ماء حق صفا ولا","شيء فيه يخالف",66,"ف",1,0],["ماءَ نَشاصٍ حَلَبَت مِنهُ فَدَر","حَدواءُ تَحدوهُ إِذا الوَبلُ اِنتَثَر",67,"ر",1,0],["ماءُ قَرِيٍّ مَدَّهُ قَرِيُّ","غِبَّ سَماءٍ فَهوَ رَقراقِيُّ",68,"ي",1,0],["ماءٌ تدَّفقَ طاعةً وسلاسَةً","فإذا اسْتُدِرَّ الخُضْرُ مِنْهُ فَنَارُ",69,"ر",1,0],["ماءُ البَشَاشَةِ مِلْءُ صَفحتِه","والقَلْبُ فيه النَّار تَسْتَعر",70,"ر",1,0],["ماءٌ جَرى في رَوضَةٍ قَد ذُلِّلَت","لِلسّائِماتِ قُطوفُها تَذليلا",71,"ل",2,0],["ماءُ وجهٍ يَجري حَياءً ومِن أح","سنِ شيءٍ في المِشرفي في الفِرند",72,"د",1,0],["ماءٌ ونارٌ عنهما اعتدلَ الهوى","فتنعّمت بدخوله الأجسامُ",73,"م",1,0],["ماءٌ ونارٌ فقلْ في ال","ميلادِ والنوروز",74,"ز",1,0],["ماءُ السماحةِ من بطونِ أكفّهم","جارٍ وَعودُ المجد فيها مُورِق",75,"ق",1,0],["ماءُ عقيقٍ بحتٌ يُطافُ به","إِناؤه ماءُ لؤلؤٍ بحتُ",76,"ت",1,1],["ماءُ لفظ تَنَزَّهَ السمعُ منه","في نواحي ضَحْضَاحِهِ الرقراق",77,"ق",1,0],["ماءُ الحَياءِ سَقى الخدودَ فَأَنبتَت","آساً وَوَرداً يانِعاً لا يقطفُ",78,"ف",1,0],["ماءُ سَماءِ الخدِّ لمّا حَلا","أَنبَتَ رَيْحاناً لطيفَ النّما",79,"م",2,1],["ماءُ الحَياءِ وَماءُ الحُسنِ ثمّ كَذا","ماءُ الحَياةِ بِفيهِ المُبْرئِ الوصِبِ",80,"ب",1,0],["ماءُ الحَياةِ بِهِ العلياءُ قد حَييَت","وَمَجدُها عاشَ إِذ لَولاهُ لَم يَعِشِ",81,"ش",1,0],["ماءَ العُيونِ لكي يَرو","كَ على سَمَائِهِمَا هِلالا",82,"ل",2,0],["ماء النعيم بِخدّه متسلسلٌ","ينساب بين بنفسج وشقائق",83,"ق",1,0],["ماءٌ ونار هواء أرضها قدح","وطوفها فلك والأنجم الحبَب",84,"ب",1,0],["ماء على راجي الندى","وعلى العدا نار تسعر",85,"ر",1,0],["ماء لمن صافاه وه","وصفًى على الأعداء صلدُ",86,"د",1,0],["ماء جوادٍ عتيقٍ غير مؤتشب