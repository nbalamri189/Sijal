نية","https://www.aldiwan.net/poem24923.html","أحذ الكامل"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[80,"أوميض البرق في الليل البهيم","https://www.aldiwan.net/poem31292.html","الرمل"],[80,"أصبحت جذلان طيب العربه","https://www.aldiwan.net/poem31562.html","المنسرح"],[31,"يا أهل بابل ما نفست عليكم","https://www.aldiwan.net/poem41836.html","الكامل"],[50,"ماء الصبابة نار الشوق تحدره","https://www.aldiwan.net/poem62402.html","البسيط"],[46,"ماءنا بالواغل يوما على ال","https://www.aldiwan.net/poem22868.html","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43778","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54283","الكامل"],[94,"السراب المظلم","https://www.poetsgate.com/ViewPoem.aspx?id=15630",""],[51,"وفقحة ٍ كالحوت في ابتلاعها","https://www.poetsgate.com/ViewPoem.aspx?id=29509",""],[88,"ناح الحمام وغرّد الشحرور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19535&r=&rc=38",""],[88,"إياك والبصرَّة المُضنى توطُّنها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19576&r=&rc=79",""]],"verses":[["ماءٌ كَجيبِ الدِرعِ تَصقُلُهُ الصَبا","وَنَقاً يُدَرِّجُهُ النَسيمُ الواني",0,"ن",2,0],["ماءُ النُقَيبِ وَلَو مِقدارُ مَضمَضَةٍ","شِفاءُ وَجدي وَغَيرُ الماءِ يَشفيني",1,"ي",1,0],["ماءُ الهَجيرِ مُرَقرَقاً","في سُرَّةِ الظِلِّ الظَليلِ",2,"ل",1,0],["ماءُ وُدّي مُصَفَّقٌ لَم أُمازِج","هُ بِرَنقٍ مِنَ الرِيا وَالنِفاقِ",3,"ق",1,0],["ماءٌ كَجيدِ الفَتاةِ الرودِ قابِضَةً","مِنَ الحُلِيِّ عَلى أَثنائِهِ الزَهَرُ",4,"ر",1,0],["ماءُ الحَياةِ بِذِلَّةٍ كَجَهَنَّمٍ","وَجَهَنَّمٌ بِالعِزِّ أَطيَبُ مَنزِلِ",5,"ل",1,0],["مَاءٌ بِهِ تُشْفَى صُدُورُ","الشَّارِبِينَ مِنَ الأَوَامِ",6,"م",1,0],["ماء قد انعكس الضياء بوجهه","وصفا فلاح كأنه بلّور",7,"ر",1,0],["ماءٌ من الجفنِ يغني روح واحدةٍ","كأنما السمّ حقًّا فيه منتقع",8,"ع",1,0],["ماءي شباب ونعمة مُزجا","بماء ذاك الحياء والخفرِ",9,"ر",1,0],["ماء الشباب بخدَّيها إذا سَفَرتْ","جرت به الرَّاح حتى أنت تُبصرها",10,"ر",3,0],["ماء بلا رنقٍ إذا ما استُعرضت","أخلاقُهُ نار بغير نُحاس",11,"س",1,0],["ماء صباها غدق","ونارها تَضرّمُ",12,"م",1,0],["ماءٌ ونارٌ فقدْ غادرْنَ كلَّ فتىً","لا بَسْنَ وهو غزير الدمع حران",13,"ن",1,0],["ماءُ الحَياءِ يَجولُ في وَجَناتِها","فَكَأَنَّ في تِلكَ الكُؤوسِ شَمولا",14,"ل",2,0],["ماءٌ تَدَفَّقَ مِن جُفو","ني فَهوَ مِن نارٍ بِصَدري",15,"ر",2,0],["ماءُ السَماءِ عَلى أَبنائِهِ دُرَرٌ","يا لُجَّةَ البَحرِ دومي ذاتَ إِزبادِ",16,"د",1,0],["ماءُ خَدِّهِ","شَفَّ عَن لَهَب",17,"ب",1,0],["ماءٌ مِنَ العَبَراتِ حَرَّى أرْضُهُ","لَوْ كانَ مِنْ مَطَرٍ لكانَ هَزيما",18,"م",2,0],["ماء ونار هما الأصلان قد جمعا","والطبع بين كلا الضدين مشتركُ",19,"ك",1,0],["ماءٌ ومحٌ صار قشرُهما","كنفاً وواقية من الخلل",20,"ل",1,0],["ماءُ وَجهٍ إِذا تَبَلَّجَ أَعطا","كَ أَماناً مِن نَبوَةِ الدَهرِ ماؤُه",21,"ا",3,0],["ماءَنا بِالصاحِبِ الثَقيلِ وَلَن","يَضيقَ بي في المَحَلِّ ماوَسِعَك",22,"ك",1,0],["ماءُ النَّعيمِ على دِيباجِ وَجنتها","يجولُ بين جَنى وردٍ وتُفَّاحِ",23,"ح",1,0],["ماء ضربت الصخر فانبجسا","وجرى الغداة زلاله العذب",24,"ب",1,0],["ماءٌ ونارٌ منايا الأُسْدِ بينهما","ما سُلّ للضرب إلّا سالَ واضطرما",25,"م",2,0],["ماءُ نعماهُ نميرٌ لا صَرىً","وَمُنَدّاهُ خصيبٌ لا وخيم",26,"م",1,0],["ماءُ عقيقٍ إذا ارتدى زبداً","حَسِبتَ دُرّاً مجُوّفاً حَبَبَه",27,"ب",2,0],["ماءَ الفُراتِ وَطيبَ لَيلٍ بارِدٍ","وَسَماعَ مُنشِدَتَينِ لِاِبنِ هِلالِ",28,"ل",1,0],["ماءُ الصَبابَةِ نارُ الشَوقِ تَحدِرُهُ","فَهَل سَمِعتُم بِماءٍ فاضَ مِن نارِ",29,"ر",1,1],["ماءَنا بِالواغِلِ يَوماً عَلى ال","شَربِ وَلا مِثلي بِالوارِشِ",30,"ش",1,1],["ماءٌ مَهينٌ أَعادَهُ عَلَقاً","بِلُطفِهِ ثُمَّ رَدَّهُ مُضَغا",31,"غ",2,0],["ماء العيونِ على الشهيدِ ذرافِ","لو أنّ فيضاً من معينك كافي",32,"ف",2,1],["ماء ولا ريّ يندي في شمائله","كأنّه القول فاتته معانيه",33,"ي",2,0],["ماء الرجال غاية ارتضاعها","يعوي عبيدُ اللَّه من إضباعها",34,"ع",3,0],["ماء قد انعكس الصفاء بوجهه","وصفا فلاح كأنه بَلور",35,"ر",1,0],["ماء زُعاق وجو قاتم وهوى","نَتن وشدة ُ حر غير مُؤتمَن",36,"ن",1,0]]}