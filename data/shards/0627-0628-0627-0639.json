w.poetsgate.com/ViewPoem.aspx?id=205077",""],[5582,"أَلا هَلْ سَرَوْا أَهْلُ العَقِيقِ وَراحُوا","https://www.poetsgate.com/ViewPoem.aspx?id=186793",""],[5582,"أَضَرَّ بِكَ الوَجْدُ لَمَّا تَمادَى","https://www.poetsgate.com/ViewPoem.aspx?id=63488",""],[5628,"رثاء صديق","https://www.poetsgate.com/ViewPoem.aspx?id=178672",""],[5725,"الى حيث لا أدري","https://www.poetsgate.com/ViewPoem.aspx?id=214796",""],[520,"أبا علي وما من حاجة عرضت","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577636",""],[572,"وزائرٍ زَارَ وقد تَعَطَّرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9308&r=&rc=165",""]],"verses":[["أَبا عَلَيٍّ هَل لِأَمثالِها","غَيرُكَ إِن خَطبُ زَمانٍ عَنى",0,"ن",2,0],["أَبَا عَبْدِ اللَّهِ فَدَتْكَ نَفْسٌ","عَلَى مَا حُزْتَ مِنْ فَضْلٍ مُدِلّهْ",1,"ل",2,0],["أَبا عامِرٍ أَينَ ذاكَ الوَفاءُ","إِذِ الدَهرُ وَسنانُ وَالعَيشُ غَضّ",2,"ض",1,0],["أَبا عامِرٍ عَثرَةً فَاِستَقِل","لِتُبرِمَ مِن وُدِّنا ما اِنتَفَض",2,"ض",1,0],["أَبا عَبدِ الاِلَهِ أَصِخ لِقَولي","وَبَعضُ القَولِ يَصحَبُهُ السَدادُ",3,"د",1,1],["أَبا عَمرٍو وَإِن حارَبتَ قَوماً","فَأَنتَ اللَيثُ مُدَّرِعاً جُلالا",4,"ل",2,0],["أبا عُبادةَ ذَرْ ما كنتَ تَنْسُجُهُ","وخذ لنفسك يا مسكينُ في النَّدبِ",5,"ب",1,0],["أبا عليٍّ وظُلماً ما كُنيتَ بها","لقد ضَللْتَ بأَتياهٍ سباريتِ",6,"ت",1,0],["أبا عبد الإله ألا فشُكْراً","فإن الشكر يَتْبَعُهُ المزيدُ",7,"د",1,0],["أبا عليٍّ للناس ألسنةٌ","إن قلت قالوا بها ولم يدعوا",8,"ع",3,1],["أبا عليٍّ طلبتُ عيبك ما اس","طعت فألفيت عيبك السرفا",9,"ف",2,1],["أبا علي وأنت المرء ليس لنا","جار سواه إذا خفنا ولا كنف",10,"ف",1,0],["أبا عثمان أنت عميدُ قومِكْ","وجودُك للعشيرةِ دونَ لَومِكْ",11,"ك",1,1],["أَباعِثَةَ المَطايا مِن حَديدٍ","كَأَسرابِ القَطا لِلعالَمينا",12,"ن",2,1],["أَبا عَزيزٍ سَلامُ اللَهِ لا رُسُلٌ","إِلَيكَ تَحمِلُ تَسليمي وَلا بُرَدُ",13,"د",1,0],["أبا عثمانَ مَعْتَبَةً وظَنّاً","وشافي النُّصْحِ يُعْدَلُ بالأَشَافي",14,"ي",1,1],["أَباعِث كُلِّ مَكرُمَةٍ طُموحُ","وَفارِسَ كُلِّ سَلهَبَةٍ سَبوحِ",15,"ح",1,1],["أَبا عَبدِ الإِلَهِ مُعاذُ إِنّي","خَفِيٌّ عَنكَ في الهَيجا مَقامي",16,"م",2,1],["أَبا عامِرٍ إِنَّ المَعالي وَأَهلَها","يَوَدّونَ وَدّاً أَن يَطولَ بِكَ العُمرُ",17,"ر",1,0],["أَبا عَلِيٍّ يا فَتى الأَشعَرِ","وَاِبنَ فَتاها السَيِّدِ الأَزهَرِ",18,"ر",1,1],["أَبا عَلِيٍّ أَعزِز عَلَيَّ بِما","أَتَتهُ ذاتُ الرِعاثِ النُطَفِ",19,"ف",1,0],["أَبا عيسى وَأَنتَ المَرءُ تَعلو","لَهُ النَفسُ الشَريفَةُ وَالقَبيلُ",20,"ل",1,0],["أَبا عَلِيٍّ عَلَيكَ الفَوتَ إِن ذُكِرَ ال","إِدراكُ مِن طالِبي الأَوتارِ وَالإِحَنِ",21,"ن",1,0],["أَبا عَلِيٍّ لِصَرفِ الدَهرِ وَالغِيَر","وَلِلحَوادِثِ وَالأَيّامِ وَالعِبَرِ",22,"ر",1,1],["أَبا عَلِيٍّ أَنتَ وادي النَدى ال","أَحوى وَمَغنى المَكرُماتِ الأَنيس",23,"س",1,0],["أبا عُبيدَةَ أَوْرِدْها مُظَفَّرَةً","مَوارِدَ النّصرِ تَشفِي كلَّ حَرّانِ",24,"ن",1,0],["أبا عُبَيْدَةَ لولا أن عزمتَ على","قيسٍ لأَمعنَ قيسٌ أيَّ إمعانِ",24,"ن",1,0],["أَبا عَلِيَّ اِبنِ نَصرٍ","وَلَيسَ حَقٌّ كَكِذبِ",25,"ب",1,0],["أَبا عُمَرٍ خَلَّفتَ خَلفَكَ حاجَتي","وَحاجَةُ غَيري بَينَ عَينَيكَ تَبرُقُ",26,"ق",1,0],["أَبا عُمَرٍ ما في طُلابيكَ حاجَةٌ","وَلا في الَّذي مَنَّيتَنا ثُمَّ أَضجَرا",27,"ر",2,1],["أبا عُبيدةَ ما المسؤولُ عن خَبرٍ","يحكيهِ إلا سُؤالاً للذي سألا",28,"ل",2,1],["أَبا عَبْدةٍ إِنَّا عَذَرْناك عِنْدَمَا","رَجَعْنَا وغَادَرْنَاك غَيْرَ ذَمِيمِ",29,"م",1,0],["أبا عمرٍ! وتنهملُ القوافي","على مثواكَ .. بالدمعِ المُراقِ",30,"ق",1,0],["أبا عمرٍ! عهدتُ الوجهَ طلْقا","ووجهُ العيشِ أغبرُ كالفراقِ",30,"ق",1,0],["أُباعِدُ بَينَ مَنّي وَالعَطايا","وَأَجمَعُ بَينَ بَرقي وَاِنسِجامي",31,"م",2,0],["ابا عبدة إنا غدرناك عندما","رجعنا وغادرناك غير ذميم",32,"م",1,0],["أبا عمرٍ ما في طلابيك حاجة ٌ","وَلاَ في الذي منَّيْتَنا ثُمَّ أضْجَر",33,"ر",1,1],["أبا عليٍ سلامٌ كيف أنتَ؟ وهلْ","علِمتَ من بعدِك الأقوامُ كيفَ هم ؟",34,"م",1,0],["أَبَا عَلِيٍّ لَقَدْ طَوَّقَتنِي مِنَناً","طَوْقَ الحَمَامَةِ لا يَبْلَى على القِدَمِ",35,"م",1,0],["أبَا عَليٍّ أعْزِزْ عَليّ بِمَا","أتَتْهُ ذاتُ الرِّعاثِ، وَالنُّطَفِ",36,"ف",1,0],["أبا عزيز سلامُ اللهِ ، رسلٌ","إليك تحمل تسليمي ، ولا بردُ",37,"د",1,0],["أَبا عُثمانَ هَل لَكَ في صَنيعٍ","تُصيبُ الرُشدَ في صِلَتي هُديتا",38,"ت",2,1],["أبا عُمَرٍ عمرت ساحَتاكَ","بغوث اللَّهيف ورعي الذِّمَم",39,"م",1,0],["أبا عبد الإله ووجه ودِّي","مزالٌ عن أسرَّته القِناع",40,"ع",1,1],["أبا عبد الإلهِ ووفدُ ودِّي","لديك ثَوى وليس له زَمَاع",40,"ع",1,0],["أبا عمْرو الأعْلى لعَمْركَ ما المُنى","بِعلْق متاح ما نزحت عن القربِ",41,"ب",1,1],["أَبا عَلِيٍّ أَنتَ جاني ثِمارِ ال","فَضلِ وَالجاني عَلى الوَفرِ",42,"ر",1,0],["أَبا عَلِيٍّ عَداكَ ال","مَخوفُ وَالمَحذورُ",43,"ر",1,0],["أَبا عَلِيٍّ فَرَّقَت بَينَنا","دَهياءُ لا يَعطِفُها مِن عَتَب",44,"ب",1,0],["أَبا عَلِيٍّ فَرَّقَت شَملَنا","حَوادِثُ الدَهرِ وَصَرفُ النُوَب",44,"ب",1,0],["أَبا عَلِيٍّ كُنتُ أَرجوكَ أَن","تَكشِفَ عَن قَلبِ أَبيكَ الكُرَب",44,"ب",1,0],["أَبا عَلِيٍّ كُنتَ لي مُؤنِساً","فَخالَسَتني فيكَ أَيدي الرِيَب",44,"ب",1,0],["أَبَا عِمْرَانَ قَدْ جِئْنَا إِلَيْكُمْ","نُؤَمِّلُ عِنْدَكُمْ حُسْنَ الْمُرَادِ",45,"د",1,1],["أَبا عبدِ الإلهِ فَدتكَ نَفسي","وقَد يفدي مواليه الغلامُ",46,"م",1,0],["أَبا عَزيزٍ أَدامَ اللَهُ دَولَتَكُم","وَزانَكُم بِكَمالِ الفَضلِ وَالرُشدِ",47,"د",1,1],["أَبا عمر أَتيتُك مُستَجيرا","وَلَيسَ عَلى الَّذي يَأتيكَ خَوف",48,"ف",1,0],["أَباعِدُ في زِيِّ الأقاربِ لم يَزَلْ","لها السُّخْطُ منّي نِيّةً والرِّضا فِعْلا",49,"ل",2,0],["أَباعِدُ أملاكٍ إذا ما طرَفْتهم","كأنْ قد أطافتْ منهمُ بي عشائر",50,"ر",1,0],["أبا عَليٍّ شِيَمٌ وَصفُها","تَضعُفُ عَنه قُوَّةُ الحامِلِ",51,"ل",1,0],["أبا عبد الحميد رُفِعتَ قدراً","وقد أُوتِيتَ حِلماً واقتدارا",52,"ر",2,0],["أبا عليّ ولي في مجدكم مدح","في الأفق تجري وقرن الشمس قرن",53,"ن",1,0],["أبا عُمارةَ أنْ شطَّتْ منازلُنا","فمن معاليك إِدْناءٌ وتقريبُ",54,"ب",1,1],["أباعثها مدمنات الحنينِ نواجي","من كلِّ وهدٍ ورعن",55,"ن",1,0],["أَبا عَلِيٍّ عَلِيٌّ لَيسَ يُنصِفُهُ","وَعَدتُهُ فَأَبِن لي فيمَ تُخلِفُهُ",56,"ف",2,1],["أَبا عَلِيٍّ اِعفُ عَنّي فَقَد","ضاقَ فَسيحُ العُذرِ عَن ذَنبي",57,"ب",2,1],["أبا عِمرانَ قد خَلّفتُ قلبي","لَديكَ وأنت أهلُ للوديعه",58,"ه",1,1],["أَبا عُقَيلٍ فَلا تَنحَر بِسادَتِكُم","فَأَنتُم أَنتُم وَالدَهرُ يَنقَلِبُ",59,"ب",1,0],["أبا علي وما من حاجة عرضت","إلى نداك سوى عتبي على كرمك",60,"ك",1,1],["أبا عبدَ الإلَه فِدَاكَ نَفسٌ","بِهَا لاَ يُفتَدَى أحدٌ سِوَاكَا",61,"ك",2,0],["أبا عليٍّ فاحْضُرْنَهُ كيْ تَرى","واكْتُبْ عليّ إنْ كذبْتُ مَحْضَرَا",62,"ر",2,0],["أبا عمارة إن موسَى قد قضَى","بالموتِ أترابٌ له ولدات",63,"ت",1,0],["أبا عيسى أتَينَكَ قارِباتٍ","تَؤُمُّ مَلي حياضِكَ وَهيَ هيمُ",64,"م",1,0],["أبا عُمارةَ لستُ أُضمِرُ فيكم","بَغضا عُمارةَ من بني أيوب",65,"ب",1,0],["أبا علي ألا اسمع","نصيحة ليس تزوى",66,"و",2,0],["أبا عبيدِ اللهِ لي يدٌ","بالشُّرْبِ من حُلْوٍ ولا حامِضِ",67,"ض",1,1],["أبا عيسى ألم ترنا كَفَانا ال","حذارُ عليك مَنْ خَلَقَ الحذارا",68,"ر",2,0],["أبا عليٍّ لك الأخلاقُ نعلمها","مبرَّءاتٍ من الأَقذاءِ والدَّنَسِ",69,"س",1,1],["أبا علي وأبا القاسِم ال","فذَّيْنِ في المَنْظَرِ والمَخْبَر",70,"ر",1,0],["أبا عبد الغني الندب أعظم","به علما عزيز الجار فردا",71,"د",2,0],["اباعرةٌ فكلٌّ ساقَ نهباً","له منه العرارةُ والخيارُ",72,"ر",1,0],["أبا عاذلا فيمن أحب دع العنا","فهيهات أن يسلوا الأحيّة مغرم",73,"م",1,0],["أباعثها مسوّمة عتاقاً","تدافع بِالكماة إلى الزحامِ",74,"م",1,0],["أباعثها للعداةِ شراباً","تدافعنَ بيضاً وسمراً صِعادا",75,"د",2,0],["أبا عَمْروٍ دَعَوْتُكُ في رِجالٍ","فجازَ عَراقِيَ الدّلْوِ الرّشاءُ",76,"ا",2,0],["أَبا عُمرو وَلي نَفَسٌ وَنَفسٌ","تَهادى ذا إِلَيكَ وَذي تَجيشُ",77,"ش",1,1],["أَبا عَمروٍ مَتى تَقضي اللَيالي","بِلُقياكُم وَهُنَّ قَصَصنَ رِيشي",78,"ي",1,1],["أَبا عونٍ لَقَد صَف","فرَ زُوّارُكَ أُذنَيكا",79,"ك",2,1],["أَبا عُمَرِ لا يُبِعْدُ الله هالكاً","فُجعتَ به والقبرُ منزلُة والبُعدِ",80,"د",1,0],["أَبا عمرٍ لله صبرُك فاغتَنمْ","به ما تُرجّي فيه من حَسَنِ الوَعْدِ",80,"د",1,0],["أبا عمر عمّرت وازددتَ رفعةً","مَدى الدَّهر وانقادَتُ إليك أُمورُهُ",81,"ر",2,0],["أبا عمرٍ عُمرت للحقّ عصمةً","يعزّ بها في الناس بادٍ وحاضرُ",82,"ر",1,0],["أبا عمر لازلت في شرف العلى","مَنيعاً سعيدَ الجَدّ ما ناح طائرُ",82,"ر",1,0],["أبا عَبْدِ الألهِ وقد تسامَتْ","لك الأيامُ بالعَجَبِ العجيب",83,"ب",1,0],["أبا علي كلما طال المدى","نور علاك زاد في التشعشع",84,"ع",1,0],["أبا ع