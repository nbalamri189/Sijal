shqas&qid=1723&r=&rc=86",""]],"verses":[["إِنّي قَرَأتُكَ في الكُهولَةِ وَالصِبا","وَمَلَأتُ مِن ثَمَرِ العُقولِ وِطابي",0,"ب",2,0],["إِنّي قَرَأتُ كِتابَهُ","بَينَ الخُشوعِ وَالاِعتِبارِ",1,"ر",1,0],["إن يقلوا عدا فسل في مدى ال","قطبين عنهم جلائل الأعمال",2,"ل",1,0],["إِنْ يَقْضِ اسْمَاعِيلُ عَاصِمْ","هَلْ مِنْ قَضَاءِ اللهِ عَاصِمْ",3,"م",1,1],["إِنْ يقُمْ نَاصِحاً فَنِعْمَ المُرَبِّي","أَوْ يَقُلْ مَازِحاً فَنِعْمَ النَّدِيمُ",4,"م",1,0],["إِنْ يَقْتُلُوكَ فَمَا إنْ عَجَّلُوا أجَلاً","قَدْ كَانَ مُذْ كُنْتَ مَقْدُوراً وَمَحْتُومَا",5,"م",2,0],["أنيقاً حقيقاً أن تكون حِقاقُهُ","من الدرّ لا بل من ثُدِيِّ الكواعبِ",6,"ب",1,0],["أن يقول الوشاةُ بي إنَّ شؤمي","قاد هذا الشُّخُوصَ والإفْكُ حُوبُ",7,"ب",1,0],["أن يُقْتَلوا دون الأمير فدىً له","ومن المكاره نافعُ المرجوع",8,"ع",1,0],["إن يقل بعد عثرة فحقيق","لم يزل مثله ملقَّىً مُوَقَّى",9,"ق",2,0],["إِن يَقبُحِ الحُسنُ إِلّا عِندَ طَلعَتِهِ","فَالعَبدُ يَقبُحُ إِلّا عِندَ سَيِّدِهِ",10,"د",2,0],["إِنّي قَنِعتُ بِخَثعَمٍ وَهيَ الَّتي","لَيسَت مِنَ الأَنسابِ غَيرَ كَفافِ",11,"ف",1,0],["إِن يَقُل زينَةٌ فَحِليَةُ عِقيا","نٍ وَإِن خِفَّةٌ فَفَضُّ عَقيقِ",12,"ق",1,0],["إِن يُقَدِّر لَنا الزَمانُ إِلتقاءً","فَهوَ حُكمي عَلى الزَمانِ وَديني",13,"ن",2,0],["إِن يَقُل واعِداً تُوافِ إِلى النُج","حِ يَداهُ في صَفقَةٍ وَلِسانُه",14,"ن",2,0],["إِن يُقتَلِ النَصرِيُّ تَحتَ لِوائِكُم","فَلَيسَت تَميمٌ بَعدَها بِتَميمِ",15,"م",1,1],["أَنّى قَطَعتِ وَأَنتِ غَيرُ رَجيلَةٍ","عَرضَ الفَلاةِ وَأَينَ مِنكِ المَطلَبُ",16,"ب",1,0],["إِنّي قَتَلتُ مُضَري بِمُضَري","شَفَيتُ نَفسي وَقَتَلتُ مَعشَري",17,"ي",1,0],["أَن يَقتُلوكَ وَقاكَ القَتلَ قادِرُهُ","وَاللَهُ جارُكَ مِمّا أَجمَعَ النَفَرُ",18,"ر",1,0],["إن يقطعوا الرَّحِمَ الرَّؤُومَ فحسبُهم","أنّ ابن عَوْنٍ من ذوي الأرحامِ",19,"م",1,0],["إِنّي قَضَيتُ فَكُلُّ عيدٍ مَأتَمٌ","حَتّى يُظِلَّكِ عيدُكِ المُتَوَقَّعُ",20,"ع",1,0],["إِنْ يَقْطَعِ اللهُ عنه أُمَّةٌ سَفِهَتْ","نُفُوسها فلهَا بالكُفْرٍ تَعْليلُ",21,"ل",1,0],["إِنّي قَصَدتُ إِلى فَقيهٍ عالِمٍ","مُتَنَسِّكٍ حَبرٍ مِنَ الأَحبارِ",22,"ر",1,0],["إِن يَقرُبُ المَوتُ مِنّي","فَلَستُ أَكَرَهُ قُربَه",23,"ب",2,1],["إِن يقتلوني فكم من شاعر قتلوا","أو ينكبوني فكم من عالم نكبوا",24,"ب",3,0],["أَنْ يَقْتَضُوكَ شَمَائِلَ لَمْ تُؤْتَهَا","فَمَطَالِبُ البَاغِينَ شَرًُّ مَطَالِبِ",25,"ب",1,0],["إِنْ يَقولُوا فُحشٌ فَلَسْت أَرَى","أَنَّ فِي صَادِقِ الْهَوَى فحْشا",26,"ش",2,0],["إن يُقْصِني عنكِ الزمانُ وأهْلهُ","فالْحُبُّ عهدٌ بيننا وذِمام",27,"م",1,0],["إنْ يَقُلْ زِينَةٌ، فَحِلْيَةُ عِقْيا","نٍ، وَإنْ خِفّةٌ فَفَصُّ عَقيقٍ",28,"ق",1,0],["أنّى قَنِعْتَ بخَثْعَمٍ، وَهْيَ التي","لَيْسَتْ مِنَ الأسْبابِ غَيرَ كِفَافِ",29,"ف",1,0],["إنيّ قرفتُكِ ناهداً مُتَدَلِّياً","وقرفتُ تلكَ الحَلْمَةَ المتهرِّئهْ",30,"ا",2,0],["إن يقس في نقد الطباع فلم تكن","ترجى لرحمتها يد الجرّاح",31,"ح",1,0],["أنيق الحسن مياس","مليح الخد والقد",32,"د",1,0],["إن يقولوا لهُ","مضَّه حبُهُ",33,"ب",2,0],["ان يقل اني محب فاجل","او سوى هذا اذا قال فلا",34,"ل",2,0],["إن يقل يوماً هنا كان أبي","قلت مجد الشعر فوق النسب",35,"ب",1,0],["إِنّي قَطعتُ مِن الحَياةِ وُرودَها","وَرَمَيتُها في الشاطىء المَتروكِ",36,"ك",1,0],["أَنيقُ القَوافي دَقيقُ المَعاني","يجيدُ الطِباقَ بِهِ وَالجِناسا",37,"س",2,0],["إِنّي قُتِلتُ وَقاتِلي مَن لَم يَشِم","سَيفاً سِوى الطَرفِ الكَحيلِ الأَحوَرِ",38,"ر",1,0],["إِنّي قصَدتُك قصدَ ذي أَمَلٍ","يَرجوكَ في عَلَنٍ وفي سِرِّ",39,"ر",1,0],["أَنّى قسوتِ وَلمْ تعطفْكِ مرحمة","وَقد يلينُ لقولي العارمُ الشرس",40,"س",1,0],["إِنّي قَنِعتُ مِنَ الوِصالِ بِذاكا","وَإِذا سَمَحتُ وَيا سَعادَةَ طالِعي",41,"ي",1,0],["إِن يَقُل أَو يَعُد فَما ثَمَّ إِلّا","صِدقِ قَولٍ وَهِمَّةِ فِعالَه",42,"ل",2,0],["إن يقلّبهُما فحدّث عن الساخر","يشقى بسُخره الخافِقان",43,"ن",1,0],["إنّي قصدتُك يا ابنَ أكرَمِ مَعشرٍ","طَرَفَيْ أُصولٍ في العُلا وفُروع",44,"ع",1,0],["إني قضيت بها الزمان مروَّعاً","أهوى فأهوي في شفير هار",45,"ر",1,0],["إِن يَقتُلوكَ فَإِنّ قَتَلَكَ لَم يَكُن","عاراً عَلَيكَ وَرُبَّ قَتلٍ عارُ",46,"ر",1,0],["إِنّي قَصَدتُك مِن بلاد قَد نأت","وَبعدت عَن أَهلي وَعَن آطامي",47,"م",2,0],["أَنيقَةٍ يَجمَعُ أَرجاؤُها","بيضُ المَقاصيرِ وَبيضُ الأَداحِ",48,"ح",1,0],["إن يقولوا تجنّس","قل لهم لي دين",49,"ن",1,0],["إني قتيل حسامه","سهم الجفون لديه باتر",50,"ر",1,0],["أَن يَقتَضي لي حَظّاً مِن مَكارِمِهِ","يُغري عَلى العَدى مِن أَجلِهِ الحَسَدُ",51,"د",1,0],["أَن يَقتَضي لي مِن إِنعامِهِ خِلَعاً","تَنوبُ عَن مَنطِقي في شُكرِ نِعمَتهُ",52,"ت",2,0],["إنِّي قد اسْتَسْلَمْتُ للحُبِّ بِهِمْ","مهما أَرادوا سادَتي فلْيَصْنَعوا",53,"ع",3,0],["إن يُقَل من فَردُ البَرايا مَزايا","فلإبراهيمَ الأكُفُّ تُشيرُ",54,"ر",1,0],["إِن يَقعُدوا فَوقي بِغَيرِ نَزاهَةٍ","وَعُلوِّ مَرتَبَةٍ وَعِزِّ مَكانِ",55,"ن",1,1],["إن يقل عنا عرته صبوة","صبوة الجهل بها المرء جريح",56,"ح",1,0],["إِنِّي قتلْتُ عليك نفسي حسرةً","ولقد رضيتُ فليتَ شِعْرِيَ هَلْ رضِي",57,"ض",2,0],["إِنّي قصدت حماك أَوّل مَرَّةٍ","فَلَقيت عزّاً زالَ مَعهُ تَذَلُّلي",58,"ل",2,0],["إني قتيل تعاديكم وفرقتكم","وليتني كنت من قتلى فلسطين",59,"ن",1,0],["إن يقربوا سئموا أو يبعدوا عتبوا","واحيرتي بين تبعيد وتقريب",60,"ب",1,0],["إن يُقَلْ مَنظَرٌ فبدرٌ تمام","أو يُقلْ مَخْبَرٌ فليثُ غريف",61,"ف",1,0],["إِن يَقُلْ شَيئاً يُصبْ في قَولِهِ","فَلِهذا قَوله القَولُ الأَصَحُّ",62,"ح",1,0],["أَنّي قَد شَرفت لَمّا وَفَدا","مَرسومُكَ العالي لَكَ الروحُ فِدا",63,"د",2,0],["إِني قَرَأت محكم القانون","وَفيهِ تَحريجٌ عَلى الجُنون",64,"ن",1,0],["إن يَقْرَع الغَىُّ سمعي","لم أستمعْ لو أراشَى",65,"ش",2,1],["إنْ يقطع اللَّهُ من أعدائه طرَفا","فأنت أولُ مقطوعٍ من الطَرفِ",66,"ف",1,0],["أن يقس بالرسل أجمعهم","فهو حقاً خيرهم رجلا",67,"ل",2,0],["إني قصرت على علاك مدايحي","وعلى ودادك قد طويت الأضلعا",68,"ع",2,0],["أني قصدتُ فِناءه","بعداتِ رأيٍ غير فالِ",69,"ل",1,0],["إني قصدتك يا كريم ومن يمل","لسوى علاك يبوء بالإفلاس",70,"س",1,0],["إني قصدتك يا حبيب ومن يلذ","بحماك كيف يخاف عادية المقيم",71,"م",1,0],["أنيق مجاري الخصب والأرض جدبة","شريف رحاب البشر والوقت أقتم",72,"م",1,0],["إِنّي قَنَعتُ بَقوتٍ لا أُجاوِزُه","وَصنُ وَجهي عَن لا لا وَعَن نَعَم",73,"م",1,0],["إني قَصَدْتُ لكي أنعَّ","م في حِماك مع النواعم",74,"م",1,0],["إِن يَقتُلُوكَ أبا حَكِيمٍ غَدرَةً","فَلقد تَشُدُّ فَتَقتلُ الأبطالا",75,"ل",2,1],["إني قريب الع