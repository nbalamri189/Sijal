{"poems":[[86,"شيخان قد خبرا الوجود وأدركا","https://www.aldiwan.net/poem68877.html","الكامل"],[86,"يا كاسي الأخلاق في","https://www.aldiwan.net/poem68899.html","مجزوء الكامل"],[93,"يا لعهد الصبا تقضي وشيكا","https://www.aldiwan.net/poem9159.html","الخفيف"],[93,"إن يقض اسماعيل عاصم","https://www.aldiwan.net/poem11404.html","مجزوء الكامل"],[93,"إن بكى الشرق فالمصاب أليم","https://www.aldiwan.net/poem11409.html","الخفيف"],[93,"أبيت والسيف يعلو الرأس تسليماً","https://www.aldiwan.net/poem11419.html","البسيط"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[51,"عيد يطابق أول الأسبوع","https://www.aldiwan.net/poem65060.html","الكامل"],[51,"نحمد الله حين من وأبقى","https://www.aldiwan.net/poem65511.html","الخفيف"],[43,"وشادن روح من يهواه في يده","https://www.aldiwan.net/poem9560.html","البسيط"],[45,"قد أهدف الغث العمى لو لم يكن","https://www.aldiwan.net/poem65167.html","الكامل"],[45,"ها هو الشيب لائما فأفيقي","https://www.aldiwan.net/poem65182.html","الخفيف"],[45,"أرق العين أن قرة عيني","https://www.aldiwan.net/poem66693.html","الخفيف"],[45,"لاجديد الصبا ولا ريعانه","https://www.aldiwan.net/poem66799.html","البسيط"],[28,"إن يقتل النصري تحت لوائكم","https://www.aldiwan.net/poem5586.html","الطويل"],[2,"شطت أميمة بعدما صقبت","https://www.aldiwan.net/poem25042.html","الكامل"],[58,"إليك أشكو عجري وبجري","https://www.aldiwan.net/poem31065.html","الرجز"],[31,"قف بالديار عفا من أهلها الأثر","https://www.aldiwan.net/poem42547.html","البسيط"],[105,"قل للحسين ولات حين ملام","https://www.aldiwan.net/poem43043.html","الكامل"],[105,"شجن بقلبك يطمئن ويفزع","https://www.aldiwan.net/poem43093.html","الكامل"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[48,"قل للعذول بحانة الخمار","https://www.aldiwan.net/poem63293.html","الكامل"],[46,"إن يقرب الموت مني","https://www.aldiwan.net/poem22148.html","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85575","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54986","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[45,"ها هوَ الشّيبُ لائِماً، فأفيقي","https://www.poetsgate.com/ViewPoem.aspx?id=32844",""],[45,"قَدْ أهدَفَ الغَثُّ العَمَى، لوْ لم يكنْ","https://www.poetsgate.com/ViewPoem.aspx?id=32833",""],[99,"إلى عجوز","https://www.poetsgate.com/ViewPoem.aspx?id=17722",""],[94,"إيه حكيم الدّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66311&r=&rc=29",""],[187,"لقد هاج لي الوجد","https://www.aldiwan.net/poem43978.html","الهزج"],[200,"شفني بعد من","https://www.aldiwan.net/poem45210.html","مجزوء المتدارك"],[211,"صد من أهواه عني وسلا","https://www.aldiwan.net/poem13370.html","الرمل"],[212,"شاعر البحر إلى البحر يعود","https://www.aldiwan.net/poem46604.html","الرمل"],[224,"من أنت يا بنت الألى وجدوك","https://www.aldiwan.net/poem41640.html","الكامل"],[283,"سرى طيف علوة من بانياسا","https://www.aldiwan.net/poem32735.html","المتقارب"],[283,"بي غادة سمراء مثل الأسمر","https://www.aldiwan.net/poem32788.html","الكامل"],[298,"سفرت أميمة ليلة النفر","https://www.aldiwan.net/poem33277.html","أحذ الكامل"],[299,"ردي علي رقادي فهو مختلس","https://www.aldiwan.net/poem36304.html","عموديه"],[321,"يا من بطول الهجر أصبح غادري","https://www.aldiwan.net/poem67095.html","الكامل"],[321,"لا تقل همت في ضياء الغزال","https://www.aldiwan.net/poem67214.html","الخفيف"],[329,"هائم الروح بالهوى والأماني","https://www.aldiwan.net/poem54990.html","الخفيف"],[365,"عدد لكم أن سرت في تشييعي","https://www.aldiwan.net/poem60845.html","الكامل"],[378,"بئس الزمان المرتدي بشرار","https://www.aldiwan.net/poem59431.html","الكامل"],[384,"يا با حسين لو شراة عصابة","https://www.aldiwan.net/poem24190.html","الكامل"],[407,"طيف ألم فزاد في آلامي","https://www.aldiwan.net/poem50127.html","الكامل"],[407,"أرحت نفسي من عداة الملاح","https://www.aldiwan.net/poem50195.html","السريع"],[480,"تونسي وحسبي","https://www.aldiwan.net/poem37610.html","مجزوء الخفيف"],[483,"ظبي خزّ بلحاظه","https://www.aldiwan.net/poem24369.html","عموديه"],[494,"وإن رأى المتناهى من سيادته","https://www.aldiwan.net/poem67397.html","البسيط"],[494,"فإن رأي لا رأي سواءا ولا برح","https://www.aldiwan.net/poem67408.html","البسيط"],[501,"هل بان نعمان وهذا الأجرع","https://www.aldiwan.net/poem37974.html","الرجز"],[539,"حيثما سرت فالمعالي تسير","https://www.aldiwan.net/poem48186.html","عموديه"],[554,"إن يقعدوا فوقي بغير نزاهة","https://www.aldiwan.net/poem68245.html","الكامل"],[559,"حق عيني رؤية الوجه المليح","https://www.aldiwan.net/poem34666.html","الرمل"],[576,"فرطت فيك فلوعتي لا تنقضي","https://www.aldiwan.net/poem2921.html","الكامل"]],"verses":[["إِنّي قَرَأتُكَ في الكُهولَةِ وَالصِبا","وَمَلَأتُ مِن ثَمَرِ العُقولِ وِطابي",0,"ب",2,0],["إِنّي قَرَأتُ كِتابَهُ","بَينَ الخُشوعِ وَالاِعتِبارِ",1,"ر",1,0],["إن يقلوا عدا فسل في مدى ال","قطبين عنهم جلائل الأعمال",2,"ل",1,0],["إِنْ يَقْضِ اسْمَاعِيلُ عَاصِمْ","هَلْ مِنْ قَضَاءِ اللهِ عَاصِمْ",3,"م",1,1],["إِنْ يقُمْ نَاصِحاً فَنِعْمَ المُرَبِّي","أَوْ يَقُلْ مَازِحاً فَنِعْمَ النَّدِيمُ",4,"م",1,0],["إِنْ يَقْتُلُوكَ فَمَا إنْ عَجَّلُوا أجَلاً","قَدْ كَانَ مُذْ كُنْتَ مَقْدُوراً وَمَحْتُومَا",5,"م",2,0],["أنيقاً حقيقاً أن تكون حِقاقُهُ","من الدرّ لا بل من ثُدِيِّ الكواعبِ",6,"ب",1,0],["أن يقول الوشاةُ بي إنَّ شؤمي","قاد هذا الشُّخُوصَ والإفْكُ حُوبُ",7,"ب",1,0],["أن يُقْتَلوا دون الأمير فدىً له","ومن المكاره نافعُ المرجوع",8,"ع",1,0],["إن يقل بعد عثرة فحقيق","لم يزل مثله ملقَّىً مُوَقَّى",9,"ق",2,0],["إِن يَقبُحِ الحُسنُ إِلّا عِندَ طَلعَتِهِ","فَالعَبدُ يَقبُحُ إِلّا عِندَ سَيِّدِهِ",10,"د",2,0],["إِنّي قَنِعتُ بِخَثعَمٍ وَهيَ الَّتي","لَيسَت مِنَ الأَنسابِ غَيرَ كَفافِ",11,"ف",1,0],["إِن يَقُل زينَةٌ فَحِليَةُ عِقيا","نٍ وَإِن خِفَّةٌ فَفَضُّ عَقيقِ",12,"ق",1,0],["إِن يُقَدِّر لَنا الزَمانُ إِلتقاءً","فَهوَ حُكمي عَلى الزَمانِ وَديني",13,"ن",2,0],["إِن يَقُل واعِداً تُوافِ إِلى النُج","حِ يَداهُ في صَفقَةٍ وَلِسانُه",14,"ن",2,0],["إِن يُقتَلِ النَصرِيُّ تَحتَ لِوائِكُم","فَلَيسَت تَميمٌ بَعدَها بِتَميمِ",15,"م",1,1],["أَنّى قَطَعتِ وَأَنتِ غَيرُ رَجيلَةٍ","عَرضَ الفَلاةِ وَأَينَ مِنكِ المَطلَبُ",16,"ب",1,0],["إِنّي قَتَلتُ مُضَري بِمُضَري","شَفَيتُ نَفسي وَقَتَلتُ مَعشَري",17,"ي",1,0],["أَن يَقتُلوكَ وَقاكَ القَتلَ قادِرُهُ","وَاللَهُ جارُكَ مِمّا أَجمَعَ النَفَرُ",18,"ر",1,0],["إن يقطعوا الرَّحِمَ الرَّؤُومَ فحسبُهم","أنّ ابن عَوْنٍ من ذوي الأرحامِ",19,"م",1,0],["إِنّي قَضَيتُ فَكُلُّ عيدٍ مَأتَمٌ","حَتّى يُظِلَّكِ عيدُكِ المُتَوَقَّعُ",20,"ع",1,0],["إِنْ يَقْطَعِ اللهُ عنه أُمَّةٌ سَفِهَتْ","نُفُوسها فلهَا بالكُفْرٍ تَعْليلُ",21,"ل",1,0],["إِنّي قَصَدتُ إِلى فَقيهٍ عالِمٍ","مُتَنَسِّكٍ حَبرٍ مِنَ الأَحبارِ",22,"ر",1,0],["إِن يَقرُبُ المَوتُ مِنّي","فَلَستُ أَكَرَهُ قُربَه",23,"ب",2,1],["إِن يقتلوني فكم من شاعر قتلوا","أو ينكبوني فكم من عالم نكبوا",24,"ب",3,0],["أَنْ يَقْتَضُوكَ شَمَائِلَ لَمْ تُؤْتَهَا","فَمَطَالِبُ البَاغِينَ شَرًُّ مَطَالِبِ",25,"ب",1,0],["إِنْ يَقولُوا فُحشٌ فَلَسْت أَرَى","أَنَّ فِي صَادِقِ الْهَوَى فحْشا",26,"ش",2,0],["إن يُقْصِني عنكِ الزمانُ وأهْلهُ","فالْحُبُّ عهدٌ بيننا وذِمام",27,"م",1,0],["إنْ يَقُلْ زِينَةٌ، فَحِلْيَةُ عِقْيا","نٍ، وَإنْ خِفّةٌ فَفَصُّ عَقيقٍ",28,"ق",1,0],["أنّى قَنِعْتَ بخَثْعَمٍ، وَهْيَ التي","لَيْسَتْ مِنَ الأسْبابِ غَيرَ كِفَافِ",29,"ف",1,0],["إنيّ قرفتُكِ ناهداً مُتَدَلِّياً","وقرفتُ تلكَ الحَلْمَةَ المتهرِّئهْ",30,"ا",2,0],["إن يقس في نقد الطباع فلم تكن","ترجى لرحمتها يد الجرّاح",31,"ح",1,0],["أنيق الحسن مياس","مليح الخد والقد",32,"د",1,0],["إن يقولوا لهُ","مضَّه حبُهُ",33,"ب",2,0],["ان يقل اني محب فاجل","او سوى هذا اذا قال فلا",34,"ل",2,0],["إن يقل يوماً هنا كان أبي","قلت مجد الشعر فوق النسب",35,"ب",1,0],["إِنّي قَطعتُ مِن الحَياةِ وُرودَها","وَرَمَيتُها في الشاطىء المَتروكِ",36,"ك",1,0],["أَنيقُ القَوافي دَقيقُ المَعاني","يجيدُ الطِباقَ بِهِ وَالجِناسا",37,"س",2,0],["إِنّي قُتِلتُ وَقاتِلي مَن لَم يَشِم","سَيفاً سِوى الطَرفِ الكَحيلِ الأَحوَرِ",38,"ر",1,0],["إِنّي قصَدتُك قصدَ ذي أَمَلٍ","يَرجوكَ في عَلَنٍ وفي سِرِّ",39,"ر",1,0],["أَنّى قسوتِ وَلمْ تعطفْكِ مرحمة","وَقد يلينُ لقولي العارمُ الشرس",40,"س",1,0],["إِنّي قَنِعتُ مِنَ الوِصالِ بِذاكا","وَإِذا سَمَحتُ وَيا سَعادَةَ طالِعي",41,"ي",1,0],["إِن يَقُل أَو يَعُد فَما ثَمَّ إِلّا","صِدقِ قَولٍ وَهِمَّةِ فِعالَه",42,"ل",2,0],["إن يقلّبهُما فحدّث عن الساخر","يشقى بسُخره الخافِقان",43,"ن",1,0],["إنّي قصدتُك يا ابنَ أكرَمِ مَعشرٍ","طَرَفَيْ أُصولٍ في العُلا وفُروع",44,"ع",1,0],["إني قضيت بها الزمان مروَّعاً","أهوى فأهوي في شفير هار",45,"ر",1,0],["إِن يَقتُلوكَ فَإِنّ قَتَلَكَ لَم يَكُن","عاراً عَلَيكَ وَرُبَّ قَتلٍ عارُ",46,"ر",1,0],["إِنّي قَصَدتُك مِن بلاد قَد نأت","وَبعدت عَن أَهلي وَعَن آطامي",47,"م",2,0],["أَنيقَةٍ يَجمَعُ أَرجاؤُها","بيضُ المَقاصيرِ وَبيضُ الأَداحِ",48,"ح",1,0],["إن يقولوا تجنّس","قل لهم لي دين",49,"ن",1,0],["إني قتيل حسامه","سهم الجفون لديه باتر",50,"ر",1,0],["أَن يَقتَضي لي حَظّاً مِن مَكارِمِهِ","يُغري عَلى العَدى مِن أَجلِهِ الحَسَدُ",51,"د",1,0],["أَن يَقتَضي لي مِن إِنعامِهِ خِلَعاً","تَنوبُ عَن مَنطِقي في شُكرِ نِعمَتهُ",52,"ت",2,0],["إنِّي قد اسْتَسْلَمْتُ للحُبِّ بِهِمْ","مهما أَرادوا سادَتي فلْيَصْنَعوا",53,"ع",3,0],["إن يُقَل من فَردُ البَرايا مَزايا","فلإبراهيمَ الأكُفُّ تُشيرُ",54,"ر",1,0],["إِن يَقعُدوا فَوقي بِغَيرِ نَزاهَةٍ","وَعُلوِّ مَرتَبَةٍ وَعِزِّ مَكانِ",55,"ن",1,1],["إن يقل عنا عرته صبوة","صبوة الجهل بها المرء جريح",56,"ح",1,0],["إِنِّي قتلْتُ عليك نفسي حسرةً","ولقد رضيتُ فليتَ شِعْرِيَ هَلْ رضِي",57,"ض",2,0]]}