قارب"],[434,"أشاقتك من أطلال ليلى معالم","https://www.aldiwan.net/poem2587.html","الطويل"],[436,"بشير يوم بملك دهر","https://www.aldiwan.net/poem34907.html","مخلع البسيط"],[438,"أريحي الوجا يا ناق ما بعد ذا وجا","https://www.aldiwan.net/poem14299.html","الطويل"],[438,"لقد أكثرت في الترب المراثي","https://www.aldiwan.net/poem14357.html","الوافر"],[451,"يا شعر من ترجو تحسب أنه","https://www.aldiwan.net/poem61226.html","الكامل"],[451,"الأربعون صدى فؤادي الدامي","https://www.aldiwan.net/poem61769.html","الكامل"],[456,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[456,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[456,"قضى دين سعدى طيفها المتأوب","https://www.aldiwan.net/poem56292.html","الطويل"],[459,"عفا الله عنها هل يلم خيالها","https://www.aldiwan.net/poem15086.html","الطويل"],[464,"ألا رب راج حاجة لا ينالها","https://www.aldiwan.net/poem50421.html","الطويل"],[464,"أقول لثور وهو يحلق لمتي","https://www.aldiwan.net/poem50475.html","الطويل"],[466,"ألا رب مله له قامة","https://www.aldiwan.net/poem59562.html","المتقارب"],[466,"ألا رب ضيف تقنصته","https://www.aldiwan.net/poem59725.html","المتقارب"],[466,"ألا رب فتيان كأن وجوههم","https://www.aldiwan.net/poem59742.html","الطويل"],[466,"ألا رب محتال عذل غدا","https://www.aldiwan.net/poem59891.html","المتقارب"],[466,"الأرض أم بناتها الشجر","https://www.aldiwan.net/poem60114.html","المنسرح"],[466,"الأرض تضحك والسماء بضدها","https://www.aldiwan.net/poem60196.html","الكامل"],[466,"ألا رب خمار طرقت تعسفا","https://www.aldiwan.net/poem60225.html","الطويل"],[466,"الأرض تجلى بزهر","https://www.aldiwan.net/poem60512.html","المجتث"],[468,"أيا راكبا إما عرضت فبلغن","https://www.aldiwan.net/poem4800.html","الطويل"],[475,"نوق براهن السرى","https://www.aldiwan.net/poem15219.html","مجزوء الرجز"],[476,"على هذه الأرض","https://www.aldiwan.net/poem9094.html","عموديه"],[497,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[498,"متى يشتفى القلب المقرح يا سعد","https://www.aldiwan.net/poem37664.html","الطويل"],[504,"ألا رب عرض امرىء مسلم","https://www.aldiwan.net/poem2468.html","المتقارب"],[511,"والله لا نظرت عيني إليك ولا","https://www.aldiwan.net/poem67700.html","البسيط"],[512,"نصال من جفونك أم سهام","https://www.aldiwan.net/poem20794.html","الوافر"],[514,"جزى الله أيام الفراق ملامة","https://www.aldiwan.net/poem48613.html","الطويل"],[514,"الا راع قلبي من سلامه ان غدا","https://www.aldiwan.net/poem48730.html","الطويل"],[536,"أمري إلى المولى العلي الشان","https://www.aldiwan.net/poem47924.html","عموديه"],[549,"طريق المعالي عامر لي قيم","https://www.aldiwan.net/poem47237.html","الطويل"],[549,"ألا رب أمر بت أحذر غبه","https://www.aldiwan.net/poem47252.html","الطويل"],[551,"طلائع شيب سير أسرعها رسل","https://www.aldiwan.net/poem68424.html","الطويل"],[582,"يريب علينا الدهر فيسوءنا","https://www.aldiwan.net/poem69390.html","الطويل"]],"verses":[["أَلا رُبَّما أَرقي اللَئيمَ فَيَنثَني","وَأَعضَلَني مَن يَجمَعُ اللُؤمَ وَالجَهلا",0,"ل",2,0],["أَلا رُبَّما حَيّاكَ رِزقُكَ طالِعاً","وَرَحلُكَ مَحطوطٌ وَنِضوُكَ بارِكُ",1,"ك",1,0],["أَلا رُبَّ حَيٍّ مِن رِجالٍ أَعِزَّةٍ","أَسالَت بِهِم مِنكَ الغَمامُ الرَواجِسُ",2,"س",1,0],["أَلا رُبَّ دَوِيَّةٍ خُضتُها","وَقَد قَيَّدَ العَينَ دَيجورُها",3,"ر",3,1],["أَلا رُبَّ صَبٍّ بِحُبِّ العُلى","وَلَيدِ المَطايا رَضيعِ السِفارِ",4,"ر",1,0],["أَلا رُبَّ لَيلٍ قَلقَلَتهُ عَزائِمي","إِلى أَن نَضا عَن مَنكِبَيهِ الغَياهِبا",5,"ب",2,0],["أَلا رُبَّ مَجدٍ قَد ضَرَحتُ قَذاتَهُ","وَكانَ عَلى الأَيّامِ جَمَّ الشَوائِبِ",6,"ب",1,0],["أَلا رُبَّ حالٍ ساعَدَتكَ وَفَتكَةٍ","رَدَدتَ بِها قَرنَ الرَدى وَهوَ أَعضَبُ",7,"ب",1,0],["أَلا رُبَّ يَومٍ قَد أَنَخنا بِدارِهِم","أُقيمُ بِهِم سَيفي وَرُمحي المُقَوَّما",8,"م",2,0],["أَلا رَجُلٌ يَبكي لِشَجوِ أَبي الفَضلِ","بِعَبرَةِ عَينٍ دَمعُها واكِفُ السَجلِ",9,"ل",1,1],["أَلا رُبَّ يَومٍ يا ظَلومُ قَطَعتُهُ","بِمُلهِيَةٍ حَسناءَ يُعظِمُها الشَربُ",10,"ب",1,1],["أَلا رُبَّ طالِبَةٍ وَصلَنا","أَبَينا عَلَيها الَّذي تَطلُبُ",11,"ب",1,0],["الأَرْضُ إِرْثٌ وَالْمَطَامِعُ جَمَّةٌ","كُلَّ يَهَشُّ إلَى الْتَمَاسِ نَصِيبِ",12,"ب",1,0],["أَلا رُبَّ نُصحٍ يُغلَقُ البابُ دونَهُ","وَغِشٍّ إِلى جَنبِ السُرورِ يُقَرِّبُ",13,"ب",1,1],["الأَريَحِيُّ السَمحُ وَالرَحبُ الحِبا","أَضحى حِماهُ مَحَطَّةَ المُجتاحِ",14,"ح",1,0],["أَلّا رَثَيتَ لِمَن يَبيتُ","وَحَشوُ مُقلَتِهِ السُهادُ",15,"د",1,0],["أَلا رُبَّ يَومٍ لَكَ مِنهُنَّ صالِحٌ","وَلا سِيَّما يَومٍ بِدارَةِ جُلجُلِ",16,"ل",1,0],["أَلا رُبَّ خَصمٍ فيكِ أَلوى رَدَدتَهُ","نَصيحٍ عَلى تَعذالِهِ غَيرَ مُؤتَلِ",16,"ل",1,0],["أَلا رُبَّ يَومٍ صالِحٍ قَد شَهِدتُهُ","بِتاذِفَ ذاتِ التَلِّ مِن فَوقِ طَرطَرا",17,"ر",2,0],["أَلا رُبَّ يَومٍ قَد لَهَوتُ بِذلِّهَ","إِذَا مَا أَبُوهَا لَيلَةً غَابَ أَو غَفَل",18,"ل",1,0],["الأرفعين تنبهاً الأبعدين","تنزهاً الأقربين تفضلا",19,"ل",2,0],["الأَروعَ المِقْدَامَ فِي ذيادِهِ","عَنْ قَوْمِهِ وَالورعَ التقيَّا",20,"ي",2,0],["ألأريحية ذخره","ومكارم الأخلاق زاده",21,"د",2,0],["أَلا رُبَّ مَن قَلبي لَهُ اللَهُ ناصِحٌ","وَمَن قَلبُهُ لي في الظِباءُ السَوانِحُ",22,"ح",1,1],["أَلا رُبَّ هَمٍّ طارِقٍ قَد قَرَيتُهُ","مُواكِبَةً يَنضو الرِعانَ ذَميلُها",23,"ل",3,0],["أَلا رُبَّ ضَيفٍ لَيسَ بِالضَيفِ لَم يَكُن","لِيَنزِلَ إِلّا بِامرِئٍ غَيرِ زُمَّلِ",24,"ل",1,0],["أَلا رُبَّ خَصمٍ مُترَفٍ قَد كَبَتُّهُ","وَإِن كانَ أَلوى يُشبِهُ الحَقَّ باطِلُه",25,"ل",2,0],["أَلا رُبَّ مَن يَهوى وَفاتي وَلو دَنَت","وَفاتي لَذَلَّت لِلعَدُوِّ مَراتِبُه",26,"ب",2,0],["الأرض مسجدنا ففيم مساجد","أمست تعدّ اليوم بالآلاف",27,"ف",1,0],["ألاّ ربّ شرّ جرّ خيرا وربما","يجُرّ تجافينا الينا التصافيا",28,"ي",2,0],["ألا ربّ شيطان من الأنس قد غدا","يُخاتلني خَلساً وعيني تراقبه",29,"ب",2,0],["ألا ربّ شاك قال لي وهو آسف","أما آن للتهذيب أن يتبغددا",30,"د",2,0],["ألا رب حرّ شاهد الحكم جائراً","يقود بنا قَوْد الذَلول المعبَّد",31,"د",1,0],["أَلا رُبَّما هاجَ التَذَكُّرُ وَالهَوى","بِتَلعَةَ إِرشاشَ الدُموعِ السَواجِمِ",32,"م",1,0],["أَلا رُبَّ قَومٍ قَد وَفَدنا عَلَيهِمُ","بِصُمِّ القَنا وَالمُقرَباتِ الصَلادِمِ",32,"م",1,0],["أَلا رُبَّما لَم نُعطِ زيقاً بِحُكمِهِ","وَأَدّى إِلَينا الحُكمَ وَالغُلُّ لازِبُ",33,"ب",1,0],["أَلا رُبَّ جَبّارٍ وَطِئنَ جَبينَهُ","صَريعاً وَنَهبٍ قَد حَوَينَ إِلى نَهبِ",34,"ب",1,0],["أَلا رُبَّ سامي الطَرفِ مِن آلِ مازِنٍ","إِذا شَمَّرَت عَن ساقِها الحَربُ شَمَّرا",35,"ر",2,0],["أَلا رُبَّ أَعشى ظالِمٍ مُتَخَمِّطٍ","جَعَلتُ لِعَينَيهِ جِلاءً فَأَبصَرا",35,"ر",2,0],["أَلا رُبَّما باتَ الفَرَزدَقُ قائِماً","عَلى حَرِّ نارٍ تَترُكُ الوَجهَ أَسفَعا",36,"ع",2,0],["أَلا رُبَّ جَبّارٍ عَلَيهِ مَهابَةٌ","سَقَيناهُ كَأسَ المَوتِ حَتّى تَضَلَّعا",36,"ع",2,0],["أَلا رُبَّما فَدّى بُكوراً فَوارِسي","بِأُمّيهِ مَلهوفُ الفُؤادِ مَروعُ",37,"ع",1,0],["أَلا رُبَّ عاصٍ ظالِمٍ قَد تَرَكتَهُ","لِأَوداجِهِ المُستَنزِفاتِ شَهيقُ",38,"ق",1,0],["أَلا رُبَّ جَبّارٍ سَلَبناهُ تاجَهُ","فَأَصبَحَ فينا عانِياً يَشتَكي الكَبلا",39,"ل",2,0],["أَلا رُبَّ جَبّارٍ حَمَلتَ عَلى العَصا","وَبابُ اِستِهِ عَن مِنبَرِ المُلكِ زائِلُ",40,"ل",1,0],["أَلا رُبَّ يَومٍ قَد شَرِبتُ بِمَشرَبٍ","سَقى الغَيمَ لَم يَشرَب بِهِ أَحَدٌ قَبلي",41,"ي",1,0],["أَلا رُبَّ يَومٍ قَد أُتيحَ لَكَ الصِبا","بِذي السِدرِ بَينَ الصُلبِ فَالمُتَثَلَّمِ",42,"م",1,1],["أَلا رُبَّ يَومٍ قَد أَثابَت رِماحُنا","بِبُؤسى وَقَومٍ آخَرينَ بِأَنعُمِ",42,"م",1,0],["ألا رُبَّ ليلٍ قد حمى فيه من وغى","حمى الشام والأجفان غافلة تكرى",43,"ر",2,0],["ألا رب يوم والظبا حول دارها","تصف على أيدي الكماة وتزهر",44,"ر",1,1],["ألا ربّ ذي ظلم كمنت لحربه","فأوقعه المقدار أيّ وقوع",45,"ع",1,1],["ألا رُبَّ أحبابٍ شغلت بحبّهم","زمان إلى أن غيَّروا بيننا الصّفه",46,"ه",1,1],["الأرض واسعة بجدوَى ملكهم","والعدل في أيامه متوثق",47,"ق",1,0],["ألا ربَّ ليلٍ واعدت فيه بالجفا","ويا ويحَ روحي إن جفتها وويلها",48,"ه",2,1],["ألا رُبَّ شأوٍ رامه فتسهَّلت","رباه وصعبٍ راضه فتذلَّلا",49,"ل",2,0],["ألا رُبَّ أشياءَ مذكورةٍ","يُحدَّثُ عنها وليستْ تُرى",50,"ر",2,1],["ألا رُبَّ نارٍ بالفضاء اصطليتُها","منَ الشَّمسِ يودي لَفْحُهَا بالحواجبِ",51,"ب",1,0],["ألا رُبَّ غِرٍّ باعك النومَ لَيْلَهُ","وراقبَ ضوء الفجر حتى تبلّجا",52,"ج",2,0],["ألا رُبَّ عين دنت منهمُ","فمدُّوا لها ليلها سرمدا",53,"د",2,0],["ألا ربما سؤتُ الغيورَ وساءني","وبات كلانا من أخيه على وحرِ",54,"ر",1,1],["الأرضُ في أفعالها مضطرةٌ","والحيُّ فيه تصرّفُ المختارِ",55,"ر",1,0],["ألا رُبما قَصَّرتُ في مدح ماجدٍ","وفزتُ بسَجْل من نداه غزير",56,"ر",1,0],["الأرذلون بغبطةٍ وسعادةٍ","والأمْجدون قلوبهم تتفطر",57,"ر",1,0],["ألا رُب قول قلتَهُ يا ابن طاهرٍ","أصاختْ له بعد الهدير قَناعسه",58,"س",2,0],["الأرضُ تنقصُ من أطرافها أبداً","لكن كنيزة طولَ الدهر تتَّسعُ",59,"ع",1,1],["ألا رُبَّ قولٍ فيه أمكن قائلاً","ولو رامه في غيره ظلّ يكْعَمُ",60,"م",1,0],["ألا ربما قبلتَ أيراً مُعَمّماً","بِجِعْرِك فاحفظ فيَّ حقَّ المعمَّمِ",61,"م",1,0],["الأرض تُنبتُ كلَّ حينٍ نبتها","ولها جميمٌ تارةً وهشيمُ",62,"م",1,0],["إلا رأيتُ من الشقاءِ كأنني","أُثنَى وأُكْبحُ دونه بلجامِ",63,"م",1,0],["ألا رُبَّ أيام سَحَبْتُ ذُيولَها","سليماً من الأرزاء أملسَ كالزُّلمْ",64,"م",1,0],["أَلا رُبَّ مَن يَخشى نَوائِبَ قَومِهِ","وَرَيبُ المَنايا سابِقاتٌ بِهِ الفِعلا",65,"ل",2,0],["أَلا رُبَّ غِرٍّ خامَرَ الشَكُّ نَفسَهُ","فَلَمّا رَآني أَبصَرَ البَحرَ مُزبَدا",66,"د",2,0],["الأَرضُ سورِيّا أَحَبُّ رُبوعِها","عِندي وَلُبنانُ أَعَزُ جِبالِها",67,"ل",3,0],["الأَربَعونَ لَوَ اِنَّها تَتَكَلَّمُ","لَرَوَت لَنا قِصَصَ العَظائِمِ عَنكُمُ",68,"م",1,1],["الأَرضُ لِلحَشَراتِ تَزحَفُ فَوقَها","وَالجَوُّ لِلبازي وَلِلشاهينِ",69,"ن",1,0],["الأَرمَنِيُّ عَلى سُفوحي وَالرُبى","يَبني الحُصونَ لِنَفسِهِ بِحُصوني",69,"ي",1,0],["الأَرضُ تَستَجدي الخِضَمَّ مِياهَهُ","وَكُنوزَهُ وَالبَحرُ يَستَجديهِ",70,"ي",2,0],["إلاَّ رياحي فهيَ جامِحَةٌ","تَمَرُّدُهَا عَصيبْ",71,"ب",1,0],["أَلا رُبَّ رَكبٍ قَد وَقَفتُ مَطِيَّهُم","عَلَيكِ وَلَولا أَنتِ لَم يَقِفِ الرَكبُ",72,"ب",1,0],["الارض والشمس والاقدار قاطبة","لم تنج واحدة منها من التهم",73,"م",1,0],["الارض امّ للنبات جميعه","ولها من الماء القراح لبان",74,"ن",1,0],["الأَرضُ حولك والسماءُ اهتزَّت","لروائع الآياتِ والآثار",75,"ر",1,0],["الأرض فوقك مأتم","جيب الفضيلة فيه شُقا",76,"ق",2,0],["الأَرضُ في أَكنافِ هَذا أَجدَبَت","وَذا أَزاحَ الجَدب عَنها وَكَفى",77,"ا",1,0],["الأَرضُ حَولَكَ وَالسَماءُ اِهتَزَّتا","لِرَوائِعِ الآياتِ وَالآثارِ",78,"ر",1,0],["الأَرضُ أَليَقُ مَنزِلاً بِجَماعَةٍ","يَبغونَ أَسبابَ السَماءِ قُعودا",79,"د",2,0],["الأرض أمٌ برةٌ","فيها طبائع أربع",80,"ع",1,1],["أَلا رُبَّما كَأسٍ سَقاني سُلافَها","رَهيفُ التَثَنّي واضِحُ الثَغرِ أَشنَبُ",81,"ب",1,0],["الأَرضُ أَوسَعُ مِن دارٍ أُلِطُّ بِها","وَالناسُ أَكثَرُ مِن خِلٍّ أُجاذِبُهُ",82,"ب",2,0],["أَلا رُبَّما يَومٍ مِنَ الراحِ رَدَّ لي","شَبابِيَ مَوفوراً وَغَيِّ مُذَمَّما",83,"م",2,0],["أَلا رُبَّما إِن حالَ لُقمانَ دونَها","تَرَبَّعَ بَينَ الأَروَتَينِ أَميرُها",84,"ر",3,0],["أَلا رُبَّ يَومٍ داجِنِ اللَيلِ كاسِفٍ","تَراهُ مِنَ التَأجيجِ وَالرَهجِ مُظلِما",85,"م",2,0],["إلا رأى الرَّاياتِ تَخفُقُ حولَه","ورأى الوَشيجَ مُخَضَّبَ الأطرافِ",86,"ف",1,0],["أَلا رُبَّ لَيلٍ بِتُّ أرعى نُجومَه","فلم أغتَمِضْ فيه ولا اللَّيلُ أغمَضا",87,"ض",2,1],["أَلا رُبَّما غَرَّ ابنَ آدَمَ أَنَّهُ","لَهُ مُدَّةٌ تَخفى عَلَيهِ وَميقاتُ",88,"ت",1,0],["أَلا رُبَّ ذي طِمرٍ غَدا في كَرامَةٍ","وَمِلكٍ بِتيجانِ الخُلودِ مُتَوَّجُ",89,"ج",1,0],["أَلا رُبَّ ذي أَجَلٍ قَد حَضَر","كَثيرِ التَمَنّي قَليلِ الحَذَر",90,"ر",1,1],["أَلا رُبَّ ذي طِمرَينِ في مَجلِسٍ غَدا","زَرابِيُّهُ مَبثوثَةٌ وَنَمارِقُه",91,"ق",2,0],["أَلا رُبَّ أَحزانٍ شَجاني طُروقُها","فَسَكَّنتُ نَفسي حينَ هَمَّ خُفوقُها",92,"ق",3,1],["أَلا رُبَّ أَسبابٍ إِلى الخَيرِ سَهلَةٌ","وَلِلشَرِّ أَسبابٌ وَهُنَّ حُزونُ",93,"ن",1,0],["أَلا رُبَّ آمالٍ إِذا قيلَ قَد دَنَت","رَأَيتَ صُروفَ الدَهرِ قَد حُلنَ دونَها",94,"ن",3,0],["أَلا رُبَّ ذي عَينَينِ لا تَنفَعانِهِ","وَهَل تَنفَعُ العَينانِ مَن قَلبُهُ أَعمى",95,"م",2,0],["أَلا رُبَّ ذي طِمرٍ غَدا في كَرامَةٍ","وَمَلكٍ بِتيجانِ الهَوانِ مُتَوَّجُ",96,"ج",1,0],["ألا رقىً للأباظيين تحفظهم","على الحوادث من أنظار حساد",97,"د",1,0],["ألا ربّ كأسٍ تقتْضي كلَّ لَذّةٍ","أكلْتُمْ عليها طولَ ليلكمُ لحمي",98,"ي",1,1],["إِلّا رَأَينا ذا عَلى تِلكَ الرَحا","قُطباً وَذا مِصباحَ ذاكَ المَشهَدِ",99,"د",1,0],["أَلا رُزِئَت خُراسانَ فَتاها","غَداةَ ثَوى عُمَيرُ بنُ الوَليدِ",100,"د",1,0],["أَلا رُزِئتَ بِمَسؤولٍ مُنيلٍ","أَلا رُزِئتَ بِمِتلافٍ مُفيدِ",100,"د",1,0],["أَلا رُبَّ لَيْلٍ قَصَّرَ اللَّهْوُ طُولَهُ","بِهَيْفَاءَ مِثْلِ الْغُصْنِ بَيِّنَةِ السَّرْوِ",101,"و",1,0],["ألا رُبَّ طبّاخٍ مليحٍ تقولُ لي","يداهُ وعيناهُ مقالاً مسلَّما",102,"م",2,1],["أَلا رُبَّ رَأسٍ لا تَزاوُرَ بَينَهُ","وَبَينَ أَخيهِ وَالمَزارُ قَريبُ",103,"ب",1,1],["أَلا رُبَّ يَومٍ حَثَّتِ الكاسُ خَطوَهُ","فَطارَ وَأَيّامُ السُرورِ قِصارُ",104,"ر",1,1],["أَلا رُبَّ يَومٍ لي بِبابِ الزَخارِفِ","رَقيقِ حَواشي الحُسنِ حُلوِ المَراشِفِ",105,"ف",1,1],["الأرضُ حَيرَى ما يزالُ هُداتُها","في غَمْرَةٍ وكأنّهم عُميانُ",106,"ن",1,0],["الأرضُ ميراثُ القَويِّ فإنْ مَضَى","يبغي الزيادةَ فالسّماءُ المظهرُ",107,"ر",1,0],["الأرضُ حولك مَعرِضٌ لك جانبٌ","منه وللأدبِ المُفضَّلِ جانِبُ",108,"ب",1,0],["الأرضُ وَلْهَى والممالكُ رُجَّفٌ","والنّاسُ حَربٌ والزّمانُ خِصامُ",109,"م",1,0],["ألا ردّدوا الأنباءَ عن فوز ماهرِ","فيا لكَ من فوزٍ على الخصمِ باهرِ",110,"ر",1,1],["الأَرضُ فَوضى وَالمَمالِكُ فَوقَها","شَتّى فَمِنها جَنَّةٌ وَسَعيرُ",111,"ر",1,0],["أَلا رُبَّما قامَت قِيامَةُ مَعشَرٍ","وَلَمّا يَضُمُّ الناسَ بَعثٌ وَلا حَشرُ",112,"ر",1,0],["أَلا راحِمٌ هَل مِن شَفيعٍ أَما كَفى","أَكُلُّ بَني الدُنيا عَدُوٌّ يُغاضِبُه",113,"ب",2,0],["الأَرضُ أَرضُكِ وَالسَماءُ حَليفَةٌ","لَكِ وَاللَيالي وَالوَرى خُدّامُ",114,"م",1,0],["ألا رُبَّ يومٍ ذُقْتَ من سُوءِ ما جَنَى","ذَوُو الشِّرْكِ فيه ما يَشُقُّ المرائرا",115,"ر",2,0],["الأرضُ واسعةُ الجوانبِ حولهم","ما مسَّ منها عامراً أو خاليا",116,"ي",2,0],["الأرضُ ترجف رُعباً والسماءُ بها","غيظٌ يظلّ على الكُفّار يحتدمُ",117,"م",1,0],["الأَرضُ قَد لَبِسَت رِداءً أَخضَرا","وَالطَلُّ يَنثُرُ في رُباها جَوهَرا",118,"ر",2,1],["أَلا رُبَّ يَومٍ قَد لَبِستُ ظِلالَهُ","كَما أَغمَدَ القَينُ الحُسامَ اليَمانِيا",119,"ي",2,0],["أَلا رُبَّ حالٍ قَد تَحَوَّلَ بُؤسُها","وَما الدَهرُ إِلّا نَبوَةٌ وَسُكونُ",120,"ن",1,0],["أَلا رُبَّ حِلمٍ عادَ رِقّاً وَذِلَّةً","وَجَهلٍ بِهِ مُعطيكَ ذو الجَهلِ ما تَرضى",121,"ض",2,0],["أَلا رُبَّ وَجهٍ في الثَرى كانَ عابِساً","إِذا خِفتُ بَطشاً مِن يَدِ الدَهرِ أَو غَمزا",122,"ز",2,0],["أَلا رُبَّ كَأسٍ قَد سَبَقتُ لِشُربِها","صَباحاً كَبازٍ هَمَّ بِالنَهضِ أَقمَرِ",123,"ر",1,0],["أَلا رُبَّ يَومٍ بِالدُوَيرَةِ صالِحٍ","فَكَيفَ بِيَومٍ بَعدَهُ لِيَ فاسِدِ",124,"د",1,1],["أَلا رُبَّ يَومٍ قَد سَراهُ مُجاهِدٌ","فَأَغرى مَطايا الفَرشِ وَاِستَمهَدَ السَرجا",125,"ج",2,0],["أَلا رُبَّ دَسّاسٍ إِلى الكَيدِ حامِلٍ","ضِبابَ حُقودٍ قَد عَرَفتُ وَدارَيتُ",126,"ت",1,0],["أَلا رُبَّ يَومٍ لي قَصيرٍ نَهارُهُ","كَسَلَّةِ سَيفٍ أَو كَرَجمَةِ كَوكَبِ",127,"ب",1,1],["أَلا رُبَّ يَومٍ لَها لا يُذَمُّ","أَراقَت دَماً وَأَغابَت سَغَب",128,"ب",1,0],["أَلا رُبَّ يَومٍ قَد كَسَوكُم عَمائِماً","مِنَ الضَربِ في الهاماتِ حُمرُ الذَوائِبِ",129,"ب",1,0],["أَلا رُبّما زادَ الحَبيبُ مَلاحَةً","إذَا شُقَّ عنه الدِّرْعُ وَانتَثَرَ العِقْدُ",130,"د",1,0],["الأريحيُّ فما يعطي سوى أملٍ","والهبزريُّ فما يردي سوى بطل",131,"ل",1,0],["ألا رُبَّ عانٍ في يديك مُصَفَّدٍ","شكتْ ذِفرَياه القِدَّ حتى اشتكى القِدُّ",132,"د",1,0],["أَلا رُبَّ مَشغوفٍ بِنا لا يَنالُنا","وَآخَرُ قَد نَشفى بِهِ يَتَباعَدُ",133,"د",1,0],["أَلا رَحِمتَ صَريعاً","تَحتَ الرَدى وَظِلالِه",134,"ل",2,0],["الأَرضُ مُظلِمَةٌ وَالنارُ مُشرِقَةٌ","وَالنارُ مَعبودَةٌ مُذ كانَتِ النارُ",135,"ر",1,1],["أَلا راعَهُ صَوتُ الأَذينِ وَما هَجَد","وَما ذاكَ إِلّا ذِكرُ مَن ذِكرُهُ كَمَد",136,"د",1,1],["الأَرضُ لِلَّهِ ما اِستَحيا الحُلولُ بِها","أَن يَدَّعوها وَهُم في الدارِ أَضيافُ",137,"ف",1,1],["الأَرضُ دارُ اِهتِضامٍ وَالأَنامُ بِها","مِثلُ الذِئابِ فَأَحرِز دونَهُم حَمَلَك",138,"ك",1,0],["أَلا رُبَّ يَومٍ لَو سَقِمتُ لَعادَني","نِساءٌ كِرامٌ مِن حُيَيٍّ وَمالِكِ",139,"ك",1,0],["أَلا رُبَّ حَيٍّ قَد رَأَينا هُنالِكُم","لَهُم سَلَفٌ تَزوَرُّ مِنهُ المَقانِبُ",140,"ب",1,0],["الأَرضُ تَركُضُ بِالشُعوبِ حَثيثَةً","فَاِمشي عَلى آثارِها وَتَرَسَّمي",141,"م",2,0],["الأرض تشرب منها","وَلا تبل أواما",142,"م",2,0],["الأرض تقصف كالمدافع تحتهم","وَالجو يلمع باللَهيب القاني",143,"ن",2,0],["الأرض تَحتَ المرء يَغلي جأَشها","وَينام ملء العين في اطمئنان",143,"ن",1,0],["الأرض من سخط السما","ءِ بالغت في الجزع",144,"ع",1,0],["إلا رجاء ثواب","أو خشية من عقاب",145,"ب",1,0],["الأرض معترك ما إِن يَفوز به","إِلّا الَّذي هو لا يَخشى من العطب",146,"ب",1,0],["الأرض لَيسَت بدار","فيها الحقوق تصان",147,"ن",1,0],["الأرض تضمر ناراً","وَالنار تضمر شرا",147,"ر",2,0],["الأَرض للشمس بنت","وَالشمس بنت الفضاء",147,"ا",2,0],["ألا رعى اللَه أَوطاناً لنا امتهنت","محبوبة السهل والوديان والكثب",148,"ب",1,0],["الأرض بالإنسان تك","سب بهجةً وتنال سعدا",149,"د",2,0],["الأرضُ من أقطارها راجفه","كأنما طافَ عليها المنونْ",150,"ن",1,0],["الأرضُ تعرفهُ وتشهدُ أنه","سيلٌ إذا لمعَ الحديدُ وقشعمُ",151,"م",1,0],["الأرزُ فيهِ والنخيلُ كلاهُما","أعشاشُ حبٍّ أو خمائلُ شادي",152,"ي",1,0],["الأرضُ من أجسادِ من قُتِلوا بها","تَجْني العذابَ وتُنْبِتُ الأحقادا",153,"د",2,0],["أَلا رُبَّ مَكْرُوبٍ أَجَبْتَ ونائِلٍ","بَذَلْتَ ومَعْرُوفٍ لَدَيْكَ ومُنْكَرِ",154,"ر",1,0],["ألا رب أعداءٍ غذاهم فأذعنوا","فعاد وهم فيما لديه عيال",155,"ل",1,0],["ألا رُبّما باتَتْ تُحَرِّقُ كُورَها","ذُيولُ بُروقٍ بالعِراقَيْنِ لُمَّع",156,"ع",1,0],["الأرض شتى والبيان مؤتلفْ","كالراح دارت في إناء مختلفْ",157,"ف",1,0],["أَلا رُبَّ خَصمٍ قد كفيت وكُرْبةٍ","كشفْتُ ودارٍ كُنْتُ في المحْلِ وبلُهَا",158,"ل",3,0],["أَلا رُبَّ يَوْمٍ كَانَ تَارِيخَ صَبْوَةٍ","مَضَى غَيْرَ إِثْرٍ فِي الْمَخِيلَةِ أَوْ ذِكْرِ",159,"ر",1,0],["أَلا رَعْدَ هَدَّادٌ أَلا بَرْقَ خَاطِفٌ","أَلا عَارِضٌ تَجْرِي الرُّبَى فِي اشْتِدَادِهِ",160,"د",2,0],["أَلأَرْزُ يَرْمُزُ أَنْ يَكُو","نَ العَيْشُ لِلفَارُوقِ خُلْدَا",161,"د",2,0],["الأرض أطهر والمحارث من","عيش على أدرانه الدر",162,"ر",1,0],["الأَرضُ تَضحَكُ لِلسّماءِ إِذا بَكَت","وَأَراهُما بَكيا مَعاً لبُكائي",163,"ا",2,0],["أَلا رُبَّ يَومٍ قَد لَهَوتُ بِذلِّهَا","إِذَا مَا أَبُوهَا لَيلَةً غَابَ أَو غَفَل",164,"ل",1,0],["ألا رُبَّ ذي طمرين في منزلٍ غَدا","زرابيُّهُ مبثوثَةٌ ونمارِقُه",165,"ه",1,1],["الأرْزُ فيك ونخلُ مصرَ كلاهما","أخَوانِ في الأتراح والأفراح",166,"ح",1,0],["الأرْضُ أنَّى خَطَوْت تِبْرُ","وزَهْرُها جَوْهَرٌ ودُرُّ",167,"ر",1,0],["ألا رافقتك السلامة أنَّى","ذهبت، وأني نويت الإِيابا",168,"ب",2,0],["الأرضُ تنكرُهم بها","والريحُ، والغيثُ الهَتون",169,"ن",1,0],["الأرض تجذب كل شيء فوقها","فإذا رأته، حاولت أن تنفرا",170,"ر",2,0],["الأَرضُ للزُّرَّاع، لا","للوَارثينَ عن الجدوُد",171,"د",1,0],["ألاَ رُبَّ يومٍ فيه قد كان وارفًا","وكان دقيق الحس، أخضر نامِيا",172,"ي",2,0],["ألا رُبّ ذي ضَيْمٍ غَدا في كَرامَة ٍ،","ومُلْكٍ، وتيجانِ الخُلُودِ مُتَوَّجُ",173,"ج",1,0],["ألاربَّ يومٍ قد لهوتُ بدَلَّها","إذا ما أبوها ليلةً غاب أو غَفَلْ",174,"ل",1,0],["ألا ربّ نارٍ بالفضاءِ اصطليتُها","من الضِّحِ يودي لَفْحُهَا بالحواجبِ",175,"ب",1,0],["ألا رُبَّ لاحٍ لو بلا الحبّ لم يَلُمْ","ولكنته من سورة الحب جاهل",176,"ل",1,0],["ألاّ ربَّ يومٍ قد أنخنا بدراهم","أقيمُ بهمْ سيفي ورُمحي المقومَّا",177,"م",2,0],["إلا رجال الغيب أصحاب الحمى","أهل الهدى للحائر المتواله",178,"ل",2,0],["الأرضُ دُونَكَ يا طهَ مُعَطَّلَةٌ","عَقِيمةٌ، أنتَ فيها الفارسُ البَطَلُ",179,"ل",1,0],["ألا رب ملكٍ قد أقمتن ضلة","وللظلم فيه زخرة وعباب",180,"ب",1,0],["أَلا رُبَّ دارٍ قَد تَحمَّلَ أَهلُها","فَأَضحَت قِفاراً وَالبِقاعُ تِلالا",181,"ل",2,0],["ألا ربَّ ساعٍ في مَداك كَبتْ به","مطاياه أو قالت له رِجلُه عَثْرا",182,"ر",2,0],["الأرضُ دارُك والأيامُ تُنفقها","على بقائك والأملاكُ كالخَوَلِ",183,"ل",1,0],["ألا ربما قد كان في عهد تبع","لآبائه الماضيين أباؤكم سبيا",184,"ي",2,0],["الا ربما كان الجهول بجهله","على نفسه مما يحاربه اسطا",185,"ط",2,0],["إلا رجالا صانعوا من دونه","في الله ذي الإِفضال والإِنعام",186,"م",1,0],["ألا ربّ مولىً غرَّني من عُهودِهِ","يمينٌ علَيْها صافَحَتْني يَمينُهُ",187,"ه",1,1],["الأَروَعَ النَدبَ السَرِيِّ العالِمَ ال","حبرَ الجَرِيَّ السَيِّدَ البهلُولا",188,"ل",2,0],["أَلا رَحَلَت نُعمٌ وَأَقفَرَ نعمانُ","فَبُح بِاِسمِها إِن عَزَّ صَبرٌ وَسُلوانُ",189,"ن",1,1],["أَلاَ رُبَّما عَزَّتْ عَلَى الْحازِمِ الَّذِي","تَرَاهَا بِكَفَّيْهِ فَرِيسَةَ طالِبِ",190,"ب",1,0],["أَلاّ رُبَّمَا أَهدَى لِيَ الشَّوقَ وَالجَوَى","عَلى النَّأىِ مِنهَا ذُكرَةٌ قَلَّمَا تُجدِى",191,"د",2,0],["إِلّا رِياحَ الجورِ تَكْ","سَحُ وَجهَها كَسحَ المَكانِسْ",192,"س",1,0],["ألا ربّ ليل يسأم الناس طولهُ","قرى متنه عندي نعيم وزخرف",193,"ف",1,0],["ألا رب راجي حاجة لا ينالها","وآخر قد تقضى له وهو جالس",194,"س",1,1],["الأرض تنفعها العماره","والثوب تصلحه القصاره",195,"ر",2,1],["أَلا رُبَّ أَعداءٍ لِئامٍ قَرَيتُهُم","مُتونَ سُيوفٍ أَو صُدورَ عَوالي",196,"ي",1,1],["أَلا رُبَّ لَهوٍ آنِسٍ وَلَذاذَةٍ","مِنَ العَيشِ يَغبيهِ الحَياءُ المُسَتَّرُ",197,"ر",1,1],["إِلّا رَواسِيَ كُلُّهُنَّ قَد اِصطَلى","حَمراءَ أَشعَلَ أَهلُها إيقادَها",198,"د",3,0],["الأرضُ ترجفُ والسما مغبَرّةٌ","وبكل ناحيةٍ ترى شَيطانا",199,"ن",2,0],["الأريحيُّ إلى السماحةِ مثلما","يرتاحُ للماءِ المروَّقِ صادي",200,"د",2,0],["الأرضٌ للناسِ بحر","والمرءُ فيها سفينهْ",201,"ن",2,1],["الا ربَّ ليلٍ أسفرتْ تحتَ جنحهِ","فما شكَّ أهلُ الحيِّ أن طلعَ البدرُ",202,"ر",1,0],["الا رحمَ اللهُ دهراً مضى","وما كاد يبسمُ حتى انتحبْ",203,"ب",1,0],["ألا ربّ ليل بتّ فيه منعّما","بليّنة الأطراف ساجية الجفن",204,"ن",1,0],["إلاّ رحمتِ قتيلاً من هواك ولم","يبق التواصل فيما بيننا نكِره",205,"ر",2,0],["أَلا رَجُلٌ مِنكُم واحِدٌ","يُحَرِّكُهُ المَجدُ وَالسودَدُ",206,"د",1,0],["ألا رايةٌ للعدلُ في مصرَ تَخفُفق","لعل مساعي دولة الظلم تخفق",207,"ق",1,1],["الا ربما نال الجبان بعجزه","مراداً وخاب الفارس المتوسم",208,"م",1,0],["الأروع الورع الهمام الأفضل","الندب الأجل الاريحي الأمجد",209,"د",1,0],["الأرضُ حولكَ تبدو في نضارَتِها","والعيشُ زخرفةُ الأحلامِ في الوسن",210,"ن",1,0],["الأرض تأخذُ من رِجليكِ نضرتها","إذا مشيتِ كما تمشي الطواويس",211,"س",1,0],["ألا رُبَّ ليلٍ بالقمارِ قَطعتُه","فأصبحتُ منه فاقداً متفقّدا",212,"د",2,0],["ألا رُبَّ نفسٍ فارقت جسمَ فاضلٍ","فشرَّفتِ المثوى وشرَّفها القَبر",213,"ر",1,0],["أَلا رُبَّ ليلٍ خِلتُها تحتَ بَدرهِ","ضَميمةَ أزهارٍ جَناها الذي صَبر",214,"ر",1,0],["ألا رُبَّ شّرٍ كان للخَيرِ واقعاً","فأحسَنَ عُقبى مَن وعى وتفكّرا",215,"ر",2,0],["الأرضُ والتاريخُ عن أخبارهم","وفتوحهم ضاقا فلا تعداد",216,"د",1,0],["الأرضُ أرضُكِ لا مطلٌ ولا جدلٌ","ولا خداعٌ فصكي وَجهَ بشاك",217,"ك",1,0],["الأرضُ قد صارت بحكمِك جنةً","تختالُ في ثوبِ النعيمِ الأنضر",218,"ر",1,0],["الأريحيّةُ هزّتني فصنتُ بها","من الأكارمِ أعراضاً وأحسابا",219,"ب",2,0],["أَلا رُبَّ باغٍ كانَ حاسِمَ فَقْرِهِ","وَباغٍ عَلَيْهِ كانَ قاصِمَ صُلْبِهِ",220,"ب",2,0],["أَلا رُبَّ واشٍ في هَواكَ وَلاحي","رَدَدتُهُما لَم يَظفَرا بِفَلاحِ",221,"ح",1,1],["أَلا رَبَّ بَرغوثٍ تَرَكَت مُجَندِلاً","بِأَبيَضَ ماضي الشَفرَتَينِ صَقيلُ",222,"ل",1,1],["ألا رب مَن يغتابني ودَّ أنني","أبوه الذي يُدعى إليه ويُنسب",223,"ب",1,1],["إِلّا رَجاءَ فَما نَدري أَنُدرِكُهُ","أَم يَستَمِرُّ فَيَأتي دونَهُ الأَجَلُ",224,"ل",1,0],["ألا رب يوم نكت علقاً وقحبةً","أقول لأيري بعدما قد أتاهما",225,"م",2,1],["أَلا رُبَّ ناهٍ عَنِ أُمورٍ وَإِنَّهُ","بِأَيِّ أُمورٍ مِثلِها لَجَديرُ",226,"ر",1,0],["الأرض دونك فامض في آفاقها","وامزج قريب فساحها بالنائي",227,"ا",2,0],["الأرض ما زالت كعهدك مسرحا","للقصة الملعونة الشوهاء",227,"ا",2,0],["الأرض دونك فامض في آفاقها","حتى تمل بها من الإعياء",227,"ا",2,0],["أَلا رُبَّ ذي أَمَلٍ كاذِبٍ","بَعيدُ الرَجاءِ قَوِيُّ الطَمَع",228,"ع",1,1],["إِلّا رَحمتَ عَليلاً لا عِلاج لَهُ","يا جارح القَلب إِلّا مرهم النَظَرِ",229,"ر",1,0],["إلاّ رئيس الدّين إن أبدَى لنا","عن وجْههِ أو سيفِه أو رائه",230,"ا",3,0],["الأَرضُ واسِعَةٌ نَعَم لَكِنَّهُم","مَلَكوا عَلَينا نَبتَها وَالمَعدِنا",231,"ن",2,1],["ألا رُبَّ يَومٍ أشرَقَت شَمسُ كَأسِه","فطافَت علَى جُلاسِه قبلَ شَمسِه",232,"ه",1,1],["الأرض والبحر والأفلاك قاطبةً","لذاك تعنو له رقّاً وترتهب",233,"ب",1,0],["أَلا رحم الرَحمن حَرّاً قَضى أَسىً","وَلَم يَسلُ عَن أَلف وَلَم يَرتَكب غَدرا",234,"ر",2,0],["الأروع المقدام في ذياده","عن قومهع والورع التقيا",235,"ي",2,0],["ألا رحمةً سكان نَعمان إنّني","بحمْلِ الّذي ألْقاهُ غيُ ضَليعِ",236,"ع",1,0],["الأرضُ إلاّ في ذَراكَ فَلاّ فإنْ","بَوَّأْتُ آمالي ذَراكَ فَلا فَلا",237,"ل",2,1],["أَلا رُبَّما غَرَّتكَ عِندَ خِطابِها","وَجادَت عَلَيكَ الآنِساتُ الخَرائِدُ",238,"د",1,0],["أَلا رُبَّ طَيْفاً زارَ ممَّن أُحِبُّه","وما زارَ إلاَّ من سُليمى وسلَّما",239,"م",2,0],["الاربّ يوم زارني خطهُ الذي","كثغر حبيبٍ بالرضاب ترصّعا",240,"ع",2,1],["إلا ربما زار الملاح وربما","رشفت من الثغر الرضاب المحببا",241,"ب",2,1],["إلا ربما جاد الزمان وأنعما","واجلو كؤوس الراح من قرقف اللمى",242,"م",2,1],["الا رب يوم كان لي فيه موعد","بصدق اجتماع الشمل وارتفع العذر",243,"ر",1,0],["ألا ربّ يوم زارني خطه الذي","كثغر حبيب بالرضاب تلمّعا",244,"ع",2,0],["ألا ربَّ يومٍ لنا صالحٍ","مَحا خطأَ الزمنِ المُفسِدِ",245,"د",1,1],["الأربّ دار باللوى قد تقوّضت","لبعدهم أركا نها والدعائم",246,"م",1,0],["الأرضُ قَدْ حُلِّيَتْ رياضاً","كُلِّلَ تيجانُها بِزَهْرِ",247,"ر",1,0],["ألا رب من لم تبد للخفو عينه","سعيد ويشقى من بكى هم عجعجا",248,"ج",2,0],["ألا رحم الإله مضوا أناساً","كبودهم من الدنيا غواث",249,"ث",1,0],["الأربعون ونيف من عمره","مثلت بهذا العيد مثل بشائر",250,"ر",1,0],["الأربعونَ صَدىَ فؤادي الدامي","تمضى ولا تمضى بها آلامي",251,"ي",1,1],["ألا راكبٌ بين الجبال سبيلُه","يُظنُّ نشاطا مُسهلا وهو محزِمُ",252,"م",1,0],["ألا رجلٌ يخاف العيبَ منكم","ويأنف للحقوق من المِحالِ",253,"ل",1,0],["ألا ربما أعطتك صادِقَةَ المُنَى","مصادَفَةُ الأحلامِ من حيثُ تَكذِبُ",254,"ب",1,0],["ألا رَجلٌ أُلقي إليه عظيمةً","وهيهات أعيتْ عقدةٌ وانحلالها",255,"ل",3,0],["أَلا رُبَّ راجٍ حاجَةً لا يَنالُها","وَآخَرَ قَد تَقضي لَهُ وَهوَ جالِسُ",256,"س",1,1],["أَلا رُبَّما يا ثَورُ قَد غَلَّ وَسطَها","أَنامِلُ رَخصاتٌ حَديثٌ خِضابُها",257,"ب",3,0],["أَلا رُبَّ مُلهٍ لَهُ قامَةٌ","تُقيمُ قِيامَةَ هيفِ الغُصون",258,"ن",1,1],["أَلا رُبَّ ضَيفٍ تَقَنَّصتُهُ","وَجيدُ السَماءِ كَثيرُ اللآلي",259,"ي",1,1],["أَلا رُبَّ فِتيانٍ كَأَنَّ وُجوهَهُم","كَواكِبُ لَيلِ غابَ عَنهُ هِلالُهُ",260,"ل",2,1],["أَلا رُبَّ مُحتالِ عَذلٍ غَدا","يَجُرُّ إِلَيَّ ذُيولَ الطَمَع",261,"ع",1,1],["الأَرضُ أُمُّ بَناتِها الشَجَرُ","وَالغَيمُ ثَديٌ لِبانُهُ المَطَرُ",262,"ر",1,1],["الأَرضُ تَضحَكُ وَالسماءُ بِضِدِّها","وَالقُضبُ تَرقُصُ في غَلائِلَ وَردِها",263,"د",3,1],["أَلا رُبَّ خَمّارٍ طَرَقتُ تَعَسُّفاً","عَلى جُرشُعٍ سامي التَليلِ عَمَرَّدِ",264,"د",1,1],["الأَرضُ تُجلى بِزَهرٍ","تَرصيعُهُ الأَنداءُ",265,"ا",2,1],["أَلا رُبَّ مَسرورٍ بِنا سَيَغيظُهُ","لَدى غِبِّ أَمرٍ عَضُّهُ بِالأَنامِلِ",266,"ل",1,0],["الا رَكْبتث في هواهُ","مِن غرامي خَطَرا",267,"ر",2,0],["الأَرْبَعِينَ بِكَامِلِ مشْمِشِهَا, ساعَةُ الشَّمْسِ فِي السَّجْنِ، غَيْمٌ يُقَلِّدُ سِرْباً مِنَ","الكَائِنَاتِ، هُتَافَاتُ شَعْبٍ لِمَنْ يَصْعَدُونَ إلى حَتْفِهِمْ بَاسِمينَ, وَخَوْفُ",268,"ف",1,0],["الأُرْضِ، أُمُّ البِدَايَاتِ أُمَّ النِّهَايَاتِ. كَانَتْ تُسَمَّى فِلِسْطِين. صَارَتْ تُسَمَّى","فلسْطِين. سَيِّدَتي: أَستحِقُّ، لأنَّكِ سيِّدَتِي، أَسْتَحِقُّ الحَيَاةْ.",268,"ه",1,0],["إلا رَوَاكِدَ بَيْنَهُنَّ خَصَاصَةٌ","سُفْعَ المَنَاكِبِ كُلُّهُنَّ قَدِ اصْطَلَى",269,"ا",1,0],["ألا رحمةً للمستجير ورأفةً","بعبدٍ ويرجو فضل سيده العبدُ",270,"د",1,0],["ألا رُبَّ عِرضِ امرِىء مُسلِمٍ","بِغَيرِ لِسانِكَ لم يُستَبَح",271,"ح",1,1],["ألا رياءً لدفع القول عنك ولا","نازعتك الدهر إلا مكرهاً كلما",272,"م",2,0],["أَلا رَعياً لأيّامٍ تقضّتْ","بها والبَيْنُ مُنْصُلُهُ كَهامُ",273,"م",1,0],["الا رب يَوم لَو رَمَتني رَمَيتُها","وَلكِن عَهدي بِالنِضالِ قَديم",274,"م",1,0],["الا راع قَلبي مِن سَلامِهِ اِن غَدا","غَراب عَلى غُصن من البابِ يَنعَب",275,"ب",1,1],["الارضُ صاغت من َدمِي شَفَقاً لَها","كَالاُفُقِ غِبَّ العارِضِ الهَتَّانِ",276,"ن",1,0],["ألا ربّ مرهوبٍ جلوتُ ظلامَه","ووجهِيَ من ماءِ النُّحورِ مثلَّمُ",277,"م",1,0],["ألا ربّ أمرٍ بتّ أحذر غِبَّهُ","وقد نابني فيه العناءُ المُجَشِّمُ",278,"م",1,1],["أَلا رُبَّ يَومٍ صادِقِ العَيشِ نِلتُهُ","بِها وَنَدامايَ العَفافَةُ وَالبَذلُ",279,"ل",1,0],["أَلا رُبَّما اِقتَدتُ الرَجاءَ إِلى المُنى","بِوَعدِكَ حَتّى يَستَبِدَّ بِهِ المَطلُ",279,"ل",1,0],["ألا رب يوم قد رزئت مرزأً","تروح وتغدو بالجزيل مواهبه",280,"ب",2,0]]}