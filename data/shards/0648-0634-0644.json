ية)","https://www.poetsgate.com/ViewPoem.aspx?id=180712",""],[5370,"عيت النفس","https://www.poetsgate.com/ViewPoem.aspx?id=81637",""],[5453,"أم(بك)وت","https://www.poetsgate.com/ViewPoem.aspx?id=28016",""],[5455,"العيش والملح","https://www.poetsgate.com/ViewPoem.aspx?id=36404",""],[5499,"مريض ابعاد","https://www.poetsgate.com/ViewPoem.aspx?id=178232",""],[5525,"الطير","https://www.poetsgate.com/ViewPoem.aspx?id=993",""],[5526,"دفتر أشعاري","https://www.poetsgate.com/ViewPoem.aspx?id=198789",""],[5526,"خلف الشبابيك","https://www.poetsgate.com/ViewPoem.aspx?id=209124",""],[5532,"هنوفي !","https://www.poetsgate.com/ViewPoem.aspx?id=34689",""],[5573,"ضاقت فلما استحكمت صارت خناق","https://www.poetsgate.com/ViewPoem.aspx?id=200308",""],[5573,"رهين","https://www.poetsgate.com/ViewPoem.aspx?id=200342",""],[5573,"ماحال دون معانق الشوق حراس","https://www.poetsgate.com/ViewPoem.aspx?id=201913",""],[5573,"حاولت عيا الحرح لايلقى دوى والليل بالغربه طويل","https://www.poetsgate.com/ViewPoem.aspx?id=206604",""],[5573,"حاولت عيا الجرح لايلقى دوى/والليل بالغربه طويل","https://www.poetsgate.com/ViewPoem.aspx?id=213725",""],[5652,"رثاء ( اُمي )","https://www.poetsgate.com/ViewPoem.aspx?id=206701",""],[5664,"الحشمة","https://www.poetsgate.com/ViewPoem.aspx?id=176692",""],[5732,"يا معذبي بالحب","https://www.poetsgate.com/ViewPoem.aspx?id=177938",""],[5747,"ضنكة الحي","https://www.poetsgate.com/ViewPoem.aspx?id=61673",""],[5747,"شح العطا","https://www.poetsgate.com/ViewPoem.aspx?id=61681",""],[5756,"الدعاء المستجاب","https://www.poetsgate.com/ViewPoem.aspx?id=5381",""],[5821,"قرب رحيله ولآ بقآله سوى شهور","https://www.poetsgate.com/ViewPoem.aspx?id=119858",""],[5837,"خسارة","https://www.poetsgate.com/ViewPoem.aspx?id=189956",""],[5848,"ماتسمى طريقه","https://www.poetsgate.com/ViewPoem.aspx?id=51953",""],[5848,"طفلة نجديه","https://www.poetsgate.com/ViewPoem.aspx?id=53355",""],[5848,"أطبطب وادلع","https://www.poetsgate.com/ViewPoem.aspx?id=50598",""],[5848,"الخطا شين","https://www.poetsgate.com/ViewPoem.aspx?id=53176",""],[5848,"ملامح غياب","https://www.poetsgate.com/ViewPoem.aspx?id=52018",""],[5848,"أروح اصور معك في المنتدى العام","https://www.poetsgate.com/ViewPoem.aspx?id=48845",""],[5848,"تصبح على خير","https://www.poetsgate.com/ViewPoem.aspx?id=53374",""],[5848,"بعض الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=49229",""],[5848,"رسالة قديمة","https://www.poetsgate.com/ViewPoem.aspx?id=53464",""],[192,"تسلم عيوني","https://www.poetsgate.com/ViewPoem.aspx?id=16314",""],[5950,"المشهد الأخير ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128146",""],[5956,"العين بالعين..‏","https://www.poetsgate.com/ViewPoem.aspx?id=183739",""],[6008,"السلف والفخر","https://www.poetsgate.com/ViewPoem.aspx?id=59157",""],[6056,"مفهوم التميّز","https://www.poetsgate.com/ViewPoem.aspx?id=130345",""],[6100,"العام في شوفي تزف التباشير","https://www.poetsgate.com/ViewPoem.aspx?id=52552",""],[6115,"زلة الرفيق","https://www.poetsgate.com/ViewPoem.aspx?id=180512",""],[6115,"الايالله اني طالبك ياعليم الغيب","https://www.poetsgate.com/ViewPoem.aspx?id=181603",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6162,"بَيْنَ بَيْنْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69308&r=&rc=1",""]],"verses":[["وَشَلَّتِ الأَرماحُ مِن أَرضِهِم","طَردَ الغَواني بَعدَ طَردِ السَوام",0,"م",1,0],["وَشَلَّ بِها شَلَّ الطَرائِدِ بِالقَنا","وَكَعكَعَها مِن جِلَّةٍ وَدَرادِقِ",1,"ق",1,0],["وشلّ كفّ افتقار","عن راحتيَّ وكفه",2,"ف",2,0],["وَشَلوٍ مُزِّقَ الأَغراسُ عَنهُ","إِذا لَم يُصلِهِ لَهَبُ الأَفاني",3,"ن",2,0],["وَشَلَّ مِنّي يَدٌ عَوائِدُها","يَجولُ فيها الحُسامُ وَالقَلَمُ",4,"م",1,0],["وَشُلَّ عَنِ التَّقوي إِلَى أن بَدَت بِ","عَلاَمَاتُ كُفرٍ بِالوِلاَيةِ احروي",5,"ي",1,0],["وشَلَّكَ عَن حِيَاضِ المَجدِ ثَلاًّ","فَمَلَّكَ كُلُّ مُنخَفِضٍ وسَامِ",6,"م",1,0],["وشَللْت بالإِحسان أَحقاد الورى","فإِذا عدوك كالأخِ البرِّ الحفي",7,"ف",2,0],["وَشَلّالُ مَغشاةٍ وَحَلّالُ تَلعَةٍ","حَمى الخَوفُ خُبراواتِها وَالمَسائِ