w.aldiwan.net/poem56128.html","المتقارب"],[465,"خليلي عوجاً بالمحلة إنها","https://www.aldiwan.net/poem3140.html","عموديه"],[465,"لذاك الحبيب وهذي الدمن","https://www.aldiwan.net/poem3319.html","عموديه"],[466,"يا صبر أيوب","https://www.aldiwan.net/poem36227.html","عموديه"],[467,"ألا بئسما أن تجرموني وتغضبوا","https://www.aldiwan.net/poem50426.html","الطويل"],[467,"ألا بأبي من قد برى الجسم حبه","https://www.aldiwan.net/poem50472.html","الطويل"],[480,"ألا بالتعاضد فلنبتد","https://www.aldiwan.net/poem37579.html","المتقارب"],[484,"لمن الديار عفون بالجزع","https://www.aldiwan.net/poem2073.html","أحذ الكامل"],[496,"أقول لإحدى المعضلات العظائم","https://www.aldiwan.net/poem10271.html","الطويل"],[516,"ما كل سجع بمعدود من الخطب","https://www.aldiwan.net/poem12020.html","البسيط"],[530,"ألا بلغا عني الحسين بأنني","https://www.aldiwan.net/poem37157.html","الطويل"],[530,"ألا بلغا عني العماد بأنها","https://www.aldiwan.net/poem37383.html","الطويل"],[552,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[559,"وراء هذا الوجود عندي","https://www.aldiwan.net/poem34585.html","مخلع البسيط"],[559,"لي رتبة العلامة الشهم الأَسد","https://www.aldiwan.net/poem34635.html","الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["إِلّا بَقايا مِن غُبارِكَ أَصبَحَت","غُصَصاً وَأَقذاءً لِعَينٍ أَو فَمِ",0,"م",1,0],["إِلّا بَقايا مِن جَميعِ الهَوى","تَهفو بِلُبِّ الجَبَلِ الراسي",1,"س",2,0],["إِلّا بِشيمَةِ بَسّامٍ وَتَكرِمَةٍ","غَرّاءَ تَعدِلُ عِندي كُلَّ مَوهوبِ",2,"ب",1,0],["أَلا بِأَبي بِذي الأَثلاتِ رَبعٌ","سَقى طَلَلَيهِ مَحجَريَ الرَويُّ",3,"ي",1,1],["أَلا بِأَبي بِلادُكِ يا سُلَيْمى","وَما ضَمَّ العُذَيْبُ مِنَ الرُّبوعِ",4,"ع",1,1],["ألا بأبي مَنْ حِيلَ دونَ مَزارِهِ","وقد بِتُّ أسْتَسْقي الغَمامَ لِدارِهِ",5,"ر",2,1],["ألا بأبي كَعْبٌ خَليلاً وصاحِباً","وناهيكَ كَعْبٌ منْ مُغيثٍ ومُصْرِخِ",6,"خ",1,1],["ألا بِأبي ذاكَ الغُزَيِّلُ إذ رَنا","إليّ وذَيّاكَ البُرَيقُ شَجاني",7,"ن",2,0],["ألا بِأبي أُسْدُ الحِمى وظِباؤُهُ","ومُنعَرَجُ الوادي مَصيفاً ومَرْبَعا",8,"ع",2,0],["أَلا بانَ بِالرَهنِ الغَداةَ الحَبائِبُ","كَأَنَّكَ مَعتوبٌ عَلَيكَ وَعاتِبُ",9,"ب",1,1],["أَلا بَكَرَت عِرسي تُوائِمُ مَن لَحى","وَأَقرَبَ بِأَحلامِ النِساء مِنَ الرَدى",10,"ا",1,1],["أَلا بَكَرت عِرسي تَلومُ وتَعذُلُ","وَغَيرُ الَّذي قالَت أَعفُّ وَأَجمَلُ",11,"ل",1,1],["أَلأَبُ الرَّاشِدُ الَّذِي فِي بَنِيهِ","خُلْقُهُ السَّمْحُ وَالضَّمِيرُ القَوِيمُ",12,"م",1,0],["أَلا بَكَرَت سَلمى فَجَدَّ بُكورُها","وَشَقَّ العَصا بَعدَ اجتِماعٍ أَميرُها",13,"ر",3,1],["إِلّا بِغُرٍّ مِنَ الشيزى مُكَلَّلَةٍ","يَجري السَديفُ عَلَيها المُربِعُ الواري",14,"ر",2,0],["إلا بأبي فهر وأميَ مالك","ولو كثرت عندي وفيَّ ذُنوبُها",15,"ب",3,0],["إلا بلاغاً إن تأبَّيتَهُ","أشقيت نفسي ثم أتلفْتُها",16,"ت",3,0],["ألا بُورك الزرعُ الذي هو زارعٌ","من البِرِّ والحرثِ الذي هو حارثُهْ",17,"ث",2,0],["ألا بكرتْ حَرَّى الملامِ تَسعَّرُ","وبئس صبوح المرء لومٌ مبكِّرُ",18,"ر",1,1],["ألا بيني وبينكُمُ النَفارُ","إلى علمائِنا فهم المَنارُ",19,"ر",1,1],["إلا بمقدارِ ما تنداح دائرةٌ","في صفحة الماء يرمَى فيه بالحجر",20,"ر",1,0],["ألا بؤس لِلأَم التي هُدَّ رُكنُها","بواحدها المُخْلي عِراصَ دِياره",21,"ر",2,0],["إلا بأخبارك التي وقعَت","منك إلينا عن ظبية البُرَق",22,"ق",1,0],["أَلا بانَ بِالرَهنِ الغَداةَ الحَبائِبُ","فَعَمداً أَكُفُّ الدَمعَ وَالحُبُّ غالِبُ",23,"ب",1,0],["أَلا بانَ بِالرَهنِ الغَداةَ الحَبائِبُ","فَأَنتَ تَكُفُّ الدَمعَ وَالدَمعُ غالِبُ",24,"ب",1,1],["ألا بديارهم جن الكرام","وشفهم بليلاها الغرام",25,"م",1,1],["آل أبى بكر لكم","في الناس أرفع الرتب",26,"ب",1,0],["إلا بسر غامض مماطلِ","يلوح للعاقل دون الجاهلِ",27,"ل",1,0],["إلا بتوفيق له سابق","منّتنا عن شكره قاصره",28,"ر",2,0],["ألا بعثتِ لنا طيفاً يُلِمُّ على","شُعْثٍ نشاوَى من الإدلاجِ خُمصانِ",29,"ن",1,0],["أَلا باعَدَ اللَهُ أَهلَ النِفاقِ","وَأَهلَ الأَراجيفِ وَالباطِلِ",30,"ل",1,1],["أَلا بَلَّغ هُديتَ سَماةَ قَومي","بِحِلَّةِ بابِلٍ عِندَ الوُرودِ",31,"د",1,1],["ألا بأبي من جُمْلَةِ الغيدِ واحدٌ","فهل علموا ذاك الغزال من السربِ",32,"ب",1,0],["أَلا بَكَرَت مَعذورَةً حينَ تَعذِلُ","تُعَرِّفُني مِنَ العَيشِ ما لَستُ أَجهَلُ",33,"ل",1,0],["أَلا بانَ عَيشٌ كانَ يَندى غَضارَةً","فَيالَيتَ ذاكَ العَيشَ لَو كانَ يَنكُصُ",34,"ص",1,0],["أَلا بَكى الدُرُّ فَوقَ حالِيَةٍ","حَلّى بِها العِقدُ شَرَّ ماحَلى",35,"ل",2,1],["ألا بَعُدتْ ديارُ الظّاعنينا","ولا عطفوا الركائبَ راجعينا",36,"ن",2,0],["أَلابْنِ أُبيٍّ رَأيهُ ما وَراءَهُ","لِذي نُهْيَةٍ رأيٌ ولا عنه مَذْهَبُ",37,"ب",1,0],["ألا بُوركتَ من هادٍ أمينِ","تَردُّ أناتهُ الحُلْمَ النزيعا",38,"ع",2,0],["ألا بُعداً لمن يَبغِي الغُلولا","تجلَّى نورُ ربّكَ ذي الجلالِ",39,"ل",1,0],["ألا بطلٌ يَذُبُّ عنِ الحريم","ويَضرِبُ بالمهنَّدِ في الصّميم",39,"م",1,0],["أَلاّ بَكَيتَ عَلى الكِرا","مِ بَني الكِرامِ أولي المَمادِح",40,"ح",1,1],["ألا بِكُمُ يَسمُو إلى العُلو من سما","وأنتُم نظامُ المُلكِ ما طَلَعَ النجمُ",41,"م",1,0],["أَلا بَل ما تَرى حَشراً","وَما الزِنديقُ وَالحَشرُ",42,"ر",1,0],["إلَّا بتَرْغيبٍ له في الطاعَهْ","وفي الدخولِ مَدْخلَ الجماعَهْ",43,"ه",1,0],["أَلا بِأبي من قلبه غير مشفِقُ","عليَّ ولي قلبٌ عليهِ شَفيقُ",44,"ق",1,0],["أَلا بِأَبي صُدْغٌ حَكَى العَينَ عِطفُهُ","وشَارِبُ مِسْكٍ قَدْ حَكى عَطفَةَ الرَّاءِ",45,"ر",3,0],["آل ابن عمران أو ابن مريما","فمن بهاتيك الشعاب خيّما",46,"م",2,0],["أَلا بأَبي زائِرِي في العتَمْ","بوجْهٍ يُجلِّي سَواد الظُّلَمْ",47,"م",1,1],["أَلا بِأَبِي مَنْ حُسْنُهُ وَحَدِيثُهُ","إِذَا مَا الْتَقَينَا لَذَّةُ الْعَيْنِ وَالسَّمْعِ",48,"ع",1,1],["أَلا بِأَبِي مَنْ كَانَ نُوراً مُجَسَّداً","يَفِيضُ عَلَينَا بِالنَّعِيمِ رَواؤُهُ",49,"ا",3,1],["ألا بأبي صدغٌ حكى العينَ فتلهُ","وَشَارِبُ مِسكٍ قَدْ حَكى عَطفَة َ الرَّاءِ",50,"ر",3,0],["الا بحياتكم يكفي التجني","فجيش الصبر بدده انهزام",51,"م",1,0],["الأُباةُ الكُماةُ في كلِّ عَصْرٍ","أَهْلُها في طلائعِ الفُرسانِ",52,"ن",1,0],["إلا بسَلسَلِ مائِهِ المَفقود","حادي العِطاشِ إلى مَواردِ ماءِ",53,"ا",2,0],["أَلا بَكَرَت تَلومُ بِغَيرِ قَدرِ","فَقَد أَحفَيتِني وَدَخَلتِ سِتري",54,"ر",2,1],["إلاَّ بقايا أناس حاولوا لكمُ","كيدا فكادهمُ الجبَّارُ فافتُقِدُوا",55,"د",3,0],["إِلاَّ بِمَكَّةَ وَوَقتُهَا الضُّحَى","إلَى الزَّوَالِ لِلجَمِيعِ وَضُحَا",56,"ح",2,0],["ألاَ بَارَكَ الرحمنُ يَا شَيخُ فِيكُمُ","ولاَ فَارَقَت يَوماً بِمَغنَاكَ فُرَّقُ",57,"ق",1,0],["إِلّا بِإِهدائي المَديحَ لِحَضرَةٍ","أَعدَت غَرائِبُ مَجدِها أَقوالي",58,"ل",2,0],["أَلإبنُ في دارِكُم صِهرٌ لِوالِدِهِ","وَالأَخُ قَد يَنثَنِي عَن كَلبِهِ الحارِ",59,"ر",1,0],["الأبلجُ الطلقُ الذي قد نزلت","آيات حكم سعوده تنزيلا",60,"ل",2,0],["الأبلج الطلق الجبين من له","خلائق تفضح نشر العطر",61,"ر",1,0],["الأبلحُ المنصور نجل الناصر ب","ن الأشرف بن الأفضلِ السلطانا",62,"ن",2,0],["الأبلجُ المنصورُ من جازى الورى","في المكرماتِ فأحرَزَ القَصباتِ",63,"ت",1,0],["إِلّا بَقايا مِن أُناسٍ بِهِمُ","إِلى سَبيلِ المَكرُماتِ يُقتَدى",64,"ا",1,0],["إِلاّ بعَلَّ وسَوفَ قِيلٌ بعدَهُ","خُلفٌ وَلَيسَ خَيالُها بِمُزَايلى",65,"ل",2,0],["إلا بقيّة معشر","من فاضل في حال خامل",66,"ل",1,0],["الأبطحيُّ المدنيُّ العربي","لِخير جنسٍ ومكانٍ اِنتمى",67,"م",2,0],["الأبطحي المنتقي من هاشم","والآل والأصحاب ما البدر اختفى",68,"ف",2,0],["ألا بالحمى إن جزت يا راكب الوجنا","فشبب بذكر العامرية في المغنى",69,"ن",2,1],["إلا بقايا الأمّ","ذات اللئات الحمّ",70,"م",1,0],["إلا بتقريض در حاشية","ينسبها عصرنا لأمجده",71,"د",2,0],["ألا بأبي جَوْرُ إدلالِها","عليَّ وإفراطُ عُدْوَانها",72,"ن",3,0],["إِلّا بِأَنَّهُمُ الغِلمانُ لا شُكِرَت","مَسعاتُهُم غَلَطاً جاؤوا إِلى بابي",73,"ب",2,0],["أَلا بَلَحَت خِفارَةُ آلِ لَأمٍ","فَلا شاةً تَرُدُّ وَلا بَعيرا",74,"ر",2,1],["أَلا بانَ الخَليطُ وَلَم يُزاروا","وَقَلبُكَ في الظَعائِنِ مُستَعارُ",75,"ر",1,1],["ألابِسةَ السّوادِ على بياضٍ","فلقتِ الصبحَ في الليلِ الدجي",76,"ي",1,0],["الابطحي المتقي من غالب","تاج النبوَّة عصمة المستعصم",77,"م",1,0],["أَلا بلغوا عني المحبين انهم","وان سَكَنوا قَلبي عَن العين غيب",78,"ب",1,0],["الابطحي المنتقى من غالب","وَالطاهِر الطهر البَشير المنذر",79,"ر",1,0],["أَلا بِأَبِي مِنْها هَدِيُّ بَلاغَةٍ","تُنَاغِي المَهَى مَحْجوبَةٌ فِي الْمَهَارِقِ",80,"ق",1,0],["أَلا بِأبِي تِلكَ الوُجُوه سَوَاهِماً","وَإنْ كُنَّ عِنْدَ اللَّهِ غَيْرَ سوَاهِمِ",81,"م",1,0],["أَلا بِأَبِي يَدُ الملْك يَحْيَى","عَطَاياها الدِّياتُ إذا تُنيلُ",8