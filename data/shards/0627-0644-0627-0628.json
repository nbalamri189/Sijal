{"poems":[[53,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[53,"قربت بالبعد من الناس","https://www.aldiwan.net/poem30188.html","السريع"],[53,"ما يصنع السير بالجرد السراحيب","https://www.aldiwan.net/poem30762.html","البسيط"],[63,"ألا بأبي بذي الأثلات ربع","https://www.aldiwan.net/poem45774.html","الوافر"],[63,"ألا بأبي بلادك يا سليمى","https://www.aldiwan.net/poem46084.html","الوافر"],[63,"ألا بأبي من حيل دون مزاره","https://www.aldiwan.net/poem46137.html","الطويل"],[63,"ألا بأبي كعب خليلا وصاحبا","https://www.aldiwan.net/poem46163.html","الطويل"],[63,"سرى طيفها والملتقى متدان","https://www.aldiwan.net/poem46182.html","الطويل"],[63,"أصاخ إلى الواشي فلباه إذ دعا","https://www.aldiwan.net/poem46191.html","الطويل"],[6,"ألا بان بالرهن الغداة الحبائب","https://www.aldiwan.net/poem383.html",""],[24,"ألا بكرت عرسي توائم من لحى","https://www.aldiwan.net/poem21856.html","الطويل"],[24,"ألا بكرت عرسي تلوم وتعذل","https://www.aldiwan.net/poem21876.html","الطويل"],[93,"لا تبن أيها المحيا الوسيم","https://www.aldiwan.net/poem11339.html","الخفيف"],[27,"ألا بكرت سلمى فجد بكورها","https://www.aldiwan.net/poem5775.html","الطويل"],[27,"حيوا المقام وحيوا ساكن الدار","https://www.aldiwan.net/poem5782.html","البسيط"],[37,"ألا لا أرى الأيام يقضى عجيبها","https://www.aldiwan.net/poem6494.html","الطويل"],[51,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[51,"مطايب عيش زايلته مخابثه","https://www.aldiwan.net/poem9226.html","الطويل"],[51,"ألا بكرت حرى الملام تسعر","https://www.aldiwan.net/poem62892.html","السريع"],[51,"ألا بيني وبينكم النفار","https://www.aldiwan.net/poem64002.html","الوافر"],[51,"ما أنس لا أنس خبازا مررت به","https://www.aldiwan.net/poem64047.html","البسيط"],[51,"حليف سهاد ليله كنهاره","https://www.aldiwan.net/poem64079.html","الطويل"],[51,"تبارك الله خالق الكرم البارع","https://www.aldiwan.net/poem65517.html","المنسرح"],[29,"لخولة بالدومي رسم كأنه","https://www.aldiwan.net/poem6210.html","الطويل"],[29,"ألا بان بالرهن الغداة الحبائب","https://www.aldiwan.net/poem6215.html","الطويل"],[85,"ألا بديارهم جن الكرام","https://www.aldiwan.net/poem7045.html","الوافر"],[85,"بيتكمو أبا لهب","https://www.aldiwan.net/poem7133.html","مجزوء الرجز"],[62,"الحمد لله العلي القادر","https://www.aldiwan.net/poem52184.html","الرجز"],[62,"الحمد لله الذي خصنا","https://www.aldiwan.net/poem52241.html","السريع"],[62,"يا حادي الظعن رفقا إنك الجاني","https://www.aldiwan.net/poem52253.html","البسيط"],[58,"ألا باعد الله أهل النفاق","https://www.aldiwan.net/poem30893.html","المتقارب"],[66,"ألا بلغ هديت سماة قومي","https://www.aldiwan.net/poem41363.html","الوافر"],[80,"لعمري لقد ظنوا الظنون وأيقنوا","https://www.aldiwan.net/poem31560.html","الطويل"],[44,"تحمل عنه الصبر يوم تحملوا","https://www.aldiwan.net/poem30377.html","الطويل"],[74,"ألا إنها سن تزيد فأنقص","https://www.aldiwan.net/poem12975.html","الطويل"],[74,"ألا بكى الدر فوق حالية","https://www.aldiwan.net/poem13229.html","المنسرح"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"سويلم ما قول ببيتك يفترى","https://www.aldiwan.net/poem44029.html","الطويل"],[105,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[105,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[21,"ألا بكيت على الكرا","https://www.aldiwan.net/poem36243.html","مجزوء الكامل"],[75,"شكا ما شكوت الرمح والنصل والسهم","https://www.aldiwan.net/poem69019.html","الطويل"],[50,"أبا الحشفان آتيك","https://www.aldiwan.net/poem63799.html","الهزج"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[76,"أرقت وقلبي عنك ليس يفيق","https://www.aldiwan.net/poem39255.html","الطويل"],[76,"وأزهر كالعيوق يسعى بزهراء","https://www.aldiwan.net/poem39507.html","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202531","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30494","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42687","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42501","الطويل"],[76,"وأزهرَ كالعيُّوقِ بزهراءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17865&r=&rc=2",""]],"verses":[["إِلّا بَقايا مِن غُبارِكَ أَصبَحَت","غُصَصاً وَأَقذاءً لِعَينٍ أَو فَمِ",0,"م",1,0],["إِلّا بَقايا مِن جَميعِ الهَوى","تَهفو بِلُبِّ الجَبَلِ الراسي",1,"ي",1,0],["إِلّا بِشيمَةِ بَسّامٍ وَتَكرِمَةٍ","غَرّاءَ تَعدِلُ عِندي كُلَّ مَوهوبِ",2,"ب",1,0],["أَلا بِأَبي بِذي الأَثلاتِ رَبعٌ","سَقى طَلَلَيهِ مَحجَريَ الرَويُّ",3,"ي",1,1],["أَلا بِأَبي بِلادُكِ يا سُلَيْمى","وَما ضَمَّ العُذَيْبُ مِنَ الرُّبوعِ",4,"ع",1,1],["ألا بأبي مَنْ حِيلَ دونَ مَزارِهِ","وقد بِتُّ أسْتَسْقي الغَمامَ لِدارِهِ",5,"ر",2,1],["ألا بأبي كَعْبٌ خَليلاً وصاحِباً","وناهيكَ كَعْبٌ منْ مُغيثٍ ومُصْرِخِ",6,"خ",1,1],["ألا بِأبي ذاكَ الغُزَيِّلُ إذ رَنا","إليّ وذَيّاكَ البُرَيقُ شَجاني",7,"ن",2,0],["ألا بِأبي أُسْدُ الحِمى وظِباؤُهُ","ومُنعَرَجُ الوادي مَصيفاً ومَرْبَعا",8,"ع",2,0],["أَلا بانَ بِالرَهنِ الغَداةَ الحَبائِبُ","كَأَنَّكَ مَعتوبٌ عَلَيكَ وَعاتِبُ",9,"ب",1,1],["أَلا بَكَرَت عِرسي تُوائِمُ مَن لَحى","وَأَقرَبَ بِأَحلامِ النِساء مِنَ الرَدى",10,"ا",1,1],["أَلا بَكَرت عِرسي تَلومُ وتَعذُلُ","وَغَيرُ الَّذي قالَت أَعفُّ وَأَجمَلُ",11,"ل",1,1],["أَلأَبُ الرَّاشِدُ الَّذِي فِي بَنِيهِ","خُلْقُهُ السَّمْحُ وَالضَّمِيرُ القَوِيمُ",12,"م",1,0],["أَلا بَكَرَت سَلمى فَجَدَّ بُكورُها","وَشَقَّ العَصا بَعدَ اجتِماعٍ أَميرُها",13,"ر",3,1],["إِلّا بِغُرٍّ مِنَ الشيزى مُكَلَّلَةٍ","يَجري السَديفُ عَلَيها المُربِعُ الواري",14,"ي",1,0],["إلا بأبي فهر وأميَ مالك","ولو كثرت عندي وفيَّ ذُنوبُها",15,"ب",3,0],["إلا بلاغاً إن تأبَّيتَهُ","أشقيت نفسي ثم أتلفْتُها",16,"ت",3,0],["ألا بُورك الزرعُ الذي هو زارعٌ","من البِرِّ والحرثِ الذي هو حارثُهْ",17,"ث",2,0],["ألا بكرتْ حَرَّى الملامِ تَسعَّرُ","وبئس صبوح المرء لومٌ مبكِّرُ",18,"ر",1,1],["ألا بيني وبينكُمُ النَفارُ","إلى علمائِنا فهم المَنارُ",19,"ر",1,1],["إلا بمقدارِ ما تنداح دائرةٌ","في صفحة الماء يرمَى فيه بالحجر",20,"ر",1,0],["ألا بؤس لِلأَم التي هُدَّ رُكنُها","بواحدها المُخْلي عِراصَ دِياره",21,"ر",2,0],["إلا بأخبارك التي وقعَت","منك إلينا عن ظبية البُرَق",22,"ق",1,0],["أَلا بانَ بِالرَهنِ الغَداةَ الحَبائِبُ","فَعَمداً أَكُفُّ الدَمعَ وَالحُبُّ غالِبُ",23,"ب",1,0],["أَلا بانَ بِالرَهنِ الغَداةَ الحَبائِبُ","فَأَنتَ تَكُفُّ الدَمعَ وَالدَمعُ غالِبُ",24,"ب",1,1],["ألا بديارهم جن الكرام","وشفهم بليلاها الغرام",25,"م",1,1],["آل أبى بكر لكم","في الناس أرفع الرتب",26,"ب",1,0],["إلا بسر غامض مماطلِ","يلوح للعاقل دون الجاهلِ",27,"ل",1,0],["إلا بتوفيق له سابق","منّتنا عن شكره قاصره",28,"ر",2,0],["ألا بعثتِ لنا طيفاً يُلِمُّ على","شُعْثٍ نشاوَى من الإدلاجِ خُمصانِ",29,"ن",1,0],["أَلا باعَدَ اللَهُ أَهلَ النِفاقِ","وَأَهلَ الأَراجيفِ وَالباطِلِ",30,"ل",1,1],["أَلا بَلَّغ هُديتَ سَماةَ قَومي","بِحِلَّةِ بابِلٍ عِندَ الوُرودِ",31,"د",1,1],["ألا بأبي من جُمْلَةِ الغيدِ واحدٌ","فهل علموا ذاك الغزال من السربِ",32,"ب",1,0],["أَلا بَكَرَت مَعذورَةً حينَ تَعذِلُ","تُعَرِّفُني مِنَ العَيشِ ما لَستُ أَجهَلُ",33,"ل",1,0],["أَلا بانَ عَيشٌ كانَ يَندى غَضارَةً","فَيالَيتَ ذاكَ العَيشَ لَو كانَ يَنكُصُ",34,"ص",1,0],["أَلا بَكى الدُرُّ فَوقَ حالِيَةٍ","حَلّى بِها العِقدُ شَرَّ ماحَلى",35,"ل",2,1],["ألا بَعُدتْ ديارُ الظّاعنينا","ولا عطفوا الركائبَ راجعينا",36,"ن",2,0],["أَلابْنِ أُبيٍّ رَأيهُ ما وَراءَهُ","لِذي نُهْيَةٍ رأيٌ ولا عنه مَذْهَبُ",37,"ب",1,0],["ألا بُوركتَ من هادٍ أمينِ","تَردُّ أناتهُ الحُلْمَ النزيعا",38,"ع",2,0],["ألا بُعداً لمن يَبغِي الغُلولا","تجلَّى نورُ ربّكَ ذي الجلالِ",39,"ل",1,0],["ألا بطلٌ يَذُبُّ عنِ الحريم","ويَضرِبُ بالمهنَّدِ في الصّميم",39,"م",1,0],["أَلاّ بَكَيتَ عَلى الكِرا","مِ بَني الكِرامِ أولي المَمادِح",40,"ح",1,1],["ألا بِكُمُ يَسمُو إلى العُلو من سما","وأنتُم نظامُ المُلكِ ما طَلَعَ النجمُ",41,"م",1,0],["أَلا بَل ما تَرى حَشراً","وَما الزِنديقُ وَالحَشرُ",42,"ر",1,0],["إلَّا بتَرْغيبٍ له في الطاعَهْ","وفي الدخولِ مَدْخلَ الجماعَهْ",43,"ه",1,0],["أَلا بِأبي من قلبه غير مشفِقُ","عليَّ ولي قلبٌ عليهِ شَفيقُ",44,"ق",1,0],["أَلا بِأَبي صُدْغٌ حَكَى العَينَ عِطفُهُ","وشَارِبُ مِسْكٍ قَدْ حَكى عَطفَةَ الرَّاءِ",45,"ر",3,0],["آل ابن عمران أو ابن مريما","فمن بهاتيك الشعاب خيّما",46,"م",2,0],["أَلا بأَبي زائِرِي في العتَمْ","بوجْهٍ يُجلِّي سَواد الظُّلَمْ",47,"م",1,1],["أَلا بِأَبِي مَنْ حُسْنُهُ وَحَدِيثُهُ","إِذَا مَا الْتَقَينَا لَذَّةُ الْعَيْنِ وَالسَّمْعِ",48,"ع",1,1],["أَلا بِأَبِي مَنْ كَانَ نُوراً مُجَسَّداً","يَفِيضُ عَلَينَا بِالنَّعِيمِ رَواؤُهُ",49,"ا",3,1],["ألا بأبي صدغٌ حكى العينَ فتلهُ","وَشَارِبُ مِسكٍ قَدْ حَكى عَطفَة َ الرَّاءِ",50,"ر",3,0]]}