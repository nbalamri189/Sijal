{"poems":[[55,"هذي المنازل بالغميم فنادها","https://www.aldiwan.net/poem30606.html","الكامل"],[9,"شريح لا تتركني بعدما علقت","https://www.aldiwan.net/poem21933.html","البسيط"],[90,"حببت العلا منذ الصبا حب شاعر","https://www.aldiwan.net/poem44989.html","الطويل"],[23,"ما بال عيني لا تنام كأنما","https://www.aldiwan.net/poem21397.html","الكامل"],[53,"لي صاحب قد كنت آمل نفعه","https://www.aldiwan.net/poem8496.html","الكامل"],[53,"قدمت لي وعدا فأين نجاحه","https://www.aldiwan.net/poem9384.html","الكامل"],[53,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[34,"وقلت لها اعتللت بغير ذنب","https://www.aldiwan.net/poem27815.html","الوافر"],[87,"عادت أغاني العرس رجع نواح","https://www.aldiwan.net/poem21008.html","الكامل"],[64,"هو الشوق حتى ما تقر المضاجع","https://www.aldiwan.net/poem52357.html","الطويل"],[47,"أمخلفي يا فتح أنت وظاعن","https://www.aldiwan.net/poem10665.html","الكامل"],[63,"شباب المرء ثوب مستعار","https://www.aldiwan.net/poem51666.html","الوافر"],[63,"أ أقحوانا أرته أم بردا","https://www.aldiwan.net/poem51719.html","المنسرح"],[63,"ما كف شاديه اعتراض عتابه","https://www.aldiwan.net/poem51813.html","الطويل"],[82,"خطاب عن لقائكم يعوق","https://www.aldiwan.net/poem31361.html","الوافر"],[46,"أسقى طلولهم أجش هزيم","https://www.aldiwan.net/poem30341.html","الكامل"],[71,"أأقتل بين جدك والمزاح","https://www.aldiwan.net/poem28551.html","الوافر"],[33,"أأقام أمس خليطنا أم سارا","https://www.aldiwan.net/poem42537.html","الكامل"],[35,"فوالله ثم والله إني لدائب","https://www.aldiwan.net/poem26026.html","الطويل"],[107,"","https://poetry.dctabudhabi.ae/diwan/poem/49185","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39612","الكامل"],[108,"كفكف دموعك","https://www.poetsgate.com/ViewPoem.aspx?id=179663",""],[34,"اشاقتك المعارف والطلول","https://www.poetsgate.com/ViewPoem.aspx?id=120",""],[33,"أأقَامَ أَمْسِ خَلِيطُنا أَمْ سارا؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18865&r=&rc=128",""],[102,"قتيلان .. هما القاتل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85961&r=&rc=231",""],[173,"إلى م أرجي ضر عيش منكدا","https://www.aldiwan.net/poem1615.html",""],[173,"إلى م أورد عتباً غير مستمع","https://www.aldiwan.net/poem1637.html",""],[227,"لقد فرض الحب الحبيب وسنه","https://www.aldiwan.net/poem55461.html","الكامل"],[314,"أأقصد بالملامة قصد غيري","https://www.aldiwan.net/poem50276.html","الوافر"],[408,"عدمت اللقا إن لم أوافك زائرا","https://www.aldiwan.net/poem46422.html","الطويل"],[408,"ألمت فهاجت لوعة بفؤادي","https://www.aldiwan.net/poem46494.html","الطويل"],[438,"قفا فاسألا مني زفيرا وأدمعا","https://www.aldiwan.net/poem12378.html","الطويل"],[447,"تذكرني ليلى وذو الحب لا ينسى","https://www.aldiwan.net/poem14307.html","الطويل"],[447,"أيا ليلى ويا ليت التلاقي","https://www.aldiwan.net/poem14315.html","الوافر"],[453,"ماذا أبث إليكم مما غدا","https://www.aldiwan.net/poem53749.html","الكامل"],[543,"أحن إلى مصر وما أنا من مصر","https://www.aldiwan.net/poem48137.html","عموديه"],[591,"يقول وقد رنا عن لحظ ظبي","https://www.aldiwan.net/poem17694.html","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122553","المتقارب"],[686,"","https://poetry.dctabudhabi.ae/diwan/poem/144927","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62524","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62483","السريع"],[1175,"","https://poetry.dctabudhabi.ae/diwan/poem/67750","الوافر"],[1175,"","https://poetry.dctabudhabi.ae/diwan/poem/67753","الوافر"],[1409,"","https://poetry.dctabudhabi.ae/diwan/poem/130256","الوافر"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35722","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108622","الوافر"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132251","الطويل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114791","الطويل"],[2100,"","https://poetry.dctabudhabi.ae/diwan/poem/34971","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53172","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93651","الكامل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141184","الطويل"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121154","الكامل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82812","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74103","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108295","الكامل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125933","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216777","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117965","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102982","الكامل"],[3996,"","https://poetry.dctabudhabi.ae/diwan/poem/114917","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86449","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83441","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83423","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83660","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139637",""],[4691,"بدر يسكن في بدر","https://www.poetsgate.com/ViewPoem.aspx?id=94080",""],[4755,"ورَجَعْتَ؟! قُلتُ: رَجَعتُ يا حُزنُ","https://www.poetsgate.com/ViewPoem.aspx?id=186541",""],[4755,"غَفوةٌ على سَرير البَرزَخ","https://www.poetsgate.com/ViewPoem.aspx?id=215432",""],[4852,"جهرة","https://www.poetsgate.com/ViewPoem.aspx?id=215147",""],[4981,"صرخة يتيم","https://www.poetsgate.com/ViewPoem.aspx?id=190504",""],[5010,"حَاشَاه مِنْ ألمِ الجوَى حَاشَاهُ","https://www.poetsgate.com/ViewPoem.aspx?id=190232",""],[5026,"قنديل مذاب","https://www.poetsgate.com/ViewPoem.aspx?id=213500",""],[5072,"هو عيدكم","https://www.poetsgate.com/ViewPoem.aspx?id=51804",""],[5145,"أأقسد الشيب في فوديه أم قسطا","https://www.poetsgate.com/ViewPoem.aspx?id=108233",""],[5145,"أعلمت أنا سيد الأنس","https://www.poetsgate.com/ViewPoem.aspx?id=108220",""],[5163,"سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=33950",""],[5277,"من أوراق حمامة بغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=185800",""],[5277,"عيونُ حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=192670",""],[5285,"جسر الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=203650",""],[5320,"إلى رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=40398",""],[5410,"زفرة","https://www.poetsgate.com/ViewPoem.aspx?id=133059",""],[5431,"رثاء...","https://www.poetsgate.com/ViewPoem.aspx?id=204906",""],[5442,"حتام أبطائي بيوم متابي","https://www.poetsgate.com/ViewPoem.aspx?id=114775",""],[5616,"الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=205217",""],[5628,"صورة مؤلمة","https://www.poetsgate.com/ViewPoem.aspx?id=178520",""],[5759,"مقيمة","https://www.poetsgate.com/ViewPoem.aspx?id=212849",""],[5899,"داليا","https://www.poetsgate.com/ViewPoem.aspx?id=31373",""],[5956,"الرياضة أسباب الصحة والجمال","https://www.poetsgate.com/ViewPoem.aspx?id=193882",""],[6093,"كلُّ اللغَاتِ تَعذًّرتْ","https://www.poetsgate.com/ViewPoem.aspx?id=206059",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[6202,"دنيا عجائب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86721&r=&rc=22",""],[406,"غفوة قلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1113&r=&rc=57",""]],"verses":[["أَأَقولُ جادَكُمُ الرَبيعُ وَأَنتُمُ","في كُلِّ مَنزِلَةٍ رَبيعُ بِلادِها",0,"د",3,0],["أَأَقتُلُ اِبنَكَ صَبراً أَو تَجيءُ بِها","طَوعاً فَأَنكَرَ هَذا أَيَّ إِنكارِ",1,"ر",1,0],["أأقدِر فيها أن أصيخ للأئم","وقد ملكت مني جميع المشاعر",2,"ر",1,0],["أَأُقيمُ بَعدَكَ بِالمَدينَةِ بَينَهُم","يا لَهفَ نَفسي لَيتَني لَم أولَدِ",3,"د",1,0],["أأقولُ شعراً لا يُعابُ شبِيهُهُ","فتكونَ أوّلَ عائبٍ تشبيبَهُ",4,"ب",2,0],["أأقول ويحكِ حالَ بعدَك بخلُهُ","أم حال بعدك جوده وسماحُهُ",5,"ح",2,0],["أأقول فيكم ما أقو","ل فلا يكون له حَويرُ",6,"ر",1,0],["أَأَقتُلَهُ وَما لي مِن سِلاحٍ","وَما بي لَو أُقاتِلَهُ حَويلُ",7,"ل",1,0],["أَأَقولُ مَن أَحيا الجَماعَةَ مُلحِدٌ","وَأَقولُ مَن رَدَّ الحُقوقَ إِباحي",8,"ح",2,0],["أَأُقصَى ويُدعَى مَنْ سوايَ فينثني","بربحٍ وفي حظِّي لديك وضائِعُ",9,"ع",1,0],["أَأَقولُ مَغضوبٌ عَلَيَّ فَعِلمُهُم","أَن لَستُ مُعتَذِراً وَلَستُ بِمُذنِبِ",10,"ب",1,0],["أَ أَقعُدُ بالعراقِ أسيرَ دَهْرٍ","غريباً لا أزورُ ولا أُزارُ",11,"ر",1,0],["أَ أُقحُواناً أَرَتْهُ أم بَرَدَا","غَيداءُ يهتزُّ عِطْفُها غَيَدا",12,"د",2,1],["أأقومُ بين يَدَي سواه مؤمِّلاً","وأُنيخُ راحلةَ الرَّجاءِ ببابِه",13,"ب",2,0],["أأقدر أنْ يُقَدَّرَ لي زمانٌ","له خُلُقٌ بأُلفَتِنا خليقُ",14,"ق",1,0],["أَأُقَنِّعُ المَعروفَ وَهوَ كَأَنَّهُ","قَمَرُ الدُجى إِنّي إِذَن لَلَئيمُ",15,"م",1,0],["أَأُقْتَلُ بينَ جدِّكَ والمزاحِ","بنبلِ جفونِكَ المرضى الصحاحِ",16,"ح",1,1],["أَأَقامَ أَمسِ خَليطُنا أَم سارا","سائِل بِعَمرِكَ أَيَّ ذاكَ اِختارا",17,"ر",2,1],["أَأَقطَعُ حَبلَ الوَصلِ فَالمَوتُ دونَهُ","أَمَ اَشرَبُ كَأساً مِنكُمُ لَيسَ يُشرَبُ",18,"ب",1,0],["أأقتلُ قَوماً ظَاهروني وحَارَبُوا","مَعِيَ حَسْبُهم أن يَحمِلوا الإثمَ والوِزْرا",19,"ر",2,0],["أأقولُ أبناءُ الوغى أم جِنةٌ","وأقولُ آلهَةٌ أمِ الأقدارُ",20,"ر",1,0],["أأقطع عُمري أنينًا وشكوى","وألبسُ فيه الحداد وشَاحا؟",21,"ح",2,0],["أأقلته وما لي من سلاح","وما بي لو أقاتله حويل؟",22,"ل",1,0],["أأقَامَ أَمْسِ خَلِيطُنا أَمْ سارا؟","سَائِلْ بِعَمْرِكَ أَيَّ ذاكَ کخْتَارَا؟",23,"ر",2,1],["أَأَقُوُلُ : أَنَا أفْدِيْ وَطَنِيْ","وَنُعُوْشُ بَنِيْهِ عَلَىْ ظَهْرِيْ",24,"ر",2,0],["أَأَقنَعُ بِالحظِّ الخَسيسِ وَلَم أَكُن","كَهاماً وَلا رَثَّ المَساعي مُزَنَّدا",25,"د",2,0],["أَأَقبَلُ النَقصَ وَالآباءُ مُنجِبَةٌ","وَالبَيتُ في المَجدِ ذُو مَرأىً وَمُستَمَعِ",26,"ع",1,0],["أأقرضتني دمعاً لأيام فاقتي","فتحذر إفلاسي لفرط بكائي",27,"ي",1,0],["أَأَقصُدُ بِالمَلامَةِ قَصدَ غَيري","وَأَمري كُلُّهُ بادي الخِلافِ",28,"ف",1,1],["أَأَقْصدُ مرزوقاً ضَنِيناً بِرزْقِهِ","أَلم يك خلاّقي على ذاك قادرا",29,"ر",2,0],["أأقعدُ في قومٍ أرى الشعر بينَهُمْ","يُباعُ ببخْسٍ طاهرٍ وكَسَادِ",30,"د",1,0],["أَأَقْلَعَ عن عَيْنِي وعندِي صبابَةٌ","نهاها النُّهَي أَنْ تستقِلَّ فتُقْلِعا",31,"ع",2,0],["أأقعد عن ليلى بدار كأنني","حللت قبيل الموت من ضيقها الرمسا",32,"س",2,0],["أأقوى عنك يا ليلى فراقاً","وغياة لوعتي يوم الفراق",33,"ق",1,0],["أأقول أنى قد بكيتم دما","حتى كأن بمقلتي جراحا",34,"ح",2,0],["أَأُقبَرُ حَيّاً يا عبادُ بِمَوطِني","نعم إنَّه قَبري نعم إنَّه قَبري",35,"ر",2,0],["أَأَقْتلُكُمْ بِطَرْفي أَمْ بِعِطْفِي","فَقُلْتُ بِمَا تَشَا فَالكُلُّ ذابِلْ",36,"ل",1,0],["أَُأُقبِحتَ عنديض حَتَّى تُلام","وحتى تُساءَ وحتى تُسَب",37,"ب",1,0],["أأقتبس الضياء من الضباب","وألتمس الشراب من السراب",38,"ب",1,1],["أأقصرُ عن مدى كرم وفضل","وآبائي ملوك لن تُسامى",39,"م",2,0],["أأقصدنْ عنهم جناباً يسدي","وهم مناي وجميع قصدي",40,"د",2,0],["أأقْتَلُ في حِجاج بيّنَ عَمْرو","وَبَيْنَ خَصِيمِهِ عَبْدِ العَزِيزِ",41,"ز",1,1],["أأقْتُلُ مُسْلما في غير جُرْم","فَليْسَ بنا فِعِي ما عشتُ عيْشي",42,"ش",2,0],["أأقعد بعد ما رجفت عظامي","وصار الموت أقرب ما يليني",43,"ن",2,1],["أَأُقيمُ مُحتَمِلاً لِضيمِ حَوادِثٍ","مَعَ هِمّةٍ مَوصولَةٍ بِالفَرقَدِ",44,"د",1,0],["أأقصد غير بابك يا إلهي","وأطلب غير نائلك الغزير",45,"ر",1,0],["أأقوى غراما منه حيث ذكرته","أم الشعر قد ألجا إلى ذلك الشعر",46,"ر",1,0],["أأقربُ من فكري وذكري وخاطري","فأمضي له ظهراً وأحدُو به سَفرا",47,"ر",2,0],["أَأُقاتِلُ الحَجّاجَ عَن سُلطانِهِ","بيدٍ تُقِرُّ بِأَنَّها مَولاتُهُ",48,"ت",2,1],["أَأَقولُ جارَ عَلَيَّ إِنّي فيكُمُ","لَأَحَقُّ مَن جارَت عَلَيهِ ولاتُهُ",48,"ت",2,0],["أأقول شعري كفء جودك لا","والله ليس القول كالعمل",49,"ل",1,0],["أَأَقول فيكَ سميدع كلّا وَلا","حاشا لمثلك أَن يقال سَميدع",50,"ع",1,0],["أأقنع بالمر النقيع وأرتوي","وبالقرب مني سلسبيل وسلسال",51,"ل",1,0],["أأقول ان بعالم السّبع العُلا","مَثَلاً أيضا هي شطر ما أبدعته",52,"ت",2,0],["أَأُقَضّي الحَياةَ حافِظَ عَهدي","في التَنّائي وَأَنثَنى في التَداني",53,"ن",2,0],["أَأَقول كَيفَ أَرد ظا","لمتي وَلَم أَتَجَشَّمِ",54,"م",1,0],["أأقل من شم يكافئني على","زفرات أنفاسي وطول حنيني",55,"ن",2,0],["أأقضي العمر أرجو ودهم","بين عذر منهم أو عذل",56,"ل",1,0],["أأقاسي بُعدين بعداً من اليأ","س على قربكم وبعد الديار",57,"ر",1,0],["أأقول كلا والعيان مكذبي","كلا بل المفتي أسير السائل",58,"ل",1,0],["أأقيس جودك بالمكارم كلّها","من قاس بالذهب الصعيد الأغبرا",59,"ر",2,0],["أأقصى ويُدنى مَن يُقَصِّرُ رأيه","ومن ليس يُعني عنكَ مِثلَ غنائيا",60,"ي",2,0],["أأقول صبراً لا وصبرك إن لي","جزعاً وصبرك لا يزال جميلا",61,"ل",2,0],["أَأَقصدُ غَيرَهُ في الأَمرِ يَوماً","وَأَعلَمُ أَنَّهُ لِلَّهِ وَحدَه",62,"د",2,0],["أَأَقصدُ بعد اللَهِ غيرَك في الوَرى","وَأَنتَ على الأَكوان ناهٍ وَآمِرُ",63,"ر",1,0],["أَأَقضي دونَ طيبَةَ مُستَهاماً","وَقد نَوَّلتَني المِننَ الرغابا",64,"ب",2,0],["أأقوى على عدٍّ لأوصافك التي","أرى البعض منها ليس يحصى له عدُّ",65,"د",1,0],["أأقْدم ما عتادي غير قلبي","فأغنم هل إذا أقدمت نصرُ",66,"ر",1,0],["أَأَقُولُ: يا زَمَنِي بَخِلْتَ؟! وهَل","هُو (حاتِمٌ) لِيَجُودَ, أَو (مَعْنُ)؟!",67,"ن",1,0],["أَأَقُولُ لِلمَوتِ: انتَصَرتَ؟ وفي دَمِي","جَمرٌ بِ(بُرقَةِ ثَهمَدٍ) مَزرُوعُ؟",68,"ع",1,0],["أأقل مِن ..\"دعدٍ \" أنا أو من \"سعاد\"؟","أنا التي من ألف \"ليلى\".. أشعَرا",69,"ر",2,0],["أَأقولُ جَهراً أنّ ضَيغمَ حَيِّنا","قد صارَ مَيتاً بعدَ أن ذاقَ العِلَلْ",70,"ل",1,0],["أ أقولُ بَعضَ مَقالةٍ منسوبةٍ","لذوِي الهوَى إذْ جرّبُوا بَلْوَاهُ",71,"ا",2,0],["أ أقدُّ فلسفةَ الجُنونِ كأنني","طينٌ وصحراءٌ تُطِلُّ من السماءْ",72,"ا",2,0],["أأقول ُ مُرتجفا ً لديك ِ : مبارك ٌ ..","عيد ٌ سعيد ٌ .. والمطاف ُ توهّنا !!",73,"ن",2,0],["أأقسد الشيب في فوديه أم قسطا","لما رمى بالدواهي جعده القططا",74,"ط",2,1],["أ، ا قاعد في منزلي كمداً","كالطائر المقصوص في قفس",75,"س",1,0],["أأقولُ سافرت العذارى","أم قول ذلك يستحيل",76,"ل",1,0],["أأقول أحلامي انتهتْ؟","فغدوتُ بالأوهامِ حائرْ؟",77,"ر",1,0],["أأقولُ في عينيكِ منفايَ الَّذي","بفمِ البعادِ على التبصُّرِ جارا",78,"ر",2,0],["أَأُقيمُ في حُلم الهوى وأذيعُه","أم أن حُلمي في القلوبِ غريبُ ؟!",79,"ب",1,0],["أَأقُولُ أَنَّك يَا حبِيبُ جَفوتَنَا","لِنسيَر فِى دَربِ الغياهِبِ والظَّلام",80,"م",1,0],["أأقول دمّرنا حضارتنا","حتى طمسنا بصمة النَسَبِ",81,"ب",1,0],["أ أقول قصة مرسل في رهطه!!...","باعوه يالقساوة الإفلاس!!",82,"س",1,0],["أأقول مد لي الغرور عنانه","فركضت في شوطي صبا وتصابي",83,"ب",2,0],["أأَقضي ولم تُزهرْ بقلبي نبْتةٌ","ولا نسمةٌ عندَ الأصيلِ تُداعبُ",84,"ب",1,0],["أأقنعُ النفس بالإغضاء عنْ وَجع ٍ","أحُسُّهُ مستمرّ الطرْقِ في كَبِدي",85,"د",2,0],["أأقُولُ لولا الدهرُ أمْ لولايَ أمْ","؟ لا قُلْ : لَعَمْرُ اللهِ بَلْ لولاكِ",86,"ك",1,0],["أأقول أني عاشق","أنا عاجز حتى عن",87,"ا",3,0],["أ أ قعد في البيوت وفيَّ عزمٌ","على المشي السريع إلى الجبالِ؟",88,"ل",1,1],["أأقولُ شمسٌ في الضُّحى","أم ذَاكَ بدرٌ في السَّحرْ",89,"ر",1,0],["أأقولُ وردٌ راحَ يُس","كِرُ سامِراً وقتَ السَّمَرْ",89,"ر",1,0],["أأقولُ للكلبِ العقور تأدُّباً:","دغدِغْ بنابك يا أخي أشلائي ؟",90,"ا",2,0],["أأقولُ للقوّاد يا صِدِّيقُ، أو","أدعو البغِيَّ بمريمِ العذراءِ ؟",90,"ا",2,0],["أأقولُ للمأبونِ حينَ ركوعِهِ:","\"حَرَماً\" وأمسحُ ظهرهُ بثنائي ؟",90,"ا",2,0],["أأقول لِلّصِ الذي يسطو على","كينونتي: شكراً على إلغائي ؟",90,"ا",2,0],["أأقول مرحى والنفوس كليمة","وصدورنا ، أجسادنا أشلاء",91,"ا",2,0],["أأقولُ : إنكَ قد سكنتَ بخاطري؟","فالأمرُ حقٌَ لا يُفيدُ دليلُ",92,"ل",1,0],["أأقولُ : أنّ الفكرَ مشغولٌ بكم","أو تجهلونَ بأنّه مشغولُ؟!",92,"ل",1,0]]}