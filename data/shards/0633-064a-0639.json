ر",1,0],["سَيُعنى بِما ضَيَّعتَ مِنِّيَ حافِظٌ","وَيُلفى لِما أَرخَصتَ مِن خَطَري مُغلي",3,"ل",2,0],["سيعلم كلّ من ذوي المال في غدٍ","إذا نصب الميزان من يشتكي الفقرا",4,"ر",2,0],["سيعلم الفَدمُ أني غيرُ تاركهِ","إلا وخُرْطومُهُ بالشتم معلوبُ",5,"ب",1,0],["سيعلم إن لم ينزجر عنك أنه","كطارف عَيْنَيْ نفسه وهو عامدُ",6,"د",1,0],["سيعطفه أني محقٌّ وأنه","حكيمٌ وأن العدلَ من حالِ بالهِ",7,"ل",2,0],["سيعود المجد القديم لايرا","ن فتفضى الى اليقين الظنون",8,"ن",1,0],["سيعزم الشعب على","النهوض ثم يعزم",9,"م",1,0],["سيعيدن لي اذا","سرت حريتي السفر",10,"ر",1,0],["سَيعْلَمُ الجَمعُ ممّنْ ضَمّ مَجلِسُنا","بأنّني خَيرُ مَنْ تَسْعَى بهِ قَدَمُ",11,"م",1,0],["سَيَعلَمُ قَومي أَنَّني بِمَفازَةٍ","فَلاةٍ نَفَت عَنها الهَجينَ فَأَرتَعا",12,"ع",2,0],["سَيَعلَمُ مَن سامى تَميماً إِذا هَوَت","قَوائِمُهُ في البَحرِ مَن يَتَخَلَّفُ",13,"ف",1,0],["سَيُعرَضُ عَن ذِكري وَتُنسى مَوَدَّتي","وَيَحدُثُ بَعدي لِلخَليلِ خَليلُ",14,"ل",1,0],["سَيَعلَمُ مُرَّةَ حَيثُ كانوا","بِأَنَّ حِمايَ لَيسَ بِمُستَباحِ",15,"ح",1,1],["سَيَعلَمُ الهَجرُ أَنّا مِن إِساءَتِهِ","وَظُلمِهِ بِالوِصالِ العَذبِ نَنتَقِمُ",16,"م",1,0],["سيعيدُ اللهُ كلاًّ منهمُ","وسيجزي فاعلاً ما قدْ فعلْ",17,"ل",1,0],["سَيعلَمُ قومُنا أنّا وَفَيْنا","وأنّا قد كَفَيْنا ما يَلينا",18,"ن",2,0],["سَيَعرِفُنا التاريخُ إِن كانَ جاهِلاً","وَيَقضي لَنا بِالفَضلِ مَن جاءَ يَبتَلي",19,"ل",2,0],["سَيَعلَمُ القَومُ عُقبى الخائِنينَ وَما","جَنى الغُرورُ وَجَرَّ الجَهلُ وَالخَرَقُ",20,"ق",1,0],["سَيَعلَمُ مَن خانَ الخَليفَةَ أَنَّهُ","مُواقِعُ أَمرٍ شَرُّهُ مُتَفاقِمُ",21,"م",1,0],["سَيَعلَمُ كُلُّهُم أَنّي مُسِنٌّ","إِذا رَفَعَت عَناناً عَن عِنانِ",22,"ن",1,0],["سيعلمُ مَن ناواك كيف مصيرُهُ","ويُبْصِرُ مَن قارعتَهُ كيفَ يُقْرَع",23,"ع",1,0],["سيَعْبَقُ في ثوبِ الخليفةِ طيبُهَا","وما نَمّ كافورٌ عليه ولا نَدُّ",24,"د",1,0],["سَيَعلَمُ ذاكَ المُدَّعي صَحَّةَ الهُدى","مَتى كانَ حَقٌّ أَيُّنا كانَ أَخسَرا",25,"ر",2,0],["سيعلم قومي إن هلكت مصيبتي","إذا ما الغيوظ لم تحلل حقودها",26,"د",3,0],["سيعقب هَذا الليل فجر ينيره","بصدق وبعض الفجر يظهر بالكذب",27,"ب",