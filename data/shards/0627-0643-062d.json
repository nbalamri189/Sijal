{"poems":[[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[275,"يا جنة الحسن حر الصيف أمحلك","https://www.aldiwan.net/poem35314.html","البسيط"],[376,"ما يتجلى وجهه ماثلا","https://www.aldiwan.net/poem57212.html","البسيط"],[469,"باحت بنجد وهوى غزلانها","https://www.aldiwan.net/poem3273.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83266","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63731","الخفيف"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61052","الرمل"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99395","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110050","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73413","المواليا"],[5092,"تُسائلني إجاباتي","https://www.poetsgate.com/ViewPoem.aspx?id=139682",""],[5458,"تأشيرة سفر إلى الجنة (من مذكرات طفل فلسطيني)","https://www.poetsgate.com/ViewPoem.aspx?id=72161",""],[5523,"وقفات","https://www.poetsgate.com/ViewPoem.aspx?id=201355",""],[5725,"هاك قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=177424",""]],"verses":[["أَكحلُ الجفنِ أدعجُ العينِ نجلا","شُكلةٌ في سوادها هدباءُ",0,"ا",2,0],["أكحّلتكِ التي ربّتكِ ناعمةً","أَم الغزالُ الذي رَبَّيتِ كحّلك",1,"ك",1,0],["أكحِل جُفوني بالكَرى مرةً","حتى تكونَ الأكحلَ الكاحِلا",2,"ل",2,0],["أكحلها ساحرها أحورها","قاتلها فاترها فتانها",3,"ن",3,0],["أَكحَلُ الطَرفَ مُستَديرُ المُحَيّا","لاحَ فيهِ الهُدى وَجالَ الحَياءُ",4,"ا",2,0],["أكحلٌ طَرْفُهُ وما مَسَّ كُحْلاً","عَطِرٌ جَيْبُهُ وما مسَّ عِطرا",5,"ر",2,0],["أكحل الطرف صَفوه وَبِما","نوع القَتل صَفوه أخيفا",6,"ا",1,0],["أكحيلة الاجفان بالسحر الذي","لولاه مادرت البلابل بابل",7,"ل",1,1],["أُكحُلِ العينَ قبلَ تَعمى فما تَن","فَعُ يوماً بعدَ العَمَى الاَكحالُ",8,"ل",1,0],["أَكحَل أَوطَف أَهيف أَحمَر أَحوى أَحوَر","أَغنٌّ أَلمى رَخيمُ الحسِّ رَشيقٌ أَسمَر",9,"ر",1,1],["أكحِّلُ عينَ ذكرانا","بأصداءِ الحكاياتِ",10,"ت",1,0],["أكحل مقلتي بدم بريءٍ","لأهل الخلد فواحاً بطيب",11,"ب",1,0],["أَكحِيلة العَينينِ وهْي خليقةٌ","وشبيهةَ الأقمارِ وهْي قلائلُ",12,"ل",1,0],["اكحلُ العين مالنا عنك سلْوٌ","إنْ سعى فيك بالغرامِ بديل",13,"ل",1,0]]}