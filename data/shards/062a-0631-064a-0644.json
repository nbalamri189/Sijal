poem/144284","البسيط"],[4329,"","https://poetry.dctabudhabi.ae/diwan/poem/79783","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83148","الرجز"],[5038,"غنّى الهزار","https://www.poetsgate.com/ViewPoem.aspx?id=189332",""],[5064,"الرُّوح","https://www.poetsgate.com/ViewPoem.aspx?id=199136",""],[5083,"طيَّاتُ العَبير","https://www.poetsgate.com/ViewPoem.aspx?id=53771",""],[5091,"ألا يا مستنيص العيش كدا","https://www.poetsgate.com/ViewPoem.aspx?id=186590",""],[5183,"البدوي والوهم","https://www.poetsgate.com/ViewPoem.aspx?id=180279",""],[5410,"آهات","https://www.poetsgate.com/ViewPoem.aspx?id=144495",""],[5431,"هو الوعظُ!","https://www.poetsgate.com/ViewPoem.aspx?id=213735",""],[5433,"ياطير","https://www.poetsgate.com/ViewPoem.aspx?id=36115",""],[5582,"أَلا ما لِدَمْعِكَ يَجْرِي طَلَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=187236",""],[5606,"تعال ارسم البسمه","https://www.poetsgate.com/ViewPoem.aspx?id=197605",""],[5756,"غرام احباب","https://www.poetsgate.com/ViewPoem.aspx?id=5423",""],[5875,"تعالي","https://www.poetsgate.com/ViewPoem.aspx?id=27771",""],[463,"أما والنقا لولا هوى ظيبة َ النقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60160&r=&rc=216",""],[463,"رعتْ بينَ حاجرَ والنِّعفِ شهرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60070&r=&rc=126",""],[463,"سقى أيَّامَ رامة َ بل سقاها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60273&r=&rc=329",""]],"verses":[["تَرى لَهُمُ المَزايا إِن أَرَمّوا","وَإِن نَطَقوا رَأَيتَ لَنا المَزايا",0,"ا",3,0],["تَرى لِلقَوافي وَالسَماءُ جَلِيَّةٌ","عَليكُم بُروقٌ جَمَّةٌ وَرِعادُ",1,"د",1,0],["تُرَى لِهذا السّيْرِ منْ مُنْتَهى","بِناءُ أعْضائِي بهِ قدْ وَهَى",2,"ه",2,1],["تَرى لِلُّؤمِ بَينَ سِبالِ تَيمٍ","وَبَينَ سَوادِ أَعيُنِهِم كِتابا",3,"ب",2,0],["تَرى لِمَجَرِّ النِسعَتَينِ بِجَوزِها","مَوارِدَ حِرمِيٍّ لَهُنَّ طَريقُ",4,"ق",1,0],["تَرى لِحَبِيِّيهِ رَباباً كَأَنَّهُ","غَوادي نَعامٍ يَنفُضُ الزِفَّ جافِلُه",5,"ل",2,0],["تَرى لِلمُسلِمينَ عَلَيكَ حَقّاً","كَفِعلِ الوالِدِ الرَؤوُفِ 