للعُفاةِ بأبوابه","مَطيّاً مُناخاً وخَيلاً صُفونا",31,"ن",2,0],["تَرى للَّيالي دائماً من صِغارِها","بكّفِّ الثريّا سِتّةً كالنّموذَج",32,"ج",1,0],["تُرى لِحَنيني أَو حَنينِ الحَمائِمِ","جَرَت فَحَكَت دَمعي دُموعُ الغَمائِمِ",33,"م",1,1],["ترى لخرير الماء في أرجائه","كأرغن شادٍ صوته يتلجلج",34,"ج",1,0],["ترى لكسوف الشمس أعظم حرقةٍ","كما لخسوف البدر أخسر صفقة",35,"ه",1,0],["ترى لَعِبَ البِلى بالدار جِدًّا","فيلعب أو يجدّ بها بكاها",36,"ا",3,0],["تُرِي لك إكثارَها قِلّةً","ومنك كثيراً جداك الطفيفا",37,"ف",2,0],["ترى للندامةِ في صحفتي","ه سطراً مبيناً وللذلِّ سطرا",38,"ر",2,0],["تَرى لَهم كلّ يومٍ مِن مدرّبهم","بِخدمةِ الحربِ تَجريباً وإمعانا",39,"ن",2,0],["ترى لكل هلال من مراكبها","خيط المجرة مجروراً على اللقب",40,"ب",1,0],["تَرى للعلوم بها مورِداً","رياضاً تَرِفُّ وماءً زُلالا",41,"ل",2,0],["ترى لامع الأنوار فيها كأنه","إذا اعترضته العين وشي مدّنرُ",42,"ر",1,0],["ترى لابسي نَسجَ الحديد ِكأنّهم","وراءَ الدّروعِ العودِ غُبرُ الضّراغِمِ",43,"م",1,1],["ترى لوعةً تقتضي لوعةً","وليلاً يطولُ ولا يَقْصُر",44,"ر",1,0],["تُرى له من مُعين","لديك أو من شفيع",45,"ع",1,0],["تُرَى لَيْتَ شِعْرِي كَيْفَ حَلَّ لَهُ دَمِي","وَمَنْ ذَ الَّذِي أَفْتَاهُ فِي قَتْلِ مُسْلِمِ",46,"م",1,0],["تَرى لَهُنَّ مِنَ الوَر","دِ شَوذَراً وَخِمارا",47,"ر",2,0],["تَرَى لَهُ بَرَانِساً وَيَلْمقا","دُبْساً وَنُمْراً فِي شَمِيط أَبْرَقا",48,"ق",2,0],["تَرَى لَهُ في كُلِّ يَوْمٍ حاصِرَا","وِرْداً مِنَ الحَقِّ وَحَقّاً صادِرا",49,"ر",2,0],["تَرَى لَهُمْ ضَوْءَ ضِياءٍ مُضْرَحا","وَالقَمَرَيْنِ وَالنُجُومَ اللُوَّحا",50,"ح",2,0],["ترى لهم حلماً وفضلاً على الرّضى","وإن أسخطوا داوَوا من الجهل بالجهلِ",51,"ل",1,0],["ترى لها في فم الابريق بارقة","ليلاً إذا ما هوى في الكوب كوْكبُها",52,"ب",3,0],["ترى للمكارم والأكرمين","في مصطفى المجد نشراً ولف",53,"ف",1,0],["ترى ليس في الأكوان من نهجه الهدى","من الناس إلا أصبحوا هم هداتها",54,"ت",3,0],["تَرى لِمُبيناتِ الخَراعَةِ راقِباً","حِذارَ الطَواغي وَالعَفافُ رَقيبُها",55,"ب",3,0],["ترى للقمل في كلِّ","شقاعٍ مائتي وكرِ",56,"ر",1,0],["تَرى لِأَخلافِها مِن خَلفِها نَسلاً","م