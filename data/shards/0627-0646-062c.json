ث لهما","https://www.aldiwan.net/poem23519.html","البسيط"],[46,"إرمنا يا ظلام في كل فج","https://www.aldiwan.net/poem23618.html","الخفيف"],[68,"إن جزت بحي ساكنين العلما","https://www.aldiwan.net/poem1529.html",""],[68,"إن جزت بحي لي على الأبرق حي","https://www.aldiwan.net/poem1537.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85685","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85381","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85575","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30442","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54717","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54633","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141987","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141951","السريع"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43720","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54325","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54247","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[106,"شبل بشبل","https://www.poetsgate.com/ViewPoem.aspx?id=179705",""],[106,"نعي الشتاء !!","https://www.poetsgate.com/ViewPoem.aspx?id=179458",""],[106,"ناصر الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179359",""],[67,"حَيَّ بُلْبَيْسَ مَنْزِلاً في العِمارهْ","https://www.poetsgate.com/ViewPoem.aspx?id=14533",""],[90,"علموها!","https://www.poetsgate.com/ViewPoem.aspx?id=179031",""],[45,"أَنْتَ الرَّبيعُ الَّذي تَحْيَا الأَنَامُ به","https://www.poetsgate.com/ViewPoem.aspx?id=32029",""],[45,"كَمْ من وُقُوفٍ على الأطلال وَالدِّمَنِ","https://www.poetsgate.com/ViewPoem.aspx?id=32011",""],[51,"إن جاء من يبغي لها منزلاً","https://www.poetsgate.com/ViewPoem.aspx?id=29976",""],[85,"ما باتَ يُثني على علياكَ إنسانُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9735&r=&rc=225",""]],"verses":[["اِنجُ فَعَن لَفتَتِكَ الرُمحُ الأَصَم","ناشَذتُكَ اللَهَ وَتَحنانَ الرَحِم",0,"م",1,0],["أَن جَعَلتُ القَلبَ مَرمىً","كَثُرَت فيهِ السِهامُ",1,"م",1,0],["إِن جُدتَ بي فَليَندَمَن","مَن كانَ بي يَوماً جَوادا",2,"د",2,0],["اِنجُ مِن رَوعاتِ أَيّا","مٍ وَغاراتِ خُطوبِ",3,"ب",1,0],["إن جالَدوا لَفَظَ السّيوفَ جُفونُها","أو جاوَدوا غَمَرَ الضّيوفَ جِفانُ",4,"ن",1,0],["إِنَّ جُهدَ البلاءِ حُبُّكَ إِنسا","ناً هَواهُ بِآخَرٍ مَشغولُ",5,"ل",1,1],["أَنجَبَ أَيّامُ والِدَيهِ بِهِ","إِذ نَجَلاهُ فَنِعمَ ما نَجَلا",6,"ل",2,0],["إِن جاءَ ذو جاهٍ بِمَحمَدَةٍ","وَتراً شَآهُ بِمِثلِها شَفعا",7,"ع",2,0],["أَنجَبتَ أَربَعَةً سادوا بِأَربَعَةٍ","فَضلٍ وَنُبلٍ وَإِحسانٍ وَعِرفانِ",8,"ن",1,0],["أَنَجاةٌ مِنَ القِطارِ مِنَ الجِس","رِ مِنَ النَهرِ جَلَّ رَبُّ الأَنامِ",9,"م",1,0],["إنْ جاعَ في شِدّةٍ قَومٌ شَرِكتَهُم","في الجوعِ أو تَنجلَي عنهم غَواشيها",10,"ي",3,0],["إِنْ جُلِيتْ كُنُوزُهَا الدَّفِينَهْ","لَيْسَ النِّسَاءُ صُوَراً لِلزِّينَهْ",11,"ن",2,0],["أَنْجَزَ وَعْداً فِيهِ الصَّفَاءُ فَلَمْ","يَشِبْهُ غَيْرُ الوَعِيدِ مِنْ عُمَرِ",12,"ر",1,0],["إِن جاءَهُ مُرتَغِباً سائِلٌ","آلَت إِلَيهِ رَغبَةُ السائِلِ",13,"ل",1,1],["إِن جاوَرَتهُنَّ لَم يَأخُذنَ شيمَتَها","وَإشن وَشَينَ بِها لَم تَدرِ ما الغَضَبُ",14,"ب",1,0],["إن جسمي وجناني","للملاح عند أمانا",15,"ن",2,0],["إن جَنَّ ليل جُنَّ من فرط الأسى","وسوى كلامك ما له من راقِ",16,"ق",1,0],["أنجمها الزُهر غير سائرة","كأنما كل كوكب قُطُب",17,"ب",1,0],["أنجبته أصول نخلة حتى","أطلعته للمجد طلعاً نضيدا",18,"د",2,0],["إن جفتنا بلادنا فهي حبّ","ومن الحب يستلذّ الجفاء",19,"ا",2,0],["أَنجَحتَ حاجَتَنا الَّتي جِئنا لَها","وَكَفَيتَ حاجَةَ مَن تَرَكتُ وَرائي",20,"ا",2,0],["إن جود الأنام كان جميعاً","يوم راحوا منية الفياض",21,"ض",1,0],["إن جاد أرضاً لفظُهُ فكأنما","نبتت لسكر عقولنا أعنابا",22,"ب",2,0],["أنجدنا جوداً فأمداحنا","ما بين إتِّهامٍ وإنجاد",23,"د",1,0],["أنجلَ العلى قابلتني ساعة العلى","مقابلةً لاقى بها القلبَ جبره",24,"ر",2,0],["أنجم قلتها أوان مشيبي","فهي لا شك أنجم الأسحار",25,"ر",1,0],["إن جادَ فالمزن في العافين منسفحٌ","أو جالَ فالدَّمُ في العادين منسفك",26,"ك",1,0],["أنجمي عندك سعد","وقناديل مضيّه",27,"ي",2,0],["إن جاءَ وسميّها سريعاً","فالآن قد جاءَها الوليّ",28,"ي",1,0],["إن جَنْبي عن الفِراش لَنابٍ","كتجافي الأسرِّ فوق الظِّرابِ",29,"ب",1,0],["أنْجِز مواعدك التي قدَّمتَها","يا مُسدِيَ النُّعمى بغير مَواعِدِ",30,"د",1,1],["إن جاء يفخر بالعباس والده","فقل فخرت بشيخٍ أرملٍ ذكر",31,"ر",1,0],["إن جديد المطل مستقبح","وأقبح المطلين مطل خلق",32,"ق",1,0],["إن جفون السيوف أكثرها","أسود والحق غير مختلق",33,"ق",1,0],["إن جاء من يبغي لها منزلاً","فقل له يمشي يستنشقُ",34,"ق",1,1],["أنجِز الوعدَ إنَّ خيرَ مواعي","دِك ما جاءَ خَلْفه مصداقُكْ",35,"ك",1,1],["إنَّ جوْراً عمومُك الناسَ بالفض","لِ سوى واحدٍ مُحقّ فعدْلا",36,"ل",2,0],["أنجى الإلهُ من المريخ زهرتكم","ومشتريكم فقد أنجاهُ من زحلِ",37,"ل",1,0],["أنجِز مواعيدَ قد شُدَّت مَعاقدها","شَدَّ المواثقِ إِنَّ الخُلفَ قد لُعنا",38,"ن",2,0],["إِنَّ جَريراً شِهابُ الحَربِ يَسعَرُها","إِذا تَواكَلَها أَصحابُهُ وَقَدا",39,"د",2,0],["إِن جَبُنَت في القِتالِ أَنجَدَها","أَو ضَعُفَت في النِزالِ قَوّاها",40,"ا",3,0],["ان جميع الكون بالشر","البغيض مفعم",41,"م",1,0],["ان جاءت الارض امراً","فللسماء القضاء",42,"ا",2,1],["انجبته مصر وكم انجبت مصر","رجالا عادوا لها بالفخار",43,"ر",1,0],["ان جد بين الغي يوما والهدى","حرب فاين من الوغى ابطالها",44,"ل",3,0],["إن جاءَ يا أمُّ بعد موتي","فالتمسي أن يزور قبري",45,"ي",1,0],["إن جاء يا أم بعد دفني","فخبِّريه أني انتظرته",45,"ه",1,0],["إن جنَّه الليل أدمت خدّه يده","وأنهدّ من سورة الأشجان مضجعه",46,"ع",2,0],["أَنجى لَكَ اللَهُ أَنجالاً يُهَيِّئُهُم","لِرِفعَةِ المُلكِ إِقبالٌ وَعِرفانُ",47,"ن",1,0],["إِن جَلَّ ذَنبي عَنِ الغُفرانِ لي أَمَلٌ","في اللَهِ يَجعَلُني في خَيرِ مُعتَصِمِ",48,"م",1,0],["إِنجِلتِرا وَجَيشَها وَلوردَها","مَسلولَةَ الهِندِيِّ تَحمي هِندَها",49,"د",3,0],["أَنجُمٌ مَطالِعُها","عابِدينُ وَالرَحَبُ",50,"ب",1,0],["إِنَّ جُهدَ الوَفاءِ ما أَنتَ آتٍ","فَليَقُم في وَقائِكَ الخُدّامُ",51,"م",1,0],["إِن جِئتَ مَرمَرَةً تَحُثُّ الفُلكَ في","بَهجٍ كَآفاقِ النَعيمِ ضَحوكِ",52,"ك",1,0],["إن جود الوسمي بل زبد البح","ر ترامى عبابُه بحَباب",53,"ب",1,0],["إِن جاوَرَ النيلَ جارى النيلَ غالِبُهُ","أَوحَلَّ بِالسيبِ زُرنا مالِكَ السيبِ",54,"ب",1,0],["إِن جَرى طالِباً نِهايَةَ فَخرٍ","أَحرَزَ السَبقَ فائِتاً أَصحابَه",55,"ب",2,0],["أُنجُ مِنَ الحُبِّ فَإِنَّ الَّذي","لَم يُردِهِ الحُبُّ هُوَ الناجي",56,"ج",2,0],["أَنجَحَ ما قَدَّمَ مِن مَوعِدِ","مُشَيَّعٌ يُصدِرُ ما أَورَدَه",57,"د",2,0],["إِن جَرى بَينَنا وَبَينَكِ هَجرٌ","وَتَناءَت مِنّا وَمِنكِ الدِيارُ",58,"ر",1,0],["أَنجَبَتهُ أَحرارُ فارِسَ حُرَّ النَف","سِ وَالبَيتُ خَيرُهُ أَحرارُه",59,"ر",2,0],["إِن جِئتُموها فَلَيسَت بِكرَ أَنعُمِكُم","وَلا بَدِئَ أَياديكُم إِلى اليَمَنِ",60,"ن",1,0],["إِن جُثَّتِ الحَركاتُ","مُستَفعِلُن فاعِلاتُ",61,"ت",1,0],["إِن جِئتَ سَلعاً فَسَل عَن جَيرَةِ العَلَمِ","وَاِقرَ السَلامَ عَلى عُربٍ بِذي سَلَمِ",62,"م",1,1],["إِن جُزتَ بِالمَيطورِ مُبتَهِجاً بِهِ","وَنَظَرتَ ناضِرَ دَوحِهِ المَمطورِ",63,"ر",1,1],["أَنجومُ رَوضٍ أَم نُجومُ سَماءِ","كَشَفَت أَشِعَّتُها دُجى الظُلماءِ",64,"ا",2,1],["إِن جالَ ماءُ الحَيا في خَدِّها خَجِلَت","وَإِن تَرَدَّدَ في أَجفانِها اِتَّقَحَت",65,"ت",1,0],["أنجُ منها وامضِ عنها","أخذت قلبك غيله",66,"ل",2,0],["أنَجَاءٌ تَخرِقُ الخَرْقَ به","كَابَدَتهُ مِنكِ أَم مَضغُ الكبود",67,"د",1,0],["إِن جَدَّ رَدَّ الخُطوبَ تَدمى وَإِن","يَلعَب فَجِدُّ العَطاءِ في لَعِبِه",68,"ب",2,0],["إنْ جزْتَ سلعاً فسلْ عن","ظَبْيٍ منَ الظبْيِ أَحْسَنْ",69,"ن",1,1],["أنجمَ الدينِ مثلُكَ مَنْ تسلَّى","إذا قُدحت منَ النوبِ العظامُ",70,"م",1,0],["إِن جَفَتني اليَومَ هِندٌ","بَعدَ وُدٍّ وَاِقتِرابِ",71,"ب",1,0],["إِن جادَ جادَ هُناكَ حاتِمُ طَيِّئٍ","أَو صالَ صالَ رَبيعَةُ بنُ مُكَدَّمِ",72,"م",1,0],["إن جلَّ ما أبصرتَ من أحداثهم","فَستُبصرُ الحدثَ الأجلَّ الأعظما",73,"م",2,0],["إن جلّ خطبُ المسلمين فإنّه","دينُ الزّمانِ وسُنّةُ الحَدَثانِ",74,"ن",1,0],["إنّ جَبْراً والدَّعاوَى جمّةٌ","لَفَتاها حين لا ترجو اعتصاما",75,"م",2,0],["إنجيلُه نَشْرُ السّلا","مِ ودينُه أَخْذُ القليلْ",76,"ل",1,0],["أَنجدوا مِصرَ إِذا ما فَزِعَت","وَأَهابَت بِالكُماةِ الباسِلينْ",77,"ن",1,0],["إن جَلَّ غُنْمُ المسلِمينَ بخيبرٍ","فَلَما غَنِمْتِ أجلُّ منه وأكبرُ",78,"ر",1,1],["إن جدَّ جِدُّ الضربِ فهو مُهَنَّدٌ","أو جَنَّ ليلُ الخطبِ فهو شِهابُ",79,"ب",1,0],["أنجب الدهر في ظلالك عصراً","نابه الذكر في العصور شهيرا",80,"ر",2,0],["إِن جَدَّدَت بِالمِزاجِ حِليَتَها","جَدَّدَت شُرباً يَسومُها العَطَلا",81,"ل",2,0],["إِن جاءَني فيهِ العَذولُ بِشُبهَةٍ","صَدَعَ الغَرامُ بِنَصِّهِ وَقِياسِهِ",82,"س",2,0],["إِن جُدتَ لي فَبِحَقٍّ أَو بَخِلتَ فَما","أَكونُ أَوَّلَ صَبٍّ ماتَ عَن أَمَلِ",83,"ل",1,0],["إِن جاءَ في اللَيلِ تَجَلّى وَإِن","جاءَ صَباحاً زادَهُ نورا",84,"ر",2,0],["إنْ جاءَ بعْدَ المُرسلينَ فَفَضْلُهُ","مِنْ بعدِه جاءَ المَسيحُ وَنُوحُ",85,"ح",1,0],["إنْ جَهِلْتُمْ ما حَلَّ في ساحلِ الشي","خِ مِنَ الصّفحِ فاسْألُوا البَحَّارَهْ",86,"ر",2,0],["إِن جِئتُ لَم تَأتِ وَإِن لَم أَجِئ","جِئتَ فَهَذا مِنكَ لي دابُ",87,"ب",1,0],["إِن جِئتَ زائِرَها غَنّاكَ طائِرُها","بِرَجعِ أَلحِنَةٍ في صَوتِها هَدَلُ",88,"ل",1,0],["إِن جازَ آباؤُهُ الأَنذالُ في مُضَرٍ","جازَت فُلوسُ بُخارى في الدَنانير",89,"ر",1,0],["أَنجِزي ما وَعَدتِ أَو","أَنجِزي مِنكِ مَوعِدا",90,"د",2,0],["أَنجِزي يا سَلامَةُ المَوعودا","وَتَصابَي وَلا تُطيعي الحَسودا",91,"د",2,1],["أَنجَزَ حُرٌّ وَأيَهُ طائِعاً","وَالعَبدُ مَكدودٌ وَمَضروبُ",92,"ب",1,0],["إِن جَدَّ عالَمُكَ الأَرضِيُّ في نَبَإٍ","يَغشاهُمُ فَتَصَوَّر جِدَّهُم لَعِبا",93,"ب",2,0],["إِن جادَ بِالمالِ سَمَحٌ يَبتَغي شَرَفاً","آلَت مَعاشِرُ ما في كَفِّهِ جودُ",94,"د",1,1],["أَنجُد أَخاكَ عَلى خَيرٍ يَهُمُّ بِهِ","فَالمُؤمِنونَ لَدى الخَيراتِ أَنجادُ",95,"د",1,0],["إِنَّ جِسراً عَلى المَنيَّةِ حَزمٌ","وَالبَرايا مِن عُبشَةٍ فَوقَ جِسرِ",96,"ر",1,0],["إِن جارَتِ الأُمَراءُ جاءَ مُؤَمَّرٌ","أَعتى وَأُجورُ يَستَضيمُ وَيَكلِمُ",97,"م",1,0],["إِن جاءَني الخَطبُ يَجنيهِ بِلا سَبَبٍ","كَيوانُ فَاللَهُ أَرجو رَبَّ كَيوانِ",98,"ن",1,0],["إِنَّ جَهلاً سَلمي لِآل سُلَيمى","وَثَنائي عَلى عِذابِ الثَنايا",99,"ا",3,0],["إنْ جزْتَ بِحيٍّ ساكنينَ العَلَما","من أجلهم حَالي كما قَدْ عُلِمَا",100,"م",2,1],["إن جزْتَ بحيّ لي على الأبْرَقِ حيْ","وابلِغْ خَبَري فإنني أُحْسَبُ حيْ",101,"ي",1,1],["إن جسم المرء للرو","ح الَّتي فيه يَقوتُ",102,"ت",1,1],["أنجزت من دروسها ما به امتا","زت عَلى الغير من بنات الكِرام",103,"م",1,0],["إن جادَلوا لَم يسبوا من يخاطبهم","وإن تراءَت لهم في رأيه ريَب",104,"ب",1,0],["إنْ جاءَ صيفٌ أو تجلَّى ربيعْ","حيَّاهُ منهُ عبقريُّ الغِناءْ",105,"ا",2,0],["أَنْجَبَتْهُ للمعالي أُسْرَةٌ","نَزَلُوا للمَجْدِ أَعْلَى الرُّتَبِ",106,"ب",1,0],["إِنْ جَرَى ذِكْرُهَا غَلاَ النَّاسُ فِي الذَّمِّ","وَمَا كُلِّ قَائِلٍ ذَمَّامُ",107,"م",1,0],["أَنْجَبَتْ قَبْلَكِ الحَوَاضِرُ إِلاَّ","أنَّهَا لَمْ تَجِيءْ بِعَبْدِ الحَمِيدِ",108,"د",1,0],["أَنْجَزْتَ فِي الدُّنْيَا كِتَابَكَ مُعْجَلاً","وَحَمَلْتَ لِلْعُلْيَا أَبَرَّ كِتَابِ",109,"ب",1,0],["إن جرحا سال من جبهتها","لثَمَته بخشوعٍ شفتانا",110,"ن",2,0],["إن جاءت الألحان تسبي النهى","فأي فضل عندها تدعين؟",111,"ن",1,0],["إِن جادَ أَقنى المُعسِرينَ وَإِن سَطا","أَفنى القَنا بِمَوايِرِ الفِرصادِ",112,"د",1,0],["إِن جزتَ إِفراطَكَ يا لائِمي","الحُزنَ أَيضاً جاوَزَ الفَرطا",113,"ط",2,0],["إن جهد الرثاء لوعة راث","في مضامين شعره مرثيّ",114,"ي",1,0],["إِنْ جَفَاهُ الزّمانُ والآلُ والصَحْ","بُ فكونوا لِمِثْله خيرَ آلِ",115,"ل",1,0],["أنجمٌ أشرقت فأطفأها المو","تُ كما تُطفأ المصابيح وهْنَا",116,"ن",2,0],["إن جرد الموتُ نصلاً ما صَمدت له","فطالما ردَّ نصلٌ منك أرواحا",117,"ح",2,1],["أَنجَبتْ للْبِلادِ أبطالَ عَزْمٍ","هُمْ دُرُوعُ البِلادِ في الأَزَمَاتِ",118,"ت",1,0],["أَنْجبَتْ كلَّ عالمٍ بَهَرَ الكَوْ","نَ بآياتِ عِلمِهِ البَيِّناتِ",118,"ت",1,0],["أَنْجَبتْ كلَّ شاعرٍ عَبْقَريٍ","صادِقِ الْحِسِّ بارعِ اللَّفَتَاتِ",118,"ت",1,0],["أنْجبتْ كُلَّ كاتِبٍ يَمْلِكُ السَّمْعَ","بآثارِ فَنِّهِ الْخالِداتِ",118,"ت",1,0],["أنْجبتْ كُلَّ مِدْرَهٍ وخَطِيبٍ","سَاحِرِ القَوْلِ صَادِقِ الحَمَلاتِ",118,"ت",1,0],["إن جُزْتَ يوماً إلى السودانِ فارْع له","مودّةً كصفاءِ الدرِّ مكنونا",119,"ن",2,0],["إن جاء كافور فكم من حاكم","قهر الشعوب وتاجه قبقاب",120,"ب",1,0],["إنْ جحدنا جهوده، شهدت بضْ","عٌ وعشرٌ من السنين الخوالي",121,"ل",2,0],["إن جنَّ فيه الدجى احتجبْنَا","فالأرض من أهلها قفار",122,"ر",1,0],["إن جادلوك ولَجُّوا في جِدَالهمُو","فالحق مُدْ كَان لم يَسلَمْ من الجدَل",123,"ل",1,0],["إن جَهِلتُمْ ما حلَّ في ساحلِ الشَّيْخِ","خِ من الصفحِ فاسألوا البحاره",124,"ر",2,0],["أنجب الشرقُ جامداً يحسبُ المرأةَ","عاراً وأنجبت طيارا",125,"ر",2,0],["إِنْ جُدْتَ فالجُودُ أَمْرٌ قد عُرِفْتَ بهِ","وإِنْ تَجافَيْتَ لم تُنْسَبْ إِلى اللُّومِ",126,"م",1,0],["إنْ جِئتُموها، فلَيستْ بكرَ أنعُمكُم،","وَلا بَديءَ أيَاديكُمْ إلى اليَمَنِ",127,"ن",1,0],["إن جاء من يبغي لها منزلاً","فقل له يمشي ويستنشقُ",128,"ق",1,1],["أَنجَى لك الله أَنجالاً لا يُهيِّئُهم","لرفعة ِ الملكِ إقبالٌ وعرفان",129,"ن",1,0]]}