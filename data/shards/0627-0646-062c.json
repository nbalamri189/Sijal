ته لم تلق إلا نعمة","عمم الورى منها حيا وحياء",220,"ا",2,0],["إن جررّ العضب بيوم معرك","طال عليه الملتقى بالغمد",221,"د",1,0],["ان جئته نلت ما قد كنت تطلبهُ","وعُمتَ بحرا عذا بالجود ملتطما",222,"م",2,0],["إن جئته تلق من بشر ومن لطفٍ","فضلا ينيلك إحسانا وحسّانا",223,"ن",2,0],["أَنجبتَهُ يَا وزيرَ المُلْكِ مُدَّخَراً","لفَجْأَةِ الخطبِ إِن غادى وإِن طَرَقا",224,"ق",2,0],["أَنجبتهُ وسْطَ رَوْضِ المُلكِ تَظْأَرُهُ","بواسِقٌ للعُلا تَهْتَزُّ فِي ثأَدِهْ",225,"د",2,0],["أَنجبتَهُ كاسْمِهِ تَحيا عُلاكَ بِهِ","كَهلُ التجارِبِ شَرْخُ العزْمِ يافِعُهُ",226,"ع",2,0],["أَنَجْماً هَوى فِي سماءِ المعالي","لتبكِ عَلَيْكِ نُجومُ السَّماءِ",227,"ا",2,0],["أَن جاهدوا فِي الله حقَّ جهادِهِ","وَعَلَى النُّفُوسِ لِرَبِّها مجهودُها",228,"د",3,0],["أَنْجَبْتَهُ ذُخْرَ الخِلافَةِ إِنْ شَكَتْ","أَلَماً تَضَمَّنَ بُرْءَهَا وَعِلاجَهَا",229,"ج",3,0],["إن جاعت النفس أمسى جسمها أبدا","روحاً وجسماً تصير الروح إن تخما",230,"م",2,0],["أن جدّ الناس إذ ينسبُ","نسل قردٍ هو نعم الحميم",231,"م",1,0],["إن جئتهُ طالبا فحكمي","أو أنا أجممته ابتداني",232,"ي",1,0],["إنّ جيداً سقطت من عِقده","درّةٌ مثلي حقيقٌ بالعطَلْ",233,"ل",1,0],["أنجبي يا أرضُ لي مِثلَهُمُ","إخوةً أو قلّديهم للهَبَلْ",233,"ل",1,0],["اُنْجُ ربيحَ العِرضِ واقعدْ حَجرَةً","منفرداً إن الحسامَ فردُ",234,"د",1,0],["إن جَنَحَ الأعداء للسَّلم أو","تلاوذوا منك إلى مَهربِ",235,"ب",1,0],["إنْ جَدَّ لم يُهجن محاور جِدِّه","أو أحمضتْ عبثاتُه لم يُقْذعِ",236,"ع",1,0],["اِنَّ جوداً أتى بغيرِ سُؤالٍ","كفَّ عني الغَريمَ وهو عنودُ",237,"د",1,0],["أنْجُمُ المُلْكِ ورُبَّ إِيابٍ","مثلما حُطَّ عن الظَّهْرِ رحْلُ",238,"ل",1,0],["أنجمٌ والسماءُ عطلٌ من الأنجمِ","تجلو ظلماً وجنحَ ظلامِ",239,"م",1,0],["إن جار خطبٌ على جارٍ لها عدلوا","أو سار حمدٌ فعنهم حيثما عدنوا",240,"ن",3,0],["أنَّ جيش الشتاء يحتاج من","يلقاهُ درعاً من الثياب منيعا",241,"ع",2,0],["أنجلّ عليٍّ ما برحت محمَّداً","فحسَّان فكري فيك إحسانهُ جمُّ",242,"م",1,1],["إن جالَ عاينتَ النسورَ","وإن سطا دنت القيامة",243,"م",2,0],["إن جئتهِ والعام أغبرُ أشهبٌ","أغنت شآبيبُ الندى مغناك",244,"ك",1,0],["إِن جاءَتِ الشَمسُ عَلَيهِ وَاِنفَتَح","وَهامَ كُلَّ ناظِرٍ مِنَ الفَرَح",245,"ح",1,0],["إِن جاءَهُ القَصدُ وَهوَ عارٍ","أَفرَغَ دَستَ الغِنى عَلَيهِ",246,"ي",2,0],["إِن جَمَحَ المَجدُ أَدرَكوهُ عَلى","ما رَكِبوا مِن سَوابِقِ الهِمَمِ",247,"م",1,0],["أَنجَدَ بِالمَكرُماتِ وَاِنتَصَرا","حَتّى اِستَقالَ الزَمانُ وَاِعتَذَرا",248,"ر",2,1],["إِن جاءَ مِن فَمِهِ إِلَيكَ بِجَونَةٍ","جاءَتكَ مِن كافورِها النَفَحاتُ",249,"ت",1,0],["إِن جاءَ حُرٌّ غِنائُهُ","مَلَّكتُهُ رَقَّ اِنتِخابي",250,"ب",2,0],["إن جف عنده ضرع الشاة أو فقدت","فما لديه متاع غير مرتهن",251,"ن",1,0],["أنجوم أفق أم كمال أهلة","أجموع شمل ما له أنظار",252,"ر",1,0],["أنجوم أفق أم كمال أهلة","أبدور ليل غار منها جلوسا",253,"س",2,0],["أنجُمٌ في القضاءِ تَحكي الدّراري","كم شَقيٍّ منها وكم من سَعيدِ",254,"د",1,0],["إن جحفل أو محفل ضمه","جمل صدر الدست والموكب",255,"ب",1,0],["إن جلسا فالبدر والمشتري","أو ركبا فالشبل والقسور",256,"ر",1,0],["إن جل أمر فأنتم قائمون به","أو قل صبر فأنتم معشر صبر",257,"ر",1,0],["إن جاد فيكم ما أقول فإنكم","أطلقتم بالجود موثق مقولي",258,"ل",2,0],["إن جاد أو كاد في يومي ندى وردى","فاضت أنامله بالرزق والأجل",259,"ل",1,0],["أنجمَ الكَونِ وَهذا","رُكنُ جهلٍ قد تَمَدَّد",260,"د",1,0],["إنْ جلَّ خَطْبٌ فأنتمْ منه لِي وَزَرٌ","أوْ آدَ صَعْبٌ فأنتمْ فيه أعوانُ",261,"ن",1,0],["إِنَّ جِلداً أوضحتَ عاد بهيماً","وصباحاً أطلعتَ صار ظلاما",262,"م",2,0],["أَنْجِد إِذا شئتَ في الأَرزاقِ أَو أغِرِ","فَلستَ تَأخذ إلّا مِن يَدِ القدرِ",263,"ر",1,1],["إنَّ جَفْنِي عليك حزناً جوادٌ","وهو في كلّ من سواك شحيحُ",264,"ح",1,0],["إن جسمي هنا وقلبي هناكا","وأنا الصب بين هذا وذاكا",265,"ك",2,1],["إن جسمي هو الجدار عليها","وهو منها وتحته هي كنز",266,"ز",1,0],["إنْ جُزتَ في غَربِ لُبنانَ الخَصيبِ فقُلْ","يا آلَ رَسلانَ ها قد قامَ رسلانُ",267,"ن",1,0],["إِنْ جَانَبَتْ قَصْدَ الهَوَى بمُقَدَّمٍ","عَطَفَتْهُ كَفُّ خَلِيْلِهَا بِمُؤَخَّرِ",268,"ر",1,0],["إن جَمَدَ الطَّبْعُ حَلَّ مِنْهُ وإِنْ","ذَابَ انحِلاَلاْ أعادَهُ جَامِدْ",269,"د",1,0],["إِن جلَّ هذا الفعلُ منه فكَم له","معنىً جليلُ القدرِ وهو دقيقُ",270,"ق",1,0],["أَنْجُمٌ قَدْ قَطَعْن حَبْلي ولا أَع","جَب للنَّجْم حينَ يَأتِي بِقَطْع",271,"ع",1,0],["أَنجَدَ الدِّينَ عَزْمُه فِلهذَا","ذِكْرُه في الزَّمان غَار وَأَنْجد",272,"د",1,0],["أَنجم الدَّمع لا تغيبُ شروقاً","مَع أَنِّي رأَيْتُها في الْغَرْب",273,"ب",1,0],["إنْ جَالَ طَرْفي في سِوَاكَ فَلا غُفي","أوْ حالَ قَلْبي عَنْ هَواكَ فلا عُفِي",274,"ي",1,0],["أَنْجِزْ بِوَصْلٍ مِنْكَ لِي فَإِلى مَتَى","يَا نُورَ عَيْنِي بِالوُعُودِ مُماطِلي",275,"ي",1,0]]}