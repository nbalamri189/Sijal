{"poems":[[77,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[71,"كذب كل ما ادعيت وزور","https://www.aldiwan.net/poem3898.html","الخفيف"],[73,"هذا الصباح على سراك رقيبا","https://www.aldiwan.net/poem11919.html","الكامل"],[93,"كيف قوضت يا علم","https://www.aldiwan.net/poem11343.html","مجزوء الخفيف"],[62,"إن أخذنا الكبريت ثم خلطنا","https://www.aldiwan.net/poem52210.html","الخفيف"],[69,"إني تركت عقودهم وفسوخهم","https://www.aldiwan.net/poem28637.html","الكامل"],[105,"أعد الرجاء وجدد الأملا","https://www.aldiwan.net/poem42045.html","أحذ الكامل"],[46,"يتحارب الطبع الذي مزجت به","https://www.aldiwan.net/poem23147.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39544","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"]],"verses":[["ولُزومِ البابِ الذي جبَر الكَسْ","رَ ووَصْلِ السّؤالِ والإلْحاحِ",0,"ح",1,0],["وَلُزومُ السِماطِ أَكبَرُ هَمّي","وَعِلاجُ الأَبوالِ أَقصى مَرامي",1,"ي",1,0],["وَلَزُرتِهِ بَل عُدتِهِ إِنَّ الهَوى","مَرَضٌ يَكونُ لَهُ الوِصالُ طَبيبا",2,"ب",2,0],["وَلِزَوْجٍ وَفِيَّةٍ","حَبْلُ آمَالِهَا انْفَصَمْ",3,"م",1,0],["ولزمنا التكرار حلاً وعقداً","فبلغنا من أمرنا ما اشتهينا",4,"ن",2,0],["ولزمتُ بيتي قانِعاً ومطالِعاً","كُتُبَ العلومِ وذاكَ زينُ الزينِ",5,"ن",1,0],["ولَزْمتَ رَبَّكَ لا تُفارِقُه","تَبغِي الخَسيسَ وَتَتْبعُ الهَمَلا",6,"ل",2,0],["وَلُزومُهُ الأَوطانَ أَبقى لِلرَدى","كَالسَيِّدِ يُستَرُ في الضَرّاءِ أَزَلُّهُ",7,"ل",2,0],["ولزمنا الصمتَ إلَّا نظراتٍ تتكلمْ","وشفاهاً عن جراحِ القلب راحتْ تتبسمْ",8,"م",1,0],["وَلَزَأْرُ لَيُثٍ يَكُو","نُ أحَبَّ وَقْعاً مِنْ بُغَامِ",9,"م",1,0]]}