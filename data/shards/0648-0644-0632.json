{"poems":[[77,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[71,"كذب كل ما ادعيت وزور","https://www.aldiwan.net/poem3898.html","الخفيف"],[73,"هذا الصباح على سراك رقيبا","https://www.aldiwan.net/poem11919.html","الكامل"],[93,"كيف قوضت يا علم","https://www.aldiwan.net/poem11343.html","مجزوء الخفيف"],[62,"إن أخذنا الكبريت ثم خلطنا","https://www.aldiwan.net/poem52210.html","الخفيف"],[69,"إني تركت عقودهم وفسوخهم","https://www.aldiwan.net/poem28637.html","الكامل"],[105,"أعد الرجاء وجدد الأملا","https://www.aldiwan.net/poem42045.html","أحذ الكامل"],[46,"يتحارب الطبع الذي مزجت به","https://www.aldiwan.net/poem23147.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39544","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[115,"هذا كتاب منزل وزبور","https://www.aldiwan.net/poem41746.html","الكامل"],[231,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[275,"لا يضع مني لوني عندكم","https://www.aldiwan.net/poem25571.html","الرمل"],[361,"يا قلب أبشر زالت الاكدار","https://www.aldiwan.net/poem68105.html","الكامل"],[380,"أيد الله أسعد الوزراء","https://www.aldiwan.net/poem48764.html","الخفيف"],[458,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[458,"سافر بطرفك واشترف هل تعرف","https://www.aldiwan.net/poem56112.html","الكامل"],[464,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[551,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[558,"لو تجلى عن ناظريك الغبار","https://www.aldiwan.net/poem34555.html","الخفيف"]],"verses":[["ولُزومِ البابِ الذي جبَر الكَسْ","رَ ووَصْلِ السّؤالِ والإلْحاحِ",0,"ح",1,0],["وَلُزومُ السِماطِ أَكبَرُ هَمّي","وَعِلاجُ الأَبوالِ أَقصى مَرامي",1,"ي",1,0],["وَلَزُرتِهِ بَل عُدتِهِ إِنَّ الهَوى","مَرَضٌ يَكونُ لَهُ الوِصالُ طَبيبا",2,"ب",2,0],["وَلِزَوْجٍ وَفِيَّةٍ","حَبْلُ آمَالِهَا انْفَصَمْ",3,"م",1,0],["ولزمنا التكرار حلاً وعقداً","فبلغنا من أمرنا ما اشتهينا",4,"ن",2,0],["ولزمتُ بيتي قانِعاً ومطالِعاً","كُتُبَ العلومِ وذاكَ زينُ الزينِ",5,"ن",1,0],["ولَزْمتَ رَبَّكَ لا تُفارِقُه","تَبغِي الخَسيسَ وَتَتْبعُ الهَمَلا",6,"ل",2,0],["وَلُزومُهُ الأَوطانَ أَبقى لِلرَدى","كَالسَيِّدِ يُستَرُ في الضَرّاءِ أَزَلُّهُ",7,"ل",2,0],["ولزمنا الصمتَ إلَّا نظراتٍ تتكلمْ","وشفاهاً عن جراحِ القلب راحتْ تتبسمْ",8,"م",1,0],["وَلَزَأْرُ لَيُثٍ يَكُو","نُ أحَبَّ وَقْعاً مِنْ بُغَامِ",9,"م",1,0],["ولزمرة العلماء في سلطانهم","شأن له التعظيم والتوقير",10,"ر",1,0],["وَلزَوجه عَونٌ عَلَيهِ وَإِنَّهُ","بِنِسائِهِ قَد كانَ خَير مُعانِ",11,"ن",1,0],["وَلُزومي الفَرْعَ وفَّى أدَبي","فَخُذوا عَنِّي أَصْلاً مُستَفادا",12,"د",2,0],["وَلِزائِريك جَمالَة وَجَلالَة","وَلَهُم عَلى كُل الاِنام فخار",13,"ر",1,0],["وَلُزوم الحُدود لِلناس مَعنى","ما يُقال الذِئاب بَينَ الشاءِ",14,"ا",2,0],["ولزِمتُ الصمتَ لا أشكو وصمتي","بعدَ أن أفنيتُ في القول الكلاما",15,"م",2,0],["ولزرتُ عن ثقة فإن مكانتي","تُدنَى وإن زيارتي تُتَشوّفُ",16,"ف",1,0],["ولزرتُ بيضاءَ المضارب صالياً","إنا بنار الحرب أو نار القرى",17,"ر",2,0],["ولَزال هذا الملكُ بعد مماتِهِ","وَلمالَ عنهُ دعِامُه المعمودُ",18,"د",1,0],["ولزالت رسوم ذاتك فيمن","لم يزل وأنمحت به الآثار",19,"ر",1,0]]}