{"poems":[[79,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[73,"كذب كل ما ادعيت وزور","https://www.aldiwan.net/poem3898.html","الخفيف"],[75,"هذا الصباح على سراك رقيبا","https://www.aldiwan.net/poem11919.html","الكامل"],[95,"كيف قوضت يا علم","https://www.aldiwan.net/poem11343.html","مجزوء الخفيف"],[64,"إن أخذنا الكبريت ثم خلطنا","https://www.aldiwan.net/poem52210.html","الخفيف"],[71,"إني تركت عقودهم وفسوخهم","https://www.aldiwan.net/poem28637.html","الكامل"],[107,"أعد الرجاء وجدد الأملا","https://www.aldiwan.net/poem42045.html","أحذ الكامل"],[48,"يتحارب الطبع الذي مزجت به","https://www.aldiwan.net/poem23147.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39544","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[119,"هذا كتاب منزل وزبور","https://www.aldiwan.net/poem41746.html","الكامل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[280,"لا يضع مني لوني عندكم","https://www.aldiwan.net/poem25571.html","الرمل"],[366,"يا قلب أبشر زالت الاكدار","https://www.aldiwan.net/poem68105.html","الكامل"],[385,"أيد الله أسعد الوزراء","https://www.aldiwan.net/poem48764.html","الخفيف"],[463,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[463,"سافر بطرفك واشترف هل تعرف","https://www.aldiwan.net/poem56112.html","الكامل"],[469,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[556,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[563,"لو تجلى عن ناظريك الغبار","https://www.aldiwan.net/poem34555.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138280",""],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101558","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87022","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54138","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64130","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77609","الرجز"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105460","الكامل"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69195","المنسرح"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64972","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112749","الوافر"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64576","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49913","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49942","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110333","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53060","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88638","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60821","الرمل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26201","الكامل"],[2621,"","https://poetry.dctabudhabi.ae/diwan/poem/199838","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87337","الطويل"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99506","الرمل"],[3181,"","https://poetry.dctabudhabi.ae/diwan/poem/105093","الكامل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112692","الكامل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139923","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129370","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91078","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111450","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44729","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91016","الكامل"],[4280,"","https://poetry.dctabudhabi.ae/diwan/poem/130548","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72574","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120536","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139673",""],[5054,"كيف تهوى","https://www.poetsgate.com/ViewPoem.aspx?id=211424",""],[5338,"« يا رسول الله خذ بيدي »","https://www.poetsgate.com/ViewPoem.aspx?id=187760",""],[5626,"مَن يُعطيني فماً ؟","https://www.poetsgate.com/ViewPoem.aspx?id=189692",""],[5691,"حواء","https://www.poetsgate.com/ViewPoem.aspx?id=205898",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[402,"أهدي إلى عالي المقام","https://www.poetsgate.com/ViewPoem.aspx?id=36221",""],[5887,"عانق الشوق فؤادي إذ ذكرت اليوم أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=35285",""],[6072,"حديث المواسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81422&r=&rc=4",""]],"verses":[["ولُزومِ البابِ الذي جبَر الكَسْ","رَ ووَصْلِ السّؤالِ والإلْحاحِ",0,"ح",1,0],["وَلُزومُ السِماطِ أَكبَرُ هَمّي","وَعِلاجُ الأَبوالِ أَقصى مَرامي",1,"م",2,0],["وَلَزُرتِهِ بَل عُدتِهِ إِنَّ الهَوى","مَرَضٌ يَكونُ لَهُ الوِصالُ طَبيبا",2,"ب",2,0],["وَلِزَوْجٍ وَفِيَّةٍ","حَبْلُ آمَالِهَا انْفَصَمْ",3,"م",1,0],["ولزمنا التكرار حلاً وعقداً","فبلغنا من أمرنا ما اشتهينا",4,"ن",2,0],["ولزمتُ بيتي قانِعاً ومطالِعاً","كُتُبَ العلومِ وذاكَ زينُ الزينِ",5,"ن",1,0],["ولَزْمتَ رَبَّكَ لا تُفارِقُه","تَبغِي الخَسيسَ وَتَتْبعُ الهَمَلا",6,"ل",2,0],["وَلُزومُهُ الأَوطانَ أَبقى لِلرَدى","كَالسَيِّدِ يُستَرُ في الضَرّاءِ أَزَلُّهُ",7,"ل",2,0],["ولزمنا الصمتَ إلَّا نظراتٍ تتكلمْ","وشفاهاً عن جراحِ القلب راحتْ تتبسمْ",8,"م",1,0],["وَلَزَأْرُ لَيُثٍ يَكُو","نُ أحَبَّ وَقْعاً مِنْ بُغَامِ",9,"م",1,0],["ولزمرة العلماء في سلطانهم","شأن له التعظيم والتوقير",10,"ر",1,0],["وَلزَوجه عَونٌ عَلَيهِ وَإِنَّهُ","بِنِسائِهِ قَد كانَ خَير مُعانِ",11,"ن",1,0],["وَلُزومي الفَرْعَ وفَّى أدَبي","فَخُذوا عَنِّي أَصْلاً مُستَفادا",12,"د",2,0],["وَلِزائِريك جَمالَة وَجَلالَة","وَلَهُم عَلى كُل الاِنام فخار",13,"ر",1,0],["وَلُزوم الحُدود لِلناس مَعنى","ما يُقال الذِئاب بَينَ الشاءِ",14,"ا",2,0],["ولزِمتُ الصمتَ لا أشكو وصمتي","بعدَ أن أفنيتُ في القول الكلاما",15,"م",2,0],["ولزرتُ عن ثقة فإن مكانتي","تُدنَى وإن زيارتي تُتَشوّفُ",16,"ف",1,0],["ولزرتُ بيضاءَ المضارب صالياً","إنا بنار الحرب أو نار القرى",17,"ر",2,0],["ولَزال هذا الملكُ بعد مماتِهِ","وَلمالَ عنهُ دعِامُه المعمودُ",18,"د",1,0],["ولزالت رسوم ذاتك فيمن","لم يزل وأنمحت به الآثار",19,"ر",1,0],["ولزال من بين العباد جحافل","إملاقهم كل الشرور يدبّر",20,"ر",1,0],["ولزمتهُ وأبحتُه","أوقات أنسي الغاليه",21,"ي",2,0],["وَلزمتُ باب الصَبر حَولاً كامِلاً","قَضيته في لَوعة وَتعلل",22,"ل",1,0],["ولَزَوْجةِ قد حُرِّمَتْ ردّ الذي","ردّ الفراق اختار بالتحريمِ",23,"م",1,0],["ولزهرِ الرياض ضِحْكٌ وللغي","م بكاءٌ على الثرى ونحيب",24,"ب",1,0],["وَلَزم الأَمرُ إِلى رُجوعِه","محتنقاً بهمِّه وَجوعِه",25,"ه",1,0],["ولزمت مدح محمد الحسن الذي","ساد الورى بالعلم وهو صغير",26,"ر",1,0],["وَلزهير بالفرك مأسدة","مرقومة صُلبَةٌ مكاسرها",27,"ر",3,0],["ولزُّهْدُ في الْغِيدِ قَبلَ الأَرْبعينَ وفي","عَشْرِ الثَّمانينَ أَقْليها وتَقْليني",28,"ن",2,0],["ولزمني الإنابة وارفعني","لحسن مسالك وشريف سير",29,"ر",1,0],["ولزلة الغلو والتعمق","وكل ما من عبده قلاه",30,"ه",1,0],["ولزومنا طوعاً لما حكم الهُوى","عبثاً بحبّ الكاعبِ الحسناءِ",31,"ا",2,0],["ولزَمْتُها تَحْتَ الشّعار مُعانقاً","رَيّا الرَّوادِف والعِظام رَداحَها",32,"ح",3,0],["ولزمت آداب المشيب وضيمها","متنكراً لصبابتي بأناتي",33,"ت",2,0],["ولزمت لبنان المفدى وقت لم","يلزمه في بلواه غير فداة",33,"ه",1,0],["ولزمت تأدية الفروض وخير ما","أدى الصلاة المرء في أوقاتها",34,"ت",3,0],["وَلُزُومُ ذَلِكَ بَيِّنٌ جِدَّا لِمَن","كَانَت لَهُ أذُنَانِ وَاعِيَتَانِ",35,"ن",1,0],["وَلزين العباد فيه مصلى","يفخر البيت لوبه اداها",36,"ا",3,0],["ولزمتُ العروة الوثقى الَّتي","منك لا يشقَى بها مَنْ لَزِما",37,"م",2,0],["وَلَزُرتُ حِمصَ الغَربِ أَغرَبَ زائِرٍ","بِغَرائِبٍ كالحُلَّةِ الأَفوافِ",38,"ف",1,0],["ولزمت بيتي واتخذت مسامري","سفراً بأنواع الفضائل ينطق",39,"ق",1,0],["ولزُّوهُ خَوفَ المدِّ ثمَّ تأمَّلوا","إلى المدّ مشهورا وساقٍ وَثَابِر",40,"ر",1,0],["ولزمت الشح بالرا","ح فما تسخو بجرعه",41,"ع",2,0],["ولزمت بيتك مصبحا أو ممسيا","فرعيتني في يقظة ومنام",42,"م",1,0],["ولزدتم فيما فعلتم","خبث عنصركم ولؤمه",43,"م",2,0],["ولزمنني حتى انفصلتُ بموعدٍ","بعد اليمين إلى النهار الرابعِ",44,"ع",1,0],["ولزمت أذيال التقاطع هيبة","عن حضرة سكن العلا بقصورها",45,"ر",3,0],["وَلَزمت منّاع الجوار إِذا دَهَت","ظُلَمُ الخطوب وَلِلنَدا منّاحا",46,"ح",2,0],["وَلِزَفسٍ بَسَطتَ كَفًّا وَأَنفَذ","تَ لَهُ سَهمَكَ المَرِيشَ اهتِوارا",47,"ر",2,0],["ولزوج زفس بدت شقيقة من","في القاصيات سهامه نشرا",48,"ر",2,0],["وَلزَنفليدُ كُن إِلَيهِ مُسارِعاً","فَدخولُهُ قَطعاً عَلَيكَ تَحتّما",49,"م",2,0],["ولزينة الإقبال من حلل الصفا","لبست دمشق الشام أبهى ملبس",50,"س",1,0],["ولزاز كلّ ألدّ يد","لي دون حجّته بباطل",51,"ل",1,0],["ولزق الخمر أضحى","بفرند الشرق نحر",52,"ر",1,0],["ولزمت حد السلم مغتبطا به","فامنت من شكوى عداي وجيرتي",53,"ت",2,0],["ولزائرٍ كم جدتَ في","جدواك مناً أو مجاور",54,"ر",1,0],["ولزمت الهوى لعلي ألقى","منه يوماً والمآسي نيام",55,"م",1,0],["وَلزومُ النَّاسِ بَيْعَتَهُ","خَيْرُ مَنْجَاةِ وَمُلْتَحَدِ(٢٠)",56,"د",1,0],["وَلَزَينبٌ أمّ الرجالِ تَخَلّدَتْ","ولها صدىً ومناقبُ وإباءُ",57,"ا",2,0],["ولزُبدَةٍ ولزُعفُرانٍ فاخِرٍ","أوْ ِماءِ ورْدٍ أوْ حليبِ نِعاجِ !",58,"ج",1,0],["ولَزانَتْ روائِعَ الفِكْر ِفضْلاً","لوْ رآها الحَكيمُ ( أفْلاطونُ )",59,"ن",1,0],["ولزأر ليث قد يكون","أحب وقعا من بغام",60,"م",1,0],["ولزوجي كل حب","فلزوجي اليوم أشهد",61,"د",1,0],["ولزحمةِ الحَسَناتِ فيكِ يُعيقُني","فيما يُعيقُ الأهلُ والميلادُ !",62,"د",1,0]]}