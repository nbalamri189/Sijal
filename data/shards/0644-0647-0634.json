{"poems":[[53,"نعوه على ضن قلبي به","https://www.aldiwan.net/poem29746.html","المتقارب"],[53,"أما آن للدمع أن يستجم","https://www.aldiwan.net/poem29769.html","المتقارب"],[53,"لأظما معلينا وأروى المصائبا","https://www.aldiwan.net/poem30735.html","الطويل"],[35,"صحا قلبه يا عز أو كاد يذهل","https://www.aldiwan.net/poem39111.html","الطويل"],[35,"غشيت لليلى بالبرود مساكنا","https://www.aldiwan.net/poem39153.html","الطويل"],[72,"تصرمت الأيام دون وصالك","https://www.aldiwan.net/poem19437.html","الطويل"],[51,"لعمرك ما السيف سيف الكمي","https://www.aldiwan.net/poem8177.html","المتقارب"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[51,"له شمالان حاز إرثهما","https://www.aldiwan.net/poem65443.html","المنسرح"],[51,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[45,"يجانبنا في الحب من لا نجانبه","https://www.aldiwan.net/poem10904.html","الطويل"],[45,"إساءة دهر برحت بي نوائبه","https://www.aldiwan.net/poem11056.html","الطويل"],[45,"لها منزل بين الدخول فتوضح","https://www.aldiwan.net/poem62693.html","الطويل"],[61,"سواء علينا وعدها ووعيدها","https://www.aldiwan.net/poem51714.html","الطويل"],[61,"أرى همة تختال بين الكواكب","https://www.aldiwan.net/poem51785.html","الطويل"],[74,"ألا ماء إلا فوق نصل يجرد","https://www.aldiwan.net/poem12903.html","الطويل"],[52,"ومستبصر في الغدر مستعجل القلى","https://www.aldiwan.net/poem26992.html","الطويل"],[52,"وسارية لا تمل البكا","https://www.aldiwan.net/poem27320.html","المتقارب"],[75,"أمنك اجتياز البرق يلتاح في الدجى","https://www.aldiwan.net/poem69096.html","الطويل"],[50,"ألم يأن أن تسلى مودة مهددا","https://www.aldiwan.net/poem63919.html","الطويل"],[1,"يا عجبا من عبد عمرو وبغيه","https://www.aldiwan.net/poem34012.html","الطويل"],[115,"خفايا المعاني تنجلي بالدلائل","https://www.aldiwan.net/poem40849.html","عموديه"],[150,"أتدري من تبارز بالذنوب","https://www.aldiwan.net/poem68506.html","الوافر"],[160,"ليوم منك والإقبال يجري","https://www.aldiwan.net/poem58985.html","الوافر"],[169,"أفي كل يوم للخطوب أصالي","https://www.aldiwan.net/poem1650.html",""],[211,"عيونك ألهبت قلبي وروحي","https://www.aldiwan.net/poem46289.html","الوافر"],[229,"وخمر ترشفت سلسالها","https://www.aldiwan.net/poem50882.html","المتقارب"],[252,"طوى دارها طي الكتاب المنمنم","https://www.aldiwan.net/poem1431.html",""],[261,"متى يستفيق الدهر من غفلانه","https://www.aldiwan.net/poem38140.html","الطويل"],[261,"أراحمة قلبي وقد شفني الصبر","https://www.aldiwan.net/poem38281.html","الطويل"],[270,"ركبت فهزني طربي","https://www.aldiwan.net/poem35269.html","مجزوء الوافر"],[270,"خمارك فيه لقلبي خمر","https://www.aldiwan.net/poem35423.html","المتقارب"],[270,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[275,"أحقا طربت إلى الربرب","https://www.aldiwan.net/poem25612.html","المتقارب"],[280,"نشدتك لا تعدم الراح راحا","https://www.aldiwan.net/poem60715.html","المتقارب"],[303,"وبي رشأ معاطفه رشاق","https://www.aldiwan.net/poem57862.html","الطويل"],[326,"له شيمة عند بذل العطاء","https://www.aldiwan.net/poem44268.html","المتقارب"],[348,"إليك بالإذن صار الناس والجود","https://www.aldiwan.net/poem20780.html","البسيط"],[364,"مقامك مجد والمسير معال","https://www.aldiwan.net/poem60670.html","الطويل"],[364,"تجلت فقلت البدر لولا عقودها","https://www.aldiwan.net/poem60950.html","الطويل"],[380,"أأرجوا من الإلمام بالطلل البالي","https://www.aldiwan.net/poem48836.html","الطويل"],[452,"أحن إلى تلك الربى والمعاهد","https://www.aldiwan.net/poem13715.html","الطويل"],[458,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[464,"عيون المهى قلبي بنبلك مجروح","https://www.aldiwan.net/poem3149.html","عموديه"],[464,"أحاجيكم ما ناطق نجل مفحم","https://www.aldiwan.net/poem3532.html","عموديه"],[464,"خلا منك طرفي والحشا لك أوطان","https://www.aldiwan.net/poem3542.html","عموديه"],[464,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[514,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[514,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[559,"شهدت حقيتي عظيم شاني","https://www.aldiwan.net/poem69263.html","الوافر"],[562,"سلام الله أيتها القباب","https://www.aldiwan.net/poem52930.html","الوافر"],[563,"هو الأجل الموقوت لا يتخلف","https://www.aldiwan.net/poem13603.html","الطويل"],[567,"متى تنشط للأكل","https://www.aldiwan.net/poem69479.html","الهزج"],[567,"له شغل عن سؤال الطلل","https://www.aldiwan.net/poem69529.html","المتقارب"],[567,"أذابت قلبه الزفره","https://www.aldiwan.net/poem69677.html","مجزوء الرجز"],[575,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[575,"تنزه طرفي بين زاه وزاهر","https://www.aldiwan.net/poem3073.html","الطويل"]],"verses":[["لَهُ شَفَتا مِبرَدِ الهالِكِي","يِ أَنحى بِجانِبِهِ غَيرَ واني",0,"ي",1,0],["لَهُ شَفَتانِ فَلَو كانَتا","لِساناً لَما بانَ عَنهُ الكَلِم",1,"م",1,0],["لَهُ شَرَرٌ يَرمي الرِماحَ بِلَفحِهِ","يَكادُ يُرى ماءُ الأَسِنَّةِ ذائِبا",2,"ب",2,0],["لَهُ شيمَتانِ مِنهُما أَنسِيُّةٌ","وَوَحشِيَّةٌ إِغراقُها النَهىَ مُعجَلُ",3,"ل",1,0],["لَهُ شُعَبٌ مِنها يَمانٍ وَرَيِّقٌِ","شآمٍ وَنَجدِيٌ وَآخَرُ غائِرُ",4,"ر",1,0],["له شيمٌ تحصي المدائح وصفها","إذا أحصيت زهر النجوم الشوابك",5,"ك",1,0],["لهُ شاهدٌ إنْ تأمّلتَهُ","ظهرتَ على سرِّهِ الغائبِ",6,"ب",1,0],["له شُعَب لا تَعدم الأرض فيئها","ولو أورقت ما أبصر الشمس مبصر",7,"ر",1,0],["له شمالان حاز إرثَهُما","عن ذي اليمينين شدَّ ما اختلفا",8,"ف",2,1],["له شاغلٌ عن أنْ يسامِيَ همُّهُ","رضاكَ وقد أعْيَتْهُ فيه المراومُ",9,"م",1,0],["لَهُ شَبَهٌ مِن تاجَوَيهِ مُبَيِّنٌ","يُنازِعُهُ أَخلاقَهُ وَيُجاذِبُه",10,"ب",2,0],["لَهُ شُغُلٌ في جانِبَيهِ كِلَيهِما","إِذا اعتادَهُ أَحبابُهُ وَحَبائِبُه",11,"ب",2,0],["لَهُ شَرَفُ البَيتِ الحَرامِ وَفَخرُهُ","وَزَمزَمَ وَالرُكنِ العَتيقِ المُمَسَّحِ",12,"ح",1,0],["له شرَفٌ عالي المحلِّ وهِمَّةٌ","تُصَعِّدُ أنفاسَ العَدوِّ صعودُها",13,"د",3,0],["له شَرَفاتٌ كالوذائلِ أشرَفَتْ","على نازحِ الأقطارِ نائي المناكِبِ",14,"ب",1,0],["لَهُ شيمَةٌ تَندى فَتَشفي مِنَ الصَدى","وَتَنقَعُ أَحشاءَ الهَجيرِ فَيَبرُدُ",15,"د",1,0],["لَهُ شافِعٌ في القَلبِ مِن كُلِّ زَلَّةٍ","فَلَيسَ بِمُحتاجِ الذُنوبِ إِلى العُذرِ",16,"ر",1,0],["لَهُ شَعَرٌ مِثلُ نَسجِ الدُروعِ","وَطَرفٌ سَقيمٌ إِذا ما رَنا",17,"ا",1,0],["له شِيمَةٌ كالأرْيِ صَفْوٌ سِجالُها","وما السَّمُّ إلاّ أن يُقانَى ويُمزَجا",18,"ج",2,0],["لَهُ شِيَمٌ تَحكي أَباً كانَ سابِقاً","إِذا قُسِمَت كانَت نُحوساً وَأَسعُدا",19,"د",2,0],["لَهُ شَربَتانِ بِالنَهارِ وَأَربَعٌ","مِنَ اللَيلِ حَتّى آضَ سُخداً مُوَرَّما",20,"م",2,0],["له شرف شاعت مآثر مجده","وسارت به الركبان رغم المخاتل",21,"ل",1,0],["له شهد الوجودُ بعالميه","من الأجسام طُراً والقلوبِ",22,"ب",1,0],["له شرف وأخلاق كرام","تسر كأنها نشوات خمر",23,"ر",1,0],["لَهُ شِيمَةُ السَنَّورِ في لُطفِ خدعِهِ","وَلَكِنَّهُ في اللَمسِ حَيَّةُ ضالِ",24,"ل",1,0],["له شفتان من نار ونور","تثيران الصبابة في إهابي",25,"ي",1,0],["له شجراتُ عُلاً لم تكن","تَرَى نَبْعَ نجدٍ ولا ضَالها",26,"ل",3,0],["لَهُ شَرَفٌ الاقدامِ في الحَربِ شِيمَةٌ","َما يَبتَغي غَيرَ الكميِّ المُقَدَّمِ",27,"م",1,0],["له شبح خافٍ عليك وان ترى","خيال غريق غاص في عبراته",28,"ت",2,0],["له شية بيضاء تزهو كأنها","على وجهه الوردي في شفق بدر",29,"ر",1,0],["له شِعرٌ على غزَلٍ","حَكى أنَّاتِ مُنتَحِب",30,"ب",1,0],["له شبةٌ من شعاعِ القمرْ","وتلكَ الخيوطُ تفكُّ الحلق",31,"ق",1,0],["لهُ شهوةٌ وحشيَّةٌ وضريبةٌ","صليبيّةٌ لكِنَّهُ قد تَستَّرا",32,"ر",2,0],["لَهُ شرَفُ البيتِ دونَ الملوك","وطيبُ الأرُومَة والمَنْسَب",33,"ب",1,0],["لَهُ شِيمَتانِ مِنَ الْمَكْرُماتِ","يُرِيكَ الْوَقارَ بِها وَالْمِراحا",34,"ح",2,0],["له شعرٌ حكاه في التجني","على ضعفي تجافى واستطالا",35,"ل",2,0],["لَهُ شيمَةٌ عِندَ بَذلِ العَطاءِ","لا يَعرِفُ الناسُ مِقدارَها",36,"ه",2,1],["لَهُ شَرِيعةُ عَدْلٍ عِنْدَها شَرَعٌ","أُسْدُ الفَلا والمَها والشّاءُ والسِّيدُ",37,"د",1,0],["له شَرَفا نَفْسٍ وأَصْلٍ تَقارنَا","فما اكتحلَتْ عَيْنٌ له بمِثال",38,"ل",1,0],["له شِيمةٌ لم يُعْطِها اللّهُ غيَرهُ","من النّاسِ حتّى ظَلّ وهْو وَحيدها",39,"د",3,0],["لَهُ شُغل عَن جودِهِ وَسَماحه","عَن النَفس وَالأَنفاس مِن غَير أَخلال",40,"ل",1,0],["له شدواتٌ في العشي تلاعبتْ","بكلِّ فؤاد طائِش الحلم واجد",41,"د",1,0],["له شِهادي مكثراً","ولي مقِلّاً سَلَعي",42,"ي",1,0],["لهُ شهبٌ بالبيض في سدف الوغى","وبالسُّمر في ضيق الوقائع تفسيح",43,"ح",1,0],["له شبهُ إنسانٍ إذا ما رأيتهُ","فإن نسبوهُ فهو إحدى البهائم",44,"م",1,0],["له شرعُ جودٍ قتلهُ المال بالندى","مباحٌ بهِ والقتلُ في الشرع عدوان",45,"ن",1,0],["له شرف البيت العتيق وزمزمٍ","وما ساقهُ حادٍ إليه عجول",46,"ل",1,0],["لهُ شِيَمٌ تصحو فتُفْني حُطامَهُ","هِباتٌ كما تُفْني العُقولَ المَساكِرُ",47,"ر",1,0],["له شُثْنُ أظفارِ المَنايا صوارِمٌ","وأجنحةُ النّصرِ العزيز بُنودُ",48,"د",1,0],["لَهُ شَمْسُ الحقيقةِ في التَّدانِي","فلمَّا أنا دنا مِنْهَا تدلَّى",49,"ل",2,0],["لهُ شَفَةٌ لناظِرِها شَرابٌ","ولكن حظُّ وارِدِها السَّرابُ",50,"ب",1,0],["لَهُ شيمٌ مِثلُ النُجومِ عَديدَةٌ","فَمِنهُنَّ مَوصوفٌ وَما لَيسَ يوصَفُ",51,"ف",1,0],["لَهُ شِدَّةُ أَلْحَاظٍ","وَفِي أَلْفَاظِهِ لِيْنَهْ",52,"ن",2,0],["لَهُ شُغُلٌ عَنْ سُؤَالِ الطَّلَلْ","أَقَامَ الخَلِيْطُ بِهِ أَمْ رَحَلْ",53,"ل",1,1],["له شوقٌ حجازيٌّ","وقلبٌ مِنْ بَني عَذْرَهْ",54,"ر",2,0],["له شاهِدا زور من النَّهْيِ والنُّهى","عليك ومن عينَيْكَ لي شاهدَا عَدْلِ",55,"ل",1,0],["له شاعِرٌ في ثَغْرِه أَيُّ نَاظِمٍ","ولي كَاتِبٌ في مُقْلِتي أَيُّ نَاثِر",56,"ر",1,0]]}