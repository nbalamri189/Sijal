{"poems":[[39,"وبعد في غزوة كانت مباركة","https://www.aldiwan.net/poem6891.html","البسيط"],[87,"ما بات يثني على علياك إنسان","https://www.aldiwan.net/poem7923.html","البسيط"],[87,"مرحبا بالربيع في ريعانه","https://www.aldiwan.net/poem62943.html","الخفيف"],[45,"غاضت أنامله وهن بحور","https://www.aldiwan.net/poem9574.html","الكامل"],[68,"ما للجبال الراسيات تسير","https://www.aldiwan.net/poem40122.html","الكامل"],[99,"قلت للبحرِ إذ وقفت مساء","https://www.aldiwan.net/poem24399.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39594","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54297","الكامل"],[92,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[98,"مأساة رجل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66382&r=&rc=58",""],[287,"لا والمطايا ذللا في البرى","https://www.aldiwan.net/poem32765.html","السريع"],[325,"هات اسقني من رائق الصهباء","https://www.aldiwan.net/poem67192.html","الكامل"],[357,"الوداع","https://www.aldiwan.net/poem947.html",""],[475,"صاح هل أبصرت","https://www.aldiwan.net/poem4687.html","مجزوء الرمل"],[511,"عيد بما يهوى الإمام يعود","https://www.aldiwan.net/poem2467.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138274",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138235",""],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101505","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70905","الكامل"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26678","البسيط"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76647","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93610","الكامل"],[2543,"","https://poetry.dctabudhabi.ae/diwan/poem/123741","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137353",""],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122487","البسيط"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101613","الخفيف"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52977","الرجز"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48326","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138552",""],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129413","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91239","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102982","الكامل"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143835","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120527","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52199","البسيط"],[4767,"نعي الجهاد","https://www.poetsgate.com/ViewPoem.aspx?id=89357",""],[4767,"روائع الأيات","https://www.poetsgate.com/ViewPoem.aspx?id=178557",""],[4767,"معركة الحق","https://www.poetsgate.com/ViewPoem.aspx?id=184948",""],[4767,"بدور شعبان","https://www.poetsgate.com/ViewPoem.aspx?id=197676",""],[4767,"العزيمة","https://www.poetsgate.com/ViewPoem.aspx?id=209008",""],[4767,"ما زلتُ","https://www.poetsgate.com/ViewPoem.aspx?id=210931",""],[243,"حقائق كالخيال","https://www.poetsgate.com/ViewPoem.aspx?id=50559",""]],"verses":[["لم تثن وجهك عن قوم غزوتهم","حتى يقال لهم بُعْدا وقد بعِدوا",0,"د",3,0],["لَم تَثنِهِم عَن طِلابِ العِلمِ في صِغَرٍ","في عِزِّ مُلكِكَ أَوطارٌ وَأَوطانُ",1,"ن",1,0],["لَم تَثُر أُمَّةٌ إِلى الحَقِّ إِلا","بُهُدى الشِعرِ أَو خُطا شَيطانِه",2,"ن",2,0],["لَم تُثنَ في طَلَبٍ أَعِنَّةُ خَيلِهِم","إِلّا وَعُمرُ طَريدِها مَبتورُ",3,"ر",1,0],["لَم تَثنِ عَنكَ الغاسِلونَ عِنانَها","إِلّا أَتاكَ مُبَشِّرٌ وَبَشيرُ",4,"ر",1,0],["لم تُثِبنَا الحياةُ إلا بهذا","حسبنا وجهُه الجميل جزاءَ",5,"ا",2,0],["لم تثنه شيخوخةٌ مكدودةٌ","دون السِّفارِ ولا صقيعُ شتاءِ",6,"ا",2,0],["لَمْ تثْنِهِ الآلامُ عن غَاياتهِ","أو تَلْوِه الأسْقَامُ دُونَ مُرَادِ",7,"د",1,0],["لم تُثِرْها نزوةُ النفس ، ولم","يُزهها العُجْبُ ولم تنبِضْ رياء",8,"ا",2,0],["لم تثنه شيخوخة مكدودة","دون السذفار ولا صقيع شتاء",9,"ا",2,0],["لَم تثنِهِ دُنياهُ عَن دينِهِ","وَلَم يَكُن في الناسِ مُستَكبِرا",10,"ر",2,0],["لَم تَثنِهِ الصِدقُ الَّذي أَعطى الصَدا","قَةَ حَقَّها في شِدَّةٍ وَرَخاءِ",11,"ا",2,0],["لم تثن العزم مصاعبه","وبه قد شيد لي صرح",12,"ح",1,0],["لَم تُثِب بِالوَصلِ سلَمى","جَارَها إِذ كانَ جارا",13,"ر",2,0],["لم تثنِهِ الأشواقُ عَن حَسَدٍ لهُ","إِحدى العجائب وامِقٌ وحَسودُ",14,"د",1,0],["لم تثنه العلياء عن أن يبتني","غرا المآثر أسهنّ مفاخر",15,"ر",1,0],["لم تثنك الوعثاء عن عمل به","أدركت أقصى القصد وهو حميد",16,"د",1,0],["لم تثق بي مع فرط حبّي لماذا","حيث انت المطبوع ضدَّ الوفاءِ",17,"ا",2,0],["لم تثْن عزمتَها إذا هي أبرمَتْ","مِن رأيها أمراً ولا هي تأتلي",18,"ل",2,0],["لم تثنِ عنكَ يداً أرجاءُ ضفتهِ","إلا ومدت يداً أرجاؤهُ الأخر",19,"ر",1,0],["لم تثن عنك عناني سلوة خطرت","على فؤادي ولا سمعي ولا بصري",20,"ر",2,0],["لَم تثن عامله المسدد جَنة","كَالمَوت لَم يَحجزه يَوماً سُور",21,"ر",1,0],["لم تُثننى تلك الأقاويلُ التي","صدَرَت وكم قد قال فيك مُنافِقُ",22,"ق",1,0],["لم تثن عزمك عن رعيتك التي","خفقت لطاعتها عليك بنود",23,"د",1,0],["لَم تثنِ عزمَهُمُ الأجسَادُ هاوِيَة","مِن كلِّ شلوٍ بنارِ الرَّوعِ مُشتَعِلِ",24,"ل",1,0],["لم تثر بعد شقوة العمر غمك","فالتشكي إذن عجب",25,"ب",1,0],["لم تثنكم خطوبُ","ولا اقتحامُ مَعْمع",26,"ع",1,0],["لمْ تثْنِ عنْ أوصافِهِ قوْلاً ولا","ملّتْ على طولِ المَدى تَرْدادَها",27,"د",3,0],["لم تثن همته العليا الصروف وان","جلت ولا فقده الانصار والعضدا",28,"د",2,0],["لم تثق نفسه لغير المعالي","رب نفس الى العلى لا يليق",29,"ق",1,0],["لَم تثنه عن وَلا مَولاه داهمةٌ","مِن الرِجال وَإِن شدّوا وَإن لانوا",30,"ن",3,0],["لم تثنه في الجود لومة لائم","أرأيت بالجبل النسيم مؤثّرا",31,"ر",2,0],["لم تثنني لمع للشيب في لممي","عن أن ألمَّ بأطراف المنى لمما",32,"م",2,0],["لم تثنه جدة الشباب وريعه","ورناه عن ارضائه المعبودا",33,"د",2,0],["لم تَثْنِ هُوجُ المعاصي من شمائله","ولاَ نَفَحاتِ الطيبِ في الخُلُقِ",34,"ق",1,0],["لم تُثن منه عزائم ثبتت","تهدي لدين الخالق المللا",35,"ل",2,0],["لم تُثنِ عزمَهم الكبيرَ مقالةٌ","قد أطلقتها فوهةُ المِِصوات",36,"ت",1,0],["لم تُثنها من أكف القوم تصدية","كلا ولم تثنها أعداد من حضروا",37,"ر",3,0],["لم تثنها فرحة في الناس عارمة","لما أتى الرجسَ عن قتل الهدى خبر",37,"ر",1,0],["لم تثنِه عن نشر معرفةٍ","كالغيث فوق الأرض ينهمر",38,"ر",1,0],["لم تُثنِنا عمَّا نريدُ مكائدٌ","في كل موقفِ عزةٍ تتجسد",39,"د",1,0],["لم تثنِهِ عن قصدِهِ حتى وإن","حاطتْ به ملحوظةٌ من ناقد",40,"د",1,0],["لم تثن سازاك عن شحذ لمدينة","آهات مرضى ولا ألهاء زوار",41,"ا",2,0]]}