{"poems":[[63,"وله تشف وراءه الأشجان","https://www.aldiwan.net/poem46179.html","الكامل"],[100,"الربيع والشعر","https://www.aldiwan.net/poem10291.html","عموديه"],[77,"النصر نصك والحسام دليله","https://www.aldiwan.net/poem36377.html","الكامل"],[91,"أبصرتها في الخمس والعشر","https://www.aldiwan.net/poem8851.html","عموديه"],[89,"حول الحقيقة في الحياة طوافي","https://www.aldiwan.net/poem44615.html","الكامل"],[85,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[74,"أذن الغمام بديمة وعقار","https://www.aldiwan.net/poem12944.html","الكامل"],[75,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49190","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39683","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39599","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54329","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[77,"النصر نصك والحسام دليله","https://www.poetsgate.com/ViewPoem.aspx?id=34198",""],[100,"فارس الاصطياف","https://www.poetsgate.com/ViewPoem.aspx?id=50417",""],[90,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""]],"verses":[["وهَفا بنا وَلَعُ النّسيمِ على الحِمى","فثَنى مَعاطِفَهُ إليهِ البانُ",0,"ن",1,0],["وهفت إليك كأنها مسحورة","ملتاعة الأعصاب ملهبة الدما",1,"م",2,0],["وَهَفَتْ بِديِنِ الْكُفْرِ أَطْمَاعٌ قَضَتْ","أَنْ تُقْتَضَى أَوْتَارُهُ وَذُحُولُهُ",2,"ل",2,0],["وَهَفا هَواها بي فَقُلتُ لَها","قَد حَلَّ هَذا المَوتُ مِن أَسري",3,"ي",1,0],["وهفت مبتهجا بها من بعدما","صافحتها فتبسمت لهتافي",4,"ي",1,0],["وَهَفا بِالفُؤادِ في سَلسَبيلٍ","ظَمَأٌ لِلسَوادِ مِن عَينِ شَمسِ",5,"س",1,0],["وَهَفَت بِتَغريدٍ هُنالِكَ أَيكَةٌ","خَفّاقَةٌ بِمَهَبِّ ريحِ عَرارِ",6,"ر",1,0],["وهَفَتْ جوانبُها ولولا ما رَسا","من عبء مجْدكَ ما استقَرّ مكانها",7,"ن",3,0],["وهفا الذّعرُ بالنفوسِ فلانوا","بعد حينٍ وللجَهالةِ حَدُّ",8,"د",1,0],["وهفت غمائمُ في السماء تظلُّكم","ويرفُّ مصعدُها لكم ومصيبها",9,"ب",3,0],["وهفَا كلُّ فؤادٍ وشدا كلُّ لسانِ","هذه فاتنةُ الدُّنيا وحسناءُ الزمانِ",10,"ن",1,0],["وهفَا للرياضِ تعبقُ بالمس","كِ وأصغى لهمسةِ الأغصان",11,"ن",1,0],["وهَفَتْ رايةٌ على قِمَّةِ النجْمِ","وَرَفَّتْ فوقَ السحابِ الثقال",12,"ل",1,0],["وهفت بدين الكفر أطماع قضت","أن تقتضي أوتاره ودخوله",13,"ل",2,0],["وهفا إلى لقياه ، انظر مدخل","تومى روائحه ، إلى الأضياف",14,"ف",1,0],["وهفا فؤادٌ كالحديدِ على وأسبَلَت","عينٌ تُفاخر أنها لا تدمَع",15,"ع",1,0]]}