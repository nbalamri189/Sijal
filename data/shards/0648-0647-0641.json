{"poems":[[63,"وله تشف وراءه الأشجان","https://www.aldiwan.net/poem46179.html","الكامل"],[100,"الربيع والشعر","https://www.aldiwan.net/poem10291.html","عموديه"],[77,"النصر نصك والحسام دليله","https://www.aldiwan.net/poem36377.html","الكامل"],[91,"أبصرتها في الخمس والعشر","https://www.aldiwan.net/poem8851.html","عموديه"],[89,"حول الحقيقة في الحياة طوافي","https://www.aldiwan.net/poem44615.html","الكامل"],[85,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[74,"أذن الغمام بديمة وعقار","https://www.aldiwan.net/poem12944.html","الكامل"],[75,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49190","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39683","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39599","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54329","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[77,"النصر نصك والحسام دليله","https://www.poetsgate.com/ViewPoem.aspx?id=34198",""],[100,"فارس الاصطياف","https://www.poetsgate.com/ViewPoem.aspx?id=50417",""],[100,"روح شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=50166",""],[100,"عودة القائد","https://www.poetsgate.com/ViewPoem.aspx?id=50093",""],[90,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""],[94,"مصرع الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=12923",""],[224,"مر جنح من الظلام وقلبي","https://www.aldiwan.net/poem41919.html","الخفيف"],[232,"ذكر العقيق فهاجه تذكاره","https://www.aldiwan.net/poem44570.html","الكامل"],[238,"أغدت زيادتنا إلى النقصان","https://www.aldiwan.net/poem19295.html","الكامل"],[329,"بين أمواجك يا ده","https://www.aldiwan.net/poem55033.html","مجزوء الرمل"],[329,"هات قيثارك يا شاعر","https://www.aldiwan.net/poem55055.html","مجزوء الرمل"],[381,"لبيك داعية الغرام","https://www.aldiwan.net/poem49199.html","مجزوء الكامل"],[428,"أعلى الجمال تغار منّا","https://www.aldiwan.net/poem42148.html","عموديه"],[433,"سائل لوى خبت فذاك لواؤه","https://www.aldiwan.net/poem12550.html","الكامل"],[440,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[459,"إن تسأليني بعد قومي","https://www.aldiwan.net/poem55856.html","مجزوء الكامل"],[501,"تعلم مني النوح في مذهب الهوى","https://www.aldiwan.net/poem37810.html","الطويل"]],"verses":[["وهَفا بنا وَلَعُ النّسيمِ على الحِمى","فثَنى مَعاطِفَهُ إليهِ البانُ",0,"ن",1,0],["وهفت إليك كأنها مسحورة","ملتاعة الأعصاب ملهبة الدما",1,"م",2,0],["وَهَفَتْ بِديِنِ الْكُفْرِ أَطْمَاعٌ قَضَتْ","أَنْ تُقْتَضَى أَوْتَارُهُ وَذُحُولُهُ",2,"ل",2,0],["وَهَفا هَواها بي فَقُلتُ لَها","قَد حَلَّ هَذا المَوتُ مِن أَسري",3,"ر",2,0],["وهفت مبتهجا بها من بعدما","صافحتها فتبسمت لهتافي",4,"ف",2,0],["وَهَفا بِالفُؤادِ في سَلسَبيلٍ","ظَمَأٌ لِلسَوادِ مِن عَينِ شَمسِ",5,"س",1,0],["وَهَفَت بِتَغريدٍ هُنالِكَ أَيكَةٌ","خَفّاقَةٌ بِمَهَبِّ ريحِ عَرارِ",6,"ر",1,0],["وهَفَتْ جوانبُها ولولا ما رَسا","من عبء مجْدكَ ما استقَرّ مكانها",7,"ن",3,0],["وهفا الذّعرُ بالنفوسِ فلانوا","بعد حينٍ وللجَهالةِ حَدُّ",8,"د",1,0],["وهفت غمائمُ في السماء تظلُّكم","ويرفُّ مصعدُها لكم ومصيبها",9,"ب",3,0],["وهفَا كلُّ فؤادٍ وشدا كلُّ لسانِ","هذه فاتنةُ الدُّنيا وحسناءُ الزمانِ",10,"ن",1,0],["وهفَا للرياضِ تعبقُ بالمس","كِ وأصغى لهمسةِ الأغصان",11,"ن",1,0],["وهَفَتْ رايةٌ على قِمَّةِ النجْمِ","وَرَفَّتْ فوقَ السحابِ الثقال",12,"ل",1,0],["وهفت بدين الكفر أطماع قضت","أن تقتضي أوتاره ودخوله",13,"ل",2,0],["وهفا إلى لقياه ، انظر مدخل","تومى روائحه ، إلى الأضياف",14,"ف",1,0],["وهفا الموطن الكريم يحيّي","مشعل العلم في سناك الباهر",15,"ر",1,0],["وهفت إليك من القوافي جوقة","سكرى متيّمة الغناء المسكر",16,"ر",1,0],["وهفا فؤادٌ كالحديدِ على وأسبَلَت","عينٌ تُفاخر أنها لا تدمَع",17,"ع",1,0],["وهفا بالنعيم غازي لبغداد","وللجند والقنا والبنود",18,"د",1,0],["وَهفا النَومُ عَن جُفوني فَروحي","في وُجودٍ ضَلَّ الهدى عَن مَكانه",19,"ن",2,0],["وهفت إلى سلع نوازع قلبه","فتضرمت بين الجوانح ناره",20,"ر",2,0],["وَهَفَتْعَلَيْكَ نَوَاسِمُ الْغُفْرَانِ","تُزْجِي لَكَ الرَّحَمَاتِ مِنْ رَحْمَانِ",21,"ن",1,0],["وهفت روحي إلى رؤ","ية ما يطوى غدى",22,"د",2,0],["وهفا الورد إلى الطل","فرنّت قبلتان",23,"ن",1,0],["وَهَفَّت بِقامات الغُصو","ن إِلى اِعتِناقٍ وَالتِزام",24,"م",1,0],["وهفت به الذكري فطاف","مع الدُجى مغناً فمغنا",25,"ن",2,0],["وهفَتْ سيوفُ البرق في أرجائه","فكأنه متألقاً آراؤه",26,"ا",3,0],["وهَفَتْ بِهِ خُدَعُ الظُّنُونِ وَلَمْ يَزَلْ","حَسَدُ القرابَةِ طائِشَ الأَحْلامِ",27,"م",1,0],["وهفا ببيضاءِ المدا","ئن يومُ بؤس أَرْوَنانُ",28,"ن",1,0],["وهفَّتْ بأَغصانِ الحِمى ريحُ لَهْفَتي","فقامَتْ بزَلْزالٍ طَوى الهَزَّ في الكُلِّ",29,"ل",1,0]]}