وديه"],[438,"سائل لوى خبت فذاك لواؤه","https://www.aldiwan.net/poem12550.html","الكامل"],[445,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[463,"إن تسأليني بعد قومي","https://www.aldiwan.net/poem55856.html","مجزوء الكامل"],[505,"تعلم مني النوح في مذهب الهوى","https://www.aldiwan.net/poem37810.html","الطويل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104063","الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39070","الكامل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35374","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133776","الرمل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64970","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64764","الكامل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202556","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69403","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106849","الخفيف"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145062","الكامل"],[3542,"","https://poetry.dctabudhabi.ae/diwan/poem/76574","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131201",""],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29311","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93739","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81282","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83141","الكامل"],[4601,"","https://poetry.dctabudhabi.ae/diwan/poem/147767","الرمل"],[4767,"سيف الله","https://www.poetsgate.com/ViewPoem.aspx?id=179611",""],[4966,"أبى","https://www.poetsgate.com/ViewPoem.aspx?id=196967",""],[3271,"وطن الفأس","https://www.poetsgate.com/ViewPoem.aspx?id=104126",""],[5183,"سمراء النيل","https://www.poetsgate.com/ViewPoem.aspx?id=185681",""],[5431,"النارنج قصة عاشقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=202098",""],[5770,"طرب الفؤاد وهاجه شجن","https://www.poetsgate.com/ViewPoem.aspx?id=178269",""],[5858,"شاطئ العشق","https://www.poetsgate.com/ViewPoem.aspx?id=188119",""],[5906,"ماذا بعد","https://www.poetsgate.com/ViewPoem.aspx?id=188226",""],[5974,"حسنها والقمر","https://www.poetsgate.com/ViewPoem.aspx?id=201403",""],[6031,"هَتَفَتْ بِدَمْعِ العَينِ وَهْي سَجُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=46292",""],[6213,"إشراقة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79027&r=&rc=69",""],[433,"أنتِ السّماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87047&r=&rc=0",""],[6311,"نغم المساء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63488&r=&rc=7",""]],"verses":[["وهَفا بنا وَلَعُ النّسيمِ على الحِمى","فثَنى مَعاطِفَهُ إليهِ البانُ",0,"ن",1,0],["وهفت إليك كأنها مسحورة","ملتاعة الأعصاب ملهبة الدما",1,"م",2,0],["وَهَفَتْ بِديِنِ الْكُفْرِ أَطْمَاعٌ قَضَتْ","أَنْ تُقْتَضَى أَوْتَارُهُ وَذُحُولُهُ",2,"ل",2,0],["وَهَفا هَواها بي فَقُلتُ لَها","قَد حَلَّ هَذا المَوتُ مِن أَسري",3,"ر",2,0],["وهفت مبتهجا بها من بعدما","صافحتها فتبسمت لهتافي",4,"ف",2,0],["وَهَفا بِالفُؤادِ في سَلسَبيلٍ","ظَمَأٌ لِلسَوادِ مِن عَينِ شَمسِ",5,"س",1,0],["وَهَفَت بِتَغريدٍ هُنالِكَ أَيكَةٌ","خَفّاقَةٌ بِمَهَبِّ ريحِ عَرارِ",6,"ر",1,0],["وهَفَتْ جوانبُها ولولا ما رَسا","من عبء مجْدكَ ما استقَرّ مكانها",7,"ن",3,0],["وهفا الذّعرُ بالنفوسِ فلانوا","بعد حينٍ وللجَهالةِ حَدُّ",8,"د",1,0],["وهفت غمائمُ في السماء تظلُّكم","ويرفُّ مصعدُها لكم ومصيبها",9,"ب",3,0],["وهفَا كلُّ فؤادٍ وشدا كلُّ لسانِ","هذه فاتنةُ الدُّنيا وحسناءُ الزمانِ",10,"ن",1,0],["وهفَا للرياضِ تعبقُ بالمس","كِ وأصغى لهمسةِ الأغصان",11,"ن",1,0],["وهَفَتْ رايةٌ على قِمَّةِ النجْمِ","وَرَفَّتْ فوقَ السحابِ الثقال",12,"ل",1,0],["وهفت بدين الكفر أطماع قضت","أن تقتضي أوتاره ودخوله",13,"ل",2,0],["وهفا إلى لقياه ، انظر مدخل","تومى روائحه ، إلى الأضياف",14,"ف",1,0],["وهفا الموطن الكريم يحيّي","مشعل العلم في سناك الباهر",15,"ر",1,0],["وهفت إليك من القوافي جوقة","سكرى متيّمة الغناء المسكر",16,"ر",1,0],["وهفا فؤادٌ كالحديدِ على وأسبَلَت","عينٌ تُفاخر أنها لا تدمَع",17,"ع",1,0],["وهفا بالنعيم غازي لبغداد","وللجند والقنا والبنود",18,"د",1,0],["وَهفا النَومُ عَن جُفوني فَروحي","في وُجودٍ ضَلَّ الهدى عَن مَكانه",19,"ن",2,0],["وهفت إلى سلع نوازع قلبه","فتضرمت بين الجوانح ناره",20,"ر",2,0],["وَهَفَتْعَلَيْكَ نَوَاسِمُ الْغُفْرَانِ","تُزْجِي لَكَ الرَّحَمَاتِ مِنْ رَحْمَانِ",21,"ن",1,0],["وهفت روحي إلى رؤ","ية ما يطوى غدى",22,"د",2,0],["وهفا الورد إلى الطل","فرنّت قبلتان",23,"ن",1,0],["وَهَفَّت بِقامات الغُصو","ن إِلى اِعتِناقٍ وَالتِزام",24,"م",1,0],["وهفت به الذكري فطاف","مع الدُجى مغناً فمغنا",25,"ن",2,0],["وهفَتْ سيوفُ البرق في أرجائه","فكأنه متألقاً آراؤه",26,"ا",3,0],["وهَفَتْ بِهِ خُدَعُ الظُّنُونِ وَلَمْ يَزَلْ","حَسَدُ القرابَةِ طائِشَ الأَحْلامِ",27,"م",1,0],["وهفا ببيضاءِ المدا","ئن يومُ بؤس أَرْوَنانُ",28,"ن",1,0],["وهفَّتْ بأَغصانِ الحِمى ريحُ لَهْفَتي","فقامَتْ بزَلْزالٍ طَوى الهَزَّ في الكُلِّ",29,"ل",1,0],["وَهفت على أيدي القِيان كأنّها","رَخَمٌ تُرفرفُ في السّماء وتلتقي",30,"ق",2,0],["وهَفَتْ قُدودُ القُضْبِ هَفوةَ مُنْتَشٍ","لَمْا سَقاها الطَّلُّ ريّاً مُحْسِبا",31,"ب",2,0],["وَهَفَت تَشُقُّ جُيوبَ كُلِّ خَميلَةٍ","وَتَفُتُّ مِسكَةَ كُلِّ رَوضٍ مَمرِعِ",32,"ع",1,0],["وهفاء الوحي عليه وارتمى","كارتماء النور في صفحة ماء",33,"ا",2,0],["وهَفا بِعَقْلي مِنْ عَقائِل حُجْبِها","هَيْفاءُ ثابِتَةٌ عَلى تَلْوينِها",34,"ن",3,0],["وهفا بقَلْبي فيهِ كلُّ مُهَفْهَفٍ","لَدْنٍ يُساقَى بالصِّبا ويُغاذَى",35,"ذ",2,0],["وهفا براجحة العقول تماثلا","ما تصطفي النغمات من ألحانه",36,"ن",2,0],["وَهَفَت عَلَيهِ عَلامَةٌ مَعقُودَةٌ","بِالعِزِّ وَالتَأييدِ مِن عَلّامِهِ",37,"م",2,0],["وهفت فيَّ كل جارحةٍ تدمى","بوخز القوارص الجارحات",38,"ت",1,0],["وهفت لك الأكباد في أحشائها","مشدوهة من لحنك السحار",39,"ر",1,0],["وَهَفَت نُفُوسُهُمُ عَلى آثارِها","إِن مُتنَ مُتنَ وَإِن حَيين حَيينا",40,"ن",2,0],["وهفا الغرام بكم فهز جسومكم","وغفلتم فكأنكم أصنام",41,"م",1,0],["وَهَفَت عَلَيكِ الروحُ مِن وادي الأَسى","لِتَعُبَّ مِن خَمرِ الأَريجِ الأَبيَضِ",42,"ض",1,0],["وهفودماس رماه مذ وثبا","عن خيله متملصاً هربا",43,"ب",2,0],["وَهفت بِذات الرجع أنة موحش","فاِستعبرت بالشهب عين بكاء",44,"ا",2,0],["وَهَفا باسمك الفُؤاد وَلَجت","بَسَمات عَلى الخَواطر سَكرى",45,"ر",2,0],["وَهَفا بِلُبِّكَ في أَفا","نِينِ الصَبابَةِ ساحِرانِ",46,"ن",1,0],["وهفا بين سكون الخاطر","يصل الماضي بيمن الحاضر",47,"ر",1,0],["وهفت للذكرى أفئدة","حيت لمشاهد صفين",48,"ن",1,0],["وهفتْ إليك منابرٌ وتشوفتْ","كم كنتَ فيها بالمحامد تهتفُ",49,"ف",1,0],["وهفت نورةٌ من الفول بيضا","ءُ كطيف الإيمان في صلواتهْ",50,"ت",2,0],["وهفا بي الهوى إليك فأسلم","ت قيادى إليك دون اختيار",51,"ر",1,0],["وهفت تعابير الحروف كأنها","سربُ الظباء وعشبها الأوراقُ",52,"ق",1,0],["وهفا إلى ظِلٍ ومُنقلبٍ","يَحنو على أطياره وطنُ",53,"ن",1,0],["وهفت الى تقبيل خدي بينما","انا هائم بالبحر أقبض جمرا",54,"ا",1,0],["وهفت بأولى القبلتين كرامة","كانت لنا في سالف الأزمان",55,"ن",1,0],["وهَفَتْ فراشات الغرام لِوهجها","وَغَدَا الضياء على مجرتنا مدرْ",56,"ر",1,0],["وهَفَا إلى أَظْلالِ دَوحِكِ جُؤْذَرٌ","يعطُو إلى أَغْصَانِهِنَّ ورِيْمُ",57,"م",1,0],["وهفا الأصيل على المسارح باسماً","يحنو على هضباتها ويطوّق",58,"ق",1,0],["وهفت به الذكري","وطاف مع الدُّجى مغنًا فمغنا",59,"ن",2,0],["وهفا إلى شمس الأصيل يزفها","عبق اللقاء المستفيض تطيبا",60,"ب",2,0]]}