{"poems":[[65,"وفتيان صدق إن يهب بهم العدا","https://www.aldiwan.net/poem45890.html","الطويل"],[30,"تمنى ابن مسعود لقائي سفاهة","https://www.aldiwan.net/poem5061.html","الطويل"],[102,"الخضر المغمور","https://www.poetsgate.com/ViewPoem.aspx?id=50346",""],[119,"الا يا من به يجلى الظلام","https://www.aldiwan.net/poem40599.html","عموديه"],[226,"يلومني كل وقت","https://www.aldiwan.net/poem55252.html","المجتث"],[266,"نعم هذه الزوراء لاحت قصورها","https://www.aldiwan.net/poem38136.html","الطويل"],[327,"ألا طال التنظر والثواء","https://www.aldiwan.net/poem56353.html","الوافر"],[364,"أتى من أريج النصر ما يشرح الصدرا","https://www.aldiwan.net/poem810.html",""],[376,"أتاني عنك إخوانك","https://www.aldiwan.net/poem57037.html","الهزج"],[376,"معي كلمات ما يطاق احتمالها","https://www.aldiwan.net/poem57213.html","الكامل"],[468,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82794","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66649","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48535","الوافر"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17570","الطويل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216882","الوافر"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72255","الوافر"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128717","الوافر"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26403","الوافر"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131685",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110079","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133275","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133197",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72494","الرجز"],[4759,"وكيف إلتفاتي؟","https://www.poetsgate.com/ViewPoem.aspx?id=204067",""],[5353,"رئة من خشب","https://www.poetsgate.com/ViewPoem.aspx?id=212242",""],[5410,"دَعني أُحِبُّكَ","https://www.poetsgate.com/ViewPoem.aspx?id=73758",""],[5770,"على اليرموك","https://www.poetsgate.com/ViewPoem.aspx?id=178268",""],[5776,"وَصَايَاهُم","https://www.poetsgate.com/ViewPoem.aspx?id=199441",""],[5866,"لوكان فكري يحمر العين مشلول","https://www.poetsgate.com/ViewPoem.aspx?id=182811",""],[6320,"مَهَاوِي اليَأْس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84354&r=&rc=51",""]],"verses":[["عَلى أَعْوَجِيّاتٍ تَهَشُّ إِلى الوَغَى","وَيَلْقَى تَكالِيفَ الأَذَى مَنْ يَذُودُها",0,"د",3,0],["عَلى أَعوَجِيّاتٍ كَأَنَّ صُدورَها","قَنا سَيسَجانٍ ماؤُهُ قَد تَحَسَّرا",1,"ر",2,0],["على أعين (الغيلان) يركض حافيا","ويجترّ من أحجار (عيبان) مئزرا",2,"ر",2,0],["على اعتابه في كل آن","وجوه العالمين لها ازدحام",3,"م",1,0],["على اعتزالي وبعدي","ونزلتي في الفنادق",4,"ق",1,0],["على اعوجيات كأن مهادنا","إذا قلقلتنا للهدو ظهورها",5,"ر",3,0],["عَلى أَعجازِهِ إِذ لاحَ فيهِ","سُيوفُ الهِندِ أَخلَصَها الجِلاءُ",6,"ا",2,0],["على أعوَجِيَّاتٍ لقد عَمَّت الفضا","عليها كُماةٌ لا يخافونه الذُعرا",7,"ر",2,0],["على أعراضِنا صارَت","مع الناسِ يَسبُّونا",8,"ن",2,0],["على أعيُنِ العُشاقِ أن تَجلب الهَوى","لهُم ولها تَسهيدُها وانهِمالُها",9,"ل",3,0],["على أعلى الورى شرفا وقدرا","نبي دينه الدين الحنيف",10,"ف",1,0],["عَلِّى أَعبُّ مَليا مِن مناهله","وَيَغتذى القَلب مِن رُباه رَيانا",11,"ن",2,0],["عليٌّ أعزُّ الناسِ جاراً وحامياً","وأقتلُهم للقِرنِ يومَ الكتائبِ",12,"ب",1,0],["عليٌّ أعمُّ الناس حِلماً ونائلاً","وأجودُهم بالمالِ حقّاً لطالبِ",12,"ب",1,0],["على أعدائه براً وبحرا","وصار لملك عثمان التئامُ",13,"م",1,0],["عَلى أَعظم بِالرايحانِ وَدايهِ","مُقَدَّسَة تَحتَ التُرابِ رُفاتِ",14,"ت",1,0],["على أعراقِهِ يجري المُذكّي","وليسَ على تكلُّفه وجهده",15,"ه",1,1],["على أعدائهم مني شهاب","تودع ناره أيدي الهواء",16,"ا",2,0],["على أعقابهم ولّو حفاة","وما وصلوا إلى خفّي حنين",17,"ن",1,0],["عَلى أَعجازِها قَرمٌ إِذا ما","عَناهُ القَولُ أَوجَزَ في تَمامِ",18,"م",1,0],["عليا عار لا غزل غزل مثنى","بمنويط الدياثه والفضايح",19,"ح",1,0],["عليَّا على الأَفلاكِ في أَرفَع الذِرَى","يُؤائِمُ املاكَ السَما وتُوائمُه",20,"م",2,0],["على أعتابكم ألقيت حملي","فأضحت لي كرامتكم أنيسه",21,"ه",1,1],["على أعلام أصحاب الزوايا","شموس الدين والجيل الأكابر",22,"ر",1,0],["على أعادي الدين سلطان الورى","الله أرَّخ دائما مظفرا",23,"ر",2,0],["على أعين لا تمر الطريق","ولا تشتهي. فيه إلا شذاك",24,"ك",1,0],["علّي أعودُ ..ولا أدري فربّ دم","أحتاجه لحروب سوف تندفق",25,"ق",1,0],["عَلّي أُعَطّر بعضَ ما في عالم ٍ","أضحى به الحُبُّ النقيُّ طَريدا",26,"د",2,0],["على أعتابها قد هام قبلي","\"أخو حلبٍ\" وطارحها الغراما",27,"م",2,0],["على أعتابهم يتلو فؤادي","وصاياهم: دفاعٌ واقتحامُ",28,"م",1,0],["على اعظم انساناً من الرب مرسول","صفوة جميع الخلق فوّل وتالي",29,"ل",2,0],["عَلَى أَعْتَابِ قِمَّتِكُمْ فَبُوءُوا","بِعَارٍ لِلَّظَى اسْتَاقَ الدِّيَارَا",30,"ر",2,0]]}