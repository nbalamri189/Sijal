{"poems":[[77,"حيى ربوع الحي من نعمان","https://www.aldiwan.net/poem36079.html","الكامل"],[86,"قد راع دار العدل طغيان","https://www.aldiwan.net/poem68888.html","مجزوء الكامل"],[51,"وقهوة رقت عن الهواء","https://www.aldiwan.net/poem8139.html","الرجز"],[92,"يا ليل ما تصنع النفس التي سكنت","https://www.aldiwan.net/poem38942.html","الكامل"],[56,"وقهوة كوكبها يزهر","https://www.aldiwan.net/poem58598.html","السريع"],[66,"قد أضحك الروض مدمع السحب","https://www.aldiwan.net/poem38809.html","المنسرح"],[66,"حويت الحمد إرثا واكتسابا","https://www.aldiwan.net/poem39044.html","الوافر"],[66,"وقهوة يجتلى السرور بها","https://www.aldiwan.net/poem39195.html","المنسرح"],[66,"أذاب التبر في كأس اللجين","https://www.aldiwan.net/poem40114.html","الوافر"],[66,"يا نسمة لأحاديث الحمى شرحت","https://www.aldiwan.net/poem41359.html","البسيط"],[80,"أصبحت جذلان طيب العربه","https://www.aldiwan.net/poem31562.html","المنسرح"],[44,"وقهوة كوكبها يزهر","https://www.aldiwan.net/poem30254.html","السريع"],[52,"قم صاحبي نغدو لجيش الوحش","https://www.aldiwan.net/poem26891.html","الرجز"],[52,"هل لك في ليلة بيضاء مقمرة","https://www.aldiwan.net/poem27081.html","البسيط"],[48,"شمر شبابك في قتلي وتعذيبي","https://www.aldiwan.net/poem10772.html","البسيط"],[48,"ربع البلى أخرس عميت","https://www.aldiwan.net/poem62459.html","السريع"],[48,"وقهوة مرة باكرت صبحتها","https://www.aldiwan.net/poem62511.html","البسيط"],[48,"وقهوة باكرتها سحرة","https://www.aldiwan.net/poem62516.html","السريع"],[48,"وقهوة كالعقيق صافية","https://www.aldiwan.net/poem63301.html","المنسرح"],[48,"وقهوة عتقت في دير شماس","https://www.aldiwan.net/poem63421.html","الطويل"],[48,"وقهوة كجني الورد خالصة","https://www.aldiwan.net/poem64423.html","الطويل"],[48,"أحسن من وصف دارس الدمن","https://www.aldiwan.net/poem65306.html","المنسرح"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39574","الخفيف"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9977","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9919","الخفيف"],[77,"حيى ربوع الحي من نعمان","https://www.poetsgate.com/ViewPoem.aspx?id=34207",""],[115,"بدأت ببسم الله في مبدأ الأمر","https://www.aldiwan.net/poem42205.html","الطويل"],[132,"أشاقتك ورق اللوى هتفا","https://www.aldiwan.net/poem54796.html","المتقارب"],[143,"بجيد علاك مدحي كل آن","https://www.aldiwan.net/poem11828.html","الوافر"],[144,"سطا جيش أهواء على من بكم لاذا","https://www.aldiwan.net/poem4459.html","الطويل"],[174,"قد ضاع فيك صبري","https://www.aldiwan.net/poem46040.html","منهوك المنسرح"],[174,"وقهوة يترامى","https://www.aldiwan.net/poem46062.html","الخفيف"],[249,"هل للحليم على ما فات من أسف","https://www.aldiwan.net/poem2102.html","البسيط"],[257,"حسب الخليع ملجا","https://www.aldiwan.net/poem2666.html","منهوك المنسرح"],[348,"وقهوة سبقت كل","https://www.aldiwan.net/poem20738.html","مجزوء الخفيف"],[361,"بروضة هذا النظم نزهت ناظري","https://www.aldiwan.net/poem68054.html","الطويل"],[364,"بيض طوالع من خيام سود","https://www.aldiwan.net/poem60954.html","الكامل"],[371,"دنا فزاد اشتعال الشوق بالبلل","https://www.aldiwan.net/poem57208.html","البسيط"],[393,"وقهوة قد حضرت بختمها","https://www.aldiwan.net/poem53419.html","مربع الرجز"],[405,"يا حسن لذة أيام لنا سلفت","https://www.aldiwan.net/poem49976.html","البسيط"],[439,"عادت عليك عوائد الأعوام","https://www.aldiwan.net/poem34806.html","الكامل"],[468,"وقهوة كخلوق","https://www.aldiwan.net/poem59992.html","المجتث"],[468,"اليوم يا ذا الفخر والمجد","https://www.aldiwan.net/poem60223.html","السريع"],[468,"وقهوة عنقت فنالت","https://www.aldiwan.net/poem60518.html","مخلع البسيط"],[500,"لا تعنف مولها أحمديا","https://www.aldiwan.net/poem37649.html","الخفيف"],[551,"عن الخيال لنا ليالي الأبرق","https://www.aldiwan.net/poem47353.html","الكامل"],[553,"نبا به الوساد","https://www.aldiwan.net/poem68396.html","مجزوء الرجز"],[553,"أما النحيب فإني سوف أنتحب","https://www.aldiwan.net/poem68401.html","البسيط"]],"verses":[["وَقَهَرْتُمُ مَنْ رَامَهَا بِمَسَاءَةٍ","فَغَدَا مُعَنَّى رِبْقَةِ الإِذْعَانِ",0,"ن",1,0],["وَقَهَرتُما الباغي عَلى","رَدِّ الحُقوقِ الناصِعَه",1,"ع",2,0],["وقهوةٍ رقَّتْ عن الهواءِ","أدفَعَ للداء من الدواءِ",2,"ا",2,1],["وقَهْقَهَ القَدَرُ الجبَّارُ سُخْريةً","بالكائناتِ تَضاحَكْ أَيُّها القَدَرُ",3,"ر",1,0],["وَقَهْوَةٍ كَوْكَبُها يُزْهِرُ","يَنْفَحُ مِنْها المِسْكُ والعَنْبَرُ",4,"ر",1,1],["وَقَهقَهَ الوَردُ لِلصِبا فَغَدَت","تَملَأُ فاهُ قُراضَةُ الذَهَبِ",5,"ب",1,0],["وَقَهوَتُنا مِنَ المَطبوخِ حِلٌّ","إِذا دُعِيَ الفَقيهُ لَها أَجابا",6,"ب",2,0],["وَقَهوَةٍ يُجتَلى السُرورُ بِها","وَتَنجَلي بِاِنجِلائِها الكُرَبُ",7,"ب",1,1],["وَقَهوَتُنا شَبيهُ شَواظِ نارٍ","تَوَقَّدُ في أَكُفِّ الساقَيَينِ",8,"ن",1,0],["وَقَهوَةٍ كَوَميضِ البَرقِ صافِيَةٍ","كَأَنَّها مِن أَديمِ الشَمسِ قَد رَشَحَت",9,"ت",1,0],["وقهوَةٍ في الزّجاجِ تحسبُها","شُعْلَةَ برقٍ في الغيم ملتهبَه",10,"ب",2,0],["وَقَهوَةٍ كَوكَبُها يَزهَرُ","يَسطَعُ مِنها المِسكُ وَالعَنبَرُ",11,"ر",1,1],["وَقَهوَةٍ صِرفٍ بِغَيرِ غِشِّ","تَفُشُّ قُفلَ الهَمِّ أَيَّ فَشِّ",12,"ش",1,0],["وَقَهوَةٍ كَشُعاعِ الشَمسِ صافِيَةٍ","كَأَنَّ أَقداحَها قَد عُمنَ بِالزَبَدِ",13,"د",1,0],["وَقَهوَةٍ مِثلُ عَينِ الديكِ صافِيَةً","مِن خَمرِ عانَةَ أَو مِن خَمرَةِ السِيَبِ",14,"ب",1,0],["وَقَهوَةٍ كَالمِسكِ مَشمولَةٍ","مَنزِلُها الأَنبارِ أَو هيتُ",15,"ت",1,0],["وَقَهوَةٍ مُرَّةٍ باكَرتُ صُبحَتَها","وَضَوءُها نائِبٌ عَن ضَوءِ مِصباحِ",16,"ح",1,1],["وَقَهوَةٍ باكَرتُها سُحرَةً","وَالصُبحُ قَد أَسفَرَ في لوحِه",17,"ح",2,1],["وَقَهوَةٍ كَالعَقيقِ صافِيَةٍ","يَطيرُ مِن كَأسِها لَها شَرَرُ",18,"ر",1,1],["وَقَهوَةٍ عُتِّقَت في دَيرِ شَمّاسِ","تَفتَرُّ في كَأسِها عَن ضَوءِ مِقباسِ",19,"س",1,1],["وَقَهوَةٍ كَجَنِيِّ الوَردِ خالِصَةٍ","قَد أَذهَبَ العِتقُ فيها الذامَ وَالرَنَقا",20,"ق",2,1],["وَقَهوَةٍ لا القَذى يُخالِطُها","تَأتيكَ مِن مَعدِنٍ وَمِن عَطَنِ",21,"ن",1,0],["وَقَهوَةٍ صَهباءَ باكَرتُها","بِجُهمَةٍ وَالديكُ لَم يَنعَبِ",22,"ب",1,0],["وقهرتُ الحياةَ حتى كأني","قَدَرٌ تكتبُ الحتوفُ وأُملي",23,"ي",1,0],["وَقَهَرتُ أَبطالَ الوَغى حَتّى غَدَوا","جَرحى وَقَتلى مِن ضِرابِ حُسامي",24,"ي",1,0],["وَقَهَرتُ المُلوكَ شَرقاً وَغَرباً","وَأَبَدتُ الأَقرانَ يَومَ الطِرادِ",25,"د",1,0],["وقهرتم من رامها لمساءة","فغدا معنى ربقة الأذعان",26,"ن",1,0],["وقهار قهر لي عدوي مدى المدى","ويا رب يا وهاب زدني من الفخر",27,"ر",1,0],["وقَهقَهَ جَهراً مَدَى صَوتِهِ","إِلَى أن تَتَابَعَ نَحوَ القَفَا",28,"ف",2,0],["وَقَهرُكَ مَن أَخافَ الناسَ قِدماً","كَفاكَ تَطاوُلاً في ذا الزَمانِ",29,"ن",1,0],["وقهركم عنه يذبُ على الولاء","يقلده عضبا إلى الشر جذاذا",30,"ذ",2,0],["وَقَهْوَةٍ كَالجَمْرِ","تِبْرٌ وَلكِنْ تَجْرِي",31,"ي",1,0],["وَقَهْوَةٍ يَتَرامى","شَعاعُها بِلَهِيبِ",32,"ب",1,1],["وَقَهوَةٍ تُنشِقُ المُستامَ نَكهَتُها","صَهباءَ صافِيَةٍ مِن خَمرِ ذي نَطَفِ",33,"ف",1,0],["وَقَهوَةٌ مُدارَه","أَنفاسُها عَبير",34,"ر",1,0],["وَقهوةٌ سَبَقَتْ كُ","لَّ مُدَّةٍ وَأَوانِ",35,"ن",1,1],["وَقه عَلى ما أَبرَزت من مُؤلف","بَد الدَهر تَلق الفَضل لِلمُتَقَدّم",36,"م",1,0],["وقَهرْتَهم بعُلُوِّ جَدِّك كلَّهم","ومن العَناءِ عَداوةُ المَجْدود",37,"د",1,0],["وقَهوةٍ قام شهرُ الصومِ يَطرُدها","عن ملَّةٍ فانضَوَت مِنها إلى ملَلِ",38,"ل",1,0],["وَقَهوَةٍ قَد حَضَرت بِخَتمِها","فَقُلتُ لِلنَدمانِ عِند شَمِّها",39,"ه",2,1],["وقَهوةٍ وسُلافِ الدَّنِّ صافيةٍ","كالمِسكِ والعنَبرِ الهِنديِّ والعُودِ",40,"د",1,0],["وقهرْتَ أَشياعَ الضلالِ مُؤَيَّداً","بنوافِذِ الأَقْدارِ والأَحكامِ",41,"م",1,0],["وَقَهوَةٍ كَخَلوقٍ","يَفتَرُّ عَن كافورِ",42,"ر",1,1],["وَقَهوَةٌ لَو أَنَّها عَنبَرٌ","لَكانَ مَنسوباً إِلى الهِندِ",43,"د",1,0],["وَقَهوَةٍ عُنِّقَت فَنالَت","أَوفَرَ حَظٍّ مِنَ الصَفاءِ",44,"ا",2,1],["وقهرت الحسود بالمدد الف","ياضِ فالنار فيه أبدت صليّا",45,"ي",2,0],["وقهرتَهمْ بمحلّةٍ لا ترتَقى","وبهرتَهمْ في جودك المتدفّقِ",46,"ق",1,0],["وَقَهوَةٍ شَمولٍ","مَنشَؤُها السَوادُ",47,"د",1,0],["وَقَهوَةٍ مِنَ بَناتِ الكَرمِ صافِيَةٍ","صَهبا يَهودِيَّةٍ أَربابُها العَرَبُ",48,"ب",1,0]]}