udhabi.ae/diwan/poem/118748","المتقارب"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216519","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85200","الوافر"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32808","المجتث"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32846","المنسرح"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40100","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86437","البسيط"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93302","السريع"],[4386,"","https://poetry.dctabudhabi.ae/diwan/poem/33814","المنسرح"],[4859,"صراعات نبض","https://www.poetsgate.com/ViewPoem.aspx?id=204283",""],[4956,"من الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=1393",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5313,"وبلدة قطعتها بضامر","https://www.poetsgate.com/ViewPoem.aspx?id=181095",""],[592,"هو الله معبود العباد فعامل","https://www.poetsgate.com/ViewPoem.aspx?id=128859",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5431,"خيمة بؤسٍ...وقصعةِ بردِ","https://www.poetsgate.com/ViewPoem.aspx?id=183414",""],[5431,"تعِزّ...الحبية تعزّ...حماها الله","https://www.poetsgate.com/ViewPoem.aspx?id=190354",""],[5431,"البردة -ريم","https://www.poetsgate.com/ViewPoem.aspx?id=190769",""],[5431,"رقص سوريالي!!","https://www.poetsgate.com/ViewPoem.aspx?id=200445",""],[5616,"حبيبتي أنت","https://www.poetsgate.com/ViewPoem.aspx?id=203493",""],[5634,"وقهوةٍ كدموع الصب صافيةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=181463",""],[6143,"عذرا رسول الله...","https://www.poetsgate.com/ViewPoem.aspx?id=175095",""],[6257,"بدويّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87175&r=&rc=0",""]],"verses":[["وَقَهَرْتُمُ مَنْ رَامَهَا بِمَسَاءَةٍ","فَغَدَا مُعَنَّى رِبْقَةِ الإِذْعَانِ",0,"ن",1,0],["وَقَهَرتُما الباغي عَلى","رَدِّ الحُقوقِ الناصِعَه",1,"ع",2,0],["وقهوةٍ رقَّتْ عن الهواءِ","أدفَعَ للداء من الدواءِ",2,"ا",2,1],["وقَهْقَهَ القَدَرُ الجبَّارُ سُخْريةً","بالكائناتِ تَضاحَكْ أَيُّها القَدَرُ",3,"ر",1,0],["وَقَهْوَةٍ كَوْكَبُها يُزْهِرُ","يَنْفَحُ مِنْها المِسْكُ والعَنْبَرُ",4,"ر",1,1],["وَقَهقَهَ الوَردُ لِلصِبا فَغَدَت","تَملَأُ فاهُ قُراضَةُ الذَهَبِ",5,"ب",1,0],["وَقَهوَتُنا مِنَ المَطبوخِ حِلٌّ","إِذا دُعِيَ الفَقيهُ لَها أَجابا",6,"ب",2,0],["وَقَهوَةٍ يُجتَلى السُرورُ بِها","وَتَنجَلي بِاِنجِلائِها الكُرَبُ",7,"ب",1,1],["وَقَهوَتُنا شَبيهُ شَواظِ نارٍ","تَوَقَّدُ في أَكُفِّ الساقَيَينِ",8,"ن",1,0],["وَقَهوَةٍ كَوَميضِ البَرقِ صافِيَةٍ","كَأَنَّها مِن أَديمِ الشَمسِ قَد رَشَحَت",9,"ت",1,0],["وقهوَةٍ في الزّجاجِ تحسبُها","شُعْلَةَ برقٍ في الغيم ملتهبَه",10,"ب",2,0],["وَقَهوَةٍ كَوكَبُها يَزهَرُ","يَسطَعُ مِنها المِسكُ وَالعَنبَرُ",11,"ر",1,1],["وَقَهوَةٍ صِرفٍ بِغَيرِ غِشِّ","تَفُشُّ قُفلَ الهَمِّ أَيَّ فَشِّ",12,"ش",1,0],["وَقَهوَةٍ كَشُعاعِ الشَمسِ صافِيَةٍ","كَأَنَّ أَقداحَها قَد عُمنَ بِالزَبَدِ",13,"د",1,0],["وَقَهوَةٍ مِثلُ عَينِ الديكِ صافِيَةً","مِن خَمرِ عانَةَ أَو مِن خَمرَةِ السِيَبِ",14,"ب",1,0],["وَقَهوَةٍ كَالمِسكِ مَشمولَةٍ","مَنزِلُها الأَنبارِ أَو هيتُ",15,"ت",1,0],["وَقَهوَةٍ مُرَّةٍ باكَرتُ صُبحَتَها","وَضَوءُها نائِبٌ عَن ضَوءِ مِصباحِ",16,"ح",1,1],["وَقَهوَةٍ باكَرتُها سُحرَةً","وَالصُبحُ قَد أَسفَرَ في لوحِه",17,"ح",2,1],["وَقَهوَةٍ كَالعَقيقِ صافِيَةٍ","يَطيرُ مِن كَأسِها لَها شَرَرُ",18,"ر",1,1],["وَقَهوَةٍ عُتِّقَت في دَيرِ شَمّاسِ","تَفتَرُّ في كَأسِها عَن ضَوءِ مِقباسِ",19,"س",1,1],["وَقَهوَةٍ كَجَنِيِّ الوَردِ خالِصَةٍ","قَد أَذهَبَ العِتقُ فيها الذامَ وَالرَنَقا",20,"ق",2,1],["وَقَهوَةٍ لا القَذى يُخالِطُها","تَأتيكَ مِن مَعدِنٍ وَمِن عَطَنِ",21,"ن",1,0],["وَقَهوَةٍ صَهباءَ باكَرتُها","بِجُهمَةٍ وَالديكُ لَم يَنعَبِ",22,"ب",1,0],["وقهرتُ الحياةَ حتى كأني","قَدَرٌ تكتبُ الحتوفُ وأُملي",23,"ل",2,0],["وَقَهَرتُ أَبطالَ الوَغى حَتّى غَدَوا","جَرحى وَقَتلى مِن ضِرابِ حُسامي",24,"م",2,0],["وَقَهَرتُ المُلوكَ شَرقاً وَغَرباً","وَأَبَدتُ الأَقرانَ يَومَ الطِرادِ",25,"د",1,0],["وقهرتم من رامها لمساءة","فغدا معنى ربقة الأذعان",26,"ن",1,0],["وقهار قهر لي عدوي مدى المدى","ويا رب يا وهاب زدني من الفخر",27,"ر",1,0],["وقَهقَهَ جَهراً مَدَى صَوتِهِ","إِلَى أن تَتَابَعَ نَحوَ القَفَا",28,"ف",2,0],["وَقَهرُكَ مَن أَخافَ الناسَ قِدماً","كَفاكَ تَطاوُلاً في ذا الزَمانِ",29,"ن",1,0],["وقهركم عنه يذبُ على الولاء","يقلده عضبا إلى الشر جذاذا",30,"ذ",2,0],["وَقَهْوَةٍ كَالجَمْرِ","تِبْرٌ وَلكِنْ تَجْرِي",31,"ر",2,0],["وَقَهْوَةٍ يَتَرامى","شَعاعُها بِلَهِيبِ",32,"ب",1,1],["وَقَهوَةٍ تُنشِقُ المُستامَ نَكهَتُها","صَهباءَ صافِيَةٍ مِن خَمرِ ذي نَطَفِ",33,"ف",1,0],["وَقَهوَةٌ مُدارَه","أَنفاسُها عَبير",34,"ر",1,0],["وَقهوةٌ سَبَقَتْ كُ","لَّ مُدَّةٍ وَأَوانِ",35,"ن",1,1],["وَقه عَلى ما أَبرَزت من مُؤلف","بَد الدَهر تَلق الفَضل لِلمُتَقَدّم",36,"م",1,0],["وقَهرْتَهم بعُلُوِّ جَدِّك كلَّهم","ومن العَناءِ عَداوةُ المَجْدود",37,"د",1,0],["وقَهوةٍ قام شهرُ الصومِ يَطرُدها","عن ملَّةٍ فانضَوَت مِنها إلى ملَلِ",38,"ل",1,0],["وَقَهوَةٍ قَد حَضَرت بِخَتمِها","فَقُلتُ لِلنَدمانِ عِند شَمِّها",39,"ه",2,1],["وقَهوةٍ وسُلافِ الدَّنِّ صافيةٍ","كالمِسكِ والعنَبرِ الهِنديِّ والعُودِ",40,"د",1,0],["وقهرْتَ أَشياعَ الضلالِ مُؤَيَّداً","بنوافِذِ الأَقْدارِ والأَحكامِ",41,"م",1,0],["وَقَهوَةٍ كَخَلوقٍ","يَفتَرُّ عَن كافورِ",42,"ر",1,1],["وَقَهوَةٌ لَو أَنَّها عَنبَرٌ","لَكانَ مَنسوباً إِلى الهِندِ",43,"د",1,0],["وَقَهوَةٍ عُنِّقَت فَنالَت","أَوفَرَ حَظٍّ مِنَ الصَفاءِ",44,"ا",2,1],["وقهرت الحسود بالمدد الف","ياضِ فالنار فيه أبدت صليّا",45,"ي",2,0],["وقهرتَهمْ بمحلّةٍ لا ترتَقى","وبهرتَهمْ في جودك المتدفّقِ",46,"ق",1,0],["وَقَهوَةٍ شَمولٍ","مَنشَؤُها السَوادُ",47,"د",1,0],["وَقَهوَةٍ مِنَ بَناتِ الكَرمِ صافِيَةٍ","صَهبا يَهودِيَّةٍ أَربابُها العَرَبُ",48,"ب",1,0],["وقهوة بنت كرم","صفت من الذم صفوا",49,"و",2,0],["وقه إذا قام الورى","للعرض محذور العقابْ",50,"ب",1,0],["وقهوةٍ كشعاعِ الشمسِ صافيةٍ","كأنَّ أقدامَها غُشّينَ بالبرد",51,"د",1,0],["وَقَهرَهُ الأَعداءَ في كلِّ زَمَنْ","يلبِسُهم ثَوبَ البَلايا وَالمِحَنْ",52,"ن",1,0],["وقهرتَ حتى كلُّ جبا","رٍ غدا لكمُ صغيرا",53,"ر",2,0],["وقهوة كشعاع الشمس مشرقة","باكرتها وبشير الصبح لم يلمحِ",54,"ح",1,0],["وَقَهوَةٌ 