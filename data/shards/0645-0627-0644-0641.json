{"poems":[[91,"ورد يطيح وبلبل اسوان","https://www.aldiwan.net/poem44907.html","الكامل"],[47,"أريحيات صبوة ومشيب","https://www.aldiwan.net/poem62638.html","الخفيف"],[60,"لو صيغ من فضة نفس على قدر","https://www.aldiwan.net/poem31142.html","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[74,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[246,"يا بني الفقر سلاما عاطرا","https://www.aldiwan.net/poem45752.html","الرمل"],[443,"مال في الحب على ضعيفي وملا","https://www.aldiwan.net/poem2545.html","الرمل"],[466,"حي نجدا وأين من مرو نجد","https://www.aldiwan.net/poem15112.html","الخفيف"],[484,"ناشدتك الله في فتاك","https://www.aldiwan.net/poem36919.html","مخلع البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66682","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64040","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120121","السريع"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128067","الكامل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126223","الرمل"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70349","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65988","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93870","الخفيف"],[3280,"","https://poetry.dctabudhabi.ae/diwan/poem/203131","الرجز"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100173","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86447","الخفيف"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136812",""],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102744","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102728","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72426","الرجز"],[5325,"بصادق الجد بيت المجد يرتفع","https://www.poetsgate.com/ViewPoem.aspx?id=171977",""]],"verses":[["ما لفظها الا دموع ثرة","اما الدموع فانها احزان",0,"ن",1,0],["مَألِفٌ لِلغَريبِ ما فيهِ إِلفٌ","مِن وُفودِ العُفاةِ إِلّا الغَريبُ",1,"ب",1,0],["ما لِفَتىً حَسَبٌ إِلّا إِذا كَمُلَت","أَخلاقُهُ وَحَوى الآدابَ وَالحَسَبا",2,"ب",2,0],["مال فيها برأسِه كلّ فرْعٍ","باحثاً في الترابِ عنْ وَرَقاتهْ",3,"ت",2,0],["ما لفصيح ذبيان","شقيقه في النعمان",4,"ن",1,0],["ما لفرجيني وباريس أما","كانَ في القفرِ عن الدنيا غَناء",5,"ا",2,0],["مال في الحبّ على ضعيفي وملّا","رشأ أبدلني بالعز ذلّا",6,"ل",2,1],["ما لفضلي يُذالُ بينَ أناسٍ","جودَهُمْ موعدٌ وشعري نقْدُ",7,"د",1,0],["ما لفتاتي سوى حياتي","إن قلت هات أجبت هاك",8,"ك",1,0],["ما لُفَّ في خِرَقِ القوافلِ مثلُهُ","إلاّ ابن آمنةَ النبيُّ محمدُ",9,"د",1,0],["مألفٌ موحشٌ من الألاف","هاج عافيه لي جوىً غيرَ عافِ",10,"ف",1,1],["ما لفتى الصاحب لا الصاحب","يشقصه وتظهر العجائبُ",11,"ب",1,1],["مالفخر الا للذى","كان المشرف حيث حل",12,"ل",1,0],["مالَ فى لَيلَى وسَلمَى مُفرِداً","فى مُحَيَّاهُ الفُؤادُ المُستَهامُ",13,"م",1,0],["ما لفؤادي عنهم","صبر ولا لي معدل",14,"ل",1,0],["ما لفعت في خرق أو أدم","يوم ولدت لم تُباشر رحمي",15,"م",2,0],["مال فينا بعادل القد ظلماً","وانثنى بين عادل وظلوم",16,"م",1,0],["مال فؤادي في الهوى","إليه عمداً وصبا",17,"ب",2,0],["ما لف ميزره إلالا على شرف","في طيه النسب الوضاح والحسب",18,"ب",1,0],["ما لفودي ينكران المشيبا","أحسن الشهب طالع لن يغيبا",19,"ب",2,1],["مالفرح ذي يصيب القلب مثل التفراح","والهوى ما انفتاحه غير من سر فتاح",20,"ح",1,0],["ما لفظ قس حين قامت بالملا","يوم المواسم والوفود عكاظ",21,"ظ",1,0],["ما لفظ سحبان وما قس إذا","ما فاه بالتحذير والاغراء",22,"ا",2,0],["ما لفت الاحقاب في حقيبة","كيومه لا عاد يوما أيوما",23,"م",2,0],["ما لف بردته إلا على كرم","وهمة في ثنايا العز تطلع",24,"ع",1,0]]}