diwan/poem/93759","الرمل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136746",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83359","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120513","الرمل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52140","الرمل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204294","الخفيف"],[4778,"سائل الأطيار عني","https://www.poetsgate.com/ViewPoem.aspx?id=193619",""],[4791,"صك المحبه","https://www.poetsgate.com/ViewPoem.aspx?id=35901",""],[4797,"تقرير في صورة مثايل","https://www.poetsgate.com/ViewPoem.aspx?id=178138",""],[4915,"نُبُوءة","https://www.poetsgate.com/ViewPoem.aspx?id=211345",""],[4988,"ذكرياتي الأوليّة","https://www.poetsgate.com/ViewPoem.aspx?id=208808",""],[5038,"قارورة مسك","https://www.poetsgate.com/ViewPoem.aspx?id=189987",""],[5074,"شوق واعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=153919",""],[5074,"الغائب الحاضر","https://www.poetsgate.com/ViewPoem.aspx?id=153717",""],[5092,"ما أروعك","https://www.poetsgate.com/ViewPoem.aspx?id=190577",""],[5138,"تهت في دربي","https://www.poetsgate.com/ViewPoem.aspx?id=185128",""],[5183,"من طرائف المأمون","https://www.poetsgate.com/ViewPoem.aspx?id=180285",""],[5213,"يا خليلي ان عزمتم رحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=170524",""],[5279,"المصيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=183492",""],[5431,"وساده....","https://www.poetsgate.com/ViewPoem.aspx?id=201735",""],[5431,"نحن موتى وإنهم أحياء..","https://www.poetsgate.com/ViewPoem.aspx?id=202730",""],[5444,"صاحبِ الشمسَ ....نزوى","https://www.poetsgate.com/ViewPoem.aspx?id=185386",""],[5596,"فنجاء","https://www.poetsgate.com/ViewPoem.aspx?id=206476",""],[5616,"غُربة... إلى أصحاب الحقائب المسافرة","https://www.poetsgate.com/ViewPoem.aspx?id=204850",""],[5747,"الجرح العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=61671",""],[5956,"الأديان والمذاهب والطوائف","https://www.poetsgate.com/ViewPoem.aspx?id=192181",""],[6056,"ملاك الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=130338",""],[6084,"أشرقت شمس الضحى بالغلس","https://www.poetsgate.com/ViewPoem.aspx?id=170846",""],[6189,"عاهة مستديمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83601&r=&rc=68",""],[3155,"الأريج القديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75609&r=&rc=32",""],[6328,"آمنة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84422&r=&rc=20",""],[6344,"سلالم الشَّك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87968&r=&rc=8",""]],"verses":[["كلما هزَّ بالمعاطف ريحاً","قرعت أنمل الصبابة سني",0,"ن",2,0],["كُلَّما هبَّ هبَّةً بنشاطٍ","حفزتْ جعسَه إلى البُلْعوم",1,"م",1,0],["كُلَّما هَزَّت يَداهُ وَتَراً","هَزَّ مِن كُلِّ فُؤادٍ وَتَرَه",2,"ر",2,0],["كلُّ مَا هبَّ وما دبَّ وما","نامَ أَو حامَ على هذا الوُجُودْ",3,"د",1,1],["كلما همّ مجده بزوال","قام فحل فحال دون الزوال",4,"ل",1,0],["كُلَّما هَزَّكَ الصِبا هَزَّني الشَو","قُ إِلى ضَمِّ قَدِّكَ المَهزوزِ",5,"ز",1,0],["كلما هبَّت الغواني عليه","ضاق ذرعاً بالغادة المعطارِ",6,"ر",1,0],["كلّما هَمَّ بأمْرٍ جَلَلٍ","أتعبَ الأيّامَ فيه واستراح",7,"ح",1,0],["كلّما هَمَّتْ بها تَدفعُها","مِلءَ شِدْقَيْها أبتْ أن تُدفعا",8,"ع",2,0],["كلما هاجتِ الرياحُ صراخي","هدَّجت في هزيمها صرخاتي",9,"ت",2,0],["كُلَّما هبَّت الرِّياحُ لَه مِن","جانِب المغربين وَهناً بكاكُم",10,"م",1,0],["كلما هم أن يطاطيء للدهر","ثناهُ العريقُ من عنفوانِه",11,"ن",2,0],["كلما هلهل الأغاني عليها","قبلته وأنكرت كل شاد",12,"د",1,0],["كلما هدّتِ الليالي قُواه","بلغ الشعرُ قِمّة العُنفوان",13,"ن",1,0],["كُلَّمَا هَزَّهُ إِلَى الشِّعْرِ شَوْقٌ","جَذَبَ الْحُبُّ نَحْوَهَا وِجْدَانَه",14,"ن",2,0],["كُلَّما هَزَّتِ المُدَامُ يَدَيْهِمْ","قَهْقَهَتْ ثُلَّةٌ مِنَ الأكْوَاب",15,"ب",1,0],["كلّما هامت الظنونُ بماضي","كِ رأتْ عَزْمَةً وأبصرن مجدا",16,"د",2,0],["كلما هم أن يطأطئ للدهر","ثناه العريق من عنفوانه",17,"ن",2,0],["كلّما هلهلت صبا أو حجازا","ضاع حلم المتوّج المحسود",18,"د",1,0],["كلما هبَّت صباً من \"دُمَّرٍ\"","رنَّحَ الجنةَ طيبٌ وغناء",19,"ا",2,0],["كلّما هبّ للسؤال نسيمٌ","فوق أغصانه انتثرنَ برِفدِ",20,"د",1,0],["كُلَّما هَمَّ بِالرُقادِ تَصَدَّت","مُقلَتاهُ بِدَمعِهِ تُرجُمانه",21,"ه",1,0],["كلّما هبّ هبّ فينا نشاطٌ","وارتياحٌ لكلِّ عَزْفٍ وقَصْفِ",22,"ف",1,0],["كُلَّمَا هَبَّتِ النَّوَاسِمُ مِنْ تِلْ","قَائِهِمْ يَثْنِي كَغُصْنٍ مَرُوحِ",23,"ح",1,0],["كُلَّمَا هَمَّ بِنَظْمِ الْقَوَافِي","جَاءَهُ كُلُّ قَرِيبٍ بَعِيدِ",24,"د",1,0],["كُلّما هبّت الصَّبا ذَكَرَ الشّوْ","قَ ففاضَت عَيْناهُ شَوْقاً وَوَجْدا",25,"د",2,0],["كلّما هَبّت الشمال ذكا الوجدُ","وفاضت بدمعها العينان",26,"ن",1,0],["كلما هشّتْ إِليه زادَها","ديدنَ الطفل قطوباً وكلوحا",27,"ح",2,0],["كلما هب الجنوب له","سحراً يهتز كالثمل",28,"ل",1,0],["كلما هب على الروض الصبا","يلثم الأغصان",29,"ن",1,0],["كلما هبت له ريح الصبا","زال عنه وصبا ثم صبا",30,"ب",2,0],["كلَّما هبَّت صبا قلتُ لها","بلِّغيهم يا صبا نجد السَّلاما",31,"م",2,0],["كلما هزّها الصلاح لخير","نبذته بحجّة الإسلام",32,"م",1,0],["كلما هانوا وزادوا صغراً","زاد كافور خبالاً في خبال",33,"ل",1,0],["كلمّا هُزَّت الحفائظُ منهم","أطلعوها ملمومةً كلَّ طِلعِ",34,"ع",1,0],["كلما هاج لاعجُ الشَّوق ذكْرى","خُذلتْ نجدةٌ وأضْعِفَ جَلْد",35,"د",1,0],["كلَّما هزَّ الصّبا قامتهُ","فضحت دعصَ النقا والغصنا",36,"ن",2,0],["كلّما هبّ بالمُدامِ نَشاطاً","كسّلَ النومُ جَفنُه بالفُتورِ",37,"ر",1,0],["كُلَّما هَيَّجَ شَوقي حُرَقِي","صِحتُ يا لَيلى أَما فيكِ سَحَرْ",38,"ر",1,0],["كلما هدَّ من بنى مصر فرداً","هدَّ مما بنته مصر جدارا",39,"ر",2,0],["كلما هبت صبا او","كلما هبّت جنوب",40,"ب",1,0],["كلما هلّت شهرها","مر الشهر عن عام",41,"م",1,0],["كُلَما هَاجَرَ القطا","نتمنَّى وَنحزَنُ",42,"ن",1,0],["كلما هُنتُ له في ذا الهوى","زاد تيهاً وصُدوداً وغضب",43,"ب",1,0],["كلما هاج الجوى واشتعلت","لوعة هوجاء ما بين الضلوع",44,"ع",1,0],["كلما همّ فتى الشعر إلى","مطلب يعليه بين النجباء",45,"ا",2,0],["كلما هبَّت نسيماتُ الصبا","رعف الجفن على الخدّ وصبْ",46,"ب",1,0],["كلما هبّت نسيم رنّما","غضِّي طرفاً يا عيون النرجسِ",47,"س",1,0],["كلما هب من فروق نسيم","فهو من أهلها عليك سلام",48,"م",1,0],["كلما هب من فروق نسيم","الهب الشوق في الحشا الهابا",49,"ب",2,1],["كلّما هاجت الصّبابةُ منّي","عَبَراتِ خَبأتُها في المآقِ",50,"ق",1,0],["كلما هام فاستراح بروضٍ","داعب الروضَ فانثنى بالخمائل",51,"ل",1,0],["كلَّما هجنَني أصولُ عليها","باعتمادي على العلي وتِّكالي",52,"ل",2,0],["كلَّما هبَّ نسيمٌ","أسكبِ الدمع سجاما",53,"م",2,0],["كلما هب النَسيم","أرعد الجسم السَقيم",54,"م",1,1],["كُلَّما هَزَّ لِلزَمانِ قَناةً","حَطَّمَتها الأَيّامُ في أَحشائِه",55,"ا",3,0],["كلما هوم أو هم به","حسنٌ في الأحشاء ناراً ودعا",56,"ع",2,0],["كُلَّما هَبَّتِ الصَبا نَثَرَت فيهِ","شَبيهاً بِالوَردِ مِن ايهَقانِه",57,"ن",2,0],["كُلَّما هَبَّتِ الصَبا شَمَّ رَيّا ال","مِسكِ مِن نَحوِ أَرضِهِ فاستَدَلّا",58,"ل",2,0],["كلما هاج الهديل لها","طرباً هاجت له شجنا",59,"ن",2,0],["كلما هبت رياح الملتقى","خلت في أدراجها منه هبا",60,"ا",1,0],["كلّما هَجَّر الوغى غَشِيَ الطَّع","ن فيجري من القنا أنبوبُ",61,"ب",1,0],["كلما هّب من حماكم نشرا","قلت بالأمس كنت في الحب غرا",62,"ر",2,0],["كُلَّما هاجَت لَواعِجَهُ","وَهيَ في أَحضانِهِ جَذَبا",63,"ب",2,0],["كلما هَوّنت وقلت ردى بي","رِمعَ الخِصب أنشطت من عقال",64,"ل",1,0],["كلما هم أن يصول عليهم","همّت الأرض خيفة برجيف",65,"ف",1,0],["كلماهم اقعدته بوهنٍ","وإذا حلّ عاد بالازهاق",66,"ق",1,0],["كلما هبّ علينا شمأل","هب من تلقائها نشر العرارِ",67,"ر",1,0],["كلما همّ ان يقبل خديه","عذار شبت بخديه نار",68,"ر",1,0],["كلما هبت الرياح عليه","خلتُ فيه الشّباك تُنشَر نشرا",69,"ر",2,0],["كلّما هبّ عليه سحراً","نقلَت عنه أسانيد الزهَر",70,"ر",1,0],["كلما هبت الصبا كدت شوقاً","نحوكم يا أُهَيلَ نجدٍ أطيرُ",71,"ر",1,0],["كُلما هبت لَهُ ريح الصبا","زادَ شَوقاً للقاكم وَهياما",72,"م",2,0],["كلما هزك النسيم بلطف","هيجتهم عوامل الأشفاق",73,"ق",1,0],["كلما هلهل دمعا أورقت","دوحة تذكى إلى الموت الحنين",74,"ن",1,0],["كلما هيج شوقي حزني","صحت يا ليلي أما فيك سحر",75,"ر",1,0],["كلّما هَبّ نسيمٌ في الضّحى","أو شَدَت وَرقاءُ بين الوَرَقِ",76,"ق",1,0],["كلّما هاج الهَوى نحوَ اللقا","مهجتي أَشغلتُها بالأدمع",77,"ع",1,0],["كل ما همَّ ابن أنثى أو عَنَى","بنت أنثى ها هنا لم يعزبِ",78,"ب",1,0],["كُلَّما هاجَ ذِكرُ ذلكَ فِكري","يَتَلَظَّى قَلبِي وَيُوغَرُ صَدرِي",79,"ي",1,0],["كلّما هبّت شمالٌ منهم","لعبت بي عن يمينٍ وشمال",80,"ل",1,0],["كلما هبت شمال وصبا","هام قلبى للقاكم وصبا",81,"ب",2,1],["كُلَّما همت بِتَرك رَدها","لِلهَوى مِن ثابت العَهد اِنجِذاب",82,"ب",1,0],["كلما هبت العزائمُ للفتك","ثنتني زخارفُ الآمال",83,"ل",1,0],["كلّما هِمتُ في هَواهُ تجلّى","بِمحيّا أَنار قَلبي وَلُبَّي",84,"ب",2,0],["كلما هب نسيم في الضحى","زاد ما بي من حنين وأنين",85,"ن",1,1],["كلماهمَّ إلى السيف دعا","قلبه داعي التصابي فصبا",86,"ب",2,0],["كلما هرّ في جواري هرّ","كاد يفضي إلى فؤادي المروع",87,"ع",1,0],["كلما هبّت شمالا","............ أيقظت في الصدر أنّي",88,"ن",2,0],["كل ما هبت الشرقي بنفح العبير","اتلقى هواها ونتشي بالقصيد",89,"د",1,0],["كل ماهب الهوى الغربي عليها","نوشت نواش نقاض الجدايل",90,"ل",1,0],["كُلما هاجَ بالهواجسِ صدري","بشَّرَ اللهُ خافقي فاستراحا",91,"ح",2,1],["كل ما هبت نسائم من جداها","أحتري في جيته واشره عليه",92,"ي",2,0],["كُلَّما هَبَّتْ صَبا مِنْ قَلَمي","مالَهُ عَضَّ بَنانَ النَّدَمِ",93,"م",1,1],["كلَّمَا هَبَّتِ النَّسَائِمُ فِيْهَا","وتَرَاءَتْ لِنَاظِرَيَّ الطُّلُوْلُ",94,"ل",1,0],["كلَّمَا هبَّتِ الرِّياحُ ومالَتْ","أغصنُ البانِ أو شَدَا عَنْدَلِيْبُ",95,"ب",1,0],["كلّما هيئَتْ لحلميَ قبلةٌ","قال لي بوحُ المنى ما أروعَكْ",96,"ك",1,0],["كلما همي من اعماقي رحل","قسوة الدنيا تخليني انوح",97,"ح",1,0],["كلما هاجت بلابله","هام بين الحلْم والحلُم",98,"م",1,0],["كلما هبت الصبا هيجت بي","شجنا كامنا وداءا دخيلا",99,"ل",2,0],["كُلَّمَا هُمْتُ هُرُوبًا مِنْ نُسُورٍ","قَيَّدُونِي فِي ظَلامِي والمَصِيرْ",100,"ر",1,0],["كلّما هفهف الشعاع أعادت","وأطالت بنزعة للإفادة",101,"د",2,0],["كلما هادنت العذاب تمادى","مُزّقتْ من أوجاعه الأحشاءُ !!",102,"ا",2,0],["كلما هزَّ يراعي جذعَه","أرسلَ الريحَ وألقى الذهبا",103,"ب",2,0],["كلما هبت النسائم هبت","من سُبات أوصالها ومَنام",104,"م",1,0],["كُلَّما هدَّ قلعةً ورماها","وقفتْ تستخفُّ فيه قلاعُ",105,"ع",1,0],["كل ماهبت ذعاذيع النسيم","واستثار الفكر حلمٍ ودعه",106,"ع",2,1],["كلما هم دخلوا في قلبنا","ودخلنا قلبهم لن نُغلبا",107,"ب",2,0],["كلما هجرك تزايد ،، زادني البعد إكتئاب","ماخبرنا أحد ٍعلى فرقا حبيبه نال مكسب",108,"ب",1,0],["كلما هب بنا الشوق لها","آب بالأرواح منا يحتسي",109,"س",2,0],["كلما هزتِ الحُتوفُ رشيداً","نزَّ في ساقِه المُخِبَّة قرحُ",110,"ح",1,0],["كلُّ ما هدَّني، وَشوَّهَ روحي","كانَ في كبوتي دخيلاً عَليا",111,"ي",2,0],["كلما هزّني لملقاكِ شوقٌ","أخمدَ الدمعُ وهجَ شوقِ اللقاءِ",112,"ا",2,0],["كلَّما هزَّ رُوحَنا الوجدُ .. جِئنَا","مِنْ نوانَا نبنِيْ المدَى تَابُوتَا",113,"ت",2,0]]}