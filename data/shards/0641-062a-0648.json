17592.html","الكامل"]],"verses":[["فَتَوَزَّعَت تِلكَ القَذاةَ نَواظِرٌ","وَتَقَسَّمَت تِلكَ الشَجاةَ حُلوقُ",0,"ق",1,0],["فتُوطِئُها وإنْ حَفِيَتْ جِبالاً","وتُغْشيها وقد رَزَحَتْ رِمالا",1,"ل",2,0],["فَتَوَلَّى بَسْطَ مَا أَجْمَلْتَ","مِنْ غَيْرِ انْقِبَاضِ",2,"ض",1,0],["فَتَوَاصَلُوا حَتَّى كَأَنَّ قُلُوبَهُمْ","عَقَدَ التَّواصُلُ بَيْنَهَا أَرْحَامَا",3,"م",2,0],["فَتَوَسَّطوا في الحالَتَينِ وَأَنصِفوا","فَالشَرُّ في التَقييدِ وَالإِطلاقِ",4,"ق",1,0],["فَتَوَهَّمتُ أَن قَدِ اِنفَلَقَ البَد","رُ وَقَد كُنتُ أُنكِرُ الأَوهاما",5,"م",2,0],["فَتَوارَيتُ ثُمَّ عَلَّقتُ أَنفا","سِيَ ما اِسطَعتُ وَاِرتَدَيتُ الظَلاما",5,"م",2,0],["فَتوضِحَ فَالمِقراةِ لَم يَعفُ رَسمُه","لِما نَسَجَتها مِن جَنوبٍ وَشَمأَلِ",6,"ل",1,0],["فَتوسِعُ أَهلَها أَقِطاً وَسَمن","وَحَسبُكَ مِن غِنى شِبعٌ وَرِيُّ",7,"ي",1,0],["فُتورُ القِيامِ قَطيعُ الكَلامِ","تَفتُرُ عَن ذي غُروبٍ خَصِر",8,"ر",1,0],["فَتَوَخيْتُ مُشْبِهاً لأَلِيسٍ","بَيْنَهَا فِي صِفَاتِهَا وَالمَعَانِي",9,"ي",1,0],["فَتَوَلَّتْ تِلْكَ العُهُودُ وَظَلَّتْ","تَتَهَادَى أَصْدَاءهَا الأَعْوَامُ",10,"م",1,0],["فَتَوَلَّى فِي عُنْفُوان الْعُمْ","رِ حَلِيفَ الْعُلى أَلِيفَ الْعَظَائِمْ",11,"م",1,0],["فَتوشِكُ أَن تَشُطَّ بِنا قَذوفٌ","تُكِلُّ نِياطُها القُلُصَ الجِيادا",12,"د",2,0],["فَتُؤخَذَ مِن عِندِ البَعيثِ ضَريبَةٌ","وَيُترَكَ نَسّاجاً بِدارينَ مُسلَما",13,"م",2,0],["فَتَوَلَّوا فاتِراً مَشيُهُمُ","كَرَوايا الطِبعِ هَمَّت بِالوَحَل",14,"ل",1,0],["فَتَوَسَّطا عُرضَ السَرِيِّ وَصَدَّعا","مَسجورَةً مُتَجاوِراً قُلّامُها",15,"م",3,0],["فَتَوَلّى الغُلامُ يَقدَعُ مُهراً","تَئِقَ الغَربَ مانِعاً لِلسِياطِ",16,"ط",1,0],["فَتَوَقَّعوا سَبَلَ العَذابِ عَلَيكُمُ","مِمّا يُمِرُّ عَلى الرَوِيِّ لِساني",17,"ي",1,0],["فَتَوَلّى مُحَمَّدُ بنُ أَبي بَك","رٍ عَياناً وَخَلفَهُ عَمّارُ",18,"ر",1,0],["فتوَّةٌ وفتاوٍ لا نظيرَ لها","كأنه في الندى والحكم مخترع",19,"ع",1,0],["فتوح ملكٍ من الأسجاع خصَّ به","هذا وذاك وسجع الناس توقيف",20,"ف",1,0],["فتور على أجفانها وفتون","تريك معاني الحسن كيف تكون",21,"ن",1,1],["فتَوانَيْت والتواني وَطيءُ ال","ظَهرِ لكنَّه ذَميمُ الوِطاءِ",22,"ا",2,0],["فتَورَّدت وتعصْفَرَتْ وجناتُهُ","إذْ قُلْتُ ذاك فأسرعَتْ تَكْذِيبي",23,"ي",1,0],["فتوقفتُ ساعةً ثم نادَيْ","تُ سلامٌ مني على الأحبابِ",24,"ب",1,0],["فَتَوَخَّ الإِعذار وارغب عن التَّعْ","ذِير يا بن المعدود في المجد فردا",25,"د",2,0],["فَتَوقَّل النجواتِ من لمم الأذى","واحللْ لكل مَحلَّةٍ لم تُؤنس",26,"س",1,0],["فتوحشه جورةٌ جارها","فشاعت مع الخبر الشائع",27,"ع",1,0],["فتوَّق الإنعامَ إلّا مع الأن","عام أوْ لا فإنه استذمامُ",28,"م",1,0],["فتولَّى وهْو مهمو","مٌ أطالَ الله همَّهْ",29,"م",2,0],["فَتَوخَّ الإعذارَ واعلُ عن التعْ","ذير لا زلت للعُلى ولديها",30,"ي",3,0],["فَتوقَفُ أَحياناً فَيَفصِلُ بَينَنا","غِناءُ مُغَنٍّ أَو شِواءٌ مُرَعبَلُ",31,"ل",1,0],["فَتَوَسَّطَ اللَذاتِ غَيرَ مُنَفِّرٍ","وَتَوَسَّدَ الأَحلامَ غَيرَ مُنَكَّدِ",32,"د",1,0],["فَتَوَلّاهُمُ القُنوطُ مِنَ النَصرِ","فَرَدّوا أَسيافَهُم لِلغُمودِ",33,"د",1,0],["فتواثبوا يتصيدون رجالها","بقوى الرصاص كأنهم غزلان",34,"ن",1,0],["فتول الذي سننت ونجِّح","لرعاياك في المعارف قصدا",35,"د",2,0],["فَتَوَلَّ جَمعاً في اليَبابِ مُشَتَّتاً","وَاِرحَم رَميماً في التُرابِ مُبَعثَرا",36,"ر",2,0],["فُتوقُ المُلكِ تَحدُثُ ثُمَّ تَمضي","وَلا يَمضي لِمُختَلِفينَ فَتقُ",37,"ق",1,0],["فَتَوَقَّع أَن يَقولوا","مَن عَنِ العُمّالِ نابا",38,"ب",2,0],["فتؤثِرُ بَرْحَ الظِمْءِ والرِيُّ فاضح","وتألفُ بؤسَ الجَدْبِ والذُّلُ رائِدُ",39,"د",1,0],["فتوقرتْ من بعدِما قَلِقَتْ","عُقَدُ الحُبَى وتفاقمَ الشغْبُ",40,"ب",1,0],["فُتورُ الجُفونِ وَإِمراضُها","نُبُوُّ الجُنوبِ وَإِقضاضُها",41,"ض",3,1],["فَتَوَلَّت ذُمَّ قالَت شُغُلي","كُلُّ مَن شاءَ تَباكى فَبَكى",42,"ك",2,0],["فُتوحٌ عَلى السُلطانِ لَم تُبقِ مُبتَغىً","لِشَرٍّ وَلا مُستَنهِضاً لِضَلالِ",43,"ل",1,0],["فُتوحٌ يَدَّرِكنَ مِنَ النَواحي","كَما اِدَّرَكَ السَحابُ إِذا تَوالى",44,"ل",2,0],["فتواصلَت مِدَحي إليك كأنَّها","أفوافُ وَشْيِ اليُمْنَةِ المتواصِلِ",45,"ل",1,0],["فتوخَّيتَ بهِ حمدَ العُلى","والقَنا يَخطِرُ محمودَ الأَثَر",46,"ر",1,0],["فتوقُه الوحشُ صحيحاً إن رَقَد","حتى إذا عايَنَها السِّرْبُ صدَد",47,"د",1,0],["فتوحُك رَدَّتْ بَهجةَ المُلكِ سَرمَدَا","وأنتَ حُسامُ اللهِ فَلَّ بِكَ العِدا",48,"د",2,1],["فَتَوَقَّ دَهرَكَ ما اِستَطَعتَ وَلا","تَغرُركَ فِضَّتُهُ وَلا ذَهَبُه",49,"ب",2,0],["فُتورُ نَبضِكَ مِن عَينَيكَ مُستَرَقٌ","وَضَعفُ جِسمِكَ مِن جَفنَيكَ مُقتَرَضُ",50,"ض",1,0],["فَتَوَسَّمتُهُ فَكانَت مَعاني","هِ لِقاحاً لِكُّلِ فِكرٍ عَقيمِ",51,"م",1,0],["فُتورُ الظُبى عِندَ القِراعِ يُشيبُنا","وَما يُرهِفُ الأَجفانَ إِلّا فُتورُها",52,"ر",3,0],["فَتَوبَةُ المُقلِعِ إِثرَ ذَنبِهِ","وَتَوبَةُ الغادِرِ مَع عِقابِهِ",53,"ب",2,0],["فُتوحُ أَميرِ المُؤمِنينَ تَفَتَّحَت","لَهُنَّ أَزاهيرُ الرُبا وَالخَمائِلِ",54,"ل",1,0],["فَتَوَجَّسَتْ فَرَطُ الرِّكَابِ وَلَمْ تَكُنْ","لِتَهَابَ فَامْتَنَعَتْ عَلَى الأَرْسَانِ",55,"ن",1,0],["فَتَوَلَّت حُمولُها وَاِستَقَلَّت","لَم تُنِل طائِلاً وَلَم نَقضِ دَينا",56,"ن",2,0],["فَتَوَلَّت في ثَلاثٍ خُرَّدٍ","كَدُمى الرُهبانِ أَو عَينِ البَقَر",57,"ر",1,0],["فَتَوَلّى نَواعِمٌ","مُثقَلاتُ الحَقائِبِ",58,"ب",1,0],["فَتَوَعَّدتني نَظرَةٌ وَقّادَةٌ","يُذكى بِها تَحتَ الظَلامِ ذُبالُ",59,"ل",1,0],["فتولَّى إلى مكانِ يَزيدُ ال","كفرَ والكافِرينَ خَسْفاً وَرَغْما",60,"م",2,0],["فَتَوَلّى وَهوَ مُستَوهِلٌ","تَرتَمي أَزلامُهُ بِالرَغام",61,"م",1,0],["فَتَوافَقَ الطَّلَلانِ هذا دارسٌ","في بُرْدَتَيْ عَصْبٍ وهذا ماثل",62,"ل",1,0],["فتوحاتُ ما بينَ السماءِ وأرضِها","لها عند يومِ الفخرِ ألسنةٌ لُدُّ",63,"د",1,0],["فَتَواعَدا يَوماً وَشَأنُهُما","أَلّا يَشوبا الوَعدَ بِالكَذِبِ",64,"ب",1,0],["فَتَوَشَّت بِكُلِّ نَورٍ أَنيقٍ","مِن فُرادى نَباتُهُ وَتُؤامِ",65,"م",1,0],["فَتَوَلَّيتُ بِحُزنٍ داخِلٍ","في الحَشا يَنمى وَيبقى أَبَدا",66,"د",2,0],["فَتَوَقَّهُم مِن أَسوَدٍ أَو أَبيَضٍ","أَو أَسمَرٍ ما بَينَ ذَينِ مُجَنَّسِ",67,"س",1,0],["فتوحه للحق فضل الباري","والجزل من هباته الكبار",68,"ر",1,0],["فَتَوَلَّى عَنْهَا وَمَنْ أَرْضَعَتْهُ","ذَلِكَ الصَّابَ لَمْ يُضِرْهُ الفِطَامُ",69,"م",1,0],["فَتُوَافِيَانِ الْقَارِئِينَ عَلَى صَدًى","مِنْهُمْ بِمَا يُرْوَى مِنْ الأَقْوَالِ",70,"ل",1,0],["فتون الدَّلاَلِ وَرَدْعُ الجَلاَلِ","وَأَمْرُ الحَيَاةِ وَنَهْيُ الحَيَاءْ",71,"ا",2,0],["فَتَوَاضَعْ لله