oetsgate.com/ViewPoem.aspx?id=179161",""],[90,"الوحدة العربية الممزقة","https://www.poetsgate.com/ViewPoem.aspx?id=178953",""],[45,"يَوْمُ سَبتٍ، وَعندَنا ما كفى الحُرَّ","https://www.poetsgate.com/ViewPoem.aspx?id=31569",""],[91,"الحرب العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=53314",""],[91,"موت العبقري","https://www.poetsgate.com/ViewPoem.aspx?id=52962",""],[94,"أنني قدمت روحي في الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=15622",""],[99,"هرة","https://www.poetsgate.com/ViewPoem.aspx?id=555",""],[51,"كلُّ زرعٍ فإنهُ للحصاد","https://www.poetsgate.com/ViewPoem.aspx?id=27682",""],[101,"يا خَلِيلَيّ خَلِّيانِي وَما بِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62430&r=&rc=22",""],[31,"","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19021&r=&rc=284",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[18,"بَاتَ لَيْلِي بِالأَنْعَمَيْنِ طَوِيلاَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26456&r=&rc=22",""],[10,"لا تَخَلْ أنّني لقيتُ رواحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10487&r=&rc=12",""]],"verses":[["أَنفَقتُ دَمعَ العَينِ مِن بَعدِهِ","وَقَلَّ دَمعُ العَينِ أَن يُخزَنا",0,"ن",2,0],["أَنَفتَ بِنا عَلى قِمَمِ الأَعادي","وَكادَ الجَدُّ يُدرِكُ ما يَرومُ",1,"م",1,0],["أَنَفاً مِنَ الدُنيا بَتَتَّ حِبالَها","وَنَزَعتَ عَنكَ قَميصَها الأَسمالا",2,"ل",2,0],["إِنَّ فيهِم مَولِدَ المُل","كِ وَمِن قَبلٍ عُلوقَه",3,"ق",2,0],["أَنِفَت مِنَ المَوتِ الذَليلِ فَأَشعَرَت","جَلداً عَلى وَقعِ القَنا الخَطّارِ",4,"ر",1,0],["إِنَّ فَوزاً لَمّا أَتاها الجَواري","يَتَباكَينَني لِمَا قَد شَجاني",5,"ي",1,0],["إِنَّ فيما بَينَ البَقيعِ وَبُطحا","نَ لَداراً فيها الهَوى مَكتومُ",6,"م",1,0],["إِنَّ فَوزاً لَمّا أَتاها رَسولي","كَتَبَت أَنَّها تُريدُ رَحيلا",7,"ل",2,0],["إِنَّ في بَعضِ ما هُناكَ لَشَخصاً","كانَ يَشفي المَوعودَ بِالإِنجازِ",8,"ز",1,0],["إِنَّ فَوزاً وَاللَهُ يُصلِحُ فَوزاً","لِلدِيونِ الَّتي عَلَيها جَحودُ",9,"د",1,0],["إِنَّ في دونِ ما تَذَكَّرتُ مِن ذا","كَ لَعُذراً لِأَعيُنِ الباكِياتِ",10,"ت",1,0],["أَنَّ في المَأتَمِ الَّذي شَهِدَتهُ","لَسُروراً لِأَعيُنِ الناظِراتِ",10,"ت",1,0],["إِن فاتَهُ بَعضُ الأَماني فَاِذكُروا","أَنّا أَمامَ مُحَنَّكينَ صِلابِ",11,"ب",1,0],["إِنَّ في الغَربِ أَعيُناً راصِداتٍ","كَحَلَتها الأَطماعُ فيكُم بِسُهدِ",12,"د",1,0],["إِنَّ في أَضلاعِنا آفئِدَةً","تَعشَقُ المَجدَ وَتَأبى أَن تُضاما",13,"م",2,0],["إِنَّ في الأَزهَرِ قَوماً نالَهُم","مِن لَظى نيرانِها بَعضُ الشَرَر",14,"ر",1,0],["إِنَّ فينا لَولا التَخاذُلُ أَبطا","لاً إِذا ما هُمُ اِستَقَلّوا اليَراعا",15,"ع",2,0],["إِنَّ في عُلوِ مَسرَحاً لِلمَقادي","رِ وَفي الأَرضِ مَكمَناً لِلقَضاءِ",16,"ا",2,0],["إِنَّ فَوقَ العَراءِ قَوماً جِياعاً","يَتَوارَونَ ذِلَّةً وَاِنكِسارا",17,"ر",2,0],["إِن فاتَني أَن أُوَفّي","بِالأَمسِ حَقَّ التَهاني",18,"ي",1,0],["أَنِفتُ مِن تَحميلِهِ","عَلى عِيالِ المُحتَسب",19,"ب",1,0],["انفوا المُؤَذِّنَ مِن بِلادِكُم","إِن كانَ يُنفى كُلُّ مَن صَدَقا",20,"ق",2,0],["أُنُفٍ كَلَونِ دَمِ الغَزالِ مُعَتَّقٍ","مِن خَمرِ عانَةَ أَو كُرومِ شَبامِ",21,"م",1,0],["إِنَّ في الصَدرِ أَربَعاً يَتَجاوَب","نَ حَنيناً حَتّى كَسَرنَ الجَناحا",22,"ح",2,0],["إِنَّ فِي نَظْمِهِ لَحِسّاً لَطِيفاً","بَاقِياً مِنْهُ فِي السُّطُورِ خَفِيَّا",23,"ي",2,0],["إنَّ فَرَنْسَا وَهْيَ الَّتِي ضَرَبَتْ","فِي كُلِّ مَجْدٍ بِالسَّهْمِ فَالسَّهْمِ",24,"م",1,1],["إِنَّ فَارُوقَنَا لَسَيْفٌ وَدِرْعٌ","وَحِمًى لِلْحِمَى وَشَمْسٌ وَنِيلُ",25,"ل",1,0],["أَنفَ المُقامَ مع الفناء نزاهةً","فنوى الرحيلَ إلى مَقام باقِ",26,"ق",1,0],["إن في مصر للكريمة عُرساً","سوف تعنى بشرحه الأقلام",27,"م",1,0],["إن في هذه السياسة سهماً","جعل الله باطلاً قرطاسه",28,"س",2,0],["أَنِفنا أَن تَحُلَّ بِهِ صُداءٌ","وَنَهدٌ بَعدَما اِنسَلَخَ الحَرامُ",29,"م",1,0],["أَنفِق مِنَ الصَبرِ الجَميلِ فَإِنَّهُ","لَم يَخشَ فَقراً مُنفِقٌ مِن صَبرِهِ",30,"ر",2,0],["إِنَّ في الأَسرِ لَصَبّاً","دَمعُهُ في الخَدِّ صَبُّ",31,"ب",1,1],["أنفقت عيني في البكاء وحبَّذا","عينٌ على مرآى جمالك تنفَق",32,"ق",1,0],["إن فاخروا بقديمهم لم يدفعوا","أو سابقوا بجديدهم لم يلحقوا",32,"ق",3,0],["أنفقتُ ماضي العمر فيك صبابةً","وعليك أنفق ما بقي فدعيني",33,"ي",1,0],["إن في نائب الشآم اعتباراً","للبرايا ما بين عالٍ ودون",34,"ن",1,1],["إِنَّ في الوَعدِ وَعدكَ الحَقُّ حَقّاً","إِنَ في البَدءِ بَدءَ أَمرى شِديدُ",35,"د",1,0],["أَنَفِسْتَ أن أمررتُ عند خصَاصةٍ","سببَ الثراءِ وما وردتُ قليبَهُ",36,"ب",2,0],["إن في أنْ تَعُقُّني بعضَ إغضا","بي وفي أن تُهينَني إغضابي",37,"ب",2,0],["أنفاسُ نُوّار يَمُجُّ الندى","خلال روضٍ سَبِطٍ أَهْلبِ",38,"ب",1,0],["إنَّ فوقَ الإفضال أن تجعل الإف","ضالَ حقاً له عليك وُجوبُ",39,"ب",1,0],["إن فعلتم ففعلُكُمْ لصواب","أو نطقتم فنطقكم لسَداد",40,"د",1,0],["أنفُسٌ قد ظَمِئْنَ ليس إلى الما","ء ولكنْ إلى مُجاج الثغورِ",41,"ر",1,1],["إنفاقُ أيام الحياة على","رزقٍ أراصد قَبْضَهُ خُسْرُ",42,"ر",1,1],["إن فطراً حيّا الخليفة بالنر","جس والعرس حقُّ فطرٍ ظريفِ",43,"ف",1,1],["إنَّ في الحلم للسّفاهِ وفي عي","سى بن شيخٍ لكلّ عاتٍ لنِكلا",44,"ل",2,0],["أنِفْتُ لعشاقِ المكارمِ أن تُرى","مواعيدُهم مثلَ البوارق في المَحْلِ",45,"ل",1,0],["انفرُوا أيها الكرامُ خِفافاً","وثِقالاً إلى العبيدِ الطَّغام",46,"م",1,0],["أنفِقُ من مالهِ ومن عُمري","فيما ترى شَهوتي وإغرامي",47,"م",2,0],["أنِفْتُ من أنْ يقولَ الناسُ لي كَلِبٌ","وبصَّرْتني صروفُ الدَّهرِ بعد عَمَى",48,"م",2,0],["أنْفِق المالَ قبل إنفاقكَ العم","رَ ففي الدهر ريبُهُ ومَنونه",49,"ن",2,0],["أنفقتُ دمعي في مَواضعه","لا الوَكسُ يلحقُني ولا الغَبنُ",50,"ن",1,0],["أَنِفتُ لِبيضٍ يَجتَليهِنَّ ثابِتٌ","بِدَوغانَ يَهفو قَزُّها وَحَريرُها",51,"ه",2,1],["إِنَّ في صَدري يا بَحرُ لَأَسراراً عِجابا","نَزَلَ السِترُ عَلَيها وَأَنا كُنتُ الحِجابا",52,"ب",2,0],["إِنَّ في مِصر وَالشَآمِ دَوِيّاً","ما سَمِعناهُ قَبلَ يَومِ وَفاتِه",53,"ت",2,0],["أَنفَقَ العُمرَ عَلى خِدمَتِها","آهٍ ما أَغلى الَّذي قَد أَنفَقا",54,"ق",2,0],["أَنفَقتَ عُمرَكَ في الإِلَهِ مُجاهِداً","أَجرُ المُجاهِدِ في الإِلَهِ جَزيلُ",55,"ل",1,0],["إِنَّ فِراقَ الحَبيبِ عِندي","أَشَدُّ وَقعاً مِنَ الحِمامِ",56,"م",1,0],["أَنفَقتُ أَيّامَ الشَبابِ عَلَيكُمُ","في ذِمَّةِ الماضي الشَبابُ الفاني",57,"ن",2,0],["أَنفَقتُ أَيّامي عَلى جَمعِها","وَخِلتُني أَدرَكتُ أُمنِيَتي",58,"ي",1,0],["إنَّ في المرأةِ الجميلَةِ سِحْراً","عبقريًّا يُذكِي الأَسى ويُنيمُهْ",59,"م",2,0],["إنَّ في الغابِ أَزاهيراً","وأَعشاباً عِذابْ",60,"ب",1,0],["إنَّ في ثَغْرِنا رحيقاً سماوِيًّا","وفي قلبنا ربيعاً مُفَوَّفْ",61,"ف",1,0],["إنَّ في روضَةِ الحَيَاةِ لأَشْواكاً","بها مُزِّقَتْ زَنابِقُ نفسي",62,"ي",1,0],["أنُفوسٌ جميلةٌ كطيورِ الغابِ","تَشْدو بِساحِرِ التَغْريدِ",63,"د",1,0],["إِن فَعَلتُ الَّذي دَعَوتَ إِلَيهِ","كُنتَ فيما رغبتَ عينُ رَغِيبِ",64,"ب",1,0],["أَنفحةُ الرَوض رَقَّت في صَبا السَحرِ","مِن بَعدِ ما باتَ وَالأنداءُ في سَمَرِ",65,"ر",1,1],["إن في مصر اليوم من بعد سعد","كل فرد للدود عن مصر سعد",66,"د",1,0],["إن فعل الرجال غير الكلام","لا تعيش الشعوب بالأحلام",67,"م",1,1],["ان في جرحهم لقلبي عذاباً","دونه القتل بالسيوف الحداد",68,"د",1,0],["ان في الموت وهو منك قريب","لخلاصا من كل همّ وحزن",69,"ن",1,0],["ان في لحنه جمالا اليه","كل نفس حساسة ترتاح",70,"ح",1,0],["ان فراقي لك يا","شعر فراق من احب",71,"ب",1,0],["انفض عني صحبتي","وبقيت مثلى السيف فردا",72,"د",2,0],["إن فات أمرٌ وولَّى","فلا تفيد الندامه",73,"م",2,1],["أنفسي إن جزعت من المنايا","فإني منكِ يا نفسي براءُ",74,"ا",2,0],["إن فيها عيشاً يدوم رخيا","وسلاماً من الصروف العوادي",75,"د",2,0],["إن فيها لهواً وكأساً دهاقا","كل يوم سرورها في ازدياد",75,"د",1,0],["إن فيها تيناً ونخلاً وما","نا وأعناباً لذة للعباد",75,"د",1,0],["إن فيها أساوراً تتراءى","وهي من فضة على الأزناد",75,"د",1,0],["انفحونا ياعابرين بماء","إنما هذه النفوس صوادي",76,"د",2,0],["إن في أوسع الفضاء نجوماً","لاقتراب تحركت وابتعاد",77,"د",1,1],["إن فيها لشاعرا لك حرا","وأراه بالذَّود عنك حرِيا",78,"ي",2,0],["إن فيها لعبرةً لو عقلتم","ليس بعد الصعود إلا النزول",79,"ل",1,0],["إن فضلا خلّفت فينا ونبلا","لأمين عليهما جبريل",80,"ل",1,0],["أنفق ما كان ادّخر","ولم يدع ولم يذر",81,"ر",1,0],["إِنفَع بِما أُعطيتَ مِن قُدرَةٍ","وَاِشفَع لِذي الذَنبِ لَدى المَجمَعِ",82,"ع",1,1],["إِن فاتَهُ نَسَبُ الرَضِيِّ فَرُبَّما","جَرَيا لِغايَةِ سُؤدُدٍ وَطِرافِ",83,"ف",1,0],["اِنفُض غُبارَ المَوتِ عَنكَ وَناجِني","فَعَسايَ أَعلَمُ ما يَكونُ غُباري",84,"ر",2,0],[