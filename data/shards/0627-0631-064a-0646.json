118","الوافر"],[3975,"","https://poetry.dctabudhabi.ae/diwan/poem/75819","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86403","المتقارب"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4301,"","https://poetry.dctabudhabi.ae/diwan/poem/146712","المتقارب"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136485",""],[4625,"","https://poetry.dctabudhabi.ae/diwan/poem/124116","الطويل"],[4679,"دعاكِ ولكن ما أجبت دعاءَه","https://www.poetsgate.com/ViewPoem.aspx?id=142760",""],[4691,"محمد صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=146375",""],[4709,"حوار مع دجلة","https://www.poetsgate.com/ViewPoem.aspx?id=214840",""],[4836,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=205524",""],[1901,"عدتْك كرائمُ الديَمُ الغوادي","https://www.poetsgate.com/ViewPoem.aspx?id=160388",""],[4940,"على غصن الرضا","https://www.poetsgate.com/ViewPoem.aspx?id=212481",""],[5038,"حزن القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=189871",""],[5038,"كيف يغنيك القليل","https://www.poetsgate.com/ViewPoem.aspx?id=190125",""],[5277,"صبا قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=186418",""],[5358,"لا تجرحي قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=183416",""],[5409,"قل للمجانين في الدنيا لكم طوبى","https://www.poetsgate.com/ViewPoem.aspx?id=155254",""],[5431,"سيرة ذاتية","https://www.poetsgate.com/ViewPoem.aspx?id=183004",""],[5431,"ثورة 26 من سبتمبر..","https://www.poetsgate.com/ViewPoem.aspx?id=191551",""],[5431,"ولا وأبيك لا أهجو الذبابا","https://www.poetsgate.com/ViewPoem.aspx?id=197167",""],[5444,"قصيدة اشتعال اخير باول الياس","https://www.poetsgate.com/ViewPoem.aspx?id=122016",""],[5688,"هذا زادي إذا لم تعرفوه","https://www.poetsgate.com/ViewPoem.aspx?id=200679",""],[5701,"أرى نفسي تكاد أسى تذوب","https://www.poetsgate.com/ViewPoem.aspx?id=164603",""],[5701,"جنود لصوص في القناة تجمعوا","https://www.poetsgate.com/ViewPoem.aspx?id=164588",""],[5725,"امستودعي سهم المنية","https://www.poetsgate.com/ViewPoem.aspx?id=205052",""],[5909,"وإن أنتِ لم تستجيبِ لهذا !","https://www.poetsgate.com/ViewPoem.aspx?id=209204",""],[5939,"أنا جدّا عليكِ أغار","https://www.poetsgate.com/ViewPoem.aspx?id=178598",""],[5956,"كفاك عويلا","https://www.poetsgate.com/ViewPoem.aspx?id=182146",""],[5957,"ياحبيبي النيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82404&r=&rc=39",""]],"verses":[["أَرى نَفسي تَتوقُ إِلى النُجومِ","سَأَحمِلُها عَلى الخَطَرِ العَظيمِ",0,"م",1,1],["أَرى نِهاباً تُساقُ حافِلَةً","لا ناقَةٌ لي بِها وَلا جَمَلُ",1,"ل",1,0],["أَرَينَ في رَأسِيَ اللَيالي","شَرَّ ضِياءٍ لِشَرِّ نارِ",2,"ر",1,0],["أرى نَظَراتِ الصَّبِّ يَعْثُرْنَ دونَها","بأعْرافِ جُرْدٍ أو رؤوسِ عَوالِ",3,"ل",1,0],["أَرى نَبوَةً لَم أَدرِ سِرَّ اِعتِراضِها","وَقَد كانَ يَجلو عارِضَ الهَمِّ أَن يَدري",4,"ر",2,0],["أَرَينَ الَّذي اِستَودَعنَ سَوداءَ قَلبَهُ","هَوىً مِثلَ شَكِّ الأَيزَني النَواجِمِ",5,"م",1,0],["أَرى ناقَتي عِندَ المُحَصَّبِ شاقَها","رَواحُ اليَماني وَالهَديلُ المُرَجَّعُ",6,"ع",1,0],["أَرَينَهُ المَوتَ حَتّى لا حَياةَ بِهِ","قَد كُنَّ دِنَّكَ قَبلَ اليَومِ أَديانا",7,"ن",2,0],["أَريني جَواداً ماتَ هَزلاً لَعَلَّني","أَرى ما تَرَينَ أَو بَخيلاً مُخَلَّدا",8,"د",2,0],["أَرى نَفسي تُطالِبُني بِأَمرٍ","قَليلٌ دونَ غايَتِهِ اِقتِصاري",9,"ر",2,0],["أريْناه الطبيبَ فجسّ مِنه","فأقسم ما لجودٍ فيه نبضُ",10,"ض",1,0],["أريني منكِ في أمري نُهوضاً","يُبيّن أن شُغلكِ بي كشغلي",11,"ل",2,0],["أَرى نَكهَةَ المِسواك في حُمرَةِ اللَمى","وَشارِبَك المُخضَر بِالمِسكِ قَد خُطّا",12,"ط",2,0],["أَرَينَهُنَّ أَشنَعَ الأَمثالِ","كَأَنَّما خُلِقنَ لِلإِذلالِ",13,"ل",1,0],["أَرَينَ الحَرورِيِّينَ يَومَ لَقيتَهُم","بِبُرقانَ يَوماً يَقلِبُ الجَونَ أَشقَرا",14,"ر",2,0],["أرينَني مطَراً يَنهَلُّ ساكبُه","من الجفُونِ وبَرْقاً لاحَ من بَرَدِ",15,"د",1,0],["أرَينني أنّ عندي من شوافِعِها","إذا تباهى زكيٌ ما يزكّيني",16,"ن",2,0],["أرى نيكَ الشيوخ عليّ حقاً","ليعرفَ باطني مُردُ الأنام",17,"م",1,0],["أَرى نارَ الصِبا لَبِسَت خُموداً","وَأَذكى الشَيبُ في الرَأسِ اِشتِعالَه",18,"ل",2,0],["أرى ناقتي قد غمها الرجن واجتوت","أزقة أبواب تغلق دورها",19,"ر",3,1],["أَرى ناساً لهم دون البَرايا","وجوه حين تَلقاها صلاب",20,"ب",1,0],["أَرَى نَفْحَةً دَلَّتْ عَلَى كَبِدِي الْوَجْدَا","فَمَنْ كَانَ بِالْمِقْيَاسِ أَقْرَبَكُمُ عَهْدَا",21,"د",2,1],["أَرِينَا بِأُلْعُوبَةٍ فِي يَدَيْكِ","عَجَائِبَ لِعْبِ الهَوَى بِالرُّؤُوسِ",22,"س",1,1],["أريني أين هم فلديك خبر","جهينة خبرينا باليقين",23,"ن",1,0],["أريني أين أصحابي وأهلي","ومن عمروك أحقابا أريني",23,"ن",2,0],["أَريني وَجهَك الوَضّاح قالَت","أَلم تُؤمن فَقُلت بَلى وَلَكن",24,"ن",1,0],["أَرى نَصيبَكَ مِن عِزٍّ وَمِن شَرفٍ","نَصيبَ شانيكَ مِن هَمٍّ وَمِن نَصَبِ",25,"ب",1,0],["أرى ناراً وبي بردٌ شَديدٌ","ولكنْ لا سبيلَ إلى التّصلّي",26,"ي",1,0],["أرى نفوسا يشفّ الضغن أعينها","عن القلوب ببغض غير مكتتم",27,"م",1,0],["أرى نظراً كالطفيلي لا","يوجهُ حتى يعود حسيرا",28,"ر",2,0],["أرى نفوسَ الورى شتى وقيمتها","عندي تأثُّرها لا العزُّ والرتبُ",29,"ب",1,0],["أرى نساءَ بني قومي ويا أسفا","في لسنهنَّ سهامٌ لسنَ في الحدقِ",30,"ق",1,1],["أرى نَفَسي خلَّى الجحيم بلا لظى","وريقك خلّى الزمهرير بلا بردِ",31,"د",1,0],["أرى نهدَيكِ معزفةً وعرشاً","لأكبرِ من هشامٍ أو يزيد",32,"د",1,0],["أَرى نَيْلَ أَقْوامٍ وَآبي امْتِنانَهُمْ","وَلَيْسَ تَفِي لِي لَذَّةُ الشُّهْدِ بِالسُّمِّ",33,"م",1,0],["أَرى نَذلاً تُقدِّمُهُ المَساوي","عَلى حُرٍّ تُؤَخِّرُهُ المَحاسِن",34,"ن",1,0],["أَرى ناقَتي حَنَّت بِلَيلٍ وَشاقَها","غِناءٌ كَنَوحِ الأَعجَمِ المُتَوائِمِ",35,"م",1,0],["أَرى نَفسي أَبَت طَلَب التَمَنّي","وَقَد أَحسَنت بِالرزّاق ظَنّي",36,"ي",1,1],["أَرى نُذُراً لِلبَينِ صَرَّحَ وَعدُها","عَلَيَّ إِذا ما الدَهرُ أَخلَفَها نَذرُ",37,"ر",1,0],["أرَى نوبَ الأيَّام تَجني ولا أرَى","من النَّاسِ من يَعدُو عَليها إِذا تَجني",38,"ن",2,1],["أرى نائِباتٍ نابِياتٍ شفارُها","وما كفَّها إلا العُلى وأميرُها",39,"ر",3,0],["أَرَينَ مَحاسِناً وَكَنَنَّ أُخرى","مِنَ الأَجيادِ وَالبَشَرِ المَصونِ",40,"ن",1,0],["أرى نخل المشاعر باسقات","عليها من مهابتها وشاح",41,"ح",1,0],["أرى نَصْراً يلوحُ، وإنْ تَراءَى","لبعض الناسٍ من ضَرْبِ المُحالِ",42,"ل",1,0],["أرى نداك الكريمَ ذا بخَلٍ","فينا ووِرْدَ البحارِ كالثّمَدِ",43,"د",1,0],["أَرى نزوى بكم كشفت هناها","وراقت من محياها حياها",44,"ا",3,0],["أرى نفوساً ضَلَّةً","تَنشُدُ ما لا تَجِدُ",45,"د",1,0],["أرى نوح الحمام يشوق قوماً","وفي نوح الحمائم لي عزاء",46,"ا",2,1],["أريْنَ وجوهاً للجمال كأنّها","نُصولٌ جَلَتْها للقُيونِ المداوسُ",47,"س",1,0],["أرى نضرةً في كل شيءٍ وبنجةً","اذو الهمة العليا محمد قادم",48,"م",1,0],["أَرَى نَارَ وَجْدِي أَطْفَأَتْنِي وَلا تُطْفَى","وَسِرَّ غَرامي قَدْ خَفيْتُ وَلا يَخْفَى",49,"ف",2,1],["اريننا ملكات قد جلسن على","عرض بابهى حليّ الملك مزدان",50,"ن",1,0],["أَرى نار قلبي كل يومٍ وليلةٍ","تزيد لهيباً كلما زدتُ في الشكوى",51,"و",2,0],["أرى نفسي تجد بها الظنون","بأن البين بعد غدٍ يكون",52,"ن",1,1],["أرينَنا أعيُناً نُجلاً مدامِعُها","دافَعنَ كُلّ دَوى أمسى به رَمَقُ",53,"ق",1,0],["أرى نزولاً عوضاً عن ارتقا","لا البِشْر ذاك البشر بي ولا اللقا",54,"ق",2,0],["أَريني فَتىً يُغَنّي غنائي وَمَوقِفي","إِذا رَهَجَ الوادِي بِوَقعِ الحَوافِرِ",55,"ر",1,0],["أرى نفسي على لهو اقامت","فقل لي أنت للخيرات واصل",56,"ل",1,0],["أرى نصر ربي من أداء أمانتي","وهيهات عزت مكنتي ومكانتي",57,"ي",1,0],["أرَى نفسِي تتُوقُ إلى أمُورِ","يُقصِّرُ دونَ مَبلَغهُنَّ مالي",58,"ي",1,1],["أَرى نَفسي تَتوقُ إِلى أُمورٍ","وَيَقصُرُ دونَ مُبلَغِهِنَّ مالي",59,"ل",2,1],["أريني سلاحي لا أبالكِ إننّي","أرى الحربَ لا تزدادُ إلاّ تمادَيا",60,"ي",2,1],["أرى نوب الدنيا تروح وتغتدي","فمن فرحٍ ناءٍ وهمٍّ مخيّم",61,"م",1,0],["أرى نشأةَ الدنيا تشير إلى البلى","بما حملته من سرورٍ ومن أذى",62,"ذ",2,1],["أَريني جَواداً ماتَ هُزلاً لَعَلَّني","أَرى ما تَرينَ أَو بَخيلاً تَخَلَّدا",63,"د",2,0],["أرين النقع فوقهم سماء","عزاليها دم كالأرجوان",64,"ن",1,0],["أَرى نَفسَكَ يُرديها ال","لَذي عِندَكَ يُنجيها",65,"ي",3,0],["أرى نفسي في حرِّه يحرقُ الحشى","وزفرةَ صدري في الجوانح تصعد",66,"د",1,0],["أرى نار موسى فأنزلوا جانب الحمى","على رغم راج للظلام وداجر",67,"ر",1,0],["أريناهُ جميعَ الحالِ فقراً","وعَجزاً قِلَّةً دُنيا ودينا",68,"ن",2,0],["أرى نظرة العطف اللّموح فأنثني","أخادع نفسي في سبيل رضاك",69,"ك",1,0],["أريناهم عقارب من قريض","تفرّ لها العقارب هاربات",70,"ت",1,0],["أرى نهر المجرّة فيه يجري","وينبت زهره من كل جنس",71,"س",1,0],["أرى نفّة الأنف لو لم تكن","أميرا على الكيف من غير مين",72,"ن",1,1],["ارى ناظر الشرقيّ يرنو من الاسى","رنوّ امرئ ضاقت عليه مذاهبه",73,"ب",2,0],["أَرينيَ كَيفَ اِستَباح الحمام","شباه وَأَنتَ له حاميَه",74,"ي",2,0],["أَرينى كَيفَ دهته المنون","وَكانَ الأمان من الداهيَه",74,"ي",2,0],["أرَيْنا ظَنونَ الحيّ بَردَ قُلوبنا","وأحشاؤنا من حَرِّها تتلهَّبُ",75,"ب",1,0],["ارى نِسبَة ما بَينَ قَلبي وَخَصرِها","فان كَلا الاثنَينِ صارَ رَقيقاً",76,"ق",2,0],["أَرى ناقَتي قَد اِجتَوَت كُلَّ مَنهَلٍ","مِنَ الجَوفِ تَرعاهُ الركابُ وَمَصدَر",77,"ر",1,1],["أَرى نَفسي تَتوقُ إِلى أُمور","بِهِنَّ بُلوغُ غاياتِ المَعالي",78,"ل",2,1],["أَرَيْنا يومَ ذلِكَ مَنْ أتانا","بِذِي الظُّبَةِ الكواكِبَ بالنَّهارِ",79,"ر",1,0],["أرى نوره شق ثوب الدجى","فأعيا على إبر الخائط",80,"ط",1,0],["أَرى نُوَباً للدهرِ تُحْصى وما أَرى","أَشد من الهجران في نُوب الدهرِ",81,"ر",1,0],["أرى نعماً لك عندي قدمن","ولمتك إن كنت ممن يلام",82,"م",1,0],["أرى نوبَ الزمانِ على غضبا","تَشنُ مغارها وتروم حَربا",83,"ب",2,1],["أرى نفثة المصدور ما بين أضلعي","حواها لغام البت فانجرح الصدر",84,"ر",1,0],["أرى نار إبراهيم زاد لهيبها","نواكِ فاذكت قلبه وحشاهُ",85,"ا",2,0],["أرى نُوَبَ الدهرِ الطويلِ تعاضدتْ","عليّ ولم ألقَ المعينَ المؤيِّدا",86,"د",2,0],["أرى نورسَ النهرِ يشدو بحزنٍ","بذاك الغروبِ فأمسي عليلا",87,"ل",2,0],["أرى نفحاتِ الدُّعاءِ الذي","يُلطف فينا قضاءَ القَدَر",88,"ر",1,0],["أرى نفسي تتوقُ إلى المعالي","وكيف وسوقُها بادِي الكسادِ",89,"د",1,0],["أرى نفسي وكيف بك اطمأنت","على غصنِ الرضا العنقودُ شادي",90,"د",2,0],["أرى ناراً تشبُّ على هشيمٍ","سرتْ مثْنى ثلاثاً بلْ رُباعا",91,"ع",2,0],["أرى نُزْلَ الْقصورِ وكلَّ نُزْلٍ","بهِ في كلّ أغْنيةٍ عويلُ",92,"ل",1,0],["أرى نجمَ الليالي لا يراني","كأنّي في مجرّتهِ مقيمُ",93,"م",1,0],["أرى نجومَكِ عكسَ النجْم ِ جارِيَةً","وريحَكِ العَذْبَ مَلْفُوفاً بعاليهِ",94,"ي",2,0],["أرى نخاريب نحلٍ ما بها عسلٌ","لكن في كل نخروب يعاسيبا",95,"ب",2,0],["أرى نفسي بفعل الخير تسمو","حبيب الذات يوصف بالحقير",96,"ر",1,0],["أرى نصرهم فجرا عزيزا مدوياً","ومجدا لهم يُبنى مديدا وباقيا",97,"ي",2,0],["أرى نفسي تسامت أنْ تُعابا","وقد طالت مناقبها السحابا",98,"ب",2,1],["أرى نهايتَنا بَوحَ التُرابِ، وهلْ","في بوحِ كُلِّ اعوجاجٍ ينتشي ألقُ",99,"ق",1,0],["أَرَى نَفْسِي لَدَى بَعْضِ العِبَادِ","كَأَنِّي الخِنْذِيَانُ مِنَ الأَعَادِي",100,"د",2,1],["أرى نفسي تكاد أسى تذوب","لما تلقاه في الشرق الشعوب",101,"ب",1,1],["أرى نهبكم في مصر أصبح سافرا","وقد كان قبل اليوم نهبا مقنعا",102,"ع",2,0],["اريني صريعاً ضرّج العشق قلبه","يهيم بمن يهوى فجافاه عن عذلِ",103,"ل",1,0],["أريني إذا الليل أرخى سدولاً","من الرقصِ ما يستثيرُ الشجونْ",104,"ن",1,1],["أريني بَسمةَ الشفتينِ حتّى تَثمَلَ الأنهارْ","أرينِيها وخبّيها أنا جدًّا عليكِ أغارْ!",105,"ر",1,0],["أرينِيها وخبّيها أنا جدًّا عليكِ أغارْ!","صباحُ الخيرِ، أنتِ الخيرُ، أنتِ الصبحُ والأنوارْ",105,"ر",1,0],["أريني في خُطوطِ يَديكِ أينَ يَقودُنا المِشوارْ","أرينِيها وخبّيها أنا جدًّا عليكِ أغارْ!",105,"ر",1,0],["أريني اختلاج العيون الكبار","أريني المحاسن تكسو صباكِ",106,"ك",1,0],["أرى نورا تجلى في سمائي","فيغدو مهجتي مني كطائر",107,"ر",1,0]]}