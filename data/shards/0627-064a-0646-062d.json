{"poems":[[110,"حتام يا قلب","https://www.shoaraa.com/p11133",""],[53,"أين حظي من العدات المواضي","https://www.aldiwan.net/poem64978.html","الخفيف"],[68,"تركتنا لواحظ الأتراك بين","https://www.aldiwan.net/poem40647.html","الخفيف"],[71,"اسأل الفوعة الشديدة حزنا","https://www.aldiwan.net/poem28977.html","الخفيف"],[33,"سائلا الربع بالبلي وقولا","https://www.aldiwan.net/poem41839.html","الخفيف"],[107,"رددوا الذكرى لقوم غافلين","https://www.aldiwan.net/poem42065.html","الرمل"],[48,"ألم تر للدنيا وسوء صنيعها","https://www.aldiwan.net/poem22382.html","الطويل"],[108,"شبل بشبل","https://www.poetsgate.com/ViewPoem.aspx?id=179705",""],[108,"زامر الحي","https://www.poetsgate.com/ViewPoem.aspx?id=179525",""],[96,"بدعة الذل","https://www.poetsgate.com/ViewPoem.aspx?id=12816",""],[33,"","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19030&r=&rc=293",""],[203,"للحسان الدلال والخيلاء","https://www.aldiwan.net/poem45375.html","الخفيف"],[382,"يا إلهي النفوس قد غالهنه","https://www.aldiwan.net/poem59227.html","الخفيف"],[400,"هل لمن يرتجي البقاء خلود","https://www.aldiwan.net/poem3667.html","الخفيف"],[422,"طرقت أسماء في جنح الظلام","https://www.aldiwan.net/poem54040.html","الرمل"],[457,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[458,"أعرفت الحنين في الأرض للشمس","https://www.aldiwan.net/poem61572.html","الخفيف"],[484,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122549","الرمل"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137336",""],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96972","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48811","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63732","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56241","الرجز"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145164","الرمل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48989","الخفيف"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113930","الخفيف"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105426","الخفيف"],[2350,"","https://poetry.dctabudhabi.ae/diwan/poem/147620","الخفيف"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101811","الخفيف"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129832","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202512","الرمل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65128","الطويل"],[3419,"","https://poetry.dctabudhabi.ae/diwan/poem/130746","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138705",""],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85187","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77049","الخفيف"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105147","الخفيف"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81688","المقتضب"],[4691,"منعتني ذكر اسمها في قصيدي","https://www.poetsgate.com/ViewPoem.aspx?id=123537",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5213,"صنت سمعي عن عاذل فيك لاحي","https://www.poetsgate.com/ViewPoem.aspx?id=170433",""],[5302,"عهد الصبا","https://www.poetsgate.com/ViewPoem.aspx?id=201740",""],[5443,"واطُولَ صَبرِي!","https://www.poetsgate.com/ViewPoem.aspx?id=185149",""],[5776,"فهارس الفراغ","https://www.poetsgate.com/ViewPoem.aspx?id=199335",""],[5956,"السُّيول","https://www.poetsgate.com/ViewPoem.aspx?id=183189",""],[5956,"أبواشٌ وشارونيّون","https://www.poetsgate.com/ViewPoem.aspx?id=192363",""],[6046,"يا ذات الخمار","https://www.poetsgate.com/ViewPoem.aspx?id=35809",""],[6055,"إلى الحداثة....مع التحية","https://www.poetsgate.com/ViewPoem.aspx?id=30577",""],[5309,"في نظام مرصع الأصفاد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573552",""]],"verses":[["أينحر الشمر رأس السبط منتعلاً","وطالما لثمت من دونه القدم",0,"م",1,0],["أين حظي من العِداتِ المواضِي","والأماني فيك الطوال العِراضِ",1,"ض",1,1],["أَينَ حُسنُ الأَعرابِ مِن حُسنُ أُسدَ","أُفرِغَت في قاوالِبِ الأَملاكِ",2,"ك",1,0],["أينَ حلفُ الصلاةِ والصومِ زهداً","مَنْ على مثلِهِ الخناصرُ تُثنى",3,"ن",2,0],["أَينَ حَيٌّ حَلّوكَ إِذ أَنتَ مَحفو","فٌ بِهِم آهِلاً أَراكَ جَميلا",4,"ل",2,0],["أين حكمُ اللهِ في قُرآنِه","كيف ضاعَ اليومَ عِنْدَ الحاكِمينْ",5,"ن",1,0],["أَيَنَحَلُّ سَبتٌ يَعقِدُ الحَظَّ يَوُمهُ","فَيَنجَحَ ساعٍ أَم هُوَ الدَهرُ سابِتُ",6,"ت",1,0],["أين حظُّ الجوادِ من قصب السَّب","ق إِذا كان وحدَهُ في المَجَال؟",7,"ل",1,0],["أين حظُّ القريض بين أناس","زعموا أنهم حماة الضاد؟",8,"د",1,0],["أين حرّيتي فلم يبق حرّا","من جهير النّداء إلاّ الأذان",9,"ن",1,0],["أينَ حيٌّ حلوكَ، إذ انتَ مح","فٌ بِهمْ، آهِلٌ، أَرَاكَ جَميلا؟",10,"ل",2,0],["أينَ حقُّ البلادِ أينَ ذكاءُ القل","بِ أينَ النفوسُ أينَ الدماءُ",11,"ا",2,0],["أين حسنٌ يزينهن جمالاً","من عيوبٍ تُزيل إجلالهنه",12,"ن",2,0],["أين حواء أين آدم اذ فا","تهما الخلد والثوى والخلود",13,"د",1,0],["أينَ حيٌّ بالفضا نعهَدُه","صُدعُوا بعد التئام والتيام",14,"م",1,0],["أَين حلوا فمعشبٌ ومقيلٌ","أَو أَناخوا فوردةٌ وبهاره",15,"ر",2,0],["أين حظي منها ومنك أجي","بيني فإني أطوف لهفان أيضا",16,"ض",2,0],["اين حلم أحنف من","حلمه إذا حسبا",17,"ب",2,0],["أينَ حالُ النّاسِ مِن حالِكُم","لَيسَ صَرفُ الصِّفرِ مِثلََ الذَّهب",18,"ب",1,0],["أيُّ نحرٍ بين اللغات كنحري","قلدته يدُ القريضِ عُقودا",19,"د",2,0],["أين حبي إن لم أمت لك حزناً","أين حزني إن لم أمت لك حبا",20,"ب",2,0],["أين حامي الدستور وهو طعينٌ","بين أيدي العدى وأيدي الصحاب",21,"ب",1,0],["أين حِسّي وأين فكريَ ضَلَّ ال","حسُّ عنِّي وَضلَّتِ الأفكار",22,"ر",1,0],["أي نحو ذاك المقنص المعهودِ","والمصيد المسترغب المقصودِ",23,"د",1,0],["أين حامي الدين من شوب الضلال","ومجير الحقّ من إِفك الهوى",24,"ه",3,0],["أَين حظُّ الآداب في وطنٍ","حُّظه ظُلمةٌ فَوَاحَرَبا",25,"ب",2,0],["أينَ حَيٌّ غنوا بسَفحكِ دهراً","محسني حِرصِ رِفعَةِ الأحسابِ",26,"ب",1,0],["أي نحرٍ فرى وريديه شمر","أي رأس علاه فوق الصعاد",27,"د",1,0],["أين حوذانها من النرجس الغض","ض إذا ناجز النسيم استقلا",28,"ل",2,0],["أين حامي حماي عقد جماني","من تسنمت في ذراه الدلالا",29,"ل",2,0],["أين حمص أين أيّامي بها","بعدها لم ألقَ شيئاً يعجِبُ",30,"ب",1,0],["أينَ حسنً النيل من نهر بها","كل نغمات لدية تطربُ",30,"ب",1,0],["أين حلمي بالغواني منعشاً","كلما أغمضت ليلاً مقلتي",31,"ي",1,0],["أينحون ميل القلت عنهُ ونقلهُ","وما هُو يوما بالإمالة مُبدلُ",32,"ل",1,0],["أين حصول الجسم في المكان","متى حصول خصّ بالأزمان",33,"ن",1,0],["أين حماة الجار من هاشمٍ","إذ نزحت عن عقر أبياتها",34,"ت",3,0],["أين حفظ المولى لمولاه لا بل","أين نفع الآباء في الأبناء",35,"ا",2,0],["أين حسن الظنون فيكم وصدق ال","حب والود أين كثر التجائي",35,"ا",2,0],["أَينَ حَق الجِوار أَين اِتِّحادي","أَينَ حَق القُدوم بَعد اِغتِرابي",36,"ب",2,0],["أين حامي الحقيقة المتحامي","أين كبش الكتيهة المنصور",37,"ر",1,0],["أينَ حُسْنُ عهدهمُ","إذ ديارهمْ صُقُب",38,"ب",1,0],["أين حرف اسمها الذي يتدلى","في سطوري كأنه الأعناب ُ",39,"ب",1,0],["أَيْنَ حِسِّي أَيْنَ نَبْضِي","كَيْفَ غَابَ الْوَجْدُ فَرَّا",40,"ر",2,0],["أين حال الخلي من ذي صبابا","ت برت جسمه كبري القداح",41,"ح",1,0],["أين حلو المنام بالرغم من صو","ت ديوك ورغم صوت نباح",42,"ح",1,0],["أَيْنَ حَادِي الهَوَى؟! وَأَيْنَ الدَّلِيلُ؟","وَلِدُورِ الحِسَانِ أَيْنَ السَّبِيلُ؟",43,"ل",1,1],["أينحني الموجُ؟؟ لا للرّوعِ رَاوَغَنا","وأرسلَ الموتَ للشطئآنِ يقظانا",44,"ن",2,0],["أ ينحسرُ الطوفان العنيفُ","وتصبح أحلامنا بائدة؟",45,"د",2,0],["أ ينحني العُرْب للصهيون كالغنمِ","ويصبح الصقرُ مركوباً من الرَّخَمِ؟",46,"م",1,0],["أيْنَ حُكَّامي والكَرامَةُ تُسْبى؟!","أَيْنَ مَنْ يَدَّعُونَ رَعْيَ الشُّؤُونِ؟",47,"ن",1,0],["أين حطين؟ أن بدر تلاشت؟","وغزتنا منهم عقول دخيلة",48,"ل",2,0],["أَينَ حُرِّيَّةُ الفَقيرِ وَهَل في الفَقرِ","إِلاَّ قَضِيَّةُ استِعبادِ",49,"د",1,0]]}