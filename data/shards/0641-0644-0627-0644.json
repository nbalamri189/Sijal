ViewPoem.aspx?id=128830",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5348,"لا لوم علينا","https://www.poetsgate.com/ViewPoem.aspx?id=59574",""],[5409,"يا من جنت يده عليه شقاءه","https://www.poetsgate.com/ViewPoem.aspx?id=155259",""],[5411,"وَحُبُّكَ موسيقى","https://www.poetsgate.com/ViewPoem.aspx?id=186139",""],[5411,"آخر الملكات","https://www.poetsgate.com/ViewPoem.aspx?id=193470",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5582,"زُرْ مَنْزِلاً قاضَكَ البُرْحا وَأَوْلاكَا","https://www.poetsgate.com/ViewPoem.aspx?id=63548",""],[5609,"التمني","https://www.poetsgate.com/ViewPoem.aspx?id=215575",""],[5667,"الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=214940",""],[5688,"إذا شئت الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=200846",""],[5784,"كأني على ساحة الشعر ذيب....","https://www.poetsgate.com/ViewPoem.aspx?id=190729",""],[5830,"وَ كُنْتُ السَّمَاءْ","https://www.poetsgate.com/ViewPoem.aspx?id=200774",""],[5939,"غريبا أتيت","https://www.poetsgate.com/ViewPoem.aspx?id=204598",""],[5956,"أحن لسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=184919",""],[5974,"تماهي","https://www.poetsgate.com/ViewPoem.aspx?id=215557",""],[6075,"لَا تُخْفِ دَمْعَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=201606",""],[6096,"سؤال .. وعتاب","https://www.poetsgate.com/ViewPoem.aspx?id=177884",""],[6102,"قاف قهر","https://www.poetsgate.com/ViewPoem.aspx?id=184627",""],[6257,"بدويّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87175&r=&rc=0",""],[454,"الجمال اليعربي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82655&r=&rc=19",""]],"verses":[["فَلا لُبَّ لي إِلّا تَماسُكُ ساعَةٍ","وَلا نَومَ لي إِلّا النُعاسُ المُرَوَّعُ",0,"ع",1,0],["فَلا لَبِسوا غَيرَ هَذا الشِعارِ","وَلا رُزِقوا غَيرَ هَذا اللَقَب",1,"ب",1,0],["فَلا لَعاً لِفَتىً ناءَتْ مَطِيَّتُهُ","بِكَلْكَلٍ لِمُناخِ السَّوْءِ مُفْتَرِشِ",2,"ش",1,0],["فَلا لَومَ إِن ساءَ ظَنّي بِكُم","فَكُلُّ مُحبٍّ يُسيءُ الظُنونا",3,"ن",2,0],["فلا لدنيا ولا أخرى أفوز بها","خسرت فِي اللغو أقوالي وأعمالي",4,"ل",2,0],["فَلا لِعَجزٍ تَعَدّى تِلكَ نائِلُهُ","وَلا لِحِرصٍ سَقَت تِلكَ الشَآبيبُ",5,"ب",1,0],["فلا لذة الشكوى ولا فرحةُ الغنى","وألْمظتمُوني لمظةً ثَبَّطت صَبري",6,"ر",2,0],["فلا لونَ إلا حين يُسفرُ مسفِرٌ","ولا روعَ إلا حين يضحكُ مفرِخُ",7,"خ",1,0],["فَلَّ الخُطوبَ وَقَد خَطَبنَ لِقائَهُ","فَرَجَعنَ في إِخفاقِ ظَنٍّ خايِبِ",8,"ب",1,0],["فَلا لِاِمرِئٍ لي حينَ يُسنِدُ قَومَهُ","إِلَيَّ وَلا بِالأَكثَرينَ يَدانِ",9,"ن",1,0],["فَلا لُكانُ إِلى وادي الغِمارِ فَلا","شَرقِيُّ سَلمى فَلا فَيدٌ فَلا رِهَمُ",10,"م",1,0],["فَلَّ الجُيوشَ بِعَزمَةٍ مَلَكِيَّةٍ","تُغنيهِ عَن خَطِّيَّةٍ وَسُيوفِ",11,"ف",1,0],["فَلا لِلزُهرِ مَرآك","وَلا لِلزَهرِ رَيّاك",12,"ك",1,0],["فَلَألَأَت في حَوافي الكَأسِ مِن يَدِهِ","مِثلَ اليَواقيتِ مِن مَثنى وَوِحدانِ",13,"ن",1,0],["فَلا لاقى مَناعِمَهُ اِبنُ قَيسٍ","يُعَزّيني وَقَد غُلِبَ العَزاءُ",14,"ا",2,0],["فَلا لَعَمرُ الَّذي مَسَّحتُ كَعبَتَهُ","وَما هُريقَ عَلى الأَنصابِ مِن جَسَدِ",15,"د",1,0],["فَلا لاحَ لِي في ذُرْوَةِ الْمَجْدِ كَوْكَبٌ","وَلا طَارَ لِي فِي قُنَّةِ الْعِزِّ طَائِرُ",16,"ر",1,0],["فَلَّ النَّوَائِبَ فَانْصَاحَتْ دَيَاجِرُهَا","بِمُرْهَفٍ مِنْ سُيُوفِ الرَّأْيِ مَأْثُورِ",17,"ر",1,0],["فَلاَّلُ غَرْبِ الكَارِثَاتِ بِحَمْلِهِ","لِلحَادِثَاتِ وهُنَّ جِدُّ ثِقَالِ",18,"ل",1,0],["فلا لومٌ عليهِ وإنْ تلوَّثْ","سياط ٌ فوقَهم أو فارَ ماء..!",19,"ا",2,0],["فلا لامرِىءٍ بي حِينَ يُسنِدُ قَوْمَهُ","إليّ، ولا بالأكْثَرِينَ يَدَانِ",20,"ن",1,0],["فَلا لَعَمرِ الَّذي تَبيتُ لَهُ","لِباتُ بُدنٍ يَنضَحنَ بِالدَفَقِ",21,"ق",1,0],["فلا لَزَّ صدري صَدرها يوم رَوَّحتْ","ولا شَفَتي قَدْ قَبَّلَتْ شَفَتاها",22,"ا",3,0],["فَلَأُلبِسَنَّ الدَهرَ فيكَ مَدائِحاً","تَحلى الشُهورُ بِمِثلِها وَتُرَصَّعُ",23,"ع",1,0],["فَلأُلبِسَنَّ الدَهرَ فيكَ مَدائِحاً","تَحلى بِنَظمِ عُقودِها أَجيادُهُ",24,"د",2,0],["فَلا لذة الشَكوى قَضَينا وَلا الَّذي","سَتَرناهُ أَخفَته الدُموعُ السَوابقَ",25,"ق",1,0],["فلا لغةٌ للمسلمينَ سوى التي","بها نُزّلَ القرآنُ للأفضلية",26,"ه",1,0],["فَلِآلِ الشَّهرَزَورِيِّ مَحَلٌ","دونَهُ الجَوزاءُ في بُعدِ المَنالِ",27,"ل",1,0],["فلا لوى بان اللوى نسمةٌ","ولا أضا برقٌ بذات الأضا",28,"ض",2,0],["فَلا لَطَفَ إِلّا وَهوَ جِسمٌ لِلُطفِهِ","وَمَعنى مَعاني الكُلِّ في الكُلِّ مَعناهُ",29,"ا",2,0],["فَلا لَغواً وَلا تَأثيم فيها","وَلا ما يَسلب العقلا نهاها",30,"ا",3,0],["فَلَّ الصُّفوفَ وأثبتَتْها حَيرةٌ","حتّى شَككْنا أنّهُنَّ فُلول",31,"ل",1,0],["فلا لها يا ذا وفا بالعهود","لا والمشفع والنبي هود",32,"د",1,0],["فلا لوم لا عتب عليكم لأنني","مقر باوزاري وكثر إساءتي",33,"ي",1,0],["فلا ليلَ إلاَّ فيكَ أَصبحَ مُقمِراً","ولا صُبحَ إلاَّ في جبينك أسفرا",34,"ر",2,0],["فلآل عمران على كلِّ الورى","فضلٌ به نطقَ الكتابُ المُنْزَلُ",35,"ل",1,0],["فَلأُلْبِسَنَّ الدهر فيك مَلابِساً","للحَمْدِ أحكمَ مَنْطِقي دِيباجَها",36,"ج",3,0],["فلا لبست ثوباً من العار لا ولا","أَذاعَت إِذا ما استودعت باطن السد",37,"د",1,0],["فلا لوم علينا إن عشقن","ولكن الملوم هو الخلي",38,"ي",1,0],["فلا لُعنتْ أمُّ الوزارة إنها","لأنجب أنثى يوم عنك تقومُ",39,"م",1,0],["فلا ليل إلا وهو كهفٌ لِمُدْلجْ","ولا جدب إلا وهو خصبٌ لمُرْمل",40,"ل",1,0],["فلا لجُرْمٍِ نَفاذٌ في مُعاهدةٍ","يوماً ولا الودُّ بالإعْراض مهدومُ",41,"م",1,0],["فلألبسنَّ من التجلد نثرةً","حصداء تهزأ من سهام النابل",42,"ل",1,0],["فلا ليلي له صبحٌ منيرٌ","ولا وجدي يُقالُ له عِثارُ",43,"ر",1,0],["فلا لوم إن أبديت فيها تغاليا","لأحيي حياة العارفين بنشأتي",44,"ت",2,0],["فلا لقيتَ من الضَّرّاءِ لاقيةً","ولا سقاك البِلى طَرْقاً ولا رَنِقا",45,"ق",2,0],["فَلا لَهْوَ مُذْ لاحَ المَشيبُ بمَفْرَقي","وصار قناعاً في العيون لراسي",46,"س",2,0],["فلا لَوْمَ على قلْبِ","كَ أن هُيِّج فاهْتاجَا",47,"ج",2,0],["فلا لعمري لقد أجلت أباتٍ ضيا","شمس الأحبة عنا كل ظلماء",48,"ا",2,0],["فَلأُلبِسَنَّكَ مِن غَرائِبِ وَشيِهِ","بُرداً دَوامُ الدَّهرِ دُونَ دَوامِهِ",49,"م",2,0],["فَلا لِلمُسلمينَ وَفَيتَ صَراً","وَقَد صَبَروا وَلا لِلمُشرِكينا",50,"ن",2,0],["فلا لَوْمَ يُسلي عَنْهُمُ لا ولا عَذْلُ","وكيفَ بأنْ أُصغي لِلَوْمٍ عَليهمُ",51,"م",1,0],["فَلا لُبَّ يَنهاهُ وَلا لَوْمَ رادعٍ","وَلا نُصحَ قَد يُجدي فَلا نَفعَ لِلنّصحِ",52,"ح",1,0],["فَلا لُبَّ لي ناهٍ وَلا عَقلَ عاقِل","وَلا خِلّ نصّاح يَقول أَلا كُفّا",53,"ف",2,0],["فَلا لَيلَ إِلّا الذّوائبُ منها","وَلا شَمسَ إِلّا الجبينُ اِستَنارا",54,"ر",2,0],["فلألفينك عند حالي حسرةٍ","وتأسفٍ وتلهفٍ وزفير",55,"ر",1,0],["فل الصفاح برأيه","وغدا عن الجانبين بصفح",56,"ح",1,0],["فلا لبسنك من برود محامدي","أبهى وأفخر وشيها المرقومِ",57,"م",1,0],["فَلا له لابس يوماً سواك ولا","يرى كفؤاً والناس إلّاكا",58,"ك",2,0],["فَلا لَيْث إِلاَّ مَنْ سَطا هذِهِ السُّطا","ولا غَيْثَ إِلاَّ مَنْ جَرَى ذلِك الْمَجْرى",59,"ر",2,0],["فلا لبسنك من محبرة","يجري على أعطافها الحبر",60,"ر",1,0],["فلا لذّ لي من بعد موتكَ مطْعَمٌ","ولا طاب لي من بعد فقدك مَشْرَبُ",61,"ب",1,0],["فلا لفظ فتصقله المعاني","ولا نور فتعكسه المرائي",62,"ا",2,0],["فلالوم لي إن همت شوقا إلى اللقا","وإن غاب عقلي عند ذلك أو حضر",63,"ر",1,0],["فلا لي لالي لا عليّ ملامة","فحالة مرء فاقد اللب تغتفر",63,"ر",1,0],["فلا لوم في حث الكتائب نحوه","كرجل جراد في الضحى متواصل",64,"ل",1,0],["فَلأُلبِسَنَّهمُ ثَناءً خالِداً","يَبقى على عَقبِ الزَّمانِ مُنَمنَما",65,"م",2,0],["فَلا لَومَ لِي إِن طارَ قَلبِي صَبابَةً","لِأَنّي مِن شَحطِ الأَحِبَّةِ مَنحُوبُ",66,"ب",1,0],["فَلألبِسَنَّكُمُ بُرُودَ محاسِنٍ","أَبهى وَأَسنى مِن بُرُود رئام",67,"م",1,0],["فلآل صائغ حرقةٌ ولحزنهم","سيف صقيل بات قلبي غمده",68,"د",2,0],["فَلا لَكَ ما نُسِبت إِلى سِنانٍ","وَلا عُزيت خُؤولكَ في تَميمِ",69,"م",1,0],["فلا لكَ اليومَ نلقى في العُلى مثلاً","وخابَ من عنك يا كهفَ الرجا عدلا",70,"ل",2,0],["فَلَّ الزَمان لِهاشمٍ صمصاما","بَل جبّ مِنها غارباً وَسَناما",71,"م",2,1],["فَلا لَوم عَلى عَيني","إِذا سَحّت مَآقيها",72,"ي",3,0],["فلَّ الرَدى مِن آل جعفر صارِماً","أَمضى مِن السَيف الصَقيل غرارا",73,"ر",2,0],["فلا لاقى سروراً من مليكٍ","ولا زالت يداه في صفادِ",74,"د",1,0],["فلا لوم لمن طلب المعالي","بما يبذله من ورق وتبر",75,"ر",1,0],["فَلا لَيسَ نُكراً لِلفَريق وَإِنَّما","تَخوَّف عَتباً مِنهُمُ فَتَجَنَّبا",76,"ب",2,0],["فَلا لَومَ أَن أَولَيتُها كُلَّ تالِدٍ","وَوالَيتُها حُبّاً أَمُورُ لَهُ مَورا",77,"ر",2,0],["فلا لوم امَّا لامني اليوم لائم","إذا ما جرى دمعي وعيل تجلدي",78,"د",2,0],["فلا لوم إن لم تتّصل بقلوبنا","ولا لوم إن لم نولك الودّ والحمدا",79,"د",2,0],["فلا للوشاة عليه سبيل","ولا للعواذل فيه كلام",80,"م",1,0],["فل الردى منه حساما مرهفا","عضباً يفل الحادثات شباه",81,"ا",2,0],["فل الغرار فلا فم لخطابة","عند الخطوب ولا حسام ولا يد",82,"د",1,0],["فل الحمام حساماً في مضاربه","كانت جراثيم أهل الظلم تنحصد",83,"د",1,0],["فَلا لِسانانِ في لبنان قاطبةً","لكن لكلٍّ عيونٌ ليس عينانِ",84,"ن",1,0],["فلّ الردى من هاشمٍ صَمصاما","وهدّ من عليائِها دِعاما",85,"م",2,0],["فلا لقيتُ أَخِلاَّء بأرضك لي","ولا تَسَمَّى بغير اليُتمِ أولادي",86,"د",2,0],["فلا لوم فيما لا يطاق وانما","يلام الفتى فيما يطاق من الامر",87,"ر",1,0],["فلا لبُيِّتَتْ بالغَوثِ دعوةُ صَارخِ","دعاهُم الى آجالهم فَتَسرعوا",88,"ع",3,0],["فَلا لعمري ما اختال مزدَهيا","إِلا وَيَدري مَن الَّذي حملا",89,"ل",2,0],["فَلا لا يغرنْكَ صدرٌ صَفا","وَوَجهٌ إِذا ما تبينت بشْ",90,"ش",1,0],["فلا له لذة إلا بها كدر","ولا له حالة إلا بها غير",91,"ر",1,0],["فلا لب اللبيب أزاح عنه","منيته ولا رأي الطبيب",92,"ب",1,0],["فَلا لا وَمَهما اِضطَرَمتُم غُرورا","سَتَلقَونَ تَحتَ العَجاجِ التُبورا",93,"ر",2,0],["فلا لعجزٍ من كلينا بدا","ليطونةٌ تلك فتاها اعتدى",94,"د",2,0],["فلالا فما أنت من بشرٍ","ولست ابن فيلا الفوارس لا",95,"ل",2,0],["فَلأَلوين عنان شَوقي كارِهاً","إِن غَضَّ طَرفاً عَن رِعايَة جانِبي",96,"ب",2,0],["فلا لحا الله لاحينا ودام له","فضل بذكر الذى أهوى وتفضيل",97,"ل",1,0],["فلا لي صَديقٌ يستَحقُّ مَدائحِي","ولا لي عَدوٌّ يُرتَضي لِهجائي",98,"ي",1,0],["فلا لذة والدنيا تشابه لذتي","ركوب سوابق بها الصيد جازع",99,"ع",1,0],["فلا لقين به الزمان وأهله","في تيه قيصره وزهو قباذه",100,"ذ",2,0],["فلا لومٌ ولا عتبٌ علينا","بفعل الجاهِلين المُبْطِلِينا",101,"ن",2,0],["فلا ليلة إلا يروقك حسنها","ولا يوم إلا عاد يفضل عيدا",102,"د",2,0],["فلا لم اجد فرحا في الهوى","ولا لم أفارق شجا أو عويلا",103,"ل",2,0],["فلا ليلى ولا مَالٌ سيبقَى","ولا ضَحِكٌ ولَوْ يَعلُو صدَاهُ",104,"ا",2,0],["فلا لا تظنّي أورق َ الشك ُّ في الذي","بحبّك ِ لا يخشى العواقب َ والشَنْقا",105,"ق",2,0],