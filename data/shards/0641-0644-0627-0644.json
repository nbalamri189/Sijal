{"poems":[[53,"أقول وما حنت بذي الأثل ناقتي","https://www.aldiwan.net/poem30123.html","الطويل"],[53,"وفى ذا السرور بتلك الكرب","https://www.aldiwan.net/poem30751.html","المتقارب"],[63,"إذا رمى النقع عين الشمس بالعمش","https://www.aldiwan.net/poem45882.html","البسيط"],[55,"أأبدى سرائرك الظاعنونا","https://www.aldiwan.net/poem26091.html","المتقارب"],[77,"مولاي ياذا الجلال الباهر العالي","https://www.aldiwan.net/poem36349.html","البسيط"],[71,"يعدو الرياض الحيا والأرض مجدبة","https://www.aldiwan.net/poem3949.html","البسيط"],[51,"سألت فأعطيتم قليلا فلم يكن","https://www.aldiwan.net/poem64000.html","الطويل"],[62,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[45,"ما أنت للكلف المشوق بصاحب","https://www.aldiwan.net/poem10671.html","الكامل"],[28,"وأطلس عسال وما كان صاحبا","https://www.aldiwan.net/poem5628.html","الطويل"],[2,"قف بالديار التي لم يعفها القدم","https://www.aldiwan.net/poem25057.html","البسيط"],[66,"فتك اللواحظ والقدود الهيف","https://www.aldiwan.net/poem38482.html","الكامل"],[81,"شكا بالعتب مضناك","https://www.aldiwan.net/poem61407.html","الهزج"],[48,"عج للوقوف على راح وريحان","https://www.aldiwan.net/poem65297.html","البسيط"],[50,"تجهز طال في النصب الثواء","https://www.aldiwan.net/poem64892.html","الوافر"],[7,"يا دار مية بالعلياء فالسند","https://www.aldiwan.net/poem2003.html","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42643","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42603","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55156","الكامل"],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[28,"وأطلس عسال وما كان صاحبا","https://www.poetsgate.com/ViewPoem.aspx?id=21035",""],[201,"مهلا بني عمنا ظلامتنا","https://www.aldiwan.net/poem68156.html","المنسرح"],[210,"لقد هجرتني أم سعد وحبها","https://www.aldiwan.net/poem37826.html","الطويل"],[233,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[233,"لك ذروة البيت العتيق عماده","https://www.aldiwan.net/poem32098.html","الكامل"],[250,"أيرجع عصر بالجزيرة رائق","https://www.aldiwan.net/poem1476.html",""],[268,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[280,"عدم الإسلام معدوم المثال","https://www.aldiwan.net/poem32634.html","الرمل"],[301,"ارتاض قلبي فيكم وارتضى","https://www.aldiwan.net/poem58103.html","السريع"],[347,"وبدر دجى شعر متى برقت به","https://www.aldiwan.net/poem16000.html","الطويل"],[351,"أدم شرب الأتاي فإن فيها","https://www.aldiwan.net/poem39599.html","الكامل"],[362,"غير العدا بسيوفكن قتيل","https://www.aldiwan.net/poem60807.html","الكامل"],[388,"أشكو إلى الله الرحيم الودود","https://www.aldiwan.net/poem54592.html","عموديه"],[388,"ولما نأت داري وشطت مسافتي","https://www.aldiwan.net/poem54606.html","عموديه"],[413,"قدمت فحياك المهيمن بندرا","https://www.aldiwan.net/poem53902.html","الطويل"],[429,"هل في قطار النصر نسر واقع","https://www.aldiwan.net/poem12385.html","الكامل"],[436,"اليوم أبهجت المنى إبهاجها","https://www.aldiwan.net/poem34909.html","الكامل"],[438,"عزاء وتسليما وصبرا فما يجدي","https://www.aldiwan.net/poem14446.html","الطويل"],[447,"الجمال اليعربي","https://www.aldiwan.net/poem1001.html",""],[456,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[459,"أروم بفضلي نصرة وبمقولي","https://www.aldiwan.net/poem16041.html","الطويل"],[459,"له عن الشر إعراض ومجتنب","https://www.aldiwan.net/poem16164.html","البسيط"],[462,"كم بين اظعان الخليط الزائلِ","https://www.aldiwan.net/poem3603.html","عموديه"],[475,"يؤرقني حنين وادكار","https://www.aldiwan.net/poem15306.html","الوافر"],[480,"بكعبة أنوار أنخت مطيتي","https://www.aldiwan.net/poem24323.html","عموديه"],[549,"لو كنت أملك للأقدار واقية","https://www.aldiwan.net/poem47362.html","البسيط"],[549,"شبابك عني فالمشيب لباسي","https://www.aldiwan.net/poem47746.html","الطويل"],[565,"بدت في نسوة مثل المها","https://www.aldiwan.net/poem69764.html","الهزج"],[585,"ما عقد در على جيد بغيداء","https://www.aldiwan.net/poem11504.html","عموديه"]],"verses":[["فَلا لُبَّ لي إِلّا تَماسُكُ ساعَةٍ","وَلا نَومَ لي إِلّا النُعاسُ المُرَوَّعُ",0,"ع",1,0],["فَلا لَبِسوا غَيرَ هَذا الشِعارِ","وَلا رُزِقوا غَيرَ هَذا اللَقَب",1,"ب",1,0],["فَلا لَعاً لِفَتىً ناءَتْ مَطِيَّتُهُ","بِكَلْكَلٍ لِمُناخِ السَّوْءِ مُفْتَرِشِ",2,"ش",1,0],["فَلا لَومَ إِن ساءَ ظَنّي بِكُم","فَكُلُّ مُحبٍّ يُسيءُ الظُنونا",3,"ن",2,0],["فلا لدنيا ولا أخرى أفوز بها","خسرت فِي اللغو أقوالي وأعمالي",4,"ي",1,0],["فَلا لِعَجزٍ تَعَدّى تِلكَ نائِلُهُ","وَلا لِحِرصٍ سَقَت تِلكَ الشَآبيبُ",5,"ب",1,0],["فلا لذة الشكوى ولا فرحةُ الغنى","وألْمظتمُوني لمظةً ثَبَّطت صَبري",6,"ر",2,0],["فلا لونَ إلا حين يُسفرُ مسفِرٌ","ولا روعَ إلا حين يضحكُ مفرِخُ",7,"خ",1,0],["فَلَّ الخُطوبَ وَقَد خَطَبنَ لِقائَهُ","فَرَجَعنَ في إِخفاقِ ظَنٍّ خايِبِ",8,"ب",1,0],["فَلا لِاِمرِئٍ لي حينَ يُسنِدُ قَومَهُ","إِلَيَّ وَلا بِالأَكثَرينَ يَدانِ",9,"ن",1,0],["فَلا لُكانُ إِلى وادي الغِمارِ فَلا","شَرقِيُّ سَلمى فَلا فَيدٌ فَلا رِهَمُ",10,"م",1,0],["فَلَّ الجُيوشَ بِعَزمَةٍ مَلَكِيَّةٍ","تُغنيهِ عَن خَطِّيَّةٍ وَسُيوفِ",11,"ف",1,0],["فَلا لِلزُهرِ مَرآك","وَلا لِلزَهرِ رَيّاك",12,"ك",1,0],["فَلَألَأَت في حَوافي الكَأسِ مِن يَدِهِ","مِثلَ اليَواقيتِ مِن مَثنى وَوِحدانِ",13,"ن",1,0],["فَلا لاقى مَناعِمَهُ اِبنُ قَيسٍ","يُعَزّيني وَقَد غُلِبَ العَزاءُ",14,"ا",2,0],["فَلا لَعَمرُ الَّذي مَسَّحتُ كَعبَتَهُ","وَما هُريقَ عَلى الأَنصابِ مِن جَسَدِ",15,"د",1,0],["فَلا لاحَ لِي في ذُرْوَةِ الْمَجْدِ كَوْكَبٌ","وَلا طَارَ لِي فِي قُنَّةِ الْعِزِّ طَائِرُ",16,"ر",1,0],["فَلَّ النَّوَائِبَ فَانْصَاحَتْ دَيَاجِرُهَا","بِمُرْهَفٍ مِنْ سُيُوفِ الرَّأْيِ مَأْثُورِ",17,"ر",1,0],["فَلاَّلُ غَرْبِ الكَارِثَاتِ بِحَمْلِهِ","لِلحَادِثَاتِ وهُنَّ جِدُّ ثِقَالِ",18,"ل",1,0],["فلا لومٌ عليهِ وإنْ تلوَّثْ","سياط ٌ فوقَهم أو فارَ ماء..!",19,"ا",2,0],["فلا لامرِىءٍ بي حِينَ يُسنِدُ قَوْمَهُ","إليّ، ولا بالأكْثَرِينَ يَدَانِ",20,"ن",1,0],["فَلا لَعَمرِ الَّذي تَبيتُ لَهُ","لِباتُ بُدنٍ يَنضَحنَ بِالدَفَقِ",21,"ق",1,0],["فلا لَزَّ صدري صَدرها يوم رَوَّحتْ","ولا شَفَتي قَدْ قَبَّلَتْ شَفَتاها",22,"ا",3,0],["فَلَأُلبِسَنَّ الدَهرَ فيكَ مَدائِحاً","تَحلى الشُهورُ بِمِثلِها وَتُرَصَّعُ",23,"ع",1,0],["فَلأُلبِسَنَّ الدَهرَ فيكَ مَدائِحاً","تَحلى بِنَظمِ عُقودِها أَجيادُهُ",24,"د",2,0],["فَلا لذة الشَكوى قَضَينا وَلا الَّذي","سَتَرناهُ أَخفَته الدُموعُ السَوابقَ",25,"ق",1,0],["فلا لغةٌ للمسلمينَ سوى التي","بها نُزّلَ القرآنُ للأفضلية",26,"ه",1,0],["فَلِآلِ الشَّهرَزَورِيِّ مَحَلٌ","دونَهُ الجَوزاءُ في بُعدِ المَنالِ",27,"ل",1,0],["فلا لوى بان اللوى نسمةٌ","ولا أضا برقٌ بذات الأضا",28,"ض",2,0],["فَلا لَطَفَ إِلّا وَهوَ جِسمٌ لِلُطفِهِ","وَمَعنى مَعاني الكُلِّ في الكُلِّ مَعناهُ",29,"ا",2,0],["فَلا لَغواً وَلا تَأثيم فيها","وَلا ما يَسلب العقلا نهاها",30,"ا",3,0],["فَلَّ الصُّفوفَ وأثبتَتْها حَيرةٌ","حتّى شَككْنا أنّهُنَّ فُلول",31,"ل",1,0],["فلا لها يا ذا وفا بالعهود","لا والمشفع والنبي هود",32,"د",1,0],["فلا لوم لا عتب عليكم لأنني","مقر باوزاري وكثر إساءتي",33,"ي",1,0],["فلا ليلَ إلاَّ فيكَ أَصبحَ مُقمِراً","ولا صُبحَ إلاَّ في جبينك أسفرا",34,"ر",2,0],["فلآل عمران على كلِّ الورى","فضلٌ به نطقَ الكتابُ المُنْزَلُ",35,"ل",1,0],["فَلأُلْبِسَنَّ الدهر فيك مَلابِساً","للحَمْدِ أحكمَ مَنْطِقي دِيباجَها",36,"ج",3,0],["فلا لبست ثوباً من العار لا ولا","أَذاعَت إِذا ما استودعت باطن السد",37,"د",1,0],["فلا لوم علينا إن عشقن","ولكن الملوم هو الخلي",38,"ي",1,0],["فلا لُعنتْ أمُّ الوزارة إنها","لأنجب أنثى يوم عنك تقومُ",39,"م",1,0],["فلا ليل إلا وهو كهفٌ لِمُدْلجْ","ولا جدب إلا وهو خصبٌ لمُرْمل",40,"ل",1,0],["فلا لجُرْمٍِ نَفاذٌ في مُعاهدةٍ","يوماً ولا الودُّ بالإعْراض مهدومُ",41,"م",1,0],["فلألبسنَّ من التجلد نثرةً","حصداء تهزأ من سهام النابل",42,"ل",1,0],["فلا ليلي له صبحٌ منيرٌ","ولا وجدي يُقالُ له عِثارُ",43,"ر",1,0],["فلا لوم إن أبديت فيها تغاليا","لأحيي حياة العارفين بنشأتي",44,"ت",2,0],["فلا لقيتَ من الضَّرّاءِ لاقيةً","ولا سقاك البِلى طَرْقاً ولا رَنِقا",45,"ق",2,0],["فَلا لَهْوَ مُذْ لاحَ المَشيبُ بمَفْرَقي","وصار قناعاً في العيون لراسي",46,"ي",1,0],["فلا لَوْمَ على قلْبِ","كَ أن هُيِّج فاهْتاجَا",47,"ج",2,0],["فلا لعمري لقد أجلت أباتٍ ضيا","شمس الأحبة عنا كل ظلماء",48,"ا",2,0]]}