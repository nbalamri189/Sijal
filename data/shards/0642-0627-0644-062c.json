{"poems":[[79,"قال جوادي عندما","https://www.aldiwan.net/poem36398.html","مجزوء الرجز"],[90,"دع مزعج اللوم وخل العتاب","https://www.aldiwan.net/poem44807.html","السريع"],[108,"مضيفة الطائرة","https://www.poetsgate.com/ViewPoem.aspx?id=179675",""],[132,"أنت يا مقلتي أسقمت حالي","https://www.aldiwan.net/poem50549.html","الخفيف"],[193,"فضل الله سيد الخلق قدما","https://www.aldiwan.net/poem35277.html","الخفيف"],[310,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[371,"افترى في عذله كذبا","https://www.aldiwan.net/poem16928.html","المديد"],[520,"يا ظبية الرمل التي","https://www.aldiwan.net/poem12102.html","مجزوء الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66743","الرمل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216636",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[4391,"","https://poetry.dctabudhabi.ae/diwan/poem/114045","الرمل"],[5431,"ليته كان شفّر !!","https://www.poetsgate.com/ViewPoem.aspx?id=203703",""]],"verses":[["قَالَ جَوَادِي عِنْدَمَا","هَمَزْتُ هَمْزَاً أَعْجَزَهْ",0,"ه",1,1],["قال جليسي يوم مرّت بنا","من هذه الغادة ذات الحجاب",1,"ب",1,0],["قال جاري: أتلك في الجوِّ تقضي","عمرها بين جَيئةٍ وذهاب؟",2,"ب",1,0],["قالَ جسْمي إنْ كانَ يقبلُ قَولِي","قُلْتُ بالحقِّ بينكُم لاَ أُبالِي",3,"ل",2,0],["قالَ جبريلُ مَع محمّدٍ المخ","تارِ تَأبى أَما لديك حياءُ",4,"ا",2,0],["قالَ جلّت مراتب قَد حَواها","قلتُ وهو الأجلُّ في الميزانِ",5,"ن",1,0],["قالَ جِدّاً ما أَتَيتُ بِهِ","قُلتُ بَل لَهواً وَبَل لَعِبا",6,"ب",2,0],["قال جلال الرؤسا","فاستمعوا وأبصروا",7,"ر",3,0],["قال جزءٌ لي وجزءٌ لابنتي","ولك الثالثُ فاقبِضْها جُمَعْ",8,"ع",1,0],["قالَ جَمَعت الجَهل وَالجُبن مَعاً","عيبان ما ظَننت أَن يَجتَمِعا",9,"ع",2,0],["قالَ جَهلت الحَق إِن المَصلحه","بادية أَسرارها مُستملحه",9,"ه",1,0],["قَالْ: جيتك بشَوْقِيْ يَا حبيبي أسير","لاجْل أناظر عْيُوْنك وآتسامر معاك",10,"ك",1,1],["قَالَ جِبرِيلُ يَا بُرَاقُ تأدَّب","فَاعتَرَاهُ مِن فِعلِهِ استِحيَاءُ",11,"ا",2,0],["قال جزت الباب مصحوبا إلى","قاعة قد طوقتها الحجر",12,"ر",1,0],["قال جهرا عُريّكم أو عروش","فأديروا وليته كان شفّرْ!",13,"ر",1,0]]}