{"poems":[[77,"قال جوادي عندما","https://www.aldiwan.net/poem36398.html","مجزوء الرجز"],[88,"دع مزعج اللوم وخل العتاب","https://www.aldiwan.net/poem44807.html","السريع"],[106,"مضيفة الطائرة","https://www.poetsgate.com/ViewPoem.aspx?id=179675",""],[129,"أنت يا مقلتي أسقمت حالي","https://www.aldiwan.net/poem50549.html","الخفيف"],[190,"فضل الله سيد الخلق قدما","https://www.aldiwan.net/poem35277.html","الخفيف"],[306,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[367,"افترى في عذله كذبا","https://www.aldiwan.net/poem16928.html","المديد"],[516,"يا ظبية الرمل التي","https://www.aldiwan.net/poem12102.html","مجزوء الرجز"]],"verses":[["قَالَ جَوَادِي عِنْدَمَا","هَمَزْتُ هَمْزَاً أَعْجَزَهْ",0,"ه",1,1],["قال جليسي يوم مرّت بنا","من هذه الغادة ذات الحجاب",1,"ب",1,0],["قال جاري: أتلك في الجوِّ تقضي","عمرها بين جَيئةٍ وذهاب؟",2,"ب",1,0],["قالَ جسْمي إنْ كانَ يقبلُ قَولِي","قُلْتُ بالحقِّ بينكُم لاَ أُبالِي",3,"ل",2,0],["قالَ جبريلُ مَع محمّدٍ المخ","تارِ تَأبى أَما لديك حياءُ",4,"ا",2,0],["قالَ جلّت مراتب قَد حَواها","قلتُ وهو الأجلُّ في الميزانِ",5,"ن",1,0],["قالَ جِدّاً ما أَتَيتُ بِهِ","قُلتُ بَل لَهواً وَبَل لَعِبا",6,"ب",2,0],["قال جلال الرؤسا","فاستمعوا وأبصروا",7,"ر",3,0]]}