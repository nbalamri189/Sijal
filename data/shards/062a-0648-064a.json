{"poems":[[95,"شجانا نوح شاديها","https://www.aldiwan.net/poem11106.html","مجزوء الوافر"],[47,"نهيتكم عن صالح فأبى بكم","https://www.aldiwan.net/poem62707.html","الطويل"],[48,"خوى دن شرب فاستحابوا إلى التقى","https://www.aldiwan.net/poem22453.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54641","البسيط"],[310,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59430","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67987","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90766","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72526","الوافر"],[4849,"يعني إذا سافرت لازم تخونين","https://www.poetsgate.com/ViewPoem.aspx?id=53506",""],[4927,"فدوى","https://www.poetsgate.com/ViewPoem.aspx?id=30183",""],[5084,"يالح قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=177782",""],[5135,"\"تويترُ\"","https://www.poetsgate.com/ViewPoem.aspx?id=201950",""],[5206,"الجاهل والعارف","https://www.poetsgate.com/ViewPoem.aspx?id=187359",""],[5206,"غابة الغرايب","https://www.poetsgate.com/ViewPoem.aspx?id=187358",""],[5242,"رجاء الإله لنا شامل","https://www.poetsgate.com/ViewPoem.aspx?id=125970",""],[5582,"أعذّالي أعذّالي","https://www.poetsgate.com/ViewPoem.aspx?id=63558",""],[5732,"هيهات اطيعك","https://www.poetsgate.com/ViewPoem.aspx?id=177897",""],[5848,"ضحكه وتنهيده","https://www.poetsgate.com/ViewPoem.aspx?id=51951",""],[5862,"البُ ع د يرضي .. جَنابِكْ ... !!!","https://www.poetsgate.com/ViewPoem.aspx?id=31906",""],[6056,"قديمة نديمة","https://www.poetsgate.com/ViewPoem.aspx?id=130512",""]],"verses":[["تَوَى أَبْطَالُهَا وَأَبَى","حَيَاةً الذُّل بَاقِيهَا",0,"ي",3,0],["تُؤَيِّدُ رُكنَيهِ المَوالي وَيَعتَزي","إِلى مَذهَبٍ عِندَ الخَليفَةِ واضِحِ",1,"ح",1,0],["تَوي دَيِّنٌ في ظَنِّهِ ما حَرائِرٌ","نَظائِرَ آمٍ وُكِّلَت بِتَوادي",2,"د",2,0],["تُؤَيِّدِينَ الَّذِينَ اسْتَبْسَلُوا فَحَمَوْا","أَوْطَانَهَا بِرِمَاحِ الخَطِّ وَالقُضُبِ",3,"ب",1,0],["تَؤيّدهنَّ أملاكٌ صعود","وَتُجريهنّ أفلاكٌ سعودُ",4,"د",1,0],["تؤيده في الحرب نفسه أبية","وقلب على كل الحروب عصيب",5,"ب",1,0],["تؤيده الأقدارُ أَنّى توجهتْ","كتائبُه والنصرُ بالسيفِ يُقْسَم",6,"م",1,0],["تويتات أتتنا في صحائف","عليها القطر فوق الصحن طائف",7,"ف",1,1],["توئي از نفس خودداري هزاران ناصح وواعظ","حضوري كرهمي خواهي ازوغائب مشو حافظ",8,"ظ",1,0],["توّي عرفت إن الوفاء للمساكين","وإن المحبّ يخون عشرين مرّة ؟!",9,"ر",2,0],["تُؤَيِّدُهَا الْمَحَاْوِرُ، وَالزَّوَاْيَاْ","وَأَرْكَاْنُ الْمَبَاْنِيْº وَالْقِبَاْبُ",10,"ب",1,0],["توي دريت إنه لفراقي يفرح","إثره يبي غيري وأنا أتعبت روحي",11,"ح",2,0],["\"تويترُ\" قالها القائلْ","أجابَ بصدقٍ السائلْ",12,"ل",1,1],["تَوِيٌّ عَلَى الفَاقَاتِ لِلحَقِّ مُخْبِتٌ ثَبُوتٌ","عَلَى الطَّاعَاتِ لَا فِي التُّهَى تَهِي",13,"ي",1,0],["تَوَى فِي تُوَى تَائِ المَتَابِ لِرَبِّهِ","تَلَا فِي التَّلَافِي وَالمَتَارِكَ تَارِكُ",14,"ك",1,0],["تؤيده من مثله سادة","كرام لهم شرف كامل",15,"ل",1,0],["تُؤَيِّسُنِي بِهِجْرَتِها","وَتُطْمِعُنِي بِإِدْلالِ",16,"ل",1,0],["توي ضحكت وفاز قلبي بفرحات","من يوم اخو صنعا خذاها غصيبه",17,"ب",2,1],["توي يابو قلبي بجرحي تساويت","وقدحت صوّان الفكر للكتابة",18,"ب",2,1],["توي عرفت اني ب هالحب موهوم","وياليت تعفيني من اوجه خرابك",19,"ك",1,0],["توّي دريت إن الغدر فيك شيمة","وطبع الخيانة نابع ٍ فيك من ساس",20,"س",1,1]]}