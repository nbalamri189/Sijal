{"poems":[[53,"ضربن إلينا خدودا وساما","https://www.aldiwan.net/poem29807.html","المتقارب"],[53,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[82,"أطال ليلى الكمد","https://www.aldiwan.net/poem29417.html","الرجز"],[88,"بدت في مسرح رحب البلاط","https://www.aldiwan.net/poem44400.html","الوافر"],[27,"عرفت منازلاً بلوى الثماني","https://www.aldiwan.net/poem4450.html","الوافر"],[51,"يا أيها السيد الذي غمرت","https://www.aldiwan.net/poem62932.html","الكامل"],[85,"عرابي كيف أوفيك الملاما","https://www.aldiwan.net/poem7581.html","الوافر"],[45,"هذي المعاهد من سعاد فسلم","https://www.aldiwan.net/poem66637.html","البسيط"],[105,"صلوا إخوانكم واقضوا الذماما","https://www.aldiwan.net/poem42079.html","الوافر"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[48,"طربت إلى الصنج والمزهر","https://www.aldiwan.net/poem63302.html","المتقارب"],[46,"بالغار من هضبي عماية نازل","https://www.aldiwan.net/poem22710.html","الكامل"],[15,"يا دار هند عفاها كل هطال","https://www.aldiwan.net/poem45254.html","البسيط"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/55641","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[88,"بدتْ في مسرح رَحْب البلاطِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19585&r=&rc=88",""]],"verses":[["وَكَبَّ الهَدِيَّ لِأَذقانِهِ","يَؤُمُّ بِهِ زَمزَماً وَالمَقاما",0,"م",2,0],["وَكَبِّكُم كَبَّ الحَجيجِ هَدِيَّهُ","يُحَثحِثُها نَخَسُ النِصالِ إِلى المَدى",1,"د",2,0],["وكبد في كبد","لهفي واين الكبد",2,"د",1,0],["وكبرّنا المهيمن حين راحت","تصول على الضياغم بالسياط",3,"ط",1,0],["وَكُبَّلَ حاجِبٌ بِشَمامَ حَولاً","فَحَكَّمَ ذا الرُقَيبَةَ وَهوا عانِ",4,"ن",1,0],["وكُبْر ظنّي أنْ ليس مثلك من","أخدَجَ معروفه ولا بتَره",5,"ر",2,0],["وكبرّ يوم مورة ثم سمى","فكنا الصف إذ كان الإماما",6,"م",2,0],["وَكَبا عَدُوُّكَ حينَ رامَ بِكَ الَّتي","تُخشى فَقُلنا لِليَدَينِ وَلِلفَمِ",7,"م",1,0],["وكَبَّرتِ العُروبةُ إذ رَأَتْنا","فَهبُّوا مِن مَضاجِعهم قياما",8,"م",2,0],["وَكَبَسَ اللُصوصَ وَالأَفرادا","وَأَمَّنَ البِلادَ وَالعِبادا",9,"د",2,0],["وَكَبَّرُوا بَعْدَ تَصْغِيرٍ جَرَائمَهُ","وقَبَّحُوا ما طَوَوْا منها وما نَشَرُوا",10,"ر",3,0],["وَكَبَّرَ مِن طيبِها ساعَةً","وَقالَ بِها ثُمَّ لَم يَصبِرِ",11,"ر",1,0],["وَكَبائِرُ الأَشياءِ تُحدِثُ غَيرَها","فَتُعيدُها مَوصوفَةً بِصِغارِ",12,"ر",1,0],["وَكَبشِ مَلمومَةٍ بادٍ نَواجِذُهُ","شَهباءَ ذاتِ سَرابيلٍ وَأَبطالِ",13,"ل",1,0],["وكبلر قد هدى أو كاد لما","أبانك يا نجوم تجاذبينا",14,"ن",2,0],["وَكَبا في مصابِكَ البَرقُ خَطفاً","وَنَبا عَن قَضائِكَ الصَمصامُ",15,"م",1,0],["وكبرنا المهمين حين راحت","تصول على الضياغم بالسياط",16,"ط",1,0]]}