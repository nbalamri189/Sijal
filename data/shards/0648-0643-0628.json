5273,"عيد وشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=181799",""],[5277,"مسافرٌ..زادُهُ الرجوعُ","https://www.poetsgate.com/ViewPoem.aspx?id=200913",""],[5344,"سماه ماجد..","https://www.poetsgate.com/ViewPoem.aspx?id=180836",""],[5358,"معكم فؤادٌ","https://www.poetsgate.com/ViewPoem.aspx?id=202325",""],[5397,"غير بدع بأن يخون الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=157911",""],[5425,"أَوفَيتَ عَهْدَكَ ، يا حَقٌّ بِمَقْتَلِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=207514",""],[5431,"بصمة الإرهاب!!","https://www.poetsgate.com/ViewPoem.aspx?id=190283",""],[5443,"العذراء والطبق","https://www.poetsgate.com/ViewPoem.aspx?id=185151",""],[5493,"معراج الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=203377",""],[5512,"شجون فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=204171",""],[5518,"لا تعذلاه فما ذو الحب معذول","https://www.poetsgate.com/ViewPoem.aspx?id=187364",""],[5596,"تحية الى العيينة واهلها","https://www.poetsgate.com/ViewPoem.aspx?id=206718",""],[5609,"نزوة عشق","https://www.poetsgate.com/ViewPoem.aspx?id=215571",""],[5628,"هواجس مرعبة","https://www.poetsgate.com/ViewPoem.aspx?id=178464",""],[5701,"رعى الله على دِجل","https://www.poetsgate.com/ViewPoem.aspx?id=164597",""],[5725,"هاك قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=177424",""],[5725,"ناسك","https://www.poetsgate.com/ViewPoem.aspx?id=198348",""],[5897,"إليك ...أمي","https://www.poetsgate.com/ViewPoem.aspx?id=157276",""],[6152,"أمي الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=203525",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[6204,"إلى صديق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69140&r=&rc=12",""],[6213,"وطن وتراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76251&r=&rc=8",""],[6225,"تسرُّب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78037&r=&rc=122",""],[6237,"القلب الكبير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77899&r=&rc=41",""],[2220,"وبالجبلِ الأمينِ يمينُ ربي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11797&r=&rc=667",""],[6355,"رمضان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66634&r=&rc=94",""]],"verses":[["وَكَبَّ الهَدِيَّ لِأَذقانِهِ","يَؤُمُّ بِهِ زَمزَماً وَالمَقاما",0,"م",2,0],["وَكَبِّكُم كَبَّ الحَجيجِ هَدِيَّهُ","يُحَثحِثُها نَخَسُ النِصالِ إِلى المَدى",1,"د",2,0],["وكبد في كبد","لهفي واين الكبد",2,"د",1,0],["وكبرّنا المهيمن حين راحت","تصول على الضياغم بالسياط",3,"ط",1,0],["و«كبلر» قد هدى أو كاد لما","أبانك يا نجوم تجاذبينا",4,"ن",2,0],["وَكُبَّلَ حاجِبٌ بِشَمامَ حَولاً","فَحَكَّمَ ذا الرُقَيبَةَ وَهوا عانِ",5,"ن",1,0],["وكُبْر ظنّي أنْ ليس مثلك من","أخدَجَ معروفه ولا بتَره",6,"ر",2,0],["وكبرّ يوم مورة ثم سمى","فكنا الصف إذ كان الإماما",7,"م",2,0],["وَكَبا عَدُوُّكَ حينَ رامَ بِكَ الَّتي","تُخشى فَقُلنا لِليَدَينِ وَلِلفَمِ",8,"م",1,0],["وكَبَّرتِ العُروبةُ إذ رَأَتْنا","فَهبُّوا مِن مَضاجِعهم قياما",9,"م",2,0],["وَكَبَسَ اللُصوصَ وَالأَفرادا","وَأَمَّنَ البِلادَ وَالعِبادا",10,"د",2,0],["وَكَبَّرُوا بَعْدَ تَصْغِيرٍ جَرَائمَهُ","وقَبَّحُوا ما طَوَوْا منها وما نَشَرُوا",11,"ر",3,0],["وَكَبَّرَ مِن طيبِها ساعَةً","وَقالَ بِها ثُمَّ لَم يَصبِرِ",12,"ر",1,0],["وَكَبائِرُ الأَشياءِ تُحدِثُ غَيرَها","فَتُعيدُها مَوصوفَةً بِصِغارِ",13,"ر",1,0],["وَكَبشِ مَلمومَةٍ بادٍ نَواجِذُهُ","شَهباءَ ذاتِ سَرابيلٍ وَأَبطالِ",14,"ل",1,0],["وَكَبا في مصابِكَ البَرقُ خَطفاً","وَنَبا عَن قَضائِكَ الصَمصامُ",15,"م",1,0],["وكبرياء البعث أهزوجة","على شفاه الموكب الزاحف",16,"ف",1,0],["وكبرنا المهمين حين راحت","تصول على الضياغم بالسياط",17,"ط",1,0],["وكَبِّرن في التى تَلِيهَا","خَمساً ولَم تَكُن تُعَدُّ فِيهَا",18,"ه",2,0],["وكَبَّرَ سِراًّ بِلاَ نِيَّةٍ","يَظُنُّ المَقَامَ مَقَامَ الخَفَا",19,"ف",2,0],["وكبّر اجلالا لوجهك من رأى","وسبح كل العالمين من العجب",20,"ب",1,0],["وَكَبِّرِ اللَهَ وَاِشكُرهُ لِذاكَ وَقُل","اللَهُ أَكبَرُ وَاِسجُد غَيرَ مُحتَشَمِ",21,"م",1,0],["وكبا جواد الحظ بي","وحسام بأسي قد تثلّم",22,"م",1,0],["وكبارُ النفوسِ يا بْنَ مَعَدٍّ","ليس تَرْضَى إلاّ بفعل الجميل",23,"ل",1,0],["وكبا الذي جاراهم وأظنه","ممن يروم من النجوم منالا",24,"ل",2,0],["وكبيت اللَه المعمور فوق الطبا","ق في التشريف والإلمام",25,"م",1,0],["وكبر والعجب والتدابر","والقطيعات",26,"ت",1,0],["وكبِدا متى أَسُمْها سَلوةً","عنك تَنَزَّى ناشزا وتزبُنِ",27,"ن",1,0],["وكبِدٍ يصدَعُها كلُّ أسىً","بها الكبودُ القَرِحاتُ تُشعَبُ",28,"ب",1,0],["وكبت عداك ولا عدا","عمراً يكون لعمر وعدك",29,"ك",1,0],["وكبر على الأكوان تكبير ميت","تفانى عن الإحساس لما تجلت",30,"ت",1,0],["وكبار اهل العصر الوصي بآله","بسناي ذو التوفيق لا يرتاب",31,"ب",1,0],["وكبِّر عطائي منك يا متكبر","ويا خالق اجعلني عن الشر لاهيا",32,"ي",2,0],["وكبير الأصنام رب محيط","أمره بالورى كما ينويه",33,"ي",2,0],["وكبارٍ وصغارٍ مثل ما","جاء في القرآن عنه وهو قال",34,"ل",1,0],["وكبار وصغار","وأصول وفروع",35,"ع",1,0],["وَكَبَابٌ مُشَرّحٌ أَرْهَفَتْهُ","كَفُّ طاهٍ لطيفةُ التّشْرِيْحِ",36,"ح",1,0],["وكبَّر طرفي حِين لاَح هِلاَلُه","وَبَادَرَ مِن طَعْم الكَرَى لفُطُورِهِ",37,"ر",2,0],["وكَّبرتُ عشراً ثم قلت لصاحبي","متى نزل البدر المنير إلى الأرضِ",38,"ض",1,0],["وكبت جياد المجد بعد","السيد السند الجليل",39,"ل",1,0],["وَكَبورجيةٌ لَها كل فَخر","في جَميع البِقاع بَينَ الجُنود",40,"د",1,0],["وكبروا للواءٍ فوق حصنكمُ","عال ونورٍ على الآفاق ممدود",41,"د",1,0],["وكبيرُ القريضِ يكبرُ أن يُقْ","ترضَ الناسَ من قريضِ الناس",42,"س",1,0],["وَكَبُرَت بَينَهُم الجَريمَه","وَشَهِدوا الكَسرَةَ وَالهَزيمَه",43,"ه",1,0],["وكبايري في كل حينٍ لم تزل","أبداً لديّ على المدار الدايم",44,"م",1,0],["وَكَبير عَلى الفؤاد حَسود","يتهم الصب بالَّذي قَد أَصابه",45,"ب",2,0],["وكبا عنها جواد الفكر","لست أدري أي قولي الجميل",46,"ل",1,0],["وكبله بالذنوب إذ عم قلبه","سواد ذنوب دونه بطش من أسر",47,"ر",1,0],["وكَبَّرَ حينَ رَآكَ الهِلالُ","كَفِعْلِكَ حينَ رَأَيْتَ الهِلالا",48,"ل",2,0],["وَكبر الشبل وَشب وَنَهض","وَاصطاد ما عز وَدَق وَبَهض",49,"ض",1,0],["وَكَبد أَحرَقتها بالثكل","وَولد أيتمته بِالأَكل",50,"ل",1,0],["وكُبَّت جفانُ القِرى بعده","ونيرانها رُميت بالخمود",51,"د",1,0],["وكبش كتيبة قد عادلته","بألف في الحديد مدججينا",52,"ن",2,0],["وكبرت أنت فكنت كالأب حاضناً","لصغار تلك الدّار في جدواها",53,"ا",3,0],["وكبتنا بالشاكرية أردفت","وقد زلزلت يا صاح من جانب الصدر",54,"ر",1,0],["وكبتنا أتتنا في صواني","محمرة كساها السمن ريا",55,"ي",2,0],["وكبر بعضهم فيها عشياً","وكبر ثالث الأيام عصرا",56,"ر",2,0],["وكبير القوم في","حظره قد أخذا",57,"ذ",2,0],["وكبِّر واستلم واسجدْ وفبِّل","ليشرقَ عن سجدتِك الجبينُ",58,"ن",1,0],["وكبِّر تكبيراً إذا ما ذكرتنا","به حاكم الله والأكبر الله",59,"ل",2,0],["وَكَبيرُكُم وَصَغيرُكُم وَقَريبُكُم","وَبَعيدُكُم لي مُرشِدٌ وَمُقَوِّمُ",60,"م",1,0],["وكباب مزّ ليس يرغب عنه إلا","الأغبر بن الأغبر بن الأغبر",61,"ر",1,0],["وَكَبيرُهُم في راحَتَيهِ كُشوفُهُ","وَوَراءَهُ هانوتُ كَالحِرباءِ",62,"ا",2,0],["وَكَبشٍ صَرَعناهُ وَعامِلُ رُمحِهِ","كَأَنَّ عَلَيهِ ذا جَناحَينِ يَخفِقُ",63,"ق",1,0],["وكباب الكفتة منضوجا","في الصيخ علىنار الفحم",64,"م",1,0],["وكبشاً يهيج كفحل الضراب","نناطح فيه القروم نِطاح",65,"ح",1,0],["وكبير الأنام لا بمقام","جلّ لكن كبيرهم بالعطاء",66,"ا",2,0],["وكبارها وصغارها لم","ا عرين من الورق",67,"ق",1,0],["وكبروا لسجود الشكر واقتربوا","لمّا بدا لهُم منهُ محيّاهُ",68,"ا",2,0],["وكبكبه في قعر الجحيم بوجبة","كجلمود صخر حطه السيل من عل",69,"ل",1,0],["وكباسه حلي الشباب لعوبة","بطرق الهوى عقادة للزمائم",70,"م",1,1],["وكبير القَومِ فِيهِم كالصّغير","لمَلاكِ المَوتِ كُلٌّ سَجَدا",71,"د",2,0],["وكبار أهل اللَه في أتباعهم","وردت إشارتهم بهذا المرحب",72,"ب",1,0],["وكبرت عن وصل الصغا","رِ وما سلوت عن الصغارِ",73,"ر",1,0],["وكَبتُ منالَ الكفِّ منه ففتُه","وقد تحبسُ الشيءَ القريبَ الحبائسُ",74,"س",1,0],["وكبار النفوس ما نطقت أن","لم تجد من سدادها الإقتناعا",75,"ع",2,0],["وَكبوتٍ لَهُ خَمسونَ عاماً","بِهِ مَرعىً لِأَنواعِ الذُّبابِ",76,"ب",1,1],["وكبرت حتى غدت دجاجا","قد ملأت أفواجها الفجاجا",77,"ج",2,0],["وكبر العرب فالآكام واجفةٌ","ومعشر البغي صرعى بين آكام",78,"م",1,0],["وكبر الجازع الباكي فكان له","هدر الحمام على الأغصان والعذب",79,"ب",1,0],["وكبِّر شؤوني يا كبير ودبّرن","عليَّ وعظِّمني وكبِّرْ بلا كِبْرِ",80,"ر",1,0],["وكبشك العُوسى والأُضحيه","أحدوثة أُرجوحة أُوقيّه",81,"ه",1,0],["وكبش زيد أليان قد ورد","والأليات بالقياس المطرد",82,"د",1,0],["وكبِد وفخِذ ولعب","وضحك وحَلِف وكذب",82,"ب",1,0],["وَكبوتك افتحها فَما النوم نافع","وَما هُوَ إِلّا علة وَمَصائب",83,"ب",1,0],["وكبار الشيوخ يمين","صدقٍ يلظون لهم",84,"م",1,0],["وَكَبَّلاَهُ بأَغلالِ الحَديدِ وَما","أَجدَاهُ مِن غَضَبٍ يَشتَدُّ أو صَخَبِ",85,"ب",1,0],["وَكَبت فَوارسُها وَشُتِّت شَملُها","وَاندكَّ معقلها وُهدِّمَ سورُها",86,"ر",3,0],["وكبّر لما أَن رأى نور وجهه","بِنَفسي وَأَهلي ذلك الوَجه افتَدي",87,"د",2,0],["وَكَبيراً وَيافِعاً وَصَغيرا","كُلَهُم يَلفُظونَ لَفظاً كَثيرا",88,"ر",2,0],["وكبائع السوسان يرفد بينه","بالجلنّار الاحمر المتوقد",89,"د",1,0],["وَكبَّلتَهُ حَولا بِجود بنفسِهِ","تَنوءُ بِهِ في ساقِهِ حَلَقُ اللَبنِ",90,"ن",1,0],["وَكَبائرَ الهَفواتِ قَد أَلبَسَتني","ثَوبَ الهَوانِ وَمَلبَسُ البُأَساءِ",91,"ا",2,0],["وكبت بجواد وأَسرى قَوْمِهِ","دُهْمٌ أتتْ من مربط الحدَّادِ",92,"د",1,0],["وكبير بطن ضاق عنه وفاتك","ذي شِرَّة عنه يخيم ضعيفا",93,"ف",2,0],["وكبيراً بالكبرياء تردَّى","وله لا لغيره الكبرياء",94,"ا",2,0],["وكبدي لكل رمآح صدّك » تصدّت «","والقلب عز الله للحزن خيآل",95,"ل",1,0],["وَكَبَّرَ فِيْ حِمْصَ الْجَرِيْحَةِ خَاْلِدٌ","فَأَوْمَضَ بَرْقٌ فَوْقَ تَدْمُرَ عَاْلِيَاْ",96,"ي",2,0],["وَكَبَّرَ فِيْ أَرْضِهَا الصَّاْلِحُوْنَ","وَمَاْ بِدِيَاْرِهِمُ مِنْ أُسَرْ",97,"ر",1,0],["وكبيرِ قومٍ زينته لحيةٌ","أغرتهمو بالسبِّ والتلعين",98,"ن",1,0],["وَكَبَّرَ فَجْراً لِلصَّلاةِ مُسافِرٌ","فَطافَتْ سَلاماً فِي رُباكِ الْمَساجِدُ",99,"د",1,0],["وكُبكِبوا في مخاضاتٍ يُشل بها","خطو الرياح وتنعي نارها سقرُ",100,"ر",1,0],["وكبر لله الحجاز وأوبت","مع البيت بالترتيل فيه أخاشبه",101,"ب",2,0],["وَ كَبَا عَاشِقُ الجَمَالِ كَمُهْرٍ","كَانَ في حَوْمَةِ الغَرَامِ يَصُوْلُ",102,"ل",1,0],["وكبتُّ أشواقي إليكِ ولم أبحْ","بالسرِّ إلا ما عيونُك تَفهمُ",103,"م",1,0],["وكبار الأفعال إن هي كانت","من كبار المقام كانت أصولا",104,"ل",2,0],["وكَبّرَ جُنْدُ مصرَ بكلِّ فَخْرٍ","فأحدثَ صوتُ فَرْحتهمْ طَنينا",105,"ن",2,0],["وكبر النفس داء اي داء","يحار الطب بحثا عن دواء",106,"ا",2,0],["وكبائعِ الحلوى يصيحُ وكُلَّما","نادى على الحلوى وقفتُ لأسمَ