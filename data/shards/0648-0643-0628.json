{"poems":[[53,"ضربن إلينا خدودا وساما","https://www.aldiwan.net/poem29807.html","المتقارب"],[53,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[82,"أطال ليلى الكمد","https://www.aldiwan.net/poem29417.html","الرجز"],[88,"بدت في مسرح رحب البلاط","https://www.aldiwan.net/poem44400.html","الوافر"],[88,"أجدك يا كواكب لا ترينا","https://www.aldiwan.net/poem45071.html","الوافر"],[27,"عرفت منازلاً بلوى الثماني","https://www.aldiwan.net/poem4450.html","الوافر"],[51,"يا أيها السيد الذي غمرت","https://www.aldiwan.net/poem62932.html","الكامل"],[85,"عرابي كيف أوفيك الملاما","https://www.aldiwan.net/poem7581.html","الوافر"],[45,"هذي المعاهد من سعاد فسلم","https://www.aldiwan.net/poem66637.html","البسيط"],[105,"صلوا إخوانكم واقضوا الذماما","https://www.aldiwan.net/poem42079.html","الوافر"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[48,"طربت إلى الصنج والمزهر","https://www.aldiwan.net/poem63302.html","المتقارب"],[46,"بالغار من هضبي عماية نازل","https://www.aldiwan.net/poem22710.html","الكامل"],[15,"يا دار هند عفاها كل هطال","https://www.aldiwan.net/poem45254.html","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[100,"بين ذهاب ومعاد","https://www.poetsgate.com/ViewPoem.aspx?id=50188",""],[88,"بدتْ في مسرح رَحْب البلاطِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19585&r=&rc=88",""],[132,"ليست صلاة العيد كالصلاة","https://www.aldiwan.net/poem54657.html","الرجز"],[132,"أشاقتك ورق اللوى هتفا","https://www.aldiwan.net/poem54796.html","المتقارب"],[160,"أقمن على قلبي رقيبا من الحب","https://www.aldiwan.net/poem58937.html","الطويل"],[169,"أنخ فهذي قباب العز والكرم","https://www.aldiwan.net/poem1676.html",""],[197,"حي الصباح إذا تبسم","https://www.aldiwan.net/poem39901.html","مجزوء الكامل"],[229,"إنما تكرم الطباع إذا ما","https://www.aldiwan.net/poem50853.html","الخفيف"],[261,"أيظن بي أني رنا أو مالا","https://www.aldiwan.net/poem38210.html","الكامل"],[304,"قل لأحبابنا بسوح المقام","https://www.aldiwan.net/poem16829.html","الخفيف"],[391,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[458,"أين تريد يا مثير الظعن","https://www.aldiwan.net/poem55836.html","الرجز"],[458,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[464,"يا سيد الوزراء","https://www.aldiwan.net/poem3283.html","عموديه"],[482,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[500,"في كل عصر من علي واحد","https://www.aldiwan.net/poem37549.html","الكامل"],[558,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[558,"قلت للعارف النبيل النبيه","https://www.aldiwan.net/poem33631.html","الخفيف"],[558,"إن من آيات ربي هو قال","https://www.aldiwan.net/poem34210.html","الرمل"],[558,"أيها البرق اللموع","https://www.aldiwan.net/poem34383.html","مجزوء الرمل"],[567,"ما ترى في الصبوح أيدك الله","https://www.aldiwan.net/poem69743.html","الخفيف"],[575,"كتاب كريم جاءني بعد فترة","https://www.aldiwan.net/poem2721.html","الطويل"]],"verses":[["وَكَبَّ الهَدِيَّ لِأَذقانِهِ","يَؤُمُّ بِهِ زَمزَماً وَالمَقاما",0,"م",2,0],["وَكَبِّكُم كَبَّ الحَجيجِ هَدِيَّهُ","يُحَثحِثُها نَخَسُ النِصالِ إِلى المَدى",1,"د",2,0],["وكبد في كبد","لهفي واين الكبد",2,"د",1,0],["وكبرّنا المهيمن حين راحت","تصول على الضياغم بالسياط",3,"ط",1,0],["و«كبلر» قد هدى أو كاد لما","أبانك يا نجوم تجاذبينا",4,"ن",2,0],["وَكُبَّلَ حاجِبٌ بِشَمامَ حَولاً","فَحَكَّمَ ذا الرُقَيبَةَ وَهوا عانِ",5,"ن",1,0],["وكُبْر ظنّي أنْ ليس مثلك من","أخدَجَ معروفه ولا بتَره",6,"ر",2,0],["وكبرّ يوم مورة ثم سمى","فكنا الصف إذ كان الإماما",7,"م",2,0],["وَكَبا عَدُوُّكَ حينَ رامَ بِكَ الَّتي","تُخشى فَقُلنا لِليَدَينِ وَلِلفَمِ",8,"م",1,0],["وكَبَّرتِ العُروبةُ إذ رَأَتْنا","فَهبُّوا مِن مَضاجِعهم قياما",9,"م",2,0],["وَكَبَسَ اللُصوصَ وَالأَفرادا","وَأَمَّنَ البِلادَ وَالعِبادا",10,"د",2,0],["وَكَبَّرُوا بَعْدَ تَصْغِيرٍ جَرَائمَهُ","وقَبَّحُوا ما طَوَوْا منها وما نَشَرُوا",11,"ر",3,0],["وَكَبَّرَ مِن طيبِها ساعَةً","وَقالَ بِها ثُمَّ لَم يَصبِرِ",12,"ر",1,0],["وَكَبائِرُ الأَشياءِ تُحدِثُ غَيرَها","فَتُعيدُها مَوصوفَةً بِصِغارِ",13,"ر",1,0],["وَكَبشِ مَلمومَةٍ بادٍ نَواجِذُهُ","شَهباءَ ذاتِ سَرابيلٍ وَأَبطالِ",14,"ل",1,0],["وَكَبا في مصابِكَ البَرقُ خَطفاً","وَنَبا عَن قَضائِكَ الصَمصامُ",15,"م",1,0],["وكبرياء البعث أهزوجة","على شفاه الموكب الزاحف",16,"ف",1,0],["وكبرنا المهمين حين راحت","تصول على الضياغم بالسياط",17,"ط",1,0],["وكَبِّرن في التى تَلِيهَا","خَمساً ولَم تَكُن تُعَدُّ فِيهَا",18,"ه",2,0],["وكَبَّرَ سِراًّ بِلاَ نِيَّةٍ","يَظُنُّ المَقَامَ مَقَامَ الخَفَا",19,"ف",2,0],["وكبّر اجلالا لوجهك من رأى","وسبح كل العالمين من العجب",20,"ب",1,0],["وَكَبِّرِ اللَهَ وَاِشكُرهُ لِذاكَ وَقُل","اللَهُ أَكبَرُ وَاِسجُد غَيرَ مُحتَشَمِ",21,"م",1,0],["وكبا جواد الحظ بي","وحسام بأسي قد تثلّم",22,"م",1,0],["وكبارُ النفوسِ يا بْنَ مَعَدٍّ","ليس تَرْضَى إلاّ بفعل الجميل",23,"ل",1,0],["وكبا الذي جاراهم وأظنه","ممن يروم من النجوم منالا",24,"ل",2,0],["وكبيت اللَه المعمور فوق الطبا","ق في التشريف والإلمام",25,"م",1,0],["وكبر والعجب والتدابر","والقطيعات",26,"ت",1,0],["وكبِدا متى أَسُمْها سَلوةً","عنك تَنَزَّى ناشزا وتزبُنِ",27,"ن",1,0],["وكبِدٍ يصدَعُها كلُّ أسىً","بها الكبودُ القَرِحاتُ تُشعَبُ",28,"ب",1,0],["وكبت عداك ولا عدا","عمراً يكون لعمر وعدك",29,"ك",1,0],["وكبر على الأكوان تكبير ميت","تفانى عن الإحساس لما تجلت",30,"ت",1,0],["وكبار اهل العصر الوصي بآله","بسناي ذو التوفيق لا يرتاب",31,"ب",1,0],["وكبِّر عطائي منك يا متكبر","ويا خالق اجعلني عن الشر لاهيا",32,"ي",2,0],["وكبير الأصنام رب محيط","أمره بالورى كما ينويه",33,"ي",2,0],["وكبارٍ وصغارٍ مثل ما","جاء في القرآن عنه وهو قال",34,"ل",1,0],["وكبار وصغار","وأصول وفروع",35,"ع",1,0],["وَكَبَابٌ مُشَرّحٌ أَرْهَفَتْهُ","كَفُّ طاهٍ لطيفةُ التّشْرِيْحِ",36,"ح",1,0],["وكبَّر طرفي حِين لاَح هِلاَلُه","وَبَادَرَ مِن طَعْم الكَرَى لفُطُورِهِ",37,"ر",2,0]]}