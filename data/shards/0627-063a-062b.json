dhabi.ae/diwan/poem/97074","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102754","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90801","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54416","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83423","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83411","الطويل"],[4393,"","https://poetry.dctabudhabi.ae/diwan/poem/124787","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133119","الطويل"],[4550,"","https://poetry.dctabudhabi.ae/diwan/poem/107129","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139524",""],[4673,"","https://poetry.dctabudhabi.ae/diwan/poem/104487","الطويل"],[4726,"أيا رحمة الدارين والسيد الذي","https://www.poetsgate.com/ViewPoem.aspx?id=146651",""],[4935,"إله البرايا إليك الحقير","https://www.poetsgate.com/ViewPoem.aspx?id=129277",""],[4935,"يا رب أنت لي سند","https://www.poetsgate.com/ViewPoem.aspx?id=129273",""],[5256,"أنادي إلهي بيا ربنا","https://www.poetsgate.com/ViewPoem.aspx?id=157390",""],[307,"طافَ الوباءُ بقاع الأرضِ","https://www.poetsgate.com/ViewPoem.aspx?id=215607",""],[5459,"طال الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=205766",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5974,"إلهي","https://www.poetsgate.com/ViewPoem.aspx?id=215788",""],[6302,"يُحيطونَ.. لكنْ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86233&r=&rc=31",""]],"verses":[["أَغِثني يا فَداكَ أَبي وَأُمّي","بِسَيبٍ مِنكَ إِنَّكَ ذو اِرتِياحِ",0,"ح",1,0],["أَغِثني وَأَصحابي بِضامِنَةِ القِرى","كَأَنَّ بِأَحقيها مُقَيَّرَةً وَفرا",1,"ر",2,0],["أغثني فإنَّ العفوَ لي منكَ جنَّةٌ","وغثني فإنَّ اللطفَ منك سحاب",2,"ب",1,0],["أغث بأيادي الرضا مغرماً","دعاك وخذ بيد العاشق",3,"ق",1,0],["أغثْ مبعداً لاقياً للأسى","يلوذ بإحسانك اللائق",3,"ق",1,0],["أغثْ قوماً إلى البطِّيخ أمسوا","قياماً يسألون عن الأهلَّه",4,"ه",1,0],["أغِثّاءُ ما فيهم أديبٌ علمتُه","ولا قابلُ التأديب حين يؤدَّبُ",5,"ب",1,0],["أغْثني يا أبا حسنٍ أغثني","فأنت المستغاث لدى الكروبِ",6,"ب",1,0],["أغثنا فأنت المرء يُهتف باسمه","إذا الأمر أضحى آخذاً بالمُخَنَّقِ",7,"ق",1,1],["أَغِث مُضَراً إِنَّ السِنينَ تَتابَعَت","عَلَيها بِحَزٍّ يَكسِرَ العَظمَ جازِرُه",8,"ر",2,0],["أَغِثني بِكُنهي في نِزارٍ وَمُقبَلي","فَإِنّي كَريمُ المَشرِقَينِ وَشاعِرُه",9,"ر",2,0],["أَغِثنا بِشرْبٍ كالذي ذاق قومُنا","فكان لهم نُوراً به الرُّوحُ تهتدي",10,"د",2,0],["أغِثْنا إنّها يا خيرَ مَولىً","عُرَى الأرحامِ ليس لها انْفِصامُ",11,"م",1,0],["أغث بلداً منها نشأت فقد عدت","عليها عوادٍ للدمار تعجل",12,"ل",1,0],["أَغَثُّ بَنيهِ يَأكُلُهُ","فَكَيفَ يَعافُ أسمَنَها",13,"ن",3,0],["اغث عانيا ً اربح ثواب فكاكه","فلا زلت للاسلام حصنا ً وموئلا",14,"ل",2,0],["اغث يا روح جسم الكون يا من","تزول بسره الكرب العظام",15,"م",1,0],["اغث يا ابن العواتك يا حبيبا","بنهلة ريقه تحيى العظام",15,"م",1,0],["اغث يا صاحب الغارات اني","بجاهك في الشؤن لي اعتصام",15,"م",1,0],["اغثني بلطف من حنانك عاجل","به القلب يحيى والمعاند يقهر",16,"ر",1,0],["اغثنا وفرج جميع الكروب","فقد طال فيها علينا المدى",17,"د",2,0],["اغث بحقك سمعي واتل مبثهجاً","تمداحهم واحي قلب السامع الرائي",18,"ي",1,0],["أغث يا أحمد البدوي وأدرك","وكن عوني فأنت حمى الفقير",19,"ر",1,1],["أغث فإني حول أعتابكم","أطوف يا مولاي في كل حال",20,"ل",1,0],["أغث يا سيد السادات عبداً","ببابك لاذ يا مولى الموالي",21,"ل",2,1],["أغث يا ختام المرسلين بإحسان","وعطف ولطف عبدك الضائع العاني",22,"ن",2,1],["أغثني أبا الزهراء وارحم شكايتي","فإني إلى عليا حماك انتمائيا",23,"ي",2,0],["أغث يا نصير العاجزين برحمةٍ","وكن ناصراً عوناً على من تعرضا",24,"ض",2,0],["أغث بقبول واصرف الهم والبلا","وكيد العدا والقائمين ببهتان",25,"ن",1,0],["أغث وردَّ سريعاً","يا أكرم الخلق مالي",26,"ل",2,0],["أغث يا مغيث المستغيثين والهاً","ألمّ به من بعد أحبابه الضر",27,"ر",1,0],["أَغِثني بِيَومٍ مِن لقائِكَ واحدٍ","فإنّي بيومٍ من لقائِكَ أجزَأُ",28,"ا",1,0],["أغث هذه الطرحا من الجوع والضنى","على الطرق عجزاً واكس أعظمهم لحما",29,"م",2,0],["أغثنا أغثنا فالوجوه تناكرت","وقد قطع الأرحام أقربهم رحما",29,"م",2,0],["أغثني ففي روحي لحون حبيسة","وفي الصدر ما فيه أغثني لأبديه",30,"ي",2,0],["أغثني بتوفيق ينور باطني","وينحو إلى الخيرات بي أحسن النحو",31,"و",1,0],["اغثني فقد ضاقت عليّ مذاهبي","وأنت ملاذ للمروع المخوّف",32,"ف",1,0],["اغثني فإني في زمان خطوبه","لها بين أحناء الرجال كصيص",33,"ص",1,0],["أَغِثْنِي يَا عَلاَءَ أَبِي عَلِيٍّ","وَأَنْقِذْنِي مِنْ أَسْبَابِ الْوَبَالِ",34,"ل",1,0],["أغثنا بالرحيل غداً فإنا","من الشوق المبرح في حصارِ",35,"ر",1,0],["اَغَثُّ يا مُغيثَ قُلوبِنا","بِغَيثٍ هَدى يُحيي القُلوبَ مِنَ المَحلِ",36,"ل",1,0],["أَغِثنا فإِنّا عُصبةٌ مَذحِجِيَّةٌ","نُناطُ على وَفرٍ وليس لنا وَفرُ",37,"ر",1,0],["أَغِثني بِماءِ الوَصلِ مَأواكِ إِنَّهُ","حِمىً كانَ مِن رَهجِ الحَمِيَّةِ كاسِيا",38,"ي",2,0],["أَغثني بِكَأس يا نَديم لَعَلَني","أَرى لي بِها مِن ربقة الهَم مَخرَجا",39,"ج",2,0],["أَغِثني بِصَوت يا نَديم فَإِنَّني","لَأَرتاح لِلصَوت الشَجيّ وَإِطرَب",40,"ب",1,0],["أغثنا بغيث يا مغيث وجد به","علينا بمحض الفضل يا رب يا صمد",41,"د",1,0],["أغِثْني وأحسِنْ واكشِفِ الضُّرَّ عن أخٍ","يُوالِيكَ والإحسانُ أولى وأحسَنُ",42,"ن",1,1],["أغِثْ أيُّها الشَّيخُ الوزيُر فإنَّني","دُهِيتُ بما قد كنتُ قبلُ أخافُ",43,"ف",1,1],["أغثني أغثني عاجلاً غير آجلٍ","باِخراس مجموعِ المخازي قرنفل",44,"ل",1,0],["أغثها وأسسها لدى كل أعصر","ولا تتركنها بالعراء يا أحمد",45,"د",1,0],["اغث فقد تعدَّت الأعداء","فرام بسهم البطش من رمينا",46,"ن",2,0],["أغث وتدارك يا ابن عم محمَّدٍ","بلطفٍ آلهي عميم المواهب",47,"ب",1,0],["أغِثْ بِخَفيِّ اللُّطْفِ يا ربِّ حالَنا","وأنْعم لَنا باللُّطْفِ من حيثُ لا ندري",48,"ر",2,0],["أَغِثْنَا فَإِنَّا قَدْ ظَمِئْنَا وَرَوِّنَا","مِنَ الرَّائِقِ المَطْبُوخِ وَلْيَكُ مَعْسُولاَ",49,"ل",2,0],["أَغثتَ تِبْنين وخلَّصْتَها","فريسةً من ما ضِغَى ضَيْغَمِ",50,"م",1,0],["أَغِثْنا أَجِرْنَا مِنْ ذنوبٍ تَعاظَمَتْ","فَأَنْتَ شَفيعٌ لِلْوَرَى وَمُخلِّصُ",51,"ص",1,0],["أَغِثني أَيُّها السَّاقي لعَلِّي","إِذا أَظمَتكَ نازِلَةٌ سَقَيتُ",52,"ت",1,0],["أغِثنا أغِثنا مِن عِدانا يكن لنا","بكَ النّصرُ حتى يُخذلُوا ثم يُهزموا",53,"م",3,0],["أغثني وأنجز سيدي ما وعدتني","وخذ بيدي ياذا الكرامة والحسنى",54,"ن",2,0],["أغثني تداركني أجرني فإنني","لفى ان تراخى عنه لطفك يعطب",55,"ب",1,0],["أغثني بفياض جود بن الأم","اني غرقى لها قد غمر",56,"ر",1,0],["أغث بمحمد يا رب عبداً","بباب المصطفى ناخ المطيّا",57,"ي",2,0],["أغثت بالعدل وبذل اللهى","منا قلوبا جد ملهوفَه",58,"ف",2,0],["أغثني أغثني يا بن عم محمد","فخُذْ بيدي مولاي رُوحي لك الفدا",59,"د",2,0],["أَغث بالنجا نفسي من الخاطف الذي","له وثبة الليث الشديد التغوّلِ",60,"ل",1,0],["أَغَثْتَ عِبادَ اللهِ مِنكَ بِرَأْفَةٍ","تَشارَكَ فيها عُرْبُهُمْ والأَعاجِمُ",61,"م",1,0],["اغثنا بغيث منك يا رب عاجل","سريعا وحقق يا الهي لنا الرجوى",62,"و",2,0],["أغثني فإني تحت بابك واقف","وجد لي بما أرجوه واستعطف الربا",63,"ب",2,0],["اغثنا بغوث عاجل غير آجل","تقربه العينان يا قرة العين",64,"ن",1,0],["أغث وعامل بلطف من جنابك يا","مولى المراحم واحفظني من المحن",65,"ن",1,0],["اغثني يا كريم وهب متابا","وسلمني إلهي ورق العذابا",66,"ب",2,1],["أغثني لاجل اللَه يا سيد الملا","وخذنا حنانا واسقني صافي الشرب",67,"ب",1,0],["اغثها فهي مما قد عراها","من الاسواء قد فُصِمت عراها",68,"ا",3,1],["اغثني اجرني أنا الحائر","الضعيف الاثير كثبر ألم",69,"م",1,0],["أغث رمقي وارحم بإصلاح مهجتي","وبالسر سيرتي بمسلك سنة",70,"ه",1,0],["أغث عبدك المذنب الخاطئ","إله البرايا بحق النبي",71,"ب",2,1],["أغث عبدا ضعيفا قد توالت","عليه من الذنوب المزعجات",72,"ت",1,0],["أغث رب عبدا ضل في مهمة غفر","وحلت به البأساء في مسلك وعر",73,"ر",1,1],["أغثنا أغثنا أنت يا رب حسبنا","ونعم النصير الرب يا عالم السر",73,"ر",1,0],["أغثني بما نجيت ذا النون بعد إذ","تعمق في أحشائه البحر ثاويا",74,"ي",2,0],["أغث عزة التوحيد وحيا بقصمهم","كسنتك اللهم في شرامة",75,"ه",1,0],["اغثني على ما انت في من الوفا","بكاس وخذ من دمع عيني ساقيه",76,"ي",2,0],["أَغِثْ وَاشْفِنيِ مِنْ دَاءِ نَفْسِىَ وَاهْدِنِي","إِلَى الخَيْرِ وَاصْلِحْ مَا بِعَقْلِي تَخَلَّلاَ",77,"ل",2,0],["أغثني حُسام اللَه انك مُنصف","وسيف لبأساء وذي غمتي حال",78,"ل",1,0],["أغثني شفيع ذلك اليوم رأفة","وأدخلن جنات لديك مجاورا",79,"ر",2,0],["أغث سرعة وانشل لصب مبرح","متيم قد أضناه هجرك جاهد",80,"د",1,0],["أغثني فأنت اليوم كهفي وناصري","فلباه لا وان ولا هو راهب",81,"ب",1,0],["أغثنا بروحك إن كان حيّاً","فإنّ قوانا تكاد تخور",82,"ر",1,0],["أغثنا به اللهم وانصر به الهدى","فما غيره للجور بالعدل ناسخ",83,"خ",1,0],["أغثنا به اللهم دعوة مقسم","عليك بخير الخلق بخير الخلق أحمد والحجب",84,"ب",1,0],["أغثني إذا ظلّت نفوس حزينة","وأرعد أفراص العصاة التندّم",85,"م",1,0],["أغث أغث يا رسول الله عبدك يا","من فوق كل مقام عرشه عال",86,"ل",1,0],["أغثني يا عماد ومن عليه","إذا ما لم تغث يكن اعتمادي",87,"د",2,0],["أغثني بمسعفة من نداك","الذي قد أطاف بكل الدهور",88,"ر",1,0],["أغثني أجرني ضاع عمري ألى متى","بأثقال أوزاري أراني أرزأ",89,"ا",1,0],["أغِثنى مِمَّا دَهانِى أغِث","فإِنِّى امرُؤٌ عادَتِى أَلنَّكَت",90,"ت",1,0],["اغِثنى وَصَحبى كُلَّهُم وَارأَفَن بِنا","وَقُل لِى أيا مَجذوبُ عِندِى عَوَاطِرُ",91,"ر",1,0],["اغثني بانتصارك وانتشلني","بعزمك من أسار الظالمينا",92,"ن",2,0],["أغثها يا غياث الدين وانقع","ببشرك من حُشاشتها الأواما",93,"م",2,0],["أَغِثْ أَغثْ أَنت مُغِيثُ المستَغيثْ","فما لنا سِوَاك يا رَبِّ مُغِيثْ",94,"ث",1,0],["أغِثْني بجاهٍ منك أوْ بشفاعةٍ","فإنك واللهِ الشفيعُ المشفّعُ",95,"ع",1,0],["أغثني برأي منك يفرج كربتي","وحل محسناً بيني وبين النوائب",96,"ب",1,0],["أغِثني إذا غنّى الحمام المطرّبُ","بكأسٍ بها وسواسُ فكريَ ينهَبُ",97,"ب",1,1],["أغث حوزة الايمان واعمر ربوعه","فلم يبق فيها غير دارس آثار",98,"ر",1,0],["أغث دعوة الحق انتعشها فمالها","سواك وأنت الشمْريُّ المداعس",99,"س",1,0],["أغث كرماً هذا الزمان فإنه","إذا قمت قامت للكرام معاطس",99,"س",1,0],["أغثنا فقد طال القضاء بوعدنا","فلا نحن أدركنا ولا الحلق آيس",99,"س",1,0],["أغثنا قبيل الموت إن نفوسنا","لها في غد أو بعده الموت خالس",99,"س",1,0],["أغث ببني عدنان دين محمد","فهم نجد واقمع بهم كل آثم",100,"م",1,0],["أغِثنِي أعالِج كُربتِي وصَبَابَتِي","ببنتِ أُسيسَاحٍ ترَجِّعُ لِي دَنَّا",101,"ن",2,0],["أغثني بسجل من نداك يكفني","وقاك الردى مرد الرجال وشيبها",102,"ب",3,0],["أَغث فَقيراً دَعاكَ اليَوم مُنزَعِجاً","عَلى غَواربه حمل وقنطار",103,"ر",1,0],["أغثت إيران حيث المستغيث بها","حشاشة ما لها صبر و