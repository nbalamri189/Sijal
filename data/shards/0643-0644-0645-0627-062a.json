اق النبوة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79569&r=&rc=25",""],[6199,"أنا آخر العشّاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79701&r=&rc=22",""],[6213,"شجون عاتية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85497&r=&rc=100",""],[6213,"العربية الصامدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81775&r=&rc=84",""],[5567,"حيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81760&r=&rc=28",""]],"verses":[["كلماتِي قَلائِدُ الأَعْناقِ","سَوْفَ تَفنى الدُّهُورُ وَهْيَ بَواقِ",0,"ق",1,1],["كَلَماتٍ مِن غَيرِ شَكلٍ وَلا نَق","طٍ وَلا مِثلِ نَغمَةِ الأَصواتِ",1,"ت",1,0],["كلماتٌ ليست بمكروهة المس","موع لكن مكروهة المشمومِ",2,"م",1,0],["كلماتٌ تَذُمُّ فعلك لا أص","لك كلا ولا تذمُّ الأَرُومه",3,"م",2,0],["كُلُّ ما تَقصُرُ المَدارِكُ عَنهُ","كائِنٌ مِثلَما الظُنونُ تَشاءُ",4,"ا",2,0],["كُلُّ ما تَصبو إِلَيهِ نَفسُهُ","مُعصَرٌ أَو خَمرَةٌ مُعتَصَرَه",5,"ر",2,0],["كُلُ ما تَطلُبُهُ في","هِ مَليحٌ وَكَثيرُ",6,"ر",1,0],["كَلِماتي هِيَ سِحرٌ","وَهِيَ البابُ المُجَرَّب",7,"ب",1,0],["كلمات قد زادت القبر طيبا","فوق طيب العظام والأكفان",8,"ن",1,0],["كلمات دون باهرها","في النُّهى الآيات في النظر",9,"ر",1,0],["كُلُّ ما تَرضاهُ يا مَو","لايَ يَرضاهُ وَلائي",10,"ا",3,0],["كَلِماتُهُ قُضُبٌ وَهُنَّ فَواصِلٌ","كُلُّ الضَرائِبِ تَحتَهُنَّ مَفاصِلُ",11,"ل",1,0],["كُلَّما تاهَ جِماحاً صَدرُهُ","صَرَّفَتهُ كَفُّهُ حَيثُ يَشا",12,"ش",2,0],["كلما تَقرُبُ تمتدُّ له","كأكفّ شرهاتٍ تنتظر",13,"ر",1,0],["كلما تخدعنا الأي","يام خادعنَا الأنامَا",14,"م",2,0],["كلماتٌ عذبةٌ معسولةٌ","ضيّعت وارحمتا للقَسَم",15,"م",1,0],["كلما تقبل أيام المنى","تنجلى النعماء عن ذاك السراب",16,"ب",1,0],["كلما تنظر في عيني ترى","سريَ الغافي ومعناي الخفيا",16,"ي",2,0],["كلما تترى المعاني أجتلي","خلف معناها لأسرارك معنى",16,"ن",2,0],["كلما تقسو الليالي عرفا","روعة الآلام في المنفى الطهور",17,"ر",1,0],["كلَّما تُبْتُ ساعةً عُدْتُ أُخرى","لِضُروبٍ من سوءِ فِعلي وهُجري",18,"ر",2,0],["كُلَّما توعِدُني تُخلِفُني","ثُمَّ تَأتي حينَ تَأتي بِعُذُر",19,"ر",1,0],["كلُّ ما تَكرَهُ النُّفُوسُ من البَغْ","يِ وَسُوءِ الصّنيعِ فيه حَرامُ",20,"م",1,0],["كُلُّ مَا تَطْوِي جَوَانِحُهُ","فَهوَ في الْعَيْنَين مَكْتُوبُ",21,"ب",1,0],["كلمات وَقَد تَكون رموزاً","كتبت في صحيفة زرقاء",22,"ا",2,0],["كُلُّ مَا تَبْنِي يبني","طَلْعَتٌ يُمْنٍ وَغَنْمُ",23,"م",1,0],["كَلِمَاتِ بَاكٍ أَنْ تبِينَ","وَلَمْ يَزَلْ غَضاً صِبَاكْ",24,"ك",1,0],["كلماتُ عطفك لا يزال رنينُها","يحكي بأُذني رنَّةَ الأعواد",25,"د",1,0],["كلُّ ما تشتهيهِ أن تَصحب الصارمَ","عَضْباً وأن تَخُبَّ الرواسِم",26,"م",1,0],["كل ماتقبل على وجهي مملّه","ااتشهّد وأذكر أن الله عويني",27,"ن",2,0],["كل ماتعثّر ؟ قلت في نفسي وأنا أمس شنبي","ياكم على الدنيا فقير .. ويحسدونه أثريا",28,"ي",2,0],["كلمات من غير شكل ولا نطق","ولا مثل نغمة الأصوات",29,"ت",1,0],["كلماتنا في الحب .. تقتل حبنا","إن الحروف تموت حين تقال",30,"ل",1,0],["كل ما تبتغيه منا الحياة","هو أن لا تصيبها النكبات",31,"ت",1,1],["كلما تجذب آها","تتبع اللهفة آها",32,"ا",3,0],["كلماته زادت على ما قدرت","أفهامنا في الفضل حين يحاور",33,"ر",1,0],["كلُّ ما تكرهُ النفوسُ من الضرِّ","حبيبٌ إن مسها من حبيبِ",34,"ب",1,0],["كلّ ما ترجوه أن يحيا الوصال","كالذي كان لأيام الدلال",35,"ل",1,0],["كلّ ما ترجوه ضلالٌ في ضلال","إن قلبي كله ملك الجمال",35,"ل",1,0],["كُلُّ ما تَقتَني حَلال","بِاِسمِكَ الخَيرُ يُذكَرُ",36,"ر",1,0],["كَلماتٌ أَصغى الغَبيُّ إِلَيها","فَاِعتَراهُ مسٌّ منَ الخُيلاءِ",37,"ا",2,0],["كَلِماتٌ كأَنَّها اللؤلؤُ المَك","نونُ أَسلاكُها سطورُ الكِتابِ",38,"ب",1,0],["كُلَّما تُبتُ عَن ذُنوبي مُنيباً","وَتَبَلَّت بُكرَةً وَعَشِيّا",39,"ي",2,1],["كل ما تمرّ السنين","كل ما يزيد الغرام",40,"م",1,0],["كل ما تطويه باصرتي","دجن تختال في دجن",41,"ن",1,0],["كَلِماتٌ خُلِقْنَ منه على الأع","داء سَيْفاً عَضْباً وللمُلْكِ زَغْفا",42,"ف",2,0],["كلمات منكم طيب شذاها","عطر عطر من دارى رباها",43,"ا",3,1],["كلمات كأنهن سيوف","أين من فضلك السيوف الصوارم",44,"م",1,0],["كلمات, أو أذرعة, أو آلاما, أو أهواء","حذرا أن نهتز ونتفتَّح",45,"ح",1,0],["كل ما تشتهيه أعطيه سمحا","غير بيعي استقلال قلبي وذهني",46,"ن",2,0],["كلمات تأتي الحزون وتمشي","حيث لانت أباطح وسهول",47,"ل",1,0