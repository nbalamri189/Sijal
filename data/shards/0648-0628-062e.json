{"poems":[[72,"أرسلت بعدكم بجهد نحوكم","https://www.aldiwan.net/poem19616.html","الكامل"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[85,"مضناك جفاه مرقده","https://www.aldiwan.net/poem63667.html","المتدارك"],[45,"يا ابنة العامري عما قليل","https://www.aldiwan.net/poem65557.html","الخفيف"],[49,"دار بليت بحبها خوانة لمحبها","https://www.aldiwan.net/poem10386.html","مجزوء الكامل"],[49,"ما لي رأيتك راكبا لهواكا","https://www.aldiwan.net/poem62207.html","الكامل"],[66,"وبخيل ينال من عرضه النا","https://www.aldiwan.net/poem38594.html","الخفيف"],[97,"راحوا بأرواحٍ ظماء","https://www.aldiwan.net/poem24773.html","مجزوء الكامل"],[52,"طال ليلي وساورتني الهموم","https://www.aldiwan.net/poem26703.html","الخفيف"],[52,"عرف الدار فحيا وناحا","https://www.aldiwan.net/poem27159.html","المديد"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"هام قلبي باللواتي","https://www.aldiwan.net/poem64733.html","مجزوء الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202538","الرجز"],[77,"","https://poetry.dctabudhabi.ae/diwan/poem/71640","الكامل"],[100,"أسمار القرية","https://www.poetsgate.com/ViewPoem.aspx?id=50334",""],[128,"ما زلت في لهو وفي طرب وفي","https://www.aldiwan.net/poem50542.html","الكامل"],[128,"جار الحبيب على الكئيب ببعده","https://www.aldiwan.net/poem50638.html","الكامل"],[128,"من لصب تصاعدت حسراته","https://www.aldiwan.net/poem50653.html","الخفيف"],[155,"أغريت بي سقما علي","https://www.aldiwan.net/poem55574.html","مجزوء الكامل"],[189,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[189,"عج بالمدينة تلق ثم كريما","https://www.aldiwan.net/poem35109.html","الكامل"],[199,"جافيتني والذنب ذنبك","https://www.aldiwan.net/poem45608.html","مجزوء الكامل"],[199,"يا طير ما للنوم قد طارا","https://www.aldiwan.net/poem45627.html","السريع"],[221,"أيهما كان الظلوم البليد","https://www.aldiwan.net/poem55291.html","المتقارب"],[235,"يا خير منتصر لخير إمام","https://www.aldiwan.net/poem31765.html","الكامل"],[235,"آنسن في الفودين وخط بياض","https://www.aldiwan.net/poem31901.html","الكامل"],[235,"وبخيلة سمح الرقا","https://www.aldiwan.net/poem32174.html","مجزوء الكامل"],[237,"ما لمن مسه من الفقر داء","https://www.aldiwan.net/poem18031.html","الخفيف"],[237,"رد فضل ذي العرش المجيد","https://www.aldiwan.net/poem18156.html","مجزوء الكامل"],[237,"ألا فالذي تسمو إليه وترتقي","https://www.aldiwan.net/poem19698.html","الطويل"],[252,"وبالجرع رسم مثل جسمي شاحب","https://www.aldiwan.net/poem1448.html",""],[259,"أصبحت مرآة لحسن مثالكم","https://www.aldiwan.net/poem35538.html","الكامل"],[270,"جردت من تلك الجفون سيوفا","https://www.aldiwan.net/poem35430.html","الكامل"],[271,"ضحك تبروق الابرقين تبسما","https://www.aldiwan.net/poem52106.html","الكامل"],[320,"محرز الفضل بالهناء تمتع","https://www.aldiwan.net/poem67119.html","الخفيف"],[349,"أنا في فقدي وجودي","https://www.aldiwan.net/poem15630.html","مجزوء الرمل"],[349,"مر بي بالآب والإبن","https://www.aldiwan.net/poem15641.html","مجزوء الرمل"],[353,"بالفتح لاح لنا الهناء مبشرا","https://www.aldiwan.net/poem40350.html","الكامل"],[371,"لمن القلب المعنى وبمن","https://www.aldiwan.net/poem57040.html","الرمل"],[377,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[403,"تحفة تهدى لمن يهوى عليا","https://www.aldiwan.net/poem33355.html","الرمل"],[403,"تبسم ثغر الدهر وافتى بالبشر","https://www.aldiwan.net/poem33918.html","الطويل"],[409,"يا لائمي أنظر إلى قمر","https://www.aldiwan.net/poem32556.html","أحذ الكامل"],[416,"بلغ الشوق لعمري ما أراد","https://www.aldiwan.net/poem53890.html","الرمل"],[429,"جاءت تميس وقدها الخطار","https://www.aldiwan.net/poem40716.html","الكامل"],[429,"طاف الحباب على حميا الكاس","https://www.aldiwan.net/poem41066.html","الكامل"],[429,"ماست بلدن والأثيث تميم","https://www.aldiwan.net/poem41395.html","الكامل"],[437,"حتام تقطع بالقطيعة والجفا","https://www.aldiwan.net/poem2551.html","الكامل"],[458,"أنذرتني أم سعد أن سعدا","https://www.aldiwan.net/poem56214.html","الرمل"],[458,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[464,"بنحول خصرك والوشاح الجائل","https://www.aldiwan.net/poem3553.html","عموديه"],[482,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[500,"أهل الحجاب مع الثياب عيونهم","https://www.aldiwan.net/poem38061.html","الكامل"],[558,"قضى الأمر وجف القلم","https://www.aldiwan.net/poem34195.html","الرمل"],[558,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[563,"هو الأجل الموقوت لا يتخلف","https://www.aldiwan.net/poem13603.html","الطويل"]],"verses":[["وبخلت عن مفروض حقكُم","فجمعت بين الجبن والخل",0,"ل",1,0],["وبِخلٍّ إذا اختللتُ رعاني","بالذي بيننا من الأسبابِ",1,"ب",1,0],["وَبِخالٍ كادَ يُحَجُّ لَهُ","لَو كانَ يُقَبَّلُ أَسوَدُهُ",2,"د",2,0],["وَبِخَصرٍ أَوهَنَ مِن جَلَدي","وَعَوادي الهَجرِ تُبَدِّدُهُ",2,"د",2,0],["وَبخيلٍ بِالعِرضِ تَصدُرُ مِنهُ","جُمَلُ النَيلِ عَن جَوادٍ بَخيلِ",3,"ل",1,0],["وَبِخَلبِها وَغُرورِها","وَبِبُعدِها وَبِقُربِها",4,"ب",3,0],["وَبَّختَ عَبدَكَ بِالعَمى فَأَفَدتَهُ","بَصَراً وَأَنتَ مُحَسَّنٌ لِعَماكا",5,"ك",2,0],["وَبَخيلٍ يَنالُ مِن عَرضِهِ النا","سُ وَلَكِن رَغيفُهُ لا يُنالُ",6,"ل",1,1],["وبخلتُمُ بُخلَ الضَّني","نِ فحسبُنا قَطراتُ ماء",7,"ا",2,0],["وَبَخيلٌ وَذو سَخاءٍ وَلَولا","بُخلُ هَذا ما قيلَ هَذا كَريمُ",8,"م",1,0],["وَبَخيلٍ تَأكُلُ الأَرضَ شَدّاً","مُلجَماتٍ يَبتَدِرنَ الصِياحا",9,"ح",2,0],["وَبِخُلقٍ مِنَ النبيِّ كريمٍ","لَمْ تُقَاصَصْ بِجرحهَا العَجْماءُ",10,"ا",2,0],["وَبِخَدِّ خَدِّ شَمسٍ","طالَعَت مِن مُزُناتِ",11,"ت",1,0],["وبخلت بالنّصرة الأنصار","وأخرت نجدتها الأمصار",12,"ر",1,0],["وبخيْرِ مَنْ أدّى أمانةَ وحْيهِ","إنّ السّعيدَ على الوَرى لَسَعيدُ",13,"د",1,0],["وبخورا وشاديا من جليد","ونداء : كم في الصلاة فوائد",14,"د",1,0],["وبخسته إن قلتُ في الهيجاءِ والب","أساءِ كالليثِ الهزبرِ الباسلِ",15,"ل",1,0],["وبخَصْره وبنحرِه وبثغرِه","وبهجرِه وببُعدِه وبقدِه",16,"د",2,0],["وبخيلٍ بالوصل أَرسلْتُ دمعي","نحو مَغْناه فارتوت عرصاتُه",17,"ت",2,0],["وَبَخِلْتَ بِالشَّكْوى إِلَيْ","كَ وَأَيُّ عُذْرٍ لِلْبَخِيلِ",18,"ل",1,0],["وَبِخفضِ القدرِ عنهُ اِعترفا","حينَما قالَ لهُ لا تنسَني",19,"ي",1,0],["وَبخيرِ مَن شفّعته يتشفّعُ","خصّصتهُ بشفاعَةٍ لا تُدفعُ",20,"ع",1,0],["وبخلتَ حتى بالرسائ","لِ خوفَ أن تشفيهِ كتبكْ",21,"ك",1,0],["وبخديكِ جنتانِ ولكنْ","في فؤادي لظىً من الجنتينِ",22,"ن",1,0],["وبخست أثمان أعراضها","ولم يك للفضل فيها عميد",23,"د",1,0],["وَبِخِلعَةٍ شَهِدَت بِأَنَّكَ حُزتَ مِن","شَرَفِ الخِلافَةِ أَوفَرَ الأَقسامِ",24,"م",1,0],["وَبَخِلنَ أَن يُسري إِلي مُسَلِّماً","طَيفُ الكَرى فَذَهَبنَ بِالإِغماضِ",25,"ض",1,0],["وَبَخيلَةٍ سَمَحَ الرُقا","دُ بِطَيفِها فَتَأَوَّبا",26,"ب",2,1],["وَبِخَيْرِ الأَرْسَالِطُرّاً وَأَزْكَى","مَنْ أَتَتْ بِأَنْبَائِهِ الأَنْبِيَاءُ",27,"ا",2,0],["وَبِخَيْرِ خَلْقِ اللهِ مَوْ","لاَنَا مُحَمَّدٍ الْوَحِيدْ",28,"د",1,0],["وَبِخْتُكَ يُدْنِي مِنْكَ كُلَّ مُمَنَّعٍ","وَرَأْيُكَ يَنْفِي عَنْكَ ذُلَّ التَّعَشُّقِ",29,"ق",1,0],["وَبَخيلَةٍ بالوَصلِ لَو سَمَحَت بِهِ","لَعَدت صَوارِمُ دونَهُ وَقَواضِبُ",30,"ب",1,0],["وبخاطري ما مرّ غير خيالكم","يا سادتي هل يخطرنّ ببالكم",31,"م",1,0],["وبخصرِك الفاني وصَبري المُنقضي","لا تمنعي من قُبلتَينِ ظريفا",32,"ف",2,0],["وَبخمسة الاقراص أَشبع جيشه","وَسَقى خَميسا من يديه عرمرما",33,"م",2,0],["وَبِخَيرِ الأَسماءِ سَمى فَأَضحى","قالَهُ أَحمَداً أَتى لِمُحَمَّدِ",34,"د",1,0],["وَبَخَلعي لِخَليعٍ","فُزتَ بِاللُبسِ الجَديدِ",35,"د",1,0],["وَبِخَدّي فيهِ نارٌ","رَوضُها آسٌ وَوَردُ",36,"د",1,0],["وَبِخالص التَوفيق جُد مُتفَضّلاً","لِرِجالِ دَولَتِهِ لتتّثق العُرى",37,"ر",2,0],["وبَخيلٍ فإذا جادَ فَما","شِئتَ من سُخطٍ وتَعدِيدٍ ومَن",38,"ن",1,0],["وبخُلفه أبقى الوصيَّ لخَلفِه","موتاً وبعثاً إذ يدانُ بما فعل",39,"ل",1,0],["وبخم قام فيهم خاطباً","تحت أشجار بها كان تقيا",40,"ي",2,0],["وبخّاً له بخّاً إن جده ال","إمامان في أهل المكارم والعصر",41,"ر",1,0],["وبخدِّهِ وَردٌ إذا نَظَرَتْ","عَيني إليه تَناثَر الورَقُ",42,"ق",1,0],["وبخلتُم بخيالِ طارقٍ","لو دنا ما بِتُّ أشكوه البعادا",43,"د",2,0],["وبخلعة العام السعيدة أرّخوا","هنّيتم ما دامت الأدهار",44,"ر",1,0],["وبخده ورد البهار يصونه","خال تستر في رياض الآس",45,"س",1,0],["وبخدها رب الجمال قد استوى","من فوق كرسي لديه نعيم",46,"م",1,0],["وبخبت للإسلام مجدا باقيا","ورفعت ما بين الأنام المصحفا",47,"ف",2,0],["وبخيلٍ خاملٍ أعديتَه","كرماً نال به الحمدَ ومجدا",48,"د",2,0],["وبخُلاء لا تُهنَّا نعمةٌ","هُمُ إليها السُّبْلُ والمَقاصدُ",49,"د",1,0],["وبخيلةٍ ضنَّت فدنتُ بحبها","ومن الشقاوةِ أن أدين لباخل",50,"ل",1,0],["وبخ لمأمومين صار إمامهم","يسمى عظيما في الغيوب القدوسيه",51,"ي",2,0],["وبَخيلُ طبعٍ مُمسِكٌ في عيشِهِ","ولعمِّهِ الإِبْذالُ للبَدَراتِ",52,"ت",1,0],["وبخير ختم الأمر لنا","أننا للدين نحن الخدم",53,"م",1,0],["وبخلَّته وإمامته","لبنيه على مر الحجج",54,"ج",1,0],["وَبَخ بَخ وَبَشِّرِ أُمَّ أَحمَدَ بِالَّذي","يُثَنّى لَها مِن أَجرِهِ وَيُضَعَّفُ",55,"ف",1,0]]}