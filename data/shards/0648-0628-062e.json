{"poems":[[72,"أرسلت بعدكم بجهد نحوكم","https://www.aldiwan.net/poem19616.html","الكامل"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[85,"مضناك جفاه مرقده","https://www.aldiwan.net/poem63667.html","المتدارك"],[45,"يا ابنة العامري عما قليل","https://www.aldiwan.net/poem65557.html","الخفيف"],[49,"دار بليت بحبها خوانة لمحبها","https://www.aldiwan.net/poem10386.html","مجزوء الكامل"],[49,"ما لي رأيتك راكبا لهواكا","https://www.aldiwan.net/poem62207.html","الكامل"],[66,"وبخيل ينال من عرضه النا","https://www.aldiwan.net/poem38594.html","الخفيف"],[97,"راحوا بأرواحٍ ظماء","https://www.aldiwan.net/poem24773.html","مجزوء الكامل"],[52,"طال ليلي وساورتني الهموم","https://www.aldiwan.net/poem26703.html","الخفيف"],[52,"عرف الدار فحيا وناحا","https://www.aldiwan.net/poem27159.html","المديد"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"هام قلبي باللواتي","https://www.aldiwan.net/poem64733.html","مجزوء الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202538","الرجز"],[77,"","https://poetry.dctabudhabi.ae/diwan/poem/71640","الكامل"]],"verses":[["وبخلت عن مفروض حقكُم","فجمعت بين الجبن والخل",0,"ل",1,0],["وبِخلٍّ إذا اختللتُ رعاني","بالذي بيننا من الأسبابِ",1,"ب",1,0],["وَبِخالٍ كادَ يُحَجُّ لَهُ","لَو كانَ يُقَبَّلُ أَسوَدُهُ",2,"د",2,0],["وَبِخَصرٍ أَوهَنَ مِن جَلَدي","وَعَوادي الهَجرِ تُبَدِّدُهُ",2,"د",2,0],["وَبخيلٍ بِالعِرضِ تَصدُرُ مِنهُ","جُمَلُ النَيلِ عَن جَوادٍ بَخيلِ",3,"ل",1,0],["وَبِخَلبِها وَغُرورِها","وَبِبُعدِها وَبِقُربِها",4,"ب",3,0],["وَبَّختَ عَبدَكَ بِالعَمى فَأَفَدتَهُ","بَصَراً وَأَنتَ مُحَسَّنٌ لِعَماكا",5,"ك",2,0],["وَبَخيلٍ يَنالُ مِن عَرضِهِ النا","سُ وَلَكِن رَغيفُهُ لا يُنالُ",6,"ل",1,1],["وبخلتُمُ بُخلَ الضَّني","نِ فحسبُنا قَطراتُ ماء",7,"ا",2,0],["وَبَخيلٌ وَذو سَخاءٍ وَلَولا","بُخلُ هَذا ما قيلَ هَذا كَريمُ",8,"م",1,0],["وَبَخيلٍ تَأكُلُ الأَرضَ شَدّاً","مُلجَماتٍ يَبتَدِرنَ الصِياحا",9,"ح",2,0],["وَبِخُلقٍ مِنَ النبيِّ كريمٍ","لَمْ تُقَاصَصْ بِجرحهَا العَجْماءُ",10,"ا",2,0],["وَبِخَدِّ خَدِّ شَمسٍ","طالَعَت مِن مُزُناتِ",11,"ت",1,0],["وبخلت بالنّصرة الأنصار","وأخرت نجدتها الأمصار",12,"ر",1,0],["وبخيْرِ مَنْ أدّى أمانةَ وحْيهِ","إنّ السّعيدَ على الوَرى لَسَعيدُ",13,"د",1,0]]}