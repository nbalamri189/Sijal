ewPoem.aspx?id=121643",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[5237,"أنوار سيدنا النبي المرسل","https://www.poetsgate.com/ViewPoem.aspx?id=113114",""],[5285,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=203201",""],[5539,"القصه","https://www.poetsgate.com/ViewPoem.aspx?id=196882",""],[2110,"والنجم من فلك النحور إذا هوى","https://www.poetsgate.com/ViewPoem.aspx?id=156289",""],[5689,"حطمت لي يد القضا كل فلس","https://www.poetsgate.com/ViewPoem.aspx?id=143434",""],[5725,"مقلة أوقع ضرباً من حسامِ","https://www.poetsgate.com/ViewPoem.aspx?id=212821",""],[5790,"هزوا القدود وأرهفوا سمر القنا","https://www.poetsgate.com/ViewPoem.aspx?id=111945",""],[5862,"فلّسفة .. أفكار : عطّشانه .. !!!","https://www.poetsgate.com/ViewPoem.aspx?id=31097",""],[5953,"إحدى العجائب خلقة الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=93862",""],[5956,"أنا لم أعد لك هاويا","https://www.poetsgate.com/ViewPoem.aspx?id=182510",""],[6046,"هاجر لتنشئ دولة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=36938",""],[6096,"الحقُّ المسلوب","https://www.poetsgate.com/ViewPoem.aspx?id=177712",""],[6102,"مفعول عكسي !!","https://www.poetsgate.com/ViewPoem.aspx?id=185062",""],[6177,"وهج البُردة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79139&r=&rc=21",""],[6189,"كائن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83579&r=&rc=46",""],[6265,"المهاجرة اليمنية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84177&r=&rc=0",""],[433,"نومة الراعي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87053&r=&rc=6",""],[6314,"المهدية المنتظِرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88075&r=&rc=10",""]],"verses":[["وبخلت عن مفروض حقكُم","فجمعت بين الجبن والخل",0,"ل",1,0],["وبِخلٍّ إذا اختللتُ رعاني","بالذي بيننا من الأسبابِ",1,"ب",1,0],["وَبِخالٍ كادَ يُحَجُّ لَهُ","لَو كانَ يُقَبَّلُ أَسوَدُهُ",2,"د",2,0],["وَبِخَصرٍ أَوهَنَ مِن جَلَدي","وَعَوادي الهَجرِ تُبَدِّدُهُ",2,"د",2,0],["وَبخيلٍ بِالعِرضِ تَصدُرُ مِنهُ","جُمَلُ النَيلِ عَن جَوادٍ بَخيلِ",3,"ل",1,0],["وَبِخَلبِها وَغُرورِها","وَبِبُعدِها وَبِقُربِها",4,"ب",3,0],["وَبَّختَ عَبدَكَ بِالعَمى فَأَفَدتَهُ","بَصَراً وَأَنتَ مُحَسَّنٌ لِعَماكا",5,"ك",2,0],["وَبَخيلٍ يَنالُ مِن عَرضِهِ النا","سُ وَلَكِن رَغيفُهُ لا يُنالُ",6,"ل",1,1],["وبخلتُمُ بُخلَ الضَّني","نِ فحسبُنا قَطراتُ ماء",7,"ا",2,0],["وَبَخيلٌ وَذو سَخاءٍ وَلَولا","بُخلُ هَذا ما قيلَ هَذا كَريمُ",8,"م",1,0],["وَبَخيلٍ تَأكُلُ الأَرضَ شَدّاً","مُلجَماتٍ يَبتَدِرنَ الصِياحا",9,"ح",2,0],["وَبِخُلقٍ مِنَ النبيِّ كريمٍ","لَمْ تُقَاصَصْ بِجرحهَا العَجْماءُ",10,"ا",2,0],["وَبِخَدِّ خَدِّ شَمسٍ","طالَعَت مِن مُزُناتِ",11,"ت",1,0],["وبخلت بالنّصرة الأنصار","وأخرت نجدتها الأمصار",12,"ر",1,0],["وبخيْرِ مَنْ أدّى أمانةَ وحْيهِ","إنّ السّعيدَ على الوَرى لَسَعيدُ",13,"د",1,0],["وبخورا وشاديا من جليد","ونداء : كم في الصلاة فوائد",14,"د",1,0],["وبخسته إن قلتُ في الهيجاءِ والب","أساءِ كالليثِ الهزبرِ الباسلِ",15,"ل",1,0],["وبخَصْره وبنحرِه وبثغرِه","وبهجرِه وببُعدِه وبقدِه",16,"د",2,0],["وبخيلٍ بالوصل أَرسلْتُ دمعي","نحو مَغْناه فارتوت عرصاتُه",17,"ت",2,0],["وَبَخِلْتَ بِالشَّكْوى إِلَيْ","كَ وَأَيُّ عُذْرٍ لِلْبَخِيلِ",18,"ل",1,0],["وَبِخفضِ القدرِ عنهُ اِعترفا","حينَما قالَ لهُ لا تنسَني",19,"ي",1,0],["وَبخيرِ مَن شفّعته يتشفّعُ","خصّصتهُ بشفاعَةٍ لا تُدفعُ",20,"ع",1,0],["وبخلتَ حتى بالرسائ","لِ خوفَ أن تشفيهِ كتبكْ",21,"ك",1,0],["وبخديكِ جنتانِ ولكنْ","في فؤادي لظىً من الجنتينِ",22,"ن",1,0],["وبخست أثمان أعراضها","ولم يك للفضل فيها عميد",23,"د",1,0],["وَبِخِلعَةٍ شَهِدَت بِأَنَّكَ حُزتَ مِن","شَرَفِ الخِلافَةِ أَوفَرَ الأَقسامِ",24,"م",1,0],["وَبَخِلنَ أَن يُسري إِلي مُسَلِّماً","طَيفُ الكَرى فَذَهَبنَ بِالإِغماضِ",25,"ض",1,0],["وَبَخيلَةٍ سَمَحَ الرُقا","دُ بِطَيفِها فَتَأَوَّبا",26,"ب",2,1],["وَبِخَيْرِ الأَرْسَالِطُرّاً وَأَزْكَى","مَنْ أَتَتْ بِأَنْبَائِهِ الأَنْبِيَاءُ",27,"ا",2,0],["وَبِخَيْرِ خَلْقِ اللهِ مَوْ","لاَنَا مُحَمَّدٍ الْوَحِيدْ",28,"د",1,0],["وَبِخْتُكَ يُدْنِي مِنْكَ كُلَّ مُمَنَّعٍ","وَرَأْيُكَ يَنْفِي عَنْكَ ذُلَّ التَّعَشُّقِ",29,"ق",1,0],["وَبَخيلَةٍ بالوَصلِ لَو سَمَحَت بِهِ","لَعَدت صَوارِمُ دونَهُ وَقَواضِبُ",30,"ب",1,0],["وبخاطري ما مرّ غير خيالكم","يا سادتي هل يخطرنّ ببالكم",31,"م",1,0],["وبخصرِك الفاني وصَبري المُنقضي","لا تمنعي من قُبلتَينِ ظريفا",32,"ف",2,0],["وَبخمسة الاقراص أَشبع جيشه","وَسَقى خَميسا من يديه عرمرما",33,"م",2,0],["وَبِخَيرِ الأَسماءِ سَمى فَأَضحى","قالَهُ أَحمَداً أَتى لِمُحَمَّدِ",34,"د",1,0],["وَبَخَلعي لِخَليعٍ","فُزتَ بِاللُبسِ الجَديدِ",35,"د",1,0],["وَبِخَدّي فيهِ نارٌ","رَوضُها آسٌ وَوَردُ",36,"د",1,0],["وَبِخالص التَوفيق جُد مُتفَضّلاً","لِرِجالِ دَولَتِهِ لتتّثق العُرى",37,"ر",2,0],["وبَخيلٍ فإذا جادَ فَما","شِئتَ من سُخطٍ وتَعدِيدٍ ومَن",38,"ن",1,0],["وبخُلفه أبقى الوصيَّ لخَلفِه","موتاً وبعثاً إذ يدانُ بما فعل",39,"ل",1,0],["وبخم قام فيهم خاطباً","تحت أشجار بها كان تقيا",40,"ي",2,0],["وبخّاً له بخّاً إن جده ال","إمامان في أهل المكارم والعصر",41,"ر",1,0],["وبخدِّهِ وَردٌ إذا نَظَرَتْ","عَيني إليه تَناثَر الورَقُ",42,"ق",1,0],["وبخلتُم بخيالِ طارقٍ","لو دنا ما بِتُّ أشكوه البعادا",43,"د",2,0],["وبخلعة العام السعيدة أرّخوا","هنّيتم ما دامت الأدهار",44,"ر",1,0],["وبخده ورد البهار يصونه","خال تستر في رياض الآس",45,"س",1,0],["وبخدها رب الجمال قد استوى","من فوق كرسي لديه نعيم",46,"م",1,0],["وبخبت للإسلام مجدا باقيا","ورفعت ما بين الأنام المصحفا",47,"ف",2,0],["وبخيلٍ خاملٍ أعديتَه","كرماً نال به الحمدَ ومجدا",48,"د",2,0],["وبخُلاء لا تُهنَّا نعمةٌ","هُمُ إليها السُّبْلُ والمَقاصدُ",49,"د",1,0],["وبخيلةٍ ضنَّت فدنتُ بحبها","ومن الشقاوةِ أن أدين لباخل",50,"ل",1,0],["وبخ لمأمومين صار إمامهم","يسمى عظيما في الغيوب القدوسيه",51,"ي",2,0],["وبَخيلُ طبعٍ مُمسِكٌ في عيشِهِ","ولعمِّهِ الإِبْذالُ للبَدَراتِ",52,"ت",1,0],["وبخير ختم الأمر لنا","أننا للدين نحن الخدم",53,"م",1,0],["وبخلَّته وإمامته","لبنيه على مر الحجج",54,"ج",1,0],["وَبَخ بَخ وَبَشِّرِ أُمَّ أَحمَدَ بِالَّذي","يُثَنّى لَها مِن أَجرِهِ وَيُضَعَّفُ",55,"ف",1,0],["وبخمَّ إذ قال الإلهُ بعَزمةٍ","قُمْ يا محمدُ بالولايةِ فاخطُبِ",56,"ب",1,0],["وَبخزيٍ يَبوء كُل رَئيس","كانَ مَعْهُ بحزبه المَكسور",57,"ر",1,0],["وبَخِلتَ الغداةَ حتّى بكَتْبٍ","وأُحاشيكَ عن تَحلٍّ ببخلِ",58,"ل",1,0],["وبخدمة سبقت لوالده الذي","لو سمتمون البيع لن يستنكفا",59,"ف",2,0],["وَبِخَيراتٍ عَلى رَغمَ الحَسود","ما حَلا في مَدحِهِ نَظمُ القَريض",60,"ض",1,0],["وَبِخوضٍ مِنَ الوَغى بِبحور","ماجَ فيها ضَياغِمُ الشّجعانِ",61,"ن",1,0],["وَبَخورُهَا عَبَقُ النخيلِ","يَهيمُ ناشِقهُ دَلالا",62,"ل",2,0],["وبخمر من لماها","حين شرب اسكرتني",63,"ن",2,0],["وبخِيمه المستطرَف ال","مَرْضيِّ جيدُ الفضل حال",64,"ل",1,0],["وبخفقة فرس ابن سهل أحرزت","سبق المدى وكذاك طرف الأسجع",65,"ع",1,0],["وبخصر ممشوقٍ يحكي","عن رقته ذاك البندُ",66,"د",1,0],["وبخسها في الوزن والمكيال","وغبنَها في الحال والمآل",67,"ل",1,0],["وبخصر مثلي نحيف ضعيف","كاد من لينه يحلّ ويعقد",68,"د",1,0],["وَبُخلهم وَالمال غَير باق","وَحرصهم وَالعَيش بِالأَرزاق",69,"ق",1,0],["وَبِخَصرِها هَيَفٌ يُزَيِّنُهُ","فَإِذا تَنوءُ يَكادُ يَنقَدُّ",70,"د",1,0],["وبخدّ مسّه رَدْعُ نَدّ","وبقدٍّ مخجل الغُصن بانِ",71,"ن",1,0],["وَبِخِدْمَةٍ لَكَ لِي أَجَلُّ تَشَرُّفٍ","أَثْوَابُهُ جَلَّتْ عَنِ الأَدْنَاسِ",72,"س",1,0],["وبخروها بعد تطيبها","بكل شيء طيب العرف",73,"ف",1,0],["وبخدِّها في الحالتين نضارةٌ","تحكي شعاع الشمس فوق الماءِ",74,"ا",2,0],["وَبخفضه وَبجزمه","وَبرفعه وَبنصبه",75,"ب",2,0],["وبخده الوردي حبة عنبرٍ","أم نكتةٍ سقطت على وردٍ ندي",76,"د",2,0],["وبخوط قامتها الرقي","ق وريق مبسمها الأغر",77,"ر",1,0],["وبخده نور الجمال تجسدا","رشأ بغير حشاي ليس بقاطن",78,"ن",1,0],["وبخمرٍ كالأرى تنسابُ أخرى","ريحُها المسكُ رُوحُها نشواء",79,"ا",2,0],["وَبخر بِهِ في كل يَومٍ وَلَيلَةٍ","سِبالك تَنأ الجن عَنكَ وَتَفَرق",80,"ق",1,0],["وَبِخَوفِهِ وَيُحُبِّه وَبِعِشقِهِ","مِنكُم لَكُم فِيكُم بِكُم يا مُوجِدى",81,"د",2,0],["وبِخَتمِهِم نَجلِ الرَّسُولِ مُحَمَّدٍ","مَهدِيَّنا الآتِى الإمامِ المُنتَظَر",82,"ر",1,0],["وبخده ولع الشقي","قُ فشفَّ نضرته الذبول",83,"ل",1,0],["وبخده خال كأنَّ سواده","خال بخد شقائق النعمان",84,"ن",1,0],["وَبُخلاً فَلِلَّهِ دَرُّ الطَّوى","إِذا كانَ عِندَهُم مَرتَعي",85,"ع",2,0],["وبِخَيرِ الوَرَى اعتِصَامِي وح