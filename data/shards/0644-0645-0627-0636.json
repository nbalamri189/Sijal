{"poems":[[102,"لا تقل لي","https://www.poetsgate.com/ViewPoem.aspx?id=50110",""],[96,"بدعة الذل","https://www.poetsgate.com/ViewPoem.aspx?id=12816",""],[234,"جرحي بعينيك ليس يندمل","https://www.aldiwan.net/poem50867.html","المنسرح"],[285,"أبا حسن لئن كانت أجابت","https://www.aldiwan.net/poem60736.html","الوافر"],[369,"أتراه بنفسه يذكر المولي","https://www.aldiwan.net/poem60885.html","الطويل"],[376,"بعين الله هجرك لا بعيني","https://www.aldiwan.net/poem57100.html","الوافر"],[422,"هذه يا صاح أوقات الهنا","https://www.aldiwan.net/poem54091.html","الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120010","الكامل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78187","الوافر"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138530",""],[4294,"","https://poetry.dctabudhabi.ae/diwan/poem/142125","الخفيف"],[4483,"","https://poetry.dctabudhabi.ae/diwan/poem/101305","الخفيف"]],"verses":[["لم أضيّع أنا ضميري وخلقي","وكفاني أنّي خسرت الرفاقا",0,"ق",2,0],["لم أضق بالهموم فلبا وهل","ضاق بشتّى عطوره البستان",1,"ن",1,0],["لم أَضْنَ إلا تَشبها بضناً","يشكوه فِي جفنِ عينكِ الكَحَلُ",2,"ل",1,0],["لَما ضاعَ اصْطِناعُكَ فِي كَرِيمٍ","مَلِيٍّ حِينَ تَقْرِضُ بِالْجَزاءِ",3,"ا",2,0],["لم أَضِعْ إذ دَنا المَسيرُ بَلِ ازْدَدْ","تُ ضَياعاً فالهَمُّ يَقدَحُ ناره",4,"ر",2,0],["لماضِي الحَزمِ ماضِي العَزمِ فيها","إذا امتَنَعت منيعَ الجانِبَينِ",5,"ن",1,0],["لم أُضِعْها فرصةً لا سيما","في ختانِ الغُرِّ أبناءِ النقيبْ",6,"ب",1,0],["لما ضفت ظلل الوصالِ وبيننا","عتب كما صفت السالف القرقفُ",7,"ف",1,0],["لِماضي أَمرِهِ في الحال صَدع","وَفي أَقوالِهِ حَث وَرَدع",8,"ع",1,0],["لم أضعتم وصية الله فينا","ونكثتم والعهد منكم قريب",9,"ب",1,0],["لم أضق بالكلام ذرعا ولكن","شدة البغى يستجير الحبالا",10,"ل",2,0],["لم أضع للسلام كفي بصدري","لحبيب سالت عليه عيوني",11,"ن",2,1]]}