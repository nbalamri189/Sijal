{"poems":[[35,"ألا أن نأت سلمى فأنت عميد","https://www.aldiwan.net/poem39165.html","الطويل"],[54,"أفيقي من ملامك يا ظعينا","https://www.aldiwan.net/poem27460.html","الوافر"],[72,"له إذا غازلتك عيناه","https://www.aldiwan.net/poem20512.html","المنسرح"],[51,"أبو عثمان والرومي","https://www.aldiwan.net/poem64019.html","الهزج"],[92,"أظل الوجود المساء الحزين","https://www.aldiwan.net/poem38904.html","المتقارب"],[92,"يقولون صوت المستذلين خافت","https://www.aldiwan.net/poem38912.html","الطويل"],[85,"حبرت مقالة جمعت فأوعت","https://www.aldiwan.net/poem7266.html","الوافر"],[43,"وفاؤكما كالربع أشجاه طاسمه","https://www.aldiwan.net/poem10140.html","الطويل"],[97,"أجل يعلم الحبُّ أني لظاهُ","https://www.aldiwan.net/poem24758.html","المتقارب"],[80,"بجمل حدا الغيران بزل جمائله","https://www.aldiwan.net/poem31331.html","الطويل"],[19,"غني تآوى بأولادها","https://www.aldiwan.net/poem335.html",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54751","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54628","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54537","الطويل"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2244","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54259","الطويل"],[100,"اللّيل الحزين","https://www.poetsgate.com/ViewPoem.aspx?id=50155",""],[100,"أثيم الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=50095",""],[92,"«صَوْتُ المُسْتَذِلِّين خَافِتٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14601&r=&rc=46",""],[128,"بعادك يا عذب الثنايا ولا الصد","https://www.aldiwan.net/poem50635.html","الطويل"],[132,"سبت لبه من بعد كبرته جمل","https://www.aldiwan.net/poem54770.html","الطويل"],[169,"بسمر القنا والمرهفات الصوارم","https://www.aldiwan.net/poem1673.html",""],[186,"حظي من النوم بعد الهجعة الأرق","https://www.aldiwan.net/poem43553.html","البسيط"],[211,"سلام على البحر الخضم وموجه","https://www.aldiwan.net/poem46233.html","الطويل"],[222,"عوارض آس ما أرى أم زبرجد","https://www.aldiwan.net/poem55411.html","الطويل"],[235,"أرقت للمع برق حاجري","https://www.aldiwan.net/poem31628.html","الوافر"],[249,"أليلى على شحط المزار تذكر","https://www.aldiwan.net/poem2118.html","الطويل"],[270,"مني تحب البنات","https://www.aldiwan.net/poem35261.html","المجتث"],[270,"أبعد التقى أهفو إلى هفواتي","https://www.aldiwan.net/poem35583.html","الطويل"],[270,"بكت لفتى يفني قواه تعمدا","https://www.aldiwan.net/poem35632.html","الطويل"],[270,"أمن عربية تشتاق دارا","https://www.aldiwan.net/poem35647.html","الوافر"],[270,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[270,"رأيت الشرق ملكا للنبي","https://www.aldiwan.net/poem35655.html","الوافر"],[275,"أبقت لصحوي من علاقتها نشوى","https://www.aldiwan.net/poem25453.html","الطويل"],[320,"على رأسها الرمان ترغب بيعه","https://www.aldiwan.net/poem67106.html","الطويل"],[328,"على أفقي سحابات","https://www.aldiwan.net/poem54953.html","الهزج"],[342,"شباب العرب بوركتم شبابا","https://www.aldiwan.net/poem55363.html","الوافر"],[349,"بعلم معنى المعاني","https://www.aldiwan.net/poem15883.html","المجتث"],[429,"هو الحب في العشاق ينفذ ما يقضي","https://www.aldiwan.net/poem39881.html","الطويل"],[439,"غدا غير مسعدنا ثم راحا","https://www.aldiwan.net/poem34902.html","المتقارب"],[505,"الوصيّة","https://www.aldiwan.net/poem27795.html","الطويل"],[515,"ولاؤك دين في الرقاب ودين","https://www.aldiwan.net/poem12276.html","الطويل"],[520,"لسعد قدومكم هبّ النسيم","https://www.aldiwan.net/poem815.html",""],[558,"وجود وأشيا ما لهن وجود","https://www.aldiwan.net/poem34627.html","الطويل"]],"verses":[["وَفي صَدرِها صَبٌّ إِذا ما تَدافَعَت","وَفي شَعبِ بَينَ المِنكَبَينِ سُنودُ",0,"د",1,0],["وَفي صَنَمِ المَغارِبِ فَوقَ رَملٍ","تَسيلُ تَلولُهُ سَيلَ السَفينا",1,"ن",2,0],["وفي صفى خدِّه وسالفه","للحسنِ ماء الهوى ومرعاه",2,"ا",2,0],["وفي صوتيَ كالبمّ","وكالزير وكالنَبر",3,"ر",1,0],["وفي صدرِهِ لوعةٌ لا تَقِرُّ","وفي قلبِهِ صَعَقَاتُ المَنونْ",4,"ن",1,0],["وفي صيحَةِ الشَّعْبِ المُسَخَّر زَعْزَعٌ","تَخُرُّ لها شُمُّ العُرُوسِ وتُهْدَمُ",5,"م",1,0],["وفي صدر المؤيد قد تلونا","بحمد الله آيات الهداية",6,"ا",3,0],["وَفي صورَةِ الرومِيِّ ذي التاجِ ذِلَّةٌ","لِأَبلَجَ لا تيجانَ إِلّا عَمائِمُه",7,"م",2,0],["وفي صدرها لهفة للعناق","وفي قلبها جنةُ المغترب",8,"ب",1,0],["وفي صدفِ الأحداجِ مكنونُ لؤلؤٍ","تُكَفّ بأطرافِ الظُّبا كفُّ باذِلِه",9,"ل",2,0],["وَفي صَدرِهِ مِثلُ جيبِ الفَت","ةِ تَشهَقُ حيناً وَحيناً تَهِرّ",10,"ر",1,0],["وَفِي صِفَاتِ بَنِي الدُّنْيَا وَمَا اصْطَلَحُوا","عَلَيْهِ فِي عَهْدِهِمْ مِنْ غَيْرِ مَعْهُودِ",11,"د",1,0],["وَفِي صَمْتِ المَدَافِعِ وَالمَنَايَا","تُهَادِنُ قَدْ يُغَنِّي العَنْدَلِيبُ",12,"ب",1,0],["وَفي صَدْرِهِ بَحْرٌ مِنَ العِلمِ لَمْ يَضِقْ","بِهِ ذَلِكَ الصَّدْرُ الصَّغِيرُ إِنَاءَ",13,"ا",2,0],["وَفي صَدرِهِ مِثلُ جيبِ الفَتا","ةِ تَشهَقُ حيناً وَحيناً تَهِرّ",14,"ر",1,0],["وفي صَدْعَةِ الإيوانِ إنذارُ أمةٍ","بأنَّ من الأشياء ما ليس يُشعَبُ",15,"ب",1,0],["وفي صدره سرّ هذا الوجود","فماذا يذيع وما يكتم ؟",16,"م",1,0],["وفي صدره ندم جائع","يلوك الحنايا ولم يشبع",17,"ع",1,0],["وفي صَيْحَة ِ الشَّعْبِ المُسَخَّر زَعْزَعٌ","تَخُرُّ لَهَا شُمُّ العُرُوشِ، وَتُهْدَمُ",18,"م",1,0],["وفي صدرك المصقولِ رمحٌ محَدَّدٌ","يماثلُه حُقٌّ مِن العاجِ أم نَهْدُ",19,"د",1,0],["وفِي صَدرِهِ نَارٌ مِنًَ الهَمِّ تَلتَظِى","زَوَافِرُهَا تَعلُو وتَسفُلُ إِن تَعلُ",20,"ل",1,0],["وَفي صَهَواتِ الخَيلِ تَدمى نُحُورها","شِفاءٌ لِأَدواءِ القُلوبِ الحَوائِمِ",21,"م",1,0],["وفي صبر على ما بي لمعرفتي","أن الزمان على تخليطه خلقُ",22,"ق",1,0],["وفي صدره عتب عليّ وإنني","لأجهل عمداً عامداً فتنة الصدر",23,"ر",1,0],["وفي صدره بحر من العلم وافر","طويل مديد كامل لا يحدّد",24,"د",1,0],["وَفي صِفّينَ عانَدتُم أَباهُ","وَأَعرَضتُم عَنِ الحَقِّ الجَليِّ",25,"ي",1,0],["وَفي صَدرِهِ أَظمى كَأَنَّ كُعوبَهُ","نَوى القَسبِ عَرّاصُ المَهَزَّةِ أَشَمَرُ",26,"ر",1,0],["وفي صداقةِ بنتٍ","قد تجمُلُ الصَّدَقات",27,"ت",1,0],["وفي صدرِها عرشٌ وكنزٌ لدولةٍ","بَنَتها جيوشُ العربِ مُنتصَرات",28,"ت",1,0],["وفي صَدرِه قلبٌ تلوّى كحيّةٍ","مُجرَّحةٍ تشتاقُ لسعاً مبرّدا",29,"د",2,0],["وفي صَدري حَزازاتٌ وسَيفٌ","يحزُّ القلبَ من علجٍ أغارا",30,"ر",2,0],["وفي صقلّية الآثارُ ما برحت","تبكي التمدُّنَ حيناً والعُلى حينا",31,"ن",2,0],["وفي صدقِ العزيمةِ كلُّ صعبٍ","يهونُ على الشجاعِ الأريحي",32,"ي",1,0],["وَفِي صِلَةِ الإقْطَاعِ مَا آدَ كاهِلِي","حَبَاءً فَهذَا الشكْرُ يَسْعَى لَهُ حَبْوَا",33,"و",2,0],["وَفي صَدرِها ثِنتانَ لَو أَنَّها اِرتَضَت","تَبيعُهُما بِالروحِ كُنتُ أَنا الشاري",34,"ي",1,0],["وفي صدري كآبات","وفي رجليّ أغلال",35,"ل",1,0],["وفي صيحاتكم برق ورعد","وماء المزن ينسكب انسكابا",36,"ب",2,0],["وَفي صِيامي صَلاتي","وَفي الصَلاةِ صِيامي",37,"م",2,0],["وفي صدره بحر العلوم وكفه","سحاب نوالٍ فاض بالكرم النض",38,"ض",1,0],["وفي صَهَوَاتِ الخُيُولِ الرِّجَالَ","ومِنْ أدوَاتِ الرِّجَالِ السِّلاحا",39,"ح",2,0],["وفي صحنِ دارهِا أسجُدي وأطيلي","وفي مرقديها بالعيونِ أجيلي",40,"ي",1,0],["وفي صدر كل من سطاه مهابة","لها بين أحناء الصدور كمين",41,"ن",1,0],["وفيصلنا الذي أحيا رسوماً","لماضيها وكان لها لزيم",42,"م",1,0],["وفي صورة النار الإرادة صورة","وقدرته نحو التراب تقود",43,"د",1,0]]}