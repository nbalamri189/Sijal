id=198833",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5873,"سيف العزيمة","https://www.poetsgate.com/ViewPoem.aspx?id=215412",""],[5977,"تأملات","https://www.poetsgate.com/ViewPoem.aspx?id=213261",""],[5997,"الغَرَّاْءُ","https://www.poetsgate.com/ViewPoem.aspx?id=214276",""],[6102,"مَرسُوم ..","https://www.poetsgate.com/ViewPoem.aspx?id=185051",""],[6115,"من لاحفظ برهم يهبا وتبت يداه","https://www.poetsgate.com/ViewPoem.aspx?id=196465",""],[6125,"جُنَاةُ الأمسِ","https://www.poetsgate.com/ViewPoem.aspx?id=210567",""],[520,"إذا لم يكن بين القلوب صدود","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577472",""],[6167,"بلا ندم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85556&r=&rc=39",""],[6167,"حديث النجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85550&r=&rc=33",""],[5781,"مُدُنٌ فارغةٌ مِنْ وَطَن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87236&r=&rc=3",""]],"verses":[["وَفي صَدرِها صَبٌّ إِذا ما تَدافَعَت","وَفي شَعبِ بَينَ المِنكَبَينِ سُنودُ",0,"د",1,0],["وَفي صَنَمِ المَغارِبِ فَوقَ رَملٍ","تَسيلُ تَلولُهُ سَيلَ السَفينا",1,"ن",2,0],["وفي صفى خدِّه وسالفه","للحسنِ ماء الهوى ومرعاه",2,"ا",2,0],["وفي صوتيَ كالبمّ","وكالزير وكالنَبر",3,"ر",1,0],["وفي صدرِهِ لوعةٌ لا تَقِرُّ","وفي قلبِهِ صَعَقَاتُ المَنونْ",4,"ن",1,0],["وفي صيحَةِ الشَّعْبِ المُسَخَّر زَعْزَعٌ","تَخُرُّ لها شُمُّ العُرُوسِ وتُهْدَمُ",5,"م",1,0],["وفي صدر المؤيد قد تلونا","بحمد الله آيات الهداية",6,"ا",3,0],["وَفي صورَةِ الرومِيِّ ذي التاجِ ذِلَّةٌ","لِأَبلَجَ لا تيجانَ إِلّا عَمائِمُه",7,"م",2,0],["وفي صدرها لهفة للعناق","وفي قلبها جنةُ المغترب",8,"ب",1,0],["وفي صدفِ الأحداجِ مكنونُ لؤلؤٍ","تُكَفّ بأطرافِ الظُّبا كفُّ باذِلِه",9,"ل",2,0],["وَفي صَدرِهِ مِثلُ جيبِ الفَت","ةِ تَشهَقُ حيناً وَحيناً تَهِرّ",10,"ر",1,0],["وَفِي صِفَاتِ بَنِي الدُّنْيَا وَمَا اصْطَلَحُوا","عَلَيْهِ فِي عَهْدِهِمْ مِنْ غَيْرِ مَعْهُودِ",11,"د",1,0],["وَفِي صَمْتِ المَدَافِعِ وَالمَنَايَا","تُهَادِنُ قَدْ يُغَنِّي العَنْدَلِيبُ",12,"ب",1,0],["وَفي صَدْرِهِ بَحْرٌ مِنَ العِلمِ لَمْ يَضِقْ","بِهِ ذَلِكَ الصَّدْرُ الصَّغِيرُ إِنَاءَ",13,"ا",2,0],["وَفي صَدرِهِ مِثلُ جيبِ الفَتا","ةِ تَشهَقُ حيناً وَحيناً تَهِرّ",14,"ر",1,0],["وفي صَدْعَةِ الإيوانِ إنذارُ أمةٍ","بأنَّ من الأشياء ما ليس يُشعَبُ",15,"ب",1,0],["وفي صدره سرّ هذا الوجود","فماذا يذيع وما يكتم ؟",16,"م",1,0],["وفي صدره ندم جائع","يلوك الحنايا ولم يشبع",17,"ع",1,0],["وفي صَيْحَة ِ الشَّعْبِ المُسَخَّر زَعْزَعٌ","تَخُرُّ لَهَا شُمُّ العُرُوشِ، وَتُهْدَمُ",18,"م",1,0],["وفي صدرك المصقولِ رمحٌ محَدَّدٌ","يماثلُه حُقٌّ مِن العاجِ أم نَهْدُ",19,"د",1,0],["وفِي صَدرِهِ نَارٌ مِنًَ الهَمِّ تَلتَظِى","زَوَافِرُهَا تَعلُو وتَسفُلُ إِن تَعلُ",20,"ل",1,0],["وَفي صَهَواتِ الخَيلِ تَدمى نُحُورها","شِفاءٌ لِأَدواءِ القُلوبِ الحَوائِمِ",21,"م",1,0],["وفي صبر على ما بي لمعرفتي","أن الزمان على تخليطه خلقُ",22,"ق",1,0],["وفي صدره عتب عليّ وإنني","لأجهل عمداً عامداً فتنة الصدر",23,"ر",1,0],["وفي صدره بحر من العلم وافر","طويل مديد كامل لا يحدّد",24,"د",1,0],["وَفي صِفّينَ عانَدتُم أَباهُ","وَأَعرَضتُم عَنِ الحَقِّ الجَليِّ",25,"ي",1,0],["وَفي صَدرِهِ أَظمى كَأَنَّ كُعوبَهُ","نَوى القَسبِ عَرّاصُ المَهَزَّةِ أَشَمَرُ",26,"ر",1,0],["وفي صداقةِ بنتٍ","قد تجمُلُ الصَّدَقات",27,"ت",1,0],["وفي صدرِها عرشٌ وكنزٌ لدولةٍ","بَنَتها جيوشُ العربِ مُنتصَرات",28,"ت",1,0],["وفي صَدرِه قلبٌ تلوّى كحيّةٍ","مُجرَّحةٍ تشتاقُ لسعاً مبرّدا",29,"د",2,0],["وفي صَدري حَزازاتٌ وسَيفٌ","يحزُّ القلبَ من علجٍ أغارا",30,"ر",2,0],["وفي صقلّية الآثارُ ما برحت","تبكي التمدُّنَ حيناً والعُلى حينا",31,"ن",2,0],["وفي صدقِ العزيمةِ كلُّ صعبٍ","يهونُ على الشجاعِ الأريحي",32,"ي",1,0],["وَفِي صِلَةِ الإقْطَاعِ مَا آدَ كاهِلِي","حَبَاءً فَهذَا الشكْرُ يَسْعَى لَهُ حَبْوَا",33,"و",2,0],["وَفي صَدرِها ثِنتانَ لَو أَنَّها اِرتَضَت","تَبيعُهُما بِالروحِ كُنتُ أَنا الشاري",34,"ي",1,0],["وفي صدري كآبات","وفي رجليّ أغلال",35,"ل",1,0],["وفي صيحاتكم برق ورعد","وماء المزن ينسكب انسكابا",36,"ب",2,0],["وَفي صِيامي صَلاتي","وَفي الصَلاةِ صِيامي",37,"م",2,0],["وفي صدره بحر العلوم وكفه","سحاب نوالٍ فاض بالكرم النض",38,"ض",1,0],["وفي صَهَوَاتِ الخُيُولِ الرِّجَالَ","ومِنْ أدوَاتِ الرِّجَالِ السِّلاحا",39,"ح",2,0],["وفي صحنِ دارهِا أسجُدي وأطيلي","وفي مرقديها بالعيونِ أجيلي",40,"ل",2,0],["وفي صدر كل من سطاه مهابة","لها بين أحناء الصدور كمين",41,"ن",1,0],["وفيصلنا الذي أحيا رسوماً","لماضيها وكان لها لزيم",42,"م",1,0],["وفي صورة النار الإرادة صورة","وقدرته نحو التراب تقود",43,"د",1,0],["وفي صهيون تذكار مجيد","لعهد سنه عيسى عشيه",44,"ي",2,0],["وفيصل الملك المحبوب دامَ لنا","سُلطانهُ ولهُ ربّ السماءِ رَعا",45,"ع",2,0],["وفي صبغة الرحمن أسرار قدرة","تدور بأمر اللَه في كل دورة",46,"ه",1,0],["وفي صفوها يحلو جميل صفاته","ويثنى عليها في جميع لغاته",46,"ه",1,0],["وفي صورة يأتي الإله كما حكى","خبير روى الأخبار فاستعلنت خبرا",47,"ر",2,0],["وفي صُدْغِهِ اللَّيْليِّ نارُ حُبَاحِبٍ","مِنَ القُرْطِ يَصْلاَهَا حَبَابٌ من العِقْدِ",48,"د",1,0],["وفي صريحِ الإبريزِ لي شُغُلٌ","عن طلبي بَهْرَجاً أُبَرِّزُه",49,"ز",2,0],["وَفي صَباحِ جُمعَة وَصَلنا","لِلبَلَد الَّذي لَهُ قَصدنا",50,"ن",2,0],["وَفي صَباح السَبت يَوم أَبد","مِن بَعد عِشرين لشَهر المَولِدِ",50,"د",1,0],["وَفي صَباحِ يَومِ الاِثنين نَزَل","بأَعلى طَنجَة نعمَ ما فَعَل",50,"ل",1,0],["وفي صرحنا الأحجار ذات ضخامة","بأعمدة تحنى عليهن أضلع",51,"ع",1,0],["وفي صالحاتِ الخَيل إنَّ ظهورَها","مراكبُنا في كلِّ يومٍ نغاوِرُهُ",52,"ر",2,0],["وَفِي صَلاتِي وَصِيامي غَدَت","عَوناً وفِي اليَقظَةِ بَل وَالمَنام",53,"م",1,0],["وفي صفية إذ في حجرها نظرت","بدر السماء دليل أوضح اللقما",54,"م",2,0],["وَفي صحيفةِ قلبي أسطرٌ كُتِبت","منَ الهوى ليس يمحو شرحها عذلُ",55,"ل",1,0],["وفي صفو عيشٍ مستديمٍ وعزّةٍ","تدوم وايامٍ من الخير مفعمَهْ",56,"م",2,0],["وفي صنعه في كافة الأرض أخبروا","إلى الأمم اللاتي شكته التقهقرا",57,"ر",2,0],["وفي صحبة الاخيار كل غنيمة","وربح وفوز ليس يحصيه تعدادي",58,"د",2,0],["وَفي صِغَري تُخَوِّفُني المَنايا","وَما تَجري بِبالِكَ حينَ شِختا",59,"ت",2,0],["وفي صدرك الدامي تهاويل شاعر","معربدةٌ ما بين نهد ومبسم",60,"م",1,0],["وفي صدرها زهرة ناضرة","رأيت بأطرافها دمعتين",61,"ن",1,0],["وَفِيٌّ صفيٌّ ذو حياً وتعفُّفٍ","أغرٌّ لِبَيتِ المكرُماتِ تحلاهُ",62,"ا",2,0],["وَفي صَبري عَلى التَقبيحِ عُذرٌ","إِذا ما كانَ مِن وَجهِ جَميلِ",63,"ل",1,0],["وفَيصَلُ مُرْسَلِي ربِّي شعيبٌ","وذي الرس بنِ حنظل فاخرونا",64,"ن",2,0],["وفي صدر الكتب من كل الاقطار","وراتب في المساجد والمحاضر",65,"ر",1,0],["وفي صوغه من كسره ضعف ماله","من الفك إلا نصف خمس يفضلُ",66,"ل",1,0],["وفي صف النساء تقوم أنثى","إذا عدموا الرجال بهم فتقرا",67,"ر",2,0],["وفي صدره للسرب والروس ثائر ال","ضغائن لم ينفك كالنار مجحما",68,"م",2,0],["وفي صورةِ الأكوان أبصرتُ صاحبي","لذا كثرتْ أسماء حبي في شعري",69,"ر",2,0],["وفي صالح الأعمال زادٌ مبلّغ","وذكرٌ به يبقى الذي هو عامل",70,"ل",1,0],["وفيصل في القضا فصل القضاء به","إذا الخصوم ألدت في تشاجرها",71,"ر",3,0],["وَفي صَدرِها إِن ساعَد اللَه نية","يَهُون عَلَيها مِن تَصَورها البُعد",72,"د",1,0],["وفي صوفر للزائرين موارد","تدفق ايناساً وما ماؤها ثمد",73,"د",1,0],["وفي صفا الراووق عين الخضرا","ماء كذوب الدر حاز الفخرا",74,"ر",2,0],["وفي صُحبة الضدّ الشريفِ تَزيّنٌ","وما الليلُ من جنس النُّجوم الثواقب",75,"ب",1,0],["وفي صدرها علم الديانة واضحا","وآداب خير الخلق ليس لها ند",76,"د",1,0],["وفي صخرة الخِضر التي عند حُوتِها","وفي الحجر المُمْهِي لمُوسى على عَمْدِ",77,"د",1,0],["وفي صلة الإنسان بالناس وحشة","وخلوته بالله مجلبة الأنس",78,"س",1,0],["وفي صبيحةٍ كم شب ناراً","همو بسعيرها أولى صليّا",79,"ي",2,0],["وفي صيدا اقمنا فوق شهر","وعيد النحر وافانا بخير",80,"ر",1,1],["وفي صَدرِهم رَبُّ الوَغى يَستَحِثُّهُم","وإِنيُو تُثِيرُ الشَّغبَ والشَّغبُ ثائرُ",81,"ر",1,0],["وفي صرحه كناته وبناته","ينحن لبهم بعدهم عظم البعد",82,"د",1,0],["وَفِى صَحِيحِ مُسلمٍ مَا أرشَدَا","إلَيهِ وَالضَّرِيرُ فِيهِ أنشَدَا",83,"د",2,0],["وَفي صحُفِ الأَعداءِ دَوماً يُحرِّرُ","فَخُسرانُ هَذا النَوعِ لا يُتَصوَّرُ",84,"ر",1,0],["وفيصل في الورى حلو شمائله","أفديه من فيصل بالعز مشتمل",85,"ل",1,0],["وفيصل بنُ سنبلٍ","في شعره كالبلبلِ",86,"ل",1,1],["وفىّ صفىّ منعم عم جوده","جميع الورى جزل العطا حكمه القسط",87,"ط",1,0],["وفي صبغها القاني حكَت لون قرمزٍ","فهبها بياضاً جالياً كل حمرة",88,"ه",1,0],["وفي صافي الصفاءِ أتى بشيراً","فكان لرهطنا خير البشيرِ",89,"ر",1,0],["وفي صدغها النسرين يأَبى نثارهُ","كما قد رنى الجوريُّ لما رأَى الخدا",90,"د",2,0],["وفي صبا الريح إن هبّت يمانية","عرفٌ عرفنا به نشر الرياحين",91,"ن",1,0],["وفي صدقات السر كم من عظيمةٍ","فطوبى لمن أمسى لدى الخير باغيا",92,"ي",2,0],["وفي صباحٍ وفي رواحٍ","على سرورٍ وفي سعود",93,"د",1,0],["وفي صدف من لحده قلت أرخوا","لقد جل مثوى الميرزا هادي الجواهري",94,"ر",2,0],["وفيصل سمي اللي فتح خط برليف","يوم انعمت عند الرجال البصيره",95,"ر",2,0],["وفيصل تعشقه طيبات السواليف","وتخرم لريحة مستكاه وعبيره",95,"ر",2,0],["وفي صبر أيوب على الضر اجتلي","شكية يعقوب لزائد احزاني",96,"ن",2,0],["وفي صفر لعام بعد هذا","رمى أهل البريمي بالجنود",97,"د",1,0],["وفي صمتِ المساءِ لنا حياةٌ","تحطّمُ قسوةَ الليلِ العتيمِ",98,"م",1,1],["وفي صدري لها مرعى","ومن دمعي لها شرب",99,"ب",1,0],["وفي صوتها لحنٍ على","تغريد ما تْرومه طيور",100,"ر",1,0],["وَفِى (صِهْيُون) صاحِبكُم دَليِل","ووأد الحق فى نخب اللئام",101,"م",1,0],["وفي صرفها أو بعضها الشرك قد أتى","فجانبه واحذر أن تجيء بمؤيد",102,"د",1,0],["وفي صدرها المسمار قد ظل نابتاً","وقد لقيت منها الضلوع انكسارها",103,"ر",3,0],["وفي صدق توحيدي وفقري وفاقتي","إلى العفو مالا ينتقي ثم بالتقي",104,"ق",2,0],["وفي صدرها التفاخ يستأذن أردوف","متسلم القمه ورد ..؟ النصيفه",105,"ف",2,0],["وَفي صبرِ احتمالِ الشوقِ تأتِي","كطيفٍ يسلبُ الألبابَ رِفقَا",106,"ق",2,0],["وَفي صَمْتِ الغِيابِ لنا حُضورٌ","وَيُشْهِدُهُ الغَيوثُ عَلى ثَرايَ",107,"ا",2,0],["وفي صهوات من عناجيج ضمر","تعادي بهم نحو الحصون المنيعةِ",108,"ه",1,0],["وفي صفحة المجد أفعالنا","ومن نورها بدرهُ قد زهى",109,"ا",1,0],["وفي صدري كتاب الله نورٌ","وبرهان السكينة والثباتِ",110,"ت",1,0],["وَفِيْ صَيْفِ أَرْبَعٍ وَتَسْعِيْنَ أَضْرَمَتْ","لَظَىٰ الْحَرْبِ شَبَّتْهَاْ رِيَاحُ التَّجَاْفِيَا",111,"ف",3,0],["وَ فَيصَلًا أَبيَضَ الخَدَّينِ يَلثَمَهُم","فَعادَ لِي أَحمَرَ الخَدَّينِ مَلثُوما ! )",112,"م",2,0],["وفي صدرها تحضنك وتطوقك باليدين","ولا يجيها الضجر من ريح جسمك واذاه",113,"ا",2,0],["وفي صَنَعاءَ مَا عَادَتْ خُطَاهَا","تُزَحزِحَهَا إلى النَّصرِ الوُعُودُ",114,"د",1,0],["وفي صحوة الإثنين سكن جأشها","وشد قواها والبلاء شديد",115,"د",1,0],["وفي صَمتٍ أسوقُ خُطاىَ أَمضى","لضاحِيةِ النجومِ فلا أَتَيتُ",116,"ت",1,0],["وفي صدرِ الحبيبِ وَقد تدانى","رياضٌ للمشوقِ بها العزاءُ",117,"ا",2,0],["وَفي صَمْتِ الغِيابِ لنا حُضورٌ","وَيُشْهِدُهُ الغَيوثُ عَلى ثَرايا",118,"ا",3,0]]}