{"poems":[[110,"حتام يا قلب","https://www.shoaraa.com/p11133",""],[95,"يا حسنها حين تجلت على","https://www.aldiwan.net/poem11300.html","السريع"],[56,"أنا من علمت إذا دعيت لغارة","https://www.aldiwan.net/poem27416.html","الكامل"],[32,"يا دار مية لم يترك لنا علما","https://www.aldiwan.net/poem29601.html","البسيط"],[23,"هل رسم دارسة المقام يباب","https://www.aldiwan.net/poem21246.html","الكامل"],[74,"ومهابة ذابت لها الفرسان ذوب","https://www.aldiwan.net/poem18738.html","الكامل"],[53,"قرأت في وجهك عنوانا","https://www.aldiwan.net/poem66470.html","المنسرح"],[31,"لقد غدوت على الندمان لا حصر","https://www.aldiwan.net/poem6163.html","البسيط"],[91,"قد أسمعتك أنينها الأوطان","https://www.aldiwan.net/poem44941.html","الكامل"],[87,"يا ليلة البال ما خالوك راقصة","https://www.aldiwan.net/poem7877.html","البسيط"],[87,"صداح يا ملك الكنار","https://www.aldiwan.net/poem63754.html","مجزوء الكامل"],[63,"عذر العذول فراح فيك مساعدا","https://www.aldiwan.net/poem51726.html","الكامل"],[68,"في مثل حبكم لا يحسن العذل","https://www.aldiwan.net/poem39928.html","البسيط"],[76,"يا حبذا والبرق يزحف بكرة","https://www.aldiwan.net/poem13191.html","الكامل"],[107,"ركب الرفاق الظاعنين عجالا","https://www.aldiwan.net/poem42127.html","الكامل"],[107,"هل ليم نضو صبابة فأفاقا","https://www.aldiwan.net/poem43377.html","الكامل"],[50,"قد أغتدي والصبح مشهور","https://www.aldiwan.net/poem63411.html","الخفيف"],[50,"خلق الشباب وشرتي لم تخلق","https://www.aldiwan.net/poem64445.html","الكامل"],[50,"حي الديار إذ الزمان زمان","https://www.aldiwan.net/poem66132.html","الكامل"],[52,"وذات دل كأن البدر صورتها","https://www.aldiwan.net/poem24579.html","البسيط"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[119,"في حالة البعد روحي كنت أرسلها","https://www.aldiwan.net/poem41996.html","البسيط"],[185,"يا للرجال هوى أميمة قاتلى","https://www.aldiwan.net/poem58883.html","الكامل"],[240,"ما ذقت قط أمر من أمري","https://www.aldiwan.net/poem31602.html","الطويل"],[272,"جاءوا معاً فيلقاً جأواء مشعلة","https://www.aldiwan.net/poem1139.html",""],[275,"حييتها بقرنفل ممطور","https://www.aldiwan.net/poem35445.html","الكامل"],[285,"أعطى الشباب من الآراب ما طلبا","https://www.aldiwan.net/poem60775.html","البسيط"],[382,"ذلت لعزة دينك الأديان","https://www.aldiwan.net/poem59237.html","الكامل"],[382,"لو كان للأفلاك نطق أو فم","https://www.aldiwan.net/poem59270.html","الكامل"],[416,"طرقتك زائرة فحي خيالها","https://www.aldiwan.net/poem67473.html","الكامل"],[447,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[520,"عادت عليك أهلة الأعياد","https://www.aldiwan.net/poem12061.html","الكامل"],[558,"عجبا لطيف خيالك المتجانب","https://www.aldiwan.net/poem68410.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66749","السريع"],[713,"","https://poetry.dctabudhabi.ae/diwan/poem/104864","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53871","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53917","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70825","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72340","الكامل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101984","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64832","الكامل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115887","البسيط"],[1479,"","https://poetry.dctabudhabi.ae/diwan/poem/20566","الكامل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82585","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101022","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100952","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101021","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101005","السريع"],[1955,"","https://poetry.dctabudhabi.ae/diwan/poem/45417","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69330","الكامل"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20424","البسيط"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71049","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104821","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89517","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53029","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53152","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137067",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93835","الرجز"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127397","الكامل"],[2973,"","https://poetry.dctabudhabi.ae/diwan/poem/107028","السريع"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65122","البسيط"],[3228,"","https://poetry.dctabudhabi.ae/diwan/poem/138836",""],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112335","السريع"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123922","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45781","البسيط"],[3715,"","https://poetry.dctabudhabi.ae/diwan/poem/17483","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59457","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111451","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75714","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86389","الكامل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136949",""],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97078","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90875","الكامل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28927","الكامل"],[4664,"","https://poetry.dctabudhabi.ae/diwan/poem/101169","الكامل"],[4767,"علم الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=178417",""],[4767,"دار الحجة","https://www.poetsgate.com/ViewPoem.aspx?id=199839",""],[5009,"بنت قنا","https://www.poetsgate.com/ViewPoem.aspx?id=24371",""],[3271,"على مذبح الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=103196",""],[5147,"يا ربع زحلة أين عنا","https://www.poetsgate.com/ViewPoem.aspx?id=166758",""],[5397,"يا سائق النوق عن الأربع","https://www.poetsgate.com/ViewPoem.aspx?id=157919",""],[5493,"طعنةُ الآلام","https://www.poetsgate.com/ViewPoem.aspx?id=197008",""],[5561,"آثار مجدك","https://www.poetsgate.com/ViewPoem.aspx?id=192893",""],[5854,"فصحى اللغات","https://www.poetsgate.com/ViewPoem.aspx?id=208608",""],[6096,"الحقُّ المسلوب","https://www.poetsgate.com/ViewPoem.aspx?id=177712",""],[6304,"مهلا ضفاف الرافدين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1612&r=&rc=2",""]],"verses":[["حتى إذا وضعت في الروع ما حملت","أمٌ تنكر من في نصره زعم",0,"م",1,0],["حَتَّى إِذَا وَقْتُ التَّجَلِّي أَتَى","وَضَاقَ بِالأَشْهَادِ رَحْبُ المُقَامْ",1,"م",1,0],["حَتّى إِذا واجَهنَهُ وَلَقينَهُ","حَيَّينَهُ بِبَصابِصِ الأَذنابِ",2,"ب",1,0],["حَتّى إِذا وَجَفَت بُهمى لِوى لَبَنٍ","وَاِبيَضَّ بَعدَ سَوادِ الخُضرَةِ العودُ",3,"د",1,0],["حَتّى إِذا وَرَدوا المَدينَةَ وَاِرتَجَوا","قَتلَ النَبِيِّ وَمَغنَمَ الأَسلابِ",4,"ب",1,0],["حتَّى إذا وجهت نحوك رغبة","سهل الطريق وأمكن المتعذّّر",5,"ر",1,0],["حتى إذا واصلَ صارمْتَه","أو سُمْتَه صدّاً وهجرانا",6,"ن",2,0],["حَتّى إِذا وَضَحَت في الصُبحِ واضِحَةً","جَوزاؤُهُ وَأَكَبَّ الشاةُ يَحتَفِرُ",7,"ر",1,0],["حتى إذا وقفت عن استرضائهم","ظنوا بأن وقوفها عصيان",8,"ن",1,0],["حتى إذا وقفت مالت إلى شرك","من السواعد مأمون لها حدب",9,"ب",1,0],["حَتّى إِذا وَسِعَت مُعا","وِيَةً وَضاقَ بِها عَلي",10,"ل",2,0],["حتى إذا وَقَفَتْ لتَوديعِ النَّوى","في مَوقِفٍ يُدني الجَوى المُتباعِدا",11,"د",2,0],["حَتّى إِذا وَثِقَت نَفسي بِمَوعِدِكُم","وَقُلتُ بُشرايَ زالَ الخَوفُ وَالوَجَلُ",12,"ل",1,0],["حَتّى إِذا وَلّى وَأَسلَمَ عَنوَةً","ماشِئتَ مِن سَهلٍ وَذُروَةِ نيقِ",13,"ق",1,0],["حتّى إذا وَردوا المناصبَ فَخمةً","رَدُّوا الأعِنَّةَ واهنين كُسالى",14,"ل",2,0],["حَتّى إِذا وَضَحَ اليَقينُ تَسَلَّلوا","عُصَباً تَروعُ العاصِفاتِ إِباقا",15,"ق",2,0],["حَتّى إِذا والى لَنا أَربَعاً","وَاِثنَينِ وَالمَجهودُ مَوفورُ",16,"ر",1,0],["حَتّى إِذا وَجَدَتهُ لَم تَرَ عِندَهُ","إِلّا مَجَرَّ إِهابِهِ المُتَمَزِّقِ",17,"ق",1,0],["حَتّى إِذا واجَهنَ إِقبالَ الصَفا","حَنَّ الحَطيمُ وَأَطَّتِ الأَركانُ",18,"ن",1,0],["حَتّى إِذا وَجَدَت ريحي فَأَعجَبَها","وَنَحنُ في خَلوَةٍ مُثِّلتُ إِنسانا",19,"ن",2,0],["حتى إِذا وثِقَتْ بنا","عُجُزُ الحواضِن والخَوادِمْ",20,"م",1,0],["حَتَّى إِذَا وَضَح اليَقِينُ وصدَّقَتْ","دعْوَاكَ آيةُ ربِّكَ المُتَعالِي",21,"ل",2,0],["حتى إذا وادي القرى رحُبت به","رحبت بشلو لُف في أكفان",22,"ن",1,0],["حتى إذا وصلت أعتاب عزتها","تقبل الأرض عني فهي نائبتي",23,"ت",2,0],["حَتّى إِذا وافَيتُ لا بِمُقَصِّرٍ","عمّا رَقَبنَ لهُ ولا بالعاجِلِ",24,"ل",1,0],["حتَّى إِذا وَقَعَ الخَرِيفُ لمسولٍ","فَلِذِى قِضِينَ إِلى بَياضِ جُلاجِلِ",24,"ل",1,0],["حَتّى إِذا وَصَلَ المَشومُ إِلى","نَهرِ المُعَلّى جانِبَ الجِسرِ",25,"ر",1,0],["حتى إذا واجهتهم وهي كالحة","شوهاءُ منها حمامُ الموتِ ينتظرُ",26,"ر",1,0],["حتى إذا وضعت أزاهرَ باقتي","في صَدرها وتلفَّتَت كغرير",27,"ر",1,0],["حَتّى إِذا وَرَدَتْ تَهْفُو قَلائِدَها","أَلْفَتْ أَغَرَّ بِتاجِ الْمَجْدَ مُعْتَصِبا",28,"ب",2,0],["حتى إذا وافيتَ نحوي زائراً","يَحويك مني مَربعٌ وجَنان",29,"ن",1,0],["حتى إذا ولدته طفلاً مرضعاً","بحليبها وهو المقيت المنعِم",30,"م",1,0],["حَتّى إِذا وَرَدَت أَوائِلُ خَيلِهِ","جَيحانَ بَثَّ عَلى العَدُوِّ رِعالَها",31,"ل",3,0],["حتى إذا وقفت بباب جهنم","صاحت وطال بويلها ولوالها",32,"ل",3,0],["حتى إذا وافيت ساحة مجمع","متضايق العرصات بالأشهاد",33,"د",1,0],["حَتّى إِذا وَدَّعنَني أَهدَينَ لي","تَسليمَهُنَّ بِأَعيُنٍ وَحَواجِبِ",34,"ب",1,0],["حتى إذا ولى ابن سعد تبعه","بنفسه قيل ومن كان معه",35,"ه",1,0],["حتى إذا وافى مع الفرانق","من فوره باب أبي الدوانق",35,"ق",1,0],["حتى إذا وارَوْهُ في قبرِه","وانصرفوا من دفِنهِ ضيَّعوا",36,"ع",3,0],["حتى إذا وجدوا لذلك فرصة","وثبوا وسيف عنادهم مسلول",37,"ل",1,0],["حتى إذا وصلتْ إليه بجَمْعِها","صَلَّتْ عليه وسلّمتْ إكْبارَا",38,"ر",2,0],["حتَّى إذا وضُحتْ أعلامُ عِلْمكُمُ","لكلّ مبتعدٍ ناءٍ ومُقْتربِ",39,"ب",1,0],["حتى إذا ولدتْ له","فيقولُ ذا ولدى عَسَى",40,"س",2,0],["حتى إذا وفدت علينا لم تجد","باباً لعمرك مغلقاً من دوني",41,"ن",2,0],["حتى إذا وردت عليه عفاتها","صدرت فطابت مصدراً وورودا",42,"د",2,0],["حتى إِذا وافاكَ فرَّ كأَنَّه","كَلْبٌ إِذا زَأَرَتْ لُيوثُكَ بَصْبَصَا",43,"ص",2,0],["حتى إذا وردت والشمسُ مُصحِيَةٌ","عيونَ موسى أحسَّت بالذى تجدُ",44,"د",1,0],["حَتّى إِذا وَرَدوا المَدينَةَ وَاِرتَدَوا","لِلمَوتِ كُلَّ مَجّرَّب قَضّابِ",45,"ب",1,0],["حَتى إِذا وَطنٌ ناداهُ عَن وَطَن","وَقَلبه بهما صَبٌّ وَمُرتَهَنُ",46,"ن",1,0],["حتى إذا وقف القطار بها على","باب الحديد تلفعت أسمالها",47,"ل",3,0],["حتى إذا وضُحت محجَّتها","وكشفتمُ عن حقِّها الحجُبا",48,"ب",2,0],["حتى إذا وقف النجاء بهم على","شوط العيي وغاية المنهوك",49,"ك",1,0],["حتى إذا وَلّى سوادُ الدجى","ونبَّهته الشمسُ بالمطلع",50,"ع",1,0],["حَتّى إِذا وَجَبَ الصَداقُ تَلَبَّستَ","لَكَ جِلدُ أَغضَفِ بارِزٍ بِصَعيدِ",51,"د",1,0],["حَتّى إِذا وَصَلوا إَلَيكَ وَعَقَّلوا","في جَوزَتيكَ الحائِماتِ الوُرَّدا",52,"د",2,0],["حَتّى إِذا وَرَدَ الغَزوالُ وَانتَبَهَت","لِحِسِّهِ أُمُّ أَجرٍ سِتَّةٍ شُزُنِ",53,"ن",1,0],["حتَّى إِذا وَطِئ المقدَّس وادِياً","يعلو ويشرف سَكْنُهُ ويُقَدَّسُ",54,"س",1,0],["حَتَّى إِذَا وَقَفُوا عِندَ الحَبِيبِ وقَد","باؤٌ بِعَفوِ كَذَا رِضوَانَ مَن عَبَدُوا",55,"د",3,0],["حَتّى إِذا وَرَدَت ماءَ الصَراةِ وَقَد","صارَت لَواحِقَ أَقرابٍ مِنَ الشَغَبِ",56,"ب",1,0],["حتى إذا وضعوا الرحال ببابه","حمدوا إليه صبيحة الإسراء",57,"ا",2,0],["حتى إذا وردت حياض سماحه","لم تلق إلا طافحاً متدفقا",58,"ق",2,0],["حتى اذا ورد البلاد موطداً","اقدامه تابوا الى الاحلام",59,"م",1,0],["حتى إذا وافتك وانتهت إلى","حماه حيث يكرم الطنيب",60,"ب",1,0],["حتى إذا وافى ونال مراده","أتي يجر قلائد العقيان",61,"ن",1,0],["حتى إذا وافته في جحفل","جرار يحكي السيل لما همى",62,"م",2,0],["حتّى إذا وردت عنّي بشائركم","جاءت بإطلاق ذاك الأسر مُبتدرا",63,"ر",2,0],["حتى إذا واصلته ساعةً حُجبت","عنه وأصفت هواها غيرَ محجوب",64,"ب",1,0],["حتى إذا وفيتَ عنك الديوان","من كبدٍ قد أوهنَتها الجراح",65,"ح",1,0],["حتى إذا وفت حقوق وفائها","وعلت بفردوس العلى درجاتها",66,"ت",