{"poems":[[262,"ما للموله من سكره لا يفيق","https://www.aldiwan.net/poem2656.html","المجتث"],[415,"أعاتب فيك الدهر لو أعتب الدهر","https://www.aldiwan.net/poem31861.html","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126722","الطويل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177818","الطويل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126195","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100237","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67980","الطويل"],[4013,"","https://poetry.dctabudhabi.ae/diwan/poem/113660","الطويل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135105","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81682","الطويل"],[4767,"كف الجود","https://www.poetsgate.com/ViewPoem.aspx?id=198231",""],[592,"بهجر أضاء الفجر واستعلن الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128846",""],[5457,"يا صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=213117",""],[5963,"إِذا كنتَ وادي النمل","https://www.poetsgate.com/ViewPoem.aspx?id=187379",""]],"verses":[["لَس بِاللَهِ نَدري دَع كُلَّ حَد مَعَ رَفيق","إِش يَكونُ إِن كان",0,"ن",1,0],["لِسبعٍ مَضتْ من عُمرهِ غالَه الرّدى","وكنتُ أُرجِّي أن يطولَ به العُمْرُ",1,"ر",1,0],["لسبطِ رسول اللّه فخراً تضمّنت","وفيها أبو السجّاد ثاو وراقدُ",2,"د",1,0],["لسبعين عاما بعد عشر وأربع","وست مئين قد تقضت من الزمن",3,"ن",1,0],["لسبعمائة وثلاَث وثَلاَ","ثِينَ من الهجرةِ ثم إر تحَلَ",4,"ل",1,0],["لسب العقارب لا لسبق عداوة","أن العقارب لسَّب من ذاتها",5,"ت",3,0],["لسبعٍ خلتْ منه وعشرون قبلَها","فبارِكْ بِهَا يوماً سيُمْحَى بِهَا الوِزْر",6,"ر",1,0],["لُسِبْتُ من الصُّدغ الجنيِّ بعقربٍ","له بين ورد الوجنتين دبيبُ",7,"ب",1,0],["لسبي البنات الراتعات بدارهم","وجردت سيفا كان غير مجرد",8,"د",1,0],["لسبطِ أبي حفص وصرح علا أبي","محمدٍ السَّامي أبي زكرياءِ",9,"ا",2,0],["لِسِبطَيْ أحمدٍ في الخلد شأنٌ","وما في الخلد يا هذا كهول",10,"ل",1,0],["لسبع من الساعات في غسق الدجى","وقد هجع الأحراس والترك والجند",11,"د",1,0],["لسبيلِ أُنسٍ عندَ شدةِ وحشتي","فتزيلُ دمعًا في الجَنانِ ليسعدا",12,"د",2,0],["لِسَبْعِيْنَ قَرْناً .. وَالصُّرَاخُ مَدَافِعٌ","وَأَنْتَ المُنَادَىٰ والعَتَادُ المَصَائبُ !",13,"ب",1,0],["لِسبْعِيْنَ قَرْنًا .. وَ الحُرُوبُ ، بِطَبْعِهَا","لَدَيْهَا خَيَارَاتٌ وَ أَنْتَ المُنَاسِبُ !",13,"ب",1,0]]}