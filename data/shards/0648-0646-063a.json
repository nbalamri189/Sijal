{"poems":[[55,"نظمنا نظام العقد ودا وألفة","https://www.aldiwan.net/poem29821.html","الطويل"],[55,"تكشف ظل العتب عن غرة العهد","https://www.aldiwan.net/poem30623.html","الطويل"],[65,"ثنى عطفه للبارق المتأجج","https://www.aldiwan.net/poem46140.html","الطويل"],[57,"تحدث عنا في الوجوه عيوننا","https://www.aldiwan.net/poem26121.html","الطويل"],[79,"لبسنا فلم نبل الزمان وأبلانا","https://www.aldiwan.net/poem36041.html","الطويل"],[32,"ما هاج عينيك من الأطلال","https://www.aldiwan.net/poem29544.html","الرجز"],[90,"كان أبو الطيب امرأ قوله","https://www.aldiwan.net/poem44436.html","المنسرح"],[49,"إلى الله أشكو ما أرى من عشائر","https://www.aldiwan.net/poem25324.html","الطويل"],[64,"لنا الأنهار من لبن وخمر","https://www.aldiwan.net/poem52201.html","الوافر"],[68,"رو عظامي بسلا","https://www.aldiwan.net/poem38502.html","مجزوء الرجز"],[46,"خذي عبرات عينك عن زماعي","https://www.aldiwan.net/poem30464.html","الوافر"],[50,"منع الصوم العقارا","https://www.aldiwan.net/poem63295.html","مجزوء الرمل"],[50,"كنت في قرة عيني","https://www.aldiwan.net/poem66168.html","مجزوء الرمل"],[48,"إذا فزعنا فإن الأمن غايتنا","https://www.aldiwan.net/poem22962.html","البسيط"],[79,"نبيت على علم يقين من الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=34136",""],[102,"ذكريات شيخين","https://www.poetsgate.com/ViewPoem.aspx?id=50390",""],[96,"العذراء الخائنة","https://www.poetsgate.com/ViewPoem.aspx?id=15617",""],[136,"رقاب العقل إن لنا ولوعا","https://www.aldiwan.net/poem54805.html","الوافر"],[216,"تغيرت الأوقات وانقبض الدهر","https://www.aldiwan.net/poem37880.html","الطويل"],[228,"وشفيت غلواء من آلامها","https://www.aldiwan.net/poem39706.html","الرجز"],[275,"تعالي نترك النسكا","https://www.aldiwan.net/poem35246.html","مجزوء الوافر"],[287,"تمتع بأنفاس الضحى والأصائل","https://www.aldiwan.net/poem32637.html","الطويل"],[290,"نصول اذا حان الدفاع ولا نرى","https://www.aldiwan.net/poem39402.html","الطويل"],[295,"هناك بذلك العلم","https://www.aldiwan.net/poem11658.html","مجزوء الوافر"],[302,"تذكر والذكرى تهيج أخا الوجد","https://www.aldiwan.net/poem33290.html","الطويل"],[327,"خل قلبي من سليمى نبلها","https://www.aldiwan.net/poem56347.html","الرمل"],[333,"خطرت كالنسمة السكرى","https://www.aldiwan.net/poem55050.html","مجزوء الرمل"],[347,"إلى أين في هذه الفانية","https://www.aldiwan.net/poem55382.html","المتقارب"],[360,"فأبلغ مالكا عني رسولا","https://www.aldiwan.net/poem61026.html","الوافر"],[382,"رأينا من عهودِكم","https://www.aldiwan.net/poem59203.html","مجزوء الوافر"],[409,"نظامك وافانا فضاق به الصدر","https://www.aldiwan.net/poem33735.html","الطويل"],[412,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"],[422,"بكت بدم من بعد عيسى وبندر","https://www.aldiwan.net/poem54120.html","الطويل"],[422,"رمينا بأدهى المعضلات النوائب","https://www.aldiwan.net/poem54172.html","الطويل"],[458,"تنادينا بنكهتها فهيا","https://www.aldiwan.net/poem61298.html","الوافر"],[463,"نقيل مع الدنيا وقد أورقت لنا","https://www.aldiwan.net/poem55852.html","الطويل"],[505,"ونغمة من أيمن الحي أتت","https://www.aldiwan.net/poem37942.html","الرجز"],[556,"يجد بنا صرف الزمان ونهزل","https://www.aldiwan.net/poem47337.html","الطويل"],[556,"تكشف ظل العتب عن غرة العهد","https://www.aldiwan.net/poem47855.html","الطويل"],[563,"نور تلفف بالظلام مكمل","https://www.aldiwan.net/poem34237.html","الكامل"],[590,"لقد سمح الدهر بالمقترح","https://www.aldiwan.net/poem1571.html",""],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59273","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72298","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56240","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112843","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50022","المتقارب"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128083","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49542","المتقارب"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49544","الطويل"],[2480,"","https://poetry.dctabudhabi.ae/diwan/poem/138769",""],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140303",""],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87452","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76448","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69970","الوافر"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147303","الكامل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136412",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139554",""],[4691,"تعويذة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=61409",""],[4797,"ياطير بي جرح","https://www.poetsgate.com/ViewPoem.aspx?id=180550",""],[4869,"نغمة الموبايل","https://www.poetsgate.com/ViewPoem.aspx?id=151536",""],[4927,"غريق","https://www.poetsgate.com/ViewPoem.aspx?id=30189",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5186,"اليسر في العسرى على مقدارها","https://www.poetsgate.com/ViewPoem.aspx?id=156462",""],[5277,"حبيبي الأغرّ","https://www.poetsgate.com/ViewPoem.aspx?id=189722",""],[5277,"صرخةُ العراقيين","https://www.poetsgate.com/ViewPoem.aspx?id=199841",""],[5302,"ليل ونهار","https://www.poetsgate.com/ViewPoem.aspx?id=200550",""],[5302,"في فؤادي ضرام","https://www.poetsgate.com/ViewPoem.aspx?id=201267",""],[5338,"جفني لفقدك سهده فرض","https://www.poetsgate.com/ViewPoem.aspx?id=187597",""],[5344,"إلتقينا","https://www.poetsgate.com/ViewPoem.aspx?id=180697",""],[470,"سلامٌ على بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=178093",""],[5616,"صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=203480",""],[5691,"أزمان مستنسَخة","https://www.poetsgate.com/ViewPoem.aspx?id=206154",""],[5736,"بلا عناق","https://www.poetsgate.com/ViewPoem.aspx?id=208856",""],[5952,"سيرٌ إلى اللا أمام","https://www.poetsgate.com/ViewPoem.aspx?id=212589",""],[5957,"هويتكَ","https://www.poetsgate.com/ViewPoem.aspx?id=12624",""],[5957,"نشيد التفاؤل","https://www.poetsgate.com/ViewPoem.aspx?id=177207",""],[6068,"تسائلني الأوانس كلّ يوم -08-","https://www.poetsgate.com/ViewPoem.aspx?id=175905",""],[6078,"ودارتِ الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=202775",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""],[6225,"انغلاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81727&r=&rc=438",""],[6236,"مرثية حلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81709&r=&rc=17",""],[6259,"عبسن من شعرٍ في الرأس مبتسمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59397&r=&rc=45",""],[6270,"لنا حجرٌ ودون الموت صدرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69080&r=&rc=4",""]],"verses":[["وَنَغتَنِمِ الأَوقاتَ إِنَّ بَقاءَها","كَمَرِّ غَمامٍ أَو كَحِلمِ مَنامِ",0,"م",1,0],["وَنَغتَنِمِ الأَيّامَ فَهيَ طَوائِشٌ","تُواتي بِلا قَصدٍ وَتَأبى بِلا عَمدِ",1,"د",1,0],["ونَغْمَةُ راعي الذّوْدِ يُزْجي إفالَهُ","بدِعْصٍ يُهاديهِ ندىً اللّيلِ أثْبَجِ",2,"ج",1,0],["وَنَغضَبُ أَحياناً وَنَرضى بِطَرفِنا","وَذَلِكَ فيما بَينَنا لَيسَ يُعلَمُ",3,"م",1,0],["وَنَغْتَرُّ بِالآمَالِ وَالعُمْرُ يَنْقَضِي","فَمَا كَانَ بِالرُّجْعَى إِلَى اللَّهِ أَوْلاَنَا",4,"ن",2,0],["وَنَغَضانُ الرَحلِ مِن مُعالِ","عَلى قَرا مَغمومَةٍ شِملالِ",5,"ل",1,0],["ونغمة بالشعور صادحة","وصنعة بالفنون متصّلة",6,"ل",2,0],["وَنَغلِبُ بِالحِلمِ الحَمِيَّةَ مِنهُمُ","وَنَرعى رِجالاً لَيسَ نَرعى لَهُم عَهدا",7,"د",2,0],["ونغسله بماء البحر حتى","يزول ظلاله عنه لحينِ",8,"ن",1,0],["وَنَغمَةُ البُلبُلِ وَال","شَحرورِ وَالمُطَوَّقِ",9,"ق",1,0],["وَنَغمَةُ مُعتَفٍ يَرجوهُ أَحلى","عَلى أُذنَيهِ مِن نَغَمِ السَماعِ",10,"ع",1,0],["وَنُغَنّي ما اِشتَهَينا","هُ مِنَ الشِعرِ جِهارا",11,"ر",2,0],["وَنُغَنّي حينَ نَلهو","لِغَريضٍ وَحُنَينِ",12,"ن",1,0],["وَنَغبَةٌ إِثرَ أُخرى أَطفَأَت ظَمَأً","وَرُبَّ مَلبَسِ دَجنٍ خيطَ مِن قَزَعِ",13,"ع",1,0],["ونغري بما يفنى المطامع والهوى","ونرفض ما يبقى فيا ضيعة العمر",14,"ر",1,0],["ونغني كالسكارى ، قبل ان","يعد العنقود اشواق القدح",15,"ح",1,0],["ونغمة من بعض ألحانها","همس اللّيالي وارتعاش الغصون",16,"ن",1,0],["ونَغمَةٍ شَادِنٍ أحوَى صَرِيعٍ","تَرَى الوَرِعَ الحَلِيم لَهَا صَرِيعَا",17,"ع",2,0],["ونغصني من بؤسهِ بمصيبةٍ","تُمَاثِلُ فعلاً ما تَضَمَّنَهُ الحَشْرُ",18,"ر",1,0],["وَنَغَمُ الجَداوُلِ الرَقراقَه","تَمتَمةُ الطَبيعَةِ المُشتاقَه",19,"ه",1,0],["ونغرَق وسطَ طوفانٍ","ولا نبني لنا فُلكا",20,"ك",2,0],["وَنَغمَةِ شادٍ تَرقُصُ الروحُ كُلَّما","تَرَنَّمَ في أَعضائِنا وَالمَفاصِلِ",21,"ل",1,0],["ونغدو والعرش الحميدي زاهر","نعزز دينا ذل في عصرنا النكد",22,"د",1,0],["ونغسل بالدم القاني","البلاد ونأخذ الثارا",23,"ر",2,0],["وَنَغدو عَلى رَغم الزَمان وقد صَفَت","موارِدُ وَصلٍ رنَّقتها يَدُ البُعدِ",24,"د",1,0],["وَنَغَدّى الضَيفَ مِن شَحمِ الذُرى","مِن سَديفٍ مُشبِعٍ مِنهُ نُعَش",25,"ش",1,0],["ونغنى الموج لحنينا","فيرغى هائجا",26,"ج",2,0],["ونغدو نشاوى متاع الحياة","وتضطرم الشهوة الجانية",27,"ي",2,0],["ونغني في الحوادث عن أخينا","كما تغني اليمينُ عن الشمالِ",28,"ل",1,0],["ونُغضي دونكم عيناً","يسوء النفسَ مرآها",29,"ا",3,0],["ونغفر للدهر المسيء ذنوبه","ونلبس هذا الكون ما نسج الشكر",30,"ر",1,0],["وَنَغمةٌ السَيف أَحلى نَغَمة خُلِقَت","إِذا تَرَنَّم بَعض البيض في اللِمَمِ",31,"م",1,0],["ونغتر بالآمال لا في سرابها","شراب ولا منها ورود لمصدر",32,"ر",1,0],["ونَغْتَرُّ في برق المنى وهو خُلَّبُ","وهيهات ما في الآل ماءٌ لشارب",33,"ب",1,0],["ونغليها فترقص في غرام","وتمنحنا الرحيق الكوثريا",34,"ي",2,0],["ونغترُّ عُجبا بالبقاءِ وإنما","بقاؤك يا مغرورُ ساقَ لك الفنا",35,"ن",2,0],["ونَغْمَةٍ من أيمنِ الحَيِّ أتَتْ","حَكَتْ لنا كيفَ يَذوبُ العاشقُ",36,"ق",1,1],["ونغترّ في الدّنيا برَيْثِ إقامةٍ","ألا إنّما ذاك المقيمُ مُرَحَّلُ",37,"ل",1,0],["ونَغتَنِمُ الأيّامَ وَهْيَ طوائشٌ","تؤاتي بلا قصدٍ وتأبى بلا عَمْدِ",38,"د",1,0],["ونغيب نحن به ويظهر تارة","هو قائمٌ عنا بنا يتمثل",39,"ل",1,0],["ونغَصتَ عَيْشي بترداده","وأَفسدتَ من حالتي ما صلضح",40,"ح",1,0],["وَنَغْمَةِ شُحْرُورٍ وَغُنَّةِ بُلْبُلٍ","وَنَعْبَةِ نَعَّابٍ وَأنَّةِ بَاغِمِ",41,"م",1,0],["ونغفر الذنب ان رام المسيء بنا","عفواً ونستره في حين ينكشف",42,"ف",1,0],["ونغمات ألحان الأغاني سميّةً","ورحب الفضا تبراً ودرّاً وزينةً",43,"ه",1,0],["ونغم أوقات الصفا ومن الوفا","نفوز بحظ وافر ونجملا",44,"ل",2,0],["ونغدو على الروض يُبدي إلينا","عيوناً من النَّور والزَّهر حولا",45,"ل",2,0],["ونغدو باللهام المَجْر يغشى","بلمع البيض منه الناظرينا",46,"ن",2,0],["ونغنى عن الارسال والرسل عاجلا","وندعم أركان العلا ونشيد",47,"د",1,0],["وَنُغْضِي على حُكْم صَرْفِ الزمان","وبين الجوانح جَمْرُ الغَضَا",48,"ا",1,0],["ونغتنمُ الأيامَ وهيَ مصائبٌ","لهنَّ علينا جيئةٌ وَذَهاب",49,"ب",1,0],["ونغل ابن هند ضاحك مترنم","بياليت أشياخي ببدر لتنظرا",50,"ر",2,0],["ونغوص في بحر القريض","لما حواه من الدرر",51,"ر",1,0],["وَنَغُلُّ في ذاك الضرآءِ ومآؤُهُ","وَغصونُهُ وَحمائمٌ بِحِماهُ",52,"ا",2,0],["وَنغمض عَن أَخلاقنا الطرف عندما","نَراها مصابا ظاهرا لعيان",53,"ن",1,0],["وَنغمةُ معمدٍ بَينَ الكِرامِ","وَصَوت العودِ مَع حسوِ المدامِ",54,"م",1,0],["ونغيب في غسق الحياة كأننا","ذر يناجي الصمتَ وهو أسير",55,"ر",1,0],["ونغمة الطائر في ايكة","ولمعة البرق وريا العرار",56,"ر",1,0],["ونغفل عن ذكر الفنا وتبيدنا","على غفلةٍ منّا جيوشُ النوائب",57,"ب",1,0],["ونغرفُ الحب للعشاق نلهمهم","لهم نقيسُ إذا قالوا لنا: قيسوا",58,"س",3,0],["ون غبت عنك اجيك عجل ٍ ومشتاق","كني خليل ٍ مبطي من خليله",59,"ل",2,0],["ونغمة عبادي قالت بروح دقتك","طال السكوت وهو متى بس تحنين",60,"ن",1,0],["وَنُغْنِي الْفَنَّ وَالأَشْعَاْرَ","وَالتَّاْرِيْخَ، وَالأَدَبَاْ",61,"ب",2,0],["ونغرفه دمعا تصعد عن معا","جريح جوى يجري على الخد عندما",62,"م",2,0],["ونغادر الجنات لاستمحالها","ونجاور النيران لاستعمارها",63,"ر",3,0],["ونغمةُ صوتِكَ في مِسْمَعي","طَوالَ النّهارِ وعندَ السَّهَرْ",64,"ر",1,0],["ونُغذي الجوعَ منْ نبضٍ أصيلٍ","وبعضُ الجوعِ في التصبيرِ عذبُ",65,"ب",1,0],["ونغني في فرحة ونمني","أنفسا أجهدت لنلقى مرادا",66,"د",2,0],["ونغني في سكرة ثم ننسى","كل ما فيه حيرة وملام",67,"م",1,0],["وَنَغُضُّ عَمَّا لَيْسَ يُخْرِجُنَا","مِنْ دِينِنَا وَلْيُحْسَنِ الْغَضُّ(١٤)",68,"ض",1,0],["ونغتنم فرحة غرام الملتقين،","لأن فرحتهم بهالدنيا سلَف",69,"ف",1,0],["ونغفو، وتغفو دورُنا مطمئنّةً","وسائُدها طُهرٌ، وطهرٌ لحافُها",70,"ف",3,0],["ونغرق في بحر هذا الإخاء","ومن بئر أسرارنا نغرف!",71,"ف",1,0],[