{"poems":[[53,"نظمنا نظام العقد ودا وألفة","https://www.aldiwan.net/poem29821.html","الطويل"],[53,"تكشف ظل العتب عن غرة العهد","https://www.aldiwan.net/poem30623.html","الطويل"],[63,"ثنى عطفه للبارق المتأجج","https://www.aldiwan.net/poem46140.html","الطويل"],[55,"تحدث عنا في الوجوه عيوننا","https://www.aldiwan.net/poem26121.html","الطويل"],[77,"لبسنا فلم نبل الزمان وأبلانا","https://www.aldiwan.net/poem36041.html","الطويل"],[30,"ما هاج عينيك من الأطلال","https://www.aldiwan.net/poem29544.html","الرجز"],[88,"كان أبو الطيب امرأ قوله","https://www.aldiwan.net/poem44436.html","المنسرح"],[47,"إلى الله أشكو ما أرى من عشائر","https://www.aldiwan.net/poem25324.html","الطويل"],[62,"لنا الأنهار من لبن وخمر","https://www.aldiwan.net/poem52201.html","الوافر"],[66,"رو عظامي بسلا","https://www.aldiwan.net/poem38502.html","مجزوء الرجز"],[44,"خذي عبرات عينك عن زماعي","https://www.aldiwan.net/poem30464.html","الوافر"],[48,"منع الصوم العقارا","https://www.aldiwan.net/poem63295.html","مجزوء الرمل"],[48,"كنت في قرة عيني","https://www.aldiwan.net/poem66168.html","مجزوء الرمل"],[46,"إذا فزعنا فإن الأمن غايتنا","https://www.aldiwan.net/poem22962.html","البسيط"],[77,"نبيت على علم يقين من الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=34136",""],[130,"رقاب العقل إن لنا ولوعا","https://www.aldiwan.net/poem54805.html","الوافر"],[210,"تغيرت الأوقات وانقبض الدهر","https://www.aldiwan.net/poem37880.html","الطويل"],[221,"وشفيت غلواء من آلامها","https://www.aldiwan.net/poem39706.html","الرجز"],[268,"تعالي نترك النسكا","https://www.aldiwan.net/poem35246.html","مجزوء الوافر"],[280,"تمتع بأنفاس الضحى والأصائل","https://www.aldiwan.net/poem32637.html","الطويل"],[283,"نصول اذا حان الدفاع ولا نرى","https://www.aldiwan.net/poem39402.html","الطويل"],[288,"هناك بذلك العلم","https://www.aldiwan.net/poem11658.html","مجزوء الوافر"],[295,"تذكر والذكرى تهيج أخا الوجد","https://www.aldiwan.net/poem33290.html","الطويل"],[320,"خل قلبي من سليمى نبلها","https://www.aldiwan.net/poem56347.html","الرمل"],[326,"خطرت كالنسمة السكرى","https://www.aldiwan.net/poem55050.html","مجزوء الرمل"],[340,"إلى أين في هذه الفانية","https://www.aldiwan.net/poem55382.html","المتقارب"],[353,"فأبلغ مالكا عني رسولا","https://www.aldiwan.net/poem61026.html","الوافر"],[374,"رأينا من عهودِكم","https://www.aldiwan.net/poem59203.html","مجزوء الوافر"],[400,"نظامك وافانا فضاق به الصدر","https://www.aldiwan.net/poem33735.html","الطويل"],[403,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"],[413,"بكت بدم من بعد عيسى وبندر","https://www.aldiwan.net/poem54120.html","الطويل"],[413,"رمينا بأدهى المعضلات النوائب","https://www.aldiwan.net/poem54172.html","الطويل"],[451,"تنادينا بنكهتها فهيا","https://www.aldiwan.net/poem61298.html","الوافر"],[456,"نقيل مع الدنيا وقد أورقت لنا","https://www.aldiwan.net/poem55852.html","الطويل"],[498,"ونغمة من أيمن الحي أتت","https://www.aldiwan.net/poem37942.html","الرجز"],[549,"يجد بنا صرف الزمان ونهزل","https://www.aldiwan.net/poem47337.html","الطويل"],[549,"تكشف ظل العتب عن غرة العهد","https://www.aldiwan.net/poem47855.html","الطويل"],[556,"نور تلفف بالظلام مكمل","https://www.aldiwan.net/poem34237.html","الكامل"],[583,"لقد سمح الدهر بالمقترح","https://www.aldiwan.net/poem1571.html",""]],"verses":[["وَنَغتَنِمِ الأَوقاتَ إِنَّ بَقاءَها","كَمَرِّ غَمامٍ أَو كَحِلمِ مَنامِ",0,"م",1,0],["وَنَغتَنِمِ الأَيّامَ فَهيَ طَوائِشٌ","تُواتي بِلا قَصدٍ وَتَأبى بِلا عَمدِ",1,"د",1,0],["ونَغْمَةُ راعي الذّوْدِ يُزْجي إفالَهُ","بدِعْصٍ يُهاديهِ ندىً اللّيلِ أثْبَجِ",2,"ج",1,0],["وَنَغضَبُ أَحياناً وَنَرضى بِطَرفِنا","وَذَلِكَ فيما بَينَنا لَيسَ يُعلَمُ",3,"م",1,0],["وَنَغْتَرُّ بِالآمَالِ وَالعُمْرُ يَنْقَضِي","فَمَا كَانَ بِالرُّجْعَى إِلَى اللَّهِ أَوْلاَنَا",4,"ن",2,0],["وَنَغَضانُ الرَحلِ مِن مُعالِ","عَلى قَرا مَغمومَةٍ شِملالِ",5,"ل",1,0],["ونغمة بالشعور صادحة","وصنعة بالفنون متصّلة",6,"ل",2,0],["وَنَغلِبُ بِالحِلمِ الحَمِيَّةَ مِنهُمُ","وَنَرعى رِجالاً لَيسَ نَرعى لَهُم عَهدا",7,"د",2,0],["ونغسله بماء البحر حتى","يزول ظلاله عنه لحينِ",8,"ن",1,0],["وَنَغمَةُ البُلبُلِ وَال","شَحرورِ وَالمُطَوَّقِ",9,"ق",1,0],["وَنَغمَةُ مُعتَفٍ يَرجوهُ أَحلى","عَلى أُذنَيهِ مِن نَغَمِ السَماعِ",10,"ع",1,0],["وَنُغَنّي ما اِشتَهَينا","هُ مِنَ الشِعرِ جِهارا",11,"ر",2,0],["وَنُغَنّي حينَ نَلهو","لِغَريضٍ وَحُنَينِ",12,"ن",1,0],["وَنَغبَةٌ إِثرَ أُخرى أَطفَأَت ظَمَأً","وَرُبَّ مَلبَسِ دَجنٍ خيطَ مِن قَزَعِ",13,"ع",1,0],["ونغري بما يفنى المطامع والهوى","ونرفض ما يبقى فيا ضيعة العمر",14,"ر",1,0],["ونَغمَةٍ شَادِنٍ أحوَى صَرِيعٍ","تَرَى الوَرِعَ الحَلِيم لَهَا صَرِيعَا",15,"ع",2,0],["ونغصني من بؤسهِ بمصيبةٍ","تُمَاثِلُ فعلاً ما تَضَمَّنَهُ الحَشْرُ",16,"ر",1,0],["وَنَغَمُ الجَداوُلِ الرَقراقَه","تَمتَمةُ الطَبيعَةِ المُشتاقَه",17,"ه",1,0],["ونغرَق وسطَ طوفانٍ","ولا نبني لنا فُلكا",18,"ك",2,0],["وَنَغمَةِ شادٍ تَرقُصُ الروحُ كُلَّما","تَرَنَّمَ في أَعضائِنا وَالمَفاصِلِ",19,"ل",1,0],["ونغدو والعرش الحميدي زاهر","نعزز دينا ذل في عصرنا النكد",20,"د",1,0],["ونغسل بالدم القاني","البلاد ونأخذ الثارا",21,"ر",2,0],["وَنَغدو عَلى رَغم الزَمان وقد صَفَت","موارِدُ وَصلٍ رنَّقتها يَدُ البُعدِ",22,"د",1,0],["وَنَغَدّى الضَيفَ مِن شَحمِ الذُرى","مِن سَديفٍ مُشبِعٍ مِنهُ نُعَش",23,"ش",1,0],["ونغنى الموج لحنينا","فيرغى هائجا",24,"ج",2,0],["ونغدو نشاوى متاع الحياة","وتضطرم الشهوة الجانية",25,"ي",2,0],["ونغني في الحوادث عن أخينا","كما تغني اليمينُ عن الشمالِ",26,"ل",1,0],["ونُغضي دونكم عيناً","يسوء النفسَ مرآها",27,"ا",3,0],["ونغفر للدهر المسيء ذنوبه","ونلبس هذا الكون ما نسج الشكر",28,"ر",1,0],["وَنَغمةٌ السَيف أَحلى نَغَمة خُلِقَت","إِذا تَرَنَّم بَعض البيض في اللِمَمِ",29,"م",1,0],["ونغتر بالآمال لا في سرابها","شراب ولا منها ورود لمصدر",30,"ر",1,0],["ونَغْتَرُّ في برق المنى وهو خُلَّبُ","وهيهات ما في الآل ماءٌ لشارب",31,"ب",1,0],["ونغليها فترقص في غرام","وتمنحنا الرحيق الكوثريا",32,"ي",2,0],["ونغترُّ عُجبا بالبقاءِ وإنما","بقاؤك يا مغرورُ ساقَ لك الفنا",33,"ن",2,0],["ونَغْمَةٍ من أيمنِ الحَيِّ أتَتْ","حَكَتْ لنا كيفَ يَذوبُ العاشقُ",34,"ق",1,1],["ونغترّ في الدّنيا برَيْثِ إقامةٍ","ألا إنّما ذاك المقيمُ مُرَحَّلُ",35,"ل",1,0],["ونَغتَنِمُ الأيّامَ وَهْيَ طوائشٌ","تؤاتي بلا قصدٍ وتأبى بلا عَمْدِ",36,"د",1,0],["ونغيب نحن به ويظهر تارة","هو قائمٌ عنا بنا يتمثل",37,"ل",1,0],["ونغَصتَ عَيْشي بترداده","وأَفسدتَ من حالتي ما صلضح",38,"ح",1,0]]}