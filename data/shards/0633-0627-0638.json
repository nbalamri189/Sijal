s://www.poetsgate.com/ViewPoem.aspx?id=180050",""],[5618,"قطرات من مطر وعطر","https://www.poetsgate.com/ViewPoem.aspx?id=208934",""],[5628,"حديث مع الطير","https://www.poetsgate.com/ViewPoem.aspx?id=178516",""],[5701,"يا صاحب السيف الذي","https://www.poetsgate.com/ViewPoem.aspx?id=164598",""],[5704,"كَمْ طَالَ لَيْلي","https://www.poetsgate.com/ViewPoem.aspx?id=191157",""],[5803,"لو لا العراق لما ترنم خافقي","https://www.poetsgate.com/ViewPoem.aspx?id=101216",""],[5853,"يا....أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=175691",""],[5897,"يا طيبة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=156357",""],[5897,"فضاءات حمد","https://www.poetsgate.com/ViewPoem.aspx?id=156362",""],[5897,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=156535",""],[5899,"من أجلكِ","https://www.poetsgate.com/ViewPoem.aspx?id=31523",""],[5939,"يغار القلب فاتنتي","https://www.poetsgate.com/ViewPoem.aspx?id=185489",""],[5943,"جيلُ كَسْرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=11260",""],[5943,"قسي الجلمدِ","https://www.poetsgate.com/ViewPoem.aspx?id=34487",""],[5943,"ويلاهُ يامسرى الرسول من الخنا","https://www.poetsgate.com/ViewPoem.aspx?id=45264",""],[5956,"ما إن لمحتُ حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=181972",""],[5956,"أدوية","https://www.poetsgate.com/ViewPoem.aspx?id=183877",""],[5956,"يَدُ بنيَّ مربوطةٌ كعقولنا","https://www.poetsgate.com/ViewPoem.aspx?id=193399",""],[5956,"يقول المحروم","https://www.poetsgate.com/ViewPoem.aspx?id=194109",""],[5956,"أصدقاء خالدون","https://www.poetsgate.com/ViewPoem.aspx?id=194831",""],[5956,"ذكرى حبي الأول","https://www.poetsgate.com/ViewPoem.aspx?id=196838",""],[5956,"الطائر الثرثار","https://www.poetsgate.com/ViewPoem.aspx?id=213433",""],[5957,"أنا لست شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=187339",""],[5974,"فاتِني ما أكْمَلَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=200224",""],[5977,"إلى أخي فهد رحمه الله","https://www.poetsgate.com/ViewPoem.aspx?id=213141",""],[6075,"لقاءٌ ساحرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=204403",""],[6082,"من انا","https://www.poetsgate.com/ViewPoem.aspx?id=59034",""],[6089,"يا ابنَ ابتساماتي","https://www.poetsgate.com/ViewPoem.aspx?id=215727",""],[6120,"أَنَا لَنْ أَقُوْلَ بِأَنَّنِي مُشْتَاْقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215367",""],[6125,"تُدمِي بقلبي هِجرَةٌ وجَفَاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=208593",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[6152,"رمضان","https://www.poetsgate.com/ViewPoem.aspx?id=203276",""],[357,"الوداع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82972&r=&rc=17",""],[6212,"أميرة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1629&r=&rc=10",""],[454,"يئس الصغار من الكبار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82661&r=&rc=25",""],[6287,"محكمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66139&r=&rc=3",""],[6325,"معراج روح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88021&r=&rc=3",""],[5190,"طَرَقات على باب الرحيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78319&r=&rc=32",""],[6343,"ربما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86042&r=&rc=4",""],[6344,"مُرافعةُ مِصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87962&r=&rc=2",""]],"verses":[["سأظلف من نفس بذلت سجودها","وكان حقيقاً أن يصان ركوعها",0,"ع",3,0],["سَأُظهِرُ في هَواكَ إِلَيكَ سِرّي","وَما أَدري أَأُخطِئُ أَم أُصيبُ",1,"ب",1,0],["سَأَظلُّ أمشي رغمَ ذلك عازفاً","قيثارتي مترنِّماً بغنائي",2,"ي",1,0],["سَأَظَلُّ كُلَّ صَبيحَةٍ في مَهمَهٍ","وَأَبيتُ كُلَّ عَشِيَّةٍ في مَنزِلِ",3,"ل",1,0],["سَأَظعَنُ عالِماً أَن لَيسَ بُرءٌ","لِسُقمي كَالوَسيجِ وَكَالذَميلِ",4,"ل",1,0],["سأظل عنوان التقى","وأَعيش عنوان الطهارة",5,"ر",2,0],["سأظل اغني مشتاق","أذعو للقائك وألح",6,"ح",1,0],["سأُظهِرُ أقصَى اليأسَ منهمْ نَزاهةً","وأرضَى بأدْنى العَيشِ والحُرُّ قانع",7,"ع",1,0],["سأظَلُّ أُشْعِلُ في الطَّريقِ قَصائدي","ليرى المُشَاةُ الشَّوك والأشجارا",8,"ر",2,0],["سأظَلُّ أعزُف لحنيَ الباكي على","وَترِ الأَسى لنْ أرحَمَ الأوتارا",8,"ر",2,0],["سأظل صداحا يغرد ههن","وهناك رغم تعقب الأقدار",9,"ر",1,0],["سأظل عاما ناظرا لوداده","حتى يعود لنا من الأسفار",10,"ر",1,0],["سأَظَل أرقُبُ صابراً تحريرهم","من هذه الحشراتِ والأدواءِ",11,"ا",2,0],["سَأظهرُ الشكرَ في طولِ الزمانِ له","لا أَنثني لا ولا عَن ذاك أنحرفُ",12,"ف",1,0],["سأظل اشبه من اضاع مقره","مترردا كالتائه الولهان",13,"ن",1,0],["سأظهر للحساد حد عزيمة","بها من قراع النائبات فلول",14,"ل",1,0],["سأظل جهدا أو أموت","لعل كربى ينجلي",15,"ل",2,0],["سأظفر من دهري بأرغد عيشة","بنعماك إن فاءت علي ظلالها",16,"ل",3,0],["سأظهر في إصلاح شأني تغافلاً","ليعذرني من ظن أني ذو جهل",17,"ل",1,1],["سأظل أخطر كالغريب بجنَّتي","حتى أثوب على قدومك فاقدم",18,"م",1,0],["سأظهر ما عندي من الوجد والضنا","وتجلى إلى الأحباب منّي الحقائقُ",19,"ق",1,0],["سأظل اغني مشتاقا...أذعو للقائك وألح","فلننس مرارة ماضينا...العاشق شيمته الصفح",20,"ح",1,0],["سأظل أتبع حبكم","لأكون جزءاً من ضياك",21,"ك",1,0],["سأظل أنتظر الهدايا حي_","_ن تهفو وردتاكْ",21,"ك",1,0],["سأظل أسكبني بكف_","_ ك علّ تشربني يداك ْ",21,"ك",1,0],["سأظل امدحها وأرفع شأنها","دوما وقلبي للمودة مهيع",22,"ع",1,0],["سأظلُّ أكتبُ فيكَ يا وطني بلا","مَلَلٍ وأنتَ هويتي فليسمعوا",23,"ع",3,0],["سأظلُّ أرتقب الوصال وأرتجي","وأودّع الأشجان حين أراكا",24,"ك",2,0],["سأظل أدعوه بقلبٍ موقنٍ","أن الوفاء مآله الفردوسُ",25,"س",1,0],["سأظل أطمح أن تقيم منهجا","يلقى العدالة عندما يلقاكا",26,"ك",2,0],["سأظلُّ أركضُ في فيافي بُعدِها","طويًا لها أو أنَّ روحي تتلفُ",27,"ف",1,0],["سَأظلُّ وَحْدِي والدُّموُعُ رَسَائلي","واللَّيلُ قافلتي وَصَوتيَ عَاقِرُ",28,"ر",1,0],["سأظلّ مثل الصّخرِ أكسِركُم","لا الخيلُ ترعِبُني ولا الجُندُ",29,"د",1,0],["سأظلُّ ميّالاً لكُلّ هُدىً","وعلى لساني الخيرُ إن قلتُ",30,"ت",1,0],["سأظل ُّ مُنْذهلا ً وأترك ُ بصمتي","في موكب ِ الشّمس التي لا تأفَل",31,"ل",1,0],["سأظلُّ في مُقَلِ المدى","مسجونةً في دربِ بُعدِكْ",32,"ك",1,0],["سَأَظَلُّ أُغَنِّيْكِ نَشِيدًا","يَنْبِعُ مَنْ رُوحِيَ خَلَّابَا",33,"ب",2,0],["سَأَظَلُّ أَسْكُبُ مِنْ جُذُورِ أَصَالَتِي","كَمَسِيِرَةِ الشُّعَرَاءِ..نَبْضُ عَوَائِلِي",34,"ل",2,0],["سأظلُّ في نبضات ِروحِكَ أحْتَمي","ومنَ الجوى بشجون ِحبِّكَ مُنْيتي",35,"ت",2,0],["سأظَلُ ألتقطُ الذرى","عَلِّي أجدْكَ على الثرى",36,"ا",1,0],["سَأظَلُّ أُنْشِدُ للْأحِبَّةِ جَهْرَةً","أسْقِيْ زُهُوْرَ الْحُبِّ عِطْراً منْ دَمِي",37,"م",2,0],["‏سأظل أشدو للبلاد تحية","‏رقراقة حتى أموت وأقبرا",38,"ر",2,0],["سأظلُ رُغمَ مخاوفي في عالمِ","من وحي أحلامي ووهمِ براءتي",39,"ت",2,0],["سَأظَلُّ أَفْخَرُ أنِّني منْ أُمَّةٍ","تَسْمُو بأحْمَدَ فَاسْمُهُ طُغْراءُ",40,"ا",2,0],["سأظل أفخر أنني لك تابع","أرجو حباء الواحد العلام",41,"م",1,0],["سأظل أرسم في وجوه أحبتي","بشرا وأهدي للأنام سرورا",42,"ر",2,1],["سأظلُّ أنتظرُ الرجوعَ لعلَّها","يوماً تعودُ ولا تني بوصالِها",43,"ل",3,0],["سأظلُّ أرتشفُ المرارةَ منْ يدٍ","تسقي الفؤادَ قصائداً لا تنشدُ",44,"د",1,0],["سأظلُّ لا ارضى بغيرِكَ عاشقاً","حتّى تُوسِّدَني حبيبي في الثّرى",45,"ر",2,0],["سأظلُّ أرْقبُ للسّما وَغيومِها","فعَسى سَحاباتُ الحنينِ سَتُمْطِرُكْ",46,"ك",1,0],["سأظلُّ وحْدي للقيامةِ ناطِراً","طيْفاً سيأتيني فشَخْصي يَنْطُرُكْ",46,"ك",1,0],["سأظلُ في ذكراك أشعلُ شمعتي","متعطرا عبق الشذا إذْ يُنشرُ",47,"ر",1,0],["سأظلّ مثل الشمس مشرقة","أهدي القلوب منارة الممشى",48,"ش",2,0],["سأظل أذكر رغم شيبي والخطوب","يوم التقيت بغادة قمر الجنوب",49,"ب",1,1],["سأظل أذكر والحنين يشدُّني","مادام يجري في الفرات الماء",50,"ا",2,0],["سأظل أذكر كل حرف قلتِه","يوم اللقاء وتنتقى الأسماء",50,"ا",2,0],["سأظلُّ أعشقُ فيكَ صبرَ تجاهلي","وأظلُّ أعشقُ حُبَّ مّن يهواني",51,"ن",2,0],["سَأظَلُّ طيْراً في ربوعِكَ صامِتا","إنَّ السُّكوتَ بساحِ حُبِّكَ أرْوَعُ",52,"ع",1,0],["سأظل من ثغر القصيدة ناهلا","والحب يبقى أيكتي وظلالي",53,"ل",2,0],["سأظلُّ أنّى سرتُ أنشدهُ","ما عشتُ حتّى ينقضي العمْرُ",54,"ر",1,0],["سأظل ألمسهم بشع","ري موقظا أو منهضا",55,"ض",2,0],["سَأظلُّ أنتظرُ الرُّجوعَ تمنِّيًا","حتَّى ألاقي ذَا الحبيبَ وأنْعَمُ",56,"م",1,0],["سَأظَلُّ فِيْ عِشْقِ الْعِرَاقِ مُتَيَّمَاً","وَأبُثّ مَا لِلْحُبِّ مِنْ أسْبَابِ",57,"ب",1,0],["سأظل أعزف للهوى نغما","لا لن أظل بدونه وثنا ؟؟",58,"ن",2,0],["سأظلُ أروي حبَهم لقصائدي","وأظل في وصف 