{"poems":[[51,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[70,"أحدثه إذا غفل الرقيب","https://www.aldiwan.net/poem43023.html","الوافر"],[92,"سأعيش رغم الداء والأعداء","https://www.aldiwan.net/poem38976.html","الكامل"],[66,"لمن الشوازب كالنعام الجفل","https://www.aldiwan.net/poem41583.html","الكامل"],[44,"كأني لم أبثكما دخيلي","https://www.aldiwan.net/poem30009.html","الوافر"],[122,"يا ليت إسحق السماره","https://www.aldiwan.net/poem23761.html","مجزوء الكامل"],[350,"الوداع","https://www.aldiwan.net/poem947.html",""],[362,"منحتك فاشكرها مقالة ناصح","https://www.aldiwan.net/poem60846.html","الطويل"],[397,"نار القصيدة","https://www.aldiwan.net/poem6761.html","عموديه"],[447,"يئس الصغار من الكبار","https://www.aldiwan.net/poem995.html",""],[451,"أين الربيع سألت عنه فلم أجد","https://www.aldiwan.net/poem61275.html","الكامل"],[451,"ست من السنوات جاوز عمرها","https://www.aldiwan.net/poem61591.html","الكامل"]],"verses":[["سأظلف من نفس بذلت سجودها","وكان حقيقاً أن يصان ركوعها",0,"ع",3,0],["سَأُظهِرُ في هَواكَ إِلَيكَ سِرّي","وَما أَدري أَأُخطِئُ أَم أُصيبُ",1,"ب",1,0],["سَأَظلُّ أمشي رغمَ ذلك عازفاً","قيثارتي مترنِّماً بغنائي",2,"ي",1,0],["سَأَظَلُّ كُلَّ صَبيحَةٍ في مَهمَهٍ","وَأَبيتُ كُلَّ عَشِيَّةٍ في مَنزِلِ",3,"ل",1,0],["سَأَظعَنُ عالِماً أَن لَيسَ بُرءٌ","لِسُقمي كَالوَسيجِ وَكَالذَميلِ",4,"ل",1,0],["سأظل عنوان التقى","وأَعيش عنوان الطهارة",5,"ر",2,0],["سأظل اغني مشتاق","أذعو للقائك وألح",6,"ح",1,0],["سأُظهِرُ أقصَى اليأسَ منهمْ نَزاهةً","وأرضَى بأدْنى العَيشِ والحُرُّ قانع",7,"ع",1,0],["سأظَلُّ أُشْعِلُ في الطَّريقِ قَصائدي","ليرى المُشَاةُ الشَّوك والأشجارا",8,"ر",2,0],["سأظَلُّ أعزُف لحنيَ الباكي على","وَترِ الأَسى لنْ أرحَمَ الأوتارا",8,"ر",2,0],["سأظل صداحا يغرد ههن","وهناك رغم تعقب الأقدار",9,"ر",1,0],["سأظل عاما ناظرا لوداده","حتى يعود لنا من الأسفار",10,"ر",1,0],["سأَظَل أرقُبُ صابراً تحريرهم","من هذه الحشراتِ والأدواءِ",11,"ا",2,0]]}