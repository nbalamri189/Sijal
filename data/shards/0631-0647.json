لهَجرِ وَالبَينِ",0,"ن",1,0],["رَهَنتُهُ قَلبي وَمَن","يَرهُنُ قَلباً أَبَدا",1,"د",2,0],["رَهَباً فَعَافٍ شَاقَهُ بَذْلُ النَّدَى","رَاجٍ وَطَاغٍ سَاقَهُ اسْتِعْفَاءُ",2,"ا",2,0],["رُهبانُ مَديَنَ وَالَّذينَ عَهِدتُهُم","يَبكونَ مِن حَذَرِ العَذابِ قُعودا",3,"د",2,0],["رَهينَةُ رَمسٍ قَد تَجُرُّ ذُيولُها","عَلَيهِ سَوافي الرامِساتِ البَوارِحِ",4,"ح",1,0],["رَهينُ بِلىً وَكُلُّ فَتىً سَيَبلى","فَأَذري الدَمعَ بِالسَكبِ المَجودِ",5,"د",1,0],["رهط إذا كانت مباسطة الصبى","فيهم فهم في الجد جد كبار",6,"ر",1,0],["رَهَنَ الحَيَاةَ بِعِزِّهَا فَإِذَا","هَانَتْ فَمَا لِحَيَاتِهِ ثَمَنُ",7,"ن",1,0],["رَهِينُكِ وَضَّاحٌ ذَهَبتِ بِعَقلِهِ","فَإِن شِئتِ فَأَحييهِ وَإِن شِئتِ فَاقتُلِي",8,"ل",2,0],["رَهاءٍ بَساطِ الظَهرِ سِيٍّ مَخوفَةٍ","عَلى رَكبِها إِقلاتُها وَضَلالُها",9,"ل",3,0],["رَهطُ الفَرَزدَقِ مِن نَصارى تَغلِبٍ","أَو يَدَّعي كَذِباً دَعاوَةَ زورِ",10,"ر",1,0],["رُهبانُ مَديَنَ لَو رَأوكِ تَنَزَّلوا","وَالعُصمُ مِن شَعَفِ العُقولِ الفادِرِ",11,"ر",1,0],["رهنت في الحبّ نومي عند ناظره","لما اقترضت لجسمي منه أسقامي",12,"م",2,0],["رَهِلُ المحاجر والجفون ترى له","وجهاً يؤكِّدُ قُبحَهُ بقُطوبِ",13,"ب",1,0],["رهبةً للإله بل رغبةً من","ك بقدرٍ عن الخنا مرفوعِ",14,"ع",1,0],["رَهينَةُ قَعرِ البَيتِ كُلَّ عَشِيَّةٍ","يُطيفُ بِيَ الوِلدانُ أَهدُجُ كَالرَألِ",15,"ل",1,0],["رَهينَ الرَمسِ حَدَّثَني مَلِيّاً","حَديثَ المَوتِ تَبدُ لِيَ العِظاتُ",16,"ت",1,0],["رَهطُ سابورَ ذي الجُنودِ وَطُلّا","بُ مَساعي سابورَ ذي الأَكتافِ",17,"ف",1,0],["رَهَنتُ بَني السيدِ الأَشائِمِ موفِياً","بِمَقتولِهِم عِندَ المُفاداةِ غالِيا",18,"ي",2,0],["رَهطُ النَبِيِّ وَهُم مَأَوى كَرامَتِهِ","وَناصِرو الدينِ وَالمَنصورُ مَن نَصَروا",19,"ر",3,0],["رَهطُ الرَسولِ الَّذي تَقَطَّعُ أَس","بابُ البَرايا غَداً سِوى سَبَبِه",20,"ب",2,0],["رهينةُ تكويرٍ وكسفٍ كأنها","رغيفُ غلاءٍ أو كقرصِ حديدِ",21,"د",1,0],["رَهينَ بِلىً قَد حَلَّ في جَوف حُفرَةٍ","يُسَدُّ عَلَيها بِالرجام وَيُردَمُ",22,"م",1,0],["رَهطُ اِبنِ جَحشٍ في الخُطوبِ أَذِلَّةٌ","دُسمُ الثِيابِ قَناتُهُم لَم تُضرَسِ",23,"س",1,0],["رُهْبانُ لَيْلٍ أُسْدُ حَرْبٍ لم تَلِج","إِلَّا القَنا يَوْمَ الكَرِيهَةِ غِيلا",24,"ل",2,0],["رَهبَةً أَو رَغبَةً في وُدِّهِ","إِنَّهُ إِن شاءَ أَحلى وَأَمَر",25,"ر",1,0],["رَهطُها شُهَّدٌ وَجيرانُها سُه","دٌ إِلَينا وَقَلبُها مِن حَديدِ",26,"د",1,0],["رَهيناً بِالَّذي لاقَي","تُ بَينَ الرَغبِ وَالرَهبِ",27,"ب",1,0],["رَهطُ اِبنِ كُوزٍ مُحقِبي أَدراعِهِم","فيهِم وَرَهطُ رَبيعَةَ بنِ حُذارِ",28,"ر",1,0],["رَهَنْتُ قَميصي عِندهُ وَهوَ فَضْلَةٌ","من المُزْنِ يُعْلى ماؤها برَماد",29,"د",1,0],["رَهْطُ حَلْوَانَ لَمْ يَكَدْ مِنْكَ يحْظَى","بِلِقَاءٍ حَتَّى تَلاَهُ الفِرَاقُ",30,"ق",1,1],["رَهْطٌ إِذَا كَانتْ مُبَاسَطَةُ الصِّبَا","فِيهِمْ فَهُمْ فِي الجِدِّ جِدُّ كِبَارِ",31,"ر",1,0],["رَهينُ حُزنٍ أَبوكَ حَتّى","يَلقاكَ في مَنزِلِ القَرارِ",32,"ر",1,0],["رَهْبةٌ تَملأُ الْجَوانِحَ رُعْباً","وأَدِيمٌ وَعْرٌ كحدِّ النِّصَالِ",33,"ل",1,0],["رهباً فعافٍ شاقَهُ بذلُ النَّدا","راج وطاغ ساقه استعفاءُ",34,"ا",2,0],["رهطُ ابنِ كوزٍ أدراعهم ،","فيهمْ، ورهطُ ربيعة َ بنِ حُذارِ",35,"ر",1,0],["رهنَ الاشارة تختفي أو تعتَلي","وينالُ منها السَلْبُ والإيجاب",36,"ب",1,0],["رهنتُها عند فجِّ الطَّبْعِ محتقنٍ","بغيرِ صُمِّ العوالي غيرِ مجذوب",37,"ب",1,0],["رة ِ لو سالم الدهرُ إقبالها","تخيّر إفريقيا تاجَه",38,"ه",1,0],["رهصتها بالحيا حتى اذا","لصقت حر ثراها بحياها",39,"ا",3,0],["رَهينَةَ قَعرِ البَيتِ كُلَّ عَشِيَّةٍ","كَأَنّي أُراوى أَن أُصَوَّبَ في مَهدِ",40,"د",1,0],["رَهِبوا أَن يَكونَ حَربُكَ لِلمُل","كِ اِنتِهاءً فَاِستَعطَفوكَ اِبتِداءَ",41,"ا",2,0],["رَهطٌ نَضَوا بيضَ السُيوفِ وَآخَرٌ","قَد جَرَّ قَوساً لَيسَ فيها مَنزِعُ",42,"ع",1,0],["رَهبَةً مِن نِضالِهِ وَإِلى الآ","سادِ قِدماً تَنَجُّلُ الأَشبالِ",43,"ل",1,0],["رَهِينَةُ قَلبِي فِي يَدَيكَ وَدِيعَةٌ","وكَفِّيَ مِن قَلبِي ومِن حُبِّهِ صِفرُ",44,"ر",1,0],["رَهْطُ الرُّوَيْبِضَة انْبَروا وتجبّروا","أنَّ الجَهالةَ منهمُ تتخرَّجُ",45,"ج",1,0],["رَهِبوهُ فَصانَعوا بالهدايا","كي يُنحّي عنهم جيوشَ المنايا",46,"ي",2,0],["رَهِلٌ زَمَخرٌ إِذا الشَمسُ ذَرَت","خَضِلَت في ظِلالِهِ الأَنداءُ",47,"ا",2,0],["رَهْطُ نَبِيِّ الهُدَى وأُسْرَتُه","والخلفاءُ الأئمَّةُ الذُّلُل",48,"ل",1,0],["رهطُ النّبِيّ وآلُه وبنوه مِن","دون البنين ونَبْتُه مُتَرَعْرِعا",49,"ع",2,0],["رَهنُ بَيتٍ لَيلُهٌ في","هِ سَواءٌ وَنَهارُه",50,"ر",2,0],["رَهناً عَلى حِفظِ المَوَد","دَةِ لي وَهَبها قَوسَ حاجِب",51,"ب",1,0],["رَهينَ بِلىً وَكُلُّ فَتىً سَيَبلى","فَأَذري الدَمعَ وَاِنتَحِبي اِنتِحابا",52,"ب",2,0],["رَهْطِ السَّماحِ وَفِيهِمْ طابَ مَوْلِدُهُ","إِنَّ السَّماحَ يَمانٍ كُلَّما انْتَسَبا",53,"ب",2,0],["رهنت ثيابي وحال القضا","ء دون القضاء وصد القدر",54,"ر",1,0],["رَهبٌ عَرَندَسَةٌ حَرفٌ مُذَكَّرَةٌ","فَكُلُّ أَخفافِها مَلثومَةٌ لُطُسُ",55,"س",1,0],["رُهِنتَ يا قَلبُ فَمَن ذا الَّذي","يَقبِضُ دَينَ الراهِنِ الخاسِرِ",56,"ر",1,0],["رَهينَةُ أَحجارٍ بِبَيداءَ دَكدَكِ","تَولَّت فحلَّت عروَةَ المُتمسِّكِ",57,"ك",1,1],["رهبانه نور الخلائق كلِّهم","وعلى تقاهم كلُّ فضلٍ يشهد",58,"د",1,0],["رهنْتُكَ قَلبي وحُكْمُ القُلو","بِ إذا رُهِنَتْ أنَّها تُغْلَقُ",59,"ق",1,0],["رهَينةِ كلِّ همٍّ مستكينٍ","ونُهزةِ كلِّ خطبٍ مستطيلِ",60,"ل",1,0],["رَهناً بإِلقاءِ اليدَيْنِ لقاهِرٍ","أَعلى يَدَيهِ الواحِدُ القهَّارُ",61,"ر",1,0],["رهط النبي نبي الآله عليهم","سقف الهدى ومن القرآن عمودا",62,"د",2,0],["رهنتُك رِقِّي عنه حبّاً ومهجتي","وكان عزيزا أن يباعا ويُرهنا",63,"ن",2,0],["رَهَباً لأغْلبَ لا مفرَّ لهاربٍ","منه ولو أنَّ النجومَ وِقاءُ",64,"ا",2,0],["رَهينٌ بِنَفسي لَم تُفَكُّ كُبولُهُ","عَنِ الساقِ حَتّى جَرَّدَ السَيفَ قاتِلُه",65,"ل",2,0],["رهْطٌ بهم شرَفُ الأنامِ وعنهُمُ","نُقِلَتْ أصولُ الذِّكرِ والتّحميدِ",66,"د",1,0],["رهْطٌ بهِم طابَتْ وزادَتْ يثرِبٌ","شرَفاً وعزّتْ أوسُها والخزرَجُ",67,"ج",1,0],["رهينُ قُوىً على خدّيه تجري","سوابِقُ دمعِه جرْيَ الرِّهانِ",68,"ن",1,0],["رَهنَ رَمسٍ بِبُهرَةٍ أَو حَزيزٍ","يا لَقَومٍ لِميّتِ المَدفونِ",69,"ن",1,0],["رهينُ رزايا ما يُمَلُّ طروقُها","ومُلّ طروقي في مدىً متطاولِ",70,"ل",1,0],["رَهْبٌ ورَغْبٌ عنده","فكأنّه شمسٌ وطَلُّ",71,"ل",1,0],["رَهنَ الحُرورِيّينَ قَد صُرِيتُ","صَمّاءَ صُمٍّ طَيرُها سُكوتُ",72,"ت",1,0],["رَهَنَت فُؤادي في هَواها لِمُدَّةٍ","فَلَم يُغنِ عَنهُ عِندَ نَفسي مُرورُها",73,"ر",3,0],["رَهنتُك قَلبي بالمواعديِ 