{"poems":[[53,"غزال ماطل ديني","https://www.aldiwan.net/poem29739.html","الهزج"],[53,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[77,"وسواس حليك أم هم الرقباء","https://www.aldiwan.net/poem36791.html","الكامل"],[35,"ولقد لقيت على الدريجة ليلة","https://www.aldiwan.net/poem39168.html","الكامل"],[10,"جرى لي طير في حمام حذرته","https://www.aldiwan.net/poem21067.html","الطويل"],[10,"أهاج لك الدموع على ابن عمرو","https://www.aldiwan.net/poem21073.html","الوافر"],[93,"وافى الحديث إلى غريب الدار","https://www.aldiwan.net/poem11068.html","الكامل"],[93,"يا مصر أنت الأهل والسكن","https://www.aldiwan.net/poem11174.html","أحذ الكامل"],[41,"أيا روضة الوضاح يا خير روضة","https://www.aldiwan.net/poem42363.html","الطويل"],[30,"دنا البين من مي فردت جمالها","https://www.aldiwan.net/poem29539.html","الطويل"],[27,"سقيا لنهي حمامة وحفير","https://www.aldiwan.net/poem5737.html","الكامل"],[27,"طرب الحمام بذي الأراك فهاجني","https://www.aldiwan.net/poem5781.html","الكامل"],[72,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[51,"ما كنت في بخس الجزاء بمشبه","https://www.aldiwan.net/poem8510.html","الكامل"],[51,"أول الشهر أول الأسبوع","https://www.aldiwan.net/poem65040.html","الخفيف"],[14,"أليس ورائي أن أدب على العصا","https://www.aldiwan.net/poem38288.html","الطويل"],[85,"ممات في المواكب أم حياة","https://www.aldiwan.net/poem62910.html","الوافر"],[45,"ألما فات من تلاق تلاف","https://www.aldiwan.net/poem65153.html","الخفيف"],[28,"غدوت وقد أزمعت وثبة ماجد","https://www.aldiwan.net/poem5653.html","الطويل"],[58,"قد يعلم الناس أنا خيرهم نسبا","https://www.aldiwan.net/poem31035.html","البسيط"],[44,"إن بكاء في الدار من أربه","https://www.aldiwan.net/poem30574.html","المنسرح"],[69,"أراك على ما فيك تبلغني الأذى","https://www.aldiwan.net/poem28425.html","الطويل"],[105,"إلام تجن الحادثات وتظلم","https://www.aldiwan.net/poem43423.html","الطويل"],[22,"ولقد رأيتك في النساء فسؤتني","https://www.aldiwan.net/poem21658.html","الكامل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[50,"يا لقوم للحبيب المذكر","https://www.aldiwan.net/poem63802.html","الرمل"],[50,"اشفعي لي صريم عند الكنود","https://www.aldiwan.net/poem63937.html","الخفيف"],[50,"دعاك الحب بالشعب","https://www.aldiwan.net/poem64830.html","الهزج"],[7,"نبئت زرعة والسفاهة كاسمها","https://www.aldiwan.net/poem1995.html","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16679","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55061","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54946","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43841","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[77,"وسواسُ حليكِ أم هم الرقباءُ","https://www.poetsgate.com/ViewPoem.aspx?id=3296",""],[7,"نبئتَ زرعة َ ، والسفاهة ُ كاسمها","https://www.poetsgate.com/ViewPoem.aspx?id=17567",""],[90,"المجلس المفجوع","https://www.poetsgate.com/ViewPoem.aspx?id=179038",""],[90,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[85,"جعلتُ حُلاها وتمثالها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9586&r=&rc=76",""],[115,"رب دار بالغضا طال بلاها","https://www.aldiwan.net/poem40433.html","عموديه"],[131,"فإن يك رأسي كالثغامة نسله","https://www.aldiwan.net/poem24160.html","الطويل"],[143,"عاذ بالصفح من أَحب البقاء","https://www.aldiwan.net/poem11716.html","الخفيف"],[143,"هل للأماني عن جنابك مدفع","https://www.aldiwan.net/poem11771.html","الكامل"],[143,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[150,"ردوا عبرة تهمي كما انهمل القطر","https://www.aldiwan.net/poem68567.html","الطويل"],[178,"ضاقت","https://www.aldiwan.net/poem50705.html","الكامل"],[189,"سيد الرسل قدره معلوم","https://www.aldiwan.net/poem35108.html","الخفيف"],[195,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[229,"جرحي بعينيك ليس يندمل","https://www.aldiwan.net/poem50867.html","المنسرح"],[229,"الشوق يستسقي العيون الأدمعا","https://www.aldiwan.net/poem50953.html","الكامل"],[235,"بأبي وجه هلال","https://www.aldiwan.net/poem31976.html","مجزوء الرمل"],[235,"يا ابن الأكابر من ذؤا","https://www.aldiwan.net/poem32155.html","مجزوء الكامل"],[249,"أسائلة عميرة عن أبيها","https://www.aldiwan.net/poem2129.html","الوافر"],[280,"أعطى الشباب من الآراب ما طلبا","https://www.aldiwan.net/poem60775.html","البسيط"],[316,"فداؤك نفسي من الحادثات","https://www.aldiwan.net/poem69436.html","المتقارب"],[322,"بان الخليط فقلبي اليوم مختلس","https://www.aldiwan.net/poem56356.html","البسيط"],[366,"واصل طيف الحب كالهاجر","https://www.aldiwan.net/poem16988.html","السريع"],[371,"رهينة أحجار ببيداء دكدك","https://www.aldiwan.net/poem57249.html","الطويل"],[377,"قالت إليك فقلت طرفي أرمد","https://www.aldiwan.net/poem66873.html","الكامل"],[405,"بنفسي أخ نفسه أمة","https://www.aldiwan.net/poem49523.html","المتقارب"],[439,"أصخ نحوي لدعوة مستقل","https://www.aldiwan.net/poem34755.html","الوافر"],[439,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[450,"أيزيد حاربت الملوك ولم يكن","https://www.aldiwan.net/poem707.html",""],[458,"أمنك خيال ضوع الركب موهنا","https://www.aldiwan.net/poem55831.html","الطويل"],[461,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[466,"لو أنك شاهدت الصبا يا ابن بوزل","https://www.aldiwan.net/poem50389.html","الطويل"],[514,"سطعت شموس قبابهم بزرود","https://www.aldiwan.net/poem20810.html","الكامل"],[514,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[514,"تصاحى وهو مخمور الجنان","https://www.aldiwan.net/poem20821.html","الوافر"],[540,"كم أخ صالح وعم وخال","https://www.aldiwan.net/poem56640.html","الطويل"],[551,"متى أنا ناج من سهام الغوائل","https://www.aldiwan.net/poem47258.html","الطويل"],[551,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[561,"يا رب إن أخطأت أو نسيت","https://www.aldiwan.net/poem27865.html","الرجز"]],"verses":[["رُهوني عِندَها تَغلَقُ","بَينَ الهَجرِ وَالبَينِ",0,"ن",1,0],["رَهَنتُهُ قَلبي وَمَن","يَرهُنُ قَلباً أَبَدا",1,"د",2,0],["رَهَباً فَعَافٍ شَاقَهُ بَذْلُ النَّدَى","رَاجٍ وَطَاغٍ سَاقَهُ اسْتِعْفَاءُ",2,"ا",2,0],["رُهبانُ مَديَنَ وَالَّذينَ عَهِدتُهُم","يَبكونَ مِن حَذَرِ العَذابِ قُعودا",3,"د",2,0],["رَهينَةُ رَمسٍ قَد تَجُرُّ ذُيولُها","عَلَيهِ سَوافي الرامِساتِ البَوارِحِ",4,"ح",1,0],["رَهينُ بِلىً وَكُلُّ فَتىً سَيَبلى","فَأَذري الدَمعَ بِالسَكبِ المَجودِ",5,"د",1,0],["رهط إذا كانت مباسطة الصبى","فيهم فهم في الجد جد كبار",6,"ر",1,0],["رَهَنَ الحَيَاةَ بِعِزِّهَا فَإِذَا","هَانَتْ فَمَا لِحَيَاتِهِ ثَمَنُ",7,"ن",1,0],["رَهِينُكِ وَضَّاحٌ ذَهَبتِ بِعَقلِهِ","فَإِن شِئتِ فَأَحييهِ وَإِن شِئتِ فَاقتُلِي",8,"ي",1,0],["رَهاءٍ بَساطِ الظَهرِ سِيٍّ مَخوفَةٍ","عَلى رَكبِها إِقلاتُها وَضَلالُها",9,"ل",3,0],["رَهطُ الفَرَزدَقِ مِن نَصارى تَغلِبٍ","أَو يَدَّعي كَذِباً دَعاوَةَ زورِ",10,"ر",1,0],["رُهبانُ مَديَنَ لَو رَأوكِ تَنَزَّلوا","وَالعُصمُ مِن شَعَفِ العُقولِ الفادِرِ",11,"ر",1,0],["رهنت في الحبّ نومي عند ناظره","لما اقترضت لجسمي منه أسقامي",12,"م",2,0],["رَهِلُ المحاجر والجفون ترى له","وجهاً يؤكِّدُ قُبحَهُ بقُطوبِ",13,"ب",1,0],["رهبةً للإله بل رغبةً من","ك بقدرٍ عن الخنا مرفوعِ",14,"ع",1,0],["رَهينَةُ قَعرِ البَيتِ كُلَّ عَشِيَّةٍ","يُطيفُ بِيَ الوِلدانُ أَهدُجُ كَالرَألِ",15,"ل",1,0],["رَهينَ الرَمسِ حَدَّثَني مَلِيّاً","حَديثَ المَوتِ تَبدُ لِيَ العِظاتُ",16,"ت",1,0],["رَهطُ سابورَ ذي الجُنودِ وَطُلّا","بُ مَساعي سابورَ ذي الأَكتافِ",17,"ف",1,0],["رَهَنتُ بَني السيدِ الأَشائِمِ موفِياً","بِمَقتولِهِم عِندَ المُفاداةِ غالِيا",18,"ي",2,0],["رَهطُ النَبِيِّ وَهُم مَأَوى كَرامَتِهِ","وَناصِرو الدينِ وَالمَنصورُ مَن نَصَروا",19,"ر",3,0],["رَهطُ الرَسولِ الَّذي تَقَطَّعُ أَس","بابُ البَرايا غَداً سِوى سَبَبِه",20,"ب",2,0],["رهينةُ تكويرٍ وكسفٍ كأنها","رغيفُ غلاءٍ أو كقرصِ حديدِ",21,"د",1,0],["رَهينَ بِلىً قَد حَلَّ في جَوف حُفرَةٍ","يُسَدُّ عَلَيها بِالرجام وَيُردَمُ",22,"م",1,0],["رَهطُ اِبنِ جَحشٍ في الخُطوبِ أَذِلَّةٌ","دُسمُ الثِيابِ قَناتُهُم لَم تُضرَسِ",23,"س",1,0],["رُهْبانُ لَيْلٍ أُسْدُ حَرْبٍ لم تَلِج","إِلَّا القَنا يَوْمَ الكَرِيهَةِ غِيلا",24,"ل",2,0],["رَهبَةً أَو رَغبَةً في وُدِّهِ","إِنَّهُ إِن شاءَ أَحلى وَأَمَر",25,"ر",1,0],["رَهطُها شُهَّدٌ وَجيرانُها سُه","دٌ إِلَينا وَقَلبُها مِن حَديدِ",26,"د",1,0],["رَهيناً بِالَّذي لاقَي","تُ بَينَ الرَغبِ وَالرَهبِ",27,"ب",1,0],["رَهطُ اِبنِ كُوزٍ مُحقِبي أَدراعِهِم","فيهِم وَرَهطُ رَبيعَةَ بنِ حُذارِ",28,"ر",1,0],["رَهَنْتُ قَميصي عِندهُ وَهوَ فَضْلَةٌ","من المُزْنِ يُعْلى ماؤها برَماد",29,"د",1,0],["رَهْطُ حَلْوَانَ لَمْ يَكَدْ مِنْكَ يحْظَى","بِلِقَاءٍ حَتَّى تَلاَهُ الفِرَاقُ",30,"ق",1,1],["رَهْطٌ إِذَا كَانتْ مُبَاسَطَةُ الصِّبَا","فِيهِمْ فَهُمْ فِي الجِدِّ جِدُّ كِبَارِ",31,"ر",1,0],["رَهينُ حُزنٍ أَبوكَ حَتّى","يَلقاكَ في مَنزِلِ القَرارِ",32,"ر",1,0],["رَهْبةٌ تَملأُ الْجَوانِحَ رُعْباً","وأَدِيمٌ وَعْرٌ كحدِّ النِّصَالِ",33,"ل",1,0],["رهباً فعافٍ شاقَهُ بذلُ النَّدا","راج وطاغ ساقه استعفاءُ",34,"ا",2,0],["رهطُ ابنِ كوزٍ أدراعهم ،","فيهمْ، ورهطُ ربيعة َ بنِ حُذارِ",35,"ر",1,0],["رهنَ الاشارة تختفي أو تعتَلي","وينالُ منها السَلْبُ والإيجاب",36,"ب",1,0],["رهنتُها عند فجِّ الطَّبْعِ محتقنٍ","بغيرِ صُمِّ العوالي غيرِ مجذوب",37,"ب",1,0],["رة ِ لو سالم الدهرُ إقبالها","تخيّر إفريقيا تاجَه",38,"ه",1,0],["رهصتها بالحيا حتى اذا","لصقت حر ثراها بحياها",39,"ا",3,0],["رَهينَةَ قَعرِ البَيتِ كُلَّ عَشِيَّةٍ","كَأَنّي أُراوى أَن أُصَوَّبَ في مَهدِ",40,"د",1,0],["رَهِبوا أَن يَكونَ حَربُكَ لِلمُل","كِ اِنتِهاءً فَاِستَعطَفوكَ اِبتِداءَ",41,"ا",2,0],["رَهطٌ نَضَوا بيضَ السُيوفِ وَآخَرٌ","قَد جَرَّ قَوساً لَيسَ فيها مَنزِعُ",42,"ع",1,0],["رَهبَةً مِن نِضالِهِ وَإِلى الآ","سادِ قِدماً تَنَجُّلُ الأَشبالِ",43,"ل",1,0],["رَهِينَةُ قَلبِي فِي يَدَيكَ وَدِيعَةٌ","وكَفِّيَ مِن قَلبِي ومِن حُبِّهِ صِفرُ",44,"ر",1,0],["رَهْطُ الرُّوَيْبِضَة انْبَروا وتجبّروا","أنَّ الجَهالةَ منهمُ تتخرَّجُ",45,"ج",1,0],["رَهِبوهُ فَصانَعوا بالهدايا","كي يُنحّي عنهم جيوشَ المنايا",46,"ي",2,0],["رَهِلٌ زَمَخرٌ إِذا الشَمسُ ذَرَت","خَضِلَت في ظِلالِهِ الأَنداءُ",47,"ا",2,0],["رَهْطُ نَبِيِّ الهُدَى وأُسْرَتُه","والخلفاءُ الأئمَّةُ الذُّلُل",48,"ل",1,0],["رهطُ