{"poems":[[55,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[55,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[55,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[55,"طلوع هداه إلينا المغيب","https://www.aldiwan.net/poem30758.html","المتقارب"],[79,"حديث على رغم العلا غير كاذب","https://www.aldiwan.net/poem36768.html","الطويل"],[9,"أذن اليوم جيرتي بحفوف","https://www.aldiwan.net/poem21953.html","الخفيف"],[88,"بين السرائر ضنة دفنوك","https://www.aldiwan.net/poem10365.html","الكامل"],[40,"أبت آيات حبى أن تبينا","https://www.aldiwan.net/poem7818.html","الوافر"],[34,"ألا ناد عيرا من بثينة ترتعي","https://www.aldiwan.net/poem27781.html","الطويل"],[33,"تشط غدا دار جيراننا","https://www.aldiwan.net/poem42585.html","المتقارب"],[76,"جفن تجافى للخلي عن الكرى","https://www.aldiwan.net/poem12960.html","الكامل"],[22,"لما رأى أن أرياف القرى منعت","https://www.aldiwan.net/poem21675.html","البسيط"],[54,"وحلو الدلال مليح الغضب","https://www.aldiwan.net/poem27264.html","المتقارب"],[77,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[50,"يا ليلة بتها أسقاها","https://www.aldiwan.net/poem66170.html","البسيط"],[48,"دعاكم إلى خير الأمور محمد","https://www.aldiwan.net/poem23208.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[22,"لَمَّا رَأَى أنَّ أرْيَافَ القُرى مَنَعَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=19731",""],[13,"أَلاَ تِلْكُمَا عِرْسِي مَنِيعَةُ ضُمِّنَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=180795",""],[92,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=179230",""],[159,"زمان الرياض زمان أنيق","https://www.aldiwan.net/poem55612.html","المتقارب"],[234,"نعت بالبين غربان","https://www.aldiwan.net/poem50762.html","مجزوء الوافر"],[234,"مزاجكما الخمر بالماء لوم","https://www.aldiwan.net/poem50822.html","المتقارب"],[255,"ما بلغ الله حسادي الذي طلبوا","https://www.aldiwan.net/poem14923.html","البسيط"],[371,"أيا نازحا أفنى نواظرنا نزحا","https://www.aldiwan.net/poem17168.html","الطويل"],[422,"هو البرق مما راعها وشجاها","https://www.aldiwan.net/poem54106.html","الطويل"],[422,"ما زلت أول مغرم مفتون","https://www.aldiwan.net/poem54126.html","الكامل"],[438,"وأهدى نسيم الروض مسكا وعنبرا","https://www.aldiwan.net/poem12526.html","الطويل"],[545,"قفا فهريقا الدمع بالمنزل الدرس","https://www.aldiwan.net/poem56802.html","الطويل"],[556,"ألا غاد دمع العين إن كنت غاديا","https://www.aldiwan.net/poem47140.html","الطويل"],[556,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126906","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63803","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63884","الهزج"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70834","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59273","الطويل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126119","الرجز"],[1369,"","https://poetry.dctabudhabi.ae/diwan/poem/141747","الطويل"],[1444,"","https://poetry.dctabudhabi.ae/diwan/poem/131377","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49960","المتقارب"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49929","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80018","الرمل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52073","الطويل"],[514,"","https://poetry.dctabudhabi.ae/diwan/poem/141833","البسيط"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20436","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53092","البسيط"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83213","الوافر"],[3022,"","https://poetry.dctabudhabi.ae/diwan/poem/120163","الكامل"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67600","المتقارب"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132721","البسيط"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/11","المتقارب"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140290",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91784","الطويل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/141688","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135260","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103055","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40110","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111469","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69956","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72792","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72392","الطويل"],[4984,"يوم العلم","https://www.poetsgate.com/ViewPoem.aspx?id=180154",""],[5261,"خبيئة وخطيئة","https://www.poetsgate.com/ViewPoem.aspx?id=212888",""],[5322,"فما لسناء النور لاح بقبلة","https://www.poetsgate.com/ViewPoem.aspx?id=120394",""],[5525,"الغضب","https://www.poetsgate.com/ViewPoem.aspx?id=985",""],[3469,"نأتك أمامة ُ إلا سُؤالاً","https://www.poetsgate.com/ViewPoem.aspx?id=17626",""],[5628,"حديث مع البحر","https://www.poetsgate.com/ViewPoem.aspx?id=178548",""],[5939,"طفلٌ بلا وطن","https://www.poetsgate.com/ViewPoem.aspx?id=178610",""],[5997,"وحي المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=214233",""]],"verses":[["وَحَثُّ العيسِ تَستَلِبُ الفَيافي","بِإِملاءِ الذَميلِ عَلى الرَسيمِ",0,"م",1,0],["وَحَثَثتُمُ حَظّي لِيَلحَقَ شَأوَكُم","حَتّى اِستَمَرَّ وَحَظُّ غَيري يُقدَعُ",1,"ع",1,0],["وَحُثَّ خَيلَ كُؤوسِ العِزِّ جامِحَةً","إِلى السُرورِ بِخَيلِ اللَهوِ وَاللَعِبِ",2,"ب",1,0],["وَحُثَّ الطِلابَ فَإِنّا نَجُدُّ","وَأَمضِ الأُمورَ فَإِنّا نَتوبُ",3,"ب",1,0],["وَحُثَّتْ لِمَغْنَاكَ الرَّحِيبِ الْقَلاَئِصُ","وَرُدَّتْ بِكَ الأَهْوَالُ وَهْيَ نَوَاكِصُ",4,"ص",1,0],["وَحَثَثنَ الجِمالَ يَسهَكنَ بِالبا","غِزِ وَالأُرجُوانِ خَملَ القَطيفِ",5,"ف",1,0],["وَحَثَوهُ فَوقَ سَناكِ يا شَمسَ الضُحى","فَبَكى لَهُ بَدرُ السَماءِ أَخوكِ",6,"ك",1,0],["وَحَثَّ الحادِيانِ بِأُمُّ لَهوٍ","ظَعائِنَ في الخَليطِ الرافِعينا",7,"ن",2,0],["وَحُثّوا عَلى جَمعِ الرِكابِ وَقَرِّبوا","جِمالاً وَنوقاً جِلَّةً لَم تَضَعضَعِ",8,"ع",1,0],["وَحَثَّ الحُداةُ بِها عَيرَها","سِراعاً إِذا ما وَنَت تُطرَدُ",9,"د",1,0],["وَحَثا التُرابَ عَلى الصَبا فَكَأَنَّما","أَزجى هُناكَ غَمامَةً بَرقٌ سَرى",10,"ر",2,0],["وَحَثُّهُ الرَكضَ وَالسِربالُ سابِغَةٌ","إِلى نِداءٍ بِظَهرِ الغَيبِ تَثويبِ",11,"ب",1,0],["وَحَثّوا النَدامى بِمَشمولَةٍ","إِذا شارِبٌ عَبَّ فيها قَطَب",12,"ب",1,0],["وحَثَّ جَناحَيْهِ ليخْطَفَ قَلبَه","عِشاءً سذانيقُ الدجى وهو غِربيب",13,"ب",1,0],["وَحَثحَثَت كَأسَها مُقَرطَقَةً","لَو مُنِّيَ الحُسنُ ما تَعَدّاها",14,"ا",3,0],["وَحَثَّ عَلى تَطهيرِ جِسمٍ وَمَلبَسٍ","وَعاقَبَ في قَذفِ النِساءِ الفَواضِلُ",15,"ل",1,0],["وحث في الشرق النواسيُّ القدَحْ","وفي ربى الغرب الخفاجيُّ صدحْ",16,"ح",1,0],["وحثه الرّكضُ والسِّربالُ سلبغة","ٌ إلى نِداءٍ بِظَهْرِ الغَيْبِ تَثْوِيبِ",17,"ب",1,0],["وَحَثْحَثْتُ مَشْعُوفَ النَّجَاءِ كَأَنَّنِي","هِجَفٌّ رَأى قَصْراً سَمَالاً وَداجِنَا",18,"ن",2,0],["وحثا التُرابَ بوجهه قَدَرٌ","عبّا لكل مُفارق طَبَقا",19,"ق",2,0],["وَحُثَّ الصَّبُوحَ لِوَقْتِ الصَّباحِ","فَمُتَّسِعُ الهَمِّ فيهِ يَضيقُ",20,"ق",1,0],["وحَثَّ بهنّ سَوّاقٌ","وحَفَّ بِهنّ غيرانُ",21,"ن",1,0],["وحُثَّا ولا تَخْشَيَا نَشْوَتي","فغَيري المُسيءُ عليها المَلُومُ",22,"م",1,0],["وحَثَّها خَندَرِيساً كأسُهَا فَمُهُ","وثَغرُهُ كلما ضاحكتَهُ الحَبَبُ",23,"ب",1,0],["وَحَثَّ رِكاباً لِلهُبوبِ طَليحَةً","تَقَيَّلُ بَينَ الطَلحِ آهاً لَهُ طَلحا",24,"ح",2,0],["وحَثْحَثَها واللَّيل يبدي ظلامه","إلى عين هادي من يضلّ عماها",25,"ا",3,0],["وحثثت يومئذٍ ركائبي الَّتي","لفّت سهول فدافد بحزون",26,"ن",1,0],["وحُثّا به كأسَ المُدامِ فإنها","تزيدُ الفتى ظرفاً وخُلقاً مكرَّما",27,"م",2,0],["وَحُثَّت اليها كُلُّ وَجناءَ حُرَّةٍ","مِن العيسِ يُبنى رَحلُها مَوضِعَ الجَلسِ",28,"س",1,0],["وحُثّوا عويلَ النّادباتِ وأبرزوا","إليهنّ عُوناً منكمُ وعَذارِيا",29,"ي",2,0],["وحُثّا عليَّ كؤوسَ النّجيعِ","سواءً شربتُ ولم أشربِ",30,"ب",1,0],["وحثّ الركبَ إن تبغي نَجاحاً","على الغربيّ من تلك المغاني",31,"ن",2,0],["وحثثْنَا الأوتارَ والهمُّ لا يح","ضرُ في حيثُ تحضرُ الأوتار",32,"ر",1,0],["وحَثِّي الصرفَ بالرطلِ","وبالجامِ وبالطَّاس",33,"س",1,0],["وحُثُّوا هيثوا قدحاً","صغيراً غير كُبَّار",34,"ر",1,0],["وَحَثُّوا مَطَايَا البَيْنِ فِي مَهْمَه الفَلاَ","وَسَارُوا بِلَيْلٍ مِنْ دُجَى الصيد فَاحِمِ",35,"م",1,0],["وحثحث المطي في طلابه","وادخل إليه راغباً من بابه",36,"ه",1,0],["وحث جناحيه وصفق طائراً","وطار بقلبي حيث طار ولا أدري",37,"ر",2,0],["وحثّوا على كسب العلوم صغاركم","أعينوهم فالعون حتمٌ لمن يقرا",38,"ر",2,0],["وحَثُّ النياق لوشك الفراق","وسير السّباقِ ببيضٍ خِرادِ",39,"د",1,0],["وحَثَّني علْمُه استقْلالهُ عِوَضاً","جزْل العطاء لَمن أُهْدي له الأَدبا",40,"ب",2,0],["وحثوا منكَ على عين العُلى","تربةً تستافها الحورُ استيافا",41,"ف",2,0],["وَحَثْحَثَ مِنْ مَاءِ الغَدِيرِ جِيادَهُ","إلى تَلةِ الغزلاَنِ تَكْسَحُ بِالبُزْلِ",42,"ل",1,0],["وحثَّ للرُّسْلِ منّا في مجالِسِهِمْ","ومنهمُ في جميعِ الحيِّ فارْتَعَدُوا",43,"د",3,0],["وَحَثَّت عَلى جَمع وَمَنع وَنفسُها","لَها في صُروفِ الدَهرِ حَقٌّ كَذوب",44,"ب",1,0],["وحثها شوقها لا سوقها فغدت","غنية عن معاناة الأناشيد",45,"د",1,0],["وَحَثَّ يَراعَتي وَسَما بِفِكري","وَأَيقَظَ هِمَّةً أَزجَت حَناني",46,"ن",2,0],["وحثوا ثراه على جمالك عاطلاً","أين الغلائل والحلى والطيب",47,"ب",1,0],["وَحَثِّ الكؤوس ومَن تَشتهيهِ","يُعاطيكَها بمزاجِ القُبَل",48,"ل",1,0],["وحث ركبك شوق الوصل معتقدا","نيل الجزيلين من فضل وانعام",49,"م",1,0],["وَحَثَّ بِها الحادِيانِ النَجاءَ","مَعَ الصُبحِ لَمّا اِستَشاروا الجِمالا",50,"ل",2,0],["وحثوا مطايا العزم في طلب العلا","فقد مات أهلوه الكرام السوالف",51,"ف",1,0],["وَحثّي مَطايا العُمر في كُلِّ مهمهٍ","لنيل مَقام فيهِ عقرُ المطية",52,"ه",1,0],["وحَثّ عشْرَيه لأَقصاها مَدَى","أَبْعَدَهَا مُنْتَجَعاً ومُرْتمَى",53,"ا",1,0],["وحُثَّ يا أخي على الكفاءهْ","خوفاً من الوقوع في الدَّناءهْ",54,"ه",1,0],["وحثثنا المطا إلى ذي محل","باذخ الأوج جاره لا يضام",55,"م",1,0],["وحَثُّ بازٍ على نأْي وحَمْلُ قَطَا","مِيٍّ تَكَدَّر منه عَيْشُ كُدْرِيِّ",56,"ي",1,0],["وحَثَّهُمُ فَرداً فَفَرداً وسِيمَّا","أُذِيسَ لِيَستَرضُوا أَخِيلَ الذي اعتَزَل",57,"ل",1,0],["وحث في صدر السرى جرده","بهدةٍ تدوي بتلك النجاد",58,"د",1,0],["وَحثَّ الغافلين عَلى القِيامِ","لَهُ الباعُ الطَويلُ بكلِّ فنّس",59,"س",1,0],["وحثَّ النوى أوراقَ بهجةِ حسنِها","وصوحَ منها كل ما كان ناميا",60,"ي",2,0],["وحثحث من شوق ذلول تذلل","لمن قد ثوى فيه احتراما وتبجيلا",61,"ل",2,0],["وحث عليه الدين يرفع شأنه","أساسا لأدراك الشريعة والحسم",62,"م",1,0],["وحثها جاهدا لطاعته","شيطانها حتى يثمر الغضب",63,"ب",1,0],["وحث المطايا كل يوم وليلة","وحل بناديهم بعزم ونية",64,"ه",1,0],["وحثيت الريح..في وجه التراب وهبت القيعان","تحت أقدامي .. ومرت ديار وودعت غالي",65,"ل",2,0],["وحث بها الحاديان النَّجاء","مع الصبحِ لما استثاروا الجِمالا",66,"ا",1,0],["وحثثتُ رغمَ وعورةِ الدربِ الخُطى","مُتنقلا بينَ الجهات الأربعِ",67,"ع",1,0],["وحثالةُ الأعرابِ دُونَكَ أغلقوا","عادينَ بابَ الغَوثِ بالمزلاجِ",68,"ج",1,0],["وَحَثَّتْ خُطًى أَغَسَّانَ شَرْقِي تِهَامَةً","وَأُرْسَى بِلُبْنَانِ الْمُكَنَّى أَبُو لَهِّبْ",69,"ب",1,0]]}