{"poems":[[53,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[53,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[53,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[53,"طلوع هداه إلينا المغيب","https://www.aldiwan.net/poem30758.html","المتقارب"],[77,"حديث على رغم العلا غير كاذب","https://www.aldiwan.net/poem36768.html","الطويل"],[9,"أذن اليوم جيرتي بحفوف","https://www.aldiwan.net/poem21953.html","الخفيف"],[86,"بين السرائر ضنة دفنوك","https://www.aldiwan.net/poem10365.html","الكامل"],[38,"أبت آيات حبى أن تبينا","https://www.aldiwan.net/poem7818.html","الوافر"],[32,"ألا ناد عيرا من بثينة ترتعي","https://www.aldiwan.net/poem27781.html","الطويل"],[31,"تشط غدا دار جيراننا","https://www.aldiwan.net/poem42585.html","المتقارب"],[74,"جفن تجافى للخلي عن الكرى","https://www.aldiwan.net/poem12960.html","الكامل"],[22,"لما رأى أن أرياف القرى منعت","https://www.aldiwan.net/poem21675.html","البسيط"],[52,"وحلو الدلال مليح الغضب","https://www.aldiwan.net/poem27264.html","المتقارب"],[75,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[48,"يا ليلة بتها أسقاها","https://www.aldiwan.net/poem66170.html","البسيط"],[46,"دعاكم إلى خير الأمور محمد","https://www.aldiwan.net/poem23208.html","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[22,"لَمَّا رَأَى أنَّ أرْيَافَ القُرى مَنَعَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=19731",""],[13,"أَلاَ تِلْكُمَا عِرْسِي مَنِيعَةُ ضُمِّنَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=180795",""],[90,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=179230",""],[155,"زمان الرياض زمان أنيق","https://www.aldiwan.net/poem55612.html","المتقارب"],[229,"نعت بالبين غربان","https://www.aldiwan.net/poem50762.html","مجزوء الوافر"],[229,"مزاجكما الخمر بالماء لوم","https://www.aldiwan.net/poem50822.html","المتقارب"],[250,"ما بلغ الله حسادي الذي طلبوا","https://www.aldiwan.net/poem14923.html","البسيط"],[366,"أيا نازحا أفنى نواظرنا نزحا","https://www.aldiwan.net/poem17168.html","الطويل"],[416,"هو البرق مما راعها وشجاها","https://www.aldiwan.net/poem54106.html","الطويل"],[416,"ما زلت أول مغرم مفتون","https://www.aldiwan.net/poem54126.html","الكامل"],[432,"وأهدى نسيم الروض مسكا وعنبرا","https://www.aldiwan.net/poem12526.html","الطويل"],[540,"قفا فهريقا الدمع بالمنزل الدرس","https://www.aldiwan.net/poem56802.html","الطويل"],[551,"ألا غاد دمع العين إن كنت غاديا","https://www.aldiwan.net/poem47140.html","الطويل"],[551,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"]],"verses":[["وَحَثُّ العيسِ تَستَلِبُ الفَيافي","بِإِملاءِ الذَميلِ عَلى الرَسيمِ",0,"م",1,0],["وَحَثَثتُمُ حَظّي لِيَلحَقَ شَأوَكُم","حَتّى اِستَمَرَّ وَحَظُّ غَيري يُقدَعُ",1,"ع",1,0],["وَحُثَّ خَيلَ كُؤوسِ العِزِّ جامِحَةً","إِلى السُرورِ بِخَيلِ اللَهوِ وَاللَعِبِ",2,"ب",1,0],["وَحُثَّ الطِلابَ فَإِنّا نَجُدُّ","وَأَمضِ الأُمورَ فَإِنّا نَتوبُ",3,"ب",1,0],["وَحُثَّتْ لِمَغْنَاكَ الرَّحِيبِ الْقَلاَئِصُ","وَرُدَّتْ بِكَ الأَهْوَالُ وَهْيَ نَوَاكِصُ",4,"ص",1,0],["وَحَثَثنَ الجِمالَ يَسهَكنَ بِالبا","غِزِ وَالأُرجُوانِ خَملَ القَطيفِ",5,"ف",1,0],["وَحَثَوهُ فَوقَ سَناكِ يا شَمسَ الضُحى","فَبَكى لَهُ بَدرُ السَماءِ أَخوكِ",6,"ك",1,0],["وَحَثَّ الحادِيانِ بِأُمُّ لَهوٍ","ظَعائِنَ في الخَليطِ الرافِعينا",7,"ن",2,0],["وَحُثّوا عَلى جَمعِ الرِكابِ وَقَرِّبوا","جِمالاً وَنوقاً جِلَّةً لَم تَضَعضَعِ",8,"ع",1,0],["وَحَثَّ الحُداةُ بِها عَيرَها","سِراعاً إِذا ما وَنَت تُطرَدُ",9,"د",1,0],["وَحَثا التُرابَ عَلى الصَبا فَكَأَنَّما","أَزجى هُناكَ غَمامَةً بَرقٌ سَرى",10,"ر",2,0],["وَحَثُّهُ الرَكضَ وَالسِربالُ سابِغَةٌ","إِلى نِداءٍ بِظَهرِ الغَيبِ تَثويبِ",11,"ب",1,0],["وَحَثّوا النَدامى بِمَشمولَةٍ","إِذا شارِبٌ عَبَّ فيها قَطَب",12,"ب",1,0],["وحَثَّ جَناحَيْهِ ليخْطَفَ قَلبَه","عِشاءً سذانيقُ الدجى وهو غِربيب",13,"ب",1,0],["وَحَثحَثَت كَأسَها مُقَرطَقَةً","لَو مُنِّيَ الحُسنُ ما تَعَدّاها",14,"ا",3,0],["وَحَثَّ عَلى تَطهيرِ جِسمٍ وَمَلبَسٍ","وَعاقَبَ في قَذفِ النِساءِ الفَواضِلُ",15,"ل",1,0],["وحث في الشرق النواسيُّ القدَحْ","وفي ربى الغرب الخفاجيُّ صدحْ",16,"ح",1,0],["وحثه الرّكضُ والسِّربالُ سلبغة","ٌ إلى نِداءٍ بِظَهْرِ الغَيْبِ تَثْوِيبِ",17,"ب",1,0],["وَحَثْحَثْتُ مَشْعُوفَ النَّجَاءِ كَأَنَّنِي","هِجَفٌّ رَأى قَصْراً سَمَالاً وَداجِنَا",18,"ن",2,0],["وحثا التُرابَ بوجهه قَدَرٌ","عبّا لكل مُفارق طَبَقا",19,"ق",2,0],["وَحُثَّ الصَّبُوحَ لِوَقْتِ الصَّباحِ","فَمُتَّسِعُ الهَمِّ فيهِ يَضيقُ",20,"ق",1,0],["وحَثَّ بهنّ سَوّاقٌ","وحَفَّ بِهنّ غيرانُ",21,"ن",1,0],["وحُثَّا ولا تَخْشَيَا نَشْوَتي","فغَيري المُسيءُ عليها المَلُومُ",22,"م",1,0],["وحَثَّها خَندَرِيساً كأسُهَا فَمُهُ","وثَغرُهُ كلما ضاحكتَهُ الحَبَبُ",23,"ب",1,0],["وَحَثَّ رِكاباً لِلهُبوبِ طَليحَةً","تَقَيَّلُ بَينَ الطَلحِ آهاً لَهُ طَلحا",24,"ح",2,0],["وحَثْحَثَها واللَّيل يبدي ظلامه","إلى عين هادي من يضلّ عماها",25,"ا",3,0],["وحثثت يومئذٍ ركائبي الَّتي","لفّت سهول فدافد بحزون",26,"ن",1,0],["وحُثّا به كأسَ المُدامِ فإنها","تزيدُ الفتى ظرفاً وخُلقاً مكرَّما",27,"م",2,0],["وَحُثَّت اليها كُلُّ وَجناءَ حُرَّةٍ","مِن العيسِ يُبنى رَحلُها مَوضِعَ الجَلسِ",28,"س",1,0],["وحُثّوا عويلَ النّادباتِ وأبرزوا","إليهنّ عُوناً منكمُ وعَذارِيا",29,"ي",2,0],["وحُثّا عليَّ كؤوسَ النّجيعِ","سواءً شربتُ ولم أشربِ",30,"ب",1,0]]}