ewPoem.aspx?id=215376",""],[5518,"صلاةٌ في محراب السماء","https://www.poetsgate.com/ViewPoem.aspx?id=187174",""],[5533,"وانتصَرَتْ حَلَب","https://www.poetsgate.com/ViewPoem.aspx?id=181540",""],[5606,"مرحبا يالغالي","https://www.poetsgate.com/ViewPoem.aspx?id=197407",""],[5608,"عزي ومجدي","https://www.poetsgate.com/ViewPoem.aspx?id=32823",""],[5652,"ديسمبر الجوع !!","https://www.poetsgate.com/ViewPoem.aspx?id=177371",""],[5725,"نم قريرا","https://www.poetsgate.com/ViewPoem.aspx?id=198899",""],[5725,"يا عراق فقل لصبرك زدني","https://www.poetsgate.com/ViewPoem.aspx?id=211338",""],[402,"هو يوم أغر مبتسم","https://www.poetsgate.com/ViewPoem.aspx?id=36523",""],[5795,"نصرت دولة المهى التركيه","https://www.poetsgate.com/ViewPoem.aspx?id=167910",""],[5952,"من للمعركةْ؟","https://www.poetsgate.com/ViewPoem.aspx?id=207805",""],[6004,"عروسُ الشَّرق","https://www.poetsgate.com/ViewPoem.aspx?id=71985",""],[6031,"يا خَلِيلَيَّ احْبِسَا الرَّكْبَ إذَا مَا","https://www.poetsgate.com/ViewPoem.aspx?id=46300",""],[6052,"بطاقات حمراء من غزة","https://www.poetsgate.com/ViewPoem.aspx?id=47578",""],[6102,"عرس برسم الدم!!","https://www.poetsgate.com/ViewPoem.aspx?id=186280",""]],"verses":[["يا عَريقَ الهَوى سَتَقضي إِذا ما","طَلَعَ البَينُ مِن ثَنايا العِراقِ",0,"ق",1,0],["يا عُرَيْبَ الشِّعْبِ منْ وادِي النّقا","أخْضَلَ الغَيْثُ رُباكُمْ ونَقَعْ",1,"ع",1,0],["يا عَريقَ الأُصولِ وَالحَسَبِ الوَ","ضاحِ وَالنُبلِ يا كَريمَ الجِوارِ",2,"ر",1,0],["يَا عَرُوسَانِ تَمَّ سَعْدُكُمَا","لا يُشَبْ تِمُّهُ بِنُقْصَانِ",3,"ن",1,0],["يَا عَرُوساً مَرَّتْ بِهَا أَشْهُرُ الصَّفْ","وِ سِرَاعاً كَأَنَّهَا حُلْمُ حَالِمْ",4,"م",1,0],["يا عربياً آباؤهُ نَبَطٌ","يا نبعةً كان أصلُها غَرَبا",5,"ب",2,0],["يا عُرُسَ الدنيا وعيدَ الأعيادْ","مُلكُك طول الدهر راسِي الأوتادْ",6,"د",1,0],["يا عروةً في الملمَّا","ت غيرَ ذاتِ انفصامِ",7,"م",1,0],["يا عروسَ الجبالِ يا وردَةَ الآ","مالِ يا فتنةَ الوُجُودِ الجليلِ",8,"ل",1,0],["يا عَرشَ قُسطَنطينَ نِلتَ مَكانَةً","لَم تُعطَها في سالِفِ الأَعصارِ",9,"ر",1,0],["يا عَروس الدُنيا وَما حالَ قَلب","فَجَعته أَحزانه بِالأَماني",10,"ن",2,0],["يا عَرَبِيّاً مِن صَنعَةِ السوقِ","وَصَنعَةُ السوقِ ذاتُ تَشقيقِ",11,"ق",1,1],["يا عروسَ الغرب يا أندلسيّهْ","بعُدَتْ داركِ والصيف دنا",12,"ن",2,0],["يا عَريقَ الأُصولِ وَالحَسَبِ الوَض","ضاحِ وَالنُبلِ يا كَريمَ الجِوارِ",13,"ر",1,0],["يا عَروسَ البِحارِ إِنَّكِ أَهلٌ","أَن تُحَلّيكِ بِالجُمانِ البُحورُ",14,"ر",1,0],["يَا عَرُوساً تَسْمُو إلى عَرْشِهَا فِي","أَيِّ حُسْنٍ يَسْبِي وَأَيِّ حَيَاءِ",15,"ا",2,0],["يَا عَرُوس اهْنَئِي بِقُرْبِ عَرُوسٍ","جَاءَ وَفْقَ الأَحْلاَمِ وَالآمَالِ",16,"ل",1,0],["يا عروس المجد تيهي واسحبي","في مغانينا ذيول الشهب",17,"ب",1,1],["يا عروس المجد طال الملتقى","بعدما طال جوى المغترب",17,"ب",1,0],["يا عروس الشعر صفّق للغنا","ترقص في ضفاف الشعر كبرا",18,"ر",2,0],["ياعروسَ \" الفلغِ \" والفلغا دمٌ","ساءت البلوى فاحسنت البلاء",19,"ا",2,0],["يا عروسَ المجدِ حسبي عزّةً","أن أرى المجدَ انثنى يعتزُّ بي",20,"ب",2,0],["يا عريض الجاه يا سند ال","عاجز المحتاج للنسد",21,"د",1,0],["يا عريض الجاه يا بحر الرضى","يا مغيثاً من دعاه كلما",22,"م",2,0],["يا عُروةٌ فازِت المُستمسِكون بها","أتَ الشفيعُ وأنت المُرشِد الهادي",23,"د",2,0],["يا عروةَ اللهِ التي لم ينتفع","إلا امرءٌ عَلِقتْ يداه بحبلها",24,"ل",3,0],["يا عروس الخيال والصيف ولّى","تاركا في النفوس ما لا تطيق",25,"ق",1,0],["يا عروس الإلهام يا مصدر الوح","ي هلُمّي فإنّ عهدي وثيق",25,"ق",1,0],["يا عروسَ الأحلامِ باللَهِ هاتي","وخُذي ولنَفُضُّ هذي البكارَه",26,"ر",2,0],["يا عروسَ الإلهامِ موعدُكِ الشاطىءُ","مأوى العشاقِ عندَ الأصيل",27,"ل",1,0],["يا عرشَ يلدزَ أنتَ النجمُ لا عطلتْ","منكَ السماءُ التي أفلاكها الوزرا",28,"ر",2,0],["يا عُريباً لَولاهم لم يَشقني","ذكرُ دارٍ ولا تذكّر ربعِ",29,"ع",1,0],["يا عرب نجدكم تطيلون الجفا","لمتيم حشيت جوانحه عنا",30,"ن",2,0],["يا عراب الحمى رق","قوا لصب عميد",31,"د",1,0],["يا عروساً في ثياب الرق","ص وارقصيني",32,"ي",1,1],["يا عرش ذات اللَه في جلواته","إن الجليل مقرُّه لَجليل",33,"ل",1,0],["يا عرش رب السما مذ جاء متضعاً","تسلمي الآن عرشاً سامياً فرجا",34,"ج",2,0],["يا عرشَ حكمةِ مبدعِ الأكوان من","بعلاه حارت حكمةُ الحكماء",35,"ا",2,0],["يا عَرشَ مجد اللَهِ يا شَمسَ الهُدى","قد مزَّقت ببزوغِها الظَلماءَ",36,"ا",2,0],["يا عرين المجد يا ركن العلى","قد حوى غابك ضرغاماً هصورا",37,"ر",2,0],["يا عُروتي الوثقَى أعدْ نظرةً","في خَلَّةٍ منبوذةٍ بالعرا",38,"ر",2,0],["يا عُرْبَ وادي المُنْحَنى بحَياتِكُمْ","حُنُّوا عليَّ فقدْ تَناهَبَني الضَّنى",39,"ن",2,0],["يا عُرْبَ منْعَرَجِ اللِّواءِ ألِيَّةً","بجَنابِكُمْ يا عِزَّ ذلكَ من قَسَمْ",40,"م",1,0],["يا عُربَ وادي النَّقا طالَ المَطالُ بِنا","غِبْتم أطلْتُمْ حَناناً رَحمةً عودوا",41,"د",3,0],["يا عرب الخسّةِ د لونى","لزعيمٍ يأخذ بيميني",42,"ن",2,0],["يا عًرشُ هذا عيدُك المرجُوُ أو","يا عيدُ هذا عرشُكَ البَسَّامُ",43,"م",1,0],["يا عريب الحمى قفوا لضعيف","جره ركبكم بنغمة حادي",44,"د",2,0],["يا عُرَيْبَ العَقِيقِ مَنْ لي وَهَيْها","تَ بأَيّامِنا بوَادِي العَقيقِ",45,"ق",1,0],["ياعُرْبَ كاظِمَةٍ أفِيكُم أُظْلَمُ","والعَبدُ عَبْدُكُمُ وأنْتُمْ أنْتُمُ",46,"م",1,1],["يا عروس الخيل والسيف له","من قراع الخيل والابطال صدح",47,"ح",1,0],["يا عروسَ الخُلْدِ كم مِن خائفٍ","في الرِّجالِ الدُّهْمِ يَعلِفْنَ المَطِيَّا!",48,"ي",2,0],["يا عروة سلَّم المستمسكون بها","ومسلكاً بالولا فيكم يمهده",49,"د",2,0],["يا عروة الدين المتين","وبحر علم العارفينا",50,"ن",2,0],["يا عرس العقبان","وفرحة الديدان",51,"ن",1,1],["يا عرس العقبان","تقلص الإِحساس",51,"س",1,0],["يا عرس العقبان","ما في مدى الأرض",51,"ض",1,0],["يا عرب وادي النقا اني بكم ولع","صب كيب يقضي ليله سهرا",52,"ر",2,0],["يا عرب وادي المنحني اني بكم","ولع وفي ذا الوقت زاد تولعي",53,"ع",2,0],["يا عرش نسل الشمس في عليائهم","سامي الكواكب في السماء وحاكي",54,"ك",2,0],["يا عَرَبي يا عَرَبي","يا عَرَبي يا عَرَبي",55,"ب",2,0],["يا عروس الكنائس الغرِّ يا من","ناب فيما تريد عن ألف فيلق",56,"ق",1,0],["يا عَروسَ الخَيالِ يا فَجرَ إِلها","مي وَدُنيا أَحلامي الذَهَبِيَّه",57,"ي",2,0],["يا عروسا زفت إلي فاهديت","إليها وفي مكان المهور",58,"ر",1,0],["يا عريب الحمى اعذروني فإني","ما تجنيت أرضكم عن ملاله",59,"ل",2,0],["يا عَروساً تُزَفُّ حالِيَةً","عُرسُها فَوقَ وَصفِ مَن يَصِفُ",60,"ف",1,0],["يا عراص الطفوف كم فيك بدراً","غاله حادث الردى بخسوف",61,"ف",1,0],["يا عروس القيامة اشفع تشفع","وأنلني صدق المقال الشفاهي",62,"ا",3,0],["يا عرب قام القائمون","وما برحتم نائمينا",63,"ن",2,0],["يا عرب ذاك الحمى كيف السبيل إلى","قلبي الذي نشا في حبكم وربي",64,"ب",2,0],["يا عريباً حلواً بسفح زرودٍ","ليت في حيكم يثنى عقالي",65,"ل",2,0],["يا عُربَ بانِ النقا صلوني","وصالكم مرهم الشفاءِ",66,"ا",2,0],["يا عرب بان المصلى","حسبي من البين حسبي",67,"ب",2,0],["يا عُربَ نجدٍ أنتُم لي فتنةٌ","وبطيب ذكركُم ألذ وأطربُ",68,"ب",1,1],["يا عروس الشهود يوم المعاد","يا أميناً إلى الخفايا تدلى",69,"ل",2,0],["يَا عَرَبَ الحَيِّ عُذَّلِي عَدَدُ","وَيْلاَهُ أَيْنَ الرِّجَالُ وَالعُدَدُ",70,"د",1,1],["يَا عُرْبَ وَاديَ المُصَلاَّ","لأَنْتُمُ خَيْرُ عُرْبِ",71,"ب",1,0],["يا عرب ذاك الحي لي بحسانك","شغفٌ ولي ولَهٌ بكم وتعلق",72,"ق",1,0],["يا عرب وادي النقا أغيثوا","عبد الكم وده الأكيد",73,"د",1,0],["يا عُرَّةَ الثقلينِ لا","دِيناً رعيتَ ولا حسب",74,"ب",1,0],["ياعرة الدنيا بلا غرة","ويا طويس الشؤم والحرص",75,"ص",1,0],["يا عرب وادى النقا إن حل سقك دمى","في شرعكم فضميري ليس يأباه",76,"ا",2,0],["يا عَروس الرُوح داوي","روحَنا في كُلِّ حين",77,"ن",1,0],["يا عَريضَ الجُفونِ لَولاكَ لَم تَم","رَض قُلوبٌ وَتَحتَرقَ أَحشاءُ",78,"ا",2,0],["يا عريباً بين الرصافة والكر","خ أقاموا لا بل بقلبي حلوا",79,"ل",3,0],["يا عريبا حبهم في مهجتى","وهمو قد سكنوا سفح قبا",80,"ب",2,0],["يا عرب كل الذي قد كان من مدحٍ","في مجدكم عاد للراثين من ندب",81,"ب",1,0],["يا عرشَ نورِ العُروشِ","ولوحَ سرّ النُقوشِ",82,"ش",1,0],["يا عرب وادي النقا","يا سلوة المستهام",83,"م",1,0],["يا عرب وادي النقا والله ما لمعت","بوارق الحي بالزوراء والعلم",84,"م",1,0],["يا عرب قلبي في جنابكم","ضيف فهل غير الصدود قرى",85,"ر",2,0],["يا عروس الشرق يا قلب الجزيره","يا وطن ما صار في الدنيا نظيره",86,"ر",2,1],["يا عرض صدرك يا سذاجة نواياك","بك ظلمة المبصر وشاعر وصعلوك",87,"ك",1,0],["ياعروسَ العُرْبِ يا سحرى الهوى","كم تغنّى بكِ أفّآكٌ أَشِرْ",88,"ر",1,0],["يا عرشَ بلقيسَ كيفَ سِيْطَ على","ثراكَ حرفيْ بسيِّئِ القَدَرِ !",89,"ر",1,0],["يا عرب للخفوق ردّوا القلب ردّوا","صحت والعين نادت غاب بدر التمام",90,"م",1,0],["يا عروس المداين يالفرح يالسرور","قلت راس المنارة للمعالي طليب",91,"ب",1,0],["يا عروساً لها \"البراءُ\" حليلٌ","حَظُّكِ الخيرُ دونَ كُلِّ النِّساءِ",92,"ا",2,0],["يا عروسُ احفلي أتتكِ عروسُ","يا فدَى أعذَبَ النُّفُوسِ النُّفُوسُ",93,"س",1,1],["يا عَرُوسُ احفَلِي فدتْكِ عيُونِي","وحدَهُ الهمُّ في فؤادي يجوسُ",93,"س",1,0],["يَا عَرُوسُ الزَّمانُ فِيَّ شحِيحٌ","تعبَت في درُوبهنَّ العيسُ",93,"س",1,0],["يا عَروسَ البحرِ غنّي هَلِّلي","واسْبَحي في النورِ قََرّي أَعْيُنا",94,"ن",2,0],["يا عروسَ الشعرِ افترقنا.. وإنّا","دون أن ندري في كِلينا كنَّا",95,"ن",2,0],["يا عروقا دم الحياة جرى في","غيرها واستخارها للركود",96,"د",1,0],["يا عرين الأحرار أنت خليق","بثناء نبثه إجماعا",97,"ع",2,0],["ياعراقاً منْ أساطيرِ الهوى","تنتهي فيكَ طروسٌ تدَّكرْ",98,"ر",1,0],["ياعرب جد الجد هيا وازحفوا","سيروا ليوم الفخر فى كنف السماء",99,"ا",2,0],["يا عراقاً أنجبَ الدّنيا وفَاقَا","أنْجَبَتْ منهُ الدُّنى سَبْعا طِباقا",100,"ق",2,1],["يا عرْبُ ناموا أو فموتوا كلَّكمْ","من جهْلِكمْ جاسَ الديارَ غريبُ",101,"ب",1,0],["ياعراقٌ صداك ازّ عروشاً","فأسمع الكونٓ صوتك المكبوتا",102,"ت",2,0],["يا عروس(ن) في خيالاتي فريده","زفّها ركب الغرام إلى مكاني",103,"ن",2,0],["يا عروس الخيل والسيفُ له","في قراع الخيل والأبطال صدحُ",104,"ح",1,0],["يا عروسَ البحرِ قالوا أنت أحلى","ليت هذا ليتَه ما كان قيلا",105,"ل",2,0],["يا عروة الرحمن قَلَّ رجالُنا","وتكاثرَ الأشباهُ ب الأعلامِ",106,"م",1,0],["يا عَروسَاً في العُلا أَمْجادُها","يا جَمالَ الشَّمْسِ قَبْلَ المَغْرِبِ",107,"ب",1,0],["يا عريب الخال مية نعم في خالك وخالي","ياسعد ياعازمي يا رجل من منبع رجاله",108,"ل",2,0],["ياعرب كلّي سعودي..وكلّي عزوم وتحدّي","ودام (ابومتعب) فخرنا .. بفتخر في كل ديره",109,"ر",2,0],["ياعُرب وين الي ينادي ل عُربه","قبل يتلاشى ف المدى طول صوته",110,"ت",2,1],["يا عراقٌ رمالك اليوم غضبى","زلزل الارض سيد الاطوادِ",111,"د",1,0],["يا عراق فقل لصبرك زدني","يؤتك الله منه نصراً مبينا",112,"ن",2,1],["يا عروسان تم سعدكما","لا شب تمه بنقصان",113,"ن",1,0],["يا عريقاً بالمكرمات فليست","هبة تستردّ أو عارّيه",114,"ي",2,0],["يا (عروة بن الورد) من للمعركةْ؟","عبْسٌ بلا ماءٍ ... وخيلٌ مُنهكةْ",115,"ك",2,1],["يا عروُسَ الشَّرقِ اجتباكِ ( حكيمٌ )","في الدُّنا للأمانِ خيرَ مثَالِ",116,"ل",1,0],["يا عُرَيْباً حلَّلُوا سفكَ دَمِي","إنَّما حَلَّلتُمُ شَيْئاً حَرَامَا",117,"م",2,0],["يا عربُ أين ضميرُكم فمنامكم","أكل النهارَ بصرخة ٍخرساء",118,"ا",1,0],["يا عَروسًا عَلى الفُراتِ؛ تُساقُ","لِلزَّنادِيقَ- جَهرَةً- وَتُراقُ!",119,"ق",1,1]]}