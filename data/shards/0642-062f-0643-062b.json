{"poems":[[53,"يا أحمد بن سعيد لا تمت جزعا","https://www.aldiwan.net/poem65873.html","البسيط"],[91,"تعلموا تعلموا","https://www.aldiwan.net/poem44642.html","مجزوء الرجز"],[83,"ظبي من العرب سبا مهجتي","https://www.aldiwan.net/poem61304.html","السريع"],[48,"ما أجلي في أجلى حاضر","https://www.aldiwan.net/poem22375.html","السريع"],[48,"هل آن للقيد أن تفكه","https://www.aldiwan.net/poem23093.html","مجزوء البسيط"],[48,"كل على مكروهه مسبل","https://www.aldiwan.net/poem23150.html","السريع"],[147,"عوضونا من السهاد الرقادا","https://www.aldiwan.net/poem11742.html","الخفيف"],[385,"أذكى الغليل نسيم الريح حين سرى","https://www.aldiwan.net/poem48832.html","البسيط"],[520,"مل وقد ملت إلى وداده","https://www.aldiwan.net/poem12065.html","الرجز"],[520,"كن لي على شكر ما أوليت من نعم","https://www.aldiwan.net/poem12253.html","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56137","السريع"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109422","السريع"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70356","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204629","الكامل"],[3341,"","https://poetry.dctabudhabi.ae/diwan/poem/139076",""],[3471,"","https://poetry.dctabudhabi.ae/diwan/poem/56460","السريع"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67613","السريع"],[3591,"رأيت فقيراً قد أتى يسأل الطعما","https://www.poetsgate.com/ViewPoem.aspx?id=149425",""]],"verses":[["قد كثَّر اللَّهُ فيها وهْي سالمةٌ","والشملُ مجتمعٌ والحبلُ موصولُ",0,"ل",1,0],["قد كثر اللاهون","بالشعر واني منهم",1,"م",1,0],["قَد كَثَب الحُسن عَلَى خَدّه","إنَّا فَتَحنَا لَك فَتحاً مُبِين",2,"ن",1,0],["قَد كثُرَت في الأَرضِ جُهّالُنا","وَالعاقِلُ الحازِمُ فينا غَريب",3,"ب",1,0],["قَد كَثُرَ الغِشُّ وَاِستَعانَت","بِهِ الأَشِدّاءُ وَالأَرِكَّه",4,"ك",2,0],["قَد كَثُرَ الشَرُّ عَلى ظَهرِها","وَاِتُّهِمَ المُرسِلُ وَالمُرسَلُ",5,"ل",1,0],["قَد كَثَرتَ المُلوكَ فَضلاً وَإِفضا","لاً وَعَدلاً فَاِكثُرهُمُ أَولادا",6,"د",2,0],["قَد كثنت مُنتَظِراً دَهري يُساعِدُني","عَلى اللُقا فَأَتاحَ الدَهر لي سَفَرا",7,"ر",2,0],["قد كثر الشعر وقل ناقد","وأنت أولى الناس بانتقاده",8,"د",2,0],["قد كثرت عدد الحساد أنعمه","عندي وما كثر الحساد كالنعم",9,"م",1,0],["قد كثر القوم الذين اعتنوا","تقليد من قد كان فيه نبيهْ",10,"ي",2,0],["قد كثُرت بالخير افعاله","ومثله بين الورى نادر",11,"ر",1,0],["قد كثر القيل وحاشاك أن","تسمع قول الخصم في خصمه",12,"م",2,0],["قد كثر الفقراء ظلم ذوي الغنى","لم يكثر الفقراء حكم الباري",13,"ر",2,1],["قد كثب الدمع على خده","تبارك الله وسبحانه",14,"ه",1,0],["قد كَثُر الناسُ ولكنّني","لَسْتُ أرى بعدكِ إِنْسانا",15,"ن",2,0],["قد كثَّرَ الحاجبُ أعداءَهُ","وأحقدَ الناسَ على نعمتهْ",16,"ه",1,0],["قد كثرت تلك الجياع ومالهم","سوى خالق يشفي المجاعة والعدما",17,"م",2,0]]}