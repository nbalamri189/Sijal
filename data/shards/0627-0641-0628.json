{"poems":[[90,"يا عدل طال الانتظار فعجل","https://www.aldiwan.net/poem44798.html","الكامل"],[29,"صرم الخليط تباينا وبكورا","https://www.aldiwan.net/poem5774.html","الكامل"],[29,"لم أر مثلك يا أمام خليلا","https://www.aldiwan.net/poem5969.html","الكامل"],[42,"قد رابه ولمثل ذلك رابه","https://www.aldiwan.net/poem42339.html","الكامل"],[98,"الشّاطئ المهجور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66348&r=&rc=24",""],[136,"حى المنازل حول نهى الضال","https://www.aldiwan.net/poem54763.html","الطويل"],[202,"كذبت ظنونك ما العزاء جميلا","https://www.aldiwan.net/poem51898.html","الكامل"],[227,"قوت روحي هواك بل روح ذاتي","https://www.aldiwan.net/poem55470.html","الخفيف"],[272,"نام الخلي وما أغمض حار","https://www.aldiwan.net/poem1140.html",""],[369,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[369,"قسما لقد رجع النسيم عليلا","https://www.aldiwan.net/poem60803.html","الكامل"],[369,"وجدي بلومك يا عذول يزيد","https://www.aldiwan.net/poem60944.html","الكامل"],[369,"لولا رجائي ثانيا للقائه","https://www.aldiwan.net/poem61006.html","الكامل"],[385,"يقضي علي تعسفا","https://www.aldiwan.net/poem48808.html","مجزوء الكامل"],[454,"لا تخدعنك كثرة الزراع","https://www.aldiwan.net/poem982.html",""],[514,"حي المنازل أقفرت بسهام","https://www.aldiwan.net/poem750.html",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122745","الخفيف"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101529","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126188","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108997","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108986","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108930","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108510","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128086","الكامل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202133","الخفيف"],[1997,"","https://poetry.dctabudhabi.ae/diwan/poem/202564","الكامل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137946",""],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88650","الكامل"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123473","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60913","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93834","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132573","الكامل"],[3123,"","https://poetry.dctabudhabi.ae/diwan/poem/21157","الكامل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121560","الكامل"],[3256,"","https://poetry.dctabudhabi.ae/diwan/poem/20935","الكامل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145062","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45795","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118001","الكامل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34630","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111476","الكامل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75683","الكامل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28927","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33225","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120233","الكامل"],[4664,"","https://poetry.dctabudhabi.ae/diwan/poem/101169","الكامل"],[4717,"ميمون","https://www.poetsgate.com/ViewPoem.aspx?id=204118",""],[4929,"مآلاتُ اللاءات","https://www.poetsgate.com/ViewPoem.aspx?id=208656",""],[5636,"تأمّلات","https://www.poetsgate.com/ViewPoem.aspx?id=207340",""],[5748,"كذبت ظنونُك ما العزاء جميلا","https://www.poetsgate.com/ViewPoem.aspx?id=26237",""],[5906,"لا تفزعن","https://www.poetsgate.com/ViewPoem.aspx?id=188237",""],[5906,"هيهات","https://www.poetsgate.com/ViewPoem.aspx?id=188315",""],[391,"أَلا حَيِّيا الدّارَ المُحيلَ رُسُومُها","https://www.poetsgate.com/ViewPoem.aspx?id=4656",""]],"verses":[["أفبعد هذا يا سَراة مَواطني","نَرضى ونَقنع بالمعاش الأرذل",0,"ل",1,0],["أَفَبِالصَليبِ وَمارَ سَرجِسَ تَتَّقي","شَهباءَ ذاتَ مَناكِبٍ جُمهورا",1,"ر",2,0],["أَفَبَعدَ مَترَكِهِم خَليلَ مُحَمَّدٍ","تَرجو القُيونُ مَعَ الرَسولِ سَبيلا",2,"ل",2,0],["أَفَبَعدَ ذاكَ وَبَعدَ ما ذَهَبَ الَّذي","يَزَعُ الفُؤادَ عَن أَن يُصَبَّ ذَهابُهُ",3,"ب",2,0],["أفبلي الآن من شواطئ أحلا","مي وردّي عليّ نفح العبير",4,"ر",1,0],["أَفَبَعدَ شَمسِ الفَضلِ يُوجَدُ مُكرِمٌ","لِلضَّيفِ بالإِطعَامِ والإجلاَلِ",5,"ل",1,0],["أفبعده تبغي الحياةَ إذن فلا","دفع البكا منا عليه غليلا",6,"ل",2,0],["افبعد الهوى أضل على علم","بآيات حسنك الباهرات",7,"ت",1,0],["أفبعد مقتل مالك بن زهيرٍ","ترجو النساء عواقب الأطهارِ",8,"ر",1,0],["أَفبعْدَ تَسْييري لكمْ مِدَحاً","حُدِيَتْ بِهنَّ الأَينُقُ الرُّسُم",9,"م",1,0],["أفبَعْدَ ما نَمّت به أنفاسُه","أبْغي على الغَدَراتِ منه دَليلا",10,"ل",2,0],["أفبَعْدَ إبْلائي وإنْ لم يُرضِكم","أيّامَ صِدْقٍ كُلُّها مَشْهود",11,"د",1,0],["أفبَعْدَ هذا للخلائقِ ريبة","في أنَّ سِرَّ اللهِ في إعلائه",12,"ا",3,0],["أَفبعد هَذا غاية","إِن كانَ هَذا ما كَفى",13,"ف",2,0],["أفبعد ذلك يليق بشاعر","يشدو ومن يشدو به لا يذكر",14,"ر",1,0],["أَفَبَعدَ مَقتَلِكُم بُجَيراً عَنوَةً","تَرجونَ وِدّاً آخِرَ الأَيامِ",15,"م",1,0],["أفَبِدعاً إن قُلتُ يا دارُ حُيّي","تَ وَيا رَبعَهُم عَلَيكَ السَّلامُ",16,"م",1,0],["أفبعد سكناك الفؤا","دَ أتيت تسلبهُ الحراك",17,"ك",1,0],["أفبالحشاشة ما تزال ذبالة","تستمطر المجهولَ من شجراتهِ",18,"ت",2,0],["أفَبالحسين وجدتَ كهفك فامحَّت","صوَرث الذي قد كنتَ من حسناتهِ",18,"ت",2,0],["أفبعد ذاك البدر زارك زائرٌ","إلّا ليسأل أين أصبح ذاكا",19,"ك",2,0],["أفبعد أحمد تحمد الدنيا وبع","دك يا علاء الدين يحلو المربع",20,"ع",1,0],["أفبعد ذلك يبتغي من مادح","مدحاً كفاه بذا ثناً وكفاني",21,"ن",2,0],["أفبعد إبرهيم تُحمَد صحبتي","أو بعد ليلى تُشتَهى نجوائي",22,"ي",1,0],["أفبعد ما قلب المجن الدهر لى","وأراش أسهم كيده بحقود",23,"د",1,0],["أفبالزهرِ تُقنعينا من الده","رِ سفاهًا كأننا سُفهاء",24,"ا",2,0],["افبعد ما صروا على أثمانها","عابوا لقد قلبوا الحديث وجاروا",25,"ر",3,0],["أفبعد هذا كله يصفو لنا","عيشٌ وقلبك مفعم تفجيعا",26,"ع",2,0],["أفبعدَ ذَا الإِنصافِ وَيحكمُوا سِوَى","مَحضِ العِنادِ وَنخوةِ الشَّيطانِ",27,"ن",1,0],["أفَبَينَهُم خُلفٌ بِأنَّ مُرَادَهُم","حَرَمُ الإِلَهِ وَقِبلَةُ البُلدَانِ",27,"ن",1,0],["أفَبَينَهُم خُلفٌ بِأنَّ مُرَادَهُم","مِنهُ رَسُولُ اللهِ ذُو البُرهَانِ",27,"ن",1,0],["افبعد ما كملت صفاتك في العلى","وترشحت كفاك للتقبيل",28,"ل",1,0],["أفَبعدما برحَ الخفا أصبو على","قولِ الغُواة التائهين بفَدفدِ",29,"د",1,0],["أفبدعاً أنْ قلتَ يا ربعُ حُيّيتَ","ويا دارَهم عليك السلام",30,"م",1,0],["أفباطل أم صار حقاً أنها","تحكي لنا أمصار ذي الإيوان",31,"ن",1,0],["افبعدما ائتلفت ضمائرنا هوى","وتمازجت بمحبه ووداد",32,"د",1,0],["أَفَبَعدَ أَملاكٍ مَضَوا مِن حِميَرِ","يُرجى الفَلاحُ وَلاتَ حينَ فَلاحِ",33,"ح",1,0],["أفبعد أخواني الألى","درجوا أخاف اليوم فقدا",34,"د",2,0],["أَفَبَعدَهُم أَو بَعدَنا","أَنثى وَلا جَرَتِ القِداحُ",35,"ح",1,0],["أفبعد تحرير الرقيق جميعه","ترضون رق سلائل الأحرار",36,"ر",1,0],["أَفَبَعد ما جاءَ الكتاب مفصلاً","تَتَفاضل البَلغاء في أَقوالها",37,"ا",1,0],["أفبعد هذا الاتفاق يصيبنا","نزغ ليفتننا من الشيطان",38,"ن",1,0],["أفبعد عهد اللَه نقلته","والقتلُ بعد أمانهِ سرفُ",39,"ف",1,0],["أَفَبِانتِظارِكَ أَلبثَنَّ لَدَيهِما","أَم أُبلِغَنَّ وَأَرجِعَنَّ مُخَوِّدا",40,"ا",1,0],["افبعدها تَرجو الأَعادي دولة","هَل يَبتَغون إِلى السَماء سَبيلا",41,"ل",2,0],["أفبَعد مَن ولدت نسيبةُ أشتكي","زوّ المنيةِ أو أرى أتوَجَعُ",42,"ع",1,0],["أفبالعذلِ يدفعُ الوجدُ هيها","تَ وحبيّكَ ذاك منه بعيدُ",43,"د",1,0],["افبعد هذا من ملا","م او خصام من مشاغب",44,"ب",1,0],["افبعدها تسمو لهاشم ذروة","والخطب هدم وقعه بنيانها",45,"ن",3,0],["أَفبَعْدَ هَذَا هَلْ أُلامُ بِقَوْلَتِى:","لَمْ يَكْتَرِثْ لِصُراخِ طِفْلٍ جَوَّعَهْ",46,"ع",2,0],["أفبعد اللاءاتِ هذي سيأتي","عامُكم للعطاءِ خِصْباً ودأبا؟",47,"ب",2,0],["أفَبَعْدَ ذلكَ سَوْفَ تَكْفُرُ يا فَتى","وَسَتَسْتَمِرُّ بِخَلْطِ شَكِّكَ باليَقينْ",48,"ن",1,0],["أفبعده تبغي الحياة إذن فلا","دفع البكاء منا عليه غليلا",49,"ل",2,0],["أَفَبَعدَ رَبكَ قد تَخافُ عبادَهُ","ما بالُ قَلبكَ إذ سُلِبتَ مِنَ الأَمَلْ ِ",50,"ل",1,0],["أَفَبعدُ يا زَمنَ العَجائبِِ لا تَعي","وَجَعي وَتعلَمُ ما الَّذي أبكانيْ!!",51,"ن",2,0],["افبتُّ أضمُّ الرّثكبتينِ إلى الحثا","كأنِّي راقي حَيَّة ٍ أو سَليمُها",52,"م",3,0]]}