54397","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45126","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94386","الطويل"],[4362,"","https://poetry.dctabudhabi.ae/diwan/poem/146021","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72843","الطويل"],[4658,"","https://poetry.dctabudhabi.ae/diwan/poem/111554","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52130","الطويل"],[4791,"ارهابكم مايهز الدين","https://www.poetsgate.com/ViewPoem.aspx?id=36908",""],[4899,"تاصلك في روما","https://www.poetsgate.com/ViewPoem.aspx?id=176820",""],[4915,"أُستاذُ إبليس","https://www.poetsgate.com/ViewPoem.aspx?id=211418",""],[4929,"الموت القادم من الصين","https://www.poetsgate.com/ViewPoem.aspx?id=211016",""],[4955,"أسرج القلب بالتفاؤل تسعد","https://www.poetsgate.com/ViewPoem.aspx?id=204805",""],[4119,"وفت لك الدنيا بميعادها","https://www.poetsgate.com/ViewPoem.aspx?id=16127",""],[5136,"قوم غذتهم لبان العز والكرم","https://www.poetsgate.com/ViewPoem.aspx?id=121938",""],[5183,"منزل الشان","https://www.poetsgate.com/ViewPoem.aspx?id=180213",""],[5189,"توبة","https://www.poetsgate.com/ViewPoem.aspx?id=198420",""],[5219,"منة الرحمن في بردة النبي العدنان","https://www.poetsgate.com/ViewPoem.aspx?id=195106",""],[2365,"رماك الدّهر بالخطب الجليل","https://www.poetsgate.com/ViewPoem.aspx?id=200653",""],[5356,"همسُ اشتياقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=204474",""],[5596,"لطف الاعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=206379",""],[5720,"هَنِيئَاً ..","https://www.poetsgate.com/ViewPoem.aspx?id=198965",""],[5751,"سلامٌ لعينيك","https://www.poetsgate.com/ViewPoem.aspx?id=215002",""],[5897,"صبراً .. دمّاج","https://www.poetsgate.com/ViewPoem.aspx?id=156532",""],[5930,"رياح الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=87028",""]],"verses":[["تَبَوَّعَ بي إِلى قُلَلِ المَعالي","وَخَيَّرَني المَعاقِلَ وَالحُصونا",0,"ن",2,0],["تبَوّأهَا مِنْ خِيرَةِ الرّسْلِ مَنْ سَمَتْ","بهِ ليْلَةَ المِعْراجِ فيها المَطامِحُ",1,"ح",1,0],["تَبَوَّأَ هَيْكَلٌ بِالحَقِّ فِيهِمْ","يُجَشِّمُهُ الثِّقَالُ مِنَ الهُمُومِ",2,"م",1,0],["تَبَوَّأُوا منه بدار كرامةٍ","فالكل بين مقرّبٍ ومنعَّمِ",3,"م",1,0],["تبوَّأ عرش الملك لا بحُسامه","ولا كان في يوم له الشعب ناخبا",4,"ب",2,0],["تَبَوَّأتُ مِن قَرمَي مَعَدٍّ كِلَيهِما","مَكاناً أَراني كَيفَ تُبنى المَفاخِرُ",5,"ر",1,0],["تبول فترمي بالجنين ولم تجد","مخاضاً ولم يُعتَد لها فيه مَثْبِر",6,"ر",1,0],["تَبوخُ المَعالي إِذا لَم يَكُن","بِكَفَّيكَ إِذكاءُ نيرانِها",7,"ن",3,0],["تُب وَثُب وَاِدعُ ذا الجَلالِ بِصِدقٍ","تَجِدِ اللَهَ لِلدُعاءِ سَميعا",8,"ع",2,1],["تَبَوَّأَ جَنَّةَ الفِردوسِ داراً","وَحَلَّ عَلى الأَرائِكِ في ظِلالِ",9,"ل",1,0],["تَبَوَّأَ مِن رَسمِ الوِزارَةِ رُتبَةً","تَمَنّى مَراقيها النُجومُ مَراقِيا",10,"ي",2,0],["تَبورُ مَذاهبُ الزُّعماءِ إلا","إذا جاءوا الرّوائعَ مُعجِزينا",11,"ن",2,0],["تَبوكُ اشْهَدِي نَزَواتِ الذّئاب","وحَيِّ الأسودَ وأشبالها",12,"ل",3,0],["تَبّوأَ الكاظِميُّ الخلدَ مَنزِلَةً","يَلقى مِن اللَه فيها خَيرَ تَرحيبِ",13,"ب",1,0],["تَبَوَّأَ قابَ قوْسَيْنِ اخْتصاصاً","وَلا وَاشٍ هناكَ وَلا رقيبُ",14,"ب",1,0],["تَبوحُ بِسِرِّكَ ضيقاً بِهِ","وَتَبغي لِسِرِّكَ مَن يَكتُمُ",15,"م",1,1],["تَبَوَّأَ الشَخصُ مِن غَبراءَ مُظلِمَةٍ","قَرارَةً بَعدَما أَزرى بِهِ القَلَقُ",16,"ق",1,0],["تَبُوحُ بفَضْلِكَ الدّنيا لتَحظى","بذاكَ وأنتَ تَكْرَهُ أنْ تَبُوحا",17,"ح",2,0],["تبوأ عرشاً في السموات ديان","فناصبه فيها العداوات شيطان",18,"ن",1,1],["تَبَوَّعُ رِسْلاً في الزِّمَامِ كَمَا نَجَا","أَحَمُّ الشَّوَى فَرْدٌ بِأَجْمَادِ حَوْمَلاَ",19,"ل",2,0],["تَبُوخُ بِهَا الأَنْفَاسُ وَهْيَ نَسَائِمٌ","وَتَعْفُو بِهَا الأَبْدَانُ وَهْيَ صعِيدُ",20,"د",1,0],["تَبَوَّأْتَهُ مَنْصِباً لا يَقُو","مُ بِأَعْبَائِهِ المُبَشِّرُ المُؤْدِمُ",21,"م",1,0],["تَبَوّأ الخُلدَ مُطمَئِنّاً","وَاِشفَع غَدا إِذ أَبوكَ جاثِ",22,"ث",1,1],["تَبُوعاً لآثِارِ السَّرِيَّةِ بَعْدَمَا","رَأَيْتُكَ بَرَّاقَ الْمَفَارِقِ أيْسَرَا",23,"ر",2,0],["تبوَّأ في المجد بُحبوحةً","على مثلها يكَمد الحاسدونا",24,"ن",2,0],["تبوأ عرشَ الشمسِ غصباً وردَّها","لها الغربُ والإظلامُ سجنٌ وأغلالُ",25,"ل",1,0],["تَبَوَّأتَها فَكَأَنَّ الجِبالَ","حَلَّت بِأَرجائِها وَالبِحارا",26,"ر",2,0],["تُبْ وسامحْ، لا تبارحْ","سوف آتي بعدُ فَوْرا.",27,"ر",2,0],["تبول من شدق مهزول به عجفٌ","وقد تفقا عليه بظرها سمنا",28,"ن",2,1],["تَبَوَّأْتَ جَنَّاتِ النَّعيمِ وَلَمْ تَزَلْ","نَزيلَ الثُّرَيَّا قَبْلَهَا والنَّعَائِمِ",29,"م",1,0],["تَبوحُ بِشَكواها وَتَكتُمُ دَمعَها","وَأَكتُمُ وَجدي وَالدُموعُ تَسيلُ",30,"ل",1,0],["تَبوحُ دُموعي وَاللِسانُ صَموتُ","وَيَحيى غَرامي وَالعَزاءُ يَموتُ",31,"ت",1,1],["تبوأْتَ القلوبَ سريرَ ملكٍ","غداة بذلتَ تاجَك والسريرا",32,"ر",2,0],["تَبوّأتَ مِن حكمِ اِبن داوودَ منزلاً","لِغيركم ما إن يرى قط من بعدِ",33,"د",1,0],["تَبوّأ من نفس الوزير مكانةً","تُنافسهُ في نيلها أعينُ الشهبِ",34,"ب",1,0],["تَبَوَّأَ فيها الوَردُ وَجنَةَ جَنَّةٍ","وَمَن بُوِّئَ الجَنّاتِ فَهوَ مُخَلَّدُ",35,"د",1,0],["تُب وابكِ نُحْ بُحْ تَمحُ من ذاك السَحا","ذَنباً دَهاكَ بِمَنظرِ اِبنِ سَحاءِ",36,"ا",2,0],["تبوا الجودُ يُمناهُ محلاً","فَلَيسَ يَهُمُّ عَنها بارتَحالِ",37,"ل",1,0],["تبوَّءُوا الأرضَ ولم يُخبِروا","عن حَرِّ مَثْواهُم ولا بَرْدِهِ",38,"د",2,0],["تَبَوَّأْتَ منها مقعدَ الصّدق مُكْرَماً","ونلْتَ مقاماً عند ربّك عاليا",39,"ي",2,0],["تبوأ من صدر المعالي مراتباً","فجاءَ سعيداً وهو باللَه رائدُ",40,"د",1,0],["تبوَّأَ ممنوعَ القلوبِ ومُهِّدَتْ","لَهُ أَذرُعٌ محفوفَةٌ ونُحُورُ",41,"ر",1,0],["تبوَّعَ في خَلِّ الثغورِ فسدَّها","وأسفرَ في سُودِ الخطوب فجلَّاها",42,"ا",3,0],["تبوّع تهتز منه الضلو","عُ بين المرنَّح والجالسِ",43,"س",1,0],["تَبوَّجَ برْقُ البِشْرِ من وجْهٍ ماجِدٍ","تألُّقُهُ في رَوْنَقِ الصُّبْحِ لامِعُ",44,"ع",1,0],["تَبوحُ القِلادَةَ مِن سِرِّهِ","بِما لا يَبوحُ بِهِ تاجُهُ",45,"ج",2,0],["تَبَوَّأنَ بيضاً فِي أَفاحِيص قَفرةٍ","فَهُنَّ بِفَيفاءِ الفلاةِ وَدائِعُ",46,"ع",1,0],["تب وزك واعف واغفر واسترن","سترا حصينا في أمان أماني",47,"ن",2,0],["تَبوعٌ لِلحَليلَةِ حَيثُ كانَت","كَما يَعتادُ لَقحَتَهُ الفَصيلُ",48,"ل",1,0],["تبوَّأ إذا ضاق الخناق ظلالنا","وخذ عروةً في الحادثات حبالنا",49,"ن",2,1],["تَبوَّأتَه عرشَ العُروشِ وكيفَ لا","ومن خيرِ خلقِ اللهِ قد جاوَرَ القَبرا",50,"ر",2,0],["تَبوعٍ لحوقٍ في يديهِ طِلابه","وَما كلُّ باغٍ فائزاً بطِلابِ",51,"ب",1,0],["تَبوح بذكراها وَتَحكى شُعورَها","وَتُروى رؤاها صادِقاً وَالمَعانيا",52,"ي",2,0],["تبوأ بالفردوس ممدود ظله","وأصبح من قصر يسير إلى قصر",53,"ر",1,0],["تبوحُ بأسرار الحديثِ كأنّها","وشاةٌ بتنقيلِ الأحاديث تُولعُ",54,"ع",1,0],["تَبوّؤا الدارَ والإِيمانَ قَبلُ وَقَد","آووا وَفَوا نصروا فازوا شَرَفا",55,"ف",2,0],["تبوأ من بيت النبوة مفخراً","علا في السماء فوق قطب الكواكب",56,"ب",1,1],["تبوّأت من خل بفكر جَنانه","ربيع سؤال ارتعي في جِنانه",57,"ن",2,1],["تَبوغُ بِها في الجَوِّ مِن غَيرِ فَترَةٍ","كَأَنَّ مَجاذيفا تَبوغُ بِها مَعا",58,"ع",2,0],["تَبَوَّأَها خَيرُ البَرايا وَمَن لَهُ","إِلى أَوجِ أَفلاكِ السَماءِ عُروجُ",59,"ج",1,0],["تَبَوأ أَفعال الشقاء جَميعها","فَمُستَقبلا منها وَحالا وَماضيا",60,"ي",2,0],["تَبَوَّأْ مِنَ الأَرْضِ ما شِئْتَهُ","فقد مكَّنَ اللهُ في الأَرضِ لَكْ",61,"ك",1,0],["تبوأت بين الموت والهون موضعاً","اقرك فيه خطبك المتفاقم",62,"م",1,0],["تَبُوعٍ لِنَفسٍ بالمَعاصِي مَشُوقَةٍ","تَحِنُّ حنِينَ البِكرِ لِلخُسرِ والمَكرِ",63,"ر",1,0],["تبوأ الدار وعذ بالحمى","لا ضر بعد اليوم يا طالب",64,"ب",1,0],["تبوأ من قحطان بيتاً تُقلُّهُ","قواعدُ بنيان العتيك وسوُرُها",65,"ر",3,0],["تبوَّأتَ من نبهانَ أَشرفَ رتبةٍ","وحزت اللبّاب المحضَ والحسبَ الصّردا",66,"د",2,0],["تَبوأَ بيتاً في العَتيكِ عمادهُ","ظُبا الهند والجُرُد العتاقُ السّوابحُ",67,"ح",1,0],["تبوّأ يحيى وُدّ لا من يرُدّهُ","طريدا ولا ينساه حين يغيب",68,"ب",1,0],["تَبوَّأَتِ العرشَ في مقلتي","ظَلومٌ كنيرونَ في شانِها",69,"ن",3,0],["تَبَوَّأتُهُ ما امتدّ لي فيه جانب","فلمّا نأى لم أتّبِع فَيئةَ الظلّ",70,"ل",1,0],["تَبَوَّأ من دارِ الخلافةِ مَقْعَداً","له فيه عَنْ حُكْمِ القضاءِ مَئاب",71,"ب",1,0],["تبوأ بالردى داراً طروحا","ودار الموت نازح طراح",72,"ح",1,0],["تَبَوَّأتُ بَعدَكَ قَعرَ السُجونِ","وَقَد كُنتُ أَرثي لِزُوّارِها",73,"ر",3,0],["تبوأتم من مهجَتي خير مقعد","فَلا تَقبلوا المضنى بِبَينكم صبرا",74,"ر",2,0],["تبوّأ من ذراه خير دارٍ","فلم يخطر لمكروهٍ ببال",75,"ل",1,0],["تبوأ من لخم وناهيت مقعداً","مكان رسول الله من آل هاشم",76,"م",1,0],["تبوج لماع العقيقة مومض","وايماض لمع البرق للصب معرض",77,"ض",1,1],["تبوء في المجد المؤثل منزلاً","تمنت تراه في الفخار ثرياه",78,"ا",2,0],["تَبَوَّجَ مُستَشرِياً في الظَلامِ","إِذا اِبتَدَرَ الأُفعُوانُ الوِجارا",79,"ر",2,0],["تَبَوَّعَ لي مَدّاً إِليها مُعَظَّمٌ","إذا لاحَ أَغْضَيْنَ العيونُ اللَّوامِحُ",80,"ح",1,0],["تبوح لديه المشكلات بسرها","وتبرز من مكنونهن الدسائس",81,"س",1,0],["تبوء بها والليل غار بنجمه","فانجد منه البعض والبعض قد غارا",82,"ر",2,0],["تبوأ الشرقَ بعد الغرب منزلةً","وهكذا كوكب الأفلاك مسراه",83,"ا",2,0],["تبوج في وطف روايا كأنما","بأرجائه أقراب باق ضوارح",84,"ح",1,0],["تَبولُ العُنوقُ عَلى أَنفِهِ","كَما بالَ ذو الوَدعَةِ الأَرغَلُ",85,"ل",1,0],["تَبوع بأَيديها اليباب إِذا مَشَت","كَأَيدي تجار للثياب تبوع",86,"ع",1,0],["تُب وَخِف اللَه عَلى","كَفك مِما اِجتَرحت",87,"ت",1,0],["تبوأت تخت الملك والله ناصرٌ","فكبرت الاسلام والدين وحدا",88,"د",2,0],["تبوّأ من بحبوحة الفضل رتبة","بغير سناها نير الفضل لن يركا",89,"ك",2,0],["تبوأ عرش اليمن والفضل والتقى","وشاورهم في الأمر عدلا مشرعا",90,"ع",2,0],["تبوأ من الدنيا المخازي وانتظر","اذا قيل في الاخرى تبوأ جهنما",91,"م",2,0],["تبوأ الرتبة العليا ومد يداً","جنى بها ثمرات المجد واقتطفا",92,"ف",2,0],["تبوأ من فوق الوزارة رتبة","فلا رابع الجوزاء إلا سريرها",93,"ر",3,0],["تبوأتم من ذروة المجد مقعداً","غدا دونه نشر السما ومغانمه",94,"م",2,0],["تبوّأَ عَرشَ العزِّ في الأَرض بَعد ما","قَضى ذلَّه في أَول الجن وَالبَشر",95,"ر",1,0],["تبوّأ منها موضع النسك والتُقى","وجاورت الحيتان في صرحها الطيرا",96,"ر",2,0],["تبوّأ من لحج الفسيحة معقلاً","يذكرنا إيوان كسرى وغمدانا",97,"ن",2,0],["تبوّأ فوق هام النجم بيتاً","له آباؤه قدما بناة",98,"ه",1,0],["تبوّأ من بطحاء مكة منزلاً","فأشرق فيها للورى بدره تمّا",99,"م",2,0],["تبوّأ في ذرى لحج فأمست","به حرماً يحجّ له العباد",100,"د",1,0],["تبوّأ من المجد بُحْبوحةً","على مِثلها يُكمِدُ الحاسدينا",101,"ن",2,0],["تبودا الدار والإيمان وارتضوا","ثدى السماح وفيهم جاء تنزيل",102,"ل",1,0],["تبَواءَ عرشَ سُلطنهِ بعزّ","لهُ تُحنى المَناكبُ وَالرؤوس",103,"س",1,0]