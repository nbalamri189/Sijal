03",""],[5582,"هَلْ مِنْ مُجِيدٍ لِي بِأَنْباءِ","https://www.poetsgate.com/ViewPoem.aspx?id=186648",""],[5582,"صَبٌّ بِدِرَّةِ ثَدْيِ الحُبِّ مَلْبُونُ","https://www.poetsgate.com/ViewPoem.aspx?id=63587",""],[5582,"عُوجُوا فَحَيُّوا مَغانِي رَبَّةِ الخالِ","https://www.poetsgate.com/ViewPoem.aspx?id=63561",""],[5582,"دَعني من التفنيدِ والتأنيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=63468",""],[5582,"خلّ المتيّم في نهج الغواياتِ","https://www.poetsgate.com/ViewPoem.aspx?id=63473",""],[5582,"أَنَوارُ هَلْ مِنْ زَوْرَةٍ أَنَوارُ","https://www.poetsgate.com/ViewPoem.aspx?id=63507",""],[5660,"غَيداءَنا أَهلاً وَ سَهلاً","https://www.poetsgate.com/ViewPoem.aspx?id=32527",""],[5674,"أعمى الزمان قصيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=186707",""],[5714,"أشذى من الفل","https://www.poetsgate.com/ViewPoem.aspx?id=213798",""],[5736,"نيفين","https://www.poetsgate.com/ViewPoem.aspx?id=208413",""],[5736,"ألق","https://www.poetsgate.com/ViewPoem.aspx?id=208866",""],[5992,"انظر إلى النخل للأَردانِ نافضةً","https://www.poetsgate.com/ViewPoem.aspx?id=41845",""],[5997,"الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=214294",""],[6078,"من دُرِّها المكنون","https://www.poetsgate.com/ViewPoem.aspx?id=202772",""],[6084,"حيت تزف سلافة الصهباء","https://www.poetsgate.com/ViewPoem.aspx?id=170811",""],[6102,"وهم الحب","https://www.poetsgate.com/ViewPoem.aspx?id=185329",""],[6237,"باقة إلى عابرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77864&r=&rc=6",""]],"verses":[["غيدٌ قِصارُ الخُطا إِن واصَلَت قَصُرَت","فَلَم تَطُلْ لِلَيالي الصَبِّ أَعمارُ",0,"ر",1,0],["غيدآء تسفرُ عن محاسنٍ دُميَةٍ","حلت بصدغي شعرها محرابا",1,"ب",2,0],["غيد بدت فتولَّى الظبي من حنقٍ","يسعى وأطراف غصن البان من خجل",2,"ل",1,0],["غيدآء وشَّحها ظل وخلخلها","ماء فقد ظهرت في منظرٍ حالي",3,"ل",2,0],["غيداء أستجلي البدور لوجهها","إذ ليس حظِّي منه غير عيان",4,"ن",1,0],["غيداء من ماء الشباب الأغْيَدِ","كأنما ترنو بِعيْنَيْ فَرْقدِ",5,"د",1,0],["غيداءُ في سنّ الغلا","مِ وَنَبْتُ شاربِهِ شَكيرُ",6,"ر",1,0],["غَيداءُ قَد وَصَلَت ذَوائِبُها الثَرى","إِنّي لَأَحسُدُ ذَلِكَ المَوصولا",7,"ل",2,0],["غيداء ذات شعَر","مرجل ململم",8,"م",1,0],["غَيداءُ لاهِيَةٌ تَخُطُّ لِأَغيَدٍ","شِعراً لِيَقرَأَهُ وَأَنتَ القاري",9,"ر",2,0],["غَيداءُ عاجَلَها الزَمانُ بِنَكثِهِ","وَبِرَيبِهِ المُتَصَرِّفِ المُتَقَلِّبِ",10,"ب",1,0],["غيداءُ تاجُ الحسنِ من غيرها","يُضحي لديها وهو نَعْلُ القدم",11,"م",1,0],["غَيداءُ تَسحَبُ كُلَّما انعَطَفَتْ","مِنْ فرْعها ذيلاً على الذيلِ",12,"ل",1,0],["غيداءُ يُسقِمُ بالملاحةِ دَلُّهَا","جِسمَ العَميدِ كَذاكَ دلّ الغيدِ",13,"د",1,0],["غيدٌ زَرَيْنَ على القطا في مشيها","فلهنّ ساحاتُ القلوب بطاح",14,"ح",1,0],["غَيداءُ جادَ وَلِيُّ الحُسنِ سُنَّتَها","فَصاغَها بِيَدَيهِ رَوضَةً أُنُفا",15,"ف",2,0],["غِيدٌ يُغَازِلُهَا الرَّصَا","صُ وَهَلْ لَهُ أَنْ يَحْتَشِمْ",16,"م",1,0],["غِيدٌ لها من شذَى لُبنانَ نفحتُه","ومن مجانيه تُفَّاحٌ ورمَّانُ",17,"ن",1,0],["غيدُك قد أفْقَدْنَني صَوَابي","أهكذا يلعبْن بالأَلْباب؟",18,"ب",1,0],["غَيداء باهرة العُيون كَأَنَّها","شَمس وَلَكن لَم تَرعَ بِكُسوف",19,"ف",1,0],["غيداءُ أَغوى وأَزوى حبُّها","وكذا الغَيداءُ غيٌّ وداءٌ لُفِّقا لَقبَا",20,"ب",2,0],["غَيْداقَةٌ كالرُّؤى والحُسْنُ مِئْزَرُها","سَبَتْ فؤادي وخَطَّتْ في الهَوى قَدَري",21,"ر",2,1],["غِيدَ المُتُونِ خُصُورُهُنَّ لطائفٌ","حُمَّ التَّرائبِ والنُّحورِ حَوالِى",22,"ل",2,0],["غَيداءُ مُرسَلةُ النِقابِ وَراءَهُ","وَأَمامَهُ نَفَحاتُ عُرفِ المَندَلِي",23,"ل",2,0],["غيداءُ عرَّجَ بي عليها أغيدٌ","في دارها أنعِم بذاكَ الأغيدِ",24,"د",1,0],["غيداء من خدرها زفّ محاسنها","عذراء بكر المعاني غرة الغرر",25,"ر",1,0],["غِيدٌ كمُحْمَرّ الشَّقيقِ خدُودُها","وعيونُها كَمطافِل الآرامِ",26,"م",1,0],["غيدٌ من الغيب تُجلى بالجمال فيا","لله مجلى بديع الميس والهيف",27,"ف",1,0],["غِيدٌ نَصَبْتُ لِصَيْدِهِنَّ حَبائِلاً","يَعْلَقْنَهُنَّ فَكُنْتُ فِيها أَعْلَقا",28,"ق",2,0],["غيداءُ مولعة بالتيه عابثة","بالعاشقين كذاك الخد والغيدُ",29,"د",1,0],["غَيداءُ غاداها فِراقي بِالأَسى","وَأَذاقَها البُرَحاءُ وَشكُ بَراحي",30,"ح",2,0],["غِيدٌ عَلَى مِرْآةِ حُسْنٍ تَنا","فَسْنَ فَأَذْرَيْنَ دُمُوعَ الخِصامْ",31,"م",1,0],["غَيْداءُ جَيْدَا عَبْقَرهْ","سَعْطاءُ فَرْعَا عَبْهَرَهْ",32,"ه",1,0],["غَيداءُ آنِسةٌ نَفُورٌ عِندَها","يَحيا الرَّجاءُ وَيُقتَلُ التَوفيقُ",33,"ق",1,0],["غيد حكين شموسنا وبدورنا","نوراً وحسنا حبذا ذي الغيد",34,"د",1,0],["غَيداءَ بِكرٍ غادَة رُعبوبَة","في غَيرِ فِكرك مِثلها لَم يهجسِ",35,"س",1,0],["غَيداء مِنَ الفَخارِ عزّاً","يَعلو بِكَ قَدرُها الفخيمُ",36,"م",1,0],["غَيداء بِكر غادَة رعبوبة","في حُسنِ وَجهٍ في بَديعِ قوامِ",37,"م",1,0],["غَيداءُ بِنتُ فَصاحَةٍ وَبَلاغَةٍ","فيها البَديعُ لَقَد أَقامَ وَخيَّما",38,"م",2,0],["غَيداء رُعبوبة رود مُخدّرة","عَذراء بِكر رَداح كاعِب نَهدا",39,"د",2,0],["غَيداءَ غانِيَةً هَيفاءَ مائِسَةً","حَسناءَ طالِعةً كَالشَّمسِ وَالقَمرِ",40,"ر",1,0],["غَيداء بِنتُ البَها جَلَّت مَحاسِنُها","بِكرٌ مِن الغيدِ فيها تَفخَر الغيدُ",41,"د",1,0],["غَيداء بِكر عَروس مِن بَلاغَتها","تَتيهُ حُسناً عَلى أَترابِها العُرُبِ",42,"ب",1,0],["غَيداءَ بِكراً غادَةً في حُسنِها","مِنها لَقَد خَجِل المَها والخُرَّدُ",43,"د",1,0],["غَيداءَ بِنتُ الأُسدِ تَرتَعُ في الفَلا","وَهيَ الغَزالَةُ في الكناسِ المُحتمي",44,"م",2,0],["غيداءُ باهيةٌ حسناءُ زاهيةٌ","بثوب حسنٍ بنور الحسن منسوج",45,"ج",1,0],["غيدَاءُ لمياءُ مفلوجٌ مُقَبَّلُها","حسناء تختال في سكر الصِّبا مَرَحا",46,"ح",2,0],["غيدٌ حسانٌ ترى الشمس المنيرةَ مِنْ","وجوههنَّ سراجاً غيرَ وَهَّاج",47,"ج",1,0],["غِيدٌ نَفَرنَ وَقَدْ أمَتُّ تَوَلُّهِي","فَأعَدْنَهُ حَيَّا كَمَا قَدْ كَانَا",48,"ن",2,0],["غيد بغور حشاشتي قد اتهموا","إذ أنجدوا بالمنحنى من أضلع",49,"ع",1,0],["غِيدُ إذَا صِحْنَ يَالَ حَاجِرْ","جاءتْ سَرَايَا غَزْوِ المِلاَحْ",50,"ح",1,0],["غِيدٌ إذَا هَزُّوا المَعَاطِفَ لَنْ ترى","إلاَّ صريعًا بَيْنَهُنَّ طَعِينَا",51,"ن",2,0],["غيداءُ لَو بعتُها روحي بقلمةِ ما","تحتَ اللثامِ فإنّي لست مغبونُ",52,"ن",1,0],["غيداء أَحسن مَن مَشى","فيما رأيتُ عَلى قَدم",53,"م",1,0],["غَيداء إِن خَطَرت يميسُ قَوامها","ميسَ القضيبِ الأملسِ الميّاسِ",54,"س",1,0],["غيداءُ ساميةٌ ريداء ضاميةٌ","هيفاءُ ناميةٌ تسمو بأخدانِ",55,"ن",1,0],["غيداء يَفتنني منها إِذا سفرت","شخصٌ لها ببديع الحسن فتّانُ",56,"