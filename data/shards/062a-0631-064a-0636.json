{"poems":[[82,"بلى جر أذيال الصبا فتصابى","https://www.aldiwan.net/poem31242.html","الطويل"],[82,"متى صدرت عيناك عن أرض بابل","https://www.aldiwan.net/poem31321.html","الطويل"],[50,"لقد طال في رسم الديار بكائي","https://www.aldiwan.net/poem10413.html","الطويل"],[251,"نأتك بليلى دارها لا تزورها","https://www.aldiwan.net/poem56333.html","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96991","الطويل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67909","المتقارب"],[2855,"","https://poetry.dctabudhabi.ae/diwan/poem/203176","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83594","الطويل"],[3749,"رفاهية الشهم اقتحام العظائم","https://www.poetsgate.com/ViewPoem.aspx?id=134962",""],[5525,"لا تعقد الحبل","https://www.poetsgate.com/ViewPoem.aspx?id=7191",""],[6001,"امل عمري","https://www.poetsgate.com/ViewPoem.aspx?id=404",""]],"verses":[["ترَى ضَحِكَ الإصباحِ فوق جبينهِ","وَقُمّصَ من ليلِ المُحَاقِ إهابا",0,"ب",2,0],["تَرى ضَيغَمَ الأَبطالِ يَعنو لِعِزِّهِ","ذَليلاً كَما استَخذى أَكيلٌ لآكلِ",1,"ل",1,0],["تَرى ضَوءَها مِن ظاهِرِ الكَأسِ ساطِعاً","عَلَيكَ وَإِن غَطَّيتَها بِغِطاءِ",2,"ا",2,0],["ترى ضُعفاءَ القومِ فيها كأنّهم","دعاميصُ ماءٍ نشَّ عنها غديرُها",3,"ر",3,0],["ترى ضوءها أهل السماء كما ترى","لدى الأفق أهل الأرض نور الكواكب",4,"ب",1,0],["ترى ضبَّها مُطلِعاً رأسَهُ","كما مَدَّ ساعِدَهُ الأقطعُ",5,"ع",1,1],["تَرَى ضَيْفَها فيها يَبيتُ بِغِبطةٍ","وجارُ ابنِ قَيسٍ جائعٌ يتحوَّبُ",6,"ب",1,0],["تَرَيَّضت وَالعشاق في رَوضِ حبّكم","وَلِلَّهِ رَوضٌ قَد جَنى زَهرَهُ النَحلُ",7,"ل",1,0],["ترى ضمت الأفلاك ملكاً كيوسف","من الجبل اللاتي خلت في الأقادم",8,"م",1,0],["ترى ضرب الفيافي ما يجي للخايف المحتار","أمانه لاتعقد الحبل ثمٍ تعجز تحله",9,"ل",2,0],["ترى ضاقت بي ايامي وصبري قد وصل حدَّه","انا ملّيِت من نفسي واخاف انه الأمل مفقود",10,"د",1,0]]}