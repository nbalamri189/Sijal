iewPoem.aspx?id=138783",""],[4984,"المحجَّة البيضاء .","https://www.poetsgate.com/ViewPoem.aspx?id=191139",""],[460,"صرمت سعيدة ُ ودَّها وخلالها","https://www.poetsgate.com/ViewPoem.aspx?id=22229",""],[5189,"هل بات فؤادك مغشيا","https://www.poetsgate.com/ViewPoem.aspx?id=191692",""],[307,"مرآة الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=215293",""],[5502,"إن كنت تبحث عن تراث عمان","https://www.poetsgate.com/ViewPoem.aspx?id=124955",""],[5602,"في موعد آخر لم نلتق","https://www.poetsgate.com/ViewPoem.aspx?id=204903",""],[5829,"هل الهلال فهللوا","https://www.poetsgate.com/ViewPoem.aspx?id=180665",""],[5829,"محمرة الجفنين","https://www.poetsgate.com/ViewPoem.aspx?id=210426",""],[5970,"بعض عمر الفتي ليال تقضى","https://www.poetsgate.com/ViewPoem.aspx?id=130622",""],[6068,"فِي الْحَيِّ أَلْمَى شَادِنٌ -10-","https://www.poetsgate.com/ViewPoem.aspx?id=175790",""],[5309,"جذل وقلبي لا يزال عليلا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573525",""]],"verses":[["فبِمِثْلِ طاعَتِهِ الهِدايَةُ تُبْتَغى","وبفَضْلِ نائِلِهِ الخَصاصَةُ تُجْبَرُ",0,"ر",1,0],["فَبِما تَرَقرَقَ لِلمُتَيَّمِ بَينَها","غَلَلٌ شَفى حَرَّ الغَليلِ بُرادُ",1,"د",1,0],["فبمثل هديك فلتُنِزْ شمس الضحى","وبمثل قومِكَ فليفاخر من فَخَرْ",2,"ر",1,0],["فبمشكورين محمود مضى","وبمحمودين مشكور قُدم",3,"م",1,0],["فبما اعتلاه بدا عليه كسوفُه","وبما كساه تَلألأتْ أوضاحُه",4,"ح",2,0],["فَبِمَجلِسي صِرفُ المُدامِ","لَدى سَواقينا الجَوابي",5,"ب",2,0],["فَبِمَعروفِهِ الخِضَمِّ غَنِيٌّ","وإلى بأسه الحديدُ فقيرُ",6,"ر",1,0],["فبمكثِ الماءِ يبقى آسناً","وسُرى البدرِ بهِ البدرُ اكتملْ",7,"ل",1,0],["فَبِمِثلِها مِن تُربَةٍ قَد قُدِّسَت","نَثَرَ النَسيمُ قَلائِدَ الأَنداءِ",8,"ا",2,0],["فَبِمَا رحمةٍ مِنَ اللَّهِ لانَتْ","صَخْرةٌ مِنْ إبائِهم صَمَّاءُ",9,"ا",2,0],["فَبِما أَدخُلُ الخِباءَ عَلى مَه","ضومَةِ الكَشحِ طَفلَةٍ كَالغَزالِ",10,"ل",1,0],["فَبِمُهْجَتِي ثَوَرَانُ بُرْكَانٍ جَوَى","وَبِظَاهِري شَخْصٌ تَراهُ هَادِئاً",11,"ا",2,0],["فبمدحه أرجو النجا","ةَ ولنْ أكونَ به مَلُومَا",12,"م",2,0],["فبمن تسود حقوقُنا من بَعدكم","وبمن بها خير النجاح يجولُ",13,"ل",1,0],["فبمثل ذا عنَد الحسود وإنما","بسَخى القلوبِ تفاوُتُ الأحوالِ",14,"ل",1,0],["فبماذا ملكتُم دوننا إر","ث نبيّ الهدى بلا استِظهار",15,"ر",1,0],["فبمن أعزك واصطفاك فأجزل ال","نعمى عليك فحوض فضلك مترع",16,"ع",1,0],["فبماله شجن تملك قلبه في","مثله ذو الشجو ليس يوبخ",17,"خ",1,0],["فَبِمَن كَسا عِطفَيكَ أَفخَرَ حُلَّةٍ","لَيسَت عَلى مَلكٍ وَلا إِنسانِ",18,"ن",1,0],["فَبِمَدْحِهِ يَسْمُو الْقَرِي","ضُ وَيُسْتَطَابُ بِهِ النَّشِيدْ",19,"د",1,0],["فَبِمثلي تَحلو المُلوكُ وَتَلهو","وَتُناجي في المُشكِلِ الفَدّاحِ",20,"ح",1,0],["فبِمَ التعلُّلُ يا مليحةُ والهوى","ما ضمَّ أعطافاً ومسَّ بنانا",21,"ن",2,0],["فبمالهم ونُفوسِهم وشُعورِهم","جادوا ونحنُ نَفيكِ لا نُعطيك",22,"ك",1,0],["فبمَ العيون تقرُّ وسطَ طبيعةٍ","جذّاءَ يُنزعُ نضرها ونضارها",23,"ر",3,0],["فَبمثلكم نَرجو الجنان وَنأمن","النيران يوم نشاهد الاهوالا",24,"ل",2,0],["فَبِمَ العُفاةُ يُشَبِّهونَكَ في النَدى","وَالبَأسِ حارَت فِكرَةُ المُتَفَكِّرِ",25,"ر",1,0],["فَبِما شِئتَ فاِختبرني فإنّي","عَبدُ ودٍّ لمن يودُّ جَنابي",26,"ب",2,0],["فَبِمثلهِ فَليفرحِ الآباءُ إذ","بَهَرت مَحاسنهُ وطاب العنصرُ",27,"ر",1,0],["فَبِمَن عَن هَواهُ أَبغي اِشتِغالاً","وَلِتَفصيلِ جُملَتي فَهوَ كُلُّ",28,"ل",1,0],["فَبِمَغناهُ تَوَخَّتني المِنى","بَعدَ فَقري بِالغِنى عَن رَحلَتَي",29,"ي",1,0],["فبِمثْلهِنّ ومثْلِهم أَرمي العِدا","وبركضهِنّ وضَرْبهم أَبغي العُلا",30,"ل",2,0],["فبِما اعتاقَه سَقانا جَزاهُ ال","لَهِ عنَّا خَيراً عَلَى تَعويقِه",31,"ق",2,0],["فبماذا تُلقي عذارَيكَ قل لي","سِيَّما إن تَدارَكَ الشعر شعرُ",32,"ر",1,0],["فبما أكاتبُه أجيبَت دَعوتي","وفديتُه من سائِر الأسواءِ",33,"ا",2,0],["فَبِمَ التَخَلُص يَوم تَدحض حِجَتي","عَدلاً وَتَستَعلي عَلَيَّ خُصومي",34,"م",2,0],["فبمدحنا ما قد مضى من دهرنا","سقياً له عن ذم هذا نصرف",35,"ف",1,0],["فبِما أُهينُ النّفسَ في ِ","يوم الوغَى بينَ الصُّفوفِ",36,"ف",1,0],["فَبِماذَا قضيتَ يا سيّدَ الحك","كَامِ طُرًّا عليَّ أنّي مَلُولُ",37,"ل",1,0],["فَبمَعنٍ تَسمو وَزائِدَةِ الخَي","رِ وَعَبدِ الإِلهِ كُلٌّ نَماكا",38,"ك",2,0],["فبما نعمةٍ عليَّ وفضلٍ","أثقَلَتْني أيديك بالشُّكر حملا",39,"ل",2,0],["فبما نشرتَ منوِّهاً من سُمعتي","وشهدتَ غير مقلِّد بتقدمي",40,"م",2,0],["فبما أكرهُ الحفيظَ ولا يَط","عم نوماً على انتباهي الغيورُ",41,"ر",1,0],["فبما أثْنَت القَوافي عليه","طَفِقَ القائلُ المُغرِّدُ يحدو",42,"د",2,0],["فَبماذا يُثْنى عليكَ وقد جاوزتَ","فضْلَ البِحارِ والأمْطارِ",43,"ر",1,0],["فَبِما تُنيهُ بِمِثلِ ذا النَسَبِ الدَني","ءِ كَذا يَكونُ مُقاوِماً لِشَريفِ",44,"ف",1,0],["فَبِما قَد سَمَوتُ مُستَبطِنَ السَي","فِ هُدوءاً في مُشرِفٍ ذي أواسِ",45,"س",1,0],["فبما هَدَأْتَ تركتني قَلِقاً","وبما أمِنْتَ أبتّنِي وَجِلا",46,"ل",2,0],["فبماذا يبالغونَ وهم لا","يبلُغونَ الإنصافَ بعدَ الجِهادِ",47,"د",1,0],["فَبِمَا قَدْ تَرُوحُ فِي الغَيِّ نَشْوَا","نَ يَفُوحُ العَبِيْرُ منْ أَرْدَانِكْ",48,"ك",1,0],["فبما أَسْدَتَا إِليّ هَوِيتُ العَجْزَ","حتى تركتُ هجْو الناسِ",49,"س",1,0],["فبمعروفِه أَقرَّ وقرَّتْ","عينُه واستَقَرَّ مِنْه قَرارُه",50,"ر",2,0],["فَبماءِ حُسْنٍ قَدْ عَززْتَ بِصَوْنِهِ","وَبِماءِ دَمْعٍ قَدْ ذَلَلْتُ بِبَذْلِهِ",51,"ل",2,0],["فَبمنْ أَعْطاكَ يا كُلَّ المُنَى","قَامةً تُزْرِي بأعْطافِ القَنا",52,"ن",2,0],["فبمثلكم تقوى روابط ودنا","وبمثلكم يعتز مجد بلادي",53,"د",2,0],["فبمثلها يجب اقترانك يا فتى","وكفاك ماضي سيرة الجهلاء",54,"ا",2,0],["فبمثلكم تسمو البلاد فانتمو","شعب لمن شاد الفخار سليل",55,"ل",1,0],["فبمثلهم أسوان تزهو مثلما","تزهو ليالي الانس بالخلان",56,"ن",1,0],["فَبِمِثلِهِم فَلنَفتَخِر وَبِهَديِهِم","فَلنَهدِ بَعدَ تَقاعُدٍ وَتَوانِ",57,"ن",1,0],["ف بِمصرَ والاَسكندَريَّةش لَوعةٌ","إن لم يكونا وادِعاً والقرتبا",58,"ب",2,0],["فَبمصر تَناسَلَت وَتجلَّت","كَعَروسٍ زُفَّت لَها مِن خِباه",59,"ا",2,0],["فبما جنته اُميّةٌ وسيمّةٌ","يبقى المصاب وتَنمحي الأعوام",60,"م",1,0],["فبمن بالفضل مولا","ي وبالعز أمدّك",61,"ك",1,0],["فبمثل ذلك فامزُجي يا قهوتي","للّه درُّكما ففيه علاجي",62,"ج",2,0],["فبِمَرْئي وجهه الوجد انجلى","وبنُعمَى وصله الصدر انشرحْ",63,"ح",1,0],["فبمن الوذ والتجي من جوره","ليصده عن مستمر جفائهِ",64,"ا",3,0],["فبما قصرت اللهو فيك بخرد","بيض كبيضات الظليم قواصرِ",65,"ر",1,0],["فَبِمَكَّةٍ نَشَأَ النَبِيُّ مُحَمَّدٌ","وَاِختُصَّ بِالمِعراجِ بَيتُ المَقدِسِ",66,"س",1,0],["فبمغناك قد أتحت ركابي","ولعلياك قق لجأت فرارا",67,"ر",2,0],["فبمهجتي يوم النوى كمد","ولأدمعي يوم النوى سكب",68,"ب",1,0],["فبمجدهم شهدت مآثر فضلهم","وبفضلهم نطق الكتاب المحكم",69,"م",1,0],["فبِمَدْحيهِ اشْتغالي","في مَسائي وصَباحي",70,"ح",2,0],["فَبِما فُزْتُ بوصلِ الغَوانيْ","وَنَجا الغيْرانُ مُنْجى الذُّبابِ",71,"ب",1,0],["فبمَ التعلل والشباب منكبٌ","عني وقد شط الحبيب مزارا",72,"ر",2,0],["فَبِمَن أَولاك حُلما","لا تَكُن لِلوَرد خَصماً",73,"م",2,0],["فبماذا يتسمّونَ كراما","عَبَدوا فلسَهمُ دهرَهمُ",74,"م",1,0],["فبمن يغتدي الهوى مستجيراً","فقدتْ كعبةُ الهُدى المستجارا",75,"ر",2,0],["فبمقلتي لو لم أخف إنسانَها","لحجبتُها عن لحظِ عينِ سميرها",76,"ر",3,0],["فبماذا أُواجهُ الفخرَ أم في","أيِّ شيءٍ أُخاطبُ المجدَ جهرا",77,"ر",2,0],["فبمن استغيث ان لم تغثني","ولمن أشتكي سواك بكرب",78,"ب",1,0],["فبما غُسلت وأنت بحرٌ زاخرٌ","ومتى نَجُست وأمُّك الزهراء",79,"ا",2,0],["فبما غدا والنيل من جيرانه","أقسى وأيبس من غضا نجران",80,"ن",1,0],["فبمهجتي وانا الصريع بحده","سيف اللواحظليئه لن يغمدا",81,"د",2,0],["فَبِمِثلِهِ أَدَباً رَفيعاً يُحتَذى","جَمَعَ البَدائِعَ فَهيَ جدُّ بَواهِ",82,"ا",2,0],["فبمسمع منك الذي قد عاينوا","وكفاهم يا سيدي ان تعلما",83,"م",2,0],["فبماذا ليت شعري إن سطا","بِمُحِبِّيه يجاري المبغضا",84,"ض",2,0],["فبمثل ما أوتيته من رأفة","ما ضرَّ إخوة يوسف لما رَمُوا",85,"م",3,0],["فبموسى شاهر من الملك الأش","رف من جور صرفه أستجير",86,"ر",1,0],["فَبِما طلت على الناس يدا","طوقت جيد المَعالي كرما",87,"م",2,0],["فَبمهجتي ذاك النَزيل بقومه","المانعين الضيم كل نزيل",88,"ل",1,0],["فبما أراك وانت غير مدرهم","إذ ذاك تقصف في القيان وتزفن",89,"ن",1,0],["فبمقتصد وبمنعرج","فاضَت فى حِكمتها لُجَجُ",90,"ج",1,0],["فَبمَنحر الهَدي المقَلدِ مِن مِنى","جُدَدٌ يلُحنَ كَأَنَّهُنَّ وشومُ",91,"م",1,0],["فبمكث الماء يبقي آسناً","وخمول النفس في الدنيا أذل",92,"ل",1,0],["فبما لك عندنا من أيادٍ","ووداد وفضل لا يحصى عدا",93,"د",2,0],["فبمن أعوذ اليوم من كمدٍ","لا أستقلُّ به من الكرب",94,"ب",1,0],["فَبِمِثلِ ذ