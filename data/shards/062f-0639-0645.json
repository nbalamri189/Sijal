spx?id=202801",""],[5278,"جمل يعاني من شللْ...","https://www.poetsgate.com/ViewPoem.aspx?id=210549",""],[5279,"أَمِيرُ الشِّعْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=183668",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[5431,"على مذبح الطغيان سالت دماؤنا","https://www.poetsgate.com/ViewPoem.aspx?id=190282",""],[5605,"مرثية النهر البارد","https://www.poetsgate.com/ViewPoem.aspx?id=159817",""],[402,"عجب ما رأيته في زماني","https://www.poetsgate.com/ViewPoem.aspx?id=35683",""],[5818,"مُت مثل مَن ماتوا","https://www.poetsgate.com/ViewPoem.aspx?id=180562",""],[5910,"عَقَدَ الأسَى بالقلبِ","https://www.poetsgate.com/ViewPoem.aspx?id=206868",""],[5956,"تركيبة معظم حكامنا","https://www.poetsgate.com/ViewPoem.aspx?id=192217",""],[5956,"إذا قال الشَّمالي صدِّقوهُ","https://www.poetsgate.com/ViewPoem.aspx?id=210307",""],[6062,"وعد","https://www.poetsgate.com/ViewPoem.aspx?id=176606",""],[6069,"خطبٌ ألم وشدةٌ لا تزول","https://www.poetsgate.com/ViewPoem.aspx?id=105700",""],[3986,"لا تحبسيني في الهوا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=502414",""],[6355,"لا رأس لا ذنبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66655&r=&rc=115",""]],"verses":[["دَع مِن دُموعِكَ بَعدَ البَينِ لِلدِمَنِ","غَداً لِدارِهِمُ وَاليَومَ لِلظُعُنِ",0,"ن",1,1],["دَع ما مَضى لَكَ في الزَمانِ الأَوَّلِ","وَعَلى الحَقيقَةِ إِن عَزَمتَ فَعَوِّلِ",1,"ل",1,1],["دَع ما يُجَشِّمُها الجُمو","دُ وَما يَجُرُّ مِنَ الجَرائِر",2,"ر",1,0],["دَعْ مِنْ عَوَارِفِهِ مَا لَيْسَ يَعْلَمُهُ","إِلاَّ الَّذِي كَفْكَفْتَ مِنْ دَمْعِهِ السَّرِبِ",3,"ب",1,0],["دع مزعج اللوم وخلِّ العتاب","واسمع إلى الأمر العجيب العُجاب",4,"ب",1,1],["دَع ما أُريدُ وَما تُري","دُ فَإِنَّ لِلَّهِ الإِرادَه",5,"د",2,0],["دَع من شفيعٍ صحبةً ما أذنبت","واهنأ بمحبوبِ الجمال بديع",6,"ع",1,1],["دعْ من قوافيك ما يكفيك إن لها","في مدح مولاكَ شَوْطاً مُلْهَبَ الخَبَبِ",7,"ب",1,0],["دع من قوافيك ما يكفيك إن لها","في مدح أحمد إعناقاً وإيجافا",8,"ف",2,0],["دع مادحيك يُقصّرونَ ولا تكنْ","ممّنْ يقال مُقصرٌ وبخيلُ",9,"ل",1,0],["دعْ ما أُريكَ من المحاسنِ واستشِرْ","عينيكَ في التقبيحِ والتحسين",10,"ن",1,0],["دَع ما مَضى مِنها فَرُبَّ مُدامَةٍ","صَهباءَ عارِيَةُ القَذى سَلسالُها",11,"ل",3,0],["دع ما يضرك والتمس ما ينفع","واختر لنفسك ما يزين ويرفع",12,"ع",1,1],["دع ملك إدورد وخل بلاده","يكفيك عسكره بوادى النيل",13,"ل",1,0],["دُعِمنَ بِحاجِبٍ وَاِبنَي عِقالٍ","وَبِالقَعقاعِ تَيّارِ الفُراتِ",14,"ت",1,0],["دَع مَن سِواهُ وَلُذ بِكَعبَةِ جودِهِ","فَجَنابُهُ لِذَوي المَطالِبِ مَقصَدُ",15,"د",1,0],["دَع ما يَقولُ النَصارى في مَسيحِهِمِ","مِنَ التَغالي وَقُل ما شِئتَ وَاِحتَكِمِ",16,"م",1,0],["دَع مَعشَري لا مَعشَرٌ لَكَ إِنَّني","مِن خَلفِهِم وَأَمامِهِم لَكَ موبِقُ",17,"ق",1,0],["دَع ما مَضى وَاِستَأنِفِ العَدَدَ الَّذي","ضَيَّعتَهُ يا مُحصِيَ الأَمواجِ",18,"ج",1,0],["دَعَمُوا الممالكَ بالأَسِنّةِ وابْتَنُوا","مجداً بغير سُيوفِهم لم يُدْعَمِ",19,"م",1,0],["دع ما يقولُ الطفلُ لا تحفل به","لَغْوُ الحديثِ أحقُّ بالإهمالِ",20,"ل",1,0],["دَعْ ما مَضى لَك يا سُرا","قَةُ من جناياتِ العُصاةِ",21,"ه",1,0],["دعْ من يَعَضُّ على الحياةِ فإنّه","غاوٍ يُضلَّل أو دَعِيٌّ يكذب",22,"ب",1,0],["دَع مَن يُنازِعُكَ الغَناءَ فَإِنَّهُ","خَرِسٌ يُنازِعُ مَعبَداً حُسنَ الغِنا",23,"ن",2,0],["دُعموصِ أَبوابِ المُلوكِ","وَجائِبٍ لِلخَرقِ فاتِح",24,"ح",1,0],["دَعْ ما ادَّعَتْهُ النَّصارَى في نَبيِّهِمِ","وَاحْكُمْ بما شْئْتَ مَدْحاً فيهِ واحْتَكِمِ",25,"م",1,0],["دَع مَن يُقارِضُ أَقداحاً بِأَقداحِ","لَيسَ المُروءَةُ سَقيَ الراحِ بِالراحِ",26,"ح",1,1],["دَع مِنَ العَيشِ كُلَّ رَن","قٍ وَخُذ مِنهُ ما صَفا",27,"ف",2,0],["دُعموصُ نَهرٍ أَنشَبَت وَسطَهُ","إِن تَنعَبِ الريحُ لَها تَنعَبِ",28,"ب",1,0],["دَع ما يريبك في الأمو","ر إلى الَّذي هُوَ لا يريب",29,"ب",1,0],["دَعَموا عَلى الحَربِ السَلامَ وَطالَما","حَقَنَت دِماءً في الزَمانِ دِماءُ",30,"ا",2,0],["دَعْ مَا يَرِيبُ وَخُذْ فِي مَا خُلِقْتَ لَهُ","لَعَلَّ قَلْبَكَ بِالإِيْمَانِ يَنْتَفِعُ",31,"ع",1,0],["دَعْ مِنَ الْفَخْرِ مَا تَعَاطَاهُ مَزْهُوٌّ","بِترْدِيدِ شِعْرٍ أَوْ فَخورُ",32,"ر",1,0],["دَعْ مَا ظَفِرْتَ بِهِ مِنَ الأَزْهَارِ","وَخُذِ الْكرِيمَةَ مِنْ يَدِ الزَّهَّارِ",33,"ر",1,1],["دَعْ مِنَ الْفَخْرِ مَا تَعَاطَاهُ","مَزْهُوٌ بِتَرْدِيدِ شِعْرِهِ وَفَخُورُ",34,"ر",1,0],["دعَّمتمو صرْحَ الإخاء، وليس ما","تبني يمينُ العلم بالمنهار",35,"ر",1,0],["دع مؤاخاة معشرٍ وسعو أح","سنك جهلاً وعد لهذا الفطين",36,"ن",1,0],["دَع مَجلس الغِيدِ الأَوانِسْ","وَهَوى لَواحِظِها النَواعِسْ",37,"س",1,1],["دع من سمعت به وخذ فيمن ترى","جمعت له ولقومه الآمال",38,"ل",1,0],["دَع ما تَقَدَّمَ مِن عَهدِ الشَبابِ فَقَد","وَلّى الشَبابُ وَزارَ الشَيبُ وَالزَعَرُ",39,"ر",1,0],["دَعْ مقال العَاذِلاتِ","والهَ عن سَعْي السُّعاةِ",40,"ه",1,1],["دع مقصراً ليس بدَّاعاً ولا عجبٌ","للأريحية والإحسان أقوام",41,"م",1,0],["دَع ما سواه ومَن سواه وسر له","إن شئت تدري العِزُّ كيف يُنالُ",42,"ل",1,0],["دَعْ مَلا مي، لُمْ غرامي","جُدْ بوصلٍ منك طابا",43,"ب",2,0],["دع مزجك الصهباء اني لا أرى","للبكر صوناً بعد ان تتزوجا",44,"ج",2,0],["دع معجزات روس الله خالصة","وصف بكل كمال كوكب الظلم",45,"م",1,0],["دَع مَطلَهُم فَالمَطلُ يُذكِرُهُ","وَعَسى عَلى الذِكرى تُديمُهُمُ",46,"م",1,0],["دع مذهباً قد جاء منك مؤيّداً","فيه خرافاتٌ بها كنت الهَمَل",47,"ل",1,0],["دع متوناً وشروحاً جُلُّها","عند ذي التحقيق أمثال القروح",48,"ح",1,0],["دعْ ما نَهى الشّيبُ والسبعونَ عنه فَتِر","بَاكَ الصّبا والشّبابُ الغضُّ قد دَرجَا",49,"ج",2,1],["دع ما تقول البرايا في مناقبهم","فكيف قولك بالآيات والسُّور",50,"ر",1,0],["دَعْ من حديثِ حوادثٍ كثُرتْ","إِن الهمومَ نتائجُ الهِممِ",51,"م",1,0],["دع مجلس الغيد الأوانس واعتزم","عزما يعود عليك بالمسلوب",52,"ب",1,0],["دعْ ملامي باللّوى أورُحْ ودعْني","واقفا أنشُد قلبا ضاع منِّي",53,"ن",2,1],["دُعِّم الملك منهمُ بأكفٍّ","صعبةِ الأسرِ جَلْدةٍ عَمّالَهْ",54,"ل",2,0],["دعَموا الخدودَ بأذرعٍ مضعوفةٍ","وتواقعوا لمناكبٍ وجُنوبِ",55,"ب",1,0],["دعْ ماءَ وجهي مالئاً حوضَه","وكُلْ سميناً نَشَبي واشربِ",56,"ب",1,0],["دع ما بجفنك ما بجفنك قاتلٌ","ماذا الذي تبغي الظباء من الظبي",57,"ب",2,0],["دَع ماءَ وَجهِكَ فيهِ لا تُرِقهُ فَما","عِندَ الَّذينِ تُرَجّيهِم سِوى الياسِ",58,"س",1,1],["دَع مَن يَنقِّي الشيبَ مِن وَجهِهِ","إِن شاءَ في الجُمعَةِ أَو في الخَميسْ",59,"س",1,1],["دَعَموا رقابَهمُ على كيرانِها","قبلَ الصباحِ مِنَ الكرى بالأذْرُعِ",60,"ع",1,0],["دعْ من تَلصَّصَ في الفسادِ مُوارباً","واهْملهُ قَدْ عَمِيتْ بُنَيَّ بَصيرتُهْ",61,"ت",2,0],["دَعْ مَنْ يَشُنُّ عَلَيْكَ غَاراتِ الأَذَى","بِلِسانِهِ بَيْنَ الأَنامِ بمَشْهَدِ",62,"د",1,0],["دعْ منزلاً لا أهلَ فيه ولا به","وأقمْ لنا بالمنزل المأهولِ",63,"ل",1,0],["دَعْ مَن يكون جمالهُ وفخارهُ","في الفاخرين الوَشْيُ والدّيباجُ",64,"ج",1,0],["دَعَمَ الإِمامُ بِهِ قَواعِدَ مُلكِهِ","وَلَقَد تَطَرَّقَها اِنتِكاثُ المُلحِدِ",65,"د",1,0],["دع من يجادل أو يماطلْ","واعلم بأن الكلَّ باطلْ",66,"ل",1,1],["دع ما أَقولُ فلوْ دَعَاني أَمْرُه","لبَّيْتهُ بالسَّعي حِينَ دَعَانِي",67,"ن",2,0],["دعْ منهُ قبلَ بلوغِ البينِ غَايَتَه","إِمَّا طريقَ البُكا أَو منزلَ السَّهَر",68,"ر",1,0],["دع ما سواك ودع شيئاً سمعت به","ففيك منك وجود غير منعدم",69,"م",1,0],["دع من عتابك ليته قبل الهوى","هيهات ما قبل الهوى مستعذب",70,"ب",1,0],["دع ما عداه وعد إليه وعد به","وبكشفه عن حالة المتوهم",71,"م",1,0],["دع من حديثك والها فيه له","لمعاهد العهد القديم تعاهد",72,"د",1,0],["دع ما عداه وعد منه إليه به","وعد به منه إحلالا كما يجب",73,"ب",1,0],["دع ما ادعوه فلن تعود سياسة","كانوا بها من أخسر التجار",74,"ر",1,0],["دعْ مِلة البخَّالِ والحراصِ","ومنهجَ الفسوق والمعاصى",75,"ص",2,1],["دع من سواهم وحدث عن محاسنهم","أخبار صدقٍ لأدواء القلوب شفا",76,"ف",2,0],["دع ما يقول الوشاة فيها","فعثرة الحب ما تقال",77,"ل",1,0],["دع ملام المستهام","في هوى بدر تمام",78,"م",1,1],["دع ما يريب إلى ما لايريب وخذ","بالحق ترقى العلا مع جملة العلما",79,"م",2,0],["دُعموصُ رَملٍ زَلَّ عَن صَخرَةِ","يَعافُ أَرواحَ البَساتينِ",80,"ن",1,0],["دع ما عداك إلى نبيّ ءايه","ما إن تبيد ولا يغيرها البلى",81,"ل",2,0],["دعْ ما يزخرفه الربيعُ وإن زهتْ","أزهاره بين الربى ووهادها",82,"د",3,0],["دع ملاهيكَ ساعةً وتفكر","في جلالِ المهيمنِ الرحمنِ",83,"ن",1,0],["دع مدح عمرو في الشجاعة إِنه","يزري على عمرو ويفضح عنترا",84,"ر",2,0],["دع ما يفخم في السماحة حاتماً","لا تخدعنَّك لامعات سرابه",85,"ب",2,0],["دعمت له مهدا تذم لطيبه","أرد