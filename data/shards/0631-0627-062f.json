{"poems":[[88,"لمصر أم لربوع الشام تنتسب","https://www.aldiwan.net/poem10918.html","البسيط"],[47,"ذاك وادي الأراك فاحبس قليلا","https://www.aldiwan.net/poem65580.html","الخفيف"],[47,"ذاكَ وَادي الأرَاكِ فاحبِسْ قليلا","https://www.poetsgate.com/ViewPoem.aspx?id=32098",""],[556,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111155","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87367","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74058","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59457","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135419","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81710","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139486",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52168","السريع"],[4802,"أشواق وحنين","https://www.poetsgate.com/ViewPoem.aspx?id=34418",""],[4806,"عطر الياسمين","https://www.poetsgate.com/ViewPoem.aspx?id=180933",""],[5168,"يا ورده تعيش بمزهريه؟","https://www.poetsgate.com/ViewPoem.aspx?id=33676",""],[5397,"يا سائق النوق عن الأربع","https://www.poetsgate.com/ViewPoem.aspx?id=157919",""],[5559,"الانتصار/زهير شيخ تراب","https://www.poetsgate.com/ViewPoem.aspx?id=152691",""],[5956,"مناجاة الأخ الميت","https://www.poetsgate.com/ViewPoem.aspx?id=192372",""],[5126,"وَدِّعْ هَواك!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87807&r=&rc=22",""]],"verses":[["رادوا المَناهِلَ في الدُنيا وَلَو وَجَدوا","إِلى المَجَرَّةِ رَكباً صاعِداً رَكِبوا",0,"ب",3,0],["رادَةُ المَجدِ أَوَّلاً وَأَخيراً","وَأُولو المَجدِ واحِداً وَقَبيلا",1,"ل",2,0],["رَادَةُ المجَمْدِ، أوّلاً وأخيراً،","وأُولو المَجْدِ وَاحِداً وَقَبيلا",2,"ل",2,0],["رادَيْتُها فلقيتُ منها صخرةً","صَمَّاءَ من جبلٍ أشمٍّ راسِ",3,"س",1,0],["رادت بموقع جدواه وقد وردت","حياضها لم تجد جوعاً بها وظما",4,"م",2,0],["رادَ الفضائِلَ حتىّ حازَ افضلها","فَلَم يَكُن من جديدٍ عندهُ فيها",5,"ي",3,0],["راد الشآم فَلَم يدع","مرعى يراد وَمَرتَعا",6,"ع",2,0],["رَادُ الوشاحين ملءُ الدِّرعِ بهكنةٌ","أذكتْ بقلبي نارَ الشوقِ والكمدِ",7,"د",1,0],["راد الحضور من الجمال أقطعُ","وبغيبةٍ فالشوق نارٌ يُضرمُ",8,"م",1,0],["رادوا مراتعَ من نعماك مخصبةً","وحبَّذا مرتعُ النعمى لِمَنْ رتعا",9,"ع",2,0],["رادفتها مناقب أبت الحص","ر وأعيت مصاقع الفصحاء",10,"ا",2,0],["راد المُنَى في جوّها هازئاً","بالقدَر الراصدِ في خِدرهِ",11,"ر",2,0],["راد الزمن افقدرتة واصدر بنا حكم لعين","حكم القدر ياصاحبي لف السنين ودارها",12,"ر",3,0],["رادو يخنگوچ يلنبضچ حياة","وقبل مايولد يموتوه الجنين",13,"ن",1,0],["رادو ايمسحون اسمچ گلتي لا","ابقى سامره ويظل جَدي الحسين",13,"ن",1,0],["رادو نختلف ما كدرو بهاي","وشكد حاولو بس انته اليه",14,"ي",2,0],["رأد الضحى ترعى سموم الفلا","وذاك مرعى قبل ذا ما رعي",15,"ع",2,0],["رادوا المواقع فرساناً وما وهنوا","والأرض من مرجٍ تغلي وتستعر",16,"ر",1,0],["رَأَدُ الضحى، حُسْن الفلا، ضَوعُ الشذا","هو أنت يا حمدي وخيرُ حكايا",17,"ا",3,0],["رَأْدُ الضحَى دَافَ مِمَّا اشْتَرْتُما ضَرَباً","واللَّيْلُ سَامَ مِنَ الإمْتاعِ مَا سَامَا",18,"م",2,0]]}