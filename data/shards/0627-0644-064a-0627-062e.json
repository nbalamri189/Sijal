{"poems":[[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48571","الوافر"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75751","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118417","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108304","المجتث"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135438","الطويل"],[4702,"سواليف المزون","https://www.poetsgate.com/ViewPoem.aspx?id=155105",""],[5163,"الى من حبه الامل","https://www.poetsgate.com/ViewPoem.aspx?id=33941",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5682,"أبلغْ سلامي يضُوع رَنْدَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=189006",""],[5692,"ذكر ( قبايل عبيدة قحطان )","https://www.poetsgate.com/ViewPoem.aspx?id=178919",""],[5776,"(أُتْسُوعةُ الهلاك )","https://www.poetsgate.com/ViewPoem.aspx?id=205841",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""]],"verses":[["إليَّ أخي بما يجلو همومي","فقد شغلتْ لساني لَوْ وليت",0,"ت",1,0],["إِلى آخر بز المقدّم فضله","وانبع ماء غاض من منهل الأَدب",1,"ب",1,1],["إلى أخوة شط المزار بهم عنا","وذكر سواهم في الخواطر ما عنا",2,"ن",2,1],["إلى أخي وحبيبي ال","كريم يوسف أسعد",3,"د",1,1],["إلى إخوةٍ حفظٌ يدور عليهم","هم الفرش في سفلٍ هم العرش في علوِ",4,"و",1,0],["الى آخر متاهه في حدودك وانت ما تدري","وانا ادري واااتجاهل والجهل يبدي خوافي به",5,"ب",2,0],["الى أخرى بها غنجٌ","تبدت والهوى عَجِلُ",6,"ل",1,0],["إلى آخر الأبيات من إفك زوره","ولمة علم القدم إذ كان قد جهل",7,"ل",1,0],["إلى آخر الهمط الذي قد ذكرته","كأنك ممن قال حقاً وأحكما",8,"م",2,0],["إلى آخر الهذر الأخس الذي به","غدا الأحمق الأشقى يعط به فشرا",9,"ر",2,0],["إلى أخٍ طال منه كفِّي","بصارمٍ لا يُحَدُّ حَدُّهْ",10,"د",2,0],["إليا خودروا يبغون الأسعار بالقرى","قدرنا على مثل الفحام السود",11,"د",1,0],["إلى آخرِ المنحنى","ودَرْعَاْ بها من نُعِتْ",12,"ت",1,0],["إلى آخر الدنيا تجل صفاتهم","وأسمائهم تتلى لكل عزيمة",13,"ه",1,0]]}