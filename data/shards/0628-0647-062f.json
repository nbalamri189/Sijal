{"poems":[[55,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[30,"فتحت لهم حتى فككت قيودهم","https://www.aldiwan.net/poem5226.html","الطويل"],[50,"يا من ينادي الدار هل تنطق","https://www.aldiwan.net/poem66594.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[154,"بطيبة للعافين أكرم سيد","https://www.aldiwan.net/poem68590.html","الطويل"],[177,"يا سليل الخال صبراً بعده","https://www.aldiwan.net/poem4401.html","عموديه"],[210,"سرور أزاح الهمّ والغمّ مذ بدا","https://www.aldiwan.net/poem916.html",""],[280,"هو الفتح بعد الفتح يأتي مسوغا","https://www.aldiwan.net/poem25482.html","الطويل"],[302,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[374,"وناجم في علم تقويمه","https://www.aldiwan.net/poem4276.html","السريع"],[415,"أذكرهم الود إن صدوا وإن صدفوا","https://www.aldiwan.net/poem32428.html","البسيط"],[422,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[445,"ولا في سرور العيد نحن مهنوه","https://www.aldiwan.net/poem34860.html","الطويل"],[529,"الصلاة عليك يا شمس الكمال","https://www.aldiwan.net/poem13293.html","الوافر"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129530","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59439","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/121989","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79862","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141346","الطويل"],[1826,"","https://poetry.dctabudhabi.ae/diwan/poem/198947","الوافر"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66295","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123184","الوافر"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104791","الطويل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42430","المواليا"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27344","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47199","الوافر"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110613","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93578","الخفيف"],[3003,"","https://poetry.dctabudhabi.ae/diwan/poem/126534","البسيط"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20598","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131242",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66536","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133295","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81923","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81698","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81690","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72347","البسيط"],[4690,"الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=153107",""],[4767,"المنزلة","https://www.poetsgate.com/ViewPoem.aspx?id=179760",""],[4806,"حبيبي وحياتي","https://www.poetsgate.com/ViewPoem.aspx?id=188630",""],[4821,"غُرّةُ الكَوْن ذاتُ بِش","https://www.poetsgate.com/ViewPoem.aspx?id=120390",""],[4931,"النّسيم الهتاني","https://www.poetsgate.com/ViewPoem.aspx?id=30630",""],[5363,"رحيلك مرٌّ (رثاء)","https://www.poetsgate.com/ViewPoem.aspx?id=200029",""],[5411,"سترحل مرغما","https://www.poetsgate.com/ViewPoem.aspx?id=197853",""],[5419,"جدي والحاسوب ... ( شعر للأطفال )","https://www.poetsgate.com/ViewPoem.aspx?id=71141",""],[5428,"أراني كُلّما قطعوا المزارا","https://www.poetsgate.com/ViewPoem.aspx?id=124932",""],[5561,"حالُهُ ....","https://www.poetsgate.com/ViewPoem.aspx?id=197101",""],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[192,"نبض الشوارع","https://www.poetsgate.com/ViewPoem.aspx?id=16352",""],[5936,"سايس زمانك","https://www.poetsgate.com/ViewPoem.aspx?id=184769",""],[5956,"بهدْي العقل","https://www.poetsgate.com/ViewPoem.aspx?id=184521",""],[4442,"عاد الوصي إلى علائه","https://www.poetsgate.com/ViewPoem.aspx?id=171021",""],[6320,"كِتَابُ الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84340&r=&rc=37",""]],"verses":[["بِهُداهُ يَستَضوي الوَرى وَبَهَديِهِ","قَرُبَ الطَريقُ لَهُم إِلى المَعبودِ",0,"د",1,0],["بهُدَاك اهتدتْ حيارى المنايا","يومَ ضلَّت مقاتلَ الأقيالِ",1,"ل",1,0],["به درَّتِ الدنيا ولولاه أصبحتْ","يعلّلُنا منها أجَدُّ مُصَرَّمُ",2,"م",1,0],["بِهِ دَمَّرَ اللَهُ المَزونَ وَمَن سَعى","إِلَيهِم كَما كانَ الفَراعينَ دَمَّرا",3,"ر",2,0],["بهديهِ يشكو التباريحَ مِن","رمّانَتي صدرتِها القُرطَقُ",4,"ق",1,0],["بِهِدَايَةٍ صَحَّتْ عَلَى","طَلَبِ الأَحَبِّ الأَنْفَعِ",5,"ع",1,0],["بِهِ دُمغِ الإِبطالُ قِدماً وَيُدمَغُ","ظَهيرٌ لأَوطارِ الأَنام مُسَوّغُ",6,"غ",1,0],["بهداكُم إن ضَلِلنا نهتدي","وبكم يُضرَبُ في الصّبر المَثَل",7,"ل",1,0],["به دبي أشرقت وتهللت","وكادت بنور العلم أن تتوقّدا",8,"د",2,0],["بِهِ دَفع الحَقُّ الضَّلالَ وهَاضَهُ","فَلوْلاهُ ما كانَ الضَّلالُ لِيُدْمَغَا",9,"غ",2,0],["به دعا إِذ دَعا فرعونُ شيعتَه","موسى فأفلتَ من تَسهيم سحرهمِ",10,"م",1,0],["بهدي لأقوام تقاويمه","ليجتدي من رِفد أقوامه",11,"م",2,0],["به دنَوتَ وإخلاصُ الهَوى نَسَبٌ","كما نَأيتَ وإفراطُ الهَوَى تَلَفُ",12,"ف",1,0],["بهديرٍ مستعذبٍ وهديلِ","يا لعيشٍ ما كانَ أمرى وأحلى",13,"ل",2,0],["بهَدْي من المنصورِ لَيْسَ يُضيعُهُ","عَلَى سَنَنٍ من سعيِهِ لَيْسَ يَأْلُوهُ",14,"و",2,0],["بِهَديك اِقتَدى في كُل منسك","وَلي قَلب بِجاهك قَد تمسك",15,"ك",1,0],["به دبرت أفلاكها وهي صورة","لأوضاعها بالقسط في الخلق نسبة",16,"ه",1,0],["به در ضرع المكرمات وثقفت","قنا الفضل وانهلت عواد به للصدى",17,"د",2,0],["بهداة الورى بكل ولي","ونبئ ومرشد وندير",18,"ر",1,0],["به دعا للهدى هاد فأنقذنا","من قعر بحر له بالزيغ تهويل",19,"ل",1,0],["بهديهم أمت البسيطة قوما","لأمرهم كل الكوائن أذعنت",20,"ت",1,0],["بِهِ دَفَعَ الَّلهُ الخُطُوبَ عَنِ الْوَرَى","وَلِلَّهِ فِي دَفْعِ الْخُطُوبِ عَجَائِبُ",21,"ب",1,0],["بهدايا يديكَ أُقسم لا أيدي","الهدايا يرمينَ نحو المصلّى",22,"ل",2,0],["بهدي العلى جدّوا وصونوا نفوسكم","عن الشرّ تقضوا فيه أكبر واجب",23,"ب",1,0],["به درجوا من الدنيا فبانوا","وكل ما خلا الرحمن فاني",24,"ن",2,0],["بهداه يُستسقى وذك","راه بها الداعي يجاب",25,"ب",1,0],["به دارت سكاكر مع سُقاة","كأقمار بأفلاك السعود",26,"د",1,0],["بهِ دَاسَ حُجبَ العِزِّ ذَاكَ المُقَدَّمُ","هدَانا إِلى سُبلِ الهِدَايَةِ مُذ أتَى",27,"ت",2,0],["بهدلتمُ الفنَّ واويلاهُ ما أنتمْ","إلّا عنوزُ الفلك من جدِّ لا كُنتمْ",28,"م",1,0],["بهدى هداتهم اهتديتُ لأنهم","في الليلة الظلماء كالنبراسِ",29,"س",1,0],["به داءُ العضال وهَلْ لِصَبٍّ","سوى وَصْلِ المحبِّ فُدِيتَ آسي",30,"س",2,0],["بهداة للطريق المهيع","هل ترى قد علم البيت الحرام",31,"م",1,0],["بهدى المهتدي وكفر العَنيد","لا تخصص بِهِ مَكاناً وَوقتا",32,"ت",2,0],["بهديه للهدى كم صاد من زمر","وغافر الذنب وفىّ طول اجرهم",33,"م",1,0],["بِهِ دَخيلُ هَوى ضَمرٍ إِذا ذُكِرَت","سَلمى لَهُ جاشَ في الأَحشاءِ وَالتَهَبا",34,"ب",2,1],["بهديك قومت أخلاقنا","فعن نهج القصد لم ننكب",35,"ب",1,0],["بِهِ دَمَّرَ اللَّهُ الصَّليبَ وَأَهْلَهُ","بِهِ مِلَّةُ الإسْلامِ عَالٍ مَنارُها",36,"ر",3,0],["بهديهم كل من في الكون معتصم","إن الحياة بغير العلم خسران",37,"ن",1,0],["بهدةٍ مثل عجيج البحر","يقذف بالموج لثغر النهر",38,"ر",1,0],["بهداه عزّ الهدى وتعزت","فرق خالفوا بذلّ عزاء",39,"ا",2,0],["به دعا آدم لما عصى وبه","نوح بنى الفلك لما عاين الغرقا",40,"ق",2,0],["بِهُدى الإِمام العدل يَحيى المرتضى","قد آنس السَّاري الصَّباح وأَبصرا",41,"ر",2,0],["بهدى أبي اليقظان عمار اقتدى","أهدى وأرشدُ كلِّ سارٍ مُدْلجِ",42,"ج",1,0],["به دمعت لأهل البغي أدمغة","لنخوة الجهل قد كانت أشرَّوعا",43,"ع",2,0],["بهداكَ يفلَحُ سيرُنا","هو زادُنا ، أتُرى نَذرْ ؟",44,"ر",1,0],["به دللتم عليكم شرَّ بارقةٍ","حتى غدوتم ضحايا كلِّ عدوان",45,"ن",1,0],["بهدوء انت تحچي البلابل تِغار","وتِظل عالصَدِرهه تدگ وتقد",46,"د",1,0],["بهُداهُ اهتدتْ ودلّت على اللّ","ه بذاك الهدى عوالمُ أخرى",47,"ر",2,0],["بهديك ورد بعيد ميلادك اليوم","يا وردة الخافق وضحكة زماني",48,"ن",2,1],["به دُفعتْ عنا بلايا عظيمةٌ","إذا استنزلتها للعقاب مظالمُ",49,"م",1,0],["بِهِ دُرْنا وَما اتَّسَقَتْ رُؤانا","فَدارَ بِنا عَلى وادٍ وَفجِّ",50,"ج",1,0],["بهدوء علمني حتى","أعطيك زجاجات الطيب",51,"ب",1,0],["بهدي المصطفى والصحب طراً","قد استهدوا فأورثهم وقارا",52,"ر",2,0],["بهدوئهِ يغري الهدوءَ وقلبُهُ","في النارِ ممّا قد جنى بيديهِ",53,"ي",2,0],["بهِ درراً أضحى عزيزاً منالها","لأهل المعالي في البواطن تُوهبُ",54,"ب",1,0],["به دارت الأفلاك منذ تكونّت","وأقطابها والختم من كل دورة",55,"ه",1,0],["به دجل يملا الحواري به كذوب ٍ في الجوامع","طوّل اللحية لسلطة ماهو سنة والا طوع",56,"ع",1,0],["بهديك علم ولازم إنك تصمه","ثلاثة أبياتٍ عليها التجاريب",57,"ب",1,0],["بِهُدى العقل ننمّي نفسنا خي","رَ نماءٍ ، ونُوَفّي كلَّ مطلبْ",58,"ب",1,0],["بهداه تجتمع القلوب","كما اجتمعن على ولائه",59,"ا",3,0],["بِهَدْيِ نَبِيِّنَا وَالصَّحْبِ كُنَّا","نَجُوبُ الأُفْقَ سَيحاً وَاغْتِرَابا",60,"ب",2,0]]}