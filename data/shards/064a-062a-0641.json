,""]],"verses":[["يَتَفَيَّؤونَ عَجاجَةً","كَجآجِىءِ الغَيمِ الرُكامِ",0,"م",1,0],["يَتَفَرَّقنَ شُعوباً","وَلَهُ مُؤتَلِفَه",1,"ف",2,0],["يتفيّأون ظلالَ جاهك كلما","لفحت سَموم الخطب بالإحراقِ",2,"ق",1,0],["يَتَفَكَّهونَ بِكُلِّ نادِرَةٍَ","وَعَلى الوُجوهِ عَلائِمُ البِشرِ",3,"ر",1,0],["يَتَفَزَّعُ الجَبّارُ مِن بَغَتاتِهِ","فَيَظَلُّ في خَلَواتِهِ مُتَكَفِّنا",4,"ن",2,0],["يَتَفَكَّهُ النَّفَرُ الأَفَاضِلُ مِنْهُمُ","بِجَنَ حَيَاتِكَ شَاعِراً وأرِيبَا",5,"ب",2,0],["يَتَفَكَّهُونَ بأحْرُفٍ أَوْدَعْتَهَا","تَلْخِيصَ عُمْرِكَ مَشْرٌقاً وَمَغِيبَا",5,"ب",2,0],["يَتَفادى مِن نَداهُ تالِدٌ","لَو تَرَقّى في الثُرَيّا ما وَأَل",6,"ل",1,0],["يَتَفاءَلُ النيلُ الْوَفِيُّ بِعَهْدِهِ","وَبِيُمْنِ طَلْعَةِ وَجْهِهِ الْوَضّاحِ",7,"ح",1,0],["يتفاخرونَ بشاعرٍ فكأنَّما","تحصيلُ معنى الحُكْمِ في تحصيله !",8,"ل",2,0],["يتفقد الأضياف ملءَ دياره","عند الصباح وعند كل غروب",9,"ب",1,0],["يتفاخرون بطول مدةِ رؤيةٍ","نظروا إِليك بها وبالإِلمامِ",10,"م",1,0],["يتفاوضون على الجلا","ءِ ووحدَة الوادي الأمين",11,"ن",1,0],["يتفارطون إلى مساورة الرَّدى","كمتفارط الكدري نحو المنهل",12,"ل",1,0],["يتفارطُ العافونَ حُبَّ ورودِهِ","كتفارُط الكُدْريِّ نحو المَنْهَلِ",13,"ل",1,0],["يتفاخرون جهالة بعديدهم","فليكثروا إن الكرام قليل",14,"ل",1,0],["يَتَفَيهَقُ الغمرُ المُغَمَّر مُسهِباً","وَالمِصقَعُ العِدُّ القَريحَةِ موجِزُ",15,"ز",1,1],["يتفانى الهائم المضني إذا","تنثني بالريح أعطافُ الفنن",16,"ن",1,0],["يتفحصون مع الظلا","م لغوزها المتواريةْ",17,"ي",2,0],["يَتفقّا عَن بهار فاقِعٍ","خِلته بالوَردِ يَطوي وَمَقا",18,"ق",2,0],["يتفرقون على مذاهبهم","وعلى الأخاء الناس تجتمع",19,"ع",1,0],["يتفنن العلماءُ في طُرُق الردى","هلاّ تفننهم بدفع بلاه",20,"ا",2,0],["يَتَفَرّى عَن مَناسِمِها","كَتَفَرّي النارِ عَن شَرَرِه",21,"ر",2,0],["يتفنن الكتاب عند رثائه","إذ كان في فن الكتابة بارعا",22,"ع",2,0],["يتفيا ما شاءَ دوح سلامٍ","وارفَ الظلّ باسقَ الاغصانِ",23,"ن",1,0],["يتفكهون بها رخيصا سعرها","ميتا بلا عوض ولا أثمان",24,"ن",1,0],["يتفاوت الآباء والابناء في","اخلاقهم وكذلك الرؤساء",25,"ا",2,0],["يَتَفاخَرونَ لَدى الخِصامِ بِفُحشِهِم","وَالفُحشُ أَقبَحُ ما يُرى مِن عارِ",26,"ر",1,0],["يَتفارَقانِ إِلى مَدىً","يَتَلاقيانِ عَلى معاد",27,"د",1,0],["يتفاخرونَ بكل عَظمٍ ناخرٍ","ما الفخرُ بالعظم الرميمِ ولو عَوَوا",28,"و",3,0],["يتفيَّأونَ خِيامَ مجد إلههم","حيثُ التهاني والسرورُ مخيّمُ",29,"م",1,0],["يتفاخرونَ برَقشِ ثوبٍ فاخرٍ","وبرونقِ البدلات والتِيجانِ",30,"ن",1,0],["يتفيأ المصطاف وارف ظلها","وتميل نافحة الصبا أفنانها",31,"ن",3,0],["يَتفقدانك في الدُجى مِن لَوعة","لَدن اِعتَللت وَخار عَزم الصابر",32,"ر",1,0],["يَتَفلى العُصور ما شاءَ تَنقيباً","وَبَحثاً عَن غَيبِها وَاِستبانه",33,"ن",2,0],["يتفانون إلى كسب العلى","وإلى المجد بجد أجمعين",34,"ن",1,0],["يتفجَّر الينبوع من هضباته","عذباً فيغرق باطن في ظاهر",35,"ر",1,0],["يتفخّل الإنسان جل نهاره","حتى يفوز بغادة في ليله",36,"ه",1,1],["يَتَفَجَّرُوْنَ بِحِقْدِهِمْº وَنُفُوْرِهِمْ","وَيُنَاْفِقُوْنَ إِذَاْ طَغَى الأَعْجَاْمُ",37,"م",1,0],["يتفجّرُ حظي ينبوعا ً","يَحْبو ويشُبُّ بأزهاري",38,"ر",2,1],["يتفقدون فلا سعاد بها ولا","سلمى فرحلتهم كلمح بالبصر",39,"ر",1,0],["يتفرّجون كأنهم في مسرح","عُرِضت به الأفْلامُ أو في ناديه",40,"ي",2,0],["يتفاهمون برميه وبرشقه","فكأنما لغة الحياة سهام",41,"م",1,0],["يتفحص جدي حاسوبي","يدنو بفضول محسوب",42,"ب",1,1],["يَتفصّدُ التاريخُ من أعراقِنا","مَجداً، وتشدو للبَهاءِ سِنونُ",43,"ن",1,0],["يتفاءلُ المحزونُ في أيامهِ","ويَعيشُ مابينَ المُنى وَيطوفُ",44,"ف",1,0],["يتفاصحون بملءِ شِدقِهُمُ","كلُّ يلمعُ عجلهُ الذهبا",45,"ب",2,0],["يتفكه النفر الأفاضل منهم","بجنى حياتك شاعرا وأريبا",46,"ب",2,0],["يَتَفَجَّرُ الجُورِيُّ مِن أَعطَافِهِ","وَعَلَى يَدَيهِ اليَاسَمِينُ يَفُوحُ",47,"ح",1,0],["يتفقدُ البيتَ الحزينَ ويمتطي","فرس الخيالِ وليس تسعده المنى",48,"ن",2,0],["يتفجرُ الإبداعُ بين جَوانِحي","وبداخلي داعي النِّجاح مقيمُ",49,"م",1,0],["يتفاوتُ الشعراءُ في أفكارِهمْ","والقومُ في صُنعِ القصيدِ مَراتِبْ",50,"ب",1,0],["يتفتح الورد الجميل من الندى","وبيوت قومي تستضاف من اللئام",51,"م",1,0],["يتفكّهْنَ -يوم جئت- صِغارا","ويولولن -حين متَّ- كبارَا",52,"ر",2,0]]}