للِقاءِ وَلا يَقولُ لَها اِسلَمي",1,"م",2,0],["وَيَقولُ مَن لَم يَدرِ كُنهَكَ إِنَّهُم","نَقَصوا بِهِ عَدَداً مِنَ الأَعدادِ",2,"د",1,0],["وَيَقْصُرُ لَيْلِيَ حَتّى يَكا","دُ يَعْلَقُ ذَيْلَ الصَّباحِ الشَّفَقْ",3,"ق",1,0],["ويَقْدُمُها طِرْفٌ أغَرُّ مُحجَّلٌ","لراكِبِهِ مَجْدٌ أغَرُّ مُحجَّلُ",4,"ل",1,0],["ويُقْدِمُ والأسْيافُ تُغْمَدُ في الطُّلى","وللْخَيْلِ مِنْ صَوْبِ الدِّماءِ نِعالُ",5,"ل",1,0],["ويَقْصُرُ عنها المَدْحُ حتى كأنّنا","إذا نَحنُ أثْنَيْنا عليها نَعيبُها",6,"ب",3,0],["ويقيمُ مائِدَهُن لَيلٌ مُظلِمٌ","ويضُمُّ شارِدَهُنَّ صُبحٌ مُسْفِرُ",7,"ر",1,0],["ويُقيمُ زَيغَ الأمرِ ناءَ بعِبْئِهِ","ذو الغارِبِ المَجْزولِ وهْوَ مُطيقُ",8,"ق",1,0],["وَيَقتَحِمونَ أَهوالَ المَناي","غَداةَ الكَرِّ في الحَربِ العَوانِ",9,"ن",1,0],["وَيُقنِعُني مِمَّن أُحِبُّ كِتابُهُ","وَيَمنَعُنيهِ إِنَّهُ لَبَخيلُ",10,"ل",1,1],["وَيَقُرُّ عَيني وَهيَ نازِحَةٌ","مالا يَقُرُّ بِعَينِ ذي الحِلمِ",11,"م",1,1],["وَيَقْتَضِي حَقَّهُ غِلاَبا","بِلاَ تَوارٍ وَلاَ تَوَانِي",12,"ي",1,0],["وَيُقِرُّ بِالتَّقْصِيرِ عِنْدَ سَمَاعِهاَ","رَبُّ الْقَصَائِدِ فيِ بَني حَمْدَانِ",13,"ن",1,0],["وَيُقْصَدُ وَجْهُ اللَّهِ بِالْعَمَلِ الرّضَى","وَتُجْنَى ثِمَارُ الْعِزِّ مِنْ شَجَرِ الْعَزْمِ",14,"م",1,0],["ويُقْنِعُنِي أَنِّي بِهِ مُتَكَيِّفٌ","فَزَمْزَمُهُ دَمْعِي وَجِسْمِي حَطِيمُهُ",15,"م",2,0],["وّيَقُولُ النَّاسُ فِي مَثَلٍ","لاَ تُحَرِّكْ مَنْ دَنَا أَجَلُهْ",16,"ه",1,0],["ويُقْسِمُ لي أنْ لا يخونَ مَواثِقاً","تخِذْتُ علَيْهِ مُحْكَماتِ المَعاقِدِ",17,"د",1,0],["وَيُقِرُّ عَيْنَ الْمُلْكِ بِالقَمَرِ الَّذِي","خَضَعَتْ لَهُ الأَقْمَارُ فِي هَالاَتِهَا",18,"ت",3,0],["وَيُقَالُ هَذَا كَافِلٌ لِخِلاَفَةٍ","تَخْتَالُ لِلْبَرَكَاتِ فِي جلْبَابِ",19,"ب",1,0],["وَيَقولُ مَن يَبقيهِمُ بِنَصيحَةٍ","هَل غَيرُ فِعلِ قَبيلَةٍ مِن عادِ",20,"د",1,0],["وَيَقسِمُ أَمرَ الناسِ يَوماً وَلَيلَةً","وَهُم ساكِتونَ وَالمَنِيَّةُ تَنطِقُ",21,"ق",1,0],["وَيُقبِلُ ذو البَثِّ وَالراغِبو","نَ في لَيلَةٍ هِيَ إِحدى اللَزَن",22,"ن",1,0],["وَيَقيسُ شُقَّتَها بِمِقياسِ النُهى","فَتَرى صَحيحَ قِياسِ الاِصطِرلابِ",23,"ب",1,0],["وَيُقالُ هَذا القُطبُ بابُ المُصطَفى","وَوَسيلَةٌ تُقضى بِها الحاجاتُ",24,"ت",1,0],["وَيَقطَعُ المُقفِراتِ الموحِشاتِ إِذا","عَن قَطعِها كَلَّتِ المَهرِيَّةُ البُزُلُ",25,"ل",1,0],["وَيَقبَحُ بي أَن أَرتَجي مِن سِواكُمُ","نَوالاً وَأَن يُعزى إِلى غَيرِكُم شُكري",26,"ر",2,0],["وَيُقِلْهَا النِّيلُ الحَفِي بِرَكْبِهَا","وَتَحُوطُهَا بِظِلالِهَا الأَهْرَامُ",27,"م",1,0],["وَيُقِرُّ مَمْلَكَةً إِلَيْهِ أَمْرُهَا","بَيْنَ المَمَالِكِ فِي أَجَلِّ مَقَامِ",28,"م",1,0],["ويَقِلُّ أَنْ يَتَنَدَّرُوا بَعَظِيمِ مَا","يَلْقَوْنَ مِنْ كُرَبٍ وَمِنْ ألامِ",29,"م",1,0],["ويقول على الطريبا","دن دنان دن دنان",30,"ن",1,0],["ويقولوا حن يروني","سكر هي من الف شاهر",31,"ر",1,0],["ويقيت يا بدر الهدى تجري بما","شاءت علاك سَوابقُ الأقدار",32,"ر",1,0],["ويَقوَى من يكون بها ضعيفاً","ويَغنَى من يعيش بها فقيرا",33,"ر",2,0],["وَيُقضى الأَمرُ حينَ تَغيبُ تَيمٌ","وَلا يُستَأمِرونَ وَهُم شُهودُ",34,"د",1,0],["وَيَقولُ مَن وَرَدَت عَلَيهِ رِكابُنا","أَمِنَ الكُحَيلِ بِهِنَّ لَونُ عَصيمِ",35,"م",1,0],["وَيَقولُ فِيَّ الحاسِدونَ تَكَذُّباً","وَيُقالُ في المَحسودِ مالا يَفعَلُ",36,"ل",1,1],["وَيَقصِدُني بِالهَجرِ عِلماً بِأَنَّهُ","إِلَيَّ عَلى ماكانَ مِنهُ حَبيبُ",37,"ب",1,0],["ويقتضي الهمّ تسهادِي فيا حرباً","من قاتلين على إنسانيَ اجتمعا",38,"ع",2,0],["ويقرع سمعي من معاريض نظمه","مداكُ عروسٍ أو صلابة حنظل",39,"ل",1,0],["ويقسم فينا كل سهم من الندى","ويبعث للأعداء في الرّوع أسهما",40,"م",2,0],["ويقول فيض فعاله ومقاله","مرج النهى بحرين يلتقيان",41,"ن",1,0],["ويقضِي على أموالِه فيمينه","على منبع السلسال أوْطف هتَّان",42,"ن",1,0],["ويُقرى ضيفُهم فيها","مَلاطاً بعده مَزْنَى",43,"ن",2,0],["ويقينَه بردَ الهواءِ وحرَّهُ","إن أصْرَدَ العَصْرَان أو إن ألهبا",44,"ب",2,0],["ويقضي إمام الحق فيكم قضاءَهُ","تماماً وما كلُّ الحوامل تُخْدَجُ",45,"ج",1,0],["ويقرصون بجدٍّ في ممازحةٍ","وإن قرصْتُ فما قرصي بتجميش",46,"ش",1,0],["ويقْلسُ أريَ النحل للمستميحهِ","وللمتعدِّي ما تمجُّ الأراقط",47,"ط",1,0],["ويقيك كلَّهمُ الحتوفَ ولم تَمُتْ","نفسٌ تُلاقي حتفَها وتقيكا",48,"ك",2,0],["ويقومُ طِرفٌ دون شوطِ رسيله","ويحلّيان حُلىً لهنَّ تصلصلُ",49,"ل",1,0],["وَيَقَعنَ في خَلَقِ الإِزاءِ كَأَنَّهُ","نُؤيٌ تَقادَمَ عَهدُهُ مَهدومُ",50,"م",1,0],["وَيَقولُ أَياهَذا قَدكا","فَوَحَقِّكَ ذا الطَيشُ الأَكبَر",51,"ر",1,0],["وَيَقولُ لا أَنساكَ يا حُلمي وَلَو","نَسَجَت عَلَيَّ عَناكِبُ النِسيانِ",52,"ن",1,0],["وَيُقصيهِ النَديُّ وَتَزدَريهِ","حَليلَتُهُ وَيَنهَرُهُ الصَغيرُ",53,"ر",1,0],["وَيُقالُ إِنَّكَ قَد كَبِر","تَ عَنِ الهَوى فَأَقولُ إِنّي",54,"ن",2,0],["وَيَقولُ لَم أَحزَن لِذا","كَ وَلَم أَكُن مُتَأَسِّفا",55,"ف",2,0],["وَيُقالُ ياريمَ الكِنا","سِ لَهُ وَيا زَينَ الكَنائِس",56,"س",1,0],["وَيَقولونَ عاشِقٌ وَهُوَ وَصفٌ","مِن صِفاتي المُقَوِّماتِ لِذاتي",57,"ي",1,0],["وَيَقطَعنَ مِن خَبطٍ وَأَرضٍ بَسيطَةٍ","بَسابِسَ قَفراً وَحشُهُنَّ عُروجُ",58,"ج",1,0],["ويَقِيهمُ وَهجَ الحَيَاةِ ولَفْحَها","ويذودُ عنهم شَرَّةَ الآلامِ",59,"م",1,0],["ويقضي صَباحُ الحياةِ البديعُ","وليلُ الوجودِ الرهيبُ العتيدْ",60,"د",1,0],["وَيَقُلنَ إِنَّكَ قَد رَضيتَ بِباطِلٍ","مِنها فَهَل لَكَ في اِعتِزالِ الباطِلِ",61,"ل",1,0],["وَيَقُلنَ إِنَّكِ يا بُثَينَ بَخيلَةٌ","نَفسي فِداؤُكِ مِن ضَنينٍ باخِلِ",61,"ل",1,0],["ويقوم ان حزبته حا","زبة مقام الجحفل",62,"ل",1,0],["ويقول عقلي والرجا","ء مطية المتخيل",62,"ل",1,0],["ويقين خالص في ال","قلب ما شيب بمين",63,"ن",1,0],["ويقال لا تحِصى المهاجر ثروة","وأقول لا يحصى الرجاء كرامها",64,"م",3,0],["ويقوم في ناديك عنهم منشدا","بيتا به يطرى الكريم ويمدح",65,"ح",1,0],["ويقائق النَّسرين في أغصانها","كالدر ركب في صدور رماح",66,"ح",1,0],["وَيَقولُ وَفّوها الرِعا","يَةَ في الرَحيلِ وَفي الإِقامَه",67,"م",2,0],["وَيَقولُ الحَمدُ لِل","هِ إِلَهِ العالَمينا",68,"ن",2,0],["وَيُقالُ لِلأَرضِ الفَضاءِ تَمَخَّضي","فَتَرُدُّ شَيخاً أَو تَمُجُّ جَنينا",69,"ن",2,0],["وَيُقيمُ مَنطِقَ كُلِّ أَعوَجِ مَنطِقٍ","وَيُريهِ رَأياً في الأُمورِ أَصيلا",70,"ل",2,0],["وَيُقريهُمُ الأُنسَ في مَنزِلٍ","وَيَجمَعُهُ وَالأَسى مَنزِلُ",71,"ل",1,0],["وَيَقولُ كُلُّ مُحَدِّثٍ لِسَميرِهِ","أَبِذاتِ طَوقٍ بَعدَ ذَلِكَ يوثَقُ",72,"ق",1,0],["وَيَقولُ تَكادُ تُجَنُّ بِهِ","فَأَقولُ وَأوشِكُ أَعبُدُهُ",73,"د",2,0],["وَيَقولُ قَومٌ كُنتِ أَشأَمَ مَورِدٍ","وَأَراكِ سائِغَةً عَلَيكِ زِحامُ",74,"م",1,0],["وَيَقولُ الطِبُّ بَل مِن جَنَّةٍ","وَرَأَيتُ العَقلَ في الناسِ نَدَر",75,"ر",1,0],["وَيَقولونَ جَفاءٌ راعَهُ","مِن أَبٍ أَغلَظَ قَلباً مِن حَجَر",75,"ر",1,0],["وَيُقدِمُ إِلّا عَلى أَن يَفِرَّ","وَيَقدِرُ إِلّا عَلى أَن يَزيدا",76,"د",2,0],["ويقبله دماً يغدو وينمي","تردّد في النزول وفي الترقي",77,"ق",2,0],["ويُقنعُني منه على العِزّ أنّهُ","يروقُ لِقاءٌ أو يرِقُّ كلامُ",78,"م",1,0],["ويقدُمُنِي من دون شِسْعِي نِجادُه","فأُغِضي وَخدُّ الفضلِ أغبرُ ضارعُ",79,"ع",1,0],["ويقصُرُ باعي أنْ ينالَ شظيّةً","من العِزِّ يزكو نَيْلُها ويَطيبُ",80,"ب",1,0],["وَيُقلِقُهُ شَوقٌ إِلى القِرنِ مُعجِلٌ","لَدى الطَعنِ حَتّى يَستَريحَ إِلى الضَربِ",81,"ب",1,0],["وَيَقلَقُ حَتّى يُنجِزَ الوَعدَ مِثلَ ما","يُجافي الَّذي يَمشي عَلى رَمَضِ الرَضفِ",82,"ف",1,0],["وَيَقِلُّ اِنتِصارُ مَن هَضَمَتهُ","ذاتُ كَشحٍ مَهَفهَفٍ مَهضومِ",83,"م",1,0],["وَيَقعُدُ بِاِبنِ توما بَيتُ سوءٍ","مِنَ الأَنباطِ يَعجَزُ أَن يَقوما",84,"م",2,0],["ويقال إنَّ الشيخَ يأكلُ دائباً","عَضَلاً يُداوي منه خَطباً مُعضِلا",85,"ل",2,0],["ويقولُ لي قومٌ فَضَلْتَ وإنّما","فَضلُ الثَّناءِ عليهِ من إفضالِه",86,"ل",2,0],["ويقولُ سامعُها إذا ما أُنْشِدَتْ","أعقودُ حَمْدٍ أم عُقودُ كَواكبِ",87,"ب",1,0],["وَيَقيكَ ما وَقّى الأَكارِمَ مِن","حوبٍ تُسَبُّ بِهِ وَمِن غَدرِ",88,"ر",1,0],["وَيَقولُ كُنتُ مُلاعِباً وَمُمازِحاً","هَيهاتَ نارُكَ في الحَشا تَتَسَعَّرُ",89,"ر",1,0],["وَيَقولُ الوِصالُ يا نارُ بَرداً","وَسَلاماً كوني لِإِبراهيمِ",90,"م",1,0],["وَيُقسَمُ في الأَنامِ زَكاةُ مَدحٍ","وَما لَكَ في نِصابِهُم نَصيبُ",91,"ب",1,0],["وَيَقصِدُني مَن لَو تَمَثَّلَ شَخصُهُ","بِعَينِ قَذىً ما عاقَ جَفني عَنِ الغَمض",92,"ض",1,0],["ويُقْبِلُ في فضفاضةٍ فارسيّةٍ","تحدِّثُ عن أبطالِ عادٍ وجُرْهُمِ",93,"م",1,0],["ويقصرُ في الحقيقة كلُّ شيءٍ","ثَنَيْتَ جمِيعَهُ غَيْرَ الكَلامِ",94,"م",1,0],["ويُقْسمُ للتقبيلِ فوكِ مُصَدَّقاً","بِأَنَّ الَّتي تَحوي القَسيمَةَ مِتْفَالُ",95,"ل",1,0],["ويقتادهم منهُ شهامَةُ قائدٍ","به جُمْلَة الجيشِ العَرَمرَمِ تَعْتَدُّ",96,"د",1,0],["ويَقدَحُ قَرعَ البيضِ في البيضِ نارَها","كما ينتضي القدحُ الشرارَ مِنَ الزَندِ",97,"د",1,0],["وَيَقولونَ إِنَّكَ المَرءُ بِالغَي","بِ مُحامٍ عَنِ الصَديقِ نَصورُ",98,"ر",1,0],["وَيَقولُ وَالشَرَفُ المُنيفُ يَحُفُّهُ","لا خَيرَ في شَرَفٍ إِذا لَم أُحمَدِ",99,"د",1,0],["ويقصدُ في العيدينِ غيظي فكبدهُ","ولبتُهُ ودي لها الفطرُ والنحرُ",100,"ر",1,0],["ويُقَلِّبُ الدُّنيا الغَرُورَ فلا يَرَى","فيها الذي يُجْدِي الغُرُورَ فَتِيلا",101,"ل",2,0],["ويقترِحْنَ علينا أنْ نُجرَّعَهُ","كالسمِّ يجرعُه سُقراطُ تَوْطينا",102,"ن",2,0],["وَيَقولُ إِنَّكِ قَد عَلِمتِ بِأَنَّكُم","أَصبَحتُمُ يا بِشرُ أَوجَهَ ذي دَمِ",103,"م",1,0],["وَيَقيلُ مَن أَمِنَ بِهِ ظَبيُ النَقا","في جِحرِ خيسِ الضَيغَمِ الزَئّارِ",104,"ر",1,0],["وَيَقتُلنَ أَبناءَ الصَبابَةِ عَنوَةً","أَما في الهَوى يا رَبِّ مِن حَكَمٍ عَدلِ",105,"ل",1,0],["ويُقيمُ لِلأخلاقِ من آياتِه","صَرْحاً تُراعُ له الصُّروحُ وَتُذْعَرُ",106,"ر",1,0],["ويُقيمُ مِيزانَ الأمورِ بِحكمةٍ","تُعطِي الضعيفَ من القويِّ ضَمانا",107,"ن",2,0],["وَيَقولُ لِلصادي المُصَفِّقِ وِردُهُ","أَتَموتُ أَم تَحيا بِغَيرِ شَرابِ",108,"ب",1,0],["وَيَقولُ قَومٌ تِلكَ آيَةُ مُلكِنا","تُملَى وَتُكتَبُ كُلُّها وَتُزادُ",109,"د",1,0],["وَيُقسِمُ دَهقانُهُم أَنَّهُ","أَبادَ المَطِيَّ وَأَفنى الكُتُبْ",110,"ب",1,0],["ويُقيمُ أعلامَ الهُدَى","للتابعين مِنَ الهُداةِ",111,"ه",1,0],["وَيُقامُ دِينُ اللّهِ في القومِ الأُلَى","فُتِنُوا بأصنامٍ تُقامُ وتُنْصَبُ",112,"ب",1,0],["ويقولُ دَعْهَا يا مُحَمَّدُ خُطّةً","يُرمَى بها الشّرفُ الرفيعُ فيُثلَمُ",113,"م",1,0],["ويقول للصدِّيقِ مَن هو يا أبا","بكرٍ وَأَيَّةَ مِلّةٍ نَترسَّمُ",113,"م",1,0],["ويقول موعدُنا المدينةُ إذ يُرَى","أيُّ الفريقينِ الأذلُّ الأضعف",114,"ف",1,0],["وَيَقنعون بِمبذولٍ يلوِّحُهُ","مُستعمِروهم بِتبعيد وَتَقريبِ",115,"ب",1,0],["ويُقر عينَكَ عبثهن","ن إذا جَثَمْن بريشهنّه",116,"ن",2,0],["وَيَقبَلُ المُستَأمِنَ المُنيبا","وَيَغفِرُ الزَلّاتِ وَالذُنوبا",117,"ب",2,0],["وَيقولُ لَم أَهجُر بَلى إِذ بُنتُمُ","أَوَلَيسَ يُشبِهُ بَينَ صَبٍّ هَجرُهُ",118,"ر",2,0],["ويقول خالِقُه أبوهُ وإنَّه","رَبٌّ وإنسانٌ أَلا فَتَعجَّبوا",119,"ب",3,0],["ويقوده اللَّيْثُ الغَضَنْفَرُ مُعْلَماً","من كلِّ شثن اللِّبْدَتينِ غضَنفر",120,"ر",1,0],["وَيَقصُرُ كَفُّ الدَهرِ عَمَّن أَجارَهُ","وَيَرعى مِنَ الآفاتِ مِن حَيثُ لا يَدري",121,"ي",1,0],["وَيَقطَعُ وُدّي مِن سُهَيلِ بنِ سالِمٍ","كَبِرتُ وَلا يَرجو طِعاني إِذا اِنفَرَد",122,"د",1,0],["وَيَقولونَ اِدنُ مِنها مَجلِساً","قُلتُ لَو وُقِّدَ عَمروٌ وَقَدا",123,"د",2,0],["وَيَقولُ الوُشاةُ أَحبَبتَ سُعدى","صَدَقوا وَالجَليلِ حُبّي عَياءُ",124,"ا",2,0],["وَيَقولُ الطَبيبُ في رَحمَةِ اللَ","هِ غَناءٌ وَلَيسَ عِندي غَناءُ",124,"ا",2,0],["وَيَقذِفنَ بِالأَولادِ في كُلِّ مَنزِلٍ","تَشَحَّطُ في أَسلائِها كَالوَصائِلِ",125,"ل",1,0],["وَيُقالُ الكِرامُ قَولاً وَما في ال","عَصرِ إِلّا الشُخوصُ وَالأَسماءُ",126,"م",3,0],["وَيَقومُ مَلِكٌ في الأَنامِ كَأَنَّهُ","مَلِكٌ يُبَرِّحُ بِالخَبيثِ المارِدِ",127,"د",1,0],["وَيَقولُ داري مَن يَقولُ وَأَعبُدي","مَه فَالعَبيدُ لِرَبِّنا وَالدارُ",128,"ر",1,0],["وَيُقالُ أَنَّ مَدى اللَيالي جاعِلٌ","جَبَلاً أَقامَ كَزاخِرٍ مَوّارِ",129,"ر",1,0],["وَيُقامِرُ الإِنسانُ طولَ حَياتِهِ","قَدَراً تَمَنَّعَ مِن رِضاً بِقِمارِ",130,"ر",1,0],["وَيُقالُ إِنَّ اللَهَ جَلَّ ثَناؤُهُ","يَوماً يُطَهِّرُ أَرضَهُ بِالنارِ",131,"ر",1,0],["وَيَقضي بِنا فَرضَهُ ناسِكٌ","يُمِرُّ اليَدَينِ عَلى الظاهِرِ",132,"ر",1,0],["وَيُقيمُ في الدارِ المُنيفَةِ لَيلَةً","وَإِذا تَرَحَّلَ لَم يَعُقهُ الآزِلُ",133,"ل",1,0],["وَيَقولُ الغُواةُ خَوَّلَكَ اللَهُ","كَذَبتُم لِغَيرِيَ التَخويلُ",134,"ل",1,0],["وَيَقولُ ما اِسمُكِ وَاِسمُ أُمُّكِ إِنَّني","بِالظَنِّ عَمّا في الغُيوبِ مُتَرجمُ",135,"م",1,0],["وَيُقسَمُ حَظُّ النَفسِ شَرقاً وَمَغرِباً","عَلى قَدَرٍ مِن خامِلٍ وَنَبيهِ",136,"ب",3,0],["ويقالُ إنّ البَحرَ غاضَ وإنّها","ستَعُودُ سِيفاً لُجّةُ الرَّجّافِ",137,"ف",1,0],["وَيَقول من يفتك بزنديق يفز","في جنة المأوى بوصل الحور",138,"ر",1,0],["ويقلُّ عُمر الدهر تَوفيَةً لما","أسدَيتِه بجمالكِ الوضَّاء",139,"ا",2,0],["ويقتحمُ الموتَ في مأزقٍ","ترى الأرضَ من هوله واجفَه",140,"ف",2,0],["ويقول شعراً كيفما اتفقا","يُغري ذوات الثُّكل بالضحكِ",141,"ك",1,0],["ويقبلُ الفجرُ الرقيقُ الإهابْ","يحنو على القبر بأضوائهِ",142,"ه",1,0],["ويقبلُ الليلُ الدجيُّ المخيفْ","فلا ترى نجماً ينيرُ السماءْ",142,"ا",2,0],["وَيَقتَحِمونَ أَهوالَ المَنايا","غَداةَ الكَرِّ في الحَربِ العَوانِ",143,"ن",1,0],["وَيَقْتَنِي نَبْعَةً يَصِيدُ بِهَا","ونَبْعُ مَنْ حَارَبَ الرَّدَى غَرَبُ",144,"ب",1,0],["وَيُقِيمُ الآمَالَ فِي النَّفْسِ كَالنو","رِ يُحِيلُ البُذُورَ زَهْراً أَنِيقَا",145,"ق",2,0],["وَيُقِرُّ السَّلِيمَ مِنْ كُلِّ زَيْفٍ","بَعْدَ لأْيٍ فِي المَحْوِ وَالإِثْبَاتِ",146,"ت",1,0],["وَيَقَرَّ نَاظِرَهُ بِرُؤْيةِ رَايَةٍ","خَضْرَاءَ فَيَّأَتِ الإِخَاءَ نَزِيلاَ",147,"ل",2,0],["وَيقَابِلُونَكِ يَا عَرُوسَ عَزِيزِهِمْ","بِعَفَافِ أَطْفَالٍ وَرِفْقِ كِبارِ",148,"ر",1,0],["وَيَقِينٌ باللّه ما مَسَّهُ الضَّعْفُ","وَلاَ طَائِفٌ مِنَ الشَّكِّ شَانَه",149,"ن",2,0],["ويقطع حينما ينبو","كذي غرْب وإفرند",150,"د",1,0],["ويقنعُ من عيشه بالكفاف","ويجزي عليه بحسن الثَّناء",151,"ا",2,0],["ويقينُنَا في الله خيرُ عَتَادِنا","وعليه في قهر العِدَا نتَوَكَّل",152,"ل",1,0],["ويقول قائِلُنا لدى استشهادهِ:","يا ليتني في كلِّ يوم أُقْتَل!",152,"ل",1,0],["ويقينٌ بالذي يحرسُه","من بَلُدْ بالله لم يَخْشَ سواه",153,"ا",2,0],["ويُقَرِّبُ المجدَ البَعِي","دَ بِحَيْثُ يَغْضَبُ أو يُفَاِخْر",154,"ر",1,0],["ويقذفه شبح مفزع","إلى شبح موحش مفزع",155,"ع",1,0],["ويقضي على مُطْرِفِ المكرُمات","ويأتي على الحَسَب المُتلد",156,"د",1,0],["ويقدُرُ إن ضمَّ منه اليدينِ","ايَّ ثمينٍ نفيسٍ حَوى",157,"ا",1,0],["ويقولُ إن قالوا تصرف درهمٌ","ليت الجمودَ عَداهُ عن تصريفه",158,"ف",2,0],["وَيَقيهِ ذَمَّ الرّجالِ، إذا شَا","ءَ رِجَالٌ عَنِ المَعالي قُعُودُ",159,"د",1,0],["ويقطعنَ منْ خبتٍ وأرضٍ بسيطة","ٍ بسابسَ قفراً وحشهنَّ عروجُ",160,"ج",1,0],["ويقلن: إنك قد رضيت بباطل","منها فهل لك في اجتناب الباطل",161,"ل",1,0],["ويقلن : إنك يا بثين بخيلة","نفسي فداءك من ضنين باخل",161,"ل",1,0],["وَيُقْضَى نَفِيسُ العُمْرِ فِي الوَعْدِ وَالمَطْلِ","فَلَمْ أَرَ أَهوَى مِنْ جَمِيل وَأَطْوَعَا",162,"ع",2,0],["ويقيم ميزانا الأمور بحكمة","تعطي الضعيف من القوي ضمانا",163,"ن",2,0],["وَيَقولُ العُداةَ أَودى عَدِيٌّ","وَعَدِيٌّ بِسُخطِ رَبٍّ أَسيرُ",164,"ر",1,0],["ويَقْتُلنا لَحْظٌ، ويأْسِر جِيدُ","بأهلٍ ، ومفقودُ الأليفِ وَحيد",165,"د",1,0],["وَ يقلنَ منْ للمستضيقِ إذا دعا","أمْ منْ لخضبِ عوالي المرانِ",166,"ن",1,0],["ويقتحم الموت في مأزق","ترى الأرض من حوله واجفه",167,"ف",2,0]]}