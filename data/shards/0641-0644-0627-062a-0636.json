{"poems":[[53,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[53,"ألا قل لذي العطن الواسع","https://www.aldiwan.net/poem65403.html","المتقارب"],[53,"علي دين ثقيل أنت قاضيه","https://www.aldiwan.net/poem66716.html","البسيط"],[47,"إذا انبسطنا رددنا عن زيارتنا","https://www.aldiwan.net/poem64631.html","البسيط"],[68,"ما ماس منعطفا في قرطق وقبا","https://www.aldiwan.net/poem39203.html","البسيط"],[46,"قل للأمير تجد للقول مضطربا","https://www.aldiwan.net/poem29988.html","البسيط"],[52,"ودع عبيدة إن البين قد أفدا","https://www.aldiwan.net/poem63908.html","البسيط"],[48,"يؤدبك الدهر بالحادثات","https://www.aldiwan.net/poem22159.html","المتقارب"],[78,"يا من يضن بصوت الطائر الغرد","https://www.aldiwan.net/poem39325.html","البسيط"],[102,"مغني الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=50186",""],[52,"ودع عبيدة إن البين قد أفدا","https://www.poetsgate.com/ViewPoem.aspx?id=21802",""],[101,"صباح السكر","https://www.poetsgate.com/ViewPoem.aspx?id=577",""],[132,"أكرم بمن يسأل سؤاله","https://www.aldiwan.net/poem50550.html","السريع"],[164,"التام جرح والاساة غيب","https://www.aldiwan.net/poem59006.html","الرجز"],[266,"أرى اليأس عزا والرجا ذلة الفتى","https://www.aldiwan.net/poem38272.html","الطويل"],[275,"أفي دار قومي يسكن الغرباء","https://www.aldiwan.net/poem35648.html","الطويل"],[330,"سؤالك يا هذا سؤال معاند","https://www.aldiwan.net/poem52139.html","الطويل"],[347,"أنا أهواك يا ليلى","https://www.aldiwan.net/poem55339.html","الهزج"],[369,"أقول وقد ناحت مطوقة ورقا","https://www.aldiwan.net/poem60830.html","الطويل"],[371,"لكل مودة أجر وأجري","https://www.aldiwan.net/poem17316.html","الوافر"],[463,"مالك لا تطرب يا حادي النعم","https://www.aldiwan.net/poem55901.html","الرجز"],[469,"مابعد لقياك للعافين من أملِ","https://www.aldiwan.net/poem3136.html","عموديه"],[482,"آليت لا حلت ولا حلتم","https://www.aldiwan.net/poem15270.html","السريع"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66962","البسيط"],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/138859",""],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202091","المتقارب"],[1294,"","https://poetry.dctabudhabi.ae/diwan/poem/101119","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113922","الوافر"],[1949,"","https://poetry.dctabudhabi.ae/diwan/poem/105287","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27883","البسيط"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140308",""],[3560,"","https://poetry.dctabudhabi.ae/diwan/poem/117155","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91917","السريع"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216746","المتقارب"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131016",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133299","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77157","الطويل"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139230","المجتث"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139502",""],[5072,"لا تدعها","https://www.poetsgate.com/ViewPoem.aspx?id=52557",""],[5653,"أربرب بالكثيب الفرد أم نشأ؟","https://www.poetsgate.com/ViewPoem.aspx?id=3011",""],[5660,"دَعِ الكِمياءَ تَفعَلُ ما تَشاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=23713",""],[5701,"رعى الله على دِجل","https://www.poetsgate.com/ViewPoem.aspx?id=164597",""],[5377,"رثاء شعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79547&r=&rc=1",""]],"verses":[["فلا تَضَعَنَّ رِفدَك دون قدري","فليس يفوتُ بسطَتَكَ انتصابي",0,"ب",2,0],["فلا تضعوا عالياً ربما","جنى وضعُهُ ندمَ الواضع",1,"ع",1,0],["فلا تُضِعْني وتَجْني لي إضاعتَهُمْ","إيايَ لا ضاع أَمرٌ أنت راعيه",2,"ي",2,0],["فَلا تَضُنّوا بِإِحدى الحاجَتَينِ فَلا","عُذرٌ لِمانِعِ داني القَدرِ مُنخَفِضِ",3,"ض",1,0],["فَلا تُضِع ساعَةً كانَت لَنا هِبَةً","مِن قَبلِ أَن يَستَرِدَّ الدَهرُ ما وَهَبا",4,"ب",2,0],["فَلا تُضِعها فَما في الأَرضِ أَحسَنُ مِن","نَظمِ القَوافي إِذا ما صادَفَت حَسَبا",5,"ب",2,0],["فَلا تَضِنّي بِتَسليمٍ عَلى رَجُلٍ","لا يَجِدُ الناسُ إِلّا دونَ ما وَجَدا",6,"د",2,0],["فَلا تُضحِكَنَّ اِبنَةُ السَنبَسيُّ","فَأَوجَبُ مِن ذاكَ أَن تَندُبا",7,"ب",2,0],["فلا تَضنَّ على أُذُني تُقَرِّطها","صوتاً يجولُ مجالَ الروحِ في الجسدِ",8,"د",1,0],["فلا تضيقي بمغنّي الهوى","وهل يضيق الروض بالطائر ؟",9,"ر",1,0],["فلا تضني بتسيلم على رجل","لا يجد الناس إلا دون ما وجدا",10,"د",2,0],["فلا تضجري من ذهولي وصمتي","ولا تحسبي أن شيئاً تغير",11,"ر",1,0],["فلا تضاهِيه بمن دُونه","هل يستوى الأعلى أو الأسفلُ",12,"ل",1,0],["فلا تضق ذرعا فرب آئس","نال المنى من حيث لا يحتسب",13,"ب",1,0],["فلا تضجرن من حالة مستحيلة","كما نلتها عسراً ستتركها يسرا",14,"ر",2,0],["فلا تضحكي يا أجنبيّةُ في الأسى","وقومُكِ مِنهم سلطةٌ وقضاء",15,"ا",2,0],["فلا تضمنن نفس ومال بمثله","ولا يعقبن عاد بمثل الجريمة",16,"ه",1,0],["فلا تضنيني يا ليلى","وخافي اللَه في صبك",17,"ك",1,0],["فلا تَضْرِبي قال الفِراقُ مَجانةً","فَتلقَيْ على فَقْدِ الأحبّةِ ما أَلْقى",18,"ق",2,0],["فَلا تَضرِب لَهُ أَجَلاً بِفَجرٍ","فَقَد مَخِضَت وَما طَرَقَت بِفَجرِ",19,"ر",1,0],["فلا تَضِع تلك الحقوقُ بينكم","ولا تَخِبْ عندكُمُ تلك الذِّمَمْ",20,"م",1,0],["فلا تضعهُ فما الدين الحنيف على","خلقٍ سواك من الدنيا بمتّكل",21,"ل",1,0],["فلا تَضيقَنَّ بأفعالِه","فربَّما هانَ الذي يَعظُمُ",22,"م",1,0],["فلا تَضَعْ مَرْبَأً للجيشِ تَنْهَدُهُ","فالنصرُ مُرْتَبِئٌ والسَّعْدُ مُرْتَبَأُ",23,"ا",1,0],["فلا تضجر وَصانِعه","وإلا تُرمَ بالخُرق",24,"ق",1,0],["فلا تضعفوا إنّ مستنصرا","وليّ الإله وليٌّ نَصِير",25,"ر",1,0],["فلا تضجرن من حالة مستحيلة","كما ظنها عسراً سيشركها يسرا",26,"ر",2,0],["فلا تضَعِ السلاحَ فإنَّ فيهِ","لأهلِ الدين عندكُمُ نَصيبا",27,"ب",2,0],["فلا تضع ساعة في غير واجبة","فاجهد فان حياة المرء ساعات",28,"ت",1,0],["فلا تضاعفه ولا تعدِّده","لأنه عينُه أكرم به نسبا",29,"ب",2,0],["فلا تضم لآس غير سوسنةٍ","ولا بنفسجةٍ إلى لنسرين",30,"ن",1,0],["فلا تضِع حقّ قحطانٍ فتُغضِبَها","ولا ربيعةَ كلّا لا ولا مضَرا",31,"ر",2,0],["فَلا تضق ذرعاً وَكُن واثقاً","ما دامَ إقبالٌ وإدبار",32,"ر",1,0],["فلا تضحكن فكم عابس","وفيّ وكم ضاحك قد غدر",33,"ر",1,0],["فلا تضبي إن سرت ابغي لقاءها","إلى موطن فيه المفاخر تكسب",34,"ب",1,0],["فلا تضيق مجالا بات متسعا","فالله أولى بنا في الموقف الحرج",35,"ج",1,0],["فَلا تَضَع الأَشياءَ إِلا بِوَقتِها","وَكُل مَحل لِلأَفاعيل قابِل",36,"ل",1,0],["فلا تضيع صديقا","فالنفع فيه جليل",37,"ل",1,0],["فلا تضرع لنائبةٍ ألمَّت","ولا تجزع إذا نزل البلاء",38,"ا",2,0],["فلا تُضع ِ الثواب َ بها فتأتي","بيوم ِ الدين ِ مكسور َ الخواطر",39,"ر",1,0],["فلا تضع مربأ للجيش تنهده","فالنصر مرتبىء والسعد مرتبأُ",40,"ا",1,0],["فَلا تُضني فُؤادي هاكِ عَيني","فَإِن أُخِذَت فَلَن يُرجى عَزاءُ",41,"ا",2,0],["فلا تضليل للناس","ولا طبل ولا زمرا",42,"ر",2,0],["فلا تُضِعْ عُمْرَ الأجيالِ في ضعة الشْ","كوى فيكفيكَ ماضيه، ويكفيهِ",43,"ي",2,0]]}