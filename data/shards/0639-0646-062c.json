{"poems":[[74,"مدمع سائل لغير رحيم","https://www.aldiwan.net/poem19679.html","الخفيف"],[87,"قم ناد أنقرة وقل يهنيك","https://www.aldiwan.net/poem63757.html","الكامل"],[119,"الحمد لله راح الهم والحزن","https://www.aldiwan.net/poem40472.html","عموديه"],[133,"حدث الشاعر عن نور القمر","https://www.aldiwan.net/poem60382.html","الرمل"],[147,"عوضونا من السهاد الرقادا","https://www.aldiwan.net/poem11742.html","الخفيف"],[240,"غاداك من بحر الرواعد مسبل","https://www.aldiwan.net/poem31795.html","الكامل"],[259,"قلب عنيد","https://www.aldiwan.net/poem24960.html","مجزوء الرمل"],[309,"خل عنك الهم يا قلب الحزين","https://www.aldiwan.net/poem16773.html","الرمل"],[309,"نسيم حاجر يا نسيم حاجر","https://www.aldiwan.net/poem16790.html","الرجز"],[457,"ريحانتي روض الإخاء ونيري","https://www.aldiwan.net/poem13810.html","الكامل"],[463,"للنقص من أعمارنا ما يكمل","https://www.aldiwan.net/poem56077.html","الكامل"],[482,"حييت من دمن ومن أطلال","https://www.aldiwan.net/poem15352.html","الكامل"],[487,"ما الزهر ما ما الرحمن ما الحلل","https://www.aldiwan.net/poem24462.html","عموديه"],[505,"كل وقت له من القوم شيخ","https://www.aldiwan.net/poem37749.html","الخفيف"],[519,"أمن البروج تعد أكناف الحمى","https://www.aldiwan.net/poem20815.html","الكامل"],[529,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[566,"أنيخ مسحول مع الصبار","https://www.aldiwan.net/poem27822.html","الرجز"],[572,"عنج اللحظ ولين المنطق","https://www.aldiwan.net/poem69578.html","الرمل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122780","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87271","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86864","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63828","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59260","الرمل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126128","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18430","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78173","الكامل"],[1949,"","https://poetry.dctabudhabi.ae/diwan/poem/105282","السريع"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100902","السريع"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93843","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132551","السريع"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91501","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91080","المديد"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103039","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111473","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77005","البسيط"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36275","الدوبيت"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119613","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90975","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94638","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72475","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72436","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120516","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139697",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139521",""],[4755,"يا حافِيَ العَينَينِ والخاطِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=186419",""],[4755,"كُلُّ شَيءٍ يَجيءُ بِالبُندُقِيّةْ","https://www.poetsgate.com/ViewPoem.aspx?id=201014",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5373,"بلاغة القرآن وإعجازه","https://www.poetsgate.com/ViewPoem.aspx?id=186008",""],[5431,"أعلنوه انسحابا ...","https://www.poetsgate.com/ViewPoem.aspx?id=212773",""],[5444,"أحلى الأمكنة","https://www.poetsgate.com/ViewPoem.aspx?id=205447",""],[5654,"حدث فقد طَابَ مَا تملى من السّير","https://www.poetsgate.com/ViewPoem.aspx?id=191766",""],[5740,"تندغ الخير","https://www.poetsgate.com/ViewPoem.aspx?id=211474",""],[5776,"سديمُ المستحيلات","https://www.poetsgate.com/ViewPoem.aspx?id=199343",""],[5815,"رفراف","https://www.poetsgate.com/ViewPoem.aspx?id=190767",""],[5897,"لا تعبث بقلب امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=164506",""],[6056,"معدن ذهب","https://www.poetsgate.com/ViewPoem.aspx?id=156704",""]],"verses":[["عن جمالِ الوجوه قصّر شجوي","وثنائي يهوى جمال العلوم",0,"م",1,0],["عَن جيدِكِ الحالي تَلَفَّتَتِ الرُبى","وَاِستَضحَكَت حورُ الجِنانِ بِفيكِ",1,"ك",1,0],["عن جده حسن آل الحسين له","وراثة قد رواها خلقه الحسن",2,"ن",1,0],["عن جمالِ الغيدِ في فِتنَتِهِ","عافَ هاروتُ الخُلُودَ المُنتَظَر",3,"ر",1,0],["عن جِنانٍ وُعِدَ الخَلقُ بها","وعلى كَوثَرِها نِعمَ المَقَرّ",3,"ر",1,0],["عَن جَهولٍ يَعُدُّها مِن عُداهُ","وَعَدُوٍّ مِن سَمعِها يَتَفادا",4,"د",2,0],["عَن جودِهِم رُوِيَت أَحاديثُ النَدى","وَبِفَضلِهِم نَطَقَ الكِتابُ المُنزَلُ",5,"ل",1,0],["عن جُحودٍ مُسْتَديمٍ","كِلْتَ لي منهُ الهلاكَ",6,"ك",1,0],["عَن جَميعَ الكَونِ حَتّى لا تَبين","وَاِبقَ مِن بَعدَ الفَنا",7,"ن",2,0],["عن جيرة الحي الذي تجاور","فالشوق قد أربى على السرائر",8,"ر",1,0],["عن جَنّةٍ في قاسيون تَسَحَّبَتْ","فيها الشمال على غصون الآسِ",9,"س",1,0],["عن جانبي دنياك فارغبْ آبقا","ودِيَ الحريصُ وما نجا المتوكّلُ",10,"ل",1,0],["عن جيرة لم تخل فكرة خاطري","من ذكر أيام لهم وليال",11,"ل",1,0],["عنجها جمعت ضدين في حلل به","سهم لصيد ظباء الحي مبتهل",12,"ل",1,0],["عن جَنابِ النَّبِيِّ جاءتْ فخُذْها","بأَمانٍ من طارِقِ الحَدَثَانِ",13,"ن",1,0],["عن جدِّه يروي أبوهُ مآثِراً","لأبيه وهوَ اليومَ يروي عنهُما",14,"م",2,0],["عَن جُودِهم عَن نَداهُم عَن فَواضِلهم","عَن منّهم عَن وَفاهُم نَيل برّهِمِ",15,"م",1,0],["عَن جَرزٍ مِنهُ وَجَوزٍ عارِ","وَاَنضَمَّ كَشحاهُ مِنَ المِضمارِ",16,"ر",1,0],["عُنُجُ اللَّحْظِ وَلِيْنُ المَنْطِقُ","مَلَكَا قَلْبِي عَلَيَّ فَشَقِي",17,"ق",2,1],["عن جيد خاذل","عاصِ العَواذِلَ والمُدامَ وَسِم عَلَى",18,"ل",2,0],["عَن جُيوش لِلمؤسسْ","ذات أَعمال مُفيدهْ",19,"ه",1,0],["عَن جُود راحته وَغَيث نَواله","وَسَحاب نعمته الغَزير الماطر",20,"ر",1,0],["عن جَنَّةِ الدنيا التي مَلَّتِ ال","دنيا وزارتْ جنَّةَ الآخره",21,"ر",2,0],["عَنْ جَبِينِ الصُّبْحِ عن صُدْغِ الدُّجَى","عَنْ مُحَيَّا البدرِ عَنْ فَرْقِ الهِلاَلْ",22,"ل",1,0],["عن جهلهم ولهوهم ما انفكوا","وعروة الدين القديم فكوا",23,"ك",3,0],["عن جاوزت كبعد علّل أبدلا","كالبا كفي زد واستعن كمن على",24,"ل",2,0],["عَن جُدَدٍ صُفرٍ وَعَن غَزورِها","وَالأُسد قَد تسمَعُ مِن زَئيرِها",25,"ر",3,0],["عَن جَدِهِ مُذ نابَ في كَشف البَلا","نابَت حُماة الشام عَن بُغداد",26,"د",1,0],["عن جوع طهران وغلاته","لم تحص بالوزن ولا المد",27,"د",1,0],["عن جانبى عينيك ألقَ الهوَى","صرعَى قضاءٍ فى الهوى مبرم",28,"م",1,0],["عن جابر صح ما ترويه من منن","وعن على وعن عثمان ذي الكرم",29,"م",1,0],["عن جوده الفياض حدث فقد","صح عن البحر حديث الرواة",30,"ه",1,0],["عن جبهة العقرب نحو قلبها","جاوزه لما ترى من قربها",31,"ه",2,0],["عَن جَوهر الودّ لا يُلهي الهَوى عَرضُ","وَعَن خَليليَ ما أَخلى الحَشا عِوَضُ",32,"ض",1,1],["عَن جَميع الخَلق أَخلصت لل","مصطَفى المُختار خَير الوُجودْ",33,"د",1,0],["عن جده وأبيه قد أخذ العلى","وسواه من عدنانه ومعدّه",34,"د",2,0],["عن جثة القتيل عبء الصد","ألقوا به لخير بهم الجند",35,"د",1,0],["عن جَمِيعَ الإِغرِيقِ جئِنا إِلَيكا","بُغيَةً أَن نُرَى أَحَبَّ لَدَيكا",36,"ك",2,0],["عَن جُنَّةٍ سَطَعَت أَو بَيضَةٍ لَمَعَت","أَوقِرنِ رَبٍّ بذاكَ الجُدِّ مَصرَعُهُ",37,"ه",1,0],["عَن جودِهِ حَدَّثَت لِسن العُفاة إِذا","ما أَبصَرَت أَبحراً أَو ما رَأَت سُحبا",38,"ب",2,0],["عَن جنحِ دُجى فرعك ما لي مَهَرَب","عَنّي حَجَب الصَباحَ ذاكَ الغَيهَب",39,"ب",1,1],["عن جود حاتم عن شجاعة عنتر","عن حِلم أحنف عن عدالة أحمد",40,"د",1,0],["عن جنة الدنيا دمشق اعتاض مذ","من جنة المأوى دعاه بشير",41,"ر",1,0],["عن جرجسٍ إن تسألوا يوم الوغى","فتُفيدكم عن فعلهِ بيروت",42,"ت",1,1],["عن جمع الدنِّ منها شملا","فلبة الكاس منها عطلى",43,"ل",2,0],["عن جانبي أرجم كنت الذي","نحاك لولا الخوف من رهطك",44,"ك",1,0],["عن جده ارث المعالي وعن","ابيه والفرع على النحر",45,"ر",1,0],["عن جودك الغيث قد نابت أنامله","إذ نُبتَ عن آل ختم الرسل مضطلعا",46,"ع",2,0],["عن جوده الناس ما صاموا وما فطروا","إلا عليه فما جاعوا ولا سغبوا",47,"ب",3,0],["عَن جُرحِهَا الثَّانِي دَفَعْنا الأَذَى","يَومًا, فَسَاقَتْنا إِلى العاشِرِ",48,"ر",1,0],["عَن جُفُونٍ سَهِيدَةٍ هامِسَاتٍ","بالأَغانِي.. بَريئةً أو شَقِيَّة",49,"ق",3,0],["عن جلوة البدر في وجه الحبيب على","مطالع قسمات الحسن تجلوها",50,"ه",2,0],["عَنْ جَهْلِهِمْ ، عَنْ ظُلْمِهِمْ كَيْ يَعْدِلُوا","بَيْنَ الوَرَى ، عَنْ بَغْيِهِمْ أَنْ يُقْلِعُوا",51,"ع",3,0],["عن جنونٍ وسكرة وتلاشٍ","في انتشاءٍ بحضرة العشق غابا",52,"ب",2,0],["عن جنةِ المسفاةِ عن غولِ العُلا","عن روضةِ العيشي وباقي الأمكنة",53,"ن",2,0],["عَن جيرةٍ نزلُوا بطحاء كاظمة","حسا وَمعنى سَواد الْقلب وَالنَّظَر",54,"ر",1,0],["عن جاكرٍ ورثوا كل العُلا سلفا","والمجدَ من تنْدغٍ أنعم به شانا",55,"ن",2,0],["عن جدّهِ عادَ الصّواعُ كجبّةٍ","في ظهرِ باعورا كصدرِ المقتبلْ",56,"ل",1,0],["عَنْ جَنَّةٍ للهوى تغْوي نَوَاظِرها ‏","ربيعُها دائمٌ لمْ يخشَ ‏من هَرَمِ‎",57,"م",1,0],["عن جنة تؤويه في أفيائها","عن عالم للحلم فوق رؤاه",58,"ا",2,0],["عن جملة الناس قلبي مختلف نبضه","وعن باقي الغيد كن العين مخطوفه",59,"ف",2,1]]}