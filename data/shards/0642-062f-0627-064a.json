{"poems":[[94,"يا ليل ما تصنع النفس التي سكنت","https://www.aldiwan.net/poem38942.html","الكامل"],[47,"أنافعي عند ليلى فرط حبيها","https://www.aldiwan.net/poem66850.html","البسيط"],[68,"قد أيقظ الصبح ذوات الجناح","https://www.aldiwan.net/poem39082.html","السريع"],[77,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62237","البسيط"],[146,"لو كنت أشفق من خضيب بنان","https://www.aldiwan.net/poem58451.html","الكامل"],[240,"خليفة الله الذي وعوده لا تخلف","https://www.aldiwan.net/poem31820.html","مجزوء الرجز"],[280,"أشدو بها وسط الندي الحاشد","https://www.aldiwan.net/poem25593.html","الرجز"],[396,"يا طبيب القلوب قلبي عليل","https://www.aldiwan.net/poem54534.html","عموديه"],[435,"بشراك يا مجد العلى بشراكا","https://www.aldiwan.net/poem41438.html","الكامل"],[519,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[520,"تقبل الله صوماً أنت واصله","https://www.aldiwan.net/poem12203.html","البسيط"],[534,"أريد إجمام ذهني عن مباحثة","https://www.aldiwan.net/poem37317.html","البسيط"],[567,"أسألت بان الجزع وهو يصفق","https://www.aldiwan.net/poem52880.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138342",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138352",""],[953,"","https://poetry.dctabudhabi.ae/diwan/poem/133934","البسيط"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80211","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56225","البسيط"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35785","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93681","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65988","الرجز"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100485","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202404","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133977","البسيط"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71311","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67996","الكامل"],[3418,"","https://poetry.dctabudhabi.ae/diwan/poem/111129","السريع"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109954","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128881","المجتث"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77144","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44711","البسيط"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75690","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94393","الكامل"],[4289,"","https://poetry.dctabudhabi.ae/diwan/poem/199287","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76753","الطويل"],[5273,"صهيل القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=162118",""],[5273,"حمى","https://www.poetsgate.com/ViewPoem.aspx?id=191955",""],[5277,"شظايا الذاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=185998",""],[5277,"جنّاتُ عاطفتي","https://www.poetsgate.com/ViewPoem.aspx?id=192112",""],[5559,"بيننا شغاف الروح ( محمود أسد )","https://www.poetsgate.com/ViewPoem.aspx?id=60738",""],[5640,"شامية","https://www.poetsgate.com/ViewPoem.aspx?id=206110",""],[5895,"قد أتت سلوى","https://www.poetsgate.com/ViewPoem.aspx?id=214162",""],[6300,"نقش قديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82860&r=&rc=31",""],[5126,"الطائف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87785&r=&rc=0",""]],"verses":[["قَدْ أيقنوا أنَّهُ لا شيءَ يُنقِذُهُمْ","فاستسلموا لِسُكونِ الرُّعْبِ وانتظروا",0,"ر",3,0],["قَد أَيقَنَت أَنَّني لَم أُرضِ كاشِحَها","فيها وَلَم أَستَمِع مِن قَولِ واشيها",1,"ي",3,0],["قَد أَيقَظَ الصُبحُ ذَواتِ الجَناح","وَعَطَّرَ الزَهرُ جُيوبَ الرِياحِ",2,"ح",1,1],["قد أُيّدوا بالقُدْسِ إلاّ أنّهُمْ","قد أُونِسوا بالرَّوحِ والرَّيحانِ",3,"ن",1,0],["قَدْ أَيْقَنُوا أَنَّ مَالَ المَرْءِ يَتْبَعُهُ","حَقٌّ عَلَى صَالِحِ الأَقْوَامِ مَعْلُومُ",4,"م",1,0],["قد أيقنتْ قِممُ الملوك بأنه","إن شاء طلَّقها من التيجانِ",5,"ن",1,0],["قَد أَينَعَت أَثمارُهُ","وَعَن قَليلٍ تُقطَفُ",6,"ف",1,0],["قد أُيِّدوا فَما لَهم من كائِد","وأُوجِدوا لِعَدمِ الشّدائِد",7,"د",1,0],["قد أيست من الخلائق طرا","وأنبا تحتكم طريح ذليل",8,"ل",1,0],["قد ايد العدل اعتدال مزاجكم","يا ماجدا أحيى الوجود فداكا",9,"ك",2,0],["قد أيّدَتْ دولةَ المُرّانِ قامتُها","وحكّمَتْها على سُلطانِها القُضُبُ",10,"ب",1,0],["قد أيد الله ديناً أنت عاضده","والناصر الذخر كافيه وكافله",11,"ل",2,0],["قَدْ أَيْنَعَتْ ثَمَراتٌ للعُقُولِ بِهِ","فَهَلْ لَدَيْكَ جَمالَ الدِّينِ إسْعافُ",12,"ف",1,0],["قد أيْمَنَ الصَبرُ الذي أعدَدتُهُ","للنَّائِباتِ ورَكْبُ شَوقي مُعْرِقُ",13,"ق",1,0],["قد أيقنوا أن الشفا بيد الذي","للطب قد أضحى أبا وشقيقا",14,"ق",2,0],["قد ايدوك بنفسهم ونفيسهم","مما تعدى العقل والمعقولا",15,"ل",2,0],["قد أيد الله أقواما بنصرتهم","للشرع فالخير فيهم أينما ساروا",16,"ر",3,0],["قَد أَيقَظَ الحُبُّ الموسد بِالحَشى","مَع أَنَّهُ ما نامَ مُنذُ سَراكا",17,"ك",2,0],["قد أيد الشرع ثمَّ القاضيين به","والحق والمقتدي فيه وقايلهُ",18,"ل",2,0],["قَد أَيقَنوا بِذَهابِها وَهَلاكِهم","وَالدَهرُ يوعِدُهُم بِيَومٍ أَعضَلِ",19,"ل",1,0],["قَد أَيقظته يَد التجارب فَهوَ لا","يَدع العُيون بِنومها تَتَمهل",20,"ل",1,0],["قد أينعت جماجم لم تجزم","وحان وقت طرحها في الأكم",21,"م",1,0],["قد أيتم العلماء إذ أودى كما","قد أويتمت من بعده الفقراء",22,"ا",2,0],["قد ائتلفا شعرٌ قديم وحادثٌ","لأنهما كانا أليفين في فكري",23,"ر",2,0],["قد اينعت مخصبات من مغارسه","للبر بالخلق منها دام تجديد",24,"د",1,0],["قَدْ أَيَّسَ الصَّبْرَ وَالسِّلْوَانَ أَيْسَرُهُ","وَعَاقَبَ الصِّبَّ عَنْ آمَالِهِ الوَصَبُ",25,"ب",1,0],["قَدْ أُيِّد الإسلامُ منك بسلطةٍ","فَلأَنت يَا مولاي من نصرائه",26,"ا",3,0],["قد أيقنوا منه بجزل الخطى","إن علياً ليس بالراضخ",27,"خ",1,0],["قد أَيَّدوا دِينَ المَجُوسِ بجعلِ تلكَ","النارِ نورَ الحقِّ وَهيَ أُوارُ",28,"ر",1,0],["قد أيمتها الليالي","وعزها سلبته",29,"ه",1,0],["قَد أَيقَنَ الأَقوامِ أَن مُحلكم","رَوضٌ وَأَنَّكَ زَهرُ أُنسِ المَجلِسِ",30,"س",1,0],["قَد أَينَعَت في فَنا الصَديق وَمَن","أَضحى بِكُلِّ جَميلِ الودِّ يُوليني",31,"ن",2,0],["قَد أَيقظ الطل وَهناً ناعس الزهر","وَطاف يَسعى بكاسات عَلى الشجر",32,"ر",1,1],["قد أَينعت شاهي الثمار لمنظر","طابَت عثاكيلٌ بها وَفنودُ",33,"د",1,0],["قد أيّد الرحمنُ ملَّةَ أحمد","بالناصريْن محمدٍ ومحمدِ",34,"د",1,1],["قد ائتلفت أهواؤها بك جملة","كما ائتلفت في وكرهن حمامُ",35,"م",1,0],["قَدْ أيْنَعَ البَوْحُ في صَدري وحَنْجَرَتي","والدّمعُ يَذْرِفُني والشِّعْرُ طابَ جَنَى",36,"ن",2,0],["قد أيقظتني بالأنين مفاصلي","دندنتُ بالآهات شبه أغان",37,"ن",1,0],["قد أينعتْ واستوتْ أثماره ودنتْ","حتى تدلّى به الرمانُ والعنبُ",38,"ب",1,0],["قد أينعتْ جنّاتُ عاطفتي","واشتاقكِ النيروزُ والزهْرُ",39,"ر",1,0],["قد أيقَظَتْ جمرَ البيانِ وطهرَهُ","يا قدسُ عفواً ، فالضمائِرُ ضُمَّرُ",40,"ر",1,0],["قدْ أيْنعَتْ في الحُبِّ كلّ ثِمارهِ","قدْ تَشْتَهي السُكنى هُنا لا تَرْحَلُ",41,"ل",1,0],["قَدْ أَيْنَعَتْ نَفْساً بِهَا عَلِقَتْ","نَبْضُ اليَرَاعِ لِمِثلِهَا يَقْوَى",42,"و",2,0],["قد أيْنَعَتْ ثمرات الحُبِّ مُذ ْزَمَن","فهلْ يدٌ في حِمَاها تقطِفُ الأمَلا",43,"ل",2,0],["قد أينعت في فيئه أثماره","وتحققت للمجتني أماله",44,"ل",2,0]]}