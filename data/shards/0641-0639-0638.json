{"poems":[[48,"عجبت لورقاء الجناحين شأنها","https://www.aldiwan.net/poem22529.html","الطويل"],[199,"فعظام فالبرقات جاد عليهما","https://www.aldiwan.net/poem54354.html","الكامل"],[214,"كفاني حزنا أن أضر بي الهجر","https://www.aldiwan.net/poem13494.html","الطويل"],[266,"متى يستفيق الدهر من غفلانه","https://www.aldiwan.net/poem38140.html","الطويل"],[396,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[458,"اضحكوا ثم اضحكوا يا هازلين","https://www.aldiwan.net/poem61608.html","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93922","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93790","الخفيف"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110825","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74055","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74035","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97065","المتقارب"],[4726,"مآل كل امرءٍ للموت والعطب","https://www.poetsgate.com/ViewPoem.aspx?id=146654",""],[5582,"تَعَمَّدَنِي الخَطْبُ غَمْزاً وَقَرْعَا","https://www.poetsgate.com/ViewPoem.aspx?id=187179",""],[5582,"لِمَنْ بِطُلُولِ الأَبْرَقَيْنِ مُقامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187300",""],[199,"يا منْ رأى برقاً أرقتُ لضوئهِ","https://www.poetsgate.com/ViewPoem.aspx?id=22447",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""]],"verses":[["فَعَظِّم أَخا النَسكِ التَقِيَّ لِدينِهِ","وَنَفسَكَ فَاِحقَر نافِعٌ لَكَ حَقرُها",0,"ر",3,0],["فَعِظامِ فَالبُرقاتِ جادَ عَلَيهِما","وَأَبَثَّ أَبطُنَهُ الثَبورَ بِهِ النَوى",1,"ن",3,1],["فعظم فيه الله ربي اجوركم","والهمكم صبرا به يعظم الاجر",2,"ر",1,0],["فعظم اغتباط المرء في جمع شمله","يكون على مقدار عظم شتاته",3,"ت",2,0],["فعظموها بفعل الخير مما ارتضاه","وعطروها بكل رائحه مشتهاه",4,"ا",2,0],["فعظاتُ الدهرِ في أحكامها","لم تُخادِع أو تُخادَع بالطنين",5,"ن",1,0],["فعظموا الرب فيها بالصلاة له","ومجدوه بتسبيح وتقديس",6,"س",1,0],["فعظ النفس وادكر وتدبر","ذهب العمر بين ناس وساهي",7,"ا",3,0],["فعظمى يحيى الفتى فإنما","يحيى جواد حيث حل برمكي",8,"ي",1,0],["فَعظات الأَيّام أوضح من أَن","يَتَغاضى عَن هَديها العارِفونا",9,"ن",2,0],["فَعَظيمهم يومَ الجلاد محقّر","وَكبيرهم يَومَ الطراد صَغيرُ",10,"ر",1,0],["فعظم إذا شمت رسل الإله","صفوفاً تعظم ذاك الجنابا",11,"ب",2,0],["فعظم الله أجر المسلمين به","ومن بالصبر والتوفيق والقرب",12,"ب",1,0],["[ فَعَظَّمْتُهُ وَرَفَعْتُ بِهِ فَوْ","قَ رأْسِي وَوَجْهِي وَثَغْرِيَ ( رَفْعا ) ]",13,"ع",2,0],["فَعَظِّمْهُ تَعْظِيماً يَجِلُّ فَإِنَّهُ","هُمامٌ إِلَى العَلْيا نَماهُ هُمامُ",14,"م",1,0],["فعظامُ البرقاتُ جادَ عليهما","وأَبَثَّ أبْطُنَهُ الثُّبُورُ بِهِ النَّوَى",15,"ا",1,0],["فعظِّمَنِّ الحروف بقدر وسعكا","وارسمها على الجميع علويّاً وسُفلا",16,"ل",2,0]]}