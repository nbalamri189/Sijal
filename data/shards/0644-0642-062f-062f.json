{"poems":[[86,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[27,"أنا ابن أبي سعد وعمرو ومالك","https://www.aldiwan.net/poem5727.html","الطويل"],[51,"تعجل مولود ليمهل والد","https://www.aldiwan.net/poem61960.html","الطويل"],[91,"دار السلام وأرض الهنا","https://www.aldiwan.net/poem62784.html","عموديه"],[70,"عليك سلام الله يا قبر عثمان","https://www.aldiwan.net/poem42450.html","الخفيف"],[85,"هذا ما در","https://www.aldiwan.net/poem6952.html","الرجز"],[62,"لقد هاجني والصبح طلق المباسم","https://www.aldiwan.net/poem52267.html","الطويل"],[28,"لأدنو من أرض لأرضك إن دنت","https://www.aldiwan.net/poem5546.html","الطويل"],[49,"خليلي إن الهم قد يتفرج","https://www.aldiwan.net/poem62024.html","الطويل"],[49,"كأنك قد جاورت أهل المقابر","https://www.aldiwan.net/poem62081.html","الطويل"],[80,"مرابعهم للوحش أضحت مراتعا","https://www.aldiwan.net/poem31383.html","الطويل"],[80,"إذا البدر يطوى في ربوع البلى لحدا","https://www.aldiwan.net/poem31479.html","الطويل"],[44,"نثرت فريد مدامع لم ينظم","https://www.aldiwan.net/poem30353.html","الكامل"],[31,"لقد دب الهوى لك في فؤادي","https://www.aldiwan.net/poem42034.html","الوافر"],[105,"ردوا بني قينقاع الأمر إذ نزلا","https://www.aldiwan.net/poem44215.html","البسيط"],[75,"بأكثبة الدهناء منهم منازل","https://www.aldiwan.net/poem69024.html","الطويل"],[48,"عزوا أخلاي قلبي فقد أصبت بلبي","https://www.aldiwan.net/poem10817.html","المجتث"],[46,"لقد دجى الزمان فلا تدجوا","https://www.aldiwan.net/poem22246.html","الوافر"],[46,"غدت هذي الحوافل راتعات","https://www.aldiwan.net/poem23239.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85527","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39578","المتقارب"],[106,"إلى القائد المظفر","https://www.poetsgate.com/ViewPoem.aspx?id=179595",""],[106,"سُحقًا لها","https://www.poetsgate.com/ViewPoem.aspx?id=179644",""],[91,"فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=1208",""],[132,"أثارت دموعا كنت لن تستبيتها","https://www.aldiwan.net/poem54653.html","الطويل"],[143,"لقد دفعنا إلى حالين لست أرى","https://www.aldiwan.net/poem11766.html","البسيط"],[150,"أصبت من الحساد أنفذ مقتل","https://www.aldiwan.net/poem68600.html","الطويل"],[182,"زر مضجعا لابن عكاوي الكريم وقل","https://www.aldiwan.net/poem61078.html","البسيط"],[185,"إذا كان عقبى ما يسوء التصبر","https://www.aldiwan.net/poem14545.html","الطويل"],[185,"هلال يحاكي نصف حلقة عاج","https://www.aldiwan.net/poem14769.html","الطويل"],[186,"في كل منقلب غيظ أساء به","https://www.aldiwan.net/poem43798.html","البسيط"],[249,"لقد دافعت علقمة بن عمرو","https://www.aldiwan.net/poem2090.html","الوافر"],[259,"دعوت وجودي حيث ما ثم داعيا","https://www.aldiwan.net/poem35965.html","الطويل"],[280,"جرى لك بالتوفيق أيمن طائر","https://www.aldiwan.net/poem60716.html","الطويل"],[280,"لنا كل يوم هناء جديد","https://www.aldiwan.net/poem60772.html","المتقارب"],[410,"أرى القلب أمسى بالأوانس مولعا","https://www.aldiwan.net/poem67492.html","الطويل"],[416,"بدا والصبح غار على الظلام","https://www.aldiwan.net/poem54132.html","الوافر"],[464,"كذا فليد من نازع الخضر الندى","https://www.aldiwan.net/poem3221.html","عموديه"],[538,"يا لذة الحلم في إغفاءة الوسن","https://www.aldiwan.net/poem47600.html","عموديه"],[551,"يا حامل الكأس ناولني مشعشعة","https://www.aldiwan.net/poem47138.html","البسيط"],[567,"يا قاتل الله كتاب الدواوين","https://www.aldiwan.net/poem69488.html","البسيط"],[570,"جزاني الزهد مان جزاء سوء","https://www.aldiwan.net/poem59462.html","الوافر"]],"verses":[["لَقَد دَهَتهُ المَنايا","مِن غارَةِ الخائِنينا",0,"ن",2,0],["لَقَد داهَنَت في رَهنِ عَوفِن مَجاشِعٌ","وَبانَ اِبنُ عَوّامٍ لَكُم غَيرَ حامِدِ",1,"د",1,0],["لقد دافع المفقودُ عنك بنفسه","عُراماً فلا يُحْزنْكَ أنك فاقدُ",2,"د",1,0],["لَقَد دافَعوا أَمسِ دونَ الحِمى","فَكانَت حُروبُهُمُ هَربَنا",3,"ن",2,0],["لَقَد دَفَنَ الأَقوامُ يَومَ وَفاتِهِ","بَقِيَّةَ مَعروفٍ وَخَيرٍ وَإِحسانِ",4,"ن",1,0],["لقد دعاني للغذاء مرة","فقسم البيضة بين أربعة",5,"ه",1,0],["لقد دَمِيَتْ غيظاً على الدهرِ أنْمُلِي","وهل ينفعُ المكروبَ عضُّ الأباهمِ",6,"م",1,0],["لَقَد دَلَّهَتني عَن صَلاتي وَإِنَّهُ","لَيَدعو إِلى الخَيرِ الكَثيرِ إِمامُها",7,"م",3,0],["لَقَد دَرَجَت مِنّا قُرونٌ كَثيرَةٌ","وَنَحنُ سَنَمضي بَعدَهُنَّ وَنَدرُجُ",8,"ج",1,0],["لَقَد دَبَّرَ الدُنيا حَكيمٌ مُدَبِّرٌ","لَطيفٌ خَبيرٌ عالِمٌ بِالسَرائِرِ",9,"ر",1,0],["لقد دخلتْ بي منك في الحزنِ لوعةٌ","حُرِمْتُ بها من ذِمّةِ الصبر راجعا",10,"ع",2,0],["لَقَد دَفَعَتْ أَيدِيكُمُ مِنهُ لِلبِلى","يَداً بِجَديدِ العُرْفِ كانَت لَكُم تَندى",11,"د",2,0],["لَقُدِدتَ مِن شِيَمٍ كَأَنَّ سُيورَها","يُقدَدنَ مِن شِيَمِ السَحابِ المُرزِمِ",12,"م",1,0],["لَقَد دَبَّ الهَوى لَكِ في فُؤادي","دَبيبَ دَمِ الحَياةِ إِلى العُروقِ",13,"ق",1,1],["لقد دعاكم إلى الحسنى فمال بكم","من طائفِ الجهلِ داعٍ يُورثُ الخَبَلا",14,"ل",2,0],["لقد دام من والاك في ظل غبطة","وأمُّ الذي يشقى بسُخطك هابل",15,"ل",1,0],["لَقَد دَعاني وَصَحبي","فَجِئتُ مِن بَينِ صَحبي",16,"ي",1,0],["لَقَد دَجّى الزَمانُ فَلا تَدَجّوا","وَلَجَّ فَلَم يَدَع خَصماً يَلَجُّ",17,"ج",1,1],["لَقَد دَرِنَت بِيَ الدُنِّيا زَماناً","وَسَوفَ يُجيدُ عَنها المَوتُ غَسلي",18,"ي",1,0],["لقد دفنوا الشعر الجميل بحفرة","وَللشعر حسن لا يغيره الدفن",19,"ن",1,0],["لقد دنَّسَ الجسَدُ الآدميُّ","حياةً حَرَصْتَ على طُهْرِها",20,"ر",3,0],["لقد دَعوْتَ، فما ضاعَ الدعاءُ سدًى","لكنه اخترَقَ الأستارَ والحُجُبَا",21,"ب",2,0],["لقد دنَّسْتُمُو مصرًا","بحكمكُمو بل الشَّرْقا",22,"ق",2,0],["لقد دافعوا أمسِ دونَ الحمى","فكانتْ حروبهمُ حربنا",23,"ن",2,0],["لقد دست السعودَ ولا صعودَا","يفوق صعودَ مَن داس السعودا",24,"د",2,0],["لَقَد دُفِعنا إِلى حالَينِ لَستُ أَرى","ما بَينَ ذاكَ وَهَذا حَظَّ مُختارِ",25,"ر",1,1],["لَقَد دَلَّ إِسراءُ الإِلَهِ بِعَبدِهِ","عَلى أَنَّهُ قَد خُصَّ مِنهُ بِوُدِّهِ",26,"ه",1,0],["لَقَد دَعاهُ إَلَيهِ رَبُّهُ فَمَضى","فَوراً وَأَبقى لَنا الأَحزانَ وَالكَدَرا",27,"ر",2,0],["لقد دانتِ الدنيا لعادٍ وتُبَّعٍ","ودَبَّر فيها الملكَ كِسْرى وقَيْصَرُ",28,"ر",1,0],["لقد دقَّ حتى أوهم العينَ أنها","تُراقبُ عَوْجَي شيبةٍ وحِجاج",29,"ج",1,0],["لقد دفعت إلى قوم إذا انتسبوا","فلا ربيعة تؤويهم ولا مضر",30,"ر",1,0],["لقد دفعت إلى أمر تحمّله","هدم الحياة وفي أشيائه أشر",30,"ر",1,0],["لَقَد دافَعتُ عَلقَمَةَ بنَ عَمرٍو","تُجاهَ البابِ مُجتَمَعَ الخُصومِ",31,"م",1,1],["لَقَد دَكَّ دَهري طَودَ صَبري فَأَصبَحت","مَنازِلُ قَصري بِالخُطوبِ خَوالِيا",32,"ي",2,0],["لَقَدْ دَلَّ تَشْرِيفُ الْخَلِيفَةِ أَنَّهُ","بِخَيْرِ بَنِي أَيّامِهِ خَيْرُ خابِرِ",33,"ر",1,0],["لَقَدْ دَفَعَ اللهُ لِلْمَجْدِ عَنْكَ","وأَعْطِيَ فِيكَ النَّدَى ما يُريدُ",34,"د",1,0],["لَقَد دَوَّخَ الأَعداءُ مَعنٌ فَأَصبَحوا","وَأَمنَعُهُم لا يَدفَعُ الذُلَّ مَدفَعا",35,"ع",2,0],["لقد دَرَّتْ سحائبه إلى أنْ","زهَتْ فيهنّ أزهار الكلام",36,"م",1,0],["لقد دافعا عن دولة المجد والهوى","عدواً حسيراً أو عدواً مضللا",37,"ل",2,0],["لَقد دَعَونِي لأَمرٍ كنت أحسَبهُ","يَأتي على غَيرِ مَأتَى المَيتِ في الكَفَنِ",38,"ن",1,0],["لقد دَعَتْ سامعاً لم تَكْدَ دعوتُهُ","وطالبتْ بعظيمٍ مَنْ يُؤاتيها",39,"ي",3,0],["لَقَدْ دَهَانِي لَطِيْفٌ مِنْهُمُ خَتِلٌ","فِي ذَاتِ حَدٍّ كَحَدِّ السَّيْفِ مَسْنُونِ",40,"ن",1,0],["لقد دافعت وقد علمت معدٌ","بني قُرظٍ وعمهم قدامة",41,"م",2,0]]}