{"poems":[[88,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[29,"أنا ابن أبي سعد وعمرو ومالك","https://www.aldiwan.net/poem5727.html","الطويل"],[53,"تعجل مولود ليمهل والد","https://www.aldiwan.net/poem61960.html","الطويل"],[93,"دار السلام وأرض الهنا","https://www.aldiwan.net/poem62784.html","عموديه"],[72,"عليك سلام الله يا قبر عثمان","https://www.aldiwan.net/poem42450.html","الخفيف"],[87,"هذا ما در","https://www.aldiwan.net/poem6952.html","الرجز"],[64,"لقد هاجني والصبح طلق المباسم","https://www.aldiwan.net/poem52267.html","الطويل"],[30,"لأدنو من أرض لأرضك إن دنت","https://www.aldiwan.net/poem5546.html","الطويل"],[51,"خليلي إن الهم قد يتفرج","https://www.aldiwan.net/poem62024.html","الطويل"],[51,"كأنك قد جاورت أهل المقابر","https://www.aldiwan.net/poem62081.html","الطويل"],[82,"مرابعهم للوحش أضحت مراتعا","https://www.aldiwan.net/poem31383.html","الطويل"],[82,"إذا البدر يطوى في ربوع البلى لحدا","https://www.aldiwan.net/poem31479.html","الطويل"],[46,"نثرت فريد مدامع لم ينظم","https://www.aldiwan.net/poem30353.html","الكامل"],[33,"لقد دب الهوى لك في فؤادي","https://www.aldiwan.net/poem42034.html","الوافر"],[107,"ردوا بني قينقاع الأمر إذ نزلا","https://www.aldiwan.net/poem44215.html","البسيط"],[77,"بأكثبة الدهناء منهم منازل","https://www.aldiwan.net/poem69024.html","الطويل"],[50,"عزوا أخلاي قلبي فقد أصبت بلبي","https://www.aldiwan.net/poem10817.html","المجتث"],[48,"لقد دجى الزمان فلا تدجوا","https://www.aldiwan.net/poem22246.html","الوافر"],[48,"غدت هذي الحوافل راتعات","https://www.aldiwan.net/poem23239.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85527","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39578","المتقارب"],[108,"إلى القائد المظفر","https://www.poetsgate.com/ViewPoem.aspx?id=179595",""],[108,"سُحقًا لها","https://www.poetsgate.com/ViewPoem.aspx?id=179644",""],[111,"بصائرنا في القضا خامدة","https://www.poetsgate.com/ViewPoem.aspx?id=522",""],[93,"فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=1208",""],[136,"أثارت دموعا كنت لن تستبيتها","https://www.aldiwan.net/poem54653.html","الطويل"],[147,"لقد دفعنا إلى حالين لست أرى","https://www.aldiwan.net/poem11766.html","البسيط"],[154,"أصبت من الحساد أنفذ مقتل","https://www.aldiwan.net/poem68600.html","الطويل"],[186,"زر مضجعا لابن عكاوي الكريم وقل","https://www.aldiwan.net/poem61078.html","البسيط"],[189,"إذا كان عقبى ما يسوء التصبر","https://www.aldiwan.net/poem14545.html","الطويل"],[189,"هلال يحاكي نصف حلقة عاج","https://www.aldiwan.net/poem14769.html","الطويل"],[190,"في كل منقلب غيظ أساء به","https://www.aldiwan.net/poem43798.html","البسيط"],[254,"لقد دافعت علقمة بن عمرو","https://www.aldiwan.net/poem2090.html","الوافر"],[264,"دعوت وجودي حيث ما ثم داعيا","https://www.aldiwan.net/poem35965.html","الطويل"],[285,"جرى لك بالتوفيق أيمن طائر","https://www.aldiwan.net/poem60716.html","الطويل"],[285,"لنا كل يوم هناء جديد","https://www.aldiwan.net/poem60772.html","المتقارب"],[416,"أرى القلب أمسى بالأوانس مولعا","https://www.aldiwan.net/poem67492.html","الطويل"],[422,"بدا والصبح غار على الظلام","https://www.aldiwan.net/poem54132.html","الوافر"],[469,"كذا فليد من نازع الخضر الندى","https://www.aldiwan.net/poem3221.html","عموديه"],[543,"يا لذة الحلم في إغفاءة الوسن","https://www.aldiwan.net/poem47600.html","عموديه"],[556,"يا حامل الكأس ناولني مشعشعة","https://www.aldiwan.net/poem47138.html","البسيط"],[572,"يا قاتل الله كتاب الدواوين","https://www.aldiwan.net/poem69488.html","البسيط"],[575,"جزاني الزهد مان جزاء سوء","https://www.aldiwan.net/poem59462.html","الوافر"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83319","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37722","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38768","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38571","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37944","المجتث"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[1106,"","https://poetry.dctabudhabi.ae/diwan/poem/104200","السريع"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112961","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64641","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49955","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80003","المتقارب"],[2044,"","https://poetry.dctabudhabi.ae/diwan/poem/105720","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27569","الوافر"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109522","الوافر"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110647","الوافر"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67236","الوافر"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106896","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121184","السريع"],[2423,"","https://poetry.dctabudhabi.ae/diwan/poem/132499","الوافر"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205785","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100415","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205030","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203001","الوافر"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133969","الطويل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112610","الطويل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107070","الخفيف"],[3102,"","https://poetry.dctabudhabi.ae/diwan/poem/113898","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100742","الوافر"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110835","الوافر"],[3243,"","https://poetry.dctabudhabi.ae/diwan/poem/140230",""],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112636","الرجز"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203538","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74054","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62788","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129448","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66512","الرجز"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128941","الرجز"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86510","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127209","الرجز"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102756","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94801","الطويل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105497","الطويل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104933","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139729",""],[4755,"لَقد دَخَلْتُ مِرارًا بعدما خَرَجُوا","https://www.poetsgate.com/ViewPoem.aspx?id=201117",""],[4767,"تكريم","https://www.poetsgate.com/ViewPoem.aspx?id=88860",""],[4778,"ثكالى في الفرات لها عويل","https://www.poetsgate.com/ViewPoem.aspx?id=188141",""],[1012,"لقد دارت على رغم الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=124956",""],[4578,"في ليلة النصف من شعبان قد عادا","https://www.poetsgate.com/ViewPoem.aspx?id=49402",""],[4878,"مصابك فيه ركن الدين هدا","https://www.poetsgate.com/ViewPoem.aspx?id=170951",""],[4943,"القطرة الغيثية والوسيلة الالهية","https://www.poetsgate.com/ViewPoem.aspx?id=125974",""],[5213,"أصاتت باسمك الناعون جهرا","https://www.poetsgate.com/ViewPoem.aspx?id=170488",""],[5376,"أناختْ على هجرِ المطايا نجائبي........يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=188567",""],[5409,"أبى الوضع عن جوره أن يكف","https://www.poetsgate.com/ViewPoem.aspx?id=155292",""],[5431,"كأن قبلته للثغر إمضاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=185586",""],[3294,"ليل يجيء ونهار يذهب","https://www.poetsgate.com/ViewPoem.aspx?id=173257",""],[5436,"قصيدة أسدلوا الستار","https://www.poetsgate.com/ViewPoem.aspx?id=36243",""],[5533,"دَارَ الزَّمانِ على بِلادِي","https://www.poetsgate.com/ViewPoem.aspx?id=176319",""],[5953,"تشخص للأنام فتشبهوه","https://www.poetsgate.com/ViewPoem.aspx?id=93843",""],[5956,"إذا ذُكِرَ اْسمُها","https://www.poetsgate.com/ViewPoem.aspx?id=181945",""]],"verses":[["لَقَد دَهَتهُ المَنايا","مِن غارَةِ الخائِنينا",0,"ن",2,0],["لَقَد داهَنَت في رَهنِ عَوفِن مَجاشِعٌ","وَبانَ اِبنُ عَوّامٍ لَكُم غَيرَ حامِدِ",1,"د",1,0],["لقد دافع المفقودُ عنك بنفسه","عُراماً فلا يُحْزنْكَ أنك فاقدُ",2,"د",1,0],["لَقَد دافَعوا أَمسِ دونَ الحِمى","فَكانَت حُروبُهُمُ هَربَنا",3,"ن",2,0],["لَقَد دَفَنَ الأَقوامُ يَومَ وَفاتِهِ","بَقِيَّةَ مَعروفٍ وَخَيرٍ وَإِحسانِ",4,"ن",1,0],["لقد دعاني للغذاء مرة","فقسم البيضة بين أربعة",5,"ه",1,0],["لقد دَمِيَتْ غيظاً على الدهرِ أنْمُلِي","وهل ينفعُ المكروبَ عضُّ الأباهمِ",6,"م",1,0],["لَقَد دَلَّهَتني عَن صَلاتي وَإِنَّهُ","لَيَدعو إِلى الخَيرِ الكَثيرِ إِمامُها",7,"م",3,0],["لَقَد دَرَجَت مِنّا قُرونٌ كَثيرَةٌ","وَنَحنُ سَنَمضي بَعدَهُنَّ وَنَدرُجُ",8,"ج",1,0],["لَقَد دَبَّرَ الدُنيا حَكيمٌ مُدَبِّرٌ","لَطيفٌ خَبيرٌ عالِمٌ بِالسَرائِرِ",9,"ر",1,0],["لقد دخلتْ بي منك في الحزنِ لوعةٌ","حُرِمْتُ بها من ذِمّةِ الصبر راجعا",10,"ع",2,0],["لَقَد دَفَعَتْ أَيدِيكُمُ مِنهُ لِلبِلى","يَداً بِجَديدِ العُرْفِ كانَت لَكُم تَندى",11,"د",2,0],["لَقُدِدتَ مِن شِيَمٍ كَأَنَّ سُيورَها","يُقدَدنَ مِن شِيَمِ السَحابِ المُرزِمِ",12,"م",1,0],["لَقَد دَبَّ الهَوى لَكِ في فُؤادي","دَبيبَ دَمِ الحَياةِ إِلى العُروقِ",13,"ق",1,1],["لقد دعاكم إلى الحسنى فمال بكم","من طائفِ الجهلِ داعٍ يُورثُ الخَبَلا",14,"ل",2,0],["لقد دام من والاك في ظل غبطة","وأمُّ الذي يشقى بسُخطك هابل",15,"ل",1,0],["لَقَد دَعاني وَصَحبي","فَجِئتُ مِن بَينِ صَحبي",16,"ب",2,0],["لَقَد دَجّى الزَمانُ فَلا تَدَجّوا","وَلَجَّ فَلَم يَدَع خَصماً يَلَجُّ",17,"ج",1,1],["لَقَد دَرِنَت بِيَ الدُنِّيا زَماناً","وَسَوفَ يُجيدُ عَنها المَوتُ غَسلي",18,"ل",2,0],["لقد دفنوا الشعر الجميل بحفرة","وَللشعر حسن لا يغيره الدفن",19,"ن",1,0],["لقد دنَّسَ الجسَدُ الآدميُّ","حياةً حَرَصْتَ على طُهْرِها",20,"ر",3,0],["لقد دَعوْتَ، فما ضاعَ الدعاءُ سدًى","لكنه اخترَقَ الأستارَ والحُجُبَا",21,"ب",2,0],["لقد دنَّسْتُمُو مصرًا","بحكمكُمو بل الشَّرْقا",22,"ق",2,0],["لقد دهش الكون لما ثوى","فما وجدت رشدها الراشده",23,"د",2,0],["لقد دافعوا أمسِ دونَ الحمى","فكانتْ حروبهمُ حربنا",24,"ن",2,0],["لقد دست السعودَ ولا صعودَا","يفوق صعودَ مَن داس السعودا",25,"د",2,0],["لَقَد دُفِعنا إِلى حالَينِ لَستُ أَرى","ما بَينَ ذاكَ وَهَذا حَظَّ مُختارِ",26,"ر",1,1],["لَقَد دَلَّ إِسراءُ الإِلَهِ بِعَبدِهِ","عَلى أَنَّهُ قَد خُصَّ مِنهُ بِوُدِّهِ",27,"ه",1,0],["لَقَد دَعاهُ إَلَيهِ رَبُّهُ فَمَضى","فَوراً وَأَبقى لَنا الأَحزانَ وَالكَدَرا",28,"ر",2,0],["لقد دانتِ الدنيا لعادٍ وتُبَّعٍ","ودَبَّر فيها الملكَ كِسْرى وقَيْصَرُ",29,"ر",1,0],["لقد دقَّ حتى أوهم العينَ أنها","تُراقبُ عَوْجَي شيبةٍ وحِجاج",30,"ج",1,0],["لقد دفعت إلى قوم إذا انتسبوا","فلا ربيعة تؤويهم ولا مضر",31,"ر",1,0],["لقد دفعت إلى أمر تحمّله","هدم الحياة وفي أشيائه أشر",31,"ر",1,0],["لَقَد دافَعتُ عَلقَمَةَ بنَ عَمرٍو","تُجاهَ البابِ مُجتَمَعَ الخُصومِ",32,"م",1,1],["لَقَد دَكَّ دَهري طَودَ صَبري فَأَصبَحت","مَنازِلُ قَصري بِالخُطوبِ خَوالِيا",33,"ي",2,0],["لَقَدْ دَلَّ تَشْرِيفُ الْخَلِيفَةِ أَنَّهُ","بِخَيْرِ بَنِي أَيّامِهِ خَيْرُ خابِرِ",34,"ر",1,0],["لَقَدْ دَفَعَ اللهُ لِلْمَجْدِ عَنْكَ","وأَعْطِيَ فِيكَ النَّدَى ما يُريدُ",35,"د",1,0],["لَقَد دَوَّخَ الأَعداءُ مَعنٌ فَأَصبَحوا","وَأَمنَعُهُم لا يَدفَعُ الذُلَّ مَدفَعا",36,"ع",2,0],["لقد دَرَّتْ سحائبه إلى أنْ","زهَتْ فيهنّ أزهار الكلام",37,"م",1,0],["لقد دافعا عن دولة المجد والهوى","عدواً حسيراً أو عدواً مضللا",38,"ل",2,0],["لَقد دَعَونِي لأَمرٍ كنت أحسَبهُ","يَأتي على غَيرِ مَأتَى المَيتِ في الكَفَنِ",39,"ن",1,0],["لقد دَعَتْ سامعاً لم تَكْدَ دعوتُهُ","وطالبتْ بعظيمٍ مَنْ يُؤاتيها",40,"ي",3,0],["لَقَدْ دَهَانِي لَطِيْفٌ مِنْهُمُ خَتِلٌ","فِي ذَاتِ حَدٍّ كَحَدِّ السَّيْفِ مَسْنُونِ",41,"ن",1,0],["لقد دافعت وقد علمت معدٌ","بني قُرظٍ وعمهم قدامة",42,"م",2,0],["لَقَد دَكدَكوا الأَجبالَ فيها وَشَيَّدوا","سَواهِنَ شَمّا مِن غُبارِ القَساطِلِ",43,"ل",1,0],["لقَدْ دَخَلَ الرِّياضَ وماسَ تِيهاً","رَشاً فاقَ الهِلالَ بوَجْنَتَيْهِ",44,"ه",1,1],["لَقَد دَعَتهُ المَعالي بِاِبنِ نَجدَتِها","فَفاقَ كِسرى وَمَن ضاهى أَبا كربِ",45,"ب",1,0],["لَقَد دارَ في سوقِ الغُصونِ خَلاخِلا","وَأَلبَسَها مِن أَفخَرِ الدّرِّ تيجانا",46,"ن",2,0],["لَقَد دَعَتهُ جِنانٌ","فَنَحوَها سارَ سَعيا",47,"ي",2,0],["لَقَد دَعاني لِلقُد