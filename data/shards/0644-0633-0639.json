3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62891","الوافر"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45737","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85179","الخفيف"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32658","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86454","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94869","الوافر"],[4578,"أطلع الريحان في روضِ الشقيق","https://www.poetsgate.com/ViewPoem.aspx?id=49490",""],[4935,"إني أقول لذي الحياء مقالاً","https://www.poetsgate.com/ViewPoem.aspx?id=129311",""],[5431,"رقصة النار ...","https://www.poetsgate.com/ViewPoem.aspx?id=204746",""],[5758,"عاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=201208",""],[5854,"عزموا الرحيلَ فبات كالمتوجّسِ ((عشيّة الفراق))","https://www.poetsgate.com/ViewPoem.aspx?id=191745",""],[6105,"قد كسر المشمش قلبِي وَلم","https://www.poetsgate.com/ViewPoem.aspx?id=190383",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[463,"أفلحَ قومٌ إذا دعوا وثبوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59958&r=&rc=14",""]],"verses":[["لَسَعَوا إِلى حامي الفَضي","لَةِ وَالحَقيقَةِ وَالذِمارِ",0,"ر",1,0],["لِسَعدٍ ذُرى عادِيَّةٍ يُهتَدى بِها","وَدَرءٌ عَلى مَن يَبتَغي الدَرءَ ضالِعُ",1,"ع",1,0],["لسع الجفاء حشاه وهو يرومكم","حقًّا لقد أمسى سليم الباطن",2,"ن",1,0],["لسعد عظيم في الحياة وبعدها","وفوق الكراسي ثم تحت الجلامد",3,"د",1,0],["لَسَعيُكَ أبطى عن لَحاق ابن جعفرٍ","وسَعيُ جَهْولٍ ظَنَّ أنّك تَلحقُه",4,"ق",2,0],["لِسَعدَةَ إِذ كانَت تُثيبُ بِوُدِّها","وَإِذ هِيَ لا تَلقاكَ إِلّا بِأَسعُدِ",5,"د",1,0],["لسعتها بعوضةٌ سكنت بِئْ","راً وقد كان جسمُها مستعدّا",6,"د",2,0],["لسعت حية الذوائب قلبي","فشفته برشف خمر لماها",7,"ه",2,1],["لسعتم بحيات الذوائب لبه","فهل من دواء من رحيق لمى الثغر",8,"ر",1,0],["لسعدك آيات بها عند أستوى","من الأمر ما اشتدت قواه وما ركا",9,"ك",2,0],["لسعت عَلى أَحداقِها وَثنت ذَوي","أَعناقِها وَطوث حنايا الاضلُع",10,"ع",1,0],["لِسُعدى موحِشٌ طَلَلٌ قَديمُ","بِريمٍ رُبُمّا أَبكاكَ ريمُ",11,"م",1,1],["لسعيه ما أهمَّه الدمُ وال","حم ولكن لغيرهِ السَّلَبُ",12,"ب",1,0],["لسعد قدومكم هبّ النسيم","وزان الجوّ حسناً يا نديم",13,"م",1,1],["لَسَعتْ إليك تشوّقاً ولأوْسَعَت","يُمناك من ضمٍّ ومن تقبيلِ",14,"ل",1,0],["لسعودِهِ الفَلَكُ المُسخَّرُ خادِمٌ","ولَوجْههِ القَمَرُ المنيرُ حَسودُ",15,"د",1,0],["لسعيد الكِرام عام خَصيبُ","مَدحه لِلأَنام فيهِ يَطيبُ",16,"ب",1,1],["لسعي السباع على عاقل","وقنص العداة ونقص العدد",17,"د",1,1],["لسعيد الحظ طفل قد بدا","حسن الوجه جميل محسن",18,"ن",1,1],["لسعت قلبي منه","فوق صدغ قطربوس",19,"س",1,0],["لسعا قلبيَ المُعَنَّى فلم تب","قَ له في الحياة غيرُ صُبابه",20,"ب",2,0],["لِسَعدَةِ مِن عامِ الهَزيمَةِ إِذ بِنا","تَصافٍ وَإِذ لَمّا يَرُعنا صدودُها",21,"د",3,0],["لسعتْ عقارب صِدْغِهِ قلبي وفي","ماءِ الرضاب وعزَّلي رُقياه",22,"ا",2,0],["لسعد بقلبي من الشّوق ما","من الحسن في وجهه قد جمع",23,"ع",1,1],["لسعادة الصدر الوزير محمدِ","من جدد العرفان بعد تهددِ",24,"د",1,1],["لِسعدهِ وَيمنهِ","مؤمّل وَمُرتقب",25,"ب",1,0],["لُسِعْتُم لسْعَةَ فَحَقَرتُموها","وساري السُّم ليس له احْتِقَارُ",26,"ر",1,0],["لسعدك مِن فَوق النُجوم سَماءُ","سَماها سَنا مِن نوره وَسَناءُ",27,"ا",2,1],["لسعت فاه نحلة","فلذا دمعه هطل",28,"ل",1,0],["لِسَعيدٍ شَوَيهَةٌ","نالَها الضُرُّ وَالعَجَف",29,"ف",1,1],["لِسَعِيدٍ فَإِنَّهُم سُعَدَاءُ","دَرَّ ثَدي ابنِهَا وَمِن قَبلُ مَا مَص",30,"ص",1,0],["لَسَعَتهُ حَيَّاتُ جُحرٍ بِرِجلٍ","سَدَّهُ نَفثُ المُصطَفَى استِشفَاءُ",31,"ا",2,0],["لَسَعَت شَوكَةُ الأعَادِي وَفِي ذَ","لِكَ لِلَّهِ حِكمَةٌ ورَبَاءُ",31,"ا",2,0],["لسعتنا عليك أفعى الليالي","بين نابين تنهض القلب نهشا",32,"ش",2,0],["لسعد اللَه لاح سعود نجل","أتى علماً وطالعُه جليلُ",33,"ل",1,1],["لسعيد المجد شكري زائدٌ","إذ هداني للعلى أي طريق",34,"ق",1,0],["لسعادة الدارين كمل قوة","نظرية بمعارف تتوالى",35,"ل",2,0],["لسعةُ الوجد والأنا في اهتياجٍ","وانتقامٌ على السرائر كشّر !!!",36,"ر",1,0],["لسعاد أوْ ليلى ، وهند مدائنٌ","في البدْءِ أنتِ وظلّكِ الوجْدانُ",37,"ن",1,0],["لسعتْه حيّاتُ اشتياقٍ فرّقتْ","بين الكرى وجفونِه في الحِندسِ",38,"س",1,0],["لسعره الغالي وعسري مَعًا","وأستحي أَن القط الحبا",39,"ب",2,0],["لِسَعيد فإِنَّهُم سعداء","خصها ربها الكَريم بِذا الخص",40,"ص",1,0],["لسعيه ما أهمه الدمُ وال","لحم ولكن لغيره السلبُ",41,"ب",1,0]]}