{"poems":[[55,"صاحت بذودي بغداد فآنسني","https://www.aldiwan.net/poem30446.html","البسيط"],[79,"ذكروا العهود فهاج من أشجاني","https://www.aldiwan.net/poem36070.html","الكامل"],[30,"إن يظعن الشيب الشباب فقد ترى","https://www.aldiwan.net/poem1267.html",""],[63,"ما ودع اللهو لما بان منصرما","https://www.aldiwan.net/poem51437.html","البسيط"],[68,"خطب لسان الحال فيه أبكم","https://www.aldiwan.net/poem41549.html","الكامل"],[52,"أهجرت عبدة أم عداك مسير","https://www.aldiwan.net/poem63827.html","الكامل"],[48,"العيش ماض فأكرم والديك به","https://www.aldiwan.net/poem23516.html","البسيط"],[108,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[173,"ماذا بنا في طلاب العز ننتظر","https://www.aldiwan.net/poem1631.html",""],[215,"جارت على الورد في أيام نضرته","https://www.aldiwan.net/poem46779.html","البسيط"],[376,"أفردتني وأرى العشاق أقرانا","https://www.aldiwan.net/poem57010.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138266",""],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110349","الكامل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110354","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77605","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59645","الرجز"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48942","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27911","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137181",""],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74287","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100808","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45866","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45863","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133226","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135780","الرجز"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136575",""],[5186,"عبد الرحيم! ألست من أدبائنا؟","https://www.poetsgate.com/ViewPoem.aspx?id=156548",""],[5338,"يا مدخلي بالهجر ذات وقود","https://www.poetsgate.com/ViewPoem.aspx?id=187990",""],[5725,"يا ايها البدر","https://www.poetsgate.com/ViewPoem.aspx?id=195274",""],[5939,"لستِ أنثى!","https://www.poetsgate.com/ViewPoem.aspx?id=185492",""],[5970,"ما بين قلب كليم آرق عاني","https://www.poetsgate.com/ViewPoem.aspx?id=130614",""]],"verses":[["إِن يَظفَرِ المَوتُ مِنّا بِاِبنِ مُنجِبَةٍ","فَطالَما عادَ رَيّانَ الأَظافيرِ",0,"ر",1,0],["إِنِّي ظَفَرْتُ بِمِنْحَةٍ وَذَخِيْرَةٍ","مِنْ وَدِّكَ الْبَاقِي عَلَى الأَزْمَانِ",1,"ن",1,0],["إِن يُظعِنِ الشَيبُ الشَبابَ فَقَد تُرى","لَهُ لِمَّةٌ لَم يُرمَ عَنها غُرابُها",2,"ب",3,1],["إن يَظْمَ مِنْها إلى طيبِ العِناقِ فكَم","رَوَّتْ جوانِحَه ضَمّاً ومُلتَثَما",3,"م",2,0],["إِن يَظفَروا فَتَكوا وَإِن يُظفَر بِهِم","كُلٌّ عَلَيهِ يُنابُ أَو يُستَخدَمُ",4,"م",1,0],["أَنّى ظَنَنتِ بِهِ الظُنونَ وَقَلبُهُ","يا عَبدَ في لُجَجِ الهَوى مَغمورُ",5,"ر",1,0],["إِن يَظلِموا فَلَهُم نَفعٌ يُعاشُ بِهِ","وَكَم حَمَوكَ بِرَجلٍ أَو بِفُرسانِ",6,"ن",1,0],["أن يظْهرُوا، يا قوم، لم يُبْقُوا لنا","أو للأذان، أو الحَنيفَةِ مَظْهَرا",7,"ر",2,0],["إِن يَظفَرُوا بي فَلا تَشمَخ أُنُوفُهُمُ","فَإِنَّما لِعِداهُم ذَلِكَ الظَفَرُ",8,"ر",1,0],["إن يظفروا فالليالي في عواقبهم","ظلماً بظلمٍ وإرهاقاً بإرهاقِ",9,"ق",1,0],["إنِّي ظَنَنتُ بكَ الحُسنى ولَستُ لَها","فِيمَن سِواكَ لقَد جَرَّبتُ ظَنَّانا",10,"ن",2,0],["أن يظهروا بجمعهم وجندب","وحسبوا عمار فيمن حسبوا",11,"ب",3,0],["أنّى ظهرن مكرمات بيننا","ومبجلات فالقلوب عبيد",12,"د",1,0],["إني ظننت لقاهُ وهماً كاذباً","إذ كان في عيني يظلُّ مصوَّرا",13,"ر",2,0],["إني ظننتُ لقاكِ يا بدر الدُّجَى","في الحلمِ كانَ ونحن كُنَّا نُوَّمَأ",14,"م",2,0],["إِني ظَنَنتُ أَن مَوت الديكِ","لراحَة إِن تَأتِني تَأتيكي",15,"ي",1,0],["إنّيَ ظَمآنُ ولا مَوْرِدَ لِي","إلا ارتشافُ الطل فوق الزَّهر",16,"ر",1,0],["أني ظمئتُ وشَدَّ ما أَنا ظامىءٌ","للحقِ لا لِطِلاً وذاتِ سُوارِ",17,"ر",1,0],["إني ظهرتُ بأديانٍ مفصَّلةٍ","على لسانِ فقيه بي وشماسِ",18,"س",1,0],["اني ظفرتا بعطف اكرم سيد","هو في ربى لبنان خير زعيم",19,"م",1,0],["إِني ظَمئت إِلى لُقياك مُذ زَمَن","أَوهى قَواعد أَركاني وَبُنياني",20,"ن",2,0],["اني ظننت السنا والليل يظهره","شيباً يلوح بأقفاء وافواد",21,"د",1,0],["إِن يَظهروا الجَدّ مِن حُزن فإِنَّهُم","إِذ خَلوا بِشياطين الهَوى لِعِبوا",22,"ب",3,0],["إِني ظَمئت وَلَم أَجد لي مَورِداً","إِلّاك يا بَحر الغَنائم وَالغِنى",23,"ن",2,0],["إن يظفروا بالوصل كان جهادهم","نصرا وإن ماتوا فهم شهداء",24,"ا",2,0],["إني ظلمت النفسَ ظلماً كثُرا","لكنّني رجوت ربي مغفرا",25,"ر",2,0],["أنيَّ ظفرتَ بقَلبي المَصدوع","فشككت سَهمك وهو بين ضلوعي",26,"ع",2,1],["أنى ظفرت، (وحظ مثلك حظنا)","بالسعد، من (قصر الملوك اليونسي)؟",27,"س",2,0],["إِنِّي ظَمٍ فَبِحَقِّ فَاطِمَةَ اسْقِنِي","مِنْ حَوْضِ كَوْثَرِ وِرْدِكَ الْمَوْرودِ",28,"د",1,0],["اني ظننتك وجهه فتأملتْ","عيني بداجية الظلام هياما",29,"م",2,0],["أنّي ظلمتُكِ والخيانةَ في دمي","كلُّ الرجالِ على دروبِكِ ضَبعُ",30,"ع",1,0],["إني ظمئت إلى خل ليؤنسني","فلم أجد مؤنسا ما بين خلاني",31,"ن",2,0]]}