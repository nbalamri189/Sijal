{"poems":[[53,"صاحت بذودي بغداد فآنسني","https://www.aldiwan.net/poem30446.html","البسيط"],[77,"ذكروا العهود فهاج من أشجاني","https://www.aldiwan.net/poem36070.html","الكامل"],[28,"إن يظعن الشيب الشباب فقد ترى","https://www.aldiwan.net/poem1267.html",""],[61,"ما ودع اللهو لما بان منصرما","https://www.aldiwan.net/poem51437.html","البسيط"],[66,"خطب لسان الحال فيه أبكم","https://www.aldiwan.net/poem41549.html","الكامل"],[50,"أهجرت عبدة أم عداك مسير","https://www.aldiwan.net/poem63827.html","الكامل"],[46,"العيش ماض فأكرم والديك به","https://www.aldiwan.net/poem23516.html","البسيط"],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[170,"ماذا بنا في طلاب العز ننتظر","https://www.aldiwan.net/poem1631.html",""],[212,"جارت على الورد في أيام نضرته","https://www.aldiwan.net/poem46779.html","البسيط"],[372,"أفردتني وأرى العشاق أقرانا","https://www.aldiwan.net/poem57010.html","البسيط"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["إِن يَظفَرِ المَوتُ مِنّا بِاِبنِ مُنجِبَةٍ","فَطالَما عادَ رَيّانَ الأَظافيرِ",0,"ر",1,0],["إِنِّي ظَفَرْتُ بِمِنْحَةٍ وَذَخِيْرَةٍ","مِنْ وَدِّكَ الْبَاقِي عَلَى الأَزْمَانِ",1,"ن",1,0],["إِن يُظعِنِ الشَيبُ الشَبابَ فَقَد تُرى","لَهُ لِمَّةٌ لَم يُرمَ عَنها غُرابُها",2,"ب",3,1],["إن يَظْمَ مِنْها إلى طيبِ العِناقِ فكَم","رَوَّتْ جوانِحَه ضَمّاً ومُلتَثَما",3,"م",2,0],["إِن يَظفَروا فَتَكوا وَإِن يُظفَر بِهِم","كُلٌّ عَلَيهِ يُنابُ أَو يُستَخدَمُ",4,"م",1,0],["أَنّى ظَنَنتِ بِهِ الظُنونَ وَقَلبُهُ","يا عَبدَ في لُجَجِ الهَوى مَغمورُ",5,"ر",1,0],["إِن يَظلِموا فَلَهُم نَفعٌ يُعاشُ بِهِ","وَكَم حَمَوكَ بِرَجلٍ أَو بِفُرسانِ",6,"ن",1,0],["أن يظْهرُوا، يا قوم، لم يُبْقُوا لنا","أو للأذان، أو الحَنيفَةِ مَظْهَرا",7,"ر",2,0],["إِن يَظفَرُوا بي فَلا تَشمَخ أُنُوفُهُمُ","فَإِنَّما لِعِداهُم ذَلِكَ الظَفَرُ",8,"ر",1,0],["إن يظفروا فالليالي في عواقبهم","ظلماً بظلمٍ وإرهاقاً بإرهاقِ",9,"ق",1,0],["إنِّي ظَنَنتُ بكَ الحُسنى ولَستُ لَها","فِيمَن سِواكَ لقَد جَرَّبتُ ظَنَّانا",10,"ن",2,0],["أن يظهروا بجمعهم وجندب","وحسبوا عمار فيمن حسبوا",11,"ب",3,0]]}