{"poems":[[32,"ذكرت فاهتاج السقام المضمر","https://www.aldiwan.net/poem29590.html","الرجز"],[74,"لام العذار أطالت فيك تسهيدي","https://www.aldiwan.net/poem18544.html","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141965","الطويل"],[136,"تخطى ركبه الظلل القواء","https://www.aldiwan.net/poem54900.html","الوافر"],[266,"طرف بكى وفؤاد أن من وصب","https://www.aldiwan.net/poem38369.html","البسيط"],[422,"سلمه الرب من الأسواء","https://www.aldiwan.net/poem53860.html","الرجز"],[440,"يا رب ليل بته","https://www.aldiwan.net/poem25310.html","مجزوء الرجز"],[484,"قبر ابن آدم أيا زرته انتدبا","https://www.aldiwan.net/poem36940.html","البسيط"],[918,"","https://poetry.dctabudhabi.ae/diwan/poem/107323","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17124","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108631","البسيط"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87856","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66537","السريع"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103024","البسيط"],[4869,"راس مال العلاقه","https://www.poetsgate.com/ViewPoem.aspx?id=151627",""]],"verses":[["كَأَنَّهُ تَحتَ السَمامِ المَرمَرُ","يَهمآءُ لا يَجتازُها المُغَرَّرُ",0,"ر",1,0],["كأنه تحت وجدان القبَا عدَمٌ","وا حيرتي بين معدوم وموجود",1,"د",1,0],["كَأَنَّهُ تَدْمُرُ الزَّهْراءُ مارِجَةً‏‏‏","بِمِثْلِ لُسْنِ الأَفاعي تَقْذِفُ اللَّهَبا‏‏‏",2,"ب",2,0],["كَأنَّ هَتُونَها تَهتَانُ وَطفَا","تَؤُمُّ بها الجَنُوبُ الجِرباءَ",3,"ا",2,0],["كأنه تحت نقع يستثار به","برق تألق في داج من السحب",4,"ب",1,0],["كأنَّه ترجم عن أشواقي","وعن صَبابتي وعن أعلاقي",5,"ي",1,0],["كأنهُ ترسُ لجينٍ","حولَ درعٍ سابغهْ",6,"غ",2,0],["كأنه ترجمان الميت يفصح أن","لا حي الحي منه يمنح الهربا",7,"ب",2,0],["كأنَّ هَتُونَ المُزنِ جادَت بِوَبلِها","مَجاري عيوني يومَ شَطَّ مَزَارُها",8,"ر",3,0],["كَأَنَّهُ تَحتَ الحِلِيِّ رَوضَةٌ","دَرَّ عَلَيها الزَهرُ أَخلافَ الحَيا",9,"ي",2,0],["كأنه تخت ملك فوق ملكٌ","لا يأخذ النفس إلّا أخذ مقتدر",10,"ر",1,0],["كَأَنَّهُ تُرجمانُ المُعجَبينَ بِها","يَروي لَها عَن هَواهُم أَعذَبَ السِيَرِ",11,"ر",1,0],["كَأَنَّهُ تاجٌ عَلى مَفْرِقٍ","لَمَّا اسْتَدارَتْ شُرَفُ السَّورِ",12,"ر",1,0],["كأنه تحت نقع الخيل بدر دجى","والشهب من حوله بيض وخرصان",13,"ن",1,0],["كانه تردي منك .. ياشين يمناك","واللي خذيته راس مال العلاقه",14,"ق",2,0]]}