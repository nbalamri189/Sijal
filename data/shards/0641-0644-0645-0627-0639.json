w.poetsgate.com/ViewPoem.aspx?id=198464",""],[4930,"حملتُ الصخر","https://www.poetsgate.com/ViewPoem.aspx?id=213599",""],[4994,"قصيدةٌ بلّلها موتاً دم الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=211084",""],[5212,"وَدَّعت دجلةَ","https://www.poetsgate.com/ViewPoem.aspx?id=212026",""],[592,"إلى الله نشكو إننا بمحلة","https://www.poetsgate.com/ViewPoem.aspx?id=128840",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5431,"عزاء","https://www.poetsgate.com/ViewPoem.aspx?id=182993",""],[482,"حرامٌ على الجفنِ القريحِ منامُه","https://www.poetsgate.com/ViewPoem.aspx?id=111412",""],[5701,"عشقت جمال الجسم حتى مللته","https://www.poetsgate.com/ViewPoem.aspx?id=164670",""],[5937,"متحف الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=211894",""],[2220,"أقولُ وروحُ القدسِ ينفثُ في النفسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11486&r=&rc=360",""],[5001,"ماذا أريد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80713&r=&rc=3",""]],"verses":[["فَلَم أُعذَل عَلى خَوضِ المَنايا","وَلَم أُعتَب عَلى بَذلِ النَوالِ",0,"ل",1,0],["فَلَمّا عَلَتهُ الشَمسُ وَاِستَوقَدَ الحَصى","تَذَكَّرَ أَدنى الشِربِ لِلمُتَيَمِّمِ",1,"م",1,0],["فَلَمّا عَفاها ظَنَّ أَن لَيسَ شارِباً","مِنَ الماءِ إِلّا بَعدَ طولِ تَحَرُّمِ",1,"م",1,0],["فَلَمَّا عَرَفت الدَّارَ بَعدَ تَوَهُّمي","تَكَفكَفَ دَمعِي فَوقَ خَدَّي وانهمَل",2,"ل",1,0],["فَلَمّا عَصاهُنَّ خابَثنَهُ","بِرَوضَةِ آلِيتَ قَصراً خِباثا",3,"ث",2,0],["فَلَمّا عَرَفتُ الدارَ قَفراً كَأَنَّها","رُقومٌ هَراقَت ماءَ عَيني جُفونُها",4,"ن",3,0],["فَلَما عَرَفنا آيَةَ البَينِ بَغتَةً","وَهَذُّ النَوى بَينَ الخُليطَينِ قاطِعُ",5,"ع",1,0],["فَلَمّا عَلَت أَقبالَ مَيمَنَةِ الحِمى","رَمَت بِالمَراسي وَاِستَهَلَّ فَضيضُها",6,"ض",3,0],["فَلَما عَرَفنا آيَةَ البَينِ قَلَّصَت","وَسوجُ المَهارى وَاِشمَعلَّ المَوالِسُ",7,"س",1,0],["فَلَمّا عَرَفتُ البَينَ لا شَكَّ أَنَّهُ","عَلى صَرفِ عَوجاءَ اِستَمَرَّ مَريرُها",8,"ر",3,0],["فَلَمّا عَرَفتُ الدارَ وَاِعتَزَّني الهَوى","تَذَكَّرتُ هَل لي أَن تَصابَيتُ مِن عُذرِ",9,"ر",1,0],["فَلَمّا عَرَفنا آيةَ البَينِ بَغتَة","وَرُدَّت لِأَحداجِ الفِراقِ رَكائِبُه",10,"ب",2,0],["فَلَمّا عَرَّسَ حَتّى هِجتُهُ","بِالتَباشيرِ مِنَ الصُبحِ الأُوَل",11,"ل",1,0],["فَلَمّا عَلا تُربانَ فَاِنهَلَّ وَدقُهُ","تَداعى وَأَلقى بَركَهُ وَتَهَزَّما",12,"م",2,0],["فَلَم أَعرِف أَخي حَتّى اِصطَبَحنا","ثَلاثاً فَاِنبَرى خَذِمَ العِنانِ",13,"ن",1,0],["فلم أعتب لذاك وإن أضاقت","عليَّ الأرضَ حتى قلت حبْس",14,"س",1,0],["فلما علاهُ الشيب أيقنتُ أنه","عَناني ولكن باسم غيري دعانيا",15,"ي",2,0],["فَلَمّا عَلا وَجهُ النَهارِ وَرَفَّعَت","بِهِ الطَيرُ أَصواتاً كَواعِيَةِ الجُندِ",16,"د",1,0],["فَلَمّا عَلَتهُ الشَمسُ في يَومِ طَلقَةٍ","وَأَشرَفَ مَكّاءُ الضُحى فَتَغَرَّدا",17,"د",2,0],["فَلَمّا عَرَفنا أَنَّها أُمُّ خَنزَرٍ","جَفاها مَواليها وَغابَ مُفيدُها",18,"د",3,0],["فَلَمّا عَلَت ذاتَ السَلاسِلِ وَاِنتَحَت","لَها مُصغِياتٌ لِلنِجاءِ عَواسِرُ",19,"ر",1,0],["فَلَمّا عَلا ذاتَ التَنانيرِ صَوبُهُ","تَكَشَّفَ عَن بَرقٍ قَليلٍ صَواعِقُه",20,"ق",2,0],["فلم أعدم إذا ما الدور نامت","سميرا بالمقابر أو نجيا",21,"ي",2,0],["فَلَمّا عَرَفتُ الدارَ قُلتُ لِرَبعِها","أَلا عِم صَباحاً أَيُّها الرَبعُ وَاِسلَمِ",22,"م",1,0],["فَلَم أَعجَب لِذَلِكَ وَهوَ دُرَّ","إِذا ما جاءَ مِن بَحرٍ خِضَمِّ",23,"م",1,0],["فَلَمّا عَرَفتُ البَينَ مِنها وَقَبلَهُ","جَرى سانِحٌ لِلعائِفِ المُتَطَيِّرِ",24,"ر",1,0],["فَلَم أَعدَم هُناكَ بِهِ شَفيعاً","إِلى أَمَلٍ وَلَم أَبرَح حَبيبا",25,"ب",2,0],["فلمّا عرفتَ الحقَّ أوفيتَ ناهضاً","تُقَبِّلُ مَن وَافَاكَ يُزْجِي البَشَائِرا",26,"ر",2,0],["فَلَمّا عَوى لِفتَ الشِمالِ سَبَعتُهُ","كَما أَنا أَحياناً لَهُنَّ سَبوعُ",27,"ع",1,0],["فلمَّا عَمُوا عنها وصَمُّوا أَراهُم","سُيوفاً لها بَرْقٌ وَخَيْلاً لها رَعْدُ",28,"د",1,0],["فَلَمّا عادَ آشِرُها خَبيصاً","بَعَثتُ جُناتِها بِمُعَقَّفاتِ",29,"ت",1,0],["فَلَمّا عَمِدناها لِنَسفِكَ بادَرَت","تَباشيرِ رَيّاها وَنَكهَتِها السَفكا",30,"ك",2,0],["فَلَمّا عَتا الجَحّادُ حينَ طَغى بِهِ","غِنىً قالَ إِنّي مُرتَقٍ في السَلالِمِ",31,"م",1,0],["فَلَمْ أعْدُدْ هَوَايَ لَهَا سَفاهاً،","وَلا وَجْدي القَديمَ بهَا ضَلالا",32,"ل",2,0],["فَلَمَّا عَرَفْتُ الدَّارَ قُلْتُ لِرَبْعِهَا","أَلاَ أَنْعِمْ صَبَاحاً أَيُّهَا الرَّبْعُ وَاسْلَمِ",33,"م",1,0],["فَلَمّا عَسوني كُنتُ مِنهُم وَقَد أَرى","غِوايَتَهُم وَأَنَّني غَيرُ مُهتَدي",34,"د",2,0],["فَلمّا عَزَّ دِينُ الحَقِّ فِينَا","صَرَفنا حَدَّها لِلكافِرينَا",35,"ن",2,0],["فلمّا عَداها اليَأسُ أَن تُؤنِسَ الحِمَى","حِمَى البَينِ خَلَّى عَبرَةَ العَينِ جالُهَا",36,"ل",3,0],["فَلمّا عَلا في السامِعينَ جؤارهُ","وَشاهدَ أُسدَ الدين هاجَت بهِ فرّا",37,"ر",2,0],["فَلَمّا عَلا الماءُ الجِبالَ تَحامَلَت","سَفينَةُ نوحٍ وَهوَ فيها يُكَبِّرُ",38,"ر",1,0],["فَلِمْ أَعطاكَهُ نَجْماً خَفِياً","وَعادَ لأَخْذِهِ قَمَراً مُنِيرا",39,"ر",2,0],["فلما علمت على التجمّل باعث","فَاِستفتِ نفسكَ في عزائك واِسمعِ",40,"ع",1,0],["فَلَمّا عَرَثنا يَنفَحُ المِسكَ جَيبُها","إِذا نَهَضَت كادَت تَميلُ مِنَ النَهضِ",41,"ض",1,0],["فَلَمّا عَلا مَتنتَيهِ الغُلامُ","وَسَكَّنَ مِن آلِهِ أَن يُطارا",42,"ر",2,0],["فلما عبَّ بحر نداك كانوا","إلى يدك النقائرَ والبِقاعا",43,"ع",2,0],["فلم أعرفِ الأطلالَ وهي دوارسٌ","خوالٍ مِنَ الأحبابِ إلا توهُّما",44,"م",2,0],["فَلَمّا عَصَينا بِالسُيوفِ تَقَطَّعَت","وَسائِلُ كانَت قَبلُ سِلماً حِيالُها",45,"ل",3,0],["فلما عاد أبصره شريداً","تمزقه الضواري في الفلاة",46,"ه",1,0],["فلمَّا عرضن لنا سافراتٍ","اعدنَ الهَوى وبَعَثْنَ الشجونا",47,"ن",2,0],["فَلَمْ أَعْدِمْ بِمَنْزِلِهِ جَمِيلاً","فَحَيْثُ هُوَ الجَمَالُ هُوَ الجَمِيلُ",48,"ل",1,0],["فلمَّا عليَّ الخطبُ ألقى جِرانَه","وسدَّ بعيني واسعَ الشرقِ والغرب",49,"ب",1,0],["فلم أعدِل بجامده مذاباً","ولم أنكر لِنَدوَتِهِ اشتعالا",50,"ل",2,0],["فلما علا رأسي القتيرُ وقوست","عصاي وجاءتني المنيةُ ترتمي",51,"م",2,0],["فلم أَعْدُ عادات الكرِام وإِنهم","عن الحقِّ في تلك الحقيقة ناموا",52,"م",3,0],["فلم أعرِّج على أهلٍ ولا ولد","ولا على أحد من البرياتِ",53,"ت",1,0],["فلما عدت بحر الوجودِ وعانيت","بسيف النهي من جلعن رتبة الأنس",54,"س",1,0],["فلما عرفتُ الضعف فيها وأنها","تخالف في نطقيهما القلب وا