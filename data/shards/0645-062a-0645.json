"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[459,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[462,"لله درك من مقارن همة","https://www.aldiwan.net/poem16024.html","الكامل"],[471,"أفالآن لما بايعوا لضلالة","https://www.aldiwan.net/poem4740.html","الطويل"],[471,"هل أنت أمير المؤمنين فإنني","https://www.aldiwan.net/poem4749.html","الطويل"],[478,"هل بعد بينك من جوى لمودع","https://www.aldiwan.net/poem15216.html","الكامل"],[483,"خود رمت عن قوس حاجبها سها","https://www.aldiwan.net/poem24485.html","عموديه"],[501,"الخب ميال مع الشبهات","https://www.aldiwan.net/poem37714.html","الكامل"],[501,"عوجا إلى الوادي المقدس بالسرى","https://www.aldiwan.net/poem37817.html","الكامل"],[505,"حلت حين ما حلت على المصايب","https://www.aldiwan.net/poem38413.html","الطويل"],[515,"نبتت رياحين العذار بورده","https://www.aldiwan.net/poem20790.html","الكامل"],[516,"بصعود منزلة وجد صاعد","https://www.aldiwan.net/poem12058.html","الكامل"],[516,"خلعت عليك مواسم الأيام","https://www.aldiwan.net/poem12251.html","الكامل"],[539,"عبد العزيز أنا فداك","https://www.aldiwan.net/poem48004.html","عموديه"],[559,"أنا في الملاح على اليقين","https://www.aldiwan.net/poem33819.html","مجزوء الكامل"],[587,"من شاء بعد رضى الأحبة يغضب","https://www.aldiwan.net/poem17412.html","الكامل"]],"verses":[["مُتَمَلِّياً بِالعُمرُ يُع","طيكَ الرَدى عَقدَ الذِمامِ",0,"م",1,0],["مُتَمَلِّيينَ مِنَ الشَبابِ كَأَنَّهُم","أَقمارُ غاشِيَةِ الظَلامِ الأَربَدِ",1,"د",1,0],["مُتَمَلمِلينَ عَلى الرِحالِ كَأَنَّما","مَرّوا بِبَعضِ مَنازِلِ الأَحبابِ",2,"ب",1,0],["مُتَمَنطِقاتٌ بِالحُلّي","وَفي قَلائِدِها المَلابُ",3,"ب",1,0],["مُتُّ مِن قَبلِ أَن أَراكَ وَأَن يَظ","هَرَ لي مِنكَ سَيِّدي الهِجرانُ",4,"ن",1,0],["مُتَمَكِّنٌ مِن نَفسِهِ لَم يَعرُهُ","قَلَقُ الضَعيفِ وَحَيرَةُ المُرتابِ",5,"ب",1,0],["مُتَمَنطِقٌ مِن جِلدِهِ","مُتَخَتِّمٌ في خَصرِهِ",6,"ه",1,1],["مُتَمَرِّسٌ بِالدَهرِ يَقعُدُ صَرفُهُ","إِن قامَ في نادي الخُطوبِ خَطيبا",7,"ب",2,0],["مُتَمَازِحَيْنِ كَأَنَّمَا نَفْسَاهُمَا","نَفْسٌ لَهَا شَبَحَانِ مُنْفَصِلانِ",8,"ن",1,0],["مُتَمَّمُ الأَسْرِ رَحْبُ الصَّدْرِ بَارِزُهُ","مَقَوَّمُ الأَزْرِ طَاوِي الْكَشْحِ مُنْهَضِمُ",9,"م",1,0],["مُتِمِّ إمَارَةِ الأَصْلِ المُعَلَّى","بِفَضْلٍ بَاذِخٍ كَالأَصْلِ سَامِ",10,"م",1,0],["متمازجان من التعانق والوفا","في الحبِّ مزجَ الماءِ بالصهباء",11,"ا",2,0],["متمنّع تلقاه في حال الرِّضا","وكأنه غضبان من فرطِ الصلف",12,"ف",1,0],["مُتمهّدون وأنت تح","ت الرَّمْس يَرْعَى الدُّودُ جِلْدَك",13,"ك",1,0],["مُتَمَهِّلٌ في سَيرِهِ","وَالماءُ يُسرِعُ في المَسيرِ",14,"ر",1,0],["مُتَمايِلُ الأَعطافِ كَال","غُصنِ الَّذي هَزَّتهُ ريحُه",15,"ح",2,0],["مُتَمَدّداً يَحميكَ كُلّ تعدّدٍ","مُتَعَطِّفاً لا رَحمَةً لِلعاني",16,"ن",2,0],["متمنياً وعد الكريم بمثلها","اما الكريم فانه لا يخلف",17,"ف",1,0],["متُّ مِن حَبَّةِ بُرٍّ","أَحدَثَت في الصَدرِ غُلَّه",18,"ل",2,0],["مُتَمايِلَ الأَعوادِ مِمّا مَسَّ مِن","كَرَمٍ وَمِمّا ضَمَّ مِن أَعطافِ",19,"ف",1,0],["مُتَمَيِّزاً حينَ التَمَيُّ","زُ لَيسَ مِن أَرَبِ الشَبابِ",20,"ب",1,0],["مُتَمَكِّنٌ كَالطَودِ أَصلاً في الثَرى","وَالفَرعُ في حَرَمِ السَماءِ مُحَلِّقُ",21,"ق",1,0],["مُتَمَسِّكينَ بِأَوَّلِيَّةِ سُؤدُدٍ","وَبِمَنصِبٍ في أَسوَدانَ لُبابِ",22,"ب",1,0],["مُتَمَسِّكينَ بِبَيعَةٍ","أَحكَمتَها بِوَثيقِ عَقدِك",23,"ك",1,0],["مُتَمايِلَ الأَعناقِ في حَرَكاتِهِ","كَسَلَ النَعيمِ وَفَترَةَ المُتَنَفِّسِ",24,"س",1,0],["مُتَمَكِّنٌ مِن هاشِمٍ في رُتبَةٍ","عَلياءَ بَينَ الغَفرِ وَالإِكليلِ",25,"ل",1,0],["متمسِّكاً بالصِّدقِ في مَوعودِه","متمسِّكاً بالعَفوِ في إيعادِه",26,"د",2,0],["متمرِّدٌ عاتٍ يضلِّلني","كَذِب السَّراب على شواطئه",27,"ه",1,0],["متمهلاً للخصم متئداً","وحينا للّقاء مسارعا",28,"ع",2,0],["مُتَمَلمِلاً أَلَماً بِمَصرَعِ سَيِّدٍ","قَد كانَ سابِقَ حَلبَةِ النُجَباءِ",29,"ا",2,0],["مُتمرِّدينَ على الزَّمانِ يَسومُهم","سِمةَ الهَوانِ وخُطَّةَ الإِذعانِ",30,"ن",1,0],["متمُ كي تعز كلمة ربي","في ربوعٍ أعزه لإسرءُ",31,"ا",1,0],["مُتَمَكِّنُ الأخلاق إلّا أنّه","في الحُكمِ يَرْضَى للإلهِ وَيَغْضبُ",32,"ب",1,0],["مُتَمَكِّنٌ في كلِّ مَشْهَدِ دَهْشَةٍ","أَوْ وَقْفَةٍ ما فَوْقَهَا مِنْ مَشْهَدِ",33,"د",1,0],["مُتَمَطِّرينَ إِلى الخِيانَةِ وَالأَذى","وَهُمُ السَحائِبُ مالَها إِمطارُ",34,"ر",1,0],["مُتَمَجِّسونَ وَمُسلِمونَ وَمَعشَرٌ","مُتَنَصِّرونَ وَهائِدونَ رَسائِسُ",35,"س",1,0],["متمرس بطباعها متفرّسٌ","في روعها يقط الخطى مرهوبها",36,"ب",3,0],["مُتَمَادِياً عَزْماً تَمَادَى أَرْوَعٍ","لاَ وَاهِنٍ يَوْماً وَلاَ خَوَّارِ",37,"ر",1,0],["مُتَمَكِّناً مِنْ نَفْسِهَا إِيمَانُهَا","إِنْ لَمْ تَكُنْ مِمَّنْ حَيُوا لِفَنَاءِ",38,"ا",2,0],["مُتَمَاثِلَيْنِ سَجيَّةً وَمَزِيَّةً","مُتَعَاهِدَيْنِ عَلَى هُدَى وَتَعَفُّفِ",39,"ف",1,0],["مُتَمَّمٍ يَمْلأُ الأَلْبَابَ رَوْنَقُه","ثَبْتِ الأَسَاسِ لَهُ تَاجٌ مِنَ الشُّهُبِ",40,"ب",1,0],["مُتّمُ كي تعزّ كِلمة ربي","في ربوع أعزها الإسراء",41,"ا",2,0],["مُت مِن جَوىً وَجَوادٍ","قَد غارَ ماءٌ فَظيعُ",42,"ع",1,1],["متماوجُ الأشباحِ حزناً ما به","الا حشاً دامٍ ووجهٌ أسفَع",43,"ع",1,0],["متمكِّنٌ مما يريد يَنالهُ","موفورُ جأشٍ هادئُ الأعصاب",44,"ب",1,0],["متملكٌ سمعَ المُلوك وإنما","يروي فصيح القول في فأفائه",45,"ا",3,0],["متُّ من حَبَّة ِ بُرٍّ","أحدثتْ في الصدر علَّه",46,"ل",2,0],["مُتَمرض مَرض الزَمان لِأَجلِهِ","إِذ عَمهُ بِسَوابغ الإِحسان",47,"ن",1,1],["مُتَمَسِّكينَ بِهُدنَةٍ ما تَنقَضي","إِلّا وَأَنتَ عَلى الخَليجِ مُخَيِّمُ",48,"م",1,0],["متمم بفضله لعلمه","بعلمكم إحسانه ذو منة",49,"ه",1,0],["مُتَمَطِّرٍ سامي التَليلِ مُقابلٍ","بَينَ النَعامَةِ وَالحرُونِ وَقُرزُلِ",50,"ل",1,0],["مُتَمَرِّداً في سُكْرِهِ","مُتَمايِلاً فِي خَطْرِهِ",51,"ر",2,0],["متمّمٌ مكارمَ الأخلاقِ","وَلِلكرامِ قَد أَتى متمّما",52,"م",2,0],["متململاً أصِلُ الدموعَ بمثلها","صلةَ العِهادِ رَبابَها برباب",53,"ب",1,0],["متمايل الاعطاف رنحه الصبا","جذلان من خمر الصبا نشوانه",54,"ن",2,0],["مُتمتِّعاً بِالعِزِّ وَالتَ","أييدِ مَنصورا لِواك",55,"ك",1,0],["مُتَمَطِّراتٍ تَلتَوي","تَحتَ الرِحالِ وَتَستَقيمُ",56,"م",1,0],["مُتَمَسِكٌ بِوَثيقِ عَه","دٍ مِن ذِمامِكُمُ مُوَلَّد",57,"د",1,0],["متميز جمع الفضائل كلها","خُلُقَاً وخَلقَاً ذا لذاك متمم",58,"م",1,0],["متمم الأوصاف والمعاني","حبه ثوي في داخل الجنان",59,"ن",1,0],["متمسك متنسك متبتل","للَه