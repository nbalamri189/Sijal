َ أُخرَى.. ما الذي اتَّضَحَا؟!","https://www.poetsgate.com/ViewPoem.aspx?id=198424",""],[4578,"قلبٌ بنار الأسى والوجد حرانُ","https://www.poetsgate.com/ViewPoem.aspx?id=49529",""],[3591,"من التلاقي قضيت السؤل والطلبا","https://www.poetsgate.com/ViewPoem.aspx?id=149403",""],[3591,"قد هام حافظ في القطرين وانتسبا","https://www.poetsgate.com/ViewPoem.aspx?id=149505",""],[5145,"أذر الدموع فلات حين مجاز","https://www.poetsgate.com/ViewPoem.aspx?id=108241",""],[5225,"في عيونك","https://www.poetsgate.com/ViewPoem.aspx?id=36757",""],[5674,"ياقدس","https://www.poetsgate.com/ViewPoem.aspx?id=195389",""],[5736,"وجع الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=208185",""],[5956,"مناهل إلهامي","https://www.poetsgate.com/ViewPoem.aspx?id=185878",""],[5975,"السير في نهج البردة","https://www.poetsgate.com/ViewPoem.aspx?id=58777",""],[6089,"يا سيد الأرض الكريمة","https://www.poetsgate.com/ViewPoem.aspx?id=215728",""],[6152,"البن يسأل","https://www.poetsgate.com/ViewPoem.aspx?id=213150",""],[5490,"أهذا الصبح..؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81929&r=&rc=15",""]],"verses":[["كَم أَحالوا عَلى غَدٍ كُلَّ أَمرٍ","وَمُحيلُ الأُمورِ يَبغي المُحالا",0,"ل",2,0],["كَم أَحمِلُ الشَوقَ المُبَرّحَ وَالأَسى","لَو كانَ قَلبي صَخرَةً لَتَفَتَّتا",1,"ت",2,0],["كم أحسنت أزهار آدابهِ","لمدحهِ الزَّاهر إمدادِي",2,"د",2,0],["كما حكى نيلُ مصر جودَ سائدها","لو لم يكن في وفاء النيل تسويف",3,"ف",1,0],["كما حَبَّبَ المِقراضَ عندي أنَّهُ","يُطَرِّي شبابي في عيونِ الحبائبِ",4,"ب",1,0],["كم احتمَلنا وكم صبرنَا","والعيشُ صبرٌ وكبرياء",5,"ا",2,0],["كما حنّ في قَيْدِ الدجى بمُضِلّةٍ","إلى وَطَنٍ عَوْدٌ من الشوق يُرْزِمُ",6,"م",1,0],["كم أحْوَرٍ لمّا رآكِ رأيتُهُ","يَرْنُو إلى تَفْتِيرِ طرفِكِ شاخصا",7,"ص",2,0],["كَم أَحرَزَت قُضُبُ الهِندِيِّ مُصلَتَةً","تَهتَزُّ مِن قُضُبٍ تَهتَزُّ في كُثُبِ",8,"ب",1,0],["كَم أَحرَزَ المالَ المُقيمُ بِجَدِّهِ","وَسَعى الحَريصُ فَعادَ غَيرَ مُمَوَّلِ",9,"ل",1,0],["كَما حَمَيناكَ يَومَ النَعفِ مِن شَطِبٍ","وَالفَضلُ لِلقَومِ مِن ريحٍ وَمِن عَدَدِ",10,"د",1,0],["كَما حُلَّ عَن وَقرى وَقَد عَضَّ حِنوُها","بِغارِبِها حَتّى أَرادَ لِيَجزِلا",11,"ل",2,0],["كم أَحِمِلُ كم أكْتُمُ كم أصطَبِرُ","يُقْضَى أجلي ولَيْسَ يُقْضَى وَطَرُ",12,"ر",1,0],["كما حَجَبَتْ بالغُبارِ العيون","خِفافٌ مُهرّأةٌ تُحتذى",13,"ا",1,0],["كم أحرزت إفادةً","وكم حوت من كشفِ",14,"ف",1,0],["كَما حَطَّ عَنهُ لِلتَخَيُّرِ وِزرَهُ","وَقَد كانَ قَبلَ البَعثِ أَنقَضَ",15,"ض",1,0],["كَما حَنَّ مَجمُوعُ الوَظِيفَينِ آنَسَت","لَهُ العَينُ أُخرَى المُطلقَاتِ الأَلاَئِفِ",16,"ف",1,0],["كَما حفظتَ الكنز بالجدارِ","فَإنّه أُحيط بالأخطارِ",17,"ر",1,0],["كما حلَّت وهادَ الأرض أسدٌ","وحلتْ في بواذخها وعول",18,"ل",1,0],["كَما حَكَمَت بَني سَعدٍ وَجَرَّت","بِرَهطِ بَني غَزِيَّةَ عَنقَفيرُ",19,"ر",1,0],["كما حوى كفّاه تمراً به","أشبع جيشاً ضمّه الخندق",20,"ق",1,0],["كَم أَحمِلُ الضَيمَ وَالأَهوالِ واحرَبا","مِن عَيشِهِ كُلّها ضَيمٌ وَأَهوالُ",21,"ل",1,0],["كَم أَحمِلُ الضَيمَ وَكَم أُنفِقُ مِن","صَبري وَلا آنالُ أَجرَ الصابِرِ",22,"ر",1,0],["كَما حَلَّ في قَبضَةِ القَرمَطِيِّ","تَحيّاتِهِ الحَجَرُ اّلأَسوَدُ",23,"د",1,0],["كما حملت نفحاتُ الصَّبا","إليكِ من الرَّوضِ عطراً عبق",24,"ق",1,0],["كما حنّ مقصوصُ الجنّاحِ وقد رأى","طيوراً إِلى الأوكارِ ترجعُ أفواجا",25,"ج",2,0],["كَما حَبا الرِياسَةَ الغَرّاءَ مِن","مُؤَيدِ الدينِ بِكافٍ مُنتَجَب",26,"ب",1,0],["كَم أَحبِسُ العُقودَ في الحَقاقِ","دونَ تَراقيها إِلى التَراقي",27,"ي",1,0],["كما حَفَّ من العَينِ","على إنسانِها الوَسْط",28,"ط",1,0],["كم أحمل الهمّ الغريب لصاحب ال","حُسنِ الغريبِ بليت بالغرباءِ",29,"ا",2,0],["كَما حَملت إِلى صَب عَليل","سَلاماً مِن أَحبتِهِ قُبول",30,"ل",1,0],["كم أحرقت شهبه للماردين فما","أبقَتْ على الأرض للباغين شيطانا",31,"ن",2,0],["كما حوى الذكر الزبور أرخوا","بأنهُ داود شيخ الحرم",32,"م",1,0],["كم أحرقت كفها طهراً وكم فجرت","صدراً وكم أذهلتنا من غرائبها",33,"ب",3,0],["كما حُدِّثْتَ عن لَسْعِ الأَفاعِي","يُعاوِدُ سُمُّها عاماً بِعامِ",34,"م",1,0],["كَمَا حَمَلَتْ رَحْلَ الدَّبا عاصِفُ الصَّبا","أَوِ انْهَلَّ بالوَبْلِ الأَجَشِّ غَمَائِمُهْ",35,"م",2,0],["كما حاسدٍ عندكم مكاني","يدعو سهيلاً إلى النزولِ",36,"ل",1,0],["كم أحملُ الدنيا فلا","ترقُّ لي من ظَلَعِ",37,"ع",1,0],["كم أحملُ الناسَ على عِلاَّتهم","قد جُلِبَ الظهرُ وجُبَّ الهادي",38,"د",2,0],["كم أحمدتْ قَبلكَ عُنْقي يدٌ","لكنّها سامتْ ولم تَضرِبِ",39,"ب",1,0],["كم أحرقوا كم أغرقوا من مرة","كم ذُوقوا ضربا يهد الناصيه",40,"ي",2,0],["كم أحالت هياكلاً من نحاس","ذهباً خالصاً ينير المسالك",41,"ك",1,0],["كما حكى القرآن هذا لنا","وكان ما قد كان من كل ضيق",42,"ق",1,0],["كَمْ أَحْتَمِل الغَرامَ والهَجْرَ تُرَى","يا بَدْرُ بِدَارِي بَعْدَ ذَا البُعْد تُرَى",43,"ر",2,0],["كم أحرقت هفواته مهجا وقد","ظهر الخطا كاليوم ذى الاشماس",44,"س",1,0],["كَما حَلا بزعيم من بني حسنٍ","آباؤهُ خيرُ فرسان وأبطالِ",45,"ل",1,0],["كم أحرجوك ليغضبوك فلم يروا","عنتاً ولم يصب اللهيب هشيما",46,"م",2,0],["كَم أَحرَقتهُ مُهجَةٌ","نارُ البعادِ وَنارُ خَدّك",47,"ك",1,0],["كما حادثٍ قد رآه الناسُ يهلكهُم","وَآلَ مِن لُطفِهِ فيهِم إِلى العدَمِ",48,"م",1,0],["كَما حَمدتُ اللَّهَ في البدءِ لما","نَظَمته أَحمَده متمّما",49,"م",2,0],["كم أحدث الزمان أمراً مُرَّا","ولم يزل يضرب زيد عمرا",50,"ر",2,0],["كم أحمدَّنك يا إلهي دايماً","وأقول من نفس تواتر شكرها",51,"ه",2,1],["كما حصلت من بعده لابن عمّه","وذا مصطفى فادع له بالترحم",52,"م",1,0],["كما حاجة من ام زيد تعوذي","وقد غالني لو تعلمين شؤون",53,"ن",1,0],["كم أحرزوا من سابقات","ليس تحصى عددا",54,"د",2,0],["كَما حَجَّت إِلى المَنهَ","لِ أَسرابُ القَطا الكُدري",55,"ر",2,0],["كم أحتسي منهم سلاف ملامة","في ذوقها رشف لكأس منون",56,"ن",1,0],["كم أحاديث فخار تؤثر","عنك ما تُذكر الا تُشكر",57,"ر",1,0],["كم احترزتُ لو وَقَى احترازي","عيون عين الربرب الجوَّاز",58,"ز",1,1],["كَم أَحالت مِنها جَميل صِفات","لا تَراها سِوى عِظام رفات",59,"ت",1,0],["كم أحزنت قلباً سليماً طاهرا","متضرعاً ولربه متبتلا",60,"ل",2,0],["كما حَمَّلتني شُقَّةَ البين بلدتي","ظَفارٌ وَقَدْ يأنى الأمورَ مُحيدها",61,"د",3,0],["كما حَرَّكتْ شَمْأَلٌ لاغِبٌ","مُتُونَ أَقاحٍ جَلاها المَطَرْ",62,"ر",1,0],["كما حذقتُ بها فن البيانِ ولل","بيان رَوق مقامٍ ينطح السحبا",63,"ب",2,0],["كم أحرقت مهجة صَبٍّ وكم","تقول للعشاق هل من مزيد",64,"د",1,0],["كَم أَ