ل يوم عبرة لك تهمع","https://www.aldiwan.net/poem15272.html","الطويل"],[477,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[491,"حفظت منك بما لم يجر في خلدي","https://www.aldiwan.net/poem67296.html","عموديه"],[498,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[498,"حفظنا له عهدا قديما مطرزا","https://www.aldiwan.net/poem37747.html","الطويل"],[502,"سما قدر السماحه والجمال","https://www.aldiwan.net/poem38407.html","الوافر"],[512,"هل المحرم فاستهل مكبرا","https://www.aldiwan.net/poem20838.html","الكامل"],[513,"سفر الزمان بواشح من بشره","https://www.aldiwan.net/poem12098.html","الكامل"],[513,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[513,"وفى لك حد الجد والسيف غادر","https://www.aldiwan.net/poem12105.html","الطويل"],[513,"تناولت المكارم والمساعي","https://www.aldiwan.net/poem12173.html","الوافر"],[527,"حفظ اله علاكا","https://www.aldiwan.net/poem37280.html","مجزوء الرمل"],[536,"تبدت نجوم الفن في أفق الغرب","https://www.aldiwan.net/poem48272.html","عموديه"],[556,"حمائم شوق في الغصون تنوح","https://www.aldiwan.net/poem33554.html","الطويل"],[556,"اصبر على ضر البلايا","https://www.aldiwan.net/poem33572.html","مجزوء الكامل"],[556,"هذه الكائنات أم هي حانه","https://www.aldiwan.net/poem33691.html","الخفيف"],[556,"ليس طيب الحياة غير وفاتك","https://www.aldiwan.net/poem34275.html","الخفيف"],[556,"اغسلوا بي نجاسة الوسواس","https://www.aldiwan.net/poem34440.html","الخفيف"],[560,"على نادي أحبتنا الكرام","https://www.aldiwan.net/poem52798.html","الوافر"],[560,"لمن المضارب في ظلال الوادي","https://www.aldiwan.net/poem52867.html","الكامل"],[562,"إن يوماً لم الق فيه حبيباً","https://www.aldiwan.net/poem841.html",""],[573,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"],[573,"لست الملوم بما تجني علي بصري","https://www.aldiwan.net/poem3066.html","البسيط"],[585,"على دارس الأطلال بالمتحلب","https://www.aldiwan.net/poem11503.html","عموديه"]],"verses":[["حَفِظوا عَورَةَ العُلى","وَرَقوا لِلعَوالِيا",0,"ي",2,0],["حَفيظٍ إِذا ما ضَيَّعَ المَرءَ قَومُهُ","وَفِيٍّ إِذا ما خُوِّنَ العَضُدانِ",1,"ن",1,0],["حُفرَةٌ أَطبَقَت عَلى واضِحِ الأَث","وابِ في المَجدِ طَيِّبِ الأَردانِ",2,"ن",1,0],["حَفِظوا أَياديكَ الجِسامَ وَإِنَّما","وُصّوا بِحِفظِ الخَيلِ وَالأَنعامِ",3,"م",1,0],["حَفائِرٌ أَلقى الجودُ أَفلاذَ كِبدِهِ","بِهِنَّ وَخَطَّ المَجدُ فيهِنَّ مَضجَعا",4,"ع",2,0],["حِفاظاً عَلى القُربى الرَؤومِ وَغَيرَةً","عَلى الحَسَبِ الداني وَبُقيا عَلى المَجدِ",5,"د",1,0],["حَفِظَ اللَهُ مَعشَراً فارَقوني","لا يُطيعونَ في الهَوى مَن يَلومُ",6,"م",1,0],["حَفيدَ وليِّ اللهِ ذي الرُّتْبَةِ العُلْيا","ومَنْ نالَ في الأخْرى السُّمُوَّ وفي الدُنْيا",7,"ي",2,1],["حَفِظوهُ ببَذْلِ النّفْسِ كَما","حَفِظوا بجُفونِهِمُ الحدَقا",8,"ق",2,0],["حَفَرَتُ فِي دَارِيَ الضَّرِيحَ لَهَا","تَعَلُّلاً بِالْمُحَالِ فِي الْحَالِ",9,"ل",1,0],["حَفيظٌ على الأسْرارِ حتّى كأنّني","دُعيتُ سَريراً أنّني أحفَظُ السِّرّا",10,"ر",2,0],["حَفِظَ اللهُ أمّةً أنْتَ فيها","مَلِكاً من طَوارِقِ الأحْداثِ",11,"ث",1,0],["حَفِظَ اللهُ قَلْبَهُ مِنْ فَسَادٍ","مِثْلَمَا يَحْفَظُ اسْمَهُ مَعَ قَلْبِهْ",12,"ه",1,0],["حَفَّتْ بِهِ رَايَاتُكَ الحُمْرُ الَّتِي","قَادَتْ إِلَيْهِ قَبَائِلاً وَشُعُوبَا",13,"ب",2,0],["حَفِظَ النَهارَ وَباتَ عَنها غافِلاً","فَخَلَت لِصاحِبِ لَذَّةٍ وَخَلا لَها",14,"ل",3,0],["حَفِظنَ وِدادي في البِلى وَحَفِظتُهُ","لَهُنَّ بِقَلبٍ دائِمِ الحَسَراتِ",15,"ت",1,0],["حَفِظَ اللَهُ مِبضَعاً في يَدَيهِ","قَد أَماتَ الأَسى وَأَحيا الرَجاءَ",16,"ا",2,0],["حَفِظتُ لَها العَهدَ الَّذي ما أَضاعَهُ","صُدودٌ وَلا أَلوى بِهِ قِدَمُ العَهدِ",17,"د",1,0],["حَفَلُوا لأُمِّ المُحْسِنِينَ وَأَمْمَأْوا","بِتَجِلَّةٍ مَصْدُوقَةٍ وَسَلامِ",18,"م",1,0],["حَفَزَتْكَ النَّفْسُ الودُودُ فَلَمْ تَتْرُكْ","وِدَادِي فِي جَانِبِ الإِغْفَالِ",19,"ل",1,0],["حفّت جوانبه بكلّ بديعةٍ","فزها جمالاً واستقلّ جلالا",20,"ل",2,0],["حُفِزَت وَزايَلَها السَرابُ كَأَنَّها","أَجزاعُ بيشَةَ أَثلُها وَرُضامُها",21,"م",3,0],["حَفِظتُ وَضَيَّعتِ المَوَدَّةَ بَينَنا","وَأَحسَنَ مِن بَعضِ الوَفاءِ لَكِ العُذرُ",22,"ر",1,0],["حِفاظاً عَلى أَحسابِنا بِنُفوسِنا","إِذا لَم يَكُن غَيرَ السُيوفِ لَنا سِترُ",23,"ر",1,0],["حفيّ غداةَ المكرمات أو الوغى","ببيض أياديها وأعلامها الصّفر",24,"ر",1,0],["حفظ عهدٍ يضوع في الحبِّ نشراً","وعجيبٌ لضائعٍ محفوظ",25,"ظ",1,0],["حفظت فوائده وضاعَ نسيمهُ","فاعْجب له من ضائعٍ محفوظ",26,"ظ",1,0],["حفيت بوعدِ الآملين فكلّها","يسعى إلى لقيا المؤمَّل حاف",27,"ف",1,0],["حفيٌّ بطلاَّب الفضائل والندى","فلله ما حيّ عيّها بعدَ عدمها",28,"م",3,0],["حَفّلتُمُ ومريتم كل ناحيةٍ","قد حاردتْ ثم ثَلَّثتم بإدرار",29,"ر",1,0],["حفزتُ إليك الشعرَ بالشعر ترتمي","غواربُهُ حتى كأنك أخرسُ",30,"س",1,1],["حفظوا حقَّ مُصعبٍ في سلي","مانَ بتضييع كلِّ أمرٍ جسيمِ",31,"م",1,0],["حِفاظاً وهل لي أُسْوةٌ لوْ طلبتُها","ألا لا وهل من قِيمة لك في القِيمْ",32,"م",1,0],["حفاظي خَصيمي عنكِ يا أمُّ إنه","أبى لي إلا الهمَّ بعدك والسَّدَمْ",32,"م",1,0],["حِفلةً بالأمير من كل شيءٍ","واحتشاداً له من المهرجان",33,"ن",1,0],["حَفَّت بِهِم سُفُنُ العُداة وَأَحدَقَت","حَتّى وَالكُلُّ إِخالَها أَسوارا",34,"ر",2,0],["حَفِظتُ لَكُم وُدّاً أَضَعتُم عُهودَهُ","فَها هُوَ مَختومٌ لَكُم بِخِتامي",35,"ي",1,0],["حَفِظنا لَكُم وُدّاً أَضَعتُم عُهودَهُ","فَشَتّانَ في الحالَينِ نَحنُ وَأَنتُمُ",36,"م",1,0],["حَفِظتُ لَكُم ماتَعهَدونَ مِنَ الهَوى","وَلَستُ لِسِرٍّ بَينَنا بُمُضيعِ",37,"ع",1,0],["حَفَرنَ عُروقُها حَتّى أَجَنَّت","مَقاتِلَها وَأَضحَينَ القُرونا",38,"ن",2,0],["حَفد الوَلائِد حَولَهُنَّ وأَسلَمَت","بأَكُفِّهنَّ أزِمَّةَ الأَجمالِ",39,"ل",1,0],["حفر الشعب يا أباه جميعا","يوم وافاك الموت في القلب لحدك",40,"ك",1,0],["حفوا بغازي مثلما","يحف بالعين الهدب",41,"ب",1,0],["حفظت الودّ والودّ انتقال","وإن الحافظين له قليل",42,"ل",1,0],["حَفِظَ الدينَ مَلِيّاً وَمَضى","يُنقِذُ الدُنيا فَلَم يَملِك ذَهابا",43,"ب",2,0],["حَفَّ كَأسَها الحَبَبُ","فَهيَ فِضَّةٌ ذَهَبُ",44,"ب",1,1],["حَفِظَ اللَهُ أَحمَدَ اِبنَ مَنيعٍ","ما سَرى كَوكَبُ وَهَبَّت جَنوبُ",45,"ب",1,0],["حَفِظَ اللَهُ جَعفَراً حَيثُ تَعرو","مِن صَديقٍ مُلِمَّةٍ أَو تَنوبُ",46,"ب",1,0],["حِفظاً عَلى مِنهاجِهِ المُفضي إِلى","أَمَدِ العُلى وَتَقَيُّلاً لِجُدودِهِ",47,"د",2,0],["حَفِظَ القَديمَ فَلَيسَ يَسبِقُهُ","أَحَدٌ إِلى التَعظيمِ لِلأَحَدِ",48,"د",1,0],["حُفِظَ القَريضُ فَما يُضَيَّعُ حَقُّهُ","أَبَداً وَأَنتَ لَهُ مِنَ العُشّاقِ",49,"ق",1,0],["حَفِظَ اللَهُ حَيثُ أَصبَحَ عَبدَ اللَ","هِ أَو حَيثُ أَصبَحَت أَوطانُه",50,"ن",2,0],["حِفاظاً وَلَو أَنَّ الإِداوَةَ تُشتَرى","غَلَت فَوقَ أَثمانٍ عِظامِ المَغارِمِ",51,"م",1,0],["حُفَّ برزْقٍ ربَّما","أردى الذي منه رُزِقْ",52,"ق",1,0],["حُفَرٌ مُسَتَّرَةٌ عَلَي","هِنَّ الجَنادِلُ وَالكَئيبُ",53,"ب",1,0],["حَفِظتُ لَكُم عَهدي عَلى القُربِ وَالنَوى","وَما ضَلَّ قَلبي في هَواكُم وَما غَوى",54,"غ",3,0],["حفظتُ الدُّمَى لهوى دُمْيَةٍ","ويُحْفَظُ للبيتِ كلّ القَصيدِ",55,"د",1,0],["حَفِظَ اللَهُ لي صَحيحَ هَواهُ","وَكَفاني مِن حُبِّهِ ما أَهَمّا",56,"م",2,0],["حَفِظَ اللَهُ حَيثُ يَمَّمَ إِسما","عيلُ وَليَسقِهِ مِنَ الغَيثِ ساقِ",57,"ق",1,0],["حِفَاظَاً وَإِشْفَاقَاً عَلَى مُتَرَحِّلٍ","خَلَتْ أَرْبُعٌ مِنْ شَخْصِهِ وَمَغَانِي",58,"ن",2,0],["حفظْتُ منَ الهوى قلبي زماناً","ولمْ أعلمْ بأنَّك في الكمينِ",59,"ن",1,0],["حَفَّت بِدَوحَتِها مَجَرَّةُ جَدوَلٍ","نَثَرَت عَلَيهِ نُجومَها الأَزهارُ",60,"ر",1,0],["حفظنا لك الآثار جما رفيفها","تجف الليالي وهي مخضرة تندى",61,"د",2,0],["حَفِظَتْ على الإسلامِ يَانِعَ غرسِه","والجاهليّةُ بالقَواضبِ تُحْصَدُ",62,"د",1,0],["حَفِظَ المحارمَ والحُقوقَ لأهلِها","وَحَمى مقاتِلَها فَنِعمَ الحامي",63,"م",2,0],["حَفِظُوا التُّراثَ لكم وصانوا عِرْضَكم","أَفَتكرهون لِعِرْضِكم أن يَسْلَما",64,"م",2,0],["حَفِظَ الإِلهُ بِلادَكم وأعزَّها","عَلَمٌ على أرجائها مَنشورُ",65,"ر",1,0],["حَفِظوا القُرآنَ فينا","وَرَعَوْهُ مُخْلِصِينا",66,"ن",2,0],["حُفَرٌ تموتُ بها القُوى ومنازلٌ","تَقرِى الترابَ نَضارةَ الزُوّارِ",67,"ر",1,0],["حَفِظنا حُرمةَ الأبناءِ فيها","وأكرمنا الأبوّةَ والجُدودا",68,"د",2,0],["حفاوةُ قومِنا وقِرى ذَوينا","وعَطفُ الأُخوةِ المتودِّدينا",69,"ن",2,0],["حَفِظنا العهدَ غيرَ مُذمَّمينا","وأدَّيْنا الأمانةَ مُحسِنينا",69,"ن",2,0],["حَفِظناها لِمِصرَ وَأَيُّ شَعبٍ","إِذا ضاعَت مَحارِمُهُ يَسودُ",70,"د",1,0],["حَفِظتُ لَها عَهدَينِ عَهدَ شَبيبَةٍ","تَصَرَّمَتِ اللَذّاتُ لَمّا تَصَرَّما",71,"م",2,0],["حَفِيٍّ بدينِ اللهِ يَمنعُ حَوْضَهُ","ويكفِيهِ أضغانَ العَدوِّ المُشَاغِبِ",72,"ب",1,0],["حَفَّت بِنورِ أَبي عَلِيٍّ عِصمَةٌ","لَو جاوَرَت شَمسَ الضُحى لَم تُكسَفِ",73,"ف",1,0],["حَفِظتَ لِلحافِظِ المَرحومِ سيرَتَهُ","وَالأَصلُ إِن طابَ طابَت عَنهُ أَفرُعُهُ",74,"ع",2,0],["حُفَّت مَصانِعُها الأَنيقَةُ بِالعِدا","فَتَرى بِساحَةِ كُلِّ قَصرٍ قَيصَرا",75,"ر",2,0],["حَفَرتُها جَوفاءَ مَنقورَةً","في دَمِثٍ سَهلٍ وَطيءَ التُراب",76,"ب",1,1],["حَفَر البِئْرَ جَهَّزَ الجَيْشَ أهْدَى الْ","هَدْيَ لما أنْ صَدَّهُ الأعْداءُ",77,"ا",2,0],["حُفّتْ بِهِ شُفعاؤهمْ واستَمطَرُوا","مِنْ جانِبَيهِ سَحائبَ الغُفرانِ",78,"ن",1,0],["حُفَّ مأثورُهُ بمَجْدٍ وفَخْرٍ","أغنَيَا فيه عن لَجاجٍ ومَحْك",79,"ك",1,0],["حَفّوا براياتِ المُعِزِّ ومَن بهِ","تَسْتَبشِرُ الأملاكُ والأقطار",80,"ر",1,0],["حِفظُ وَصايا عَن أَبٍ لَم تَشُب","مَعروفَهُ في الناسِ أَكدارُ",81,"ر",1,0],["حَفَرتُم صَخراً وَأَنبَطتُمُ","ماءً فَهَلّا العِلمَ تَستَنبِطون",82,"ن",1,0],["حَفظْتَ المُسْلِمِينَ وقَدْ تَوالَتْ","سَحائِبُ تَحْمِلُ النُّوَبَ الثِّقالا",83,"ل",2,0],["حفرت بئراً لِنَفسي","في غيضة وطويت",84,"ت",1,0],["حفظ اللَه دولة العلم دَهراً","من زوال نخافه وانقراض",85,"ض",1,0],["حفِظتْ لوَالداكَ الصنيعَ المجتبى","ورَعَتْ فتاةُ البرِّ في الأولادِ",86,"د",1,0],["حَفَّت بِهِنَّ مَناصِلٌ وَذَوابِلٌ","وَمَشَت بِهِنَّ ذَوامِلٌ وَنَواجي",87,"ي",1,0],["حُفَاةٌ عُرَاةٌ غَيْرَ أَخْلاقِ صُدْرَةٍ","تَطِيرُ كَنَسْجِ الْعَنْكَبُوتِ الْمُسَدَّفِ",88,"ف",1,0],["حَفِيتُ لَهُ بِالْوُدِّ مِنِّي وَكَيْفَ لا","أُسَابِقُهُ فِي وُدِّهِ وَهْوَ بِي حَفِي",88,"ف",2,0],["حَفَّتْ بِهَا الجَنَّاتُ وَالنُّعْمَى بِهَا","مَاذا ترَكنَ لِزَاهِدٍ أَوْ مُتَّقِ",89,"ق",1,0],["حَفِظَ الوَصَايَا وَاسْتَقَامَ بِدَينِهِ","وَلَهُ عنِ الخُطَطِ المُرِيبَةِ وَازِعُ",90,"ع",1,0],["حَفِظَ اللّهُ مُقْلَتيْكَ وَأَقْصَى","عَنْهُمَا كُلَّ طَارِيءٍ مَحْذُورِ",91,"ر",1,0],["حَفِظْتُ لهُ عَهْدِي وَلَوْ بَانَ مَقْتَلِي","لِدَهْرٍ بِهِ جَدُّ المُرُوءَةِ كَابِي",92,"ب",2,0],["حَفْلٌ يُكَرِّمُهُ وَلاَ","دَخَلٌ هُنَاكَ وَلاَ ارْتِيَا