{"poems":[[88,"سلام على الإسلام بعد محمد","https://www.aldiwan.net/poem10494.html","الطويل"],[88,"أقصر الزعفران لأنت قصر","https://www.aldiwan.net/poem68902.html","الوافر"],[75,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[74,"كذا أبدا تزهى العلى بجلالها","https://www.aldiwan.net/poem20460.html","الطويل"],[53,"عبيد اللّه عبد الله","https://www.aldiwan.net/poem61864.html","مجزوء الوافر"],[87,"رأى فيه عيبا وإن لم نجد","https://www.aldiwan.net/poem6951.html","المتقارب"],[68,"رأى فرسي إسطبل موسى فقال لي","https://www.aldiwan.net/poem38782.html","الطويل"],[107,"تجدد من ذكراك للشرق مأتما","https://www.aldiwan.net/poem42110.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54972","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55153","المنسرح"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54262","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54231","الطويل"],[119,"بعزم امير المؤمنين ابي بكر","https://www.aldiwan.net/poem41100.html","عموديه"],[146,"إذا نثر الناس الهرقلية الصفرا","https://www.aldiwan.net/poem58435.html","الطويل"],[164,"أتم سرور يرى الوالد الابنا","https://www.aldiwan.net/poem58924.html","الطويل"],[308,"قلبي سلا عنه برغم الهوى","https://www.aldiwan.net/poem58101.html","السريع"],[325,"رأي فحب فرام الوصل فامتنعوا","https://www.aldiwan.net/poem61719.html","البسيط"],[325,"رأى فحب فرام الوصل فامتنعوا","https://www.aldiwan.net/poem67094.html","البسيط"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[454,"هو الدين","https://www.aldiwan.net/poem977.html",""],[454,"سؤال إلى صلاح الدين الأيوبي","https://www.aldiwan.net/poem997.html",""],[463,"صحا القلب لكن صبوة وحنين","https://www.aldiwan.net/poem55824.html","الطويل"],[463,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[591,"للعاشقين بأحكام الغرام رضا","https://www.aldiwan.net/poem17576.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122565","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48801","المتقارب"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50012","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111894","البسيط"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114777","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89545","الطويل"],[2309,"","https://poetry.dctabudhabi.ae/diwan/poem/140201",""],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100898","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202736","الوافر"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100814","البسيط"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121871","الوافر"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121790","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26112","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62851","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62813","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126977","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86339","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92376","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111460","الطويل"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17771","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125816","الطويل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/198880","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90934","البسيط"],[4348,"","https://poetry.dctabudhabi.ae/diwan/poem/198557","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120320","السريع"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52163","الوافر"],[4578,"تذكرت شرقيّ الحمى من أحبه","https://www.poetsgate.com/ViewPoem.aspx?id=49354",""],[5206,"الجاهل والعارف","https://www.poetsgate.com/ViewPoem.aspx?id=187359",""],[5464,"طرقنا بابكم فأجاب صمت","https://www.poetsgate.com/ViewPoem.aspx?id=6677",""],[6134,"للعاشقين بأحكام الغرام رضا","https://www.poetsgate.com/ViewPoem.aspx?id=169530",""],[6167,"غيوم السماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85553&r=&rc=36",""],[463,"صحا القلبُ لكن صبوة ٌ وحنينُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60264&r=&rc=320",""],[454,"هو الدين ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82679&r=&rc=43",""]],"verses":[["رَأى في لَياليكِ المُنَجِّمُ ما رَأى","فَأَنذَرَنا بِالوَيلِ وَالعَثَراتِ",0,"ت",1,0],["رَأى فيكَ المُعِزُّ زَمانَ أَعلى","قَواعِدَهُ عَلى ظَهرِ الأَديمِ",1,"م",1,0],["رَأى في اِختِصاصي مارَأَيتَ وَزادَني","مَزِيَّةَ زُلفى مِن نَتائِجِها الفَخرُ",2,"ر",1,0],["رأى فضله أن يجعل الحال بيننا","فوضع الندى منه ووضع الدعا منَّا",3,"ن",2,0],["رأى فيه شمائله","ففضَّله على ولدِهْ",4,"د",2,0],["رأى فيه عيبا وإن لم نجد","على اللحم عيبا سوى قلته",5,"ت",2,1],["رَأى فَرَسي إِسطَبلَ موسى فَقالَ لي","قِفا نَبكِ مِن ذِكرى حَبيبٍ وَمَنزِلِ",6,"ل",1,1],["رأى فتنةَ الأحزابِ تَعتصرُ القُوى","فشَمَّر يسقيها الحِفاظَ المُسمَّما",7,"م",2,0],["رَأَى فِي تَمَادِيهِنَّ قَوْمٌ تَهَوُّساً","وَبِالْعَقْلِ طُرّاً بَعْضُ هَذَا التهَوُّسِ",8,"س",1,0],["رَائِفُ زَيْنُ الشَّبَابِ حَسْبُكَ أَنْ","أَحْرزْتَ مَا لَمْ يُحْرِزْ فَتًى قَبلاَ",9,"ل",2,0],["رأى فيه رَضْوَى مثلَه في ثباتِه","وحيَّاه من رَحبِ البقيعِ جَنَاب",10,"ب",1,0],["رَأَى فِيكَ هَذَا الشَّعْبُ آمَالَهُ الّتي","تَمَنَّى عَلَى الأيامِ وَهْيَ تُمَاطِلُهْ",11,"ل",2,0],["رأى في اسارى بدر اذ ذاك رأيه","فوافق حكم النص رأي ابي بكر",12,"ر",1,0],["رأى فيك ما يهواه مجدا وسؤددا","فما كنت إلا في مجالسه صدرا",13,"ر",2,0],["رأى فيه طفلاً كلما كان جدهُ","يرى في ابنه من نحيلتهِ الحسنى",14,"ن",2,0],["رأى فؤادي تائها في الهوى","فمن بالسلوى على قلبي",15,"ب",2,0],["رَأيٌ فَحُبٌّ فَرامَ الوَصلَ فَاِمتَنَعوا","فَهامَ عِشقاً فَأَمسى جِسمُهُ حَرضا",16,"ض",2,1],["رَأى فَحَبَّ فَرامَ الوَصلَ فَاِمتَنِعوا","فَهامَ عِشقاً فاضَني جِسمُهُ فَنِضا",17,"ض",2,1],["رأى فتنةً من بناتِ الخدورِ","فما زال بالطير حتى انطلَق",18,"ق",1,0],["رأى في ثناياها جواداً وفارس","تسنم مجداً شامخاً وتأملا",19,"ل",2,0],["رأى في الحق غايته فهانت","عليه النفس طوعا وانصياعا",20,"ع",2,0],["رأى فضلَها للسابقين فبذَّهم","جِماحا وجَارَى السابقاتِ حَرونُ",21,"ن",1,0],["رأى فضلي فقدَّمَنِي وأُولَى","غرائسِ ما تَروْن اليومَ يجَني",22,"ن",2,0],["رَأَى فَحبَّ فَسامَ الوَصْلَ فامْتَنَعُوا","فَرامَ صَبْراً فأَعْيَا نَيْلُهُ فَقَضَى",23,"ض",2,0],["رأى في النَّوحِ راحتَه فَناحا","وضاقَ بِسِرِّهِ ذَرعاً فباحا",24,"ح",2,1],["رأى في الشقاق تعلاته","فصار الشقاق له ديدنا",25,"ن",2,0],["رآى فيكَ من آرائه مايُسرّهُ","كأحسن ماقرّت به عيْنُ ذي نَسلِ",26,"ل",1,0],["رأي فحبَّ فرامَ الوصلَ فامثنعوا","فسامَ صبراً فأَعيا نيلهُ فقضى",27,"ض",2,0],["رأى فطناً أبدت له عن نجاره","وكانَ لنبعٍ فاستحالَ لأثأبِ",28,"ب",1,0],["رَأى فيهِ سُلطانُ المُلوكِ وَفَخرُها","مَخايِل مجدٍ حينَ ما ضمَّهُ المَهدُ",29,"د",1,0],["رأى في النوم أنه في جنان","يقطف الزهر وهو يجني القتادا",30,"د",2,0],["رأى فؤاداً فقال الفُلكُ صاعدةٌ","والأرضُ نابعةٌ والغيثُ منسجِم",31,"م",1,0],["رأى فيهِ لهُ شبْهاً وصحباً","وأَهلاً أبصروا فيه وليدا",32,"د",2,0],["رآى فحب فتاة من وصائفه","والحب من ملك يدعو الى العجب",33,"ب",1,0],["رأى في الكاس صب دم الحميا","فذر عله كافور الحباب",34,"ب",1,0],["رأَى في طريقِ الرُّشْد شَبَّتْ بهامَتِي","فأوْقَد فوق الرأسِ منِّي مَشَاعِلاَ",35,"ل",2,1],["رَأى فَرجَ يَربوعيَّةٍ غَيرَ طاهِرٍ","إِذا ما دَنا مِنهُ الذُبابُ تَقرطَبا",36,"ب",2,0],["رأَى في الرفقِ كيداً لم يروهُ","وكانَ الرفقُ أَدنى للسَّدَادِ",37,"د",1,0],["رأى فارس الأملاك يوم حللته","منظّمة فوت العيونِ جنودُها",38,"د",3,0],["رأى في الحشا والعين مرعى ومورداً","فجنب عن ماء العذيب ورنده",39,"د",2,0],["رَأى فُؤادي حَبيبُ القَلبِ في وَلَهٍ","رَهنَ التَلظّي فَناداني أَيا صاحِ",40,"ح",1,0],["رأى فحبَّ فرام الوصلَ فامتنعوا","فسيم صبراً فأعيى نيلَه فقضى",41,"ض",2,0],["رأى في منامٍ أنهُ عن نبينا","يذبُّ فكانَ ما أتى به يحكُمُ",42,"م",1,0],["رَاَى فَبِأَعلَى الصَّوتِ صاحَ بِأُوذِسٍ","إِلى أَينَ يا ذا المَكرِ جُبناً أَرى تُرَد",43,"د",1,0],["رَأَى فَجرى يَلقى الصُّدُورَ مُدَجَّجاً","فَضاقت بِهِم عَن مُلتَقاهُ المَعَابِرُ",44,"ر",1,0],["رَأى في المَطايا ذاتَ أَشعُبَ تامِكٍ","فَكاسَت بِرِجلٍ في المُناخِ عَقيرِ",45,"ر",1,0],["رأى في إيران الليثَ يحمل سيفه","وما هاب أسدَ الغرب يدوي زئيرها",46,"ر",3,0],["رأى فيك مقداما وبانيَ نهضة","وحمّال أعباءٍ إذا أطبق الجهد",47,"د",1,0],["رأى فحب فرام الوصل فامتنعوا","وبان من بعدهم عيش الصفا ومضى",48,"ض",2,0],["رأى في جفوني دمعها جامد الهوى","ففاضت على الإسعاد منه جفون",49,"ن",1,0],["رأى فؤادا للصدارة مثل","الروح للجسم وذاك السداد",50,"د",1,0],["رأى فأجادَها صُوَراً ومعنىً","وأُستاذي أَجَادَ وما رآها",51,"ا",3,0],["رأى فيض جفني واجباً شرع حبهم","فأمسى له فرضٌ بخدي ندبه",52,"ب",2,0],["رَأَى فِي مَرَائِي الكَشْفِ نُورًا بِهِ رَبَا","حَقَايِقُ سِرِّ السِّرِّ فيهِ رُبَىً رَبِي",53,"ي",1,0],["رأى فيها ب\"بندَةَ\" خلفَ سترٍ","صباحاً تحتَ داجيةٍ يُقيمُ",54,"م",1,0],["رأى فحب فرام الوصل فامتنعوا","فما ابتغى بدلاً منهم ولا عوضا",55,"ض",2,0],["رأَى في الأَصيلِ احمرارَكِ غَضْبَى","فجاشَتْ بِه لوعةٌ من دُناهْ",56,"ا",2,0],["رأى فضلها للسابقين فبدَّهم","جماحا وجارى السابقاتِ حرونُ",57,"ن",1,0],["رأى في ثناياها جواداً وفارساً","تسنم مجداً شامخاً وتأملا",58,"ل",2,0]]}