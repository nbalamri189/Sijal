مجتث"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74030","الرجز"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48405","الوافر"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45810","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91591","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91428","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117997","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85155","المجتث"],[3837,"","https://poetry.dctabudhabi.ae/diwan/poem/114697","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114208","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77057","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127350","السريع"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127223","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136653",""],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132200","المنسرح"],[557,"في عينيك عنواني","https://www.poetsgate.com/ViewPoem.aspx?id=7677",""],[5135,"الشعر مشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=202684",""],[5136,"يا سادتي هذه روحي تصافحكم","https://www.poetsgate.com/ViewPoem.aspx?id=121733",""],[5183,"مبعث الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=180278",""],[5200,"أبصرته غدوة سطيحا","https://www.poetsgate.com/ViewPoem.aspx?id=200801",""],[5277,"صرخةُ العراقيين","https://www.poetsgate.com/ViewPoem.aspx?id=199841",""],[5638,"فلتفخري مصرُ","https://www.poetsgate.com/ViewPoem.aspx?id=198248",""],[5703,"ستبقى أميراً","https://www.poetsgate.com/ViewPoem.aspx?id=214518",""],[5942,"بغداد. يا لغة الدنيا وجنتها","https://www.poetsgate.com/ViewPoem.aspx?id=215593",""],[6164,"أيها الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66015&r=&rc=25",""]],"verses":[["فَقُلتُ هَيهاتَ فاتَ السَمعُ لائِمَه","لا يُفهَمُ الحُزنُ إِلّا يَومَ عاشورِ",0,"ر",1,0],["فَقُلتُ هَذا لِأَيِّ عَينٍ","فَقالَ هَذا لِعَينِ ظَهري",1,"ي",1,0],["فَقُلتُ هَذي حُجَّةٌ ضَعيفَه","وَغِرَّةٌ ظاهِرَةٌ مَعروفَه",2,"ه",1,0],["فقلتُ هذي قدرةٌ يا ستَّنا","من قبلِ أن تمسُّها النار غلت",3,"ت",1,0],["فقلت هو البحر في فضله","فما ألتقيه سوى في السفينه",4,"ه",1,0],["فقلتْ هلّا توارت عنك محسنةً","فقال تخشى عقابَ اللَّهِ مولاها",5,"ا",3,0],["فقلت هو العضو لو فاتني","عدمت البسالة والسوره",6,"ر",2,0],["فقلت هو المهذب غيرَ أني","أراه كثير إرخاءِ الستور",7,"ر",1,0],["فَقُلتُ هُوَ اِمرُؤٌ يَهوى العُقارا","كَما يَهوى مُغازَلَةَ العَذارى",8,"ر",2,0],["فَقُلتُ هَل يَنفَعَنّي إِن حَضَرتُكُمُ","بِطاعَةٍ وَفُؤادٍ مِنكَ مَرعوبِ",9,"ب",1,0],["فَقُلتُ هِيَ الدارُ الَّتي لَيسَ غَيرُها","وَنافَستُ مِنها في غُرورٍ وَباطِلِ",10,"ل",1,0],["فَقُلتُ هَذا قُبولٌ جاءَني سَلَفاً","ما نالَهُ أَحَدٌ قَبلي مِنَ الأُمَمِ",11,"م",1,0],["فَقُلتُ هَلّا فَقالَ كَلّا","فَقُلتُ لِمَ لا فَقالَ إيهِ",12,"ي",2,0],["فَقُلتُ هَلّا رَأَيتَ صَيغَتَها","كَأَنَّها في الزُجاجِ تَلتَهِبُ",13,"ب",1,0],["فَقُلتُ هَذا نَرجِسٌ طالِعٌ","وَرَّدَ في العارِضِ وَالخَدِّ",14,"د",1,0],["فَقُلتُ هَل لَكَ في الصَهباءِ تَأخُذُها","مِن كَفِّ ذاتِ هَنٍ فَالعَيشُ مُقتَبِلُ",15,"ل",1,0],["فقلتُ هاكِ الأير فاستدخلي","فأدخلت لاميَ في صادِها",16,"د",3,0],["فقلتَ هذا استي ولم تحتشم","ميمتُها واسعةُ الداره",17,"ر",2,0],["فَقُلتُ هَمٌّ عَراني مِن أَخٍ سَبَقَت","بِهِ المَنايا كَريمِ العَهدِ مَودودِ",18,"د",1,0],["فقلت هاتوا دليلا","إن كنتم صادقينا",19,"ا",1,0],["فَقُلْتُ هَلْ مِنْ وِصَالٍ","يَكُونُ لِلْحُبِّ أُجْرَهْ",20,"ر",2,0],["فَقُلْتُ هَيْهَاتَ أَنْ أَبْغِي بِهَا بَدَلاً","لَمْ يَخْلُقِ اللهُ مِنْ قَلْبَيْنِ فِي جَسَدِ",21,"د",1,0],["فقلتُ هِيَ الفُصْحَى بِخَيرٍ وَإِنَّهَا","بأَمثالِ هَذَيْن الْحَفيَّيْنِ تَرْتَقي",22,"ق",2,0],["فقلت هذي أحاديثٌ ملفقة","موضوعة قد أتت من قول مختلق",23,"ق",1,0],["فَقُلتُها قولاَ عَلى اعتِذاريَ","فَليغفِر الزَّلَّةَ فِيها القاري",24,"ي",1,0],["فقلت هذا عجب","قامت به قدرة اللَه",25,"ل",2,0],["فقلتُ هيهاتِ مِقدارٌ جرى فَقضى","بما قَضَاهُ ولا رد لمقدارِ",26,"ر",1,0],["فَقُلْتُ هذَا اعْتِداءُ الدَّهْر عَاجَلَنِي","لِطُولِ مَطْلِكَ لِي فِي أَقْصَرِ الْعُمُرِ",27,"ر",1,0],["فقلتُ هما غصنان أَعْدِلُ فيهما","إذا جار ذو النجلين عَدْلَ ندى القطرِ",28,"ر",1,0],["فقلت هل بي يا قلب فيه","لعلني أطفئ الظما",29,"م",2,0],["فَقُلتُ هذي فُروقٌ إِن سَكنتِ بِها","سَكَنتِ يا نَفسُ أَرضاً لِلأَشدّاءِ",30,"ا",2,0],["فقلتُ هنيئاً للحَمامِ أمانُه","وإن كانتِ الأَيّامُ لم تُعطني أمنا",31,"ن",2,0],["فقلتُ هذا لفرطِ حُبِّي","قالتْ دع الترَّهاتِ باللهْ",32,"ل",2,0],["فقلت هو الدر الذي قد حشابه","أبومضر اذني تساقط من عيني",33,"ي",1,0],["فقلت هذا عجيب في بلادكم","أن ابن ستة عشرٍ يبلغ الهرما",34,"م",2,0],["فَقُلْتُ هذا الوَجْهُ عُذْ","رِي قالَ عُذْرٌ وَاضِحُ",35,"ح",1,0],["فقلتُ هما صِنْفانِ صِنْفٌ مَغارِمٌ","بها استَوجَبوا سَهْماً وصِنْفٌ مَفاقر",36,"ر",1,0],["فَقُلتُ هَل بَعدَكَ الأَيّامُ واسِعَةٌ","أَو لا فَقَد جاءَني ما ضَيَّقَ السُبُلا",37,"ل",2,0],["فقلت: هيَّا ارسمي روضاً ورابيةً","خضراءَ تُعْجبُ في تنسيقها النَّظَرا",38,"ر",2,0],["فقلت هل تجد الإِنصاف متبعاً","فقال والقلب بالنيران يضطرم",39,"م",1,0],["فقلت هبه مثلما قلته","مالك والتفتيش للمختفي",40,"ف",2,0],["فقلت هل حلّ للصب المتيم إن","يقبّل الثغر قالت حل في عنقي",41,"ق",2,0],["فَقُلتُ هَذا هَولي مَذهَبٌ","فَخَلِّني ماءً وَكُن صَخرا",42,"ر",2,0],["فقلت هذا عجيب","قالت واللّه خرق",43,"ق",1,0],["فقلت هذا فضول","في حق أهل الفضول",44,"ل",1,0],["فقلتُ هو العمر إذن ظنُّه بأن","نني بتُّ خالياً فأمّ جفونيهْ",45,"ي",2,0],["فقلت هل أفقر الوادي أم افتقر النادي","أم انحل ذاك الكرب والكرب",46,"ب",1,0],["فَقلتُ هَوِّن فما في الأمرِ مِن حَرَجٍ","عَيشٌ بلا مِحَنٍ شَرٌّ مِنَ المِحَنِ",47,"ن",1,0],["فقلت هذي البرَاغِيث التي كثُرت","ماب الُها كَبُرَت في المطعم البلدي",48,"د",2,0],["فقلتُها طنانةً جودةً","لأَنه جاد فَلِمْ لا أُجيد",49,"د",1,0],["فَقُلْتُ هَذِي مُهْجَتِي وَالحَشَا","قَالَ انْظُروا بِالجَهْلِ كَيْفَ انْحَشَا",50,"ش",2,0],["فقلت هل ذاك يغني","وقد تحكم كربي",51,"ب",2,0],["فَقُلتُ هِلالُ الشَّهرِ مَن ذا لَهُ رَأى","وَيا لَيتما رائيهِ موسى وَهارونُ",52,"ن",1,0],["فقلت هذى أبرك الساعات","مشاهد الحسن تلك الذات",53,"ت",1,0],["فقلت هذا منزل أنيق","وأنه بنجعتي خليق",54,"ق",1,0],["فقلت هبوا بأن الحق هذا","فقلبي يمموا فيم اصطباري",55,"ي",1,0],["فقلتُ هذا وَ