"الطويل"],[576,"طراز غرامي في المحبة مذهب","https://www.aldiwan.net/poem2984.html","الطويل"],[576,"رأيت طرفك يوم البين حين همى","https://www.aldiwan.net/poem3020.html","البسيط"],[576,"أحسنتم إن تحسنوا في الفعل","https://www.aldiwan.net/poem3038.html","الرجز"],[576,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"],[586,"سرى ما بيننا سر الغيوب","https://www.aldiwan.net/poem1565.html",""]],"verses":[["وَمُذِ اِدَّرَعتَ عَطاءَهُ وَفِناءَهُ","أَرمي وَيَرميني الزَمانُ فَأَسلَمُ",0,"م",1,0],["وَمُذَكِّري رَحِماً مُعَنَّسَةً","كَالشَمسِ أَخلَقَ ضَوءَها الطَفَلُ",1,"ل",1,0],["وَمُذ أَذابوا ماءَ عَي","ني بِالأَسى ما جَمَدا",2,"د",2,0],["وَمُذ أَسخَطَكَ المَغرو","رُ ما قَرَّ عَلى الجَنبِ",3,"ب",1,0],["وَمُذ نَبَذَتها أُمُّها حَفِيَت بِها","حُنُواً وَضَمَّتها إِلى جَنبِها أُخرى",4,"ر",2,0],["وَمُذِ التَقَيْنَا بَاحَ لِي بِهُيَامِهِ","وَكَتَمْتُ سِرِّي فَاسْتَشَفَّ هُيامِي",5,"م",2,0],["ومذ نشرت سود الذوائب أولجت","نهار محيّاها يليل الذوائب",6,"ب",1,0],["ومذ عرضت للإبن منها الْتِفاتةٌ","أشارت إليه بامدامع أن قْم",7,"م",1,0],["ومذ قام ابن عبد اللّه فيهم","أقام لكلّ مَكْرُمة عمودا",8,"د",2,0],["وَمَذحجُ قَد رَأينَاهُم حَدِيثاً","لأَطفَال الاَذَاة مُرَشَّحِينَا",9,"ن",2,0],["ومذ آثرَت فيكَ الكواكب حكمها","صددت فما يرعى بجفنيَّ كوكب",10,"ب",1,0],["ومذ علقت منها بناني بعروةٍ","شدَدت لطرفِ القول فيه حزاما",11,"م",2,0],["وَمُذ كُنتُ لَم أَرضَ النَقيصَةَ شيمَتي","وَمِثلُكَ مَن يَأبى لِمِثلي وَيَأنَفُ",12,"ف",1,0],["ومذلّةَ الحقِّ الضَّعيفِ","وعِزَّةَ الظُّلْمِ القَديرْ",13,"ر",1,0],["ومذيق العقول في الغرب مما","عصر العُرب في السنين الخوالي",14,"ل",2,0],["وَمُذ مَضى مُضطَهدا وَالدُهم","أَصبَحَ بِالمُضطَهد اِهتم المَلا",15,"ا",1,0],["وَمُذ مَرَرتَ عَلى أَطوادِها قَرِعَت","مِنَ السُجودِ فَلا نَبتٌ عَلى القُنَنِ",16,"ن",1,0],["ومُذْقَةُ ظِلٍّ بين غُصْنَي أراكةٍ","وقد كادَ مِيزانُ النهارِ يميلُ",17,"ل",1,0],["وَمَذهَبُ حُبٍّ لَم أَجِد عَنهُ مَذهَباً","وَشاغِلُ بَثٍّ لَم أَجِد عَنهُ شاغِلا",18,"ل",2,0],["وَمَذاهِبٌ في المَكرُماتِ بِمِثلِها","يَتَبَيَّنُ المَفضولُ سَبقَ الفاضِلِ",19,"ل",1,0],["وَمَذحِجِيُّ النِجارِ وَالبَيتِ لَم يَق","عُد بِهِ يَومَ سُؤدُدٍ نَجرانُه",20,"ن",2,0],["وَمُذَكِّري بِكَريمِ شيمَتِكَ الَّذي","قَد كُنتُ أَعهَدُهُ مِنَ الفِتيانِ",21,"ن",1,0],["ومُذهَبَةِ الخُدودِ بجُلَّنارٍ","مُفَضَّضَةِ الثُّغور ِبأُقحوانِ",22,"ن",1,0],["ومذ حلفتموني أنني لا أذوقها","ولم يك مثلي في اليمين يمين",23,"ن",1,1],["وَمُذ رَجَعَت أَترابُهُ مِن وَداعِهِ","تَلَقّاهُ في أَكفانِهِ عَفوُ رَبِّهِ",24,"ب",2,0],["وَمُذ أَطفَأَ الشَمعَ النَسيمُ بِمَجلِسٍ","بِهِ نورُ شَمسِ الدينِ كَالشَمسِ ساطِعُ",25,"ع",1,1],["وَمُذ قَلَبَ الدَهرُ المِجَنَّ أَصابَني","صَبوراً عَلى حالٍ قَليلٍ صَبورُها",26,"ر",3,0],["وَمُذ أَنى الوَضعُ وَهوَ الرَّفعُ مَنزِلَةً","جاءَت بِرُوحٍ بِنُورِ اللَهِ مُتَّسِمِ",27,"م",1,0],["وَمُذ رَأى المُشرِكون الدّين قَد وضَحَت","سَماؤُهُ وَاِنجَلَت عَن صِمَّةِ الصِّمَمِ",27,"م",1,0],["ومذْ صحبْتُ سوى جنسي ضنيتُ به","والشَّمعُ لولا جوارُ النارِ لم يذبِ",28,"ب",1,0],["وَمَذعورَةٍ لَم تَدرِ مِمّا أَصابَها","أَيهلِكُ أَم يَبقى لِأَبنائِهِ الأَبُ",29,"ب",1,0],["وَمُذكِراتٍ لِجِنانِ الخُلدِ","لَطيفَةٍ ما إِن لَها مِن نَدِّ",30,"د",1,0],["ومُذْ كَرِهَ السُّلطَانُ خِدْمَتَهُم لَهُ","تَمَنَّى النَّصَارَى أنهم لم يُنَصَّرُوا",31,"ر",3,0],["ومُذْ هدانا إلى الإسلامِ مَبْعَثُه","دَهَى الشياطِينَ والأصْنامَ تَجْدِيلُ",32,"ل",1,0],["وَمُذْ غاضَ طُوفانُ العُلُومِ بِمَوتِهِ اسْ","تَوَى الفُلْكُ في ذَاكَ الضَّرِيحِ عَلَى الجُودِيِّ",33,"ي",1,0],["وَمَذهَبي في البَرايا كَونَهُم شِيَعاً","كَالثَلجِ وَالقارِ مِنهُ الجَونُ وَالحَلَك",34,"ك",1,0],["ومُذْ قال إنّ ابن اللئيمةِ شاعِرٌ","ذَوُو الجَهْلِ ماتَ الشّعْرُ والشّعَراء",35,"ر",3,0],["ومذقَةٌ كَطُرَّةِ الخَنِيْفِ","تَنْبُتُ بَين الزَّرْبِ والكَنيفِ",36,"ف",1,0],["ومذ نشرب سودَ الذوائبِ أولجت","نهار محياها بليل الذوائب",37,"ب",1,0],["وَمُذ كَشَفَ الفَصاد عَن زِندِهِ رَأى","مَحاسن الهتهُ فضلَّ عَن الرُشد",38,"د",1,1],["وَمُذ أَتاني بَريد القَلب يُخبِرُني","أَيقَنت أَني كَموسى وَهُوَ كَالخضر",39,"ر",1,0],["وَمُذ قالوا فُلان حم قُلنا","كُلوا مِن زادِهِ في الحال يَعرَق",40,"ق",1,1],["ومذ سرى لا الى ما رمت سارية","هدته منك الى ما رمته النذر",41,"ر",1,0],["ومذ طور حالي اليه اشتكي","اتاني يؤنبني بالبكا",42,"ك",2,0],["ومذ جذبته للهوى نفحة الصبا","فقد كاد رياها يطير بلبه",43,"ب",2,0],["ومذهبي الجود لا عن سمعة وريا","بل طبعي البذل والإذهاب للذهب",44,"ب",1,0],["ومذ أبصرت كسحاناً","بهم تتبرم الدرب",45,"ب",1,0],["ومذلَّ أهل الجَوْرِ با","لذرِبِ السنانِ القاطِر",46,"ر",1,0],["ومذ أتى الجنات أرخته","عريان أضحى في ثيابِ الجنانْ",47,"ن",1,0],["وَمُذ أَرَياني ناصِرَ الدَولَةِ اِنجَلى","بِرُؤياهُ ما أَخشى وَما أَتَرَقَّبُ",48,"ب",1,0],["وَمُذ دَعاكَ إِمامُ العَصرِ عُدَّتَهُ","عادَت سِراعاً عَلى أَعقابِها النُوَبُ",49,"ب",1,0],["وَمُذ شاعَ في مِصرٍ وُصولُكَ سالِماً","فَفيها لِمَن يَحتَلُّها عيشَةٌ رَغدُ",50,"د",1,0],["وَمُذ حَلَلتَ بِهَذا الشامِ تَكلَؤُهُ","فَقَد عَدا الدَهرُ فيهِ أَن يُقالَ عَدا",51,"د",2,0],["وَمُذ ذُدتَ عَن إِرثِ الإِمامَةِ مَن طَغى","بِسَيفِكَ أَضحى رَوضَةً لَيسَ تُرتَعا",52,"ع",2,0],["وَمُذ فَشا خَبَرُ التَبريزِ ما اِجتَمَعوا","فَهَل ضَرَبتَ طُلىً بِالقاعِ أَو خِيَما",53,"م",2,0],["وَمُذ وَصَلَت تاجَ المُلوكِ أَنَختُها","بِأَرفَعِهِم بَيتاً وَأَمنَعِهِم حِما",54,"م",2,0],["وَمُذ عَزَزتَ فَشَعبُ الإِفكِ مُنصَدِعٌ","في كُلِّ أَرضٍ وَشَعبُ الحَقِّ مُلتَئِمُ",55,"م",1,0],["وَمُذ دَعاكَ إِمامُ العَصرِ عُدَّتَهُ","ذَلَّ العِدى فَأَزالَ الحَقُّ إِفكَهُمُ",56,"م",1,0],["وَمُذ رَأَيتُكَ تولي العَفوَ كافِرَهُ","عَلِمتُ أَنَّكَ بِالإِنعامِ تَنتَقِمُ",56,"م",1,0],["وَمُذ عَقَلتُ المُنى وَالعيسَ في حَلَبٍ","حَلَلتُ آمَنَ أَرضِ اللَهِ سُكّانا",57,"ن",2,0],["ومذ زها ورد خديها بوجنتها","تكدرت في المآقي حمرة الشفق",58,"ق",1,0],["ومُذ أَعلقتْني الأربعونَ حِبالَها","تراءَتْ لعيني الأرضُ كِفّةَ حابِلٍ",59,"ل",1,0],["وَمُذ خَفِقَت راياتُهُ وَبُنُودُهُ","فَوَجهُ بِلادِ الشِّركِ بِالضَيمِ يُلطَمُ",60,"م",1,0],["وَمُذ سَلَكَت فرسانُهُ مِن دِيارِها","مَحارِمَها لَم يَبقَ لِلشِركِ مَحرَمُ",60,"م",1,0],["وَمذهبهُ لا مذهبٌ غير أنّه","يُجادلُ عَن أهوائِه الشهرَ والدَهرا",61,"ر",2,0],["وَمَذهبُهم حكمُ الدياناتِ واحدٌ","تَساوى بهِ الإسلامُ والمللُ الأخرى",61,"ر",2,0],["وَمُذ نَشَأَت طابَ الزمانُ كأنّما","بهِ نَشَرت في كلِّ ناحيةٍ عطرا",62,"ر",2,0],["ومذانبٌ زُرْقُ النطافِ تَرفُّ في","وَجناتهنَّ شقائقٌ وبنفسج",63,"ج",1,0],["ومذْ صحوتُ من ال","حبِّ إذ كواني كيّا",64,"ي",2,0],["ومذ بصفا قلبي سعى طائف الهوى","رمى بفؤادي جمرة بعد جمرة",65,"ه",1,0],["ومذ تاه الدليل وقد ظللنا","بليل ليس يهدى سالكوه",66,"و",2,1],["ومذ أنت والنصر اجتمعت تولدت","سعود فخلنا باجتماع تولدا",67,"د",2,0],["ومذ في سما الهيجا سيوفك ابرقت","فامطر منها الجفن والقلب ارعدا",67,"د",2,0],["ومذ رام بدر التم يحكيك طلعة","فبان به نقص ولازمه الكلف",68,"ف",1,0],["ومذ تغّيبتَ أمسى","قذىً بعين المشوق",69,"ق",1,0],["وَمُذ جَلا عَنّيَ الغَمامُ","رَأَيتُ في قَعرِهِ شَبَح",70,"ح",1,0],["ومُذْكرةٍ ريحَ الحبيب بريحها","وحاكية خدَّيه لي باحمرارها",71,"ه",2,1],["ومذهبنا الوسطى هي العصر فاستفد","مسائل خمساً من فروع تفرّع",72,"ع",1,0],["ومذ حملت بدا في وجه آمنة ال","أنوار وهي لثقل الحمل لا تجد",73,"د",1,0],["وَمُذ خَبَّروني أَنَّ غُصناً قَوامُهُ","تَيَقَّنتُ أَنَّ القَلبَ مِنّي طائِرُ",74,"ر",1,0],["وَمُذ وَرَدنا بَحرَ إِحسانِكِ ال","زاخِرِ لَم نظمأ وَلَم نَعطَشِ",75,"ش",1,0],["وَمُذَمَّمٍ جَادَتْ يَدَاهُ بِعِرْضِهِ","إِذْ ضَنَّ مِمَّا قَدْ حَوَاهُ بِقَمْشِهِ",76,"ش",2,0],["ومذ توصَّلت أو وَصلتُ إلى","بابك لم أفتقر إلى أحدٍ",77,"د",1,0],["ومذ كسرت أجفانها قلت هذه ال","لتي فوقت من خفض طرف الهوى سهمي",78,"م",2,0],["ومذ كان منّي في جِنان الجَنان من","صفا خَلَدي بوّأتُه جنّة الخلد",79,"د",1,0],["ومذ رأى صحبي القطوفَ الدانيهْ","ناديت هاؤمُ اقرأوا كتابيهْ",80,"ه",1,0],["ومذ بدا في الأحم الجعد مفرقها","ازددت بالليل إيمانا وبالفلق",81,"ق",1,0],["ومذ صرت كالأبريز اخلص سبكه","فما ساءني اني اباع واشتري",82,"ر",2,0],["وَمَذْهَبٌ ما زالَ مُسْتَقْبحاً","فِي الْحَرْبِ أَنْ يُقْتَلَ مُسْتَسْلِمُ",83,"م",1,0],["وَمُذ سُمِّيَت شَمسُ النهارِ غَزالَةً","تَمَنَّت مَغيباً خيفَةً مِنهُ بِالغابِ",84,"ب",1,0],["وَمذْ أَسوتِ جراحَ البائسين لقدْ","أسقطتُ دعوايَ في قلبٍ بكِ انفطرا",85,"ر",2,0],["وَمذْ وَقفتْ عليك العي","نُ في جمعٍ بناديكِ",86,"ك",1,0],["وَمذْ تَمَّ الزواجُ مضى حميداً","فودعنا المهابةَ والوقارا",87,"ر",2,0],["ومذ وعت أذني معنى بلاغته","علمت كخيف مقر الدر في الصدف",88,"ف",1,0],["ومذ خفت ضيق السبل في طلب الغنى","رتعت بأمن في مروت مروتي",89,"ي",1,0],["وَمُذ أَعربا عَن ظهرِ قلبٍ فَأغربا","أقرّت بفضلِ العربِ في العلم عجمهُ",90,"م",2,0],["وَمُذ حلّ بِالشهرِ الحرامِ بأوجهٍ","غدا حرماً لا صرف دهر يبزّهُ",91,"ز",2,0],["وَمُذ تَعانَقنا وَقَبَّلتُهُ","عَدَدتُ لِلسَبعِ بِغَيرِ اِتِيابِ",92,"ب",1,0],["وَمُذ فُصِّلَت وَأُغمِضَتِ الجُفونُ عَلى","قَذى الضِرارِ بِلا شَكوى وَلا جَدَلِ",93,"ل",1,0],["وَمُذْ رآني يَتيماً تَحتَ رايتِكُم","فَمَا نَوَى ليَّ شَرّاً مِن نوائبهِ",94,"ب",2,0],["وَمُذْ شَكَتْ فَأَخُوهَا البَحْرُ مِن فَلَقٍ","يَلُوحُ قَبْلَ أَبِيبٍ فَوْقَهُ الزَّبَدُ",95,"د",1,0],["وَمُذْ تَشكَّى جَوْرَ أَرْدافهِ","أَشْفَقْتُ أَنْ أَدْعُو على ظالمِي",96,"ي",1,0],["وَمُذْ بُنَيتْ على الفَتحِ استمرَّتْ","عَليهِ ولا مُغيِّرَ لِلمَباني",97,"ن",2,0],["وَمُذ حَلَلتُ رَقيمَ الكَهفِ مِنهُ بِنَو","مي فيهِ لَم يُلفَ قَلبي غَيرَ مُنتَبِهِ",98,"ب",2,0],["وَمُذلَكُم أَضحى خَليلَ الهَوى","أَعادَ أَوثانَ الأَعادي جُذاذ",99,"ذ",1,0],["وَمُذ أَتى بِالخَلعِ طَو","عَ الأَمرِ مِنهُ ما اِحتَذى",100,"ذ",2,0],["وَمُذ شَهِجتُ الشَهرَ صِرتُ صائِمَ ال","دَهرِ وَإِفطارِيَ إِخراجُ الفِطَر",101,"ر",1,0],["وَمُذ أَوفى لَكَ التاريخ قُلنا","تَقبَّلَ حجَّكَ الرَبُّ الكَريمُ",102,"م",1,0],["وَمُذ أَرّختها كانَت بِخَير","حَوَت أَبيات تاريخي اِفتِخارا",103,"ر",2,0],["وَمُذ اِستَفاض الدَمع ذكر مَرابِعي","خاضَ العَواذل في حَديث مَدامِعي",104,"ي",1,0],["وَمُذ وَجَدتك تُبدي","لَفظا كدر منظم",105,"م",1,0],["ومُذْ دُعيتَ ظهيرَ الدّينِ صار حِمىً","إذا تَعرَّضَ للباغي تَحاشاه",106,"ا",2,0],["ومُذْ دُعيتَ كمالَ الدّولةِ اعتدلَتْ","برَأْيكَ المُنْتَضَى في الخَطْبِ سَيْفاه",106,"ا",2,0],["ومُذْ دُعيتَ جمالَ الملّةِ ابْتَهَجَتْ","بوَجْهِك المُدَّعي للبَدْرِ مَرْآه",106,"ا",2,0],["ومُذالٌ عليه غَيْرُ مُذالٍ","مُذْهَبٌ ساطعُ الشُّعاعِ مَصون",107,"ن",1,0],["ومُذْ خُلِقَتْ عينُ اللّيالي وفُتِّحَتْ","إلى الخَلْقِ لم تَعْلَقْ سِواك بإنْسان",108,"ن",1,0],["ومُذْ شاهدَتْ أطرافَ أقلامهِ القَنا","أَبَتْ خِيفةً إلاّ ارْتعادَ مُتون",109,"ن",1,0