{"poems":[[53,"لله ثم لك المحل الأعظم","https://www.aldiwan.net/poem29795.html","الكامل"],[53,"أمبلغي ما أطلب الغزل","https://www.aldiwan.net/poem29910.html","الكامل"],[53,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[53,"يد في قائم العضب","https://www.aldiwan.net/poem30764.html","الهزج"],[71,"ومملوكة عندي حديث نتاجها","https://www.aldiwan.net/poem3851.html","الطويل"],[93,"بلغت من عيشي أعز مرام","https://www.aldiwan.net/poem11394.html","الكامل"],[88,"سيوف لحاظ أم قسي حواجب","https://www.aldiwan.net/poem44401.html","الطويل"],[88,"رمت مسمعي ليلا بأنه مؤلم","https://www.aldiwan.net/poem45022.html","الطويل"],[88,"عهدتك شاعر العرب المجيدا","https://www.aldiwan.net/poem45028.html","الوافر"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[72,"حجبت ولم أحسب سنا البدر يحجب","https://www.aldiwan.net/poem18243.html","الطويل"],[72,"تفهمه قلبي الشجي فهاما","https://www.aldiwan.net/poem19682.html","الطويل"],[70,"طريقتك المثلى أجل وأشرف","https://www.aldiwan.net/poem42807.html","الطويل"],[92,"كم من عهود عذبة","https://www.aldiwan.net/poem38946.html","مجزوء الكامل"],[85,"غال في قيمة أبن بطرس غالى","https://www.aldiwan.net/poem7128.html","الخفيف"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[43,"أفاضل الناس أغراض لذا الزمن","https://www.aldiwan.net/poem10587.html","البسيط"],[62,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[45,"أرى بين ملتف الأراك منازلا","https://www.aldiwan.net/poem65533.html","الطويل"],[45,"لو كان يعتب هاجر في واصل","https://www.aldiwan.net/poem65544.html","الكامل"],[45,"لاجديد الصبا ولا ريعانه","https://www.aldiwan.net/poem66799.html","البسيط"],[45,"ياصالح ابن الفضل إنك مخبري","https://www.aldiwan.net/poem66818.html","الكامل"],[61,"بلاني الحب فيك بما بلاني","https://www.aldiwan.net/poem51417.html","الوافر"],[66,"ومذ حلفتموني أنني لا أذوقها","https://www.aldiwan.net/poem38465.html","الطويل"],[66,"هو الدهر مغرى بالكريم وسلبه","https://www.aldiwan.net/poem40134.html","الطويل"],[66,"ومذ أطفأ الشمع النسيم بمجلس","https://www.aldiwan.net/poem40991.html","الطويل"],[66,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[69,"طول المقام بدار الحرث برح بي","https://www.aldiwan.net/poem29268.html","البسيط"],[105,"أرى الدم يجري في الكنانة دائبا","https://www.aldiwan.net/poem43132.html","الطويل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[67,"بقبة قبر الشافعي سفينة","https://www.aldiwan.net/poem18145.html","الطويل"],[46,"لو صح ماقال رسطاليس من قدم","https://www.aldiwan.net/poem23069.html","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16640","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67326","الرجز"],[88,"سيوف لحاظ أم قسي حواجب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19571&r=&rc=74",""]],"verses":[["وَمُذِ اِدَّرَعتَ عَطاءَهُ وَفِناءَهُ","أَرمي وَيَرميني الزَمانُ فَأَسلَمُ",0,"م",1,0],["وَمُذَكِّري رَحِماً مُعَنَّسَةً","كَالشَمسِ أَخلَقَ ضَوءَها الطَفَلُ",1,"ل",1,0],["وَمُذ أَذابوا ماءَ عَي","ني بِالأَسى ما جَمَدا",2,"د",2,0],["وَمُذ أَسخَطَكَ المَغرو","رُ ما قَرَّ عَلى الجَنبِ",3,"ب",1,0],["وَمُذ نَبَذَتها أُمُّها حَفِيَت بِها","حُنُواً وَضَمَّتها إِلى جَنبِها أُخرى",4,"ر",2,0],["وَمُذِ التَقَيْنَا بَاحَ لِي بِهُيَامِهِ","وَكَتَمْتُ سِرِّي فَاسْتَشَفَّ هُيامِي",5,"ي",1,0],["ومذ نشرت سود الذوائب أولجت","نهار محيّاها يليل الذوائب",6,"ب",1,0],["ومذ عرضت للإبن منها الْتِفاتةٌ","أشارت إليه بامدامع أن قْم",7,"م",1,0],["ومذ قام ابن عبد اللّه فيهم","أقام لكلّ مَكْرُمة عمودا",8,"د",2,0],["وَمَذحجُ قَد رَأينَاهُم حَدِيثاً","لأَطفَال الاَذَاة مُرَشَّحِينَا",9,"ن",2,0],["ومذ آثرَت فيكَ الكواكب حكمها","صددت فما يرعى بجفنيَّ كوكب",10,"ب",1,0],["ومذ علقت منها بناني بعروةٍ","شدَدت لطرفِ القول فيه حزاما",11,"م",2,0],["وَمُذ كُنتُ لَم أَرضَ النَقيصَةَ شيمَتي","وَمِثلُكَ مَن يَأبى لِمِثلي وَيَأنَفُ",12,"ف",1,0],["ومذلّةَ الحقِّ الضَّعيفِ","وعِزَّةَ الظُّلْمِ القَديرْ",13,"ر",1,0],["ومذيق العقول في الغرب مما","عصر العُرب في السنين الخوالي",14,"ل",2,0],["وَمُذ مَضى مُضطَهدا وَالدُهم","أَصبَحَ بِالمُضطَهد اِهتم المَلا",15,"ا",1,0],["وَمُذ مَرَرتَ عَلى أَطوادِها قَرِعَت","مِنَ السُجودِ فَلا نَبتٌ عَلى القُنَنِ",16,"ن",1,0],["ومُذْقَةُ ظِلٍّ بين غُصْنَي أراكةٍ","وقد كادَ مِيزانُ النهارِ يميلُ",17,"ل",1,0],["وَمَذهَبُ حُبٍّ لَم أَجِد عَنهُ مَذهَباً","وَشاغِلُ بَثٍّ لَم أَجِد عَنهُ شاغِلا",18,"ل",2,0],["وَمَذاهِبٌ في المَكرُماتِ بِمِثلِها","يَتَبَيَّنُ المَفضولُ سَبقَ الفاضِلِ",19,"ل",1,0],["وَمَذحِجِيُّ النِجارِ وَالبَيتِ لَم يَق","عُد بِهِ يَومَ سُؤدُدٍ نَجرانُه",20,"ن",2,0],["وَمُذَكِّري بِكَريمِ شيمَتِكَ الَّذي","قَد كُنتُ أَعهَدُهُ مِنَ الفِتيانِ",21,"ن",1,0],["ومُذهَبَةِ الخُدودِ بجُلَّنارٍ","مُفَضَّضَةِ الثُّغور ِبأُقحوانِ",22,"ن",1,0],["ومذ حلفتموني أنني لا أذوقها","ولم يك مثلي في اليمين يمين",23,"ن",1,1],["وَمُذ رَجَعَت أَترابُهُ مِن وَداعِهِ","تَلَقّاهُ في أَكفانِهِ عَفوُ رَبِّهِ",24,"ب",2,0],["وَمُذ أَطفَأَ الشَمعَ النَسيمُ بِمَجلِسٍ","بِهِ نورُ شَمسِ الدينِ كَالشَمسِ ساطِعُ",25,"ع",1,1],["وَمُذ قَلَبَ الدَهرُ المِجَنَّ أَصابَني","صَبوراً عَلى حالٍ قَليلٍ صَبورُها",26,"ر",3,0],["وَمُذ أَنى الوَضعُ وَهوَ الرَّفعُ مَنزِلَةً","جاءَت بِرُوحٍ بِنُورِ اللَهِ مُتَّسِمِ",27,"م",1,0],["وَمُذ رَأى المُشرِكون الدّين قَد وضَحَت","سَماؤُهُ وَاِنجَلَت عَن صِمَّةِ الصِّمَمِ",27,"م",1,0],["ومذْ صحبْتُ سوى جنسي ضنيتُ به","والشَّمعُ لولا جوارُ النارِ لم يذبِ",28,"ب",1,0],["وَمَذعورَةٍ لَم تَدرِ مِمّا أَصابَها","أَيهلِكُ أَم يَبقى لِأَبنائِهِ الأَبُ",29,"ب",1,0],["وَمُذكِراتٍ لِجِنانِ الخُلدِ","لَطيفَةٍ ما إِن لَها مِن نَدِّ",30,"د",1,0],["ومُذْ كَرِهَ السُّلطَانُ خِدْمَتَهُم لَهُ","تَمَنَّى النَّصَارَى أنهم لم يُنَصَّرُوا",31,"ر",3,0],["ومُذْ هدانا إلى الإسلامِ مَبْعَثُه","دَهَى الشياطِينَ والأصْنامَ تَجْدِيلُ",32,"ل",1,0],["وَمُذْ غاضَ طُوفانُ العُلُومِ بِمَوتِهِ اسْ","تَوَى الفُلْكُ في ذَاكَ الضَّرِيحِ عَلَى الجُودِيِّ",33,"ي",1,0],["وَمَذهَبي في البَرايا كَونَهُم شِيَعاً","كَالثَلجِ وَالقارِ مِنهُ الجَونُ وَالحَلَك",34,"ك",1,0],["ومُذْ قال إنّ ابن اللئيمةِ شاعِرٌ","ذَوُو الجَهْلِ ماتَ الشّعْرُ والشّعَراء",35,"ر",3,0],["ومذقَةٌ كَطُرَّةِ الخَنِيْفِ","تَنْبُتُ بَين الزَّرْبِ والكَنيفِ",36,"ف",1,0],["ومذ نشرب سودَ الذوائبِ أولجت","نهار محياها بليل الذوائب",37,"ب",1,0]]}