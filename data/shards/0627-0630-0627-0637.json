الطويل"],[461,"أرادت جوارا بالعراق فلم تطق","https://www.aldiwan.net/poem15094.html","الطويل"],[461,"أظلما ورمحي ناصري وحسامي","https://www.aldiwan.net/poem15100.html","الطويل"],[461,"يظن الهوى العذري وجدي بمجده","https://www.aldiwan.net/poem15650.html","الطويل"],[464,"أطاع فما إلى صبر سبيل","https://www.aldiwan.net/poem3168.html","عموديه"],[464,"شهيدا غرامي ادمعي وسجومها","https://www.aldiwan.net/poem3217.html","عموديه"],[464,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[468,"وخل يمد رواق الغنى","https://www.aldiwan.net/poem59867.html","المتقارب"],[468,"لنا صديق صادق الوعد","https://www.aldiwan.net/poem60217.html","السريع"],[477,"مغاني الهوى لم يبق إلا رسومها","https://www.aldiwan.net/poem15188.html","الطويل"],[493,"وليلة أوسعتني","https://www.aldiwan.net/poem67362.html","المجتث"],[500,"للروح من روح ريح الحب ريحان","https://www.aldiwan.net/poem37759.html","البسيط"],[515,"لئن قل صبر فالمصاب عظيم","https://www.aldiwan.net/poem12255.html","الطويل"],[527,"فإن ردني دهري عليك طريدة","https://www.aldiwan.net/poem45958.html","الطويل"],[529,"سلام على شيخ الفواطم عن يد","https://www.aldiwan.net/poem37386.html","الطويل"],[551,"ألا غاد دمع العين إن كنت غاديا","https://www.aldiwan.net/poem47140.html","الطويل"],[551,"أمالك من غرام ما أمالا","https://www.aldiwan.net/poem47319.html","الوافر"],[551,"من دلني اليوم على صاحب","https://www.aldiwan.net/poem47386.html","السريع"],[551,"على مثل هذا اليوم تحنى الرواجب","https://www.aldiwan.net/poem48099.html","الطويل"],[553,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[562,"يا أيها القبر فيك الناس قد رقدوا","https://www.aldiwan.net/poem52822.html","البسيط"],[562,"ماذا شعوب بني عثمان تنتظر","https://www.aldiwan.net/poem52830.html","البسيط"],[562,"إذا طلع النهار أرى الرجالا","https://www.aldiwan.net/poem52866.html","البسيط"],[567,"أذابت قلبه الزفره","https://www.aldiwan.net/poem69677.html","مجزوء الرجز"],[567,"أناب فأعداني على ظلمه الدهر","https://www.aldiwan.net/poem69703.html","الطويل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"على كل حال ليس لي عنك مذهب","https://www.aldiwan.net/poem3109.html","الطويل"],[585,"عروس الكأس يجلوها نديمي","https://www.aldiwan.net/poem1566.html",""]],"verses":[["إِذا طُرِدَت رِماحُ اللَهوِ فيهِ","أَرَقنَ عَلى الكُؤوسِ دَمَ القِنانِ",0,"ن",1,0],["إِذا طَرَدوا في مَعرَكِ المَجدِ قَصَّفوا","رِماحَ العَطايا في صُدورِ المَكارِمِ",1,"م",1,0],["إِذا طَرَقَ الخَطبُ البَهيمُ عِيالَهُ","وَقَد مالَ عُنقُ الرَأيِ كُلَّ مَميلِ",2,"ل",1,0],["إِذا طَرِبوا لِلجودِ أَمطَرنَهُم حَياً","وَإِن غَضِبوا لِلمَجدِ هَيَّجتَهُم أُسدا",3,"د",2,0],["إِذا طَلَعَ الرَكبُ يَمَّمتُهُ","أُحَيّي الوُجوهَ كُهولاً وَمُردا",4,"د",2,0],["إِذا طَمِعَ الأَعداءُ فيها أَجارَها","وَأَرتَعَها بَينَ العَوالي وَأَورَدا",5,"د",2,0],["إِذا طَرَدوها خالَفَت بِرِقابِها","رُجوعاً إِلى أَوطانِها وَالمَسارِحِ",6,"ح",1,0],["إِذا طَرَحوا عِمّاتِهِم وَضَحَت لَهُم","مَفارِقُ لَم يَعصِب بِها العارَ لائِثُ",7,"ث",1,0],["إِذا طَبَعَ الآراءَ ما طَلَ غَربَها","فَلَم يُمضِها إِلّا بِإِذنِ العَواقِبِ",8,"ب",1,0],["إِذا طَلَبوا الأَعداءَ كانوا نَغيضَةً","لِيَومِ الوَغى مِن قَبلِ جَرِّ الكَتائِبِ",8,"ب",1,0],["إِذا طَلَعَت نَجداً أَضاءَت وُجوهُها","وَقُدّامَها مِن سائِقِ النَقعِ غَيهَبُ",9,"ب",1,0],["إِذا طاوَعَ المِقدارُ لَم نَحمَدِ الغِنَى","وَلَسنا نَذُمُّ الدَّهرَ حينَ يُعاصي",10,"ي",1,0],["إِذا طَرَق الرَّكْبُ العِراقيُّ أرْضَها","بِحَيْثُ تُظِلُّ السُّمْرُ مُقْرَبَةً جُرْدا",11,"د",2,0],["إذا طاشَتِ الأحْلامُ واسْتَرْخَتِ الحُبا","تفيّأَتِ الآراءُ ظِلَّ وَقارِهِ",12,"ر",2,0],["إذا طالَعَتنا منْ قُرَيْشٍ عِصابَةٌ","وشافَهْنَ من أعلامِ مَكَّتِها هَضْبا",13,"ب",2,0],["إِذا طولِبوا يَوماً إِلى الغَزوِ شَمَّرو","وَإِن نُدِبوا يَوماً إِلى غارَةٍ جَدّوا",14,"د",3,0],["إِذا طَلَعَت شَمسُ النَهارِ فَسَلِّمي","فَآيَةُ تَسليمي عَلَيكِ طُلوعُها",15,"ع",3,1],["إِذا طَمَعٌ يَحِنُّ بِقَلبِ عَبدٍ","عَلَتهُ مَهانَةٌ وَعَلاهُ هونُ",16,"ن",1,0],["إذا طُوِيَ الإثْراءُ لي في تملُّقٍ","رضِيتُ بعِزِّ النّفْسِ في عِزِّ إمْلاقِ",17,"ق",1,0],["إِذَا طَلعَتْ مُفْتَرَّةً فِي سُعُودِهَا","تُبشِّرُ أَحْكَامُ السُّرورِ بِمَا تَقْضِي",18,"ي",1,0],["إِذا طَمعٌ كَسا غَيري ثِياباً","يذِلُّ بِها كَساني العزَّ ياسُ",19,"س",1,0],["إِذا طافَ بِالراحِ المُديرِ عَلَيهِمُ","أَطافَ بِهِ بيضُ الوُجوهِ كِرامُ",20,"م",1,0],["إِذا طَلَبوا أَعلى المَكارِم أَدرَكوا","بِما أَدرَكَت أَحسابُ قَومٍ وَدينها",21,"ن",3,0],["إِذا طَيِّبِ الأَثوابِ قَد أُلهِمَ التُقى","هِجانِ البَنينِ يَعتَريهِ المُعاقِلُ",22,"ل",1,0],["إِذا طُرِحَت لَم تَطَّبِ الكَلبَ رِيحُها","وَإِن وُضِعَت في مَجلِسِ القَومِ شُمَّتِ",23,"ت",1,0],["إذَا طُولِعَتْ لَمْ تَسْأَمِ الْعَيْنُ حُسْنَها","وَإِنْ أُنْشِدَتْ فَالسَّمْعُ هَيْهَاتَ يَسْأَمُ",24,"م",1,0],["إِذا طَرَفَت في مَربَعٍ بَكَراتُها","أَو اِستَأخَرَت عَنها الثِقالُ القَناعِسُ",25,"س",1,0],["إِذا طَرِبَ الحَمامُ حَمامُ نَجدٍ","نَعى جارَ الأَقارِعِ وَالحُتاتِ",26,"ت",1,0],["إذا طرق الأمر بالمغِلقا","ت يتْنا وضاق به المَهِلُ",27,"ل",1,1],["إذا طلع الخطّ رمّلته","فيا حبَّذا الرّمل والطالع",28,"ع",1,0],["إذا طلب الملك المؤيد معسرٌ","رأى بشره في وجهه كضمينه",29,"ن",2,0],["إذا طوى الأرض في كتائبِهِ","ثمَّ سقاها حيا مواهبهِ",30,"ه",1,0],["إذا طَرَفٌ من حبلك انحلّ عقدُهُ","تداعت وشيكاً بانتقاضٍ مرائرُهْ",31,"ه",1,0],["إذا طيِّئٌ عدت بُناة بِنائها","فحاتمها الباني وأنت المتبِّرُ",32,"ر",1,0],["إذا طال شكرٌ طولَ كفّيه مرةً","ثنى الطّوْل طلّاباً بتلك الطوائلِ",33,"ل",1,0],["إذا طاب لي عيشي تنغصتُ طيبه","بصدق يقيني أن سيذهبُ كالحُلمِ",34,"م",1,0],["إِذا طَعَنَت ريحُ الصَبا في فُروجِهِ","تَحَلَّبَ رَيّانُ الأَسافِلِ أَنجَلُ",35,"ل",1,0],["إِذا طَلَعَ العَيّوقُ وَالنَجمُ أَولَجَت","سَوالِفَها بَينَ السِماكَينِ وَالقَلبِ",36,"ب",1,0],["إِذا طَعَنَت فيهِ الجَنوبُ تَحامَلَت","بِأَعجازِ جَرّارٍ تَداعى خُصومُها",37,"م",3,0],["إِذا طَلَعَت ذُكاءً فَلَيسَ تَخفى","وَلَو حاكوا الظَلامَ لَها لِثاما",38,"م",2,0],["إِذا طَمَحَتْ للحَياةِ النُّفوسُ","فلا بُدَّ أنْ يستجيبَ القَدَرْ",39,"ر",1,0],["إِذا طُوِيَت بِالشُهبِ وَالدُهمِ شَقَّةٌ","طَوى الشُهبَ أَوجابَ الغُدافِيَّةَ الدُهما",40,"م",2,0],["إِذا طالَ وَاِستَعصى فَما هِيَ لَيلَةٌ","وَلَكِن لَيالٍ ما لَهُنَّ عَديدُ",41,"د",1,0],["إِذا طَلَبتَ عَظيماً فَاِصبِرَنَّ لَهُ","أَو فَاِحشُدَنَّ رِماحَ الخَطِّ وَالقُضُبا",42,"ب",2,0],["إِذا طاشَ بَينَ الماءِ وَالصَخرِ سَهمُها","أَتاها حَديدٌ ما يَطيشُ وَأَسرَبُ",43,"ب",1,0],["إِذا طَلَبوا جَدواكَ أَعطوا وَحُكِّموا","وَإِن طَلَبوا الفَضلَ الَّذي فيكَ خُيِّبوا",44,"ب",3,0],["إِذا طَلَبَ التَبلَ لَم يَشأَهُ","وَإِن كانَ ديناً عَلى ماطِلِ",45,"ل",1,0],["إِذا طَلَبَت وَدائِعُهُم ثِقاتٍ","دُفِعنَ إِلى المَحاني وَالرِعانِ",46,"ن",1,0],["إِذا طَمِعَ الساعونَ أَن يَلحَقوا بِهِ","تَمَهَّلَ قابَ العَينِ أَو فَوتَ قابِها",47,"ب",3,0],["إِذا طَلَبنا بِلينِ القَولِ غِرَّتَهُ","ظَلنا نُعالِجُ قُفلاً لَيسَ يَنفَتِحُ",48,"ح",1,0],["إِذا طَأطَأَ الذُلُّ مِن ناظِرَيهِ","وَكَلَّلَ مِن طَرفِ بازٍ حَديدِ",49,"د",1,0],["إِذا طَلَبوا مِنهُ الهَوادَةَ طالَهُم","قَرا جَبَلٍ مِن دونِهِم مُتَوَعِّرِ",50,"ر",1,0],["إِذا طَلَبنا إِلَيهِ مَرغَبَةً","لَم يَعتَرِض دونَها تَعَذُّرُها",51,"ر",3,0],["إِذا طُوِيَ الفِتيانُ عَنكَ فَأَشكَلَت","مَقاديرُهُم فَاِعرِفهُمُ بِالعَوارِفِ",52,"ف",1,0],["إِذا طَلَعَت مِنهُ شَذاةٌ عَلى العِدا","أَرَت أَنَّ بَغثَ الطَيرِ صَيدُ الأَجادِلِ",53,"ل",1,0],["إِذا طَلَبَ الأَقامُ رُتبَةَ مَجدِهِ","أَباها عَلَيهِم تُبَّعٌ وَمُقاوِلُه",54,"ل",2,0],["إِذا طِبتُ نَفساً بِالسَلامَةِ رَدَّني","إِلى الحُزنِ دَهرٌ لَيسَ يَسلَمُ سالِمُه",55,"م",2,0],["إِذا طَلَبوا لَها الأَشباهَ كانَت","غَرائِبَ ما سُمِعنَ وَلا رُؤينا",56,"ن",2,0],["إِذا طاوَلوهُ إِلى سُؤدُدٍ","عَلا النَجمَ في بُعدِ إِمعانِهِ",57,"ن",2,0],["إِذا طَلَبَتها نَهشَلٌ كانَ حَظُّها","عَناءً وَجَهداً ثُمَّ تَنزَعُ ظُلَّعا",58,"ع",2,0],["إذا طافَت بعبدِ الله لاقَت","سِماتِ الحمدِ في الوَجهِ الوَسيمِ",59,"م",1,0],["إذا طَلبتْ ربُى نجدٍ مخيِّمةً","فما لها في طلابِ غيرِها أربُ",60,"ب",1,0],["إذا طارَتْ مُرفرفةً عليه","عِقابُ الجيش فانتظروا العِقابا",61,"ب",2,0],["إذا طار عنها انفلَّ في كلِّ نَثَلةٍ","دِلاصٍ كما ينفلُّ في الشَّمَطِ المِدْرَى",62,"ا",1,0],["إذا طلب الحب برهانه","من الموت لبَّيت كي تعلما",63,"م",2,0],["إذا طَعَنوا بالسهريّةَ خِلْتَهُم","ضراغمَ تُغْري بالقلوب أراقما",64,"م",2,0],["إذا طلع النطحُ اسجادتْ نطاحَهُ","برأسٍ له هادٍ على السُّحبِ مُعْتَلِ",65,"ل",1,0],["إِذا طارَ مِنهُم بِالوصيَّةِ سَوْذَقٌ","فذلك في إفصاحِ منطقه القمري",66,"ي",1,0],["إِذا طَيِّئٌ لَم تَطوِ مَنشورَ بَأسِها","فَأَنفُ الَّذي يُهدى لَها السُخطُ جادِعُ",67,"ع",1,0],["إِذا طَرَقَتهُ الحادِثاتُ بِنَكبَةٍ","مَخَضنَ سِقاءً مِنهُ لَيسَ بِذي زُبدِ",68,"د",1,0],["إِذا طَرِبوا يَوماً إِلى العِزِّ شَمَّروا","وَإِن نُدِبوا يَوماً إِلى غارَةٍ جَدّوا",69,"د",3,0],["إِذا طَلَبَ الأَعداءُ إِثري بِبَلدَةٍ","نَجَوتُ وَقَد غَطّى عَلى أَثَري البُردُ",69,"د",1,0],["إِذا طَمِعَت عادَت إِلى غَيرِ مَطمَعٍ","بِجودٍ وَتَأبى النَفسُ أَن تَتَحَلَّلا",70,"ل",2,0],["إِذا طَلَعَت شَمسُ النَهارِ ذَكَرتُها","وَأُحدِثُ ذِكراها إِذا الشَمسُ تَغرُبُ",71,"ب",1,0],["إذا طلبوا المغانم لم يبالوا","بما تَلْقَى البلادُ من الرّزايا",72,"ا",3,0],["إذا طلبوا النّجاةَ تلقّفَتْهم","يدا عزريلَ في المُتلقِّفينا",73,"ن",2,0],["إذا طَغتِ السّياسةُ في بلادٍ","فتلك سياسةُ المُستأثِرينا",73,"ن",2,0],["إذا طرقتكمُ الأحداثُ بِتْنا","قِياماً في المضاجعِ مُشفِقينا",73,"ن",2,0],["إِذا طَرِبتَ أَهابَ بِها مِراحٌ","تُجاوِبُهُ نُفوسُ الهالِكينا",74,"ن",2,0],["إِذا طَلبوا حَقّاً تَداعوا فَأَجلبوا","عَلى سالبيهِ وَانثَنوا غَيرَ خُيَّبِ",75,"ب",1,0],["إذا طارَ منهم مُدبِرٌ يَتَّقِي الرَّدَى","تَلَقَّاكَ منه في مَطَارِ الرَّدى الصَّدْرُ",76,"ر",1,0],["إِذا طَلَعَت أَولى العَدِيِّ فَنَفرُهُ","إِلى سَلَّةٍ مِن صارِمِ الغَربِ باتِكِ",77,"ك",1,0],["إِذا طَلَعَت أولى المُغيرَةِ قَوَّموا","كَما قَوَّمَت نيبٌ مُخَزَّمَةٌ زُجُر",78,"ر",1,0],["إذا طلب الجهالُ يوما دلائلا","على الشمس لم تُطلب عليك دلائل",79,"ل",1,0],["إذا طاعة الأعداء لم تشف صدره","شفاه صبوح من دم وغبوق",80,"ق",1,0],["إذا طالَ شهرُ الصوم قصّرت طولهُ","بحمراءَ يكحي الجلّنارَ احمرارُها",81,"ه",2,1],["إِذا طَعَنَت فيها القَبولُ تَشَمَّصَت","بِفُرسانِها لا في سُهولٍ وَلا وَعرِ",82,"ر",1,0],["إِذا طارِفُ الحُبِّ اِنجَلى عَنكَ هَمُّهُ","ثَناهُ مِنَ الحُبِّ الدَخيلِ تَلادُ",83,"د",1,0],["إِذا طَلَبتَ إِلى المُنجابِ نافِلَةً","فَاِطلُب بِأَيرِكَ لا تَطلُب بِكَرّابِ",84,"ب",1,0],["إِذا طَلَبوا فَاِقنَع لِتَظفَرَ بِالغِنى","وَإِن نَطَقوا فَاِصمُت لِتَرجِعَ بِاللُبِّ",85,"ب",1,0],["إِذا طَفِئَت في الثَرى أَعيُنٌ","فَقَد أَمِنَت مِن عَماً أَو رَمَد",86,"د",1,0],["إِذا طَلَعَ الشَيبُ المُلِمُّ فَحَيِّهِ","وَلا تَرضَ لِلعَينِ الشَبابَ المُزَوَّرا",87,"ر",2,1],["إِذا طَلَعَ النِسرانِ غارَت ظَعائِنٌ","وَكانَ مِراسُ القُرِّ شَرَّ مِراسِ",88,"س",1,1],["إِذا طَلَبوا أَقصى العُلا اِتَّخَذوا لَهُ","بِصُمِّ العَوالي في تَرائِبِكُم طُرقا",89,"ق",2,0],["إِذا طَلَبتَ نَداهُم صِرتَ ضِدَّهُمُ","وَإِن تُرِد مِنهُمُ عِزّاً يُهينوكا",90,"ك",2,0],["إِذا طَما لِيَ أَو لَم يَطمُ بَحرُ غِنىً","فَقَد وَجَدتُ بَني الدُنيا طَماليلا",91,"ل",2,0],["إِذا طَرَقَ المِسكينُ دارَكَ فَاِحبُهُ","قَليلاً وَلَو مِقدارَ حَبَّةِ خَردَلِ",92,"ل",1,1],["إِذا طَمِعوا فَاِقتَنِع","وَإِن جَهِلوا فَاِحلَمِ",93,"م",1,0],["إذا طلعت من خدرها الشمس في غد","أَطلت إليها من دجى لَيلَتي الشكوى",94,"و",2,0],["إذا طابق الشعر الحَقيقة لَم يكن","بِذي حاجة في صدقه لشهود",95,"د",1,0],["إذا طلبت ودائعهم ثقاتٍ","دفعن إلى المحاني والرّعاني",96,"ن",2,0],["إذا طالعنني أُنسيتُ جُرحي","وأنَّ الحبَّ لم يرحم قتيلَهْ",97,"ل",2,0],["إذا طُوِيَتْ فالقَعْبُ يجْمَعُ شَملَها","وإنْ نُثِلَتْ سالَتْ مَسيلَ ثَماد",98,"د",1,0],["إذا طالَ عنها سَرّها لو رُؤوسُها","تُمَدّ إليه في رُؤوسِ عَوال",99,"ل",1,0],["اذا طاف قلبى حولها جن شوقه","كذلك يطفئ الغلة المنهل العذب",100,"ب",1,0],["إِذَا طَرَقَتْهُ الحادِثَاتُ أَعارَهَا","شَبا فِكَرَاتٍ قد أَطالَ مَضَاءَهَا",101,"ا",3,0],["إِذا طولِبوا يَوماً إِلى الغَزوِ شَمَّروا","وَإِن نُدِبوا يَوماً إِلى غارَةٍ جَدّوا",102,"د",3,0],["إذا طلعتْ في سماء البيا","نِ، لم يسألوا: أيُّ نجم غرب؟",103,"ب",1,0],["إذا طارق منهم تأنس للقرى","نحرت له دني ووسدته زق",104,"ق",1,0],["إذا طمع يحل بقلب عبدٍ","علته مهانة وعلاه هون",105,"ن",1,0],["إذا طَلَبْنَا بِلِينِ القَوْلِ عزّتَهُ،","ظِلْنا نُعالِجُ قُفْلاً ليسَ يَنفَتِحُ",106,"ح",1,0],["إِذا طَلَب الأَقْوَامُ رُتْبَةَ مَجْدِهِ","أَبَاهَا عَلَيْهِمْ تُبَّعٌ ومَقَاوِلُهْ",107,"ل",2,0],["إذا طَلَعَتْ منهُ شَذاةٌ على العِدَى