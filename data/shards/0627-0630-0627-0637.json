/141034",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39619","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16679","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202699","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30434","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9914","الطويل"],[106,"تحيْة الرسالة","https://www.poetsgate.com/ViewPoem.aspx?id=179503",""],[77,"أمحي رسوم الأنس إن شئت أن تبقي","https://www.poetsgate.com/ViewPoem.aspx?id=34185",""],[57,"أمت مطامعي فأرحت نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=3232",""],[45,"لكَ الخَلائِقُ فِينا السّهلَةُ السُّمُحُ","https://www.poetsgate.com/ViewPoem.aspx?id=32947",""],[45,"هَلِ الرَّبْعُ قد أَمْستْ خَلاَءً مَنَازِلُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32113",""],[45,"تَقَضّى الصّبَا، إلاّ تَلَوّمَ رَاحِلِ","https://www.poetsgate.com/ViewPoem.aspx?id=32195",""],[45,"لَيَالينا بَينَ اللّوَى، فمُحَجَّرِ،","https://www.poetsgate.com/ViewPoem.aspx?id=31220",""],[80,"ونوبية ٍ في الخلقِ منها خلائقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=3586",""],[46,"يُسمُّون بالجهْلِ عبدَ الرّحيم،","https://www.poetsgate.com/ViewPoem.aspx?id=20046",""],[105,"لئن ظهرت لنا رغبات قوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55022&r=&rc=192",""],[3,"لأَيِّ حَبيبٍ يَحْسُنُ الرَّأْيُ والوُدُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10678&r=&rc=32",""],[71,"أرى شأنيكَ شأنهما انبجاسُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=28022&r=&rc=9",""]],"verses":[["إِذا طُرِدَت رِماحُ اللَهوِ فيهِ","أَرَقنَ عَلى الكُؤوسِ دَمَ القِنانِ",0,"ن",1,0],["إِذا طَرَدوا في مَعرَكِ المَجدِ قَصَّفوا","رِماحَ العَطايا في صُدورِ المَكارِمِ",1,"م",1,0],["إِذا طَرَقَ الخَطبُ البَهيمُ عِيالَهُ","وَقَد مالَ عُنقُ الرَأيِ كُلَّ مَميلِ",2,"ل",1,0],["إِذا طَرِبوا لِلجودِ أَمطَرنَهُم حَياً","وَإِن غَضِبوا لِلمَجدِ هَيَّجتَهُم أُسدا",3,"د",2,0],["إِذا طَلَعَ الرَكبُ يَمَّمتُهُ","أُحَيّي الوُجوهَ كُهولاً وَمُردا",4,"د",2,0],["إِذا طَمِعَ الأَعداءُ فيها أَجارَها","وَأَرتَعَها بَينَ العَوالي وَأَورَدا",5,"د",2,0],["إِذا طَرَدوها خالَفَت بِرِقابِها","رُجوعاً إِلى أَوطانِها وَالمَسارِحِ",6,"ح",1,0],["إِذا طَرَحوا عِمّاتِهِم وَضَحَت لَهُم","مَفارِقُ لَم يَعصِب بِها العارَ لائِثُ",7,"ث",1,0],["إِذا طَبَعَ الآراءَ ما طَلَ غَربَها","فَلَم يُمضِها إِلّا بِإِذنِ العَواقِبِ",8,"ب",1,0],["إِذا طَلَبوا الأَعداءَ كانوا نَغيضَةً","لِيَومِ الوَغى مِن قَبلِ جَرِّ الكَتائِبِ",8,"ب",1,0],["إِذا طَلَعَت نَجداً أَضاءَت وُجوهُها","وَقُدّامَها مِن سائِقِ النَقعِ غَيهَبُ",9,"ب",1,0],["إِذا طاوَعَ المِقدارُ لَم نَحمَدِ الغِنَى","وَلَسنا نَذُمُّ الدَّهرَ حينَ يُعاصي",10,"ي",1,0],["إِذا طَرَق الرَّكْبُ العِراقيُّ أرْضَها","بِحَيْثُ تُظِلُّ السُّمْرُ مُقْرَبَةً جُرْدا",11,"د",2,0],["إذا طاشَتِ الأحْلامُ واسْتَرْخَتِ الحُبا","تفيّأَتِ الآراءُ ظِلَّ وَقارِهِ",12,"ر",2,0],["إذا طالَعَتنا منْ قُرَيْشٍ عِصابَةٌ","وشافَهْنَ من أعلامِ مَكَّتِها هَضْبا",13,"ب",2,0],["إِذا طولِبوا يَوماً إِلى الغَزوِ شَمَّرو","وَإِن نُدِبوا يَوماً إِلى غارَةٍ جَدّوا",14,"د",3,0],["إِذا طَلَعَت شَمسُ النَهارِ فَسَلِّمي","فَآيَةُ تَسليمي عَلَيكِ طُلوعُها",15,"ع",3,1],["إِذا طَمَعٌ يَحِنُّ بِقَلبِ عَبدٍ","عَلَتهُ مَهانَةٌ وَعَلاهُ هونُ",16,"ن",1,0],["إذا طُوِيَ الإثْراءُ لي في تملُّقٍ","رضِيتُ بعِزِّ النّفْسِ في عِزِّ إمْلاقِ",17,"ق",1,0],["إِذَا طَلعَتْ مُفْتَرَّةً فِي سُعُودِهَا","تُبشِّرُ أَحْكَامُ السُّرورِ بِمَا تَقْضِي",18,"ي",1,0],["إِذا طَمعٌ كَسا غَيري ثِياباً","يذِلُّ بِها كَساني العزَّ ياسُ",19,"س",1,0],["إِذا طافَ بِالراحِ المُديرِ عَلَيهِمُ","أَطافَ بِهِ بيضُ الوُجوهِ كِرامُ",20,"م",1,0],["إِذا طَلَبوا أَعلى المَكارِم أَدرَكوا","بِما أَدرَكَت أَحسابُ قَومٍ وَدينها",21,"ن",3,0],["إِذا طَيِّبِ الأَثوابِ قَد أُلهِمَ التُقى","هِجانِ البَنينِ يَعتَريهِ المُعاقِلُ",22,"ل",1,0],["إِذا طُرِحَت لَم تَطَّبِ الكَلبَ رِيحُها","وَإِن وُضِعَت في مَجلِسِ القَومِ شُمَّتِ",23,"ت",1,0],["إذَا طُولِعَتْ لَمْ تَسْأَمِ الْعَيْنُ حُسْنَها","وَإِنْ أُنْشِدَتْ فَالسَّمْعُ هَيْهَاتَ يَسْأَمُ",24,"م",1,0],["إِذا طَرَفَت في مَربَعٍ بَكَراتُها","أَو اِستَأخَرَت عَنها الثِقالُ القَناعِسُ",25,"س",1,0],["إِذا طَرِبَ الحَمامُ حَمامُ نَجدٍ","نَعى جارَ الأَقارِعِ وَالحُتاتِ",26,"ت",1,0],["إذا طرق الأمر بالمغِلقا","ت يتْنا وضاق به المَهِلُ",27,"ل",1,1],["إذا طلع الخطّ رمّلته","فيا حبَّذا الرّمل والطالع",28,"ع",1,0],["إذا طلب الملك المؤيد معسرٌ","رأى بشره في وجهه كضمينه",29,"ن",2,0],["إذا طوى الأرض في كتائبِهِ","ثمَّ سقاها حيا مواهبهِ",30,"ه",1,0],["إذا طَرَفٌ من حبلك انحلّ عقدُهُ","تداعت وشيكاً بانتقاضٍ مرائرُهْ",31,"ه",1,0],["إذا طيِّئٌ عدت بُناة بِنائها","فحاتمها الباني وأنت المتبِّرُ",32,"ر",1,0],["إذا طال شكرٌ طولَ كفّيه مرةً","ثنى الطّوْل طلّاباً بتلك الطوائلِ",33,"ل",1,0],["إذا طاب لي عيشي تنغصتُ طيبه","بصدق يقيني أن سيذهبُ كالحُلمِ",34,"م",1,0],["إِذا طَعَنَت ريحُ الصَبا في فُروجِهِ","تَحَلَّبَ رَيّانُ الأَسافِلِ أَنجَلُ",35,"ل",1,0],["إِذا طَلَعَ العَيّوقُ وَالنَجمُ أَولَجَت","سَوالِفَها بَينَ السِماكَينِ وَالقَلبِ",36,"ب",1,0],["إِذا طَعَنَت فيهِ الجَنوبُ تَحامَلَت","بِأَعجازِ جَرّارٍ تَداعى خُصومُها",37,"م",3,0],["إِذا طَلَعَت ذُكاءً فَلَيسَ تَخفى","وَلَو حاكوا الظَلامَ لَها لِثاما",38,"م",2,0],["إِذا طَمَحَتْ للحَياةِ النُّفوسُ","فلا بُدَّ أنْ يستجيبَ القَدَرْ",39,"ر",1,0],["إِذا طُوِيَت بِالشُهبِ وَالدُهمِ شَقَّةٌ","طَوى الشُهبَ أَوجابَ الغُدافِيَّةَ الدُهما",40,"م",2,0],["إِذا طالَ وَاِستَعصى فَما هِيَ لَيلَةٌ","وَلَكِن لَيالٍ ما لَهُنَّ عَديدُ",41,"د",1,0],["إِذا طَلَبتَ عَظيماً فَاِصبِرَنَّ لَهُ","أَو فَاِحشُدَنَّ رِماحَ الخَطِّ وَالقُضُبا",42,"ب",2,0],["إِذا طاشَ بَينَ الماءِ وَالصَخرِ سَهمُها","أَتاها حَديدٌ ما يَطيشُ وَأَسرَبُ",43,"ب",1,0],["إِذا طَلَبوا جَدواكَ أَعطوا وَحُكِّموا","وَإِن طَلَبوا الفَضلَ الَّذي فيكَ خُيِّبوا",44,"ب",3,0],["إِذا طَلَبَ التَبلَ لَم يَشأَهُ","وَإِن كانَ ديناً عَلى ماطِلِ",45,"ل",1,0],["إِذا طَلَبَت وَدائِعُهُم ثِقاتٍ","دُفِعنَ إِلى المَحاني وَالرِعانِ",46,"ن",1,0],["إِذا طَمِعَ الساعونَ أَن يَلحَقوا بِهِ","تَمَهَّلَ قابَ العَينِ أَو فَوتَ قابِها",47,"ب",3,0],["إِذا طَلَبنا بِلينِ القَولِ غِرَّتَهُ","ظَلنا نُعالِجُ قُفلاً لَيسَ يَنفَتِحُ",48,"ح",1,0],["إِذا طَأطَأَ الذُلُّ مِن ناظِرَيهِ","وَكَلَّلَ مِن طَرفِ بازٍ حَديدِ",49,"د",1,0],["إِذا طَلَبوا مِنهُ الهَوادَةَ طالَهُم","قَرا جَبَلٍ مِن دونِهِم مُتَوَعِّرِ",50,"ر",1,0],["إِذا طَلَبنا إِلَيهِ مَرغَبَةً","لَم يَعتَرِض دونَها تَعَذُّرُها",51,"ر",3,0],["إِذا طُوِيَ الفِتيانُ عَنكَ فَأَشكَلَت","مَقاديرُهُم فَاِعرِفهُمُ بِالعَوارِفِ",52,"ف",1,0],["إِذا طَلَعَت مِنهُ شَذاةٌ عَلى العِدا","أَرَت أَنَّ بَغثَ الطَيرِ صَيدُ الأَجادِلِ",53,"ل",1,0],["إِذا طَلَبَ الأَقامُ رُتبَةَ مَجدِهِ","أَباها عَلَيهِم تُبَّعٌ وَمُقاوِلُه",54,"ل",2,0],["إِذا طِبتُ نَفساً بِالسَلامَةِ رَدَّني","إِلى الحُزنِ دَهرٌ لَيسَ يَسلَمُ سالِمُه",55,"م",2,0],["إِذا طَلَبوا لَها الأَشباهَ كانَت","غَرائِبَ ما سُمِعنَ وَلا رُؤينا",56,"ن",2,0],["إِذا طاوَلوهُ إِلى سُؤدُدٍ","عَلا النَجمَ في بُعدِ إِمعانِهِ",57,"ن",2,0],["إِذا طَلَبَتها نَهشَلٌ كانَ حَظُّها","عَناءً وَجَهداً ثُمَّ تَنزَعُ ظُلَّعا",58,"ع",2,0],["إذا طافَت بعبدِ الله لاقَت","سِماتِ الحمدِ في الوَجهِ الوَسيمِ",59,"م",1,0],["إذا طَلبتْ ربُى نجدٍ مخيِّمةً","فما لها في طلابِ غيرِها أربُ",60,"ب",1,0],["إذا طارَتْ مُرفرفةً عليه","عِقابُ الجيش فانتظروا العِقابا",61,"ب",2,0],["إذا طار عنها انفلَّ في كلِّ نَثَلةٍ","دِلاصٍ كما ينفلُّ في الشَّمَطِ المِدْرَى",62,"ا",1,0],["إذا طلب الحب برهانه","من الموت لبَّيت كي تعلما",63,"م",2,0],["إذا طَعَنوا بالسهريّةَ خِلْتَهُم","ضراغمَ تُغْري بالقلوب أراقما",64,"م",2,0],["إذا طلع النطحُ اسجادتْ نطاحَهُ","برأسٍ له هادٍ على السُّحبِ مُعْتَلِ",65,"ل",1,0],["إِذا طارَ مِنهُم بِالوصيَّةِ سَوْذَقٌ","فذلك في إفصاحِ منطقه القمري",66,"ي",1,0],["إِذا طَيِّئٌ لَم تَطوِ مَنشورَ بَأسِها","فَأَنفُ الَّذي يُهدى لَها السُخطُ جادِعُ",67,"ع",1,0],["إِذا طَرَقَتهُ الحادِثاتُ بِنَكبَةٍ","مَخَضنَ سِقاءً مِنهُ لَيسَ بِذي زُبدِ",68,"د",1,0],["إِذا طَرِبوا يَوماً إِلى العِزِّ شَمَّروا","وَإِن نُدِبوا يَوماً إِلى غارَةٍ جَدّوا",69,"د",3,0],["إِذا طَلَبَ الأَعداءُ إِثري بِبَلدَةٍ","نَجَوتُ وَقَد غَطّى عَلى أَثَري البُردُ",69,"د",1,0],["إِذا طَمِعَت عادَت إِلى غَيرِ مَطمَعٍ","بِجودٍ وَتَأبى النَفسُ أَن تَتَحَلَّلا",70,"ل",2,0],["إِذ