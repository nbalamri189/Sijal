["إِذا طَرَقَ المِسكينُ دارَكَ فَاِحبُهُ","قَليلاً وَلَو مِقدارَ حَبَّةِ خَردَلِ",92,"ل",1,1],["إِذا طَمِعوا فَاِقتَنِع","وَإِن جَهِلوا فَاِحلَمِ",93,"م",1,0],["إذا طلعت من خدرها الشمس في غد","أَطلت إليها من دجى لَيلَتي الشكوى",94,"و",2,0],["إذا طابق الشعر الحَقيقة لَم يكن","بِذي حاجة في صدقه لشهود",95,"د",1,0],["إذا طلبت ودائعهم ثقاتٍ","دفعن إلى المحاني والرّعاني",96,"ن",2,0],["إذا طالعنني أُنسيتُ جُرحي","وأنَّ الحبَّ لم يرحم قتيلَهْ",97,"ل",2,0],["إذا طُوِيَتْ فالقَعْبُ يجْمَعُ شَملَها","وإنْ نُثِلَتْ سالَتْ مَسيلَ ثَماد",98,"د",1,0],["إذا طالَ عنها سَرّها لو رُؤوسُها","تُمَدّ إليه في رُؤوسِ عَوال",99,"ل",1,0],["اذا طاف قلبى حولها جن شوقه","كذلك يطفئ الغلة المنهل العذب",100,"ب",1,0],["إِذَا طَرَقَتْهُ الحادِثَاتُ أَعارَهَا","شَبا فِكَرَاتٍ قد أَطالَ مَضَاءَهَا",101,"ا",3,0],["إِذا طولِبوا يَوماً إِلى الغَزوِ شَمَّروا","وَإِن نُدِبوا يَوماً إِلى غارَةٍ جَدّوا",102,"د",3,0],["إذا طلعتْ في سماء البيا","نِ، لم يسألوا: أيُّ نجم غرب؟",103,"ب",1,0],["إذا طارق منهم تأنس للقرى","نحرت له دني ووسدته زق",104,"ق",1,0],["إذا طمع يحل بقلب عبدٍ","علته مهانة وعلاه هون",105,"ن",1,0],["إذا طَلَبْنَا بِلِينِ القَوْلِ عزّتَهُ،","ظِلْنا نُعالِجُ قُفْلاً ليسَ يَنفَتِحُ",106,"ح",1,0],["إِذا طَلَب الأَقْوَامُ رُتْبَةَ مَجْدِهِ","أَبَاهَا عَلَيْهِمْ تُبَّعٌ ومَقَاوِلُهْ",107,"ل",2,0],["إذا طَلَعَتْ منهُ شَذاةٌ على العِدَى","أرَتْ أنّ بُغْثَ الطّيرِ صَيدُ الأجادِلِ",108,"ل",1,0],["إذا طَلَبُوا مِنْهُ الهَوَادَةَ طالَهُمْ","قَرَا جَبَلٍ مِنْ دُونِها مُتَوَعِّرِ",109,"ر",1,0],["إذا طلع النطحُ استجادتْ نطاحه","برأسٍ له هادٍ على السُّحبِ معتلِ",110,"ل",1,0],["إذا طَفِئَتْ في الثّرى أعينٌ","، فقدْ أمِنتْ منْ عمًى أو رمد",111,"د",1,0],["إذا طلبوا المغانم لم يبالوا","بما تلقى البرد من الرزايا",112,"ا",3,0],["إذا طلبوا إلى الغزو شمروا","وإن نُدِبُوا يوْماً إلى غَارَة ٍ جَدّوا",113,"د",3,0],["إذا طمعٌ كسا غيري ثياباً","يذلُّ بها كساني بها العزَّ ياسُ",114,"س",1,0]]}