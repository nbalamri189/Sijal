{"poems":[[53,"توقعي أن يقال قد ظعنا","https://www.aldiwan.net/poem29653.html","المنسرح"],[53,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[53,"عجلت يا شيب على مفرقي","https://www.aldiwan.net/poem29876.html","السريع"],[53,"ألهاك عنا ربة البرقع","https://www.aldiwan.net/poem30157.html","السريع"],[100,"وحدي هنا","https://www.aldiwan.net/poem24837.html","عموديه"],[77,"مولاي مذ بعدت دياري لا تسل","https://www.aldiwan.net/poem36641.html","الكامل"],[9,"ودع هريرة إن الركب مرتحل","https://www.aldiwan.net/poem21969.html","البسيط"],[86,"أما أمين فقد ذقنا لمصرعه","https://www.aldiwan.net/poem10377.html","البسيط"],[86,"نثروا عليك نوادي الأزهار","https://www.aldiwan.net/poem10492.html","الكامل"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[86,"شيخان قد خبرا الوجود وأدركا","https://www.aldiwan.net/poem68877.html","الكامل"],[93,"يا بالغ التسعين من عمره","https://www.aldiwan.net/poem9841.html","السريع"],[93,"ألغرس غرسك أيها البستاني","https://www.aldiwan.net/poem11219.html","الكامل"],[93,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[27,"ما بال نومك بالفراش غرارا","https://www.aldiwan.net/poem5750.html","الكامل"],[51,"لم يله في المهرجان أولى","https://www.aldiwan.net/poem7936.html","مخلع البسيط"],[51,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[29,"نعم المجير سماك من بني أسد","https://www.aldiwan.net/poem6169.html","البسيط"],[85,"قم ناد أنقرة وقل يهنيك","https://www.aldiwan.net/poem63757.html","الكامل"],[43,"أمساور أم قرن شمس هذا","https://www.aldiwan.net/poem9561.html","الكامل"],[45,"لامت علي أنها في الدمع لم تلم","https://www.aldiwan.net/poem66653.html","البسيط"],[2,"لمن الديار غشيتها بالفدفد","https://www.aldiwan.net/poem25034.html","الكامل"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[44,"ظني به حسن لولا تجنيه","https://www.aldiwan.net/poem30076.html","البسيط"],[44,"قل للأمير لقد قلدتني نعما","https://www.aldiwan.net/poem30562.html","البسيط"],[90,"في ذمة الله ما ألقى وما أجد","https://www.aldiwan.net/poem47616.html","الكامل"],[105,"نادى الشباب فهب من إغفائه","https://www.aldiwan.net/poem42094.html","الكامل"],[105,"يا غاديا ببريد الشام ينتحب","https://www.aldiwan.net/poem43094.html","الكامل"],[105,"فزع الدجى لأنينه المتردد","https://www.aldiwan.net/poem43163.html","الكامل"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[50,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[50,"قاس الهموم تنل بها نجحا","https://www.aldiwan.net/poem63980.html","الكامل"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49158","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147505","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55085","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55018","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43823","المنسرح"],[106,"كرموه","https://www.poetsgate.com/ViewPoem.aspx?id=179708",""],[106,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[9,"معلقة الأعشي","https://www.poetsgate.com/ViewPoem.aspx?id=11407",""],[46,"يُصَلّي على مِثْلِ الرّبيعِ وإنّه","https://www.poetsgate.com/ViewPoem.aspx?id=74963",""],[124,"للحب دين وللأشواق باقينا","https://www.aldiwan.net/poem794.html",""],[133,"دع في الغرام مقالة السفهاء","https://www.aldiwan.net/poem49114.html","الكامل"],[140,"هو منزل النجوى بخالي الأعصر","https://www.aldiwan.net/poem58442.html","الكامل"],[141,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[158,"سم سمة تحمد آثارها","https://www.aldiwan.net/poem59021.html","السريع"],[164,"ضربوا بمنعرج اللواء سرادقا","https://www.aldiwan.net/poem47021.html","الكامل"],[193,"شطت بجارتك النوى فتحمل","https://www.aldiwan.net/poem54423.html","الكامل"],[196,"بيني وبين الحادثات خصام","https://www.aldiwan.net/poem51882.html","الكامل"],[197,"كان لي قلب فيا عجبي","https://www.aldiwan.net/poem45139.html","المديد"],[208,"رأى العقيق فأجرى دمعه لولو","https://www.aldiwan.net/poem13306.html","البسيط"],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[273,"عذلوه في تشبيبه ونسيبه","https://www.aldiwan.net/poem25625.html","الكامل"],[280,"في مدحي الصاحب ماض عزمي","https://www.aldiwan.net/poem32459.html","الرجز"],[280,"بالملك الأشرف لم","https://www.aldiwan.net/poem32630.html","منهوك الرجز"],[288,"ملكت قلبك الرباب ولن تملك","https://www.aldiwan.net/poem11691.html","الخفيف"],[295,"وشاعر قريضه","https://www.aldiwan.net/poem32941.html","مجزوء الرجز"],[318,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[347,"شرعة وجدي ما لها نسخ","https://www.aldiwan.net/poem15566.html","السريع"],[377,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[390,"بلغت نفسي مناها","https://www.aldiwan.net/poem53668.html","مجزوء الرمل"],[413,"جسد ذاب نحولا وسقاما","https://www.aldiwan.net/poem53951.html","الرمل"],[413,"أعد اللهو فإن اللهو أحمد","https://www.aldiwan.net/poem54100.html","الرمل"],[426,"وافى يطوف بشمس كاسه","https://www.aldiwan.net/poem40239.html","مجزوء الكامل"],[429,"لم يلف للهون عاشق جاحد","https://www.aldiwan.net/poem12471.html","المنسرح"],[429,"يا رب ليل أشتهي لباسه","https://www.aldiwan.net/poem12790.html","مشطور الرجز"],[434,"سل دار هند بالكثيب الفرد","https://www.aldiwan.net/poem2579.html","الرجز"],[434,"ما بعد رامة للمشتاق من إرب","https://www.aldiwan.net/poem2580.html","البسيط"],[456,"أين تريد يا مثير الظعن","https://www.aldiwan.net/poem55836.html","الرجز"],[456,"أرأيت أم حبست لحاظك عبرة","https://www.aldiwan.net/poem56150.html","الكامل"],[456,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[462,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[466,"قد راح بي القصد على ظهره","https://www.aldiwan.net/poem60001.html","السريع"],[475,"برق على الجزع بدا يلمع","https://www.aldiwan.net/poem15226.html","السريع"],[477,"إن كنت مثلي على الأحوال مطلعا","https://www.aldiwan.net/poem37575.html","البسيط"],[498,"أنا الفتى من بني الصياد لي نسب","https://www.aldiwan.net/poem37773.html","البسيط"],[512,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[513,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[513,"هل تبلغن لبختيار","https://www.aldiwan.net/poem12133.html","مجزوء الكامل"],[513,"هل تعلمان طريقة لم تطرق","https://www.aldiwan.net/poem12186.html","الكامل"],[513,"تقبل الله صوماً أنت واصله","https://www.aldiwan.net/poem12203.html","البسيط"],[513,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[536,"أهلا بجرح ليته يتكرر","https://www.aldiwan.net/poem48144.html","عموديه"],[573,"يا ساكناً بين جنات وأنهار","https://www.aldiwan.net/poem2784.html","البسيط"]],"verses":[["لَم يَلبَسِ الثَوبَ مِن تَوَقُّعِهِ","الأَمرَ إِلّا وَظَنَّهُ كَفَنا",0,"ن",2,0],["لَم يَلحَقوا فيها بِشَأوِكَ بَعدَما","أَمَلوا فَعاقَهُمُ اِعتِراضُ الأَزلَمِ",1,"م",1,0],["لَم يَلقَ مِن دوني لَهُ مَصرِفاً","وَلَم أَجِد مِن دونِهِ مَوئِلا",2,"ل",2,0],["لَم يَلقَكَ المَغرورُ إِلّا غَدا","يُقَوِّمُ الجَنبَ عَلى المَصرَعِ",3,"ع",1,0],["لمّيل يلهو بي كما","يهوى التجنّي والتعدّي",4,"ي",1,0],["لمْ يَلْقَ بعْدَكَ ما يَلَذُّ لناظِري","منْ حُسْنِ أرْجاءٍ وزَهْرِ بِطاحِ",5,"ح",1,0],["لَم يُلهِني اللَهوُ عَنهُ حينَ أَرقُبُهُ","وَلا اللَذاذَةُ مِن كَأسٍ وَلا الكَسَلُ",6,"ل",1,0],["لَم يَلوِهِ المالُ عَن رَأيٍ يَدينُ بِهِ","وَلَو حَمَلتَ إِلَيهِ الدَهرَ مَلآنا",7,"ن",2,0],["لَم يَلوِهِ عَنها الوَعيدُ وَلا ثَنى","مِن عَزمِهِ قَولُ المُريبِ حَذارِ",8,"ر",1,0],["لم يُلهِكَ النَّزْعُ عن تأييدِ دَولَتها","وللمَنِيَّةِ آلامٌ تُعانيها",9,"ي",3,0],["لَم يُلهِكَ الإِثراءُ عَن طَلَبِ العُلا","بِالجِدِّ لا بِتَصَيُّدِ الأَلقابِ",10,"ب",1,0],["لم يلق من أبنائه والدٌ","بعض الذي تلقى من البر",11,"ر",1,0],["لَمْ يَلْتَمِسْ فِي الْعَيْشِ إِلاَّ غَايَةً","تُرْضِي الإِبَاءَ وَطَاهِرِ الْوِجْدَانِ",12,"ن",1,0],["لَمْ يُلْفَ يَوْماً مَنْ يَفِي كَوَفَائِهِ","فِيمَا بَلاهُ مِنَ الحَمِيمِ حَمِيمُ",13,"م",1,0],["لَم يُلقَ أَخبَثُ يا فَرَزدَقُ مِنكُمُ","لَيلاً وَأَخبَثُ بِالنَهارِ نَهارا",14,"ر",2,0],["لم يَلهُ في المِهْرجانِ أَوْلَى","باللهوِ فيه من ابن يحيى",15,"ا",1,1],["لم يلفح الصيفُ له صفحةً","ولا سقاه عُودهُ الشاسبُ",16,"ب",1,0],["لم يلحقوا شأوهُ ولو فعلوا","أمكن أن يسبِق امرؤٌ قدَره",17,"ر",2,0],["لم يُلفِه الغمز خواراً وتعطفه","بالرفق منك فتلقى منه عطافا",18,"ف",2,0],["لَم يُلهِهِ عَن سَوامِ الخَيرِ قَد عَلِموا","أَمرُ الضَعيفِ وَلا مِن حِلمِهِ البَطَرُ",19,"ر",1,0],["لَم يَلبِسوا بُردَ النَبِيِّ وَإِنَّما","لَبِسوا طُقوسَ الرومِ إِذ لَبِسوكِ",20,"ك",1,0],["لَم يَلقَ قَبلَكَ مَن إِذا اِختَلَفَ القَنا","جَعَلَ الطِعانَ مِنَ الطِعانِ مَلاذا",21,"ذ",2,0],["لَم يَلقَ سائِلَهُ مُذ كانَ سائِلُهُ","إِلّا بِوَجهٍ أَغَرِّ الوَجهِ مُبتَسِمِ",22,"م",1,0],["لَم يَلقَها إِلّا بِشِكَّةِ حازِمٍ","يَخشى الحَوادِثَ عازِمٍ مُستَعدِدِ",23,"د",1,0],["لَم يَلقَ مَرحَبُ مِنهُ مَرحَباً وَرَأى","ضِدَّ اِسمِهِ عِندَ هَدِّ الحِصنِ وَالأُطُمِ",24,"م",1,0],["لَم يُلهِني عَنهُ ما أَلهاهُ بَل عَذُبَت","عِندي الصَبابَةُ إِذ جُرِّعتُها فيهِ",25,"ي",2,0],["لَم يُلبِسِ اللَهُ نوحاً فَضلَ نِعمَتِهِ","إِلّا لِما بَثَّهُ مِن شُكرِهِ نوحُ",26,"ح",1,0],["لم يَلْقَ في قلبِها غِلٌّ ولا دَنَسٌ","لهُ محلاً ، ولا خُبْثٌ ولا حَسد",27,"د",1,0],["لم يَلْقَِ قَيْسٌ في هَوى ليلاه ما","لاقَى ولا ابنُ خزامَ في عَفرائِهِ",28,"ا",3,0],["لَم يَلبِسِ التاجَ حَتّى راحَ يَخلَعُهُ","مُشَرَّداً في فِجاجِ الأَرضِ يَغتَرِبُ",29,"ب",1,0],["لَم يُلهِهِ أَرَبٌ وَلَم يَقعُد بِهِ","قَولُ المُغَرِّرِ أَلقِ رَحلَكَ وَاِقعُدِ",30,"د",1,0],["لَم يُلفَ إِلّا دَنِسَ الأَثوابِ","مُهَوَّساً مُهَوِّسَ الأَصحابِ",31,"ب",1,0],["لم يلْقَ جالوتُ من داودَ ما لِقيَتْ","شُراتُهُ منك في حَلٍّ وفي رِحَل",32,"ل",1,0],["لَم يَلقَ ذو المَجدِ ما لاقَيتَ مِن قُرُمٍ","صُمٍّ عَنِ الخَيرِ بِالقُرآنِ جُحّادِ",33,"د",1,0],["لَم يَلقَ مِثلي في مُواظَبَةٍ","لِشِفائِها مِمَّن صَبا وَصَحا",34,"ح",2,0],["لم يلبثِ القومُ حتّى قال قائلُهم","فِيمَ الحوارُ وهل في الأمرِ من جَدَلِ",35,"ل",1,0],["لم يله عنه الدهر في عيشة","واللهو لا يخلد عزاً لها",36,"ه",2,0],["لَمْ يَلْبَثَا مُتَآزِرَيْنِ بِنِيَّةٍ","مَصْدُوقَةٍ فِي خُفْيَةٍ وَجِهَارِ",37,"ر",1,0],["لَمْ يُلْفَ قَبْلاً مُوْكبٌ بِجلاَلِهِ","وَسِعَ الأَمِيرَ وَضَاقَ بِالصَّعْلُوكِ",38,"ك",1,0],["لَمْ يُلْفَ إِلاَّكَ عَبْقَرِيٌّ","رَدَّ بِهِ شَمْلَهَا جَمِيعَا",39,"ع",2,0],["لم يلبسا ريش الهوى لكنما","هو ريش احلام وريش أمان",40,"ن",1,0],["لَم يَلو وُجودُ شيبي بَل","فَقدُ الهِلالِ الَّذي أَلاحَ لَوى",41,"ل",3,0],["لم يلن عودُهُ، وكم كبيرٍ","عجمت عودَهُ الخطوبُ فلانا",42,"ن",2,0],["لم يَلقَ قبرًا فوق أرضٍ طالما","فتحتْ له أحْضانها ترحيبا",43,"ب",2,0],["لم يلهني اللهو عنه حين أرقبه","ولا اللذاذة في كأس ولا شغل",44,"ل",1,0],["لم يُلْقَ في رُوعٍ لها خوْفُ صارِمٍ","ففازَ بطُهْرٍ مِن تُقَى الموْتِ رُوعُها",45,"ع",3,0],["لم يلق إلاّ ثبات العزم متقداً","وشدّة الصبر لا وهناً ولا لينا",46,"ن",2,0],["لم يلْفَ يوماً في الجوابِ مقصراً","وبيانهُ لما يُشَبْ بخفاءِ",47,"ا",2,0],["لم يلبسوا الأدراع إلا رِيبةً","لا خيفةً من أبيضٍ أو أسمرِ",48,"ر",1,0],["لَم يَلقَ عَنها وازِعاً مِن رَأيِهِ","حَتّى اِنبَرَت أَعضاؤُهُ تَتَوَزَّعُ",49,"ع",1,0],["لم يله مهنا الشيب عن خوفه","والعبد غير الله لن يلهمه",50,"م",2,0],["لم يلتمس ماءَ الحياةِ بجَهْدِهِ","لو كانَ ذُو القَرنينِ منهُ ذائقا",51,"ق",2,0],["لَم يَلتَفِت أَحَدٌ إِلَيهِ وَلَم يَجِد","إِلّا نَداكَ فَكُنتَ خَيرَ مُعَولِ",52,"ل",1,0],["لم يُلْفَ فيه سوى الفرارِ أو الردى","فاخترتَ صَرْفَ الموتِ وهو زؤام",53,"م",1,0],["لم يلن إلا بمطرقة","من قضاء اللَه أو قدره",54,"ر",2,0],["لم يلههم عن غداء البيض غانية","ولا عن الاسمر العسال معسول",55,"ل",1,0],["لَم يَلقَهُ مِنهُم فَتاةٌ أَو فَتى","إِلّا بِقَلبٍ نَيِّرٍ جَذلانِ",56,"ن",1,0],["لَم يَلقَهُ يَوماً بِوَجهٍ باسِر","لَكَأَنَّهُ ما كانَ ذا شَنَآنِ",56,"ن",1,0],["لَم يَلْبثِ المَكروهُ فيها أنْ نَأى","لمّا دَنا المَحبوبُ دونَ رَقيبِهِ",57,"ب",2,0],["لَم يُلفَ إِلّا لِلجَميلِ آلِفاً","فاعِلَ خَيرٍ صافِحاً عَن جُرمِ",58,"م",1,0],["لَم يَلقَ في دُنياهُ هَم","مَن زارَهُ وَلا نَدِم",59,"م",1,0],["لم يلح فجر عمرها ولقد لاح","على مفرقيك أثر الخضاب",60,"ب",1,0],["لَم يَلتَزِم شَيئاً سِوى","لزوم ما لا يَلزَمُ",61,"م",1,0],["لَم يَلبَثِ الكُلَّ إِن كَلَت عَواهِنَهُم","وَبانَ عَنهُم مَحابيهِم وَعائِنَهُم",62,"م",1,0],["لَم يَلقَ قَلباً حُبُّهُ قالِياً","إِلّا بِهِ مِن حَبِّهِ لَطخُ",63,"خ",1,0],["لم يلبثِ الدستُ به أن يَبطُلا","ويهدم المجدَ وتَسمَح العلا",64,"ل",2,0],["لَم يلج آذانَهُم شع","ريَ لا صُمَّ صَداها",65,"ا",3,0],["لم يَلِنْ للدَّهر منِّي جانب","حيث لم أستعطف القومَ اللّئاما",66,"م",2,0],["لم يلد مثل أبيهم والدٌ","لم يلد قبل ولا من بعد يولد",67,"د",1,0],["لم يلتبس من مشكلٍ","إلا جلا وجه التباسه",68,"س",2,0],["لم يُلْفَ للهون عاشقٌ جاحِدْ","فخلِّ قولَ العذولِ والحاسِدْ",69,"د",1,1],["لم يلبثِ النجمُ به أن حاسَهْ","دعِ امرأَ القيسِ ودَعْ أمراسَهْ",70,"س",2,0],["لم يلف جود كفّه من الندى","نهايةً فهو بغير حد",71,"د",1,0],["لم يلحتق شأوكم كسرى ولا تبعت","أخلاق تبّع أو مسعى أبي كربِ",72,"ب",1,0],["لم يلتحمْ بِعذرةٍ معروفُها","ولا أتت مكدودةً بالمننِ",73,"ن",1,0],["لم يُلفِ لي عيباً وطالعَ عِرضَه","فرنا إليّ بعيبه وتخرّصا",74,"ص",2,0],["لم يلامسْ خطباً وكان جسيماً","في المعالي إلا رآه حقيرا",75,"ر",2,0],["لم يلجْ قلبَ كاسرٍ كاشرٍ","أحلى حديثاً منها ولا سمعَ سمع",76,"ع",1,0],["لَم يَلقَهُ مُذ كانَ مُستَرفِدٌ","فَقَصَّرَت جَدواهُ في أَمرِهِ",77,"ر",2,0],["لم يُلهِه بعدَهمُ ملعبٌ","ولا اطبَّاهُ لهمُ مربعُ",78,"ع",1,0],["لم يلق من أهله أهلا ليرشده","حتى يكون إلى هاديه متبعا",79,"ع",2,0],["لم يُلْفَ في مَعْرَكِ الفُرسانِ إِن هَجَمَتْ","منَّا لذي الحربِ إِلاَّ الفاتِكُ القَرِمُ",80,"م",1,0],["لم يَلقَها الليلُ إلّا دُهمُهُ صدرَتْ","بيضَ الثّيابِ وغارتْ فوقَها الشُهُبُ",81,"ب",1,0],["لم يلقب ذخر الأئمة إلا","وهو كنز لملكهم مذخور",82,"ر",1,0],["لم يلقني إذ جئته","إلا بمطل واعتذار",83,"ر",1,0],["لم يلق نازلة بقلب خافق","أبداً ولم يرجع بسعي مخفق",84,"ق",1,0],["لم يلق عندك غير البر قادمة","ولا تزود غير البر راحلة",85,"ل",2,0],["لم يلتفت كماله","لعلة من العلل",86,"ل",1,0],["لم يَلتَئم في الرأسِ جُرحٌ قد بَدا","حتى تَركتُم جُرحَ قلبي يَقطُرُ",87,"ر",1,0],["لم يَلْتَفِتْ قَطُّ للأَيامِ مُقْبِلةً","ولم يبالِ بإِقلال وإِكْثَارِ",88,"ر",1,0]]}