لَيأسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86326&r=&rc=9",""],[6212,"فيفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1620&r=&rc=1",""],[6251,"صديقُ المجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76479&r=&rc=19",""]],"verses":[["لَم يَلبَسِ الثَوبَ مِن تَوَقُّعِهِ","الأَمرَ إِلّا وَظَنَّهُ كَفَنا",0,"ن",2,0],["لَم يَلحَقوا فيها بِشَأوِكَ بَعدَما","أَمَلوا فَعاقَهُمُ اِعتِراضُ الأَزلَمِ",1,"م",1,0],["لَم يَلقَ مِن دوني لَهُ مَصرِفاً","وَلَم أَجِد مِن دونِهِ مَوئِلا",2,"ل",2,0],["لَم يَلقَكَ المَغرورُ إِلّا غَدا","يُقَوِّمُ الجَنبَ عَلى المَصرَعِ",3,"ع",1,0],["لمّيل يلهو بي كما","يهوى التجنّي والتعدّي",4,"د",2,0],["لمْ يَلْقَ بعْدَكَ ما يَلَذُّ لناظِري","منْ حُسْنِ أرْجاءٍ وزَهْرِ بِطاحِ",5,"ح",1,0],["لَم يُلهِني اللَهوُ عَنهُ حينَ أَرقُبُهُ","وَلا اللَذاذَةُ مِن كَأسٍ وَلا الكَسَلُ",6,"ل",1,0],["لَم يَلوِهِ المالُ عَن رَأيٍ يَدينُ بِهِ","وَلَو حَمَلتَ إِلَيهِ الدَهرَ مَلآنا",7,"ن",2,0],["لَم يَلوِهِ عَنها الوَعيدُ وَلا ثَنى","مِن عَزمِهِ قَولُ المُريبِ حَذارِ",8,"ر",1,0],["لم يُلهِكَ النَّزْعُ عن تأييدِ دَولَتها","وللمَنِيَّةِ آلامٌ تُعانيها",9,"ي",3,0],["لَم يُلهِكَ الإِثراءُ عَن طَلَبِ العُلا","بِالجِدِّ لا بِتَصَيُّدِ الأَلقابِ",10,"ب",1,0],["لم يلق من أبنائه والدٌ","بعض الذي تلقى من البر",11,"ر",1,0],["لَمْ يَلْتَمِسْ فِي الْعَيْشِ إِلاَّ غَايَةً","تُرْضِي الإِبَاءَ وَطَاهِرِ الْوِجْدَانِ",12,"ن",1,0],["لَمْ يُلْفَ يَوْماً مَنْ يَفِي كَوَفَائِهِ","فِيمَا بَلاهُ مِنَ الحَمِيمِ حَمِيمُ",13,"م",1,0],["لَم يُلقَ أَخبَثُ يا فَرَزدَقُ مِنكُمُ","لَيلاً وَأَخبَثُ بِالنَهارِ نَهارا",14,"ر",2,0],["لم يَلهُ في المِهْرجانِ أَوْلَى","باللهوِ فيه من ابن يحيى",15,"ا",1,1],["لم يلفح الصيفُ له صفحةً","ولا سقاه عُودهُ الشاسبُ",16,"ب",1,0],["لم يلحقوا شأوهُ ولو فعلوا","أمكن أن يسبِق امرؤٌ قدَره",17,"ر",2,0],["لم يُلفِه الغمز خواراً وتعطفه","بالرفق منك فتلقى منه عطافا",18,"ف",2,0],["لَم يُلهِهِ عَن سَوامِ الخَيرِ قَد عَلِموا","أَمرُ الضَعيفِ وَلا مِن حِلمِهِ البَطَرُ",19,"ر",1,0],["لَم يَلبِسوا بُردَ النَبِيِّ وَإِنَّما","لَبِسوا طُقوسَ الرومِ إِذ لَبِسوكِ",20,"ك",1,0],["لَم يَلقَ قَبلَكَ مَن إِذا اِختَلَفَ القَنا","جَعَلَ الطِعانَ مِنَ الطِعانِ مَلاذا",21,"ذ",2,0],["لَم يَلقَ سائِلَهُ مُذ كانَ سائِلُهُ","إِلّا بِوَجهٍ أَغَرِّ الوَجهِ مُبتَسِمِ",22,"م",1,0],["لَم يَلقَها إِلّا بِشِكَّةِ حازِمٍ","يَخشى الحَوادِثَ عازِمٍ مُستَعدِدِ",23,"د",1,0],["لَم يَلقَ مَرحَبُ مِنهُ مَرحَباً وَرَأى","ضِدَّ اِسمِهِ عِندَ هَدِّ الحِصنِ وَالأُطُمِ",24,"م",1,0],["لَم يُلهِني عَنهُ ما أَلهاهُ بَل عَذُبَت","عِندي الصَبابَةُ إِذ جُرِّعتُها فيهِ",25,"ي",2,0],["لَم يُلبِسِ اللَهُ نوحاً فَضلَ نِعمَتِهِ","إِلّا لِما بَثَّهُ مِن شُكرِهِ نوحُ",26,"ح",1,0],["لم يَلْقَ في قلبِها غِلٌّ ولا دَنَسٌ","لهُ محلاً ، ولا خُبْثٌ ولا حَسد",27,"د",1,0],["لم يَلْقَِ قَيْسٌ في هَوى ليلاه ما","لاقَى ولا ابنُ خزامَ في عَفرائِهِ",28,"ا",3,0],["لَم يَلبِسِ التاجَ حَتّى راحَ يَخلَعُهُ","مُشَرَّداً في فِجاجِ الأَرضِ يَغتَرِبُ",29,"ب",1,0],["لَم يُلهِهِ أَرَبٌ وَلَم يَقعُد بِهِ","قَولُ المُغَرِّرِ أَلقِ رَحلَكَ وَاِقعُدِ",30,"د",1,0],["لَم يُلفَ إِلّا دَنِسَ الأَثوابِ","مُهَوَّساً مُهَوِّسَ الأَصحابِ",31,"ب",1,0],["لم يلْقَ جالوتُ من داودَ ما لِقيَتْ","شُراتُهُ منك في حَلٍّ وفي رِحَل",32,"ل",1,0],["لَم يَلقَ ذو المَجدِ ما لاقَيتَ مِن قُرُمٍ","صُمٍّ عَنِ الخَيرِ بِالقُرآنِ جُحّادِ",33,"د",1,0],["لَم يَلقَ مِثلي في مُواظَبَةٍ","لِشِفائِها مِمَّن صَبا وَصَحا",34,"ح",2,0],["لم يلبثِ القومُ حتّى قال قائلُهم","فِيمَ الحوارُ وهل في الأمرِ من جَدَلِ",35,"ل",1,0],["لم يله عنه الدهر في عيشة","واللهو لا يخلد عزاً لها",36,"ه",2,0],["لَمْ يَلْبَثَا مُتَآزِرَيْنِ بِنِيَّةٍ","مَصْدُوقَةٍ فِي خُفْيَةٍ وَجِهَارِ",37,"ر",1,0],["لَمْ يُلْفَ قَبْلاً مُوْكبٌ بِجلاَلِهِ","وَسِعَ الأَمِيرَ وَضَاقَ بِالصَّعْلُوكِ",38,"ك",1,0],["لَمْ يُلْفَ إِلاَّكَ عَبْقَرِيٌّ","رَدَّ بِهِ شَمْلَهَا جَمِيعَا",39,"ع",2,0],["لم يلبسا ريش الهوى لكنما","هو ريش احلام وريش أمان",40,"ن",1,0],["لَم يَلو وُجودُ شيبي بَل","فَقدُ الهِلالِ الَّذي أَلاحَ لَوى",41,"ل",3,0],["لم يلن عودُهُ، وكم كبيرٍ","عجمت عودَهُ الخطوبُ فلانا",42,"ن",2,0],["لم يَلقَ قبرًا فوق أرضٍ طالما","فتحتْ له أحْضانها ترحيبا",43,"ب",2,0],["لم يلهني اللهو عنه حين أرقبه","ولا اللذاذة في كأس ولا شغل",44,"ل",1,0],["لم يُلْقَ في رُوعٍ لها خوْفُ صارِمٍ","ففازَ بطُهْرٍ مِن تُقَى الموْتِ رُوعُها",45,"ع",3,0],["لم يلق إلاّ ثبات العزم متقداً","وشدّة الصبر لا وهناً ولا لينا",46,"ن",2,0],["لم يلْفَ يوماً في الجوابِ مقصراً","وبيانهُ لما يُشَبْ بخفاءِ",47,"ا",2,0],["لم يلبسوا الأدراع إلا رِيبةً","لا خيفةً من أبيضٍ أو أسمرِ",48,"ر",1,0],["لَم يَلقَ عَنها وازِعاً مِن رَأيِهِ","حَتّى اِنبَرَت أَعضاؤُهُ تَتَوَزَّعُ",49,"ع",1,0],["لم يله مهنا الشيب عن خوفه","والعبد غير الله لن يلهمه",50,"م",2,0],["لم يلتمس ماءَ الحياةِ بجَهْدِهِ","لو كانَ ذُو القَرنينِ منهُ ذائقا",51,"ق",2,0],["لَم يَلتَفِت أَحَدٌ إِلَيهِ وَلَم يَجِد","إِلّا نَداكَ فَكُنتَ خَيرَ مُعَولِ",52,"ل",1,0],["لم يُلْفَ فيه سوى الفرارِ أو الردى","فاخترتَ صَرْفَ الموتِ وهو زؤام",53,"م",1,0],["لم يلن إلا بمطرقة","من قضاء اللَه أو قدره",54,"ر",2,0],["لم يلههم عن غداء البيض غانية","ولا عن الاسمر العسال معسول",55,"ل",1,0],["لَم يَلقَهُ مِنهُم فَتاةٌ أَو فَتى","إِلّا بِقَلبٍ نَيِّرٍ جَذلانِ",56,"ن",1,0],["لَم يَلقَهُ يَوماً بِوَجهٍ باسِر","لَكَأَنَّهُ ما كانَ ذا شَنَآنِ",56,"ن",1,0],["لَم يَلْبثِ المَكروهُ فيها أنْ نَأى","لمّا دَنا المَحبوبُ دونَ رَقيبِهِ",57,"ب",2,0],["لَم يُلفَ إِلّا لِلجَميلِ آلِفاً","فاعِلَ خَيرٍ صافِحاً عَن جُرمِ",58,"م",1,0],["لَم يَلقَ في دُنياهُ هَم","مَن زارَهُ وَلا نَدِم",59,"م",1,0],["لم يلح فجر عمرها ولقد لاح","على مفرقيك أثر الخضاب",60,"ب",1,0],["لَم يَلتَزِم شَيئاً سِوى","لزوم ما لا يَلزَمُ",61,"م",1,0],["لَم يَلبَثِ الكُلَّ إِن كَلَت عَواهِنَهُم","وَبانَ عَنهُم مَحابيهِم وَعائِنَهُم",62,"م",1,0],["لَم يَلقَ قَلباً حُبُّهُ قالِياً","إِلّا بِهِ مِن حَبِّهِ لَطخُ",63,"خ",1,0],["لمْ يلْحَقوكِ ولنْ لَوْ أنهُمْ ركَضُو","عِشْرينَ قرْنًا وَقَرْنا خلفَ قافلتي",64,"ت",2,0],["لم يلبثِ الدستُ به أن يَبطُلا","ويهدم المجدَ وتَسمَح العلا",65,"ل",2,0],["لَم يلج آذانَهُم شع","ريَ لا صُمَّ صَداها",66,"ا",3,0],["لم يَلِنْ للدَّهر منِّي جانب","حيث لم أستعطف القومَ اللّئاما",67,"م",2,0],["لم يلد مثل أبيهم والدٌ","لم يلد قبل ولا من بعد يولد",68,"د",1,0]