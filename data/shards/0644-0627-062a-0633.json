oetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42548","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42628","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42709","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55188","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54676","المجتث"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12745","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/142343","البسيط"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10402","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142339","الرمل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205801","الخفيف"],[106,"إلى القائد المظفر","https://www.poetsgate.com/ViewPoem.aspx?id=179595",""],[106,"حفل زواج","https://www.poetsgate.com/ViewPoem.aspx?id=179388",""],[106,"على الأعراف","https://www.poetsgate.com/ViewPoem.aspx?id=179633",""],[106,"رسل الثقافة","https://www.poetsgate.com/ViewPoem.aspx?id=179609",""],[106,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[106,"تحية وقضية","https://www.poetsgate.com/ViewPoem.aspx?id=179292",""],[100,"راهب الفن","https://www.poetsgate.com/ViewPoem.aspx?id=50160",""],[90,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[90,"تحت ظل النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=179087",""],[45,"أعادَ شَكوى منَ الطّيفِ الذي اعتَادَا","https://www.poetsgate.com/ViewPoem.aspx?id=31633",""],[45,"غلّسَ الشّيبُ، أوْ تَعجّلَ وِرْدُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32940",""],[80,"تفشي يداكَ سرائر الأغمادِ","https://www.poetsgate.com/ViewPoem.aspx?id=3154",""],[99,"لا تسألوني مااسمه حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=556",""],[51,"ذُكِر الأخفشُ القديمُ فقُلنا","https://www.poetsgate.com/ViewPoem.aspx?id=30256",""],[51,"لم أتخذ منك غير متخَذِ","https://www.poetsgate.com/ViewPoem.aspx?id=28614",""],[105,"يا مالكا عنت الوجوه لعزه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55045&r=&rc=215",""],[100,"لا اكتراث","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67636&r=&rc=124",""],[87,"ذهبَ الصبا ، وَ تولتِ الأيامُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23776&r=&rc=38",""]],"verses":[["لا تَسمَعَن قَولَ الوُشاةِ وَمِن","غَرَسَ الأَضالِعَ لي عَلى الإِحَنِ",0,"ن",1,0],["لا تَسبِريني بِغَربِ عَذلِكِ لي","فَما لِجُرحي مِنَ النَدى أَلَمُ",1,"م",1,0],["لا تَستَشِر غَيرَكَ في كَيِّها","قَد بَلَغَ الداءُ إِلى المَيسَمِ",2,"م",1,0],["لا تَستَلينُهُمُ الضَرّاءُ نازِلَةً","وَلا تَقودُهُمُ الأَطماعُ وَالنُجَعُ",3,"ع",1,0],["لا تَسقِني ماءَ الحَياةِ بِذِلَّةٍ","بَل فَاِسقِني بِالعِزِّ كَأسَ الحَنظَلِ",4,"ل",1,0],["لا تسْتَوي الأعْيانُ فضْلَ مزيّةٍ","وطَبيعةً فطرَ الإلاهُ وَسُوسا",5,"س",2,0],["لاَ تَسَلْ عَنْ رَجْعَتِي كَيْفَ كَانَتْ","إِنَّ يَوْمَ الْبَيْنِ يَوْمٌ عَصِيبُ",6,"ب",1,0],["لاَ تَسْتَقِرُّ عَلَى التَّنَافُسِ صُحْبَةٌ","وَمَوَدَّةُ الأَكْفَاءِ أَمْرٌ يَصْعُبُ",7,"ب",1,0],["لا تَسأَلوهُ وَاِسأَلوا دارَهُ","فَإِنَّها تُخبِرُ عَمّا نَهَب",8,"ب",1,0],["لا تَسأَموا الإِدلاجَ حَتّى تُدرِكوا","بيضَ الأَيادي وَالجَنابَ الأَخضَرا",9,"ر",2,0],["لا تَسمَعَنَّ حَديثَ مَلكٍ غَيرهِ","يُروى فَكُلُّ الصَّيدِ في جَوفِ الفَرا",9,"ر",2,0],["لا تَستَجِز وَضعَ قَدَري بَعدَ رَفعِكَهُ","فَاللَهُ لا يَرفَعُ القَدرَ الَّذي تَضَعُ",10,"ع",1,0],["لا تَسألِ اليَومَ عَمّا كابدت كَبدي","لَيتَ الفِراقَ وَلَيتَ الحُبَّ ما خُلِقا",11,"ق",2,0],["لا تَسمَنُ الدَهرَ في أَرضٍ وَإِن رَتَعَت","فَإِنَّما هِيَ تَحنانٌ وَتَسجارُ",12,"ر",1,0],["لا تَسأَمي أَن تَجودي غَيرَ خاذِلَةٍ","فَيضاً كَفَيضِ غُروبٍ ذاتِ أَوشالِ",13,"ل",1,0],["لاَ تَسْطَعُ الشَّمْسُ إِلاَّ خَلْفَ غَاشِيَةٍ","مِنَ الأسَى بمُحْيّا كَاسِفٍ شَحِبِ",14,"ب",1,0],["لاَ تَسْتَبِينَ بِهِ سُرُو","راً إِنْ نَظَرْتَ وَلاَ اكْتِئَابَا",15,"ب",2,0],["لا تَسْأَلُونِي وَقَدْ لاقَيْتُ مَا سَمَحَتْ","بِهِ مَكَارِمُكُمْ عَمَّا تَوَلاَّنِي",16,"ي",1,0],["لا تَسْأَلُونِي وَقَدْ وُلِّيْتُ مَا سَمَحَتْ","بِهِ مَكَارِمُكُمْ عَمَّا تَوَلاَّنِي",16,"ي",1,0],["لا تَسأَلِنَّ عنِ الثِّيابِ فَإِنَّني","يومَ اللِّقَاءِ على الكُماةِ مُشِيحُ",17,"ح",1,0],["لا تسقِ غير الروض فضلة كأسها","فالغصن في ذيل الأزاهر قد عثرْ",18,"ر",1,0],["لا تستنيموا للزمان فأخذه","خلسٌ وقوس الحادثات ضروح",19,"ح",1,0],["لا تسأل البلبل عمّا مضى","في زمن الورد له من دعه",20,"ه",1,0],["لا تستقرّ بحالة فكأنها","أمل به تتقاذف الأوهام",21,"م",1,0],["لا تسأمَنّ إذا حاولت منزلةً","فيها يرِفّ عليك المجد والكرم",22,"م",1,0],["لا تسل عنه وزير ال","قَوم واسأل مستشاره",23,"ر",2,0],["لا تستنيموا للزمان توكُّلاً","فالدهر نزّاءٌ له وثبات",24,"ت",1,0],["لا تستهينوا بنا من ضعف قوتنا","فكم ذبابة غاب أزعجت نمرا",25,"ر",2,0],["لا تسابق في حلبة العزّ ذا العل","م فما للهجين شأو الجواد",26,"د",1,0],["لا تَسأَليني ما الَّذي بِيَ بَعدَما","زَوَّدتِني بِلِوى التَناضُبِ زادي",27,"ي",1,0],["لا تَسأَموا لِلمَطايا ما سَرَينَ بِكُم","وَاِستَبشِروا بِنَوالٍ غَيرِ مَنزورِ",28,"ر",1,0],["لا تَسقِني بِيَدَيكَ إِن لَم أَلتَمِس","نَعَمَ الضَجوعِ بِغارَةٍ أَسرابِ",29,"ب",1,0],["لا تَستُري قِدري إِذا ما طَبَختُه","عَلَيَّ إِذا ما تَطبُخينَ حَرامُ",30,"م",1,1],["لا تَسُبَّنَّني فَلَستَ بِسَبّي","إِنَّ سَبّي مِنَ الرِجالِ الكَريمُ",31,"م",1,0],["لا تستقرُّ يداه في أمواله","فكأنَّما هو سابحٌ في ماء",32,"ا",2,0],["لا تسألن عن طبّها متأمِّلاً","واسأل به دونَ الملوكِ تجارِبا",33,"ب",2,0],["لا تسل عن حال عبدك في","زمنٍ مستحكم المغَث",34,"ث",1,0],["لا تستقرّ بكفه أمواله","فكأنها نومٌ بمقلة أرْمد",35,"د",1,0],["لا تسلْ عن مسيل دمعي بخدِّي","قتلَ الدمعُ صاحب الأخدود",36,"د",1,0],["لا تسمعنَّ حديثَ القوم في شرفٍ","حديثُ غيرك موضوعٌ ومتضع",37,"ع",1,0],["لا تسمعنَّ بأنَّ قلبي قد سلا","ذاكَ الزمان وذاكَ قول مختلق",38,"ق",1,0],["لا تسألوا كيفَ حالي منه ممحلة","ما حال فرع نبات يشتكي وَرَقه",39,"ق",2,0],["لا تسل عن حديث دمعيَ لمَّا","ظعنَ الركب واستقل الفريق",40,"ق",1,1],["لا تسأل الصبّ عن سلسال أدمعه","ملذّذاً بتعاطيها وسلْ سالي",41,"ي",1,0],["لا تسألوا في الحبّ عن شاني","فقد كفى تعبير أجفاني",42,"ي",1,1],["لا تسألوا ما جرى من فيضِ أدمعنا","فيكم وما قد جرى من غدركم فينا",43,"ن",2,0],["لا تسلني عن حال عائلتي في","ه فإني من أمرهم في جنون",44,"ن",1,0],["لا تسلّيت ولا قل","ت لألحاظك مهلا",45,"ل",2,0],["لا تَسأَمَنَّ مَقالَتي يا صاحِ","وَاِقبَل نَصيحَةَ ناصِحٍ نَصّاحِ",46,"ح",1,1],["لا تسفه دنيا قريش تبوئك","من الملك ذروة العلياء",47,"ا",2,0],["لا تُسْلَبَنَّ يدٌ قد أمَّلت بكمُ","ما أمَّلتْه فلا حرمانَ كالسَّلبِ",48,"ب",1,0],["لا تسبكَنَّ الكرامَ إنهمُ","أصفى نفوسٍ أَوتْ إلى جُثَثِ",49,"ث",1,0],["لا تُسَقرِط يا أبا يح","يى أخا نَيكِ العجائزْ",50,"ز",1,1],["لا تَسترث ما أعدَّه لكما","وارضَ لعَيرَينِ نبلَ عِكراش",51,"ش",1,0],["لا تسْمُ عينُك في العيو","ن فلو عقلتَ لطال غضُّك",52,"ك",1,0],["لا تسيئي ملك المماليك والمم","لوكُ ذو واجبٍ على الملاك",53,"ك",1,0],["لا تسائلْ به سواه من النا","س تجده بحضرةِ الحفلِ حَفْلا",54,"ل",2,0],["لا تسمُ الحمدَ أبا أحمدٍ","فليس ذاك العِلقُ من بالهِ",55,"ل",2,1],["لا تسخطنّ على الإله فإنما","أعمالُ طعنِ فحولها بالفَيْشلِ",56,"ل",1,0],["لا تستحيلُ عهودُه","والمِسكُ معدومُ الحُموم",57,"م",1,0],["لا تسجُنَنَّ الهمَّ عندك إنه","ما زال مسجوناً يعذِّبُ ساجنا",58,"ن",2,0],["لا تَسَلني عَنِ السَماءِ فَما عِندِيَ","إِلّا النُعوتُ وَالأَسماءُ",59,"ا",2,1],["لا تَسأَلوني المَدحَ أَو وَصفَ الدُمى","إِنّي نَبَذتُ سَفاسِفَ الشُعَراءِ",60,"ا",2,0],["لا تَسأَلوا العاشِقَ عَن قَلبِهِ","قَد ضاعَ بَينَ الضِحك وَاللَعِبِ",61,"ب",1,0],["لا تَسأَليني لِما سَهِدتُ فَإِنَّني","لَو كانَ في وُسعي الكَرى لَم أَسهَدِ",62,"د",1,0],["لا تَسَل أَينَ الهَوى وَالكَوثَرُ","سَكَتَ الشادي وَبُحَّ الوَتَرُ",63,"ر",1,1],["لا تَستَطيعُ الخَمرُ سَردَ صِفاتِها","وَالرَوضُ وَصفَ زُهورِه وَنَباتِهِ",64,"ه",1,0],["لا تَسَل ماذا عَراهُم كُلُّهُم يَجهَلُ أَمرَه","حائِرٌ كَالطائِرِ الخائِفِ قَد ضَيَّعَ وَكرَه",65,"ر",2,0],["لا تَسأَليني كَيفَ أَصبَحَ حالُهُم","إِنّي أَخافُ حَديثُهُم يُشجيكِ",66,"ك",1,0],["لا تَسقِني الراحَ إِلّا عِندَ ذِكرِهِمُ","أَو ذِكرِ قائِدِهِم أَو ذِكرِ ما فَعَلوا",67,"ل",3,0],["لا تَسأَلوني اليَومَ عَن قيثارَ