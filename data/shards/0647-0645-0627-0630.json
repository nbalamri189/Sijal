{"poems":[[29,"ألا حي المنازل والخياما","https://www.aldiwan.net/poem6017.html","الوافر"],[53,"أيها الماجد الذي بهر المداح","https://www.aldiwan.net/poem65475.html","الخفيف"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[147,"ظن الأراك لدى واديه أظعانا","https://www.aldiwan.net/poem11832.html","عموديه"],[415,"يا ناق شطت دارهم فحني","https://www.aldiwan.net/poem32367.html","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119903","المنسرح"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75730","الرمل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45703","الوافر"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65122","البسيط"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99364","البسيط"],[6052,"الطيف النزيل بمقلتي","https://www.poetsgate.com/ViewPoem.aspx?id=50261",""]],"verses":[["هُما ذادا لِخِندِفَ عَن حِماها","وَنارُ الحَربِ تَضطَرِمُ اِضطِراما",0,"م",2,0],["هم إذا شئتَ نحل شهدٍ وإن شِئ","تَ أفاعٍ رقشٌ تمجُّ الزعافا",1,"ف",2,0],["هم اذا الخيل ارتجحن بحرها","في مأزق الروع تراموا للردى",2,"ا",1,0],["هَمٌّ إِذا ما عَرى أَفضى إِلى هِمَمٍ","جاوَرنَ بَهرامَ أَو جاوَزنَ كيوانا",3,"ن",2,0],["هُمُ إذا قُلتُ سقَى أرضَ الحِمَى","وبَانَه صوبُ الحيَا مَن أعْنِي",4,"ن",2,0],["هم إذا سوا جلوا بحار","تطمي وإن حولموا جبالُ",5,"ل",1,0],["هم أَذاعوا عني أقاول هجر","أَثمرَت هجر صادق لا يشابه",6,"ب",2,0],["هُما ذوبان لَو جَمَدا جَميعاً","إِذا صارا مَعاً وَرَقاً وَعَينا",7,"ن",2,0],["هُم أذعنوا طاعة من خوفهم وأتى","كلٌّ إليك بثوب الذُّلّ مُتّزرا",8,"ر",2,0],["هم إذا خلطوا شعري بشعرهم","كالطير يهذون أو يحكمون ما سمعوا",9,"ع",3,0],["هما ذهبا والقلب يحمل حسرة","وأنت كريم فاستجب لي دعائيا",10,"ي",2,0]]}