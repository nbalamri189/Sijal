{"poems":[[57,"أغيب عنك بود لا يغيره","https://www.aldiwan.net/poem26046.html","البسيط"],[75,"أعرفك راح في عرف الرياح","https://www.aldiwan.net/poem11940.html","الوافر"],[26,"هل الدهر إلا ليلة ونهارها","https://www.aldiwan.net/poem24105.html","الطويل"],[31,"أتعرف من أسماء بالجد روسما","https://www.aldiwan.net/poem6156.html","الطويل"],[93,"روحي التي بالأمس كانت ترتع","https://www.aldiwan.net/poem8723.html","عموديه"],[91,"أحس لو ينفعني حسي","https://www.aldiwan.net/poem44856.html","السريع"],[64,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[64,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[47,"أغيب عنك بود لا يغيره","https://www.aldiwan.net/poem66832.html","البسيط"],[51,"أفنيت عمرك باغترارك","https://www.aldiwan.net/poem62119.html","مجزوء الكامل"],[68,"برق المشيب قد أضا","https://www.aldiwan.net/poem40981.html","مجزوء الرجز"],[33,"خليلي مرا بي على رسم منزل","https://www.aldiwan.net/poem41841.html","الطويل"],[69,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[48,"أيا شجر العرا أوسعت ريا","https://www.aldiwan.net/poem22995.html","الوافر"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30474","البسيط"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/22684","الطويل"],[333,"تعاليت لا مولى سواك خلقتني","https://www.aldiwan.net/poem54954.html","الطويل"],[369,"حيث انتهيت من الهجران بي فقف","https://www.aldiwan.net/poem60841.html","البسيط"],[376,"دارت عيون في محاجر","https://www.aldiwan.net/poem57443.html","مجزوء الكامل"],[408,"رميت أسهم آمالي فلم تصب","https://www.aldiwan.net/poem46936.html","البسيط"],[445,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[458,"إلى الصديق خفاجفي عوالمه","https://www.aldiwan.net/poem61248.html","البسيط"],[463,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[466,"أعيذكم بمجدكم ومدحي","https://www.aldiwan.net/poem15378.html","الوافر"],[469,"إذا كنت ذا مجد رفيع فلا تهن","https://www.aldiwan.net/poem3533.html","عموديه"],[521,"دعا المحرمون الله يستغفرونه","https://www.aldiwan.net/poem48720.html","الطويل"],[534,"حسدوا علومي خاملا فأتيح لي","https://www.aldiwan.net/poem37430.html","الكامل"],[534,"مولاي يا فرد العلى والملا","https://www.aldiwan.net/poem37525.html","السريع"],[541,"يا عوف ويحك هلا قلت عارفة","https://www.aldiwan.net/poem23858.html","البسيط"],[556,"أدر أيها الساقي الكؤوس على صحبي","https://www.aldiwan.net/poem48063.html","الطويل"],[563,"ألا فتحقق أن كل استقامة","https://www.aldiwan.net/poem34206.html","الطويل"],[580,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122658","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48791","المتقارب"],[1002,"","https://poetry.dctabudhabi.ae/diwan/poem/26631","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119884","الرمل"],[1054,"","https://poetry.dctabudhabi.ae/diwan/poem/145938","السريع"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136362","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112824","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112765","الطويل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6770","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141267","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124722","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110254","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53170","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53051","الهزج"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27894","السريع"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28057","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28514","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121190","الطويل"],[2732,"","https://poetry.dctabudhabi.ae/diwan/poem/143370","الوافر"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68729","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100840","الطويل"],[3153,"","https://poetry.dctabudhabi.ae/diwan/poem/126067","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68025","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62773","الطويل"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145151","الرمل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102421","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110093","البسيط"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131954","الرمل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118744","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66121","البسيط"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136441",""],[4830,"حصاد العمر","https://www.poetsgate.com/ViewPoem.aspx?id=195090",""],[4832,"حيث الهزار شدا وغرد","https://www.poetsgate.com/ViewPoem.aspx?id=166698",""],[5121,"سُلْطَانُ الرُّوح","https://www.poetsgate.com/ViewPoem.aspx?id=49547",""],[5512,"أنا السُّوري","https://www.poetsgate.com/ViewPoem.aspx?id=205024",""],[5550,"أرى القلبَ","https://www.poetsgate.com/ViewPoem.aspx?id=210923",""],[5566,"المجد والعشاق","https://www.poetsgate.com/ViewPoem.aspx?id=192928",""],[5596,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=205612",""],[5701,"تعجبت حتى كدت لا أتعجب","https://www.poetsgate.com/ViewPoem.aspx?id=164590",""],[5703,"طفلةٌ بلهاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=210566",""],[5725,"شذى الروح","https://www.poetsgate.com/ViewPoem.aspx?id=191727",""],[5771,"صَوتٌ لا يَموت","https://www.poetsgate.com/ViewPoem.aspx?id=189449",""],[5897,"غداً القصاص","https://www.poetsgate.com/ViewPoem.aspx?id=160569",""],[6102,"يَارَا","https://www.poetsgate.com/ViewPoem.aspx?id=185333",""]],"verses":[["فَإِن أَعِش فَلَعَلَّ الدَهرَ يَجمَعُنا","وإِن أَمُت فَقَتيلُ الهَمِّ وَالحَزَنِ",0,"ن",1,0],["فَإِن أَعجِز فَإِنَّ النُصحَ ثَقفٌ","وَإِن أَشكُر فَإِنَّ الشُكرَ صاحِ",1,"ح",1,0],["فَإِن أَعتَذِر مِنها فَإِنّي مُكَذَّبٌ","وَإِن تَعتَذِر يُردَد عَلَيها اِعتِذارُها",2,"ر",3,0],["فَإِن أَعفُ عَنكُم يا نُعَيمُ فَغَيرُكُم","ثَنى عَنكُمُ مِنّي المُسَرَّ المُكَتَّما",3,"م",2,0],["فَأَنا عَلى ما ضاعَ مِنِّيَ جازِعُ","إِنَّ الَّذي قَد ضاعَ جَدُّ ثَمينِ",4,"ن",1,0],["فان اعش كان بها نقلتي","وان امت كان بها رمسي",5,"س",2,0],["فإن أعدتَ إليه الحلَّ ثانية","والعقد زادك صبغا على القدرِ",6,"ر",1,0],["فإنْ أعجبتهمْ نوبة سلفتْ لهم","فأنتَ لأُخرى ضامنٌ ووكيلُ",7,"ل",1,0],["فَإِن أَعِش فَلَعَلَّ الدَهرَ يَجمَعُنا","وَإِن أَمُت فَبِطولِ الشَوقِ وَالحَزَنِ",8,"ن",1,0],["فَإِنِ اِعتَبَرتَ بِما تَرى","فَكَفاكَ عِلماً بِاعتِبارِك",9,"ك",1,0],["فَإِن أَعِش صاحَبتُ دَه","ري عالِماً بِما اِنطَوى",10,"ا",1,0],["فَإِنّا عَلى أَن نُسعِفَ النَفسَ بِالهَوى","حِراصٌ فَما حاوَلتَ مِن ذاكَ فَاِفعَلِ",11,"ل",1,0],["فإنْ اعْتَذَرْتُ لَهُمْ عَنِ التَّقْصِيرِ في","مَدْحِي الوَزِيرَ فَحُجَّةُ الأَقْدامِ",12,"م",1,0],["فَإِن أُعطِ القَليلَ يَكُن هَنيئاً","يَجيءُ المُستَميحَ بِغَيرِ شَفِّ",13,"ف",1,0],["فإِنْ أَعِشْ فلعلَّ الدَّهْرَ يَجْمَعُنَا","وإِنْ أَمُتْ فَسَيَسقِيهِ كَذَا السّاقِي",14,"ق",2,0],["فَإِن أَعفُ يَوماً عَن ذُنوبٍ وَتَعتَدي","فَإِنَّ العَصا كانَت لِغَيرِكَ تُقرَعُ",15,"ع",1,0],["فأنا عبدكم ومالي سواكم","فالطفوا بي بفضلكم وارحموني",16,"ي",1,0],["فإن أَعِشْ بعدَهمْ فَرداً فيما عجَبي","وإن أَمُتْ هكذا وَجداً فيما أسَفي",17,"ف",2,0],["فإن اعتَرضتَ مُجاحِداً","لي في المقالَة أو مناكِر",18,"ر",1,0],["فإن أعدْ خائباً عن بابِكم فلقَدْ","قلّدتكمْ بعقُود الدرّ والذَّهب",19,"ب",1,0],["فإِنْ أَعلَقَتْ بك عِلْقَ الفخارِ","فأَنتَ الكفيلُ بِهَا والزعيمُ",20,"م",1,0],["فإن أعش في جنان كلها عجب","فإن قلبي بالتعذيب في النار",21,"ر",1,0],["فإن اعترتكم هفوةٌ أو صدّكم","غضبُ المنيل على الغَموطِ الكافرِ",22,"ر",1,0],["فانْ أعرضْتُم فبمن ألاقي","كماةَ فوارس الدهْرِ الغَشومِ",23,"م",1,0],["فإن أعالي الدوح تهصرها الصّبا","فتخضع في عليائها وتدين",24,"ن",1,0],["فَإن أعط لَيلى في حَياتي لَم يَتُب","إِلى اللَّهِ عَبدٌ تَوبَة لا أَتوبُها",25,"ب",3,0],["فَأَنا عَلَى الحالَيْن مَحْسُودٌ لَهُمْ","اللهُ أكبرُ لَسْتُ أُعْدَمُ حاسِدا",26,"د",2,0],["فإنّ أَعْيانَ جَميع الْوَرَى","إلَى مْحَيّا الْبَدْرِ في الْمَرْقَبِ",27,"ب",1,0],["فَإِن أَعِش أَجزِ عَوفاً عَن مَقالَتِهِ","شَرَّ الجَزاءِ بِما أَلفَيتُهُ طَبَعا",28,"ع",2,0],["فإنْ أَعْيَ عن شكرٍ لها من صنيعةٍ","فَذلك مِن ذنبِ البلاغةِ لا ذَنبي",29,"ب",2,0],["فإن اعوجاج القوس عين استقامة","له في يد الرامي فلا يتحول",30,"ل",1,0],["فإِن أَعْلَموه أَنَّه بعضُ عَاشِقٍ","فعزُّوا بِه المُلْكَ الَّذِي هُو قَصْرُه",31,"ر",2,0],["فإن أُعطَ ما لَم يُعَط غَيريَ حُظَوةً","فَلم يُعطَ عِلمَ الخَضرِ مُوسى ويُوشَعُ",32,"ع",1,0],["فإن أعجبته احتفالاتها","فقد نالها منك ما زانها",33,"ن",3,0],["فَإِن أَعتُب عَلَيكَ أَبا نِزارٍ","فَتَعتَبُني فَكُلَّكَ لي مُريبُ",34,"ب",1,1],["فأنا عيد الأيادي","وعبيد الشعر عبدي",35,"د",2,0],["فإنَّ إعْرَاضَكَ عن سَيِّدٍ","إليه يَدْعُوك عَجيبٌ عجيبْ",36,"ب",1,0],["فانا على ابواب فضلك نرتجي","نوالك فامنن يا كريماً بما نهوى",37,"و",2,0],["فانا عددناكم علينا وحزبنا","لذا جاءكم حسن الكمال ومفخر",38,"ر",1,0],["فإنا عثرنا والشفيع ملاذنا","وانا من اللَه به الفوز نطلب",39,"ب",1,0],["فَأَنا عَبدُهُ وَذاكَ فَخاري","وَجَمالي بَينَ الوَرى وَبَهائي",40,"ا",2,0],["فإنّا على عهد الوفا للساننا","ولو طال عهد الصّدّ بالهمّ والكرب",41,"ب",1,0],["فإن اعتدوا قبل الضحى فتصبحوا","وأتاهم العسفاء بالخبر",42,"ر",1,0],["فانا على الحالين ميت","لا يريد عذابها",43,"ب",3,0],["فإن أعجمت في أوجه القوم أحرفاً","أبى السيف إلا أن يبينها شكلا",44,"ل",2,0],["فإن أعوزني الرِّزق","فكم لي من تسابيبِ",45,"ب",1,0],["فإن أعادوه عليه فهم","ممن يري الإشراق من شرقه",46,"ق",2,0],["فَاِن أَعفُ عَنهُ أَغضِ عَيناً عَلى قَذىً","وَلَيسَ لَهُ بِالصَفحِ عَن ذَنبِهِ عِلمُ",47,"م",1,0],["فَإِن أَعرَضَت مِن دونِنا هَضَباتُهُ","وَوَدَّعَنا لُبنانُها وَسَنيرُها",48,"ر",3,0],["فإن اعدمتني بالبصيرة ثروتي","ومالي فما قد اعدمتني لسانيا",49,"ي",2,0],["فإنْ أُعَنِ اغتربتُ إلى كرامٍ","حُماةِ حقائقٍ في الروع شُوسِ",50,"س",1,0],["فإن اعوجاج القوس لا شك أنه اس","تقامته عن تلك لا يتحول",51,"ل",1,0],["فان اعجبوا بالقطب زدت اكتشافهم","من الغيب علماً وهو جم العجائب",52,"ب",1,0],["فان اعصى ريعان الشباب فطالما","اطعت اليه الجهل والحلم وافر",53,"ر",1,0],["فإن أَعِشْ دهراً فطو","لُ العيشِ أدنَى الحُلُم",54,"م",1,0],["فإنّا على خُبْثِ الزّمانِ وغدرهِ","لنشرعُ في أحداثِهِ والزّلازِلِ",55,"ل",1,0],["فأنا عبد ضعيف عاجز","عادم القدرة في كبح هوايا",56,"ا",3,0],["فإن أعطيتني عيناً بدين","فهاتي العين وانتظري ضماري",57,"ر",2,0],["فان اعجبَ ما تَلَقى وأَغرَبهُ","من ليسَ يَفرُقُ بينَ التِبر والتبنِ",58,"ن",1,0],["فأنا على عهد الأحب","ة والفتوة لا أتوب",59,"ب",1,0],["فإنّا على علم بأنّ من اعتدى","تعاجله النقمات من حيث لا يدري",60,"ر",2,0],["فإن أعتم نصحي","ظفرتم بالنجح",61,"ح",1,0],["فانا عَلَى الحالَيْنِ مُصْطَبِرٌ","مُتَنَعِّمٌ في عيشيَ الخَشِنِ",62,"ن",1,0],["فإن اعتناء المرء في نشر ما أتى","أبوه به في الخير من أعظم البر",63,"ر",1,0],["فانْ أعارتْك خيطَ القَزّ ناعمَه","تُحيلَهُ كَفَناً حين المماتِ غدا",64,"د",2,0],["فأنا عتيق هواهم","لكنه أبداً مجدد",65,"د",1,0],["فَأَنَا عَصَرْتُ مِنَ الثِّمَارِ لَذِيِذَهَا","وَسَكَبْتُ كَأْسِي لِلْقُلُوبِ مُسَكِّنَا",66,"ن",2,0],["فأنا عزيزٌ في مضارِبِه","لا الفقرُ يؤلمني ولا القَفْرُ",67,"ر",1,0],["فإنَّ اعْتناءَكَ يبْقى له","مُهمًّا ليطرقَ بابَ الشفاء",68,"ا",2,0],["فأنا عشقت وكان لي مجد وما","أيقنت أن العشق فيه مهالك",69,"ك",1,0],["فإنا على مُرّ الزمان أحبةٌ","وإنّا على مَرّ الزمان شباب",70,"ب",1,0],["فإن أعرضوا طارت قواف صريحة","لها شعل مشبوبة تتلهب",71,"ب",1,0],["فأنا على كلِّ الملوكِ مليكةٌ","وأمامَ حُبّكَ طفلةٌ بلهاءُ",72,"ا",2,0],["فانا على السر الدفين مؤمّن","ماكنت اخدش بالهوى كسفيهِ",73,"ي",2,0],["فَأَنَا عَلَى عَهْدِي وَمُعْتَقَدِي","باقٍ وإنْ نَكَثُوا وإنْ خَرَقُوا",74,"ق",3,0],["فإن اعتراك الخوف فانصب سلماً","نحو السماء تشده الأحبال",75,"ل",1,0],["فَإِنْ أَعلَنَا صَدِّي - فَوَ اللهِ - إِنَّنِي","لَأَعلَمُ أَنَّ التَّوقَ - فِي الجَوفِ - أَسرَرا",76,"ر",2,0]]}