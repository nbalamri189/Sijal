{"poems":[[66,"إني لأكتم من علمي جواهره","https://www.aldiwan.net/poem67543.html","البسيط"],[53,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[53,"يا رب جري شواء مررت به","https://www.aldiwan.net/poem66771.html","البسيط"],[63,"يا رب جسم كله نواظر","https://www.aldiwan.net/poem51618.html","الطويل"],[51,"الجود لا ينفك حامده","https://www.aldiwan.net/poem63119.html","السريع"],[54,"يا رب جاري نهر فضي","https://www.aldiwan.net/poem26566.html","الرجز"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/12718","البسيط"],[108,"فاجعة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=179419",""],[108,"على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179312",""],[108,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[108,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[108,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[164,"ما خاب من في الله كان رجاه","https://www.aldiwan.net/poem59130.html","الكامل"],[190,"إني لأكتم من علمي فواضله","https://www.aldiwan.net/poem43209.html","البسيط"],[240,"يا قالة الشعر أما","https://www.aldiwan.net/poem31626.html","مجزوء الرجز"],[286,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[396,"يا رب جئناك نطلب منك مالايعد","https://www.aldiwan.net/poem54593.html","عموديه"],[398,"يا وصل مالك لا تعاود","https://www.aldiwan.net/poem53658.html","مجزوء الكامل"],[408,"لو كان يعلم أنها الأحداق","https://www.aldiwan.net/poem46984.html","الكامل"],[412,"لمن الرسوم بعرصة البردان","https://www.aldiwan.net/poem50100.html","الكامل"],[534,"متى أرى الحق يصفو من تكدره","https://www.aldiwan.net/poem37242.html","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59112","الكامل"],[1116,"","https://poetry.dctabudhabi.ae/diwan/poem/117073","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112747","الكامل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6763","السريع"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128696","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108806","المجتث"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77419","المجتث"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77347","البسيط"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88649","الرجز"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126194","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93887","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204653","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109955","الكامل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118742","المجتث"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117945","الكامل"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122244","المجتث"],[3837,"","https://poetry.dctabudhabi.ae/diwan/poem/114685","السريع"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59461","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59499","الرجز"],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20891","البسيط"],[4858,"أشواق قلب","https://www.poetsgate.com/ViewPoem.aspx?id=139898",""],[4859,"أوردة النعيم!","https://www.poetsgate.com/ViewPoem.aspx?id=210845",""],[4921,"بك أستجير فمن يجير سواكا","https://www.poetsgate.com/ViewPoem.aspx?id=3652",""],[4955,"يأتيكَ شيطانٌ يوسوسُ قائلاً","https://www.poetsgate.com/ViewPoem.aspx?id=187864",""],[5015,"جزيت خيرا","https://www.poetsgate.com/ViewPoem.aspx?id=210870",""],[5042,"يا رب جفني قد جفاه هجوعه","https://www.poetsgate.com/ViewPoem.aspx?id=211627",""],[5121,"عَجَبِي","https://www.poetsgate.com/ViewPoem.aspx?id=33572",""],[5694,"البيعة","https://www.poetsgate.com/ViewPoem.aspx?id=129888",""],[5720,"يا رب","https://www.poetsgate.com/ViewPoem.aspx?id=199969",""],[5730,"يا رب","https://www.poetsgate.com/ViewPoem.aspx?id=210364",""],[5742,"مناجاة ودعاء","https://www.poetsgate.com/ViewPoem.aspx?id=206896",""],[5842,"يا ربّ عفوك / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=136527",""],[5956,"نفس المنظر","https://www.poetsgate.com/ViewPoem.aspx?id=182120",""],[6075,"الْمَوْتُ أَطْلَقَ سَهْمَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=210328",""],[6101,"زمرة الشيطان / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120281",""],[6101,"بشرى السماء / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120279",""],[5616,"أمي ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1926&r=&rc=1",""],[6259,"لمن الرسومُ بعرصة ِ البردانِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59405&r=&rc=53",""]],"verses":[["يا رُبَّ جَوهَرِ عِلمٍ لَو أَبوحُ بِهِ","لِقيلَ لي أَنتَ مِمَّن يَعبدُ الوَثَنا",0,"ن",2,0],["يا رُبَّ جِدٍّ لكم في العلى","قد جعل المالَ لكم ملعبا",1,"ب",2,0],["يا رُبَّ جَرِّيِّ شَوّاءٍ مررتُ بهِ","كأنه فِدَرُ الفالوذِ مَشْوِيِّ",2,"ي",1,1],["يا رُبَّ جسمٍ كلُّه نواظرُ","بآمُقٍِ ليسَت لها مَحاجرُ",3,"ر",1,1],["يا رُبَّ جيلٍ قَد سَمِعتُ بِهِ","وَرَأَيتُ قَد هَمَدَت خَضارِمُهُ",4,"م",2,0],["يا رُبَّ جاري نَهَرٍ فِضِّيِّ","مُضطَرِبٍ عَلى حَصىً نَقِيِّ",5,"ي",1,1],["يا رُبَّ جارِيَةٍ أَسبَلَتُ عَبرَتَها","مِن رِقَّةٍ وَلِغَيري قَلبُها قاسِ",6,"س",1,0],["يا رُب جسم منحنِ","لم ينج صاحبَه انحناؤه",7,"ا",3,0],["يا رُبَّ جارية في البحر كالعلم","تراقصت فوق موج منه ملتطم",8,"م",1,1],["يا رُبَّ جاريةٍ من فوقِه خطَرَتْ","تُنْمَي إلى عاهلٍ من آلِ سَاسَانا",9,"ن",2,0],["يا رُبَّ جنديِّ بدا","لك «بيدقًا» في ثوب «شاه»",10,"ا",2,0],["يا رُبَّ جبَّارٍ يصول بجنده","أمسى بأيدي جنده مصلوبا",11,"ب",2,0],["يا رب جودك قد دعا لمطامعي","الثقل منك وقد اجيز دعاه",12,"ا",2,0],["يا رب جوهر علم لو أبوح به","لقيل إنك ممّن يعبد الوثنا",13,"ن",2,0],["يا رَبِّ جَنِّبَنا طَما","عاتِ النُفوسِ المُردِيَه",14,"ي",2,0],["يا رب جاز أبي عني الخلود بها","يا رب بوِّئه من فردوسها الغرفا",15,"ف",2,0],["يا رب جده من الرحمى بأكرمها","سحاً واحسنها فوق الزبا وطفا",15,"ف",2,0],["يا رب جئناك نطلب منك مالايعد","وليس يحصى بمقدار وليس يحد",16,"د",1,1],["يا رب جيناك نطلب منك كشف الشدد","تبدل الخوف أمنا والغلا بالرغد",16,"د",1,0],["يا رَبّ جَنِّبني العَوا","ئِقَ مُجزِلَ النِعمِ العَوائِد",17,"د",1,0],["يا ربّ جرِّعْهمْ بِعَدْلِكَ غبَّ مَا","قَدْ جَرَعُوه أَقاربي وأَذاقوا",18,"ق",3,0],["يا رَب جَيش قَد كَفَفتِ بِمِثلِهِ","وَالخَيل تعثر في النَجيع الآني",19,"ن",2,0],["يا رَبِّ جُدْ لِيَ ما مُعْطي الجَزيلِ ويا","مُولي الجَميلِ بإجْمالٍ وإفضالِ",20,"ل",1,0],["يَا رُبَّ جيشٍ نقعُه وَجيَادُه","نَارٌ عَلاَهَا بِالقَتَادِ دخانُ",21,"ن",1,0],["يَا رُبَّ جَارِيَةٍ حَورَاءَ نَاعِمةٍ","كَأَنَّها عَومَةً فِي جَوفِ رَاقُودِ",22,"د",1,1],["يا رب جئت بليلة عبديه","كملت وقد حازت شريف مزية",23,"ه",1,0],["يا رُبَّ جَبّارٍ شَديدِ القُوى","أَصابَهُ سَهمٌ مِنَ اللَهِ",24,"ل",2,0],["يا رب جد لي بعفو منك ينقذني","من الجحيم إذا ما عمّ تهويل",25,"ل",1,0],["يا ربُّ جار حبيبي","ولم يدع ليَ حيلا",26,"ل",2,1],["يَا رَبِّ جَرِّد عَبدَكَ المِسكِينَ رَا","جِي الفَضلِ مِنكَ أضعَفَ العُبدَانش",27,"ن",2,0],["يا رب جنبهم طرائقها التي","تفضي بسالكها الى النيران",27,"ن",1,0],["يا رَبِّ جَنَّةَ عَدنٍ","وَجيرَةَ المُختارِ",28,"ر",1,1],["يا رَبِّ جودُكَ عَوني إِن وَهى جلَدي","وَأَسلَمَتنِيَ أَنصاري وَأَعواني",29,"ن",2,0],["يا رب جلى دك منها شاهق","لا يرتَفي اليه بالسلالم",30,"م",1,0],["يا ربّ جئتُ راغباً فى فَضلِكَ","وصِرتُ مُستَعِيذَ قَهرِ عَلِكّ",31,"ك",1,0],["يا رب جد كرماً وأقبل توسلنا","بهم إليك عسى أن تكشف البرحا",32,"ح",2,0],["يا رب جيش الهم قد أحاط بي","وليس لي غير الحميا ملتجا",33,"ج",2,1],["يا ربِّ جئتكَ نادباً حالي الشقيَّ","وفرطَ شُؤمي يا رجا الأَقطارِ",34,"ر",1,0],["يا رب جاروا علينا","والجور داءٌ عضال",35,"ل",1,0],["يا رب جارية سبتك بحسنها","وأتتك آيات الكتاب بوصفها",36,"ه",2,1],["يا رب جد لي بلطف","وأنت دبر أموري",37,"ر",2,1],["يا رب جدى دق فى خصره","ثم اتانا بقفا يدمى",38,"م",2,0],["يا رُب جمجُمةٍ جعل","تُ لصارمِ غِمدا",39,"د",2,0],["يا رُبَّ جيشٍ لَجبٍ لُهامٍ","يغرق منه زاخرُ الَّلهامِ",40,"م",1,0],["يا رب جيء شديد الشغب ذي لجب","ذعرت من راهن منهم ومرهون",41,"ن",1,0],["يا ربّ جمّع شملنا بأحبّةٍ","في ظلّ أمنٍ في ربوع بلادنا",42,"ن",2,0],["يارب جل الخطب واندثر المنى","واليوم أعظم مانريد سلامة!",43,"م",2,0],["يارب جئتك ثاوياً أبكي على","ما قدمته يداي لا أتباكى",44,"ك",2,0],["ياربُّ جنِّبنا اتباع طريقهِ","واهدِ النفوسَ إلى ربى الإيمانِ",45,"ن",1,0],["يَاربُ جِئْنَا وَقَدْ نَاخَتْ ركَاْئِبُنَا","بِبَابِ عَفْوكَ يَا رَحْمٰن رجواكا",46,"ك",2,0],["يا رب جفني قد جفاه هجوعه","والوجد يعصي مهجتي ويطيعه",47,"ع",2,1],["يَا رُبَّ جِسْمٍ نَاحِلٍ بِعِظَامِهِ","قَامَتْ بِهِ الثَّوْرَاتُ نَزْفاً رَافِضَا",48,"ض",2,0],["يارب جنبنا طريق الظالمين","فليس للظالم ولياً مرشدا",49,"د",2,0],["يَا رَبّ جُوْدُكَ في الوُجُوْدِ عَظِيْمُ","يَشْتَاقُه المَكْلُوْمُ والمَحْرُوْمُ",50,"م",1,1],["يَا رَبّ جِئْتُكَ .. خَاشِعَاً مُتَبَتِّلاً","أَرْجُوْكَ .. والرَّجْوَىٰ إليكَ تَدُوْمُ",50,"م",1,0],["‏يا رب جئتُكَ محزونا فخذ بيدي","فمن سِواكَ يَصُدُّ الحزن عن خَلَدِي",51,"ي",1,1],["يا ربِ جَنِبْهُ ما بالجسمِ من ألمٍ","وردَّ عافيةً نتلوا لها سُوَرا",52,"ر",2,0],["يا ربّ جئتك طاوي الصبر مُعتَرِفاً","خاوي الحَصاد رَضِيَّاً حيث أُمتَحَنُ",53,"ن",1,0],["يا ربِّ جمّدْنا معا في حالنا","هذا الذي لسنا نروم سواهُ",54,"ا",2,0],["يَا رَبِّ جِئْتُكَ فَرْدًا","فَاغْفِرْ بِعَفْوِكَ إِثْمَهْ",55,"م",2,0],["يارب جئنا والنفوس كليمة","وقلوبنا لعقتْ لشر هوان",56,"ن",1,0],["يا رب جاوزت الحديث لغيرتي","فاغفر وجنبني عن الأخطاء",57,"ا",2,0],["يا ربِّ جفّت دموع الأمهات هنا","فأنزلنَّ علينا الغيث والمطرا",58,"ر",2,0],["ياربَّ جيش قد كففت بمثله","والخيل تعثرُ في النجيع القاني",59,"ن",2,0]]}