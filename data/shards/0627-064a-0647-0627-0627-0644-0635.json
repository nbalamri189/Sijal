{"poems":[[55,"يا عذولي قد غضضت جماحي","https://www.aldiwan.net/poem29800.html","الخفيف"],[80,"أيها الصاحب الذي فارقت عي","https://www.aldiwan.net/poem14043.html","الخفيف"],[91,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[91,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[87,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[68,"نلت من ودك الجميل انتصافي","https://www.aldiwan.net/poem40336.html","الخفيف"],[69,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[77,"عبرات تحثها زفرات","https://www.aldiwan.net/poem69098.html","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202546","الرمل"],[91,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[113,"حسنت ليلة الخميس فكانت","https://www.aldiwan.net/poem16454.html","الخفيف"],[266,"ربع أسماء لا عداك عنان","https://www.aldiwan.net/poem38168.html","الخفيف"],[280,"أيها الصاحب الصفي مباح","https://www.aldiwan.net/poem25416.html","الخفيف"],[333,"من ترانيم وحيك القدسي","https://www.aldiwan.net/poem55045.html","الخفيف"],[374,"أيها الصاحب المحافظ قد حم","https://www.aldiwan.net/poem4278.html","الخفيف"],[438,"أيها اللائم لم غي","https://www.aldiwan.net/poem12544.html","مجزوء الرمل"],[443,"أيها الصاحب المعظم إني","https://www.aldiwan.net/poem2605.html","الخفيف"],[484,"رقص الدهر بقومي","https://www.aldiwan.net/poem37172.html","مجزوء الرمل"],[484,"بلبل في الروض غنى","https://www.aldiwan.net/poem37611.html","مجزوء الرمل"],[543,"أيها الصبيان مهلا","https://www.aldiwan.net/poem47996.html","عموديه"],[572,"اكفنا ياعذول شر لسانك","https://www.aldiwan.net/poem69496.html","الخفيف"],[580,"وجنة فوقها عذار أطلا","https://www.aldiwan.net/poem3027.html","الخفيف"],[580,"ليل وصل منيرة أقماره","https://www.aldiwan.net/poem3059.html","الخفيف"],[580,"ما على الدهر بعد رؤياك عتب","https://www.aldiwan.net/poem3096.html","الطويل"],[591,"أيها الهاجر حدث","https://www.aldiwan.net/poem17528.html","مجزوء الرجز"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86827","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86651","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86744","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54186","الرمل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53988","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79794","الخفيف"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105426","الخفيف"],[1894,"","https://poetry.dctabudhabi.ae/diwan/poem/198779","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53234","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93913","الخفيف"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79703","الخفيف"],[3345,"","https://poetry.dctabudhabi.ae/diwan/poem/97844","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40042","الخفيف"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199121","الرمل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119708","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54378","الخفيف"],[4859,"أين قلبي؟!","https://www.poetsgate.com/ViewPoem.aspx?id=204284",""],[4984,"نَشِيدُ النَّصْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=197045",""],[5183,"الرثاء الباكي","https://www.poetsgate.com/ViewPoem.aspx?id=180250",""],[5183,"صرخة الفحول","https://www.poetsgate.com/ViewPoem.aspx?id=185636",""],[5302,"شعري","https://www.poetsgate.com/ViewPoem.aspx?id=201746",""],[5528,"ضياع","https://www.poetsgate.com/ViewPoem.aspx?id=201145",""],[5725,"موت عراقي الشذى","https://www.poetsgate.com/ViewPoem.aspx?id=207163",""],[5741,"أيها الصائد باللحظ ومن","https://www.poetsgate.com/ViewPoem.aspx?id=187459",""],[5956,"انفتح يا سجن","https://www.poetsgate.com/ViewPoem.aspx?id=192340",""],[5970,"أيها الثاوي الذي ليس يزار","https://www.poetsgate.com/ViewPoem.aspx?id=130675",""],[6189,"يا ضمير الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67118&r=&rc=3",""]],"verses":[["أَيُّها الصُبحُ زُل ذَميماً فَما أَظ","لَمَ يَومي مِن بَعدِ ذاكَ الظَلامِ",0,"م",1,0],["أَيُّها الصاحِب الَّذي فارَقَت عي","ني وَنَفسي مِنهُ السَنى وَالسَناءَ",1,"ا",2,1],["ايها الصبح انت شعر","ومعناك مبتكر",2,"ر",1,0],["ايها الصبح الذي","سرّني ما اجملك",3,"ك",1,0],["أَيُّها الصارِخُ مِن بَحرِ الهُموم","ما عَسى يُغني غَريقٌ مِن غَريق",4,"ق",1,0],["أَيُّها الصاحِبُ المُعَظَّمُ تاجُ ال","دينِ رَبُّ الإِسعادِ وَالإِسعافِ",5,"ف",1,0],["أَيُّهَا الصاحبُ المُؤَمَّلُ أَدْعُو","كَ دُعَاءَ استغاثَةٍ واستجارَهْ",6,"ر",2,0],["أيها الصبُّ لا تُرَعْ فالليالي","فرَحاتٌ تَشُوبُها تَرَحات",7,"ت",1,0],["أيها الصارخ من بحر الهموم","ما عسى يغني غريق عن غريقْ",8,"ق",1,0],["أيها الصبح أنت أجمل شيء","لسروري جماً يعيد ويبدي",9,"ي",1,0],["أَيُّها الصُبح زَل زَميماً فَما أَظ","لَم يَومي مِن بَعد ذاكَ الظَلام",10,"م",1,0],["أيها الصاحب الصديق المفدي","أنت في عين صحبك الإنسان",11,"ن",1,0],["أَيُّها الصاحِبُ الصفِيُّ مُباحُ","لَكَ عَنّي فِيما نصَصْت الروايَه",12,"ا",3,1],["أيها الصامت الذي أيقظ","الكون بنجواه للعزيز العلي",13,"ي",1,0],["أيها الصاحبُ المحافظُ قد حم","لتَنَا من وفاء عَهدك دَينا",14,"ن",2,1],["أيها الصاحبُ قل لي","مثلُه في الأرض أيْنا",15,"ن",2,0],["أيها الصاحب المعظّمُ إني","أتشكّى اليك من أوصابي",16,"ب",2,1],["أيها الصاغي لقولي","فيه لو تدري رموز",17,"ز",1,0],["أيها الصداح فينا","شنف الأسماع باللّه",18,"ه",1,0],["أيها الصِّبيان مَهلاً","لَستمُ للرَّي أهلا",19,"ل",2,1],["أَيُّهَا الصَّبُّ بُحْ فَقَدْ شَفَّكَ الشَّوْقُ","وَمَلَّكْتَ كَفَّهُ مِنْ عِنَانِكْ",20,"ك",1,0],["أَيُّها الصاحب الذي اعتز","بالله وزيراً واهتزَّ بالبأْس نصْلا",21,"ل",2,0],["أَيُّها الصاحِبُ الذي مَلَكَ الده","رَ وأَجنادُ ملكِه أَقْدَارُه",22,"ر",2,0],["أَيها الصَّاحِبُ الَّذي أَمرُه الجِدُّ","وأَمْرُ الأَنام لَهْو ولِعْبُ",23,"ب",1,0],["أَيُّها الصَّابِرُ عَنِّي","لَيتني أُعْطِيتُ صَبْرَكْ",24,"ك",1,0],["أَيُّها الصدِّيق يا نعم المُشيرْ","يا أَثيل المَجد يا أَسمى وَزيرْ",25,"ر",1,1],["أَيُّها الصدِّيقُ بشراك أَتى","مِن أُوربّا مصطفى نعم الفَتى",26,"ت",2,1],["أَيُّها الصَدر وَالمَلاذ الوَحيدُ","طالع الناجب الأَمين سعيدُ",27,"د",1,1],["أيّها الصَّبُّ بسُكنى بسطةٍ","يَبْتَغي العزَّ بها والشّرَفَا",28,"ف",2,1],["أيّها الصّادي شرابي","مُذْهِبٌ بَرْحَ الغَلِيلِ",29,"ل",1,1],["أيها الصحنُ لم تزل للمُصلَّى","ومن الذنبِ مسجداً وطهورا",30,"ر",2,0],["أيها الصحب ليس للقوم قصد","غير قتلي فليغد من هو غاد",31,"د",1,0],["ايها الصاعدون للبدر مهلا","لا تتيهوا على ذرى الأكوان",32,"ن",1,0],["أيها الصاحب الذي لست أخشى","في حماه من حادث الدهر نَبْوه",33,"و",2,1],["أيها الصب في غزال شرود","لوع القلب بالتهاب الخدود",34,"د",1,1],["أيها الصمت لا شكوتك عمري","كل شيء فعلته محبوب",35,"ب",1,0],["أيها الصمت لا تملك نفسي","كلما أحرجت وضاقت جنوب",35,"ب",1,0],["أيها الصاحب الذي نلت منه","ما أرجي فاليوم حالي حال",36,"ل",1,0],["أَيُّهَا الصَّاحيانِ من كَأسِ عَينٍ","غازَلَتْنِي حَتّى تَطَغَّمْتُ سُكرا",37,"ر",2,0],["أيها الصرفي إني ملغز","في عجيب وزنه نفع الدواب",38,"ب",1,1],["أيها الصحبُ إنّ هذا مقامي","فدعُوني وصحبة الأطلال",39,"ل",1,0],["أَيُّها الصادرون ريّاً عن الورْ","د أما تَنْقَعونَ غُلّةَ صادِ",40,"د",1,0],["‏أيها الصّبح قل لهم أين قلبي","لم يعد بعد أن جفوني انشراحي",41,"ح",2,1],["أيها الصحبُ تعَالوا","نَنْشُدُ التاريخَ شعرا",42,"ر",2,0],["أيها الصامد المجدّ ترفق","فلقد جذ في يديك اللواء",43,"ا",2,0],["أيها الصامدان في لجب الثو","رة من كل باسل بناء",44,"ا",2,0],["أيها الصحب ليس شعري بشعر","إن أتى جامدا وظل يراوح",45,"ح",1,0],["أيُّهَا الصَّبْرُ هَلْ إليْكَ سَبِيلٌ","فلَقَدْ سَاقَنِي إليْكَ الرَّجَاءُ",46,"ا",2,0],["ايها الصوت العراقي اللمى","ثابتاً بالقول فوق المقصلِ",47,"ل",1,0],["أيها الصائد باللحظ ومن","هو من بين الورى مقتنص",48,"ص",1,1],["أيها الصاحون في هذا الدجى","أقفِلوا الأبوابَ في وجهِ الوباءْ",49,"ا",2,0],["أيها الصامت ما أوعظ ما","قد سمعنا منك عن يوم العثار",50,"ر",1,0],["أيها الصابرون ، طال التمادي","في خلافاتنا ، وطال المسيرُ",51,"ر",1,0]]}