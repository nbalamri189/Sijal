{"poems":[[90,"أرى الحسن في لبنان أينع غرسه","https://www.aldiwan.net/poem44445.html","الطويل"],[64,"قال الحكيم مقالا أبان","https://www.aldiwan.net/poem52187.html","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39621","الهزج"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42540","المنسرح"],[154,"أرقت لبرق من تهامة مومض","https://www.aldiwan.net/poem68586.html","الطويل"],[170,"أراك مستعجلا يا حادي الإبل","https://www.aldiwan.net/poem46896.html","البسيط"],[275,"ملأت يدي من نهدها متزودا","https://www.aldiwan.net/poem35252.html","الطويل"],[289,"برزت من المنازل القباب","https://www.aldiwan.net/poem44319.html","الوافر"],[382,"طهارة نفس لا تفيد وتنفع","https://www.aldiwan.net/poem59338.html","الطويل"],[412,"هل الوجد إلا أن تلوح خيامها","https://www.aldiwan.net/poem50126.html","الطويل"],[435,"أخا الانس هل أبصرت صبا مولعا","https://www.aldiwan.net/poem41392.html","الطويل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122350","المنسرح"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96644","الطويل"],[1192,"","https://poetry.dctabudhabi.ae/diwan/poem/74132","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101004","الطويل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96499","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27603","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100362","الطويل"],[2959,"","https://poetry.dctabudhabi.ae/diwan/poem/99063","المنسرح"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48327","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85206","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141683","البسيط"],[4981,"هواجس دمشقية","https://www.poetsgate.com/ViewPoem.aspx?id=190502",""],[5038,"كبرت اليوم أم تصغر","https://www.poetsgate.com/ViewPoem.aspx?id=189878",""],[585,"سل الأرض كم خاضت قديم المآزق","https://www.poetsgate.com/ViewPoem.aspx?id=161964",""],[5306,"الكوكب الدرّي","https://www.poetsgate.com/ViewPoem.aspx?id=174807",""],[5397,"لعمر العلى ما كل من طلب الفخرا","https://www.poetsgate.com/ViewPoem.aspx?id=157968",""],[5411,"النّور","https://www.poetsgate.com/ViewPoem.aspx?id=187732",""],[5582,"أَلا حَدِّثا عَنْ عَهْدِ ناقِضَةِ العَهْدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186936",""],[520,"فيا ايها الدست الذي غاب صدره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577592",""]],"verses":[["فمن زاره مستوحشاً فهو انسه","ومن جاءه مستنزهاً فهو قدسه",0,"س",2,0],["فمن زادها زادها جودة","وصبغا فتلك عليها ترد",1,"د",1,0],["فمن زُرقٍ إلى صُفرٍ","إلى خُضرٍ إلى حُمرِ",2,"ر",1,0],["فَمَنْزِلٌ عَامِرٌ بِقَاطِنِهِ","وَمَنْزِلٌ بَعْدَ أَهْلِهِ خَربُ",3,"ب",1,0],["فَمَن زادَ في التَعدادِ زادَتهُ في الضِعفِ","فَضائِلُ لَم يُوقَف لَها عِندَ غايَةٍ",4,"ه",1,0],["فمن زمامٍ إلى مغناهُ مُنعطفٍ","ومن عنانٍ إلى مأواهُ مُنْفتِلِ",5,"ل",1,0],["فمن زفراتٍ حرُّها محرقٌ ومن","تكسُّرِ قُبلاتٍ يرنُّ لها صدى",6,"د",2,0],["فَمَنزِلي الفَضاءُ وَسَقفُ بَيتي","سَماءُ اللَهِ أَو قطعِ السَحابِ",7,"ب",1,0],["فمن زاد طهراً زاد شِبْهاً بربه","يَخِسُّ وينمو موجِدٌ ومضيَّع",8,"ع",1,0],["فَمِن زَردٍ فَوقَ العَوالي كَأَنَّها","خَواتِم أَودى في البَنانِ التِحامُها",9,"م",3,0],["فمنزله قلبي وعهد وداده","بطيّ فؤادي كامن ما تضعضعا",10,"ع",2,0],["فمن زلال الوصال خذ بدلا","فما لمثلي إذا قضى بدل",11,"ل",1,0],["فَمن زارهُ مُستمنحاً فَقَدِ اِنتحى","لإِنجاحهِ وجه السبيل إلى القصدِ",12,"د",1,0],["فمن زُبَرِ الأَقيادِ مَدٌّ بِساعِدٍ","وَمِن حلقات الكبلِ شَدٌّ بمخلب",13,"ب",1,0],["فمِن زارعِ ضاقت خزائن بيته","بغَلّات جنات له وزروع",14,"ع",1,0],["فمن زائر يرجو فواضل سيبه","وآخر يقضي حاجَه قد ترحلا",15,"ل",2,0],["فمنزلتان مع ثلث لبرجٍ","كتقسيمِ المراتبِ في النديّ",16,"ي",1,0],["فمن زفرة في الصدر ترقص لاعجاً","ومن عبرة في الخد تنفض وابلا",17,"ل",2,0],["فمنزلي مطبقٌ بلا حرسٍ","صفرٌ من الصفر حيثما درت",18,"ت",1,0],["فمِن زَفَراتٍ رَجْعُها يُذْهِبُ الأسى","ومنْ جَمَراتٍ رمْيُها ينقعُ الظّما",19,"م",2,0],["فمن زاره أوزاره عنه تنمحي","وتغمره الأفراح والفوز والبشر",20,"ر",1,0],["فمن زارني فيها","فلا يَرْجُوَنْ ترفه",21,"ه",1,0],["فَمَنزلُ الأهلِ يَشكو طُولَ غُربتِنا","والقطُّ مَاءَ ،و كلبُ الحَيِّ نبّاحُ",22,"ح",1,0],["فَمَنْ زَرَعَ الرّدى فيها","وَفي أكْبادِها الْخَنْجَرْ",23,"ر",1,0],["فمنزلق في الدحض عند انفجارها","ومنطلقٌ من جوف أقتم خافق",24,"ق",1,0],["فمنزلهم عند المهيمن فوق ما","يراه العدى شأناً شأى الفكر مجهدا",25,"د",2,0],["فمن زار بعد اليوم قبرك خالصا","بنيته حط الإله له وزرا",26,"ر",2,0],["فَمِنْ زُجاجَتكَ المُثْلى الّتي ائْتَلَقَتْ","بِكَ اسْتَنارَ المَدى وَاسّاقَطَتْ رُجُمُ",27,"م",1,0],["فَمَنْ زارَهُ مُسْتَنْجِحاً فَقَدْ انْتَحَى","لإِنْجاحِهِ وَجْهَ السَّبِيلِ إِلَى القَصْدِ",28,"د",1,0],["فمن زلزل الطود الذي ساخ في الثرى","وفي كل أرضٍ خوفه وزلازله",29,"ل",2,0]]}