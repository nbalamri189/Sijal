{"poems":[[68,"كان الزمان بلقياكم يمنينا","https://www.aldiwan.net/poem40132.html","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79838","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100982","الكامل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140090",""],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112678","الرجز"],[3791,"","https://poetry.dctabudhabi.ae/diwan/poem/145984","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77126","الوافر"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78347","المتدارك"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4755,"بِرَشَّاشِهِ.. أو بِدَبَّابَتِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=200555",""],[4935,"يروي لنا التاريخ أن النيلا","https://www.poetsgate.com/ViewPoem.aspx?id=129369",""],[5953,"إن يوم الغدير يوم السرور","https://www.poetsgate.com/ViewPoem.aspx?id=93784",""],[5956,"عصفور هطلَ على ماء بجانبي","https://www.poetsgate.com/ViewPoem.aspx?id=183461",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""]],"verses":[["بِرَشفِ راحِ النَدى مِن كاسِ راحِهِمُ","أَنّا لَبِسنا الضَنا بَعدَ اِلتِماحِهِمُ",0,"م",1,0],["برشاقة الغُصنِ الرطيبِ","ولفتة الظبي الغريرِ",1,"ر",1,0],["برٌّ شهدناه ومرحمة","ينبيك عنها ذلك الوفد",2,"د",1,0],["برشاوش للغول يحمل راسه","من تحته فرس طويل القامة",3,"ه",1,0],["برشة من دمه مطهره","طهره اللَه لعبد ذكره",4,"ه",1,0],["برشف لماه واغتنام حديثه","وتقبيل خديه وضم رشيقه",5,"ق",2,0],["بَرشَق لِحاظُها داء المَعنى","وَفي ترشاف مَبسَمِها الدَواء",6,"ا",2,0],["بِرَشاقته أَضعَفَني","وَحسام لحاظ أَتلَفَني",7,"ي",1,0],["برشقة من نبال الأعين النجل","فلا أفر من الشجعان تبعدني",8,"ي",1,0],["بِرَشَّاشِهِ.. أو بِدَبَّابَتِكْ","هُوَ الحاكِمُ اليَومَ في غابَتِكْ",9,"ك",1,1],["برشيد سعد مشرق ببراعة","منها رأينا للكمال دليلا",10,"ل",2,0],["برشاء من شعر أسود مع الكل","ب وزبر المخوف المذعور",11,"ر",1,0],["بِرَشْفٍ خاطفٍ خوفا","أشن عليه شَعْواءا",12,"ا",3,0],["برشمتها بِالريش وَالخز وَالودع","مثل هودج الغيدا بديعة جمالها",13,"ل",3,0]]}