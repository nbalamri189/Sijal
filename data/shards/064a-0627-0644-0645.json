2,"","https://poetry.dctabudhabi.ae/diwan/poem/140058",""],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104671","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203053","الخفيف"],[2973,"","https://poetry.dctabudhabi.ae/diwan/poem/107023","السريع"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102406","البسيط"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126976","الخفيف"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101226","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91661","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29297","السريع"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66158","الرمل"],[4869,"المال ..","https://www.poetsgate.com/ViewPoem.aspx?id=151709",""],[4888,"حلب الشهباء","https://www.poetsgate.com/ViewPoem.aspx?id=207762",""],[4929,"ازهر الرأس","https://www.poetsgate.com/ViewPoem.aspx?id=199507",""],[4929,"بحار عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=200189",""],[4935,"لاح نجم السعد في أوج الكمال","https://www.poetsgate.com/ViewPoem.aspx?id=129484",""],[5186,"يا لمنطاد أرضنا يتقلى","https://www.poetsgate.com/ViewPoem.aspx?id=156522",""],[5324,"نحن قابيل وهابيل.","https://www.poetsgate.com/ViewPoem.aspx?id=211648",""],[5455,"التوبه","https://www.poetsgate.com/ViewPoem.aspx?id=34694",""],[5480,"متغنّم الشاره","https://www.poetsgate.com/ViewPoem.aspx?id=29630",""],[5591,"يالمنترب لبستك لباسين","https://www.poetsgate.com/ViewPoem.aspx?id=194067",""],[5606,"ماياجيك باس","https://www.poetsgate.com/ViewPoem.aspx?id=196788",""],[2110,"يا مهاة قد نأت عن مقلتي","https://www.poetsgate.com/ViewPoem.aspx?id=156291",""],[5739,"غدينا بالمتاهه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=126427",""],[5837,"عبدالعزيز القنيدي","https://www.poetsgate.com/ViewPoem.aspx?id=181088",""],[5866,"قال من لا يعجزه نظم الحروف الابجدية","https://www.poetsgate.com/ViewPoem.aspx?id=182872",""],[5952,"نِلْتُ خُفَّا","https://www.poetsgate.com/ViewPoem.aspx?id=201759",""],[6164,"بطرت .. فزلت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66039&r=&rc=49",""]],"verses":[["يا لمّةً قد عهدتُها زمناً","سوداءَ سحماءَ جَثلة الغُدر",0,"ر",1,0],["يا لملك راح عني نائيا","كان لو فتشت عنه في يدي",1,"ي",1,0],["يا لمصرَ الجنةِ الفيحاءِ كم","فتحت قبراً لباغٍ قد ظَلَم",2,"م",1,0],["يا لمنفيين ضلا في الوعور","دميا بالشوك فيها والصخور",3,"ر",1,0],["يَا لَمْحَةً مِنْ نُورِ رَبِّ الهُدَى","يُحَارُ فِي أَوْصَافِهَا القَائِلُ",4,"ل",1,0],["يُألمُ بالفصْد كفَّ ذي غُنجٍ","تَفْصِدُ منا القلوبَ عيناهُ",5,"ه",1,0],["يا لمرآى شاعر يسقي غريره","ويناغيها بألحانٍ مثره",6,"ه",1,0],["يا لمرآى الدموع وهيَ بناتُ الش","عر في مُقلةِ الحييِّ الخجول",7,"ل",1,0],["يا لمخموريْنِ مُلتخَّيْنِ لمْ","يعِ كلٌ منهما ماذا يقول",8,"ل",1,0],["يا لمجد غذاه نور الأماني","وسهاد الجفون والأمسيات",9,"ت",1,0],["يا لمصر تهتاجها صعقةُ الهو","ل وتحيى آلامها الدارسات",9,"ت",1,0],["يا لَمعَةَ البَرقِ بَل يا هَبَّةَ الريحِ","روحي بِجِسمي إِلى مَن عِندَهُ روحي",10,"ح",2,1],["يا لمغنًى به الغواني تهادَتْ","وخَلَتْ من مؤنّبٍ وعذولِ",11,"ل",1,0],["ي المُحَيَّا الزاهرِ الغُرَّ","ة في الدهرِ البهيمِ",12,"م",1,0],["يَأْلَمُ كلَّ قطرةٍ سائلةٍ","من مائه كأنما سال دمُهْ",13,"م",2,0],["يا لَمحبٍّ مغضَبٍ لو أنه","في حبكم مستعذِبٌ خَبالَه",14,"ل",2,0],["يا لَمن ينكُص عن غِزلانكم","وهو وثَّابٌ على الليثِ الغضوبِ",15,"ب",1,0],["يا لمة ضرب الزما","ن على معرسها خيامَهُ",16,"م",2,1],["يا لمجدٍ حديثُهُ ملأَ الأَر","ضَ وقد أَخلقَ الزَّمانَ جَديدُهْ",17,"د",2,0],["يا لِمَّةً نَصَلَت ولَيس خِضابُها","عِوَضاً وأقبِح شَيبَةً أَن تُخضبا",18,"ب",2,0],["يا لموج يا لريح زعزع","أسرعت مي لتحمي الغنما",19,"م",2,0],["يا لَمَولاها السَعيدِ","صاحب الرَأي السَديدِ",20,"د",1,0],["يا لمةً أخْلَقَتْ من بعدِ جدَّتِها","فللمشيبِ على حافاتها رُقَع",21,"ع",1,0],["يألمها القلب بأوهامه","فتظهرُ الأجفان منه اعتلال",22,"ل",1,0],["يالمطلعي ودّي جِداهم سلامين","مَكتوب في سجِل معَرّب بالاسطار",23,"ر",1,0],["يألم القلب إذا أخطأه","ولروحي راحة حين يصيب",24,"ب",1,0],["يا لُمعةً سوداءَ في وجهِ الزما","ن خيرُها ونفعُها لا يُرتجى",25,"ا",1,0],["يا لمعة البرق بردي كبدي","لا تحرقيه بشدة البرق",26,"ق",1,0],["يا لِما أَبداهُ في العُسرَةِ إِذ","جَهَّزَ الجَيشَ قِلاصاً بُدُنا",27,"ن",2,0],["يا لماء لولا التموج فيه","لم تخل أنه على الأرض جار",28,"ر",1,0],["يا لماكاً رقي على أنه","له بذاك الفضل والمنه",29,"ن",2,1],["يا لمعدٍّ ويا للناس كلهم","ويا لغائبهم يوماً ومن شهدا",30,"د",2,1],["يالميت بكى له المجد حزناً","وعليه قلب العلا قد توقد",31,"د",1,0],["يالماه كم رشفنا","ك اغتباقا واصطباحا",32,"ح",2,0],["يا لما في تلك المعاهد رجع","وَالزَمان الجموح صَعبُ المآب",33,"ب",1,0],["يا لَمعَةً سَطَعَت","في الفَجرِ مِن دُرَّه",34,"ر",2,0],["يا لَمِيسُ الهَجْرُ أَضْنى مُهْجَتي","وبَراني بِرْيَةَ السَّهْمِ الهُوَيّ",35,"ي",1,0],["يالمال وش ذنبك يسبونك الناس","وانته على مذهب رفيقك ودينه",36,"ن",2,0],["يالمال خذها كاش من بين الاقواس","انته على مذهب رفيقك ودينه",36,"ن",2,0],["يا لمحَ طفلٍ صافعًا إحساسَنا","يا صرخةً لفّتْ فؤادي عاصرةْ",37,"ر",2,0],["يالَ ما أحدثَتْهُ بي مقلتاها","إن سرَ العيونِ أمرٌ عجيبُ",38,"ب",1,0],["يالَ ما حلَّ منهما بي ويالي","من مُعنّى أبلاه فيكِ الغرامُ",39,"م",1,0],["يا لميلاد تسعى بالتي","أقبلت بالعز مع اسعاد آل",40,"ل",1,0],["يا لمنطاد أرضنا يتقلى","بين نارين من حشاه ويوجه",41,"ه",1,1],["يالمأساة الذي يجهل منّا","وجهنا الآخر كالدنيّا العجيبة",42,"ب",2,0],["يالمزنه اللي تحن لغيثها نوقي","تعبت أخيلك وأقول نياقي نياقي",43,"ق",2,0],["يالمهتوي شعر ٍ على غير دستوره","أجهش ضميري ولا له غيري استاره",44,"ر",2,1],["يالمنترب لبستك لباسين","لبسٍ تجنعبه ورضابه",45,"ب",2,1],["يالمرض بالله إذاعندك احساس وقياس","لاتصيب الكفو وان كان صبته لاتجور",46,"ر",1,0],["يا ل مي طال هجري للسكرى","في هواكم فارحموني يا ل مي",47,"ي",1,0],["يالمحال اللي من دْيارك تحيل.","ليه قلت الحب لعبه مع فكاهه.؟",48,"ا",3,0],["يالمبدع الواعي المتمكّن الشامخ","ما فيه مثلك شبيه بلعبة الكورة",49,"ر",2,0],["يالمباحث سلمو راعي البيوت البربرية","سلموه المحكمة عند الغلاظ من القضاتي",50,"ت",2,0],["يا لَمَنْ قد تُعجِزُ الكُتَّابَ وصْفا","كلُ حرفٍ رامها قد نالَ حَتْفا",51,"ف",2,1],["يالَ مَجْدِ الله في عَلْيائِهِ","إنه فَكَّ عن العَقْلِ العِقالْ!",52,"ل",1,0]]}