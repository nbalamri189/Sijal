{"poems":[[85,"الأمير بدر المواكب","https://www.aldiwan.net/poem54192.html","مجزوء الرمل"],[53,"قل لنجح أخطأت باب النجاح","https://www.aldiwan.net/poem9402.html","الخفيف"],[53,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[91,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[46,"أرض مصردة وأخرى تثجم منها","https://www.aldiwan.net/poem30363.html","الكامل"],[107,"أرأيتها تبغي السبيل فتهتدي","https://www.aldiwan.net/poem42103.html","الكامل"],[107,"جددوا الذكرى لأهل المشرق","https://www.aldiwan.net/poem42122.html","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85412","الخفيف"],[102,"فارس الاصطياف","https://www.poetsgate.com/ViewPoem.aspx?id=50417",""],[193,"يا نسيماً سرى إلى قاسيونا","https://www.aldiwan.net/poem34874.html","الخفيف"],[197,"عيرتني ترك المدام وقالت","https://www.aldiwan.net/poem12830.html","الخفيف"],[201,"كفكف بربك دمعك الهتانا","https://www.aldiwan.net/poem39950.html","الكامل"],[228,"إيه برناس هيكل الشعراء","https://www.aldiwan.net/poem41899.html","الخفيف"],[240,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[371,"شوقا إلى ذاك الجلال ومجتنى","https://www.aldiwan.net/poem17166.html","الكامل"],[398,"يا غزالا عذاره كالطراز","https://www.aldiwan.net/poem53679.html","الخفيف"],[406,"وهج الحب","https://www.aldiwan.net/poem6703.html","عموديه"],[463,"قالوا عساك مرجم فتبين","https://www.aldiwan.net/poem55859.html","الكامل"],[505,"عهدت طريقتنا أصولا خمسة","https://www.aldiwan.net/poem37962.html","الكامل"],[505,"لله أن يختار من أحبابه","https://www.aldiwan.net/poem38096.html","الكامل"],[519,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[543,"أنا صب متيم ما حييت","https://www.aldiwan.net/poem48258.html","عموديه"],[563,"هي قامت بنفسها لذويها","https://www.aldiwan.net/poem33637.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138201",""],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101525","الرمل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101487","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86594","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63861","الخفيف"],[1217,"","https://poetry.dctabudhabi.ae/diwan/poem/143765","الخفيف"],[1224,"","https://poetry.dctabudhabi.ae/diwan/poem/130642","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56696","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79844","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80006","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48931","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48936","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110231","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130851",""],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83208","الرمل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127368","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204469",""],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107071","الخفيف"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101236","الخفيف"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101218","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205951","الرمل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132166","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85194","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128921","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125873","الكامل"],[4097,"","https://poetry.dctabudhabi.ae/diwan/poem/147253","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90789","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81266","الكامل"],[4718,"ياغافلين اصحوا ترا الوعد قدام","https://www.poetsgate.com/ViewPoem.aspx?id=147144",""],[4830,"مغنى صَبوتي","https://www.poetsgate.com/ViewPoem.aspx?id=202936",""],[4849,"من حسنها كل المخاليق عارف","https://www.poetsgate.com/ViewPoem.aspx?id=53500",""],[4922,"عيرتني تركَ المُدامِ وقالتْ","https://www.poetsgate.com/ViewPoem.aspx?id=16256",""],[5055,"القاعه","https://www.poetsgate.com/ViewPoem.aspx?id=103541",""],[5055,"لو سألتي","https://www.poetsgate.com/ViewPoem.aspx?id=109396",""],[5072,"زمن","https://www.poetsgate.com/ViewPoem.aspx?id=34351",""],[5111,"عَلَى وَتَرِ الْحَنِينِ","https://www.poetsgate.com/ViewPoem.aspx?id=212447",""],[5136,"هي تربة تسمو على كيوان","https://www.poetsgate.com/ViewPoem.aspx?id=121726",""],[5183,"ثورة العراق","https://www.poetsgate.com/ViewPoem.aspx?id=185645",""],[5273,"أنا وهي","https://www.poetsgate.com/ViewPoem.aspx?id=186929",""],[5277,"حكايةُ عشقٍ بغدادي","https://www.poetsgate.com/ViewPoem.aspx?id=195060",""],[5277,"لغةُ الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=198590",""],[5277,"ليلُ البنفسج","https://www.poetsgate.com/ViewPoem.aspx?id=206770",""],[5277,"حمامةٌ زادُها الكتابُ..","https://www.poetsgate.com/ViewPoem.aspx?id=215560",""],[5281,"الحياءُ البِكر","https://www.poetsgate.com/ViewPoem.aspx?id=199311",""],[5376,"أيْ وطني هل حُلْمُنا راموا","https://www.poetsgate.com/ViewPoem.aspx?id=191735",""],[223,"ما لم تقله زرقاء اليمامة","https://www.poetsgate.com/ViewPoem.aspx?id=181142",""],[5431,"هذي_أنا","https://www.poetsgate.com/ViewPoem.aspx?id=183365",""],[5461,"الله اكبر كيف يجرحن العيون","https://www.poetsgate.com/ViewPoem.aspx?id=21939",""],[5660,"قِفا أُوَدِّعكُما يا صاحِبايَ قِفا","https://www.poetsgate.com/ViewPoem.aspx?id=23717",""],[5674,"والضفاف مسافرة","https://www.poetsgate.com/ViewPoem.aspx?id=189553",""],[5725,"سهم الصبابة","https://www.poetsgate.com/ViewPoem.aspx?id=181550",""],[5848,"يافؤادي لا تسلني","https://www.poetsgate.com/ViewPoem.aspx?id=51956",""],[5848,"ضحكتها تسنعني","https://www.poetsgate.com/ViewPoem.aspx?id=50597",""],[5903,"لي هوىً","https://www.poetsgate.com/ViewPoem.aspx?id=124149",""],[5956,"المرأة غالباً أشرف من الرجل","https://www.poetsgate.com/ViewPoem.aspx?id=181897",""],[5956,"أنا محرومٌ","https://www.poetsgate.com/ViewPoem.aspx?id=181915",""],[5956,"لله أشكو ذلّتي","https://www.poetsgate.com/ViewPoem.aspx?id=182498",""],[5956,"من أجل نقوده تقتله","https://www.poetsgate.com/ViewPoem.aspx?id=182526",""],[5956,"دائماً صهيون تنجو من العقاب","https://www.poetsgate.com/ViewPoem.aspx?id=192311",""],[5956,"سندرا أمُّ الجميع","https://www.poetsgate.com/ViewPoem.aspx?id=193161",""],[5956,"أفراح الإفراج","https://www.poetsgate.com/ViewPoem.aspx?id=193434",""],[6024,"أنياب المنايا","https://www.poetsgate.com/ViewPoem.aspx?id=186354",""],[6124,"هيت لك","https://www.poetsgate.com/ViewPoem.aspx?id=120684",""],[6142,"ما نشا في السما ولا ساح في الأر","https://www.poetsgate.com/ViewPoem.aspx?id=155697",""],[6164,"بطرت .. فزلت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66039&r=&rc=49",""]],"verses":[["هي تسوّى ل المراتب","قبل يحمل للمكاتب",0,"ب",1,0],["هي تَهوَى النِّكاحَ والدَّلْكُ مَجْهُو","دُك فيها والدَّلْكُ زُورُ نُكاحِ",1,"ح",1,0],["هي تفري لي الفريَّ فأحذو","حذوها كالإمام والمأموم",2,"م",1,0],["هي تبقى قسما وتأخذ قسما","ثم تلهو بأخذ تلك البقايا",3,"ي",2,0],["هِيَ تِلكَ مُشكاةٌ بِكُم لَو تَشتَكي","مَظلومَةٌ لَو أَنَّها تَتَظَلَّمُ",4,"م",1,0],["هي تلك تعرفها بحسنِ سِماتِها","وبما تريك من الطّرازِ الأوحدِ",5,"د",1,0],["هي تيجانُ القويِّ المُزْدَهِي","وَهْيَ أكفانُ الضّعيفِ المُرهَقِ",6,"ق",1,0],["هيَ تَمشي إلى الشمال ثقالاً","وَخياشيمها إلى الغرب ميل",7,"ل",1,0],["هي تعده ، ويرتجي ميعادها","وسدىّ يعنقد خضرة الصفصاف",8,"ف",1,0],["هيَ تحتَ الثَرى بجلّق غابت","وَعلا نورُها لِعِلّيّينا",9,"ن",2,0],["هِيَ تَحتَ الظَلامِ نُورٌ وَفي الأَك","بادِ بَردٌ وَفي الخُدودِ لَهيبُ",10,"ب",1,0],["هيَ تستجيرُ بكم فقوموا وأقسِموا","يا قومُ ألّا تُغمِضوا الأجفانا",11,"ن",2,0],["هيَ تَبكي الأُلى أَبادَهُم الظُل","مُ وَوارَتهُم يَدُ البَغضاءِ",12,"ا",2,0],["هِيَ تارَةً تَهمي وَتُقلِعُ تارَةً","وَأَرى عَطاءَكَ دائِماً لا يُقلِعُ",13,"ع",1,0],["هِيَ تُربَةُ الكَرَمِ الَّتي مِن بَعدِها","كُلُّ الثَرى لِلجودِ مِثلُ التُربَةِ",14,"ه",1,0],["هيَ تَمشي بِأَصبَهانَ وَلكِن","سَتَروها قَد أَصبَحَت بِطراز",15,"ز",1,0],["هي تَشْتاق أنْ ترى الصدقَ من","مُشْرقَاً كالضُّحى النَّقيِّ مُبينا",16,"ن",2,0],["هي تلك دارُهمُ وذلك ماؤهم","فاحبس ورِدْ وشِرقتَ إن لم تسقِني",17,"ن",2,0],["هي تلكَ إن عُدَّتْ أُصولٌ خمسَةٌ","فيها لِداءِ القلبِ بالسَّيرِ الشِّفَا",18,"ف",2,0],["هي تلك نُكتَةُ حِكمةٍ رَجعتْ إِلى","ما قرَّرَتْهُ مَقولَتي البَيْضاءُ",19,"ا",2,0],["هي تدري ما بها من نَبلِكُم","والعيونُ السّودُ تدري مَن رَماها",20,"ا",3,0],["هِيَ تُغنِيكَ إذ تُغَنِّيكَ عن كلِّ","كمَان وكلِّ عُودٍ بتيت",21,"ت",1,0],["هي تهدي بها لها من أرادت","فتزيل التكييف والتشبيها",22,"ي",3,0],["هي تستمد من المدير حياتها","وتعدّه بين الأنام لها أبا",23,"ب",2,0],["هي تمثال لُجينٍ صدرهُ","كُرتا عاجٍ عليهِ العسجدُ",24,"د",1,0],["هي تمضي للاماني والمنى","وهو يمضي ليوارَى في الترَب",25,"ب",1,0],["هِيَ تِلكَ الأَفلاك فيها بُدور","نُورُها يَزدَري بِنُور الكَواكب",26,"ب",1,0],["هي تلك الجبلَّةُ الفذَّةُ الجو","هرِ في الناسِ وهي تلك الفِلِزَّه",27,"ز",2,0],["هي تغري بالمكرمات وأهليها","فعش من صروفها في أمان",28,"ن",1,0],["هي تحفة وافت لمن","في المجد معدوم المثال",29,"ل",1,0],["هي تشقى من غير ذنب جنته","ولكم مذنب يعيش سعيدا",30,"د",2,0],["هي تلك لاعبةُ العشاء ومن لها","ألفت بناتُ الشوقِ قلبك ملعبا",31,"ب",2,0],["هي تلكَ النفسُ التي بين جنبي","ذي المعالي أخيك ليست بأُخرى",32,"ر",2,0],["هي تُرضعُ الأجسامَ والأرواحَ ما","في صدرها من صحة وخَلاق",33,"ق",1,0],["هي تدعو للعلم وهو ضمين","أن يُرقِّي الحِجى ويُحيي الشعور",34,"ر",1,0],["هي تبغي احتكار قلبي وقلبي","ثائرٌ مطلقٌ هوى وهياما",35,"م",2,0],["هي تلقى على القلوب شعوراً","بمعالي رب البرايا تعالى",36,"ل",2,0],["هَيتَ ياِ ابنَ النيلِ هَيِّتْ بِالعُلا","واسَبقِ الغَربِيَّ نَحوَ الأَلزَمِ",37,"م",1,0],["هي تسبيح وشكوى وأنين","وهي للقلب صلاة قيمه",38,"ه",1,0],["هي تشبه المعدوم","خافية وتحسب باديه",39,"ي",2,0],["هي تتلو آيات ذكر حميد","لسليمان ذي العلى والحميه",40,"ي",2,0],["هي تنبي بأن احمد فيها","حاز سبق الرهان بالألمعيه",40,"ي",2,0],["هي تنبي بما لهم من مزايا","عن مداها تنحط كل مزيه",40,"ي",2,0],["هي تسقى أهل الولا سلسبيلا","وأعادي ذوي الولاء ضريعا",41,"ع",2,0],["هي تهدي حين تروي عسلا","للمحبين وللأعداء صابا",42,"ب",2,0],["هي تنمي حين تغذو طفلها","وهي تنمي طفلها حين تجيع",43,"ع",1,0],["هي تفدي بنفسها ساكنيه","كل نفسٍ من ساكنيه فداها",44,"ا",3,0],["هي تحكي في النور ثغر حبيبي","وهي في الفعل شابهت سلساله",45,"ل",2,0],["هي تسري وليس تدري سراها","لهدى كان ذاك أم لضلال",46,"ل",1,0],["هي تقضى النهار في درس علم","وهو يقضيه بين خمر وجام",46,"م",1,0],["هي تقضى الدجى بنوم هنيئ","وهو يقضيه في هوى وهيام",46,"م",1,0],["هي تلكمُ الرُوح التي","غابت عن الجسمِ النحيل",47,"ل",1,0],["هي تلك أمي ! بالحنانِ أثبتُها","فمتى يكون ثوابها وجزاها",48,"ا",3,0],["هي تربة ماذا على من شمها","إن لا يشم مدى الزمان غوالي",49,"ل",2,0],["هِيَ تِلكَ نَفس فَتى أَقا","مَ بِها عَلى حَرم الفُنون",50,"ن",1,0],["هي تصفيّه عد التنازل بلّرقام","وانتم عليكم تدفعون الرسومي",51,"م",2,0],["هيَ تنتقي سلوى الفؤادِ برزئِها","آهٍ فقد قطفَتْ أزاهرَ جنّّتي",52,"ت",2,0],["هي تختلف وأحلى من ألفين منظر","نظامها بتصير مشهور خالف",53,"ف",1,0],["هي تحتَ الظلامِ نورٌ وفي الأكبادِم","بردٌ وفي الخدودِ لهيبُ",54,"ب",1,0],["هي تلف هي نفس جواعه","والربح لي روح يحييها",55,"ي",3,0],["هي تناديني وأنا كلي غضب","طيبه مثلك بغت ورد وعبير",56,"ر",1,0],["هي تدري بأنَّني لم أخنْها","حيث بالكأسِ لن يخونَ العقارُ",57,"ر",1,0],["هَيْتَ الليَالِي عَلَى الْجُفُونِ تَمَدَّدَتْ","آهٍ..أيَا سَجَّانُ أيْنَ؟ مَتَى؟ وَمَا ؟",58,"م",2,0],["هي تربة تسمو على كيوان","شرفاً وتشرف سائر الأكوان",59,"ن",1,1],["هي تلك أمانة مقتدر","بيديك فمن لك تجحده",60,"د",2,0],["هِيَ ( تاءُ تأنيثٍ ) لفِعلٍ جَامِدٍ","( ليست ) سوى حَمّالَةِ الأوْصابِ",61,"ب",1,0],["هيَ تلكمُ الخنساءُ تطلبُ صخرَها","فتقرَّحتِ منْ دمعِها آماقُها",62,"ق",3,0],["هي توتةٌ نبتتْ وأثمرَ عودُها","وتفيَّأتْ كلُّ الورودِ بظلِّها",63,"ل",3,0],["هيتَ وليتَ الدارَ تقرُبُ ليتَها","سقيا الغمامِ تطلُّ خلف الرّائي",64,"ا",3,0],["هي تلكمُ القصواءُ شطّ مسيرُها","لم تلتفتْ للزادِ أو بردِ الشتاءْ",65,"ا",2,0],["هِيَ تَشْقَى إذا أستثارَ جَريئًا","وتَرَى فِي الحَياءِ عَيْشًا سَعِيدا",66,"د",2,0],["هيْتَ لها قبل الخنا عزةً","فإنَّ تركَ الدارِ إجرامُ",67,"م",1,0],["هِيَ تلكَ قافلةُ البشيرِ تَلُوحُ