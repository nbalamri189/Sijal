{"poems":[[65,"لمعت كناصية الحصان الأشقر","https://www.aldiwan.net/poem46196.html","الكامل"],[73,"يا أدباء الزمان إني","https://www.aldiwan.net/poem3892.html","مخلع البسيط"],[87,"أحق أنهم دفنوا عليا","https://www.aldiwan.net/poem7117.html","الوافر"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62210","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141999","المتقارب"],[201,"يا عيد عدت فأين الروض والعود","https://www.aldiwan.net/poem39816.html","البسيط"],[215,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[466,"تخطتكم أيدي الخطوب وجانبت","https://www.aldiwan.net/poem16170.html","الطويل"],[545,"كتبت إليك أستهدي نبيذا","https://www.aldiwan.net/poem56730.html","الوافر"],[580,"شفاك الله من دائك","https://www.aldiwan.net/poem2699.html","الهزج"],[591,"خذوا قودي من أسير الكلل","https://www.aldiwan.net/poem17697.html","المتقارب"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88595","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53871","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64021","الهزج"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61152","الطويل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93093","الرجز"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113986","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101062","الوافر"],[2212,"","https://poetry.dctabudhabi.ae/diwan/poem/202383","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27797","البسيط"],[2346,"","https://poetry.dctabudhabi.ae/diwan/poem/18038","البسيط"],[2446,"","https://poetry.dctabudhabi.ae/diwan/poem/21212","البسيط"],[2446,"","https://poetry.dctabudhabi.ae/diwan/poem/21208","الطويل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105671","الرمل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205766","الخفيف"],[2851,"","https://poetry.dctabudhabi.ae/diwan/poem/105589","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205077","المتقارب"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68004","الطويل"],[3929,"","https://poetry.dctabudhabi.ae/diwan/poem/198515","الكامل"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119512","الطويل"],[4815,"مياسة العود","https://www.poetsgate.com/ViewPoem.aspx?id=210424",""],[5409,"عيش ترصده المنايا ضيق","https://www.poetsgate.com/ViewPoem.aspx?id=155461",""],[5411,"ضفاف الروح..","https://www.poetsgate.com/ViewPoem.aspx?id=191907",""]],"verses":[["فخَبَتْ ببَأْسِكَ فِتْنَةٌ عرَبيّةٌ","كانت تُهَجْهِجُ بالسّوامِ النُّفَّرِ",0,"ر",1,0],["فَخَبِّروني عَن اِسمِ جَمعِ","النصف ظرفٌ وَالنصفُ حَرفُ",1,"ف",1,0],["فخبرني عن الماضين إني","شددت الرحل أنتظر المضيا",2,"ي",2,0],["فَخَبَّرَ عَنْهُمْ رَاكِبٌ قَذَفَتْ بِهِ","مَطِيَّةُ مِصْرٍ لَحمُهَا قدْ تَخَدَّدَا",3,"د",2,0],["فخبأتُ وجهي ولكنَّه","إلى الصَّدْرِ يا أمُّ مَدَّ اليدينْ",4,"ن",1,0],["فخبّراني بحقّ اللَه ربّكما","يا ساقييّ أخمرٌ في كؤؤسكما",5,"م",2,0],["فخبّوا في المطامع كيف شئتم","وخوضوا القاتمات من العقاب",6,"ب",1,0],["فخبْتٌ على مسْعاته كلُّ شامخٍ","ودانٍ قريبٌ عنده كلُّ عازِبِ",7,"ب",1,0],["فَخَبَّرتَ الأَميرَ بذاكَ غَدراً","وَكُنتَ أَخا مُفاضَحَةٍ وَمُوقِ",8,"ق",1,0],["فَخَبرني بإِصْباح","ك في الخير وإِمْسَائك",9,"ك",1,0],["فَخَبأْتُه في سَوادِ العُيونِ","وَقْد غَسلَ الدَّمْعُ ذَاكَ المَحَلْ",10,"ل",1,0],["فخبوا أَنجماً وَغابوا بدوراً","وهووا أَجبلاً وغاضوا بحورا",11,"ر",2,0],["فخَبَتْ له نيرانْ فَارِسَ آيةٌ","فغَدتْ وما تَسْطيعُ تُوقِدُ نارَا",12,"ر",2,0],["فخبزُ المرأةِ البائ","تُ خبزٌ عَسِرُ البلع",13,"ع",1,0],["فَخبر عَن المَوصوف إِن كُنت حاذِقا","فَهذي صِفات لَست فيها بِكاذب",14,"ب",1,0],["فخبطت بظعنهم","أفئدة السباسب",15,"ب",1,0],["فخَبَّرَهُم رُوّادُهُم بعد سبعَةٍ","بما سرَّهُم أن جادَ فيها فأفعَما",16,"م",2,0],["فخبر يا كتيعاً أهل روما","بما لاقيت إذ فاجأتمونا",17,"ن",2,0],["فخبرني ظنى بأنك راجع","الى الراس ملوى عليك خناق",18,"ق",1,0],["فخبروني عن أمر لا شبيه له","وما هو الله ذو الآلاءِ والرفد",19,"د",1,0],["فَخَبِّروني أَثمانَ العَباءِ مَتى","كُنتُم بَطاريقَ أَو دانَت لَكُم مُضَرُ",20,"ر",1,0],["فخبَّرتني بأمر قد سمعتُ بهِ","فيما مضى من قديم الدهر والعُصُر",21,"ر",1,0],["فخبرنا عن كلِّ خير بعلمهِ","وللحقِّ أبوابٌ لهن مفاتحُ",22,"ح",1,0],["فخبايا القلب تبدو للملا","بلساني فهي ما كانت خبايا",23,"ا",3,0],["فخبا ذلك الضياء وسدت","شرفات نضون وشي الستور",24,"ر",1,0],["فخبت عنهم تباريخ الجوى","فيك إذ مر عليهم من شذاك",25,"ك",1,0],["فخبزي خبازها إذ أجوع","ومائي نمير كذوب الدرر",26,"ر",1,0],["فخبِّر بيَ الأحبابَ يَا سعدُ إنني","أسيرٌ وإني فِي الهوى لهمُ عبدُ",27,"د",1,0],["فخبئت عنك وإنما أنا جوهر","في طي أصداف الحوادث أخبأ",28,"ا",1,0],["فخبت من الود الذي كان بيننا","كما خاب راجي البرق والبرق خلب",29,"ب",1,0],["فخبّأ العلمَ في أركانِه شغفٌ","وما يُخبَّأُ إلا الدرّ والذهبُ",30,"ب",1,0],["فخبت من الآداب بعدك جذوةٌ","من قبل غص بها الظلام الأورق",31,"ق",1,0],["فخَبِّ خَمائِلَ النُّوارِ","لا تَفْضَحْ لَهُ سِرَّهْ",32,"ر",2,0]]}