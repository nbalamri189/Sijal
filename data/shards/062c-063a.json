{"poems":[[1006,"","https://poetry.dctabudhabi.ae/diwan/poem/145934","السريع"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82831","الكامل"]],"verses":[["جُغَه، بَجعصهُ انتُف سبيله انتغهُ","مده بكعفو به اسفقه بالملا",0,"ل",2,0],["جَغبوبُ وَالسَودانُ أَدرى بِالأُلى","خانوا البِلادَ وَحُبِّبَت لَهُم الخِيانَه",1,"ن",2,0],["جَغبوبُ وَالسودانُ أَدرى بِالأُلى","صاروا أَحَقَّ بِالازدِراءِ وَبِالمَهانَه",1,"ن",2,0]]}