اته هجر الحياة وسحرها","https://www.poetsgate.com/ViewPoem.aspx?id=180863",""],[4984,"نوفمبر","https://www.poetsgate.com/ViewPoem.aspx?id=183238",""],[4119,"خذوا حديث غرامي عن ضنا بدني","https://www.poetsgate.com/ViewPoem.aspx?id=16232",""],[585,"سل الدار هل في الدار من كنت تألف","https://www.poetsgate.com/ViewPoem.aspx?id=161868",""],[5122,"(غني الاوأدم ما تكفل أبمفلسها)","https://www.poetsgate.com/ViewPoem.aspx?id=34736",""],[5246,"يودعنا ولكن لا يريد","https://www.poetsgate.com/ViewPoem.aspx?id=187055",""],[5261,"عدلا رجاءً","https://www.poetsgate.com/ViewPoem.aspx?id=213852",""],[5289,"مَوْسِمُ الْكَلامِ!","https://www.poetsgate.com/ViewPoem.aspx?id=126297",""],[5324,"بيارق الشطرنج.","https://www.poetsgate.com/ViewPoem.aspx?id=211925",""],[5397,"متى آمن الدنيا من الغدر أخدع","https://www.poetsgate.com/ViewPoem.aspx?id=157923",""],[5409,"ما لها قد شفعت أيدي الردى","https://www.poetsgate.com/ViewPoem.aspx?id=155456",""],[5431,"بلقيس...","https://www.poetsgate.com/ViewPoem.aspx?id=204633",""],[5431,"قصيد بلا شرف...","https://www.poetsgate.com/ViewPoem.aspx?id=211837",""],[5431,"تباكى كاليتامى ذات غصةْ....","https://www.poetsgate.com/ViewPoem.aspx?id=212134",""],[5461,"الجرحين","https://www.poetsgate.com/ViewPoem.aspx?id=5240",""],[5528,"حياضُ النّور","https://www.poetsgate.com/ViewPoem.aspx?id=207553",""],[5582,"أَنَّى يَكُونُ مِنَ الغَرامِ جُحُودُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=186884",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5948,"ربَّ مغمومِ بعَافيةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=100597",""],[6031,"تَوَشَّحَتِ السَّمَاءُ بِبُرْدِ غَيْمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=46337",""],[6031,"رَعَتْ قُريشٌ فِينَا الذِّمامَ على","https://www.poetsgate.com/ViewPoem.aspx?id=46269",""],[6131,"نحَّاتُ نورٍ","https://www.poetsgate.com/ViewPoem.aspx?id=189270",""],[2220,"يلبي نداءَ الحقِّ منْ كانَ داعياً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11905&r=&rc=774",""],[4890,"دروب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72401&r=&rc=91",""]],"verses":[["يُوَلِّعُ الطَلُّ بُردَينا وَقَد نَسَمَت","رُوَيحَةُ الفَجرِ بَينَ الضالِ وَالسَلَمِ",0,"م",1,0],["يولونَني خُزرَ العُيونِ لِأَنَّني","غَلسَتُ في طَلَبِ العُلى وَتَصَبَّحوا",1,"ح",3,0],["يولِغُ ظِفراً لِلرَدى وَنابا","لا يَبكِيَن حاضِرُنا مَن غابا",2,"ب",2,0],["يؤلّفُ بالحُسْننَى قُلوباً تفرّقَتْ","يفرِّقُ بالإحْسانِ ما لا يؤلِّفُ",3,"ف",1,0],["يُوَلّونَني عُرضَ الكَراهَةِ وَالقِلى","وَما دَهرُهُم إِلّا النَفاسَةُ وَالغَمطُ",4,"ط",1,0],["يُؤَلِّفُ بَيْنَ حُضَّارٍ وَبَدْوٍ","بِهَا عَهْدُ العُرُوبَةِ وَالذِّمامُ",5,"م",1,0],["يؤلف بين ضفدعة وضبٍّ","ويعجب أن نَبَرَّ بني أبينا",6,"ن",2,1],["يولد فضل مولدِهِ سعوداً","بنو سعدٍ بها أبداً وضاء",7,"ا",2,0],["يُؤلمُ بالفصْد كفَّ ذي غُنُجٍ","تَفْصِدُ منا القلوبَ عيناهُ",8,"ه",1,0],["يُولجُ في زوجتهِ","أَيْرَ سِوَاهُ بِيَدِهْ",9,"د",2,0],["يولي المُولّي منهُمُ وهْو مانعٌ","حقيقتهُ لم يخزَ منه المذمَّر",10,"ر",1,0],["يُولينَ ما فيه إغرامٌ وآونةً","يولينَ ما فيه للمشعوفِ سُلوان",11,"ن",1,0],["يُوَلَّهُ عَقلي قامَةٌ وَرَشاقَةٌ","وَيَخلُبُ قَلبي أَعيُنٌ وَثُغورُ",12,"ر",1,0],["يؤلم القلب قلب من يتروى","أن هذا عهدٌ وذلك عهد",13,"د",1,0],["يُؤَلِّفُ إيلامُ الحَوادِثِ بَينَنا","وَيَجمَعُنا في اللَهِ دينٌ وَمَذهَبُ",14,"ب",1,0],["يولَدُ السَيِّدُ المُتَوَّجُ غَضّاً","طَهَّرَتهُ في مَهدِها النَعماءُ",15,"ا",2,0],["يولي المُوالينَ مِن جَدوى شَفاعَتِهِ","مُلكاً كَبيراً عَدا ما في نُفوسِهِمِ",16,"م",1,0],["يولُّونَهُ في البرِّ قصدَ خمولِهِ","فيصبحُ ميِّتاً والضياعُ له قَبْرُ",17,"ر",1,0],["يُؤَلِّلُ مِن أُذنٍ فَأُذنٍ تَشَوُّفاً","إِلى صَرخَةٍ مِن هاتِفٍ أَو تَطَلُّعا",18,"ع",2,0],["يُؤَلِّفُ بَينَنا نَسَبٌ قَريبٌ","وَيَجمَعُنا التَوَدُّدُ وَالوِئامُ",19,"م",1,0],["يُؤَلِّفُ بَينَ القَومِ بُغضي وَما لَهُم","سِوى فَرطِ إِجماعٍ عَلَيَّ جَميعُ",20,"ع",1,0],["يولي بِأَنَّ الجِنَّ تَطرُقُ بَيتَهُ","وَلَهُ يَدينُ فَصيحُها وَالأَعجَمُ",21,"م",1,0],["يولد الدهر ناساً","وَبعد ذلك يبلي",22,"ل",2,0],["يؤلّفُها على الأحداث صفاً","جسورَ النفس جبّار العُرامهْ",23,"م",2,0],["يولي النفوس بشاشة وينيلها","أدبا ويسقيها الوداد صراحا",24,"ح",2,0],["يُوَلّي الحِسْلُ عنها مُسْتَجِيرا","ويَكْرَهُ قُرْبَها ضَبُّ البَداوَه",25,"ا",3,0],["يُؤَلِّفُ أَشْتَاتَ الْمَحَامِدِ جَاهِداً","بِإِخْفَاءِ بَادِيهَا فَيَظْهَرُهُ الْحَمْدُ",26,"د",1,0],["يؤّلّفُ البؤسُ منهُ","في كل يوم كتابا",27,"ب",2,0],["يولد فضل مولدهِ سعوداً","بنوا سعدٍ بها أبداً وضاء",28,"ا",2,0],["يؤلفهم ايمانهم واحتسابهم","كمؤتلف الأنصار والدخل عارم",29,"م",1,0],["يؤلف بالحسنى قلوبا تفرقت","يفرق بالإحسان ما لا يؤلف",30,"ف",1,0],["يولون : في أنثى من أنثى خليفة","ٌ وقدْ كذبُوا، بعضُ الأَوَانِسِ نَيْرَبُ",31,"ب",1,1],["يُوليكَ صَدْرَ اليَوْمِ قاصِيَةَ الغِنَى،","بمَوَاهب قَد كُنّ، أمسِ، مَوَاعِدَا",32,"د",2,0],["يؤلفها حينا وتطفر جفّلا","وحاول لم يقنط إلى أن تغلّبا",33,"ب",2,0],["يُولي الجميلَ وصرفُ الدهرِ يقبضُ مِن","يَديْهِ والفحلُ يَحمي وهو في العُقَلِ",34,"ل",1,0],["يُولَدُ المَرءُ لِلحَياةِ اِضطِراراً","وَاِضطِراراً يَذوقُ كاسَ الحِمامِ",35,"م",1,0],["يوليكَ ما حسد الحسود لهُ","يكفيك منه وحسبه كمده",36,"د",2,0],["يولى النوال تكرما من غير ما","مدح عليه ومثله من يمتدح",37,"ح",1,0],["يولِّد فيها المزجُ دُرّاً منضّدا","كما كُتبت فوق الثرى نُقَطُ القَطْر",38,"ر",1,0],["يوليكَ مُقتَبِلُ الشَبا","بِ نُهىً وَرَأياً أَشيَبا",39,"ب",2,0],["يولّي ظهره المحنيّ خزياً","ويجري .. لا يهاب من افتضاح",40,"ح",1,0],["يولِغُ في دَمِ العِدا سِنانَهُ","إِذ كانَ مِسمارُ السِنانِ ثَعلَبا",41,"ب",2,0],["يُولي ولا يعتذرُ","عمّا عليه يَقدِرُ",42,"ر",1,0],["يولي الجَزيلَ ولا يَمنُن بكَثرته","وَيوسعُ الضَيفَ إن قَلّوا وإن كثروا",43,"ر",3,0],["يُولي عَديمهم ويحملَ كلّهم","وَيُبادرُ الكربات بالتنفيسِ",44,"س",1,0],["يُوَلَّدُ لي في كُلِّ آنٍ صَبابَةً","وَدَهري بِبَرئي مِن هَوايَ عَقيمُ",45,"م",1,0],["يَولّد إنشائي الثَناءَ عَلَيكُمُ","فَيَخرُج مِن بَينَ التَرائب وَالصُلبِ",46,"ب",1,0],["يُؤْلِفُ الشَّدَّ عَلى الشَّدِّ كَما","حَفَشَ الوَابِلَ غَيثٌ مُسبكرّْ",47,"ر",1,0],["يؤلِّفُ بينَ الأسدِ تحتَ لِوائِه","وكلُّ مكان حَلَّ فيهِ عَرِينُها",48,"ن",3,0],["يؤلِّفنا منهجٌ واحدٌ","أتانا به المصطفى المُرْسَلُ",49,"ل",1,0],["يُؤلي أليَّةَ صادقٍ لو لَمْ يكن","لي غير يحي ابْني نصيراً في الورى",50,"ر",2,0],["يولي الطعان بحربه","وبرحبه يولي النعم",51,"م",1,0],["يولي الندى والردى فذا لموا","ليه وهذا لمعتدٍ ختره",52,"ر",2,0],["يؤلِّل عُصْلاً لابُناهُنَّ هَيْنةً","ضِعافاً ولا أطرافهن نوابيا",53,"ي",2,0],["يولي النُضارَ إذا ضنّ الحيا كرَماً","ويعصِمُ الرأيَ أن يُفضي إلى الزّلَلِ",54,"ل",1,0],["يُؤْلمني جزاءُ ما","داويتُه من الأَلَمْ",55,"م",1,0],["يولِجُ حِرماني عَلى مُنْيَتِي","خَبْطاً وإيلامِي على لَذَّتِي",56,"ي",1,0],["يُوَلِّدْنَ لِذِي الشَّهْوَ","ةِ جُوعَاً وَيُشَهِّيْنَهْ",57,"ن",2,0],["يُولي صنائعهَا العظامَ لِذَاتِها","لا رغبةً في الشكر مِنْ أَصْحَابِها",58,"ب",3,0],["يُولّيكَ فيه جسامَ الأمورِ","فأنتَ صَنيعُ بني هاشمِ",59,"م",1,0],["يولي النزيل مكارماً وجلالة","فشؤونه بين المخافة والرجا",60,"ج",2,0],["يولد الطفل لهم أو ينتشى","وعليه من نقيع الرعب نضح",61,"ح",1,0],["يُوَلِّيك على القَرْنِ","ويستولي على الضَّرْع",62,"ع",1,0],["يُوَلّونَ أَدباراً يَضلّونَ في الفَلا","وَقَد شدَّ حبل الضّيقِ فَوقَ الحَلاقِمِ",63,"م",1,0],["يُوَلّيهِ حُكمَ اللّيلِ مِن أَجلِ راحَةٍ","وَيَحكُمُ فيما فيهِ يَبدو ظهورهُ",64,"ر",2,0],["يُوَلّيهِ شَهراً ثمَّ ينصب غَيره","وَيَعزِلُهُ غَضبان ثمّ يُبيرُهُ",64,"ر",2,0],["يُولِى الجميل وإن يُعادَى","يدوخِ الثائرَ المبارزْ",65,"ز",1,0],["يولي العهد لا ريع الحمى","وجميل الصنع عنه يَدفع",66,"ع",1,0],["يولي الجواهر داجي رفده فغدت","قرى جواهره فينا وقرآنا",67,"ن",2,0],["يولي الوادي خصباً سفرا","ويزين النادي إذا حضرا",68,"ر",2,0],["يولّهة الجمال الطلق","في الأحداق والشنب",69,"ب",1,0],["يولي الجَميل وَقَد تَخشى بَوادره","في طَيه نعم تنحل عَن نقم",70,"م",1,0],["يولّف بعض تلفيق وخلطٍ","ويزعم أنه قد صار شاعرْ",71,"ر",1,0],["يؤلف فى صمت قلائد لم تكن","يؤلفها فرد وإن جهر الفردُ",72,"د",1,0],["يولي السعادة او تبلي بليَّتُهُ","اللَه يحفظ ان زلَّت لك قدمٌ",73,"م",1,0],["يوليكها قبل السؤال متوجٌ","في راحتيه الحسن والإحسان",74,"ن",1,0],["يولي التي ذهب القصاص بزوجها","ذهباً كأن الحكم أصبح مغرما",75,"م",2,0],["يوليك نداه ومنطقه","فيفيض الدر على الدر",76,"ر",1,0],["يوليك مقترباً ومبتعداً كما","يوليك بحرٌ جاء منه مطير",77,"ر",1,0],["يوليكها قمرٌ يريك قوامه","بانَ الغوير على هضاب ثبير",78,"ر",1,0],["يولي الندى ويواليه بلا مَهَلٍ","ويعتري السحب ابطاءٌ وامهالُ",79,"ل",1,0],["يُوليك نُصحاً من لسان مُسالمٍ","وًَيُسِرٌّ كيداً في ضمير مُحاربِ",80,"ب",1,0],["يولي صنائعَهُ الرجال وعندَهُ","علَلُ السؤال إِذا فصلن صنائعُ",81,"ع",1,0],["يولي المعز اختافا خفاقا","تغادر كل صخر فلقتين",82,"ن",1,0],["يُولونَ ما لَهُمُ مَن قَد لَجا لَهُمُ","فاِشدُد يَداً بِهِمِ وانزِل بِبابِهِمِ",83,"م",1,0],["يؤلِّفُ الناس بالألطاف يُسعِفُهم","فلا لهُ مبغِضٌ أو حاسدٌ شان",84,"ن",1,0],["يولي الشَليل وَما مَسَّت وَليّتهُ","مُوثَّقاً ذا كَراديسٍ وَأَثباجِ",85,"ج",1,0],["يولي الأيادي شفعاً ولكن","تلقاه في المكرمات وترا",86,"ر",2,0],["يُوَلّي قَفاهُ حينَ يُدعى إِلى الوَغى","وَيَلبُدُ فَوقَ الخُصيَتَينِ عَلى رُعبِ",87,"ب",1,0],["يوليه أمرَ الكونِ فهو خليفته","وإقليده التقليد إنْ كنت واعيا",88,"ي",2,0],["يوليهم شرّاً إذا كفروا","وينيلهم خيراً إذا حمدوا",89,"د",3,0],["يؤلمها قرع السياط فتنثني","تحن فيشجى صوتها كل جلمد",90,"د",1,0],["يؤلف اهواء النفوس بحكمة","ويرضى اذا ما راح ذو الجهل يغضب",91,"ب",1,0],["يُؤَلفُ الخَلقَ بِحِكمَتِهِ","حَتّى استقامَ الكُلُّ من عِوَجِ",92,"ج",1,0],["يُولي قَبولاً عَرفُهُ عَطِرٌ","مُطَيِّبُ الأنفاسِ والأَرَجِ",92,"ج",1,0],["يُولي الجَميلَ وَيَنساهُ وَيذكرُ ما","تُوليهِ شُكراً لَهُ مِن ذاكِرٍ ناسِ",93,"س",1,0],["يولِّد السرُور والافراحا","ان صار في كيْلوسه صلاحا",94,"ح",2,0],["يُوَلِّي وَيعزِلُ مِن يَومِهِ","فَلا ذا يَتمُّ وَلا ذا يَتمّ",95,"م",1,1],["يولي الجميل صنيعه","وحلاة ترضى من يغاضب",96,"ب",1,0],["يؤلف بيننا ادبٌ وفضلٌ","كزهر الروض طاب لمجتنيه",97,"ي",2,0],["يؤلِّهُنَ جماداً لا حَرَاك لَهُ","ويُنكرون قديراً صوَّرَ الصُّوَرَا",98,"ر",2,0],["يولّد الفكر أشجاناً إذا عصفت","تطير لي نشوتي والخمر والكاسا",99,"س",2,0],["يؤلمني الجسم بآلامه","كأنما جسمي غدا خصمي",100,"م",2,0],["يؤلف من أسرابه لي قصائداً","فطوراً لها نظم وطوراً لها نثر",101,"ر",1,0],["يولمسنا فيه نابا قاتلا","تحته نزت أفاويق السنين",102,"ن",1,0],["يولد الطفل للعذاب وهذي","سنة الدهر وقي