ليلى وضافنى","https://www.poetsgate.com/ViewPoem.aspx?id=200786",""],[5605,"ملحمة الحذاء","https://www.poetsgate.com/ViewPoem.aspx?id=159791",""],[5628,"الى قريتي الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=178470",""],[5956,"بوصلة العقل العربي الخربَة","https://www.poetsgate.com/ViewPoem.aspx?id=192073",""],[6068,"عُجْبا أقول ودمع العين منسكبُ -10-","https://www.poetsgate.com/ViewPoem.aspx?id=175888",""],[6068,"‫#العراق‬ -04-","https://www.poetsgate.com/ViewPoem.aspx?id=177020",""],[6202,"فليسقط الشعر -2","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86741&r=&rc=42",""],[6277,"شرب فطرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64450&r=&rc=13",""]],"verses":[["إِذا يابِسُ الماءِ بَلَّ الحِزامَ","طارَت بِهِ غُلواءُ المِراحِ",0,"ح",1,0],["إِذا يَقَعُ السِهامُ بِجانِبَيهِ","تَأَخَّرَ قابِعاً فيهِ صُدودُ",1,"د",1,0],["إذا يُساوِرُ قِرناً لا يَحِلُّ لَهُ","أَن يَترُكَ القِرنَ إِلّا وَهُوَ مَفلولُ",2,"ل",1,0],["إِذا يُعارِضُهُ وَعثٌ أَقامَ لَهُ","وَجهَ الظَعائِنِ خَلٌّ يَعسِفُ الضَفِرا",3,"ر",2,0],["إذا يُضَاحِكُ فيها الوَرْدُ نَرْجِسَها","باهى زَكِيَّ خُزَاماها بَنَفْسَجُها",4,"ج",3,0],["إِذا يُقالُ اِتَّئِب رَدَّت صَبابَتُهُ","إِلَيهِ ثابِتَ وَجدٍ لَيسَ يَتَّئِبُ",5,"ب",1,0],["إِذا يَثورونَ أَفواجاً كَأَنَّهُمُ","جَرادُ ريحٍ مِنَ الأَجداثِ مَنشورِ",6,"ر",1,0],["إِذا يَلطُمونَ وَلا يَخشَونَ مُقلَتَهُ","طَعناً دراكاً وَضَرباً غَيرَ مَأفونِ",7,"ن",1,0],["إِذا يَجلو الحَمِيّا وَالمُحَيّا","شَهِدنا الجَمعَ بَينَ النَيِّرَينِ",8,"ن",1,0],["إِذا يَدُهُ بِنائِلِهِ اِستَهَلَّت","فَوَيلٌ لِلنُضارِ وَلِلُّجَينِ",9,"ن",1,0],["إِذا يَئِسَت نَفسُ اِمرِىءٍ مِن قَريبَةٍ","تُبَدَّلَ أُخرى مَركَباً بَعدَ مَركَبِ",10,"ب",1,0],["إِذا يَسَّرَ اللَهُ الخُطوبَ فَكَم يَدٍ","وَإِن قَصُرَت تَجني مِنَ الصابِ تَمرَها",11,"ر",3,0],["إِذا ئلَجَأتُهُم ساعَةٌ مِن زَمانِهِم","إِلى الشَرِّ لَم يُغنوا فَتيلاً وَلَم يَنكوا",12,"ك",3,0],["إِذا يَدُنا لم تُذْكِ نارَ حياتنا","فلا تَرْجُ دِفئاً من وميضِ رعودِ",13,"د",1,0],["إذا يَدُنا لم تَحْمِ نَبْعَ حياتنا","سرى رِيُّهُ سمّاً بكلِّ وريدِ",13,"د",1,0],["إِذَا يَئِسَتْ نفْسُ امْرىء ٍ من قَرينة","ٍ تبدَّل أخرى مركباً بعد مركبِ",14,"ب",1,0],["إذا يُذكر الوردُ في مجلسٍ","مع الورد تسرد أخبارنُا",15,"ن",2,0],["إِذَا يَمَّمَتْهُ القاصِدُونَ تَيَسَّرَتْ","عليهمْ وإنْ لم يسألوكِ المقَاصدُ",16,"د",1,0],["إذ آية الظرف حرف في تنادمنا","يوحي إلى العزف أنواع الأغاريد",17,"د",1,0],["إِذا يَلطِمونَ وَلا يَخشَونَ مُقلَتَهُ","طَعناً دِراكاً وَضَرباً غَيرَ مَرهونِ",18,"ن",1,0],["إذا ينداح ضلعي نحو قلبي","يحز بنصلهِ قلبا فتيا",19,"ي",2,0],["إِذا يَمَسُّ الأَرضَ في جَريِهِ","خِيفَ عَلى راكِبِهِ الاِصطِلام",20,"م",1,0],["إِذا يَومي أَظَلَّ فَما أُبالي","بِسَيفٍ كانَ حَتفي أَو سِنانِ",21,"ن",1,0],["إذا يَممت حَيْدرةً لفضلٍ","فدُونَك ما تُريد بلا حجاب",22,"ب",1,0],["أذائب التبر أبدى جوهر الحبب","أم ريق مبسمه قد شيب بالشنب",23,"ب",1,1],["إِذا يئسَ المرءُ من أَيرِهِ","رأَت عِرْسُهُ اليأس من خيرهِ",24,"ه",1,1],["إِذا يَدٌ لَم تُفِد بِالرِّفدِ مُمتَدِحاً","مَعَ الغِنى فَرَماها اللَهُ بِالشَلَلِ",25,"ل",1,0],["إذا يعطو لها بالجيد دلّتْ","فتعطف تارةً وَتصدُّ تارا",26,"ر",2,0],["إِذا يَأسُونَها نَشَزَت عَلَيهِمْ","شَرَنبَثةُ الأَصابِع أُمُّ هَامِ",27,"م",1,0],["إذا يُعَادُ لها ذِكْرٌ أُكَذِّبُهُ","حتى أتَتْني بِهَا الأنْبَاءُ وَالخَبَرُ",28,"ر",1,0],["إذا يَئِسَ المَرْءُ من أَيرهِ","رَأَتْ عِرْسُهُ اليَأْسَ مِن غَيْرهِ",29,"ه",1,1],["إذا يَمينُ أميرِ المؤمنينَ غدا","وقد تسوَّرها فالفَخْرُ أغناني",30,"ن",2,0],["إِذا يَضحَكنَ أَو يَبسِمنَ يوماً","ترى بَرَداً أَلَحَّ به الصَّقيعُ",31,"ع",1,0],["إذا يَسرُوا لم يُورِثِ اليسر بَيْنَهُمْ","فَواحِشَ يُنعى ذِكْرُها بالمَصايِفِ",32,"ف",1,0],["إذا يَدُه طالَت إلى صَرفِ صَرفِه","أطالَت لِساني حيثُ تَقصرُ ألسُنُ",33,"ن",1,0],["إذا يَدُهُ عُلِّقَت","من النَّصلِ بالقائِمِ",34,"م",1,0],["إذا يمَّمته يَمَّمتُ يمناً","وإنْ طالعته طالعتُ سعدا",35,"د",2,0],["إِذَا يَمَّمَتْ منه حِمىً فكأَنَّما","أَرَبَّتْ عَلَيْهِ مُصْعِقاتُ الرَّواعِدِ",36,"د",1,0],["إذا يومُ عيدٍ زفّها قام ناصباً","لتجهيزِ أُخرى مثلِها لك عيدُ",37,"د",1,0],["إذا يَبِستْ أقلامُهُ أو تصامتتْ","فصارمُهُ رَطْبُ اللسانِ خَطيبُ",38,"ب",1,0],["اذا يمَّماها في الظَّلامِ تألَّقَتْ","بمُنْبلجٍ منْ واضحِ الشر لامعِ",39,"ع",1,0],["إذا يمنٌ حفَّت بقيسٍ تألقت","هناك مصابيح الطلاقةِ والنجح",40,"ح",1,0],["إذا يَدُه البيضاءُ أخرَجَها النّدى","فيا وَيلَ أمّ البيضِ والورقِ الصُّفْرِ",41,"ر",1,0],["إذا يراعٌ لظى الهيجاء أضرمَ او","في باطل كان مثل السيف قد رهفا",42,"ف",2,0],["إِذا يَنتَضي قَلَماً كَالعَضبِ يَظهَرُهُ","عَلى حُسامٍ صَقيلِ الحَدِّ ماضيهِ",43,"ي",2,0],["إذا يشار إلى جود ومكرمة","عليا فإنَّك أنت المفرد العلم",44,"م",1,0],["إذَا يُشَارُ إلى فَضْلٍ ومَكْرُمَةٍ","عَليكُم اقْتَصَرتْ كل الإشارَاتِ",45,"ت",1,0],["إذا يَدٌ نَضَبَت دَرّت عَلَيَّ يَدٌ","أو أَقلَعَت مِنَنٌ أمطَرنَني مِنَنُ",46,"ن",1,0],["إذا يئستُ فشارفتُ السُّلوّنكى","قُرحي وهيّجَ شوقي طائرٌ غرد",47,"د",1,0],["إذا يفصِلُ الحاكُم القضاءَ","أَبرا إليكم من الأعادي",48,"ي",1,0],["إذا يدٌ لمسته من غضاضته","وحسن نعمته أبقت به ندبا",49,"ب",2,0],["إذا يغزو محبيه بلحظٍ","فسل كم من قتيل أو جريح",50,"ح",1,0],["إذا يمم العافي مَريع جنابنا","فقد حمدت طيَّ الفيافي رواحله",51,"ل",2,0],["إذا يموت الورد لا يمحي","إلا السنا واللون والرونق",52,"ق",1,1],["إذا يموت الورد يمضي الشذا","إلى جواءٍ خلف هذا الجواء",53,"ا",2,0],["إِذا يممت نَحوَ الأَحبة ناقَتي","وَأعملت السير الحَثيث وَخبت",54,"ت",1,1],["إذ أي قطْر في الأمان كقطرنا","فحماه للوجلان نعم المرتقدْ",55,"د",1,0],["إِذا يُلِمُّ بِهِ خَطبٌ ذكَرتَ بِهِ","تِلكَ النَعامَةَ لَم تَحمِل وَلَم تَطِرِ",56,"ر",1,0],["إِذا يَشكُريٌّ مَسَّ ثَوبَكَ ثَوبُهُ","فَلا تَذكُرَنَّ اللَّهَ حَتّى تَطهرا",57,"ر",2,1],["إذَا يَسَّرَ اللّهُ الأمُورَ تَيَسَّرَتْ","وَلانتْ قُواهَا واستَقَادَ عَسِيرُها",58,"ر",3,0],["إذا ينادي الحسين فيها ألا هل","من نصير فلا يجاب النداء",59,"ا",2,0],["إذا يرنو فكالظبي التفاتاً","وان يبدو فكالريح انتصابا",60,"ب",2,0],["إذا يبق منها غير ثلثٍ","من الأذنين والذنب الرديد",61,"د",1,0],["إِذا يَمَّمَهُ الساري","هَدى الساري الَّذي يَسري",62,"ر",2,0],["إِذا يَجِفُّ ثَراها بَلَّها ديمٌ","مِن كَوكَبٍ نَزل بِالماءِ سَجّامِ",63,"م",1,0],["إذا يحددني في كلِّ آونة","فلا أزال مع الأنفاسِ في كبد",64,"د",1,0],["إذا يفصله علمي يحدّده","وهمي وما يقبل التفصيل يجمله",65,"ل",2,0],["إذا يصح له من أصله نَسبٍ","صحَّ اللباسُ لباسَ الفخرِ والتيه",66,"ي",2,0],["إذا يحكمني فيما يملكني","في الحال أحجره فكيف اعتمد",67,"د",1,0],["إذا يستخير العبد مما يهمُه","يصلِّي ويدعو ركعتين على السوا",68,"ا",1,0],["إذا يضيق بنا أمر ليزعجنا","نصبر فإنَّ انتهاءَ الضيقِ ينفرجُ",69,"ج",1,1],["إذا يحس بأصواتِ اللهيبِ بها","يأتي إليه رجيمُ السمعِ يستمع",70,"ع",1,0],["إذا يرانا فلا شكَّ يداخلنا","إني أراه فإني النائبُ الوالي",71,"ل",2,0],["إذا يسلك الشيطان فجاً سوى الذي","سلكت ولا يلفى سبيلا إلى مكر",72,"ر",1,0],["إِذا يَومُ نَحسٍ هَبَّ ريحاً كَسَونَهُ","ذُرى عَقداتٍ تُربهنَّ دَقيقُ",73,"ق",1,0],["إذا يهب النسيم سهلا","يلعب فيه كما يشاء",74,"ا",2,0],["إذا يهش إلى الاصباح عاوده","ليل من الهم تغشاه غواشيه",75,"ي",2,0],["اذا يدها على القيثار مرت","تحرك للصبابة كل خال",76,"ل",1,0],["إِذا يَكونُ فعلُه تردُّدا","في فعلهِ أَو تَركه ما قَد بَدا",77,"د",2,0],["إذا يا ابن عاشُور تُحرّمُ خلّتي","فإنّي غنيٌّ عنك أعظمُ مأجُور",78,"ر",1,1],["إذا ياسرت احرزت المعلى","وان اجريت احرزت المجالا",79,"ل",2,0],["إذاي نادى به الملهوف يوما","نضى من عزمه سيفاً صقيلا",80,"ل",2,0],["إذا يئستْ عُقبانُها من خَصيلة","رفعتَ إليها الدارعينَ على القَنا",81,"ا",1,0],["إذا يدُها وافدَتْ رِجلَها","بأغبرَ يزدادُ إلاّ اغبرارا",82,"ر",2,0],["إذا يقوم يملأ الأرض من ال","عدل كما من قبله الظلم انتشر",83,"ر",1,0],["إِذا يمَّمَ الحادي بَدِيعَك أوحَدَا","غَدَوتُ على حُكمِ الهَوَى فِيكَ أوحَدا",84,"د",2,1],["إِذا يَزِنُ الناسُ أَحلامَهُم","وَجَدتُهُم رُجُحَ المُحتَفَل",85,"ل",1,0],["إِذا يوسِرونَ فَلا يَبطِرونَ","وِيَومَ البَلاءِ كِرامُ البُلَل",85,"ل",1,0],["إِذْا يَدُهُ الْكَرِيمَةُ صافَحَتْهُ","فَقُلْ فِي لاَمِعٍ أو أَلْمَعيِّ",86,"ي",1,0],["إذا يجي البرءُ يجي","من دَرَكٍ ودُرَجِ",87,"ج",1,1],["إِذا يَمَّمنَ خَيلاً مُسرِعاتٍ","جَرى بِنُحوسِ طَيرِهُمُ الغُرابُ",88,"ب",1,0],["إذا يسرحُ ضأنا","مائة أتبعها ضانا",89,"ن",2,0],["اِذا يَئِسَ الطَبيبُ وَكل عَنّي","بِقُدرَتِهِ بِما أَرجو حَباني",90,"ن",2,0],["إِذا يَجني عَلَيَّ بَذَلتُ نَصري","وَيَبذُلُ مِثلَ ذَلِكَ إِن جَنَيتُ",91,"ت",1,0],["إذا يراعتُهُ في كفِّه خَطَرَتْ","أنساكَ كلَّ قويمِ المتنِ خطَّار",92,"ر",1,0],["إذا يمّموا يوماً إمام مكارم","فأحمد قد اضحى أمام إمامها",93,"م",3,0],["إِذا يَدٌ سَرَقَت فَالحَدُّ يَقطَعُها","وَالحَدُّ في سِرقَةِ العَينَينِ لا يَجِبُ",94,"ب",1,0],["إذا يرضى بيا","أنا لو مكسوب",95,"ب",1,0],["إِذا يَبدو اِمرؤٌ مِن حَيّ لَيلى","يَذلُّ لَهُ وَيَنكَسِرُ اِنكِسارا",96,"ر",2,0],["اذا يممته لعظيم امر","اشاح له على جد انتهاض",97,"ض",1,0],["إذا يَمرُّ ضياءٌ فوقَ شفَّتِها","يغدو نبيذاً مِنَ التُّوليبِ والبَللِ",98,"ل",1,0],["إذا يَشمُّ نسيمٌ عطرَ راحتِها","يُراسلُ الزَّهرَ أنْ تأتي على عَجَلِ",98,"ل",1,0],["ِاذا يُرضيكَ ربّي وَهْبَ روحي","فخُذْ ما شئتَ أرجو منكَ عُتْبى",99,"ب",2,0],["إذا يدنو ..ذكرتُ اللُّحمةَ الأولى ..","وشطرتَنا .. ووعدا ..\"سوف ألقاهُ\"",100,"ا",2,0],["إذا يأتيهِ مَكلومٌ","لَعَمْرُكَ طابَ لو شَرِبَا",101,"ب",2,0],["اذا يقري العفاة به جواد","يباري البحر جودا والرياحا",102,"ح",2,0],["إذا يرِفُّ يميسُ الفجرُ في سُحُبٍ","فيهطِلُ الحُسنُ ذكرَ العَارض اللَّهِجِ",103,"ج",1,0],["إذا يومًا ذكرتُكَ حالَ بعْدي","وشاقتني ابتسامتُكَ الظّريفهْ",104,"ف",2,0],["إذا يمم الحادي بها حضرة العلا","أرتك انسياب الفلك تحت المحامل",105,"ل",1,0],["اذا يوما أرادَ العيشَ حراً","ترى منه الهواءَ بها تَنَخَّلْ",106,"ل",1,0],["اذا يده بلّت «2» بقائم سيفه","هوت قمم الاعداء من كلّ جانب",107,"ب",1,0],["إذا يوما شهامتنا استفاقت","فما سرٌ لَدَينَا له خَفَاءُ",108,"ا",2,0],["إذا يوما ذُكرت على لسانٍ","أهابَ بمسمعي للقلب خفْقُ",109,"ق",1,0],["إذاً يَعْرِفُ الأجنبِيِّينَ أرقى","ففضَّل بالذل أن \"يستقيما\"",110,"م",2,0],["إذا يغيب ضياها فالجنون بها","منّي توارثه العشاق والنَدَبُ",111,"ب",1,0],["إذا يقرّب ربّي مهحتي وفمي","أرض الرباط الذي حالت معالمه",112,"م",2,0],["إذا يغض لطرفٍ مثل قادتنا","ولا يقاوم محتلا وغدارا",113,"ر",2,0],["إذ آية الظّرف صرف في تنادمنا","يوحي إلى العزف أنواع الأغاريد",114,"د",1,0]]}