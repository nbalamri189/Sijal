{"poems":[[53,"بروم السيوف وغرب الرماح","https://www.aldiwan.net/poem30653.html","المتقارب"],[3,"تركت جرية العمري فيه","https://www.aldiwan.net/poem94.html",""],[24,"بانت سعاد فقلبي اليوم متبول","https://www.aldiwan.net/poem21877.html","البسيط"],[30,"يا دار مية بالخلصاء غيرها","https://www.aldiwan.net/poem29593.html","البسيط"],[56,"وليلة بات طل الغيث ينسجها","https://www.aldiwan.net/poem58473.html","البسيط"],[45,"يشكو إليك هواك المدنف الوصب","https://www.aldiwan.net/poem11494.html","البسيط"],[28,"كيف ببيت قريب منك مطلبه","https://www.aldiwan.net/poem5081.html","البسيط"],[58,"أمن تذكر دهر غير مأمون","https://www.aldiwan.net/poem30819.html","البسيط"],[66,"أذاب التبر في كأس اللجين","https://www.aldiwan.net/poem40114.html","الوافر"],[44,"خشنت عليه أخت بني خشين","https://www.aldiwan.net/poem30339.html","الوافر"],[50,"ألا قل لتلك المالكية أصحبي","https://www.aldiwan.net/poem64863.html","الطويل"],[46,"أتت جامع يوم العروبة جامعا","https://www.aldiwan.net/poem22610.html","الطويل"],[46,"لخالقنا الحكم القديم وكم فتى","https://www.aldiwan.net/poem23062.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39660","الطويل"],[50,"ألا قلْ لتلك المالكيَّة ِ أصحبي","https://www.poetsgate.com/ViewPoem.aspx?id=16887",""],[99,"سؤال","https://www.poetsgate.com/ViewPoem.aspx?id=7380",""],[67,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""]],"verses":[["إِذا يابِسُ الماءِ بَلَّ الحِزامَ","طارَت بِهِ غُلواءُ المِراحِ",0,"ح",1,0],["إِذا يَقَعُ السِهامُ بِجانِبَيهِ","تَأَخَّرَ قابِعاً فيهِ صُدودُ",1,"د",1,0],["إذا يُساوِرُ قِرناً لا يَحِلُّ لَهُ","أَن يَترُكَ القِرنَ إِلّا وَهُوَ مَفلولُ",2,"ل",1,0],["إِذا يُعارِضُهُ وَعثٌ أَقامَ لَهُ","وَجهَ الظَعائِنِ خَلٌّ يَعسِفُ الضَفِرا",3,"ر",2,0],["إذا يُضَاحِكُ فيها الوَرْدُ نَرْجِسَها","باهى زَكِيَّ خُزَاماها بَنَفْسَجُها",4,"ج",3,0],["إِذا يُقالُ اِتَّئِب رَدَّت صَبابَتُهُ","إِلَيهِ ثابِتَ وَجدٍ لَيسَ يَتَّئِبُ",5,"ب",1,0],["إِذا يَثورونَ أَفواجاً كَأَنَّهُمُ","جَرادُ ريحٍ مِنَ الأَجداثِ مَنشورِ",6,"ر",1,0],["إِذا يَلطُمونَ وَلا يَخشَونَ مُقلَتَهُ","طَعناً دراكاً وَضَرباً غَيرَ مَأفونِ",7,"ن",1,0],["إِذا يَجلو الحَمِيّا وَالمُحَيّا","شَهِدنا الجَمعَ بَينَ النَيِّرَينِ",8,"ن",1,0],["إِذا يَدُهُ بِنائِلِهِ اِستَهَلَّت","فَوَيلٌ لِلنُضارِ وَلِلُّجَينِ",9,"ن",1,0],["إِذا يَئِسَت نَفسُ اِمرِىءٍ مِن قَريبَةٍ","تُبَدَّلَ أُخرى مَركَباً بَعدَ مَركَبِ",10,"ب",1,0],["إِذا يَسَّرَ اللَهُ الخُطوبَ فَكَم يَدٍ","وَإِن قَصُرَت تَجني مِنَ الصابِ تَمرَها",11,"ر",3,0],["إِذا ئلَجَأتُهُم ساعَةٌ مِن زَمانِهِم","إِلى الشَرِّ لَم يُغنوا فَتيلاً وَلَم يَنكوا",12,"ك",3,0],["إِذا يَدُنا لم تُذْكِ نارَ حياتنا","فلا تَرْجُ دِفئاً من وميضِ رعودِ",13,"د",1,0],["إذا يَدُنا لم تَحْمِ نَبْعَ حياتنا","سرى رِيُّهُ سمّاً بكلِّ وريدِ",13,"د",1,0],["إِذَا يَئِسَتْ نفْسُ امْرىء ٍ من قَرينة","ٍ تبدَّل أخرى مركباً بعد مركبِ",14,"ب",1,0],["إذا يُذكر الوردُ في مجلسٍ","مع الورد تسرد أخبارنُا",15,"ن",2,0],["إِذَا يَمَّمَتْهُ القاصِدُونَ تَيَسَّرَتْ","عليهمْ وإنْ لم يسألوكِ المقَاصدُ",16,"د",1,0]]}