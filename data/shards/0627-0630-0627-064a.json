{"poems":[[55,"بروم السيوف وغرب الرماح","https://www.aldiwan.net/poem30653.html","المتقارب"],[3,"تركت جرية العمري فيه","https://www.aldiwan.net/poem94.html",""],[24,"بانت سعاد فقلبي اليوم متبول","https://www.aldiwan.net/poem21877.html","البسيط"],[32,"يا دار مية بالخلصاء غيرها","https://www.aldiwan.net/poem29593.html","البسيط"],[58,"وليلة بات طل الغيث ينسجها","https://www.aldiwan.net/poem58473.html","البسيط"],[47,"يشكو إليك هواك المدنف الوصب","https://www.aldiwan.net/poem11494.html","البسيط"],[30,"كيف ببيت قريب منك مطلبه","https://www.aldiwan.net/poem5081.html","البسيط"],[60,"أمن تذكر دهر غير مأمون","https://www.aldiwan.net/poem30819.html","البسيط"],[68,"أذاب التبر في كأس اللجين","https://www.aldiwan.net/poem40114.html","الوافر"],[46,"خشنت عليه أخت بني خشين","https://www.aldiwan.net/poem30339.html","الوافر"],[52,"ألا قل لتلك المالكية أصحبي","https://www.aldiwan.net/poem64863.html","الطويل"],[48,"أتت جامع يوم العروبة جامعا","https://www.aldiwan.net/poem22610.html","الطويل"],[48,"لخالقنا الحكم القديم وكم فتى","https://www.aldiwan.net/poem23062.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39660","الطويل"],[52,"ألا قلْ لتلك المالكيَّة ِ أصحبي","https://www.poetsgate.com/ViewPoem.aspx?id=16887",""],[101,"سؤال","https://www.poetsgate.com/ViewPoem.aspx?id=7380",""],[69,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""],[128,"يا من تجشمه الألحاظ برح جوى","https://www.aldiwan.net/poem23788.html","البسيط"],[138,"أمن تذكر دهر غير مأمون","https://www.aldiwan.net/poem21043.html","البسيط"],[158,"قيود الأحرار","https://www.aldiwan.net/poem932.html",""],[173,"قم فاسقنيها قبل صوت الحمام","https://www.aldiwan.net/poem1679.html",""],[173,"على م وفي م ظلماً تلحياني","https://www.aldiwan.net/poem1688.html",""],[189,"عسى يبلى العذول ببعض ما بي","https://www.aldiwan.net/poem14126.html","الوافر"],[214,"أذائب التبر أبدى جوهر الحبب","https://www.aldiwan.net/poem13373.html","البسيط"],[260,"إذا يئس المرء من أيره","https://www.aldiwan.net/poem48322.html","المتقارب"],[286,"في عنفوان الصبا ما كنت بالغزل","https://www.aldiwan.net/poem32668.html","البسيط"],[302,"أما ينفك قلبك مستطارا","https://www.aldiwan.net/poem36826.html","عموديه"],[305,"جلبنا الخيل من جنبي أريك","https://www.aldiwan.net/poem2060.html","الوافر"],[335,"إني أتتني لسان ما أسر بها","https://www.aldiwan.net/poem518.html",""],[352,"إذا يئس المرء من أيره","https://www.aldiwan.net/poem20377.html","المتقارب"],[368,"يا مودع السر درا عند أجفاني","https://www.aldiwan.net/poem60635.html","البسيط"],[369,"ينادي من براقش أو معين","https://www.aldiwan.net/poem44493.html","الوافر"],[372,"ألا بان جيراني ولست بعائف","https://www.aldiwan.net/poem1874.html","الطويل"],[375,"يسرك سر بينهن ويحزن","https://www.aldiwan.net/poem57041.html","الطويل"],[375,"أنام وما لائمي","https://www.aldiwan.net/poem57105.html","مجزوء المتقارب"],[420,"وميض البرق هيج منك وجدا","https://www.aldiwan.net/poem54190.html","الوافر"],[443,"إذا شئت كان النجم عندك شاهدي","https://www.aldiwan.net/poem34811.html","الطويل"],[461,"أنا اليوم مما تعهدين بعيد","https://www.aldiwan.net/poem56239.html","البسيط"],[461,"تزِل الليالي مرة وتصيب","https://www.aldiwan.net/poem56290.html","الطويل"],[464,"هنيئا لأيام المناسك والتي","https://www.aldiwan.net/poem16025.html","الطويل"],[467,"هوى قمر العلياء يا ساري الجنح","https://www.aldiwan.net/poem3298.html","عموديه"],[517,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[818,"","https://poetry.dctabudhabi.ae/diwan/poem/20471","البسيط"],[845,"","https://poetry.dctabudhabi.ae/diwan/poem/21465","الطويل"],[1081,"","https://poetry.dctabudhabi.ae/diwan/poem/2522","الوافر"],[1104,"","https://poetry.dctabudhabi.ae/diwan/poem/20888","الهزج"],[1112,"","https://poetry.dctabudhabi.ae/diwan/poem/28239","الوافر"]],"verses":[["إِذا يابِسُ الماءِ بَلَّ الحِزامَ","طارَت بِهِ غُلواءُ المِراحِ",0,"ح",1,0],["إِذا يَقَعُ السِهامُ بِجانِبَيهِ","تَأَخَّرَ قابِعاً فيهِ صُدودُ",1,"د",1,0],["إذا يُساوِرُ قِرناً لا يَحِلُّ لَهُ","أَن يَترُكَ القِرنَ إِلّا وَهُوَ مَفلولُ",2,"ل",1,0],["إِذا يُعارِضُهُ وَعثٌ أَقامَ لَهُ","وَجهَ الظَعائِنِ خَلٌّ يَعسِفُ الضَفِرا",3,"ر",2,0],["إذا يُضَاحِكُ فيها الوَرْدُ نَرْجِسَها","باهى زَكِيَّ خُزَاماها بَنَفْسَجُها",4,"ج",3,0],["إِذا يُقالُ اِتَّئِب رَدَّت صَبابَتُهُ","إِلَيهِ ثابِتَ وَجدٍ لَيسَ يَتَّئِبُ",5,"ب",1,0],["إِذا يَثورونَ أَفواجاً كَأَنَّهُمُ","جَرادُ ريحٍ مِنَ الأَجداثِ مَنشورِ",6,"ر",1,0],["إِذا يَلطُمونَ وَلا يَخشَونَ مُقلَتَهُ","طَعناً دراكاً وَضَرباً غَيرَ مَأفونِ",7,"ن",1,0],["إِذا يَجلو الحَمِيّا وَالمُحَيّا","شَهِدنا الجَمعَ بَينَ النَيِّرَينِ",8,"ن",1,0],["إِذا يَدُهُ بِنائِلِهِ اِستَهَلَّت","فَوَيلٌ لِلنُضارِ وَلِلُّجَينِ",9,"ن",1,0],["إِذا يَئِسَت نَفسُ اِمرِىءٍ مِن قَريبَةٍ","تُبَدَّلَ أُخرى مَركَباً بَعدَ مَركَبِ",10,"ب",1,0],["إِذا يَسَّرَ اللَهُ الخُطوبَ فَكَم يَدٍ","وَإِن قَصُرَت تَجني مِنَ الصابِ تَمرَها",11,"ر",3,0],["إِذا ئلَجَأتُهُم ساعَةٌ مِن زَمانِهِم","إِلى الشَرِّ لَم يُغنوا فَتيلاً وَلَم يَنكوا",12,"ك",3,0],["إِذا يَدُنا لم تُذْكِ نارَ حياتنا","فلا تَرْجُ دِفئاً من وميضِ رعودِ",13,"د",1,0],["إذا يَدُنا لم تَحْمِ نَبْعَ حياتنا","سرى رِيُّهُ سمّاً بكلِّ وريدِ",13,"د",1,0],["إِذَا يَئِسَتْ نفْسُ امْرىء ٍ من قَرينة","ٍ تبدَّل أخرى مركباً بعد مركبِ",14,"ب",1,0],["إذا يُذكر الوردُ في مجلسٍ","مع الورد تسرد أخبارنُا",15,"ن",2,0],["إِذَا يَمَّمَتْهُ القاصِدُونَ تَيَسَّرَتْ","عليهمْ وإنْ لم يسألوكِ المقَاصدُ",16,"د",1,0],["إذ آية الظرف حرف في تنادمنا","يوحي إلى العزف أنواع الأغاريد",17,"د",1,0],["إِذا يَلطِمونَ وَلا يَخشَونَ مُقلَتَهُ","طَعناً دِراكاً وَضَرباً غَيرَ مَرهونِ",18,"ن",1,0],["إذا ينداح ضلعي نحو قلبي","يحز بنصلهِ قلبا فتيا",19,"ي",2,0],["إِذا يَمَسُّ الأَرضَ في جَريِهِ","خِيفَ عَلى راكِبِهِ الاِصطِلام",20,"م",1,0],["إِذا يَومي أَظَلَّ فَما أُبالي","بِسَيفٍ كانَ حَتفي أَو سِنانِ",21,"ن",1,0],["إذا يَممت حَيْدرةً لفضلٍ","فدُونَك ما تُريد بلا حجاب",22,"ب",1,0],["أذائب التبر أبدى جوهر الحبب","أم ريق مبسمه قد شيب بالشنب",23,"ب",1,1],["إِذا يئسَ المرءُ من أَيرِهِ","رأَت عِرْسُهُ اليأس من خيرهِ",24,"ه",1,1],["إِذا يَدٌ لَم تُفِد بِالرِّفدِ مُمتَدِحاً","مَعَ الغِنى فَرَماها اللَهُ بِالشَلَلِ",25,"ل",1,0],["إذا يعطو لها بالجيد دلّتْ","فتعطف تارةً وَتصدُّ تارا",26,"ر",2,0],["إِذا يَأسُونَها نَشَزَت عَلَيهِمْ","شَرَنبَثةُ الأَصابِع أُمُّ هَامِ",27,"م",1,0],["إذا يُعَادُ لها ذِكْرٌ أُكَذِّبُهُ","حتى أتَتْني بِهَا الأنْبَاءُ وَالخَبَرُ",28,"ر",1,0],["إذا يَئِسَ المَرْءُ من أَيرهِ","رَأَتْ عِرْسُهُ اليَأْسَ مِن غَيْرهِ",29,"ه",1,1],["إذا يَمينُ أميرِ المؤمنينَ غدا","وقد تسوَّرها فالفَخْرُ أغناني",30,"ن",2,0],["إِذا يَضحَكنَ أَو يَبسِمنَ يوماً","ترى بَرَداً أَلَحَّ به الصَّقيعُ",31,"ع",1,0],["إذا يَسرُوا لم يُورِثِ اليسر بَيْنَهُمْ","فَواحِشَ يُنعى ذِكْرُها بالمَصايِفِ",32,"ف",1,0],["إذا يَدُه طالَت إلى صَرفِ صَرفِه","أطالَت لِساني حيثُ تَقصرُ ألسُنُ",33,"ن",1,0],["إذا يَدُهُ عُلِّقَت","من النَّصلِ بالقائِمِ",34,"م",1,0],["إذا يمَّمته يَمَّمتُ يمناً","وإنْ طالعته طالعتُ سعدا",35,"د",2,0],["إِذَا يَمَّمَتْ منه حِمىً فكأَنَّما","أَرَبَّتْ عَلَيْهِ مُصْعِقاتُ الرَّواعِدِ",36,"د",1,0],["إذا يومُ عيدٍ زفّها قام ناصباً","لتجهيزِ أُخرى مثلِها لك عيدُ",37,"د",1,0],["إذا يَبِستْ أقلامُهُ أو تصامتتْ","فصارمُهُ رَطْبُ اللسانِ خَطيبُ",38,"ب",1,0],["اذا يمَّماها في الظَّلامِ تألَّقَتْ","بمُنْبلجٍ منْ واضحِ الشر لامعِ",39,"ع",1,0],["إذا يمنٌ حفَّت بقيسٍ تألقت","هناك مصابيح الطلاقةِ والنجح",40,"ح",1,0],["إذا يَدُه البيضاءُ أخرَجَها النّدى","فيا وَيلَ أمّ البيضِ والورقِ الصُّفْرِ",41,"ر",1,0],["إِذا يَجِفُّ ثَراها بَلَّها ديمٌ","مِن كَوكَبٍ نَزل بِالماءِ سَجّامِ",42,"م",1,0],["إِذا يَومُ نَحسٍ هَبَّ ريحاً كَسَونَهُ","ذُرى عَقداتٍ تُربهنَّ دَقيقُ",43,"ق",1,0],["إِذا يَمَّمنَ خَيلاً مُسرِعاتٍ","جَرى بِنُحوسِ طَيرِهُمُ الغُرابُ",44,"ب",1,0],["إذا يسرحُ ضأنا","مائة أتبعها ضانا",45,"ن",2,0],["إِذا يَجني عَلَيَّ بَذَلتُ نَصري","وَيَبذُلُ مِثلَ ذَلِكَ إِن جَنَيتُ",46,"ت",1,0]]}