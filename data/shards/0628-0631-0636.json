{"poems":[[53,"يوم كأن سماءه تحكي جفوني حين بنتا","https://www.aldiwan.net/poem8684.html","مجزوء الكامل"],[53,"برضاب ثغرك يستغيث","https://www.aldiwan.net/poem9236.html","مجزوء الكامل"],[53,"زعموا أنك يا خالد","https://www.aldiwan.net/poem63017.html","مجزوء الرمل"],[80,"يا أيها الملك الذي","https://www.aldiwan.net/poem14067.html","مجزوء الكامل"],[71,"شاعر باهر بديع المعاني","https://www.aldiwan.net/poem28319.html","الخفيف"],[71,"ومليح إذا النحاة رأوه","https://www.aldiwan.net/poem29104.html","الخفيف"],[52,"فتن المرعث بعد طول تصاح","https://www.aldiwan.net/poem63971.html","البسيط"],[80,"يا أَيُّها المَلِك الَّذي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86540&r=&rc=85",""],[164,"هكذا فلتكن إلى الغلمان","https://www.aldiwan.net/poem58854.html","الخفيف"],[438,"عزمي وحزمي والحسام الماضي","https://www.aldiwan.net/poem12440.html","مشطور الرجز"],[443,"أين الديار فهذه الجرعاء","https://www.aldiwan.net/poem2589.html","الكامل"],[563,"يا رب عبد قد بسط","https://www.aldiwan.net/poem34410.html","مجزوء الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122780","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56081","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80043","الخفيف"],[1754,"","https://poetry.dctabudhabi.ae/diwan/poem/107349","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93554","الخفيف"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112660","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89270","الوافر"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78373","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90921","الكامل"],[4816,"نيست","https://www.poetsgate.com/ViewPoem.aspx?id=8485",""],[4935,"خل عنك الهزل خلي والكسل","https://www.poetsgate.com/ViewPoem.aspx?id=129317",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5189,"آجال وعمر","https://www.poetsgate.com/ViewPoem.aspx?id=198419",""],[5612,"{ صَنْصَفْطُ } سَيِّدَةُ القُرَى","https://www.poetsgate.com/ViewPoem.aspx?id=183746",""],[6008,"مهداه إلى الإمير نواف بن فواز الشعلان","https://www.poetsgate.com/ViewPoem.aspx?id=60802",""],[6008,"يراعي الجمس","https://www.poetsgate.com/ViewPoem.aspx?id=60994",""]],"verses":[["بِرِضاً يعيشُ ببَرْدِهِ","قلبٌ بسُخطك قد أَمَتَّا",0,"ت",2,0],["برضابِ ثغرك يستغي","ثُ متيّمٌ بك إن أغثْتَهْ",1,"ه",1,1],["برضىً منك وأنت ال","مرء يرضى بالصّغار",2,"ر",1,0],["بِرضاكَ أُبصِرُ نائيَ ال","آلام مِنّي ذا اِقتِرابْ",3,"ب",1,0],["برضابٍ عنِ المبرِّدِ يروي","ونهودٍ تروي عنِ الرمّانِ",4,"ن",1,0],["برضابٍ عن المبرِّد يروي","ونهودٍ تَروي عن الرماني",5,"ي",1,0],["بِرُضابِ ذي أَشَرٍ أَغَرَّ كَأَنَّما","غُبِقَت مَشارِبُهُ مِنَ التُفّاحِ",6,"ح",1,0],["بِرضاكَ أُبصِرُ نائيَ ال","آمالِ مِنّي ذا اِقتِرابْ",7,"ب",1,0],["برضى عنك من إله تعالى","وبعفو الذنوب والغفرانِ",8,"ن",1,0],["برْضٌ أبَتْهُ همّةُ البرّاضِ","فواصَلا الطِّوالَ بالعِراضِ",9,"ض",1,0],["برضاك ألبست الغزالة نورها","وبسخطك انسدلت لنا الظلماء",10,"ا",2,0],["برضاك أدفع للسخط","وكثير ذنبي ما انضبط",11,"ط",1,0],["بِرَضابَةِ الصَّعبِ الجَمُوحِ وَقُوّةِِ","الدِّرعِ الضَّعيفِ وَنُصرَةِ المَظلُومِ",12,"م",1,0],["برضاه ودّ الموت لكن روحه","عند الشهادة للمهيمن سلّما",13,"م",2,0],["برضاها النقيِّ وابن أبيه","مصطفاها يدعو وردتُ سفيرا",14,"ر",2,0],["برضاه قد مات فوق صليب","لينتجي الأنام طرّا ويفدي",15,"د",2,0],["برضاب عَذب المَذاق وَلَكن","قَد حمته مِن الجُفون الرماة",16,"ه",1,0],["بِرَض ضِلع فاطمَ البتولِ","رُضّت ضلوعُ السبط والخيولِ",17,"ل",1,0],["برضوان الإله خَلفتَ مالكْ","فما للغير يا أفتا ومالكْ",18,"ك",1,1],["بِرِضابه ماء الحَياة","يَحيى الرَميم مَع الرفات",19,"ت",1,1],["برضى واسماعيل دمت مهنئا","ومؤيدا بهما تغيظ الحسدا",20,"د",2,0],["برض جفر ونبع المواريد يبسا","ما عاد ارجع لو اصواتك تعالت",21,"ت",1,0],["برضا المولى الذي فقهنا","أمر دين طاهر خالي الزغل",22,"ل",1,0],["برضوان بالحور الحسان بجنة","النعيم بما أعددت فيها من النعمى",23,"م",2,0],["برضوانٍ وعفوٍ قد تسامى","بوجهٍ ناضرٍ كالمؤمنينَ",24,"ن",1,0],["برضاكِ يَهْنَأُ إنْ تَوَضَّأَ للصَّلا","وإذا تَشَيْطَنَ بالعَصا يَتَأدَّبُ",25,"ب",1,0],["برضاك يا المعبود في كل ميقاف","اطلبك نفسي بالايمان تعمرها",26,"ر",3,0],["برض ٍ خلا ماعنده أحد ً يصلح","يابي مهندس بين فك ٍ وتركيب",27,"ب",1,0]]}