{"poems":[[53,"وقتك يد الإله أبا علي","https://www.aldiwan.net/poem8297.html","الوافر"],[53,"وحديثها السحر الحلال لو انها","https://www.aldiwan.net/poem64552.html","الكامل"],[53,"هنيئا يا أبا حسن هنيئا","https://www.aldiwan.net/poem66738.html","الوافر"],[87,"نبذ الهوى وصحا من الأحلام","https://www.aldiwan.net/poem8104.html","الكامل"],[47,"عزمت على المنازل أن تبينا","https://www.aldiwan.net/poem66674.html","الوافر"],[68,"فوالله ما فرقت ما جدت لي به","https://www.aldiwan.net/poem38693.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54897","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[47,"وحديثها السحر الحلال لو أنه","https://www.poetsgate.com/ViewPoem.aspx?id=31168",""],[154,"يهن الجزيرة منك أي حسام","https://www.aldiwan.net/poem68464.html","الكامل"],[292,"أصرمت حبل الوصل من فتر","https://www.aldiwan.net/poem1918.html","أحذ الكامل"],[438,"يا بن عدلان يا أخس الرجال","https://www.aldiwan.net/poem12457.html","الخفيف"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216894","الخفيف"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96552","الوافر"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126152","الرجز"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122859","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64415","الخفيف"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87867","البسيط"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105866","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66306","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109383","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93651","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109972","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91435","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95320","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44699","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91046","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72482","الكامل"],[4579,"","https://poetry.dctabudhabi.ae/diwan/poem/205461","الكامل"],[5186,"طاب يا نشء في نهاك الثناء","https://www.poetsgate.com/ViewPoem.aspx?id=156455",""],[5321,"شَرَّك غَدَى","https://www.poetsgate.com/ViewPoem.aspx?id=152742",""],[5528,"من مثل أحمد..؟ ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=200986",""],[5786,"يا بارقاً لاحَ من أكتاف كوفانِ","https://www.poetsgate.com/ViewPoem.aspx?id=50655",""],[6318,"فلق الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66162&r=&rc=12",""]],"verses":[["شَرِكتك في البلاء المرِّ حتى","لكاد القلب من ألمٍ يذوبُ",0,"ب",1,0],["شرك النفوس وفتنة ما مثلُها","للمطمئن وعُقْلة المستوفِز",1,"ز",1,0],["شركتَ القِردَ في سُخْفٍ وقبح","وما قصَّرْتَ عنه في الحكايهْ",2,"ا",3,0],["شَرِكاتُكَ الدُنيا العَريضَةُ لَم تُنَل","إِلّا بِطولِ رِعايَةٍ وَقِيامِ",3,"م",1,0],["شَرَكنا العيسَ ما نَدَعُ التَصابي","لِواحِدَةٍ وَما تَدَعُ الحَنينا",4,"ن",2,0],["شَرِكتُ جَميعَ الصَحبِ فيها لَعَلَّها","تُساعِدُ في شُكرٍ يَقومُ بِهِ عُذري",5,"ر",2,0],["شَرِكَاتٌ مَصْرِيَّةٌ أَلِفَتْهَا","نهْضَةٌ تَمْلأُ الجوَانِحَ بُشْرَا",6,"ر",2,0],["شركسيٌّ أعيا على العُرْبِ مَأْتا","هُ فَحسّانُ ليس بالْحسّان",7,"ن",1,0],["شرك النفوس منزهة ما مثلها","للمطمئن وعقله المستوفز",8,"ز",1,0],["شرك البرية في وظائف برها","وله مزية ذابل وحسام",9,"م",1,0],["شِركاً بِماءِ الذَوبِ يَجمَعُهُ","في طَودِ أَيمَنَ في قُرى قَسرِ",10,"ر",1,0],["شِركةٌ في النساءِ كالشِّرك بالل","هِ لقد بُؤتَ خاسراً بالضّلالِ",11,"ل",1,0],["شرّكمْ حاضرٌ وخيركمْ درّ","كمْ خروسٍ من الأرانبِ بكرِ",12,"ر",1,0],["شَرِكتُكَ في هوى مَن كانَ حظى","وحظُّك من مودتها العذابُ",13,"ب",1,0],["شركه المشاركة","وكثرة المداركة",14,"ه",1,0],["شركتك من كل الجهات بحسنها","وضيائها وصلاحها وفسادها",15,"د",3,0],["شرك النفس لا يغيب عن العق","ل فكيف الوقوع في الأصفاد",16,"د",1,0],["شِركٌ بوصلٍ لمن أَصفاك نيَّتَهُ","وما لإِنسٍ على الحيوان من شرفٍ",17,"ف",1,0],["شرِك البنفسج في الاديم فَلَونُهُ","مِن لَونه فكأنّهُ منه اختُلس",18,"س",1,0],["شرك جحود ولائه","وهل السليم سوى النهيش",19,"ش",1,0],["شركَ الجفن لصيدي نَصبا","رشأ لورث قلبي نصبا",20,"ب",2,1],["شرك الصبا قَد كانَ فيكَ يَفيدني","بلقا المَها فَأصيدها وَتصيدني",21,"ي",1,0],["شرُّكم قد نَمَّ في نَجدٍ وواد","عمَّ اهلَ البدوِ ايضاً والحَضَر",22,"ر",1,0],["شُرْكُ العذارِ بِهِ وَحَبتُّهُ الَّتي","لَولا لياليهنّ ما أَغراني",23,"ن",2,0],["شرك لا تفلت الألباب منه","حفظته روضةٌ تسبي العيون",24,"ن",1,0],["شرَكُ القلوبِ ولم أَخل من قبلها","أنّ القلوبَ تصيدها الأشراكُ",25,"ك",1,0],["شَرَكٌ إِلى صَيدِ الملاحِ جَعَلتَهُ","بِطَريقةِ التَشبيبِ أَو بِتَغزُّلِ",26,"ل",1,0],["شركاء مكر لم تزل أشراكهم","تصطاد من أوكارها الأطيارا",27,"ر",2,0],["شرك كثيف أنت في حبلاته","قيد الحياة أسير قيد مثقل",28,"ل",1,0],["شركوا العدا في أمرهم فتفاقمت","منها الفتون وفرقت أهواؤها",29,"ا",3,0],["شركات وأسهم بل شراك","وسهام قدت بها الأحشاء",30,"ا",2,0],["شَرَّك غَدَى واستبشرت فيك الأوطان","ياضيَّها اللّي دون باسه هدبها",31,"ب",3,1],["شَرَّك غدى ياسيّد الجود وإحسان","من كان مثلك فالشّدايد غلبها",31,"ب",3,0],["شِرْكُ يُوَجِّهُ بينَهُمْ أجْنادَهُ","مُتنَمِّرًا بَلْهَ الفَتَى المُتَحَنِّفا",32,"ف",2,0],["شركي الودادُ وأهوى من يدومُ على","حفظ الوفاء وأشنا كلّ خوَانِ",33,"ن",1,0],["شَرَكُ المُسَاومَة التي تَرْجينها","شَرَكُ يَمُدُّ إِليك نَابَ الأرْقم",34,"م",1,0]]}