[45,"لأخي الحب عبرة ما تجف","https://www.aldiwan.net/poem65151.html","الخفيف"],[45,"ضمان على عينيك أني لا أسلو","https://www.aldiwan.net/poem65536.html","الطويل"],[45,"على الحي سرنا عنهم وأقاموا","https://www.aldiwan.net/poem65687.html","الطويل"],[45,"هذي المعاهد من سعاد فسلم","https://www.aldiwan.net/poem66637.html","البسيط"],[61,"أهجرا كان صدك أم ملالا","https://www.aldiwan.net/poem51492.html","الوافر"],[61,"أتكتم أسرار الهوى أم تذيعها","https://www.aldiwan.net/poem51571.html","الطويل"],[61,"وأزهر وضاح يروق عيوننا","https://www.aldiwan.net/poem51626.html","الخفيف"],[66,"يسائلني صديقي عن كتاب","https://www.aldiwan.net/poem38543.html","الوافر"],[97,"أحب أجل أحب كأن نبعا","https://www.aldiwan.net/poem24913.html","الوافر"],[87,"عم الحيا واستنت الجداول","https://www.aldiwan.net/poem8367.html","الرجز"],[105,"في حمى الحق ومن حول الحرم","https://www.aldiwan.net/poem42091.html","الرمل"],[105,"بلغ الدنى فألم غير مسلم","https://www.aldiwan.net/poem43112.html","الكامل"],[105,"ثقيف انظري أين قصد الطريق","https://www.aldiwan.net/poem44033.html","المتقارب"],[39,"قفا فاسألا الدمنة الماصحه","https://www.aldiwan.net/poem53809.html","المتقارب"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"ذو يراع يروع كالسيف إما","https://www.aldiwan.net/poem18069.html","الخفيف"],[67,"ليت شعري ما مقتضى حرماني","https://www.aldiwan.net/poem18113.html","الخفيف"],[75,"قد سار بي هذا الزمان فأوجفا","https://www.aldiwan.net/poem69062.html","الكامل"],[48,"قام الأمين بأمر الله في البشر","https://www.aldiwan.net/poem63359.html","الطويل"],[48,"سأركب ما استطعت من الحرام","https://www.aldiwan.net/poem66280.html","الوافر"],[50,"وهبت لنا يا فتى منقر","https://www.aldiwan.net/poem62288.html","المتقارب"],[46,"غدوت مريض العقل والدين فالقني","https://www.aldiwan.net/poem22294.html","الطويل"],[46,"أم دفر جزيت شرا فديا","https://www.aldiwan.net/poem22852.html","الخفيف"],[19,"أيتها النفس أجملي جزعا","https://www.aldiwan.net/poem347.html",""],[19,"لليلى بأعلى ذي معارك منزلُ","https://www.aldiwan.net/poem358.html",""],[8,"هل بالديار الغداة من صمم","https://www.aldiwan.net/poem21838.html","المنسرح"],[76,"وأزهر كالعيوق يسعى بزهراء","https://www.aldiwan.net/poem39507.html","الطويل"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/44414","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39557","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39547","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42611","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54727","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54820","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142052","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141966","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54262","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[106,"يا أخت عموريْة!","https://www.poetsgate.com/ViewPoem.aspx?id=179607",""],[77,"عهد الشباب سقى أيامك الأولا","https://www.poetsgate.com/ViewPoem.aspx?id=34202",""],[67,"لَيْتَ شِعْرِي ما مُقْتَضَى حِرْماني","https://www.poetsgate.com/ViewPoem.aspx?id=14581",""],[27,"وأَقبَّ كالسِّرحان تم له","https://www.poetsgate.com/ViewPoem.aspx?id=180957",""],[90,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[34,"لَقَدْ خِفْتُ ألاّ تَقْنَعَ النَّفْسُ بَعْدَها","https://www.poetsgate.com/ViewPoem.aspx?id=22469",""],[45,"نحنُ الفِداءُ، فمَأخُوذٌ وَمُرْتَقَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=31563",""],[45,"يا أخَا الأزْدِ ما حَفِظتَ الإخَاءَ","https://www.poetsgate.com/ViewPoem.aspx?id=32957",""],[91,"كتابي","https://www.poetsgate.com/ViewPoem.aspx?id=53230",""],[99,"التمثيلية","https://www.poetsgate.com/ViewPoem.aspx?id=36365",""],[51,"يا كريماً لم يزل محتمِلا","https://www.poetsgate.com/ViewPoem.aspx?id=30692",""],[51,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[78,"الملكُ في طيّ الدَفاتِرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86599&r=&rc=105",""],[99,"التمثيلية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67013&r=&rc=146",""],[76,"وأزهرَ كالعيُّوقِ بزهراءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17865&r=&rc=2",""]],"verses":[["وَأَزرَقِ ماءٍ كَلَونِ الزُجا","جِ بِالرَملِ جُمَّتُهُ طامِيَه",0,"ي",2,0],["وَأَزعَجتُ القَطا الوَسنا","نَ بِالمَخطومَةِ الرُسُمِ",1,"م",1,0],["وَأَزورُ أَطرافَ الثُغورِ وَدونَها","طَعنٌ يُبَرِّحُ بِالوَشيجِ الذُبَّلِ",2,"ل",1,0],["وَأُزيحَ ذاكَ الأُنسُ أَجمَعُهُ","وَأُميطَ ذاكَ البِرُّ وَاللَطَفُ",3,"ف",1,0],["وَاِزدَد بَقاءً وَعُلىً","ما بَعدَ وِردَيكَ صَدَر",4,"ر",1,0],["وَأَزرَقِ ماءٍ قَد سَلَبتُ جُمامَهُ","يَعومُ الَشَوى في غَمرِهِ وَيَغيبُ",5,"ب",1,0],["وَأَزْحَفُ بِالجيادِ إِلى مَكَرٍّ","بِهِ الأبْطالُ دامِيَةُ الأَشِلَّهْ",6,"ل",2,0],["وأزْهى على الأيّامِ وهْيَ تَروعُني","وأنْيابُها لا ريعَ جارُكَ رُوقُ",7,"ق",1,0],["وأزارَها ابْنَ الدّارِميِّ أبا الندىً ال","إكْرامُ والتّعْظيمُ والتّبْجيلُ",8,"ل",1,0],["وأزْجُرُ منْ نَزائِعِها رَعيلاً","إذا وَقَذَ الوَجى منها رَعيلا",9,"ل",2,0],["وأزورُ إذْ ظَعَنَ الخَليطُ مَنازِلاً","نَحِلَتْ بِهِنَّ كما نَحِلْتُ الأرْسُمُ",10,"م",1,0],["وَأَزيدُها مِن نارِ حَربي شُعلَةً","وَأُثيرُها حَتّى تَدورَ رَحاها",11,"ا",3,0],["وَأَزجُرُ عَنها النَفسَ إِذ حيلَ دونَها","وَتَأبى إِلَيها النَفسُ إِلّا تَطَلُّعا",12,"ع",2,0],["وازْلِفْ بصَوْمٍ حَبَيْتَ الذِّكْرَ وافِدَهُ","قِرىً وأخْلَصْتَ فيهِ القوْلَ والعَمَلا",13,"ل",2,0],["وَأَزْعَجَنِي مِنْ مَنْشَأي وَمُبَوَّأي","وَمَعْهَدِ أَحْبَابِي وَمَأْلَفِ جِيرَانِي",14,"ي",1,0],["وَازِنْ بِهِ مُؤَنَ السِّيَاسَةِ وادَّخِرْ","فَضْلاً وَوَازِ بِخَرْجِهِ مَا يدْخُلُ",15,"ل",1,0],["وَأَزْمَعَ عَنْكَ الشَّهْرُ لاَ عَنْ مَلاَلَةٍ","فَقَدْ كَمُلَتْ بِالْبِرِّ مِنْهُ الْمَآرِبُ",16,"ب",1,0],["وأزْهَر فضْفاضِ الرِّداءِ إذا احْتَبى","بسُدّةِ نادٍ أو قَرارَةِ مجْلِسِ",17,"س",1,0],["وَأَزِل شُكوكاً بِالنُفو","سِ تَعَلَّقَت مُنذُ البِدايَه",18,"ا",3,0],["وَأَزهَرَ في طِرسي يَراعي وَأَنمُلي","وَلَفظي فَباتَ الطِرسُ يَجني وَيَقطِفُ",19,"ف",1,0],["وأزرق اللون كلون السما","فيه لمن ينظر سر عجيب",20,"ب",1,1],["وَازْدَدْ فَخَاراً بِهَا","يَزْدَدْ فَخَارُ الأَدَبْ",21,"ب",1,0],["وَازْدَرَدُوا مَا ازْدَرَدُوا","مِنْ أَكَلاتٍ مُشْبَعَهْ",22,"ع",2,0],["وَازَّيَنَتْ أَرْضٌ وَفَوَّفَ سَنْدُسٌ","تَمْشِي عَلَى دِيبَاجِهِ الأَقْدَامُ",23,"م",1,0],["وَازْدَادَتِ الإِسْكَنْدَرِيَّةُ بَهْجَةً","إِذْ لاحَ فِيهَا وَجْهُكَ البَسَّامُ",23,"م",1,0],["وَأَزوَرَ يَمطو في بِلادٍ عَريضَةٍ","تَعاوى بِهِ ذُؤبانُهُ وَثَعالِبُه",24,"ب",2,0],["وأَزدُ شَنُوءَةَ ابذَرَعُو إلَينَا","بِجُمٍّ يَحسِبُونَ لَهَا قُرُونَا",25,"ن",2,0],["وأزعجني شيبٌ بفودَيّ طالعٌ","وما كان وقعُ الشيب لي عنهُ مزعجا",26,"ج",2,0],["وأزرقُ العين يمضي حدّ مقلته","مثل السنان بقلبِ العاشق الحذِر",27,"ر",1,1],["وأزهر وضَّاح الصفات عليّها","مدحت به المدح الذي أنا قائله",28,"ل",2,1],["وازداد تحسيناً يخالف قول من","قد قال إن النقص في الترخيم",29,"م",1,0],["وازرع زروعاً ترتضي ريعها","يوماً فكلٌّ حاصدٌ زرعه",30,"ع",2,0],["وازَت عُراها ملوك مِلَّتنا","فكنتمُ ثمَّ من وثائقها",31,"ق",3,0],["وازدحَمَ الوِردُ عليه واعتركْ","واعتبطَ الشرُّ عليه وابتركْ",32,"ك",1,0],["وازجُرِ النفسَ إذا ما حَرنَتْ","أن يفوتَ القوم سبقاً من حرن",33,"ن",1,0],["وَأُزهى إِذا أَطعَمتُ جَوعانَ لُقمَةً","كَأَنّي خَلَقتُ الحَبَّ في الحَقلِ وَالحَقلا",34,"ل",2,0],["وَاِزرَع نُجومَ الشَيبِ في لِمَّتي","فَيَنجَلي حِندِسٌ أَوهامي",35,"ي",1,0],["وَأَزهَرَ سَخّى نَفسَهُ عَن تِلادِهِ","حَنايا حَديدٍ مُقفِلٍ وَسَوارِقُه",36,"ق",2,0],["وَازجُر جفونك لا تَرضَ البُكاءَ لَها","وَاِصبر فَقَد كُنتَ الخطب تَصطَبِرُ",37,"ر",1,0],["واِزحَفْ إِلى جَيش المَعا","رِف تَقهَر الحِبرَ المُقامِرْ",38,"ر",1,0],["وأزلف الوفد إلى ربهم","وظلل السدّة واظّلل",39,"ل",1,0],["وَاِزهَدوا في الطَيرِ إِنَّ ال","عَيشَ عَيشُ الزاهِدينا",40,"ن",2,0],["وَاِزهَدي في مَوكِبٍ لَو شِئتِهِ","لَتَغَطّى وَجهُها بِالدارِعين",41,"ن",1,0],["وَأُزيلَ هَيكَلُها المَصونُ وَسِرُّهُ","وَالدَهرُ لِلسِرِّ المَصونِ مُذيلُ",42,"ل",1,0],["وَأُزيلَ مِن حُسنِ الوُجوهِ وَعِزِّها","ماكانَ يُعبَدُ مِن وَراءِ سِجافِ",43,"ف",1,0],["وَاِزدَدتِ مِن حُسنِ الثَناءِ وَطيبِهِ","حَجَراً هُوَ الدُرِيُّ في الأَمداحِ",44,"ح",1,0],["وَاِزَّيَّنَت أُمَّهاتُ الشَرقِ وَاِستَبَقَت","مَهارِجُ الفَتحِ في المُؤشِيَّةِ القُشُبِ",45,"ب",1,0],["وَاِزدَهى الكَونُ بِالوَليدِ وَضاءَت","بِسَناهُ مِنَ الثَرى الأَرجاءُ",46,"ا",2,0],["وَأَزَرتَ الخُيولَ قَبرَ امرِئِ القَي","سِ سِراعاً فَعُدنَ مِنهُ بِطاءَ",47,"ا",2,0],["وَأَزرَقُ الفَجرِ يَأتي قَبلَ أَبيَضِهِ","وَأَوَّلُ الغَيثِ قَطرٌ ثُمَّ يَنسَكِبُ",48,"ب",1,0],["وَإِزائي مَطالِبٌ لَو تُواتي","نِيَ نَفسٌ عَن مِثلِهِنَّ تَعِفُّ",49,"ف",1,0],["وَأَزعَجَ أَهلَ المَحلَبِيّاتِ ناجِزٌ","مِنَ الحَربِ ما فيهِ خِداعٌ وَلا هَزلُ",50,"ل",1,0],["وَأَزهَرَ وَضّاحِ العَشِيّاتِ لا يَني","مِنَ البِشرِ يَنأى عَن ذَراهُ قَتامُ",51,"م",1,0],["وَأَزارَ أَرضَ الرومِ أَطرافَ الظُبا","حَتّى أَقامَ مُلوكَها في المَقسَمِ",52,"م",1,0],["وأزرقَ كالشِّهابِ إذا حَناه","دِراكُ الطَّعنِ غادَرَه هِلالا",53,"ل",2,0],["وأزهرَ يَنقادُ الزَّمانُ لأمرِهِ","وتأمُرُهُ زُهْرُ العُلى فيُطيعُها",54,"ع",3,0],["وأزهرَ وَضَّاحٍ يَروقُ عيونَنا","إذا ما رَميناه بِلَحْظِ النَّواظِرِ",55,"ر",1,1],["وَأَزعُمُ أَنَّهُ خَطٌّ سَقيمٌ","وَطِرسٌ دارِسٌ كَالشِنَّ بالي",56,"ي",1,0],["وأزهى من تثنَّى في حُلِيٍّ","وأبهج من تَهادى في رداء",57,"ا",2,0],["وَازَّيَّنَتْ بِنَوْرِهَا الْخَمَائِلُ","وَغَرَّدَتْ فِي أَيْكِهَا الْبَلابِلُ",58,"ل",1,0],["وأزالوا ما حَوَتْ أرجاؤُه","للأوالي من قُبورٍ ورِمَمْ",59,"م",1,0],["وَاِزوَرَّ يَلتَمِسُ النَجاةَ فَعاقَهُ","قَدَرٌ أَحاطَ بِهِ وَلَمّا يَعلَمِ",60,"م",1,0],["وأزلفْتَها توبةً تبتغي","بها الخيرَ والخيرُ نِعْمَ الرفيقْ",61,"ق",1,0],["وَأَزعَجَهُنَّ اِهتَزامُ الحُداة","كَجَلجَلَةِ القَينَةِ الصادِحَه",62,"ح",2,0],["وَأَزالَت بِلَمْسِهَا كلَّ دَاءٍ","أكْبَرَتْهُ أطِبَّةٌ وَإِسَاءُ",63,"ا",2,0],["وَازْدَرَتنِي بعضُ الوُلاةِ وقدْ أَص","بَحَ شِعْرِي فيهمْ كَخُبْزِ الشَّعِيرِ",64,"ر",1,0],["وأُزِيلَتْ بالسَّبِّ أعْراضُ","مَنْ فيها فما قامَ الرِّبْحُ بالخُسرانِ",65,"ن",1,0],["وازدَرْتَ قبرَ أبيكَ قبرَ محمّدٍ","بملائكِ اللّهِ العُلى متكنَّفا",66,"ف",2,0],["وَاِزدادَتِ الأَرضُ لَمّا ساسَها سَعَةً","حَتّى تَضاعَفَ نورُ الشَمسِ وَالقَمَرِ",67,"ر",1,0],["وأزين من هوى بازٍ وصقرٍ","ولعب بالديوكِ وبالحمام",68,"م",1,0],["وَأَزهَدَ مِن جيفَةٍ لَم تَدَع","لَها الشَمسُ مِن مَفصَلٍ مَفصَلا",69,"ل",2,0],["وَأَزهَدُ في مَدحِ الفَتى عِندَ صِدقِهِ","فَكَيفَ قُبولي كاذِباتِ المَدائِحِ",70,"ح",1,0],["وَأَزورُ الجِنانَ أُحبَرُ فيها","بَعدَ طولِ الهُمودِ في الأَرماسِ",71,"س",1,0],["وَاِزدَحَمَت حَلقَتا البِطانِ بِأَق","وامٍ وَطارَت نُفوسُهُم جَزَعا",72,"ع",2,0],["وَأَزعَجَهُ أَن قيلَ شَتّانَ ما تَرى","إِلَيكَ وَعودٌ مِن سَراءٍ مُعَطَّلُ",73,"ل",1,0],["وَأَزجُرُ الكاشِحَ العَدُوَّ إِذا","اِغتابَكَ زَجراً مِنّي عَلى أَضَمِ",74,"م",1,0],["وَأَزْهَرَ كالعَيُّوقِ يَسعَى بِزهْرَاءِ","لَنَا مِنْهُما دَاءٌ وَبرْءٌ مِنَ الدَّاءِ",75,"ا",2,1],["وَازجُر جفونك لا تَرضَ البُكاءَ لَها","وَاِصبر فَقَد كُنتَ عند الخطب تَصطَبِرُ",76,"ر",1,0],["وأزاهيرُ حانياتٌ على النهر","يُقَبلنَ في الضحى شُطآنه",77,"ن",2,0],["وأزوريسُ على الشطِّ الظليلْ","يَعْصُرُ الخمرَ ويسقِي السلسبيلْ",78,"ل",1,0],["وأزاهيرَ حوله ذابلاتٍ","مزَّقتها الرِّياحُ في الليلِ شملا",79,"ل",2,0],["وأزهدُ الناس وفي الدنيا يدُه","وأخشع العالم وهو سيده",80,"ه",1,0],["وَازْوَرَّ حَاجِبُهَا عَنْ نَظْرَةٍ رَشَقَتْ","سَوَادَ قَلْبِي بِسَهْمٍ صِيغَ مِنْ حَوَرِ",81,"ر",1,0],["وَازَّينَتْ بِكِ بَعْدَ أَنْ خَلَّفْتِهَا","وَكَأَنَّ زُخْرُفَهَا عَلَيْه رَمَاد",82,"د",1,0],["وَأَزْكَى الْعَوَارِفِ بِيضُ الأَيَا","دِي تَجُودُ بِهِنَّ ذَوَاتُ الْخَفَرْ",83,"ر",1,0],["وَأَزْهدَتْنِي فِي المَدِيحِ","وَالأَبَاطِيلِ الأُخَرْ",84,"ر",1,0],["وأزاح النسيم عن صدرها الثوب","فلاحا ولا تقل نهداها",85,"ا",3,0],["وازرقاق كأنهُ حين زار","الأفق أهدى إليه منهُ إزارا",86,"ر",2,0],["وأزْلفها ملءَ النواظِرِ جَنَّةً","تميد بها الأغصانُ وهي رِطاب",87,"ب",1,0],["وأزاح التاريخُ عن عَيْنِهِ الحُجْبَ","فَمَرَّتْ تخوض في الأجيال",88,"ل",1,0],["وَأَزَاهِيرُ كُنَّ تَاجَ عَرُوسٍ","عُفِّرَتْ بَعدَ لَيْلةٍ في التُّرابِ",89,"ب",1,0],["وأزيزَ أسرابٍ تَصبُّ شُواظَها","فوق الحصون، فتستحيلُ طلُولا",90,"ل",2,0],["وازلف بصوم حييت الذكر وافده","قرى وأخلصت فيه القول والعملا",91,"ل",2,0],["وأزيلتْ بالسَّبِّ أعراضُ من في","فما قامَ الرِّبْحُ بالخُسْرانِ",92,"ن",1,0],["وأزدان بالديكين صَلْصلهُ","ونبت دجاجته عن الصدر",93,"ر",1,0],["وأزاحني عن عالَمٍ قَذِرٍ","نَحْسٌ لآخرَ زاهرٍ نَضِر",94,"ر",1,0],["وازجر عنها النَّفس إِذا حيلَ دُونَها","وَتَأْبَى إليها النَّفْسُ إلاّ تطَلُّعا",95,"ع",2,0],["وأزْرَقُ الفَجْرِ يَأتي قَبلَ أبيَضِهِ،","وَأوّلُ الغَيثِ مطرٌّ، ثمّ يَنسَكِبُ",96,"ب",1,0],["وأزَرْتَ الخُيول قَبرَ امرِىءِ القَيْ","سِ سِرَاعاً، فعُدْنَ منهُ بِطَاءَ",97,"ا",2,0],["وأزهى إذا أطمعت جوعان لقمة","كأني خلقت الحبّ والحقل والحقلا",98,"ل",2,0],["وأزعم أن لا شيء يجمع بينا","لأبعد عن نفسي وعنك المتاعبا",99,"ب",2,0],["وازجُرِ النفسَ إذا ما حَزُنَتْ","أن يفوتَ القوم سبقاً من حزن",100,"ن",1,0],["وازجُرْ عن الجَهلِ ولا تُجاهل","وادعُ إلى الخيرِ ولا تُقاتل",101,"ل",1,0],["واِزحَفْ إِلى جَيش المَعا","رِف تَقهَرِ الحِبرَ المُغَامِرْ",102,"ر",1,0],["وأزعم أن لا شيء يجمع بيننا","لأبعد عن نفسي وعنك المتاعبا",103,"ب",2,0],["وأزهرَ كالعيُّوقِ بزهراءِ","لَنَا مِنْهُما دَاءٌ وَبرْءٌ مِنَ الدَّاءِ",104,"ا",2,1]]}