شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[556,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[556,"حباك الله بالنعما لتشكر","https://www.aldiwan.net/poem34280.html","الوافر"],[559,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[560,"وقفت مدحي فلا يطمع به أحد","https://www.aldiwan.net/poem52857.html","البسيط"],[565,"نفسي الفداء لمن إذا جرح الأسى","https://www.aldiwan.net/poem69820.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"يا ثالث العمرين علماً","https://www.aldiwan.net/poem3011.html","مجزوء الكامل"],[584,"يا حبذا نهر القصير ومغربا","https://www.aldiwan.net/poem17431.html","الكامل"],[585,"لقد كسفت شمس العلا والمفاخر","https://www.aldiwan.net/poem11500.html","عموديه"],[585,"ألا أيها الغادي مجداً بنجداً","https://www.aldiwan.net/poem11509.html","عموديه"],[585,"أمور القضا ليست بحكم العوالم","https://www.aldiwan.net/poem11521.html","عموديه"]],"verses":[["وَأَزرَقِ ماءٍ كَلَونِ الزُجا","جِ بِالرَملِ جُمَّتُهُ طامِيَه",0,"ي",2,0],["وَأَزعَجتُ القَطا الوَسنا","نَ بِالمَخطومَةِ الرُسُمِ",1,"م",1,0],["وَأَزورُ أَطرافَ الثُغورِ وَدونَها","طَعنٌ يُبَرِّحُ بِالوَشيجِ الذُبَّلِ",2,"ل",1,0],["وَأُزيحَ ذاكَ الأُنسُ أَجمَعُهُ","وَأُميطَ ذاكَ البِرُّ وَاللَطَفُ",3,"ف",1,0],["وَاِزدَد بَقاءً وَعُلىً","ما بَعدَ وِردَيكَ صَدَر",4,"ر",1,0],["وَأَزرَقِ ماءٍ قَد سَلَبتُ جُمامَهُ","يَعومُ الَشَوى في غَمرِهِ وَيَغيبُ",5,"ب",1,0],["وَأَزْحَفُ بِالجيادِ إِلى مَكَرٍّ","بِهِ الأبْطالُ دامِيَةُ الأَشِلَّهْ",6,"ل",2,0],["وأزْهى على الأيّامِ وهْيَ تَروعُني","وأنْيابُها لا ريعَ جارُكَ رُوقُ",7,"ق",1,0],["وأزارَها ابْنَ الدّارِميِّ أبا الندىً ال","إكْرامُ والتّعْظيمُ والتّبْجيلُ",8,"ل",1,0],["وأزْجُرُ منْ نَزائِعِها رَعيلاً","إذا وَقَذَ الوَجى منها رَعيلا",9,"ل",2,0],["وأزورُ إذْ ظَعَنَ الخَليطُ مَنازِلاً","نَحِلَتْ بِهِنَّ كما نَحِلْتُ الأرْسُمُ",10,"م",1,0],["وَأَزيدُها مِن نارِ حَربي شُعلَةً","وَأُثيرُها حَتّى تَدورَ رَحاها",11,"ا",3,0],["وَأَزجُرُ عَنها النَفسَ إِذ حيلَ دونَها","وَتَأبى إِلَيها النَفسُ إِلّا تَطَلُّعا",12,"ع",2,0],["وازْلِفْ بصَوْمٍ حَبَيْتَ الذِّكْرَ وافِدَهُ","قِرىً وأخْلَصْتَ فيهِ القوْلَ والعَمَلا",13,"ل",2,0],["وَأَزْعَجَنِي مِنْ مَنْشَأي وَمُبَوَّأي","وَمَعْهَدِ أَحْبَابِي وَمَأْلَفِ جِيرَانِي",14,"ي",1,0],["وَازِنْ بِهِ مُؤَنَ السِّيَاسَةِ وادَّخِرْ","فَضْلاً وَوَازِ بِخَرْجِهِ مَا يدْخُلُ",15,"ل",1,0],["وَأَزْمَعَ عَنْكَ الشَّهْرُ لاَ عَنْ مَلاَلَةٍ","فَقَدْ كَمُلَتْ بِالْبِرِّ مِنْهُ الْمَآرِبُ",16,"ب",1,0],["وأزْهَر فضْفاضِ الرِّداءِ إذا احْتَبى","بسُدّةِ نادٍ أو قَرارَةِ مجْلِسِ",17,"س",1,0],["وَأَزِل شُكوكاً بِالنُفو","سِ تَعَلَّقَت مُنذُ البِدايَه",18,"ا",3,0],["وَأَزهَرَ في طِرسي يَراعي وَأَنمُلي","وَلَفظي فَباتَ الطِرسُ يَجني وَيَقطِفُ",19,"ف",1,0],["وأزرق اللون كلون السما","فيه لمن ينظر سر عجيب",20,"ب",1,1],["وَازْدَدْ فَخَاراً بِهَا","يَزْدَدْ فَخَارُ الأَدَبْ",21,"ب",1,0],["وَازْدَرَدُوا مَا ازْدَرَدُوا","مِنْ أَكَلاتٍ مُشْبَعَهْ",22,"ع",2,0],["وَازَّيَنَتْ أَرْضٌ وَفَوَّفَ سَنْدُسٌ","تَمْشِي عَلَى دِيبَاجِهِ الأَقْدَامُ",23,"م",1,0],["وَازْدَادَتِ الإِسْكَنْدَرِيَّةُ بَهْجَةً","إِذْ لاحَ فِيهَا وَجْهُكَ البَسَّامُ",23,"م",1,0],["وَأَزوَرَ يَمطو في بِلادٍ عَريضَةٍ","تَعاوى بِهِ ذُؤبانُهُ وَثَعالِبُه",24,"ب",2,0],["وأَزدُ شَنُوءَةَ ابذَرَعُو إلَينَا","بِجُمٍّ يَحسِبُونَ لَهَا قُرُونَا",25,"ن",2,0],["وأزعجني شيبٌ بفودَيّ طالعٌ","وما كان وقعُ الشيب لي عنهُ مزعجا",26,"ج",2,0],["وأزرقُ العين يمضي حدّ مقلته","مثل السنان بقلبِ العاشق الحذِر",27,"ر",1,1],["وأزهر وضَّاح الصفات عليّها","مدحت به المدح الذي أنا قائله",28,"ل",2,1],["وازداد تحسيناً يخالف قول من","قد قال إن النقص في الترخيم",29,"م",1,0],["وازرع زروعاً ترتضي ريعها","يوماً فكلٌّ حاصدٌ زرعه",30,"ع",2,0],["وازَت عُراها ملوك مِلَّتنا","فكنتمُ ثمَّ من وثائقها",31,"ق",3,0],["وازدحَمَ الوِردُ عليه واعتركْ","واعتبطَ الشرُّ عليه وابتركْ",32,"ك",1,0],["وازجُرِ النفسَ إذا ما حَرنَتْ","أن يفوتَ القوم سبقاً من حرن",33,"ن",1,0],["وَأُزهى إِذا أَطعَمتُ جَوعانَ لُقمَةً","كَأَنّي خَلَقتُ الحَبَّ في الحَقلِ وَالحَقلا",34,"ل",2,0],["وَاِزرَع نُجومَ الشَيبِ في لِمَّتي","فَيَنجَلي حِندِسٌ أَوهامي",35,"ي",1,0],["وَأَزهَرَ سَخّى نَفسَهُ عَن تِلادِهِ","حَنايا حَديدٍ مُقفِلٍ وَسَوارِقُه",36,"ق",2,0],["وَازجُر جفونك لا تَرضَ البُكاءَ لَها","وَاِصبر فَقَد كُنتَ الخطب تَصطَبِرُ",37,"ر",1,0],["واِزحَفْ إِلى جَيش المَعا","رِف تَقهَر الحِبرَ المُقامِرْ",38,"ر",1,0],["وأزلف الوفد إلى ربهم","وظلل السدّة واظّلل",39,"ل",1,0],["وَاِزهَدوا في الطَيرِ إِنَّ ال","عَيشَ عَيشُ الزاهِدينا",40,"ن",2,0],["وَاِزهَدي في مَوكِبٍ لَو شِئتِهِ","لَتَغَطّى وَجهُها بِالدارِعين",41,"ن",1,0],["وَأُزيلَ هَيكَلُها المَصونُ وَسِرُّهُ","وَالدَهرُ لِلسِرِّ المَصونِ مُذيلُ",42,"ل",1,0],["وَأُزيلَ مِن حُسنِ الوُجوهِ وَعِزِّها","ماكانَ يُعبَدُ مِن وَراءِ سِجافِ",43,"ف",1,0],["وَاِزدَدتِ مِن حُسنِ الثَناءِ وَطيبِهِ","حَجَراً هُوَ الدُرِيُّ في الأَمداحِ",44,"ح",1,0],["وَاِزَّيَّنَت أُمَّهاتُ الشَرقِ وَاِستَبَقَت","مَهارِجُ الفَتحِ في المُؤشِيَّةِ القُشُبِ",45,"ب",1,0],["وَاِزدَهى الكَونُ بِالوَليدِ وَضاءَت","بِسَناهُ مِنَ الثَرى الأَرجاءُ",46,"ا",2,0],["وَأَزَرتَ الخُيولَ قَبرَ امرِئِ القَي","سِ سِراعاً فَعُدنَ مِنهُ بِطاءَ",47,"ا",2,0],["وَأَزرَقُ الفَجرِ يَأتي قَبلَ أَبيَضِهِ","وَأَوَّلُ الغَيثِ قَطرٌ ثُمَّ يَنسَكِبُ",48,"ب",1,0],["وَإِزائي مَطالِبٌ لَو تُواتي","نِيَ نَفسٌ عَن مِثلِهِنَّ تَعِفُّ",49,"ف",1,0],["وَأَزعَجَ أَهلَ المَحلَبِيّاتِ ناجِزٌ","مِنَ الحَربِ ما فيهِ خِداعٌ وَلا هَزلُ",50,"ل",1,0],["وَأَزهَرَ وَضّاحِ العَشِيّاتِ لا يَني","مِنَ البِشرِ يَنأى عَن ذَراهُ قَتامُ",51,"م",1,0],["وَأَزارَ أَرضَ الرومِ أَطرافَ الظُبا","حَتّى أَقامَ مُلوكَها في المَقسَمِ",52,"م",1,0],["وأزرقَ كالشِّهابِ إذا حَناه","دِراكُ الطَّعنِ غادَرَه هِلالا",53,"ل",2,0],["وأزهرَ يَنقادُ الزَّمانُ لأمرِهِ","وتأمُرُهُ زُهْرُ العُلى فيُطيعُها",54,"ع",3,0],["وأزهرَ وَضَّاحٍ يَروقُ عيونَنا","إذا ما رَميناه بِلَحْظِ النَّواظِرِ",55,"ر",1,1],["وَأَزعُمُ أَنَّهُ خَطٌّ سَقيمٌ","وَطِرسٌ دارِسٌ كَالشِنَّ بالي",56,"ي",1,0],["وأزهى من تثنَّى في حُلِيٍّ","وأبهج من تَهادى في رداء",57,"ا",2,0],["وَازَّيَّنَتْ بِنَوْرِهَا الْخَمَائِلُ","وَغَرَّدَتْ فِي أَيْكِهَا الْبَلابِلُ",58,"ل",1,0],["وأزالوا ما حَوَتْ أرجاؤُه","للأوالي من قُبورٍ ورِمَمْ",59,"م",1,0],["وَاِزوَرَّ يَلتَمِسُ النَجاةَ فَعاقَهُ","قَدَرٌ أَحاطَ بِهِ وَلَمّا يَعلَمِ",60,"م",1,0],["وأزلفْتَها توبةً تبتغي","بها الخيرَ والخيرُ نِعْمَ الرفيقْ",61,"ق",1,0],["وَأَزعَجَهُنَّ اِهتَزامُ الحُداة","كَجَلجَلَةِ القَينَةِ الصادِحَه",62,"ح",2,0],["وَأَزالَت بِلَمْسِهَا كلَّ دَاءٍ","أكْبَرَتْهُ أطِبَّةٌ وَإِسَاءُ",63,"ا",2,0],["وَازْدَرَتنِي بعضُ الوُلاةِ وقدْ أَص","بَحَ شِعْرِي فيهمْ كَخُبْزِ الشَّعِيرِ",64,"ر",1,0],["وأُزِيلَتْ بالسَّبِّ أعْراضُ","مَنْ فيها فما قامَ الرِّبْحُ بالخُسرانِ",65,"ن",1,0],["وازدَرْتَ قبرَ أبيكَ قبرَ محمّدٍ","بملائكِ اللّهِ العُلى متكنَّفا",66,"ف",2,0],["وَاِزدادَتِ الأَرضُ لَمّا ساسَها سَعَةً","حَتّى تَضاعَفَ نورُ الشَمسِ وَالقَمَرِ",67,"ر",1,0],["وأزين من هوى بازٍ وصقرٍ","ولعب بالديوكِ وبالحمام",68,"م",1,0],["وَأَزهَدَ مِن جيفَةٍ لَم تَدَع","لَها الشَمسُ مِن مَفصَلٍ مَفصَلا",69,"ل",2,0],["وَأَزهَدُ في مَدحِ الفَتى عِندَ صِدقِهِ","فَكَيفَ قُبولي كاذِباتِ المَدائِحِ",70,"ح",1,0],["وَأَزورُ الجِنانَ أُحبَرُ فيها","بَعدَ طولِ الهُمودِ في الأَرماسِ",71,"س",1,0],["وَاِزدَحَمَت حَلقَتا البِطانِ بِأَق","وامٍ وَطارَت نُفوسُهُم جَزَعا",72,"ع",2,0],["وَأَزعَجَهُ أَن قيلَ شَتّانَ ما تَرى","إِلَيكَ وَعودٌ مِن سَراءٍ مُعَطَّلُ",73,"ل",1,0],["وَأَزجُرُ الكاشِحَ العَدُوَّ إِذا","اِغتابَكَ زَجراً مِنّي عَلى أَضَمِ",74,"م",1,0],["وَأَزْهَرَ كالعَيُّوقِ يَسعَى بِزهْرَاءِ","لَنَا مِنْهُما دَاءٌ وَبرْءٌ مِنَ الدَّاءِ",75,"ا",2,1],["وَازجُر جفونك لا تَرضَ البُكاءَ لَها","وَاِصبر فَقَد كُنتَ عند الخطب تَصطَبِرُ",76,"ر",1,0],["وأزاهيرُ حانياتٌ على النهر","يُقَبلنَ في الضحى شُطآنه",77,"ن",2,0],["وأزوريسُ على الشطِّ الظليلْ","يَعْصُرُ الخمرَ ويسقِي السلسبيلْ",78,"ل",1,0],["وأزاهيرَ حوله ذابلاتٍ","مزَّقتها الرِّياحُ في الليلِ شملا",79,"ل",2,0],["وأزهدُ الناس وفي الدنيا يدُه","وأخشع العالم وهو سيده",80,"ه",1,0],["وَازْوَرَّ حَاجِبُهَا عَنْ نَظْرَةٍ رَشَقَتْ","سَوَادَ قَلْبِي بِسَهْمٍ صِيغَ مِنْ حَوَرِ",81,"ر",1,0],["وَازَّينَتْ بِكِ بَعْدَ أَنْ خَلَّفْتِهَا","وَكَأَنَّ زُخْرُفَهَا عَلَيْه رَمَاد",82,"د",1,0],["وَأَزْكَى الْعَوَارِفِ بِيضُ الأَيَا","دِي تَجُودُ بِهِنَّ ذَوَاتُ الْخَفَرْ",83,"ر",1,0],["وَأَزْهدَتْنِي فِي المَدِيحِ","وَالأَبَاطِيلِ الأُخَرْ",84,"ر",1,0],["وأزاح النسيم عن صدرها الثوب","فلاحا ولا تقل نهداها",85,"ا",3,0],["وازرقاق كأنهُ حين زار","الأفق أهدى إليه منهُ إزارا",86,"ر",2,0],["وأزْلفها ملءَ النواظِرِ جَنَّةً","تميد بها الأغصانُ وهي رِطاب",87,"ب",1,0],["وأزاح التاريخُ عن عَيْنِهِ الحُجْبَ","فَمَرَّتْ تخوض في الأجيال",88,"ل",1,0],["وَأَزَاهِيرُ كُنَّ تَاجَ عَرُوسٍ","عُفِّرَتْ بَعدَ لَيْلةٍ في التُّرابِ",89,"ب",1,0],["وأزيزَ أسرابٍ تَصبُّ شُواظَها","فوق الحصون، فتستحيلُ طلُولا",90,"ل",2,0],["وازلف بصوم حييت الذكر وافده","قرى وأخلصت فيه القول والعملا",91,"ل",2,0],["وأزيلتْ بالسَّبِّ أعراضُ من في","فما قامَ الرِّبْحُ بالخُسْرانِ",92,"ن",1,0],["وأزدان بالديكين صَلْصلهُ","ونبت دجاجته عن الصدر",93,"ر",1,0],["وأزاحني عن عالَمٍ قَذِرٍ","نَحْسٌ لآخرَ زاهرٍ نَضِر",94,"ر",1,0],["وازجر عنها النَّفس إِذا حيلَ دُونَها","وَتَأْبَى إليها النَّفْسُ إلاّ تطَلُّعا",95,"ع",2,0],["وأزْرَقُ الفَجْرِ يَأتي قَبلَ أبيَضِهِ،","وَأوّلُ الغَيثِ مطرٌّ، ثمّ يَنسَكِبُ",96,"ب",1,0],["وأزَرْتَ الخُيول قَبرَ امرِىءِ القَيْ","سِ سِرَاعاً، فعُدْنَ منهُ بِطَاءَ",97,"ا",2,0],["وأزهى إذا أطمعت جوعان لقمة","كأني خلقت الحبّ والحقل والحقلا",98,"ل",2,0],["وأزعم أن لا شيء يجمع بينا","لأبعد عن نفسي وعنك المتاعبا",99,"ب",2,0],["وازجُرِ النفسَ إذا ما حَزُنَتْ","أن يفوتَ القوم سبقاً من حزن",100,"ن",1,0],["وازجُرْ عن الجَهلِ ولا تُجاهل","وادعُ إلى الخيرِ ولا تُقاتل",101,"ل",1,0],["واِزحَفْ إِلى جَيش المَعا","رِف تَقهَرِ الحِبرَ المُغَامِرْ",102,"ر",1,0],["وأزعم أن لا شيء يجمع بيننا","لأبعد عن نفسي وعنك المتاعبا",103,"ب",2,0],["وأزهرَ كالعيُّوقِ بزهراءِ","لَنَا مِنْهُما دَاءٌ وَبرْءٌ مِنَ الدَّاءِ",104,"ا",2,1],["وَأَزُفها لِجَناب فَياض النَدى","طامي العباب موطد الأَلواذ",105,"ذ",1,0],["وازدان بالدين والتقوى فقام له","عز بتمداحه عجت طلائعه",106,"ع",2,0],["وأزكى صلاة اللَه ما لاح كوكب","على ملجأ الأكوان وانتعمة الكبرى",107,"ر",2,0],["وأزال الأرصاد عن مضمرات السر","ر جهراً بالكشف والإطلاع",108,"ع",1,0],["وأزاهر الشوق الملح أَحالها","لفح السموم تغضناً بإهابي",109,"ي",1,0],["وَأَزرَقُ في رَأَسِ خَطِيَّةٍ","إِذا هَزَّ اِكعَبَها تَخطِرُ",110,"ر",1,0],["وازدَهَى مَجلِسِي ومُلِّي عَرفاً","فَائِحاً مُزرِياً بِكُلِّ عَبِيرِ",111,"ر",1,0],["وازدان مسرى وهو مسراه إلى","هذا الوجود بجوده المتلاحقِ",112,"ق",1,0],["وأزور آثار الملو","ك وكنت قبلُ بها معنّى",113,"ن",2,0],["وَآزَرَكَ الرَأيُ ما إِن يَفيلُ","وَضافَرَكَ العَزمُ ما إِن يُفَلّ",114,"ل",1,0],["وأزرت أفريقية قِطَعاً","قطعت بها وريده",115,"د",2,0],["وأزاهير ترى من طلِّها","حببا قد قلَّدته دررا",116,"ر",2,0],["وازجره إني في جوارك ينقمع","عني وقم في نصر عبدك واقعد",117,"د",1,0],["وآزره قوم وهم أكبر العدى","له لو درا والطبع أغلب غالب",118,"ب",1,0],["وازددت فخرا على الأقران قاطبة","إذ كان علمي من جدواه مكتسبا",119,"ب",2,0],["وازن الرقص بالقضا وتخير","ارجح المنصبين في الميزان",120,"ن",1,0],["وازدروا من طلب العلم","وعدوه عوارا",121,"ر",2,0],["وأزعجتْها دواعي البَينِ وانكمشتْ","تَسري وفي مُقلتيها فَتْرةُ الكسَلِ",122,"ل",1,0],["وأزجِّ قوسِ الحاجبينِ وجدْتُهُ","يَرمي بسهمِ الشفرِ نَحوي اشِقا",123,"ق",2,0],["وَأَزعَجَهُم مَن ذاقَ لِلجُرحِ بَعدَهُم","بِأَمسٍ وَهَل يَستَعذِبُ المَوتَ ذائِقُ",124,"ق",1,0],["وَأَزُورُ الحِبَّ عَلانِيَةً","وَيَزُورُ جَنابي عَن أَمَمِ",125,"م",1,0],["وَأَزْرَقَ خَفَّاقٍ تَلُوحُ كَأنَّمَا","تَجَلَّدَ دَرْعاً أَوْ بِسَلْخٍ تَجَبَّبَا",126,"ب",2,0],["وأَزور من أَلِف البعادَ وحبُّه","بينَ الجوانحِ والحَشَا مركوز",127,"ز",1,0],["وَأَزهدُ خلقِ اللَّه عيسى بعصرهِ","وَما قطُّ أَغوى الناسَ بالمالِ أو أغرى",128,"ر",2,0],["وَأزالَ عمّن حلّها الأهوالا","وَعلى الإرادةِ آخذَ الجهّالا",129,"ل",2,0],["وَأزورَ آثارَ النبيّ فأغنمُ","بِحياتهِ صلّوا عليهِ وسلّموا",129,"م",3,0],["وأزورَ بالمعلاةِ كلَّ سميدع","راضٍ قرير العين غير مروّعِ",129,"ع",1,0],["وَأزورُ ثمَّ محمّداً","خير الوَرى كلّاً وبعضا",130,"ض",2,0],["وازَرته على النبوّة لمّا","جاءَهُ الوحي كان منها الوحاءُ",131,"ا",2,0],["وأزعجتكم شجونٌ","من نارها قد سلمتم",132,"م",1,0],["وأزمع عند الصبح بيناً لرحلة","إلى بلد فيه لأهله منزل",133,"ل",1,0],["وأ