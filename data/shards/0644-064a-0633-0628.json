,[4679,"ما درت مثل عيدك الأعيادُ","https://www.poetsgate.com/ViewPoem.aspx?id=142749",""],[3591,"يا أمير البلاد أهدي سلاماً","https://www.poetsgate.com/ViewPoem.aspx?id=149442",""],[5187,"ذكريات وعتاب","https://www.poetsgate.com/ViewPoem.aspx?id=29255",""],[4045,"نفّر نومي الخبر الساري","https://www.poetsgate.com/ViewPoem.aspx?id=200300",""],[5302,"شعري","https://www.poetsgate.com/ViewPoem.aspx?id=201746",""],[5338,"أمة العرب قفي واستلهمي","https://www.poetsgate.com/ViewPoem.aspx?id=187618",""],[5353,"فرعون","https://www.poetsgate.com/ViewPoem.aspx?id=212458",""],[5442,"ليس بعد السبعين إلا الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=114787",""],[5473,"قلت لما شرطوه وَجرى","https://www.poetsgate.com/ViewPoem.aspx?id=189607",""],[5582,"قَدْكَ يا عاذِلُ تُبْدِي اللَّوْمَ قَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=186907",""],[5691,"فقير...!","https://www.poetsgate.com/ViewPoem.aspx?id=207554",""],[5701,"لاحت على الشاطئ بستانا","https://www.poetsgate.com/ViewPoem.aspx?id=164672",""],[466,"قد لفَّها الليلُ بمدلاج الليلْ","https://www.poetsgate.com/ViewPoem.aspx?id=38081",""],[402,"في رضى المربوب والرب","https://www.poetsgate.com/ViewPoem.aspx?id=35118",""],[402,"أي بشرى حملتموها الكتابا","https://www.poetsgate.com/ViewPoem.aspx?id=35111",""],[402,"يا ابن لبنان عد إلى لبنان ط","https://www.poetsgate.com/ViewPoem.aspx?id=36536",""],[5790,"حدثوا عن صبابتي وشجوني","https://www.poetsgate.com/ViewPoem.aspx?id=112160",""],[6009,"أودى الشباب حميدا ذو التعاجيب","https://www.poetsgate.com/ViewPoem.aspx?id=182950",""],[6019,"سجدةٌ في محراب العشق","https://www.poetsgate.com/ViewPoem.aspx?id=157678",""],[6102,"تَضاد !!","https://www.poetsgate.com/ViewPoem.aspx?id=182736",""],[6102,"عَيناكِ","https://www.poetsgate.com/ViewPoem.aspx?id=182765",""],[6102,"رسالة إلى \"موديل\" ...","https://www.poetsgate.com/ViewPoem.aspx?id=184870",""],[6102,"موعد","https://www.poetsgate.com/ViewPoem.aspx?id=185070",""],[6119,"ليس بيني وبين قومي إلا","https://www.poetsgate.com/ViewPoem.aspx?id=181288",""],[6124,"أين","https://www.poetsgate.com/ViewPoem.aspx?id=109739",""],[5309,"قل لجدي الأعلى ابي العنعنات","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573797",""],[5309,"في نظام مرصع الأصفاد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573552",""],[6184,"رقصة في ازمير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78622&r=&rc=14",""],[572,"من ترى ينصفُني من خَليلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9428&r=&rc=285",""]],"verses":[["لَيسَ بَدرٌ إِن بَغى أَو","وَلَ مَن عَزَّ الحِمامُ",0,"م",1,0],["لَيسَ بِالمَغبونِ عَقلاً","مَن شَرى عِزّاً بِمالِ",1,"ل",1,0],["لَيسَ بِالراضي إِذا نَبَّهَهُم","طارِقُ اللَيلِ وَلا بِالمُغتَبِط",2,"ط",1,0],["لَيسَ بِسَمّاعٍ لِمَن لامَهُ","إِنَّ الَّذي أَبلاهُ مَحبوبُ",3,"ب",1,0],["لَيسَ بِالمُؤيِسِي تَكَلُّفُكِ العَتبَ","دَلالاً مِنَ الرِضى المَطبوعِ",4,"ع",1,0],["لَيسَ بِخَبٍّ مانِعٍ ظَهرَهُ","لا يَنهَضُ الدَهرَ بِعِبءٍ ثَقيل",5,"ل",1,0],["لَيْسَ بِالْوَقَّافِ مُخْتَبِلاً","بَيْنَ دَفْتِ الفِكْرِ وَالجَذْبِ",6,"ب",1,0],["لَيْسَ بِالشَّاعِرِ الَّذِي خِلْتِ إِلاَّ","عَبْرَةً قَدْ يَصُوغُهَا أَوْ أَنَّهْ",7,"ن",2,0],["لَيْسَ بِدْعاً وَفِي القُلُوبِ صَفَاءٌ","مَا يُرَى مِنْ تَقَارُضِ الجِيْرَانِ",8,"ن",1,0],["لَيْسَ بِدْعاً وَقَدْ تَوَى أَنْ يُعَ","زى كُبَرَاءُ البِلادِ وَالأَعْيَانُ",9,"ن",1,0],["لَيْسَ بِدْعاً أَنْ تُقَدِّرِيهِ بِحَقٍّ","إِنَّمَا يُقَدِّرُ العَظِيمَ العَظِيمُ",10,"م",1,0],["لَيْسَ بِالأَصْيَدِ العَيُوفِ وَلا بِاللَّ","بِقِ المُجْتَدِي تَحَايَا الأَنَامِ",11,"م",1,0],["لَيْسَ بِدْعاً وَالحَقُّ مَا أَنْتَ تَرْجُو","أَنْ يُرَى الصِّدْقُ عَاصِماً لِلْمَقَالِ",12,"ل",1,0],["ليس بِدعا تجاة ليث هصور","من كليب عدا عليه وهّرا",13,"ر",2,0],["لَيسَ بِمَطروقٍ وَلا بَكِيِّ","وَمَرتَعٍ مُقتَبِلٍ جَنِيِّ",14,"ي",1,0],["ليس بالناظِرَيْن صبرٌ عن الوج","ه الذي يجمع السَّنا والسناءَ",15,"ا",2,0],["ليس بين الصديق والنفس فرقٌ","عند تحصيل قسمة الأشياءِ",16,"ا",2,0],["ليس بالمُعْمِل الهَجين ولا الوَحْ","شِيِّ ذي العُنْجُهيَّةِ العَثْوَاءِ",16,"ا",2,0],["ليس بيني وبين قَيْسٍ عِتَابٌ","غيرَ طعن الكُلَى وضرب الرقابِ",17,"ب",1,0],["ليس بعد النشورِ موتٌ فكبتاً","للأعادي فكلهم مكبوتُ",18,"ت",1,0],["ليس بيضٌ من المشيب رثاثٌ","شكلَ بيض من الغواني بضاض",19,"ض",1,0],["ليس بمكفورٍ ولا ضائعٍ","إيناسه نفسي وإرفاقه",20,"ق",2,0],["ليس بدْعاً من الحوادثِ أن يُع","زَلَ والٍ وأن تموتَ الرّجالُ",21,"ل",1,0],["ليس بجَوْرٍ عليه أقْصده","بل منعُه زورتي وإلمامي",22,"م",2,0],["ليس بمدفوعٍ ولا مخاصَمِ","في ذاك تالله ولا مُحاكمِ",23,"م",1,0],["ليس بالراجِحِ مَنْ رُجْ","حانُهُ لحْمٌ وشحمُ",24,"م",1,0],["ليس بالخاشع الضئيل ولكن","قده الله قدَّ سيفٍ يمان",25,"ن",1,0],["ليس بالمنكرِ إن لم تُجعَلوا","مُستقاه أن تكونوا شَطَنه",26,"ن",2,0],["لَيسَ بَينَ الصَلاحِ وَالشَرِّ حَدٌّ","كَالَّذي شاءَ وَضعُهُ الأَنبِياءُ",27,"ا",2,0],["لَيسَ بي داءٌ وَلَكِنّي اِمرُؤٌ","لَستُ في أَرضي وَلا بَينَ صَحابي",28,"ب",2,0],["لَيسَ بَعدَ الأَمينِ ثَمَّ مَكانُ","غَيرَ مُستَوحِشٍ وَلا إِنسانُ",29,"ن",1,0],["ليس بدعا إن أبنتك القوافي","فالذي نابها لعمري فجيع",30,"ع",1,0],["ليس بعد الحياة إلا بوار","ليس بعد العمران إلا الخراب",31,"ب",1,0],["ليس بالشعر ما خلا من شعور","وان احلولى لفظه والبناء",32,"ا",2,0],["ليس بدعاً من امة قد رعاها","فيصل ان يكسر الاغلالا",33,"ل",2,0],["ليس بين الغنى إلى الفقر إلا","قولة الشؤم من وسيط يقول",34,"ل",1,0],["لَيسَ بِحملٍ ما يَمَلُّ الظَهرُ","ما الحِملُ إِلّا ما يُعاني الصَدرُ",35,"ر",1,0],["لَيسَ بَيني وَبَينَ خالِكَ إِلّا","أَنَّني ما حَييتُ في إِجلالِه",36,"ل",2,0],["لَيسَ بِالسائِلِ إِن هَمَّ مَتى","لا وَلا الناظِرِ ما يوحي الفَلَك",37,"ك",1,0],["لَيسَ بِالزاخِرِ في العِلمِ وَلا","هُوَ يَنبوعُ البَيانِ المُنفَجِر",38,"ر",1,0],["لَيسَ بِالأَمرِ جَديراً","كُلُّ مَن أَلقى خِطابا",39,"ب",2,0],["ليسَ بَرْقٌ يكونُ أَخْ","لَبَ مِنْ بَرْقِ غَانِيَهْ",40,"ن",3,0],["لَيسَ بِالمُنكَرِ إِن بَرَّزتَ سَبقاً","غَيرُ مَدفوعٍ عَنِ السَبقِ العِرابُ",41,"ب",1,0],["لَيسَ بِمُختالٍ لَدى نِعمَةٍ","وَلا عَظيمِ الكِبرِ فَجفاجِ",42,"ج",1,0],["لَيسَ بَرحُ الغَرامِ ما بِتُّ تُخفي","إِنَّ بَرحَ الغَرامِ ما بِتَّ تُبدي",43,"د",2,0],["لَيسَ بِالمُصرِمِ المُقِلِّ الَّذي يو","جَدُ رَبُّ اِثنَتَي مَساعٍ وَإِحدى",44,"د",2,0],["لَيسَ بَديعاً مِنهُ وَلا عَجَباً","أَن يَطرُقَ الماءَ وِردُهُ خِمسُ",45,"س",1,0],["لَيْسَ بِهَيَّابَةٍ وَلا وَكَلٍ","بَلْ صَادِقٌ فِي اللِّقَاءِ مُعْتَرَفُهْ",46,"ه",1,0],["لَيسَ بي عِيٌّ بِما قُلتَ إِنّي","عالِمٌ أَفقَهُ رَجعَ الجَوابِ",47,"ب",1,0],["ليس بالحيِّ وإن طال المدى","مَن يخافُ الموتَ فيما اعتزما",48,"م",2,0],["ليس بالمُدركِ حقّاً غافلٌ","نامَ والأحداثُ يقظَى لم تَنَمْ",49,"م",1,0],["لَيسَ بِدعاً نَفرَةٌ مِن شادِنٍ","فَرِقٍ أَو ميلَةٌ مِن غُصنِ بانِ",50,"ن",1,0],["لَيسَ بِمُحتاجٍ إِلى مِكحَلٍ","وَلا دَماليجَ وَخِلخالِ",51,"ل",1,0],["لَيسَ بِقِعديدٍ وَلا قَيّومِ","وَلا عَنِ الحيلَةِ بِالسَؤومِ",52,"م",1,0],["لَيسَ بِاللابِسِ القَميصَ وَلَكِن","ذي القِباءِ المُعَقرَبِ الصُدغَينِ",53,"ن",1,0],["لَيسَ بَيني وَبَينَ مَن كانَ وَخماً","لا يَفي لِلخَليلِ غَيرُ السُكوتِ",54,"ت",1,0],["لَيسَ بِالصافي وَإِن صَفَّيتَهُ","عَيشُ مَن يُصبِحُ نَهباً لِلرُتَب",55,"ب",1,0],["لَيسَ بِالمُبتَغي سِواكِ وَلا البا","ئعِ مِنكُمُ نَصيبَهُ بِنَصيبِ",56,"ب",1,0],["لَيسَ بِالناظِرِ الجَوابَ فَيَرعى","قَولَ حُدّاثِهِ وَلا بِالمُجيبِ",56,"ب",1,0],["لَيسَ بِالسِنِّ تَستَحِقُّ المَنايا","كَم نَجا بازِلٌ وَعوجِلَ بَكرُ",57,"ر",1,0],["ليس بين الأثير والله فرقٌ","في سوى اللفظ إن هداك الشعور",58,"ر",1,0],["ليس بي ما يريب عند بكائي","غير أني مفارق لرفاقي",59,"ق",2,0],["ليس بي كبرة تقرب حتفي","غير اني اموت شيئاً فشيا",60,"ي",2,0],["ليس بي في المقال عنك عياء","كيف يعيا الفصيح حين يقول",61,"ل",1,0],["لَيسَ بالشاعر من كا","ن لما قيل يعيدُ",62,"د",1,1],["ليس بدعاً يا وردة العمر أن كا","نت لمغناك وردةُ الروض تُهدى",63,"د",2,0],["لَيْسَ بَيْنَ الْجُنونِ وَالْحُمْقِ إِلَّا","مِثْلُ مَا بَيْنَ أَدْهَمٍ وَكُمَيْتِ",64,"ت",1,0],["لَيْسَ بِدْعاً مِنْهُمُ أَنْ يَحْتَفُوا","بِالَّذِي شَرَّفَهُمْ خَيْرَ احْتِفَاءْ",65,"ا",2,0],["لَيْسَ بِدْعاً وَقَدْ رَأَيْتُكَ فِي","أَبْهَى مِثَالٍ إِنْ قُلْتُ هَذَا وِإِلاَّ",66,"ل",2,1],["لَيْسَ بِدْعاً وَفِي المَكَانِ صَلاحٌ","أَنْ يُرَاعَى فِي اسْمِ المَكانِ النَّظِيرُ",67,"ر",1,0],["لَيْسَ بِدْعاً أَنْ يُمْسِيَ الشَّامُ وَالأَحْ","زَان فِيه تُقِض كل وِسَاد",68,"د",1,0],["لَيْسَ بِدْعاً وَإِنَّهُمْ","صَفْوَةُ الشَّرْقِ وَالنُّخَبْ",69,"ب",1,0],["ليْسَ بَذْلٌ عَنْ بَسْطةٍ فِي الحِجَى","عِلماً وَخُبْراً كالْبَذلِ عَن إمْلاَقِ",70,"ق",1,0],["لَيْسَ بِالتَّارِكِ فِيهِمْ جُهْدَهُ","لِسِوَى أَعْوَانِهِ جَاهاً وَأَزْرَا",71,"ر",2,0],["لَيْسَ بِالْكُفْؤِ لِعَيْشٍ طَيِّبٍ","كلُّ مَنْ شَقَّ عَليْهِ العَيْشَ حُرَّا",71,"ر",2,0],["لَيْسَ بِدْعاً بِنَاؤُهُ غَيْرَ أَنَّ","السِّرَّ فِيمَا بَنى لِمِصْرَ وَمَهَّدْ",72,"د",1,0],["لَيْسَ بِدْعاً وَرَبَّةُ القْصْرِ لاَ تَفْ","عَلُ غَيْرَ الْخَلِيقِ بالإِحْمَادِ",73,"د",1,0],["لَيْسَ بِدْعاً وَأَنْتِ مَا أَنْتِ أَنْ","أَطْنَبَ فِيكِ الْكِتَابُ وَالشُّعَرَاءُ",74,"ا",2,0],["لَيْسَ بِدْعاً وَقَدْ دَعَوْتَ إِذَا","لَبَّتْ نُفُوسُ الأَعِزَّةِ الأَمْجَادِ",75,"د",1,0],["لَيْسَ بِدْعاً أَنْ يُرْخِصُوا غَالِيَ الدَّمْ","عِ عَلَى ذَلِكَ الزَّعِيمِ الفَقِيدِ",76,"د",1,0],["لَيْسَ بِدْعاً وَأَنْتَ مَا أَنْتَ مِنَّا","أَنْ نَظَمْنا لَكَ الْقَلاَئِدَ حَمْدَا",77,"د",2,0],["لَيْسَ بُدْعاً وَذَاكَ وَصْفُ حُسَيْنٍ","أَنْ يُغَنَّى بِذِكرِهِ إِطْنَابَا",78,"ب",2,0],["ليس بِدعاً أنْ زَهَا شعري به","يزدهي الروضُ إذا الغَيْثُ همَا",79,"م",2,0],["ليس بِدعاً أن نَستريبَ ولكن","نتمنىَّ ألاّ نرى ما يُريب",80,"ب",1,0],["ليس بعد الضراط يا وهب فينا","حرب الناس غير وقع السلاح",81,"ح",1,0],["ليس بين العراق والشام حدّ","هدم الله ما بنوا من حدود",82,"د",1,0],["ليس بجَوْرٍ عليه أقْصده","بل منعُه زورتي وإلمالي",83,"ي",1,0],["ليس بتَنْبالٍ ولا زُميل","إنِّي إليه لشديدُ الميل",84,"ل",1,0],["ليس بيني وبين قَسيْسٍ عِتَابٌ","غيرَ طعن الكُلَى وضرب الرقابِ",85,"ب",1,0],["ليس بي نازعا إلى الهلك يوماً","نسب لي في الهالكين عريق",86,"ق",1,0],["لَيْسَ بِهَيَّابَة ٍ، وَلاَ وَكَلٍ","بلْ صادقٌي اللقاءِ معترفهْ",87,"ه",1,0],["ليس بدعاً على ترقي الرزايا","أن تبيت الشؤون أعظم غزرا",88,"ر",2,0],["ليس برح الهموم ما رحت تبدي","ه ولكن ما بات فيك دفينا",89,"ن",2,0],["ليس ببالى بالأعادي بعد ما","يَعُدُّ ذؤبانَ الفلا أصادقا",90,"ق",2,0],["ليس بمحتاجٍ إلى شِكَّةٍ","سلاحُه من ذاته الضيغمُ",91,"م",1,0],["ليس بمخلوق ولا بخالق","كذا