{"poems":[[79,"هدم السد وهو ما هو فار","https://www.aldiwan.net/poem36415.html","الخفيف"],[74,"سقى عهد ليلى مدمع وسحائب","https://www.aldiwan.net/poem18247.html","الطويل"],[45,"جللا كما بي فليك التبريح","https://www.aldiwan.net/poem9522.html","الكامل"],[47,"شيد بفضلك مشرف البنيان","https://www.aldiwan.net/poem66837.html","الكامل"],[2,"مرج الدين فأعددت له","https://www.aldiwan.net/poem25039.html","الرمل"],[71,"إن وادي الباب قد أذكرني","https://www.aldiwan.net/poem28833.html","الرمل"],[108,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[92,"شاغور حمانا","https://www.poetsgate.com/ViewPoem.aspx?id=179166",""],[164,"ليوم واحد لك في الصيام","https://www.aldiwan.net/poem59047.html","الوافر"],[228,"مر جنح من الظلام وقلبي","https://www.aldiwan.net/poem41919.html","الخفيف"],[295,"هند عذراء أسلمتها المقادير","https://www.aldiwan.net/poem11680.html","الخفيف"],[408,"عدمت اللقا إن لم أوافك زائرا","https://www.aldiwan.net/poem46422.html","الطويل"],[445,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[505,"أسكرت أهل الوحا خمرتنا","https://www.aldiwan.net/poem37672.html","الرمل"],[563,"مرج البحرين إذ يلتقيان","https://www.aldiwan.net/poem33756.html","الرمل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103082","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64667","البسيط"],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102223","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122006","الكامل"],[1525,"","https://poetry.dctabudhabi.ae/diwan/poem/116111","الرمل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77798","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108933","الكامل"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105844","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109470","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93846","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134196","الخفيف"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3688,"","https://poetry.dctabudhabi.ae/diwan/poem/101265","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128882","الخفيف"],[3774,"","https://poetry.dctabudhabi.ae/diwan/poem/21495","الطويل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34630","الكامل"],[3914,"","https://poetry.dctabudhabi.ae/diwan/poem/116905","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54474","الطويل"],[4434,"","https://poetry.dctabudhabi.ae/diwan/poem/130704","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72431","الرجز"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204243","الهزج"],[4677,"لك با حنونة","https://www.poetsgate.com/ViewPoem.aspx?id=203949",""],[4578,"بالله نحوي بأعطاف اللقا ميلوا","https://www.poetsgate.com/ViewPoem.aspx?id=49504",""],[3271,"التائهة","https://www.poetsgate.com/ViewPoem.aspx?id=131013",""],[5186,"مخرت تحمل خمرا، وجعه","https://www.poetsgate.com/ViewPoem.aspx?id=156525",""],[5431,"عمان","https://www.poetsgate.com/ViewPoem.aspx?id=197619",""],[5431,"بنٌ أفّاك!...","https://www.poetsgate.com/ViewPoem.aspx?id=208853",""],[5431,"أقسى من الليل ...","https://www.poetsgate.com/ViewPoem.aspx?id=210254",""],[5470,"سديم التداني","https://www.poetsgate.com/ViewPoem.aspx?id=11241",""],[5506,"إن جِئتَ بَدراً فَطِب وَاِنزِل بِذي سَلَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=115770",""],[5648,"برهانه اليا حارت عقول الالباب","https://www.poetsgate.com/ViewPoem.aspx?id=164273",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""],[6067,"بائع العسلية","https://www.poetsgate.com/ViewPoem.aspx?id=177158",""],[6102,"كبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=184856",""],[6124,"مرجان","https://www.poetsgate.com/ViewPoem.aspx?id=174897",""],[6142,"ها هو البرقُ مرودٌ من حديدِ","https://www.poetsgate.com/ViewPoem.aspx?id=155683",""],[4222,"قضى عمره في الهجر شوقا إلى الوصل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52880&r=&rc=172",""]],"verses":[["مِرْجَلٌ فوقَ قِدْرَةِ الغَدْرِ يغْلي","أُضْرِمَتْ تحْتَهُ منَ الشّرِّ نارُ",0,"ر",1,0],["مرجيَة أقواله وفعاله","ولا غرو أن ترجى لديه الرغائب",1,"ب",1,0],["مَرجُوُّ مَنفَعَةٍ مَخوفُ أَذِيَّةٍ","مَغبوقُ كاسِ مَحامِدٍ مَصبوحُ",2,"ح",1,0],["مَرَجَ الإِلَهُ بِسَيبِ كَفِّكَ لِلنَدى","بَحرَينِ بِالمَعروفِ يَلتَقِيانِ",3,"ن",1,0],["مَرِجَ الدينُ فَأَعدَدتُ لَهُ","مُشرِفَ الحارِكِ مَحبوكَ الثَبَج",4,"ج",1,1],["مرجُهُ مبتسمٌ مما بَكَتْ","سُحُبٌ في ذيلها الطيبُ انسحبْ",5,"ب",1,0],["مَرَجَ البحرين في مصرَ الذي","شقَّت النيلَ وأجرَتْهُ يداهْ",6,"ا",2,0],["مرْجٌ أرادتْه الطبيعةُ صورةً","منها على إبداعها عُنوانا",7,"ن",2,0],["مرجعة بأصوات حسان","مغردة كتغريد الحمام",8,"م",1,0],["مَرَّ جُنحٌ مِنَ الظَلامِ وَقَلبي","لَم يَزَل يَستَمِرُّ في خَفَقانِه",9,"ن",2,1],["مرّ جذلان باسم الثغر","وضاح المحيا يتيه عجبا وكبرا",10,"ر",2,0],["مُرجٍ لِشخْصٍ كلّ يومٍ وليلةٍ","وربّكَ رَبّ العرش يكفيك ناصِرا",11,"ر",2,0],["مَرَجْتَ عَلَيْهِ لُجَّ بَحْرَيْنِ يَلْتَقِي","عَلَى نَفْسِهِ تَيَّارُهُ المُتَلاطِمُ",12,"م",1,0],["مرجعُ السادات اعيان الحمى","اين ما راموا السرى حضرتنا",13,"ن",2,0],["مرج البحرينِ إذ يلتقيانْ","وهما بحرا وجودٍ وكيانْ",14,"ن",1,1],["مرجوحه راجح فيه ومعتدل","وجائز واجب والعكس مطرود",15,"د",1,0],["مُرَّجبٌ لعُفاةٍ صَدْرُهُ لَهُمُ","رَحْبٌ وإِنْ ضاقَ نادِيهِ بما رَحُبا",16,"ب",2,0],["مرجّى يرجّي فضل أنعُمِك التي","بكفّيك مجراها ثناءً ومَوحِداً",17,"د",2,1],["مَرِجَتْ عُهُودُ الدِّرْعِ يَوْمَ ضِرَابِهِمْ","وَعُهُودُ فَتْكِ سُيُوفِهِمْ لَمْ تَمْرَجِ",18,"ج",1,0],["مرجَ البحرينِ فيضاً دمعُه","إذ رأى جفنيهِ لا يلتَقِيان",19,"ن",1,0],["مرج الفضاء الواسع","فتح الرتاج المبهم",20,"م",1,0],["مرجت لنا البحرين راحته التي","فيها الندى واليأس يلتقيان",21,"ن",1,0],["مُرجّيا أن يُلينَ منها","ما اظهرته من الجفاءِ",22,"ا",2,0],["مرجُ العيون إذا بغى باغٍ به","يغدو بمارج بأسه مترمّدا",23,"د",2,0],["مرج بوجه ثراه نضرة عرفت","حيث النعيم كساء رونق الخصب",24,"ب",1,0],["مرجع العالمين بل عالميهم","وملاذ الفضل الذي لا يسامى",25,"م",2,0],["مَرجيِّهُم يُزري عَلى قَدَريَّهُم","وَالفِرقَتانِ لَدَيَّ كافِرَتانِ",26,"ن",1,0],["مرجية نيل العلاء ببابه","وليس ينال الحد من ليس يطلبه",27,"ب",2,1],["مرجع الأَمر مَوطن النَفس هَذا","تَتَقي مَن يَحتله الأسواء",28,"ا",2,0],["مر جنح من الدجى وفؤادي","خافق كالنجوم في الخفقان",29,"ن",1,1],["مَرَجتَ لَنا البَحرينِ بَحراً شَرابُهُ","فُراتٌ وَبَحراً يَحمِلُ الفُلكَ أَسوَدا",30,"د",2,0],["مرج النظام وعاد منكرنا","عرفاً وأنكر بعده العرفُ",31,"ف",1,0],["مرجى للخلافة وهو ماء","ومأمول لآمال عظامِ",32,"م",1,0],["مرجعةٌ فوقَ الغصونِ حمامُها","فنونَ هديلٍ بينَ أَفنانها الهُدلِ",33,"ل",1,0],["مرجان مقتني نفيس ونجاح","فقتل الطفل نفيس وأزاح",34,"ح",1,0],["مرجل الشعر بمعنى حسنه الرا","جل من تخيلي تفرَّسا",35,"س",2,0],["مرجّيك وصابيك","بذا الأضحى يهنيكا",36,"ك",2,1],["مرجًا عهدتك بالربيع يلفُّني","بالقطر يا نبع الهنا يرويني",37,"ن",2,0],["مرجان دمعي لما شام مبسمهُ","رأي العتيق فأجرى دمعه لولو",38,"ل",2,0],["مرجومةُ النظرةِ في لمحها","تابوت أرجاسٍ وأوزارِ",39,"ر",1,0],["مرجع الترب، سواء أثوى","في مضيق، أم هوى في ذي سعه",40,"ع",2,0],["مرج الحمام واهله والذكريات","العابقات وطيبها إدمانُ",41,"ن",1,0],["مرج الحمام وقهوتي ولذاذةٌ","غجريةٌ من بوحها نشوانُ",41,"ن",1,0],["مرّ جنب الهزيع طيفا وأومى","أنْ تعالَ ..فكلنا نُساكُ",42,"ك",1,0],["مرجا من النور آفاقا تضوع سنا","تُبلّغ العطرَ أنّا خيرُ من عشقا",43,"ق",2,0],["مِرْجَلُ الجَدْبِ يَغتَلِي في عُرُوقِي ","ودَمِي قَارِتٌ ودَربِي طَويلُ",44,"ل",1,0],["مرجٍ أَبا ضَرمٍ مُقرٍ أَبا نَغَمٍ","مُغنٍ أَبا رَقَمٍ مُرضٍ أَبا جرَمِ",45,"م",1,0],["مرجع وجامع در لولوه والالماس","برهانه اليا حارت عقول الالباب",46,"ب",1,0],["مَرَجَ الْبِحَاْرِ الْمَاْلِحَاْتِ وَعَذْبِهَاْ","فِي بَرْزَخٍ لا يبغيا بِحِيَادِ",47,"د",1,0],["مُرِج النبض يا (رشيدُ)، افترقنا،","والفُراتُ الأُجاج خَصمان فِيّهْ",48,"ي",2,0],["مَرجٌ مِنَ النَّوَّارِ ضَجَّ كَأَنَّهُ","مِضمارُ عِطرٍ , وَ الأَرِيجُ سِباقُ",49,"ق",1,0],["مرجانٌ في القلبِ","شاءَ حنينًا ورديَّ اللمساتِ",50,"ت",1,1],["مرجف محرق معا لامسيه","بالاشدين صرةٍ ووقود",51,"د",1,0],["مرجعة فوق الغصون حمامها","فنون هدل بين أفنانها الهدل",52,"ل",1,0]]}