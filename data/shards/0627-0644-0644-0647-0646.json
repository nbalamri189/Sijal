{"poems":[[164,"لو كنت تعلم ما بأهل زبيد","https://www.aldiwan.net/poem58886.html","الكامل"],[406,"يا الله","https://www.aldiwan.net/poem10310.html","عموديه"],[447,"يا من له وسط الفؤاد","https://www.aldiwan.net/poem14306.html","مجزوء الكامل"],[447,"هذا الفراق وهكذا التوديع","https://www.aldiwan.net/poem14378.html","الكامل"],[447,"على الشهيد الشريف اللوذعي علي","https://www.aldiwan.net/poem14474.html","البسيط"],[563,"يحبني وأنا المعدوم لم أزل","https://www.aldiwan.net/poem34199.html","البسيط"],[563,"إن الوجود له ذات وأسماء","https://www.aldiwan.net/poem35080.html","البسيط"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18415","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79802","الرجز"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102056","البسيط"],[2198,"","https://poetry.dctabudhabi.ae/diwan/poem/27035","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27497","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27476","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202988","السريع"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70075","البسيط"],[4004,"","https://poetry.dctabudhabi.ae/diwan/poem/111317","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120499","الكامل"],[4791,"ارهابكم مايهز الدين","https://www.poetsgate.com/ViewPoem.aspx?id=36908",""],[4917,"بشرى فقد أحيى البشير نفوسا","https://www.poetsgate.com/ViewPoem.aspx?id=124959",""],[5186,"لكن لي فيها مجال صراحة","https://www.poetsgate.com/ViewPoem.aspx?id=156463",""],[5219,"المشهد العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=194500",""],[5363,"رثاء","https://www.poetsgate.com/ViewPoem.aspx?id=180622",""],[5376,"أشكو السَقَامةَ بالهوى يا شامُ","https://www.poetsgate.com/ViewPoem.aspx?id=188933",""],[5431,"فامسح على الجرح العتيق..","https://www.poetsgate.com/ViewPoem.aspx?id=192280",""],[5431,"وكل قصيدة عتق...","https://www.poetsgate.com/ViewPoem.aspx?id=208652",""],[5684,"عيد","https://www.poetsgate.com/ViewPoem.aspx?id=188300",""],[5818,"من أجل ذلك ....","https://www.poetsgate.com/ViewPoem.aspx?id=181545",""],[5869,"اعذب الألفاظ","https://www.poetsgate.com/ViewPoem.aspx?id=57075",""],[5956,"خلَفٌ أتانا طاهراً مثل السّلفْ","https://www.poetsgate.com/ViewPoem.aspx?id=193487",""],[6106,"ما بين الهجرة والهجمة على سيد الخلق صلى الله عليه","https://www.poetsgate.com/ViewPoem.aspx?id=6303",""],[6352,"قم ناشد الأسلام عن مصابه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22753&r=&rc=14",""]],"verses":[["الله نعم العون ان راعيته","وصبرت جهدك فهو غير بعيد",0,"د",1,0],["الله نورٌ في السموات العُلى","والأرض جلّ سناءه وسناه",1,"ا",2,0],["اللَه نسأله الرضى","ومنال ما نتلمس",2,"س",1,0],["اللَه نسأله رجوعك سالماً","فعن الذنوب إذا رجعت رجوع",3,"ع",1,0],["اللَه نسأله نلقاه في غرف","من الجنان بها ظل من الظلل",4,"ل",1,0],["الله نور السموات استمع خبراً","والأرضِ عن ربِّنا في الذكر منه تُلي",5,"ل",2,0],["الله نور السموات استمعه وعى","والأرض والنور يُمحى فيه ظلماء",6,"ا",2,0],["اللَهُ نَجّاكَ بِكَفّيْ مَسلَمَتْ","مِن بَعدِما وَبَعدِما وَبَعدِمَتْ",7,"ت",1,1],["الله نفسُ أحمدٍ من قد غدا","من نفس كلِّ مؤمنٍ أولى به",8,"ب",2,0],["اللَه نوَّه باسمه وخصصه","بعمره مقسماً في الآي ذي الحكم",9,"م",1,0],["اللَهُ نَجّاكَ مِنَ القَصيمِ","وَبطنِ فَلجٍ وَبَني تَميمِ",10,"م",1,1],["الله نوّر أفلاكاً بأنجمها","ليهتدي في ظلامِ الليلِ في الطرق",11,"ق",1,1],["الله نورٌ تعالى أنْ يماثله","نورٌ وقد لاح لي في نارِ نِبراسِ",12,"س",1,0],["الله نور الأرض نور السما","ما أنا ما العالم لولاه",13,"ا",2,0],["اللَهُ نادى عمانوئيل خادمهُ","يا مَن بِأَمنانِهِ زادَت مَكاسبهُ",14,"ه",1,1],["اللَه ناصبه برغمهم","أتراهم عزلوا ام اعتزلوا",15,"ل",3,0],["الله ناصره فما يقصد ينل","ومن استعان بربه منصور",16,"ر",1,0],["الله نشر عز دينه فوق الآفاقي","وبقدرته يفضح الخوّان لا خانه",17,"ن",2,0],["الله نسأل أن يقيه من الردى","ويقيه أيضاً من دهى أبليسا",18,"س",2,0],["الله ناصرها متى هي عدت","الأعمال لا الأقوال من أنصارها",19,"ر",3,0],["الله نادى - وجل الله منزلة -","سمعا وطوعا لرب العرش داعينا",20,"ن",2,0],["الله نصّبه دليلا للسبيل","المستقيم ومعلماً ما قُوّضا",21,"ض",2,0],["الله نسألُ لا نسائلُ غيرَه","بزغ الصباحُ وديننا الإسلامُ",22,"م",1,0],["الله نورٌ لايضيء بجاهلٍ","والوحي دربك كي تراه وتسمعه",23,"ع",2,0],["الله نور الكون فاض بنا","ولنا على مشكاته دلقُ",24,"ق",1,0],["اللهَ نسأل نصرا ملء أمّتنا","حتى يفوح الشذا والروحَ يختلج",25,"ج",1,0],["اللهُ نورٌ والمسالكُ خيرةٌ","لولا الضيا لَمْ يُبدِعِ الألوانا",26,"ن",2,0],["اللهُ نُورٌ سَمَاويٌّ يُهَيِّجُ مِنْ","لَوَاعِجِ الأَنْفُسِ العَطْشَى وَيُذْكِيهَا",27,"ي",3,0],["الله نوّر صدركم وصدورنا","بتراحمٍ سامٍ به الهادي عُرِفْ",28,"ف",1,0],["الله ناصره ومظهِر دينه","ومؤيدٌ بالعون والأجناد",29,"د",1,0],["الله نفس أحمد من قد غدا","من نفص كل مؤمن \"أولى به\"",30,"ب",2,0]]}