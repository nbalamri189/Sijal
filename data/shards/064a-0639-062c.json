om/modules.php?name=Sh3er&doWhat=shqas&qid=60144&r=&rc=200",""]],"verses":[["يُعجِبُني كُلُّ حازِمِ الرَأيِ لا","يَطمَعُ في قَرعِ سِنِّهِ النَدَمُ",0,"م",1,0],["يُعجِبُني مَطلُ غَريمِ الهَوى","لِطولِ تَردادي إِلى الماطِلِ",1,"ل",1,0],["يَعجَبُ مِن عُجبي بِهِ في الهَوى","وا عَجَبي مِنهُ وَمِن عُجبي",2,"ب",2,0],["يَعجِمُ مِن عيدانِنا صِلابا","صَعباً يُلاقي أَنفُساً صِعابا",3,"ب",2,0],["يُعجِزُ الوَهمَ عَن تَلَمُّسِ ذاكَ ال","بابِ بابِ الخَليفَةِ المَنكودِ",4,"د",1,0],["يعجل غايةَ ما يرتجى","ويحلمُ ساعةَ ما يقدِر",5,"ر",1,0],["يعجَبُ منه ومن تلوُّنِهِ","وكيف يقفو نوالَه حَرَبُهْ",6,"ب",2,0],["يعجبُك الفحلُ في تراجعه","على عِجان الفتاةِ بالسَّحر",7,"ر",1,0],["يُعجِلُ من أنْحى عليه المِنهسا","من أن يُرَجّي البرء أو أن يَيْأسا",8,"س",2,0],["يعجزُ العقلُ من ذوي العقل عمّا","يتأتَّى لغيرهمْ بالكلام",9,"م",1,0],["يُعجبان الكريمَ جداً وليسا","من شؤون الهلباجة المِبْطان",10,"ن",1,0],["يَعِجُّ الماءَ تَحتَ مُسَخَّراتٍ","يَصُكُّ القارَ وَالخَشَبَ الصِلابا",11,"ب",2,0],["يُعجِزُني إِدراكُ ما أَدرَكوا","كَأَنَّ عَقلي فَحمَةٌ أَو رَماد",12,"د",1,0],["يعجبني من الهزا","ر الشدو والترنم",13,"م",1,0],["يُعجِزُ القُصّاصَ إِلّا قَلَما","في سَوادٍ مِن هَوىً لَم يُغمَسِ",14,"س",1,0],["يُعجِبُها قَتلُها الكُماةُ وَلا","يُنظِرُها الدَهرُ بَعدَ قَتلاها",15,"ا",3,0],["يُعجِبُنِي أنهمْ إِذا كَثُروا","قَلُّوا غَناءً وإِنْ هم كَثروا",16,"ر",3,0],["يَعجَزُ الشِعرُ عَن مُجازاةِ خِرقٍ","أَريَحِيٍّ إِذا اِجتَدَيناهُ أَجدى",17,"د",2,0],["يُعجِبُني في الخَليلِ تَكريرُهُ النَف","عَ وَخَيرُ الخُلّانِ مَن نَفَعَك",18,"ك",1,0],["يُعجِلُ المَوعِدَ أَو يَسبِقُهُ","نائِلٌ لَو سابَقَ السَيفَ سَبَق",19,"ق",1,0],["يُعَجِّلنَ يَرهَصنَ البُطونَ إِلَيكُمُ","بِأَعجازِ قِعدانِ الوِطابِ الرَواسِمِ",20,"م",1,0],["يُعْجِبُها وَقْعُ خَرابِ البَرْيَرِ","وهْيَ مُعَنَّاةٌ بكلِّ أسمَرِ",21,"ر",1,0],["يَعجِّلُ تَخليصَ النُفوسِ مِنَ الأَذى","وَيُدني مِنَ الدارِ التَّي هيَ أَشرَفُ",22,"ف",1,0],["يُعجِبُني حالي وَأَيُّ حالِ","يَبقى عَلى الأَيّامِ وَاللَيالي",23,"ل",2,0],["يَعجَبُ مِن تَعَجُّبي وَبُخلِهِ","يَلحَظُني في جَدِّهِ وَهَزلِهِ",24,"ل",2,0],["يَعجَبنَ مِنّي أَن سَمَحتُ بِمُهجَتي","وَكَذاكَ أَعجَبُ مِن سَماحَةِ جَعفَرِ",25,"ر",1,0],["يعجبني وفاةُ مَنْ","فيهِ فسادٌ وأذى",26,"ذ",2,1],["يعجُّ ويُبدي أنَّةً وتحرُّقاً","على أهلِهِ حتى يلينَ لهُ الحجرْ",27,"ر",1,0],["يَعجِزُ المِطرَفُ العُشاريُّ عَنها","وَالإِزارُ السَديسُ ذو الصِنفاتِ",28,"ت",1,1],["يُعجِلُها في مائِها إِن رَسَخا","حَكَّمَ فيها مِنسَراً مُضَمَّخا",29,"خ",2,0],["يعجبني الأمردُ الطريرُ إذا","أبصرتهُ أهيفاً لهُ كفَل",30,"ل",1,0],["يعجبُ منا كلُّ ما حولنا","أما سئِمنا بعد طولِ انتظارْ",31,"ر",1,0],["يَعجبنَ من فعل الشرابِ بهم","ويَلذْنَ من سأمٍ بإغفاءِ",32,"ا",2,0],["يُعْجِزُ الفِكْرَ مَا يُريدُ الفُؤَادُ","فِيكَ يَا خيْرَ مَنْ بِمَدْحٍ يرَادُ",33,"د",1,1],["يَعجزُ الناسُ كلُّهم أن ينالوا","بالأذى -وهو طَبعُهُم- فنَّانا",34,"ن",2,0],["يعجون بالتحكيم لله وحده","وهامهم تحت العجاج تطير",35,"ر",1,0],["يَعْجِزُ الشّعْرُ عنْ مجاداةِ خِرْقِ،","أرْيَحيّ، إذا اجْتدَيْنَاهُ أجْدَى",36,"د",2,0],["يعجز بيتُ المال عن إشباعها","من الغراميل وعن إرضاعها",37,"ع",3,0],["يعجبُ السامِعُ من وصفي لها","ووراء العجزِ ما لَم أَصِفِ",38,"ف",1,0],["يعجبني المرء ذو الحزامة والفهم","ومن لا يغره الوهم",39,"م",1,0],["يعجزُ الواصفونَ أن يصفُوها","بصفاتٍ لم يبلغُوا مُنْتهاهَا",40,"ا",3,0],["يعجزُ الواصفونَ أن يصفره","بصفاتٍ تجلٌّ عنهم صفاتُه",41,"ت",2,0],["يعجب على المالِ المسلوب","أزاي ما يرجعْ بالتاني",42,"ي",1,0],["يعجبني الرشق بالحاظها","وإن غدت أمضى من الشفرة",43,"ه",1,0],["يُعجِز في الوصفِ ذوى الأَلْباب","مع التَّغالي فيه والإطْناب",44,"ب",1,0],["يُعْجِب الإنسانَ مَكْسبُه","وهْو بابُ الهمِّ والأَسف",45,"ف",1,0],["يُعجبنِي البُخْلُ إِن بِخِلتِ ولا","يُعجِبُني الجودُ مِنكِ والنَّفَلُ",46,"ل",1,0],["يُعجِبُهُ التِبنُ وَالشَعيرُ ال","مَغسولُ وَالقَتُّ وَالقَصيلُ",47,"ل",1,0],["يُعجِبُهُم مِنّي إِذا جِئتُهُم","ما يُعجِبُ الأَكرادَ مِن جَعفَرِ",48,"ر",1,0],["يُعجِبُهُ الطيبُ وَهوَ ذو كَلَفٍ","بِحُبِّهِ جَدُّ مُغرَمٍ لَهِجِ",49,"ج",1,0],["يعجَبُ السامعون في الصَّوم لما","قُمتُ أجلو منها عليهم مُداماً",50,"م",2,0],["يعجبني الشيءُ فأَختارُهُ","لهُ بجهدٍ علمَ اللهُ",51,"ه",1,0],["يعجز البرق شأوه ومن","العجز عليه تظاهر الخفقان",52,"ن",1,0],["يَعجَبُ مِن بَلبالِهِ في الهَوى ال","مَجنونِ مَجنونُ بَني عامِرِ",53,"ر",1,0],["يَعجبُ من غير عَجَب","يَغضبُ من غير غَضَب",54,"ب",1,0],["يعجب المعجون ساعَةَ أَلقاه","بِمَديح سَما بِهِ فَاِستَطالا",55,"ل",2,0],["يُعجبُها أن تَرتَدي حُسنَه","والحسنُ قَد يَردَى به المُرتَدي",56,"د",2,0],["يُعجبُكَ البَحرُ وأمواجُهُ","واللَّيلُ والخلوةُ في اللَّيلِ",57,"ل",1,1],["يعجُزُ الإسهابَ ما يب","لُغُ فيها الاختِصارُ",58,"ر",1,0],["يعجز القائلون عن مثلها حق","قا ولو أصبح الورى شعراء",59,"ا",2,0],["يُعجبُك اليومَ صديقا وغداً","ما عاش في الدهر أخاً خَدينا",60,"ن",2,0],["يعجَبُ للجهل كيف راخَى لأق","وامٍ ودانَى من خطوه الحزمُ",61,"م",1,0],["يُعجِبُه اسمٌ ليس من ورائهِ","معنىً إذا ما هو بالعليا وُسِمْ",62,"م",1,0],["يعجُّ النديُّ خصاماً فإن","نطقتَ أرمَّ لك المحفِلُ",63,"ل",1,0],["يعجَزُ الصارمُ عن تبليغها","ما تقولُ الكتب فيها والرسُلْ",64,"ل",1,0],["يعجبني تسلُّطٌ فيها إذا","قامت تعاطي من علاكم ما تصِفْ",65,"ف",1,0],["يعجَبُ من جهالةِ الأيّام في","وِجدانه ما لم يكن لينشُدا",66,"د",2,0],["يُعجبُه قربي لغير حاجةٍ","فإن عرَتْ طارَ مع البعادِ",67,"د",1,0],["يَعجُمُ منه الدهرُ إن رابهُ","جَلْدَ العصا صُلبَ حصاةِ الفؤادْ",68,"د",1,0],["يُعجِبُ قلبي مطلُها لطول ما","يكُرُّ بي المطلُ إليها ويَرُدْ",69,"د",1,0],["يُعجزُ في مدحه وقد علمتْ","توحُّدي في الفصاحةِ العربُ",70,"ب",1,1],["يعجبني المقصورُ من عشيّها","والسابغُ الممدود من ظلالها",71,"ل",3,0],["يعجب والليلُ مديد الخطى","من اعتلاقي بذيول الخيال",72,"ل",1,0],["يعجبني في طبِ أجفانها","برءُ ذوي السّقم وسقم الصّحاح",73,"ح",1,0],["يُعَجِّلُ لِلقَومِ الشِواءَ يَجُرُّهُ","بِأَقصى عَصاهُ مُنضِجاً وَمُرَمِّدا",74,"د",2,0],["يعجُّ براجٍ نيلَه وبمُختَشٍ","جَنَى إذ لهم مِنه وَعيدُه والوَعدُ",75,"د",1,0],["يعُجُّ القنا بالطّعنِ في ثغَراتها","عجيجَ المطايا جُنَّحاً للمباركِ",76,"ك",1,0],["يُعجَبُ الناسُ أنه أَفْضلُ النا","سِ عُلاً وهو غيرُ ذي إعْجابِ",77,"ب",1,0],["يُعَجِّلُ مِنْ تكذيبِه مِنْه خَجْلَةٌ","سيعقُبها عَمَّا قَلِيلِ عِقَابُه",78,"ب",2,0],["يَعجِزُ المِطرَفُ السُباعِيُّ عَنها","وَالإِزارُ المُفَوَّفُ المِلفاقُ",79,"ق",1,0],["يعجب الناظر منها","من قريب وبعيد",80,"د",1,0],["يُعجِبُهُ نَماءُ ما يملِكُهُ","وهو بنقصانِ الحياةِ ما نَمَى",81,"ا",1,0],["يُعجِبُهُ المَردُ فَيَحكيهُمُ","حِكايَةَ زُوَرٍ مِنَ الزُوَرِ",82,"ر",1,0],["يُعْجِبُهُ السُخُونُ وَالبُرُودْ","وَالقَزُّ حُبّاً ما لَهُ مَزِيدْ",83,"د",1,0],["يُعَجِّلُ لي مِنْ قَصْدِهِ كلَّ بَدرةٍ","أُعاجِلُ قُصَّادي بِها وأُبادِرُ",84,"ر",1,0],["يعجل المتقى ويبقى سليباً","من توالى طعانه وضرابه",85,"ب",2,0],["يُعَجّل لِلأَضيافِ وَاري سَديفها","وَمَن يَأتِها مِن سائِرِ النّاسِ يَشبَعِ",86,"ع",1,0],["يعجز الجيش عن مهم وكم فض","فض ذو نهية صدور الهوادي",87,"د",2,0],["يعجز عن درك وصفه وَعُلى","هِمَّتِهِ مُطنِبٌ ومختصِر",88,"ر",1,0],["يعجز الدهر أن يجود بثان","من زعيم كزايد السلطان",89,"ن",1,1],["يعجزُ النسر وصلَهُنَّ إذا طا","رَ وينهلُّ دونهُنَّ الصبيرُ",90,"ر",1,0],["يعجز الشعر لعمري عن ثنا","فضلكم مهما علا الشعر انتظاما",91,"م",2,0],["يُعجِبُني نَموذَجٌ","منها وشكلٌ حَسَنُ",92,"ن",1,0],["يعجز العد عن مناقب نفس","ذو المعالي لاجله سواها",93,"ا",3,0],["يَعجبكَ الأَصفر مِن لَونِهِ","كَأَنَّما مِن ذَهَب فاقعه",94,"ع",2,0],["يعجب منك الكرام أعجب ما","يدعو به الله عاقل فتنه",95,"ن",2,0],["يعجم اللفظ باندماجة نطق","لغط ورقاء طارحت ورقاء",96,"ا",2,0],["يعجزُ عَنْ حَمْل تبنه فإذا لا","رأى شنيفاً حَسَاهُ في نَفَس",97,"س",1,0],["يَعْجَبُ الصّبْرُ من تَصَبّرِ قلبي","واحتمالي ما رَمَقَته العيونُ",98,"ن",1,0],["يعجب اذ يراهم يراهُم النّظارُ","من عالم الجنّ بهم آثارُ",99,"ر",1,0],["يعجبني شربى بالدور على","تسلسل الماء ببطن الجدول",100,"ل",1,1],["يعجبني خال وجنتيه","الميسك في الجلنار أعجب",101,"ب",1,0],["يعجب الناس ويزهون بما","فيه بعض النفع فيما يصفون",102,"ن",1,0],["يعجبني وجودٌ ذو دليلِ","وليس له وجودٌ في السبيلِ",103,"ل",1,1],["يَعجَلُونَ التَّنظِيفَ في تُرَعِ ال","فُلكِ وجَرِّ الأركَانِ عَنها عُبُورا",104,"ر",2,0],["يَعجَز المَوتُ أَن يُحَطِّمَ نَفساً","مالَها في الحَياةِ مِن نُظَراءِ",105,"ا",2,0],["يُعجبُهُ من غيرهِ دَعوةٌ","حتَّى يراها أبداً في المنامِ",106,"م",1,0],["يَعجَزُ الصَّمتُ عَن