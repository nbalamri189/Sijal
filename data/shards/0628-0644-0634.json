tps://www.poetsgate.com/ViewPoem.aspx?id=124438",""],[5136,"هذا المحرم قادما مسروراً","https://www.poetsgate.com/ViewPoem.aspx?id=121575",""],[5431,"أقصى التوله...","https://www.poetsgate.com/ViewPoem.aspx?id=198351",""],[5582,"قَدْكَ يا عاذِلُ تُبْدِي اللَّوْمَ قَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=186907",""],[5689,"ترى يطب بي شعبي رجوعي لغيله","https://www.poetsgate.com/ViewPoem.aspx?id=143430",""],[5785,"متى متى يا قرة النواظر","https://www.poetsgate.com/ViewPoem.aspx?id=131564",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[5956,"سأكون دون إقامة وأبورُ","https://www.poetsgate.com/ViewPoem.aspx?id=204590",""]],"verses":[["بل شادن ذو نعمةٍ في نعمةٍ","يكتنُّ منها في أكنِّ كناس",0,"س",1,0],["بل شهوة الجرذان من سُوسها","مُركَّبٌ ذلك في الطينه",1,"ن",2,0],["بل شهد التمثيلا","ثم انثنى بخيلا",2,"ل",2,0],["بل شِسْعُ نَعلِكَ عَدنانٌ وما ولدتْ","بل أنتَ وحدك عندي كلُّ إنسيّ",3,"ي",1,0],["بل شعرك الزهر في روق الرَبيع بدا","فطلُّهُ عند غيدان الصباح ندى",4,"د",2,0],["بل شامةٌ والشام جنة الثرى","ترفّ فردوساً وتجري كوثرا",5,"ر",2,0],["بَلْ شَاءَ رَبُّكَ أَنْ تَفُوزَ بِقُرْبِهِ","عَجِلاً وَأَخْطَأ قَوْمَكَ التَّوْفِيقُ",6,"ق",1,0],["بَلْ شَفَقاً لألاؤُه نَاصِعٌ","يُرَى خِلاَلَ الدَّمْعِ شِبْهَ المَشُوبْ",7,"ب",1,0],["بَل شِئتُ إِعلامَ مَن تَندى بِمَسأَلَةٍ","يَداهُ أَنَّ نَداكَ الغَمرَ يَقتَضِبُ",8,"ب",1,0],["بل شيعة الرحمن ألقى حبهم","في خلقه فسموا بذاك وفضلوا",9,"ل",3,0],["بَل شَيَّبَتني حادِثاتٌ أَخرجَت","آلَ النَبِيِّ الأَبطَحِيِّ شِدادُ",10,"د",1,0],["بل شاء أن لا يقتلوه لو درى","قطعاً بأن سيوفهم تعلوه",11,"و",2,0],["بل شموس هزأت بالخنس","فكره جنة علم ازهرت",12,"ت",1,0],["بل شوهت بالداء غصنك ناضرا","وبعيد شدته عراه همود",13,"د",1,0],["بل شهاب في الدجى ملتهب","قد سقانيها أغن ربرب",14,"ب",1,0],["بَل شُغلُهُ في زادِهِ لِمَعادِهِ","فَالزادُ آكَدُ شُغلِ كُلِّ مُسافِرِ",15,"ر",1,0],["بل شرُّ منهُ قرينٌ ساءَه صَلفٌ","اكراهُ بعلتهِ خلّاه أيوسا",16,"س",2,0],["بل شاقني حب من فرض محبته","بحر العلوم الذي قد فاق اعصرها",17,"ر",3,0],["بل شُمُوساً من الحَيَا في خُدُورٍ","مِنكِ قُولي متى يَكُونُ نَجَاحي",18,"ح",2,0],["بل شاكراً لنواله وعطائه","وأنا الفقير المحض من غير امترا",19,"ر",2,0],["بل شامة الدنيا وعين الملكِ","وتعرف الدينار عند السبك",20,"ك",1,0],["بل شِفاءُ الحُبِّ وَصلٌ عاجِلٌ","وَاعتِناقٌ وَاجتماعٌ مُستَلَذ",21,"ذ",1,0],["بل شأنه الأسفار طول العمر","هلم فوق ظهرها بالجد",22,"د",1,0],["بَل شَدِّدوا بَعضُكُم بَعضاً وَلا تَهِنوا","لَعَلَّ زَفسَ مُنيلُ النَصرِ وَوالفَرَجِ",23,"ج",1,0],["بل شموس الإنس إذ ترخي سحوف","من شعورٍ مسدلاتٍ كالنقاب",24,"ب",1,0],["بل شدة الحر ولو في أبرد ال","بلدان يكفي من أقام ومن سهج",25,"ج",1,0],["بَلْ شَعْرُهَا .. بَلْ خَدُّهَا .. بَلْ جِيدُها","لَا بَلْ فَمٌ فاحَ الشذَى فوْحَ الزَهَرْ",26,"ر",1,0],["بل شمسُ صحوٍ مضيئةٌ ومن عجبٍ","أن ليسَ يكسفُ غيرُ الشانئ القَزَمِ",27,"م",1,0],["بل شرعة الإسلام قام عمودها","من بعد أن كادت تروم دثورا",28,"ر",2,0],["بل شهقة الوصل ماتُرضي تولهنا","في منطق العشق في عِرْف المجانين",29,"ن",1,0],["بَلْ شَجانِي زَمَنٌ حادِثُهُ","فِي الحَشا يُسْعِرُ جَمْراً مُتَّقِدْ",30,"د",1,0],["بل شعبي قد بات ينكر من أنا","كأن لم يته يوما فخارا بنجله",31,"ل",2,0],["بل شا أقول يا عالم الضماير","ويا شديد البطش خير مكّار",32,"ر",1,0],["بل شاغلتنا في الحياة طوارئ","يصطك تحت عبابها الجلمود",33,"د",1,0],["بل شئتُ توديعاً لكم ومدامعي","تجري هوىً لبلادكم وتَفورُ",34,"ر",1,0]]}