{"poems":[[91,"اغتنم كل فرصة في الحياة","https://www.aldiwan.net/poem44633.html","الخفيف"],[580,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120027","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202588","الكامل"],[2971,"","https://poetry.dctabudhabi.ae/diwan/poem/199872","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54497","الخفيف"],[4978,"تشطير أغنية حب","https://www.poetsgate.com/ViewPoem.aspx?id=177264",""],[5198,"بيت القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=136097",""],[5542,"نفحة من بستان الوحي","https://www.poetsgate.com/ViewPoem.aspx?id=10057",""],[5956,"يا مُحْدِثاً أقوى اختراق","https://www.poetsgate.com/ViewPoem.aspx?id=194556",""],[6237,"سوزان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77873&r=&rc=15",""]],"verses":[["انت اجزاء من عناصر شتى","ما لها من جمع وراء الشتات",0,"ت",1,0],["أَنتَ أَجْرُ الشَّهِيدِ حُسْناً فكُنْ","أَجْرِي فإِنِّي بِنَاظِرَيْكَ شَهِيدُ",1,"د",1,0],["أنت أجرى الأنام كفا إذا","سيل وأرعاهم لحق الجارِ",2,"ر",1,0],["انتاجه الأولادَ غاية همّه","استاذهم طرُقٌ وذوق ميّت",3,"ت",1,0],["أَنْتَ أَجْرَيْتَ دَمْعَ عَيْنِيَ بِالْهجْ","رِ وَعَلَّمْتَنِي لِحاظَ المُرِيِبِ",4,"ب",1,0],["أَنتَ أَجريتَ نيلَ مصر إلى الشّا","مِ نَوالاً أَم سالَ نيلٌ ثاني",5,"ن",2,0],["( أنت اجتماع مكاني والزمان معاً )","ما أَجمَل العِيد... فِي أَعْطَافِ مَغنَاكِ",6,"ك",1,0],["انت اجمل اوراق عمري وانت بيت القصيد","وانت الضنين الذي م ارضى بداله ضنين",7,"ن",1,0],["أنتَ أََجْرَيْتَ ها هنا نهرَ خيرٍ","وجزاء الرحمن خيرُ الجَزاءِ",8,"ا",2,0],["إنتاجكم خيرٌ بخيرٍ وفق مَنهج عاقل ومثابرِ","درّبْ سواك غداً تشيخ تصير لستَ بقادرِ",9,"ر",1,0],["أنتِ أجل أنتِ ولولاك لم","ينبجس الشاعر عن موهبهْ",10,"ب",2,0]]}