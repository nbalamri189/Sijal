,"الكامل"],[465,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[496,"لا يغرنك الذي أنا فيه من الطلب","https://www.aldiwan.net/poem9764.html","مجزوء الخفيف"],[496,"قسما لقد عجم الزمان","https://www.aldiwan.net/poem9819.html","مجزوء الكامل"],[501,"آه من نار فؤآده لم يزل","https://www.aldiwan.net/poem37673.html","الرمل"],[501,"ما بين جرعاء اليلملم والعلم","https://www.aldiwan.net/poem37799.html","الكامل"],[501,"طار نحو الحبيب شحرور قلبي","https://www.aldiwan.net/poem37945.html","الخفيف"],[501,"ما بال قوم ترى للغير مقدرة","https://www.aldiwan.net/poem38007.html","البسيط"],[501,"أي راح دارت به الأقداح","https://www.aldiwan.net/poem38045.html","الخفيف"],[516,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[516,"لو اطلعت على سري وإضماري","https://www.aldiwan.net/poem12126.html","البسيط"],[516,"شأن الغرام أجل أن يلحاني","https://www.aldiwan.net/poem12277.html","الكامل"],[539,"سجنت نفسي بيدي","https://www.aldiwan.net/poem47500.html","عموديه"],[559,"نحن المراتب بالوجود مرتبه","https://www.aldiwan.net/poem33526.html","الكامل"],[559,"إن الحروف إشارات المداد فلا","https://www.aldiwan.net/poem33579.html","البسيط"],[559,"إياك تشهد غيره ودع العنا","https://www.aldiwan.net/poem33787.html","الكامل"],[559,"خذها إليك لها هدى وبيان","https://www.aldiwan.net/poem33803.html","الكامل"],[559,"إن الوجود الواحد ال","https://www.aldiwan.net/poem33875.html","مجزوء الكامل"],[559,"يحبني وأنا المعدوم لم أزل","https://www.aldiwan.net/poem34199.html","البسيط"],[559,"إن الوجود حقيقة لا تدرك","https://www.aldiwan.net/poem34285.html","الكامل"],[559,"هل تعرفون العدم الصرفا","https://www.aldiwan.net/poem34346.html","السريع"],[559,"إن الوجود الحق بي يتلفظ","https://www.aldiwan.net/poem34399.html","الكامل"],[559,"لا تمش معه كما ترى","https://www.aldiwan.net/poem34486.html","مجزوء الكامل"],[559,"غلب الهوى واستحوذ استحواذا","https://www.aldiwan.net/poem34561.html","الكامل"],[559,"إن السيادة والريا","https://www.aldiwan.net/poem34634.html","مجزوء الكامل"],[559,"إن الوجود الحق شيء واحد","https://www.aldiwan.net/poem34654.html","الكامل"],[559,"إن الوجود بموجوداته امتزجا","https://www.aldiwan.net/poem34689.html","البسيط"],[559,"إن الوجود له ذات وأسماء","https://www.aldiwan.net/poem35080.html","البسيط"],[559,"ظهر الوجود بسائر الأشياء","https://www.aldiwan.net/poem35085.html","الكامل"],[565,"عنوان مجدك ظاهر وضاح","https://www.aldiwan.net/poem833.html",""],[576,"هو بغاء وعرسه بغاءه","https://www.aldiwan.net/poem2793.html","الخفيف"]],"verses":[["إِنَّ الوَزيرَ وَإِن تَطَرَّقَهُ الرَدى","وَعَدا عَليهِ مِنَ الخُطوبِ ذَميمُها",0,"م",3,0],["أَنا لَولاكَ ما ظَفِر","تُ بِقَلبٍ مُصادِقِ",1,"ق",1,0],["إِنَّ الوَفاءَ كَما اِقتَرَحتُ فَلَو يَكُن","حَيّاً إِذا ما كُنتُ بِالمُزدادِ",2,"د",1,0],["أَنا لَولا أَنَّ لي مِن أُمَّتي","خاذِلاً ما بِتُّ أَشكو النُوَبا",3,"ب",2,0],["أَنا لَو طُوِّقتُ مِنهُ بَدَلاً","أَنجُمَ الجَوزاءَ لَم أَرضَ البَدَل",4,"ل",1,0],["إِنَّ الوَفَاءَ سَجِيَّةٌ لَمْ يُؤْتِهَا","إِلاَّ رِجَالُ الرَّأْيِ وَالإِقْدَامِ",5,"م",1,0],["إِنَّ الوُشَاةَ إِذَا أَتَو","كِ تَنَصحُوا ونَهَوكِ عَن",6,"ن",1,0],["أنا لولا فيض دمعي السَكِب","لتَحرّقت بنار الأسف",7,"ف",1,0],["إن الوجوه صحائف مطموسة","يمحو كتابتها ويثبتها الدم",8,"م",1,0],["إِنَّ الوِبارَ الَّتي في الغارِ مِن سَبَأٍ","لَن تَستَطيعَ عَرينَ المُخدِرِ العادي",9,"د",2,0],["إِنَّ الوَليدَ خَليفَةٌ لِخَليفَةٍ","رَفَعَ البِناءَ عَلى البِناءِ الأَعظَمِ",10,"م",1,0],["إِنَّ الوَليدَ هُوَ الإِمامُ المُصطَفى","بِالنَصرِ هُزَّ لِواؤُهُ وَالمَغنَمِ",10,"م",1,0],["إنَّ الوزير أدام الله نعمته","أزال بالعدلِ عنَّا الفقر والبؤسا",11,"س",2,1],["إنَّ الوليدَ لمغوارٌ إذا نَكَلتْ","نفسُ الجبان بعيدُ الهمِّ والسُرَبِ",12,"ب",1,0],["إن الوزارة لم تزل وبها","شوق إليك يُرى تنزُّعه",13,"ع",2,0],["إن الوزيرَ غدا وَصّالَ قاطِعِه","فاعمدْ إليه ودعْ قطّاع واصلِهِ",14,"ل",2,0],["أنالَ وقلتُ يُعطيني وأثنَى","فما جاريتُهُ حتى شآني",15,"ن",2,0],["إن الوزيرَ إذا تَأَمَّلَ ناظرٌ","لَعَتادُ مُحتاطٍ وتاجُ مُباه",16,"ه",1,0],["إِنَّ الوَليدَ أَمينَ اللَهِ أَنقَذَني","وَكانَ حِصناً إِلى مَنجاتِهِ هَرَبي",17,"ب",2,0],["أَنا لَو يَعلَمُ أَهلي دُرَّةٌ","ظُلِمَت في البَيعِ كَالمُخَشلَبِ",18,"ب",1,0],["أَنا لَو رَأَيتُ بِكَ القَذى مَحضَ القَذى","لَسَتَرتُ وَجهي عَنكَ مِثلُ صِحابي",19,"ب",2,0],["أَنا لَولا الشُعورُ لَم أَتَأَلَّم","لَيتَ الفُؤادَ كانَ جَمادا",20,"ا",1,0],["انا لو لا شيخوختي ثم دائي","كل يوم نظمت فيهم قصيدا",21,"د",2,0],["انا لو كنت عند قبرك طأطأ","ت له الرأس خاشعا والجبينا",22,"ن",2,0],["ان الوجود الذي حفّ الفضاء به","في واسع اللا تناهى منه ممدود",23,"د",1,0],["انا لو كنت املك اليوم حر","رية نفسي اذعت ما لن يذاعا",24,"ع",2,0],["أنا لولا الرحمن والعفو منه","داخل في الجحيم بعد المعاد",25,"د",1,1],["أنا لولا خوفي من الناس أن يع","زوا كلامي للكفر والإلحاد",26,"د",1,0],["أنا لو بيع بفلس","لم يجد سوقا جرابي",27,"ي",1,0],["أَنا لَولا العِظامُ وَهيَ حَياتي","لَم تَطلُب لي مَعَ اِبنِ آدَمَ حالُ",28,"ل",1,0],["أَنا لَو أَطَعتُ القَلبَ في","هِ لَم أَزِدهِ عَلى جَواهُ",29,"ا",2,0],["أَنا لَو نادَيتُهُ في ذِلَّةٍ","هِيَ ذي روحي فَخُذها ما اِحتَفى",30,"ف",2,0],["إِنَّ الوُشاةَ وَإِن لَم أَحصِهِم عَدَدا","تَعَلَّموا الكَيدَ مِن عَينَيكَ وَالفَنَدا",31,"د",2,1],["أَنا لَو نِلتُ الَّذي قَد نالَهُ","ما هَبَطتُ الأَرضَ أَرضاها مُقاما",32,"م",2,0],["أَنالوا المُلكَ فَتحاً أَيَّ فَتحٍ","وَشادوا لِلخِلافَةِ أَيَّ صَرحِ",33,"ح",1,0],["أَنَّ الوَفاءَ كَعَهدِهِ لَم يُنتَقَض","وَالشُكرَ وافِيَةٌ لَهُ أَقسامُهُ",34,"م",2,0],["إِنَّ الوَليدَ وَلِيُّ عَهدِ مُحَمَّدٍ","كُلَّ المَكارِمِ بِالمَكارِمِ يَشتَري",35,"ر",2,0],["إِنَّ الوَليدَ أَبا العَبّاسِ أَورَثَهُ","مِنَ المَكارِمِ مِنها الرُجَّحُ الكُبَرا",36,"ر",2,0],["إنَّ الوزيرَ دَعا إلى غَمرِ النَّدى","من كان موقوفاً على أوشالِه",37,"ل",2,0],["إنَّ الوَداعَ وإن سَعِدْتُ بِه","لَيَزيدُ كامنَ لوعتي حَرَّا",38,"ر",2,0],["إنَّ الوعيدَ ثَناه عن آرائِه","حتى تجنَّبَ مُونِقَ الآدابِ",39,"ب",1,0],["إِنَّ الوِلايَةَ ثَوبٌ قَد خُصِصتَ بِهِ","جاءَت كَفافاً فَلَم تَفضَل وَلَم تَعُزِ",40,"ز",1,0],["إِنَّ الْوَقِيعَةَ لا تَعُودُ بِخِزْيَةٍ","أَوْ سُبَّةٍ إِلَّا عَلَى مَنْ قَالَهَا",41,"ه",2,0],["أنا لو تركتُ القريضَ تهتكَتْ","أستارُهُ وغدا كلمعِ سرابِ",42,"ب",1,0],["أنا لولا هواكِ صنتُ دموعي","صونَ دينِ الوزيرِ عنْ محظورِ",43,"ر",1,0],["أنا لو كنتُ حازماً في هواها","حزمَهُ في الحروبِ جادَتْ أموري",43,"ر",2,0],["أنا لولا خشيةِ اللَّ","هِ لأَنْفقْتُ نضاري",44,"ي",1,1],["إنَّ الوبا قدْ غلبا","وقدْ بدا في حلبا",45,"ب",2,1],["أنا لو كنتُ مُقِلاًّ","ما اصطلى الناسُ بناري",46,"ي",1,1],["إِنَّ الوُشاةَ كَثيراً إِن أَطَعتِهِمُ","لا يَرقُبونَ بِنا إِلّا وَلا ذِمَما",47,"م",2,0],["إنّ الوليمةَ أخزى اللّهُ صانِعَها","كانت ضِراراً فلا وُدٌّ ولا لَطَفُ",48,"ف",1,0],["أنا لولا نَوالُهُ آنِفاً لمْ","يَكْ لي من شكايةِ الدهرِ مُشك",49,"ك",1,0],["إِنَّ الوَقارَ وَما تَرى بِمَفارِقي","صَرَفَ الغِوَايَةَ فَاِنصَرَفتُ كَريما",50,"م",2,0],["إِنَّ الوَداعَ مِنَ الأَحبابِ نافِلَةٌ","لِلظاعِنينَ إِذا ما يَمَّموا بَلَدا",51,"د",2,1],["أنا لو كنت مختاراً","لما جئت إلى الدنيا",52,"ي",2,1],["أنا لو كنت بالبعير أضحي","سار بي مرقلاً عليه البعير",53,"ر",1,0],["إن الوَلي قضى بالرَغم عَن أَملي","وَما قَضى منه ذاك المجد وَالشَرف",54,"ف",1,0],["أنا لو كنت بليدا","فاز بالأسهم سهمي",55,"ي",1,1],["إن الوفاء بضاعة كسدَت","ومآل صاحبها لإملاق",56,"ق",1,0],["إنَّ الوُجودَ الرَّحْبَ","والغَاباتِ والأُفقَ الخَضيبْ",57,"ب",1,0],["أنا لو كنتُ يا سُليمى نسيما","لَقَطَعتُ السرى وجبُبتُ السهولا",58,"ل",2,1],["أنا لو ذكرت ذكرت أح","لامي وأنغامي وكوبي",59,"ب",2,0],["إن الوكيلَ لِسَانُه سيكون في","أيدي زبانية الجحيم زِمَاما",60,"م",2,0],["أنا لو أنصفني المرء لما","كنت إلا مغزلاً في معمل",61,"ل",1,0],["أنا لو خيرت لاخترت الخفا","ورجوعي للخمول الأول",61,"ل",1,0],["أنا لو خيرت لاخترت البقا","في يد الآسي وعلم الصيدلي",61,"ل",2,0],["إنَّ الوساوِسَ إنْ رامَتْ مَسارِبَها","سَدَّ الطريقَ عليها الحازِمُ الحَذِر",62,"ر",1,0],["إن الوزارة َ لم تزل بها","شوق إليك يُرى تنزُّعُهُ",63,"ع",2,0],["أنا لولاهُ لما طوّفتُ في","كلِّ قفرٍ مترامٍ مجدبِ",64,"ب",1,0],["إنَّ الوُشاة َ كَثيرٌ، إنْ أَطَعْتِهِمُ،","لا يرقبون بنا إلاًّ، ولا ذمما",65,"م",2,0],["أنا لولا العظامُ وهيَ حياتي","لم تَطِبْ لي مع ابنِ آدمَ حال",66,"ل",1,0],["أنا لو أطلعت القلبَ في","ه لم أزدْه على جواه",67,"ا",2,0],["إنَّ الَّواصح كلَّهمْ","قالوا بتبديلِ «الهوا»",68,"و",2,0],["إِن الوَزير أَدامَ اللَهُ دَولَتَهُ","أَخبارُهُ سِيَرٌ في الناس تَنتَقِلُ",69,"ل",1,1],["إن الوعود التي منوا وما صدقوا","بها علينا لعمري كن بهتانا",70,"ن",2,0],["إن الوقوف بهن شب زوافرا","بين الجوانح والدموع جَوَارِ",71,"ر",1,0],["إِنَّ الوَثيقَةَ في لزومِ مُحَمَّدٍ","فَاِشدُد بِصُحبَتِهِ عَلى يَدَيكا",72,"ك",2,1],["أنا لولاك لم أحُكْ بُردةَ الشِّع","ر ولا كان لؤلئى للثَّقبِ",73,"ب",1,0],["إن الورى لما دعوْه جَمالَهم","حلُّوا من العلياءِ خيرَ مكانِ",74,"ن",1,0],["إِنَّ الوَزارَةَ مُذ تَحَلَّت بِاِسمِهِ","عَزَّت ذَرىً في ظِلِّهِ وَعَلَت ذُرى",75,"ر",2,0],["إِنَّ الوَزيرَ رَأى النَوائِبَ جَمَّةً","فَاِختارَ مِنكَ لِدَفعِها مُختارا",76,"ر",2,0],["إِنَّ الوَفاءَ طَريقُ أَسلافي الأُلى","عَمَروهُ ما بَيني وَبَينَ الهَيثَمِ",77,"م",1,0],["إِنَّ الوُفُودَ مِنَ القَبَائلِ كلِّهَا","مِمَّن تَضَعضَعَ مالُهُ والخاملِ",78,"ل",1,0],["أَنا لَو خُيّرت في أَعلى سما","أَو بِها لاِخترتُ فيها مجلسي",79,"ي",1,0],["إِنَّ الوَليدَ أَمرَ المُؤمِنينَ لَهُ","خَلقٌ أَعانَ عَلَيهِ اللَهُ فَاِرتَفَعا",80,"ع",2,0],["إِنَّ الوَليدَ أَميرَ المُؤمِنينَ قَضى","أَمراً يُبَلِّغُهُ الأَدنَونَ أَقصانا",81,"ن",2,0],["إنَّ الوفاء ديانةٌ ولقد يُرى","غَدرُ الفَتى أخزى له من كُفرِهِ",82,"ر",2,0],["انا لو برح بي هجرانه","عنه قلبي في الهوى ما ترحا",83,"ح",2,0],["انا لو جاء في الملا","بضروب من الملق",84,"ق",1,0],["أنا لو شئت توبة الروج منكم","هام عقلى بكم وهام بياني",85,"ن",2,0],["إن الورود وإن لم يبق رائعها","يومين تضرب أزماناً بأزمان",86,"ن",1,0],["أنا لو كنت قد خلوت من الحب","لما كنت شاعراً بوجودي",87,"د",2,0],["إِنَّ الوَرى أَطلَقوا ريحاً إِلى سَقرٍ","تقود لِلنّارِ قَوماً دانَه البشرُ",88,"ر",1,0],["أنا لولا مَنْ يُؤَمّلني","لم أرِد مُسْتأْخِرَ الأَجل",89,"ل",1,0],["أنا لو رُمت شكرَ بعضِ أيادِي","ك لأَعْيا عَلَيّ إدراك ذاكا",90,"ك",2,0],["إِنَّ الوِزارَةَ لَمّا غابَ ضَيغَمُها","عَنها وَفارَقَ تِلكَ الهالَةَ القَمَرُ",91,"ر",1,0],["أنا لو قضيت العمر أبكي أحمدا","ما جفّ زمزم دمعي الدفّاق",92,"ق",1,0],["إن الورى في راحتيكَ حظوظُهُ","وكذا ال