{"poems":[[65,"فؤاد ببين الظاعنين مروع","https://www.aldiwan.net/poem45790.html","الطويل"],[87,"الدب معروف بسوء الظن","https://www.aldiwan.net/poem8022.html","الرجز"],[87,"اجعل رثاءك للرجال جزاء","https://www.aldiwan.net/poem62936.html","الكامل"],[87,"محجوب إن جئت الحجاز","https://www.aldiwan.net/poem63699.html","مجزوء الكامل"],[99,"هل في العصيب المدلهم","https://www.aldiwan.net/poem24783.html","مجزوء الكامل"],[100,"مصرع النسر","https://www.poetsgate.com/ViewPoem.aspx?id=55338",""],[287,"لأجفانك المرضى الصحاح القواتل","https://www.aldiwan.net/poem32674.html","الطويل"],[466,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[563,"حوت تعاظم فالتقم","https://www.aldiwan.net/poem34194.html","مجزوء الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59286","الوافر"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133869","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127987","الكامل"],[1776,"","https://poetry.dctabudhabi.ae/diwan/poem/84765","الكامل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132315","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91858","الوافر"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132142","الكامل"]],"verses":[["فَلِمْ حَمَلَتها وَهيَ كارِهَةُ النَوى","إِلى حَيثُ لا يَستَوقِفُ العيسَ مَرتَعُ",0,"ع",1,0],["فَلَمَحَ المَركَبَ فَوقَ الجودي","وَالرَكبُ في خَيرٍ وَفي سُعودِ",1,"د",1,0],["فَلَمَحتُ أَعرَجَ في زَوايا الحَقِّ لَم","أَعلَم عَلَيهِ ذِمَّةً عَرجاءَ",2,"ا",2,0],["فَلَمَحتَ نَضرَةَ بانِهِ","وَشَمَمتَ كَالرَيحانِ ضالَه",3,"ل",2,0],["فلمحت صبحك في السوا","دِ وخلتُ روحكِ في النسم",4,"م",1,0],["فلمحنا في أفقها وجهَ هارو","نَ وعصراً مخضَّباً بالعظائم",5,"م",1,0],["فَلِم حارَبَتني في هَواهُ عَواذِلي","فَلَمّا رَأَتهُ سالَمَتهُ العَواذِلُ",6,"ل",1,0],["فلمُحْفِظيهِ مَتالِفٌ ومَعاطِبٌ","ولمُعْتَفيهِ مكارِمٌ وعَطاءُ",7,"ا",2,0],["فلمحت يونسَ حكمةٍ","زالت بها عني النقم",8,"م",1,0],["فَلِمْ حَرَّكْتَ يَا سَكَنِي سُكُونِي","إلَى تَلَفٍ يُبَيَّنُ بَعْدَ بَيْنِ",9,"ن",1,0],["فلمح الخَباز ضَرب القادر","فَثارَ للغيظ كَليث خادِر",10,"ر",1,0],["فلمحت في بعض الوها","د وقد قعدت سواد هامه",11,"م",2,0],["فلمحت من سجف الحرير شموسهم","حجب الحرير جمالها المتوارى",12,"ر",2,0],["فَلَمَحتُ رِدفاً كَالكَثيبِ","لِخَصرِها المَمشوقِ زانِقِ",13,"ق",1,0],["فلَمَحتُ سِرباً كُنتُ أحسِبُهُ نساً","فإذا بهِ الظَبيَاتُ في سرحَاتِهَا",14,"ت",3,0],["فَلم حرّمتمُ عَدلاً حَلالاً","وَكَيفَ الظُلم حللتم حَرامه",15,"م",2,0],["فلمحت في الوادي على فسح المدى","وضح الهدى ومنارة الأرياف",16,"ف",1,0]]}