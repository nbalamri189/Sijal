{"poems":[[63,"فؤاد ببين الظاعنين مروع","https://www.aldiwan.net/poem45790.html","الطويل"],[85,"الدب معروف بسوء الظن","https://www.aldiwan.net/poem8022.html","الرجز"],[85,"اجعل رثاءك للرجال جزاء","https://www.aldiwan.net/poem62936.html","الكامل"],[85,"محجوب إن جئت الحجاز","https://www.aldiwan.net/poem63699.html","مجزوء الكامل"],[97,"هل في العصيب المدلهم","https://www.aldiwan.net/poem24783.html","مجزوء الكامل"],[98,"مصرع النسر","https://www.poetsgate.com/ViewPoem.aspx?id=55338",""],[283,"لأجفانك المرضى الصحاح القواتل","https://www.aldiwan.net/poem32674.html","الطويل"],[462,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[559,"حوت تعاظم فالتقم","https://www.aldiwan.net/poem34194.html","مجزوء الكامل"]],"verses":[["فَلِمْ حَمَلَتها وَهيَ كارِهَةُ النَوى","إِلى حَيثُ لا يَستَوقِفُ العيسَ مَرتَعُ",0,"ع",1,0],["فَلَمَحَ المَركَبَ فَوقَ الجودي","وَالرَكبُ في خَيرٍ وَفي سُعودِ",1,"د",1,0],["فَلَمَحتُ أَعرَجَ في زَوايا الحَقِّ لَم","أَعلَم عَلَيهِ ذِمَّةً عَرجاءَ",2,"ا",2,0],["فَلَمَحتَ نَضرَةَ بانِهِ","وَشَمَمتَ كَالرَيحانِ ضالَه",3,"ل",2,0],["فلمحت صبحك في السوا","دِ وخلتُ روحكِ في النسم",4,"م",1,0],["فلمحنا في أفقها وجهَ هارو","نَ وعصراً مخضَّباً بالعظائم",5,"م",1,0],["فَلِم حارَبَتني في هَواهُ عَواذِلي","فَلَمّا رَأَتهُ سالَمَتهُ العَواذِلُ",6,"ل",1,0],["فلمُحْفِظيهِ مَتالِفٌ ومَعاطِبٌ","ولمُعْتَفيهِ مكارِمٌ وعَطاءُ",7,"ا",2,0],["فلمحت يونسَ حكمةٍ","زالت بها عني النقم",8,"م",1,0]]}