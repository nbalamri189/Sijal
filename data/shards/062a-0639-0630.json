رأة","https://www.poetsgate.com/ViewPoem.aspx?id=202646",""],[4808,"تعذبني أراك ولا أراك","https://www.poetsgate.com/ViewPoem.aspx?id=187969",""],[4849,"الهم قصيت له قصه قصيره ونام","https://www.poetsgate.com/ViewPoem.aspx?id=53494",""],[4882,"اجبني فحتى الماء فجره الصخرُ_بهاء الدين الخاقاني","https://www.poetsgate.com/ViewPoem.aspx?id=7332",""],[5122,"تّمر","https://www.poetsgate.com/ViewPoem.aspx?id=33179",""],[5277,"للهِ درُّ غزالي","https://www.poetsgate.com/ViewPoem.aspx?id=193453",""],[5397,"لعمر العلى ما كل من طلب الفخرا","https://www.poetsgate.com/ViewPoem.aspx?id=157968",""],[5419,"للكبار فقط","https://www.poetsgate.com/ViewPoem.aspx?id=32270",""],[5431,"لقد آنس الأرواح حزنٌ مقعرُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=198970",""],[5587,"هيا نتسامح","https://www.poetsgate.com/ViewPoem.aspx?id=194341",""],[5784,"جف الشعر في السطر الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=190846",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5956,"فقدان وأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=194843",""],[5956,"غزة وإسرائيل","https://www.poetsgate.com/ViewPoem.aspx?id=202518",""],[5957,"تباعدتَ","https://www.poetsgate.com/ViewPoem.aspx?id=18429",""],[5966,"جريح الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=158860",""],[5969,"رَبيعُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=198726",""],[5975,"أيحسنُ أن تضنّي؟","https://www.poetsgate.com/ViewPoem.aspx?id=52979",""],[5997,"بحرٌ وأطْلس","https://www.poetsgate.com/ViewPoem.aspx?id=214227",""],[5997,"ملاذ الهم","https://www.poetsgate.com/ViewPoem.aspx?id=214250",""],[6038,"كويتيه","https://www.poetsgate.com/ViewPoem.aspx?id=25685",""],[161,"لكل سؤال جواب وحل","https://www.poetsgate.com/ViewPoem.aspx?id=169334",""],[6048,"أنَا المُدانَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=197749",""],[6152,"اسير ذكراك","https://www.poetsgate.com/ViewPoem.aspx?id=204245",""],[5309,"تعذب قلبي غادة ذات صولة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573598",""],[5567,"مدار الفراغ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81817&r=&rc=67",""]],"verses":[["تَعَذَّبُ الآمالُ في ظِلِّهِ","وَتَنثَني عَنهُ بِلا طائِلِ",0,"ل",1,0],["تَعَذَّرتَ يا خِنزيرَ تَغلِبَ بَعدَما","عَلِقتَ بِحَبلَي ذي مُعاسَرَةٍ شَغبِ",1,"ب",1,0],["تَعَذَّرُ لِلنَزيلِ وَكانَ عِرقٌ","لَنا في اِبنَي نُمَيرَةَ غَيرُ جافِ",2,"ف",1,0],["تعذّر أن نعتاض من أمهاتنا","وآبائنا والنسلُ لا يتعذر",3,"ر",1,0],["تعذرت الركائب والمطايا","فأوفدنا القلوب إلى السلوم",4,"م",1,1],["تعذِّبه بسحرهما","وتوجده وتعدمه",5,"م",2,0],["تَعَذَّرَ مِنها الوَصلُ وَالوَصلُ مُمكِنٌ","وَقَصرُ نَوالِ البيضِ أَن يَتَعَذَّرا",6,"ر",2,0],["تَعذيبُهُ العُشّاقَ تَعذيبُها","ووعدُه نُسخَةُ موعودَها",7,"د",3,0],["تَعَذر العَين في البُكاء عَلَيه","دَمعَ سَلوى لَكن بِلا سُلوان",8,"ن",1,0],["تَعَذَّرَ بَعدَ عَهدِكَ مِن سُلَيمى","أَجارِعُ بَعدَ رامَةَ فَالهُجولُ",9,"ل",1,1],["تَعَذَّرَ في المَشِيبِ وكانَ عَيَّاً","وَبُرْدُ شبابِهِ ضافٍ قشيبُ",10,"ب",1,0],["تَعَذَّرَ مَأَتاهُ فَما نَستَطيعُهُ","عَلى قَولِ مَن يَغتابُنا وَيَعيبُ",11,"ب",1,0],["تُعَذِّبُ أدْناهُ فَيَعْزُبُ دُونَها","وتُبْرِئُ داءَ الضّرْبِ والداءُ ناجِس",12,"س",1,0],["تعذّر بعد رامة َ من سليمى","أَجَارِعُ بَعْدَ رَامَة َ فالهُجُولُ",13,"ل",1,1],["تعذر أن نعتاض من أمهاتنا","وآبائنا والنسلُ لا يتعتذر",14,"ر",1,0],["تعذيب قلبي في هواك حلالي","رفقا فما هذا الاذى بحلال",15,"ل",1,1],["تُعَذَّبُ فِي لَهِيبِ الشَّكِّ رُوحِي","وَتَشْقَى بِالظُّنُونِ وَبِالتَّمَنِّي",16,"ن",2,0],["تعذّبني وتضنيني","وتقتلني بلا جرم",17,"م",1,0],["تعذبني نداءات اليتامى","وصانع يتمهم حرٌ طليق",18,"ق",1,0],["تعذر المستهام من أنْ يُلاما","كيفَ ينجو من الصَّبابة صبٌّ",19,"ب",1,0],["تعذُلُني في رشأٍ","أرى هواهُ مذهبي",20,"ب",2,0],["تَعَذَّرَ في الناسِ الكمالُ وحازَهُ","بأجْمَعِهِ والنَّقْصُ خَزْيانُ مُذْعِنُ",21,"ن",1,0],["تُعذِّبُني من كامِنٍ الشَّوقِ جذوةٌ","فأفزعُ للِّذكرى فَتَضرمُ من جَمرِ",22,"ر",1,0],["تَعَذَّرِتِ القَوَافِي والنَّشِيدُ","وَضَاقَ بِرَحْبِ مَسْعَاكَ القَصِيدُ",23,"د",1,1],["تعذر المامي عليها بيقظتي","ونومي وان أضحى فؤادي مأواها",24,"ا",3,0],["تَعَذَّبتُ في الحُبِّ مَن في الهَوى","تَذَوَّقَ ما ذُقتُ مَن في البَشَرْ",25,"ر",1,0],["تَعَذَّرَ مَنْ أحِبُّ فَطَابَ عُذْرِي","وَزَادَ هَوَايَ فِيهِ وَقَلَّ صَبْرِي",26,"ي",1,1],["تَعذى مسارحه وَيَصفى شربه","وَيَبيتُ بالرَبوات وَالأَعلام",27,"م",1,0],["تعذر الصبر إذ تعذر","أغن أحوى الجفون أحور",28,"ر",1,1],["تعذب حتى أنها لو مزجت","للناس بالسمِّ الذعاف شربا",29,"ب",2,0],["تعذيب قلبي من سواجي جفونه","ونْحول جسمي من نشاشيب لاحْداقْ",30,"ق",1,0],["تعذر الصبر وعز الكرى","وانذهل العقل وطاشت حلوم",31,"م",1,0],["تُعَذِّبُني وَتَعلَمُ أَنَّ قَلبي","يَهيمُ إِلى مَراشِفِها العِذابِ",32,"ب",1,0],["تَعُذ بِخَرقٍ لَو نَظَر","إِلى فَقيرٍ ما اِفتَقَر",33,"ر",1,0],["تعذرت الطباع عن المعالي","وعاد الربح بين الناس خسرا",34,"ر",2,0],["تعذبني الذكرى إذا هي حركت","جوىً تتغذّاه الضلوعُ حرارا",35,"ر",2,0],["تعذر حتى قلت والشعر قد بدا","اتذكر بغيا كان حين التمرد",36,"د",1,0],["تعذّرَ إلا حين عُذْتُ بك الغنى","وأقصر إلا عندَ مدحي لك الشّعرُ",37,"ر",1,0],["تعذيبها عذب يروق وروده","عندي فكيف العذب من حالاتها",38,"ت",3,0],["تعذيبكُم يا أهل نجد عذبُ","والبعد إذا ما كان منكم قربُ",39,"ب",1,1],["تَعَذَّرَ مِن هِجائيَ فَرطَ حَولٍ","فَقَد ذَهَبَ العِتابُ فَلا عِتابا",40,"ب",2,0],["تعذب بالجفا روحي","وما ملت وما غدرت",41,"ت",1,1],["تعذَّر غُمض العين وانشرح الكَرا","وباح من الأسرار ما لا تكاتمه",42,"م",2,0],["تعذّب مهجتي فيهِ وَعيني","لَها مِن وجنتيهِ جَنتان",43,"ن",1,0],["تُعذِّرُ منه الآنَ لَمّا قَتَلتَهُ","تَفاوَتَ أَرجاءِ القليبِ مِن الشَطنِ",44,"ن",1,0],["تَعذر الطِب وَالبرء اِنزَوى وَنَأى","عَنّي وَلَونى مِن فِعل الهَوى حائِل",45,"ل",1,0],["تُعذِّبُ قلبي قلتُ طَرفُكَ مُشرِكٌ","فَما العذرُ في تعذيبِ قلبِ المُوحِّدِ",46,"د",1,0],["تُعذَرُ في النَوح إِذ تُعَزّى","قُل لي فَما العُذرُ إِذ تُهني",47,"ن",2,0],["تَعَذَّرَ صمتُ الواجدينَ فصاحوا","ومن صاحَ وجداً ما عليهِ جناحُ",48,"ح",1,1],["تعذرُ العينُ بأن لا تَكِف","والهوى يعلم أني دنِفُ",49,"ف",1,1],["تعذر أن يفيها النقل وصفا","تخذت أوامر الأسواء الفا",50,"ف",2,0],["تعذر أن يبوح بماء عيني","وقولي ألف آه ليس يغني",50,"ي",1,0],["تعذلني في قهوةٍ مُزَّةٍ","درياقةٍ تُجلَب من بابلِ",51,"ل",1,0],["تعذر ديناري علي ودرهمي","فلاطفت مولانا ببيتين من شعري",52,"ي",1,1],["تَعْذُرَا حِينَهَا فؤاداً ولوعاً","ذَاقَ مِنْهَا الّرضَا وَطَعْمَ السّرُورِ",53,"ر",1,0],["تعذّب القلب حتى يستشفّ هوىً","ويصبح الموت من أغلى أمانيهِ",54,"ي",2,0],["تعذّب القلب كي يأتي طواعية","رحابها دون تحذيرٍ وتنويهِ",54,"ي",2,0],["تُعذِّبُني: \" أراكَ ولا أراكَ \"","وتأسرُني: \" أحبكَ؛ لا سِواكَ \"",55,"ك",1,1],["تعذّري بأي عذر من الطفولة مدام","قلبي رضى بالجروح ودائماً يدعّي",56,"ع",2,0],["تعذبني بالصمت والأه فاضح ٌ","عجبْت لملْك ٍ لا يفاخِره الشعرُ",57,"ر",1,0],["تعذبك الاحلام إن لم تمتْ بها","متيم دربٍ ما أستذلّ به السِفرُ",57,"ر",1,0],["تعذر تقول اللي حصل ماهوب مقصود","تعذر وتذرف فوق الاوجان دمعتها",58,"ت",3,0],["تعذّبَ القلبُ من صبٍّ وما وعدا","هلّا رأيتِ فؤادي بالنوى اتَّقدا",59,"د",2,1],["تعذر عما قد جنته يمينه","ومنه ابن بنت الوحي قد قبل العذرا",60,"ر",2,0],["تُعذّب في اليوم خمسين عاماً","وبالقهر ذكر البلاد ارتبطْ",61,"ط",1,0],["تُعذبني شكوى الجياع وأقهرُ","ومهما بذلتُ الحبَ عنها أقصّرُ",62,"ر",1,1],["تُعَذِّبْنِي بِنَارِ جَفَاكَ تُكْوَى","فَيَا لَهْفِي لَقَدْ خَيَّبْتَ ظَنِّي",63,"ن",2,0],["تعذبني متاهات القوافي","وأنعم في مداها بالعبيرِ",64,"ر",1,0],["تعذرتْ الأيامُ عن مثلهِ وقد","نَبَتْ أَلسُنُ الأفكار وكَلَّتِ",65,"ت",1,0],["تُعذبني الحياة بما أضاعت","من الأشعارِ فوق التِّبْرِ وزْنا",66,"ن",2,0],["تعذيب شعبي يا إله تفاقما","بلغَ الذبى أ وَ لن تعيده سالما؟",67,"م",2,1],["تعذرتَ بينَ انشغالٍ وبينَ","عسير الظروفِ طويلا طويلا",68,"ل",2,0],["تعذبني دائماً بالجَفا","قسا قلبُها مثلَ صلدِ الحجَر",69,"ر",1,1],["تَعذَرَ ظِلي عَنْ مُلاقاةِ شَمْسِها","وَنَقعُ غُبارِ الزَيفِ راحَ يُدَمْدِمُ",70,"م",1,0],["تُعَذِّبُني بِجورِ القَهْرِ دُنْيَا","وتُتْحِفُني بِأَصْنَاْفِ التجَنِّي",71,"ن",2,0],["تُعَذِّبُنِي ولا أدري لماذا","فَهلْ حُبّي لها بالحالِ أفْلَسْ",72,"س",1,0],["تعذبني ولا تعلم","بأنَّي عاشق مغرم",73,"م",1,1],["تعذيب خلايق الله شي هويته","زيد في تعذيبك الله يخليك",74,"ك",1,0],["09-تَعَذَّرَ سَاعِي بَرِيدِي كَما","تَلهَّى