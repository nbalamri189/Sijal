لَى عَبِيدِ الْ \" بِيَادَةِ \" فِي مِصْرَ","https://www.poetsgate.com/ViewPoem.aspx?id=191618",""],[5101,"ثمار عين مالحة","https://www.poetsgate.com/ViewPoem.aspx?id=197579",""],[5213,"واشم شارع نجدة","https://www.poetsgate.com/ViewPoem.aspx?id=170493",""],[5397,"أطربتني نغمات لحن المنشد","https://www.poetsgate.com/ViewPoem.aspx?id=157934",""],[5595,"وسَكرتُ فيك","https://www.poetsgate.com/ViewPoem.aspx?id=150151",""],[5595,"عطر الورد","https://www.poetsgate.com/ViewPoem.aspx?id=176725",""],[5595,"يَا قلبُ صَبْرَاً","https://www.poetsgate.com/ViewPoem.aspx?id=177967",""],[5612,"يا رَبُّ فَرِّجْ","https://www.poetsgate.com/ViewPoem.aspx?id=181791",""],[5618,"وردة في محراب عقبة","https://www.poetsgate.com/ViewPoem.aspx?id=208918",""],[5736,"قميص","https://www.poetsgate.com/ViewPoem.aspx?id=203844",""],[5736,"هدهد فؤادك","https://www.poetsgate.com/ViewPoem.aspx?id=208437",""],[5845,"قلْ للمطيِّ اللواتي طالَ مسراها","https://www.poetsgate.com/ViewPoem.aspx?id=198493",""],[5849,"يا راحماً فوجَ الحجيج","https://www.poetsgate.com/ViewPoem.aspx?id=191080",""],[5956,"ريثما الموت يجىء","https://www.poetsgate.com/ViewPoem.aspx?id=181921",""],[5956,"‏\"أبَلْعِطُ\" في البحر‏","https://www.poetsgate.com/ViewPoem.aspx?id=183268",""],[5974,"خذني معك","https://www.poetsgate.com/ViewPoem.aspx?id=207301",""],[5975,"على نغم المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=58500",""],[6096,"عماء .. لكني أرى","https://www.poetsgate.com/ViewPoem.aspx?id=177111",""],[6102,"تعدو دعد","https://www.poetsgate.com/ViewPoem.aspx?id=183318",""],[1100,"أترى انت دليلي تهت من فكر ضليل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612986",""],[6341,"مداي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87282&r=&rc=11",""],[5396,"لمعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65505&r=&rc=4",""]],"verses":[["وَأَشمَمتُها رَملَ الأُنَيعِمِ غُدوَةً","فَسافَت بِأَنفٍ مُنكِرٍ غَيرِ عارِفِ",0,"ف",1,0],["وَأَشمَتُّ بِالقُربِ أَيدي النَوى","وَخاطَرتُ بِالطَمَعِ العاثِرِ",1,"ر",1,0],["وَاِشمُم تُرابَ الأَرضِ تَعلَم أَنَّها","جَرباءُ تُحدِثُ كُلَّ يَومٍ داءَ",2,"ا",2,0],["وَأَشمَتِّ العِدى حَتّى كَأَنّي","وَإِيّاها لَهُم غَرَضُ النِبالِ",3,"ل",1,0],["وَأَشمَمتُها أَعقارَ مَركُوِّ مَنهَلٍ","تَرى جَوفَه يَعوي بِهِ الذِئبُ خاوِيا",4,"ي",2,0],["وَأَشمَطَ قَد تَرَدَّدَ في عَماهُ","جَعَلتَ لِشَيبِ لِحيَتِهِ خِضابا",5,"ب",2,0],["وَأَشمَطَ سَوّاسِ الفَوارِسِ أَشيَبُ","يَسيرُ بِهِ في الشَعبِ أَشمَطُ أَشيَبُ",6,"ب",1,0],["وَأَشمَتَ اللَهُ بِمَن عابَني","أَحوَجَ ما كُنتُ وَما أَدري",7,"ر",2,0],["وَأَشمَطَ مَحنِيِّ الضُلوعِ عَلى لَظى","بِهِ الضُرُّ إِلّا أَنَّهُ يَتَسَتَّرُ",8,"ر",1,0],["وَأَشمَطُ مِن وُرقِ الحَمامِ كَأَنَّما","سَنا الصُبحِ يُصبي قَلبَهُ حينَ يُصبِحُ",9,"ح",1,0],["وأشمطَ خُضْنا نَحوَهُ اللَّيل بِالسُّرى","وقد خاطَ منه النومُ شفراً على شَفرِ",10,"ر",1,0],["وأَشَمَّ من بَيتِ الرئاسَةِ أكبرٍ","يُنْمَى إِلى شُمِّ الأُنوفِ أَكابِرِ",11,"ر",1,1],["وَأَشَمَّنا في اللَيلِ بَردَ نَسيمِهِ","وَاِرتاحَتِ الأَرواحُ في الأَجسادِ",12,"د",1,0],["وَأَشمَطَ رَبِّ حانوتٍ تَراهُ","لِنَفخِ الزِقِّ مُسوَدَّ السِبالِ",13,"ل",1,0],["وَأَشمَطَ عُرياناً يُشَدُّ كِتافُهُ","يُلاُم عَلى جَهدِ القِتالِ وما ائتَلى",14,"ل",2,0],["وأَشْمَطَ مِنْ طُولِ الجِهَادِ اسْتَخَفّهُ","مَعَ المُرْدِ حَتَّى رَأْسُهُ اليَوْمَ أَشْيَبُ",15,"ب",1,0],["وأَشْمَلُ النُّعْمَى بِأَفْرَاحِهَا","هِيَ الَّتِي يَحْظَى بِهَا الأَجْدَرُ",16,"ر",1,0],["وأشمخَ أهلها أنفًا إذا ما","تمرَّغت الأنوفُ على الصعيد",17,"د",1,0],["وأَشْمَطَ مِنْ طُولِ الجِهَادِ اسْتَخَفّهُ","ومَأْوَى اليَتَامَى الغُبْرِ عَامُوا وأَجْدَبُوا",18,"ب",3,0],["واشمل بجودك يا كريم ذنوبنا","ان الكريم عن الذنوب صفوح",19,"ح",1,0],["واشمل بعونك والدي وإخوتي","وعني إذ بك للمراد حصول",20,"ل",1,0],["وأشمَّ الأرضَ أو ألثُمَها","فدوائي نفحةٌ من ذا الثَّرى",21,"ر",2,0],["واشمل بمرحمة عَبد الرَحيم وصل","أَهلا وَصحبا وارحاما لمولاها",22,"ا",3,0],["واشمل بجاهك صاحبا وَحَميما","صلوا عليه وَسَلموا تَسليما",23,"م",2,0],["وَاِشمَعَلَّت بِالقَنا أُسدُ وَغىً","تَملأُ الحَزنَ خُيولاً وَالسُهولا",24,"ل",2,0],["وَأشمسُ فضلٍ لا تُماثلُ بهجةً","بأفلاكِ مجدٍ عن مطاولها تربا",25,"ب",2,0],["وَاِشمل طَوائفَ جَمعنا","بِالفَضل يا رَبَّ البَرايا",26,"ي",2,0],["وَاِشمَت بِذا الهَمِّ المُغَر","ربِ خيفَةَ القَدَحِ المُشَرِّق",27,"ق",1,0],["وأشمتُ طرف اللَّحْظِ حيث أشاموا","ولربّ ذنبٍ ظَلْتُ في تَطْلابه",28,"ه",1,0],["وأَشمسَ شيْبي فهل فَيْئة","تعود بظلّ الصِّبا الزائلِ",29,"ل",1,0],["وأشمتَّهم ذا العامَ أنك جُرتَ بي","ومَذهَبُك العدلُ الصحيحُ ومَذهَبي",30,"ب",2,0],["واشْمعلُّوا بعدَ إِجْماعِهُمُ","كأبابيلِ جَرادٍ مُثْمِدِ",31,"د",1,0],["واشمخ بأنفك فالرايات خافقة","يهزها الفخر والإجلال والعظم",32,"م",1,0],["وَاِشمُمْ عَبيرَ تُرابِهِ واِلْثِمْ حَصىً","في سَفحِهِ اِنتثَرتْ عُقودُ جُمانِهِ",33,"ن",2,0],["وَأَشَمَّ بِطريقٍ كَأَنَّ صَليفَهُ","عُقِدَت مَفاصِلُهُ وَإِن لَم تُعقَدِ",34,"د",1,0],["واشمم شذا الروضة من نفسه","وعش به واقنع بتعطيره",35,"ر",2,0],["وأشمتوا بهتكها الأعادي","وما على النساء من جهاد",36,"د",1,0],["وأشمطَ أعلى وَسْطََها بعد هجعة","تراه بها من قرَّة يتشنجُ",37,"ج",1,0],["وَأشَمَّ أقتَلَ طَلعَةً مِن عَنتَرٍ","بَأساً وَأكبَرَ جِفنَةً مِن حاتِمِ",38,"م",1,0],["وأشمَخَهُم وَأفصَحَهُم لِساناً","إذا عيَّ البَليغُ عَنِ الكَلامِ",39,"م",1,0],["وأَشَمَّ يَهدِمُ مالَهُ فيما بَنَى","مِن سُؤدَدٍ فاعجَب لِبانٍ هادِمِ",40,"م",1,0],["وأشمُّ يَسمَن في ذراه الأعجَفُ الضّا","ري ويَشبَعُ في فِناه الجائِع",41,"ع",1,0],["وَأشَمُّ إن لَقيَ الكَماةَ عَجِبتَ مِن","لَيثٍ يُنازِلُ في المَكَرِّ شياها",42,"ا",3,0],["وأشَمُّ لا وَكِلٌ وَلا ضَرَعٌ وَلا","وَغدٌ وَلا بِغَضيبَةٍ أفّاكِ",43,"ك",1,0],["وأشَمَّ لَيسَ مَسَبَّةً لَعّانَةً","أحَدا وَلَيسَ عَظيمَةً أفَاكا",44,"ك",2,0],["وأشَمُّ لو صَدَمَ الشَّواهِقَ عَزمُه","بالأعوَجيَّةِ ما مَثلنَ شَواهِقا",45,"ق",2,0],["واشم من تلك النحور لطائماً","فيهن خفاق النسيم نموم",46,"م",1,0],["وَأَشمَتَّ بي أَهلي وَجُلَّ عَشيرَتي","لِيَهنَئكَ ما تَهواهُ إِن كانَ ذا يَهني",47,"ن",2,0],["وأشم طأطأ للمنون وكم له","من كل ذي شرفٍ تطأطأ هام",48,"م",1,0],["واشمّ أَروع لا يرَّوع جاره","فنزيله للفرقدين نزيلُ",49,"ل",1,0],["وأشمتم النمام إذ نم بالذي","أكنته أحشائي فقال وقلتم",50,"م",1,0],["وأشمُّ الطيب حتى","انتهي طيبَ التلول",51,"ل",1,0],["واشمل عبيدك في يوم القضاء رضا","من حلمك الوافر الوافي الذي جزلا",52,"ل",2,0],["وأشمُّ قد مسح النُجوم لواؤُه","فكأنَّ من عَذباته جوزاءها",53,"ا",3,0],["وأَشُمَّ ريحانَ الشعورِ مُطَيَّباً","وأُعَلَّ خمراً بالثغور مُشَنَّبا",54,"ب",2,0],["وأشمّ لا يحتل دار هضيمة","أو يستقل على النجوم رغامها",55,"م",3,0],["واشمأزت وأبت حاردة","حانيات الدوح كف الهاصرين",56,"ن",1,0],["واشمُل إلهي بما نرجو مشايخَنا","ووالدَينا فإنّا لهُم أَثَرُ",57,"ر",1,0],["واشمُل أحِبَّتَنا طُراً وجيرتَنا","والمسلمينَ ومن غابوا ومن حضروا",57,"ر",3,0],["وأشمت المجد الاشم","برغم ماجده رغامه",58,"م",2,0],["واشم يخترق الصفوف باجيد","لو طاول الشم الرعان لطالها",59,"ل",3,0],["وأشم العبير يعبق في صدغيك","وأعض التفاح في وجنتيك",60,"ك",1,0],["وأشم عبل الساعدين شمردل","ضخم الدسيعة شامخ العرنين",61,"ن",1,0],["وَأَشمط بَهّاتٍ غَريبٍ مُمَزَّقٍ","رَميةِ أَفّاقٍ كَثير دَهارِسُه",62,"س",2,0],["واشم الانف أو تقضى المنى","تظمأ الاملاك ان لم يشرب",63,"ب",1,0],["واشملونا بالثقافة لا","تدعونا موثقي الحقبِ",64,"ب",1,0],["واشم أبيض لا ينهنه ما","بين المواضي البيض والسمرِ",65,"ر",1,0],["وأشم قد شام المني","ة فرصة فاستغنما",66,"م",2,0],["وأشم منها المصحفي على النوى","نفساً ينسي السوسن المبلولا",67,"ل",2,0],["وَأشم عطراً مِن حَواشي طوقها","قَد خل بَين تَرائب وَنهود",68,"د",1,0],["وأشم من ريحانها وزهورها","مسكا يفوح لنا ونشرا عاطرا",69,"ر",2,0],["واشمرْ يديكَ الجوَّ شَمرةَ مُعجَبٍ","نَشوانَ يَخْطِرُ باليدينِ مُخائِلِ",70,"ل",1,0],["وأشمم عبير ثرى به فلعلهُ","يشفي فوآدك من جوى برحائه",71,"ا",3,0],["واشمُّ ورد خدوده متنقلاً","ما بين وجنته وبين المرشف",72,"ف",1,0],["وأشم شئن اللّبدتين ترى له","همماً يكيل بكيلها الابطالا",73,"ل",2,0],["واشم من ذاك العذار بنفسجا","الند لبس له من الأنداد",74,"د",1,0],["وأشمتوا بي حسادي وقد علموا","بأن أعظم ما أبلى به الحسد",75,"د",1,0],["واشمل بعفوك ما مضى من زلة","لولا جميل الصفح منك انهارا",76,"ر",2,0],["واشمخْ بهمَّتِكَ العلياءِ مرتقياً","لِسُلمِ المجدِ ولمهِمَّاتِ مُعْتَنِقَا",77,"ق",2,0],["واشمل بفضلك أهلى والبنين مع الز","وجات ثم ذوى القربى واخوانى",78,"ن",2,0],["واشمخوا من جراحكم","فالجراحاتُ كِبريَا..",79,"ي",2,0],["وَاشْمَتُوا فِينَا وَكُونُوا","دُونَهُ مِثْلَ الْ \" بِيَادَةْ \"",80,"د",2,0],["وأشمُّ ريح وجودهم في خاطري","وأحبهم هل للتذكر رائحة ؟",81,"ح",2,1],["واشم شارع نجدة","يقفو أخا النجدات شارع",82,"ع",1,1],["وأشم خاطب منه أرفع همة","لمعارج الفلك المحيط بي اصعدي",83,"د",2,0],["وأشمُّ فِيهَا مِن ريَاحين الهَوى","قُبُلاً تُداعبُها الورُود ُ فتُزهِر ُ",84,"ر",1,0],["وأشمُّ عِطرَ الوردِ في أنفاسِها","شمّاً يعيدُ الرّوحَ بعْدَ فنائِها",85,"ه",2,1],["وأشمَّ رِيْحَ المِسْكِ عِنْدَ عِنَاقِهَا","بِفَمِ الخَبَايَا رعْشَةُ الاجْرَاسِ",86,"س",1,0],["واشْمَلْ بعفْوِكَ عائِداً مُتَذلِّلاً","واغْفِرْ بجُودِكَ يا كريمُ ذنوبي",87,"ب",2,0],["وأشمنا -الأوراس- يبقى صامدا","وبكل أسفار البطولة خُلِّدا",88,"د",2,0],["وأشمُّ ريحَك في قميصِ حديثِهم","فمتى سُيلقون القميصَ لأبصرا؟",89,"ر",2,1],["واشمخ بنفسك فالتواكل ذلةٌ","كن كالنسور وفي الرضا إقناعُ",90,"ع",1,0],["واشملْ برحمة ٍ عبدَ الرحيمِ وصلْ","أهلا ً وصحبا ً وأرحاماً لمولاها",91,"ا",3,0],["واشمل جميع المسلمين برحمةٍ","واملأ رُباهُم نعمةً وهناءَ",92,"ا",2,0],["وأشمُّ اللحم شمّاً","حصتي أني أموءُ",93,"ا",1,0],["‏ ‏وأشمخُ في البَرِّ أحسب أني","‏ ‏ هِزَبْرُ البطولة والافتخار",94,"ر",1,0],["وأشم عطرا منك يخترق المدى","ليعيد همسا في الغرام تضلعكْ",95,"ك",1,0],["وأشمُّ في عمقِ الترابِ عبيرَكم","فأضيعُ بالعبراتِ شوقاً ديّنا",96,"ن",2,0],["وأشمُّ رائحةَ المروجِ وعطرها","وردٌ تفتّحَ ، زنبقٌ ، منثورُ",97,"ر",1,0],["وَ اشَّمَّرَتْ أَكمَامُها فَبَدا","شَمعٌ يَلُفُّ بَيَاضَهُ زَندُ",98,"د",1,0],["وأشمُّ الطيب حتى انتهي طيبَ التلول","يتلقاني ويرمي بيَ في حضن خليل",99,"ل",1,0],["وأشمّ فيها مثل عطر حبيبتي","وجموح شَعرٍ ندّ عن أصفادِه",100,"د",2,0],["وأشمّ الأمواج وهي قرابين","تضّحى للزورق المصدوع",101,"ع",1,0]]}