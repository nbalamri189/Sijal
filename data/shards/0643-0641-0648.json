{"poems":[[55,"تناسيت إلا باقيات من الذكر","https://www.aldiwan.net/poem30441.html","الطويل"],[9,"فدى لبني ذهل ابن شيبان ناقتي","https://www.aldiwan.net/poem21917.html","الطويل"],[29,"بان الخليط غداة الجناب","https://www.aldiwan.net/poem5783.html","المتقارب"],[74,"عجزت عن راتبي الأدنى فوا حربا","https://www.aldiwan.net/poem18282.html","البسيط"],[74,"كفوا حديث العذل عن مسمعي","https://www.aldiwan.net/poem19170.html","السريع"],[53,"تجرد من غمدين سيف مهند","https://www.aldiwan.net/poem61940.html","الطويل"],[31,"عفا ممن عهدت به حفير","https://www.aldiwan.net/poem6048.html","الوافر"],[80,"كذبت مناكم صرحوا أو جمجموا","https://www.aldiwan.net/poem14191.html","الكامل"],[47,"وواعظ منه لولا أنه حجر","https://www.aldiwan.net/poem63596.html","البسيط"],[63,"بين الشنوف الحمر والأقراط","https://www.aldiwan.net/poem51578.html","البسيط"],[82,"ملاعب البيض بين البيض والأسل","https://www.aldiwan.net/poem31322.html","البسيط"],[22,"عرفت منازلا من آل هند","https://www.aldiwan.net/poem21670.html","الوافر"],[22,"شهد الحطيأة يوم يلقى ربه","https://www.aldiwan.net/poem21694.html","الكامل"],[78,"بين الأهلة بدر ما له فلك","https://www.aldiwan.net/poem39243.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54831","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54941","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54906","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54666","الكامل"],[9,"فِدًى لَبنى ذُهلِ بنِ شَيبانَ ناقَتي","https://www.poetsgate.com/ViewPoem.aspx?id=20023",""],[132,"حي المعاليم والرسوما","https://www.aldiwan.net/poem50515.html","مجزوء الكامل"],[138,"الحمد لله الذي قد شرفا","https://www.aldiwan.net/poem21016.html","الرجز"],[146,"يا آل عوف أنجدوا الصبا","https://www.aldiwan.net/poem58349.html","أحذ الكامل"],[164,"وقفت على بيتين من أثقل الشعر","https://www.aldiwan.net/poem59177.html","الطويل"],[201,"ذكرى أثارت غافي الأحزان","https://www.aldiwan.net/poem39804.html","الطويل"],[201,"لا الأنس أنس ولا الأفراح أفراح","https://www.aldiwan.net/poem39809.html","البسيط"],[240,"يا من جلا بقدومه ال","https://www.aldiwan.net/poem31609.html","مجزوء الكامل"],[264,"يا منكرين على من","https://www.aldiwan.net/poem35547.html","المجتث"],[310,"يمم جياد القول خير ميمم","https://www.aldiwan.net/poem56411.html","الكامل"],[369,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[398,"الشيب ينشر عمرا ثم يطويه","https://www.aldiwan.net/poem53662.html","الطويل"],[435,"كفوا اللواحظ عن صب أخي تلف","https://www.aldiwan.net/poem41057.html","البسيط"],[463,"متى رفعت لها بالغور نار","https://www.aldiwan.net/poem56187.html","الوافر"],[466,"ظل الأسنة لا جيران بغداد","https://www.aldiwan.net/poem15126.html","البسيط"],[469,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138212",""],[674,"","https://poetry.dctabudhabi.ae/diwan/poem/145907","الكامل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130210","البسيط"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124612","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56372","الكامل"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205623","البسيط"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78121","المواليا"],[1754,"","https://poetry.dctabudhabi.ae/diwan/poem/107350","الكامل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126643","الكامل"],[2186,"","https://poetry.dctabudhabi.ae/diwan/poem/124166","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27274","الرمل"],[2497,"","https://poetry.dctabudhabi.ae/diwan/poem/143747","البسيط"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84532","الطويل"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107173","الكامل"],[2740,"","https://poetry.dctabudhabi.ae/diwan/poem/126524","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94028","الكامل"],[2973,"","https://poetry.dctabudhabi.ae/diwan/poem/107015","الرجز"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140024","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86290","البسيط"],[3645,"","https://poetry.dctabudhabi.ae/diwan/poem/99286","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109950","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117923","الرمل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70110","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70039","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77017","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36233","الدوبيت"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90816","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94941","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95031","الكامل"],[4767,"تاج الشجاعة","https://www.poetsgate.com/ViewPoem.aspx?id=179986",""],[4814,"عامٌ سعيد","https://www.poetsgate.com/ViewPoem.aspx?id=195041",""],[4861,"من القلب","https://www.poetsgate.com/ViewPoem.aspx?id=33707",""],[5122,"سمان القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=24712",""],[5295,"إنها مصر","https://www.poetsgate.com/ViewPoem.aspx?id=210866",""],[5338,"إن لم تثر في نصر أهلك في اليمن","https://www.poetsgate.com/ViewPoem.aspx?id=187944",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[5363,"رسالة إلى طبل","https://www.poetsgate.com/ViewPoem.aspx?id=199949",""],[5397,"تعجب الدهر من صبري ومن جلدي","https://www.poetsgate.com/ViewPoem.aspx?id=157958",""],[5431,"سيقودني للغيم تحشيشُ....","https://www.poetsgate.com/ViewPoem.aspx?id=200263",""],[5929,"باد هواك","https://www.poetsgate.com/ViewPoem.aspx?id=202445",""],[5969,"رَمتني بدائها وانسلت","https://www.poetsgate.com/ViewPoem.aspx?id=199036",""],[6068,"أعواذلي كفِّي اللوائم واعدلي -28-","https://www.poetsgate.com/ViewPoem.aspx?id=175792",""],[6070,"بيريزُ مَاتَ وطارتِ الغربانُ","https://www.poetsgate.com/ViewPoem.aspx?id=188857",""],[6090,"بدت لنا بمحيا أخجل البدرا","https://www.poetsgate.com/ViewPoem.aspx?id=170914",""],[6142,"ولادة المرتضى لم يحوها أحد","https://www.poetsgate.com/ViewPoem.aspx?id=155710",""]],"verses":[["كَفَوني وَما اِستَكفَيتُهُم مِن ضَراعَةٍ","تَرافُدَ أَيدي الأَبعَدينَ عَلى نَصري",0,"ر",2,0],["كَفَوا إِذ أَتى الهامَرزُ تَخفِقُ فَوقَهُ","كَظِلِّ العُقابِ إِذ هَوَت فَتَدَلَّتِ",1,"ت",1,0],["كَفَوا خُزرَ تَغلِبَ نَصرَ الرَسولِ","وَنَقضَ الأُمورِ وَإِمرارَها",2,"ر",3,0],["كفوا ابن غنام أو كفوا أخا شجر","من قبل أن تتلقوا نارهم حطبا",3,"ب",2,0],["كفُّوا حديث العذل عن مسمعي","فأين من يعقل أو من يعي",4,"ع",2,1],["كفورٌ أبى إلا جُحُوداً لنعمةٍ","تُكذِّبه شهّادُها حين يجحدُ",5,"د",1,0],["كَفَونيها وَلَم يَتَواكَلوها","بِخُلقٍ لا أَلَفُّ وَلا عَثورُ",6,"ر",1,0],["كُفّو وَإِلّا فاِرقُبوا ليَ بَطشَةً","يُلقى السَفيهُ بِمِثلِها فَيُحلَّمُ",7,"م",1,0],["كُفّوا وَإِلّا كَفَفتُم مُضمِري أَسَفٍ","إِذا تَنَمَّرَ في إِقدامِهِ النَمِرُ",8,"ر",1,0],["كُفُّوا فلستُ أُعَرِّضُ الحَسَبَ الذي","لا خِلْطَ فيه لمَعْشَرٍ أَخلاطِ",9,"ط",1,0],["كفؤٌ كَفَى اللَّه في الدهرِ الغشيمِ به","خَطْباً يخاطبُ منه ألْسُنَ العُضَلِ",10,"ل",1,0],["كَفَوا سَنِتينَ بِالأَصيافِ بُقعاً","عَلى تِلكَ الجِفارِ مِنَ النَفِيِّ",11,"ي",1,0],["كَفّوا عِنانَكَ إِذ جَرَيتَ وَلَو","خَلَّوا عِنانَكَ لَم تَزَل تَجري",12,"ر",2,0],["كُفُّوا بني حارثٍ ألحاظَ ريمِكُم","فكلُّها لفؤادي كلِّهِ شَرَكُ",13,"ك",1,0],["كَفُؤَانِ مَا أَحْلَى لِقَاءَهُمَا وَمَا","أَعْلَى رَجَاءُ المَجْدِ وَالأَخْطَارِ",14,"ر",1,0],["كُفُؤَانِ قَدْ صَلحَا لِيَنتظِمَا","فِي الْبَيْتِ أَكْمَلَ شَطْرَهُ الشّطْرُ",15,"ر",1,0],["كُفُؤَانِ صَفْوَ الْعَيْشِ أَنْ يَتَلاقَيَا","لا نَغَّصَتْهُ عَلَيْهما الأَقْدَارُ",16,"ر",1,0],["كُفُؤَانِ يَبْدُو لِلْنَوَاظِرِ مِنْهُمَا","لُطْفُ التَّشَابُهِ بِالْحِلَى وَالذَاتِ",17,"ت",1,0],["كَفَوْا إذْ أتَى الهَامَرْزُ تَخفِقُ فوْقَه","كظل االعقاب،اٍذهوت ،فتدلت",18,"ت",1,0],["كُفُّوا خطوبَ الدهرِ عنّي","أن أصبر بها كَظِيما",19,"م",2,0],["كَفَوا إِساةَ السَيِّ مَن تَكَلَّفا","كانوا لِأَهلِ الخافِقَينِ سَلَفا",20,"ف",2,0],["كُفُّوا ظباءً في مَسارحكم","تَسبى إذا غُزيتْ ولا تُسْبَى",21,"ب",2,0],["كفوت زبيد ثم عادت ومثلها","رأى الآية الكبرى بيافع والثغر",22,"ر",1,0],["كفوا الملام فلست أوّل بائس","يستبدل الأفراح بالأحزان",23,"ن",1,0],["كفّوا الملام فآمالي محطّمة","شيّعتها بالبُكا فالطرف سحّاحُ",24,"ح",1,0],["كَفُؤٌ إِذا نيطَت مُلِمّا","تُ الأُمورِ بِهِ كَفاها",25,"ا",3,0],["كفّوا أذاكم وتوبوا","وراقبوا الله فينا",26,"ن",2,0],["كُفؤاً بحسنِ شمائلٍ لو أنّها","في البدرِ لم يكلف لِنيل تتمّمِ",27,"م",1,0],["كفْؤُكّفِ الولِيِّ لم يُرَ للكُت","تابِ يوماً في الحُدْث والقدماء",28,"ا",2,0],["كَفو البتول وَلا كفو سواهُ لَها","وَالأَمر يَكشِفُهُ أَمرٌ يُوازيهِ",29,"ي",2,0],["كفوا اللواحظ عن صب أخي تلف","حتى يعاني الذي قد جاء يقصده",30,"ه",1,1],["كُفُوا بدلالة الكافي عليهم","بحرصٍ ما ادعى لهم الفخارُ",31,"ر",1,0],["كُفُّوا عن الأوراق العاديِّ إنكم","لا تستطيعون نقل الأوْرق العادي",32,"د",2,0],["كفؤادِ المحبِ أضمرَ شوقاً","وكدمعِ المتيمِ المستهامِ",33,"م",1,0],["كفؤاد توفيق الذي أخلاقه","دلت على آداب أفضل كاتب",34,"ب",1,0],["كفؤ لنبي وكفؤ أعلى جنة","خيرت له بشهادة وصداق",35,"ق",1,0],["كفوفهم أمطرت قطر النضار على","ارض العفاة بجود غيثها همرا",36,"ر",2,0],["كفؤان ما لكليهما كفؤٌ يرى","في العالم العلوى والسفلان",37,"ن",1,0],["كفَّوا الملامة أيّها العذّالُ","فسلوّ قلبي في الغرام محالُ",38,"ل",1,1],["كفّوا مطامعكم عنا أليس لكم","مما جنيتم وما تجنونه شبع",39,"ع",1,0],["كُفوا أَيا عَذلي إِذ لَست أَسلاها","ما دُمتُ طولُ المَدى بِاللهَنا حَيّا",40,"ا",1,0],["كفٌّ واعطاءٌ وجودٌ فائقٌ","بحرٌ وأمواجٌ وسيلٌ مفعم",41,"م",1,0],["كفوا بنى الانسان ما","هذا التمادى في الغرور",42,"ر",1,0],["كفّوا الملامَ فما فؤادي حاضرٌ","من بعده بل غائب في حاضر",43,"ر",1,0],["كفؤادِ أمِّ موسى","فارغاً منَ المعاني",44,"ن",2,0],["كفوفة الظفر تخفي من مهانتها","ومثلها في سواد العين مشهور",45,"ر",1,0],["كفوفي تكف الحادِثات وَساعدي","مساعد عن فاقد العون ناهك",46,"ك",1,0],["كَفٌّ وَوَجهٌ لا يَزالا مِنهُما","تَتَهَلَّلُ الأَنواءُ وَالأَنوارُ",47,"ر",1,0],["كفُّوا البكا ثمَّ الاسى يا آله","اذ روحهُ لالهه قد سلَّما",48,"م",2,0],["كفؤ يقول أنالها","وكفاك شاهد منظري",49,"ر",2,0],["كفوا فقد تواترت","أخبار خير مرسل",50,"ل",1,0],["كَفَوْا ما كَفَوْا ثم انثنوا بعد شدّة","أصابتهم في ذلك الموقف الضنك",51,"ك",1,0],["كَفوا العَنا مَعشَر الاِخوانِ وَاتَّئِدوا","فَالمَوتُ كَأس وَمِنها الكُل يَرتَشِفُ",52,"ف",1,0],["كفوا فما أحلى عذابي في الهوى","عندي إذا كان المعذب ذاكا",53,"ك",2,0],["كُفُّوا عن الإِساد حتى أنني","ممن أُحِبُّ بنظرةٍ أتزوَّدُ",54,"د",1,0],["كفؤ أبكار العلى الناصب في","أوج كيوان اللواء الأصفرا",55,"ر",2,0],["كَفوا البُكاءَ فَبالنَعيمِ مورخاً","يَلجِ العَظيم الربح في وَزناتِهِ",56,"ت",2,0],["كفوا البُكاءَ فَإِن اللَهَ أَجلسهُ","حَياً عَلى صَدرِهِ بَعَ الأَحايينِ",57,"ن",1,0],["كَفواق مَحلوب عَناء صَريعها","وَعَقيب ذلِكَ راحَة وَحَبور",58,"ر",1,0],["كُفّوا عَذلي فَلَومُكُم إِغراءُ","وَالنُصحُ بِمَنصِب الهَوى إِزراءُ",59,"ا",2,1],["كفو لكل بديعة عربية","خود إليك تزفها الشعراء",60,"ا",2,0],["كفّوا البكا يا آل داغر وانثنوا","للشكر بالتسليم والتنزيهِ",61,"ي",2,1],["كُفّوا البكا يا آل خازِنَ واصبروا","فالموت حتمٌ في البريَّة أمرهُ",62,"ه",1,1],["كفُّوا ولوموا إن أردتُمْ من بِهم","فيكم تغلغلَ نافثاً وَسواس",63,"س",1,0],["كُفَّ وانسَ الوئامَ لستَ بأهلٍ","وانعدامُ الأمانِ منكَ وعيدُ",64,"د",1,0],["كفو عن عشرة رجاجيل ومدد","ربي بَعِّدها عيون الحاسدين",65,"ن",1,0],["كفوا يابو متعب صبت بالرأي ياهديف","رفيع المقام ورميتك ماتضيعها",66,"ع",3,0],["كُفّوا الْعذابَ ألا تَبَّتْ مقاصِدُكمْ","عن أرضِ مصرَ أميطوا الذُّلَّ والعارا",67,"ر",2,0],["كُفّوا عَنِ اليَمَنِ الْمُشَتَّتِ شَمْلُهُ","بِقَذَائِفٍ مِثْلَ السَّحَابِ إِذَا هَتَنْ",68,"ن",1,0],["كُفّوا لُعِنْتُمْ زُمْرَةً لَمْ يَفْقَهوا","لُغَةَ الْحِوَارِ لِخَمْدِ نَائِرَةِ الضِّغَنْ(١٣)",68,"ن",1,0],["كفو الشيخ الهدى أو من يقاربه","أو كان بالعلم معروفاً ولو كانا",69,"ن",2,0],["كفّوا الطبول فهاك قول قاسِ","يا طبل تقرع في هوى الأرجاس",70,"س",1,1],["كفوا رأى شخصه الإسلام يرشده","دين الذي هو لم يولد ولم يلد",71,"د",1,0],["كفّوا عن الآفاق هرطقة","قد يمنع الأمطار تهويشُ",72,"ش",1,0],["كُفُّوا !فَقَدْ سَكَنَتْ حَشَا كَبِدِي","أَقْوَالُكُمْ مِنْ نَيْلِهَا صِفْرُ",73,"ر",1,0],["كفوا الحَديثَ عَنِ الوَفاءِ بِرَبِكُمْ","خَجِلَ الوَفا مِنْ نَهْشِكُمْ في لَحْمِهِ",74,"م",2,0],["كفُّوا فليس القلب عنه براحل","كيف الرواح ورحت فيه بمنسل",75,"ل",1,0],["كفوا النفاقَ بقولكم وبفعلكمْ","عارٌ عليكمْ قالها الغلمانُ",76,"ن",1,0],["كفوا فلا تقربوا منها فإن لها","حراس يحمونها عن ناظر جهرا",77,"ر",2,0],["كفوا وما كفهم عنه لتبقية","بل خيفة من حسام لا يبقيها",78,"ي",3,0]]}