{"poems":[[55,"رجونا أبا الهيجاء إذ مات حارث","https://www.aldiwan.net/poem30665.html","الطويل"],[32,"ألا أيهذا المنزل الدارس اسلم","https://www.aldiwan.net/poem29526.html","الطويل"],[29,"قولي لهم يا عبل قد خاب قينكم","https://www.aldiwan.net/poem5945.html","الطويل"],[39,"يفوت ذوي المفاقر أسهلاه","https://www.aldiwan.net/poem7429.html","الوافر"],[72,"لها خفر يوم اللقاء خفيرها","https://www.aldiwan.net/poem42923.html","الطويل"],[40,"بان الأحبة بالعهد الذي عهدوا","https://www.aldiwan.net/poem7699.html","البسيط"],[71,"رعى الله عيشا بالمعرة لي مضى","https://www.aldiwan.net/poem28441.html","الطويل"],[33,"يقول خليلي إذ أجازت حمولها","https://www.aldiwan.net/poem42550.html","الطويل"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[50,"وظبي تقسم الآجال","https://www.aldiwan.net/poem66189.html","الهزج"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16706","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42647","الوافر"],[119,"هل هداك الله ففاضت عيوننا","https://www.aldiwan.net/poem41255.html","عموديه"],[136,"برى جسمي المرور على المغاني","https://www.aldiwan.net/poem54716.html","الوافر"],[214,"أدر يا طلعة البدر","https://www.aldiwan.net/poem13362.html","مجزوء الوافر"],[234,"يعد وجيع الوجد ما هيج البعد","https://www.aldiwan.net/poem51175.html","الطويل"],[234,"ألا سقني بالملا الصحصح","https://www.aldiwan.net/poem51188.html","المتقارب"],[264,"عرائس حسن بالجمال تجلت","https://www.aldiwan.net/poem35563.html","الطويل"],[302,"سقى صوب الحيا أرض الحجاز","https://www.aldiwan.net/poem33244.html","الوافر"],[302,"أشارت من لها في الحسن شاره","https://www.aldiwan.net/poem33259.html","الوافر"],[371,"تخوف منها أن يقول متى الوعد","https://www.aldiwan.net/poem16972.html","الطويل"],[371,"أبى الدمع أن يشفى به هم هائم","https://www.aldiwan.net/poem17262.html","الطويل"],[376,"وما يرد الدهر إلا يد","https://www.aldiwan.net/poem57445.html","السريع"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130199","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37986","الطويل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132857","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108737","الوافر"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[2113,"","https://poetry.dctabudhabi.ae/diwan/poem/205701","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121017","الرجز"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121186","البسيط"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110752","الوافر"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86568","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69975","الوافر"],[4727,"نسيبٌ وهجاءْ","https://www.poetsgate.com/ViewPoem.aspx?id=211408",""],[5054,"الله أكبر","https://www.poetsgate.com/ViewPoem.aspx?id=215081",""],[5186,"أرقت وهاجتني وقد هجع الركب","https://www.poetsgate.com/ViewPoem.aspx?id=156457",""],[5403,"على قمر الاقبال في أفق اليسر","https://www.poetsgate.com/ViewPoem.aspx?id=187604",""],[444,"صباح مُحلّى حُبّا","https://www.poetsgate.com/ViewPoem.aspx?id=184403",""],[5759,"مُسَهِّدَتي","https://www.poetsgate.com/ViewPoem.aspx?id=213782",""]],"verses":[["لَها خَدَشاتٌ بِالمَوامي كَأَنَّها","عَلى لَقَمِ البَيداءِ أَيدٍ عَوابِثُ",0,"ث",1,0],["لَها خَطَراتُ العَهدِ مِن كُلِّ بَلدَةٍ","لِقَومٍ وَإِن هاجَت لَهُم عِطرُ مَنشِمِ",1,"م",1,0],["لَها خُنزُوانٌ في خُزَيمَةَ لَم تَزَل","تَنَقَّلُ مِنهُ في سَنامِ وَحارِكِ",2,"ك",1,0],["لها خِبَ تلوذ به وليست","بضائعة الجنين ولا مذول",3,"ل",1,0],["لَها خَفَرٌ يَومَ اللِقاءِ خَفيرُها","فَما بالُها ضَنَّت بِما لا يَضيرُها",4,"ر",3,1],["لَها خُصورٌ وَأَعجازٌ يَنوءُ بِها","رَملُ الغِناءِ وَأَعلى مَتنِها رُؤُدُ",5,"د",1,0],["لها خَبَرٌ في طيبِها فَهْيَ مبتدا","فمرفوعُها ما كانَ عندي لَيُخْفَضا",6,"ض",2,0],["لَهُ اِختَلَجَت عَيني أَظُنُّ عَشِيَّةً","وَأَقبَلَ ظَبيٌ سانِحٌ كَالمُبَشِّرِ",7,"ر",1,0],["لها خُلُقُ الصَّواعقِ حين تُغْفِي","فما يُمْسَكْنَ حتّى يَرتمِينا",8,"ن",2,0],["لَهُ آخِرَةٌ قَد أَش","بَهَت في الحُسنِ دُنياهُ",9,"ا",2,0],["لها خَدَمٌ وأقْرِطَةٌ ووُشْحٌ","وأسْوِرَةٌ ثَقَائِلُ إنْ وُزِنّه",10,"ن",2,0],["لَهَا خَدٌّ بِهِ لِلْحُسْنِ وَرْدٌ","وَلَحْظٌ فِيهِ لِلْمَلَكَيْنِ سِحْرُ",11,"ر",1,0],["لها خطرات في القلوب ملحة","كستها من البث العريض جلاببا",12,"ب",2,0],["لَهَا خدٌّ يُضاهِي البَدرَ حُسناً","يَقُودُ المُرعوي سَلِسَ العِنَانِ",13,"ن",1,0],["لها خال كمسك فو","ق ياقوت على در",14,"ر",1,0],["لها خُلُق في كلّ يوم من الجفا","طريفٌ له بين الحشى حُرَق تُلْد",15,"د",1,0],["لها خَفَر البكر لكنّها","تزيد على خُدَع القُرَّح",16,"ح",1,0],["لها خلعٌ من نسج حال خلاعةٍ","بتلوين لبس الحال في كلّ صورة",17,"ه",1,0],["لَها خَفَرٌ حَماها قبل تُسمى","وَيَعزوها إِلى الآباء عازِ",18,"ز",1,0],["لها خَدٌّ تَسعَّرَ جلُّ ناري","به لَمّا أَراني جُلَّنارَه",19,"ر",2,0],["لَها خُلُقٌ ما فيهِ لِلحَمدِ مَوضِعٌ","وَلِلوَجهِ مِنها قُلْ هُوَ اللَهُ وَالحَمدُ",20,"د",1,0],["لَها خَلَّةٌ بَل حُلَّةٌ عَرَبِيَّةٌ","وَرُبَّ فَصيحٍ ما رَأى دارَ دارِمِ",21,"م",1,0],["لها خُطوبٌ بالردَى تُتَّقى","وحادِثاتٌ بالندى تَجري",22,"ر",2,0],["لها خيال يريني الشمس بازغة","ليلاً ووقت الضحى الجوزاء والشهبا",23,"ب",2,0],["لها خفرٌ في كلِّ وَقتٍ خَفيرُها","وكيفَ ومِن أسَدِ العرين يُجيرها",24,"ر",3,1],["له أَخَوَاتٌ مِثلُه ألفت ثنى","على مثل ما كَانَا زماناً تألَّفا",25,"ف",2,0],["لها خال يتيّم كل خالٍ","على خد يفرِّح كل عابس",26,"س",1,0],["لَها خُفّانِ قَد ثُلِبا وَرَأسٌ","كَرَأسِ العَودِ شَهبَرَةٌ نَؤولُ",27,"ل",1,0],["لها خلقٌ جزلٌ ورأيٌ ومنطقٌ","وخلقٌ مصونٌ في حياءٍ ومصدق",28,"ق",1,0],["له أخٌ أفضلُ منه لم تزل","آثاره محمودةً في الشرعِ",29,"ع",1,0],["لها خيال تريك الشمس بارقة","ليلا ووقت الضحى الجوزاء والشهبا",30,"ب",2,0],["لها خدر تصان به منيع","مهابٌ عند ذي البطش المهابِ",31,"ب",1,0],["لها خطرات بالمثاني كأنما","شواكلها تحت السروج خصور",32,"ر",1,0],["لَهُ اختارَ المُهيمنُ وَارتضاهُ","فَلَم يَرَ في صِباه ما يَشينُ",33,"ن",1,0],["لَهَا خَصْرٌ يَزِينُ الَمتْنَ مِنها","لهَا صِفْرٌ كَنَافُورِ السَّواقيِ",34,"ق",2,0],["( لها خال على صفحات خدٍ","كَنُقطةَ عنبر في صحنِ مرمر",35,"ر",1,1],["لها خلف من بعد شيب تخلفوا","فحول على حب النهوض بها شبوا",36,"ب",3,0],["له أخوة حازو وأبناهم هدا","بأجدادهم أهل النوال بني الفخر",37,"ر",1,0],["لها خطوة في الأرض يأسر خطوها","فآنس من خطْواتها فرحة الثرى",38,"ر",2,0],["لها خدّانِ مثلُ الوردِ لوناً","تَفرَّدَ وجهُها بِهمِا ٱنفرادا",39,"د",2,0],["لها خَصرٌ نحيفٌ في قَوامٍ","كغُصنِ البانِ في مَيَسٍ تهادى ٦",39,"د",2,0]]}