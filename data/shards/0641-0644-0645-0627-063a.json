{"poems":[[9,"أترحل من ليلى ولما تزود","https://www.aldiwan.net/poem21924.html","الطويل"],[53,"أيها المتحفي بحول وعور","https://www.aldiwan.net/poem66402.html","الخفيف"],[72,"سروري كان أن ألقاك يوما","https://www.aldiwan.net/poem42413.html","الوافر"],[64,"هو العتب حتى ما يرد سلام","https://www.aldiwan.net/poem52295.html","الطويل"],[63,"هم صرموا حبل الهوى فتصرما","https://www.aldiwan.net/poem51445.html","الطويل"],[46,"عفت أربع الحلات للأربع الملد","https://www.aldiwan.net/poem30536.html","الطويل"],[107,"أبا رافع لا يرفع الله طاغيا","https://www.aldiwan.net/poem43582.html","الطويل"],[41,"أساءك تقويض الخليط المباين","https://www.aldiwan.net/poem53738.html","الطويل"],[52,"لحى الله حماد بن نهيا فإنه","https://www.aldiwan.net/poem63895.html","الطويل"],[41,"أَسَاءَكَ تَقْوِيضُ الخَلِيطِ المُبَايِنِ","https://www.poetsgate.com/ViewPoem.aspx?id=4309",""],[119,"قديما كان في الدنيا اناس","https://www.aldiwan.net/poem41199.html","عموديه"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[234,"ألا أيها الطير الموافي","https://www.aldiwan.net/poem51187.html","الوافر"],[305,"فمثلك ألوى بالفؤاد وزار بالعداد","https://www.aldiwan.net/poem45486.html","الطويل"],[327,"أرقت وصاحباي ببعلبك","https://www.aldiwan.net/poem56348.html","الوافر"],[369,"وبرق مشيب في ظلام ذوائب","https://www.aldiwan.net/poem60634.html","الطويل"],[409,"بروق بأكناف الحمى تتردد","https://www.aldiwan.net/poem33980.html","الطويل"],[411,"أبا قاسم كم ظالم متعجرف","https://www.aldiwan.net/poem49444.html","الطويل"],[463,"أيوما مثل يوم الجزع","https://www.aldiwan.net/poem55890.html","مجزوء الوافر"],[463,"ألا يا خليلي المجتبى من خزيمة","https://www.aldiwan.net/poem56184.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138441",""],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107203","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79823","المتقارب"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76827","الوافر"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89535","الطويل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21434","الطويل"],[3055,"","https://poetry.dctabudhabi.ae/diwan/poem/131358","الطويل"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17772","الطويل"],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5587,"إرادة الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=191323",""],[5603,"بأرضٍ نأت عن والديها كليهما","https://www.poetsgate.com/ViewPoem.aspx?id=181686",""],[5701,"تعجبت حتى كدت لا أتعجب","https://www.poetsgate.com/ViewPoem.aspx?id=164590",""]],"verses":[["فَلَمّا غَدا يَومَ الرُقادِ وَعِندَهُ","عَتادٌ لِذي هَمٍّ لِمَن كانَ يَغتَدي",0,"د",2,0],["فَلِما غابَ من أُمورِكَ عُنْوا","نٌ مُبينٌ وللزّمانِ لسان",1,"ن",1,0],["فَلَمّا غابَ عَن عَيني كَراها","خَلَت مِن ساكِنٍ فَسَكَنتُ فيها",2,"ي",3,0],["فلمّا غدا والدهرُ طوعُ مرادهِ","وفي يدِه للحادثاتِ زِمامُ",3,"م",1,0],["فلمَّا غَدا عَضباً صقيلاً وذابِلاً","خَطيراً وملمومَ السَّراةِ مُسوَّما",4,"م",2,0],["فَلَم أَغشَ باباً أَنكَرَتني كِلابُهُ","وَلَم أَتَشَبَّث بِالوَسيلَةِ مِن بُعدِ",5,"د",1,0],["فلمَّا غَفا السُّمارُ أقبلَ صَاعِداً","إلى الأخرقِ المغرورِ يَعلو المراقيا",6,"ي",2,0],["فَلَمّا غَدا اِستَذرى لَهُ سِمطُ رَملَةٍ","لِحَولَينِ أَدنى عَهدِهِ بِالدَواهِنِ",7,"ن",1,0],["فَلَمّا غَدا في المُلكِ ضاقَت بِهِ اِستُهُ","وَآلى يَميناً لا يَجودُ عَلى أَحَد",8,"د",1,0],["فَلَمَّا غَدَا اسْتَذْرَى لَهُ سِمْطُ رَمْلَة ٍ","وبالغسلِ إلاَّ أنْ يميرَ عصارة",9,"ه",1,0],["فلما غال فعل الخير دهر","انوف الزهر فيه مرغمات",10,"ت",1,0],["فَلمّا غَدا في سِربه اليومَ آمناً","بِكشفِ مَخازيهِ غَدا يُظهرُ الفَخرا",11,"ر",2,0],["فَلمّا غَزاهم لَم تُفِدهم وأَشبهوا","أَرانبَ مِن خَوفٍ بها لَزِمت وكرا",12,"ر",2,0],["فلما غاب في التِّذْكار فهمي","وحسّي حيث تَصْفِق بالجَناحِ",13,"ح",1,0],["فَلَمّا غَسى لَيلي وَأَيقَنتُ أَنَّها","هِيَ الأُرَبى جاءَت بِأُمِّ حَبَوكَرا",14,"ر",2,0],["فَلَمّا غَمَّها بِالماءِ أَجلى","بِإِقلاعٍ بَطيءٍ غَيرِ وَشكِ",15,"ك",1,0],["فلمّا غدا عِبْئاً على جَفْنِ ناظري","لقاءُ الورَى من صاحبٍ وخَدين",16,"ن",1,0],["فلم أغترب عنها لتفضيل غيرها","وقد كان لي فيها عهاد ومعهد",17,"د",1,0],["فلّما غَر في ظُلمِهِ وَعتُوِّهِ","وأشبَهَ عِيراً لجَّ في نزَوانِهِ",18,"ن",2,0],["فلم أُغبن ولم أقرَعْ","بشوكة ناجِذي نَدَما",19,"م",2,0],["فلما غدت مجنوبةً في حبالهم","تواصَوا عليها بالخيانة والغدرِ",20,"ر",1,0],["فلم أغفل مقاما او ضريحا","ولم أهمل نبيا أو نبيه",21,"ي",2,0],["فلَمّا غَدونا حَولَ بُستانِهِ إِذا","بِهِ جَنَّةُ الدُّنيا لِمَن كانَ يُبصِرُ",22,"ر",1,0],["فلِم أغفلت بك أوتارَها","وليست تعاجل إمكانَها",23,"ن",3,0],["فلما غاب عن عيني على","وعاد بياض نورهما سحاما",24,"م",2,0],["فَلَما غال فعلَ الخَيرِ دَهرٌ","به عاشَ الخَنا وَالمَكرُ ماتوا",25,"ت",3,0],["فَلَمّا غَشانا بَعدَهُم لَيلُ فِتنَةٍ","بِهِ عَمَّ نَهبُ المالِ وَالسَفكُ لِلدَّمِ",26,"م",1,0],["فَلَمّا غَدَت قَد قَلَّصَت غَيرَ حشوَةٍ","مِنَ الجَوفِ فيهِ عُلَّفٌ وَخُضوبُ",27,"ب",1,0],["فلما غدت أجبال تيرس خلفها","وأرطاتها ثارت بنا ثورانا",28,"ن",2,0],["فَلَمّا غَلَبنا المُلكَ لا يَقسِرونَنا","قَسَطنا فَأَقبَلنا مِنَ الهَيلِ وَالبِشرِ",29,"ر",1,0],["فلما غدا من إذا في جبينه","وحان بسر الله أن يعد ولكنما",30,"م",2,0],["فَلَمَّا غَدَوْتُ بِأَصْحَابِهِ","أَصَابَتْ فُؤَادِي جِرَاحٌ أُخَرْ",31,"ر",1,0],["فلما غدا للمال ربا ونافست","لإعجابها فيه عيون الكواعب",32,"ب",1,0],["فلما غفا عن واجب الملك والتوى","هوى مثلما يهوي من الأفق كوكب",33,"ب",1,0]]}