,"https://poetry.dctabudhabi.ae/diwan/poem/52154","المقتضب"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52171","الرمل"],[1703,"أنا حرٌّ هذي البلاد بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=49866",""],[4929,"تطريز كلمة الوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=205025",""],[4978,"أيها الآتون من خلف البحار","https://www.poetsgate.com/ViewPoem.aspx?id=177174",""],[5111,"رَحَلُوا","https://www.poetsgate.com/ViewPoem.aspx?id=212625",""],[5136,"أسد غودر في القاع الجدد","https://www.poetsgate.com/ViewPoem.aspx?id=121559",""],[5174,"لغة الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=199065",""],[3071,"أَيهَا الْأَمْرَد المولع بالهج","https://www.poetsgate.com/ViewPoem.aspx?id=189680",""],[5302,"أيها الحلو","https://www.poetsgate.com/ViewPoem.aspx?id=200602",""],[5320,"أنا الشعب","https://www.poetsgate.com/ViewPoem.aspx?id=40426",""],[1824,"أيها الأوحد الفريد سلام","https://www.poetsgate.com/ViewPoem.aspx?id=170048",""],[5377,"الأمن الزائف","https://www.poetsgate.com/ViewPoem.aspx?id=61898",""],[333,"نشيد الصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=101256",""],[5436,"مناجاة بين بوش وكلبه! ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35272",""],[5473,"أَيهَا الأوحد الرضي الَّذِي طا","https://www.poetsgate.com/ViewPoem.aspx?id=189603",""],[5542,"أيها العالم","https://www.poetsgate.com/ViewPoem.aspx?id=10056",""],[5628,"قصيدة حب للأطفال","https://www.poetsgate.com/ViewPoem.aspx?id=178755",""],[5956,"هدايا للأطفال العرب من صهيون","https://www.poetsgate.com/ViewPoem.aspx?id=192184",""],[5970,"خذ من الدنيا الذي أعطت ولا","https://www.poetsgate.com/ViewPoem.aspx?id=130593",""],[5970,"آه لو كانت تفيد النفس آه","https://www.poetsgate.com/ViewPoem.aspx?id=130619",""],[6115,"خذ من الأمس دروسا وعبر","https://www.poetsgate.com/ViewPoem.aspx?id=181639",""],[6228,"جسد واحد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85971&r=&rc=8",""],[549,"سيرةٌ إنسانيَّةٌ للرِّمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87656&r=&rc=8",""],[6345,"نشيد الوصل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78661&r=&rc=32",""]],"verses":[["أَيُها الآملُ ما لَيسَ لَهُ","رُبَّما غَرَّ سَفيهاً أَمَلُه",0,"ل",2,1],["أَيُّهَا الآلُ وَالمَحِبونَ مِنْ وَا","شِجِ عِرْقٍ وَمِنْ وَلِيٍّ حَمِيمِ",1,"م",1,0],["أيها الانكليز لن نتناسى","بغيكم في مساكن الفلوجه",2,"ج",2,1],["أيّها الأنجم التي قد رأينا","عبراً في أفولها كالشموس",3,"س",1,1],["أيها الأنجم التي تركتنا","في أسىً من مصابها محسوس",3,"س",1,0],["أيها الأرض سرتِ سيرك مثنى","ذا نتاجين في زمان أحاد",4,"د",1,0],["أيها الأشْيَبُ المسوِّد لَمَّا","آلَ إنفاقُه إلى إكسادِهْ",5,"د",2,0],["أيُّها الأعورُ لِمْ جشَّمْتَني","أن أشُقَّ الرمسَ عن والدتِكْ",6,"ك",1,1],["أيها الآملُ البعيدُ من الغُنْ","م تذكر ما دونه من غرامَهْ",7,"ه",1,1],["أَيُّها الآتونَ مِن ذاكَ الحِمى","يا دُعاةَ الخَيرِ يا رَمزَ الشَبابِ",8,"ب",1,0],["أيها الأجواد لا نجزيكم","لذة الخير من الخير بديل",9,"ل",1,0],["أَيُّها الأَعرَجُ المُحَجَّبُ مَهلاً","لَيسَ هَذا مِن فِعلِ مَن يَتَمَرّى",10,"ر",2,1],["أَيُّها الآمِري بِتَركِ التَصابي","رُمتَ مِنّي ما لَيسَ في إِمكاني",11,"ن",2,0],["أَيُّها الأَروَعُ الَّذي لَفظُهُ وَال","فَضلُ بَينَ الأَنامِ زاهٍ وَزاكِ",12,"ك",1,0],["أيها الآمرُ في مُلكِ الهوى","اعفُ عن لهفةِ روحي وأواري",13,"ي",1,0],["أيها الآسي لناري هذه","ما الذي تصنع بالنار الدفينه",14,"ه",1,0],["أيها الأيك غدونا حوله","نسماً في الأيك موصول الحفيف",15,"ف",1,0],["أَيُّها الأَيِّدُ","جاءَ يَومَ الحِساب",16,"ب",1,0],["أيها الأغنياء لا تجهلوا ما","يحمل البائسون والبائسات",17,"ت",1,0],["أيها الأحياءُ غنُّوا واطربوا","وانهبوا من غفلاتِ الدهرِ ساعا",18,"ع",2,0],["أيها الأحياءُ ما الكونُ إذا","تنثرُ الشُّهْبُ وتندكُّ الشموسْ",19,"س",1,0],["أيها الأحياءُ يا أسرى القضاء","كيف أمسيتم بدنيا الحدَدِ",19,"د",1,0],["أَيُّها الأَجوادُ لا نَجزيكُمو","لَذَّةُ الخَيرِ مِنَ الخَيرِ بَديل",20,"ل",1,0],["أَيُّهَا الأَوْفِياءُ مِمًّنْ أَجَابُوا","دَاعِيَ البِرِّ بِابْنِ مِصْرَ الأَبَرِّ",21,"ر",1,0],["أيها الأغنياء إن غناكم","شيّدته سواعد الفقراءِ",22,"ا",2,1],["أَيُّها الآمِرونَ بِالصَبرِ وَالنا","هونَ عَنها وَالناصِحونَ جُيوبا",23,"ب",2,0],["أيّها الأغنياءُ أين نَداكُمْ","بَلَغ السّيْلُ عالياتِ القِلالِ",24,"ل",1,0],["أيها الأزهري يا سارق النار","ويا كاسرا حدود الثواني",25,"ن",2,0],["أيها الأنصارُ، هذا يومُكم","يا سيوف اللهِ في حربِ الطغاة",26,"ا",2,0],["أيها الآتي بلا وجه إلينا","لم تعد منا ولا ضيفا علينا",27,"ن",2,1],["أيّها الآكلون عرضي لأنّي","كنت ألعوبة لديكم أسيره",28,"ر",2,0],["أيّها الأقوياء لينا وعطفا","أشعوبها ترعونها أم سواما",29,"م",2,0],["أيها الآتي بلا وجه إلينا","لمتعد منا ولا ضيفا لدينا",30,"ن",2,1],["ايها الابيض اضعفت القوى","هز في صف الاعادي اسمرك",31,"ك",1,0],["أيُّها الانسان صبرا","إنَّ بعد العسر يسرا",32,"ر",2,1],["أيها الآمل الصفاء مع الدهر","ترفق بنفسك الوسنانه",33,"ه",1,0],["أيها الأغنياءُ هل حرم اللَه","عليكم مآدبَ الفاقات",33,"ت",1,0],["أيها الأعزل الذي قد تحدى أمة","لم تلن لغير غوى",34,"غ",3,0],["أَيُّها الاهيف الَّذي أَهواهُ","صل محبا هَواكَ قَد أَفناهُ",35,"ا",2,1],["أيّها الآمرِي بصّدِيَ عنه","كيف صدُّ العطشانِ عن صَدّاء",36,"ا",2,0],["أيُّها الأوحَدُ الّذي مثْلُه العن","قاءُ في العزّ لا بَنو العَنقاء",36,"ا",2,0],["أَيُّها الآملونَ حُطّوا سَريعاً","بِرَفيعِ العماد واري الزِنادِ",37,"د",1,0],["أيّها الآبقُ إنْ لَمْ","تَرْجُ وَعْداً خَفْ وَعيدا",38,"د",2,0],["أيها الأعلام من ساداتنا","ومصابيح دياجي المشكل",39,"ل",1,1],["أيُّها الآخذ عن آبائه","سُنَنَ المعروف بالفعل الجميل",40,"ل",1,0],["أيها الأخذ قلبي مغنما","بلحاظٍ فاتناتٍ ونفار",41,"ر",1,0],["أيُّها الآسِرُ الأسيرُ تُقىً","ليسَ إلا اللهِ يَزدَلِفُ",42,"ف",1,0],["أَيُّها الآمِرونَ بِالصَبرِ عَمَّن","قَد بَدا في الضِياءِ مِنهُ ظَلامُ",43,"م",1,1],["أَيُّها الأَبلَجُ الَّذي","رَوضُ جَدواهُ ناضِرُ",44,"ر",1,1],["أيها الأقوام كونوا نبلا","وارفعوا بالله شأن التونسي",45,"ي",1,0],["أيها الأحرار أنتم","قد سعيتم للترقي",46,"ي",1,0],["أيها الأنفُ وَدَاعا","إنَّ فضلِي منك شَاعا",47,"ع",2,1],["أيُّها الآخذِي بِشَأنِ التسلِّي","جلَّ ما بي عن طاعةِ السُّلْوانِ",48,"ن",1,0],["أيّها الآملُ الحياةَ وما يخ","شى غروباً كما يرجّي طلوعا",49,"ع",2,0],["أيها الأقوام كفوا","عقلكم عن رب عالي",50,"ل",