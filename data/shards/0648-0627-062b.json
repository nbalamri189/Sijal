ml","الرمل"],[466,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[479,"أشجاك قمري الأراك مغردا","https://www.aldiwan.net/poem15234.html","الكامل"],[481,"القول كالبرق والأعمال كالمطر","https://www.aldiwan.net/poem37185.html","البسيط"],[502,"يا آلهي بدولة الأسماء","https://www.aldiwan.net/poem37720.html","الخفيف"],[502,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[502,"طار نحو الحبيب شحرور قلبي","https://www.aldiwan.net/poem37945.html","الخفيف"],[502,"أما والنجوم المشرقات من العلى","https://www.aldiwan.net/poem37987.html","الطويل"],[502,"رغبنا بأسرار الشهود لوجهكم","https://www.aldiwan.net/poem38082.html","الطويل"],[508,"بلغت أمير المؤنين مدى المنى","https://www.aldiwan.net/poem2405.html","الطويل"],[508,"اطلت على افقك الزاهر","https://www.aldiwan.net/poem2425.html","المتقارب"],[516,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[516,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[517,"أمنت من الغرام على فؤادي","https://www.aldiwan.net/poem12064.html","الوافر"],[517,"قدك مثل الغصن في اعتداله","https://www.aldiwan.net/poem12217.html","الرجز"],[522,"يا زمان العكس قلاب الأمور","https://www.aldiwan.net/poem818.html",""],[529,"أيدري السيف أي فتى يبيد","https://www.aldiwan.net/poem45970.html","الوافر"],[531,"هوت العقيق وما هوت فكأنها","https://www.aldiwan.net/poem37342.html","الكامل"],[538,"أتذكر داراً بين دمخ ومنورا","https://www.aldiwan.net/poem23850.html","الطويل"],[553,"أمالك من غرام ما أمالا","https://www.aldiwan.net/poem47319.html","الوافر"],[553,"لنا من ثناياك الغريض المرشف","https://www.aldiwan.net/poem47403.html","الطويل"],[553,"ولما أردت طروق الفتاة","https://www.aldiwan.net/poem47811.html","المتقارب"],[560,"بدر تم لاح في الغسق","https://www.aldiwan.net/poem34335.html","المديد"],[560,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[560,"يا عابدا ربا بتصويره","https://www.aldiwan.net/poem34459.html","السريع"],[560,"إني أنا فرضه وتقديره","https://www.aldiwan.net/poem34467.html","المنسرح"],[564,"منازل عسفان فدتك المنازل","https://www.aldiwan.net/poem52753.html","الطويل"],[564,"أرى الدهر يقضي كل يوم ديونه","https://www.aldiwan.net/poem52787.html","الطويل"],[566,"أعيدوا لنا التاريخ احيوا لنا الذكرى","https://www.aldiwan.net/poem854.html",""],[570,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[577,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"],[577,"أرى كل شيء في البسيطة قد نما","https://www.aldiwan.net/poem3021.html","الطويل"],[577,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[577,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[577,"تنزه طرفي بين زاه وزاهر","https://www.aldiwan.net/poem3073.html","الطويل"],[651,"","https://poetry.dctabudhabi.ae/diwan/poem/216877","الوافر"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/21480","الطويل"],[883,"","https://poetry.dctabudhabi.ae/diwan/poem/45538","الطويل"],[1080,"","https://poetry.dctabudhabi.ae/diwan/poem/2528","الخفيف"],[1162,"","https://poetry.dctabudhabi.ae/diwan/poem/28933","الطويل"]],"verses":[["وآثرت حفظ الدين بالصبر بعدما","أقمت لنشر الدين سيفا يجاهد",0,"د",1,0],["وَأَثني سَنَنَ الخَيلِ","بِهَبهابِ السُرى لَينِ",1,"ن",1,0],["وَأَثافٍ كَأَنَّهُنَّ رَذايا","وَأَسارى لا يَنظُرونَ فِكاكا",2,"ك",2,0],["واثِقاً بِالدَهرِ تُعطى","مِن رَزاياهُ وَثيقَه",3,"ق",2,0],["وَأَثاروا الدينَ مِن مَربِضِهِ","وَأَطاروا عَن مَجاليهِ الخِمارا",4,"ر",2,0],["وَأَثقَلُ مَحمولٍ عَلى العَينِ دَمعُها","إِذا بانَ أَحبابٌ وَعَزَّ إِيابُ",5,"ب",1,0],["وأثْبَتُها في حَومَةِ الحَرْبِ مالِكٌ","وعَوفٌ وذو الرُّمْحَينِ جَدُّكُمُ عَمْرو",6,"ر",2,0],["وآثارُها مَشهورَةٌ وغُمودُها","إذا جُرِّدَتْ هامُ المُلوكِ ولا فَخْرُ",6,"ر",1,0],["وآَثَرَ تَقْوَى اللَّهِ مِنْهَا فَلَمْ يَكُنْ","بِمُشْتَغِلٍ عَنْهَا بزيرٍ وَلاَ بَمِّ",7,"م",1,0],["وأثْبَتَ منْهُ الرّيقُ عيْنَ قَتادَةٍ","فأحْكَمَها من بعْدِ ما ذَهَبَتْ ردّا",8,"د",2,0],["وآثارُ مَلْكٍ ظاهِرِ الفَضْلِ لمْ يزَلْ","يُشَفَّعُ فِينا هَدْيُهُ وصَلاحُهُ",9,"ح",2,0],["وَأَثيثٍ جَثلِ النَباتِ تُرَوّي","هِ لَعوبٌ غَريرَةٌ مِفناقُ",10,"ق",1,0],["وَأَثارَت بي فَوادِحُهُ","كامِناتِ الهَمِّ وَالكَدَرِ",11,"ر",1,0],["وَأَثمَلَتها خَمرَةٌ مِن دَمٍ","يَلهو بِها الميكادُ وَالقَيصَرُ",12,"ر",1,0],["واثَقتُهُ أَلّا أَبوحَ وَإِنَّما","يَومَ الحِسابِ يُحَلُّ ذاكَ المَوثِقُ",13,"ق",1,0],["وَآثَرَ بِالمِلحاةِ آلَ مُجاشِعٍ","رِقابَ إِماءٍ يَقتَنينَ المَفارِما",14,"م",2,0],["وَأَثنى في هَوايَ عَلَيَّ خَيراً","وَيَسأَلُ عَن بَنِيَّ وَكَيفَ حالي",15,"ل",2,0],["وَأَثبَتُهُ داراً عَلى الخَوفِ ثَملُها","فُروعُ عَوالي الغابِ أَكرِم بِها ثَملا",16,"ل",2,0],["وَأَثَابَتْ بَغْدَادُ مَسْعَاكَ إِذْ بِ","تَّ وَفِيهَا لَكَ المَكَانُ المكينُ",17,"ن",1,0],["وَأَثِرْ غَيْهَبَ المِدَادِ وَأَرْسِلْ","صَعَقَاتٍ لَهَا انْقِضَاضُ الرجُومِ",18,"م",1,0],["وَآثَرْتَ مَيْدَانَ المُحَامَاةِ دُونَها","مَجَالاً رَحِيباً لِلمُرُوءةِ والعَزْمِ",19,"م",1,0],["وأثرت فيه للطراد فوارساً","مثل الشموس وجوهُهم تتهلّلُ",20,"ل",1,0],["واثنان سارا في طريق معاً","إلى حمى سورية العامره",21,"ر",2,0],["وأثبت بالسيوف لهم حقوقاً","مؤيّدةً بكل دم سيفك",22,"ك",1,0],["وَأَثنَوا عَلَيهِ بِالَّذي كانَ عِندَهُ","وَعَضَّ عَلَيهِ العائِداتُ الأَنامِلا",23,"ل",2,0],["وَأَثبَتَ فَرعاً في الفُروعِ وَمَنبِتاً","وَعوداً غَذاهُ المُزنُ فَالعودُ أَغيَدُ",24,"د",1,0],["وأثنى على جهدي بما هو أهله","وأظهر أفعال الجميل وأضمرا",25,"ر",2,0],["واثق الوعد من طرابلس الشا","م بجودٍ حيث التقى البحران",26,"ن",1,0],["واثقة بالرزق حيث كانا","تغدو خماصاً وتجي بطانا",27,"ن",2,0],["واثباتٍ على الظِّباء ضِعافٍ","عن وثابِ الأسود يومَ الوِثابِ",28,"ب",1,0],["واثنان لي منهما أجَلُّهما","عذرُ كريمِ الرجال أو نَشَبُهْ",29,"ب",2,0],["وآثره لما قدْ كا","ن يؤنس فيه من رشَدِهْ",30,"د",2,0],["واثبُتْ على الحسنى فقد طَمَحَتْ","نحوي ونحوَك أعين خُزرُ",31,"ر",1,0],["واثلثْ بحمدونةَ دعموصِ السِّككْ","شرُّ ثلاث تحت بُطنانِ الفلكْ",32,"ك",1,0],["واثقاً منك بالعطايا التي تس","عى إلى القاعدين غيرَ أوالِ",33,"ل",1,0],["وأثبتَ للأمرِ الذي يستديمه","أواخيَّ صدْقٍ أقسمتْ لا تَجَذَّمُ",34,"م",1,0],["وأُثيبَ سعيُك للإمام فلم تزل","لثغورهِ بجنود رأيكَ شاحنا",35,"ن",2,0],["وَأُثني عَلى الحَيَّينِ عَمرٍ وَمالِكٍ","ثَناءً يُوافيهِم بِنَجدٍ وَغائِرِ",36,"ر",1,0],["وَآثارُ الرِجالِ إِذا تَناهَت","إِلى التاريخِ خَيرُ الحاكِمينا",37,"ن",2,0],["وَأُثني عَلَيهِ بِآلائِهِ","وَأَقرُبُ مِنهُ نَأى أَو قَرُب",38,"ب",1,0],["واثنان في حكمتنا","أب قديم وولد",39,"د",1,0],["وأَثَّرَ في عُودي النُيوبَ وطالَما","تمنَّعَ واستعصَى عليها مكاسِرُهْ",40,"ر",2,0],["وآثرَهُ بالصَّيْدِ صَوْناً لنفسهِ","وكان مُعَاناً في الأمورِ مُؤَيَّدَا",41,"د",2,0],["وَأَثقَلُ مَن أَهجو عَلَيَّ مَغَمَّرٌ","أَظَلُّ بِإِسفافي إِلى هَجوِهِ أُهجى",42,"ج",2,0],["وَآثَرَكُم وَلَم يُؤثِر عَلَيكُم","وَقَد شَرَعَت لَهُ دُنيا المُعارِ",43,"ر",1,0],["وَأَثافٍ أَتَت لَها حِجَجٌ دو","نَ لَظى النارِ مُثَّلَ كَالأَثافي",44,"ف",2,0],["وَأَثني عَلى سَعدٍ بِما هِيَ أَهلُهُ","وَخَيرُ أَحاديثِ الغَريبِ صَدوقُها",45,"ق",3,0],["وآثارٌ تَمُرُّ بها اللَّيالي","وهُنَّ على جِباهِ الدَّهْرِ شامُ",46,"م",1,0],["وآثرتْ فيشةَ مُوسى لِمَا","غادرَه من بَظْرِها المُوسَى",47,"س",2,0],["وآثَرْتَ بالعَدْلِ الخلافةَ فاعتلَى","سَناها وكاد الجَوْرُ يُخمِدُ نورَها",48,"ر",3,0],["وآثرتُمُ فَكَّ العُناةِ وإنما","يُملِّكُكُم عِتْقُ الرِّقابِ رِقابَها",49,"ب",3,0],["وَاُثبُت رُوَيداً أَيُّها الكَلبُ الكَلِب","أُو لا فَوَلِّ هارِباً ثُمَّ اِنقَلِب",50,"ب",1,0],["وَآثَرَ أَن تَرتَضيهِ الأَنامُ","مِنَ الحَكَمَينِ لِأَسبابِها",51,"ب",3,0],["واثق الخطوة يمشي ملكاً","ظالم الحسن شهي الكبرياء",52,"ا",2,0],["وأثيثٌ ذو عقاصٍ غَيّمَتْ","فيه للمندل أنفاسُ دخان",53,"ن",1,0],["وأثارتْ شُزَّبُ الجُرْدِ بها","عِثْيَراً يَسودّ منه الخافقان",53,"ن",1,0],["وَأَثبَتَ اللَّه أَمْناً في قلوبِهِمُ","بَعدَ التقلُّبِ في الأحشاءِ من وجلِ",54,"ل",1,0],["وأَثبَتُ الأُسدِ في جَوفِ العدى قَدَماً","إِذا جَناحُ لِواءٍ فَوقَهُ خفَقَا",55,"ق",2,0],["وَأَثبَتَ لِلعَلياءِ مِنهُم قَواعِداً","لأعدائِهِ منها قواعدُ تَنْهَدُّ",56,"د",1,0],["وَآثارٌ مُوَكَّلَةٌ بِأَلّا","يُجاوِزُ ما رَقَشنَ لَهُ عَريبُ",57,"ب",1,0],["وَأَثلاثُها السُفلى بُرادِيُّ ساحِلٍ","وَأَثلاثُها الوُسطى كَثيبٌ مِنَ الرَملِ",58,"ل",1,0],["وَأَثلاثُها العُليا كَأَنَّ فُروعَها","عَناقيدُ تُغذى بِالدِهانِ وَبِالغِسلِ",58,"ل",1,0],["وأثبتِهم في الحادثِ النُّكرِ موقفاً","وأَنْفذِهم سَهْماً إذا أخطأ الرامي",59,"م",2,0],["وآثرتُ المحجّةَ والسبيلا","أراك أطعتَهم وأبيتَ إلّا",60,"ل",2,0],["وَأثبَتَ فِي الصُّحفِ زَهرَ الرَّبِيعِ","فَحَدّث عَن المُثمِرِ الذَّبِلِ",61,"ل",1,0],["وَأَثبَتَ الأَعرابَ في الديوانِ","وَقالَ إِنّي مِن بَني شَيبانِ",62,"ن",1,0],["وَأَثافٍ بَقَينَ لا لِاِشتِياقِ","جالِساتٍ عَلى فَريسَةِ نارِ",63,"ر",1,0],["وَآثارِ وَصلٍ في هَواكِ حَفِظتُها","تَحِيّاتِ رَيحانٍ وَعَضّاتِ تُفّاحِ",64,"ح",1,1],["وأثَارَتْ بأرضِ مكةَ نَقْعَاً","ظُنَّ أن الغُدُوَّ منها عِشاءُ",65,"ا",2,0],["وَأَثْبَتَ الوجِدُ خَطَّيْ عَبْرَةِ وضَنىً","مِثْلَ البَهارِ عَلَى خَدَّيْكَ وَالعَنَمِ",66,"م",1,0],["وأثكَلْتَه منه القضيبَ تهَصّرَتْ","أعاليه والرّوْضُ المُفوَّفُ صُوّحا",67,"ح",2,0],["وَأَثبَتَ الثالِثَ الباقي بِنافِذَةٍ","مِن باسِلٍ عالِمٍ بِالطَعنِ كَرّارِ",68,"ر",1,0],["وَآثَرتَ حَرَّ النارِ تُسعَرُ دائِماً","عَلى الفَقرِ أَو غُصنٍ لَهُ غَيرِ وارِقِ",69,"ق",1,0],["وَآثَرُ عِندي مِن مَديحي تَخَرُّصاً","كَلامُ غَوِيٍّ لامَني وَهَجاني",70,"ن",2,0],["وأثْقَلْتَه مِن أنْعُمٍ وعَوَارِفٍ","فسَارَ بها سيرَ البَطِيءِ المُقيّدِ",71,"د",1,0],["وأثرتَ منه الرُّوحَ فانطلقتْ","تحسو الحميمَ وتأكلُ اللهبا",72,"ب",2,0],["وآثارُ دمعِك فوقَ الوسادِ","وفوق المُهدَّل من سترِها",73,"ر",3,0],["وأثارَ أجنحةَ الطيورِ فحوَّمتْ","في الأفقِ حيرى تتبعُ الأصداءَ",74,"ا",2,0],["وآثَرْتُ أخلاقَ السّرابيلِ بَعدَما","أكونُ وأوْفَى أدْرُعِ القوْمِ سِرْبالي",75,"ل",2,0],["وأثْبَتِ الناسِ قلْباً في ظَلامِ سُرًى","ولا رَبِيئَةَ إلا مِسْمَعُ الفَرَسِ",76,"س",1,0],["وأثقل الحقّ على الجماعه","إن وجدت أذن له سمّاعه",77,"ه",1,0],["وَأَثْرَى مِنَ المَالِ المُؤَثَّلِ بِالنُّهَى","وَأَثْرَى مِنَ الْحَمْدِ المُؤَثَّلِ بِالنَّدَى",78,"د",2,0],["وَآثَرَ أَنْ يَخْتَطَّ فِي العَيْشِ خُطَّةً","أَسَدَّ وَأَمْلَى أَنْ تُحَقِّقَ مَقْصِدَا",78,"د",2,0],["وَأَثَرٍ تَرُدُّهُ مِنْ غُرْبَةٍ","وَقَدْ بَذَلْتَ فِيه بَذْلَ الفَادِي",79,"د",2,0],["وَأَثابُوا بِالرَّدَى قَيصَرَ إذْ","أَخْضَعَ الدُّنْيَا لهُمْ بَرّاً وَبَحْرَا",80,"ر",2,0],["وَأَثْخنَ جُرْحاً فَأَقْصَاكَ عَنْ","ثَرَى مِصرَ مُجْتَنَباً مُزْدَرَى",81,"ر",2,0],["وَأَثارَ فِي الأَوْتَارِ تَغْرِيداً","كَأَنَّ الْعُودَ طائِرْ",82,"ر",1,0],["وأثالة رجل المحامد بيته","بيت الفخار وملتقى الضيفان",83,"ن",1,0],["وَآثَرتُ ديني وَاِقتَنَعتُ بِما كَفى","وَعِشتُ عَزيزاً وَالغَريبُ ذَليلُ",84,"ل",1,0],["وآثارُ فَضْلٍ في البِلاَدِ رَفَعْتَها","كما كَان إِسْمَاعيلُ للْبَيْت يَرْفَع",85,"ع",1,0],["وَاثِباً لاهِياً لَعُوباً ضَحوكاً","غيْرَ مَا وَاجلٍ وَلا هَيَّابِ",86,"ب",1,0],["وَاثقاً بالإِله لَيْسَ يَرَى الصَّعْبَ","سِوَى أَن تَهابَ خَوْضَ الصِّعَاب",86,"ب",1,0],["وآثارُ عِرفانٍ تُضيءُ كأنّما","تناثر حول النيل عِقْدٌ مُرَصّع",87,"ع",1,0],["وأثرنها شعواء من","خلف الخدور على الرجال",88,"ل",1,0],["وآثَرَتْ نفسُكْ الأخرى، ولو خَضَعَتْ","يومًا، لكان لها دنيا سُلَيْمانا",89,"ن",2,0],["وآثارُها كعبةٌ للفنونِ","تُزَار، أَلَمْ تَرَ قُصَّادها؟",90,"د",3,0],["وأثيرٌ من بات عنِّي بعيدًا","وكثيرٌ أَولاديَ الغرباءُ",91,"ا",2,0],["وآثار أملاك كرام تقلدوا","حلا بيتك النصري لله دره",92,"ر",2,0],["وآثر تقوى الله منها فلم يكن","بمشتغل عنها بزور ولا فم",93,"م",1,0],["وأثيم أيّامه للدنايا","ولياليه للبغايا الهوائم",94,"م",1,0],["وآثامها لم تسعها اللّغات","ولم يحو تصويرها ملهمُ",95,"م",1,0],["وأثبتَ فرعاً فِي الفروعِ ومنبتاً","وعوداً غداةَ المزنِ، فالعودُ أغيدُ",96,"د",1,0],["وأثبَتَ الثّالثَ الباقي بنافِذَة","ٍ، من باسِيلٍ عالمٍ بالطّعنِ، كرّارِ",97,"ر",1,0],["وأُثقلها بالعَتْب أن كان لي غنى","عن الشرِّ لولا حبُّها للمَخاطر",98,"ر",1,0],["وأثرتُ هاجعةَ القوافي لم تجد","في الراقدين لركضة ميدانا",99,"ن",2,0],["وأثقلَتْ مُتَعُ الدُّنيا قوادِمَهُ","فما ارتقى صُعُداً حتَّى ادَّنى صَبيا",100,"ب",3,0],["وأثني على الحيّينِ عمرٍو ومالكٍ","ثناءً يوافيهمْ بنجدٍ وغائرِ",101,"ر",1,0],["وَأَثبتُّمُ قَولَ من لَفظُه","هُوَ الحَقّ وَالشَرعُ مِنهُ يَقوم",102,"م",1,0],["واثب قلبي ثباتا","عل فيه الصبر يفرغ",103,"غ",1,0],["وإثاره لا ريب فيه وأنه","تبرأ من بخل فسبحان من برا",104,"ر",2,0],["وأثاب وغد القوم غاية قصده","فعلاً وأوصله لذلك جهله",105,"ل",2,0],["وأثبني إخلاص قلب وصدق","واشف يا عمدتي بفضلك دائي",106,"ا",2,0],["وأثقلني همي وأقعدني فما","أصعد طرفي مرةً في سمائيا",107,"ي",2,0],["وأثر في الفؤاد ناراً تلظى","فحياتي في غير هذا الخمود",108,"د",1,0],["واثنان لا تذكرهما واعرفهما","سوءُ المسىء وفَعْلَهُ الحسناتِ",109,"ت",1,0],["وأثيثا يحكى الظلام اسودادا","ومحيًّا يحكى الصباح وسيما",110,"م",2,0],["وآثرَ معشراً ضلوا سبيلاً","فما عرفوا النبيَّ ولا الإلها",111,"ا",1,0],["وأثمرَه الصبرُ الذي لم تزل بهِ","حُماةُ الهدى والدينِ تستنزلُ النصرا",112,"ر",2,0],["وَأَثمَرَت فيكَ آمالي وَلَو قَصَدَت","سِواكَ كانَت غُصوناً مالَها ثَمَرُ",113,"ر",1,0],["وآثر السجن إرضاء لخالقه","ولم يزل به في خطره الدَّحض",114,"ض",1,0],["وَأَثبَتَهُمُ في كُلِّ بابٍ سيادَةً","لَئن كانَ رُسل اللَهِ لِلناسِ سادَةً",115,"ه",1,0],["وأثنى على من ليس يصلحُ للثنا","فقلتُ له أهلا وسهلاً ومرحبا",116,"ب",2,0],["واثنى عليه بالذي قد أعاره","وألبسه من كلِّ فضلٍ وأكسبا",116,"ب",2,0],["وآثار غنما بالنجاحين أثروا","على فعل أمر ليس يرضى به التركا",117,"ك",2,0],["وأثار شراً ساكناً فتلاطموا","بالمشرفيةِ واستقامَ العثيرُ",118,"ر",1,0],["وأثنى على من لم يجب نوح إذ دعا","إلى ترك ود أو سواع وناسر",119,"ر",1,0],["وأثنى على فرعون بالعلم والذكا","وقال بموسى عجلة المتبادر",119,"ر",1,0],["وأُثنِى كما تُثْنى الرياُ على الحَيا","إذا حركتْها في الأَصائِل ريح",120,"ح",1,0],["وَأثقالهُم لو ذرّةٌ من جبالها","عَلى الدهرِ قَد خرّت لأثقلتِ الدهرا",121,"ر",2,0],["واثمارها هامٌ واغصانها الظبى","ومن زهرها ذاك الرصاص نثيرُ",122,"ر",1,0],["واثبةٌ ساكنةٌ","مالتْ ولما تملِ",123,"ل",1,0],["واثبتي للعمرِ آونةً","فليالي العمرِ في هربِ",124,"ب",1,0],["وأثرِ رياحَ وسائلٍ لمؤمِّلٍ","فعسى يُثِرنَ من النجاح سحابا",125,"ب",2,0],["وأثنى عليهِ بالقريضِ مدائحي","ولو لَجَّ عذّالي عليَّ وقالوا",126,"ل",3,0],["وأثقلُ مِنْ رَضْوَى وأعقلُ مَن سَعى","بنعلٍ وأوفاهم ذِماماً ومَوْعِدا",127,"د",2,0],["وأثارت نقع الصبابة حتى","ضلت النفس في قتام الهيام",128,"م",1,0],["وَأَثرَتِ حُنجُرَة الفجور فَأَطلَقَت","حِمَماً عَلى نَغَمِ الجَحيمِ مُوَقَّعَه",129,"ع",2,0],["وأَثبتَّ في الأسماع برهانَ حكمةٍ","يُقَصِّر عنها من يقول ويُطْنِب",130,"ب",1,0],["وَأَثقالٌ أَهُدُّ بِهِنَّ ظَهري","لَقَد عَرَّضتُ نَفسي لِلبَلاءِ",131,"ا",2,0],["وَأَثَّلتَ مَجداً طارِفاً غَيرَ قانِعٍ","بِمِراثِ مَجدٍ سالِفٍ وَعَلاءِ",132,"ا",2,0],["وَأَثِبْ ذِي الْخُطَى التِي أَوْصَلَتْنَا","لِحِمَاكَ الْمَعْلُولِ بِالإِشْرَاقِ",133,"ق",1,0],["وَأَثَارَتْ مَا لَمْ يَكُنْ عَِلِمَ اللَّ","هُ لِيُخْمِدَ مِنْ لَهِيبِ اشْتِيَاقِي",134,"ق",2,0],["وَأَثْنَى عَلَيْهِ الْكَرِيمْ","بِهِ فِي الْقُرْآنِ الْمَجِيدْ",135,"د",1,0],["وأثمار جنّات حبّي اجتنى","بذات اليمين وذات الشمال",136,"ل",1,0],["وأثار بالذكرى عهوداً لم تكن","تنسَى وأنسى سالفَ الإيعاد",137,"د",1,0],["واثقل ما حملته قلب راحل","حليف صبابات بحب مقيم",138,"م",1,0],["وآثارُ بؤس أو نعيمٍ تناثرت","على سُبُلِ الأيام في العسرِ واليسر",139,"ر",1,0],["وأثمله مر النَسيم فَما دَرى","أنسمة طيب أَم ضيا طيبة هبا",140,"ب",2,0],["واثبت بنور العلم وَالحلم منك لي","سَعادة حظ ما لمثبتها حذف",141,"ف",1,0],["وَأَثَّتْ رِياشاً فاسْتَحَثَّتْ لِدَعْوَةٍ","عَلَى رَبِّها أَن يَكْفِي الحَسِّ والحَصَّا",142,"ص",2,0],["وَأَثقَفُ مَن سَطا بِالسَيفِ صَلتاً","إِذا بِثِقافِهِ حَمِيَ المقامُ",143,"م",1,0],["وأثني على ما صُغتَه من قلائِدٍ","تَحَلّى بها من جيدِ مدحيَ عاطلُه",144,"ل",2,0],["وَأثّلَ في كلّ القلوبِ مودّةً","كَستهُ غنى دينٍ ودنيا مفوّفا",145,"ف",2,0],["وآثرت لذاتي ونيل مآربي","واتبعت نفسي كل شيءٍ أحبت",146,"ت",1,0],["وإثباتها وقت الزوال بركعة","وإتمامها عند الغروب بسجدة",146,"ه",1,0],["وَأَثارَ بي وَجدي وَآثَرَ بَعدَهُ","فَغَدا العَذولُ فَما يَكونُ تَحيلي",147,"ل",2,0],["وأثار المِصباحُ رقصَك فاهتزّ","خفوق الأشعّة الحمراء",148,"ا",2,0],["وأثرتِ كامن لوعتي وتركتني","صباً مشوقاً ليس ينعمُ بالا",149,"ل",2,0],["واثملي كالزهور","واسخري كالقدر",150,"ر",1,0],["وأَثمَرَتِ السُّمْرُ هَامَ الكُماةِ","وعَاجَلْنَها بِأَوانِ الجَناءِ",151,"ا",2,0],["وَأَثَّرَ سَيْرُهُ في كُلِّ سَيْرٍ","وَخَدَّهُ مَا ضَغَيْهِ في الحَدائِدْ",152,"د",1,0],["وأَثابَها المنصورُ لِلمهدِى إذاً","هَمَلتْ سَواداً مِن بَني العَبَّاسِ",153,"س",1,0],["وَأَثبَتُ في المِثلِ الظُهرورَ إِذا اِخ","تَفى المِثالُ وَأَنفي مَزجَهث بِالهَوِيَّةِ",154,"ه",1,0],["وَاِثنِ عِطفَيكَ عَن مَلامِ غَوِيٍّ","لَكَ بِالصَدِّ عَن هَداكَ تَصَدّى",155,"د",2,0],["وَأَثنَينا عَلى أَوصافِ سُعدى","وَمَعنىً غَيرَ حُسنَكِ ما عَنَينا",156,"ن",2,0],["وأثن مَعِي على سَفَرٍ حَمِيدٍ","قَضَى لِي مِن لِقَائِكَ كُلَّ سُولِ",157,"ل",1,0],["وأثَرْتُها شَطْرَ العِرا","قِ تَجُرُّ فَضْلاتِ الحِبال",158,"ل",1,0],["وأثمانُها الأرواحُ تُبذَلُ والوغى","لَهُنّ عُكاظٌ والرِّماحُ تِجار",159,"ر",1,0],["وآثارُ أغلالٍ تَوالَتْ فلم تدَعْ","لدى النّاسِ آثاراً إلى اليومِ تُحمَد",160,"د",1,0],["وَأُثني عَلى نارٍ ضُلوعاً وَأَلتَظي","وُلوعاً وَأَستَشفي دُموعاً جَوارِيا",161,"ي",2,0],["وأثبت مَن إن قال قولا وفي به","على كل خطبٍ في العظائم معضل",162,"ل",1,0],["وأثيمٍ قد أتاها","راح بالغفران زاكن",163,"ن",1,0],["وأثبتَ فيه حقَّ أجرٍ وأُجرةٍ","وإرثٍ وأَرشٍ والقِصاصِ المضارع",164,"ع",1,0],["وأثبتمُ الإيمان بالحق قائماً","وفنَّدتمُ آراء أهل البدائع",164,"ع",1,0],["وَأَثاف تَحكي قُلوب المُحبين","اِحتِراقاً لَكنَها لا تَطيرُ",165,"ر",1,0],["واثن المَطيَّ قليلاً","على المُحبِّ العَميد",166,"د",1,0],["وأثنى بالمحامد","على رب البريات",167,"ت",1,0],["وآثار نويرة","من أرباب الكشوفات",167,"ت",1,0],["واثبتْ ثباتَ \"شَدَا\" و\"حُزْنَةَ\" كُلَّم","لاقيتَ مهزوزَ الفؤادِ مُذبْذَبا",168,"ب",2,0],["وأثبتهم جأشاً إذا شهد الوغى","يفوق الحصا من كفه الضرب والطعنا",169,"ن",2,0],["واثنان ما للعفو فيهن مدخل","ولا حام منه حول ذلك حائم",170,"م",1,0],["واثكلتاه لأقلامي وما رقمت","كأنها من رماح الدهر تشرع لي",171,"ل",2,0],["وأثني عليه وهو واللّه بالثنا","حقيق فقل ما شئت في الواحد الفرد",172,"د",1,0],["واثْن العنان إلى الثنا","ء على بديع الاندماج",173,"ج",1,0],["وأثْقَلَني حملُ هذا الغرام","وحَمَّلَني الوجدُ عبئاً عظيما",174,"م",2,0],["وآثار ما أبقى الخليط بعهده","ونُؤياً كمعْوَجِّ السّار مهدَّما",175,"م",2,0],["وأثْقَلَ بالأَيدي لساني وعاتقي","ألَم تَرَني لا أستطيعُ التّكلّما",175,"م",2,0],["وأثْنَتْ عليهمْ بالجميل عوالمٌ","فمن مقصرٍ في مدحِهِم ومطيل",176,"ل",1,0],["واثقاً بالله ربي والغنى","من ندى عبد الغنيِّ في ضمان",177,"ن",1,0],["وأثبت الحب له دلائلاً","بصبّه منها النحول والضنى",178,"ا",1,0],["وأُثني عليه بالَّذي هو أهله","وأُنْشِدُهُ ما قلتُ فيه ويسمعُ",179,"ع",1,0],["وأَثنَيْنَا على مَجْدٍ أصيلٍ","عَجَزْنَا أَن نُوَفِّيَهُ الثَّناءَ",180,"ا",2,0],["وأثارَ نقْعَ جفائه لكنّهُ","لم يجْفُني حتى استنابَ نُقوعَهُ",181,"ع",2,0],["وأثبتت للعلا والمكرمات إذن","محاضرُ بانعدام البذل والجود",182,"د",1,0],["وأثبتّ من جدوى يديك مناقا","هي المجد لا ما يبتغي منه كاسبه",183,"ب",2,0],["وأثل مجده حتى تساوى ال","عليم بما يشيد والغبيّ",184,"ي",1,0],["وآثارُها فِي الأَرْضِ أَشْلاءُ كافِرٍ","وغاوٍ وَفِي جَوِّ السماءِ غمائِمُ",185,"م",1,0],["وأَثقَلْتُ أوتارَ الرِّكابِ جَوَاهِراً","عَلَى ثَمنٍ يَعْدُو بِهِ مُحْوِلُ النَّمْلِ",186,"ل",1,0],["وأثمان النفوس لها قرار","وكل بضاعة تهدى لسوق",187,"ق",1,0],["وأثنيت العنان بلا حزناً","ووجداً لن يطاق ويستطاعا",188,"ع",2,0],["وأثر في شهب السماء وفي الحصا","وفي الأرض تأثير الرياح الصيارم",189,"م",1,0],["وأثَرتُ جوهرَ بحره متعمِّقا","والناسُ يحتشُّون فوق الساحلِ",190,"ل",1,0],["وآثار من الأيام بيض","كآثار البدور على الليالي",191,"ل",2,0],["وَأَثرٌ من ظاعنينَ أَحمدوا","من عيشهم على الأُثَيلاتِ الأَثَرْ",192,"ر",1,0],["وأثير النَّقع من أنديةٍ","يعبقُ المندلُ فيها بالنسيم",193,"م",1,0],["وأثبت الحق والدهماءُ شاهدةٌ","قولُ الفرزدق عند البدو والمُدنِ",194,"ن",1,0],["وأثني رقابَ العيس عن موقف العلى","لَحزْميَ عن رأيٍ أجَلْتُ بعيدُ",195,"د",1,0],["واثِباً لو سابقَتْهُ زَعْزَعٌ","غادَرَ الهُوجَ رَذايا ثُمَّ سارا",196,"ر",2,0],["واثق في الحروب بالنصر لا","يقدم جهلاً بهن إما وإما",197,"م",2,0],["وأثرتَ في اِثرِ الظعائنِ زفرةً","تُغني مطايا الراحلينَ عنِ الحِدا",198,"د",2,0],["واثبت على مبدأ أيدت صحته","حتى توخيته سيرا مع العمر",199,"ر",1,0],["وأثبنا يا رب فتحاً قريباً","وامح ليل الضراء بالسراء",200,"ا",2,0],["وأَثابَ القُوى بُروزاً وطَمْساً","فهوَ مُعْطي القُوى لكلِّ قَوِيِّ",201,"ي",1,0],["واثْبِتوني رِقًّا وإنْ رَقَّ عَظْمي","فَحَياتي بِرقَّةِ اسْتِرْقاقي",202,"ق",2,0],["وآثارِ أنْواعِ الجَمالِ التي انْجَلَتْ","ومَضْمونُها قد لاحَ في طرَفِ الرَّوْضِ",203,"ض",1,0],["وأَثبتَكُمْ في حضرةِ القدسِ رحمَةً","لعُجْمِ البرايا كلِّها والأَعارِبِ",204,"ب",1,0],["وآثرت درء الحد عنهم بشبهة","لظاهر اسلام وحكمك اعدلُ",205,"ل",1,0],["وآثارك الغرّ تبقى بها","وتلك المآثر للآثر",206,"ر",1,0],["واثْنوا الأعنّةَ نحو سكّانِ اللّوى","واِلوُوا بأعناقِ المطيّ وعوّجوا",207,"ج",3,0],["وآثارٌ على دُهْمِ الليالي","حكَتْ غُرَرَ المسوّمةِ العِرابِ",208,"ب",1,0],["وأثكَلْتَ الخزائِنَ فهْي تنعى","على الولدِ المقرَّطِ بالجِرابِ",208,"ب",1,0],["وأثواب الحداد على بلاد","رماها بالمهندة الحداد",209,"د",1,0],["وآثرت في مارني أرسانه","واعتاد ظهري العري من جلاله",210,"ل",2,0],["وأثني الله مولّينا النّعم","من حيا الأرض بجريان الغدُور",211,"ر",1,0],["وآثارٌ له عندي قباحٌ","يجمّش بينها الرأس الحديدُ",212,"د",1,0],["وأَثَرْتَ نَارَ الشَّوْقِ وَهْيَ مناخة","فَتَخِبُّ وَهْيَ عَلَى الْحَضِيضِ الأَوْضَعِ",213,"ع",1,0],["وَأَثنى عَلَيهِم صالِحاً في كِتابِهِ","فَكانَ الَّذي أَثنى أَجَلَّ وَأَكثَرا",214,"ر",2,0],["وأثقلني ولم أكُ طولَ عمري","حملتُ لغيره المِنَنَ الثّقالا",215,"ل",2,0],["وآثرنا دون الأنامِ بصِهْرِهِ","وقد ذِيدَ عنه الطّالبُ المُتَشَوِّفُ",216,"ف",1,0],["وَأَثّر في جيدِها ساعدي","وأثّر في جانبيَّ السِّوارُ",217,"ر",1,0],["وأثارت عرف روضته","في الورى طوبى لمنتشق",218,"ق",1,0],["وأثنوا عليه بالذي هو أهله","ومنه استعاذوا فهو ضار ونافع",219,"ع",1,0],["واثبت على الشرع وما جاء من","أحكامه تظفر بتنويره",220,"ر",2,0],["واثنان في الغيب نحن وهو ولا","يمكن تغييرنا وتغييره",221,"ر",2,0],["وأثنَى بما فيهِ فكانَ كأنَّهُ","بذاكَ يُناجي نفسَهُ وَهْوَ غافِلُ",222,"ل",1,0],["وأثبَتُ من شُمِّ الجبالِ فلم يكُنْ","يُحرِّكُ زَلزالُ الخُطوبِ سكونَهُ",223,"ن",2,0],["واثبت في لوح السياسة أمةً","قد إتفقت في محوها أمم أخرى",224,"ر",2,0],["وأثبت الذين قالوا في الخبر","بأنه أمرهم لما أمر",225,"ر",1,0],["وأثر السجود في مساجده","فكان في ذلك في مشاهده",225,"ه",1,0],["وأَثْريتُ من دينار خَدٍّ مَلكْتُه","وأَحسنُ وَجهٍ بعدَه مثلُ دِرْهمِ",226,"م",1,0],["وأَثْنَى عليه كلُّ شيءٍ محبةٍ","وعادَ فصيحاً فيه ما كان أَعْجما",227,"م",2,0],["وأَثقلَها الحسنُ الَّذي قد تكاثرَتْ","ملاحتُه حتَّى تَثَنَّت مِنَ الثِّقل",228,"ل",1,0],["وآثَرتُ صُحبَةَ مولى الأَنامِ","لأَبْلُغ مِنْه الَّذِي أُوثِر",229,"ر",1,0],["وأَثْلج صَدْري من هوَاجِر رَبْعِه","فيا بَرْدَةً مِن حَرِّ تلَكَ الْهَواجرِ",230,"ر",1,0],["وآثارِ يُلحنَ على ركيّ","بنَعْفِ مُلَيْحَة فالمُسترادِ",231,"د",1,0],["وأَثر في صمِّ الصَّفا ثَفِناتُهُ","وَرامَ بِلَمّا أَمره ثُمَ صَمَّما",232,"م",2,0],["وَأَثلامِ آرِيٍّ قَديمٍ وَمَلعَبٍ","وَنُؤيٍ كَمُلقَى القَوسِ أسلَمَ دابِرِ",233,"ر",1,0],["وَأَثارَت عَجاجَةً بَعدَ نَقعٍ","وَصَهيلٍ مُستَرعَدٍ فَاِكفَهَرَّت",234,"ت",1,0],["وآثَرَ سيلَ الواديين بديمةٍ","تُرشِحُ وسمياً من النَبتِ خِروعا",235,"ع",2,0]]}