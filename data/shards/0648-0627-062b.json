{"poems":[[53,"غزال ماطل ديني","https://www.aldiwan.net/poem29739.html","الهزج"],[53,"يا أراك الحمى تراني أراكا","https://www.aldiwan.net/poem29922.html","الخفيف"],[53,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[53,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[53,"أشوقا وما زالت لهن قباب","https://www.aldiwan.net/poem30761.html","الطويل"],[63,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[77,"إذا أنا لم أوثر هواي على عزمي","https://www.aldiwan.net/poem36126.html","الطويل"],[77,"دعا عزماتي والمطية والوخدا","https://www.aldiwan.net/poem36533.html","الطويل"],[77,"هو النصر باد للعيون صباحه","https://www.aldiwan.net/poem36646.html","الطويل"],[9,"يوم قفت حمولهم فتولوا","https://www.aldiwan.net/poem21960.html","الخفيف"],[86,"ما لهذا النجم في السحر","https://www.aldiwan.net/poem10504.html","المديد"],[86,"أساحة للحرب أم محشر","https://www.aldiwan.net/poem10697.html","السريع"],[86,"سكن الظلام وبات قلبك يخفق","https://www.aldiwan.net/poem68942.html","الكامل"],[0,"ألا قبح الله البراجم كله","https://www.aldiwan.net/poem68.html",""],[35,"أقر الله عيني إذ دعاني","https://www.aldiwan.net/poem39098.html","الوافر"],[35,"سقى دمنتين لم نجد لهما مثلا","https://www.aldiwan.net/poem39120.html","الطويل"],[93,"لحق اليوم بالرفاق أمين","https://www.aldiwan.net/poem11209.html","الخفيف"],[93,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[93,"أخا الحزم نبئني أفارقت عن حزم","https://www.aldiwan.net/poem11418.html","الطويل"],[83,"طلع الهلال وأفقه متهلل","https://www.aldiwan.net/poem54255.html","الكامل"],[88,"لا تأمنن دنياك في حالة","https://www.aldiwan.net/poem44805.html","السريع"],[88,"بدا وجه العروبة في حلوك","https://www.aldiwan.net/poem45038.html","الوافر"],[4,"كبيشة حلت بعد عهدك عاقلا","https://www.aldiwan.net/poem21183.html","الطويل"],[23,"بطيبة رسم للرسول ومعهد","https://www.aldiwan.net/poem21547.html","الطويل"],[72,"برغم العلى تاج تحلى به الثرى","https://www.aldiwan.net/poem18719.html","الطويل"],[72,"من عذيري من الطلا والأغاني","https://www.aldiwan.net/poem20180.html","الخفيف"],[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[51,"عبيد اللّه عبد الله","https://www.aldiwan.net/poem61864.html","مجزوء الوافر"],[51,"إنفاق أيام الحياة على","https://www.aldiwan.net/poem64031.html","أحذ الكامل"],[51,"إني إذا ما الخصم في الغي ابترك","https://www.aldiwan.net/poem65823.html","الرجز"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[38,"أحار بن عبد للدموع البوادر","https://www.aldiwan.net/poem7719.html","الطويل"],[85,"قفي يا أخت يوشع خبرينا","https://www.aldiwan.net/poem63733.html","الوافر"],[43,"فهمت الكتاب أبر الكتب","https://www.aldiwan.net/poem9461.html","المتقارب"],[62,"المبدأ الأول في","https://www.aldiwan.net/poem52199.html","مجزوء الرجز"],[62,"أقول وصرف الدهر يحرق نابه","https://www.aldiwan.net/poem52390.html","الطويل"],[62,"بني إذا السلطان خصك فاعتمد","https://www.aldiwan.net/poem52445.html","الطويل"],[45,"دع الشيء لا تطلبه من نحو وجهه","https://www.aldiwan.net/poem62679.html","الطويل"],[45,"حذرت الحب لو أغنى حذاري","https://www.aldiwan.net/poem63588.html","الوافر"],[45,"ألما فات من تلاق تلاف","https://www.aldiwan.net/poem65153.html","الخفيف"],[28,"فسيري فأمي أرض قومك إنني","https://www.aldiwan.net/poem5344.html","الطويل"],[61,"سحابك في السماح لها انسجام","https://www.aldiwan.net/poem51440.html","البسيط"],[61,"قد تركت عرس أبي جعفر","https://www.aldiwan.net/poem51591.html","السريع"],[61,"قليل لها أن يتبع الدمع غيرها","https://www.aldiwan.net/poem51683.html","الطويل"],[61,"على غير عتب ما طويت عتابها","https://www.aldiwan.net/poem51781.html","الطويل"],[58,"أنا الغلام العربي المنتسب","https://www.aldiwan.net/poem31195.html","الرجز"],[66,"ألا قل لشر عبيد الإله","https://www.aldiwan.net/poem41383.html","المتقارب"],[97,"يا فؤادي رحم الله الهوى","https://www.aldiwan.net/poem25088.html","الرمل"],[80,"أخذت سفاقس منك عهد أمان","https://www.aldiwan.net/poem31263.html","الكامل"],[80,"ملاعب البيض بين البيض والأسل","https://www.aldiwan.net/poem31322.html","البسيط"],[80,"ما للوشاة عليها أذكت الحدقا","https://www.aldiwan.net/poem31358.html","البسيط"],[80,"بكى فقدك العز المؤيد والمجد","https://www.aldiwan.net/poem31472.html","الطويل"],[44,"متى يرعي لقولك أو ينيب","https://www.aldiwan.net/poem29679.html","الوافر"],[33,"ليالي أصبو بالعشي وبالضحى","https://www.aldiwan.net/poem25837.html","الطويل"],[105,"ألا فاذكروا من قومنا كل مقدام","https://www.aldiwan.net/poem43047.html","الطويل"],[105,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[81,"أسيف الوزارة بوركت من","https://www.aldiwan.net/poem61329.html","المتقارب"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"أي رسم لآل هند ودار","https://www.aldiwan.net/poem27050.html","الخفيف"],[52,"وآثار وصل في هواك حفظتها","https://www.aldiwan.net/poem27163.html","الطويل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[75,"أنظلم أن شمنا بوارق لمحا","https://www.aldiwan.net/poem69094.html","الطويل"],[7,"عوجوا فحيوا لنعم دمنة الدار","https://www.aldiwan.net/poem1998.html","البسيط"],[46,"ألا هل أتى قبر الفقيرة طارق","https://www.aldiwan.net/poem23048.html","الطويل"],[46,"أرى فتيي دنياك إن حرج الفتى","https://www.aldiwan.net/poem23511.html","الطويل"],[46,"إليك تناهى كل فخر وسؤدد","https://www.aldiwan.net/poem23640.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39548","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39578","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39584","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16684","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16620","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54747","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54748","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43741","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54275","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54272","الطويل"],[106,"أدب الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=179476",""],[106,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[106,"أعياد النصر","https://www.poetsgate.com/ViewPoem.aspx?id=179343",""],[77,"رأيت هدايا الأرض دونك قدرها","https://www.poetsgate.com/ViewPoem.aspx?id=34130",""],[77,"إذا أنا لم أوثر هواي على عزمي","https://www.poetsgate.com/ViewPoem.aspx?id=34203",""],[23,"بطيبة رسم للرسول","https://www.poetsgate.com/ViewPoem.aspx?id=11422",""],[7,"عوجوا ، فحيوا لنعمٍ دمنة َ الدارِ ،","https://www.poetsgate.com/ViewPoem.aspx?id=17560",""],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[90,"شاغور حمانا","https://www.poetsgate.com/ViewPoem.aspx?id=179166",""],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[38,"أحارِ بنَ عبدٍ للدّموعِ البوادرِ","https://www.poetsgate.com/ViewPoem.aspx?id=21197",""]],"verses":[["وَأَثني سَنَنَ الخَيلِ","بِهَبهابِ السُرى لَينِ",0,"ن",1,0],["وَأَثافٍ كَأَنَّهُنَّ رَذايا","وَأَسارى لا يَنظُرونَ فِكاكا",1,"ك",2,0],["واثِقاً بِالدَهرِ تُعطى","مِن رَزاياهُ وَثيقَه",2,"ق",2,0],["وَأَثاروا الدينَ مِن مَربِضِهِ","وَأَطاروا عَن مَجاليهِ الخِمارا",3,"ر",2,0],["وَأَثقَلُ مَحمولٍ عَلى العَينِ دَمعُها","إِذا بانَ أَحبابٌ وَعَزَّ إِيابُ",4,"ب",1,0],["وأثْبَتُها في حَومَةِ الحَرْبِ مالِكٌ","وعَوفٌ وذو الرُّمْحَينِ جَدُّكُمُ عَمْرو",5,"ر",2,0],["وآثارُها مَشهورَةٌ وغُمودُها","إذا جُرِّدَتْ هامُ المُلوكِ ولا فَخْرُ",5,"ر",1,0],["وآَثَرَ تَقْوَى اللَّهِ مِنْهَا فَلَمْ يَكُنْ","بِمُشْتَغِلٍ عَنْهَا بزيرٍ وَلاَ بَمِّ",6,"م",1,0],["وأثْبَتَ منْهُ الرّيقُ عيْنَ قَتادَةٍ","فأحْكَمَها من بعْدِ ما ذَهَبَتْ ردّا",7,"د",2,0],["وآثارُ مَلْكٍ ظاهِرِ الفَضْلِ لمْ يزَلْ","يُشَفَّعُ فِينا هَدْيُهُ وصَلاحُهُ",8,"ح",2,0],["وَأَثيثٍ جَثلِ النَباتِ تُرَوّي","هِ لَعوبٌ غَريرَةٌ مِفناقُ",9,"ق",1,0],["وَأَثارَت بي فَوادِحُهُ","كامِناتِ الهَمِّ وَالكَدَرِ",10,"ر",1,0],["وَأَثمَلَتها خَمرَةٌ مِن دَمٍ","يَلهو بِها الميكادُ وَالقَيصَرُ",11,"ر",1,0],["واثَقتُهُ أَلّا أَبوحَ وَإِنَّما","يَومَ الحِسابِ يُحَلُّ ذاكَ المَوثِقُ",12,"ق",1,0],["وَآثَرَ بِالمِلحاةِ آلَ مُجاشِعٍ","رِقابَ إِماءٍ يَقتَنينَ المَفارِما",13,"م",2,0],["وَأَثنى في هَوايَ عَلَيَّ خَيراً","وَيَسأَلُ عَن بَنِيَّ وَكَيفَ حالي",14,"ي",1,0],["وَأَثبَتُهُ داراً عَلى الخَوفِ ثَملُها","فُروعُ عَوالي الغابِ أَكرِم بِها ثَملا",15,"ل",2,0],["وَأَثَابَتْ بَغْدَادُ مَسْعَاكَ إِذْ بِ","تَّ وَفِيهَا لَكَ المَكَانُ المكينُ",16,"ن",1,0],["وَأَثِرْ غَيْهَبَ المِدَادِ وَأَرْسِلْ","صَعَقَاتٍ لَهَا انْقِضَاضُ الرجُومِ",17,"م",1,0],["وَآثَرْتَ مَيْدَانَ المُحَامَاةِ دُونَها","مَجَالاً رَحِيباً لِلمُرُوءةِ والعَزْمِ",18,"م",1,0],["وأثرت فيه للطراد فوارساً","مثل الشموس وجوهُهم تتهلّلُ",19,"ل",1,0],["واثنان سارا في طريق معاً","إلى حمى سورية العامره",20,"ر",2,0],["وأثبت بالسيوف لهم حقوقاً","مؤيّدةً بكل دم سيفك",21,"ك",1,0],["وَأَثنَوا عَلَيهِ بِالَّذي كانَ عِندَهُ","وَعَضَّ عَلَيهِ العائِداتُ الأَنامِلا",22,"ل",2,0],["وَأَثبَتَ فَرعاً في الفُروعِ وَمَنبِتاً","وَعوداً غَذاهُ المُزنُ فَالعودُ أَغيَدُ",23,"د",1,0],["وأثنى على جهدي بما هو أهله","وأظهر أفعال الجميل وأضمرا",24,"ر",2,0],["واثق الوعد من طرابلس الشا","م بجودٍ حيث التقى البحران",25,"ن",1,0],["واثقة بالرزق حيث كانا","تغدو خماصاً وتجي بطانا",26,"ن",2,0],["واثباتٍ على الظِّباء ضِعافٍ","عن وثابِ الأسود يومَ الوِثابِ",27,"ب",1,0],["واثنان لي منهما أجَلُّهما","عذرُ كريمِ الرجال أو نَشَبُهْ",28,"ب",2,0],["وآثره لما قدْ كا","ن يؤنس فيه من رشَدِهْ",29,"د",2,0],["واثبُتْ على الحسنى فقد طَمَحَتْ","نحوي ونحوَك أعين خُزرُ",30,"ر",1,0],["واثلثْ بحمدونةَ دعموصِ السِّككْ","شرُّ ثلاث تحت بُطنانِ الفلكْ",31,"ك",1,0],["واثقاً منك بالعطايا التي تس","عى إلى القاعدين غيرَ أوالِ",32,"ل",1,0],["وأثبتَ للأمرِ الذي يستديمه","أواخيَّ صدْقٍ أقسمتْ لا تَجَذَّمُ",33,"م",1,0],["وأُثيبَ سعيُك للإمام فلم تزل","لثغورهِ بجنود رأيكَ شاحنا",34,"ن",2,0],["وَأُثني عَلى الحَيَّينِ عَمرٍ وَمالِكٍ","ثَناءً يُوافيهِم بِنَجدٍ وَغائِرِ",35,"ر",1,0],["وَآثارُ الرِجالِ إِذا تَناهَت","إِلى التاريخِ خَيرُ الحاكِمينا",36,"ن",2,0],["وَأُثني عَلَيهِ بِآلائِهِ","وَأَقرُبُ مِنهُ نَأى أَو قَرُب",37,"ب",1,0],["واثنان في حكمتنا","أب قديم وولد",38,"د",1,0],["وأَثَّرَ في عُودي النُيوبَ وطالَما","تمنَّعَ واستعصَى عليها مكاسِرُهْ",39,"ر",2,0],["وآثرَهُ بالصَّيْدِ صَوْناً لنفسهِ","وكان مُعَاناً في الأمورِ مُؤَيَّدَا",40,"د",2,0],["وَأَثقَلُ مَن أَهجو عَلَيَّ مَغَمَّرٌ","أَظَلُّ بِإِسفافي إِلى هَجوِهِ أُهجى",41,"ج",2,0],["وَآثَرَكُم وَلَم يُؤثِر عَلَيكُم","وَقَد شَرَعَت لَهُ دُنيا المُعارِ",42,"ر",1,0],["وَأَثافٍ أَتَت لَها حِجَجٌ دو","نَ لَظى النارِ مُثَّلَ كَالأَثافي",43,"ي",1,0],["وَأَثني عَلى سَعدٍ بِما هِيَ أَهلُهُ","وَخَيرُ أَحاديثِ الغَريبِ صَدوقُها",44,"ق",3,0],["وآثارٌ تَمُرُّ بها اللَّيالي","وهُنَّ على جِباهِ الدَّهْرِ شامُ",45,"م",1,0],["وآثرتْ فيشةَ مُوسى لِمَا","غادرَه من بَظْرِها المُوسَى",46,"س",2,0],["وآثَرْتَ بالعَدْلِ الخلافةَ فاعتلَى","سَناها وكاد الجَوْرُ يُخمِدُ نورَها",47,"ر",3,0],["وآثرتُمُ فَكَّ العُناةِ وإنما","يُملِّكُكُم عِتْقُ الرِّقابِ رِقابَها",48,"ب",3,0],["وَاُثبُت رُوَيداً أَيُّها الكَلبُ الكَلِب","أُو لا فَوَلِّ هارِباً ثُمَّ اِنقَلِب",49,"ب",1,0],["وَآثَرَ أَن تَرتَضيهِ الأَنامُ","مِنَ الحَكَمَينِ لِأَسبابِها",50,"ب",3,0],["واثق الخطوة يمشي ملكاً","ظالم الحسن شهي الكبرياء",51,"ا",2,0],["وأثيثٌ ذو عقاصٍ غَيّمَتْ","فيه للمندل أنفاسُ دخان",52,"ن",1,0],["وأثارتْ شُزَّبُ الجُرْدِ بها","عِثْيَراً يَسودّ منه الخافقان",52,"ن",1,0],["وَأَثبَتَ اللَّه أَمْناً في قلوبِهِمُ","بَعدَ التقلُّبِ في الأحشاءِ من وجلِ",53,"ل",1,0],["وأَثبَتُ الأُسدِ في جَوفِ العدى قَدَماً","إِذا جَناحُ لِواءٍ فَوقَهُ خفَقَا",54,"ق",2,0],["وَأَثبَتَ لِلعَلياءِ مِنهُم قَواعِداً","لأعدائِهِ منها قواعدُ تَنْهَدُّ",55,"د",1,0],["وَآثارٌ مُوَكَّلَةٌ بِأَلّا","يُجاوِزُ ما رَقَشنَ لَهُ عَريبُ",56,"ب",1,0],["وَأَثلاثُها السُفلى بُرادِيُّ ساحِلٍ","وَأَثلاثُها الوُسطى كَثيبٌ مِنَ الرَملِ",57,"ل",1,0],["وَأَثلاثُها العُليا كَأَنَّ فُروعَها","عَناقيدُ تُغذى بِالدِهانِ وَبِالغِسلِ",57,"ل",1,0],["وأثبتِهم في الحادثِ النُّكرِ موقفاً","وأَنْفذِهم سَهْماً إذا أخطأ الرامي",58,"ي",1,0],["وآثرتُ المحجّةَ والسبيلا","أراك أطعتَهم وأبيتَ إلّا",59,"ل",2,0],["وَأثبَتَ فِي الصُّحفِ زَهرَ الرَّبِيعِ","فَحَدّث عَن المُثمِرِ الذَّبِلِ",60,"ل",1,0],["وَأَثبَتَ الأَعرابَ في الديوانِ","وَقالَ إِنّي مِن بَني شَيبانِ",61,"ن",1,0],["وَأَثافٍ بَقَينَ لا لِاِشتِياقِ","جالِساتٍ عَلى فَريسَةِ نارِ",62,"ر",1,0],["وَآثارِ وَصلٍ في هَواكِ حَفِظتُها","تَحِيّاتِ رَيحانٍ وَعَضّاتِ تُفّاحِ",63,"ح",1,1],["وأثَارَتْ بأرضِ مكةَ نَقْعَاً","ظُنَّ أن الغُدُوَّ منها عِشاءُ",64,"ا",2,0],["وَأَثْبَتَ الوجِدُ خَطَّيْ عَبْرَةِ وضَنىً","مِثْلَ البَهارِ عَلَى خَدَّيْكَ وَالعَنَمِ",65,"م",1,0],["وأثكَلْتَه منه القضيبَ تهَصّرَتْ","أعاليه والرّوْضُ المُفوَّفُ صُوّحا",66,"ح",2,0],["وَأَثبَتَ الثالِثَ الباقي بِنافِذَةٍ","مِن باسِلٍ عالِمٍ بِالطَعنِ كَرّارِ",67,"ر",1,0],["وَآثَرتَ حَرَّ النارِ تُسعَرُ دائِماً","عَلى الفَقرِ أَو غُصنٍ لَهُ غَيرِ وارِقِ",68,"ق",1,0],["وَآثَرُ عِندي مِن مَديحي تَخَرُّصاً","كَلامُ غَوِيٍّ لامَني وَهَجاني",69,"ي",1,0],["وأثْقَلْتَه مِن أنْعُمٍ وعَوَارِفٍ","فسَارَ بها سيرَ البَطِيءِ المُقيّدِ",70,"د",1,0],["وأثرتَ منه الرُّوحَ فانطلقتْ","تحسو الحميمَ وتأكلُ اللهبا",71,"ب",2,0],["وآثارُ دمعِك فوقَ الوسادِ","وفوق المُهدَّل من سترِها",72,"ر",3,0],["وأثارَ أجنحةَ الطيورِ فحوَّمتْ","في الأفقِ حيرى تتبعُ الأصداءَ",73,"ا",2,0],["وآثَرْتُ أخلاقَ السّرابيلِ بَعدَما","أكونُ وأوْفَى أدْرُعِ القوْمِ سِرْبالي",74,"ل",2,0],["وأثْبَتِ الناسِ قلْباً في ظَلامِ سُرًى","ولا رَبِيئَةَ إلا مِسْمَعُ الفَرَسِ",75,"س",1,0],["وأثقل الحقّ على الجماعه","إن وجدت أذن له سمّاعه",76,"ه",1,0],["وَأَثْرَى مِنَ المَالِ المُؤَثَّلِ بِالنُّهَى","وَأَثْرَى مِنَ الْحَمْدِ المُؤَثَّلِ بِالنَّدَى",77,"د",2,0],["وَآثَرَ أَنْ يَخْتَطَّ فِي العَيْشِ خُطَّةً","أَسَدَّ وَأَمْلَى أَنْ تُحَقِّقَ مَقْصِدَا",77,"د",2,0],["وَأَثَرٍ تَرُدُّهُ مِنْ غُرْبَةٍ","وَقَدْ بَذَلْتَ فِيه بَذْلَ الفَادِي",78,"د",2,0],["وَأَثابُوا بِالرَّدَى قَيصَرَ إذْ","أَخْضَعَ الدُّنْيَا لهُمْ بَرّاً وَبَحْرَا",79,"ر",2,0],["وَأَثْخنَ جُرْحاً فَأَقْصَاكَ عَنْ","ثَرَى مِصرَ مُجْتَنَباً مُزْدَرَى",80,"ر",2,0],["وَأَثارَ فِي الأَوْتَارِ تَغْرِيداً","كَأَنَّ الْعُودَ طائِرْ",81,"ر",1,0],["وأثالة رجل المحامد بيته","بيت الفخار وملتقى الضيفان",82,"ن",1,0],["وَآثَرتُ ديني وَاِقتَنَعتُ بِما كَفى","وَعِشتُ عَزيزاً وَالغَريبُ ذَليلُ",83,"ل",1,0],["وآثارُ فَضْلٍ في البِلاَدِ رَفَعْتَها","كما كَان إِسْمَاعيلُ للْبَيْت يَرْفَع",84,"ع",1,0],["وَاثِباً لاهِياً لَعُوباً ضَحوكاً","غيْرَ مَا وَاجلٍ وَلا هَيَّابِ",85,"ب",1,0],["وَاثقاً بالإِله لَيْسَ يَرَى الصَّعْبَ","سِوَى أَن تَهابَ خَوْضَ الصِّعَاب",85,"ب",1,0],["وآثارُ عِرفانٍ تُضيءُ كأنّما","تناثر حول النيل عِقْدٌ مُرَصّع",86,"ع",1,0],["وأثرنها شعواء من","خلف الخدور على الرجال",87,"ل",1,0],["وآثَرَتْ نفسُكْ الأخرى، ولو خَضَعَتْ","يومًا، لكان لها دنيا سُلَيْمانا",88,"ن",2,0],["وآثارُها كعبةٌ للفنونِ","تُزَار، أَلَمْ تَرَ قُصَّادها؟",89,"د",3,0],["وآثار أملاك كرام تقلدوا","حلا بيتك النصري لله دره",90,"ر",2,0],["وآثر تقوى الله منها فلم يكن","بمشتغل عنها بزور ولا فم",91,"م",1,0],["وأثبتَ فرعاً فِي الفروعِ ومنبتاً","وعوداً غداةَ المزنِ، فالعودُ أغيدُ",92,"د",1,0],["وأثبَتَ الثّالثَ الباقي بنافِذَة","ٍ، من باسِيلٍ عالمٍ بالطّعنِ، كرّارِ",93,"ر",1,0],["وأُثقلها بالعَتْب أن كان لي غنى","عن الشرِّ لولا حبُّها للمَخاطر",94,"ر",1,0],["وأثرتُ هاجعةَ القوافي لم تجد","في الراقدين لركضة ميدانا",95,"ن",2,0],["وأثقلَتْ مُتَعُ الدُّنيا قوادِمَهُ","فما ارتقى صُعُداً حتَّى ادَّنى صَبيا",96,"ب",3,0],["وأثني على الحيّينِ عمرٍو ومالكٍ","ثناءً يوافيهمْ بنجدٍ وغائرِ",97,"ر",1,0]]}