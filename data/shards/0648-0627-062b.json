ww.aldiwan.net/poem34096.html","مجزوء الكامل"],[416,"تذكر بالخيف عهدا قديما","https://www.aldiwan.net/poem53932.html","المتقارب"],[416,"تذكر عهدا بالحمى قد تقدما","https://www.aldiwan.net/poem53977.html","الطويل"],[416,"سقاك الحيا من أربع وطلول","https://www.aldiwan.net/poem54049.html","الطويل"],[416,"هذه الدار وهاتيك المغاني","https://www.aldiwan.net/poem54073.html","الرمل"],[416,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[416,"بوادي الغضا للمالكية أربع","https://www.aldiwan.net/poem54180.html","الطويل"],[432,"سعود سنيكما كملت سناء","https://www.aldiwan.net/poem12355.html","الوافر"],[432,"ماذا أقول وقد حبيت بفطنة","https://www.aldiwan.net/poem12655.html","الكامل"],[437,"الله أكبر هذا مربع الجود","https://www.aldiwan.net/poem2539.html","البسيط"],[437,"فؤاد عصاه صبره وهو طالبه","https://www.aldiwan.net/poem2577.html","الطويل"],[437,"دعا فأجابه الدمع العصي","https://www.aldiwan.net/poem2606.html","الوافر"],[439,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[439,"أفي مثلها تنبو أياديك عن مثلي","https://www.aldiwan.net/poem34897.html","الطويل"],[441,"أيا رباه دعوة مستضيق","https://www.aldiwan.net/poem14335.html","الوافر"],[441,"وداعا أيها الشهر الوداعا","https://www.aldiwan.net/poem14377.html","الوافر"],[441,"هو الرزء حتى خص ريش القوادم","https://www.aldiwan.net/poem14478.html","الطويل"],[458,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[458,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[458,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[461,"علقته والصبا غض الأديم","https://www.aldiwan.net/poem15087.html","الرمل"],[461,"ضاقت بلاغة أشعاري بما رحبت","https://www.aldiwan.net/poem15395.html","البسيط"],[461,"أأترك محيي العدل والشوق قائدي","https://www.aldiwan.net/poem15921.html","الطويل"],[461,"يفضل الصارم في عزمته","https://www.aldiwan.net/poem16119.html","الرمل"],[464,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[477,"أشجاك قمري الأراك مغردا","https://www.aldiwan.net/poem15234.html","الكامل"],[479,"القول كالبرق والأعمال كالمطر","https://www.aldiwan.net/poem37185.html","البسيط"],[500,"يا آلهي بدولة الأسماء","https://www.aldiwan.net/poem37720.html","الخفيف"],[500,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[500,"طار نحو الحبيب شحرور قلبي","https://www.aldiwan.net/poem37945.html","الخفيف"],[500,"أما والنجوم المشرقات من العلى","https://www.aldiwan.net/poem37987.html","الطويل"],[500,"رغبنا بأسرار الشهود لوجهكم","https://www.aldiwan.net/poem38082.html","الطويل"],[506,"بلغت أمير المؤنين مدى المنى","https://www.aldiwan.net/poem2405.html","الطويل"],[506,"اطلت على افقك الزاهر","https://www.aldiwan.net/poem2425.html","المتقارب"],[514,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[514,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[515,"أمنت من الغرام على فؤادي","https://www.aldiwan.net/poem12064.html","الوافر"],[515,"قدك مثل الغصن في اعتداله","https://www.aldiwan.net/poem12217.html","الرجز"],[520,"يا زمان العكس قلاب الأمور","https://www.aldiwan.net/poem818.html",""],[527,"أيدري السيف أي فتى يبيد","https://www.aldiwan.net/poem45970.html","الوافر"],[529,"هوت العقيق وما هوت فكأنها","https://www.aldiwan.net/poem37342.html","الكامل"],[536,"أتذكر داراً بين دمخ ومنورا","https://www.aldiwan.net/poem23850.html","الطويل"],[551,"أمالك من غرام ما أمالا","https://www.aldiwan.net/poem47319.html","الوافر"],[551,"لنا من ثناياك الغريض المرشف","https://www.aldiwan.net/poem47403.html","الطويل"],[551,"ولما أردت طروق الفتاة","https://www.aldiwan.net/poem47811.html","المتقارب"],[558,"بدر تم لاح في الغسق","https://www.aldiwan.net/poem34335.html","المديد"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[558,"يا عابدا ربا بتصويره","https://www.aldiwan.net/poem34459.html","السريع"],[558,"إني أنا فرضه وتقديره","https://www.aldiwan.net/poem34467.html","المنسرح"],[562,"منازل عسفان فدتك المنازل","https://www.aldiwan.net/poem52753.html","الطويل"],[562,"أرى الدهر يقضي كل يوم ديونه","https://www.aldiwan.net/poem52787.html","الطويل"],[564,"أعيدوا لنا التاريخ احيوا لنا الذكرى","https://www.aldiwan.net/poem854.html",""],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"],[575,"أرى كل شيء في البسيطة قد نما","https://www.aldiwan.net/poem3021.html","الطويل"],[575,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[575,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[575,"تنزه طرفي بين زاه وزاهر","https://www.aldiwan.net/poem3073.html","الطويل"]],"verses":[["وَأَثني سَنَنَ الخَيلِ","بِهَبهابِ السُرى لَينِ",0,"ن",1,0],["وَأَثافٍ كَأَنَّهُنَّ رَذايا","وَأَسارى لا يَنظُرونَ فِكاكا",1,"ك",2,0],["واثِقاً بِالدَهرِ تُعطى","مِن رَزاياهُ وَثيقَه",2,"ق",2,0],["وَأَثاروا الدينَ مِن مَربِضِهِ","وَأَطاروا عَن مَجاليهِ الخِمارا",3,"ر",2,0],["وَأَثقَلُ مَحمولٍ عَلى العَينِ دَمعُها","إِذا بانَ أَحبابٌ وَعَزَّ إِيابُ",4,"ب",1,0],["وأثْبَتُها في حَومَةِ الحَرْبِ مالِكٌ","وعَوفٌ وذو الرُّمْحَينِ جَدُّكُمُ عَمْرو",5,"ر",2,0],["وآثارُها مَشهورَةٌ وغُمودُها","إذا جُرِّدَتْ هامُ المُلوكِ ولا فَخْرُ",5,"ر",1,0],["وآَثَرَ تَقْوَى اللَّهِ مِنْهَا فَلَمْ يَكُنْ","بِمُشْتَغِلٍ عَنْهَا بزيرٍ وَلاَ بَمِّ",6,"م",1,0],["وأثْبَتَ منْهُ الرّيقُ عيْنَ قَتادَةٍ","فأحْكَمَها من بعْدِ ما ذَهَبَتْ ردّا",7,"د",2,0],["وآثارُ مَلْكٍ ظاهِرِ الفَضْلِ لمْ يزَلْ","يُشَفَّعُ فِينا هَدْيُهُ وصَلاحُهُ",8,"ح",2,0],["وَأَثيثٍ جَثلِ النَباتِ تُرَوّي","هِ لَعوبٌ غَريرَةٌ مِفناقُ",9,"ق",1,0],["وَأَثارَت بي فَوادِحُهُ","كامِناتِ الهَمِّ وَالكَدَرِ",10,"ر",1,0],["وَأَثمَلَتها خَمرَةٌ مِن دَمٍ","يَلهو بِها الميكادُ وَالقَيصَرُ",11,"ر",1,0],["واثَقتُهُ أَلّا أَبوحَ وَإِنَّما","يَومَ الحِسابِ يُحَلُّ ذاكَ المَوثِقُ",12,"ق",1,0],["وَآثَرَ بِالمِلحاةِ آلَ مُجاشِعٍ","رِقابَ إِماءٍ يَقتَنينَ المَفارِما",13,"م",2,0],["وَأَثنى في هَوايَ عَلَيَّ خَيراً","وَيَسأَلُ عَن بَنِيَّ وَكَيفَ حالي",14,"ي",1,0],["وَأَثبَتُهُ داراً عَلى الخَوفِ ثَملُها","فُروعُ عَوالي الغابِ أَكرِم بِها ثَملا",15,"ل",2,0],["وَأَثَابَتْ بَغْدَادُ مَسْعَاكَ إِذْ بِ","تَّ وَفِيهَا لَكَ المَكَانُ المكينُ",16,"ن",1,0],["وَأَثِرْ غَيْهَبَ المِدَادِ وَأَرْسِلْ","صَعَقَاتٍ لَهَا انْقِضَاضُ الرجُومِ",17,"م",1,0],["وَآثَرْتَ مَيْدَانَ المُحَامَاةِ دُونَها","مَجَالاً رَحِيباً لِلمُرُوءةِ والعَزْمِ",18,"م",1,0],["وأثرت فيه للطراد فوارساً","مثل الشموس وجوهُهم تتهلّلُ",19,"ل",1,0],["واثنان سارا في طريق معاً","إلى حمى سورية العامره",20,"ر",2,0],["وأثبت بالسيوف لهم حقوقاً","مؤيّدةً بكل دم سيفك",21,"ك",1,0],["وَأَثنَوا عَلَيهِ بِالَّذي كانَ عِندَهُ","وَعَضَّ عَلَيهِ العائِداتُ الأَنامِلا",22,"ل",2,0],["وَأَثبَتَ فَرعاً في الفُروعِ وَمَنبِتاً","وَعوداً غَذاهُ المُزنُ فَالعودُ أَغيَدُ",23,"د",1,0],["وأثنى على جهدي بما هو أهله","وأظهر أفعال الجميل وأضمرا",24,"ر",2,0],["واثق الوعد من طرابلس الشا","م بجودٍ حيث التقى البحران",25,"ن",1,0],["واثقة بالرزق حيث كانا","تغدو خماصاً وتجي بطانا",26,"ن",2,0],["واثباتٍ على الظِّباء ضِعافٍ","عن وثابِ الأسود يومَ الوِثابِ",27,"ب",1,0],["واثنان لي منهما أجَلُّهما","عذرُ كريمِ الرجال أو نَشَبُهْ",28,"ب",2,0],["وآثره لما قدْ كا","ن يؤنس فيه من رشَدِهْ",29,"د",2,0],["واثبُتْ على الحسنى فقد طَمَحَتْ","نحوي ونحوَك أعين خُزرُ",30,"ر",1,0],["واثلثْ بحمدونةَ دعموصِ السِّككْ","شرُّ ثلاث تحت بُطنانِ الفلكْ",31,"ك",1,0],["واثقاً منك بالعطايا التي تس","عى إلى القاعدين غيرَ أوالِ",32,"ل",1,0],["وأثبتَ للأمرِ الذي يستديمه","أواخيَّ صدْقٍ أقسمتْ لا تَجَذَّمُ",33,"م",1,0],["وأُثيبَ سعيُك للإمام فلم تزل","لثغورهِ بجنود رأيكَ شاحنا",34,"ن",2,0],["وَأُثني عَلى الحَيَّينِ عَمرٍ وَمالِكٍ","ثَناءً يُوافيهِم بِنَجدٍ وَغائِرِ",35,"ر",1,0],["وَآثارُ الرِجالِ إِذا تَناهَت","إِلى التاريخِ خَيرُ الحاكِمينا",36,"ن",2,0],["وَأُثني عَلَيهِ بِآلائِهِ","وَأَقرُبُ مِنهُ نَأى أَو قَرُب",37,"ب",1,0],["واثنان في حكمتنا","أب قديم وولد",38,"د",1,0],["وأَثَّرَ في عُودي النُيوبَ وطالَما","تمنَّعَ واستعصَى عليها مكاسِرُهْ",39,"ر",2,0],["وآثرَهُ بالصَّيْدِ صَوْناً لنفسهِ","وكان مُعَاناً في الأمورِ مُؤَيَّدَا",40,"د",2,0],["وَأَثقَلُ مَن أَهجو عَلَيَّ مَغَمَّرٌ","أَظَلُّ بِإِسفافي إِلى هَجوِهِ أُهجى",41,"ج",2,0],["وَآثَرَكُم وَلَم يُؤثِر عَلَيكُم","وَقَد شَرَعَت لَهُ دُنيا المُعارِ",42,"ر",1,0],["وَأَثافٍ أَتَت لَها حِجَجٌ دو","نَ لَظى النارِ مُثَّلَ كَالأَثافي",43,"ي",1,0],["وَأَثني عَلى سَعدٍ بِما هِيَ أَهلُهُ","وَخَيرُ أَحاديثِ الغَريبِ صَدوقُها",44,"ق",3,0],["وآثارٌ تَمُرُّ بها اللَّيالي","وهُنَّ على جِباهِ الدَّهْرِ شامُ",45,"م",1,0],["وآثرتْ فيشةَ مُوسى لِمَا","غادرَه من بَظْرِها المُوسَى",46,"س",2,0],["وآثَرْتَ بالعَدْلِ الخلافةَ فاعتلَى","سَناها وكاد الجَوْرُ يُخمِدُ نورَها",47,"ر",3,0],["وآثرتُمُ فَكَّ العُناةِ وإنما","يُملِّكُكُم عِتْقُ الرِّقابِ رِقابَها",48,"ب",3,0],["وَاُثبُت رُوَيداً أَيُّها الكَلبُ الكَلِب","أُو لا فَوَلِّ هارِباً ثُمَّ اِنقَلِب",49,"ب",1,0],["وَآثَرَ أَن تَرتَضيهِ الأَنامُ","مِنَ الحَكَمَينِ لِأَسبابِها",50,"ب",3,0],["واثق الخطوة يمشي ملكاً","ظالم الحسن شهي الكبرياء",51,"ا",2,0],["وأثيثٌ ذو عقاصٍ غَيّمَتْ","فيه للمندل أنفاسُ دخان",52,"ن",1,0],["وأثارتْ شُزَّبُ الجُرْدِ بها","عِثْيَراً يَسودّ منه الخافقان",52,"ن",1,0],["وَأَثبَتَ اللَّه أَمْناً في قلوبِهِمُ","بَعدَ التقلُّبِ في الأحشاءِ من وجلِ",53,"ل",1,0],["وأَثبَتُ الأُسدِ في جَوفِ العدى قَدَماً","إِذا جَناحُ لِواءٍ فَوقَهُ خفَقَا",54,"ق",2,0],["وَأَثبَتَ لِلعَلياءِ مِنهُم قَواعِداً","لأعدائِهِ منها قواعدُ تَنْهَدُّ",55,"د",1,0],["وَآثارٌ مُوَكَّلَةٌ بِأَلّا","يُجاوِزُ ما رَقَشنَ لَهُ عَريبُ",56,"ب",1,0],["وَأَثلاثُها السُفلى بُرادِيُّ ساحِلٍ","وَأَثلاثُها الوُسطى كَثيبٌ مِنَ الرَملِ",57,"ل",1,0],["وَأَثلاثُها العُليا كَأَنَّ فُروعَها","عَناقيدُ تُغذى بِالدِهانِ وَبِالغِسلِ",57,"ل",1,0],["وأثبتِهم في الحادثِ النُّكرِ موقفاً","وأَنْفذِهم سَهْماً إذا أخطأ الرامي",58,"ي",1,0],["وآثرتُ المحجّةَ والسبيلا","أراك أطعتَهم وأبيتَ إلّا",59,"ل",2,0],["وَأثبَتَ فِي الصُّحفِ زَهرَ الرَّبِيعِ","فَحَدّث عَن المُثمِرِ الذَّبِلِ",60,"ل",1,0],["وَأَثبَتَ الأَعرابَ في الديوانِ","وَقالَ إِنّي مِن بَني شَيبانِ",61,"ن",1,0],["وَأَثافٍ بَقَينَ لا لِاِشتِياقِ","جالِساتٍ عَلى فَريسَةِ نارِ",62,"ر",1,0],["وَآثارِ وَصلٍ في هَواكِ حَفِظتُها","تَحِيّاتِ رَيحانٍ وَعَضّاتِ تُفّاحِ",63,"ح",1,1],["وأثَارَتْ بأرضِ مكةَ نَقْعَاً","ظُنَّ أن الغُدُوَّ منها عِشاءُ",64,"ا",2,0],["وَأَثْبَتَ الوجِدُ خَطَّيْ عَبْرَةِ وضَنىً","مِثْلَ البَهارِ عَلَى خَدَّيْكَ وَالعَنَمِ",65,"م",1,0],["وأثكَلْتَه منه القضيبَ تهَصّرَتْ","أعاليه والرّوْضُ المُفوَّفُ صُوّحا",66,"ح",2,0],["وَأَثبَتَ الثالِثَ الباقي بِنافِذَةٍ","مِن باسِلٍ عالِمٍ بِالطَعنِ كَرّارِ",67,"ر",1,0],["وَآثَرتَ حَرَّ النارِ تُسعَرُ دائِماً","عَلى الفَقرِ أَو غُصنٍ لَهُ غَيرِ وارِقِ",68,"ق",1,0],["وَآثَرُ عِندي مِن مَديحي تَخَرُّصاً","كَلامُ غَوِيٍّ لامَني وَهَجاني",69,"ي",1,0],["وأثْقَلْتَه مِن أنْعُمٍ وعَوَارِفٍ","فسَارَ بها سيرَ البَطِيءِ المُقيّدِ",70,"د",1,0],["وأثرتَ منه الرُّوحَ فانطلقتْ","تحسو الحميمَ وتأكلُ اللهبا",71,"ب",2,0],["وآثارُ دمعِك فوقَ الوسادِ","وفوق المُهدَّل من سترِها",72,"ر",3,0],["وأثارَ أجنحةَ الطيورِ فحوَّمتْ","في الأفقِ حيرى تتبعُ الأصداءَ",73,"ا",2,0],["وآثَرْتُ أخلاقَ السّرابيلِ بَعدَما","أكونُ وأوْفَى أدْرُعِ القوْمِ سِرْبالي",74,"ل",2,0],["وأثْبَتِ الناسِ قلْباً في ظَلامِ سُرًى","ولا رَبِيئَةَ إلا مِسْمَعُ الفَرَسِ",75,"س",1,0],["وأثقل الحقّ على الجماعه","إن وجدت أذن له سمّاعه",76,"ه",1,0],["وَأَثْرَى مِنَ المَالِ المُؤَثَّلِ بِالنُّهَى","وَأَثْرَى مِنَ الْحَمْدِ المُؤَثَّلِ بِالنَّدَى",77,"د",2,0],["وَآثَرَ أَنْ يَخْتَطَّ فِي العَيْشِ خُطَّةً","أَسَدَّ وَأَمْلَى أَنْ تُحَقِّقَ مَقْصِدَا",77,"د",2,0],["وَأَثَرٍ تَرُدُّهُ مِنْ غُرْبَةٍ","وَقَدْ بَذَلْتَ فِيه بَذْلَ الفَادِي",78,"د",2,0],["وَأَثابُوا بِالرَّدَى قَيصَرَ إذْ","أَخْضَعَ الدُّنْيَا لهُمْ بَرّاً وَبَحْرَا",79,"ر",2,0],["وَأَثْخنَ جُرْحاً فَأَقْصَاكَ عَنْ","ثَرَى مِصرَ مُجْتَنَباً مُزْدَرَى",80,"ر",2,0],["وَأَثارَ فِي الأَوْتَارِ تَغْرِيداً","كَأَنَّ الْعُودَ طائِرْ",81,"ر",1,0],["وأثالة رجل المحامد بيته","بيت الفخار وملتقى الضيفان",82,"ن",1,0],["وَآثَرتُ ديني وَاِقتَنَعتُ بِما كَفى","وَعِشتُ عَزيزاً وَالغَريبُ ذَليلُ",83,"ل",1,0],["وآثارُ فَضْلٍ في البِلاَدِ رَفَعْتَها","كما كَان إِسْمَاعيلُ للْبَيْت يَرْفَع",84,"ع",1,0],["وَاثِباً لاهِياً لَعُوباً ضَحوكاً","غيْرَ مَا وَاجلٍ وَلا هَيَّابِ",85,"ب",1,0],["وَاثقاً بالإِله لَيْسَ يَرَى الصَّعْبَ","سِوَى أَن تَهابَ خَوْضَ الصِّعَاب",85,"ب",1,0],["وآثارُ عِرفانٍ تُضيءُ كأنّما","تناثر حول النيل عِقْدٌ مُرَصّع",86,"ع",1,0],["وأثرنها شعواء من","خلف الخدور على الرجال",87,"ل",1,0],["وآثَرَتْ نفسُكْ الأخرى، ولو خَضَعَتْ","يومًا، لكان لها دنيا سُلَيْمانا",88,"ن",2,0],["وآثارُها كعبةٌ للفنونِ","تُزَار، أَلَمْ تَرَ قُصَّادها؟",89,"د",3,0],["وأثيرٌ من بات عنِّي بعيدًا","وكثيرٌ أَولاديَ الغرباءُ",90,"ا",2,0],["وآثار أملاك كرام تقلدوا","حلا بيتك النصري لله دره",91,"ر",2,0],["وآثر تقوى الله منها فلم يكن","بمشتغل عنها بزور ولا فم",92,"م",1,0],["وأثيم أيّامه للدنايا","ولياليه للبغايا الهوائم",93,"م",1,0],["وآثامها لم تسعها اللّغات","ولم يحو تصويرها ملهمُ",94,"م",1,0],["وأثبتَ فرعاً فِي الفروعِ ومنبتاً","وعوداً غداةَ المزنِ، فالعودُ أغيدُ",95,"د",1,0],["وأثبَتَ الثّالثَ الباقي بنافِذَة","ٍ، من باسِيلٍ عالمٍ بالطّعنِ، كرّارِ",96,"ر",1,0],["وأُثقلها بالعَتْب أن كان لي غنى","عن الشرِّ لولا حبُّها للمَخاطر",97,"ر",1,0],["وأثرتُ هاجعةَ القوافي لم تجد","في الراقدين لركضة ميدانا",98,"ن",2,0],["وأثقلَتْ مُتَعُ الدُّنيا قوادِمَهُ","فما ارتقى صُعُداً حتَّى ادَّنى صَبيا",99,"ب",3,0],["وأثني على الحيّينِ عمرٍو ومالكٍ","ثناءً يوافيهمْ بنجدٍ وغائرِ",100,"ر",1,0],["وَأَثبتُّمُ قَولَ من لَفظُه","هُوَ الحَقّ وَالشَرعُ مِنهُ يَقوم",101,"م",1,0],["واثب قلبي ثباتا","عل فيه الصبر يفرغ",102,"غ",1,0],["وإثاره لا ريب فيه وأنه","تبرأ من بخل فسبحان من برا",103,"ر",2,0],["وأثاب وغد القوم غاية قصده","فعلاً وأوصله لذلك جهله",104,"ل",2,0],["وأثبني إخلاص قلب وصدق","واشف يا عمدتي بفضلك دائي",105,"ا",2,0],["وأثقلني همي وأقعدني فما","أصعد طرفي مرةً في سمائيا",106,"ي",2,0],["وأثر في الفؤاد ناراً تلظى","فحياتي في غير هذا الخمود",107,"د",1,0],["واثنان لا تذكرهما واعرفهما","سوءُ المسىء وفَعْلَهُ الحسناتِ",108,"ت",1,0],["وأثيثا يحكى الظلام اسودادا","ومحيًّا يحكى الصباح وسيما",109,"م",2,0],["وآثرَ معشراً ضلوا سبيلاً","فما عرفوا النبيَّ ولا الإلها",110,"ا",1,0],["وأثمرَه الصبرُ الذي لم تزل بهِ","حُماةُ الهدى والدينِ تستنزلُ النصرا",111,"ر",2,0],["وَأَثمَرَت فيكَ آمالي وَلَو قَصَدَت","سِواكَ كانَت غُصوناً مالَها ثَمَرُ",112,"ر",1,0],["وآثر السجن إرضاء لخالقه","ولم يزل به في خطره الدَّحض",113,"ض",1,0],["وَأَثبَتَهُمُ في كُلِّ بابٍ سيادَةً","لَئن كانَ رُسل اللَهِ لِلناسِ سادَةً",114,"ه",1,0],["وأثنى على من ليس يصلحُ للثنا","فقلتُ له أهلا وسهلاً ومرحبا",115,"ب",2,0],["واثنى عليه بالذي قد أعاره","وألبسه من كلِّ فضلٍ وأكسبا",115,"ب",2,0],["وآثار غنما بالنجاحين أثروا","على فعل أمر ليس يرضى به التركا",116,"ك",2,0],["وأثار شراً ساكناً فتلاطموا","بالمشرفيةِ واستقامَ العثيرُ",117,"ر",1,0],["وأثنى على من لم يجب نوح إذ دعا","إلى ترك ود أو سواع وناسر",118,"ر",1,0],["وأثنى على فرعون بالعلم والذكا","وقال بموسى عجلة المتبادر",118,"ر",1,0],["وأُثنِى كما تُثْنى الرياُ على الحَيا","إذا حركتْها في الأَصائِل ريح",119,"ح",1,0],["وَأثقالهُم لو ذرّةٌ من جبالها","عَلى الدهرِ قَد خرّت لأثقلتِ الدهرا",120,"ر",2,0],["واثمارها هامٌ واغصانها الظبى","ومن زهرها ذاك الرصاص نثيرُ",121,"ر",1,0],["واثبةٌ ساكنةٌ","مالتْ ولما تملِ",122,"ل",1,0],["واثبتي للعمرِ آونةً","فليالي العمرِ في هربِ",123,"ب",1,0],["وأثرِ رياحَ وسائلٍ لمؤمِّلٍ","فعسى يُثِرنَ من النجاح سحابا",124,"ب",2,0],["وأثنى عليهِ بالقريضِ مدائحي","ولو لَجَّ عذّالي عليَّ وقالوا",125,"ل",3,0],["وأثقلُ مِنْ رَضْوَى وأعقلُ مَن سَعى","بنعلٍ وأوفاهم ذِماماً ومَوْعِدا",126,"د",2,0],["وأثارت نقع الصبابة حتى","ضلت النفس في قتام الهيام",127,"م",1,0],["وَأَثرَتِ حُنجُرَة الفجور فَأَطلَقَت","حِمَماً عَلى نَغَمِ الجَحيمِ مُوَقَّعَه",128,"ع",2,0],["وأَثبتَّ في الأسماع برهانَ حكمةٍ","يُقَصِّر عنها من يقول ويُطْنِب",129,"ب",1,0],["وَأَثقالٌ أَهُدُّ بِهِنَّ ظَهري","لَقَد عَرَّضتُ نَفسي لِلبَلاءِ",130,"ا",2,0],["وَأَثَّلتَ مَجداً طارِفاً غَيرَ قانِعٍ","بِمِراثِ مَجدٍ سالِفٍ وَعَلاءِ",131,"ا",2,0],["وَأَثِبْ ذِي الْخُطَى التِي أَوْصَلَتْنَا","لِحِمَاكَ الْمَعْلُولِ بِالإِشْرَاقِ",132,"ق",1,0],["وَأَثَارَتْ مَا لَمْ يَكُنْ عَِلِمَ اللَّ","هُ لِيُخْمِدَ مِنْ لَهِيبِ اشْتِيَاقِي",133,"ي",1,0],["وَأَثْنَى عَلَيْهِ الْكَرِيمْ","بِهِ فِي الْقُرْآنِ الْمَجِيدْ",134,"د",1,0],["وأثمار جنّات حبّي اجتنى","بذات اليمين وذات الشمال",135,"ل",1,0],["وأثار بالذكرى عهوداً لم تكن","تنسَى وأنسى سالفَ الإيعاد",136,"د",1,0],["واثقل ما حملته قلب راحل","حليف صبابات بحب مقيم",137,"م",1,0],["وآثارُ بؤس أو نعيمٍ تناثرت","على سُبُلِ الأيام في العسرِ واليسر",138,"ر",1,0],["وأثمله مر النَسيم فَما دَرى","أنسمة طيب أَم ضيا طيبة هبا",139,"ب",2,0],["واثبت بنور العلم وَالحلم منك لي","سَعادة حظ ما لمثبتها حذف",140,"ف",1,0],["وَأَثَّتْ رِياشاً فاسْتَحَثَّتْ لِدَعْوَةٍ","عَلَى رَبِّها أَن يَكْفِي الحَسِّ والحَصَّا",141,"ص",2,0],["وَأَثقَفُ مَن سَطا بِالسَيفِ صَلتاً","إِذا بِثِقافِهِ حَمِيَ المقامُ",142,"م",1,0],["وأثني على ما صُغتَه من قلائِدٍ","تَحَلّى بها من جيدِ مدحيَ عاطلُه",143,"ل",2,0],["وَأثّلَ في كلّ القلوبِ مودّةً","كَستهُ غنى دينٍ ودنيا مفوّفا",144,"ف",2,0],["وآثرت لذاتي ونيل مآربي","واتبعت نفسي كل شيءٍ أحبت",145,"ت",1,0],["وإثباتها وقت الزوال بركعة","وإتمامها عند الغروب بسجدة",145,"ه",1,0],["وَأَثارَ بي وَجدي وَآثَرَ بَعدَهُ","فَغَدا العَذولُ فَما يَكونُ تَحيلي",146,"ل",2,0],["وأثار المِصباحُ رقصَك فاهتزّ","خفوق الأشعّة الحمراء",147,"ا",2,0],["وأثرتِ كامن لوعتي وتركتني","صباً مشوقاً ليس ينعمُ بالا",148,"ل",2,0],["واثملي كالزهور","واسخري كالقدر",149,"ر",1,0],["وأَثمَرَتِ السُّمْرُ هَامَ الكُماةِ","وعَاجَلْنَها بِأَوانِ الجَناءِ",150,"ا",2,0],["وَأَثَّرَ سَيْرُهُ في كُلِّ سَيْرٍ","وَخَدَّهُ مَا ضَغَيْهِ في الحَدائِدْ",151,"د",1,0],["وأَثابَها المنصورُ لِلمهدِى إذاً","هَمَلتْ سَواداً مِن بَني العَبَّاسِ",152,"س",1,0],["وَأَثبَتُ في المِثلِ الظُهرورَ إِذا اِخ","تَفى المِثالُ وَأَنفي مَزجَهث بِالهَوِيَّةِ",153,"ه",1,0],["وَاِثنِ عِطفَيكَ عَن مَلامِ غَوِيٍّ","لَكَ بِالصَدِّ عَن هَداكَ تَصَدّى",154,"د",2,0],["وَأَثنَينا عَلى أَوصافِ سُعدى","وَمَعنىً غَيرَ حُسنَكِ ما عَنَينا",155,"ن",2,0],["وأثن مَعِي على سَفَرٍ حَمِيدٍ","قَضَى لِي مِن لِقَائِكَ كُلَّ سُولِ",156,"ل",1,0],["وأثَرْتُها شَطْرَ العِرا","قِ تَجُرُّ فَضْلاتِ الحِبال",157,"ل",1,0],["وأثمانُها الأرواحُ تُبذَلُ والوغى","لَهُنّ عُكاظٌ والرِّماحُ تِجار",158,"ر",1,0],["وآثارُ أغلالٍ تَوالَتْ فلم تدَعْ","لدى النّاسِ آثاراً إلى اليومِ تُحمَد",159,"د",1,0],["وَأُثني عَلى نارٍ ضُلوعاً وَأَلتَظي","وُلوعاً وَأَستَشفي دُموعاً جَوارِيا",160,"ي",2,0],["وأثبت مَن إن قال قولا وفي به","على كل خطبٍ في العظائم معضل",161,"ل",1,0],["وأثيمٍ قد أتاها","راح بالغفران زاكن",162,"ن",1,0],["وأثبتَ فيه حقَّ أجرٍ وأُجرةٍ","وإرثٍ وأَرشٍ والقِصاصِ المضارع",163,"ع",1,0],["وأثبتمُ الإيمان بالحق قائماً","وفنَّدتمُ آراء أهل البدائع",163,"ع",1,0],["وَأَثاف تَحكي قُلوب المُحبين","اِحتِراقاً لَكنَها لا تَطيرُ",164,"ر",1,0],["واثن المَطيَّ قليلاً","على المُحبِّ العَميد",165,"د",1,0],["وأثنى بالمحامد","على رب البريات",166,"ت",1,0],["وآثار نويرة","من أرباب الكشوفات",166,"ت",1,0],["واثبتْ ثباتَ \"شَدَا\" و\"حُزْنَةَ\" كُلَّم","لاقيتَ مهزوزَ الفؤادِ مُذبْذَبا",167,"ب",2,0],["وأثبتهم جأشاً إذا شهد الوغى","يفوق الحصا من كفه الضرب والطعنا",168,"ن",2,0],["واثنان ما للعفو فيهن مدخل","ولا حام منه حول ذلك حائم",169,"م",1,0],["واثكلتاه لأقلامي وما رقمت","كأنها من رماح الدهر تشرع لي",170,"ل",2,0],["وأثني عليه وهو واللّه بالثنا","حقيق فقل ما شئت في الواحد الفرد",171,"د",1,0],["واثْن العنان إلى الثنا","ء على بديع الاندماج",172,"ج",1,0],["وأثْقَلَني حملُ هذا الغرام","وحَمَّلَني الوجدُ عبئاً عظيما",173,"م",2,0],["وآثار ما أبقى الخليط بعهده","ونُؤياً كمعْوَجِّ السّار مهدَّما",174,"م",2,0],["وأثْقَلَ بالأَيدي لساني وعاتقي","ألَم تَرَني لا أستطيعُ التّكلّما",174,"م",2,0],["وأثْنَتْ عليهمْ بالجميل عوالمٌ","فمن مقصرٍ في مدحِهِم ومطيل",175,"ل",1,0],["واثقاً بالله ربي والغنى","من ندى عبد الغنيِّ في ضمان",176,"ن",1,0],["وأثبت الحب له دلائلاً","بصبّه منها النحول والضنى",177,"ا",1,0],["وأُثني عليه بالَّذي هو أهله","وأُنْشِدُهُ ما قلتُ فيه ويسمعُ",178,"ع",1,0],["وأَثنَيْنَا على مَجْدٍ أصيلٍ","عَجَزْنَا أَن نُوَفِّيَهُ الثَّناءَ",179,"ا",2,0],["وأثارَ نقْعَ جفائه لكنّهُ","لم يجْفُني حتى استنابَ نُقوعَهُ",180,"ع",2,0],["وأثبتت للعلا والمكرمات إذن","محاضرُ بانعدام البذل والجود",181,"د",1,0],["وأثبتّ من جدوى يديك مناقا","هي المجد لا ما يبتغي منه كاسبه",182,"ب",2,0],["وأثل مجده حتى تساوى ال","عليم بما يشيد والغبيّ",183,"ي",1,0],["وآثارُها فِي الأَرْضِ أَشْلاءُ كافِرٍ","وغاوٍ وَفِي جَوِّ السماءِ غمائِمُ",184,"م",1,0],["وأَثقَلْتُ أوتارَ الرِّكابِ جَوَاهِراً","عَلَى ثَمنٍ يَعْدُو بِهِ مُحْوِلُ النَّمْلِ",185,"ل",1,0],["وأثمان النفوس لها قرار","وكل بضاعة تهدى لسوق",186,"ق",1,0],["وأثنيت العنان بلا حزناً","ووجداً لن يطاق ويستطاعا",187,"ع",2,0],["وأثر في شهب السماء وفي الحصا","وفي الأرض تأثير الرياح الصيارم",188,"م",1,0],["وأثَرتُ جوهرَ بحره متعمِّقا","والناسُ يحتشُّون فوق الساحلِ",189,"ل",1,0],["وآثار من الأيام بيض","كآثار البدور على الليالي",190,"ي",1,0],["وَأَثرٌ من ظاعنينَ أَحمدوا","من عيشهم على الأُثَيلاتِ الأَثَرْ",191,"ر",1,0],["وأثير النَّقع من أنديةٍ","يعبقُ المندلُ فيها بالنسيم",192,"م",1,0],["وأثبت الحق والدهماءُ شاهدةٌ","قولُ الفرزدق عند البدو والمُدنِ",193,"ن",1,0],["وأثني رقابَ العيس عن موقف العلى","لَحزْميَ عن رأيٍ أجَلْتُ بعيدُ",194,"د",1,0],["واثِباً لو سابقَتْهُ زَعْزَعٌ","غادَرَ الهُوجَ رَذايا ثُمَّ سارا",195,"ر",2,0],["واثق في الحروب بالنصر لا","يقدم جهلاً بهن إما وإما",196,"م",2,0],["وأثرتَ في اِثرِ الظعائنِ زفرةً","تُغني مطايا الراحلينَ عنِ الحِدا",197,"د",2,0],["واثبت على مبدأ أيدت صحته","حتى توخيته سيرا مع العمر",198,"ر",1,0],["وأثبنا يا رب فتحاً قريباً","وامح ليل الضراء بالسراء",199,"ا",2,0],["وأَثابَ القُوى بُروزاً وطَمْساً","فهوَ مُعْطي القُوى لكلِّ قَوِيِّ",200,"ي",1,0],["واثْبِتوني رِقًّا وإنْ رَقَّ عَظْمي","فَحَياتي بِرقَّةِ اسْتِرْقاقي",201,"ق",2,0],["وآثارِ أنْواعِ الجَمالِ التي انْجَلَتْ","ومَضْمونُها قد لاحَ في طرَفِ الرَّوْضِ",202,"ض",1,0],["وأَثبتَكُمْ في حضرةِ القدسِ رحمَةً","لعُجْمِ البرايا كلِّها والأَعارِبِ",203,"ب",1,0],["وآثرت درء الحد عنهم بشبهة","لظاهر اسلام وحكمك اعدلُ",204,"ل",1,0],["وآثارك الغرّ تبقى بها","وتلك المآثر للآثر",205,"ر",1,0],["واثْنوا الأعنّةَ نحو سكّانِ اللّوى","واِلوُوا بأعناقِ المطيّ وعوّجوا",206,"ج",3,0],["وآثارٌ على دُهْمِ الليالي","حكَتْ غُرَرَ المسوّمةِ العِرابِ",207,"ب",1,0],["وأثكَلْتَ الخزائِنَ فهْي تنعى","على الولدِ المقرَّطِ بالجِرابِ",207,"ب",1,0],["وأثواب الحداد على بلاد","رماها بالمهندة الحداد",208,"د",1,0],["وآثرت في مارني أرسانه","واعتاد ظهري العري من جلاله",209,"ل",2,0],["وأثني الله مولّينا النّعم","من حيا الأرض بجريان الغدُور",210,"ر",1,0],["وآثارٌ له عندي قباحٌ","يجمّش بينها الرأس الحديدُ",211,"د",1,0],["وأَثَرْتَ نَارَ الشَّوْقِ وَهْيَ مناخة","فَتَخِبُّ وَهْيَ عَلَى الْحَضِيضِ الأَوْضَعِ",212,"ع",1,0],["وَأَثنى عَلَيهِم صالِحاً في كِتابِهِ","فَكانَ الَّذي أَثنى أَجَلَّ وَأَكثَرا",213,"ر",2,0],["وأثقلني ولم أكُ طولَ عمري","حملتُ لغيره المِنَنَ الثّقالا",214,"ل",2,0],["وآثرنا دون الأنامِ بصِهْرِهِ","وقد ذِيدَ عنه الطّالبُ المُتَشَوِّفُ",215,"ف",1,0],["وَأَثّر في جيدِها ساعدي","وأثّر في جانبيَّ السِّوارُ",216,"ر",1,0],["وأثارت عرف روضته","في الورى طوبى لمنتشق",217,"ق",1,0],["وأثنوا عليه بالذي هو أهله","ومنه استعاذوا فهو ضار ونافع",218,"ع",1,0],["واثبت على الشرع وما جاء من","أحكامه تظفر بتنويره",219,"ر",2,0],["واثنان في الغيب نحن وهو ولا","يمكن تغييرنا وتغييره",220,"ر",2,0],["وأثنَى بما فيهِ فكانَ كأنَّهُ","بذاكَ يُناجي نفسَهُ وَهْوَ غافِلُ",221,"ل",1,0],["وأثبَتُ من شُمِّ الجبالِ فلم يكُنْ","يُحرِّكُ زَلزالُ الخُطوبِ سكونَهُ",222,"ن",2,0],["واثبت في لوح السياسة أمةً","قد إتفقت في محوها أمم أخرى",223,"ر",2,0],["وأثبت الذين قالوا في الخبر","بأنه أمرهم لما أمر",224,"ر",1,0],["وأثر السجود في مساجده","فكان في ذلك في مشاهده",224,"ه",1,0],["وأَثْريتُ من دينار خَدٍّ مَلكْتُه","وأَحسنُ وَجهٍ بعدَه مثلُ دِرْهمِ",225,"م",1,0],["وأَثْنَى عليه كلُّ شيءٍ محبةٍ","وعادَ فصيحاً فيه ما كان أَعْجما",226,"م",2,0],["وأَثقلَها الحسنُ الَّذي قد تكاثرَتْ","ملاحتُه حتَّى تَثَنَّت مِنَ الثِّقل",227,"ل",1,0],["وآثَرتُ صُحبَةَ مولى الأَنامِ","لأَبْلُغ مِنْه الَّذِي أُوثِر",228,"ر",1,0],["وأَثْلج صَدْري من هوَاجِر رَبْعِه","فيا بَرْدَةً مِن حَرِّ تلَكَ الْهَواجرِ",229,"ر",1,0]]}