{"poems":[[55,"عسكر الحب في فؤادي مقيم","https://www.aldiwan.net/poem26125.html","الخفيف"],[86,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[93,"يا لها اللَه غادة ذات دل","https://www.aldiwan.net/poem11076.html","الخفيف"],[88,"لا تأمنن دنياك في حالة","https://www.aldiwan.net/poem44805.html","السريع"],[88,"أيها القوم مالكم في جمود","https://www.aldiwan.net/poem44819.html","الخفيف"],[47,"ولي منة في رقاب الضباب","https://www.aldiwan.net/poem25271.html","المتقارب"],[23,"لمن الدار أوحشت بمغان","https://www.aldiwan.net/poem21389.html","الخفيف"],[23,"قد عفا جاسم إلى بيت راس","https://www.aldiwan.net/poem21625.html","الخفيف"],[72,"في ثغرها الحلو أو في جيدها الحالي","https://www.aldiwan.net/poem19473.html","البسيط"],[51,"يا كريما لم يزل محتمِا","https://www.aldiwan.net/poem66525.html","الرمل"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[92,"اسكني يا جراح","https://www.aldiwan.net/poem38902.html","مجزوء المتدارك"],[89,"أحمد كان مثل بحر رحيب","https://www.aldiwan.net/poem44619.html","الخفيف"],[85,"لِيعِنا كل معبود معين","https://www.aldiwan.net/poem7767.html","الرمل"],[85,"آل زغلول حسبكم من عزاء","https://www.aldiwan.net/poem62833.html","الخفيف"],[85,"أيها العمال أفنوا العمر","https://www.aldiwan.net/poem63778.html","مجزوء الرمل"],[45,"كيف به والزمان يهرب به","https://www.aldiwan.net/poem10913.html","المنسرح"],[49,"قد دعوناه نائيا فوجدنا","https://www.aldiwan.net/poem64236.html","الكامل"],[80,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[80,"وباكية بعيون الجراح","https://www.aldiwan.net/poem31335.html","المتقارب"],[44,"أيها البرق بت بأعلى البراق","https://www.aldiwan.net/poem30394.html","الخفيف"],[31,"ضحكت أم نوفل إذ رأتني","https://www.aldiwan.net/poem41286.html","الخفيف"],[52,"لا تملا حثنا واسقيانا","https://www.aldiwan.net/poem26608.html","المديد"],[48,"ومعتد بالذي تحوي أنامله","https://www.aldiwan.net/poem64499.html","البسيط"],[48,"يا من ينادي الدار هل تنطق","https://www.aldiwan.net/poem66594.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85672","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16681","السريع"],[106,"تكلمي يا كتائب","https://www.poetsgate.com/ViewPoem.aspx?id=179636",""]],"verses":[["قَد دَعاني الهَوى فَلَبَّيتُ أَلفاً","إِذ دَعاني إِلَيكُمُ يا ظَلومُ",0,"م",1,0],["قَد دُهيتُم في دورِكُم وَدُهينا","في نُفوسٍ أَبَينَ إِلّا اِحتِسابا",1,"ب",2,0],["قد دعاها العشاق عيداً ولكن","حرفت اسمها وقالت إيدا",2,"د",2,0],["قد دبَرت منهم لهم كيدها","حتى غدت منهم بهم واتره",3,"ر",2,0],["قد دعتكم أوطانكم فأجيبوا","دعوة الآمرين بالتجنيد",4,"د",1,0],["قَدَدنَ البَقيعَةَ قَدَّ الأَدي","مِ وَالغَربُ في شَبَهِ الأَشقَرِ",5,"ر",1,0],["قَد دَنا الفِصحُ فَالوَلائِدُ يَنظِم","نَ قُعوداً أَكِلَّةَ المَرجانِ",6,"ن",1,0],["قَد دَنا الفِصحُ فَالوَلائِدُ يَنظِم","نَ سِراعاً أَكِلَّةَ المَرجانِ",7,"ن",1,0],["قد دبرت مصر والأمصار فكرته","يوميْ نزالٍ بقطريها وإنزال",8,"ل",1,0],["قد دعتْكَ النفسُ من غمْرتها","فتداركْها فلم تدعُ وثن",9,"ن",1,0],["قَد دَخَلتُ الدَيرَ عِندَ الفَجرِ كَالفَجرِ الطَروبِ","وَتَرَكتُ الدَيرَ عِندَ اللَيلِ كَاللَيلِ الغَضوب",10,"ب",1,0],["قَد دَخَلتُ الدَيرَ أَستَنطِقُ فيهِ الناسِكينا","فَإِذا القَومُ مِنَ الحَيرَةِ مِثلي باهِتونا",10,"ن",2,0],["قَدْ دعاني الصَّباحْ","ورَبيعُ الحَيَاهْ",11,"ه",1,0],["قد دعاك العلا فسرت اليه","ودعوت العلا فكان مجيبا",12,"ب",2,0],["قد دعونا لنخلّى ديننا","ولنستهزى بأرباب لنا",13,"ن",2,0],["قَد دَهاهُ مِن فَقدِهِ ما دَهاكُم","وَبَكى ما بَكَيتُمُ مِن خِلالِه",14,"ل",2,0],["قَد دَعاكُم ذَنبَ الهَي","ئَةِ داعٍ فَأَصابا",15,"ب",2,0],["قَد دَأَبَ العاذِلُ اللَجوجُ فَلَم","أُصغِ لِفَرطِ الإِكثارِ مِن دَأَبِه",16,"ب",2,0],["قَد دَعَوناهُ نائِياً فَوَجَدنا","هُ عَلى نَأيِهِ قَريباً سَميعا",17,"ع",2,1],["قد دُفِعْنا إلى حياةٍ وموْتٍ","ونشورٍ إلى الإلهِ العَليِّ",18,"ي",1,0],["قددتُ بها الدرعَ فوق الكميّ","كما شُقّ مَتْنُ غديرٍ غلَل",19,"ل",1,0],["قَد دَنَت حَلقَتا خِناقي فَراخى","بِأَياديهِ عَقدَ ذاكَ الخِناقِ",20,"ق",1,0],["قَد دَعاني وَقَد دَعاهُنَّ لِلَّه","وِ شُجونٌ مِن أَعجَبِ الأَشجانِ",21,"ن",1,0],["قَد دَعَوناهُ إِلى الكَأسِ حَتّى","هَشَّ لِلساقي وَمَدَّ البَنانا",22,"ن",2,0],["قَد دَبَّتِ الخَمرُ سِرّاً في مَفاصِلِهِ","فَماتَ سُكراً وَلَكِن حاطَهُ الأَجَلُ",23,"ل",1,0],["قد داومَ الإطراقَ حتى لهُ","يحسب عيّاً وهو المفلقُ",24,"ق",1,0],["قد دعوت الشعب للعل","مِ إلى أن بح صوتي",25,"ي",1,1],["قد دَرِمَتْ من كِبَرِ أُخْتُها","وعُمّرَتْ عَصْراً فلم تَدْرَم",26,"م",1,0],["قد دقَّ ناقوسُ الجهاد، فأنْصِتِي","ودعا الحمى أبطالَه، فتقدَّمي",27,"م",2,0]]}