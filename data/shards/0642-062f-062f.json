{"poems":[[55,"عسكر الحب في فؤادي مقيم","https://www.aldiwan.net/poem26125.html","الخفيف"],[86,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[93,"يا لها اللَه غادة ذات دل","https://www.aldiwan.net/poem11076.html","الخفيف"],[88,"لا تأمنن دنياك في حالة","https://www.aldiwan.net/poem44805.html","السريع"],[88,"أيها القوم مالكم في جمود","https://www.aldiwan.net/poem44819.html","الخفيف"],[47,"ولي منة في رقاب الضباب","https://www.aldiwan.net/poem25271.html","المتقارب"],[23,"لمن الدار أوحشت بمغان","https://www.aldiwan.net/poem21389.html","الخفيف"],[23,"قد عفا جاسم إلى بيت راس","https://www.aldiwan.net/poem21625.html","الخفيف"],[72,"في ثغرها الحلو أو في جيدها الحالي","https://www.aldiwan.net/poem19473.html","البسيط"],[51,"يا كريما لم يزل محتمِا","https://www.aldiwan.net/poem66525.html","الرمل"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[92,"اسكني يا جراح","https://www.aldiwan.net/poem38902.html","مجزوء المتدارك"],[89,"أحمد كان مثل بحر رحيب","https://www.aldiwan.net/poem44619.html","الخفيف"],[85,"لِيعِنا كل معبود معين","https://www.aldiwan.net/poem7767.html","الرمل"],[85,"آل زغلول حسبكم من عزاء","https://www.aldiwan.net/poem62833.html","الخفيف"],[85,"أيها العمال أفنوا العمر","https://www.aldiwan.net/poem63778.html","مجزوء الرمل"],[45,"كيف به والزمان يهرب به","https://www.aldiwan.net/poem10913.html","المنسرح"],[49,"قد دعوناه نائيا فوجدنا","https://www.aldiwan.net/poem64236.html","الكامل"],[80,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[80,"وباكية بعيون الجراح","https://www.aldiwan.net/poem31335.html","المتقارب"],[44,"أيها البرق بت بأعلى البراق","https://www.aldiwan.net/poem30394.html","الخفيف"],[31,"ضحكت أم نوفل إذ رأتني","https://www.aldiwan.net/poem41286.html","الخفيف"],[52,"لا تملا حثنا واسقيانا","https://www.aldiwan.net/poem26608.html","المديد"],[48,"ومعتد بالذي تحوي أنامله","https://www.aldiwan.net/poem64499.html","البسيط"],[48,"يا من ينادي الدار هل تنطق","https://www.aldiwan.net/poem66594.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85672","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16681","السريع"],[106,"تكلمي يا كتائب","https://www.poetsgate.com/ViewPoem.aspx?id=179636",""],[107,"لي حبيب فداه كل حبيب","https://www.aldiwan.net/poem16682.html","الخفيف"],[113,"صبرا امي فذي الشخوص خيال","https://www.aldiwan.net/poem40634.html","عموديه"],[127,"الطبول الطبول إِنا انتصرنا","https://www.aldiwan.net/poem67451.html","الخفيف"],[135,"خف من دار جيرتي","https://www.aldiwan.net/poem67982.html","مجزوء الخفيف"],[141,"من عف عن ظلم العباد تورعا","https://www.aldiwan.net/poem11773.html","الكامل"],[141,"لله قدرك ما أجل وأشرفا","https://www.aldiwan.net/poem11781.html","الكامل"],[141,"إدراك وصفك ليس في الإمكان","https://www.aldiwan.net/poem11827.html","الكامل"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[193,"لمن الدار مثل خط الكتاب","https://www.aldiwan.net/poem54424.html","الخفيف"],[196,"كتبت ولو أنني أستطيع","https://www.aldiwan.net/poem51943.html","المتقارب"],[209,"يا أمير الغناء يفديك روحي","https://www.aldiwan.net/poem46323.html","الخفيف"],[227,"قد دعانا إلى الصبا الناقوس","https://www.aldiwan.net/poem50978.html","الخفيف"],[233,"قد دخلنا حمامكم فرأينا","https://www.aldiwan.net/poem31641.html","الخفيف"],[254,"أبا الحسين بن نصر","https://www.aldiwan.net/poem48554.html","المجتث"],[259,"أأبحت يا هذي دم المهجور","https://www.aldiwan.net/poem38277.html","الكامل"],[301,"قد دب صدغك في أثناء ديباج","https://www.aldiwan.net/poem57932.html","البسيط"],[320,"ذرفت عيني دموعا","https://www.aldiwan.net/poem56351.html","مجزوء الرمل"],[374,"كلفت نفسي جهادا فاستفدت به","https://www.aldiwan.net/poem66884.html","البسيط"],[390,"شيب لغير أوانه يعتاد","https://www.aldiwan.net/poem53667.html","الكامل"],[400,"أحسن ما يبدي به الكلام","https://www.aldiwan.net/poem33344.html","الرجز"],[400,"يقول من في علمه يدعي","https://www.aldiwan.net/poem33610.html","السريع"],[413,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[429,"قل للإمام الذي فضائله","https://www.aldiwan.net/poem12542.html","المنسرح"],[450,"يا لعهد مضى وعيش رغيد","https://www.aldiwan.net/poem13711.html","الخفيف"],[456,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[480,"أشكو له منه مهجتي","https://www.aldiwan.net/poem24282.html","عموديه"],[480,"البين في سقر","https://www.aldiwan.net/poem24370.html","عموديه"],[480,"هي لؤلؤ تفتر عن درّ بدا","https://www.aldiwan.net/poem24469.html","عموديه"],[498,"لله من جفن هملن دموعه","https://www.aldiwan.net/poem37965.html","الكامل"],[501,"قد دنا الفصل في الصباح وللسل","https://www.aldiwan.net/poem21742.html","الخفيف"],[527,"يا بن البهاليل والأطواد من مضر","https://www.aldiwan.net/poem37166.html","البسيط"],[536,"حي فيها الإخلاص ولاإقداما","https://www.aldiwan.net/poem47934.html","عموديه"],[549,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[560,"بين قلب المحب والأحداق","https://www.aldiwan.net/poem52949.html","الخفيف"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[573,"سلام عليه لا على الدهر بعده","https://www.aldiwan.net/poem3075.html","الطويل"],[584,"هذا العقيق فما لقلبك يخفق","https://www.aldiwan.net/poem18003.html","الكامل"]],"verses":[["قَد دَعاني الهَوى فَلَبَّيتُ أَلفاً","إِذ دَعاني إِلَيكُمُ يا ظَلومُ",0,"م",1,0],["قَد دُهيتُم في دورِكُم وَدُهينا","في نُفوسٍ أَبَينَ إِلّا اِحتِسابا",1,"ب",2,0],["قد دعاها العشاق عيداً ولكن","حرفت اسمها وقالت إيدا",2,"د",2,0],["قد دبَرت منهم لهم كيدها","حتى غدت منهم بهم واتره",3,"ر",2,0],["قد دعتكم أوطانكم فأجيبوا","دعوة الآمرين بالتجنيد",4,"د",1,0],["قَدَدنَ البَقيعَةَ قَدَّ الأَدي","مِ وَالغَربُ في شَبَهِ الأَشقَرِ",5,"ر",1,0],["قَد دَنا الفِصحُ فَالوَلائِدُ يَنظِم","نَ قُعوداً أَكِلَّةَ المَرجانِ",6,"ن",1,0],["قَد دَنا الفِصحُ فَالوَلائِدُ يَنظِم","نَ سِراعاً أَكِلَّةَ المَرجانِ",7,"ن",1,0],["قد دبرت مصر والأمصار فكرته","يوميْ نزالٍ بقطريها وإنزال",8,"ل",1,0],["قد دعتْكَ النفسُ من غمْرتها","فتداركْها فلم تدعُ وثن",9,"ن",1,0],["قَد دَخَلتُ الدَيرَ عِندَ الفَجرِ كَالفَجرِ الطَروبِ","وَتَرَكتُ الدَيرَ عِندَ اللَيلِ كَاللَيلِ الغَضوب",10,"ب",1,0],["قَد دَخَلتُ الدَيرَ أَستَنطِقُ فيهِ الناسِكينا","فَإِذا القَومُ مِنَ الحَيرَةِ مِثلي باهِتونا",10,"ن",2,0],["قَدْ دعاني الصَّباحْ","ورَبيعُ الحَيَاهْ",11,"ه",1,0],["قد دعاك العلا فسرت اليه","ودعوت العلا فكان مجيبا",12,"ب",2,0],["قد دعونا لنخلّى ديننا","ولنستهزى بأرباب لنا",13,"ن",2,0],["قَد دَهاهُ مِن فَقدِهِ ما دَهاكُم","وَبَكى ما بَكَيتُمُ مِن خِلالِه",14,"ل",2,0],["قَد دَعاكُم ذَنبَ الهَي","ئَةِ داعٍ فَأَصابا",15,"ب",2,0],["قَد دَأَبَ العاذِلُ اللَجوجُ فَلَم","أُصغِ لِفَرطِ الإِكثارِ مِن دَأَبِه",16,"ب",2,0],["قَد دَعَوناهُ نائِياً فَوَجَدنا","هُ عَلى نَأيِهِ قَريباً سَميعا",17,"ع",2,1],["قد دُفِعْنا إلى حياةٍ وموْتٍ","ونشورٍ إلى الإلهِ العَليِّ",18,"ي",1,0],["قددتُ بها الدرعَ فوق الكميّ","كما شُقّ مَتْنُ غديرٍ غلَل",19,"ل",1,0],["قَد دَنَت حَلقَتا خِناقي فَراخى","بِأَياديهِ عَقدَ ذاكَ الخِناقِ",20,"ق",1,0],["قَد دَعاني وَقَد دَعاهُنَّ لِلَّه","وِ شُجونٌ مِن أَعجَبِ الأَشجانِ",21,"ن",1,0],["قَد دَعَوناهُ إِلى الكَأسِ حَتّى","هَشَّ لِلساقي وَمَدَّ البَنانا",22,"ن",2,0],["قَد دَبَّتِ الخَمرُ سِرّاً في مَفاصِلِهِ","فَماتَ سُكراً وَلَكِن حاطَهُ الأَجَلُ",23,"ل",1,0],["قد داومَ الإطراقَ حتى لهُ","يحسب عيّاً وهو المفلقُ",24,"ق",1,0],["قد دعوت الشعب للعل","مِ إلى أن بح صوتي",25,"ي",1,1],["قد دَرِمَتْ من كِبَرِ أُخْتُها","وعُمّرَتْ عَصْراً فلم تَدْرَم",26,"م",1,0],["قد دقَّ ناقوسُ الجهاد، فأنْصِتِي","ودعا الحمى أبطالَه، فتقدَّمي",27,"م",2,0],["قَد دَعاني مُتَيماً وَكَئيب","مَدداً يا أَنيس كُل غَريب",28,"ب",1,0],["قد دنستها عصبة لاعمها","عم ولا الخال المنكر خال",29,"ل",1,0],["قد دُحِرنا وفرَّ صَحبي وزالَ","الحُلمُ عني وهُدَّتِ الأركانُ",30,"ن",1,0],["قَد دَنا الصُبحُ أَو بَدا","وَهيَ لَم يُقضَ لُبسُها",31,"س",3,0],["قَد دانَتِ الدُنيا لِحُكمِكَ هَيبَةً","فَحَكَمتَ في أَقطارِها مُتَرَبِّعا",32,"ع",2,0],["قَد دانَتِ الدُنيا لِعِزَّتِكَ الَّتي","مَنَعَت نُفوساً أَن تَعِزَّ فَتَعزُفا",33,"ف",2,0],["قَد دَقَّ عَن فِكرِ الوَرى وَتَحَيَّرَت","فيكَ العُقولُ وَكَلَّ كُلُّ لِسانِ",34,"ن",1,0],["قَد دَعا قومهُ لتسليمهِ لل","قتلِ بَغياً فخابَ هذا الدعاءُ",35,"ا",2,0],["قَد دَعا الناسَ بِالكتابِ وبعضُ ال","حقّ يَخفى إن ضلّت الآراءُ",35,"ا",2,0],["قَد دَعا اللَّه قالباً لرداهُ","جلّ مَن قَد حواهُ هذا الرداءُ",35,"ا",2,0],["قَد دَعاهُم حَتّى تَغَلَّلَ لَأياً","صَوتُهُ مِن رُؤوسِهِم في النِقابِ",36,"ب",1,0],["قددتُ اليراعةَ من أَنملي","وكان المدادُ سوادَ البصر",37,"ر",1,0],["قد دعتني مصرٌ فطار صوابي","وتناسيت ملهمى وإمامي",38,"م",2,0],["قد دعانا إلى الصِبَا الناقوسُ","حين حنَّتْ إلى الصَبُوحِ النفُوسُ",39,"س",1,1],["قَد دَخلَنا حَمّامَكُم فَرَأَينا","عَجَباً مِن تَجَمُّعِ الضِدَّينِ",40,"ن",1,1],["قد در ضرعي على ما","ترى فلله دري",41,"ي",1,0],["قد دبرت اجزاءها ولتركها","التدبير عندك غاية التدبير",42,"ر",1,0],["قد دب صدغك في أثناء ديباج","وعاج كالنمل في أرضٍ من العاج",43,"ج",1,1],["قَد دَعاها جُنحُ لَيلٍ","حينَ قَضَّت لوكورِ",44,"ر",1,0],["قد دق عقلي به حقّاً فأرقني","حتى رأيت غموض المتن في الشرح",45,"ح",1,0],["قَد دَبَّت الطَلقاءُ نَحو ضِرارِهِ","تَقتادُها الأَذخالُ وَالأَحقادُ",46,"د",1,0],["قد دونوا التهذيب والتأديبا","وللأخير تركوا نصيبا",47,"ب",2,0],["قد دق عن فكري ما دققوا","فقلت دع ما دق عن فكركا",48,"ك",2,0],["قد دهى من وجيفها والذميلِ","أصْبَحتْ بعدَ ريّها تتولّى",49,"ل",2,0],["قد دَهاهم من المنيّة أمرُ","وتمطّى بساعدِ الغَدْرِ دهرُ",49,"ر",1,0],["قد دنتِ الشمسُ منك مسرعةً","فسِرْ الى الظّلِّ غيرَ متّئِدِ",50,"د",1,0],["قد دعتهم إلى المُدَام نفوسٌ","أسلمتهم لكلِّ ساقٍ ميود",51,"د",1,0],["قد دَرت الدنيا على جهلاتها","أنك خيرُ من حوت أقطارُها",52,"ر",3,0],["قد دك طوري لما خر موسى","صعقا ولا موسى وكان سرابا",53,"ب",2,0],["قد دقت من صرر","والكأس والسحر",54,"ر",1,0],["قد دبجت بقطائف من سندس","مثل الرياض ممايله كبلابله",55,"ل",2,0],["قد دَقَّ عن نسجِ الخَيالِ وفوقَ ما","في النَّارِ حرًّا ما تُكِنُّ ضُلُوعُهُ",56,"ع",2,0],["قَد دَنَا الفَصلُ في الصَّبَاحِ ولِلسِّل","مِ رِجَالٌ وَلِلحُرُوبِ رِجَالُ",57,"ل",1,1],["قَدْ دَلَّ نَظْمُكَ للدُّرِّ الثّمينِ بِلا","شَكٍّ بأَنَّكَ بَحْرٌ للعُلُومِ طَمَا",58,"م",2,0],["قد دعاك ابنُه بغَيرِ لسان","فاجعَلَن تُرجُمانُه الأَقلاما",59,"م",2,0],["قد دَرّت الدّنيا لهمْ مرّةً","وأيُّ درٍّ ليس بالحَلْبِ",60,"ب",1,0],["قد دَهَى سِحرُها المُحِبينَ حتى","عِيلَ صبرٌ وقيلَ هل من راقِ",61,"ق",1,0],["قد دخلوا في جملة الرعية","لشدة المحنه والرزية",62,"ه",1,0],["قد دَهَاهُ من فقدِها ما غَدا منه","قليلَ البهَا قليلَ الضِّياءِ",63,"ا",2,0],["قَدْ دَعَتْه إِلى النَّوالِ دواعٍ","وعَدَتْه عَنْ ضِدِّ ذاك العَوادِي",64,"ي",1,0],["قَدْ دبَّ مُخْضَرُّ العِذارِ بِخَدِّهِ","إِنِّي لَيُعْجِبُنِي القضيبُ المورِقُ",65,"ق",1,0]]}