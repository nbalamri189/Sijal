=155316",""],[5444,"غَزَّةٌ ... وَصَمْتُ المنَارة","https://www.poetsgate.com/ViewPoem.aspx?id=205078",""],[5493,". شرُّ البلية .","https://www.poetsgate.com/ViewPoem.aspx?id=197092",""],[5533,"قَدْ أَتَيْتُ أَعْتَذرُ","https://www.poetsgate.com/ViewPoem.aspx?id=176647",""],[5550,"يا كثيرَ الصُّدُود","https://www.poetsgate.com/ViewPoem.aspx?id=211543",""],[5561,"الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=193314",""],[5574,"جرحُ الشام!","https://www.poetsgate.com/ViewPoem.aspx?id=206023",""],[5626,"فُكّي القيود","https://www.poetsgate.com/ViewPoem.aspx?id=189513",""],[5689,"حي بدرا بافق مسرتا، تلالا","https://www.poetsgate.com/ViewPoem.aspx?id=143437",""],[5690,"نادى البشير وصبح الخير قد سفرا","https://www.poetsgate.com/ViewPoem.aspx?id=172159",""],[5725,"عشرون مرّت","https://www.poetsgate.com/ViewPoem.aspx?id=195080",""],[5725,"يا غصنك المياد","https://www.poetsgate.com/ViewPoem.aspx?id=205269",""],[5736,"عيد وأرق","https://www.poetsgate.com/ViewPoem.aspx?id=208886",""],[4623,"على من باح بالحب ملام (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146605",""],[5941,"الملكوت","https://www.poetsgate.com/ViewPoem.aspx?id=188907",""],[5956,"بصخرِ العز","https://www.poetsgate.com/ViewPoem.aspx?id=192333",""],[5956,"نوعٌ جديد","https://www.poetsgate.com/ViewPoem.aspx?id=192427",""],[5957,"ما زلت أذكر لوعتي وعذابي","https://www.poetsgate.com/ViewPoem.aspx?id=30136",""],[6004,"جَنَّةٌ للنِّسَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=59595",""],[6070,"القاضي والذئب","https://www.poetsgate.com/ViewPoem.aspx?id=188079",""],[2638,"ممرضتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87859&r=&rc=16",""]],"verses":[["قَد دَعاني الهَوى فَلَبَّيتُ أَلفاً","إِذ دَعاني إِلَيكُمُ يا ظَلومُ",0,"م",1,0],["قَد دُهيتُم في دورِكُم وَدُهينا","في نُفوسٍ أَبَينَ إِلّا اِحتِسابا",1,"ب",2,0],["قد دعاها العشاق عيداً ولكن","حرفت اسمها وقالت إيدا",2,"د",2,0],["قد دبَرت منهم لهم كيدها","حتى غدت منهم بهم واتره",3,"ر",2,0],["قد دعتكم أوطانكم فأجيبوا","دعوة الآمرين بالتجنيد",4,"د",1,0],["قَدَدنَ البَقيعَةَ قَدَّ الأَدي","مِ وَالغَربُ في شَبَهِ الأَشقَرِ",5,"ر",1,0],["قَد دَنا الفِصحُ فَالوَلائِدُ يَنظِم","نَ قُعوداً أَكِلَّةَ المَرجانِ",6,"ن",1,0],["قَد دَنا الفِصحُ فَالوَلائِدُ يَنظِم","نَ سِراعاً أَكِلَّةَ المَرجانِ",7,"ن",1,0],["قد دبرت مصر والأمصار فكرته","يوميْ نزالٍ بقطريها وإنزال",8,"ل",1,0],["قد دعتْكَ النفسُ من غمْرتها","فتداركْها فلم تدعُ وثن",9,"ن",1,0],["قَد دَخَلتُ الدَيرَ عِندَ الفَجرِ كَالفَجرِ الطَروبِ","وَتَرَكتُ الدَيرَ عِندَ اللَيلِ كَاللَيلِ الغَضوب",10,"ب",1,0],["قَد دَخَلتُ الدَيرَ أَستَنطِقُ فيهِ الناسِكينا","فَإِذا القَومُ مِنَ الحَيرَةِ مِثلي باهِتونا",10,"ن",2,0],["قَدْ دعاني الصَّباحْ","ورَبيعُ الحَيَاهْ",11,"ه",1,0],["قد دعاك العلا فسرت اليه","ودعوت العلا فكان مجيبا",12,"ب",2,0],["قد دعونا لنخلّى ديننا","ولنستهزى بأرباب لنا",13,"ن",2,0],["قَد دَهاهُ مِن فَقدِهِ ما دَهاكُم","وَبَكى ما بَكَيتُمُ مِن خِلالِه",14,"ل",2,0],["قَد دَعاكُم ذَنبَ الهَي","ئَةِ داعٍ فَأَصابا",15,"ب",2,0],["قَد دَأَبَ العاذِلُ اللَجوجُ فَلَم","أُصغِ لِفَرطِ الإِكثارِ مِن دَأَبِه",16,"ب",2,0],["قَد دَعَوناهُ نائِياً فَوَجَدنا","هُ عَلى نَأيِهِ قَريباً سَميعا",17,"ع",2,1],["قد دُفِعْنا إلى حياةٍ وموْتٍ","ونشورٍ إلى الإلهِ العَليِّ",18,"ي",1,0],["قددتُ بها الدرعَ فوق الكميّ","كما شُقّ مَتْنُ غديرٍ غلَل",19,"ل",1,0],["قَد دَنَت حَلقَتا خِناقي فَراخى","بِأَياديهِ عَقدَ ذاكَ الخِناقِ",20,"ق",1,0],["قَد دَعاني وَقَد دَعاهُنَّ لِلَّه","وِ شُجونٌ مِن أَعجَبِ الأَشجانِ",21,"ن",1,0],["قَد دَعَوناهُ إِلى الكَأسِ حَتّى","هَشَّ لِلساقي وَمَدَّ البَنانا",22,"ن",2,0],["قَد دَبَّتِ الخَمرُ سِرّاً في مَفاصِلِهِ","فَماتَ سُكراً وَلَكِن حاطَهُ الأَجَلُ",23,"ل",1,0],["قد داومَ الإطراقَ حتى لهُ","يحسب عيّاً وهو المفلقُ",24,"ق",1,0],["قد دعوت الشعب للعل","مِ إلى أن بح صوتي",25,"ي",1,1],["قد دَرِمَتْ من كِبَرِ أُخْتُها","وعُمّرَتْ عَصْراً فلم تَدْرَم",26,"م",1,0],["قد دقَّ ناقوسُ الجهاد، فأنْصِتِي","ودعا الحمى أبطالَه، فتقدَّمي",27,"م",2,0],["قَد دَعاني مُتَيماً وَكَئيب","مَدداً يا أَنيس كُل غَريب",28,"ب",1,0],["قد دنستها عصبة لاعمها","عم ولا الخال المنكر خال",29,"ل",1,0],["قد دُحِرنا وفرَّ صَحبي وزالَ","الحُلمُ عني وهُدَّتِ الأركانُ",30,"ن",1,0],["قَد دَنا الصُبحُ أَو بَدا","وَهيَ لَم يُقضَ لُبسُها",31,"س",3,0],["قَد دانَتِ الدُنيا لِحُكمِكَ هَيبَةً","فَحَكَمتَ في أَقطارِها مُتَرَبِّعا",32,"ع",2,0],["قَد دانَتِ الدُنيا لِعِزَّتِكَ الَّتي","مَنَعَت نُفوساً أَن تَعِزَّ فَتَعزُفا",33,"ف",2,0],["قَد دَقَّ عَن فِكرِ الوَرى وَتَحَيَّرَت","فيكَ العُقولُ وَكَلَّ كُلُّ لِسانِ",34,"ن",1,0],["قَد دَعا قومهُ لتسليمهِ لل","قتلِ بَغياً فخابَ هذا الدعاءُ",35,"ا",2,0],["قَد دَعا الناسَ بِالكتابِ وبعضُ ال","حقّ يَخفى إن ضلّت الآراءُ",35,"ا",2,0],["قَد دَعا اللَّه قالباً لرداهُ","جلّ مَن قَد حواهُ هذا الرداءُ",35,"ا",2,0],["قَد دَعاهُم حَتّى تَغَلَّلَ لَأياً","صَوتُهُ مِن رُؤوسِهِم في النِقابِ",36,"ب",1,0],["قددتُ اليراعةَ من أَنملي","وكان المدادُ سوادَ البصر",37,"ر",1,0],["قد دعتني مصرٌ فطار صوابي","وتناسيت ملهمى وإمامي",38,"م",2,0],["قد دعانا إلى الصِبَا الناقوسُ","حين حنَّتْ إلى الصَبُوحِ النفُوسُ",39,"س",1,1],["قَد دَخلَنا حَمّامَكُم فَرَأَينا","عَجَباً مِن تَجَمُّعِ الضِدَّينِ",40,"ن",1,1],["قد در ضرعي على ما","ترى فلله دري",41,"ر",2,0],["قد دبرت اجزاءها ولتركها","التدبير عندك غاية التدبير",42,"ر",1,0],["قد دب صدغك في أثناء ديباج","وعاج كالنمل في أرضٍ من العاج",43,"ج",1,1],["قَد دَعاها جُنحُ لَيلٍ","حينَ قَضَّت لوكورِ",44,"ر",1,0],["قد دق عقلي به حقّاً فأرقني","حتى رأيت غموض المتن في الشرح",45,"ح",1,0],["قَد دَبَّت الطَلقاءُ نَحو ضِرارِهِ","تَقتادُها الأَذخالُ وَالأَحقادُ",46,"د",1,0],["قد دونوا التهذيب والتأديبا","وللأخير تركوا نصيبا",47,"ب",2,0],["قد دق عن فكري ما دققوا","فقلت دع ما دق عن فكركا",48,"ك",2,0],["قد دهى من وجيفها والذميلِ","أصْبَحتْ بعدَ ريّها تتولّى",49,"ل",2,0],["قد دَهاهم من المنيّة أمرُ","وتمطّى بساعدِ الغَدْرِ دهرُ",49,"ر",1,0],["قد دنتِ الشمسُ منك مسرعةً","فسِرْ الى الظّلِّ غيرَ متّئِدِ",50,"د",1,0],["قد دعتهم إلى المُدَام نفوسٌ","أسلمتهم لكلِّ ساقٍ ميود",51,"د",1,0],["قد دَرت الدنيا على جهلاتها","أنك خيرُ من حوت أقطارُها",52,"ر",3,0],["قد دك طوري لما خر موسى","صعقا ولا موسى وكان سرابا",53,"ب",2,0],["قد دقت من صرر","والكأس والسحر",54,"ر",1,0],["قد دبجت بقطائف من سندس","مثل الرياض ممايله كبلابله",55,"ل",2,0],["قد دَقَّ عن نسجِ الخَيالِ وفوقَ ما","في النَّارِ حرًّا ما تُكِنُّ ضُلُوعُهُ",56,"ع",2,0],["قَد دَنَا الفَصلُ في الصَّبَاحِ ولِلسِّل","مِ رِجَالٌ وَلِلحُرُوبِ رِجَالُ",57,"ل",1,1],["قَدْ دَلَّ نَظْمُكَ للدُّرِّ الثّمينِ بِلا","شَكٍّ بأَنَّكَ بَحْرٌ للعُلُومِ طَمَا",58,"م",2,0],["قد دعاك ابنُه بغَيرِ لسان","فاجعَلَن تُرجُمانُه الأَقلاما",59,"م",2,0],["قد دَرّت الدّنيا لهمْ مرّةً","وأيُّ درٍّ ليس بالحَلْبِ",60,"ب",1,0],["قد دَهَى سِحرُها المُحِبينَ حتى","عِيلَ صبرٌ وقيلَ هل من راقِ",61,"ق",1,0],["قد دخلوا في جملة الرعية","لشدة المحنه والرزية",62,"ه",1,0],["قد دَهَاهُ من فقدِها ما غَدا منه","قليلَ البهَا قليلَ الضِّياءِ",63,"ا",2,0],["قَدْ دَعَتْه إِلى النَّوالِ دواعٍ","وعَدَتْه عَنْ ضِدِّ ذاك العَوادِي",64,"د",2,0],["قَدْ دبَّ مُخْضَرُّ العِذارِ بِخَدِّهِ","إِنِّي لَيُعْجِبُنِي القضيبُ المورِقُ",65,"ق",1,0],["قد دجا في صدورهم ليل غيٍ","فيه يَهوى نجم القنا أَن يغورا",66,"ر",2,0],["قَد دَلَّ أَنك لا تُبقي عَلى أحدٍ","مِن الإِخلاء وَالأَحباب وَالبدل",67,"ل",1,0],["قد دعاه الحمى به مستجيرا","من قتال العدى فلبى مجيرا",68,"ر",2,1],["قَد دَعاهُ رَبُّ الجِنانِ إِلَيها","فَأَجاب النِّدا بِدونِ تَواني",69,"ن",2,0],["قَد دَهاهُ مِنَ الخطوبِ مُلِمٌّ","بِكَ يَرجو لَه سريع اِندِفاعِ",70,"ع",1,0],["قَد دَعاهُ إِلَههُ لِلقاهُ","وَجِنان بِها الهَنا وَالرضاءُ",71,"ا",2,0],["قَد دَهَتني الآنَ أَدهى شدّة","لَكَ مِنها إِذ دَهَتني أَلجأُ",72,"ج",2,0],["قَد داسَ في قَدمٍ ثريّا المَجدِ في","شَرفِ العُلى وَبِشَمسِهِ يَتَوسَّدُ",73,"د",1,0],["قَد دَعاهُ رضوانُ نحوَ جِنانٍ","فَتَولَّى لِرَحمَةِ الغفّارِ",74,"ر",1,0],["قَدْ دَهَتْنِي الآنَ دَاهِيةٌ","وَسْمُهَا بَاقٍ عَلَى الأَبَدِ",75,"د",1,0],["قد دعونا الإله سراً وجهراً","بتلاق وعطفة واتصال",76,"ل",1,0],["قد دعاها إلى هداه بآي","قد هدى اللّه من هدى بهداها",77,"ا",3,0],["قد دخل الناس فما لي أنا","أخرج من ذا الطهر براني",78,"ن",2,0],["قَد دبّر الملك الأستاذ هيبته","بتدبيرِ مَن في الأحامي أَرسل النظرا",79,"ر",2,0],["قَد دافَعوا بِالسَيفِ أَبرَهَةَ