te.com/ViewPoem.aspx?id=175507",""],[4755,"مُجتَمَعُ العَناكِب","https://www.poetsgate.com/ViewPoem.aspx?id=205179",""],[463,"حمامَ اللوى رفقاً به فهو لبهُ","https://www.poetsgate.com/ViewPoem.aspx?id=14527",""],[4578,"شمس إليها أخطرت بالحلى والحلل","https://www.poetsgate.com/ViewPoem.aspx?id=49510",""],[5150,"ذكرى دائمة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203768",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"سؤال فهل مفت من القوم ينظم","https://www.poetsgate.com/ViewPoem.aspx?id=128819",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5397,"زها زمنا روض الشبيبة مونقا","https://www.poetsgate.com/ViewPoem.aspx?id=157957",""],[5411,"الشَّوْكَ المُذرّى","https://www.poetsgate.com/ViewPoem.aspx?id=186955",""],[709,"هذَا الْحِمى فَانْزِلْ عَلَى جَرْعائِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=2903",""],[482,"حرامٌ على الجفنِ القريحِ منامُه","https://www.poetsgate.com/ViewPoem.aspx?id=111412",""],[5720,"رحلتي في عسير","https://www.poetsgate.com/ViewPoem.aspx?id=198936",""],[5894,"مليكة حسن قد أتتنا بصارم","https://www.poetsgate.com/ViewPoem.aspx?id=131433",""],[5956,"أقصوصة شغالتين ظالمتين لإنسانية سيدهما الألماني العجوز:","https://www.poetsgate.com/ViewPoem.aspx?id=207868",""],[5997,"أعوذُ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=214253",""],[6003,"رثاء","https://www.poetsgate.com/ViewPoem.aspx?id=201019",""],[6066,"اللج العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=36766",""],[566,"بكيت والمحتزن البكي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=507632",""],[6164,"الثمانون؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66038&r=&rc=48",""],[2220,"إذا جاءتِ الأسماء يقدمُها الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11859&r=&rc=728",""],[6313,"صباح الهم يا بلدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83381&r=&rc=0",""]],"verses":[["مِنَ الحُجرَةِ القُصوى وَراءَ رِحالِها","إِذا الأُسدُ بِالأَكوارِ طافَ رَزومُها",0,"م",3,0],["مَنِ الحَربُ رَبَّتهُ فَلَيسَ بِسائِمٍ","إِذا مَلَّ عَنها ذاتَ يَومٍ ضَجورُها",1,"ر",3,0],["مِنَ الحَرورِ وَاِحزَأَلَّ الحَزوَرُ","في الآلِ يَخفَى مَرَّةً وَيَظهَرُ",2,"ر",1,0],["مِنَ الحُقبِ لاحَتهُ بَرهبَا مُرِبَّةٌ","تَهُزُّ السَفا وَالمُرتِجاتُ الرَوامِحُ",3,"ح",1,0],["مِنَ الحامِلاتِ الحَمدِ لَمّا تَكَشَّفَت","ذَلاذِلُها وَاِستَوأَرَت لِلمُناشِدِ",4,"د",1,0],["مِنَ الحينِ سُقتَ الخورَ خورَ مُجاشِعٍ","إِلى حَربِ قَيسٍ وَهيَ حامٍ سَعيرُها",5,"ر",3,0],["من الحيف تخسيسُ النوال ومطْلُه","فعجِّل خسيساً أو فأجّل موفَّرا",6,"ر",2,1],["مِنَ الحُزْنِ المُذِيبْ","إبكِ يا قَلْبُ وَحِيدْ",7,"د",1,0],["مِنَ الحِلمِ أَن تَستَعمِلَ الجَهلَ دونَهُ","إِذا اِتَّسَعَت في الحِلمِ طُرقُ المَظالِمِ",8,"م",1,0],["من الحزمِ أن لا يَضْجَرَ المرءُ بالذي","يُعانيهِ من مكروههِ وكأن قَدِ",9,"د",1,0],["مِنَ الحِلمِ عِندَ اِنتِقاصِ الحُلو","مِ وَالحَزمِ عِندَ اِنتِقاضِ المِرَر",10,"ر",1,0],["مِنَ الحامِلاتِ الحَمدَ لَمّا تَكَشَّفَت","ذَلاذِلُها وَاِستَأوَرَت لِلمُناشِدِ",11,"د",1,1],["مِن آلِ حَربٍ وَفي الأَعياصِ مَنزِلُهُم","هُم وَرَّثوكَ بِناءً عالِيَ السورِ",12,"ر",1,0],["مِنَ الحارِثِ المُنجي عِياضَ اِبنَ دَيهَثٍ","فَرَدَّ أَبو لَيلى لَهُ وَهوَ أَظلَمُ",13,"م",1,0],["مِنَ الحَمدِ وَالتَسبيحِ لِلَّهِ ما جَرَت","إِلى الغَورِ أَدراجَ النُجومِ التَوائِمِ",14,"م",1,0],["مِنَ الحَزمِ أن تَلقَى الهَوى وهو مُقبِلُ","وكيفَ تَرى عدلَ الزمانِ فَتعدِلُ",15,"ل",1,1],["من ألحفَ الدنْيا جنَاحَيْ عدْلِهِ","وأجارَ من صرْفِ الخطوبِ المعضلِ",16,"ل",1,0],["مِنَ الحورِ مِخماصٌ كَأَنَّ وِشاحَها","بِعُسلوجِ غابٍ بَينَ غيلٍ وَجَدوَلِ",17,"ل",1,0],["مِن آلِ حَمدينَ الأُلى حَلِيَت بِهِم","قِدماً صُدورُ كَتائِبٍ وَمَدارِسِ",18,"س",1,0],["مِنَ الحُصِّ هُزروفٌ يَطيرُ عِفائُهُ","إِذا اِستَدرَجَ الفَيفا وَمَدَّ المَغابِنا",19,"ن",2,0],["مِنَ الحُورِ لَو تَبدُو لِأَشمَطَ راهِبٍ","تَعَبَّدَ مِمّا أَحرَزَتهُ الصَوامِعُ",20,"ع",1,0],["من الحقولِ الخوارِ","لما قبلتَ اعتذاري",21,"ر",2,0],["مِنَ الحَيِّ قَيسٍ قَيسِ عَيلانَ إِنَّهُم","عُيونُ النَدى مِنهُم تُرَوّى سَحائِبُه",22,"ب",2,0],["مِنَ الحوتِ الَّذي في لُجِّ بَحرٍ","يُجيدُ السَبحَ في اللُجَجِ القِماصِ",23,"ص",1,0],["من الحياة ومن ضو","ضاء الحياة بعيدا",24,"د",2,0],["مِنَ الحُورِ دَانَ فُؤادِي بِهَا","وَوَحَّدَهَا الحُبُّ فِي مَذْهَبِي",25,"ب",2,0],["من الحقل جئت نبيا إليه","وما جئت من (هاشم) أو (هشام)",26,"م",1,0],["مِنَ الْحُصِّ هَزْرُوفٌ كَأَنَّ عِفَاءَهُ","إذَا اسْتَدْرَجَ الْفَيْفَاء مَدَّ الْمَغَابِنَا",27,"ن",2,0],["من الحِلمِ عندَ انتِقَاضِ الحُلُومِ،","والحَزْمِ عندَ انتِقَاضِ المِرَرْ",28,"ر",1,0],["من الحارِثِ المُنجي عياض بن دَيهَثٍ،","فَرَدّ أبُو لَيْلى لَهُ، وَهوَ أظْلَمُ",29,"م",1,0],["من الحُليّ الجمّة ِ الصَّلاصل","والسَّلَبِ الرائع لاالمباذل",30,"ل",1,0],["من الحفراتِ البيضش أخلصَ لونها","تلاحي عدوّاً لم يجدْ ما يعيبها",31,"ب",3,1],["من الحسر أن تبقى على الجهل أمة","وليس عليها مرشد ورشيد",32,"د",1,0],["من الحقد الا عدت عنها كما هيا","وداريتُ حتى قيلَ لي مُتعلق",33,"ق",1,0],["من الحقّ أن يُحبَى بها مستحقُّها","ويُنزَعَها مردودةً مستعيرُها",34,"ر",3,0],["مِنَ الحُبِّ وَالتَشريفِ في الرُتبَةِ العُليا","أَما وَالَّذي أَعلى عَلى الخَلقِ رُسلَهُ",35,"ه",1,0],["مِنَ الحارثيِّينَ الألى في أَكُفِّهِم","بِحارُ النَدى مَسجورَة لا ثغابُها",36,"ب",3,0],["من آلِ حميرَ لا عُزْلٌ ولا كُشُفٌ","إذا عَدَتْ بهم الجردُ المحاضيرُ",37,"ر",1,0],["من آل حام كلما سمته","وصلا علا في الحب قدرا وسام",38,"م",1,0],["مِنَ الحَضَر","مِلءَ الخَيال",39,"ل",1,0],["مِنَ الحارِثِيينَ الَّذينَ دِماؤُهُم","حَرامٌ وَأَمّا مالُهُم فَحَلالُ",40,"ل",1,0],["من الحبر وَالنيابَتين تَراسَلَت","الى مقصد من دونه الهول يَركب",41,"ب",1,0],["مِنَ الْحالِياتِ الْعالِياتِ مَناصِباً","تُماثِلُ مِنْ قَبْلِي وَتَفْضُلُ مَنْ بَعْدِي",42,"د",2,0],["مِنَ الْحَقِّ ما يَقْضِي عَلَيْكَ بِأَنْ أُرى","لَدَيْكَ وَحَظِّي مِنْ نَوالِكَ أَوْفَرُ",43,"ر",1,0],["من الحور والولدان زوج وخادم","ومن ذهب والورق قصر لمنزل",44,"ل",1,0],["مِنَ الحضرمي قَد فازَ وهو مِن","وريثهِ يحيى القادريّ بلا ذكرِ",45,"ر",1,0],["مِن آلِ حَمدانَ الَّذينَ في الهَوى","بِصِدقِهِم يُضرَبُ في الناسِ المَثَل",46,"ل",1,0],["منَ الحَديد مَتى نار الوَغى اِضطَرَمَت","كادَت تَذوب عَلى الأَجساد مِن رَهبِ",47,"ب",1,0],["مِنَ الحَيِّ أَوجُهُهُم في الدُجى","تُنيرُ فَما لَيلُهُم أَليَلُ",48,"ل",1,0],["مِن آلِ حَيدَرةِ الذي","نَ تَعَوَّدوا بَذلَ النَّوالِ",49,"ل",1,0],["من الحرمين بعضهم وبعض","بصنعا خير أوطاني وداري",50,"ر",2,0],["من آل حيدرة الَّذينَ شعارهم","فيض النَدى الهامي وَضرب الهامِ",51,"م",1,0],["مِنَ الحِسابِ وَمن علم الغَريب مَعاً","وَالنَحوِ ما لَم يَكُن فيهِ بِمُكتَسِبِ",52,"ب",1,0],["مِنَ الحُورِ رضوانُه بُخْلُهُ","وَرِيقَتُهُ البارِدُ السَّلسَلُ",53,"ل",1,0],["من آل حوى حوىً من عهد صبوته","إلى الوفاة جمال البر والورع",54,"ع",1,0],["منَ الحِمْيَرَيِّينَ الَّذِينَ أَكُفُّهُمْ","سحائِبُ تَهْمِي بالنَّدى وبُحُورُ",55,"ر",1,0],["من الحلم أن لا تطرق الناس بالأذى","ومهما أذوك الناس فاصبر على الأذى",56,"ذ",2,1],["من الحبشيات اللواتي إذا انتمت","أسَّر لها سامٌ وأظهرَ حامُ",57,"م",1,0],["مَن الحاوي الذي انتزعتْ يداهُ","نيوبَ العزِّ من تلك اللَّهاةِ",58,"ه",1,0],["من الحلالِ العفوِ لم تُستَلَبْ","بغارةِ الشعرِ ولم تُنْهَبِ",59,"ب",1,0],["من الحيّ تشتقُّ العِرَضْنَةَ عِيسُهُ","إزاءك حتى أمتدّ كالسطر رَكبُهُ",60,"ب",2,0],["من الحور يحمي ناظريه بجفنه","ومن عجبٍ أن ينصر السيف بالجفن",61,"ن",1,0],["مِنَ الحَزمِ أَلا يَرُدَّ الفَتى","عِنانِ الشَبابِ عَنِ الخِندريسِ",62,"س",1,1],["مِنَ الحُداةِ ومِن شِعرى لها ولنا","حدْوٌ يُعلِّلُها وَهْناً وتشبيبُ",63,"ب",1,0],["من الحُسَيْنِ انتَقَى عقْدٌ يتيمَتُهُ","عَصْماءُ عاقبَةَ الزُّهرِ الشَّآبيبِ",64,"ب",1,0],["منَّ الحبيبُ رأْفَةً","وبالمُرَجَّى وهَبَا",65,"ب",2,0],["من الحلة الفحاء زاد لك البها","لذلك حلو انت طبعاً وطاهر",66,"ر",1,0],["من آل حيدرةَ الألى ورثوا العُلا","من هاشمٍ والضّربَ في هيجائهِ",67,"ا",3,0],["من آلِ حيدرَةَ الغطارفةِ الأُلى","فرضوا على الذِمَمِ النّوالَ وأوجَبوا",68,"ب",3,0],["من آلِ حيدرَةَ الأُلى اِزدانَ العُلا","فيهم كما اِزْدانَ الرّبيعُ بزَهرِهِ",69,"ر",2,0],["مِنَ الحَجازِ حاملاً لكَ العَدَ","مِن السَّلام والدعَاء للصَّمَد",70,"د",1,0],["مِن الحَفَراتِ لَم تَفضَح أَباها","وَلَم تَرفَع لِإِخَوتِها شَنارا",71,"ر",2,0],["مِنَ الحِقافِ هَمِرٍ يَهمورِ","فَباتَ في مُكتَنَسٍ مَعمورِ",72,"ر",1,0],["مِنَ الحَوامي الرُطبُ وَالذُوِيُّ","وَالهَدَبُ الناعِمُ وَالخَشِيُّ",73,"ي",1,0],["مِن آل حيدر أسرة العلم الألى","بهمُ اِهتدى كلّ اِمرئ متمدّنِ",74,"ن",1,0],["من آلِ حربٍ ومن زيادِ","وآل مروانَ ذي العَتادِ",75,"د",1,0],["مِن الحِكايات يَنالهُم طَرَب","وَقَد يفضلونها عَلى الخُطب",76,"ب",1,0],["من آل حراص وذيبان وأب","نَاء السياب وجمع عوف الصَّائلِ",77,"ل",1,0],["من الحارك مخشوشٌ","بجنب مجفر رحبِ",78,"ب",1,0],["من الحيين ثعلبة بن سعدٍ","ومرة أخذ جمعهم اعتباط",79,"ط",1,0],["مِنَ الحُلمِ ضَربٌ إِذا رُمتَهُ","لَقيتَ مِنَ الذُلِّ فيهِ ضُروبا",80,"ب",2,0],["مِنَ الحُورِ أَجفانُهُ","جفونُ سيوفِ الفِتَنْ",81,"ن",1,0],["مِن آلِ حَسَّانَ اللَّذِي","نَ هُمُ الذَّوَائِبُ والدّعَائِم",82,"م",1,0],["من الحسن أستملى البيان كروضةٍ","أزاهرُها تنمو بِتَسكابِ هطّالِ",83,"ل",1,0],["مِنَ الْحَيّ إذْ كَانُوا هُنَاكَ وَإِذْ تَرَى","لَكَ الْعَيْنُ فِيهِمْ مُسْتَرَاداً وَمَنْظَرا",84,"ر",2,0],["من الحضرميّين الأُولى أحْرَزوُا العلا","بَنَوا فأطالوا أو رَمْوا فأصابوا",85,"ب",3,0],["منَ الحَفِيَّ لِوِردِ الماجل اندفعتْ","تَؤُمُّ قَفصَةَ يَحْدوُهَا لَهَا طَرَبُ",86,"ب",1,0],["مِنَ الحَبِيِّ أَو قَطَر","ما دَقَّ مِن روسِ الإِبَر",87,"ر",1,0],["من الحي أما جدهم فهو أفخر","وأما هداهم فهو ما دله الذر",88,"ر",1,0],["من آل حمدان حيث الملك مقتبل","والمال مقتسم والحمد مغتنم",89,"م",1,0],["من الحروف حروفٌ هن كالعرض ال","مجهول تغييره في سمعنا ظهرا",90,"ر",2,1],["من الحياةِ آيسِ","في الغرفاتِ نافسِ",91,"س",1,0],["من الحجاب دنت انوارها فبدت","نور تنزل بين الماء والدمن",92,"ن",1,0],["مِنَ الحَيِّ إِذ هَرَّت مَعَدٌّ كَتيبَةً","مُظاهِرَةً نَسجَ الحَديدِ المُسَربَلِ",93,"ل",1,0],["من الحزن ابي لم ازل ورعا","وان لاحق اسي بالحظوظ كبا",94,"ب",2,0],["من الحق إن يصلى الكريم بحرها","ويأخذ منها صفوها القعدد الوغد",95,"د",1,0],["مِن آلِ حامٍ أَخي سامٍ وَيافثِهِ","بِحُسنِهِ استعبَدَ السامِينَ وَالخَزَرا",96,"ر",2,0],["مِنَ الحُمسِ إِذ جاؤوا إِلَينا بِجَمعِهِم","غَداةَ لَقيناهُم بِجَأواءَ فَيلَقِ",97,"ق",1,0],["من الحيوانِ لم أشكُ استياء","ولم أرَ في الضواري لي خصوما",98,"م",2,1],["من الحر صفراء فاعرفهما","ي