ate.com/ViewPoem.aspx?id=21888",""],[5431,"يكاد يُضيئ...","https://www.poetsgate.com/ViewPoem.aspx?id=214558",""],[5442,"هل نازح الدار بعد البين مقترب","https://www.poetsgate.com/ViewPoem.aspx?id=114788",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5587,"عمر الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=196762",""],[5616,"عامان","https://www.poetsgate.com/ViewPoem.aspx?id=205247",""],[5625,"نعمة العشق","https://www.poetsgate.com/ViewPoem.aspx?id=183007",""],[5672,"عيونٌ","https://www.poetsgate.com/ViewPoem.aspx?id=214549",""],[5739,"عش ٍ من القش","https://www.poetsgate.com/ViewPoem.aspx?id=126423",""],[5756,"الجريمة","https://www.poetsgate.com/ViewPoem.aspx?id=5418",""],[5771,"وجهٌ ثُلاثيُّ الأوجاع","https://www.poetsgate.com/ViewPoem.aspx?id=189540",""],[5908,"لي لا لغيري آلت نوبة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=170970",""],[5956,"لحن الحب","https://www.poetsgate.com/ViewPoem.aspx?id=186141",""],[5960,"بغدادُ أغلى انتماءاتي","https://www.poetsgate.com/ViewPoem.aspx?id=30808",""],[6142,"بكر الردى فاجتاح في نكبائه","https://www.poetsgate.com/ViewPoem.aspx?id=155755",""],[469,"ولو يملك الملك الأهلة عنده","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574823",""],[1583,"عيناكِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73061&r=&rc=18",""],[6237,"رمضان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77859&r=&rc=1",""]],"verses":[["وَلَو يَسوقُ جَميعُ الناسِ ما مَلَكوا","لِنَظرَةٍ مِن ظَلومِ الحُسنِ ما غُبِنوا",0,"ن",3,0],["وَلَوْ يَمَّمَتْ سَيْفَ بْنَ ذِي يَزَنٍ لَمَا","تَقَرَّرَ ذَاكَ الْغِمْدُ فِي غِمْدِ غُمْدَانِ",1,"ن",1,0],["وَلَو يَستَطيعُ المُسلِمونَ لَقَسَّموا","لَكَ الشَطرَ مِن أَعمارِهِم غَيرَ نُدَّمِ",2,"م",1,0],["وَلَو يُرزَقُ الناسُ مِن حيلَةٍ","لَما نِلتَ كَفّاً مِنَ التُربَه",3,"ب",2,0],["وَلَو يَشرَبُ الماءَ أَهلُ العَفافِ","لَما نِلتَ مِن مائِهِم شَربَه",3,"ب",2,0],["وَلَو يَعلَمُ السُلطانُ ما تَفعَلونَهُ","لَبانَت يَمينٌ مِنكُمُ وَيَمينُ",4,"ن",1,0],["وَلَو يَدعو الكِرامَ بَني حُباقٍ","لَلاقى دونَ ذِمَّتِهِم ذِيادا",5,"د",2,0],["وَلَو يَدعو بَني عَوذِ بنِ سودٍ","دَعا الوافينَ بِالذِمَمِ الجِعادا",5,"د",2,0],["وَلَو يَدعو المَعاوِلَ ما اِجتَوَوهُ","إِذا الداعي غَداةَ الرَوعِ نادى",5,"د",2,0],["وَلَو يَهوَينَ ذاكَ سَقَينَ عَذباً","عَلى العِلّاتِ آوِنَةً زُلالا",6,"ل",2,0],["وَلِوى قُرَيشٍ في المَشاهِدِ كُلِّها","وَبِنَجدَةٍ عِندَ القَنا الخَطّارِ",7,"ر",1,0],["ولو يسْطيعُ مكَّنه","مكان الروح من جسدِهْ",8,"د",2,0],["ولُوِّيَ عمرو لَيَّ لَبلابِ غيضةٍ","وطال فما يَفنى بذرع ولا حزر",9,"ر",1,0],["ولو يشاء كفاهُ أنَّهُ رَجُلٌ","من بين أكرم أخوالٍ وأعمامِ",10,"م",1,0],["ولو يَممتْ من مَقْطع التُّرب عُصبةٌ","ذَراك على علاتها ما تَعنَّتِ",11,"ت",1,0],["ولوى احتراسي من المنْسياتِ","كفاني الكتابَ اعتمادي عليكا",12,"ك",2,0],["وَلَو يُجَمَّعُ رِفدُ الناسِ كُلِّهِمِ","لَم يَرفِدِ الناسُ إِلّا دونَ ما رَفَدوا",13,"د",3,0],["وَلَو يَبُثُّ بَنو لُبنانَ لَوعَتَهُم","لَاِهتَزَّتِ الأَرضُ لَمّا اِهتَزَّ لِبنانُ",14,"ن",1,0],["ولو يردّ القضاءَ دمع","لحولت أدمعي القضاء",15,"ا",2,0],["وَلَو يَمَّمتُهُم في الحَشرِ تَجدو","لَأَعطَوكَ الَّذي صَلَّوا وَصاموا",16,"م",3,0],["وَلَو يُلاقيكَ صُبحاً مُصحِراً لَرَأى","صَريمَةً يَنثَني عَن مِثلِها الأَسَدُ",17,"د",1,0],["وَلَو يَبتَدي في بَضعِ عَشرَةَ لَيلَةً","مِنَ الشَهرِ ما شَكَّ اِمرُؤٌ أَنَّهُ البَدرُ",18,"ر",1,0],["وَلَوَّينَ البَنانَ غَداةَ بَينٍ","بِتَسليمٍ وَهُنَّ عَلى اِنطِلاقِ",19,"ق",1,0],["ولو يَطيبُ ولو عُلَّتْ شَرائِجُه","بالرَّاحِ خالطَها مِسْكٌ وكافورُ",20,"ر",1,0],["وَلَو يَنشَقُّ وَجهُ الأَرضِ عَنهُ","عَدَدتَ عِظامَهُ عَظماً فَعَظما",21,"م",2,0],["وَلَو يَمَسُّونَ مَحْمُومَاً أَبَلَّ بِهِمْ","والحُزْنُ جَمْرٌ إذا مَرُّوا بِهِ بَرَدَا",22,"د",2,0],["وَلَوْ يُقَالُ لَهُ سِرْ فَوْقَ جَمْرِ غَضَىً","مَشَى عَلَيْهِ بَسِيمَ الوَجْهِ مُتَّئِدَا",22,"د",2,0],["وَلَو يُقالُ اِقرِ حَدَّ السَيفِ شَرَّهُما","ما شامَ حَدَّيهِ حَتّى يَقتُلَ الخُلُفا",23,"ف",2,0],["ولو يذوقُ عاذلي ريقتَها","صبا معي لكنَّهُ ما ذاقَها",24,"ق",3,0],["ولو يبقى سَلَوْنا مَنْ سواهُ","فإنَّ بموته ماتَ الكرامُ",25,"م",1,0],["وَلَوى الخَليجُ هُناكَ صَفحَةَ مُعرِضٍ","لَثَمَت سَوالِفَها ثُغورُ أَقاحِ",26,"ح",1,0],["وَلَوى القَضيبُ هُناكَ جيداً أَتلَعاً","قَد قَبَّلَتهُ مَباسِمُ النُوّارِ",27,"ر",1,0],["وَلَوى العِنانَ عَنِ الإِطالَةِ أَنَّني","نِضوُ القُوى بِسُرى الفِراشِ ضَئيلُ",28,"ل",1,0],["ولوَى مُقبَّلَكِ اللّثامُ وما دَرَوا","أن قد لَثمْتُ به وقُبِّلَ فُوك",29,"ك",1,0],["ولو يعطى صقيلَ الحدّ","مثل الملح قِرضابا",30,"ب",2,0],["وَلَو يُبصِرُها العُمّا","رُ ما طابَت لَهُم عُمرَه",31,"ر",2,0],["وَلَو يَفدي مِنَ الحَدَثانِ شَيءٌ","فَدَيتُكَ بِالطَريفِ وَبِالتِلادِ",32,"د",1,0],["وَلَو يَترُكُني الحُبُّ","لَقَد صُمتُ وَصَلَّيتُ",33,"ت",1,0],["وَلَو يَشهَدُني ذو ثِ","قَتي بَعدُ لَأَوصَيتُ",33,"ت",1,0],["وَلَو يَسطيعُ إِذ شَطَّت","عَلى ما كانَ مِن عَتبِ",34,"ب",1,0],["ولو يَدَعْ رُيَّةَ والجزيرَهْ","حتى كوَى أَكلبَها الهريرَهْ",35,"ه",1,0],["ولو يعظم لنقصٍ كان فيه","ولم يزل الأمير ولن يزالا",36,"ل",2,0],["ولو يُرَدّ زمانُ المعجزاتِ بها","لانشقَّ بحرٌ لها وارتدَّ تيَّارُ",37,"ر",1,0],["وَلَو يُدفَنُ التَيمِيُّ ثُمَّ دَعَوتَهُ","إِلى فَضلِ زادٍ جاءَ يَسعى مِنَ القَبرِ",38,"ر",1,0],["وَلَوْ يَقْوَى لَسَارَ وَكَيْفَ يَقْوى","عَلَى هَوْلِ السُّرَى قَدَمُ الْكَسِيحِ",39,"ح",1,0],["وَلَوَى شَعْرَ حاجِبَيَّ عَلَى عَيْ","نَيَّ حَتَّى أَطَلَّ كَالْهُدَّابِ",40,"ب",1,0],["ولوى جيده فأومى إليه","قبس شعّ لحظة وتوارى",41,"ر",2,0],["وَلَو يَشاء لأَجراها عَلى يَبس","مِن غَير سفان أَحياناً وَلا سفن",42,"ن",1,0],["ولوى له هام البرية كلها","ولقد تولاه بكل أموره",43,"ر",2,0],["ولو يبايعني الخَطِّىُّ أنْفَسه","لم أعطِه شطرَ أُنبوبٍ بأنبوبِ",44,"ب",1,0],["ولوّينَ البنانَ فقلتُ زجرا","بمعيادي وآمالي لوَينا",45,"ن",2,0],["وَلَو يَكونونَ أَكفاءً بَرَزتَ لَهُم","بُرُوزَ جَدِّكَ لَمّا نَكَّسَ الصُلُبا",46,"ب",2,0],["وَلَو يَظفَرونَ لَعَمري بِها","لَكانَت لِتيجانِهِم كَالدُرَر",47,"ر",1,0],["ولو يلاقي الذي لاقيته حجراً","من الحجارة ولو تورى له لانا",48,"ن",2,0],["وَلَو يَكُونُ لِقَرنِ الشَمسِ غُرَّتُهُ","تاهَت فَلَم يَستَطِع شَيءٌ يُواريها",49,"ي",3,0],["ولو يستطيع السعي مضناكم سعى","ولو انه يسعى على الشوك والجمر",50,"ر",1,0],["ولو يرعوي ذكري لهُ ومدائِحِي","لما طفقت يمناه بالرّسفان",51,"ن",1,0],["ولو ئشت قابلت الفعال بمثله","ونال جزاء الفعل عات ومذنب",52,"ب",1,0],["وَلَو يُناظِرُهُ في الفِقهِ أَسعَدُ لَم","يَسعَد وَأَحصَرَهُ عَن نُطقِهِ الحَصَرُ",53,"ر",1,0],["وَلَو يُناظِرُهُ في الفِقهِ أَسعَدُ لَم","يُسعَد وَأَحصَرَهُ عَن ذِكرِهِ الحَصَرُ",54,"ر",1,0],["وَلَوْ يَحْيَا كُشَاجِمُ كان عَبْداً","ليحيى في مُصنّفهِ الفَوائِدْ",55,"د",1,0],["ولو يَسْمَحْنَ لي بصديقِ صدْقٍ","جعلْتُ لَهُنَّ من ذَمّي ذِماما",56,"م",2,0],["وَلَو يَحلو كَماء المزنِ خَلقٌ","لما شَرَقَ امرؤ فيهِ بِحالِ",57,"ل",1,0],["وَلَو يَحكي أَنامله سَحابٌ","لَكانَ الدَهرُ منهُ في رَبيعِ",58,"ع",1,0],["ولو يُفدى فديناهُ ولكنْ","أسيرُ الموت ليس له فداء",59,"ا",2,0],["ولو يصبر القرم الوزير عليهم","لقيل به عجز وما قيل عن صبر",60,"ر",1,0],["ولو يفدى فدته إذَن رجال","عوادٍ بالسيوف على الأعادي",61,"د",2,0],["ولَوَيْنَ أَجياداً يُحَلِّيها النَّوَى","بفرائِدٍ من فَيْضِ دَمْعٍ جارِي",62,"ر",2,0],["ولوى الى مصرٍ أخادِعُهُ","أرَجُ نماهُ ذلك الخَطُّ",63,"ط",1,0],["ولو يكون لنوح مثل سيبكم","لم ينفع الفلك بل أردي بطوفان",64,"ن",1,0],["ولو يباريه زاد الركب عن عرضٍ","في حلبةٍ لكبا منه على الركبِ",65,"ب",1,0],["ولَوْ يَتَعاطَى عاصِفُ الرِّيحِ شَأْوَها","لعاذَ بأَرْجَاءِ الفَلا من عُصُوفِها",66,"ف",3,0],["ولو يعطى لما قنعا","بدون الروح والنشب",67,"ب",1,0],["ولو يبغي الفدا عنها فدينا","بما نحوي ونحن من الفداة",68,"ه",1,0],["ولو يخطي الردى أَخطى هديلا","فأبكى حزنه فخت الحمام",69,"م",1,0],["ولو يقبل الموت الفدى من ذوي الفدى","لفدي أنوشروان بالملك والجند",70,"د",1,0],["ولو يهب أبو جهل لنجدتكم","ألا ترون أبا جهل هو السبب",71,"ب",1,0],["ولو يُشَقّ البحرُ ثمّ يلتقي","فِلقاه فوقي في هواك لم أُبَلْ",72,"ل",1,0],["ولويت وجهي عن مَصارع أُسرتي","حذرَ المنيّةِ والشفارُ تُحَدُّ لي",73,"ل",2,0],["ولو يستطيع البدر والجوُّ سافر","لمرَّ بذاك الأفق وهو ملثَّم",74,"م",1,0],["ولو يرى ما رأى الطاووس صاح لها","إذ ليس من وتد فيها ولا سبب",75,"ب",1,0],["ولو يعلم الإنسان ما يلتقي غدا","بدار البقا ما غدا للشر فاعل",76,"ل",1,0],["ولوى هامةً واقصر باعاً","مدَّ في الخائفين وهو طويل",77,"ل",1,0],["ولو يسطيع ما درجت دبورٌ","إذن ونهى الشمال عن الجنوب",78,"ب",1,0],["ولوى عنه كلّما عاقه التّرْ","بُ ولا ذاق في الزّمانِ أُواما",79,"م",2,0],["ولو يشاء ربها أطلقها","عن قيدها الوهميِّ بالأشياء",80,"ا",2,0],["ولو يُعطى من الأرزاقِ كلٌّ","على مِقدارِهِ انتَصَفَ الحكيمُ",81,"م",1,0],["وَلَوى الغَرامُ عِنانَهُ نَحوَ اللَوى","وَبَد الحَنينُ لا بَرقَ الحَنانِ",82,"ن",1,0],["وَلو يَمدُّ ما بلغتَ مَدَّهُ","ولو يشدُ ما لحِقتَ شّدهُ",83,"د",2,0],["ولو يموت ما كُفيتّ فقدهُ","ولو رُبيتَ لحُسبت عبدهُ",83,"د",2,0],["ولو يَرُوْمُ نِزالَ الطَّوْدِ يَبْلُغُهُ","أو يَنْزِلوا من صَياصيْه كما زَنَأُوا",84,"ا",1,0],["ولو يكفي الفتى أدب وعلم","لكنت بما تيسر لي اكتفيت",85,"ت",1,0],["ولو يبتغي إعجازهم عنه لم يكن","لهم في الثرى والماء طرق ومعبر",86,"ر",1,0],["ولو يتأسى كلُّ ذي غمرةٍ بما","تجشمته لم ألق في الناس شاكيا",87,"ي",2,0],["ولو يُجزَى بما صنعت يداه","لأصبح وهو في الوادي أمير",88,"ر",1,0],["ولو يغالون في خير أعَنْتَهُمُ","على التعجُّل فيه والمقالات",89,"ت",1,0],["ولو يسرتها الليالي له","تجنبها ثانياً واعتزل",90,"ل",1,0],["ولوى الطريق على مراميه فما","يجلوه غير الجحفل الجرار",91,"ر",1,0],["ولو يُمَسُّ بقلبٍ","أفناهُ المزورِينَ أُنْسا",92,"س",2,0],["وَلَو يَفدِي بِهِ عُثمانَ قَومٌ","لَكانَ لَهُم بِهِ الثَّمَنُ الرَّبيحُ",93,"ح",1,0],["ولو يدرى ما بي مِنْ جوًى وصبابةٍ","عدُوِّي لأضحى باكياً متنهدا",94,"د",2,0],["ولوْ يكنْ مِنْ أَشَرِّ الناسِ أَوْ كافرْ","أوصيكَ يا صاحْ لا تشْمتْ ولا تفرحْ",95,"ح",1,0],["ولو يدري ما وصْف الجِنان مُفَكرٌ","لسارع فيها لا عدمتُك مُوفضا",96,"ض",2,0],["ولو يدري أبو دُلَفَ","المكنَّي في بني عجل",97,"ل",1,0],["ولو يوماً تلقَّاه","مصادمةً أبو الشِّبْل",97,"ل",1,0],["ولو يُستخبرُ العلماءُ عَنَّا","وَمَن شَهِدَ الملاحِمَ والوَقاعا",98,"ع",2,0],["ولو يراني أبو غيلان إذ حُسرت","عني الهمومُ بأمرٍ مالهُ طبقُ",99,"ق",1,1],["وَلَو يَكونُ الطَّيفُ طَوعَ أَمرِهِ","لَم يَطمَعِ العاشِقُ في إِلمامِهِ",100,"م",2,0],["ولو يراني الثوى وحسبي","أنك مغناطيس اعتقادي",101,"د",2,0],["وَلَوَى الظِّلُّ عَلَى خَدّ النَّهَرْ","سَالِفاً مَرْقُومْ",102,"م",1,1],["وَلَوَى صُدْغَهُ المُزَرَّدَ كَيْمَا","يَفْتنَ القَلْبَ بِاللِّوَى وَزَرُودِ",103,"د",1,0],["وَلَوَى الآسُ سَالِفاً خَضِرَا","فَوْقَ صدْغِ النَّوَارْ",104,"ر",1,0],["وَلوى عليّ بمعصمٍ","ريّان لم يتلبّدِ",105,"د",1,0],["وَلَوْ يَبِيعَان الشَباب أَنْفَقا","وَالشَيْبُ لا سُوقَ لَهْ إِنْ سُوِّقا",106,"ق",2,0],["وَلَو يُفتَدى مَيتٌ بِشَيء فَدَيته","بِنَفسي وَمالي من طَريف وَمُتلَد",107,"د",1,0],["ولوى العنان عليهم","وسقاهم كاس المرارْ",108,"ر",1,0],["وَلَو يُعَمِّرُ نُوحٌ فيهمُ سَنَةً","لَقالَ يا رَبِّ هَذا غايَةُ العُمُرِ",109,"ر",1,0],["ولو يرى حاتم فيض كفه","في حلبات السبق للجود كبا",110,"ب",2,0],["وَلَو يَنكَهُ في صَلدٍ","صَفاً لا نَصدَعَ الصَّلدُ",111,"د",1,0],["ولوى ثلاثَ ذوائبٍ من شعره","تركت فؤادى بالصّبابة ذائِبا",112,"ب",2,0],["ولو ينالوا بما جاءوا به سفهاً","غلا نكالا وأبعاداً وحرمانا",113,"ن",2,0],["ولو يأمن الحارث الوائلين","لراعك في بعض من كان راعا",114,"ع",2,0],["وَلَويتَ فيهِ عَبّاسِ الدُجى","وَكَفَيتَ ناظِرَهُ عَنِ الأَضواءِ",115,"ا",2,0],["وَلَوى التَكَلُّحَ يَشتَكي سَغَباً","وَأَنا اِبنُ قاتِلِ شِدَّةِ السَغبِ",116,"ب",1,0],["ولو يستطيعون الرواح تروّحوا","معي ومضوا في المصبحين على ظهر",117,"ر",1,0],["ولو يرتقي المجد السماكين لارتقوا","إليه بأطراف المثقفة الملد",118,"د",1,0],["ولو يطيقان لسارا معاً","واحنيا الرأسين فوق ثراك",119,"ك",1,0],["ولوى للهدوء ذو الضوضاءِ","وإلى الكهف كل حيٍّ ادبر",120,"ر",1,0],["ولو يطيق لاك أُفعوانا","ولا يوافي لاخٍ خِوانا",121,"ن",2,0],["ولويتَ عنقك عن مباذله","كم قد أذلَّت سيد قرما",122,"م",2,0],["ولو ينخزن في الشّامخ انذاب","ذوب الحيد وشبّ لاضي",123,"ض",2,0],["ولو يكون له الإنسان في كبد","والنفس في تلف والحلق في شرق",124,"ق",1,0],["ولو يكون لصلبٍ كان عن جسد","في ناظر العينِ لم يدرك به غبنا",125,"ن",2,0],["ولو يعدُّ الذي يكون من حدث","في يومه ما انتهى في يومه عدده",126,"د",2,0],["ولو يعارضه ما كان معجزةً","فليس إعجازه يجري إلى أجَل",127,"ل",1,0],["ولو يبغي نظيرتها سواه","نسميه طفيلي الوليمه",128,"م",2,0],["ولو يرى منه ما رأيت صبا","وظل يدمي الاكف بالندم",129,"م",1,0],["وَلَو يُمطَرُ الناسُ الدَنانيرَ لَم يَكُن",