ام","https://www.aldiwan.net/poem29243.html","الوافر"],[74,"يا رب مائسة المعاطف تزدهي","https://www.aldiwan.net/poem12885.html","الكامل"],[74,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[74,"الليل إلا حيث كنت طويل","https://www.aldiwan.net/poem13223.html","الكامل"],[75,"فتكات طرفك أم سيوف أبيك","https://www.aldiwan.net/poem69051.html","الكامل"],[48,"ولا أفرق غلابا","https://www.aldiwan.net/poem66291.html","الهزج"],[50,"ألا يا خاتم الملك الذي","https://www.aldiwan.net/poem63815.html","الهزج"],[50,"فلا تبعد فكل فتى سيأتي","https://www.aldiwan.net/poem63836.html","البسيط"],[50,"أراني قد تصابيت","https://www.aldiwan.net/poem64742.html","الهزج"],[50,"دعاك الحب بالشعب","https://www.aldiwan.net/poem64830.html","الهزج"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140867",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39573","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1691","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42560","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42507","الخفيف"],[107,"فلك القلوب نسيم اللطف سيرها","https://www.aldiwan.net/poem16489.html","البسيط"],[113,"منح المهيمن أحمدا بظهوره","https://www.aldiwan.net/poem42002.html","الكامل"],[140,"ما زال يكشف عنى كل طارقة","https://www.aldiwan.net/poem58377.html","البسيط"],[140,"أبينا أن نطيعكم أبينا","https://www.aldiwan.net/poem58432.html","البسيط"],[141,"بك اقتضى الدين دينا كان قد وجبا","https://www.aldiwan.net/poem11722.html","البسيط"],[141,"سما بك دهرك فليفتخر","https://www.aldiwan.net/poem11765.html","المتقارب"],[158,"في الصلح راسل دهر راح غضبانا","https://www.aldiwan.net/poem59080.html","البسيط"],[167,"تخفي الصبابة والألحاظ تبديها","https://www.aldiwan.net/poem1690.html",""],[208,"سلام كعرف المسك يعبق بالنشر","https://www.aldiwan.net/poem13525.html","الطويل"],[210,"سرى كنسيم الخافقين أتاني","https://www.aldiwan.net/poem37829.html","الطويل"],[237,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[280,"نعشت قوما وكانوا قبل قد دثروا","https://www.aldiwan.net/poem32293.html","البسيط"],[280,"نعشت قوما وكانوا قبل قد دثروا","https://www.aldiwan.net/poem32759.html","البسيط"],[346,"برغمي إن خلت منه المذاود","https://www.aldiwan.net/poem20065.html","الوافر"],[362,"إذا ضربوا بكاظمة الخياما","https://www.aldiwan.net/poem60656.html","الوافر"],[403,"ألم بمضجعي بعد الكلال","https://www.aldiwan.net/poem50138.html","الوافر"],[403,"ألم خاليها بعد الهجوع","https://www.aldiwan.net/poem50149.html","الوافر"],[413,"نؤمل أن يطول بنا الثواء","https://www.aldiwan.net/poem54077.html","الوافر"],[413,"لقد خفقت في النحر ألوية النصر","https://www.aldiwan.net/poem54141.html","الطويل"],[413,"أمن بعد الهمام القرم وادي","https://www.aldiwan.net/poem54153.html","الوافر"],[429,"لمن الشموس غربن في الأكوار","https://www.aldiwan.net/poem12433.html","الكامل"],[429,"سارت مطيهم بهم تمطو","https://www.aldiwan.net/poem12799.html","أحذ الكامل"],[434,"قد أعرب الدمع عن وجدي وكتماني","https://www.aldiwan.net/poem2565.html","البسيط"],[434,"ما بعد رامة للمشتاق من إرب","https://www.aldiwan.net/poem2580.html","البسيط"],[436,"كذا تتجلى الشمس بعد كسوفها","https://www.aldiwan.net/poem34867.html","الطويل"],[438,"أطاوي السبسب القهب","https://www.aldiwan.net/poem14421.html","مجزوء الوافر"],[438,"نيوب النائبات البائنات","https://www.aldiwan.net/poem14437.html","الوافر"],[438,"تعز فعز حي لا يموت","https://www.aldiwan.net/poem14442.html","الوافر"],[438,"أعزيكمو في ميت لم يزل عندي","https://www.aldiwan.net/poem14445.html","الطويل"],[447,"إن العروبة بالإسلام عزتها","https://www.aldiwan.net/poem996.html",""],[456,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[456,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[462,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[477,"بالشاعرين نحيي ندوة الأدب","https://www.aldiwan.net/poem37191.html","البسيط"],[480,"تزود من الدنيا فإنك راحل","https://www.aldiwan.net/poem24463.html","عموديه"],[498,"كل حال لا بد آنا يحول","https://www.aldiwan.net/poem37568.html","الخفيف"],[511,"مباشرة النسيم لشخص الفي","https://www.aldiwan.net/poem67779.html","الوافر"],[549,"من على هذه الديار أقاما","https://www.aldiwan.net/poem47232.html","الخفيف"],[556,"كواكب جرت من السماء","https://www.aldiwan.net/poem35083.html","الرجز"],[560,"يصيب كنوز مال كل فدم","https://www.aldiwan.net/poem52717.html","الوافر"]],"verses":[["وَلَو يَسوقُ جَميعُ الناسِ ما مَلَكوا","لِنَظرَةٍ مِن ظَلومِ الحُسنِ ما غُبِنوا",0,"ن",3,0],["وَلَوْ يَمَّمَتْ سَيْفَ بْنَ ذِي يَزَنٍ لَمَا","تَقَرَّرَ ذَاكَ الْغِمْدُ فِي غِمْدِ غُمْدَانِ",1,"ن",1,0],["وَلَو يَستَطيعُ المُسلِمونَ لَقَسَّموا","لَكَ الشَطرَ مِن أَعمارِهِم غَيرَ نُدَّمِ",2,"م",1,0],["وَلَو يُرزَقُ الناسُ مِن حيلَةٍ","لَما نِلتَ كَفّاً مِنَ التُربَه",3,"ب",2,0],["وَلَو يَشرَبُ الماءَ أَهلُ العَفافِ","لَما نِلتَ مِن مائِهِم شَربَه",3,"ب",2,0],["وَلَو يَعلَمُ السُلطانُ ما تَفعَلونَهُ","لَبانَت يَمينٌ مِنكُمُ وَيَمينُ",4,"ن",1,0],["وَلَو يَدعو الكِرامَ بَني حُباقٍ","لَلاقى دونَ ذِمَّتِهِم ذِيادا",5,"د",2,0],["وَلَو يَدعو بَني عَوذِ بنِ سودٍ","دَعا الوافينَ بِالذِمَمِ الجِعادا",5,"د",2,0],["وَلَو يَدعو المَعاوِلَ ما اِجتَوَوهُ","إِذا الداعي غَداةَ الرَوعِ نادى",5,"د",2,0],["وَلَو يَهوَينَ ذاكَ سَقَينَ عَذباً","عَلى العِلّاتِ آوِنَةً زُلالا",6,"ل",2,0],["وَلِوى قُرَيشٍ في المَشاهِدِ كُلِّها","وَبِنَجدَةٍ عِندَ القَنا الخَطّارِ",7,"ر",1,0],["ولو يسْطيعُ مكَّنه","مكان الروح من جسدِهْ",8,"د",2,0],["ولُوِّيَ عمرو لَيَّ لَبلابِ غيضةٍ","وطال فما يَفنى بذرع ولا حزر",9,"ر",1,0],["ولو يشاء كفاهُ أنَّهُ رَجُلٌ","من بين أكرم أخوالٍ وأعمامِ",10,"م",1,0],["ولو يَممتْ من مَقْطع التُّرب عُصبةٌ","ذَراك على علاتها ما تَعنَّتِ",11,"ت",1,0],["ولوى احتراسي من المنْسياتِ","كفاني الكتابَ اعتمادي عليكا",12,"ك",2,0],["وَلَو يُجَمَّعُ رِفدُ الناسِ كُلِّهِمِ","لَم يَرفِدِ الناسُ إِلّا دونَ ما رَفَدوا",13,"د",3,0],["وَلَو يَبُثُّ بَنو لُبنانَ لَوعَتَهُم","لَاِهتَزَّتِ الأَرضُ لَمّا اِهتَزَّ لِبنانُ",14,"ن",1,0],["ولو يردّ القضاءَ دمع","لحولت أدمعي القضاء",15,"ا",2,0],["وَلَو يَمَّمتُهُم في الحَشرِ تَجدو","لَأَعطَوكَ الَّذي صَلَّوا وَصاموا",16,"م",3,0],["وَلَو يُلاقيكَ صُبحاً مُصحِراً لَرَأى","صَريمَةً يَنثَني عَن مِثلِها الأَسَدُ",17,"د",1,0],["وَلَو يَبتَدي في بَضعِ عَشرَةَ لَيلَةً","مِنَ الشَهرِ ما شَكَّ اِمرُؤٌ أَنَّهُ البَدرُ",18,"ر",1,0],["وَلَوَّينَ البَنانَ غَداةَ بَينٍ","بِتَسليمٍ وَهُنَّ عَلى اِنطِلاقِ",19,"ق",1,0],["ولو يَطيبُ ولو عُلَّتْ شَرائِجُه","بالرَّاحِ خالطَها مِسْكٌ وكافورُ",20,"ر",1,0],["وَلَو يَنشَقُّ وَجهُ الأَرضِ عَنهُ","عَدَدتَ عِظامَهُ عَظماً فَعَظما",21,"م",2,0],["وَلَو يُقالُ اِقرِ حَدَّ السَيفِ شَرَّهُما","ما شامَ حَدَّيهِ حَتّى يَقتُلَ الخُلُفا",22,"ف",2,0],["ولو يذوقُ عاذلي ريقتَها","صبا معي لكنَّهُ ما ذاقَها",23,"ق",3,0],["ولو يبقى سَلَوْنا مَنْ سواهُ","فإنَّ بموته ماتَ الكرامُ",24,"م",1,0],["وَلَوى الخَليجُ هُناكَ صَفحَةَ مُعرِضٍ","لَثَمَت سَوالِفَها ثُغورُ أَقاحِ",25,"ح",1,0],["وَلَوى القَضيبُ هُناكَ جيداً أَتلَعاً","قَد قَبَّلَتهُ مَباسِمُ النُوّارِ",26,"ر",1,0],["وَلَوى العِنانَ عَنِ الإِطالَةِ أَنَّني","نِضوُ القُوى بِسُرى الفِراشِ ضَئيلُ",27,"ل",1,0],["ولوَى مُقبَّلَكِ اللّثامُ وما دَرَوا","أن قد لَثمْتُ به وقُبِّلَ فُوك",28,"ك",1,0],["ولو يعطى صقيلَ الحدّ","مثل الملح قِرضابا",29,"ب",2,0],["وَلَو يُبصِرُها العُمّا","رُ ما طابَت لَهُم عُمرَه",30,"ر",2,0],["وَلَو يَفدي مِنَ الحَدَثانِ شَيءٌ","فَدَيتُكَ بِالطَريفِ وَبِالتِلادِ",31,"د",1,0],["وَلَو يَترُكُني الحُبُّ","لَقَد صُمتُ وَصَلَّيتُ",32,"ت",1,0],["وَلَو يَشهَدُني ذو ثِ","قَتي بَعدُ لَأَوصَيتُ",32,"ت",1,0],["وَلَو يَسطيعُ إِذ شَطَّت","عَلى ما كانَ مِن عَتبِ",33,"ب",1,0],["ولو يَدَعْ رُيَّةَ والجزيرَهْ","حتى كوَى أَكلبَها الهريرَهْ",34,"ه",1,0],["ولو يعظم لنقصٍ كان فيه","ولم يزل الأمير ولن يزالا",35,"ل",2,0],["ولو يُرَدّ زمانُ المعجزاتِ بها","لانشقَّ بحرٌ لها وارتدَّ تيَّارُ",36,"ر",1,0],["وَلَو يُدفَنُ التَيمِيُّ ثُمَّ دَعَوتَهُ","إِلى فَضلِ زادٍ جاءَ يَسعى مِنَ القَبرِ",37,"ر",1,0],["وَلَوْ يَقْوَى لَسَارَ وَكَيْفَ يَقْوى","عَلَى هَوْلِ السُّرَى قَدَمُ الْكَسِيحِ",38,"ح",1,0],["وَلَوَى شَعْرَ حاجِبَيَّ عَلَى عَيْ","نَيَّ حَتَّى أَطَلَّ كَالْهُدَّابِ",39,"ب",1,0],["وَلَو يَشاء لأَجراها عَلى يَبس","مِن غَير سفان أَحياناً وَلا سفن",40,"ن",1,0],["ولوى له هام البرية كلها","ولقد تولاه بكل أموره",41,"ر",2,0],["ولو يبايعني الخَطِّىُّ أنْفَسه","لم أعطِه شطرَ أُنبوبٍ بأنبوبِ",42,"ب",1,0],["ولوّينَ البنانَ فقلتُ زجرا","بمعيادي وآمالي لوَينا",43,"ن",2,0],["وَلَو يَكونونَ أَكفاءً بَرَزتَ لَهُم","بُرُوزَ جَدِّكَ لَمّا نَكَّسَ الصُلُبا",44,"ب",2,0],["وَلَو يَظفَرونَ لَعَمري بِها","لَكانَت لِتيجانِهِم كَالدُرَر",45,"ر",1,0],["ولو يلاقي الذي لاقيته حجراً","من الحجارة ولو تورى له لانا",46,"ن",2,0],["وَلَو يَكُونُ لِقَرنِ الشَمسِ غُرَّتُهُ","تاهَت فَلَم يَستَطِع شَيءٌ يُواريها",47,"ي",3,0],["ولو يستطيع السعي مضناكم سعى","ولو انه يسعى على الشوك والجمر",48,"ر",1,0],["ولو يرعوي ذكري لهُ ومدائِحِي","لما طفقت يمناه بالرّسفان",49,"ن",1,0],["ولو ئشت قابلت الفعال بمثله","ونال جزاء الفعل عات ومذنب",50,"ب",1,0],["وَلَو يُناظِرُهُ في الفِقهِ أَسعَدُ لَم","يَسعَد وَأَحصَرَهُ عَن نُطقِهِ الحَصَرُ",51,"ر",1,0],["وَلَو يُناظِرُهُ في الفِقهِ أَسعَدُ لَم","يُسعَد وَأَحصَرَهُ عَن ذِكرِهِ الحَصَرُ",52,"ر",1,0],["وَلَوْ يَحْيَا كُشَاجِمُ كان عَبْداً","ليحيى في مُصنّفهِ الفَوائِدْ",53,"د",1,0],["ولو يَسْمَحْنَ لي بصديقِ صدْقٍ","جعلْتُ لَهُنَّ من ذَمّي ذِماما",54,"م",2,0],["وَلَو يَحلو كَماء المزنِ خَلقٌ","لما شَرَقَ امرؤ فيهِ بِحالِ",55,"ل",1,0],["وَلَو يَحكي أَنامله سَحابٌ","لَكانَ الدَهرُ منهُ في رَبيعِ",56,"ع",1,0],["ولو يُفدى فديناهُ ولكنْ","أسيرُ الموت ليس له فداء",57,"ا",2,0],["ولو يصبر القرم الوزير عليهم","لقيل به عجز وما قيل عن صبر",58,"ر",1,0],["ولو يفدى فدته إذَن رجال","عوادٍ بالسيوف على الأعادي",59,"ي",1,0],["ولَوَيْنَ أَجياداً يُحَلِّيها النَّوَى","بفرائِدٍ من فَيْضِ دَمْعٍ جارِي",60,"ر",2,0],["ولوى الى مصرٍ أخادِعُهُ","أرَجُ نماهُ ذلك الخَطُّ",61,"ط",1,0],["ولو يكون لنوح مثل سيبكم","لم ينفع الفلك بل أردي بطوفان",62,"ن",1,0],["ولو يباريه زاد الركب عن عرضٍ","في حلبةٍ لكبا منه على الركبِ",63,"ب",1,0],["ولَوْ يَتَعاطَى عاصِفُ الرِّيحِ شَأْوَها","لعاذَ بأَرْجَاءِ الفَلا من عُصُوفِها",64,"ف",3,0],["ولو يعطى لما قنعا","بدون الروح والنشب",65,"ب",1,0],["ولو يبغي الفدا عنها فدينا","بما نحوي ونحن من الفداة",66,"ه",1,0],["ولو يخطي الردى أَخطى هديلا","فأبكى حزنه فخت الحمام",67,"م",1,0],["ولو يقبل الموت الفدى من ذوي الفدى","لفدي أنوشروان بالملك والجند",68,"د",1,0],["ولو يهب أبو جهل لنجدتكم","ألا ترون أبا جهل هو السبب",69,"ب",1,0],["ولو يُشَقّ البحرُ ثمّ يلتقي","فِلقاه فوقي في هواك لم أُبَلْ",70,"ل",1,0],["ولويت وجهي عن مَصارع أُسرتي","حذرَ المنيّةِ والشفارُ تُحَدُّ لي",71,"ل",2,0],["ولو يستطيع البدر والجوُّ سافر","لمرَّ بذاك الأفق وهو ملثَّم",72,"م",1,0],["ولو يرى ما رأى الطاووس صاح لها","إذ ليس من وتد فيها ولا سبب",73,"ب",1,0],["ولو يعلم الإنسان ما يلتقي غدا","بدار البقا ما غدا للشر فاعل",74,"ل",1,0],["ولوى هامةً واقصر باعاً","مدَّ في الخائفين وهو طويل",75,"ل",1,0],["ولو يسطيع ما درجت دبورٌ","إذن ونهى الشمال عن الجنوب",76,"ب",1,0],["ولوى عنه كلّما عاقه التّرْ","بُ ولا ذاق في الزّمانِ أُواما",77,"م",2,0],["ولو يشاء ربها أطلقها","عن قيدها الوهميِّ بالأشياء",78,"ا",2,0],["ولو يُعطى من الأرزاقِ كلٌّ","على مِقدارِهِ انتَصَفَ الحكيمُ",79,"م",1,0]]}