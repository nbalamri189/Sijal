{"poems":[[55,"إني أجل ظلوما أن يكون لها","https://www.aldiwan.net/poem26080.html","البسيط"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[35,"عرج بأطراف الديار وسلم","https://www.aldiwan.net/poem38831.html","الطويل"],[54,"أمطلب دع دعاوى الكماة","https://www.aldiwan.net/poem27635.html","المتقارب"],[27,"أمامة ليست للتي شاع سرها","https://www.aldiwan.net/poem4435.html","الطويل"],[27,"أرسم الحي إذ نزلوا الإيادا","https://www.aldiwan.net/poem5724.html","الوافر"],[27,"أجد اليوم جيرتك ارتحالا","https://www.aldiwan.net/poem5947.html","الوافر"],[23,"كانت قريش بيضة فتفلقت","https://www.aldiwan.net/poem21409.html","الكامل"],[51,"عبيد اللّه عبد الله","https://www.aldiwan.net/poem61864.html","مجزوء الوافر"],[51,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[51,"اسعد بعيد أخي نسك وإسلام","https://www.aldiwan.net/poem66052.html","البسيط"],[51,"عزمت على تطليق عرسي لعسرتي","https://www.aldiwan.net/poem66518.html","الطويل"],[51,"سبيلي إليك كتابي إليكا","https://www.aldiwan.net/poem66730.html","المتقارب"],[29,"حلت صبيرة أمواه العداد وقد","https://www.aldiwan.net/poem6069.html","البسيط"],[91,"قالت لجارتها يوما تسائلها","https://www.aldiwan.net/poem62759.html","عموديه"],[85,"شأنك والدمع والبكاء","https://www.aldiwan.net/poem7111.html","مخلع البسيط"],[43,"فؤاد ما تسليه المدام","https://www.aldiwan.net/poem10538.html","الوافر"],[45,"قلب مشوق عناه البث والكمد","https://www.aldiwan.net/poem62734.html","البسيط"],[45,"عمرت أبا إسحاق ما صلح العمر","https://www.aldiwan.net/poem63637.html","الطويل"],[45,"تحمل آل سعدى للفراق","https://www.aldiwan.net/poem65210.html","الوافر"],[61,"خيش ابن رستم يحمى وهو ممطور","https://www.aldiwan.net/poem51649.html","البسيط"],[49,"كأني بالتراب عليك ردما","https://www.aldiwan.net/poem63117.html","الوافر"],[107,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[44,"أما الرسوم فقد أذكرن ما سلفا","https://www.aldiwan.net/poem30404.html","البسيط"],[69,"سرقت منها نظرة فاستضحكت","https://www.aldiwan.net/poem28902.html","الرجز"],[69,"برغمي أن بيتكم يضام","https://www.aldiwan.net/poem29243.html","الوافر"],[74,"يا رب مائسة المعاطف تزدهي","https://www.aldiwan.net/poem12885.html","الكامل"],[74,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[74,"الليل إلا حيث كنت طويل","https://www.aldiwan.net/poem13223.html","الكامل"],[75,"فتكات طرفك أم سيوف أبيك","https://www.aldiwan.net/poem69051.html","الكامل"],[48,"ولا أفرق غلابا","https://www.aldiwan.net/poem66291.html","الهزج"],[50,"ألا يا خاتم الملك الذي","https://www.aldiwan.net/poem63815.html","الهزج"],[50,"فلا تبعد فكل فتى سيأتي","https://www.aldiwan.net/poem63836.html","البسيط"],[50,"أراني قد تصابيت","https://www.aldiwan.net/poem64742.html","الهزج"],[50,"دعاك الحب بالشعب","https://www.aldiwan.net/poem64830.html","الهزج"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140867",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39573","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1691","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42560","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42507","الخفيف"],[100,"حوار جارين","https://www.poetsgate.com/ViewPoem.aspx?id=50201",""],[109,"فلك القلوب نسيم اللطف سيرها","https://www.aldiwan.net/poem16489.html","البسيط"],[115,"منح المهيمن أحمدا بظهوره","https://www.aldiwan.net/poem42002.html","الكامل"],[142,"ما زال يكشف عنى كل طارقة","https://www.aldiwan.net/poem58377.html","البسيط"],[142,"أبينا أن نطيعكم أبينا","https://www.aldiwan.net/poem58432.html","البسيط"],[143,"بك اقتضى الدين دينا كان قد وجبا","https://www.aldiwan.net/poem11722.html","البسيط"],[143,"سما بك دهرك فليفتخر","https://www.aldiwan.net/poem11765.html","المتقارب"],[160,"في الصلح راسل دهر راح غضبانا","https://www.aldiwan.net/poem59080.html","البسيط"],[169,"تخفي الصبابة والألحاظ تبديها","https://www.aldiwan.net/poem1690.html",""],[210,"سلام كعرف المسك يعبق بالنشر","https://www.aldiwan.net/poem13525.html","الطويل"],[212,"سرى كنسيم الخافقين أتاني","https://www.aldiwan.net/poem37829.html","الطويل"],[239,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[282,"نعشت قوما وكانوا قبل قد دثروا","https://www.aldiwan.net/poem32293.html","البسيط"],[282,"نعشت قوما وكانوا قبل قد دثروا","https://www.aldiwan.net/poem32759.html","البسيط"],[348,"برغمي إن خلت منه المذاود","https://www.aldiwan.net/poem20065.html","الوافر"],[364,"إذا ضربوا بكاظمة الخياما","https://www.aldiwan.net/poem60656.html","الوافر"],[406,"ألم بمضجعي بعد الكلال","https://www.aldiwan.net/poem50138.html","الوافر"],[406,"ألم خاليها بعد الهجوع","https://www.aldiwan.net/poem50149.html","الوافر"],[416,"نؤمل أن يطول بنا الثواء","https://www.aldiwan.net/poem54077.html","الوافر"],[416,"لقد خفقت في النحر ألوية النصر","https://www.aldiwan.net/poem54141.html","الطويل"],[416,"أمن بعد الهمام القرم وادي","https://www.aldiwan.net/poem54153.html","الوافر"],[432,"لمن الشموس غربن في الأكوار","https://www.aldiwan.net/poem12433.html","الكامل"],[432,"سارت مطيهم بهم تمطو","https://www.aldiwan.net/poem12799.html","أحذ الكامل"],[437,"قد أعرب الدمع عن وجدي وكتماني","https://www.aldiwan.net/poem2565.html","البسيط"],[437,"ما بعد رامة للمشتاق من إرب","https://www.aldiwan.net/poem2580.html","البسيط"],[439,"كذا تتجلى الشمس بعد كسوفها","https://www.aldiwan.net/poem34867.html","الطويل"],[441,"أطاوي السبسب القهب","https://www.aldiwan.net/poem14421.html","مجزوء الوافر"],[441,"نيوب النائبات البائنات","https://www.aldiwan.net/poem14437.html","الوافر"],[441,"تعز فعز حي لا يموت","https://www.aldiwan.net/poem14442.html","الوافر"],[441,"أعزيكمو في ميت لم يزل عندي","https://www.aldiwan.net/poem14445.html","الطويل"],[449,"إن العروبة بالإسلام عزتها","https://www.aldiwan.net/poem996.html",""],[458,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[458,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[464,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[479,"بالشاعرين نحيي ندوة الأدب","https://www.aldiwan.net/poem37191.html","البسيط"],[482,"تزود من الدنيا فإنك راحل","https://www.aldiwan.net/poem24463.html","عموديه"],[500,"كل حال لا بد آنا يحول","https://www.aldiwan.net/poem37568.html","الخفيف"],[513,"مباشرة النسيم لشخص الفي","https://www.aldiwan.net/poem67779.html","الوافر"],[551,"من على هذه الديار أقاما","https://www.aldiwan.net/poem47232.html","الخفيف"],[558,"كواكب جرت من السماء","https://www.aldiwan.net/poem35083.html","الرجز"],[562,"يصيب كنوز مال كل فدم","https://www.aldiwan.net/poem52717.html","الوافر"]],"verses":[["وَلَو يَسوقُ جَميعُ الناسِ ما مَلَكوا","لِنَظرَةٍ مِن ظَلومِ الحُسنِ ما غُبِنوا",0,"ن",3,0],["وَلَوْ يَمَّمَتْ سَيْفَ بْنَ ذِي يَزَنٍ لَمَا","تَقَرَّرَ ذَاكَ الْغِمْدُ فِي غِمْدِ غُمْدَانِ",1,"ن",1,0],["وَلَو يَستَطيعُ المُسلِمونَ لَقَسَّموا","لَكَ الشَطرَ مِن أَعمارِهِم غَيرَ نُدَّمِ",2,"م",1,0],["وَلَو يُرزَقُ الناسُ مِن حيلَةٍ","لَما نِلتَ كَفّاً مِنَ التُربَه",3,"ب",2,0],["وَلَو يَشرَبُ الماءَ أَهلُ العَفافِ","لَما نِلتَ مِن مائِهِم شَربَه",3,"ب",2,0],["وَلَو يَعلَمُ السُلطانُ ما تَفعَلونَهُ","لَبانَت يَمينٌ مِنكُمُ وَيَمينُ",4,"ن",1,0],["وَلَو يَدعو الكِرامَ بَني حُباقٍ","لَلاقى دونَ ذِمَّتِهِم ذِيادا",5,"د",2,0],["وَلَو يَدعو بَني عَوذِ بنِ سودٍ","دَعا الوافينَ بِالذِمَمِ الجِعادا",5,"د",2,0],["وَلَو يَدعو المَعاوِلَ ما اِجتَوَوهُ","إِذا الداعي غَداةَ الرَوعِ نادى",5,"د",2,0],["وَلَو يَهوَينَ ذاكَ سَقَينَ عَذباً","عَلى العِلّاتِ آوِنَةً زُلالا",6,"ل",2,0],["وَلِوى قُرَيشٍ في المَشاهِدِ كُلِّها","وَبِنَجدَةٍ عِندَ القَنا الخَطّارِ",7,"ر",1,0],["ولو يسْطيعُ مكَّنه","مكان الروح من جسدِهْ",8,"د",2,0],["ولُوِّيَ عمرو لَيَّ لَبلابِ غيضةٍ","وطال فما يَفنى بذرع ولا حزر",9,"ر",1,0],["ولو يشاء كفاهُ أنَّهُ رَجُلٌ","من بين أكرم أخوالٍ وأعمامِ",10,"م",1,0],["ولو يَممتْ من مَقْطع التُّرب عُصبةٌ","ذَراك على علاتها ما تَعنَّتِ",11,"ت",1,0],["ولوى احتراسي من المنْسياتِ","كفاني الكتابَ اعتمادي عليكا",12,"ك",2,0],["وَلَو يُجَمَّعُ رِفدُ الناسِ كُلِّهِمِ","لَم يَرفِدِ الناسُ إِلّا دونَ ما رَفَدوا",13,"د",3,0],["وَلَو يَبُثُّ بَنو لُبنانَ لَوعَتَهُم","لَاِهتَزَّتِ الأَرضُ لَمّا اِهتَزَّ لِبنانُ",14,"ن",1,0],["ولو يردّ القضاءَ دمع","لحولت أدمعي القضاء",15,"ا",2,0],["وَلَو يَمَّمتُهُم في الحَشرِ تَجدو","لَأَعطَوكَ الَّذي صَلَّوا وَصاموا",16,"م",3,0],["وَلَو يُلاقيكَ صُبحاً مُصحِراً لَرَأى","صَريمَةً يَنثَني عَن مِثلِها الأَسَدُ",17,"د",1,0],["وَلَو يَبتَدي في بَضعِ عَشرَةَ لَيلَةً","مِنَ الشَهرِ ما شَكَّ اِمرُؤٌ أَنَّهُ البَدرُ",18,"ر",1,0],["وَلَوَّينَ البَنانَ غَداةَ بَينٍ","بِتَسليمٍ وَهُنَّ عَلى اِنطِلاقِ",19,"ق",1,0],["ولو يَطيبُ ولو عُلَّتْ شَرائِجُه","بالرَّاحِ خالطَها مِسْكٌ وكافورُ",20,"ر",1,0],["وَلَو يَنشَقُّ وَجهُ الأَرضِ عَنهُ","عَدَدتَ عِظامَهُ عَظماً فَعَظما",21,"م",2,0],["وَلَو يَمَسُّونَ مَحْمُومَاً أَبَلَّ بِهِمْ","والحُزْنُ جَمْرٌ إذا مَرُّوا بِهِ بَرَدَا",22,"د",2,0],["وَلَوْ يُقَالُ لَهُ سِرْ فَوْقَ جَمْرِ غَضَىً","مَشَى عَلَيْهِ بَسِيمَ الوَجْهِ مُتَّئِدَا",22,"د",2,0],["وَلَو يُقالُ اِقرِ حَدَّ السَيفِ شَرَّهُما","ما شامَ حَدَّيهِ حَتّى يَقتُلَ الخُلُفا",23,"ف",2,0],["ولو يذوقُ عاذلي ريقتَها","صبا معي لكنَّهُ ما ذاقَها",24,"ق",3,0],["ولو يبقى سَلَوْنا مَنْ سواهُ","فإنَّ بموته ماتَ الكرامُ",25,"م",1,0],["وَلَوى الخَليجُ هُناكَ صَفحَةَ مُعرِضٍ","لَثَمَت سَوالِفَها ثُغورُ أَقاحِ",26,"ح",1,0],["وَلَوى القَضيبُ هُناكَ جيداً أَتلَعاً","قَد قَبَّلَتهُ مَباسِمُ النُوّارِ",27,"ر",1,0],["وَلَوى العِنانَ عَنِ الإِطالَةِ أَنَّني","نِضوُ القُوى بِسُرى الفِراشِ ضَئيلُ",28,"ل",1,0],["ولوَى مُقبَّلَكِ اللّثامُ وما دَرَوا","أن قد لَثمْتُ به وقُبِّلَ فُوك",29,"ك",1,0],["ولو يعطى صقيلَ الحدّ","مثل الملح قِرضابا",30,"ب",2,0],["وَلَو يُبصِرُها العُمّا","رُ ما طابَت لَهُم عُمرَه",31,"ر",2,0],["وَلَو يَفدي مِنَ الحَدَثانِ شَيءٌ","فَدَيتُكَ بِالطَريفِ وَبِالتِلادِ",32,"د",1,0],["وَلَو يَترُكُني الحُبُّ","لَقَد صُمتُ وَصَلَّيتُ",33,"ت",1,0],["وَلَو يَشهَدُني ذو ثِ","قَتي بَعدُ لَأَوصَيتُ",33,"ت",1,0],["وَلَو يَسطيعُ إِذ شَطَّت","عَلى ما كانَ مِن عَتبِ",34,"ب",1,0],["ولو يَدَعْ رُيَّةَ والجزيرَهْ","حتى كوَى أَكلبَها الهريرَهْ",35,"ه",1,0],["ولو يعظم لنقصٍ كان فيه","ولم يزل الأمير ولن يزالا",36,"ل",2,0],["ولو يُرَدّ زمانُ المعجزاتِ بها","لانشقَّ بحرٌ لها وارتدَّ تيَّارُ",37,"ر",1,0],["وَلَو يُدفَنُ التَيمِيُّ ثُمَّ دَعَوتَهُ","إِلى فَضلِ زادٍ جاءَ يَسعى مِنَ القَبرِ",38,"ر",1,0],["وَلَوْ يَقْوَى لَسَارَ وَكَيْفَ يَقْوى","عَلَى هَوْلِ السُّرَى قَدَمُ الْكَسِيحِ",39,"ح",1,0],["وَلَوَى شَعْرَ حاجِبَيَّ عَلَى عَيْ","نَيَّ حَتَّى أَطَلَّ كَالْهُدَّابِ",40,"ب",1,0],["ولوى جيده فأومى إليه","قبس شعّ لحظة وتوارى",41,"ر",2,0],["وَلَو يَشاء لأَجراها عَلى يَبس","مِن غَير سفان أَحياناً وَلا سفن",42,"ن",1,0],["ولوى له هام البرية كلها","ولقد تولاه بكل أموره",43,"ر",2,0],["ولو يبايعني الخَطِّىُّ أنْفَسه","لم أعطِه شطرَ أُنبوبٍ بأنبوبِ",44,"ب",1,0],["ولوّينَ البنانَ فقلتُ زجرا","بمعيادي وآمالي لوَينا",45,"ن",2,0],["وَلَو يَكونونَ أَكفاءً بَرَزتَ لَهُم","بُرُوزَ جَدِّكَ لَمّا نَكَّسَ الصُلُبا",46,"ب",2,0],["وَلَو يَظفَرونَ لَعَمري بِها","لَكانَت لِتيجانِهِم كَالدُرَر",47,"ر",1,0],["ولو يلاقي الذي لاقيته حجراً","من الحجارة ولو تورى له لانا",48,"ن",2,0],["وَلَو يَكُونُ لِقَرنِ الشَمسِ غُرَّتُهُ","تاهَت فَلَم يَستَطِع شَيءٌ يُواريها",49,"ي",3,0],["ولو يستطيع السعي مضناكم سعى","ولو انه يسعى على الشوك والجمر",50,"ر",1,0],["ولو يرعوي ذكري لهُ ومدائِحِي","لما طفقت يمناه بالرّسفان",51,"ن",1,0],["ولو ئشت قابلت الفعال بمثله","ونال جزاء الفعل عات ومذنب",52,"ب",1,0],["وَلَو يُناظِرُهُ في الفِقهِ أَسعَدُ لَم","يَسعَد وَأَحصَرَهُ عَن نُطقِهِ الحَصَرُ",53,"ر",1,0],["وَلَو يُناظِرُهُ في الفِقهِ أَسعَدُ لَم","يُسعَد وَأَحصَرَهُ عَن ذِكرِهِ الحَصَرُ",54,"ر",1,0],["وَلَوْ يَحْيَا كُشَاجِمُ كان عَبْداً","ليحيى في مُصنّفهِ الفَوائِدْ",55,"د",1,0],["ولو يَسْمَحْنَ لي بصديقِ صدْقٍ","جعلْتُ لَهُنَّ من ذَمّي ذِماما",56,"م",2,0],["وَلَو يَحلو كَماء المزنِ خَلقٌ","لما شَرَقَ امرؤ فيهِ بِحالِ",57,"ل",1,0],["وَلَو يَحكي أَنامله سَحابٌ","لَكانَ الدَهرُ منهُ في رَبيعِ",58,"ع",1,0],["ولو يُفدى فديناهُ ولكنْ","أسيرُ الموت ليس له فداء",59,"ا",2,0],["ولو يصبر القرم الوزير عليهم","لقيل به عجز وما قيل عن صبر",60,"ر",1,0],["ولو يفدى فدته إذَن رجال","عوادٍ بالسيوف على الأعادي",61,"ي",1,0],["ولَوَيْنَ أَجياداً يُحَلِّيها النَّوَى","بفرائِدٍ من فَيْضِ دَمْعٍ جارِي",62,"ر",2,0],["ولوى الى مصرٍ أخادِعُهُ","أرَجُ نماهُ ذلك الخَطُّ",63,"ط",1,0],["ولو يكون لنوح مثل سيبكم","لم ينفع الفلك بل أردي بطوفان",64,"ن",1,0],["ولو يباريه زاد الركب عن عرضٍ","في حلبةٍ لكبا منه على الركبِ",65,"ب",1,0],["ولَوْ يَتَعاطَى عاصِفُ الرِّيحِ شَأْوَها","لعاذَ بأَرْجَاءِ الفَلا من عُصُوفِها",66,"ف",3,0],["ولو يعطى لما قنعا","بدون الروح والنشب",67,"ب",1,0],["ولو يبغي الفدا عنها فدينا","بما نحوي ونحن من الفداة",68,"ه",1,0],["ولو يخطي الردى أَخطى هديلا","فأبكى حزنه فخت الحمام",69,"م",1,0],["ولو يقبل الموت الفدى من ذوي الفدى","لفدي أنوشروان بالملك والجند",70,"د",1,0],["ولو يهب أبو جهل لنجدتكم","ألا ترون أبا جهل هو السبب",71,"ب",1,0],["ولو يُشَقّ البحرُ ثمّ يلتقي","فِلقاه فوقي في هواك لم أُبَلْ",72,"ل",1,0],["ولويت وجهي عن مَصارع أُسرتي","حذرَ المنيّةِ والشفارُ تُحَدُّ لي",73,"ل",2,0],["ولو يستطيع البدر والجوُّ سافر","لمرَّ بذاك الأفق وهو ملثَّم",74,"م",1,0],["ولو يرى ما رأى الطاووس صاح لها","إذ ليس من وتد فيها ولا سبب",75,"ب",1,0],["ولو يعلم الإنسان ما يلتقي غدا","بدار البقا ما غدا للشر فاعل",76,"ل",1,0],["ولوى هامةً واقصر باعاً","مدَّ في الخائفين وهو طويل",77,"ل",1,0],["ولو يسطيع ما درجت دبورٌ","إذن ونهى الشمال عن الجنوب",78,"ب",1,0],["ولوى عنه كلّما عاقه التّرْ","بُ ولا ذاق في الزّمانِ أُواما",79,"م",2,0],["ولو يشاء ربها أطلقها","عن قيدها الوهميِّ بالأشياء",80,"ا",2,0],["ولو يُعطى من الأرزاقِ كلٌّ","على مِقدارِهِ انتَصَفَ الحكيمُ",81,"م",1,0]]}