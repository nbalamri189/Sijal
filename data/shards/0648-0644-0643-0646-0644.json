ldiwanalarabi.com/poemDescription.do?poemId=563811",""],[6239,"المتنبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75979&r=&rc=30",""],[2220,"عبدتُ الله لم أعبد سواه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11862&r=&rc=731",""],[6320,"نِدَاءُ اسْتِغَاثَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84333&r=&rc=30",""],[5126,"أقلّي اللَّوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87797&r=&rc=12",""]],"verses":[["وَلَكِن لَعَمري قَد بَكَيتُكِ جاهِداً","وَإِن كانَ دائي كُلُّهُ مِنكِ أَجمَعُ",0,"ع",1,0],["ولكِنْ لَقيتُ بصَبْرٍ جَميلٍ","قضاءَ الذي لمْ يزَلْ مُجْمَلا",1,"ل",2,0],["وَلَكِن لا يَصيدُ إِذا رَماها","وَلا تَصطادُ غانِيَةٌ كَنودُ",2,"د",1,0],["وَلَكِن لَيسَ هَذا مِنهُ بِدعاً","فَشِبهُ الشَيءِ مُنجَذِبٌ إِلَيهِ",3,"ي",2,0],["وَلَكِن لِحالٍ إِن لَبِستُ جَمالَها","كَسَوتُكَ ثَوبَ النُصحِ أَعلامُهُ الحَمدُ",4,"د",1,0],["وَلَكِن لا أَزالُ أَرى عَجولاً","وَباكِيَةً تَنوحُ لِيَومِ نَحسِ",5,"س",1,0],["وَلَكِنْ لِكُلٍّ حَيْثُ جَلَّتْ سُعُودُهُ","شَقَاءٌ يُوَافِيهِ أَّجَلَّ وَأَعْظَمَا",6,"م",2,0],["وَلَكِنْ لَقُوا مِنَّا الَّذِي لَمْ يَسُرَّهُمْ","لَقُوا الْقَاعَ وَالطَّيَّارُ خَزْيَانُ مُرْغَمُ",7,"م",1,0],["ولكنّ لي في موقف الشوق عبرة","تُساقط من أجفانيَ اللؤلؤ الرطبا",8,"ب",2,0],["ولكن لا أصوم صيام قوم","تكاثر في فُطورهم الطعام",9,"م",1,0],["ولكنّ لي فيكم يراعاً إذا شدا","أتاكم بكافٍ من علاه ومخرس",10,"س",1,0],["ولكن ليس مُنتَفِعاً بعلم","فتىً لم يُحرز الخُلُق النضيرا",11,"ر",2,0],["ولكن لمن أمسى بأيْد وقوّة","يجرّ على الأيام فضلَ ازاره",12,"ر",2,0],["ولكِنَّ لِي في آلِ أحمَدَ إسوَةً","وَمَا قَد مَضَى في سَالِفِ الدَّهرِ أطوَلُ",13,"ل",1,0],["وَلَكِن لَقيتُ المَوتَ حَتّى تَرَكتُها","وَفيها وَفي حَدِّ الحُسامِ فُلولُ",14,"ل",1,0],["وَلَكِنَّ لِحياناً أَبوكَ وَرِثتَهُ","وَمَأوى الخَنا مِنهُم فَدَع عَنكَ هاشِما",15,"م",2,0],["ولكنْ لكنزٍ من لُجينٍ وعَسْجَدٍ","يودُّ فناءَ العُمر قبل فنائِهِ",16,"ا",3,0],["ولكن لا تزالُ تَدُرُّ عفواً","لكل يدٍ مَرَتْها لاحتلابِ",17,"ب",1,0],["ولكن لا يزال يجودُ كُلّاً","بجَوْدٍ أو بَوبْلٍ ذي انسكابِ",17,"ب",1,0],["ولكنَّ لي نفس عليك شفيقةٌ","تحاذر وِجدانَ العدا فيك مَقْدحا",18,"ح",2,0],["ولكنْ لا بحمدِك ذاك لكن","بحمدِ مُكثّر المتنقّصيكا",19,"ك",2,0],["ولكن لا وفاء لها","فنفس محبها وجِلَهْ",20,"ل",2,0],["ولكن لا ارتجاعَ لما تقضَّى","فما استشعارُ باقٍ ذِكرَ فاني",21,"ن",2,0],["ولكن لها منهمُ عدَّةٌ","كقَطْر السماء وسكانها",22,"ن",3,0],["وَلَكِن لَنا بَرُّ العِراقِ وَبَحرُهُ","وَحَيثُ تَرى القُرقورَ في الماءِ يَسبَحُ",23,"ح",1,1],["وَلَكِنَّ لي أُمنِيَةً ما تَحَقَّقَت","إِذا لَم تُنِلنيها فَما أَنتَ صاحِبي",24,"ي",1,0],["وَلَكِن لَم يَدَع بُؤسَ اللَيالي","طَريفاً في يَدَيه وَلا تِلادا",25,"د",2,0],["ولكنْ لقد فَقَدَتْ في الوُجُودِ","رفيقاً مُصيخاً وقلباً رَؤُوفْ",26,"ف",1,0],["وَلَكِن لا يَمُرُّ عَلَيهِ إِلّا","كَما مَرَّت يَداهُ بِعارِضَيهِ",27,"ي",2,0],["ولكنْ لقومي عندَ قَومِكِ بُغْيَةٌ","وبينهُمُ فيها قِراعُ الكَتائبِ",28,"ب",1,0],["وَلَكِن لي في مارِدَينِ مَعاشِراً","شَدَدتُ بِهِم لَمّا حَلَلتُ بِها أَزري",29,"ر",2,0],["وَلَكِنَّ لي في كُلِّ يَومٍ إِلى العُلى","حَوائِجَ لَكِن دونَهُنَّ جَوائِحُ",30,"ح",1,0],["وَلَكِن لَيسَ يُعرَفُ لي خُروجٌ","وَلا تَسطيعُ في سِرٍّ دُخولا",31,"ل",2,0],["وَلَكِنَّ لَيلى لا تَفي بِأَمانَةَ","فَتَحسِبُ لَيلى أَنَّني سَأَخونُها",32,"ن",3,0],["ولكنْ للكريمِ السَّمْحِ ناهٍ","مِنَ الشِّيَمِ السَّنِيَّةِ والخِصَالِ",33,"ل",1,0],["وَلَكِن لَها آمِرٌ قادِرٌ","إِذا حاوَلَ الأَمرَ لا يُغلَبُ",34,"ب",1,0],["ولكنْ لعلّ الجاثليقَ يَغُرُّه","على حَلَبٍ نَهْبٌ هنالكَ مَنهوب",35,"ب",1,0],["وَلَكِن لَم أَجِد بُدّاً","مِن أَن أَجزيكُمُ وُدّي",36,"د",2,0],["وَلَكِن لا تُخانُ الدَهرَ عِندي","وَعِندَ اللَهِ تَجزِيَةُ الرِجالِ",37,"ل",1,0],["وَلَكِن لَقَيتَ صُروفَ الزَمانِ","وَباشَرَتها مِقنَباً مِقنَبا",38,"ب",2,0],["وَلَكِنْ لأَحْكَامِ الْهَوَى جَبَرِيَّةٌ","تَبُوخُ لَهَا الأَنْفَاسُ وَهْيَ تَفُورُ",39,"ر",1,0],["وَلَكِنْ لِمَ الأَيْدِي تُقِلُّكِ فَوْقَهَا","مُوسَّدَةً وَالصَّاحِبَاتُ بِلا عِطْرِ",40,"ر",1,0],["ولكن ليسَ في الباب","سوى الجنديّ والجابي",41,"ي",1,0],["ولكن ليس ينفجر","فيا لؤلؤتي السمراء!",42,"ا",2,0],["ولكن لا مُقامَ ببيت شعر","يطيب، ولو بناه أبو العلاء",43,"ا",2,0],["ولكنّ لي في صون دمعي مذهبا","فمن شاء عاناه ومن شاء نكّبا",44,"ب",2,0],["ولكن، لماذا الشهاداتُ؟ قولي","وهل يضمن البحر يوماً حدودَ جزيره؟؟",45,"ر",2,0],["ولكنْ لكنزٍ من لُجينٍ وعَسْجَدٍ","يودُّ فناءَ العُمر قبل فسائه",46,"ا",3,0],["ولكن لوعة التذكار شبت","فطيرت التشبث في الرنين",47,"ن",1,0],["ولكن لي في موقف الشوق عبرة","أولى الأنام بعطف الناس أرملة",48,"ه",1,0],["وَلَكن لَو رَكبت الريح طَرفاً","وَكانَ البَرق سَوطاً في يَديا",49,"ي",2,0],["ولكن لئيم الاصل والطبع لا يرى","سوى العيب شيئا والكريم حمول",50,"ل",1,0],["ولكن لفظك من ذاك أحلى","وأوقع في قلبي المستهام",51,"م",1,0],["ولَكِن لَم تَكُن بِمُقلِّدِيهِ","إذَا الأثرُ الصحيحُ تَضَا الثيابَا",52,"ب",2,0],["ولكنّ لي فضلا عليه فإنني","أنا الصائح المحكيّ والآخر الصدى",53,"د",2,0],["ولكن لها قبل السلام إِذا دنت","وداعٌ ومن قبل الرِضاع فِطامُ",54,"م",1,0],["ولكن لتجلو عنك ما لبسوا به","وتغسل امراً خادعوك به غسلا",55,"ل",2,0],["ولكن له يحتاط من كل مذهب","بأضيقه فعل الهيوب المحاذر",56,"ر",1,0],["وَلَكِن لِأَمرٍ أَخَّروني وَقَدَّموا","زَعانِفَ لا يَنهى العَدوَّ اِحتِسابُها",57,"ب",3,0],["وَلَكِنَّ لي فيكُم هَوىً وَقَرابَةً","تُحَرِّكُني وَالرَحمُ يُحمَدُ واصِلُه",58,"ل",2,0],["وَلَكن لهُ في كلّ عصرٍ جماعةٌ","وَإِنّي بهَذا العصرِ منهُم ولا فخرا",59,"ر",2,0],["ولكنْ لحظي أنَّ حظيَ ليلها","ومن ذا يخالُ الشمسَ في الليلِ تطلعُ",60,"ع",1,0],["ولكن لا مفر ولا دفاعا","من الاجل المحتم في القضاء",61,"ا",2,0],["ولكن للطبيخ، وقد عراها","طليح الهم مستلب الفراء",62,"ا",2,0],["وَلكِنَّ لَونَ الحُبِّ قَد يَتَغَيَّرُ","أُحِبُّكِ وَالدُنيا سَحابٌ مُغَرِّرٌ",63,"ر",1,0],["وَلَكِن لِيَستَشفي البِلادُ وَأَهلُها","بِفَضلِكَ مِن داءِ الجَهالَةِ وَالبُخلِ",64,"ل",1,0],["وَلَكِنْ لَمْ تُسَاعِدْنَا اللَّيَالِي","لِمَا يُرْضِي الإِخَاءَ مِنَ الْوِصَالِ",65,"ل",1,0],["ولكن لي حلم ابن قيس وحذقه","وفهم سليمانٍ وعزة ملكه",66,"ك",2,0],["ولكن لاصلاح لداء دهر","إذا ألفت طبائعه الفسادا",67,"د",2,0],["ولكن لمكث الدر في اليم رفعة","تبلغه بعد التراب الترائبا",68,"ب",2,0],["ولكن لي من ربة الشعر عطفةً","فأسلو بإكليلٍ يُزَيِّنُ جبهتي",69,"ي",1,0],["ولكنَّ ليلاتِ الشّقاءِ طويلةٌ","وفيهنَّ تهوي نجمةٌ بعد نجمة",70,"ه",1,0],["ولكن لها بالطَّيبينَ شَفَاعةٌ","فَهُم خيرُ أبدالٍ لخيرٍ تأخرا",71,"ر",2,0],["ولكن لجدٍّ عاثِرٍ خانت الوغى","فأردت أميرَ الجيشِ حرّاً تهجَّرا",71,"ر",2,0],["وَلكِنْ لِكَيْ يَعْلَمُوا أَنَّنِي","شَكَرْتُ حَقِيقاً بِشُكْرِ الأَيادِي",72,"د",2,0],["وَلَكِن لَم أَكُن إِلّا لِرَبّي","عَلى إِبلالِهِ عَبداً شَكورا",73,"ر",2,0],["وَلَكِن لَنا عُمرانِ عُمرٌ مُغلَقٌ","وَثانٍ يُسمي عِندَ رَبّي مَقدِرُ",74,"ر",1,0],["وَلَكن لعمري جَوهَر الحلم نادر","كَحلم أَمين الملك بَل هُوَ أَندَرُ",75,"ر",1,0],["وَلكِن لِتَجرِي دَمعَتِي مُطمَئِنَّةً","فأبكِي ولا يَدرِي بِذَاكَ جَلِيسي",76,"ي",1,0],["ولكنْ لا أزالُ كأنّ دَهْري","يُبِرُّ من الإساءةِ بي ألايا",77,"ا",3,0],["ولكن لاح بدراً في غمامٍ","فلم تَره العيونُ ولا تَلالا",78,"ل",2,0],["ولكنّ لي حُبّاً تقَادَمَ عَهْدُه","فليس إلى الإقصار عنه سَبيل",79,"ل",1,0],["ولكنْ لا سبيلَ إلى شفاءٍ","إذا مالَ الطّبيبُ على العَليل",80,"ل",1,0],["ولكنْ لي تَقادمُ عَهْدِ رِقٍ","فذاكَ عليكَ علَّمني الدَّلالا",81,"ل",2,0],["ولكنْ لعِلْمٍ منه أن سَيَرى الوَرى","بسيفِ أبي نَصْرٍ لدينِ الهُدَى نَصرا",82,"ر",2,0],["ولكنْ لكُلٍّ غَيْبةٌ عن مكانِه","وعمّا قليلٍ رَجْعَةٌ فإياب",83,"ب",1,0],["ولكِن ليسَ لي في كلِّ أرضٍ","أحاولُها نَدى بنجوتَكينا",84,"ن",2,0],["وَلَكن لَيسَ لِلمَرء اِحتِيال","مَع القَدر المُناح وَلا اِختِيار",85,"ر",1,0],["وَلكِن لَه طَبعٌ الى الخَيرِ سابِقٌ","وَرَأي بِأَبناءِ الرِجال بَصيرُ",86,"ر",1,0],["ولكن لقوم قد أتوا لعظيمة","فقاوال على ربنا منتهى القصد",87,"د",1,0],["ولكن لي في المصطفى ووصيه","وسبطيه والزهر أوذي الثفنات",88,"ت",1,0],["ولكن لإِفراط تغفيله","وغفلته عن شروط الأدب",89,"ب",1,0],["ولكن للعيان لَطيفُ مَعْنَى","لذا سأل المعايَنَةَ الكليمُ",90,"م",1,0],["ولكنْ لا سُهادَ بغَيرِ جَفْنٍ","كما وَجْدَ إلاّ بالفُؤادِ",91,"د",1,0],["ولكِنْ ليَ الأَعواضُ في النّاسِ منكُمُ","وكلُّ سَماءٍ من سمائِكُمُ أندَى",92,"د",2,0],["ولكنَّ لي قلبا تملَّكهُ الهوى","فلا العيشُ يهتنا لي ولا الموت أقربُ",93,"ب",1,0],["ولكنْ لقولٍ قد محا الشِعْرُ رسمَهُ","وهل عند رسمٍ دارسٍ بالهونِ منزلي",94,"ل",2,0],["ولكن لا سواك لنا مآل","وحلمك واسعٌ ستر السفاها",95,"ا",3,0],["ولكن للفتى أمد","إِذا وافاه لم يقف",96,"ف",1,0],["ولكن لنا بالمصطفى أي أسوة","تقضي وذي الدنيا تراها كما هيا",97,"ي",2,0],["ولكن لا جديد تح","ت هذي الشمس في النظم",98,"م",1,0],["ولكن لأُخْرى أرتجي حسن رأيه","ليحلو لنفسي في ذَراهُ مُقامُها",99,"م",3,0],["ولكنْ لماءِ المُعْصِراتِ مَواسِمٌ","وجودُ يَديْهِ مُسْتمرُّ المَواطِرِ",100,"ر",1,0],["ولكن لست رائدهم لشر","فقد أغنى الكلام عن الحسام",101,"م",1,0],["ولكن لساني وإن طالت بلاغته","مقصر عن أداء الفضل بل حصر",102,"ر",1,0],["ولكن لاختراعك في المعالي","خلائق لم تدنس باختراع",103,"ع",1,0],["وَلكِن لا شِفاءَ لَهُم","وَلَو قَد أَظهَروا اليَلَلا",104,"ل",2,0],["ولكن ليس بِدعاً كلُّ هذا","وفيهِ ما تَحيَّرتِ الفُهومُ",105,"م",1,0],["ولكن لِنصرِ الدَّينِ دينِ محمَّدٍ","وإنقَاذِه مِن بُؤرَة الهَلكِ والنَّكدِ",106,"د",1,0],["ولكن لِذاك الحُسنِ طبعٌ مُهذَّبٌ","وحاشا يخونُ العهدَ طبعٌ مهذَّبُ",107,"ب",1,0],["وَلَكِن لِعَبدِ اللَهِ فاِنطِق بِمَدحَةٍ","تُجبِرُكَ مِن عُسرِ الزَمانِ المُطَبَّقِ",108,"ق",1,0],["ولكن لا يضل سوى نفوس","بإنكار بغت وبسوء ظن",109,"ن",1,0],["ولكن له سلمت نفسي فإن يرد","هداها وإن يضلل فما هو جائر",110,"ر",1,0],["ولكن للظهور تنوُّعاتٌ","بها خرج البطونُ عن القيود",111,"د",1,0],["ولكنَّ لي أَرَباً لو أَرادَ","لصيَّرهُ غَيرَ مُسْتَصْعَب",112,"ب",1,0],["ولكن لنا بعض التسلي بذكرها","وحق بأن يرثي له كل شاعر",113,"ر",1,0],["وَلَكِنَّ لي مِن عَفوِ مَولايَ ساتِراً","فَهاءَنَذا مِنهُ بِهِ بِتُّ أَحتَمي",114,"م",2,0],["وَلَكِن لِفَضلِ الفَنِّ أَلقَت قِيادَها","فَصالَت بِها الصُنّاعَ صَولَةَ عَنتَرِ",115,"ر",1,0],["وَلَكن لسقمٍ حلّ بِالجسم فَاِنبَرى","وَكَلَّ فلم يَنهض لِنيل أُجور",116,"ر",1,0],["وَلَكن لِبعد واِحتجاب عَن الأَذى","وَعَن مَنع إِحسان وَنَقض ذمام",117,"م",1,0],["وَلَكن لا تمل عَني لِغَيري","فَغَيري لِلصَبابة لا يُعاني",118,"ن",2,0],["وَلكِن لَعَمرُ اللَهِ ما ظَلَّ مُسلِماً","كَغَرِّ الثَنايا واضِحاتِ المَلاغِمِ",119,"م",1,1],["ولكنَّ للأيّامِ شِيمةَ غادرٍ","إذا حَسَّنَتْ حالاً تَعودُ تُقَبِّحُ",120,"ح",1,0],["ولكن لاملأ سمع الزما","ن من جوهري فيك حمدا وشكرا",121,"ر",2,0],["ولكن لي نفس الوقور وعفة ال","قدير وقلبي في المهمات قلب",122,"ب",1,0],["ولكن لُذْ بقهارٍ قوى","عزيز لاتحيط به الصفات",123,"ت",1,0],["ولكن لنا رب بنا هُو ألطفُ","فمنه العطاء الجمُّ والفتح والنصرُ",124,"ر",1,0],["وَلكِن لِماذا بَل اِبقَ اَبراهيم","وَخُذ في هَوى الغيدِ بَعدي وَذَرْ",125,"ر",1,0],["وَلَكِن لِيَرتَاحَ الصَّدِيقُ وَيَنزَوِي","عَدُوٌّ مُداجٍ أَو عَدُوٌّ مُجالِحُ",126,"ح",1,0],["وَلكنّ لي أَهلون فارقت أرضَهم","وَفي القلبِ مِن خوف الفراق وجيبُ",127,"ب",1,0],["ولكن لساني إذا ما أردت","مديحاً خطرت على ذكره",128,"ر",2,0],["ولكنّ لي خافقاً لم يزل","يحن إلى بقعة نائيةْ",129,"ي",2,0],["وَلَكن لا رجاءَ وَلا مُجيبٌ","سِوى رَجع الصَدى فَأقصر عَناكا",130,"ك",2,0],["وَلَكِن لِهَذا الرِزقَ وَقتٌ مُوقتٌ","يقسّمه بَينَ البَريَّةِ واهبه",131,"ب",2,0],["ولكن لي منهاج علم سلكته","تحاماه غيري فهو من وراد وهبي",132,"ب",2,0],["ولكن لي بالفضل يا رحمة الورى","تجارة مدح ليس فيك بتور",133,"ر",1,0],["ولكن للشباب عليَّ هينٌ","وقد حكم المشيب بأن أفيه",134,"ي",2,0],["وَلكِنْ لِتَجْري عَبْرَتي مُطْمَئِنَّةً","فَأَبْكي وَلا يَدْرِي بِذَاك جَليسي",135,"ي",1,0],["ولكن لا تَدِقُّ بناتُ فكري","إذا ما قيلَ قد فنيَ الدقيقُ",136,"ق",1,0],["ولكنَّ لي في باطن النّفس حاجةً","تَنِمُّ عليها زفرةٌ وشهيق",137,"ق",1,0],["ولكن لأجال تؤخر أخذها","لعل ارعواء ما يساق بنفحة",138,"ه",1,0],["ولكنَّ لي بالشامِ عَذرَاءُ صَبوةٍ","جَعَلتُ لها عذرَ النُّهى غير راشِدِ",139,"د",1,0],["ولكنّ لي في آل نبهان موضعا","من البرّ لا أسلوهُم فأفارِقُ",140,"ق",1,0],["وَلَكِنْ لِتَحْظَى بِاقْتِرَابِ خَلِيفةٍ","يدِينُ بِتَقْوَى اللَّهِ فِي الحِلِّ وَالعَقْدِ",141,"د",1,0],["ولكن لها أفعالُ عينيه فى الحشا","فكلّ حُشاً فيها عليه جريحُ",142,"ح",1,0],["ولكن للفتوح بنا فتوح","مقدرة فلم تدرك طلابا",143,"ب",2,0],["ولكنَّ لي كلَّهم مرتضًى","فحاشاهمُ أن يَروني عَقيلا",144,"ل",2,0],["ولكن لإظهار صِدق الشعور","ولا خير في المرء لا يَشعر",145,"ر",1,0],["ولكن لرفع حِجاب الجَهالةِ","أدعو بلاديَ إن تَسمع",146,"ع",1,0],["ولكن لحفظِك مّما يُلِمُّ","تراقبك العينُ يا غاليه",147,"ي",2,0],["وَلَكِن لَجَّ في شَتمِ البَرايا","وكانَ القَتلُ عاقِبَةَ اللُجاجِ",148,"ج",1,0],["ولكن لأبياتٍ حباني بدرِّها","محمد عز الدين در البراعةِ",149,"ه",1,0],["ولكن للوفود وكل جار","أرقَّ وللضيوف النازلينا",150,"ن",2,0],["ولكنَّ لي من صادق الودَّ عندهم","شفيعاً إذا ما عاتبوني تشفَّعا",151,"ع",2,0],["ولكن لا به شجني","ولا قد شفه الكلفُ",152,"ف",1,0],["ولكن لعمري ما شفى المرء وجده","بشاف كوخد اليعملات الرواسم",153,"م",1,0],["ولكن للمديح أراك أهلا","لأنك للمكارم ذو اكتساب",154,"ب",1,0],["ولكن لما فاهوا به وتكلمُوا","من الإفك والبهتان في الواحد الحكم",155,"م",1,0],["ولكن له الميراث من صلب ماله","كأنك تحييه وإن كان يخنعُ",156,"ع",1,0],["وَلَكِن لَهُم في عَرصَةِ الدارِ جَولَةٌ","يُثَقَّلُ مِنها خُرجُهُ المُتَخَفِّفُ",157,"ف",1,0],["ولكن للشرق يوماً يجيءُ","فيا نفس صبراً لا بانه",158,"ن",2,0],["ولكِنْ لِمَن قَدحَلَّها وَثَوَى بِها","وَإنْ غَابَ عَن عَيني فَمازالَ عن قَلبي",159,"ب",2,0],["ولكن لا أراك اللَه كرهاً","له طمع تذوب به المراره",160,"ر",2,0],["ولكن لا أرى من يشتريه","ولا من لا يقول اليك عذرا",161,"ر",2,0],["وَلكِن لِأَمرٍ يَجدَعُ الأَنفَ رَبُّهُ","وَيُغضي وَفي الأَحشاءِ وَخزُ اللهاذمِ",162,"م",1,0],["ولكن ليس نفقه علم هذا","وإنْ كان قد دعاه",163,"ا",2,0],["ولكن ليعلو الدينُ عِزَّاً وشرعُنا","إلى موضعِ عنه الطواغيت تسفلُ",164,"ل",1,0],["ولكن لما عندي من العلم بالذي","إذا أنا لم أذكره قيل غيور",165,"ر",1,0],["ولكن لنا في بعد ذاتك وحشةٌ","لانس فقدناه فلا كان ذا البعد",166,"د",1,0],["ولكن لؤم الطبع يحمل أهله","على الصعب من سب الكرام أولي النبل",167,"ل",1,0],["وَلَكِن لا يُطاوِعُني حَيائي","وَعَزمٌ كُنتُ أَحسَبُهُ طَريرا",168,"ر",2,0],["ولكن ليبدوا عندهم سوء مااجتروا","عليهم فلا يبقى لآثمهم عذر",169,"ر",1,0],["ولكنْ لودٍّ من أبيكَ اعتقدتهُ","ومن قَبل من زيد جرى بالمراحمِ",170,"م",1,0],["ولكن لها نارٌ يشبُّ وقودها","أبيتُ لها ليل السليم موسوسا",171,"س",2,0],["ولكن لا فأَنتِ مع التجافي","مكرمةٌ على رغم الجميع",172,"ع",1,0],["ولكن لاقتناص شرود معنى","يعنّ وحكمة تبدو وسر",173,"ر",1,0],["وَلَكن للأَرحام عِندي وَشيجة","تَراعي وَعِندي الوَد لَيسَ يَضيع",174,"ع",1,0],["وَلَكن لَيسَ لي في البَيت ديك","يَنبَّهني لاوقات الصَلاة",175,"ه",1,0],["ولكن لعل الله يجمع بيننا","فنقضي مكنون الحشا والترائب",176,"ب",1,0],["ولكنّ لي في مدحِكم خيرَ قُربةٍ","بها اللَهُ يعفو عن عظائمِ أوزاري",177,"ر",2,0],["ولكن لأرباب الغرامِ طريقةٌ","يلذُّ بها مُرُّ الدَّواهي الهوائلِ",178,"ل",1,0],["ولكن لجاج في النفوس إذا انقضى","رجعت كما قد عاد طير إلى وكر",179,"ر",1,0],["وَلَكن لِتَرتادوا حَقائق شَرقنا","وَتَستَمعوا للقَلب عَن كَثَبٍ نَبضا",180,"ض",2,0],["ولكن لي إلى ربي شفيع","شفاعته بها أعطاه إذنه",181,"ن",2,0],["ولكن لي يوم الصروف عزيمة","أذيب بها حد الحسام المهند",182,"د",1,0],["وَلَكن لَيسَ يَجسُرُ ناصِحُوه","عَلَيهِ إِنَّهُ ملِكٌ مَخوفُ",183,"ف",1,0],["وَلَكن لَها شُغلٌ بِأَجرٍ تُعِدُّهُ","لِيَوم معادٍ حينَ ينفَخُ في الصُوَر",184,"ر",1,0],["ولكن لي بالصابرين تأسيا","أقول لها لما استضاء ظلامها",185,"م",3,0],["ولكن لعزف الخيل يوماً بوقعة","ترى الطفل فيها بالقتير معمما",186,"م",2,0],["ولكن لدى الرحمان آي وهل أتى","تبكي بوصف القاصرات المفكر",187,"ر",1,0],["ولكن لقوم عاهدوا اللّه أنهم","يقدون نسج الهام من كل فاسق",188,"ق",1,0],["ولكنْ لهن بسمعي الشجاع","تواقيع عودٍ ولحنُ وتر",189,"ر",1,0],["ولكنْ لي بقلبك يا حبيبي","شفيع عنده تمحى الذنوب",190,"ب",1,0],["ولكن لستَ من نظمي وخلْقي","لما خَلَقَتْ يدي أبكي الضياعا",191,"ع",2,0],["ولكن لا أزال أعيش فيه","بدنيا الفكر أو دنيا الرجاء",192,"ا",2,0],["ولكن لا أريد شريك عيش","ووحي مفسدا عقلي وديني",193,"ن",2,0],["ولكن له غيبوبةٌ كلّ فترةً","فيصبح في النادي غريباً عن النادي",194,"د",2,0],["ولكن لم يحسوا الضنك مثلي","فمن يسمع صراخي لم يجبني",195,"ن",2,0],["ولكن لم أكد آويه حتى","رأيت له جيوش الركب تترى",196,"ر",2,0],["ولكن لستُ أدري كيف أني","هويتُ ومال بي للأرض نحسي",197,"س",2,0],["وَلَكن للأَعمار حَداً وَغاية","هُنالك تَنبو عَن مضارِبِها القضب",198,"ب",1,0],["ولكن لها جاه الحسين عناية","تقول بها فخري ونعم المفاخر",199,"ر",1,0],["ولكن لأغتيال الدين جاؤا","ليطفوا من سناه أي نور",200,"ر",1,0],["ولكن لا يبل غليل شوقي","إليك سوى مشاهدة العيان",201,"ن",1,0],["ولكن لسان الدين قد قال فيكما","بفقد حسين قد فقدت محمدا",202,"د",2,0],["ولكن لستُ أوَّلَ من تمنَّى","من الدنيا الذي لا يستحقُ",203,"ق",1,0],["ولكنّ لي في سَفحِ صِنّينَ مَوطِناً","إِذا مَا ذكَرتُ الأهلَ فِيهِ فَإنّني",204,"ي",1,0],["ولكن لم أجد أحداً","يضّمّد جرحي الدّامي",205,"م",2,0],["ولكن لست أيأس قط منهم","إذا ما جئت بالقلب السليم",206,"م",1,0],["وَلَكِنَّ لِي فِي يُوسُفَ خَيرَ أسوَةٍ","وَلَيسَ عَلَى مَن بَالنَّبِيّ ائتَسَى ذَنبُ",207,"ب",1,0],["ولكن لي في يوسف خير أسوة","وليس على من بالنبي انتسى ذنب",208,"ب",1,0],["ولكن لهُ العُذْرُ فيما أتَى","فلمْ يكْبُ وهْناً ولمْ يُسْرِفِ",209,"ف",1,0],["وَلكِن لَنا عَنهُ عَزاءٌ مُخَلَّد","يَكف بِهِ عَنّا العنا وَالتَحسُّرُ",210,"ر",1,0],["وَلَكِن لِشِعرٍ لَهُ رائِق","لِسَمعِ البَصيرِ وَلِلمُنشدِ",211,"د",1,0],["ولكنَّ لي طبعاً كريماً مخالفاً","لاخلاقكم حلمٌ به وسكون",212,"ن",1,0],["ولكن لنا من وصفه خير حلية","تقيم دواماً حسنها ليس ذاويا",213,"ي",2,0],["ولكن لا يزال لك أذكاري","وما وشى لغيركم بناني",214,"ن",2,0],["وَلَكن لَهُ بِالسَبق في الفَضل عادة","وَمثلي بِذاكَ السَبق لَم يَتعوّد",215,"د",1,0],["ولكن لأَن ما كانَ قبل وُلودِهِ","وِلادٌ وذا رَدٌّ كفاكَ بهِ رَدعا",216,"ع",2,0],["وَلَكن لذل النَفس أَيّةُ خِسّةٍ","يحدّث عَنها ذاهبُ الناس قادِما",217,"م",2,0],["وَلكن لَو قَضى يانوسُ فيهِ","عَلى ما أَبصرت زرقا اليَمامه",218,"م",2,0],["وَلكنّ لي قَلباً حديداً وَإِن أَكن","أَرقّ من النسمات غبّ التنسُّم",219,"م",1,0],["وَلكن لكل في الأُمور نهايةٌ","وَلم يَبقَ حالٌ واحد حال واحد",220,"د",1,0],["وَلكنّ لي نَفساً أَبَت غَيرَ عزها","وَلَيسَ عَجيب ذا لِنفس أَبية",221,"ه",1,0],["وَلَكن لي مِن الدُنيا أَمانٌ","وَأَرجو أَن تَفي لي بِالوُعود",222,"د",1,0],["ولكن ليس هذا الخطب مما","تقهقهره الجيوش ولا الجنود",223,"د",1,0],["ولكن لهم فيها الظهور على العدى","وإن كثرت أعدا وهم وتالبوا",224,"ب",3,0],["ولكن لأنواع الظهور مراتب","لها أجل يثني الظهور اذا حمَّا",225,"م",2,0],["ولكن لهن بعد","عن الأرض لا يحد",226,"د",1,0],["ولكن لها أهل إذا ما عددتهم","فتوشك تحيا الدهر طائرة الجسم",227,"م",1,0],["ولكن لإبنِ أخيهِ عليٍّ","عُلُوٌّ على العمِّ لم يُرَمِ",228,"م",1,0],["وَلكن لي سرا خَطيراً اريد أَن","ابثكه كَي تَستَفيق وَتَعلما",229,"م",2,0],["وَلَكِن لَدى اشبنِ تِلامونَ ثارَت","عِصابَةُ بَأسٍ حَوالَيهِ دارَت",230,"ت",1,0],["ولكن للعزاء ترى","سبيلاً كل أسرتنا",231,"ن",2,0],["ولكن لنغض عن الغابر","ونله بموقفنا الحاضر",232,"ر",1,0],["ولكن لهكطور صوتٍ دوى","يشق الفضاء بغربٍ وشرق",232,"ق",1,0],["ولكنَّ لي قَولاً صَرِيحاً فَخُذ بهِ","لأَجلِ فَتاتي لَستُ مُنتضِياً نَصلي",233,"ل",2,0],["ولكن لي قولاً بقلبي أقوله","فعيه إلى يوم انبتات العلائق",234,"ق",1,0],["وَلَكِن لَيالينا بِبُرقَةِ بَرمَلٍ","وَهَضبِ شَرَورى دونَنا لا تَصَدَّفُ",235,"ف",1,0],["ولكن لمر ليس يدرك سره","وعاصفةٍ هوجاء في قلب معتلِّ",236,"ل",1,0],["وَلكِنَّ لي عَن مِثلِ فِعلِكَ عِفَّةٌ","قَفَوتُ بِها مَن قالَ لِلخَلِّ يَنصَحُ",237,"ح",1,0],["ولكن لي في اللَه ظنا محققا","سأعطي به فضلا من اللَه وافيا",238,"ي",2,0],["ولكن لضعفٍ وافتفارٍ وصبيةٍ","صغار عليهم تستهل شئوني",239,"ن",2,0],["ولكن ليس من حرج عليه","كما قد جاء في نص الكتاب",240,"ب",1,0],["ولكن لي البشرى بما قد كتبتها","على نفسك اللهم فيما تنزلا",241,"ل",2,0],["وَلَكِن لأمرٍ شاءَهُ اللَهُ خَلقَهُ","سَرى لَهُ في جُنحٍ مِنَ اللَيلِ مُظلِمِ",242,"م",1,0],["وَلَكِن لٍسوءِ الحَظِّ خانَت ثَقاتُهُ","فَأَصبَحَ صُلحُ الروسِ أَجزَلَ مَغنَمِ",242,"م",1,0],["ولكن لهُ فضلٌ عليَّ ومنةٌ","فمن حيث ما أنساه ذِكري التطوُّدُ",243,"د",1,0],["ولكن لم يزل ربُّ البَرايا","يزورُكَ من مَلائكِهِ جُموعُ",244,"ع",1,0],["وَلكِن لأَمر طالَ حجبي فَلَم أَرَ","مُحيّاهُ يُجلى آه من ظلمة الحَبسِ",245,"س",1,0],["وَلكِن لي في جاهِ أَحمدَ مُرتَجىً","لَدَيكَ وَفي الأَشيا لَكَ الحلُّ وَالعَقدُ",246,"د",1,0],["وَلكِن لوجه اللَهِ أَدرك بِلادنا","فَمن ضعفها تَخشى السِلاح مخشخشا",247,"ش",2,0],["ولكن لما فرق اللّه شملكم","رأيتم من الأهوال قاصمة الظهر",248,"ر",1,0],["ولكن له ربُّه اختارَ ما","به يحصل الفوزُ والإفتخار",249,"ر",1,0],["ولكنّ لطفَ الله بالناس لم يزل","يُسايرهم في كل أمرٍ مُحتَّم",250,"م",1,0],["ولكن لفرطِ الوُدِّ مني أبحتُكم","جميعَ الذي قد كان في القلب يكتمُ",251,"م",1,1],["ولكن له فينا يدٌ قد تضاءلت","علينا بها غاراتهُ وهجومهُ",252,"م",2,0],["ولكن له ذكر جميل مؤبدٌ","وحسن جزاء عند ربكفي الأخرا",253,"ر",2,0],["ولكن لمن يسعى ويدأب عمره","وان يدع للجلى يكن ايما ندب",254,"ب",1,0],["ولكنْ لمعنًى تراهُ الكِرامُ","وذاكَ لأقضي العُلا حقَّها",255,"ق",3,0],["ولكن لا خلودَ مع المَنايا","تخطَّفُ ثم تضمَنُها القُبورُ",256,"ر",1,0],["ولكن لسان الحال أفصح ناطق","لديك وهذا الصمت أبلغ من عذر",257,"ر",1,0],["ولكن للأسف خلّصت صبري","وكفتني المحبه من عناها",258,"ا",3,0],["ولكنَّ لِي قَلبًا قَضَى اللهُ أَن يُرَى","وَفِيًّا, يُرَاعِي الحُبَّ والعَيشَ والمِلحا",259,"ح",2,0],["ولكنَّ لِي قَلبًا قَضَى اللهُ أَن يُرَى","وَفِيًّا, يُرَاعِي الحُبَّ والعَيشَ والمِلح",260,"ح",1,0],["ولكنْ للخُنُوعِ بنا حَديثٌ","إذا ما حاصَرَ اللَّيثَ القُرُودُ",261,"د",1,0],["ولكن ليس فيها من أمانٍ","إذا جاءت ثعالبُ أو قرودُ",262,"د",1,0],["ولكن له عندي شروح عجيبة","بواهر أنوار زواهر اكنان",263,"ن",1,0],["ولكن لك يفز يفز يم عالي شواهيقه","وثم ينزل بجزلات المعاني لك بكرّاته",264,"ت",2,0],["ولكنْ ليلُ أمّتِنا طويلٌ","وبين الفجرِ والآمالِ سورُ",265,"ر",1,0],["ولكن للأسف نفسي عنيدة","لها تاريخ ذكري في مجلدْ",266,"د",1,0],["ولكن لن يطول الجرحُ فينا","سيلقوا حتفهم في كل شارعْ",267,"ع",1,0],["ولكن لحسن الحظ أن البلاء لا","يضر بموفور لخير موَسَّع",268,"ع",1,0],["ولكنَّ لي عَيْنًا كَتُومًا بمائها","جَمُودًا بأيدي الناظرين انْسِجَامُهَا",269,"م",3,0],["ولكن لم يصب إلا","إناء السمن في جلد",270,"د",1,0],["ولكن لأرفع ضر الفقي","ر كأني به بعض آلاميه",271,"ي",2,0],["ولكن لأوتيَه المستح","ق ولو جف مورد أرزاقيه",271,"ي",2,0],["ولكن لعل الله ملهمكم إلى","مؤسسة تجدي عليلا ومعدما",272,"م",2,0],["ولكنْ ليسَ يحلو لي صباحٌ","إذا أخفتْ ( صباحَ الخَير ) ليلى",273,"ل",2,0],["ولكن ليس تعنيني","فلست بحفظها مبدع",274,"ع",1,0],["ولكنْ لباس الحجابِ العفافُ","ونبضُ الشهامةِ للمدّعي",275,"ع",2,0],["ولكن لم يعاودهم ووالوا","لهذا الضرب فانعكس المرام",276,"م",1,0],["ولكن ليدري أن في الربع والحمى","رماة أعدوا للمعادين أسهما",277,"م",2,0],["ولكن لتجريد أتباع محمد","أذعتم وأبديتم مقالاً محرما",278,"م",2,0],["ولكن لم تقع منهم فباءوا","لعمري بالخسار والنكال",279,"ل",1,0],["ولكن ليس يوجب أن سيدعى","ويرجى أو يخاف بكل حال",279,"ل",1,0],["ولكن لتجريد أتباع محمد","وتجريد توحيد العبادة قدما",280,"م",2,0],["ولكن َّ لي صبية ً ، دونَهم","عقدتُ المواعيدَ .. والأعْذرا",281,"ر",2,0],["ولكن للرؤوس به ارتعاش","وللأعضاء بالوهن اضطراب",282,"ب",1,0],["ولكن للأسف بانت وخابت فيكم ظنوني","وهدمتوا أجمل احلامي وخيبتوا الرجا فيكم",283,"م",1,0],["ولكنْ ليسَ في لهوٍ وَضِيعٍ","يُضيعُ العُمرَ أو فيه اعتِداءُ",284,"ا",2,0],["ولكنَّ ليْ طبع البريق بومضه","وفيضٌ من الإحساس ..لكنْ عجولُ",285,"ل",1,0],["ولكن ليعلو قدر ناظمها بها","ويبدو به من كان في الناس خافيا",286,"ي",2,0],["ولكنْ لن أموتَ كما أرادوا","سأكويهمْ بنيرانِ اصطباري",287,"ر",2,0],["ولكِنْ لَيْسَ يَخْدعُنا دَعِيٌّ","ولا نَرْضَى الحَياةَ مَع البَهِيمِ",288,"م",1,0],["وَلكِنَّ لِي أَهْلُينَ فارَقْتُ أَرْضَهُمْ","وَفِي القَلْبِ مِنْ خَوْفِ الفِراقِ وَجِيبُ",289,"ب",1,0],["وَلَكِنْ لِيَعْلَمْ كُلُّ طَاغٍ وَمُجْرِمٍ","بِأَنَّ لِدِينِ اللهِ حُرَّ الضَّيَاغِمِ",290,"م",1,0],["ولكن لأمر الله نرضى وبالقضا","نعلل منا النفس حُكماً مؤبدا",291,"د",2,0],["ولكنْ لها نفس تنوء بطيبة","وقلب كريم الطّبع ليس بغائل",292,"ل",1,0],["ولكن لا حيوة لمن تنادي","وحكم اللّه ليس بهِ كلامُ",293,"م",1,0],["ولكن لطفهُ عم البرايا","فزار ديارنا وكفى اللمامُ",294,"م",1,0],["ولكن لجنبول سوابق كلها","تحذرنا منه فجنبول ثعلب",295,"ب",1,0],["ولكنْ لاتشكّ ولو بقربي","قلوبُ العاشقينَ غدتْ رمالا",296,"ل",2,0],["وَلَكِنْ لَسْتَ مَسْؤُولًا","فَأَنْتَ هَبَاءَةُ الْعَفْرِ",297,"ر",1,0],["ولكنّ لمّا استفاض الكلام","وبان الذي قد كان",298,"ن",1,0],["ولكن لا يضيق العفو عنهم","وكيف يضيق وهو لهم معد",299,"د",1,0],["ولكنْ لحرٍّ حليفِ الندى","ويحملُ في كفِّهِ قَبَسا",300,"س",2,0],["ولكنّ ليليَ أضحى صديقاً","إذا ما ترفَعتُ عنهُ..تَوَدّدْ",301,"د",1,0],["ولكن لَم تَزدني غَير ُموتٍ","وبَعدَُ الموتِ أحيا قَبلَ نَحري",302,"ر",2,0],["ولكن للخلاص طريقَ حقٍّ","فسِرْ بالتوبِ فيهِ إن عزمتا",303,"ت",2,0],["ولكنْ لا أرى منك اْهتماماً","وإقبالا عليّ وحُسْنَ ردِّ",304,"د",1,0],["ولكنْ له وقْعٌ جميلٌ وقوَّة","لذلك صادقتُ القوافي مُعَظِّما",305,"م",2,0],["ولكنْ لستَ تضربني بتاتاً","وأبقى عاشقاً لك دُمْ غَفورا",306,"ر",2,0],["ولكن لن أعود إلى اندفاعي","بمنحي من يسائلني الودادا...",307,"د",2,0],["ولكنْ ليته يبقى أمامي","لأصقلَ منه أعظُميَ البوالي",308,"ي",1,0],["ولكن لطفه في حق رق","تجلبب حبه أبداً شعارا",309,"ر",2,0],["ولكن للنوى ابكى","وطول العهد يا املُ",310,"ل",1,0],["ولكن لو تمادى حد منّا ينقلب ضدَّه","وتتغير موازينه ويصبح شي هِبْ موجود",311,"د",1,0],["ولكن لم تكن يوما","سوى نبع لأنَاتي",312,"ت",2,0],["وَ لَكِنَّ لِيْ قَلْبًا تَأَذَّى شغَافُهُ","بِحَسْرَةِ مَفْجُوعٍ يُرَدِّدُهَا الخَفْقُ",313,"ق",1,0],["وَلَكِن لَم تُساعِدني اللَيالي","لِما يُرضي الإِخاءَ مِنَ الوِصالِ",314,"ل",1,0],["((ولكنْ لا سبيلَ إلى وصالٍ))","وأهلُ الوصل لَيْس لهمْ نصيبُ",315,"ب",1,0],["ولكن ليس نفقه علم هذا","وإنْ كان المسبح قد دعاه",316,"ا",2,0],["وَلَكِنْ لاَ سِلاَحَ لَهُ نُفُوذٌ","سِوَى قَلَمِي لإِيقَاظِ النِّيَامِ",317,"م",1,0],["ولَكِنْ.. لاَ أَقُولُ.. فَرُبَّ مَعْنًى","تَضَخَّمَ رَغْمَ إِمْعَانِ النُّحُولِ",318,"ل",1,0],["وَلَكِنْ لَيْلَ مُرْتَجِزٍ ثَقِيلٍ","يُغَنَّى فيهِ بالرَّجْزِ الثَّقِيلِ",318,"ل",1,0]]}