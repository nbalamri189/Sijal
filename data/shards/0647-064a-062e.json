{"poems":[[53,"يا أبا الصقر زادك الله في المجد","https://www.aldiwan.net/poem65411.html","الخفيف"],[53,"عسرت علينا دعوة السمك","https://www.aldiwan.net/poem65756.html","أحذ الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141969","الكامل"],[280,"أهلا بهن أهلة وكواكبا","https://www.aldiwan.net/poem25628.html","الكامل"],[463,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[543,"يا طاهر والله إنك طاهر","https://www.aldiwan.net/poem48188.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138366",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138302",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138290",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138196",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138397",""],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137339",""],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101558","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53873","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145971","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62515","الكامل"],[1141,"","https://poetry.dctabudhabi.ae/diwan/poem/130715","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95583","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48958","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48916","الكامل"],[1689,"","https://poetry.dctabudhabi.ae/diwan/poem/36161","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110330","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27299","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76051","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93896","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204460","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85051","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125824","الكامل"],[4679,"يا قراناً قد أشرق السعد فيه","https://www.poetsgate.com/ViewPoem.aspx?id=142795",""],[4680,"حنين الطين","https://www.poetsgate.com/ViewPoem.aspx?id=185077",""],[4927,"مريم","https://www.poetsgate.com/ViewPoem.aspx?id=29635",""],[5057,"الخطوة الأولى","https://www.poetsgate.com/ViewPoem.aspx?id=197231",""],[5151,"سميتها وضحاً","https://www.poetsgate.com/ViewPoem.aspx?id=184797",""],[5277,"ويك عيونها","https://www.poetsgate.com/ViewPoem.aspx?id=185705",""],[5431,"قصيدة قلقه...","https://www.poetsgate.com/ViewPoem.aspx?id=201108",""],[5431,"كوب من البن !!...","https://www.poetsgate.com/ViewPoem.aspx?id=203341",""],[5457,"هي خلف جفني","https://www.poetsgate.com/ViewPoem.aspx?id=213337",""],[5660,"وَ الوَجدُ يَربَحُ وَ النَّوى تَقتاتُ","https://www.poetsgate.com/ViewPoem.aspx?id=35775",""],[5956,"أعضاؤها لخدامتي تتسابقُ","https://www.poetsgate.com/ViewPoem.aspx?id=205481",""],[5956,"هدَّ انعطافي للرَّفاه قوايا","https://www.poetsgate.com/ViewPoem.aspx?id=210311",""],[5956,"القدِّيسة النقية تقية","https://www.poetsgate.com/ViewPoem.aspx?id=215548",""],[6113,"ذكريات....بحرجده","https://www.poetsgate.com/ViewPoem.aspx?id=36932",""],[6225,"سلمت مصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80916&r=&rc=185",""]],"verses":[["هي خرقاء حين تعطي وكانت","حين تستخرج الخراج الصناعا",0,"ع",2,0],["هي خِلْعَةٌ ليست بباقيةٍ","كالخزِّ والسمَّورِ والفنكِ",1,"ك",1,0],["هي خطرةٌ أو نظرةٌ ودرجتما","في جوفِ عاصفةٍ من النيرانِ",2,"ن",1,0],["هي خطبةٌ للموت أروعُ ما بها","أن الخطيبَ ولا خطابَ أجادا",3,"د",2,0],["هِيَ خِدْمَةٌ أدّيْت حَقّاً لازِماً","مِنْ وَصْفِها وقَضَيْت فَرْضاً واجِبا",4,"ب",2,0],["هي خيرُ أهلِ زمانِها","بيتاً وأنتَ خِيارُها",5,"ر",3,0],["هي خيرُ أيامِ الحَياةِ وحَقِّكم","قُضِيَت بِهنَّ مناسكٌ ومَشاعرُ",6,"ر",1,0],["هي خير آنسة تزف لا مجدس","ان عُدَّ أهل الفضل كان الافضلا",7,"ل",2,0],["هي خير جوهرة يعزِّ نظيرها","وتكاد لا تلفى لتلك نظائرا",8,"ر",2,0],["هي خير ما اتصفت به علماؤنا","من زينتهم فطنة وشعور",9,"ر",1,0],["هي خير منهاج لمتبع الهدى","ومحجةٌ محفوفة بضياء",10,"ا",2,0],["هي خير فضلى عندها لا يستوى","مثل الكثير محلل ومحرّم",11,"م",1,0],["هي خطت والنصر طوعٌ لما خط","طت وربُّ النصر العزيزُ القدير",12,"ر",1,0],["هيَ خمسةٌ في ستَّةٍ","او سبعةٌ بثمانيه",13,"ي",2,0],["هي خِطّةٌ كان الهناءُ لها بِهِ","أهمَّ لِمَا نالتْ به مِنْ تَقَدُّمِ",14,"م",1,0],["هِيَ خيمةُ الدُنيا بما","فيها وَأعظمَهَا جَلالا",15,"ل",2,0],["هي خِلسةٌ نامت عيون الدهر عن","ها فهي منه تُهدّ من آلائه",16,"ا",3,0],["هي خلعة خلعت قلوب حواسد","لكن بها أحبابكم تستبشر",17,"ر",1,0],["هي خير آلات الريا","ضة فى المزايا والمظاهر",18,"ر",1,0],["هي خمرةُ الإخلاصِ يَعصرها","في القلبِ خمّارٌ هو الأَدبُ",19,"ب",1,0],["هي خطوة في سُلّم الدنيا فلا","تتهوروا بسلوك هذا المِصعد",20,"د",1,0],["هيَ خَمرةُ الحُبِّ القَديمِ وَمُنتَهى","غَرض النَديم فَنعم ذاكَ الراحُ",21,"ح",1,0],["هي خاطر الادهار في أسرارها","وربيبة الأمراء في غمدانها",22,"ن",3,0],["هي خيرٌ من ألفِ شهرٍ وإني","أنا خيرٌ منها بغير زمان",23,"ن",1,0],["هِيَ خَلقُهُ حَقًّا وأفعَالٌ لَهُم","حَقًّا وَلاَ يَتنَاقَضُ الأمرَانِ",24,"ن",1,0],["هِيَ خَمسَةٌ مَعلُومَةٌ بِالعَدِّ وَال","حُسبَانِ فاطلُبهَا مِنَ القُرآنِ",24,"ن",1,0],["هِيَ خَلقٌ وَلَيسَ يَعلمُ خَلقٌ","كُنهَها إِنَّها عَجيبٌ فَعالا",25,"ل",2,0],["هي خود وشاحها من جمال","وعليها من البها إكليل",26,"ل",1,0],["هي خرساء لا بنطقٍ تؤدي","ما أرادت ولا بلمح تفيد",27,"د",1,0],["هي خمر الشهود فاجتلها","لا خمور المحجب إلا فيك",28,"ك",1,0],["هي خمرةُ الشعب الأبِّي إذا انتشى","منها عدا نحو المعالي واثبا",29,"ب",2,0],["هي خودٌ فريدة في المزايا","ولأنت الفريد علماً وحزما",30,"م",2,0],["هي خطوةٌ حيرى مداها لم يزل","ينأى بعيداً عن نوازع ذاتي",31,"ت",2,0],["هِيَ خَلْجَةٌ فِي الْقَلْبِ أَعْمَىْ سِرُّهَاْ","أَهْلَ الْملاْمَةِº فَاسْتَشَاْطَ اللُّوَّمُ",32,"م",1,0],["هي خطوةٌ أولى وهذا آنُهَا","فدعِ الهوى وأفِق مِنَ التخديرِ",33,"ر",1,0],["هي خيمةٌ غَطَّى الصَحَارى شالُها","فاستَيقَظت مُدُنٌ ومَيتٌ قد صَحا",34,"ح",2,0],["هي خمرةٌ وكؤوسِها من ثغرها","طربتْ لرشُفِ لذيذهن الراحُ",35,"ح",1,0],["هي خارج الأبعاد لبوته","مذ كان طيف النار معتنقه",36,"ق",2,0],["هي خمسةٌ والذوق أكملها!","ولذاذة الأشواق في رشفةْ!",37,"ف",2,0],["هي خلفَ جفني تستقرُ وفي السما","وغيابها عن ناظريّ محالُ",38,"ل",1,0],["هي خِنجَرٌ أَشواقُنا بِقُلوبِنا","هِي فَيصَلٌ مُستَرسِلٌ وَ قَناةُ",39,"ه",1,0],["هي خير أرزاقي حماها الرازقُ","أعضاؤها لخدامتي تتسابقُ",40,"ق",1,0],["هي خير أرزاق لنا وهداية","أن نستحبَّ عقارباً وحيايا",41,"ا",3,0],["هي خير أنثى لي تعيش ونسلِها","حرصتْ على أن لا نكون ضحايا",41,"ا",3,0],["هي خيرُهنّ من النساءِ القانتا","ت تصرفا وإدارة ونوايا",41,"ا",3,0],["هي خير أنثى قاومتْ رغباتها","وتفرغتْ لصيامها وصلاتِها",42,"ت",3,0],["هي خذت قلبي وهي عيت ترده","واذكراني ماعرفت اللي تريده",43,"د",2,0],["هي خلقٌ أقام ، والأرضُ تسقي","شجراتِ الهلام عِزًّا وجاها",44,"ا",3,0]]}