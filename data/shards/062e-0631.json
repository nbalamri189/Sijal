em22317.html","الطويل"],[46,"كنت الفقير فخطئت لك صيب","https://www.aldiwan.net/poem22804.html","الكامل"],[15,"لمن الدار أقفرت بالجناب","https://www.aldiwan.net/poem45282.html","الخفيف"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[76,"خرجت أجتاز قفرا غير مجتاز","https://www.aldiwan.net/poem39289.html","البسيط"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85538","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39546","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39567","الخفيف"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9938","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9881","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42602","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42658","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42670","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55119","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54712","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54933","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54850","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142048","الرمل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12549","الكامل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1912","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54304","الرمل"],[106,"زامر الحي","https://www.poetsgate.com/ViewPoem.aspx?id=179525",""],[50,"تثاقل ليلي فما أبرح","https://www.poetsgate.com/ViewPoem.aspx?id=21636",""],[90,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"ماهذه النفوس قداح","https://www.poetsgate.com/ViewPoem.aspx?id=178947",""],[54,"خَرَجتُ مُبكِّراً مِنْ سُرَّ","https://www.poetsgate.com/ViewPoem.aspx?id=14269",""],[45,"أفي كُلّ دارٍ مِنكَ عَينٌ تَرَقْرَقُ","https://www.poetsgate.com/ViewPoem.aspx?id=32846",""],[45,"قُلْ للخَيالِ، إذا أرَدتَ، فعَاوِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=32882",""],[45,"طافَ الوُشاةُ بهِ، فصَدّ وَأعْرَضَا","https://www.poetsgate.com/ViewPoem.aspx?id=31129",""],[38,"عفتْ بعدنا أجراعُ بكرٍ فتولبِ","https://www.poetsgate.com/ViewPoem.aspx?id=21244",""],[38,"وَمَنْ يَكُ بَادِياً وَيَكُنْ أَخَاهُ","https://www.poetsgate.com/ViewPoem.aspx?id=21223",""],[51,"شابَ رأسي ولات حينَ مَشيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=26854",""],[31,"ودعْ لبابة َ قبلَ أن تترحلا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19018&r=&rc=281",""],[3,"ظعنَ الذينَ فراقهم أتوقعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10713&r=&rc=67",""]],"verses":[["خَرَجتُ أَجُرُّ الذَيلَ مِنها وَقَد نَزَت","قُلوبُ العِدا مِنّي وَجُنَّ جَنانُها",0,"ن",3,0],["خَرّاجَةِ الصَدرِ إِن صاحَ المُهيبُ بِها","عَلى الوَجى مِن صُدورِ الأَينُقِ الرُسُمِ",1,"م",1,0],["خَرَقنا مَعَ الشَمسِ تِلكَ الفَلاةِ","وَجُبنا مَعَ اللَيلِ طِلكَ الأَكَم",2,"م",1,0],["خَرّوا عَلى شُعَبِ الرِحالِ وَأَسنَدوا","أَيدي الطِعانِ إِلى قُلوبٍ تَخفِقُ",3,"ق",1,0],["خُرسٌ قَد اِعتَنَقوا الصَفيحَ وَطالَما اِع","تَنَقوا الصَفائِحَ وَالدِماءُ جَوارِ",4,"ر",1,0],["خُرسُ البُغامِ تَرُدُّ الصَوتَ كاظِمَةً","وَقَد تَصاعَدَ مِن أَعناقِها الجِرَرُ",5,"ر",1,0],["خَرَجَت خُروجَ الريمِ عاطِلَةً","وَلِجيدِها حَليٌ مِنَ الجَيدِ",6,"د",1,0],["خَرساءَ ظاهِرَةِ الأَداةِ كَأَنَّه","نارٌ يُشَبُّ وُقودُها بِلَظاها",7,"ا",3,0],["خَرَجتُ إِلى القَرمِ الكَمِيِّ مُبادِر","وَقَد هَجَسَت في القَلبِ مِنّي هَواجِسي",8,"س",2,0],["خَرَجنا شَباباً ذَوي نَجدَةٍ","لِنَلهو عَلَيها بِضَربِ الكُرينا",9,"ن",2,0],["خُروجي بَعدَما أَبلَيتُ عُذراً","وَلَم أَجِدِ السَبيلَ إِلى المُقامِ",10,"م",1,1],["خَرَجَت وَلَم أَشعُر بِذاكَ فَلَيتَني","كُنتُ الجِنازَةَ وَهيَّ فيمَن يَتبَعُ",11,"ع",1,0],["خُرقاً إِذا راضَ الأُمورَ بِنَفسِهِ","مِثلَ العَدوِّ لَها يُريدُ هَلاكَها",12,"ك",3,0],["خَرَجتَ مَع العَوراءِ تَلتَمِسُ الهُدى","وَكانَ الهُدى فيما تَرَكتَ عَلى عَمدِ",13,"د",1,0],["خُرِبَت بُيوتُ نَبيطَةٍ فَكَأَنَّما","لَم تَلقَ بَعدَكَ عامِراً مُتَعَهِّدا",14,"د",2,0],["خَرجاءُ جَوَّفَها بَياضٌ داخِلٌ","لِعِفائِها لَونانِ فَهُوَ خَصيفُ",15,"ف",1,0],["خَرَجَت أُمَّةٌ تُشَيِّعُ نَعشاً","قَد حَوى أُمَّةً وَبَحراً عُبابا",16,"ب",2,0],["خَرَجَ الغَواني يَحتَجِج","نَ وَرُحتُ أَرقُبُ جَمعَهُنَّه",17,"ن",2,1],["خَرَجتَ تَبغي أذاها في محمَّدها","وللحَنيفةِ جَبّارٌ يُواليها",18,"ي",3,0],["خَرَجتَ بِهِ عَن طَوقِ كُلِّ مُصَوِّرٍ","يُجيدُ دَقيقَ الفَنِّ في جَوفِ مَصنَعِ",19,"ع",1,0],["خَرَقَ العاداتِ مُبدي صورَةٍ","حَشَدَ الحُسنُ عَلَيها فَاحتَفَل",20,"ل",1,0],["خَرَجتُ بِها أَمشي تَجُرُّ وَراءَن","عَلى أَثَرَينا ذَيلَ مِرطٍ مُرَحَّلِ",21,"ل",1,0],["َخَرقٍ كَأَنضاءِ القَميصِ دَوِيَّةٍ","مَخوفٍ رَداهُ ما يُقيمُ بِهِ رَكبُ",22,"ب",1,1],["خَرَجُوا لِيَسْتَجْلُوا طَلِيعَةَ مَجْدِهِمْ","فِي رَكْبِهِ المَحْفُوفِ بِاللَّمَعَانِ",23,"ن",1,0],["خَرْسَاءُ أَوْ هَدَّارَةٌ فِي سَيْرِهَا","جَرَّافَةٌ بِالعُنْفِ أَوْ بِاللِّينِ",24,"ن",1,0],["خَرَجَتْ تُشَيِّعُهُ وَسَارَ بِرَمْزِهِ","مَنْ فَاتَهُ التَّشْيِيعُ لِلْجُثْمَانِ",25,"ن",1,0],["خَرِقٌ عَلى جُلَسائِهِ فَكَأَنَّهُم","حَضَروا لِمَلحَمَةٍ وَيَومِ جِلادِ",26,"د",1,0],["خَرَجتُ مُبَكِّراً مِن سُرَّ مَن را","أُبادِرُ حاجَةً فَإِذا عُمَيرُ",27,"ر",1,1],["خَروجٌ مِنَ الخَرقِ البَعيدِ نِياطُهُ","وَفي الشَولِ نامي خَبطَةِ الطَرقِ ناجِلُه",28,"ل",2,0],["خَراعيبُ أُملودٍ كَأَنَّ بَنانَها","بَناتُ النَقا تَخفَى مِراراً وَتَظهَرُ",29,"ر",1,0],["خرجوا لها الجمَّ الغفيرَ وكلُّهم","متعجَب من لطف صنع الباري",30,"ر",2,0],["خرج الناس يهرعون احتفاءً","بقدوم الأمير غير الأمير",31,"ر",1,1],["خرجت بعيد النحر صبحاً فلاح لي","مسارح للأضداد فيهنّ مرتع",32,"ع",1,0],["خرجت وقرص الشمس قد ذَرّ شارقاً","ترى النور سيّالاً به يتدفّع",32,"ع",1,0],["خرقت يا علم رداء لنا","كنا ارتديناه فِهل ترقع",33,"ع",1,0],["خرجت من ظلمة لأخرى","فما أمامي وما ورائي",34,"ا",2,0],["خَرَجتَ مِنَ المَدينَةِ غَيرَ عَفٍّ","وَقامَ عَلَيكَ بِالحَرَمِ الشُهودُ",35,"د",1,0],["خِربانَ صَيفٍ نَفَّشَت أَعرافَها","عايَنَّ أَسفَعَ مُلحَماً مِبكارا",36,"ر",2,0],["خَرَجتَ مِنَ العِراقِ وَأَنتَ رِجسٌ","تَلَبَّسُ في الظِلالِ ثِيابَ غولٍ",37,"ل",1,0],["خَروجٍ بِأَفواهِ الرُواةِ كَأَنَّها","قَرا هُندُوانِيٍّ إِذا هُزَّ صَمَّما",38,"م",2,0],["خرجت لهم تمشي البراح ولم تكن","كمن حِصْنه فيه الرتاج المضَبَّبُ",39,"ب",1,1],["خريع دَوَادِيَّ في ملعبٍ","تأزَّرَ طوراً وتلقى الأزارا",40,"ر",2,0],["خرجت خروج القدح قدح ابن مقبل","على الرغم من تلك النوابح والمشلي",41,"ي",1,0],["خُرُقٌ مَعازيلٌ إِذا جَدَّ الوَغى","بُطُنٌ إِذا ما جارُهُم لَم يَشبَعِ",42,"ع",1,0],["خُرَّهِيٌّ من الملوك أديبٌ","لم يزل ملجأً لكل أديبِ",43,"ب",1,0],["خرجتُ مُوازِنَكُم بالسوا","ءِ عُذراً بعذرٍ فلا مَعْتِبَهْ",44,"ب",2,0],["خِرْقٌ حَوَتْ يدُهُ مُلْكاً فجادَ به","فأصبح الملك ملكاً غير مُغتصَبِ",45,"ب",1,0],["خَرُقْتَ فجمَّشْتَهُ بالهجاء","وأُنْسِيتَ كثرةَ خطَّابِهِ",46,"ب",2,0],["خَرَّبتَها بالأيور النازلاتِ بها","فقال أخطأت بل لو عُطِّلت خَربتْ",47,"ت",1,0],["خرّاجةٌ للفسقِ دخّالةٌ","تُعجِبُها الدخلةُ والخرجَهْ",48,"ج",2,0],["خِرقٌ به نشوةٌ من أريحيَّتِهِ","هيهات من منْتشيها أن يقال صحا",49,"ح",2,0],["خِرْقٌ إذا استَنْجَدْتَ معروفه","جاءك نصرُ الله والفتحُ",50,"ح",1,0],["خِرْقٌ تراه بفعل الغيث مقتدياً","والغيثُ يُنعِم حتى يُعشِب المَدَر",51,"ر",1,0],["خِرْقٌ يحاجز بالإجبار عاذلَهُ","ولا يحاجز ممتاحاً بإجبار",52,"ر",1,0],["خِرْتُ فأملتُ ما لديك فعو","قِبْتُ بفوتِ النجاح والظفرِ",53,"ر",1,0],["خرجن يُبارينَ الربيع وروضَهُ","بما هُنَّ من تلك البُرودِ لوابس",54,"س",1,0],["خِرق إذا أسنى أفاعيلَهُ","قال لِمُسني شكرِه خسِّس",55,"س",1,0],["خرقٌ لأهوال الدجى مُتدرِّعٌ","في بحر كلِّ هجيرةٍ غوّاص",56,"ص",1,0],["خِرقٌ له كف يكون سماحها","كرماً إذا كان السماح ولوعا",57,"ع",2,0],["خرق يعم ولا يخص بفضله","لكنه كالغيث في الإطباق",58,"ق",1,0],["خِرْقٌ يشحُّ على صُغَرى محامِدِهِ","كيما يشح على كُبرى طوائلِهِ",59,"ل",2,0],["خرجا