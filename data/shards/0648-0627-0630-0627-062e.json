{"poems":[[53,"يا ذاكر النعماء إن نسيت","https://www.aldiwan.net/poem30191.html","الكامل"],[55,"يا قلب ما لك لا تناهى","https://www.aldiwan.net/poem26038.html","مجزوء الكامل"],[9,"يوم قفت حمولهم فتولوا","https://www.aldiwan.net/poem21960.html","الخفيف"],[86,"إن عضيك يا أخي بالملام","https://www.aldiwan.net/poem68843.html","الخفيف"],[86,"أخرق الدف لو رأيت شكيبا","https://www.aldiwan.net/poem68871.html","الخفيف"],[93,"عفوكم ما تقدمي إقدام","https://www.aldiwan.net/poem11087.html","الخفيف"],[93,"رأفة بها الدعاة الكرام","https://www.aldiwan.net/poem11369.html","الخفيف"],[41,"حي التي أقصى فؤادك حلت","https://www.aldiwan.net/poem42379.html","الكامل"],[37,"وإذا خاف مغبة أمر","https://www.aldiwan.net/poem7077.html","الخفيف"],[51,"لا تقصدن لحاجة","https://www.aldiwan.net/poem64582.html","مجزوء الكامل"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[51,"سئل الأير ما تريد إلى الكعثب","https://www.aldiwan.net/poem65932.html","الخفيف"],[91,"أنا إن أغمض الحمام جفوني","https://www.aldiwan.net/poem62792.html","عموديه"],[85,"صداح يا ملك الكنار","https://www.aldiwan.net/poem7144.html","مجزوء الكامل"],[85,"ولد الهدى فالكائنات ضياء","https://www.aldiwan.net/poem20977.html","الكامل"],[85,"قم حي هذي النيرات","https://www.aldiwan.net/poem63775.html","مجزوء الكامل"],[56,"احل وامرر معا ولن تارة واخشن","https://www.aldiwan.net/poem58528.html","البسيط"],[43,"أمن ازديارك في الدجى الرقباء","https://www.aldiwan.net/poem9445.html","الكامل"],[43,"مالنا كلنا جو يا رسول","https://www.aldiwan.net/poem9980.html","الخفيف"],[45,"نفست قربها علينا كنود","https://www.aldiwan.net/poem62739.html","الخفيف"],[45,"أتراك تسمع للحمام الهتف","https://www.aldiwan.net/poem65160.html","الكامل"],[45,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[45,"ريح الشمال أتت بريح شمال","https://www.aldiwan.net/poem65636.html","الكامل"],[28,"أعرفت بين رويتين وحنبل","https://www.aldiwan.net/poem5251.html","الكامل"],[61,"عندي إذا مالروض أصبح ذابلا","https://www.aldiwan.net/poem51487.html","الكامل"],[61,"هذه الشمس أوشكت أن تغيبا","https://www.aldiwan.net/poem51805.html","الخفيف"],[49,"قطعت منك حبائل الآمال","https://www.aldiwan.net/poem63049.html","الكامل"],[66,"خذ من الدهر لي نصيب","https://www.aldiwan.net/poem41371.html","مجزوء الخفيف"],[66,"بلغي الأحباب يا ريح","https://www.aldiwan.net/poem41564.html","مجزوء الرمل"],[80,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[44,"أطلالهم سلبت دماها الهيفا","https://www.aldiwan.net/poem30403.html","الكامل"],[50,"يا دار أقوت بالأجالد","https://www.aldiwan.net/poem63942.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85489","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140863",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[45,"قُلْتُ للاّئِمِ في الجُبّ أفِقْ","https://www.poetsgate.com/ViewPoem.aspx?id=32850",""],[128,"هاكم من أخى وداد سلاما","https://www.aldiwan.net/poem50527.html","الخفيف"],[128,"إني لأعلم لا أزال معلما","https://www.aldiwan.net/poem50679.html","الكامل"],[132,"لمعان البروق هاج الهموما","https://www.aldiwan.net/poem54745.html","الخفيف"],[182,"في الركب بين هوادج الآرام","https://www.aldiwan.net/poem67034.html","الكامل"],[185,"شكري لقربك واشتياق","https://www.aldiwan.net/poem14608.html","مجزوء الرمل"],[223,"تسأل الغيب أن يريها المصيرا","https://www.aldiwan.net/poem41609.html","الخفيف"],[250,"خلني من ملامة اللوام","https://www.aldiwan.net/poem15034.html","الخفيف"],[251,"درة العشاق","https://www.aldiwan.net/poem65127.html","عموديه"],[261,"جرب الناس مرارا","https://www.aldiwan.net/poem38187.html","مجزوء الرمل"],[276,"هل عند عمرة من بتات مسافر","https://www.aldiwan.net/poem2239.html","الكامل"],[284,"قد مررنا بمالك فوجدناه","https://www.aldiwan.net/poem44342.html","الخفيف"],[297,"لمن العيس لها في البيد نفح","https://www.aldiwan.net/poem33307.html","الرمل"],[304,"خذ ما صفا ودع الكدر","https://www.aldiwan.net/poem16879.html","مجزوء الكامل"],[309,"ذهب الذين أحبهم","https://www.aldiwan.net/poem50323.html","مجزوء الكامل"],[353,"أشرقت تتلو الهنا شمس التهاني","https://www.aldiwan.net/poem39777.html","الرمل"],[371,"يرمي فلا أتحيد","https://www.aldiwan.net/poem57507.html","مجزوء الكامل"],[403,"عبر الصبا سحرا بكيرة حاجر","https://www.aldiwan.net/poem33917.html","الكامل"],[403,"قد أصبتم يا سيدي بالجواب","https://www.aldiwan.net/poem34148.html","الخفيف"],[409,"إن خان عهدك من توده","https://www.aldiwan.net/poem32602.html","مجزوء الكامل"],[441,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[443,"في إثر سعيد يا أسعد","https://www.aldiwan.net/poem55931.html","عموديه"],[449,"رثاء جمال عبد الناصر","https://www.aldiwan.net/poem979.html",""],[458,"سافر بطرفك واشترف هل تعرف","https://www.aldiwan.net/poem56112.html","الكامل"],[458,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[461,"جرد سيوفك للجلاد وأشهر","https://www.aldiwan.net/poem15128.html","الكامل"],[461,"عشت قطب الدين هطال الندى","https://www.aldiwan.net/poem16432.html","الرمل"],[464,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[551,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[551,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[551,"من ذا الذي ينجو من الآجال","https://www.aldiwan.net/poem47273.html","الكامل"],[551,"ليس للقلب في السلو نصيب","https://www.aldiwan.net/poem48092.html","الخفيف"],[567,"لصديق لنا صديقة سوء","https://www.aldiwan.net/poem69465.html","الخفيف"]],"verses":[["وَإِذا خِناقُ الكَربِ ضاقَ بِنا","رَدّوا النُفوسَ وَرَدَّدوا النَفَسا",0,"س",2,0],["وَإِذا خَضَعتُ بِمُقلَتي","مُتَتَبِّعاً مِنها رِضاها",1,"ا",3,0],["وَإِذا خافَتِ السِباعَ مِنَ الغي","لِ وَأَمسَت وَحانَ مِنها اِنطِلاقُ",2,"ق",1,0],["وَإِذا خانَ قِسمُنا ما شَكَونا","لِسِوى اللَهِ أَعدَلِ القُسّامِ",3,"م",1,0],["وَإِذا خِفتَ ما يُخافُ مِنَ اليَم","مِ فَرَشنا لِأَخمَصَيكَ القُلوبا",4,"ب",2,0],["وإذا خص بالرذيئة شعب","فلقد عم بالبلاء الأنام",5,"م",1,0],["وَإِذَا خَصَّ بِالرَّزِيئَةِ شَعْبٌ","فَلَقَدْ عَمَّ بِالبَلاءِ الأَنْامُ",6,"م",1,0],["وَإِذَا خَرَجتَ بَكَت عَلَيكَ صَبَابةً","حَتَّى تَبُلَّ دُموعُها مَا بَلَّتِ",7,"ت",1,0],["وإذا خاف مَغَبَّةَ أمر","حَقَباً أن يلاقي التصديرا",8,"ر",2,1],["وإذا خلا من مَغرمٍ","ضخمٍ فذلك يومُ وَكسه",9,"س",2,0],["وإذا خطا أعياه ثقْل مؤَزَّرٍ","يرتَجُّ تحت موشَّحٍ ميّاس",10,"س",1,0],["وإذا خَسَّ في المعاشر قدْري","فلديها يجلُّ قدْري وينبُلْ",11,"ل",1,0],["وَإِذا خُفتِ أَن يَثورَ بِكِ الوَجدُ","فَتَبدو أَسرارُنا المَكنونَه",12,"ن",2,0],["وإذا خطرت على الملا","عب لم تدع لممثل",13,"ل",1,0],["وَإِذا خَطَبتَ فَلِلمَنابِرِ هِزَّةٌ","تَعرو النَدِيَّ وَلِلقُلوبِ بُكاءُ",14,"ا",2,0],["وَإِذا خَطَبتَ فَلا تَكُن","خَطباً عَلى مِصرَ الفَتاةِ",15,"ت",3,0],["وإذا خِفْتَ أَنْ يُراهِقَكَ العُدْ","مُ فَعُذْ بالمُثَقّفاتِ العَوالي",16,"ل",2,0],["وَإِذا خَفيتُ عَلى الغَبِيِّ فَعاذِرٌ","أَن لا تَراني مُقلَةٌ عَمياءُ",17,"ا",2,0],["وَإِذا خامَرَ الهَوى قَلبَ صَبٍّ","فَعَلَيهِ لِكُلِّ عَينٍ دَليلُ",18,"ل",1,0],["وَإِذا خُبِّرَت بِظاهِرِ شَكوي","هانَ عِندَ الصَحيحِ أَنّي عَميدُ",19,"د",1,0],["وَإِذا خِطابُ القَومِ في الخَطبِ اِعتَلى","فَصَلَ القَضِيَّةَ في ثَلاثَةِ أَحرُفِ",20,"ف",1,0],["وَإِذا خالَفَ أَصلاً فَرعُهُ","كانَ شَنّاً لَم يُوافِقهُ طَبَق",21,"ق",1,0],["وَإِذا خَلَوتُ وَلَم أَجِد لي مُسعِداً","إِلّا الشُؤونَ بِساجِمٍ هَطّالِ",22,"ل",1,0],["وَإِذا خَرَجنَ يَعُدنَ أَهلَ مُصابَةٍ","كانَ الخُطا لِسِراعِها الأَشبارُ",23,"ر",1,0],["وإذا خلوتَ بهنَّ ظمآنَ الحَشا","مَنَحتكَ من صَوبِ العُقولِ مَناهِلا",24,"ل",2,0],["وإذا خاضَ غَمرةَ الموتِ رَدَّ السْ","يْفَ من غَمرةِ الدِّماءِ خَضيبا",25,"ب",2,0],["وَإِذا خَشيتَ تَعَذُّراً في بَلدَةٍ","فَاِشدُد يَدَيكَ بِعاجِلِ التَرحالِ",26,"ل",1,0],["وَإِذا خابَتِ الظُنون","عِندَهُ يَصدُقُ الرَجا",27,"ج",2,0],["وَإِذا خاطَبَكِ الجا","هِلُ بي قَولي سَلاما",28,"م",2,0],["وإذا خافَ من شجاعٍ جبَانٌ","غَالَهُ منه جاهداً ما يَغولُ",29,"ل",1,0],["وَإِذا خَلائِقُهُم نَبَت أَو أَجدَبَت","أَنشَأتَ تَمهَدُ لي خَلائِقَ ريفا",30,"ف",2,0],["وَإِذا خَشيتَ مُحيطَةً","مِن وارِقِ الجَهَلاتِ زائِد",31,"د",1,0],["وإذا خلت منها فإن","نَ خلوها إحدى المصائب",32,"ب",1,0],["وإذا خفيت على الغبي فعاذرٌ","ألا تراني مقلةٌ عمياء",33,"ا",2,0],["وإذا خاف من حساب عسير","ذو ثراء، فما أخفَّ حسابه!",34,"ب",2,0],["وإذا خَالَفَ أصْلاً فَرْعُهُ،","كانَ شَنَّا لمْ يُوَافِقْهُ الطَّبَقْ",35,"ق",1,0],["وإذا خُوطبوا بجهلٍ يصونُوا","عنه أعراضَهم وقالوا سلامَا",36,"م",2,0],["وإذا خليلَتُه أبَتْ عن رأيهِ","نزلَ الشِّقاقُ وحان كل شقاءِ",37,"ا",2,0],["وإِذَا خِلتُ أَن غَدَوتُ سَلِيمَا","مِنَ أَلِيمِ الغَرامِ صِرتُ سَلِيمَا",38,"م",2,0],["وَإِذا خَشيتِ عَلى الصَبابةِ سَلوةً","فَتَعَوَّذي بِجَمالهم وَغَرامي",39,"م",2,0],["وإذا خضعتُ لحادثٍ","حَلَّت مكارمُه وَثاق",40,"ق",1,0],["وَإِذا خَيَّمَ الدُجى سَأَلتَهُ","بَعضَ نور فَلا تَرى فيهِ نورا",41,"ر",2,0],["وإذا خفت من أثامِ فعَفوُ اللَه","لا يُرتَجى لغير الاثامِ",42,"م",1,0],["واذا خرجت الى الأنام كأنّما","ملك كريم سار في الأسواق",43,"ق",1,0],["وإذا خاطبك الجاهل","جهلاً قل سلاما",44,"م",2,0],["وَإِذا خَليلُكَ لَم يَدُم لَكَ وَصلُهُ","فَاِقطَع لُبانَتَهُ بِحَرفٍ ضامِرِ",45,"ر",1,0],["وَإِذا خُبزُهُ سَيَكفيكَهُمُ","اللَهُ ما بَدا ضوءُ نَجمِ",46,"م",1,0],["وَإِذا خاتَمَ النَبِيِّ سُلَيمانُ","بنُ داوودَ قَد عَلاهُ بِخَتمِ",46,"م",1,0],["وإِذا خابَ لراجٍ أَملٌ","فَلَه عند رَسول اللَهِ نُجحُ",47,"ح",1,0],["وإذا خصصت بنعمة","فاشكر لها مع من شكر",48,"ر",1,0],["وَإِذا خَبا وَغر الصُدو","رِ فَلا يَزالُ بِهِ يُشِبُّه",49,"ب",2,0],["وَإِذا خطَّ فَلا أُقسمُ بِال","قَلم الصادر عَن تِلكَ البَنانِ",50,"ن",1,0],["وإذا خَمِرتُ فعندَه","بردٌ به أتبرَّدُ",51,"د",1,0],["وإذا خلوت مفكراً فبذكرهم","هيهات يخطر غيرهم في خاطري",52,"ي",1,0],["وإذا خاف شؤم حبس وقصر","ودفاعاً عنا من الحجّاب",53,"ب",1,0],["وإذَا خضعتَ لمن يخُو","نُكَ فالإبَاءُ لِمَن تُعِدُّهْ",54,"د",2,0],["وإذا خبت منها البروق أثارها","من نفخ باكرة الصبا ولواها",55,"ه",2,0],["وإذا خاضا في فن ما","جاء بالمضعف والمسند",56,"د",1,0],["وإذا خلت نفسي إلي فإنني","استشعر العزم الذي يتضعضع",57,"ع",1,0],["وإذا خلطتَ فتىً بودّك لم يكد","كرماً صديقُك من شقيقك يُعرَفُ",58,"ف",1,0],["وإذا خِلاط الأمرِ سُدَّ طريقُه","فلديك واضحةٌ له وقرارُ",59,"ر",1,0],["وإذا خَبَتْ نارُ اليَفاع فَنارُه","تهدي ركابَ الخابطِ المُتنور",60,"ر",1,0],["وإذا خَيْلُكَ أظْماها الوَغى","طَوَتِ الوِرْدَ النَّميرَ الشَّبِما",61,"م",2,0],["وإذا خفَّ مدَّعي الحبِ سمعاً","لم يكن حاملاً من الحبّ ثِقلا",62,"ل",2,0],["وَإِذا خَطاك الدّهرُ لم يجتزْ بما","لا نرتضيه فما عليه ملامي",63,"ي",1,0],["وإذا خصالُ السّوءِ باعَدْن اِمرءاً","عن قومه لم تُدنِهِ أرحامُهُ",64,"م",2,0],["وإذا خليلي لم أُطِقْ فعلاً به","يكفي الرّدى زوَّدتُه أقوالي",65,"ي",1,0],["وَإِذا خِيفَتِ الغيوبُ فلا خِي","فتْ عليكم مدى الزّمان الغيوبُ",66,"ب",1,0],["وَإِذَا خَانَ أَنْ تُوَدِّعَ وَارَتْ","نَايَهَا فِي اليَسَارِ مِنْ مِنْخَرَيْهَا",67,"ي",3,0]]}