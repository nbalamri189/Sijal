3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130090","الكامل"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35841","الرجز"],[3492,"","https://poetry.dctabudhabi.ae/diwan/poem/111585","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62924","الطويل"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26976","الكامل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117965","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114310","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102981","الخفيف"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143856","الرمل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125899","الرمل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35093","الكامل"],[4728,"الجد والغي","https://www.poetsgate.com/ViewPoem.aspx?id=176883",""],[4744,"هذا العقيق وذي ربا أزهاره","https://www.poetsgate.com/ViewPoem.aspx?id=131549",""],[4755,"التَّمِيمة","https://www.poetsgate.com/ViewPoem.aspx?id=208979",""],[4830,"سلاماً ياعِراق","https://www.poetsgate.com/ViewPoem.aspx?id=207947",""],[5038,"طوق الحمام","https://www.poetsgate.com/ViewPoem.aspx?id=189986",""],[5185,"عبّاد الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=72892",""],[5358,"فقدان ذاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=135",""],[5460,"أمنن علىّ بقلة الودّ","https://www.poetsgate.com/ViewPoem.aspx?id=200726",""],[5616,"أحوال","https://www.poetsgate.com/ViewPoem.aspx?id=205244",""],[5616,"حينما التقيك","https://www.poetsgate.com/ViewPoem.aspx?id=207395",""],[5879,"هل بدلت أرقام هاتفها؟","https://www.poetsgate.com/ViewPoem.aspx?id=215457",""],[5939,"ليلى وأخواتها","https://www.poetsgate.com/ViewPoem.aspx?id=190078",""],[5956,"سؤال وجواب على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183228",""],[6023,"من كان في لُقياه لا يتودّد","https://www.poetsgate.com/ViewPoem.aspx?id=123861",""],[6125,"وإذا خلوتُ رأيتُ وجهكِ في السَّما","https://www.poetsgate.com/ViewPoem.aspx?id=210956",""],[6314,"غزل أحمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88066&r=&rc=1",""]],"verses":[["وَإِذا خِناقُ الكَربِ ضاقَ بِنا","رَدّوا النُفوسَ وَرَدَّدوا النَفَسا",0,"س",2,0],["وَإِذا خَضَعتُ بِمُقلَتي","مُتَتَبِّعاً مِنها رِضاها",1,"ا",3,0],["وَإِذا خافَتِ السِباعَ مِنَ الغي","لِ وَأَمسَت وَحانَ مِنها اِنطِلاقُ",2,"ق",1,0],["وَإِذا خانَ قِسمُنا ما شَكَونا","لِسِوى اللَهِ أَعدَلِ القُسّامِ",3,"م",1,0],["وَإِذا خِفتَ ما يُخافُ مِنَ اليَم","مِ فَرَشنا لِأَخمَصَيكَ القُلوبا",4,"ب",2,0],["وإذا خص بالرذيئة شعب","فلقد عم بالبلاء الأنام",5,"م",1,0],["وَإِذَا خَصَّ بِالرَّزِيئَةِ شَعْبٌ","فَلَقَدْ عَمَّ بِالبَلاءِ الأَنْامُ",6,"م",1,0],["وَإِذَا خَرَجتَ بَكَت عَلَيكَ صَبَابةً","حَتَّى تَبُلَّ دُموعُها مَا بَلَّتِ",7,"ت",1,0],["وإذا خاف مَغَبَّةَ أمر","حَقَباً أن يلاقي التصديرا",8,"ر",2,1],["وإذا خلا من مَغرمٍ","ضخمٍ فذلك يومُ وَكسه",9,"س",2,0],["وإذا خطا أعياه ثقْل مؤَزَّرٍ","يرتَجُّ تحت موشَّحٍ ميّاس",10,"س",1,0],["وإذا خَسَّ في المعاشر قدْري","فلديها يجلُّ قدْري وينبُلْ",11,"ل",1,0],["وَإِذا خُفتِ أَن يَثورَ بِكِ الوَجدُ","فَتَبدو أَسرارُنا المَكنونَه",12,"ن",2,0],["وإذا خطرت على الملا","عب لم تدع لممثل",13,"ل",1,0],["وَإِذا خَطَبتَ فَلِلمَنابِرِ هِزَّةٌ","تَعرو النَدِيَّ وَلِلقُلوبِ بُكاءُ",14,"ا",2,0],["وَإِذا خَطَبتَ فَلا تَكُن","خَطباً عَلى مِصرَ الفَتاةِ",15,"ت",3,0],["وإذا خِفْتَ أَنْ يُراهِقَكَ العُدْ","مُ فَعُذْ بالمُثَقّفاتِ العَوالي",16,"ل",2,0],["وَإِذا خَفيتُ عَلى الغَبِيِّ فَعاذِرٌ","أَن لا تَراني مُقلَةٌ عَمياءُ",17,"ا",2,0],["وَإِذا خامَرَ الهَوى قَلبَ صَبٍّ","فَعَلَيهِ لِكُلِّ عَينٍ دَليلُ",18,"ل",1,0],["وَإِذا خُبِّرَت بِظاهِرِ شَكوي","هانَ عِندَ الصَحيحِ أَنّي عَميدُ",19,"د",1,0],["وَإِذا خِطابُ القَومِ في الخَطبِ اِعتَلى","فَصَلَ القَضِيَّةَ في ثَلاثَةِ أَحرُفِ",20,"ف",1,0],["وَإِذا خالَفَ أَصلاً فَرعُهُ","كانَ شَنّاً لَم يُوافِقهُ طَبَق",21,"ق",1,0],["وَإِذا خَلَوتُ وَلَم أَجِد لي مُسعِداً","إِلّا الشُؤونَ بِساجِمٍ هَطّالِ",22,"ل",1,0],["وَإِذا خَرَجنَ يَعُدنَ أَهلَ مُصابَةٍ","كانَ الخُطا لِسِراعِها الأَشبارُ",23,"ر",1,0],["وإذا خلوتَ بهنَّ ظمآنَ الحَشا","مَنَحتكَ من صَوبِ العُقولِ مَناهِلا",24,"ل",2,0],["وإذا خاضَ غَمرةَ الموتِ رَدَّ السْ","يْفَ من غَمرةِ الدِّماءِ خَضيبا",25,"ب",2,0],["وَإِذا خَشيتَ تَعَذُّراً في بَلدَةٍ","فَاِشدُد يَدَيكَ بِعاجِلِ التَرحالِ",26,"ل",1,0],["وَإِذا خابَتِ الظُنون","عِندَهُ يَصدُقُ الرَجا",27,"ج",2,0],["وَإِذا خاطَبَكِ الجا","هِلُ بي قَولي سَلاما",28,"م",2,0],["وإذا خافَ من شجاعٍ جبَانٌ","غَالَهُ منه جاهداً ما يَغولُ",29,"ل",1,0],["وَإِذا خَلائِقُهُم نَبَت أَو أَجدَبَت","أَنشَأتَ تَمهَدُ لي خَلائِقَ ريفا",30,"ف",2,0],["وَإِذا خَشيتَ مُحيطَةً","مِن وارِقِ الجَهَلاتِ زائِد",31,"د",1,0],["وإذا خلت منها فإن","نَ خلوها إحدى المصائب",32,"ب",1,0],["وإذا خفيت على الغبي فعاذرٌ","ألا تراني مقلةٌ عمياء",33,"ا",2,0],["وإذا خاف من حساب عسير","ذو ثراء، فما أخفَّ حسابه!",34,"ب",2,0],["وإذا خَالَفَ أصْلاً فَرْعُهُ،","كانَ شَنَّا لمْ يُوَافِقْهُ الطَّبَقْ",35,"ق",1,0],["وإذا خُوطبوا بجهلٍ يصونُوا","عنه أعراضَهم وقالوا سلامَا",36,"م",2,0],["وإذا خليلَتُه أبَتْ عن رأيهِ","نزلَ الشِّقاقُ وحان كل شقاءِ",37,"ا",2,0],["وإِذَا خِلتُ أَن غَدَوتُ سَلِيمَا","مِنَ أَلِيمِ الغَرامِ صِرتُ سَلِيمَا",38,"م",2,0],["وَإِذا خَشيتِ عَلى الصَبابةِ سَلوةً","فَتَعَوَّذي بِجَمالهم وَغَرامي",39,"م",2,0],["وإذا خضعتُ لحادثٍ","حَلَّت مكارمُه وَثاق",40,"ق",1,0],["وَإِذا خَيَّمَ الدُجى سَأَلتَهُ","بَعضَ نور فَلا تَرى فيهِ نورا",41,"ر",2,0],["وإذا خفت من أثامِ فعَفوُ اللَه","لا يُرتَجى لغير الاثامِ",42,"م",1,0],["واذا خرجت الى الأنام كأنّما","ملك كريم سار في الأسواق",43,"ق",1,0],["وإذا خاطبك الجاهل","جهلاً قل سلاما",44,"م",2,0],["وَإِذا خَليلُكَ لَم يَدُم لَكَ وَصلُهُ","فَاِقطَع لُبانَتَهُ بِحَرفٍ ضامِرِ",45,"ر",1,0],["وَإِذا خُبزُهُ سَيَكفيكَهُمُ","اللَهُ ما بَدا ضوءُ نَجمِ",46,"م",1,0],["وَإِذا خاتَمَ النَبِيِّ سُلَيمانُ","بنُ داوودَ قَد عَلاهُ بِخَتمِ",46,"م",1,0],["وإِذا خابَ لراجٍ أَملٌ","فَلَه عند رَسول اللَهِ نُجحُ",47,"ح",1,0],["وإذا خصصت بنعمة","فاشكر لها مع من شكر",48,"ر",1,0],["وَإِذا خَبا وَغر الصُدو","رِ فَلا يَزالُ بِهِ يُشِبُّه",49,"ب",2,0],["وَإِذا خطَّ فَلا أُقسمُ بِال","قَلم الصادر عَن تِلكَ البَنانِ",50,"ن",1,0],["وإذا خَمِرتُ فعندَه","بردٌ به أتبرَّدُ",51,"د",1,0],["وإذا خلوت مفكراً فبذكرهم","هيهات يخطر غيرهم في خاطري",52,"ر",2,0],["وإذا خاف شؤم حبس وقصر","ودفاعاً عنا من الحجّاب",53,"ب",1,0],["وإذَا خضعتَ لمن يخُو","نُكَ فالإبَاءُ لِمَن تُعِدُّهْ",54,"د",2,0],["وإذا خبت منها البروق أثارها","من نفخ باكرة الصبا ولواها",55,"ه",2,0],["وإذا خاضا في فن ما","جاء بالمضعف والمسند",56,"د",1,0],["وإذا خلت نفسي إلي فإنني","استشعر العزم الذي يتضعضع",57,"ع",1,0],["وإذا خلطتَ فتىً بودّك لم يكد","كرماً صديقُك من شقيقك يُعرَفُ",58,"ف",1,0],["وإذا خِلاط الأمرِ سُدَّ طريقُه","فلديك واضحةٌ له وقرارُ",59,"ر",1,0],["وإذا خَبَتْ نارُ اليَفاع فَنارُه","تهدي ركابَ الخابطِ المُتنور",60,"ر",1,0],["وإذا خَيْلُكَ أظْماها الوَغى","طَوَتِ الوِرْدَ النَّميرَ الشَّبِما",61,"م",2,0],["وإذا خفَّ مدَّعي الحبِ سمعاً","لم يكن حاملاً من الحبّ ثِقلا",62,"ل",2,0],["وَإِذا خَطاك الدّهرُ لم يجتزْ بما","لا نرتضيه فما عليه ملامي",63,"م",2,0],["وإذا خصالُ السّوءِ باعَدْن اِمرءاً","عن قومه لم تُدنِهِ أرحامُهُ",64,"م",2,0],["وإذا خليلي لم أُطِقْ فعلاً به","يكفي الرّدى زوَّدتُه أقوالي",65,"ل",2,0],["وَإِذا خِيفَتِ الغيوبُ فلا خِي","فتْ عليكم مدى الزّمان الغيوبُ",66,"ب",1,0],["وَإِذَا خَانَ أَنْ تُوَدِّعَ وَارَتْ","نَايَهَا فِي اليَسَارِ مِنْ مِنْخَرَيْهَا",67,"ي",3,0],["وإذا خلا الإنسان من علم ومن","أدب فذاك يعد في الأنعام",68,"م",1,0],["وإذا خفت افتضاحا","كل عيس في افتضاحك",69,"ك",1,0],["وإِذا خَطَّ باليَراعَةِ خَطّاً","فهو نارٌ تَذْكُو وماءٌ معينُ",70,"ن",1,0],["وإذا خلا الجمعان من بيض ومن","سود إليك مضى الغريب الآخر",71,"ر",1,0],["وَإِذا خُدِعتُ خُدِعتُ طَوعاً عالِماً","لَولا الكَرامَةُ لَستُ مِمَّن يُخدَعُ",72,"ع",1,0],["وَإِذا خَلَوتَ عَنِ النظيرِ فَلَم يحل","أَن لا يُرى لَكَ في الوَرى أَندادُ",73,"د",1,0],["وإذا خلت سبل العلا من طارق","يأتي إليها فهو هادٍ مهتدي",74,"د",2,0],["وإذا خوَّلك الله الغنى","لا تكن يا صاح مغلول اليدينْ",75,"ن",1,0],["واذا خلوت بها آمنت بقربها","طول الحياة وعيشك الامذاء",76,"ا",2,0],["وَإذا خفتِ أن يكونَ منَ اللَف","ظِ جلاميدُ ترجمُ السامِعينا",77,"ن",2,0],["وإذا خشيت من العمى","أصبحت ترضى بالعَوَر",78,"ر",1,0],["وإذ أخذت قلقا","كالعضب صافي الرونَق",79,"ق",1,0],["وإذا خِفتَ من خليلٍ ملالا","فاستجر من صُدُوِده بالمسيرِ",80,"ر",1,1],["وإذا خشيتِ من القضاء صروفَه","فأَنا بفضلك من قضاةِ الجنَّةِ",81,"ه",1,0],["واذا خبأن خدودهن أريننا","حدق المها واخذت قبل القابل",82,"ل",1,0],["وإذا خفا قلبي فإن وجيبه","لمع الجوى بفؤادك الخفاق",83,"ق",1,0],["وإذا خَطَرتِ مَلأتِ أنفاسَ الصَّبا","صِيباً وأخجَلَ قدُّكِ الأغصانا",84,"ن",2,0],["وإذا خالعها في وصبٍ","فاحتسى كأس المنايا جرعا",85,"ع",2,0],["وإذا خالعها كان له","ردها حلا إذا ما رجعا",85,"ع",2,0],["وإذا خالعها شرطاً على","أنها ترزق طفلاً مرضعا",85,"ع",2,0],["وإذا خلفت منهم زوجةً","أخذ الوارث أبا أو ولد",86,"د",1,0],["وإذا خيرها في نفسها أو","مقامٍ عند طولَ الأبد",86,"د",1,0],["وِإذا خَطَا وَكَظَا بِخَيرِكَ جَامِدٌ","لا تُبطِلِ الحُسنَى بِمَنٍّ يُسأَمُ",87,"م",1,0],["وإذا خَطا فَبَانَةُ حِقْفٍ","وإذا ما عَطَا فجُؤْ ذَرُ رَمْلَه",88,"ل",2,0],["وإِذا خَلا من فَرْطِ وجدٍ لا جَوىً","منه شِغَافُ حَشَاشةٍ لم يُشْغَفِ",89,"ف",1,0],["وَإِذا خَبرتَهُم خَبَرتَ سَماحَةً","وَشَراعَةً تَحت الوَشيجِ الموردِ",90,"د",1,0],["وإذا خلوت بمثله","وعزمت فيه على اعتزام",91,"م",1,0],["وإذا خاطبه من ذاته","ما يرى خاطبه منه سوى",92,"و",2,0],["وَإِذ إِخوَتي حَولي وَإِذ أَنا شامِخٌ","وَإِذ لا أُطيعُ العاذِلاتِ مِنَ الصَمَم",93,"م",1,0],["وَإِذ إِخوَتي حَولي وَإِذ أَنا شائِخٌ","وَإِذ لا أُجيبُ العاذِلاتِ مِنَ الصَمَم",94,"م",1,0],["وَإِذا خَلوتَ بِها خلوتَ بِحُرَّةٍ","رَيّا العِظامِ دَميثَةٍ مِكسالِ",95,"ل",1,0],["وإذا خرَجتُ لفرجةٍ هنّيتُها","لا صنعةٌ ضاعت ولا تذكار",96,"ر",1,0],["وإذا خفايا المشكلات تحجبت","عرف الذي في طيها وتحققا",97,"ق",2,0],["وإذا خفت نزعة من وشاة","كالشياطين بيننا نزاغه",98,"غ",2,0],["وإذا خاضوا في اللهو فكن","في بحر تقاتك منغمسا",99,"س",2,0],["وإذا خفت لسع رقش الخطايا","فاله عن عشق زينب ورقاش",100,"ش",1,0],["وإذا خلوت إلى الأسى نادمته","بشكايتي وحسرتُ عن أسقامي",101,"م",2,0],["وإذا خطك البديع على البا","ب يبث الضياء والأنوارا",102,"ر",2,0],["وإذا خالفتني أن","ت ملاك يا حبيبي",103,"ي",1,0],["وإذا خلا ما مر عارضَ ذكره","إلا تلهب فوق ذلك وامتلا",104,"ل",2,0],["وإذا خشيتَ من الشتاء وجوّهِ","فذكاك يذهبُ بالضباب القاتِمِ",105,"م",1,0],["وَإِذا خَلا نَحوَ العِداةِ سَمِعتَهُ","يَرميكَ بِالشَرِّ العَظيمِ وَبِاللَهَب",106,"ب",1,0],["وإذا خلوت لهمتي لا يرضي","إلا الأجل من الأمور الأشرف",107,"ف",1,0],["واذا خَشِيْتَ من الخُطُوبِ مُلِمَّة","فاعلَق بحبلِ الغالبِ بنِ القَادِرِ",108,"ر",1,0],["وَإِذا خَرَجتُ لِنُزهَةٍ هُنّيتُها","لا ضَيعَةٌ ضاعَت وَلا تِذكارُ",109,"ر",1,0],["وَإِذا خَلَوتَ بِرِيبَةٍ في ظُلمَةٍ","وَالنَفسُ داعيَةٌ إِلى الطُغيانِ",110,"ن",1,0],["وإذا خلوا عكفوا على شهواتهم","من لاعب أو شارب أو آكل",111,"ل",1,0],["وَإِذَا خَالَفَ خِلٌّ فِي الَّذِي","مِلْتَ عَنْهُ أَوْ إِلَيْهِ قَدْ أخَلْ",112,"ل",1,0],["وإذا خانت المساعي فمهلا","ربما تحدث الأمور أمورا",113,"ر",2,0],["وإذا خصَّ زمانٌ بمنىً","فزمان الورد باللَّهو أخص",114,"ص",1,0],["وإذا خالسته في نظرة","لا يدانيه حياءً أَحد",115,"د",1,0],["وَإِذا خَلَوتُ بِها تَمَثَّلَ لي","ذاكَ الزَمانُ وَعَيشُهُ الرَغدُ",116,"د",1,0],["وإذا خيالي يوم حسّ بهجيره","مرّت سحابتها وقال أطلبك ريّ",117,"ي",1,0],["وإذا خشيت من الحوادث ريبها","أو خفت بث صروفه وضراره",118,"ر",2,0],["وإِذا خانَنَا الجَمِيعُ.. فَمَن سَو","فَ يُعَزِّي طُمُوحَنا ويُكَفكِف؟",119,"ف",1,0],["واِذا خَبَتْ نارُ النَّدى","جعلوا أكُفَّهُمُ حِطابْ",120,"ب",1,0],["وإذا خريفُ العمرِ ناخَ بدارِها","وإذا شتاءُ الدّهْرِ مرّ كئيبا",121,"ب",2,0],["وإذا خطوت شكوت للأرض الهوى","وشكا إليّ أنينها المعتاد",122,"د",1,0],["وإذا خرَجْتِ البيتُ يسألنِي","وإذا دخلتِ البابُ يَسْألُكِ",123,"ك",1,0],["واذا خلوت بمن تفاكهه","فاشتم له عرضى على عمد",124,"د",1,0],["وإذا خطْوُنا السريعُ بطيءٌ","وإذا عمرُنا الندى صَلْصَالُ",125,"ل",1,0],["وإذا خانك التراب. فماذا","ينفع البرق عندها. والهطول؟",126,"ل",1,0],["وإذا خشيت من الغرام على المدى","ضاع الفؤاد وضاع رسم شوارعي",127,"ع",2,0],["وإذا خَطَرنَ على ضميرٍ غائبٍ","لَخَطَفنَ قلبَ المرءِ دونَ إيابِ",128,"ب",1,0],["وإذا خَيَّرَتني ياربِّ أنَّى","أبتغي موتي ؟ سمعتُ المَوْج قالا",129,"ل",2,0],["وإذا خفى حالٌ وأشكل أمرُه","فالعين تُخبر بالخفي وتشهدُ",130,"د",1,0],["وإذا خلوتُ رأيتُ وجهكِ في السَّما","بدرًا يُنيرُ بحسنهِ ظلمائي",131,"ي",1,1],["وإذا خطرتِ عليَّ في غسق الدجى","غرق الشعور ببحره المرتابِ",132,"ب",1,0]]}