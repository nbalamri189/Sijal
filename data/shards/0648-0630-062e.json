{"poems":[[53,"يا راغبا نزعت به الآمال","https://www.aldiwan.net/poem65921.html","الكامل"],[87,"درجت على الكنز القرون","https://www.aldiwan.net/poem63694.html","مجزوء الكامل"],[82,"قبس بكف مديرها أم كوكب","https://www.aldiwan.net/poem31239.html","الكامل"],[107,"الكتب تترى والكتائب تدلف","https://www.aldiwan.net/poem43999.html","الكامل"],[54,"سقيا لمنزلة الحمى وكثيبها","https://www.aldiwan.net/poem27267.html","الكامل"],[119,"الا عذر لا كان الهوى في الهوى العذر","https://www.aldiwan.net/poem41119.html","عموديه"],[369,"في الجيرة الغادين بدر","https://www.aldiwan.net/poem60895.html","مجزوء الكامل"],[416,"مضى لسبيله معن وأبقى","https://www.aldiwan.net/poem67484.html","الوافر"],[422,"أمن بعد الهمام القرم وادي","https://www.aldiwan.net/poem54153.html","الوافر"],[445,"سر سار صنع الله حيث تسير","https://www.aldiwan.net/poem34815.html","الكامل"],[445,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[463,"دعها تكن كالسلف من أخواتها","https://www.aldiwan.net/poem56263.html","البسيط"],[469,"هي دار مية يا طليق العدل","https://www.aldiwan.net/poem3282.html","عموديه"],[520,"سرت نفحة كالمسك أزهى وأعطر","https://www.aldiwan.net/poem12119.html","الطويل"],[556,"أأبا الحسين كفيت ما بعد الردى","https://www.aldiwan.net/poem47742.html","الكامل"],[556,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[580,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122621","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86581","الكامل"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90652","الكامل"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105873","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85123","الطويل"],[5737,"في شهداء عزلة ( الأَجْعُود )","https://www.poetsgate.com/ViewPoem.aspx?id=177995",""],[463,"دعها تكنْ كالسلفِ من أخواتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59994&r=&rc=50",""]],"verses":[["وذخرتُه للدّهرِ أعلمُ أنه","كالحصنِ فيه لمنْ يؤول مآلُ",0,"ل",1,0],["وَذَخائِرٌ مِن أَعصُرٍ وَل","لَت وَمِن دُنيا وَدين",1,"ن",1,0],["وذخيرَةٍ للعيشِ مَرّ لعمرها","عَدَدٌ يشقّ على يَدَيْ من يحسبُ",2,"ب",1,0],["وذخيرةً يَجِدُ الذَّخائِرَ كُلَّها","بِيَدَيهِ حينَ يُصيبُها المتلقِّفُ",3,"ف",1,0],["وَذَخَرتَ لِلأَعداءِ أُسدَ وَقائِعٍ","صُبُراً عَلى غُمّاتِها وَكُروبِها",4,"ب",3,0],["وذخري ابن خير الله ذو الفضل والتقى","عليٌّ عليُّ الذات والاصل والقدر",5,"ر",1,0],["وذخرْتُ وُدَّك والكري","مُ وِدادهُ للدَّهرِ ذُخر",6,"ر",1,0],["وَذُخراً مِن مَحامِدَ باقِياتٍ","وَفَضلَ تُقى بِهِ التَفضيلَ نالا",7,"ل",2,0],["وذخر الأنجبين وكلّ ذخر","ستسلِمه الخطوبُ إلى النفاد",8,"د",1,0],["وذخيرةٌ فِي النائِباتِ ومَعْقِلٌ","من صرفِ أَحداثِ الزمانِ مُجيرُ",9,"ر",1,0],["وَذَخَرْتُ للأَزْمانِ من حَسناتِهَا","مثْلَ القلائدِ فِي نحورِ كواعبِ",10,"ب",1,0],["وذخيرةٍ طفِقتْ تضمُّها","والدهرُ خلفَك مولَعٌ بِشَتاتِها",11,"ت",3,0],["وذخيرةُ الآباء للأبناء في","حال الثواءِ ونعم زادُ المعجل",12,"ل",1,0],["وذخر يرى ذخر الأئمة أنه","لدولته كنز يصان ويذخر",13,"ر",1,0],["وذخرتُ منك مودّةً فُسِلبْتُها","والدّهرُ مشغولٌ بسلبِ نفائسي",14,"س",2,0],["وَذخرتُ منكَ على الزّمانِ نفيسةً","لَو كانَ يَبقى لِلفَتى ما يذخرُ",15,"ر",1,0],["وذُخُرِيَ منْ كَفَّيه في الدَّهْر جُودُه","كما أَن تقوى خالق الدهر ذخره",16,"ر",2,0],["وذُ خَمرَ عَينَيهِ بِعينِكَ صاحيا","وإن أنتَ لَم تَسكَر مِنَ الخمرِ تَسكَرِ",17,"ر",1,0],["وَذَخيرَتي يَوم الزحام وَعدّتي","وَوِقايَتي في شدّتي وَرَخائي",18,"ا",3,0],["وذخرتَ أبناءَ الحروبِ كأنهم","أسدُ العرينِ علىمُتونِ عِتاقِ",19,"ق",1,0],["وذخيرةُ الخُلَفاءِ والأملاكِ لا","يَخلُون مِنهُ مُجَنّساً مَفصُولا",20,"ل",2,0],["وذخري عبيد اللَه أوحد عصره","هزبر المزايا سيد متبرع",21,"ع",1,0],["( وذَخُورُ ) شُهْبُ اللهِ بين مضاربٍ","تهوي وبين مخابئ النمرودِ",22,"د",1,0],["وذخيرة ٍ طفقتْ يداك تضمها","والدهرُ خلفك مولعٌ بشتاتها",23,"ت",3,0]]}