515","الوافر"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81701","الوافر"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136738",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83638","الطويل"],[4729,"فُنب لك الخيِرُ عَن العَا","https://www.poetsgate.com/ViewPoem.aspx?id=109463",""],[4729,"دَعُوهَا تَنُش إسحلا بالعقيق","https://www.poetsgate.com/ViewPoem.aspx?id=109444",""],[4935,"لي حلا ورد الهناء الكوثري","https://www.poetsgate.com/ViewPoem.aspx?id=129442",""],[4984,"العسس","https://www.poetsgate.com/ViewPoem.aspx?id=180561",""],[5092,"لها","https://www.poetsgate.com/ViewPoem.aspx?id=152403",""],[5271,"الى/ لئيمة","https://www.poetsgate.com/ViewPoem.aspx?id=67533",""],[592,"لك الحمد اللهم يا واسع المجد","https://www.poetsgate.com/ViewPoem.aspx?id=128838",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5436,"لهيب الثأر ماخمدا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177642",""],[5725,"ومضى الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=177495",""],[5895,"عُيُونُكِ قالَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=202651",""],[5910,"بِمكةَ نورٌ قد سَرَى وضياءُ","https://www.poetsgate.com/ViewPoem.aspx?id=206977",""],[5943,"بإيمانٍ فلاحُ المسلمينا","https://www.poetsgate.com/ViewPoem.aspx?id=37270",""],[6093,"إلاَّا القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=178563",""],[5075,"ولابد أن يستمر الحداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82757&r=&rc=3",""],[5616,"أننسى ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1925&r=&rc=0",""],[6277,"العبودية الكبرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64441&r=&rc=0",""]],"verses":[["فنُبْ عنْ بَعيدِ الدّارِ في ذلكَ الحمى","وأذْرِ بهِ دمْعاً وعفِّرْ بهِ خَدّا",0,"د",2,0],["فَنَبِّه عُقولاً طالَ عَهدُ رُقادِها","وَأَفئِدَةً شُدَّت إِلَيها بِأَنسُعِ",1,"ع",1,0],["فَنَبَذتُ ثَمَّ تَحِيَّةً فَأَعادَها","غَمرُ الرِداءِ مُفَضفَضُ السِربالِ",2,"ل",1,0],["فنبطّنتها وقد أخذ الش","قول من ذلك المحلّ مكانه",3,"ن",2,0],["فنبكي على الأوطان حول رِجامه","كما قد بكت من فقدها الأَّم أطفال",4,"ل",1,0],["فنُبْت عن المسيح وقمت حتى","لقد شكر المسيح لك القياما",5,"م",2,0],["فنبيت مجداً منك مكتسبا","من بعد آخر غير مكتسب",6,"ب",1,0],["فَنَبعٌ فَالنَبيعُ فَذو سُدَيرٍ","لِئارامِ النِعاجِ بِهِ سِخالُ",7,"ل",1,0],["فنبيحهن مَرادَهنَّ يَردْنه","فيما ادَّعين ملاحةً ووساما",8,"م",2,0],["فنبيحنّ ملاثماً ومراشفاً","ما ضرَّها أن لا تكون مُداما",8,"م",2,0],["فَنَبَّهتُ سَعداً بَعدَ نَومٍ لِطارِقٍ","أَتانا ضَئيلاً صَوتُهُ حينَ سَلَّما",9,"م",2,0],["فَنَبَّهَني طَرقٌ عَلى بابِ غُرفَتي","وَصَوتٌ ضَعيفٌ وَهوَ أَقرَبُ لِلهَمسِ",10,"س",1,0],["فَنَبيعُ أَياماً خَلَت فيما مَضَى","قَصُرت بأَيَّامٍ عقبنَ طوالِ",11,"ل",1,0],["فنبتّ بين جوانحي","والقلب من دمه سقاك",12,"ك",1,0],["فَنَبيتُ في الإيناسِ يَغ","بُطُنا بِهِ النَجمُ الوَحيد",13,"د",1,0],["فَنَبَّهَنا الفَتحُ الَّذي ما بِفَجرِهِ","وَلا بِكَ يا فَجرَ السَلامِ مُكَذِّبُ",14,"ب",1,0],["فَنُبتَ مَنابَ البَدرِ في لَيلَةِ السُرى","وَقُمتَ مَقامَ الوَبلِ في البَلَدِ المَحلِ",15,"ل",1,0],["فَنَبَّهَني زَيدٌ فَقُمتُ إِلَيهِما","أَجُرُّ أَسابِيَّ الكَرى غَيرَ مُرقَدِ",16,"د",1,0],["فَنَبقى كَما كُنّا نَكونُ وَأَنتُمُ","قَريبٌ وَإِذ ما تَبذُلينَ زَهيدُ",17,"د",1,0],["فنبتْ أهدابه إلا دما","قام كالياقوت لم ينبجس",18,"س",1,0],["فَنَباتُها عَمّا يَعِيبُ مُنَزَّهٌ","وَهَواؤُهَا مِمّا يَشِينُ مُبَرَّأُ",19,"ر",2,0],["فَنَبَّهَتْ فِيهَا الضَّمِيرَ الَّذي","يَخْدُرُ فِي الحُرِّ إِذَا اسْتُعْبِدَا",20,"د",2,0],["فَنٌّ بَذَلْتَ لَهُ الحَيَاةَ مُثَابِراً","فِي حَوْمِة الآلامِ وَالآمَالِ",21,"ل",1,0],["فنَبْعٌ فالنّبيعُ فَذُو سُدَيْرٍ","لآرامِ النِّعَاجِ بِهِ سِخَالُ",22,"ل",1,0],["فنبيذ قعوار اللذيذ","وانة الناي الشجية",23,"ي",2,0],["فَنَبَّهتُ مِطوَىَّ اللَّذينِ كِلاهُما","يُلَبِّينِ عِندَ المُفظِعاتِ مُجِيبُ",24,"ب",1,0],["فنبئينا رعاك اللّهُ جارتنا","بل انت سوغٌ لنا من عهد ميلاد",25,"د",1,0],["فنَبْتُ رياضِ جودك للأماني","نُضَارٌ جَلَّ لا طَلْح وحَمْض",26,"ض",1,0],["فَنَبّه الأَحبابَ مِن نَومِهم","لِيَخرُجوا في غَيرِ ما حينِ",27,"ن",1,0],["فَنَبا عَن فِراشِهِ كَأَثيمِ","أَيقَظَته من نَومِهِ الأَحلامُ",28,"م",1,0],["فَنَبَذتِها وَجَحدتِ ما ردَّدته","وَصَنعتِ بِالحسونِ أَفظَعَ مصنَعِ",29,"ع",1,0],["فنَبِّه رَقيقاً من حِذاركَ كلَّما","رَأَيت بِأطرافِ الفُؤادِ أمانيا",30,"ي",2,0],["فَنَبَذتَها مِن راحَتَيكَ وَإِنَّها","في الذَبِّ عَن عِرضِ الكَريمِ لَمُنصُلُ",31,"ل",1,0],["فنبئني أعَيْشُ المرءِ خيرٌ","بذلٍ أم رداه فأنت أدرى",32,"ر",2,0],["فنبيت فيها ونفدو جيمعا","للوقوف بالوقوف المتسامي",33,"م",2,0],["فنَبذْنا نظْرةً نحوَ الحِمَى","ثُمَّ أَهدَيْنا منَ البُعْدِ السَّلاما",34,"م",2,0],["فَنُبْ عن أبيكَ الدَّهْرَ ما غابَ شَخْصُه","فإنّك بَدْرٌ شَمسُه ذلك الصّدْر",35,"ر",1,0],["فَنبه أَشواقي وَوَجديَ سَجعَها","وَلم أَكُ ساهٍ عَن هَواهُ وَلا سالي",36,"ل",2,0],["فَنبَّهَ الأَحبابَ منْ نَوْمِهمْ","لِيَخْرُجُوا مِن غيْر ما حِينِ",37,"ن",1,0],["فَنَبِّهْ فادِيَ الأَسْرى عَلَيْهِمْ","نفوسُهُمُ لَهُ ولَكَ الفِداءُ",38,"ا",2,0],["فنَبَّهت كلَّ مِرْنام الضحى غَرِدٍ","حالي الطلاَ مخضَب الكفين مستَحِر",39,"ر",1,0],["فنبَّه من أيام جَمعٍ لبانةً","يكاد لها جمعُ الضلوع يفرَّقُ",40,"ق",1,0],["فنبه نيرانه والجفان","وأيقظ سماره والعبيدا",41,"د",2,0],["فنبثه الشوق المبرح عله","يجد المشوق به شفاء غليل",42,"ل",1,0],["فنبّهْتُ منها نرجِساً زرّهُ الكَرى","كأنّي أفُضّ الخَتم عن قدَحَيْ خَمْرِ",43,"ر",1,0],["فَنَبِيتَ مِنْ فَرَحِ اللّقا في غِبْطَةٍ","وَيَجِفَّ فَيْضُ مدامِعِي الْمِهْراقُ",44,"ق",1,0],["فنبتدي الحجة فيما أصلوا","من ذاك من قولهم وحملوا",45,"ل",3,0],["فَنبهه ذات يَوم نِداء","إِلى الحَرب يَدعو فَلَبى النِداء",46,"ا",1,0],["فَنَبَّهتُهُ ثُمَّ عاطَيتُهُ","سِلافَ الأَبارِقَ تَشفي الخِمارا",47,"ر",2,0],["فنب يا ابن ودي عن أخيك مقبلاً","سنا راحةٍ هي عين روحي وراحتي",48,"ي",1,0],["فنبينا نعم الملاذ وحبذا","عبد أتى لإلاهه واسترحمه",49,"م",2,0],["فن به علم الفتى أو جهلل","محقق كما تقول أهله",50,"ه",1,0],["فنبا الجسم عن خفوق فؤادٍ","حقه أَن يكونَ في الأَطواد",51,"د",1,0],["فنبهتني لحفظ الحب من دنس","وذكرتني عهداً قط ما شينا",52,"ن",2,0],["فنبا من تحت صمصا","مت