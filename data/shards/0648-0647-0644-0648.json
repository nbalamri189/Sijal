{"poems":[[65,"بكت شجوها وهنا وكدت أهيم","https://www.aldiwan.net/poem46131.html","الطويل"],[75,"أثرت هزبر الشرى إذ ربض","https://www.aldiwan.net/poem11911.html","المتقارب"],[53,"تأمل أبا عبد الإله فإنه","https://www.aldiwan.net/poem66003.html","الطويل"],[47,"تبيت له من شوقه ونزاعه","https://www.aldiwan.net/poem64716.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39561","السريع"],[119,"بالله يا حادي الركبان هل طرقت","https://www.aldiwan.net/poem40474.html","عموديه"],[147,"أما ومساع لا نحيط لها عدا","https://www.aldiwan.net/poem11755.html","الطويل"],[275,"أيا زهرة من حبيبة قلبي","https://www.aldiwan.net/poem35665.html","المتقارب"],[302,"سل البان عنهم أين بانوا ويمموا","https://www.aldiwan.net/poem33179.html","الطويل"],[310,"بسعيك تبلغ الرتب العظام","https://www.aldiwan.net/poem56409.html","الوافر"],[347,"إليك إليك يا وطني","https://www.aldiwan.net/poem55317.html","مجزوء الوافر"],[463,"يلوم عليك لا عدم الملامه","https://www.aldiwan.net/poem55898.html","الوافر"],[463,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[466,"يبيت الوحيد الفرد من هو وال","https://www.aldiwan.net/poem15977.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83308","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48735","البسيط"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18483","البسيط"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122023","الطويل"],[1491,"","https://poetry.dctabudhabi.ae/diwan/poem/107300","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128722","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47189","الطويل"],[2408,"","https://poetry.dctabudhabi.ae/diwan/poem/128800","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130049","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68012","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138463",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92369","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101355","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123524","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83590","السريع"],[585,"هو الصوت دوّى من فلسطين عالياً","https://www.poetsgate.com/ViewPoem.aspx?id=161906",""],[3591,"إذا كنت لم أبرح من الدهر شاكيا","https://www.poetsgate.com/ViewPoem.aspx?id=149441",""],[5442,"عسى وقفة بالركب يا حادي الركب","https://www.poetsgate.com/ViewPoem.aspx?id=114759",""],[5874,"أَمِيرَةُ التَّابُوتِ","https://www.poetsgate.com/ViewPoem.aspx?id=202112",""],[463,"يلومُ عليكِ لا عدمَ الملامهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60300&r=&rc=356",""]],"verses":[["وهلْ واجِدٌ يَمْتاحُ عَبْرَتَهُ النّوى","ويَسْلُبُهُ الشّوْقُ الرُّقادَ مُليمُ",0,"م",1,0],["وَهَل وارِدُ الغَمرِ مِن عِدِّهِ","يُقاسُ بِهِ مُستَشِفُّ البَرَض",1,"ض",1,0],["وهل وثنٌ بعد النبي محمدٍ","وبعد كتاب الله إلا مُعطَّلُ",2,"ل",1,0],["وَهَل وازَنوهُ عِندَ جِدِّ حَقيقَةٍ","بِمِثقالِهِ أَو كايَلوهُ بِصاعِهِ",3,"ع",2,0],["وهل وراءَ الموت ما نجهلُ","من عالم الرُّجعى ويومِ النشورْ",4,"ر",1,0],["وهل وأنت مثير عجها نظرت","عيونها بعد طول السير متكينا",5,"ن",2,0],["وَهَل وَخَدَت تِلكَ الرِكابُ بِمَهمَهٍ","لِتَقطَعَهُ إِلّا بِمَدحِكُمُ تُحدا",6,"د",2,0],["وَهل وطنٌ تأسفين عليه","وهل أنتِ ما بين حبٍّ وحربِ",7,"ب",1,0],["وَهَل وردت ماءَ العُذيب أَوانِسٌ","فإنّي أَرى أَرجاءَه تَتَبَسَّمُ",8,"م",1,0],["وَهَل وافى لِغايتهِ مجلّ","وَلَيس لَكم بِفارسه اِهتمامُ",9,"م",1,0],["وهل ورد بلا حسك","وهل شهد بلا إِبر",10,"ر",1,0],["وهل وصفَتْكِ أعجازُ الليالي ال","طوالِ له وأعوادُ البَشامَهْ",11,"م",2,0],["وهل وقد أمرضها بعادكم","كنتم بعَطفِ الذِّكْر من عُوّادِها",12,"د",3,0],["وهل ولدٌ مُغْنٍ اذا نزلَ الردى","فتيلاً وأمْرُ اللّهِ ماضٍ مُقَدَّرُ",13,"ر",1,0],["وَهَل وَرَدَتهُم عَن كَريمِ مَقامِهِ","سَمانَ المَعالي في لِطافِ النَسائِمِ",14,"م",1,0],["وهل وفيتم بميثاق لمصرَ كما","رعيتمُ العهد للبلجيك موفينا",15,"ن",2,0],["وهل وجدتُ أبا سني لجاريةٍ","أبقى الزمانُ لها من والدين أبا",16,"ب",2,0],["وَهَلْ وَرَدَتْ مَاءَ الأَثِيلِ وَدُونَهُ","ظِبَاءٌ سَطَتْ أَلْحَاظُهَا النُّجْلُ بِالأُسْدِ",17,"د",1,0],["وَهَل ودّنا ما غَيَّرَتهُ يَدُ النَوَى","وَظَنِّي به ما حالَ عَن ما عَهِدنَاهُ",18,"ا",2,0],["وهل وردوا مياه عيون دمعي","أم اقتبسوا بقلبي نارهنّه",19,"ن",2,0],["وهل وصلوا لطيبة واستراحوا","أم ارتحلوا فحيّهلا بهنه",19,"ن",2,0],["وهل وجدوا كفِتيَتِهِم عليّاً","إذا لبسوا القوانس والعماما",20,"م",2,0],["وهل وقع الملزوم يوماً ولم يكن","لِلاَزِمِهِ في ساحة الكون موقع",21,"ع",1,0],["وهل وجدت في الترب جسم ابن فاطمٍ","مغيراً رضيضاً صدره بالمناسم",22,"م",1,0],["وهل ودعته عند شد الرواسم","أم القوم قد حالوا لتزداد بلواها",22,"ه",2,0],["وهل وجهكَ الوضّاء يهدي إلى العلا","أمِ النار يُذكيها العدوّ ويوقدُ",23,"د",1,0],["وهل وجهك الوضّاح وجهٌ سالم","يطلُّ فيُرضينا سناه المجدّدُ",23,"د",1,0],["وهل وقفتَ عَلَى الأعتاب ملتمِساً","تقبيلَ أعتابه بالتُّرْب تفتخر",24,"ر",1,0],["وهل وصي نبي مثل حيدرة","ملبباً قيد قسراً غير محتشم",25,"م",1,0],["وهل ودّنا باقٍ وإلا تغيرتْ","على عادة الأيام منك العَوائدُ",26,"د",1,0],["وَهَل وَدّنا باقٍ لمن لام غائظُ","وَهَل أَنتِ ضيّعت الَّذي أَنا حافظُ",26,"ظ",1,0],["وهل وافتك يكحل مقلتيها ال","شباب الغض في ميل الفتور",27,"ر",1,0],["وهل ودّعت غير القوى حين ودّعت","وقد طال في وقت الوداع دعاها",28,"ا",3,0],["وَهَل وِئامٌ وَاِتّفاقٌ فَقد","قَصّر منّا العمر طول الشَغَب",29,"ب",1,0],["وهل وجدوا الجبار هتلر عاتياً","كما كنت جباراً على العرب عاتيا",30,"ي",2,0],["وهل وسعتني بعد باريس بلدةٌ","تضيق بلاد الله من بعدها بيا",31,"ي",2,0],["وهل وادع في القوم من عقد الجوى","بجفنيه ما بين الحواجب والهدب",32,"ب",1,0],["وهَل؟ وَكَيْفَ؟ وَكَمْ بَاقٍ؟ وَمَنْ سَبَقُوا؟","وَالطَّامِعُونَ؟ وَمَا يُبْكِي؟ وَمَا يُشْجِي؟",33,"ج",2,0],["وهل وصلفتكِ أعجازُ الليالي ال","طوالِ له أعوادُ البشامهْ",34,"م",2,0]]}