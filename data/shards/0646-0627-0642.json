{"poems":[[55,"قعد الراضون بالذل فقم","https://www.aldiwan.net/poem29750.html","الرمل"],[53,"يا ابن بوران يا جعلت فدائي","https://www.aldiwan.net/poem7967.html","الخفيف"],[53,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[53,"مدرك عاين أمه","https://www.aldiwan.net/poem66348.html","مجزوء الرمل"],[87,"مرت على الخفاش","https://www.aldiwan.net/poem8037.html","مجزوء الرجز"],[87,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[87,"مضناك جفاه مرقده","https://www.aldiwan.net/poem63667.html","المتدارك"],[47,"كلما شاءت الرسوم المحيله","https://www.aldiwan.net/poem65542.html","الخفيف"],[99,"ها أنا عدت إلى حيث التقينا","https://www.aldiwan.net/poem24925.html","الرمل"],[46,"لم أر عيرا جمة الدؤوب","https://www.aldiwan.net/poem29700.html","الرجز"],[21,"كثمود التي تفتكت الدين","https://www.aldiwan.net/poem36208.html","الخفيف"],[136,"إن للبين صولة وهجوما","https://www.aldiwan.net/poem54650.html","الخفيف"],[136,"ناقص العقل من يعارض مرءا","https://www.aldiwan.net/poem54689.html","الخفيف"],[136,"لعبت بعد ما انقضى الريعان","https://www.aldiwan.net/poem54719.html","الخفيف"],[136,"لا تلوماه في الهوى أو لوما","https://www.aldiwan.net/poem54746.html","الخفيف"],[147,"سل المقادير ما أحببته تجب","https://www.aldiwan.net/poem11725.html","البسيط"],[147,"هل للأماني عن جنابك مدفع","https://www.aldiwan.net/poem11771.html","الكامل"],[228,"ناقم على السماء","https://www.aldiwan.net/poem41593.html","مجزوء الرمل"],[240,"لا وجدتم يا أهل نعمان وجدي","https://www.aldiwan.net/poem32096.html","الخفيف"],[287,"أقر نجدا ومن بنجد سلامي","https://www.aldiwan.net/poem32631.html","الخفيف"],[321,"يا لحدب الظهور فصع الرقاب","https://www.aldiwan.net/poem69444.html","الخفيف"],[409,"ناقضت ما قلت يا جهول","https://www.aldiwan.net/poem33603.html","مخلع البسيط"],[449,"أهي الجنة التي وعد الله","https://www.aldiwan.net/poem55987.html","عموديه"],[458,"وطن الدولار هذا أم ترى","https://www.aldiwan.net/poem61565.html","الرمل"],[466,"يا راكبا يقطع الفيافي","https://www.aldiwan.net/poem16141.html","مخلع البسيط"],[484,"تونسي وحسبي","https://www.aldiwan.net/poem37610.html","مجزوء الخفيف"],[534,"يا جاهلا في نصر سنة أحمد","https://www.aldiwan.net/poem37462.html","الكامل"],[556,"قد مضى شهر الصيام","https://www.aldiwan.net/poem47208.html","مجزوء الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48794","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64122","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[1961,"","https://poetry.dctabudhabi.ae/diwan/poem/34925","الخفيف"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46490","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53056","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94273","الخفيف"],[3481,"","https://poetry.dctabudhabi.ae/diwan/poem/112964","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216475","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85156","الرمل"],[4764,"يسألوني","https://www.poetsgate.com/ViewPoem.aspx?id=37030",""],[4578,"رنا إلي بعينيه فقلت رشا","https://www.poetsgate.com/ViewPoem.aspx?id=49448",""],[5072,"في قاعة المناقشة","https://www.poetsgate.com/ViewPoem.aspx?id=53674",""],[5315,"رام أَن يتْرك الْهوى فَبَدَا لَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=190297",""],[5461,"ناقد الاشعار لك مني سلام","https://www.poetsgate.com/ViewPoem.aspx?id=1316",""],[5937,"إلى مُعَلمة","https://www.poetsgate.com/ViewPoem.aspx?id=211808",""],[6056,"بطاقة ورد","https://www.poetsgate.com/ViewPoem.aspx?id=156707",""],[6093,"مسائل في الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=176101",""],[6093,"مَاهِيَّتي ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=180517",""],[6142,"لم يكن همه بدنياه إلا","https://www.poetsgate.com/ViewPoem.aspx?id=155695",""],[6314,"غزل أحمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88066&r=&rc=1",""]],"verses":[["ناقِصُ الأَموالِ في بَذلِ النَدى","زائِدُ الخَطوِ إِلى ضَربِ القِمَم",0,"م",1,0],["ناقضَتْ مريمَ العفافَ فلما","قاومَتها سَمَتْ إلى حَوّاءِ",1,"ا",2,0],["ناقضتْ مريم العفافَ فلمَّا","قاومتها بالغيِّ والتأثيم",2,"م",1,0],["ناقهٌ أبصرَ لحماً","فاشتهاهُ حين شمَّهْ",3,"م",2,0],["ناقِصَةَ الأَعضاءِ","تَشكو مِنَ الفَناءِ",4,"ا",2,0],["ناقِلاتٍ في العَبيرِ القَدَما","واطِئاتٍ في حَبيرِ السُندُسِ",5,"س",1,0],["ناقوسُ القَلبِ يَدُقُّ لَهُ","وَحَنايا الأَضلُعِ مَعبَدُهُ",6,"د",2,0],["ناقِهٌ لِلسَماعِ وَالغَبنُ مِنهُ","حَشَفٌ رادِفٌ لَهُ سوءُ كيلَه",7,"ل",2,0],["ناقلاً للنّهرِ والسهلِ معاً","قصةً يشرحُها عنكِ وعني",8,"ي",1,0],["ناقِضَةً لِمَرَرِ الخُطوبِ","تَكُفُّ غَربَ الزَمَنِ العَصيبِ",9,"ب",1,0],["ناقَةٌ لِلآِلَهِ تَسرَحُ في الأَرضِ","وَتَنتابُ حَولَ ماءٍ قَديرا",10,"ر",2,0],["ناقضَ العهدِ مُخلفَ الوعد أفشَى","في جميع الإناث فحشا عميما",11,"م",2,0],["نَاقِصُ العَقلِ مَن يُعَارِضُ مَرءاً","نَصَرَ اللهُ مَا يَقُولُ بِفِيهِ",12,"ي",2,1],["نَاقِفٌ حنظَلاً أوَ أبلَهُ أو مَا","مُومٌ أو ذُو اختِبَالٍ أو نَشوَانُ",13,"ن",1,0],["نَاقِصَ العَقلِ طَامِسَ الأصلِ والفَصلِ","مُرِبًّا بِكُلِّ عَارٍ مُقِيمَا",14,"م",2,0],["ناقَضتَ حُكمَهُمُ لَمّا أَبَحتَهُمُ","ما قَد سَلَبتَ بِأَطرافِ القَنا السُلُبِ",15,"ب",1,0],["ناقَضتَهُم فَوَهَبتَ ما ضَنّوا بِهِ","وَحَفِظتَ غَيرَ مُنازِعِ ما ضَيَّعوا",16,"ع",3,0],["ناقِمٌ عَلى السَماء","حاقِدٌ عَلى البَشَر",17,"ر",1,1],["ناقِلاً مِن ذَوائِبِ الزَهرِ السَب","طِ حَديثاً إِلى ثَراها الجَعدِ",18,"د",1,0],["ناقِضٌ في الوَغى جُيوشَ الأَعادي","مُستَطيلٌ بِالنَقضِ وَالإِبرامِ",19,"م",1,0],["ناقبات في الأرض والسقف والحي","طان نقبا أعيا على النقاب",20,"ب",1,0],["ناقضت ما قلت يا جهول","ما هكذا تفعل الفحول",21,"ل",1,1],["ناقلات من الخلائق عشرا","ت بادنى الاجور فيها جلوس",22,"س",1,0],["ناقدي ما كان إلا حاسدي","أو غبيّ مستطيب خرفه",23,"ف",2,0],["ناقَتُهُ والهَجيرُ نارٌ","تُرْقِلُ منْ تَحْتِهِ وتَخْدي",24,"د",2,0],["ناقضون عهودا","دون أخذ ورد",25,"د",1,0],["ناقَضْتَ مَذْهَبَهُمْ وحِفْتَ عَن الْهُدى","وهَدَمْتَ شامِخَ مَجْدٍ عِلْمٍ أَمْجَدِ",26,"د",1,0],["ناقعاتٍ إن حساهُن","نَ الفتى كلَّ أُوامِ",27,"م",1,0],["ناقماً منك أن تقوم بما أل","قى عليك الزمان من أثقاله",28,"ل",2,0],["ناقباتٍ في الأرض والسقف والحا","ئطِ نقباً أعيا على النقَّاب",29,"ب",1,0],["ناقصها يكون باسم وخبر","وللتمام غنيةُ عن الخبر",30,"ر",1,0],["ناقةُ اللَه أنكروها وظلماً","عقروها فحقَّت النكباء",31,"ا",2,0],["ناقُ سيري قَد جَدَّ حَقّاً بِنا السي","رُ وَكوني جَوّالَةً في الزِمامِ",32,"م",1,0],["ناقُ إِنّي أَرى المَقامَ عَلى الضي","مِ عَظيماً في قُبَّةِ الإِسلامِ",32,"م",1,0],["ناقص الراي تاجرَ البر وَالبح","ر وناهيك فارِسٌ في التجار",33,"ر",1,0],["نَاقِعٌ ماء بشره غلة الص","ادي ونيران فكره في التهابِ",34,"ب",1,0],["ناق هيا جدي المسير وجوزي","بحمى كل من تخطاه جوزي",35,"ز",2,1],["ناقضتُهم أن نَوَوا هجري ولو بُدلت","حالي وعدتُ رضيعاً غير منفطمِ",36,"م",1,0],["ناقل السر وما أعجبه","في رحاب الكون من سر جهير",37,"ر",1,0],["ناقص خصراً ولكن","ردفه واف متمم",38,"م",1,0],["ناقصه فيني اماكن تحتري حلو المزايا","عاجزن حلمي بدونه/ ولا اظن الطب يشفي",39,"ف",2,0],["ناقشت في حبه من جاء يعذلني","والمسك في خده للورد قد نقشا",40,"ش",2,0],["ناقشونا وأبدعوا واحْتَملْنا","ما أشارت ْ إليه تلك َ الثِّقات ُ",41,"ت",1,0],["نَاقص صبره كثير بكاه","لَو رَآهُ عدوه لرثى لَهُ",42,"ل",2,0],["ناقد الاشعار لك مني سلام","والتحيه للفكر والاحترام",43,"م",1,1],["ناقدي خذ حرفي وحل الرموز","وحلل المعنى بوجد المستهام",43,"م",1,0],["ناقشتُ شمعي فيكِ ، قال كبيرهم","هي من بنات الغيم أو هي عندَمُ",44,"م",1,0],["ناقش عليه ،، إسمك ،، بدم ٍ تجمّد","وبحرارة ملا قاك ، سالت حروفي",45,"ف",2,0],["ناقِشْهُ فِيْ أمْرِ الغَرام مَسائلاً","منها العَويص وبَعض مَا لَمْ أفْهَمِ",46,"م",1,0],["نَاقَشْتُ ماهِيَّتِي في كيف أنسبها","فقالتِ: الطِّيْنُ والأنوارُ ، يا فَهِمُ",47,"م",1,1],["ناقلاً ما جرى ليعتبروا ما","صبه الله من نكالٍ مبيد",48,"د",1,0],["ناقوسُ كعبكِ في سمائي عائثٌ","الله يكفي كعبها مما بي",49,"ب",2,0]]}