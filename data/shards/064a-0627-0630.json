في الخلا",175,"ل",2,0],["يَا ذَا الَّذِي عِندَهُ حَيَاتِي","بِاللهِ بِاللهِ أَبقِ عَنِّي",176,"ن",2,1],["ياذا المنوّه تَدعوني لِتُسمِعَني","مواعظاً مِن جَميلٍ رأيُهُ حَسَنِ",177,"ن",1,1],["يا ذاهباً عنّي ولي من بعده","قلبٌ به متلهّبٌ متأجّجُ",178,"ج",1,0],["يا ذوينا وأمنا وأبينا","نسب الحب بيننا هو راسي",179,"س",2,1],["يا ذوي الإعتقاد فينا ويا من","أسسونا على أتم أساس",179,"س",1,0],["يا ذا الذي لامني جهلاً رويدك بي","فأنت عندي محسوب من البقر",180,"ر",1,0],["يا ذا المحيط بنا كما","هو بالجميع له النفود",181,"د",1,0],["يا ذا الذي مِنْ بِعادُهْ مدمعُهْ مسكوبْ","نفسَكْ حجابَكْ أَمِتْها تشهَدْ المطلوبْ",182,"ب",1,0],["يا ذِكرَةً ذَكَرتُ لَيلى بَعدَما","جالَ الفُؤادُ جَولَةً وَاستَهزَما",183,"م",2,0],["يا ذا الذي يُعطِي الوُفُودَ لِسانُهُ","دُرَراً وتُعطِي راحتَاهُ العَسْجدا",184,"د",2,0],["يا ذاهباً حيثُ لا نَدري لهُ خَبَرا","تَفِدي لنا ذاهباً نَدرِي لهُ خَبَرا",185,"ر",2,0],["يَا ذَا الذِي بِعْتُهُ فُؤَادَاً","مَا كَانَ لَولاَ الهَوَى يُبَاعُ",186,"ع",1,0],["يا ذا الَّذِي يُطْرِبُه كُلَّما","قيل له إِنَّ فُلاناً سَقِيمْ",187,"م",1,1],["يا ذهبيَّ اللَّونِ أَذْهَبْتَني","ويا فريدَ الحسنِ دَمْعِي فَرِيدْ",188,"د",1,0],["يا ذَا الَّذي صَدَّ عَنْ مُحِبٍّ","به أَذابَ الغَرامُ قَلْبَهْ",189,"ه",1,1],["يا ذَا القَمَرُ المُنيرُ في الآفاقِ","الصَّبْرُ فُنِي فِيكَ وَوَجْدِي باقي",190,"ي",1,1],["يا ذا الَّذي يَطْمَعُ في سَلْوَتي","أَهكذا قالَ لَهُ عَقْلُهُ",191,"ل",2,0],["يَا ذَا الَّذي نَامَ عَنْ جُفُوني","وَنَبَّهَ الوَجْدَ والجَوَى لِي",192,"ي",1,1],["يا ذَا الَّذي يَرْوي الحَدِي","ثَ وَلَيْسَ يُرْوَى بالقديمِ",193,"م",1,1]]}