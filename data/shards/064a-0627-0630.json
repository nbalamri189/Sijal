https://poetry.dctabudhabi.ae/diwan/poem/12745","السريع"],[90,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=179230",""],[51,"يا ذا الذي كُنْيتي","https://www.poetsgate.com/ViewPoem.aspx?id=29389",""],[31,"يا ذا الذي في الحبّ يلحى ، أما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19087&r=&rc=349",""]],"verses":[["يَإِذا الحُسَينُ دَعاهُمُ بِجِيادِهِم","حُشِدَت إِلَيهِ مُصِرَّةَ الآذانِ",0,"ن",1,0],["يا ذُلَّ ما عِندَكِ مِن أَوجُهٍ","كُنَّ كِراماً أَبَداً عِندَنا",1,"ن",2,0],["يا ذابِلاً صَوَّحَ فَينانُهُ","قَد آنَ لِلذابِلِ أَن يُختَلى",2,"ل",2,0],["يا ذاكِرَ النَعماءِ إِن نُسِيَت","وَمَجَدِّدَ المَعروفِ إِن دَرَسا",3,"س",2,1],["يا ذا المَعارِجِ كَم سَأَلتُكَ نِعمَةً","فَمَنَحتَنيها بِالذَنوبِ الأَوفَرِ",4,"ر",1,1],["يا ذا الَّذي كَتَبَ الكِتابَ يَسُبُّني","فيهِ فَبالَغَ في الكِتابِ وَأَعجَما",5,"م",2,0],["يا ذا الرَسولُ الَّذي يَهدي السُرورَ لَنا","إِنّي لَتَحسُدُ عَيني عَينَكَ النَظَرا",6,"ر",2,0],["يا ذا الَّذي صَدَعَ الفُؤادَ بِصَدِّهِ","أَنتَ البَلاءُ طَريفُهُ وَالتالِدُ",7,"د",1,0],["يا ذا الَّذي أَنكَرَني طَرفُهُ","إِذ ذابَ جِسمي وَعَلاني شُحوب",8,"ب",1,1],["يا ذَا الذُّؤابَةِ إلا أنّهُ سَعْدُ","هلْ يَقْرُبُ الوَصْلُ أو هلْ يُنْجَزُ الوعْدُ",9,"د",1,1],["يَا ذَا الرِّيَاسَاتِ الَّتِي أَضْفَتْ عَلَى","وَادِي الكِنَانَةِ وَارِفَاتِ ظلالِهَا",10,"ل",3,0],["يَا ذِي الحُرُوفُ أَأَنْتِ عَالِمَةٌ بِمَا","أَوْلَيْتِهِ مِنْ طَائِلِ الإِحْسَانِ",11,"ن",1,0],["يَا ذَا المَكَانَةِ فِي سَرَاةِ","الخَلْقِ بِالخُلُقِ النَّبِيلْ",12,"ل",1,0],["يا ذا العَباءَةِ إِنَّ بِشراً قَد قَضى","أَن لا تَجوزَ حُكومَةُ النَشوانِ",13,"ن",1,0],["يا ذا البلاغة أسلاكاً على حلل","فالفضل ما بين وشّاء ووشَّاح",14,"ح",1,0],["يا ذا الندى السعدي دمت مهنئاً","ببسيط مدح كامل ومديد",15,"د",1,1],["يا ذا البراعة من أسعفت مدحته","لقد أعدْت إلى بحرٍ جواهره",16,"ر",2,0],["يا ذا الرغائب من نوا","لك لا أصوم ولم أصم",17,"م",1,0],["يا ذا اليراع المجتلي بارقاً","وفي فجاج الأرض هتانه",18,"ن",2,0],["يا ذائقَ الموتى لتعلم هل بَقُوا","بعد التَّقادُمِ منهمُ بدَواءِ",19,"ا",2,1],["يا ذا الشبابِ الذي أضحتْ مَناسِبُهُ","قد بُدِّلتْ فيه أنواعاً من النُّدَبِ",20,"ب",1,0],["يا ذا الذي لو هجاه مادحه","عُوقب هَلّا يثاب بالمِدَحِ",21,"ح",1,1],["يا ذا الذي ضنَّ بآزَاذِهِ","تَعَرُّضاً منا لتوبيخِهِ",22,"خ",2,1],["ياذِجاراتٌ سنشربها","لك فيه جمَّةُ العَدَدِ",23,"د",1,0],["يا ذا الذي قد حال عن عهدي","وحلَّ ما أكَّدتُ من عَقْدِ",24,"د",1,1],["يا ذا الذي كُنيتُهُ كُنْيتي","أما رعيتَ الودّ والخُلْطَهْ",25,"ط",2,1],["يا ذاكر الغنم عند مغرمه","وذاكر الريع حين يزدرع",26,"ع",1,0],["يا ذا العلاء الذي أرسى قواعده","على الحضيض وجاز النجم أعرافا",27,"ف",2,0],["يا ذا الذي ضنَّ بمعروفه","عني وقد قاسيت فيه الأرقْ",28,"ق",1,1],["يا ذا الطواحن قل لي","بالله ربك حقّا",29,"ق",2,1],["يا ذا الوسائلِ إن المستقى رَفِقٌ","ليستْ له غيرَ أيدي الناسِ أشطان",30,"ن",1,0],["يا ذا الذي منه التَّنَكْ","كُرُ والتغيُّرُ والنُّبُوُّ",31,"و",1,1],["يا ذا النَدى وَالمَعالي","وَالعِشرَةَ المُستَطابَه",32,"ب",2,1],["يا ذئب انت شرير","يا ذئب انت خبيث",33,"ث",1,1],["يا ذا الغِنَى والبُخْلِ مالَكَ مِنْ غِنى","وكذاكَ يا ذا المالِ مالكَ مالُ",34,"ل",1,0],["يا ذا المَعالي وَمَعدِنَ الأَدَبِ","سَيِّدَنا وَاِبنَ سَيِّدِ العَرَبِ",35,"ب",1,1],["يا ذا الَّذي يَهَبُ الجَزيلَ وَعِندَهُ","أَنّي عَلَيهِ بِأَخذِهِ أَتَصَدَّقُ",36,"ق",1,0],["يا ذا الَّذي يَطلُبُ مِنّي الوِترا","إِن كُنتَ تَبغي أَن تَزورَ القَبرا",37,"ر",2,1],["يا ذا الَّذي اِتَّخَذَ الزَمانَ مَطِيَّةً","وَخُطا الزَمانِ كَثيرَةُ العَثَراتِ",38,"ت",1,0],["يا ذا الَّذي نَقصُهُ زِيادَتُهُ","إِن كُنتَ لَم تَنتَقِص فَلَم تَزِدِ",39,"د",1,0],["يا ذا المُقيمُ بِمَنزِلٍ أَشِبٍ","وَمَقامُ ساكِنِهِ بِهِ دَحضُ",40,"ض",1,0],["يا ذا الَّذي يَقرَءُ في كُتبِهِ","ما قَد نَهى اللَهُ وَلا يَعمَلُ",41,"ل",1,1],["يا ذا الَّذي يَشتَهي ما لا ثَوابَ لَهُ","تَبغي الثَوابَ فَكُن حَمّالَ أَثقالِ",42,"ل",1,0],["يا ذا الَّذي يَومُهُ آتٍ بِساعَتِهِ","وَإِن تَأَخَّرَ عَن عامٍ إِلى عامِ",43,"م",1,0],["يا ذا النَدامَةِ عِندَ ميتَتِهِ","وَالمَوتُ لَيسَ يُقالُ نادِمُهُ",44,"م",2,0],["يا ذا الَّذي سَيَرُصُّ وا","رِثُهُ عَلَيهِ ثَراً وَلِبنا",45,"ن",2,0],["يا ذا الغَوايَةِ لا تَكُن","مِمَّن تَعَبَّدَهُ هَواه",46,"ا",2,0],["يا ذا الَّذي شَغَلَ الزَمانَ بِنَفسِهِ","فَأَصَمَّ سَمعَ طَوارِقِ الحِدثانِ",47,"ن",1,0],["يا ذا الَّذي خَطَبَ المَديحَ سَماحُهُ","فَنَداهُ قَبلَ نِدايَ قَد لَبّاني",47,"ن",2,0],["يا ذنبُ فات المتاب","لما تحطًَّم صرحي",48,"ي",1,0],["يا ذنوبي ثَقّلْتِ واللّه ظَهْري","بانَ عُذْري فكيفَ يُقْبَلُ عذري",49,"ر",2,1],["يا ذائِدَ الهيمِ الخَوامِسِ وَفِّها","عِشراً وَوافِ بِها حِياضَ مُحَمَّدِ",50,"د",1,0],["يَا ذُكْرَةً أَبْصَرْتُ فِي","مِرْآتِهَا صُوَرَ التَّمَنِّي",51,"ن",2,1],["يا ذا الَّذي في الحُبِّ يَلحى أَما","تَخشى عِقابَ اللَهِ فينا أَما",52,"م",2,1],["ياذا القِلادةِ إنّها لَكَ آيةٌ","مِن مَظهرِ الشَّرفِ الأعزِّ الأرفعِ",53,"ع",1,0],["يا ذا الجَلالَةِ لا سَعِدتَ بِتاجِهِ","مُلكاً سِواكَ بِهِ السَعيدُ الهاني",54,"ن",2,0],["يا ذا الجَلالَةِ في مَآلِكَ عِبرَةٌ","لِلمالِكينَ وَساءَ ذاكَ مَآلا",55,"ل",2,0],["يا ذا الَّذي تَسخَرُ عَيناهُ","بي مِنكَ ما يَعلَمُهُ اللَهُ",56,"ه",1,1],["يا ذا البَديهَةِ في المقالِ أما كَفَتْ","بَدَهَاتُ هذا النّقضِ والإبرام",57,"م",1,1],["يا ذا الَّذي يَخطِرُ في مِشيَتِه","قَد صَفَّفَ الشَعرَ عَلى جَبهَتِه",58,"ت",2,1],["يا ذا الَّذي عَن جِنانٍ ظَلَّ يُخبِرُني","بِاللَهِ قُل وَأَعِد يا طَيِّبَ الخَبَرِ",59,"ر",1,1],["يا ذا الَّذي أُبعِدُهُ لِلَّذي","أَسمَعُ فيهِ وَهُوَ الجارُ",60,"ر",1,0],["يا ذا الَّذي نَقَضَ العُهودَ وَمَلَّني","ما كُنتُ أَعلَمُ أَنَّ ذا سَيَكونُ",61,"ن",1,0],["يا ذا الَّذي طُوِّحَ العِبادُ بِهِ","في فِتنَةٍ مِن أَعاظِمِ الفِتَنِ",62,"ن",1,0],["يا ذا المُقَحِّمُ سادِراً","أَقصِر فَإِنَّكَ غَيرُ راشِد",63,"د",1,0],["يا ذا المُخَوِّفَنا بِقَت","لِ أَبيهِ إِذلالاً وَحَينا",64,"ن",2,1],["يا ذا المُخَوِّفَنا بِمَقتَلِ شَيخِهِ","حُجرٍ تَمَنِّيَ صاحِبِ الأَحلامِ",65,"م",1,0],["يا ذا الذي خطَّ الجمالُ بخَدِّهِ","خَطَّينِ هاجا لوعةً وبَلابِلا",66,"ل",2,1],["يا ذَوي العَودِ ذَوى عُودُ وِدا","ديَ مِنكُمْ بعدَ أن أينَعَ ذَي",67,"ي",1,0],["يا ذئب حبل رجاوتي","في أن تسالمنا رثيث",68,"ث",1,0],["يا ذاهباً لم يَشفِ مني الغليل","ما أسرع العقربَ عند الرحيل",69,"ل",1,0],["يا ذا الذي يهب الكثير وعنده","أني عليه بأخذه أتصدق",70,"ق",1,0],["يَاذَا الأَيادِي البَيْضَاءَ كَمْ لَكَ مِنْ","حَقٍّ عَزِيزِ الوَفَاءِ فِي عُنقِ",71,"ق",1,0],["يَا ذَاتَ قَدْرٍ كُلُّ مَنْ فِي الحِمَى","يَجُلهُ يَرْعَاكِ رَبَّ الحَلاَلْ",72,"ل",1,0],["يَا ذَاتَ حُسْنٍ أَكْمَلَتْ حُسْنَهَا","بِالأَدَبِ الوَافِرِ وَالرُّشْدِ",73,"د",1,0],["يا ذابح العنقود خضب كفه","بدمائه بوركت من سفاح",74,"ح",1,0],["يا ذا الَّذي نَمَّ عَلَينا لَقَد","قُلتَ وَمِنكَ القَولُ مَسموعُ",75,"ع",1,0],["يا \" ذكرياتُ \" تَحَشَّدي فِرقا","تسَعُ الخيالَ وتملأُ الأُفُقا",76,"ق",2,1],["يا ذكريات تجسَّدي بَدَناً","غضَّ الصِّبَا ، وتعطَّري خُلُقا",76,"ق",2,0],["يا ذكرياتٌ كلُّها حُرقٌ","تَطَأ الفُؤادَ ، وتلهبُ الحَدَقا",76,"ق",2,0],["يا ذا الذي كُنْيتي","أما رعيتَ الودّ والخُلْطهْ",77,"ط",2,1],["يا ذا الذي في الحبّ يلحى ، أما","تَخْشَى عِقَابَ کللَّهِ فينا، أَما",78,"م",2,1]]}