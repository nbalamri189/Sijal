ن مثل ما","https://www.aldiwan.net/poem60247.html","السريع"],[466,"يا ذا الذي لم يدع لي","https://www.aldiwan.net/poem60295.html","المجتث"],[466,"يا ذا الذي حمله جهله","https://www.aldiwan.net/poem60494.html","السريع"],[493,"إن لم يكن هذا الصدود فصالا","https://www.aldiwan.net/poem10260.html","الكامل"],[493,"وكلني بالهم والكآبة","https://www.aldiwan.net/poem10290.html","الرجز"],[536,"يا ذا الذي عنده حياتي","https://www.aldiwan.net/poem47913.html","عموديه"],[538,"ياذا المنوه تدعوني لتسمعني","https://www.aldiwan.net/poem56644.html","البسيط"],[549,"كم ذا سرى بالموت عنا مدلج","https://www.aldiwan.net/poem48018.html","الكامل"],[556,"يا ذوينا وأمنا وأبينا","https://www.aldiwan.net/poem34437.html","الخفيف"],[556,"يا طلعة الشمس أو يا طلعة القمر","https://www.aldiwan.net/poem34551.html","البسيط"],[556,"إني أنا بك يا ودود","https://www.aldiwan.net/poem34580.html","مجزوء الكامل"],[556,"ظاهر ومن يعشقه عن رؤيته محجوب","https://www.aldiwan.net/poem34969.html","المواليا"],[559,"طاف الخيالان فهاجا سقما","https://www.aldiwan.net/poem27844.html","الرجز"],[560,"هذه عروس الزهر نقطها الندى","https://www.aldiwan.net/poem52865.html","الكامل"],[560,"قد عاهد الدهر أهليه فما غدرا","https://www.aldiwan.net/poem52874.html","البسيط"],[565,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[573,"يا ذا الذي يطربه كلما","https://www.aldiwan.net/poem3016.html","السريع"],[573,"أمورد يا ناظري أم وريد","https://www.aldiwan.net/poem3088.html","الرجز"],[584,"يا ذا الذي صد عن محب","https://www.aldiwan.net/poem17433.html","مخلع البسيط"],[584,"يا ذا القمر المنير في الآفاق","https://www.aldiwan.net/poem17632.html","الدوبيت"],[584,"جار فهيهات يرى عدله","https://www.aldiwan.net/poem17655.html","السريع"],[584,"يا ذا الذي نام عن جفوني","https://www.aldiwan.net/poem17682.html","مخلع البسيط"],[584,"يا ذا الذي يروي الحدي","https://www.aldiwan.net/poem17753.html","مجزوء الكامل"]],"verses":[["يَإِذا الحُسَينُ دَعاهُمُ بِجِيادِهِم","حُشِدَت إِلَيهِ مُصِرَّةَ الآذانِ",0,"ن",1,0],["يا ذُلَّ ما عِندَكِ مِن أَوجُهٍ","كُنَّ كِراماً أَبَداً عِندَنا",1,"ن",2,0],["يا ذابِلاً صَوَّحَ فَينانُهُ","قَد آنَ لِلذابِلِ أَن يُختَلى",2,"ل",2,0],["يا ذاكِرَ النَعماءِ إِن نُسِيَت","وَمَجَدِّدَ المَعروفِ إِن دَرَسا",3,"س",2,1],["يا ذا المَعارِجِ كَم سَأَلتُكَ نِعمَةً","فَمَنَحتَنيها بِالذَنوبِ الأَوفَرِ",4,"ر",1,1],["يا ذا الَّذي كَتَبَ الكِتابَ يَسُبُّني","فيهِ فَبالَغَ في الكِتابِ وَأَعجَما",5,"م",2,0],["يا ذا الرَسولُ الَّذي يَهدي السُرورَ لَنا","إِنّي لَتَحسُدُ عَيني عَينَكَ النَظَرا",6,"ر",2,0],["يا ذا الَّذي صَدَعَ الفُؤادَ بِصَدِّهِ","أَنتَ البَلاءُ طَريفُهُ وَالتالِدُ",7,"د",1,0],["يا ذا الَّذي أَنكَرَني طَرفُهُ","إِذ ذابَ جِسمي وَعَلاني شُحوب",8,"ب",1,1],["يا ذَا الذُّؤابَةِ إلا أنّهُ سَعْدُ","هلْ يَقْرُبُ الوَصْلُ أو هلْ يُنْجَزُ الوعْدُ",9,"د",1,1],["يَا ذَا الرِّيَاسَاتِ الَّتِي أَضْفَتْ عَلَى","وَادِي الكِنَانَةِ وَارِفَاتِ ظلالِهَا",10,"ل",3,0],["يَا ذِي الحُرُوفُ أَأَنْتِ عَالِمَةٌ بِمَا","أَوْلَيْتِهِ مِنْ طَائِلِ الإِحْسَانِ",11,"ن",1,0],["يَا ذَا المَكَانَةِ فِي سَرَاةِ","الخَلْقِ بِالخُلُقِ النَّبِيلْ",12,"ل",1,0],["يا ذا العَباءَةِ إِنَّ بِشراً قَد قَضى","أَن لا تَجوزَ حُكومَةُ النَشوانِ",13,"ن",1,0],["يا ذا البلاغة أسلاكاً على حلل","فالفضل ما بين وشّاء ووشَّاح",14,"ح",1,0],["يا ذا الندى السعدي دمت مهنئاً","ببسيط مدح كامل ومديد",15,"د",1,1],["يا ذا البراعة من أسعفت مدحته","لقد أعدْت إلى بحرٍ جواهره",16,"ر",2,0],["يا ذا الرغائب من نوا","لك لا أصوم ولم أصم",17,"م",1,0],["يا ذا اليراع المجتلي بارقاً","وفي فجاج الأرض هتانه",18,"ن",2,0],["يا ذائقَ الموتى لتعلم هل بَقُوا","بعد التَّقادُمِ منهمُ بدَواءِ",19,"ا",2,1],["يا ذا الشبابِ الذي أضحتْ مَناسِبُهُ","قد بُدِّلتْ فيه أنواعاً من النُّدَبِ",20,"ب",1,0],["يا ذا الذي لو هجاه مادحه","عُوقب هَلّا يثاب بالمِدَحِ",21,"ح",1,1],["يا ذا الذي ضنَّ بآزَاذِهِ","تَعَرُّضاً منا لتوبيخِهِ",22,"خ",2,1],["ياذِجاراتٌ سنشربها","لك فيه جمَّةُ العَدَدِ",23,"د",1,0],["يا ذا الذي قد حال عن عهدي","وحلَّ ما أكَّدتُ من عَقْدِ",24,"د",1,1],["يا ذا الذي كُنيتُهُ كُنْيتي","أما رعيتَ الودّ والخُلْطَهْ",25,"ط",2,1],["يا ذاكر الغنم عند مغرمه","وذاكر الريع حين يزدرع",26,"ع",1,0],["يا ذا العلاء الذي أرسى قواعده","على الحضيض وجاز النجم أعرافا",27,"ف",2,0],["يا ذا الذي ضنَّ بمعروفه","عني وقد قاسيت فيه الأرقْ",28,"ق",1,1],["يا ذا الطواحن قل لي","بالله ربك حقّا",29,"ق",2,1],["يا ذا الوسائلِ إن المستقى رَفِقٌ","ليستْ له غيرَ أيدي الناسِ أشطان",30,"ن",1,0],["يا ذا الذي منه التَّنَكْ","كُرُ والتغيُّرُ والنُّبُوُّ",31,"و",1,1],["يا ذا النَدى وَالمَعالي","وَالعِشرَةَ المُستَطابَه",32,"ب",2,1],["يا ذئب انت شرير","يا ذئب انت خبيث",33,"ث",1,1],["يا ذا الغِنَى والبُخْلِ مالَكَ مِنْ غِنى","وكذاكَ يا ذا المالِ مالكَ مالُ",34,"ل",1,0],["يا ذا المَعالي وَمَعدِنَ الأَدَبِ","سَيِّدَنا وَاِبنَ سَيِّدِ العَرَبِ",35,"ب",1,1],["يا ذا الَّذي يَهَبُ الجَزيلَ وَعِندَهُ","أَنّي عَلَيهِ بِأَخذِهِ أَتَصَدَّقُ",36,"ق",1,0],["يا ذا الَّذي يَطلُبُ مِنّي الوِترا","إِن كُنتَ تَبغي أَن تَزورَ القَبرا",37,"ر",2,1],["يا ذا الَّذي اِتَّخَذَ الزَمانَ مَطِيَّةً","وَخُطا الزَمانِ كَثيرَةُ العَثَراتِ",38,"ت",1,0],["يا ذا الَّذي نَقصُهُ زِيادَتُهُ","إِن كُنتَ لَم تَنتَقِص فَلَم تَزِدِ",39,"د",1,0],["يا ذا المُقيمُ بِمَنزِلٍ أَشِبٍ","وَمَقامُ ساكِنِهِ بِهِ دَحضُ",40,"ض",1,0],["يا ذا الَّذي يَقرَءُ في كُتبِهِ","ما قَد نَهى اللَهُ وَلا يَعمَلُ",41,"ل",1,1],["يا ذا الَّذي يَشتَهي ما لا ثَوابَ لَهُ","تَبغي الثَوابَ فَكُن حَمّالَ أَثقالِ",42,"ل",1,0],["يا ذا الَّذي يَومُهُ آتٍ بِساعَتِهِ","وَإِن تَأَخَّرَ عَن عامٍ إِلى عامِ",43,"م",1,0],["يا ذا النَدامَةِ عِندَ ميتَتِهِ","وَالمَوتُ لَيسَ يُقالُ نادِمُهُ",44,"م",2,0],["يا ذا الَّذي سَيَرُصُّ وا","رِثُهُ عَلَيهِ ثَراً وَلِبنا",45,"ن",2,0],["يا ذا الغَوايَةِ لا تَكُن","مِمَّن تَعَبَّدَهُ هَواه",46,"ا",2,0],["يا ذا الَّذي شَغَلَ الزَمانَ بِنَفسِهِ","فَأَصَمَّ سَمعَ طَوارِقِ الحِدثانِ",47,"ن",1,0],["يا ذا الَّذي خَطَبَ المَديحَ سَماحُهُ","فَنَداهُ قَبلَ نِدايَ قَد لَبّاني",47,"ن",2,0],["يا ذنبُ فات المتاب","لما تحطًَّم صرحي",48,"ي",1,0],["يا ذنوبي ثَقّلْتِ واللّه ظَهْري","بانَ عُذْري فكيفَ يُقْبَلُ عذري",49,"ر",2,1],["يا ذائِدَ الهيمِ الخَوامِسِ وَفِّها","عِشراً وَوافِ بِها حِياضَ مُحَمَّدِ",50,"د",1,0],