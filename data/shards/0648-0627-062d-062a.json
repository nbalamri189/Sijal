19",""],[6256,"كلمات إليها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65934&r=&rc=22",""],[5190,"الحسناء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78290&r=&rc=4",""]],"verses":[["وَاِحتَمِل سَطوَةَ العِتابِ فَخَيرُ ال","نَبعِ ما مَدَّ مَتنَهُ التَثقيفُ",0,"ف",1,0],["وَاِحتَلَّ غارِبَهُ وَلِيُّ خِلافَةٍ","ما كانَ يَلبَسُها عَلى أَلباسِ",1,"س",1,0],["واحْتَوَشَتْهُ نُوَبٌ للفَتى","فيهِنَّ تَصْعيدٌ تَصويبُ",2,"ب",1,0],["واحْتَلّ بيْتَ اللّيْثِ في آثارِهِ","زُحَلٌ وليْثُ الغابِ يُرْهَبُ زارُهُ",3,"ر",2,0],["واحْتَملتُ الأمْرَ إذْ أبْصَرْتُهُ","باعَ ما أفْقَدَني منْ ولَدي",4,"ي",1,0],["وَأَحتَثُّ بَينَ وُفودِ السَراةِ","مَطايا الرَجاءِ لِذاكَ الرَحَب",5,"ب",1,0],["واحتَوَشَتها كلاب مَجزَرة","مهترشات يَهيجها الكَلَب",6,"ب",1,0],["واحتل بركُ الشتاء منزلَه","وبات شيخُ العيالِ يصطلِب",7,"ب",1,1],["واحتَضَرَ المُوقِدُونَ إذ عَزَل ال","وَاغِلُ منها النِفَارُ والزَّبَبُ",8,"ب",1,0],["واحتضى الموقدون اذ عزل","الواغل منها النغار والريب",9,"ب",1,0],["واحتملني إن تحالي","تُ وأغربتُ بمُلحَه",10,"ح",2,0],["واحتراسُ الدُهاة منك وإعصا","فُكَ بالأقوياءِ والضعفاءِ",11,"ا",2,0],["واحتشمْ أن يراك مُعطيك ما أع","طاك تَجزِي نَعْماءه خُيَلاءَ",12,"ا",2,0],["واحتل من عاداه في منزل","حميمه آنٍ وغساقه",13,"ق",2,0],["واحتملنا مقالة الناسِ فينا","ولَهم كلُّ ما احتملنا وفيهِمْ",14,"م",1,0],["وَاِحتَواها نَهِمٌ لا يَشبَعُ","فَاِحتَوى سُكّانَها خَوفٌ وَجوع",15,"ع",1,0],["واحتضنِّي فإنَّني لكَ حتَّى","يتوارى هذا الدُّجى ونجومُهْ",16,"م",2,0],["واحتيال على خيال من المج","د ودعوى من العراض الطوال",17,"ل",1,0],["وَاِحتَرِم في بابِهِ مَن دَخَلا","كُلُّهُم مِنهُ رَسولٌ وَصَلا",18,"ل",2,0],["وَاِحتِمالُ الأَذى وَرُؤيَةُ جاني","هِ غِذاءٌ تَضوى بِهِ الأَجسامُ",19,"م",1,0],["وَاِحتَرِس مِن ضَياعِ حِلمِكَ في الجَف","وَةِ وَالاِنقِباضِ إِن ضاعَ حِلمي",20,"م",2,0],["واحتدَمَ المِقدارُ في احتدامِه","واستنزلَ السِّربَ على أحكامِه",21,"م",2,0],["واحتالَ في نَظمِ الثَّناءِ ونَثرِه","في مُشرقاتِ قَلائِدٍ وشُنوفِ",22,"ف",1,0],["واحتجبَتْ في كِلَلِ الرَّقْمِ دمىً","تَأنَقُ أثناءَ الحِجالِ والحُجُبْ",23,"ب",1,0],["وَاِحتِيالي بِما عَلَيَّ وَلا لي","وَاِشتِغالي بِكُلِّ ما يُلهيني",24,"ن",2,0],["واحتيالي على الكرى وبجفني","يَ قتادٌ ولي من الشوك مرقد",25,"د",1,0],["واحتفلْ للفقهِ في الدينِ ولا","تشتغلْ عنهُ بمالٍ أوْ خَوَلْ",26,"ل",1,0],["واحتوى التَّاجُ المحلَّى دُرَّةً","منكِ مَن يلمحْ سناها يُطرِق",27,"ق",1,0],["وَاِحتَلَّ بَيتُكَ حَيثُ حلْ","لَ بِذِرَوَةِ القُحَمِ الأَطاوِل",28,"ل",1,0],["وَأَحتَضِرُ النادي وَوَجهِيَ مُسفِرٌ","وَأَضرِبُ عِطفَ الأَبلَخِ المُتَخَيِّلِ",29,"ل",1,0],["وَاِحتَلَّ أَهلُكِ سيفَ كاظِمَةٍ","فَأَشَتَّ ذاكَ الهَجرُ وَاِختَلَفا",30,"ف",2,0],["وَاِحتَسَينا مِن عَتيقٍ عُقارٍ","خُسرَوِيٍّ كامِنٍ في لِيانِ",31,"ن",1,0],["وَاِحتازَها لَونٌ جَرى في جِلدِها","يَقَقٌ كَقِرطاسِ الوَليدِ هِجانُ",32,"ن",1,0],["واحتملَ التَّقوى على جَبينهِ","والدينَ والدُّنيا على يمينهِ",33,"ه",1,0],["واحتلَّها بالعزِّ والتَّمكِينِ","ومحْوِ آثارِ بني حَفْصونِ",33,"ن",1,0],["واحتوتنا بَين لحن مطرب","حانةٌ مِثلُ أساطيرِ الزَّمانِ",34,"ن",1,0],["واحتوى رأسيَ الحزينَ ذراعا","ها ومرتْ على جبينيَ راحُ",35,"ح",1,0],["واحتوت سرَّ كائنين كأنْ لم","يُبْعَثا سيرةً مع الكائناتِ",36,"ت",1,0],["واحتوتهُ في أصيصٍ زهرةً","يسرِقُ الأنفاسَ من طيب شذاها",37,"ا",3,0],["واحتاجت الشام إلى همام","أروع يحمى عسكر الإمام",38,"م",1,0],["واحتَلَّ أَهلي بِالخَورَنقِ وال","حِيرةِ واحتَلُّوا بِذي خُشُبِ",39,"ب",1,0],["وَاحْتِمَالِ الْعفَاةِ نَعْشَ أَبِيهِمْ","موشِكاً أَنْ يَسْعَى بِهِ التَّقْبِيلُ",40,"ل",1,0],["وَاحْتَلَّ فِي الْعَلْيَاءِ مَنْزِلَةً","أَسْمَى مِنَ الأَلْقَابِ وَالرُّتَبِ",41,"ب",1,0],["واحتجب منك بي ولا تحتجب م","ني بسجف التأثير والايجاد",42,"د",1,0],["واحترق من محبتي أنا وحدي","من طباق النيران في كل وادي",42,"د",2,0],["واحتج منعطف أطارت صمته","ونعاسه نقالة الإسعاف",43,"ف",1,0],["واحتمى بالصلاة لم يدن منه","بصر الحيذ أو ظنون البصيرة",44,"ر",2,0],["واحتقرنا قطع الرؤوس وأدم","نّا المنايا في حانه السفاح",45,"ح",1,0],["واحتمى بالقوى فضجّ عليه","لهب عارم يلبّيه عارم",46,"م",1,0],["واحتوى الصمت الندا واضطربت","حول مصباح الفتى هوج الرياح",47,"ح",1,0],["واحتضنّا أطيافه في مآقينا","كما يحضن العشيق العشيقه",48,"ق",2,0],["واحترقنا شوقا إليه وذبنا","في كؤوس الهوى لحونا رقيقة",48,"ق",2,0],["واحتواها رهَجُ الحربِ فما","تُبصر الأرضَ عتواً وازدهاء",49,"ا",2,0],["واحتواهمْ كالموتِ نومٌ عميق","وتغشَّاهُمُ سكونٌ رهيب",50,"ب",1,0],["واحتواها \" صِنّينُ \" بينَ ذِراعيه","عجوزاً له رُواءُ الشَّباب",51,"ب",1,0],["واحترسُ الدهاة ِ منك","واعصا فُك بالاقوياء والضعفاء",52,"ا",2,0],["واحتيالي على الكرى وبجفنيَّ","قتادٌ ولي من الشوك مرقدْ",53,"د",1,0],["وَاِحتَسَبنا بِاللَهِ في كُلِ حالٍ","وَاِستَجَرنا بِسَيد الكَونينِ",54,"ن",1,0],["واحتمي بالهاشمي المصطفى","سيد الاكوان مصباح الرشد",55,"د",1,0],["واحتاط باس القطع","بالغير سبحان الله",56,"ه",1,0],["وأحتارُ في ما عَساني اقول","فنجثو كلانا على الرُكبة",57,"ه",1,0],["وَاحتَرِس من تَكَلًّفٍ واعتِسَافٍ","وانعِقَادِ مَعنًى ورَاعِ مَعنًى جَسِيمَا",58,"م",2,0],["واحتضَرتْها المُدَى نحتاً وقد فُلِقتْ","هاماتُها بين تصعيدٍ وتصويبِ",59,"ب",1,0],["وَاحْتَجَّ في قَتْلَتِهِ","بِأَنَّهُ مَا عَلِمَا",60,"م",2,0],["واحتراس من ظنون","السوء أو عذل عذول",61,"ل",1,0],["واحتلن حتى خلونا ساعة ولها","بعض ببعض فباب البيت مردود",62,"د",1,0],["واِحتِياجي إليكَ في كلّ ما يأ","تي وجلّت فيما مضى الآلاءُ",63,"ا",2,0],["وَاِحتَلَّ أَهلُكَ ذا القتودِ وَغُرَّباً","فَالصَحصَحانَ فَأَينَ مِنكَ نَواها",64,"ا",3,0],["واحتمالي عنك فرضٌ","في الهوى لو كان صَبرُ",65,"ر",1,0],["واحتشاما لاجله الشمس ردت","بعد ما اسبل الظلام حباله",66,"ل",2,0],["واحتذتْ أَرْبُعُ المنامِة حتّى","طلع البَدْرُ وهو فِيها سِرار",67,"ر",1,0],["وَاِحتَفِظ بي فَقَد مَحَضتُكَ إِن أَن","صَفتَ نَصحي في سائِرِ الأَبياتِ",68,"ت",1,0],["وَاحْتَسِبْ يَا طَالِبَ الْعِلْمِِ امْرَأً","مَاتَ فِيهِ الْعِلْمُ وَالدِّينُ مَعَا",69,"ع",2,0],["واحتجت أن أذكركم خيفة","بالخيرِ للواردِ والصادرِ",70,"ر",1,0],["واحتمى من لاذ في ذاك الحمى","كلّ من نحو حماه يمّما",71,"م",2,0],["واحتسى كأس المنى صرفاً وقد","غفر الله له أوزاره",72,"ر",2,0],["واحتَل تَنَل شيئاً وإلا تمُت","في لوعَةِ الحُرمانِ والصَدِّ",73,"د",1,0],["واحتلّ أندلسَ الجميلةَ طارقٌ","في وقعةٍ غراءَ ذات حجول",74,"ل",1,0],["واِحتَساها داودُ صِرفاً فأَضحى","ظافِراً في الوَغى على جالوتِ",75,"ت",1,0],["واحتفظ بالشرع وابغي به","حكم رب العرش في الصور",76,"ر",1,0],["واِحتَسِبها لدى حفيظٍ يوفّي الص","صابرين أجراً بغير حسابِ",77,"ب",1,0],["واحتراقي ووحدتي وبُكائي","ذبُلت زهرة الصبا والشباب",78,"ب",1,0],["واحتسوها سلافة","بعثت فيهم الوهن",79,"ن",1,0],["واحتسيناها دماء","وغزير ما احتسينا",80,"ن",2,0],["واحتوى صفحة ايا","مي خلاط وصواب",81,"ب",1,0],["وَاِحتَكَم غَير خُصلة تَغضَب","اللَه فما فازَ ذو حجى قَد خانَه",82,"ن",2,0],["واحْتَلَّ أَهْلِي بالكَّثِيبِ وأَهْلُها","في دارِ كَلْبٍ أَرْضِها وسَمائِها",83,"ا",3,0],["واحتفظها كالزُجاج","إذ هو سريع العطب",84,"ب",1,0],["وَاِحتِكام المُلوك ما زالَ أَولى","مِن دَلال الرَعية الحَمقاءِ",85,"ا",2,0],["وَاِحتَسى رائِقاً حُب الغَمام لَهُ","مثل الحباب وَطيب النَشر ساقيهِ",86,"ي",2,0],["وأحتوى من قرب رب معبود","يفوق ما هذا العرب يظنون",87,"ن",1,0],["واحتقب زادا بقاء حسنا","عده ذخرا لاهوال طوال",88,"ل",1,0],["واحتمل كل أذى الناس وخذ","من جميع الناس أيسر ما بدر",89,"ر",1,0],["واحتوينا للمساوى والعيوب","وعصينا الله علام الغيوب",90,"ب",1,0],["وَاِحتَمى عَنها وَلَو قَد","قامَ كَلبٌ فَاِدَّعاها",91,"ا",3,0],["واحتشّها السير في خرقاء داويةٍ","حتى عرى البيد منها في عرابيد",92,"د",1,0],["واحْتَسِبُوا آلَ إِسماعِيلَ مَا احْتَسَبَتْ","خيلُ الوغى من لواءِ الجَيْشِ يَنْصَرِعُ",93,"ع",1,0],["واحْتازَ إِرْثَ الأُلى آوَوْا وَهُمْ نَصرُوا","باسمٍ يُصدِّقُهُ فِعلٌ يُضارِعُهُ",94,"ع",2,0],["واحتسى دَرَّة الكروم أبو العبا","س والدَّجْنُ يستدر قُطاره",95,"ر",2,0],["واحتوتني وهدهدت حزنيَ البالغ","حتى استحال حزني نعيما",96,"م",2,0],["واحتدَّ لحظاها وقامتها","أفأنتِ علّمتِ القنا الطعنا",97,"ن",2,0],["وأحتمل السكوتَ وفيه معنىً","من التعنيف أوجعُ من كلامي",98,"م",2,0],["واحتلبي المزنَ أفاويقَها","بين سِماكيها إلى المِرزَمِ",99,"م",1,0],["واحتفظوا بي إنني بقيّةٌ","تمضي فلا يُخلفُها الدهرُ لكُمْ",100,"م",1,0],["واحتكموا بالعدل في دولةٍ","تحكُّمَ الحقِّ على الباطلِ",101,"ل",1,0],["واحتمل من هذه تقصيرَها","ربّما كانت مع الطَّوْل الإطالَهْ",102,"ل",2,0],["واحتطبتْ تبغيك بالشرّ على","أيّ اعتذارٍ في المعَاد تتّكِلْ",10