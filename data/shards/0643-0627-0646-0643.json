.html","الطويل"],[46,"سم الهلال إذا عاينته قمرا","https://www.aldiwan.net/poem22544.html","البسيط"],[46,"ألم تر أن جسمي فيه فضل","https://www.aldiwan.net/poem22987.html","الوافر"],[46,"أزول وليس في الخلاق شك","https://www.aldiwan.net/poem23073.html","الوافر"],[46,"أيا ديك عدت من أياديك صيحة","https://www.aldiwan.net/poem23291.html","الطويل"],[46,"إذا قيل غال الدهر شيئا فإنما","https://www.aldiwan.net/poem23293.html","الطويل"],[46,"تهاون بالظنون وما حدسنه","https://www.aldiwan.net/poem23486.html","الوافر"],[46,"كأنك بعد خمسين استقلت","https://www.aldiwan.net/poem23602.html","الوافر"],[46,"بني الحسب الوضاح والشرف الجم","https://www.aldiwan.net/poem23627.html","الطويل"],[46,"إبق في نعمة بقاء الدهور","https://www.aldiwan.net/poem23636.html","الخفيف"],[46,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"],[46,"تخيرت جهدي لو وجدت خيارا","https://www.aldiwan.net/poem23644.html","الطويل"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[19,"تنكر بعدي من أميمة صائف","https://www.aldiwan.net/poem351.html",""],[76,"ورادعة بأنفاس العبير","https://www.aldiwan.net/poem39303.html","البسيط"],[76,"مقيلك تحت أظلال العوالي","https://www.aldiwan.net/poem39442.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85465","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85433","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85368","الطويل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125533","الوافر"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140906",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39604","المتقارب"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72193","الوافر"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72206","الطويل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72194","الطويل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72252","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16680","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16639","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/141831","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16620","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16623","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16654","الوافر"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30489","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54723","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54893","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54754","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43782","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43845","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43885","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43697","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9497","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54286","الطويل"],[106,"فقيد القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179682",""],[77,"بحيث القباب البيض والأسل السمر","https://www.poetsgate.com/ViewPoem.aspx?id=34138",""],[49,"ألاَ للهِ أَنْتَ مَتَى تَتُوبُ","https://www.poetsgate.com/ViewPoem.aspx?id=16962",""],[18,"أليلتنا بذي حسم أنيري","https://www.poetsgate.com/ViewPoem.aspx?id=27758",""],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[90,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[35,"أَلَمْ تَرْبَعْ فَتُخْبِرَكَ الطُّلُولُ","https://www.poetsgate.com/ViewPoem.aspx?id=22132",""],[51,"إذا ضحكتُمْ ضحكنا في مَفارحكُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=29581",""],[51,"أكُفُّ الغواني بالخنا خَضِراتُ","https://www.poetsgate.com/ViewPoem.aspx?id=27207",""],[0,"خليلّي مرّ بي على أم جندب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14326&r=&rc=2",""],[18,"أليلتنا بذي حسمٍ أنيري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26445&r=&rc=11",""]],"verses":[["كَأَنَّكَ لَم يَعتَنِقكَ النَسيمُ","وَلا مالَ نَحوَكَ قَطرٌ بِفَم",0,"م",1,0],["كَأَنَّكَ تَلقى بِهِ السَمهَريَّ","إِذا مُدَّ يَومَ وَغىً أَو أَتَم",0,"م",1,0],["كَأَنَّكَ تَلقى بُدوراً تُضيءُ","إِذا طَلَعوا أَو قُروماً تَسامى",1,"م",2,0],["كَأَنَّكَ تَلقى وَجهَهُ البَدرَ طالِعاً","إِذا اِبتَدَرَ القَومُ الرِواقَ المُرَفَّعا",2,"ع",2,0],["كَأَنَّكَ لَم تَقُد بِعُوَيرِضاتٍ","أَبا العَوّامِ فِتياناً قِطاطا",3,"ط",2,1],["كَأَنَّكَ تَلقى هَجمَةَ الخَطبِ مِنهُمُ","بِزَيدِ القَنا أَو بِالقَلَمَّسِ أَو عُمرو",4,"ر",2,0],["كَأَنَّكَ تَلقى مِنهُمُ أَجَمِيَّةً","مُؤَلَّلَةَ الأَنيابِ أَو قُلَلاً صَلدا",5,"د",2,0],["كَأَنَّكَ لِلأَرضِ العَريضَةِمالِكٌ","وَحيداً وَلِلدُنيا العَظيمَةِ والِدُ",6,"د",1,0],["كَأَنَّكَ صُبتَ مِنهُ بِذاتِ فَرعٍ","عَلى البَوغاءِ لَبَّدَتِ العَجاجا",7,"ج",2,0],["كَأَنَّكَ قُدمَةُ الأَمَلِ المُرجّى","عَلَيَّ وَطَلعَةُ الفَرَجِ القَريبِ",8,"ب",1,0],["كَأَنَّكَ وَالحَيَّ الَّذينَ تَدَيَّروا","ضَريَّةَ عِندي في الفُؤادِ نُزولُ",9,"ل",1,0],["كأنّكَ حينَ تَسْمعُهُ اهْتِزازاً","بكَ النّشَواتُ منْ فَضَلاتِ راحِ",10,"ح",1,0],["كأنّ كُلَّ بَنانٍ منْ ولائِدِهِمْ","أهْدى إلَيْهِنّ إذْ نَجَّيْنَهُمْ عَنَما",11,"م",2,0],["كأنّكَ حينَ تُزْجرُها وتُرخِي","أزِمَّتَها تَروعُ بها رِئالا",12,"ل",2,0],["كَأَنَّ كَأساً سَلسَبيلِيَّةً","مَملوءَةً بِالمِسكِ وَالخَمرِ",13,"ر",1,0],["كَأَنَّكِ لا تَدرينَ ما بي مِنَ الهَوى","وَقَد صِرتُ عَظماً يابِساً مُغلَفاً جِلدا",14,"د",2,0],["كَأَنَّكَ لَم تَغنَهُ إِذ لَم تُلاقِها","وَإِن تَلقَها فَالقَلبُ راضٍ وَقانِعُ",15,"ع",1,1],["كَأَنَّكَ بِدعٌ لَم تَرى الناسَ قَبلَها","وَلَم يَطَّلِعكَ الدَهرُ فيمَن يُطالِعُ",15,"ع",1,0],["كَأنَّكَ بَدْرٌ وَالْبِلاَدُ مَنَازِلٌ","إذَا جِئْتَ أُفْقاً رَاقَ نُورُ جَمَالِهِ",16,"ل",2,0],["كأنّك قدْ ذمّرْتَ كلَّ كَتيبةٍ","غَنائِمُها بيضٌ وآسالُها سُمْرُ",17,"ر",1,0],["كَأَنَّ كوري وَميسادي وَميثَرَتي","كَسَوتُها أَسفَعَ الخَدَّينِ عَبعابا",18,"ب",2,0],["كَأَنَّكَ لَم تَشهَد قَرابينَ جَمَّةً","تَعيثُ ضِباعٌ فيهِمُ وَعَواسِلُ",19,"ل",1,0],["كَأَنَّكَ كُنتَ تَعلَمُ يَومَ بُزَّت","ثِيابُكَ ما سَيَلقى سالِبوها",20,"و",3,0],["كَأَنَّكَ لَم تَجزَع عَلَيهِ وَلَم تَكُن","تَرى في حِمى فِرعَونَ أَمناً وَلا جَدا",21,"د",2,0],["كَأَنَّكَ وَالآمالُ حَولَكَ حُوَّمٌ","نَميرٌ عَلى عِطفَيهِ طَيرٌ تُرَفرِفُ",22,"ف",1,0],["كَأَنَّكَ في الزَمانِ اِسمٌ صَحيحٌ","جَرى فَتَحَكَّمَت فيهِ العَوامِل",23,"ل",1,0],["كَأَنَّكِ ناظَرتِ أَهلَ الكَلامِ","وَأوتيتِ فَهماً بِعلمِ الجَدَل",24,"ل",1,0],["كَأَنَّكَ أَهدَيتَ السَوابِحَ ضُمَّراً","لِيَركِضَها فيما كَرِهتَ فَيُجهِدا",25,"د",2,0],["كَأَنَّكَ لَم تَسمَع وَلَم تَرَ قَبلَها","تَفَرُّقَ أُلّافٍ لَهُنَّ حَنينُ",26,"ن",1,0],["كَأَنَّكَ مَردوعٌ مِنَ الشَمسِ مَطرَدٌ","يُفارِقُهُ مِن عُقدَةِ البُقعِ هيمُها",27,"م",3,0],["كَأَنَّكَ تَسْمَعُ أُغْنِيَةً","تُهَيِّجُ لِلْنَّفْسِ رَوحَ الطَّرَبْ",28,"ب",1,0],["كَأَنَّكَ قَد جَعَلتَ عَلَيهِ دَنّاً","فَتَحتَ بِزالَهُ مِن فَردِ عَينِ",29,"ن",1,0],["كَأَنَّكَ إِذ مُلِّكتَنا لِشَقائِنا","عَجوزٌ عَلَيها التاجُ وَالعِقدُ وَالاِتبُ",30,"ب",1,0],["كانَ كُحلاً لِمَآقيها فَقَد","صارَ بِالشَيبِ لِعَينَيها قَذى",31,"ا",1,0],["كَأَنَّكَ بِالأَضلاعِ قَد ضاقَ رُحبُها","لِما ضُمِّنَت مِن شِدَّةِ الزَفَراتِ",32,"ت",1,0],["كان كما قال وهو مفتخر","بفضل ما قاله وما فعله",33,"ل",2,0],["كأنكم المِعزى تهاوَيْن عندما","نزا فنزت فوق الجبال عَتُودها",34,"د",3,0],["كَأَنَّكَ يَومَ بُرقَةَ لَم تُكَلَّف","ظَعائِنَ قادَهُنَّ هَوىً يَماني",35,"ي",1,0],["كَأَنَّكَ لَم تَشهَد لَقيطاً وَحاجِباً","وَعَمروَ بنَ عَمروٍ إِذ دَعوا يا لَدارِمِ",36,"م",1,0],["كَأَنَّكَ قَد رَأَيتَ مُقَدِّماتٍ","بِصينِ اِستانَ قَد رَفَعوا القِبابا",37,"ب",2,0],["كَأَنَّكَ مُستَعيرُ كُلى شَعيبٍ","وَهَت مِن ناضِحٍ سَرِبِ الطِبابِ",38,"ب",1,0],["كَأَنَّكَ يا اِبنَ القَينِ واهِبُ سَيفِهِ","لِأَعدائِهِ وَالحَربُ تَغلي قُدورُها",39,"ر",3,0],["كَأَنَّكُمُ بِإِمعَزِ وارِداتٍ","نَعامُ الصَيفِ زَفَّ مَعَ الرِئالِ",40,"ل",1,0],["كَأَنَّكَ حينَ تَشحَطُ عَنكَ سَلمى","أَميمٌ حينَ تَذكُرُهُ تَبيلُ",41,"ل",1,0],["كَأَنَّكَ لَم تَسِر بِجَنوبِ قَوٍّ","وَلَم تَعرِف بِناظِرَةَ الخِياما",42,"م",2,0],["كأَنَّ كِتَابَ الله يُعنَى بأمرِهِ","وبالنَّهي فِيهِ الكَودَنِيُّ المُرَكَّلُ",43,"ل",1,0],["كَأَنَّكَ أَيُّها المُعطى لِساناً","وَجِسماً مِن بَني عَبدِ المَدانِ",44,"ن",1,0],["كأنَّك بي سكنت بخانقاتٍ","ووعظك قد ملا سمع المصيخ",45,"خ",1,1],["كأنَّك في العليا أبوك سقى ثرى","أبيكَ حياً يهمي فلله درّه",46,"ر",2,0],["كأنَّ كلّ هلال في مطالعه","قوسٌ يطالب أرواحاً بأوتار",47,"ر",1,0],["كأنك لم تنفع ولياً ولم تضر","عدوًّا ولك تحمدك في أزمةٍ سفرُ",48,"ر",1,0],["كأن كل هلال في مطالعه","قوس له عند أهل الأرض أوتار",49,"ر",1,0],["كأنك لم تكن من ذا وهذا","أكلت أوزَّةً وشربت بطه",50,"ه",1,0],["كأنك يا ظلّ العفاة بشخصه","يجاريك للعلياء كالشخص والظّل",51,"ل",1,0],["كأنك لم تنهض بأعباء دولة","تكلف سعي الدهر فوق احتماله",52,"ل",2,0],["كأنك لم تحمل يراعاً تمرها","وتعضدها في سلمه وصياله",52,"ل",2,0],["كأنك لم تبسط بنان مؤملٍ","يمين غوادي المزن دون شماله",52,"ل",2,0],["كأنك سيف زيد الخيل عندي","أحادثه يصقّل كل يوم",53,"م",1,0],["كأنك بادرت الرحيل تخوُّفاً","عليَّ من الحسنِ الذي هو فاتني",54,"ن",2,0],["كأنَّكم الثلاثة ضرب خيط","عليّ في عليّ في عليّ",55,"ي",1,0],["كأنك تلقاءَ الخليقةِ كلّها","مشارقُ شمسٍ أشرقتْ لمغاربِ",56,"ب",1,0],["كان كمن خافَ حريقاً واقعاً","فزاد فيه حطباً على حَطَبْ",57,"ب",1,0],["كأنكُمُ ليناً وحدّاً مَناصلٌ","لها الصفحاتُ المُلس والشَّفراتُ",58,"ت",1,0],["كأنك قد حللت من المعالي","بحيث الشمس والقمر المنيرُ",59,"ر",1,0],["كأنك قد فُتّ المديح فما ترى","لمجدك فيه من كَفِيٍّ مُقادِر",60,"ر",1,0],["كان كالمتلف البضاعة في المت","جر حتى استفاد كيْسا بكيس",61,"س",1,0],["كأنك قابلتْك بأنف عمروٍ","ورأس مثل حُلَّتهِ خَليس",62,"س",1,0],["كأنك ما أُثقلْتِ تسعة أشهرٍ","بحمل ولا قاسيتِ ضربَ مخاض",63,"ض",1,0],["كأنكم يا بني قاسم","كواكب من قمرٍ تنقلع",64,"ع",1,0],["كأن كفي بها مُمَلَّكةٌ","دجلة تسقي منابت السعف",65,"ف",1,0],["كأنكم قد نسيتم والذكاء لكم","أن الكرام إذا ما استعطفوا عطفوا",66,"ف",3,0],["كأنكم أنصلٌ مهندةٌ","يبدي لنا الصقل عن سفاسقها",67,"ق",3,0],["كأنكم شجر الأترج طاب معاً","حملاً ونوراً وطاب العود والورقُ",68,"ق",1,0],["كأنك بي أقولُ وقد أتاني","رسولُك بعدما غالته غولُ",69,"ل",1,0],["كأنكَ قد أُنسيتَ أنك سيدٌ","له الفضل أو أُنسيتَ أنِّيَ خادمُ",70,"م",1,0],["كَأَنَّكَ إِذ عَلِقتَ بِعَردَمِيٍّ","سَمَوتَ إِلى أُمَيَّةَ بِالحِبالِ",71,"ل",1,0],["كَأَنَّكَ قَد وَتَرتَ المَوتَ قِدماً","وَهابَكَ في كَنانَتِكَ السِهامُ",72,"م",1,0],["كَأَنَّكَ قَد قَتَلتَ الدَهرَ بَحثاً","فَعِندَكَ سِرُّهُ الخافي مُبينُ",73,"ن",1,0],["كَأَنَّكَ قَد صَدَّقتَ فِيَّ حَديثَهُم","وَحاشاكَ مِن هَذا وَخُلقُكَ أَشرَفُ",74,"ف",1,0],["كأَنَّكَ الأَبدُ المجهولُ قَدْ عَجَزَتْ","عنكَ النُّهى واكْفَهَرَّتْ حولكَ الظُّلَمُ",75,"م",1,0],["كَأَنَّكَ تَحسَبُها نَرجِساً","تُديرُ الدِماءَ عَلَيها عُقارا",76,"ر",2,0],["كان كالكوكب الذي قد عراه","قبل ان يأتي الاوان افول",77,"ل",1,0],["كأنك لم تركب جواداً لغارة","ولم تتبطن كاعباً ذات خلخال",78,"ل",1,0],["كأنك بالقبائل في عكاظ","تجاذبت المنابر والتلاعا",79,"ع",2,0],["كانك قاتل والحكم يتلى","عليك وانت تنتظر الحماما",80,"م",2,0],["كأنك البدر في غايات رفعته","لو كان للبدر كرسي وتاجان",81,"ن",1,0],["كَأَنَّكَ إِن حارَبتَ فَوقَكَ عَنتَرٌ","وَتَحتَ اِبنِ سينا أَنتَ حينَ تُسالِمُ",82,"م",1,0],["كَأَنَّكَ خَيلُ التُركِ شابَت مُتونُها","وَشابَت نَواصيها وَشابَ القَوائِمُ",82,"م",1,0],["كَأَنَّكَ لِلمَوتِ مَوتٌ أُتيحَ","فَلَم يَرَ وَجهَكَ إِلّا هَرَب",83,"ب",1,0],["كَأَنَّكَ مِن ضَميرِكَ عِندَ دينٍ","فَمِن شَرَفِ المَبادِئِ أَن تُقيما",84,"م",2,0],["كَأَنَّكَ شَمشونُ هَذي الحَياةِ","وَكُلُّ حَوادِثِها هَيَكلُ",85,"ل",1,0],["كَأَنَّكَ في سَماءِ المُلكِ يَحيى","وَآلُكَ في السَماءِ النَيِّراتِ",86,"ت",1,0],["كَأَنَّ كُلَّ غَوانيهِ ضَرائِرُها","عُجباً وَكُلَّ نَواحيهِ مَرائيها",87,"ي",3,0],["كَأَنَّكَ فيها لِواءُ الفَضاءِ","عَلى الأَرضِ أَو دَيدَبانُ القَدَر",88,"ر",1,0],["كَأَنَّكَ صاحِبُ رَملٍ يَرى","خَبايا الغُيوبِ خِلالَ السَطَر",88,"ر",1,0],["كَأَنَّكَ وَحدَكَ وَحَّدتَهُ","وَدانَ البَرِيَّةُ بِاِبنِ وَأَب",89,"ب",1,0],["كَأَنَّ كُلَّ سُؤالٍ في مَسامِعِهِ","قَميصُ يوسُفَ في أَجفانِ يَعقوبِ",90,"ب",1,0],["كَأَنَّكَ بِالفَقرِ تَبغي الغِنى","وَبِالمَوتِ في الحَربِ تَبغي الخُلودا",91,"د",2,0],["كَأَنَّكَ بَردُ الماءِ لا عَيشَ دونَهُ","وَلَو كُنتَ بَردَ الماءِ ل