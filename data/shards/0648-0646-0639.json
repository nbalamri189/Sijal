ml","المتقارب"],[456,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[456,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[456,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[456,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[456,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[456,"عاتبت دهري في الجناية لو وعى","https://www.aldiwan.net/poem56132.html","الكامل"],[456,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[456,"تغرب فبالدار الحبية دار","https://www.aldiwan.net/poem56195.html","الطويل"],[456,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[456,"لا تلمس الشمس يد","https://www.aldiwan.net/poem56236.html","مجزوء الرجز"],[456,"قفا نضويكما بالغمر نسأل","https://www.aldiwan.net/poem56264.html","الوافر"],[456,"أصبت لو أحمدت أن أصيبا","https://www.aldiwan.net/poem56297.html","الرجز"],[459,"ذريني وأهوالي نفر ونلتقي","https://www.aldiwan.net/poem15283.html","الطويل"],[459,"حسام أنت لكن شفرتاه","https://www.aldiwan.net/poem15300.html","الوافر"],[459,"اذا افتخرت عليا ربيعة بالذي","https://www.aldiwan.net/poem15413.html","الطويل"],[459,"أصوب غمام أم نوال معذل","https://www.aldiwan.net/poem15452.html","الطويل"],[459,"هنيئا لأيام المواسم والتقى","https://www.aldiwan.net/poem16027.html","الطويل"],[459,"لقد علم الأحياء دان ونازح","https://www.aldiwan.net/poem16091.html","الطويل"],[459,"ولما التقينا والمعالي مضيئة","https://www.aldiwan.net/poem16106.html","الطويل"],[459,"هناكم قدوم العام وابتسمت لكم","https://www.aldiwan.net/poem16181.html","الطويل"],[459,"أقول لساري الليل والليل غابر","https://www.aldiwan.net/poem16236.html","الطويل"],[459,"لتهن قصور المجد زيدت جلالة","https://www.aldiwan.net/poem16249.html","الطويل"],[459,"يسوس الأمر وجبته ضجاج","https://www.aldiwan.net/poem16427.html","الوافر"],[462,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[462,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[462,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[462,"عزاء فمن ودعته ليس يرجع","https://www.aldiwan.net/poem3395.html","عموديه"],[462,"وهبت وقد سرت ذات الوشاح","https://www.aldiwan.net/poem3519.html","عموديه"],[480,"تلألأ وجه الدهر واتصلت عر","https://www.aldiwan.net/poem24375.html","عموديه"],[513,"أمالي من عذولكم عذير","https://www.aldiwan.net/poem12131.html","الوافر"],[536,"عدو الحق عند الناس طرا","https://www.aldiwan.net/poem47994.html","عموديه"],[542,"ثمالة الأمل","https://www.aldiwan.net/poem67253.html","عموديه"],[549,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[549,"أروني امرءا من قبضة الدهر مارقا","https://www.aldiwan.net/poem47364.html","الطويل"],[549,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[549,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[549,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[549,"ما في السلو لنا نصيب يطلب","https://www.aldiwan.net/poem48091.html","الكامل"],[549,"ناد امرءا غيب خلف النقا","https://www.aldiwan.net/poem48119.html","السريع"],[556,"أهل المحبة في السرور الدائمِ","https://www.aldiwan.net/poem33857.html","الكامل"],[556,"لا خلق أعظم مثل خلق الآخره","https://www.aldiwan.net/poem34472.html","الكامل"],[556,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[560,"وقفت مدحي فلا يطمع به أحد","https://www.aldiwan.net/poem52857.html","البسيط"],[573,"قالوا محبك يا حبيب صبر","https://www.aldiwan.net/poem2956.html","أحذ الكامل"],[573,"من فر منك فما يلام","https://www.aldiwan.net/poem3009.html","مجزوء الكامل"],[573,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[573,"نعم المشوق وأنعم المعشوق","https://www.aldiwan.net/poem3046.html","الكامل"],[573,"باتت معانقتي ولكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"],[573,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"],[573,"ما على الدهر بعد رؤياك عتب","https://www.aldiwan.net/poem3096.html","الطويل"],[573,"حسبي كما حكم الغرام وحسبها","https://www.aldiwan.net/poem3099.html","الكامل"],[584,"أأخاف صرف الدهر أم حدثانه","https://www.aldiwan.net/poem17502.html","الكامل"]],"verses":[["وَنَعمانُ ياسُقيا لِنَعمانَ ما جَرَت","عَليهِ النَعامى بَعدَنا وَصَباها",0,"ا",3,0],["وَنَعماءٍ شَقيتُ بِها وَلَكِن","غَدا حَظّي مِنَ الرِيحِ السَمومُ",1,"م",1,0],["وَنِعمَ قادِحُ زَندٍ أَنتَ في ظُلَمٍ","لا يوقِدُ النارَ فيها المَرخُ وَالعُشَرُ",2,"ر",1,0],["وَنَعلَمُ أَن سَيوجِرُنا مُراراً","بِآيَةِ أَن يُلَمَّظَنا شِهادا",3,"د",2,0],["وَنُعْرِضُ عَنْ بِيضٍ تُديرُ وَراءَنا","عُيونَ مَهاً فيها دَمٌ وَدُموعُ",4,"ع",1,0],["وَنَعْتَقِلُ الرِّماحَ مُثَقَّفاتٍ","وَنَرْفُلُ في سَرابِيلِ الحَديدِ",5,"د",1,0],["ونِعْمَ المُحامي دونَ مَجْدِكَ مِقْوَلي","بهِ أُلْقِمَتْ قَسْراً أعاديكَ جَنْدَلا",6,"ل",2,0],["ونِعْمَ خَليلُ الخيرِ أنتَ مُحافِظاً","على سُنَنِ الإخْلاصِ في السّرِّ والجَهْرِ",7,"ر",1,0],["وَنُعيرُ الأَهواءَ حَرباً عَواناً","مِن خِلافٍ وَالخُلفُ كَالسِلِّ يُعدي",8,"ي",1,0],["وَنِعمَةٍ جاءَت إِلى سِفلةٍ","أَبطَرَهُ الإِثراءُ لَمّا ثَرا",9,"ر",2,1],["وَنِعمَ مَحَلُّ الصَبوَةِ المُتَبَوَّأُ","وَيا رُبَّ مَلهىً بِالعَقيقِ وَمَجلِسِ",10,"س",1,0],["وَنَعِمنا بِلَفِّ جِسمٍ بِجِسمٍ","لِلتَصافي وَقَرعِ ثَغرٍ بِثَغرِ",11,"ر",1,0],["وَنُعمى تَفَيَّأتُها أَيكَةً","فَشُكري حَمامٌ بِها غَرَّدا",12,"د",2,0],["وَنَعدو حينَ لا يُعدى عَلَين","وَنَضرِبُ بِالمَواسي مَن يَلينا",13,"ن",2,0],["وَنَعودُ سَيِّدَنا وَسَيِّدَ غَيرِنا","لَيتَ التَشَكِّيَ كانَ بِالعُوّادِ",14,"د",1,1],["وَنِعمَ جارُ القَومِ في أَزمَةٍ","إِذا اِلتَجا الناسُ بِجارٍ ذَليل",15,"ل",1,0],["وَنَعلَمُ أَنَّ مَنايا الرِجالِ","بالِغَةٌ حَيثُ يُحلى لَها",16,"ل",3,0],["وَنَعْزِمُ عَزْماً كُلَّ يَوْمٍ فَيَنْقَضِي","بِلا أَثَرٍ مَن لَمْ يُطِقْ فِيمَ يَعْزِمُ",17,"م",1,0],["وَنَعَمْ يَرُومُ مِنَ الفَخَارِ أجَلَّهُ","وَأَعَّزهُ لَكِنْ لِمِصْرَ يَرُومُ",18,"م",1,0],["ونَعُدّ الركوع للقبر حِلاًّ","وهو في الدين ما له تحليل",19,"ل",1,0],["وَنَعرِفُ حَقَّ النازِلينَ وَلَم تَزَل","فَوارِسُنا يَحمونَ قاصِيَةَ السَربِ",20,"ب",1,0],["وَنَعوذُ سَيِّدَنا وَسَيِّدَ غَيرِنا","لَيتَ التَشَكِّيَ كانَ بِالعُوّادِ",21,"د",1,0],["وَنِعمَ أَخو الحُروبِ إِذا تَرَدّى","عَلى الزَغفِ المُضاعَفَةِ النِجادا",22,"د",2,0],["وَنِعمَ مُناخُ الجارِ حَلَّ بِبَيتِهِ","إِذا ما الكَعابُ أَصبَحَت لَم تَسَتَّرِ",23,"ر",1,0],["وَنِعمَ وليُّ الأمرِ بَعدَ وَلِيهِ","وَمُنتَجَعُ التَقوى ونِعمَ المُؤَدِبُ",24,"ب",1,0],["وَنَعتَقِلُ الصُمَّ العَوالِيَ إِنَّها","طَريقٌ إِلى نَيلِ المَعالي وَسُلَّمُ",25,"م",1,0],["وَنَعلَمُ أَنَّ اللَهَ لا رَبَّ غَيرُهُ","وَأَنَّ كِتابَ اللَهِ أَصبَحَ هادِيا",26,"ي",2,0],["وَنَعلَمُ أَنَّ المُلكَ لِلَّهِ وَحدَهُ","وَأَنَّ قَضاءَ اللَهِ لا بُدَّ واقِعُ",27,"ع",1,0],["ونعمَ الغوث إن دهياء دارت","ونعم العونُ إن دارَ الرجاء",28,"ا",2,0],["ونعمَ المصطفى من معشر مّا","نجومُ النيراتِ لهمْ كفاء",28,"ا",2,0],["ونعم أجزتُ لهم روايةَ ما اقْتضوا","بالشرطِ من لفظٍ أجزت ومسند",29,"د",1,0],["ونعم شكرتُ مواهباً لكَ حلوةً","حتى شققت من العداة مرائرا",30,"ر",2,0],["ونُعمت باللّذات وهي جديدةٌ","ولبست ضوءَ الرَّاح وهو معتّق",31,"ق",1,0],["ونعت مصر والشآم إماماً","طرزت مجد وذا وذاك خلاله",32,"ل",2,0],["ونعم سبيل المكرمات محمد","إذا ما ذكرنا ناسلاً وإذا ما",33,"م",2,0],["ونعم شكراً لها من نعمٍ","بوركت حتى أكلنا ولبسنا",34,"ن",2,0],["ونعمنا بليلة ليس لِلْهَم","مِ لديها قِرىً سوى الإِزعاجِ",35,"ج",1,0],["ونُعماك في هذا الوزير فإنَّنا","نعوذُ بنعمى ربِّنا من جُحُودها",36,"د",3,0],["ونعمةٍ قد أُتمَّتْ","ونعمةٍ مستجدّهْ",37,"د",2,0],["ونعمةُ الله حسبي","تبقى ونُعماك عِدُّ",38,"د",1,0],["ونَعَتْ إلينا مُفلِحاً سقياً لهُ","من فارسٍ مَنَعَ الحريمَ وحاطا",39,"ط",2,0],["ونِعْم الجذْل للتدبير نأوي","إليه إذا تضعضعت الجذولُ",40,"ل",1,0],["وَنَعرُر أُناساً عَرَّةً يَكرَهونَها","وَنَحيا كِراماً أَو نَموتَ فَنُقتَلُ",41,"ل",1,0],["وَنِعمَ أَخو الكَريهَةِ حينَ يُلقى","إِذا نَزَتِ النُفوسُ إِلى التَراقي",42,"ي",1,0],["وَنِعمَ الحَيُّ في اللَزَباتِ عَبسٌ","إِذا ما الطَلحُ أَرجَفَهُ الدَبورُ",43,"ر",1,0],["وَنَعَم كَبِرتُ وَإِنَّما","تِلكَ الشَمائِلُ باقِيَه",44,"ي",2,0],["وَنَعلٍ كَأَشلاءِ السُمانى تَرَكتُها","عَلى جَنبِ مَورٍ كَالنَحيزَةِ أَغبَرا",45,"ر",2,0],["ونعودُ نَضْحَكُ للمروجِ","وللزَّنابقِ والغَديرْ",46,"ر",1,0],["ونعيدُ أُغنيَةَ السَّواقي","وهي تَلْغو بالخَريرْ",46,"ر",1,0],["ونعود نحيا مثلما","كنا بغير تبدّل",47,"ل",1,0],["ونعيش في حال التعا","سة بالأمانيِّ الكواذب",48,"ب",1,0],["ونعدّ تعذر أننُهَيِّئ خيرهم","فمن الأبوّة أن نحب ونرشدا",49,"د",2,0],["ونعم هذه يمينك لكن","حيل بين اليمين والصولجان",50,"ن",1,0],["وَنَعيمٍ وَنَضرَةٍ","وَظِلالٍ مِنَ الصِبا",51,"ب",2,0],["وَنَعلَمُ أَنّا في البِناءِ دَعائِمٌ","وَأَنتُم أَساسٌ في البِناءِ وَطيدُ",52,"د",1,0],["وَنَعشٍ كَالغَمامِ يَرِفُّ ظِلّاً","إِذا ذَهَبَ الزِحامُ بِهِ وَجاءَ",53,"ا",2,0],["وَنَعى النُعاةُ إِلى المُروءَةِ كَنزَها","وَإِلى الفَضائِلِ نَجمَها الوَضّاءَ",54,"ا",2,0],["ونعجن من خميرته سياقاً","يحدُّ علاجُها البصر الكليلا",55,"ل",2,0],["ونعوا عليَّ معايبي فحذرتُها","ونفيتُ عن أخلاقيَ الأقذاءَ",56,"ا",2,0],["وَنِعمَةٌ مِن أَمينِ اللَهِ ضافِيَةٌ","عَلَيكَ في رُتبَةٍ مِن دونِها الرُتَبُ",57,"ب",1,0],["وَنَعذُلُ الدَهرَ أَن وافى بِنائِبَةٍ","وَلَيسَ لِلدَهرِ فيما نابَنا أَرَبُ",57,"ب",1,0],["وَنَعتَمِدُ الحَقَّ حَتّى يُضيءَ","لَنا مُظلِمُ الأَمرِ أَو يَنبَلِج",58,"ج",1,0],["وَنَعرِفُ حَقَّ المَشرِفِيَّةِ كُلَّما","أَطارَ جُناةَ الحَربِ يَوماً مُطيرُها",59,"ر",3,0],["وَنِعمَ مَلاذُ الخائِفينَ وَحِرزُهُم","وَمَوئلُ ذي الجُرمِ العَظيمِ المُوائِلِ",60,"ل",1,0],["ونعرت بالماء ناعورة","حنينها كالبربط الناعر",61,"ر",1,1],["وَنَعبَثُ أَحياناً بِما لا نُريدُهُ","وَنَرفَعُ أَعلامَ المَخيلَةِ وَالكِبرِ",62,"ر",1,0],["ونعوتُ البيض حُمْرٌ عِندَهُ","لِدَمٍ تُكْسَاهُ من قَتلِ الأُسود",63,"د",1,0],["ونَعّمِيني بعُتبى","فقد شقيتُ بِعَتْبِك",64,"ك",1,0],["وَنِعمَ مُسَكِّنُ البُرَحاءِ حَلَّت","بِهِ فَأَقامَتِ الدَمعُ السَكوبُ",65,"ب",1,0],["وَنِعمَةٍ مِنهُ تَسَربَلتُها","كَأَنَّها طُرَّةُ ثَوبٍ قَشيبِ",66,"ب",1,0],["وَنِعمَ الصَريخُ المُستَجاشُ مُحَمَّدٌ","إِذا حَنَّ نَوءٌ لِلمَنايا وَأَرزَما",67,"م",2,0],["وَنَعلَمُ أَنَّنا سَنَبيدُ يَوماً","كَما قَد بادَ مِن عَدَدِ الشُعوبِ",68,"ب",1,0],["وَنَعسَةُ طَرفِ العَينِ مِن سِنَةِ الكَرى","لِرَجعِ خَريرٍ أَو لِشَجوِ هَديرِ",69,"ر",1,0],["ونَعرفُه إذا الأَجماتُ ريعَتْ","فَرُحْنا ننشدُ الأُسْدَ الغِضابا",70,"ب",2,0],["ونعلمُ أنّهم قومٌ ضِعافٌ","شَقُوا بالغاصِبينَ كما شَقِينا",71,"ن",2,0],["وَنَعلَمُ أَنّا عَلى واضِحٍ","مِنَ الحَقِّ يَعرِفُهُ ذو النَظَرْ",72,"ر",1,0],["وَنِعمَ فَتى الجُلّى إِذا ما تَوَثَّبَت","وَأَمسى الفَتى مِن دونِها وَهوَ جاثِمُ",73,"م",1,0],["وَنَعلَمُ أَن شَعبَ النيلِ طُرّاً","عَلَينا بِالرَجاءِ الحَقِّ يُلقى",74,"ق",2,0],["وَنُعِزُّ رايَتَها وَنَمنَعُ حَوضَها","وَنَزيدُ صادِقَ حُبِّها اِستَحكاما",75,"م",2,0],["ونِعمَ أخو الوغَى زيدٌ","إذا ما جَدَّ فَاقْتَحَما",76,"م",2,0],["وَنَعيش إِخواناً عَلى","مَحض المودّة وَالوِئام",77,"م",1,0],["وَنَعلٍ كَأَشلاءِ السُمانى نَبَذتُها","إِلى صاحِبٍ حافٍ وَقُلتُ لَهُ اِنعَلِ",78,"ل",1,0],["وَنِعمَ دَواءُ النَأي وَالكَرب جَسرَةٌ","وَأَبيَضُ مَصقُولُ الغَرارَينِ قاطِعُ",79,"ع",1,0],["وَنِعمَ الحَيُّ حَيُّ بَني كُلَيبٍ","إِذا اِختَلَطَ الدَواعي بِالدَواعي",80,"ع",2,0],["وَنَعيمٍ في وِصالٍ","حُلُّ مِن طولِ الصُدودِ",81,"د",1,0],["وَنُعمى تَضيقُ النَفسُ حينَ أَرُدُّها","شَكَرتُ عَلَيها ذا البَلادِ وَكافَيتُ",82,"ت",1,0],["وَنِعمَ العَينُ لِلناظِ","رِ في ظَلماءِ دَيجورِ",83,"ر",1,0],["وَنِعمَ أَميرُ المِصرِ يُصبِحُ لِلِّقا","وَدوداً وَفي الإِسلامِ عَفّاً مُوَدَّدا",84,"د",2,0],["وَنَعيمٍ بَغَيتُهُ","بَعدَ ما لَذَّ مَرقَدا",85,"د",2,0],["وَنَعيمي حينَ أَغفي","وَشِفاءُ اليَقَظاتِ",86,"ت",1,0],["وَنِعمَ جارُ العُيَّلِ السِغابِ","يَهوونَ في المُحمَرَّةِ الغِلابِ",87,"ب",1,0],["وَنَعطِف هاجِرَ الخِلّانِ كَيما","يَزولُ عَنِ السَجايا المُسئِماتِ",88,"ت",1,0],["وَنَعوذُ بِالخَلّاقِ مِن أُمَمٍ","أَوفى المَنازِلِ مِنهُمُ القَبرُ",89,"ر",1,0],["وَنِعمَ أُذينُ المَعشَرِ اِبنُ حَمامَةٍ","إِذا سَجَعَت لِلذاكِرينَ الحَمائِمُ",90,"م",1,0],["ونَعيبُها كنحيبِها وحِدادُها","أبداً سَوادُ قَوادمٍ وخَوَافِ",91,"ف",1,0],["وَنَعيماً قَد كنت أَرتَع فيه","وَهُوَ اليَوم لَيسَ إلا خَيالا",92,"ل",2,0],["وَنَعُبَّ الخمرَ من عُنقودها","واتركِ الدنَّ وخلِّ القدَحا",93,"ح",2,0],["ونِعْمَ الفَتى يا توبَ كُنْتَ ولَمْ تَكُنْ","لتُسْبقَ يوماً كُنْتَ فيه تُحاوِلُ",94,"ل",1,0],["ونِعْمَ الفَتى يا توبَ كنتَ لخائفٍ","أتاكَ لكي يُحْمى ونِعْمَ المجاملُ",94,"ل",1,0],["ونِعْمَ الفَتى يا توبَ جاراً وصاحِباً","ونِعْمَ الفَتى يا توبَ حين تُفاضِلُ",94,"ل",1,0],["ونِعْمَ الفَتى إنْ كانَ تَوْبَةُ فاجِراً","وفوق الفتى إن كان ليس بفاجِرِ",95,"ر",1,0],["وَنَعدو حينَ لا يُعدى عَلَينا","وَنَضرِبُ بِالمَواسي مَن يَلينا",96,"ن",2,0],["ونِعْمَ ذخيرَةُ البَدَوِيّ زَغْفٌ","أوانَ البِيضُ يُسْقِطْنَ الأجِنّه",97,"ن",2,0],["وَنِعمَ فَوارِسُ الهَيجاءِ قَومي","إِذا عَلِقوا الأَعِنَّةَ بِالبَنانِ",98,"ن",1,0],["وَنِعْمَتِ الهَيْفَاءُ مَا","فِي مَيْلِهَا مِنْ مَيَلِ",99,"ل",1,0],["وَنَعْرِفُ مِنْ حَقِّهِ فَوْقَ مَا","تَسَامَى إِلَيْهِ الْمُنَى وَالخُطُبْ",100,"ب",1,0],["ونِعْمَ الأَخُ الْوَافِي إِذَا مَا تَنَكَّرَتْ","لِصاحِبِهِ الأَيَّامُ لاَ يَتَنَكَّرُ",101,"ر",1,0],["ونُعِدُّ للأَعْدَاءِ كُلَّ مُقَلَّصٍ","وَرْدٍ وَمَحْجُولِ القَوَائِمِ أبْلقِ",102,"ق",1,0],["ونعمانَ وابنِ الجدِّ أَوْ ثَابِت بنِ","قَيْسٍ وأمثالُ ابنِ عَفْرَاءَ بالصّبْرِ",103,"ر",1,0],["ونَعمانُ أَوْفى بمِيثاقِهِ","وَحَنْظَلَةُ الخيرِ لَمْ يُحْنَجِ",104,"ج",1,0],["ونعم هل كانت كما صورت أم","بالغ في تلوينها المصور",105,"ر",1,0],["وَنَعِيمُ السَّرَّاءِ يَجْهَلُ مَعْنَا","هُ فَتىً لَمْ يُمَسَّ بِالضَّرَّاءِ",106,"ا",2,0],["ونُعِيتِ للدنيا فشبَّتْ لوعةٌ","أصلَى القلوبَ بحرِّها ناعيكِ",107,"ك",1,0],["ونعم التفى ياتوب كنت لخائف","أتاك لكي يحمي ونعم الجاملُ",108,"ل",1,0],["ونعود نضحك للمروج والزنابق والغدير","ونخاطب الاصداء وهي ترف في الوادي المنير",109,"ر",1,0],["ونعمتُ أُسبوعاً بها وسعيدةٌ","سَنَةٌ نعمتُ خلالهَا أسبوعا",110,"ع",2,0],["وَنِعْمَ مَلاذُ الخائِفِينَ وَحِرْزُهُمْ","وَمَوْئِلُ ذي الجُرْمِ العَظيمه المُوائلِ",111,"ل",1,0],["ونعرفه إذا الأجمات ريعت","فرحنا ننشد الأسد الغضاب",112,"ب",1,0],["ونعت شيخا كبيرا سيدا","ملأ الاقطار بالصيت الحسن",113,"ن",1,0],["ونعم لا عدمت وداد نعم","تساعدني على لهف الغرام",114,"م",1,0],["ونعمت في ظل البتول مع الالى","آل الرسول ودام رحبك نيرا",115,"ر",2,0],["ونعم أقرانه بحرٌ له زجلٌ","وسافياتٌ لها سجعٌ وأرنان",116,"ن",1,0],["ونعطى المعتفيني الكوم عودا","وفي المشتاة ننحرها سمانا",117,"ن",2,0],["ونعي الضلال فما تصدى باطلٌ","إلا وأزهق روحهُ إزهاقا",118,"ق",2,0],["وَنُعمى لِشَهرِ الصَومِ مُدَّ ظِلالَها","سَيَشكُرُها مَن صامَ فيهِ وَمَن صَلّا",119,"ل",2,0],["وَنُعِيدُ السَّنَا مِنَ الأَنْجُمِ الزُّهْ","رِ وَلَوْ لَمْلَمَتْهُ مِنْ أَلْفِ عَامِ",120,"م",1,0],["وَنَعِيشُ الحَيَاةَ أَغْلَى مِنَ الكَوْ","نِ وَأَحْلَى مِنْ شَائِقِ الأَحْلاَمِ",120,"م",1,0],["وَنِعمَ المُرَجّى في السِنينِ إِذا اِستَوَت","مِنَ الضُرِّ أَبناءُ السُرى وَالأَرامِلُ",121,"ل",1,0],["وَنِعمَ المُراعي لِلنَّزيلِ إِذا غَدا","أَكيلاً وَأَفنى مالَهُ مَن يُنازِلُ",121,"ل",1,0],["وَنِعمَ الصَريخُ المُستَجاشُ إِذا اِرتَوَت","لَدى الرَوعِ مِن هامِ الكُماةِ المَناصِلُ",121,"ل",1,0],["وَنِعمَ لِسانُ القَومِ إِمّا تَأَخَّرَت","عَنِ القَولِ ساداتُ الرِجالِ المَعاوِلُ",121,"ل",1,0],["وَنِعمَ مُناخُ الرَكبِ أَهدى لَهُ السُرى","سَنا النارِ في الظَلماءِ وَالعامُ ماحِلُ",121,"ل",1,0],["وَنِعمَ لِسانُ القَومِ إِن قيلَ مَن لَها","خَطيبٌ وَأَعيَى الحاضِرينَ مَقالُها",122,"ل",3,0],["وَنِعمَ مُناخُ الطارِقينَ إِذا أَتَت","تُقَلقِلُ مِن بَعدِ الهُدُوِّ رِحالُها",122,"ل",3,0],["وَنِعمَ مَلاذُ المُعتَفينَ إِذا نَبا","زَمانٌ وَهَبَّت عامَ مَحلٍ شَمالُها",122,"ل",3,0],["وَنِعمَ سَدادُ الثَغرِ تَكثُرُ دُونَهُ","مَعاذيرُ أَربابِ العُلى وَاِعتِلالُها",122,"ل",3,0],["وَنِعمَ مُناخُ الطارِقينَ رَمَت بِهِم","شَآمِيَّةٌ تُزجي سَحاباً حَوافِلا",123,"ل",2,0],["وَنِعمَ المُراعى لِلنَزيلِ وَطالَما","أَحَلَّت رِجالٌ بِالنَزيلِ النَوَازِلا",123,"ل",2,0],["وَنِعمَ لِسانُ القَومِ في يَوم لا تَرى","لِكِلمَةِ فَصلٍ تَرفَعُ الشَكَّ قائِلا",123,"ل",2,0],["وَنِعمَةً لَكَ عِندي لا يُقاوِمُها","شُكري وَمِن أَينَ لي شُكرٌ يُؤَدِّيها",124,"ي",3,0],["وَنَعلمُ أنّ الروحَ في الجسم غيره","وَما الجسمُ إلّا بيتهُ فيه قد قرّا",125,"ر",2,0],["وَنعمةُ اللَّه سبيل اللَّهِ","وَأنعمُ اللَّه صراطُ اللَّهِ",126,"ه",1,0],["ونعم قد قضيت يوم نأوا","فيه لكن من الهوى يخبي",127,"ب",2,0],["ونعم يلذ لي الكرى لكن ارى","مهري عليه الذ من اغفائي",128,"ا",2,0],["ونعم انني تغيرت لكن","من سقامي ولوعتي وزفيري",129,"ر",2,0],["ونعيمٍ لانَ مَعطِفُه","قد تَردَّى الطِّيبَ واشتمَلا",130,"ل",2,0],["ونَعيمٍ جَذَبْتُ طِيبَ التّصابِي","فيه جَذْبَ الصّدودِ للمعشوق",131,"ق",1,0],["ونعمةٌ وسُعودٌ","للمُعْتَفين وجَاه",132,"ا",2,0],["وَنِعْمَ الْبَحْرُ فَضْلُكَ وَهْوَ طَامٍ","إِذَا قَالَ الثَّنَاءُ بِكَ اعْتِصَامِي",133,"م",2,0],["وَنِعْمَ الْبَدْرُ وَجْهُكَ حِينَ يُمْسِي","وَقَدْ عَاضَ اللِّثَامَ بِالاِبْتِسَامِ",133,"م",1,0],["ونعيذ ذاتك بعد ان يهدى لنا","ضمن التهاني في القريض تعازي",134,"ز",2,0],["ونعم مولى بدهر تكتسى شرفاً","منه الموالي وبعض الفضل يكتسب",135,"ب",1,0],["ونعم أبو الضيوف إذا أطاحت","بيوت الحي عاصفة الرياح",136,"ح",1,0],["وَنِعْمَ الْمُوضِحُ الْعَميْاءَ رَأْياً","وَقَدْ كَثُرَ التَّمادِي وَالتَّلاحِي",136,"ي",1,0],["وَنِعْمَ مُفَرِّجُ الْغَمَراتِ عَزَّتْ","عَلَى سَوْمِ الأَسِنَّةِ وَالصِّفاحِ",136,"ح",1,0],["ونعرب عن صداقتنا ونبدي","لمولانا المعظم رسم عيد",137,"د",1,0],["وَنعمتُ من أفيائِه","وَظلالهِ بجنانِ عدن",138,"ن",1,0],["ونعتُها طريقةٌ","كما ترى مبتكره",139,"ر",2,0],["ونعمت طرفي إذ نظرت به إلى","شقائقَ روضٍ لا شقاءِ قريضِ",140,"ض",1,0],["وَنعّمَ بِالتأميلِ فيكُم حُشاشتي","وعذّبني بِالشوقِ وهو شديدُ",141,"د",1,0],["وَنِعمَةً لَيسَ تَفنى","وَغِبطَةً لا تُحَدَّدِ",142,"د",1,0],["ونعيمي هواك","بيغنّى لقلبك",143,"ك",1,0],["ونعمت في الاحلام أنشد غايتي","طيف الحبيب ولذتي وفتوني",144,"ي",1,0],["ونعقد فوق هامك تاج غار","ونسكنك الحنايا والضلوعا",145,"ع",2,0],["وَنِعْمَ مَن وَكَّلَهُ هَيّناً","وَحَسْبُنا اللَّهُ وَنِعْمَ الوَكِيلْ",146,"ل",1,0],["وَنِعْمَ الفِداءُ لَهُمْ قد بَعَثْتَ","من الفائقات ذَواتِ الشُُّحُومِ",147,"م",1,0],["وَنَعيمي في جَحيمي","نَضَجَت فيهِ جُلودي",148,"د",2,0],["وَنِعمَ النَدامى هُم غَداةَ لَقيتُهُم","عَلى الدامِ تُجرى خَيلُهُم وَتُؤَدَّبُ",149,"ب",1,0],["وَنِعمَةٌ في قَرارِ العِزِّ خالِدَةً","وَكَوكَبٌ في سَماءِ الفَخرِ وَقّادُ",150,"د",1,0],["وَنَعَم رَضيتُ بِما فَعَل","تَ عَلى تَعَسُّفِهِ رَضيتُ",151,"ت",1,0],["ونعلو على الناس فيما نقول","وكلٌ له سامعٌ قابل",152,"ل",1,0],["ونعبده بالوهم شخصاً محيَّزاً","وحاشاه من شخصٍ يُحيِّزُه وصفي",153,"ف",2,0],["ونَعيتُ كلّي بعد فرقةِ جزئه","بالموت إذ كلّي لجزئي يَتبع",154,"ع",1,0],["ونعمتُه إذاجاءت تجلت","عليك وأنت بالإنعام أدرى",155,"ر",2,0],["ونعيم ربٍّ خالدٍ","خيراته لا تنتزح",156,"ح",1,0],["ونعشق نخلها يعطي غذاءً","ويَنْبُوعَ الهدى يشفي الغَليلا",157,"ل",2,0],["ونعقدُ رايةً لِلْوصل بَيْضا","إذا انْهزمَ البعادُ على يديه",158,"ي",2,0],["ونَعَتْهُ أطيار السماء بواكياً","لمّا رأتْ أمراً فظيعاً مُنكرا",159,"ر",2,0],["ونعم ها هنا فريق يقولو","ن بأنا أنصار كل الأئمة",160,"م",2,0],["ونعمةُ غيرِهِ عارٌ عَلَيهِ","كَمِثلِ الخُلي لِلسَّيفِ الكِهامِ",161,"م",1,0],["ونعماه ناعيه وقال مؤَرِّخاً","قد مات ويك أبو الثنا محمود",162,"د",1,0],["ونعاني أسًى لأرسم دارٍ","شقيت من بعاد سَلمَى وسعدى",163,"د",2,0],["ونُعْمِلُ كالأَهِلَّةِ ضامراتٍ","لنبلُغَ فوقها القَمَرَ التَّماما",164,"م",2,0],["ونُعْمَى مَنْ رَأَى الأَجسامَ عُطْلاً","فَقَلَّدَها أَيادِيَهُ الجِساما",164,"م",2,0],["ونَعَمْ جهِلْتُ فقمتُ عن نِعمِ","كانت لَديْكَ وقُمْتُ في نِعَم",165,"م",1,0],["ونعيمٌ دارُنا اللدَّ","ةُ من دارِ النعيمِ",166,"م",1,0],["ونعمْ سأخدمُها ومث","لُ جلالِك المشهورُ يُخْدَمْ",167,"م",1,0],["ونعم كفيلُ الشَّمْسِ حاجِبُها الَّذِي","يشيِّعُنا فِيهَا ويَخْلُفُها فينا",168,"ن",2,0],["ونَعْلَمُ أَنَّ اللهَ أَبْقى لأَرْضِهِ","رِعَايَةَ رَاعِيها وعَطْفَ عَطُوفِها",169,"ف",3,0],["ونعمة اللَه في المخلوق شاهدةً","عليه من عقله المنصور عن فلج",170,"ج",1,0],["ونعيمها الصافي يكدره الردى","إن النعيم مع المنون ضريع",171,"ع",1,0],["ونعيجات له من سمنها","ولباها خير مطعوم مقيت",172,"ت",1,0],["ونعيمٍ والاه في حجرة الأُتْ","رُجِّ والماء قد أثار بخاره",173,"ر",2,0],["ونعشقُ جَمعكِ فوقَ الهضاب","ويستوقفُ الجمعُ حتىّ السحاب",174,"ب",1,0],["ونَعمْ أعذرُكم فالتمسوا","عِذرةَ المجد إذا ما المجدُ لاما",175,"م",2,0],["ونعمة موشيّة","حَوْكَ برودِ الرَّقْمِ",176,"م",1,0],["ونَعمْ لهم تلك النَّطافُ صفتْ","وامتدّ سابغُ ذلك الظلِّ",177,"ل",1,0],["ونعمةٌ تُخْلَق مثلَ أختها","في الحسن أو يُحذَى عن مثالها",178,"ل",3,0]