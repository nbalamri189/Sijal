الرزء أعظم أن تراق دموع","https://www.aldiwan.net/poem14460.html","الكامل"],[444,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[453,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[454,"طيور الخريف أطيلي البقاء","https://www.aldiwan.net/poem61659.html","المتقارب"],[459,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[459,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[459,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[459,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[459,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[459,"عاتبت دهري في الجناية لو وعى","https://www.aldiwan.net/poem56132.html","الكامل"],[459,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[459,"تغرب فبالدار الحبية دار","https://www.aldiwan.net/poem56195.html","الطويل"],[459,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[459,"لا تلمس الشمس يد","https://www.aldiwan.net/poem56236.html","مجزوء الرجز"],[459,"قفا نضويكما بالغمر نسأل","https://www.aldiwan.net/poem56264.html","الوافر"],[459,"أصبت لو أحمدت أن أصيبا","https://www.aldiwan.net/poem56297.html","الرجز"],[462,"ذريني وأهوالي نفر ونلتقي","https://www.aldiwan.net/poem15283.html","الطويل"],[462,"حسام أنت لكن شفرتاه","https://www.aldiwan.net/poem15300.html","الوافر"],[462,"اذا افتخرت عليا ربيعة بالذي","https://www.aldiwan.net/poem15413.html","الطويل"],[462,"أصوب غمام أم نوال معذل","https://www.aldiwan.net/poem15452.html","الطويل"],[462,"هنيئا لأيام المواسم والتقى","https://www.aldiwan.net/poem16027.html","الطويل"],[462,"لقد علم الأحياء دان ونازح","https://www.aldiwan.net/poem16091.html","الطويل"],[462,"ولما التقينا والمعالي مضيئة","https://www.aldiwan.net/poem16106.html","الطويل"],[462,"هناكم قدوم العام وابتسمت لكم","https://www.aldiwan.net/poem16181.html","الطويل"],[462,"أقول لساري الليل والليل غابر","https://www.aldiwan.net/poem16236.html","الطويل"],[462,"لتهن قصور المجد زيدت جلالة","https://www.aldiwan.net/poem16249.html","الطويل"],[462,"يسوس الأمر وجبته ضجاج","https://www.aldiwan.net/poem16427.html","الوافر"],[465,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[465,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[465,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[465,"عزاء فمن ودعته ليس يرجع","https://www.aldiwan.net/poem3395.html","عموديه"],[465,"وهبت وقد سرت ذات الوشاح","https://www.aldiwan.net/poem3519.html","عموديه"],[483,"تلألأ وجه الدهر واتصلت عر","https://www.aldiwan.net/poem24375.html","عموديه"],[516,"أمالي من عذولكم عذير","https://www.aldiwan.net/poem12131.html","الوافر"],[539,"عدو الحق عند الناس طرا","https://www.aldiwan.net/poem47994.html","عموديه"],[545,"ثمالة الأمل","https://www.aldiwan.net/poem67253.html","عموديه"],[552,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[552,"أروني امرءا من قبضة الدهر مارقا","https://www.aldiwan.net/poem47364.html","الطويل"],[552,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[552,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[552,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[552,"ما في السلو لنا نصيب يطلب","https://www.aldiwan.net/poem48091.html","الكامل"],[552,"ناد امرءا غيب خلف النقا","https://www.aldiwan.net/poem48119.html","السريع"],[559,"أهل المحبة في السرور الدائمِ","https://www.aldiwan.net/poem33857.html","الكامل"],[559,"لا خلق أعظم مثل خلق الآخره","https://www.aldiwan.net/poem34472.html","الكامل"],[559,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[563,"وقفت مدحي فلا يطمع به أحد","https://www.aldiwan.net/poem52857.html","البسيط"],[576,"قالوا محبك يا حبيب صبر","https://www.aldiwan.net/poem2956.html","أحذ الكامل"],[576,"من فر منك فما يلام","https://www.aldiwan.net/poem3009.html","مجزوء الكامل"],[576,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[576,"نعم المشوق وأنعم المعشوق","https://www.aldiwan.net/poem3046.html","الكامل"],[576,"باتت معانقتي ولكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"],[576,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"],[576,"ما على الدهر بعد رؤياك عتب","https://www.aldiwan.net/poem3096.html","الطويل"],[576,"حسبي كما حكم الغرام وحسبها","https://www.aldiwan.net/poem3099.html","الكامل"],[587,"أأخاف صرف الدهر أم حدثانه","https://www.aldiwan.net/poem17502.html","الكامل"]],"verses":[["ونعيا لأيام حبلن بعهده","فأجهضها ليل تناجت ربائبه",0,"ب",2,0],["وَنَعمانُ ياسُقيا لِنَعمانَ ما جَرَت","عَليهِ النَعامى بَعدَنا وَصَباها",1,"ا",3,0],["وَنَعماءٍ شَقيتُ بِها وَلَكِن","غَدا حَظّي مِنَ الرِيحِ السَمومُ",2,"م",1,0],["وَنِعمَ قادِحُ زَندٍ أَنتَ في ظُلَمٍ","لا يوقِدُ النارَ فيها المَرخُ وَالعُشَرُ",3,"ر",1,0],["وَنَعلَمُ أَن سَيوجِرُنا مُراراً","بِآيَةِ أَن يُلَمَّظَنا شِهادا",4,"د",2,0],["وَنُعْرِضُ عَنْ بِيضٍ تُديرُ وَراءَنا","عُيونَ مَهاً فيها دَمٌ وَدُموعُ",5,"ع",1,0],["وَنَعْتَقِلُ الرِّماحَ مُثَقَّفاتٍ","وَنَرْفُلُ في سَرابِيلِ الحَديدِ",6,"د",1,0],["ونِعْمَ المُحامي دونَ مَجْدِكَ مِقْوَلي","بهِ أُلْقِمَتْ قَسْراً أعاديكَ جَنْدَلا",7,"ل",2,0],["ونِعْمَ خَليلُ الخيرِ أنتَ مُحافِظاً","على سُنَنِ الإخْلاصِ في السّرِّ والجَهْرِ",8,"ر",1,0],["وَنُعيرُ الأَهواءَ حَرباً عَواناً","مِن خِلافٍ وَالخُلفُ كَالسِلِّ يُعدي",9,"د",2,0],["وَنِعمَةٍ جاءَت إِلى سِفلةٍ","أَبطَرَهُ الإِثراءُ لَمّا ثَرا",10,"ر",2,1],["وَنِعمَ مَحَلُّ الصَبوَةِ المُتَبَوَّأُ","وَيا رُبَّ مَلهىً بِالعَقيقِ وَمَجلِسِ",11,"س",1,0],["وَنَعِمنا بِلَفِّ جِسمٍ بِجِسمٍ","لِلتَصافي وَقَرعِ ثَغرٍ بِثَغرِ",12,"ر",1,0],["وَنُعمى تَفَيَّأتُها أَيكَةً","فَشُكري حَمامٌ بِها غَرَّدا",13,"د",2,0],["وَنَعدو حينَ لا يُعدى عَلَين","وَنَضرِبُ بِالمَواسي مَن يَلينا",14,"ن",2,0],["وَنَعودُ سَيِّدَنا وَسَيِّدَ غَيرِنا","لَيتَ التَشَكِّيَ كانَ بِالعُوّادِ",15,"د",1,1],["وَنِعمَ جارُ القَومِ في أَزمَةٍ","إِذا اِلتَجا الناسُ بِجارٍ ذَليل",16,"ل",1,0],["وَنَعلَمُ أَنَّ مَنايا الرِجالِ","بالِغَةٌ حَيثُ يُحلى لَها",17,"ل",3,0],["وَنَعْزِمُ عَزْماً كُلَّ يَوْمٍ فَيَنْقَضِي","بِلا أَثَرٍ مَن لَمْ يُطِقْ فِيمَ يَعْزِمُ",18,"م",1,0],["وَنَعَمْ يَرُومُ مِنَ الفَخَارِ أجَلَّهُ","وَأَعَّزهُ لَكِنْ لِمِصْرَ يَرُومُ",19,"م",1,0],["ونَعُدّ الركوع للقبر حِلاًّ","وهو في الدين ما له تحليل",20,"ل",1,0],["وَنَعرِفُ حَقَّ النازِلينَ وَلَم تَزَل","فَوارِسُنا يَحمونَ قاصِيَةَ السَربِ",21,"ب",1,0],["وَنَعوذُ سَيِّدَنا وَسَيِّدَ غَيرِنا","لَيتَ التَشَكِّيَ كانَ بِالعُوّادِ",22,"د",1,0],["وَنِعمَ أَخو الحُروبِ إِذا تَرَدّى","عَلى الزَغفِ المُضاعَفَةِ النِجادا",23,"د",2,0],["وَنِعمَ مُناخُ الجارِ حَلَّ بِبَيتِهِ","إِذا ما الكَعابُ أَصبَحَت لَم تَسَتَّرِ",24,"ر",1,0],["وَنِعمَ وليُّ الأمرِ بَعدَ وَلِيهِ","وَمُنتَجَعُ التَقوى ونِعمَ المُؤَدِبُ",25,"ب",1,0],["وَنَعتَقِلُ الصُمَّ العَوالِيَ إِنَّها","طَريقٌ إِلى نَيلِ المَعالي وَسُلَّمُ",26,"م",1,0],["وَنَعلَمُ أَنَّ اللَهَ لا رَبَّ غَيرُهُ","وَأَنَّ كِتابَ اللَهِ أَصبَحَ هادِيا",27,"ي",2,0],["وَنَعلَمُ أَنَّ المُلكَ لِلَّهِ وَحدَهُ","وَأَنَّ قَضاءَ اللَهِ لا بُدَّ واقِعُ",28,"ع",1,0],["ونعمَ الغوث إن دهياء دارت","ونعم العونُ إن دارَ الرجاء",29,"ا",2,0],["ونعمَ المصطفى من معشر مّا","نجومُ النيراتِ لهمْ كفاء",29,"ا",2,0],["ونعم أجزتُ لهم روايةَ ما اقْتضوا","بالشرطِ من لفظٍ أجزت ومسند",30,"د",1,0],["ونعم شكرتُ مواهباً لكَ حلوةً","حتى شققت من العداة مرائرا",31,"ر",2,0],["ونُعمت باللّذات وهي جديدةٌ","ولبست ضوءَ الرَّاح وهو معتّق",32,"ق",1,0],["ونعت مصر والشآم إماماً","طرزت مجد وذا وذاك خلاله",33,"ل",2,0],["ونعم سبيل المكرمات محمد","إذا ما ذكرنا ناسلاً وإذا ما",34,"م",2,0],["ونعم شكراً لها من نعمٍ","بوركت حتى أكلنا ولبسنا",35,"ن",2,0],["ونعمنا بليلة ليس لِلْهَم","مِ لديها قِرىً سوى الإِزعاجِ",36,"ج",1,0],["ونُعماك في هذا الوزير فإنَّنا","نعوذُ بنعمى ربِّنا من جُحُودها",37,"د",3,0],["ونعمةٍ قد أُتمَّتْ","ونعمةٍ مستجدّهْ",38,"د",2,0],["ونعمةُ الله حسبي","تبقى ونُعماك عِدُّ",39,"د",1,0],["ونَعَتْ إلينا مُفلِحاً سقياً لهُ","من فارسٍ مَنَعَ الحريمَ وحاطا",40,"ط",2,0],["ونِعْم الجذْل للتدبير نأوي","إليه إذا تضعضعت الجذولُ",41,"ل",1,0],["وَنَعرُر أُناساً عَرَّةً يَكرَهونَها","وَنَحيا كِراماً أَو نَموتَ فَنُقتَلُ",42,"ل",1,0],["وَنِعمَ أَخو الكَريهَةِ حينَ يُلقى","إِذا نَزَتِ النُفوسُ إِلى التَراقي",43,"ق",2,0],["وَنِعمَ الحَيُّ في اللَزَباتِ عَبسٌ","إِذا ما الطَلحُ أَرجَفَهُ الدَبورُ",44,"ر",1,0],["وَنَعَم كَبِرتُ وَإِنَّما","تِلكَ الشَمائِلُ باقِيَه",45,"ي",2,0],["وَنَعلٍ كَأَشلاءِ السُمانى تَرَكتُها","عَلى جَنبِ مَورٍ كَالنَحيزَةِ أَغبَرا",46,"ر",2,0],["ونعودُ نَضْحَكُ للمروجِ","وللزَّنابقِ والغَديرْ",47,"ر",1,0],["ونعيدُ أُغنيَةَ السَّواقي","وهي تَلْغو بالخَريرْ",47,"ر",1,0],["ونعود نحيا مثلما","كنا بغير تبدّل",48,"ل",1,0],["ونعيش في حال التعا","سة بالأمانيِّ الكواذب",49,"ب",1,0],["ونعدّ تعذر أننُهَيِّئ خيرهم","فمن الأبوّة أن نحب ونرشدا",50,"د",2,0],["ونعم هذه يمينك لكن","حيل بين اليمين والصولجان",51,"ن",1,0],["وَنَعيمٍ وَنَضرَةٍ","وَظِلالٍ مِنَ الصِبا",52,"ب",2,0],["وَنَعلَمُ أَنّا في البِناءِ دَعائِمٌ","وَأَنتُم أَساسٌ في البِناءِ وَطيدُ",53,"د",1,0],["وَنَعشٍ كَالغَمامِ يَرِفُّ ظِلّاً","إِذا ذَهَبَ الزِحامُ بِهِ وَجاءَ",54,"ا",2,0],["وَنَعى النُعاةُ إِلى المُروءَةِ كَنزَها","وَإِلى الفَضائِلِ نَجمَها الوَضّاءَ",55,"ا",2,0],["ونعجن من خميرته سياقاً","يحدُّ علاجُها البصر الكليلا",56,"ل",2,0],["ونعوا عليَّ معايبي فحذرتُها","ونفيتُ عن أخلاقيَ الأقذاءَ",57,"ا",2,0],["وَنِعمَةٌ مِن أَمينِ اللَهِ ضافِيَةٌ","عَلَيكَ في رُتبَةٍ مِن دونِها الرُتَبُ",58,"ب",1,0],["وَنَعذُلُ الدَهرَ أَن وافى بِنائِبَةٍ","وَلَيسَ لِلدَهرِ فيما نابَنا أَرَبُ",58,"ب",1,0],["وَنَعتَمِدُ الحَقَّ حَتّى يُضيءَ","لَنا مُظلِمُ الأَمرِ أَو يَنبَلِج",59,"ج",1,0],["وَنَعرِفُ حَقَّ المَشرِفِيَّةِ كُلَّما","أَطارَ جُناةَ الحَربِ يَوماً مُطيرُها",60,"ر",3,0],["وَنِعمَ مَلاذُ الخائِفينَ وَحِرزُهُم","وَمَوئلُ ذي الجُرمِ العَظيمِ المُوائِلِ",61,"ل",1,0],["ونعرت بالماء ناعورة","حنينها كالبربط الناعر",62,"ر",1,1],["وَنَعبَثُ أَحياناً بِما لا نُريدُهُ","وَنَرفَعُ أَعلامَ المَخيلَةِ وَالكِبرِ",63,"ر",1,0],["ونعوتُ البيض حُمْرٌ عِندَهُ","لِدَمٍ تُكْسَاهُ من قَتلِ الأُسود",64,"د",1,0],["ونَعّمِيني بعُتبى","فقد شقيتُ بِعَتْبِك",65,"ك",1,0],["وَنِعمَ مُسَكِّنُ البُرَحاءِ حَلَّت","بِهِ فَأَقامَتِ الدَمعُ السَكوبُ",66,"ب",1,0],["وَنِعمَةٍ مِنهُ تَسَربَلتُها","كَأَنَّها طُرَّةُ ثَوبٍ قَشيبِ",67,"ب",1,0],["وَنِعمَ الصَريخُ المُستَجاشُ مُحَمَّدٌ","إِذا حَنَّ نَوءٌ لِلمَنايا وَأَرزَما",68,"م",2,0],["وَنَعلَمُ أَنَّنا سَنَبيدُ يَوماً","كَما قَد بادَ مِن عَدَدِ الشُعوبِ",69,"ب",1,0],["وَنَعسَةُ طَرفِ العَينِ مِن سِنَةِ الكَرى","لِرَجعِ خَريرٍ أَو لِشَجوِ هَديرِ",70,"ر",1,0],["ونَعرفُه إذا الأَجماتُ ريعَتْ","فَرُحْنا ننشدُ الأُسْدَ الغِضابا",71,"ب",2,0],["ونعلمُ أنّهم قومٌ ضِعافٌ","شَقُوا بالغاصِبينَ كما شَقِينا",72,"ن",2,0],["وَنَعلَمُ أَنّا عَلى واضِحٍ","مِنَ الحَقِّ يَعرِفُهُ ذو النَظَرْ",73,"ر",1,0],["وَنِعمَ فَتى الجُلّى إِذا ما تَوَثَّبَت","وَأَمسى الفَتى مِن دونِها وَهوَ جاثِمُ",74,"م",1,0],["وَنَعلَمُ أَن شَعبَ النيلِ طُرّاً","عَلَينا بِالرَجاءِ الحَقِّ يُلقى",75,"ق",2,0],["وَنُعِزُّ رايَتَها وَنَمنَعُ حَوضَها","وَنَزيدُ صادِقَ حُبِّها اِستَحكاما",76,"م",2,0],["ونِعمَ أخو الوغَى زيدٌ","إذا ما جَدَّ فَاقْتَحَما",77,"م",2,0],["وَنَعيش إِخواناً عَلى","مَحض المودّة وَالوِئام",78,"م",1,0],["وَنَعلٍ كَأَشلاءِ السُمانى نَبَذتُها","إِلى صاحِبٍ حافٍ وَقُلتُ لَهُ اِنعَلِ",79,"ل",1,0],["وَنِعمَ دَواءُ النَأي وَالكَرب جَسرَةٌ","وَأَبيَضُ مَصقُولُ الغَرارَينِ قاطِعُ",80,"ع",1,0],["وَنِعمَ الحَيُّ حَيُّ بَني كُلَيبٍ","إِذا اِختَلَطَ الدَواعي بِالدَواعي",81,"ع",2,0],["وَنَعيمٍ في وِصالٍ","حُلُّ مِن طولِ الصُدودِ",82,"د",1,0],["وَنُعمى تَضيقُ النَفسُ حينَ أَرُدُّها","شَكَرتُ عَلَيها ذا البَلادِ وَكافَيتُ",83,"ت",1,0],["وَنِعمَ العَينُ لِلناظِ","رِ في ظَلماءِ دَيجورِ",84,"ر",1,0],["وَنِعمَ أَميرُ المِصرِ يُصبِحُ لِلِّقا","وَدوداً وَفي الإِسلامِ عَفّاً مُوَدَّدا",85,"د",2,0],["وَنَعيمٍ بَغَيتُهُ","بَعدَ ما لَذَّ مَرقَدا",86,"د",2,0],["وَنَعيمي حينَ أَغفي","وَشِفاءُ اليَقَظاتِ",87,"ت",1,0],["وَنِعمَ جارُ العُيَّلِ السِغابِ","يَهوونَ في المُحمَرَّةِ الغِلابِ",88,"ب",1,0],["وَنَعطِف هاجِرَ الخِلّانِ كَيما","يَزولُ عَنِ السَجايا المُسئِماتِ",89,"ت",1,0],["وَنَعوذُ بِالخَلّاقِ مِن أُمَمٍ","أَوفى المَنازِلِ مِنهُمُ القَبرُ",90,"ر",1,0],["وَنِعمَ أُذينُ المَعشَرِ اِبنُ حَمامَةٍ","إِذا سَجَعَت لِلذاكِرينَ الحَمائِمُ",91,"م",1,0],["ونَعيبُها كنحيبِها وحِدادُها","أبداً سَوادُ قَوادمٍ وخَوَافِ",92,"ف",1,0],["وَنَعيماً قَد كنت أَرتَع فيه","وَهُوَ اليَوم لَيسَ إلا خَيالا",93,"ل",2,0],["وَنَعُبَّ الخمرَ من عُنقودها","واتركِ الدنَّ وخلِّ القدَحا",94,"ح",2,0],["ونِعْمَ الفَتى يا توبَ كُنْتَ ولَمْ تَكُنْ","لتُسْبقَ يوماً كُنْتَ فيه تُحاوِلُ",95,"ل",1,0],["ونِعْمَ الفَتى يا توبَ كنتَ لخائفٍ","أتاكَ لكي يُحْمى ونِعْمَ المجاملُ",95,"ل",1,0],["ونِعْمَ الفَتى يا توبَ جاراً وصاحِباً","ونِعْمَ الفَتى يا توبَ حين تُفاضِلُ",95,"ل",1,0],["ونِعْمَ الفَتى إنْ كانَ تَوْبَةُ فاجِراً","وفوق الفتى إن كان ليس بفاجِرِ",96,"ر",1,0],["وَنَعدو حينَ لا يُعدى عَلَينا","وَنَضرِبُ بِالمَواسي مَن يَلينا",97,"ن",2,0],["ونِعْمَ ذخيرَةُ البَدَوِيّ زَغْفٌ","أوانَ البِيضُ يُسْقِطْنَ الأجِنّه",98,"ن",2,0],["وَنِعمَ فَوارِسُ الهَيجاءِ قَومي","إِذا عَلِقوا الأَعِنَّةَ بِالبَنانِ",99,"ن",1,0],["وَنِعْمَتِ الهَيْفَاءُ مَا","فِي مَيْلِهَا مِنْ مَيَلِ",100,"ل",1,0],["وَنَعْرِفُ مِنْ حَقِّهِ فَوْقَ مَا","تَسَامَى إِلَيْهِ الْمُنَى وَالخُطُبْ",101,"ب",1,0],["ونِعْمَ الأَخُ الْوَافِي إِذَا مَا تَنَكَّرَتْ","لِصاحِبِهِ الأَيَّامُ لاَ يَتَنَكَّرُ",102,"ر",1,0],["ونُعِدُّ للأَعْدَاءِ كُلَّ مُقَلَّصٍ","وَرْدٍ وَمَحْجُولِ القَوَائِمِ أبْلقِ",103,"ق",1,0],["ونعمانَ وابنِ الجدِّ أَوْ ثَابِت بنِ","قَيْسٍ وأمثالُ ابنِ عَفْرَاءَ بالصّبْرِ",104,"ر",1,0],["ونَعمانُ أَوْفى بمِيثاقِهِ","وَحَنْظَلَةُ الخيرِ لَمْ يُحْنَجِ",105,"ج",1,0],["ونعم هل كانت كما صورت أم","بالغ في تلوينها المصور",106,"ر",1,0],["وَنَعِيمُ السَّرَّاءِ يَجْهَلُ مَعْنَا","هُ فَتىً لَمْ يُمَسَّ بِالضَّرَّاءِ",107,"ا",2,0],["ونُعِيتِ للدنيا فشبَّتْ لوعةٌ","أصلَى القلوبَ بحرِّها ناعيكِ",108,"ك",1,0],["ونعم التفى ياتوب كنت لخائف","أتاك لكي يحمي ونعم الجاملُ",109,"ل",1,0],["ونعود نضحك للمروج والزنابق والغدير","ونخاطب الاصداء وهي ترف في الوادي المنير",110,"ر",1,0],["ونعال الغزاة وهي كثير","فوق أعناقنا جباه وهام",111,"م",1,0],["ونعمتُ أُسبوعاً بها وسعيدةٌ","سَنَةٌ نعمتُ خلالهَا أسبوعا",112,"ع",2,0],["ونعمت ألمح في جفونك رغبة","خجلى صريعة نشوة ودعاب",113,"ب",1,0],["ونعم عندي بشرى عطّرت","بالزغاريد وجوه البشراء",114,"ا",2,0],["وَنِعْمَ مَلاذُ الخائِفِينَ وَحِرْزُهُمْ","وَمَوْئِلُ ذي الجُرْمِ العَظيمه المُوائلِ",115,"ل",1,0],["ونعرفه إذا الأجمات ريعت","فرحنا ننشد الأسد الغضاب",116,"ب",1,0],["ونعت شيخا كبيرا سيدا","ملأ الاقطار بالصيت الحسن",117,"ن",1,0],["ونعم لا عدمت وداد نعم","تساعدني على لهف الغرام",118,"م",1,0],["ونعمت في ظل البتول مع الالى","آل الرسول ودام رحبك نيرا",119,"ر",2,0],["ونعم أقرانه بحرٌ له زجلٌ","وسافياتٌ لها سجعٌ وأرنان",120,"ن",1,0],["ونعطى المعتفيني الكوم عودا","وفي المشتاة ننحرها سمانا",121,"ن",2,0],["ونعي الضلال فما تصدى باطلٌ","إلا وأزهق روحهُ إزهاقا",122,"ق",2,0],["وَنُعمى لِشَهرِ الصَومِ مُدَّ ظِلالَها","سَيَشكُرُها مَن صامَ فيهِ وَمَن صَلّا",123,"ل",2,0],["وَنُعِيدُ السَّنَا مِنَ الأَنْجُمِ الزُّهْ","رِ وَلَوْ لَمْلَمَتْهُ مِنْ أَلْفِ عَامِ",124,"م",1,0],["وَنَعِيشُ الحَيَاةَ أَغْلَى مِنَ الكَوْ","نِ وَأَحْلَى مِنْ شَائِقِ الأَحْلاَمِ",124,"م",1,0],["وَنِعمَ المُرَجّى في السِنينِ إِذا اِستَوَت","مِنَ الضُرِّ أَبناءُ السُرى وَالأَرامِلُ",125,"ل",1,0],["وَنِعمَ المُراعي لِلنَّزيلِ إِذا غَدا","أَكيلاً وَأَفنى مالَهُ مَن يُنازِلُ",125,"ل",1,0],["وَنِعمَ الصَريخُ المُستَجاشُ إِذا اِرتَوَت","لَدى الرَوعِ مِن هامِ الكُماةِ المَناصِلُ",125,"ل",1,0],["وَنِعمَ لِسانُ القَومِ إِمّا تَأَخَّرَت","عَنِ القَولِ ساداتُ الرِجالِ المَعاوِلُ",125,"ل",1,0],["وَنِعمَ مُناخُ الرَكبِ أَهدى لَهُ السُرى","سَنا النارِ في الظَلماءِ وَالعامُ ماحِلُ",125,"ل",1,0],["وَنِعمَ لِسانُ القَومِ إِن قيلَ مَن لَها","خَطيبٌ وَأَعيَى الحاضِرينَ مَقالُها",126,"ل",3,0],["وَنِعمَ مُناخُ الطارِقينَ إِذا أَتَت","تُقَلقِلُ مِن بَعدِ الهُدُوِّ رِحالُها",126,"ل",3,0],["وَنِعمَ مَلاذُ المُعتَفينَ إِذا نَبا","زَمانٌ وَهَبَّت عامَ مَحلٍ شَمالُها",126,"ل",3,0],["وَنِعمَ سَدادُ الثَغرِ تَكثُرُ دُونَهُ","مَعاذيرُ أَربابِ العُلى وَاِعتِلالُها",126,"ل",3,0],["وَنِعمَ مُناخُ الطارِقينَ رَمَت بِهِم","شَآمِيَّةٌ تُزجي سَحاباً حَوافِلا",127,"ل",2,0],["وَنِعمَ المُراعى لِلنَزيلِ وَطالَما","أَحَلَّت رِجالٌ بِالنَزيلِ النَوَازِلا",127,"ل",2,0],["وَنِعمَ لِسانُ القَومِ في يَوم لا تَرى","لِكِلمَةِ فَصلٍ تَرفَعُ الشَكَّ قائِلا",127,"ل",2,0],["وَنِعمَةً لَكَ عِندي لا يُقاوِمُها","شُكري وَمِن أَينَ لي شُكرٌ يُؤَدِّيها",128,"ي",3,0],["وَنَعلمُ أنّ الروحَ في الجسم غيره","وَما الجسمُ إلّا بيتهُ فيه قد قرّا",129,"ر",2,0],["وَنعمةُ اللَّه سبيل اللَّهِ","وَأنعمُ اللَّه صراطُ اللَّهِ",130,"ه",1,0],["ونعم قد قضيت يوم نأوا","فيه لكن من الهوى يخبي",131,"ب",2,0],["ونعم يلذ لي الكرى لكن ارى","مهري عليه الذ من اغفائي",132,"ا",2,0],["ونعم انني تغيرت لكن","من سقامي ولوعتي وزفيري",133,"ر",2,0],["ونعيمٍ لانَ مَعطِفُه","قد تَردَّى الطِّيبَ واشتمَلا",134,"ل",2,0],["ونَعيمٍ جَذَبْتُ طِيبَ التّصابِي","فيه جَذْبَ الصّدودِ للمعشوق",135,"ق",1,0],["ونعمةٌ وسُعودٌ","للمُعْتَفين وجَاه",136,"ا",2,0],["وَنِعْمَ الْبَحْرُ فَضْلُكَ وَهْوَ طَامٍ","إِذَا قَالَ الثَّنَاءُ بِكَ اعْتِصَامِي",137,"م",2,0],["وَنِعْمَ الْبَدْرُ وَجْهُكَ حِينَ يُمْسِي","وَقَدْ عَاضَ اللِّثَامَ بِالاِبْتِسَامِ",137,"م",1,0],["ونعيذ ذاتك بعد ان يهدى لنا","ضمن التهاني في القريض تعازي",138,"ز",2,0],["ونعم مولى بدهر تكتسى شرفاً","منه الموالي وبعض الفضل يكتسب",139,"ب",1,0],["ونعم أبو الضيوف إذا أطاحت","بيوت الحي عاصفة الرياح",140,"ح",1,0],["وَنِعْمَ الْمُوضِحُ الْعَميْاءَ رَأْياً","وَقَدْ كَثُرَ التَّمادِي وَالتَّلاحِي",140,"ح",2,0],["وَنِعْمَ مُفَرِّجُ الْغَمَراتِ عَزَّتْ","عَلَى سَوْمِ الأَسِنَّةِ وَالصِّفاحِ",140,"ح",1,0],["ونعرب عن صداقتنا ونبدي","لمولانا المعظم رسم عيد",141,"د",1,0],["وَنعمتُ من أفيائِه","وَظلالهِ بجنانِ عدن",142,"ن",1,0],["ونعتُها طريقةٌ","كما ترى مبتكره",143,"ر",2,0],["ونعمت طرفي إذ نظرت به إلى","شقائقَ روضٍ لا شقاءِ قريضِ",144,"ض",1,0],["وَنعّمَ بِالتأميلِ فيكُم حُشاشتي","وعذّبني بِالشوقِ وهو شديدُ",145,"د",1,0],["وَنِعمَةً لَيسَ تَفنى","وَغِبطَةً لا تُحَدَّدِ",146,"د",1,0],["ونعيمي هواك","بيغنّى لقلبك",147,"ك",1,0],["ونعمت في الاحلام أنشد غايتي","طيف الحبيب ولذتي وفتوني",148,"ن",2,0],["ونعقد فوق هامك تاج غار","ونسكنك الحنايا والضلوعا",149,"ع",2,0],["وَنِعْمَ مَن وَكَّلَهُ هَيّناً","وَحَسْبُنا اللَّهُ وَنِعْمَ الوَكِيلْ",150,"ل",1,0],["وَنِعْمَ الفِداءُ لَهُمْ قد بَعَثْتَ","من الفائقات ذَواتِ الشُُّحُومِ",151,"م",1,0],["وَنَعيمي في جَحيمي","نَضَجَت فيهِ جُلودي",152,"د",2,0],["وَنِعمَ النَدامى هُم غَداةَ لَقيتُهُم","عَلى الدامِ تُجرى خَيلُهُم وَتُؤَدَّبُ",153,"ب",1,0],["وَنِعمَةٌ في قَرارِ العِزِّ خالِدَةً","وَكَوكَبٌ في سَماءِ الفَخرِ وَقّادُ",154,"د",1,0],["وَنَعَم رَضيتُ بِما فَعَل","تَ عَلى تَعَسُّفِهِ رَضيتُ",155,"ت",1,0],["ونعلو على الناس فيما نقول","وكلٌ له سامعٌ قابل",156,"ل",1,0],["ونعبده بالوهم شخصاً محيَّزاً","وحاشاه من شخصٍ يُحيِّزُه وصفي",157,"ف",2,0],["ونَعيتُ كلّي بعد فرقةِ جزئه","بالموت إذ كلّي لجزئي يَتبع",158,"ع",1,0],["ونعمتُه إذاجاءت تجلت","عليك وأنت بالإنعام أدرى",159,"ر",2,0],["ونعيم ربٍّ خالدٍ","خيراته لا تنتزح",160,"ح",1,0],["ونعشق نخلها يعطي غذاءً","ويَنْبُوعَ الهدى يشفي الغَليلا",161,"ل",2,0],["ونعقدُ رايةً لِلْوصل بَيْضا","إذا انْهزمَ البعادُ على يديه",162,"ي",2,0],["ونَعَتْهُ أطيار السماء بواكياً","لمّا رأتْ أمراً فظيعاً مُنكرا",163,"ر",2,0],["ونعم ها هنا فريق يقولو","ن بأنا أنصار كل الأئمة",164,"م",2,0],["ونعمةُ غيرِهِ عارٌ عَلَيهِ","كَمِثلِ الخُلي لِلسَّيفِ الكِهامِ",165,"م",1,0],["ونعماه ناعيه وقال مؤَرِّخاً","قد مات ويك أبو الثنا محمود",166,"د",1,0],["ونعاني أسًى لأرسم دارٍ","شقيت من بعاد سَلمَى وسعدى",167,"د",2,0],["ونُعْمِلُ كالأَهِلَّةِ ضامراتٍ","لنبلُغَ فوقها القَمَرَ التَّماما",168,"م",2,0],["ونُعْمَى مَنْ رَأَى الأَجسامَ عُطْلاً","فَقَلَّدَها أَيادِيَهُ الجِساما",168,"م",2,0],["ونَعَمْ جهِلْتُ فقمتُ عن نِعمِ","كانت لَديْكَ وقُمْتُ في نِعَم",169,"م",1,0],["ونعيمٌ دارُنا اللدَّ","ةُ من دارِ النعيمِ",170,"م",1,0],["ونعمْ سأخدمُها ومث","لُ جلالِك المشهورُ يُخْدَمْ",171,"م",1,0],["ونعم كفيلُ الشَّمْسِ حاجِبُها الَّذِي","يشيِّعُنا فِيهَا ويَخْلُفُها فينا",172,"ن",2,0],["ونَعْلَمُ أَنَّ اللهَ أَبْقى لأَرْضِهِ","رِعَايَةَ رَاعِيها وعَطْفَ عَطُوفِها",173,"ف",3,0],["ونعمة اللَه في المخلوق شاهدةً","عليه من عقله المنصور عن فلج",174,"ج",1,0],["ونعيمها الصافي يكدره الردى","إن النعيم مع المنون ضريع",175,"ع",1,0],["ونعيجات له من سمنها","ولباها خير مطعوم مقيت",176,"ت",1,0],["ونعيمٍ والاه في حجرة الأُتْ","رُجِّ والماء قد أثار بخاره",177,"ر",2,0],["ونعشقُ جَمعكِ فوقَ الهضاب","ويستوقفُ الجمعُ حتىّ السحاب",178,"ب",1,0],["ونَعمْ أعذرُكم فالتمسوا","عِذرةَ المجد إذا ما المجدُ لاما",179,"م",2,0],["ونعمة موشيّة","حَوْكَ برودِ الرَّقْمِ",180,"م",1,0],["ونَعمْ لهم تلك النَّطافُ صفتْ","وامتدّ سابغُ ذلك الظلِّ",181,"ل",1,0],["ونعمةٌ تُخْلَق مثلَ أختها","في الحسن أو يُحذَى عن مثالها",182,"ل",3,0],["ونعم صدقتَ سواك من أصغى لها","سَرَفاً وأسمعه بها الهتَّافُ",183,"ف",1,0],["ونعى أبا بكرٍ إليَّ صباحُهَا","لسفاههِ لو كان يعلم مَن نعى",184,"ع",2,0],["ونعم بكيت فهل تبل","لُكَ سائلاً أخبارُها",185,"ر",3,0],["ونعماه إن دهري أغار حُماتهُ","على الحُرّ من مسّ الهوانِ تَغارُ",186,"ر",1,0],["ونعمة أثقلتُمُ كاهلي","بحملها وهي يدٌ من أَيادْ",187,"د",1,0],["ونِعَمٌ نابتةٌ","مع الربيع جُدُدُ",188,"د",1,0],["ونِعمَ عدوّ مالِكَ كنت فيهم","وخصبُ الجالباتِ الرابحاتِ",189,"ت",1,0],["ونعمةٌ تسير في نُضوحها","خَرْقَ الجديب فيُرَى خصيبا",190,"ب",2,0],["ونِعْمَ الفتى يثْني إليه بنو السُّرى","رقاب المَطايا من جمالٍ وأيْنُقِ",191,"ق",1,0],["ونِعْمَ مُبيتُ طرَّاقِ الليالي","إذا بخلتْ بِدَرَّتها الغِزارُ",192,"ر",1,0],["ونعمَ مُناخ الطارقين عشيَّةً","اذا حارَدتْ غبر السنين العواقر",193,"ر",1,0],["ونعم مُناخِ الطَّارقينَ بأزْمَةٍ","إِذا أكفأتْ غُبْرُ السنينَ المَقاريا",194,"ي",2,0],["ونعم الكميُّ الذِّمْرِ رأياً ونجدةً","اذا السمر خامت وارجحنت صدورها",195,"ر",3,0],["ونِعْمَ مبيتُ الطَّارقينَ عَشيَّةً","إذا أخمدتْ نار اليَفاعِ الزَّعازع",196,"ع",1,0],["ونِعْمَ مُناخُ الطَّارقينَ عشيَّةً","إذا ما المشاتي جعجعتْ بالرَّواحلِ",197,"ل",1,0],["ونِعْمَ مُناخُ الطَّارقين عَشيَّةً","إذا أخمد الشَّفَّانُ نارَ المَراقِبِ",198,"ب",1,0],["ونِعْم الفتى الكَرَّار في كل مأزقٍ","إذا انْتعلتْ هامَ الكُماةِ الحَوافر",199,"ر",1,0],["ونِعْمَ مُناخُ الطَّارقينَ عَشيَّةً","إذا ضاقَ ذرْعُ الحيِّ بالنُّزَلاءِ",200,"ا",2,0],["ونِعْمَ مَبيتُ طُرَّاقِ اللَّيالي","إذا صَفِرتْ من المَحْلِ الوطابُ",201,"ب",1,0],["ونعم غداةَ الحرب أنت ابن همَّةٍ","يلاقي ليالي نقعها غيرَ جازع",202,"ع",1,0],["ونعدُّها ذخراً ونعمَ","الذخرَ للملك المشيَّد",203,"د",1,0],["ونعمَ حماةُ الظعنِ والسيف باسم","وغيد الغواني باكيات من الذعر",204,"ر",1,0],["ونُعلي البناءَ المشمخرَّ وكلنا","إلى جدثٍ ضنكِ الإقامةُ نودع",205,"ع",1,0],["ونعمَ ربيبةُ العلياءُ ردّتْ","بهِ ظعن الحريم المستباح",206,"ح",1,0],["ونعرف سر الله في الخلق لا يغي","ب عنا شهود الحق في الدنى والأخرى",207,"ر",2,0],["ونعلم أن مدحاً لم يقيد","به إحسانكم كذب وزور",208,"ر",1,0],["ونعلمُ كل ذاك وحين يأتي","يعودُ له لمنزلِنا دُخولُ",209,"ل",1,0],["ونعود نفترع النجوم وحسبنا","فيما نؤمل ان متنك مركب",210,"ب",1,0],["وَنعى إليَّ الشُّمسيَّ مُخْبِّرٌ","فوددتُ أنّ لسانَه لم يُخلَقِ",211,"ق",1,0],["ونعشق في دار الفَناءِ مواطناً","يعرّين منّا لم يكنّ معاشقا",212,"ق",2,0],["ونعى إليّ وليتَه لم ينعَ لي","عَنَتَ القُرومِ وفاضحَ السّوّاسِ",213,"س",1,0],["وَنَعِمْتَ بِالنّيروزِ نعمةَ ناشدٍ","أضحى وَحشوُ يمينِهِ المنشودُ",214,"د",1,0],["ونُعدى بداء الموتِ ممَّنْ أَصابهُ","وَعَدوى المَنايا غَيرُ عَدوى الأجاربِ",215,"ب",1,0],["وَنُعاتبُ الأيّامَ في فُرُطاتها","لكنْ نُعاتب سادراً لا يُعتبُ",216,"ب",1,0],["وَنِعمَةٍ سابغةٍ قَلّصتْ","وَمَنزلٍ بَعَد كَمالٍ عفا",217,"ا",1,0],["ونعيم أهل الكشف رؤية طلعة ال","محبوب بالوجه الجميل الدائم",218,"م",1,0],["ونعيمه وعذابه متنوع","أبدا كأمواج البحار الزاخره",219,"ر",2,0],["ونعلم نحن الرتبتين كلاهما","ونعرف ما قد غاب عن جاهل غمر",220,"ر",1,0],["ونِعمةً طَوَّقَتْ عُنقي قَلائِدُها","بالأمسِ واليومُ موصولٌ بهِ وغَدُ",221,"د",1,0],["ونَعَمْ صَبَوْتُ إِليه حين وَفَى","ونعمْ صبرتُ عليه حِينَ غَدَرْ",222,"ر",1,0],["ونعم لهم نعم فلم","شرَدُوا كما شَرَدَ النَّعامُ",223,"م",1,0],["وَنَعَمْ سِوايَ له الوِصَا","لُ كما أَرَى ولي الغَرَامُ",223,"م",1,0],["ونِعمَةُ الظَّالمِ بالظَّ","المِ كالظَّليم",224,"م",1,0],["ونَعم لقد طرقَ الحبيبُ وما لَه","إِلا خدودُ العاشقين طريقُ",225,"ق",1,0],["ونَعم دَرى لَمَّا رأَى في بُردَتِي","ردعاً وشمَّ مِن الثِّيابِ العَنْبَرا",226,"ر",2,0],["ونعيمُ الدُّنيا إِذَ