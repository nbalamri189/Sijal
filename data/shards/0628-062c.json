يع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"]],"verses":[["بِجَيشٍ لا غُبارَ لِحَجرَتَيهِ","قَليلِ الرُزءِ غَرّارِ السَرايا",0,"ا",3,0],["بِجُرْدٍ يُجاذِبْنَ الأَعِنَّةَ أَيْدِيَاً","لَبيقَاتِ أَطْرِافِ الأَنامِلِ بِالندى",1,"د",2,0],["بجِزْعٍ بِطاحيٍّ يَنوشُ أراكَهُ","مَهاً في خَليطَيْ أُسْدِهِ ونِمارِهِ",2,"ر",2,0],["بِجَيشٍ كُلَّما لاحَظتُ فيهِ","حَسِبتُ الأَرضَ قَد مُلِأَت رِجالا",3,"ل",2,0],["بِجَزعٍ مِنَ الوادي خَلا عَن أَنيسِهِ","عَفا وَتَخَطَّتهُ العُيونُ الخَوادِعُ",4,"ع",1,0],["بجَنِيِّ وَرْدِ شجَّ وجْنَتَهُ النّدى","وبسَوسَنٍ شُقَّتْ علَيْهِ بُرودُهُ",5,"د",2,0],["بِجُلالَةٍ سُرُحٍ كَأَنَّ بِغَرزِها","هِرّاً إِذا اِنتَعَلَ المَطِيُّ ظِلالَها",6,"ل",3,0],["بِجَمالِ مَحجَرِها وَتعلَمُ ما الَّذي","تُبدي لِنَظرَةِ زَوجِها وَتُواري",7,"ر",2,0],["بِجَوارٍ مُنشَآتٍ كَالدُمى","أَينَما سارَت صَبا البَحرُ وَهاما",8,"م",2,0],["بِجَبينٍ مِثلِ الصَباحِ مُنيرٍ","تَحتَ لَيلٍ تَضلُّ فيهِ المَداري",9,"ي",1,0],["بِجَنانِ مَضّاءِ العَزائِمِ رَأيُهُ","في الحَربِ غَيرُ الفائِلِ الضَعضاعِ",10,"ع",1,0],["بِجَمعٍ مِن بَني قُرّانَ صيدٍ","يُجيلونَ الطِعانَ إِذا أَجالا",11,"ل",2,0],["بِجيدٍ كَجيدِ الرِئمِ حالٍ تزينُهُ","غَدائِرُ مُستَرخي العِقاصِ يَصورُها",12,"ر",3,0],["بِجَمِيلِ مَا صَنَعُوا وَمَا رَفَعُوا","فَازَ الوِئَامُ وَخَابَتِ الإِحَنُ",13,"ن",1,0],["بِجَنَابِ ظَاهِرَةِ الثَّنَا مَحمُودَةٍ","لا يُستَطَاعُ كَلامُها إِعظَامَا",14,"م",2,0],["بِجَرعائِها مِن سامِرِ الحَيِّ مَلعَبٌ","وَآرِيُّ أَفراسٍ كَجُرثومَةِ النَملِ",15,"ل",1,0],["بِجانِبِ الزُرقِ لَم تَطمِس مَعالِمَها","دَوارِجُ المورِ وَالأَمطارُ وَالحِقَبُ",16,"ب",1,0],["بجميع الكون مظهر","لكرام ولجود",17,"د",1,0],["بِجُردٍ كَالقِداحِ مُسَوَّماتٍ","بِأَيدينا يُعارِضنَ السَماما",18,"م",2,0],["بِجَسرَةٍ تَنجُلُ الظُرّانَ ناجِيَةَ","إِذا تَوَقَّدَ في الدَيمومَةِ الظُرَرُ",19,"ر",1,0],["بِجَيشٍ لايَحِلُّ بِهِم مُغيرٌ","وَرَأيٍ لايَغِبُّهُمُ مُغارِ",20,"ر",1,0],["بِجَيشٍ جاشَ بِالفُرسانِ حَتّى","ظَنَنتَ البَرَّ بَحراً مِن سِلاحِ",21,"ح",1,0],["بجوهر الكأس يجلو لي بها عرضاً","ظبيٌ يفدَّى بأشباحٍ وأرواح",22,"ح",1,0],["بجاهك عند الله أقبلت لائِذاً","فكثرت حاجاتي وجاهك أكثر",23,"ر",1,0],["بجود يديك ابن فضل الإله","تناسب منطقي الأبهر",24,"ر",1,0],["بجفن رشاً إن تسمه السحر لم يحد","وإن تدعه حدّ الحسام فأخلق",25,"ق",1,0],["بجودٍ وزهدٍ وخطٍّ بهر","ت فأنتَ الوليّ على كلّ حال",26,"ل",1,0],["بجفونها وبفرعها يا مغرم","وافى بنصرتها السواد الأعظم",27,"م",1,1],["بجفنِهِ نادى الهوى يا للشجي","وكلُّ ياءٍ بعد مكسورٍ تجي",28,"ي",1,0],["بِجَهْلٍ كجهلِ السيفِ والسيفُ مُنْتَضىً","وحلْمٍ كحلم السيف والسيفُ مُغْمَدُ",29,"د",1,0],["بجود ما انقادت البلاد له","حتى إذا ما استثارها ضعفا",30,"ف",2,0],["بجدواه يُغفرُ لي لومُهم","ويُغمدُ عني لسان الملامِ",31,"م",1,0],["بِجَهَنَّمٍ لَكِنَّما أَن لا تُحِبَّ جَهَنَّمُ","يا صاحِبي إِنَّ الخَواءَ هُوَ العَذابُ الأَعظَمُ",32,"م",1,0],["بِجَهَنَّمٍ بَِلساكِني حُجراتِها","بِمَواقِدٍ النيرانِ بِالنيرانِ",33,"ن",1,0],["بِجُردٍ عَلَيهِنَّ الأَجِلَّةُ سُوِّيَت","بِضَيفِ الشِتاءِ وَالبَنينَ الأَصاغِرُ",34,"ر",1,0],["بِجانِبِ رامَةٍ فَوَقَفتُ يَوماً","أُسائِلُ رَبعَهُنَّ فَما أَحارا",35,"ر",2,0],["بِجَنوبِ لينَةَ ما تَزالُ بِراكِبٍ","تُذري مَناسِمُها بِهِنَّ الحَنظَلا",36,"ل",2,0],["بجَدّهم في السَنة اِستَسقى عُمَر","هَزّ الغَمامَ بِالغَمام فَاِنهَمَر",37,"ر",1,0],["بِجِلْبَابِ نارٍ قَدْ تَجَلْبَبَ جِسْمُها","وآخر مِنْ طينٍ وليس بلازبِ",38,"ب",1,0],["بِجِسمي مَن بَرَتهُ فَلَو أَصارَت","وِشاحي ثَقبَ لُؤلُؤَةٍ لَجالا",39,"ل",2,0],["بِجَوىً مُقيمٍ لَو بَلَوتِ غَليلَهُ","لَوَجَدتِهِ غَيرَ الجَوى المُعتادِ",40,"د",1,0],["بِجودِكَ يَدنو النائِلُ المُتَباعِدُ","وَيَصلُحُ فِعلُ الدَهرِ وَالدَهرُ فاسِدُ",41,"د",1,1],["بِجَيشٍ تُستَباحُ بِهِ الضَواحي","وَتَعتَصِمُ العَواصِمُ وَالثُغورُ",42,"ر",1,0],["بِجَدِّ العُلا أَنَّ العَلاءَ بنَ صاعِدٍ","عَلا صاعِداً يَقصو مَداها وَيَفرَعُ",43,"ع",1,0],["بِجَمعٍ تَرى فيهِ النَهارَ قَبيلَةً","إِذا سارَ فيهِ وَالظَلامَ قَبائِلا",44,"ل",2,0],["بِجِسمي سَقامٌ كُلَّما جُزتُ رَدَّني","إِلى كَمَدٍ في الصَدرِ غَيرِ سَقيمِ",45,"م",1,0],["بِجابِيَةِ الجَولانِ باتَت عُيونُنا","كَأَنَّ عَواويراً بِها مِن بُكائِها",46,"ا",3,0],["بَجيلَةُ عِندَ الشَمسِ أَو هِيَ فَوقَها","وَإِذ هِيَ كَالشَمسِ المُضيأَةِ يُطرِقِ",47,"ق",1,0],["بِجابِيَةِ الجَولانِ إِذ عَمَّ فَضلُهُ","عَلَينا وَقِدماً كانَ جَمُّ الفَواضِلِ",48,"ل",1,0],["بجلجل في نحره صخّاب","أحفظ للباب من البواب",49,"ب",1,0],["بِجُودِ أبي الهَيْجاءِ أُلبِسْتُ نِعْمَةً","مُجدَّدَةً تَضْفو عليَّ وتُشرِقُ",50,"ق",1,0],["بجيشٍ للمَنايا فيه جيشٌ","شديدُ البأْسِ في النُّوبِ الشِّدادِ",51,"د",1,0],["بجديدِ الشُّؤبوبِ يُصبحُ منه","خَلَقُ الرَّوْضِ نَاضراً مُستَجِداً",52,"د",2,0],["بجُردٍ تُثيرُ النَّقعَ حتى كأنَّما","تُمزِّقُ منه البِيضُ ثَوبَ حِدادِ",53,"د",1,0],["بِجيدِ مُغزِلَةٍ أَدماءَ خاذِلَةٍ","مِنَ الظِباءِ تُراعي شادِناً خَرِقا",54,"ق",2,0],["بِجَفنٍ يَجيءُ بِبيضٍ غَزَت","تَشَجُّ فَتَنفُذُ في جُبَّتي",55,"ت",2,0],["بِجُفونٍ لَها فُتورُ ذَوي السِك","رِ عَلى ضُعفِها وَفَتكُ الصُحاةِ",56,"ه",1,0],["بِجَيشٍ تَرجُفُ الراياتُ فيهِ","وَتَخفِقُ دونَ مَقدَمِهِ البُنودُ",57,"د",1,0],["بِجِنَانٍ يُقيمُ فيها مُقِيمٌ","أو بنارٍ فيها عذابٌ مهينُ",58,"ن",1,0],["بجيشٍ تثيرُ الجردُ فيه قساطلاً","تريكَ بها وَجْهَ الغزالةِ قائما",59,"م",2,0],["بِجُمْلٍ حَدا الغَيْرَانُ بُزْلَ جمائِلهْ","وأرْقصَ قامات القَنَا في قَنابِلِهْ",60,"ل",2,1],["بِجودِهِ اِنصاتَتِ الأَيّامُ لابِسَةً","شَرخَ الشَبابِ وَكانَت جِلَّةً شُرُفا",61,"ف",2,0],["بِجودِكَ تَبيَضُّ الخُطوبُ إِذا دَجَت","وَتَرجِعُ في أَلوانِها الحِجَجُ الشُهبُ",62,"ب",1,0],["بجنابكم نتعلقُ","وإليكم نتشوَّقُ",63,"ق",1,1],["بِجانِبِ البَوباةِ لَم يَعدُهُ","تَقادُمُ العَهدِ بِأَن يُؤهَلا",64,"ل",2,0],["بِجَوارٍ خَرائِدٍ","ذاكَ وَالوُدُّ يُبذَلُ",65,"ل",1,0],["بِجودي عَلى لَيلى بِوُدّي وَبُخلِها","عَلَيَّ سَلاها أَيُّنا كانَ أَظلَما",66,"م",2,0],["بِجِزعٍ مِنَ الوادي فَضاءٍ مَسيلُهُ","وَأَعلاهُ أَثلٌ ناعِمٌ وَسَديرُ",67,"ر",1,0],["بُجَيْرٌ كيفَ يُخطِئُكَ السّدادُ","ويَجنحُ ضِلَّةً منك القِياد",68,"د",1,1],["بُجاوِيَّةً لَم تَستَدِر حَولَ مَثبِرٍ","وَلَم يَتَخَوَّن دَرَّها ضَبُّ آفِنِ",69,"ن",1,0],["بِجِلادٍ يَفري الشُؤونَ وَطَعنٍ","مِثلِ إيزاغِ شامِذاتِ المَخاضِ",70,