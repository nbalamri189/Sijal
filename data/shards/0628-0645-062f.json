 أهّلتني لنظامها","فغدت محررة وعنقيَ مسترق",2,"ق",1,0],["بِمدرهٍ كلتا يديه تارسه","يأوي إلى عادية قُدامسه",3,"س",2,0],["بمِدَحٍ أحسن من نشر الرممْ","أو من شباب ناشئ بعد هرمْ",4,"م",1,0],["بِمِدْحَةٍ أَو رثاءٍ","تُهدى لرَبِّ السَّريرِ",5,"ر",1,0],["بمداد أحمر يخ","طِفُ نور البصرين",6,"ن",1,0],["بِمُدَّرِعينَ اللَيلَ مِمّا وَرائَها","بِأَنفُسِ قَوماً قَد بَلَغنَ التَراقِيا",7,"ي",2,0],["بمُدامَةٍ شَّبهتُ فاضلَ كأسِها","من لونها في رقّةٍ وصَفاءِ",8,"ا",2,0],["بِمَديدِ الظِلالِ مُقتَضَبِ الرَأ","يِ بَسيطِ النَدى طَويلِ النِجادِ",9,"د",1,0],["بِمُدمَجاتٍ زانَها إِدماجُها","مُعَوَّجاتٍ حُسنُها اِعوِجاجُها",10,"ه",2,0],["بِمَدحِكَ تَمَّت حِجَّتي وَهيَ حُجَّتي","عَلى عُصبَةٍ يَطغى عَلَيَّ فُجورُها",11,"ر",3,0],["بِمُدامَةٍ نَغَمُ السَماعِ خَفيرُها","لا خَيرَ في المَعلولِ غَيرَ مُعَلَّلِ",12,"ل",1,0],["بِمُدامَةٍ تَغدو المُنى لِكُؤوسِها","خَوَلاً عَلى السَرّاءِ وَالضَرّاءِ",13,"ا",2,0],["بمدةٍ مِنْ قلمٍ واحدٍ","تكتبُ في الشرعِ وفي المكسِ",14,"س",1,0],["بِمَدْحِ المصطفى تَحيا القلوبُ","وَتُغْتَفَرُ الخطايا وَالذُّنوبُ",15,"ب",1,1],["بِمُدامَةٍ وَرِثَ الزَمانُ لُبابَها","عَن ذي الأَوائِلِ مِن أَكابِرِ عادِ",16,"د",1,0],["بِمَدْرَسَةِ التَّجَلِّي وَهْيَ دَارٌ","بَنَاهَا لِلْهُدَى خَيْرُ البُنَاةِ",17,"ه",1,1],["بمديحي لإمامِ المرسلينا","أحمدَ الهادي الذي أمتُهُ",18,"ه",1,0],["بمُدَّرِعِينَ اللّيْلَ مِمّا وَرَاءَهَا،","بأنْفُسِ قَوْمٍ قَدْ بَلَغنَ التّرَاقِيا",19,"ي",2,0],["بمدحٍ أحسنَ من نشر الرممْ","أو من شباب ناشىء بعد هرمْ",20,"م",1,0],["بِمَدح كُل عَظيم القَدر أَو حَسَنٍ","تَعلو وَتَغلو مِن الأَشعار قيمتها",21,"ه",2,0],["بمدرسةِ الحقوقِ أفاضَ علماً","سرت نفحاتهُ في كلِّ نادِ",22,"د",1,0],["بمدامع لمَّا تَغِضْ ومَكاسرٍ","لم تَنجبر وجرائحٍ لم تُسبَرِ",23,"ر",1,0],["بِمَدحٍ إِذا ما ضاعَ في القَومِ نَشرُهُ","فَما النَدُ أَهلٌ أَن يَكونَ لَهُ نِدّا",24,"د",2,0],["بِمُدرِكٍ وَهوَ لِلهَيجاءِ مُعتَزِلٌ","ما لَم يَنَلهُ سِواهُ وَهوَ مُعتَزِمُ",25,"م",1,0],["بِمَدحِ الَّذي حازَ السَناءَ إِلى السَنا","مُنى كُلِّ ذي قَلبٍ وَأَحلى مِنَ المُنى",26,"ن",2,0],["بِمَدحِ النَبيِّ اقطَع زَمانَ