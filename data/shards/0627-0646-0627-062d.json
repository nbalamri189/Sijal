],[5688,"سعيد فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=200891",""],[5694,"نرهب عدو الدين","https://www.poetsgate.com/ViewPoem.aspx?id=129915",""],[5704,"أَمَل...","https://www.poetsgate.com/ViewPoem.aspx?id=191297",""],[5707,"يَا مبدعاً فِي النّظم والنثر","https://www.poetsgate.com/ViewPoem.aspx?id=189185",""],[5756,"التمثال","https://www.poetsgate.com/ViewPoem.aspx?id=1366",""],[5782,"أوزان وشطآن","https://www.poetsgate.com/ViewPoem.aspx?id=185767",""],[5804,"لا تلم في الزمان حرا غريبا","https://www.poetsgate.com/ViewPoem.aspx?id=215193",""],[5843,"وطن عمري","https://www.poetsgate.com/ViewPoem.aspx?id=51293",""],[5848,"الخطا شين","https://www.poetsgate.com/ViewPoem.aspx?id=53176",""],[5848,"ياموت","https://www.poetsgate.com/ViewPoem.aspx?id=53382",""],[5848,"على الطاير","https://www.poetsgate.com/ViewPoem.aspx?id=53189",""],[5891,"أحلام الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=39927",""],[5899,"شهيدة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=31491",""],[5939,"جحود","https://www.poetsgate.com/ViewPoem.aspx?id=178579",""],[5939,"بسكوتة!","https://www.poetsgate.com/ViewPoem.aspx?id=195175",""],[5952,"وجْهُ فَلا","https://www.poetsgate.com/ViewPoem.aspx?id=214017",""],[5956,"إلى أن أموت","https://www.poetsgate.com/ViewPoem.aspx?id=183873",""],[5956,"لله درك يا أحنَّ حبيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=193815",""],[5956,"أنا أرتينُ المُشاغِبْ","https://www.poetsgate.com/ViewPoem.aspx?id=205157",""],[5956,"الشعر يُشعل نورَه العظماءُ","https://www.poetsgate.com/ViewPoem.aspx?id=208507",""],[5960,"أنا حاكمٌ عربيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=31108",""],[6019,"عتاب على هامش الشوق ...!!","https://www.poetsgate.com/ViewPoem.aspx?id=53042",""],[6056,"أنا ياناس من قدي","https://www.poetsgate.com/ViewPoem.aspx?id=130359",""],[6056,"الخنجر المذروب","https://www.poetsgate.com/ViewPoem.aspx?id=130515",""],[6056,"عيب ٍ عليك ...","https://www.poetsgate.com/ViewPoem.aspx?id=130525",""],[6102,"فارسية","https://www.poetsgate.com/ViewPoem.aspx?id=184546",""],[6152,"حبك عالمي الأروع","https://www.poetsgate.com/ViewPoem.aspx?id=204685",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[6174,"سفر في قصيدة حبّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86188&r=&rc=5",""],[6257,"رحيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87183&r=&rc=8",""],[6288,"فراديس الرند","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78520&r=&rc=0",""],[5567,"آخر الوصايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81814&r=&rc=64",""],[5567,"أبدو .. ولا أبدو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81749&r=&rc=21",""],[5567,"حوادم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69069&r=&rc=7",""],[6355,"ذكرى بدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66682&r=&rc=142",""]],"verses":[["أَنا حَربُ ضِدِّكَ فَاِرضِني حَرباً لَهُ","وَاِرضَ السِنانَ مُصَمِّماً لِطِعانِ",0,"ن",1,0],["إِن أَحسَنوا عَمّوا بِنائِلِهِم","وَإِذَ رَموا بِجَريرَةٍ خَصّوا",1,"ص",3,0],["إِن أُحرِجوا لَم يَجهَلوا وَإِذا قَضَوا","لَم يَقسِطوا وَإِذا عَلَوا لَم يَبجَحوا",2,"ح",3,0],["إِن أَحسَنَ الفِعلَ لَم يُضمِر تَعَمُّدَهُ","وَإِن أَساءَ تَمادى غَيرَ مُعتَذِرِ",3,"ر",1,0],["أَنا حينَ أُطرِقُ لَيسَ يَفتَأُ طارِقي","شَوقٌ كَما طَرَقَ السَليمَ عِدادُ",4,"د",1,0],["أنا حرّمت كل ما كان فيه","شَبَه للأصنام أو تمثيل",5,"ل",1,0],["إن أحسّت بقوةٍ من خصيم","كانت الظبي لم يزايل كناسه",6,"س",2,0],["إِنّا حَمِدنا الَّذي يَشفي خَليقَتَهُ","مِن كُلِّ مُبتَدِعٍ في الدينِ صَدّادِ",7,"د",1,0],["إن أحوج الفقر حالي أن يحاربه","فالعرض منِّي ومن إحسانك النفَقَهْ",8,"ه",1,0],["أنا حرٌّ وأنتَ من سادةِ الأحْ","رارِ أهلِ الحجا المُصاصُ اللُّبابُ",9,"ب",1,0],["أنا حُرٌّ وهبتُ نفْسيَ عبْداً","لك بالحقِّ فاتَّخذني عَبْدا",10,"د",2,0],["إنَّ أحقَّ امرئٍ حَزنْتَ له","من يستعيذُ الإلَهَ من حَزنِك",11,"ك",1,0],["إن احتجبتَ فلم تُنْصِفك غاشيةٌ","واستَنْكَفَتْ قال بدرٌ ربما دجنا",12,"ن",2,0],["إِنَّ أَحَبَّ سُفَّلٌ أَشرارُ","حُثالَةٌ عودُهُمُ خَوّارُ",13,"ر",1,1],["أنا حريتي... فإن سرقوه","تسقط الأرض كلها والسماء",14,"ا",2,0],["أنا حُرٌّ إذا انتسبْتُ ولكنْ","جَعلَتْني لكَ الصَّنائعُ عَبْدا",15,"د",2,0],["إنّا حبيبان وذا حبنا","إنّا وليدان وهذا وليد",16,"د",1,0],["إنَّ أحلى عيشةٍ قضيتُها","ذهبتْ لذاتُها والإثمُ حلْ",17,"ل",1,0],["أنا حالفٌ متورِّعٌ","عنْ هجوِ كلِّ العالمينْ",18,"ن",1,1],["أنا حَسَّانُ مَدْحِكم فإذَا نُحْ","تُ عليكمْ فإنَّنِي الخنساءُ",19,"ا",2,0],["أَنا حَقّاً أَدَّعيهِم","لِسَوادي وَهُزالي",20,"ل",2,0],["إِنّا حَسَبنا حِساباً لَم يَصِحَّ لَنا","قَد بانَ في كُلِّهِ التَفريطُ وَالغَلَتُ",21,"ت",1,1],["أَنِ احتَمى بالواحِدِ القهَّارِ","وفاضَ مِن غَيظٍ على الكُفَّارِ",22,"ر",1,0],["أناحَتْ حَماماتُ اللِّوى أمْ تَغَنَّتِ","فَأَبْدَتْ دَواعِي قَلْبِهِ مَا أَجَنَّتِ",23,"ت",1,1],["إِنِ احتقرت فإنَّ الشعب محتقر","أَو اِحترمت فإن الشعب محترم",24,"م",1,0],["إنا حمدنا لليالي","قد قرَّبتنا من سنيّ سمائك",25,"ك",1,0],["أنا حائرٌ في سِرِّ ذَا","لِكَ الاندحار، وألفُ حائر",26,"ر",1,0],["أنا حتفُهم ألِجُ البيوتَ عليهم ُ","أُغري الوليدَ بشتمهمْ والحاجبا",27,"ب",2,0],["أنا حِلس الطِلا ولست كشيخ","خلسَ الدينَ وهو يُحسَب حِلسا",28,"س",2,0],["ان أحلى مما يسبح هذا الحبرُ","قرْعُ النديم بالكأس جَرْسا",28,"س",2,0],["أنا حَّملتك يا طير الأسى","أنا ، حتى عدت منه ألكنا",29,"ن",2,0],["أنا حرّ به .. وما بعد هذا","عند باغي سرّ الحياة هباء",30,"ا",2,0],["أنا حريَّتي فإن سرقوها","تسقطِ الأرضُ كلُّها والسماءُ",31,"ا",2,0],["إنَّ أحقَّ امرىء ٍ حَزنْتَ له","من يستعيذُ الإلَهَ من حَزنِك",32,"ك",1,0],["انا حمدنا لليالي انها","قد قرَّبتنا من سنيّ سمائكِ..",33,"ك",1,0],["إِنَّ اْحْتِدامَ النَّارِ في جَوْفِ الثَّرَى","أَمْرٌ يُثيرُ حَفِيظَةَ الْبُرْكانِ",34,"ن",1,0],["انا حجتي عجزي واني جاهل","مع عد انفاسي عواقب حالي",35,"ل",2,0],["أنا حافظٌ ودى لأهل مودَّتِى","مترفقٌ لو بدلُوا أو غيرُوا",36,"ر",3,0],["أَنا حاميكَ مِثلَ آبائِيَ الزُه","رِ لِآبائِكَ الَّتي لا تَهونُ",37,"ن",1,0],["إن أُحرِزتْ نفسي إلى أمدٍ","دبَّرتُها في الشَّيبِ بالعقلِ",38,"ل",1,0],["أنا حقّ أنا خلق","أنا ربّ أنا عبد",39,"د",1,1],["أَنا حُرٌّ وَالحُرُّ يَشْهَدُ أَنِّي","لَكَ عَبْدٌ فَاكْتُبْ بِذاكَ سِجِلا",40,"ل",2,0],["ان احسن الأقوام لي في قولهم","احسنت أي والله قولا وعمل",41,"ل",1,0],["أنا حطّمت رغم أنفي يراعي","يا لحزني وقد طويت كتابي",42,"ب",2,0],["أنا حلّقت ثمّ قصّ جناحي","يا ملاكي دهرٌ ظلومٌ عقوق",43,"ق",1,0],["أنا حسبي من رآه","هام فيه وافتتن",44,"ن",1,1],["إن احتكمنا إلى محام","لم يدر ما مهنة المحامى",45,"م",2,0],["أَنا حَكَّمتُ لَحظَ عَينَيكَ فَاِحكُم","في دَمي غَيرَ آثِمٍ مَأزورِ",46,"ر",1,0],["أنا حَكَّمتُها فجارت وشرع الحُبِّ","يَقضي بأن أحكَّم خصمي",47,"م",2,0],["أنا حودابة وذهني صديدٌ","تحت خصي فرعون أو هامان",48,"ن",1,0],["أنا حرب من جد في كسبه","ومن يتقنع تعصبت له",49,"ه",1,0],["أنا حيٌّ ولست أدري أحقّاً","أنا حيٌّ أم لست في الأحياء",50,"ا",2,0],["أنا حلمك الماضي الذي","أنسيته والبعد ينسي",51,"ي",1,0],["انا حيران ملتاع","اداري القلب في حبك",52,"ك",1,0],["إن أَحسّتْ بسَيرِكم عَبراتي","لم تَدعْ للرّفاقِ في الأرضِ عَبرا",53,"ر",2,0],["إنَّ أحبابَنا الَّذينَ استَقامُوا","في طَريقِ الهَوى سَهِرتُ ونامُوا",54,"م",3,1],["إن أحسنت فعلاً وتبكي إن جنت","بمدامعٍ تهمي ولما تُقلِع",55,"ع",1,0],["أنا حاسي الغرام بكم","وكاسي فرَّغَ اَكياسي",56,"س",2,0],["أَنا حَربٌ لآلِ حَربٍ عَلَيهِم","لَعنَةُ اللَهِ ما تَجَهَّزَ غازي",57,"ز",2,0],["إن أحلى هديتي عند مثلي","نكتة في العلوم تأتي سريه",58,"ي",2,0],["إنَّ أحلى العيش ما مرَّ على","روضة غنَّاء والكاسات تترى",59,"ر",2,0],["إنّا حمِدْنا الدهرَ منكَ ولم نكُنْ","لنذُمّ دهراً أنت من حسَناتِه",60,"ت",2,0],["إنْ أحزنَ الحسَّادَ إنك قادمٌ","فالشمسُ كيف تروق عيني أرمدا",61,"د",2,0],["أنا حرّ صفحك غير أنَّ الش","كر مني في سبايك",62,"ك",1,0],["أنا حائك إن لم أكن","عبداً لعبدك وابن حائك",63,"ك",1,0],["أَنا حسرَةُ الأَعداءِ طولَ زمانِهِمْ","أَنا فرحَةُ الإِخْوانِ والخُلاَّنِ",64,"ن",1,0],["أن احمدِ اللهَ أنْ رُزقنا","كلباً عرفناهُ بالصّلاحِ",65,"ح",1,0],["إن أحسنت فلأجل إحسان سرت","آمالها في صورة المتألق",66,"ق",1,0],["أنا حُسَامُه إذا","تَشهَرُنِي يُمنَاه",67,"ا",2,0],["أنَا حرٌّ بين الرّجالِ فما يَمْ","لك رِقّي ذو المنِّ فيهمْ بمَنِّ",68,"ن",1,0],["إن أحبابنا وهم سادةُ الحَيْ","هجروا بعد وصلهم مغرماً عَيْ",