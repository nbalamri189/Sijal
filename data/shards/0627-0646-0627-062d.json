{"poems":[[53,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[53,"لمن الديار طلولها وقص","https://www.aldiwan.net/poem30177.html","الكامل"],[53,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[55,"عيناي شامت دمي والشؤم في النظر","https://www.aldiwan.net/poem26366.html","البسيط"],[73,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[88,"وضح الحق واستاقم السبيل","https://www.aldiwan.net/poem45025.html","الطويل"],[88,"أدهق الدهر بالمنية كاسه","https://www.aldiwan.net/poem45051.html","الخفيف"],[27,"قد قرب الحي إذ هاجوا لإصعاد","https://www.aldiwan.net/poem5728.html","البسيط"],[72,"يا سيدي يا جمال الدين قد عرضت","https://www.aldiwan.net/poem19399.html","البسيط"],[51,"كم نسام الأذى كأنا كلاب","https://www.aldiwan.net/poem8534.html","الخفيف"],[51,"يا أبا أحمد ومثلك لا يغفل","https://www.aldiwan.net/poem61894.html","الخفيف"],[51,"أنى تشاغلت عن أبي حسنك","https://www.aldiwan.net/poem65777.html","الخفيف"],[51,"ناشدتك الله أن تستفسد المننا","https://www.aldiwan.net/poem66517.html","البسيط"],[32,"إن أحب سفل أشرار","https://www.aldiwan.net/poem27729.html","الرجز"],[99,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[61,"رد جفني بسافح الدمع يندى","https://www.aldiwan.net/poem51724.html","الخفيف"],[97,"يا شطر نفسي وغرامي الوحيد","https://www.aldiwan.net/poem24986.html","السريع"],[69,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[69,"أنا حالف متورع","https://www.aldiwan.net/poem28529.html","مجزوء الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"قلت يوما للرقاشي","https://www.aldiwan.net/poem65053.html","مجزوء الرمل"],[46,"إنا حسبنا حسابا لم يصح لنا","https://www.aldiwan.net/poem22146.html","البسيط"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[76,"أناحت حمامات اللوى أم تغنت","https://www.aldiwan.net/poem39474.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85571","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125679","الكامل"],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[90,"جناية الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=178941",""],[94,"يا نديمي","https://www.poetsgate.com/ViewPoem.aspx?id=15656",""],[99,"إفادة في محكمة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=581",""],[51,"أنَّى تشاغلتَ عن أبي حَسَنِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=30025",""],[97,"ابد الخلود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63590&r=&rc=137",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[115,"تعذيب قلبي في هواك حلالي","https://www.aldiwan.net/poem40601.html","عموديه"],[128,"لك منزل في القلب لا يتغير","https://www.aldiwan.net/poem50594.html","الكامل"],[134,"ليت شعري مسافر بن أبي عمرو","https://www.aldiwan.net/poem21042.html","الخفيف"],[142,"شدوا على ظهر الصبا رحلى","https://www.aldiwan.net/poem58410.html","السريع"],[147,"أنا حق أنا خلق","https://www.aldiwan.net/poem47618.html","مجزوء الرمل"],[155,"سيدي أنت لم أقل سيدي أنت","https://www.aldiwan.net/poem55576.html","الخفيف"],[160,"لي منكم يا كهف الملوك والدول","https://www.aldiwan.net/poem58757.html","الرجز"],[197,"ليس عيدا بل مأتم يا صحابي","https://www.aldiwan.net/poem39805.html","الخفيف"],[197,"من لروحي فلا الرحيق رحيق","https://www.aldiwan.net/poem39808.html","الخفيف"],[210,"أنا حسبي من رآه","https://www.aldiwan.net/poem13474.html","مجزوء الرمل"],[211,"هوى جديد أشد فتكا","https://www.aldiwan.net/poem46241.html","مخلع البسيط"],[235,"من عذيري فيه وهل من عذير","https://www.aldiwan.net/poem32017.html","الخفيف"],[250,"عاقبتني بالصد من غير جرم","https://www.aldiwan.net/poem15037.html","الخفيف"],[256,"من شروط الصبوح في المهرجان","https://www.aldiwan.net/poem48463.html","الخفيف"],[303,"يقول الزمان ولم نستمع","https://www.aldiwan.net/poem58284.html","المتقارب"],[328,"أنا أحيى كطائر حطم القي","https://www.aldiwan.net/poem54965.html","الخفيف"],[328,"قالوا الربيع فقلت لا","https://www.aldiwan.net/poem55037.html","مجزوء الكامل"],[342,"أنا أهواك يا ليلى","https://www.aldiwan.net/poem55339.html","الهزج"],[364,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[371,"إن أحبابنا الذين استقاموا","https://www.aldiwan.net/poem57154.html","الخفيف"],[377,"هبطت إليك من المحل الأرفع","https://www.aldiwan.net/poem59343.html","الكامل"],[377,"أمكرديج زد فضلا","https://www.aldiwan.net/poem59380.html","مجزوء الوافر"],[393,"يا غزالا عذاره كالطراز","https://www.aldiwan.net/poem53679.html","الخفيف"],[403,"أشموس من المعاني مضيه","https://www.aldiwan.net/poem33350.html","الخفيف"],[416,"قد نحرنا الزق يوم العيد نحرا","https://www.aldiwan.net/poem53935.html","الطويل"],[432,"لولا ظبى تنسل من لحظاته","https://www.aldiwan.net/poem12779.html","الكامل"],[464,"ما للخيال جفا وقد بعد المدى","https://www.aldiwan.net/poem3191.html","عموديه"],[464,"لندى يديك ويمن رأيك","https://www.aldiwan.net/poem3314.html","عموديه"],[495,"أنا في اعتقادي للتسن","https://www.aldiwan.net/poem10252.html","مجزوء الكامل"],[500,"للقلب في سبك الحروف معان","https://www.aldiwan.net/poem37757.html","الكامل"],[505,"إلهٌ من نباح","https://www.aldiwan.net/poem42459.html","مخلع البسيط"],[515,"هل تعلمان طريقة لم تطرق","https://www.aldiwan.net/poem12186.html","الكامل"],[538,"فضلك لا أنساه","https://www.aldiwan.net/poem47510.html","عموديه"],[551,"في العناء الطويل كيف وقعتم","https://www.aldiwan.net/poem47151.html","الخفيف"],[558,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[558,"لم أزل في الحب يا أملي","https://www.aldiwan.net/poem34255.html","المديد"],[558,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"]],"verses":[["أَنا حَربُ ضِدِّكَ فَاِرضِني حَرباً لَهُ","وَاِرضَ السِنانَ مُصَمِّماً لِطِعانِ",0,"ن",1,0],["إِن أَحسَنوا عَمّوا بِنائِلِهِم","وَإِذَ رَموا بِجَريرَةٍ خَصّوا",1,"ص",3,0],["إِن أُحرِجوا لَم يَجهَلوا وَإِذا قَضَوا","لَم يَقسِطوا وَإِذا عَلَوا لَم يَبجَحوا",2,"ح",3,0],["إِن أَحسَنَ الفِعلَ لَم يُضمِر تَعَمُّدَهُ","وَإِن أَساءَ تَمادى غَيرَ مُعتَذِرِ",3,"ر",1,0],["أَنا حينَ أُطرِقُ لَيسَ يَفتَأُ طارِقي","شَوقٌ كَما طَرَقَ السَليمَ عِدادُ",4,"د",1,0],["أنا حرّمت كل ما كان فيه","شَبَه للأصنام أو تمثيل",5,"ل",1,0],["إن أحسّت بقوةٍ من خصيم","كانت الظبي لم يزايل كناسه",6,"س",2,0],["إِنّا حَمِدنا الَّذي يَشفي خَليقَتَهُ","مِن كُلِّ مُبتَدِعٍ في الدينِ صَدّادِ",7,"د",1,0],["إن أحوج الفقر حالي أن يحاربه","فالعرض منِّي ومن إحسانك النفَقَهْ",8,"ه",1,0],["أنا حرٌّ وأنتَ من سادةِ الأحْ","رارِ أهلِ الحجا المُصاصُ اللُّبابُ",9,"ب",1,0],["أنا حُرٌّ وهبتُ نفْسيَ عبْداً","لك بالحقِّ فاتَّخذني عَبْدا",10,"د",2,0],["إنَّ أحقَّ امرئٍ حَزنْتَ له","من يستعيذُ الإلَهَ من حَزنِك",11,"ك",1,0],["إن احتجبتَ فلم تُنْصِفك غاشيةٌ","واستَنْكَفَتْ قال بدرٌ ربما دجنا",12,"ن",2,0],["إِنَّ أَحَبَّ سُفَّلٌ أَشرارُ","حُثالَةٌ عودُهُمُ خَوّارُ",13,"ر",1,1],["أنا حريتي... فإن سرقوه","تسقط الأرض كلها والسماء",14,"ا",2,0],["أنا حُرٌّ إذا انتسبْتُ ولكنْ","جَعلَتْني لكَ الصَّنائعُ عَبْدا",15,"د",2,0],["إنّا حبيبان وذا حبنا","إنّا وليدان وهذا وليد",16,"د",1,0],["إنَّ أحلى عيشةٍ قضيتُها","ذهبتْ لذاتُها والإثمُ حلْ",17,"ل",1,0],["أنا حالفٌ متورِّعٌ","عنْ هجوِ كلِّ العالمينْ",18,"ن",1,1],["أنا حَسَّانُ مَدْحِكم فإذَا نُحْ","تُ عليكمْ فإنَّنِي الخنساءُ",19,"ا",2,0],["أَنا حَقّاً أَدَّعيهِم","لِسَوادي وَهُزالي",20,"ي",1,0],["إِنّا حَسَبنا حِساباً لَم يَصِحَّ لَنا","قَد بانَ في كُلِّهِ التَفريطُ وَالغَلَتُ",21,"ت",1,1],["أَنِ احتَمى بالواحِدِ القهَّارِ","وفاضَ مِن غَيظٍ على الكُفَّارِ",22,"ر",1,0],["أناحَتْ حَماماتُ اللِّوى أمْ تَغَنَّتِ","فَأَبْدَتْ دَواعِي قَلْبِهِ مَا أَجَنَّتِ",23,"ت",1,1],["إِنِ احتقرت فإنَّ الشعب محتقر","أَو اِحترمت فإن الشعب محترم",24,"م",1,0],["إنا حمدنا لليالي","قد قرَّبتنا من سنيّ سمائك",25,"ك",1,0],["أنا حائرٌ في سِرِّ ذَا","لِكَ الاندحار، وألفُ حائر",26,"ر",1,0],["أنا حتفُهم ألِجُ البيوتَ عليهم ُ","أُغري الوليدَ بشتمهمْ والحاجبا",27,"ب",2,0],["أنا حِلس الطِلا ولست كشيخ","خلسَ الدينَ وهو يُحسَب حِلسا",28,"س",2,0],["ان أحلى مما يسبح هذا الحبرُ","قرْعُ النديم بالكأس جَرْسا",28,"س",2,0],["أنا حَّملتك يا طير الأسى","أنا ، حتى عدت منه ألكنا",29,"ن",2,0],["أنا حرّ به .. وما بعد هذا","عند باغي سرّ الحياة هباء",30,"ا",2,0],["أنا حريَّتي فإن سرقوها","تسقطِ الأرضُ كلُّها والسماءُ",31,"ا",2,0],["إنَّ أحقَّ امرىء ٍ حَزنْتَ له","من يستعيذُ الإلَهَ من حَزنِك",32,"ك",1,0],["انا حمدنا لليالي انها","قد قرَّبتنا من سنيّ سمائكِ..",33,"ك",1,0],["إِنَّ اْحْتِدامَ النَّارِ في جَوْفِ الثَّرَى","أَمْرٌ يُثيرُ حَفِيظَةَ الْبُرْكانِ",34,"ن",1,0],["انا حجتي عجزي واني جاهل","مع عد انفاسي عواقب حالي",35,"ل",2,0],["أنا حافظٌ ودى لأهل مودَّتِى","مترفقٌ لو بدلُوا أو غيرُوا",36,"ر",3,0],["أَنا حاميكَ مِثلَ آبائِيَ الزُه","رِ لِآبائِكَ الَّتي لا تَهونُ",37,"ن",1,0],["إن أُحرِزتْ نفسي إلى أمدٍ","دبَّرتُها في الشَّيبِ بالعقلِ",38,"ل",1,0],["أنا حقّ أنا خلق","أنا ربّ أنا عبد",39,"د",1,1],["أَنا حُرٌّ وَالحُرُّ يَشْهَدُ أَنِّي","لَكَ عَبْدٌ فَاكْتُبْ بِذاكَ سِجِلا",40,"ل",2,0],["ان احسن الأقوام لي في قولهم","احسنت أي والله قولا وعمل",41,"ل",1,0],["أنا حطّمت رغم أنفي يراعي","يا لحزني وقد طويت كتابي",42,"ي",1,0],["أنا حلّقت ثمّ قصّ جناحي","يا ملاكي دهرٌ ظلومٌ عقوق",43,"ق",1,0],["أنا حسبي من رآه","هام فيه وافتتن",44,"ن",1,1],["إن احتكمنا إلى محام","لم يدر ما مهنة المحامى",45,"م",2,0],["أَنا حَكَّمتُ لَحظَ عَينَيكَ فَاِحكُم","في دَمي غَيرَ آثِمٍ مَأزورِ",46,"ر",1,0],["أنا حَكَّمتُها فجارت وشرع الحُبِّ","يَقضي بأن أحكَّم خصمي",47,"ي",1,0],["أنا حودابة وذهني صديدٌ","تحت خصي فرعون أو هامان",48,"ن",1,0],["أنا حرب من جد في كسبه","ومن يتقنع تعصبت له",49,"ه",1,0],["أنا حيٌّ ولست أدري أحقّاً","أنا حيٌّ أم لست في الأحياء",50,"ا",2,0],["أنا حلمك الماضي الذي","أنسيته والبعد ينسي",51,"ي",1,0],["انا حيران ملتاع","اداري القلب في حبك",52,"ك",1,0],["إن أَحسّتْ بسَيرِكم عَبراتي","لم تَدعْ للرّفاقِ في الأرضِ عَبرا",53,"ر",2,0],["إنَّ أحبابَنا الَّذينَ استَقامُوا","في طَريقِ الهَوى سَهِرتُ ونامُوا",54,"م",3,1],["إن أحسنت فعلاً وتبكي إن جنت","بمدامعٍ تهمي ولما تُقلِع",55,"ع",1,0],["أنا حاسي الغرام بكم","وكاسي فرَّغَ اَكياسي",56,"ي",1,0],["أَنا حَربٌ لآلِ حَربٍ عَلَيهِم","لَعنَةُ اللَهِ ما تَجَهَّزَ غازي",57,"ز",2,0],["إن أحلى هديتي عند مثلي","نكتة في العلوم تأتي سريه",58,"ي",2,0],["إنَّ أحلى العيش ما مرَّ على","روضة غنَّاء والكاسات تترى",59,"ر",2,0],["إنّا حمِدْنا الدهرَ منكَ ولم نكُنْ","لنذُمّ دهراً أنت من حسَناتِه",60,"ت",2,0],["إنْ أحزنَ الحسَّادَ إنك قادمٌ","فالشمسُ كيف تروق عيني أرمدا",61,"د",2,0],["أنا حرّ صفحك غير أنَّ الش","كر مني في سبايك",62,"ك",1,0],["أنا حائك إن لم أكن","عبداً لعبدك وابن حائك",63,"ك",1,0],["أَنا حسرَةُ الأَعداءِ طولَ زمانِهِمْ","أَنا فرحَةُ الإِخْوانِ والخُلاَّنِ",64,"ن",1,0],["أن احمدِ اللهَ أنْ رُزقنا","كلباً عرفناهُ بالصّلاحِ",65,"ح",1,0],["إن أحسنت فلأجل إحسان سرت","آمالها في صورة المتألق",66,"ق",1,0],["أنا حُسَامُه إذا","تَشهَرُنِي يُمنَاه",67,"ا",2,0],["أنَا حرٌّ بين الرّجالِ فما يَمْ","لك رِقّي ذو المنِّ فيهمْ بمَنِّ",68,"ن",1,0],["إن أحبابنا وهم سادةُ الحَيْ","هجروا بعد وصلهم مغرماً عَيْ",69,"ي",1,1],["إن أحشائي بكم تلفت","بل وجسمي في الغرام بَلي",70,"ل",2,0],["أنا حارت بي الألبا","ب لا يدرون ما أصلي",71,"ي",1,0]]}