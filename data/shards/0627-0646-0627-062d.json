{"poems":[[53,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[53,"لمن الديار طلولها وقص","https://www.aldiwan.net/poem30177.html","الكامل"],[53,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[55,"عيناي شامت دمي والشؤم في النظر","https://www.aldiwan.net/poem26366.html","البسيط"],[73,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[88,"وضح الحق واستاقم السبيل","https://www.aldiwan.net/poem45025.html","الطويل"],[88,"أدهق الدهر بالمنية كاسه","https://www.aldiwan.net/poem45051.html","الخفيف"],[27,"قد قرب الحي إذ هاجوا لإصعاد","https://www.aldiwan.net/poem5728.html","البسيط"],[72,"يا سيدي يا جمال الدين قد عرضت","https://www.aldiwan.net/poem19399.html","البسيط"],[51,"كم نسام الأذى كأنا كلاب","https://www.aldiwan.net/poem8534.html","الخفيف"],[51,"يا أبا أحمد ومثلك لا يغفل","https://www.aldiwan.net/poem61894.html","الخفيف"],[51,"أنى تشاغلت عن أبي حسنك","https://www.aldiwan.net/poem65777.html","الخفيف"],[51,"ناشدتك الله أن تستفسد المننا","https://www.aldiwan.net/poem66517.html","البسيط"],[32,"إن أحب سفل أشرار","https://www.aldiwan.net/poem27729.html","الرجز"],[99,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[61,"رد جفني بسافح الدمع يندى","https://www.aldiwan.net/poem51724.html","الخفيف"],[97,"يا شطر نفسي وغرامي الوحيد","https://www.aldiwan.net/poem24986.html","السريع"],[69,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[69,"أنا حالف متورع","https://www.aldiwan.net/poem28529.html","مجزوء الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"قلت يوما للرقاشي","https://www.aldiwan.net/poem65053.html","مجزوء الرمل"],[46,"إنا حسبنا حسابا لم يصح لنا","https://www.aldiwan.net/poem22146.html","البسيط"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[76,"أناحت حمامات اللوى أم تغنت","https://www.aldiwan.net/poem39474.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85571","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125679","الكامل"],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[90,"جناية الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=178941",""],[99,"إفادة في محكمة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=581",""],[51,"أنَّى تشاغلتَ عن أبي حَسَنِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=30025",""],[97,"ابد الخلود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63590&r=&rc=137",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""]],"verses":[["أَنا حَربُ ضِدِّكَ فَاِرضِني حَرباً لَهُ","وَاِرضَ السِنانَ مُصَمِّماً لِطِعانِ",0,"ن",1,0],["إِن أَحسَنوا عَمّوا بِنائِلِهِم","وَإِذَ رَموا بِجَريرَةٍ خَصّوا",1,"ص",3,0],["إِن أُحرِجوا لَم يَجهَلوا وَإِذا قَضَوا","لَم يَقسِطوا وَإِذا عَلَوا لَم يَبجَحوا",2,"ح",3,0],["إِن أَحسَنَ الفِعلَ لَم يُضمِر تَعَمُّدَهُ","وَإِن أَساءَ تَمادى غَيرَ مُعتَذِرِ",3,"ر",1,0],["أَنا حينَ أُطرِقُ لَيسَ يَفتَأُ طارِقي","شَوقٌ كَما طَرَقَ السَليمَ عِدادُ",4,"د",1,0],["أنا حرّمت كل ما كان فيه","شَبَه للأصنام أو تمثيل",5,"ل",1,0],["إن أحسّت بقوةٍ من خصيم","كانت الظبي لم يزايل كناسه",6,"س",2,0],["إِنّا حَمِدنا الَّذي يَشفي خَليقَتَهُ","مِن كُلِّ مُبتَدِعٍ في الدينِ صَدّادِ",7,"د",1,0],["إن أحوج الفقر حالي أن يحاربه","فالعرض منِّي ومن إحسانك النفَقَهْ",8,"ه",1,0],["أنا حرٌّ وأنتَ من سادةِ الأحْ","رارِ أهلِ الحجا المُصاصُ اللُّبابُ",9,"ب",1,0],["أنا حُرٌّ وهبتُ نفْسيَ عبْداً","لك بالحقِّ فاتَّخذني عَبْدا",10,"د",2,0],["إنَّ أحقَّ امرئٍ حَزنْتَ له","من يستعيذُ الإلَهَ من حَزنِك",11,"ك",1,0],["إن احتجبتَ فلم تُنْصِفك غاشيةٌ","واستَنْكَفَتْ قال بدرٌ ربما دجنا",12,"ن",2,0],["إِنَّ أَحَبَّ سُفَّلٌ أَشرارُ","حُثالَةٌ عودُهُمُ خَوّارُ",13,"ر",1,1],["أنا حريتي... فإن سرقوه","تسقط الأرض كلها والسماء",14,"ا",2,0],["أنا حُرٌّ إذا انتسبْتُ ولكنْ","جَعلَتْني لكَ الصَّنائعُ عَبْدا",15,"د",2,0],["إنّا حبيبان وذا حبنا","إنّا وليدان وهذا وليد",16,"د",1,0],["إنَّ أحلى عيشةٍ قضيتُها","ذهبتْ لذاتُها والإثمُ حلْ",17,"ل",1,0],["أنا حالفٌ متورِّعٌ","عنْ هجوِ كلِّ العالمينْ",18,"ن",1,1],["أنا حَسَّانُ مَدْحِكم فإذَا نُحْ","تُ عليكمْ فإنَّنِي الخنساءُ",19,"ا",2,0],["أَنا حَقّاً أَدَّعيهِم","لِسَوادي وَهُزالي",20,"ي",1,0],["إِنّا حَسَبنا حِساباً لَم يَصِحَّ لَنا","قَد بانَ في كُلِّهِ التَفريطُ وَالغَلَتُ",21,"ت",1,1],["أَنِ احتَمى بالواحِدِ القهَّارِ","وفاضَ مِن غَيظٍ على الكُفَّارِ",22,"ر",1,0],["أناحَتْ حَماماتُ اللِّوى أمْ تَغَنَّتِ","فَأَبْدَتْ دَواعِي قَلْبِهِ مَا أَجَنَّتِ",23,"ت",1,1],["إِنِ احتقرت فإنَّ الشعب محتقر","أَو اِحترمت فإن الشعب محترم",24,"م",1,0],["إنا حمدنا لليالي","قد قرَّبتنا من سنيّ سمائك",25,"ك",1,0],["أنا حائرٌ في سِرِّ ذَا","لِكَ الاندحار، وألفُ حائر",26,"ر",1,0],["أنا حتفُهم ألِجُ البيوتَ عليهم ُ","أُغري الوليدَ بشتمهمْ والحاجبا",27,"ب",2,0],["أنا حِلس الطِلا ولست كشيخ","خلسَ الدينَ وهو يُحسَب حِلسا",28,"س",2,0],["ان أحلى مما يسبح هذا الحبرُ","قرْعُ النديم بالكأس جَرْسا",28,"س",2,0],["أنا حَّملتك يا طير الأسى","أنا ، حتى عدت منه ألكنا",29,"ن",2,0],["أنا حريَّتي فإن سرقوها","تسقطِ الأرضُ كلُّها والسماءُ",30,"ا",2,0],["إنَّ أحقَّ امرىء ٍ حَزنْتَ له","من يستعيذُ الإلَهَ من حَزنِك",31,"ك",1,0],["انا حمدنا لليالي انها","قد قرَّبتنا من سنيّ سمائكِ..",32,"ك",1,0],["إِنَّ اْحْتِدامَ النَّارِ في جَوْفِ الثَّرَى","أَمْرٌ يُثيرُ حَفِيظَةَ الْبُرْكانِ",33,"ن",1,0]]}