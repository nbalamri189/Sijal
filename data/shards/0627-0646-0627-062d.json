َربيَّةْ","وثَقافَتي ومَبادِئي غَربيَّةْ",230,"ي",2,1],["أنا حاكمٌ في دولةٍ عَربيةْ","أهدافُها الخُذلانُ والتَّبعيّةْ",230,"ي",2,0],["أنا حاكمٌ في دولةٍ عربيَّةْ","يا أمَّةً ماتتْ بِها الثَّوريَّةْ",230,"ي",2,0],["إنْ احتراقي قَرَابِينٌ أُقَدِّمُهَا","لأجلِ حُبِّي فَلَا تَخشَيهِ واقتربي",231,"ب",2,0],["أناحَسَب رغبته يااهل الغرام رهين","من شوفته ،، يالرّبع مالي أنا بدّي",232,"د",2,0],["أنا حظي رداته مع نصيبي في الشقا مكتوب","وقلبي بينهن من حيرته كثرت مطاليبه",233,"ب",2,1],["أنا حضرت الزين يومه يزفاّ","قدام ، عيني ، شفتهم ، يدخلونه",234,"ن",2,0],["إِنَّا حَمَلنَا المَجدَ مِشكَاةَ الهُدَى","فَلتَنظُرِي آثَارَهُ فِيكُم, وَنَقشَهْ",235,"ش",2,0],["أنا حزن وآلام","فمن لمدامعي يشفع",236,"ع",1,0],["أَنا حين حين ما سمعت المَواعظ كلَها","رَديت للعقل السَخيف شوار",237,"ر",1,0],["أنا حَسْبي أنَّكِ هذا الصَّوْت","وهذا الحَرْفُ، وهذا الحِبْرْ",238,"ر",1,0],["أنا حاتمٌ تحفو على الشوك أَرْجُلِي","وفوق جَبِينِي الشمسُ تصحو وتَثْمَلُ",239,"ل",1,0],["ان احساسي الرهيف غني","في قصيد يطير في الافاق",240,"ق",1,0],["أنا حلمي حملت دمي نزيفا","أغني كي يعانقنا النخيلُ",241,"ل",1,0],["أنا حيرةٌ حلَّ اليقينُ بها","فكأن ناري وهجها بردُ",242,"د",1,0],["أنا (حوادم) في سري أخاطبني","وأنت آدم قد تاهت مراميه",243,"ي",2,0],["إنَّا حَمَلنا حنايانا لها صُحُفاً","حَتَّى نصونَ بها آثارَها الدرَرَا",244,"ر",2,0]]}