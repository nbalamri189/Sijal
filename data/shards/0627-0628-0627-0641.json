{"poems":[[65,"عجبت لمن يبغي مداي وقد رأى","https://www.aldiwan.net/poem46096.html","الطويل"],[88,"أقصر الزعفران لأنت قصر","https://www.aldiwan.net/poem68902.html","الوافر"],[53,"ألا خذها إليك عن الحرون","https://www.aldiwan.net/poem66529.html","الوافر"],[83,"أصيخوا فمن طور الهدى انبعث الندا","https://www.aldiwan.net/poem61537.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16620","البسيط"],[92,"الملك حسين","https://www.poetsgate.com/ViewPoem.aspx?id=179040",""],[255,"أنجدتني في الهوى مذ أنجدوا","https://www.aldiwan.net/poem14942.html","الرمل"],[376,"أبثك ما بي وماذا عسى","https://www.aldiwan.net/poem57024.html","المتقارب"],[376,"هو الحب يصنع ما يصنع","https://www.aldiwan.net/poem57326.html","المتقارب"],[422,"إذا المجد شادته القنا والصوارم","https://www.aldiwan.net/poem54162.html","الطويل"],[447,"هو الرزء حتى خص ريش القوادم","https://www.aldiwan.net/poem14478.html","الطويل"],[463,"لعل لها مع النسرين سرا","https://www.aldiwan.net/poem56198.html","الوافر"],[470,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35373","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49092","السريع"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28898","الوافر"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32777","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111436","الرمل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45965","الطويل"],[470,"يا شيخ شعري","https://www.poetsgate.com/ViewPoem.aspx?id=178095",""],[5770,"كم في الموت من عجبِ","https://www.poetsgate.com/ViewPoem.aspx?id=178685",""],[6106,"إلى رحمات الله ، يا أبا فيصل","https://www.poetsgate.com/ViewPoem.aspx?id=7000",""]],"verses":[["أَبَاً فَأَبَاً مِنْ عَبْدِ شَمْسٍ وَهكذا","إِلى آدَمٍ لَمْ يَنْمِنا غَيْرُ مَاجِدِ",0,"د",1,0],["أَبا فاروقَ أَنتَ وَهَبتَ هَذا","لِمِصرَ وَهَكَذا مَنحُ الكَريمِ",1,"م",1,0],["أَبا فاروقَ خُذ بِيَدِ الأَماني","وَحَقِّقها عَلى رَغمِ الخَصيمِ",1,"م",1,0],["أبا فَسْوَى لقد دانيت منا","غريماً لا يُماطل بالديون",2,"ن",1,0],["أَبا فارِسٍ حَسبُ الأَماني أَنَّها","نُجومٌ تَلَقَّت مِن قُدومِكَ أَسعُدا",3,"د",2,0],["أبا فُلانٍ دعاكَ اللهُ مُقْتَدِراً","أخا المكارِمِ وابنَ الصارِمِ الخَلِسِ",4,"س",1,0],["أبا فيصلٍ بعضَ التعزي فكم رَمَت","شهامةُ قومٍ شملَهمْ بالتفرّق",5,"ق",1,0],["أبا فيصلٍ إن الحياةَ ثقيلةٌ","على غير مذمومينَ وغدٍ وأحمق",5,"ق",1,0],["أبا فيصل أشجى التحايا تحيةٌ","تمازجها الذكرى بدمعٍ مُرقرٌق",5,"ق",1,0],["أبا في شرع الهوى عَبدٌ له","وهوَ لي إن كان يرضى سَيِّدُ",6,"د",1,0],["أبا فَرجٍ شَهِدَ الاختِبارُ","بصحَّةِ ما قلتُه والعِيانُ",7,"ن",1,0],["أبا فرجٍ والعُلى حرَّةٌ","وبالجودِ بينَ الوَرى تخدَعُ",8,"ع",1,0],["أبا فالح سُدْتَ الأُمور بحكمةٍ","وأنت خبيرٌ بالسِّياسة عالم",9,"م",1,0],["أبا فارس إن الرجا فيك صادق","بأنك أرسى من هضاب العواصم",10,"م",1,0],["أباً فأباً من الأعلام فيها","نعدّهُمُ إليك هلمَّ جرَّا",11,"ر",2,0],["أبا فُراتٍ ، وَلَنْ يَنفَكَّ مُرتَقِباً","شَوقُ الجموع ِ،وَلنْ تَنفَكَّ مُرتَقَبا",12,"ب",2,0],["أَبا فارِسٍ بانَ الخَليطُ وَوَدَّعوا","فَقُلتُ وَوَلَّوا وَحُسنَ الصَبرِ مِنّي شَيَّعوا",13,"ع",3,1],["أَبا فريدٍ خذْ رثائي وما","هذي القوافي غيرَ لهْبِ الحُروقْ",14,"ق",1,0],["أَباً فَأباً إِذا نَحنُ اِنتَسَبنا","إِلى أَنْ تَبلُغَ الأَنسابُ طينا",15,"ن",2,0],["أَبا فَرَجٍ أُهجى لَدَيكَ وَيُعتَدى","عَلَيَّ فَلا تَحمي لِذاكَ وَتَغضَبُ",16,"ب",1,1],["أَبإِفرِيجِيَةٍ بَعدُ فَتًى","تَطرَحِيني عِندَهُ بالوَصَبِ",17,"ب",1,0],["أَبا فارِسٍ مَن ذا يُجاريكَ في النُهى","وَلَو كانَ في الدُنيا لَهُ الجاهُ وَالطَولُ",18,"ل",1,0],["أبا فراتٍ.. أبا روحي وقافيتي","وما عرفتُ لأوجاعي سواك أبا",19,"ب",2,0],["أبا فرات! رمادٌ كل ما نفخت","شِدقاك فيه، فما أسعرتَ من لهب",20,"ب",1,0],["أبا فرات وداعاً لا لقاء له","روّى ضريحك فيض الغيث والسحب",20,"ب",1,0],["أبا فيصل فاضت أياديك بالندى","مكارم في دنيا العطاء تُعَمَم",21,"م",1,0]]}