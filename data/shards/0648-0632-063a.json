{"poems":[[55,"مقيم من الهم لا يقلع","https://www.aldiwan.net/poem29974.html","المتقارب"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123175","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94973","الكامل"],[4978,"يفْحَصُ العِنَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=177699",""],[6147,"أم الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=151698",""]],"verses":[["وَزُغفٍ تَحَدَّرُ عَن بَيضَةٍ","كَأَنَّ الأَغَمَّ بِها أَنزَعُ",0,"ع",1,0],["وزغرتت في طهوري فرحة وغدت","تنثر الملح من فوقي وترقيني",1,"ن",2,0],["وزغرتة إذ أكرمت جُثمانَهُ","حازت على طول المدى تذكارا",2,"ر",2,0],["وزغردت لجيوش المجد قرطُبَةٌ","وراح يرقص في أفراحه النقبُ",3,"ب",1,0],["وزغردة الحيتان والجسم هابط","ألا إنّها القربان للربّ واثب",4,"ب",1,0]]}