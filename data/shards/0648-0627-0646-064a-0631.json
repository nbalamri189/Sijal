{"poems":[[55,"هو الدهر فينا خليع اللجام","https://www.aldiwan.net/poem29771.html","المتقارب"],[55,"أأبقى كذا أبدا مستقلا","https://www.aldiwan.net/poem29898.html","المتقارب"],[55,"سننت لهذا الرمح غربا مذلقا","https://www.aldiwan.net/poem29931.html","الطويل"],[95,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[95,"ألا أيها الطالع المتبسم","https://www.aldiwan.net/poem11413.html","الطويل"],[93,"لو رأى آدم فتاه لزال الحقد","https://www.aldiwan.net/poem8729.html","عموديه"],[87,"يود من الأرواح ما لا توده","https://www.aldiwan.net/poem7878.html","الطويل"],[45,"أطاعن خيلا من فوارسها الدهر","https://www.aldiwan.net/poem9607.html","الطويل"],[60,"فلا تفش سرك إلا إليك","https://www.aldiwan.net/poem31112.html","المتقارب"],[68,"حبل المنى بحبال اليأس معقود","https://www.aldiwan.net/poem40133.html","البسيط"],[82,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[46,"شهدت لقد أقوت مغانيكم بعدي","https://www.aldiwan.net/poem30537.html","الطويل"],[22,"ألا آل ليلى أزمعوا بقفول","https://www.aldiwan.net/poem21653.html","الطويل"],[54,"ظللت بحزن إن بدا البرق غدوة","https://www.aldiwan.net/poem26926.html","الطويل"],[50,"أحب الغلام إذا كرها","https://www.aldiwan.net/poem63341.html","المتقارب"],[7,"وإن يرجع النعمان نفرح ونبتهج","https://www.aldiwan.net/poem1981.html","الطويل"],[48,"إذا كان رعبي يورث الأمن فهو لي","https://www.aldiwan.net/poem22115.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55271","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54897","الخفيف"],[92,"الوطن والشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179071",""],[93,"الطيران","https://www.poetsgate.com/ViewPoem.aspx?id=53423",""],[133,"فلسطين من غربة موثقة","https://www.aldiwan.net/poem67434.html","المتقارب"],[211,"ألا أبلغا عمرا على نأي داره","https://www.aldiwan.net/poem27970.html","الطويل"],[215,"رأيت من العيد ما سرني","https://www.aldiwan.net/poem46246.html","المتقارب"],[227,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[275,"سأتبع ظل الموت بين الكتائب","https://www.aldiwan.net/poem35630.html","الطويل"],[309,"يا رحمة الله زوري","https://www.aldiwan.net/poem16858.html","المجتث"],[445,"أهنيكما ما يهنئ الدين منكما","https://www.aldiwan.net/poem34766.html","الطويل"],[445,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[447,"كفى البدر حسناً أن يقال نديدها","https://www.aldiwan.net/poem14342.html","الطويل"],[505,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[510,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[534,"سعوا لارعوا في جلب كل مضرة","https://www.aldiwan.net/poem37454.html","الطويل"],[541,"أمن طيف سلمى بالبطاح الدمائث","https://www.aldiwan.net/poem23872.html","الطويل"],[556,"ألا قل للوزير مقال مثن","https://www.aldiwan.net/poem47206.html","الوافر"],[556,"لو كنت أملك للأقدار واقية","https://www.aldiwan.net/poem47362.html","البسيط"],[556,"أيا ملك الأملاك قد جاءني الذي","https://www.aldiwan.net/poem47842.html","الطويل"],[563,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83286","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38380","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37938","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70749","الطويل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126146","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56182","البسيط"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90660","الطويل"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90582","الطويل"],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136784",""],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48949","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101034","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100994","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101037","الطويل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87863","الخفيف"],[1938,"","https://poetry.dctabudhabi.ae/diwan/poem/111210","الطويل"],[1993,"","https://poetry.dctabudhabi.ae/diwan/poem/199044","الطويل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104785","الطويل"],[2053,"","https://poetry.dctabudhabi.ae/diwan/poem/132441","الرجز"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48253","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53204","الوافر"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121946","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107006","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137364",""],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65969","الطويل"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109811","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201266","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205005","السريع"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112622","الرجز"],[3493,"","https://poetry.dctabudhabi.ae/diwan/poem/100575","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48281","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66437","الطويل"],[3654,"","https://poetry.dctabudhabi.ae/diwan/poem/27096","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91220","الوافر"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132118","الطويل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128889","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131020",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135355","الرجز"],[4143,"","https://poetry.dctabudhabi.ae/diwan/poem/202302","الطويل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97066","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94579","الطويل"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127928","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66150","الرمل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66135","الخفيف"],[4755,"أَلَمْ يَخطُر لِجَوَّالِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=183692",""],[4755,"تُعَلِّمُنِي القَصِيدَةُ كُلَّ يَومٍ","https://www.poetsgate.com/ViewPoem.aspx?id=191420",""],[4955,"وبعض الناس لايرضيه قول","https://www.poetsgate.com/ViewPoem.aspx?id=188712",""],[4984,"نُغَالِبُ دُنْيَانَا","https://www.poetsgate.com/ViewPoem.aspx?id=206076",""],[5413,"فما بالُه يزدادُ!","https://www.poetsgate.com/ViewPoem.aspx?id=201571",""],[5518,"حين تسجد الكلمات","https://www.poetsgate.com/ViewPoem.aspx?id=201119",""],[5628,"هواجس مرعبة","https://www.poetsgate.com/ViewPoem.aspx?id=178464",""],[5638,"كاميليا والخائنون","https://www.poetsgate.com/ViewPoem.aspx?id=198249",""],[6070,"زكاة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=188817",""],[6164,"مشاوير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66075&r=&rc=84",""],[5377,"رثاء شعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79547&r=&rc=1",""],[4792,"جَمالٌ ينحتُ القصيدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86320&r=&rc=2",""]],"verses":[["وَأَن يَرشُفَ الهَجرُ ماءَ الوِصالِ","وَأَن يَهتِكَ العَذرُ سُجفَ الذِمامِ",0,"م",1,0],["وَإِنّي رَأَيتُ غَنيَّ الأَنامِ","إِذا لَم يَكُن ذا عَلاءٍ مُقِلّا",1,"ل",2,0],["وَإِن يَرقَ يَوماً في المَعالي فَإِنَّهُ","سَما لِيُوَقّي وَطءَ رِجلِكَ مَزلَقا",2,"ق",2,0],["وَإِنْ يَرْمِني بِالجُبْنِ قَوْمٌ فَإِنَّنِي","رَأَيْتُ اتِّقَاءَ الضَّيْمِ بِالمَوْتِ أَحْزَما",3,"م",2,0],["وَإِنْ يَرَ مِثْلِي رَأْيَهُ عَنْ تَحَيُّزٍ","فَمَنْ عَالِمٌ فِينَا وَمَنْ مُتَعَلِّمُ",4,"م",1,0],["وَأَنيري طَريقَهُ إِن دَجا اللَي","لُ وَدَبَّت عَقارِبُ الظَلماءِ",5,"ا",2,0],["وإن يرتجل وعدا وفي الليل هجعه","تجلى على الصدق الصباح ووعده",6,"د",2,0],["وَإِنّي رَأَيتُ الضُرَّ أَحسَنَ مَنظَراً","وَأَهوَنَ مِن مَرأى صَغيرٍ بِهِ كِبرُ",7,"ر",1,0],["وَإِنّي رَأَيتُ غُواةَ الرِجالِ","لا يَترُكونَ أَديماً صحيحاً",8,"ح",2,0],["وَأَن يُرى رَبعُكَ العافي وَليسَ بِهِ","مَرعىً خَصيبٌ وَظِلٌّ مِنكَ مَمدودُ",9,"د",1,0],["وأَن يُرجعَ الأَعلاجَ بَعدَ عِلاجها","خَزايا على آثارِها الذُّلُّ والقهرُ",10,"ر",1,0],["وَأَنّي رَأَيتُ الوَسمَ في خُلُقِ الفَتى","هُوَ الوَسمُ لا ما كانَ في الشَعرِ وَالجِلدِ",11,"د",1,0],["وَإِن يَرتَقوا في خُطَّةٍ يَرقَ فَوقَها","بِثَبتٍ عَلى ضاحي المَزَلِّ رَجيلِ",12,"ل",1,0],["وَإِنّي رَأَيتُ الدَهرَ في كُلِّ ساعَةٍ","يَسيرُ بِنَفسِ المَرءِ وَالمَرءُ جالِسُ",13,"س",1,0],["وَإِنّي رَأَيتُ سَراويلَهُ","لَها تَكَّةٌ أَشتَهي جَرَّها",14,"ر",3,0],["وَإِن يَرجِعِ النُعمانُ نَفرَح وَنَبتَهِج","وَيَأتِ مَعَدّاً مُلكُها وَرَبيعُها",15,"ع",3,1],["وَإِنّي رَأَيتُ الصَعبَ يَركَبُ دائِماً","مِنَ الناسِ مَن لَم يَركَبِ الغَرَضَ الصَعبا",16,"ب",2,0],["وَأَنْ يَرُد للحقُّ لِلمُسْتَضْ","عَفِ المُهْتَضَمِ",17,"م",1,0],["وَأُنِيرَتْ بِمَا تُوَلَّدْ مِنْ كُلِّ","شِهَابٍ فِي جَوْفِهَا كانَ سِرَّا",18,"ر",2,0],["وأنْ يِردوا مياهَكَ صافياتٍ","مرقرقةً وأنْ أرِدَ الثمادا",19,"د",2,0],["وأنيري طريقه أن دجا اللّيل","ودبّت عقلرب الظّلماء",20,"ا",2,0],["وإِن يَرغَبِ العَسفُ في ذلِّنا","فَويلَ المُذِلِّ وما أحمَقَه",21,"ق",2,0],["وَأَنّي رَدَدتُ الخَيلَ صُعراً خُدودُها","وَدَهدَهتُ قَتلى بَينَ مَثنى وَمَوحَدِ",22,"د",1,0],["وأن يرجع العهد عهد الصفاء","وفي وجهه الحلو ثغر بسوم",23,"م",1,0],["وإن يرد محركاً فمثل ما","يكون قبله أتى وأدغما",24,"م",2,0],["وإن يرد يحرّك بعد ساكن أتى","مغايراً لما ذكرت يا فتى",24,"ت",2,0],["وإن يرد محركاً وقبله","محرك فتسع صور له",24,"ه",1,0],["وإني رأيتُ الخيرَ والشرَّ فطرةً","بلا رغبةٍ أو رهبةٍ من مُعاقب",25,"ب",1,0],["وأن يريح كروباً","قد خيمت في الصدور",26,"ر",1,0],["وإِنْ يَرْعَ لي وَكْفُ الحيا حقَّ مُسعِدٍ","يُخَبِّرْكَ عن دمعي إليك إذا همى",27,"م",2,0],["وإِنْ يَرُعْ نازِحَ الأَوْطانِ عَنكَ فقدْ","راعَ العدى منهُ يومٌ أَنتَ رائعُهُ",28,"ع",2,0],["وإني رأيت العرب تحفر بالعصا","فيمنع لاجيها ويحمي ضهيدها",29,"د",3,0],["وإِنْ يرُمْ كشفَ الغِطا","قالوا تمكَّنَ أَدَبَا",30,"ب",2,0],["وأنّي راعني استسلا","مُ علم القومِ صَغرانا",31,"ن",2,0],["وإنْ يُرِدِ الرَّحْمنُ نَشْرَ فَضِلَةٍ","أَقامَ لَها بَيْنَ الْبَرِيَّةِ حُسَّدا",32,"د",2,0],["وَإِن يَركَبوا طُغيانَهُم وَضَلالَهُم","فَلَيسَ عَذابُ اللَهِ عَنهُم بِلابِثِ",33,"ث",1,0],["وإِنّي راقبٌ زمناً وشيكاً","يَبينُ به الصّباحُ من الظّلامِ",34,"م",1,0],["وأنْ يراك فريداً وسْطَ مُقفرةٍ","مَن لو خطرتَ له لاقى الرَّدى فرَقا",35,"ق",2,0],["وَأَن يَرجعوا إلّا بِشملٍ مجمّعٍ","جنَوْه لهمْ من كفِّ شملٍ مبَدَّدِ",36,"د",1,0],["وان يروا آية لا يؤمنون بها","لهم بذاك اقتباس من أصولهم",37,"م",1,0],["وَأَن يَرى غَيرَهُ مَعَ عَينِهِ شَرَعا","فَلَيسَ بَينَهُما فَرقٌ سِوى الصُوَر",38,"ر",1,0],["وَإِنْ يَرمِهمْ بِالنَّبلِ كانَت سِهامُهُ","تَصبُّ عَلَيهم مِثل وَبلِ الغمائِمِ",39,"م",1,0],["وَإِنْ يُرِدْكَ عَدُوٌّ في مَضرَّتِهِ","فَحَسْبُكَ اللَّهُ إِنَّ اللَّهَ يهلكُهُ",40,"ه",1,0],["وإني رأيتُ الصبرَ أجمل للفتى","ولكنما الدنيا لمنْ صار غالبا",41,"ب",2,0],["وأن يرش ثوبه وبدنه","لعله يغسل عنه درنه",42,"ه",1,0],["وإن يرم صلي نار حدّه فذكى","من وزي حافره عند السرى شررُ",43,"ر",1,0],["وإني رأيت البُخل يُزري بأهلِهِ","فأكرمتُ نفسي أن يُقال بَخيلُ",44,"ل",1,0],["وإني رأيتُ الدهرَ منذُ صَحِبتُهُ","محاسِنُهُ مقرونةٌ ومعايبُه",45,"ب",2,0],["وإن يرم معرفتي في الورى","بنسبة العشاق لا بالجدود",46,"د",1,0],["وإني رأيتُ النشئَ فيهم كأنه","حُباحِبُ في الظلماء تسطُعُ أَنجما",47,"م",2,0],["وإن يرض تورق دوحة الماء نضرة","فلا يعتريها بالذحول ذبول",48,"ل",1,0],["وإن يرضَ قومٌ حِلفنا يسعدوا به","وإلا فعُقبى أمر ذي القوة الخَسر",49,"ر",1,0],["وإن يرق أعواد المنابر أصغرت","بمقوله قسّاً وسحبان وائلا",50,"ل",2,0],["وَأَنيري هُناكَ في جانِبِ القَل","بِ مَكاناً لِلطُهرِ فيهِ بَقِيَّه",51,"ي",2,0],["واني ربيع الضيف والعام مجدب","يعز بربعي الوفد والضيف والجار",52,"ر",1,0],["واني رأيت الدار منه بلاقعا","جهشت بمسرى عيسها وجيادها",53,"د",3,0],["وَإِنِّى رَسُولَ اللهِ قَد جئتُ طالِباً","بِبِضعَتِكَ الزَّهرَا أَرُومُ لِحاجَةِ",54,"ه",1,0],["وإن يرى الثريد فهو ليث","فيه ليمنى راحتيه غيثُ",55,"ث",1,0],["وإن يُرَدِّدْ زئيراً ريعَ حُسَّدُهُ","تهدَّمتْ لهم الأسوارُ والقلَعُ",56,"ع",1,0],["وأنى راعه للدهر خطب","ومثوى الأمن في دار السلام",57,"م",1,0],["وإني رأيت الصبر يحمد غبة","وحسبك أن الله أثنى على الصبر",58,"ر",1,0],["وان يرو من ماء الشبيبة عطفه","فقلبي لسلسال المباسم أظماه",59,"ا",2,0],["وانى رفعت اليوم منه شكايتي","لقاضي الهوى العذري حتى يعزرا",60,"ر",2,0],["وإن يرزق السيدان والطير جئتي","فأحشر منها لا أرى ظلمة الجرف",61,"ف",1,0],["وَإِن يُرِد أَحدُنا الرّجوعا","لِبَيتِه يَسدّ عَنهُ الجوعا",62,"ع",2,0],["واني رهنت القلب بين رماله","مقام حصاة فيه ما بين حصباء",63,"ا",2,0],["وإني رأيت الحق والفن واحداً","ولكن فن الحق ليس بظاهر",64,"ر",1,0],["وإن يرم يوماً رجوعاً الى","صدري فلن أقبل أن أرجعه",65,"ع",2,0],["وأن يَرى نساءَهُ سبايا","في الأسرِ فوقَ هُزّلِ المطايا",66,"ي",2,0],["وإني رأيت الحادثات فلم أجد","أشد ضنىً من أن يبين خليل",67,"ل",1,0],["وإنّ يَراعي كالذوابِلِ شُرَّعاً","ولفْظيَ يمْضي كالحُسامِ المُصَمِّمِ",68,"م",1,0],["وإن يرجف الحسّاد عنّا بريبةٍ","تكون حديثاً بين غادٍ ورايح",69,"ح",1,0],["وَإِنّي رَأَيتُ الدَّهرَ إِن تَكرَ لا يَنَم","وَإِن أَنتَ تَغفُل تَلقَهُ غَيرَ غافِلِ",70,"ل",1,0],["وَإِن يَرنو إِليّ يسلّ سَيفاً","كَليلاً صال بالغرب الحَديد",71,"د",1,0],["وَإِن يَردى بِسَيفٍ مَن لحاظٍ","يَجدْ مِن نَفسهِ بُشرى الشَهيد",71,"د",1,0],["وإني رأيت الجسم للرأس طائعاً","وإن كان فكر الرأس غير موافقِ",72,"ق",1,0],["وإني رأيت العنف بالخلق صدمةً","تميل بركن الدولة المتواثقِ",72,"ق",1,0],["وأنير الافكار في بث علمي","لا بذقن مخضب وبزي",73,"ي",1,0],["وأنّ يراعي كلما صرّ صرة","درى حاسدي كيف البيان المحبب",74,"ب",1,0],["وأن يُرى مُكثراً للعملِ","وأن يُرى مقلِّلاً للزللِ",75,"ل",1,0],["وأن يُرى مقلّلاً كل الفضولْ","وأن يُرى بَراً كذلك وَصولْ",75,"ل",1,0],["وإني رأيت المرء يظعن جاره","لنيته لا بد يوما وإن ثوى",76,"ا",1,0],["وإن يرغم الغلب أبناء غالبٍ","كريمته أضحى الدماء خضابها",77,"ب",3,0],["وإن يرمق الأعداءَ شزراً بطرفهِ","فيرجفهم رعباً كمن قُرَّ بالبردِ",78,"د",1,0],["واني رأَيت البرَّ أقوى شدائداً","وأعظم أهوالاً وتضني متاعبُهُ",79,"ب",2,0],["وانِيرُوا بالهُدى الْبابَ","هذي الناشااتِ",80,"ت",1,0],["وأَنِيرُوا بالعلمِ لَيْلاً دَجُوجِيّاً","تَمَطَّى بِصُلْبهِ كَفارا",81,"ر",2,0],["وأَن يَرقَى لِإِطفائِي","بدَمعِي, أَو بإِشعالِكْ!",82,"ك",1,0],["وأَنِّي رُغمَ جَعْجَعَتِي فَرَاغٌ","وأَنِّي رُغمَ مَعْمَعَتِي سَبيُّ",83,"ب",2,0],["وإن يرَ أيَّ فعلٍ لم يرقهُ","أشارَ لهُ ويفعله جهارا",84,"ر",2,0],["وإِنِّي رأيت القوْمَ من بعد سُؤْدُدٍ","تَداعوا وخَرُّوا في جَنَادِلِها صَرْعَى",85,"ع",2,0],["وأنيَ رغم الحبِّ والصبر لمْ أَنلْ","من الحبِّ إلا قصَّةً تُوقظُ الجوى",86,"و",2,0],["وَ إنِّي رُبَّمَا ما زِدْتُ شَيْئاً","عَلَى مَدْحِ الأَوَائِلِ طَابَ صُنْعَا",87,"ع",2,0],["وانّيَ روحٌ شبيه الضياء ِ","عوالمُه ما وراء السُدُمْ",88,"م",1,0],["وَإِنْ يُرِدِ الْكُفَّارُ حَرْبَ حِجَابِهَا","يَصِرْ لَهُمُ سَيْفًا مُقَطِّعَ أَعْظُمِ",89,"م",1,0],["وأنيرَ في وجهِ الظلامِ منارةً","للعلمِ والاخلاقِ كي أترفعا",90,"ع",2,0],["وأنِّي رأّيتُ النَّخْلَ تُغْرِي ثِمارُهُ","بِقَطْفٍ . فَلَمْ أَقْطِفْ به أبَداً قِنوا!",91,"و",2,0],["وإنْ يرى في يدي التاريخَ أنقلهُ","بكلّ ما فيه للدنيا وأَرويهِ",92,"ي",2,0],["وإنّي رأيتُ العشقَ أطولَ رحلةً","من العمرِ إنَّ الوقتَ وهمٌ",93,"م",1,0]]}