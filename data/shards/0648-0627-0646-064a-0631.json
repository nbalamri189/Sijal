{"poems":[[55,"هو الدهر فينا خليع اللجام","https://www.aldiwan.net/poem29771.html","المتقارب"],[55,"أأبقى كذا أبدا مستقلا","https://www.aldiwan.net/poem29898.html","المتقارب"],[55,"سننت لهذا الرمح غربا مذلقا","https://www.aldiwan.net/poem29931.html","الطويل"],[95,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[95,"ألا أيها الطالع المتبسم","https://www.aldiwan.net/poem11413.html","الطويل"],[93,"لو رأى آدم فتاه لزال الحقد","https://www.aldiwan.net/poem8729.html","عموديه"],[87,"يود من الأرواح ما لا توده","https://www.aldiwan.net/poem7878.html","الطويل"],[45,"أطاعن خيلا من فوارسها الدهر","https://www.aldiwan.net/poem9607.html","الطويل"],[60,"فلا تفش سرك إلا إليك","https://www.aldiwan.net/poem31112.html","المتقارب"],[68,"حبل المنى بحبال اليأس معقود","https://www.aldiwan.net/poem40133.html","البسيط"],[82,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[46,"شهدت لقد أقوت مغانيكم بعدي","https://www.aldiwan.net/poem30537.html","الطويل"],[22,"ألا آل ليلى أزمعوا بقفول","https://www.aldiwan.net/poem21653.html","الطويل"],[54,"ظللت بحزن إن بدا البرق غدوة","https://www.aldiwan.net/poem26926.html","الطويل"],[50,"أحب الغلام إذا كرها","https://www.aldiwan.net/poem63341.html","المتقارب"],[7,"وإن يرجع النعمان نفرح ونبتهج","https://www.aldiwan.net/poem1981.html","الطويل"],[48,"إذا كان رعبي يورث الأمن فهو لي","https://www.aldiwan.net/poem22115.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55271","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54897","الخفيف"],[92,"الوطن والشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179071",""],[93,"الطيران","https://www.poetsgate.com/ViewPoem.aspx?id=53423",""],[132,"فلسطين من غربة موثقة","https://www.aldiwan.net/poem67434.html","المتقارب"],[210,"ألا أبلغا عمرا على نأي داره","https://www.aldiwan.net/poem27970.html","الطويل"],[214,"رأيت من العيد ما سرني","https://www.aldiwan.net/poem46246.html","المتقارب"],[225,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[273,"سأتبع ظل الموت بين الكتائب","https://www.aldiwan.net/poem35630.html","الطويل"],[307,"يا رحمة الله زوري","https://www.aldiwan.net/poem16858.html","المجتث"],[442,"أهنيكما ما يهنئ الدين منكما","https://www.aldiwan.net/poem34766.html","الطويل"],[442,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[444,"كفى البدر حسناً أن يقال نديدها","https://www.aldiwan.net/poem14342.html","الطويل"],[502,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[507,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[531,"سعوا لارعوا في جلب كل مضرة","https://www.aldiwan.net/poem37454.html","الطويل"],[538,"أمن طيف سلمى بالبطاح الدمائث","https://www.aldiwan.net/poem23872.html","الطويل"],[553,"ألا قل للوزير مقال مثن","https://www.aldiwan.net/poem47206.html","الوافر"],[553,"لو كنت أملك للأقدار واقية","https://www.aldiwan.net/poem47362.html","البسيط"],[553,"أيا ملك الأملاك قد جاءني الذي","https://www.aldiwan.net/poem47842.html","الطويل"],[560,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/27096","الطويل"],[1116,"","https://poetry.dctabudhabi.ae/diwan/poem/202302","الطويل"]],"verses":[["وَأَن يَرشُفَ الهَجرُ ماءَ الوِصالِ","وَأَن يَهتِكَ العَذرُ سُجفَ الذِمامِ",0,"م",1,0],["وَإِنّي رَأَيتُ غَنيَّ الأَنامِ","إِذا لَم يَكُن ذا عَلاءٍ مُقِلّا",1,"ل",2,0],["وَإِن يَرقَ يَوماً في المَعالي فَإِنَّهُ","سَما لِيُوَقّي وَطءَ رِجلِكَ مَزلَقا",2,"ق",2,0],["وَإِنْ يَرْمِني بِالجُبْنِ قَوْمٌ فَإِنَّنِي","رَأَيْتُ اتِّقَاءَ الضَّيْمِ بِالمَوْتِ أَحْزَما",3,"م",2,0],["وَإِنْ يَرَ مِثْلِي رَأْيَهُ عَنْ تَحَيُّزٍ","فَمَنْ عَالِمٌ فِينَا وَمَنْ مُتَعَلِّمُ",4,"م",1,0],["وَأَنيري طَريقَهُ إِن دَجا اللَي","لُ وَدَبَّت عَقارِبُ الظَلماءِ",5,"ا",2,0],["وإن يرتجل وعدا وفي الليل هجعه","تجلى على الصدق الصباح ووعده",6,"د",2,0],["وَإِنّي رَأَيتُ الضُرَّ أَحسَنَ مَنظَراً","وَأَهوَنَ مِن مَرأى صَغيرٍ بِهِ كِبرُ",7,"ر",1,0],["وَإِنّي رَأَيتُ غُواةَ الرِجالِ","لا يَترُكونَ أَديماً صحيحاً",8,"ح",2,0],["وَأَن يُرى رَبعُكَ العافي وَليسَ بِهِ","مَرعىً خَصيبٌ وَظِلٌّ مِنكَ مَمدودُ",9,"د",1,0],["وأَن يُرجعَ الأَعلاجَ بَعدَ عِلاجها","خَزايا على آثارِها الذُّلُّ والقهرُ",10,"ر",1,0],["وَأَنّي رَأَيتُ الوَسمَ في خُلُقِ الفَتى","هُوَ الوَسمُ لا ما كانَ في الشَعرِ وَالجِلدِ",11,"د",1,0],["وَإِن يَرتَقوا في خُطَّةٍ يَرقَ فَوقَها","بِثَبتٍ عَلى ضاحي المَزَلِّ رَجيلِ",12,"ل",1,0],["وَإِنّي رَأَيتُ الدَهرَ في كُلِّ ساعَةٍ","يَسيرُ بِنَفسِ المَرءِ وَالمَرءُ جالِسُ",13,"س",1,0],["وَإِنّي رَأَيتُ سَراويلَهُ","لَها تَكَّةٌ أَشتَهي جَرَّها",14,"ر",3,0],["وَإِن يَرجِعِ النُعمانُ نَفرَح وَنَبتَهِج","وَيَأتِ مَعَدّاً مُلكُها وَرَبيعُها",15,"ع",3,1],["وَإِنّي رَأَيتُ الصَعبَ يَركَبُ دائِماً","مِنَ الناسِ مَن لَم يَركَبِ الغَرَضَ الصَعبا",16,"ب",2,0],["وَأَنْ يَرُد للحقُّ لِلمُسْتَضْ","عَفِ المُهْتَضَمِ",17,"م",1,0],["وَأُنِيرَتْ بِمَا تُوَلَّدْ مِنْ كُلِّ","شِهَابٍ فِي جَوْفِهَا كانَ سِرَّا",18,"ر",2,0],["وأنْ يِردوا مياهَكَ صافياتٍ","مرقرقةً وأنْ أرِدَ الثمادا",19,"د",2,0],["وأنيري طريقه أن دجا اللّيل","ودبّت عقلرب الظّلماء",20,"ا",2,0],["وإِن يَرغَبِ العَسفُ في ذلِّنا","فَويلَ المُذِلِّ وما أحمَقَه",21,"ق",2,0],["وَأَنّي رَدَدتُ الخَيلَ صُعراً خُدودُها","وَدَهدَهتُ قَتلى بَينَ مَثنى وَمَوحَدِ",22,"د",1,0],["وأن يرجع العهد عهد الصفاء","وفي وجهه الحلو ثغر بسوم",23,"م",1,0],["وإن يرد محركاً فمثل ما","يكون قبله أتى وأدغما",24,"م",2,0],["وإن يرد يحرّك بعد ساكن أتى","مغايراً لما ذكرت يا فتى",24,"ت",2,0],["وإن يرد محركاً وقبله","محرك فتسع صور له",24,"ه",1,0],["وإني رأيتُ الخيرَ والشرَّ فطرةً","بلا رغبةٍ أو رهبةٍ من مُعاقب",25,"ب",1,0],["وأن يريح كروباً","قد خيمت في الصدور",26,"ر",1,0],["وإِنْ يَرْعَ لي وَكْفُ الحيا حقَّ مُسعِدٍ","يُخَبِّرْكَ عن دمعي إليك إذا همى",27,"م",2,0],["وإِنْ يَرُعْ نازِحَ الأَوْطانِ عَنكَ فقدْ","راعَ العدى منهُ يومٌ أَنتَ رائعُهُ",28,"ع",2,0],["وإني رأيت العرب تحفر بالعصا","فيمنع لاجيها ويحمي ضهيدها",29,"د",3,0],["وإِنْ يرُمْ كشفَ الغِطا","قالوا تمكَّنَ أَدَبَا",30,"ب",2,0],["وأنّي راعني استسلا","مُ علم القومِ صَغرانا",31,"ن",2,0],["وإنْ يُرِدِ الرَّحْمنُ نَشْرَ فَضِلَةٍ","أَقامَ لَها بَيْنَ الْبَرِيَّةِ حُسَّدا",32,"د",2,0],["وَإِن يَركَبوا طُغيانَهُم وَضَلالَهُم","فَلَيسَ عَذابُ اللَهِ عَنهُم بِلابِثِ",33,"ث",1,0],["وإِنّي راقبٌ زمناً وشيكاً","يَبينُ به الصّباحُ من الظّلامِ",34,"م",1,0],["وأنْ يراك فريداً وسْطَ مُقفرةٍ","مَن لو خطرتَ له لاقى الرَّدى فرَقا",35,"ق",2,0],["وَأَن يَرجعوا إلّا بِشملٍ مجمّعٍ","جنَوْه لهمْ من كفِّ شملٍ مبَدَّدِ",36,"د",1,0],["وان يروا آية لا يؤمنون بها","لهم بذاك اقتباس من أصولهم",37,"م",1,0],["وَإِنّي رَأَيتُ الدَّهرَ إِن تَكرَ لا يَنَم","وَإِن أَنتَ تَغفُل تَلقَهُ غَيرَ غافِلِ",38,"ل",1,0],["وإني رأيت المرء يظعن جاره","لنيته لا بد يوما وإن ثوى",39,"ا",1,0]]}