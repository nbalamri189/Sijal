""],[5626,"فُكّي القيود","https://www.poetsgate.com/ViewPoem.aspx?id=189513",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5897,"إلى ذات الحرير الأخضر","https://www.poetsgate.com/ViewPoem.aspx?id=160572",""],[5906,"ملاك","https://www.poetsgate.com/ViewPoem.aspx?id=187982",""],[1920,"الدوحة","https://www.poetsgate.com/ViewPoem.aspx?id=199884",""],[6093,"قاصرة على شفة طريق","https://www.poetsgate.com/ViewPoem.aspx?id=198539",""],[6093,"كلالة","https://www.poetsgate.com/ViewPoem.aspx?id=203986",""],[6117,"سِفْر ُالأحَادِيْثِ وَنَبْعُ الْفَضَائِلْ","https://www.poetsgate.com/ViewPoem.aspx?id=182797",""],[572,"عَرَضنَ فَعَرّضْنَ القلوبَ منَ الأذَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9298&r=&rc=155",""]],"verses":[["عَرَضنَ بِما رَوّى الغَليلَ اِعتِراضُها","وَلا قَطَعَ الدَمعَ اللَجوجَ اِعتِنانُها",0,"ن",3,0],["عَرَضَت رِحلَةٌ فَعَرَّضَ بِالدَم","عِ فَهانَ المَأمولُ وَالمَطلوبُ",1,"ب",1,0],["عِرضٌ نَقِيٌّ مِنَ الوُصومِ إِذا","أَحَكَّ عِرضَ المُذَمَّمِ الجَرَبُ",2,"ب",1,0],["عَرَضَتْ وَالنَّجمُ واهٍ عِقدُهُ","حرَّدٌ مُعتَجِرَاتٌ بِمِنَى",3,"ن",2,1],["عَرَضَتْ لَنا تَخْتالُ بَيْنَ كَواعِبٍ","وَالرَّوْضُ يُذْهِلُ حُورَها عن غِيْدِها",4,"د",3,0],["عَرَضَتْ ناشِئَةُ المُزْنِ لَنا","فَاسْتَهَلَّتْ مِنْ أُصَيْحابِي دُموعُ",5,"ع",1,1],["عَرَضَتْ ونَحْنُ على الحِمى ومَطيُّنا","كالسّمْهَريِّ أُقيمَ بالتّثْقيفِ",6,"ف",1,0],["عَرَضْنَ عليَّ الوَصْلَ والقَلبُ كلُّهُ","لدَيْكِ فأنّى يَبتغينَ وِصالي",7,"ل",2,0],["عَرَضَتْ لوامِعُهُ فطَرَّبَ مُجْدِبٌ","ومَضى فلا عِدَةٌ ولا تَنويلُ",8,"ل",1,0],["عَرَضَتْ كَخُوطِ البانَةِ الأُمْلودِ","تَختالُ بينَ مَجاسِدٍ وعُقودِ",9,"د",1,1],["عَرَضَتْ على غَفَلاتِ ظَنِّيَ عَزْمَةٌ","لمْ يُسْتَشَفَّ وراءَها التَّوفيقُ",10,"ق",1,0],["عَرَضْنَ والعِيسُ مُرخاةٌ أزِمَّتُها","يَرتاحُ مِنهُنَّ مَعقولٌ لمَرْسونِ",11,"ن",1,0],["عَرَضتُ لَهُ بَعدَ الأَناةِ فَرُعتُهُ","بِخَدباءَ قَد تَرفَضُّ عَنها المَجاوِبُ",12,"ب",1,0],["عرضاً أبصرت ولا","ذنب إلا لمن نوى",13,"و",2,0],["عرّضْ بذكري في الخيام وقلْ إذا","جئت العقيق مُبَلِّغ الأوطارِ",14,"ر",1,0],["عَرَضَتْ به المستنفرات كأنَّها","خيلٌ عِرابٌ جُلْنَ في مضمارِ",14,"ر",1,0],["عَرَضَ الهَوى وَتَبَلَّغَت حاجاتُهُ","مِنكَ الضَميرَ فَلَم يَدَعنَ ضَميرا",15,"ر",2,0],["عِرَضنَةُ ليلٍ في العِرَضنَاتِ جُنَّحا","أمامَ رِجَالٍ خَلفَ تِيكَ وأَركُبُ",16,"ب",1,0],["عَرَّضتُ صَبري وَسُلُوّي لَهُ","فَاِستَشهَدا في طاعَةِ الحُبِّ",17,"ب",1,0],["عرَّضْتَ للشعراءِ عرضَك عامِداً","كَيْما يُقالَ تَكذُّبُ الشعراءِ",18,"ا",2,0],["عرضتُ حمدي عليه فاستخفّ به","وإن حمديَ في قومٍ لمخطوبُ",19,"ب",1,0],["عَرضتُ لأَذوادي وبحرُك زاخرٌ","فلما أردن الوِرْدَ ألفَينَ ضَحضَحا",20,"ح",2,0],["عِرضي كعرضِ البَيْنِ يا ابن اسْتِهَا","ذاكَ الأرَثِّ الأنْتَنِ الأوْسَخِ",21,"خ",1,0],["عرضتُ على نفسي الغِنَى منك تارةً","ومِنِّيَ أخرى والغِنى مِنِّيَ الصبر",22,"ر",1,0],["عرضْتَ لشوك قتاداته","وما شَوْكُهُنّ بمستنقش",23,"ش",1,0],["عرض لي بعد مواعيده","دون المنى عارض تعويقِ",24,"ق",1,0],["عرَّضْنَ عرضاً ووقى ملبساً","أغرى به اللاحين حتى انتهك",25,"ك",1,0],["عرضَ اللئيمُ من الحياءِ فعاقنا","إن الحياءَ من الكريم لئيمُ",26,"م",1,0],["عرَّضْتَ حمديك أن يقالَ له","ضلَّ ضلالَ البكاء في الدمن",27,"ن",1,0],["عِرضي له الدهرَ يهجوني وأصْفعهُ","وإن أبى زدتُه أعراض إخواني",28,"ي",1,0],["عَرَضَت مَواكِبَها الشُعوبُ فَلَم أَجِد","إِلّا بِمِصرَ نَضارَةَ الآبادِ",29,"د",1,0],["عَرَضَت مَحاسِنَها الحَياةُ عَلَيكُمُ","فَأَخَذتُمُ بِأَحَبِّها وَالأَليَقِ",30,"ق",1,0],["عَرَضَ الحِسابَ المُسَتشارُ وَلَم يَكُن","لَولا السِياسَةِ حاسِباً وَمُدَقِّقا",31,"ق",2,0],["عُرضَ المَفازَةِ وَالظَلماءُ داجِيَةٌ","كَأَنَّها جُبَّةٌ خَضراءُ مِن ساجِ",32,"ج",1,0],["عرضَ الجَباجِبِ مِن أُثال كَما غَدَت","رُجحُ السَّفينِ دُفِعنَ بِالأَثقالِ",33,"ل",1,0],["عرض الحب لسلمى وتأَلى","ثم لما نال ما نال تولَّى",34,"ل",2,1],["عَرَضَ الأَمرَ عَلَيهِ","وَهوَ يَرجو أَن يَلينا",35,"ن",2,0],["عَرَضَ القُعودُ فَكانَ دونَ نُبوغِهِ","قَيداً وَدونَ خُطى الشَبابِ وِثاقا",36,"ق",2,0],["عَرَضَ الشَكُّ لَها فَاِضطَرَبَت","تَطَأُ الآذانَ هَمساً وَالشِفاها",37,"ا",3,0],["عَرَضوا الحَياةَ عَلَيهِ وَهيَ غَباوَةٌ","فَأَبى وَآثَرَ أَن يَموتَ نَبيلا",38,"ل",2,0],["عَرَضَ الخُسوفُ لَهُ فَما أَزرى بِهِ","ما في الخُسوفِ عَلى الأَهِلَّةِ عارُ",39,"ر",1,0],["عَرَضوا الأَمانَ عَلى الخَواطِر","وَاِستَعرَضوا السُمرَ الخَواطِر",40,"ر",1,1],["عِرضُ الخِلافَةِ ذادَ عَنهُ مُجاهِدٌ","في اللَهِ غازٍ في الرَسولِ هُمامُ",41,"م",1,0],["عَرَضتَ لَهُ دونَ الحَياةِ وَطَرفِهِ","وَأَبصَرَ سَيفَ اللَهِ مِنكَ مُجَرَّدا",42,"د",2,0],["عَرَضتُ عَلَيها ما تَمَنّى مِنَ المُنى","لَتَرضى فَقالَت قُم فَجِئني بِكَوكَبِ",43,"ب",1,1],["عَرُضَت عِذرَتي إِلَيكَ وَطالَت","فَاِغفِرَن ذَنبِيَ الطَويلَ العَريضا",44,"ض",2,0],["عرض المشيب لعارضي فزادني","ذلا وزاد ذوي المحاسن تيها",45,"ه",2,1],["عَرَضَتنْي على الحُسامِ فأضحَى","كلُّ عُضوٍ مني لِحَدَّيْهِ غِمْدا",46,"د",2,0],["عَرَضْتَ على الِبيضِ الرِّقاقِ أُسُودَهم","وسُقْتَ المَها حُوّاً إليها وسُهَّدا",47,"د",2,0],["عَرَضَ المَشيبُ مِنَ الشَبابِ خَليفَةً","وَكِلاهُما لَكَ حِليَةٌ وَنِظامُ",48,"م",1,0],["عَرَضنا أَنفُساً عَزَّت لَدينا","عَليكُم فَاِستَخَفَّ بِها الهَوانُ",49,"ن",1,1],["عُرِضَ العَروضُ فَلَم تَرُعكَ دَوائِرٌ","مِنهُ وَلَم تُشكِل عَلَيكَ رُموزُ",50,"ز",1,0],["عرض الحياة ولا الحطام الفاني","واستلهم الأم الطبيعة وحدها",51,"ه",2,0],["عَرَضَت لَنا يَومَ الحِمى في خُرَّدٍ","كَالسِربِ حُوِّ لِثاً وَلُعسَ شِفاهِ",52,"ه",1,0],["عرضٌ وشكلٌ وذكاءٌ أما","تعذرُهُ في حسدٍ ضلَّلا",53,"ل",2,0],["عَرَّضَت يَوماً لِجارَتِها","وَهيَ لا تَبوحُ لي بِاِسمِ",54,"م",1,0],["عَرَضَت لَنا بِالخَيفِ في بَقَرٍ","تَقرو الكَباثَ وَناضِرَ السَدرِ",55,"ر",1,0],["عَرَضَت عَلَينا خُطَّةً","مَشروقَةً بِرُضابِها",56,"ب",3,0],["عَرَضَت لَهُ وَاللَيثُ دونَكَ جُرأَةً","فَأَجفَلَ إِجفالَ النَعامَةِ يَجزَعُ",57,"ع",1,0],["عَرَضتُ عَلى قَلبي العَزاءَ فَقالَ لي","مِنَ الآنَ فَاِجزَع لا تَمَلَّ مِنَ الصَبرِ",58,"ر",1,0],["عِرْضٌ يَشقُّ على الرُّماةِ وَراءَهُ","وَجهٌ يُبرِّحُ بالهُداةِ وَقاحُ",59,"ح",1,0],["عرضوه في ضوءِ النّهارِ فزانَه","وَضَحُ الضُّحى وتوهُّجُ الآصالِ",60,"ل",1,0],["عِرضُ الحرائِرِ ما عَلمتِ وإنّما","يَرضَى سِواهُنَّ الزِّنَا وَسِواكِ",61,"ك",1,0],["عرضوا الكفالةَ والكرامةَ عندَه","عبثاً وهل عَرَضٌ يُقاس بجوهر",62,"ر",1,0],["عُرِضَتْ لكم خلفَ الزُّجا","جِ تميسُ في حلل البهاءِ",63,"ا",2,0],["عَرَضَ الشَيخُ عِندَ ذاكَ بَناتٍ","كَظِباءٍ بِأَجزَعِ تَرعاها",64,"ا",1,0],["عَرَضتُ فَما أُعطي الحَوادِثَ طاعَةً","وَلَيسَ يُطيعُ الحادِثاتِ فَتىً مِثلي",65,"ل",2,0],["عُرِضَتْ عليهِ جبالُ مكَّةَ عَسْجَداً","فأبى لِفَاقَتِهِ وكانَ مُعِيلا",66,"ل",2,0],["عَرِّضَن لِلَّذي تُحِبُّ بِحُبٍّ","ثُمَّ دَعهُ يَروضُهُ إِبليسُ",67,"س",1,0],["عَرَّضتُ بِالشَكوى لِغَيرِكَ شُبهَةً","وَكَنَيتُ عَنكَ وَما أُريدُ سِواكا",68,"ك",2,0],["عَرَضتُ إِلى وَجهِ الحَبيبِ وَراعَني","غَزالٌ عَلَيهِ زَعفَرانٌ مُضَرَّجُ",69,"ج",1,0],["عَرَضَت لَهُ بِجَمالِها وَدَلالِها","عِندَ المَثابِ فَحيلَ دونَ مَثابِهِ",70,"ب",2,0],["عَرَضْتُ بِأَجْدَالٍ له فَضَرقْتُهُ","مُدَافَعَةً عَنْ ذَنْبِ آخَرَ مُذْنِبِ",71,"ب",1,0],["عَرَضْتُ لَهَا السَّيْفَ عَنْ قُدْرَةٍ","ومَا أَحْدَثَ القَيْنُ فِيهِ صِقَالاَ",72,"ل",2,0],["عَرَضَتْ بفاكهة محرَّمةٍ","وعرضتُ لم أنطِقْ ولم أبُحِ",73,"ح",1,0],["عرض الجمالُ له فأكبَره","ورآكَ فيهِ فجُنَّ من فَرحِ",73,"ح",1,0],["عرضت مآثمها بهم وتقدّمت","أمم تمور على الرمال ذنوبها",74,"ب",3,0],["عرضوا الذكرياتِ فاهتجن فيهم","كامنَ الحزن والهموم الدفينه",75,"ن",2,0],["عَرَضٌ تَقَضَّى لمَّ يَمُسِّ الْجوْهَرَا","فالْحَمْدُ لِلْمَوْلى عَلى مَا قَدَّرَا",76,"ر",2,1],["عَرَضتُ عَلى خيرِ المُلوكِ بِضاعَتي","فَأَلفَيتُ سوقاً صَفقَتي فيهِ تَربَحُ",77,"ح",1,0],["عُرِضَتْ عَلَينا فاشْتَهَينا ذِكْرَهَا","مِنْ بَعْدِ ما عُرِضَتْ على الأَحْزابِ",78,"ب",1,0],["عَرَضتُ عَلى قَلبي الفِراقَ فَقالَ لي","مِنَ الآنَ فَاِيأَس لا أَغُرُّكَ مِن صَبرِ",79,"ر",1,1],["عَرَضَت لَهُ تُفّاحَةً نَفّاحَةً","بَعض الإماء فَرَدَّ بِالإيماءِ",80,"ا",2,0],["عَرَضَت أَعراضها فَأَبى","وَنَفى غَيرَ التُقى نَفَلا",81,"ل",2,0],["عَرَضَتْ عُذْرَتي إلَيكَ، وَطَالَتْ،","فاغتَفِرن ذَنْبيَ الطّوِيلَ العَريضَا",82,"ض",2,0],["عرضْتُ بأجْدالٍ لهُ ، فصرَفْتُهُ","مُدَافَعَة ً عَنْ ذَنْبِ آخَرَ مُذْنِبِ",83,"ب",1,0],["عَرضتُ لأَذوادي وبحرك زاخر","فلما أردن الوِرْد أَلْقين ضَحْضَحا",84,"ح",2,0],["عرض الجاه مبيض الأيادي","رحيب الصدر وضاح الجبين",85,"