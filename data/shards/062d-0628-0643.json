732,"يا عاذلي","https://www.poetsgate.com/ViewPoem.aspx?id=177924",""],[5732,"يا زين جرحك","https://www.poetsgate.com/ViewPoem.aspx?id=177949",""],[5732,"بعدك يزيد القلب","https://www.poetsgate.com/ViewPoem.aspx?id=177947",""],[5732,"في منامي زارني طيف الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=177847",""],[5739,"الشريط ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127064",""],[5743,"كلهم يحدثني عنك","https://www.poetsgate.com/ViewPoem.aspx?id=202315",""],[5756,"تزعلين وتقعدين","https://www.poetsgate.com/ViewPoem.aspx?id=34908",""],[5764,"دكتور !","https://www.poetsgate.com/ViewPoem.aspx?id=137055",""],[5818,"ابتسام المرايا","https://www.poetsgate.com/ViewPoem.aspx?id=197055",""],[5848,"كسرة وسكون وضمة وفتحة","https://www.poetsgate.com/ViewPoem.aspx?id=49224",""],[5853,"صمت الانتظار","https://www.poetsgate.com/ViewPoem.aspx?id=175622",""],[5859,"منذ البداية","https://www.poetsgate.com/ViewPoem.aspx?id=29409",""],[5956,"‏ عصفور وعُشُّ الإلهام ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182118",""],[5957,"بهجة قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=27078",""],[5957,"ليس حبي من هيام وشغب","https://www.poetsgate.com/ViewPoem.aspx?id=128188",""],[6001,"بلغت روحي","https://www.poetsgate.com/ViewPoem.aspx?id=377",""],[6001,"هلا وغلا","https://www.poetsgate.com/ViewPoem.aspx?id=694",""],[6056,"إسمك وعنوانك بجوالي","https://www.poetsgate.com/ViewPoem.aspx?id=130335",""],[6056,"قتيل البناتي","https://www.poetsgate.com/ViewPoem.aspx?id=130340",""],[6113,"منال .........!!!","https://www.poetsgate.com/ViewPoem.aspx?id=26380",""],[520,"يا محبا من النجوم الزباني","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577484",""],[6174,"سفر في قصيدة حبّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86188&r=&rc=5",""],[402,"ما كان ريب قبل ريب الحمام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54039&r=&rc=891",""],[6339,"مناجاة قلب..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87891&r=&rc=3",""],[572,"حِبُّكَ الزائرُ في وقتِ السّحَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9333&r=&rc=190",""]],"verses":[["حُبٌّ كَضَوْءِ الصبْحِ فِيهِ الهُدى","وَفِيهِ رِيٌّ كَالنَّدَى لِلأُوَامْ",0,"م",1,0],["حُبُّكَ الشَّعْبَ ضَاعَفَ الحُبّ فِي الشَّعْ","بِ وَلَوْلا الإجْلالُ كَانَ غَرَامَا",1,"م",2,0],["حُبُكُ الغَمامِ رُصِفنَ بَينَ مُنَمَّرٍ","وَمُسَيَّرٍ وَمُقارِبٍ وَمُشاكِلِ",2,"ل",1,0],["حُبُّكَ لِلمالِ لا كَحُبُّكَ عَب","بادَةَ يا فاضِحَ المُحِبّينا",3,"ن",2,1],["حَبَكَ الهَنا بِسَمائِهِنَّ خَمائِلاً","تَنقَضُّ فيها أَنجُمُ الأَقداحِ",4,"ح",1,0],["حُبُّكَ بَينَ الحَشا مُقيمُ","يا أَيُّها الشادِنُ الرَخيمُ",5,"م",1,1],["حبُّكَ الأوطانَ عجزٌ ظاهرٌ","فاغتربْ تلْقَ عنِ الأهلِ بدلْ",6,"ل",1,0],["حُبُّكَ لي في سَقَمٍ دائِمٍ","لَكِنَّ حُبّي لَكَ في عافِيَه",7,"ي",2,0],["حُبُّكَ يا أَحمَدُ أَضناني","يا قَمَراً في شَخصِ إِنسانِ",8,"ن",1,1],["حُبُّكِ رُبَّانُ الهدى والسلامْ","ما لان للأخطار أو أذعنَا",9,"ن",2,0],["حبك تلميذ شيطان",".. يتسلى بالقلم الأحمر",10,"ر",1,0],["حبك رسام مجنون",".. لا يرسم إلا .. بالأحمر",10,"ر",1,0],["حبك البربري أكبر مني","فلماذا على ذراعيك أصلب",11,"ب",1,0],["حبك اللَه تجلّد","واتئد واهدأ قليلا",12,"ل",2,0],["حبكم أضنى فؤاد الصّب يا","عجباً من بعد أهل الإتصال",13,"ل",1,0],["حبّكم أنجبته أيام حرب","صبحها في سناه ليل بهيم",14,"م",1,0],["حبّكم صيغ من أمان وخوف","فهو نار يهفو عليها النسيم",14,"م",1,0],["حبكم خدعة السلام أشاعوا","قبل يومين أنها تسليم",14,"م",1,0],["حبُّك ذُخري يومَ لا والدٌ","يُغني ولا والدةٌ تُسعِدُ",15,"د",1,0],["حبكم وودادكم حشو قلبي","من قديم وقبل ماء وترب",16,"ب",1,0],["حُبكم مَذهبي وَعقد يَقيني","لَيسَ لي مَذهَب سِواه وَعَقد",17,"د",1,0],["حبُّكَ لا حبُكَ هذا الذي","أوقعَ في أنشوطةِ الحابلِ",18,"ل",1,0],["حبّكم كان فكَّ أسري من الشِّر","ك وفي منكبي له أغلالُ",19,"ل",1,0],["حُبُّكِ خَرْقٌ لا أرى","له الملامَ نَصْحا",20,"ح",2,0],["حبكمُ سفينةٌ ركبتُها","مأمونةٌ فكيف أخشى الغرقا",21,"ق",2,0],["حبُّك الدُنيا وَزينَتها","فتنَةٌ عَمَّتك بِالفِتَنِ",22,"ن",1,0],["حُبُّكُمْ عَلَّمَ الأنينَ فُؤادي","وأثارَ الأشواقَ في مَغْناهُ",23,"ا",2,1],["حُبُكٌ فوقَها تُسمّى خُطوطاً","وهْيَ بحرٌ وتلك أمواجُ جودي",24,"د",2,0],["حبك الزب بغض الزبد عندي","والزبادي وزبية الآساد",25,"د",1,0],["حُبُّكُمُ لِديني","مُكَمِّلٌ وَدِيني",26,"ن",2,0],["حُبُّكم يملأُ القلوبَ وبالخَي","رِ جرى ذِكركم بكل لِسانِ",27,"ن",1,0],["حبك فرض وأرى قوتي","تعجز عن تأدية الفرض",28,"ض",1,0],["حبّكم قد حلّ في قل","بي وأبداهُ لِساني",29,"ن",2,0],["حبكم آل أبي بك","ر به تمحى الذنوب",30,"ب",1,0],["حبكم ديني ومن يب","غضكم طاغ مريب",30,"ب",1,0],["حُبُّكَ مِنْ قلبي مكانَ الذي","أَشبهتَهُ منْ حَبَّةِ القلب",31,"ب",1,0],["حَبكَ المَجد فَوقَ مِنوالِ عزٍّ","فَدَعتهُ العَلياءُ بِالحَبّاكِ",32,"ك",1,0],["حبكم قطع الفؤاد كأني","واضع الثوب في يدي بزّازِ",33,"ز",1,0],["حبكم فاض في الورى كأَيادي","فيصل لم يزل يفيض حياها",34,"ا",3,0],["حبّك كثر فضلك على كل الاوقات","يا كثْر فضلك في الشعوب وقراها",35,"ا",3,0],["حبكم في الفؤاد دابا مقيم","وهواكم لا زال يعلو عليه",36,"ي",2,0],["حبكم في النواد دابا مقيم","وهواكم اذاب مني جلودي",37,"د",2,0],["حبك قد أرقني","وزاد قلبي سقما",38,"م",2,1],["حبكم لبنانَ إيمانُ وذي","آيةٌ قد أنزلت في الكتب",39,"ب",1,0],["حبكم إشراقة كالنور","في القلب يلوح",40,"ح",1,0],["حبّك بشرياني تشرّب","يا جوهره يا تبر يا ماس",41,"س",1,0],["حُبُّكُمْ قد شدّني من عضدَيّ","وافتقاري لَكُمُ أغنى يديّ",42,"ي",1,1],["حبك يا ذات الأنيف الأكشم","حب تساقاه مُشاشُ أعظمي",43,"م",2,1],["حبكم شغل فؤادي في الملا","ونجي القلب مني إن تخلى",44,"ل",2,0],["حُبُّك طبعٌ فيّ لا ينقضي","والجودُ طبعٌ في بنى المجدل",45,"ل",1,0],["حبكم مضغتي تُشير إِلَيهِ","إِن سرّ الفَتى عَلى أَبويه",46,"ه",1,0],["حبك الأوان عجز ظاهر","ان غدا قولا وما بالفعل دل",47,"ل",1,0],["حبُّك ما فارقني","في سفري أو حضري",48,"ر",2,0],["حبك المحض في خزائن ذي العر","ش لأهليه من أعز الكنوزِ",49,"ز",1,0],["حبكِ المشبوبُ ليلى","كلما يخبو يعود",50,"د",1,1],["حبّك مَعي مَا هو مَنْساي","مفلاك وسط القلب مفلاك",51,"ك",1,0],["حبّك في الحشرِ لنا عدةٌ","فَلا نعدّ البيض والزغفا",52,"ف",2,0],["حبكم لم يبق من شخصي سوى","مدمعٍ سالَ وقلب غير سال",53,"ل",1,0],["حبٌّ كأن البَدر نورُ جَبينه","أَو أن من فرعيه لَونَ ظَلام",54,"م",1,0],["حبك لا نعمة أ