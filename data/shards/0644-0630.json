://www.aldiwan.net/poem53809.html","المتقارب"],[40,"خليلي عوجا نحي نباعا","https://www.aldiwan.net/poem42311.html","المتقارب"],[40,"أهاجك ربع عفا مخلق نعم","https://www.aldiwan.net/poem42328.html","المتقارب"],[40,"أقول بأعلى نخلتين وقد مضى","https://www.aldiwan.net/poem42330.html","الطويل"],[52,"سأثني على عهد المطيرة والقصر","https://www.aldiwan.net/poem27054.html","الطويل"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[75,"قفا فلأمر ما سرينا وما نسري","https://www.aldiwan.net/poem69081.html","الطويل"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[75,"بلى هذه تيماء والأبلق الفرد","https://www.aldiwan.net/poem69089.html","الطويل"],[75,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[48,"ونابه في الهوى لنا ناس","https://www.aldiwan.net/poem64318.html","المنسرح"],[48,"إني وإن كنت ماجنا خرقا","https://www.aldiwan.net/poem64503.html","المنسرح"],[48,"يا من يبادلني عشقا بسلوان","https://www.aldiwan.net/poem66139.html","البسيط"],[48,"دع الأمطار تعتور الديارا","https://www.aldiwan.net/poem66573.html","الوافر"],[48,"يقولون شهر الصوم شهر مبارك","https://www.aldiwan.net/poem66626.html","الطويل"],[50,"نأتك على طول التجاور زينب","https://www.aldiwan.net/poem64821.html","الطويل"],[46,"لذاتنا إبل الزمان ينالها","https://www.aldiwan.net/poem22102.html","الطويل"],[46,"من يعرف الدنيا يهن عنده","https://www.aldiwan.net/poem23151.html","السريع"],[76,"والحر لا يكتفي من نيل مكرمة","https://www.aldiwan.net/poem39496.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[66,"","https://poetry.dctabudhabi.ae/diwan/poem/14439","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16684","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42676","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43846","البسيط"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23663","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54242","الخفيف"],[72,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[50,"نأتْك على طُولِ التَّجاوَرِ «زَيْنبُ»","https://www.poetsgate.com/ViewPoem.aspx?id=17921",""],[90,"ذكرى الهاشمي","https://www.poetsgate.com/ViewPoem.aspx?id=179163",""],[90,"الريف الضاحك","https://www.poetsgate.com/ViewPoem.aspx?id=179018",""],[51,"علاكَ قناعُ المشيبِ اليقَقْ","https://www.poetsgate.com/ViewPoem.aspx?id=29918",""],[58,"ألا هل إلى طول الحياة سبيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15571&r=&rc=97",""],[29,"بان الشّبابُ، ورُبّما عَلّلْتُهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17433&r=&rc=6",""],[76,"والحرُّ لا يكتفي منْ نيلِ مكرمة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17876&r=&rc=13",""],[31,"أَهَاجَكَ رَبْعٌ عَفَا مُخْلِقُ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18974&r=&rc=237",""]],"verses":[["لِذاكَ مُني بَعدَ الفِرارِ أُمَيَّةٌ","بِشِقشِقَةٍ لَوثاءَ مِن آلِ دارِمِ",0,"م",1,0],["لِذاكَ شَجَّعتُ قَلبي وَهوَ ذو كَمَدٍ","وَمِلتُ بِالدَمعِ عَنّي وَهوَ ذو دُفَعِ",1,"ع",1,0],["لِذِلَّتِها هانَت عَلَيَّ ذُنوبُها","فَلَم أَدرِ مِن نَبذي لَها مِن جُناتِها",2,"ت",3,0],["لِذَلِكَ يَركَبُ مَن قَد سَعى","طَويلاً وَيَرحَلُ مَن قَد رَكِب",3,"ب",1,0],["لِذِكْرِكَ فِي الآفَاقِ عَرْفٌ مُؤَرَّجٌ","كَمَا انْتُشِقَ الرَّيحَانُ وَالرَّوْحُ يُشْتَمُّ",4,"م",1,0],["لَذو قَلبٍ بِذي القُربى رَحيمٍ","وَذو عَينٍ بِما بَلَغت بَصيرَه",5,"ر",2,0],["لَذاكَ أَهَيبُ عِندي إِذ أُكَلِّمُهُ","وَقيلَ إِنَّكَ مَسبورٌ وَمَسؤولُ",6,"ل",1,0],["لَذُبنا أَسىً يَومَ الوَداعِ لِأَنَّنا","نَرى فيكَ ذاكَ المُصلِحَ المُتَوَدِّدا",7,"د",2,0],["لِذَلِكَ الحَدِّ لَم تَبلُغ مَوَدَّتُنا","أَما كَفى أَن يَراني اليَومَ مُنتَحِبا",8,"ب",2,0],["لذاكَ أوْصَى بأولادٍ له عُمَراً","لمّا دَعاهُ إلى الفِرْدَوسِ داعيها",9,"ي",3,0],["لَذَّةُ الوَصلِ نالَهُ بَعدَ يَأسٍ","كَلِفٌ طالَما تَشَكّى الجَفاءَ",10,"ا",2,0],["لِذِكرى مَعشَرٍ وَلَّوا وَخَلَّوا","عَلَينا مِن خِلافَتِهِم فُقودا",11,"د",2,0],["لذاك كان كريهاً","مستهجن الأفعال",12,"ل",1,0],["لَذُّ بِالقَرِيضِ وَجَدْنَا","بِجَزْلِهِ وَفَصِيحِهْ",13,"ح",2,0],["لِذِكْرَاكَ يَا حِفْنِيُّ فِي النَّفْسِ أَشْجَانُ","وَكَيْفَ سُلُوِّي لِلرِّفَاقِ الأُولَى بَانُوا",14,"ن",3,1],["لُذْتَ بِالعَالَمِ الجَدِيدِ وَإنْ شَ","طَّ وَمَا كَانَ طَائِلاً مَا تَرُومُ",15,"م",1,0],["لَذاكَ مِمَّن بَدا في ظُلمِ أُمِّهِما","حَتّى قَضَت غَضَباً مِن ظُلمِها العاتي",16,"ت",2,0],["لذلك قام ابن الدّنا عن دناءة","يُحابيك فيما فيه للقوم إذلال",17,"ل",1,0],["لذا قال أرجعوا أبداً إليها","بثُلثَيْ دينكم ذي البيّنات",18,"ت",1,0],["لذاك لم يُجد نفعاً ما نصحت لهم","ولو ملأت بنصحي ألف كُرّاس",19,"س",1,0],["لذاك جعلت الحق نصب مقاصدي","وصيّرت سرّ الرأي في أمره جهرا",20,"ر",2,0],["لذاك كنت اعتزلت القوم منفرداً","حتى أقارّبك الأدَنين والآلا",21,"ل",2,0],["لذلك كانت الأرواح منا","بحيث تهي إذا وهتِ الجسوم",22,"م",1,0],["لِذِكرِكِ حينَ فَوَّزَتِ المَطايا","عَلى شَرَكٍ تَخالُ بِهِ سِبابا",23,"ب",2,0],["لَذيذاً وَمَنقوفاً بِصافي مَخيلَةٍ","مِنَ الناصِعِ المَختومِ مِن خَمرِ بابِلا",24,"ل",2,0],["لَذيذُ الكَرى حَتّى أَراكَ مُحَرَّمُ","وَنارُ الأَسى بَينَ الحَشا تَتَضَرَّمُ",25,"م",1,0],["لِذِكرى حَبيبٍ هَيَّجَت ثُمَّ عَبرَةً","سَفوحاً وَأَسبابُ البُكاءِ التَذَكُّرُ",26,"ر",1,0],["لذَّتْ مناسبه في لفظِ ممتدحٍ","حتَّى حسبنا نسيباً ذلك النسبا",27,"ب",2,0],["لذْ بيمناه في الحوائجِ تظفرْ","بيسار يمحى به كلّ عسر",28,"ر",1,0],["لذْ بشيخِ الشيوخ يوم رجاءٍ","والْتجئْ واهْنأ ميامن منّه",29,"ه",1,1],["لذاك من قُضُب الرمّان مُكتَنَفٌ","يُحمى ويُسقَى ومنبوذٌ مع الحطبِ",30,"ب",1,0],["لذاك إذا مررتَ وتلك تَشفي","من الحسَّاد أو صابَ الوِصَابِ",31,"ب",1,0],["لَذةُ الطَّعمِ في يَدَيْ لذّةِ الملْ","ثَمِ تدعو الهوى دعاءَ مُجابِ",32,"ب",1,0],["لذاك بني العباس يصبر مثلُكُم","ويصبر للموت الكميُّ المدجَّجُ",33,"ج",1,0],["لِذلك آخَتْها الرماحُ فأصبحتْ","تَقَوَّمُ في أيْدِيكُمُ وتَأَوَّدُ",34,"د",1,0],["لذلك أضحى فضّلَ الله نشرَهُ","كتفضيله عَرْف النحور على القبر",35,"ر",1,0],["لذلك تَحمي الناسَ أول وهلةٍ","نداك سوى الشيء الموائم والنزر",36,"ر",1,0],["لذلك ليست تزال استه","يخضخضها مِخْوَض أعجر",37,"ر",1,0],["لذوي الجدال إذا غدوا لجدالهم","حججٌ تَضِلَ عن الهدى وتجورُ",38,"ر",1,1],["لَذكاؤه لهبُ الحريقِ وحلمُهُ","أندى وأبرد من ندى الأغلاس",39,"س",1,0],["لذي الحلم قبل اليوم ما تُقرعُ العصا","وقد قالها من قبليَ المتلمس",40,"س",1,0],["لذيذ على الأفواه مُرٌّ مساغهُ","إذا هو رامتْهُ الحلوقُ السوارطُ",41,"ط",1,0],["لذاك يدب خفيّاً له","فيسلبه سلباً كالسَّرق",42,"ق",1,0],["لذلكَ يُثْني عليك الورى","بأطيبَ من ريح أرْدانكا",43,"ك",2,0],["لذكرتُ هذا الموتَ فارتبكتْ","نفسي هناك أشدَّ مُرتَبك",44,"ك",1,0],["لَذاكَ عن الصهباء أبردُ علةً","وأجدرُ أن يغْنى بتلك المناهلِ",45,"ل",1,0],["لذلك أقفاه وسمّاه باسمه","وفي الحقّ يُقْفَى مثلهُ ويكرَّمُ",46,"م",1,0],["لذاك أضحتْ محامدي نَفَلاً","بينهما بالسَّواء مُقْتَسَما",47,"م",2,0],["لذلك لا تزالُ له عطايا","لهُنَّ على مؤمِّله ازدحامُ",48,"م",1,0],["لَذٌّ تُقَبَّلَهُ النَعيمُ كَأَنَّما","مُسِحَت تَرائِبُهُ بِماءٍ مُذهَبِ",49,"ب",1,0],["لَذٌّ أَصابَت حُمَيّاها مُقاتِلَهُ","فَلَم تَكَد تَنجَلي عَن قَلبِهِ الخُمَرُ",50,"ر",1,0],["لَذَّةٌ عِندِيَ أَن أَسمَعَ تَغريدَ البَلابِل","وَحَفيفَ الوَرَقِ الأَخضَرِ أَو هَمسَ الجَداوِل",51,"ل",1,0],["لِذاتُكَ هَمُّهُم نَفعُ البَرايا","وَهَمُّكَ أَن تَكيد وَأَن تُكادا",52,"د",2,0],["لِذي الجَناح وَذي الأَظفارِ بي وَطَرٌ","وَلَيسَ في العَيشِ لي فيما أَرى وَطَرُ",53,"ر",1,0],["لِذاكَ لَم يَشفَقوا عَلى جَسَدي","مِنَ الرمايا وَلَو دَرَوا شَفِقوا",54,"ق",3,0],["لِذاكَ تَرى في وَجنَتَيهِ مُسَطَّراً","إِذا كُوِّرَت وَالشَمسُ وَاللَيلُ إِذ يَغشى",55,"ش",2,0],["لذيولها فوق الربى","والسهل ضافية تجر",56,"ر",1,0],["لذاذة طاهرة نقيه","تبعث في قلوبنا الحميه",57,"ي",2,0],["لِذَلِكَ سَمّى اِبنُ الدُمُستُقِ يَومَهُ","مَماتاً وَسَمّاهُ الدُمُستُقُ مَولِدا",58,"د",2,0],["لَذِكرُكَ أطيبُ من نشرِها","ومدحُكَ أحلى سماعِ الأُذُن",59,"ن",1,0],["لذاك قد حدّوه في","علومنا بالعددِ",60,"د",1,0],["لَذاكِرٌ مِنكَ فَضلَ نُعمى","وَسَترُ نُعمى الكَريمِ كُفرُ",61,"ر",1,0],["لِذِكرى زَمانٍ بانَ مِنّا بِنَضرَةٍ","وَعَيشٍ مَضى بِالرَقَّتَينِ رَقيقِ",62,"ق",1,0],["لَذو وَفاءٍ لِأَهلِ الوُدِّ مُدَّخَرٍ","عِندي وَغَيبٍ عَلى الإِخوانِ مَأمونِ",63,"ن",1,0],["لَذادوا عَن حَريمِهِمِ بِضَربٍ","كَأَفواهِ الأَوارِكِ أَيَّ هَبرِ",64,"ر",1,0],["لِذَحلَيهُما إِذ فَوَّزَت نِقضَياهُما","بِبايِنَةٍ عَن زَورِها كُلَّ مِرفَقِ",65,"ق",1,0],["لِذِكرى حَبيبٍ لَم أَزَل مُذ هَجَرتُهُ","أَعُدُّ لَهُ بَعدَ اللَيالي لَيالِيا",66,"ي",2,0],["لَذَّ فيك المدحُ حتى خِلتُه","سَمَراً لم أشقَ فيه بسَهَر",67,"ر",1,0],["لِذي الفَضلِ مِن ذُبيانَ عِندي مَوَدَّةٌ","وَحِفظٌ وَمَن يُلحِم إِلى الشَرِّ أَنسُجِ",68,"ج",1,0],["لُذ بِالإِلَهِ مِنَ الرَدى وَطُروقِهِ","فَتَحُلَّ مِنهُ في المَحَلِّ الواسِعِ",69,"ع",1,0],["لُذنا بِهِ فَرَأَينا مِن مَناقِبِهِ","ما لا تُشاهِدُهُ الأَبصارُ في رَجُلِ",70,"ل",1,0],["لَذَّ الوَغى لِلمَواضي فَاِنثَنَت طَرَباً","بِهِ وَماسَ القَنا كَالشارِبِ الثَمِلِ",70,"ل",1,0],["لِذاكَ أَجلو ذِكرَهُم","في مَغرِبِ وَمَشرِقِ",71,"ق",1,0],["لِذَلِكَ إِنّي أَنهَبُ العَيشَ قاطِعاً","ثِمارَ المُنى حَتّى أَموتَ وَأُبعَثا",72,"ث",2,0],["لِذا غَدَتِ الحَلاوَةُ فيهِ طَبعاً","لِمُعتَدِلٍ يُؤَثِّرُ في كَثيفِ",73,"ف",1,0],["لِذا بَواكِرُ أَيّامي لِبُعدِكُمُ","أَصائِلٌ وَضُحاها بَعدَكُم طَفَلُ",74,"ل",1,0],["لِذاكَ هَجَرتُ الإِلفَ أَعلَمُ أَنَّني","لَكَ السَيفُ لا يُبليهِ إِن بَلِيَ الغِمدُ",75,"د",1,0],["لِذاكَ سَمَت بِرُكنِ الدينِ نَفسٌ","تَعَلَّمَ رَبُّها طَلَبَ الكَمالِ",76,"ل",1,0],["لِذاكَ إِن هَيمَنَت في الدَوحِ أُنشِدُهُ","بَيني وَبينَكَ يا دَوحَ الحِمى نَسَبُ",77,"ب",1,0],["لِذَلِكَ لَم تَثنِ الحُطوبُ مَوَدَّتي","وَلَكِنَّني مِثلُ النُضارِ عَلى السِبكِ",78,"ك",1,0],["لِذاكَ أُحجِمُ عَن مَدحي فَيَبعَثُني","صِدقُ الوَلاءِ وَإِنّي فيكَ مُعتَقِدُ",79,"د",1,0],["لِذا جُعِلَ الأَمرُ شورى لَهُم","فَهَل كانَ مِن بَعضِ أَربابِها",80,"ب",3,0],["لُذنا بِظِلِّكَ عِلماً أَنَّ فيكَ لَنا","نَيلَ الأَماني وَمَن يَلقَ المُنى يَفُزِ",81,"ز",1,0],["لِذَلِكَ مُذ عَلا في الناسِ ذِكري","رَمَيتُ بِلادَ قَومي بِالنَسايا",82,"ا",3,0],["لذعتني دمعة تلفح خدي","نبهتني من ضلالٍ ليس يُجدِي",83,"ي",1,0],["لَذَّةُ الطَعمِ تَمُجُّ ال","مِسكَ في الأَقداحِ مَجّا",84,"ج",2,0],["لَذيذَةَ الريقِ مَعَ الصَبيبِ","كَأَنَّما تَهمي عَلى ا