{"poems":[[53,"أسل بدمعك وادي الحي إن بانوا","https://www.aldiwan.net/poem29743.html","البسيط"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[0,"ألا انعم صباحا أيها الربع وانطق","https://www.aldiwan.net/poem79.html","الطويل"],[27,"أقمنا وربتنا الديار ولا أرى","https://www.aldiwan.net/poem5798.html","الطويل"],[4,"قوما تجوبان مع الأنواح","https://www.aldiwan.net/poem21154.html","الرجز"],[51,"ما علمنا من لؤلؤ ما ذكرتا","https://www.aldiwan.net/poem8703.html","الخفيف"],[51,"لو هداك القصد فهم","https://www.aldiwan.net/poem66315.html","مجزوء الرمل"],[29,"عفا ممن عهدت به حفير","https://www.aldiwan.net/poem6048.html","الوافر"],[29,"لعمري لقد ناطت هوازن أمرها","https://www.aldiwan.net/poem6165.html","الطويل"],[16,"هل ما علمت وما استودعت مكتوم","https://www.aldiwan.net/poem27694.html","البسيط"],[70,"سمع الناس وقلنا","https://www.aldiwan.net/poem42679.html","مجزوء الرمل"],[70,"خليلي من أشتاق في البعد منكما","https://www.aldiwan.net/poem42682.html","الطويل"],[56,"سهام لحاظ من قسي الحواجب","https://www.aldiwan.net/poem58453.html","الطويل"],[80,"وناهدة تربت كفها","https://www.aldiwan.net/poem31467.html","المتقارب"],[52,"وندمان دعوت وهب نحوي","https://www.aldiwan.net/poem26793.html","الوافر"],[50,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[46,"ألاح وقد رأى برقا مليحا","https://www.aldiwan.net/poem23637.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42506","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42509","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54241","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54316","الطويل"],[77,"أمحي رسوم الأنس إن شئت أن تبقي","https://www.poetsgate.com/ViewPoem.aspx?id=34185",""],[90,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=179239",""],[181,"حى المنازل من حماء قد درست","https://www.aldiwan.net/poem58851.html","البسيط"],[185,"ألا يا نسيم الريح إن كنت عابرا","https://www.aldiwan.net/poem14661.html","الطويل"],[195,"علاني الشيب واشتعل اشتعالا","https://www.aldiwan.net/poem54419.html","الوافر"],[223,"جثا الليل ملتفا ببرد السرائر","https://www.aldiwan.net/poem41614.html","الطويل"],[229,"شهدت بأن هجر الحب حين","https://www.aldiwan.net/poem50740.html","الوافر"],[229,"خليلي قد ولى الظلام وهملجا","https://www.aldiwan.net/poem51194.html","الطويل"],[235,"لم يبق فيك لمشتاق إذا وقفا","https://www.aldiwan.net/poem31816.html","البسيط"],[241,"يا يراعي لولا يد لك عندي","https://www.aldiwan.net/poem45751.html","الخفيف"],[282,"جيب الربيع على الإحسان مزرور","https://www.aldiwan.net/poem32762.html","البسيط"],[337,"عفت ذروة من أهلها فجفيرها","https://www.aldiwan.net/poem45429.html","الطويل"],[380,"أأرجوا من الإلمام بالطلل البالي","https://www.aldiwan.net/poem48836.html","الطويل"],[551,"ألا إني وهبت اليوم نفسي","https://www.aldiwan.net/poem47748.html","الوافر"],[567,"وروض عن صنيع الغيث راض","https://www.aldiwan.net/poem69580.html","الوافر"]],"verses":[["كَأَنَّ غُرَّ المَعالي في بُيوتِهِمُ","بيضٌ عَقائِلُ يَحميهِنَّ غَيرانُ",0,"ن",1,0],["كَأَنَّ غُضونَهُنَّ مُتونُ غُدرٍ","تُصَفِّقُها الرِياحُ إِذا جَرَينا",1,"ن",2,0],["كَأَنَّ غُلامي إِذ عَلا حالَ مَتنِهِ","عَلى ظَهرِ بازٍ في السَماءِ مُحَلِّقِ",2,"ق",1,0],["كَأَنَّ غَماماً في الخُدورِ الَّتي غَدَت","دَنا ثُمَّ هَزَّتهُ الصَبا فَتَرَفَّعا",3,"ع",2,0],["كانَ غِياثَ المُرمِلِ المُمتاحِ","وَعِصمَةً في الزَمَنِ الكَلاحِ",4,"ح",1,0],["كان غَنَّى في مجلس فلحَيْنا","فانثنى ساكتاً فقلنا أجدتا",5,"ت",2,0],["كان غثّاً أو سميناً","هو مهما كان شَتْمُ",6,"م",1,0],["كَأَنَّ غَمامَةً غَرّاءَ باتَت","تَكَشَّفُ عَن مَحاسِنِها الخُدورُ",7,"ر",1,0],["كَأَنَّ غَراضيفَ اِستِها حَولَ أَيرِهِ","وَحَجمَ تَراقيها سَكاكينُ جازِرِ",8,"ر",1,0],["كَأَنَّ غِسلَةَ خِطمِيٍّ بِمِشفَرِها","في الخَدِّ مِنها وَفي اللَحيَينِ تَلغيمُ",9,"م",1,0],["كانَ غَضباناً فَلَمّا","أَن تَلاقَينا اِصطَلَحنا",10,"ن",2,0],["كَأَنَّ غُرابَ البَينِ يَومَ فِراقِنا","أَعارَ فُؤادي شِدَّةَ الخَفَقانِ",11,"ن",1,0],["كأن غُلاماً حاذِقاً خَطّهُ لها","فجاءَ كَنِصْفِ الصَّادِ مِنْ خَطِّ كاتبِ",12,"ب",1,0],["كَأَنَّ غَدائِرها المُرسَلاتِ","أسَاوِدَ سابِحةٌ في غَديرِ",13,"ر",1,0],["كَأَنَّ غَمامَةً بَيضاءَ بَيني","وَبَينَ الراحِ تُحرِقُها البُروقُ",14,"ق",1,0],["كانَ غَيثَ الضَريكِ في حَجرَةِ البَأ","سِ وَجاراً لِلحارِمِ المُستَجيرِ",15,"ر",1,0],["كَأنّ غَبوقَهُ مِن فَرْطِ رِيّ","أباهُ جِسمُه فغَدا مَسِيحا",16,"ح",2,0],["كَأَنَّ غُصُونَها غِيدٌ تَهَادَى","مِنَ الزَّهْرِ الْمُنَمَّقِ في ثِيَابِ",17,"ب",1,0],["كَأَنَّ غُرَّتَهَا مِنْ تَحْتِ طُرَّتِها","فَجْرٌ بِجَانِحَةِ الظَّلْمَاءِ مُنْتَقِبُ",18,"ب",1,0],["كأَنَّ غبارَ النصر في لَهَواتِهم","سُلافٌ من الفِرْدوسِ مازجتِ الشّهدا",19,"د",2,0],["كأنّ غبارَ النصر في لهواتِهم","جنى النحلِ أو أشهى وأطيب في الطعْمِ",20,"م",1,0],["كأن غدير النهر في الدوح دارع","على تعب منه إلى الظل مستلق",21,"ق",1,0],["كأنَّ غديراً فُويقَ الجبينِ عن","ثقةٍ في \" غدٍ\" يَنْضَح",22,"ح",1,0],["كأنَّ غارِبَهُ مُستَشرِفاً إِرمٌ","يُوفِي اليَوافِعَ مِن أَعلاهُ مُرتقِبَا",23,"ب",2,0],["كأن غصون البانِ في كُثُب النّقا","جُذِبْنَ على رِدْفٍ له وقَوام",24,"م",1,0],["كَأَنَّ غَمامَةً نَضَحَت ذَراها","عَلى أَنيابِها عَذباً زُلالا",25,"ل",2,0],["كَأَنَّ غَطيطَ النائِمينَ نَواسِمٌ","يُحَرِّكُها الصَفصافُ فَوقَ المَقابِر",26,"ر",1,0],["كأنّ غِلاَلَتْي خدَّيهِ تبْرٌ","مُذابٌ حولَ حُمرته لُجَيْن",27,"ن",1,0],["كأنّ غصون الأقْحوان زُمُرُّدٌ","تَعمَّم بالكافور ثم تَتَوَّجا",28,"ج",2,0],["كَأَنَّ غُرَّتَهُ وَالخَطبُ مُعتَكِرٌ","بِشائِرُ الصُبحِ جَلّا نورُها السُدفا",29,"ف",2,0],["كان غُصناً فصارَ عُوداً ولكن","لم يزَل بعدُ يَحمُلِ الأَثمارا",30,"ر",2,0],["كَأَنَّ غُدرانَهُ راحٌ مُشَعشَعَةٌ","فَرَوضُهُ مُنتَشٍ وَالزَهرُ مَخمورُ",31,"ر",1,0],["كَأَنَّ غَضيضاً مِن ظِباءِ تَبالَةٍ","يُساقُ بِهِ يَومَ الفِراقِ بَعيرُها",32,"ر",3,0],["كَأَنّ غَليل الشَوق بَينَ جَوانِحي","لِسان لَهيب دَبَّ في جسم",33,"م",1,0],["كَأنَّ غروبَ قَرْنِ الشَمسِ يَطْلِي","ذوائبَه وأعلاهُ بوَرْسِ",34,"س",1,0],["كَأَنَّ غُصُونَهُ سُقِيَتْ رَحِيْقَاً","فَمَاسَتَ مِيْسَ شُرَّابِ الرَّحِيْقِ",35,"ق",1,0]]}