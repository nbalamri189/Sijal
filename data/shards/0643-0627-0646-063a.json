{"poems":[[55,"أسل بدمعك وادي الحي إن بانوا","https://www.aldiwan.net/poem29743.html","البسيط"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[0,"ألا انعم صباحا أيها الربع وانطق","https://www.aldiwan.net/poem79.html","الطويل"],[29,"أقمنا وربتنا الديار ولا أرى","https://www.aldiwan.net/poem5798.html","الطويل"],[4,"قوما تجوبان مع الأنواح","https://www.aldiwan.net/poem21154.html","الرجز"],[53,"ما علمنا من لؤلؤ ما ذكرتا","https://www.aldiwan.net/poem8703.html","الخفيف"],[53,"لو هداك القصد فهم","https://www.aldiwan.net/poem66315.html","مجزوء الرمل"],[31,"عفا ممن عهدت به حفير","https://www.aldiwan.net/poem6048.html","الوافر"],[31,"لعمري لقد ناطت هوازن أمرها","https://www.aldiwan.net/poem6165.html","الطويل"],[16,"هل ما علمت وما استودعت مكتوم","https://www.aldiwan.net/poem27694.html","البسيط"],[72,"سمع الناس وقلنا","https://www.aldiwan.net/poem42679.html","مجزوء الرمل"],[72,"خليلي من أشتاق في البعد منكما","https://www.aldiwan.net/poem42682.html","الطويل"],[58,"سهام لحاظ من قسي الحواجب","https://www.aldiwan.net/poem58453.html","الطويل"],[82,"وناهدة تربت كفها","https://www.aldiwan.net/poem31467.html","المتقارب"],[54,"وندمان دعوت وهب نحوي","https://www.aldiwan.net/poem26793.html","الوافر"],[52,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[48,"ألاح وقد رأى برقا مليحا","https://www.aldiwan.net/poem23637.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42506","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42509","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54241","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54316","الطويل"],[79,"أمحي رسوم الأنس إن شئت أن تبقي","https://www.poetsgate.com/ViewPoem.aspx?id=34185",""],[92,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=179239",""],[185,"حى المنازل من حماء قد درست","https://www.aldiwan.net/poem58851.html","البسيط"],[189,"ألا يا نسيم الريح إن كنت عابرا","https://www.aldiwan.net/poem14661.html","الطويل"],[199,"علاني الشيب واشتعل اشتعالا","https://www.aldiwan.net/poem54419.html","الوافر"],[228,"جثا الليل ملتفا ببرد السرائر","https://www.aldiwan.net/poem41614.html","الطويل"],[234,"شهدت بأن هجر الحب حين","https://www.aldiwan.net/poem50740.html","الوافر"],[234,"خليلي قد ولى الظلام وهملجا","https://www.aldiwan.net/poem51194.html","الطويل"],[240,"لم يبق فيك لمشتاق إذا وقفا","https://www.aldiwan.net/poem31816.html","البسيط"],[246,"يا يراعي لولا يد لك عندي","https://www.aldiwan.net/poem45751.html","الخفيف"],[287,"جيب الربيع على الإحسان مزرور","https://www.aldiwan.net/poem32762.html","البسيط"],[342,"عفت ذروة من أهلها فجفيرها","https://www.aldiwan.net/poem45429.html","الطويل"],[385,"أأرجوا من الإلمام بالطلل البالي","https://www.aldiwan.net/poem48836.html","الطويل"],[556,"ألا إني وهبت اليوم نفسي","https://www.aldiwan.net/poem47748.html","الوافر"],[572,"وروض عن صنيع الغيث راض","https://www.aldiwan.net/poem69580.html","الوافر"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104021","الطويل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122357","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63897","الوافر"],[925,"","https://poetry.dctabudhabi.ae/diwan/poem/144555","الوافر"],[928,"","https://poetry.dctabudhabi.ae/diwan/poem/145680","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62536","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62514","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62503","الوافر"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17570","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80190","الوافر"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144099","الطويل"],[1362,"","https://poetry.dctabudhabi.ae/diwan/poem/113644","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64628","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113935","الطويل"],[1656,"","https://poetry.dctabudhabi.ae/diwan/poem/131360","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108762","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108542","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128056","السريع"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20389","الطويل"],[2074,"","https://poetry.dctabudhabi.ae/diwan/poem/33090","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106996","الرجز"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100908","البسيط"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93408","الطويل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100495","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204654","الوافر"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147324","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132606","البسيط"],[3361,"","https://poetry.dctabudhabi.ae/diwan/poem/202179","الوافر"],[3402,"","https://poetry.dctabudhabi.ae/diwan/poem/200345","البسيط"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99316","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48277","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102383","المتقارب"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66486","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109914","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91597","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91628","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91612","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216706","الوافر"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128942","الرجز"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86504","الطويل"],[3964,"","https://poetry.dctabudhabi.ae/diwan/poem/73557","البسيط"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17788","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101361","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119612","البسيط"],[4106,"","https://poetry.dctabudhabi.ae/diwan/poem/130737","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81283","الخفيف"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81686","الطويل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146751","الطويل"],[5273,"أسئلة بظهر الغيب","https://www.poetsgate.com/ViewPoem.aspx?id=176796",""],[5376,"وقامت أُخيَّة تلقي السلام......من حماه","https://www.poetsgate.com/ViewPoem.aspx?id=188421",""],[5376,"تناغي الهوى في قلبها العشق والوصلُ","https://www.poetsgate.com/ViewPoem.aspx?id=190151",""],[5442,"أرحها فقد مل الظلام سراها","https://www.poetsgate.com/ViewPoem.aspx?id=114763",""],[351,"إِذَا بَرَزَتْ لَيلَى مِنَ الخِدْرِ أَبْرَزَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=4471",""],[5508,"وقفنا على حكم الهوى نعلن الشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=110819",""],[5510,"حكاية الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=206323",""],[5717,"هذا الكتاب معجز مشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=170606",""],[5992,"أرى هالةَ البدر وَسْطَ السماءِ","https://www.poetsgate.com/ViewPoem.aspx?id=41830",""],[6251,"إلى الشيخ جابر الأحمد الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76467&r=&rc=7",""]],"verses":[["كَأَنَّ غُرَّ المَعالي في بُيوتِهِمُ","بيضٌ عَقائِلُ يَحميهِنَّ غَيرانُ",0,"ن",1,0],["كَأَنَّ غُضونَهُنَّ مُتونُ غُدرٍ","تُصَفِّقُها الرِياحُ إِذا جَرَينا",1,"ن",2,0],["كَأَنَّ غُلامي إِذ عَلا حالَ مَتنِهِ","عَلى ظَهرِ بازٍ في السَماءِ مُحَلِّقِ",2,"ق",1,0],["كَأَنَّ غَماماً في الخُدورِ الَّتي غَدَت","دَنا ثُمَّ هَزَّتهُ الصَبا فَتَرَفَّعا",3,"ع",2,0],["كانَ غِياثَ المُرمِلِ المُمتاحِ","وَعِصمَةً في الزَمَنِ الكَلاحِ",4,"ح",1,0],["كان غَنَّى في مجلس فلحَيْنا","فانثنى ساكتاً فقلنا أجدتا",5,"ت",2,0],["كان غثّاً أو سميناً","هو مهما كان شَتْمُ",6,"م",1,0],["كَأَنَّ غَمامَةً غَرّاءَ باتَت","تَكَشَّفُ عَن مَحاسِنِها الخُدورُ",7,"ر",1,0],["كَأَنَّ غَراضيفَ اِستِها حَولَ أَيرِهِ","وَحَجمَ تَراقيها سَكاكينُ جازِرِ",8,"ر",1,0],["كَأَنَّ غِسلَةَ خِطمِيٍّ بِمِشفَرِها","في الخَدِّ مِنها وَفي اللَحيَينِ تَلغيمُ",9,"م",1,0],["كانَ غَضباناً فَلَمّا","أَن تَلاقَينا اِصطَلَحنا",10,"ن",2,0],["كَأَنَّ غُرابَ البَينِ يَومَ فِراقِنا","أَعارَ فُؤادي شِدَّةَ الخَفَقانِ",11,"ن",1,0],["كأن غُلاماً حاذِقاً خَطّهُ لها","فجاءَ كَنِصْفِ الصَّادِ مِنْ خَطِّ كاتبِ",12,"ب",1,0],["كَأَنَّ غَدائِرها المُرسَلاتِ","أسَاوِدَ سابِحةٌ في غَديرِ",13,"ر",1,0],["كَأَنَّ غَمامَةً بَيضاءَ بَيني","وَبَينَ الراحِ تُحرِقُها البُروقُ",14,"ق",1,0],["كانَ غَيثَ الضَريكِ في حَجرَةِ البَأ","سِ وَجاراً لِلحارِمِ المُستَجيرِ",15,"ر",1,0],["كَأنّ غَبوقَهُ مِن فَرْطِ رِيّ","أباهُ جِسمُه فغَدا مَسِيحا",16,"ح",2,0],["كَأَنَّ غُصُونَها غِيدٌ تَهَادَى","مِنَ الزَّهْرِ الْمُنَمَّقِ في ثِيَابِ",17,"ب",1,0],["كَأَنَّ غُرَّتَهَا مِنْ تَحْتِ طُرَّتِها","فَجْرٌ بِجَانِحَةِ الظَّلْمَاءِ مُنْتَقِبُ",18,"ب",1,0],["كأَنَّ غبارَ النصر في لَهَواتِهم","سُلافٌ من الفِرْدوسِ مازجتِ الشّهدا",19,"د",2,0],["كأنّ غبارَ النصر في لهواتِهم","جنى النحلِ أو أشهى وأطيب في الطعْمِ",20,"م",1,0],["كأن غدير النهر في الدوح دارع","على تعب منه إلى الظل مستلق",21,"ق",1,0],["كأنَّ غديراً فُويقَ الجبينِ عن","ثقةٍ في \" غدٍ\" يَنْضَح",22,"ح",1,0],["كأنَّ غارِبَهُ مُستَشرِفاً إِرمٌ","يُوفِي اليَوافِعَ مِن أَعلاهُ مُرتقِبَا",23,"ب",2,0],["كأن غصون البانِ في كُثُب النّقا","جُذِبْنَ على رِدْفٍ له وقَوام",24,"م",1,0],["كَأَنَّ غَمامَةً نَضَحَت ذَراها","عَلى أَنيابِها عَذباً زُلالا",25,"ل",2,0],["كَأَنَّ غَطيطَ النائِمينَ نَواسِمٌ","يُحَرِّكُها الصَفصافُ فَوقَ المَقابِر",26,"ر",1,0],["كأنّ غِلاَلَتْي خدَّيهِ تبْرٌ","مُذابٌ حولَ حُمرته لُجَيْن",27,"ن",1,0],["كأنّ غصون الأقْحوان زُمُرُّدٌ","تَعمَّم بالكافور ثم تَتَوَّجا",28,"ج",2,0],["كَأَنَّ غُرَّتَهُ وَالخَطبُ مُعتَكِرٌ","بِشائِرُ الصُبحِ جَلّا نورُها السُدفا",29,"ف",2,0],["كان غُصناً فصارَ عُوداً ولكن","لم يزَل بعدُ يَحمُلِ الأَثمارا",30,"ر",2,0],["كَأَنَّ غُدرانَهُ راحٌ مُشَعشَعَةٌ","فَرَوضُهُ مُنتَشٍ وَالزَهرُ مَخمورُ",31,"ر",1,0],["كَأَنَّ غَضيضاً مِن ظِباءِ تَبالَةٍ","يُساقُ بِهِ يَومَ الفِراقِ بَعيرُها",32,"ر",3,0],["كَأَنّ غَليل الشَوق بَينَ جَوانِحي","لِسان لَهيب دَبَّ في جسم",33,"م",1,0],["كَأنَّ غروبَ قَرْنِ الشَمسِ يَطْلِي","ذوائبَه وأعلاهُ بوَرْسِ",34,"س",1,0],["كَأَنَّ غُصُونَهُ سُقِيَتْ رَحِيْقَاً","فَمَاسَتَ مِيْسَ شُرَّابِ الرَّحِيْقِ",35,"ق",1,0],["كأنّ غصونَ الآس والريح بينها","متونُ نَشاوى كُلّما اضطربت سُكرا",36,"ر",2,0],["كان غزالا فشوهوه","حتى غدا طعمة الذئاب",37,"ب",1,1],["كأنّ غشاءَها الملقى قناعٌ","على عيطاءَ بكرٍ عَيطَموس",38,"س",1,0],["كأن غصونها شربٌ نشاوي","يصفق كلها راحاً براح",39,"ح",1,0],["كأن غراريه وإن كان فلها","فتورا حمام لا يلبث بالنفس",40,"س",1,0],["كأن غلالة حمراء حيكت","بأوسطها طرائف من دِمَقْسِ",41,"س",1,0],["كأنَّ غمامة حمراء مرَّت","فأخصبت الجَديب المضمحلا",42,"ل",2,0],["كأنَّ غراره من عَدْ","لِ مالكه اكتسى طبعا",43,"ع",2,0],["كَأَنَّ غَمامَ العِزِّ حَشوُ أَكُفِّهِم","إِذا طَبقَ الآفاق بِالدِيماتِ",44,"ت",1,0],["كَأَنَّ غُصونَها لَيلٌ بَهيمٌ","تَغَشاني فَحَيَرني إِرتِباكا",45,"ك",2,0],["كأنّ غديرَ الماءِ جوشَنُ فِضّةٍ","من السّردِ محبوكٌ عليها مُضاعفُ",46,"ف",1,1],["كأن غصون البان تندى غضارةً","معاطف غيدٍ حشوهنَّ خمورُ",47,"ر",1,0],["كأن غمار الدهر من حول حزمه","شكوك تجلى بينهن يقين",48,"ن",1,0],["كأنَّ غَريضاً من مُجاجِ غَمامَةٍ","بِدارِيِّ مسكٍ ظلمهُ مُتَأَرِّجِ",49,"ج",1,0],["كأن غناء العندليب بأيكها","مزامير قينات يرجين مطمعا",50,"ع",2,0],["كأن غزال المسك أصبح منصفاً","فذرَّ على خاليه مسكاً منصَّفا",51,"ف",2,0],["كأن غوانيها بلابل جنةٍ","تئنُّ على عيدانها الوترية",52,"ه",1,0],["كأن غصن البان قد الذي","أهواه في ملبسه السندسي",53,"ي",1,0],["كان غُصناً غضاً فتياً رطيباً","لم يفكر في الرمسِ والأكفانِ",54,"ن",1,0],["كَأَنَّ غُضوناً مِن لَهاهُ وَحَلقِهِ","مُغارٍ هَيامُ عُدمُلِيٌّ مَنهورُ",55,"ر",1,0],["كَأَنَّ غُصونَ الخَيزُرانِ مُتونُها","إِذا هِيَ جالَت في طِرادَ الثَعالِبِ",56,"ب",1,0],["كأن غريد الهوى مطرب","غنى فأغنى عن غزال وغزل",57,"ل",1,0],["كأنَّ غاليةً تذكُو بكلِّ فمٍ","يمجُّ عن ذكرهم مِسكاً اذا ذُكِروا",58,"ر",3,0],["كَأَنَّ غَديرَ الماءِ بَينَ حَبابِهِ","وَبَينَ شُخُوصٍ قُمنَ مثلَ الأَنامل",59,"ل",1,0],["كان غوثاً للعالمين فأمسى","مستغيثاً يا للورى مستجيرا",60,"ر",2,0],["كأن غناك يعطي الرو