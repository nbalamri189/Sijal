t/poem38413.html","الطويل"],[534,"هنيئاً زادك الرحمن خيراً","https://www.aldiwan.net/poem23843.html","الوافر"],[536,"عبد ببابك خده قد عفرا","https://www.aldiwan.net/poem48191.html","عموديه"],[538,"دعوني وقد شالت لإبليس راية","https://www.aldiwan.net/poem56892.html","الطويل"],[549,"كأن معقري مهج كرام","https://www.aldiwan.net/poem47728.html","الوافر"],[551,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[551,"أديرا علي الراح لا تشربا قبلي","https://www.aldiwan.net/poem68430.html","الطويل"],[571,"يا من لصبح الشيب كيف تنفسا","https://www.aldiwan.net/poem3649.html","الكامل"],[584,"أهلا بوجهك لا حجبت عن نظري","https://www.aldiwan.net/poem17534.html","البسيط"],[584,"شكوت إلى ذاك الجمال صبابة","https://www.aldiwan.net/poem17600.html","الطويل"],[584,"ملامك لا ربط لديه ولا حل","https://www.aldiwan.net/poem17642.html","الطويل"]],"verses":[["فَلَأَنتَ نَهّاضٌ إِذا قَعَدوا","أَبَداً وَصَعّادٌ إِذا نَزَلوا",0,"ل",3,0],["فَلَأَنتَ أَولى بِالإِمامَةِ وَالهُدى","وَأَذَبُّ عَن وَلَدِ النَبيِّ المُرسَلِ",1,"ل",1,0],["فَلا نَجاءٌ مِنَ الأَقدارِ طالِبَةً","فَاِطلُب عُلالَةَ آمالٍ وَأَطماعِ",2,"ع",1,0],["فَلَأَنتَ قائِمُ سَيفِها الذَرِبُ الشَبا","مَجداً وَوابِلُ نَوئِها الرَجّاسِ",3,"س",1,0],["فَلَأَنتِ آمَنُ أَن يَلومَكِ عاذِلٌ","في فَرطِ حُبٍّ أَو يَغُرَّكَ عاذِرُ",4,"ر",1,0],["فَلا نَعِمَ الباغونَ يَوماً بِعَيشَةٍ","وَلا حَضَروا إِلّا بِأَلأَمِ مَشهَدِ",5,"د",1,0],["فَلَأَنهَضَنَّ إِلى المَعالي نَهضَةً","مِلءَ الزَمانِ تَفي بِطولِ قُعودي",6,"د",2,0],["فَلا نَقَلَ المُهَيمِنُ عَنكَ ظِلّاً","مِنَ النَعماءِ لَيسَ بِمُستَباحِ",7,"ح",1,0],["فَلَأَنتِ أَفتَنُ لِلقُلوبِ مِنَ الَّتي","عَرَضَت لِداوُدَ النَبِيِّ المُهتَدِ",8,"د",1,0],["فَلاَ نَظمَتْ دُرَّ الْقِريضِ قَرِيحَتي","وَلاَ كَانَتِ الآدَابُ أَكْبَرَ دَابِي",9,"ي",1,0],["فَلِأَنَّهُم لَم يَذكُروا","أَنَّ المُتَرجِمَ في إِسارِ",10,"ر",1,0],["فُلانَةٌ حَسْنَاءُ لَكِنَّهَا","عَلَى صِبَاهَا بَضَّةٌ خَامِلَهْ",11,"ل",2,0],["فُلانَةٌ حَسْنَاءُ لي زَعْمِهِمْ","أَدِيبَةٌ آنِسَةٌ عَاقِلَهْ",11,"ل",2,0],["فلأنت يا بدر العلا","شرّفْتَني بلباسِ",12,"س",1,0],["فلا نبالي اليوم من لامنا","في رفضنا آدم أو من عذر",13,"ر",1,0],["فَلا نَتَجاوَزُ العَطِلاتِ مِنها","إِلى البَكرِ المُقارِبِ وَالكَزومِ",14,"م",1,0],["فَلا نَزَلَت بِيَ الجيرانُ إِن لَم","أُجاوِرها مُجاوَرَةَ البِحارِ",15,"ر",1,0],["فَلانَ الصَوتُ فَاِنبَسَطَت يَداهُ","وَكانَ كَأَنَّهُ في الغُلِّ عانِ",16,"ن",1,0],["فَلَإِن فَخَرتُ بِهِم لَمِثلُ قَديمِهِم","فَخَرَ اللَبيبُ بِهِ عَلى الأَقوامِ",17,"م",1,0],["فلان الدين قد أعليتَ قدرِي","وصحَّ إلى مودتك انْتِسابي",18,"ي",1,1],["فلأنت الرشيدُ أمراً وأنَّى","يخطيء الرشدَ من أبوه الرشيدُ",19,"د",1,0],["فلأَنت الذي إذا أمَّه الآ","ملُ عُدَّتْ آمالُه أموالَهْ",20,"ل",2,0],["فلانتْ قناتيَ للغامزي","نَ وارْفَتَّ عُوديَ للعاجمِ",21,"م",1,0],["فُلانٌ وَهوَ مَعروفٌ لَدَيكُم","فَلا يَحتاجُ يَوماً أَن يُسَمّى",22,"م",2,1],["فُلانَةٌ مِن تيهِها","تَغَصُّ بِها مُقلَتي",23,"ي",1,1],["فَلَأَنتَ أَرهَفُ حينَ تُدهِمُ خُطَّةً","مِن مُرهَفٍ شَهَرَتهُ كَفُّكَ مِقضَبِ",24,"ب",1,0],["فَلا نَجَحَت تِلكَ اللُبانَةُ إِنَّها","تَرومُ مَراماً لِلعُلا غَيرَ ناجِحِ",25,"ح",1,0],["فَلَأَنتَ في نَفسي وَإِن عَنَّيتَني","وَبَعَثتَ لي الأَشجانَ أَحلى وافِدِ",26,"د",1,0],["فَلَأَنتَ أَصدَقُ مِن شَآ","بيبِ الغَمامِ نَدىً وَأَجوَد",27,"د",1,0],["فَلَأَنتِ أَفتَنُ لِلقُلوبِ مِنَ الَّتي","عَرَضَت لِداوُودِ النَبِيِّ المُهتَدي",28,"ي",1,0],["فَلا نَعدَم بَقاءَكَ في سُرورٍ","وَعِزٍّ ما سَرى الظَلماءَ سارِ",29,"ر",1,0],["فَلَأَنتَ يَومَ تَعُدُّ أَحسَنَ مالَها","يَدُها الصَناعُ وَوَجهُها وَلِسانُها",30,"ن",3,0],["فَلَأَنتَ أَهوَنُ مِن زِيادٍ جانِباً","فَاِذهَب إِلَيكَ مُخَرِّمَ السُفّارِ",31,"ر",1,0],["فَلَأَنتِ مِن خَلَلِ الحِجالِ قَتَلتِني","إِذ نَحنُ بِالحَدَقِ الذَوارِفِ نَرتَمي",32,"ي",1,0],["فَلا نَقتُلُ الأَسرى وَلَكِن نَفُكُّهُم","إِذا أَثقَلَ الأَعناقَ حَملُ المَغارِمِ",33,"م",1,0],["فَلا نحنُ نَغفُلُ عن ذَمِّها","ولا هيَ عن ضَيمِنا تَغفُلُ",34,"ل",1,0],["فلا نازحُ الوُدِّ يُدْني الدُّنُوَّ","ولا غائِبُ الشَّرِّ يَنوي الرُّجوعا",35,"ع",2,0],["فلا نَظَرُ الدَّاعي إلى الزَّادِ كَفَّهم","ولا خَجَلةُ المدعوِّ ردَّتْ لهم يَدا",36,"د",2,0],["فَلَأَنتَ تَفري ما خَلَقتَ وَبَعضُ","القَومِ يَخلُقُ ثُمَّ لا يَفري",37,"ر",2,0],["فَلَأَنتَ في حالَي حَضورِكَ وَالنَوى","ما زِلتَ تَعهَدُ بِالجَوابِ الشافي",38,"ف",2,0],["فَلانَ عَلى هَواكَ وَلا عَجيبٌ","إِذا داوُدُ لانَ لَهُ الحَديدُ",39,"د",1,0],["فَلا نَقطَ إِلّا مِن سِنانِ قَناتِهِ","وَلا شَكلَ إِلّا مِن مَضارِبِ عَضبِهِ",40,"ب",2,0],["فَلا نَمَّقَ الأَعذارَ يوماً لِسائِلٍ","وَلا قالَ لِلوُفّادِ مَوعِدُكُم غَدُ",41,"د",1,0],["فلان لا تعجب إذا","عُزِلتَ واعرفْ ما السببْ",42,"ب",1,1],["فلانُ والينا على رغمِنا","لا باركَ الرحمنُ في عمرِهِ",43,"ه",1,1],["فلانُ فظٌّ غليظٌ","إليكَ عنهُ إليكا",44,"ك",2,1],["فلانٌ يا لَلناسِ معْ جهلهِ","وفسقِهِ في حلبٍ يحكمُ",45,"م",1,1],["فلأنتما والشاعرون سويةٌ","كالشمع يَهدي غيرَه ويذوب",46,"ب",1,0],["فَلا نَفَعَ اللَهُ الطَبيبَ بِطِبِّهِ","وَلا أَرشَدَ اللَهُ الحَكيمَ المُداوِيا",47,"ي",2,0],["فَلا نَعِمَت بَعدي وَلا عِشتُ بَعدَها","وَدامَت لَنا الدُنيا إِلى مُلتَقى الحَشرِ",48,"ر",1,0],["فَلا نَحنُ ما عِشنا عَنِ اللَّومِ نَرعوِي","ولا أَنتَ ما كرَّ الجديدان تَحفِلُ",49,"ل",1,0],["فَلانَ قلبُ رسولِ اللهِ مرحمةً","وَرَقَّ من شِدَّةِ البطشِ الذي وَصَفَا",50,"ف",2,0],["فَلا نَكراءُ بِالمَعروفِ يَوماً","وَغاياتُ المَكارِمِ مُنتَهاها",51,"ا",3,0],["فلأنْتَ والصِّيدُ الذين نَمَيتَهُم","من كلّ رَحبِ الباعِ أبلَجَ سام",52,"م",1,0],["فلا نُقِضَ الرأيُ الذي أنتَ مُبرمٌ","ولا خُذِل الجيشُ الذي أنت باعث",53,"ث",1,0],["فَلا نَوالٌ زَهيدٌ","وَلا عَطاءٌ جَزيلُ",54,"ل",1,0],["فلا نَيْلَ إلا أنْ أخالسَ لحظةً","ولا وصلَ إلا أن ينمَّ شَهيقُ",55,"ق",1,0],["فَلأَنْتَ أَوَّلُ مَنْ أَفَادَ بِعَدْلِهِ","حُرِّيَّةَ الأَخْلاقِ بَعْدَ تَعَبُّدِ",56,"د",1,0],["فَلأَنْتَ أَجْدَرُ بِالثَّنَاءِ لِمِنَّةٍ","أَوْلَيْتَهَا وَالْبِرُّ أَفْضَلُ مَا رُعِي",57,"ع",2,0],["فَلأَنْتُمْ رَهْطُ الْفِلاحِ وَأَهْلٌ","لِلْمَعَالِي وَسَعْيُكُمْ مَأْثُورُ",58,"ر",1,0],["فَلأَنْتَ كِسْرَى مَا تَرَى تَحْرِيمَهُ","كَانَ الحَرَامَ وَمَا تُحِلُّ حَلاَلاَ",59,"ل",2,0],["فَلاَ نُمْسِي بِلاَ أَمْرٍ","وَلاَ نُضْحِي بِلاَ أَمْرِ",60,"ر",1,0],["فَلأَنتَ أَجدَرُ 