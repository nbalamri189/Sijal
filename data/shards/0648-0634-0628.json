Poem.aspx?id=185878",""],[5976,"يا ملكْة الشعْر ..","https://www.poetsgate.com/ViewPoem.aspx?id=31767",""],[6038,"اوسط الحلين","https://www.poetsgate.com/ViewPoem.aspx?id=25691",""],[6052,"أنت المنار","https://www.poetsgate.com/ViewPoem.aspx?id=49595",""],[6093,"ليلة بيضاء","https://www.poetsgate.com/ViewPoem.aspx?id=197677",""],[6099,"قانأ","https://www.poetsgate.com/ViewPoem.aspx?id=35798",""],[6113,"ذكريات....بحرجده","https://www.poetsgate.com/ViewPoem.aspx?id=36932",""],[6115,"ياوجودي على طفل تهمل عيونه","https://www.poetsgate.com/ViewPoem.aspx?id=180490",""],[5309,"هي الأخلاق تنبت كالنبات","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573769",""],[463,"سائلِ الدَّارَ غنْ سألتَ خبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60093&r=&rc=149",""],[6275,"سنوات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83611&r=&rc=3",""],[6290,"المُعَلّقَةُ الثّامِنَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85504&r=&rc=22",""],[5126,"الطائر الغريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87826&r=&rc=41",""],[5190,"أُحقِّركُم وأكرَهُكُم جميعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85050&r=&rc=125",""]],"verses":[["وَشَبَابٍ كَانَ يَنْدَى نَظْرَةً","نَزَلَ الثَّلْجُ عَلَى رَيْحَانِهِ",0,"ه",1,0],["وَشَبَابٍ مِنَ المَنَا","جِيدِ إِنْ تَدْعُهُمْ تُصَنْ",1,"ن",1,0],["وَشَبَابِ ذَاكَ الجِسْمِ فِي رَيْعَانِهِ","وَشَبَابَ تِلْكَ النَّفْسِ فِي الرَّيْعَانِ",2,"ن",1,0],["وَشَبَّهتُ ضَبَر الخَيلِ شُدَّت قُيودُها","تَقَمُّسَ أَعناقِ الرِعانِ السَوامِكِ",3,"ك",1,0],["وشبّه بالنهر الحياةَ معاشرٌ","فمنبعه في رأيهم قدم الدهر",4,"ر",1,0],["وَشَبَّهَ القَومُ أَطلالاً بِأَسنَمَةٍ","ريشَ الحَمامِ فَزِدنَ القَلبَ تَحزينا",5,"ن",2,0],["وَشَبَّهتَ نَفسَكَ أَشقى ثَمودَ","فَقالوا ضَلِلتَ وَلَم تَهتَدِ",6,"د",1,0],["وَشَبَّهتَ نَفسَكَ حوقَ الحِمارِ","خَبيثَ الأَوارِيَّ وَالمِروَدِ",6,"د",1,0],["وَشَبَّهتُ القِلاصَ وَحادِيَيها","قِداحاً صَكَّها يَسَرا قِمارِ",7,"ر",1,0],["وَشَبَّهتُ الحُدوجَ غَداةَ قَوٍّ","سَفينَ الهِندِ رَوَّحَ مِن أَوالا",8,"ل",2,0],["وشبيهاك لا يَخونانك العَهْ","دَ لعمري بل يرعيان العهودا",9,"د",2,0],["وَشَباباً سَكرانَ مِن خَمرَةِ الوَهمِ","يَخالُ المُحالَ أَمراً يَقينا",10,"ن",2,0],["وَشَبا لِساني في المَحا","فِل بِالتَعَثُّر لا يُشابْ",11,"ب",1,0],["وشبه ناس طرفها وقوامها","بابيض بتار واسمر عسال",12,"ل",1,0],["وشب ينمو كخوط البان مزدهراً","حتى تناسق من فرع الى قدم",13,"م",1,0],["وشباب من رآهم عصبةً","قال نَحلٌ أُوذنت بالمعتدين",14,"ن",1,0],["وَشَبابُها يَتَعَلَّمو","نَ عَلى الفَراقِدِ وَالنُجومِ",15,"م",1,0],["وَشِبهُ الشَيءِ مُنجَذِبٌ إِلَيهِ","وَأَشبَهُنا بِدُنيانا الطِغامُ",16,"م",1,0],["وَشَبيبَةٌ فيها النُهى فَإِذا بَدَت","لِذَوي التَوَسُّمِ فَهيَ شَيبُن أَسوَدُ",17,"د",1,0],["وَشَبيهَ النَبِيِّ خَلُقاً وَخُلُقاً","وَنَسيبِ النَبِيِّ جَدّاً فَجَدّا",18,"د",2,0],["وَشَبَّت فَلا الأَترابُ تَرجو لِقاءَها","وَلا بَيتُها مِن سامِرِ الحَيِّ مَوعِدُ",19,"د",1,0],["وَشُبَّ وَقودُ الشَعرَيَينِ وَحارَدَت","جِلادُ لِقاحِ المُمحِلينَ وَخورُها",20,"ر",3,0],["وَشَبَّهتَ رَسمَ الدارِ إِذ أَنتَ واقِفٌ","عَلَيها تَكُفُّ الدَمعَ بُرداً مُسَهَّما",21,"م",2,0],["وشبابٌ جَفَّ إلا شَجَرٌ","مُوجِفٌ منه وكم يبقَى الشَّجَر",22,"ر",1,0],["وشبَّ لي في سوادِ الليل بارقُه","فخِلْتُه في سوادِ القَلبِ مَشبوبا",23,"ب",2,0],["وَشَبَّ لَهُ فيها بَنونَ وَتوبِعَت","سَلامَةُ أَعوامٍ لَهُ وَغَنائِمُ",24,"م",1,0],["وَشَبيهَ الَّذي اِستَقَلَّت بِهِ العي","رُ عَنِ الجُبِّ خاضِعاً كَالطَليحِ",25,"ح",1,0],["وَشَبَّبتُ أَطرَبُ لا عَن هَوىً","وَهَل يَطرَبُ المَرءُ إِن شَبَّبا",26,"ب",2,0],["وَشُبِ الوَعيدَ بِمَوعِدٍ","فَالماءُ يُمزَجُ بِالرَحيقِ",27,"ق",1,0],["وشبا الأسنة فيه ألسنَةٌ إذا","نطقت فمنطق سؤددٍ وسداد",28,"د",1,0],["وَشَبِعتُ مِن أَمرٍ وَمَملَكَةٍ","وَحَكَمتُ بِالمَلَكاتِ وَالسُنِّ",29,"ن",1,0],["وَشَبابٍ كانَ يُعجِبُني","وَبِهِ قَد كُنتُ لَعّابا",30,"ب",2,0],["وَشَبيهُ الَّذي تَلَبَّثَ في السِج","نِ سِنيناً وَكانَ بَرّاً نَجيبا",31,"ب",2,0],["وَشِب لي بِاِسمِها عَذَلي","وَزِدني ثُمَّ زِد وَزِدِ",32,"د",1,0],["وَشَبَّت حَربُها وَاِشتَ","عَلَت تُلهِبُ نيرانا",33,"ن",2,0],["وَشَبابي قَد كانَ مِن لَذَّةِ العَي","شِ فَأَودى وَغالَهُ اِبنا سَميرِ",34,"ر",1,0],["وَشَبَّ وَشابَ وَأَفنى الشَبابَ","وَسَقياً لَهُ مِن خِضابٍ نَصَل",35,"ل",1,0],["وشَبِيهٌ صَوْتُ النّعيّ إذا قِي","سَ بِصَوْتِ البَشيرِ في كلّ نادِ",36,"د",1,0],["وَشُبِّهَ الهَيدَبُ العَبامُ مِنَ ال","أَقوامِ سَقباً مُلَبَّساً فَرَعا",37,"ع",2,0],["وشبت له نار ابن طمر بداله","سناها وأنى منه نار بني طمر",38,"ر",1,0],["وَشبت الحرب ناراً","عمت تَروع الأناما",39,"م",2,0],["وَشباباً به تلفعت حنياً","أَتملى غيدانه ثم زالا",40,"ل",2,0],["وَشب الأسى في قَلبها متسرِّعاً","إليه شبوب النار في الحطب الجزل",41,"ل",1,0],["وشُبَّانُنَا مِثْلُ الكُهُولِ وكَهْلُنَا","إذَا شَابَ قِنْعَاسٌ مِنَ القَوْمِ أَجْلَحُ",42,"ح",1,0],["وشبابَ مهدور الدماءِ مجاهد","في اللّه عَن عربٍ وعن إِسلامِ",43,"م",1,0],["وَشَبابٍ وَكُهولٍ أَقسَموا","أَن يَشيدوا مَجدَها فَوقَ الذُرا",44,"ر",2,0],["وشَبَبْتَ مُكْتَمِلَ الرجُولَةِ حَيْثُمَا","دَرَجَ اللِّدَاتُ مدارِجَ الأَطْفَالِ",45,"ل",1,0],["وَشَبَابُهُمْ هُمْ هُؤْلاَءِ وَكُلُّهُمْ","سَامِي السَّجِيَّةِ ذُو ذَكَاءٍ ثَاقِبِ",46,"ب",1,0],["وَشَبَاباً هُمْ نُخْبَةٌ في شَبَابِ الْعَصْ","رِ عِلْماً وَحِكْمَةً وَمضَاءَ",47,"ا",2,0],["وشَبَابُ مِصْرَ يَروَنَ مِنْكَ لَهُمْ أَباً","ويَرَوْنَ مِنْكَ بِمَنزِلِ الأَبنَاءِ",48,"ا",2,0],["وشباب قد فات إلا تناسي","ه ونفسٍ لم يبق إلا شجاها",49,"ا",3,0],["وَشَبَّهتهُ لينا فَلَمّا قَلبتهُ","إِذا هُوَ فَوقَ الفَرقَدَينِ أنيلُ",50,"ل",1,0],["وَشِبَاكٍ مِنَ الْجَرائِمِ وَالْختْلِ","حَوَاهَا شَيْطانُهُمْ فِي جِرَابِهْ",51,"ب",2,0],["وشبابٌ كأنه ناضرُ الريح","انِ في حسنهِ وفي نَفَحاته",52,"ت",2,0],["وشبابا توهجوا فانطفى \" نيرون \"","وانهار أغبر الوجه فاحم",53,"م",1,0],["وشبّ طفل الهدى المنشود متّزرا","بالحقّ متّشحا بالنور والنار",54,"ر",1,0],["وَشَبيبَةٌ، فيها النُّهَى، فإذا بَدَتْ","لذَوِي التّوَسّمِ، فَهْيَ شَيبٌ أسوَدُ",55,"د",1,0],["وَشَبَّ عَنِ الأَكْمَامِ زَهْرُ شَبَابِهَا","وَدَلَّ عَلَى النَّعْمَاءِ غَضُّ إِهَابِهَا",56,"ه",2,0],["وَشَبَّا بِحِجْرٍ وَاحِدٍ وَتَرَعْرَعَا","وَضُمَّا بِعَقْدٍ مُبْرَمٍ غَيْرِ مُنْحَلِّ",56,"ل",1,0],["وشباب أشدُّ بطشاً من الأُسْ","د شداد تخالهم في الجلادِ",57,"د",1,0],["وَشُبّاناً إِذا فَزِعوا تَغَشّوا","سَوابِغَ يَسحَبونَ لَها ذُيولا",58,"ل",2,0],["وشِبهَ ذَينِ وأبوَابَ النِّيَابَةِ لا","تَجهَلهُهَا أبَداً لاَ تَجَهَلَن ذَينِ",59,"ن",1,0],["وَشَبَّهَ عَن جَهلٍ حَبيبٌ وَلو رَأَى","زَمانَكَ لَم يَعدِل بِهِ زَمَنَ الوَردِ",60,"د",1,0],["وشبيهاً بأوّليهِ فإن لا","ح حسبنا جدَّه وأباه",61,"ا",2,0],["وشبَّ وشاب الدهر فيهم ومن يمت","يخّلف وراه للخلافه كافيا",62,"ي",2,0],["وشب فشب الدهر عند شبابه","وعادت قواه واستقلت قوائمه",63,"م",2,0],["وشب للعلم فتيان بدولته","صالوا بجدة فهم يقطع الحجرا",64,"ر",2,0],["وشبهه بالدار تبنى وما درت","ببان يشيد السمك منها وينصب",65,"ب",1,0],["وشبهته بالخلق جهلا وقلتم","عبادته مثل العبادة للصخر",66,"ر",1,0],["وشبابا ما كنتُ من قبل نَشْرِ ال","شيب أخشى غُرابَه أنْ يَطيرا",67,"ر",2,0],["وشبّب في قصائده بدعد","ولم يرها ولا حضرته دعد",68,"د",1,0],["وَشبّه إِذا ما شئتَ بالضبِّ بعضهم","ثَوى لِخداعِ الناس من ديره جحرا",69,"ر",2,0],["وشبَّهتُ شكواه في رفعه","بشكوى عليلٍ يُداوي طبيبا",70,"ب",2,0],["وشبب الغصون بها سرورا","نسيم الروض مذ غنى الهزار",71,"ر",1,0],["وشبّ شباباً للنواظر ناضراً","وفيه لسر المجد مرأىً ومسمع",72,"ع",1,0],["وَشَبَّهتُهُ كَفَّ مُهديهِ لي","فَما يَصلُحانِ لِغَيرِ القُبَل",73,"ل",1,0],["وشبيهةَ الظبياتِ في نظراتها","ما بين ذاتِ خِباً وذاتِ كِنَاسِ",74,"س",1,0],["وشبه بالمريخ لما خضبته","وما ذاك إلا وهو اشقر أزرق",75,"ق",1,0],["وَشَبَّت طَيِّئُ الجَبَلَينِ حَرباً","تَهِرُّ لِشَجوِها مِنها صُحارُ",76,"ر",1,0],["وَشِبْلاً يَهْصُر الآسادَ بأساً","أَلَمَّ بغَابَة الأَسَد الهَصُورِ",77,"ر",1,0],["وَشَبابي غَضَّةً أَفنانُهُ","وَلَهُ ظِلٌّ ظَليلٌ وَقَلَص",78,"ص",1,0],["وشبّهت الحُسامَ به مَضاءً","فَغار فَشَنَّ في العُشّاق غارَه",79,"ر",2,0],["وشبَّ الثورَةَ الأُولى فأَذكى","نفوساً كاد يدركها انطفاءُ",80,"ا",2,0],["وَشَببت في أحشاء حسّادي لظى","لا يطعمونَ بها المنام غرارا",81,"ر",2,0],["وشبابي على رباها خيال","عاثِرُ الظل عبقريّ الشحوب",82,"ب",1,0],["وشبابي المحروم واللهفة الهو","جاء تمضى به لغير قرار",83,"ر",1,0],["وشبيب أنفاس الشروق","وصمت أطياف الغروب",84,"ب",1,0],["وشِبْتُ فاحتجبتْ عنّي الحسانُ قِلىً","وكان منهنّ طَرْفي يَجْتلي صُوَرا",85,"ر",2,0],["وشبه وقت الموت في يوم صلبه","وهذا مقالٌ مفعمٌ كل شبهة",86,"ه",1,0],["وَشَبابٌ كَأَنَّهُم أُسدُ غيلٍ","خالَطَت فَرطَ حَدِّهِم أَحلامُ",87,"م",1,0],["وشبهة كم حولها من فتى","حام ولم يدر بما يقبل",88,"ل",1,0],["وَشِبل رَجَونا أَن يَكون غَضَنفَراً","فَماتَ وَلَم يَجرح بِنابٍ وَلا ظفرِ",89,"ر",1,0],["وشبب بشاص وفي برج دوس","ويوم بحصن لهم مرتهن",90,"ن",1,0],["وشِبْتُ في حُبّه فوا سَقَمي","وها أنا الآن منه في ورطَه",91,"ط",2,0],["وشبّ البأسُ نيرانَ المواضي","وأسبلَ غيثَ أمواهِ النجيعِ",92,"ع",1,0],["وشَبا عزمةٍ يردُّ بها الخط","بَ وفيه من شفرتَيْها كُلومُ",93,"م",1,0],["وشبّوا الهم نار الجهاد فإنكم","متى تتركوها آن للنار تحمد",94,"د",1,0],["وشَبَّ شيبانُنا من ذِكْرِهِ فَرَحاً","وشابَ من خِزْيِهِ فِي الشِّرْكِ أَطفالُ",95,"ل",1,0],["وشبابُ لَيْلٍ طالَمَا بَلَّغْتُهُ","تَخْطِيطَ شَيْبٍ أَوْ نُصُولَ خِضَابِ",96,"ب",1,0],["وشبّ بأرض بوليفا","وجارتها على تخم",97,"م",1,1],["وشبان إلى شرب ال","ردى سبقوا بلا استثنا",98,"ا",1,0],["وشبّ الحرب حتى عم","ت الدنيا بلا استثنا",98,"ا",1,0],["وَشُبّوا عَلى فَرعِ اليَفاعَةِ نارَكُم","لِيَأتيها الضَيفُ الَّذي باتَ سارِيا",99,"ي",2,0],["وشبهةٍ في الرأي مجهولةٍ","لا تجدُ النجمَ بها هاديا",100,"ي",2,0],["وشبابي ما عليه في الهوى","أمرُ سلطانٍ ولا تعزير والي",101,"ل",2,0],["وشبابي إن دنوتم كان غَضَّاً","وإذا رحتم مع البين استُرِدَّا",102,"د",2,0],["وشبابي نصلتْ صبغتهُ","ودجى ليليَ صبعٌ ما نصل",103,"ل",1,0],["وشَبَّ فيهمْ شِهابُ السِّرِّ فانْمَحَقوا","كَذاكَ غاراتُ مَوْلانا الرِّفاعِيِّ",104,"ي",1,0],["وشبابها مثل الشباب فرونق","غض وأيام بها شهوات",105,"ت",1,0],["وشبيهٌ بالرَّوْضِ خُلْقاً وبالقَطْ","رِ نوالاً وراحةً بالرّيحِ",106,"ح",1,0],["وشبَّ نملُ عِذارَيه فقلتُ له","كبُرت يا نملُ أَوْ صِرْت السُّليماني",107,"ي",1,0],["وشبتُ مِنْه وإِنَّ الشَّيبَ أَكْثَره","يَبْدو مِن الْهَمِّ لا يَبْدو مِنَ الكِبَر",108,"ر",1,0],["وشِبتُ فَما لي لا أَرى الصُّبحَ أَشْيباً","وعِشْتُ زَمَاناً لا أَرى اللَّيلَ أَسْودَا",109,"د",2,0],["وشبَّ لهيبُ القلبِ إِذ فاض مَدْمَعِي","فَنَوْرَزَ