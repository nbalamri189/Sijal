{"poems":[[94,"كرهت القصور وقطانها","https://www.aldiwan.net/poem38931.html","المتقارب"],[264,"غب دعاء عاطر","https://www.aldiwan.net/poem35755.html","مجزوء الرجز"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[409,"من فلق البحر للكليم ومن","https://www.aldiwan.net/poem33376.html","المنسرح"],[466,"نطقت بمدحي ثم أسررت بعده","https://www.aldiwan.net/poem16168.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83309","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101027","الوافر"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28497","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62832","المتقارب"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135839","الرجز"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33345","المنسرح"]],"verses":[["وكَيْدَ الضَّعيفِ لِسَعْي القويِّ","وعَصْفَ القويَّ بجَهْدِ الضَّعيفْ",0,"ف",1,0],["وكيد كلّ غادر","وحقد كلّ كاسر",1,"ر",1,0],["وَكَيدُ فِرعَونَ وَما السِحرَ الَّذي","جاءَ بِهِ وَمَن بِهِ البَحَر عَبَر",2,"ر",1,0],["وكيد حتى غدا بسجنهم","مرتهناً برهة من الزمن",3,"ن",1,0],["وكيدُ أواخي الوِدِّ وافٍ بعهْدهِ","الكريم فلا نكْثٌ يَشينُ ولا غَدْرُ",4,"ر",1,0],["وَكَيدٌ عَلى الأَتراكِ قيلَ مُصَوَّبٌ","وَلَكِن لِصَيدِ الأُمَّتَينِ حَبائِلُه",5,"ل",2,0],["وكيداً يترك البصراء عمياً","ويترك لجة الرجاف آلا",6,"ل",2,0],["وَكَيد عَلى الأَعداءِ يَرمي زَنادُهُ","لواذِعَ ما فيها سَلامٌ وَلا بَردُ",7,"د",1,0],["وكيدُكَ يَلبَسُ أثوابهُ","كما يلبسُ الزِبْرِقانُ السِّرارا",8,"ر",2,0],["وكيدَهُمْ فاجعلْهُ في نحورِهمْ","تدميرَهم يكون في تدبيرهمْ",9,"م",1,0],["وكيدَ حتى كأنهُ حنقٌ","أو طالبٌ في جفائِه وترا",10,"ر",2,0]]}