{"poems":[[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113977","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53163","الرجز"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106880","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201885","الوافر"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100173","البسيط"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103268","الرمل"],[4816,"سامحكم الله","https://www.poetsgate.com/ViewPoem.aspx?id=8491",""],[6019,"يا بسمة عمري","https://www.poetsgate.com/ViewPoem.aspx?id=53786",""]],"verses":[["بنَشيدٍ ومِزهَرٍ وعويصٍ","من علومِ الهدى عزيزِ المنالِ",0,"ل",1,0],["بِنَشْرِه الخوف بما","تطوى من المراحل",1,"ل",1,0],["بنشاط مضمون النجاح له","من علمه ونشاطه سند",2,"د",1,0],["بنشر الشعر كم عانيت جهداً","فكنت أشقُّ صخراً أو جليدا",3,"د",2,1],["بنشرها ينشر الميت الرميم ومن","أنوارها تنجلي الغماء والكرب",4,"ب",1,0],["بنشاط لا يدانيه الونى","طيلة العمر وعود لا يلين",5,"ن",1,0],["بنشدك يا من يملك الشر والخير","يا حافظ في اللوح اغلى كتابه",6,"ب",2,1],["بِنَشِيدِهِ لَحنٌ يُطرِبُنِي","فَتَمَايَلَ قَلبِيَ وَاحْتَفَلا",7,"ل",2,0]]}