{"poems":[[95,"هذا الرثاء الذي تمليه أشجاني","https://www.aldiwan.net/poem11189.html","البسيط"],[47,"أفي مستهلات الدموع السوافح","https://www.aldiwan.net/poem62691.html","الطويل"],[68,"خذ من الدهر لي نصيب","https://www.aldiwan.net/poem41371.html","مجزوء الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85817","المجتث"],[463,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53101","الطويل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97921","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48454","المتقارب"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216439","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135752","الرجز"],[3271,"وطن الفأس","https://www.poetsgate.com/ViewPoem.aspx?id=104126",""],[5183,"نكبات الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=186413",""],[5272,"حلم صغير","https://www.poetsgate.com/ViewPoem.aspx?id=202108",""],[5674,"جئت إليك ياخنساء أعتذر","https://www.poetsgate.com/ViewPoem.aspx?id=185907",""],[6124,"أوتار الكمان","https://www.poetsgate.com/ViewPoem.aspx?id=201312",""]],"verses":[["فِي الضَّيْرِ وَالضَّيْمِ لَمْ يَجْهَلْ مَبَرَّتَكُمْ","وَلا مُرُوءَتَكُمْ عَافٍ وَلا عَانِ",0,"ن",1,0],["فَيا لَضَلالِ الرَأيِ كَيفَ أَرادَهُ","أَحِبّاؤُهُ بِالمُعضِلاتِ الجَوائِحِ",1,"ح",1,0],["في الضُحى تُشبِهُ الشُموس","وَهيَ تَحتَ الدُجى سِراج",2,"ج",1,0],["في الضيق أنت عدوي","وفي الرفاهة خلي",3,"ل",2,0],["في الضاربين على البَلقْاءِ باديةً","يَسبِي لها الحرَّ من أبنائه الحَضَرُ",4,"ر",1,0],["في الضرب والعروض حيث أقبلا","وفيه خلف عن سعيد نقلا",5,"ل",2,0],["فيا لضلوع أججت نار كربها","غيوث دموع قلّما تنقع الصدى",6,"د",2,0],["في الضيق كان يزورني","يشكو إلى من الحرج",7,"ج",1,1],["فَيا لضريحٍ ثوَى عندَهُ","غَداة أناخَ به رَكْبَهُ",8,"ب",2,0],["فِى الضِّدِّ جَرِّد والمُمَيِّزَ اجرُرِ","جَمعاً بِلَفظِ قِلَّةِ فِى الأكثَرِ",9,"ر",1,0],["فى الضفة الأخرى بقية عسكر","قاومتهم جهد المطيق وقاوموا",10,"م",3,0],["في الضعف والذلِّ بلغنا درَكَهْ","لم تَصِلَنْها نفسُ عبدٍ هالكَهْ",11,"ه",1,0],["في الضحى والشعاع جاثٍ على الني","ل كما خرّ ساجدٌ في صلاتهْ",12,"ت",2,1],["فيا لضريح ضم جرما به الهدى","ومعنى الهدى والعالم المتعمقا",13,"ق",2,0],["في الضفَّتينِ أنا يانهر لي صخبٌ","تجري مياهي مصبَّاً لستُ أعنيهِ",14,"ي",2,0],["في الضادِ أنتِ الهوى.. والنبضُ في نٓسٓقي","في السطرِ ترتيلةٌ.. ما قالها بٓشٓرُ",15,"ر",1,0],["فِي الضُّحَى كُنْ كَالغَوَانِي","وَانْتَقِلْ بَيْنَ الجِنَانِ.",16,"ن",1,0]]}