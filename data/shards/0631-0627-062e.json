{"poems":[[53,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[47,"عاود القلب بثه وخباله","https://www.aldiwan.net/poem65603.html","الخفيف"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62216","البسيط"],[123,"حثا شرابهما في ظل حسان","https://www.aldiwan.net/poem49285.html","البسيط"],[435,"راخ لها في السبب","https://www.aldiwan.net/poem12774.html","مجزوء الرجز"],[460,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[460,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[460,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[460,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[460,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"]],"verses":[["راخى خناق بني اللأواء كلِّهمِ","وشدَّ آساس ملك كُنَّ أجرافا",0,"ف",2,0],["راخَنا أَمسِ جاهُهُ وَثَنى اليَو","مَ لَنا بِالرِياشِ أَجمَعَ مالُه",1,"ل",2,0],["رَاخَى مَزَارَكَ عَنْهُمْ أَنْ تُلِمَّ بِهِمْ","مَعْجُ القِلاَصِ بِفِتْيَانٍ وأَكْوَارِ",2,"ر",1,0],["راخت ليالي النوى أوتار عيداني","يا لهف نفسي على جنكي وعيداني",3,"ن",2,0],["راخِ لها في السّبَبِ","وارمِ عِراصَ السَبْسَبِ",4,"ب",1,1],["راخَى له المِرزمانِ وانشالت ال","عقربُ عن كلِّ هاجم عَرِمِ",5,"م",1,0],["راخِ لها فادنُ بها","ناشطةً من الرِّبَقْ",6,"ق",1,0],["راخِ لهم فإنهم وفدُ هوىً","يرضيه أن تُرْوِدَ أو أن تَسْلَسا",7,"س",2,0],["راخِ يديكَ في امتدادِ حبلِهِ","وطاوِل الوقتَ به أن يُجذَبا",8,"ب",2,0],["راخِ على الدنيا إذا عاسرتْ","وإن أتَتْ مُسمِحةً فاجذِبِ",9,"ب",1,0]]}