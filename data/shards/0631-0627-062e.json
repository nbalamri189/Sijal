{"poems":[[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[45,"عاود القلب بثه وخباله","https://www.aldiwan.net/poem65603.html","الخفيف"],[118,"حثا شرابهما في ظل حسان","https://www.aldiwan.net/poem49285.html","البسيط"],[429,"راخ لها في السبب","https://www.aldiwan.net/poem12774.html","مجزوء الرجز"],[456,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[456,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[456,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[456,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[456,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"]],"verses":[["راخى خناق بني اللأواء كلِّهمِ","وشدَّ آساس ملك كُنَّ أجرافا",0,"ف",2,0],["راخَنا أَمسِ جاهُهُ وَثَنى اليَو","مَ لَنا بِالرِياشِ أَجمَعَ مالُه",1,"ل",2,0],["راخت ليالي النوى أوتار عيداني","يا لهف نفسي على جنكي وعيداني",2,"ي",1,0],["راخِ لها في السّبَبِ","وارمِ عِراصَ السَبْسَبِ",3,"ب",1,1],["راخَى له المِرزمانِ وانشالت ال","عقربُ عن كلِّ هاجم عَرِمِ",4,"م",1,0],["راخِ لها فادنُ بها","ناشطةً من الرِّبَقْ",5,"ق",1,0],["راخِ لهم فإنهم وفدُ هوىً","يرضيه أن تُرْوِدَ أو أن تَسْلَسا",6,"س",2,0],["راخِ يديكَ في امتدادِ حبلِهِ","وطاوِل الوقتَ به أن يُجذَبا",7,"ب",2,0],["راخِ على الدنيا إذا عاسرتْ","وإن أتَتْ مُسمِحةً فاجذِبِ",8,"ب",1,0]]}