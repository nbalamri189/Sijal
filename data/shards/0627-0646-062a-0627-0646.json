id=199087",""],[5064,"الأنوثة المخبولة","https://www.poetsgate.com/ViewPoem.aspx?id=199150",""],[5121,"بَيْرُوتُ الْحُبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=215332",""],[5147,"أنا شيء وكنه هيكلي المشهود","https://www.poetsgate.com/ViewPoem.aspx?id=166689",""],[1470,"نبع الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=12967",""],[5193,"الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=213571",""],[5351,"شكوى سعد","https://www.poetsgate.com/ViewPoem.aspx?id=202099",""],[5351,"على درب الحسين","https://www.poetsgate.com/ViewPoem.aspx?id=202234",""],[5443,"واطُولَ صَبرِي!","https://www.poetsgate.com/ViewPoem.aspx?id=185149",""],[5491,"أقسمت","https://www.poetsgate.com/ViewPoem.aspx?id=197188",""],[5558,"أَنتِ يا أُمِّي مَلاكٌ","https://www.poetsgate.com/ViewPoem.aspx?id=211878",""],[5561,"نجمة الليل","https://www.poetsgate.com/ViewPoem.aspx?id=193221",""],[5674,"الوداع طويل","https://www.poetsgate.com/ViewPoem.aspx?id=191215",""],[5725,"يا انيق العتاب","https://www.poetsgate.com/ViewPoem.aspx?id=203178",""],[402,"غلب الموت فالحياة ثكول","https://www.poetsgate.com/ViewPoem.aspx?id=36544",""],[5804,"القصيدة القمرية","https://www.poetsgate.com/ViewPoem.aspx?id=184052",""],[469,"جزت حدَّ المديح قولاً وفعلا","https://www.poetsgate.com/ViewPoem.aspx?id=76860",""],[5848,"آل ثاني والدوحه وحبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=53199",""],[5956,"نوع احتياجي","https://www.poetsgate.com/ViewPoem.aspx?id=181892",""],[5956,"أنت نور الله فينا والأملْ..","https://www.poetsgate.com/ViewPoem.aspx?id=192437",""],[5956,"رُحماك يا نسلي العزيز","https://www.poetsgate.com/ViewPoem.aspx?id=214192",""],[243,"صحيفة الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68182&r=&rc=174",""],[6246,"وقفة على الشاطئ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74371&r=&rc=0",""],[6307,"اعتراف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79013&r=&rc=1",""],[6328,"ليته جاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82087&r=&rc=6",""]],"verses":[["أَنْتَ أَنْقَذْتَهُ وَلَيْسَ لَهُ إِل","لاكَ فِي كُلِّ غَايَةٍ وَابْتِدَاءِ",0,"ا",2,0],["أَنتِ أَنبَتِّ ذَلِكَ النَبتَ يا مِص","رُ فَأَضحى عَلَيكِ شَوكاً قَتادا",1,"د",2,0],["أَنتِ أَنبَتِّ ناعِقاً قامَ بِالأَم","سِ فَأَدمى القُلوبَ وَالأَكبادا",1,"د",2,0],["أَنتَ إِن تَأسَ عَلى","المَفقودِ إِلفاً وَاِجتِباءَ",2,"ا",2,0],["إن تأنَّوا فربضة الليث تأتي","بعدها وثبة له وكفاح",3,"ح",1,0],["أنت إن لم يكن لنا","شافعٌ خيرُ شافع",4,"ع",1,0],["أَنْتَ أَنْزَلْتَني إلى ظُلْمَةِ الأَرضِ","وقَدْ كنتُ في صباحِ زَاهِ",5,"ه",1,0],["أَنْتَ أنشأْتني غريباً بنفسي","بَيْنَ قومي في نَشْوَتي وانتباهي",5,"ي",1,0],["أَنتِ أُنشودَةُ الأَناشيدِ غنَّاكِ","إِلهُ الغناءِ ربُّ القصيدِ",6,"د",1,0],["أَنتِ أَنتِ الحَيَاةُ في قدْسها السَّا","مي وفي سِحْرها الشَّجيِّ الفريدِ",6,"د",1,0],["أَنتِ أَنتِ الحَيَاةُ في رِقَّةِ ال","فجر في رونق الرَّبيعِ الوليدِ",6,"د",1,0],["أَنتِ أَنتِ الحَيَاةُ كلَّ أَوانٍ","في رُواءٍ من الشَّبابِ جديدِ",6,"د",1,0],["أَنتِ أَنتِ الحَيَاةُ فيكِ وفي","عَيْنَيْكِ آياتُ سحرها الممدودِ",6,"د",1,0],["أَنْتَ أنشودةُ فَجْرٍ رتَّلَتها الظُّلُماتْ","أَيُّها السَّاري مع الظُّلْمةِ في غير أناةْ",7,"ه",1,0],["أَنتَ إِن تَغزُ ظافِرُ","فَليُطِع مَن يُنافِرُ",8,"ر",1,1],["انت ان تعزمى يهن كل صعب","لا ينال المراد غير المريد",9,"د",1,0],["انت ان رمنا للنوابغ عداً","واحد من اولئك الابطال",10,"ل",1,0],["انت ان عشت تمت جو","عاً وان مت تعيش",11,"ش",1,0],["أنت إن عد خواقين الورى","خيرهم جدّا وأزكاهم أبا",12,"ب",2,0],["أنت إن عشت نزيها","بين عزل واعتزا ل",13,"ل",1,0],["أنت إن بت في الجفون فأهلا","عادة النور ينزل الأبصارا",14,"ر",2,0],["أَنتَ إِن بِتَّ في الجُفونِ فَأَهلٌ","عادَةُ النورِ يُنزِلُ الأَبصارا",15,"ر",2,0],["أَنتَ إِن شِئتَ نَعيمي","وَإِذا شِئتَ شَقائي",16,"ا",3,0],["أَنتَ أُنسٌ لَنا إِذا بَعُدَ الإِن","سُ وَأَنتَ الحَياةُ وَالإِحياءُ",17,"ا",2,0],["أَنتَ أَندى كَفّاً وَأَشرَفُ أَخلا","قاً وَأَزكى قَولاً وَأَكرَمُ فِعلا",18,"ل",2,0],["أنتِ إن تؤمني بحبي كفاني","لا غرامي ولا جمالك فاني",19,"ن",2,1],["أنتَ أنتَ الأمينُ عزَّ بكَ الصُّن","عُ الذي يرفع الرِّجالَ وسادا",20,"د",2,0],["أنت أنشأتَ للنُّفوس حَياةً","غَيَّرتْ كلَّ كائنٍ تغييرا",21,"ر",2,0],["أَنتَ أَنكى مِن بائع الأرض عندي","أَنتَ أَعذاره الَّتي يدعيها",22,"ي",3,0],["أَنتَ إِن لَم تَمُت بِها ال","عامَ لَم تَنجُ قابِلا",23,"ل",2,0],["أَنتَ أَنفُ الجودِ إِن زايَلتَهُ","عَطَسَ الجودُ بِأَنفٍ مُصطَلَم",24,"م",1,1],["أَنتَ إِن رُمتَ وَصلَنا","فَاِنجُ هَل تُدرِكُ القَمر",25,"ر",1,0],["أَنْتَ أَنْتَ النَّبِيلُ لاَ يَدَّعِي مَا","لَيْسَ فِيهِ مَا كُلُّ مُثْرٍ نَيِبلُ",26,"ل",1,0],["أَنْتِ أَنْصَفْتَ حَافِظاً دُمْتَ مِنْ قَا","ضٍ نَزِيهٍ وَمِنْ وَزِيرٍ حُرِّ",27,"ر",1,0],["أَنت أنبَتِّ في ثَرَى النِّيلِ شَعْباً","نافِذَ الرَّأْي طاهِرَ النَّزَعاتِ",28,"ت",1,0],["أنتَ أنهضْتَ مصرَ تستَبِقُ الْخطْوَ","وتمضِي بِعَزْمَةٍ وطِماح",29,"ح",1,0],["أنت انتقيت رجال أمرك","وارتقبت بهم صلاحك",30,"ك",1,0],["أنت أنقذتَهُ وليس له إلاك","في كل غاية ٍ وابتداء",31,"ا",2,0],["أَنت إن بتَّ في الجفون فأَهلٌ","عادة النور ينزل الأبصار",32,"ر",1,0],["أَنتَ أَنقَذتَني مِن الضَلّ وَالشّر","ك بِنور أَضاءَ لي مِن هُداكا",33,"ك",2,0],["انت انيسي وجليسي الذي","يحيا به لبي ونعم العشير",34,"ر",1,0],["انت انت الذي تبدت جهارا","يد روح الوجود بعد خطابك",35,"ك",1,0],["انت ان قام للأكابر شأن","فمدى الدهر شأن بيتك حابك",35,"ك",1,0],["انت ان عدت الرجال أمام","برحاب التفويض انزلت مابك",35,"ك",1,0],["انت ان ثارت الاعادي بحرب","يوم كرب احرقتهم بشهابك",35,"ك",1,0],["انت ان صح للسوى ترك دنيا","كان خلع الاكوان من آدابك",35,"ك",1,0],["أنتَ أنتَ الفتَى أبو العرب الزاكى","أبُو الخلق كلهم لَنْ تَزَالاَ",36,"ل",2,0],["أنتَ أنتَ الذي لَحنتَ مِرَاراً","ولَقد كُنتَ بِاللُّحُونِ زَعِيمَا",37,"م",2,0],["أنتَ أنتَ الأَضَاةُ والرَّاكِدُ الرَّن","قُ وأنتَ الهَشِيمُ مَعنًى وِسيمَا",38,"م",2,0],["أَنتَ أَنداهُمُ إِذا أَجدَبَ العا","مُ وَأَهداهُمُ لِطُرقِ المَعالي",39,"ل",2,0],["أنت أنقذت فؤادي من جواه","وسقيت الروح أكوابَ الصفاء",40,"ا",2,0],["أنت أنسي برغم بعدك عني","وسمير معي بكل مكان",41,"ن",1,0],["أَنت إِن غابت البدورُ لنا بد","رٌ متى لاح تَنجلى الظلماءُ",42,"ا",2,0],["أَنتَ إِن حاوَلَت مُناواتَكَ الأَن","واءُ أَندى كَفّاً وَأَرحَبُ باعا",43,"ع",2,0],["أنت، إنْ أنكرتَ ودّي","فأنا أحْفَظْهُ دَهْرا",44,"ر",2,0],["أنت ان لم تحد عن الجد يوما","غرة العصر بالمكارم احرى",45,"ر",2,0],["أَنتَ أَنتَ المُرتَجى إِن سَنحَت","كُربَةٌ أَو أَعوزَ الإِقبالَ سُنحُ",46,"ح",1,0],["أَنت أنت والرأي رأيك والخط","ب يسيرٌ على ذوي الألبابِ",47,"ب",1,0],["أنت أُنسي في وحشتي ويقيني","في شكوكي ويقظتي في رقادي",48,"ي",1,0],["انت ان اضربت يوماً","عن كذاب انا اضرب",49,"ب",1,0],["أنت أنت الإِمام في العلم والنظ","م ونحن الأجناد في سلطانك",50,"ك",1,0],["أنت إنسان كل عين كمال","وجمال له على الإِطلاق",51,"ق",1,0],["أَنْتَ أَنْتَ اليوم فيها سيّدٌ","يُتّقى بأساً ويُرجى كرما",52,"م",2,0],["أنتَ أندى الناس إنْ تثرى ندى","يا غماماً سحَّ يا بحراً طمى",53,"م",2,0],["أنت أندى كفّاً وأحسن للأي","ام منهُ فرعاً وأشرف أصلا",54,"ل",2,0],["أَنتَ إِن أَصبحتَ من أَتْباعِهِ","قل لأَهلِ البَغْيِ موتوا كَمَدَا",55,"د",2,0],["أنت إن عدوك شخصاً واحداً","فكذا الواحد أصل العدد",56,"د",1,0],["أَنْتَ أَنْتَ الذي بِكَ اطّرحَ الرَأ","يُ وَقَدْ كانَ حَوْلَهُ التَّعْويلُ",57,"ل",1,0],["أنت إنسان خيالي","لك عقل كالعقالِ",58,"ل",1,1],["أنت إن كنت قد غضبت جعلنا","لك حر الوجوه أرضاً لترضى",59,"ض",2,0],["أنتَ أنتَ الذي جَنَيتَ عَلى نَف","سِكَ فاصبِر تَجد أُؤلاكَ أؤلاكا",60,"ك",2,0],["أَنت أُنسٌ لوالدَيك وسلوى","حبَّذا الأُنس بالبنين نصيبا",61,"ب",2,0],["أَنتَ أَنتَ الفرد الَّذي لم ينا","زعك شريك على المساعي العظام",62,"م",1,0],["أَنتَ إِنسانُ عَين دَهرك يا خَي","رَ أَميرٍ للمكرمات يُعاني",63,"ن",2,0],["أَنَّتْ أنينَ مغرَّبٍ عن إلفِهِ","ودموعها مثلُ الجمان سوابقُ",64,"ق",1,0],["أَن تَأنَسوا بِمُذَمَّمينَ عُروقُهُم","في الناسِ إِن نُسِبوا عُروقُ عَبيدِ",65,"د",1,0],["أنتَ أنت الذي بلغتَ ذرا ال","مجد وبالمجد فُقْت عمراً وحُجْرا",66,"ر",2,0],["أنت إنسانُ عين هذا الزمانِ","وهُدانا وعينُ عقلِ عُمانِ",67,"ن",1,1],["أنت أنت الملاذ إن أفظع الكر","ب ومدّت للفتك أيدي الخطوب",68,"ب",1,0],["أنت أنداهم جنابا مريعا","إن سئلت الندى ووجها وكفّا",69,"ف",2,0],["أنت إن أقطب وجه الد","دهر مفتر المباسم",70,"م",1,0],["أنت أن تأتهم تنزل لهم","باغياً للعرف فيهم لا تخب",71,"ب",1,0],["أنت إن لم تجر الدموع عليه","لم تكن في دفتر الولاء مقيد",72,"د",1,0],["أنت أنثى حمراء لم تبق منها","شهوة الليل غير بعض القشور",73,"ر",1,0],["أَنتَ إِنسانٌ تُسَمّى","دارُهُ دارُ الزَّواني",74,"ن",2,1],["أنتِ أنا ان تُخلصين مودَّةً","لا تجزعي ان التعاضد ريحُ",75,"ح",1,0],["أنت إن قلت كبدر","رفعة أسنى وأعلى",76,"ل",2,0],["أنت أنكحتني فقد أض","حى ولداً وكان قبل عقيما",77,"م",2,0],["أنتَ أنتَ ملجانا","أنت أنت معطينا",78,"ن",2,0],["انتَ إِن جزتَ ارض تبريز تحظى","بهما عند يوسف ابن جوادِ",79,"د",1,0],["أنت ان تنس جميلا","منك إني غير ناس",80,"س",1,0],["أَنتَ إِن تَقطُر دَماً","فَقَديماً ما قَطَرت",81,"ت",1,0],["أنت أنقى نفساً وأطهر روحاً","فانتقيني من بينهم وخذيني",82,"ن",2,0],["أنت أنشودة السعادة والبؤ","س أغنى بها المدى ترتيلا",83,"ل",2,0],["أنت أنت الدنيا ولم نرفيها","غير آمالنا بوصلك فضلا",84,"ل",2,0],["أنت أنجبت للحروب رجالا","قد أبوا فيها ذلةً وانكسارا",85,"ر",2,0],["أنتِ أنموذجٌ لكلِّ بلادٍ","تَعمرُ الأرضَ دأبها التجميلُ",86,"ل",1,0],["أنت ان لم تجد لنفسك كفواً","فلك السابقات عوداً وبدءا",87,"ا",2,1],["أَنتَ إِن لَجا","لاجئٌ ظُلم",88,"م",1,0],["أَنتَ إِن تكن","في الوَرى حَكم",88,"م",1,0],["أَنتَ إِن جئت سرت في أَوّل الشو","طِ فأحييت سيرة الأَوّلينا",89,"ن",2,0],["أنت ان فهت با البكلام حكيم","نطقت عنك حكمة الحكماء",90,"ا",2,0],["أنت آنست ذا الزمان وقد غا","دره موحشاً بنوه اللثام",91,"م",1,0],["أنت أنت التي سرت في عروقي","منك يوم اللقاء خمر جمالك",92,"ك",1,1],["أنت إن عرَّيته من ثوبه","نبتت من جلده تلك السهام",93,"م",1,0],["أنت إن لم تحسن الرق","ص فمن يحسن عُذْرِي",94,"ر",2,0],["أنت إن قصرتَ قالوا","شاعر بالزور يُطْرِي",94,"ر",2,0],["انت اندى الورى وازكى البرايا","محتداً طلت للسماء مقاما",95,"م",2,0],["أنتَ أنتَ الحبيبُ سِراً وجَهراً","لي وإِن كنتَ في القياسِ عَدُوَّا",96,"و",2,0],["أنت أنت المعلم الصخرَ لما","طوَّح الركبُ فيهم أن يَلينا",97,"ن",2,0],["أَنتَ أَنتَ الَّذي به قَد سَعدنا","إِي وَربّي دنيا وَأخرى كذاكا",98,"ك",2,0],["انت انسي ومهجتي ونديمي","وخليلي اذا اتخذت خليلا",99,"ل",2,0],["أنت أنثى من ضياء أنت نورْ","عَزَفَتْ للقلب ألحان ِ السرورْ",100,"ر",1,1],["أنتِ إن لم تصدقي القول