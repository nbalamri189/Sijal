{"poems":[[55,"كان قضاء الإله مكتوبا","https://www.aldiwan.net/poem30741.html","المنسرح"],[79,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[95,"قصر عن أدنى علاك الحسد","https://www.aldiwan.net/poem9840.html","السريع"],[95,"حي الكنانة غدوة استقلالها","https://www.aldiwan.net/poem11126.html","الكامل"],[48,"إلهنا الحق خفف واشف من وصب","https://www.aldiwan.net/poem23395.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55132","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54560","الخفيف"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[111,"غوث الوجود اغثني ضاق مصطبري","https://www.poetsgate.com/ViewPoem.aspx?id=517",""],[92,"على الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179083",""],[92,"ثورة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=179082",""],[95,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[199,"شطت بجارتك النوى فتحمل","https://www.aldiwan.net/poem54423.html","الكامل"],[342,"صدع الظعائن قلبه المشتاقا","https://www.aldiwan.net/poem45423.html","الكامل"],[371,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[374,"روض الهوى مرتع وخيم","https://www.aldiwan.net/poem4324.html","مخلع البسيط"],[463,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[463,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[534,"يا بن البهاليل والأطواد من مضر","https://www.aldiwan.net/poem37166.html","البسيط"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103076","البسيط"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112460","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64128","المنسرح"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71036","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27136","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202730","البسيط"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97886","الكامل"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123576","الكامل"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122292","الرجز"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139687",""],[4755,"لَمَّا طَغَى المَاء..","https://www.poetsgate.com/ViewPoem.aspx?id=183533",""],[4816,"السيف والضيف والكيف","https://www.poetsgate.com/ViewPoem.aspx?id=199477",""],[4916,"ثورة احساسي","https://www.poetsgate.com/ViewPoem.aspx?id=136534",""],[4929,"أثناء مرضي","https://www.poetsgate.com/ViewPoem.aspx?id=214197",""],[5032,"القناديل الغامضة","https://www.poetsgate.com/ViewPoem.aspx?id=189645",""],[5289,"مَوْسِمُ الْكَلامِ!","https://www.poetsgate.com/ViewPoem.aspx?id=126297",""]],"verses":[["مَحَصَتِ النارُ كُلَّ شائِبَةٍ","وَزادَ لَونُ النُضارِ تَهذيبا",0,"ب",2,0],["محّصَ اللهُ فيكَ ياقوتَة المُل","كِ ويَنْبوعَ العَدْلِ والإصلاح",1,"ح",1,0],["محصول جدٍّ مخصبٍ مثمرٍ","وافقه سعدٌ وواتاه جد",2,"د",1,0],["مَحَّصْتَها تَمْحِيصَ أَغْلَى جَوهَرٍ","فِي ضَيْمِ كُلِّ مُلِمَّةٍ وَنَكَالِهَا",3,"ل",3,0],["مُحصي الجَرائِمِ فَعّالِ العَظائِمِ نَص","ارِ الهَضائِمِ جازٍ غَيرِ ظَلّامِ",4,"م",1,0],["محَصْتُ خَبَراً بَنِي دَهْرِي فَلَمْ أَرَ فِي","أَذكى الرِّجَالِ وَأَمْضَاهُمْ لَهُ مَثَلاَ",5,"ل",2,0],["مُحْصَنَاتٍ مُرَبِّيَا","تِ النَّجِيبَاتِ وَالنُّجُبْ",6,"ب",1,0],["محصلها بالكد والكدح راقب","لفوت وتفريق إليه تحور",7,"ر",1,0],["محصنين بحصن من رعايته","مستعصمين به في الصفو والكرد",8,"ر",2,0],["محّص بالتجريب أيامه","وكيِّسُ الأقوام من جربا",9,"ب",2,0],["مَحِّصْ بِعينَيْ نزيهٍ غير ذي غَرَضٍ","حالَ العراقِ وخلِّدهُ بأسفار",10,"ر",1,0],["مُحَصَّنَةً بِكْراً وَذِي الحَالُ حَالُهَا","فَيُغْوِيهِ فِيهَا أُنْسُهَا وَابْتِذَالُهَا",11,"ه",2,0],["مَحَصَّ الشَوى ما مِن يَدَيهِ يَخونُهُ","عَظمُ الشَظاة وَلا اِنتِشارُ الأَبجَلِ",12,"ل",1,0],["مَحصُ الشَوى شَنِجُ النَسى خاظي المَطى","صَحِلٌ يُرَجِّعُ خَلفَها التَنهاقا",13,"ق",2,0],["مَحصورَةٌ أَموالُهُ ما لَهُ","مَعَ اِشتِدادِ الحصرِ إِمكانُ",14,"ن",1,0],["محصنٌ بالوفاء باقٍ","تَريمُ رضوى ولا يَريم",15,"م",1,0],["محصورةٌ فيه السيادةُ نافرٌ","من شكله التوقيرُ والتعظيمُ",16,"م",1,0],["محصَّنٌ بالشكر أن","تنفُرَ منه النِّعمُ",17,"م",1,0],["مُحَصّلاتُ وِدادي ما رَضيتُ لَها","عَنْكَ الْعُدُولَ ولا أَوْلَيْتُها الْعَدَما",18,"م",2,0],["محصورة العد حقاً في مراتبها","وليس تحصى بنظم الخلق في الكلم",19,"م",1,0],["محصف الرأي جواد فطن","قد غلب الدنيا يدين قويم",20,"م",1,0],["مُحَصَّنُ الحَبِّ في جواشنَ قد","أَمِنَّ في لُبْسِها من الحرب",21,"ب",1,0],["محصورةً فيها بها منها لها","حُجُبٌ ومُحْتَجَبٌ لديها ماثِلُ",22,"ل",1,0],["مُحَصَّبُهُم قَلبي لِرَميِ جِمارِهِم","وَمَنحَرُهُم نَفسي وَمَشرَبِهِم دَمي",23,"م",2,0],["محصّنٌ بضياءٍ من مهابته","فزائف القول لا يأتي فيدخله",24,"ل",2,0],["محص من البؤساء ماضيهم","كم بائسٍ واختال من قبل",25,"ل",1,0],["مَحْصولُ وُدِّك في رِضاك مُحَصَّلٌ","شَرْحُ القصائدِ في الوُجوهِ مُلَخَّصُ",26,"ص",1,1],["محصل المنطوق والمفهوم","موسى بن عيسى الحنبلي القدومي",27,"ي",1,0],["محصَّناً في بني يس آب وفي","درعٍ من الله فيهم جاء مدَّرعا",28,"ع",2,0],["مَحَّصْتُ أَعدَاءَ قَلبي مِن أَحِبَّتِهِ","كانُوا عَدُوَّ حَبيبٍ، أَو حَبيبَ عَدُو",29,"د",2,0],["محصي لنا افعالنا بالمثاقيل","تغفر زللها وخيرها نغتنمها",30,"م",3,0],["محصور كل التعب .. من راسي لساسي","من ضيقةٍ في حنايا الصدر .. اكدّسها",31,"س",3,0],["محصورة ما بين أول شهقة","وجدِتْ وآخر زفرة بنطاق",32,"ق",1,0],["مَحْصُوبَةٌ..هلْ زَنَتْ هذي البُيُوْتُ؟متى","تَزْني النَّوافِذُ والأبْوابُ والحُجَرُ",33,"ر",1,0],["مَحْصُولُ نَبْضِي ذَوَى فِي حَقْلِ أُمْنِيَةٍº","وَرَاءَ قَرْيَةِ صَمْتٍ بِالْمُنَى كَفَرَا",34,"ر",2,0]]}