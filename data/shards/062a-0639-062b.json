{"poems":[[65,"نظرت خلال الركب والمزن هطال","https://www.aldiwan.net/poem46217.html","الطويل"],[45,"يا أخت خير أخ يا بنت خير أب","https://www.aldiwan.net/poem9460.html","البسيط"],[47,"لأية حال أعلن الوجد كاتمه","https://www.aldiwan.net/poem65658.html","الطويل"],[108,"عصفورة تتحدى النسور!","https://www.poetsgate.com/ViewPoem.aspx?id=179471",""],[173,"خلياني من وطاء ووساد","https://www.aldiwan.net/poem1619.html",""],[409,"بستان أنس به أقمنا","https://www.aldiwan.net/poem33684.html","مخلع البسيط"],[463,"إذا ذهب الوفاء من الزمانِ","https://www.aldiwan.net/poem55825.html","الوافر"],[463,"ذكرت وما وفاي بحيث أنسى","https://www.aldiwan.net/poem56157.html","الوافر"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69195","المنسرح"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79810","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53220","المتقارب"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121908","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130052","الطويل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131972","الوافر"],[4680,"مجازر الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=185033",""],[4767,"أنهار الفيض","https://www.poetsgate.com/ViewPoem.aspx?id=179964",""],[4814,"كرنفال الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=194511",""],[4929,"كفارة الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=204449",""],[5273,"جريمة","https://www.poetsgate.com/ViewPoem.aspx?id=176205",""],[5273,"شآم","https://www.poetsgate.com/ViewPoem.aspx?id=180372",""],[5574,"هارون","https://www.poetsgate.com/ViewPoem.aspx?id=205997",""],[5605,"رسائل لم تصل !","https://www.poetsgate.com/ViewPoem.aspx?id=160309",""],[5725,"ابنية العينين","https://www.poetsgate.com/ViewPoem.aspx?id=204441",""],[6052,"روضة الايمان","https://www.poetsgate.com/ViewPoem.aspx?id=35138",""],[6093,"قُرى السَّبيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=200603",""],[6142,"كم البيض بالأغماد حرى شفارها","https://www.poetsgate.com/ViewPoem.aspx?id=155749",""],[6148,"أشواق القبة الخضراء","https://www.poetsgate.com/ViewPoem.aspx?id=202096",""]],"verses":[["تَعَثَّرُ في أذيالِهِنَّ خَمائِلٌ","إذا انْسَحَبَتْ فيهِ مِن الرّيحِ أذْيالُ",0,"ل",1,0],["تَعَثَّرَت بِهِ في الأَفواهِ أَلسُنُها","وَالبُردُ في الطُرقِ وَالأَقلامُ في الكُتُبِ",1,"ب",1,0],["تَعَثَّرَ في عادٍ وَكانَ طَريقُهُ","عَلى لُبَدٍ إِذ لَم تُطِعهُ قَوادِمُه",2,"م",2,0],["تعثر الريح حين تقفو خطاها","عشراتِ الجبان في الميدان",3,"ن",1,0],["تَعثُرُ العِقبانُ في عِثيَرها","وَتَظَلُّ الشَمسُ مِنها في حِدادِ",4,"د",1,0],["تعثر فيه النسيم وَهْناً","ولم تثر للتراب نقعا",5,"ع",2,0],["تعثَّرت الجيادُ وراء جارٍ","مسلِّمةً له قَصَبَ الرِّهانِ",6,"ن",1,0],["تَعثَّر دهشةً بالبين حتى","يقلن لعاً لها فتقولُ تعسا",7,"س",2,0],["تعثُر في ثَوبِها وتعجلها","كبّةُ خَيل ريعت حَوافرها",8,"ر",3,0],["تَعثُر بِالأَوجه الحِسان من ال","قَتلى وغلّت دماً أَشاعرها",8,"ر",3,0],["تعثَّر حتَّى مات في الهام حدُّهُ","وقائمهُ في كفِّه ما تعثَّرا",9,"ر",2,0],["تعثرت فيكم بذيلي فهل","زَمَانٌ أجرُّ به فضل ردني",10,"ن",2,0],["تعثر حظى بين دهري وأهله","فلا أهله أهل ولا الدهر قائله",11,"ل",2,0],["تعثّر جيشُ الترك في سقطاتهِ","فلمّا رأى منك العناية قاما",12,"م",2,0],["تعثر في دموعه مستبيحا","لسر كان في حصن حصين",13,"ن",1,0],["تعثّرتُ في دنيا من الهمِّ والأسى","ولي خافقٌ ممّا يعانيه ذاهلُ",14,"ل",1,0],["تعثر فيه سالكهُ","وعن أهلِ الهدى افترقا",15,"ق",2,0],["تَعثّرتُ ويحيْ ببحرٍ عَتا","ومَوجٍ تُهَدهدهُ مُقلتانْ",16,"ن",1,0],["تعَثُّرُ الوَعْيِ في عُكَّازَةِ الرَّمَدِ","أَحَادَ إدراكَنَا مِنْ حيثُ لمْ يَحِدِ",17,"د",1,1],["تَعَثَّرَ بالأمنياتِ الصّباحُ","وبَثَّ فتيتَ العُطورِ الأقاحُ",18,"ح",1,1],["تَعَثَّرْتُ بالأمسِ في دَرْبِ عُمْري","تَأبَّطْتُ كُلَّ مَعاني الحَذَرْ",19,"ر",1,0],["٤- تعثَّرَ البوْحُ لا تعبيرَ يُسعِفُني","كوردةٍ خُنِقتْ في معقلِ الحِمَمِ",20,"م",1,0],["تعثرت ربما من أصل ما حملت","لا يفلح الصدق في أرض بلا عمل",21,"ل",1,0],["تعثرني وهمي وبالقلب حسرة","بأن الذي قد فات مات ببالكِ",22,"ك",1,0],["تعثّرت في متاهات الضباب خطىً","وضُيّع القصدُ في فخّ لها نصبوا",23,"ب",3,0],["تعثَّرَ النَّايُ في أنفاسِ عازفِهِ","لمَّا دَنَا عَازفٌ مِنْ مَفْرَقِ الطُّرُقِ",24,"ق",1,0],["تعثر فيه جائر السهم مغرقا","بفادحةٍ ليست يقال عثارها",25,"ر",3,0],["تعَثَّرَ عَجْزي بإعْجَازه","وقرَّظتُ دُرَّ الوَرَى بالفَحَم",26,"م",1,0]]}