{"poems":[[55,"تطاط لها فيوشك أن تجلى","https://www.aldiwan.net/poem29856.html","الوافر"],[53,"أمون من العظعاظ عند مروقها","https://www.aldiwan.net/poem65078.html","الطويل"],[53,"أعوذ بحقويك العزيزين أن أرى","https://www.aldiwan.net/poem65771.html","الطويل"],[53,"تذكرت ما سخى بنفسي عنكم","https://www.aldiwan.net/poem65858.html","الطويل"],[47,"أمرتجع مني حباء خلائف","https://www.aldiwan.net/poem62732.html","الطويل"],[30,"وما عن قلى عاتبت بكر ابن وائل","https://www.aldiwan.net/poem5507.html","الطويل"],[68,"أيا ملك العصر الذي شاع فضله","https://www.aldiwan.net/poem41353.html","الطويل"],[99,"أقبل بموكبك الأغَر","https://www.aldiwan.net/poem24760.html","مجزوء الكامل"],[71,"مولاي يا ذا المنظر الزاهر","https://www.aldiwan.net/poem29218.html","السريع"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20983","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42697","الطويل"],[154,"لكل نبي عصمة وأمانة","https://www.aldiwan.net/poem68578.html","الطويل"],[305,"لعمري ما خلفت إلا لما أرى","https://www.aldiwan.net/poem45449.html","الطويل"],[445,"هو البدر في فلك المجد دارا","https://www.aldiwan.net/poem34793.html","المتقارب"],[463,"أنبه طرفي وهو يخدع بالحلم","https://www.aldiwan.net/poem55872.html","الطويل"],[463,"أتكتم يوم بانة أم تبوح","https://www.aldiwan.net/poem56247.html","الوافر"],[466,"حماكم إله العرش من كل نبوة","https://www.aldiwan.net/poem16102.html","الطويل"],[482,"يذكرني ثناياهنلما","https://www.aldiwan.net/poem15199.html","الوافر"],[591,"عفا الله عن قوم عفا الصبر منهم","https://www.aldiwan.net/poem17715.html","الطويل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/103995","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37870","البسيط"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18504","السريع"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70673","المتدارك"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112889","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112870","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77976","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124738","الرمل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124722","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104956","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106879","الطويل"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70350","الرمل"],[561,"","https://poetry.dctabudhabi.ae/diwan/poem/145195","المتدارك"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65951","الطويل"],[2839,"","https://poetry.dctabudhabi.ae/diwan/poem/102199","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204890","الطويل"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99469","المتقارب"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101609","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87405","البسيط"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35838","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89084","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62867","المتقارب"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138623",""],[3709,"","https://poetry.dctabudhabi.ae/diwan/poem/36070","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95335","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83388","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133163","الرمل"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18814","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72489","الكامل"],[4878,"ببرج المجد قد دخل السعود","https://www.poetsgate.com/ViewPoem.aspx?id=170945",""],[4927,"حَدِيْثُ الدُّمُوْع","https://www.poetsgate.com/ViewPoem.aspx?id=29724",""],[5092,"من هناك إلى هنا","https://www.poetsgate.com/ViewPoem.aspx?id=178240",""],[592,"ألا فذراني من جهول وغاشم","https://www.poetsgate.com/ViewPoem.aspx?id=128817",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5431,"ثورتنا","https://www.poetsgate.com/ViewPoem.aspx?id=185252",""],[6159,"سبورة الفوضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85855&r=&rc=1",""],[6239,"النشيد العالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75976&r=&rc=27",""]],"verses":[["فَإِن أَخَذوا الأَقَلَّ مِنَ المَعالي","فَقَد تَرَكوا مِنَ الصَونِ الأَجَلّا",0,"ل",2,0],["فإن أخطأته استوهلتهُ لأختها","فَتَلحقه الأخرى مروعاً مُفزَّعا",1,"ع",2,0],["فإن أخطأتْني من يَمينيْك نعمةٌ","فلا تخطِئنْه نقمة من شمالكا",2,"ك",2,0],["فإن أخانا لحية الليفِ بعلُها","ألا قبَّح اللَّه الحليلة والبعلا",3,"ل",2,0],["فَإِن أُخِذَ الإيغارُ أَخذَ صَريمَةٍ","وَدارَت عَلى الإِقطاعِ دائِرَةُ الرَدِّ",4,"د",1,0],["فَإِنَّ أَخاها عَبدُ أَعلى بَنى لَها","بِأَرضِ هِرَقلٍ وَالعُلى ذاتُ مَجشَمِ",5,"م",1,0],["فَإِن أَخطَأَتني مِن نَداكَ سَحابَةٌ","فَما غَيَّرَت حُبّي وَلا أَوجَبَت تَركي",6,"ك",2,0],["فأنا خيالك أتبعُك","ظمآن أرشف ما تجود",7,"د",1,0],["فإن أُخالفْ لم يلقَ بي وإنْ","أطعتُ أخشى هزأةَ الناظرِ",8,"ر",1,0],["فأن أخطَأتُ أو أوهَمتُ أَمراً","فقد يَهِمُ الُمصافي بالَحبيبِ",9,"ب",1,0],["فَإِنْ أَخْلَفَتْ نَفْسٌ طَوِيَّةَ مَا وَأَتْ","فَلِي مِنْ عَلِيٍّ صَاحِبٌ غَيْرُ مُخْلِفِ",10,"ف",1,0],["فَإِن أُخِّروا وَقتاً فَقَد قُدِّموا فَضلا","أَطاعوهُ فاِستَخذى لَهُم كُلَّ سَيِّدِ",11,"د",1,0],["فَإِن أَخطَأَت نَبلاً حَداداً ظُباتُها","عَلى القَصدِ لا تُخطِئُ كِلاباً ضَوارِيا",12,"ي",2,0],["فَإِنْ أَخْطَأَتْهُ كُؤوسُ المنايا","لقد خَلَّدَتْ فِي حَشاهُ خُمارا",13,"ر",2,0],["فإن أخَّرتْك باقياً وتقدَّمتْ","بلا جزع لاقته فيك ولا إثمِ",14,"م",1,0],["فإن أخرستَ ريبَ الدهر عنّي","بعونك والنوائبُ بي تَصيحُ",15,"ح",1,0],["فإنْ أخلفتْ ظَني اللياليِ فسلوةً","بأروعَ مَعْسولٍ شمائلُهُ تَحْلو",16,"ل",2,0],["فاِنَّ أخا الغرامِ إذا تمادىَ","بهِ داءُ الهوى أمسى يُعانُ",17,"ن",1,0],["فإِنّا خَبَّرَتْنَا عَنْ رِضَاكُم","أمانينا بِأَنَّكُمُ كِرامُ",18,"م",1,0],["فإن أخذت ريها أرضعت","بَنيها بثدي هُو الإثمدُ",19,"د",1,0],["فَإِنْ أَخَذتُم لِعكّا بِالقتالِ نَنَلْ","ما كانَ فيهِ لَنا إِرْبٌ وَتَأميلُ",20,"ل",1,0],["فَإِنَّ أَخوالَكَ لَم يَبرَحوا","يُربُونَ بِالرِفدِ عَلى الرافِدِ",21,"د",1,0],["فأناخوا بطَيبةَ كلُّهمُ","بأمانِ المهيمْنِ عز وجلّْ",22,"ل",1,0],["فإن أخا الاشواق يطرب قلبه","بكاء حمامات لهن هدير",23,"ر",1,0],["فان أخذت فذاك الفضل أجمعه","وإن أخذت الوصايا فاسمعن جملى",24,"ل",2,0],["فإن أَخذت بقولي فزت يوم غد","وإن أَبيت فرب العرش يجزيني",25,"ن",2,0],["فإن اختارته كانت عنده","زوجةً في عيشة الغض الرغد",26,"د",1,0],["فإن اختفى فاستفرغوا أيامه","كملا كذلك قال ذو الخبر",27,"ر",1,0],["فإن أخَّرَ الله الظهور لحكمة","به سبقت في علمه وله الأمر",28,"ر",1,0],["فإن أخلصت سلمى له النصح ردها","ثقيلاً عليها ناهياً متمردا",29,"د",2,0],["فإن اخترتم عذابي","لا أبالي لا أبالي",30,"ل",2,0],["فأناخ الموت كلاكله","بظباك على بشر رجس",31,"س",1,0],["فإن أخانا لم يغب غير شخصه","وآثاره في كل غور وأنجد",32,"د",1,0],["فإن أخذت طريقا في مخاصمتي","تجد هزيراً لروح الخصم منتزعا",33,"ع",2,0],["فان أخطأت في خط شعري ووزنه","فما في الهوى ذنب على أنمل الصب",34,"ب",1,0],["فإن أخدشت قرطست بالمنى","وإن تممت ولدت عقعقا",35,"ق",2,0],["فأنا خالدٌ بشعري على رغم","زمانٍ عن قيمة الشعر يغضي",36,"ض",2,0],["فان أُخاطِب ولم يُجِبني","مُخاطَبي تُبتُ عن خطابي",37,"ب",2,0],["فَإِنَّ اِختِبارَ المَرءِ قَبلَ اِختِيارِهِ","جِبِلَّةُ لُبٍّ في المَعارِفِ ثاقِبِ",38,"ب",1,0],["فإن أخا الحسنى هو الحي ميتاً","كمثل علي القدر حي المحامد",39,"د",1,0],["فانَّ أَخا الحَربِ مُسْتَيقِظٌ","اذا هي نامتْ له لم يَنَمْ",40,"م",1,0],["فإن أخذت منهم جنازته فهل","تولت عليها بعد ذاك أحباه",41,"ا",2,0],["فَإِن أَخَذَت عَيني مَحاسِنَ وَجهِهِ","دُهشتُ لِما أَلقى فَيملكُني الحَصَر",42,"ر",1,0],["فإن أخذت الثلث منهم فاضمم","إلفا حروف الحلق فافتح وافهم",43,"م",1,0],["فإن أخيل وقل له","أفطر قل حدسك ليس يحدسي",44,"ي",1,0],["فَأَنا خَديمُ الآلِ آلِ محمّدٍ","وَعلى مودَّتِهِم وَقَفتُ حَياتي",45,"ي",1,0],["فأنا خدان المضاجع والهٌ","مستهام القلب في ذاك الرشي",46,"ي",1,0],["فَإِنَّ أَخِلّاءَ اِبنَ زَينَبَ أَصبَحوا","شَتاتَ النَوى مِن مُصعِدٍ وَمُفَرِّعِ",47,"ع",1,0],["فأناخ في أعشار قلب أليفه","والهم عن قلبي لدى تشريفه",48,"ه",1,0],["فإن أخذ الأنام بكل فن","لهم تبديه في العليا يسودوا",49,"د",3,0],["فَإِنْ أَخْلَفَ الأَحْبَاْبُº أَوْفَىْ عُهُوْدَهُمْ","وَخَاْلَفَ مَنْ ظَنَّ الْغَرَاْمَ تَخَلُّفَاْ",50,"ف",2,0],["فإنْ أخطأتُ في بوحي","لسانُ الصمتِ صَحّاحُ",51,"ح",1,0],["فإن أخطئوا يوماً وعابوا لمن على","مذاهب أشياخ هداة أكارم",52,"م",1,0],["فإن اختصار القول في ذاك أننا","نقول كما قال الأئمة ذو الرشد",53,"د",1,0],["فإن أخذت حياة لم نلمها","وإن سلخت لحوما عن عظامِ",54,"م",1,0],["فأناخ مرآةَ الأسى ، وعيونهُ","هذي مُصدِّقَةٌ وتلك مُكَذِّبَةْ",55,"ب",2,0],["فانْ أخَّرتْكِ الرِّيحُ عنِّي فإننَّي","أؤخّرُ كفَّ الموتِ عنِّي ثوانيا",56,"ي",2,0]]}