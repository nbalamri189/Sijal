,"إذا لم يكن معنى حديثك لي يدرى","https://www.aldiwan.net/poem69370.html","الطويل"],[569,"ولو شئت أبديت نميهم","https://www.aldiwan.net/poem52018.html","المتقارب"],[575,"أيدفعني الدهر عن مطلبي","https://www.aldiwan.net/poem2750.html","المتقارب"],[575,"دع قضب نعمان أو كثبان يبرين","https://www.aldiwan.net/poem2851.html","البسيط"],[575,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"],[575,"أرى كل شيء في البسيطة قد نما","https://www.aldiwan.net/poem3021.html","الطويل"]],"verses":[["وَلَو شِئتُ جَلّى بي إِلى غايَةِ العُلى","جَوادي وَلَكِنّي أَرُدُّ عِناني",0,"ي",1,0],["وَلَو شِئتَ لَمّا طالَعَتكَ رِماحُهُم","وَأَطرافُها عوجٌ إِلَيكَ دَواني",0,"ي",1,0],["وَلَو شُوِّرَ السَيفُ في مِثلِها","لَقالَ أَطِعني وَلا تَقبَلِ",1,"ل",1,0],["وَلَو شِئتُ غَنَّتني الحَمامُ عَشيَّةً","وَلَكِنَّني مِن ماءِ عَينَيَّ أَشرَبُ",2,"ب",1,0],["وَلَوْ شَاءَ قَوْمِي لَمْ يَبُلَّ عَدُوُّهُمْ","غَليلَ الصَّدى إِلَّا بِسُؤرِ المَوارِدِ",3,"د",1,0],["ولو شاءَ غادَرَ أشْلاءَهُ","يُحيّي الضِّباعَ بِها الأذْؤُبُ",4,"ب",1,0],["ولو شِئْتُ إدراكَ الغِنى بالْتِماسِهِ","زَجَرْتُ على الأيْنِ المَطِيِّ المُخَرَّما",5,"م",2,0],["ولو شِئْتُ إِرهاقَ الحُلِيِّ أجَارَني","مُسَوَّرُهُ منْ جَرْسِها والمُخَدَّمُ",6,"م",1,0],["وَلَو شِئتُ مِلتُ إِلى غَيرِها","إِلى مَن يَكونُ بِوُدّي ضَنينا",7,"ن",2,0],["ولو شئت في طي الكتاب لزرتكم","ولم تدر عني أحرف وسطور",8,"ر",1,0],["وَلَو شِئتُ ما أَعرَضتُ حَتّى أَصَبتُهُ","عَلى أَنفِهِ خَدباءَ تَعضِلُ بِالآسي",9,"ي",1,0],["وَلَو شِئتُ أَذهَلتُ النُجومَ عَنِ السُرى","وَعَطَّلتُ أَفلاكاً بِهِنَّ تَدورُ",10,"ر",1,0],["وَلَو شِئتِ راجَعتِ حُرَّ الفَعالِ","وَعُدتِ لِتِلكَ السَجايا الأُوَل",11,"ل",1,0],["وَلَو شاءَ كانَ الغَزوُ مِن أَرضِ حِميَرٍ","وَلَكِنَّهُ عَمداً إِلى الرومِ أَنفَرا",12,"ر",2,0],["وَلَو شِئتُ قَصَّرتُ النَهارَ بِطَفلَةٍ","هَضيمِ الحَشا بَرّاقَةِ المُتَبَسَّمِ",13,"م",1,0],["ولو شئت كايَلْت الذين أنطَوَوا بها","على الحِقد صاعاً بالعِداء فصاعا",14,"ع",2,0],["ولو شئت أرسلت الخَديعة خلفه","تطارده حتى تضيق مذاهبه",15,"ب",2,0],["ولو شكت الحقيقة لانتزعنا","شكايتها بتضحية المجاز",16,"ز",1,0],["وَلَو شاءَ الأَطِبَّةُ أَخبَروني","بِداءٍ في قُلوبِهِمِ المِراضِ",17,"ض",1,0],["وَلَو شَهِدَت يَومَ الوَقيطَينِ خَيلُنا","لَما قاظَتِ الأَسرى القِطاطَ وَلَعلَعا",18,"ع",2,0],["وَلَو شاءَت أُمامَةُ قَد نَقَعنا","بِعَذبٍ بارِدٍ يَشفي السَقاما",19,"م",2,0],["وَلَو شَهِدَتنا بِالمُزاحِ لَأَيقَنَت","عَلى ضُرَّنا أَنّا كِرامُ الضَرائِبِ",20,"ب",1,0],["وَلَو شِئنا حَمَيناها البَوادي","كَما تَحمي أُسودُ الغابِ غابا",21,"ب",2,0],["وَلَو شَهِدَ البَطحاءَ مِنّا عِصابَةٌ","لَهانَ عَلَينا يَومَ ذاكَ ضِرابُها",22,"ب",3,0],["ولو شئت قسمت الذوائبَ مقسماً","بطيب ليالٍ من ذوائبها عشر",23,"ر",1,0],["ولو شفعتك المكرمات بآخر","لما باتَ شاكي الدهر منه على وتر",24,"ر",1,0],["ولو شاء أغناه عن الجيش ذكره","ورُبَّ حسامٍ هازم بطنينه",25,"ن",2,0],["ولو شهد الشبابُ إذاً لراحتْ","وإن بها وعيشك ضِعْفَ مابي",26,"ب",2,0],["ولو شئتَ أطعمتَ المنية رُوحه","بأدنى غلامٍ أو بأصغر قائدِ",27,"د",1,0],["ولو شئتَ ساجلت البحور غزارةً","وبادهتَ قرض الشعر جِنَّة عَبقرا",28,"ر",2,1],["ولو شئتُ لم تَذهب على حُوَّليَّتي","هَناتٌ لأسماء الرجال شواهر",29,"ر",1,0],["ولو شئت ماطلتُ القوافيَ جريها","مدى ما تمادى شأوُها المتنفسُ",30,"س",1,0],["ولو شئتُ روَّيْتُ الجفون من الكرى","وألجأتُ أعطافي إلى جسدٍ بضّ",31,"ض",1,0],["ولو شِئتُ أن أطغى على الناس كُلّهم","طغوت بمجد واسع الطول والعرض",32,"ض",1,0],["ولو شئتَ لاحتجَّت عليك براءتي","بما ليس فيه إن تأملت من رَحض",32,"ض",1,0],["ولو شِئْتَ قلت أقِمْ راشداً","فلا ذنبَ لي بل لحرْمانِكا",33,"ك",2,0],["ولو شئت شبَّهتَ الذي أستحقُّه","بحالك هاتيك الجليلة لا حالي",34,"ل",2,0],["وَلَو شاءَ لَم يَختَر سِوى الشَرَّ مَركَباً","فَقَد كانَتِ الأَحقادُ مِلءَ الحَيازِمِ",35,"م",1,0],["وَلَو شاهَدَ العِجلِيُّ جَدواهُ ما اِنتَمى","لِعِكرِمَةَ الفَيّاضِ يَوماً وَحَوشَبِ",36,"ب",1,0],["وَلَو شاءَت حَياتي الدَهرَ سَقَّت","حَرورَ القَلبِ مِن شَبَم قُراحِ",37,"ح",1,0],["ولو شئت جاءتني المعالي مطيعة","ولكن وجدت الصبر أعذب موردا",38,"د",2,0],["ولو شُقَّ عن سوداءِ قلبي وفتشتْ","جوانبُه لم يُلْفَ إلّا هواكُما",39,"م",2,0],["ولو شَذَّ عن حكمِ المقاديرِ كائنٌ","لما دَرَتِ الأقدارُ ما هو صانِعُ",40,"ع",1,0],["وَلَو شاوَرَ الأَيّامَ قَبلَ خُروجِهِ","نَهَينَ اِبنَ أُمِّ الكَلبِ أَن يَتَوَرَّدا",41,"د",2,0],["وَلَو شَهِداني أَشهَداني عِنايَةً","تَعودُ بِحَقّي أَو تُبَلِّغُني عُذري",42,"ي",1,0],["وَلَو شاهَدَ الدُنيا وَجامِعَ مُلكِها","لَقَلَّ لَدَيهِ ما يُكَثِّرُ مِن مِصرِ",43,"ر",1,0],["وَلَو شِئتَ طاحوا بِالسُيوفِ وَبِالقَنا","وَبِاللَهذَمِيّاتِ المُذَرَّبَةِ الزُرقِ",44,"ق",1,0],["وَلَو شِئتِ يَومَ الجِزعِ بَلَّ غَليلَهُ","مُحِبٌّ بِوَصلٍ مِنكِ إِن أَمكَنَ الوَصلُ",45,"ل",1,0],["وَلَو شاءَ إِذ تَركُ المَشِيَّةِ سُؤدُدٌ","لَأَشوَتهُ يَومَ الهُندُوانِ نِبالُها",46,"ل",3,0],["وَلَو شِئتُمُ أَن تَستَثيروا اِستَثَرتُمُ","عِجالاً وَلَكِنَّ الكِرامَ كِرامُ",47,"م",1,0],["وَلَو شَعَرَ الأَجبالُ دَمخٌ وَيَذبُلٌ","لَمالا بِأَعرافِ الذُرى وَالمَناكِبِ",48,"ب",1,0],["وَلَو شِئتُ قَدَّ السَيفُ ما بَينَ أَنفِهِ","إِلى عَلَقٍ تَحتَ الشَراسيفِ جامِدِ",49,"د",1,0],["وَلَو شاءَ يَعسوبُ الطَفاوَةِ أَصبَحَت","رِواءً بِجَيّاشِ الخَسيفَةِ أَقمَرا",50,"ر",2,0],["وَلَو شَهِدَت بَني ذَهَلٍ لَحاموا","عَلى أَحسابِ ضَبَّةَ أَن تُضاعا",51,"ع",2,0],["وَلَو شاءَ إِذ وَلّى الكَتائِبُ حَولَهُ","تَعالى عَلى باقي العُلالَةِ مِرجَمِ",52,"م",1,0],["وَلَو شاءَ تَحريماً عَلى كُلِّ مَعشَرٍ","لَقالَ رَسولُ اللَهِ لا يُغرَسُ الكَرمُ",53,"م",1,0],["وَلَو شاهَدَت عَيناكَ وَجهُ مُعَذِّبي","وَقَد زارَني بَعدَ القَطيعَةِ وَالهَجرِ",54,"ر",1,0],["وَلَو شِئتُ نَهضي إِلى قَصدِكُم","لَخَفَّفتُ عَن ظَهرِيَ المُثقَلِ",55,"ل",1,0],["ولو شِئتُ يوماً لانتصرتُ بِمِقْوَلٍ","يُحِيلُ على الأغراض حدّ السكاكين",56,"ن",1,0],["ولوْ شئتُ عَقْدَ الخصرِ منه لحضّني","عليه تَشَنّي خيزرانِ قوامهِ",57,"م",2,0],["ولو شامَ هاروتٌ وماروت طَرْفَهُ","لَما أَصبَحا إِلّا قَنيصيْ حبائِلِه",58,"ل",2,0],["ولو شُقّقَتْ تلكَ القبورُ لأنهَضَتْ","إِلَيهِم مِنَ الأَحداثِ أُسداً عَوابِسا",59,"س",2,0],["وَلَو شيتُ لَمّا اِلتاثَ بِرّي عَلَيهِم","وَلَم يَكُ إِجمالاً لَكانَ تَجَمُّلا",60,"ل",2,0],["وَلَو شاءَ رُمحي سَدَّ كُلَّ ثَنِيَّةٍ","تُطالِعُني فيها المَغاويرُ وَالجُردُ",61,"د",1,0],["ولو شئتُ فقتُ الكلَّ حرصاً وجرأةً","فأُرضي بجمعي وأرثي وأَغضب",62,"ب",1,0],["وَلَو شِئتُ رُعتُ القِرنَ وَالبيدُ بَينَنا","بِصَهلَةِ خَوّارِ الأَعِنَّةِ ضامِرِ",63,"ر",1,0],["وَلَو شَهِدَتني حينَ تَحضُرُ ميتَتي","جَلا سَكَراتِ المَوتِ عَنّي كَلامُها",64,"م",3,0],["ولو شاءَ لاجْتثَّهم أجمعين","فبادت أصولٌ وجفّتْ عُروقْ",65,"ق",1,0],["وَلَو شاءَ قَلبي باعَ غَيرَكِ فَاِقتَضى","وَلَكِنَّهُ يَأَبى وَأَنتِ مَطُولُ",66,"ل",1,0],["وَلَو شاءَ وارى الشَمسَ مِن دونِ وَجهِهِ","حِجابٌ وَمَطوِيُّ السَراةِ مُنيفُ",67,"ف",1,0],["وَلَو شِئتَ لَقَد صِرتا","إِلى حَظٍّ وَقَصَّرتا",68,"ت",2,0],["ولو شاءَ مَدَّ النِّيلَ سَيْلُ دمائِهِمْ","وَزَفَّتْ نُحُورٌ ماءَهُ وسُحُورُ",69,"ر",1,0],["ولو شِئْتُ لم تبْعُدْ عليّ خِيامُها","ولو طُنِّبَتْ بين النُّجومِ العواتم",70,"م",1,0],["ولو شَهِدوا الأيامَ والعيشُ بعدهم","حدائقُ والآمالُ مونِقَةٌ خُضْر",71,"ر",1,0],["وَلَو شَهِدتَ أَخي يَوماً نَعِمتُ بِهِ","وَعِندَنا قَمَرٌ نَجلو بِهِ الظُلُما",72,"م",2,0],["وَلَو شِئتَ اِكتَفَيتَ إِلى نَعيمٍ","وَقاسى الأَمرَ دونَكَ آخَرونا",73,"ن",2,0],["وَلَو شِئتُ قَد دارَت بِذي قَرقَلٍ يَدي","مِنَ اللَمسِ إِلّا مِن يُدَيِّ حَصانِ",74,"ن",1,0],["وَلَو شِئتِ تَمَتَّعنا","وَإِن سَبَّحَ يَعقوبُ",75,"ب",1,0],["وَلَو شاءَ مَن صاغَ النُجومَ بِلُطفِهِ","لَصاغَهُما كَالمُشتَري وَدَعانِ",76,"ن",1,0],["ولو شمْسُ الضّحى قَدَرَتْ لعادتْ","مُشَرِّقَةً إذا رأتِ الزّوالا",77,"ل",2,0],["وَلَو شَهِدَ الفَوارِسُ مِن نُمَيرٍ","بِرامَةَ أَو بِنَعفِ لِوى القَصيمِ",78,"م",1,1],["ولو شئتُ راهنتُ الصَّبابَةَ والهَوى","وأَجريتُ في اللَّذَّاتِ مِن مِئتينِ",79,"ن",1,1],["وَلَو شاء سعد مزق الشعب لحمه","ولكنَّ سعداً قلبه راحمٌ يأبى",80,"ب",2,0],["وَلَو شئت أرهفت ردعاً له","يراعي فكان بكفي حساما",81,"م",2,0],["وَلَو شئتَ أحضرت الشهود فربما","إذا أبصروا ما بي من الضر أَقلَعوا",82,"ع",3,0],["وَلَو شِئتُ غَمَّ التَيمَ عَمروٌ وَمالِكٌ","وَطَمَّ عَلَيهِم قُمقُمانٌ مِنَ البَحرِ",83,"ر",1,0],["ولو شئنا جزيناه ونرضي","شمائلنا فنوسعه سماحا",84,"ح",2,0],["ولَو شِئتُ عَلَى مَق","دِرةٍ مِنَّي لَعاقبَتُ",85,"ت",1,0],["وَلوْ شِئْتِ قَالَ الْحُبُّ إِمْرَةَ قَادِرٍ","لِمُجْدبِ هَذَا العَيْشِ أَزْهِرْ وَأَمْرِعِ",86,"ع",1,0],["وَلَوْ شِئْتُ تعْدَاداً لأَوْصَافِ آلِهِ","لأَطْرَبْتُكُمْ بِالْحَقَّ لاَ بِالتَوَدُّدِ",87,"د",1,0],["وَلَو شِئتُ الجَوابَ أَجَبتُ لَكِن","خَفَضتُ لَكُم عَلى عِلمٍ جَناحي",88,"ح",2,0],["وَلَو شاءَ عافى وَجهَكَ الحَسنَ الَّذي","تَوَرَّمَ حَتّى خِفتُ أَن يَتَخَذَّذَا",89,"ذ",2,0],["ولو شهدته تغلب بنت وائل","لكانوا له عزاً عزيزاً وناصرا",90,"ر",2,0],["ولو شئت حملت برقية","تُزَفُّ لكم من رجيف الضُّلوع",91,"ع",1,0],["ولو شَاءَ الإمامُ أَقامَ سوقاً","فباعهمُ كما بيعَ السَّمادُ",92,"د",1,0],["وَلَوْ شَاءَ، إذْ تَرْكُ المَشيئَةِ سُؤدَدٌ","لأشْوَتْهُ، يَوْمَ الهِنْدُوَانِ، نِبَالُها",93,"ل",3,0],["ولو شُقّقَتْ تلكَ القبوُر لأنهَضَتْ","إليهم من الأجداثِ أُسْدا عوابِسا",94,"س",2,0],["ولو شهدت حور الجنان مدامعي","ترشّفن في هول الحساب غروبي",95,"ب",2,0],["ولو شاء ان تجنيه من غير هزها","ومن غير اعمال الوسائل والتعب",96,"ب",1,0],["ولو شئت أطربت الصحاب عيشيةً","ولكن قلبي يا سمير طعين",97,"ن",1,0],["ولو شئنا لكان النصف","لكن فيه تصعيب",98,"ب",1,0],["ولو شاء قصَّر باعَ الردى","فلم يرمِهِ الساعدُ النازعُ",99,"ع",1,0],["ولو شئتُ أرسلتُها غارةً","تعود إلىَّ بأسلابها",100,"ب",3,0],["وَلَو شِئتَها كانَت لَدَيكَ سَوابِقٌ","لِلَحقِ العِدى لا لِلفِرارِ تُقَرَّبُ",101,"ب",1,0],["وَلَو شِئتَ ما مُدَّ لِلمارِقينَ","وَأَشياعِهِم دونَ قافٍ طُنُب",102,"ب",1,0],["وَلَو شاجَروكَ القَنا ضَلَّةً","لَطَمَّ عَلى الخَبَرِ المُختَبَر",103,"ر",1,0],["وَلَو شِئتَ تَدويخَ المَمالِكِ سُرعَةً","لَكُنتَ بِها أَغرى مِنَ النارِ بِالحَلفا",104,"ف",2,0],["وَلَو شِئتَ لَم تَترُك لِبيضٍ مِنَ الظُبى","وَزُرقٍ مِنَ الخِرصانِ في مُهجَةٍ رِزقا",105,"ق",2,0],["ولو شمّت الأعلام في الدرس ريحها","لما طاش عن صوب الصواب لها فكر",106,"ر",1,0],["ولو شئتِ لمّا أزمع الحيُّ رَوْحَةً","أشرتِ إلينا بالبنانِ المُقَمَّعِ",107,"ع",1,1],["ولو شاهدوا ليلى وطول امتداده","لما قال قوم كلُّ شيء له حدُّ",108,"د",1,0],["ولو شاء لا يعطى لا ظهر ما به","تحن إلى التقوى العصاة وترغب",109,"ب",1,0],["ولو شاءَ مولانا الوزيرُ لكفّني","وأبلعَني رِيقي ونفّسَ من كربى",110,"ب",2,0],["وَلَو شاءَ جازى بِالعُقوبَةِ قُدرَةً","وَلَكِن لَهُ مِن خَشيَةِ اللَهِ رادِعُ",111,"ع",1,0],["وَلَو شِئتُ قَد كُنتُ المُدارى لِأَنَّني","أَصُولُ بِأَيدٍ في الأَنامٍ طِوالِ",112,"ل",1,0],["ولو شئتُ أَخْفاه الخِضابُ وإنما","أنا أتّقى من أنْ يُداخِله غش",113,"ش",1,0],["وَلو شاءَ أَرداهُم ولَم يخشَ ثَأرهم","وهَل أَحدٌ يَخشى منَ العدمِ الثَأرا",114,"ر",2,0],["وَلَو شاءَ عكسَ الأمرِ لَم يعُد عدله","وَلكن بِفضلٍ منهُ لا يعكسُ الأمرا",114,"ر",2,0],["وَلَو شَرِبوا أَضعافَ ما فيه من دمٍ","لَما كانَ يرويهِم وَلو قَد جَرى نَهرا",114,"ر",2,0],["وَلَو شُرعَ التطليقُ فيهم لطلّقوا","وَعُوّض كُلٌّ من بغيضٍ له خيرا",114,"ر",2,0],["ولو شئتَ لم يدروا بما دارَ بيننا","ولو أن حسادي عليكَ من الجانِ",115,"ن",1,0],["ولو شئتُ عرَّفتُه مَن أنا","وإن كانَ لي جيِّد المعرفَه",116,"ف",2,0],["ولو شوى بالقلا فؤادي","ما مال عنه ولا قلاه",117,"ا",2,0],["ولو شهدوا حَالَيْكَ في السِّلم والوَغَى","لفدَّاك مسرورا لُؤَيٌّ وهاشم",118,"م",1,0],["ولو شئتُ عاودتُ الصِبا واستفزَّني","من الغِيد مكحولُ الجفون غَرير",119,"ر",1,0],["ولو شاء أن يرقى السموات إذ له","على كتف الهادي البشير ترفع",120,"ع",1,0],["وَلَو شِئتَ حَكَّمتَ الأَسِنَّةَ فيهُمُ","وَبَلَّت صَداها الهِندُوانِيَّةُ البُترُ",121,"ر",1,0],["ولو شاء الوزير ولم يزل لي","صلاحي في مشيئات الوزير",122,"ر",1,0],["ولو شاهدت ما القاه حقا","جننت وما الهوى إلا جنون",123,"ن",1,0],["ولو شربت حمامي كان أعذب من","عذاب طول حياة كلها نصب",124,"ب",1,0],["ولو شِئتِ يا حَسناءُ كُنتِ مليكةً","فحسنُكِ هذا للأريكةِ والمُلك",125,"ك",1,0],["وَلَوْ شِئْتُ إِذ رابَنِي ما يَرِيبُ","هَزَزْتُكَ هزَّ الْحُسامِ الْيَمانِي",126,"ي",1,0],["وَلَو شئتُمُ ما فرَّق البينُ بيننا","ولا عنَّ طَيرٌ للتفرُّقِ أَشأمُ",127,"م",1,0],["وَلَو شاء أَرعى الذئب للشاءِ أمره","وَلكن رأى التكليفَ للعجمِ لا يحبى",128,"ب",2,0],["ولو شاء ربي لما راعنى","بها كل حين كأني رجيم",129,"م",1,0],["ولوْ شَاءَ نَجَّاهُ من الخَيْل سابِحٌ","جَمُومٌ على السَّاقَينٍ والسَّوْطُ مُفْضَلُ",130,"ل",1,0],["وَلَوْ شِئْتُ لاستنجدْتُ عَزُمةَ جَلْدَكٍ","وَحَارَبْتُ دَهراً لا أَزالُ أُسالِمُه",131,"م",2,0],["وَلَو شَهِدَ الوَرى غَيبي","بِعَينٍ لي بِهِ شَهَدوا",132,"د",3,0],["وَلَو شاء يَبلو السمهريّة لاِعتلى","بِها الهام مِنها وَاِبتَلى العين بِالعينِ",133,"ن",1,0],["ولو شِئْتُ أَيضاً رَدَّ شَعريَ حالكاً","وجلْدةَ وجهي غيرَ ذاتِ غُضون",134,"ن",1,0],["ولو شهِدَتْ فُرسانُ قَومي لأَوْقروا","قَرا الأرضِ دُوني بالقَنا المُتحَطِّم",135,"م",1,0],["ولو شغَل الكَرى باللّيلِ عَيْني","رأيتُ لها بها عنها اشْتِغالا",136,"ل",2,0],["ولو شغَل الكرَى باللّيلِ عَيْني","جَعلْتُ لها بها عنها اشْتِغالا",137,"ل",2,0],["ولو شَرَطَتْ روحي ثَوابَ مَسيرِها","فما قَدْرُ روحي في الوفاءِ بشَرْطها",138,"ط",3,0],["وَلَو شَرَعَ الناسُ المُواساةَ في الهَوى","لَكُنتُ أُواسَى أَو لَكُنتُ أُواسي",139,"ي",1,0],["ولَو شِئتُ أنذَرتُ القُلوبَ بِحدِّه","فقُلتُ ولكِن أتركُ القَولَ مُبهَما",140,"م",2,0],["وَلَو شِئتَ لَم تَخلط وِصالاً بِهَجرةٍ","كَما شيبَ بِالماءِ الزلال حَميم",141,"م",1,0],["ولو شمّت روائحه الروابي","لما احتفلت بوردٍ أو خزامى",142,"م",2,0],["وَلَو شئتَ أَدركت أَن الجَوا","د في السلم غَير منيع السلب",143,"ب",1,0],["ولو شاء كشف الضرّ فرّق جمعه","وما فارق العضبَ اليماني قرابه",144,"ب",2,0],["ولو شاءَتْ صوارِمُهُ المواضي","أقامَتْ دونَهُم سوراً وبابا",145,"ب",2,0],["ولو شاءَتْ لأغناها كمينٌ","يثورُ فيَبْلُلُ البطلُ الكميُّ",146,"ي",1,0],["ولو شئت أن أحصي أياديك بالني","بعثت بها نحوي لرحت مقصّرا",147,"ر",2,0],["ولو شاهَدَتْنِي والصَّواخِدُ تَلْتَظِي","عَلَيَّ ورقراقُ السراب يَمُورُ",148,"ر",1,0],["ولو شِمْتَ سَيفَكَ فِي صَدْرِ كِسْرى","وَقَيصَرَ بَيْنَ الطُّلى والوريدِ",149,"د",1,0],["ولو شئتِ أودَعتُ القصائد مُهجتي","على الرملِ الواناً وأطلقتها سَكرىَ",150,"ر",2,0],["ولو شريتُ ساعةً منك بما","بين ضلوعي ما شكوت الغبنا",151,"ن",2,0],["ولو شئت أن تعطي علاءك حقَّه","سموتَ فخاطبتَ الكواكبَ من علُ",152,"ل",1,0],["ولو شئتُ ما ضاع فيَّ العتابُ","فإنكِ لا تنقلين الطباعا",153,"ع",2,0],["ولو شئت بي أخفَى زهيرٌ ثناءهُ","على هَرِمٍ أيّام تُجزَى الصنائعُ",154,"ع",1,0],["ولو شاء لم يجْمعْ لحربٍ كتيبةً","وعسكرُه التوفيقُ واللّهُ ناصِرُهْ",155,"ر",2,1],["ولو شاء أغنتهُ ركائب عزمهِ","إلى الأمر أنْ يُزجي المطيَّ المُخرَّما",156,"م",2,0],["ولو شئت في تلك السيوف قطيعة","لردت إلى الأعناق وهي سلاسل",157,"ل",1,0],["ولو شاهد المأسوف عنه جنابكم","مناهضة الأحرار أسكره البشر",158,"ر",1,0],["ولو شرى عاشق وصل الحبيب بما","يرضيه من ملكه والروح والسحج",159,"ج",1,0],["ولو شاء الزمان قرار جاشي","لأسمعني نداء أخ مصاف",160,"ف",1,0],["ولو شاء يوم الجمعة الفتك بالعدى","لرضت جباه منهم وخدود",161,"د",1,0],["ولو شكرت لياليهم محافظة","لعهدها لم يكن بالعهد من قدم",162,"م",1,0],["ولَو شئتَ حكّمتَ الصّوارمَ فيهمُ","وسُمراً طِوالاً للنُّحُور هواتكا",163,"ك",2,0],["ولو شئتُ والحاجاتُ منّي قريبةٌ","منعتُ بياضَ الشيبِ أخذَ مفارقي",164,"ق",2,0],["وَلَو شِئتَ لمّا أنْ تَرَيّبتَ منهمُ","وَراموا الّذي لا يُرتَضى وتولّعوا",165,"ع",3,0],["ولو شئت لمّا تيسّرْن لِي","لنالتْ يداي المحيط المُدارا",166,"ر",2,0],["ولو شئتُ حلّتْ ربقةُ المال في يدي","ما نفعُ مالٍ دون عورتِه سِترُ",167,"ر",1,0],["ولو شئتُ أضحى بين دارِي وبينهمْ","بساطٌ بعيدٌ لِلمطايا وَبرزخُ",168,"خ",1,0],["ولو شاء أبدى في فناهم وجوده","وأسمعهم بالنفخ فيهم يراعه",169,"ع",2,0],["ولو شَهدوا معنى جمَالِكَ مثْلما","شهدْتُ بعينِ القلبِ ما أنكروا الدَّعوى",170,"و",2,0],["وَلَو شئت أبديت نميهم","وأَدخلت تحت الثياب الابر",171,"ر",1,1],["ولو شئتُ كَان لَديَّ الهِلالُ","بِنَهْرِ المجرَّةِ كالمركب",172,"ب",1,0],["ولو شريتُ بِنَفْسِي لَثْمَ مَبْسمِه","لكنْتُ أَعْلَمُ أَنِّي غير مغبون",173,"ن",1,0],["ولو شئتَ كانَتْ من هِباتِك إِنما","لَك الشمسُ دينارٌ لك البدرُ دِرْهَمُ",174,"م",1,0],["ولو شَاءَ أَن يُغنِي الخلائقَ كلَّهم","لولاَّكَ أَرْزاقَ العِبادِ مُقَسِّما",175,"م",2,0]]}