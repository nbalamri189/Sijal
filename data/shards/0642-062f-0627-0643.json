ae/diwan/poem/200330","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72509","الطويل"],[4767,"زرقة السماء","https://www.poetsgate.com/ViewPoem.aspx?id=180059",""],[4852,"ليت أسرقه","https://www.poetsgate.com/ViewPoem.aspx?id=214321",""],[5183,"مأساة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=186493",""],[5187,"حكايتي مع الناس","https://www.poetsgate.com/ViewPoem.aspx?id=33008",""],[5358,"ناصية الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=21905",""],[5376,"دَهُرْتَ أمْ بَلَغَتْ روحٌ تراقيها","https://www.poetsgate.com/ViewPoem.aspx?id=197734",""],[5431,"صفقة العهر ...ليس من خان منّا","https://www.poetsgate.com/ViewPoem.aspx?id=209119",""],[5552,"صوت من المخيم","https://www.poetsgate.com/ViewPoem.aspx?id=18416",""],[5717,"يا حسرة من فؤاد محتدم","https://www.poetsgate.com/ViewPoem.aspx?id=170590",""],[402,"قف خاشعا بضريح عز الدين","https://www.poetsgate.com/ViewPoem.aspx?id=36452",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5956,"الحب العاقرُ","https://www.poetsgate.com/ViewPoem.aspx?id=182020",""],[6093,"الهاربة إلى المجهول","https://www.poetsgate.com/ViewPoem.aspx?id=202107",""],[6093,"إنَّ السَّلامَ على المُختارِ قدْ وَجَبَا","https://www.poetsgate.com/ViewPoem.aspx?id=211222",""],[463,"رقَّ لبغدادَ القضاءُ والقدرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60077&r=&rc=133",""]],"verses":[["قد أكبر الشاه مروءاتكم","وحسن مسعاكم لدفع الشدد",0,"د",1,0],["قَدْ أَكْرَمَ اللهُ مَثْوَاهُ","فِي رِحَابِ صرُوحِهْ",1,"ح",2,0],["قَدْ أَكْبَرَ البَلَدُ الأَمِينُ وَفَاءَكُمْ","وَبِمِثْلِهِ كَانَ العَظِيمُ عَظِيمَا",2,"م",2,0],["قَدْ أَكْرَمُونِي مُقْبِلِينَ وَكُلهُمْ","أَوْلَى بِأَنْ يَتَقبَّلَ الإِكْرَامَا",3,"م",2,0],["قَدِ اِكتَفَلَت بِالحَزنِ وَاِعوَجَّ دونَها","ضَوارِبُ مِن خَفّانَ مُجتابَةٌ سِدرا",4,"ر",2,0],["قد أكسبوا الشهرا","خليفه الأنصار",5,"ر",1,0],["قد أكثر الناس في وهبٍ وضرطته","حتى لقد مُلَّ ما قالوا وقد بردا",6,"د",2,0],["قد أكلناك لذيذاً","طيباً حلو المذاق",7,"ق",1,0],["قد اكتهلت صناعتُها","لرُودٍ غير مُكْتهلَهْ",8,"ل",2,0],["قد أكلن الأيورَ أكل الضَّواري","وشربنَ المنيَّ شرْبَ الهِيم",9,"م",1,0],["قَد أَكمَلَ اللَهُ ذَيّاكَ الهِلالَ لَنا","فَلا رَأى الدَهرَ نَقصاً بَعدَ إِكمالِ",10,"ل",1,0],["قَد أَكمَلَ الحِلمَ وَاِشتَدَّت شَكيمَتُهُ","عَلى الأَعادي وَلَم يَبلُغ مَدى الحُلُمِ",11,"م",1,0],["قَد أَكسَبَتهُ رِياضَةً سُوّاسُهُ","فَتَكادُ تَركُضُهُ بِغَيرِ عِنانِ",12,"ن",1,0],["قَد أَكَلَ الحَمدُ تِلادي أَكلا","وَالعَضبُ لا يَثنيهِ إِن يُفَلّا",13,"ل",2,0],["قد أُكِرهَ الحافي فمَرّ على الثَّرَى","رَسْفاً وطار على القَتادِ النّاعل",14,"ل",1,0],["قد أكملَ اللّه في ذا السيفِ حِلْيَتَهُ","واختالَ باسم معزِّ الدين مُنتَقَشا",15,"ش",2,1],["قَدِ اِكتَفى الناسُ مِن عِلمي بِعِلمِهِمُ","فَالرَدُّ مِنّي عَلَيهِم عِلمُهُم نَقَلُ",16,"ل",1,0],["قَدِ اِكتَسى العودُ في الثَرى خِلَعاً","مِن يانِعِ الزَهرِ وَالنَدى الشَبِمِ",17,"م",1,0],["قَدِ اِكتَحَلَت عُيونٌ لِلثُرَيّا","بِما يُربي عَلى كُثُبِ الرِمالِ",18,"ل",1,0],["قدِ اكتستْ حُللاً من وشْيِ زَهرتِها","كأنَّ زُخرفَها في الحسنِ حاكاكا",19,"ك",2,0],["قَدْ أَكْبَرَتْ ذَاكَ الْقُدومَ فَأَبْدَعَتْ","زِيناتِهَا وَلِمِثْلِهِ الإِكبَارُ",20,"ر",1,0],["قَد أكِنَّ الأَسى فإِن","غَلَبَ الدَمعُ ذاعَ بَث",21,"ث",1,0],["قد اكثر التهويل اخلاط على","صفحاتهم سطر المذلة قد رقم",22,"م",1,1],["قد أكرم الله أقواما وأسعدهم","بنظرة منك في أعمارهم ظفروا",23,"ر",3,0],["قَد أكرمَ اللَّه النبيّ الأكرما","اللَّهُ قَد صلّى عليهِ وسلّما",24,"م",2,0],["قَد أكَلَت كُلَّ ما اشتَرَيتُ لَهَا","مِن رِزقِ شَعبَانَ أمس في رَجَبِ",25,"ب",1,0],["قَدِ اِكتنفا نهجاً إلى القصرِ لاحباً","كَما تكنفُ الأعلامُ ماثلةً خطّا",26,"ط",2,0],["قَد أكثَبَت فرصُ الجميلِ فبادرِ","وَاِنهض لَها نَهض الهزبرِ الخادرِ",27,"ر",1,1],["قد اكتنفا عبادتها فتمت","بأكمل صورةٍ في كل صورهْ",28,"ه",1,0],["قد أَكَلْنَ اللّحمَ هِضْنَ","العَظْمَ مَزّقْنَ الجلودا",29,"د",2,0],["قد أكلت الزَّمان حلواً ومرًّا","وشربت الأيام خمراً وخلاّ",30,"ل",2,0],["قد أكثر الدهر من غدرٍ ومن نكدٍ","وما رعى ذمةً إذ قام يغتالُ",31,"ل",1,0],["قد اكتسبت سيوف الهند منه","مضاءً والمثقفة اعتدالا",32,"ل",2,0],["قد اكتُتِبَتْ فِي اللَّوحِ فخراً مؤيَّداً","صُدورُ الدُّنا منها سطورٌ وألواحُ",33,"ح",1,0],["قد أكلَ الجدبُ أطيبيها فلم","يَبقَ سوى رسمها لمرتسمِ",34,"م",1,0],["قد أكلتني بعدكم فترةٌ","ما أكلت إلّا فتىً مُقْترا",35,"ر",2,0],["قد أكلتْ أكفَّها نواجذٌ","يومَ لك الأمرُ استقامَ واستقَرّْ",36,"ر",1,0],["قد أكلَتْنا بعدكم فاغرةٌ","أنيابَها قبلَ العِضاض جَزَرا",37,"ر",2,0],["قد أكثرَ المُدَّاحُ اِذْ مَدحوا","واِخالُهمْ وصفوا وما وصفوا",38,"ف",3,0],["قد اكتنفوا عشر الحقائق فانبرت","قواهم لها مع كونها شكل إنسان",39,"ن",1,0],["قَد أَكَلَ الطَعامَ المَقبوضَ أَجمَعَهُ","هَل تَأخُذَن لِطَعامٍ مِثلِهِ ثَمَرا",40,"ر",2,0],["قد اكتست ثوب بشرحين حل بها","كأنها الروض لما جاده القطر",41,"ر",1,0],["قد أكسبت تلك الخلال بناتنا","في الناس كل تجلة ووقار",42,"ر",1,0],["قدِ اِكتَسَبت فيهِ العروبة مَفخراً","وطالَت بهِ عزّاً على هام كيوانِ",43,"ن",1,0],["قد اكتنفته عصبة عربية","مع الحق تمشي أو تقوم نوادب",44,"ب",1,0],["قد اكتفيتمْ بالبُكا","لو البُكاءُ نافِعُ",45,"ع",1,0],["قد اكتسبوا شتى مَخازِيَ وانثنوْا","إلى فِيش تشفي جَوىً حلَّ بالدُّبر",46,"ر",1,0],["قد أكسب الفضل والمجد الأثيل علاً","ففات بالمجد أخداناً وأقرانا",47,"ن",2,0],["قَد أَكبَرَتكَ عُيونُ الخَلقِ إِذ نَظَرَت","لِلشَمسِ قَد بَزَغَت مِن جَبهَةِ الأَسَدِ",48,"د",1,0],["قد اكتساها أمير الآمرين على","كيد الزمان ورغم الحاسد الليمِ",49,"م",1,0],["قَد أَكثَرا الخِصام وَالجِدالا","وَأَعلَنا الشِّجار وَالمَقالا",50,"ل",2,0],["قد أكثر الناس في الشاهي مدائحهم","ولست أذكر فيه فوق ما أجد",51,"د",1,1],["قد اكتست الدنيا فتاهتْ بزهوها","خلائقَ أخلاقُ الرجال سمولها",52,"ل",3,0],["قد أُكمِلَت ما شئتَ إلّا أنها","عشرونَ من أعوامِها لم تكمُلِ",53,"ل",1,0],["قَد أَكَلوا الوَحشَ فَلَم يُشبِعهُمُ","وَشَرِبوا الماء فَطالَ شُربُهُم",54,"م",1,0],["قد أكمل اللَه فيه الخلق مع خلق","كدمية نزَّهت من كل مشيته",55,"ه",1,0],["قد أكثر الناس في الصفات وقد","قالوا جميعاً في الأعين النجل",56,"ل",1,1],["قَد أَكثَرَ الفِعلَ الجَميلَ فَواحِدٌ","في نَفسِهِ الإِقلالُ وَالإِكثارُ",57,"ر",1,0],["قد أكْمَلتْ بعد عشرٍ سنُّها سَنَةٌ","فَطرْفُها لحَشَا أهلِ الهوى 