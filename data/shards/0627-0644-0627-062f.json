{"poems":[[93,"هل بعالي الذرى مكان اعتصام","https://www.aldiwan.net/poem11308.html","الخفيف"],[47,"أبا العشائر إن أسرت فطالما","https://www.aldiwan.net/poem25183.html","الكامل"],[23,"ألا دفنتم رسول الله في سفط","https://www.aldiwan.net/poem21562.html","البسيط"],[72,"لرسوم الحمى عليه حقوق","https://www.aldiwan.net/poem19353.html","الخفيف"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[43,"لا افتخار إلا لمن لا يضام","https://www.aldiwan.net/poem10542.html","الخفيف"],[49,"خليلي إن الهم قد يتفرج","https://www.aldiwan.net/poem64142.html","الطويل"],[97,"هم أناخ فما انجلى","https://www.aldiwan.net/poem24903.html","مجزوء الكامل"],[74,"ألا دعاني اليوم داعي النهى","https://www.aldiwan.net/poem12862.html","السريع"],[105,"على ذكرها فليعرف الحق جاهله","https://www.aldiwan.net/poem41937.html","الطويل"],[48,"ألا دارها بالماء حتى تلينها","https://www.aldiwan.net/poem65278.html","الطويل"],[8,"ألا ديار الحي بين محجر","https://www.aldiwan.net/poem21793.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39562","الخفيف"],[94,"عيد الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=12815",""],[94,"إني لأشمت بالجبار","https://www.poetsgate.com/ViewPoem.aspx?id=12813",""],[110,"إلا دعني وشأني يابن ودي","https://www.aldiwan.net/poem16740.html","الوافر"],[200,"تجنى الخبيب فقالوا غضب","https://www.aldiwan.net/poem45639.html","المتقارب"],[238,"ما أنا بالأديب يا من كلامه","https://www.aldiwan.net/poem19078.html","الخفيف"],[365,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[367,"ألا دارس إلا له منك ساكب","https://www.aldiwan.net/poem16923.html","الطويل"],[430,"الا دع يا ابن كلثوم فخارا","https://www.aldiwan.net/poem40806.html","الوافر"],[539,"ألا دمت يا دار ودام لك الجد","https://www.aldiwan.net/poem48232.html","عموديه"],[539,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[552,"شطت عليك لبانة الصدر","https://www.aldiwan.net/poem47783.html","أحذ الكامل"]],"verses":[["أَلأَدِيبُ الَّذِي إذَا جَالَتِ الأَقْ","لامُ جَلَّى فِي حَلْبَةِ الأَقْلامِ",0,"م",1,0],["أَلّا دَعَوتَ أَخاكَ وَهوَ مُصاقِبٌ","يَكفي العَظيمَ وَيَدفَعُ الأَهوالا",1,"ل",2,0],["أَلّا دَعَوتَ أَبا فِراسٍ إِنَّهُ","مِمَّن إِذا طَلَبَ المُمَنَّعَ نالا",1,"ل",2,0],["أَلا دَفَنتُم رَسولَ اللَهِ في سَفَطٍ","مِنَ الأَلُوَّةِ وَالكافورِ مَنضودِ",2,"د",1,1],["الأديب الذي به أدّب الده","ر فما يشتكى لديه عقوق",3,"ق",1,0],["إِلّا دِمَشق اِغتُصِبَت وَلَم تَزَل","دِمَشقُ لِلشِيعَةِ تُضمرُ القِلى",4,"ا",1,0],["الأَديبُ المُهَذَّبُ الأَصيَدُ الضَر","بُ الذَكِيُّ الجَعدُ السَرِيُّ الهُمامُ",5,"م",1,0],["أَلا دَحَرَت مِنّا قُرونٌ كَثيرَةٌ","وَنَحنُ سَنَمضي بَعدَهُنَّ وَنَدرُجُ",6,"ج",1,0],["إلا دروعَ اليأس إن","نَ اليأسَ أيسر محمِلا",7,"ل",2,0],["أَلا دَعاني اليَومَ داعي النُهى","وَقَوَّمَت قِدحِيَ أَيدي الخُطوب",8,"ب",1,1],["أَلاَ دولةٌ للحقِّ تَسْلُكُ نَهْجَهُ","وتمشِي على آثارهِ ما تُزايلُهْ",9,"ل",2,0],["أَلا دارِها بِالماءِ حَتّى تُلينَها","فَلَن تُكرِمَ الصَهباءَ حَتّى تَهينَها",10,"ن",3,1],["أَلا دِيارَ الحَيِّ بَينَ مُحَجَّرٍ","إِلَى جانِبِ القَمرى كَأَن لَم تَغَيَّرِ",11,"ر",1,1],["الأديبُ العريقُ في لغة الضّا","د وقاموسُها الصحيحُ المرتَّبْ",12,"ب",1,0],["الأديم السّمح عطر ورؤى","ربّما أغفى عليه الأنبياء",13,"ا",2,0],["ألا دَمٌ يَتَنزَّى في سُلافَتِها","أستغفِرُ الثأرَ بلْ جَفَّت حُميّانا",14,"ن",2,0],["إِلا دَعني وَشَأني يابن وِدي","وَمَحوى كُل شَخص مِن خَيالي",15,"ي",1,1],["الا دعهمُ ذاكَ بدرُ السما","إذا ما أضاءَ السماءَ احتجبْ",16,"ب",1,0],["الْأَدِيبُ الذِي يَرُوقُ نِظَامُهْ","وَتُصَانُ عَنِ الْخَنَا أَقْلَامُهْ",17,"ه",1,0],["الأديبُ الذي حوىَ الفضلَ طُرّاً","والرْئيسُ الّذي علا الخَلْقَ مَجدا",18,"د",2,0],["أَلا دارِسٌ إِلّا لَهُ مِنكَ ساكِبُ","وَلا مانِعٌ إِلّا لَهُ مِنكَ طالِبُ",19,"ب",1,1],["الا دع يا ابن كلثوم فخاراً","بيوم عنيزةٍ إذ قلت شعرا",20,"ر",2,1],["ألا دُمتِ يا دارُ ودامَ لكِ الجَدُّ","فسَعدُكِ بينَ الدُّورِ لا مِثلُه سَعدُ",21,"د",1,1],["ألا دَع سَعيرَ الحِقِد يَغلي بقلبِهِم","فإنَّ سعيرَ الحِقدِ في القلبِ لاَ يخبُو",22,"ب",2,0],["ألّا دَفعتَ وَقَد دَفعت إلى","وِرْدِ المنون بمالك الأَثْرِ",23,"ر",1,0]]}