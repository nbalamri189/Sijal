{"poems":[[95,"هل بعالي الذرى مكان اعتصام","https://www.aldiwan.net/poem11308.html","الخفيف"],[49,"أبا العشائر إن أسرت فطالما","https://www.aldiwan.net/poem25183.html","الكامل"],[23,"ألا دفنتم رسول الله في سفط","https://www.aldiwan.net/poem21562.html","البسيط"],[74,"لرسوم الحمى عليه حقوق","https://www.aldiwan.net/poem19353.html","الخفيف"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[45,"لا افتخار إلا لمن لا يضام","https://www.aldiwan.net/poem10542.html","الخفيف"],[51,"خليلي إن الهم قد يتفرج","https://www.aldiwan.net/poem64142.html","الطويل"],[99,"هم أناخ فما انجلى","https://www.aldiwan.net/poem24903.html","مجزوء الكامل"],[76,"ألا دعاني اليوم داعي النهى","https://www.aldiwan.net/poem12862.html","السريع"],[107,"على ذكرها فليعرف الحق جاهله","https://www.aldiwan.net/poem41937.html","الطويل"],[50,"ألا دارها بالماء حتى تلينها","https://www.aldiwan.net/poem65278.html","الطويل"],[8,"ألا ديار الحي بين محجر","https://www.aldiwan.net/poem21793.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39562","الخفيف"],[96,"عيد الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=12815",""],[96,"إني لأشمت بالجبار","https://www.poetsgate.com/ViewPoem.aspx?id=12813",""],[113,"إلا دعني وشأني يابن ودي","https://www.aldiwan.net/poem16740.html","الوافر"],[203,"تجنى الخبيب فقالوا غضب","https://www.aldiwan.net/poem45639.html","المتقارب"],[242,"ما أنا بالأديب يا من كلامه","https://www.aldiwan.net/poem19078.html","الخفيف"],[369,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[371,"ألا دارس إلا له منك ساكب","https://www.aldiwan.net/poem16923.html","الطويل"],[435,"الا دع يا ابن كلثوم فخارا","https://www.aldiwan.net/poem40806.html","الوافر"],[543,"ألا دمت يا دار ودام لك الجد","https://www.aldiwan.net/poem48232.html","عموديه"],[543,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[556,"شطت عليك لبانة الصدر","https://www.aldiwan.net/poem47783.html","أحذ الكامل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83338","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64042","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37882","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37952","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38950","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37876","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37955","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77558","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145779","المتقارب"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79801","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77982","الوافر"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199811","المسحوب"],[2537,"","https://poetry.dctabudhabi.ae/diwan/poem/132205","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137177",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137372",""],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65293","الطويل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128929","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94343","الوافر"],[4245,"","https://poetry.dctabudhabi.ae/diwan/poem/73825","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133175","البسيط"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123866","الخفيف"],[4778,"الأدب الرفيع","https://www.poetsgate.com/ViewPoem.aspx?id=197844",""],[4830,"عيناكِ","https://www.poetsgate.com/ViewPoem.aspx?id=211902",""],[4954,"هلْ لي منْ غزالٍ سماحةً","https://www.poetsgate.com/ViewPoem.aspx?id=208832",""],[5031,"دموع أهلي من ياقوت","https://www.poetsgate.com/ViewPoem.aspx?id=165141",""],[5050,"ألا دع خلة الكاس","https://www.poetsgate.com/ViewPoem.aspx?id=38215",""],[5183,"بَْينَ الْشَّهْدِ وَالْشَّهَادَة","https://www.poetsgate.com/ViewPoem.aspx?id=186463",""],[5198,"صوت وصدى","https://www.poetsgate.com/ViewPoem.aspx?id=136245",""],[5376,"الدهرُ أمتعنا بالرود والغيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=188404",""],[5408,"إحتفالية المقاتل في محراب الشهادة","https://www.poetsgate.com/ViewPoem.aspx?id=190866",""],[5413,"أيها البدر المنير!","https://www.poetsgate.com/ViewPoem.aspx?id=200619",""],[5629,"الوقت","https://www.poetsgate.com/ViewPoem.aspx?id=184606",""],[5690,"لي في غرامك صبر غير محدودِ","https://www.poetsgate.com/ViewPoem.aspx?id=172148",""],[5694,"من العايدين","https://www.poetsgate.com/ViewPoem.aspx?id=132100",""],[5763,"زمنُ الصفاقة","https://www.poetsgate.com/ViewPoem.aspx?id=27063",""],[5956,"‏ رثاء حب الطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=182240",""],[6068,"‫أقسمت في جنح الظلام ونوم‬-14-","https://www.poetsgate.com/ViewPoem.aspx?id=175857",""]],"verses":[["أَلأَدِيبُ الَّذِي إذَا جَالَتِ الأَقْ","لامُ جَلَّى فِي حَلْبَةِ الأَقْلامِ",0,"م",1,0],["أَلّا دَعَوتَ أَخاكَ وَهوَ مُصاقِبٌ","يَكفي العَظيمَ وَيَدفَعُ الأَهوالا",1,"ل",2,0],["أَلّا دَعَوتَ أَبا فِراسٍ إِنَّهُ","مِمَّن إِذا طَلَبَ المُمَنَّعَ نالا",1,"ل",2,0],["أَلا دَفَنتُم رَسولَ اللَهِ في سَفَطٍ","مِنَ الأَلُوَّةِ وَالكافورِ مَنضودِ",2,"د",1,1],["الأديب الذي به أدّب الده","ر فما يشتكى لديه عقوق",3,"ق",1,0],["إِلّا دِمَشق اِغتُصِبَت وَلَم تَزَل","دِمَشقُ لِلشِيعَةِ تُضمرُ القِلى",4,"ا",1,0],["الأَديبُ المُهَذَّبُ الأَصيَدُ الضَر","بُ الذَكِيُّ الجَعدُ السَرِيُّ الهُمامُ",5,"م",1,0],["أَلا دَحَرَت مِنّا قُرونٌ كَثيرَةٌ","وَنَحنُ سَنَمضي بَعدَهُنَّ وَنَدرُجُ",6,"ج",1,0],["إلا دروعَ اليأس إن","نَ اليأسَ أيسر محمِلا",7,"ل",2,0],["أَلا دَعاني اليَومَ داعي النُهى","وَقَوَّمَت قِدحِيَ أَيدي الخُطوب",8,"ب",1,1],["أَلاَ دولةٌ للحقِّ تَسْلُكُ نَهْجَهُ","وتمشِي على آثارهِ ما تُزايلُهْ",9,"ل",2,0],["أَلا دارِها بِالماءِ حَتّى تُلينَها","فَلَن تُكرِمَ الصَهباءَ حَتّى تَهينَها",10,"ن",3,1],["أَلا دِيارَ الحَيِّ بَينَ مُحَجَّرٍ","إِلَى جانِبِ القَمرى كَأَن لَم تَغَيَّرِ",11,"ر",1,1],["الأديبُ العريقُ في لغة الضّا","د وقاموسُها الصحيحُ المرتَّبْ",12,"ب",1,0],["الأديم السّمح عطر ورؤى","ربّما أغفى عليه الأنبياء",13,"ا",2,0],["ألا دَمٌ يَتَنزَّى في سُلافَتِها","أستغفِرُ الثأرَ بلْ جَفَّت حُميّانا",14,"ن",2,0],["إِلا دَعني وَشَأني يابن وِدي","وَمَحوى كُل شَخص مِن خَيالي",15,"ي",1,1],["الا دعهمُ ذاكَ بدرُ السما","إذا ما أضاءَ السماءَ احتجبْ",16,"ب",1,0],["الْأَدِيبُ الذِي يَرُوقُ نِظَامُهْ","وَتُصَانُ عَنِ الْخَنَا أَقْلَامُهْ",17,"ه",1,0],["الأديبُ الذي حوىَ الفضلَ طُرّاً","والرْئيسُ الّذي علا الخَلْقَ مَجدا",18,"د",2,0],["أَلا دارِسٌ إِلّا لَهُ مِنكَ ساكِبُ","وَلا مانِعٌ إِلّا لَهُ مِنكَ طالِبُ",19,"ب",1,1],["الا دع يا ابن كلثوم فخاراً","بيوم عنيزةٍ إذ قلت شعرا",20,"ر",2,1],["ألا دُمتِ يا دارُ ودامَ لكِ الجَدُّ","فسَعدُكِ بينَ الدُّورِ لا مِثلُه سَعدُ",21,"د",1,1],["ألا دَع سَعيرَ الحِقِد يَغلي بقلبِهِم","فإنَّ سعيرَ الحِقدِ في القلبِ لاَ يخبُو",22,"ب",2,0],["ألّا دَفعتَ وَقَد دَفعت إلى","وِرْدِ المنون بمالك الأَثْرِ",23,"ر",1,0],["إِلّا دُمتَ بِالخَيرِ مُستَمسِكاً","يَنارُ بِكَ الوَطَنُ العامِرُ",24,"ر",1,0],["الأديبُ اللبيبُ أنت وأنت ال","متأتّي الملاطفُ المتلطِّف",25,"ف",1,0],["الأَديبُ الأَريبُ شَمسُ كَمالٍ","صائِبُ الرأيِ وَالمَقالِ السّديدِ",26,"د",1,0],["الأَديبِ الجزائِريِّ المُفدّى","الأريبِ المُهذَّبِ المَسعودِ",27,"د",1,0],["الأَديب اللّوذَعيّ الفاضلُ","فَضلهُ في الدّهرِ ما إِن يجحدُ",28,"د",1,0],["الأَديبُ الغزّيُّ نَسْلُ كِرامٍ","حَيثُ كانوا عَلى المُلوكِ مَوالي",29,"ل",2,0],["الأَديبُ القطّانُ صِنْوُ كمالٍ","مفرَدُ الدَّهرِ في الصّفاتِ الحِسانِ",30,"ن",1,1],["الادعاء في الوَرى كَثير","وَالناسُ لَيسَ فيهمُ صَغيرُ",31,"ر",1,1],["ألاَ دعكَ مِن جَوقةِ الرَّاقصين","على دمِنا وهوَ يجري سيولا",32,"ل",2,0],["ألآدمٍ تنعى وأين خليفة ال","رحمنِ آدمُ كي يُقيمَ عزاءها",33,"ا",3,0],["ألا دين عن الفحشاء ينهى","ألا علم لذي جهل يفيد",34,"د",1,0],["الأديب الفذ والفهم اللبيب","في الجزاله والعداله الأولي",35,"ل",2,0],["ألا دولة المستنصر اليوم قد علت","بدولتكم واعتز بالعلم طالبه",36,"ب",2,0],["الا دام ايها الصرح المعلى","مجلى الجيد في غرر الخصال",37,"ل",1,0],["الأديب الأريب رب المعالي","والحسيب النسيب مجدا وقدرا",38,"ر",2,0],["ألا دلّني في الوصل كيف سبيلهُ","إليك فقد ضاقت عليّ المسالكُ",39,"ك",1,1],["الاديب الأبي قد نفروه","والغبي الدنيئ فيها مقرب",40,"ب",1,0],["أَلا دأبي أَخيذٌ عن كرام","وَشأني في سما الأخلاق سام",41,"م",1,1],["أَلا دَرى الصِّيدُ مِن قَومِي الصَّناديدُ","أَنِّي أَسير بِدارِ الذُّلِّ مَصفودُ",42,"د",1,1],["الأدعج الأهيف القويم","ذي كل حسنى في الملا حواها",43,"ه",2,0],["الأديب الأريب ذي الفضل من عمّ","ر صرح العلا وشاد مناره",44,"ر",2,0],["الأدب الرفيع على المدى ما غابا","يروي الغليل ويخلب الألبابا",45,"ب",2,1],["ألا دَعي لومةَ العُذّالِ واقتربي","فالصّبرُ من أَلَقِ الأعمارِ يسترقُ",46,"ق",1,0],["ألا دعْكَ منْ ذِكْرِ الرّزايا،فَمالَنا","سِوى أجَلٍ نَحْياه،فِي الْعُمْر،معْدُود",47,"د",1,0],["إلا دُمُوعَ بني حُزْني فَهُمْ كُثُرُ","جذوعُ صَبْرٍ تَعَرَّى عندَها الزَّهَرُ",48,"ر",1,0],["ألا دع خلة الكاس","وقم للمجد بالبأس",49,"س",1,1],["أَلا دعها تمجّ الريق شهدا","وتشهد من جلال الله بندا",50,"د",2,1],["ألاد ناجم كان فيهم عذاريب","عذروبهم يوفون الاخصام كيه",51,"ي",2,0],["ألا دعيني أعود الدار منتظراً","يوما من السقْم أو دهرا من البيدِ",52,"د",1,0],["إلا دماك تكون مهر زفافها","فتضم صدرك تحتويه ملاطفا",53,"ف",2,0],["إلا دموع العين والقلب الذي","أعطى الغرام زمَامَه لعمائه",54,"ا",3,0],["الادمي لاطاب طابت مزاياه ،","ولا خاب خابت وانحرف عن مساره ،",55,"ر",2,0],["إلا دعي الطبيب وأرمي الكحل واحتقري","هذي الحلى وانبذي تحسين تجعيدِ",56,"د",1,0],["ألاد مريح كلهم متكاتفين","ويمناً تفرقهم عساها بالشلل",57,"ل",1,0],["الأدعياءُ تسنَّموا شرفَ العُلا","يثني عليهم مَنْ يرومُ المغنما",58,"م",2,0],["إلّا دموع وابلاتٌ ريثما","أدْنيك مني في الضريح الرَّاحمِ.",59,"م",1,0],["إلا دمائي ليس منها هدية","خوفا عليك لمزجها بسموم",60,"م",1,0]]}