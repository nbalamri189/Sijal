ي رغم هجري فانعمي","https://www.poetsgate.com/ViewPoem.aspx?id=188285",""],[5376,"قصيدة من ملحمة سقوط بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=188511",""],[5409,"غنى فأطمعه السقا","https://www.poetsgate.com/ViewPoem.aspx?id=155390",""],[709,"خفرت بسيف الغنج ذمّة َ مِغفَري","https://www.poetsgate.com/ViewPoem.aspx?id=2880",""],[5459,"اضمحلال","https://www.poetsgate.com/ViewPoem.aspx?id=190891",""],[5466,"يا مَنْ يرومُ تلاوة القرآن","https://www.poetsgate.com/ViewPoem.aspx?id=112512",""],[5725,"الحاضرون","https://www.poetsgate.com/ViewPoem.aspx?id=210514",""],[5730,"يقين","https://www.poetsgate.com/ViewPoem.aspx?id=210367",""],[5732,"يقول من عدا على رأس عالي","https://www.poetsgate.com/ViewPoem.aspx?id=34388",""],[5829,"الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=151689",""],[6093,"مجاز","https://www.poetsgate.com/ViewPoem.aspx?id=197061",""],[6093,"في كل صبح نستعيد العيدا","https://www.poetsgate.com/ViewPoem.aspx?id=200912",""],[572,"وليلة ٍ فيها قَصُرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9293&r=&rc=150",""]],"verses":[["كَالعيرِ في عانَةِ ذي طَخفَةٍ","لا طالِبِ النَسلِ وَلا عازِلِ",0,"ل",1,0],["كَالعِلقِ وَالعِلقِ لَو خُيِّرتَ بَينَهُما","لَم تَرضَ بِالدونِ يَوماً أَن يَكونَ لَكا",1,"ك",2,0],["كَالعَضبِ فيهِ صاقِلٌ عَمِلٌ","يَنفي القَذى وَيُباعِدُ الدَنَسا",2,"س",2,0],["كَالعيرِ ذاتِ الأَوساقِ صاحَ بِها","مُعتَسِفٌ بِالأَيانِقِ النُجُبِ",3,"ب",1,0],["كالعُرْفِ يَكْتُمُهُ الأغَرُّ وعرْفُهُ","أرِجٌ تَنُمُّ بهِ المَدائِحُ فاشِ",4,"ش",1,0],["كالعصا في يدِ الكليم وفيها","لحمى الملك غاية الآراب",5,"ب",1,0],["كالعارض التهبت صواعقه","وسقى البلاد فلم يدع بقعه",6,"ع",2,0],["كَالعَبدِ يَخشى بَعدَ ما أَفنى الصِبى","يَلهو بِهِ ساداتُهُ أَن يُعتَقا",7,"ق",2,0],["كَالعودِ يوقَدُ بَعضُهُ","وَالبَعضُ مِنهُ الماءُ يَجري",8,"ر",2,0],["كالعاشقَين تقابلا","لكن على سُرر النبات",9,"ت",1,0],["كَالعَينِ مَنهومَةً بِالحُسنِ تَتبَعُهُ","وَالأَنفِ يَطلُبُ أَعلى مُنتَهى الطيبِ",10,"ب",1,0],["كَالعَذارى غَدَونَ في الحُلَلِ الصُف","رِ إِذا رُحنَ في الخُطوطِ السودِ",11,"د",1,0],["كالعارضِ انهلَّ رَذاذاً مُزنُهُ","وَبَرقُهُ بادي الحَريقِ يَلتَهِب",12,"ب",1,0],["كَالعِذقِ في رَأسِ الكَثيبِ نَما","طُولاً وَمالَ بِفَرعِهِ الوِقرُ",13,"ر",1,0],["كَالعاذِلاتِ تَأَخَّرَت","بِالسَيفِ شَمعاً مُترَفا",14,"ف",2,0],["كَالعَينِ وَالحاءِ تَأبى أَن تُقارِنَها","في لَفظِها فَحَماها قُربَها حامي",15,"ي",1,0],["كالعَهْد عندهُمُ العهودُ على الصّفا","أنّى ولَستُ لها صفاً نَبّاذا",16,"ذ",2,0],["كالعَندَليب شدا للناس في قفص","بحيث يحيا بحبات لها التقطا",17,"ط",2,0],["كالعمرِ والسُّقمِ إذا","تحالفا واصطحبا",18,"ب",2,0],["كَالعَقيق تَنثُرُهُ ال","حورُ بَينَ أَنحُرِها",19,"ر",3,0],["كالعِطْرِ تَجْمَعُ قَطْرةٌ من مائهِ","زَهْراً يَنُوءُ بغُصْنِهِ المَيَّادِ",20,"د",1,0],["كالعذارَى يدنو بها الشوقُ قُرْباً","ثم تنأَى مخافةَ اللّومِ بُعْدَا",21,"د",2,0],["كالعارضِ انهلَّ رَواءً ديمةً","بأساً وبِيضِ الهِندِ لا بِيضِ العَرَبْ",22,"ب",1,0],["كالعود في أهزاجه ، والسهم في","إصماته ، والطَرفِ في إيمائه",23,"ا",3,0],["كالعبد يخضع للضيوف وانه","في القوم أكبر سَيد معصوب",24,"ب",1,0],["كالعارض الثجاج ملء هوائه","لكن دمُ الأبطالِ من أنوائه",25,"ا",3,0],["كالعضب تثلمه الغضاض","ة بالحمائل والجفون",26,"ن",1,0],["كالعز وافَقه الغنى","والحسن وافقه الشباب",27,"ب",1,0],["كَالعَينِ لا تُبصِرُ ما حَولَها","وَلَحظُها يُدرِكُ ما يبعدُ",28,"د",1,0],["كالعروسِ قد حجبتْ","وهو دونها حُجبُ",29,"ب",1,0],["كالعاشِقِ الحَرّان يرتَشفُ اللّمى","خَمرا ولا يرويه ريقٌ أشْنَبُ",30,"ب",1,0],["كالعالمِ العلّامةِ الفهامةِ ال","برّ التقي الماجد المتورّعِ",31,"ع",1,0],["كالعابد المفتون يحنى الجبين","وروحه تزجى إليك الرجاء",32,"ا",2,0],["كَالعَينِ تَشهَدُ في المِرآةِ صورَتَها","وَما اِستَحلا وَلا حالا وَلا اِنتِقِلا",33,"ل",2,0],["كالعَيْنِ تَخْتَرِقُ الآفاقُ ناظرةً","أجَلْ ومَحْجِرُها للصَّونِ يَحْويها",34,"ي",3,0],["كالعَينِ كيف رَمتْ بطَرْفٍ إنّما","يَعْتادُ أبيضُها اتِّباع الأسْود",35,"د",1,0],["كَالعِيَسِ أَقتَلُ ما يَكونُ لَها الظَلما","وَالماءُ فَوقَ ظُهورِها مَحمولُ",36,"ل",1,0],["كالعجب والكبر والغيبة والشتم","والغدر فبئس من غدر",37,"ر",1,0],["كالعشق يستحليه صاحبه","وبه دواعي السقم والسُّهْدِ",38,"د",1,0],["كالعود مشيته فإن حرقته","كره الدخان وطاب عرف المنذل",39,"ل",1,0],["كالعارضِ المنهلِّ يومَ نواله","والصَّارم المنسلّ يوم نزاله",40,"ل",2,0],["كالعارضِ اضطرَمَت لواقحُ برقِه","في مستهلِّ الويلِ من نضّاحِه",41,"ح",2,0],["كالعبد يرهق كل حسن ناضر","ويمن بعد عليه باسم وصاله",42,"ل",2,0],["كالعاشق الصَّبْوان يوهمهُ الجَفا","جنفَ الجنابِ ونظرةَ الاِغْضاءِ",43,"ا",2,0],["كالعين بالبصرِ المُنير تفضّلتْ","والعينُ لولا نَجلُها لم تُبصِرِ",44,"ر",1,0],["كالعِقْدِ كان نظامُها فتفرّقَتْ","فحكَتْ ثَنايا الغُرّ وهْو مفلَّجُ",45,"ج",1,0],["كَالعُطاسِ الفُضُولُ لا مِن مَرَدٍّ","لهُ إن جاءَ رَبَّهُ فاعذِروني",46,"ن",2,0],["كالعبد يعلم ثم يذكر علمه","لا خارجاً عنه وذاك خياله",47,"ل",2,0],["كالعيس في البيداء يقتلها الظما","والماء فوق ظهورها محمولُ",48,"ل",1,0],["كالعنكبوت بنت نفس لها خيماً","حتى بها وهنت من طول تعنيس",49,"س",1,0],["كَالْعِقْدِ حَلَّ فَانْتَثَرْ","عَرُوضُ قَوْلٍ مُشْتَهَرْ",50,"ر",1,0],["كالعود يقطر والنيران تحرقه","كالماء في طرف والنار في طرف",51,"ف",1,0],["كالعين تفرح غيرها","وتظل لابسة الحداد",52,"د",1,0],["كالعسيفِ المربوعِ شلِّ قلاصا","ما له دون منهلٍ من مباتِ",53,"ت",1,0],["كالعيلم المهدي من جعلت له","علماؤها في المشكلات مآبها",54,"ب",3,0],["كالعاصم الحامي الذي خضعت","أهل العراق فلم يحق مكرا",55,"ر",2,0],["كالعاشق المهجور يقنع أن يرى","طيف الحبيب إذا ثناه صدود",56,"د",1,0],["كاْلعُودِ لا يُطْمَعُ في طِيِبِه","إِلاَّ إِذا أُحْرِقَ بالنَّارِ",57,"ر",1,0],["كَالْعَبْدِ إِنْ لمْ تُهِنُهُ","جَنَى على الأَحْرارِ",58,"ر",1,0],["كالعذارى الحِسان في الحُلل الحُمْ","رِ والجمر طار عنه شراره",59,"ر",2,0],["كالعقاب الغرثان يقتنص اللح","م ويهوي إلى طيور الخوان",60,"ن",1,0],["كالعين تبلغُ اختُها الشأوَ الذي","بلغته إن كلٌّ إليه تحدّق",61,"ق",1,0],["كالعقد في صدرِ الفتا","ة بضوئه والإلتماع",62,"ع",1,0],["كالعارض الملْتَفّ يَخْتَلع النُهى","قَصَفاتُ رَعْدٍ في حَشاه مُقَهْقهِ",63,"ه",1,0],["كالعارِض المُسْوَدِّ إِلاّ أَنَّهُ","باللاّمعات يَشِفُّ عن ماءِ الأَضا",64,"ض",2,0],["كالعارض المدرار خف بودقه","فسرت إلى ريح الصبا انجابا",65,"ب",2,0],["كَالعارِضِ الوَطِفِ الَّذي في طَيِّهِ ال","إِرهام وَالإِرعادُ وَالإِبراقُ",66,"ق",1,0],["كَالعُقَابِ الطَّلُوبِ يِضرِبُها الطَّ","لُ وقد صَوَّبَت عَلى عِسبَارِ",67,"ر",1,1],["كالعلا تزداد بهجتها","بين عثمانٍ وبين علي",68,"ل",2,0],["كالعصر إن كان جميلَ البنا","لم تدنُ كف الهدم من أُسّه",69,"س",2,0],["كَالعادلي الَّذي جلت فَضائله","عَن أَن تعد بِتَمييز وَإحصاء",70,"ا",2,0],["كالعجب بالنفس ايضا واتباع هوى","بهذه صحت الاخبار من قدم",71,"م",1,0],["كالعرش واللوح والكرسي وجنتهم","والرعد والبرق والانوار في الظلم",71,"م",1,0],["كَالعُودِ يَضْرِبُ في فُؤَادٍ فَارغٍ","فَتَأَسَّ لَو أَحْتَالُ بِالإِنْشَادِ",72,"د",1,0],["كَالعَضْبِ لكِن لا يجوزُ مُضَارِباً","كالمُزْن لكِن لا يَصُوبُ رَذاذا",73,"ذ",2,0],["كالعَاثرِ استشرتْ بزلتهِ","قَدَمٌ فأَلزَمَ دنبَها النَّعْلا",74,"ل",2,0],["كَالعودِ فَلَولا نَفحَتُهُ","يَوماً ما اِمتازَ مِن الحَطب",75,"ب",1,0],["كالعلم إما سنة من عالم","تهدي وإما بدعة من مبدع",76,"ع",1,0],["كالعلم والصلاح ينجيان","والناس يسحبون للنيران",77,"ن",1,0],["كالعلم أن اثنين ضعف واحد","وأن ليس قائما كقاعد",78,"د",1,0],["كآل علي القانت ابن محمد","بناة المعالي والمجلين إن جالوا",79,"ل",3,0],["كالعِطْرِ تجلِبُه لأنْطاكِيَّةٍ","فَتَراهُ يفسُد رِيحُه بل يُنْتِنُ",80,"ن",1,0],["كالعقد فُصِّلَ لؤلؤا وزبرجدا","فتقابلت أولاهُ مَع أخراهُ",81,"ا",2,0],["كالعبدِ ذي الفروةِ الرَّبداءِ اقلقه","شاءٌ ذواهبُ بين الزُّرق فالجُردِ",82,"د",1,0],["كالعيد إِذ تبكي العيون لفقده","وَيسرها من قبل ذاك هلاله",83,"ل",2,0],["كالعارض الهطال أطفأ نارها","بمواطر ورواعد وسيول",84,"ل",1,0],["كالعجل داروا به لو كان من ذهب","لأَلَّهوه بتقديس وإيمان",85,"ن",1,0],["كالعارض الهتان يو","رث صوبه جوداً وذعراً",86,"ر",2,0],["كالعيد والوتر صله والكسوف وتال","لذة في الفضل ما هو للفرائض بحال",87,"ل",1,0],["كالعبد صبغته السوداء ثابتة","على المسمى بها والاسم كافور",88,"ر",1,0],["كالعودِ تَحَنَّنتُ إِلى حُجر هَوى","لَو ضَمَّ كَعوده جَماداً نَطَقا",89,"ق",2,0],["كالعقد في جيد المليحة لؤلوء","يزهو وفي جيد القبيحة قرطم",90,"م",1,0],["كالعهن منفوش العمامة ثعلب","متحيل صلب القتادة ملحد",91,"د",1,0],["كالعطر في عبق والقطر في غدق","والبدر في غسق والفجر في فلق",92,"ق",1,0],["كالعرض لي غرضي ومن ينظر إلى ال","أعراض لم يأمن من الإعراض",93,"ض",1,0],["كالعينِ وهي صغيرةٌ في حجمها","تَسَعُ السماءَ وتجمع الأَقطارا",94,"ر",2,0],["كالعدّ يُحصَى ولا حدٌ لقمته","أهيم لكنْ كأني فيه لم أهم",95,"م",1,0],["كالعنكبوتِ .. أحكمتْ غزلَها","فكلُّ ماشٍ فوقه كُبِّلا",96,"ل",2,0],["كالعذارى يملا الخضر انجلت","للقاء زوارها تبدي انخفاض",97,"ض",1,0],["كالعبدِ مأمورٌ لدى أسيادِهِ","الأوباشِ منتظرٌ هناكَ أوامرهْ",98,"ر",2,0],["كالعود ينفح العطر للناس","ويفنى تحرقاً واشتعالا",99,"ل",2,0],["كالعود يحسن عرفه وأريجه","للقلب حين يطيب باستنشاق",100,"ق",1,0],["( كالعطر للورد بعض من شمائله )","أيَا حَبِيبَة ... إِنِي بَعضُ فَحوَاكِ",101,"ك",1,0],["كالعطر يسري فرحة","كالهمس ما بين الشجر",102,"ر",1,0],["كَالعُشْبَةِ النَّعْمَاءِ بَلَّلَهَا الرِّوَىْ","فَسَرَىْ اخْضِلَالُ الخَيْرِ مِنْ غَزَلٍ طَرِيَّا",103,"ي",2,0],["كَالْعَاشِقِ الْوَلْهَانِ يَصْفُو مُشْرِقاً","إِنْ زَارَهُ الإِلْهَامُ يَشْدُو مُفْرَدَا",104,"د",2,0],["كالعاشقِ الولهانِ صرتَ متيّما","بالحبّ تُخلص للأنامِ صنيعا",105,"ع",2,0],["كالعقدِ في الجيدِ الجميلِ وزينةٍ","وسوارِ حبٍّ في جميلِ المعصمِ",106,"م",1,0],["كالعهن ناثرها بيض ظفائرها","واسود الشعر بين الشيب منثورُ",107,"ر",1,0],["كالعود تملأ جوفه","فيكف عن نغماته",108,"ت",2,0],["كَالْعَيْنِ بِالْبَصَرِ الْمُنِيرِ تَفَضَّلَتْ","مالعينُ لولا نجلها لم تبصرِ",109,"ر",1,0],["كَالْعُمْيِ نَحْنُ ..وَ فِي النَّهَا","رِ عَلَى الدُّجُنَّةِ نَسْتَدِلُّ..",110,"ل",1,0],["كا لعِْنِ أفرِغْ لا تُزغْ نَخْتِمْ ولا","تخشى وسبُحْهُ وكالإحسانِ",111,"ن",1,0],["كالعاذلين على الجروح تسامروا","فتثائبوا فأرتاب منا البابُ",112,"ب",1,0],["كالعودِ ترهقهُ أناملُ عازف ٍ","فيرتّل الأوجاع للمشتاق ِ",113,"ق",1,0],["كالعنبر الغالي بالاسواق غالي","ولادرهم الفضيه على صفر ونحاس",114,"س",1,0],["كالعروسِ البكرٍ زفّت في غناها","مهرها روح الأضاحي والحماةِ",115,"ا",2,0],["كَالعِطْرِ فَوْقَ الورْدِ قَالَ قَصِيْدَةً","وَ تَرَى الفَرَاشَ لنَِصِّهِ يَنْحَازُ",116,"ز",1,0],["كَالعِيد يَأْتِي فِي النُّفُوسِ بِفَرْحَة","فِي كُلِّ صُبْحٍ نَسْتَعِيدُ العيدا",117,"د",2,0],["كالعِقْدِ حُلَّ فانتَشَرْ","عروضُ قولٍ مُشْتَهَرْ",118,"ر",1,0]]}