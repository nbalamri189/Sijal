{"poems":[[64,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[82,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[89,"أخذ الكرى بمعاقد الأجفان","https://www.aldiwan.net/poem8239.html","الكامل"],[136,"أبان اصطباري بين أم أبان","https://www.aldiwan.net/poem54702.html","الطويل"],[254,"وجنبتها قران إن لأهلها","https://www.aldiwan.net/poem2114.html","الطويل"],[266,"أكذا النفوس إذا عشقن الأنفسا","https://www.aldiwan.net/poem38255.html","الكامل"],[274,"لما رأيت البز والشاره","https://www.aldiwan.net/poem26749.html","الرجز"],[310,"محيا الهنا طلق وثغر المنى افترا","https://www.aldiwan.net/poem56547.html","الطويل"],[500,"ومضطغن على الألباب قاس","https://www.aldiwan.net/poem10272.html","الوافر"],[505,"صاح إن مسك الزمان بخطب","https://www.aldiwan.net/poem37691.html","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77640","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77596","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77592","الرجز"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133759","المتقارب"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125365","الخفيف"],[1936,"","https://poetry.dctabudhabi.ae/diwan/poem/105195","الكامل"],[3289,"","https://poetry.dctabudhabi.ae/diwan/poem/31455","الطويل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66586","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111502","البسيط"],[3996,"","https://poetry.dctabudhabi.ae/diwan/poem/114910","الوافر"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101372","الكامل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119428","الكامل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33068","المتقارب"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66114","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52135","الخفيف"],[4927,"وداع عفراء","https://www.poetsgate.com/ViewPoem.aspx?id=29611",""]],"verses":[["فَصَعّدِ الأرض في الأثال تضربها","بالنار فهي تُهَبَيها بلا صورِ",0,"ر",1,0],["فَصَعيدُ وجهِ الأرْضِ منه مُبَعْثَرٌ","وَذَرُورُ عين الشَّمسِ منه غبارُ",1,"ر",1,0],["فَصَعِيدُهَا أَحْوَى النَّبَاتِ وَسَرْحُهَا","أَلْمَى الظِّلالِ وَزَهْرُهَا مُتَدَانِي",2,"ن",2,0],["فَصَعَّدَ انفَاسِ وحَدَّر ادمُعِي","نَجِيعاً عَلَى خَدِىِّ أحمَرَ فَان",3,"ن",1,0],["فَصُعنا وَلَم نَجبُن وَلَكِن تَقاصَرَت","بِإِخوانِنا عُندُ الجُدودِ تَقَصُّرا",4,"ر",2,0],["فصعيدها الأكسير يغني طالباً","من ان يظل مصعداً ومدمسا",5,"س",2,0],["فَصَعَّدَت نائِلَةً سُلَّماً","تَخافُ أَن تَصعَدَهُ الفارَه",6,"ر",2,0],["فَصَعّدَ أَنفاساً وَلَم يدرِ أنّها","تشبُّ لِفَضلي في ذُرى علم ذكرا",7,"ر",2,0],["فصعر خده غضباً عليها","وزناها ببهتان عظيم",8,"م",1,0],["فصعاب الخطوب تغدو هباءً","ويجئَ السرور من كل بابِ",9,"ب",1,0],["فَصعبت عَلَيهِ تِلكَ النِيَّه","وَفرقة المَنازِل السنيَّه",10,"ه",1,0],["فَصَعدت لِلنسر تِلكَ القِطَّه","مِن بَعد ما نَطَت إِلَيهِ نَطَه",11,"ه",1,0],["فَصعبت عَلَيهُم العِبارَه","وَما رأَوا بَيتاً خَلا في الحارَه",12,"ه",1,0],["فصعَّد في السهل أنفاسه","وأحنى على الجبل الأصلع",13,"ع",1,0],["فَصُعُودُ العُلا لمثلك يدعو","كلَّ قلبٍ لأن يَزُفَّ التهاني",14,"ن",2,0],["فصعود أعلى الخلد بالعمل الذي","لولاه يرهقك الإله صعودا",15,"د",2,0],["فَصَعَّدَ في وَعسائِها ثُمَّتَ اِنتَمى","إِلى أَحبُلٍ مِنها وَجاوَزَ أَحبُلا",16,"ل",2,0],["فَصَعَّدْتُ أَنْفاسِي وَقَطَّرْتُ أَدْمُعي","فَصَحَّ بِذا التَّدْبِيْرِ تَصْفِيرَةُ الجِسْمِ",17,"م",1,0],["فصعدت من عباب البحر زفرتها","حيث استقر أبوها نيرس الهرم",18,"م",1,0],["فَصعَّدَ في السماء بغير اذنٍ","على عَمَدٍ قَواعِدُها رَوَاسي",19,"س",2,0],["فصعدتم والموت منها نازل","ووقفتم في أرفع الدرجات",20,"ت",1,0],["فصعيدها صفر ونامي غصنها","شمع وما قد أثمرته نار",21,"ر",1,0],["فَصَعَدَ في الجَوِّ ثُمَّ اِستَدارَ","فَطارَ حَشيشاً إِذا ما اِنصَمى",22,"ا",1,0],["فَصَعْبُ الأَماني في رِضا المجدِ هَيِّنٌ","وإِنْ كانَ مَعصوماً بأَنيابِ أَغلبِ",23,"ب",1,0],["فصعودٌ طوراً وطوراً هبوطٌ","لعنَ الله هذهِ الأسعارا",24,"ر",2,0],["فَصَعَّرَ الْخَدَّ كَالْهُندوسِ مُضطرباً","وَاغتالَتِ الْحُبَّ يا عَفْرَا !!! أياديهِ",25,"ي",2,0]]}