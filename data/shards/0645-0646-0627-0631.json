[6089,"يا سيد الأرض الكريمة","https://www.poetsgate.com/ViewPoem.aspx?id=215728",""],[6093,"تأملات في الكون","https://www.poetsgate.com/ViewPoem.aspx?id=215207",""],[6106,"إلى رحمات الله ، يا أبا فيصل","https://www.poetsgate.com/ViewPoem.aspx?id=7000",""],[6127,"فداء العرش","https://www.poetsgate.com/ViewPoem.aspx?id=189496",""],[6199,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66252&r=&rc=5",""],[406,"مليون توقيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63261&r=&rc=71",""],[6318,"الفجر الدامي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66161&r=&rc=11",""],[6328,"في رحاب الضاد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82139&r=&rc=14",""]],"verses":[["مَن أَرتَجي وَإِلى ما يَنتَهي أَرَبَي","وَلَم أَطأ صَهواتِ السَبعَةِ الشُهُبِ",0,"ب",1,1],["مِن أرْيَحيَّاتٍ إذا هَبَّتْ بِها","ذِكرى الحَبيبِ نهَضْنَ بالأحشاءِ",1,"ا",2,0],["من أرض بلقيس هذا اللحن والوتر","من جوها هذه الأنسام والسحر",2,"ر",1,1],["مَنَارَةَ نَحْسٍ مِنْ نُحَاسٍ حَقِيرَة","وَقَدْ حَلَّ أَعْلاَهَا لِيَلْعَقَهَا قِطُّ",3,"ط",1,0],["مَنَارُها قَعَدَ الْبَانِي بِنِصْبَتِهِ","فَلاَ تُشِيرُ إِلَيْهِ عَيْنُ مُغْتَبِطِ",4,"ط",1,0],["مَنارٌ مِنَ الإيمانِ لَم يَعدُ أَن هَوى","وَحَبلٌ مِنَ التَقوى وَهى فَتَقَطَّعا",5,"ع",2,0],["مَنَارَةَ عَهْدٍ لِلحضَارَةِ زَاهِرٍ","بِشَتَّى حِلاهَا يَسْتَضِيءُ وَيَزْدَانُ",6,"ن",1,0],["مَنَارَةٌ بَيْنَ كُثْرٍ مِنْ مَنَائِرِهَا","فِيهَا الْهِدَايَاتُ لِلأَلْعَابِ وَالسُّفُنِ",7,"ن",1,0],["مِنْ أَرْيَحيٍّ عَظِيمٍ","مَا كَانَ بِالمُتَعَاظِمْ",8,"م",1,0],["مَنَارَةُ النُّوَّابِ إِنْ حُيِّرَتْ","سَبِيلُهُمْ فِي المَعْبَرِ المُظْلِمِ",9,"م",1,0],["من أرى ذات الشريفا","قد فهم سر ومعنيه",10,"ه",1,0],["مَن أَرادَ الكِتابَ هَذا خِطابي","فَاِقرَؤوا وَاِعلَموا بِأَنّي شَهيدُ",11,"د",1,0],["من إرثه عن أبي محمَّده","يا لك مأوى العلا ومفخرَها",12,"ر",3,0],["من ارتجاعِ عقارٍ لجَّ غاصبُه","ورَدِّ دَينٍ له في الظلمِ مُعتقَلِ",13,"ل",1,0],["مَنارُ الحُزونِ إِذا ما اِعتَلى","مَنارُ السُهولِ إِذا ما اِنقَلَب",14,"ب",1,0],["مَن أَرادَ الغِنى فَلا يَسأَلِ النا","سَ فَإِنَّ السُؤالَ ذُلٌّ وَلومُ",15,"م",1,0],["مَن أَرادَ الفُجورَ في الوُدِّ مِنّا","ضَرَبَ اللَهُ في ذِراعَيهِ غُلّا",16,"ل",2,0],["مِن أَريحِيٍّ بِالنَدى مُتَدَفِّقٍ","أَو أَحوَذِيٍّ لِلسَرى مُتَجَرِّدِ",17,"د",1,0],["مَن أَرادَ البَقاءَ وَهوَ حَبيبٌ","فَليُعِدَّن لِلحُزنِ قَلباً صَبورا",18,"ر",2,0],["مَن أَرادَ الخَيرَ فَليَعمَل لَهُ","فَعَلَيهِ لِذَوي اللُبِّ عَلَم",19,"م",1,0],["من أرفع الأبيات منزلة وقد","جمَّعن كُل محاسن النسوان",20,"ن",1,0],["منارٌ يجوبُ الدجى لمحهُ","فتلقى السفينُ به مرفأه",21,"ه",1,0],["مَنِ ارْتَعَتْ خيْلُه الرّياضَ بها","وكان حوْضَ الصّفاء موْردُها",22,"د",3,0],["مَن أراد الكتاب هذا خطابي","فاقرؤُا وأعلموا بأنّي شهيد",23,"د",1,0],["من أريحّياتٍ إذا هبَّتْ بِها","ذكرى الحبيبِ نهضَ بالأحشاءِ",24,"ا",2,0],["مَنْ أَرْخَىْ حَوْلَ مَكَانكُمَا","أَسْتَارَاً كَالسُّوْرِ الصَّخْرِيْ؟",25,"ر",2,0],["من ارض حاجر وافانا النسيم به","على المحاجر انباء واخبار",26,"ر",1,1],["مَنَارَةٌ حَائِرٍ وهُدَى غَوَىٍّ","وذِكرَةُ غَافِلٍ ورُقَى سَلِيمِ",27,"م",1,0],["مَنارُ هُدىً يَهدي القُلوبَ شُعاعُه","إِذا لَم تَلُح شَمسٌ وَلَم تَبدُ أَنجُمُ",28,"م",1,0],["مَن أَرعَفَ السَيفَ مِن هامِ العِدى غَضَباً","لِلمَجدِ حُقَّ لَهُ أَن يُرعِفَ القَلَما",29,"م",2,0],["من أَرْسَطاطاليسُ من إسكندر","من قيصر أم من أنوشِرْوان",30,"ن",1,0],["من أراد المل والرا","حة من همّ طويل",31,"ل",1,1],["مَن أَرادَ الدُخولَ لِلَّهِ مِن با","بٍ سِواهُ جَزاؤُهُ الإِقصاءُ",32,"ا",2,0],["مَن أراكَ الرحمنُ صورَتها قب","لُ حَوتها الحريرة الخضراءُ",32,"ا",2,0],["من أرضهم خُلقتْ فنا","زعتها الهوى لترابها",33,"ب",3,0],["منارات أشجاني وهالة صبوتي","ودوحة أحلام بها أتنقل",34,"ل",1,0],["منار العقل كنت بلا امتراء","ونار القلب كنت بلا ارتياب",35,"ب",1,0],["مَن أَرتَجي يا كَريمَ الدَهر تَنعَشُني","جَدواه إِن خابَ سَعيي في رَجائيكا",36,"ك",2,0],["من أرتجي دون البرايا فضلَهُ","عساه يسقي نهله وعلَّهُ",37,"ه",1,0],["من إرثه يُحرَمُ الفادي له بدمٍ","ولليهودِ احتكامٌ بعدَ إملاك",38,"ك",1,0],["مَن أراد الخلود في هذه الدنيا","فقد ضاع جهده بالمحال",39,"ل",1,0],["منارة الدمع سلْها عن ترنّمهم","أما ألانَ وأبكى الجلْمَدَ القاسي",40,"س",2,0],["مِن أربِيانٍ تَزِينُهُ شُقُقٌ","يُغبِقُ ماءَ النَدى وَيَصطَبِحُ",41,"ح",1,0],["مَن اِرتَدى بحلل الكَمالِ","حَتّى غَدَت تَسمو بِهِ المَعالي",42,"ي",1,0],["من أرقشٍ لا تَستَمدُّ شَباتُه","إلا بأسودَ يستحبُّ السُّؤدَدا",43,"د",2,0],["منارةُ القدس كانت رسمَ بِيعته","منارةِ الحق ذات السر والمُثُل",44,"ل",1,0],["من أراد لهم والغم الكبير","فليقع سلطان للناس أو وزير",45,"ر",1,1],["من أرج الأزهار","كالغادة المعطار",46,"ر",1,0],["من أرتجي من بعدهم","ظفراً قريباً بالإِياب",47,"ب",1,0],["مَنْ أراه الترياق من ضرر السّ","مّ أراه على العدوّ سماما",48,"ا",1,0],["منارٌ يُستمدُّ الرأي منه","وعنه رميَّة السَّهْمِ المصيب",49,"ب",1,0],["من أرجع التاريخ بين دروسه","عبرا وأوقفه مكان الحاضر",50,"ر",1,0],["منارُها فيكُمُ وقِبلتُها","والناسُ من تائهٍ ومن حائرْ",51,"ر",1,0],["مِن أرضِهم طينتُهُ وفيهِمُ","رواقُهُ وبيتُهُ المطنَّبُ",52,"ب",1,0],["منارتها في العين من صنعةِ الورى","ولكنها في الفكر من صنعة الجنّ",53,"ن",1,0],["مَن أراد العزَّ فيها مقيماً","فلْيُبِتْها كلَّ يومٍ طلاقا",54,"ق",2,0],["مَنارةٌ في ضواحي مِصرَ مُشرقةٌ","تُعيدُ ما قد مَضَى مِن سالِفِ الأمَدِ",55,"د",1,0],["مَنارةٌ في حِمَى بيروتَ قد سَطَعَتْ","تُنيرُ ظُلمةَ أبصارٍ وأذهانِ",56,"ن",1,0],["من أرضِنا رحمةُ الله الكريمِ أتى","مع فَيْضِ رحمتهِ من عُلْوِ أفلاكِ",57,"ك",1,0],["منارُ السَّماحِ به قَائِمٌ","وربعُ العَلاءِ به آهِلُ",58,"ل",1,0],["مَن أَروى أَبناء العَصرِ","مِن بَحر الجُود المَسجورِ",59,"ر",1,0],["من ارقني قد استلذ الارقا","ويلاه ومن اعشقه قد عشقا",60,"ق",2,1],["مَنارَةٌ كَثُرت سُرْجاً وَقَد رُفِعت","فَخِلتَها كَالثّريّا دونَ ما رِيَبِ",61,"ب",1,1],["من أراد العيش الهني فلا يعم","ل فكر أفالعيش عيش السوام",62,"م",1,0],["من أرضع ثدي حليمة فتحاشى","أن يرضع إلا الذي اقتضت به الحال",63,"ل",1,0],["من أرسل بالحق للخلائق طرا","من خصص بالصدق في المضيّ وفي الحال",63,"ل",1,0],["مِن إرثِ عَبَّاس بنِ عبدِ المُطَّلِب","وجَاءت الخَيلُ به تَشكو التَّعَب",64,"ب",1,0],["منارةُ قدس القلب يزهو ضياؤها","لها سرجٌ تنجابُ منها المظالم",65,"م",1,0],["منار هدى بل كنز علم ونائل","وما حكمة إلا لديه مقيلها",66,"ل",3,0],["من أَروع في الحق يَمضي عزمه","من أَروع في شهوة لا يَغضَب",67,"ب",1,0],["من أربع مفترقات تجمعُ","وكلها في واحد ستجمعُ",68,"ع",1,0],["من أربع مدكوكة طيّ أتى","من بعده كشف وذاك حذف تا",69,"ت",2,0],["منارٌ لأبصارِ السراة وربُّها","منالٌ لآمال العُفَاةِ إذا ضلُّوا",70,"ل",3,0],["منارة تنقذ العانى هدايتها","فينسج الحمد للبانين أثوابَا",71,"ب",2,0],["من أربعين عشية","راع المى صوت الوعيد",72,"د",1,0],["من أربعين هوت هوى","بدر العلاء إلى الصعي",72,"ي",1,0],["من أربعين خلت والكل فى حزن","وليس للصبر سلطان لدى النقمِ",73,"م",1,0],["من أربعين تولت","للنيل جزر ومدُّ",74,"د",1,0],["من أرسله اللّه من صميم قريش","في ذرة مجد علا قبائل قحطان",75,"ن",1,0],["منارُ هدًى لولاهُ لاغتدت الورى","بمجهل غيٍّ ضمَّها وهو قاتمُ",76,"م",1,0],["من أريحيٍّ بين بيضِ الظُّبَا","يومَ الوغى والسُّمُرِ الذُّبْل",77,"ل",1,0],["من أرض سابور الجنود وخيلنا","مثل القداح بَريتها بِشفار",78,"ر",1,0],["من أرادَ المَجدَ يَعلُو","ذِروَةَ الشَّرَفِ العَظيم",79,"م",1,0],["من أراد الدُّنيا تَبَوَّأَ منها","كلَّ ما يشتهي ونالَ الأماني",80,"ن",2,0],["منارته إذا اتقدت صباحاً","تباشرنا بيوم العيد ني ني",81,"ن",2,0],["من أراد الدين والدنيا معاً","فهو بالعلم ينال الاملا",82,"ل",2,0],["من أرغب الناس في الفقاح ال","لذيذة المنيك الثّقال",83,"ل",1,0],["من أراد الحج يقصده","من جميع العُرب والعجمِ",84,"م",1,0],["من أرض بابلَ قد أتاك معلماً","سحراً بسحر كلامه هاروت",85,"ت",1,0],["مِن أرضِ طَيبَةَ مِن مُهَاجَرِ أحمَدٍ","بالحقِّ والبُرهَانِ والتِّبيَانِ",86,"ن",1,0],["من ارتجي منه الصفا","إن كان ودك ليس يصفو",87,"ف",2,0],["مَنار يا بَني المَهدي أَنتُم","رَأَتهُ الناس فَاِهتَدَت السَبيلا",88,"ل",2,0],["مَن أَراد اللحوق فيكَ فَأَقصى","فَخره أَنه تَمَنى اللحوقا",89,"ق",2,0],["من أرفعٍ والدهُ أعلى وَفا الس","ادات لا زوراً ولا تكذيبا",90,"ب",2,0],["منارٌ إن تدجدجَ ليلُ هولٍ","تَلُوذُ به الموالي والموالي",91,"ل",2,0],["من أراد أن يسلك على صراطه","يطلق الدنيا الجميع فافهم",92,"م",1,0],["مِن أرضِ كاليكوتَ بالعنايَه","بأوَّلِ الستِّينَ قَبلَ المايَه",93,"ه",1,0],["مِن أَرضِ كَالِيكُوتَ مَع دَابُولِ","وَجُوزَرَاتٍ ومِنَ الدَّيُولِ