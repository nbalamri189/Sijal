{"poems":[[63,"من أرتجي وإلى ما ينتهي أربي","https://www.aldiwan.net/poem45848.html","البسيط"],[63,"طرقت ونحن بسرة البطحاء","https://www.aldiwan.net/poem46215.html","الكامل"],[100,"من أرض بلقيس","https://www.aldiwan.net/poem43676.html","عموديه"],[77,"إذا نزع الأثواب جعسوس خلته","https://www.aldiwan.net/poem36387.html","الطويل"],[77,"ماذا لقينا بماغوس من اللغط","https://www.aldiwan.net/poem36393.html","البسيط"],[73,"ألا هل درى الداعي المثوب إذ دعا","https://www.aldiwan.net/poem11947.html","الطويل"],[93,"لذكراك يا حفني في النفس أشجان","https://www.aldiwan.net/poem11210.html","الطويل"],[93,"في حيكم لي قلب جد مرتهن","https://www.aldiwan.net/poem11218.html","البسيط"],[93,"لانت صلاب العزائم","https://www.aldiwan.net/poem11341.html","المجتث"],[93,"في أي جو بالأسى مفعم","https://www.aldiwan.net/poem11348.html","السريع"],[83,"شت أن معين مبارك","https://www.aldiwan.net/poem54201.html","مجزوء الرمل"],[64,"لا تلمني فاللوم مني بعيد","https://www.aldiwan.net/poem67656.html","الخفيف"],[51,"أشد بأيامنا لتشهرها","https://www.aldiwan.net/poem64036.html","المنسرح"],[51,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[85,"فديناه من زائر مرتقب","https://www.aldiwan.net/poem8090.html","المتقارب"],[49,"كل حي كتابه معلوم","https://www.aldiwan.net/poem63100.html","الخفيف"],[31,"جن قلبي فقلت يا قلب مهلا","https://www.aldiwan.net/poem41849.html","الخفيف"],[105,"فزع الدجى لأنينه المتردد","https://www.aldiwan.net/poem43163.html","الكامل"],[46,"يا حصان النساء كم فارسا ول","https://www.aldiwan.net/poem22638.html","الخفيف"],[46,"صاحب الشرطة إن أنصفني","https://www.aldiwan.net/poem23428.html","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16625","المنسرح"],[64,"لا تَلمنّي فاللوم منّي بعيد","https://www.poetsgate.com/ViewPoem.aspx?id=8519",""],[63,"طَرَقَتْ ، ونحنُ بِسُرَّة ِ البَطْحاءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=25946&r=&rc=8",""],[100,"قتيلان .. هما القاتل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85961&r=&rc=231",""],[116,"من ارض حاجر وافانا النسيم به","https://www.aldiwan.net/poem41114.html","عموديه"],[133,"طربت لحضرة الشيخ الخديم","https://www.aldiwan.net/poem54741.html","الوافر"],[151,"أجد مدح خير الخلق ذاتا وجودة","https://www.aldiwan.net/poem68582.html","الطويل"],[170,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[186,"بجلال قدرك تفخر الأزمان","https://www.aldiwan.net/poem14677.html","الكامل"],[187,"من أراد المل والراحة","https://www.aldiwan.net/poem43484.html","مجزوء الرمل"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[200,"خل القلوب لما بها","https://www.aldiwan.net/poem45576.html","مجزوء الكامل"],[212,"صدقت ولكن كيف تلك رواية","https://www.aldiwan.net/poem46328.html","الطويل"],[212,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[253,"أما كفاك تلافي في تلافيكما","https://www.aldiwan.net/poem1474.html",""],[260,"باسمك يا الله ربي ابتدي","https://www.aldiwan.net/poem35938.html","الرجز"],[271,"حبي الخليفة مولانا ومولاك","https://www.aldiwan.net/poem35652.html","البسيط"],[291,"لا تضني بالدمع يا عين ما الدمع","https://www.aldiwan.net/poem11695.html","الخفيف"],[299,"على الزعازع والأهوال والبأس","https://www.aldiwan.net/poem36834.html","البسيط"],[323,"أشتقت وانهل دمع عينك أن","https://www.aldiwan.net/poem56345.html","المنسرح"],[354,"الحمد لله أَتم الحمد","https://www.aldiwan.net/poem38727.html","الرجز"],[372,"أما الحديث بما صنعت فقد بدا","https://www.aldiwan.net/poem57485.html","الكامل"],[378,"قلب يذوب إلى الأطلال والحلل","https://www.aldiwan.net/poem59287.html","البسيط"],[392,"من أراد لهم والغم الكبير","https://www.aldiwan.net/poem54561.html","عموديه"],[404,"مولاي قد أحسنتم","https://www.aldiwan.net/poem33347.html","مجزوء الرجز"],[404,"نظم أرق من الشراب","https://www.aldiwan.net/poem34142.html","مجزوء الكامل"],[417,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[417,"هلم بنا نزور أبا الخصيب","https://www.aldiwan.net/poem54011.html","الوافر"],[454,"يا شعر من ترجو تحسب أنه","https://www.aldiwan.net/poem61226.html","الكامل"],[459,"هل لقتيل على اللوى ثائر","https://www.aldiwan.net/poem56169.html","المنسرح"],[459,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[465,"سقى الله بالإسكندرية منزلاً","https://www.aldiwan.net/poem3376.html","عموديه"],[552,"قربا مني القلاص العتاقا","https://www.aldiwan.net/poem47367.html","المديد"],[563,"بنو عبيد أقاموا اليوم مدرسة","https://www.aldiwan.net/poem52581.html","البسيط"],[563,"اليوم لاح لنا في الحي شمسان","https://www.aldiwan.net/poem52711.html","البسيط"],[563,"يا أرض بيروت بشرانا وبشراك","https://www.aldiwan.net/poem52776.html","البسيط"],[576,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"]],"verses":[["مَن أَرتَجي وَإِلى ما يَنتَهي أَرَبَي","وَلَم أَطأ صَهواتِ السَبعَةِ الشُهُبِ",0,"ب",1,1],["مِن أرْيَحيَّاتٍ إذا هَبَّتْ بِها","ذِكرى الحَبيبِ نهَضْنَ بالأحشاءِ",1,"ا",2,0],["من أرض بلقيس هذا اللحن والوتر","من جوها هذه الأنسام والسحر",2,"ر",1,1],["مَنَارَةَ نَحْسٍ مِنْ نُحَاسٍ حَقِيرَة","وَقَدْ حَلَّ أَعْلاَهَا لِيَلْعَقَهَا قِطُّ",3,"ط",1,0],["مَنَارُها قَعَدَ الْبَانِي بِنِصْبَتِهِ","فَلاَ تُشِيرُ إِلَيْهِ عَيْنُ مُغْتَبِطِ",4,"ط",1,0],["مَنارٌ مِنَ الإيمانِ لَم يَعدُ أَن هَوى","وَحَبلٌ مِنَ التَقوى وَهى فَتَقَطَّعا",5,"ع",2,0],["مَنَارَةَ عَهْدٍ لِلحضَارَةِ زَاهِرٍ","بِشَتَّى حِلاهَا يَسْتَضِيءُ وَيَزْدَانُ",6,"ن",1,0],["مَنَارَةٌ بَيْنَ كُثْرٍ مِنْ مَنَائِرِهَا","فِيهَا الْهِدَايَاتُ لِلأَلْعَابِ وَالسُّفُنِ",7,"ن",1,0],["مِنْ أَرْيَحيٍّ عَظِيمٍ","مَا كَانَ بِالمُتَعَاظِمْ",8,"م",1,0],["مَنَارَةُ النُّوَّابِ إِنْ حُيِّرَتْ","سَبِيلُهُمْ فِي المَعْبَرِ المُظْلِمِ",9,"م",1,0],["من أرى ذات الشريفا","قد فهم سر ومعنيه",10,"ه",1,0],["مَن أَرادَ الكِتابَ هَذا خِطابي","فَاِقرَؤوا وَاِعلَموا بِأَنّي شَهيدُ",11,"د",1,0],["من إرثه عن أبي محمَّده","يا لك مأوى العلا ومفخرَها",12,"ر",3,0],["من ارتجاعِ عقارٍ لجَّ غاصبُه","ورَدِّ دَينٍ له في الظلمِ مُعتقَلِ",13,"ل",1,0],["مَنارُ الحُزونِ إِذا ما اِعتَلى","مَنارُ السُهولِ إِذا ما اِنقَلَب",14,"ب",1,0],["مَن أَرادَ الغِنى فَلا يَسأَلِ النا","سَ فَإِنَّ السُؤالَ ذُلٌّ وَلومُ",15,"م",1,0],["مَن أَرادَ الفُجورَ في الوُدِّ مِنّا","ضَرَبَ اللَهُ في ذِراعَيهِ غُلّا",16,"ل",2,0],["مِن أَريحِيٍّ بِالنَدى مُتَدَفِّقٍ","أَو أَحوَذِيٍّ لِلسَرى مُتَجَرِّدِ",17,"د",1,0],["مَن أَرادَ البَقاءَ وَهوَ حَبيبٌ","فَليُعِدَّن لِلحُزنِ قَلباً صَبورا",18,"ر",2,0],["مَن أَرادَ الخَيرَ فَليَعمَل لَهُ","فَعَلَيهِ لِذَوي اللُبِّ عَلَم",19,"م",1,0],["من أرفع الأبيات منزلة وقد","جمَّعن كُل محاسن النسوان",20,"ن",1,0],["منارٌ يجوبُ الدجى لمحهُ","فتلقى السفينُ به مرفأه",21,"ه",1,0],["مَنِ ارْتَعَتْ خيْلُه الرّياضَ بها","وكان حوْضَ الصّفاء موْردُها",22,"د",3,0],["مَن أراد الكتاب هذا خطابي","فاقرؤُا وأعلموا بأنّي شهيد",23,"د",1,0],["من أريحّياتٍ إذا هبَّتْ بِها","ذكرى الحبيبِ نهضَ بالأحشاءِ",24,"ا",2,0],["مَنْ أَرْخَىْ حَوْلَ مَكَانكُمَا","أَسْتَارَاً كَالسُّوْرِ الصَّخْرِيْ؟",25,"ر",2,0],["من ارض حاجر وافانا النسيم به","على المحاجر انباء واخبار",26,"ر",1,1],["مَنَارَةٌ حَائِرٍ وهُدَى غَوَىٍّ","وذِكرَةُ غَافِلٍ ورُقَى سَلِيمِ",27,"م",1,0],["مَنارُ هُدىً يَهدي القُلوبَ شُعاعُه","إِذا لَم تَلُح شَمسٌ وَلَم تَبدُ أَنجُمُ",28,"م",1,0],["مَن أَرعَفَ السَيفَ مِن هامِ العِدى غَضَباً","لِلمَجدِ حُقَّ لَهُ أَن يُرعِفَ القَلَما",29,"م",2,0],["من أَرْسَطاطاليسُ من إسكندر","من قيصر أم من أنوشِرْوان",30,"ن",1,0],["من أراد المل والرا","حة من همّ طويل",31,"ل",1,1],["مَن أَرادَ الدُخولَ لِلَّهِ مِن با","بٍ سِواهُ جَزاؤُهُ الإِقصاءُ",32,"ا",2,0],["مَن أراكَ الرحمنُ صورَتها قب","لُ حَوتها الحريرة الخضراءُ",32,"ا",2,0],["من أرضهم خُلقتْ فنا","زعتها الهوى لترابها",33,"ب",3,0],["منارات أشجاني وهالة صبوتي","ودوحة أحلام بها أتنقل",34,"ل",1,0],["منار العقل كنت بلا امتراء","ونار القلب كنت بلا ارتياب",35,"ب",1,0],["مَن أَرتَجي يا كَريمَ الدَهر تَنعَشُني","جَدواه إِن خابَ سَعيي في رَجائيكا",36,"ك",2,0],["من أرتجي دون البرايا فضلَهُ","عساه يسقي نهله وعلَّهُ",37,"ه",1,0],["من إرثه يُحرَمُ الفادي له بدمٍ","ولليهودِ احتكامٌ بعدَ إملاك",38,"ك",1,0],["مَن أراد الخلود في هذه الدنيا","فقد ضاع جهده بالمحال",39,"ل",1,0],["منارة الدمع سلْها عن ترنّمهم","أما ألانَ وأبكى الجلْمَدَ القاسي",40,"س",2,0],["مِن أربِيانٍ تَزِينُهُ شُقُقٌ","يُغبِقُ ماءَ النَدى وَيَصطَبِحُ",41,"ح",1,0],["مَن اِرتَدى بحلل الكَمالِ","حَتّى غَدَت تَسمو بِهِ المَعالي",42,"ي",1,0],["من أرقشٍ لا تَستَمدُّ شَباتُه","إلا بأسودَ يستحبُّ السُّؤدَدا",43,"د",2,0],["منارةُ القدس كانت رسمَ بِيعته","منارةِ الحق ذات السر والمُثُل",44,"ل",1,0],["من أراد لهم والغم الكبير","فليقع سلطان للناس أو وزير",45,"ر",1,1],["من أرج الأزهار","كالغادة المعطار",46,"ر",1,0],["من أرتجي من بعدهم","ظفراً قريباً بالإِياب",47,"ب",1,0],["مَنْ أراه الترياق من ضرر السّ","مّ أراه على العدوّ سماما",48,"ا",1,0],["منارٌ يُستمدُّ الرأي منه","وعنه رميَّة السَّهْمِ المصيب",49,"ب",1,0],["من أرجع التاريخ بين دروسه","عبرا وأوقفه مكان الحاضر",50,"ر",1,0],["منارُها فيكُمُ وقِبلتُها","والناسُ من تائهٍ ومن حائرْ",51,"ر",1,0],["مِن أرضِهم طينتُهُ وفيهِمُ","رواقُهُ وبيتُهُ المطنَّبُ",52,"ب",1,0],["منارتها في العين من صنعةِ الورى","ولكنها في الفكر من صنعة الجنّ",53,"ن",1,0],["مَن أراد العزَّ فيها مقيماً","فلْيُبِتْها كلَّ يومٍ طلاقا",54,"ق",2,0],["مَنارةٌ في ضواحي مِصرَ مُشرقةٌ","تُعيدُ ما قد مَضَى مِن سالِفِ الأمَدِ",55,"د",1,0],["مَنارةٌ في حِمَى بيروتَ قد سَطَعَتْ","تُنيرُ ظُلمةَ أبصارٍ وأذهانِ",56,"ن",1,0],["من أرضِنا رحمةُ الله الكريمِ أتى","مع فَيْضِ رحمتهِ من عُلْوِ أفلاكِ",57,"ك",1,0],["منارُ السَّماحِ به قَائِمٌ","وربعُ العَلاءِ به آهِلُ",58,"ل",1,0]]}