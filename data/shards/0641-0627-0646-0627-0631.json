{"poems":[[95,"جرحت أثخن جرح","https://www.aldiwan.net/poem11240.html","المجتث"],[90,"سمعت شعرا للعندليب","https://www.aldiwan.net/poem44413.html","مخلع البسيط"],[53,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[53,"ليوقن من يعارضني بأني","https://www.aldiwan.net/poem65446.html","الوافر"],[80,"هذي السعادة قد قامت على قدم","https://www.aldiwan.net/poem14270.html","البسيط"],[47,"ليل بذي الأثل عناني تطاوله","https://www.aldiwan.net/poem65602.html","البسيط"],[47,"إلام بابك معقودا على أمل","https://www.aldiwan.net/poem65617.html","البسيط"],[30,"فقالت أليس ابن الوليد الذي له","https://www.aldiwan.net/poem5011.html","الطويل"],[63,"تذكر أيامه الخاليه","https://www.aldiwan.net/poem51396.html","المتقارب"],[60,"إذا أظمأتك أكف الرجال","https://www.aldiwan.net/poem30794.html","المتقارب"],[68,"يا سادة مذ سعت عن بابهم قدمي","https://www.aldiwan.net/poem40332.html","البسيط"],[54,"يا دار يا دار أطرابي وأشجاني","https://www.aldiwan.net/poem26663.html","البسيط"],[54,"سكنتك يا دنيا برغمي مكرها","https://www.aldiwan.net/poem26935.html","الطويل"],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85594","المجتث"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147577","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55087","الهزج"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55156","الكامل"],[111,"عش ما نشاء وراقب فجعة الأجل","https://www.poetsgate.com/ViewPoem.aspx?id=520",""],[136,"يا عجبا لقادر","https://www.aldiwan.net/poem54833.html","مجزوء الرجز"],[173,"إلى م أرجي ضر عيش منكدا","https://www.aldiwan.net/poem1615.html",""],[228,"ما لسلمى التي استبدت وما لي","https://www.aldiwan.net/poem41624.html","الخفيف"],[240,"خليفة الله أنت في الدين وال","https://www.aldiwan.net/poem31824.html","المنسرح"],[276,"بارق بالابرق الفرد سرى","https://www.aldiwan.net/poem52054.html","الرمل"],[286,"جهل الطبيب شكايتي وشكايتي","https://www.aldiwan.net/poem1368.html",""],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[369,"قلب المشوق بأن يساعد أجدر","https://www.aldiwan.net/poem60910.html","الكامل"],[382,"إذا أطراك إنسان بمدحٍ","https://www.aldiwan.net/poem59212.html","الوافر"],[396,"وليس للمرء بعد الموت من شجر","https://www.aldiwan.net/poem54444.html","عموديه"],[409,"فقلت حسبكما لله دركما","https://www.aldiwan.net/poem33440.html","البسيط"],[411,"شوقي إليك ربيع القلب ملبسه","https://www.aldiwan.net/poem49815.html","البسيط"],[458,"عرفناك يا يوم عيد الحياة","https://www.aldiwan.net/poem61253.html","المتقارب"],[473,"ما صاحب المرء من إن زل عاقبه","https://www.aldiwan.net/poem60062.html","البسيط"],[500,"خلقت كما ترى صعب الثقاف","https://www.aldiwan.net/poem10241.html","الوافر"],[505,"تحت شراع الرفرف","https://www.aldiwan.net/poem37961.html","مجزوء الرجز"],[563,"ظهرت ذاتي لذاتي","https://www.aldiwan.net/poem34729.html","مجزوء الرمل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44582","الرجز"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123431","المتقارب"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70928","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119964","الكامل"],[1052,"","https://poetry.dctabudhabi.ae/diwan/poem/130881","البسيط"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138062","الرجز"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101982","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56142","الوافر"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46530","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109261","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109130","البسيط"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113957","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77956","الوافر"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87866","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87839","البسيط"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108423","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27611","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27233","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27227","الكامل"],[2581,"","https://poetry.dctabudhabi.ae/diwan/poem/141564","الوافر"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94320","الرجز"],[2815,"","https://poetry.dctabudhabi.ae/diwan/poem/105748","الوافر"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117024","الطويل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82830","البسيط"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/133005","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138510",""],[3656,"","https://poetry.dctabudhabi.ae/diwan/poem/133926","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92376","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205879","الهزج"],[3741,"","https://poetry.dctabudhabi.ae/diwan/poem/121172","الوافر"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69955","الرمل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119633","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94584","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94582","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94411","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72507","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72669","المجتث"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139520",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139665",""],[4626,"","https://poetry.dctabudhabi.ae/diwan/poem/102855","البسيط"],[4767,"الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=87662",""],[4859,"تأبى الأسود بأن تقتات بالجيفِ!","https://www.poetsgate.com/ViewPoem.aspx?id=191558",""],[4862,"في رضاع الكبير","https://www.poetsgate.com/ViewPoem.aspx?id=89595",""],[4984,"مخرج النجاة","https://www.poetsgate.com/ViewPoem.aspx?id=175599",""],[4984,"نَشِيدُ النَّصْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=197045",""],[585,"يا جيرة البان مهلاً واسألوا البانا","https://www.poetsgate.com/ViewPoem.aspx?id=161926",""],[5121,"قَلَمِي","https://www.poetsgate.com/ViewPoem.aspx?id=33498",""],[5121,"حرف الجن","https://www.poetsgate.com/ViewPoem.aspx?id=36286",""],[5121,"لا يا عزيزي","https://www.poetsgate.com/ViewPoem.aspx?id=37455",""],[5150,"المرأة .. بنصف عقل ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203061",""],[5183,"مِشْكاة المَلاَغِز","https://www.poetsgate.com/ViewPoem.aspx?id=186412",""],[5183,"إلى البهلاني","https://www.poetsgate.com/ViewPoem.aspx?id=180208",""],[5184,"عندما يموت المعتصم","https://www.poetsgate.com/ViewPoem.aspx?id=186083",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5690,"لما أعاد مليكنا","https://www.poetsgate.com/ViewPoem.aspx?id=172280",""],[5943,"ياصحبة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=34332",""],[6097,"عَكّارُنا","https://www.poetsgate.com/ViewPoem.aspx?id=190700",""],[5309,"لما رأيت الغنى والفقر قد سلبا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573948",""],[5309,"ذكرى ليالي الهوى العذري تصبينا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573536",""]],"verses":[["فَإنْ أرَدْتَ سُلُوَّا","أحْسِنْ وَمَا اسْطَعْتَ أحْسِنْ",0,"ن",1,0],["فإن أردتم أن تؤنسوني","ففي المباني لا تحبسوني",1,"ي",1,0],["فإن ارتبتَ باليمن وما حق","قُ يمينٍ حلفتُها أن تُريبا",2,"ب",2,0],["فإن ارتبتَ في العقوبة بالقت","ل فأدِّبْ وأحسنِ التأديبا",2,"ب",2,0],["فإن أربى عليَّ بنيتُ قصراً","يطول بسوره الشرف الشريفا",3,"ف",2,0],["فإن أربى علي بنيت طوداً","يجوز النجم والسقف المطيفا",3,"ف",2,0],["فَإِن أَرَدتَ إِلَهي بِالوَرى حُسناً","فَمَلَّكَني زِمامَ الدَهرِ وَالأُمَمِ",4,"م",1,0],["فَإِن أَرابَ صَديقي في الوِدادِ فَكَم","أَمسَيتُ أَحذَرُ ما أَصبَحتُ آمُلُهُ",5,"ل",2,0],["فَإِن أَرَدتُكَ عَرَّضتُ الرَسولَ لِما","أَخشى مِنَ الرَدِّ وَاِستَأذَنتُ مِن ميلِ",6,"ل",1,0],["فَإِنَّ اِرتِدادَ الهَمَّ عَجزٌ عَلى الفَتى","عَلَيهِ كَما رُدَّ البَعيرُ المُقَيَّدُ",7,"د",1,0],["فإِن أرَها سَالِماً أستَلِم","فَوارِعَ أركانِها العالِيه",8,"ي",2,0],["فَإِنَّ إِراقَةَ ماءَ الحَيا","ةِ دونَ إِراقَةِ ماءِ المُحَيّا",9,"ي",2,0],["فَإِن أَرَدتُم لَها البُقيا بِقُربِكُمُ","تَدارَكوها وَفي أَغصانِها وَرَقُ",10,"ق",1,0],["فَإِن أَرَدتِ وِصالاً فَاِقبَلي صِلَتي","مِنّي وَإِلّا فَهِجرانٌ بِهِجرانِ",11,"ن",1,0],["فَإِن أَرتَحِل يَوماً أَدَعكِ ذَميمَةً","وَما فيكِ مِن دَعوى غِراسٍ وَلا بَذرُ",12,"ر",1,0],["فَإِنَّ أَروَاحَنا مِثلَ النُّجُومِ لها","مِنَ المَنِيَّةِ تَسْيِيرٌ وَتَرْحِيلُ",13,"ل",1,0],["فإن أَردت رحيلاً","فما عليّ ملام",14,"م",1,0],["فإن أرتحل يوماً أدعك ذميمة","وما فيك من عودي غراس ولا بذر",15,"ر",1,0],["فَإِنْ أَرضَاكَ هَذَا التَّرْكُ","عِشْ وَالعِزُّ سِرْبَالُكْ",16,"ك",1,0],["فَأَنَارَ أَهْلَ الحَزْمِ كُل حَقِيقَة","وَأَثَارَ أَهْلَ العَزْمِ كُلُّ خَيَالِ",17,"ل",1,0],["فان أرواح أهل الله فاعلة","بقوة الحق لا بالحل والنقل",18,"ل",1,0],["فَإِن أرَدتَ مُتَضًَى","رِضَى الإلهِ القَادِرِ",19,"ر",1,0],["فَإِن أَرتحِل عَن دارِ قَومي لِنبوَةٍ","وَيُصبِحُ رَبعي فيهمُ قَد تَأَبَّدا",20,"د",2,0],["فَأَنا راحِلٌ عَن الكَونِ عَلّي","أَجِد المكر نائِياً في اِرتِحالي",21,"ل",2,0],["فَإِن أَرَدتُم أَمراً يَزولُ بِهِ","الخِصامُ مِن بَينِنا وَيَرتَفِعُ",22,"ع",1,0],["فأنار النور من فضيه","في ربا تلك النواحي زهرا",23,"ر",2,0],["فإن أرتضي برئي تدارك فضله","وإن ارتضى سقمي رضيت بمارضي",24,"ض",2,0],["فإن أَردتَ فاِسمَعِ","حديثَه كيما تَعي",25,"ي",1,0],["فإن أَردتُم فقَعوا","لا يَعتَريكم جَزَعُ",25,"ع",1,0],["فان أَردتَ طولَه","فَصدِّقنَّ قولَه",25,"ه",1,0],["فإنِ ارتضَوا حُكْمِي فغيرُ بديعةٍ","من مثْلِ ذاكَ البحرِ هذا الجوهر",26,"ر",1,0],["فإن أرضاك زد للَه شكراً","وإن أغواك فُز بالبعد عنهُ",27,"ه",1,0],["فإن أردت معينا تستعين به","على المهمات فاطلب من يجليها",28,"ي",3,0],["فإن أراد الضيا هذا فقد نطقت","بالحق أبياته لامسه السقم",29,"م",1,0],["فإن أردْتَ له مِثْلاً يُشابِهُهُ","فانظُرْ إلى حُسنِ فعلِ الشَّمسِ في الحَمَلِ",30,"ل",1,0],["فإنا رعاة حقوق الشعوب","ولو بينها المرهق الأعزل",31,"ل",1,0],["فَإِن أَرَدتَ وِصالاً لا يُكَدِّرُهُ","هَجرٌ فَكُن صافِياً لِلخِلِّ إِن كَدَرا",32,"ر",2,0],["فإن أرحل فعن حسب كريم","وعن خلق كماء المزن صاف",33,"ف",1,0],["فإنْ أَردْتَ نَيْلَهُ","فاثْبُتْ على قلبٍ صَفي",34,"ف",2,0],["فأنارت أرض قلبي","وبها ضاءت جهاتي",35,"ت",2,0],["فإن أردت أنه أوصانا","بالسمع والطاعة كنت صادق",36,"ق",1,0],["فَإِن أَرَدتَ الشُربَ في إِبانِهِ","عَلى الَّذي وَصَفتُهُ مِن شانِهِ",37,"ه",1,0],["فَإِن أَرَدتَ الشُربَ لِلعُقارِ","في حينِهِ بِاللَيلِ وَالنَهارِ",37,"ر",1,0],["فَإِن أَرَدتَ بِالنَهارِ الشُربا","فيهِ فَقَد قاسَيتَ خَطباً صَعبا",37,"ب",2,0],["فإنّا رِضِيعا وِدادٍ صَفا","وناسي الرِّضاعة بئس الرَّضيعُ",38,"ع",1,1],["فإنْ أُرِدْ منهمُ ما أبتغيه فقد","يُصاب من بعد حمل القربةِ العُرَقُ",39,"ق",1,0],["فأنار نور العدل حي","ن دجت نواحيه وأصبح",40,"ح",1,0],["فان أراع رعاع الجهل سحرهم","فمر يراعك يلقف كل ما سحروا",41,"ر",3,0],["فَإنْ أُرِيْدَ الْحِفْظُ وَالضَّبْطُ لِما","قَدْ جاءَنا وَما يَقُوْلُ الْعُلَما",42,"م",2,0],["فإن أردت له مثلا فلست ترى","وإن طلبت له شبها فلم تجد",43,"د",1,0],["فان أرسلت ما قلنا","على مرغوبنا تُحمدْ",44,"د",1,0],["فَإِن أَرادوك لَها","فَلا تَكُن مولها",45,"ه",2,0],["فإن أردت اليوم أن","تعيش عيشاً مؤتمن",46,"ن",1,0],["فإن أردت شفائي كنت بعدئذ","طوع العناق فكن في الحب طوع يدي",47,"د",2,0],["فإنّا رعَينا أنفَ ناضرِ روضهِ","محلَّ الخليطِ الجوَّ جوّ المُبَيدعِ",48,"ع",1,0],["فإن أَرضاك سفك دمي","وَقطع الإرب بالقُضُب",49,"ب",1,0],["فإِنِ اِرتَضَى الدّاءَ العُقامَ وَذِلَّةً","قَد خَابَ أُنساً وَاستَحَقَّ جَفَاكُمُ",50,"م",1,0],["فَإِن أَرَدتِ دَليلاً فَاِسأَلي أَرَقي","سُهدي دَليلي وَدَمعي خَيرُ بُرهانِ",51,"ن",1,0],["فانارت كل ربع مظلم","بسنا الحسن الذي لم يغب",52,"ب",1,0],["فأنا رومٌ لأني","شاهد أصلِّي وأسي",53,"س",2,0],["فأنارت أرض الوجودِ وأبدت","كلَّ شيء مخبأ في البطاح",54,"ح",1,0],["فأنار روضَ القلبِ في ملكوته","وأتتْ بكلِّ حقيقة أشجارُه",55,"ر",2,0],["فإن أرد الأنيس أعش ذليلاً","وإن أرد التعزز أبق وحدي",56,"د",2,0],["فان أردت الواجب ابتداء","فهو الذي لا يقبل 