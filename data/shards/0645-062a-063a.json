{"poems":[[53,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[53,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[55,"يا هجر كف عن الهوى ودع الهوى","https://www.aldiwan.net/poem26307.html","الكامل"],[51,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[51,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[92,"كنا كزوجي طائر","https://www.aldiwan.net/poem38903.html","مجزوء الكامل"],[45,"أما الخيال فإنه لم يطرق","https://www.aldiwan.net/poem65181.html","الكامل"],[28,"متغطرفين وخندف من حولهم","https://www.aldiwan.net/poem5217.html","الكامل"],[97,"عجباً لعارية كساها","https://www.aldiwan.net/poem25001.html","مجزوء الكامل"],[80,"يوم كأن نسيمه","https://www.aldiwan.net/poem31222.html","مجزوء الكامل"],[69,"والنار أيضا من جنود نبينا","https://www.aldiwan.net/poem28057.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54894","الكامل"],[45,"أمّا الخَيالُ، فإنّهُ لمْ يَطْرُقِ","https://www.poetsgate.com/ViewPoem.aspx?id=32849",""],[378,"سعدت نفوس بالإله الأعظم","https://www.aldiwan.net/poem59265.html","الكامل"],[394,"متغايرات قد جمعن وكلها","https://www.aldiwan.net/poem53590.html","الكامل"],[410,"لما رأيت صروف هذا","https://www.aldiwan.net/poem32056.html","مجزوء الكامل"],[442,"خل الكئيب بدائه في ذاته","https://www.aldiwan.net/poem14341.html","الكامل"],[454,"ذكرى يرددها الزمان الوافي","https://www.aldiwan.net/poem61693.html","الكامل"],[462,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[516,"شأن الغرام أجل أن يلحاني","https://www.aldiwan.net/poem12277.html","الكامل"],[568,"يا من لأجفان قريحه","https://www.aldiwan.net/poem69759.html","مجزوء الرجز"]],"verses":[["مُتَغَرِّباً لا أَستَجيرُ بِمَنزِلٍ","فَإِذا نَزَلتُ فَعَقلَةُ الضيفانِ",0,"ن",1,0],["مُتَغَطرِفاً كَالسَيلِ يَب","طُشُ بِالجَنادِلِ وَالصُخورِ",1,"ر",1,0],["مُتَغَيِّرينَ مِنَ الهَوى أَلوانُهُم","مِمّا تُجِنُّ قُلوبُهمُ صُفرُ",2,"ر",1,0],["متغافلاً عن ذكر ما أسديْتَهُ","وإذا وعدْتَ فذاكرٌ لا تغفُلُ",3,"ل",1,0],["متغزلات عند أروع ما لَهُ","إلا مع المِدَح الوِضاءِ تغزُّلُ",3,"ل",1,0],["مُتَغَنَّم الضَّحكاتِ مُثْمِنُها","وله لقاءٌ غيرُ مُغْتَنَمِ",4,"م",1,0],["مُتَغَرِّدينَ مع البَلابلِ","في السُّهولِ وفي الحزونْ",5,"ن",1,0],["مُتَغَمِّدٌ يَهَبُ الذُنوبَ وَعَهدُها","لَم يَستَطِل وَجَديدُها لَم يُشلِقِ",6,"ق",1,0],["مُتَغَطرِفينَ وَخِندِفٌ مِن حَولِهِم","كَاللَيلِ إِذ جاءَت بِعِزٍّ قَسوَرِ",7,"ر",1,1],["متغاير الإبداع مُخ","تلف المحاسن جامعا",8,"ع",2,0],["مُتَغَيّرٌ غيناً وصَح","واً مثل ما حدّثْتُ عنكِ",9,"ك",1,0],["متغلِّبونَ مخرِّبونَ بسحتِهم","حرمَ النبيِّ فطهَّرتْه النارُ",10,"ر",1,0],["مُتَغَفِّراً مُتَدَرِّعاً إِنْ صَرَّحَت","حَربٌ وقَالَ الحانِقونَ نَزَالِ",11,"ل",1,0],["مُتَغَنِّيَاتٍ مِنْ أَهَازِيجِ الصِّبا","مَا شَاءَ وَحْيُ هَوَىً وَطِيبُ هَوَاءِ",12,"ا",2,0],["متَغَامِزْونَ بِعَجْزِهِمْ","مُتَقَاصرِونَ مِنْ القُصُورِ",13,"ر",1,0],["مُتَغَمِّدٌ يَهَبُ الذّنوبَ، وَعهدُها","لمْ يَستَطِلْ، وَجديدُها لم يُخلِقِ",14,"ق",1,0],["متغرِّباً متنسكاً متقشفاً","متوشحاً بالصبر كالليث الكمي",15,"م",2,0],["مُتَغايِراتٌ قَد جُمِعنَ وَكلُّها","مُتَشاكل أَشباحُها أَرواحُ",16,"ح",1,1],["مُتغايرَ الأحوالِ مُخْ","تَلِفَ الضرائِبِ والسَّجَايا",17,"ا",3,0],["متغيراً عند الوداع فمهجتي","كادت به تنسل من عبراته",18,"ت",2,0],["متغلغلا بِنهىَ الفوارسِ دافعاً","من يُحجمون إلى الخلود الضافي",19,"ف",2,0],["مُتغطمطاً غصب الوحوش مكانها","تيَّارهُ فالضبُّ جارُ الضِّفْدعِ",20,"ع",1,0],["متغاير الأوصاف فوق جبينه","بشر الولي وهيبة السلطان",21,"ن",1,0],["مُتَغَيِّراً منها مُعَلْ","لَى المَجْدِ مُجْتَنِياً مَنِيْحَهْ",22,"ح",2,0]]}