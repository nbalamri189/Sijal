{"poems":[[55,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[55,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[57,"يا هجر كف عن الهوى ودع الهوى","https://www.aldiwan.net/poem26307.html","الكامل"],[53,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[53,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[94,"كنا كزوجي طائر","https://www.aldiwan.net/poem38903.html","مجزوء الكامل"],[47,"أما الخيال فإنه لم يطرق","https://www.aldiwan.net/poem65181.html","الكامل"],[30,"متغطرفين وخندف من حولهم","https://www.aldiwan.net/poem5217.html","الكامل"],[99,"عجباً لعارية كساها","https://www.aldiwan.net/poem25001.html","مجزوء الكامل"],[82,"يوم كأن نسيمه","https://www.aldiwan.net/poem31222.html","مجزوء الكامل"],[71,"والنار أيضا من جنود نبينا","https://www.aldiwan.net/poem28057.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54894","الكامل"],[47,"أمّا الخَيالُ، فإنّهُ لمْ يَطْرُقِ","https://www.poetsgate.com/ViewPoem.aspx?id=32849",""],[382,"سعدت نفوس بالإله الأعظم","https://www.aldiwan.net/poem59265.html","الكامل"],[398,"متغايرات قد جمعن وكلها","https://www.aldiwan.net/poem53590.html","الكامل"],[415,"لما رأيت صروف هذا","https://www.aldiwan.net/poem32056.html","مجزوء الكامل"],[447,"خل الكئيب بدائه في ذاته","https://www.aldiwan.net/poem14341.html","الكامل"],[458,"ذكرى يرددها الزمان الوافي","https://www.aldiwan.net/poem61693.html","الكامل"],[466,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[520,"شأن الغرام أجل أن يلحاني","https://www.aldiwan.net/poem12277.html","الكامل"],[572,"يا من لأجفان قريحه","https://www.aldiwan.net/poem69759.html","مجزوء الرجز"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112434","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119932","الكامل"],[1738,"","https://poetry.dctabudhabi.ae/diwan/poem/124297","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109347","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77349","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58260","الكامل"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216549",""],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40049","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90811","الكامل"],[4902,"ميت وأنا حي","https://www.poetsgate.com/ViewPoem.aspx?id=22607",""],[5277,"المرثيّة الكاظميّة","https://www.poetsgate.com/ViewPoem.aspx?id=187574",""],[5284,"المُبعدون","https://www.poetsgate.com/ViewPoem.aspx?id=205895",""],[5411,"مُتَغَرّبٌ نِسرين بَوحي","https://www.poetsgate.com/ViewPoem.aspx?id=190992",""],[5431,"قطوف عشقٍ دانيه!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200580",""],[5431,"يارب دينك بالغلاة تشوّها...","https://www.poetsgate.com/ViewPoem.aspx?id=212717",""],[5452,"الشّعر","https://www.poetsgate.com/ViewPoem.aspx?id=148452",""],[5652,"وتبقى لك العزوه عدود وعشاير","https://www.poetsgate.com/ViewPoem.aspx?id=190144",""],[5732,"إلى عذلت القلب","https://www.poetsgate.com/ViewPoem.aspx?id=177953",""],[5843,"موت طازج","https://www.poetsgate.com/ViewPoem.aspx?id=51285",""],[5956,"متغزِّلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=182090",""],[5959,"القلب الأخضرانى","https://www.poetsgate.com/ViewPoem.aspx?id=12164",""]],"verses":[["مُتَغَرِّباً لا أَستَجيرُ بِمَنزِلٍ","فَإِذا نَزَلتُ فَعَقلَةُ الضيفانِ",0,"ن",1,0],["مُتَغَطرِفاً كَالسَيلِ يَب","طُشُ بِالجَنادِلِ وَالصُخورِ",1,"ر",1,0],["مُتَغَيِّرينَ مِنَ الهَوى أَلوانُهُم","مِمّا تُجِنُّ قُلوبُهمُ صُفرُ",2,"ر",1,0],["متغافلاً عن ذكر ما أسديْتَهُ","وإذا وعدْتَ فذاكرٌ لا تغفُلُ",3,"ل",1,0],["متغزلات عند أروع ما لَهُ","إلا مع المِدَح الوِضاءِ تغزُّلُ",3,"ل",1,0],["مُتَغَنَّم الضَّحكاتِ مُثْمِنُها","وله لقاءٌ غيرُ مُغْتَنَمِ",4,"م",1,0],["مُتَغَرِّدينَ مع البَلابلِ","في السُّهولِ وفي الحزونْ",5,"ن",1,0],["مُتَغَمِّدٌ يَهَبُ الذُنوبَ وَعَهدُها","لَم يَستَطِل وَجَديدُها لَم يُشلِقِ",6,"ق",1,0],["مُتَغَطرِفينَ وَخِندِفٌ مِن حَولِهِم","كَاللَيلِ إِذ جاءَت بِعِزٍّ قَسوَرِ",7,"ر",1,1],["متغاير الإبداع مُخ","تلف المحاسن جامعا",8,"ع",2,0],["مُتَغَيّرٌ غيناً وصَح","واً مثل ما حدّثْتُ عنكِ",9,"ك",1,0],["متغلِّبونَ مخرِّبونَ بسحتِهم","حرمَ النبيِّ فطهَّرتْه النارُ",10,"ر",1,0],["مُتَغَفِّراً مُتَدَرِّعاً إِنْ صَرَّحَت","حَربٌ وقَالَ الحانِقونَ نَزَالِ",11,"ل",1,0],["مُتَغَنِّيَاتٍ مِنْ أَهَازِيجِ الصِّبا","مَا شَاءَ وَحْيُ هَوَىً وَطِيبُ هَوَاءِ",12,"ا",2,0],["متَغَامِزْونَ بِعَجْزِهِمْ","مُتَقَاصرِونَ مِنْ القُصُورِ",13,"ر",1,0],["مُتَغَمِّدٌ يَهَبُ الذّنوبَ، وَعهدُها","لمْ يَستَطِلْ، وَجديدُها لم يُخلِقِ",14,"ق",1,0],["متغرِّباً متنسكاً متقشفاً","متوشحاً بالصبر كالليث الكمي",15,"م",2,0],["مُتَغايِراتٌ قَد جُمِعنَ وَكلُّها","مُتَشاكل أَشباحُها أَرواحُ",16,"ح",1,1],["مُتغايرَ الأحوالِ مُخْ","تَلِفَ الضرائِبِ والسَّجَايا",17,"ا",3,0],["متغيراً عند الوداع فمهجتي","كادت به تنسل من عبراته",18,"ت",2,0],["متغلغلا بِنهىَ الفوارسِ دافعاً","من يُحجمون إلى الخلود الضافي",19,"ف",2,0],["مُتغطمطاً غصب الوحوش مكانها","تيَّارهُ فالضبُّ جارُ الضِّفْدعِ",20,"ع",1,0],["متغاير الأوصاف فوق جبينه","بشر الولي وهيبة السلطان",21,"ن",1,0],["مُتَغَيِّراً منها مُعَلْ","لَى المَجْدِ مُجْتَنِياً مَنِيْحَهْ",22,"ح",2,0],["متغلغلا في الماء الم وجنتي","ك ومقلتيك بحرقة وتوجع",23,"ع",1,0],["متغيب ما أن تزا","ل إلى الهجر ان هجره",24,"ر",2,0],["متغافلٌ عن حقّه متواضع","عن قدره متثبّتٌ متقصّد",25,"د",1,0],["متغلغلاً في الأرض بين مجاهل","جهل الغراب بها طريق نجاته",26,"ت",2,0],["مُتَغَزِّلاً في ظَبيِهِ","وَمَهاتِهِ وظَليمِهِ",27,"م",2,0],["متغيِّراً بالتاج يلمسُ رأسَهُ","طوراً وآونَةً يُرى مَنكوسا",28,"س",2,0],["مِتّ غَرْقَه ما ابْتَلّ يَنْبي","واحْتِرَقْت وثوبي لِعْفا بْها",29,"ب",3,0],["مُتَغَضِّبٌ دَلّاً فَلَستُ بمُدْرِكٍ","مِنهُ الرِّضا إِلّا بأَنْ أَتَغضَّبا",30,"ب",2,0],["متغزل بلواحظ الغزلان لا","يعنيه الا بالحسان الاعتنا",31,"ن",2,0],["متغرب وغربتي تابوت","ميت وأنا حي مستني",32,"ن",2,0],["مُتغوِّلاً مدَّ الفضاءِ بظُلمةٍ","جابتْ أساريرَ الردى منْ قادمِ",33,"م",1,0],["متغرِّبون وفي الحناجرِ غُصَّةٌ","أن يتركوه تلوكُه الأنيابُ",34,"ب",1,0],["مُتَغَرّبٌ نِسرين بَوحي في مَصا","ئِد فجْرِهِ وِبهِ تَدورُ نَسائِسُ",35,"س",1,0],["متغسّلٌ بالنارِ جوعٌ كافرٌ","والمعجزات جرَتْ بكلّ نواحيه!",36,"ي",2,0],["متغلّقا لم يحتدم فيه النهى","في لبِّ قعرٍ للنفايات انتهى !!",37,"ه",2,0],["متغيّب إنّ الغياب معذّب","في دربه متفرّد بعنائهِ",38,"ا",3,0],["متغلغله من دون حقن وتبرير","اليا لفت ب اجموعها ماتخاير",39,"ر",1,0],["متغطرس عبث على القلب لحاق","للعقل نهاب وللقلب سارق",40,"ق",1,0],["متغربين وبلا موطن ولا زول","يقاسم الصمت فينا بعض الاهوال",41,"ل",1,0],["متغزِّلٌ كي أكسب استسلاما","ممن أحب وأغتدي قوّاما",42,"م",2,1],["متغرب والليالى يا بوي","مش سايباني في حالي يا عين",43,"ن",1,0]]}