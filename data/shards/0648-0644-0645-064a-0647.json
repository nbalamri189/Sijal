{"poems":[[90,"وفدفد قاتم الأعماق متسع","https://www.aldiwan.net/poem44438.html","البسيط"],[53,"لشاعرنا خالد في استه","https://www.aldiwan.net/poem65010.html","المتقارب"],[87,"خفضت لعزة الموت اليراعا","https://www.aldiwan.net/poem62859.html","الوافر"],[48,"أصاب الأخفشين بصير خطب","https://www.aldiwan.net/poem22696.html","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9901","الوافر"],[371,"وكم كان لي قدما قصيد ومقصد","https://www.aldiwan.net/poem17179.html","الطويل"],[438,"هفا طربي الى عافي الرسوم","https://www.aldiwan.net/poem12714.html","الوافر"],[616,"","https://poetry.dctabudhabi.ae/diwan/poem/204391","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64069","الوافر"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100137","المتدارك"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138148",""],[1177,"","https://poetry.dctabudhabi.ae/diwan/poem/28379","الرجز"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21670","الطويل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137963",""],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82146","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129997","المتقارب"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116519","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138567",""],[3784,"","https://poetry.dctabudhabi.ae/diwan/poem/18575","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73397","الطويل"],[4767,"بدر عدنان","https://www.poetsgate.com/ViewPoem.aspx?id=179957",""],[709,"أَتُنْكِرُ بَأْسَ أَحْدَاقِ الْعَذَارَى","https://www.poetsgate.com/ViewPoem.aspx?id=2929",""],[5818,"ملهمة شعري","https://www.poetsgate.com/ViewPoem.aspx?id=199981",""],[5842,"ثورة .. قيامة البحرين ../ حسان علي الزاوي","https://www.poetsgate.com/ViewPoem.aspx?id=82895",""],[6333,"آخر رسالة حب مالم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7033&r=&rc=1",""]],"verses":[["ولم يهم لو رأى ابن العبد منظرها","من وصف عوجائه في كل اسلوب",0,"ب",1,0],["ولم يهجُرِ الشيخُ لذَّاتِهِ","ويجفُ المعاصي كالقانطِ",1,"ط",1,0],["وَلَم يَهدَء وِسادُكَ في اللَيالي","لِعِلمِكَ أَن سَتُفنيها اِضطِجاعا",2,"ع",2,0],["وَلَم يَهمُم بِلَقطِ الحَبِّ يَوماً","فَيوجَدَ رَهنَ أَشراكٍ دَواري",3,"ر",2,0],["وَلَم يَهجِم عَلى أُسدِ المَنايا","وَلَم يَطعَن صُدورَ الصافِناتِ",4,"ت",1,0],["وَلَم يَهدِني قَصدٌ إِلى قَصدِ مَدحِهِ","فَأُطنِبَ إِلّا أَن يَكونَ عَلى القَصدِ",5,"د",1,0],["ولم يهضِمْ معاليَهُ التفاتٌ","يملّ به الى كشحٍ هَضيمِ",6,"م",1,0],["ولم يهد بالبرهان من علم مالك","وما طويت أخباره والجوامع",7,"ع",1,0],["ولم يُهْلِلْ بتلبيةٍ","ولم ينْسُكْ ولم يَطُف",8,"ف",1,0],["ولمية أطلال درست","صارت عبراً لمن اعتبرا",9,"ر",2,0],["ولم يهج ظمأُ الحرمان هائجة","بل زاده ظمأُ الحرمان احسانا",10,"ن",2,0],["وَلَم يَهُلني مُصعَبٌ وَمَن مَعَه","نِعمَ الفَتى ذَلِكُم اِبنُ مَشجَعَه",11,"ه",1,0],["وَلَم يَهلِكوا إِلّا عَلى جاهِلِيَّةٍ","عَصاها عَلَيهِم تُرتَبٌ وَعَذابُها",12,"ب",3,0],["ولم يُهضم الشعبُ الضعيف حقوقه","وأصبح في الدنيا كما ينبغي حُرَّا",13,"ر",2,0],["ولم يهد جيشاً نحو جيش ولم يقد","الى السلف الغادي نصاباً مفأدا",14,"د",2,0],["ولم يهَبِ النار في لمسهِ","ولا احتاج في قطه للجلَم",15,"م",1,0],["ولم يهتد بالغير بل عكسه الذي","له واقع واستفت عن ذا من الذكر",16,"ر",1,0],["ولم يهن عزماً ولم يضعف ولو","توازرت كل الورى ما عجزا",17,"ز",2,0],["وَلَم يَهبِ الكومَ المَرايا وَعَبدها","كَأَنَّ بِها نَخلاً بِنَجرانَ يُنَّقا",18,"ق",2,0],["وَلَم يُهملوِهُ خَشيةً مِنهُ إِنما","رأَوهُ مَهيناً ذَمُّهُ كثَنائِهِ",19,"ه",1,0],["ولَم يهدأ بِمَرتَعهِ حِمارٌ","إذا جالتْ بِجانبه الأسود",20,"د",1,0],["وَلَمْ يهَبِ الْعِدَا إِلاَّ تَبَارَا","أَلاَ يَا أَيُّهَا الْمَلِكُ الْمُرَجَّى",21,"ر",3,0],["ولمْ يهمس لها غيري","وعينكِ ما رأت أشنبْ",22,"ب",1,0],["ولم يهبَوا سعوديّاً تعدّى","وهدّمَ مسجداً وسبا إمامَهْ",23,"م",2,0],["ولم يهب حبنا عن رحلتي ثمنًا","غير الرماد فهل نحيا بما وهبا؟!!",24,"ب",2,0]]}