ي بالعذارى البيض أسمى","https://www.poetsgate.com/ViewPoem.aspx?id=49520",""],[4859,"أنا لا أريد سوى الوفاء!","https://www.poetsgate.com/ViewPoem.aspx?id=187855",""],[4884,"حياء","https://www.poetsgate.com/ViewPoem.aspx?id=212245",""],[4935,"تمثل لي خيالك في المنام","https://www.poetsgate.com/ViewPoem.aspx?id=129386",""],[4935,"لو كنت مثلي في الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=129296",""],[4935,"فخار الملوك بأعوانها","https://www.poetsgate.com/ViewPoem.aspx?id=129303",""],[5136,"شاد الوزير جامعاً","https://www.poetsgate.com/ViewPoem.aspx?id=121617",""],[5136,"يا راقد الليل لم تشعر لمن سهرا","https://www.poetsgate.com/ViewPoem.aspx?id=121584",""],[5189,"جميلُ الخلق","https://www.poetsgate.com/ViewPoem.aspx?id=190888",""],[5191,"جسدًا واحدًا","https://www.poetsgate.com/ViewPoem.aspx?id=211978",""],[5302,"ما خانك الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=200065",""],[5497,"أتيه بحسنه","https://www.poetsgate.com/ViewPoem.aspx?id=208726",""],[5533,"إنَّما الفَارُوْقٌ عَدْلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=176963",""],[5561,"إطلالة على الماضي والحاضر","https://www.poetsgate.com/ViewPoem.aspx?id=197572",""],[5720,"بحسْنِ الظَّنِ","https://www.poetsgate.com/ViewPoem.aspx?id=209050",""],[5732,"يامرجع ليعقوب غاليه","https://www.poetsgate.com/ViewPoem.aspx?id=177866",""],[5732,"يقول من عدا على رأس عالي","https://www.poetsgate.com/ViewPoem.aspx?id=34388",""],[5739,"زوايا الحبر ..!","https://www.poetsgate.com/ViewPoem.aspx?id=126878",""],[402,"بالعلم يدرك أقصى المجد من أمم","https://www.poetsgate.com/ViewPoem.aspx?id=36317",""],[402,"أتحفزنا فعالك أن نقولا","https://www.poetsgate.com/ViewPoem.aspx?id=36072",""],[5961,"يسير بك المهيمن","https://www.poetsgate.com/ViewPoem.aspx?id=199772",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""]],"verses":[["بِحُسامٍ كُلَّما جَرَّدتُهُ","في يَميني كَيفَما مالَ قَطَع",0,"ع",1,0],["بِحَسبِ الهَوى أَن قَد بُليتُ وَأَنَّني","مَتى ما أَقُل قَد غاضَ دَمعِيَ يَهمَعِ",1,"ع",1,0],["بحسنها الفتان","والعقل والبيان",2,"ن",1,0],["بِحَسْبِ عُلاكَ أَنكَ هَاشِمِيٍّ","فَمَا يَرْقَى رُقِيَّكُمُ الأَنَامُ",3,"م",1,0],["بحسبنا كاشفاً عواقبَه","أنَّ شهاب الظلامِ والدُهُ",4,"د",2,0],["بحسبك بل حسب المريديَ بالرّدى","جوى حَزَنٍ يَصلى فؤداي بناره",5,"ر",2,0],["بحسبك هذي ما حُبيت إمارةً","تُجَلُّ بها حقَّ الجلال وتُعْظَمُ",6,"م",1,0],["بحسرتي على شفاءٍ أعدمُهْ","بل أنا والله الذي أسترحمُهْ",7,"م",2,0],["بحسام يأبَى الخيانة في الرَّوْ","عِ إذا خان آمناً مأمونه",8,"ن",2,0],["بِحُسنِ نُطقِكِ الَّذي قَد أَصبى","إِلّا أَرَيتِني اللِسانَ العَذبا",9,"ب",2,0],["بِحُسنِ رَأيِ أَميرِ المُؤمِنينَ وَما","لِصاعِدٍ وَهوَ مَوصولٌ بِهِ نَسَبُ",10,"ب",1,0],["بِحَسبِكَ أَنَّ عِندَكَ كُلَّ عَيبٍ","عَلِمناهُ فَوابِكَ ما تُعابُ",11,"ب",1,0],["بِحَسبِكِ ما تَخوضُ لَنا اللَيالي","مِنَ البَينِ المُبَرِّحِ وَالشَتاتِ",12,"ت",1,0],["بِحَسبِنا مِنهُ ما يَزدادُ مِن حَسَبٍ","وَما قَضى مِن فُروضِ القَومِ أَو كافا",13,"ف",2,0],["بِحَسبِكَ أَنَّ الشوسَ مِن آلِ مُصعَبٍ","رَضوكَ عَلى تِلكَ المَكارِمِ قَيِّما",14,"م",2,0],["بِحَسبِها أَنَّها مِن فَضلِ رُتبَتِها","تُعَدُّ واحِدَةً وَالبَحرُ ثانيها",15,"ي",3,0],["بِحَسرَةٍ تَشتَدُّ في السِرِّ قِراً","إِذ لَم تُذَلَّل بِزِمامٍ وَقَرَن",16,"ن",1,0],["بِحُسام مُطفئٍ أرواحهُمْ","بِشواظِ البارِقِ المُتَّقِدِ",17,"د",1,0],["بِحَسبِ عُتبَةَ داءٌ قَد تَضَمَّنَهُ","لَو كانَ في أَسَدٍ لَم يَفرِسِ الأَسَدُ",18,"د",1,0],["بِحُسامِ اللِسانِ وَالرَأيِ أَمضى","حينَ يُنضى مِنَ الجُرازِ الحُسامِ",19,"م",1,0],["بِحَسبِكَ مِن نَيلِ المَناقِبِ أَن تُرى","عَليماً بِأَن لَيسَت تُنالُ مَناقِبُه",20,"ب",2,0],["بحسبِ نَفسَكَ ماتعيا النفوسُ به","من فرط منطلق ٍ أو فرط منحدر",21,"ر",1,0],["بِحُسامِ سَيفِكَ أَو لِسانِكَ وَال","كَلِمُ الأَصيلُ كَأَرغَبِ الكَلمِ",22,"م",1,0],["بِحُساماتٍ تَراها رُسَّباً","في الضَريباتِ مُتِرّاتِ العُصُم",23,"م",1,0],["بِحُسْنِ رَأْيٍ يَذودُ ال","زَّمَانُ عَنْهَا وَصَرْفَهْ",24,"ف",2,0],["بِحَسَبٍ مُؤَثَّلٍ","وَنَسَبٍ مُؤَصَّلِ",25,"ل",1,0],["بِحَسْبِكَ مَا جَنَيْتَ الحَسْبَ مِنْهُ","مُعِيناً أَوْ مُغِيثاً أَوْ مُنِيرا",26,"ر",2,0],["بِحَْسِبُكْم أَنَّهُ يُدَانِي","فِي مَلَكُوتِ الْعُلَى يَسُوعَا",27,"ع",2,0],["بِحُسَامِهِ وَبِرَأْيهِ بَلِّغَ الذُّرَى","فَخْراً فَمَا يَسْمُو إِلَيْهِ نَدِيدُ",28,"د",1,0],["بحَسْبِهَا أنّها، في فَضْلِ رُتْبَتِها،","تُعَدُّ وَاحِدَةً والبَحْرُ ثَانِيها",29,"ي",3,0],["بحسبِك بل حسب المُريديَ بالرَّدى","جوى حَزَنٍ يَصلى فؤادي بناره",30,"ر",2,0],["بحسبي أني سوف ألقي حماميا","وأنت إلى جنبي تراعي فنائيا",31,"ي",2,0],["بحسبي حسنٌ صورته خواطري","له دون أحناء الضلوع سفور",32,"ر",1,0],["بحسبِكَ أنَّ البَينَ راشَ نبالَه","وفوَّقَها نَحوي فأصمَتْ مقاتلي",33,"ل",2,0],["بحسب منافعي منك اطّراحي","إذا سلمت وأحتمل الغضاضه",34,"ض",2,0],["بحسب انتفاع المرء بالمرء يشتهي","بقاه وإلا فالبقاء قصير",35,"ر",1,0],["بِحُسنهِ فاقَ اللآلي قيما","سمّيتُها بأحسنِ الوسائلِ",36,"ل",1,0],["بحُسنهِ الكونُ غدا متيّما","محمّدٌ دعوةُ إِبراهيما",36,"م",2,0],["بحسن وجهك يا مَن لا شبيه له","لا تُشمتِ الناسَ بي يا أملح الناسِ",37,"س",1,0],["بحسبي أني لا أزال مروّعاً","أبيت على هم وأغدوا على عتب",38,"ب",1,0],["بِحَسْبِ زيادٍ نَدْبُهُ طَلَلاً عَفَا","وَحَسْبِي اقْتِدَاحٌ للغَرامِ زَكَا وَرْيَا",39,"ي",2,0],["بِحَسْبِكَ جَدٌّ صاعِدٌ يقْهَر العِدَى","مِنَ الجَيشِ جَمَّاعِ الصَّهيلِ إلَى الرُّغَا",40,"غ",2,0],["بِحَسْبي رِضَى المَوْلَى وحُسْنُ اصْطِنَاعِهِ","عِلاجاً بِهِ أبْقَى إِذا خِفْتُ أَنْ أَفْنَى",41,"ن",2,0],["بِحَسْبِكَ في هوَّارَةٍ وزَنَاتَةٍ","وقائِعُ هابَتْها سُلَيْم وعامِرُ",42,"ر",1,0],["بِحسّانِ بِنِ مِسْمارٍ أُقِيمَتْ","قَناةُ الدِّينِ مِنْ بَعْدِ اعْوِجاجِ",43,"ج",1,0],["بِحُسنِ غِزلانِهِم","قَد راقَ لي التَغَزُّلُ",44,"ل",1,0],["بحُسامٍ قد نَماهُ عَضُدٌ","ثمَّ أوطاهُ منَ الأكفاء هاما",45,"م",2,0],["بحُسنِ رأْيٍ لعزّ دينِ هُدىً","مُستظهِرٌ لم يَزَلْ بهِ الخَدَم",46,"م",1,0],["بِحُسن نَظارة الفَتح المرجى","رَجاء الجامع الأَموي راجا",47,"ج",2,0],["بِحَسبك أَن سَقي","بَعض ما أَشكو مِن الضَر",48,"ر",1,0],["بحسرةِ ملهوفٍ وصفقة خاسر","وكم لي على جيرون وقفة حائر",49,"ر",1,0],["بحسن تاريخٍ زهيٍ سما","محمدٌ رئاسة العسكر",50,"ر",1,0],["بحسنها وردت من ورد رجنتها ال","حمرا وشامتها الخضرا اسانيد",51,