{"poems":[[55,"خذي حديثك من نفسي عن النفس","https://www.aldiwan.net/poem30189.html","البسيط"],[95,"لحق اليوم بالرفاق أمين","https://www.aldiwan.net/poem11209.html","الخفيف"],[56,"فوهاء شوهاء يبدي الكيد مضحكها","https://www.aldiwan.net/poem27499.html","البسيط"],[53,"من ذا رأت عيناه مثلي في الشجا","https://www.aldiwan.net/poem9239.html","الرجز"],[16,"هل ما علمت وما استودعت مكتوم","https://www.aldiwan.net/poem27694.html","البسيط"],[30,"لا قوم أكرم من تميم إذ غدت","https://www.aldiwan.net/poem5479.html","الكامل"],[54,"هاتيك دارهم فعرج واسأل","https://www.aldiwan.net/poem26755.html","الكامل"],[52,"ألا قل لعبدة إن جئتها","https://www.aldiwan.net/poem63871.html","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54542","الخفيف"],[119,"إلا أن بعد القوم عن جاهل بهم","https://www.aldiwan.net/poem41712.html","الطويل"],[136,"رسم ربع بجانب الينبوع","https://www.aldiwan.net/poem54803.html","الخفيف"],[275,"رأيت الشرق ملكا للنبي","https://www.aldiwan.net/poem35655.html","الوافر"],[275,"إن الجمال به عزاء الأنفس","https://www.aldiwan.net/poem35666.html","الكامل"],[287,"كلما حادثني ابن الخيمي","https://www.aldiwan.net/poem32841.html","المتقارب"],[353,"دعوة لي في النحو قد جمعتنا","https://www.aldiwan.net/poem19836.html","الخفيف"],[466,"يا إمام الهدى علوت عن الجود","https://www.aldiwan.net/poem16241.html","الخفيف"],[473,"وبربطاني غدا","https://www.aldiwan.net/poem59948.html","مجزوء الرجز"],[548,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105469","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108922","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125360","الكامل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100457","الرجز"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202137","الرمل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121616","الدوبيت"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88929","السريع"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59473","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123500","الكامل"],[4767,"وهْن الحب","https://www.poetsgate.com/ViewPoem.aspx?id=211125",""],[4830,"سَرارَةُ مُهجَتي","https://www.poetsgate.com/ViewPoem.aspx?id=194612",""],[5111,"تَقَاسِيمُ الصَّمْتِ","https://www.poetsgate.com/ViewPoem.aspx?id=212043",""],[5186,"رب خير يولى ولا من بشير","https://www.poetsgate.com/ViewPoem.aspx?id=156485",""],[5273,"أسئلة بظهر الغيب","https://www.poetsgate.com/ViewPoem.aspx?id=176796",""],[5388,"قناديل الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=206919",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5861,"هو قالها","https://www.poetsgate.com/ViewPoem.aspx?id=191302",""],[5894,"في الجفن كسر تحته تضعيفي","https://www.poetsgate.com/ViewPoem.aspx?id=131429",""],[5190,"لا تسألي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85040&r=&rc=115",""]],"verses":[["فَوهاءُ تَفغَرُ نَحوي وَهيَ ساغِبَةٌ","شَجوَ الوَليدِ إِذا ما عَبَّ في النَفَسِ",0,"س",1,0],["فَوَهَى الهيكَلُ المَنِيعُ وَلَكِنْ","سَلِمَ الجَوْهَرُ الرَّفِيعُ الحَصِينُ",1,"ن",1,0],["فَوهاءُ شَوهاءُ يُبدي الكَيدَ مَضحَكُها","قَنواءُ بِالعَرضِ وَالعَينانِ بِالطولِ",2,"ل",1,1],["فوهّج القلبَ كما توهَّجا","أقسمتُ بالليلِ إذا الليلُ دجا",3,"ج",2,0],["فوهٌ كَشَقِّ العَصا لَأياً تُبَيَّنُّهُ","أَسَكُّ ما يَسمَعُ الأَصواتَ مَصلومُ",4,"م",1,0],["فَوَهَبتُكُم لِأَحَقَّكُم بِقَديمِكُم","قِدماً وَأَفعَلِهِ لِكُلِّ نَوالِ",5,"ل",1,0],["فَوهاءَ يَفرُقُ بَينَ شَطرَي وَجهِها","نورٌ تَخالُ سَناهُ سَلَّةَ مُنصُلِ",6,"ل",1,0],["فَوَهَّنَني عَنهُ حُبِّيكُمُ","وَفي الحُبِّ ما يوهِنُ الجالِدا",7,"د",2,0],["فَوَهَى قَلْبُكِ الْكَسِيرُ الْمُعَنَّى","وَتَعَجَّلْتِ لِلرَّحِيلِ الْقَضَاءَ",8,"ا",2,0],["فوهم اعتراض المرء في شانهم عمى","وأفشاؤه للناس أوهى وأعظم",9,"م",1,0],["فُوهُ فِيهِ العُقَارُ بَعدَ كَرَاهُ","وعَبِيرُ الرِّيَاضِ دَهرَ الرَّبيعِ",10,"ع",1,0],["فوهنُ الشّعبِ من وَهَنِ المزايا","ومن فَقدِ السلاحِ المعنوي",11,"ي",1,0],["فوهبتُها شيئاً وقلتُ لها أرى","قلبي بلا حُبٍّ كجيبِ المُفلِس",12,"س",1,0],["فوهُ كَالمَعدَةِ ما مَرَّ بِها","طَيِّبٌ إِلّا أَحالَتهُ خَبيثا",13,"ث",2,0],["فَوَهَتْ حُجَّةُ المُبّرِدِ فيها","والكِسَائىُّ رَاحَ والفَرَّاءُ",14,"ا",2,0],["فَوهَبْتَ الأعْمارَ والأمْنَ والبُلْدانَ","كُلاً في ساعةٍ منْ نَهارِ",15,"ر",1,0],["فوهُ لَهُ خَريطَةً","كَمَخَتُها أَضراسُهُ",16,"س",2,0],["فَوِهَ الأَفوَهُ لَمّا هَتَمَت","فَمَهُ مِن هَضبَةِ الشِعرِ الفِهارُ",17,"ر",1,0],["فوهبته وهو المذمم باسمه","غوث المروعة في كرى آماقها",18,"ق",3,0],["فوها قرنفلةٌ والعين نرجسةٌ","والخد تفاحة والنهد رمَّانه",19,"ن",2,0],["فوهبتُهُ قلبي وكلَّ سعادَتي","وحسبتُ أنِّي قد بَلَغتُ مَرامي",20,"ي",1,0],["فوه بأعلاه رسا","ورأسه تنكسا",21,"س",2,0],["فوهة البركان ترمي حمما","عمت الدنيا سهولا وحزون",22,"ن",1,0],["فُوهُ لم ينْفَتِحْ بغير سَدادٍ","لا تَمَطٍ له ولا ثَوْباءُ",23,"ا",1,0],["فوه فسا فظنه فائحاً","فقحته فدس فيها فتيل",24,"ل",1,0],["فوهبتُ ما ملكت يدايَ لنشوتي","ولكم صحوتُ ونائلي لا يُقطعُ",25,"ع",1,0],["فوهمت خصرا كاصطبارى تحته","عجز كلائمى اللئيم معجز",26,"ز",1,0],["فوهْن الحب سهَّرني","أعان الله مَن وَهَنا",27,"ن",2,0],["فوهبتُهُ شغفاً سَرارَةَ مُهجتي","وَحَشا لظى أشواقهَ بين الحَشا",28,"ش",2,0],["فَوَهَبْتُ قَلْبِيْ لِْلقَرِيبِ شَهَيدًا","يَافِعًا يَعْبِقُ الطُّيُوفَ خُزَامَى",29,"م",2,0],["فوهة الأرض قد تثور وتهدأ","بنظام الطبيعة المقدور",30,"ر",1,0],["فوهجُكِ أرْهَقَ في اشتِهائي","وأهلكني بالهوى ما اشتهيتُ",31,"ت",1,0],["فوهج الدهشة العذراء بوحٌ","وأصدقه السّطورُ الباكياتُ",32,"ت",1,0],["فوهت عزيمته وساخ جواده","في الأرض مرتطماً بها مشكولا",33,"ل",2,0],["فوهبتُهُ كلَّ الزهورِ بهمسةٍ","وكتبتُهُ طيَّ الضلوعِ نوالَها",34,"ل",3,0],["فوهبت دمعا عند وجدي مثل ما","وهبت يد المصري بالمعروف",35,"ف",1,0],["فَوَهَبتِهِ من نُورِ عَينِكِ نَظرَةً","ومَدَدتِ في جُنحِ الظَّلامِ له يدا",36,"د",2,0]]}