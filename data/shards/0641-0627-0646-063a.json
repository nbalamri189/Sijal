{"poems":[[53,"ردي يا جيادي وأذني برحيل","https://www.aldiwan.net/poem29903.html","الطويل"],[77,"لعل خيالا منك يطرق مضجعي","https://www.aldiwan.net/poem35993.html","الطويل"],[77,"هنيئا لمن حث الركائب في بدر","https://www.aldiwan.net/poem36494.html","الطويل"],[86,"يا يوم تكريم حفني","https://www.aldiwan.net/poem68862.html","المجتث"],[54,"بني مالك صونوا الجفون عن الكرى","https://www.aldiwan.net/poem27513.html","الطويل"],[27,"كاد مجيب الخبث تلقى يمينه","https://www.aldiwan.net/poem5964.html","الطويل"],[51,"لشاعرنا خالد في استه","https://www.aldiwan.net/poem65010.html","المتقارب"],[51,"قالوا هجاك أبو حفص ولحيته","https://www.aldiwan.net/poem65864.html","البسيط"],[51,"أنهنه غربي عن الجاهلي","https://www.aldiwan.net/poem66484.html","البسيط"],[51,"نبكي الشباب لحاجات النساء ولي","https://www.aldiwan.net/poem66769.html","البسيط"],[62,"خذي صفو ما أوتيت واغتنميه","https://www.aldiwan.net/poem52247.html","الطويل"],[45,"وكان البعد عن ملح","https://www.aldiwan.net/poem62745.html","مجزوء الوافر"],[58,"ومن كرمت طبائعه تحلى","https://www.aldiwan.net/poem30829.html","الوافر"],[66,"وفى لي فيك الدمع إذ خانني الصبر","https://www.aldiwan.net/poem40123.html","الطويل"],[66,"ألست ترى ما في العيون من السقم","https://www.aldiwan.net/poem41585.html","الطويل"],[97,"أحبك ما حييت وأنت حسبي","https://www.aldiwan.net/poem24943.html","الوافر"],[74,"ألا ليت أنفاس الرياح النواسم","https://www.aldiwan.net/poem13258.html","الطويل"],[105,"أمن صلف صدودك أم دلال","https://www.aldiwan.net/poem43412.html","الطويل"],[81,"جرى من جفوني ما أذاب أجفاني","https://www.aldiwan.net/poem61307.html","الطويل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9916","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54693","الرجز"],[77,"لعل خيالا منك يطرق مضجعي","https://www.poetsgate.com/ViewPoem.aspx?id=34177",""],[77,"سقى دارهم هام من السحب هامع","https://www.poetsgate.com/ViewPoem.aspx?id=34206",""],[32,"تصد إذا ما الناس بالقول أكثروا","https://www.poetsgate.com/ViewPoem.aspx?id=118",""],[124,"أسلسل أشعاري وأزجي قصائدي","https://www.aldiwan.net/poem801.html",""],[148,"ألا قل للثقاة السامعين","https://www.aldiwan.net/poem68502.html","الوافر"],[158,"أتم سرور يرى الوالد الابنا","https://www.aldiwan.net/poem58924.html","الطويل"],[167,"أرتها المآقي ما تكن الجوانح","https://www.aldiwan.net/poem1611.html",""],[167,"إلى كم مداراة العدى واحترامها","https://www.aldiwan.net/poem1663.html",""],[167,"دعوه فخير الرأي أن لا يعنفا","https://www.aldiwan.net/poem1639.html",""],[184,"ليالي الصبا درت عليك السحائب","https://www.aldiwan.net/poem44142.html","الطويل"],[184,"وجملة أمري أن عيشي منغص","https://www.aldiwan.net/poem44154.html","الطويل"],[205,"أتشحذ أرماحا بأيدي عدونا","https://www.aldiwan.net/poem27974.html","الطويل"],[210,"زار الحبيب وللواشين أبراق","https://www.aldiwan.net/poem37855.html","الطويل"],[259,"حلا بك الدهر وازدانت علا حلب","https://www.aldiwan.net/poem38367.html","البسيط"],[268,"هو الملك تبنيه الجيوش الخضارم","https://www.aldiwan.net/poem35646.html","الطويل"],[273,"هو الفتح بعد الفتح يأتي مسوغا","https://www.aldiwan.net/poem25482.html","الطويل"],[311,"بدا لك طال عنك اكتتامه","https://www.aldiwan.net/poem59484.html","الطويل"],[326,"الحمد للَه على ماق ضى","https://www.aldiwan.net/poem54955.html","الكامل"],[347,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[362,"لي فرس صائم حكى فرس الشطرنج","https://www.aldiwan.net/poem60870.html","المنسرح"],[362,"كتاب عبد إلى مولاه يعتذر","https://www.aldiwan.net/poem60915.html","البسيط"],[377,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[418,"يا من علا فرأى ما في القلوب وما","https://www.aldiwan.net/poem46385.html","البسيط"],[429,"أسائل عنها الركب والدمع سائل","https://www.aldiwan.net/poem12707.html","الطويل"],[436,"منكم إليكم مساعي المجد تنصرف","https://www.aldiwan.net/poem34822.html","البسيط"],[436,"ما أحسن الصبر فيما يحسن الجزع","https://www.aldiwan.net/poem34837.html","البسيط"],[436,"لك الخير قد أوفى بعهدك خيران","https://www.aldiwan.net/poem34887.html","الطويل"],[444,"قتيل ما قتيل المرء عمرو","https://www.aldiwan.net/poem23927.html","الوافر"],[456,"بكرت عليه ضلة تعذلينه","https://www.aldiwan.net/poem55848.html","الطويل"],[456,"يا وحشة المجد ثقي بالأنس","https://www.aldiwan.net/poem56153.html","الرجز"],[459,"أأترك محيي العدل والشوق قائدي","https://www.aldiwan.net/poem15921.html","الطويل"],[459,"الام يراك المجد في زي شاعر","https://www.aldiwan.net/poem15927.html","الطويل"],[462,"في لأذني عن كل لاح صمم","https://www.aldiwan.net/poem3159.html","عموديه"],[466,"جمالي وزيني إذا ما حضر","https://www.aldiwan.net/poem59983.html","المتقارب"],[540,"لها في لحظها لحظات حتف","https://www.aldiwan.net/poem34024.html","الوافر"],[549,"يظن رجال بي ظنونا شنيئة","https://www.aldiwan.net/poem47184.html","الطويل"],[549,"أتاني والركبان يأتي نجيهم","https://www.aldiwan.net/poem47332.html","الطويل"],[549,"أيا ملك الأملاك قد جاءني الذي","https://www.aldiwan.net/poem47842.html","الطويل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"أودع منك الصدر والبدر والبحرا","https://www.aldiwan.net/poem2722.html","الطويل"]],"verses":[["فَإِن غَنِمَ الجَيشُ المُغيرُ وَراءَهُ","فَما غُنمُهُ في الحَربِ غَيرَ غُلولِ",0,"ل",1,0],["فإنْ غِبْتَ غابَ الأنْسُ عنّي بأسْرِهِ","ومالِي منْ عيشٍ إذا لمْ تكُنْ مَعي",1,"ي",1,0],["فإنْ غابَ عنّي وجْهُهُ ودَلالُهُ","أعَلِّلُ قلْبي بالدُّجُنّةِ والبَدْرِ",2,"ر",1,0],["فَإِن غَدَوتَ وَزيراً","يَوماً وَجِئنا نُهَنّي",3,"ي",1,0],["فَإِن غُصَّ هَرونٌ بِجُرعَةِ عَمِّهِ","فَأَيسَرُ مَفقودٍ وَأَهوَنُ هالِكِ",4,"ك",1,0],["فَإِن غَفَلَ الراعي الَّذي نامَ بِالحِمى","فَإِنَّ بِحَجرٍ راعِياً غَيرَ غافِلِ",5,"ل",1,0],["فإن غارَ قالتْ له نفسُهُ","تغافلْ كأنكَ في واسط",6,"ط",1,0],["فإن غدتْ أجرة الحلّاقِ تعوزُه","فقد أبحتُ يديهِ نتفها خُصَلا",7,"ل",2,0],["فإن غمطوا الحلم أتبعتُه","مَغبَّة إطراقةِ الأُفعوان",8,"ن",1,0],["فإن غدوتُ فعنْ نفسٍ مكلَّفةٍ","مثلَ الحسير يُزجِّيها مزجِّيها",9,"ي",3,0],["فإِن غدرتْ بالحسنِ يوماً بناتُه","فذاك قليلٌ من كثيرِ بنيهِ",10,"ي",2,0],["فَإِن غَنِيَت لَنا دارٌ","بِجَمعِ الشَملِ لَم أَعُدِ",11,"د",1,0],["فَإِن غَدَرَت بِكَ الأَيامُ فَاِصبِر","وَكُن بِاللَهِ مَحمودَ المَعاني",12,"ن",2,0],["فَإِن غابَ ذاكَ البَدرُ عَن أُفقِ مُلكِهِ","فَقَد أَشرَقَت مِن نَجلِهِ أَنجُمٌ زُهرُ",13,"ر",1,0],["فَإِن غِبتَ فَاِجعَل لي وَلِيّاً مِنَ الأَذى","وَهَيهاتَ لا يُغني الوَلِيُّ عَنِ الوَسمي",14,"ي",1,0],["فإن غفلت عيون الحظ عنا","وصرت ولم أكن أدري بقربي",15,"ي",1,0],["فَإِن غاضَتِ الأَيّامُ ماءَ شَبيبَتي","وَمالَت بِغُصنٍ مِن قَوامِيَ ناعِمِ",16,"م",1,0],["فَإِن غَضِبوا عَلَيَّ فَقَولُ حُرٍّ","يَرى أَوطانَهُ غَرَضَ النِبالِ",17,"ل",1,0],["فَإن غَيَّبُوا فِي التُّربِ عَادِل قَدّه","فَقَد غَيَّبُوا بَدراً وغُصناً من البَانِ",18,"ن",1,0],["فَإِن غَدا مِن فَوقِ ظَهرٍ نَدبِ","كانَ إِلى الأَرضِ سَريعَ الجَنبِ",19,"ب",1,0],["فَإنْ غَلُظَتْ مِنْهُمْ رِقَابٌ لِبُعْدِهِ","فَما انْحَطَّ عَنْها لِلْمَذَلَّةِ نِيرُ",20,"ر",1,0],["فَإِنَّ غُبارَ الصافِناتِ إِذا عَلا","نَشِقتُ لَهُ ريحاً أَلَذَّ مِنَ النَدِّ",21,"د",1,0],["فَإِنْ غَوَى أَخُْو نُهىً فَمُهْلَةً","حَتَّى يَرُدَّهُ نُهَاهُ رَدَّا",22,"د",2,0],["فإن غبت غاب الأنس عني بأسره","ومالي من عيش إذا لم تكن مع",23,"ع",1,0],["فإن غال خطب فهوى مأوى من الردى","وإن جل ذنب فهو في الذنب شافع",24,"ع",1,0],["فإن غفل الواشون عدنا لوصلنا","وعاد التّصافي بيننا والتّراسل",25,"ل",1,0],["فإن غاب عن عيني فعندي خياله","وفي الروح مأواه وفي القلب يختلج",26,"ج",1,0],["فإن غرّت أعاديه هناة","فإن الله خير الناصرينا",27,"ن",2,0],["فإن غضبت فالنصر للسيف والقنا","فهم خدمٌ لا شكَّ يكفونها القرنا",28,"ن",2,0],["فَإِن غاضَ في أَرضي الوَفاءُ وَقُطِّعَت","أَواصِرُ ذي القُربى وَعزَّ المُناصِحُ",29,"ح",1,0],["فَإِن غَضِبَت فيها عُقَيلٌ فَأَنتُمُ","بَنو الحَربِ إِذ يُذكي لَظاها ضِرامُها",30,"م",3,0],["فَإِن غالَهُم رَيبُ المَنونِ كَغَيرِهِم","فَقَولُوا عَلى الدُنيا وَأَبنائِها العَفا",31,"ف",2,0],["فإن غالني صرف الزمان وريبه","وأعوزني فيه خليل مقارب",32,"ب",1,0],["فإن غبت فالشوق المبرّح قاتلي","وإن قربت دار فقيل رقيب",33,"ب",1,0],["فَإِن غَضِبَت فيها حَبيبُ بنُ حَبتَرٍ","فَخُذ خُطَّةً يَرضاكَ فيها الأَباعِدُ",34,"د",1,0],["فإن غَرَّبَتْ يمضي إليها مُغَرِّبَاً","وإن شرَّقَتْ يمضي إليها مُشَرِّقَا",35,"ق",2,0],["فإن غاية من أقضى به أمل","إلى تناول ما فوق السهى التعب",36,"ب",1,0],["فإن غَضِبوا للحقِّ يوماً تلَهّبت","صَوارمُ في أيدي الضّواري ضَوارِم",37,"م",1,0],["فإِن غادَرَ التَّجْسيمَ شلْواً مُمَزَّعاً","فَقَدْ صانَ للتَّوحيدِ وَجْهاً مُمَرَّغَا",38,"غ",2,0],["فَإِن غِبتَ عَنهُ حَلَّ فِيه وَطَنَّبَت","عَلَى الكَشفِ المَصُونِ خِيَامُهُ",39,"م",2,0],["فإن غفا مدّ له مسرحا","حدوده فوق مرامى النظر",40,"ر",1,0],["فَإِن غَدَوتَ رائِداً لِوِردِهِم","فَأَلُ إِلى الآلِ وَلِلبِرِّ فَبَر",41,"ر",1,0],["فانغَمسوا في نَعيمهمْ وأنا","في الهذَيان الطّويلِ مُنَغَمسي",42,"س",2,0],["فإنْ غدا وله في قَلْبِه أثَرٌ","لم يَبْقَ للعَبْدِ لا عَيْنٌ ولا أثَر",43,"ر",1,0],["فإن غَضِبتَ عُظِّم المصابُ","وضَلَّ بالكُلِّية الصوابُ",44,"ب",1,0],["فإن غفَرت فَذو فضلٍ وذو كرَمٍ","وإن سطَرتَ فأنتَ الحاكم العادِلُ",45,"ل",1,0],["فإن غُرِسَتْ في بابلٍ فتوقّها","فكلُّ غزالٍ حلّ بابلَ نابِلُ",46,"ل",1,0],["فإنْ غَدَتْ منهُمُ الأَيامُ مُوحِشَةً","فالحاجِبُ القائِدُ الأَعلى لَهَا خَلَفُ",47,"ف",1,0],["فإِنْ غَدَا شَعْبُكُمْ فِي اللهِ مُفْتَرِقاً","فإِنَّ شَعْبَكُمُ فِي المَجْدِ مُجْتَمِعُ",48,"ع",1,0],["فَإِنْ غَرَّبَتْ أرض المغاربِ مَوئِلي","وأَنْكَرَنِي فِيهَا خَليطٌ وخِلّانُ",49,"ن",1,0],["فَإِنَّ غَداً وَبَعدَ غَدٍ لَوَهنٌ","لِأَمرٍ ما يُقامُ لَهُ عَظيمِ",50,"م",1,0],["فإن غادرتْ أمسِي نحولا صروفُهُ","فلليوم حتى أستعيدَ سمينَهُ",51,"ن",2,0],["فإن غلت بصدره حميَّةٌ","راعك وجهُ الضيغم المعبِّسِ",52,"س",1,0],["فانْ غِبْتُ عن نادي عُلاهُ فانني","بمدحي مُقيمٌ في ذَراهُ عَتيدُ",53,"د",1,0],["فانْ غَربتْ في نحر كلِّ مَدَجَّجٍ","واِلا لَقىً معْزولةٌ بالبَواتِرِ",54,"ر",1,0],["فان غضبتم لمقالي فاغتصبوا","إذ الوهاجُ قد سمتها القممِ",55,"م",1,0],["فَإِن غَدَرَ الدَهرُ بي في أَخي","فَكَم مِن كَريمٍ بِهِ قَد غَدَر",56,"ر",1,0],["فإن غضبت رأيتَ الناس قتلى","وإن ضحكت فأرواحٌ تعودُ",57,"د",1,0],["فإِنّ غرتُ في تفتيشِ مَن أستعينُهُ","فَما هو إلّا مَن عليَّ يُعينُ",58,"ن",1,0],["فإنْ غبتَ عنّا فالنّجومُ غوائبٌ","وإنْ زلتَ عنّا فالجبالُ زوائلُ",59,"ل",1,0],["فإنْ غرَّد الشادِي بهنَّ تنغُّماً","تناسيتَ تغريد الحَمامِ المغرّدِ",60,"د",1,0],["فإن غضبت فهو في جواري","مثلث بالأشعار والأبشار",61,"ر",1,0],["فإِن غبتُ فاذكرني فإِنِّيَ مؤمنٌ","ولا مؤمنٌ إِلاَّ وتَنْفعُه الذِّكْرَى",62,"ر",2,0]]}