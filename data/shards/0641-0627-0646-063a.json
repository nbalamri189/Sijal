{"poems":[[53,"ردي يا جيادي وأذني برحيل","https://www.aldiwan.net/poem29903.html","الطويل"],[77,"لعل خيالا منك يطرق مضجعي","https://www.aldiwan.net/poem35993.html","الطويل"],[77,"هنيئا لمن حث الركائب في بدر","https://www.aldiwan.net/poem36494.html","الطويل"],[86,"يا يوم تكريم حفني","https://www.aldiwan.net/poem68862.html","المجتث"],[54,"بني مالك صونوا الجفون عن الكرى","https://www.aldiwan.net/poem27513.html","الطويل"],[27,"كاد مجيب الخبث تلقى يمينه","https://www.aldiwan.net/poem5964.html","الطويل"],[51,"لشاعرنا خالد في استه","https://www.aldiwan.net/poem65010.html","المتقارب"],[51,"قالوا هجاك أبو حفص ولحيته","https://www.aldiwan.net/poem65864.html","البسيط"],[51,"أنهنه غربي عن الجاهلي","https://www.aldiwan.net/poem66484.html","البسيط"],[51,"نبكي الشباب لحاجات النساء ولي","https://www.aldiwan.net/poem66769.html","البسيط"],[62,"خذي صفو ما أوتيت واغتنميه","https://www.aldiwan.net/poem52247.html","الطويل"],[45,"وكان البعد عن ملح","https://www.aldiwan.net/poem62745.html","مجزوء الوافر"],[58,"ومن كرمت طبائعه تحلى","https://www.aldiwan.net/poem30829.html","الوافر"],[66,"وفى لي فيك الدمع إذ خانني الصبر","https://www.aldiwan.net/poem40123.html","الطويل"],[66,"ألست ترى ما في العيون من السقم","https://www.aldiwan.net/poem41585.html","الطويل"],[97,"أحبك ما حييت وأنت حسبي","https://www.aldiwan.net/poem24943.html","الوافر"],[74,"ألا ليت أنفاس الرياح النواسم","https://www.aldiwan.net/poem13258.html","الطويل"],[105,"أمن صلف صدودك أم دلال","https://www.aldiwan.net/poem43412.html","الطويل"],[81,"جرى من جفوني ما أذاب أجفاني","https://www.aldiwan.net/poem61307.html","الطويل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9916","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54693","الرجز"],[77,"لعل خيالا منك يطرق مضجعي","https://www.poetsgate.com/ViewPoem.aspx?id=34177",""],[77,"سقى دارهم هام من السحب هامع","https://www.poetsgate.com/ViewPoem.aspx?id=34206",""],[32,"تصد إذا ما الناس بالقول أكثروا","https://www.poetsgate.com/ViewPoem.aspx?id=118",""]],"verses":[["فَإِن غَنِمَ الجَيشُ المُغيرُ وَراءَهُ","فَما غُنمُهُ في الحَربِ غَيرَ غُلولِ",0,"ل",1,0],["فإنْ غِبْتَ غابَ الأنْسُ عنّي بأسْرِهِ","ومالِي منْ عيشٍ إذا لمْ تكُنْ مَعي",1,"ي",1,0],["فإنْ غابَ عنّي وجْهُهُ ودَلالُهُ","أعَلِّلُ قلْبي بالدُّجُنّةِ والبَدْرِ",2,"ر",1,0],["فَإِن غَدَوتَ وَزيراً","يَوماً وَجِئنا نُهَنّي",3,"ي",1,0],["فَإِن غُصَّ هَرونٌ بِجُرعَةِ عَمِّهِ","فَأَيسَرُ مَفقودٍ وَأَهوَنُ هالِكِ",4,"ك",1,0],["فَإِن غَفَلَ الراعي الَّذي نامَ بِالحِمى","فَإِنَّ بِحَجرٍ راعِياً غَيرَ غافِلِ",5,"ل",1,0],["فإن غارَ قالتْ له نفسُهُ","تغافلْ كأنكَ في واسط",6,"ط",1,0],["فإن غدتْ أجرة الحلّاقِ تعوزُه","فقد أبحتُ يديهِ نتفها خُصَلا",7,"ل",2,0],["فإن غمطوا الحلم أتبعتُه","مَغبَّة إطراقةِ الأُفعوان",8,"ن",1,0],["فإن غدوتُ فعنْ نفسٍ مكلَّفةٍ","مثلَ الحسير يُزجِّيها مزجِّيها",9,"ي",3,0],["فإِن غدرتْ بالحسنِ يوماً بناتُه","فذاك قليلٌ من كثيرِ بنيهِ",10,"ي",2,0],["فَإِن غَنِيَت لَنا دارٌ","بِجَمعِ الشَملِ لَم أَعُدِ",11,"د",1,0],["فَإِن غَدَرَت بِكَ الأَيامُ فَاِصبِر","وَكُن بِاللَهِ مَحمودَ المَعاني",12,"ن",2,0],["فَإِن غابَ ذاكَ البَدرُ عَن أُفقِ مُلكِهِ","فَقَد أَشرَقَت مِن نَجلِهِ أَنجُمٌ زُهرُ",13,"ر",1,0],["فَإِن غِبتَ فَاِجعَل لي وَلِيّاً مِنَ الأَذى","وَهَيهاتَ لا يُغني الوَلِيُّ عَنِ الوَسمي",14,"ي",1,0],["فإن غفلت عيون الحظ عنا","وصرت ولم أكن أدري بقربي",15,"ي",1,0],["فَإِن غاضَتِ الأَيّامُ ماءَ شَبيبَتي","وَمالَت بِغُصنٍ مِن قَوامِيَ ناعِمِ",16,"م",1,0],["فَإِن غَضِبوا عَلَيَّ فَقَولُ حُرٍّ","يَرى أَوطانَهُ غَرَضَ النِبالِ",17,"ل",1,0],["فَإن غَيَّبُوا فِي التُّربِ عَادِل قَدّه","فَقَد غَيَّبُوا بَدراً وغُصناً من البَانِ",18,"ن",1,0],["فَإِن غَدا مِن فَوقِ ظَهرٍ نَدبِ","كانَ إِلى الأَرضِ سَريعَ الجَنبِ",19,"ب",1,0],["فَإنْ غَلُظَتْ مِنْهُمْ رِقَابٌ لِبُعْدِهِ","فَما انْحَطَّ عَنْها لِلْمَذَلَّةِ نِيرُ",20,"ر",1,0],["فَإِنَّ غُبارَ الصافِناتِ إِذا عَلا","نَشِقتُ لَهُ ريحاً أَلَذَّ مِنَ النَدِّ",21,"د",1,0],["فَإِنْ غَوَى أَخُْو نُهىً فَمُهْلَةً","حَتَّى يَرُدَّهُ نُهَاهُ رَدَّا",22,"د",2,0],["فإن غبت غاب الأنس عني بأسره","ومالي من عيش إذا لم تكن مع",23,"ع",1,0],["فإن غال خطب فهوى مأوى من الردى","وإن جل ذنب فهو في الذنب شافع",24,"ع",1,0],["فإن غفل الواشون عدنا لوصلنا","وعاد التّصافي بيننا والتّراسل",25,"ل",1,0]]}