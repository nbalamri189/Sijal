{"poems":[[55,"ردي يا جيادي وأذني برحيل","https://www.aldiwan.net/poem29903.html","الطويل"],[79,"لعل خيالا منك يطرق مضجعي","https://www.aldiwan.net/poem35993.html","الطويل"],[79,"هنيئا لمن حث الركائب في بدر","https://www.aldiwan.net/poem36494.html","الطويل"],[88,"يا يوم تكريم حفني","https://www.aldiwan.net/poem68862.html","المجتث"],[56,"بني مالك صونوا الجفون عن الكرى","https://www.aldiwan.net/poem27513.html","الطويل"],[29,"كاد مجيب الخبث تلقى يمينه","https://www.aldiwan.net/poem5964.html","الطويل"],[53,"لشاعرنا خالد في استه","https://www.aldiwan.net/poem65010.html","المتقارب"],[53,"قالوا هجاك أبو حفص ولحيته","https://www.aldiwan.net/poem65864.html","البسيط"],[53,"أنهنه غربي عن الجاهلي","https://www.aldiwan.net/poem66484.html","البسيط"],[53,"نبكي الشباب لحاجات النساء ولي","https://www.aldiwan.net/poem66769.html","البسيط"],[64,"خذي صفو ما أوتيت واغتنميه","https://www.aldiwan.net/poem52247.html","الطويل"],[47,"وكان البعد عن ملح","https://www.aldiwan.net/poem62745.html","مجزوء الوافر"],[60,"ومن كرمت طبائعه تحلى","https://www.aldiwan.net/poem30829.html","الوافر"],[68,"وفى لي فيك الدمع إذ خانني الصبر","https://www.aldiwan.net/poem40123.html","الطويل"],[68,"ألست ترى ما في العيون من السقم","https://www.aldiwan.net/poem41585.html","الطويل"],[99,"أحبك ما حييت وأنت حسبي","https://www.aldiwan.net/poem24943.html","الوافر"],[18,"قتيل ما قتيل المرء عمرو","https://www.aldiwan.net/poem23927.html","الوافر"],[76,"ألا ليت أنفاس الرياح النواسم","https://www.aldiwan.net/poem13258.html","الطويل"],[107,"أمن صلف صدودك أم دلال","https://www.aldiwan.net/poem43412.html","الطويل"],[83,"جرى من جفوني ما أذاب أجفاني","https://www.aldiwan.net/poem61307.html","الطويل"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[69,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9916","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54693","الرجز"],[79,"لعل خيالا منك يطرق مضجعي","https://www.poetsgate.com/ViewPoem.aspx?id=34177",""],[79,"سقى دارهم هام من السحب هامع","https://www.poetsgate.com/ViewPoem.aspx?id=34206",""],[34,"تصد إذا ما الناس بالقول أكثروا","https://www.poetsgate.com/ViewPoem.aspx?id=118",""],[111,"تكب على دنياك وهي تبيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545632",""],[130,"أسلسل أشعاري وأزجي قصائدي","https://www.aldiwan.net/poem801.html",""],[154,"ألا قل للثقاة السامعين","https://www.aldiwan.net/poem68502.html","الوافر"],[164,"أتم سرور يرى الوالد الابنا","https://www.aldiwan.net/poem58924.html","الطويل"],[173,"أرتها المآقي ما تكن الجوانح","https://www.aldiwan.net/poem1611.html",""],[173,"إلى كم مداراة العدى واحترامها","https://www.aldiwan.net/poem1663.html",""],[173,"دعوه فخير الرأي أن لا يعنفا","https://www.aldiwan.net/poem1639.html",""],[190,"ليالي الصبا درت عليك السحائب","https://www.aldiwan.net/poem44142.html","الطويل"],[190,"وجملة أمري أن عيشي منغص","https://www.aldiwan.net/poem44154.html","الطويل"],[211,"أتشحذ أرماحا بأيدي عدونا","https://www.aldiwan.net/poem27974.html","الطويل"],[216,"زار الحبيب وللواشين أبراق","https://www.aldiwan.net/poem37855.html","الطويل"],[265,"حلا بك الدهر وازدانت علا حلب","https://www.aldiwan.net/poem38367.html","البسيط"],[274,"هو الملك تبنيه الجيوش الخضارم","https://www.aldiwan.net/poem35646.html","الطويل"],[279,"هو الفتح بعد الفتح يأتي مسوغا","https://www.aldiwan.net/poem25482.html","الطويل"],[317,"بدا لك طال عنك اكتتامه","https://www.aldiwan.net/poem59484.html","الطويل"],[332,"الحمد للَه على ماق ضى","https://www.aldiwan.net/poem54955.html","الكامل"],[353,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[368,"لي فرس صائم حكى فرس الشطرنج","https://www.aldiwan.net/poem60870.html","المنسرح"],[368,"كتاب عبد إلى مولاه يعتذر","https://www.aldiwan.net/poem60915.html","البسيط"],[384,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[425,"يا من علا فرأى ما في القلوب وما","https://www.aldiwan.net/poem46385.html","البسيط"],[436,"أسائل عنها الركب والدمع سائل","https://www.aldiwan.net/poem12707.html","الطويل"],[443,"منكم إليكم مساعي المجد تنصرف","https://www.aldiwan.net/poem34822.html","البسيط"],[443,"ما أحسن الصبر فيما يحسن الجزع","https://www.aldiwan.net/poem34837.html","البسيط"],[443,"لك الخير قد أوفى بعهدك خيران","https://www.aldiwan.net/poem34887.html","الطويل"],[461,"بكرت عليه ضلة تعذلينه","https://www.aldiwan.net/poem55848.html","الطويل"],[461,"يا وحشة المجد ثقي بالأنس","https://www.aldiwan.net/poem56153.html","الرجز"],[464,"أأترك محيي العدل والشوق قائدي","https://www.aldiwan.net/poem15921.html","الطويل"],[464,"الام يراك المجد في زي شاعر","https://www.aldiwan.net/poem15927.html","الطويل"],[467,"في لأذني عن كل لاح صمم","https://www.aldiwan.net/poem3159.html","عموديه"],[471,"جمالي وزيني إذا ما حضر","https://www.aldiwan.net/poem59983.html","المتقارب"],[545,"لها في لحظها لحظات حتف","https://www.aldiwan.net/poem34024.html","الوافر"],[554,"يظن رجال بي ظنونا شنيئة","https://www.aldiwan.net/poem47184.html","الطويل"],[554,"أتاني والركبان يأتي نجيهم","https://www.aldiwan.net/poem47332.html","الطويل"],[554,"أيا ملك الأملاك قد جاءني الذي","https://www.aldiwan.net/poem47842.html","الطويل"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"أودع منك الصدر والبدر والبحرا","https://www.aldiwan.net/poem2722.html","الطويل"],[628,"","https://poetry.dctabudhabi.ae/diwan/poem/21183","الطويل"],[766,"","https://poetry.dctabudhabi.ae/diwan/poem/31486","الطويل"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/12036","البسيط"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/10433","الطويل"],[1013,"","https://poetry.dctabudhabi.ae/diwan/poem/79663","الطويل"],[1062,"","https://poetry.dctabudhabi.ae/diwan/poem/21394","الطويل"]],"verses":[["فَإِن غَنِمَ الجَيشُ المُغيرُ وَراءَهُ","فَما غُنمُهُ في الحَربِ غَيرَ غُلولِ",0,"ل",1,0],["فإنْ غِبْتَ غابَ الأنْسُ عنّي بأسْرِهِ","ومالِي منْ عيشٍ إذا لمْ تكُنْ مَعي",1,"ع",2,0],["فإنْ غابَ عنّي وجْهُهُ ودَلالُهُ","أعَلِّلُ قلْبي بالدُّجُنّةِ والبَدْرِ",2,"ر",1,0],["فَإِن غَدَوتَ وَزيراً","يَوماً وَجِئنا نُهَنّي",3,"ن",2,0],["فَإِن غُصَّ هَرونٌ بِجُرعَةِ عَمِّهِ","فَأَيسَرُ مَفقودٍ وَأَهوَنُ هالِكِ",4,"ك",1,0],["فَإِن غَفَلَ الراعي الَّذي نامَ بِالحِمى","فَإِنَّ بِحَجرٍ راعِياً غَيرَ غافِلِ",5,"ل",1,0],["فإن غارَ قالتْ له نفسُهُ","تغافلْ كأنكَ في واسط",6,"ط",1,0],["فإن غدتْ أجرة الحلّاقِ تعوزُه","فقد أبحتُ يديهِ نتفها خُصَلا",7,"ل",2,0],["فإن غمطوا الحلم أتبعتُه","مَغبَّة إطراقةِ الأُفعوان",8,"ن",1,0],["فإن غدوتُ فعنْ نفسٍ مكلَّفةٍ","مثلَ الحسير يُزجِّيها مزجِّيها",9,"ي",3,0],["فإِن غدرتْ بالحسنِ يوماً بناتُه","فذاك قليلٌ من كثيرِ بنيهِ",10,"ي",2,0],["فَإِن غَنِيَت لَنا دارٌ","بِجَمعِ الشَملِ لَم أَعُدِ",11,"د",1,0],["فَإِن غَدَرَت بِكَ الأَيامُ فَاِصبِر","وَكُن بِاللَهِ مَحمودَ المَعاني",12,"ن",2,0],["فَإِن غابَ ذاكَ البَدرُ عَن أُفقِ مُلكِهِ","فَقَد أَشرَقَت مِن نَجلِهِ أَنجُمٌ زُهرُ",13,"ر",1,0],["فَإِن غِبتَ فَاِجعَل لي وَلِيّاً مِنَ الأَذى","وَهَيهاتَ لا يُغني الوَلِيُّ عَنِ الوَسمي",14,"م",2,0],["فإن غفلت عيون الحظ عنا","وصرت ولم أكن أدري بقربي",15,"ب",2,0],["فَإِنَّ غَداً وَبَعدَ غَدٍ لَوَهنٌ","لِأَمرٍ ما يُقامُ لَهُ عَظيمِ",16,"م",1,0],["فَإِن غاضَتِ الأَيّامُ ماءَ شَبيبَتي","وَمالَت بِغُصنٍ مِن قَوامِيَ ناعِمِ",17,"م",1,0],["فَإِن غَضِبوا عَلَيَّ فَقَولُ حُرٍّ","يَرى أَوطانَهُ غَرَضَ النِبالِ",18,"ل",1,0],["فَإن غَيَّبُوا فِي التُّربِ عَادِل قَدّه","فَقَد غَيَّبُوا بَدراً وغُصناً من البَانِ",19,"ن",1,0],["فَإِن غَدا مِن فَوقِ ظَهرٍ نَدبِ","كانَ إِلى الأَرضِ سَريعَ الجَنبِ",20,"ب",1,0],["فَإنْ غَلُظَتْ مِنْهُمْ رِقَابٌ لِبُعْدِهِ","فَما انْحَطَّ عَنْها لِلْمَذَلَّةِ نِيرُ",21,"ر",1,0],["فَإِنَّ غُبارَ الصافِناتِ إِذا عَلا","نَشِقتُ لَهُ ريحاً أَلَذَّ مِنَ النَدِّ",22,"د",1,0],["فَإِنْ غَوَى أَخُْو نُهىً فَمُهْلَةً","حَتَّى يَرُدَّهُ نُهَاهُ رَدَّا",23,"د",2,0],["فإن غبت غاب الأنس عني بأسره","ومالي من عيش إذا لم تكن مع",24,"ع",1,0],["فإن غال خطب فهوى مأوى من الردى","وإن جل ذنب فهو في الذنب شافع",25,"ع",1,0],["فإن غفل الواشون عدنا لوصلنا","وعاد التّصافي بيننا والتّراسل",26,"ل",1,0],["فإن غيض عنها الماء غاضت حياتها","وعادت هشيماً للتراب يعود",27,"د",1,0],["فإن غاب عن عيني فعندي خياله","وفي الروح مأواه وفي القلب يختلج",28,"ج",1,0],["فإن غرّت أعاديه هناة","فإن الله خير الناصرينا",29,"ن",2,0],["فإن غضبت فالنصر للسيف والقنا","فهم خدمٌ لا شكَّ يكفونها القرنا",30,"ن",2,0],["فَإِن غاضَ في أَرضي الوَفاءُ وَقُطِّعَت","أَواصِرُ ذي القُربى وَعزَّ المُناصِحُ",31,"ح",1,0],["فَإِن غَضِبَت فيها عُقَيلٌ فَأَنتُمُ","بَنو الحَربِ إِذ يُذكي لَظاها ضِرامُها",32,"م",3,0],["فَإِن غالَهُم رَيبُ المَنونِ كَغَيرِهِم","فَقَولُوا عَلى الدُنيا وَأَبنائِها العَفا",33,"ف",2,0],["فإن غالني صرف الزمان وريبه","وأعوزني فيه خليل مقارب",34,"ب",1,0],["فإن غبت فالشوق المبرّح قاتلي","وإن قربت دار فقيل رقيب",35,"ب",1,0],["فَإِن غَضِبَت فيها حَبيبُ بنُ حَبتَرٍ","فَخُذ خُطَّةً يَرضاكَ فيها الأَباعِدُ",36,"د",1,0],["فإن غَرَّبَتْ يمضي إليها مُغَرِّبَاً","وإن شرَّقَتْ يمضي إليها مُشَرِّقَا",37,"ق",2,0],["فإن غاية من أقضى به أمل","إلى تناول ما فوق السهى التعب",38,"ب",1,0],["فإن غَضِبوا للحقِّ يوماً تلَهّبت","صَوارمُ في أيدي الضّواري ضَوارِم",39,"م",1,0],["فإِن غادَرَ التَّجْسيمَ شلْواً مُمَزَّعاً","فَقَدْ صانَ للتَّوحيدِ وَجْهاً مُمَرَّغَا",40,"غ",2,0],["فَإِن غِبتَ عَنهُ حَلَّ فِيه وَطَنَّبَت","عَلَى الكَشفِ المَصُونِ خِيَامُهُ",41,"م",2,0],["فإن غفا مدّ له مسرحا","حدوده فوق مرامى النظر",42,"ر",1,0],["فَإِن غَدَوتَ رائِداً لِوِردِهِم","فَأَلُ إِلى الآلِ وَلِلبِرِّ فَبَر",43,"ر",1,0],["فانغَمسوا في نَعيمهمْ وأنا","في الهذَيان الطّويلِ مُنَغَمسي",44,"س",2,0],["فإنْ غدا وله في قَلْبِه أثَرٌ","لم يَبْقَ للعَبْدِ لا عَيْنٌ ولا أثَر",45,"ر",1,0],["فإن غَضِبتَ عُظِّم المصابُ","وضَلَّ بالكُلِّية الصوابُ",46,"ب",1,0],["فإن غفَرت فَذو فضلٍ وذو كرَمٍ","وإن سطَرتَ فأنتَ الحاكم العادِلُ",47,"ل",1,0],["فإن غُرِسَتْ في بابلٍ فتوقّها","فكلُّ غزالٍ حلّ بابلَ نابِلُ",48,"ل",1,0],["فإنْ غَدَتْ منهُمُ الأَيامُ مُوحِشَةً","فالحاجِبُ القائِدُ الأَعلى لَهَا خَلَفُ",49,"ف",1,0],["فإِنْ غَدَا شَعْبُكُمْ فِي اللهِ مُفْتَرِقاً","فإِنَّ شَعْبَكُمُ فِي المَجْدِ مُجْتَمِعُ",50,"ع",1,0],["فَإِنْ غَرَّبَتْ أرض المغاربِ مَوئِلي","وأَنْكَرَنِي فِيهَا خَليطٌ وخِلّانُ",51,"ن",1,0],["فإن غادرتْ أمسِي نحولا صروفُهُ","فلليوم حتى أستعيدَ سمينَهُ",52,"ن",2,0],["فإن غلت بصدره حميَّةٌ","راعك وجهُ الضيغم المعبِّسِ",53,"س",1,0],["فانْ غِبْتُ عن نادي عُلاهُ فانني","بمدحي مُقيمٌ في ذَراهُ عَتيدُ",54,"د",1,0],["فانْ غَربتْ في نحر كلِّ مَدَجَّجٍ","واِلا لَقىً معْزولةٌ بالبَواتِرِ",55,"ر",1,0],["فان غضبتم لمقالي فاغتصبوا","إذ الوهاجُ قد سمتها القممِ",56,"م",1,0],["فَإِن غَدَرَ الدَهرُ بي في أَخي","فَكَم مِن كَريمٍ بِهِ قَد غَدَر",57,"ر",1,0],["فإن غضبت رأيتَ الناس قتلى","وإن ضحكت فأرواحٌ تعودُ",58,"د",1,0],["فإِنّ غرتُ في تفتيشِ مَن أستعينُهُ","فَما هو إلّا مَن عليَّ يُعينُ",59,"ن",1,0],["فإنْ غبتَ عنّا فالنّجومُ غوائبٌ","وإنْ زلتَ عنّا فالجبالُ زوائلُ",60,"ل",1,0],["فإنْ غرَّد الشادِي بهنَّ تنغُّماً","تناسيتَ تغريد الحَمامِ المغرّدِ",61,"د",1,0],["فإن غضبت فهو في جواري","مثلث بالأشعار والأبشار",62,"ر",1,0],["فإِن غبتُ فاذكرني فإِنِّيَ مؤمنٌ","ولا مؤمنٌ إِلاَّ وتَنْفعُه الذِّكْرَى",63,"ر",2,0],["فَإِن غابَ عَنّا غائِبٌ أَو تَخاذَلو","كَفى ذاكَ مِنهُم وَالجَنابُ خَصيبُ",64,"ب",1,0],["فَإِنَّ غَداً إِن لا نَجِد بَعضَ زادِنا","نُفِىء لَكِ زادا أَو نُعَدِّكِ بِالأَزمِ",65,"م",1,0],["فَإِن غُلِبتُم عَلى ضِنٍّ بِدارِكُمُ","فَقَد لَقيتُم بِأَمرٍ حازِمٍ فَزَعا",66,"ع",2,0],["فَإِن غِبتُ لَم أُغفِل وَإِن كُنتُ شاهِداً","تَجِدني شَديداً في الكَريهَةِ جانِبي",67,"ب",2,0],["فإنْ غابَ يوماً كنْتَ أَنَتَ مكانَه","وسوفَ تراني يومَ ذاكَ أَلوبُ",68,"ب",1,0],["فإِن غالَنا دَهرٌ فَقَد غالَ قَبلَنا","مُلوكَ بَني نَصرٍ وَكِسرى وَقَيصَرا",69,"ر",2,0]]}