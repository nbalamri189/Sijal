,""],[5957,"رجاء","https://www.poetsgate.com/ViewPoem.aspx?id=59641",""],[5997,"أعوذُ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=214253",""],[6093,"حَرْثُ فِكْرٍ ( الطويل)","https://www.poetsgate.com/ViewPoem.aspx?id=183200",""],[6124,"لينة","https://www.poetsgate.com/ViewPoem.aspx?id=193274",""],[2220,"تولدتَ عني وعن واحدٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11316&r=&rc=190",""],[6331,"الشكوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82021&r=&rc=2",""]],"verses":[["فَإِن غَنِمَ الجَيشُ المُغيرُ وَراءَهُ","فَما غُنمُهُ في الحَربِ غَيرَ غُلولِ",0,"ل",1,0],["فإنْ غِبْتَ غابَ الأنْسُ عنّي بأسْرِهِ","ومالِي منْ عيشٍ إذا لمْ تكُنْ مَعي",1,"ع",2,0],["فإنْ غابَ عنّي وجْهُهُ ودَلالُهُ","أعَلِّلُ قلْبي بالدُّجُنّةِ والبَدْرِ",2,"ر",1,0],["فَإِن غَدَوتَ وَزيراً","يَوماً وَجِئنا نُهَنّي",3,"ن",2,0],["فَإِن غُصَّ هَرونٌ بِجُرعَةِ عَمِّهِ","فَأَيسَرُ مَفقودٍ وَأَهوَنُ هالِكِ",4,"ك",1,0],["فَإِن غَفَلَ الراعي الَّذي نامَ بِالحِمى","فَإِنَّ بِحَجرٍ راعِياً غَيرَ غافِلِ",5,"ل",1,0],["فإن غارَ قالتْ له نفسُهُ","تغافلْ كأنكَ في واسط",6,"ط",1,0],["فإن غدتْ أجرة الحلّاقِ تعوزُه","فقد أبحتُ يديهِ نتفها خُصَلا",7,"ل",2,0],["فإن غمطوا الحلم أتبعتُه","مَغبَّة إطراقةِ الأُفعوان",8,"ن",1,0],["فإن غدوتُ فعنْ نفسٍ مكلَّفةٍ","مثلَ الحسير يُزجِّيها مزجِّيها",9,"ي",3,0],["فإِن غدرتْ بالحسنِ يوماً بناتُه","فذاك قليلٌ من كثيرِ بنيهِ",10,"ي",2,0],["فَإِن غَنِيَت لَنا دارٌ","بِجَمعِ الشَملِ لَم أَعُدِ",11,"د",1,0],["فَإِن غَدَرَت بِكَ الأَيامُ فَاِصبِر","وَكُن بِاللَهِ مَحمودَ المَعاني",12,"ن",2,0],["فَإِن غابَ ذاكَ البَدرُ عَن أُفقِ مُلكِهِ","فَقَد أَشرَقَت مِن نَجلِهِ أَنجُمٌ زُهرُ",13,"ر",1,0],["فَإِن غِبتَ فَاِجعَل لي وَلِيّاً مِنَ الأَذى","وَهَيهاتَ لا يُغني الوَلِيُّ عَنِ الوَسمي",14,"م",2,0],["فإن غفلت عيون الحظ عنا","وصرت ولم أكن أدري بقربي",15,"ب",2,0],["فَإِنَّ غَداً وَبَعدَ غَدٍ لَوَهنٌ","لِأَمرٍ ما يُقامُ لَهُ عَظيمِ",16,"م",1,0],["فَإِن غاضَتِ الأَيّامُ ماءَ شَبيبَتي","وَمالَت بِغُصنٍ مِن قَوامِيَ ناعِمِ",17,"م",1,0],["فَإِن غَضِبوا عَلَيَّ فَقَولُ حُرٍّ","يَرى أَوطانَهُ غَرَضَ النِبالِ",18,"ل",1,0],["فَإن غَيَّبُوا فِي التُّربِ عَادِل قَدّه","فَقَد غَيَّبُوا بَدراً وغُصناً من البَانِ",19,"ن",1,0],["فَإِن غَدا مِن فَوقِ ظَهرٍ نَدبِ","كانَ إِلى الأَرضِ سَريعَ الجَنبِ",20,"ب",1,0],["فَإنْ غَلُظَتْ مِنْهُمْ رِقَابٌ لِبُعْدِهِ","فَما انْحَطَّ عَنْها لِلْمَذَلَّةِ نِيرُ",21,"ر",1,0],["فَإِنَّ غُبارَ الصافِناتِ إِذا عَلا","نَشِقتُ لَهُ ريحاً أَلَذَّ مِنَ النَدِّ",22,"د",1,0],["فَإِنْ غَوَى أَخُْو نُهىً فَمُهْلَةً","حَتَّى يَرُدَّهُ نُهَاهُ رَدَّا",23,"د",2,0],["فإن غبت غاب الأنس عني بأسره","ومالي من عيش إذا لم تكن مع",24,"ع",1,0],["فإن غال خطب فهوى مأوى من الردى","وإن جل ذنب فهو في الذنب شافع",25,"ع",1,0],["فإن غفل الواشون عدنا لوصلنا","وعاد التّصافي بيننا والتّراسل",26,"ل",1,0],["فإن غيض عنها الماء غاضت حياتها","وعادت هشيماً للتراب يعود",27,"د",1,0],["فإن غاب عن عيني فعندي خياله","وفي الروح مأواه وفي القلب يختلج",28,"ج",1,0],["فإن غرّت أعاديه هناة","فإن الله خير الناصرينا",29,"ن",2,0],["فإن غضبت فالنصر للسيف والقنا","فهم خدمٌ لا شكَّ يكفونها القرنا",30,"ن",2,0],["فَإِن غاضَ في أَرضي الوَفاءُ وَقُطِّعَت","أَواصِرُ ذي القُربى وَعزَّ المُناصِحُ",31,"ح",1,0],["فَإِن غَضِبَت فيها عُقَيلٌ فَأَنتُمُ","بَنو الحَربِ إِذ يُذكي لَظاها ضِرامُها",32,"م",3,0],["فَإِن غالَهُم رَيبُ المَنونِ كَغَيرِهِم","فَقَولُوا عَلى الدُنيا وَأَبنائِها العَفا",33,"ف",2,0],["فإن غالني صرف الزمان وريبه","وأعوزني فيه خليل مقارب",34,"ب",1,0],["فإن غبت فالشوق المبرّح قاتلي","وإن قربت دار فقيل رقيب",35,"ب",1,0],["فَإِن غَضِبَت فيها حَبيبُ بنُ حَبتَرٍ","فَخُذ خُطَّةً يَرضاكَ فيها الأَباعِدُ",36,"د",1,0],["فإن غَرَّبَتْ يمضي إليها مُغَرِّبَاً","وإن شرَّقَتْ يمضي إليها مُشَرِّقَا",37,"ق",2,0],["فإن غاية من أقضى به أمل","إلى تناول ما فوق السهى التعب",38,"ب",1,0],["فإن غَضِبوا للحقِّ يوماً تلَهّبت","صَوارمُ في أيدي الضّواري ضَوارِم",39,"م",1,0],["فإِن غادَرَ التَّجْسيمَ شلْواً مُمَزَّعاً","فَقَدْ صانَ للتَّوحيدِ وَجْهاً مُمَرَّغَا",40,"غ",2,0],["فَإِن غِبتَ عَنهُ حَلَّ فِيه وَطَنَّبَت","عَلَى الكَشفِ المَصُونِ خِيَامُهُ",41,"م",2,0],["فإن غفا مدّ له مسرحا","حدوده فوق مرامى النظر",42,"ر",1,0],["فَإِن غَدَوتَ رائِداً لِوِردِهِم","فَأَلُ إِلى الآلِ وَلِلبِرِّ فَبَر",43,"ر",1,0],["فانغَمسوا في نَعيمهمْ وأنا","في الهذَيان الطّويلِ مُنَغَمسي",44,"س",2,0],["فإنْ غدا وله في قَلْبِه أثَرٌ","لم يَبْقَ للعَبْدِ لا عَيْنٌ ولا أثَر",45,"ر",1,0],["فإن غَضِبتَ عُظِّم المصابُ","وضَلَّ بالكُلِّية الصوابُ",46,"ب",1,0],["فإن غفَرت فَذو فضلٍ وذو كرَمٍ","وإن سطَرتَ فأنتَ الحاكم العادِلُ",47,"ل",1,0],["فإن غُرِسَتْ في بابلٍ فتوقّها","فكلُّ غزالٍ حلّ بابلَ نابِلُ",48,"ل",1,0],["فإنْ غَدَتْ منهُمُ الأَيامُ مُوحِشَةً","فالحاجِبُ القائِدُ الأَعلى لَهَا خَلَفُ",49,"ف",1,0],["فإِنْ غَدَا شَعْبُكُمْ فِي اللهِ مُفْتَرِقاً","فإِنَّ شَعْبَكُمُ فِي المَجْدِ مُجْتَمِعُ",50,"ع",1,0],["فَإِنْ غَرَّبَتْ أرض المغاربِ مَوئِلي","وأَنْكَرَنِي فِيهَا خَليطٌ وخِلّانُ",51,"ن",1,0],["فإن غادرتْ أمسِي نحولا صروفُهُ","فلليوم حتى أستعيدَ سمينَهُ",52,"ن",2,0],["فإن غلت بصدره حميَّةٌ","راعك وجهُ الضيغم المعبِّسِ",53,"س",1,0],["فانْ غِبْتُ عن نادي عُلاهُ فانني","بمدحي مُقيمٌ في ذَراهُ عَتيدُ",54,"د",1,0],["فانْ غَربتْ في نحر كلِّ مَدَجَّجٍ","واِلا لَقىً معْزولةٌ بالبَواتِرِ",55,"ر",1,0],["فان غضبتم لمقالي فاغتصبوا","إذ الوهاجُ قد سمتها القممِ",56,"م",1,0],["فَإِن غَدَرَ الدَهرُ بي في أَخي","فَكَم مِن كَريمٍ بِهِ قَد غَدَر",57,"ر",1,0],["فإن غضبت رأيتَ الناس قتلى","وإن ضحكت فأرواحٌ تعودُ",58,"د",1,0],["فإِنّ غرتُ في تفتيشِ مَن أستعينُهُ","فَما هو إلّا مَن عليَّ يُعينُ",59,"ن",1,0],["فإنْ غبتَ عنّا فالنّجومُ غوائبٌ","وإنْ زلتَ عنّا فالجبالُ زوائلُ",60,"ل",1,0],["فإنْ غرَّد الشادِي بهنَّ تنغُّماً","تناسيتَ تغريد الحَمامِ المغرّدِ",61,"د",1,0],["فإن غضبت فهو في جواري","مثلث بالأشعار والأبشار",62,"ر",1,0],["فإِن غبتُ فاذكرني فإِنِّيَ مؤمنٌ","ولا مؤمنٌ إِلاَّ وتَنْفعُه الذِّكْرَى",63,"ر",2,0],["فإن غمرتَ على مِثلي بِعارِفةٍ","فيها من الدَّهر إعتابٌ وإسجاح",64,"ح",1,0],["فإن غاب عين اللَه في عين غيبه","هو اللَه في أسمائه المستوية",65,"ه",1,0],["فَإِن غبتَ فَالأَرواح تَسعى جُنودُها","لَدَيك وَفي الأَشباح دُونك تزهد",66,"د",1,0],["فَإِن غراب البين طار إِلى اللظى","لِيُحرق فيها مَع ذَويه بِنيران",67,"ن",1,0],["فَإِن غابَ عَنّا غائِبٌ أَو تَخاذَلو","كَفى ذاكَ مِنهُم وَالجَنابُ خَصيبُ",68,"ب",1,0],["فإن غبتُ عن نجد فليس بغائب","ضميرٌ يُناجي أو فؤاد يفكر",69,"ر",1,0],["فان غرقت ببحر الحب لا عجب","ففي بحور الهوى الفيت كم غرقى",70,"ق",2,0],["فإن غشي الكرم جفنيك ليلاً","وعادك تحت طيته أساكا",71,"ك",2,0],["فإن غبت عن يوم الحسين فلم تغب","بنو أسد أسد الهياج أقاربي",72,"ب",2,0],["فان غُيّبَتْ عنها رجالٌ فإنّها","إليك إذا عنْهُم عوانٍ شوارِدُ",73,"د",1,0],["فانغمرت روحي وناديته","يا أيها الثعبان بالكهف",74,"ف",1,0],["فإن غيض ماء أو أصابته علة","تنكس فاستلقى الجميع على الظهر",75,"ر",1,0],["فإن غضب ارتاعت ملوك وزلزلت","عروش وطاشت أنفسٌ وعقول",76,"ل",1,0],["فَإِنَّ غَداً إِن لا نَجِد بَعضَ زادِنا","نُفِىء لَكِ زادا أَو نُعَدِّكِ بِالأَزمِ",77,"م",1,0],["فإن غسلت شقاً عراها ابتداله","وأدركها رد الخليط المصرم",78,"م",1,0],["فإن غسلت فأتت ولو بنجاسةٍ","مطلقها والعلم بعد التعلمِ",78,"م",1,0],["فإن غيرت والزوج مستمسك بها","فلا نقضَ إن عادت إلى الزوج تجنح",79,"ح",1,0],["فإن غَرَّ برق سواه فلذ","بأبلج طلق المحيا أغرّ",80,"ر",1,0],["فإنّ غناه بأعياننا","مُحالٌ عليه لدى الناشد",81,"د",1,0],["فَإِنَّ غَرامي بِالبُرَيقِ وَلَمحِهِ","وَلَيسَ غَرامي بِالأَماكِنِ وَالتُربِ",82,"ب",1,0],["فإن غرامَك بعد مماتي","هنالك حيٌّ يناجي الغيوبا",83,"ب",2,0],["فَإِن غُلِبتُم عَلى ضِنٍّ بِدارِكُمُ","فَقَد لَقيتُم بِأَمرٍ حازِمٍ فَزَعا",84,"ع",2,0],["فَإِن غِبتُ لَم أُغفِل وَإِن كُنتُ شاهِداً","تَجِدني شَديداً في الكَريهَةِ جانِبي",85,"ب",2,0],["فإنْ غرَبَ النّجمُ الذي انقرضوا به","فقد كشف الظّلماءَ من نجمه بدرُ",86,"ر",1,0],["فإِن غضبوا شدّوا المشارفَ منهم","ملوكٌ وحُكّامٌ كلامُهمُ فَصلُ",87,"ل",1,0],["فإن غدوتَ صديقي","أضعتُ فيك الوئاما",88,"م",2,0],["فإن غبتُ لا يبقى سوى الله حارساً","لنفسي يوقيّها المخاطر ألوانا",89,"ن",2,0],["فَإِنْ غَلِطَتْ عَيْنُ الجَهُولِ فَشَاهَدَتْ","خِلاَفاً فَفي عَيْنِ الوِفَاقِ المُنَاصِحِ",90,"ح",1,0],["فإنْ غضبتَ على شخصٍ لتشتمه","فقُلْ له أنتَ إنسانٌ ابن انسانِ",91,"ن",1,0],["فإنْ غابَ يوماً كنْتَ أَنَتَ مكانَه","وسوفَ تراني يومَ ذاكَ أَلوبُ",92,"