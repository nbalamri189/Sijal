لصَبِّ جَوىً وَاِنقَضى",1,"ض",2,0],["عهِدْتُ بِها خِشْفاً أغَنَّ كأنّني","أرى بمَخَطِّ النُّؤْيِ مُلْقى سِوارِهِ",2,"ر",2,0],["عَهِدْتُ بهِ غَيداءَ تُلقي على الثّرى","أَساوِدَ فَرْعٍ في القُلوبِ لها نَشْطُ",3,"ط",1,0],["عَهدي بِهِ مَدَّ النَهارِ كَأَنَّم","خُضِبَ البَنانُ وَرَأسُهُ بِالعِظلِمِ",4,"م",1,0],["عهْدَ الشّبابِ سَقَى أيّامَكَ الأُوَلا","سحٌّ منَ الدّمْعِ إنْ شحَّ الحَيا هطَلا",5,"ل",2,1],["عُهودٌ مُنى ألْوى بجدّتِها المَدى","وقلّصَ منْ إيناسِها ذلِكَ الظِّلاّ",6,"ل",2,0],["عهْدي بهِ والدّهْرُ يُتْحِفُ بالمُنى","وقدِ اقْتَضَتْ نُعْماهُ أن لا بُوسا",7,"س",2,0],["عَهْدِي بِهَاتِيكَ الْكَرِيمَةِ مُهْرَقٌ","يَقَقٌ تُسَرُّ بِهِ الْعُيُونُ وَتُغْبَطُ",8,"ط",1,1],["عهْدي بذاكَ الجَبينِ قدْ مُلِئَتْ","غُصونُهُ الغُبْرُ بالدّمِ الهَدَرِ",9,"ر",1,0],["عهْدي بذاكَ القَفا الغليظِ وقدْ","مُدَّ لوقْعِ المهنّدِ الذَّكَرِ",9,"ر",1,0],["عهِدْناهُ في كلِّ المَعارِفِ مُطْنِباً","فَما بالُهُ في حُرْمَةِ الوُدِّ مخْتَصِرْ",10,"ر",1,0],["عُهودُ مُنىً غصَّ الزّمانُ بحُسْنها","فغارَ عليْها والزّمانُ غَيورُ",11,"ر",1,0],["عُهودُ أُنْسٍ وأيّامٌ لَنا انْصَرَفَتْ","أخْنى علَيْها الذي أخْنى على لُبَدِ",12,"د",1,0],["عَهدي بِها في الحَيِّ قَد سُربِلَت","هَيفاءَ مِثلَ المُهرَةِ الضامِرِ",13,"ر",1,0],["عَهدي بِهِ يَلقى الرَدى بِمُهَنَّدٍ","يَعلوهُ غِمدٌ مِن دَمٍ مَسفوكِ",14,"ك",1,0],["عَهِدوكِ لا تَتَصَدَّعينَ لِحادِثٍ","أَوَ أَنتِ باقِيَةٌ كَما عَهِدوكِ",14,"ك",1,0],["عَهِدناكَ لا تَبكي وَتُنكِرُ أَن يُرى","أَخو البَأسِ في بَعضِ المَواطِنِ باكِيا",15,"ي",2,0],["عَهدُ الرَشيدِ بِبَغدادٍ عَفا وَمَضى","وَفي دِمَشقَ اِنطَوى عَهدُ اِبنِ مَروانِ",16,"ن",1,0],["عَهدٌ سَما الشِعرُ فيهِ","إِلى مَجالي الشُموسِ",17,"س",1,0],["عَهدي بِهِ وَاليَدُ اليُمنى يَكُفُّ بِها","غَربَ المَدامِعِ وَالأُخرى عَلى الكَبِدِ",18,"د",1,0],["عَهدي بِأَنيابِ النَوائِبِ عِندَهُ","دُرداً وَظفرِ الحادِثاتِ مُقَلَّما",19,"م",2,0],["عَهدي كَعَهدِكَ ما الدُنيا تُغَيِّرُهُ","وَإِن تَغَيَّرَ مِنكَ العَهدُ أَلوانا",20,"ن",2,0],["عَهِدنا المَكارِمَ فيهِ مَعاني","تُبَشِّرُنا فيهِ مِنها الجُمَل",21,"ل",1,0],["عَهِدْنَاهُ لا تَلْقَاهُ إِلاَّ عَلَى الرِّضَا","وَيَخْشَنُ آناً عِرْضٌ يَعِفُّ وَدِينُ",22,"ن",1,0],["عَهْدِي بِهِ إِنْ كَافَحَتْهُ حَوَادِثٌ","أَبْلَى بِعَزْمٍ فِي الْكِفَاحِ مَتِينِ",23,"ن",1,0],["عَهْدُ ذَاكَ المَقَامِ أَكْرَمُ مَا يَحْفَظُهُ","فِي القُلُوبِ شَعْبٌ مُوَالِي",24,"ي",1,0],["عَهِدنا بِها لَو تُسعِفُ العوجُ بِالهَوى","رِقاقِ الثَنايا وَاضِحاتِ المَعاصِمِ",25,"م",1,0],["عَهِدتُ بِهِ الحَيَّ الحُلولَ بِسَلوَةٍ","جَميعاً وُآياتُ الهَوى ما تُزَيِّلُ",26,"ل",1,0],["عهدي بها سَدَلّتْ عليَّ ظلالها","فسدلتُ ظلاًّ للشباب ظليلا",27,"ل",2,0],["عهدي بها والعيش أخضر ناعم","والشمل تجمعه يد الأفراح",28,"ح",1,0],["عهد الصبا سقياً لأيام الصبا","أشبه شئ بأزاهير الربا",29,"ا",1,1],["عهدناك لا تَلهو عن الخِلّ ساعةً","فكيف علينا قد أطلت التجافيا",30,"ي",2,0],["عهِدتُك شاعر العرب المُجيدا","فما لك لا تطارحنا النشيد",31,"د",1,1],["عَهدي بِها الإِنسَ الجَميعَ وَفيهُمُ","قَبلَ التَفَرُّقِ مَيسِرٌ وَنِدامُ",32,"م",1,0],["عهدت الليالي حلوةً بارتشافهِ","وهنَّ الليالي لا يدوم لها عهد",33,"د",1,0],["عهدت فؤادِي ملآن من","شجونٍ ولا موضعٌ لازْدِياد",34,"د",1,0],["عهدِي بسفحِك مرتعاً لأوانسٍ","كم في محاسنها لنا من مرتع",35,"ع",1,0],["عَهْدُنا بالرياحِ كانت تَبارى","بالعطايا الرِّغاب والنفحاتِ",36,"ت",1,1],["عهدي بِرَيِّقِ لهوها خضلاً","أَرِقَ الرياض يرفُّ مُمرِعه",37,"ع",2,0],["عهْدتُ به شرخَ الشبابِ ونعمةً","كنعمةِ قومٍ أصبحوا في ظِلالكا",38,"ك",2,0],["عهدُ كفّي بفضل كفيكَ عهدٌ","يمنعُ السائل الملحَّ السؤالا",39,"ل",2,0],["عهدْنا لك الكفَّ التي جلَّ بذلُها","فلِمْ قلّ لما زادك الله بذْلُها",40,"ل",3,0],["عهدتُك لا تَعْتَدُّ بالعين شاهداً","عليَّ فلمْ أصبحتَ تَعْتَدُّ بالأذن",41,"ن",1,0],["عهودٌ خَلَتْ محمودةً وكأنَّها","مُعانَقَةُ اللَّذاتِ في حُلَّة الأمن",41,"ن",1,0],["عَهَدتُكَ تَأبى دَعوَةً غَيرَ دَعوَتي","فَمالَكَ تَأبى مُصطَفى كُلَّ دَعَوَةِ",42,"ه",1,0],["عَهدٌ تَرَحَّلَتِ البَشاشَةُ إِذ مَضى","وَأَتى الأَسى فَآقامَ لا يَتَرَحَّلُ",43,"ل",1,0],["عَهدُكَ الآنَ بِالحَبيبِ قَريبٌ","وَلَنا نَحنُ مُدَّةً ما اِلتَقَينا",44,"ن",2,0],["عَهِدتُكَ لاتُطيقُ الصَبرَ عَنّي","وَتَعصي في وَدادي مَن نَهاكا",45,"ك",2,0],["عَهِدتُ رَبعَكِ مَأنوساً يُغازِلُني","فيهِ شُموسٌ مُنيراتٌ وَأَقمارُ",46,"ر",1,0],["عَهِدنا بِها سَلمى وَفي العَيشِ غِرَّةٌ","وَسُعدى بِأَلبابِ الرِجالِ خَلوجُ",47,"ج",1,0],["عَهِدنا الجِيادَ الجُردِ كُلَّ عَشِيَّةٍ","يُشارُ بِها وَالمَجلِسَ المُتَباهِيا",48,"ي",2,0],["عهدٌ كَمَعْسولِ الرُّؤَى","مَا بينَ أجنحَةِ السُّبَاتْ",49,"ت",1,0],["عَهِدنا البِحار لِزَجرٍ وَمَدٍّ","وَتأبى بِحارُ أَياديكَ جَزرا",50,"ر",2,0],["عهدتكَ تمشي أيها القلب خلفهم","فقل لي لماذا أنت يا قلب آيب",51,"ب",1,0],["عهدها لي والمنى أمتزجا","كامتزاج الروح بالبدن",52,"ن",1,0],["عَهدُ الخِلافَةِ فِيَّ أَوَّلُ ذائِدٍ","عَن حَوضِها بِبَراعَةٍ نَضّاحِ",53,"ح",1,0],["عَهدُ البَقيعِ وَساكِني","هِ عَلى الحَيا المُتَهَدِّلِ",54,"ل",1,0],["عَهدٌ مِنَ الشورى الظَليلَةِ نُضِّرَت","آصالُهُ وَاِخضَلَّتِ الأَسحارُ",55,"ر",1,0],["عَهدُ الفِرَنجِ وَأَنتَ تَعلَمُ عَهدَهُم","لا يَبخَسونَ المُحسِنينَ فَتيلا",56,"ل",2,0],["عَهدُ النَبِيِّ هُوَ السَماحَةُ وَالرِضى","بِمُحَمَّدٍ أَولى وَسَمحِ خِلالِهِ",57,"ل",2,0],["عَهْدِي بِهِ مَيْتاً كأَحْسَنِ نائمٍ","والحُزْنُ يَسْفَحُ عَبْرَتي في نَحْرِهِ",58,"ر",2,0],["عَهدي بِمَعرَكَةِ الأَميرِ وَخَيلُهُ","في النَقعِ مُحجِمَةٌ عَنِ الإِحجامِ",59,"م",1,0],["عهِدتُ به غصنَ الشبيبةِ مورِقاً","فخانَ وخنتمْ والوفاءُ قليلُ",60,"ل",1,0],["عهدي بظلّك والشبابُ يَزينُهُ","أيامَ ربعُك للحِسانِ عُكَاظُ",61,"ظ",1,0],["عَهِدناهُ دَهراً بِالوُفودِ مُعضَّلاً","يُزاحِمُ فيهِ الأَقرَبينَ الأَباعِدُ",62,"د",1,0],["عَهدي بِرَبعِكَ مَأنوساً مَلاعِبُهُ","أَشباهُ آرامِهِ حُسناً كَواعِبُهُ",63,"ب",2,1],["عَهدُ المَشوقِ بِوَصلِ الأُنَّسِ الخُرُدِ","يَكادُ يَشرَكُ نَجمَ اللَيلَ في البُعُدِ",64,"د",1,1],["عَهدٌ لِعَلوَةَ بِاللِوى قَد أَشكَلا","ما كانَ أَحسَنُ مُبتَداهُ وَأَجمَلا",65,"ل",2,1],["عَهِدَتني وَلِلشَبيبَةِ سِربا","لٌ جَديدٌ فَأَنهَجَ السِربالُ",66,"ل",1,0],["عَهدي بِرَبعِكَ مُثَّلاً آرامُهُ","يُجلى بَضَوءِ خُدودِهِنَّ ظَلامُهُ",67,"م",2,1],["عَهدٌ مِنَ الأُنسِ عاقَرنا الكُؤوسَ عَلى","بَديإِهِ وَخَبَطنا فيهِ أَزمانا",68,"ن",2,0],["عَهدٌ مِنَ السَيفِ عَلى خَدِّهِ","مُجاوِرٌ مارِنَ ع