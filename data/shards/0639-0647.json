,0],["عَهدي بِهِ مَدَّ النَهارِ كَأَنَّما","خُضِبَ البَنانُ وَرَأسُهُ بِالعِظلِمِ",117,"م",1,0],["عَهْدٌ كَطَيْفٍ زَارَ حَتَّى إِذَا","أَشْرَقَ صُبْحٌ مِنْ مَشِيبي مَضَى",118,"ض",2,0],["عَهِدْتُكَ لاَ تَهْوَى ثَنَاءً لِقَائِلِ","وَتؤْثِرُ فِي صَمْتِ ثَنَاءَ الفَضَائِلِ",119,"ل",1,1],["عَهْدٌ قَدِيمٌ مِنَ الوُدِّ","كَانَ خَيْرُ العُهُودِ",120,"د",1,0],["عهْدٌ غَنمْنَا الحلْو مِنْ أَوْقاتِهِ","حَتْى اسْتَمرَّ ولَمْ يَكنْ مَمْلولاَ",121,"ل",2,0],["عَهْدَ الخَلِيلِ سَقَتْكَ أَصْفى دَرِّهَا","دِيَمُ الضُّحَى وَغَمَائِمُ الآصَالِ",122,"ل",1,0],["عهْدٌ مَضَى وَغَدا أَعِزَّتُهُ الأولَى","أَحْيَوَا بِلاَداً فِي الرَّمِيمِ البَالِي",122,"ي",1,0],["عَهْدٌ بِمَا أَنْجَحْتَ فِيهِ مِنَ المُنَى","لاَ الفَضْلُ مَنْقوصٌ وَلاَ مَسْبُوقُ",123,"ق",1,0],["عَهْدُكَ يَا فَارُوقَنَا المُجْتَبَى","مِنْ نِعَمِ اللهِ عَلَى الخَلْقِ",124,"ق",1,0],["عَهْدُ شَمسِ المُلُوكِ زَانَتْهُ شُهْبٌ","بَاهِرَاتٌ وَأَنْتَ فِي الشُّهْبِ بَدْرُ",125,"ر",1,0],["عَهْدُ نُورٍ مِنَ الحِفَاظِ وَنَارٍ","بَعْدَ طُولِ الخُمُودِ وَالإِخْمَادِ",126,"د",1,0],["عَهْدُ فَارُوقَ كَانَ لِليُمْنِ عَهْداً","مِن قَدِيمٍ وَعَادَ لِليُمْنِ عَهْدَا",127,"د",2,0],["عَهْدُهَا عَهْدُهَا كَمَا كضانَ وَالما","ضِي بِمَا بَعْدَهُ وَثِيقُ الصِّلاةِ",128,"ه",1,0],["عَهْداً بِهِ ضَمَّتْ فُؤَا","داً وَاحِداً مِنَّا الجُنُوبُ",129,"ب",1,0],["عَهْدٌ قَشِيبٌ يَوْمَ مَوْلِدِهَا بَدَا","في أَيِّ ثَوْبٍ للحَيَاةِ قَشِيبِ",130,"ب",1,0],["عَهْدِي بِجَدِّكَ كَمْ","تُعَاوِدُنِي بِذِكْراهُ الخَوَاطِرْ",131,"ر",1,0],["عَهْدُهُ كَانَ عَهْدَ خَيْرٍ وَخَيْرُ النَّا","سِ مَنْ وُدَّ فِي الجَوَارِ وَوَدَّا",132,"د",2,0],["عَهْدُهُ بِالأَمْنِ وَاليُمْ","نِ مَحَا تِلْكَ العُهُودا",133,"د",2,0],["عهد الطفولةفي الهوى كم ليلة","مرت لنا ذهبية الأبرادِ",134,"د",1,0],["عهدته عربيا ما لوى فمه","بلكنة هاجرت من شاطئ التتر",135,"ر",1,0],["عهدته عربيا ملء جبهنه","كبر من البيد لم يركع على قدر",135,"ر",1,0],["عهدته عربيا ما غفا وما صحا","إلا على لغة الإعجاز والسور",135,"ر",1,0],["عَهدتُ لَيلَتَكَ البَيضاءَ نيّرَةً","فَما لَها كَحَّلت عَيني بِإِظلامِ",136,"م",1,0],["عَهِدت