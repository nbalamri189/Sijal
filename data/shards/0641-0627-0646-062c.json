العجم )","https://www.aldiwan.net/poem52315.html","البسيط"],[45,"أبقاك ربك في عز وتأييد","https://www.aldiwan.net/poem63547.html","البسيط"],[49,"ألا يا أيها البشر","https://www.aldiwan.net/poem62097.html","مجزوء الوافر"],[49,"خذ الدنيا بأيسرها عليكا","https://www.aldiwan.net/poem62202.html","الوافر"],[66,"جلت الظلماء بللهب","https://www.aldiwan.net/poem40672.html","المديد"],[66,"قل للملي الذي قد نام عن سهري","https://www.aldiwan.net/poem41556.html","البسيط"],[31,"رأين الغواني الشيب لاح بعارضي","https://www.aldiwan.net/poem42484.html","الطويل"],[74,"ركضوا الجياد إلى الجلاد صباحا","https://www.aldiwan.net/poem12884.html","الكامل"],[74,"وضيف طيف أم من هاجر","https://www.aldiwan.net/poem12934.html","السريع"],[74,"أرأيك أمضى أم حسامك يقطع","https://www.aldiwan.net/poem13174.html","الطويل"],[48,"أيا ملين الحديد","https://www.aldiwan.net/poem62572.html","المجتث"],[48,"إذا أنت زوجت الكريمة كفوها","https://www.aldiwan.net/poem62614.html","الطويل"],[50,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[50,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[7,"ألا من مبلغ عني خزيماً","https://www.aldiwan.net/poem1996.html","الوافر"],[46,"لقد وضعت حواء أمك بكرها","https://www.aldiwan.net/poem22644.html","الطويل"],[46,"إن كانت لك امرأة حصان","https://www.aldiwan.net/poem23057.html","الوافر"],[46,"روح تعدن قضي اليوم وانتظري","https://www.aldiwan.net/poem23472.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85327","المتقارب"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140830",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42552","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[90,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[90,"عتاب مع النفس ..","https://www.poetsgate.com/ViewPoem.aspx?id=179099",""],[45,"أنظر إلى ناظر قد شفه السهد","https://www.poetsgate.com/ViewPoem.aspx?id=31304",""],[64,"إذا دهمَتْك خيول البعاد","https://www.poetsgate.com/ViewPoem.aspx?id=3132",""],[20,"أَيا منذراً كافيت بالود سخطَةً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70012&r=&rc=34",""]],"verses":[["فإن جَهلوا فَضْلي عليهمْ فإنّني","بتَمْزيقِ أعْراضِ اللِّئامِ عَليمُ",0,"م",1,0],["فانْجابَ منْ أنوارِهِنَّ ظَلامُهُ","وأظَلَّهُنّ دُجى ذَوائِبَ سُودِ",1,"د",1,0],["فانْجابَ لَيلُ شَبابٍ كنتُ آلَفُهُ","إذ لاحَ صُبْحُ مَشيبي في حَواشيها",2,"ي",3,0],["فَإِن جاءَ مِنّي بَعضُ ما تَكرَهينَهُ","فَعَن خَطَإٍ واللَهِ لا عَن تَعَمُّدِ",3,"د",1,0],["فَإِنْ جَرَتِ الأَيَّامُ فِي غُلَوَائِهَا","وَجَرَّتْ وَشِيجَ الْقَسْرِ فِي مَأَزِقِ الخطْبِ",4,"ب",1,0],["فَإِنَّ جَميعَ الناسِ إِما مُكَذِّبٌ","يَقولُ بِما يَهوى وَإِمّا مُصَدِّقُ",5,"ق",1,0],["فَأَنجُمُ دَهرِهُمُ سَعدَةٌ","وَشَمسُ زَمانِهِمُ في الحَمَل",6,"ل",1,0],["فَإِن جاءَكِ الواشونَ عَنّي بِكِذبَةٍ","فَرَوها وَلَم يَأتوا لَها بِحَويلِ",7,"ل",1,0],["فَإِن جِئتَ فَأتِ عَلى بَغلَةٍ","فَلَيسَ يُؤاتي الخَفاءَ البَعيرُ",8,"ر",1,0],["فإنّ جميع الأرض أمست كبلدة","بها كل جمع عُدَّ في الحكم مفردا",9,"د",2,0],["فَإِنَّ جِبالَ العِزِّ مِن آلِ خِندِفٍ","لِقَيسٍ فَقَد عَزَّت وَعَزَّ نَصيرُها",10,"ر",3,0],["فإن جذاماً فارقت إذ تباعدت","بريش أبي دودان معروفة النسلِ",11,"ل",1,0],["فَإِن جَلَّ هَذا الأَمرُ فَاللَهُ فَوقَهُ","وَإِن عَظُمَ المَطلوبُ فَاللَهُ أَعظَمُ",12,"م",1,0],["فَإِن جَدَّ أَو لَفَّ الأُمورَ بِعَزمِهِ","فَقُل هُوَ مَوتورُ الحَشى وَهوَ واتِرُ",13,"ر",1,0],["فَإِنَّ جِنانَ الخُلدِ مَنزِلُهُ بِها","وَأَمرُ الَّذي يَقضي الأُمورَ سَريعُ",14,"ع",1,0],["فَإِن جاءَكَ الهَجرُ في ظُلمَةٍ","فَسِر في مَشاعِلِ نورِ الصَفا",15,"ا",1,0],["فأنجِزْ مواعيدَ أكّدتها","فقد مر عصر وقد كر عصر",16,"ر",1,0],["فإن جِئنا سواءً في عِنانٍ","إزاءَ عِذارنا منكم عِذار",17,"ر",1,0],["فإن جاءت فلا أهلاً وسهلاً","وإن ذهبت فلا حفظاً ورجعى",18,"ع",2,0],["فأنجِزْ عِداتك أو أعطني","أماناً من الحَدَثِ النازل",19,"ل",1,0],["فأنجِز الوعد بثوب له","من الجياد المرتضاة الحسان",20,"ن",1,0],["فإن جمعت إلى حظيهما خلقا","فذلك الحظ إن فكرت أجمعه",21,"ع",2,0],["فَأَنجَدَ في تَسالِيَةٍ وَأَتهَم","وَكانَت لِلعِدا حِصناً حَصينا",22,"ا",1,0],["فَأَنجُمُ أَموالِهِ في النُحوسِ","وَأَنجُمُ سُؤَلِهِ في السُعودِ",23,"د",1,0],["فإن جنحتَ إليه فاتَّخِذْ نَفَقاً","في الأرضِ أو سلَّماً في الجوِّ فاعتزلِ",24,"ل",1,0],["فَأَنجِزِ الوَعدَ يا اِبنَ الأَكرَمينَ فَقَد","أَمسى وَأَصبَحَ مِن هَمّي وَمَقصودي",25,"ي",1,0],["فَإِنَّ جَميعَ ما عَظَّم","تَ عِندَ المَوتِ مُحتَقَرُ",26,"ر",1,0],["فَإِنَّ جَميعَ ما خُوِّلتَ مِنها","سَتَنفُضُهُ جَميعاً مِن يَدَيكا",27,"ك",2,0],["فَاِنجَلَت في تاجِها فَجَلَت","ظُلَمَ الأَحزانِ وَالكُرَبِ",28,"ب",1,0],["فَإِن جَنَحتَ إِلَيهِ فَاِتَّخِذ نَفَقاً","لَيَحدُثَنَّ لِمَن وَدَّعتُهُم نَدَمَ",29,"م",1,0],["فَإِن جَمَحَت عَنّي نَواظِرُ أَعيُنٍ","رَمينَ بَأَحداقِ المَها وَالجَآذِرِ",30,"ر",1,0],["فَاِنجابَ لَيلُ الخَطبِ عَن أُفقِ الهُدى","وَتَطَلَّعَ الفَتحُ المُبينُ صَباحا",31,"ح",2,0],["فَاِنجابَتِ الدُهمَةُ عَن شُهبَةٍ","وَآلَتِ المِسكَةُ كافورا",32,"ر",2,0],["فَأَنجَزَ فيهِ مَوعِدَ السَيفِ فاتِكٌ","يَهونُ عَلَيهِ الجانِبُ المُتَمَنِّعُ",33,"ع",1,0],["فَأَنجِزي لِيَ وَعدي","وَأَقصِري مِن وَعيدي",34,"ي",1,0],["فَإِن جَرَتِ الأَقدارُ يَوماً بِفُرقَةٍ","تَبَدَّلَ مِنها كُلَّ عَذراءِ ناهِدِ",35,"د",1,0],["فَأَنجِني مِنهُ فَداكَ الزيرُ","وَالأَسَدُ الأَبلَجُ وَالنِحريرُ",36,"ر",1,0],["فَإِن جَزَوكَ بِشُكرٍ فَالوَفاءُ بِهِ","وَإِن جُحِدتَ فَعادٌ قَبلَهُمُ جَحَدوا",37,"د",3,0],["فَإِنَّ جَوابَها في كُلِّ يَومٍ","أَلَمَّ بِأَنفُسٍ مِنكُم وَوَفرِ",38,"ر",1,0],["فَإِن جَهِلَت ذاكَ المُصابَ فَراحَةٌ","وَإِن أَيقَنَتهُ فَهيَ في نَبَإٍ نُكرِ",39,"ر",1,0],["فَإِن جَمَعتَ إِلى الإِحصانِ عَقلاً","فَبورِكَ مُثمِرُ الغُصنِ الوَريقِ",40,"ق",1,0],["فَإِنَّ جَنَّةَ عَدنٍ لا يُجادُ بِها","إِلّا لِصاحِبِ دينٍ في أَذىً عُدِنا",41,"ن",2,0],["فإن جئت أَسأل ما عندها","تقل كلمات لها تعجم",42,"م",1,0],["فأنجم أمواله في النحوس","وأنجم سؤاله في السعود",43,"د",1,0],["فإنْ جفاها ذاتَ يومٍ سناهْ","لاذتْ بليلِ الموتِ في قبرِها",44,"ه",2,0],["فَأَنْجادُها لِلْكَاسِراتِ مَعَاقِلٌ","وَأَغْوَارُها لِلْعاسِلاتِ مَسَارِحُ",45,"ح",1,0],["فَإِن جَحَدوا كانَ الغَديرُ شَهيدَهُ","وَبَدرٌ وَأُحدٌ شامِخَ الهَضَباتِ",46,"ت",1,0],["فان جهلت فتى قد بذ مشيخةٍ","في الشعر فاستقص عنه \" حلبة الادب \"",47,"ب",1,0],["فانْ جِئتُ بالمُوجعِ المشتكي","فقد جئتُ بالمُرقِص المُطرِب!",48,"ب",1,0],["فإن جحدت الذي قاساه بينهما","فشاهداه عليك الخد والجسد",49,"د",1,0],["فإن جاء الهجر في ظلمة","فسِرْ في مشاعل نور لصفا",50,"ا",1,0],["فَإِنَّ جَزاءً يَرجى مِنكَ كَرامَةٌ","وَلَستُ لِنُصحٍ فيكَ بِالمُتَعَرِّضِ",51,"ض",1,0]]}