ldiwan.net/poem12337.html","البسيط"],[432,"بك الإسلام قد لبس الشبابا","https://www.aldiwan.net/poem12461.html","الوافر"],[437,"بما بجفنيك من غنجٍ ومن كحلِ","https://www.aldiwan.net/poem2610.html","البسيط"],[439,"أهنيكما ما يهنئ الدين منكما","https://www.aldiwan.net/poem34766.html","الطويل"],[439,"وعدا على الله حقا نصر من نصره","https://www.aldiwan.net/poem34779.html","البسيط"],[439,"تسمع لدعوة ناء غريب","https://www.aldiwan.net/poem34789.html","المتقارب"],[439,"تسليت حتى أنسي الهائم الهما","https://www.aldiwan.net/poem34792.html","الطويل"],[443,"نعم ذاك وجد الصب لا وجد دونه","https://www.aldiwan.net/poem55946.html","عموديه"],[458,"نأت والأمانِي بها تقرب","https://www.aldiwan.net/poem56282.html","المتقارب"],[461,"خل التغزل للمشوق المغرم","https://www.aldiwan.net/poem15296.html","الكامل"],[461,"الام يراك المجد في زي شاعر","https://www.aldiwan.net/poem15927.html","الطويل"],[461,"شكوا أشمس أنت قمر","https://www.aldiwan.net/poem15952.html","أحذ الكامل"],[468,"إذا الفتى مرة كساني","https://www.aldiwan.net/poem59641.html","مخلع البسيط"],[468,"وإني لأعطي المستميح بحقه","https://www.aldiwan.net/poem59939.html","الطويل"],[468,"تشتت شمل الصبر واتصل الضد","https://www.aldiwan.net/poem60222.html","الطويل"],[468,"أرحب بالضيف والمجتدي","https://www.aldiwan.net/poem60255.html","المتقارب"],[468,"يا بدر تم محياه تحيته","https://www.aldiwan.net/poem60349.html","البسيط"],[470,"شر الحزاميين ذو السن منهم","https://www.aldiwan.net/poem4628.html","الطويل"],[485,"إني أتتني لسان لا أسر بها","https://www.aldiwan.net/poem1121.html",""],[500,"أجتلى نور وجهه فأذب","https://www.aldiwan.net/poem37636.html","الخفيف"],[500,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[500,"بدر حسن راق العيون شهوده","https://www.aldiwan.net/poem38027.html","الخفيف"],[505,"الغيْب","https://www.aldiwan.net/poem27791.html","الوافر"],[551,"بنقا الرمث من شراف غزال","https://www.aldiwan.net/poem47338.html","الخفيف"],[558,"أدر صرفا خمور الأندرينا","https://www.aldiwan.net/poem33755.html","الوافر"],[558,"حقيقتي حضرة التجلي","https://www.aldiwan.net/poem34241.html","مخلع البسيط"],[559,"أيا سعد قل للقس من داخل الدير","https://www.aldiwan.net/poem69361.html","الطويل"],[562,"قد بناها عمر ركن بني","https://www.aldiwan.net/poem52643.html","الرمل"],[564,"لعمرك ما عقل الفتى وعلومه","https://www.aldiwan.net/poem848.html",""],[575,"أجل مناه قبلة من حبيبه","https://www.aldiwan.net/poem3098.html","الطويل"]],"verses":[["فإن جَهلوا فَضْلي عليهمْ فإنّني","بتَمْزيقِ أعْراضِ اللِّئامِ عَليمُ",0,"م",1,0],["فانْجابَ منْ أنوارِهِنَّ ظَلامُهُ","وأظَلَّهُنّ دُجى ذَوائِبَ سُودِ",1,"د",1,0],["فانْجابَ لَيلُ شَبابٍ كنتُ آلَفُهُ","إذ لاحَ صُبْحُ مَشيبي في حَواشيها",2,"ي",3,0],["فَإِن جاءَ مِنّي بَعضُ ما تَكرَهينَهُ","فَعَن خَطَإٍ واللَهِ لا عَن تَعَمُّدِ",3,"د",1,0],["فَإِنْ جَرَتِ الأَيَّامُ فِي غُلَوَائِهَا","وَجَرَّتْ وَشِيجَ الْقَسْرِ فِي مَأَزِقِ الخطْبِ",4,"ب",1,0],["فَإِنَّ جَميعَ الناسِ إِما مُكَذِّبٌ","يَقولُ بِما يَهوى وَإِمّا مُصَدِّقُ",5,"ق",1,0],["فَأَنجُمُ دَهرِهُمُ سَعدَةٌ","وَشَمسُ زَمانِهِمُ في الحَمَل",6,"ل",1,0],["فَإِن جاءَكِ الواشونَ عَنّي بِكِذبَةٍ","فَرَوها وَلَم يَأتوا لَها بِحَويلِ",7,"ل",1,0],["فَإِن جِئتَ فَأتِ عَلى بَغلَةٍ","فَلَيسَ يُؤاتي الخَفاءَ البَعيرُ",8,"ر",1,0],["فإنّ جميع الأرض أمست كبلدة","بها كل جمع عُدَّ في الحكم مفردا",9,"د",2,0],["فَإِنَّ جِبالَ العِزِّ مِن آلِ خِندِفٍ","لِقَيسٍ فَقَد عَزَّت وَعَزَّ نَصيرُها",10,"ر",3,0],["فإن جذاماً فارقت إذ تباعدت","بريش أبي دودان معروفة النسلِ",11,"ل",1,0],["فَإِن جَلَّ هَذا الأَمرُ فَاللَهُ فَوقَهُ","وَإِن عَظُمَ المَطلوبُ فَاللَهُ أَعظَمُ",12,"م",1,0],["فَإِن جَدَّ أَو لَفَّ الأُمورَ بِعَزمِهِ","فَقُل هُوَ مَوتورُ الحَشى وَهوَ واتِرُ",13,"ر",1,0],["فَإِنَّ جِنانَ الخُلدِ مَنزِلُهُ بِها","وَأَمرُ الَّذي يَقضي الأُمورَ سَريعُ",14,"ع",1,0],["فَإِن جاءَكَ الهَجرُ في ظُلمَةٍ","فَسِر في مَشاعِلِ نورِ الصَفا",15,"ا",1,0],["فأنجِزْ مواعيدَ أكّدتها","فقد مر عصر وقد كر عصر",16,"ر",1,0],["فإن جِئنا سواءً في عِنانٍ","إزاءَ عِذارنا منكم عِذار",17,"ر",1,0],["فإن جاءت فلا أهلاً وسهلاً","وإن ذهبت فلا حفظاً ورجعى",18,"ع",2,0],["فأنجِزْ عِداتك أو أعطني","أماناً من الحَدَثِ النازل",19,"ل",1,0],["فأنجِز الوعد بثوب له","من الجياد المرتضاة الحسان",20,"ن",1,0],["فإن جمعت إلى حظيهما خلقا","فذلك الحظ إن فكرت أجمعه",21,"ع",2,0],["فَأَنجَدَ في تَسالِيَةٍ وَأَتهَم","وَكانَت لِلعِدا حِصناً حَصينا",22,"ا",1,0],["فَأَنجُمُ أَموالِهِ في النُحوسِ","وَأَنجُمُ سُؤَلِهِ في السُعودِ",23,"د",1,0],["فإن جنحتَ إليه فاتَّخِذْ نَفَقاً","في الأرضِ أو سلَّماً في الجوِّ فاعتزلِ",24,"ل",1,0],["فَأَنجِزِ الوَعدَ يا اِبنَ الأَكرَمينَ فَقَد","أَمسى وَأَصبَحَ مِن هَمّي وَمَقصودي",25,"ي",1,0],["فَإِنَّ جَميعَ ما عَظَّم","تَ عِندَ المَوتِ مُحتَقَرُ",26,"ر",1,0],["فَإِنَّ جَميعَ ما خُوِّلتَ مِنها","سَتَنفُضُهُ جَميعاً مِن يَدَيكا",27,"ك",2,0],["فَاِنجَلَت في تاجِها فَجَلَت","ظُلَمَ الأَحزانِ وَالكُرَبِ",28,"ب",1,0],["فَإِن جَنَحتَ إِلَيهِ فَاِتَّخِذ نَفَقاً","لَيَحدُثَنَّ لِمَن وَدَّعتُهُم نَدَمَ",29,"م",1,0],["فَإِن جَمَحَت عَنّي نَواظِرُ أَعيُنٍ","رَمينَ بَأَحداقِ المَها وَالجَآذِرِ",30,"ر",1,0],["فَاِنجابَ لَيلُ الخَطبِ عَن أُفقِ الهُدى","وَتَطَلَّعَ الفَتحُ المُبينُ صَباحا",31,"ح",2,0],["فَاِنجابَتِ الدُهمَةُ عَن شُهبَةٍ","وَآلَتِ المِسكَةُ كافورا",32,"ر",2,0],["فَأَنجَزَ فيهِ مَوعِدَ السَيفِ فاتِكٌ","يَهونُ عَلَيهِ الجانِبُ المُتَمَنِّعُ",33,"ع",1,0],["فَأَنجِزي لِيَ وَعدي","وَأَقصِري مِن وَعيدي",34,"ي",1,0],["فَإِن جَرَتِ الأَقدارُ يَوماً بِفُرقَةٍ","تَبَدَّلَ مِنها كُلَّ عَذراءِ ناهِدِ",35,"د",1,0],["فَأَنجِني مِنهُ فَداكَ الزيرُ","وَالأَسَدُ الأَبلَجُ وَالنِحريرُ",36,"ر",1,0],["فَإِن جَزَوكَ بِشُكرٍ فَالوَفاءُ بِهِ","وَإِن جُحِدتَ فَعادٌ قَبلَهُمُ جَحَدوا",37,"د",3,0],["فَإِنَّ جَوابَها في كُلِّ يَومٍ","أَلَمَّ بِأَنفُسٍ مِنكُم وَوَفرِ",38,"ر",1,0],["فَإِن جَهِلَت ذاكَ المُصابَ فَراحَةٌ","وَإِن أَيقَنَتهُ فَهيَ في نَبَإٍ نُكرِ",39,"ر",1,0],["فَإِن جَمَعتَ إِلى الإِحصانِ عَقلاً","فَبورِكَ مُثمِرُ الغُصنِ الوَريقِ",40,"ق",1,0],["فَإِنَّ جَنَّةَ عَدنٍ لا يُجادُ بِها","إِلّا لِصاحِبِ دينٍ في أَذىً عُدِنا",41,"ن",2,0],["فإن جئت أَسأل ما عندها","تقل كلمات لها تعجم",42,"م",1,0],["فأنجم أمواله في النحوس","وأنجم سؤاله في السعود",43,"د",1,0],["فإنْ جفاها ذاتَ يومٍ سناهْ","لاذتْ بليلِ الموتِ في قبرِها",44,"ه",2,0],["فَأَنْجادُها لِلْكَاسِراتِ مَعَاقِلٌ","وَأَغْوَارُها لِلْعاسِلاتِ مَسَارِحُ",45,"ح",1,0],["فَإِن جَحَدوا كانَ الغَديرُ شَهيدَهُ","وَبَدرٌ وَأُحدٌ شامِخَ الهَضَباتِ",46,"ت",1,0],["فان جهلت فتى قد بذ مشيخةٍ","في الشعر فاستقص عنه \" حلبة الادب \"",47,"ب",1,0],["فانْ جِئتُ بالمُوجعِ المشتكي","فقد جئتُ بالمُرقِص المُطرِب!",48,"ب",1,0],["فإن جحدت الذي قاساه بينهما","فشاهداه عليك الخد والجسد",49,"د",1,0],["فإن جاء الهجر في ظلمة","فسِرْ في مشاعل نور لصفا",50,"ا",1,0],["فَإِنَّ جَزاءً يَرجى مِنكَ كَرامَةٌ","وَلَستُ لِنُصحٍ فيكَ بِالمُتَعَرِّضِ",51,"ض",1,0],["فَإِن جِئتَهُ في الحَشر تَرجو نَوالَهُ","فَيُعطيك ما تَختار مِن حَسَناتِهِ",52,"ه",1,0],["فانجلى شأن عزها بيد الجو","د ودارت على الكرام الكبار",53,"ر",1,0],["فإن جشأت في صدره غصص الجوى","وجلله وجد الحسان النوافر",54,"ر",1,0],["فَإِن جَارَاكَ مِن حَسَدِ حَسُودٌ","وَسامَكَ بِالمَذَلَّةِ والصَّغَارِ",55,"ر",1,0],["فأنجمُ الليل كالأسنةِ والصُّ","بحُ حسامٌ له الورى خِلَلُ",56,"ل",1,0],["فإن جرى فالجميل منكم","وليس بالبدع صدق بال",57,"ل",1,0],["فانجح لما أن دنامنك سعيه","وأينع مراعه وأورق عوده",58,"د",2,0],["فإن جاءني قصدا إليّ تعمّدا","وكنت على رفع سقطت إلى خفض",59,"ض",1,0],["فإن جمعت لي الأخلاط كاملة","كما وصفت بترتيب وتعديد",60,"د",1,0],["فَأَنجُمُ بَهجَتِنا في الطُلوعِ","وَأَنجُمُ وَحشَتِنا في الغُروبِ",61,"ب",1,0],["فانجفلت أنجمه فاشتكى","للبعضِ منها البعضُ وَشْكَ الفراق",62,"ق",1,0],["فان جرحت منهم سيوف عداتهم","فبالشُّعل الحمرِ الجراحُ تفورُ",63,"ر",1,0],["فإنْ جدْتِ شفيتُ وإن","بخلتِ أمضَّني الياسُ",64,"س",1,0],["فان جودك يمحوها وان كثرت","لو أنّ عنها يضيق السهل والجبل",65,"ل",1,0],["فإنْ جَال في الأكْواسِ دُر حُبَابها","عجبتُ لهَ ِمن جوْهر حَل في عرضِ",66,"ض",1,0],["فَإِنَّ جَميلَ الذِكرى يَبقى مُخَلَّداً","لِكاسِبِهِ وَالمالُ يَفنى وَيَنفَدُ",67,"د",1,0],["فَأَنْجِزْ مُنَى مَنْ أَمَّ مَثْوَاكَ قَائِلاً","بِحَارُ النَّدَى تُعْزَى إِلَيْكُمْ أَبَا يَعْزَى",68,"ز",2,0],["فإن جهلتم علينا","وكنتمُ مفترينا",69,"ن",2,0],["فانجلى ذلك الغبار ولاح ال","فجر في الأفق واستنار النهار",70,"ر",1,0],["فان جدتِ بالوصلِ ابعَثي الطَّيفَ مُخبراً","وإلا فألقي نظرةً المترحّل",71,"ل",1,0],["فَإنْ جَوّدَ الفكرُ لم يُغربِ","وإنْ قصّر الشعر لم يُذنب",72,"ب",1,0],["فإن جَزَعٌ يَبدو فذاكَ تكرُّهٌ","لتجريعِ صَابٍ من مُصابٍ مُواعك",73,"ك",1,0],["فَاِنجِزهُ فَكَم حِصنٍ مَنيعٍ","تَزَلتَ بِهِ فَفَرَّجتَ الرِتاجا",74,"ج",2,0],["فإنْ جادلتَ في دعواك فاجعلْ","بعزمِكَ لا بمنطقِك الدليلا",75,"ل",2,0],["فانج فيها لا تكون كذا","واعتصم باللَه واستعن",76,"ن",1,0],["فإن جميع الكون أوجب فعله","مشيئة رب الخلق باري الخليقة",77,"ه",1,0],["فإن جمع الليل ندمانه","رآه إماماً على الشاربين",78,"ن",1,0],["فإنْ جَزَعْنَا فإنّ الشّرّ أَجْزَعَنَا","وَإنْ صَبَرْنَا فَإنَّا مَعْشَرٌ صُبُرُ",79,"ر",1,0],["فَاِنجَلى غَيهَب الهُموم بِمَجلى","نور أَفراح يَومِنا المَشهودِ",80,"د",1,0],["فإنْ جُبِلَتْ على كَرَمٍ يَداهُ","فمِن أخلاقِ آباءٍ أَكارم",81,"م",1,0],["فإنْ جرَتْ عَبَراتي لم يكنْ عجَباً","فالخَدُّ كالقاع يَجْلو الماءَ والآلا",82,"ل",2,0],["فأَنجيتُ أسرى مَذحِجٍ من هَوَازِنٍ","ولم يُنجِهم إِلّا السَّكينةُ والصَّبرُ",83,"ر",1,0],["فَأَنجَزَ هَذا الدَهرُ ما كُنتُ أَرتَجي","وَأَنجَزَ هَذا الدَهرُ ما كُنتُ أَحذَرُ",84,"ر",1,0],["فانجاب ليل الكفر منه مذ بدا","وزَهَت وِهادُ الحق والكثبان",85,"ن",1,0],["فإن جئتها تغنيك عن كل حاجةٍ","فأنت إليها حيثما سرت أحوج",86,"ج",1,0],["فإنجيله ينبيك عن فعله البهي","وعن علمه المعلول عن فضل علة",87,"ه",1,0],["فإن جادَ يوماً فَمَنْ حاتمٌ","وإنْ جالَ يوماً فَمَنْ عنترُ",88,"ر",1,0],["فإن جرى من أديمي بعدها عرق","فإنها غسلت للذنب أدرانا",89,"ن",2,0],["فإن جزعنا فمثل الخطب يجزعنا","وإن صبرنا فإنا معشر صُبر",90,"ر",1,0],["فَإِن جادَني من جود نعماكَ رائِحٌ","فَقَد صادَني من صوب يُمناكَ باكِرُ",91,"ر",1,0],["فإن جَرَيْنَ وإن أرَّخْتَهُنَّ فقلْ","تجري وأصبحَ باسم الله مجراها",92,"ا",3,0],["فإن جحد الحساد فضلك والنهى","إذَنْ مزجت بالشهد سمّ الأراقم",93,"م",1,0],["فإن جاءني بالقرب منها مبشرٌ","وهبت له سروراً وما أغنى",94,"ن",2,0],["فإن جميل العز والفوز والغنى","برؤيته لا زال شهما مكرما",95,"م",2,0],["فإن جادت يداه ي