gate.com/ViewPoem.aspx?id=206116",""],[5282,"أنشودة الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=214736",""],[5324,"لقاء المساء.","https://www.poetsgate.com/ViewPoem.aspx?id=211494",""],[5376,"أذودُ عن الحوض ِالمنيعِ برفعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=188375",""],[5431,"وجهٌ له الأنوارحتما تُشرقُ","https://www.poetsgate.com/ViewPoem.aspx?id=187197",""],[5431,"للقدس...للحبيبة...","https://www.poetsgate.com/ViewPoem.aspx?id=194944",""],[5431,"سقطت بقلعته الحتوفُ","https://www.poetsgate.com/ViewPoem.aspx?id=195002",""],[5431,"الناي يشدو مسمعا عذره","https://www.poetsgate.com/ViewPoem.aspx?id=196785",""],[5431,"هي لم تعد لليوم تهواه!","https://www.poetsgate.com/ViewPoem.aspx?id=201336",""],[5561,"كيف السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=196513",""],[5609,"جازان","https://www.poetsgate.com/ViewPoem.aspx?id=214101",""],[5650,"امْلأْ فُؤادَكَ بِالْحَبيب","https://www.poetsgate.com/ViewPoem.aspx?id=131222",""],[5790,"قد رأيناك والغزالة تسنح","https://www.poetsgate.com/ViewPoem.aspx?id=111949",""],[5829,"تلك الفتاة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=190585",""],[5829,"ذكاء","https://www.poetsgate.com/ViewPoem.aspx?id=192054",""],[5839,"جرح","https://www.poetsgate.com/ViewPoem.aspx?id=62092",""],[5853,"مولد الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=175678",""],[5939,"مكرُ الأنوثة","https://www.poetsgate.com/ViewPoem.aspx?id=185494",""],[5956,"إليك تفتحتْ ورداتُ حبٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=182073",""],[6102,"بين كلابها وحجاجها ..","https://www.poetsgate.com/ViewPoem.aspx?id=182808",""],[6147,"أم الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=151698",""],[5190,"أُحمِّلك السلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78312&r=&rc=25",""],[5190,"لا زلتُ أشكو لوعةَ الغُرباءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78295&r=&rc=8",""]],"verses":[["وَتَرنو بِنَجلاوَينِ سِحرُهما جَثا","على نَظَرٍ يَسبي القُلوبَ كَليلِ",0,"ل",1,0],["وَتَرنو بِعَينَي نَعجَةٍ أُمِّ فَرقَدٍ","تَظَلُّ بِوادي رَوضَةٍ وَخَمائِلِ",1,"ل",1,0],["وَتَرناهُ فَلَم يَرضَ","فَأَعقَبناهُ بِالوَترِ",2,"ر",1,0],["وترنَّموا ما شئتمُ بِشَتَائمي","وتجاهَروا ما شئتمُ بعِدائي",3,"ي",1,0],["وترنمت فوق الغدير جميلة","عصفورة اوطانها الغدران",4,"ن",1,0],["وترنمات الشعب حول ركابه","وطلاسم الكهنوت والأسرار",5,"ر",1,0],["وَتَرَنَّمتَ في الرِكابِ فَقُلنا","راهِبٌ طافَ في الأَناجيلِ يَقرا",6,"ر",2,0],["وترنحتُ بين جنبيك تلهو","بي فتطغَى آناً وتهدأ آنا",7,"ن",2,0],["وَتَرنو بِعَينَيها إِلَيَّ كَما رَنا","إِلى رَبرَبٍ وَسطَ الخَميلَةِ جُؤذَرُ",8,"ر",1,0],["وَتَرَنَّمَت حَتّى سَمِعتُ حَمامَةً","حَتّى إِذا حَسَرَت زَجَرتُ غُرابا",9,"ب",2,0],["وَتَرَنَّمَت فيه الحما","ئم وَالفواخت وَالقماري",10,"ر",2,0],["وترنم الوادي بسلسلِ مائه","وتَلَتْ حمائمُه نشيد الصافرِ",11,"ر",1,0],["وَتَرنَّمَ النَّاقُوسُ عِنْدَ صَلاتِهِمْ","ففَتَحْتُ من عَيْني لرَجْعِ هَدِيرِه",12,"ر",2,0],["وتَرنَّمتْ فيها القِيا","نُ لنا ورجَّعتِ البواغِمْ",13,"م",1,0],["وَتَرَنَّمَتْ فَوْقَ الأَرَاكِ حَمَامَةٌ","تَصِفُ الْهَوَى بِلِسعانِ صَبٍّ مُولَعِ",14,"ع",1,0],["وَتَرَنَّمَتْ في وَكْرِها سَحَرِيَّةٌ","تُغْنِي الْمَقَامَةَ عَنْ صَفِيرِ النَّاءِ",15,"ا",2,0],["وَتَرَنَّمْ تُجِبْ صَدَاكَ الْقَمارِي","وَتَمِلْ نَحْوَكَ الْغُصُونُ قُدُودا",16,"د",2,0],["وترنو من أسى همسي","ومن أحزان أوقاتي",17,"ت",2,0],["وترنو º وترنو وعيناك شوق","هتوف يناجيه شوق هتوف",18,"ف",1,0],["وترنَّحَ الأحرارُ يؤذِنُ بَعضُهُمْ","بعضاً بفقدهُمِ أبا الأحرار",19,"ر",1,0],["وَتَرَنَّمَتْ فَوْقَ الأَرَاكِ حَمَامَة ٌ","تَصِفُ الْهَوَى بِلِسَانِ صَبٍّ مُولَعِ",20,"ع",1,0],["وتَرنُو إلَينَا ثُمَّ تَرنُو إلَيهُمُ","وتَرنو إِلَى الغَبرَا وتَرنُو إلَى النَّسرِ",21,"ر",1,0],["وَتَرَنُّمُ الأَوتارِ في يَدِ قَينَةٍ","غَنِجٍ يَدينُ لَها الغَريضُ وَمَعبَدُ",22,"د",1,0],["وَتَرَنَّمي ما شِئتِ في حَمأ البَلى","حَتّى يَجِفَّ بِك الرضاع وَتَهرَمي",23,"م",2,0],["وَتَرَنَّم بِمَن أَفاضَ على حَل","قكَ ما لم يُفِض على الوَرقاءِ",24,"ا",2,0],["وَتَرَنُّم الأَطيارِ نَحسِبُ أَنَّها","أَصواتُ شادٍ مُطرِبُ الأَلحانِ",25,"ن",1,0],["وَتَرَنُّمُ الدولابِ في","غَدَواتِهِ وَأَصائِلِه",26,"ل",2,0],["وترنّمي بالحب وار","وي للوَرى من شعريه",27,"ي",2,0],["وتَرنُّمُ البُوقاتِ إن رَكبَ السْ","سُلطانُ تَحسَبُها بهِ نَذرا",28,"ر",2,0],["وترنم الورقاء في أفنانها","ما زاد هذا الصب غير خبال",29,"ل",1,0],["وترنّمُ الأطيار من ألحانها","فيه دواء للغرام وداء",30,"ا",2,0],["وترنمت سبأ بلحنٍ خالدٍ","إكسيره الذكر الجميل الممتع",31,"ع",1,0],["وترنمت أطيارها مُهتاجةً","فكأنما سمعت بحمْد الحامد",32,"د",1,0],["وترنْحت فيها الغصونُ صبابةً","وافترّ عن شَنَبِ القِطار إِقاحُها",33,"ح",3,0],["وترنَّحَتْ أعْطافُهُمْ فكأنما","في كُلِّ قافيَةٍ سُلافَةُ بابِلِ",34,"ل",1,0],["وترنّمَتْ فشدَتْ حمائِمُ حَليِها","وكذاكَ دأبُ حَمائِمِ الأغصانِ",35,"ن",1,0],["وترنَّمتْ بيروتُ حينَ ثَوَى بها","فأجابها لُبنانُ من أطوادِهِ",36,"د",2,0],["وتَرَنَّمي يا وُرْقُ فيهِ ويا صَبَا","مُرِّي عَليْهِ بِأَطْيَبِ النَّفَحَاتِ",37,"ت",1,0],["وَتَرناهُمُ في قتلِهِم في مُحَرَّمٍ","حُسَينفَجِئناهُم لأُولَى مُحَرَّمِ",38,"م",1,0],["وترنمت لحنين قد حلتهما","بِغناءِ مُسمِعةٍ وأنّةِ شاكِ",39,"ك",1,0],["وَترنمت في مَدحه","بِصحاح درّ الجَوهر",40,"ر",1,0],["وَترنمت مِنها بِمَدحك أَلسنٌ","شُكراً لَما أَوليت مِن نَعماء",41,"ا",2,0],["وَترنمت فَوق الغُصون عَنادلٌ","في مَدحه بِبَديع نَظمٍ فائق",42,"ق",1,0],["وَترنمت فَوق الغُصون بَلابل","بِبَديع مَدح في علاه نَظيم",43,"م",1,0],["وَتَرنو بِطرْفٍ يَأسِر الأُسْدَ وَالمَها","وَما هوَ إِلّا ذو الفقارِ المجرّبُ",44,"ب",1,0],["وترنَّمَ الأطيار في وُكْنَاتِها","صبحاً ودام صباحُنا ومسانا",45,"ن",2,0],["وترٌ ناعِسُ الجُفون ِلِزريابَ","استشاطتْ بسحرهِ الأعْوادُ",46,"د",1,0],["وَتَرنو بِأَبصارٍ إِذا ما أَدَرنَها","جَلَونَ عَقيقاً لِلعُيونِ مُرَصَّعا",47,"ع",2,0],["وترنّحت فيه قنا","طرُ من عهود خالية",48,"ي",2,0],["وترنمت فيها الطيور شجيّة","وشدا لها الموج الرشيق فأطربا",49,"ب",2,0],["وترنمت فوق الغصون بلابلٌ","وشدت شحاريرٌ وما هبّت نسمْ",50,"م",1,0],["وترنمت طرباً بمجد بشيرها","تاج المفاخر والعلا والبنا",51,"ن",2,0],["وترنم الشحرور من طربٍ به","أشجى ونغمة صدحهِ مشجونَهْ",52,"ن",2,0],["وتْرنّحَتْ تختال في روض بستان","نفحه يعبّر عن كنوز الخوافي",53,"ف",2,0],["وترنَّحت منّا ا