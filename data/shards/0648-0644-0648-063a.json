{"poems":[[53,"قليل من الخلان من لا تذمه","https://www.aldiwan.net/poem29759.html","الطويل"],[53,"ألوي حيازيمي عليك تحرقا","https://www.aldiwan.net/poem29950.html","الطويل"],[53,"تفوز بنا المنون وتستبد","https://www.aldiwan.net/poem30604.html","الوافر"],[63,"خليلي هذا ربع ليلى بذي الغضى","https://www.aldiwan.net/poem45679.html","الطويل"],[77,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[5,"ألم تر أنني رجل صبور","https://www.aldiwan.net/poem299.html",""],[27,"لقد هتف اليوم الحمام ليطربا","https://www.aldiwan.net/poem5659.html","الطويل"],[27,"لقد سرني أن لا تعد مجاشع","https://www.aldiwan.net/poem5768.html","الطويل"],[27,"أتنسى يوم حومل والدخول","https://www.aldiwan.net/poem5965.html","الوافر"],[72,"يا تاركين للمحب أدمعا","https://www.aldiwan.net/poem19361.html","الرجز"],[51,"أبا الصقر لست أرى مهديا","https://www.aldiwan.net/poem8301.html","المتقارب"],[43,"بغيرك راعيا عبث الذئاب","https://www.aldiwan.net/poem9459.html","الوافر"],[28,"تبكي على المنتوف بكر ابن وائل","https://www.aldiwan.net/poem5515.html","الطويل"],[28,"وأطلس عسال وما كان صاحبا","https://www.aldiwan.net/poem5628.html","الطويل"],[66,"لا راجع الطرف باللقا وسنه","https://www.aldiwan.net/poem40971.html","المنسرح"],[80,"وباكية بعيون الجراح","https://www.aldiwan.net/poem31335.html","المتقارب"],[81,"يقولون لو قبلته لاشتفى الجوى","https://www.aldiwan.net/poem61511.html","الطويل"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[75,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[46,"يطهر الجسد المغرور صاحبه","https://www.aldiwan.net/poem22812.html","البسيط"],[46,"بطن التراب كفاني شر ظاهره","https://www.aldiwan.net/poem23099.html","البسيط"],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6809","الوافر"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10206","الوافر"],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[54,"أَيا للناسِ مِن خَبَرٍ طَريفٍ","https://www.poetsgate.com/ViewPoem.aspx?id=14500",""],[27,"لَقَدْ هَتَفَ اليَوْمَ الحَمامُ ليُطرِبَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16340&r=&rc=4",""],[141,"لي بامتداحك عن ذكر الهوى شغل","https://www.aldiwan.net/poem11803.html","البسيط"],[158,"كذا فليعاني الملك من أعطي الملكا","https://www.aldiwan.net/poem58826.html","الطويل"],[158,"بكيت لأخفى بالدموع السوافح","https://www.aldiwan.net/poem58950.html","الطويل"],[167,"أبى الدهر أن يلقاك إلا محارباً","https://www.aldiwan.net/poem1599.html",""],[210,"وادعج وضاح الجبين يزورني","https://www.aldiwan.net/poem37867.html","الطويل"],[230,"ألا خاد أعللها بنجد","https://www.aldiwan.net/poem14778.html","الوافر"],[237,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[296,"إذا لم تطق (لمياء) أن تنجز الوعدا","https://www.aldiwan.net/poem36321.html","عموديه"],[303,"توسط بين الشمس والبدر سالم","https://www.aldiwan.net/poem56493.html","الطويل"],[324,"أرى المائة ألفا صادقا قد وعدتها","https://www.aldiwan.net/poem44273.html","الطويل"],[351,"صلوا حبل ودي يا كرام وزوروا","https://www.aldiwan.net/poem40349.html","الطويل"],[362,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[362,"أصح عيون البابلية ما اعتلا","https://www.aldiwan.net/poem60796.html","الطويل"],[362,"أشاكر أنا للأيام أم شاك","https://www.aldiwan.net/poem60816.html","البسيط"],[364,"وما كنت أرضى من علاك بذا الجفا","https://www.aldiwan.net/poem17855.html","الطويل"],[369,"منيتها تفرق من عاذلي","https://www.aldiwan.net/poem57221.html","الكامل"],[436,"تسمع لدعوة ناء غريب","https://www.aldiwan.net/poem34789.html","المتقارب"],[438,"عتاب أحال الشهد كالصاب في الحلق","https://www.aldiwan.net/poem14428.html","الطويل"],[456,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[522,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[574,"يعيرني أمي رجال لا أرى","https://www.aldiwan.net/poem1777.html","الطويل"]],"verses":[["وَلو غَيرَ قَلبي ضَمَّ ذا العَزمَ شَقَّهُ","وَلَكِنَّهُ لا يَقتُلُ الصِلَّ سُمُّهُ",0,"م",2,0],["وَلَو غَيرَ هَذا المَوتِ نالَكَ ظُفرُهُ","وَوَلّاكَ غَرباً لِلمَنايا مُذَلَّقا",1,"ق",2,0],["وَلَو غَيرُ الرَدى جاثاكَ أَقعى","بِهِ مِن بَأسِكَ الخَصمُ الأَلَدُّ",2,"د",1,0],["وَلَو غابَ عَنّي واحِدٌ مِنكُما وَهَتْ","قُوى الصَّبرِ لا أَوهى الزَّمانُ قُواكُما",3,"م",2,0],["وَلَوْ غَيْرُ ذَاتِ اللَّهِ رَامَتْهُ نَضْنَضَتْ","قَناً كَالأَفَاعِي الرَّقْطِ أَوْ دُونَهَا الرَّقْطُ",4,"ط",1,0],["وَلَو غَيري يَجيءُ بِهِ أَسير","لَنالَ بِهِ رَغيبةَ ذُخرِ دَهرِ",5,"ر",1,0],["وَلَو غَضِبَت يا تَيمُ أَو زُيِّلَ الحَصا","عَلَيكَ تَميمٌ لَم تَجِد لَكَ مَغضَبا",6,"ب",2,0],["وَلَو غَضِبَت في شَأنِ حَدراءَ نَهشَلٌ","سَمَوها بِدُهمِ أَو غَزَوها بِأَنسُرِ",7,"ر",1,0],["وَلو غُسِلَت بِساقِيَتي دُجَيلٍ","لَقالَت ما اِكتَفَيتُ مِنَ الغَسولِ",8,"ل",1,0],["ولو غدت تملي على الأغصان ما","في كبدي لأحرقت أوراقها",9,"ق",3,0],["ولو غيرُك السائِمي ما أرى","لشعَّبتُ للظن فيه شِعابا",10,"ب",2,0],["وَلَو غَيرُ الأَميرِ غَزا كِلاباً","ثَناهُ عَن شُموسِهِمِ ضَبابُ",11,"ب",1,0],["وَلَو غَيرُ أَيدي الأَزدِ نالَت ذَراهُما","وَلَكِن بِأَيدي الأَزدِ حُزَّت طُلاهُما",12,"م",2,0],["وَلَو غَيرَنا نَبَّهتَ تَلتَمِسُ القِرى","أَتاكَ بِسَهمٍ أَو شَباةَ سِنانِ",13,"ن",1,0],["وَلَو غَدا وَهوَ عابِدٌ وَثَناً","لَما غَدا غَيرُ شَخصِكُم وَثَنَه",14,"ن",2,0],["ولو غُمِستْ فيه زُرْقُ العيون","لَعُوّضَ من زَرَقٍ بالكحَل",15,"ل",1,0],["وَلَو غَفَلَ الواشي لَقَبَّلتُ نَعلَهُ","أُنَزِّهُهُ أَن أَذكُرَ الجيدَ وَالثَغرا",16,"ر",2,0],["ولو غدا بخُلوبِ اللّيثِ مُدَّرِعاً","أو باتَ بينَ نُيوبِ الحيّةِ العُصُل",17,"ل",1,0],["ولو غيرُ رَيبِ المَنونِ اعتدى","عليّ وجرّبني ما اعتدى",18,"ا",1,0],["وَلَو غَدا الكَواكِبُ المِرّيخُ في يَدِهِ","كَالسَهمِ وَاِتَّخَذَ البِرجيسَ بِرجاسا",19,"س",2,0],["وَلَو غَدَوتُ سُلَيكاً جاءَني قَدَرٌ","أَخا السُرى أَو صَغيرَ السَلكِ وَالسُلُكِ",20,"ك",1,0],["وَلَو غَيري يَجيءُ بِهِ أَسيراً","لَنالَ بِهِ رَغيبةَ ذُخرِ دَهرِ",21,"ر",1,0],["وَلَو غَلِطوا بِواحِدِةٍ لَقُلنا","يَكونُ الوَهمُ بَينَ العاقِلَينِ",22,"ن",1,0],["ولو غيرُ \" رُوَميلٍ \" لقُلْنا كغيرِها","سُقاةُ الرَّدى عاطَتْ بأكؤسُها شَرْبا",23,"ب",2,0],["ولوْ غلظوا بواحدة ٍ لقلنا",": يكونُ الوهمُ بينَ العاقلينِ",24,"ن",1,0],["ولو غضبتْ يا تيمُ أوزيلَ الحصا","عَلَيكَ تَميمٌ لم تجدد لكَ مغصْبا",25,"ب",2,0],["وَلَو غَزَوا مَكَّةً إِذ جاهِلِيَّتُها","قُرَيشُ لَم تُعبَدِ العُزّى وَلا هُبَلُ",26,"ل",1,0],["ولو غيره وكلت بي بان عجزه","وما كنت أوليه ملاما به نسكا",27,"ك",2,0],["ولو غير ألحاظٍ رمتني لدستها","ملا الأرض خيراً بالمساعي النوجحِ",28,"ح",1,0],["وَلَو غَيرُ قَومي رامَ ظُلمي لَقَلَّصت","خُصاهُ وَأَضحى قاصِرَ الخَطوِ لاغِبا",29,"ب",2,0],["ولو غُرُبان الليلِ يَلْحَظْنَ سيفَه","لشابتْ خوافيها وهاماتُها شمط",30,"ط",1,0],["وَلو غَنّى بِرامَةِ جادِياها","جَرَت جَريَ العَواصِفِ حَيثُ تَحدي",31,"ي",1,0],["ولو غيرهم زودت من بعض زادهم","وجدك ما كانوا ليطووا ويسغبوا",32,"ب",3,0],["وَلو غير ديني كلفتنيَ بذله","رأتنيَ لا كَزَّ اليمينِ وَلا جَعْدا",33,"د",2,0],["وَلَو غيرهُ رامَ التوسّط بيننا","خَشينا خسوفاً إِذ حَكى ثقلهُ الأَرضا",34,"ض",2,0],["وَلَو غَيرُ هارونَ يَجودُ بِوَعدِها","لِما عُجتُ مِن مَوعودِهِ بِنَقيرِ",35,"ر",1,0],["وَلو غايرتها الناس طرّاً لَأَوشَكَت","بِها الأَرض لَما أَن تغير تَغورُ",36,"ر",1,0],["ولو غيْرُ المَنونِ غزا حِماها","لَقَوهُ بالفوارسِ والرِّجال",37,"ل",1,0],["ولو غيرُ مَنْصورٍ غدا وهْو ناصِري","لأضحَى دَمي في حَرْبِ دهري وقد طُلاّ",38,"ل",2,0],["ولو غدَوْتِ بهذا منه قانعةً","لما حدا نحوَه الحادي مَطاياك",39,"ك",1,0],["وَلَو غَيرُكُم يَرمي الفُؤادَ بِسَهمِهِ","لَما كانَ مِمَّن قَد أَصابَ يُصيبُهُ",40,"ب",2,0],["وَلَو غَدا يَحملُ فيها النَّدى","كانَ الحُسينُ ابنُ أَبي كامِلِ",41,"ل",1,0],["ولو غابَ عِلْمُكَ عن بَحرِ ظِمءٍ","وَمَا غِيضَ من شربِه فِي الشُّروبِ",42,"ب",1,0],["ولو غابت الشهب الدراري لقصّرت","عن الغرب وارتدت صدوداً إِلى الشرق",43,"ق",1,0],["ولو غضبتُ غضبةً","أعوز سدُّ موضعي",44,"ي",1,0],["وَلَو غَدا البَحرُ حبراً وَالفَضا وَرَقاً","في حَصرِ أَوصافِهِ ضاقا بِبَعضِهِمِ",45,"م",1,0],["وَلو غَيرُ أَخوالي أَرادوا نَقيصَتي","جَعَلتُ لَهُم فَوقَ العَرانينِ ميسَما",46,"م",2,0]]}