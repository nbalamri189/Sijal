{"poems":[[139,"من أين للبدر أن يحكى محياه","https://www.aldiwan.net/poem49112.html","البسيط"],[154,"عجبا لمن ترك الحقيقة جانبا","https://www.aldiwan.net/poem68457.html","الكامل"],[443,"أين الخليط وأية سلكوا","https://www.aldiwan.net/poem2600.html","الكامل"],[563,"قد قال من قال من جهل وإغواء","https://www.aldiwan.net/poem35078.html","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53992","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124739","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104334","السريع"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83672","البسيط"],[5397,"أترع لي في سفحه الأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=157902",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[6202,"طول مسيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86734&r=&rc=35",""]],"verses":[["والله سوّاه من لطف ومن أدب","وأفرغ الحسنَ فيه حين سواه",0,"ا",2,0],["والله سأل عصمة وكفاية","من أن أكون عن المحجة ناكبا",1,"ب",2,0],["والله سنحرفوفهم فلكا","يعطي وهذا فيهم الفلك",2,"ك",1,0],["والله سمِّيَ علام الغيوب بها","ترتبت هكذا ترتيب إنهاء",3,"ا",2,0],["والله سبحانَه ما بيننا حَكَمٌ","يَقضي عليكم به بالقَهْرِ والغَلَبَهْ",4,"ب",2,0],["والله سمى الخل رزقاً طيباً","حسناً من الأعتاب والقطعاء",5,"ا",2,0],["وَاللهُ سَابِقُ كُلِّ شَيءٌ غَيرُهُ","مَا رَبُّنَا وَالخَلقُ مُقتَرِنَانِ",6,"ن",1,0],["واللَهُ سن حبهُ للغير","سترت بين لومي شؤوني",7,"ي",1,0],["واللَه ستار على عبده","جاء بشكر أو بكفران",8,"ن",1,0],["وَاللَهُ سُبحانهُ تَجري بَدائِعه","وفقَ الإرادَة في نورٍ وَفي نارِ",9,"ر",1,0],["والله سوى صدره عيبةً","يخزن فيها سره المودع",10,"ع",1,0],["واللهُ سطَّر لوحَها بيمينهِ","وبنهرها.. سكبَ الجمالَ فأبدعا",11,"ع",2,0],["والله ستار العيوب , له الثنا","بالحمد نرجوه ولا نتزحزح",12,"ح",1,0]]}