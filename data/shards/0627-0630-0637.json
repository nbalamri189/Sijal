{"poems":[[110,"ما انفكت الناس في أديانها قددا","https://www.shoaraa.com/p11352",""],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85411","المتدارك"],[113,"إن الوزير أدام الله دولته","https://www.aldiwan.net/poem16293.html","البسيط"],[173,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77627","الرجز"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79473","المجتث"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100483","الكامل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145047","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129352","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92368","البسيط"],[4984,"نوفمبر","https://www.poetsgate.com/ViewPoem.aspx?id=183238",""],[5191,"تَدَلُّلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215453",""],[5626,"عرس نينوى","https://www.poetsgate.com/ViewPoem.aspx?id=189509",""],[5829,"خطاب لم يصل","https://www.poetsgate.com/ViewPoem.aspx?id=152684",""],[5956,"الثلاثي المثالي","https://www.poetsgate.com/ViewPoem.aspx?id=193163",""],[6106,"حكيم وشهم العرب الشيخ زايد","https://www.poetsgate.com/ViewPoem.aspx?id=7067",""]],"verses":[["إذ طَوَّقَ الجيدَ منها حَبلُ ثاكِلِها","وإنما قد طَوى في جيدِه مَسَدا",0,"د",2,0],["إِذ طارَ عَلى طيارته","في الجوِّ يكر وَيبتدر",1,"ر",1,0],["إِذ طَهَر الأَرض مِن كُفر الدُروز وَمِن","شَر البُغاة الَّذي مِن دونِهِ الأَجَلُ",2,"ل",1,0],["إِذ طَيَّرَ التَلَّ يَومَ القَصرِ كَرُّهُمُ","عَلى الأَعاجِمِ حَتّى بادَ بَينَهُما",3,"م",2,0],["إِذ طَبعه إِذا أُصيب يُغشى","عَلَيهِ مِما ذاقَهُ في الأَحشا",4,"ش",2,0],["إذ طيرُ سعدِي جوارٍ","مع امتلاكِ الجواري",5,"ر",2,0],["إذ طاف بي ندماء خمرةٍ إنها","وسرت حميا البرء في أحشائي",6,"ي",1,0],["إذ طاف بالبلوى عليهم طائف","خسف الديار وعجل استئصالها",7,"ل",3,0],["إذ طعام الأثيم بيض المواضي","وشراب الحميم فيض الوريد",8,"د",1,0],["إذ طال حزني وَقَد غلّت عليه يدي","تلك الليالي وإن طالت لقد قَصرت",9,"ت",1,0],["إذ طرحوا اليأس جانبا وحموا","عزائما من هواجس الفشل",10,"ل",1,0],["إذ طافَ حول الشَعر شِعرُ","الحبّ مفتونًا، وصَفّ",11,"ف",1,0],["اذْ طَلَّقوا الدُّنيا وَفي أحداقِهِمْ","أَمَلُ الشَّهيدِ وَوَجهُهُ الفتّانُ",12,"ن",1,0],["إذ طالما كنت المعوّل إن أنا","ذهبت رياحي واحتواني مضجع",13,"ع",1,0],["إذْ طوّع المولى جميع ذكائهم","في خدمةِ التطويرِ والتنعيمِ",14,"م",1,0],["إذ طفت تهتف في الأحباب قادتها","حتى استجابوا بعهد غير منفصم",15,"م",1,0]]}