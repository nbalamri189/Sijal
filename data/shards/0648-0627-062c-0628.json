",""],[5605,"حميمية لقاء..","https://www.poetsgate.com/ViewPoem.aspx?id=159461",""],[402,"يا مصر كم في سيرة الجيل الذي","https://www.poetsgate.com/ViewPoem.aspx?id=36070",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[5956,"ألمي عليها","https://www.poetsgate.com/ViewPoem.aspx?id=182412",""],[5956,"الظلم والطيبون","https://www.poetsgate.com/ViewPoem.aspx?id=192334",""],[5976,"مخاوين إسْعدي","https://www.poetsgate.com/ViewPoem.aspx?id=33492",""],[6102,"أحلام","https://www.poetsgate.com/ViewPoem.aspx?id=182838",""],[6115,"ياوجودي يوم شفت الديره المهجوره","https://www.poetsgate.com/ViewPoem.aspx?id=181608",""],[5309,"قيل العروبة موطن وحدود","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573935",""],[5616,"أمي ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1926&r=&rc=1",""],[5567,"فيوضات فارابية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82101&r=&rc=142",""]],"verses":[["وَأَجبُلٌ كانَ يُستَذَمُّ بِهِ","مِنَ اللَيالي فَساخَ في التُرُبِ",0,"ب",1,0],["وَاجْبُرْ بِجَبْرِي قَلْبَهُ تَنَلِ الْمُنَى","وَتُطَالِعْ الْفَتْحَ الْمُبِينَ وَشِيكَا",1,"ك",2,0],["وَأَجِبْ نِدَاءَ الضَّادِ تَسْتَوْفِيكَ مِنْ","سَامِي بَلاغِكَ مَا قَطَعْتَ فَتَمِّمِ",2,"م",1,0],["واجبُر بِها الرَّجُلَ الغَرِيبَ بأَرضِهَا","قَد فَارَقَ الأَحوَالَ والأَعمَامَا",3,"م",2,0],["واجبي أن أرى جوابيَ عُتبا","كَ فلا تجعلِ السكوتَ جوابي",4,"ب",2,0],["وأجبتُ مَنْ قال اتَّصِل بوصيلةٍ","حسبي بسؤددِ منْ مدحتُ وصيلا",5,"ل",2,0],["وأَجبْني فَدَتْكَ نفسيَ ماذا","أَمُصَابٌ أَمْ ذاك أَمرٌ ترومُهْ",6,"م",2,0],["وَأَجبُنُ عَن تَعريضِ عِرضي لِجاهِلٍ","وَإِن كُنتُ في الإِقدامِ أَطعَنُ في الصَفِّ",7,"ف",1,0],["وأَجِبْ إلى شُربِ الشَّمولِ فإنّها","تُهدي بقُربِك لي سُروراً شَامِلا",8,"ل",2,0],["واجبٌ عندَ الورى إكرامُهُ","وقليلُ المالِ فيهمْ يُستقلْ",9,"ل",1,0],["وأجبت مَنْ يلحى على تركِ القضا","تلفُ العدوَّ على العدوِّ رخيصُ",10,"ص",1,1],["وَأَجِبني وَأَنتَ أَوجَدُ شَيءٍ","وَلَكَ الوُدُّ خالِصاً مَبذولا",11,"ل",2,0],["وَأَجَبتُ في ظَهرِ الكِتابِ إِذا أَتى","لِيَلوطَ خَطّي في الكِتابِ بِخَطِّهِ",12,"ط",2,0],["وَأَجبالِ فِهرٍ وَأَحجارِها","وَكَعبَةِ كَعبٍ وَمُنتابِها",13,"ب",3,0],["وَاِجبُن أَو اِشجَع فَطُرُقُ المَوتِ واحِدَةٌ","وَالظَبيُّ فيهِنَّ مِثلُ السَيِّدِ وَالأَسَدِ",14,"د",1,0],["وَاجِبٌ مُرْهِقُ التَّكَالِيفِ","أَدَّيْتَ تَكَالِيفَهُ عَلَى الإِرْهَاقِ",15,"ق",1,0],["وَأَجَبْتَ إِنِّي لَمْ أَضِنَّ عَلَى الحِمَى","بِدَمِ الشَّبَاِب فَمَا الدِّمَاءُ بِغَالِي",16,"ل",2,0],["واجب الشعر والوفاء مدى","العمر فطوبى لشاعر ووفيّ",17,"ي",1,0],["واجِبَ القلبِ ولولا نظرةٌ","عرضتْ لاهيةً لم يَجِب",18,"ب",1,0],["واجبر فوأدي بالاغاثة مسرعا","بيد الاعانة يا ابا الزهراء",19,"ا",2,0],["واجبر بعزك في حياتي كسرتي","وأصلح شؤني يا ضيا البطحاء",20,"ا",2,0],["وَأََجبَرُ لِلمَولَى إِذا رَقَّ عَظمُهُ","وَأَسرَعُ غَوثاً يَومَ هَيجاً لِهاتِفِ",21,"ف",1,0],["وأجبت لائمتي على ترك العزا","للنّاس عند تفاوت الآجال",22,"ل",1,1],["واجبٌ كالوجودِ كلُّ الكمالا","ت محالٌ أضدادها والفناءُ",23,"ا",2,0],["وأجبتَ الجودَ مبتدئاً","فتركت المال مقتسَما",24,"م",2,0],["وَاجبُرهُ فَالمَجهولُ يَقوى عَلى اِس","تِخراجِهِ مَسأَلَةُ الجَبرِ",25,"ر",1,0],["واجبر لكسري إنّني بك واثقٌ","وبك اكتفيت وأنت أنت الكافي",26,"ف",2,0],["واجبٌ منك داعياً لك داعٍ","دع دواعي الدعوى وعد لدُعاتك",27,"ك",1,0],["واجبٌ للمحبّ حقٌّ عليه","يعطَى من حَبّ زرع تلك المروج",28,"ج",1,0],["وأَجبه عمّا قد حَواه كتابُه","من عِقد نظمٍ فصِّلت عِقيانُهُ",29,"ن",2,0],["وأجبَهُ الدهر فردا","ذا مِرّة مقداما",30,"م",2,0],["وأجبْتُ داعيةَ الصَّبابةِ نَحْوَها","فلَقِيتُ عاديةَ الخميسِ المُصْحِر",31,"ر",1,0],["واجبٌ أن تَخافَ جَيْشَ أبي بَكْرٍ","إذا كنتَ مانعاً للزّكاة",32,"ه",1,0],["واجِبٌ شُكرُهُ عَلَيَّ كما ظَن","نَ وَعِندي عَلَيهِ غَيظٌ وَعَتبُ",33,"ب",1,0],["وَأَجبَنُهُم في الحُبِّ جَفناً عَنِ الكَرى","وَنُطقاً عَنِ السَلوى وَعَزماً عَنِ الصَبرِ",34,"ر",1,0],["وأجبني إلى مديحِ إلهٍ","ذي اقتدارٍ له السماء حجاب",35,"ب",1,0],["واجبروني واقبلوني","واعذروني وارفعوني",36,"ن",2,0],["وأجب سيدي علينا بنظم","رائق دونها كؤوس الشراب",37,"ب",1,0],["واجب شكري لمن أرسلها","ومن الواجب شكر المنعم",38,"م",1,0],["وأجبتُ منه أن ينمَّ فلم أجد","له مثل أن يطوى وبالمسك يختم",39,"م",1,0],["وأجبتُ هاتفةَ الغرامِ ولو دعا","طيف الخيال لما أجاب به الصدى",40,"د",2,0],["واجبات المرء دائنه","ربّه يوما تقاضيه",41,"ي",2,0],["وأجبت داعية الفرنج بديهة","قبل الروية بارتجال رجال",42,"ل",1,0],["وأجِب قلبَ خَلِيلٍ","يَرتَجِي منكَ جَوابا",43,"ب",2,0],["وأجبْ منِّيَ النّداءَ فلم تَحْ","رِمْ سؤالاً ولا مَطَلْتَ غريما",44,"م",2,0],["واجب ما زال ربي واجباً","مستحيل أن يرى منقلبا",45,"ب",2,0],["واجب حق الله في الإمامة","وهي لعمري أعظم الظلامة",46,"ه",1,0],["وأجب القوم إذا ما سألوا","واشرح لهم جميع ما قد جهلوا",46,"ل",3,0],["واجبته البشرى بنهضتك التي","ستعيد شمس الشرق بعد زوال",47,"ل",1,0],["واجبر الكسر الَّذي أَقعدني","عَن نهوض كُنتُ عَنهُ لَم أَنَم",48,"م",1,0],["وَاجبروا ما مَضى بِحُسن اعتِكاف","وَاحتِفال بِشأَنه والتفات",49,"ت",1,0],["وَاجبر عَلى العيد كسر المُلتجى شَرَفاً","إِلَيكَ يا مُنصفاً في العجم وَالعَرَب",50,"ب",1,0],["واجبٌ كَسْبِي على كُلْ","لِ مُجيدِ الرّمي فاضِلْ",51,"ل",1,1],["وأجبت دعوته وأنت موفق","والدهر سلم والمجاز فسيح",52,"ح",1,0],["واجب الشعب ما توليت فالشا","كر أنت العظيم والمشكور",53,"ر",1,0],["وأجبت دعوة كلَّ موفٍ مخلصٍ","لترى بلاداً نضرة وعبادا",54,"د",2,0],["وَاِجبُر لِخاطِرِ مُرتَجٍ","في رَفعِ هَذا الاِنتِقام",55,"م",1,0],["وَأَجِب يا ربِّ دَعوَتنا","فَإِلَيك بَسَطنا كلّ يدِ",56,"د",1,0],["وَأجبرت رَغماً عَلى الصِيام","وَبَقيت إِلى مَدى أَيّام",57,"م",1,0],["واجبرُوا الخاطر منها","فهي جبر للخواطرْ",58,"ر",1,0],["واجبروني بجبة وبجاد","مع جذاذ من النضير نضير",59,"ر",1,0],["وَأجِبْ دُعَائِي وَاعْفُ عَنْ ذَنْبِي وَجُدْ","فَجَمِيلُ ظَنِّي فِيكَ قَدْ بَسَطَ الْيَداَ",60,"د",2,0],["وأجب دعائي مثل ما عودتني","كرما وطهرني من الأدناس",61,"س",1,0],["واجبها ان قالت كما هي تعتني","ما أنت تامر فيه دون مباحثهْ",62,"ث",2,0],["واجب أن تأتينا الي","وم إلى منزلنا ال",63,"ل",1,0],["واجبر بفضلك الخلل","واستر على معايبي",64,"ي",1,0],["وأجب نصح من أشار فما أن","كر في شرع ملة ايجابه",65,"ب",2,0],["وَأَجِب أَخاكَ إِذا اِستَشارَكَ ناصِحاً","وَعَلى أَخيكَ نَصيحَةً لا تَردُدِ",66,"د",1,0],["وأَجَبْنَاكَ إِذْ دعَوتَ وذُو التا","جِ شُرَحبِيلُ ثَمَّ غَيرُ مُجابِ",67,"ب",1,0],["واجبِ القلبِ رأى المكروهَ مِن","عَذَلٍ في لحظكِ المسنونِ سُنّا",68,"ن",2,0],["وإِجبَرَها لِذي عَظمٍ مَهِيضٍ","إِذا ضَنَّت بِدَرَّتِها اللِقاحُ",69,"ح",1,0],["وَاجِبٌ حَتْمٌ عَلَى دَاخِلِهَا","حَمدُهُ لِله ِرَبّ العالَمِين",70,"ن",1,0],["وأجبتُهُنَّ إلى الوصالِ فسَهَّلَتْ","بعد الحُرون لقاء قرب الموعدِ",71,"د",1,0],["واجبُرهُ من كل كسرٍ واردُرَدَنَّ علي","هِ بالمعارفِ يتلوها فيَنجَبِرُ",72,"ر",1,1],["وَأَجبَنُ من صافِرٍ كلبُهُم","إِذا قَرَعتُهُ حَصاةٌ أَضافا",73,"ف",2,0],["واجبٌ عنديَ أن أسعى على","بَصَرِي حقّا لهم لا قدميّ",74,"ي",1,0],["وأَجِبْ بفضلك دعوتي إذْ قلتُ فِي","تاريخه جازى الصغيّر جودا",75,"د",2,0],["وَأجبِلتَ حَتّى صِرتَ مِثلي فَإِنَّني","بِبُعدِكَ قَد لاقَيتُ ضَرباً مِنَ المَسِّ",76,"س",1,0],["واجبر المكسور بالعود إلى","بينك المحجوج كي يحظى بحج",77,"ج",1,0],["وإجبُر الكسرَ من فتىً قادرىِّ","في جميعِ الأحوالِ يا قَهَّارُ",78,"ر",1,0],["وأجب لِداعية الهَنا فَلَقَد زَهَت","أَرض الغريّ بأنسها المَشهود",79,"د",1,0],["وَأَجبالٌ تَمورُ بِها المَذاكي","وَأَقمارٌ تَميسُ بِها الغُصونُ",80,"ن",1,0],["واجبت داعى الحب ثم شكوته","كيف الخلاص وفي الفؤاد سقام",81,"م",1,0],["واجبتُها صبراً بنيّة واعلمي","إن ليس يعدو يومَهُ من يجزعُ",82,"ع",1,0],["واجب القلب لا يقر قرارا","في هوى ساكن يقرّ قرارُه",83,"ر",2,0],["واجبته والدمع جار","فوق خدي منسكب",84,"ب",1,0],["وَاجبُروا كُلِّ ثَلمٍ","وَاِمنَحوني كمالا",85,"ا",1,0],["واجبتها وجبينها متصبب","عرقاً حكى دراً عليه ترصعا",86,"ع",2,0],["واجبر لقلب بتمنيع وترك اذى","وستر عورة ذي التطليق من حرم",87,"م",1,0],["وأجبتٌ داعي النفس بال","إعرَاض عن شُبُهاتها",88,"ت",3,0],["وَاجبُر بِرَدِّ الَّلامِ مَا مِنهُ حُذِف","جَوازاً إن لَم يَكُ رَدُّهُ أُلف",89,"ف",1,0],["وأجبني بما يراض به العق","د إذا حاول الجموح انزياغه",90,"غ",2,0],["واجبه كالنون والميم ثغره","وعارضه نمل تبارك فاطره",91,"ر",2,0],["واجب ربي دعائي إنه","لقضاء الحاج مفتاح ونجح",92,"ح",1,0],["واجبر بحقّ الطهر آلك كسره","فالكرب إن تعطف عليه فرجا",93,"ج",2,0],["وأج بغدران زنث ففار","كقدرٍ تفور بنارٍ تثار",94,"ر",1,0],["وَاِجبِر بِعَفوِكَ وَالرِضا من أَنشَأت","ما اِخضَرَّ مِن دوحِ الرِياضِ وَربق",95,"ق",1,0],["واجب بالنصوص منه عن الله","وأين المصغي بك الاقتداء",96,"ا",2,0],["وأَجْبُلُ القبلةِ الغرَّاء قابَلَها","طودُ المحاريب من أعلامِ مُذْقار",97,"ر",1,0],["وأجبت هاتفه الصباح بنعرة","أضحى لها بقلوبهن وجيب",98,"ب",1,0],["واجبٌ رغمَ الهوى يدفعهُ","وهوى يثنيه عمّا وجبا",99,"ب",2,0],["واجبته وطلبت فيها عونه","وهو المعين الطالبيه المرشدُ",100,"د",1,0],["وَأَجَبْتُهَاْ: إِنِّيْ يَئِسْتُ، وَكُلَّمَاْ","نَاْدَيْتُ، يَخْنِقُ صَرْخَتِي الْجَزَّاْرُ",101,"ر",1,0],["وأجبر القلب وجد لي","وقني من كل فاجر",102,"ر",1,0],["واجبر مُصابَ أبي وكلِّ أحبتي","وارحمْ فإني عن مصيري جاهلُ",103,"ل",1,0],["واجبره يا جبار من كسر الهوى","إلا لوجهك في كريم عَلائه",104,"ا",3,0],["وأجب نداه يا مجيب فطالما","ناداك في إعلانه وخفائه",104,"ا",3,0],["واجب انّا نقدّرها ونشكر عطاها","مابقي غير هيل في حلوق الدلالا",105,"ل",2,0],["واجبلْ معَ الدَّمعِ أطواداً تثبِّتُنَا","بُثَّ الصَّلابةَ في أركانِ مرتَعِدِ",106,"د",1,0],["وأجب إيليا الذي ليس يدري","فلسفيّاً من أين جاء بحال",107,"ل",1,0],["وَأَجْبَرَتْنِي على الأَحلامِ مُرتقبًا","طَيْف الزيارةِ ما أحلَى.. وَأَحْلاَكِ",108,"ك",1,0],["وأجبت إني لم أضن على الحمى","بدم الشباب فما الذماء بغالي",109,"ل",2,0],["وأجبت كل مصعر فدمغته","وجزاء كل مكيدة تنكيد",110,"د",1,0],["‏واجبر خواطرنا وبدِّدْ خوفنا","‏ ‏ وعليك وحدك ربَّنا نتوكلُ",111,"ل",1,0],["واجبُ الشعر يقوّى ملَكات","لدفاعٍ وليبدي ما يراهُ..",112,"ا",2,0],["واجب عليك انّك لربّك تحمدي","إنّي كتبت الك القصيده فالدوام .. !!",113,"م",1,0],["وَ أَجَبتُها : ( أَنا مُوقِدُ الأَشواقَ فِي","مُهَجِ الدُّنَى , مُذْ بِتُّ فِيها المالِكا !",114,"ك",2,0],["واجب الشاعر بمكنونه يصيغ شعوره","وانا قلت ابيات بأفكاري وصح لساني",115,"ن",2,0],["وَأَجبتُ بَل هِيَ فِكرَةٌ مَوضوعَةٌ","لِلخَلقِ أَجمَعَ قَصدُها التَّوحيدُ",116,"د",1,0],["واجبرْ إلهي كسْراً ، حلَّ في ولدي","فأنتَ تجبرُ يا مولاي ما انكسرا",117,"ر",2,0],["واجب أنت في الوجود إلهي","وأنا العبد في وجوده فان ِ",118,"ن",1,0]]}