{"poems":[[107,"ناج الشهيد وحدث بعده الأثرا","https://www.aldiwan.net/poem42131.html","البسيط"],[52,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[487,"خود رمت عن قوس حاجبها سها","https://www.aldiwan.net/poem24485.html","عموديه"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45782","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44717","الكامل"],[5064,"الرُّوح","https://www.poetsgate.com/ViewPoem.aspx?id=199136",""]],"verses":[["سِرْ غازياً تَغمرُ الدُّنيا عساكرُه","أما ترى الشرَّ أمسى يَغمرُ البَشرَا",0,"ر",2,0],["سِر غَيرَ وانٍ وَلا ثانٍ عَلى شَجَنٍ","إِنَّ الإِمامَ لِمَن صَلّى بِمِرصادِ",1,"د",1,0],["سر غدا معنى الحروف كأنه","محمود أحمد عنصر الأعيان",2,"ن",1,0],["سر غَير مَأمور وَدارك فتنة","تَأبى السُكون بِغَير جحجاح سَرى",3,"ر",2,0],["سِرٌّ غَداً أَرشادُه حِصناً إِلى","مِن أَزعَجَتهُ حَوادثُ الإَزمانِ",4,"ن",1,0],["سِرْ غيرَ مُكتَرِثٍ بِمَا ترُومُ فقَدْ","يأتِي بهِ قدَرٌ يمضِي بهِ القدَرُ",5,"ر",1,0]]}