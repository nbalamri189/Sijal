{"poems":[[82,"هل أقصر الدهر عن تعنيت ذي أدب","https://www.aldiwan.net/poem31565.html","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16664","الطويل"],[111,"أبا الحارث اسمع حديثا جرى","https://www.poetsgate.com/ViewPoem.aspx?id=527",""],[256,"أما وجفونك المرضى الصحاح","https://www.aldiwan.net/poem1418.html",""],[357,"ولما ضاقت الأسباب فينا","https://www.aldiwan.net/poem39593.html","الوافر"],[433,"إلا ربما زار الملاح وربما","https://www.aldiwan.net/poem41046.html","الطويل"],[436,"صدرنا وقد نادى السماح بنا ردوا","https://www.aldiwan.net/poem12450.html","الطويل"],[445,"فؤادي يحن لليلى الشريفه","https://www.aldiwan.net/poem14314.html","المتقارب"]],"verses":[["ولم أضِقْ في السرَى ذرعاً بمعضلةٍ","قد زاحمتنيَ حتى ضاقَ مُضْطَربي",0,"ب",2,0],["ولمّا ضَرَبْنا قَوْنَسَ الليلِ من عَلٍ","تَسَرّى بنَضْخِ الزّعْفَرانِ أوِ الرَّدْع",1,"ع",1,0],["ولما ضجرنا انقلبنا الى","ديار تطاول تقلابها",2,"ب",3,0],["وَلَمّا ضاقَ حَدٌّ عَن مَداهُ","لَقَيناهُ بآمالٍ فِساحِ",3,"ح",1,0],["وَلمّا ضاقَت الأَسباب فينا","وَلَم يَبلغ فَتى مِنّا مُناهُ",4,"ه",1,1],["ولما ضممت الخصر من بان قدّها","لمست بكفيّ البنان المخضبا",5,"ب",2,0],["ولما ضرَبْنا للأماني ونيلها","أوَناً شرَطْنا فيه أنك موعِدُ",6,"د",1,0],["ولما ضممت أنا عطفها","لصدري فكانت لوصلي عطوفه",7,"ف",2,0]]}