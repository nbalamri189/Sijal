{"poems":[[82,"هل أقصر الدهر عن تعنيت ذي أدب","https://www.aldiwan.net/poem31565.html","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16664","الطويل"],[111,"أبا الحارث اسمع حديثا جرى","https://www.poetsgate.com/ViewPoem.aspx?id=527",""],[257,"أما وجفونك المرضى الصحاح","https://www.aldiwan.net/poem1418.html",""],[358,"ولما ضاقت الأسباب فينا","https://www.aldiwan.net/poem39593.html","الوافر"],[435,"إلا ربما زار الملاح وربما","https://www.aldiwan.net/poem41046.html","الطويل"],[438,"صدرنا وقد نادى السماح بنا ردوا","https://www.aldiwan.net/poem12450.html","الطويل"],[447,"فؤادي يحن لليلى الشريفه","https://www.aldiwan.net/poem14314.html","المتقارب"],[595,"","https://poetry.dctabudhabi.ae/diwan/poem/100675","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63889","الهزج"],[2053,"","https://poetry.dctabudhabi.ae/diwan/poem/132441","الرجز"],[3145,"","https://poetry.dctabudhabi.ae/diwan/poem/128313","الوافر"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133228","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135433","البسيط"],[3927,"","https://poetry.dctabudhabi.ae/diwan/poem/113705","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94504","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57980","الوافر"],[5213,"ولما ضاقت الدنيا وجار ال","https://www.poetsgate.com/ViewPoem.aspx?id=170446",""],[5284,"هرمنا","https://www.poetsgate.com/ViewPoem.aspx?id=191799",""],[5605,"ملحمة الحذاء","https://www.poetsgate.com/ViewPoem.aspx?id=159791",""],[5975,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=52972",""]],"verses":[["ولم أضِقْ في السرَى ذرعاً بمعضلةٍ","قد زاحمتنيَ حتى ضاقَ مُضْطَربي",0,"ب",2,0],["ولمّا ضَرَبْنا قَوْنَسَ الليلِ من عَلٍ","تَسَرّى بنَضْخِ الزّعْفَرانِ أوِ الرَّدْع",1,"ع",1,0],["ولما ضجرنا انقلبنا الى","ديار تطاول تقلابها",2,"ب",3,0],["وَلَمّا ضاقَ حَدٌّ عَن مَداهُ","لَقَيناهُ بآمالٍ فِساحِ",3,"ح",1,0],["وَلمّا ضاقَت الأَسباب فينا","وَلَم يَبلغ فَتى مِنّا مُناهُ",4,"ه",1,1],["ولما ضممت الخصر من بان قدّها","لمست بكفيّ البنان المخضبا",5,"ب",2,0],["ولما ضرَبْنا للأماني ونيلها","أوَناً شرَطْنا فيه أنك موعِدُ",6,"د",1,0],["ولما ضممت أنا عطفها","لصدري فكانت لوصلي عطوفه",7,"ف",2,0],["ولما ضاق بطن الأرض عن أن","يضم علاك من بعد الوفاة",8,"ه",1,0],["ولم أضعفْ عن الشرب","بجامٍ لا ولا طاس",9,"س",1,0],["ولم أُضِع كتب أبي عبيدِ","جميعها في ربقتي وقيدي",10,"ي",1,0],["ولمّا ضمّا وحوى عليها","تركت له بعاقبة نصيبي",11,"ب",2,0],["ولما ضقت من مرضى وسقمى","وأدركني من العي العناء",12,"ا",2,1],["ولم أضنّ بغيرها مقابلة","حتى بدا عابد الوهاب عبّاده",13,"د",2,0],["ولم أضيع عهوداً منك لي سلفت","وما غدرت فلم للود احترم",14,"م",1,0],["وَلمّا ضاء في الجنات وردٌ","وقد حاكى الخزامه في زُرودِ",15,"د",1,1],["ولم أضرع لحادثة الرزايا","إذا خضعت لها غُلْبُ الرقاب",16,"ب",1,0],["ولما ضاقت الدنيا وجار ال","زمان على بالخطب الشديد",17,"د",1,1],["وَ لَمَّا ضَاقَتِ الدُّنْيَا بِصَدْرِيْ","وَنَاءَ بِحَمْلِ مَا لَاقِيْتُ ظَهْرِيْ",18,"ر",2,1],["ولما ضَا قَ صبرك يا حذاءُ","وأعياكَ التسكع والعنَاءُ",19,"ا",2,0],["ولمّا ضجَّ بي ألمٌ وسقمٌ","ونارٌ لِمْ ذهبتَ فلا أراكا",20,"ك",2,0]]}