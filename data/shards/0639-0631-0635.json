{"poems":[[79,"عرصات دارك للضياف مبارك","https://www.aldiwan.net/poem36384.html","الكامل"],[87,"يا قلب ويحك والمودة ذمة","https://www.aldiwan.net/poem8110.html","الكامل"],[87,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[47,"هين ما يقول فيك اللاحي","https://www.aldiwan.net/poem62696.html","الخفيف"],[68,"يا بدورا تغيب تحت التراب","https://www.aldiwan.net/poem40292.html","الخفيف"],[46,"الزنج أكرم منكم والروم","https://www.aldiwan.net/poem30003.html","الكامل"],[369,"أنت للعيد وهو للناس عيد","https://www.aldiwan.net/poem60931.html","الخفيف"],[422,"إسأل الأرسم لو ردت جوابا","https://www.aldiwan.net/poem54032.html","الرمل"],[519,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[556,"هل مجير من غصة ما تقضى","https://www.aldiwan.net/poem47736.html","الخفيف"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49935","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79929","الخفيف"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28515","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125880","الكامل"],[5376,"أيها الغاصب ....إنها القدس","https://www.poetsgate.com/ViewPoem.aspx?id=188543",""]],"verses":[["عَرَصَاتُ دَارِكَ لِلضِّيَافِ مَبَارِكُ","وَبِضَوْءِ نَارِ قِراكَ يُهْدَى السَّالِكُ",0,"ك",1,1],["عَرَصاتُها مَمطورَةٌ بِمَدامِعٍ","مَوطوءَةٌ بِمَفارِقٍ وَجِباهِ",1,"ا",2,0],["عَرَصاتٌ تَخَلَّتِ الخَيلُ عَنها","وَاِستَراحَت مِن اِحتِراسٍ وَعَسِّ",2,"س",1,0],["عَرَصاتٌ قَد أَبرَحَت حُرَقَ الشَو","قِ إِلَيهِنَّ أَيَّما إِبراحِ",3,"ح",1,0],["عَرَصاتٌ كَأَنَّهُنَّ سَماءٌ","قَد تَوارَت شَموسُها في الحِجابِ",4,"ب",1,0],["عَرَصاتُ سوءٍ لَم يَكُنَّ لِسَيِّدٍ","وَطَناً وَلَم يَرتَع بِهِنَّ كَريمُ",5,"م",1,0],["عَرصاتُ كأنّها عرَفاتٌ","مِلْؤُها العُرْفُ والفَعالُ الحَميد",6,"د",1,0],["عَرصاتٌ يَقِفُ الصبّ بها","ينفدُ الدَّمع ذهاباً وإيابا",7,"ب",2,0],["عرَصاتٌ عطّرَتْ أرجاءَها","بأريجِ المِسكِ أنفاسُ دماها",8,"ا",3,0],["عرصاتٌ أصبحن وهي سماءٌ","ثمّ أمسين بالحوادث أرضا",9,"ض",2,0],["عَرَصاتهم مَغْنى الفقير المُعتَفي","وحُصونُهم مأوى اللَّهيف المُزْعَجِ",10,"ج",1,0],["عَرصاتٍ حَبستَ أيدي المراسي","لِ عليها والدمعُ ملك طَليقُ",11,"ق",1,0],["عَرَصات كَأَنَّهُنَّ لَيالٍ","فارَقَتها عِندَ الكَمالِ البُدورُ",12,"ر",1,0],["عرصاتُها وطني وساكنُ رَبْعها","أهلي وصفوةُ أهلِها إخواني",13,"ن",2,0],["عرصاتُها كالروض يلهو خافقي","سكنت بخيفتها تئن بمرجفِ",14,"ف",1,0]]}