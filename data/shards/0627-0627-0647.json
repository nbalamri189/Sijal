{"poems":[[55,"قد قلت للنفس الشعاع أضمها","https://www.aldiwan.net/poem30669.html","الكامل"],[73,"أهاجك شوق أم سنا بارق نجدي","https://www.aldiwan.net/poem4007.html","الطويل"],[29,"لست بمعطي الحكم عن شف منصب","https://www.aldiwan.net/poem5670.html","الطويل"],[39,"ألا هل عم في رأيه متأمل","https://www.aldiwan.net/poem7652.html","الطويل"],[53,"حتى متى يوري سواي وأقتدح","https://www.aldiwan.net/poem9423.html","الكامل"],[33,"أيا من كان لي بصرا وسمعا","https://www.aldiwan.net/poem42237.html","الوافر"],[83,"أرقت لبرق بالحمى يتألق","https://www.aldiwan.net/poem61455.html","الطويل"],[77,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62272","الطويل"],[112,"الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=34732",""],[80,"تَظُنُّ بِنا أُمُّ الرَّبيع سآمَةً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86477&r=&rc=22",""],[124,"أيا ساعة مليت فيها بحسنه","https://www.aldiwan.net/poem49302.html","الطويل"],[208,"أحب فمن ذا الذي أخلفه","https://www.aldiwan.net/poem53251.html","المتقارب"],[234,"لست أدرى من المعلى المهنا","https://www.aldiwan.net/poem51270.html","الخفيف"],[242,"أأهل سلا أهل السلو عن البخل","https://www.aldiwan.net/poem18858.html","الطويل"],[246,"أأهنأ بالدنيا ومولاي واجد","https://www.aldiwan.net/poem45770.html","البسيط"],[303,"أضر بغادة هيفاء رود","https://www.aldiwan.net/poem36293.html","عموديه"],[371,"أيا نازحا أفنى نواظرنا نزحا","https://www.aldiwan.net/poem17168.html","الطويل"],[408,"كم ذا يذوب أسى وكم يتجلد","https://www.aldiwan.net/poem46938.html","الكامل"],[466,"أأهجع أم آوي إلى لين مرقد","https://www.aldiwan.net/poem15111.html","الطويل"],[580,"أيا بصري لا تنظرن إلى بصرى","https://www.aldiwan.net/poem2725.html","الطويل"],[592,"دع للعبرات تنسجم انسجاما","https://www.aldiwan.net/poem11522.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122733","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48854","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63907","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112940","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80005","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79989","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132238","الوافر"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132259","الطويل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66262","الخفيف"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11171","الطويل"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20440","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199944","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205026","الوافر"],[3170,"","https://poetry.dctabudhabi.ae/diwan/poem/115127","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138578",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216835","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131087",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131272",""],[4009,"","https://poetry.dctabudhabi.ae/diwan/poem/20979","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83500","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139523",""],[4814,"ظمأ","https://www.poetsgate.com/ViewPoem.aspx?id=193408",""],[4578,"أآهدي إليَّ تفضلاً تمثالهُ","https://www.poetsgate.com/ViewPoem.aspx?id=49508",""],[5039,"المسامح كريم","https://www.poetsgate.com/ViewPoem.aspx?id=48114",""],[5136,"أضحك النصر مبسم العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=121488",""],[5147,"هل ربع ذاك الحي يدري","https://www.poetsgate.com/ViewPoem.aspx?id=166707",""],[5149,"رسولَ اللهِ قد عَظُمَ البَلاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=212566",""],[5463,"ألف ونّه وسط قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=25292",""],[5463,"قصه كذوبه","https://www.poetsgate.com/ViewPoem.aspx?id=25529",""],[5463,"آآه يا حالي عليها","https://www.poetsgate.com/ViewPoem.aspx?id=31732",""],[5480,"الفداء","https://www.poetsgate.com/ViewPoem.aspx?id=9889",""],[5480,"الجيره","https://www.poetsgate.com/ViewPoem.aspx?id=30870",""],[5537,"وجع","https://www.poetsgate.com/ViewPoem.aspx?id=208165",""],[5582,"أَتَجْحَدُ داءَ الحُبِّ عِنْدَ المُشاهِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186906",""],[5582,"لِمَنْ بِطُلُولِ الأَبْرَقَيْنِ مُقامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187300",""],[5582,"كَئِيبٌ ما النَّسِيمُ سَرَى عَلِيلا","https://www.poetsgate.com/ViewPoem.aspx?id=63608",""],[5895,"عُيُونُكِ قالَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=202651",""],[6052,"الطيف النزيل بمقلتي","https://www.poetsgate.com/ViewPoem.aspx?id=50261",""],[6056,"شعاع الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=130143",""],[6056,"كأس المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=130314",""],[6056,"المرثية","https://www.poetsgate.com/ViewPoem.aspx?id=130571",""]],"verses":[["أَأهُزُّ مَن لا يَنثَني وَأُديرُ مَن","لا يَرعَوي وَأَلومُ مَن لا يَختَتي",0,"ت",2,0],["أَأَهلُ الحِمى خَصوكَ مِنهُم بِنَفحَةٍ","فَأَصبَحتَ مُعتَلَّ الصَّبا عطرَ البُردِ",1,"د",1,0],["أَأَهدَيتَ يازيقَ بنَ زيقٍ غَريبَةً","إِلى شَرِّ ما تُهدى إِلَيهِ الغَرائِبُ",2,"ب",1,0],["أأهلُ كتابٍ نحنُ فيه وانتمُ","على الحقِّ نَقضِي بالكتاب وَنَعدِلُ",3,"ل",1,0],["أَأَهَشُّ من رَجُلٍ برأْيِكَ يقتدي","أأخَفُّ من رَجُلٍ بكَفِّكَ يتَّشِحْ",4,"ح",1,0],["أَأَهجُرُها وَأَقعُدُ لا أَراها","وَأَقطَعُها وَما هَمَّت بِقَطعي",5,"ع",2,0],["أَأُهدي إِلى شَمسِ الضُحى كَوكَبَ السُها","وَيُنفِقُ لي في مَعدِنِ التِبرِ زِئبَقُ",6,"ق",1,0],["أأُهْضَمُ لا نَبعَتي مَرْخَةٌ","ولا عَزماتي أيادي سَبا",7,"ا",1,0],["أَأَهرب من وجه الرَزايا إِلى الفلا","إلى الغاب إن الغاب لا شك أستر",8,"ر",1,0],["أَأَهْجُرُ لَيْلى بَعْدَ طُولِ صَبَابَةٍ","أَمَ اصْرِمُ حَبْلَ الوصْلِ مِنْهَا فَأَقْطَعُ",9,"ع",1,0],["آآه لا وقفت مابين تصيب وتخيب","بيني وبين المواليف وفواه السباع",10,"ع",1,0],["أَأَهجرُ ظَبيًا في ضُلوعي كِناسُهُ","وَبَدرَ تَمامٍ في جُفوني مَطالِعُه",11,"ع",2,0],["أأهواك أم أقلاك واللَه إنني","لأجهل ما تطوي عليه الضمائر",12,"ر",1,0],["أأهجوه حتّى يقول الأنامُ","أنَصرٌ هجاه لقد شرَّفَه",13,"ف",2,0],["أأهنِّيك يا شقيقَ المعالي","أم أُهَنّي بك اتخاذَ الدواء",14,"ا",2,0],["أَأَهْلَ سَلاَ أَهْلَ السُّلُوِّ عَنِ الْبُخْلِ","سَلِمْتُمْ وَدُمْتُمْ فِي مُسَالَمَةِ الْمَحْلِ",15,"ل",1,1],["أأهنأُ بالدنيا ومولاي واجِدٌ","على وأرضاها ومولاى مغضَبُ",16,"ب",1,1],["أَأَهرق ماءَ وَجهي في سؤالٍ","وَما في الحيِّ من رجلٍ رشيد",17,"د",1,0],["أَأَهلَ الأَسى لِلناسِ في الناسِ أُسوَةُ","وَمَن ذا الَّذي أَمسى بِعَمرِ الَّذي أَضحى",18,"ح",2,0],["أَأُهَيْلَ وادِي المنْحَنَي وحياتِكُمْ","إنّي على ما تَعْهَدونَ وأعْهَدُ",19,"د",1,0],["أأهجعُ أم آوي إلى لينِ مَرْقَد","ولم يرو في كفي غرارُ مُهنَّدي",20,"د",2,1],["أَأَهبِطُ مِنْ مصرٍ وقِدْماً قد اشتهى","عَلَى اللهِ أَقوامٌ فقال اهْبِطُوا مِصْرَا",21,"ر",2,0],["أ أهجر من إذا أقبلت هشت","وأولتني التحية والسلاما",22,"م",2,0],["أَأَهلَ الغَضَى لَو أنَّ نَفسي تُطيعُني","لَنَهنَهتُها بِالعَذلِ دُونَ العَواذِلِ",23,"ل",1,0],["أأهوى فريقاً لا يرد تحيةً","وأجفو فريقاً لا يحسُّ جفاءَ",24,"ا",2,0],["أأهجو الذي لو كُلِّفَ الخُرسُ مَدْحَهُ","لما عَجَزَتْ عن مَدْحِه أَلْسُنُ الخُرْس",25,"س",1,0],["أأهل البيت قوموا بالضعيف","فانتم خير الرب اللطيف",26,"ف",1,1],["أَأُهنِّيك قائلاً لك بشرى","أو أُعزِّيك قائلاً لك صبرا",27,"ر",2,1],["أأهل النفوس الغالبيات مولداً","لأنتم على كسب المكارم أغلب",28,"ب",1,0],["أأهل الحب هل لكم دواء","به أسلو ونجب الحب تحد",29,"د",1,1],["أأهل الثنا فأتوا بمثل براءة","وفاتحة والفتح والنجم والزمر",30,"ر",1,0],["أأهنيكما ومنكم هنا كل البرايا","دوّاره قد دارا",31,"ر",2,0],["أَأَهجو قُرَيشاً ثُمَّ تَكرَهُ ريبَتي","وَيَسرِقُني عِرضي حُمَيسُ إِبنُ عامِرِ",32,"ر",1,0],["أَأُهلِكُها وَقَد لاقَيتُ فيها","مِرارَ الطَعنِ وَالضَربِ الشِجاجا",33,"ج",2,0],["أأهدم أبياتهم ثم لا","يضج الأولى بيتهم قد هدم",34,"م",1,0],["أأهجوه وخلقته هجاء","له ووجوده نحس وشؤم",35,"م",1,0],["أَأهجوا تَميماً إن تَعرَّضَ مُلصَقٌ","إليها دَعي قد نفتهُ قرونُها",36,"ه",2,1],["أأهني الهدى بشعبان بشرى","أم أعزيه والعزا فيه أحرى",37,"ر",2,1],["أأهواه أم أهوى خيالاً تعلقت","به نظرتي في صفحة القدماء",38,"ا",2,0],["أأهواه ميت الروح في عنفوانه","وتغلى عليه بالحياة دمائي",38,"ي",1,0],["أأهوى الحسان الفاتنات وجوهها","وبي من شقائي ما يراع به الوجد",39,"د",1,0],["أأهوى الشيوخ وهم كالهشيم","وحولي من هم كزهر الربى",40,"ب",2,0],["أَأَهتَمُّ يا خَيرَ البَرِيَّةِ والِداً","وَرَهطاً إِذا ما الناس عَدّوا المَساعِيا",41,"ي",2,1],["أَأَهوي لِلحَضيض وَجاهُ طه","رَفيعٌ ما لرفعته اِنتِهاءُ",42,"ا",2,0],["أاُهنّى الزمان منك بصفوٍ","فيه عيش العلا غدا مستطابا",43,"ب",2,0],["أ أهونُ عليَّ وأحرمني","جنّةَ أحداقكَ يا أحور؟",44,"ر",1,0],["أآهدي إليَّ تفضلاً تمثالهُ","من لستُ أنظر في الأنام مثاله",45,"ل",2,1],["آآه ..إلى رو ّحوا صوت الخطا صوت ديم","ثم روحت ياتركي تسوق القرايب",46,"ب",1,0],["أأهنيك أم أهني بأثناء","معاليك سيد الأنبياء",47,"ا",2,0],["أأهيل ذاك الربع إني","منك في قلق وفكر",48,"ر",1,0],["أَ أَهلَ الأَرضِ مُنْقِذُكُمْ وَلِيدٌ،","جَديبُ الأَرْضِ أَزْهَرَ والسَّمَاءُ",49,"ا",2,0],["آآه يا روحي الحزينه آآه يا مقسى بعاده","[ جَدّ شاعر ] لو يعوّد إفتداه بشوف عينه",50,"ن",2,0],["آآه يا حرف(ن) معذّب ما قوى شخص(ن) سماعه","وآآه يا هم(ن) مهاجر زارني ويّا سُرُوبه .. !",51,"ب",2,0],["آآه يا قلبي .. متى هالحظ يكشف لي قِنَاعَه ؟","وأفرح بأيامي مرّه وتِصْبِحْ لعمري عُذوبه .. !",51,"ب",2,0],["آآه يا حالي عليها وآآه يا مسكين حالي","منذ غابت وانا كلي بنار شوقي أحتريها",52,"ي",3,1],["آآه عليها يا حروفي آآه عليها يالليالي","ودّي بلحظة لقاها وإيدي تلامس إيديها",52,"ي",3,0],["آآه يا هم\"ن\" كتمته في ضميري واستباح","مستحّل فكل جسمي مدمي ٍ كل الجروح",53,"ح",1,1],["آآه يا جار الدنا صغيره","ما تلحّق مضغت الزادي",54,"د",2,0],["أاه يا بلد ساكته","عن حقك المغصوب",55,"ب",1,0],["أَأَهْلَ الغَضَا ما عِلْمُكُمْ عَنْ مَعاهِدٍ","بِوادِي الغَضَا وَالأَبْرَقِ المُتَباعِدِ",56,"د",1,0],["أَأَهْلَ الهَوَى بُثُّوا الغَرامَ وَصَرِّحُوا","فَإِنِّي لَكُمْ فِيما أَبُثُّ إِمامُ",57,"م",1,0],["[ أَأَهْلَ الحَقِّ مِنْ كَنَفَيْ عُمانٍ","لَقَدْ كُفِّيتُمُ الأَمْرَ العَضِيلا ]",58,"ل",2,0],["أأهْرَبُ مِنْكِ وَفِيكِ سَراحِى ؟!","فَإِنِّى سَجِينٌ بِحُكْمٍ غَرِيبْ",59,"ب",1,0],["أ أهرب من جلدي وفيه تشدُّني","عروق بهنًّ البرُّ يسقي وثاقيا",60,"ي",2,0],["آآه ياوقتي اللي ، في مهب الهبوب","طار مثل الحلوم اللي تجي بالمنام",61,"م",1,0],["آآه يا قلبي وش اللي صار فيك وصار فيني","ما بقالك حظ باللي في غرامك ترتجيه",62,"ي",2,1],["آآه وآجض قلبي من صروف الدهر","جضّة اللي مريض ٍ والمداوي كواه",63,"ا",2,1]]}