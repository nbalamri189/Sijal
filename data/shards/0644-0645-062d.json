.aspx?id=158858",""],[3271,"أنا شاعر الوادي وعزاف اللظى","https://www.poetsgate.com/ViewPoem.aspx?id=103536",""],[3271,"على مذبح الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=103196",""],[585,"عبست لك الدنيا وحال ودادها","https://www.poetsgate.com/ViewPoem.aspx?id=161922",""],[5111,"بسمةُ الرحمانِ","https://www.poetsgate.com/ViewPoem.aspx?id=212080",""],[5273,"رسول النواعير","https://www.poetsgate.com/ViewPoem.aspx?id=215990",""],[5411,"النَّقْشُ اليَمانِي","https://www.poetsgate.com/ViewPoem.aspx?id=186271",""],[5411,"مَقام الْوَرْدِ","https://www.poetsgate.com/ViewPoem.aspx?id=196446",""],[5431,"ونور من الرحمن يجلو وساوسي","https://www.poetsgate.com/ViewPoem.aspx?id=189700",""],[5431,"البردة -ريم","https://www.poetsgate.com/ViewPoem.aspx?id=190769",""],[5431,"إنّ الإباء لنا من مائه بردى ....","https://www.poetsgate.com/ViewPoem.aspx?id=197082",""],[5538,"عشق الحبيب وما هجر","https://www.poetsgate.com/ViewPoem.aspx?id=142631",""],[5573,"الله الواحد","https://www.poetsgate.com/ViewPoem.aspx?id=200182",""],[5574,"وهْم","https://www.poetsgate.com/ViewPoem.aspx?id=206022",""],[5606,"أنا على عهدالوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=194981",""],[5650,"امْلأْ فُؤادَكَ بِالْحَبيب","https://www.poetsgate.com/ViewPoem.aspx?id=131222",""],[5736,"طيف","https://www.poetsgate.com/ViewPoem.aspx?id=208229",""],[5818,"ملهمة شعري","https://www.poetsgate.com/ViewPoem.aspx?id=199981",""],[5829,"صبوة عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=148226",""],[5848,"مهرجان الدوحه السابع","https://www.poetsgate.com/ViewPoem.aspx?id=48848",""],[5848,"الى حال دون الباب","https://www.poetsgate.com/ViewPoem.aspx?id=48847",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[5956,"صوتٌ حنونٌ فألُهُ تبشيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=205261",""],[6001,"لمحت لك","https://www.poetsgate.com/ViewPoem.aspx?id=410",""],[6056,"رحيق الذات","https://www.poetsgate.com/ViewPoem.aspx?id=130317",""],[6102,"ظهيرة تحت رحمة الكهرباء","https://www.poetsgate.com/ViewPoem.aspx?id=184444",""],[6268,"إضاءة في خيمة الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82915&r=&rc=1",""],[6318,"مواكب بدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66158&r=&rc=8",""]],"verses":[["لِمِحْبَرَةِ البُنّيِّ وقْفٌ يَقوتُها","إذا ما شكَتْ برْحَ الأوامِ تَراقِيها",0,"ه",2,1],["لَمَحُوكَ يَا بَدْرَ الْكَمَالِ فكَبَّرُوا","وَبَدَا هِلاَلُكَ بَعْدَ ذَاكَ فَهَلَّلُوا",1,"ل",3,0],["لمُحمّدٌ خيْرُ البريّةِ كلِّها","ذاتاً وأوْسَعَهُمْ لِعافٍ جُودا",2,"د",2,0],["لِمُحَمَّدِ بْنِ أَبِي الْوَلِيدِ شَمَائِلٌ","غُرٌّ بَدَتْ وَالْحُسْنُ بَعْضُ صِفَاتِهَا",3,"ت",3,0],["لَمَحقوقَةٌ أَن تَستَجيبي لِصَوتِهِ","وَأَن تَعلَمي أَنَّ المُعانَ مُوَفَّقُ",4,"ق",1,0],["لَمحَةً يَسعَدُ الصَديقانِ فيها","بِاِجتِماعٍ وَيَلتَقي العاشِقانِ",5,"ن",1,0],["لَمَحتُ مِن مِصرَ ذاكَ التاجَ وَالقَمَرا","فَقُلتُ لِلشِعرِ هَذا يَومُ مَن شَعَرا",6,"ر",2,1],["لَمَحتُ جَلالَ العيدِ وَالقَومُ هُيَّبُ","فَعَلَّمَني آيَ العُلا كَيفَ تُكتَبُ",7,"ب",1,1],["لِمُحِبٍّ في حَبيبٍ","عَنهُ ناءٍ مِنهُ دانِ",8,"ن",1,0],["لمحت تباشير المنى من خلاله","ضئالاً كمهوك غدا يشتكي الضُرّا",9,"ر",2,0],["لمحتك للبين المصادف لمحةً","فطاحت بأحشائي إليك الطوائح",10,"ح",1,0],["لمحسنٍ أسلفني فروَّجا","أيسرُ ما استوجب أن يُتوَّجا",11,"ج",2,0],["لَمَحنا الحَظَّ ناحِيَةً فَلَمّا","بَلَغناها أَحَسَّ بِنا فَحادا",12,"د",2,0],["لِمُحَمَّدِ بنِ عَلِيٍِّ الشَرَفُ الَّذي","لا يَرمُقُ الجَوزاءَ إِلّا مِن عَلِ",13,"ل",1,0],["لَمحةُ البارقِ من حيثُ لَمحْ","طَمَحَتْ للشَّوقِ وَهْناً فطَمَحْ",14,"ح",1,1],["لِمُحَمَّدِ بنِ الهَيثَمِ بنِ شُبانَةٍ","مَجدٌ إِلى جَنبِ السماكِ مُقيمُ",15,"م",1,0],["لَمَحَتكَ مِصرُ فَأَبصَرتَ آمالَها","تَمشي عَلى السَنَنِ السَوِيِّ وَتَدأَبُ",16,"ب",1,0],["لِمُحِبٍّ عَلى المَوَدَّةِ باكٍ","أَو يَكونَ الصَنيعُ مِنكُم سَديدا",17,"د",2,0],["لم حولك الأرض الوسيعة أقفرت","والماء منك هناك غير ثماد",18,"د",1,0],["لمحت على بُعد اشارة صاحب","ينادي أن ارْجع وهو بالثوب مُلمِع",19,"ع",1,0],["لمحتربٍ مِنَ الأبطال فادٍ","يخاف الدهرُ أن يَلقى عُرامهْ",20,"م",2,0],["لمح الشقى يد العناية والرخى","خَفَضا الجناح لمستغاثُ مُصرِخِ",21,"خ",1,0],["لمح كلمح البياض","من العيون الكحيلة",22,"ه",1,0],["لَمَحَتْ فَوْزُ لَمْحَةً أَعْجَبَتْهَا","فَأَشَارَتْ إِلَى سُعَادَ وَهِنْدَ",23,"د",1,0],["لَمَحْتُ مِنْكَ جَفاءً","فَاسْلَمْ وَكُنْ خَيْرَ جَافِ",24,"ف",1,1],["لَمحَةٌ مِن سَناهُ مِصباحُ لَيلي","وَدُعاء مِن فيهِ مِفتاحُ كنزي",25,"ز",2,0],["لَمحَ البِشْرُ باسماً بالأماني","وشدا الصفوُ صادحاً بالأغاني",26,"ن",2,1],["لَمَحُوا عِزَّةً وشَامُوا بِكَفَّيْك","غَمَاماً هَتَّانةً أَنْدَاؤه",27,"ا",3,0],["لَمَحاتٌ كأنّها خاطفُ الب","رقِ وأين البُروقُ من لمحاته",28,"ت",2,0],["لمح الدهرَ وهو يحبو من المَهْدِ","عليه غَدائرٌ من ليالي",29,"ل",2,0],["لمحمد خير البرية كلها","ذاتا وأوسعهم سنات جودا",30,"د",2,0],["لمحت في كأسي وقد شعشعت","طيف الأماني والهوى والسنين",31,"ن",1,0],["لَمَحا ذُنوبَهُمُ وَجَمَّعَ شَملَهُم","بَعدَ الشَتاتِ حُنُوُّهُ وَحَنانُهُ",32,"ن",2,0],["لَمَحتُ بِقَلبي مَن هُو القَلبُ كُلُّهُ","فَعايَنتُ مَولىً لا يَليقُ بهِ المِثلٌُ",33,"ل",1,0],["لمحوتَ بالسيف المداد بلحظةٍ","محوَ المداد لحافظ ما يكتبُ",34,"ب",1,0],["لمح يتخذ كسر البيوت جنة","وأى خير عند رب كسر",35,"ر",1,0],["لِمُحمّدٍ والشركُ فرّ وقبحهُ","ساءَ اللعينَ ومُشركيه طرحهُ",36,"ه",1,0],["لمحات روحي عندها","تهدى لمبدعها الخلود",37,"د",1,0],["لِمْ حِلْتُمُ بَيْنَنا وَجِسْمي","كَطَرْفِهَا ذِي الفُتُورِ مُضنَى",38,"ن",2,0],["لمُحَمَّدٍ وُعِدَتْ رعَايَا أحمَدٍ","ألا تَزَالَ زَوَاهِرَ الأَيَّامِ",39,"م",1,0],["لمحة البارقي في","ليلٍ دجوجيٍ ضرير",40,"ر",1,0],["لمحةٌ منه رمتْ","قلبَ المعنّى بسهام",41,"م",1,0],["لَمحت مَرتع المنى وهو غضٌّ","مستجمّ في مهدهِ الثريانِ",42,"ن",1,0],["لِمُحَيّا كُدورَةِ البَدرِ شَكلاً","إِنَّما البَدرُ لا يَجوزُ كَمالَه",43,"ل",2,0],["لم حقرت الملك والدنيا وماذا","كنت ترجين من الأخرى تنالي",44,"ل",2,0],["لِمْ حُرِّمَ الشِعْرُ قلتُ حتى","يُقَادَ قَسْراً لِغَيْرِ أَهْلِه",45,"ه",1,0],["لِمحَبَّتي نَظرِي إليك صيانَتي","بَصَرِي وإمساكي عنِ استبكائه",46,"ا",3,0],["لمحتُه فاستثرتُ كامنةً","أسرع في قيلها من اللمحِ",47,"ح",1,0],["لَمح العُيون يَهز قا","متهُ وَإِن لَم تَمسس",48,"س",1,0],["لمحبكم مسكينكم وفقيركم","فادعوا ألحوا سادتي لا تضجروا",49,"ر",3,0],["لِمُحبِّهِ دارُ البَقا","ولِمَنْ يُعاديهِ الجحيمُ",50,"م",1,0],["لمحطِّم الرّدْنِ الرّماح وقد غَدا","لِلنّقعِ مِن فوق الرّماح رواقُ",51,"ق",1,0],["لمحنا بك الآمال تجنى ثمارها","كما نتمنّاها فهلْ أنتَ لامح",52,"ح",1,0],["لمحضر ويا له","من محشر ما أوعره",53,"ر",2,0],["لمح اثنتين كأنما احداهما","لا تعرف الأخرى فتأتلفان",54,"ن",1,0],["لمُحمَّدٍ مجْدِ المُلوك فتى النَّدى","والبأسِ مأوى المُرْمِلين العُيَّلِ",55,"ل",1,0],["لَمُحَسِّنِ بنِ المِلحِ خَطوٌ ضَيِّقٌ","في المَكرُماتِ وَواسِعٌ في التيهِ",56,"ي",2,1],["لِمُحَسِّنِ بِنِ المِلحِ مَنزِلَةٌ","في البُخلِ خارِجَةٌ عَنِ الحَدِّ",57,"د",1,1],["لمحتُ ما نظموه لمحَ مُعتبِرِ","فكانَ نظماً به عن دينهِ مرقوا",58,"ق",3,0],["لَمَحَتْ بهِ الصحراءُ هيأةَ فارسٍ","عَبَرَ الجحيمَ وجاءَها من هَوْلِهِ",59,"ل",2,0],["لمحات أسرار الرجا","ل الجامعين لفرق سري",60,"ر",2,0],["لمحات تلوح من نور أمر","وبقاء الجميع في اللمحات",61,"ت",1,0],["لِمحَمّدٍ في المَجْدَ مُعْجِزُ سُؤْدَدٍ","عَجزَتْ بِهِ الأَيّامُ عَنْ أَمْثالِهِ",62,"ل",2,0],["لمُحَمَّدِ بنِ القاسِمِ الكَرَمُ الذي","وَردتهُ آمالُ العُفاةِ شُرُوعا",63,"ع",2,0],["لِمَحمود المَعالي وَالمَكارمْ","سَليل السادة الطهر الأَكارمْ",64,"م",1,1],["لم حُلتَ بَينَ الَّذي يَهواه مُعتَدياً","وَبينَ مَحبوبه هَذا هوَ العجبُ",65,"ب",1,0],["لِمحمَّدٍ نجلِ ابن مالكٍ الرّضَى","الطّاهر الأعراضِ والأثوابِ",66,"ب",1,0],["لِمُحيَّاهُ المُحيّا رَوْنَقٌ","يا لَقَلْبِي ولِذاكَ الرَّوْنَقِ",67,"ق",1,0],["لمحمدِ بنِ جُزَيِّ آيةُ سُؤددٍ","قد ظَلَّ في العَليا بِها مُتَمَيِّزا",68,"ز",2,0],["لمحتْ آيَها المدا","معُ مَحْوَ الصَّحائف",69,"ف",1,0],["لَمَحَتها فَاِستَخَفَّت نَحوَها","عَجَلاً ثُمَّ أَحالَت تَنتَسِف",70,"ف",1,0],["لم حيلٌ على الخصمين تجري","فتأكل مثل آلات النشاره",71,"ر",2,0],["لمحة ثم بشرت بقدوم","وتداعى أعداؤها للأفول",72,"ل",1,0],["لمحمّد بن أبي المعمّر شيمة","مطبوعةٌ من جوهر الإِحسان",73,"ن",1,0],["لمحمد بن معمر قدمٌ","تَعلو العُلى وعلى المُلوك يَدُ",74,"د",1,0],["لمحمّد بن معمّر في يَعرُبٍ","عليا خُؤولٍ مجدَها وفخارَها",75,"ا",1,0],["لمحمد بن أَبي الحسَين مَحَاسنٌ","كالنُّور بلّلَهُ النَّدى فَتَفتّحا",76,"ح",2,0],["لمحمّد بن معمر عَمُرْت لنا","سُبلُ المنافعِ في الطَّريق المهيعِ",77,"ع",1,0],["لمُحَمّد الزَّاكي ونبْهان الرِّضى","وأَبي الحُسَيْن اللَّوذَعيّ الأَبلَجِ",78,"ج",1,0],["لمحى اللهُ به عنه الإِثاما","وله من حسناتٍ كتبا",79,"ب",2,0],["لمحرابٍ من البلور عالٍ","يتيه على الخورنق والسدير",80,"ر",1,0],["لمحنا في صفاتك مجد سعدٍ","وللأقمار في الشمس التماح",81,"ح",1,0],["لمحضتكم ودي بلاعج لوعةٍ","مكثت وسافح عبرةٍ لا تمكث",82,"ث",1,0],["لمحمد عبد الرحيم وحزبه","والسالكين طريقه والمقتدي",83,"د",2,0],["لمحمد علم العلوم باسرها","لأخ التقى الفياض غيث ان هما",84,"م",2,0],["لمحمد أهدي الهناء بحلية","ابدت محاسن اوجه الأبرار",85,"ر",1,1],["لِمَ حِزبُ الدُستورِ يَهدِمُ دُستو","راً أَقَمناهُ بَعدَ جُهدٍ جَهيدِ",86,"د",1,0],["لمحبٍ قد تفانى","فيك حباً واِفتتانا وعباده",87,"ه",1,0],["لِمحمد يَوم كَيوم محمد","أحَزانه تَبقى مدى الأَحقاب",88,"ب",1,0],["لَمَحن عَلى وَجهي حِماية ضَيغم","وَجُرأة مِقدام وَسَطوة باسل",89,"ل",1,0],["لمح الخصم شخصه من بَعيد","فهو للرعب منه في زلزال",90,"ل",1,0],["لمحمد رضوان ذى ال","مجد المؤثل والسناء",91,"ا",2,0],["لِمَحمولَةٍ في الفلكِ مِن جَنَّةِ المُنى","قَد أوصيَ نوحٌ غَرسَها وَضُمامها",92,"م",3,0],["لمحب وَوَلي","هُوَ سَيف ذو مَودة",93,"ه",1,0],["لَمحت مِنهُ لَمحة فَأَرتنا","منهَجاً واضِحاً وَبانَ السَبيل",94,"ل",1,0],["لَمَحت لَهُ مِن نور وَجهك لمحة","فَغدت لِشوال هِلالاً بادي",95,"د",2,0],["لِمُحب ما تَولى","عَثَرت رجل جَواده",96,"ه",1,0],["لمحمودنا في رياض التهاني","مسرات افراح صفو الزمان",97,"ن",1,1],["لمحن الزّمانُ بصرفكمْ خبرا فعا","بُوهُ وعدُّوهُ من اللّكناء",98,"ا",2,0],["لمحت ركبك بالاجلال يقترب","وأنت كالبدر سارت حوله الشهب",99,"ب",1,1],["لمحبوبي علي الدهر حقُّ","رِضا إذ سار في البيداءِ حِقُّ",100,"ق",1,0],["لمحتكِ في الماء مثل الملاك","حين لحتِ",101,"ت",1,0],["لمحمد الذكرى عليِّ السعد مَن","قال القبولُ له احتكم وأعزم ورمْ",102,"م",1,1],["لمحمدٍ عالي المراتب رونق","في كل مكرمة وصدق أكبر",103,"ر",1,0],["لمحمَّد بن المُصطَفى وَالمُجتَبى","هَذا لِدنيائي