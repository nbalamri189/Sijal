{"poems":[[77,"لمحبرة البني وقف يقوتها","https://www.aldiwan.net/poem35847.html","الطويل"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[77,"يا مصطفى الرحمان والنور الذي","https://www.aldiwan.net/poem36534.html","الكامل"],[77,"نبه نديمك للصبوح وهاتها","https://www.aldiwan.net/poem36703.html","الكامل"],[9,"أرقت وما هذا السهاد المؤرق","https://www.aldiwan.net/poem21956.html","الطويل"],[86,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[86,"لمحت من مصر ذاك التاج والقمرا","https://www.aldiwan.net/poem68954.html","البسيط"],[86,"لمحت جلال العيد والقوم هيب","https://www.aldiwan.net/poem68955.html","الطويل"],[73,"لا افتنان كافتناني","https://www.aldiwan.net/poem11970.html","مجزوء الرمل"],[88,"تبلج أفق الشرق من بعدما اغبرا","https://www.aldiwan.net/poem44824.html","الطويل"],[72,"نجوم تراعيها جفون سوافح","https://www.aldiwan.net/poem18485.html","الطويل"],[51,"من ذا رأت عيناه مثلي في الشجا","https://www.aldiwan.net/poem9239.html","الرجز"],[85,"نراوح بالحوادث أو نغادى","https://www.aldiwan.net/poem8105.html","الوافر"],[45,"أهلا بذالكم الخيال المقبل","https://www.aldiwan.net/poem65577.html","الكامل"],[61,"لمحة البارق من حيث لمح","https://www.aldiwan.net/poem51745.html","الرمل"],[44,"أسقى طلولهم أجش هزيم","https://www.aldiwan.net/poem30341.html","الكامل"],[105,"علم الجهاد لك التحية من فتى","https://www.aldiwan.net/poem43375.html","الكامل"],[50,"أنجزي يا سلامة الموعودا","https://www.aldiwan.net/poem63951.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85557","الكامل"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/55693","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202701","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54712","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55041","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54314","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54210","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54299","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[77,"هاجتك إذ جئت اللوى فزرودا","https://www.poetsgate.com/ViewPoem.aspx?id=34092",""],[94,"يا جارتي","https://www.poetsgate.com/ViewPoem.aspx?id=15618",""],[144,"أما الزمان ففي يديك عنانه","https://www.aldiwan.net/poem11830.html","الكامل"],[151,"لعمري لقد ذقت الهوى فوجدته","https://www.aldiwan.net/poem68554.html","الطويل"],[161,"يا أيها الملك الذي لا يغلب","https://www.aldiwan.net/poem58818.html","الكامل"],[161,"يوم سرور وشفاء صدر","https://www.aldiwan.net/poem59024.html","الرجز"],[190,"أقبل على مدح النبي مفخما","https://www.aldiwan.net/poem35104.html","الكامل"],[212,"قصر الرشيد رأيته","https://www.aldiwan.net/poem46778.html","مجزوء الكامل"],[276,"لبانة المستهام لبنى","https://www.aldiwan.net/poem25508.html","مخلع البسيط"],[276,"بيني ثلاثا سلوة الأيام","https://www.aldiwan.net/poem25529.html","الكامل"],[299,"من وراء السحب فوق البح","https://www.aldiwan.net/poem36798.html","عموديه"],[299,"لاح في جنح الظلام","https://www.aldiwan.net/poem36799.html","عموديه"],[306,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[321,"لا تقل همت في ضياء الغزال","https://www.aldiwan.net/poem67214.html","الخفيف"],[343,"كسف هذي تراها ام ليالي","https://www.aldiwan.net/poem55324.html","الرمل"],[349,"وسائل قال لي ومثلي","https://www.aldiwan.net/poem20656.html","مخلع البسيط"],[365,"لولا رجائي ثانيا للقائه","https://www.aldiwan.net/poem61006.html","الكامل"],[372,"مازحت بالحب ضامر الكشح","https://www.aldiwan.net/poem57512.html","المنسرح"],[381,"قد رق برق الحندس","https://www.aldiwan.net/poem48809.html","مجزوء الكامل"],[392,"وصل الكتاب مسجع ومحرر","https://www.aldiwan.net/poem54571.html","عموديه"],[403,"حتام عن جهل تلوم","https://www.aldiwan.net/poem46981.html","مجزوء الكامل"],[403,"لو كان يعلم أنها الأحداق","https://www.aldiwan.net/poem46984.html","الكامل"],[417,"نعم ما لهذا الأمر غيرك صالح","https://www.aldiwan.net/poem54137.html","الطويل"],[442,"ليتني كنت شجره","https://www.aldiwan.net/poem14371.html","مجزوء الرجز"],[444,"لله رب العرش والأكوان","https://www.aldiwan.net/poem56035.html","عموديه"],[462,"يا عاقدا وضن الجمال البزل","https://www.aldiwan.net/poem16248.html","الكامل"],[469,"لمحسن بن الملح خطو ضيق","https://www.aldiwan.net/poem59542.html","الكامل"],[469,"لمحسن بن الملح منزلة","https://www.aldiwan.net/poem60232.html","أحذ الكامل"],[478,"قد خان أهل الهوى قل لي بمن أثق","https://www.aldiwan.net/poem15254.html","البسيط"],[545,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[559,"الله أنزل حكم أمري","https://www.aldiwan.net/poem34521.html","مجزوء الكامل"],[559,"أنا كل الوجود والكائنات","https://www.aldiwan.net/poem34732.html","الخفيف"],[587,"لو رمت إبقاء الوداد بحاله","https://www.aldiwan.net/poem17687.html","الكامل"]],"verses":[["لِمِحْبَرَةِ البُنّيِّ وقْفٌ يَقوتُها","إذا ما شكَتْ برْحَ الأوامِ تَراقِيها",0,"ه",2,1],["لَمَحُوكَ يَا بَدْرَ الْكَمَالِ فكَبَّرُوا","وَبَدَا هِلاَلُكَ بَعْدَ ذَاكَ فَهَلَّلُوا",1,"ل",3,0],["لمُحمّدٌ خيْرُ البريّةِ كلِّها","ذاتاً وأوْسَعَهُمْ لِعافٍ جُودا",2,"د",2,0],["لِمُحَمَّدِ بْنِ أَبِي الْوَلِيدِ شَمَائِلٌ","غُرٌّ بَدَتْ وَالْحُسْنُ بَعْضُ صِفَاتِهَا",3,"ت",3,0],["لَمَحقوقَةٌ أَن تَستَجيبي لِصَوتِهِ","وَأَن تَعلَمي أَنَّ المُعانَ مُوَفَّقُ",4,"ق",1,0],["لَمحَةً يَسعَدُ الصَديقانِ فيها","بِاِجتِماعٍ وَيَلتَقي العاشِقانِ",5,"ن",1,0],["لَمَحتُ مِن مِصرَ ذاكَ التاجَ وَالقَمَرا","فَقُلتُ لِلشِعرِ هَذا يَومُ مَن شَعَرا",6,"ر",2,1],["لَمَحتُ جَلالَ العيدِ وَالقَومُ هُيَّبُ","فَعَلَّمَني آيَ العُلا كَيفَ تُكتَبُ",7,"ب",1,1],["لِمُحِبٍّ في حَبيبٍ","عَنهُ ناءٍ مِنهُ دانِ",8,"ن",1,0],["لمحت تباشير المنى من خلاله","ضئالاً كمهوك غدا يشتكي الضُرّا",9,"ر",2,0],["لمحتك للبين المصادف لمحةً","فطاحت بأحشائي إليك الطوائح",10,"ح",1,0],["لمحسنٍ أسلفني فروَّجا","أيسرُ ما استوجب أن يُتوَّجا",11,"ج",2,0],["لَمَحنا الحَظَّ ناحِيَةً فَلَمّا","بَلَغناها أَحَسَّ بِنا فَحادا",12,"د",2,0],["لِمُحَمَّدِ بنِ عَلِيٍِّ الشَرَفُ الَّذي","لا يَرمُقُ الجَوزاءَ إِلّا مِن عَلِ",13,"ل",1,0],["لَمحةُ البارقِ من حيثُ لَمحْ","طَمَحَتْ للشَّوقِ وَهْناً فطَمَحْ",14,"ح",1,1],["لِمُحَمَّدِ بنِ الهَيثَمِ بنِ شُبانَةٍ","مَجدٌ إِلى جَنبِ السماكِ مُقيمُ",15,"م",1,0],["لَمَحَتكَ مِصرُ فَأَبصَرتَ آمالَها","تَمشي عَلى السَنَنِ السَوِيِّ وَتَدأَبُ",16,"ب",1,0],["لِمُحِبٍّ عَلى المَوَدَّةِ باكٍ","أَو يَكونَ الصَنيعُ مِنكُم سَديدا",17,"د",2,0],["لم حولك الأرض الوسيعة أقفرت","والماء منك هناك غير ثماد",18,"د",1,0],["لمحت على بُعد اشارة صاحب","ينادي أن ارْجع وهو بالثوب مُلمِع",19,"ع",1,0],["لمحتربٍ مِنَ الأبطال فادٍ","يخاف الدهرُ أن يَلقى عُرامهْ",20,"م",2,0],["لمح الشقى يد العناية والرخى","خَفَضا الجناح لمستغاثُ مُصرِخِ",21,"خ",1,0],["لمح كلمح البياض","من العيون الكحيلة",22,"ه",1,0],["لَمَحَتْ فَوْزُ لَمْحَةً أَعْجَبَتْهَا","فَأَشَارَتْ إِلَى سُعَادَ وَهِنْدَ",23,"د",1,0],["لَمَحْتُ مِنْكَ جَفاءً","فَاسْلَمْ وَكُنْ خَيْرَ جَافِ",24,"ف",1,1],["لَمحَةٌ مِن سَناهُ مِصباحُ لَيلي","وَدُعاء مِن فيهِ مِفتاحُ كنزي",25,"ز",2,0],["لَمحَ البِشْرُ باسماً بالأماني","وشدا الصفوُ صادحاً بالأغاني",26,"ن",2,1],["لَمَحُوا عِزَّةً وشَامُوا بِكَفَّيْك","غَمَاماً هَتَّانةً أَنْدَاؤه",27,"ا",3,0],["لَمَحاتٌ كأنّها خاطفُ الب","رقِ وأين البُروقُ من لمحاته",28,"ت",2,0],["لمح الدهرَ وهو يحبو من المَهْدِ","عليه غَدائرٌ من ليالي",29,"ل",2,0],["لمحمد خير البرية كلها","ذاتا وأوسعهم سنات جودا",30,"د",2,0],["لمحت في كأسي وقد شعشعت","طيف الأماني والهوى والسنين",31,"ن",1,0],["لَمَحا ذُنوبَهُمُ وَجَمَّعَ شَملَهُم","بَعدَ الشَتاتِ حُنُوُّهُ وَحَنانُهُ",32,"ن",2,0],["لَمَحتُ بِقَلبي مَن هُو القَلبُ كُلُّهُ","فَعايَنتُ مَولىً لا يَليقُ بهِ المِثلٌُ",33,"ل",1,0],["لمحوتَ بالسيف المداد بلحظةٍ","محوَ المداد لحافظ ما يكتبُ",34,"ب",1,0],["لمح يتخذ كسر البيوت جنة","وأى خير عند رب كسر",35,"ر",1,0],["لِمُحمّدٍ والشركُ فرّ وقبحهُ","ساءَ اللعينَ ومُشركيه طرحهُ",36,"ه",1,0],["لمحات روحي عندها","تهدى لمبدعها الخلود",37,"د",1,0],["لِمْ حِلْتُمُ بَيْنَنا وَجِسْمي","كَطَرْفِهَا ذِي الفُتُورِ مُضنَى",38,"ن",2,0],["لمُحَمَّدٍ وُعِدَتْ رعَايَا أحمَدٍ","ألا تَزَالَ زَوَاهِرَ الأَيَّامِ",39,"م",1,0],["لمحة البارقي في","ليلٍ دجوجيٍ ضرير",40,"ر",1,0],["لمحةٌ منه رمتْ","قلبَ المعنّى بسهام",41,"م",1,0],["لَمحت مَرتع المنى وهو غضٌّ","مستجمّ في مهدهِ الثريانِ",42,"ن",1,0],["لِمُحَيّا كُدورَةِ البَدرِ شَكلاً","إِنَّما البَدرُ لا يَجوزُ كَمالَه",43,"ل",2,0],["لم حقرت الملك والدنيا وماذا","كنت ترجين من الأخرى تنالي",44,"ل",2,0],["لِمْ حُرِّمَ الشِعْرُ قلتُ حتى","يُقَادَ قَسْراً لِغَيْرِ أَهْلِه",45,"ه",1,0],["لِمحَبَّتي نَظرِي إليك صيانَتي","بَصَرِي وإمساكي عنِ استبكائه",46,"ا",3,0],["لمحتُه فاستثرتُ كامنةً","أسرع في قيلها من اللمحِ",47,"ح",1,0],["لَمح العُيون يَهز قا","متهُ وَإِن لَم تَمسس",48,"س",1,0],["لمحبكم مسكينكم وفقيركم","فادعوا ألحوا سادتي لا تضجروا",49,"ر",3,0],["لِمُحبِّهِ دارُ البَقا","ولِمَنْ يُعاديهِ الجحيمُ",50,"م",1,0],["لمحطِّم الرّدْنِ الرّماح وقد غَدا","لِلنّقعِ مِن فوق الرّماح رواقُ",51,"ق",1,0],["لمحنا بك الآمال تجنى ثمارها","كما نتمنّاها فهلْ أنتَ لامح",52,"ح",1,0],["لمحضر ويا له","من محشر ما أوعره",53,"ر",2,0],["لمح اثنتين كأنما احداهما","لا تعرف الأخرى فتأتلفان",54,"ن",1,0],["لمُحمَّدٍ مجْدِ المُلوك فتى النَّدى","والبأسِ مأوى المُرْمِلين العُيَّلِ",55,"ل",1,0],["لَمُحَسِّنِ بنِ المِلحِ خَطوٌ ضَيِّقٌ","في المَكرُماتِ وَواسِعٌ في التيهِ",56,"ي",2,1],["لِمُحَسِّنِ بِنِ المِلحِ مَنزِلَةٌ","في البُخلِ خارِجَةٌ عَنِ الحَدِّ",57,"د",1,1],["لمحتُ ما نظموه لمحَ مُعتبِرِ","فكانَ نظماً به عن دينهِ مرقوا",58,"ق",3,0],["لَمَحَتْ بهِ الصحراءُ هيأةَ فارسٍ","عَبَرَ الجحيمَ وجاءَها من هَوْلِهِ",59,"ل",2,0],["لمحات أسرار الرجا","ل الجامعين لفرق سري",60,"ر",2,0],["لمحات تلوح من نور أمر","وبقاء الجميع في اللمحات",61,"ت",1,0],["لِمحَمّدٍ في المَجْدَ مُعْجِزُ سُؤْدَدٍ","عَجزَتْ بِهِ الأَيّامُ عَنْ أَمْثالِهِ",62,"ل",2,0]]}