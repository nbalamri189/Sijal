{"poems":[[77,"لمحبرة البني وقف يقوتها","https://www.aldiwan.net/poem35847.html","الطويل"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[77,"يا مصطفى الرحمان والنور الذي","https://www.aldiwan.net/poem36534.html","الكامل"],[77,"نبه نديمك للصبوح وهاتها","https://www.aldiwan.net/poem36703.html","الكامل"],[9,"أرقت وما هذا السهاد المؤرق","https://www.aldiwan.net/poem21956.html","الطويل"],[86,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[86,"لمحت من مصر ذاك التاج والقمرا","https://www.aldiwan.net/poem68954.html","البسيط"],[86,"لمحت جلال العيد والقوم هيب","https://www.aldiwan.net/poem68955.html","الطويل"],[73,"لا افتنان كافتناني","https://www.aldiwan.net/poem11970.html","مجزوء الرمل"],[88,"تبلج أفق الشرق من بعدما اغبرا","https://www.aldiwan.net/poem44824.html","الطويل"],[72,"نجوم تراعيها جفون سوافح","https://www.aldiwan.net/poem18485.html","الطويل"],[51,"من ذا رأت عيناه مثلي في الشجا","https://www.aldiwan.net/poem9239.html","الرجز"],[85,"نراوح بالحوادث أو نغادى","https://www.aldiwan.net/poem8105.html","الوافر"],[45,"أهلا بذالكم الخيال المقبل","https://www.aldiwan.net/poem65577.html","الكامل"],[61,"لمحة البارق من حيث لمح","https://www.aldiwan.net/poem51745.html","الرمل"],[44,"أسقى طلولهم أجش هزيم","https://www.aldiwan.net/poem30341.html","الكامل"],[105,"علم الجهاد لك التحية من فتى","https://www.aldiwan.net/poem43375.html","الكامل"],[50,"أنجزي يا سلامة الموعودا","https://www.aldiwan.net/poem63951.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85557","الكامل"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/55693","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202701","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54712","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55041","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54314","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54210","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54299","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[77,"هاجتك إذ جئت اللوى فزرودا","https://www.poetsgate.com/ViewPoem.aspx?id=34092",""]],"verses":[["لِمِحْبَرَةِ البُنّيِّ وقْفٌ يَقوتُها","إذا ما شكَتْ برْحَ الأوامِ تَراقِيها",0,"ه",2,1],["لَمَحُوكَ يَا بَدْرَ الْكَمَالِ فكَبَّرُوا","وَبَدَا هِلاَلُكَ بَعْدَ ذَاكَ فَهَلَّلُوا",1,"ل",3,0],["لمُحمّدٌ خيْرُ البريّةِ كلِّها","ذاتاً وأوْسَعَهُمْ لِعافٍ جُودا",2,"د",2,0],["لِمُحَمَّدِ بْنِ أَبِي الْوَلِيدِ شَمَائِلٌ","غُرٌّ بَدَتْ وَالْحُسْنُ بَعْضُ صِفَاتِهَا",3,"ت",3,0],["لَمَحقوقَةٌ أَن تَستَجيبي لِصَوتِهِ","وَأَن تَعلَمي أَنَّ المُعانَ مُوَفَّقُ",4,"ق",1,0],["لَمحَةً يَسعَدُ الصَديقانِ فيها","بِاِجتِماعٍ وَيَلتَقي العاشِقانِ",5,"ن",1,0],["لَمَحتُ مِن مِصرَ ذاكَ التاجَ وَالقَمَرا","فَقُلتُ لِلشِعرِ هَذا يَومُ مَن شَعَرا",6,"ر",2,1],["لَمَحتُ جَلالَ العيدِ وَالقَومُ هُيَّبُ","فَعَلَّمَني آيَ العُلا كَيفَ تُكتَبُ",7,"ب",1,1],["لِمُحِبٍّ في حَبيبٍ","عَنهُ ناءٍ مِنهُ دانِ",8,"ن",1,0],["لمحت تباشير المنى من خلاله","ضئالاً كمهوك غدا يشتكي الضُرّا",9,"ر",2,0],["لمحتك للبين المصادف لمحةً","فطاحت بأحشائي إليك الطوائح",10,"ح",1,0],["لمحسنٍ أسلفني فروَّجا","أيسرُ ما استوجب أن يُتوَّجا",11,"ج",2,0],["لَمَحنا الحَظَّ ناحِيَةً فَلَمّا","بَلَغناها أَحَسَّ بِنا فَحادا",12,"د",2,0],["لِمُحَمَّدِ بنِ عَلِيٍِّ الشَرَفُ الَّذي","لا يَرمُقُ الجَوزاءَ إِلّا مِن عَلِ",13,"ل",1,0],["لَمحةُ البارقِ من حيثُ لَمحْ","طَمَحَتْ للشَّوقِ وَهْناً فطَمَحْ",14,"ح",1,1],["لِمُحَمَّدِ بنِ الهَيثَمِ بنِ شُبانَةٍ","مَجدٌ إِلى جَنبِ السماكِ مُقيمُ",15,"م",1,0],["لَمَحَتكَ مِصرُ فَأَبصَرتَ آمالَها","تَمشي عَلى السَنَنِ السَوِيِّ وَتَدأَبُ",16,"ب",1,0],["لِمُحِبٍّ عَلى المَوَدَّةِ باكٍ","أَو يَكونَ الصَنيعُ مِنكُم سَديدا",17,"د",2,0],["لم حولك الأرض الوسيعة أقفرت","والماء منك هناك غير ثماد",18,"د",1,0],["لمحت على بُعد اشارة صاحب","ينادي أن ارْجع وهو بالثوب مُلمِع",19,"ع",1,0],["لمحتربٍ مِنَ الأبطال فادٍ","يخاف الدهرُ أن يَلقى عُرامهْ",20,"م",2,0],["لمح الشقى يد العناية والرخى","خَفَضا الجناح لمستغاثُ مُصرِخِ",21,"خ",1,0],["لمح كلمح البياض","من العيون الكحيلة",22,"ه",1,0],["لَمَحَتْ فَوْزُ لَمْحَةً أَعْجَبَتْهَا","فَأَشَارَتْ إِلَى سُعَادَ وَهِنْدَ",23,"د",1,0],["لَمَحْتُ مِنْكَ جَفاءً","فَاسْلَمْ وَكُنْ خَيْرَ جَافِ",24,"ف",1,1],["لَمحَةٌ مِن سَناهُ مِصباحُ لَيلي","وَدُعاء مِن فيهِ مِفتاحُ كنزي",25,"ي",1,0],["لَمحَ البِشْرُ باسماً بالأماني","وشدا الصفوُ صادحاً بالأغاني",26,"ن",2,1],["لَمَحُوا عِزَّةً وشَامُوا بِكَفَّيْك","غَمَاماً هَتَّانةً أَنْدَاؤه",27,"ا",3,0],["لَمَحاتٌ كأنّها خاطفُ الب","رقِ وأين البُروقُ من لمحاته",28,"ت",2,0],["لمح الدهرَ وهو يحبو من المَهْدِ","عليه غَدائرٌ من ليالي",29,"ل",2,0],["لمحمد خير البرية كلها","ذاتا وأوسعهم سنات جودا",30,"د",2,0]]}