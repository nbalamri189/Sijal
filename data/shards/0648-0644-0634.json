{"poems":[[53,"ملك النفاق طباعه فتثعلبا","https://www.aldiwan.net/poem8513.html","الكامل"],[53,"لا تشم للمزن برقا","https://www.aldiwan.net/poem65494.html","مجزوء الرمل"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[91,"انما نهضة الامم","https://www.aldiwan.net/poem44855.html","مجزوء الخفيف"],[50,"إن كان يحيى يقدر","https://www.aldiwan.net/poem66289.html","المجتث"],[48,"بئس الشهادة إذا سألت شهادة","https://www.aldiwan.net/poem22889.html","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21130","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54516","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54714","الكامل"],[20,"ولشؤم البغي والنغشم قدما","http://www.aldiwanalarabi.com/poemDescription.do?poemId=502613",""],[190,"وقائلة أطلت النوم صلي","https://www.aldiwan.net/poem43641.html","الوافر"],[190,"مجزوء الخفيف","https://www.aldiwan.net/poem43743.html","مجزوء الخفيف"],[210,"أهدي لذي المجد الرفيع وذي الصفا","https://www.aldiwan.net/poem921.html",""],[214,"قسما بحفظ عهودكم وودادي","https://www.aldiwan.net/poem13298.html","الطويل"],[214,"أعريب ذاك الحي من يبرين","https://www.aldiwan.net/poem13559.html","الكامل"],[266,"هذي ربى الأثلات من يبرين","https://www.aldiwan.net/poem38165.html","الكامل"],[409,"ما على الصب في الصبابة وصمه","https://www.aldiwan.net/poem33405.html","الخفيف"],[445,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[458,"أمسائل القدر العتي محيرا","https://www.aldiwan.net/poem61571.html","الكامل"],[505,"منن الرفاعي الرفيع الهمة","https://www.aldiwan.net/poem37634.html","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64037","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55936","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144093","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46641",""],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111807","الرمل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104694","الكامل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110630","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93540","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107008","الكامل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/83049","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58283","الكامل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127395","الكامل"],[3003,"","https://poetry.dctabudhabi.ae/diwan/poem/126538","الكامل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109923","الخفيف"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95371","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127081","الخفيف"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93259","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90882","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90831","الرمل"],[4942,"رتلتُ حسنَكِ","https://www.poetsgate.com/ViewPoem.aspx?id=188279",""],[585,"حتام تطمع أن تبل غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=161928",""],[585,"مهلاً فلست بجاحدٍ أو عات","https://www.poetsgate.com/ViewPoem.aspx?id=161934",""],[585,"نظر المشيب إليك قبل أوان","https://www.poetsgate.com/ViewPoem.aspx?id=161877",""],[585,"لمع اللجين وسال ذوب العسجد","https://www.poetsgate.com/ViewPoem.aspx?id=161875",""],[585,"لمن الضارب في ظلال الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=161910",""],[5186,"\"كم حلالي في \"\"آديسون\"\" و\"\"مركو","https://www.poetsgate.com/ViewPoem.aspx?id=156490",""],[5186,"\"أصلح الله يا \"\"أسيمى\"\" عقولا","https://www.poetsgate.com/ViewPoem.aspx?id=156507",""],[5199,"رابطة عبس العالميه","https://www.poetsgate.com/ViewPoem.aspx?id=150974",""],[5302,"يا عجولا","https://www.poetsgate.com/ViewPoem.aspx?id=201222",""],[3294,"وجه الحقيقة دونه أستار","https://www.poetsgate.com/ViewPoem.aspx?id=173270",""],[5526,"قمة طويق","https://www.poetsgate.com/ViewPoem.aspx?id=198731",""],[5691,"ياقوتة...!","https://www.poetsgate.com/ViewPoem.aspx?id=207971",""],[5751,"رسْمٌ بذاكرةِ اللَّيلَك","https://www.poetsgate.com/ViewPoem.aspx?id=214774",""],[5833,"حميا الكأس","https://www.poetsgate.com/ViewPoem.aspx?id=197004",""],[6023,"والصباح استعار من هجر حبِّي","https://www.poetsgate.com/ViewPoem.aspx?id=123863",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[6315,"قَبائلُ النِّسْرِين !! هامشٌ على قرطاسِ المُتَنَبّي ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87575&r=&rc=0",""]],"verses":[["ولَشرُّ من جرَّبتَهُ في حاجةٍ","من لا تزال به مُعنَّىً مُتعبَا",0,"ب",2,0],["ولشتّان لعمري","بين من يهوي ويرقى",1,"ق",2,0],["ولَشعرٌ فيه مديحُك أحلى","من رقيق النسيب في الألحان",2,"ن",1,0],["ولشعب اصابه الحيف","بالعلم معتصم",3,"م",1,0],["ولشغةٍ وخناثٍ","وطيٍّ كشح مخصّر",4,"ر",1,0],["وَلِشَرُّ أَصحابِ الرِجالِ عِصابَةٌ","تُعطيكَ دونَ ثِيابِها أَعراضَها",5,"ض",3,0],["ولشُؤم البَغي والغشم قِدماً","ما خَلاَ جَوفٌ وَلم يَبَق حِمَار",6,"ر",1,1],["وَلَشِكَّةُ الأَلْوَانِ حَوْلَكِ","كَالنِّصَاعِ الشُّرَّعِ",7,"ع",1,0],["وَلَشَدَّ مَا سُرَّتْ بِهَ","ذَا الضَيْفِ لَيْلَى حِينَ جاءْ",8,"ا",2,0],["وَلِشَيْخِهِ فَضْلُ انْبِعَا","ثِ حُمَاتِهِ شِيباً وَمُرْدَا",9,"د",2,0],["ولشُؤم البَغي والنغشم قِدماً","ما خَلاَ جَوفٌ وَلم يَبَق حِمَار",10,"ر",1,1],["ولشكروز مع موسى بباذا","وشاشنكير ذو الأمر المطاع",11,"ع",1,0],["ولشؤمي وحرفتي","شخت في أرض عكبرا",12,"ر",2,0],["ولشيخنا المفضال ألف تحيّةٍ","بأريجها العود الرّطيب تشرّفا",13,"ف",2,0],["ولشقوتي في الحب قد عزّ الرقا","لما تناءيتم وعز رقادي",14,"د",2,0],["ولشقوتي اصبحت صفر الكف كالمم","نوع من صرف عن التنوين",15,"ن",1,0],["ولشذان تصفو معيشة إمر","جبلت جبلة خلقه من طين",16,"ن",1,0],["ولشابهت فرقة في أزال","تركوا منهج الصلاح ورسمه",17,"م",2,0],["ولَشَدَّما مَاجَتْ بِهِ أَمْواجُهُ","حَتَّى أَسالَتْهُ إِلَيْكَ سُيُولُهُ",18,"ل",2,0],["ولشاركوها في الحبور بصحبة","وترنموا معها بشعر الواله",19,"ل",2,0],["ولشأننا سرٌّ يرى جهراً غدا","في موقفٍ ينجو السليم بنيَّةِ",20,"ه",1,0],["ولِشَاهَسْفَرٍ بها مِنْ نداه","نُقَطٌ قُمْنَ في مَقام الشنوف",21,"ف",1,0],["ولشبلك المصباح عمرٌ اكمل","لا مسَّهُ طول المدى تنكيدُ",22,"د",1,0],["ولشمسِ جوّك كيف لم تكسَفْ جوىً","بل كيفَ بعدَ أبي الفوارس تطلُعُ",23,"ع",1,0],["ولشمسِ جوّكَ كيف لم تُكشف جوىً","بل كيف بعد أبي الفوارس تطلُعُ",24,"ع",1,0],["ولشهمٍ ذلَّ والشهمُ انوف","ولنجمٍ بعدَ لألاءٍ أفل",25,"ل",1,0],["وَلِشَخمةِ الأُذنِ الشَّريفَةِ شَعرُهُ","يا طِيبَ نَشرٍ فاحَ مِن ذَاكَ الشَّعَر",26,"ر",1,0],["ولشد ما أبكيت جفن أب","بك ثغر انسه كان يفتر",27,"ر",1,0],["وَلشخصك النائي وَعلمك بَيننا","كُلّ بِعالمه أَراه غَريبا",28,"ب",2,0],["ولشدة الضم الذي أوليتها","أثرت في رمانتي نهديها",29,"ي",3,0],["وَلشعرِ شيخِ المحدَث","ينَ أَبي نواس أو حَبيب",30,"ب",1,0],["وَلِشِقوتي نِمنا مَعاً في مَضَجعٍ","مُتَرَدِيَيْنِ على الثّرى ببساطِ",31,"ط",1,0],["ولشامخ في الراسيا","ت يغيب في ضيق الرجوم",32,"م",1,0],["ولشرعة تهدي الأنام سبيلا","جاء المسيح من الإله رسولا",33,"ا",1,0],["وَلشكلهُ قَبلَ مُضمَرٍ لَينٍ بِمَا","جَانَسَ مِن تَحرُّكِ قَد عُلِمَا",34,"م",2,0],["ولشرحِ النُواحِ عِندي حواشٍ","صَدرُها الصمتُ لا يُطيقُ انشِراحا",35,"ح",2,0],["ولشد جيش العسكر الشرقي أع","راف الجياد بنخل اهل المغرب",36,"ب",1,0],["ولشد العجال هرمس هبا","وبها جد ينهب السهل نهبا",37,"ب",2,0],["ولشمل قد شتته المنايا","ولعين تفيض منها الدماء",38,"ا",2,0],["وَلَشَمَّرَتْ عنها الثّغور وأَصبحت","فيها العواصم وهي غيرُ عواصم",39,"م",1,0],["ولشانه خطب العلاء ومن غدا","للغادة الحسناء كفؤا يخطب",40,"ب",1,0],["ولشمس السعد فيه أصبحت","هالة البدر مقرا واكتنان",41,"ن",1,0],["ولِشهرزادَ حكايةٌ لا تنتهي","قصصٌ لأحلام ِ الغرامِ تُسطَّرُ",42,"ر",1,0],["ولشد ما ارتاد الدليل فلم يجد","غير الحسام لدى الخصام دليلا",43,"ل",2,0],["ولشد ما أمسكت عنك تجلداً","وكتمت ما في النفس من حاجات",44,"ت",1,0],["ولشد ما اختلفت عليك فأصبحت","لك قدوةً في الختل والروغان",45,"ن",1,0],["ولشد ما استوحيت من أسرارها","فتمردت بك شرة المتمرد",46,"د",1,0],["ولشد ما انطوت العصور وما انطوت","للعيش فيك بشاشة الأعياد",47,"د",1,0],["ولشوقي ما كان أوفر حظا","\"من سواه... لولا \"\"سراي الأمير\"\"\"",48,"ر",1,0],["ولشكر المولى على كل فضل","رتلي آي ذكره ترتيلا",49,"ل",2,0],["ولشيخً فارس وابن سمره من الراس ويقول","لله درء ابناء رشيد بمامضى والى بعد",50,"د",1,0],["ولشيطانه العجول تمطى","وعلى سعيه الحثيث تجنى",51,"ن",2,0],["ولشد ما أبصرت أمرا كائنا","لم تختلف في شأنه الأقطار",52,"ر",1,0],["ولَ شاقني من وقتي الهم والضيق","انصى هذاك اللي طليقٍ حجاجه",53,"ج",2,0],["ولَشَدَّتْ وَثاقَهُ كأسيرٍ","ثُمَّ زجَّتْهُ في الكِناسِ اعْتِقالا",54,"ل",2,0],["ولِشَعْرِكِ المُنسابِ طَلَّةُ لَيلَكٍ","أو رِكْضُ خَيلٍ ضَمَّهُنَّ مَساءُ",55,"ا",2,0],["ولشجرة الزيتون ألفُ حكايةٍ","تشدو بهنَّ متى يداعِبها الهَوا!",56,"و",2,0],["ولشيخِ الشُّيوخِ نجلك سَعدٌ","ذو نحوس من مالك الإسعادِ",57,"د",1,0],["ولشاعرٍ يكتظُّ من عَسَلِ النعيمِ","على حسابِ مَرارةِ البؤساءِ",58,"ا",2,0],["وَ لِشَهرَيَارَ زَوَارِقُ القَلَقِ التي","مَخَرَتْ وَرَاءَ الأُمنِيَاتِ سَرَابا",59,"ب",2,0]]}