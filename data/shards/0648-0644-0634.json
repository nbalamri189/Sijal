{"poems":[[51,"ملك النفاق طباعه فتثعلبا","https://www.aldiwan.net/poem8513.html","الكامل"],[51,"لا تشم للمزن برقا","https://www.aldiwan.net/poem65494.html","مجزوء الرمل"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[89,"انما نهضة الامم","https://www.aldiwan.net/poem44855.html","مجزوء الخفيف"],[48,"إن كان يحيى يقدر","https://www.aldiwan.net/poem66289.html","المجتث"],[46,"بئس الشهادة إذا سألت شهادة","https://www.aldiwan.net/poem22889.html","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21130","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54516","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54714","الكامل"],[20,"ولشؤم البغي والنغشم قدما","http://www.aldiwanalarabi.com/poemDescription.do?poemId=502613",""],[187,"وقائلة أطلت النوم صلي","https://www.aldiwan.net/poem43641.html","الوافر"],[187,"مجزوء الخفيف","https://www.aldiwan.net/poem43743.html","مجزوء الخفيف"],[207,"أهدي لذي المجد الرفيع وذي الصفا","https://www.aldiwan.net/poem921.html",""],[211,"قسما بحفظ عهودكم وودادي","https://www.aldiwan.net/poem13298.html","الطويل"],[211,"أعريب ذاك الحي من يبرين","https://www.aldiwan.net/poem13559.html","الكامل"],[262,"هذي ربى الأثلات من يبرين","https://www.aldiwan.net/poem38165.html","الكامل"],[404,"ما على الصب في الصبابة وصمه","https://www.aldiwan.net/poem33405.html","الخفيف"],[440,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[454,"أمسائل القدر العتي محيرا","https://www.aldiwan.net/poem61571.html","الكامل"],[501,"منن الرفاعي الرفيع الهمة","https://www.aldiwan.net/poem37634.html","الكامل"]],"verses":[["ولَشرُّ من جرَّبتَهُ في حاجةٍ","من لا تزال به مُعنَّىً مُتعبَا",0,"ب",2,0],["ولشتّان لعمري","بين من يهوي ويرقى",1,"ق",2,0],["ولَشعرٌ فيه مديحُك أحلى","من رقيق النسيب في الألحان",2,"ن",1,0],["ولشعب اصابه الحيف","بالعلم معتصم",3,"م",1,0],["ولشغةٍ وخناثٍ","وطيٍّ كشح مخصّر",4,"ر",1,0],["وَلِشَرُّ أَصحابِ الرِجالِ عِصابَةٌ","تُعطيكَ دونَ ثِيابِها أَعراضَها",5,"ض",3,0],["ولشُؤم البَغي والغشم قِدماً","ما خَلاَ جَوفٌ وَلم يَبَق حِمَار",6,"ر",1,1],["وَلَشِكَّةُ الأَلْوَانِ حَوْلَكِ","كَالنِّصَاعِ الشُّرَّعِ",7,"ع",1,0],["وَلَشَدَّ مَا سُرَّتْ بِهَ","ذَا الضَيْفِ لَيْلَى حِينَ جاءْ",8,"ا",2,0],["وَلِشَيْخِهِ فَضْلُ انْبِعَا","ثِ حُمَاتِهِ شِيباً وَمُرْدَا",9,"د",2,0],["ولشُؤم البَغي والنغشم قِدماً","ما خَلاَ جَوفٌ وَلم يَبَق حِمَار",10,"ر",1,1],["ولشكروز مع موسى بباذا","وشاشنكير ذو الأمر المطاع",11,"ع",1,0],["ولشؤمي وحرفتي","شخت في أرض عكبرا",12,"ر",2,0],["ولشيخنا المفضال ألف تحيّةٍ","بأريجها العود الرّطيب تشرّفا",13,"ف",2,0],["ولشقوتي في الحب قد عزّ الرقا","لما تناءيتم وعز رقادي",14,"د",2,0],["ولشقوتي اصبحت صفر الكف كالمم","نوع من صرف عن التنوين",15,"ن",1,0],["ولشذان تصفو معيشة إمر","جبلت جبلة خلقه من طين",16,"ن",1,0],["ولشابهت فرقة في أزال","تركوا منهج الصلاح ورسمه",17,"م",2,0],["ولَشَدَّما مَاجَتْ بِهِ أَمْواجُهُ","حَتَّى أَسالَتْهُ إِلَيْكَ سُيُولُهُ",18,"ل",2,0],["ولشاركوها في الحبور بصحبة","وترنموا معها بشعر الواله",19,"ل",2,0],["ولشأننا سرٌّ يرى جهراً غدا","في موقفٍ ينجو السليم بنيَّةِ",20,"ه",1,0]]}