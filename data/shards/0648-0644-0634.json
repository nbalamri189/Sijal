{"poems":[[51,"ملك النفاق طباعه فتثعلبا","https://www.aldiwan.net/poem8513.html","الكامل"],[51,"لا تشم للمزن برقا","https://www.aldiwan.net/poem65494.html","مجزوء الرمل"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[89,"انما نهضة الامم","https://www.aldiwan.net/poem44855.html","مجزوء الخفيف"],[48,"إن كان يحيى يقدر","https://www.aldiwan.net/poem66289.html","المجتث"],[46,"بئس الشهادة إذا سألت شهادة","https://www.aldiwan.net/poem22889.html","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21130","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54516","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54714","الكامل"],[20,"ولشؤم البغي والنغشم قدما","http://www.aldiwanalarabi.com/poemDescription.do?poemId=502613",""]],"verses":[["ولَشرُّ من جرَّبتَهُ في حاجةٍ","من لا تزال به مُعنَّىً مُتعبَا",0,"ب",2,0],["ولشتّان لعمري","بين من يهوي ويرقى",1,"ق",2,0],["ولَشعرٌ فيه مديحُك أحلى","من رقيق النسيب في الألحان",2,"ن",1,0],["ولشعب اصابه الحيف","بالعلم معتصم",3,"م",1,0],["ولشغةٍ وخناثٍ","وطيٍّ كشح مخصّر",4,"ر",1,0],["وَلِشَرُّ أَصحابِ الرِجالِ عِصابَةٌ","تُعطيكَ دونَ ثِيابِها أَعراضَها",5,"ض",3,0],["ولشُؤم البَغي والغشم قِدماً","ما خَلاَ جَوفٌ وَلم يَبَق حِمَار",6,"ر",1,1],["وَلَشِكَّةُ الأَلْوَانِ حَوْلَكِ","كَالنِّصَاعِ الشُّرَّعِ",7,"ع",1,0],["وَلَشَدَّ مَا سُرَّتْ بِهَ","ذَا الضَيْفِ لَيْلَى حِينَ جاءْ",8,"ا",2,0],["وَلِشَيْخِهِ فَضْلُ انْبِعَا","ثِ حُمَاتِهِ شِيباً وَمُرْدَا",9,"د",2,0],["ولشُؤم البَغي والنغشم قِدماً","ما خَلاَ جَوفٌ وَلم يَبَق حِمَار",10,"ر",1,1]]}