{"poems":[[65,"ثنى عطفه للبارق المتأجج","https://www.aldiwan.net/poem46140.html","الطويل"],[60,"صن النفس واحملها على ما يزينها","https://www.aldiwan.net/poem30912.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85575","البسيط"],[164,"لقد أسرفت في بخس حظي وواجبي","https://www.aldiwan.net/poem59002.html","الطويل"],[186,"رعى الله مغنى بالعذيب ومعهدا","https://www.aldiwan.net/poem67081.html","الطويل"],[266,"ما بالتعلل بالأوطان أوطار","https://www.aldiwan.net/poem38320.html","البسيط"],[369,"عداك الحادثات إلى عداكا","https://www.aldiwan.net/poem60815.html","الوافر"],[382,"ذريني فجدي حيثما كنت مرشدي","https://www.aldiwan.net/poem66877.html","الطويل"],[463,"هوى لي وأهواء النفوس ضروب","https://www.aldiwan.net/poem56294.html","الطويل"],[515,"يا جور هذا الدهر من ظالم","https://www.aldiwan.net/poem1590.html",""],[543,"اسال من الأجفان عن صدره نهرا","https://www.aldiwan.net/poem48140.html","عموديه"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48937","الوافر"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87827","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52122","الوافر"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20414","البسيط"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102560","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132619","الوافر"],[3524,"","https://poetry.dctabudhabi.ae/diwan/poem/124598","الطويل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119421","المتقارب"],[4234,"","https://poetry.dctabudhabi.ae/diwan/poem/203440","الوافر"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66118","البسيط"],[144,"تمنى ابن كوز والسفاهةِ كاسمها","https://www.poetsgate.com/ViewPoem.aspx?id=186561",""],[5431,"وليس سوى التحنان عرْفٌ ومذهبُ","https://www.poetsgate.com/ViewPoem.aspx?id=191897",""],[5616,"حبيبتي أنت","https://www.poetsgate.com/ViewPoem.aspx?id=203493",""]],"verses":[["فما اكْتحَلَتْ عَيْني وللبَيْنِ رَوْعَةٌ","بأحْسَنَ منْ يَومِ الوَداعِ وأسمَجِ",0,"ج",1,0],["فَما أَكثَرَ الإِخوان حينَ تَعدّهُم","وَلَكِنَهُم في النائِباتِ قَليلُ",1,"ل",1,0],["فَما اكتتبت دفاعاً ذاع مشتهراً","ألا وأَنتَ مرادي حين اكتتب",2,"ب",1,0],["فما اكلها لحمي ولا شربها دمي","ولا كل ما تجنى على بعائب",3,"ب",1,0],["فَما أَكثرَ الأُلّافَ في كُلِ بَلدةٍ","وَأَكثَرُ قَول الزُورِ مِمَّن تَودَّدا",4,"د",2,0],["فما اكرر مدحي في مواهبه","الا ومنه على التكرار تكرار",5,"ر",1,0],["فما اكتحلَتْ بوَجهِ السَّعْدِ يَوماً","من الدُّنيا سوى عَينٍ تَراكا",6,"ك",2,0],["فما أكثرَ القُصّادَ واللَهُ سؤلُهم","ومن ضل عنها ضل عن كل مقصد",7,"د",1,0],["فما أكثَرَ الإخوانَ بل ما أقلَّهم","على نائباتِ الدهر حين تنوبُ",8,"ب",1,0],["فما اكتفى بالظلم حتى بدا","يُلزمنا الشكرَ على الظلم",9,"م",1,0],["فما اكتََنَز الوادي جَواهِرَهُ عَدا","لِيَنظِمَها دَمعاً فَيَنثُرُها نَثرا",10,"ر",2,0],["فما أكملتُ إلاَّ وهي ظبيٌ","تأسّد وانبرتْ تُعطي جَوابا",11,"ب",2,0],["فَما أَكثَرَ الأَحبابَ في ساعَةِ الغِنى","وَما أَندَرَ الأَصحابَ في ساعَةِ البُؤسِ",12,"س",1,0],["فما اكترثوا بشيء صد عنه","ولا بعثوا إلى الفولاذ أذنا",13,"ن",2,0],["فَما اِكتَسَبنَ رَئيس غَير مُنتَقِصِ","وَلَيسَ فيما تَرى مَن كَسبه طمعُ",14,"ع",1,0],["فما أكثر الأصحاب حين تعدّهم","وما قلهم إن حاولتك النوائب",15,"ب",1,0],["فما أكرمه حرّاً","على عيدية حرّه",16,"ر",2,0],["فما أكثر الامجاد في خير أمة","ولكنما بيت الرسول مجيدها",17,"د",3,0],["فما أكره الطيف في نفسه","ولكنني أكره الوصل زورا",18,"ر",2,0],["فما اكتحلت بنوم قط إلا","بميل في المسافة بعد ميل",19,"ل",1,0],["فَما اكَلَّتْ صُرُوفُ الدَّهْرِ صارِمَنا","وَلا لَوَتْنا عِنِ المَسْعَى الى الكرَمِ",20,"م",1,0],["فما أكبر الأشياء عندي حزازة","بأن أبتَ مزريا عليك وزاريا",21,"ي",2,0],["فما أكثر الآلام حتى كأنها","عرائش في حقل النفوس تُنصَّبُ",22,"ب",1,0],["فما أكلت طعاماً غير ما صنعت","ولا شربت سوى من فيك \"يا بردى\"",23,"د",2,0]]}