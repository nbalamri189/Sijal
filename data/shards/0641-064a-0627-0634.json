{"poems":[[53,"ألوي حيازيمي عليك تحرقا","https://www.aldiwan.net/poem29950.html","الطويل"],[55,"أروني وجه نسرين","https://www.aldiwan.net/poem26047.html","الهزج"],[55,"ألا أسعديني بالدموع السواكب","https://www.aldiwan.net/poem26543.html","الطويل"],[77,"كن من صروف الردى على حذر","https://www.aldiwan.net/poem36441.html","المنسرح"],[86,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[86,"أيحصي معانيك القريض المهذب","https://www.aldiwan.net/poem10695.html","الطويل"],[88,"وقفت على البسفور والريح عاصف","https://www.aldiwan.net/poem44421.html","الطويل"],[91,"يا ميتا فيه جمال الحياة","https://www.aldiwan.net/poem8784.html","عموديه"],[70,"هوانا بالهوى كم ذا التجني","https://www.aldiwan.net/poem42447.html","الوافر"],[85,"خليفة ما جاء حتى ذهبا","https://www.aldiwan.net/poem7913.html","الرجز"],[43,"فديناك من ربع وإن زدتنا كربا","https://www.aldiwan.net/poem9455.html","الطويل"],[74,"سجعت وقد غنى الحمام فرجعا","https://www.aldiwan.net/poem13173.html","الطويل"],[74,"ألا ساجل دموعي ياغمام","https://www.aldiwan.net/poem13249.html","الوافر"],[74,"بذات المكارم ذاك الألم","https://www.aldiwan.net/poem13252.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85435","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39658","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39590","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202547","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54900","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54274","البسيط"],[90,"العزم وأبناؤه","https://www.poetsgate.com/ViewPoem.aspx?id=178926",""],[115,"سقاك العارض الوسمي سجما","https://www.aldiwan.net/poem40598.html","عموديه"],[120,"أناديك لو رد النداء رميم","https://www.aldiwan.net/poem49281.html","الطويل"],[143,"بقيت ولا عزت عليك المطالب","https://www.aldiwan.net/poem11719.html","الطويل"],[150,"بحمد الله يفتتح الكلام","https://www.aldiwan.net/poem68494.html","الوافر"],[160,"ألا قللا ما بي تقر عيونها","https://www.aldiwan.net/poem58783.html","الطويل"],[160,"ليوم واحد لك في الصيام","https://www.aldiwan.net/poem59047.html","الوافر"],[169,"صبا شوقاً فحن إلى الديار","https://www.aldiwan.net/poem1627.html",""],[169,"أقيما على حر المدى أو ترحلا","https://www.aldiwan.net/poem1649.html",""],[169,"بنانك من مغدودق المزن أهطل","https://www.aldiwan.net/poem1659.html",""],[185,"ألا هل لدائي من فراقك إفراق","https://www.aldiwan.net/poem14607.html","الطويل"],[192,"زرعت هواه في جريب مثلث","https://www.aldiwan.net/poem27546.html","الطويل"],[198,"مصابك ما كر الجديدان سرمد","https://www.aldiwan.net/poem51953.html","الطويل"],[199,"تميل بالأفلاك مثلي آمال","https://www.aldiwan.net/poem45367.html","الطويل"],[204,"حبيبي ذاك البدر إذ وافق النصفا","https://www.aldiwan.net/poem53243.html","الطويل"],[210,"مسير قد ألم به هناء","https://www.aldiwan.net/poem13311.html","الوافر"],[210,"لعلياك في أفق الكمال مطالع","https://www.aldiwan.net/poem13464.html","الطويل"],[211,"سلام على البحر الخضم وموجه","https://www.aldiwan.net/poem46233.html","الطويل"],[221,"سل القلب عن حبه جاهدا","https://www.aldiwan.net/poem55265.html","المتقارب"],[252,"بكا آمناً أن صار ستراً عَلى الحب","https://www.aldiwan.net/poem1439.html",""],[271,"متى يستقيم الظل والعود أعوج","https://www.aldiwan.net/poem52083.html","الطويل"],[275,"كأن كتائب الباغين حزن","https://www.aldiwan.net/poem25543.html","الوافر"],[280,"ألا هكذا تستهل البدور","https://www.aldiwan.net/poem60773.html","الطويل"],[282,"هنيئا أيها الملك المعظم","https://www.aldiwan.net/poem32628.html","الوافر"],[364,"ألم تر أن الدهر يكتب ما تملي","https://www.aldiwan.net/poem60792.html","الطويل"],[364,"أعد نظرة تبصر صنيع هواكا","https://www.aldiwan.net/poem60818.html","الطويل"],[364,"قليل لهم أن يحن المشوق","https://www.aldiwan.net/poem60831.html","المتقارب"],[366,"لعينيه على العشاق إمره","https://www.aldiwan.net/poem17205.html","الوافر"],[377,"حبيب لنا بين الرموز يناقش","https://www.aldiwan.net/poem59369.html","الطويل"],[441,"حرائق حزن في فؤادي تجدد","https://www.aldiwan.net/poem14448.html","الطويل"],[449,"هو الدين","https://www.aldiwan.net/poem977.html",""],[453,"ولي منزل لقنته سر عزلتي","https://www.aldiwan.net/poem61264.html","الطويل"],[458,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[464,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[468,"متى يشتفي قلب الدنو من البعد","https://www.aldiwan.net/poem60226.html","الطويل"],[505,"الجرّافة","https://www.aldiwan.net/poem56764.html","الوافر"],[538,"دعاني من ذكر السقام دعانيا","https://www.aldiwan.net/poem47498.html","عموديه"],[551,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[551,"بلغنا ليلة الشعب","https://www.aldiwan.net/poem48050.html","الهزج"],[575,"يا حيرة الحق لما غيب الهادي","https://www.aldiwan.net/poem2786.html","البسيط"],[586,"فيا شعره هل فيك ليلي ينقضي","https://www.aldiwan.net/poem17718.html","الطويل"]],"verses":[["فَيا شَملَ لُبّي لا تَزالُ مُبَدَّداً","وَيا جَفنَ عَيني لا تَزالُ مُؤَرَّقا",0,"ق",2,0],["فَيا شُغلي عَنِ الدُنيا","وَيا شُغلي عَنِ الدينِ",1,"ن",1,0],["فَيا شُؤمَ جَدّي كَيفَ أَبكي تَلَهُّفاً","عَلى ما مَضى مِن وَصلِ بَيضاءَ كاعِبِ",2,"ب",1,0],["في أشْهُرٍ عشْرَةٍ طحَنْتَهُمُ","فَيا رَحى الشّؤمِ والبَوارِ دُري",3,"ر",2,0],["فَيا شَهيداً رَمَتهُ","غَدراً كُراتُ الأَعادي",4,"ي",1,0],["فَيا شَرقُ إِنَّ الغَربَ إِن لانَ أَو قَسا","فَفيهِ مِنَ الصَهباءِ طَبعٌ مُذَوَّبُ",5,"ب",1,0],["فيا شعراء القوم كفّوا وغاكم","فشرح العلا في بعض شعري مُلخص",6,"ص",1,0],["فَيا شَباباً يَطلُبونَ العُلى","إِنَّ العُلى لِلأَنفُسِ الماضِيات",7,"ت",1,0],["فَيا شَوقي إِلى ثَغرٍ وَقَدٍ","حَلَت مِنهُ الثَنايا وَالتَثَنّي",8,"ن",2,0],["فَيا شَقاءَ اِبنَ الزُبير ما لَقى","لَقَد أُصيبَ بِالدَهيِّ الفَيلَق",9,"ق",1,0],["فَيا شَوقِ ما أَبقى وَيالي مِنَ النَوى","وَيا دَمعِ ما أَجرى وَيا قَلبِ ما أَصبى",10,"ب",2,0],["فَيا شائِمي بَرقٍ تَوَضَّحَ مَوهِناً","وَقَعقَعَ إِرعاداً بِنَجدٍ فَأَطمَعا",11,"ع",2,0],["فَيا شَرخَ الشَبابِ أَلا لِقاءٌ","يُبَلُّ بِهِ عَلى يَأسٍ أُوامُ",12,"م",1,0],["فَيا شَمسَ سَعدٍ إِذا ما اِعتَزى","وَكَوكَبَ رَجمٍ إِذا ما اِعتَزَم",13,"م",1,0],["فَيا شاعِر الأطيار زدني ترنماً","فإني لما أَنشدتنيه سَميع",14,"ع",1,0],["فيا شمسُ كُفِّي عن مداركِ واخمدي","ويا شهب غُوري في دياجير آجالِ",15,"ل",1,0],["فيا شاعراً غنَّى فرَقَّ لشجوِهِ","جَفاءُ اللَّيالي واعتسافُ المقادرِ",16,"ر",1,0],["فيا شقاء ابن الزبير ما لقى","لقد أصبت بالدهي الفيلق",17,"ق",1,0],["فَيَا شَمْسُ سَرْعَانُ القَضَاءِ تَهَجُّماً","عَلَيْكِ وَلَمْ يُمَهِلكِ فِي السَّبْعِ وَالعَشْرِ",18,"ر",1,0],["فَيَا شَمْسَ حُسْنٍ بَكَّرَتْ فِي زَوَالِهَا","لَئِنْ غِبْتِ فَالزَّهْرُ الثَّوَابِتُ فِي الإِثْرِ",18,"ر",1,0],["فيا شبابَ البلاد صونوا","شَرْخَ الصبا قبل أن يبيدا",19,"د",2,0],["فيا شرق حتى الحشر تربك فوقه","دليل لمن يدر ما فعل الغرب",20,"ب",1,0],["فيا شعب الحبيب عفوت لكن","نقشت بقلبي الممحوّ رقما",21,"م",2,0],["فيا شقوة الإنسان يجنيه سعيه","ثمار الردى المشنوء وهو نعيم",22,"م",1,0],["فَيا شائِبَ المَعروفِ بِالبِشرِ مُنعِماً","أَعَدتَ الخَبابَ الغَضَّ وَالرَأسُ شائِبُ",23,"ب",1,0],["فيا شيبَ الذُّنوبِ غلاَّ حياءٌ","تبدّى الصبح وانقشع الظَّلام",24,"م",1,0],["فيا شرف الدين انتقد قد جلوتها","عليك عروساً ما بها ما يشينها",25,"ن",3,0],["فيا شهر التلاوة قد تدانى","فراقك وانقضى عقد الذمام",26,"م",1,0],["فَيا شَرَّ الدُهورِ جُزيتَ شَرَّ ال","جَزاءِ وَذُقتَ فُقدانَ الشّرارِ",27,"ر",1,0],["فَيا شِقَوتا ما لي أَرى كُلَّ ساعَةٍ","أُمُوراً مُحالاتٍ وَرَأياً مُضَلَّلا",28,"ل",2,0],["فَيا شَقوَتا مِن عُظمِ شَوقٍ مُبَرِّحٍ","إِلَيهِ بِأَثناءِ الحَشا يَتَغَلغَلُ",29,"ل",1,0],["فيا شمسَ فضلٍ غَرَّبتْ ولضوئِها","على كلِّ قُطرٍ بالمَشارق إشراق",30,"ق",1,0],["فَيا شُؤمُ مالي إِذ يَعطُل لِلشَّقا","وَيا وَيحَ ثَوري صارَ مُعلَفَه كَبِدي",31,"د",2,0],["فيا شدةً أمسيتُ سيانِ بعده","أُرَدِّدُ من شوقي لما لا أُرَدِّد",32,"د",1,0],["فيا شمسُ هل مزّقتِ ثوبكِ عندما","نُكبتِ وهذا الغيمُ في الأفقِ أذيالُ",33,"ل",1,0],["فيا شكل ذا خصراً ويا ثقل ذا ردفاً","ويا حسن ذا خدّاً ويا نَبل ذا طرفا",34,"ف",2,0],["فيا شوقي لكم حين التنائي","ويا اسني بكم حيث اللقاء",35,"ا",2,0],["فيا شائما برق الحيا من نواله","ليهنك هذا الغيث هام وهامع",36,"ع",1,0],["فيا شارع الكورنيش ألف تحية","إلى ما أثمنا في جوانبك الغر",37,"ر",1,0],["فياشوق مزق فؤادي فما","بقائي من بعدها بغيتي",38,"ي",1,0],["فَيا شُغلي عَن كُلِّ شيء بِفارغ","حَبيب عَلى بُخل مُعادٍ عَلى الحُبِّ",39,"ب",1,0],["فَيا شؤوم حَظي حين ينكشف الغطا","اذا لَم يَكن لي من ذنوبي مخرج",40,"ج",1,0],["فَيا شَرق الفَضاءِ بِهم شُروقاً","ويا لِزَوالِهِم عِنْدَ الزَّوالِ",41,"ل",1,0],["فَيا شَرَفَ الدَّوْلَةِ الْمُستَجارُ","لَكَ اللهُ مِنْ كُلِّ عَيْنٍ مُجِيرُ",42,"ر",1,0],["فَيا شَرَفاً لِدينِ اللَهِ يا مَن","لَهُ المَجدُ المُؤَثَّلُ حيثُ يَمَّم",43,"م",1,0],["فيا شَمْسُ بل يا وَبْلُ هل أنت مُنقذي","ومُنقِذُ صَحْبي من يَدِ الشّمسِ والوَبْل",44,"ل",1,0],["فيا شِعْرُ لولا عَطْفةٌ منه أَدركَتْ","لقد كنتَ سَطْراً والزّمانُ مَحاكا",45,"ك",2,0],["فيا شمسُ لا عَدِمَتْها البِلادُ","ولا عَلِقَتْ من عُلاها عَلوق",46,"ق",1,0],["فَيا شَمساً تَبَدَّت لي عِشاءً","وَيا قَمَراً وَلَيسَ يغيبُ بُكرَه",47,"ر",2,0],["فيا شوقُ لا تُثقِل عليه لأنه","رقيقٌ وهذا الشوق بالطبع حارش",48,"ش",1,0],["فيا شر مغرور بدنيا دنية","يحل بها ما لا يحل ويعقد",49,"د",1,0],["فيا شيخنا أكرمت للفضل شيخن","فحياك رب في سماواته العلا",50,"ل",2,0],["فيا شمس غيبي أو أطلي فإننا","نرى ضوءك الوهاج كان معارا",51,"ر",2,0],["في اشتباه الناس ودٌّ بينهم","وحزازات التنافي شرُّ ضِعنِ",52,"ن",1,0],["فيا شدَّ ما شفَّ الأسى قلبَ ذاكر","تخليها ما بين عامٍ وقابل",53,"ل",1,0],["فَيا شُؤمَ بَختي كَيفَ حَتّى اِستَرَقَّني","مِنَ الناسِ مَولىً لا يَرِقُّ عَلى عَبدِ",54,"د",1,0],["فيا شؤمَ زمانٍ فيهِ ديسَ","الصّحابُ كما يُداسُ الطفلُ فينا",55,"ن",2,0],["فيا شاديا يشدو بنَيلِ مُنَائِيا","أعِدهُ علَى الأسمَاع حُيِّيتَ شَاديا",56,"ي",2,0],["فيا شَعَراتِ رأسٍ كنّ سُوداً","وحُلْنَ بما جناه الدَّهرُ جُونا",57,"ن",2,0],["فَيا شِعباً تَعانقنا","بِهِ بوركتَ من شِعبِ",58,"ب",1,0],["فيا شماتة تعطيل وفلْسَفةٍ","ويا مسرَّة إِشراكٍ وإِلحاد",59,"د",1,0],["فَيَا شَعْرَهُ هَلْ فِيكَ لَيْلِيَ يَنْقَضِي","وَيَا صُبْحَهُ هَلْ فِيكَ صُبْحِي بَاسِمُ",60,"م",1,1]]}