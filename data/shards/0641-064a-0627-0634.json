لصَهباءِ طَبعٌ مُذَوَّبُ",5,"ب",1,0],["فيا شعراء القوم كفّوا وغاكم","فشرح العلا في بعض شعري مُلخص",6,"ص",1,0],["فَيا شَباباً يَطلُبونَ العُلى","إِنَّ العُلى لِلأَنفُسِ الماضِيات",7,"ت",1,0],["فَيا شَوقي إِلى ثَغرٍ وَقَدٍ","حَلَت مِنهُ الثَنايا وَالتَثَنّي",8,"ن",2,0],["فَيا شَقاءَ اِبنَ الزُبير ما لَقى","لَقَد أُصيبَ بِالدَهيِّ الفَيلَق",9,"ق",1,0],["فَيا شَوقِ ما أَبقى وَيالي مِنَ النَوى","وَيا دَمعِ ما أَجرى وَيا قَلبِ ما أَصبى",10,"ب",2,0],["فَيا شائِمي بَرقٍ تَوَضَّحَ مَوهِناً","وَقَعقَعَ إِرعاداً بِنَجدٍ فَأَطمَعا",11,"ع",2,0],["فَيا شَرخَ الشَبابِ أَلا لِقاءٌ","يُبَلُّ بِهِ عَلى يَأسٍ أُوامُ",12,"م",1,0],["فَيا شَمسَ سَعدٍ إِذا ما اِعتَزى","وَكَوكَبَ رَجمٍ إِذا ما اِعتَزَم",13,"م",1,0],["فَيا شاعِر الأطيار زدني ترنماً","فإني لما أَنشدتنيه سَميع",14,"ع",1,0],["فيا شمسُ كُفِّي عن مداركِ واخمدي","ويا شهب غُوري في دياجير آجالِ",15,"ل",1,0],["فيا شاعراً غنَّى فرَقَّ لشجوِهِ","جَفاءُ اللَّيالي واعتسافُ المقادرِ",16,"ر",1,0],["فيا شقاء ابن الزبير ما لقى","لقد أصبت بالدهي الفيلق",17,"ق",1,0],["فَيَا شَمْسُ سَرْعَانُ القَضَاءِ تَهَجُّماً","عَلَيْكِ وَلَمْ يُمَهِلكِ فِي السَّبْعِ وَالعَشْرِ",18,"ر",1,0],["فَيَا شَمْسَ حُسْنٍ بَكَّرَتْ فِي زَوَالِهَا","لَئِنْ غِبْتِ فَالزَّهْرُ الثَّوَابِتُ فِي الإِثْرِ",18,"ر",1,0],["فيا شبابَ البلاد صونوا","شَرْخَ الصبا قبل أن يبيدا",19,"د",2,0],["فيا شرق حتى الحشر تربك فوقه","دليل لمن يدر ما فعل الغرب",20,"ب",1,0],["فيا شعب الحبيب عفوت لكن","نقشت بقلبي الممحوّ رقما",21,"م",2,0],["فيا شقوة الإنسان يجنيه سعيه","ثمار الردى المشنوء وهو نعيم",22,"م",1,0],["فَيا شائِبَ المَعروفِ بِالبِشرِ مُنعِماً","أَعَدتَ الخَبابَ الغَضَّ وَالرَأسُ شائِبُ",23,"ب",1,0],["فيا شيبَ الذُّنوبِ غلاَّ حياءٌ","تبدّى الصبح وانقشع الظَّلام",24,"م",1,0],["فيا شرف الدين انتقد قد جلوتها","عليك عروساً ما بها ما يشينها",25,"ن",3,0],["فيا شهر التلاوة قد تدانى","فراقك وانقضى عقد الذمام",26,"م",1,0],["فَيا شَرَّ الدُهورِ جُزيتَ شَرَّ ال","جَزاءِ وَذُقتَ فُقدانَ الشّرارِ",27,"ر",1,0],["فَيا شِقَوتا ما لي أَرى كُلَّ ساعَةٍ","أُمُوراً مُحالاتٍ وَرَأياً مُضَلَّلا",28,"ل",2,0],["فَيا شَقوَتا مِن عُظمِ شَوقٍ مُبَرِّحٍ","إِلَيهِ بِأَثناءِ الحَشا يَتَغَلغَلُ",29,"ل",1,0],["فيا شمسَ فضلٍ غَرَّبتْ ولضوئِها","على كلِّ قُطرٍ بالمَشارق إشراق",30,"ق",1,0],["فَيا شُؤمُ مالي إِذ يَعطُل لِلشَّقا","وَيا وَيحَ ثَوري صارَ مُعلَفَه كَبِدي",31,"د",2,0],["فيا شدةً أمسيتُ سيانِ بعده","أُرَدِّدُ من شوقي لما لا أُرَدِّد",32,"د",1,0],["فيا شمسُ هل مزّقتِ ثوبكِ عندما","نُكبتِ وهذا الغيمُ في الأفقِ أذيالُ",33,"ل",1,0],["فيا شكل ذا خصراً ويا ثقل ذا ردفاً","ويا حسن ذا خدّاً ويا نَبل ذا طرفا",34,"ف",2,0],["فيا شوقي لكم حين التنائي","ويا اسني بكم حيث اللقاء",35,"ا",2,0],["فيا شائما برق الحيا من نواله","ليهنك هذا الغيث هام وهامع",36,"ع",1,0],["فيا شارع الكورنيش ألف تحية","إلى ما أثمنا في جوانبك الغر",37,"ر",1,0],["فياشوق مزق فؤادي فما","بقائي من بعدها بغيتي",38,"ي",1,0],["فَيا شُغلي عَن كُلِّ شيء بِفارغ","حَبيب عَلى بُخل مُعادٍ عَلى الحُبِّ",39,"ب",1,0],["فَيا شؤوم حَظي حين ينكشف الغطا","اذا لَم يَكن لي من ذنوبي مخرج",40,"ج",1,0],["فَيا شَرق الفَضاءِ بِهم شُروقاً","ويا لِزَوالِهِم عِنْدَ الزَّوالِ",41,"ل",1,0],["فَيا شَرَفَ الدَّوْلَةِ الْمُستَجارُ","لَكَ اللهُ مِنْ كُلِّ عَيْنٍ مُجِيرُ",42,"ر",1,0],["فَيا شَرَفاً لِدينِ اللَهِ يا مَن","لَهُ المَجدُ المُؤَثَّلُ حيثُ يَمَّم",43,"م",1,0],["فيا شَمْسُ بل يا وَبْلُ هل أنت مُنقذي","ومُنقِذُ صَحْبي من يَدِ الشّمسِ والوَبْل",44,"ل",1,0],["فيا شِعْرُ لولا عَطْفةٌ منه أَدركَتْ","لقد كنتَ سَطْراً والزّمانُ مَحاكا",45,"ك",2,0],["فيا شمسُ لا عَدِمَتْها البِلادُ","ولا عَلِقَتْ من عُلاها عَلوق",46,"ق",1,0],["فَيا شَمساً تَبَدَّت لي عِشاءً","وَيا قَمَراً وَلَيسَ يغيبُ بُكرَه",47,"ر",2,0],["فيا شوقُ لا تُثقِل عليه لأنه","رقيقٌ وهذا الشوق بالطبع حارش",48,"ش",1,0],["فيا شر مغرور بدنيا دنية","يحل بها ما لا يحل ويعقد",49,"د",1,0],["فيا شيخنا أكرمت للفضل شيخن","فحياك رب في سماواته العلا",50,"ل",2,0],["فيا شمس غيبي أو أطلي فإننا","نرى ضوءك الوهاج كان معارا",51,"ر",2,0],["في اشتباه الناس ودٌّ بينهم","وحزازات التنافي شرُّ ضِعنِ",52,"ن",1,0],["فيا شدَّ ما شفَّ الأسى قلبَ ذاكر","تخليها ما بين عامٍ وقابل",53,"ل",1,0],["فَيا شُؤمَ بَختي كَيفَ حَتّى اِستَرَقَّني","مِنَ الناسِ مَولىً لا يَرِقُّ عَلى عَبدِ",54,"د",1,0],["فيا شؤمَ زمانٍ فيهِ ديسَ","الصّحابُ كما يُداسُ الطفلُ فينا",55,"ن",2,0],["فيا شاديا يشدو بنَيلِ مُنَائِيا","أعِدهُ علَى الأسمَاع حُيِّيتَ شَاديا",56,"ي",2,0],["فيا شَعَراتِ رأسٍ كنّ سُوداً","وحُلْنَ بما جناه الدَّهرُ جُونا",57,"ن",2,0],["فَيا شِعباً تَعانقنا","بِهِ بوركتَ من شِعبِ",58,"ب",1,0],["فيا شماتة تعطيل وفلْسَفةٍ","ويا مسرَّة إِشراكٍ وإِلحاد",59,"د",1,0],["فَيَا شَعْرَهُ هَلْ فِيكَ لَيْلِيَ يَنْقَضِي","وَيَا صُبْحَهُ هَلْ فِيكَ صُبْحِي بَاسِمُ",60,"م",1,1],["فَيا شهرُ لا تبعُد لَكَ الخَيرُ كلُّهُ","فأَنتَ رَبيعُ الوَصلِ يا طِيبَ مَرعَاهُ",61,"ا",2,0],["فيا شوقَ الحجازِ إلى مَذاكٍ","تُمَطَّرُ من جيادِك في جياد",62,"د",1,0],["فيا شاب العصر هبوا إلى","نهج أماط العلم عنه الحجاب",63,"ب",1,0],["فَيا شَيخ سُوء أَطَعت الهَوى","وَلَم يَعصك الأَبرَص الأَمرَد",64,"د",1,0],["فَيا شمل شمِّر وَاِطلبِ القوم بالّذي","أَصبتَ وَلا تَقبل قصاصاً ولا عقلا",65,"ل",2,0],["فَيَا شَجَرَاتٍ أَثْمَرَتْ كلَّ لَذَةٍ","جَنَاكِ لذيذٌ لَوْ جَنَيْتِ على الغادِي",66,"د",2,0],["فيا شادناً أحورَ المقلتين","بل دونَهُ الشادنُ الأحور",67,"ر",1,0],["فَيا شَمسَ أُفقِ الحُسنِ لَولا انتِسابُها","لِكُلِّ نَجيبٍ قَد نَماهُ نَجيبُ",68,"ب",1,0],["فيا شرف الإسلام لا زلت سالما","يسير فيك المادحون القوافيا",69,"ي",2,0],["فيا شرف الحضرتين استمع","ثناء براهينه تشهدُ",70,"د",1,0],["فيا شرفي بأن قد صرت منهم","على قرب وإن سواي نائي",71,"ي",1,0],["فيا شهيداً قضى في الله محتسباً","وفي الجنان حباه عالي الرتب",72,"ب",1,0],["فياشامتا بالنَّفي لي كُفَّ إنني","عقدتُ به فوقَ المعَالي معَاليا",73,"ي",2,0],["فيا شعباً سليباً كيف تبلى","بما تبلى وتقبل بالرقود",74,"د",1,0],["فيا شقيقة نفسي","أهواك دون رجاء",75,"ا",2,0],["فيا شهب بيت المجد يا أجمل الورى","ويا خير مجناء وآل أكارمِ",76,"م",1,0],["فيا شمس الأصيل أراك تشكو","كشكوائي، أطبعك من طباعي!",77,"ي",1,1],["فياشعر جوجو فداك الحرير","ويا نابه دونك المبضعُ",78,"ع",1,0],["فيا شوقي لأكناف المصلى","ومسجد خيفها والمعهدين",79,"ن",1,0],["فيا شوقا إلى بانات سلع","فكم عطفت عليّ قدود قضب",80,"ب",1,0],["فيا ش