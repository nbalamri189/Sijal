{"poems":[[53,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[53,"في كل يوم مودات مطلقة","https://www.aldiwan.net/poem30416.html","البسيط"],[63,"الورد يبسم والركائب حوم","https://www.aldiwan.net/poem46212.html","الكامل"],[86,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[86,"ردوا علي بياني بعد محمود","https://www.aldiwan.net/poem10495.html","البسيط"],[86,"كم وارث غض الشباب رميته","https://www.aldiwan.net/poem10705.html","الكامل"],[86,"الشعب يدعو الله يا زغلول","https://www.aldiwan.net/poem68900.html","الكامل"],[86,"وسع الفضل كله صدرك الرح","https://www.aldiwan.net/poem68931.html","الخفيف"],[88,"حي هل يا أخا مصر","https://www.aldiwan.net/poem44435.html","مجزوء الخفيف"],[88,"دار ذا الدهر مداره","https://www.aldiwan.net/poem44820.html","مجزوء الرمل"],[72,"سهرت عليك لواحظ الرقباء","https://www.aldiwan.net/poem18175.html","الكامل"],[72,"أستغفر الله لا مالي ولا ولدي","https://www.aldiwan.net/poem18543.html","البسيط"],[72,"معاطف أو شراشف دبل","https://www.aldiwan.net/poem19535.html","المنسرح"],[72,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[51,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[51,"راجعت بعد الجهل حجرا","https://www.aldiwan.net/poem64034.html","مجزوء الكامل"],[51,"قل لأبي سهل الذي ورث","https://www.aldiwan.net/poem64575.html","المنسرح"],[51,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[51,"دع لباك رسومه وطلوله","https://www.aldiwan.net/poem65987.html","الخفيف"],[51,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[91,"زحزحت عن صدرها الغيم السماء","https://www.aldiwan.net/poem8732.html","عموديه"],[91,"لا تقلقي يوم النوى أو فاقلقي","https://www.aldiwan.net/poem8985.html","عموديه"],[70,"وزائر على عجل","https://www.aldiwan.net/poem42734.html","مجزوء الرجز"],[78,"سكن فؤادك لا تذهب به الفكر","https://www.aldiwan.net/poem14154.html","البسيط"],[85,"هز اللواء بعزك الإسلام","https://www.aldiwan.net/poem63742.html","الكامل"],[56,"أنت حديثي في النوم واليقظه","https://www.aldiwan.net/poem58560.html","الطويل"],[56,"إن ريب الزمان طال انتكائه","https://www.aldiwan.net/poem58624.html","الخفيف"],[43,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[45,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[45,"ما لذا الظبي لاينال إقتناصه","https://www.aldiwan.net/poem64618.html","الخفيف"],[61,"أجل هو الفتح لا فتح يشاكله","https://www.aldiwan.net/poem51478.html","البسيط"],[61,"ناديك من مطر الإحسان ممطور","https://www.aldiwan.net/poem51687.html","البسيط"],[49,"من يعش يكبر ومن يكبر يمت","https://www.aldiwan.net/poem10392.html","الرمل"],[49,"المنايا تجوس كل البلاد","https://www.aldiwan.net/poem62044.html","الخفيف"],[49,"اتق الله بجهدك","https://www.aldiwan.net/poem62061.html","مجزوء الرمل"],[49,"إن دارا نحن فيها لدار","https://www.aldiwan.net/poem62089.html","المديد"],[49,"نسأل الله بما يقضي الرضى","https://www.aldiwan.net/poem62141.html","الرمل"],[66,"كم ساهر حرم لمس الوساد","https://www.aldiwan.net/poem38652.html","السريع"],[97,"قدم لبسيوني قريضك واعتذر","https://www.aldiwan.net/poem24384.html","الكامل"],[44,"يوم الفراق لقد خلقت طويلا","https://www.aldiwan.net/poem30378.html","الكامل"],[44,"لطمحت في الإبراق والإرعاد","https://www.aldiwan.net/poem30535.html","الكامل"],[69,"كم وكم دولة تبرمت منها","https://www.aldiwan.net/poem28515.html","الخفيف"],[69,"مربع يخلو ودمع يكف","https://www.aldiwan.net/poem28817.html","الرمل"],[46,"قد حجب النور والضياء","https://www.aldiwan.net/poem22000.html","مجزوء البسيط"],[46,"الكون في جملة العوافي","https://www.aldiwan.net/poem22211.html","مجزوء البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85330","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85322","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39559","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39581","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54905","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142007","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141990","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54317","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[106,"صاحب آويته","https://www.poetsgate.com/ViewPoem.aspx?id=179660",""],[106,"ثورة على الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=179425",""],[106,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[91,"ضرة جلق","https://www.poetsgate.com/ViewPoem.aspx?id=53143",""],[51,"دعْ لباكٍ رسومَه وطلولَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=30335",""]],"verses":[["كَم وَقفَةٍ ناجَيتَهُ في ظِلِّها","وَالقَولُ يَغدُرُ بِالخَطيبِ المِقوَلِ",0,"ل",1,0],["كَم وَحدَةٍ هِيَ خَيرٌ مِن مُصاحَبَةٍ","يُنسى الجَميعُ وَيَغدو الفَذُّ مَذكورا",1,"ر",2,0],["كَمْ وَقْفَةٍ مَيْلاءَ في أثْنائِها","شَوْقٌ إِلى طَلَلٍ بِرامَةَ يُرْزِمُ",2,"م",1,0],["كَم وَرَدنا مَوارِدَ الأُنسِ مِنها","وَرَشَفنا سُلافَها وَالرُضابا",3,"ب",2,0],["كَم وَقفَةٍ لَكَ وَالأَبطالُ طائِرَةٌ","وَالحَربُ تَضرِبُ صِنديداً بِصِنديدِ",4,"د",1,0],["كَم وارِثٍ غَضِّ الشَبابِ رَمَيتِهِ","بِغَرامِ راقِصَةٍ وَحُبِّ هَلوكِ",5,"ك",1,1],["كَم وارِدٍ يا سَعدُ قَبلَكَ ماءَهُ","قَد عادَ عَنهُ وَفي الفُؤادِ غَليلُ",6,"ل",1,0],["كَم وِسامٍ كَم حِليَةٍ كَم شِعارٍ","فيكَ كَم شارَةٍ وَكَم مِن عَلامَه",7,"م",2,0],["كم وكم في حساتنا","مبتدأ ماله خبر",8,"ر",1,0],["كم وزير هو كالوِزْ","رِ على ظهر الوزاره",9,"ر",2,0],["كمؤمل يبغي براحةِ واهبٍ","كرماً ويتركُ أكرمَ الوزراء",10,"ا",2,0],["كم واثقٍ بالليالي مدَّ راحتهُ","إلى المرامِ فناداه الحمامُ قَدِ",11,"د",1,0],["كم وقعةٍ لي مع الزمان وقد","دفعت عني كوقعة الجمل",12,"ل",1,0],["كم ومتى جادلت فيه من عذلٍ","ولا حتَّى ثم أو وأم وبل",13,"ل",1,0],["كم وَعِيدٍ لهُمْ تَبَلَّجَ عن صَفْ","حٍ ومَنْحٍ تَبَلُّجَ الموْعُودِ",14,"د",1,0],["كم وحْيِ رؤيا فزعتُ فيك له","وطِيرةٍ من نواطق الطيرِ",15,"ر",1,0],["كم وقفة لي قد حشَرْ","تُ بها جموع الناس حشرا",16,"ر",2,0],["كم وقفةٍ منك كنتُ أعهدُها","أعتدُّها حين نلتقي أنسا",17,"س",2,0],["كم وعيد أخلفت لو حُقَّ أمسى","من أصابت سماؤه مصعوقا",18,"ق",2,0],["كم وكم قدّرت بدفعك عنها","ردَّ أظفارِ دهرِها مفْلولهْ",19,"ل",2,0],["كم وكم قدرت بسعيك فيما","ترتجيهِ من الأمور حصُولهْ",19,"ل",2,0],["كم وكم بعدي من ظلكمُ","ظلل اللَّه عليه جننه",20,"ن",2,0],["كَم وَجَدنا آفَةً مُهلِكَةً","كُلَّما زَحزَحتَ عَن سِرٍّ غَطاء",21,"ا",2,0],["كَم وِقفَةٍ لي عِندَ شاطِءِ نَهرِها","لا أَستَقي مِنهُ وَروحِيَ تَستَقي",22,"ق",2,0],["كَم واقِفٍ في رَسمِ دا","رٍ لِلحَبيبِ أَو طَلَل",23,"ل",1,0],["كَم وقعة لي في الأَعداء واضِحَة","تَفنى اللَيالي وَما يَفنى لَها الخبرُ",24,"ر",1,0],["كَم واثِقٍ بِالنَفسِ نَهّاضٍ بِها","سادَ البَرِيَّةَ فيهِ وَهوَ عِصامُ",25,"م",1,0],["كَمْ واعِظٍ فيكَ لي وواعِظَةٍ","لو كُنْتُ مِمّنْ تَنْهاهُ عَنْكَ عِظَهْ",26,"ه",1,0],["كَمْ وكَمْ أَسْتَغيثُ مِنْ شَحْطَةِ الدَّا","رِ ولَمْ يُسْعِفِ النّوى مُسْتَغَاثُهْ",27,"ه",1,0],["كَم وَقفَةٍ سَجَرَتكَ شَوقاً بَعدَما","غَرِيَ الرَقيبُ بِنا وَلَجَّ العاذِلُ",28,"ل",1,0],["كَم وُفودٍ بِهِ اِستَجاروا فَأَضحَوا","بِأَياديهِ مُستَجارَ الوُفودِ",29,"د",1,0],["كَم وَجَدناكَ عِندَ آمالِ رَكبٍ","راغِبٍ أَو جَفَت إِلَيكَ قِلاصُه",30,"ص",2,0],["كَمْ وَقْفَةٍ لكَ في ادنى ديارِهِمُ","أَخَذْتَ بالسَّيفِ منها ما تُحاوِلُه",31,"ل",2,0],["كم وقعةٍ لك شَبَّتْ في ديارِهِمْ","ناراً وأشرقَ منها في الهُدى نُورُ",32,"ر",1,0],["كَم وَكَم قَد دَرَجَت مِن قَبلِنا","مِن قُرونٍ وَقُرونٍ قَد مَضَت",33,"ت",1,0],["كَم وَكَم في القُبورِ مِن أَهلِ مُلكٍ","كَم وَكَم في القُبورِ مِن قُوّادِ",34,"د",1,0],["كَم وَكَم في القُبورِ مِن أَهلِ دُنيا","كَم وَكَم في القُبورِ مِن زُهّادِ",34,"د",1,0],["كَم وَكَم عاهَدتَ مَولا","كَ فَلَم توفِ بِعَهدِك",35,"ك",1,0],["كَم وَكَم قَد حَلَّها مِن أُناسٍ","ذَهَبَ اللَيلُ بِهِم وَالنَهارُ",36,"ر",1,0],["كَم وَكَم مِن هَنَةٍ مَحقورَةٍ","تَرَكَت قَوماً كَثيراً حَرَضا",37,"ض",2,0],["كَم والِهٍ مَرَّ هَواهُ لَهُ","لَمّا حَلا مَورِدُهُ وَالمُراد",38,"د",1,0],["كم وقفةٍ لك بيننَا في مجلسٍ","أقسمتُ كنتَ به شبابَ شبابِهِ",39,"ب",2,0],["كَم وَقعَةٍ لَكَ في المَكارِمِ فَخمَةٍ","غادَرتَ فيها ما مَلَكتَ قَتيلا",40,"ل",2,0],["كَم وَقعَةٍ لي في الهَوى مَشهورَةٍ","ما كُنتُ فيها الحارِثَ بنَ عُبادِ",41,"د",1,0],["كَمْ وَكَمْ دولةٍ تبرمْتُ منها","ثم زالتْ كأنَّها لمْ تكنْها",42,"ه",2,1],["كم وكم شمسِ جدالٍ طلعَتْ","في سماءِ البحثِ بي تنكسفُ",43,"ف",1,0],["كَم وَعَظَ الواعِظونَ مِنّا","وَقامَ في الأَرضِ أَنبِياءُ",44,"ي",3,0],["كَم وَدَّعَ الناسُ مِن خَليلٍ","سارَ فَما هَمَّ بِاِلتِفاتِ",45,"ت",1,0],["كم وكم في رجالها من جَهولٍ","صدره ساطع بأَبهى وسام",46,"م",1,0],["كَم وقفنا عَلى ضَريح كَريم","وقفةً قَد جَرَت لها العبرات",47,"ت",1,0],["كم ودّ لو من ضنىً وحُبِّ","هوى على صدرها وأَغفى",48,"ف",2,0],["كم وقفنا العشيَّ نرقب منها","مغربَ الشمس وانبثاق البدورِ",49,"ر",1,0],["كم وقفةٍ لكَ في الصلاةِ كأنما","عمرٌ تحُفُّ به القلوبُ وتخفُقُ",50,"ق",1,0],["كمْ وَقْفَةٍ فِي بَعْلبَكَّ وَقفتُهَا","أَرْمِي الْجِهَاتِ بِنَاظِرٍ رَوَّادِ",51,"د",1,0],["كَمْ وَالمَدَامِعُ فِي انْهِمَا","لٍ وَالْجَوَانِحُ فِي احْتِدَامِ",52,"م",1,0],["كَمْ وَدَّ نَجْمٌ ثَاقٍبٌ لَوْ كَانَهُ","حُسْناً وَعِزّاً لاَ يُرَامُ وَنُورَا",53,"ر",2,0],["كمْ وقفةٍ لي في ذراكَ وجولةٍ","شعريةٍ، وهوى الشآمِ سلاحي",54,"ح",2,0],["كم وردة من غرس كفك","راح يجنيها سواك",55,"ك",1,0],["كَمْ وكم للّهِ في الناسِ يَدٌ","يعجِزُ الشكرُ عليها باليدينْ",56,"ن",1,0],["كم وقفنا نرتجي البُشْرَى كما","يُرْتَجَى بدرُ الدجَى في ليل غَيْنْ",56,"ن",1,0],["كَم وُجوهٍ تَنَقَّبَتْ بسُفُورٍ","ووُجُوهٍ قد أَسْفَرت بِنقَاب",57,"ب",1,0],["كم وحيدٍ بين الرجامِ بكى أمّ","اً وأمٍ بكتْ فتاها الوحيدا",58,"د",2,0],["كَمْ وقفةٍ لك في المَحَارِبِ جَمَّلَتْ","عِزَّ المُلوك بِخَشْيَةِ الْمعبُودِ",59,"د",1,0],["كم وكم ذُقت وإيَّاهُ الطَّوَى","حين لم نلق سوى الغثِّ طعاما!",60,"م",2,0],["كم وضَّحَ العلمُ منهاجًا لمختلِسٍ","وبات يحمي من القانون مغتالا",61,"ل",2,0],["كم ودَّ شبل شرّى بجد","ع الأنف لو أضحى أباه",62,"ا",2,0],["كم وكم ثاوٍ بجُحْرٍ مُظلمٍ","وحريبٍ يأكلُ الماءُ الزلالا",63,"ل",2,0],["كم وقفة لي عند شاطىء نهرها","لا أستقي منه، وروحي تستقي",64,"ق",2,0],["كم وكم قدّرتُ بدفعك عنها","ردَّ أظفارِ دهرِها مغْلوله",65,"ل",2,0]]}