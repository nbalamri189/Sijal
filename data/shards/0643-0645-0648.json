 أهني المعالي","https://www.aldiwan.net/poem33473.html","الخفيف"],[405,"منحتكم صدق المودة كاملا","https://www.aldiwan.net/poem49539.html","الطويل"],[409,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[416,"من لصب مستطار القلب هائم","https://www.aldiwan.net/poem53954.html","الرمل"],[416,"يا رعى الله للأحبة في الجزع","https://www.aldiwan.net/poem53961.html","الخفيف"],[416,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[416,"قام يجلوها وبرد الليل معلم","https://www.aldiwan.net/poem54025.html","الرمل"],[416,"طرقت أسماء في جنح الظلام","https://www.aldiwan.net/poem54040.html","الرمل"],[416,"هاتها حمراء تحكي العندما","https://www.aldiwan.net/poem54068.html","الرمل"],[416,"ضحك البرق فأبكاني دما","https://www.aldiwan.net/poem54130.html","الرمل"],[416,"عد عن من لج في قال وقيل","https://www.aldiwan.net/poem54131.html","الرمل"],[416,"مذ سل في العشاق سيف الناظر","https://www.aldiwan.net/poem54147.html","الكامل"],[427,"وفد البيان","https://www.aldiwan.net/poem42145.html","عموديه"],[429,"طفل السرور من الصهباء مولود","https://www.aldiwan.net/poem40519.html","البسيط"],[429,"لاح في مهد المعالي والسنا","https://www.aldiwan.net/poem40715.html","الرمل"],[432,"ألحق بنفسج فجري وردتي شفقي","https://www.aldiwan.net/poem12386.html","البسيط"],[432,"إن كنت يوما معيني عند نازلة","https://www.aldiwan.net/poem12553.html","البسيط"],[458,"من ناصري والزمان لي خصم","https://www.aldiwan.net/poem55862.html","المنسرح"],[458,"تراك ترى غدوا أو أصيلا","https://www.aldiwan.net/poem56078.html","الوافر"],[458,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[464,"في لأذني عن كل لاح صمم","https://www.aldiwan.net/poem3159.html","عموديه"],[464,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[465,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[500,"أسكرت أهل الوحا خمرتنا","https://www.aldiwan.net/poem37672.html","الرمل"],[500,"أي ورد قد شممناه ضحى","https://www.aldiwan.net/poem37781.html","الرمل"],[500,"وحد الله ولا تشرك به","https://www.aldiwan.net/poem38033.html","الرمل"],[505,"نسوة الحيّ الشرقيّ","https://www.aldiwan.net/poem27890.html","الخفيف"],[538,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[553,"يا أبا الفضل هيجتك الديار","https://www.aldiwan.net/poem68380.html","الخفيف"],[558,"إنني قد شفني السقم","https://www.aldiwan.net/poem34089.html","المديد"],[563,"حمدنا الله ذا العرش المجيد","https://www.aldiwan.net/poem13602.html","الوافر"],[575,"يا ويح نفس عشقت","https://www.aldiwan.net/poem2982.html","مجزوء الرجز"],[575,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"],[575,"كحل العيون بمرود من عسجد","https://www.aldiwan.net/poem3085.html","الكامل"]],"verses":[["كَم وَقفَةٍ ناجَيتَهُ في ظِلِّها","وَالقَولُ يَغدُرُ بِالخَطيبِ المِقوَلِ",0,"ل",1,0],["كَم وَحدَةٍ هِيَ خَيرٌ مِن مُصاحَبَةٍ","يُنسى الجَميعُ وَيَغدو الفَذُّ مَذكورا",1,"ر",2,0],["كَمْ وَقْفَةٍ مَيْلاءَ في أثْنائِها","شَوْقٌ إِلى طَلَلٍ بِرامَةَ يُرْزِمُ",2,"م",1,0],["كَم وَرَدنا مَوارِدَ الأُنسِ مِنها","وَرَشَفنا سُلافَها وَالرُضابا",3,"ب",2,0],["كَم وَقفَةٍ لَكَ وَالأَبطالُ طائِرَةٌ","وَالحَربُ تَضرِبُ صِنديداً بِصِنديدِ",4,"د",1,0],["كَم وارِثٍ غَضِّ الشَبابِ رَمَيتِهِ","بِغَرامِ راقِصَةٍ وَحُبِّ هَلوكِ",5,"ك",1,1],["كَم وارِدٍ يا سَعدُ قَبلَكَ ماءَهُ","قَد عادَ عَنهُ وَفي الفُؤادِ غَليلُ",6,"ل",1,0],["كَم وِسامٍ كَم حِليَةٍ كَم شِعارٍ","فيكَ كَم شارَةٍ وَكَم مِن عَلامَه",7,"م",2,0],["كم وكم في حساتنا","مبتدأ ماله خبر",8,"ر",1,0],["كم وزير هو كالوِزْ","رِ على ظهر الوزاره",9,"ر",2,0],["كمؤمل يبغي براحةِ واهبٍ","كرماً ويتركُ أكرمَ الوزراء",10,"ا",2,0],["كم واثقٍ بالليالي مدَّ راحتهُ","إلى المرامِ فناداه الحمامُ قَدِ",11,"د",1,0],["كم وقعةٍ لي مع الزمان وقد","دفعت عني كوقعة الجمل",12,"ل",1,0],["كم ومتى جادلت فيه من عذلٍ","ولا حتَّى ثم أو وأم وبل",13,"ل",1,0],["كم وَعِيدٍ لهُمْ تَبَلَّجَ عن صَفْ","حٍ ومَنْحٍ تَبَلُّجَ الموْعُودِ",14,"د",1,0],["كم وحْيِ رؤيا فزعتُ فيك له","وطِيرةٍ من نواطق الطيرِ",15,"ر",1,0],["كم وقفة لي قد حشَرْ","تُ بها جموع الناس حشرا",16,"ر",2,0],["كم وقفةٍ منك كنتُ أعهدُها","أعتدُّها حين نلتقي أنسا",17,"س",2,0],["كم وعيد أخلفت لو حُقَّ أمسى","من أصابت سماؤه مصعوقا",18,"ق",2,0],["كم وكم قدّرت بدفعك عنها","ردَّ أظفارِ دهرِها مفْلولهْ",19,"ل",2,0],["كم وكم قدرت بسعيك فيما","ترتجيهِ من الأمور حصُولهْ",19,"ل",2,0],["كم وكم بعدي من ظلكمُ","ظلل اللَّه عليه جننه",20,"ن",2,0],["كَم وَجَدنا آفَةً مُهلِكَةً","كُلَّما زَحزَحتَ عَن سِرٍّ غَطاء",21,"ا",2,0],["كَم وِقفَةٍ لي عِندَ شاطِءِ نَهرِها","لا أَستَقي مِنهُ وَروحِيَ تَستَقي",22,"ق",2,0],["كَم واقِفٍ في رَسمِ دا","رٍ لِلحَبيبِ أَو طَلَل",23,"ل",1,0],["كَم وقعة لي في الأَعداء واضِحَة","تَفنى اللَيالي وَما يَفنى لَها الخبرُ",24,"ر",1,0],["كَم واثِقٍ بِالنَفسِ نَهّاضٍ بِها","سادَ البَرِيَّةَ فيهِ وَهوَ عِصامُ",25,"م",1,0],["كَمْ واعِظٍ فيكَ لي وواعِظَةٍ","لو كُنْتُ مِمّنْ تَنْهاهُ عَنْكَ عِظَهْ",26,"ه",1,0],["كَمْ وكَمْ أَسْتَغيثُ مِنْ شَحْطَةِ الدَّا","رِ ولَمْ يُسْعِفِ النّوى مُسْتَغَاثُهْ",27,"ه",1,0],["كَم وَقفَةٍ سَجَرَتكَ شَوقاً بَعدَما","غَرِيَ الرَقيبُ بِنا وَلَجَّ العاذِلُ",28,"ل",1,0],["كَم وُفودٍ بِهِ اِستَجاروا فَأَضحَوا","بِأَياديهِ مُستَجارَ الوُفودِ",29,"د",1,0],["كَم وَجَدناكَ عِندَ آمالِ رَكبٍ","راغِبٍ أَو جَفَت إِلَيكَ قِلاصُه",30,"ص",2,0],["كَمْ وَقْفَةٍ لكَ في ادنى ديارِهِمُ","أَخَذْتَ بالسَّيفِ منها ما تُحاوِلُه",31,"ل",2,0],["كم وقعةٍ لك شَبَّتْ في ديارِهِمْ","ناراً وأشرقَ منها في الهُدى نُورُ",32,"ر",1,0],["كَم وَكَم قَد دَرَجَت مِن قَبلِنا","مِن قُرونٍ وَقُرونٍ قَد مَضَت",33,"ت",1,0],["كَم وَكَم في القُبورِ مِن أَهلِ مُلكٍ","كَم وَكَم في القُبورِ مِن قُوّادِ",34,"د",1,0],["كَم وَكَم في القُبورِ مِن أَهلِ دُنيا","كَم وَكَم في القُبورِ مِن زُهّادِ",34,"د",1,0],["كَم وَكَم عاهَدتَ مَولا","كَ فَلَم توفِ بِعَهدِك",35,"ك",1,0],["كَم وَكَم قَد حَلَّها مِن أُناسٍ","ذَهَبَ اللَيلُ بِهِم وَالنَهارُ",36,"ر",1,0],["كَم وَكَم مِن هَنَةٍ مَحقورَةٍ","تَرَكَت قَوماً كَثيراً حَرَضا",37,"ض",2,0],["كَم والِهٍ مَرَّ هَواهُ لَهُ","لَمّا حَلا مَورِدُهُ وَالمُراد",38,"د",1,0],["كم وقفةٍ لك بيننَا في مجلسٍ","أقسمتُ كنتَ به شبابَ شبابِهِ",39,"ب",2,0],["كَم وَقعَةٍ لَكَ في المَكارِمِ فَخمَةٍ","غادَرتَ فيها ما مَلَكتَ قَتيلا",40,"ل",2,0],["كَم وَقعَةٍ لي في الهَوى مَشهورَةٍ","ما كُنتُ فيها الحارِثَ بنَ عُبادِ",41,"د",1,0],["كَمْ وَكَمْ دولةٍ تبرمْتُ منها","ثم زالتْ كأنَّها لمْ تكنْها",42,"ه",2,1],["كم وكم شمسِ جدالٍ طلعَتْ","في سماءِ البحثِ بي تنكسفُ",43,"ف",1,0],["كَم وَعَظَ الواعِظونَ مِنّا","وَقامَ في الأَرضِ أَنبِياءُ",44,"ي",3,0],["كَم وَدَّعَ الناسُ مِن خَليلٍ","سارَ فَما هَمَّ بِاِلتِفاتِ",45,"ت",1,0],["كم وكم في رجالها من جَهولٍ","صدره ساطع بأَبهى وسام",46,"م",1,0],["كَم وقفنا عَلى ضَريح كَريم","وقفةً قَد جَرَت لها العبرات",47,"ت",1,0],["كم ودّ لو من ضنىً وحُبِّ","هوى على صدرها وأَغفى",48,"ف",2,0],["كم وقفنا العشيَّ نرقب منها","مغربَ الشمس وانبثاق البدورِ",49,"ر",1,0],["كم وقفةٍ لكَ في الصلاةِ كأنما","عمرٌ تحُفُّ به القلوبُ وتخفُقُ",50,"ق",1,0],["كمْ وَقْفَةٍ فِي بَعْلبَكَّ وَقفتُهَا","أَرْمِي الْجِهَاتِ بِنَاظِرٍ رَوَّادِ",51,"د",1,0],["كَمْ وَالمَدَامِعُ فِي انْهِمَا","لٍ وَالْجَوَانِحُ فِي احْتِدَامِ",52,"م",1,0],["كَمْ وَدَّ نَجْمٌ ثَاقٍبٌ لَوْ كَانَهُ","حُسْناً وَعِزّاً لاَ يُرَامُ وَنُورَا",53,"ر",2,0],["كمْ وقفةٍ لي في ذراكَ وجولةٍ","شعريةٍ، وهوى الشآمِ سلاحي",54,"ح",2,0],["كم وردة من غرس كفك","راح يجنيها سواك",55,"ك",1,0],["كَمْ وكم للّهِ في الناسِ يَدٌ","يعجِزُ الشكرُ عليها باليدينْ",56,"ن",1,0],["كم وقفنا نرتجي البُشْرَى كما","يُرْتَجَى بدرُ الدجَى في ليل غَيْنْ",56,"ن",1,0],["كَم وُجوهٍ تَنَقَّبَتْ بسُفُورٍ","ووُجُوهٍ قد أَسْفَرت بِنقَاب",57,"ب",1,0],["كم وحيدٍ بين الرجامِ بكى أمّ","اً وأمٍ بكتْ فتاها الوحيدا",58,"د",2,0],["كَمْ وقفةٍ لك في المَحَارِبِ جَمَّلَتْ","عِزَّ المُلوك بِخَشْيَةِ الْمعبُودِ",59,"د",1,0],["كم وكم ذُقت وإيَّاهُ الطَّوَى","حين لم نلق سوى الغثِّ طعاما!",60,"م",2,0],["كم وضَّحَ العلمُ منهاجًا لمختلِسٍ","وبات يحمي من القانون مغتالا",61,"ل",2,0],["كم ودَّ شبل شرّى بجد","ع الأنف لو أضحى أباه",62,"ا",2,0],["كمومس ، باغت البوليس مرقدها","كمقبلين على أشلائهم ، رجعوا",63,"ع",3,0],["كمؤمرة ... من تحكمهم","ماتوا أو باتت معزولة",64,"ل",2,0],["كم وكم ثاوٍ بجُحْرٍ مُظلمٍ","وحريبٍ يأكلُ الماءُ الزلالا",65,"ل",2,0],["كم وقفة لي عند شاطىء نهرها","لا أستقي منه، وروحي تستقي",66,"ق",2,0],["كم وردة طيبها حتّى لسارقها","لا دمنه خبثها حتّى لساقيها",67,"ي",3,0],["كم وكم قدّرتُ بدفعك عنها","ردَّ أظفارِ دهرِها مغْلوله",68,"ل",2,0],["كمؤمّرة … من تحكمهم …","ماتوا ، أو باتت معزولبه",69,"ل",3,0],["كم وقفة لك بالصّلاة كأنّما","عمر تحف به القلوب وتخفق",70,"ق",1,0],["كم وكم مزق صفا في الوغى","وسقى الابطال راح الاجل",71,"ل",1,0],["كم وكم حاضرته في ثقل","فكفاني الله هم الثقل",71,"ل",1,0],["كَم وارَدوكَ الرَدى فَما صَدَروا","عَنهُ وَلَكِن رُدّوا كَما وَرَدوا",72,"د",3,0],["كم ورَّطت في عُسرةٍ من موسر","كم ورَّطت في عطبة من مُعسِر",73,"ر",1,0],["كم وقعة لصروف الدهر منكرة","جلا عجاجتها في لمحة البصر",74,"ر",1,0],["كم ود إسماعيل إسحاقا له","أو ذبحه بيدي عدون شاني",75,"ن",2,0],["كَم وَقعَةٍ تَرَكَ العِدى وَجِباهُها","لِلسَيفِ ساجِدَةٌ عَلى الأَقدامِ",76,"م",1,0],["كم واضع نفسه والله يرفعه","ورافع نفسه في حال مخفوض",77,"ض",1,0],["كم وثبة وثب اللعي","ن على المحابر والدفاتر",78,"ر",1,0],["كَم والِدٍ يَحرِمُ أَولادَهُ","وَخَيرُهُ يَحظى بِهِ الأَبعَدُ",79,"د",1,1],["كم واجدٍ منها تقاذفَ قلبهُ","ذاتُ الدلالِ فإن دنا هو تبعدِ",80,"د",1,0],["كَمَوكِب جِنٍّ قَد أَطَلَّ من الفَضا","لِيَشهَدَ أَطلالَ الرَدى وَبِهِ ذُعرُ",81,"ر",1,0],["كَمْ وَلَهِي فيه وكَمْ عَبْرتي","ومُحْرَقي من غير نارٍ بنار",82,"ر",1,0],["كم وكم من رسالة لك قد برّ","زتَ فيها سبقاً على التبريزي",83,"ز",2,0],["كَم وَكَم قَد خَبَأتُ عِندي حَديثاً","هُوَ عِندَ المُلوكِ كَالتُفّاحِ",84,"ح",1,0],["كَمْ وَقْعَةٍ لِلشَّوْقِ شُبَّ ضِرامُها","فَلَقِيتُ فِيها أَضْلُعِي بِجُفُونِي",85,"ن",2,0],["كَم وَكَم أَملٍ نلتَ بهم","حيث لَم تَقضِ اللَيالي أَملَك",86,"ك",1,0],["كَم وَكَم مِن نِعمَةٍ وَشَّحَها","عاتقُ الدهر بكفٍّ لا تَشحُّ",87,"ح",1,0],["كم وَقفةٍ لك في (طرابس) وَقدْ","طاش الحليمُ وَظلَّ ذعراً لا يعي",88,"ي",1,0],["كم وَقفةٍ في ظلالِ الأَيك من (بردى)","وَبين أَدغالِه والجزع والساح",89,"ح",1,0],["كم وكم لي من مرام ومزامر","فيك يا دري المباسم والعقود",90,"د",1,0],["كَم واجِدٍ أَطلَقَ وُجدانُه","عِنا