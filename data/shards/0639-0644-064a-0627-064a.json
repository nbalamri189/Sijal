{"poems":[[55,"على أي غرس آمن الدهر بعدما","https://www.aldiwan.net/poem30730.html","الطويل"],[55,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[88,"ملكتم علي عنان الخطب","https://www.aldiwan.net/poem68863.html","المتقارب"],[90,"زر السجن في بغداد زورة راحم","https://www.aldiwan.net/poem45020.html","الطويل"],[29,"على أي دين دين سوداء إذ شوت","https://www.aldiwan.net/poem6001.html","الوافر"],[39,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[74,"على أيمن الأوقات مقدم من له","https://www.aldiwan.net/poem19034.html","الطويل"],[87,"على أي الجنان بنا تمر","https://www.aldiwan.net/poem63714.html","الوافر"],[47,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[47,"على أي أمر مشكل أتلوم","https://www.aldiwan.net/poem65664.html","الطويل"],[30,"ينام الطريد بعدها نومة الضحى","https://www.aldiwan.net/poem5509.html","الطويل"],[46,"أألله إني خالد بعد خالد","https://www.aldiwan.net/poem30315.html","الطويل"],[77,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[111,"ألا هل لداعي الله في الأرض سامع","https://www.poetsgate.com/ViewPoem.aspx?id=103",""],[92,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[47,"عَلى أيّ أمْرٍ مُشْكِلٍ أتَلَوّمُ","https://www.poetsgate.com/ViewPoem.aspx?id=31836",""],[119,"خفايا المعاني تنجلي بالدلائل","https://www.aldiwan.net/poem40849.html","عموديه"],[168,"على أي رغم ظلت أغضي وأكظم","https://www.aldiwan.net/poem67840.html","الطويل"],[214,"سلوا فاتر الأجفان عن كبدي الحرا","https://www.aldiwan.net/poem13338.html","الطويل"],[315,"على أي حال لليالي أعاتب","https://www.aldiwan.net/poem59238.html","الطويل"],[369,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[422,"على أي وجد طويت الضلوعا","https://www.aldiwan.net/poem53848.html","المتقارب"],[463,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[463,"على أي لائمة أربع","https://www.aldiwan.net/poem56136.html","المتقارب"],[463,"على أي أخلاقِ الزمان أعاتبه","https://www.aldiwan.net/poem56287.html","الطويل"],[569,"اهجر معنى القلب عندك جائز","https://www.aldiwan.net/poem856.html",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48820","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63874","المنسرح"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59258","الطويل"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44997","المتقارب"],[1149,"","https://poetry.dctabudhabi.ae/diwan/poem/67681","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56161","الوافر"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/20003","الطويل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137846",""],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49983","الطويل"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116542","الوافر"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100451","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28534","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204816","الطويل"],[3026,"","https://poetry.dctabudhabi.ae/diwan/poem/143629","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74203","الطويل"],[3243,"","https://poetry.dctabudhabi.ae/diwan/poem/140233",""],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68077","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62936","المتقارب"],[3698,"","https://poetry.dctabudhabi.ae/diwan/poem/203432","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91157","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91703","الوافر"],[3906,"","https://poetry.dctabudhabi.ae/diwan/poem/199410","الطويل"],[3914,"","https://poetry.dctabudhabi.ae/diwan/poem/116895","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77089","الطويل"],[3975,"","https://poetry.dctabudhabi.ae/diwan/poem/75823","الطويل"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69296","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136640",""],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117229","الوافر"],[4680,"غدا سيدور الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=189978",""],[4733,"نزوح","https://www.poetsgate.com/ViewPoem.aspx?id=190641",""],[4733,"منادمةُ المرايا","https://www.poetsgate.com/ViewPoem.aspx?id=211536",""],[4755,"مَنَاحَة","https://www.poetsgate.com/ViewPoem.aspx?id=184225",""],[4755,"أَنا مُنهَكٌ أَيُّها المُنهَكُونا","https://www.poetsgate.com/ViewPoem.aspx?id=192452",""],[4814,"محضُ خواء","https://www.poetsgate.com/ViewPoem.aspx?id=192444",""],[4927,"رسالة حب","https://www.poetsgate.com/ViewPoem.aspx?id=29840",""],[4935,"بدا وعلى المحب عطف","https://www.poetsgate.com/ViewPoem.aspx?id=129483",""],[4935,"إلى ولدي وإنساني","https://www.poetsgate.com/ViewPoem.aspx?id=129465",""],[4960,"عَودةُ كعب","https://www.poetsgate.com/ViewPoem.aspx?id=210399",""],[4984,"بريق المرافئ","https://www.poetsgate.com/ViewPoem.aspx?id=175566",""],[231,"الإهداء","https://www.poetsgate.com/ViewPoem.aspx?id=186123",""],[3975,"وَإِنّي من أَرعادكم وَبروقكم","https://www.poetsgate.com/ViewPoem.aspx?id=8290",""],[5277,"منادمة","https://www.poetsgate.com/ViewPoem.aspx?id=206862",""],[5304,"الراتب ما يكفي الحاجه","https://www.poetsgate.com/ViewPoem.aspx?id=155913",""],[5411,"جناح الصبر","https://www.poetsgate.com/ViewPoem.aspx?id=189169",""],[5612,"قَصَدْتُ كريماً","https://www.poetsgate.com/ViewPoem.aspx?id=190617",""],[5616,"موال فلسطيني خاص جدًّا","https://www.poetsgate.com/ViewPoem.aspx?id=205045",""],[5691,"فزاعة","https://www.poetsgate.com/ViewPoem.aspx?id=206387",""],[5725,"على اي جمر","https://www.poetsgate.com/ViewPoem.aspx?id=210930",""],[5732,"اصبر على ضيم الليالي ونكدها","https://www.poetsgate.com/ViewPoem.aspx?id=177837",""],[5732,"مصايب الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=177822",""],[5736,"إيقاع","https://www.poetsgate.com/ViewPoem.aspx?id=203807",""],[5776,"على أيِّ عُشٍّ سوفَ تنمو الغمامةُ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=205836",""],[5843,"أهم إحساسي","https://www.poetsgate.com/ViewPoem.aspx?id=51299",""],[5873,"لوحة المعاني","https://www.poetsgate.com/ViewPoem.aspx?id=215792",""],[5937,"سقوطٌ مُر","https://www.poetsgate.com/ViewPoem.aspx?id=211803",""],[5956,"هنالك في عمق السعود كواكب","https://www.poetsgate.com/ViewPoem.aspx?id=193362",""]],"verses":[["عَلى أَيِّ غَرسٍ آمَنُ الدَهرَ بَعدَما","رَمى فادِحَ الأَيّامِ في الغُصُنِ الرَطبِ",0,"ب",1,1],["عَلى أَيِّ خَلقٍ آمِنُ الدَهرِ بَعدَما","تَباعَدَ ما بَيني وَبَينَ الأَقارِبِ",1,"ب",1,0],["عَلَيَّ أَيادٍ لَهُ جَمَّةٌ","وَفَضلٌ قَديمٌ شَريفُ السَبَب",2,"ب",1,0],["على أي حكم أن لأية حكمة","ببغداد ضاع الحقُّ من غير منشد",3,"د",1,0],["عَلى أَيِّ دينٍ دينُ سَوداءَ إِذ شَوَت","نَواهِضَها وَالكَأسُ يَجري مُدامُها",4,"ه",2,1],["عَلَى أيّ جُرمٍ أَم بأيَّةِ سِيرَةٍ","أُعَنَّفُ في تَقرِيظِهِم وَأُؤنَّبُ",5,"ب",1,0],["على أيمن الأوقات مقدم من له","عصا قلم أضحى بها الشام محروسا",6,"س",2,1],["عَلى أَيِّ الجِنانِ بِنا تَمُرُّ","وَفي أَيِّ الحَدائِقِ تَستَقِرُّ",7,"ر",1,1],["عَلى أَينُقٍ مِثلِ القِسِيِّ سَواهِمٍ","ضَوامِرِ لاحَتها الهَواجِرُ وَالقَفرُ",8,"ر",1,0],["عَلى أَيِّ أَمرٍ مُشكِلٍ أَتَلَوَّمُ","أُقيمُ فَأَشوى أَم أَهُمُّ فَأَعزِمُ",9,"م",1,1],["عَلى أَيِّهِم أَعطى وَلَم يَدرِ مَن هُمُ","أَحَلَّ لَهُم تَعقيلَ أَلفٍ مُصَتَّمِ",10,"م",1,0],["عَلى أَيِّ عِرنينٍ غُلِبنا وَمارِنٍ","وَأَيَّةُ كَفٍّ فارَقَتنا وَساعِدِ",11,"د",1,0],["على أيّ حُكْمِ اللّهِ إذ يأفكونَهُ","أُحِلَّ لهم تقديمُ غيرِ المُقدَّم",12,"م",1,0],["عَلى أَيّ إحسان الحَياة وبرها","أَطيب فؤاداً بالحَياة وأَطمع",13,"ع",1,0],["على أي شيء يقتل البعض بعضنا","وتذكي فظاظات النفوس المطامع",14,"ع",1,0],["على أي عذر تحملون وقد نهت","قوانينكم عن فعلكم والشرائع",15,"ع",1,0],["عَلى أيّ أمْرٍ مُشْكِلٍ أتَلَوّمُ،","أُقِيمُ، فأثْوِي، أمْ أهُمُّ، فأعزِمُ",16,"م",1,1],["على أي حال يندب الشهم ما مضى","وفي كل حال مقتل للفواضل",17,"ل",1,0],["عَلى أَيِّ رَغمٍ ظَلتُ أُغضي وَأكظِمُ","وَعَن أَيِّ حُزنٍ باتَ دَمعي يُتَرجِمُ",18,"م",1,1],["على أي حال كان ان جئت سائلا","ترى الوجه منه قد تهلل بالبشرى",19,"ر",2,0],["على أي حال لليالي أعاتب","وأي صروف للزمان أغالب",20,"ب",1,1],["على أيِّ الجيادِ إذا عرَتْنا","نَفوتُ خُطا المَقاديرِ العِجال",21,"ل",1,0],["على أيّ وَجدٍ طَوَيْتَ الضلوعا","وأجْرَيْتَ ممَّا وَجَدْتَ الدُّموعا",22,"ع",2,1],["على أيّ سمتٍ تقتفيك نشيدتي","وأيّ مسيل أقتري عنك أو رَعْنِ",23,"ن",1,0],["على أيّ لائمةٍ أربعُ","وفي أيِّما سلوةٍ أطمعُ",24,"ع",1,1],["على أيّ أخلاقِ الزمان أعاتبُهْ","وما هو إلا صَرفه ونوائبُهْ",25,"ب",2,1],["على أي شيء منك يستوجب الجفا","قواه وهت مما به والغرائز",26,"ز",1,0],["على أي شيءٍ يرجعُ الخلفُ بينكم","وما سار إلا ليلةً بكم الصلحُ",27,"ح",1,1],["عليُّ أيُّ العلى يُقاسُ إلى","عُلاك إن صَحَّتِ المقاييس",28,"س",1,0],["على أيِّ حالٍ كان لابدَّ لي منك","يميناً بنجم القرط منك إذَا هوى",29,"ه",3,0],["عَلَيَّ أَيا بنُ الشَفيعِ المُطاع","وَيا بنُ المَصابيحِ يا بنَ الغُرَر",30,"ر",1,1],["عَلَى أَيِّ الأمورِ وقفتَ حَقّاً","يُرَى أو باطلاً فَلَهُ دواءُ",31,"ا",2,0],["على أي حالة لا بدّ يبدي","إشارات الرذاله لا محاَلهْ",32,"ل",2,0],["عَلى أَيِّ شَجو تَشتَكي النَفسُ بَعدَهُ","إِلى شَجوِهِ أَو يَذخُرُ الدَمعَ مَدمَعُ",33,"ع",1,0],["على أي شيء نحوه جئت سائلا","فقبل سؤال منك تنظره لبي",34,"ب",2,0],["على أيّة الحالاتِ وافاهُ سائل","لَجدواه ألفاه البشارة بالبُشرِ",35,"ر",1,0],["على أيدي الملوك عَلَت يداهُ","علوّ الباسقات على الودايا",36,"ا",3,0],["على أيها يا غيرة اللَه صبرنا","وكم من دم للَه فيه مضى هدرا",37,"ر",2,0],["عَلى أَيِّ حالٍ فيكَ أَعجَبُ لِلغَدرِ","وَما أَنتَ إِلّا واحِدٌ مِن بَني الدَّهرِ",38,"ر",1,1],["على أي شيء يبتغون مديحهم","أنعطيهم مدحاً بدون عطاء",39,"ا",2,0],["على أي بابٍ أطلب الإذن بعدما","حجبت عن الباب الذي أنا حاجبه",40,"ه",1,1],["عَلى أَي مَرء قَد أَغارت خُيولهم","عَلى ابن الَّذي في الحَرب تَعرفه بَدر",41,"ر",1,0],["على أي الخصال تقر عيني","بعيد الصالحين من الأقارب",42,"ب",1,0],["عَلَى أيِّ حكمٍ فِي الهوى تتركونها","لديكم حياتي أينما تَنْبذونها",43,"ه",2,0],["على أَيِّ شَىءٍ يكونُ الحَسَدْ","وكلُّهم للمَنَايا رَصَدْ",44,"د",1,1],["على أيِّ ذنب يا حريث بن جابر","شددت على رجليَّ إذ جئتك الكبلا",45,"ل",2,1],["على أَيّ شَيء مِن حَياتي أَصونُها","سُرورٌ مَضى عَني وَهمٌّ منادمي",46,"م",2,0],["عَلى أَيّ الأَحبة صرتُ أَبكي","وَمَن أَبكيهم الخلق الكَثير",47,"ر",1,0],["على أَيّ أَمرٍ ما تُساق عِصابةٌ","إِلى السّجْن والَوْا جَدَّك المُتَخَيَّرا",48,"ر",2,0],["على أيمن الأوقات كان ارتحالكا","وفي أيمن الساعات كان احتلاكا",49,"ك",2,1],["عَلى أَي حال شِئتَ كُنتَ مِنَ الهَوى","وَأَعيُنِ صَرف الدَهرِ عَن وُجهَتي رَمَد",50,"د",1,0],["علَى أيِّ شَيْءٍ لا أبالأَبيكُمُ","تُشِيرونَ نَحْوي كلكمْ بالأصابعِ",51,"ع",1,0],["عَلى أَيِّ شيءٍ يا لُؤَيَّ بنَ غالِبٍ","تُجيبونَ من أَجرى عَليَّ وَأَلجَما",52,"م",2,0],["على أي ذنبٍ صدَّ عني بَعد ما","تملَّك قلبي حبُّه وجناني",53,"ن",2,0],["على أيام عمر قد تولّت","وأبقت في الفؤاد جوى دخيلا",54,"ل",2,0],["على أي دمعٍ تحت جفنيك تهجعُ","ومن أي جرحٍ يدمن النزف تدمعُ",55,"ع",1,1],["على أيّ القرى أحني مَشيبي","ويأتي مُرسَلُ المولى لقَبضِي",56,"ض",2,0],["على أَيِّ القَوافِلِ مرَّ يَومي","وقد أضحَى سَبيلا دونَ عابِر",57,"ر",1,0],["على أَيِّ دِينٍ يا خَصِيمِي قَتَلْتَنِي؟!","على أَيِّ دِينٍ كُنتُ مِمَّن تَجَرَّأُوا؟!",58,"ا",1,0],["على أَيِّ دِينٍ يا شَقِيقِي ظَلَمتَنِي","وأدخَلتَنِي فِيمَن أصَابُوا وأَخطَأُوا؟!",58,"ا",1,0],["على أَيِّ دِينٍ كُنتَ حِينَ اقتَلَعتَنِي؟","وهَل كُنتَ بي أو بالدّيَانَاتِ تَعبَأُ!",58,"ا",1,0],["على أَيِّ جَنبَيَّ أَغفُو.. وكُلِّي","عيونٌ تَرَى كُلَّ شَيءٍ عيونا!",59,"ن",2,0],["على أي المفارقِ ضاع َخَطوي","وضيّعني الطريقُ وضاعَ منّي",60,"ن",2,0],["عَلَىْ إِيْقَاْعِ أَشْعَاْرٍ تَسَاْمَتْ","وَشَاْعَتْº لاْ تَزُوْلُº وَلاْ تَبِيْدُ",61,"د",1,0],["على أيدي الجمال غدا","يبر لنا صفا القرقف",62,"ف",1,0],["على أيدي الصفا وافي","إلى ذى الجاه والشأن",63,"ن",1,0],["على أيِّ المرافِئ سوف نرسو؟","نكاد البحر لكنْ لا نكاد",64,"د",1,0],["على أي أوتار المنى أنت عازفُ","وكل قديم من جراحك نازف",65,"ف",1,1],["على أيما حالٍ أراكَ مخلّدي","وباعث أيامي العِذاب السوالفِ",66,"ف",1,0],["عَلى أَي شيء لا أَبا لأبيكم","تشيرون نحوي نحوكم بالأَصابع",67,"ع",1,0],["على أيّ المواجعِ تحضنيني","ودمعي لا يفارقُ مقتليكِ",68,"ك",1,0],["على ايش