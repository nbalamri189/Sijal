{"poems":[[63,"وعليلة اللحظات يشكو قرطها","https://www.aldiwan.net/poem46100.html","الكامل"],[23,"ذهبت بابن الزبعرى وقعة","https://www.aldiwan.net/poem21243.html","الرمل"],[97,"موقفٌ حانَ فاغتنم","https://www.aldiwan.net/poem24754.html","مجزوء الخفيف"],[80,"أخذت سفاقس منك عهد أمان","https://www.aldiwan.net/poem31263.html","الكامل"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[141,"بقيت ولا عزت عليك المطالب","https://www.aldiwan.net/poem11719.html","الطويل"],[209,"ما الذي أنكرت مني","https://www.aldiwan.net/poem46347.html","مجزوء الرمل"],[247,"أمسى سمير قد بان فانقطعا","https://www.aldiwan.net/poem2108.html","المنسرح"],[318,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[374,"أفنظم در ما أره نفيسا","https://www.aldiwan.net/poem59382.html","الكامل"],[390,"شيب لغير أوانه يعتاد","https://www.aldiwan.net/poem53667.html","الكامل"],[454,"كيف رأيتم طلبي وصبري","https://www.aldiwan.net/poem2178.html","الرجز"]],"verses":[["إِذْ شَقَّ أَرْدِيَةَ الشَّقيقِ بِهِ الحيا","فَحَكيْنَهُ بِقلوبِها وَخُدُودِها",0,"د",3,0],["إِذ شَدَدنا شَدَّةً صادِقَةً","فاجَأناكُمُ إِلى سَفحِ الجَبَل",1,"ل",1,0],["إذ شكا الضعفَ سيد ال","بيت خارت به الهِمم",2,"م",1,0],["إذ شبَابي غَضّةٌ أوراقُه","وحديثي تُحَفٌ بين الحسان",3,"ن",1,0],["إذ شكا من شَكاتك الناسُ والبا","سُ وطعنُ القنا وضرب الحسامِ",4,"م",1,0],["إِذَ شُبَّتِ النيرانُ لِلقُرِّ وَالقِرى","فَلا نارَ إِلّا ما يُريهِ الحُباحِبُ",5,"ب",1,0],["إذ شفت يمناك صدرى","من جواه والبلاء",6,"ا",2,0],["إِذ شُبِّهَ الهَيدَبُ العَبامُ مِنَ ال","أَقوامِ سَقباً مُجَلَّلاً فَرَعا",7,"ع",2,0],["إِذ شاهَدوها كَمِثلِ اللُؤلُؤِ النَضِدِ","لَها مَعانَ كَمَوجِ البَحرِ في مَدَدِ",8,"د",1,0],["إذ شُرِّفَت شرفاً جليلاً باذخاً","بوجودكم وتأسست تأسيسا",9,"س",2,0],["اِذ شاهَدَتهُ وَالمَنونُ تطيعُهُ","فيمَن يَهمُّ بِخَطفِهِ وَيَكادُ",10,"د",1,0],["إِذ شالَتِ الحَربُ غَريمَ أَمري","السَيفُ عِزّي وَالإِلَهُ ظَهري",11,"ر",2,0]]}