{"poems":[[65,"وعليلة اللحظات يشكو قرطها","https://www.aldiwan.net/poem46100.html","الكامل"],[23,"ذهبت بابن الزبعرى وقعة","https://www.aldiwan.net/poem21243.html","الرمل"],[99,"موقفٌ حانَ فاغتنم","https://www.aldiwan.net/poem24754.html","مجزوء الخفيف"],[82,"أخذت سفاقس منك عهد أمان","https://www.aldiwan.net/poem31263.html","الكامل"],[82,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[147,"بقيت ولا عزت عليك المطالب","https://www.aldiwan.net/poem11719.html","الطويل"],[215,"ما الذي أنكرت مني","https://www.aldiwan.net/poem46347.html","مجزوء الرمل"],[254,"أمسى سمير قد بان فانقطعا","https://www.aldiwan.net/poem2108.html","المنسرح"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[382,"أفنظم در ما أره نفيسا","https://www.aldiwan.net/poem59382.html","الكامل"],[398,"شيب لغير أوانه يعتاد","https://www.aldiwan.net/poem53667.html","الكامل"],[461,"كيف رأيتم طلبي وصبري","https://www.aldiwan.net/poem2178.html","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77558","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56241","الرجز"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104466","الرجز"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124719","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58343","الرجز"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65141","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89273","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48322","البسيط"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61282","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128946","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125904","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86371","البسيط"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135102","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72476","السريع"],[4767,"بلاغ","https://www.poetsgate.com/ViewPoem.aspx?id=179843",""],[5121,"نشوة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=33517",""],[5596,"من وحي \"بون\"","https://www.poetsgate.com/ViewPoem.aspx?id=206482",""]],"verses":[["إِذْ شَقَّ أَرْدِيَةَ الشَّقيقِ بِهِ الحيا","فَحَكيْنَهُ بِقلوبِها وَخُدُودِها",0,"د",3,0],["إِذ شَدَدنا شَدَّةً صادِقَةً","فاجَأناكُمُ إِلى سَفحِ الجَبَل",1,"ل",1,0],["إذ شكا الضعفَ سيد ال","بيت خارت به الهِمم",2,"م",1,0],["إذ شبَابي غَضّةٌ أوراقُه","وحديثي تُحَفٌ بين الحسان",3,"ن",1,0],["إذ شكا من شَكاتك الناسُ والبا","سُ وطعنُ القنا وضرب الحسامِ",4,"م",1,0],["إِذَ شُبَّتِ النيرانُ لِلقُرِّ وَالقِرى","فَلا نارَ إِلّا ما يُريهِ الحُباحِبُ",5,"ب",1,0],["إذ شفت يمناك صدرى","من جواه والبلاء",6,"ا",2,0],["إِذ شُبِّهَ الهَيدَبُ العَبامُ مِنَ ال","أَقوامِ سَقباً مُجَلَّلاً فَرَعا",7,"ع",2,0],["إِذ شاهَدوها كَمِثلِ اللُؤلُؤِ النَضِدِ","لَها مَعانَ كَمَوجِ البَحرِ في مَدَدِ",8,"د",1,0],["إذ شُرِّفَت شرفاً جليلاً باذخاً","بوجودكم وتأسست تأسيسا",9,"س",2,0],["اِذ شاهَدَتهُ وَالمَنونُ تطيعُهُ","فيمَن يَهمُّ بِخَطفِهِ وَيَكادُ",10,"د",1,0],["إِذ شالَتِ الحَربُ غَريمَ أَمري","السَيفُ عِزّي وَالإِلَهُ ظَهري",11,"ر",2,0],["إِذ شاهَدَ الفيل الَّذي كَالجَبَلِ","يَمشي رُوَيداً كَجمال المحمل",12,"ل",1,0],["إذ شانها في أينما استخفى الحجَلْ","تستتبع الآثار منه بالعجَلْ",13,"ل",1,0],["إذ شمت من بين اختلافات الكسر","رغيف خبز بعضه كان انكسر",14,"ر",1,0],["إذ شدت الشفتان ثم استنطقته","وتكلمت بذنوبكَ الرجلانِ",15,"ن",1,0],["إذْ شعرُهُ","كَذَقنهُ مثلُ",16,"ل",1,0],["اذ شمس فضلك أحرقت بضيائها","من في اعتقادك أكبر الحسداء",17,"ا",2,0],["إذ شرح الروحُ صدرَ طه","فما لإبليس من سبيل",18,"ل",1,0],["إذْ شيّدَ الصُّنْعُ للنّصْرِ العزيزِ بها","مَصانِعاً يبْهَرُ الألْبابَ رائِعُها",19,"ع",3,0],["إِذ شَقَّت العربُ العَصا وَتَقَطَّعوا","شيعاً تَضِلُّ عَنِ الهُدى وَتُعرِّدُ",20,"د",1,0],["اذ شاهدا الخروج غير ممكن","بل مستحيل ذاك بالتأكيد",21,"د",1,0],["إذ شاده رمزا لمجد جاءه","إرثا علاه كابرا من كابر",22,"ر",1,0],["إذ شع نور شعاع في مطالعه","وطبق الأرض إنجاداً وغيطانا",23,"ن",2,0],["إذ شنت العجم غارات السباق إلى","أطراف بلدتنا الحدباء بالحيل",24,"ل",1,0],["إذ شاد ما كان بها داثرا","فأشرقت في حضرة النيرين",25,"ن",1,0],["إذ شع نورٌ ساطع حولها","حتى استنارت منه أركانه",26,"ن",2,0],["إِذْ شُعُورِي يَا حَبِيِبِي مُسْتَبَاحٌ","فَلُقَانَا نَشْوَةُ الْحُبِّ الْفَضِيلِ",27,"ل",1,0],["إذ شجاه رجع لحنٍ خافتٍ","في هزيع الليل سارٍ طرب",28,"ب",1,0]]}