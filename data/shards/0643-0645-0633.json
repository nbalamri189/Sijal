الي تفيض الدمع مدرارا","https://www.aldiwan.net/poem38732.html","البسيط"],[429,"للمرء في حادثات الدهر آمال","https://www.aldiwan.net/poem40075.html","البسيط"],[453,"ما شكاتي من الأنام عداء","https://www.aldiwan.net/poem61578.html","الخفيف"],[453,"أخي حبيبا أياد منك أحمدها","https://www.aldiwan.net/poem61761.html","البسيط"],[458,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[458,"سل في الغضا وصبا الأصائل تنفح","https://www.aldiwan.net/poem56248.html","الكامل"],[464,"نشوات طرفك والقوام الأهيف","https://www.aldiwan.net/poem3147.html","عموديه"],[464,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[464,"عداك وجدي فعد عن عذلي","https://www.aldiwan.net/poem3178.html","عموديه"],[464,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[464,"أشرب على ورد الخدود وغنني","https://www.aldiwan.net/poem3431.html","عموديه"],[477,"عهد الصبا ومعاهد الأحباب","https://www.aldiwan.net/poem15221.html","الكامل"],[482,"فاح عرف المسك من عرف الخزام","https://www.aldiwan.net/poem24551.html","عموديه"],[500,"مطلسم القوم لا تهمل مكانته","https://www.aldiwan.net/poem37775.html","البسيط"],[500,"ما عرفت الولي إلا بدلق","https://www.aldiwan.net/poem37938.html","الخفيف"],[520,"يا زمان العكس قلاب الأمور","https://www.aldiwan.net/poem818.html",""],[558,"بين أهل الجحود والتكذيب","https://www.aldiwan.net/poem34966.html","الخفيف"],[562,"أرثي ويا ليت شعري من سيرثيني","https://www.aldiwan.net/poem52888.html","البسيط"],[575,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"],[575,"رجع الغرام إلى الحبيب الأول","https://www.aldiwan.net/poem3030.html","الكامل"],[575,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[587,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"]],"verses":[["كَم سَقَمٍ مِنكَ أَتى","عَلى عَقابيلِ سَقَم",0,"م",1,0],["كم ساعةٍ للأُنْسِ فيكِ قَضيْتُها","مَنْ نالَها ما فاتَهُ مَقْصودُ",1,"د",1,0],["كَم سَلَّ مِن أَيدي المَنايا أَنفُساً","وَثَنى عِنانَ المَوتِ وَهوَ زُؤامُ",2,"م",1,0],["كَم سَمِعنا مُسائِلاً قَبلَ شِبلي","عاشَ في البَحثِ طارِقاً كُلَّ بابِ",3,"ب",1,0],["كَم سَمِعنا عَن لِسانِ البَرقِ ما","يُزعِجُ الدُنيا إِذا الأُسطولُ عاما",4,"م",2,0],["كَم سُطِّرَت عِندَهُ طُروسُ","بِقِسمَةِ العِزِّ وَالهَوان",5,"ن",1,0],["كَم سَيِّدٍ بِالعِلمِ كا","نَ بِرَغمِهِ لِلجَهلِ عَبدا",6,"د",2,0],["كَم سِقطِ زِندٍ قَد نَما حَتّى غَدا","بُركانَ نارٍ كُلَّ شَيءٍ تَحطِمُ",7,"م",1,0],["كَمُستَعبَري في رَسمِ دارٍ كَأَنَّها","بِوَعساءَ تَنصوها الجَماهيرُ مُهرَقُ",8,"ق",1,0],["كم سائل للدهر أقسمَ قائلاً","والله ما أيامُهُ إلا غُرَرْ",9,"ر",1,0],["كم سقتنا كأس السرور بلحنٍ","وبلحن كأساً من الأشجان",10,"ن",1,0],["كم ساءنا منها ومن وزرائها","عمل بمنفعة المواطن مُجحِف",11,"ف",1,0],["كم سقتمو نجحاً إلى طلبٍ","وبعثتموا نَصراً إلى طَلْب",12,"ب",1,0],["كم سافرت في الجودِ أمواله","يحدو بها من مدحهِ حاد",13,"د",1,0],["كم سمعنا عن فضلِه وشهدنا","فحمدنا المنقول والمعقولا",14,"ل",2,0],["كم سبرنا لهُ تقىً ونوالاً","فوجدنا في الحالتينِ وليّا",15,"ي",2,0],["كم سبسبٍ جابَ مديحٌ لكم","ما جاب من إحسانكم سبسبا",16,"ب",2,0],["كم سمعنا مقالها","وهي تجثو على الرُّكَبْ",17,"ب",1,0],["كم سائقٍ ساقَ المطيَّ يؤمُّهُ","حتى اقتدى بذلولِهِ ممْراحُه",18,"ح",2,0],["كم سرَّني حين ساءني زمنٌ","كم برّني حين عَقَّني البرره",19,"ر",2,0],["كم سنا نورٍ ذكا منه وكم","أطفأ الله به من نائره",20,"ر",2,0],["كم سهلةٍ فيك لا تُكدِي مَحافرها","وصخرةٍ منك تنبي كلّ منقار",21,"ر",1,0],["كم سائل عن نداك قلت له","مُخدَّع بالسؤال منخدع",22,"ع",1,0],["كم سقاني فوك من رِي","قك بالكأس الدهاق",23,"ق",1,0],["كم ساقَ مِنْ صحةٍ وعافيةٍ","إلى شديدٍ ضناهُ قد نُهكا",24,"ك",2,0],["كمستعبِر مستبشرٍ بعد حزنهِ","لبيْنِ خليطٍ قوّضوا ثم خيَّموا",25,"م",3,0],["كَم سارِحٍ في غابَةٍ عِندَ الضُحى","جاءَ المَساءُ فَكانَ بَعضَ الغابِ",26,"ب",1,0],["كَم سامَني جَرعَ الدَوا","وَكَم جَرَعتُ مِنَ المَريرِ",27,"ر",1,0],["كَم سِرتُ في الوادي وَفي الغَديرِ","عَلى شَبيهِ الدُرِّ وَالكافورِ",28,"ر",1,0],["كم سديم بها تدور وشمس","تتناءى عما به من زحام",29,"م",1,0],["كَم ساقَ مِن جَيشٍ إِلَيها فَثَنى","عَسكَرَهُ القَحطُ وَردّه الوَبا",30,"ا",1,0],["كَم سَقاهُم بِشِعرِهِ","مِدحَةً أَو تَعَتُّبا",31,"ب",2,0],["كَم سَبَّحوا لَكَ في الرَوا","حِ وَأَلَّهوكَ لَدى البُكور",32,"ر",1,0],["كم سبجٍ فيها وكم جَزعةٍ","صحيحةِ التدويرِ لم تُثقَبِ",33,"ب",1,0],["كَم سَعيدٍ أَحذاهُ ثَوبَ شَقِيٍِ","وَشَقِيٍّ أَحذاهُ ثَوبَ سَعيدِ",34,"د",1,0],["كَم سَرى مُنفِرٍ لِهامِ رِجالٍ","ساكِنٍ باتَتِ السُيوفُ تُطيرُه",35,"ر",2,0],["كَم سَرِيٍّ تَقَيَّلَ السَروَ عَنهُم","وَاِشتِباهُ الأَخلاقِ عَدوى وَإِلفِ",36,"ف",1,0],["كَم سادِرٍ في الغِيِّ ذَمَّ فِعالَهُ","لَمّا هَوى تَحتَ السيوفِ مُجَدَّلا",37,"ل",2,0],["كم سطوةٍ لك أخملَت من نابهٍ","وصنيعةٍ لك نَبَّهت من خامِلِ",38,"ل",1,0],["كم سالبٍ بِزَّةَ أعدائِه","أطرقَ فيه وهو مَسلوبُ",39,"ب",1,0],["كَم سَتَرى في الناسِ مِن هالِكٍ","وَهالِكٍ حَتّى تُرى هالِكا",40,"ك",2,0],["كَم ساهِرٍ حَرَّمَ لَمسَ الوِساد","وَما أَراهُ سُؤلَهُ وَالمُراد",41,"د",1,1],["كَم سَبَقَت إِلى المِياهِ مِن قَطاً","فَأَورَدَت بِاللَيلِ وَهوَ في قَطَن",42,"ن",1,0],["كم سجدنا وعبدنا الحسن فيها","كيف بالله رجعنا غرباء",43,"ا",2,0],["كَم سامِعٍ بِالعَينِ مِن آلامِهِ","قِيلاً بأفواهِ الدموعِ وقالا",44,"ل",2,0],["كَم سَبيلٍ نَحوَهُ مسلوكةٍ","فهي للقُصّاد كالأمِّ الوَلود",45,"د",1,0],["كم سيئاتٍ وكم خطايا","نادى عليكم بها المنادي",46,"ي",1,0],["كَم سَهرنا مِن قَبل لَيلاً طَويلاً","فَشَكا الصَمتُ فيهِ منّا العَويلا",47,"ل",2,0],["كَم سَخطَةٍ بِتُّ أُخفيها عَلَيهِ كَما","تُخفي الحِجارَةُ فيها مَسكِنَ النارِ",48,"ر",1,0],["كَم ساعَةٍ مِنكَ خَطَّتها مَلائِكَةٌ","أَزهو عَلى الناسِ بِالذَنبِ الَّذي كَتَبوا",49,"ب",3,0],["كَمُستَحرِشٍ مِن عَقرَبٍ دَبَّبَت لَهُ","جُيوشُ الأَعادي أَو جُنودُ الأَساوِدِ",50,"د",1,0],["كَم سَقَينا الحِمامَ شارِبَ ماءٍ","وَمُدامٍ أَو مَن يُسَقّى حَليبا",51,"ب",2,0],["كَم سادَ في مُدَّةِ الأَيّامِ مِن رَجُلٍ","ثُمَّ اِنقَضى فَهوَ مِثلُ المَرءِ لَم يَسُدِ",52,"د",1,0],["كَم سَبَحَت أَربَعٌ جَوارٍ","لَها بِتَسبيحِها حُبورُ",53,"ر",1,1],["كَم سَيِّدٍ جَعَلَتهُ الراحُ مِن خُرُقٍ","وَكانَ كَالهَضبِ مِن ثَهلانَ أَو أُقُرِ",54,"ر",1,0],["كَم سائِلٍ وافى وَدارَكَ سائِلٌ","نَهرَ الغِنى فيها فَعادَ بِنَهرِهِ",55,"ر",2,0],["كَم سامِعِ اللَفظِ قَوّالٌ كَأَنَّهُمُ","تَحتَ البَسيطَةِ ما قالوا وَلا سَمِعوا",56,"ع",3,0],["كَم سَيِّدٍ بارِقُ الجَدوى بِمَيسِمِهِ","ساوَوا بِهِ الجَدِيَ عِندَ الحَتفِ وَالبَرَقا",57,"ق",2,0],["كَم سَلَّتِ الراحُ مِن يُمناكَ خادِعَةً","سَيفَ الرَشادِ وَأَعطَتهُ لِمَن خَتَلَك",58,"ك",1,0],["كَم سارَ مِن سَنَةٍ أَبوهُ فَيا لَهُ","قَطَعَ المَسافَةَ في ثَلاثِ مَراحِلِ",59,"ل",1,0],["كم سُقْتُهُم بِأَمادِيحي وقُدْتُهُم","نحوَ المعالِي فما انْقادُوا ولا انْساقوا",60,"ق",3,0],["كم سَوْسَنٍ لَطفَ الحياءُ بِلَونِهِ","فَأصارَهُ وَرْداً على وَجْناتِهِ",61,"ه",1,1],["كم سفرةٍ لي إلى مغناك فائزة","أغنت لهاك يدي فيها عن السفره",62,"ر",2,0],["كَمْ سَبَنْتَى حَنِقٍ أَقْرَضَهُ","ضَرَمٌ ناباً بِهِ يَسْطو وَظُفْرَا",63,"ر",2,0],["كمْ سَحابٍ مِنْ هَبَاءٍ سَاطِعٍ","أَشْبَهَ المُزْنةَ إِيمَاضاً وَقَطْرَا",63,"ر",2,0],["كَمْ سَبَقَتْنَا أُمَّةٌ فَاتَّحَدَتْ","وَأَدْركَتْ شَأْناً بِهِ مُعْتَدَّا",64,"د",2,0],["كَمْ سَاهِرٍ يَدْعُو لَكِ","الرِّحْمَنَ فِي تِلْكَ اللَّيَالِي",65,"ل",2,0],["كم سياج من الحديد تعفّى","وسياجٍ باقٍ من الآداب",66,"ب",1,0],["كَم سَأَلتُ الأَديبَ رِفقاً وَكَم لُم","تُ عَلَيهِ فَقالَ لا تَثريبا",67,"ب",2,0],["كم ساهرٍ نام لمَّا بتَّ تكلؤُهُ","لولا سُهادك لم يأخذه تغميض",68,"ض",1,0],["كم سلَوْنا عَن صاحبٍ بحبيبٍ","فإذا بالحبيبِ يُخلفُ ظنَّا",69,"ن",2,0],["كم سلاحٍ صالَ من غيرِ يَدٍ","ويدٍ تدفَعُ من غيرِ سِلاَح",70,"ح",1,0],["كَمْ سُؤَالٍ بَعَثْتَ إِثْرَ سُؤَالٍ","أَيْقَظَ النَّائِمينَ رَجْعُ جَوَابِه",71,"ب",2,0],["كم سمِعْنا عَزيفَها من قريبٍ","فغدا الرأْيُ والسدادُ بعيدا",72,"د",2,0],["كم سائرٍ قُدمًا ولكن عينُه","من خلفه تَبكي الزمانَ البائدا!",73,"د",2,0],["كم سَيْطَرَ الحُمْقُ والنَوْكَى على بلدٍ","إذا تُوُورِثَ عرشُ الحُكْمُ في البلدِ",74,"د",1,0],["كم سَقتهم من الشقاء زعافًا","وسقوْها من الوفاء مداما",75,"م",2,0],["كم سَقَتْه من الحليب زبيبًا","أبيض اللون، لا يضيع صوابه",76,"ب",2,0],["كم سَأَلْتُ السَّماءُ عَطْفًا عليهم","ليت شِعْري: هل تستجيب السماءُ؟",77,"ا",2,0],["كم سألنا التفتيش عن جبفة الأث","م وسرنا والإثم يحدو خطانا !",78,"ن",2,0],["كم ساعدتْك على الجُلِّى وكم دَفَعَتْ","هواجساً عن فؤادٍ منكَ \" متعوب \"",79,"ب",1,0],["كَمْ سرَى مُنفِراً لهَامِ رِجَالٍ","ساكِنٍ باتَتِ السّيُوفُ تُطِيرُهْ",80,"ر",2,0],["كم سنة .. ضيعت في نحته ؟","قل لي .. ألم تتعب .. ألم تسأم؟",81,"م",1,0],["كم سقتها من ماء عيني غواد","علمت عارض الغمام انسجاما",82,"م",2,0],["كم سمعنا كلامه فسكرنا","ورأينا الخمر العتيق كلاما",82,"م",2,0],["كم سيد قاد الشعوب","وساسها في الغابرين",83,"ن",1,0],["كَمُستَلحَمٍ في ظُلمَةِ اللَيلِ مِحزِماً","رَأى المَوتَ صِرفاً وَالسُيوفَ بِها تُضمي",84,"ي",1,0],["كم ساجدٍ لمّا سموتَ طالعا","كأنه صلَّى إلى مِحرابِه",85,"ب",2,0],["كَم سَبَقتَ الجارينَ في حَلبَةِ المَج","دِ وَكَلّوا وَما شَكَوتَ لُغوبا",86,"ب",2,0],["كَم سَبَقتَ المُنى بِصَوبِ يَمينٍ","في العَطايا كَثيرَةِ الإِرتِجالِ",87,"ل",1,0],["كم ساهر يرتجى نوما بطلعته","وحائر يرتجي للحزن تسهالا",88,"ل",2,0],["كَمُستَرعِفٍ أَحذى وَدَنَّحَ بَعدَما","غَدا طَلقاً وَاِستَبدَهَتهُ المَطاوِحُ",89,"ح",1,0],["كَم سَيِّدٍ في ظَلامِ النَقعِ غادَرَهُ","شِلواً بِأَبيضَ أَو زَرقاءَ كَالضَرَمِ",90,"م",1,0],["كَم سارَ مِنها في رضاه عرمرمُ","بِحياتهِ صلّوا عليهِ وَسلّموا",91,"م",3,0],["كم سبحنا معا ونحن نشاوى","بسماء الخيال والأوهام",92,"م",1,0],["كم سربلت رحماءَ الناس رحمته","وكم تجرَّد فيمن كان مِرِّيدا",93,"د",2,0],["كم سر مشتاقا وضر مشاققا","افديه في السراء والضراء",94,"ا",2,0],["كَم سَمِعتُ الفَضاءَ يَخفِقُ حَولي","أَتُرى كانَ يَلتَقي طَيفانا",95,"ن",2,0],["كَم سَهِرتُ الساعاتِ في الظلماءِ","أَرصدُ النُجمَ في فَسيحِ الفَضاءِ",96,"ا",2,1],["كَم سَهِرتُ الظَلام أَرعى هَواهُ","وَأَنا شاخِصٌ بِمرشفِ فيهِ",97,"ي",2,0],["كَم ساعةٍ آلَمني مَسُّها","وَأَزعَجَتني يَدُها القاسِيَه",98,"ي",2,1],["كم سَقيتَ السُّمْر من عَطَشٍ","ثم أَنهلتَ السيوفَ دما",99,"م",2,0],["كم سَقَينا عِداك عِنْدَ الإمام ال","عَدْلِ إذ فَنَّدُوا بِسُمّ ذعافِ",100,"ف",1,0],["كم سفكت أجفانه من دَمٍ","نمّت عليهنّ به وَجْنتاه",101,"ا",2,0],["كَم سامَني فيها البَخيلُ وَلَم أَكُن","لَأَشينَ رَونَقَ حُسنِها بِمَشينِ",102,"ن",1,0],["كَم سَلَبوا أَنفُسَ الف