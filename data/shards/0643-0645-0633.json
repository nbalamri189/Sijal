{"poems":[[53,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[77,"الصبر إلا في هواك حميد","https://www.aldiwan.net/poem36607.html","الكامل"],[86,"لا مرحباً بك أيهذا العام","https://www.aldiwan.net/poem10482.html","الكامل"],[86,"سكن الفيلسوف بعد اضطراب","https://www.aldiwan.net/poem10484.html","الخفيف"],[86,"طمع ألقى عن الغرب اللثاما","https://www.aldiwan.net/poem10683.html","الرمل"],[86,"ببابك النحس والسعود","https://www.aldiwan.net/poem68833.html","مخلع البسيط"],[86,"أرأيت رب التاج في","https://www.aldiwan.net/poem68886.html","مجزوء الكامل"],[73,"الدهر إن أملى فصيح أعجم","https://www.aldiwan.net/poem11979.html","الكامل"],[30,"أدارا بحزوى هجت للعين عبرة","https://www.aldiwan.net/poem29554.html","الطويل"],[83,"نفسي الفداء لشادن مهما خطر","https://www.aldiwan.net/poem54307.html","الكامل"],[88,"أم كلثوم في فنون الأغاني","https://www.aldiwan.net/poem44430.html","الخفيف"],[88,"أنا بالحكومة والسياسة أعرف","https://www.aldiwan.net/poem44808.html","الكامل"],[72,"دمعي عليك مجانس قلبي","https://www.aldiwan.net/poem18235.html","أحذ الكامل"],[72,"لحظك في الفتك هو البادي","https://www.aldiwan.net/poem18557.html","السريع"],[72,"بعثت طيفها إلينا رسولا","https://www.aldiwan.net/poem20542.html","الخفيف"],[72,"جاءت العاذلات شيئا فريا","https://www.aldiwan.net/poem20564.html","الخفيف"],[51,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[51,"يا أبا روبة الريب يا مسيحا بغير أب","https://www.aldiwan.net/poem8656.html","مجزوء الخفيف"],[51,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[51,"لا وألحاظ العيون الساحره","https://www.aldiwan.net/poem62878.html","الطويل"],[51,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[51,"هل أنت من مرتجيك مستمع","https://www.aldiwan.net/poem65399.html","المنسرح"],[51,"كان أناس يرون أني في","https://www.aldiwan.net/poem65695.html","المنسرح"],[51,"يا من جلا دهرنا دجاه به","https://www.aldiwan.net/poem65808.html","المنسرح"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[91,"من أين جئت وكيف عجت ببابي","https://www.aldiwan.net/poem8751.html","عموديه"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[91,"كان على خوان رب المال","https://www.aldiwan.net/poem62626.html","عموديه"],[89,"إن فعل الرجال غير الكلام","https://www.aldiwan.net/poem44616.html","الخفيف"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[85,"يا ابن زيدون مرحبا","https://www.aldiwan.net/poem8080.html","مجزوء الخفيف"],[85,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[62,"وكرمة أعراقها في الثرى","https://www.aldiwan.net/poem52501.html","السريع"],[45,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[45,"أوحشت أربع العقيق ودوره","https://www.aldiwan.net/poem63578.html","الخفيف"],[45,"لأخي الحب عبرة ما تجف","https://www.aldiwan.net/poem65151.html","الخفيف"],[45,"إن الأمير أبا علي أصبحت","https://www.aldiwan.net/poem65628.html","الكامل"],[61,"تأبى الصبابة أن تصيخ لعاذل","https://www.aldiwan.net/poem51494.html","الكامل"],[61,"قد أمكن الطالب مطلوب","https://www.aldiwan.net/poem51778.html","السريع"],[49,"خفض هداك الله من بالكا","https://www.aldiwan.net/poem62212.html","السريع"],[66,"كم ساهر حرم لمس الوساد","https://www.aldiwan.net/poem38652.html","السريع"],[66,"كم قد أفضنا من دموع ودما","https://www.aldiwan.net/poem41378.html","الرجز"],[97,"هذه الكعبة كنا طائفيها","https://www.aldiwan.net/poem24799.html","الرمل"],[80,"نهت الكواشح عنه والعذالا","https://www.aldiwan.net/poem31323.html","الكامل"],[80,"أين مني عتب أحباب هجود","https://www.aldiwan.net/poem31481.html","الرمل"],[69,"قالوا فساد الهواء يردي","https://www.aldiwan.net/poem29249.html","مخلع البسيط"],[102,"قم حبيبي وأطفئ المصباحا","https://www.aldiwan.net/poem33110.html","الخفيف"],[52,"سقيا لدار بنهر الكرخ من دار","https://www.aldiwan.net/poem26978.html","البسيط"],[48,"فديت من تم فيه الظرف والأدب","https://www.aldiwan.net/poem10814.html","البسيط"],[50,"ألا من لصب عازب النوم ساهد","https://www.aldiwan.net/poem63940.html","الطويل"],[46,"زعموا أن ما يذكر إن قا","https://www.aldiwan.net/poem22145.html","الخفيف"],[46,"خدر العروس وإن كانت محببة","https://www.aldiwan.net/poem22460.html","البسيط"],[46,"كم سبحت أربع جوار","https://www.aldiwan.net/poem22555.html","مجزوء البسيط"],[46,"أمسى خليلك عند اللب محتقرا","https://www.aldiwan.net/poem22661.html","البسيط"],[46,"سألت منجمها عن الطفل الذي","https://www.aldiwan.net/poem22701.html","الكامل"],[46,"دولاتكم شمعات يستضاء بها","https://www.aldiwan.net/poem22935.html","البسيط"],[46,"جاء القران وأم الله أرسله","https://www.aldiwan.net/poem23037.html","البسيط"],[46,"إن كنت ذارع أرض لم ألمك بها","https://www.aldiwan.net/poem23104.html","البسيط"],[46,"عز الذي بالموت رد غنينا","https://www.aldiwan.net/poem23252.html","الكامل"],[76,"ساق ترنح يشدو فوقه ساق","https://www.aldiwan.net/poem39256.html","البسيط"],[76,"كم سوسن لطف الحياء بلونه","https://www.aldiwan.net/poem39473.html","الكامل"],[72,"","https://poetry.dctabudhabi.ae/diwan/poem/40678","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54693","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55182","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142021","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23960","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54246","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[106,"يا راعي الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179702",""],[106,"صدى الجمهورية","https://www.poetsgate.com/ViewPoem.aspx?id=179586",""],[106,"الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=179448",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[90,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[45,"أُوحِشَتْ أرْبُعُ العَقيقِ وَدُورُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31336",""],[99,"فم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=299&r=&rc=32",""]],"verses":[["كَم سَقَمٍ مِنكَ أَتى","عَلى عَقابيلِ سَقَم",0,"م",1,0],["كم ساعةٍ للأُنْسِ فيكِ قَضيْتُها","مَنْ نالَها ما فاتَهُ مَقْصودُ",1,"د",1,0],["كَم سَلَّ مِن أَيدي المَنايا أَنفُساً","وَثَنى عِنانَ المَوتِ وَهوَ زُؤامُ",2,"م",1,0],["كَم سَمِعنا مُسائِلاً قَبلَ شِبلي","عاشَ في البَحثِ طارِقاً كُلَّ بابِ",3,"ب",1,0],["كَم سَمِعنا عَن لِسانِ البَرقِ ما","يُزعِجُ الدُنيا إِذا الأُسطولُ عاما",4,"م",2,0],["كَم سُطِّرَت عِندَهُ طُروسُ","بِقِسمَةِ العِزِّ وَالهَوان",5,"ن",1,0],["كَم سَيِّدٍ بِالعِلمِ كا","نَ بِرَغمِهِ لِلجَهلِ عَبدا",6,"د",2,0],["كَم سِقطِ زِندٍ قَد نَما حَتّى غَدا","بُركانَ نارٍ كُلَّ شَيءٍ تَحطِمُ",7,"م",1,0],["كَمُستَعبَري في رَسمِ دارٍ كَأَنَّها","بِوَعساءَ تَنصوها الجَماهيرُ مُهرَقُ",8,"ق",1,0],["كم سائل للدهر أقسمَ قائلاً","والله ما أيامُهُ إلا غُرَرْ",9,"ر",1,0],["كم سقتنا كأس السرور بلحنٍ","وبلحن كأساً من الأشجان",10,"ن",1,0],["كم ساءنا منها ومن وزرائها","عمل بمنفعة المواطن مُجحِف",11,"ف",1,0],["كم سقتمو نجحاً إلى طلبٍ","وبعثتموا نَصراً إلى طَلْب",12,"ب",1,0],["كم سافرت في الجودِ أمواله","يحدو بها من مدحهِ حاد",13,"د",1,0],["كم سمعنا عن فضلِه وشهدنا","فحمدنا المنقول والمعقولا",14,"ل",2,0],["كم سبرنا لهُ تقىً ونوالاً","فوجدنا في الحالتينِ وليّا",15,"ي",2,0],["كم سبسبٍ جابَ مديحٌ لكم","ما جاب من إحسانكم سبسبا",16,"ب",2,0],["كم سمعنا مقالها","وهي تجثو على الرُّكَبْ",17,"ب",1,0],["كم سائقٍ ساقَ المطيَّ يؤمُّهُ","حتى اقتدى بذلولِهِ ممْراحُه",18,"ح",2,0],["كم سرَّني حين ساءني زمنٌ","كم برّني حين عَقَّني البرره",19,"ر",2,0],["كم سنا نورٍ ذكا منه وكم","أطفأ الله به من نائره",20,"ر",2,0],["كم سهلةٍ فيك لا تُكدِي مَحافرها","وصخرةٍ منك تنبي كلّ منقار",21,"ر",1,0],["كم سائل عن نداك قلت له","مُخدَّع بالسؤال منخدع",22,"ع",1,0],["كم سقاني فوك من رِي","قك بالكأس الدهاق",23,"ق",1,0],["كم ساقَ مِنْ صحةٍ وعافيةٍ","إلى شديدٍ ضناهُ قد نُهكا",24,"ك",2,0],["كمستعبِر مستبشرٍ بعد حزنهِ","لبيْنِ خليطٍ قوّضوا ثم خيَّموا",25,"م",3,0],["كَم سارِحٍ في غابَةٍ عِندَ الضُحى","جاءَ المَساءُ فَكانَ بَعضَ الغابِ",26,"ب",1,0],["كَم سامَني جَرعَ الدَوا","وَكَم جَرَعتُ مِنَ المَريرِ",27,"ر",1,0],["كَم سِرتُ في الوادي وَفي الغَديرِ","عَلى شَبيهِ الدُرِّ وَالكافورِ",28,"ر",1,0],["كم سديم بها تدور وشمس","تتناءى عما به من زحام",29,"م",1,0],["كَم ساقَ مِن جَيشٍ إِلَيها فَثَنى","عَسكَرَهُ القَحطُ وَردّه الوَبا",30,"ا",1,0],["كَم سَقاهُم بِشِعرِهِ","مِدحَةً أَو تَعَتُّبا",31,"ب",2,0],["كَم سَبَّحوا لَكَ في الرَوا","حِ وَأَلَّهوكَ لَدى البُكور",32,"ر",1,0],["كم سبجٍ فيها وكم جَزعةٍ","صحيحةِ التدويرِ لم تُثقَبِ",33,"ب",1,0],["كَم سَعيدٍ أَحذاهُ ثَوبَ شَقِيٍِ","وَشَقِيٍّ أَحذاهُ ثَوبَ سَعيدِ",34,"د",1,0],["كَم سَرى مُنفِرٍ لِهامِ رِجالٍ","ساكِنٍ باتَتِ السُيوفُ تُطيرُه",35,"ر",2,0],["كَم سَرِيٍّ تَقَيَّلَ السَروَ عَنهُم","وَاِشتِباهُ الأَخلاقِ عَدوى وَإِلفِ",36,"ف",1,0],["كَم سادِرٍ في الغِيِّ ذَمَّ فِعالَهُ","لَمّا هَوى تَحتَ السيوفِ مُجَدَّلا",37,"ل",2,0],["كم سطوةٍ لك أخملَت من نابهٍ","وصنيعةٍ لك نَبَّهت من خامِلِ",38,"ل",1,0],["كم سالبٍ بِزَّةَ أعدائِه","أطرقَ فيه وهو مَسلوبُ",39,"ب",1,0],["كَم سَتَرى في الناسِ مِن هالِكٍ","وَهالِكٍ حَتّى تُرى هالِكا",40,"ك",2,0],["كَم ساهِرٍ حَرَّمَ لَمسَ الوِساد","وَما أَراهُ سُؤلَهُ وَالمُراد",41,"د",1,1],["كَم سَبَقَت إِلى المِياهِ مِن قَطاً","فَأَورَدَت بِاللَيلِ وَهوَ في قَطَن",42,"ن",1,0],["كم سجدنا وعبدنا الحسن فيها","كيف بالله رجعنا غرباء",43,"ا",2,0],["كَم سامِعٍ بِالعَينِ مِن آلامِهِ","قِيلاً بأفواهِ الدموعِ وقالا",44,"ل",2,0],["كَم سَبيلٍ نَحوَهُ مسلوكةٍ","فهي للقُصّاد كالأمِّ الوَلود",45,"د",1,0],["كم سيئاتٍ وكم خطايا","نادى عليكم بها المنادي",46,"ي",1,0],["كَم سَهرنا مِن قَبل لَيلاً طَويلاً","فَشَكا الصَمتُ فيهِ منّا العَويلا",47,"ل",2,0],["كَم سَخطَةٍ بِتُّ أُخفيها عَلَيهِ كَما","تُخفي الحِجارَةُ فيها مَسكِنَ النارِ",48,"ر",1,0],["كَم ساعَةٍ مِنكَ خَطَّتها مَلائِكَةٌ","أَزهو عَلى الناسِ بِالذَنبِ الَّذي كَتَبوا",49,"ب",3,0],["كَمُستَحرِشٍ مِن عَقرَبٍ دَبَّبَت لَهُ","جُيوشُ الأَعادي أَو جُنودُ الأَساوِدِ",50,"د",1,0],["كَم سَقَينا الحِمامَ شارِبَ ماءٍ","وَمُدامٍ أَو مَن يُسَقّى حَليبا",51,"ب",2,0],["كَم سادَ في مُدَّةِ الأَيّامِ مِن رَجُلٍ","ثُمَّ اِنقَضى فَهوَ مِثلُ المَرءِ لَم يَسُدِ",52,"د",1,0],["كَم سَبَحَت أَربَعٌ جَوارٍ","لَها بِتَسبيحِها حُبورُ",53,"ر",1,1],["كَم سَيِّدٍ جَعَلَتهُ الراحُ مِن خُرُقٍ","وَكانَ كَالهَضبِ مِن ثَهلانَ أَو أُقُرِ",54,"ر",1,0],["كَم سائِلٍ وافى وَدارَكَ سائِلٌ","نَهرَ الغِنى فيها فَعادَ بِنَهرِهِ",55,"ر",2,0],["كَم سامِعِ اللَفظِ قَوّالٌ كَأَنَّهُمُ","تَحتَ البَسيطَةِ ما قالوا وَلا سَمِعوا",56,"ع",3,0],["كَم سَيِّدٍ بارِقُ الجَدوى بِمَيسِمِهِ","ساوَوا بِهِ الجَدِيَ عِندَ الحَتفِ وَالبَرَقا",57,"ق",2,0],["كَم سَلَّتِ الراحُ مِن يُمناكَ خادِعَةً","سَيفَ الرَشادِ وَأَعطَتهُ لِمَن خَتَلَك",58,"ك",1,0],["كَم سارَ مِن سَنَةٍ أَبوهُ فَيا لَهُ","قَطَعَ المَسافَةَ في ثَلاثِ مَراحِلِ",59,"ل",1,0],["كم سُقْتُهُم بِأَمادِيحي وقُدْتُهُم","نحوَ المعالِي فما انْقادُوا ولا انْساقوا",60,"ق",3,0],["كم سَوْسَنٍ لَطفَ الحياءُ بِلَونِهِ","فَأصارَهُ وَرْداً على وَجْناتِهِ",61,"ه",1,1],["كم سفرةٍ لي إلى مغناك فائزة","أغنت لهاك يدي فيها عن السفره",62,"ر",2,0],["كَمْ سَبَنْتَى حَنِقٍ أَقْرَضَهُ","ضَرَمٌ ناباً بِهِ يَسْطو وَظُفْرَا",63,"ر",2,0],["كمْ سَحابٍ مِنْ هَبَاءٍ سَاطِعٍ","أَشْبَهَ المُزْنةَ إِيمَاضاً وَقَطْرَا",63,"ر",2,0],["كَمْ سَبَقَتْنَا أُمَّةٌ فَاتَّحَدَتْ","وَأَدْركَتْ شَأْناً بِهِ مُعْتَدَّا",64,"د",2,0],["كَمْ سَاهِرٍ يَدْعُو لَكِ","الرِّحْمَنَ فِي تِلْكَ اللَّيَالِي",65,"ل",2,0],["كم سياج من الحديد تعفّى","وسياجٍ باقٍ من الآداب",66,"ب",1,0],["كَم سَأَلتُ الأَديبَ رِفقاً وَكَم لُم","تُ عَلَيهِ فَقالَ لا تَثريبا",67,"ب",2,0],["كم ساهرٍ نام لمَّا بتَّ تكلؤُهُ","لولا سُهادك لم يأخذه تغميض",68,"ض",1,0],["كم سلَوْنا عَن صاحبٍ بحبيبٍ","فإذا بالحبيبِ يُخلفُ ظنَّا",69,"ن",2,0],["كم سلاحٍ صالَ من غيرِ يَدٍ","ويدٍ تدفَعُ من غيرِ سِلاَح",70,"ح",1,0],["كَمْ سُؤَالٍ بَعَثْتَ إِثْرَ سُؤَالٍ","أَيْقَظَ النَّا