{"poems":[[53,"لو كان يرتدع القضاء بمردع","https://www.aldiwan.net/poem30148.html","الكامل"],[53,"أبكيك لو نقع الغليل بكائي","https://www.aldiwan.net/poem30779.html","الكامل"],[42,"من ذا الذي بإخائه وبوده","https://www.aldiwan.net/poem50302.html","الكامل"],[86,"أيها الوسمي زر نبت الربا","https://www.aldiwan.net/poem10855.html","الرمل"],[86,"أدلال ذاك أم كسل","https://www.aldiwan.net/poem68842.html","المديد"],[93,"فجع القريض وقد ثوى حسان","https://www.aldiwan.net/poem11217.html","البسيط"],[88,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[27,"هاج الهوى لفؤادك المهتاج","https://www.aldiwan.net/poem5696.html","الكامل"],[27,"يا عقب لا عقب لي في البيت أسمعه","https://www.aldiwan.net/poem5755.html","البسيط"],[47,"أيحلو لمن لا صبر ينجده صبر","https://www.aldiwan.net/poem25288.html","الطويل"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[51,"قل لمن ألبس الجمال جمالا","https://www.aldiwan.net/poem65878.html","الخفيف"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"أيها الشاتمي في كل حين","https://www.aldiwan.net/poem66532.html","الخفيف"],[26,"أمن المنون وريبها تتوجع","https://www.aldiwan.net/poem24106.html","الكامل"],[92,"عذبة أنت كالطفولة كالأح","https://www.aldiwan.net/poem38954.html","الخفيف"],[89,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[89,"ويل لمملكة قضى اهمالها","https://www.aldiwan.net/poem44846.html","الكامل"],[89,"جو السياسة مكفهر","https://www.aldiwan.net/poem44852.html","مجزوء الكامل"],[85,"أم الملائك والبدور","https://www.aldiwan.net/poem6815.html","مجزوء الكامل"],[85,"نزل المناهل والربى آذار","https://www.aldiwan.net/poem7051.html","الكامل"],[85,"بعثوا الخلافة سيرة في النادى","https://www.aldiwan.net/poem7110.html","الكامل"],[85,"لمن المساكن كالمقابر","https://www.aldiwan.net/poem7768.html","مجزوء الكامل"],[85,"كم لنا من عجيبة","https://www.aldiwan.net/poem7784.html","مجزوء الخفيف"],[85,"نبذ الهوى وصحا من الأحلام","https://www.aldiwan.net/poem8104.html","الكامل"],[85,"سر يا صليب الرفق في ساح الوغى","https://www.aldiwan.net/poem63731.html","الطويل"],[85,"رضي المسلمون والإسلام","https://www.aldiwan.net/poem63740.html","الخفيف"],[85,"العام أقبل قم نحي هلالا","https://www.aldiwan.net/poem63751.html","الكامل"],[85,"أيامكم أم عهد إسماعيلا","https://www.aldiwan.net/poem63755.html","الكامل"],[56,"ما أنت مني ولا ربعاك لي وطر","https://www.aldiwan.net/poem58594.html","البسيط"],[62,"الحمد لله الذي خصنا","https://www.aldiwan.net/poem52220.html","السريع"],[61,"نوب الزمان قلائد الأعناق","https://www.aldiwan.net/poem51346.html","الكامل"],[61,"وسألت عنه فقيل مات لما به","https://www.aldiwan.net/poem51761.html","الكامل"],[58,"ألا باعد الله أهل النفاق","https://www.aldiwan.net/poem30893.html","المتقارب"],[49,"عيب ابن آدم ما علمت كثير","https://www.aldiwan.net/poem62077.html","الكامل"],[49,"ربما ضاق الفتى ثم اتسع","https://www.aldiwan.net/poem62157.html","الرمل"],[66,"من نفخة الصور أم من نفحة الصور","https://www.aldiwan.net/poem41361.html","البسيط"],[97,"راحوا بأرواحٍ ظماء","https://www.aldiwan.net/poem24773.html","مجزوء الكامل"],[87,"أي شيء يبقى على الحدثان","https://www.aldiwan.net/poem8231.html","الخفيف"],[74,"رفعت عليك عويلها الأمجاد","https://www.aldiwan.net/poem12905.html","الكامل"],[105,"لمن الجلال يفوق كل جلال","https://www.aldiwan.net/poem41929.html","الكامل"],[105,"أمم العروبة جاء يومك فاعلمي","https://www.aldiwan.net/poem41936.html","الكامل"],[105,"أعد الرجاء وجدد الأملا","https://www.aldiwan.net/poem42045.html","أحذ الكامل"],[105,"لك من تحيات القلوب مواكب","https://www.aldiwan.net/poem42053.html","الكامل"],[105,"رددوا الذكرى لقوم غافلين","https://www.aldiwan.net/poem42065.html","الرمل"],[105,"يا بريد النيل إن جئت الشآما","https://www.aldiwan.net/poem42115.html","الرمل"],[105,"طف بالمصارع واستمع نجواها","https://www.aldiwan.net/poem44218.html","الكامل"],[21,"اقترب الوعد والقلوب إلى","https://www.aldiwan.net/poem36191.html","المنسرح"],[22,"يا جفنة ترك ابن هوذة خلفه","https://www.aldiwan.net/poem21665.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[75,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[48,"يزيد ماذا دهاكا","https://www.aldiwan.net/poem64487.html","المجتث"],[50,"ريق سعدى يا ابن الدجيل الشفاء","https://www.aldiwan.net/poem64890.html","الخفيف"],[19,"عيني لا بد من سكب وتهمال","https://www.aldiwan.net/poem360.html",""],[8,"هل بالديار الغداة من صمم","https://www.aldiwan.net/poem21838.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85330","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85499","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85568","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39678","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42570","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54244","الكامل"],[106,"مهبِط الوحي","https://www.poetsgate.com/ViewPoem.aspx?id=179626",""],[106,"رسل الثقافة","https://www.poetsgate.com/ViewPoem.aspx?id=179609",""],[106,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[106,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[18,"كُنَّا نَغَارُ عَلَى الْعَوَاتِقِ أَنْ تَرَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26470&r=&rc=36",""]],"verses":[["أَم مَن يُبَلِّغُ بِالبَلاغَةِ غايَةً","تَلوي بِحَسرى طالِبينَ وَظُلَّعِ",0,"ع",1,0],["أَم مَن يَرُدُّ مِنَ المُغيرَةِ غَربَها","وَالخَيلُ تَنهَضُ كَالقَطا بِالدُرَّعِ",0,"ع",1,0],["أَم مَن يَلِطُّ عَلَيَّ سِترَ دُعائِهِ","حَرَماً مِنَ البَأساءِ وَالضَرّاءِ",1,"ا",2,0],["أَم مُمسِكٌ بِوصالِ خِلٍّ ناصِحٍ","مَحض الأُخوَّة مِثلُهُ لا يُطرَحُ",2,"ح",1,0],["أُمَمٌ تَفنى وَأَركانٌ تَهي","وَعُروشٌ تَتَهاوى وَسُرُر",3,"ر",1,0],["أَم مَشوقٌ مُغرَمٌ وَلِهٌ","شَفَّهُ التَشبيبُ وَالغَزَلُ",4,"ل",1,0],["أَمَمُ العُرُوبَةِ شَاطَرَتْهُمْ حُزْنَهُمْ","أَوَ مَا بَنُوهَا كُلُّهُمْ إِخْوَانُ",5,"ن",1,0],["أم من وجود له اختفاء","إلى وجود بلا اختفاء",6,"ا",2,0],["أَم مَن يَغارُ عَلى النِساءِ حَفيظَةً","إِذ لا يَثِقنَ بِغَيرَةِ الأَزواجِ",7,"ج",1,0],["أَم مَن لِبابٍ إِذا ما اِشتَدَّ حاجِبُهُ","أَم مَن لِخَصمٍ بَعيدِ السَأوِ خَطّارِ",8,"ر",1,0],["أَم مَن يَقومُ بِفاروقٍ إِذا اِختَلَفَت","غَياطِلُ الشَكِّ مِن وَردٍ وَإِصدارِ",8,"ر",1,0],["أَمُمعِنَةً في العَذلِ رِفقاً بِقَلبِهِ","أَيَحمِلُ ذا قَلبٌ وَلو أَنَّهُ صَخرُ",9,"ر",1,0],["أم من تَهشُّ له فيرجفُ قلبُهُ","خَوفَ المفاقر غير ذي وسواس",10,"س",1,0],["أم متى لم أرَ الكثيرَ قليلاً","لك بالحقّ نيةً وانتحالا",11,"ل",2,0],["أم ملال عراكَ مني فأنَّى","حان قبل اللقاءِ حينُ الملالِ",12,"ل",1,0],["أمُّ من شئتُ من أَعاديَّ ظهر","أمتطيه بقُدرةِ الشيطان",13,"ن",1,0],["أَم ما لِجَنبِكَ لا يُلائِمُ مَضجَعاً","إِلّا أَقَضَّ عَلَيكَ ذاكَ المَضجَعُ",14,"ع",1,0],["أَم ملاكُ الفردوس جاءَ إلى الأَر","ضِ ليُحيي روحَ السَّلامِ العهيدِ",15,"د",1,0],["امم كلها تبيد فتأتي","امم اخرى بعدها للبيود",16,"د",1,0],["امم اذلتها سياسة قسوة","من اقوياء يسرهم اذلالها",17,"ل",3,0],["امم تقدم والكفا","ح على السلامة مستمر",18,"ر",1,0],["أم من كريمات الحسي","ن صباحه يوم النقور",19,"ر",1,0],["أمم من الإسلام يجمع بيننا","ماض وأحداث خلون كبار",20,"ر",1,0],["أمم كملموم القطيع ترى لهم","شمل الجميع وفرقة الآحاد",21,"د",1,0],["أمم يكاثرها الحصى","عدّا وليس لها بكاثر",22,"ر",1,0],["أمم قد تغيرت","وبلاد تولتِ",23,"ت",1,0],["أُمَمٌ وَراءَ الكَهفِ جُهدُ حَياتِهِم","حَرَكاتُ عَيشٍ في سُكونِ حِمامِ",24,"م",1,0],["أُمَمُ الحَضارَةِ أَنتُمُ آباؤُنا","مِنكُم أَخَذنا العِلمَ وَالعِرفانا",25,"ن",2,0],["أَم مِنَ الناسِ بَعدُ مَن قَولُهُ وَح","يٌ كَريمٌ وَفِعلُهُ إِلهامُ",26,"م",1,0],["أُمَمَ الهِلالِ مَقالَةً مِن صادِقٍ","وَالصِدقُ أَليَقُ بِالرِجالِ مَقالا",27,"ل",2,0],["أَم مِن صِيانَتِكَ القَضاءَ بِمِصرَ أَن","تَأتي بِقاضي دِنشِوايَ وَكيلا",28,"ل",2,0],["أَمْ مَنْ حَوى قَصَباتِ السّبْقِ دوَنهُمُ","يومَ القَليبِ وفي أَعْناقِهِمْ زَوَرُ",29,"ر",1,0],["أَمْ مَنْ رَسَا يومَ أُحْدٍ ثابتاً قَدَماً","وفي حُنَينٍ وسَلْعٍ بَعْدَمَا عَثَرُوا",29,"ر",3,0],["أَمْ مَنْ غَدا داحِياً بابَ القُمُوصِ لَهُمْ","وفاتحاً خَيْبراً مِنْ بَعْدِما كُسِرُوا",29,"ر",3,0],["أم ملوك الأرض في جوفها","جنينها الأبيض والأحمر",30,"ر",1,0],["أمم السجية لا الجفون غريقة","وجدا ولا الأشجان في إغراق",31,"ق",1,0],["أم من يُرَجِّي بعدَه صرَفَ الرَّدى","عن نفسِه بجِلادِه وضِرابِه",32,"ب",2,0],["أَممن أَبِن لِيَ فَأَنبأتُهُ","بارجافِ ذي الحَسَدِ الداغِلِ",33,"ل",1,0],["أَم ما تَقولُ إِذا ظَعَنتَ إِلى البَلى","وَإِذا خَلا بِكَ مُنكَرٌ وَنَكيرُ",34,"ر",1,0],["أُمَمٌ مَزروعَةٌ مَحصودَةٌ","كُلُّ مَزروعٍ فَلِلحَصدِ زُرِع",35,"ع",1,0],["أَم مِن شَذا نَسمَةِ الفِردوسِ حينَ سَرَت","عَلى بَليلٍ مِنَ الأَزهارِ مَمطورِ",36,"ر",1,0],["أمَمٌ يُصبِّرُ بعضُها","بعضاً وهيهات العزاء",37,"ا",2,0],["أُمَمٌ أَخْلَدَتْ إِلَى الدَّهْرِ حِيناً","ثُمَّ ضَاعَتْ فِي لُجَّةِ النِّسْيَانِ",38,"ن",1,0],["أُمَمٌ يَغُصُّ بِها الفَضاءُ طَوَتهُمُ","كَفُّ الرَدى طَيَّ الرِداءِ فَبادوا",39,"د",3,0],["أمَمُ العُروبة إن تَتَابَع شُكرُها","فَلِفَضْلِها المُتتابِع المتوالي",40,"ل",2,0],["أُمَمَ العُروبةِ جاءَ يومُكِ فاعْلَمِي","وإلى مكانكِ فانهَضِي وتقدَّمي",41,"م",2,1],["أُمَمَ العُروبةِ أين أنْتِ فقد طَغَى","سَيْلُ الأَذَى في موجهِ المُتَضرِّمِ",41,"م",1,0],["أُمَمَ العُروبةِ لا نجاةَ لِمُدْبِرٍ","يبغِي النّجاةَ ولا حَياةَ لِمُحْجمِ",41,"م",1,0],["أُمَمَ العُروبةِ جَدَّ جِدُّكِ فانْظِمي","من عِقدِكِ المنثورِ ما لم يُنْظَمِ",41,"م",1,0],["أُمَمٌ يَظَلُّ الجَهْلُ يَقْتُلُها","فَتزيدُ جَهْلاً كُلّما قَتلا",42,"ل",2,0],["أُمَمُ العروبةِ أكبرت لك نجدةً","رَضِيَ اللّهيفُ بها وكَفَّ العاتِبُ",43,"ب",1,0],["أُمَمُ الدُّنيا إذا ما صَلُحَتْ","ف