com/ViewPoem.aspx?id=215432",""],[3591,"أممت نزهة نفس خارج البلد","https://www.poetsgate.com/ViewPoem.aspx?id=149392",""],[5120,"وَ يَنْتَهِي اَلْإِغْرَاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=184371",""],[5183,"الحزن العميق","https://www.poetsgate.com/ViewPoem.aspx?id=180262",""],[5183,"مصيبة العلم","https://www.poetsgate.com/ViewPoem.aspx?id=180257",""],[5183,"السمحاء","https://www.poetsgate.com/ViewPoem.aspx?id=180179",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5213,"أعلى السفح تعرفت الديارا","https://www.poetsgate.com/ViewPoem.aspx?id=170459",""],[5277,"القصيدةُ الذئبية","https://www.poetsgate.com/ViewPoem.aspx?id=193351",""],[5295,"فجر المنى","https://www.poetsgate.com/ViewPoem.aspx?id=159305",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5338,"معارضة قصيدة بات سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=187941",""],[5351,"وجع الجبال","https://www.poetsgate.com/ViewPoem.aspx?id=202145",""],[5362,"أهنيك بالعيد أم بالظفر","https://www.poetsgate.com/ViewPoem.aspx?id=170387",""],[5409,"يا شبابي لم يصبني لك ذكر","https://www.poetsgate.com/ViewPoem.aspx?id=155268",""],[5425,"نَورَسَةُ الهَور","https://www.poetsgate.com/ViewPoem.aspx?id=198930",""],[5431,"هيتَ له ....","https://www.poetsgate.com/ViewPoem.aspx?id=202400",""],[5436,"بغداد/ للشاعر زهير شيخ تراب","https://www.poetsgate.com/ViewPoem.aspx?id=152682",""],[5512,"قمحانة ( هل نعشق )","https://www.poetsgate.com/ViewPoem.aspx?id=204385",""],[5518,"سِدرةُ المنتهَى","https://www.poetsgate.com/ViewPoem.aspx?id=206241",""],[470,"في عيد ميلادها","https://www.poetsgate.com/ViewPoem.aspx?id=178041",""],[5582,"أَتَجْحَدُ داءَ الحُبِّ عِنْدَ المُشاهِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186906",""],[5689,"هل طي عرفك لي يا نسمة السحر","https://www.poetsgate.com/ViewPoem.aspx?id=143428",""],[5689,"ما بال دمعك ينهمر","https://www.poetsgate.com/ViewPoem.aspx?id=143433",""],[5720,"سَيِّدِيﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=200126",""],[5815,"غصّة","https://www.poetsgate.com/ViewPoem.aspx?id=190032",""],[5829,"دعونا وشأننا","https://www.poetsgate.com/ViewPoem.aspx?id=178059",""],[5885,"أشتار من جمالها","https://www.poetsgate.com/ViewPoem.aspx?id=203026",""],[5906,"غدا يشيّعنا التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=193749",""],[5956,"أنعمْ بسيفٍ صارمٍ كأبيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=193096",""],[5975,"وسائلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=58501",""],[6012,"غاض القريض وأذوت نضرة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=181633",""],[6102,"طيب","https://www.poetsgate.com/ViewPoem.aspx?id=184439",""],[469,"أمن الهجر سيفه فهو لا ين","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574767",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6218,"عبير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65866&r=&rc=20",""],[6290,"هَلْ تَسْتَقِيمُ جُذُوعُنَا يَوْماً؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85166&r=&rc=16",""],[6305,"حياتي ... أنْ أموتَ فِداك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87348&r=&rc=22",""],[6355,"بداية الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66551&r=&rc=11",""],[572,"أيُّ حِرَاكٍ غالَ منكَ السكونْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9491&r=&rc=348",""]],"verses":[["أَم مَن يُبَلِّغُ بِالبَلاغَةِ غايَةً","تَلوي بِحَسرى طالِبينَ وَظُلَّعِ",0,"ع",1,0],["أَم مَن يَرُدُّ مِنَ المُغيرَةِ غَربَها","وَالخَيلُ تَنهَضُ كَالقَطا بِالدُرَّعِ",0,"ع",1,0],["أَم مَن يَلِطُّ عَلَيَّ سِترَ دُعائِهِ","حَرَماً مِنَ البَأساءِ وَالضَرّاءِ",1,"ا",2,0],["أَم مُمسِكٌ بِوصالِ خِلٍّ ناصِحٍ","مَحض الأُخوَّة مِثلُهُ لا يُطرَحُ",2,"ح",1,0],["أُمَمٌ تَفنى وَأَركانٌ تَهي","وَعُروشٌ تَتَهاوى وَسُرُر",3,"ر",1,0],["أَم مَشوقٌ مُغرَمٌ وَلِهٌ","شَفَّهُ التَشبيبُ وَالغَزَلُ",4,"ل",1,0],["أَمَمُ العُرُوبَةِ شَاطَرَتْهُمْ حُزْنَهُمْ","أَوَ مَا بَنُوهَا كُلُّهُمْ إِخْوَانُ",5,"ن",1,0],["أم من وجود له اختفاء","إلى وجود بلا اختفاء",6,"ا",2,0],["أَم مَن يَغارُ عَلى النِساءِ حَفيظَةً","إِذ لا يَثِقنَ بِغَيرَةِ الأَزواجِ",7,"ج",1,0],["أَم مَن لِبابٍ إِذا ما اِشتَدَّ حاجِبُهُ","أَم مَن لِخَصمٍ بَعيدِ السَأوِ خَطّارِ",8,"ر",1,0],["أَم مَن يَقومُ بِفاروقٍ إِذا اِختَلَفَت","غَياطِلُ الشَكِّ مِن وَردٍ وَإِصدارِ",8,"ر",1,0],["أَمُمعِنَةً في العَذلِ رِفقاً بِقَلبِهِ","أَيَحمِلُ ذا قَلبٌ وَلو أَنَّهُ صَخرُ",9,"ر",1,0],["أم من تَهشُّ له فيرجفُ قلبُهُ","خَوفَ المفاقر غير ذي وسواس",10,"س",1,0],["أم متى لم أرَ الكثيرَ قليلاً","لك بالحقّ نيةً وانتحالا",11,"ل",2,0],["أم ملال عراكَ مني فأنَّى","حان قبل اللقاءِ حينُ الملالِ",12,"ل",1,0],["أمُّ من شئتُ من أَعاديَّ ظهر","أمتطيه بقُدرةِ الشيطان",13,"ن",1,0],["أَم ما لِجَنبِكَ لا يُلائِمُ مَضجَعاً","إِلّا أَقَضَّ عَلَيكَ ذاكَ المَضجَعُ",14,"ع",1,0],["أَم ملاكُ الفردوس جاءَ إلى الأَر","ضِ ليُحيي روحَ السَّلامِ العهيدِ",15,"د",1,0],["امم كلها تبيد فتأتي","امم اخرى بعدها للبيود",16,"د",1,0],["امم اذلتها سياسة قسوة","من اقوياء يسرهم اذلالها",17,"ل",3,0],["امم تقدم والكفا","ح على السلامة مستمر",18,"ر",1,0],["أم من كريمات الحسي","ن صباحه يوم النقور",19,"ر",1,0],["أمم من الإسلام يجمع بيننا","ماض وأحداث خلون كبار",20,"ر",1,0],["أمم كملموم القطيع ترى لهم","شمل الجميع وفرقة الآحاد",21,"د",1,0],["أمم يكاثرها الحصى","عدّا وليس لها بكاثر",22,"ر",1,0],["أمم قد تغيرت","وبلاد تولتِ",23,"ت",1,0],["أُمَمٌ وَراءَ الكَهفِ جُهدُ حَياتِهِم","حَرَكاتُ عَيشٍ في سُكونِ حِمامِ",24,"م",1,0],["أُمَمُ الحَضارَةِ أَنتُمُ آباؤُنا","مِنكُم أَخَذنا العِلمَ وَالعِرفانا",25,"ن",2,0],["أَم مِنَ الناسِ بَعدُ مَن قَولُهُ وَح","يٌ كَريمٌ وَفِعلُهُ إِلهامُ",26,"م",1,0],["أُمَمَ الهِلالِ مَقالَةً مِن صادِقٍ","وَالصِدقُ أَليَقُ بِالرِجالِ مَقالا",27,"ل",2,0],["أَم مِن صِيانَتِكَ القَضاءَ بِمِصرَ أَن","تَأتي بِقاضي دِنشِوايَ وَكيلا",28,"ل",2,0],["أَمْ مَنْ حَوى قَصَباتِ السّبْقِ دوَنهُمُ","يومَ القَليبِ وفي أَعْناقِهِمْ زَوَرُ",29,"ر",1,0],["أَمْ مَنْ رَسَا يومَ أُحْدٍ ثابتاً قَدَماً","وفي حُنَينٍ وسَلْعٍ بَعْدَمَا عَثَرُوا",29,"ر",3,0],["أَمْ مَنْ غَدا داحِياً بابَ القُمُوصِ لَهُمْ","وفاتحاً خَيْبراً مِنْ بَعْدِما كُسِرُوا",29,"ر",3,0],["أم ملوك الأرض في جوفها","جنينها الأبيض والأحمر",30,"ر",1,0],["أمم السجية لا الجفون غريقة","وجدا ولا الأشجان في إغراق",31,"ق",1,0],["أم من يُرَجِّي بعدَه صرَفَ الرَّدى","عن نفسِه بجِلادِه وضِرابِه",32,"ب",2,0],["أَممن أَبِن لِيَ فَأَنبأتُهُ","بارجافِ ذي الحَسَدِ الداغِلِ",33,"ل",1,0],["أَم ما تَقولُ إِذا ظَعَنتَ إِلى البَلى","وَإِذا خَلا بِكَ مُنكَرٌ وَنَكيرُ",34,"ر",1,0],["أُمَمٌ مَزروعَةٌ مَحصودَةٌ","كُلُّ مَزروعٍ فَلِلحَصدِ زُرِع",35,"ع",1,0],["أَم مِن شَذا نَسمَةِ الفِردوسِ حينَ سَرَت","عَلى بَليلٍ مِنَ الأَزهارِ مَمطورِ",36,"ر",1,0],["أمَمٌ يُصبِّرُ بعضُها","بعضاً وهيهات العزاء",37,"ا",2,0],["أَم مَن لِاِسباقِ الدِياتِ وَجَمعِها","وَلِفادِحاتِ نَوائِبِ الحِدثانِ",38,"ن",1,0],["أُمَمٌ أَخْلَدَتْ إِلَى الدَّهْرِ حِيناً","ثُمَّ ضَاعَتْ فِي لُجَّةِ النِّسْيَانِ",39,"ن",1,0],["أُمَمٌ يَغُصُّ بِها الفَضاءُ طَوَتهُمُ","كَفُّ الرَدى طَيَّ الرِداءِ فَبادوا",40,"د",3,0],["أمَمُ العُروبة إن تَتَابَع شُكرُها","فَلِفَضْلِها المُتتابِع المتوالي",41,"ل",2,0],["أُمَمَ العُروبةِ جاءَ يومُكِ فاعْلَمِي","وإلى مكانكِ فانهَضِي وتقدَّمي",42,"م",2,1],["أُمَمَ العُروبةِ أين أنْتِ فقد طَغَى","سَيْلُ الأَذَى في موجهِ المُتَضرِّمِ",42,"م",1,0],["أُمَمَ العُروبةِ لا نجاةَ لِمُدْبِرٍ","يبغِي النّجاةَ ولا حَياةَ لِمُحْجمِ",42,"م",1,0],["أُمَمَ العُروبةِ جَدَّ جِدُّكِ فانْظِمي","من عِقدِكِ المنثورِ ما لم يُنْظَمِ",42,"م",1,0],["أُمَمٌ يَظَلُّ الجَهْلُ يَقْتُلُها","فَتزيدُ جَهْلاً كُلّما قَتلا",43,"ل",2,0],["أُمَمُ العروبةِ أكبرت لك نجدةً","رَضِيَ اللّهيفُ بها وكَفَّ العاتِبُ",44,"ب",1,0],["أُمَمُ الدُّنيا إذا ما صَلُحَتْ","فَعَلَى أيدي الوُلاةِ الصّالحينْ",45,"ن",1,0],["أممُ المشرقِ لولا ما بِنا","من حياةٍ أصبحت مَوْتَى رمِاما",46,"م",2,0],["أُممٌ هَوالِكُ ما لَمستُ جِراحَها","إلا بكتْ وبكيتُ من جَرّاها",47,"ا",3,0],["أَم مَسكَنُ الجَنَةِ الَّتي","وُعِدَ الأَبرارُ مَصفوفَةٌ نَمارِقُها",48,"ق",3,0],["أَم مَن لِراسِيَةٍ كَأَنَّ أُوارَها","نَقعٌ تَعاوَرَهُ بَناتُ الأَخدَرِ",49,"ر",1,0],["أَم مَن لِخَصمٍ مُضجِعينَ قِسِيَّهُم","مَيلٍ خُدودُهُمُ عِظامِ المَفخَرِ",49,"ر",1,0],["أُمَمَاً أُشرِبَتُ قلوبُهُم الكُف","رَ فَدَاءُ الضَّلالِ فيهم عَيَاءُ",50,"ا",2,0],["أم مَحَا اللَّهُ آية الليل ذكراً","بعدَ سَهْوٍ ليوجَدَ الإِمْساءُ",50,"ا",2,0],["أمْ مَنْ يُذِلُّ عَماليقاً تُذِلُّهمُ","إنّ الأجادلَ تَسمْو للكَراكيّ",51,"ي",1,0],["أم مَن يُعَمَّرُ في الزّمانِ مخلَّداً","حتى يعدّ له الحصَى والأثلبَا",52,"ب",2,0],["أَم مِرَّةٌ وافَقَت وَق","تَها فَهَذا لِذاكا",53,"ك",2,0],["أَمَمٌ ماسَلِمتِ فَقدُ فَقيدٍ","أَيُّ نَفسٍ صَفا لَها ماتَشاءُ",54,"ا",2,0],["أَم مَن يَكونُ خَطيبَ القَومِ إِن حَفَلوا","لَدى مُلوكٍ أُلي كَيدٍ وَأَقوالِ",55,"ل",1,0],["أَم مَن لِقَومٍ أَضاعوا بَعضَ أَمرِهِمِ","بَينَ القُسوطِ وَبَينَ الدينِ دَلدالِ",55,"ل",1,0],["أَم مَن لِأَهلِ لَوِيٍّ في مُسَكَّعَةٍ","في أَمرِهِم خالَطوا حَقّاً بِإِبطالِ",55,"ل",1,0],["أَم مَن لِعادِيَةٍ تُردي مُلَملَمَةٍ","كَأَنَّها عارِضٌ مِن هَضبِ أَوعالِ",55,"ل",1,0],["أَم ما تُنادي مِن ماثِلٍ دَرَجَ السَ","يلُ عَلَيهِ كَالحَوضِ مُنهَدِمِ",56,"م",1,0],["أمم الغرب عمَّموا العلم حتى","وفَّروا قوة مع الأيام",57,"م",1,0],["أُمَم المشرقين منتفضات","من هوانٍ بهن أَي اِنتفاض",58,"ض",1,0],["أُمَم قد التأمت جرو","ح في جوانحها دوامي",59,"م",2,0],["أَمْ مَا تَذَكَّرُ مِنْ دَهْمَاءَ إِذْ طَلَعَتْ","نَجْدَيْ مَرِيعٍ وقَدْ شَابَ المَقَادِيمُ",60,"م",1,0],["أم موجةُ الطهرِ التي تغْسلُ","مآثمَ الكونِ وتمحو أذاهْ",61,"ه",1,0],["أم مورةُ الشماءُ يوم أباحها","والنارُ حول سفينه تتهزّمُ",62,"م",1,0],["أممٌ ترسف في أحقادها","دتتها بالصفح والصنع الحميد",63,"د",1,0],["أُمَمٌ خَلَتْ فَاسْتَعْجَمَتْ أَخْبَارُها","حَتَّى غَدَتْ مَجْهُولَةَ الإِسْنَادِ",64,"د",1,0],["أُمٌّ مِنَ الَّلائِي نَدَرْنَ وَكَانَ مِن","أَبْنائِهِنَّ نَوَادِرُ الأَدْهَارِ",65,"ر",1,0],["أُمَمُ الأَثِيرِ جَمَالُهَا","فِي أَنْ تُرَاعَ فَرَوِّعِي",66,"ع",2,0],["أَم مُصابَ مُقتَدِرِ ال","حَربِ مَع مُظَفَّرِها",67,"ر",3,0],["أُمَمٌ تلتَقي صباحاً على المو","تِ لتستقبلَ المساءَ هُمودا",68,"د",2,0],["أمَمٌ إِنْ يَهْلِكَ المَالُ فإِن","لُمِستْ أَعْراضُها حَلَّت حُبَاها",69,"ا",3,0],["أممٌ لها خُلْقُ السماحِ سَجيَّةٌ","ودماؤها في الحرب رَمزُ سَماحها",70,"ح",3,0],["أمَمٌ سرَتْ في جُنْحِ ليلٍ مظلمٍ","قد ضَلّ فيه النجم قبلَ الساري",71,"ر",2,0],["أُممُ العروبة وحَّدَتْ أَهدافَها","توحيدَها للبارئ القهار",72,"ر",1,0],["أمَمٌ تباع وتشترى في السُّوق؛ من","يد سيِّد تمضي إلى يد سيد",73,"د",1,0],["أمَمٌ بنت ركن الحضارة عاليًا","ما بالها لم تألُهُ تخريبا؟",74,"ب",2,0],["أمم تكسر القيود وأخرى","يرهف القين سيفها الصمصاما",75,"م",2,0],["أَمْ مسَّكُمْ منا صفاءٌ","أمْ حادثٌ مِنَّا ظَهرْ",76,"ر",1,0],["أَم مِن تَذَكُّرِ أَقوامٍ ذَوي سَفَهٍ","يَغشونَ بِالظُلمِ مَن يَدعو إِلى الدينِ",77,"ن",1,0],["أممتِّعى وحشَ الفلا بجمالهم","ما ذنْب طرف الهائم المستهترِ",78,"ر",1,0],["أُمَمٌ إِذا رَغِبوا فَأَنتَ المُجتَدى","فيهِم وَإِن رَهِبوا فَأَنتَ المَفزَعُ",79,"ع",1,0],["أُمَمٌ مُذ وَليتَ أَمرَ اللَيالي","آذَنَتهُم صُروفُها بِاِنصِرافِ",80,"ف",1,0],["أَم مَقالاتُهُ وَآراؤُهُ اللّا","تي تَرُدُّ المِئينَ في الآحادِ",81,"د",1,0],["أُمَمٌ تَدَخَّلَتِ الحُتوفُ عَلَيهِم","أَبوابَهُم وَكَشَفنَ غِطاءِ",82,"ا",2,0],["أم من ينوب منابَهُ لحوادث","تذر العزيز بحكمهنَّ ذليلا",83,"ل",2,0],["أم من معاطفها أم من عواطفها","أم من مراشفها أم من مجانيها",84,"ي",3,0],["أم من تفترها أم من تكسرها","أم من تلفتها أم من تثنيها",84,"ي",3,0],["أم من يدانيك في أبوّتِهِ","مِن عَلَوِيّينِ فاطِمِيّينِ",85,"ن",1,0],["أم محّياً يجول ماء النُهَى في","ه وماء الحِجَا القَرَاح النَمِير",86,"ر",1,0],["أَم ما بُكاؤُكَ في دارٍ عَهِدتَ بِها","عَهداً فَأَخلَفَ أَم في آيِها تَقِفُ",87,"ف",1,0],["أمميت قلبي وهو في تاموره","لولا بقاؤك فيه هان بقاؤه",88,"ا",3,0],["ام مشهد الكعبة البيت الحَرام وَفي","اكنافها الوفد حجاج وَعمار",89,"ر",1,0],["أَم من كقاب القوس آية قربه","بعلوه وَدَنوه من ربه",90,"ه",1,0],["أمم كالذئاب تفترس الضعفى","شدادٌ وكلّهم للزوال",91,"ل",1,0],["أمم قد خلَت وأخرى ستمضى","فلكٌ لا يني عن الدوران",92,"ن",1,0],["أمم كأطراف الجذيم فناؤها","إرث على نوبِ الحياة موزّع",93,"ع",1,0],["أمما قضاه الله يا ساق مخرج","أ