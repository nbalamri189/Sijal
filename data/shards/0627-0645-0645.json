 الكامل"],[429,"من الأحبة أم من طيب ربعهم","https://www.aldiwan.net/poem41426.html","البسيط"],[437,"أمن الهجران غدا جسدي","https://www.aldiwan.net/poem2563.html","المتدارك"],[439,"منكم إليكم مساعي المجد تنصرف","https://www.aldiwan.net/poem34822.html","البسيط"],[453,"علم الإباء وأحكم الشعراء","https://www.aldiwan.net/poem61239.html","الكامل"],[453,"مهد الحضارة للعروبة كلها","https://www.aldiwan.net/poem61290.html","الكامل"],[453,"أرشد الله أمة الإسلام","https://www.aldiwan.net/poem61362.html","الخفيف"],[453,"الشاعر القروي في تكريمنا","https://www.aldiwan.net/poem61569.html","الكامل"],[458,"إن كان فوق الشمس للساعي قدم","https://www.aldiwan.net/poem55866.html","الرجز"],[458,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[464,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[464,"يا من بدا ورنا فلاح","https://www.aldiwan.net/poem3458.html","عموديه"],[477,"هل بعد وصالك من وطر","https://www.aldiwan.net/poem15256.html","الوافر"],[500,"رفع البدر علينا سجفا","https://www.aldiwan.net/poem37954.html","الرمل"],[540,"أحمامة حلبت شؤونك أسجما","https://www.aldiwan.net/poem56754.html","البسيط"],[553,"يا عين جودي بدمع منك مدرار","https://www.aldiwan.net/poem68400.html","البسيط"],[558,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"],[567,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["أَم مَن يُبَلِّغُ بِالبَلاغَةِ غايَةً","تَلوي بِحَسرى طالِبينَ وَظُلَّعِ",0,"ع",1,0],["أَم مَن يَرُدُّ مِنَ المُغيرَةِ غَربَها","وَالخَيلُ تَنهَضُ كَالقَطا بِالدُرَّعِ",0,"ع",1,0],["أَم مَن يَلِطُّ عَلَيَّ سِترَ دُعائِهِ","حَرَماً مِنَ البَأساءِ وَالضَرّاءِ",1,"ا",2,0],["أَم مُمسِكٌ بِوصالِ خِلٍّ ناصِحٍ","مَحض الأُخوَّة مِثلُهُ لا يُطرَحُ",2,"ح",1,0],["أُمَمٌ تَفنى وَأَركانٌ تَهي","وَعُروشٌ تَتَهاوى وَسُرُر",3,"ر",1,0],["أَم مَشوقٌ مُغرَمٌ وَلِهٌ","شَفَّهُ التَشبيبُ وَالغَزَلُ",4,"ل",1,0],["أَمَمُ العُرُوبَةِ شَاطَرَتْهُمْ حُزْنَهُمْ","أَوَ مَا بَنُوهَا كُلُّهُمْ إِخْوَانُ",5,"ن",1,0],["أم من وجود له اختفاء","إلى وجود بلا اختفاء",6,"ا",2,0],["أَم مَن يَغارُ عَلى النِساءِ حَفيظَةً","إِذ لا يَثِقنَ بِغَيرَةِ الأَزواجِ",7,"ج",1,0],["أَم مَن لِبابٍ إِذا ما اِشتَدَّ حاجِبُهُ","أَم مَن لِخَصمٍ بَعيدِ السَأوِ خَطّارِ",8,"ر",1,0],["أَم مَن يَقومُ بِفاروقٍ إِذا اِختَلَفَت","غَياطِلُ الشَكِّ مِن وَردٍ وَإِصدارِ",8,"ر",1,0],["أَمُمعِنَةً في العَذلِ رِفقاً بِقَلبِهِ","أَيَحمِلُ ذا قَلبٌ وَلو أَنَّهُ صَخرُ",9,"ر",1,0],["أم من تَهشُّ له فيرجفُ قلبُهُ","خَوفَ المفاقر غير ذي وسواس",10,"س",1,0],["أم متى لم أرَ الكثيرَ قليلاً","لك بالحقّ نيةً وانتحالا",11,"ل",2,0],["أم ملال عراكَ مني فأنَّى","حان قبل اللقاءِ حينُ الملالِ",12,"ل",1,0],["أمُّ من شئتُ من أَعاديَّ ظهر","أمتطيه بقُدرةِ الشيطان",13,"ن",1,0],["أَم ما لِجَنبِكَ لا يُلائِمُ مَضجَعاً","إِلّا أَقَضَّ عَلَيكَ ذاكَ المَضجَعُ",14,"ع",1,0],["أَم ملاكُ الفردوس جاءَ إلى الأَر","ضِ ليُحيي روحَ السَّلامِ العهيدِ",15,"د",1,0],["امم كلها تبيد فتأتي","امم اخرى بعدها للبيود",16,"د",1,0],["امم اذلتها سياسة قسوة","من اقوياء يسرهم اذلالها",17,"ل",3,0],["امم تقدم والكفا","ح على السلامة مستمر",18,"ر",1,0],["أم من كريمات الحسي","ن صباحه يوم النقور",19,"ر",1,0],["أمم من الإسلام يجمع بيننا","ماض وأحداث خلون كبار",20,"ر",1,0],["أمم كملموم القطيع ترى لهم","شمل الجميع وفرقة الآحاد",21,"د",1,0],["أمم يكاثرها الحصى","عدّا وليس لها بكاثر",22,"ر",1,0],["أمم قد تغيرت","وبلاد تولتِ",23,"ت",1,0],["أُمَمٌ وَراءَ الكَهفِ جُهدُ حَياتِهِم","حَرَكاتُ عَيشٍ في سُكونِ حِمامِ",24,"م",1,0],["أُمَمُ الحَضارَةِ أَنتُمُ آباؤُنا","مِنكُم أَخَذنا العِلمَ وَالعِرفانا",25,"ن",2,0],["أَم مِنَ الناسِ بَعدُ مَن قَولُهُ وَح","يٌ كَريمٌ وَفِعلُهُ إِلهامُ",26,"م",1,0],["أُمَمَ الهِلالِ مَقالَةً مِن صادِقٍ","وَالصِدقُ أَليَقُ بِالرِجالِ مَقالا",27,"ل",2,0],["أَم مِن صِيانَتِكَ القَضاءَ بِمِصرَ أَن","تَأتي بِقاضي دِنشِوايَ وَكيلا",28,"ل",2,0],["أَمْ مَنْ حَوى قَصَباتِ السّبْقِ دوَنهُمُ","يومَ القَليبِ وفي أَعْناقِهِمْ زَوَرُ",29,"ر",1,0],["أَمْ مَنْ رَسَا يومَ أُحْدٍ ثابتاً قَدَماً","وفي حُنَينٍ وسَلْعٍ بَعْدَمَا عَثَرُوا",29,"ر",3,0],["أَمْ مَنْ غَدا داحِياً بابَ القُمُوصِ لَهُمْ","وفاتحاً خَيْبراً مِنْ بَعْدِما كُسِرُوا",29,"ر",3,0],["أم ملوك الأرض في جوفها","جنينها الأبيض والأحمر",30,"ر",1,0],["أمم السجية لا الجفون غريقة","وجدا ولا الأشجان في إغراق",31,"ق",1,0],["أم من يُرَجِّي بعدَه صرَفَ الرَّدى","عن نفسِه بجِلادِه وضِرابِه",32,"ب",2,0],["أَممن أَبِن لِيَ فَأَنبأتُهُ","بارجافِ ذي الحَسَدِ الداغِلِ",33,"ل",1,0],["أَم ما تَقولُ إِذا ظَعَنتَ إِلى البَلى","وَإِذا خَلا بِكَ مُنكَرٌ وَنَكيرُ",34,"ر",1,0],["أُمَمٌ مَزروعَةٌ مَحصودَةٌ","كُلُّ مَزروعٍ فَلِلحَصدِ زُرِع",35,"ع",1,0],["أَم مِن شَذا نَسمَةِ الفِردوسِ حينَ سَرَت","عَلى بَليلٍ مِنَ الأَزهارِ مَمطورِ",36,"ر",1,0],["أمَمٌ يُصبِّرُ بعضُها","بعضاً وهيهات العزاء",37,"ا",2,0],["أُمَمٌ أَخْلَدَتْ إِلَى الدَّهْرِ حِيناً","ثُمَّ ضَاعَتْ فِي لُجَّةِ النِّسْيَانِ",38,"ن",1,0],["أُمَمٌ يَغُصُّ بِها الفَضاءُ طَوَتهُمُ","كَفُّ الرَدى طَيَّ الرِداءِ فَبادوا",39,"د",3,0],["أمَمُ العُروبة إن تَتَابَع شُكرُها","فَلِفَضْلِها المُتتابِع المتوالي",40,"ل",2,0],["أُمَمَ العُروبةِ جاءَ يومُكِ فاعْلَمِي","وإلى مكانكِ فانهَضِي وتقدَّمي",41,"م",2,1],["أُمَمَ العُروبةِ أين أنْتِ فقد طَغَى","سَيْلُ الأَذَى في موجهِ المُتَضرِّمِ",41,"م",1,0],["أُمَمَ العُروبةِ لا نجاةَ لِمُدْبِرٍ","يبغِي النّجاةَ ولا حَياةَ لِمُحْجمِ",41,"م",1,0],["أُمَمَ العُروبةِ جَدَّ جِدُّكِ فانْظِمي","من عِقدِكِ المنثورِ ما لم يُنْظَمِ",41,"م",1,0],["أُمَمٌ يَظَلُّ الجَهْلُ يَقْتُلُها","فَتزيدُ جَهْلاً كُلّما قَتلا",42,"ل",2,0],["أُمَمُ العروبةِ أكبرت لك نجدةً","رَضِيَ اللّهيفُ بها وكَفَّ العاتِبُ",43,"ب",1,0],["أُمَمُ الدُّنيا إذا ما صَلُحَتْ","فَعَلَى أيدي الوُلاةِ الصّالحينْ",44,"ن",1,0],["أممُ المشرقِ لولا ما بِنا","من حياةٍ أصبحت مَوْتَى رمِاما",45,"م",2,0],["أُممٌ هَوالِكُ ما لَمستُ جِراحَها","إلا بكتْ وبكيتُ من جَرّاها",46,"ا",3,0],["أَم مَسكَنُ الجَنَةِ الَّتي","وُعِدَ الأَبرارُ مَصفوفَةٌ نَمارِقُها",47,"ق",3,0],["أَم مَن لِراسِيَةٍ كَأَنَّ أُوارَها","نَقعٌ تَعاوَرَهُ بَناتُ الأَخدَرِ",48,"ر",1,0],["أَم مَن لِخَصمٍ مُضجِعينَ قِسِيَّهُم","مَيلٍ خُدودُهُمُ عِظامِ المَفخَرِ",48,"ر",1,0],["أُمَمَاً أُشرِبَتُ قلوبُهُم الكُف","رَ فَدَاءُ الضَّلالِ فيهم عَيَاءُ",49,"ا",2,0],["أم مَحَا اللَّهُ آية الليل ذكراً","بعدَ سَهْوٍ ليوجَدَ الإِمْساءُ",49,"ا",2,0],["أمْ مَنْ يُذِلُّ عَماليقاً تُذِلُّهمُ","إنّ الأجادلَ تَسمْو للكَراكيّ",50,"ي",1,0],["أم مَن يُعَمَّرُ في الزّمانِ مخلَّداً","حتى يعدّ له الحصَى والأثلبَا",51,"ب",2,0],["أَم مِرَّةٌ وافَقَت وَق","تَها فَهَذا لِذاكا",52,"ك",2,0],["أَمَمٌ ماسَلِمتِ فَقدُ فَقيدٍ","أَيُّ نَفسٍ صَفا لَها ماتَشاءُ",53,"ا",2,0],["أَم مَن يَكونُ خَطيبَ القَومِ إِن حَفَلوا","لَدى مُلوكٍ أُلي كَيدٍ وَأَقوالِ",54,"ل",1,0],["أَم مَن لِقَومٍ أَضاعوا بَعضَ أَمرِهِمِ","بَينَ القُسوطِ وَبَينَ الدينِ دَلدالِ",54,"ل",1,0],["أَم مَن لِأَهلِ لَوِيٍّ في مُسَكَّعَةٍ","في أَمرِهِم خالَطوا حَقّاً بِإِبطالِ",54,"ل",1,0],["أَم مَن لِعادِيَةٍ تُردي مُلَملَمَةٍ","كَأَنَّها عارِضٌ مِن هَضبِ أَوعالِ",54,"ل",1,0],["أَم ما تُنادي مِن ماثِلٍ دَرَجَ السَ","يلُ عَلَيهِ كَالحَوضِ مُنهَدِمِ",55,"م",1,0],["أمم الغرب عمَّموا العلم حتى","وفَّروا قوة مع الأيام",56,"م",1,0],["أُمَم المشرقين منتفضات","من هوانٍ بهن أَي اِنتفاض",57,"ض",1,0],["أُمَم قد التأمت جرو","ح في جوانحها دوامي",58,"م",2,0],["أم موجةُ الطهرِ التي تغْسلُ","مآثمَ الكونِ وتمحو أذاهْ",59,"ه",1,0],["أم مورةُ الشماءُ يوم أباحها","والنارُ حول سفينه تتهزّمُ",60,"م",1,0],["أممٌ ترسف في أحقادها","دتتها بالصفح والصنع الحميد",61,"د",1,0],["أُمَمٌ خَلَتْ فَاسْتَعْجَمَتْ أَخْبَارُها","حَتَّى غَدَتْ مَجْهُولَةَ الإِسْنَادِ",62,"د",1,0],["أُمٌّ مِنَ الَّلائِي نَدَرْنَ وَكَانَ مِن","أَبْنائِهِنَّ نَوَادِرُ الأَدْهَارِ",63,"ر",1,0],["أُمَمُ الأَثِيرِ جَمَالُهَا","فِي أَنْ تُرَاعَ فَرَوِّعِي",64,"ع",2,0],["أَم مُصابَ مُقتَدِرِ ال","حَربِ مَع مُظَفَّرِها",65,"ر",3,0],["أُمَمٌ تلتَقي صباحاً على المو","تِ لتستقبلَ المساءَ هُمودا",66,"د",2,0],["أمَمٌ إِنْ يَهْلِكَ المَالُ فإِن","لُمِستْ أَعْراضُها حَلَّت حُبَاها",67,"ا",3,0],["أممٌ لها خُلْقُ السماحِ سَجيَّةٌ","ودماؤها في الحرب رَمزُ سَماحها",68,"ح",3,0],["أمَمٌ سرَتْ في جُنْحِ ليلٍ مظلمٍ","قد ضَلّ فيه النجم قبلَ الساري",69,"ر",2,0],["أُممُ العروبة وحَّدَتْ أَهدافَها","توحيدَها للبارئ القهار",70,"ر",1,0],["أمَمٌ تباع وتشترى في السُّوق؛ من","يد سيِّد تمضي إلى يد سيد",71,"د",1,0],["أمَمٌ بنت ركن الحضارة عاليًا","ما بالها لم تألُهُ تخريبا؟",72,"ب",2,0],["أمم تكسر القيود وأخرى","يرهف القين سيفها الصمصاما",73,"م",2,0],["أمْ منْ لاسباقِ الدياتِ وَ جمعها","وَلِفَادِحَاتِ نَوَائِبِ الْحِدْثَانِ",74,"ن",1,0],["أَمْ مسَّكُمْ منا صفاءٌ","أمْ حادثٌ مِنَّا ظَهرْ",75,"ر",1,0],["أَم مِن تَذَكُّرِ أَقوامٍ ذَوي سَفَهٍ","يَغشونَ بِالظُلمِ مَن يَدعو إِلى الدينِ",76,"ن",1,0],["أممتِّعى وحشَ الفلا بجمالهم","ما ذنْب طرف الهائم المستهترِ",77,"ر",1,0],["أُمَمٌ إِذا رَغِبوا فَأَنتَ المُجتَدى","فيهِم وَإِن رَهِبوا فَأَنتَ المَفزَعُ",78,"ع",1,0],["أُمَمٌ مُذ وَليتَ أَمرَ اللَيالي","آذَنَتهُم صُروفُها بِاِنصِرافِ",79,"ف",1,0],["أَم مَقالاتُهُ وَآراؤُهُ اللّا","تي تَرُدُّ المِئينَ في الآحادِ",80,"د",1,0],["أُمَمٌ تَدَخَّلَتِ الحُتوفُ عَلَيهِم","أَبوابَهُم وَكَشَفنَ غِطاءِ",81,"ا",2,0],["أم من ينوب منابَهُ لحوادث","تذر العزيز بحكمهنَّ ذليلا",82,"ل",2,0],["أم من معاطفها أم من عواطفها","أم من مراشفها أم من مجانيها",83,"ي",3,0],["أم من تفترها أم من تكسرها","أم من تلفتها أم من تثنيها",83,"ي",3,0],["أم من يدانيك في أبوّتِهِ","مِن عَلَوِيّينِ فاطِمِيّينِ",84,"ن",1,0],["أم محّياً يجول ماء النُهَى في","ه وماء الحِجَا القَرَاح النَمِير",85,"ر",1,0],["أَم ما بُكاؤُكَ في دارٍ عَهِدتَ بِها","عَهداً فَأَخلَفَ أَم في آيِها تَقِفُ",86,"ف",1,0],["أمميت قلبي وهو في تاموره","لولا بقاؤك فيه هان بقاؤه",87,"ا",3,0],["ام مشهد الكعبة البيت الحَرام وَفي","اكنافها الوفد حجاج وَعمار",88,"ر",1,0],["أَم من كقاب القوس آية قربه","بعلوه وَدَنوه من ربه",89,"ه",1,0],["أمم كالذئاب تفترس الضعفى","شدادٌ وكلّهم للزوال",90,"ل",1,0],["أمم قد خلَت وأخرى ستمضى","فلكٌ لا يني عن الدوران",91,"ن",1,0],["أمم كأطراف الجذيم فناؤها","إرث على نوبِ الحياة موزّع",92,"ع",1,0],["أمما قضاه الله يا ساق مخرج","أناتك يا ساقي فما بي غداً رأسُ",93,"س",1,0],["أمَمٌ على الماضي تطيل بكاءها","وتنام عن مستقبل وضاء",94,"ا",2,0],["أمم حطمت بمعول شيطان","ولفت بمجدها الوه