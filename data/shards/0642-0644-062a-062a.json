{"poems":[[53,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[53,"لي صديق إذا رأت","https://www.aldiwan.net/poem62008.html","مجزوء الخفيف"],[53,"بك تمت لي السلامة يا سالم","https://www.aldiwan.net/poem65393.html","الخفيف"],[53,"لي صديقٌ إذا رأت","https://www.poetsgate.com/ViewPoem.aspx?id=28618",""],[190,"غرد الديك قبل وقت الأذان","https://www.aldiwan.net/poem43217.html","الخفيف"],[353,"صدقوا قد نظروا الورد مسيج","https://www.aldiwan.net/poem19932.html","الرمل"],[354,"مر بي بالآب والإبن","https://www.aldiwan.net/poem15641.html","مجزوء الرمل"],[358,"قال لي المحبوب يوما","https://www.aldiwan.net/poem39755.html","مجزوء الرمل"],[463,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[463,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[572,"حبذا الزائر في وقت السحر","https://www.aldiwan.net/poem69697.html","الرمل"],[580,"بعضهم لا يحب إلا مصنن","https://www.aldiwan.net/poem2800.html","الخفيف"],[619,"","https://poetry.dctabudhabi.ae/diwan/poem/203371","زجل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38466","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56101","الخفيف"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133874","المنسرح"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95257","الرجز"],[2751,"","https://poetry.dctabudhabi.ae/diwan/poem/138895",""],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205845","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111450","الخفيف"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135083","الخفيف"],[4308,"","https://poetry.dctabudhabi.ae/diwan/poem/34763","المنسرح"],[4829,"الهنوف","https://www.poetsgate.com/ViewPoem.aspx?id=36754",""],[4119,"قلت تقول الله لا خائفا","https://www.poetsgate.com/ViewPoem.aspx?id=16247",""],[5061,"البدر لا غاب","https://www.poetsgate.com/ViewPoem.aspx?id=147151",""],[5463,"خل من راح يرحل بكره شوقه يجيبه","https://www.poetsgate.com/ViewPoem.aspx?id=27213",""]],"verses":[["قلت تاللَّه ليس مثلي مَنْ وَد","دَ ضَلالاً وحيَرةً باهتداءِ",0,"ا",2,0],["قلت تب توبة امرئٍ","عَقَّ نفساً وبرَّها",1,"ر",3,0],["قلتَ تمِّي لخادمي فأطاعت","ك بحق ومن أطاع أطيعا",2,"ع",2,0],["قلتُ تب توبة امرىء ٍ","عَقَّ نفساً وبرَّها",3,"ر",3,0],["قلتُ تاب النبيذ مني وما تب","ت مطيعا فليكتب",4,"ب",1,0],["قُلْتُ تَاجُ الدِّينِ فيهِ وَصْفُهُ","قالَ هذا مَلِكُ الشِّعْرِ المُتَوَّجْ",5,"ج",1,0],["قُلتُ تَوحيدَكَ في التَثل","يثُ لِلتَوحيدُ ضِدُّ",6,"د",1,0],["قُلت تَاللّه لَقَد آ","ثرك اللَه عَلَينا",7,"ن",2,0],["قلتُ تَنَفَّجْ وكِد ذليلا","يا رُبَّ عِرضٍ في ماضغينِ",8,"ن",1,0],["قلتُ تنحَّ يا فري","سُ عن مكان السَّبُعِ",9,"ع",1,0],["قلتُ تنساني إذا فارقْتَني","فَتَغَنّى بدَلالٍ وخَفَرْ",10,"ر",1,0],["قلت تهواه أَسْمراً قال إِي وال","لهِ أَهْواهُ أَسمراً لا مُعَنَّن",11,"ن",1,0],["قلت تكذب يا مليعين","هات فيمك لي وقل أح",12,"ح",1,0],["قُلتُ تَنَفَّسْ عاجِلاً","يا صُبحُ حتّى تَنفَلِق",13,"ق",1,0],["قلت تالله ما انا رب حرث","لا ولا قد فلحت عمري حقولا",14,"ل",2,0],["قلت تزيدت وادعيت على","شيخ نبيل ينمى إلى نبل",15,"ل",1,0],["قُلتُ تَنحَّ سيّدي","كي لا أضُرَّ جَانِبَك",16,"ك",1,0],["قلت تعودين إذا ما غفا","عنك رقيب الحي قالت أجل",17,"ل",1,0],["قلت ترعاني وترعى ولدى","وتربيّه على قصد السّنن",18,"ن",1,0],["قُلتُ تَضوَى الجِيادُ في تي الدِّيارِ","لامتِناعِ الكَلاءِ تَحتَ الحِصارِ",19,"ر",1,0],["قلت تقري لمغرم قال لا لا","إن مجزوء عشقنا ليس يقرا",20,"ر",2,0],["قُلتُ تَقولينَ لِلَّذي يَسَلُ","يَمنَعُني مِن جَوابِكَ الكَسَلُ",21,"ل",1,0],["قلت تعرف كلام البشر تنطقه","قال من جاورك يذْهَل ويذهلك",22,"ك",1,0],["قلت تقول الله لا خائفا","مع حكم القرآن حكم القران",23,"ن",1,1],["قلت تدري من حضورك وش خذيت","فالحقيقه صرت ادري من انا",24,"ن",2,0],["قلت : \" تمّ ما طلبتي .. جيت وهذا سطوعي","مثل نجم(ن) تلألئ وسط ليله كئيبه \"",25,"ب",2,0]]}