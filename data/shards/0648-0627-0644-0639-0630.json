{"poems":[[55,"حب العلى شغل قلب ما له شغل","https://www.aldiwan.net/poem29895.html","البسيط"],[95,"أين المجاز فيهبط الإلهام","https://www.aldiwan.net/poem11414.html","الكامل"],[53,"مستعبد هيهات إعتاقه","https://www.aldiwan.net/poem65706.html","السريع"],[91,"كنت طاغور ماثلا في خيالي","https://www.aldiwan.net/poem44752.html","الخفيف"],[107,"ناد القبور وبشر كل مقبور","https://www.aldiwan.net/poem43053.html","البسيط"],[104,"هادئ القلب مطبق الأجفان","https://www.aldiwan.net/poem33126.html","الخفيف"],[139,"أهدي إلى السامي المقام سلاميه","https://www.aldiwan.net/poem48994.html","الكامل"],[164,"زيادة القول تحكي النقص في العمل","https://www.aldiwan.net/poem59154.html","الطويل"],[164,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[173,"بع واسطاً بالنأي والهجر","https://www.aldiwan.net/poem1629.html",""],[234,"ظبي بثوب الهوى تردى","https://www.aldiwan.net/poem51152.html","مخلع البسيط"],[302,"يا بارقا صدع الدجى لمعانه","https://www.aldiwan.net/poem33147.html","الكامل"],[333,"واقع أروع من نسج الخيال","https://www.aldiwan.net/poem55008.html","الرمل"],[409,"الحمامة إن أثارت بالهديل","https://www.aldiwan.net/poem32903.html","الرمل"],[409,"مولاي يا فخر العلى والدين","https://www.aldiwan.net/poem33382.html","الرمل"],[556,"بنقا الرمث من شراف غزال","https://www.aldiwan.net/poem47338.html","الخفيف"],[580,"راح رسولي وجاءني عاشق","https://www.aldiwan.net/poem3045.html","المنسرح"],[580,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138245",""],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/107325","الرمل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101488","المجتث"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101506","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54149","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38988","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37991","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37918","السريع"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59687","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62461","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62495","الرمل"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75744","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119886","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59427","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59423","البسيط"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202119","الكامل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203792","الخفيف"],[1315,"","https://poetry.dctabudhabi.ae/diwan/poem/140222",""],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141287","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109437","الكامل"],[2228,"","https://poetry.dctabudhabi.ae/diwan/poem/123767","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104981","البسيط"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118931","الرجز"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140271",""],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140257",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91429","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91189","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77172","الكامل"],[4691,"قهقهة 1","https://www.poetsgate.com/ViewPoem.aspx?id=105401",""],[4693,"أهوى السحاب","https://www.poetsgate.com/ViewPoem.aspx?id=29939",""],[4693,"سطّر على صفحة التاريخ يا قلمي","https://www.poetsgate.com/ViewPoem.aspx?id=30100",""],[4578,"زف المدام على الصفا خدٍ وقد","https://www.poetsgate.com/ViewPoem.aspx?id=49400",""],[4578,"يا من بألفاظه ازدانت نواحينا","https://www.poetsgate.com/ViewPoem.aspx?id=49531",""],[5232,"قرية النور","https://www.poetsgate.com/ViewPoem.aspx?id=212235",""],[5480,"بت ساهد","https://www.poetsgate.com/ViewPoem.aspx?id=4104",""],[243,"تحية القرية","https://www.poetsgate.com/ViewPoem.aspx?id=50485",""],[5650,"عَائِشَة... وَحْيُ الْقَصِيد!","https://www.poetsgate.com/ViewPoem.aspx?id=131223",""],[5756,"الاسطورة","https://www.poetsgate.com/ViewPoem.aspx?id=5416",""],[6093,"حتى البحر قد يتوتر","https://www.poetsgate.com/ViewPoem.aspx?id=201115",""],[6102,"نَكهَةُ الغَدر","https://www.poetsgate.com/ViewPoem.aspx?id=182767",""]],"verses":[["وَالعَذلُ أَثقَلُ مَحمولٍ عَلى أُذُنٍ","وَهوَ الخَفيفُ عَلى العُذّالِ إِن عَذَلوا",0,"ل",3,0],["وَالعُذْرُ أَنِّي لَوْ سَكَتُّ لَكَانَ لِي","مِنْ مُكْرِميكَ جَمِيعِهِمْ لُوَّامُ",1,"م",1,0],["والعذل شيء منه منقاده","والفضل شيء منه منساقه",2,"ق",2,0],["والعذارى اذا بكين فقد يبكين","من قسوة الشباب المقالي",3,"ل",2,0],["والعذرُ للفاتكِ العادِي فإنْ جَزِعَتْ","نَفْسُ المُروَّعِ أَمَسْى غَيرَ معذورِ",4,"ر",1,0],["وَالعَذارى سَوافر لاهيات","بِالأَراجيح وَهِيَ في الأَغصان",5,"ن",1,0],["والعذر كل العذر في تأخيرها","عنكم فليس الأمر طبق مراديهْ",6,"ي",2,0],["والعذر في الناس طبع لا تثق بهم","وان ابيت فخذ في الامن والوجل",7,"ل",1,0],["والعذر أني لم أعثر بمدته","على الفصوص وهذا الكفر والكذب",8,"ب",1,0],["وَالعُذرُ لي فيما هَذَيتُ بِهِ","إِن كانَتِ الحُمّى مِن العُذرِ",9,"ر",1,0],["والعذر يكفِينيه عندك بعد ذا","علمي بأنك عالم بودادي",10,"د",2,0],["والعذرُ في تركي دعاءَك مسرعاً","عذرٌ وحقِّك واضحٌ برهانُهُ",11,"ن",2,0],["والعذارى أورَدتهنَ الوَغى","مورِداً غطّت حوافيه الصلال",12,"ل",1,0],["والعذار لما بدا زاد الوقود","وغرامي فيه تأكد",13,"د",1,0],["والعذر منك ومن وحسام الدين من","قد فاق في التحقيق كل فطين",14,"ن",1,0],["والعُذَيْبَ العُذَيْبَ يا ركبُ فالقلْ","بُ له بالعُذيْبِ داءٌ عُضالُ",15,"ل",1,0],["والعذرُ فيمن هَوِيتُ منبسطٌ","والعذرُ في مثلِ حُسنه لائِق",16,"ق",1,0],["والعُذرُ في وُضوحِه","نارٌ بكفِّ قابس",17,"س",1,0],["والعذر تعرفه فذهني بعد ما","بي حل صار مشتتا ومبددا",18,"د",2,0],["والعُذيبُ العذبُ شرقيَّ الحمى","عمَّه الوبلُ فأرواهُ وهَنّا",19,"ن",2,0],["والعذرُ يا هندُ بادٍ","يُتلى ويُروى ويُسمَع",20,"ع",1,0],["والعذارى بالصون مشتهراتٌ","كيف تُدعى قلوبهنَّ هواءَ",21,"ا",2,0],["والعذر في عدم السلوان متضح","فما عليك إذا لم تسل من عذل",22,"ل",1,0],["وَالعذر ما أَبديتهُ لِجَنابكم","وَبِهِ اِعتَذرت أَخا المَقام السامي",23,"م",2,0],["وَالعُذرُ ذَنبٌ لا يُزيلُ جِنايةً","أَترى الخَطايا تَنمَحي بِخَطيئةِ",24,"ه",1,0],["وَالعُذرُ قَولي عِندَ مَن لامَني","النّفسُ خَضراءُ وذا أَخضَرُ",25,"ر",1,0],["والعذر أوضح واضح فيما جرى","وأعيذكم من أن يُلمَّ مَلام",26,"م",1,0],["والعذر أوضح والكمال لربنا","وله الثناء بأولٍ وبآخِرِ",27,"ر",1,0],["والعذارَ اخلعْه وانشر","فيه راياتِ المجون",28,"ن",1,0],["وَالعُذر عني عند كل مجانب","دنس الدناءَة فضله متحقق",29,"ق",1,0],["والعذل في سمع المحب كأنه","مال العلاء يراد للتضييعِ",30,"ع",1,0],["والعذق لباه إذ دعاه","وهكذا أخرس الجماد",31,"د",1,0],["والعذق لباه لما إن دعاه كما","عليه قطر الحيا لما دعا وكفى",32,"ف",2,0],["والعذر إني كنت فيه مفزعاً","زورا ببطشه ساخط جباه",33,"ه",1,0],["والعذارى لكل وحشٍ تمطى","واليتامى لمنسم الروّاد",34,"د",1,0],["والعذر إن قصرت عن شأوه","إذ كان في ميدانه سابقى",35,"ق",2,0],["والعذارى ينثرن زهراً وعطراً","ويبلّلن بالدّموع ثراها",36,"ا",3,0],["والعذر في شرع الوداد لمن","يبكيك حتى ينقضي العُمُر",37,"ر",1,0],["والعذر انّ هموماً طاردت فكري","فأطول الليل عندي غاية القصر",38,"ر",1,0],["والعذر عندك مقبول وها أناذا","عن الثنا جئت بالتقصير معترفا",39,"ف",2,0],["والعذب من وصلكم","يطفي لهيب علتي",40,"ي",1,0],["والعذر منك مؤمل يا ذا العلا","والصفح منك تفضل أسترفده",41,"د",2,0],["والعذر أولى ما يكون من الفتى","والصفح أشرف ما يكون إذا هفا",42,"ف",2,0],["والعذر منه مع القبول هديةٌ","جادت عليَّ بنعمةٍ تنفي الجفا",42,"ف",2,0],["وَالعذولُ الظَلومُ يَهذي بلومي","وَيَرى ذلتي وَيَرضى أَنيني",43,"ن",2,0],["وَالعذر لي عَن قُصوري في مَديحك إِذ","طُول الهُموم أَعار الذهن تَقصيرا",44,"ر",2,0],["والعذاري يجدن بالعبرات","ثم صاحت إيقاب واحسراتي",45,"ي",1,0],["والعُذرُ أَحسَنَهُ الَّذي قَد زالَ عَن","كَ وَقَد حَمِدت وُقوعَهُ وَمِثالُه",46,"ل",2,0],["والعذارى قلنَ : اهْجها قلت : كلا","سوف يكفيها غيظها يا عذارى",47,"ر",2,0],["والعذر اطلب من كل الذين لهم","فضل تسطّره الأقلام في الكتب",48,"ب",1,0],["والعذر اطلبه يا من أطعت يدي","إني قسوت عليك اليوم من عشمي",49,"م",2,0],["والعذر بالتأخير عندك واضحٌ","وأراه عند أولي المكارم لا يردُ",50,"د",1,0],["والعذب بالملح من نوع البديع يرى","فيه طباق به تحلو معانينا",51,"ن",2,0],["والعذارى تلتقي","عندَ فردوس الهنا",52,"ا",1,0],["والعذارى جوقةٌ","صوتها يسبي المها",52,"ا",1,0],["والعذر يا سامع الجيلي","هذر هاوي وللشعر فنه",53,"ن",2,0],["والعذارى بين الربى يتهادين","ندي النوار والزهرات",54,"ت",1,0],["وَالْعُذْرُ حَطَّ مِنَ السّمَاءِ مُزَلْزِلا","قَالَتْ كَمَا يَعْقُوبُ صَاحَ مُرَدّدَا",55,"د",2,0],["والعذاب اللي يذوب بعين من يفقد خليله","عندي اكبر من عذاب العين لو تفقد نظرها",56,"ر",3,0],["والعذرُ تِلْوَ العذرِ أسمجُ حيلةٍ","فإلى متى في عفوِنا تتعثرُ",57,"ر",1,0],["وَالعَذاباتُ مَسرَحِيَّةُ كِذبٍ","لَكِ فِيها البُطُولَةُ المُستَمِرَّةْ",58,"ر",2,0]]}