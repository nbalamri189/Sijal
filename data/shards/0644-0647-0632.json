{"poems":[[53,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[4,"ألا ذهب المحافظ والمحامي","https://www.aldiwan.net/poem21204.html","الوافر"],[51,"وقائل كيف تهجو","https://www.aldiwan.net/poem61920.html","المجتث"],[51,"لشاعرنا خالد في استه","https://www.aldiwan.net/poem65010.html","المتقارب"],[38,"تبصر خليلي هل ترى من ظعائن","https://www.aldiwan.net/poem7707.html","الطويل"],[44,"دنا سفر والدار تنئي وتصقب","https://www.aldiwan.net/poem30573.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42701","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54767","السريع"],[44,"دنا سفرٌ والدر تنأى وتصقبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15650&r=&rc=10",""],[320,"ألا هاج قلبي العام ظعن بواكر","https://www.aldiwan.net/poem56358.html","الطويل"],[335,"رأيت وقد أتى نجران دوني","https://www.aldiwan.net/poem45430.html","الوافر"],[351,"بروحي جمالا صورته يد القدره","https://www.aldiwan.net/poem40340.html","الطويل"],[362,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[400,"ناقضت ما قلت يا جهول","https://www.aldiwan.net/poem33603.html","مخلع البسيط"],[438,"ألا من لصب لا تجف دموعه","https://www.aldiwan.net/poem14326.html","الطويل"],[459,"يود المسف الجون تحمله الصبا","https://www.aldiwan.net/poem15374.html","الطويل"],[549,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"]],"verses":[["لَهُ زَجَلٌ كَالفَحلِ يَقرَعُ شَولَهُ","أَلَظَّ بِقَرقارِ الهَديرِ وَرَدَّدا",0,"د",2,0],["لَهُ زَبَدٌ عَلى الناجودِ وَردٌ","بِماءِ المُزنِ مِن ريقِ الغَمامِ",1,"م",1,0],["له زُنوج حضور","هَزَلت وهْو مُجدُّ",2,"د",1,0],["له زوجة شرَّ ما زوجةٍ","تلقَّطها شرُّ ما لاقطِ",3,"ط",1,0],["لَهُ زِئبَرٌ جوفٌ كَأَنَّ خُدودَها","خُدودُ جِيادٍ أَشرَفَت فَوقَ مِربَدِ",4,"د",1,0],["لَهُ زِئبِرٌ يُدفي مِنَ الذَمِّ كُلَّما","تَجَلبَبَهُ في مَحفِلٍ مُتَجَلبِبُ",5,"ب",1,0],["لَهُ زَفْرَةٌ تَتْرَى وَعَيْنٌ سَخِيَّةٌ","وَقَلْبٌ كَزَهْرَاءِ الْمَصَابِيحِ يَرْجُفُ",6,"ف",1,0],["لَه زُهَى الشمْسِ وَمِنْ حَوْلِهِ","نِظَامُ تِلْكَ الشَّرِكَاتِ الْعِدَادْ",7,"د",1,0],["لَهُ زِئْبِرٌ يُدْفِي مِن الذم كلَّما","تجلببهث في محفل متجلببُ",8,"ب",1,0],["لَهُ زِبرِجٌ بَرقٌ وَرَعدٌ كَأَنَّهُ","مَزاميرُ جونٌ هَيَّجَتها مَزاهِرُ",9,"ر",1,0],["لَهُ زَجَلٌ تَقولُ أَصَوتُ حادٍ","إِذا طَلَبَ الوَسيقَةَ أَو زَميرُ",10,"ر",1,0],["لَهُ زَجَلٌ كَأَنَّ الرِجلَ مِنهُ","إِذا ما قامَ مُعتَمِداً كَسيرُ",10,"ر",1,0],["لَهُ زُفّت الأَفراح بِالعزّ درَّةً","عَلى تاج هَذا العَصر ما مِثلها دُرَّه",11,"ر",2,0],["لَهُ زَمانُ كُلُّهُ رَبيعُ","وَهِمَّةٌ جَنابُها مُريعُ",12,"ع",1,0],["له زمان مع مكان","بذا وهذا له حصول",13,"ل",1,0],["له زفرات زفرة إثر زفرة","إذا صعدت كادت تقد ضلوعه",14,"ع",2,0],["له زجلٌ من رعْده فكأنَّهُ","طُبولُ ملوكٍ أعلنتها الوقائعُ",15,"ع",1,0],["له زَفرةٌ مِن فوق جنب صريعهِ","كما صُكَّ صُلْبٌ يابسٌ بصِلابِ",16,"ب",1,0]]}