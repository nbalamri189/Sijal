{"poems":[[55,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[4,"ألا ذهب المحافظ والمحامي","https://www.aldiwan.net/poem21204.html","الوافر"],[53,"وقائل كيف تهجو","https://www.aldiwan.net/poem61920.html","المجتث"],[53,"لشاعرنا خالد في استه","https://www.aldiwan.net/poem65010.html","المتقارب"],[40,"تبصر خليلي هل ترى من ظعائن","https://www.aldiwan.net/poem7707.html","الطويل"],[46,"دنا سفر والدار تنئي وتصقب","https://www.aldiwan.net/poem30573.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42701","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54767","السريع"],[46,"دنا سفرٌ والدر تنأى وتصقبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15650&r=&rc=10",""],[327,"ألا هاج قلبي العام ظعن بواكر","https://www.aldiwan.net/poem56358.html","الطويل"],[342,"رأيت وقد أتى نجران دوني","https://www.aldiwan.net/poem45430.html","الوافر"],[358,"بروحي جمالا صورته يد القدره","https://www.aldiwan.net/poem40340.html","الطويل"],[369,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[409,"ناقضت ما قلت يا جهول","https://www.aldiwan.net/poem33603.html","مخلع البسيط"],[447,"ألا من لصب لا تجف دموعه","https://www.aldiwan.net/poem14326.html","الطويل"],[466,"يود المسف الجون تحمله الصبا","https://www.aldiwan.net/poem15374.html","الطويل"],[556,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[899,"","https://poetry.dctabudhabi.ae/diwan/poem/115094","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70895","المجتث"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96741","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25454","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20389","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27669","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28550","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112315","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108331",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109939","الطويل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46020","الرمل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131092",""],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70161","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77173","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119625","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204249","الطويل"],[5431,"أيا ليته يجني الكريم عدالةً","https://www.poetsgate.com/ViewPoem.aspx?id=187715",""]],"verses":[["لَهُ زَجَلٌ كَالفَحلِ يَقرَعُ شَولَهُ","أَلَظَّ بِقَرقارِ الهَديرِ وَرَدَّدا",0,"د",2,0],["لَهُ زَبَدٌ عَلى الناجودِ وَردٌ","بِماءِ المُزنِ مِن ريقِ الغَمامِ",1,"م",1,0],["له زُنوج حضور","هَزَلت وهْو مُجدُّ",2,"د",1,0],["له زوجة شرَّ ما زوجةٍ","تلقَّطها شرُّ ما لاقطِ",3,"ط",1,0],["لَهُ زِئبَرٌ جوفٌ كَأَنَّ خُدودَها","خُدودُ جِيادٍ أَشرَفَت فَوقَ مِربَدِ",4,"د",1,0],["لَهُ زِئبِرٌ يُدفي مِنَ الذَمِّ كُلَّما","تَجَلبَبَهُ في مَحفِلٍ مُتَجَلبِبُ",5,"ب",1,0],["لَهُ زَفْرَةٌ تَتْرَى وَعَيْنٌ سَخِيَّةٌ","وَقَلْبٌ كَزَهْرَاءِ الْمَصَابِيحِ يَرْجُفُ",6,"ف",1,0],["لَه زُهَى الشمْسِ وَمِنْ حَوْلِهِ","نِظَامُ تِلْكَ الشَّرِكَاتِ الْعِدَادْ",7,"د",1,0],["لَهُ زِئْبِرٌ يُدْفِي مِن الذم كلَّما","تجلببهث في محفل متجلببُ",8,"ب",1,0],["لَهُ زِبرِجٌ بَرقٌ وَرَعدٌ كَأَنَّهُ","مَزاميرُ جونٌ هَيَّجَتها مَزاهِرُ",9,"ر",1,0],["لَهُ زَجَلٌ تَقولُ أَصَوتُ حادٍ","إِذا طَلَبَ الوَسيقَةَ أَو زَميرُ",10,"ر",1,0],["لَهُ زَجَلٌ كَأَنَّ الرِجلَ مِنهُ","إِذا ما قامَ مُعتَمِداً كَسيرُ",10,"ر",1,0],["لَهُ زُفّت الأَفراح بِالعزّ درَّةً","عَلى تاج هَذا العَصر ما مِثلها دُرَّه",11,"ر",2,0],["لَهُ زَمانُ كُلُّهُ رَبيعُ","وَهِمَّةٌ جَنابُها مُريعُ",12,"ع",1,0],["له زمان مع مكان","بذا وهذا له حصول",13,"ل",1,0],["له زفرات زفرة إثر زفرة","إذا صعدت كادت تقد ضلوعه",14,"ع",2,0],["له زجلٌ من رعْده فكأنَّهُ","طُبولُ ملوكٍ أعلنتها الوقائعُ",15,"ع",1,0],["له زَفرةٌ مِن فوق جنب صريعهِ","كما صُكَّ صُلْبٌ يابسٌ بصِلابِ",16,"ب",1,0],["له زَفرةٌ يا أُمّ عمرٍو وعبرَةٌ","يُبلى به يا أم عمرٍو دَبيبُها",17,"ب",3,0],["له زحيرٌ ونفخ","كعاصفات الرياح",18,"ح",1,0],["لَه زهدُ عيسى في سماحةِ حاتمٍ","وَبطش كليم اللّه موسى بن عمرانا",19,"ن",2,0],["لَهزَم خَدَّيَّ بِهِ مُلَهْزِمُهْ","ورَعْنُ مَقْرُومٍ تَسامَى آرِمُهْ",20,"م",2,1],["لهزج ستا مفاعيلن يرد","بالجزء للعروض ضربين اعتمد",21,"د",1,0],["له زجر يغشى به العصم في الذرى","وبأسٌ متى ينذر به النجم يصدق",22,"ق",1,0],["لَهُ زُبَرٌ كاللبد طارَت رَعابِلاً","وَكَتِفانِ كَالشَرخَينِ عَبَلٌ مُضَبَّرُ",23,"ر",1,0],["له زينةُ الأسماءِ أسماءِ خالقي","عليه من الأثوابِ ثوبُ حداد",24,"د",1,0],["لَهُ زَجَلٌ يَروي النَّسيمُ وَراءَهُ","أَحاديثَ نَشرِ الرَّوضَةِ المُتَضَوِّعِ",25,"ع",1,0],["لهُ زَفَرَاتٌ كلما جَنّهُ الدّجى","يشقّ بها ستر الدجى ويمزّعُ",26,"ع",1,0],["له زهر اخلاق ارق من الصبا","تجانسني في الشعر لما اشبب",27,"ب",1,0],["لهُ زَأَراتٌ تبايعوهنَّ أَجمَعَت","فرائصهم في المِنبَرِ الاسدُ الوَردُ",28,"د",1,0],["لهزماتٌ ناعِماتٌ","بِالأَفاويهِ عَبوقَه",29,"ق",2,0],["له زفرات ليس للنار حرها","وشجو كما ناحت حمام على الرند",30,"د",1,0],["لَهُ زُفَّت كَريمة خير قومٍ","فَذي بنتُ العَميدِ إِلى العَميدِ",31,"د",1,0],["لَهُ زاخِر الفَضلُ الَّذي فاضَ حِكمَة","وَمن عِلمِهِ لِلنّاسِ في فَضلِهِ خال",32,"ل",1,0],["له زاجر من عقله سوى العلى","وليس له عن وارد الجود زاجر",33,"ر",1,0],["له زورة في العام ما زال يومها","كفيلاً بحظي سيد ومسود",34,"د",1,0],["لهزاع آفاق السناء ونفسه","تعاف فعال الظالم المتوعدِ",35,"د",1,0]]}