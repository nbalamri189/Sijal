{"poems":[[91,"قلت الحقيقة طالباً أن ينظروا","https://www.aldiwan.net/poem45119.html","الكامل"],[45,"أفكر في ادعائهم قريشا","https://www.aldiwan.net/poem10609.html","الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20991","السريع"],[20,"أَبلِغ خليلي عند هند فلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70013&r=&rc=35",""],[147,"النجم أقرب من مداك منالا","https://www.aldiwan.net/poem11792.html","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119879","البسيط"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105120","البسيط"],[5829,"الاسراء والمعراج","https://www.poetsgate.com/ViewPoem.aspx?id=166830",""]],"verses":[["إن كذبوك يضيرهم تكذيبهم","إياك أعنى أيها الصديق",0,"ق",1,0],["أنكذب فيكم الثقلين طراً","ونقبلكم لأنفسكم شهودا",1,"د",2,0],["إنَّكَ ذُو عَهدٍ وذُو مَصدَقٍ","مُجانِبٌ هَديَ الكَذُوبِ اللَّموص",2,"ص",1,0],["إِنَّكَ ذو عَهدٍ وَذو مَصدَقٍ","مُخالِفٌ عَهدَ الكَذوبِ اللَموص",3,"ص",1,0],["إِن كَذَّبَ الأَطماعَ بَأسُكَ في الوَغى","فَنَدى يَدَيكَ يُصَدِّقُ الآمالا",4,"ل",2,0],["إن كذبتني الأيام ظنا","صدق إحسانه رجائي",5,"ا",2,0],["إن كذبتك الأماني بالعلى فابن","بصادق العزم منها الكاذب الأشرا",6,"ر",2,0],["29. إن كذبوك فلا تهن قد كذبوا","رسلاً أتتهم بالكتاب وبالعبر",7,"ر",1,0]]}