{"poems":[[88,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[95,"هذا الرثاء الذي تمليه أشجاني","https://www.aldiwan.net/poem11189.html","البسيط"],[95,"أحننت من شوق إلى لبنان","https://www.aldiwan.net/poem11270.html","الكامل"],[90,"عبد المجيد قضى فوا أسفا","https://www.aldiwan.net/poem45049.html","أحذ الكامل"],[29,"سمت لي نظرة فرأيت برقا","https://www.aldiwan.net/poem5736.html","الوافر"],[74,"أهوى بمرشفه الشهي وقال ها","https://www.aldiwan.net/poem19469.html","الكامل"],[87,"طال عليها القدم","https://www.aldiwan.net/poem63695.html","مجزوء السريع"],[87,"يا رب أمرك في الممالك نافذ","https://www.aldiwan.net/poem63758.html","الكامل"],[63,"إني هديت لنعمة مكنونة","https://www.aldiwan.net/poem51755.html","الكامل"],[104,"افدي بروحي غيد اشبيليه","https://www.aldiwan.net/poem33027.html","السريع"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85598","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85600","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142033","الكامل"],[106,"بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=5126",""],[108,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[113,"ألا هات أسقني كأسا فكأسا","https://www.aldiwan.net/poem16380.html","الوافر"],[255,"حتام تخدع عزمي الآمال","https://www.aldiwan.net/poem15007.html","الكامل"],[275,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[308,"بي رشأ من خلف فدانه","https://www.aldiwan.net/poem58042.html","السريع"],[310,"بيرم الخامس الهدى","https://www.aldiwan.net/poem56560.html","مجزوء الخفيف"],[353,"بي رمد جاء كلمح بالبصر","https://www.aldiwan.net/poem20234.html","الرجز"],[382,"أولى مسيري ذا الأمان","https://www.aldiwan.net/poem59233.html","مجزوء الكامل"],[469,"لهفي على غصن النقا المتمايل","https://www.aldiwan.net/poem3200.html","عموديه"],[469,"هي ظبية الوادي وعين لداتها","https://www.aldiwan.net/poem3345.html","عموديه"],[534,"قلب تقلب في فنون","https://www.aldiwan.net/poem37273.html","مجزوء الكامل"],[567,"قف فوق رابية تجاه المسجد","https://www.aldiwan.net/poem52889.html","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126891","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37853","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120018","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55948","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141293","الرمل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104800","المديد"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108436","البسيط"],[2203,"","https://poetry.dctabudhabi.ae/diwan/poem/104459","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109400","السريع"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109398","الكامل"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111147","الرمل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106979","الرجز"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137128",""],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101597","الخفيف"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216566",""],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122250","الكامل"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122251","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86505","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70156","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77023","الكامل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107508","الكامل"],[4087,"","https://poetry.dctabudhabi.ae/diwan/poem/131657",""],[4087,"","https://poetry.dctabudhabi.ae/diwan/poem/131678",""],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54462","الكامل"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83596","السريع"],[4604,"","https://poetry.dctabudhabi.ae/diwan/poem/113021","الخفيف"],[4728,"الهلامة والصتيمة","https://www.poetsgate.com/ViewPoem.aspx?id=176970",""],[4767,"جرح لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=215436",""],[4831,"ربيع لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=208035",""],[4852,"بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=215294",""],[4859,"بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=207372",""],[4859,"فتات!","https://www.poetsgate.com/ViewPoem.aspx?id=215564",""],[4908,"إيقاع على وتر الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=207335",""],[557,"مرثية حلم","https://www.poetsgate.com/ViewPoem.aspx?id=13825",""],[5030,"بيروتُ","https://www.poetsgate.com/ViewPoem.aspx?id=215694",""],[5121,"بَيْرُوتُ","https://www.poetsgate.com/ViewPoem.aspx?id=215301",""],[5271,"نواقيس الرؤى","https://www.poetsgate.com/ViewPoem.aspx?id=123677",""],[5277,"رغبةٌ من جنون","https://www.poetsgate.com/ViewPoem.aspx?id=188248",""],[5320,"شكرا أمريكا","https://www.poetsgate.com/ViewPoem.aspx?id=41633",""],[5353,"بيروت تحفل بالأسى","https://www.poetsgate.com/ViewPoem.aspx?id=215399",""],[5376,"بيروت كالعنقاء ليس تموت","https://www.poetsgate.com/ViewPoem.aspx?id=215546",""],[5410,"ثورة أنين","https://www.poetsgate.com/ViewPoem.aspx?id=133057",""],[5410,"صرخات من أعلى المنارة","https://www.poetsgate.com/ViewPoem.aspx?id=142533",""],[5493,". جراح الأمس .","https://www.poetsgate.com/ViewPoem.aspx?id=197040",""],[5595,"إنّ العراقَ أبيّ ٌ أينما ذهبوا","https://www.poetsgate.com/ViewPoem.aspx?id=144531",""],[5625,"تمرد انثى","https://www.poetsgate.com/ViewPoem.aspx?id=182834",""],[5751,"شَكوى مُسافر","https://www.poetsgate.com/ViewPoem.aspx?id=214716",""],[5751,"العامليّة","https://www.poetsgate.com/ViewPoem.aspx?id=214762",""],[5823,"بكائية لياسمين دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=59163",""],[5879,"غربل ترابك","https://www.poetsgate.com/ViewPoem.aspx?id=215401",""],[5943,"بيروت تقصفُ","https://www.poetsgate.com/ViewPoem.aspx?id=34804",""],[5944,"عروبتنا النازفة","https://www.poetsgate.com/ViewPoem.aspx?id=215338",""],[5970,"محنة تأتي وأخرى في رواح","https://www.poetsgate.com/ViewPoem.aspx?id=130629",""],[6070,"بيريزُ مَاتَ وطارتِ الغربانُ","https://www.poetsgate.com/ViewPoem.aspx?id=188857",""],[6093,"بئرٌ معطلةٌ ( الكامل )","https://www.poetsgate.com/ViewPoem.aspx?id=176094",""],[6152,"لا بأس يا بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=215639",""],[5190,"اصمد وقاوم أيها اللبناني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78289&r=&rc=3",""]],"verses":[["بَيروتُ لَو أَنَّ خَصماً","مَشى إِلَيَّ مَشَيتُ",0,"ت",1,0],["بَيروتُ مَهدُ غَرامي","فيها وَفيكِ صَبَوتُ",0,"ت",1,0],["بَيْرُوتُ مَاذَا رَمَانِي فِي الصَّمِيمِ وَقَدْ","رُمِيتُ فِي مُلْتَقَى ذِكْرِي وَتَحْنَانِي",1,"ن",2,0],["بَيْرُوتُ يَا بَلَداً عَزِيزاً طَيِّباً","سَمْحَ السَّرِيرَةِ صَادِقَ الْشُّكْرَانِ",2,"ن",1,0],["بَيْرُوتُ هَذَا مَنْ بَلَغْتِ مِنَ العُلَى","بِمَكَانِهِ السَّامِي أَعَزَّ مَكَانِ",2,"ن",1,0],["بيروت منه أحرزت شرفا","لما غدت لعلاه مضطجعا",3,"ع",2,0],["بِيَربوعٍ فَخَرتَ وَآلِ سَعدٍ","فَلا مَجدي بَلَغتَ وَلا اِفتِخاري",4,"ر",2,0],["بيراع سيفٍ أو بسيف يراعة","فصل الأمور جلادها وجدالها",5,"ل",3,0],["بي رَشَأٌ ناعِمٌ","ما عَرفَ العُمرَ هَم",6,"م",1,0],["بَيروتُ ماتَ الأُسدُ حَتفَ أُنوفِهِم","لَم يُشهِروا سَيفاً وَلَم يَحموكِ",7,"ك",1,0],["بَيروتُ يا راحَ النَزيلِ وَأُنسِهُ","يَمضي الزَمانُ عَلَيَّ لا أَسلوكِ",7,"ك",1,0],["بئرٍ كأنّ رِشاءَها في مائِها","سمراءُ قد رُكِزَتْ على مِرآةِ",8,"ه",1,0],["بيروتُ لو شئتُ دفعتُ النوى","طوْعاً ولم أهجركِ فالويل لي",9,"ي",1,0],["بيروت عز بلاد الضادِ قاطبةً","بنهضة القوم فيه يضرب المثل",10,"ل",1,0],["بيروت روح له لبنان جثمانُ","فليحي للمجد بيروت ولبنانُ",11,"ن",1,1],["بيروت نسر له لبنان أَجنحةٌ","لبنان عين لها بيروت إنسان",11,"ن",1,0],["بيروت بيت له لبنان أَعمدة","بيروت صرح له لبنان أَركان",11,"ن",1,0],["بيروت هل ذرفت عيونك دمعة","إلا ترشفها فؤادي المغرم",12,"م",1,0],["بيروت! ويحك! أين السحر والطيب؟","وأين سحر على الشطآن مسكوب؟",13,"ب",1,1],["بيروت! ماذا يقول الناس؟ هل ذبحت","بيض الأماني.. وغال الطفلة الذيب؟",13,"ب",1,0],["بيروت! لا تصفي لي الجرح.. أعرفه","فإنه في دمائي الحمر معصوب",13,"ب",1,0],["بيروت! نحن الألي ساقوك عارية","للموت يصرخ في عينيك تعذيب",13,"ب",1,0],["بئِّرَ الشِّرْك بموت عاجِل","أيها الشركُ، دَنَا يومُ الوفاة",14,"ا",2,0],["بيريك إِذا بَدا قَمَراً مُنيراً","وَغُصناً إِن ثَنى عَطفاً وَماسا",15,"س",2,0],["بيراعهم وسُيُوفهم بين الورى","تتقسَّمُ الأرزاقُ والآجالُ",16,"ل",1,0],["بيروتُ أُختُكِ يا دِمَشقُ فإنَّها","عرَبيَّةُ واللهُ أكبرُ شاهِد",17,"د",1,0],["بي رشأٌ من خلف فدانه","أضحى لأقمار الدجا وارث",18,"ث",1,1],["بيرمُ الخامسُ الهُدى","نورهُ مُشرقاً بدا",19,"د",2,1],["بي رَمَدٌ جَاءَ كَلَمْحِ بِالبَصَرْ","بِما دُهِي والحَالُ أَدْهَى وَأَمَرّْ",20,"ر",1,1],["بيروسُ معْ تُبّاعه","مع فُوتِيُوسٍ ذاكَ المُهان",21,"ن",1,0],["بي رافلٌ في حلّة الحسن الذي","ما بات عن ظلم المحبّ بغافل",22,"ل",1,0],["بيراعةٍ فيها المنيَّة والمنى","هاتيك للباغي وذي لبغاتها",23,"ت",3,0],["بِيرِ القَضَا نَصْباً ورَفْعا","يَلْقاكَ فيهِ كُلُّ عامِلْ",24,"ل",1,0],["بيروتُ نُوُحي في الأصائِلِ والضُّحَى","حُزناً عليهِ ولا أقولُ تَجَلَّدي",25,"د",2,0],["بيراعهِ ردّ العدى مقهورةً","ما سالَمتهُ يدٌ له ولسانُ",26,"ن",1,0],["بَيروتنا مقبرةٌ","للعِلمِ والعِرفانِ",27,"ن",1,1],["بيراعه راع العدو","وفجنه خوفا مؤرقٌ",28,"ق",1,0],["بيروتنا بك كم غدت تهدي الثنا","وتجلّك الصغراء والكبراءُ",29,"ا",2,0],["بيراع يسبك الدرّ به","ولسان يلفظ الدرّ كلاما",30,"م",2,0],["بِئرَ حُبٍّ فِيها مَشرَبُكُم","فاحمدُوا لِلهِ ذِى النِّعَمِ",31,"م",1,0],["بيروت سرت بواليها وحق لها","هذا السرور لنعمى افضل الدول",32,"ل",1,1],["بئراً اعدت للسقاية في الورى","طوبى لمنشئها غداً في المحشر",33,"ر",1,1],["بيروت قد شدت بهِ أزرها","وفاخرت مصرَ به والشآم",34,"م",1,0],["بيروت قد حازت به شرفاً وقد","باهت بمظهرهِ العراق وجلقا",35,"ق",2,0],["بيراع دونه العضب الرهيف","كم جسيم وهو ذو جسم نحيف",36,"ف",1,0],["بي رشأ منك يزين جيده","العاطل حسناً وكفاه الجيدّ",37,"د",1,0],["بيروت قرت عينها ووفود لبنان","بهم قد ضاقت البيداء",38,"ا",2,0],["بيراع دم الضعيف له حب","ر ونواحُ المظلوم صوت صريره",39,"ر",2,0],["بير الوَعَد ريته معَطّل","فِيْه الثرى ومْغبّي الْطَّيّ",40,"ط",2,0],["بيروت إني في هواها أرغب","من ثغرها البسام طاب المشربُ",41,"ب",1,1],["بيروت مثل الشام أضحت جنة","والبحر يغني عن كثير الأنهر",42,"ر",1,1],["بيروت حين وليتها","برأت من الداء العقام",43,"م",1,0],["بيروت ترثيهِ وَالشَهباءُ تندبهُ","وَمَصر تطريهِ وَالدامورُ تفتقدُ",44,"د",1,0],["بيراعه راعَ العُداة كَأَنَّما","أَلفاتُهُ في الضَد عَدن نُصولا",45,"ل",2,0],["بيروت إِذ أَلقت زمامها","مصرٌ أتاها ذو المراحم يوسفُ",46,"ف",1,1],["بير العزب غيمها مثل السجاف","وحرها في الربيع يبقى سجيف",47,"ف",1,0],["بير العزب لا بسه حله جديد","والروضه النائيه سفرة طلى",48,"ل",2,1],["بير العزب مصر والروضه شبام","والأصل في ذا الكلام حب الوطن",48,"ن",1,0],["بيراعهِ أَبداً يُراعى عالمٌ","في سِرْبهِ ويُراعُ سربُ الجاهلِ",49,"ل",1,0],["بيرأريس شربوا من مائها","وسرّحوا الأبصار في فنائها",50,"ه",2,0],["بَيروتُ أَم ثَغرُ العُلى بِاسمُ","أَم دارُ خُلدٍ ظِلُّها دائِمُ",51,"م",1,1],["بيَراعٍ منه تُراعُ المَنايا","ويُراعَى فيه ربيعُ الأمانِ",52,"ن",1,0],["بيرٍ تعكّر ماه واجب هدامه","ما دام ما تارد عليه المحيمة",53,"م",2,0],["بيروتُ يا أمَّ التعدد والإبا","يا من تتوق لحسنك الحسناء",54,"ا",2,0],["بَيروتُ في جَفْنِكَ المخضلِّ شاردةٌ","كأنَّها عَبَقٌ جادَتْ بِهِ نُسُمُ",55,"م",1,0],["‏‎بيروت يا أرض الجمال، سلامنا","لو كل أنفاس الحياة .. تموتُ",56,"ت",1,1],["بيروتُ أنتِ جديلةٌ وشريطةٌ","في شَعر أرضٍ زانها الياقوتُ",56,"ت",1,0],["بيروت ياهذا وذاك عفيفةٌ","عربيّةٌ لم يثنها طاغوتُ",57,"ت",1,0],["بيروت كفي عن عويلك هدهدي","حلم اليتامى أخرسي الأصواتا",58,"ت",2,1],["بئرٌ مُعَطلَةٌ وحَقْلٌ قَاحِلُ","أطلالُ تبكي أهلَها وهياكلُ",59,"ل",1,1],["بيروت في اليم ماتت قدسنا انتحرت","ونحن في العار نسقي وحلنا طينا",60,"ن",2,0],["‏‎‎بيروت يا جذوة الإحساسِ قد حُرقت","مشاعري وشديد الهم مكبوتُ",61,"ت",1,1],["بَيْرُوتُ يَا صَفْحَةً وَتَبْتَهِلُ","فِي سَجْدَةِ الْحِبْرِ وَالنَّدَى أَمَلُ",62,"ل",1,1],["بَيْرُوتُ يَا رُوحَ الْحُبِّ قَدْ نَشِفَتْ","فِي قَلْبِكِ الأُمْنِيَاتُ وَالْقُبَلُ",62,"ل",1,0],["بَيْرُوتُ يَا بِنْتَ النُّورِ قَذْ ثَكِلَتْ","فِي شَمْسِكِ الأُمُّ وَالسَّنَا خَجِلُ",62,"ل",1,0],["بَيروتُ في عَينَيكِ حِينَ ضَمَمْتُهَا","أَحسَستُ في عُمقِ الشَغَافِ حَرُونَا",63,"ن",2,0],["بي رغبةٌ من جنونٍ لستُ أعرفهُ","إلا شواظاً يمسُّ الروحَ والعصبا