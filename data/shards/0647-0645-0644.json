{"poems":[[88,"أطل على الأكوان والخلق تنظر","https://www.aldiwan.net/poem10689.html","الطويل"],[85,"حياك يا دار الهوى من دار","https://www.aldiwan.net/poem54294.html","الكامل"],[4,"سفها عذلت وقلت غير مليم","https://www.aldiwan.net/poem21199.html","الكامل"],[53,"أبى القلب إلا وجده برخاص","https://www.aldiwan.net/poem64933.html","الطويل"],[53,"بني وهب الله جار لكم","https://www.aldiwan.net/poem66482.html","المتقارب"],[58,"إن الرسول لم يزل يقول","https://www.aldiwan.net/poem58534.html","الرجز"],[45,"أحق عاف بدمعك الهمم","https://www.aldiwan.net/poem10537.html","المنسرح"],[89,"كل صعب سوى المذلة سهل","https://www.aldiwan.net/poem8345.html","الخفيف"],[107,"قومي أهاب من الحياة بشير","https://www.aldiwan.net/poem42068.html","الكامل"],[22,"عفا مسحلان من سليمى فحامره","https://www.aldiwan.net/poem21639.html","الطويل"],[77,"أرياك أم ردع من المسك صائك","https://www.aldiwan.net/poem69053.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85497","الكامل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140856",""],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[45,"أحق عاف بدمعك الهمم","https://www.poetsgate.com/ViewPoem.aspx?id=143",""],[53,"بني وهب الله جارٌ لكم","https://www.poetsgate.com/ViewPoem.aspx?id=30677",""],[119,"هيج البعد هواها","https://www.aldiwan.net/poem40431.html","عموديه"],[119,"ألقيت في باب أهل اللَه في حلب","https://www.aldiwan.net/poem41748.html","البسيط"],[119,"نسيم الصبا إن زرت زورا وسامرا","https://www.aldiwan.net/poem41796.html","الطويل"],[234,"جرحي بعينيك ليس يندمل","https://www.aldiwan.net/poem50867.html","المنسرح"],[275,"أدمشق ما أمضى سيوف بنيك","https://www.aldiwan.net/poem35644.html","الكامل"],[398,"قد ظل يجرح صدري","https://www.aldiwan.net/poem53660.html","المجتث"],[406,"برقية شعرية إلى الصحافة العربية","https://www.aldiwan.net/poem10295.html","عموديه"],[463,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[463,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[463,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[484,"قالوا حبست فقلت ليس بضائري","https://www.aldiwan.net/poem37597.html","الكامل"],[505,"هذه واسط أم ذا حلم","https://www.aldiwan.net/poem37790.html","الرمل"],[520,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[556,"ليت أنا لا نعرف القوم فيهم","https://www.aldiwan.net/poem47808.html","الخفيف"],[567,"هكذا هكذا وإلا فلا لا","https://www.aldiwan.net/poem52814.html","الخفيف"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126859","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70956","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59736","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96631","الوافر"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203780",""],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6779","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49949","الطويل"],[1449,"","https://poetry.dctabudhabi.ae/diwan/poem/110682","الرجز"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114798","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123054","البسيط"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177830","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93588","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93733","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93867","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93812","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199999",""],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103490","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100786","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130044","الرجز"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82826","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138691",""],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101227","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117843","الرمل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131061",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133288","البسيط"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111066","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127298","الرمل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58164","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72426","الرجز"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139735",""],[4717,"ميمون","https://www.poetsgate.com/ViewPoem.aspx?id=204118",""],[4755,"أَهلِي.. وحَسبي أَنني عَنهُمُ","https://www.poetsgate.com/ViewPoem.aspx?id=183825",""],[1012,"باب الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=186322",""],[4816,"بصمت احبك","https://www.poetsgate.com/ViewPoem.aspx?id=32380",""],[4843,"يا أمةَ العربِ الأمجادِ في القدمِ","https://www.poetsgate.com/ViewPoem.aspx?id=142690",""],[4913,"بواسل العراق","https://www.poetsgate.com/ViewPoem.aspx?id=203008",""],[4929,"ارهاصات النهاية","https://www.poetsgate.com/ViewPoem.aspx?id=199351",""],[5082,"أطيافٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212387",""],[5186,"لا تعد بي إلى ربوع الخيام","https://www.poetsgate.com/ViewPoem.aspx?id=156442",""],[5206,"أئمة بني خروص","https://www.poetsgate.com/ViewPoem.aspx?id=187433",""],[5213,"أين العذيب وآرام بواديه","https://www.poetsgate.com/ViewPoem.aspx?id=170569",""],[5397,"عذبت لنظرة عينك الأرياف","https://www.poetsgate.com/ViewPoem.aspx?id=157965",""],[5428,"أراني كُلّما قطعوا المزارا","https://www.poetsgate.com/ViewPoem.aspx?id=124932",""],[5443,"ربَّاكَ ربّكَ جلَّ منْ ربَّاكَا","https://www.poetsgate.com/ViewPoem.aspx?id=185152",""],[5689,"ضاقت بمن في ظلها الآجام","https://www.poetsgate.com/ViewPoem.aspx?id=143413",""],[5691,"تحجر العُرْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=206096",""],[5756,"الجريمة","https://www.poetsgate.com/ViewPoem.aspx?id=5418",""],[5776,"إليهم... هم","https://www.poetsgate.com/ViewPoem.aspx?id=199538",""],[5846,"قصة ثورة","https://www.poetsgate.com/ViewPoem.aspx?id=69123",""],[5944,"طلع الشعر علينا","https://www.poetsgate.com/ViewPoem.aspx?id=212850",""],[5956,"هم لم يطيقوا أن يكونوا دولة واحدة","https://www.poetsgate.com/ViewPoem.aspx?id=205384",""],[6152,"أنتِ كوني وكياني","https://www.poetsgate.com/ViewPoem.aspx?id=203409",""],[520,"أقسمت لا كفت لمضر غمة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577494",""],[520,"عند ظباء الجلهتين ثاره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577515",""],[6171,"غرفتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86323&r=&rc=6",""],[6320,"ثَلْجُ الجَحِيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83636&r=&rc=17",""]],"verses":[["هُمُ لَهُمُ العامُ القَديمُ مُقَدَّرٌ","وَنَحنُ عَلى الآثارِ لا شَكَّ نَظفَرُ",0,"ر",1,0],["هَمَلِ المسَارح لا يُراعُ قنيصُهُ","إلا لنَبْأةِ فارسٍ مغوارِ",1,"ر",1,0],["هَمَلٌ عَشائِرُهُ عَلى أَولادِها","مِن راشِحٍ مُتَقَوِّبٍ وَفَطيمِ",2,"م",1,0],["هُمُ لوجوه الناس في المجد آنُفٌ","وهمْ لرؤوس الناس فيه نَواصي",3,"ص",2,0],["همُ للمولك أرواحها","إذا الناسُ كانوا كأبدانها",4,"ن",3,0],["هُمُ لِمَنْ والاهُمُ الأَمانُ","إِذْ كانَ فيهمْ يَكْمُلُ الإِيمانُ",5,"ن",1,0],["هُمُ لِأَموالِهِم وَلَسنَ لَهُم","وَالعارُ يَبقى وَالجُرحُ يَلتَإِمُ",6,"م",1,0],["هُمْ لَعَمْرِي أَذَلُّ مِنْ قَدَمِ الْنَّعْ","لِ نُفُوساً وَالنَّعْلُ مِنْهُمْ أَجَلُّ",7,"ل",1,0],["هُم للفِداءِ فَما لَهمْ مُتزحزَحٌ","إنْ صَحَّ وِجدانٌ وبَرَّ شُعورُ",8,"ر",1,0],["هُمُ لاحَموني بَعدَ جَهدٍ وَفاقَةٍ","كَما لاحَمَ العَظمَ الكَسيرَ جَبائِرُه",9,"ر",2,0],["هُمُ لحظوكم والنّبُوّةُ فيكُمُ","كما لحَظَ الشِّيبَ النّساءُ الفوارك",10,"ك",1,0],["هم للبلاد إذا اطمأنت شوكة","وَهم إذا ريعت هم الإنجاد",11,"د",1,0],["هم لأموالهم وليس لهم","والعار يبقى والجرح يلتئم",12,"م",1,0],["هم لكبات الخميس حدها","وجدها وشدها والمحتمى",13,"ا",1,0],["هُمُ لِأَموالِهِم وَلَسنَ لَهُمْ","وَالعارُ يَبقى وَالجُرحُ يَلتَئِمُ",14,"م",1,0],["هم للملوك كأرواحها","إذا الناسُ كانوا كأبدانها",15,"ن",3,0],["هملت منها عيون","والنوى زاد عناها",16,"ا",3,0],["هم للنزيل وهم أهل الدخيل وهم","عون الضعيف وأهل المن بالأرب",17,"ب",1,0],["هم للورى تلك السفينة قد نجا ال","ذي فيهم قلباً تمسك وانسرا",18,"ر",2,0],["هُمُ لُيوثُ الأنام إنْ جَبُنوا","وهُمْ هُداةُ العباد إن جَهِلوا",19,"ل",3,0],["هم للأعِنَّةِ والأسنّةِ والظّبى","يَشقى بها من رامَ أن يُشقيك",20,"ك",1,0],["هُمُ ليوثٌ غَيوثٌ","مِن دونِ حبطٍ وَضَرِّ",21,"ر",1,0],["هم لا يرون سوى القبيح وإنم","يهوي على المستنقعات ذبابُ",22,"ب",1,0],["هم لنصري أُسرةُ العزِّ القُدامى","وهُمُ أربابُ نُعمايَ الأَوالي",23,"ل",2,0],["هم لبسوا الدنيا وبع","دُ حسنُها لم يُنزَعِ",24,"ع",1,0],["هُمُ لعشيرتهم كالسما","ءِ كلُّ الذي تحتها يصغُرُ",25,"ر",1,0],["هم لي عيون قد سقيت بمائها","من سلسبيلي فاح عرف أزاهري",26,"ر",2,0],["هُمْ لَهُمْ في حضرَةِ الطَّمْسِ يدٌ","ولَهُمْ فوقَ الثُّريَّا قَدَمُ",27,"م",1,0],["هم لباب أنتم لبابه","وهم نضار أنتما نضاره",28,"ر",2,0],["هم ليوثٌ إذا اِستحرَّت وَفي يو","مِ عطاءٍ هُمُ عطاءً بحارُ",29,"ر",1,0],["هم لعَمري من أحسنِ النَّاسِ فِعلاً","جعلوني من أحسنِ النَّاسِ حالا",30,"ل",2,0],["هُم للبريّة رحمةٌ","وَبِحبّهم تُمحى الجرائِم",31,"م",1,0],["همُ لئام وهمْ غَوْغا سواسية","وهمْ بخال وهمْ حْمق بغير مِرا",32,"ر",2,0],["همْ للمعالي والعوالي","والحمى السامي المنيف",33,"ف",1,0],["همُ لَبثوا ثلاث مئين عاماً","وَتسعاً بعد فهي من المزيدِ",34,"د",1,0],["هم للسيادة والحياة مَشَوْا","وسيوفُهمْ رعافةٌ حمر",35,"ر",1,0],["هُمُ لُبابُ الوَرى حَقّاً وَغَيرُهُم","عِندَ الحَقيقَةِ أَبقالُ الغَرابيلِ",36,"ل",1,0],["هُمُ لرضَى الرّحمن آوَوا رسولَهُ","وهمْ أَسعدوه حين لا وقتَ مَسْعَدِ",37,"د",1,0],["هم للعلوم مصدر","ومورد فيه نعل",38,"ل",1,0],["هَمَلَت عليكَ العَينُ إذ أَقَرَرتَها","ومن الوَفاءِ بعهدِها أَن تَهمِلا",39,"ل",2,0],["هُم لرفع وصالي هجرهم نصبوا","فجرّ من جزمهم بالصد لي نَصَبُ",40,"ب",1,1],["هملت لمرآك العيون وقد نأى","مرمى العيان بغير ما إهمال",41,"ل",1,0],["هُم لِلسَماح كَما أن السَماح لَهُم","ما أَحسَن القَول مَعكوساً وَمَطردا",42,"د",2,0],["هَملت أَدمُعي رخاصاً وَدَمعي","كانَ في النائِبات ما أَغلاه",43,"ا",2,0],["هم ليوث إذا سطوا وغيوث","إن جفا القطر مجدب الأقطار",44,"ر",1,0],["هم لصديق المصطفى خير أبنا","ولسبطيه أكرم الأصهار",44,"ر",1,0],["هم ليوث الوغى حماة حماهم","ليس جفن الحسام منهم بغافي",45,"ف",2,0],["هم لدى القول يهزأون به","وهو يسعى لجعلهم بشرا",46,"ر",2,0],["هُم لِلعِداة كآجالٍ مُسَوَّمَةٍ","إِن حاولوا فَوتَها آلوا وَلَم يَئِلوا",47,"ل",3,1],["همُ لهمُ دعوى الهوى والهوى ليا","وأشكو وهم يبدون فيه التشاكيا",48,"ي",2,1],["هُم لحِماكِ جنّة","إن حلَّ في الدُنيا خَطر",49,"ر",1,0],["هُم لِلسَّلامِ وَلِلحُروب","وَبِهم عَلَينا اللَهُ مَن",50,"ن",1,0],["هم للوجود قوامه","سر الوجود بهم ظهر",51,"ر",1,0],["هم للهدات هداتهم","ولذي المفاخر مفتخر",51,"ر",1,0],["هملت أنامله الحمام فطأطأت","للدين رأساً بعد وهن زنودها",52,"د",3,0],["هم لعمر الله أعلام العلى","وهم اس الهدى والعمد",53,"د",1,0],["هم لم يخطئوا لكن","هل المضنى له عقل",54,"ل",1,0],["هم للزمان على طول المدى حلل","لكن سواهم لهذا الدهر أسمال",55,"ل",1,0],["هملت بنان أكفه","للوفد باسمة رويه",56,"ي",2,0],["هملت أجفاننا قائلة","ان هذا عارض ممطرنا",57,"ن",2,0],["هم للداء قد كانوا شفاء","وهمْ كانُوا حماةَ المسلمينا",58,"ن",2,0],["هم للوجود روحه من بعدهم","لذلك اختار الوجود العدما",59,"م",2,0],["هم للورى سفن النجاة وفيهم","يمحو المهيمن عنهم آثامها",60,"م",3,0],["هُمْ لقَّبُوهُ -عَلَى خِلَافِ حَقِيَقَةٍ-","(رِيمُ الفَلَا) .. (أَسَدُ الشَّرَى) ... مَا أَخْدَعَهْ!",61,"ع",2,0],["هُم لَحنُ هذي الأَرضِ, هُم لَونُها","هُم ثَوبُها, والزَّادُ, والمَرهَمُ",62,"م",1,0],["هُم لَحنُ (أَيُّوبَ) المُنَدَّى, وما","خَطَّ (الفَضُولُ) الشَّاعِرُ المُلهَمُ",62,"م",1,0],["هم لوحه المحفوظ كانت قلوبهم","بها قلم الأنوار للسر رقما",63,"م",2,0],["هملول حبك بالمعاليق ينساب","اليا طرى ذكراك جدد مخيله",64,"ل",2,0],["هم لقنوا العربَ الأجوادَ فلسلفةَ","وعلم طبٍ بهِ المنجاةُ من سقمِ",65,"م",1,0],["هُمْ للعراقِ عَِزيمةٌ لا تَثْبِط ُ","وَهُمْ النياشينَ التي يَتَنًوطُ",66,"ط",1,1],["هم لعنةٌ نزلتْ بالعُرْبِ ليس لها","من كاشِفٍ غيرَ أن يُلويْ بهم خُلَعَا",67,"ع",2,0],["هَمَلَتْ عُيُوني بحرَها","وتَسَرْبلتْ في فيضِ مَدِّكْ",68,"ك",1,0],["هم لأوطانهم غيوث ولسنا","في سماء الأوطان غير جهام",69,