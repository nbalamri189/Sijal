{"poems":[[48,"إذا خطب الزهراء شيخ له غنى","https://www.aldiwan.net/poem23014.html","الطويل"],[276,"بالابرق الفرد اطلال قديمات","https://www.aldiwan.net/poem52092.html","البسيط"],[284,"ذرا السعي في نيل العلا والفضائل","https://www.aldiwan.net/poem2630.html","الطويل"],[369,"جمال ولكن أين منك جميل","https://www.aldiwan.net/poem60800.html","الخفيف"],[369,"إذا لم يخن صب ففيم عتاب","https://www.aldiwan.net/poem61000.html","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65043","المنسرح"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/199440","الطويل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104815","البسيط"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104682","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139702",""],[2365,"ألاهل الى ورد العراق سبيل","https://www.poetsgate.com/ViewPoem.aspx?id=200655",""]],"verses":[["وَقَلَّ غَناءً عَن فَتاةٍ وَزَوجُها","أَخو هَرَمٍ أَحجالُها وَالمَخانِقُ",0,"ق",1,0],["وقل غدا أَنتَ من أَهل اليَمين اذا","زخرفن للداخلين الخلد جنات",1,"ت",1,0],["وقل غاب بدر التم عن أنجم الدجى","وأشرق منهم بعده كل آفل",2,"ل",1,0],["وقَلَّ غَناءُ الطِّرْفِ والقِدْحِ كُلّما","يَضيقُ مَجالٌ أو يَضيقُ مُجِيل",3,"ل",1,0],["وقَلّ غناءً عن فؤادٍ مُعَذّبٍ","بأنْ يتَجّلى كيف شاء إهاب",4,"ب",1,0],["وقُلْ غَداً مَوْعِدُ الوصِالِ ولا","تَقْصِدْ لإِنْجازِهِ ولا تَكِدِ",5,"د",1,0],["وقل غناء عنه إسبال عبرة","إذا ابتدرت كفكفتها بردائيا",6,"ي",2,0],["وَقُل غَداً عِندَما أُنادَى","يَومَ الحِسابِ فَذَا حَسِيبُ",7,"ب",1,0],["وقل غداً أنت من أهل اليمين إذا","صوب الخلائق شأماتٌ ويمنات",8,"ت",1,0],["وقل غدونا بعده في حمىً","من كل بشرى وصفا بلقع",9,"ع",1,0],["وقلّ غناء عن أخى الشوق والهوى","صحائف لا يشفى بهن غليل",10,"ل",1,0]]}