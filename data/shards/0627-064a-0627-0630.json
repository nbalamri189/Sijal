تقارب"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76013","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200710","المتقارب"],[3560,"","https://poetry.dctabudhabi.ae/diwan/poem/117157","المتقارب"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109970","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107541","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90925","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90810","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133169","المتقارب"],[4729,"أَرَاجِعٌ لي عَيشي الفَارِطُ","https://www.poetsgate.com/ViewPoem.aspx?id=109457",""],[4729,"أحاضرٌ وأُهيلُ المُنحنى غَيَبُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=109432",""],[585,"هو الصوت دوّى من فلسطين عالياً","https://www.poetsgate.com/ViewPoem.aspx?id=161906",""],[5277,"البيت العتيق","https://www.poetsgate.com/ViewPoem.aspx?id=185450",""],[5277,"أرجوزة منفية","https://www.poetsgate.com/ViewPoem.aspx?id=191072",""],[6018,"أياذا الفضائل واللام حاء","https://www.poetsgate.com/ViewPoem.aspx?id=181192",""],[6177,"رَجْعُ الغِياَب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79067&r=&rc=14",""]],"verses":[["أَيَأذَنُ لي المَليكُ البَرُّ أَنّي","أُهَنِّئُ مِصرَ بِالأَمرِ الكَريمِ",0,"م",1,0],["أَيا ذا اليَمينَينِ وَالدَعوَتَينِ","وَمَن عِندَهُ العُرفُ وَالنائِلُ",1,"ل",1,1],["أَياذا الَّذي أَلقَتهُ في الغَيِّ نَفسُهُ","وَمَن غَرَّهُ مِنها عَساها وَلَيتُها",2,"ت",3,0],["أَيا ذِكرَ مَن تَحتَ الثَرى مِن أَحِبَّتي","وَصَلتُ بِهِم عَهدي عَلى بُعدِ مُلتَقى",3,"ق",2,0],["أَيا ذَوي الوَخامَة","أَكثَرتُمُ المَلامَة",4,"م",2,1],["أَيا ذا الفَخرِ وَمَلكَ العَصرِ","وَسامي القَدرِ عَلى النِسرَينِ",5,"ن",1,1],["أَيا ذاتَ اللَمى رِفقاً بِصَبٍّ","يُراعي ذِمَّةَ العَهدِ القَديمِ",6,"م",1,0],["أَيا ذَا اليَمَنَينِ والدَّعوَتَين","ومنْ عندهُ العرفُ والنائلُ !",7,"ل",1,1],["أيا ذات الفم الذهَبيِّ..","رُشِّي الليل.. موسيقا",8,"ق",2,0],["أيا ذا الفضل والمنن","وربِّ السرِّ والعلنِ",9,"ن",1,1],["أيا ذا الذي في كفّه مرهف الشبا","يصيب به عمدا مكان المقاتل",10,"ل",1,1],["أيا ذاتَ المكارمِ والمعالي","تكسَّرتِ الصوارمُ والعوالي",11,"ل",2,1],["أيا ذا الْمَكارِمِ لا رُوِّعَتْ","بِفَقْدِكَ ما هَدْهَدَ الصّادِحُ",12,"ح",1,0],["أيْ إذا صُمْتَها فقد صُمْتَ عاماً","كاملَ النُّسك بينَ ماضٍ وجاء",13,"ا",2,0],["أَيَأْذَنُ سَمْعُكَ لِي من بَعيدٍ","ولحظُكَ قَدْ رابَنِي من قريبِ",14,"ب",1,0],["أيا ذكريات الأمس ترقصن في الرؤى","تعالي إلى حضن الجمال تعالي",15,"ل",2,1],["أَيا ذا الحَزمِ وَالعَزمِ المَكينِ","وَذا التَدبيرِ وَالرَأيِ الرَصينِ",16,"ن",1,1],["أيا ذاهلاً ونداءُ الحتو","فِ في النّاسِ يوقظ مَن يذهَلُ",17,"ل",1,0],["أَيا ذاهباً ولّى وخلّفَ بعدَه","عَليَّ مِنَ الأحزانِ مِلْءَ جَوانبي",18,"ب",2,0],["أَيا ذاهِباً بُقّيتُ لِلحزنِ بعدَهُ","أَلا إِنَّني حزناً عَليك كَذاهبِ",19,"ب",1,0],["أيا ذا الندى مُرْهُ بما شئتَ إنهُ","غمام الردى إن سُمته للعِدا همى",20,"م",2,0],["أيا ذا الذي قد كفَّ كفيهِ عامداً","عن الجودِ خوفَ الفقرِ ما ذاكَ سائغُ",21,"غ",1,1],["أَيا ذا الجودِ فَاِسلَم ما","جَرَت حُقبٌ إِلى حُقبِ",22,"ب",1,0],["أي إذن على جفوف لطيف","طارق والكرى شديد الحجابِ",23,"ب",1,0],["أيا ذاهباً قد مضى فقدُهُ","حلاوةُ ذِكراكَ ما تَذهبُ",24,"ب",1,1],["أَيا ذَهبيَّ اللَونِ روحيَ ذاهِبٌ","فرِفقا بِهيمانٍ عَلى المَوتِ قَد أَشفى",25,"ف",2,0],["أيا ذكرياتي هل أنت وهم","أمَ اَنك حقٌّ ولا تعلمين",26,"ن",1,1],["أيا ذا اليمينَينِ إنّ العتا","بَ يشفي صدوراً ويغري صدورا",27,"ر",2,1],["أيا ذخرنا المأمونَ في هَولِ مَوقِفٍ","بهِ ما لنا عن قُجِ سيئةٍ عُذرُ",28,"ر",1,0],["إياذك والثقيلا","ولا تكن تقيلا",29,"ل",2,0],["أيا ذاتَ النقاء وددتُ أني","حفظتكِ بينَ أجنحةِ البزاةِ",30,"ه",1,0],["أياذرية الصديق حسبي","رضاكم فهو كنز ليس ينفد",31,"د",1,0],["أيا ذرية الزهراء يا آ","ل بيت محمد يا خير آل",32,"ل",1,0],["أيا ذا المعادي فنحن حتوفك","توقع هلاكك وقرب المنون",33,"ن",1,0],["أيا ذَوي الودّ أمَا اشتقتُم","إلى أمامٍ جَأشُه رابِطُ",34,"ط",1,0],["أُيَا ذُوابةَ الحيّ هل وَطرٌ","نَجرانُ منتزحٌ والمُنحَنى كثبُ",35,"ب",1,0],["أيأذن كرسس الرئاسة أنه","يراك وكيلاً لليهود وداعيا",36,"ي",2,0],["أيا ذكرى الشباب ِ إليك ِ عنّي","فلون الشيبِ عصفرُه العشيقُ",37,"ق",1,0],["أيا ذكرى الشباب إليك عنّي","مشيبُ اليوم أعياهُ الطريقُ",38,"ق",1,0],["أياذا الفضائل واللام حاء","وياذا المكارم والميم هاء",39,"ا",2,1],["أيا ذكرايَ يا محراب ذاتي","ويا نجوايَ في الزّمن البخيلِ",40,"ل",1,0]]}