{"poems":[[3,"نأتك رقاش إلا عن لمام","https://www.aldiwan.net/poem110.html",""],[79,"قل للأشوني ولا تحتشم","https://www.aldiwan.net/poem36657.html","السريع"],[73,"أشكو إلى الله حماتي فما","https://www.aldiwan.net/poem3921.html","السريع"],[91,"إني غير مختار وفارق مضطرا","https://www.aldiwan.net/poem45097.html","الطويل"],[30,"مكان ابنها إذ هاجني بعوائه","https://www.aldiwan.net/poem5247.html","الطويل"],[68,"عجبت لها تمسي العقول لها نهبا","https://www.aldiwan.net/poem39205.html","الطويل"],[54,"أبا طيب خبرت أنك بعدنا","https://www.aldiwan.net/poem26893.html","الطويل"],[54,"عجوز تصابى وهي بكر بزعمها","https://www.aldiwan.net/poem27173.html","الطويل"],[52,"وهبت لنا يا فتى منقر","https://www.aldiwan.net/poem62288.html","المتقارب"],[48,"أخوك معذب يا أم دفر","https://www.aldiwan.net/poem23560.html","الوافر"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30501","المتقارب"],[102,"أغنية من خشب","https://www.poetsgate.com/ViewPoem.aspx?id=50378",""],[190,"ثلاثة أشياء تضني الفؤاد","https://www.aldiwan.net/poem43608.html","المتقارب"],[264,"أنجد المتهم في غزلان طي","https://www.aldiwan.net/poem35802.html","الرمل"],[266,"لحا الله دنيانا التي مذ عهدتها","https://www.aldiwan.net/poem38258.html","الطويل"],[438,"تلين لعزمي بالعراء العوائك","https://www.aldiwan.net/poem12691.html","الطويل"],[463,"وأم يفوز بإعلانها","https://www.aldiwan.net/poem56174.html","المتقارب"],[558,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[580,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122647","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54083","المتقارب"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130156","السريع"],[1033,"","https://poetry.dctabudhabi.ae/diwan/poem/18186","المتقارب"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144076","الطويل"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87942","الطويل"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33869","الطويل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67263","الوافر"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84528","الطويل"],[3042,"","https://poetry.dctabudhabi.ae/diwan/poem/199484","الوافر"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110812","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62874","المنسرح"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66426","الطويل"],[3678,"","https://poetry.dctabudhabi.ae/diwan/poem/34818","السريع"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21544","الهزج"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21577","المتقارب"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73158","الوافر"],[4489,"","https://poetry.dctabudhabi.ae/diwan/poem/205345","الطويل"],[4529,"","https://poetry.dctabudhabi.ae/diwan/poem/105372","السريع"],[4578,"بعيني غزال ألبان هاروت ماكث","https://www.poetsgate.com/ViewPoem.aspx?id=49366",""],[4862,"عجوزٌ تحسن المكرا","https://www.poetsgate.com/ViewPoem.aspx?id=55620",""],[4862,"كفانا الله من شر الدواب","https://www.poetsgate.com/ViewPoem.aspx?id=55621",""],[4862,"عجوز في التلوي كالأفاعي","https://www.poetsgate.com/ViewPoem.aspx?id=55622",""],[4862,"عجوز النحس سيدة الضلالِ","https://www.poetsgate.com/ViewPoem.aspx?id=152395",""],[5277,"البائيةُ البغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=184967",""],[5431,"ونور من الرحمن يجلو وساوسي","https://www.poetsgate.com/ViewPoem.aspx?id=189700",""],[5956,"شعرتُ بأني غبارٌ عليك","https://www.poetsgate.com/ViewPoem.aspx?id=182531",""],[5957,"حكايات (المسنجر)","https://www.poetsgate.com/ViewPoem.aspx?id=46453",""]],"verses":[["عَجوزٌ مِن بَني حامِ بنِ نوحٍ","كَأَنَّ جَبينَها حَجَرُ المَقامِ",0,"م",1,0],["عَجوزِ يَنَّيْرٍ بِها تَجتَزي","تأتِيكَ للأرْياحِ في فَوْجِ",1,"ج",1,0],["عَجوزُ سوءٍ لَو رَأَت قودَةً","في النسرِ طارَت بِجَناحَي قَطاه",2,"ا",2,0],["عجوز أبت أن تسكن الدار إنها","رأت دارها من بعد واحدها قَفرا",3,"ر",2,0],["عَجوزٌ تُصَلّي الخَمسَ عاذَت بِغالِبٍ","فَلا وَالَّذي عاذَت بِهِ لا أُضيرُها",4,"ر",3,0],["عَجوزٌ إِذا ما أُبرِزَت مِن حِجابِها","تُريكَ نَشاطاً كَالغُلامِ إِذا شَبّا",5,"ب",2,0],["عَجوزٌ كَأَنَّ الشَيبَ تَحتَ قِناعِها","عَلى الرَأسِ وَالأَكتافِ قُطنٌ مُنَفَّشُ",6,"ش",1,0],["عَجوزٌ تَصابى وَهيَ بِكرٌ بِزَعمِها","وَمُذ أَلفِ عامٍ قَد وَجى خَدَّها الواجي",7,"ي",1,1],["عَجوزاً قَدَ اَورَدَها عُمرُها","وَأَسكَنَها الدَهرُ دارَ البِلى",8,"ل",2,0],["عَجوزُ خِيانَةٍ حَضَنَت وَليداً","فَلَدَّتهُ الكَريهَ وَشَرَّقَتهُ",9,"ت",2,0],["عجُوزٌ لَعمْرُ الصّبا فانِيهْ","لها في الحشَا صُورةُ الغانِيهْ",10,"ن",3,1],["عجوز تئنّ بعصر الجليد","وتلبس آخر ما يجتلب",11,"ب",1,0],["عجوزٌ تباكرني بالنقار","ويأتي الظلام فتستأنفُ",12,"ف",1,0],["عج وعرّج حاديَ الأظعان من","حيِّ سلمى بل وعنّي الحيَّ حي",13,"ي",1,0],["عجوز إذا ساءت تسوء حقيقة","بنيها وان سرت تسر مجازا",14,"ز",2,0],["عجوزٌ عليها سَبحةٌ من حَبابها","تُصلّي على قوم بها وتُباركُ",15,"ك",1,0],["عجوزٌ ولودٌ تَعُدُّ البعولَ","كثيراً وكلٌّ أبو عُذرِها",16,"ر",3,0],["عَجولٌ إِلى ما يودِعُ الحَمدَ مالَهُ","يَعُدُّ النَدى غُنماً إِذا اِغتُنِمَ البُخلُ",17,"ل",1,0],["عَجُّوا وعَاجُوا عَنْ طَريقِ الرَّدى","فما خَلَوْا مِنْ خَورٍ أَو خُوَار",18,"ر",1,0],["عَجُوزٍ تُحَلَّى بالصِّبا كسرَويَّةٍ","مُؤرَّخَةِ الميلادِ مِن زَمَنِ الفُرس",19,"س",1,0],["عجوزٌ لهَا حَسَبٌ حِرْصُها","على طلب الشرّ ما أكثرَهْ",20,"ه",1,1],["عجوزة حدباء أبناؤها","ببابي الحدباء تبدى ابتسام",21,"م",1,0],["عَجوزُ الضَفادِعِ قَد حَدُرَت","تُطيفُ بِها وِلدَةُ الحاضِرِ",22,"ر",1,0],["عجوزٌ لها في الزّنجِ أصلٌ ومحتِدٌ","ولكنّما أولادُها الرّومُ والقِبطُ",23,"ط",1,0],["عجوزٌ يرى الآمال آلاً وعمرُهُ","مضى قبل ان يقضيَ شاواً يؤمِّل",24,"ل",1,0],["عَجوزٌ لَنا قَد طالَ بِالنَيكِ عَهدُها","لَها أَشهُرٌ مُذ فاتَها وَلَيالِ",25,"ل",1,0],["عجولٌ عند بذلِ المال لكن","صبورٌ عند مختلفِ السهام",26,"م",1,0],["عجول الى أَن يعطى السيف حقه","ونىّ عن الفحشآء عفّ الطبائع",27,"ع",1,0],["عَجوز لَوْ دَنا منها يَمانٍ","لَلاقَى مثل ما لاقى يَسارُ",28,"ر",1,0],["عجوز جف ملمسها","فلا ماء ولا مرعى",29,"ع",2,1],["عَجُّوا الى اللهِ يسأَلونَ لكَ ال","عمرَ وطولَ البقاءِ والخُلَدِ",30,"د",1,0],["عجوز غدت شمطاء وجهٍ لناظر","قد ابيضّ فيما بين أوراقها الحبرُ",31,"ر",1,0],["عَجوزاً أَضَرَّ بِها دَهرُها","وَأَنزَلَها الذُلُّ دارَ البِلى",32,"ل",2,0],["عَجوز نَسَج الماءُ","لَها طَوقاً مِنَ الشَذرِ",33,"ر",1,0],["عَجوز غذا المِسكُ أصداغها","مُضمَّخة الجلدِ بالزعفَرانِ",34,"ن",1,0],["عَجوزٌ قد أسنَّت وهيَ بِكرٌ","ومن عَجبٍ عجوزٌ وهي بكرُ",35,"ر",1,0],["عجوم لهام الدارعين كأنه","شهاب غضى من ملهب متوقد",36,"د",1,0],["عجوزة الشيخ تعيد الصبا","وتبعث الموتى سواقيها",37,"ي",3,1],["عجولٌ بقتل العاشقين إذا رنا","وهيهات لحظ ينفث السحر رائثُ",38,"ث",1,0],["عجوزٌ تحسن المكرا","وتطعن في الحشا غدراً",39,"ر",2,1],["عجوز النحس فاجرة","تحب العشق والسهرا",39,"ر",2,0],["عجوزٌ ما رأت عيني","عجوزاً مثلها فجرا",39,"ر",2,0],["عجوز لا تمل من التصابي","هوايتها مغازلة الشباب",40,"ب",1,1],["عجوز في التلوي كالأفاعي","تحوم على الفريسة كالعقاب",41,"ب",1,1],["عجوز النحس سيدة الضلالِ","أتتني اليوم تنهق كالبغالِ",42,"ل",1,1],["عجوزٌ لاتملّ من التصابي","هوايتها مشاكسة الرجالِ",42,"ل",1,0],["عَجّوا وَثَجّوا والطواف بلندنٍ","صفرُ الوجوه ِ بِحَضرَة ِ العَرّابِ",43,"ب",1,0],["عجولٌ غدوا أرباب جاه وثروة","وماالعرْب إلا بيدقٌ للتنافسِ",44,"س",1,0],["عجوزٌ وأشمطُ مهما لديّ","نشاطٌ ومجدٌ وشوقٌ ودفْءُ",45,"ا",1,0],["عجوزٌ غابرٌ يصطادُ قلباً","بريئاً ناعمِ النبضات أخضرْ",46,"ر",1,0]]}