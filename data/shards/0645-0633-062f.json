{"poems":[[88,"مسدي الجميل بلا من يكدره","https://www.aldiwan.net/poem10374.html","البسيط"],[56,"مسدد الرأي إن تلحظ مكايده","https://www.aldiwan.net/poem27488.html","البسيط"],[74,"رأى الغصن أعطاف الغزال المقرطق","https://www.aldiwan.net/poem19355.html","الطويل"],[74,"خليلي من مصر قفا نبك في السبك","https://www.aldiwan.net/poem19441.html","الطويل"],[74,"يدافعني الغيران عن طيب لثمها","https://www.aldiwan.net/poem19677.html","الطويل"],[53,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[53,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[63,"هويتها والفراق يهواها","https://www.aldiwan.net/poem51406.html","المنسرح"],[71,"مولاي يا ذا المنظر الزاهر","https://www.aldiwan.net/poem29218.html","السريع"],[107,"أئن تولت جنود الشرك مدبرة","https://www.aldiwan.net/poem44211.html","البسيط"],[77,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42603","البسيط"],[246,"سار يباري النجم في جده","https://www.aldiwan.net/poem45763.html","الطويل"],[302,"أربة الخدر ذات الريط والخمر","https://www.aldiwan.net/poem33274.html","البسيط"],[310,"أحيا قدومك مرعى الجود والجود","https://www.aldiwan.net/poem56574.html","البسيط"],[443,"الله أكبر هذا مربع الجود","https://www.aldiwan.net/poem2539.html","البسيط"],[463,"هبت ومنها الخلاب والخدع","https://www.aldiwan.net/poem56139.html","المنسرح"],[466,"من مبلغ سلف الأجواد إذ سبقوا","https://www.aldiwan.net/poem16058.html","البسيط"],[543,"يا حسرتي يا حسرتي","https://www.aldiwan.net/poem48262.html","عموديه"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34430","البسيط"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146221","المجتث"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62560","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62508","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62586","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62450","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119989","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120058","المجتث"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112788","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112861","الوافر"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95579","المجتث"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128716","الطويل"],[1611,"","https://poetry.dctabudhabi.ae/diwan/poem/106718","البسيط"],[1706,"","https://poetry.dctabudhabi.ae/diwan/poem/198798","البسيط"],[2053,"","https://poetry.dctabudhabi.ae/diwan/poem/132441","الرجز"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88666","البسيط"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100885","الوافر"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137408",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132583","البسيط"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61257","البسيط"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125927","السريع"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4578,"لولد لي الأنس بعيش رغيدْ","https://www.poetsgate.com/ViewPoem.aspx?id=49399",""],[4578,"ريم النقا بالله غني سلاه","https://www.poetsgate.com/ViewPoem.aspx?id=49603",""],[4578,"مصر الغرام فؤادي في هوى الغيد","https://www.poetsgate.com/ViewPoem.aspx?id=49405",""],[585,"خذوا بيدي فالدهر جاشت غواربه","https://www.poetsgate.com/ViewPoem.aspx?id=161927",""],[585,"هنا المجال يهز الشعر والأدبا","https://www.poetsgate.com/ViewPoem.aspx?id=161896",""]],"verses":[["مُسدي الجَميلِ بِلا مَنٍّ يُكَدِّرُهُ","وَمُكرِمُ الضَيفِ أَمسى ضَيفَ رِضوانِ",0,"ن",1,1],["مُسَدَّدُ الرَأيِ إِن تَلحَظ مَكايِدَهُ","مَكايِدُ الدَهرِ لَم تَثبُت لَها قَدَمُ",1,"م",1,1],["مسدّد نبل المقلتين كأنما","يخيّر أرواح الكماة وينتقي",2,"ق",2,0],["مسدَّدة الأفعال والبأس والندى","مثقفة الآراء في الأخذِ والترك",3,"ك",1,0],["مسدَّدة المرمى مقسَّمة الحيا","فلا زالَ للإسلام وافر سهمها",4,"م",3,0],["مُسدَّدٌ في جواباتٍ يُجيبُ بها","كأنها أبداً مأخوذةُ الأُهَبِ",5,"ب",1,0],["مَسَدَتْ حَبْلَنا يداه جزى الخيْ","رُ يَدَيْهِ عن حَبْلِنا المَمْسُودِ",6,"د",1,0],["مُسَدَّدٌ تاهتِ الإمارةُ مُذ","نِيطَ به عِبئُها ومَا تَاها",7,"ا",3,0],["مسدَّد الأحكامِ حتى غدا","حكمُكَ مثلَ المثلِ السائر",8,"ر",1,0],["مُسدّدُ الرأي ما تهفو الظنونُ به","الخيرُ ما اختارَ والمكروهُ ما اجتنبا",9,"ب",2,0],["مسدولَ سِترِ جَلالَةٍ أنْطَقْتَهُ","فرفعْتَ عن حِكَمِ البيانِ سُدُولا",10,"ل",2,0],["مُسَدَّدُ الرَأْيِ مَوْقُوفُ الظُّنُونِ عَلَى","رَعْيِ السِّيَاسَةِ فِي ثَبْتٍ وَتَحْوِيرِ",11,"ر",1,0],["مسدد العزمِ إذا مامضى","يحارُ صَرفُ الدهر في رَدِّه",12,"د",2,0],["مُسدَّدِ الرأي لم يعبأ بحادثَةٍ","وَلَم تخنه يدُ الأَيّام وَالغيَرِ",13,"ر",1,0],["مُسدّد السهمِ ماضي العزمِ متّشحاً","بِالحزمِ متّزراً بالبأس والجودِ",14,"د",1,0],["مسدّد الراي في الأحوال يكلأها","مشرّع السمع للداعي إذا نودي",15,"د",2,0],["مسدّد النطق مستريبٌ بما","قال من الحق آمنٌ فزِعُ",16,"ع",1,0],["مسدِّدُ الطعن حيث السُّمر حائدةٌ","وصائبُ القول حيث الرأي مُرتجن",17,"ن",1,0],["مَسدولةٌ عليها","مثلُ انسِدالِ السُّترَة",18,"ه",1,0],["مسدَّدُ الرأي حَجّاجُ الخصوم غَدا","في سَعيه خير حجّاج ومعتمرِ",19,"ر",1,0],["مُسَدَّدٌ صدرَ رمحٍ","فيه سنانٌ رصيد",20,"د",1,0],["مسدداً مؤهلا","في ظل عيش عاطر",21,"ر",1,0],["مسَدَّد الأمر ميمونٌ جَوانبهُ","كثير نفع الورى كالغيث في البلدِ",22,"د",1,0],["مُسدَّد السَّهم منصور اللواء مُبا","رك القَنَاء مُعِزّ التاجِ مصْلاتُ",23,"ت",1,0],["مُسدّدُ السعي مليءُ الثنا","مستحسَن الطلعة والمذهبِ",24,"ب",1,0],["مسدي العوارف ليس يتبعها","مطلا يكدِّرها ولا منَّا",25,"ن",2,0],["مسدد الرأي والعز","م محصد التدبيرِ",26,"ر",1,0],["مسددون إذا اعوج القنا ورأوا","رأيَ التطاعين لا عزل ولا ميل",27,"ل",1,0],["مسدد أصحاب المعارف رائد","وقائد أهل الاعتنا لوصالكم",28,"م",1,0],["مسددنا مبلغ كل خير","ومرشد جمعنا بمبين رشدك",29,"ك",1,0],["مسدّدا لفؤاد","زكا وما فيه مطعن",30,"ن",1,0],["مسدّد رأي في المغازي مجاهد","وكم سيرة عنه رواها مقاتل",31,"ل",1,0],["مُسَدَّدَ الرَأيِ مَنصورُ اللِوا أَسَدٌ","شاكي السِلاحِ حَليفُ اليُمنِ مَجدودُ",32,"د",1,0],["مسدّد الرأي لماح الحِجا خبِراً","ومشرق النفس إيمانا وإسلاما",33,"م",2,0],["مسدداً إلى ذراه عُرفه","بكفّه لا برئت من عرفه",34,"ه",1,0],["مسدد الرأي عن تَدقيق","وآية اللَه بالتَحقيق",35,"ق",1,0],["مسددٌ بعدل في الأحكامِ","ويبذل الإحسان للأنامِ",36,"م",1,0],["مسدَّدة السهامِ فلو أصابت","بعينيها غرابَ البين شَابا",37,"ب",2,0],["مسدد الرأى عند المشكلات فلا","تلقى عن العدل في أحكامه عوجا",38,"ج",2,0],["مسدّد الرمي افتديه","بمهجتي رامياً مسدّد",39,"د",1,0],["مسدّدُ الرَأي مَيمونُ النَقيبة مَن","صورُ العَزيمةِ عالي الجَدِّ مقتبلِ",40,"ل",1,0],["مسدد النظرة في قومه","مشهم المفرق عارى الجسد",41,"د",1,0],["مُسدداً نباله لِنُبلَةٍ","ومُشرِعاً قناته إلى القنا",42,"ا",1,0],["مسدد الأمر بحدٍ له","بفتح ما أغلق رأيٌ سديد",43,"د",1,0],["مسدد الرأي بسهم الذكا","لم يخط أغراض المعالي حجاه",44,"ا",2,0],["مسدد الفكر في فتح الأمور ترى","أحكامهُ ذات أحكامٍ وتسديدِ",45,"د",1,0],["مسددة نحو القلوب سهامه","مجردةٌ فوق الرقاب قواضبه",46,"ب",2,0],["مسدد الرأي إن يبعثه منصلتاً","في المعضل اخترق الأستار والحجبا",47,"ب",2,0]]}