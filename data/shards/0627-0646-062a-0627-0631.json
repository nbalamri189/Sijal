{"poems":[[95,"يا ابنة العم إن ذاك الذي","https://www.aldiwan.net/poem11116.html","الخفيف"],[53,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[94,"قدس الله ذكره من صباح","https://www.aldiwan.net/poem38922.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54956","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/205801","الخفيف"],[108,"حفظ الله صالحًا","https://www.poetsgate.com/ViewPoem.aspx?id=179358",""],[102,"راهب الفن","https://www.poetsgate.com/ViewPoem.aspx?id=50160",""],[228,"هبة الحب يا شعاع رؤايا","https://www.aldiwan.net/poem39735.html","الخفيف"],[382,"أدعو بمريم في ضري فتنقذني","https://www.aldiwan.net/poem59151.html","البسيط"],[409,"بنت فكر وافت كشمس النهار","https://www.aldiwan.net/poem33921.html","الخفيف"],[445,"حسبي رضاك من الدهر الذي عتبا","https://www.aldiwan.net/poem34821.html","البسيط"],[580,"قمر بات بين سحري ونحري","https://www.aldiwan.net/poem3061.html","الخفيف"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145976","مجزوء الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62478","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125477","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76503","الرمل"],[4978,"أحمد الدقاسمة","https://www.poetsgate.com/ViewPoem.aspx?id=188844",""],[5351,"شكوى سعد","https://www.poetsgate.com/ViewPoem.aspx?id=202099",""],[470,"قالتْ محتجة: وأين كبريائي..؟","https://www.poetsgate.com/ViewPoem.aspx?id=178006",""],[5757,"برقيّةٌ إلى المتنبّي","https://www.poetsgate.com/ViewPoem.aspx?id=59801",""]],"verses":[["أَنْتَ أَرْقَى الشَّبَابِ خَلْقاً وَخُلْقاً","وَأَرَقُّ الأَتْرَابِ حِذْقاً وَفِطْنَهْ",0,"ن",2,0],["إن تأرَّى عليَّ عتبُك والصي","فُ وحاشايَ كان ذاك الجَلاءَ",1,"ا",2,0],["أَنتِ أُرْجوحَةُ النَّسيمِ فميلي","بالنَّسيمِ السَّعيدِ كلَّ مَمِيلِ",2,"ل",1,0],["أَنْتَ أَرْضَيْتَ بِالنُّهَى وَالمَسَاعِي","عُمْرَ الْمُجْتَبَى وَأَرْضَيْتَ عُسْرَا",3,"ر",2,0],["أنت أرضعتنا حليب التحدي","فطحنا النجوم بالأسنان",4,"ن",1,0],["إن تاريخ صالح صفحاتٌ","من كفاح، بل قصة، بل «درامه»",5,"م",2,0],["إنّ تاريخ عمره","قصّة الحبّ والألم",6,"م",1,0],["أَنتِ أَرض الميعادِ ما سَمح اللّ","هُ بِها أَو بِمِثلِها لِسِوايا",7,"ا",3,0],["أنت ارتقيت بترتيل الملائك بال","أزهار مزدانةً كي ترحضي الداء",8,"ا",2,0],["أنت أرضاً نشأت في سوحها الرح","ب لأرض الكرام والأحرار",9,"ر",1,0],["أَنتَ ارْتَجَعْتَ المنى غُرّاً مُحَجَّلَةً","نحوِي وَقَدْ أَعجَزَتْنِي دُهْمُها هَرَبا",10,"ب",2,0],["أَنتَ أَرْشَدتَني إِليكَ ولكن","كَ حيَّرت في مَديحِكَ فكْري",11,"ر",2,0],["أنتَ أرخصتَنا ثمناً","هَكذا يَرخصُ الثَمنُ",12,"ن",1,0],["أنت أرض وبتيمور","العُلا صارت سماءَ",13,"ا",2,0],["إن تاريخي المجيد","كان مِرآةَ العَجَب",14,"ب",1,0],["أَنتَ أُرسلتَ وَالخَلائق شَتّى","مَهملاتٌ وَكلُّهم غَوغاء",15,"ا",2,0],["انت ارسلت لنا من قبل ال","غرب مبعوثا لِتَعمير البلاد",16,"د",1,0],["أنت إرهاصُ ( دنا موعده )","نضّر الرحمن ذيّاك المُحَيّا",17,"ي",2,0],["أنت ارتجاف الصيف تضربهُ","بعصا الشتاء جراحهُ النشوى",18,"و",2,0],["أنتِ، أرفَعي هذا الجبين","فَكلُّ نُبلِكِ في حيَائِكْ!‍",19,"ك",1,0],["أنتَ ٱرْتِعاشُ الصُّبْح ِبعْدَ لقائِنا","والصُّبْحُ قبلَ لقائنا خنّاسُ",20,"س",1,0]]}