,""],[5455,"صمت المكان","https://www.poetsgate.com/ViewPoem.aspx?id=34700",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""],[5848,"ست الكل","https://www.poetsgate.com/ViewPoem.aspx?id=53093",""],[5956,"أقصوصة بغلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=204061",""],[6046,"أيها الخائفون...شكراً","https://www.poetsgate.com/ViewPoem.aspx?id=36245",""],[6102,"استِنزاف","https://www.poetsgate.com/ViewPoem.aspx?id=182845",""],[6102,"مِزَعُ الشَّرِّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=185056",""],[6189,"السيف والوردة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83560&r=&rc=27",""],[549,"سيرةٌ إنسانيَّةٌ للرِّمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87656&r=&rc=8",""]],"verses":[["كُلَّما خَفَّ إِلَيكُم حادِثٌ","غَلَّطَ النَهجَ وَلَم يُعطِ المَراما",0,"م",2,0],["كلما خالف الجماعة في الرأي","جريئ رموه بالالحاد",1,"د",1,0],["كلما خلَّى حبيبي يَدَهُ","لحظةً قلتُ وحُبِّي أبقِها",2,"ه",2,0],["كَلِّم أَخاكَ يُكَلِّمُ الفَضلا","وَلِيَبلُني حَسَناً كَما أَبلى",3,"ل",2,0],["كُلَّما خَطَّ أَبا جا","دٍ قَراهُ فَمَحاهُ",4,"ا",2,0],["كُلَّمَا خَلَّفَ يَوماً فَمَضَى","زادَهُ ذَلِكَ قُرباً لِلأَجَل",5,"ل",1,0],["كلما خافوا الملل","أنعشوه بالقبل يا حبيبي",6,"ي",1,0],["كلّما خَارَ أجزأتْ بسمةٌ مِنْه","فَمدَّ الخُطَا حَثِيثاً وجَدّا",7,"د",2,0],["كلما خلت أن نفسي استكانت","دهمتني بثورة في سكون",8,"ن",1,0],["كلَّما خوطبت على حبس قلبي","وقّعت للدموع بالإطلاقِ",9,"ق",1,0],["كلّما خامر السلوُّ فؤادي","دلَّهتهُ مفجوعةٌ ذاتُ فرع",10,"ع",1,0],["كُلَّما خِلتُ أَنَّني أَلحَقُ الوَر","دَ تَمَطَّت بِهِ سَبوحٌ ذَنوبُ",11,"ب",1,1],["كلّما خاضَ في دُجنّةِ نَقْعٍ","فلَقَ الفجرَ سيفُهُ فجَلاها",12,"ا",3,0],["كلما خيف أن تخف لهول","أثقلتها رزانة الكبرياء",13,"ا",2,0],["كُلَّما خاط َجرحَهُ فتَّقَ الجُْر","حَ بكفيِّهِ هازئَا ًثمَّ ماذا",14,"ذ",2,1],["كلَم أَخا دَعَةٍ تَعُد أخا ملكٍ","فيستوي منك قلبٌ غير منقسمِ",15,"م",1,0],["كُلَّما خلتُ أخلَق الدَهرُ هَجرا","قَدَّمته جاءَت بِهَجرٍ جَديدِ",16,"د",1,0],["كلما خضبت صدور العوالي","بدماهم تقول هل من مزيد",17,"د",1,0],["كلم اخا دعةٍ تعد اخا ملك","فيستوي منك قلبٍ غير منسقم",18,"م",1,0],["كلما خاطبتها قال الصدى","يا ليالينا بطيب الوصل عودي",19,"د",2,0],["كلما خر ساجداً لك رأس","منهمُ قال سيفك الله أكبرْ",20,"ر",1,0],["كلما خالسته نظري","رد جفنيه على حور",21,"ر",1,1],["كلّما خفّ هائجٌ من أغانيْ","هِ تعايا فذاب طيّ الحناجر",22,"ر",1,0],["كُلُّ مَا خَرَّ مِنْ لِحَافِي تَشَكَّى","وَالْدِّثَارُ ابْتَلَى عَلَيْهِ الْرَّثَاءُ",23,"ا",2,0],["كلّما خيّل على المنشا بروق","يحسب ان الارض خضرا مصبحة",24,"ح",2,0],["كلما خارت العزيمة مِني","حثني منك طاهرُ الدعوات",25,"ت",1,0],["كلما خاطت الحروف ثيابا","لبستني وصرت بالثوب أحلى",26,"ل",2,1],["كل ماخلّت وراها غالي ٍ ريم الصبايا","حتى والله من غلاها .. رحت وأغليت المكان",27,"ن",1,0],["كل ما خيّم الظلام ومالت","سُدف الليل قمت فيه قياما",28,"م",2,0],["كل ما خاصمتني قلت قلبي مُصاب","وكل ما سامحتني قلت والله لا اتوب",29,"ب",1,0],["كل ما خِلته نُبْلَه","صارَ نشاباً ونَبلةْ",30,"ل",2,0],["كلَّما خِفْتُ، لاحَ في الذِّهْنِ منكُمْ","منظرُ الرعبِ قائلاً لي: «تجلَّدْ»",31,"د",1,0],["كُلَّما خِلتُ أَنَّنِي بَعدَ يَأسِي","أَجِدُ الحُبَّ خانَنِي الإِنصافُ",32,"ف",1,0],["كُلَّما خِلتَ أَنَّها عَنْ خَلايا","كَ أَشاحَتْ ؛ تَوَغَّلَتْ فِي الخَلايا",33,"ا",3,0],["كلما خالها \" الدجى \" لفَّ شيئاً","فوق عِرْنينه وأنَّ وأغضى",34,"ض",2,0],["كلَّما خانَتْ بهِ خارطةٌ","تقرضُ الأوطانَ، عاوَدْنَا ابتكارَهْ",35,"ر",2,0]]}