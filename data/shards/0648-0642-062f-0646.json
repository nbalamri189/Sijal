,2,0],["وقد نُزِّهْتُ عن هَجْرٍ وهُجْرٍ","وإنْ أَبْدَى الخليلُ لِيَ اخْتِلالا",207,"ل",2,0],["وقد نطقَتْ بالفعلِ لي عرَصاتُه","لأني وجدتُ الأهل فيهنّ والرّحْبا",208,"ب",2,0],["وقد نَشَقَتْ رِياحَ النَّصْرِ تُزْجِي","غمامَ الموتِ أبْرَقَ فاْستَهَلّا",209,"ل",2,0],["وَقَدْ نَهَدَا بأَيمَنِ طائِرَيْنِ","وَقَدْ طَلَعَا بأَسْعَدِ طالِعَيْنِ",210,"ن",1,0],["وَقَدْ نَفَقَتْ بي سُوقُ موتٍ يقودُها","سنا البارِقَاتِ الصُّمِّ والأَسَلِ الصُّمْعِ",211,"ع",1,0],["وَقَدْ نَبَذَ الأَنامَ بكلِّ أرضٍ","إِلَيْكَ إِلَيْكَ يَا خَيْرَ الأَنامِ",212,"م",1,0],["وقد نشرت فيه الحوادث أضمساً","وليس له إلا يد الموت تلقط",213,"ط",1,0],["وقد نصحتك يا بر الفؤاد وكم","من ناصح كان أَولى منك لو نُصحا",214,"ح",2,0],["وقد نفض الأكفان بيضا تبعثرت","وبدل منها حالمات ضياء",215,"ا",2,0],["وقد نضونا العمرَ في رجائها","ننتظرُ الإقبالَ في إقبالها",216,"ل",3,0],["وقد نام الرُّعاة وغادروها","على جِرّاتها نهباً مشاعا",217,"ع",2,0],["وقد نُسخ العطاءُ فصار منعاً","وعاد الوصلُ صدّاً وانقطاعا",217,"ع",2,0],["وقد نام عنه الدافعون وكُشِّفتْ","خَباياه للأبصارِ وهي عَوارُ",218,"ر",1,0],["وقْدُنا إليه تحت كل عجاجة","شوازِبَ يعلكن الشَّكائم ضُمَّرا",219,"ر",2,0],["وقد نقع البأس أعطافه","وكاد يموت بداء الصدا",220,"د",2,0],["وقد نهبت صبري ضعافاً جفونهُ","وناهيك أن يقوى الكسير على النهب",221,"ب",1,0],["وقد نام عن حاجاتنا نومَ سيفهِ","إذا قابل الأعداءَ يوم نزاله",222,"ل",2,0],["وقد نظمت في سلك جسمي مدامعي","فما بالها صدَّت عن العقد ذي النظمِ",223,"م",1,0],["وقد نظمتْ في سلك جسمي مدامعي","فلمْ زهدت في السلك وهو نظيم",224,"م",1,0],["وَقَد نَهَيناكَ عَنهُ","فَلَم تُطِع مَن نَهاكا",225,"ك",2,0],["وَقد نَهاني العَذولُ عَنهُ كَما","عَلَقتُ مِنهُ بِحَبلِ خِلَّتِهِ",226,"ت",2,0],["وقد نضا الشيبُ عن فَوْدي غياهِبَهُ","والوجدُ مازالَ عن قلبي ولا نَصَلا",227,"ل",2,0],["وقد نشرت أيدي الجنوب مطارفاً","على الجو دكناً والحواشي على الأرض",228,"ض",1,0],["وَقَدْ نَالَ فَوْقَ الّذِي تَبْتَغِي","مِنَ النّاسِ من لَيْسَ في النَّاسِ شَيّا",229,"ي",2,0],["وقَدْ نالَ أَرْحاماً لَكُمْ وَقَرابَةً","مِنَ الْفَقْرِ أوْصافٌ تَجِلُّ وتَعْظمُ",230,"م",1,0],["وقد نقِطت حاءُ الحَليلِ فأصبحَ ال","حليلُ خَليلاً والخَليلُ حَليلُ",231,"ل",1,0],["وقد نَفقَت سوقُ الفُجورِ وشُيِّدَت","مَعالِمُه واستَعذَبوا طَعمَه المُرَّا",232,"ر",2,0],["وقد نَكَّروها جُهْدَهمْ فعرفتَها","وقد طلعتْ من قبل حَطِّ لِثامها",233,"م",3,0],["وَقَد نابَكمْ ما نابَكمْ فتأمّلوا","أمرَّ لَكمْ مِثلٌ لها في النّوائبِ",234,"ب",1,0],["وقد نظمت عقود المدح مرتجياً","قبولها مستمداً جوهر الحكمِ",235,"م",1,0],["وقد نفوا ما عقلهم قاصر","عن فهمه من شرعنا الواسع",236,"ع",1,0],["وقد نهى السلف الماضون عنه وهم","لم ينتهو حيث لا يغزوهمو غازي",237,"ز",2,0],["وقد نادَى لِسانُ الحالِ فيها","بتأريخٍ لكمْ في الأرضِ جَنَّهْ",238,"ه",1,0],["وقد نزل النصر العزيز لذي السنا","وبالتب باء المعتدى المتطول",239,"ل",1,0],["وَقَدْ نَقَضَتْ عَهْدَ الصَّفَاءِ كَأَنَّهَا","أُنَاسٌ هَوَاهُمْ فِي عُهُودِهِمْ النَّقْضُ",240,"ض",1,0],["وقد نقضت أصل ما قد ادعوا","فيما مضى وكل ما قد انطووا",241,"و",3,0],["وقد نَقلَتْنِي عَن طِباعٍ كثيرةٍ","وقد قَلَبَت قَلْبي وقد خَلَبَت خَلْبي",242,"ب",2,0],["وقد نقضَتْ مِنِّي المآرِبُ كلُّها","ولكن لَها بالكاملِ الملكِ إِكْمَالُ",243,"ل",1,0],["وقد نَشَأَ الدِّينُ لما نَشَا","ووَلَّى به الكفرُ لمَّا وَلي",244,"ل",2,0],["وقد نادى مُؤَذِّنهم، فنادى","ليوثُ الغاب: حيَّ على الحروب",245,"ب",1,0],["وَقَدْ نَظَمْتُ صَدْرِي عِناقاً وصَدْرَهُ","عُقُودَ الرِّضَا حَتَّى تَناثَر عِقْدُهُ",246,"د",2,0],["وقد نظرت طوالعكم إلينا","بأعينهم وحققنا الظنونا",247,"ن",2,0],["وقد نيل شطر الليل حتى تغضنت","مشافره كالقنفذ المتحارب",248,"ب",1,0],["وَقَد نُقَدِّمُ في الهَيجاءِ إِذ لَقِحَت","يَومَ الحِفاظِ وَنَحمي كُلَّ مَكروبِ",249,"ب",1,0],["وَقَد نالَ حَدُّ السَيفِ مِن حُرِّ وَجهِهِ","إِلى حَيثُ ساوى أَنفَهُ المُتَنَقَّبُ",250,"ب",1,0],["وَقَد نِلنا لِعَبدِ القَيسِ سَبياً","مِنَ البَحرَينِ يُقتَسَمُ اِقتِساما",251,"م",2,0],["وَقَد نالَ آفاقَ السَماواتِ مَجدُنا","لَنا الصَحوُ مِن آفاقِها وَغُيومُها",252,"ه",2,0],["وَقَد نَزلت بهراءُ خلف بيوتنا","كَما نَزَلت تَبغي قرانا الأساورُ",253,"ر",1,0]]}