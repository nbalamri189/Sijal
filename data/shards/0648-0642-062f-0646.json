],[464,"بني عمنا كفوا العضيهة أنها","https://www.aldiwan.net/poem15099.html","الطويل"],[467,"لواه القضاء بفرط السلام","https://www.aldiwan.net/poem3116.html","عموديه"],[467,"سرت بدر تم في سحاب من النقب","https://www.aldiwan.net/poem3292.html","عموديه"],[467,"وقفنا بباب المنقذي عشية","https://www.aldiwan.net/poem3299.html","عموديه"],[467,"ألم تحتلف أن لا تعود إلى ظلم","https://www.aldiwan.net/poem3450.html","عموديه"],[467,"حديث غرامي في هواك قديم","https://www.aldiwan.net/poem3516.html","عموديه"],[471,"اسمع جعلنا فداكا","https://www.aldiwan.net/poem59784.html","المجتث"],[471,"أذاق قلبي أسى بهجرته","https://www.aldiwan.net/poem60360.html","المنسرح"],[480,"لما استحث حداة الجيرة الابلا","https://www.aldiwan.net/poem15257.html","البسيط"],[520,"وساق صبيح للصبوح دعوته","https://www.aldiwan.net/poem60552.html","الطويل"],[532,"لك الويل لا فاجر تتقى","https://www.aldiwan.net/poem37075.html","المتقارب"],[532,"نداء لكل الناس فالأمر أعظم","https://www.aldiwan.net/poem37210.html","الطويل"],[541,"إلى العالم الفرد الذي عز نده","https://www.aldiwan.net/poem47983.html","عموديه"],[541,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[554,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"],[554,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[561,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[561,"نحن ضياء الغارب الطالع","https://www.aldiwan.net/poem34396.html","السريع"],[561,"من أين للسعد ما ندري وللرازي","https://www.aldiwan.net/poem34456.html","البسيط"],[565,"هلموا للنزاهة نحو دار","https://www.aldiwan.net/poem52641.html","الوافر"],[567,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[570,"تعطف علينا أيها الغصن الغض","https://www.aldiwan.net/poem69619.html","الطويل"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"أيا شمسي منك أشرق بهجة","https://www.aldiwan.net/poem2994.html","الطويل"],[578,"على خاطري يا شغله منك أشغال","https://www.aldiwan.net/poem3029.html","الطويل"],[578,"هواي لمحبوبي الأول","https://www.aldiwan.net/poem3036.html","المتقارب"],[588,"سرى ما بيننا سر الغيوب","https://www.aldiwan.net/poem1565.html",""],[589,"تداركه قبل البين فاليوم عهده","https://www.aldiwan.net/poem17487.html","الطويل"],[644,"","https://poetry.dctabudhabi.ae/diwan/poem/104194","الوافر"],[755,"","https://poetry.dctabudhabi.ae/diwan/poem/121898","الطويل"],[940,"","https://poetry.dctabudhabi.ae/diwan/poem/9621","البسيط"],[940,"","https://poetry.dctabudhabi.ae/diwan/poem/9617","الطويل"],[1081,"","https://poetry.dctabudhabi.ae/diwan/poem/2565","الوافر"],[1081,"","https://poetry.dctabudhabi.ae/diwan/poem/2576","الطويل"],[1186,"","https://poetry.dctabudhabi.ae/diwan/poem/97832","الطويل"]],"verses":[["وَقَد نَصَلَ الدُجى عَن صَدرِ يَومٍ","مِنَ الخِرصانِ مَخضوبِ البَنانِ",0,"ن",1,0],["وَقَد نَمنَمَ الوَسميُّ بَيني وَبَينَهُ","وَوالى بِمُغبَرِّ الرَبابِ هَطولِ",1,"ل",1,0],["وَقَد نَشَأَت سَحابٌ مِن عَجاجٍ","تَعُطُّ صُدورَها أَيدي الجِيادِ",2,"د",1,0],["وَقَد نَصَلَت أَنضاؤُنا مِن ظَلَمِها","نَصُلُ بَنانِ الخَودِ تَنضو خَضابَها",3,"ب",3,0],["وَقَد نَمَّ دَمعٌ بَينَ جَفنَيَّ ظاهِرٌ","إِلَيهِم بِوَجدٍ بَينَ جَنَبيَّ باطِنِ",4,"ن",1,0],["وَقَد نَزَفَ الوَجدُ المُبَرِّحُ أَدمُعي","فَهَل عَبرَةٌ يا صاحِبَيَّ أُعارُها",5,"ر",3,0],["وَقَد نارَ الرَّبيعُ بِهِ وَأَسدَى","كَما نَشَرَت غَلائِلَها الهَديُّ",6,"ي",1,0],["وَقَدْ نَصَلَتْ مِنْ حَواشِي الدُّجَى","تَمايَلُ أَعْناقُها مِنْ نَصَبْ",7,"ب",1,0],["وقدْ نَعَشَتْهُ ثَروَةٌ غيرَ أنّهُ","أعَدَّ بِها للذّمِّ عِرْضاً مُمَشَّغا",8,"غ",2,0],["وقد نَفعَتْني وَقْفَةٌ في ظِلالِه","فلَمْ أُرْعِهِمْ سَمْعي ولا ضَرَّ ما قالوا",9,"ل",3,0],["وقد نَبَذَتْ عَيني إِلى الناسِ نَظْرَةً","كما يَتّقي الظَّبْيُ المُرَوَّعُ رامِيا",10,"ي",2,0],["وَقَد نَذَرَت إِن سَلَّم اللَهُ نَفسَها","وَنَفسي لَها شَهراً تَصومُ وَتُعِتِقُ",11,"ق",1,0],["وَقَد نَشَأَت في القَلبِ مِنكُم مَوَدَّةٌ","كَما نَشَأَت في الراحَتَينِ الأَصابِعُ",12,"ع",1,0],["وَقَدْ نِمْتُ عَنْ أَمري وَنبَّهْتُ هِمَّة","تُحَدِّقُ مِنْ عُلْو إِلَى صَرْحِ هَامَانِ",13,"ن",1,0],["وَقَد نَزَلَ المِقدارُ بِالأَمرِ صادِعاً","فَضاقَت عَلى شَيخِ المُلوكِ مَذاهِبُه",14,"ب",2,0],["وَقَد نالَ المَرامَ وَطابَ نَفساً","فَها هُوَ ذا بِلابِسِهِ يُدِلُّ",15,"ل",1,0],["وَقَد نَكونُ وَما يُخشى تَفَرُّقُنا","فَاليَومَ نَحنُ وَما يُرجى تَلاقينا",16,"ن",2,0],["وَقُدنا مِنهُم سَرَواتِ قَومٍ","كَجُربِ الإِبلِ تُطلى بِالهِناءِ",17,"ا",2,0],["وقد نظمت فيه السّعود ميامناً","كما يُنظمُ العِقدُ النفيسُ ويُرصَفُ",18,"ف",1,0],["وقد نثر الضياء بها نثاراً","يحاكي الوَشي في طرر الرياش",19,"ش",1,0],["وَقَد نَخَسوا الفَرَزدَقَ حينَ أَجرَوا","لِيُعتِبَهُم فَأَعتَبَ بِالحِرانِ",20,"ن",1,0],["وَقُدنا كُلَّ أَجرَدَ أَعوَجِيٍّ","تُعارِضُهُ عُذافِرَةٌ وَرودُ",21,"د",1,0],["وَقَد نُخِسَ الفَرَزدَقُ بَعدَ جَهدٍ","فَأَلقى القَوسَ إِذ سَإِمَ النِضالا",22,"ل",2,0],["وَقَد نالَ الأَخيطِلُ مِن هِجائي","دَحولَ السَبرِ غائِرَةَ الهُزومِ",23,"م",1,0],["وَقَد نَسَبَ النُسّابُ قَبلَكَ طَيِّئاً","إِلى ذِروَةٍ مِن مَذحِجٍ وَصَميمِ",24,"م",1,0],["وَقَد نَظَمَت عَلى خَدّي سُموطاً","مِنَ الدُرِّ المُفَصَّلِ بِالعَقيقِ",25,"ق",1,0],["وَقَد نالَت بَنو النَجّارِ مِنكُم","أُمَيَّةَ إِذ يَغَوِّثُ يا عَقيلُ",26,"ل",1,0],["وقد نفرت حتى عن الشعر صبوتي","ولولا الثنا التَّاجيّ ما كنت أشعر",27,"ر",1,0],["وقد نرى الأرواح تُهدي لنا","نشراً من الأَطْيبِ فالأطيبِ",28,"ب",1,0],["وقد نُصبتْ لها شُرُعٌ أُقيمتْ","بهنّ صدورُهُنَّ عن النكوبِ",29,"ب",1,0],["وقد نال في الدنيا سناءً وصِيتةً","وقام مقاماً لم يَقُمْهُ مُزَلَّجُ",30,"ج",1,0],["وقد نلتُ من عرض العُثيميِّ ما كفى","فلا تكُ وخْشاً للتعرض للوخش",31,"ش",1,0],["وقد نشرتْ أيدي الجنوب مطارفاً","على الجوِّ دُكناً وهي خضرٌ على الأرضِ",32,"ض",1,0],["وقد نُوظرتَ في أشياء شتَّى","فلم تعرف فُساءك من عُطاسك",33,"ك",1,0],["وقد نبهتَها ورفعتَ منها","وشكّلَ قدرَها التشريفُ شكلك",34,"ك",1,0],["وقد نُحدَى كما تُحدَى المطايا","وقد نُرعَى كما تُرعَى البِهامُ",35,"م",1,0],["وقد نظرتُ بعينٍ غيرِ كاذبةٍ","فلم أجِدك على الأيام مُضطغنا",36,"ن",2,0],["وَقَد نَنزِلُ الثَغرَ المَخوفَ وَيُتَّقى","بِنا البَأسُ وَاليَومُ الأَغَرُّ المُحَجَّلُ",37,"ل",1,0],["وَقَد ناشَدَتهُ طَلَّةُ الشَيخِ بَعدَ ما","مَضَت حِقبَةٌ لا يَنثَني لِنِشادِ",38,"د",1,0],["وَقَد نُصِرتَ أَميرَ المُؤمِنينَ بِنا","لَمّا أَتاكَ بِبَطنِ الغوطَةِ الخَبَرُ",39,"ر",1,0],["وقد نبذوا جنابك حين أقوى","وقد لاذوا إلى أقوى جناب",40,"ب",1,0],["وَقَد نُزِحَ الغُوَيرُ فَلا غُوَيرٌ","وَنِهيا وَالبُيَيضَةُ وَالجِفارُ",41,"ر",1,0],["وَقَد نُسِيَ الحُسَينُ بِما يُسَمّى","رَدى الأَبطالِ أَو غَيثَ العِطاشِ",42,"ش",1,0],["وَقَد نَهَيتُ فُؤادي لَو يُطاوِعُني","عَن ذي دَلالٍ غَريبِ الحُسنِ مُفرَدِهِ",43,"د",2,0],["وَقَد نَقَضتَ مَرامي الجودِ حَيثُ نَحَت","مُثلى سَحائِبِكَ الغُرِّ المَباكيرِ",44,"ر",1,0],["وَقَد نافَسَتني عُصبَةٌ مِن مُقَصِّرٍ","وَمُنتَحِلٍ مالَم يَقُلهُ وَمُدَّعِ",45,"ع",1,0],["وَقَد نَسَبوهُ إِلى اِبنَةٍ","تُجاذِبُهُ صِترُهُ المُنهَتِك",46,"ك",1,0],["وَقَد نَبَّهَ النَوروزُ في غَلَسِ الدُجى","أَوائِلَ وَردٍ كُنَّ بِالأَمسِ نُوَّما",47,"م",2,0],["وَقَد نَهاني عَنِ الغَواني","ما أَخَذَ الشَيبُ مِن عُرامي",48,"م",2,0],["وَقَد نُسمِنُ الشَولَ العِجافَ وَنَبتَغي","بِها في المَعالي وَهيَ حُدبُ الغَوارِبِ",49,"ب",1,0],["وقد نشأت بين الكؤوس غمامة","من الند إلا أنها ليس تهطل",50,"ل",1,0],["وقد نُظِمَ المنثورُ فهو قلائِدٌ","علينا وعقدٌ مُذْهَبٌ وخِناقُ",51,"ق",1,0],["وقد نَجا البدرُ إذ طافَ الكُسوفُ به","وزالَ عن مُشتَهيهِ الخوفُ والحَذَرُ",52,"ر",1,0],["وقد نظَمَ العِلجُ أجسامَها","مع الجُدْرِ نَظْمَ صفوفِ اللِّقاءِ",53,"ا",2,0],["وَقَد نَشَرَ الرَبيعُ مُروطَ رَوضٍ","عَلى الشِعبَينِ مِن سَهلٍ وَحَزنِ",54,"ن",1,0],["وَقَد نَغُضُّ وَنُغضي عَن قَبائِحِهِ","وَلَم يَكُن عَجَزاً عَنهُ تَغاضينا",55,"ن",2,0],["وقد نضب الخيال وغاض طبعي","ومات على حياض اليأس زرعي",56,"ي",1,0],["وقد نهشتْهُ حيّاتُ العوالي","سلوا الليلَ السليمَ عن السليمِ",57,"م",1,0],["وَقَد نَحَرَتْ في كلِّ شَرقٍ ومغربٍ","عليها نُحورَ البيد في العزم أسْهُمُ",58,"م",1,0],["وقَد نَقَلَتْ صُنّاعُها مِن صِفاتِهِ","إِلَيها أَفانيناً فَأَحسنَتِ النقلا",59,"ل",2,0],["وقد نَشَرَتْ في جانبيه ليَ النّوى","قِفاراً طَواها بي طِمِرٌّ وَشملالُ",60,"ل",1,0],["وقد نَفَضَ الطلَّ عن منكبيه","بمثل انتفاضِ الطمرِّ العتيق",61,"ق",1,0],["وقد نُسيتُ وذكري لا خفاءَ به","والمِسكُ يُطْوَى ونشرٌ منه ينتشرُ",62,"ر",1,0],["وَقَد نَدَبَتكَ البيضُ والسمرُ في الوَغى","وعدّدَكَ التأييدُ والحَسَبُ العِدُّ",63,"د",1,0],["وقد نصلت للطعن مَحْنِيَّ صَعْدَةٍ","بشوكةِ عُنّابٍ قتيلٍ زبيبها",64,"ب",3,0],["وَقَد نالَ مِنّي الشَيبُ وَاِبيَضَّ مَفرِقي","وَغالَت سَوادي شُهبَةٌ في قَذالِيا",65,"ي",2,0],["وَقَد نُكِسَ الثَغرُ فَاِبعَث لَهُ","صُدورَ القَنا في اِبتِغاءِ الشِفاءِ",66,"ا",2,0],["وَقَد نَثَرَتهُم رَوعَةٌ ثُمَّ أَحدَقوا","بِهِ مِثلَما أَلَّفتَ عِقداً مُنَظَّما",67,"م",2,0],["وَقَد نَهَيتُ فُؤادي عَن تَطَلُّبِها","فَاِغتَشَّني وَأَتى ما شاءَ مُعتَمِدا",68,"د",2,0],["وَقَد نَسَمَت ريحُ النُعامى فَنَبَّهَت","عُيونَ النَدامى تَحتَ رَيحانَةِ الفَجرِ",69,"ر",1,0],["وَقَد نامَ مِنّي ظالِمٌ لِيَ ذاعِرٌ","فَيا هَبَّةَ السَيفِ الحُسامِ دَراكِ",70,"ك",1,0],["وَقَد نَثَرَت مِنها قِسِيّاً يَدُ السُرى","وَفَوَّقَ مِنّا فَوقَهَا المَجدُ أَسهُما",71,"م",2,0],["وَقَد نُطتُ آمالي بِأَبلَجَ واضِحٍ","يُجَشِّمُها أَمضى مِنَ السَيفِ عارِيا",72,"ي",2,0],["وَقَد نَدَبَت مِن حَيثُ لَم أَدرِ رُقعَةً","أُنَمِّقُ أَم دَمعاً أُرَقرِقُ جارِيا",73,"ي",2,0],["وَقَد نَظَرتُكُمُ إِعشاءَ صادِرَةٍ","لِلخَمسِ طالَ بِها حَبسي وَتَنساسي",74,"س",2,0],["وَقَد نَسيتُ شَرَرَ الكانونِ","كَأَنَّهُ نِثارُ يا سَمينِ",75,"ن",1,0],["وَقَد نَضِجَت ثِمارُ بَنا","نِ كَفَّيهِ مِنَ القُنوِ",76,"و",1,0],["وَقَد نَصَحوا مِن قَبلِ ذَلِكَ زَوجَها","فَقالَ لَهُم وَجهُ المُحَرِّشِ أَحرَشُ",77,"ش",1,0],["وَقد نالوا عَلَى الأُمم المَوَاضي","به شَرَفاً فكلُّهُمُ حَسيبُ",78,"ب",1,0],["وقد نَفِدَتْ فيه ذخائرُ مُلكهم","وما لم يكنْ ضرّاً فأكثره نَفْع",79,"ع",1,0],["وقد نَصَحَتْ قُوّادُه غيرَ أنّني","رأيتُ ربيبَ المُلكِ للملكِ أنصَحا",80,"ح",2,0],["وَقَد نافَحتُ عَن أَحسابِ قَومٍ","هُمُ وَرِثوا مَكارِمَ ذي نُواسِ",81,"س",1,0],["وَقَد نَهَيتُ فُؤادي","في خَلوَةٍ فَتَباكى",82,"ك",2,0],["وقد نِكتُهم دهراً طويلاً وآنفاً","أجول بأيري بين أفخاذ مجرمِ",83,"م",1,0],["وَقَد نَرى عارَ قَومٍ في أُنوفِهِمُ","وَنَترُكُ العَيبَ إِذ لَيسوا بِأَندادِ",84,"د",1,0],["وَقَد نَسِيَت عَهدَ الصَفاءِ وَلَم أَزَل","عَلى ذُكَرٍ مِنها أَروحُ وَأَغتَدي",85,"د",2,0],["وَقَد نَهاكِ أُناسٌ لا صَفا لَهُمُ","عَيشٌ وَلا عَدِموا خَصماً وَلا فَلَجوا",86,"ج",3,0],["وَقَد نَزَلوا يَوماً بِأَوضاحِ كامِلٍ","وَلَأياً بَلايِ مِن أَضاخَ اِستَقَلَّتِ",87,"ت",1,0],["وَقَد ناكَ فِزرٌ كُلثُماً غَيرَ مَرَّةٍ","وَلَكِنَّهُ قَد قاءَها بِشَبيبِ",88,"ب",1,0],["وَقَد نَزَلَت مِنّا بِتَدمُرَ نَوبَةٌ","كَذاكَ عُروضُ الشَرِّ تَعرو نَوائِبُه",89,"ب",2,0],["وَقَد نَهاني الإِمامُ فَاِنصَرَفَت","نَفسي لَهُ وَالإِمامُ يُرتَقَبُ",90,"ب",1,0],["وَقَد نُطِحَت بِالجَيشِ رَضوى فَلَم تُبَل","وَلُزَّ بِراياتِ الخَميسِ قُباءُ",91,"ب",3,0],["وَقَد نَطَقتِ بِأَصنافِ العِظاتِ لَنا","وَأَنتِ فيما يَظِنُّ القَومُ خَرساءُ",92,"س",3,0],["وَقَد نَبَذتُ عَلى جَمرٍ خَبا يَبَساً","فَإِن يَكُن فيهِ سِقطٌ يَذكُ إِلهابي",93,"ب",2,0],["وَقَد نَصَحتُكَ فَاِحذَر أَن تَرى أُذُناً","تَرمي إِلى السَهبِ إِكثاري وَإِسهابي",93,"ب",2,0],["وَقَد نَفَت عَنكَ إِغماضاً مُلاحِيَةٌ","في كَرَمِها وَكَأَنَّ النَجمَ عُنقودُ",94,"د",1,0],["وَقَد نَأمُلُ الآمالَ وَهيَ مَنوطَةٌ","إِلى ذَنَبِ السِرحانِ أَو عُنُقِ النَسرِ",95,"ر",1,0],["وَقَد نَطَقوا مَيناً عَلى اللَهِ وَاِفتَروا","فَما لَهُم لا يَفتَرونَ عَلَيكا",96,"ك",2,0],["وَقَد نَسِيَت حُسنَ العُهودِ وَما لَها","بَنانُ يَدٍ فيهِ تُشَدُّ الرَتائِمُ",97,"م",1,0],["وَقَد نَضَتِ النَواظِرُ كُلَّ عامٍ","وَأَترابُ السَعادَةِ مُترَبوهُ",98,"ب",3,0],["وقد نُصلِّي العيدَ بالنواظِرِ","مخافةً من العدوَّ الثائِرِ",99,"ر",1,0],["وَقَد نَتَوَهَّم من نفسنا","لذاكَ بواعثَ أَو نزعم",100,"م",1,0],["وقَدْ نَازَعتْنَا مِنْ كِلاَبٍ قَبَائلٌ","مَحَاجِمُ مِنْهَا مَا يَفِيضُ ويَنْطِفُ",101,"ف",1,0],["وقد نشرَ الغربُ الحزينُ ظلالَهُ","على ثَبَجِ الأمواجِ شُعْثَ الغدائرِ",102,"ر",1,0],["وقد نستعيرُ صفاءَ النمير","وقد نستمدُّ صراعَ العبابْ",103,"ب",1,0],["وقد نسحبُ الليلَ فوق القلوب","ونغري العيون بقوسِ السَّحابْ",103,"ب",1,0],["وقد نَبَحوني وما هِجْتُهُمْ","كما نَبَحَ الكلْبُ ضَوْءَ القَمرْ",104,"ر",1,0],["وقد نَزَلَتْها الصّيْفَ رِجْلٌ فغادرَتْ","بها حَ