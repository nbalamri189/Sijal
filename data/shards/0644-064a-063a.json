{"poems":[[55,"اسقني فاليوم نشوان","https://www.aldiwan.net/poem29667.html","المديد"],[75,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[72,"لا تزد في الهوى علي","https://www.aldiwan.net/poem42389.html","مجزوء الخفيف"],[47,"إسمع مديحي في كعب وما وصلت","https://www.aldiwan.net/poem66803.html","البسيط"],[30,"وأهل حبونا من مراد تداركت","https://www.aldiwan.net/poem5486.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85561","المجتث"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[30,"سمونا لنجران اليماني وأهله","https://www.poetsgate.com/ViewPoem.aspx?id=22082",""],[119,"لي غربة وذلة وقلة","https://www.aldiwan.net/poem41999.html","الرجز"],[185,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[215,"ولي شبابك لم ننعم بنضرتِه","https://www.aldiwan.net/poem46560.html","البسيط"],[251,"وشى واشيا ليلى فقلت صدقتما","https://www.aldiwan.net/poem56326.html","الطويل"],[264,"باسمك يا الله ربي ابتدي","https://www.aldiwan.net/poem35938.html","الرجز"],[266,"أأبحت يا هذي دم المهجور","https://www.aldiwan.net/poem38277.html","الكامل"],[270,"الغبيط","https://www.aldiwan.net/poem8370.html","عموديه"],[287,"لي غريم لازم وهو الغرام","https://www.aldiwan.net/poem32465.html","الرمل"],[287,"لي غبوق من الهوى وصبوح","https://www.aldiwan.net/poem32815.html","الخفيف"],[333,"هتف الشاطىء بالمدح","https://www.aldiwan.net/poem55007.html","مجزوء الرمل"],[438,"صاح هذا ربع الهوى المعهود","https://www.aldiwan.net/poem12476.html","الخفيف"],[438,"أسف موثق ودمع طليق","https://www.aldiwan.net/poem12681.html","الخفيف"],[500,"لو كان بالدهر لحر يدان","https://www.aldiwan.net/poem10281.html","السريع"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199596","المسحوب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59126","الطويل"],[1378,"","https://poetry.dctabudhabi.ae/diwan/poem/216847",""],[1413,"","https://poetry.dctabudhabi.ae/diwan/poem/204397","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49993","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95576","الوافر"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/177841","الطويل"],[2425,"","https://poetry.dctabudhabi.ae/diwan/poem/145270","الخفيف"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87337","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65941","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58533","الرجز"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26113","الوافر"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74061","السريع"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90810","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141683","البسيط"],[5351,"يمانيون يا طه تنادت","https://www.poetsgate.com/ViewPoem.aspx?id=202647",""],[5411,"وَحُبُّكَ موسيقى","https://www.poetsgate.com/ViewPoem.aspx?id=186139",""],[5431,"خيطا من الشمس ثوبا ليس يهترئُ","https://www.poetsgate.com/ViewPoem.aspx?id=197697",""],[5561,"الشاعرُ السجين","https://www.poetsgate.com/ViewPoem.aspx?id=193065",""],[5873,"اِزدهار الحب","https://www.poetsgate.com/ViewPoem.aspx?id=215410",""],[5937,"باحثٌ عن أناهُ في مابعد الحداثة","https://www.poetsgate.com/ViewPoem.aspx?id=211893",""],[6032,"زائري في ليلة صيف","https://www.poetsgate.com/ViewPoem.aspx?id=181524",""],[6075,"( الحسن توجها )","https://www.poetsgate.com/ViewPoem.aspx?id=195130",""]],"verses":[["لي غَديرٌ مِن مُقَبَّلِهِ","وَمِنَ الصُدغَينِ بُستانُ",0,"ن",1,0],["لِيَغُر هَواكَ فَقَد أَجَدَّ حِمايَةً","لِفَتاةِ نَجدٍ فِتيَةٌ أَنجادُ",1,"د",1,0],["لي غَرامٌ مِنَ الصِبا","بَعدُ في النَفسِ مِنهُ شَيَّ",2,"ي",1,0],["لَيُغمَدَنَّ لِساني خائِباً أَبَداً","عَن تينِ فيكُم فَلا سَيءٌ وَلا حَسَنُ",3,"ن",1,0],["لِيَغمِزَ عِزّاً قَد عَسا عَظمُ رَأسِهِ","قُراسِيَةً كَالفَحلِ يَصرِفُ بازِلُه",4,"ل",2,0],["لي غاية أَبتَغيها","وَقَد يوفَّق مثلي",5,"ل",2,0],["لِيَغْنَمِ العَيْشَ طَلْقَاً كُلُّ مُقتَحِمٍ","وَلْيَبْغِ فِي الأَرْضِ شِقَّاً كُلُّ رَعْدِيدِ",6,"د",1,0],["ليَغْمِزَ عِزّاً عَسا عَظْمُ رَأسِهِ،","قُراسِيَةً كالفَحَلِ يَصْرِفُ بَازِلُهْ",7,"ل",2,0],["لي غربة وذلة وقلة","وعلة وفكرة مطلسمه",8,"م",2,1],["لِيَغلِبَ حُبِّها عَزائى وَإِنَّنِي","لِصَبرِى إِذا غالَبتُهُ لَغَلُوبُ",9,"ب",1,0],["ليغفر الحبّ ما أسلفت من صلفٍ","إلى محب معنّى القلب متبول",10,"ل",1,0],["ليغترَّ واشٍ أو ليحسبَ كاشحٌ","مُوِدٌّ لليلى قد تولىّ نشوبّها",11,"ه",2,0],["ليغدُ في حماك مستقيما","وفي رضاك أبداً مقيما",12,"م",2,0],["ليغره بمتاع عيش باطل","وحياة دنيانا متاع غرور",13,"ر",1,0],["ليغرق الفتيان في رقصٍ جنونيٍّ","لئلا يسقطَ الإيقاع.",14,"ع",1,0],["لي غَريمٌ لازِمٌ وَهوَ الغَرامُ","وَحَبيبٌ نامَ عَمَّن لا يَنامُ",15,"م",1,1],["لي غَبوقٌ مِنَ الهَوى وَصَبوحُ","وَبِقَلبي يَغدو الهَوى ويَروحُ",16,"ح",1,1],["ليغنّيها على الخ","لوة لحناً حالما",17,"م",2,0],["لي غَدْرٌ منه ومني وفاءٌ","ووصالٌ مني ومنه صدودُ",18,"د",1,0],["ليَ غيثٌ من المدامع يهْمي","حينَ يلتاحُ البِراقِ البُروقُ",19,"ق",1,0],["لي غلوة أخرى فإن أورقت","كسرت قوسي وهشمت البنان",20,"ن",1,0],["لي غرّقها حشرها","واتوقّفت الانسام",21,"م",1,0],["لِيَغْنَى بِكَ العَانِيا وَيَحْي بِكَ النَّدَى","وَتَزْهُو بِك الدُّنْيَا ويُشْفَى بك اللُّمْطُ",22,"ط",1,0],["لي غيّر جِنْسَه يَرهِبَه","بين الطّباع منافِرَه",23,"ر",2,0],["ليغفر ذنب المستجير بعفوه","ويبلغ في الإحسان غايته القصوى",24,"و",2,0],["ليُغنيَ محروماً ويعطي سائلاً","ويرجي لفعل الصّالحات ويُعتفى",25,"ف",2,0],["ليغدوا الكون خلواً من شرور","وآفاتٍ ويغدو الضيق رحبَا",26,"ب",2,0],["ليغتسل الحجاج فيه ويحرموا","فمنه نلبي ربنا لا حرمناه",27,"ن",3,0],["لي غزال وداده","مع قلبي مغازل",28,"ل",1,1],["لَيَغويكَ أو يحويكَ بَحرٌ وبرُّهُ","وَأُرصُدَ صوتَ الهام إن كُنتَ مَاهِر",29,"ر",1,0],["ليغشاك تعزيز الامام وقد صفا","له الأمر من بعد اعتياق التغنج",30,"ج",1,0],["ليغتدي عِقداً منَ اللآلي","يُنفسُه ذكرُ الجنابِ العالي",31,"ي",1,0],["لِيَغتَبِقَ الغِلالَةَ مِن نَداها","صَفا فوها لِمُغتَبِقٍ وَطابا",32,"ب",2,0],["لِيَغتَبِط سعد بأوطانه","وَليغمر الأَوطان إسعادا",33,"د",2,0],["ليغشوهم وصوب غمامهم من","رصاص ظل يهمي بانهمال",34,"ل",1,0],["لي غرفة ملأى من الكذب الذي","أنفقته في مدح كل بخيل",35,"ل",1,0],["لي غرفة ما شأنها شيء سوى","أن ليس تجري تحتها الأنهار",35,"ر",1,0],["ليغدو النصر موعدنا ويأتي","لنا الفتح القريب غدا نجاحا",36,"ح",2,0],["لِيَغْمرَني الإحْساسُ دونَ هوادةٍ","وَشَوْقٌ بِعَيني جارِفٌ مُتَهَوِّرُ",37,"ر",1,0],["ليغزلَ الشعرَ في تيهٍ وفي صلفٍ","ويكتم الحزن حتى عنه ينكفئُ",38,"ا",1,0],["ليغنّي القلبُ الحزينُ مواويلا","وشعرا يسري بروحي فيكتب",39,"ب",1,0],["لي غدا يحي الأماني ذكرها","مثلما تحيى الفيافي بالمطرْ",40,"ر",1,0],["ليغرقَ فوق سطح الشعر ، حتى","إذا ماصار في قاعٍ ، تَنَفَّسْ",41,"س",1,0],["ليغدو كلانا رهين حياة","يخبئ جرحا ً ودمعا ًعصيّا",42,"ي",2,0],["لِيَغْسِلَ الرُّوحَ كَيْ يَرْقَى عَلَى ثِقَةٍ","أَنَّ الْجَمَالَ الَّذِي يَرْجُوهُ عَيْنَاكِ",43,"ك",1,0]]}