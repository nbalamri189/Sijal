{"poems":[[53,"اسقني فاليوم نشوان","https://www.aldiwan.net/poem29667.html","المديد"],[73,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[70,"لا تزد في الهوى علي","https://www.aldiwan.net/poem42389.html","مجزوء الخفيف"],[45,"إسمع مديحي في كعب وما وصلت","https://www.aldiwan.net/poem66803.html","البسيط"],[28,"وأهل حبونا من مراد تداركت","https://www.aldiwan.net/poem5486.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85561","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[28,"سمونا لنجران اليماني وأهله","https://www.poetsgate.com/ViewPoem.aspx?id=22082",""]],"verses":[["لي غَديرٌ مِن مُقَبَّلِهِ","وَمِنَ الصُدغَينِ بُستانُ",0,"ن",1,0],["لِيَغُر هَواكَ فَقَد أَجَدَّ حِمايَةً","لِفَتاةِ نَجدٍ فِتيَةٌ أَنجادُ",1,"د",1,0],["لي غَرامٌ مِنَ الصِبا","بَعدُ في النَفسِ مِنهُ شَيَّ",2,"ي",1,0],["لَيُغمَدَنَّ لِساني خائِباً أَبَداً","عَن تينِ فيكُم فَلا سَيءٌ وَلا حَسَنُ",3,"ن",1,0],["لِيَغمِزَ عِزّاً قَد عَسا عَظمُ رَأسِهِ","قُراسِيَةً كَالفَحلِ يَصرِفُ بازِلُه",4,"ل",2,0],["لي غاية أَبتَغيها","وَقَد يوفَّق مثلي",5,"ل",2,0],["لِيَغْنَمِ العَيْشَ طَلْقَاً كُلُّ مُقتَحِمٍ","وَلْيَبْغِ فِي الأَرْضِ شِقَّاً كُلُّ رَعْدِيدِ",6,"د",1,0],["ليَغْمِزَ عِزّاً عَسا عَظْمُ رَأسِهِ،","قُراسِيَةً كالفَحَلِ يَصْرِفُ بَازِلُهْ",7,"ل",2,0]]}