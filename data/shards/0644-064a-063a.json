{"poems":[[53,"اسقني فاليوم نشوان","https://www.aldiwan.net/poem29667.html","المديد"],[73,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[70,"لا تزد في الهوى علي","https://www.aldiwan.net/poem42389.html","مجزوء الخفيف"],[45,"إسمع مديحي في كعب وما وصلت","https://www.aldiwan.net/poem66803.html","البسيط"],[28,"وأهل حبونا من مراد تداركت","https://www.aldiwan.net/poem5486.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85561","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[28,"سمونا لنجران اليماني وأهله","https://www.poetsgate.com/ViewPoem.aspx?id=22082",""],[113,"لي غربة وذلة وقلة","https://www.aldiwan.net/poem41999.html","الرجز"],[179,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[209,"ولي شبابك لم ننعم بنضرتِه","https://www.aldiwan.net/poem46560.html","البسيط"],[244,"وشى واشيا ليلى فقلت صدقتما","https://www.aldiwan.net/poem56326.html","الطويل"],[257,"باسمك يا الله ربي ابتدي","https://www.aldiwan.net/poem35938.html","الرجز"],[259,"أأبحت يا هذي دم المهجور","https://www.aldiwan.net/poem38277.html","الكامل"],[263,"الغبيط","https://www.aldiwan.net/poem8370.html","عموديه"],[280,"لي غريم لازم وهو الغرام","https://www.aldiwan.net/poem32465.html","الرمل"],[280,"لي غبوق من الهوى وصبوح","https://www.aldiwan.net/poem32815.html","الخفيف"],[326,"هتف الشاطىء بالمدح","https://www.aldiwan.net/poem55007.html","مجزوء الرمل"],[429,"صاح هذا ربع الهوى المعهود","https://www.aldiwan.net/poem12476.html","الخفيف"],[429,"أسف موثق ودمع طليق","https://www.aldiwan.net/poem12681.html","الخفيف"],[493,"لو كان بالدهر لحر يدان","https://www.aldiwan.net/poem10281.html","السريع"]],"verses":[["لي غَديرٌ مِن مُقَبَّلِهِ","وَمِنَ الصُدغَينِ بُستانُ",0,"ن",1,0],["لِيَغُر هَواكَ فَقَد أَجَدَّ حِمايَةً","لِفَتاةِ نَجدٍ فِتيَةٌ أَنجادُ",1,"د",1,0],["لي غَرامٌ مِنَ الصِبا","بَعدُ في النَفسِ مِنهُ شَيَّ",2,"ي",1,0],["لَيُغمَدَنَّ لِساني خائِباً أَبَداً","عَن تينِ فيكُم فَلا سَيءٌ وَلا حَسَنُ",3,"ن",1,0],["لِيَغمِزَ عِزّاً قَد عَسا عَظمُ رَأسِهِ","قُراسِيَةً كَالفَحلِ يَصرِفُ بازِلُه",4,"ل",2,0],["لي غاية أَبتَغيها","وَقَد يوفَّق مثلي",5,"ل",2,0],["لِيَغْنَمِ العَيْشَ طَلْقَاً كُلُّ مُقتَحِمٍ","وَلْيَبْغِ فِي الأَرْضِ شِقَّاً كُلُّ رَعْدِيدِ",6,"د",1,0],["ليَغْمِزَ عِزّاً عَسا عَظْمُ رَأسِهِ،","قُراسِيَةً كالفَحَلِ يَصْرِفُ بَازِلُهْ",7,"ل",2,0],["لي غربة وذلة وقلة","وعلة وفكرة مطلسمه",8,"م",2,1],["لِيَغلِبَ حُبِّها عَزائى وَإِنَّنِي","لِصَبرِى إِذا غالَبتُهُ لَغَلُوبُ",9,"ب",1,0],["ليغفر الحبّ ما أسلفت من صلفٍ","إلى محب معنّى القلب متبول",10,"ل",1,0],["ليغترَّ واشٍ أو ليحسبَ كاشحٌ","مُوِدٌّ لليلى قد تولىّ نشوبّها",11,"ه",2,0],["ليغدُ في حماك مستقيما","وفي رضاك أبداً مقيما",12,"م",2,0],["ليغره بمتاع عيش باطل","وحياة دنيانا متاع غرور",13,"ر",1,0],["ليغرق الفتيان في رقصٍ جنونيٍّ","لئلا يسقطَ الإيقاع.",14,"ع",1,0],["لي غَريمٌ لازِمٌ وَهوَ الغَرامُ","وَحَبيبٌ نامَ عَمَّن لا يَنامُ",15,"م",1,1],["لي غَبوقٌ مِنَ الهَوى وَصَبوحُ","وَبِقَلبي يَغدو الهَوى ويَروحُ",16,"ح",1,1],["ليغنّيها على الخ","لوة لحناً حالما",17,"م",2,0],["لي غَدْرٌ منه ومني وفاءٌ","ووصالٌ مني ومنه صدودُ",18,"د",1,0],["ليَ غيثٌ من المدامع يهْمي","حينَ يلتاحُ البِراقِ البُروقُ",19,"ق",1,0],["لي غلوة أخرى فإن أورقت","كسرت قوسي وهشمت البنان",20,"ن",1,0]]}