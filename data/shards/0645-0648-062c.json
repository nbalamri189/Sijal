,"https://www.poetsgate.com/ViewPoem.aspx?id=212369",""],[5111,"ليلُ الحَيَارَى","https://www.poetsgate.com/ViewPoem.aspx?id=212633",""],[5121,"رونق الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=36282",""],[5147,"هي الحقيقة والعقبى بمجراها","https://www.poetsgate.com/ViewPoem.aspx?id=166753",""],[5168,"عسنك بالجبيره","https://www.poetsgate.com/ViewPoem.aspx?id=33603",""],[5225,"شوف تأثيرك","https://www.poetsgate.com/ViewPoem.aspx?id=25796",""],[5277,"خطى الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=191033",""],[5277,"حوّاءُ عراقية","https://www.poetsgate.com/ViewPoem.aspx?id=192530",""],[5277,"زهرةٌ لا تذبلها الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=196558",""],[5351,"سؤال الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=202130",""],[5356,"جنّيةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=204487",""],[5365,"خمرة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=191265",""],[5431,"أنطقُ الضاد خائفا من زماني ...","https://www.poetsgate.com/ViewPoem.aspx?id=199742",""],[5431,"إنّ ربي بمهجتي","https://www.poetsgate.com/ViewPoem.aspx?id=213011",""],[5449,"فاءٌ أنا","https://www.poetsgate.com/ViewPoem.aspx?id=188821",""],[5461,"إنتحار موجه","https://www.poetsgate.com/ViewPoem.aspx?id=5982",""],[5491,"ما الشعر ؟","https://www.poetsgate.com/ViewPoem.aspx?id=203221",""],[5495,"مو جيتك","https://www.poetsgate.com/ViewPoem.aspx?id=175438",""],[5573,"ماحال دون معانق الشوق حراس","https://www.poetsgate.com/ViewPoem.aspx?id=201913",""],[5701,"لاحت على الشاطئ بستانا","https://www.poetsgate.com/ViewPoem.aspx?id=164672",""],[5736,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=208885",""],[5776,"النّهرُ العيّاب","https://www.poetsgate.com/ViewPoem.aspx?id=199331",""],[5848,"مع المحبه لتركي رويع","https://www.poetsgate.com/ViewPoem.aspx?id=48979",""],[5848,"خالد المسعودي","https://www.poetsgate.com/ViewPoem.aspx?id=48973",""],[5956,"ساعِدِي الموجَ يا رفاهي","https://www.poetsgate.com/ViewPoem.aspx?id=182092",""],[5956,"لو تحوَّلتُ لنور","https://www.poetsgate.com/ViewPoem.aspx?id=185270",""],[5956,"ذكرى حبي الأول","https://www.poetsgate.com/ViewPoem.aspx?id=196838",""],[6131,"صراعُ الماءْ","https://www.poetsgate.com/ViewPoem.aspx?id=189528",""],[6142,"ما نشا في السما ولا ساح في الأر","https://www.poetsgate.com/ViewPoem.aspx?id=155697",""],[6160,"على نَوافِذِ الغَيبِ ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87103&r=&rc=20",""],[6167,"نداء الأمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85478&r=&rc=7",""],[6212,"أميرة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1629&r=&rc=10",""],[6243,"بَرَدُ الشمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84435&r=&rc=9",""],[5555,"مُعَلَّقَةٌ لِلِاحتِفَاءِ بِالْهَشَاشَةِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87404&r=&rc=0",""],[6312,"خيبةٌ متكرِّرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82952&r=&rc=2",""],[6351,"مخطوطة للمتنبي.. لم تُحقَّق بعد!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86051&r=&rc=4",""]],"verses":[["مُوجِبٌ أن أكون أدنى جليس","لك أعلو بحقِّيَ الجلساءَ",0,"ا",2,0],["مُوجباً رَعْيها لكثرةِ تشبي","هِي لها بالذي أحبّ عَليّا",1,"ي",2,0],["مُوَجَّهُ الوَفرِ مَسؤولاً وَمُبتَدِئاً","إِلى عَطاءِ سَليمِ الوَفرِ مَوفورِ",2,"ر",1,0],["مُوَجَّهاتٍ لِذَوي عَيلَةٍ","تُقَضُّ مِنهُم في فَريقٍ فَريق",3,"ق",1,0],["موجٌ وريحٌ وزحفُ ليلٍ","فمن دمارٍ إلى دمار",4,"ر",1,0],["موج من البر ذو اتصال","بلا هدوء ولا قرار",5,"ر",1,0],["موج على لُجَّته خافقان","قَرَّا على أرجوحةٍ من أمان",6,"ن",1,0],["موجةَ السحرِ من خفيِّ البحورِ","أغمري القلبَ بالخيالِ الغميرِ",7,"ر",1,1],["موجِزٌ زاده الوُضوحُ جمالاً","والتخلِّي عن الفَضالاتِ وزْنَا",8,"ن",2,0],["موجزةُ اللفظ وداعي الأسى","بالحزن في أثنائها أطنبا",9,"ب",2,0],["موجه الوفر مسئولا ومبتدئاً","إلى عطاء سليم الوفر موفور",10,"ر",1,0],["موجبةً إلى الهلاك والتلفْ","والغمّ والخسران أيضاً والأسفْ",11,"ف",1,0],["موجٌ من النارِ لا تهدا زواخرُه","يمدّه آخرٌ ما ارتدَّ وافده",12,"د",2,0],["موجبه الاستقامه في مقامات الإيقان","واتباع النبي الهادي بسر وإعلان",13,"ن",1,0],["موجهاً أنك ابن أنسه","رفقاً عليه من عتاب نفسه",14,"ه",1,0],["مؤجَّلاً قبل النوى وبعدَها","من طارف الرسوم أو تِلادِها",15,"د",3,0],["مُوَجَّدٍ لم يشكُ من دهره","وأهلِهِ إلا إلى مُذنِبِ",16,"ب",1,0],["مَوْجُ بحرِ الشُّهودِ في حضرَةِ السِّ","رِّ عِياناً وعينُ كلِّ نَبِيِّ",17,"ي",1,0],["موجِدُ الأَشياءِ باقٍ دائمٌ","وخَيالٌ كلُّ ما قدْ زُعِمَا",18,"م",2,0],["مَوْجوعُ قلبٍ وغَريبٌ نازِحٌ","من للغَريبِ النَّازحِ المَوْجوعِ",19,"ع",1,0],["مَوْجاتُ دمعةِ عيني","على خُدودي جارتْ",20,"ت",1,0],["موجٌ تدفَّقَ من نشإِ البُروزِ الى","ألْبابِ قومٍ فإلْهامٌ وإِيحاءُ",21,"ا",2,0],["موجودْ معدومْ لا موجودْ لا معدومْ","عبدٌ كثيرُ الخطا في حضرةِ القيومْ",22,"م",1,1],["موجعاً في زفرات وأنين","يا بني الدين أما من سامعِ",23,"ع",1,0],["مُوجها يا (سيف) تيّاره فظيع","اجرفنا دون راي ودون شور",24,"ر",1,0],["موجز القول من أخي الفقر مملو","لٌ وذو الجد مؤثر إنتهابه",25,"ب",2,0],["موجودةٌ حسناتُه وهباتُه","محمودةٌ عاداتْه وخلالُهُ",26,"ل",2,0],["مُؤَجِّجَةٌ نَارَيْنِ نَارَ صَبَابَةٍ","وَنَارَ قِرىً تَنْجَابُ عَنْهَا الْغَيَاهِبُ",27,"ب",1,0],["موجَع بالليل يشكو الألما","ساهرُ الجفن غزير المدمع",28,"ع",1,1],["مُوجعات يبكينَ للكبد ال","حرى عليه وللفُؤاد العميدِ",29,"د",1,0],["موجد الجود والمكارم داود","بن عيسى ذي الحسن والإحسان",30,"ن",1,0],["مَوجُودَةٌ لَكِن أمُورٌ كُلُّهَا","نِسَبٌ تُرَى عَدَمِيَّةَ الوجدَانِ",31,"ن",1,0],["مُوَجِّها منارةً إلى علي","للمُلتَزِم لبير زَمزمَ مُقبِلِ",32,"ل",1,0],["موجُ الشُرورِ بِلُجه مُتلاطمٌ","حَرَكاتُهُ أَنِفَت من الإِسكانِ",33,"ن",1,0],["موجسًا من خيانة في ثنايا ال","غيب والغيب صارم الكتمان",34,"ن",1,0],["موج يطيف بها وقد ران الكرى","فيها طواف الضيغم الغرثان",35,"ن",1,0],["موجِباتِ العِشقِ وَالشَغَفِ","كَم رَشا فاقَ عَلى القَمَرِ",36,"ر",1,0],["موجبة الموجبتين ومع ال","سالبة السالبتين فليقل",37,"ل",1,0],["موجبة جزئية مع موجبة","كلية كعكسة لا سالبة",37,"ه",1,0],["مُوجِبٌ غَايَةَ الفَسَادِ لِمَا يَأ","تِي بِهِ رُسلُنَا وَهُم أمَنَاءُ",38,"ا",2,0],["موجِدُ مبتدِيءُ يا معيدُ","عن المعافاة فلا أحيدُ",39,"د",1,0],["موجد معدمُ محيطُ يا مبين","أظهر علينا الفضل واستر يا معين",40,"ن",1,0],["موج من النور عال لا يسكنه","إلا الذي من سناه ذلك النور",41,"ر",1,0],["موج ماء الصبا بخديك أجرى","سحب عيني تدفقاً وانبجاسا",42,"س",2,0],["مَوجة كَالسَماء تَقلع مِن شَط","وَتُرسي مِن الوُجود بِشَط",43,"ط",1,0],["مُوَجِّهاً شَطرَ الشَّطورِ وَجهَهُ","إِذا عَنِ الزَّاويةِ الوَجه زَوَى",44,"ا",1,0],["موجود لكن مانْت والله بموجود","الحزن زادك والهموم المطايا",45,"ا",3,0],["مُوجَزُ الأَنباءِ: ما مِن","وَجبَةٍ بَعدَ العَصِيرِ",46,"ر",1,0],["موج الغرام عالى يخدك وما يْجيبك","تسأل عناده ليه يسكت ما يُجيبك",47,"ك",1,1],["موجها مثل السحاب المستثير","في جبينك كنها ترسم رجاي",48,"ا",2,0],["مَوْجَا زُجَاجٍ يَسْعَدَانِ بِنَوْرَسٍ","يَقْتَاتُ مِن بَحْرِ اللِّحَاظِ رَغِيدَا",49,"د",2,0],["موْجٌ يُقاذفُني والرُّوٰحُ أَجْنِحَةٌ","على البقاءِ تُبارِي الرِّيحَ... ماسَلتا",50,"ت",2,0],["موجُ الهزيمةِ لا يزالُ بأدمعي","مهزومةٌ عيني , لطيشيَ ناصِرهْ",51,"ر",2,0],["مُؤَجَّجٌ تَائِهٌ ،بِالْحُزْنِ مُكْتَحِلٌ","مَدَى سُهَادِي يُنَاجِي الْقَلْبُ رَبَّاهُ",52,"ا",2,0],["مَوجَةُ النَّايَاتِ هَاتِيْ","مِنْ حَنَايَاكِ اشْتيَاقِي ْ",53,"ق",2,1],["مَوْجَةٌ تَرْسُو ، عَلَى أحْلامِهِمْ","فَيَتُوهُ الْقَلْبُ حُبًّا وَدَلاَلاَ",54,"ل",2,0],["مَوْجُ الْحَرِيِرِ عَلَى خُدْودِ وُرُودِهِ","يَهْفُو فَتَصْحُو حُمْرَةً عِنَدَ الْلِّقَا",55,"ق",2,0],["موجودة بتجليها هويتها","فما أعز معاليها وأغناها",56,"ا",3,0],["موجك كسرت بيه المجاذيف","نخيتك شو كلبت الموج طوفان",57,"ن",1,0],["موجكم طامي وانا بلجّه غريج","في بحورٍ موجها غزر العموق",58,"ق",1,0],["مؤجّلٌ منكِ ما ألقاهُ من عطشٍ","يطوي اشتياقي إلى عينيكِ يا حلبُ",59,"ب",1,0],["موجُ الفراتِ يشقُّ دربَ محبتي","بين الصخورِ وناتئ الأحجارِ",60,"ر",1,0],["موجوعةٌ منكِ الضلوعُ حبيبتي","فمتى تطبِّبُ داءَها السمراءُ",61,"ا",2,0],["موجاً إذا ارتج يغدو","حسم الكريهات أولى",62,"ل",2,0],["موجٌ يُراقِصُ أحلامي ويأسُِرها","ورقانِ ما فيهما فَرطٌ من السحرِ",63,"ر",1,0],["موجُ البحور ِعلى قوافيكِ اهتدتْ","إنّ الحروفَ لَفي حِمى مرساكِ",64,"ك",1,0],["موجع الروح نازفٌ منذ دهر","خانني الوجه لم يعدْ في المرايا",65,"ا",3,0],["موجع القلب غارقا في اشتها","ءات الحشاي