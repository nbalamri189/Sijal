{"poems":[[53,"ألا يا ابن القنوط عجبت جدا","https://www.aldiwan.net/poem65793.html","الوافر"],[33,"ألم تسأل الربع أن ينطقا","https://www.aldiwan.net/poem42216.html","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39578","المتقارب"],[108,"على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179312",""],[108,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[33,"ألمْ تسألِ الربعَ أن ينطقا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18968&r=&rc=231",""],[369,"هم منعوا مني الخيال المسلما","https://www.aldiwan.net/poem60668.html","الطويل"],[438,"قرنت بواو الصدغ صاد المقبل","https://www.aldiwan.net/poem12695.html","الطويل"],[463,"حاشاك من عارية ترد","https://www.aldiwan.net/poem56234.html","الوافر"],[788,"","https://poetry.dctabudhabi.ae/diwan/poem/206050","الطويل"],[1403,"","https://poetry.dctabudhabi.ae/diwan/poem/115360","المنسرح"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96324","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53057","البسيط"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26112","الطويل"],[5937,"خَلْفَ اللثام","https://www.poetsgate.com/ViewPoem.aspx?id=211889",""]],"verses":[["وكيف طمعتَ في استضعافِ ليثٍ","مخالبُهُ شوارع لاختلاسِك",0,"ك",1,0],["وَكَيفَ طِلابي عَراقيَّةً","وَقَد جاوَزَت عيرُها الحِرنِقا",1,"ق",2,0],["وَكَيفَ طِلابُكَ أَلّا الصِبا","وَغَربَ النَوى بَلَداً مُسحَقا",1,"ق",2,0],["وكيف طوى خَصرَها ساعدَاكَ","ومرَّتْ يداكَ على شعرِها",2,"ر",3,0],["وكيف طِرْتَ بلا ريش وأجنحة","في حالق الجوِّ كالعِقْبان والرخم؟",3,"م",1,0],["وكيف طموحي بعد أن شابَ مَفرِقي","بحسبِيَ من دنيايَ: زَادِي، ومَائِيَا",4,"ي",2,0],["وكيفَ طلابي عراقية ً،","وَقَدْ جَاوَزَتْ عِيرُها الخِرْنِقا",5,"ق",2,0],["وكيف طُروقُ الطّيْفِ لا العَيُن غَيّضتْ","لها الدَّمعَ تقليلاً ولا الصّبُّ هَوَّما",6,"م",2,0],["وكيفَ طرقتُ الحَذْرَ يُكرَهُ ربّهُ","على رغم أنفِ الساهرِ المتبتّلِ",7,"ل",1,0],["وكيف طِبتَ أن يُرَى فريسةً","نفساً وأيامُ الشتاء أُسْدُ",8,"د",1,0],["وكيف طلابي العامرية بعدما","أتى دونها غول الرجام فألمس",9,"س",1,1],["وكيف طاب الثرى ببلته","وهب نواره من النوم",10,"م",1,0],["وكيف طلاب البيض او تبع الصبا","وقد صرت من شيب تغشاك اشيبا",11,"ب",2,0],["وكيف طالت يمين الحادثات إلى","رواق ملك على العلياء مضروبِ",12,"ب",1,0],["وَكَيفَ طِلابُ المَردفاتِ عَشيَّةً","وَقَد جاوَزَ الشَيخُ الغَميمَ وَيَثرِبا",13,"ب",2,0],["وكيف طردتُ بحصةِ رسمٍ","لأني رسمتُ البلادَ ، حُطامْ",14,"م",1,0]]}