{"poems":[[53,"زمان الهوى ما أنت لي بزمان","https://www.aldiwan.net/poem29719.html","الطويل"],[53,"ضلالا لسائل هذي المغاني","https://www.aldiwan.net/poem29720.html","المتقارب"],[53,"أيرجع ميتا رنة وعويل","https://www.aldiwan.net/poem29891.html","الطويل"],[53,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[100,"الربيع والشعر","https://www.aldiwan.net/poem10291.html","عموديه"],[77,"نديمي عللني بمشمولة واسق","https://www.aldiwan.net/poem35920.html","الطويل"],[77,"قفا فاسألا في ساحة الأجرع الفرد","https://www.aldiwan.net/poem36602.html","الطويل"],[77,"إذا فكرت في وطن كريم","https://www.aldiwan.net/poem36755.html","الوافر"],[77,"حديث على رغم العلا غير كاذب","https://www.aldiwan.net/poem36768.html","الطويل"],[42,"وعوراء أهداها امرؤ من عشيرتي","https://www.aldiwan.net/poem50329.html","الطويل"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[24,"أمن دمنة الدار أقوت سنينا","https://www.aldiwan.net/poem21884.html","المتقارب"],[86,"نعمن بنفسي وأشقينني","https://www.aldiwan.net/poem10501.html","المتقارب"],[86,"أطل على الأكوان والخلق تنظر","https://www.aldiwan.net/poem10689.html","الطويل"],[86,"أين يوم القنال يا ربة التاج","https://www.aldiwan.net/poem10696.html","الخفيف"],[71,"وعوج كأمثال الأهلة بزل","https://www.aldiwan.net/poem3856.html","الطويل"],[30,"أللأربع الدهم اللواتي كأنها","https://www.aldiwan.net/poem29555.html","الطويل"],[27,"لمن رسم دار هم أن يتغيرا","https://www.aldiwan.net/poem5761.html","الطويل"],[27,"صرم الخليط تباينا وبكورا","https://www.aldiwan.net/poem5774.html","الكامل"],[11,"أتعرف أطلالاَ ونؤيا مهدم","https://www.aldiwan.net/poem268.html",""],[72,"عطفت كأمثال القسي حواجبا","https://www.aldiwan.net/poem18230.html","الكامل"],[72,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[72,"بشراك إن السرى والعود مبرور","https://www.aldiwan.net/poem18707.html","البسيط"],[72,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[72,"تأخرت عنكم يا بني ويا أبي","https://www.aldiwan.net/poem19247.html","الطويل"],[72,"على اليمن والنعمى قدومك إنه","https://www.aldiwan.net/poem20300.html","الطويل"],[51,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[51,"راع فؤادي منك ما راعه","https://www.aldiwan.net/poem65408.html","السريع"],[70,"عليك سلام الله يا قبر عثمان","https://www.aldiwan.net/poem42450.html","الخفيف"],[89,"وقفت على المستنصرية باكيا","https://www.aldiwan.net/poem44962.html","الطويل"],[85,"نراوح بالحوادث أو نغادى","https://www.aldiwan.net/poem8105.html","الوافر"],[85,"لكل زمان مضى آية","https://www.aldiwan.net/poem63760.html","المتقارب"],[43,"لا افتخار إلا لمن لا يضام","https://www.aldiwan.net/poem10542.html","الخفيف"],[62,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[45,"بعض هذا الملام والتفنيد","https://www.aldiwan.net/poem63515.html","الخفيف"],[45,"حلفت لها بالله يوم التفرق","https://www.aldiwan.net/poem65186.html","الطويل"],[45,"ألا هل أتاها بالمغيب سلامي","https://www.aldiwan.net/poem65670.html","الطويل"],[28,"وطئت جياد يزيد كل مدينة","https://www.aldiwan.net/poem5178.html","الكامل"],[2,"لمن طلل برامة لا يريم","https://www.aldiwan.net/poem25054.html","الوافر"],[49,"ألا من لنفس في الهوى قد تمادت","https://www.aldiwan.net/poem10840.html","الطويل"],[66,"رو عظامي بسلا","https://www.aldiwan.net/poem38502.html","مجزوء الرجز"],[66,"وعودتني منك الجميل فإن يكن","https://www.aldiwan.net/poem38793.html","الطويل"],[66,"عجبت لها تمسي العقول لها نهبا","https://www.aldiwan.net/poem39205.html","الطويل"],[66,"لقد جزت في الصد حد الزياده","https://www.aldiwan.net/poem40303.html","المتقارب"],[66,"وعود به عاد السرور لأنه","https://www.aldiwan.net/poem40679.html","الطويل"],[80,"إني امرؤ لا ترى لساني","https://www.aldiwan.net/poem31253.html","مخلع البسيط"],[80,"كفى سيفك الإسلام عادية الكفر","https://www.aldiwan.net/poem31440.html","الطويل"],[44,"زفرات مقلقلات","https://www.aldiwan.net/poem30274.html","مجزوء الرمل"],[105,"قفوا ساعة إن المحب له عهد","https://www.aldiwan.net/poem43161.html","الطويل"],[105,"أكل متوج يحمي البلادا","https://www.aldiwan.net/poem43373.html","الوافر"],[105,"قدوم من أبي موسى الهمام","https://www.aldiwan.net/poem44016.html","الوافر"],[81,"أما لك لا ترثي لحاله مكمد","https://www.aldiwan.net/poem61538.html","الطويل"],[67,"قل لعلي الذي صداقته","https://www.aldiwan.net/poem18135.html","المنسرح"],[75,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[48,"وعود كرمة كرخ","https://www.aldiwan.net/poem62558.html","الخفيف"],[46,"ضحك الدهر في محياك مكر","https://www.aldiwan.net/poem22593.html","الخفيف"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140892",""],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54935","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54988","الوافر"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67288","الطويل"],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[77,"نديمي عللني بمشمولة واسق","https://www.poetsgate.com/ViewPoem.aspx?id=34194",""],[100,"الربيع والشعر","https://www.poetsgate.com/ViewPoem.aspx?id=50128",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[45,"ألا هَلْ أتَاهَا، بالمَغِيبِ، سَلاَمي","https://www.poetsgate.com/ViewPoem.aspx?id=31842",""],[85,"نُراوَحُ بالحوادثِ، أَو نُغادَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9639&r=&rc=129",""]],"verses":[["وَعَوراءَ لَم أُنصِت إِلَيها وَلَم أُرِد","جَواباً لَها وَالقَولُ لَيسَ بِوانِ",0,"ن",1,0],["وَعوجا عَلَيَّ أُحَيِّ الدِيارَ","فَإِنَّ الدِيارَ لِمَن تَعلَمانِ",1,"ن",1,0],["وَعَوَّدَني مِن جودِ كَفّيهِ عادَةً","أَعوجُ إِلَيها بِالمُنى وَأَميلُ",2,"ل",1,0],["وَعَوِّذوا مِنهُ النُحو","رَ وَالرِقابَ وَالقَصَر",3,"ر",1,0],["وعواطف تندى وإنسانية","عصما توشحت السمو الأعصما",4,"م",2,0],["وعودٌ حنى أضْلاعَهُ فوقَ كاهِنٍ","يفوهُ بِما يوحِي البَنانُ وما يُلْقي",5,"ق",2,0],["وعُوجا علَيْها فاسْأَلا عنْ أنيسِها","وإنْ كانَ تسْآلُ المَعالِمِ لا يُجْدي",6,"د",2,0],["وَعَوَّضَكَ الزَّمَانُ بِشرِّ دَار","وَسُكْنَى مَنْزِلٍ وَحْشِ الْجَنَابِ",7,"ب",1,0],["وَعُوجَا بِأَكْنَافِ الضَّرِيح الَّذِي حَوَى","مِنَ الْجُودِ وَالإفْضَالِ أَسْنَى الْمَرَاتِبِ",8,"ب",1,0],["وَعَوراءَ أَهداها امرُؤٌ مِن عَشيرَتي","إِلَيَّ وَما بي أَن أَكونَ لَها أَهلا",9,"ل",2,1],["وَعَوراءَ جاءَت فَجاوَبتُها","بِشَنعاءَ نافِيَةٍ لِلرَقِم",10,"م",1,0],["وَعوجاً خِفافاً سَلامُ الشَظى","وَميظَبَ أُكمٍ صَليباً رَزينا",11,"ن",2,0],["وَعَوَّدتُهُنَّ نِزالَ الخُطوبِ","فَما يَنثَنينَ وَما أَنثَني",12,"ن",2,0],["وَعَوَّذَها بِاللَهِ مِن شَرِّ طامِعٍ","إِذا ما رَمى إِدوَردُ أَو راشَ قَيصَرُ",13,"ر",1,0],["وَعَوى الذِئبُ في نَواحيكَ يا قَص","رُ وَقَد كُنتَ مَعقِلاً لِلِّسانِ",14,"ن",1,0],["وَعُوجٍ كَأَمثالِ الأَهِلَّةُ بزَّلٍ","دِقاقٍ حَواشيها تماكٍ خُصورُها",15,"ه",2,1],["وَعَوصاءِ حاجاتٍ عَلَيها مَهابَةٌ","أَطافَت بِها مَحفوفَةٍ بِالمَخاوِفِ",16,"ف",1,0],["وَعَوفٌ يَعافُ الضَيمَ في آلِ مالِكٍ","وَكُنتُم بَني جَوخى عَلى المَوتِ أَصبَرا",17,"ر",2,0],["وَعَوى الفَرَزدَقُ لِلأُخَيطِلِ مُحلِباً","فَتَنازَعا مَرِسَ القُوى مَشزورا",18,"ر",2,0],["وَعَوراءَ قَد أَعرَضتُ عَنها فَلَم يَضِر","وَذي أَوَدٍ قَوَّمتُهُ فَتَقَوَّما",19,"م",2,0],["وعواذِلي عابُوا عليَّ صبابتِي","وكفاهُم جهلُ الصبابةِ عائبا",20,"ب",2,0],["وعُوِّدتْ قتل ذي زيغ وذي خطل","كأنَّها من كسير الحظِّ فضلات",21,"ت",1,0],["وعودة لحمى ملكٍ يطوف بها","يا كعبة الجود ملهوفٌ ومضرور",22,"ر",1,0],["وعودك في سما التدبير بدراً","يفرّع من ركوب هلال كور",23,"ر",1,0],["وعود نباتيّ مني يرتجي بقا","وقد مات منه أصله وفروعه",24,"ه",1,0],["وعودك للأوطان من مصر فائزاً","بملكٍ ومن أرض الحجاز بغفران",25,"ن",1,0],["وعوَّجَ من عمرو تمكُّنُ خبلهِ","كما عوجت كفُّ الصبي من السطر",26,"ر",1,0],["وعواعة البطن فإن رجعت","يوماً غناء فهي وعواعه",27,"ع",2,0],["وَعُوِّضتَ عَن دارٍ بِأَكنافِ جَنَّةٍ","وَعُوِّضتَ عَن أَهلٍ بُحورٍ وَوِلدانِ",28,"ن",1,0],["وعُوّض عنها دولة ثم دولة","تُسَرُّ بكون الجهل في الناس فاشيا",29,"ي",2,0],["وَعودِيَ دونَها حَتّى بَناها","وَمِن شَأنِ المُجَدِّدِ أَن يُعادى",30,"د",2,0],["وَعودُ اِبنِ ساعِدَةٍ في عُكاظَ","إِذا سالَ خاطِرُهُ بِالطُرَف",31,"ف",1,0],["وَعَوارٍ لَوامِعٌ دينُها الحِل","لُ وَلَكِنَّ زِيَّها الإِحرامُ",32,"م",1,0],["وعوجٌ لها بين الضُّلوعِ أزاملٌ","وبيضٌ لها فوقَ الرُؤوسِ صَلِيلُ",33,"ل",1,0],["وَعَوانٍ تُحَلُّ تَحتَ وَغاها","عُقدَةُ الفارِسِ الشُجاعِ النَجيدِ",34,"د",1,0],["وَعودوا لَهُ بِالشُكرِ مِنكُم يَعُد لَكُم","بِسَيبِ جَوادٍ بِاللُهى مُتَدَفِّقِ",35,"ق",1,0],["وَعودُ بَنانٍ حينَ ساعَدَ شَجوَهُ","عَلى نَغَمِ الأَلحانِ نايُ زُنامِ",36,"م",1,0],["وَعَواسِلٍ عَسَلَ الذِئابِ كَأَنَّها","أَشطانُ بائِنَةٍ مِنَ الآبارِ",37,"ر",1,0],["وَعَوَّدَ قَومَهُ هَرِمٌ عَلَيهِ","وَمِن عاداتِهِ الخُلُقُ الكَريمُ",38,"م",1,0],["وَعَوَّدتُ نَفسي عادَةً فَلَزِمتُها","أَراهُ عَظيماً أَن أُفارِقَ عادَتي",39,"ي",1,0],["وَعَوِّذِ الكَأسَ مِنَ ال","ماءِ بِرَبِّ الفَلَقِ",40,"ق",1,0],["وَعَوَّدتَني مِنكَ الجَميلَ فَإِن يَكُن","جَفاكَ لَأَمرٍ موجِبٍ فَجَميلُ",41,"ل",1,1],["وَعوجا بِنا نَستَمطِرُ الدُنَّ غُدوَةً","إِذا عاجَتِ الأَغمارُ تَستَمطِرُ السُحبا",42,"ب",2,0],["وَعَوَّدتَني مِنكَ حُسنَ الوَدادِ","وَما يَطلُبُ القَلبُ إِلّا اِعتِيادَه",43,"د",2,0],["وَعودٍ بِهِ عادَ السُرورُ لِأَنَّهُ","حَوى اللَهوِ قِدماً وَهوَ رَيّانُ ناعِمُ",44,"م",1,1],["وَعْوَعَ سِيدٌ على هزَبرٍ","فما رآهُ الهزبرُ كُفْوا",45,"و",2,0],["وَعَوّلَ في العسرِ الفَقيرُ على نَدى","يَدَيكَ وَهَل يَغْنى الكسيرُ عَنِ الجبرِ",46,"ر",1,0],["وَعَويلٌ مِن غَليلِ","أَضرَمَتهُ الحَسَراتُ",47,"ت",1,0],["وَعودوا إِلى أَوطانِكُم في غَضارَةٍ","مِنَ العَيشِ مَقرونٌ بِها العِزُّ وَالمَجدُ",48,"د",1,0],["وعَوِّدنا خلالَ الخير إنّي","رأيتُ الخيرَ والشرّ اعتيادا",49,"د",2,0],["وَعَوْدٌ من غريبِ الدارِ ناءٍ","رَمى برحالهِ للبَيْنِ رامِ",50,"م",1,0],["وَعَوَّضتَني بِالسُخطِ مِن حالَةِ الرِضا","وَمِن أُنسِ مَألوفٍ بِحالَةِ مُفرَدِ",51,"د",1,0],["وَعَوَدَتْ يَوْمَها زِيارَتَهُ","وما اعْتَرَاها مِنْ قَبْلِ ذَاكَ سَنَهْ",52,"ن",2,0],["وعوابسٌ وقَوانِسٌ وفَوارِسٌ","وكوانسٌ وأوانسٌ وعقائل",53,"ل",1,0],["وعواطفاً وعوارفاً وقواصفاً","وخوانِفاً يشتاقُها المِضمار",54,"ر",1,0],["وَعودُ كَرمَةِ كَرخٍ","زَوَّجتُها ماءَ وادِ",55,"د",1,1],["وَعَوانٍ حازَت حُليَّ كَعابٍ","فاجَأَتها مِنَ الحَوادِثِ بِكرُ",56,"ر",1,0],["وعودتي أجرع كأس الحياة","مُعاقِراً سُمَّ الفناء البطيء",57,"ي",2,0],["وعوار لوامعٌ دينها الح","ل ولكن زيها الإحرام",58,"م",1,0],["وعُوَيْراً شَكَتْ وليس الّذي أسْ","رى بهِنْدٍ لا بلْ عُوَيْراً بَصيرا",59,"ر",2,0],["وَعَوَالِي النَّخِيلِ خُضْرِ الأَكَالِيلِ","زَوَاهِي المَرْجَانِ حَوْلَ النُّحُورِ",60,"ر",1,0],["وَعُولِيَ فوْقَهُ نُصُبٌ","يُرِينَا الشَّاعِرَ الْغضَّا",61,"ض",2,0],["وَعَوْفُ بنُ سَلْمى وابنُ عوفٍ كلاهما","وكَعْبٌ رئيسُ القَومِ حانَ وخُيِّبا",62,"ب",2,0],["وعويلِ رَبَّات البيو","تِ كأَنَّهُ قَصْفُ الرعود",63,"د",1,0],["وعود حنا أضلاعه فوق كافىء","يفوه بما بوحي البيان وما يلقي",64,"ق",2,0],["وعواطف تندى وإنسانية","عصما توشّجت السمو الأعصما",65,"م",2,0],["وعوَّضَهم عن الشَرَفِ المُبَقَّى","حُطام المالِ يذهَبُ والضِياعا",66,"ع",2,0],["وعوَّضَ الناسَ عن ذُلٍّس ومَتربَةٍ","مَنَ القناعةِ كنزاً مائجاً ذهبا",67,"ب",2,0],["وعوَّضتَ عن قُبلتي قُبلةً","عَصَرْتَ بها كلَّ ما يؤلِم",68,"م",1,0],["وَعُودُ بَنَانٍ، حينَ سَاعََ شَجْْوهُ","عَلَى نَغَمِ الألحَانِ نَايَ زُنَامِ",69,"م",1,0],["وعوديَ ودونها حتى بناها","ومن شأْنِ المجدِّدِ أَن يُعادى",70,"د",2,0]]}