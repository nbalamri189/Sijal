.net/poem47835.html","المتقارب"],[551,"رأيت فلم أر فيما رأيت","https://www.aldiwan.net/poem47836.html","المتقارب"],[558,"إليك من البعد قلبي دنا","https://www.aldiwan.net/poem33810.html","المتقارب"],[558,"ومن أعجب الأمر هذا الخفا","https://www.aldiwan.net/poem34360.html","المتقارب"],[559,"أتيناك بالفقر لا بالغنى","https://www.aldiwan.net/poem69341.html","المتقارب"],[567,"أتأسى يا أبا بكر","https://www.aldiwan.net/poem69652.html","مجزوء الوافر"],[569,"ونار دعوت المعتفين بضوئها","https://www.aldiwan.net/poem52006.html","الطويل"],[569,"رب أمور قد بريت لحاءها","https://www.aldiwan.net/poem52036.html","الطويل"],[575,"أودع منك الصدر والبدر والبحرا","https://www.aldiwan.net/poem2722.html","الطويل"],[575,"أصبحت بعدك في الحياة كفان","https://www.aldiwan.net/poem2773.html","الكامل"],[575,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"],[587,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"],[587,"ألا مال نيران الأسى تتضرم","https://www.aldiwan.net/poem11519.html","عموديه"]],"verses":[["وَعَوراءَ لَم أُنصِت إِلَيها وَلَم أُرِد","جَواباً لَها وَالقَولُ لَيسَ بِوانِ",0,"ن",1,0],["وَعوجا عَلَيَّ أُحَيِّ الدِيارَ","فَإِنَّ الدِيارَ لِمَن تَعلَمانِ",1,"ن",1,0],["وَعَوَّدَني مِن جودِ كَفّيهِ عادَةً","أَعوجُ إِلَيها بِالمُنى وَأَميلُ",2,"ل",1,0],["وَعَوِّذوا مِنهُ النُحو","رَ وَالرِقابَ وَالقَصَر",3,"ر",1,0],["وعواطف تندى وإنسانية","عصما توشحت السمو الأعصما",4,"م",2,0],["وعودٌ حنى أضْلاعَهُ فوقَ كاهِنٍ","يفوهُ بِما يوحِي البَنانُ وما يُلْقي",5,"ق",2,0],["وعُوجا علَيْها فاسْأَلا عنْ أنيسِها","وإنْ كانَ تسْآلُ المَعالِمِ لا يُجْدي",6,"د",2,0],["وَعَوَّضَكَ الزَّمَانُ بِشرِّ دَار","وَسُكْنَى مَنْزِلٍ وَحْشِ الْجَنَابِ",7,"ب",1,0],["وَعُوجَا بِأَكْنَافِ الضَّرِيح الَّذِي حَوَى","مِنَ الْجُودِ وَالإفْضَالِ أَسْنَى الْمَرَاتِبِ",8,"ب",1,0],["وَعَوراءَ أَهداها امرُؤٌ مِن عَشيرَتي","إِلَيَّ وَما بي أَن أَكونَ لَها أَهلا",9,"ل",2,1],["وَعَوراءَ جاءَت فَجاوَبتُها","بِشَنعاءَ نافِيَةٍ لِلرَقِم",10,"م",1,0],["وَعوجاً خِفافاً سَلامُ الشَظى","وَميظَبَ أُكمٍ صَليباً رَزينا",11,"ن",2,0],["وَعَوَّدتُهُنَّ نِزالَ الخُطوبِ","فَما يَنثَنينَ وَما أَنثَني",12,"ن",2,0],["وَعَوَّذَها بِاللَهِ مِن شَرِّ طامِعٍ","إِذا ما رَمى إِدوَردُ أَو راشَ قَيصَرُ",13,"ر",1,0],["وَعَوى الذِئبُ في نَواحيكَ يا قَص","رُ وَقَد كُنتَ مَعقِلاً لِلِّسانِ",14,"ن",1,0],["وَعُوجٍ كَأَمثالِ الأَهِلَّةُ بزَّلٍ","دِقاقٍ حَواشيها تماكٍ خُصورُها",15,"ه",2,1],["وَعَوصاءِ حاجاتٍ عَلَيها مَهابَةٌ","أَطافَت بِها مَحفوفَةٍ بِالمَخاوِفِ",16,"ف",1,0],["وَعَوفٌ يَعافُ الضَيمَ في آلِ مالِكٍ","وَكُنتُم بَني جَوخى عَلى المَوتِ أَصبَرا",17,"ر",2,0],["وَعَوى الفَرَزدَقُ لِلأُخَيطِلِ مُحلِباً","فَتَنازَعا مَرِسَ القُوى مَشزورا",18,"ر",2,0],["وَعَوراءَ قَد أَعرَضتُ عَنها فَلَم يَضِر","وَذي أَوَدٍ قَوَّمتُهُ فَتَقَوَّما",19,"م",2,0],["وعواذِلي عابُوا عليَّ صبابتِي","وكفاهُم جهلُ الصبابةِ عائبا",20,"ب",2,0],["وعُوِّدتْ قتل ذي زيغ وذي خطل","كأنَّها من كسير الحظِّ فضلات",21,"ت",1,0],["وعودة لحمى ملكٍ يطوف بها","يا كعبة الجود ملهوفٌ ومضرور",22,"ر",1,0],["وعودك في سما التدبير بدراً","يفرّع من ركوب هلال كور",23,"ر",1,0],["وعود نباتيّ مني يرتجي بقا","وقد مات منه أصله وفروعه",24,"ه",1,0],["وعودك للأوطان من مصر فائزاً","بملكٍ ومن أرض الحجاز بغفران",25,"ن",1,0],["وعوَّجَ من عمرو تمكُّنُ خبلهِ","كما عوجت كفُّ الصبي من السطر",26,"ر",1,0],["وعواعة البطن فإن رجعت","يوماً غناء فهي وعواعه",27,"ع",2,0],["وَعُوِّضتَ عَن دارٍ بِأَكنافِ جَنَّةٍ","وَعُوِّضتَ عَن أَهلٍ بُحورٍ وَوِلدانِ",28,"ن",1,0],["وعُوّض عنها دولة ثم دولة","تُسَرُّ بكون الجهل في الناس فاشيا",29,"ي",2,0],["وَعودِيَ دونَها حَتّى بَناها","وَمِن شَأنِ المُجَدِّدِ أَن يُعادى",30,"د",2,0],["وَعودُ اِبنِ ساعِدَةٍ في عُكاظَ","إِذا سالَ خاطِرُهُ بِالطُرَف",31,"ف",1,0],["وَعَوارٍ لَوامِعٌ دينُها الحِل","لُ وَلَكِنَّ زِيَّها الإِحرامُ",32,"م",1,0],["وعوجٌ لها بين الضُّلوعِ أزاملٌ","وبيضٌ لها فوقَ الرُؤوسِ صَلِيلُ",33,"ل",1,0],["وَعَوانٍ تُحَلُّ تَحتَ وَغاها","عُقدَةُ الفارِسِ الشُجاعِ النَجيدِ",34,"د",1,0],["وَعودوا لَهُ بِالشُكرِ مِنكُم يَعُد لَكُم","بِسَيبِ جَوادٍ بِاللُهى مُتَدَفِّقِ",35,"ق",1,0],["وَعودُ بَنانٍ حينَ ساعَدَ شَجوَهُ","عَلى نَغَمِ الأَلحانِ نايُ زُنامِ",36,"م",1,0],["وَعَواسِلٍ عَسَلَ الذِئابِ كَأَنَّها","أَشطانُ بائِنَةٍ مِنَ الآبارِ",37,"ر",1,0],["وَعَوَّدَ قَومَهُ هَرِمٌ عَلَيهِ","وَمِن عاداتِهِ الخُلُقُ الكَريمُ",38,"م",1,0],["وَعَوَّدتُ نَفسي عادَةً فَلَزِمتُها","أَراهُ عَظيماً أَن أُفارِقَ عادَتي",39,"ي",1,0],["وَعَوِّذِ الكَأسَ مِنَ ال","ماءِ بِرَبِّ الفَلَقِ",40,"ق",1,0],["وَعَوَّدتَني مِنكَ الجَميلَ فَإِن يَكُن","جَفاكَ لَأَمرٍ موجِبٍ فَجَميلُ",41,"ل",1,1],["وَعوجا بِنا نَستَمطِرُ الدُنَّ غُدوَةً","إِذا عاجَتِ الأَغمارُ تَستَمطِرُ السُحبا",42,"ب",2,0],["وَعَوَّدتَني مِنكَ حُسنَ الوَدادِ","وَما يَطلُبُ القَلبُ إِلّا اِعتِيادَه",43,"د",2,0],["وَعودٍ بِهِ عادَ السُرورُ لِأَنَّهُ","حَوى اللَهوِ قِدماً وَهوَ رَيّانُ ناعِمُ",44,"م",1,1],["وَعْوَعَ سِيدٌ على هزَبرٍ","فما رآهُ الهزبرُ كُفْوا",45,"و",2,0],["وَعَوّلَ في العسرِ الفَقيرُ على نَدى","يَدَيكَ وَهَل يَغْنى الكسيرُ عَنِ الجبرِ",46,"ر",1,0],["وَعَويلٌ مِن غَليلِ","أَضرَمَتهُ الحَسَراتُ",47,"ت",1,0],["وَعودوا إِلى أَوطانِكُم في غَضارَةٍ","مِنَ العَيشِ مَقرونٌ بِها العِزُّ وَالمَجدُ",48,"د",1,0],["وعَوِّدنا خلالَ الخير إنّي","رأيتُ الخيرَ والشرّ اعتيادا",49,"د",2,0],["وَعَوْدٌ من غريبِ الدارِ ناءٍ","رَمى برحالهِ للبَيْنِ رامِ",50,"م",1,0],["وَعَوَّضتَني بِالسُخطِ مِن حالَةِ الرِضا","وَمِن أُنسِ مَألوفٍ بِحالَةِ مُفرَدِ",51,"د",1,0],["وَعَوَدَتْ يَوْمَها زِيارَتَهُ","وما اعْتَرَاها مِنْ قَبْلِ ذَاكَ سَنَهْ",52,"ن",2,0],["وعوابسٌ وقَوانِسٌ وفَوارِسٌ","وكوانسٌ وأوانسٌ وعقائل",53,"ل",1,0],["وعواطفاً وعوارفاً وقواصفاً","وخوانِفاً يشتاقُها المِضمار",54,"ر",1,0],["وَعودُ كَرمَةِ كَرخٍ","زَوَّجتُها ماءَ وادِ",55,"د",1,1],["وَعَوانٍ حازَت حُليَّ كَعابٍ","فاجَأَتها مِنَ الحَوادِثِ بِكرُ",56,"ر",1,0],["وعودتي أجرع كأس الحياة","مُعاقِراً سُمَّ الفناء البطيء",57,"ي",2,0],["وعوار لوامعٌ دينها الح","ل ولكن زيها الإحرام",58,"م",1,0],["وعُوَيْراً شَكَتْ وليس الّذي أسْ","رى بهِنْدٍ لا بلْ عُوَيْراً بَصيرا",59,"ر",2,0],["وَعَوَالِي النَّخِيلِ خُضْرِ الأَكَالِيلِ","زَوَاهِي المَرْجَانِ حَوْلَ النُّحُورِ",60,"ر",1,0],["وَ