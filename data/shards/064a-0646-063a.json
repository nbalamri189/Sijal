{"poems":[[92,"أرح ركابك من أين ومن عثر","https://www.aldiwan.net/poem60154.html","عموديه"],[266,"صب بلا لوعة ولا كمد","https://www.aldiwan.net/poem38340.html","المنسرح"],[412,"أبا الفضل طال الليل أم خانني صبري","https://www.aldiwan.net/poem50177.html","الطويل"],[2740,"","https://poetry.dctabudhabi.ae/diwan/poem/126522","الطويل"],[3484,"","https://poetry.dctabudhabi.ae/diwan/poem/216400",""],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62855","المتقارب"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132118","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136678",""]],"verses":[["ينَغٌص العَيش إنٌ المَوت يدرِكهُ","فنحن من ذين ِ بين الناب والظفرِ",0,"ر",1,0],["ينغص الدهر عيشتي نكدا","لديهم والغريب في نكد",1,"د",1,0],["يُنَغِّصُ نَومي كُلَّ يَومٍ وَيقظَتي","خَيالٌ لَهُ يَسري وَذِكرٌ لَهُ يَجري",2,"ر",2,0],["ينغصها الاحباب بالهجر والنوى","وتقطعها الآمال قطع المراحلِ",3,"ل",1,0],["ينغذِن مِ البرّ والدِّهن الهَباد","والوريقي لي زروعَه تايهات",4,"ت",1,0],["يُنغِّضُ عندي لقاءَ الحبيبِ","فَرْطُ الحَيَاءِ وطُولُ الحَصَرْ",5,"ر",1,0],["ينغصه من باذخ العز ما مضى","ويجرحه ذكر العصور السوابق",6,"ق",1,0],["ينغطُ الظُبي في رُباها كما","تنغط بنتُ القطا على الغدران",7,"ن",1,0]]}