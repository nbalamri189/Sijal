wan/poem/91385","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92276","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135751","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105256","الكامل"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105259","الكامل"],[4109,"","https://poetry.dctabudhabi.ae/diwan/poem/97554","الخفيف"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136444",""],[3464,"تحكم بما تهوى لك الحسن مسعدُ","https://www.poetsgate.com/ViewPoem.aspx?id=158768",""],[4929,"القدس في آجامها أُسْدُ","https://www.poetsgate.com/ViewPoem.aspx?id=199469",""],[5038,"تعال نغنّي","https://www.poetsgate.com/ViewPoem.aspx?id=188834",""],[5111,"بلحُ القَصَائِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=212104",""],[5145,"مقل الظباء إذا رمين قواصد","https://www.poetsgate.com/ViewPoem.aspx?id=108154",""],[5183,"عالي الجناب","https://www.poetsgate.com/ViewPoem.aspx?id=186607",""],[5186,"لم يبق لي في الساح جولة جائل","https://www.poetsgate.com/ViewPoem.aspx?id=156459",""],[5365,"بلا عنوان","https://www.poetsgate.com/ViewPoem.aspx?id=190403",""],[5431,"أنا الكُردي","https://www.poetsgate.com/ViewPoem.aspx?id=183030",""],[5431,"رياض العاشقين ...","https://www.poetsgate.com/ViewPoem.aspx?id=207521",""],[709,"هَلَّ الْمُحَرَّمُ فَاسْتَهِلَّ مُكَبِّرَا","https://www.poetsgate.com/ViewPoem.aspx?id=2961",""],[5538,"أشم النسيم بوقت الأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=142639",""],[5943,"جيلُ كَسْرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=11260",""],[5956,"غيري من الشعراء...","https://www.poetsgate.com/ViewPoem.aspx?id=193359",""],[6056,"أبدع المنظوم","https://www.poetsgate.com/ViewPoem.aspx?id=156714",""],[402,"لك في ارتجال جلائل الهمم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54014&r=&rc=866",""]],"verses":[["بِلَحْظَةٍ أَوْ لَفْظَةٍ تَغْتَدِي","مُحْسِنَةً قَبْلَ اليَدِ المُحسِنَهْ",0,"ن",2,0],["بَلْ حُكْمُهُ أَنْ يُسْتَشَفَّ مَدَى","غَايَاتِهَا مِنْ أَبْلَغِ الحِكَمِ",1,"م",1,0],["بلحن إذا امتدّ هزّ القلو","ب وخدّر أبداننا والعصب",2,"ب",1,0],["بَل حاجَةٌ لَكَ في الحَيِّ الَّذينَ غَدَوا","مَرّوا عَلى السِرِّ ذي الأَغيالِ فَاِجتَزَعوا",3,"ع",3,0],["بل حَذَوا حَذْوَها فراحوا يريحو","ن من القولِ كلَّ معنى غريبِ",4,"ب",1,0],["بل حقُّه الرحمة إن الفتى","قد زُجَّ في البحر به زَجَّهْ",5,"ج",2,0],["بَلْ حَدَتْهُ إليهِ حَادِيَة الحظ","ظِ حُدَاءَ ابنِ قَفْرَةٍ بقَعُودِ",6,"د",1,0],["بل حَقُّ سقياك أن تكون من ال","صهباءِ صهباءِ حمص أو جَدَرِ",7,"ر",1,0],["بل حاضر النصر من ذي مضرب خَذِمٍ","وذي سنانٍ طرير الحد مجلوز",8,"ز",1,0],["بل حِفاظٌ فينا إذا قيل حاموا","وسماحٌ فينا إذا قيل أعطُو",9,"ط",2,0],["بل حمىَ جسمَها وقد أسلمتهُ","رقةٌ سابريةٌ لانحلالِ",10,"ل",1,0],["بل حلوة مرة طوراً يقال لها","شهدٌ وطوراً يقول الناس ذيفان",11,"ن",1,0],["بِلِحاظٍ نَوافِثٍ","فَجَنَى حَظِّيَ الشَّقا",12,"ق",2,0],["بل حَكَتْ فِعْلَك الكَريمَ ليُضحي","شأنُها في العُلى سواءً وشانُك",13,"ك",1,0],["بل حباكَ اللَّه بأساً وندىً","خُلُقاً منك على أكْرم خِيمْ",14,"م",1,0],["بَل حَبَّذا نَهضَةُ المِعراجِ حينَ سَما","بِهِ إِلى مَشهَدٍ في العزِّ لَم يُرَمِ",15,"م",1,0],["بل حكمةُ اللهِ كانت في سلامتكم","لأَنكم غير أهل للشهاداتِ",16,"ت",1,0],["بلَحظَةٍ منهُ فَما دونَها","يَرُدّ غَرْبَ الجيشِ عن قَصْدِهِ",17,"د",2,0],["بَل حَوابٍ في ظِلالِ فَسيلٍ","مُلِئَت أَجوافُهُنَّ عَصيرا",18,"ر",2,0],["بَلْ حَبَّذَا دَوْحَةٌ تَدْعُوالْهَدِيلَ بِهَا","عِنْدَ الصَّبَاحِ قَمَارِيٌّ بِأَطْوَاقِ",19,"ق",1,0],["بل حملتَ النَّعيَ الذي يَفطرُ القل","ب، ويَرمي بالشيب رأسَ الوليد",20,"د",1,0],["بِلِحاظِهِ سَيْفُ المَنُو","نِ مُجَرَّداً بِيَدِ الفُتُونِ",21,"ن",1,1],["بل حمرة الخد من أسياف مقلته","لأن من قتلت لوثته بدمه",22,"م",2,0],["بَل حَبَّذا طَيرٌ يَعومُ بِمائِها","طَوراً وَيَرعى النَّجمَ بِالصَّحراءِ",23,"ا",2,0],["بلحن ذاك الغزال","ما هذه النار تذكيها بأشعارك",24,"ك",1,0],["بِلَحظٍ مِثلِ نَصلِ السَيفِ ماضٍ","وَقَدٍّ كَاِعتِدالِ الغُصنِ لَدنِ",25,"ن",1,0],["بِلَحمِ ماعِزَةٍ كَالشِنِّ بالِيَةٍ","قَريبَةِ العَهدِ بِاللَأواءِ وَالبوسِ",26,"س",1,0],["بِلِحَاظِ نَرْجِسِهِ وَسَوْسَنِ ثَغْرِهِ","وَشَقِيقِ وَجْنَتِهِ الْمَنُوطِ بِخَالِ",27,"ل",1,0],["بَلْ حَرَّرُوا كُلَّ عَدْلٍ","مِنَ الْخِلاَفِ وَصَرْفِ",28,"ف",1,0],["بَلْ حَالُ مَنْ لَمْ يُقْلِعُوا عَنْ خَبِّهِمْ","وَتَمَكَّنَتْ خُدَعُ الْمُنَى مِنْ لُبِّهِمْ",29,"م",1,0],["بِلحظِكِ تقدحينَ زِنادَ قلبي","وتمنعني ثناياكِ النَّميرا",30,"ر",2,0],["بلحظك لا هجرت وأى لحظ","أَراقَ دمي وأي دم أَراقا",31,"ق",2,0],["بل حللت الفؤاد منّي فكانت","بك برداً نيرانهُ وَسلاما",32,"م",2,0],["بلحظةٍ تقتضِي مِنِّي مكارِمَهَا","هدِيَّةً لَكَ حازَ السبقَ مُهْدِيها",33,"ي",3,0],["بل حبّك صحتي ولكن غرضي","في سقمي أن اخفى عن العذال",34,"ل",1,0],["بل حياةٌ كاشَفَتهُ سِرَّها","فرَأَى مِن سرِّها كلَّ خَفِي",35,"ي",1,0],["بِلِحاظٍ وَيالَها مِن لِحَاظٍ","وَجَبينٍ ويا لَهُ مِن جَبينِ",36,"ن",1,0],["بلحاظو وبشرطو","ألا كان الشرط أملك",37,"ك",1,0],["بلحظ غير ذي سنة","وحظ غير منتبه",38,"ب",2,0],["بِلَحْظَةٍ منكَ يُثْنَى القِرْنُ مُنْعَفِراً","كأنَّ لَحْظَكَ فيه صارِمٌ خَذِمُ",39,"م",1,0],["بل حار في جودِكَ شكري ومَنْ","يملأ عينيهِ منَ الشمس",40,"س",1,0],["بِلَحمِهم قَد قَريتَ الوَحشَ تُطعِمُهُ","وَقلتَ يا وَحشُ أَقبلْ قُمْ هَلُمَّ وَجي",41,"ج",2,0],["بَل حَبانا بِساعَةٍ مِنه جُوداً","فَاِحتَظَينا بِأَبرَكِ السّاعاتِ",42,"ت",1,0],["بَل حَمَلوا بِجَمعهم لِلسُوقِ","فَشَرعوا الكَلامَ في الطَريق",43,"ق",1,0],["بلحاظ فاترات","ساهيات أهلكتني",44,"ن",2,0],["بل حبا ذو الفضل كلاًّ حظَّه","من ذوي التفسير مما قد أرادْ",45,"د",1,0],["بلحَاظ وقَوام","جرّدت ضرباً وطعناً",46,"ن",2,0],["بل حلة وردت نحوي ويوسفها","أنت العزيز على يعقوبك الدنف",47,"ف",1,0],["بلحيةٍ يضرط منها الشارب","ونكهةِ بنتنِها يعاقِبُ",48,"ب",1,0],["بلحاظه قلبي جريح مثخن","فالوصل يأسو والتجني ينكأ",49,"ا",1,0],["بلحاظ من البَديع مراض","نفثت في خلالها الاسحارا",50,"ر",2,0],["بلحنٍ حارَ إبراهيمُ فيه","ووزنٍ ليس يعرفه الخليلُ",51,"ل",1,0],["بلحظةٍ في الليل والنهار","في كل أطواري إلى الآثار",52,"ر",1,0],["بل حدثيها كم وقفتُ مناج