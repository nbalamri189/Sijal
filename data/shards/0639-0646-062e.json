{"poems":[[90,"مني إلى مصر ذات المجد والحسب","https://www.aldiwan.net/poem44801.html","البسيط"],[74,"عن خده منع الرقيب","https://www.aldiwan.net/poem18942.html","مجزوء الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21072","الخفيف"],[133,"حدث الشاعر عن نور القمر","https://www.aldiwan.net/poem60382.html","الرمل"],[333,"هات الدموع فأنت شاعر","https://www.aldiwan.net/poem55048.html","مجزوء الكامل"],[369,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[422,"يا إماما في الدين والمذهب الحق","https://www.aldiwan.net/poem54104.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86780","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59260","الرمل"],[1275,"","https://poetry.dctabudhabi.ae/diwan/poem/73508","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77271","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2798,"","https://poetry.dctabudhabi.ae/diwan/poem/144168","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127054","السريع"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85088","البسيط"],[3892,"","https://poetry.dctabudhabi.ae/diwan/poem/97708","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36588","الدوبيت"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36517","الدوبيت"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93270","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117309","البسيط"],[4755,"عَن نَكبَةٍ فِي عَامِهَا الثَّالِثِ","https://www.poetsgate.com/ViewPoem.aspx?id=191999",""],[4791,"لمع السيوف","https://www.poetsgate.com/ViewPoem.aspx?id=36904",""],[4866,"رمضان","https://www.poetsgate.com/ViewPoem.aspx?id=142236",""],[4119,"عن خاطري نبأ الخيال الخاطر","https://www.poetsgate.com/ViewPoem.aspx?id=16155",""],[5150,"إلى أختي ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203764",""],[5150,"أي قلب تملكين ...؟!","https://www.poetsgate.com/ViewPoem.aspx?id=203781",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5397,"أترع لي في سفحه الأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=157902",""],[5431,"نحن موتى وإنهم أحياء..","https://www.poetsgate.com/ViewPoem.aspx?id=202730",""],[5953,"لاح ضياء القمر الزاهر","https://www.poetsgate.com/ViewPoem.aspx?id=93849",""]],"verses":[["عن خالد بطل الأبطال يخبرنا","إذ فلّ جيش العدى بالقتل والهرب",0,"ب",1,0],["عن خدّه منع الرقيب","وبعده داجي عذاره",1,"ه",1,1],["عَن خَريفٍ سَقَاهُ نَوءٌ مِنَ الدَّل","وِ تَدَلَّى وَلم تُوارَ العَراقي",2,"ق",2,0],["عن خِداعٍ عن شَقاءٍ عن شَجا","عن فِراقٍ عن دُموعٍ عن سَهَر",3,"ر",1,0],["عن خافق صافي الوداد","كريق النور المشاع",4,"ع",1,0],["عن خَدِّ خَوْدٍ سافِرُ مُرّادُه","وقد زها بالنّرجس الغَضّ النّدي",5,"د",2,0],["عن خلوصٍ وعن ثبات اعتقاد","أوقَفَتْه ببابك الآمال",6,"ل",1,0],["عَن خادمٍ في إِقاماتٍ وَفي سَفَرٍ","بِمَدحك اِزداد مَجداً يَزدَهي أَبَدا",7,"د",2,0],["عَنْ خُزَامَى القَاعِ عَنْ زَهْرِ الرُّبَى","عَنْ نَبَاتِ الشِّيحِ عَنْ وَادِي الغَزَالْ",8,"ل",1,0],["عَن خاطِرٍ صَعبِ القِياد مَخاطِرٍ","مِن كَثرَةِ الأَوزارِ في وَسواسِ",9,"س",1,0],["عَن خُبثِها زَجَرَ الكَليمُ وَصِنوُهُ","وَنَهى مُحَمَّدُ وَالمَسيحُ وَمَريَمُ",10,"م",1,0],["عَن خَمسَةٍ وَنِصفِ أقصَى المَنتخِ","خَوفاً مِنَ الرِّيحِ الجَنُوبِي يَاأخِي",11,"ي",1,0],["عن خيرِ من يردي به متمطّرٌ","في يوم مكرُمةٍ ويومِ طِعانِ",12,"ن",1,0],["عن خطة الاذلال عزاًل ها","أبعدها اللّه وأقصاها",13,"ا",3,0],["عن خدها وثناياها وريقتها","تقاصر الورد والصهباء والحبب",14,"ب",1,0],["عَن خَيرِها نَسباً إِذا","نُصّت إِلى أَنسابِها",15,"ب",3,0],["عَن خَدِّكَ عَبَّروا بورد وَشَقيق","عَن نَكهتك اِكتَفوا بِمِسكٍ وَرَحيق",16,"ق",1,1],["عَن خَدِّك لَم يَقتَنِ طَرفٌ لَحظا","إِلّا حُرَقَ القَلب وَمن ذا اِتَّعَظا",17,"ظ",2,1],["عن خاطري نبأ الخيالِ الخاطرِ","فأعجب لزورةِ واصلٍ من هاجرِ",18,"ر",1,1],["عن خطب أمرى أصبحت لاهى","وعن فلاحي أصبحت ساهى",19,"ه",2,0],["عَن خطّةِ التَّحريرِ مِن راحِلٍ؟!","أَم عَن يَدِ التَّدمِير مِن مَاكِثِ؟!",20,"ث",1,0],["عن خطاك آتصدد والنواظر تشوف","وان حكو فيك عدوان الغلا ما اسمعي",21,"ع",2,0],["عن خطايا الغُرب يمّه والعشير","وبالصلاة وفي رضى الله اكتفا",22,"ف",2,0],["عن خاطري نبأ الخيال الخاطر","فاعجب لزورة واصل عن هاجر",23,"ر",1,1],["عن خلودِ النفسِ عن صدقِ الوفا","عن صداهُ.. عن فتاةٍ لن تخونَهْ",24,"ن",2,0],["عن خمورِ الرِّيقِ عن خمرِ الهوى","حدَّثوا عن خمرةٍ تشفي الأنينْ",25,"ن",1,0],["عن خد زينب والريحان يمسحه","عن عينها نرجس البستان يغضيها",26,"ي",3,0],["عن خوضه الكوثر أعدائه","يوم الجزا خاسئة ترجع",27,"ع",1,0],["عن خطايايَ أسألُ الله دوما !!","ماذنوبي؟...لعلتي مالشفاءُ؟!!",28,"ا",2,0],["عن خامس الحجب أب جعفر","عالم كنه الغيب والباقر",29,"ر",1,0]]}