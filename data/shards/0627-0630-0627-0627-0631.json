.dctabudhabi.ae/diwan/poem/54279","الطويل"],[45,"لا الدّهرُ مُستَنفَدٌ، وَلاَ عَجَبُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31555",""],[45,"ألَمّتْ، وَهَلْ إلمامُها لكَ نَافِعُ","https://www.poetsgate.com/ViewPoem.aspx?id=31221",""],[91,"1931","https://www.poetsgate.com/ViewPoem.aspx?id=53444",""],[133,"يقال للشمس الكسوف والخسوف","https://www.aldiwan.net/poem54661.html","الرجز"],[142,"وتعجبني الغصون إذا تثنت","https://www.aldiwan.net/poem2365.html","عموديه"],[143,"أى لبيب بك لم يخدع","https://www.aldiwan.net/poem58407.html","السريع"],[161,"كما كان إسماعيل يحيى به يحيا","https://www.aldiwan.net/poem58823.html","الطويل"],[230,"ما قال أوه لفقده واها","https://www.aldiwan.net/poem51256.html","المنسرح"],[238,"لئن غربت شمس تبدت من الشرق","https://www.aldiwan.net/poem19521.html","الطويل"],[250,"تناهيت عن ذكر الصبابة فاحكم","https://www.aldiwan.net/poem2094.html","الطويل"],[257,"هذا وأيام أكلي","https://www.aldiwan.net/poem48494.html","المجتث"],[271,"هو الملك تبنيه الجيوش الخضارم","https://www.aldiwan.net/poem35646.html","الطويل"],[281,"أعطى الشباب من الآراب ما طلبا","https://www.aldiwan.net/poem60775.html","البسيط"],[283,"دع الأثلات وآرام رامه","https://www.aldiwan.net/poem32456.html","المتقارب"],[298,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[323,"لقد واصلت سلمى في ليال","https://www.aldiwan.net/poem56357.html","الوافر"],[338,"أتعرف رسما دارسا قد تغيرا","https://www.aldiwan.net/poem45431.html","الطويل"],[339,"يا من ترفع للدنيا وزينتها","https://www.aldiwan.net/poem68606.html","البسيط"],[339,"إذا أروت الأرض أسيافهم","https://www.aldiwan.net/poem68739.html","المتقارب"],[365,"من كان فوق سراة المجد معتليا","https://www.aldiwan.net/poem60558.html","البسيط"],[404,"خلعت ردا التشبيب عن منكب الفكر","https://www.aldiwan.net/poem33905.html","الطويل"],[406,"إذا أرتجت أبواب قوم أراذل","https://www.aldiwan.net/poem49421.html","الطويل"],[433,"لي في المصيف طريق","https://www.aldiwan.net/poem12420.html","المجتث"],[433,"طوبى لمن ترك اللذات وازدجرا","https://www.aldiwan.net/poem12464.html","البسيط"],[440,"كذا تتجلى الشمس بعد كسوفها","https://www.aldiwan.net/poem34867.html","الطويل"],[442,"أريحي الوجا يا ناق ما بعد ذا وجا","https://www.aldiwan.net/poem14299.html","الطويل"],[459,"لعل لها مع النسرين سرا","https://www.aldiwan.net/poem56198.html","الوافر"],[462,"أأهجع أم آوي إلى لين مرقد","https://www.aldiwan.net/poem15111.html","الطويل"],[462,"ولينة الأعطاف خوارة","https://www.aldiwan.net/poem16084.html","السريع"],[467,"ألا رب راج حاجة لا ينالها","https://www.aldiwan.net/poem50421.html","الطويل"],[471,"ودعتهن ولا شيء يراجعني","https://www.aldiwan.net/poem4819.html","البسيط"],[478,"عليل الوجد عندك لا يعاد","https://www.aldiwan.net/poem15313.html","الوافر"],[499,"بقلبك يا غافلاً فانظر","https://www.aldiwan.net/poem3702.html","المتقارب"],[549,"إذا أرملوا زادا عقرتُ مطيةً","https://www.aldiwan.net/poem1185.html",""],[552,"أمن أجل من سارت بهن الأباعر","https://www.aldiwan.net/poem47825.html","الطويل"],[559,"إن المعشرات أحرف الهجا","https://www.aldiwan.net/poem33530.html","الرجز"],[559,"قد صرت كلي قلوبا فيه تحتار","https://www.aldiwan.net/poem34523.html","البسيط"],[563,"عليك كل اعتمادي أيها الصمد","https://www.aldiwan.net/poem52823.html","البسيط"],[563,"كادت تذوب ثغور البحر من حسد","https://www.aldiwan.net/poem52927.html","البسيط"],[563,"فدى الجلابيب والأطمار من وبر","https://www.aldiwan.net/poem52941.html","البسيط"],[576,"نسيم ربعك أفديه بأنفاسي","https://www.aldiwan.net/poem3057.html","البسيط"]],"verses":[["إِذا أَرعَدوا يَوماً لَنا بِوَعيدِهِم","عَلى النَأيِ أَبرَقنا لَهُم بِالصَوارِمِ",0,"م",1,1],["إِذا أَرعى بِأَرضٍ لَم تَجِدهُ","يُشارِكُ في الجِمامِ وَفي الجَميمِ",1,"م",1,0],["إِذا أَرادَ قَولَ لا","مِن سُكرِهِ قالَ نَعَم",2,"م",1,0],["إذا ارْتَكَضَ الكَرى في مُقْلتَيْهِ","أقَضَّ على جَوانِحِهِ المِهادُ",3,"د",1,0],["إِذا أَرَدتُ سُلُوّاً كانَ ناصِرَكُم","قَلبي وَما أَنا مِن قَلبي بمُنتَصِرِ",4,"ر",1,0],["إِذا أَرسَلتَ في أَمرٍ رَسولاً","فَأَفهِمهُ وَأَرسِلهُ أَديبا",5,"ب",2,1],["إِذا أَرادَ لَها تَركاً تَقَعَّدَهُ","كَما تَقَعَّدَ ساقَ الموثَقِ الطِوَلُ",6,"ل",1,0],["إِذا أَرِجَ الثَناءُ الرَوعُ مِنها","فَكَم لِلمِسكِ عَنهُ مِنِ اِفتِضاحِ",7,"ح",1,0],["إذا أردت لو صف الاقحوان فقل","كأنما هو ثغر فيه دينار",8,"ر",1,1],["إِذا اِرفَضَّ أَطرافُ السِياطِ وَهُلِّلَت","جُرومُ المَطايا عَذَّبَتهُنَّ صَيدَحُ",9,"ح",1,0],["إِذا أَرادَ اِنكِراساً فيهِ عَنَّ لَهُ","دونَ الأًرومَةِ مِن أَطنابِها طُنُبُ",10,"ب",1,0],["إذا أرتوت البلاد بفيض علم","فعاجز أهلها يُمسى قديرا",11,"ر",2,0],["إذا أرضنا كانت سماءً لغيرها","فما من عروج بل نزول إلى القعر",12,"ر",1,0],["إِذا أَرسَلَت كَفُّ الوَليدِ كِعامَهُ","يَمُجُّ سُلافاً مِن رَحيقٍ مُعَطَّبِ",13,"ب",1,0],["إِذا أَروَوا بِها زَرعاً وَقَضباً","أَمالوها عَلى خورٍ طِوالِ",14,"ل",1,0],["إِذا آرِقٌ أَفنى مِنَ اللَيلِ ما مَضى","تَمَطّى بِهِ ثِنيٌ مِنَ اللَيلِ راجِحُ",15,"ح",1,0],["إِذا اِرتَحَلوا مِن مَنزِلٍ خِلتَ أَنَّهُ","مُدَمَّنُ أَهلِ المَوسِمِ المُتَعارِكِ",16,"ك",1,0],["إذا أراد قبولَ البرِّ خالقنا","هيا نوافلهُ في وقت إحواج",17,"ج",1,0],["إذا ارتأى للملوك في هَنَةٍ","أَشهدهُمْ كلَّ ما هُمُ غَيَبُهْ",18,"ب",2,0],["إذا ارتأى تبعت آثارُه سدداً","لا كالذي يتبع الآثار مقتافا",19,"ف",2,0],["إذا أراد الكرى توسدها","فقد كفته مكان مرفقته",20,"ت",2,0],["إذا ارتدى السيف لم يُمسكْ بقائمهِ","ليستقلَّ ولم يخططْ بسافلِهِ",21,"ل",2,0],["إذا ارتضعَ الدنيا أخو اللؤم وحْدَهُ","فذاك رضاعٌ مؤذِنٌ بفِصالِ",22,"ل",1,0],["إذا ارتأى خلتَهُ هناك يرى","وهْو كمن يَرْتَئى إذا رَجَمَا",23,"م",2,0],["إذا ارتأى الرأي في خَطْبٍ أُتيحَ له","فيه السدادُ بفكرٍ أو بإلهامِ",24,"م",1,0],["إِذا أَرَنَّ عَلَيها طارِداً نَزَقَت","فَالفَوتُ إِن فاتَ هادي الصَدرِ وَالكَنَدُ",25,"د",1,0],["إِذا أَرادَ سِوى أَطهارِها اِمتَنَعَت","مِنهُ سَراعيفُ أَمثالُ القَنا قودُ",26,"د",1,0],["إِذا أَرادَ بِها التَغميضَ أَرَّقَهُ","سَيلٌ يَدِبُّ بِهَدمِ التُربِ مَوّارِ",27,"ر",1,0],["إِذا اِرتَحلوا أَصَمَّ كُلَّ مُؤَيَّهٍ","وَكُلِّ مُهيبٍ نَقرُهُ وَصَواهِلُه",28,"ل",2,0],["إِذا اِرتَفَعَ الطَرفُ في جَوِّها","رَأى مِن عَجاجَتِها هِندِبا",29,"ب",2,0],["إِذا أَرَدتُ السَيرَ في مِنهاجي","طالَ عِثاري فيه وَاِنزِلاجي",30,"ج",2,0],["إِذا أَرسَلتَ قافِيَةً شَروداً","فَقَد أَيقَظتَ في الناسِ الشُكوكا",31,"ك",2,0],["إِذا اِرتَدى المَرءُ ما في الأَرضِ مِن بُرُدٍ","وَعافَ لِلدينِ بُرداً عادَ عُريانا",32,"ن",2,0],["إِذا أَرهَنَتهُ المَينَ شَدَّةُ ماجِدٍ","فَوَرَّعَها القَومُ الأُلى ثُمَّ ماصَعوا",33,"ع",3,0],["إِذا اِرتَعنَ أَو فُزّعنَ قُمنَ حَوالَها","قِيامَ بَناتِ الماءِ في جانِبِ الضَحلِ",34,"ل",1,0],["إِذا أَرَدتُ عَدَّها لَم تُعدَدِ","وَإِن ذَكَرتُ فَضلَهُ لَم يَنفَدِ",35,"د",1,0],["إِذا أَرَدتُ كُمَيتَ اللَونِ صافِيَةً","وَجَدتُها وَحَبيبُ النَفسِ مَفقودُ",36,"د",1,0],["إِذا اِرتَقَبوا صُبحاً رَأَوا قَبلَ ضَوإِهِ","كَتائِبَ لا يَردِ الصَباحُ كَما تَردي",37,"د",2,0],["إذا أرواحنا بالطبخ يوماً","غلظنَ فذلك العسل الثخين",38,"ن",1,1],["إِذا ارتوتْ من مائِها أسبلتْ","جفونُها بالواكفِ الصَّيِّبِ",39,"ب",1,0],["إِذا أَرابَ الزَمانُ مُعتَمِداً","إِنكاسُ حَذّي سَأَلتُ ما أَرَبُه",40,"ب",2,0],["إِذا أَرَدتَ مَلَأتَ العَينَ مِن بَلَدٍ","مُستَحسَنٍ وَزَمانٍ يُشبِهُ البَلَدا",41,"د",2,0],["إِذا اِرتَقى في أَعالي الرَأيِ لاحَ لَهُ","ما في الغُيوبِ الَّتي تَخفى فَتَستَتِرُ",42,"ر",1,0],["إِذا أَرادَ مُريدٌ عَدَّ أَنعُمِهِ","أَبى نَوالٌ عَلى العافينَ مَفضوضُ",43,"ض",1,0],["إِذا اِرتَفَعوا في هَضبَةٍ وَجَدوا أَبا","عَلِيِّهِمِ أَعلى مَكاناً وَأَرفَعا",44,"ع",2,0],["إِذا أَرَدتُ لِراقي الدَمعِ مُنحَدَراً","ذَكَرتُ مُرتَبَعاً فيها وَمُصطافا",45,"ف",2,0],["إِذا أَرسَلَت طَيفاً يُذَكِّرُني الجَوى","رَدَدتُ إِلَيها بِالنَجاحِ رَسولَها",46,"ل",3,0],["إِذا اِرتَدى بِنِجادِ السَيفِ عاتِقُهُ","قُلتَ الحَمائِلُ قَد نيطَت عَلى جَبَلِ",47,"ل",1,0],["إِذا اِرتَدَّ يَومُ الحَربِ لَيلاً رَدَدتَهُ","نَهاراً بِلَألاءِ السُيوفِ الصَوارِمِ",48,"م",1,0],["إِذا أَرَدنا وَرَدنا بَحرَ نائِلِهِ","فَنَوَّلَتنا يَداهُ مِلءَ أَيدينا",49,"ن",2,0],["إِذا اِرتَدَّ صَمتاً فَالرُؤوسُ نَواكِسٌ","وَإِن قالَ فَالأَعناقُ صورٌ خَواضِعُ",50,"ع",1,0],["إِذا اِرتَفَقَ المُشتاقُ كانَ سُهادُهُ","أَحَقَّ بِجَفنَي عَينِهِ مِن هُجوعِهِ",51,"ع",2,0],["إِذا اِرتَجَلَت شَقَّت عَلَيها وَإِن تَنُخ","يَكُن مِن غَرامِ اللَهِ عَنها نُزولُها",52,"ل",3,0],["إذا ارتدَتْها اللُّجَجُ الزَّواخِرُ","وَضَمَّها مِثلَ المِرَاةِ مائرُ",53,"ر",1,0],["إذا ارتدى مُهجةَ الكَميِّ غَدا","مُضرَّجاً من جِسادِهِ جَسَدُه",54,"د",2,0],["إذا ارتمَتْ بالشَّرارِ واطَّرَدَتْ","على ذُراها مَطاردُ اللَّهَبِ",55,"ب",1,0],["إِذا أَرَدتَ شَريفَ الناسِ كُلَّهُمُ","فَاِنظُر إِلى مَلِكٍ في زِيِّ مَسكينِ",56,"ن",1,0],["إِذا أَرضى مَسامِعُنا بِشَدوٍ","تُجاوِبُهُ البَلابِلُ وَالقُماري",57,"ر",2,0],["إذا ارتكسنا إغاثتنا مَغاوينا","أوِ ارتكضنا أقلَّتنا مَذاكينا",58,"ن",2,0],["إِذا اِرتَجَعَت أَيدي اللَيالي هِاتِها","فَغايَةُ هاتيكَ الهِباتِ ذَهابُ",59,"ب",1,0],["إِذا اِرتَحَلَت نَحوَ اليَمامَةِ رُفقَةٌ","دَعاكَ الهَوى وَاِهتاجَ قَلبُكَ لِلذِكرِ",60,"ر",1,0],["إِذا أَرَدنَ كَلامي عِندَهُ اِعتَرَضَت","مِن دُونِهِ عَبَراتٌ فَاِنثَنى الكَلِمُ",61,"م",1,0],["إِذا اِرتَفَقَت فَوقَ الفِراشِ تَخالَها","تَخافُ اِنبِتاتَ الخَصرِ ما لَم تَشَدَّدِ",62,"د",1,0],["إِذا أَرادَ فِتنَةً لا يُجتَرى","خَوفاً وَيُبدي غَيرَ ذاكَ وَيَرى",63,"ر",2,0],["إِذا أَرَدتَ الشُربَ عِندَ الفَجرِ","وَالنَجمُ في لُجَّةِ لَيلٍ يَسري",64,"ي",1,0],["إِذا اِرتَعَشَت يُمناهُ بِالكَأسِ رَقَّصَت","بِهِ ساعَةً حَتّى يُسَكِّنَها الشُربُ",65,"ب",1,0],["إذا أرْزَمَتْ فيه المَهاري ولم يُجِبْ","حُوَارٌ أجابَتْ عنه أصداءُ هامهِ",66,"م",2,0],["إذا أَرنَّتْ بغمزِ لافظِها","قلتَ حمامٌ يُجيبُهنَّ حَمُ",67,"م",1,0],["إذا أردت بأَصل الكَون معرفة","فاِرجع بفكرك أَدراجاً إلى الأزل",68,"ل",1,0],["إذا ارتقبوا صبحاً رأوا قبل ضوئه","كتائب لا يردي الصّباح كما تردي",69,"د",2,0],["إِذَا ارْتَأَى بَدَرَتْ أَنْوَارُ حِكْمَتِهِ","كَمَا تَطَايَرَ بَعْدَ الْقَدْحَةِ الشَّرَرُ",70,"ر",1,0],["إِذَا ارْتَابَ أَمْرَاً أَلْهَبَتْهُ حَفِيظَةٌ","تُمِيتُ الرِّضَا بِالسُّخْطِ وَالحِلْمَ بِالْجَهْلِ",71,"ل",1,0],["إِذا أَرَتْكَ الجِبالُ الغِيدَ كاسِيَةً","فالشَّطُّ أَذْوَقُ مِنْها حينَ عَرَّاها",72,"ا",3,0],["إِذا أَرْسَلَتْ أَلْحانَها في خَمِيلةٍ","تَوثَّبَ زَهْرُ الرَّوْضِ واهْتَزّ عاطِرُه",73,"ر",2,0],["إذا أراب الزّمَانُ، مُعْتَمِداً،","إنكَاسَ حَظّي سألتُ مَا أرَبُهْ",74,"ب",2,0],["إذا ارْتَدّ صَمْتاً فالرّوءسُ نَوَاكِسٌ،","وإنْ قَالَ فالأعناقُ صُورٌ خَوَاضِعُ",75,"ع",1,0],["إذا ارتفع الطرف في جوّها","رأى من عجاجتها هيدبا",76,"ب",2,0],["إِذَا أرَدتَهَا فَهِىَّ رَكعتَان","لَهَا والرُّكُوعُ مَرَّتَان",77,"ن",1,0],["إذا ارتجت نهودٌ في قدودٍ","فقل للحلم قد ذهب الوقار",78,"ر",1,0],["إذا ارتقتْ أقلامهُ كفَّه","تهزّأت بالخاطبِ المِصقَعِ",79,"ع",1,0],["إذا أرشد الأعداء نادت بغمدها","إلهي بدّلهم برشدهم غيّا",80,"ي",2,0],["إذا أرادت مزاجها جعلت","بآخر اللحظ في فمي فاها",81,"ا",3,0],["إِذَا أَرْشَدَ الْخَلاَّقُ جَلَّ امْرَءً إِلَى","سَعِيدٍ فَذَاكَ الْمَرْءُ مِنْ أَسْعَدِ الْخَلْقِ",82,"ق",1,0],["إِذا أَرقَلَت كَأَنَّ أَخطَبَ ضالَةٍ","عَلى خَدِبِ الأَنيابِ لَم يَتَثَلَّمِ",83,"م",1,0],["إذا أرادت تعشى","تنعصت لي بفار",84,"ر",1,0],["إذا ارتَفَعت فوق الكَتيبةِ رَفرفت","كما رَفرفت فوقَ الغُصونِ الحمائم",85,"م",1,0],["إِذا أَرَدْتُ أَفاءَتْنِي عَواطِفُهُ","ظِلاًّ يُريحُ لِيَ الْحَظِّ الَّذِي عَزَبا",86,"ب",2,0],["إِذا اِرتَجَّ في خَدِّهِ الجُلَّنار","فَفي ثَغرِهِ لِلأَقاحِ اِبتِسامَه",87,"م",2,0],["إذا أَردت تصنعُ","خَيراً بشخصٍ منَعوا",88,"ع",3,0],["إِذا اِرتَجَّت رَوادِفُها تَهادَت","مُبَتَّلَةً شَواها غَيرُ حُمشِ",89,"ش",1,0],["إِذا اِرتَدَفاها بَعدَ طولِ هِبابِها","أَبَسّا بِها مِن خَشيَةٍ ثُمَّ قَرقَرا",90,"ر",2,0],["إِذا أَرَدتَ شَريفَ القَومِ كُلّهم","فَاِنظُر إِلى ملكٍ في زِيِّ مِسكينِ",91,"ن",1,0],["إِذا أَروَتِ الأَرضَ أَسيافُهُم","مِنَ الدَمِّ خِلتَ سَحاباً هَمَع",92,"ع",1,1],["إذا أردتَ إلى سَعدِ الوَرى نَظَراً","فكنْ لوَجْهِك في المِرآةِ مُجتليا",93,"ي",2,0],["إذا ارتشفت من كأسهن مسامعي","جلبن الهوى من حيث أدري ولا أدري",94,"ر",2,0],["إذا أرتِجَت أبوابُ قومٍ أراذلٍ","فبابُكَ مفتوحٌ لنا غير مُرتَجِ",95,"ج",1,1],["إِذا ارْتَمَى بِشرارِ السَّ","مومِ في الخافِقَيْنِ",96,"ن",1,0],["إذا ارتقى في أعالي الرأيِ لاح له","ما في العيونِ إذاً عن غيره استترا",97,"ر",2,0],["إِذَا أُرْسِلَتْ فِيهَا العُيُونُ تَشَكَّلَتْ","نواظِرُها فِي سَيْرِها وَوُقُوفِها",98,"ف",3,0],["إذا أرتجت أبوب خلقك خالقي","فبابك مفتوح وما ليس مرتجى",99,"ج",2,0],["إذا أرسِلنَ في الحاجات خَطْباً","حَبَوْنَك ثيِّباً منها وبِكرا",100,"ر",2,0],["إذا ارتفقوا كان القيامُ تخادماً","أمام سرير المُلْك فخر المُسوَّدِ",101,"د",1,0],["إذا أُريحَتْ خِلْتَها والِهاً","ثكْلى لها منْ حُزْنها أوْلَقُ",102,"ق",1,0],["إِذا أَرسَلوني عِندَ تَقديرِ حاجَةٍ","أُمارِسُ فيها كُنتُ نِعمَ المُمارِسُ",103,"س",1,0],["إِذا أَرَدنَ كَلامي عِندَهُ عَرَضَت","مِن دونِهِ عَبَراتٌ فَارعَوى الكَلِمُ",104,"م",1,0],["اِذا أرسلتُهنَّ رأيتُ سَحّاً","عِهادُ الدمعِ يتبعُه عِهادُ",105,"د",1,0],["إِذا أُرسِل الطَرفُ هامَ الفُؤاد","وَبَعض المَرائي عَمى البَصَر",106,"ر",1,0],["إِذا أَرمَلوا زاداً عَقَرتُ مَطيَّةً","تَجُرُّ بِرِجلَيها السَريحَ المُخَدَّما",107,"م",2,1],["إِذا أَرسلتْ في الخيلِ تَعدو إلى مدىً","تُحاضرُ حتّى لا ترى مَن تحاضِرُ",108,"ر",1,0],["إذا أراد الشيء قال كن له","فإنه يكون يعني بالدعا",109,"ا",1,0],["إذا أراد بدا ذاك المراد به","كما يريد وكانت منه أغيار",110,"ر",1,0],["إذا أَرَدنا سِوى مَلْجَاكَ ليسَ نَرَى","وإنْ طَلَبنا سِوى جَدْواكَ لا نَجِدُ",111,"د",1,0],["إذا أردتَ لهُ توجيهَ مَكرُمةٍ","فقُلْ قَبِلتُكَ لي عَبداً ولا تَزِدِ",112,"د",1,0],["إذا أردتَ الظِبَا اللآلي عهدتَ لها","نوافجَ المسكِ فاطلُبْها من القِفَرِ",113,"ر",1,0],["إِذا أَرَدْتَ ترى الأَقْدَارَ جَاريَةً","فانظر له قَلَماً مِنْ فَوقِ قِرْطَاس",114,"س",1,0]]}