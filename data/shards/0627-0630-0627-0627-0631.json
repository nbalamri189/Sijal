30,"","https://poetry.dctabudhabi.ae/diwan/poem/122275","الرجز"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59504","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135261","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101376","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81272","المتقارب"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83196","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83192","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58179","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120416","المقتضب"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120240","المتقارب"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139549",""],[4691,"للاحق يُنشدُ الشعر .. إخوانية","https://www.poetsgate.com/ViewPoem.aspx?id=88158",""],[4755,"هذا السَّرَابُ القائِمُ القاعِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=183630",""],[4884,"عزائي للهوى","https://www.poetsgate.com/ViewPoem.aspx?id=201771",""],[585,"أجل إنه الفجر الذي أنت آمله","https://www.poetsgate.com/ViewPoem.aspx?id=161921",""],[5106,"الطَّيَِبُوْنَ .. شَرِبْنَا المِسْكَ وَالصَ","https://www.poetsgate.com/ViewPoem.aspx?id=148667",""],[5183,"عُلْيَا المَناَصِب","https://www.poetsgate.com/ViewPoem.aspx?id=186458",""],[5183,"الطعنة النجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180183",""],[5185,"استر عيوبك ( إلى إخواني المرابطين في الجبل الأحمر)","https://www.poetsgate.com/ViewPoem.aspx?id=118680",""],[5186,"تسآءلني فتاة الحي ما بي","https://www.poetsgate.com/ViewPoem.aspx?id=156495",""],[5224,"حبيبي أنت ذو منٍّ وجودِ","https://www.poetsgate.com/ViewPoem.aspx?id=121310",""],[1059,"أجيرة قلبي إن تدانوا وإن شطوا","https://www.poetsgate.com/ViewPoem.aspx?id=108380",""],[5431,"وقفة عزّ...","https://www.poetsgate.com/ViewPoem.aspx?id=207555",""],[5431,"وحقك لاتعتب....","https://www.poetsgate.com/ViewPoem.aspx?id=214590",""],[5459,"سلعة بائرة","https://www.poetsgate.com/ViewPoem.aspx?id=211767",""],[5685,"في رثاء زايد الخير","https://www.poetsgate.com/ViewPoem.aspx?id=34735",""],[5720,"أَهْلُ الْبِر","https://www.poetsgate.com/ViewPoem.aspx?id=206964",""],[5759,"نشيدُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=214175",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[6031,"أَلا تَسْتنطقُ الدِمَنَ الخَوَالي","https://www.poetsgate.com/ViewPoem.aspx?id=46291",""],[6093,"جيل من ذهب","https://www.poetsgate.com/ViewPoem.aspx?id=205227",""],[6093,"ومن عجب أقيك وأتقيكا","https://www.poetsgate.com/ViewPoem.aspx?id=205486",""],[6102,"هاتِف","https://www.poetsgate.com/ViewPoem.aspx?id=185295",""],[5309,"قالت جماعة مغرورين نحن هنا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573901",""],[186,"نسيمات نجد هل تحملت من نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55747&r=&rc=10",""],[5126,"مرفوعة إلى صاحب الجلالة الملك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87829&r=&rc=44",""],[5567,"حوادم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69069&r=&rc=7",""]],"verses":[["إِذا أَرعَدوا يَوماً لَنا بِوَعيدِهِم","عَلى النَأيِ أَبرَقنا لَهُم بِالصَوارِمِ",0,"م",1,1],["إِذا أَرعى بِأَرضٍ لَم تَجِدهُ","يُشارِكُ في الجِمامِ وَفي الجَميمِ",1,"م",1,0],["إِذا أَرادَ قَولَ لا","مِن سُكرِهِ قالَ نَعَم",2,"م",1,0],["إذا ارْتَكَضَ الكَرى في مُقْلتَيْهِ","أقَضَّ على جَوانِحِهِ المِهادُ",3,"د",1,0],["إِذا أَرَدتُ سُلُوّاً كانَ ناصِرَكُم","قَلبي وَما أَنا مِن قَلبي بمُنتَصِرِ",4,"ر",1,0],["إِذا أَرسَلتَ في أَمرٍ رَسولاً","فَأَفهِمهُ وَأَرسِلهُ أَديبا",5,"ب",2,1],["إِذا أَرادَ لَها تَركاً تَقَعَّدَهُ","كَما تَقَعَّدَ ساقَ الموثَقِ الطِوَلُ",6,"ل",1,0],["إِذا أَرِجَ الثَناءُ الرَوعُ مِنها","فَكَم لِلمِسكِ عَنهُ مِنِ اِفتِضاحِ",7,"ح",1,0],["إذا أردت لو صف الاقحوان فقل","كأنما هو ثغر فيه دينار",8,"ر",1,1],["إِذا اِرفَضَّ أَطرافُ السِياطِ وَهُلِّلَت","جُرومُ المَطايا عَذَّبَتهُنَّ صَيدَحُ",9,"ح",1,0],["إِذا أَرادَ اِنكِراساً فيهِ عَنَّ لَهُ","دونَ الأًرومَةِ مِن أَطنابِها طُنُبُ",10,"ب",1,0],["إذا أرتوت البلاد بفيض علم","فعاجز أهلها يُمسى قديرا",11,"ر",2,0],["إذا أرضنا كانت سماءً لغيرها","فما من عروج بل نزول إلى القعر",12,"ر",1,0],["إِذا أَرسَلَت كَفُّ الوَليدِ كِعامَهُ","يَمُجُّ سُلافاً مِن رَحيقٍ مُعَطَّبِ",13,"ب",1,0],["إِذا أَروَوا بِها زَرعاً وَقَضباً","أَمالوها عَلى خورٍ طِوالِ",14,"ل",1,0],["إِذا آرِقٌ أَفنى مِنَ اللَيلِ ما مَضى","تَمَطّى بِهِ ثِنيٌ مِنَ اللَيلِ راجِحُ",15,"ح",1,0],["إِذا اِرتَحَلوا مِن مَنزِلٍ خِلتَ أَنَّهُ","مُدَمَّنُ أَهلِ المَوسِمِ المُتَعارِكِ",16,"ك",1,0],["إذا أراد قبولَ البرِّ خالقنا","هيا نوافلهُ في وقت إحواج",17,"ج",1,0],["إذا ارتأى للملوك في هَنَةٍ","أَشهدهُمْ كلَّ ما هُمُ غَيَبُهْ",18,"ب",2,0],["إذا ارتأى تبعت آثارُه سدداً","لا كالذي يتبع الآثار مقتافا",19,"ف",2,0],["إذا أراد الكرى توسدها","فقد كفته مكان مرفقته",20,"ت",2,0],["إذا ارتدى السيف لم يُمسكْ بقائمهِ","ليستقلَّ ولم يخططْ بسافلِهِ",21,"ل",2,0],["إذا ارتضعَ الدنيا أخو اللؤم وحْدَهُ","فذاك رضاعٌ مؤذِنٌ بفِصالِ",22,"ل",1,0],["إذا ارتأى خلتَهُ هناك يرى","وهْو كمن يَرْتَئى إذا رَجَمَا",23,"م",2,0],["إذا ارتأى الرأي في خَطْبٍ أُتيحَ له","فيه السدادُ بفكرٍ أو بإلهامِ",24,"م",1,0],["إِذا أَرَنَّ عَلَيها طارِداً نَزَقَت","فَالفَوتُ إِن فاتَ هادي الصَدرِ وَالكَنَدُ",25,"د",1,0],["إِذا أَرادَ سِوى أَطهارِها اِمتَنَعَت","مِنهُ سَراعيفُ أَمثالُ القَنا قودُ",26,"د",1,0],["إِذا أَرادَ بِها التَغميضَ أَرَّقَهُ","سَيلٌ يَدِبُّ بِهَدمِ التُربِ مَوّارِ",27,"ر",1,0],["إِذا اِرتَحلوا أَصَمَّ كُلَّ مُؤَيَّهٍ","وَكُلِّ مُهيبٍ نَقرُهُ وَصَواهِلُه",28,"ل",2,0],["إِذا اِرتَفَعَ الطَرفُ في جَوِّها","رَأى مِن عَجاجَتِها هِندِبا",29,"ب",2,0],["إِذا أَرَدتُ السَيرَ في مِنهاجي","طالَ عِثاري فيه وَاِنزِلاجي",30,"ج",2,0],["إِذا أَرسَلتَ قافِيَةً شَروداً","فَقَد أَيقَظتَ في الناسِ الشُكوكا",31,"ك",2,0],["إِذا اِرتَدى المَرءُ ما في الأَرضِ مِن بُرُدٍ","وَعافَ لِلدينِ بُرداً عادَ عُريانا",32,"ن",2,0],["إِذا أَرهَنَتهُ المَينَ شَدَّةُ ماجِدٍ","فَوَرَّعَها القَومُ الأُلى ثُمَّ ماصَعوا",33,"ع",3,0],["إِذا اِرتَعنَ أَو فُزّعنَ قُمنَ حَوالَها","قِيامَ بَناتِ الماءِ في جانِبِ الضَحلِ",34,"ل",1,0],["إِذا أَرَدتُ عَدَّها لَم تُعدَدِ","وَإِن ذَكَرتُ فَضلَهُ لَم يَنفَدِ",35,"د",1,0],["إِذا أَرَدتُ كُمَيتَ اللَونِ صافِيَةً","وَجَدتُها وَحَبيبُ النَفسِ مَفقودُ",36,"د",1,0],["إِذا اِرتَقَبوا صُبحاً رَأَوا قَبلَ ضَوإِهِ","كَتائِبَ لا يَردِ الصَباحُ كَما تَردي",37,"د",2,0],["إذا أرواحنا بالطبخ يوماً","غلظنَ فذلك العسل الثخين",38,"ن",1,1],["إِذا ارتوتْ من مائِها أسبلتْ","جفونُها بالواكفِ الصَّيِّبِ",39,"ب",1,0],["إِذا أَرابَ الزَمانُ مُعتَمِداً","إِنكاسُ حَذّي سَأَلتُ ما أَرَبُه",40,"ب",2,0],["إِذا أَرَدتَ مَلَأتَ العَينَ مِن بَلَدٍ","مُستَحسَنٍ وَزَمانٍ يُشبِهُ البَلَدا",41,"د",2,0],["إِذا اِرتَقى في أَعالي الرَأيِ لاحَ لَهُ","ما في الغُيوبِ الَّتي تَخفى فَتَستَتِرُ",42,"ر",1,0],["إِذا أَرادَ مُريدٌ عَدَّ أَنعُمِهِ","أَبى نَوالٌ عَلى العافينَ مَفضوضُ",43,"ض",1,0],["إِذا اِرتَفَعوا في هَضبَةٍ وَجَدوا أَبا","عَلِيِّهِمِ أَعلى مَكاناً وَأَرفَعا",44,"ع",2,0],["إِذا أَرَدتُ لِراقي الدَمعِ مُنحَدَراً","ذَكَرتُ مُرتَبَعاً فيها وَمُصطافا",45,"ف",2,0],["إِذا أَرسَلَت طَيفاً يُذَكِّرُني الجَوى","رَدَدتُ إِلَيها بِالنَجاحِ رَسولَها",46,"ل",3,0],["إِذا اِرتَدى بِنِجادِ السَيفِ عاتِقُهُ","قُلتَ الحَمائِلُ قَد نيطَت عَلى جَبَلِ",47,"ل",1,0],["إِذا اِرتَدَّ يَومُ الحَربِ لَيلاً رَدَدتَهُ","نَهاراً بِلَألاءِ السُيوفِ الصَوارِمِ",48,"م",1,0],["إِذا أَرَدنا وَرَدنا بَحرَ نائِلِهِ","فَنَوَّلَتنا يَداهُ مِلءَ أَيدينا",49,"ن",2,0],["إِذا اِرتَدَّ صَمتاً فَالرُؤوسُ نَواكِسٌ","وَإِن قالَ فَالأَعناقُ صورٌ خَواضِعُ",50,"ع",1,0],["إِذا اِرتَفَقَ المُشتاقُ كانَ سُهادُهُ","أَحَقَّ بِجَفنَي عَينِهِ مِن هُجوعِهِ",51,"ع",2,0],["إِذا اِرتَجَلَت شَقَّت عَلَيها وَإِن تَنُخ","يَكُن مِن غَرامِ اللَهِ عَنها نُزولُها",52,"ل",3,0],["إذا ارتدَتْها اللُّجَجُ الزَّواخِرُ","وَضَمَّها مِثلَ المِرَاةِ مائرُ",53,"ر",1,0],["إذا ارتدى مُهجةَ الكَميِّ غَدا","مُضرَّجاً من جِسادِهِ جَسَدُه",54,"د",2,0],["إذا ارتمَتْ بالشَّرارِ واطَّرَدَتْ","على ذُراها مَطاردُ اللَّهَبِ",55,"ب",1,0],["إِذا أَرَدتَ شَريفَ الناسِ كُلَّهُمُ","فَاِنظُر إِلى مَلِكٍ في زِيِّ مَسكينِ",56,"ن",1,0],["إِذا