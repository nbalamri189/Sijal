أخرى لمرايا البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80107&r=&rc=5",""],[6268,"بعثريني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82933&r=&rc=19",""],[6300,"نشوة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82840&r=&rc=11",""],[5190,"الديك المغرور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78302&r=&rc=15",""],[5190,"ها أنا يا نبض قلبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78297&r=&rc=10",""],[6344,"متاهات الأسى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87974&r=&rc=14",""],[6344,"دوّامة المعنى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87976&r=&rc=16",""]],"verses":[["ها أَوشِكي أَن تَرِدي الحِماما","غَمراً يَزيدُ لُجُّهُ اِلتِطاما",0,"م",2,0],["ها إِنَّها نَومَةٌ بِسَورَتِها","أَقالَتِ العَينَ عَثرَةَ السَهَدِ",1,"د",1,0],["ها أنا يا أمّي اليوم فتى","طائر الصيت بعيد الشهاب",2,"ب",1,0],["ها أنا يا أمّ أرثيك وفي","شجو هذا الشعر شجوي وانتحابي",2,"ب",2,0],["ها أنت في كل ذراتي وملء دمي","شعر «تعنقده» الذكرى وتعتصر",3,"ر",1,0],["ها إِنَّها لَوعَةٌ في الصَدرِ قادِحَةٌ","نارَ الأَسى وَمَشيبي طائِرُ الشَرَرِ",4,"ر",1,0],["ها إِنَّما مُطِرَت سَماؤُكُمُ دَم","وَرَفَعتَ رَأسَكَ مِثلَ رَأسِ الأَصيَدِ",5,"د",1,0],["ها إنَّ تا خطبةٌ قام الخطيبُ بها","صريحةُ الصدق لم تُمْذَق ولم تُشَبِ",6,"ب",1,0],["ها إنّ ذاك لَمنزلٌ","من كلّ صالحةٍ عَميرُ",7,"ر",1,0],["ها إنها مِدحةٌ مبالغةٌ","إن امرُؤٌ منصِفٌ تدبَّرها",8,"ر",3,0],["ها أنا المنذر المحذِّر من يظ","لم شعراً من سُوقَةٍ ورئيس",9,"س",1,0],["ها إنها خطبة قام الخطيب بها","بكر ولكنها في حزمها نَصَف",10,"ف",1,0],["ها أنتَ تعلمُ أن الصبر من صَبِرٍ","فامزجهُ بالنجحِ إن النُجح من عسلِ",11,"ل",1,0],["ها أنا عبدُ الأمير قد وضحَت","ظُلامتي فهْيَ عندهُ علَم",12,"م",1,0],["ها أَنتِ كَالحَقلِ في نَزعٍ وَحَشرَجَةٍ","وَهَت قُواكِ كَما اِستَرخى جَناحاكِ",13,"ك",1,0],["ها أَنْتَ ذا قَدْ أَطْبَقَتْ","جفنَيْكَ أَحلامُ المَنُونْ",14,"ن",1,0],["ها أَنْتَ ذا قَدْ جَلَّلَتْكَ","سَكِينَةُ الأَبدِ الكبيرْ",14,"ر",1,0],["هَا أَنا أَسمَعُ في قَلْبِ الحِيِاةْ","صَيْحَةَ الآلامْ",15,"م",1,0],["هَا أَنا أسْمَعُ أَصْواتَ السُّرُورْ","كَضَّتِ الأَيَّامْ",15,"م",1,0],["ها إنَّ أَزْهارَ الرَّبيعِ","تَبَسَّمَتْ أَكمامُها",16,"ه",2,0],["ها إنَّها هَمَسَتْ","بِآذانِ الحياةِ غَرِيدَهَا",16,"ه",2,0],["ها أتى الأرباب من أجبالهم","وتبدى الجنّ من أوغالهم",17,"م",1,0],["ها إِنَّها عُصبَةٌ جاءَت مُخالِفَةً","بَعضٌ لِبَعضٍ فَخِلنا أَنَّها عُصَبُ",18,"ب",1,0],["ها إِنَّ نَجمَكُمُ عَلى كَرهي العِدى","يَعلو وَريحَكُمُ تَزيدُ هُبوبا",19,"ب",2,0],["ها إِنَّ سَعيَ ذَوي الآمالِ قَد نَجَحا","وَإِنَّ بابَ النَدى بِالفَتحِ قَد فُتِحا",20,"ح",2,0],["ها إِنَّها نِعمَةٌ إِذا ذُكِرَت","كانَت عَطاءً وَكُنتَ باذِلَها",21,"ل",3,0],["ها إنَّها خُطَطُ العَلياءِ والكَرَمِ","وأينَ سَافِرَةُ الأخلاقِ والشِّيَمِ",22,"م",1,1],["ها إِنَّ أَمرَ الزَمانِ في يَدِهِ","يَأمُرُهُ تارَةً وَيَنهاهُ",23,"ا",2,0],["ها أنا عُدتُ إلى حيثُ التقينا","في مكانٍ رَفرَفَت فيه السعاده",24,"ه",1,1],["ها أنا جفت دموعي فاعف عنها","إنها قبلك لم تبذل لحي",25,"ي",1,0],["ها أَنا ذا بِالذُنوبِ مُعتَرِفٌ","فَهَب لِذُلّي جِنايَتَي أَمسِ",26,"س",1,0],["ها إِنَّ هَذا مَوقِفُ الجازِعِ","أَقوى وَسُؤرُ الزَمَنِ الفاجِعِ",27,"ع",1,1],["ها إِنَّ بي لَمَماً يُؤَرِّقُ ناظِري","أَلَماً فَهَل مِن نافِثٍ أَو راقِ",28,"ق",1,0],["ها أَنَّ لي عِندَ اللَيالي حاجَةً","بَعُدَت مَنالاً وَاللَيالي تَكؤُمُ",29,"م",1,0],["ها إِنَّهُ الرُزءُ الَّذي ثَقُلَت بِهِ","نُوَبٌ وَخَفَّت عِندَهُ الأَحلامُ",30,"م",1,0],["ها إنّها كأسٌ بَشعِتُ بهَا","لا مَلجَأٌ منْها ولا وَزَر",31,"ر",1,0],["ها إنّ مَصَر غداةَ صرْتَ قَطينَها","أحْرَى لتحسدها بك الأقطار",32,"ر",1,0],["ها إِنَّ ذي عِذرَةٌ إِلّا تَكُن نَفَعَت","فَإِنَّ صاحِبَها مُشارِكُ النَكَدِ",33,"د",1,0],["ها أَنتِ عَجماءُ عَمّا قَد سُئِلتِ فَما","بالُ المَنازِلِ لَم تَنطِق وَلَم تُحَرِ",34,"ر",1,0],["ها أَنْتَ ذا في الأُفقِ","تَضْحَكُ لا تُهَمُّ ولا تَخِيبْ",35,"ب",1,0],["ها إِنَّها فِرْيَةٌ قَدْ كانَ باءَ بِها","في ثَوْبِ يُوسُفَ مِنْ قَبْلِي دَمٌ كَذِبُ",36,"ب",1,0],["ها إِنّ أَجفان الكَظيمِ غَضيضَةٌ","حَتّى تَراكَ وَرَأسهُ مَنكوسُ",37,"س",1,0],["ها إِنَّما مُطِرَت سَماؤُكُمُ دَماً","وَرَفَعتَ رَأسَكَ مِثلَ رَأسِ الأَصيَدِ",38,"د",1,0],["ها أنا وحدي وألقا","ك هنا بين الحنايا",39,"ي",2,0],["ها أنت مُتّ..فقومي الآن وانتفضي","قد يصبح الموت ميعاداً مع الأزلِ",40,"ل",1,0],["ها أنا حيث التقينا وعلى","خاطري من صور الأمس ازدحام",41,"م",1,0],["ها أنا في منزل اللّقيا وفي","جوّه من عهدنا الفاني حطام",41,"م",1,0],["هَا إنّهُ وَعَطاءَكَ الجَمّ اللُّهَى","أخَوَانِ، ذا فَانٍ، وَهَذا بَاقِ",42,"ق",1,0],["ها إنّ نَجمَكُمُ، عَلى كُرْهِ العِدَى،","يَعْلُو، وَرِيحَكُمُ تَزِيدُ هُبُوبا",43,"ب",2,0],["ها أنتَ تعلمُ أن الصبر من صبرٍ","تمزجُه بالنجحِ إن النُجح من عسلِ",44,"ل",1,0],["ها أنتم الشمس التي","أخذت تشعشع في سماها",45,"ا",3,0],["ها أنت دولة قدس طالما منحت","بلا انقطاع وبالعدل الجلي منعت",46,"ت",1,0],["ها أنت نصرة عاجز مثلي أتا","ك له بكاء تلهف وعويل",47,"ل",1,1],["ها أنت كالئنا إذا الباغي بغى","ولحفظنا يوم الكروب كفيل",47,"ل",1,0],["ها أنا ذَا والمالُ طوعُ يدبكم","فانظرُوا حالتي كفهتم أثَامَا",48,"م",2,0],["هَآ أنَا في رُبَاكَ مُنهَمِلَ الأد","مُعِ يغلي الزَّفِيرُ بَينَ ضُلُوعِى",49,"ع",2,0],["هَا إِنَّ ذَا وَالدِى والحالُ مُعتَبَرٌ","قَد جَاءَ مُدَّعِياً مَالِى الذي بِيدِى",50,"د",2,0],["ها أنت ذاك وأنت من ندري بهِ","وفّاكَ هذا الدهرُ ما لا يلزمُ",51,"م",1,0],["ها إنني قَرْمٌ تَناهبَ مَرتعي","جُرْبٌ فهجْتُ مُجَرْجِراً بِهديرِ",52,"ر",1,0],["ها أنا أُدْخل شعري راضياً","حقلَ ألغامٍ وينصاعُ رضيّا",53,"ي",2,0],["ها أنا أجعلُ شعري طائعاً","للذي تمليهِ عيناكِ عليّا",53,"ي",2,0],["ها أَنتَ تزعمُ أنّ اللّه في جهةٍ","وَلا تُبالي بِتشبيهٍ ضللتَ بهِ",54,"ب",2,0],["ها أنا أُقلع عن أكوابها","قبلَ ما تُقْلِعُ أنواءُ الغيوم",55,"م",1,0],["ها إنني أيقنتُ أن جفونَهُمْ","تُربي على بأس الكمي المعلم",56,"م",1,0],["هَا أَنَا الْمُحْتَمِى بِهِ صِحْتُ وَا غَوْ","ثَاهُ مِنْ لاَعِجِ الْفُؤَادِ وَبَثِّهْ",57,"ث",2,0],["هَا أَنَا الصَّادِي تَرَجَّيْتُ غَيْثاً","يُطْفِئَنَّ الْجَوَى تَرَشْرُشُ دَثِّهْ",57,"ث",2,0],["هَا أَنَا الْعَبْدُ قَدْ تَنَادَيْتُ يَا مَوْ","لاَيَ ذُبْتُ مِنْ رَضْعِ هَمِّي وَرَغْثِهْ",57,"ث",2,0],["هَا أَنَا رُدْتُ مِنْ جَنَابِكَ رَوْضاً","مُثْمِراً بِمُبَدِّدِ الإِبْلاَسِ",58,"س",1,0],["ها أنا عبدٌ صبورٌ","واقفٌ أحصي جروحي",59,"ح",2,0],["هاأنا في الهَمِّ وحدي","غُصْتُ في موجٍ رهيبِ",60,"ب",1,0],["ها أنا في الذُّلِّ أُبْلي","طَيِّعاً حتى أصيرا!",61,"ر",2,0],["ها أنا في العشق أذْوي","وهْوَ غَيْثٌ لا يُعينُ",62,"ن",1,0],["ها أَنا كَالمُهدي إِلى بَغدادَ مِن","دِمَشقَ إِذ أُنشِد تَمراً أَو رُطَب",63,"ب",1,0],["ها أَنا ذا عَبيدُكَ ال","جاني المُقصِرُ بِالفَنا",64,"ن",2,0],["ها أَنتَ غُصن وَقَلبي طائِر فَإِذا","أَبعَدته عَنكَ أَو هَيَّجتُه صرخا",65,"خ",2,0],["ها أنت تفقد من حكاه برقَّة","وبرِيقه وأراكَ في تَبْريح",66,"ح",1,0],["ها أَنتَ فَوقَ سَماءِ المَكرُماتِ فَزِد","عَفواً بِلا مِنَّةٍ صَفواً بِلا كَدَرِ",67,"ر",1,0],["ها أنا ذا منقَطع","عن أسرتي وبَلدي",68,"د",2,0],["ها أنا ذا مِن بَين أهلِ الندى","والمجدِ من بانٍ ومن كاتبِ",69,"ب",1,0],["ها العالمون غدَوا من تحت رايته","في البعثِ قسمين منصورٌ وخِذلان",70,"ن",1,0],["ها أنت يا حبي جميلٌ بارعٌ","في حسنه بل رائعٌ ببهاء",71,"ا",2,0],["ها أَنتُمُ سُفُنُ النَجاةِ وَرافِعوا الد","دَرَجاتِ يَومَ تشاهَد الأَشهادُ",72,"د",1,0],["ها أنتَ في الأَشْرافِ واحد عصرها","ونجيبُ عنصرها رضيعُ لبانها",73,"ن",3,0],["ها أنتَ في الإسلام أكبرُ آيةً","لله تمحو الغيَّ والإلحادا",74,"د",2,0],["ها إنّ ظِلفَك ساقَ حتفَك عنوةً","مُتْ حسرةً قد حاقَ فيك الداءُ",75,"ا",2,0],["ها أنت والدهر والدنيا مطاوعة","وها أنا ونداكم غير محدودِ",76,"د",1,0],["ها أنت والدهر والأيام مقبلةٌ","وها أنا بينكم في صفقة الغبنِ",77,"ن",1,0],["ها إنَّها نعمةٌ ما زالَ كوكَبُها","إليكَ في ظُلُماتِ الخطبِ يَهْدِيني",78,"ن",2,0],["ها أنتم الشهدا وهذي داركم","نزوى الجنان وما سوى فجهنم",79,"م",1,0],["ها أنا أبكيه فهل من رِدَّةٍ","لفائتٍ على فتىً بكى لَه",80,"ل",2,0],["ها أنتَ تُبصِرُ يا مَولايَ كَم صَغُروا","كبيرُهُم صارَ مِنهُ الخِزيُ يَنكَسِفُ",81,"ف",1,0],["ها أنت فستقة الثمار جنيتها","بيدي ويشهد عن حلاوتها الفم",82,"م",1,0],["ها أنت يا أبتي تجرّ على يدي","حير الإيالة غيبة وحضورا",83,"ر",2,0],["ها إنني بالرغم عني قائد","ما بينهم لكن بدون عساكر",84,"ر",1,0],["ها أنا اليوم أرضي","يا بلادي جنابك",85,"ك",1,0],["ها الأرض قد لبست جمالا أخضرا","والغصن