{"poems":[[65,"تجنى علينا طيفها حين أرسلا","https://www.aldiwan.net/poem46150.html","السريع"],[68,"أتاني كتاب منك أحسب أنه","https://www.aldiwan.net/poem40301.html","الطويل"],[68,"معان حكت في قلوب الأنام","https://www.aldiwan.net/poem40677.html","المتقارب"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[409,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[438,"مل من صبوته ما أملا","https://www.aldiwan.net/poem12453.html","الرمل"],[447,"أراك تريد فوق هوى تليد","https://www.aldiwan.net/poem14304.html","الوافر"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75877","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201874","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72430","الطويل"],[5145,"فديتك يا أعز الناس قدرا","https://www.poetsgate.com/ViewPoem.aspx?id=108219",""]],"verses":[["بنَثْرٍ يمُجُّ السِّحْرَ طَوْراً وتارَةً","بنَظْمٍ إذا ما أحْزَنَ الشِّعْرُ أسْهَلا",0,"ل",2,0],["بِنَثرٍ يَظَلُّ النَظمُ يَحسُدُ رَصفَهُ","وَنَظمٍ لِلُطفِ السَبكِ يَحسُدُهُ النَثرُ",1,"ر",1,0],["بِنَثرٍ يُنَظِّمُ شَملَ العُلومِ","وَنَظمٍ يُقَلِّدُ جيدَ الزَمانِ",2,"ن",1,0],["بِنثرٍ يفوقُ العقدَ حُلّ نظامهُ","فَيُزري به نَظماً ويُزري به نثرا",3,"ر",2,0],["بنثر يخرس البلغا ونظم","ألَذُّ لدى النديم من المدام",4,"م",1,0],["بنَثاً فاوحَهُ الطّيبُ فلم","يرتَضِ المندَلَ عنه بدَلا",5,"ل",2,0],["بنثر أبي نباتة والمعاني","أياساً والنظام فمن عبيد",6,"د",1,0],["بنثرٍ كَشِبهِ الزَهرِ غِبَّ سَمائِهِ","وَنَظمٍ كَمثلِ الزَهرِ بِالسحرِ نافثِ",7,"ث",1,0],["بنثري يجئُ الوهمُ لي فأعافه","وان جاءني في النظم سجّلته شعرا",8,"ر",2,0],["بنثر الاعادي من صفوف نظامه","يعلمنا قانونه النظم والنثرا",9,"ر",2,0],["بنثرٍ يملأ الأبصار حسناً","ونظمٍ يملأ الأسماع سحرا",10,"ر",2,0]]}