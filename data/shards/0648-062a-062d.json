://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[106,"طوى الموت إبراهيم!","https://www.poetsgate.com/ViewPoem.aspx?id=179679",""],[106,"تحية مولود","https://www.poetsgate.com/ViewPoem.aspx?id=179510",""],[106,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[106,"زمزم طليعة الأسطول المصري","https://www.poetsgate.com/ViewPoem.aspx?id=179646",""],[106,"في مهرجان دار العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=179366",""],[106,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[106,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[77,"أمحي رسوم الأنس إن شئت أن تبقي","https://www.poetsgate.com/ViewPoem.aspx?id=34185",""],[100,"نهاية حسناء ريفيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50449",""],[100,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=50099",""],[67,"جِوَارُكَ منْ جَوْرِ الزَّمانِ يُجِيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=14535",""],[90,"غضبة","https://www.poetsgate.com/ViewPoem.aspx?id=179231",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[90,"الشاعرية","https://www.poetsgate.com/ViewPoem.aspx?id=650",""],[0,"ألا عِمْ صَبَاحاً أيّهَا الطّلَلُ البَالي","https://www.poetsgate.com/ViewPoem.aspx?id=4731",""],[5,"معلقة عمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=11411",""],[91,"لقاء وفراق","https://www.poetsgate.com/ViewPoem.aspx?id=53392",""],[46,"يا حَصانَ النّساءِ! كم فارساً","https://www.poetsgate.com/ViewPoem.aspx?id=20205",""],[99,"أحبكِ لا أدري","https://www.poetsgate.com/ViewPoem.aspx?id=206832",""],[51,"أجنتْ لك الوجدَ أغصانٌ وكثبانُ","https://www.poetsgate.com/ViewPoem.aspx?id=25836",""],[90,"لعبة التجارب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66767&r=&rc=175",""],[71,"صليلُ المواضي واهتزازُ القنا السُّمرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=28020&r=&rc=7",""]],"verses":[["وَتَحسَبُهُ مِمّا تَضايَقَ واقِفاً","وَما رَدَّ مِن غَربِ الجِيادِ الصَلادِمِ",0,"م",1,0],["وَتَحِنُّ ما جَدَّ المَسيرُ كَأَنَّما","كُلُّ البِلادِ مُحَجَّرٌ وَعَقيقُ",1,"ق",1,0],["وَتَحَرَّجتَ يَومَ رُحتَ حَراماً","مِن عَطائي فَمَن أَباحَكَ مَنعي",2,"ي",1,0],["وَتَحفَظُ أَيدينا كُعوبَ رِماحِنا","وَأَطرافُها بَينَ القُلوبِ تَضيعُ",3,"ع",1,0],["وَتَحَوَّلَتْ نُقَطاً بِضاحِي جِلْدِهِ","حَتَّى وَقَتْ بِعُيونِها أَرْواحَها",4,"ح",3,0],["وَتَحْتِيَ طَيّارُ العِنانِ كَأَنَّهُ","خُدارِيَّةٌ هَزَّتْ لِصَيْدٍ جَناحَها",5,"ح",3,0],["وَتَحْتَ حَبابِ الدَّمْعِ عَيْنٌ رَويَّةٌ","مِنَ الدَّمِ وَالأحشاءُ مُضْمِرَةٌ وَجْدا",6,"د",2,0],["وتَحْتيَ أدْهَمُ يُخْفي الصّهيلَ","كَما اسْتَرَقَ المَضرَحِيُّ الوَعَى",7,"ا",1,0],["وتحتَ نِجادي باتِرُ الحَدِّ صارِمٌ","تَدِبُّ صِغارُ النّملِ فوقَ غِرارهِ",8,"ر",2,0],["وتحتَ القَنا للأعْوَجيّاتِ رنّةٌ","بضَرْبٍ يُطيرُ الهامَ تحتَ شَرارِهِ",8,"ر",2,0],["وتحتَ نِجادي مَشْرَفيٌّ إذا الْتَوى","بجَنْبيَ رَوْعٌ كادَ يَلْفِظُهُ الغِمْدُ",9,"د",1,0],["وتَحتيَ أدْهَمُ رَحْبُ اللَّبانِ","حَبيكٌ قَراهُ سَليمٌ شَظاهْ",10,"ا",2,0],["وتَحِلُّها عُصَبٌ تُضَرِّمُ للْقِرى","شَذَبَ الأراكِ زَهادَةً في العَنْبَرِ",11,"ر",1,0],["وتَحتَ راياتِهِ آسادُ مَلحَمَةٍ","في ظَهرِ كُلِّ أقَبِّ البَطنِ مَلبُونِ",12,"ن",1,0],["وتحدى بالهدى جهد العدا","وانتضى للصارم الباغي حساما",13,"م",2,0],["وتحتشد الأمسيات","على العامر البلقع",14,"ع",1,0],["وَتَحُلُّ عَبلَةُ بِالجَواءِ وَأَهلُن","بِالحَزنِ فَالصَمّانِ فَالمُتَثَلَّمِ",15,"م",1,0],["وَتَحتِيَ مِنها ساعِدٌ فيهِ دُملُجُ","مُضيءٌ وَفَوقي آخَرٌ فيهِ دُملُجُ",16,"ج",1,0],["وَتَحْسَبُ الصَّدّ يُسلِينِي مَحَبَّتَهَا","هَيْهَاتَ لَوْ أَنَّ جَمْرَ النَّار يُصْلِينِي",17,"ي",1,0],["وتحثّهُ الزّلْفى ليَقْصِدَ عِبْرَة","في الدّهْرِ طالَ لأجْلِها استِعْبارُهُ",18,"ر",2,0],["وتحمّلْ نحْوَ القِبابِ سَلاماً","يزْدَري عرْفُهُ بأزْهارِ نَجْدِ",19,"د",1,0],["وتَحْتَمِلُ الرُّكْبانُ طيبَ حَديثِهِ","فيأتيكَ بالأخبارِ مَنْ لم تُزَوِّدِ",20,"د",1,0],["وَتَحسَبُ في البَحرِ تَعشيرَهُ","تَغَرُّدَ أَهوَجَ في مُنتَشينا",21,"ن",2,0],["وَتَحتَ ظَلامِ النَقعِ تُشرِقُ أَوجُهُ ال","ثَناءِ وَجَمعُ المَجدِ في فِرقَةِ الوَفرِ",22,"ر",1,0],["وَتَحَكَّمَت فيها الفرنجُ وَغادَرَت","أَعلاجُها مِحرابَ عَمروٍ هَيكَلا",23,"ل",2,0],["وَتُحمَدُ عُقبى الأَمرِ مازالَ يُشنَأُ","ظَعَنتُ فَكانَ الحُرُّ يُجفى فَيَظعَنُ",24,"ن",1,0],["وَتَحمِلُنا غَداةَ الرَوعِ جُردٌ","عُرِفنَ لَنا نَقائِذَ وَاَفتُلينا",25,"ن",2,0],["وَتَحسِبُ سَلمى لا تَزالُ تَرى طَلّ","مِنَ الوَحشِ أَو بَيضاءً بِمَيثاءِ مِحلالِ",26,"ل",1,0],["وَتَحسِبُ سَلمى لا نَزالُ كَعَهدِن","بِوادي الخُزامى أَو عَلى رَسِ أَوعالِ",26,"ل",1,0],["وَتَحتَ قُتودِ الرَحلِ عَنسٌ حَريزَةٌ","عَلاةٌ يُباريها سَواهِمُ قُودُ",27,"د",1,0],["وتَحْفَظُ الْحُسْنَى لأَرْبَابِهَا","في حَاضِرِ الْوَقْتِ وَفِي الْعَقْبِ",28,"ب",1,0],["وَتَحَوَّلَتْ يَدُهُ إلى","أَحْشَائِهِ ظُفْراً وَنَابَا",29,"ب",2,0],["وَتُحّيِّي في الضَّيْفِ أَيَّ خَطِيبٍ","لاَ يُدَانَى شَأْواً وَأَيَّ أَدِيبِ",30,"ب",1,0],["وَتَحُفُّ أَبْصَارٌ بِهَا فَيَخِزْنَها","بِحَيَائِهَا وَيَشُكْنِهَا فِي وَهمِهَا",31,"م",3,0],["وَتَحْتَ اسْمِ حِفْنِيٍّ مَعَانٍ كَثِيرَةٌ","هُوَ الضَّوْءُ إِنْ حَلَّلْتَهُ وَهْيَ أَلوَانُ",32,"ن",1,0],["وَتَحَوَّلَتْ غُرَراً تَضِيءُ وَأَنْعُمَا","تِلْكَ اللَّيَالِي السُّودُ وَالآلامُ",33,"م",1,0],["وَتَحفِرُ الأَرضَ إِذا ما مَشَت","كَأَنَّما تَحفِرُ رِجلاها",34,"ه",2,1],["وَتَحسَبُ مِنهُما مَن هَزَّ رَأساً","لِيَنظُرَ في مَواريثٍ وَدَينِ",35,"ن",1,0],["وَتَحمِلُها في اِتِّباعِ الهَوى","عَلى آلَةٍ ظَهرُها أَحدَبُ",36,"ب",1,0],["وَتَحتَ قُتودِ الرَحلِ حَرفٌ شِمِلَّةٌ","سَريعٌ أَمامَ اليَعمُلاتِ نُصولُها",37,"ل",3,0],["وَتَحتَ العَوالي وَالقَنا مُستظِلَّةً","ظِباءٌ أَعارَتها العُيونَ الجآذِرُ",38,"ر",1,0],["وتحملت عنه حديث صحيحه","رُسُلُ النسيم وصدّق الخُبُرُ الخَبَرْ",39,"ر",1,0],["وتحيد عن آداب كلّ قبيلة","لم تنتحلها مصر في أنسابها",40,"ب",3,0],["وتحتدم الحفائظ في البرايا","فتُضرم فوق مدفنه أُتونا",41,"ن",2,0],["وتَحسُن للعُرب الكرام عواقب","فيحمَدها مُفتٍ ويشكر مطران",42,"ن",1,0],["وتحديث غِرّ مُطرياً عدل دولة","برايتها رسم الصليب المشبّك",43,"ك",1,0],["وتحسبَهم دوداً يعيش بحمأة","وما هو من دود بها متولِّد",44,"د",1,0],["وَتَحسُدُ أَن نَزورَكُمُ وَنَرضى","بِدونِ البَذلِ لَو عَلِمَ الحَسودُ",45,"د",1,0],["وَتُحرِزُ حينَ تَضرِبُ بِالمُعَلّى","مِنَ الحَسَبِ الكَواهِلَ وَالسَناما",46,"م",2,0],["وتحسب طالبيك إذا أرادوا","وئامك أنت والشعرى العبورُ",47,"ر",1,1],["وَتَحسِبُه ذَا بُرقِع وكأنَّه","بأسمالِ جَيشَانيّةٍ مُتَنَقِّب",48,"ب",1,0],["وَتُحِبُّ نَفسي العاشِقينَ لِأَنَّهُم","مِثلي عَلى كَنَفٍ مِنَ الأَحزانِ",49,"ن",1,0],["وَتَحَلُّ بِالجِسرِ الجِنا","نِ وَتَسكُنُ الحُصنَ المُعَلّى",50,"ل",2,0],["وَتَحولُ دونَ الكَفِّ ظُلمَتُها","حَتّى تَشُقَّ عَلى الَّذي يَسري",51,"ر",2,0],["وَتَحسُبُهُم ماتوا زُمَينَ حَليمَةٍ","وَإِن تَأتِهِم تَحمَد نِدامَهُمُ غَدا",52,"د",2,0],["وتحمل الأمر قد أنضت فوادحه","صمّ الجبال ولكن ليس ينضيكا",53,"ك",2,0],["وتحدَّثت في الروعِ ألسن بيضه","بين المقاصد بالحديثِ الفاصل",54,"ل",1,0],["وَتُحِلُّ الضَميرَ جَوفُ فُؤادي","كَحُلولِ الأَرواحِ في الأَبدانِ",55,"ن",1,0],["وَتحُطُّ الرِّخَاخَ بعد الفَرازي","ن فتزداد شدةَ استعلاءِ",56,"ا",2,0],["وتحرِّياً لرضاهُمُ اسْ","تنفرت من شِعري غِضابهْ",57,"ب",2,0],["وتحتيَ نعْلي تخبِطُ الأرضَ جهْدَها","وتحت سِوايَ السَّرْجُ والسابح النهدُ",58,"د",1,0],["وتحت آباطها صُنان","علاجه جَعسُها ذريره",59,"ر",2,0],["وتحاول البطل البئيسَ رماحُهُمْ","فيظل بين لواطم وخوامش",60,"ش",1,0],["وتُحيل الظاءَ ضاداً فإذا","هي قالت عِظةً قالت عِضَهْ",61,"ض",2,0],["وتحنَّبت ساقاه وانشنجت","أنساؤه فقمصنَ أكرعه",62,"ع",2,0],["وتحكيكٍ لشُفرينِ","حقيقين بتحكيكِ",63,"ك",1,0],["وتحتقرُ الحظَّ الجزيلَ تقيسُه","بقدْرِك يا وهّابَ كلّ جزيل",64,"ل",1,0],["وتحدّثتَ مُكثِراً ومُطِيباً","بأحاديثَ جمّةِ الأشكالِ",65,"ل",1,0],["وتحتاطُ من كرّ الزمانِ عليهمُ","فتنهاه عنهم بالتي هي أحسمُ",66,"م",1,0],["وتحت هاتيك أعنابٌ تلوعُ به","أطرافُهُنَّ قلوبُ القومِ قنوانُ",67,"ن",1,0],["وتحرَّمْنَ إذْ غدوْنَ إماءً","مذعناتٍ بحقها إذعانا",68,"ن",2,0],["وتُحيّي متونَها بثمارٍ","يانعاتٍ قطوفهُنَّ دواني",69,"ن",2,0],["وتحسبُ العينُ فكّيه إذا اختلفا","عند التنغم فكَّي بغلِ طحان",70,"ن",1,0],["وتحفَّظَ المدحَ الذي أهديتُه","كرماً ودوَّنه لديهِ دَواوِنا",71,"ن",2,0],["وَتُحَبِّبُ الدُنيا إِلَيهِ نَفسَهُ","فَيُطيعُها وَالنَفسُ مِن آفاتِهِ",72,"ت",2,0],["وَتَحَيَّرَت في مُقلَتَيها دَمعَةٌ","خَرساءُ لا تَهمي وَلَيسَ تَغورُ",73,"ر",1,0],["وَتَحفَظُ سِرَّ صاحِبَها مَصوناً","وَبِنتُ الكَرَمِ تَفضَحُ كُلَّ سِرِّ",74,"ر",1,0],["وَتُحِسُّ الوَحيَ روحي هابِطاً","مِن سَماها في ضُحاها وَمَساها",75,"ا",3,0],["وَتَحرُمُ النَفسَ لِذاتٍ لَها خُلِقَت","وَلَم تُصاحِبكَ يا هَذا لِتُؤذيها",76,"ي",3,0],["وَتَحتَ ذَلِكَ خَصرٌ يَستَقِلُّ بِهِ","دَعصٌ تُرَجرِجُ حَتّى كادَ يُلقيها",77,"ي",3,0],["وَتَحوي وَدَّ غانِيَةٍ بِعَسفٍ","أَلا حاوَلتَ غَيرَ مَدى الطَريقِ",78,"ق",1,0],["وتحتَ رواقِ الظَّلامِ الكَئيبِ","إِذا شَمَلَ الكونَ روحُ السَّحَرْ",79,"ر",1,0],["وتُحَيِّي الحَيَاةَ والعالَمَ الحيَّ","بصَوْتِ المحبَّةِ المعسولهْ",80,"ه",1,0],["وَتَحتَ مَجاري الدَمعِ مِنّا مَوَدَّةٌ","تُلاحِظُ سِرّاً لا يُنادي وَليدُها",81,"د",3,0],["وتحملت في هواها هوانك","ومن العز في هواها هوانك",82,"ك",1,0],["وتحدثنا في مواضيع شتى","وتقلدنا مذهباً بعد مذهب",83,"ب",1,0],["وتحرروا من قيد كل عقيدة","سوداء ما فيها هدى للساري",84,"ر",2,0],["وتحت يدى من العمال جمع","يُشمِّر ذيله عند التلاقى",85,"ق",2,0],["وتحلاق اللحى ما كان رأيى","ولا قصّ الشوارب من خلاقي",85,"ي",1,0],["وتحنت وتمنت أضلعي","لوفدت مما تلاقى أضلعك",86,"ك",1,0],["وتحتجب السواسن غير زاهي","جبينك للعيون ومعصميك",87,"ك",1,0],["وتحمل الملك والاسلام عن امم","شلاء لاتحفئ الاشياء ايديها",88,"ي",3,0],["وتحته في سلّم المقام","شريف قوم شاكي الحسام",89,"م",1,0],["وتحتهم جميعهم فلاح","في كيسه محصوله المباح",89,"ح",1,0],["وَتَحكُمُ في النَفسِ أَوتارُهُ","عَلى العودِ ناطِقَةً حاكِيَه",90,"ي",2,0],["وَتَحُطُّ الفَرخَ مِن أَيكَتِهِ","وَتَنالُ البَبَّغا في المِئَتَين",91,"ن",1,0],["وَتَحَلَّت مِنَ البُراقِ بِطُغَرا","ءَ وَمِن حافِرِ البُراقِ بِخاتِم",92,"م",1,0],["وَتَحتَ جِنانِكِ الأَنهارُ تَجري","وَمِلءُ رُباكِ أَوراقٌ وَوُرْقُ",93,"ق",1,0],["وَتَحَكَّموا بِكَ في الوُجو","دِ تَحَكُّماً كانَ اِبتِداعَك",94,"ك",1,0],["وَتَحضُنُكَ الجَزائِرُ وَالرَواسي","وَتَجري رِقَّةً لَكَ وَهيَ صَخرُ",95,"ر",1,0],["وَتَحمُلُ في أَديمِ الحَقِّ وَجهاً","صُراحاً لَيسَ يَتَّخِذُ اللِثاما",96,"م",2,0],["وَتُحِسُّ ثَمَّ العِلمَ عِندَ عُبابِهِ","تَحتَ الثَرى وَالفَنُّ عِندَ عُجابِهِ",97,"ب",2,0],["وَتَحتَ رَبابِهِ نَبَتوا وَأَثّوا","وَفي أَيّامِهِ كَثُروا وَطابوا",98,"ب",3,0],["وَتَحتَ لِوائِهِ ضَرَبوا الأَعادي","وَذَلَّ لَهُم مِنَ العَرَبِ الصِعابُ",98,"ب",1,0],["وَتُحيِي لَهُ المالَ الصَوارِمُ وَالقَنا","وَيَقتُلُ ما يُحيِي التَبَسُّمُ وَالجَدا",99,"د",2,0],["وَتَحَيَّرَت فيهِ الصِفاتُ لِأَنَّها","أَلفَت طَرائِقَهُ عَلَيها تَبعُدُ",100,"د",1,0],["وَتَحيدُ عَن طَبَعِ الخَلائِقِ كُلِّهِ","وَيَحيدُ عَنكَ الجَحفَلُ الجَرّارُ",101,"ر",1,0],["وَتَحتَقِرُ الدُنيا اِحتِقارَ مُجَرِّبٍ","يَرى كُلَّ ما فيها وَحاشاكَ فانِيا",102,"ي",2,0],["وتحمَّلوا سَحَراً وحشوُ حُدوجِهمْ","صُوَرُ الجَآذرِ والظِباءُ العِينُ",103,"ن",1,0],["وتحجبُني حتى تهدَّ مناكبي","بابك ما بينَ الوفودِ زِحامُ",104,"م",1,0],["وتحوز نارُ الشوقِ في أحشائِه","فيرى بياضَ اليومِ ليلاً أليَلا",105,"ل",2,0],["وَتَحَدَّثوا عَن نُجحِ وَع","دِكَ في السَماحِ وَصِدقِ وائِك",106,"ك",1,0],["وَتَحتَ ضُلوعي مِن هَواكَ جَوانِحُ","مُحَرَّقَةٌ في كُلِّ جانِحَةٍ جَمرُ",107,"ر",1,0],["وَتَحَلَّتِ الدُنيا بِأَحسَنِ حَليِها","وَغَدَت بِوَجهٍ ضاحِكٍ مُستَبشِرِ",108,"ر",1,0],["وَتَحمِلُ دِجلَةُ حَملَ الجَموحِ","حَتّى تُناطِحُ أَركانَها",109,"ن",3,0],["وَتَحتاطُ مِن شَفَقٍ حَولَهُ","كَما حاطَتِ العَينُ إِنسانَها",109,"ن",3,0],["وَتَحسِبُ مِن مَلائِمِها كُلَيبٍ","عَلَيها الناسُ كُلَّهُمُ غِضابا",110,"ب",2,0],["وَتَحمي وَراءَ الحَيِّ مِنّا عِصابَةٌ","كِرامٌ إِذا اِحمَرَّ العَوالي مَساعِرُ",111,"ر",1,0],["وَتَحمي حِماها وَالمَنايا شَوارِعٌ","عَلى الحَربِ تَمري دَرَّها بِالمَناصِلِ",112,"ل",1,0],["وتَحلَّها من عائذٍ بك واثقٍ","دهراً سهامُ الظُّلمِ في أوتارِه",113,"ر",2,0],["وتَحلَّتْ بك المدائحُ حتَّى","هي شَدْوُ القِيانِ والأسمارُ",114,"ر",1,0],["وتَحلَّها نظْمَ اللسانِ وإنما","نَظْمُ اللّسانِ فرائدُ الألبابِ",115,"ب",1,0],["وتحتَها ديباجَةُ الفَضاءِ","قد رُصِّعَتْ باللؤلؤ الأنداءِ",116,"ا",2,0],["وتُحدِثُ في الماءِ بردَ الشَّمالِ","إذا سُدَّ فُوها على مائِها",117,"ا",3,0],["وَتَحتَ الثَرى مِنّي وَمِنكَ وَدائِعٌ","قَريبَةُ عَهدٍ إِن تَذَكَّرتَ عَهدَها",118,"د",3,0],["وَتَحمي وَلَكِن عَن شِفاءٍ وَصِحَّةٍ","وَتَحقِنُ إِلّا لِلحَياءِ وَلِلدَمِ",119,"م",1,0],["وَتَحسَبُ قَهوَتَنا كاهِناً","لِما أَظهَرَت مِن صِفاتٍ حِسانِ",120,"ن",1,0],["وَتَحَصَّنوا في قَلعَةٍ لَم يَعلَموا","أَن سوفَ تَشهَدُ يَومَها المَوعودا",121,"د",2,0],["وَتَحَقَّقتُ إِنَّما العَيشُ أَطوا","رٌ وَكُلٌّ مَصيرُهُ لِنَفادِ",122,"د",1,0],["وتحوَّلت عني لرفقتها","ما بين منتظرٍ ومرتقب",123,"ب",1,0],["وتحرُّرٌ مما جنا","ه طينُ آدم في الدماء",124,"ا",2,0],["وتحسبُهُ من جَنّةِ الخلد دانياً","يعانقُ حُوراً لا تراهنّ أعْيُنُ",125,"ن",1,0],["وتحْسَبُ ظلمةَ أحشائها","تُجن من النور عنّا جنين",126,"ن",1,0],["وتحسبُهُ سيفاً على عاتقِ العلى","ولا حليةٌ إلا مَنوطُ التمائمِ",127,"م",1,0],["وتحسبُها في كلّ بيداءَ عُنْصُلاً","تَرَى ناثراً فيها لهنّ وناظما",128,"م",2,0],["وتحسبُ غُرّةَ صبحٍ منيرٍ","بَدَتْ منه وَجْهِ ليلٍ بهيم",129,"م",1,0],["وتحسبُهُ يرتاضُ في غَرْسِ حمله","وَيُسْرَجُ فيه كلاماً للركوب ويُلجَمُ",130,"م",1,0],["وتحسبها من عسكر الشهب سُرْبةً","عمائمهمْ بيضٌ وخيلهمُ دُهمُ",131,"م",1,0],["وتحسبهُ طفلاً من الرّومِ طَرّقَتْ","به من بناتِ الزنج قائمةً أُمّ",131,"م",1,0],["وَتَحسَبها من نَفسِها إِن تَبخترَتْ","تُزَفّ إلى بعلٍ عروساً وتَنجلي",132,"ل",2,0],["وتحسبُها تجلو علينا عرائسا","وشاربُها يفتضّ منهُنَّ ما يُجلى",133,"ل",2,0],["وتَحسَبُه بَحراً تلفُّ عَواصِفاً","أَواخرَه أرواحُهُ بِأَوائِلِه",134,"ل",2,0],["وتحسبها في نقعِهِ رَقْمَ بُرْقُعٍ","يجولُ على وجهٍ من الشمس مُسْدَفا",135,"ف",2,0],["وَتَحسَبُها تُلقي ضروباً مِنَ الجوى","تَحَكّمَ فيها من غَرَامي المُنَوّعِ",136,"ع",1,0],["وتَحسَب أَهوالَ الحروبِ لشَيبِه","وكلُّ خِضابٍ في ذَوائِبِهِ رَدْعُ",137,"ع",1,0],["وتحسرُ منه أنفسٌ هلكتْ به","فما صارمٌ في الأرض من غمدهِ سَقعُ",137,"ع",1,0],["وتحسبُهُ إن حَبّكَتْ مَتْنَهُ الصَّبا","عموداً علاهُ النّقْشُ وهو مُفضَّضُ",138,"ض",1,0],["وَتَحسَبُ مِنهُ الريحَ تَغدو بِضَيغَمٍ","على جِسمِهِ نهيٌ وفي يده نَهْرُ",139,"ر",1,0],["وتحسب إبريق الزجاجة مُغْزِلاً","يُشَوَّفُ في الإِرضاع منه إلى غِفْرِ",140,"ر",1,0],["وتحسبهم قد سُرْبلوا من عِيابِهِمْ","سُيوفاً وَسَلّوا من سُيوفِهِمُ الهِندا",141,"د",2,0],["وَتَحسَبُ مِنها في البَراقِعِ نَرجِساً","تَخطُّ الأَسى بِالطَلِّ في صَفحَةِ الخَدِّ",142,"د",1,0],["وتحسبُ فيه زفرةً من جَهَنَّمٍ","تَصَعّدُ عن فَتْلِ اللوالِبِ بالشدِّ",142,"د",1,0],["وَتَحسَبُها عمَّا تُشيرُ بِأَنمُلٍ","إِلى ما يُلاقي كُلَّ عُضوٍ مِنَ الوَجدُ",143,"د",1,0],["وتحلّي منهُ أجياداً إذا","عَطِلَتْ راقَتكَ في حَلي الغَيَد",144,"د",1,0],["وتحسبها تجلو على كلّ ناظرٍ","كواكبَ نارٍ في بروجِ زجاج",145,"ج",1,0],["وتحسبه وادياً مُفْعَماً","سراباً تموّج في قفرته",146,"ت",2,0],["وتَحسَبهم تَحتَ السَوابِغ والقَنا","ضراغمَ شقّتْ في العَرينِ سَرابا",147,"ب",2,0],["وتحسبُ أنهاءً مُلئْنَ عليهمُ","حَبائكَ من نَسجِ الصّبا وحبابا",147,"ب",2,0],["وتحسب أنّ القفرَ حُمَّ فماؤه","من العرق الجاري عليه صبيبُ",148,"ب",1,0],["وتحسبها تُلْقي لنا رَمْلَ فِضّةٍ","إذا أدمن الإلقاء فيها حصى ذهب",149,"ب",1,0],["وتحسبُ خافقَ الهادي وجيفاً","يظنّ زمامَ مخطمه حُبابا",150,"ب",2,0],["وَتَحَدَّثوا عَن هُلكِهِ كَحَديثِ مَن","بِالبَدوِ عَن مُتَتابِعِ الأَمطارِ",151,"ر",1,0],["وَتَحتَ ذاكَ قَضاءٌ حَزُّ شَفرَتِهِ","كَما يَعَضُّ بِأَعلى الغارِبِ القَتَبُ",152,"ب",1,0],["وَتَحَمَّلَتْ سِرَّ الْهَوَى فَتَرَدَّدَتْ","بِرَسَائِلِ الأَشْوَاقِ فِيمَا بَيْنَنَا",153,"ن",2,0],["وَتَحْتَ جَنَاحِ اللَّيْلِ مِنِّي ابْنُ لَوْعَةٍ","يَرِقُّ إِلَيْهِ الطَّائِرُ الْمُتَرَنِّمُ",154,"م",1,0],["وتحمرُّ خدَّاها إذا ما نظرْتُها","حياءً أبى أنْ تجرحَ الوردَ بالوردِ",155,"د",1,0],["وتحالفتْ أطوارُنا وتمازَجَتْ","ونبا بنا التَقريعُ والتأنيب",156,"ب",1,0],["وتحالفوا أنْ لا يُفّرِقَ بينكم","غاوٍ .ولا يَنْدسَّ فيكُمْ ذيب",156,"ب",1,0],["وَتَحَرَّجي مِن قَتلِ مَن لَم يَبغِكُم","هَجراً وَلا صَرما وَلَم يَتَبَغَّضِ",157,"ض",1,0],["وَتَحَمَّلا عَنّي إِلَيهِ أَمانَةً","مِن عِلقِ صِدقٍ أَو رِداءِ ثَناءِ",158,"ا",2,0],["وَتَحورُ نَفسُ المُستَطيلِ مَهابَةً","وَيَذِلُّ رُغماً مَعطِسُ الجَبّارِ",159,"ر",1,0],["وَتَحَمَّلا عَنّي إِلَيكَ تَحِيَّةً","تَندى عَلى نَفسِ القَبولِ وَتَعبَقُ",160,"ق",1,0],["وَتَحسَبُ لَيلى أَنَّني إِن هَجَرتُها","حِذارَ الأَعادي أَنَّ ما بِيَ هونُها",161,"ن",3,1],["وتَحَيَّفتْ فيكِ الحياةَ حوادثٌ","مرّت بها مِئةٌ عليكِ شِدادُ",162,"د",1,0],["وَتَحمي مِن بِلادِكَ ما اِستَباحَت","بِحَدِّ السَيفِ أَيدي الغاصِبينا",163,"ن",2,0],["وَتَحَمَّلوا حَرَّ الهَجيرِ فَإِنَّهُ","ظِلٌّ لَكُم يَومَ المُقامِ الأَكبَرِ",164,"ر",1,0],["وتحرّجوا أن لا يمس حروفها","قلمُ الجبان يخطُّها بمداد",165,"د",1,0],["وَتَحض الرِجال فيها عَلى تضحية","النَفس ما أهينوا اِحتلالا",166,"ل",2,0],["وَتَحتَهُمُ نَمارِقُ مِن دَمَقسٍ","وَلا أَحَدٌ يُرى فيهِم سَئيمُ",167,"م",1,0],["وَتَحدو يَدَيها زَجولا الحَصى","أَمَرَّهُما العَصبُ ثُمَّ اِستَمالا",168,"ل",2,0],["وَتُحصِفُ بَعدَ اِضطِرابِ النُسوعِ","كَما أَحصَفَ العِلجُ يَحدو الحِيالا",168,"ل",2,0],["وَتَحسِبُ الماءَ زُجاجاً جَرى","وَتَحسَبُ الأَقداحَ ماءً جَمَد",169,"د",1,0],["وَتُحارِبُ الإِنسانَ عِدَّةُ عَقلِهِ","لِحَوادِثِ الدَهرِ الَّذي هُوَ آتِ",170,"ت",1,0],["وَتَحَلّوا عِقدَ التَمَلُّكِ مِنكُم","بِأَكُفٍّ قَد خُضِّبَت بِالدِماءِ",171,"ا",2,0],["وتَحَدَّى فارتابَ كلُّ مُريبٍ","أَوَ يَبْقَى مع السُّيُولِ الغُثاءُ",172,"ا",2,0],["وَتَحِيَّة مني إليه يَرُدُّهَا","منه عليَّ مُسَلِّمٌ ومُرَحِّبُ",173,"ب",1,0],["وَتَحْسِبُهُ قد سارَ يَرْمِي بُرُوجَهَا","بِخَيْلٍ عليها كالبروجِ يُغيرُ",174,"ر",1,0],["وتَحَدَّثوا أنِّي سَلَوْتُ هَواكُمُ","كيفَ السُّلُوُّ مِنَ الزُّلالِ الطَّامِي",175,"م",2,0],["وتَحَلَّتِ الدّنْيا بسِمْطَيْ دُرِّهَا","فرأيتُها شَخصاً لديكَ ضَئيلا",176,"ل",2,0],["وتحسُدُهَا فيه المشارقُ أنّهُ","سواءٌ إذا ما حلَّ في الأرض والقَطر",177,"ر",1,0],["وتحسَبُ أطرافَ آذانها","يراعاً بُرينَ لها بالمُدى",178,"ا",1,0],["وَتَحتَ رِجلِيَ بَحرٌ","يَجري الهَوى بِمُدودِه",179,"د",2,0],["وَتَحتَدُّ حَتّى يَخافَ الجَليسُ","شَذاكَ عَلَيهِ مِنَ الحِدَّه",180,"د",2,0],["وَتَحتَ رَحلي طَيِّعٌ مَيلَعٌ","أَدمَجَها طَيٌّ وَإِضمارُ",181,"ر",1,0],["وَتَحِنُّ مِن شَوقٍ إِلَي","هِ حَنينَ دائِمَةِ الحَنينِ",182,"ن",1,0],["وتحسّها زيتيةً","صفراءَ فاتحة النسيم",183,"م",1,0],["وَتَحسَبُ أَنَّ التَقِيَّ الَّذي","تُشاهِدُهُ راكِعاً ساجِدا",184,"د",2,0],["وَتَحطيمُ أَرماحِ الوَغى أَبَرٌ صَغا","بِها القَولُ كَم طَعنٍ يُهَيّجُهُ أَبرُ",185,"ر",1,0],["وَتُحِبُّ الأُمُّ الخَلوبَ وَداوو","دُ يَحِبُّ الدُنيا وَيَتلو الزَبورُ",186,"ر",1,0],["وَتَحُلّينَ قَريَةً فَسَقاكِ ال","مَوتُ كَأساً كَما سَقاها البَعيرا",187,"ر",2,0],["وَتَحمِلُنا الأَيّامُ حَملَ عَوائِمٍ","بِنا في خِضَمٍّ كُلُّنا فيهِ قامِسُ",188,"س",1,0],["وَتُحِبُّ أَن يُثنى عَلَيكَ بِأَنَّكَ ال","بَرُّ التَقيُّ وَأَنتَ صِلٌّ أَرقَمُ",189,"م",1,0],["وَتَحمِلُهُ الغَريزَةُ وَهوَ شَيخٌ","عَلى ما كانَ يَفعَلُهُ غُلاما",190,"م",2,0],["وَتَحتَ رِجلِكَ مِنها مَفرِقٌ تَرِبٌ","أَنّى اِتَّجَهتَ بِإِعراقٍ وَإِشآمِ",191,"م",1,0],["وَتحصر البحر غوا","صاتٌ وَتُهدي البوارا",192,"ر",2,0],["وَتحسب ماسَ القرط نار حباحب","عَلى متلع من جيدها تَتَوَهَّج",193,"ج",1,0],["وَتحادثنا إلى أن طلع ال","صُبح وانجاب الدجى ينحسر",194,"ر",1,0],["وَتحسب أَن النرجس الغض أَعين","من الطل في أَجفانهن دموع",195,"ع",1,0],["وتحيي له المالَ الصّوارمُ والقنا","ويقتل ما تحيي التّبسّم والجدا",196,"د",2,0],["وتحملُ عنهم من العبء ما","تخرُّ الجبالُ له خاسفَه",197,"ف",2,0],["وتحت الوسادة أقصوصةٌ","لقلبين لم يَروِها عاشقانْ",198,"ن",1,0],["وتحدثانِ النجمَ عن أوصافِها","والنجمُ مأخوذٌ بما تصفانِ",199,"ن",1,0],["وتَحُلّ بالوادي الجديبِ كأنّها","مَيْثاءُ جَدَّ الغَيْثُ في إمْراعها",200,"ع",3,0],["وتحْتي الكَرُّ إدْماجاً وفوْقي","نَظيرُ الكَرّ في دِيَمٍ وهَتْنِ",201,"ن",1,0],["وتَحْسُدُكِ البِيضُ الحَوالي قلادَةً","بجيدِكِ فيها مِن شَذا المِسْكِ تِمْثال",202,"ل",1,0],["وتحت أقدامهم التيجان","يندبها اللؤلؤ والمرجان",203,"ن",1,0],["وتَحْسَبُ صَقْراً واقِعاً دَبَرانَهَا","بعُشِّ الثُّرَيّا فَوْقَ حُمْرِ الحَوَاصِلِ",204,"ل",1,0],["وتَحَوَّلَتْ فينا الذُّنا","بَى الرأْسَ وابْنُ المَجْدِ راغِمْ",205,"م",1,0],["وَتَحُلُّ عَبلَةُ بِالجَواءِ وَأَهلُنا","بِالحَزنِ فَالصَمّانِ فَالمُتَثَلَّمِ",206,"م",1,0],["وَتَحَدَّثَتْ رُسُلُ النَّسِيمِ بلَوْعَتِي","فَلِكُلِّ غُصْنٍ نَحْوَها إِصْغَاءُ",207,"ا",2,0],["وَتَحْتَ جَنَاحِ الدِّرْعِ مِنِّي ابْنُ فَتْكَةٍ","مُعَوَّدَةٌ أَلَّا تُحَطَّ لُبُودُهُ",208,"د",2,0],["وَتَحُفُّ أُمَّتُهُ بِهِ","كَصِغَارِ لَيْثٍ فِي الأُجُمْ",209,"م",1,0],["وَتَحِسُّ تَنْسِيمَ الصَّبَا فِي رَوْضَةٍ","وَتَرَى فُطُورَ الْوَرْدِ فِي الأكْمَامِ",210,"م",1,0],["وَتَحَملَتْ آلامُهُ آمَالَكمْ","هَلْ حَقَّقَتْ آلاَمُهُ الآمالاَ",211,"ل",2,0],["وَتَحَمَّلُوكَ عَلَى الأَشِعَّةِ وَارْتَقَوا","سِرْباً يَجُوزُ بِكَ الدَّرَارِيءَ مُوجِفا",212,"ف",2,0],["وَتحَقَّقتْ عِنْدَ المُثِيبِ المرْتجَى","آمَالكُمْ بِثَوَابِهِ المَوْعُودِ",213,"د",1,0],["وَتُحِسُّ نَزْفَ حُشَاشَةٍ مَكْلُومَةٍ","بِمَقَاطِرِ الْياقُوتَةِ الحُمْرَاءِ",214,"ا",2,0],["وَتَحُولُ الأَفْكَارُ فيهِ فَمَا تُخْطيءُ","مَعْنىً منَ الْمَعَاني الرِّقَاقِ",215,"ق",1,0],["وَتَحَلَّتْ مِنَ اللَّيالِي بِشَامَا","تٍ كَتَنْقِيطِ عَنْبَرٍ فِي بَهَارِ",216,"ر",1,0],["وتَحَوُّلاً فِي حَالِهَا نُظِمَت","فِيهِ المَحَاسِنُ نَظْمَ أَضْدَادِ",217,"د",1,0],["وَتُحيطُ بِي لُجَجُ الصَّرُوفِ","فَمِنْ بَلاَءٍ فِي بَلاَءْ",218,"ا",2,0],["وتحوطُ سائمةَ الدّيارِ وتارَةً","تُرْدِي العِدَى وتَؤُوبُ بالأَسْلابِ",219,"ب",1,0],["وتحيي الصباح إذ يتلالا","وتحييه عندما يتوارى",220,"ر",2,0],["وَتَحَمَّلوا أَصر الأَسى فَتَجَمَّلوا","وَأَرى التَجَمُّلَ أَجمَلَ الآراءِ",221,"ا",2,0],["وَتَحسِبُ سَلمى لا تَزالُ تَرى طَلّاً","مِنَ الوَحشِ أَو بَيضاءً بِمَيثاءِ مِحلالِ",222,"ل",1,0],["وَتَحسِبُ سَلمى لا نَزالُ كَعَهدِنا","بِوادي الخُزامى أَو عَلى رَسِ أَوعالِ",222,"ل",1,0],["وتَحمَّلوهُ ليَدْفِنوا تَحْتَ الثَّرَى","شَمَمَ الأُبَاةِ وصَوْلَةَ الآسَادِ",223,"د",1,0],["وتُحِسُّ الْهَوَى يرِفُّ حناناً","شَرَكُ الحُبِّ أنْ تُحِسَّ حَنَانَه",224,"ن",2,0],["وَتُحَلِّقي فَوْقَ النُّجُو","مِ بلاَ شَبِيهٍ أَوْ نَدِيدِ",225,"د",1,0],["وَتَحدَّيْتَ شَمْسَهُ فَإِذا وَلَّى","تَمنَّيْتَ لَمْحَةً مِنْ ضَبَابِهْ",226,"ب",2,0],["وَتَحَدَّيَا قَصَبَ السبَا","قِ فَأَذْعَنَتْ عِنْدَ التَّحَدِّي",227,"د",2,0],["وتحملُ ألوان الأذى في سبيله","فما كان من ذَنبِ، فحلمك غافره",228,"ر",2,0],["وتحمَّل عبء الأبوة، يا ويْ","حَكَ، لَمْ يحملِ امرؤٌ أعباءك",229,"ك",1,0],["وتحارُ النقودُ بين يديه","حيرَةَ الريش في مهبِّ الهواء",230,"ا",2,0],["وتحرَّكتْ، فكأنها عَلَمٌ","متحرِّكٌ فوق الثرى يجري",231,"ر",2,0],["وتحس قَعْقَعَةَ السلاح، ودونَها","خيلٌ سَنَابِكُهَا تثير العِثْيرا",232,"ر",2,0],["وتَحفظُ الشَّرقَ إنْ شرٌّ أُريدَ به","ممَّنْ يظُنُّون أَهل الشرقِ قُطَعانا",233,"ن",2,0],["وتحسدها بين الخُدُورِ حَرَائِرٌ","وتحسد في بعض الخدُور الجواريا",234,"ي",2,0],["وتحسب خيط الفجر مرود فضة","يجول من الآفاق في حدق زرق",235,"ق",1,0],["وتحمل عن هج أسمارها","رياح الدجى هودجا من حكايا",236,"ا",3,0],["وتحبّ الطموح في الأنفس العظمى","وتحنو على النفوس الضئيلة",237,"ل",2,0],["وَتَحْفَظُ منهمْ إخْوة ً وَتَمِيرُ","ولو شاء مَدَّ النِّيلَ سَيْلُ دمائِهِمْ",238,"م",1,0],["وتحلَّبوه ففي اكُفِّهم","شَطرٌ وفي أفواهِهم شَطْر",239,"ر",1,0],["وتحفَّزَتْ شُمُّ الجبال لهُ","بثُلوجها كِسفَاً تُهدِّده",240,"د",2,0],["وتحلَّبُوا أوطارَهُ فاذا بها","وَشَلٌ لِما استحلى من الأوطار",241,"ر",1,0],["وتحَّلأَ الجَمْعُ الظِماءُ ووُكِّلَتْ","أبناؤهم بالوِرد والإِصدار",241,"ر",1,0],["وتحريقُ \" لوطٍ \" بذنبٍ أتى","وأخذُ \" ثمودٍ \" بسِقبٍ رغا",242,"ا",1,0],["وتحرَّسَّنْ أنْ يقتضوكَ ثوابَها !","وتوقَّ هذا \" الصيرفيَّ \" الحاسبا",243,"ب",2,0],["وتحدَّى من تحدَّى معلناً","أنه يَقبل في الحق النِزالا",244,"ل",2,0],["وتحملُ ما يجلُ من الرزايا","قُواك وقد تخورُ لما يَدِقُ",245,"ق",1,0],["وتحسبُ سلمى لا تزالُ ترى طَلا","من الوَحشِ أوْ بَيضاً بمَيثاءِ مِحْلالِ",246,"ل",1,0],["وتحملُنا غداة الروع جُروٌ","عُرفن لنا نفائذ وافتُلينا",247,"ن",2,0],["وتحت ذلك خصر يستقلّ به","دعص ترجرج حتّى كاد يلفيها",248,"ي",3,0],["وتُحِبُّ الأمُّ الخَلوبَ، وداوودُ","يُحبُّ الدّنيا، ويتْلو الزَّبورا",249,"ر",2,0],["وتحطيمُ أسوارِ الثواني بِلَمْحَةٍ","وفتحُ سماءٍ كُلُها أعينٌ شُهْلُ",250,"ل",1,0],["وتحت هاتيك أعنابٌ تلوحُ به","أطرافهُنَّ قلوبُ القومِ قِنوانُ",251,"ن",1,0],["وتحيي ليالي الرّقْص فيها خليعةٌ","تكشَّف عن سوق الحسان الكواعب",252,"ب",1,0],["وتحت ظلامِ النَّقعِ تُشرقُ أوجهُ ال","ثنا