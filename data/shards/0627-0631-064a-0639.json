لطويل"],[556,"أرى عزة من بين أثناء ذلة","https://www.aldiwan.net/poem48027.html","الطويل"],[578,"أرى عقرب الصدغ في خده","https://www.aldiwan.net/poem3658.html","المتقارب"],[581,"يعيرني أمي رجال لا أرى","https://www.aldiwan.net/poem1777.html","الطويل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2486","الوافر"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126700","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122811","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122765","الطويل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110398","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96667","الطويل"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96456","الوافر"],[1187,"","https://poetry.dctabudhabi.ae/diwan/poem/130345","الطويل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56625","السريع"],[1553,"","https://poetry.dctabudhabi.ae/diwan/poem/144585","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125375","البسيط"],[1890,"","https://poetry.dctabudhabi.ae/diwan/poem/89657","الطويل"],[1938,"","https://poetry.dctabudhabi.ae/diwan/poem/111209","الطويل"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101418","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48268","الطويل"],[2162,"","https://poetry.dctabudhabi.ae/diwan/poem/96046","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53170","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77357","الوافر"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104962","المتقارب"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100266","الوافر"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109794","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204496","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205028","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74244","الطويل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121572","الطويل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145035","المجتث"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86284","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91662","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91728","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206158","السريع"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131304",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131024",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103060","الطويل"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103552","الطويل"],[3949,"","https://poetry.dctabudhabi.ae/diwan/poem/127790","الطويل"],[3973,"","https://poetry.dctabudhabi.ae/diwan/poem/198946","الوافر"],[3977,"","https://poetry.dctabudhabi.ae/diwan/poem/99206","الطويل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105116","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94327","البسيط"],[4348,"","https://poetry.dctabudhabi.ae/diwan/poem/198566","الطويل"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117185","الطويل"],[4935,"أري عين الجميل بغير كحل","https://www.poetsgate.com/ViewPoem.aspx?id=129364",""],[5277,"حواء..ولدتني شمساً..وأولدتُها قمرين","https://www.poetsgate.com/ViewPoem.aspx?id=192760",""],[5277,"لكي لا يطمعُ الأسفُ","https://www.poetsgate.com/ViewPoem.aspx?id=199942",""],[5387,"لمن أشكو؟","https://www.poetsgate.com/ViewPoem.aspx?id=53754",""],[5387,"أهون عليكِ؟","https://www.poetsgate.com/ViewPoem.aspx?id=83392",""],[5449,"صقيع","https://www.poetsgate.com/ViewPoem.aspx?id=189106",""],[5582,"قِفُوا حَدِّثُوا عَنْ حاجِرٍ وَمُحَجَّرِ","https://www.poetsgate.com/ViewPoem.aspx?id=63520",""],[5701,"مقادير تمحو ما تشاء وتكتب","https://www.poetsgate.com/ViewPoem.aspx?id=164592",""],[5703,"عيون القلب","https://www.poetsgate.com/ViewPoem.aspx?id=207967",""],[5818,"دموع وحنين","https://www.poetsgate.com/ViewPoem.aspx?id=193070",""],[5956,"أرى عاشقي لم يزل نائما","https://www.poetsgate.com/ViewPoem.aspx?id=192948",""],[6152,"ذات الكُحل","https://www.poetsgate.com/ViewPoem.aspx?id=203130",""],[463,"أمرتكمُ أمري بنعمانَ ناصحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60004&r=&rc=60",""],[463,"أروم الوفاءَ الصعبَ بالمطلبِ السهلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60203&r=&rc=259",""],[6320,"نَزِيفُ القَهْر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84335&r=&rc=32",""]],"verses":[["أَرى عَينَها نَشوى وَبي نَشوَةُ الهَوى","فَما لِيَ أَو تَصحو نواظِرُها صَحوُ",0,"و",1,0],["أَرى عَلَيها قُلوبَ القَومِ حائِمَةً","كَالطَيرِ لاحَ لَهُ وِردٌ فَوافاهُ",1,"ا",2,0],["أَرى عَلى الأَرضِ حَلياً قَد نَسيتُ بِهِ","حَليَ السَماءِ وَحُسناً لَستُ أَنساهُ",1,"ا",2,0],["أرى عينها وهي خلاّبة","فأمسك بالكفّ منّي الضلوع",2,"ع",1,0],["أرى عيشنا تأبى المنون امتداده","كأنّا على كيس المنون نعيش",3,"ش",1,1],["أَريعُ عَلَيهِ البانُ في كُلِّ لَيلَةٍ","فَيُصبِحُ جَعداً كَالعَناقيدِ يَقطُرُ",4,"ر",1,0],["أَرى عُنوانَ أَشياءٍ","وَما يَبعُدُ أَن تَجري",5,"ر",2,0],["أرى عِرْقَ نُعماكَ صديانَ عندي","وقد كان قِدْماً ثريَّ التُرابْ",6,"ب",1,0],["أَرى عَلى بابِهِ صَرعى أَقامَ بِهِم","طولُ المَطالِ فَلا أَجدى وَلا نَجَحوا",7,"ح",3,0],["أُرى عَبدَ الصَديقِ فَإِن تَحَلّى","بِظُلمٍ فَاِرجُ عِتقي أَو إِباقي",8,"ق",2,0],["أَرى عِلَلَ الأَشياءِ شَتّى وَلا أَرى ال","تَجَمُّعَ إِلّا عِلَّةً لِلتَفَرُّقِ",9,"ق",1,0],["أَرى عَيناً قَدِ اِنقَلَبَت وَأُخرى","تُقَلِّبُ طَرفَها شَفّاً كَليلا",10,"ل",2,0],["أَرى عِلَلَ الدينا عَلَيَّ كَثيرَةً","وَصاحِبَها حَتّى المَماتِ عَليلُ",11,"ل",1,1],["أَرى عِلَلَ الدُنيا عَلَيَّ كَثيرَةً","وَصاحِبُها حَتّى المَماتِ عَليلُ",12,"ل",1,0],["أَرى عَمَلي لِلشَرِّ مِنّي بِشَهوَةٍ","وَلَستُ أَرومُ الخَيرَ إِلّا تَكَرُّها",13,"ه",2,0],["أرَى عصرَكم يُزجِي الأعاجيبَ فانْهضوا","سِراعَ الخُطَى إنّا نخاف الدوائرا",14,"ر",2,0],["أرى عِنَباً وما مِن ذَاكَ شَيْءٌ","بِمكّةَ يا لها عِظَةً ويالي",15,"ل",2,0],["أرى عدداً في الشؤم لا كثلاثةٍ","وعشر ولكن فاقَه في المصائبِ",16,"ب",1,1],["أَرَّى عَلَيها وَلِيٌّ ما يُغَيِّرُها","وَديمَةٌ حُلِّلَت فيها عَزاليها",17,"ي",3,0],["أَرى عَوَراتِ الناسِ يَخفى مَكانَها","وَعَورَتُهُ في عَقلِهِ وَلِسانِهِ",18,"ه",1,0],["أرى عاصماً لا قدّسَ اللَه عاصماً","يتيهُ إذا ما أبصر الأيرَ قائما",19,"م",2,1],["أَرى عالَماً يَرجونَ عَفوَ مَليكِهِم","بِتَقبيلِ رُكنٍ وَاِتِّخاذِ صَليبِ",20,"ب",1,0],["أَرى عالَماً يَشكو إِلى اللَهِ جَهلَهُ","وَكَم مِن بَرىً يَعلو فَيَخطُبُ مِنبَرا",21,"ر",2,0],["أَرى عَمَلاً كَلا عَمَلٍ وَأَمراً","يَجُرُّ فَسادَهُ قَدَرٌ مِصَكُّ",22,"ك",1,0],["أَرى عند الَّذي يأَتي اِنتقاداً","إذا كثر الحجى قلّ السباب",23,"ب",1,0],["أَرِيعَتِ الْحَسْناءُ في خِدْرِها","نَعَمْ دَعاها الذعْرُ أَنْ تَهْلَعَا",24,"ع",2,0],["أرى عالمًا كسدَت رُوحُهُ","على فضلاتِ الحُطام اختصم",25,"م",1,0],["أرى على خدّيك فيما أرى","بألف لون قبل العاشقين",26,"ن",1,0],["أرى عينك اخضلت وعهدي بدمعها","عصيّاً على ريب النوازل آبيا",27,"ي",2,0],["أرى عالما بالضر والبؤس قد هلك","وآخر عفوا بالجهالة قد ملك",28,"ك",1,1],["أرى على الأرضِ جرَّاراً لهُ لجبٌ","تخالهُ الأرضُ أطواداً إذا انحدرا",29,"ر",2,0],["أرى عقلي كساقيةٍ تُدارُ","وأنواعُ العلومِ لها بحارُ",30,"ر",1,1],["أرى عجباً إذا أبصرتُ قومي","وما تخلو من العجبِ الدهورُ",31,"ر",1,1],["أرى عَورَاتٍ منكَ تَظْهرُ في المَلا","ولُبسكَ عن أستارِها يَتَقَلَّصُ",32,"ص",1,0],["أرى على كل شيء","كمسحة من جلال",33,"ل",1,0],["أَرى عِندَ الرِياح لَكُم حَديثاً","أُواجِهُها فَتُمليهِ عَليّا",34,"ي",2,0],["أرَى علمَنا والمدّعُون بنوهُ","فأرفُضُ ما قالوه أو كتبوهُ",35,"و",2,1],["أَرى عِيدانَ قَوْمٍ غَيْرَ عُودِي","مِنَ الأَثْمارِ مُثْقَلَةَ الْغُصُونِ",36,"ن",1,0],["أَرَى عِنَبَ البُسْتانِ قَدْ آنَ أَكلُهُ","وَأَصْبَحَ أَحْلَى مَا يُذاقُ وَأَطْيبَا",37,"ب",2,1],["أَرى عَهد الشَباب الغَضِّ وَلّى","وَما بَقيت مِن اللذّات إِلّا",38,"ل",2,0],["أَرى عاراً وَقَد أَودوا حَياتي","فَأَنف مِن بَقائي وَمِن وُجودي",39,"د",2,0],["أرى عصفور أحلامي أمامي","وما غنى ولا خفق الجناح",40,"ح",1,0],["أَرى عَبدَ عَمرٍو قَد أَساطَ ابنَ عَمَّهِ","وَأَنضَجَهُ في غَليِ قَدرٍ وَما يَدري",41,"ر",2,1],["أَرى عُلماكم الدُنيا صبتها","فراحت أذؤباً وغدت شياها",42,"ا",3,0],["أرى عيونَ الشامتين شارةً","مصبوغة تُشعِرُ صبرا حسَنا",43,"ن",2,0],["أرى عارضاً قد طَبق الأرضَ ماؤه","وعمّ وربعي منه ليس بمبتلِّ",44,"ل",1,0],["أرى عينه عينك والغورُ بيننا","فأَدمَى لقد أبعدتَ يا سهمُ جارحا",45,"ح",2,0],["أرىْ عُشوشَ الطّيورِ فيْها","يبيتُ صَقرٌ وعنْدليبُ",46,"ب",1,0],["أريعن مدلل","غزيل يأبى الغزل",47,"ل",1,0],["أَرَى عُمْرَ هذا الشَّخْصِ في الأَصْلِ قَدْرُهُ","ثَلاثُ مِئينٍ غَيْرَ سِتِّين فارْفُضا",48,"ض",2,1],["أَرى عِزّةً مِن بَين أثناء ذلّةٍ","وعجزاً أراناهُ الزّمان لقدرةِ",49,"ه",1,1],["أَرى عَقرَبَ الصُدغِ في خَدِّهِ","وَفي كَبِدي حُمَّةُ العَقرَبِ",50,"ب",1,1],["أَرى عُصَماً مِن نَصرِ بُهثَةَ دانِياً","وَيَدفَعُني عَن آلِ زَيدٍ فَبِئسَما",51,"م",2,0],["أُري عَينَيَّ ما لَم تَرَياهُ","كِلانا عارِفٌ بِالتُرَّهاتِ",52,"ت",1,0],["أرى عجائب في الدنيا تمرّ بنا","وإنّما الدهر دهر كلّه عجبُ",53,"ب",1,0],["أرَى عَينَ الصَّديقِ وَفي بَناني","دِما ثَجٍّ تَرِقُ عَنِ العيانِ",54,"ن",1,0],["أرَى عيشَتي إن عِشتُ غَيرَ مُحَمَّدٍ","فِدَى ميتَتي إن مِتُّ غَيرَ مُذَمَّمِ",55,"م",1,0],["أرى عليها لآلي النظمِ زاهرةً","من بحر علمٍ يروقُ السمعَ والبصر",56,"ر",1,0],["أَرى عندَها ما أَشتهي بِلذاذهِ","فَما لذّة إِلّا وكان بمحضرِ",57,"ر",1,0],["أرى عَينَىَّ مَا لَم تَرأَيَاهُ","كِلاَنَا عَالِمٌ بِالتُّرَّهَاتِ",58,"ت",1,0],["أرى علماً للناس ينصب","على جامع ابن العاص أعلاه كوكب",59,"ب",1,1],["أرى عيوناً ملؤها أدمع","وأسمع الأنات تحت الصدور",60,"ر",1,0],["أرى عُصباً تيجانُها قد تَقَوّضتْ","وقد عصَبتْها بالثرى غَبَراتُها",61,"ت",3,0],["أرى عليه ضياءَ البدرِ مُنعكِساً","يكادُ يفضحُنا في دارةِ البلَدِ",62,"د",1,0],["أَرى عاجِزاً يُدعى جَليداً لِغشمه","وَلَو كلف التَقوى لِفلت مضارِبه",63,"ب",2,0],["اريعت عن الاستار بعد حميها","كما ربع في وكر المهامه واجد",64,"د",1,0],["أَرَى عُمرَاً أَولَى الكَرامَةَ أَحمداً","وَمَن غَيرُهُ أَولى بإكرامِ أَحمَدا",65,"د",2,0],["أرى عذلكم فيمن أحبُّ سفاهةً","يضيقُ الفضَا منها وظلْماً وعدوانا",66,"ن",2,0],["أرى عثمان مهتدياً ويأبى","متابعتي وآبى ما يريد",67,"د",1,0],["أرى عهدكم مثل النسيم بأرضكم","تصحّ به أشواقنا كلما اعتلاّ",68,"ل",2,0],["أَرى عَزمي يُطالِعُ بي خطوباً","شَحَذتُ لِغَربِها غَربَ الحُسامِ",69,"م",1,0],["أرى عمري مؤذِناً بالذهابِ","تَمُرُّ لياليه مَرَّ السحابِ",70,"ب",1,1],["أرى عصراً وفرد العصر فيه","يقوم مقام جمعٍ بانفرادِ",71,"د",1,0],["أرى عليه ضياءَ الحب منبعثاً","يكاد يفضحنا في دارة البلد",72,"د",1,0],["أرى عادتي للروح تعدو لتحتمي","بها والحجى كالنمر يعدو لصرعها",73,"ع",3,0],["أرى عقاربها اللاتي تدور بها","عقاربا كل حين تلدغ العمرا",74,"ر",2,0],["أَرى عبرات الكَون فاضَ عبابها","وَمُقلة هَذا الدَهر زادَ انسِكابها",75,"ب",3,1],["أرى عز غير الله للذل صائرا","وكل هني من سواه منغص",76,"ص",1,1],["أرى عليك مآت","من المناظر تترى",77,"ر",2,0],["أرى عِندَ بحثي في الأمور الدَقائِق","بأن حَياة المَرءِ بَعض الدَقائِق",78,"ق",1,1],["أَرى عهدَها الباقي عَلى غيرِ عهدنا","بِها حَيثُ شيبُ القَومِ فيها شَبابُها",79,"ب",3,0],["أَرى عُمري عَلى الدُنيا قَصيراً","وَلَكن بِالهُموم عَظيم طُول",80,"ل",1,0],["أرى على البعد هوان الدُّني","من حيثما ألمس مجد البقاء",81,"ا",2,0],["أرى عقربيها يحصيان كلاهما","على الناس أنفاساً يقال لها العمر",82,"ر",1,0],["أرى عجباً أمشي وأبرز معصما","فتمشي كما أمشي وتبرز معصما",83,"م",2,0],["أرى عينها نشوى ولي نشوة الهوى","فما لي أو تصحو نواظرها صحو",84,"و",1,0],["أرى عابد الرحمن رحمة من قست","عليه الليالي أمن من ريع بالفقر",85,"ر",1,0],["أرى عهدكم كالورد ليس بدائمٍ","ولا خير في من لا يدوم له عهدي",86,"ي",1,1],["أرى عمر الأنام كرأس مال","سعوا فيه لربحٍ أو خساره",87,"ه",1,1],["أرى عارضاً بالغَور لو أنّه يَهمِي","لعَمَّ بنُعماه المَعاهدَ من نُعمِ",88,"م",1,1],["أرى عبد الحسين له مساع","غدت لمقلد العلياء عقدا",89,"د",2,0],["أَرى عجاباً بأن العصر جاد بِهِ","إِبّانَ لا تُرتَجى للناس جودَتُهُ",90,"ت",2,0],["أرى عمر الإنسان يوماً يسره","فمن نال ذاك اليوم نال الأمانيا",91,"ي",2,0],["أرى عهدَها كالوردِ ليسَ بدائمٍ","ولا خيرَ فيمَن لا يدومُ لهُ عهدُ",92,"د",1,1],["أري عين الجميل بغير كحل","بنا فتكت فكيف إذا تكحل",93,"ل",1,1],["أرى عينيكِ ياصبحَ اغتباقي","يساقطنَ الهوى العذريَّ ندفا",94,"ف",2,0],["أرى عينيكِ في سهدي","كضوءِ الشمسِ ينكشفُ",95,"ف",1,0],["أرى عينيك في دربي وترحالي","كنبعين من اللآلاء قد كشفا",96,"ف",2,0],["أرى عينيك بالساحات والطرق","وبالأضواء والعربات والبشرِ",97,"ر",1,0],["أرى عَبرتينِ على وجنتين","هما وردتانِ بأرضٍ قفارْ",98,"ر",1,0],["أَرَى عِنْدَها ما أَشْتَهِي مِنْ لَذاذَةٍ","فَما لَذَّةٌ إِلاَّ وَكانَتْ بِمَحْضَرِي",99,"ر",2,0],["أرى عم سام مثل جنبول لا أرى","صديقا لنا فالكل ذئب وثعلب",100,"ب",1,0],["أرى عذراً أمام الناس عندي","إذا قلبي هوى وإليكَ مالا",101,"ل",2,0],["أرى عينيكِ في نومي وصحوي","وفي الأمواجِ في بدْرِ المساءِ",102,"ا",2,0],["أرى عاشقي لم يزل نائما","فأضحى شعور الهنا واجما",103,"م",2,1],["أرى عينها كالبدر يسفر نوره","فيشرق وجه الليل دون حجاب",104,"ب",1,0],["أرى عينه عينيكو الغورُ بيننا","فأدمى لقد أبعدتَ يا سهمُ جارحا",105,"ح",2,0],["أرى عارضاً قد طبّق الأرضَ ماؤه","وعتم وربعي منه ليس بمتبلِّ",106,"ل",1,0],["أَرَى عَرْقُوبَ رَمْزَ الشُّحِّ أَضْحَى","عَلَى الأَنْقَاضِ لِلْمَوْتَى إِمَاما",107,"م",2,0]]}