{"poems":[[53,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[53,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[51,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[31,"أطوي الضمير على حرارته","https://www.aldiwan.net/poem42495.html","الكامل"],[52,"كم حاسد حنق علي بلا","https://www.aldiwan.net/poem26800.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39635","الكامل"],[90,"المجلس المفجوع","https://www.poetsgate.com/ViewPoem.aspx?id=179038",""],[118,"ماض على غلوائه يجري","https://www.aldiwan.net/poem49330.html","أحذ الكامل"],[179,"يا صاحبى قفا على الأطلال","https://www.aldiwan.net/poem58842.html","الكامل"],[197,"أترى زمانك بالحمى سيعاد","https://www.aldiwan.net/poem45629.html","الكامل"],[220,"يا سعد سر مترنما","https://www.aldiwan.net/poem55397.html","مجزوء الكامل"],[233,"ياابن الدوامي الذي","https://www.aldiwan.net/poem32128.html","مجزوء الكامل"],[364,"حيث ماء الشباب في وجنتيها","https://www.aldiwan.net/poem16937.html","الخفيف"],[364,"لهفي لمقتول تلا","https://www.aldiwan.net/poem17348.html","مجزوء الكامل"],[400,"جادت على قبر الجلال","https://www.aldiwan.net/poem33476.html","مجزوء الكامل"],[406,"إن لم أمت أسفا عليه فإنني","https://www.aldiwan.net/poem32480.html","الكامل"],[438,"شهدت بإخلاصي عذول قرائحي","https://www.aldiwan.net/poem14422.html","الكامل"],[451,"بشراك هذا العم عيسي","https://www.aldiwan.net/poem61242.html","مجزوء الكامل"]],"verses":[["مُتَضايِقٍ غَصَّت بِهِ فيحُ الفَلا","ضيقَ القَلائِدِ في رِقابِ غَوانِ",0,"ن",1,0],["مُتَضايِقٌ يَدعو القَريبَ ضَجاجُهُ","أَبَداً وَيَلمَعُ بِالبَعيدِ القَسطَلُ",1,"ل",1,0],["مُتضمِّناً كشفَ الغُيُوب وتارةً","سَحَّ السُّيُوبِ دَوَافقاً لا رُشَّحَا",2,"ح",2,0],["مُتَضَمِّخٍ بِالمِسكِ يُشعِرُ بي","أَعطافَ أَجيَدَ واضِحِ النَحرِ",3,"ر",1,0],["مُتَضاحِكٍ نَحوي كَما ضَحِكَت","نارُ الذُبالَةِ وَهيَ تَحتَرِقُ",4,"ق",1,0],["متضائلَ الأفكار مهدورَ القُوى","متزايلَ الأهواءِ والأحلامِ",5,"م",1,0],["متضرّجاتٌ بالدماء زكيةٌ","فيهنَّ للجرحِ البليغِ خطاب",6,"ب",1,0],["متضاحك سلس وآونة","متوثب عن نزوة الشر",7,"ر",1,0],["مُتَضَمِّنِينَ صُدورَها تَحتَ الدُّجَى","عَسفاً بلا نَجمِ ولا بِقدالِ",8,"ل",1,0],["متضرمُ الأحشاءِ لا من لوعةٍ","لكنما استعرتْ بهِ الأكبادُ",9,"د",1,0],["متضمن تاريخها","والله خير الناصرين",10,"ن",1,0],["مُتَضايِقٌ لَو عادَ عَط","فُكَ وَاِلتِقاؤُكَ لَاِنفَرَج",11,"ج",1,0],["مِتُّ ضيقاً في الرِقِّ رِقِّ غَليلي","مَطَلَتهُ بِالوِردِ وَالوِردُ نَهبُ",12,"ب",1,0],["مُتَضَرِّجاً بِدَمٍ رَأَت","هُ الحورُ في الجَنّاتِ عِطرا",13,"ر",2,0],["متضلع في كل ف","نٍّ لا يجاري في مجال",14,"ل",1,0],["مُتضَادِدَ الأحوالِ بين غَرامِه","وإبائِه ما يستقرّ قَرارُهُ",15,"ر",2,0],["متضمناً سيل الخطية لو جرى","فوق الصرادح كُنَّ غير صرادح",16,"ح",1,0],["متضاحكين مهللين","يهزّ نشوتنا الزحام",17,"م",1,0]]}