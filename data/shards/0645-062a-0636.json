{"poems":[[55,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[55,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[53,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[33,"أطوي الضمير على حرارته","https://www.aldiwan.net/poem42495.html","الكامل"],[54,"كم حاسد حنق علي بلا","https://www.aldiwan.net/poem26800.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39635","الكامل"],[92,"المجلس المفجوع","https://www.poetsgate.com/ViewPoem.aspx?id=179038",""],[124,"ماض على غلوائه يجري","https://www.aldiwan.net/poem49330.html","أحذ الكامل"],[185,"يا صاحبى قفا على الأطلال","https://www.aldiwan.net/poem58842.html","الكامل"],[203,"أترى زمانك بالحمى سيعاد","https://www.aldiwan.net/poem45629.html","الكامل"],[227,"يا سعد سر مترنما","https://www.aldiwan.net/poem55397.html","مجزوء الكامل"],[240,"ياابن الدوامي الذي","https://www.aldiwan.net/poem32128.html","مجزوء الكامل"],[371,"حيث ماء الشباب في وجنتيها","https://www.aldiwan.net/poem16937.html","الخفيف"],[371,"لهفي لمقتول تلا","https://www.aldiwan.net/poem17348.html","مجزوء الكامل"],[409,"جادت على قبر الجلال","https://www.aldiwan.net/poem33476.html","مجزوء الكامل"],[415,"إن لم أمت أسفا عليه فإنني","https://www.aldiwan.net/poem32480.html","الكامل"],[447,"شهدت بإخلاصي عذول قرائحي","https://www.aldiwan.net/poem14422.html","الكامل"],[458,"بشراك هذا العم عيسي","https://www.aldiwan.net/poem61242.html","مجزوء الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138261",""],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72271","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79796","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87862","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83229","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206170","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59493","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86498","الكامل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93752","الكامل"],[4343,"","https://poetry.dctabudhabi.ae/diwan/poem/123795","الكامل"],[4387,"","https://poetry.dctabudhabi.ae/diwan/poem/124044","الكامل"],[4755,"مُتمسِّكونَ بِآبِقِ","https://www.poetsgate.com/ViewPoem.aspx?id=198474",""],[5183,"الدعاء الثاني","https://www.poetsgate.com/ViewPoem.aspx?id=185885",""],[5431,"المال...رأسُ الفضائل في الدُنى هجرانُه","https://www.poetsgate.com/ViewPoem.aspx?id=199562",""],[5764,"دمعة قهر !","https://www.poetsgate.com/ViewPoem.aspx?id=144510",""],[5956,"الله وحدَهُ فاطرُ الأكوانِ","https://www.poetsgate.com/ViewPoem.aspx?id=183100",""],[5956,"يا ربِّ لا تقطعْ بعنسٍ شمليا","https://www.poetsgate.com/ViewPoem.aspx?id=183497",""]],"verses":[["مُتَضايِقٍ غَصَّت بِهِ فيحُ الفَلا","ضيقَ القَلائِدِ في رِقابِ غَوانِ",0,"ن",1,0],["مُتَضايِقٌ يَدعو القَريبَ ضَجاجُهُ","أَبَداً وَيَلمَعُ بِالبَعيدِ القَسطَلُ",1,"ل",1,0],["مُتضمِّناً كشفَ الغُيُوب وتارةً","سَحَّ السُّيُوبِ دَوَافقاً لا رُشَّحَا",2,"ح",2,0],["مُتَضَمِّخٍ بِالمِسكِ يُشعِرُ بي","أَعطافَ أَجيَدَ واضِحِ النَحرِ",3,"ر",1,0],["مُتَضاحِكٍ نَحوي كَما ضَحِكَت","نارُ الذُبالَةِ وَهيَ تَحتَرِقُ",4,"ق",1,0],["متضائلَ الأفكار مهدورَ القُوى","متزايلَ الأهواءِ والأحلامِ",5,"م",1,0],["متضرّجاتٌ بالدماء زكيةٌ","فيهنَّ للجرحِ البليغِ خطاب",6,"ب",1,0],["متضاحك سلس وآونة","متوثب عن نزوة الشر",7,"ر",1,0],["مُتَضَمِّنِينَ صُدورَها تَحتَ الدُّجَى","عَسفاً بلا نَجمِ ولا بِقدالِ",8,"ل",1,0],["متضرمُ الأحشاءِ لا من لوعةٍ","لكنما استعرتْ بهِ الأكبادُ",9,"د",1,0],["متضمن تاريخها","والله خير الناصرين",10,"ن",1,0],["مُتَضايِقٌ لَو عادَ عَط","فُكَ وَاِلتِقاؤُكَ لَاِنفَرَج",11,"ج",1,0],["مِتُّ ضيقاً في الرِقِّ رِقِّ غَليلي","مَطَلَتهُ بِالوِردِ وَالوِردُ نَهبُ",12,"ب",1,0],["مُتَضَرِّجاً بِدَمٍ رَأَت","هُ الحورُ في الجَنّاتِ عِطرا",13,"ر",2,0],["متضلع في كل ف","نٍّ لا يجاري في مجال",14,"ل",1,0],["مُتضَادِدَ الأحوالِ بين غَرامِه","وإبائِه ما يستقرّ قَرارُهُ",15,"ر",2,0],["متضمناً سيل الخطية لو جرى","فوق الصرادح كُنَّ غير صرادح",16,"ح",1,0],["متضاحكين مهللين","يهزّ نشوتنا الزحام",17,"م",1,0],["متضمن غرر البيان وجامع","درر اللسان نوادراً وشواردا",18,"د",2,0],["متضاعف الحسرات مسلو","الجوارح بالجراح",19,"ح",1,0],["متضوّعٌ أرجُ السيادةِ من","عطفي علاه بأطيب النشر",20,"ر",1,0],["مُتَضامِنينَ عَلى النِضالِ فَما تَرى","إِلّا مَسيحِيّاً يُؤازِرُ مُسلِما",21,"م",2,0],["متضمنان القدح في نفس الألو","هة كم بذاك القدح من نقصان",22,"ن",1,0],["مُتَضامِناً يَحمي الخَميلَةَ وَالحِمى","وَيَذودُ عَن حُريَّةَ الأَحفادِ",23,"د",1,0],["متضاحكين على الشجا وذحولكم","في الصدر كامنة كمون النار",24,"ر",1,0],["متضرمٌ كالنارِ من أشَرٍ به","وإذا جرى مثلَ الشَّهاب المرسلِ",25,"ل",1,0],["متضوعاً كالروض باكره","صوب الغمام فراق زخرفه",26,"ف",2,0],["متضمنات للبشائر آية","رفعت لَها في عرشك الرايات",27,"ت",1,0],["متضرّج الوجنات عنبر خاله","أسر القلوب بطرفه النعاس",28,"س",1,0],["متضرعا أشكو إليه بلابلي","فعساه يرحم آهتي وتململي",29,"ل",2,0],["مُتضاحِكونَ لِقادمٍ","مُتشبّثونَ بسابقِ",30,"ق",1,0],["متضلعا متطلعا متضرعا","بعلومه لفهومة لكيانه",31,"ن",2,0],["متضرجٌ بدم الشعوب كيانه","تُبنى على جثث الهوى حيطانه",32,"ن",2,0],["متضايقه حيل والله يعلم احساسي","ياكم دمعة قهر ..بتطّيح مآ طاحت",33,"ت",1,0],["مُتضامنٌ معها بحبل إلهنا","وبفهمها حقاً بلا نقصانِ",34,"ن",1,0],["متضجّر أنا ما المواشي قُرْبيا","يا ربِّ لا تقطعْ بِعَنْزٍ شَمْليا",35,"ي",2,1]]}