{"poems":[[55,"هي سلوة ذهبت بكل غرام","https://www.aldiwan.net/poem29797.html","الكامل"],[55,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[79,"مولاي يهنيك المطر","https://www.aldiwan.net/poem36506.html","مجزوء الكامل"],[95,"أليوم عيد البائس المتألم","https://www.aldiwan.net/poem11290.html","الكامل"],[53,"لا زلت أبيض غرة وأياد","https://www.aldiwan.net/poem11439.html","الكامل"],[93,"هذي الوغى مشبوبة النيران","https://www.aldiwan.net/poem62764.html","عموديه"],[93,"الحشد ملء الدار لكن","https://www.aldiwan.net/poem62804.html","عموديه"],[94,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[87,"يا أيها الناعي أبا الوزراء","https://www.aldiwan.net/poem62939.html","الكامل"],[47,"نفسي الفداء لمن أوده","https://www.aldiwan.net/poem63470.html","مجزوء الكامل"],[47,"ما لذا الظبي لاينال إقتناصه","https://www.aldiwan.net/poem64618.html","الخفيف"],[46,"لمكاسر الحسن بن وهب أطيب","https://www.aldiwan.net/poem30585.html","الكامل"],[46,"لو أن دهرا رد رجع جواب","https://www.aldiwan.net/poem30590.html","الكامل"],[76,"خذها يرن لها الجواد صهيلا","https://www.aldiwan.net/poem13220.html","الكامل"],[104,"برقت له مسنونة تتلهب","https://www.aldiwan.net/poem33042.html","الكامل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[108,"تحية وتقدير","https://www.poetsgate.com/ViewPoem.aspx?id=179700",""],[93,"معركة بورغاس","https://www.poetsgate.com/ViewPoem.aspx?id=53308",""],[170,"وفت السعود بوعدها المضمون","https://www.aldiwan.net/poem46843.html","الكامل"],[201,"أشجى الرفاق تأوهي وتوجعي","https://www.aldiwan.net/poem39946.html","الكامل"],[280,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[287,"صاد الفؤاد برمل رامة ريم","https://www.aldiwan.net/poem32627.html","الكامل"],[287,"من منقذي من منقذي عشقه","https://www.aldiwan.net/poem32792.html","الكامل"],[382,"قد حاز يوحنا الجنين كماله","https://www.aldiwan.net/poem59246.html","الكامل"],[435,"هبت نسيمات السرور","https://www.aldiwan.net/poem40742.html","مجزوء الكامل"],[435,"هاجت رياح بالشمال تجول","https://www.aldiwan.net/poem41032.html","الكامل"],[469,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[469,"يا من لابيض كل جفن اسود","https://www.aldiwan.net/poem3536.html","عموديه"],[482,"أما هواك وان تقادم عهده","https://www.aldiwan.net/poem15208.html","الكامل"],[484,"نبه لحاظك فالصباح قريب","https://www.aldiwan.net/poem36933.html","الكامل"],[484,"يهتز صوتهما الرنين","https://www.aldiwan.net/poem37615.html","مجزوء الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70753","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62534","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122081","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95529","الكامل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82667","الكامل"],[1879,"","https://poetry.dctabudhabi.ae/diwan/poem/198784","الكامل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202169","الكامل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46743","الكامل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83225","الكامل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93426","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202588","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203494","الكامل"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147331","الكامل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145062","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66455","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109928","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216628",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111451","الكامل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119433","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123488","الكامل"],[4387,"","https://poetry.dctabudhabi.ae/diwan/poem/124044","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133083","الرجز"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139732",""],[4859,"مازال في صدري كلام!","https://www.poetsgate.com/ViewPoem.aspx?id=190043",""],[5064,"فانُوسُ اللَّيَالِي","https://www.poetsgate.com/ViewPoem.aspx?id=199168",""],[3591,"حيّا منازلنا الغزال الأمنع","https://www.poetsgate.com/ViewPoem.aspx?id=149381",""],[5147,"من عاذلي ومن البلية","https://www.poetsgate.com/ViewPoem.aspx?id=166725",""],[5277,"مجاهيل الحلا","https://www.poetsgate.com/ViewPoem.aspx?id=191279",""],[5277,"طيفُ القلم..","https://www.poetsgate.com/ViewPoem.aspx?id=211102",""],[5296,"وحدي أنا","https://www.poetsgate.com/ViewPoem.aspx?id=155353",""],[5431,"النارنج قصة عاشقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=202098",""],[5431,"تبارك الله أحسن الخالقين...","https://www.poetsgate.com/ViewPoem.aspx?id=203151",""],[3294,"ربع محا الحدثان رسمه","https://www.poetsgate.com/ViewPoem.aspx?id=173276",""],[5444,"شمسُ الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=205079",""],[5725,"قولي لحسنك","https://www.poetsgate.com/ViewPoem.aspx?id=192489",""],[402,"اليوم عيد البائس المتألم","https://www.poetsgate.com/ViewPoem.aspx?id=36427",""],[5956,"إذا شاخ الدمُ","https://www.poetsgate.com/ViewPoem.aspx?id=183934",""],[5956,"قرُبَ الوداعُ","https://www.poetsgate.com/ViewPoem.aspx?id=193570",""],[5969,"الساعةُ الواحدة بعد منتصف العشق","https://www.poetsgate.com/ViewPoem.aspx?id=198666",""]],"verses":[["مُتَدَفِّقِ القُطرَينِ يَرجُفُ نَقعُهُ","بِعَصائِبِ الراياتِ وَالأَعلامِ",0,"م",1,0],["مُتَداوِلينَ لِباسَ أَثوابِ العُلى","هَذا يُجابُ لَهُ وَهَذا يُنزَعُ",1,"ع",1,0],["مُتدارِكُ الدَّفَعاتِ يُحْ","سَبُ منْ بَنانِكَ قدْ قَطَرْ",2,"ر",1,0],["مُتَدَارِكِينَ عَوَادِي الدُّنْيَا بِمَا","أُوتُوا مِنَ الرَّأْيِ الأَسَدِّ الأَحْزَمِ",3,"م",1,0],["متدرِّعاً خِلعاً أنسْتَ بِلُبْسِها","أنْس المعَوَّد لُبْسَها المعتادِ",4,"د",1,0],["مُتَدَفِّقٌ كَالسَيلِ في الغُدرانِ","مُتَدَفِّعٌ كَالعاصِفِ المِرنانِ",5,"ن",1,0],["مُتَدافِعَينِ كَمَوجَتَي","نِ خُطاهُ تَتبَعُها خُطاها",6,"ا",3,0],["متدفِّعاً في أُفْقهِ المُتَرامي","والرِّيحُ تخفقُ في الفَضَاءِ وفي الثَّرى",7,"ر",2,0],["مُتَدَرِّعٍ صبرَ الكِرامِ عَلى الأَذى","إِنَّ الكِرامَ مَشاغِلُ السُفَهاءِ",8,"ا",2,0],["مُتَدَفِّقٌ بِعَطائِهِ","كَالنَيلِ لَمّا جاشَ مَدُّه",9,"د",2,0],["مُتَداني الثُغبانِ إِذ لَيسَ لِلما","تِحِ إِلّا الثَرى وَإِلّا إِمتِصاصُه",10,"ص",2,0],["مُتَدَسِّمُ الثَوبَينِ يَنظُرُ زادَهُ","نَظَرٌ يُحَدِّقُهُ وَخَدٌّ صُلَّبُ",11,"ب",1,0],["مُتَدَفِّقاً صَقَلوا بِهِ أَحسابَهُم","إِنَّ السَماحَةَ صَيقَلُ الأَحسابِ",12,"ب",1,0],["مُتَدَفِّقاً أَعيا العُقولَ طَريقُهُ","فَكَأَنَّما رَكِبَ المَجَرَّ سَبيلا",13,"ل",2,0],["متدفقٌ بدمائه متقلبٌ","متعلّقٌ بدَمائِه متوثب",14,"ب",1,0],["متدفقاً مثل العُباب ومُزبداً","متفجراً كالسَّيل في أعماقي",15,"ي",1,0],["مُتَدلِّلاتٍ ما عَرَفْن صَبَابةً","نَشْوَى وما لَعِبتْ بهنّ عُقَار",16,"ر",1,0],["متدفِّقَ الأُسلوب، تَحس","بُهُ نميرًا في انسِيابه",17,"ب",2,0],["متدّفق كالسّيل في الغدرا","متدفّع كالعاصف المرتان",18,"ن",1,0],["مُتدحْرجاُ من طَودِ نخوتهِ إلى","سفْحٍ من القدْرِ الدَّنِّي الدُّونِ",19,"ن",1,0],["مُتدلّهٍ يَبكي ويَلثُمُ رَسمَها","ويَضُمُّهُ لفؤادهِ المتقَطّع",20,"ع",1,0],["مُتَدانِي الخُطْوَةِ مِنْ تَرَفٍ","أَتُرَى الأَحجالُ تُقَيِّدُهُ",21,"د",2,0],["مُتَدَلِّلٌ صَلَفاً عَلى مُتَذَلِّلٍ","كَلَفاً يَهُمُّ بِسَلوَةٍ فَيَهيمُ",22,"م",1,0],["مُتَدَلِّلٌ صَلَفاً عَلى مُتَذَلِّلٍ","كَلِفاً وَلَيسَ لَهُ إِلَيهِ مَنفَذُ",23,"ذ",1,0],["متدجِّجاً بسلاح روحٍ قبل أن","تتدجَّجَ الأعضا السلاحَ بتَمِّه",24,"م",2,0],["متدفقاً فكأنه","كف الشهابيّ البشيرِ",25,"ر",1,0],["متدفق متزايد يومان مع","ليل تواصل هطله الموصول",26,"ل",1,0],["متدلل خلف الحمام وعيده","وعد الوصال أخا الحياة فأخلفا",27,"ف",2,0],["متدفقٌ كالماءِ لينُ إهابه","يلقى القنا وكأنّه من جلمد",28,"د",1,0],["متد فِّق الشوْبوبِ يبسِمُ بر قُه","في المزنِ عُجْهاً حينَ يبكي رَعْدُه",29,"د",2,0],["متدت الأسلاك من أنوارها","فوق السهول وللشعاع لهيب",30,"ب",1,0],["متدليان كلاهما","قد شد بالحبل المتين",31,"ن",1,0],["مُتدرِّعاً بالحزم ذِمْراً مُبْصرا","بالرأي لا وانٍ ولا عجلانا",32,"ن",2,0],["متداركٌ عزّ الامام وحزبه","مستعقب الماضي بنصر العَاجلِ",33,"ل",1,0],["مُتَدَفِّقٌ عِلْماً يُغَصُّ بِرِيقِهِ","مَنْ جَاءَ يَخْصِمُ أَعْظَمَ الإِغْصَاصِ",34,"ص",1,0],["متدثر ثوب الملاحة مثلمَا","أضحى عليٌّ بالعلَى يتزمَّل",35,"ل",1,0],["مُتَدرِّعين قُلوبَهُم","فَوقَ الدُّروعِ لَدى التَّنازل",36,"ل",1,0],["متدِّرعاً بتُقَى الإله مسلَّحاً","بعزيمة الأبرار في مَرضاتهِ",37,"ت",2,0],["مُتَدَفِّق كرماً وبأْساً ما لَهُ","عن ذا ولا عن ذاك مِنْ إِقلاعِ",38,"ع",1,0],["مُتَدافِعٍ بالحملِ غَيرَ مواكِلٍ","شَهمٍ إِذا اِستَعجلته شِملالِ",39,"ل",1,0],["مُتَدَفِّعاً نَحوَ الجَنابِ وَقَلبُهُ","قَد فاضَ إِخلاصاً إِلَيهِ مُدَفَّعا",40,"ع",2,0],["مُتدرعٌ بِالوشي إِلا أَن مِد","رَعَهُ يحاكُ عَلَيهِ غَيرَ طَويلِ",41,"ل",1,0],["متدّينٌ الا بإزعاج الورى","فالدين ازعاج الورى وتزمُّت",42,"ت",1,0],["متدينون بكفرهم انظر لهم","تخذوا لكفرهم التعصب دينا",43,"ن",2,0],["مُتَدَثِّرًا بِالجُرْحِ يَنْفُضُ طَعْنَةً","مَسْمُومَةَ مِن مَارِدٍ غَدَّارِ!",44,"ر",1,0],["متدفقا كالموج لكن صنته","عن شاطئ الحمات والأكدار",45,"ر",1,0],["متداخلاً تلقاه كر طعانه","متجمعاً مثل الكمام المفرد",46,"د",1,0],["مُتَدثِّراً ناسُوتَنا وَهُوَ الذي","مازالَ متَّشِحَ الضِياءِ كما الردا",47,"د",2,0],["متدفّع الأمواج تر","قص وفق توقيع الخرير",48,"ر",1,0],["مُتَدَجِّجاً كاللَّيثِ حامَ عَلَيهِ لا","يَخشى وَلا تَلوِيهِ جَمهَرَةُ المَلا",49,"ل",2,0],["متدرع في السلم ثوب غلالة","درعا مظاهرة بثوب أخضر",50,"ر",1,0],["متداركا بالتوب فارط ما مضى","مع صبّ دمع هاطل ثجاج",51,"ج",1,0],["متدرع زغف الشريعة راضع","محض المعارف من ثديّ حفّل",52,"ل",1,0],["متدرعاً برد القناعة رافلاً","في خلعة التسليم والإيمان",53,"ن",1,0],["متدفق الكفَّين سال نداهما","في الأرض فاخضرَّت به الآكام",54,"م",1,0],["متدثرٌ بالصمتِ","إنّ الصمتَ مرآةُ السلام",55,"م",1,0],["مُتدَفِّقُونَ فلا قرَارَ لبحرِهمْ","موجٌ يجيءُ بهمْ وآخرُ يذهَبُ",56,"ب",1,0],["متدكراً قبل الحنين لمثلها","ولى التذكر ضمها استرجع",57,"ع",1,0],["متدلياً من طوره الأ","على ومصدره المعلى",58,"ل",2,0],["متدللٌ رقتْ بوجنته الصبا","حُقَّ الدلالِ لوجهه مما جلا",59,"ل",2,0],["متدّرعاً بالحبِّ رغمَ تعاستي","من قسوةِ الشطّارِ والحكّامِ",60,"م",1,0],["متدثرٌ بالشوقِ أمضي لحظةً","مَرَّتْ كَعُمْرٍ في خريفِ زماني",61,"ن",2,0],["متدفقٌ نحو الفرات بدمعه","متوجعٌ متلوعٌ مشتاقُ",62,"ق",1,0],["متدبرا بالعلم مقتنعا","متأملا متمحّص النظرة",63,"ر",2,0],["متدرعا من صبره","درعا أبى الايمان فصمه",64,"م",2,0],["مُتدثراً بنَعيمِ وَعدٍ، نُورُه","جعلَ الفؤادَ يَرى الحبيبَ عَيانا",65,"ن",2,0],["متدرعا حلل الجمال بغارة","شعواء شقّت للظلام صباحهُ",66,"ح",2,0],["متداركين عوادي الدنيا بما","أوتوا من الرأي الأسد الحزم",67,"م",1,0],["متدلل هو بيننا متحكِّم","فيما يجود لنا وفيما يحرمُ",68,"م",1,0],["متدخل بشؤونكم متحجّرٌ","وبمخّه رجعيّةٌ وجماحُ",69,"ح",1,0],["مُتداخلٌ في مَوجِ لَيلٍ مُعتِمٍ","جَفْنُ السماء بِهَمهِ يَتَكَحلُ",70,"ل",1,0]]}