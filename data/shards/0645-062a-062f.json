{"poems":[[53,"هي سلوة ذهبت بكل غرام","https://www.aldiwan.net/poem29797.html","الكامل"],[53,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[77,"مولاي يهنيك المطر","https://www.aldiwan.net/poem36506.html","مجزوء الكامل"],[93,"أليوم عيد البائس المتألم","https://www.aldiwan.net/poem11290.html","الكامل"],[51,"لا زلت أبيض غرة وأياد","https://www.aldiwan.net/poem11439.html","الكامل"],[91,"هذي الوغى مشبوبة النيران","https://www.aldiwan.net/poem62764.html","عموديه"],[91,"الحشد ملء الدار لكن","https://www.aldiwan.net/poem62804.html","عموديه"],[92,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[85,"يا أيها الناعي أبا الوزراء","https://www.aldiwan.net/poem62939.html","الكامل"],[45,"نفسي الفداء لمن أوده","https://www.aldiwan.net/poem63470.html","مجزوء الكامل"],[45,"ما لذا الظبي لاينال إقتناصه","https://www.aldiwan.net/poem64618.html","الخفيف"],[44,"لمكاسر الحسن بن وهب أطيب","https://www.aldiwan.net/poem30585.html","الكامل"],[44,"لو أن دهرا رد رجع جواب","https://www.aldiwan.net/poem30590.html","الكامل"],[74,"خذها يرن لها الجواد صهيلا","https://www.aldiwan.net/poem13220.html","الكامل"],[102,"برقت له مسنونة تتلهب","https://www.aldiwan.net/poem33042.html","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[106,"تحية وتقدير","https://www.poetsgate.com/ViewPoem.aspx?id=179700",""],[91,"معركة بورغاس","https://www.poetsgate.com/ViewPoem.aspx?id=53308",""],[166,"وفت السعود بوعدها المضمون","https://www.aldiwan.net/poem46843.html","الكامل"],[197,"أشجى الرفاق تأوهي وتوجعي","https://www.aldiwan.net/poem39946.html","الكامل"],[275,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[282,"صاد الفؤاد برمل رامة ريم","https://www.aldiwan.net/poem32627.html","الكامل"],[282,"من منقذي من منقذي عشقه","https://www.aldiwan.net/poem32792.html","الكامل"],[377,"قد حاز يوحنا الجنين كماله","https://www.aldiwan.net/poem59246.html","الكامل"],[429,"هبت نسيمات السرور","https://www.aldiwan.net/poem40742.html","مجزوء الكامل"],[429,"هاجت رياح بالشمال تجول","https://www.aldiwan.net/poem41032.html","الكامل"],[464,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[464,"يا من لابيض كل جفن اسود","https://www.aldiwan.net/poem3536.html","عموديه"],[477,"أما هواك وان تقادم عهده","https://www.aldiwan.net/poem15208.html","الكامل"],[479,"نبه لحاظك فالصباح قريب","https://www.aldiwan.net/poem36933.html","الكامل"],[479,"يهتز صوتهما الرنين","https://www.aldiwan.net/poem37615.html","مجزوء الكامل"]],"verses":[["مُتَدَفِّقِ القُطرَينِ يَرجُفُ نَقعُهُ","بِعَصائِبِ الراياتِ وَالأَعلامِ",0,"م",1,0],["مُتَداوِلينَ لِباسَ أَثوابِ العُلى","هَذا يُجابُ لَهُ وَهَذا يُنزَعُ",1,"ع",1,0],["مُتدارِكُ الدَّفَعاتِ يُحْ","سَبُ منْ بَنانِكَ قدْ قَطَرْ",2,"ر",1,0],["مُتَدَارِكِينَ عَوَادِي الدُّنْيَا بِمَا","أُوتُوا مِنَ الرَّأْيِ الأَسَدِّ الأَحْزَمِ",3,"م",1,0],["متدرِّعاً خِلعاً أنسْتَ بِلُبْسِها","أنْس المعَوَّد لُبْسَها المعتادِ",4,"د",1,0],["مُتَدَفِّقٌ كَالسَيلِ في الغُدرانِ","مُتَدَفِّعٌ كَالعاصِفِ المِرنانِ",5,"ن",1,0],["مُتَدافِعَينِ كَمَوجَتَي","نِ خُطاهُ تَتبَعُها خُطاها",6,"ا",3,0],["متدفِّعاً في أُفْقهِ المُتَرامي","والرِّيحُ تخفقُ في الفَضَاءِ وفي الثَّرى",7,"ر",2,0],["مُتَدَرِّعٍ صبرَ الكِرامِ عَلى الأَذى","إِنَّ الكِرامَ مَشاغِلُ السُفَهاءِ",8,"ا",2,0],["مُتَدَفِّقٌ بِعَطائِهِ","كَالنَيلِ لَمّا جاشَ مَدُّه",9,"د",2,0],["مُتَداني الثُغبانِ إِذ لَيسَ لِلما","تِحِ إِلّا الثَرى وَإِلّا إِمتِصاصُه",10,"ص",2,0],["مُتَدَسِّمُ الثَوبَينِ يَنظُرُ زادَهُ","نَظَرٌ يُحَدِّقُهُ وَخَدٌّ صُلَّبُ",11,"ب",1,0],["مُتَدَفِّقاً صَقَلوا بِهِ أَحسابَهُم","إِنَّ السَماحَةَ صَيقَلُ الأَحسابِ",12,"ب",1,0],["مُتَدَفِّقاً أَعيا العُقولَ طَريقُهُ","فَكَأَنَّما رَكِبَ المَجَرَّ سَبيلا",13,"ل",2,0],["متدفقٌ بدمائه متقلبٌ","متعلّقٌ بدَمائِه متوثب",14,"ب",1,0],["متدفقاً مثل العُباب ومُزبداً","متفجراً كالسَّيل في أعماقي",15,"ي",1,0],["مُتَدلِّلاتٍ ما عَرَفْن صَبَابةً","نَشْوَى وما لَعِبتْ بهنّ عُقَار",16,"ر",1,0],["متدفِّقَ الأُسلوب، تَحس","بُهُ نميرًا في انسِيابه",17,"ب",2,0],["متدّفق كالسّيل في الغدرا","متدفّع كالعاصف المرتان",18,"ن",1,0],["مُتدحْرجاُ من طَودِ نخوتهِ إلى","سفْحٍ من القدْرِ الدَّنِّي الدُّونِ",19,"ن",1,0],["مُتدلّهٍ يَبكي ويَلثُمُ رَسمَها","ويَضُمُّهُ لفؤادهِ المتقَطّع",20,"ع",1,0],["مُتَدانِي الخُطْوَةِ مِنْ تَرَفٍ","أَتُرَى الأَحجالُ تُقَيِّدُهُ",21,"د",2,0],["مُتَدَلِّلٌ صَلَفاً عَلى مُتَذَلِّلٍ","كَلَفاً يَهُمُّ بِسَلوَةٍ فَيَهيمُ",22,"م",1,0],["مُتَدَلِّلٌ صَلَفاً عَلى مُتَذَلِّلٍ","كَلِفاً وَلَيسَ لَهُ إِلَيهِ مَنفَذُ",23,"ذ",1,0],["متدجِّجاً بسلاح روحٍ قبل أن","تتدجَّجَ الأعضا السلاحَ بتَمِّه",24,"م",2,0],["متدفقاً فكأنه","كف الشهابيّ البشيرِ",25,"ر",1,0],["متدفق متزايد يومان مع","ليل تواصل هطله الموصول",26,"ل",1,0],["متدلل خلف الحمام وعيده","وعد الوصال أخا الحياة فأخلفا",27,"ف",2,0],["متدفقٌ كالماءِ لينُ إهابه","يلقى القنا وكأنّه من جلمد",28,"د",1,0],["متد فِّق الشوْبوبِ يبسِمُ بر قُه","في المزنِ عُجْهاً حينَ يبكي رَعْدُه",29,"د",2,0],["متدت الأسلاك من أنوارها","فوق السهول وللشعاع لهيب",30,"ب",1,0],["متدليان كلاهما","قد شد بالحبل المتين",31,"ن",1,0]]}