{"poems":[[53,"قعد الراضون بالذل فقم","https://www.aldiwan.net/poem29750.html","الرمل"],[53,"لا يبعد الله فتيانا رزئتهم","https://www.aldiwan.net/poem29949.html","البسيط"],[53,"يا غائبا نقض الودادا","https://www.aldiwan.net/poem30597.html","مجزوء الكامل"],[27,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[95,"أمتي هل لك بين الأمم","https://www.aldiwan.net/poem60148.html","عموديه"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"رقاب أهل الحلوم معتبده","https://www.aldiwan.net/poem61895.html","المنسرح"],[51,"يا ليت شعري والحوادث جمة","https://www.aldiwan.net/poem65459.html","الكامل"],[51,"يا ابن أبي الجهم احتقب هذا اللطف","https://www.aldiwan.net/poem65467.html","الرجز"],[51,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[51,"سمعا أبا إسحق إنك ماجد","https://www.aldiwan.net/poem66524.html","الكامل"],[85,"مشيئة الله كانت","https://www.aldiwan.net/poem6834.html","المجتث"],[85,"قم للمعلم وفه التبجيلا","https://www.aldiwan.net/poem15422.html","الكامل"],[45,"صبابة راح عنها غير مزجور","https://www.aldiwan.net/poem63640.html","البسيط"],[45,"يزداد في غي الصبا ولعه","https://www.aldiwan.net/poem64662.html","الكامل"],[45,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[28,"إن النوائح لا يعدون في عمر","https://www.aldiwan.net/poem5102.html","البسيط"],[107,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[80,"هل أقصر الدهر عن تعنيت ذي أدب","https://www.aldiwan.net/poem31565.html","البسيط"],[44,"نثرت فريد مدامع لم ينظم","https://www.aldiwan.net/poem30353.html","الكامل"],[87,"كل صعب سوى المذلة سهل","https://www.aldiwan.net/poem8345.html","الخفيف"],[90,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[102,"لا تبالي بألف خطب عراها","https://www.aldiwan.net/poem32997.html","الخفيف"],[46,"يغني الفتى ملبس يستره","https://www.aldiwan.net/poem22922.html","المنسرح"],[1,"أصحوت اليوم أم شاقتك هر","https://www.aldiwan.net/poem33999.html","الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19015","الخفيف"],[28,"أما قريش أبا حفص فقد رزئت","https://www.poetsgate.com/ViewPoem.aspx?id=21599",""],[143,"فت الورى فعلام ذا الإجهاد","https://www.aldiwan.net/poem11754.html","الكامل"],[185,"لا أظلم البين حالي كالذي كانا","https://www.aldiwan.net/poem14679.html","البسيط"],[186,"سقط العتاب عن الفقي","https://www.aldiwan.net/poem43834.html","مجزوء الكامل"],[235,"أهلا بطلعة زائر","https://www.aldiwan.net/poem31608.html","مجزوء الكامل"],[297,"وافى إليك بكأس الراح يرتاح","https://www.aldiwan.net/poem33302.html","البسيط"],[305,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[320,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[322,"اليأس من طول الثواء رواح","https://www.aldiwan.net/poem56342.html","الكامل"],[328,"أبنجواي من رقيق النشيد","https://www.aldiwan.net/poem55060.html","الخفيف"],[366,"اقرا الدموع فإنها عنواني","https://www.aldiwan.net/poem17127.html","الكامل"],[366,"يا من إذا ولي البلاد فإنما","https://www.aldiwan.net/poem17204.html","الكامل"],[391,"خذ من الوقت ما سمح","https://www.aldiwan.net/poem54594.html","عموديه"],[400,"أغلى الهدايا","https://www.aldiwan.net/poem6722.html","عموديه"],[405,"من كان يبغي علو الذكر والشرفا","https://www.aldiwan.net/poem49526.html","البسيط"],[437,"شمل العلا في ذراك مجتمع","https://www.aldiwan.net/poem2549.html","المنسرح"],[437,"راح يخشى في حبه الرقباء","https://www.aldiwan.net/poem2550.html","الخفيف"],[439,"كذا تتجلى الشمس بعد كسوفها","https://www.aldiwan.net/poem34867.html","الطويل"],[458,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[458,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[495,"كم حسرات لي وكم وجد","https://www.aldiwan.net/poem9818.html","السريع"],[505,"غزّة","https://www.aldiwan.net/poem61086.html","المتدارك"],[514,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[551,"رضيت بالدون لما لم أجد وزرا","https://www.aldiwan.net/poem47161.html","البسيط"],[553,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[562,"يا بائع الصبر لا تشفق على الشاري","https://www.aldiwan.net/poem52764.html","البسيط"],[562,"ماذا شعوب بني عثمان تنتظر","https://www.aldiwan.net/poem52830.html","البسيط"],[562,"لا يلزم القمر المنير المشرقا","https://www.aldiwan.net/poem52951.html","الكامل"]],"verses":[["لا يُلاقونِيَ إِلّا خائِضاً","أَخطُمُ الأَقوالَ مِنهُم وَأَزُمّ",0,"م",1,0],["لا يَلبَثُ المَرءُ يُبلي شَرخَ جِدَّتِهِ","مِنَ الزَمانِ جَديدٌ ما لَهُ خَلَقُ",1,"ق",1,0],["لا يَلبَسُ الوُدَّ الطَري","فَ مِجامِلٌ خَلَعَ التِلادا",2,"د",2,0],["لا يُلبِثُ القُرَناءَ أَن يَتَفَرَّقوا","لَيلٌ يَكُرُّ عَلَيهِمُ وَنَهارُ",3,"ر",1,0],["لايلام الذئب في عدوانه","إن يك الراعي عدوَّ الغنم",4,"م",1,0],["لا يلَهِّيهِ عنه خفضٌ ولا ين","ساه عند المُرْبَدَّةِ الشَّوْهَاءِ",5,"ا",2,0],["لا يَلْحني جارمٌ سطوتُ به","من زرع الشرَّ عامداً حصدَهْ",6,"د",2,0],["لا يُلفَ وعدك والبنفسج كاسمه","في حلية التنكير والتصحيفِ",7,"ف",1,0],["لا يلتقي فيه العفاف والشرف","بل تلتقي فيه بظور وقلف",8,"ف",1,0],["لا يلمْهُ لائمٌ في فعله","فله عُذرانِ عند الفَطَنه",9,"ن",2,0],["لا يُلْفِينَّك ذو الجلال مُحاولاً","تَبْيينَ مَطْموسٍ وطَمْسَ مُبين",10,"ن",1,0],["لا يلفظ اللفظ طيشا","ولا يذيل اليمينا",11,"ن",2,0],["لا يَلمَسُ الدُستورُ فيكُم روحَهُ","حَتّى يَرى جُندِيَّهُ المَجهولا",12,"ل",2,0],["لا يَلبَثُ الحُلمُ يَدعوهُ فَيَتبَعُهُ","تَأَلُّقَ البَرقِ في طَخياءِ دَيجورِ",13,"ر",1,0],["لايَلبَثُ المَمنوعُ تَطلُبَهُ","حَتّى يَثوبَ إِلَيكَ مُمتَنِعُه",14,"ع",2,0],["لا يُلَذُّ المُلتَقى إِن لَم يَكُن","باعِثُ الشَوقِ لَذيذَ المُعتَنَق",15,"ق",1,0],["لا يُلقِيَن بِيَدَيهِ الدَهرَ ذي حَسَبٍ","يَرجو الفِداءَ إِذا ما رُمحُهُ اِنكَسَرا",16,"ر",2,0],["لا يَلْقُطُ الحَبَّ إلا فِي مَنَازِلِكُمْ","ولا يُقِيمُ سِوَى مِنْ شَوْقِهِ الأَوَدَا",17,"د",2,0],["لا يلحظُ الحرَّ إلّا مثلما وَقَعَتْ","على أخي سيئاتٍ عينُ ذي غضبِ",18,"ب",1,0],["لا يُلحِمَنَّكَهُ تَحَلُّمُهُ فَقَد","يودي بِكَ الوادي وَلَيسَ بِمُفعَمِ",19,"م",1,0],["لا يَلُمْنِي عَلَى الْحَفِيظَةِ قَوْمٌ","غَرَّهُمْ مَنْظَرُ الْحَيَاةِ فَضَلُّوا",20,"ل",3,0],["لا يلمسُ الروحَ فينا مَن يُصاحبنا","ولا تحدُّ حدودٌ مَن يُعادينا",21,"ن",2,0],["لا يلينُ القويُّ حتى يُلاقي","مثَلهُ عِزَّة وبطشاً وجاها",22,"ا",3,0],["لا يَلقُطُ الحَبَّ مِن زُروعِهِمُ","وَإِن رَأى حِبَّةَ النَباتِ لَقَط",23,"ط",1,0],["لا يُلِحّونَ عَلى غارِمِهِم","وَعَلى الأَيسارِ تَيسيرُ العَسِر",24,"ر",1,0],["لا يلم بعضكم على الخطب بعضا","أيها القوم كلكم أبرياء",25,"ا",2,0],["لا يُلْقِيَنْ بيَدَيْهِ الدّهَر ذو حَسَبٍ","يَرْجُو الفِداءَ إذا ما رُمحُهُ انكَسَرَا",26,"ر",2,0],["لا يَلفِتَنَّكَ عَن ثَنائي لافِتٌ","فَلِكُلِّ قَولٍ ما عَداهُ نَفادُ",27,"د",1,0],["لا يلبث الفقرُ في أرضٍ وراحُته","مما يجود فيغني الإنس والجانا",28,"ن",2,0],["لا يلزمون لعجزهم","حمل المروءة كالقدر",29,"ر",1,0],["لا يَلتَقي أَبَداً مَوا","عِدُها بِيَومِ وَفائِها",30,"ا",3,0],["لا يُلهينَّك حزنٌ بانَ عن فَرحٍ","فإنَّما الدَهرُ أَفراح وأَتراحُ",31,"ح",1,0],["لا يُلهينّكَ زينةٌ وتكاثرٌ","فَإِلى الهشيمِ يؤولُ ما هو ممرعُ",32,"ع",1,0],["لا يَلغَزُ المَجدُ مَن يَعني سَناهُ فَما","خِفتُ بِتَصحيفِهِ في المَدحِ فِكرَتُهُ",33,"ت",2,0],["لا يُلبِسَنَّ أَخٌ أَخاهُ مَواعِداً","خُلُفاً كَما لَبِسَ السَرابَ رُماحُ",34,"ح",1,0],["لا يلبى الأصنام حين تنادي","ه ولبى محمدا حين نودى",35,"د",2,0],["لا يَلحَني اللاحي فَإِنَّ أَحِبَّتي","أَفعالُها لا قَولُهُ يَلحاني",36,"ي",1,0],["لا يُلقَ إِلّا بِالسَلاسِلِ وَالظُبا","مَن كَيفَما لاقاكَ كانَ أَسيرا",37,"ر",2,0],["لا يلم غير نفسه","من لقى الهم والترح",38,"ح",1,0],["لا يلْتَقي سَيْفانِ في الغِمْدِ الذي","عَشِقتْ سريرتُهُ برِيقَ حُسامِ",39,"م",1,0],["لا يلحقُ الواصِفُ المطريُّ معانيَهُ","وإن يكُنْ سابِقاً في كُلِّ ما وَصَفا",40,"ف",2,0],["لا يلغ الذئب في تهجّمه","بمورد رام وردةٌ السبع",41,"ع",1,0],["لا يلمني العذول في فيض دمع","علّمتني يد الفراق البكاء",42,"ا",2,0],["لإِيلافِ شَمْلِ المُسْلِمِينَ بِرِحْلَةٍ","تَشُجُّ بِمَشْتَاها كُؤوسَ مَصيِفِها",43,"ف",3,0],["لا يلبث الوفرُ الجمي","عُ أن يُشِتَّ شملَهْ",44,"ل",2,0],["لا يلتوي عنكم لها","لا ناظرٌ ولا عُنُقْ",45,"ق",1,0],["لا يلبُس الجوزاء ألحاظَه","تيهاً ولا يخرا على النَد",46,"د",1,0],["لا يليقُ بمن هاب أتْيَ العُلا","أن ينال حياة غدٍ برَقا",47,"ق",2,0],["لا يلحَقُ الذُلُّ جاراً يستعزُّ به","ولا يرى الأمنَ مرعوبٌ يُذعِّرُهُ",48,"ر",2,0],["لا يَلتَقي بِيَ إلّا عند نائبةٍ","يُعين فيها ومكروهٍ يُعنّيني",49,"ي",1,0],["لا يُلقِحُ الحَربَ إِلّا رَيثَ يُنتِجُها","مِن هالِكٍ وَأَسيرِ غَيرِ مُختَتَلِ",50,"ل",1,0],["لا يلبَثُ الغصنُ عُرياناً بلا ثَمرٍ","حتَّى تراهُ بأوراقٍ وأثمارِ",51,"ر",1,0],["لا يَلحقُ الفِعلَ من أفعالِهِ نَدَمٌ","ولا يُلامُ على أمرٍ فيَعتَذِرُ",52,"ر",1,0],["لا يَلزَمُ القَمرُ المُنيرُ المَشرِقا","فأتى وكانَ يُضِئُ من قبلِ اللِّقا",53,"ق",2,1]]}