1012,"فتح جعلان","https://www.poetsgate.com/ViewPoem.aspx?id=124501",""],[5009,"قوة","https://www.poetsgate.com/ViewPoem.aspx?id=67997",""],[5397,"ما لهذا الدهر في الغي تمادى","https://www.poetsgate.com/ViewPoem.aspx?id=157914",""],[5409,"حدثينا يا فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=155283",""],[5436,"جرح الأباة(جواد بركات علي)","https://www.poetsgate.com/ViewPoem.aspx?id=35169",""],[5490,"صهوة الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=176416",""],[5725,"موت عراقي الشذى","https://www.poetsgate.com/ViewPoem.aspx?id=207163",""],[5784,"ليس ذنبي","https://www.poetsgate.com/ViewPoem.aspx?id=189911",""],[5812,"قهر","https://www.poetsgate.com/ViewPoem.aspx?id=114118",""],[5956,"أحزانٌ على فقرِ بعض الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=200036",""],[5956,"أفرحْتِنا فرحاً يعيد حياتنا","https://www.poetsgate.com/ViewPoem.aspx?id=207451",""],[6031,"يا خَلِيلَيَّ احْبِسَا الرَّكْبَ إذَا مَا","https://www.poetsgate.com/ViewPoem.aspx?id=46300",""],[6052,"كواكب أمتي","https://www.poetsgate.com/ViewPoem.aspx?id=34627",""],[6124,"وحدنا كنا","https://www.poetsgate.com/ViewPoem.aspx?id=174665",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""],[5393,"رب شيخ يمد للحق رجلاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85468&r=&rc=35",""]],"verses":[["لا يُلاقونِيَ إِلّا خائِضاً","أَخطُمُ الأَقوالَ مِنهُم وَأَزُمّ",0,"م",1,0],["لا يَلبَثُ المَرءُ يُبلي شَرخَ جِدَّتِهِ","مِنَ الزَمانِ جَديدٌ ما لَهُ خَلَقُ",1,"ق",1,0],["لا يَلبَسُ الوُدَّ الطَري","فَ مِجامِلٌ خَلَعَ التِلادا",2,"د",2,0],["لا يُلبِثُ القُرَناءَ أَن يَتَفَرَّقوا","لَيلٌ يَكُرُّ عَلَيهِمُ وَنَهارُ",3,"ر",1,0],["لايلام الذئب في عدوانه","إن يك الراعي عدوَّ الغنم",4,"م",1,0],["لا يلَهِّيهِ عنه خفضٌ ولا ين","ساه عند المُرْبَدَّةِ الشَّوْهَاءِ",5,"ا",2,0],["لا يَلْحني جارمٌ سطوتُ به","من زرع الشرَّ عامداً حصدَهْ",6,"د",2,0],["لا يُلفَ وعدك والبنفسج كاسمه","في حلية التنكير والتصحيفِ",7,"ف",1,0],["لا يلتقي فيه العفاف والشرف","بل تلتقي فيه بظور وقلف",8,"ف",1,0],["لا يلمْهُ لائمٌ في فعله","فله عُذرانِ عند الفَطَنه",9,"ن",2,0],["لا يُلْفِينَّك ذو الجلال مُحاولاً","تَبْيينَ مَطْموسٍ وطَمْسَ مُبين",10,"ن",1,0],["لا يلفظ اللفظ طيشا","ولا يذيل اليمينا",11,"ن",2,0],["لا يَلمَسُ الدُستورُ فيكُم روحَهُ","حَتّى يَرى جُندِيَّهُ المَجهولا",12,"ل",2,0],["لا يَلبَثُ الحُلمُ يَدعوهُ فَيَتبَعُهُ","تَأَلُّقَ البَرقِ في طَخياءِ دَيجورِ",13,"ر",1,0],["لايَلبَثُ المَمنوعُ تَطلُبَهُ","حَتّى يَثوبَ إِلَيكَ مُمتَنِعُه",14,"ع",2,0],["لا يُلَذُّ المُلتَقى إِن لَم يَكُن","باعِثُ الشَوقِ لَذيذَ المُعتَنَق",15,"ق",1,0],["لا يُلقِيَن بِيَدَيهِ الدَهرَ ذي حَسَبٍ","يَرجو الفِداءَ إِذا ما رُمحُهُ اِنكَسَرا",16,"ر",2,0],["لا يَلْقُطُ الحَبَّ إلا فِي مَنَازِلِكُمْ","ولا يُقِيمُ سِوَى مِنْ شَوْقِهِ الأَوَدَا",17,"د",2,0],["لا يلحظُ الحرَّ إلّا مثلما وَقَعَتْ","على أخي سيئاتٍ عينُ ذي غضبِ",18,"ب",1,0],["لا يُلحِمَنَّكَهُ تَحَلُّمُهُ فَقَد","يودي بِكَ الوادي وَلَيسَ بِمُفعَمِ",19,"م",1,0],["لا يَلُمْنِي عَلَى الْحَفِيظَةِ قَوْمٌ","غَرَّهُمْ مَنْظَرُ الْحَيَاةِ فَضَلُّوا",20,"ل",3,0],["لا يلمسُ الروحَ فينا مَن يُصاحبنا","ولا تحدُّ حدودٌ مَن يُعادينا",21,"ن",2,0],["لا يلينُ القويُّ حتى يُلاقي","مثَلهُ عِزَّة وبطشاً وجاها",22,"ا",3,0],["لا يَلقُطُ الحَبَّ مِن زُروعِهِمُ","وَإِن رَأى حِبَّةَ النَباتِ لَقَط",23,"ط",1,0],["لا يُلِحّونَ عَلى غارِمِهِم","وَعَلى الأَيسارِ تَيسيرُ العَسِر",24,"ر",1,0],["لا يلم بعضكم على الخطب بعضا","أيها القوم كلكم أبرياء",25,"ا",2,0],["لا يُلْقِيَنْ بيَدَيْهِ الدّهَر ذو حَسَبٍ","يَرْجُو الفِداءَ إذا ما رُمحُهُ انكَسَرَا",26,"ر",2,0],["لا يَلفِتَنَّكَ عَن ثَنائي لافِتٌ","فَلِكُلِّ قَولٍ ما عَداهُ نَفادُ",27,"د",1,0],["لا يلبث الفقرُ في أرضٍ وراحُته","مما يجود فيغني الإنس والجانا",28,"ن",2,0],["لا يلزمون لعجزهم","حمل المروءة كالقدر",29,"ر",1,0],["لا يَلتَقي أَبَداً مَوا","عِدُها بِيَومِ وَفائِها",30,"ا",3,0],["لا يُلهينَّك حزنٌ بانَ عن فَرحٍ","فإنَّما الدَهرُ أَفراح وأَتراحُ",31,"ح",1,0],["لا يُلهينّكَ زينةٌ وتكاثرٌ","فَإِلى الهشيمِ يؤولُ ما هو ممرعُ",32,"ع",1,0],["لا يَلغَزُ المَجدُ مَن يَعني سَناهُ فَما","خِفتُ بِتَصحيفِهِ في المَدحِ فِكرَتُهُ",33,"ت",2,0],["لا يُلبِسَنَّ أَخٌ أَخاهُ مَواعِداً","خُلُفاً كَما لَبِسَ السَرابَ رُماحُ",34,"ح",1,0],["لا يلبى الأصنام حين تنادي","ه ولبى محمدا حين نودى",35,"د",2,0],["لا يَلحَني اللاحي فَإِنَّ أَحِبَّتي","أَفعالُها لا قَولُهُ يَلحاني",36,"ن",2,0],["لا يُلقَ إِلّا بِالسَلاسِلِ وَالظُبا","مَن كَيفَما لاقاكَ كانَ أَسيرا",37,"ر",2,0],["لا يلم غير نفسه","من لقى الهم والترح",38,"ح",1,0],["لا يلْتَقي سَيْفانِ في الغِمْدِ الذي","عَشِقتْ سريرتُهُ برِيقَ حُسامِ",39,"م",1,0],["لا يلحقُ الواصِفُ المطريُّ معانيَهُ","وإن يكُنْ سابِقاً في كُلِّ ما وَصَفا",40,"ف",2,0],["لا يلغ الذئب في تهجّمه","بمورد رام وردةٌ السبع",41,"ع",1,0],["لا يلمني العذول في فيض دمع","علّمتني يد الفراق البكاء",42,"ا",2,0],["لإِيلافِ شَمْلِ المُسْلِمِينَ بِرِحْلَةٍ","تَشُجُّ بِمَشْتَاها كُؤوسَ مَصيِفِها",43,"ف",3,0],["لا يلبث الوفرُ الجمي","عُ أن يُشِتَّ شملَهْ",44,"ل",2,0],["لا يلتوي عنكم لها","لا ناظرٌ ولا عُنُقْ",45,"ق",1,0],["لا يلبُس الجوزاء ألحاظَه","تيهاً ولا يخرا على النَد",46,"د",1,0],["لا يليقُ بمن هاب أتْيَ العُلا","أن ينال حياة غدٍ برَقا",47,"ق",2,0],["لا يلحَقُ الذُلُّ جاراً يستعزُّ به","ولا يرى الأمنَ مرعوبٌ يُذعِّرُهُ",48,"ر",2,0],["لا يَلتَقي بِيَ إلّا عند نائبةٍ","يُعين فيها ومكروهٍ يُعنّيني",49,"ن",2,0],["لا يُلقِحُ الحَربَ إِلّا رَيثَ يُنتِجُها","مِن هالِكٍ وَأَسيرِ غَيرِ مُختَتَلِ",50,"ل",1,0],["لا يلبَثُ الغصنُ عُرياناً بلا ثَمرٍ","حتَّى تراهُ بأوراقٍ وأثمارِ",51,"ر",1,0],["لا يَلحقُ الفِعلَ من أفعالِهِ نَدَمٌ","ولا يُلامُ على أمرٍ فيَعتَذِرُ",52,"ر",1,0],["لا يَلزَمُ القَمرُ المُنيرُ المَشرِقا","فأتى وكانَ يُضِئُ من قبلِ اللِّقا",53,"ق",2,1],["لا يلتقي الجيش بغير مهجة","جليلة تدخر للجلائل",54,"ل",1,0],["لا يُلجِئَنَّ غَزالَ المِسك ذو حَوَرٍ","نَقِيُّ خدٍّ بِهِ لِلحسنِ أَنوارُ",55,"ر",1,1],["لا يلبس الباس قلباً في قلوبهم","يوماً ولا انخفضوا من خافض وضر",56,"ر",1,0],["لا يَليقُ الغِنى بِوَجهِ أَبي يَع","لى وَلا نورُ بَهجَةِ الإِسلام",57,"م",1,0],["لا يَلعَبنَّ أَبَداً مَع مُحسن","مجود فذاكَ فعل الأَرعن",58,"ن",1,0],["لا يلتحف بِإثمه وَعاره","خَير الأُمور الصَّبر في المَكاره",59,"ه",1,0],["لا يلتوي حتى يفوز براية","لا ينثني حتى يصد الجحفلا",60,"ل",2,0],["لا يَلتَوي صَدرُ الأُمورِ وَوردُها","أَبَداً إِذا ما البَرمَكيّ أَجالَها",61,"ل",3,0],["لا يلتقي منكِ دحضا","فصارَ وهوَ قريبٌ",62,"ب",1,0],["لا يلمس الساعي بها حرقٌ","فكأنها في كفه تبر",63,"ر",1,0],["لا يلهينك عن حلاوتها ال","صبر الذي مثل اسمه صبر",64,"ر",1,0],["لا يلبث الهزل أن يجني لصاحبه","ذما ويذهب عنه بهجة الأدب",65,"ب",1,0],["لا يلذن مطعم لك فيها","كل حلو من بعده الموت مر",66,"ر",1,0],["لا يلبَثُونَ عنِ الأوْلادِ تنْشُدُهُمْ","ولا النِّساءِ ولا يألُونَ ما بَعُدُوا",67,"د",3,0],["لا يلتفتُ من قال فيه إنه","يفري الكلى ويقطع الأوصالا",68,"ل",2,0],["لا يُلامونَ إن أسالوا عليهِ","عَبرةً بالجفون من بعد عبره",69,"ر",2,0],["لا يلهينك منزل لعبت به","أيدي البلا من سالف الأزمان",70,"ن",1,0],["لا يلبثُ الشوقُ المبرح لمحةً","حتى يَمُرَّ إليهمُ ويؤوبَا",71,"ب",2,0],["لا يَلقط الحُب الحمام بِها","وَالفار مَأمون مِن الهر",72,"ر",1,0],["لا يَلطموا الأَيدي وَحَق لَهُم","أَن يَعقدوا أَنديةً لِلهَنا",73,"ن",2,0],["لا يُلاقي النَسيبُ مِنهُم نَسيباً","يَتَعَزّى بِهِ وَلا الخِلُّ خِلّا",74,"ل",2,0],["لا يليق الثناء إلا لمجد","ضم تلك النقيبة الزينيه",75,"ي",2,0],["لا يلبسون دروعاً في الوغى جنتاً","وعزمهم درعهم لا الدرع واليلب",76,"ب",1,0],["لا يَلِجُ الطَّيْفُ إليه فَرَقاً","وفيه ليستْ تهتدي كُدْرُ القَطَا",77,"ا",1,0],["لا يَلُمْني العذولُ إِنْ بنفسي","قَبساً بالفؤاد شَبَّ لَظاها",78,"ا",3,0],["لا يليق النسيب بالشيخ ان لم","يتخلق أخلاق شرّ الكهول",79,"ل",1,0],["لا يلبث الليث في غاب على سغب","حتى يخضب فاه من دم النعم",80,"م",1,0],["لا يَلتَفِتنَ وَلا يَنطِقْنَ فاحِشَةً","وَلا يُسائِلْنَ عَن تِلكَ الأَضابيرِ",81,"ر",1,0],["لا يلحقونَ بجريهم خَبَبي","أَو يلحقُ الدَّبَرانُ بالنجْمِ",82,"م",1,0],["لا يلام العليل لو راح يشكو","علة برحت به للطبيب",83,"ب",1,0],["لا يلام الصب في ذكر رباً","بان من غير رضي عن بانها",84,"ن",3,0],["لاَ يُلهِيَنَّك عنَّا بَعدَ فُرقَتِنَا","بُعدُ المزَارِ وَإِن صَاحبتَ أملاكَا",85,"ك",2,0],["لا يُلام العابسُ اليا","ئسُ إلا بعد لومِكْ",86,"ك",1,0],["لا يُلقينْك الغرام في شُبَه","تسلك بالقلب مسلك الندم",87,"م",1,1],["لا يُلاقَى الخلد بالحزن ولا","يُكتَسى الفتح بجلباب السواد",88,"د",1,0],["لايلاف دين الحق ألفه واذ","يفرِّق شمل الجبر سمَّاه بالسيف",89,"ف",1,0],["لا يلتقي البطليوس خيراً ولا","أجنادهُ أبناءُ أهلِ الصليب",90,"ب",1,0],["لا يلتقى والعلم فى مجلس","أو يلتقى الادراك والفوت",91,"ت",1,0],["لا يلقينّك في افواه مهلكةٍ","قول السفاه وضعف حين تأتمر",92,"ر",1,0],["لا يُلْهِهِم أَنْ قَد مَنَنْتَ وشُنَّها","شَعواءَ تُصلي الكافرينَ سَعيرا",93,"ر",2,0],["لا يَلهِيَنَّكَ غَيرُ ما","تَهوى فَإِنَّ العُمرَ فانِ",94,"ن",1,0],["لا يَليقُ الجَفا وَقَد رَق طَبعُ","مَن حَليف الوَفا كَريم الجَناب",95,"ب",1,0],["لا يَلتَقيها بالقنا ومهنَّدٍ","لكن بآراء يهون عسيرُها",96,"ر",3,0],["لا يلحق المدفون غوث والد","فيه ولا عون أخ ودود",97,"د",1,0],["لا يُلامُ الغوَّاصُ في طلبِ اللُؤ","لؤِ إنْ تاهَ وسطَ بَحرٍ عَرمرمْ",98,"م",1,0],["لا يلم غير نفسه كل من قد","عرض النفس أن تهان فذلا",99,"ل",2,1],["لا يلتقي طرف إلى طرف بها","فالباع فيها واحد والميل",100,"ل",1,0],["لا يلبث الحر في مكان","ينسب فيه إلى هوان",101,"ن",1,0],["لِإِيْلَافِ قَلبي لِإِيلافِهِ","حَنِينٌ كَفِيلٌ بإِتلافِهِ",102,"ف",2,1],["لِإِيْلَافِ قَلبي نُزُوعٌ إِلى","مُحَالٍ, وجَهلٌ بأَوصَافِهِ!",102,"ف",2,0],["لِإِيْلَافِ قَلبي دُعائِي لَهُ","ب: يا رَبَّهُ خُذْهُ, أَو عَافِهِ",102,"ف",2,0],["لا يَلِيقُ القُعُودُ بي في بلادٍ","لا يُطِيقُ الوَلِيدَ فيها القِماطُ",103,"ط",1,0],["لا يلام المرء في الخطب إذا","عز مفقود وقد جل المصاب",104,"ب",1,0],["لا يلجأ الإنسان إن حلت به","رٍيَب الزمان أو اعتراه مُصابُ",105,"ب",1,0],["لا يلامون والسيوف بعدلٍ","حاكمت قبل أن يذوقوا السنانا",106,"ن",2,0],["لا يلتوي كالأفعوان ولا يطأطىء كالعبيد","وإذا أريد على الدنية قال: إني لا أريد",107,"د",1,0],["لا يلين الخطب مني جانبا","خشنا قد صدع الصلد الجمادا",108,"د",2,0],["لا يلوم السيف من لم","يتخذ للسيف ترسا",109,"ا",1,0],["لا يلتوي هذا العراق عزيمة","بيت الحضارة .. عزمه كرارُ",110,"ر",1,0],["لا يلتقي الليلُ والإشراقُ في زَمَنٍ","مَنْ رَامَ ذاكَ فلا أََمْسى ولا أَضْحى",111,"ح",2,0],["لا يليق الموت الا من له",