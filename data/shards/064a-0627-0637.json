//www.poetsgate.com/ViewPoem.aspx?id=179288",""],[59,"يا طالبض العلمِ بادرِ الورعَا","https://www.poetsgate.com/ViewPoem.aspx?id=20443",""],[22,"لمن الدّيارُ كأنَّهنَّ سطور","https://www.poetsgate.com/ViewPoem.aspx?id=19748",""],[50,"حسبي بما قد لقيت يا عمرُ","https://www.poetsgate.com/ViewPoem.aspx?id=22678",""],[50,"سبح خليلي وقل يا حسن تصوير","https://www.poetsgate.com/ViewPoem.aspx?id=22662",""],[91,"الى الشبان المتفرّجين","https://www.poetsgate.com/ViewPoem.aspx?id=53238",""],[91,"الحرب العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=53314",""],[99,"القرط الطويل","https://www.poetsgate.com/ViewPoem.aspx?id=36382",""],[51,"يا طالباً عند الإمام هوادة","https://www.poetsgate.com/ViewPoem.aspx?id=26066",""],[39,"إنَّ الفؤادَ هفَا للبائنِ الغردِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7469&r=&rc=9",""],[31,"أمستْ كراعُ الغميمِ موحشة ً،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18784&r=&rc=47",""],[31,"يا أمّ نوفلَ، فكي عانياً مثلتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19015&r=&rc=278",""]],"verses":[["يا طاعِناً بِالرُمحِ بَرعَفُ زُجُّهُ","عَلَقاً بِمَجَّةِ عامِلٍ وَسِنانِ",0,"ن",1,0],["يا طائِرَ البانِ غِرّيداً عَلى فَنَنٍ","ما هاجَ نَوحُكَ لي يا طائِرَ البانِ",1,"ن",1,1],["يا طالِبَ المَعروفِ حَلَّقَ نَجمُهُ","حُطَّ الحُمولَ وَعَطِّلِ الأَجمالا",2,"ل",2,0],["يا طَودُ كَيفَ وَأَنتَ عاديُّ الذُرى","أَلقى بِجانِبِكَ الرَدى زِلزالا",2,"ل",2,0],["يا طالِباً مِن ذا الزَمانِ شَبيهَهُ","هَيهاتَ كَلَّفتَ الزَمانَ مُحالا",2,"ل",2,0],["ياطَلحَ آمَةَ لاسُقّيتَ مِن شَجرٍ","مُذَمَّمِ الأَرضِ لا ظِلٌّ وَلا ثَمَرُ",3,"ر",1,0],["يا طالِباً بِالثَأرِ أَعجَلَكَ الرَدى","عَن أَن تَنامَ عَلى وُجودِ الثارِ",4,"ر",1,0],["يا طيبَ نَجدٍ وَحُسنَ ساكِنِهِ","لَو أَنَّهُم أَنجَزوا الَّذي وَعَدوا",5,"د",3,1],["يا طائِرَ البانِ ما غُرَّبتَ عَن سَكَنٍ","يَوماً وَلا كُنتَ عَن مَأوىً بِمَطرودِ",6,"د",1,0],["يا طُلوعَ البَدرِ لا نا","لَكَ مَحذورُ الغُروبِ",7,"ب",1,0],["يا طُرَّةَ الشّيحِ بسفْحِ عاقِلِ","كيفَ تُناجيكِ صَبا الأصائِلِ",8,"ل",1,1],["يا طامِعاً في هَلاكي عُد بِلا طَمَعٍ","وَلا تَرِد كَأسَ حَتفٍ أَنتَ شارِبُهُ",9,"ب",2,0],["يا طائِراً قَد باتَ يَندُبُ إِلفَهُ","وَيَنوحُ وَهوَ مُوَلَّهٌ حَيرانُ",10,"ن",1,0],["يا طولَ هَمّي بِما لا يَعلَمُ الناسُ","رَجاءُ وُدِّكِ يَنعاهُ لِيَ الياسُ",11,"س",1,1],["يا طَلَلاً ما عليْهِ منْ عمَلٍ","يا شجَراً ما لدَيْهِ منْ ثمَرِ",12,"ر",1,0],["يا طَبيبَ الذّنوبِ تَدْبيرُكَ النا","جِعُ في علّتي ضَمينُ النّجاحِ",13,"ح",1,0],["يا طالِباً منْ جارِهِ إسْكَرْفَجا","هَذا يُخَبِّرُ أن جوعَكَ فاجَا",14,"ج",2,1],["يَا طَلْعَةَ الشُّومِ التَّي مَهْمَا بَدَتْ","يَئِسَتْ عُفَاةُ النُّجْحِ مِنْ أَسْبَابِهِ",15,"ب",2,1],["يا طالِعاً لِلشَرقِ لَجَّ بِهِ","نَحسُ النُحوسِ فَقَرَّ في زُحَلِ",16,"ل",1,0],["يا طِبَّ جالينوسَ في أَنواعِهِ","ما لي أَراكِ كَثيرَةِ الأَعداءِ",17,"ا",2,0],["يَا طِيبَ عيْنِي حِين آنسهَا","يَا سَعْدَ قَلْبِي حِين ناجَاهُ",18,"ا",2,0],["يَا طَيبَ يَوْمٍ لا يُضَاهِي حُسْنَهُ","بِيُمْنِهِ قَرَّتْ وَسُرَّتْ أُسْرَتَانِ",19,"ن",1,1],["يَا طَبِيبَ الأَبْدَانِ تَهْنِيءُ أَرْ","شَدْتَ أَوْ عِدْتَ صِحَّةُ الأَبْدَانِ",20,"ن",1,0],["يَا طِيبَهَا لَوْ لَمْ يُفاجِئُنِي بِهَا","عُمَرٌ بِلَحْظٍ مُرْسَلٍ كَسِهَامِ",21,"م",1,0],["يا طوسَ طوباكِ قَد صِر","تِ لِاِبنِ أَحمَدَ مَشهَد",22,"د",1,0],["يا طَيبَ هَل مِن مَتاعٍ تُمتِعينَ بِهِ","ضَيفاً لَكُم باكِراً يا طَيبَ عَجلانا",23,"ن",2,0],["يا طُعمَ يا اِبنَ قُرَيطٍ إِنَّ بَيعَكُمُ","رِفدَ القِرى ناقِصٌ لِلدينِ وَالحَسَبِ",24,"ب",1,1],["ياطيبَ لَيلَةِ ميلادٍ لَهَوتُ بِها","بِأَحوَرٍ ساحِرِ العَينَينِ مَكمورِ",25,"ر",1,1],["ياطولَ شَوقِيَ إِن قالوا الرَحيلُ غَدا","لَا فَرَّقَ اللَهُ فيما بَينَنا أَبَدا",26,"د",2,1],["يا طالباً منه جوداً أو مباحثةً","رد بحرهُ العذب واحْذر سورة اللَّجج",27,"ج",1,0],["يا طرسُ قبّل ثرى الباب العليّ وقل","مولايَ لا زلت تولي الخيرَ مستورا",28,"ر",2,1],["يا طرق الشكر عليه قسما","لتركبنَّ طبقاً عن طبق",29,"ق",1,0],["يا طالب الجود لا تتعب أمانيكا","فقد تغيب نجمٌ كان يهديكا",30,"ك",2,1],["يا طرس قبّل راحةً شمسيّةً","تزهو بها وبمدحها الأيام",31,"م",1,1],["يا طائراً بالحمى يشدو على فتن","طوَّقت أنت رقاب الناس بالمنن",32,"ن",1,1],["يا طرس قبَّل امرئٍ فطنٍ","بالفضل لا غافل ولا لاهي",33,"ي",1,1],["يا طالَما غِبنا عَن أَشباحِ النَظَر","مِن نقطَةٍ يَحكي ضِياؤُها القَمَر",34,"ر",1,1],["يا طالباً عند الإمام هوادةً","مهلاً وحسبُك مُنذراً شَشْداءُ",35,"ا",2,1],["يا طيبَها ضرطةً وإن خَبُثتْ","وربما طاب بعض ما خبُثا",36,"ث",2,0],["يا طيِّبَ الثغر والمُجَاجَهْ","اقضِ لنا حاجةً بحاجَهْ",37,"ج",2,1],["يا طاهريين لا طَهورَ لكم","من حَيْضة الغدر آخرَ الأبدِ",38,"د",1,1],["يا طيلسانَ الحَمْدوْي","ي لقد شُفِعْتَ وكنتَ وِترا",39,"ر",2,0],["يا طيلساناً أنا وقْفٌ له","أرفوه بالفرض وبالقرض",40,"ض",1,0],["يا طالبَ العُرفِ أعْيتهُ وسائلهُ","دع الوسائلَ والأسباب واختبطِ",41,"ط",1,0],["يا طِيرة الشؤم ويا فأل التلف","يا سُدَّةً في المنخرين من نَغَف",42,"ف",1,0],["يا طالبي ما يُحاكُ من حُلل ال","حمدِ بأغلى ما تُطبعُ السِّككُ",43,"ك",1,0],["يا طيبَ ريقٍ باتَ بدرُ الدُّجى","يمجّهُ بين ثناياكا",44,"ك",2,1],["يا طالبَ التفصيلِ في شنطفٍ","حسبُك بالجملةِ تفصيلا",45,"ل",2,0],["يا طولَ غلَّة نفسِي المبلاهِ","بظباء بين أَجارعٍ وجِلاهِ",46,"ه",1,1],["يا طالَما اِكتَسَبَ الحَريرُ مَلاحَةً","مِنها وَيُكسِبُ غَيرَها ما يَكسَبُ",47,"ب",1,0],["يا طالِبَ الشَهدِ أَقصِر","لَم يَبقَ إِلّا القَفيرُ",48,"ر",1,0],["يا طالَما قَد كُنتُ أَحسُدُهُ","وَاليَومَ أَحسُدُهُ عَلى القَبرِ",49,"ر",1,0],["يا طالِعاً لَفَتَ العُيونَ طُلوعُهُ","بَعدَ الطُلوعِ وَإِن جَهِلتَ أُفولُ",50,"ل",1,0],["يا طالَما مَثَلوا لَدَيكَ كَأَنَّهُم","ىُسدُ الشَرى فَنَسيتُ أَنَّكَ تَحلُمُ",51,"م",1,0],["يا طالَما اِستَبكَيتُهُ فَبَكى لَكُم","لَولا الرَجاءُ بَكَيتُهُ وَبَكاني",52,"ن",2,0],["يا طيبَها ريحاً إِذا ما سَرَت","وَطيبَ ما تَروي وَما تَذكُرُ",53,"ر",1,0],["يا طيبَهُ لَو لَم يَكُن","مَلَأَ الصَحائِفَ بِالذُنوبِ",54,"ب",1,0],["يا طائرَ الشِّعْرِ رَوِّحْ","على الحَيَاةِ الكئيبَهْ",55,"ه",1,0],["يا طرف اهرق من دمو","عك البواقي وشلك",56,"ك",1,0],["يا طالما ارتاحوا إليه وطالما","حمسوا على النغم الشجىّ وثاروا",57,"ر",3,0],["يا طيبها حين تحدوها بحنجرة","كخرطم النحل أرواحا وألوانا",58,"ن",2,0],["يا طير لولا أن يقو","لوا جُن قلت تعقل",59,"ل",1,0],["يا طيف من أهو