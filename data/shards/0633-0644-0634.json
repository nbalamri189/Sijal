{"poems":[[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127954","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101065","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106985","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87766","الكامل"],[3228,"","https://poetry.dctabudhabi.ae/diwan/poem/138836",""],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129464","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92071","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117847","الكامل"],[5038,"دار السلام","https://www.poetsgate.com/ViewPoem.aspx?id=195233",""],[3271,"دمعة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=104119",""],[5183,"عواطف الإخاء","https://www.poetsgate.com/ViewPoem.aspx?id=180212",""],[5960,"بغدادُ أغلى انتماءاتي","https://www.poetsgate.com/ViewPoem.aspx?id=30808",""]],"verses":[["سل شعره عن طول ليل به","وخلعت فيه على الخلى نعاسى",0,"س",2,0],["سل شعبه أيام تحجل حوله","نذر المنون ولا يخاف منونا",1,"ن",2,0],["سل شبا جفنه فأضحى","نظام دمعي يصوغ نثره",2,"ر",2,0],["سَل شُمَّه عَنهُم فَقَد خُضبت","مِنهُم قَديماً بِالدَم القاني",3,"ن",2,0],["سل شيبةً عنه في ذاك القليب وسل","مَن قدر رماه من الشبَّان والشيب",4,"ب",1,0],["سل شمرا مذ أناخوا عن معرسهم","بنهر عيسى وثغر السيف يبتسم",5,"م",1,0],["سل شمسها كم أبصرت من غادة","وسل الأهلة كم صحبن مباهيا",6,"ي",2,0],["سل شانئي الأشراف هل أبقيت بي","ن لظى وبينك من حجاب حائل",7,"ل",1,0],["سَلْ شَهْرَزادَ وَشَهْرَيارَ عَنِ الْجَوى","بَلْ كَيفَ بَزَّ الْوَرْدُ سَيفاً يَقْطُرُ",8,"ر",1,0],["سلْ شحوب المساء كيف احتوانا","في جحيم من التأوّه ساعرْ",9,"ر",1,0],["سل شيخنا السالمي في شرح ثالثه","من مسند ابن حبيب تعرف الدينا",10,"ن",2,0],["سَلْ شهرَيارَ إذا عادتْ طبائعُهُ","وعادَ يَذبحُ ظُلماً في الرِّواياتِ",11,"ت",1,0]]}