{"poems":[[55,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[88,"لاهم إن الغرب أصبح شعلة","https://www.aldiwan.net/poem10678.html","الكامل"],[88,"بالذي أجراك يا ريح الخزامى","https://www.aldiwan.net/poem10684.html","الرمل"],[29,"حيوا أمامة واذكروا عهدا مضى","https://www.aldiwan.net/poem5655.html","الكامل"],[74,"يا بروقا على ربى يبرين","https://www.aldiwan.net/poem20165.html","الخفيف"],[53,"أقبلت دولة هي الإقبال","https://www.aldiwan.net/poem65883.html","الخفيف"],[64,"نظري إلى لمع الوميض حنين","https://www.aldiwan.net/poem52265.html","الكامل"],[64,"لجلال قدرك تخضع الأقدار","https://www.aldiwan.net/poem52392.html","الكامل"],[47,"إنما الغي أن يكون رشيدا","https://www.aldiwan.net/poem63464.html","الخفيف"],[63,"ردي الخيال يجد معنى واجدا","https://www.aldiwan.net/poem51370.html","الكامل"],[46,"وأبي المنازل إنها لشجون","https://www.aldiwan.net/poem30334.html","الكامل"],[107,"أتنام عينك والعيون سهاد","https://www.aldiwan.net/poem42119.html","الوافر"],[107,"أطلقوا قيدها وحلوا العقالا","https://www.aldiwan.net/poem43051.html","الخفيف"],[107,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[107,"طغت الدماء وفاضت الأرواح","https://www.aldiwan.net/poem43145.html","الكامل"],[48,"لم أرض رأي ولاة قوم لقبوا","https://www.aldiwan.net/poem22632.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42595","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[108,"في مهرجان دار العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=179366",""],[92,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[96,"على أطلال الجزيرة العربية","https://www.poetsgate.com/ViewPoem.aspx?id=15663",""],[146,"مرض بقلبك ما يعاد","https://www.aldiwan.net/poem58409.html","مجزوء الكامل"],[147,"يا للرجال لنظرة سفكت دما","https://www.aldiwan.net/poem11808.html","الكامل"],[173,"عني إليك حوادث الأيام","https://www.aldiwan.net/poem1669.html",""],[230,"نحن لله ما لحي بقاء","https://www.aldiwan.net/poem55098.html","الخفيف"],[240,"سل عن الماضين إن نطقت","https://www.aldiwan.net/poem31799.html","المديد"],[242,"لله يوم شربنا فيه كأس منى","https://www.aldiwan.net/poem19743.html","البسيط"],[275,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[275,"أدمشق أين بنو أمية قولي","https://www.aldiwan.net/poem35651.html","الكامل"],[303,"يا ليتني لما شرب","https://www.aldiwan.net/poem36797.html","عموديه"],[409,"كل أخبار الهوى قد رويت","https://www.aldiwan.net/poem34111.html","الرمل"],[409,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[463,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[466,"أما اذا سلم الامام الأعظم","https://www.aldiwan.net/poem16018.html","الكامل"],[469,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[469,"يا من لابيض كل جفن اسود","https://www.aldiwan.net/poem3536.html","عموديه"],[556,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[556,"ما قربوا إلا لبين نوقا","https://www.aldiwan.net/poem47365.html","الكامل"],[556,"خل من كان للجنادل جارا","https://www.aldiwan.net/poem47802.html","الخفيف"],[563,"ملكوت السماء والأرض","https://www.aldiwan.net/poem34415.html","الخفيف"],[580,"لست الملوم بما تجني علي بصري","https://www.aldiwan.net/poem3066.html","البسيط"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2463","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122666","الكامل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103080","الكامل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103069","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62667","الكامل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202073","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64874","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64980","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49925","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77761","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77882","الرمل"],[1680,"","https://poetry.dctabudhabi.ae/diwan/poem/81896","الخفيف"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95378","الكامل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126651","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[1886,"","https://poetry.dctabudhabi.ae/diwan/poem/130695","الرمل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202169","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69374","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69322","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109329","الكامل"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123655","الرمل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60891","المتدارك"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87767","الرمل"],[2900,"","https://poetry.dctabudhabi.ae/diwan/poem/102185","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74237","الكامل"],[3102,"","https://poetry.dctabudhabi.ae/diwan/poem/113896","الكامل"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140303",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132543","الخفيف"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121355","الكامل"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127915","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74043","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62924","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62886","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138519",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138553",""],[3625,"","https://poetry.dctabudhabi.ae/diwan/poem/204080","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110063","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109928","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109954","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92071","الكامل"],[3737,"","https://poetry.dctabudhabi.ae/diwan/poem/138917",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102983","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44632","البسيط"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107289","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54496","الخفيف"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105506","الخفيف"],[4434,"","https://poetry.dctabudhabi.ae/diwan/poem/130704","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58031","الكامل"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113833","الكامل"],[4859,"أين قلبي؟!","https://www.poetsgate.com/ViewPoem.aspx?id=204284",""],[5005,"تشبيب في حضرة الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=195378",""],[3591,"كل من عاش بالمذلة لم يش","https://www.poetsgate.com/ViewPoem.aspx?id=149428",""],[5271,"معزوفة الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=123678",""],[5363,"اللهُ يا أللهُ اللهُ","https://www.poetsgate.com/ViewPoem.aspx?id=199946",""],[5409,"كلما اجتاز بعدك الدهر ميلا","https://www.poetsgate.com/ViewPoem.aspx?id=155494",""],[5431,"عظُمَ الحنينُ وعنّفا ...","https://www.poetsgate.com/ViewPoem.aspx?id=198505",""],[5436,"مهابة التأريخ(جواد بركات علي)","https://www.poetsgate.com/ViewPoem.aspx?id=34913",""],[5458,"كان جدِّي","https://www.poetsgate.com/ViewPoem.aspx?id=72394",""],[5596,"تقريظ كتاب التاريخ الإباضي","https://www.poetsgate.com/ViewPoem.aspx?id=206483",""],[5605,"معلقة الخليفة","https://www.poetsgate.com/ViewPoem.aspx?id=159729",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5889,"قلب المحب لحبه ثمن","https://www.poetsgate.com/ViewPoem.aspx?id=212598",""],[6052,"كواكب أمتي","https://www.poetsgate.com/ViewPoem.aspx?id=34627",""],[6149,"يصف النسيم إذا يمر به","https://www.poetsgate.com/ViewPoem.aspx?id=169626",""]],"verses":[["مَلَكوا وَلَمّا يُحسِنوا وَوَلوا وَلَم","ما يَعدِلوا وَغَنوا وَلَمّا يَسمَحوا",0,"ح",3,0],["مَلَكوا مَسابِحَها عَلَيها بَعدَ ما","غَلَبوا النُسورَ عَلى الجِواءِ وَحَلَّقوا",1,"ق",3,0],["مَلَكوا البَرَّ فَلَمّا لَم يَسَع","مَجدَهُم نالوا مِنَ البَحرِ المَراما",2,"م",2,0],["مَلَكوا البِلادَ فَسُخِّرَت أَنهارُها","في غَيرِ مَظلِمَةٍ وَلا تَبَعِ الرَيا",3,"ا",1,0],["ملكوا راية البيان وحلُّوا","عنق الدهر بالكلام الثمين",4,"ن",1,0],["ملك وابنُهُ ومِدرَه مُلْكٌ","وابنُه هكذا يكون الكمالُ",5,"ل",1,0],["ملكوا الأعنَّةَ والأسنَّةَ والظُبَى","والخيلُ تنزو في الوغى وتلينُ",6,"ن",1,0],["ملكوا قِلاعَ الأرضِ واتَّسقَتْ لهمْ","حِيَلٌ يَضِلُّ بمثلِها الأغمارُ",7,"ر",1,0],["مَلَكوا الأَرضَ قَبلَ أَن تُملَكَ الأَر","ضُ وَقادوا في حافَتَيها الجُنودا",8,"د",2,0],["ملكوا محل الملك من أعدائهم","فغدت بقاع الأرض منه مساجدا",9,"د",2,0],["مَلَكوا خِطامَ العَيشِ بِالمَلِكِ الَّذي","أَخلاقُهُ لِلمَكرُماتِ حُصونُ",10,"ن",1,0],["ملكوا بني الدنيا فلولا عَدْلُهم","ذهبوا كما ذَهبتْ ثمودُ وعادُ",11,"د",1,0],["ملكوا النّيلَ عنوةً أم أرادوا","أن يكونوا على بَنيهِ عيالا",12,"ل",2,0],["مَلَكوا العَناصِرَ فَالعَصِيُّ مُطاوِعٌ","وَالصَعبُ سَهلٌ وَالبَعيدُ مُدانِ",13,"ن",1,0],["مَلَكوا الشِعابَ عَلى العَدُوِّ وَزاحَموا","شَعبَ النُسورِ وَأُمَّةَ العِقبانِ",13,"ن",1,0],["مَلَكوا عَلَينا البُغيَتَينِ فَلَم نَذُق","طَعمَ الحَياةِ وَلَذَّةَ العِرفانِ",13,"ن",1,0],["مَلِكٌ وَلا غَيرَ الجَماجِمِ حَولَهُ","سُورٌ وَلا غَيرَ الرِقابِ سِلاحُ",14,"ح",1,0],["مَلَكوا فَما سَلَكوا سَبيلَ الرُشدِ بَل","مَلَأوا الدِيارَ ضَوارِباً وَمَزاهِرا",15,"ر",2,0],["مَلَكُوا التَهَائِمَ وَالنَجَا","ئِدَ وَالْحَوَاضِرَ وَالْبَوَادِي",16,"د",2,0],["ملكوا الدنيا فلما جَمَحتْ","ملكوها برفيعِ الأدب",17,"ب",1,0],["ملكُوا الأرضَ لم يسيئوا إِلى شَعْبٍ","ولم يحكموه حُكْمَ العبيدِ",18,"د",1,0],["مَلَكُوا مِقْوَدَ الَّليالي صِعَاباً","وَلَوَوْا هَامَةَ الزَّمَانِ عَنِيدا",19,"د",2,0],["مَلَكوا مقاليدَ البيانِ، فَبِاسْمِهم","نجد الكلامَ مُذَيَّلاً ومصدَّرا",20,"ر",2,0],["ملكوا البلادَ عروشَها وقصورَها","واستعذبوا وعْث التراب مَقيلا",21,"ل",2,0],["ملكوا عليها الدجلتين وحرّموا","بردى وذادوا بالظبى ورّادها",22,"د",3,0],["ملكوا النفوسَ فهل لنا","من بعدها ما يسترادُ",23,"د",1,0],["مَلَكوا فَجاروا في القَضايا وَاِعتَدَوا","وَعَدَلتَ فيهِم إِذ غَدَوتَ مُحَكَّما",24,"م",2,0],["مَلَكُوا الأَقاليمَ العِظامَ وَأَهلَها","بِالمُرهَفاتِ البيضِ لا الأَقلامِ",25,"م",1,0],["ملَكوا الأَرضَ حِقبَةً ثمَّ أَمسَوا","وهُمُ في بُطونِها نُزَلاءُ",26,"ا",2,0],["مَلَكوا الدُنيا فَما دَفَعَ ال","مَوتَ ما حازوا وَما مَلَكوا",27,"ك",3,0],["مَلَكُوا أَمْرَهُمْ وَنَالُوا مُنَاهُمْ","عَاجِلاً وَسَعَى لَهُمْ مَا اشْتَهَوْهُ",28,"و",2,0],["ملكوتُها في كل عصرٍ قد بدا","متعاظماً وبه تتيهُ الأعصر",29,"ر",1,0],["ملكوا القلوبَ بحلمِهم وسخائهم","ورعوا ذمامَ عشيرةٍ وقبيل",30,"ل",1,0],["ملكٌ وَمن عجبٍ له","في كل نفسٍ سحرُ جنّي",31,"ن",2,0],["ملك وابن ملك فإلى","بيته كل المعاني حديت",32,"ت",1,0],["ملك وابن مليك لم يكن","مجده بين الورى مكتسبا",33,"ب",2,0],["ملكوا الناس آمرين وما في ال","ناس إلّا مستعبَدٌ مأمورُ",34,"ر",1,0],["مَلكوا ببذْلِ نوالهمْ وببيأسهمْ","مُهَجَ العُفاةُ وأنْفُس الأعْداءِ",35,"ا",2,0],["ملكوا الورى ومشوا على خدّ الدُّنى","واستخدموا أيامها والأعصرا",36,"ر",2,0],["ملكٌ وإن زعمتْ أعادي ملكه","عفُّ المغيب كريم يوم المشهد",37,"د",1,0],["ملكوا رِبْقَتِي لِما سيّروهُ","من لُصوقي بودّهمْ واِلتزامي",38,"م",2,0],["ملكوا الفخارَ فما ترى مِن بعدهمْ","إلّا اِفتخاراً منهُمُ مسروقا",39,"ق",2,0],["مَلَكوا الأرضَ كلّها ثمّ مَن كا","نَ عَلى الأرضِ في الزمانِ مرارا",40,"ر",2,0],["ملكوت السماء والأرضِ","نافض في الجميع كالنبضِ",41,"ض",1,1],["مَلِكٌ وما الحَقُّ إِلاَّ أَنَّه مَلَكٌ","فَقَدْ عَلاَ بمَعَالِيه عَنِ الْبَشَرِ",42,"ر",1,0],["مَلِكٌ وَجهُهُ طَليقٌ إِلَينا","حينَ نَأتيهِ وَالعَطاءُ جَزيلُ",43,"ل",1,0],["مُلكٌ وَرِثتَ بِه الذَّوينَ وأسعَداً","والأحوصَينِ ونَهشَلاً ومَجاشِعا",44,"ع",2,0],["ملكوته أرواح ملك كيانه","في أي ما قسط وما ميزان",45,"ن",1,0],["ملك وجن فاعل عن أمره","هذا وهذا بالطباع معاند",46,"د",1,0],["ملكوا مواطنها فملَّ","كهم بواطنها القَدَرْ",47,"ر",1,0],["مَلَّكُوا الدَّين كلَّ أُنْثَى وخُنثى","وضَعيفٍ بِغَيْرِ باسٍ يَصولُ",48,"ل",1,0],["مِلِكٌ وَفِيٌّ للعُلا بكمالِهِ","أَضْحى على كُلِّ البَريّةِ مُوفي",49,"ف",2,0],["مَلِكٌ وثِقْتُ بأَنَّ جودَ يَمينِهِ","أَدْنو فيُغني باليَسارِ يَميني",50,"ن",2,0],["مَلكوا العزاءَ وقلَّما فجِعوا بما","يُنْسي الرّجال بِحيرَةٍ البابَها",51,"ب",3,0],["ملكون أَملاك السما","سلام سكان الحمى",52,"ا",1,0],["ملكوا المال فلما ملكوا","خَرجوا عَن كل شيء ملكوا",53,"ك",3,1],["مَلَكُونِي بِحُبِّهِمْ وَرَضُوا عَنْ","عَبْدِ رِقٍّ فَسُدْتُ بَيْنَ المَوَالِي",54,"ل",2,0],["ملك وفا كل الصحائف حوله","جند كذا الأشكال كالحجاب",55,"ب",1,0],["ملكوا بالسيوف بنت ذكاء","وهم اليوم تحت رق الرقاع",56,"ع",1,0],["مَلَكُوتٌ فيه العوالمُ تَجري","آمناتٍ طوارئ الحدَثَانِ",57,"ن",1,0],["مَلِكٌ ومن مُلُوك ذكرُهُم","ملأَ الغَربَ وزادَ المَشرِقا",58,"ق",2,0],["مَلكٌ ولاياتُ البلاد وعزلُها","ما بين قَطْعٍ منه أَو إِقطاعِ",59,"ع",1,0],["مَلِكٌ واضِحُ الجَبينِ كَأَنَّ الشْ","شَمسَ ما بَينَ تاجِهِ وَلِثامِه",60,"م",2,0],["مَلَكوا مَكاناً هَدَّ رُكنَ عُدُوِّهِم","وَعَدُوِّهِ وَحَسودِهِم وَحَسودِهِ",61,"د",2,0],["ملكوا الفراسة والخفايا عندها","كالصبح جلت قدرة المنان",62,"ن",1,0],["ملكوا رقى بملكى رقهم","فأنا الموقع نفسي في البلش",63,"ش",1,0],["مَلكوا أفكوا فَتَكوا","هَتَكوا حرمة الأشهر الحرم",64,"م",1,0],["مَلَكوا مِني فُؤاداً طيّعاً","فَغَدا مُلكَهُمُ مُلكَ يَمين",65,"ن",1,0],["ملك ومن ناظريه قاد عسكره","من فتكه قط لم يدفع بأتراس",66,"س",1,0],["ملك وَأفئدة المُلوك جُنوده","وَالحسن وَالإحسان مِن عماله",67,"ل",2,0],["ملكوا العلى واستخرجوا رزق الثرى","وشرابهم عذب العلوم رحيق",68,"ق",1,0],["ملكوا الملوك وأوغلوا","بالروم فتحاً والخزر",69,"ر",1,0],["ملكوا غاية السباق وفازوا","بمعلى قداحها والرقيب",70,"ب",1,0],["ملكوا النفوس فهل لها","من بعدها ما يستعاد",71,"د",1,0],["ملكوني بلطفهم ورضوا بي","عبد رق فسدت بين الرجال",72,"ل",1,0],["مَلَكوا الظُنون وَحلّقوا","فَوقَ الظُنون إِلى الأرب",73,"ب",1,0],["ملكوا البلادَ ودوختْ غاراتُهم","ما بينَ عامرِها وبينَ الغَامِرِ",74,"ر",1,0],["ملكوا وسامَهُمُ الدنيةَ معشرٌ","لا العقلُ راضَهُم ولا التأديبُ",75,"ب",1,0],["ملكوا أجاروا أطلقوا وتوطدت","بشبا مواضيها لكم أعوادها",76,"د",3,0],["ملكوا الماء والرماح إليهم","شاخصاتٌ والبيض كانت شهودا",77,"د",2,0],["ملكوا برهةً فسادوا وقادوا","ثم صاروا أحدوثة السمار",78,"ر",1,0],["ملكوتٌ يَضُمُّ كل طَهُورٍ","مالِكوهُ ملائكُ العَلامِ",79,"م",1,0],["مَلكُونُ كِسبارُ السَرِيُّ وبَختَصا","لُ طَوَوا بعَسفِهِمِ السريعِ الفَدفَدا",80,"د",2,0],["مَلَكوُتُهُ الأَسنَى السَناءُ ورَبُّهُ","حُبُّ النِساءِ ودِينهُ الدينارُ",81,"ر",1,0],["ملكوا الدنا وتبوأوا من رحبها","ملكاً وجالوا في الغَرام مجاليا",82,"ي",2,0],["ملكوا قيد المعالي","فقضوا حق علاها",83,"ا",3,0],["ملك ولكن الملوك عبيده","ما كل منصلت يقد المغفرا",84,"ر",2,0],["مُلكٌ وَعَدلٌ وَمَجدٌ فاضَ مَنبَعَهُ","بِالعلم ما بَينَ مَعفول وَمَنقولِ",85,"ل",1,0],["مَلكوا جميعَ المَشرِقَينِ وأَخضَعُوا ال","بَاغِينَ فِيها أَيَّما إِخضاعِ",86,"ع",1,0],["ملكوا مِصْرَ مثلَ قلبي وفي ه","ذا وهاتيكَ أَصبحوا سُكّانا",87,"ن",2,0],["ملكوا ريقة الزمان قديماً","واسترقوا بنيه حراً وعبدا",88,"د",2,0],["ملكوا المسعود نجل الأشرف","ابن المليك الناصر بن الاشرف",89,"ف",1,0],["ملكوا بنو العباس جَوْراً في الورى","فأتاهمُ صَرْفُ البَوَارِ فبارُوا",90,"ر",3,0],["ملكوا أماكن ليس تحصى واشتفوا","من كل طاغ في الزمان ومفسد",91,"د",1,0],["ملكوني وأشعلوني وداداً","ثم راحو وخلفوا أتراحي",92,"ح",2,0],["ملكوا الفناءَ ودونهُ نهَما سَعوا","وملكتَ أنتَ من الكمالِ نصابا",93,"ب",2,0],["ملكوا الغيد لا العلم ولا ما","لٍ ولكن لهم جسومٌ جسامُ",94,"م",1,0],["ملكوت كسرى ياحبيب بأسره","عندالعناق ضممتُه بذراعي",95,"ع",2,0],["ملكٌ وغلّابٌ وقهّارٌ صفا","تك قاصماتُ الخصمِ يا أللهُ",96,"ل",2,0],["ملكوا المشرقين باسمك حتى","شيدوا للإسلام مجداً أثيلا",97,"ل",2,0],["ملكٌ وفي جبروته","يُحيي الفؤاد تعطفا",98,"ف",2,0],["ملكٌ ومن آلائه","نارٌ تُحرّقُ مدنفا",98,"ف",2,0],["ملكوا مدارات الزمان وسجلوا","فضلاً على مر الزمان يسجل ُ",99,"ل",1,0],["ملكوا سلاحاً فاق أعظم دولة","خرقوا الشرائع قرصنوا في الماء",100,"ا",2,0],["ملكوا الدنيا ولكن","خرجوا صفرا يبابا",101,"ب",2,0],["ملكوا القصور مع العتاد","وتوارثوا ذات العماد",102,"د",1,0],["ملكوا أكرم الخصال أروماً","لم يُشَبْ قط مذ جرى التكوينُ",103,"ن",1,0],["ملكوا الزِّمامَ وأهدروا دمَنا","قطفوا الزهورَ لييبس الفَنَنُ",104,"ن",1,0],["ملكوا العقول وجملوا أفعالها","وتزينت في فعلها أفكارها",105,"ر",3,0],["ملكوا المكارم للعلى طرقا","فتسابقوا فيها وما انحرفوا",106,"ف",3,0]]}