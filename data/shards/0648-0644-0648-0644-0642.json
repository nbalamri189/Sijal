{"poems":[[55,"لواعج الشوق تخطيهم وتصميني","https://www.aldiwan.net/poem29744.html","البسيط"],[30,"وأفلت دجال النفاق وما نجا","https://www.aldiwan.net/poem5107.html","الطويل"],[30,"ولو لقيت الذي تكنى بكنيته","https://www.aldiwan.net/poem5222.html","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43755","الوافر"],[401,"أجارتنا غُضي من السير أو قفي","https://www.aldiwan.net/poem596.html",""],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2219,"","https://poetry.dctabudhabi.ae/diwan/poem/103393","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131292",""]],"verses":[["وَلَو لَقوا بَعضَ ما أَلقى نَعِمتُ بِهِم","لَكِنَّهُم سَلِموا مِمّا يُعَنّيني",0,"ن",2,0],["وَلَو لَقِيا الحَجّاجَ في الخَيلِ لاقَيا","حِسابَ يَهودِيَّينِ مِن أَهلِ كَسكَرا",1,"ر",2,0],["وَلَو لَقِيَ الخَيلَ اِبنُ سَعدٍ لَقَنَّعوا","عِمامَتَهُ المَيلاءَ عَضباً مُذَكَّرا",1,"ر",2,0],["وَلَو لَقيتَ الَّذي تُكنى بِكُنيَتِهِ","فَاِسطاعَ مِنكَ أَبا الأَشبالِ لَاِنجَحَرا",2,"ر",2,1],["وَلَو لَقَّنتَهُ مائَةً","مِنَ الآياتِ أَتقَنَها",3,"ن",3,0],["ولو لُقي النُّعمانُ حَيّاً لَنالها","ولو بعث الجنيّ في الناس يصطفي",4,"ف",2,0],["ولو لقِّيتم فيه رشاداً","فتتبعون دون بني أبينا",5,"ن",2,0],["ولو لَقَيت ما كنتُ ألقى من العدَى","إذاً شابَ منها مَفرقٌ وقَذالُ",6,"ل",1,0],["ولو لقي الخود الجميلة فاسقٌ","لأحجم عنها وهم جم المخاوف",7,"ف",1,0]]}