لب","https://www.poetsgate.com/ViewPoem.aspx?id=204477",""],[6003,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=200570",""],[6052,"ميراث الفضيلة","https://www.poetsgate.com/ViewPoem.aspx?id=35378",""],[6056,"لمسة حنان","https://www.poetsgate.com/ViewPoem.aspx?id=130348",""],[6056,"نار اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=130380",""],[6068,"يا عشقها -06-","https://www.poetsgate.com/ViewPoem.aspx?id=175878",""],[6102,"عودة اضطرارية","https://www.poetsgate.com/ViewPoem.aspx?id=184458",""],[6131,"نَوابضُ الضَّادْ","https://www.poetsgate.com/ViewPoem.aspx?id=189282",""],[6175,"عبيدكَ ليسوا حَجَرْ!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72850&r=&rc=75",""],[6189,"نبوءة العمائم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83598&r=&rc=65",""],[357,"تعبت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82968&r=&rc=13",""],[2588,"يا بعلبك عروسة البلدان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83217&r=&rc=165",""],[463,"ألاَ من مبلغٌ أسدا رسولا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59979&r=&rc=35",""],[6325,"أمنيات لطفلٍ عاشق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88019&r=&rc=1",""],[6346,"جَمْرُ الوَدَاعِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84888&r=&rc=13",""],[6355,"اجمل أنثى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66652&r=&rc=112",""]],"verses":[["أمد من الضلوع له ذراعا","وأضرب رمش أجفاني طِنابا",0,"ب",2,0],["أَمَدّوهُ مِن طيبٍ لِغَيرِ كَرامَةٍ","وَضَمّوهُ في ثَوبٍ جَديدِ البَنائِقِ",1,"ق",1,0],["أَمَدَّت عَلَيكَ القُلوبُ العُيونَ","فَلَيسَ يُرى مَدمَعٌ ناضِبُ",2,"ب",1,0],["أمدّ له سلمّا","إلى النور من أضلعي",3,"ع",2,0],["أَمُدُّ عَيني إِلى الدُنيا وَزَهرَتِها","فَما تَرى العَينُ شَيئاً غَيرَها حَسَنا",4,"ن",2,1],["أمدك فيها الله بالملإ العلى","فجيشك مهما حقق الأمر جيشان",5,"ن",1,0],["أَمِدِّيني بِأَرْوَاحٍ زَوَاكٍ","لأُقْرِئَهَا الزَّكِيَّ مِنَ السَّلامِ",6,"م",1,0],["أَمدامعٌ منهلَّةٌ أم لؤلؤُ","لما استهلَّ العارض المتلألِئُ",7,"ل",2,1],["أمددتها بمداد ليس يعقبه","دمع الأنام وإن يبكوك أحوال",8,"ل",1,0],["أَمَدَحتُمُ الجَمَلَ الكَريمَ بَناتُهُ","لَكِن بَناتُ أَبيكَ غَيرُ كِرامِ",9,"م",1,0],["أمدُّ لها كفِّي فيهتزّ فرحةً","كما انْتفض العصفور بلَّله المطر",10,"ر",1,0],["أمداحه من عطاه أو فضائله","كأنَّ أمداحه من تبره سبكوا",11,"ك",3,0],["أمدُّ يدي في كلِّ يومٍ لذيلِها","فآخذ من جورِ الشتاء ذماما",12,"م",2,0],["أمْدَدْتَ شِعْري بأَمْدَادٍ مظاهَرَةٍ","من المناقب لا تُحْصَى بِتعديدِ",13,"د",1,0],["أمُدُّ إلى الطُولى يداً ذاتَ بسطةٍ","وعين كريم لا يُقال لها غُضِّي",14,"ض",2,0],["أَمُداوِيَ الأَرواحِ قَبلَ جُسومِها","قُم داوِ فيكَ فُؤادِيَ المَحزونا",15,"ن",2,0],["اُمدُد حُداءَكَ في النَجائِبِ تَنصَرِف","يَهوى أَعِنَّتِها إِلى تَحنانِهِ",16,"ن",2,0],["اِمْدَحِ الكَأْسَ ومَنْ أَعْمَلَها","واهْجُ قَوْماً قَتَلُونا بالعَطَشْ",17,"ش",1,1],["أمدّت بواطن أركاننا","بامثالها فغدت تظهرُ",18,"ر",1,0],["أَم دَبَّ لي كاشِحٌ فَأَضرَمَ لي","عِندَكَ ناراً بِالإِفكِ تَلتَهِبُ",19,"ب",1,0],["أَمُدُّ كَفّي لِأَخذِ الكَأسِ مِن رَشَأِ","وَحاجَتي كُلُّها في حامِلِ الكاسِ",20,"س",1,0],["أَمَدُّ الرِجالِ لُبثَةً حينَ يَرتَأي","وَأَسرَعُهُم إِمضاءَةً حينَ يَعزِمُ",21,"م",1,0],["أمدّ يديَّ في لهف إليه","أشاكيه بمحتبس الدموعِ",22,"ع",1,0],["أمُدامٌ عن حَبابٍ تبتسمْ","أمْ عقيقٌ فوقه دُرٌّ نُظِمْ",23,"م",1,0],["أَمدَدتَهُ في العُدمِ وَالعُدمُ الجَوى","بِالجودِ وَالجودُ الطَبيبُ الآسي",24,"س",2,0],["أمَدائِحٌ لِي فِيكَ أمْ تَسْبِيحُ","لوْلاكَ ما غَفَرَ الذنوبَ مَدِيحُ",25,"ح",1,1],["أمَدُ المَطالبِ والوفودِ إذا حَدَتْ","فَوْتَ العيونِ رِكابُها رُكبانها",26,"ن",3,0],["أمْدِده أو فاصْفَحْ له عَنْ نَيْلِهِ","فلقد تَخَوّفَ أن يُقالَ ضَنين",27,"ن",1,0],["أمُديرَها من حيثُ دارَ لَشَدّ مَا","زاحمتَ حولَ ركابهِ جِبريلا",28,"ل",2,0],["أُمَّ دَفرٍ جُزيتِ شَرّاً فَدَيّا","نُكِ يَغدو كَالضَيغَمِ الهَمّاسِ",29,"س",1,1],["أُمَّ دَفرٍ إِنّي هَويتُكِ جِدّاً","أَيُّ ضَبٍّ تَرَكتِ مِن غَيرِ حَرشِ",30,"ش",1,0],["أُمُّ دَفرٍ تَقولُ بَعدَكَ لِلذا","ئِقِ لا تَعمَ لي فَأَينَ فَحايَه",31,"ا",3,0],["أَم دَلَّكُم بَعضُ مَن يَرتادَ مَشتَمَتي","بِأَيِّ أَكلَةِ لَحمٍ تُؤكَلُ الكَتِفُ",32,"ف",1,0],["أَمدينةَ الإسلام يا دار السلا","م لمن أقام وكعبة القصاد",33,"د",1,0],["أمدّ كفّي إلى كنزي فيغمرها","بما أحبّ شبابا جامحا وددا",34,"د",2,0],["أَمَدٌ عِشْتَهُ مَدِيدٌ وَلَكِنْ","قَصَّرَتْهُ السُّعودُ فِي الآمَادِ",35,"د",1,0],["أُمُّ دُرزٍ إِلَيَّ فيهِ أَساءَت","وَمَتى قَطّ أَحسَنتُ أُمُّ دُرزِ",36,"ز",1,0],["أمد يدي فأنتزع الرواسي","وأبني المجد مؤتلقاً مكينا",37,"ن",2,0],["إم داراً حُطتمُوها بالنَّدى","أخذتْ عهدَ النَّدى ألاَّ تميل",38,"ل",1,0],["أمْ دهركم ألهَاكُمُ","أَمْ قلبكم عنّا نَفر",39,"ر",1,0],["أمدّ إلى اللصوص يدَي دفاعٍ","وإن كانوا ذوي أيدٍ طوالِ",40,"ل",1,0],["أم دوحة صاح فيها الطير وابتسمت","آقاحها عن ثغورٍ لؤلؤيات",41,"ت",1,0],["أمدّ إلى معطي الغنى كلّ طالب","وأقبضُها عن طالب متطاول",42,"ل",1,0],["أَمدحُ المُصطفى هناكَ وأَتلو","هُ كِفاحاً يجود لي فأجيدُ",43,"د",1,0],["أمدوهم إذا شئتم بجيش","وقاح الوجه منزوع النقاب",44,"ب",1,0],["أمُدَبِّرَ المُلكِ المُقيم","أرى الليالي بَعضَ جُندِك",45,"ك",1,0],["أمدُّ يَدي كي أمسحَ الدّمعَ غافلاً","فأعلم كيفَ الدّمعُ في العينِ يجمد",46,"د",1,0],["أمدينةَ المنصورِ يا زوراء يا","بلدَ السلامِ سَلِمتِ يا بغداد",47,"د",1,0],["أمدُّ الوَرَى في كلِّ صالِحَةٍ يَداً","وحَسْبكَ خافٍ مِنْ ثناهُ وظَاهِرُ",48,"ر",1,0],["أمَدّ بِجدٍّ صَاعِدٍ جُرَعَ الرّدى","عِدَاه فمَغْلُوبٌ بِهِ كُلُّ غَالِبِ",49,"ب",1,0],["أمدُّ ما تَلقى طَلاقَتُهُ مَدىً","في اليومِ أنّ ضُحاه يَطْلعُ شاحِبا",50,"ب",2,0],["أَمَدَّ اللهُ ظِلَّكَ يا سِعِيدُ","عَلَيَّ فَإِنَّهُ الظِّلُّ الْمَدِيدُ",51,"د",1,1],["اُمدُد إِلَيَّ يَداً يَعتادُها الكَرَمُ","سَما بِها الماضِيانِ السَيفُ وَالقَلَمُ",52,"م",1,1],["أَم دَروا أَنّا وردنا بَعدَهم","سائغَ العَذبِ من البَلوى أجاجا",53,"ج",2,0],["أَمدَّه الدمعُ حتى غاضَ جائدُه","فمنْ بأَدمعِ عينيه يرافدُه",54,"د",2,1],["أمدّ الورى باعاً وأوثق منعة","وَأَمتنهم ديناً وَأَخلصهم قلبا",55,"ب",2,0],["امْدُدْ يَداً لي بِالكِساءِ فَإنَّ لي","رِجْلاً تُؤَمِّلُ في كِسَائِكَ حَدَّها",56,"ه",2,0],["أمدها أليك يدي لاشتياقي","ودمع عيني من العين يجدي",57,"ي",1,0],["أمدَحُهمم عُمْري ولكنّني","أرجو من الله ثَوابَ امتداح",58,"ح",1,0],["أم دُمُوع في جُفُونٍ","مَثَّلت فيها نُجُوما",59,"م",2,0],["أَمد اللَه هِمَتُهُ بعز","وَروجها الَّذي خَلق الرَواجا",60,"ج",2,0],["أَمُديرَ كاسِ الجودِ قَد ثَمِلَ الوَرى","أَنَّى لَهُم صَحوٌ وَأَنتَ السَّاقِي",61,"ق",2,0],["أُمدَاماً أهديْتَ لي أم نِظاماً","فعله في العقول فعل الخمور",62,"ر",1,0],["أمَدَّ من همَّته وعزمه","ظِلاًّ على الإسلام منه قد ضفا",63,"ا",1,0],["أمدَّ على قطر العراقين ظلّه","إذا عصفت في الملك نكباء زعزعُ",64,"ع",1,0],["أم دمنة باللوى عفّت مرابعها","يد البلى ومماها الأزلم الجذَعُ",65,"ع",1,0],["أُمدِدْتَ فِيهِ بالملائكةِ الَّتِي","نُصرَتْ بِهَا أَعمامُكَ الأَنصارُ",66,"ر",1,0],["امدُدْ يَمينكَ شافِعاً ومُشَفَّعاً","تَحُزِ الثَّناءَ مُخلَّداً بمُخلَّدِ",67,"د",1,0],["أمدى الحياة تجرّم وتعتب","فمتى البراءة والرضى ووصالك",68,"ك",1,0],["أم دكا كين يضرب العود فيها","ويباع المفروش والملبوس",69,"س",1,0],["اُمدُدْ إلى النجم يداً إنما","يكونُ عن غيركُمُ عاليا",70,"ي",2,0],["أم دمي وهو عزيزٌ","هان في دِينِ هواكِ",71,"ك",1,0],["أمدّ بها كفاً صَناعاً كأنني","أهيب بسيفٍ في الهياج صنيعِ",72,"ع",1,0],["امدد بيمناك على مجدٍ عفا","خِصباً وجدِّدْ رسمَ جُودٍ قد دَثَرْ",73,"ر",1,0],["أمدُّ غليه أرشيةَ المعالي","فعيطِشُني وراحتُه القَليبُ",74,"ب",1,0],["أمدحُ المثرِين ظنَّاً بهِمُ","ربّما يقمَر بالظنّ الكذوبِ",75,"ب",1,0],["أمْدحُه أبْلَجَ كالنَّهارِ","غمْرَ السَّجايا سالماً منْ عارِ",76,"ر",1,1],["أَم دَمٌ مَجَّ ريقَهُ فَمُ عِرقٍ","وَجهُهُ ساعِدُ الغَزالِ الغَريرِ",77,"ر",1,0],["أمدَّ بغير شاخصه ظلالٌ","وهل ثمر إذا امتنع اللقاح",78,"ح",1,0],["أمْدُدْ يَميناً منكَ لي عَظيمَةً","لعلَّها من سَقَمي تَشْفينِي",79,"ن",2,0],["إمْدَحْهُ مُحْتسباً ولُذْ بِجنابِه","لتُسِحَّ منكَ على الفُؤادِ منائِحهْ",80,"ح",2,0],["أمِدادُ الحُروفِ مَع حَرَكاتٍ","مِن سوادٍ منها ومن أشفَارِ",81,"ر",1,0],["أمدَّهُ اللهُ بعون مُسعِدٍ","له علَى فِعلِ المُفيد الأفيَد",82,"د",1,0],["أمدُّ زندي كزند العودِ محتضِناً","صدرَ الجراح التي لم تلقَ مُحْتَضِنَا",83,"ن",2,0],["أمد الدهر ما جلا بمديح","فيه عبد الغنيْ رقيق النظام",84,"م",1,0],["أمد الأزمان ما غرد في","دوحه الطائر فاهتاج الطرب",85,"ب",1,0],["امْدَحْ وَقُلْ في مَعَانيهِ فَقَدْ كَرُمَتْ","لا يَحْسُنُ القَوْلُ حَتَّى يَحْسُنُ العَمَلُ",86,"ل",1,0],["أمدير المعارف الشهم إنّي","لمساعيك بالثناءِ أُقابِل",87,"ل",1,0],["امدَح أبا عبدِ الإل","هِ فتى البريّةِ في احتمالِهْ",88,"ل",2,1],["أَمدّ يَميني بِالتَضرع وَالدُعا","إِلَيك مغيث المُستَغيث مِن الشَرِّ",89,"ر",1,1],["أَمدينة مِن فَوق سَطح الماءِ","تَجري بِأَبَهج مَنظر وبَهاءِ",90,"ا",2,1],["أَمداحُهُ في آل بَيت مُحمَّدٍ","بَينَ الوَرى مسكيّةُ الأَنفاسِ",91,"س",1,0],["أم دكَّتِ الأطواد في جزع فمن","جثث البرايا شمَّخ الأطواد",92,"د",1,0],["أم درمان إن قومك جاروا","واستباحوا محارم الضعفاء",93,"ا",2,0],["أم درمان كم من الظلم أظلم","ت إذن فاشرقي بلمع الدماء",93,"ا",2,0],["أم درمان سوف تنسيننا لُنْ","دُنَ أمَّ المدائنِ الزهراء",93,"ا",2,0],["أُمدُده إلَهي بِالنّصر","وَاِقطَع عَنهم كلّ المددِ",94,"د",1,0],["أمدَّك اللَّهُ بما شئته","وأعظم اللَّه لك الأجرا",95,"ر",2,0],["أمدك اللَّه فيها","بكل يُسْرِ مُيَسَّر",96,"ر",1,0],["امدَحْ رسولَ اللَّه تُسْقى من الر","رحْمَةِ بعد المحْل بالغيثِ",97,"ث",1,1],["أمُدّ ُيَدي نحْوهَا صارخا ً","خذيني حسيرَ الدمَا أوْ دَعِي",98,"ع",2,0],["أَمُدُّ يَديِ إِلِيْكِ وأَنْتِ حَمْقَا","ويَغْلِبُ طَبْعَكِ الخُيَلاءُ والشَّرّْ",99,"ر",1,0],["أمدك في علائك بالمزيد","إله العرش والعمر المديدِ",100,"د",1,1],["أمدّك اللّه ملكاً لا نفاد له","وَقرن عزّ لهام النجم نطّاحا",101,"ح",2,0],["أَمددَ اللّه بقاها","وَرَعاها وسَقاها",102,"ه",2,0],["أَمدّلج القفارِ بكلِّ حرفٍ","تَجوبُ بذرعها فسح القفارِ",103,"ر",1,0],["أمدّ ظلالَ العدلِ في ملكهِ على","مَشارق أَقصى ملكه والمغاربِ",104,"ب",1,0],["أَمُداماً فَرَطتُم لِمُدامٍ","أَم زُجاجاً سَبَكتُمُ في زُجاجِ",105,"ج",1,0],["أمدّ قلبي نحو كاساتها","رشفاً إذا مدّت إلى الراح راحْ",106,"ح",1,0],["أَمُدامٌ باكَرَتنا","تِبرُها في الكَأسِ ذائِب",107,"ب",1,1],["أَمَدَّ وَلَم يُمدَد وَماتَ مُشَمِّرا","إِلى اللَهِ لَم يَذهَب بِأَثوابِ غادِرِ",108,"ر",1,0],["أَمْدَدْتنا حِلْماً يَسَفِّهُ أَحْنَفاً","وعَمَمْتَنا جُوداً يُبخِّلُ حاتِماً",109,"م",2,0],["امْدَحْهُ غَيْرَ مُقَصِّرٍ","فَهُوَ الحَقيقُ بِما مَدَحْتا",110,"ت",2,0],[