{"poems":[[53,"ألا يا لقومي للخطوب الطوارق","https://www.aldiwan.net/poem29952.html","الطويل"],[53,"كذا يهجم القدر الغالب","https://www.aldiwan.net/poem30740.html","المتقارب"],[100,"اليوم الجنين","https://www.aldiwan.net/poem43675.html","عموديه"],[55,"أمد عيني إلى الدنيا وزهرتها","https://www.aldiwan.net/poem26063.html","البسيط"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[93,"إلى مصر أزف عن الشآم","https://www.aldiwan.net/poem11411.html","الوافر"],[83,"أمدامع منهلة أم لؤلؤ","https://www.aldiwan.net/poem54345.html","الكامل"],[88,"أزمعت عنا إلى مولاك ترحالا","https://www.aldiwan.net/poem45053.html","البسيط"],[27,"حيوا الديار وأهلها بسلام","https://www.aldiwan.net/poem6005.html","الكامل"],[72,"سأشكر نعماك التي من أقلها","https://www.aldiwan.net/poem18947.html","الطويل"],[72,"طيف تصيدته والليل محتبك","https://www.aldiwan.net/poem19439.html","البسيط"],[72,"تفهمه قلبي الشجي فهاما","https://www.aldiwan.net/poem19682.html","الطويل"],[51,"للناس عيد ولي عيدان في العيد","https://www.aldiwan.net/poem10864.html","البسيط"],[51,"أسوغ لخلاني مساغ شرابهم","https://www.aldiwan.net/poem64944.html","الطويل"],[85,"أوحت لطرفك فاستهل شؤونا","https://www.aldiwan.net/poem8112.html","الكامل"],[85,"وطن يرف هوى إلى شبانه","https://www.aldiwan.net/poem63735.html","الطويل"],[56,"امدح الكأس ومن أعملها","https://www.aldiwan.net/poem58562.html","الرمل"],[62,"تطهر بماء الحياة الذي","https://www.aldiwan.net/poem52198.html","المتقارب"],[45,"يا فضل فيما الصدود والغضب","https://www.aldiwan.net/poem11496.html","المنسرح"],[45,"أقام كل ملث الودق رجاس","https://www.aldiwan.net/poem64599.html","البسيط"],[45,"خيال ملم أم حبيب مسلم","https://www.aldiwan.net/poem65652.html","الطويل"],[97,"لعينيك احتملنا ما احتملنا","https://www.aldiwan.net/poem24770.html","الوافر"],[80,"خلعت على بنيات الكروم","https://www.aldiwan.net/poem31295.html","الوافر"],[44,"ما في وقوفك ساعة من باس","https://www.aldiwan.net/poem30485.html","الكامل"],[67,"أمدائح لي فيك أم تسبيح","https://www.aldiwan.net/poem18045.html","الكامل"],[75,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[75,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[46,"أم دفر جزيت شرا فديا","https://www.aldiwan.net/poem22852.html","الخفيف"],[46,"لم يكن لي عرش فيثلم عرشي","https://www.aldiwan.net/poem22870.html","الخفيف"],[46,"ليس يبقى الضرب الطويل على الدهر","https://www.aldiwan.net/poem23619.html","الخفيف"],[19,"طلس العشاء إذا ما جن ليلهم","https://www.aldiwan.net/poem352.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85557","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54755","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[103,"ملكنا هذه الدنيا قرونا","https://www.poetsgate.com/ViewPoem.aspx?id=1234",""],[85,"حبَّذا الساحة ُ والظلُ الظليلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9651&r=&rc=141",""],[126,"مذ مدة ما جاءنا","https://www.aldiwan.net/poem50602.html","مجزوء الكامل"],[133,"سواي بهذه الدنيا يبالي","https://www.aldiwan.net/poem48852.html","الوافر"],[133,"يا صاح قل لي على تلك البراعات","https://www.aldiwan.net/poem49033.html","البسيط"],[184,"أضفني إلى النوكي وقل هو أبله","https://www.aldiwan.net/poem43336.html","الطويل"],[187,"لك يا طيبة علينا عهود","https://www.aldiwan.net/poem35166.html","الخفيف"],[209,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[248,"مولاي هب نظرا لعبدك","https://www.aldiwan.net/poem15004.html","مجزوء الكامل"],[268,"محا لك حسنا مدمع وتسهد","https://www.aldiwan.net/poem35617.html","الطويل"],[268,"عودي الى ماضيك يا بغداد","https://www.aldiwan.net/poem35650.html","الكامل"],[273,"أوائل فتح ما لهن أواخر","https://www.aldiwan.net/poem25552.html","الطويل"],[273,"ألم ترها تسمو لأشرف غاية","https://www.aldiwan.net/poem25624.html","الطويل"],[273,"أهلا بهن أهلة وكواكبا","https://www.aldiwan.net/poem25628.html","الكامل"],[278,"أمد الله ظلك يا سعيد","https://www.aldiwan.net/poem60568.html","الرمل"],[280,"امدد إلي يدا يعتادها الكرم","https://www.aldiwan.net/poem32458.html","البسيط"],[295,"ما على حاديهم لو كان عاجا","https://www.aldiwan.net/poem33310.html","الرمل"],[296,"أمده الدمع حتى غاض جائده","https://www.aldiwan.net/poem36819.html","عموديه"],[303,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[346,"أمطهر بن الطاهر بن مناسب","https://www.aldiwan.net/poem20171.html","الكامل"],[350,"تعبت","https://www.aldiwan.net/poem951.html",""],[362,"صوت حمام الأيك عند الصباح","https://www.aldiwan.net/poem60968.html","السريع"],[369,"أصبح الليل مقيما","https://www.aldiwan.net/poem57132.html","مجزوء الرمل"],[377,"رويدا إن للضيق انفراجا","https://www.aldiwan.net/poem48757.html","الوافر"],[381,"ظعنوا فخيم لاعجُ الأشواق","https://www.aldiwan.net/poem1314.html",""],[400,"ما يصان الغرام بالتستير","https://www.aldiwan.net/poem33908.html","الخفيف"],[413,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[413,"بوادي الغضا للمالكية أربع","https://www.aldiwan.net/poem54180.html","الطويل"],[434,"أمن أميمة مصطاف ومرتبع","https://www.aldiwan.net/poem2573.html","البسيط"],[436,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[436,"كم أستطيل تضللي وتلددي","https://www.aldiwan.net/poem34890.html","الكامل"],[441,"أنا مثلما شئت وشاء دلالك","https://www.aldiwan.net/poem55972.html","عموديه"],[441,"أهي الجنة التي وعد الله","https://www.aldiwan.net/poem55987.html","عموديه"],[456,"أَصاب أو أخطأني راميا","https://www.aldiwan.net/poem55810.html","السريع"],[456,"ياابنة القوم تراك","https://www.aldiwan.net/poem56083.html","مجزوء الرمل"],[456,"أمرتجع لي فارط العيش بالحمى","https://www.aldiwan.net/poem56129.html","الطويل"],[456,"رق لبغداد القضاء والقدر","https://www.aldiwan.net/poem56181.html","الرجز"],[456,"ألا من مبلغ أسدا رسولا","https://www.aldiwan.net/poem56278.html","الوافر"],[456,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[459,"أمدحه أبلج كالنهار","https://www.aldiwan.net/poem16108.html","الرجز"],[466,"أخلوق يسيل من كافور","https://www.aldiwan.net/poem60049.html","الطويل"],[498,"جلا سر الغيوب لنا الصباح","https://www.aldiwan.net/poem37682.html","الوافر"],[498,"حب النبي الهاشمي ديني","https://www.aldiwan.net/poem37768.html","الرجز"],[498,"جدي بواسط أوسط القوم الألى","https://www.aldiwan.net/poem38041.html","الكامل"],[536,"يابن عبد السلام بالطرف رفقا","https://www.aldiwan.net/poem48149.html","عموديه"],[536,"شرط العظيم وصفه بالمهتدي","https://www.aldiwan.net/poem48235.html","عموديه"],[542,"سقياك يا والد النهرين","https://www.aldiwan.net/poem67249.html","عموديه"],[556,"ربنا الله شارع الأحكام","https://www.aldiwan.net/poem33883.html","الخفيف"],[556,"كن على الصدق مقيما والأدب","https://www.aldiwan.net/poem34940.html","الرمل"],[584,"أرح يمينك مما أنت معتقل","https://www.aldiwan.net/poem17644.html","البسيط"]],"verses":[["أَمَدّوهُ مِن طيبٍ لِغَيرِ كَرامَةٍ","وَضَمّوهُ في ثَوبٍ جَديدِ البَنائِقِ",0,"ق",1,0],["أَمَدَّت عَلَيكَ القُلوبُ العُيونَ","فَلَيسَ يُرى مَدمَعٌ ناضِبُ",1,"ب",1,0],["أمدّ له سلمّا","إلى النور من أضلعي",2,"ع",2,0],["أَمُدُّ عَيني إِلى الدُنيا وَزَهرَتِها","فَما تَرى العَينُ شَيئاً غَيرَها حَسَنا",3,"ن",2,1],["أمدك فيها الله بالملإ العلى","فجيشك مهما حقق الأمر جيشان",4,"ن",1,0],["أَمِدِّيني بِأَرْوَاحٍ زَوَاكٍ","لأُقْرِئَهَا الزَّكِيَّ مِنَ السَّلامِ",5,"م",1,0],["أَمدامعٌ منهلَّةٌ أم لؤلؤُ","لما استهلَّ العارض المتلألِئُ",6,"ل",2,1],["أمددتها بمداد ليس يعقبه","دمع الأنام وإن يبكوك أحوال",7,"ل",1,0],["أَمَدَحتُمُ الجَمَلَ الكَريمَ بَناتُهُ","لَكِن بَناتُ أَبيكَ غَيرُ كِرامِ",8,"م",1,0],["أمدُّ لها كفِّي فيهتزّ فرحةً","كما انْتفض العصفور بلَّله المطر",9,"ر",1,0],["أمداحه من عطاه أو فضائله","كأنَّ أمداحه من تبره سبكوا",10,"ك",3,0],["أمدُّ يدي في كلِّ يومٍ لذيلِها","فآخذ من جورِ الشتاء ذماما",11,"م",2,0],["أمْدَدْتَ شِعْري بأَمْدَادٍ مظاهَرَةٍ","من المناقب لا تُحْصَى بِتعديدِ",12,"د",1,0],["أمُدُّ إلى الطُولى يداً ذاتَ بسطةٍ","وعين كريم لا يُقال لها غُضِّي",13,"ي",1,0],["أَمُداوِيَ الأَرواحِ قَبلَ جُسومِها","قُم داوِ فيكَ فُؤادِيَ المَحزونا",14,"ن",2,0],["اُمدُد حُداءَكَ في النَجائِبِ تَنصَرِف","يَهوى أَعِنَّتِها إِلى تَحنانِهِ",15,"ن",2,0],["اِمْدَحِ الكَأْسَ ومَنْ أَعْمَلَها","واهْجُ قَوْماً قَتَلُونا بالعَطَشْ",16,"ش",1,1],["أمدّت بواطن أركاننا","بامثالها فغدت تظهرُ",17,"ر",1,0],["أَم دَبَّ لي كاشِحٌ فَأَضرَمَ لي","عِندَكَ ناراً بِالإِفكِ تَلتَهِبُ",18,"ب",1,0],["أَمُدُّ كَفّي لِأَخذِ الكَأسِ مِن رَشَأِ","وَحاجَتي كُلُّها في حامِلِ الكاسِ",19,"س",1,0],["أَمَدُّ الرِجالِ لُبثَةً حينَ يَرتَأي","وَأَسرَعُهُم إِمضاءَةً حينَ يَعزِمُ",20,"م",1,0],["أمدّ يديَّ في لهف إليه","أشاكيه بمحتبس الدموعِ",21,"ع",1,0],["أمُدامٌ عن حَبابٍ تبتسمْ","أمْ عقيقٌ فوقه دُرٌّ نُظِمْ",22,"م",1,0],["أَمدَدتَهُ في العُدمِ وَالعُدمُ الجَوى","بِالجودِ وَالجودُ الطَبيبُ الآسي",23,"س",2,0],["أمَدائِحٌ لِي فِيكَ أمْ تَسْبِيحُ","لوْلاكَ ما غَفَرَ الذنوبَ مَدِيحُ",24,"ح",1,1],["أمَدُ المَطالبِ والوفودِ إذا حَدَتْ","فَوْتَ العيونِ رِكابُها رُكبانها",25,"ن",3,0],["أمْدِده أو فاصْفَحْ له عَنْ نَيْلِهِ","فلقد تَخَوّفَ أن يُقالَ ضَنين",26,"ن",1,0],["أمُديرَها من حيثُ دارَ لَشَدّ مَا","زاحمتَ حولَ ركابهِ جِبريلا",27,"ل",2,0],["أُمَّ دَفرٍ جُزيتِ شَرّاً فَدَيّا","نُكِ يَغدو كَالضَيغَمِ الهَمّاسِ",28,"س",1,1],["أُمَّ دَفرٍ إِنّي هَويتُكِ جِدّاً","أَيُّ ضَبٍّ تَرَكتِ مِن غَيرِ حَرشِ",29,"ش",1,0],["أُمُّ دَفرٍ تَقولُ بَعدَكَ لِلذا","ئِقِ لا تَعمَ لي فَأَينَ فَحايَه",30,"ا",3,0],["أَم دَلَّكُم بَعضُ مَن يَرتادَ مَشتَمَتي","بِأَيِّ أَكلَةِ لَحمٍ تُؤكَلُ الكَتِفُ",31,"ف",1,0],["أَمدينةَ الإسلام يا دار السلا","م لمن أقام وكعبة القصاد",32,"د",1,0],["أَمَدٌ عِشْتَهُ مَدِيدٌ وَلَكِنْ","قَصَّرَتْهُ السُّعودُ فِي الآمَادِ",33,"د",1,0],["أُمُّ دُرزٍ إِلَيَّ فيهِ أَساءَت","وَمَتى قَطّ أَحسَنتُ أُمُّ دُرزِ",34,"ز",1,0],["أمد يدي فأنتزع الرواسي","وأبني المجد مؤتلقاً مكينا",35,"ن",2,0],["إم داراً حُطتمُوها بالنَّدى","أخذتْ عهدَ النَّدى ألاَّ تميل",36,"ل",1,0],["أمْ دهركم ألهَاكُمُ","أَمْ قلبكم عنّا نَفر",37,"ر",1,0],["أمدّ إلى اللصوص يدَي دفاعٍ","وإن كانوا ذوي أيدٍ طوالِ",38,"ل",1,0],["أم دوحة صاح فيها الطير وابتسمت","آقاحها عن ثغورٍ لؤلؤيات",39,"ت",1,0],["أمدّ إلى معطي الغنى كلّ طالب","وأقبضُها عن طالب متطاول",40,"ل",1,0],["أَمدحُ المُصطفى هناكَ وأَتلو","هُ كِفاحاً يجود لي فأجيدُ",41,"د",1,0],["أمدوهم إذا شئتم بجيش","وقاح الوجه منزوع النقاب",42,"ب",1,0],["أمُدَبِّرَ المُلكِ المُقيم","أرى الليالي بَعضَ جُندِك",43,"ك",1,0],["أمدُّ يَدي كي أمسحَ الدّمعَ غافلاً","فأعلم كيفَ الدّمعُ في العينِ يجمد",44,"د",1,0],["أمدينةَ المنصورِ يا زوراء يا","بلدَ السلامِ سَلِمتِ يا بغداد",45,"د",1,0],["أمدُّ الوَرَى في كلِّ صالِحَةٍ يَداً","وحَسْبكَ خافٍ مِنْ ثناهُ وظَاهِرُ",46,"ر",1,0],["أمَدّ بِجدٍّ صَاعِدٍ جُرَعَ الرّدى","عِدَاه فمَغْلُوبٌ بِهِ كُلُّ غَالِبِ",47,"ب",1,0],["أمدُّ ما تَلقى طَلاقَتُهُ مَدىً","في اليومِ أنّ ضُحاه يَطْلعُ شاحِبا",48,"ب",2,0],["أَمَدَّ اللهُ ظِلَّكَ يا سِعِيدُ","عَلَيَّ فَإِنَّهُ الظِّلُّ الْمَدِيدُ",49,"د",1,1],["اُمدُد إِلَيَّ يَداً يَعتادُها الكَرَمُ","سَما بِها الماضِيانِ السَيفُ وَالقَلَمُ",50,"م",1,1],["أَم دَروا أَنّا وردنا بَعدَهم","سائغَ العَذبِ من البَلوى أجاجا",51,"ج",2,0],["أَمدَّه الدمعُ حتى غاضَ جائدُه","فمنْ بأَدمعِ عينيه يرافدُه",52,"د",2,1],["أمدّ الورى باعاً وأوثق منعة","وَأَمتنهم ديناً وَأَخلصهم قلبا",53,"ب",2,0],["امْدُدْ يَداً لي بِالكِساءِ فَإنَّ لي","رِجْلاً تُؤَمِّلُ في كِسَائِكَ حَدَّها",54,"ه",2,0],["أمدها أليك يدي لاشتياقي","ودمع عيني من العين يجدي",55,"ي",1,0],["أمدَحُهمم عُمْري ولكنّني","أرجو من الله ثَوابَ امتداح",56,"ح",1,0],["أم دُمُوع في جُفُونٍ","مَثَّلت فيها نُجُوما",57,"م",2,0],["أَمد اللَه هِمَتُهُ بعز","وَروجها الَّذي خَلق الرَواجا",58,"ج",2,0],["أَمُديرَ كاسِ الجودِ قَد ثَمِلَ الوَرى","أَنَّى لَهُم صَحوٌ وَأَنتَ السَّاقِي",59,"ق",2,0],["أُمدَاماً أهديْتَ لي أم نِظاماً","فعله في العقول فعل الخمور",60,"ر",1,0],["أمَدَّ من همَّته وعزمه","ظِلاًّ على الإسلام منه قد ضفا",61,"ا",1,0],["أمدَّ على قطر العراقين ظلّه","إذا عصفت في الملك نكباء زعزعُ",62,"ع",1,0],["أم دمنة باللوى عفّت مرابعها","يد البلى ومماها الأزلم الجذَعُ",63,"ع",1,0],["أُمدِدْتَ فِيهِ بالملائكةِ الَّتِي","نُصرَتْ بِهَا أَعمامُكَ الأَنصارُ",64,"ر",1,0],["امدُدْ يَمينكَ شافِعاً ومُشَفَّعاً","تَحُزِ الثَّناءَ مُخلَّداً بمُخلَّدِ",65,"د",1,0],["أمدى الحياة تجرّم وتعتب","فمتى البراءة والرضى ووصالك",66,"ك",1,0],["أم دكا كين يضرب العود فيها","ويباع المفروش والملبوس",67,"س",1,0],["اُمدُدْ إلى النجم يداً إنما","يكونُ عن غيركُمُ عاليا",68,"ي",2,0],["أم دمي وهو عزيزٌ","هان في دِينِ هواكِ",69,"ك",1,0],["أمدّ بها كفاً صَناعاً كأنني","أهيب بسيفٍ في الهياج صنيعِ",70,"ع",1,0],["امدد بيمناك على مجدٍ عفا","خِصباً وجدِّدْ رسمَ جُودٍ قد دَثَرْ",71,"ر",1,0],["أمدُّ غليه أرشيةَ المعالي","فعيطِشُني وراحتُه القَليبُ",72,"ب",1,0],["أمدحُ المثرِين ظنَّاً بهِمُ","ربّما يقمَر بالظنّ الكذوبِ",73,"ب",1,0],["أمْدحُه أبْلَجَ كالنَّهارِ","غمْرَ السَّجايا سالماً منْ عارِ",74,"ر",1,1],["أَم دَمٌ مَجَّ ريقَهُ فَمُ عِرقٍ","وَجهُهُ ساعِدُ الغَزالِ الغَريرِ",75,"ر",1,0],["أمدَّ بغير شاخصه ظلالٌ","وهل ثمر إذا امتنع اللقاح",76,"ح",1,0],["أمْدُدْ يَميناً منكَ لي عَظيمَةً","لعلَّها من سَقَمي تَشْفينِي",77,"ي",1,0],["إمْدَحْهُ مُحْتسباً ولُذْ بِجنابِه","لتُسِحَّ منكَ على الفُؤادِ منائِحهْ",78,"ح",2,0],["أمِدادُ الحُروفِ مَع حَرَكاتٍ","مِن سوادٍ منها ومن أشفَارِ",79,"ر",1,0],["أمدَّهُ اللهُ بعون مُسعِدٍ","له علَى فِعلِ المُفيد الأفيَد",80,"د",1,0],["أمدُّ زندي كزند العودِ محتضِناً","صدرَ الجراح التي لم تلقَ مُحْتَضِنَا",81,"ن",2,0],["أمد الدهر ما جلا بمديح","فيه عبد الغنيْ رقيق النظام",82,"م",1,0],["أمد الأزمان ما غرد في","دوحه الطائر فاهتاج الطرب",83,"ب",1,0],["امْدَحْ وَقُلْ في مَعَانيهِ فَقَدْ كَرُمَتْ","لا يَحْسُنُ القَوْلُ حَتَّى يَحْسُنُ العَمَلُ",84,"ل",1,0]]}