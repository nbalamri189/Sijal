{"poems":[[53,"ألا يا لقومي للخطوب الطوارق","https://www.aldiwan.net/poem29952.html","الطويل"],[53,"كذا يهجم القدر الغالب","https://www.aldiwan.net/poem30740.html","المتقارب"],[100,"اليوم الجنين","https://www.aldiwan.net/poem43675.html","عموديه"],[55,"أمد عيني إلى الدنيا وزهرتها","https://www.aldiwan.net/poem26063.html","البسيط"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[93,"إلى مصر أزف عن الشآم","https://www.aldiwan.net/poem11411.html","الوافر"],[83,"أمدامع منهلة أم لؤلؤ","https://www.aldiwan.net/poem54345.html","الكامل"],[88,"أزمعت عنا إلى مولاك ترحالا","https://www.aldiwan.net/poem45053.html","البسيط"],[27,"حيوا الديار وأهلها بسلام","https://www.aldiwan.net/poem6005.html","الكامل"],[72,"سأشكر نعماك التي من أقلها","https://www.aldiwan.net/poem18947.html","الطويل"],[72,"طيف تصيدته والليل محتبك","https://www.aldiwan.net/poem19439.html","البسيط"],[72,"تفهمه قلبي الشجي فهاما","https://www.aldiwan.net/poem19682.html","الطويل"],[51,"للناس عيد ولي عيدان في العيد","https://www.aldiwan.net/poem10864.html","البسيط"],[51,"أسوغ لخلاني مساغ شرابهم","https://www.aldiwan.net/poem64944.html","الطويل"],[85,"أوحت لطرفك فاستهل شؤونا","https://www.aldiwan.net/poem8112.html","الكامل"],[85,"وطن يرف هوى إلى شبانه","https://www.aldiwan.net/poem63735.html","الطويل"],[56,"امدح الكأس ومن أعملها","https://www.aldiwan.net/poem58562.html","الرمل"],[62,"تطهر بماء الحياة الذي","https://www.aldiwan.net/poem52198.html","المتقارب"],[45,"يا فضل فيما الصدود والغضب","https://www.aldiwan.net/poem11496.html","المنسرح"],[45,"أقام كل ملث الودق رجاس","https://www.aldiwan.net/poem64599.html","البسيط"],[45,"خيال ملم أم حبيب مسلم","https://www.aldiwan.net/poem65652.html","الطويل"],[97,"لعينيك احتملنا ما احتملنا","https://www.aldiwan.net/poem24770.html","الوافر"],[80,"خلعت على بنيات الكروم","https://www.aldiwan.net/poem31295.html","الوافر"],[44,"ما في وقوفك ساعة من باس","https://www.aldiwan.net/poem30485.html","الكامل"],[67,"أمدائح لي فيك أم تسبيح","https://www.aldiwan.net/poem18045.html","الكامل"],[75,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[75,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[46,"أم دفر جزيت شرا فديا","https://www.aldiwan.net/poem22852.html","الخفيف"],[46,"لم يكن لي عرش فيثلم عرشي","https://www.aldiwan.net/poem22870.html","الخفيف"],[46,"ليس يبقى الضرب الطويل على الدهر","https://www.aldiwan.net/poem23619.html","الخفيف"],[19,"طلس العشاء إذا ما جن ليلهم","https://www.aldiwan.net/poem352.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85557","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54755","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[103,"ملكنا هذه الدنيا قرونا","https://www.poetsgate.com/ViewPoem.aspx?id=1234",""],[85,"حبَّذا الساحة ُ والظلُ الظليلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9651&r=&rc=141",""]],"verses":[["أَمَدّوهُ مِن طيبٍ لِغَيرِ كَرامَةٍ","وَضَمّوهُ في ثَوبٍ جَديدِ البَنائِقِ",0,"ق",1,0],["أَمَدَّت عَلَيكَ القُلوبُ العُيونَ","فَلَيسَ يُرى مَدمَعٌ ناضِبُ",1,"ب",1,0],["أمدّ له سلمّا","إلى النور من أضلعي",2,"ع",2,0],["أَمُدُّ عَيني إِلى الدُنيا وَزَهرَتِها","فَما تَرى العَينُ شَيئاً غَيرَها حَسَنا",3,"ن",2,1],["أمدك فيها الله بالملإ العلى","فجيشك مهما حقق الأمر جيشان",4,"ن",1,0],["أَمِدِّيني بِأَرْوَاحٍ زَوَاكٍ","لأُقْرِئَهَا الزَّكِيَّ مِنَ السَّلامِ",5,"م",1,0],["أَمدامعٌ منهلَّةٌ أم لؤلؤُ","لما استهلَّ العارض المتلألِئُ",6,"ل",2,1],["أمددتها بمداد ليس يعقبه","دمع الأنام وإن يبكوك أحوال",7,"ل",1,0],["أَمَدَحتُمُ الجَمَلَ الكَريمَ بَناتُهُ","لَكِن بَناتُ أَبيكَ غَيرُ كِرامِ",8,"م",1,0],["أمدُّ لها كفِّي فيهتزّ فرحةً","كما انْتفض العصفور بلَّله المطر",9,"ر",1,0],["أمداحه من عطاه أو فضائله","كأنَّ أمداحه من تبره سبكوا",10,"ك",3,0],["أمدُّ يدي في كلِّ يومٍ لذيلِها","فآخذ من جورِ الشتاء ذماما",11,"م",2,0],["أمْدَدْتَ شِعْري بأَمْدَادٍ مظاهَرَةٍ","من المناقب لا تُحْصَى بِتعديدِ",12,"د",1,0],["أمُدُّ إلى الطُولى يداً ذاتَ بسطةٍ","وعين كريم لا يُقال لها غُضِّي",13,"ي",1,0],["أَمُداوِيَ الأَرواحِ قَبلَ جُسومِها","قُم داوِ فيكَ فُؤادِيَ المَحزونا",14,"ن",2,0],["اُمدُد حُداءَكَ في النَجائِبِ تَنصَرِف","يَهوى أَعِنَّتِها إِلى تَحنانِهِ",15,"ن",2,0],["اِمْدَحِ الكَأْسَ ومَنْ أَعْمَلَها","واهْجُ قَوْماً قَتَلُونا بالعَطَشْ",16,"ش",1,1],["أمدّت بواطن أركاننا","بامثالها فغدت تظهرُ",17,"ر",1,0],["أَم دَبَّ لي كاشِحٌ فَأَضرَمَ لي","عِندَكَ ناراً بِالإِفكِ تَلتَهِبُ",18,"ب",1,0],["أَمُدُّ كَفّي لِأَخذِ الكَأسِ مِن رَشَأِ","وَحاجَتي كُلُّها في حامِلِ الكاسِ",19,"س",1,0],["أَمَدُّ الرِجالِ لُبثَةً حينَ يَرتَأي","وَأَسرَعُهُم إِمضاءَةً حينَ يَعزِمُ",20,"م",1,0],["أمدّ يديَّ في لهف إليه","أشاكيه بمحتبس الدموعِ",21,"ع",1,0],["أمُدامٌ عن حَبابٍ تبتسمْ","أمْ عقيقٌ فوقه دُرٌّ نُظِمْ",22,"م",1,0],["أَمدَدتَهُ في العُدمِ وَالعُدمُ الجَوى","بِالجودِ وَالجودُ الطَبيبُ الآسي",23,"س",2,0],["أمَدائِحٌ لِي فِيكَ أمْ تَسْبِيحُ","لوْلاكَ ما غَفَرَ الذنوبَ مَدِيحُ",24,"ح",1,1],["أمَدُ المَطالبِ والوفودِ إذا حَدَتْ","فَوْتَ العيونِ رِكابُها رُكبانها",25,"ن",3,0],["أمْدِده أو فاصْفَحْ له عَنْ نَيْلِهِ","فلقد تَخَوّفَ أن يُقالَ ضَنين",26,"ن",1,0],["أمُديرَها من حيثُ دارَ لَشَدّ مَا","زاحمتَ حولَ ركابهِ جِبريلا",27,"ل",2,0],["أُمَّ دَفرٍ جُزيتِ شَرّاً فَدَيّا","نُكِ يَغدو كَالضَيغَمِ الهَمّاسِ",28,"س",1,1],["أُمَّ دَفرٍ إِنّي هَويتُكِ جِدّاً","أَيُّ ضَبٍّ تَرَكتِ مِن غَيرِ حَرشِ",29,"ش",1,0],["أُمُّ دَفرٍ تَقولُ بَعدَكَ لِلذا","ئِقِ لا تَعمَ لي فَأَينَ فَحايَه",30,"ا",3,0],["أَم دَلَّكُم بَعضُ مَن يَرتادَ مَشتَمَتي","بِأَيِّ أَكلَةِ لَحمٍ تُؤكَلُ الكَتِفُ",31,"ف",1,0],["أَمدينةَ الإسلام يا دار السلا","م لمن أقام وكعبة القصاد",32,"د",1,0],["أَمَدٌ عِشْتَهُ مَدِيدٌ وَلَكِنْ","قَصَّرَتْهُ السُّعودُ فِي الآمَادِ",33,"د",1,0],["أُمُّ دُرزٍ إِلَيَّ فيهِ أَساءَت","وَمَتى قَطّ أَحسَنتُ أُمُّ دُرزِ",34,"ز",1,0],["أمد يدي فأنتزع الرواسي","وأبني المجد مؤتلقاً مكينا",35,"ن",2,0],["إم داراً حُطتمُوها بالنَّدى","أخذتْ عهدَ النَّدى ألاَّ تميل",36,"ل",1,0]]}