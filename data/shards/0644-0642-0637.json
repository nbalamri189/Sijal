{"poems":[[53,"يا دار ما طربت إليك النوق","https://www.aldiwan.net/poem29956.html","الكامل"],[62,"بعض التماسك أيها القلب","https://www.aldiwan.net/poem52504.html","أحذ الكامل"],[80,"الدمع ينطق واللسان صموت","https://www.aldiwan.net/poem31531.html","الكامل"],[105,"ودع ذويك وسر في شأنك الجلل","https://www.aldiwan.net/poem44046.html","البسيط"],[50,"الله أكبر والصغير صغير","https://www.aldiwan.net/poem63801.html","الكامل"],[46,"عجبا للقطا من الكدر والجو","https://www.aldiwan.net/poem23274.html","الخفيف"],[106,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179775",""],[118,"كل يوم لي شكاة","https://www.aldiwan.net/poem49324.html","مجزوء الرمل"],[280,"لست أسلو الشادن الأحوى الأغنا","https://www.aldiwan.net/poem32385.html","الرمل"],[303,"إليك ومنك الحمد ربي مدى الدهر","https://www.aldiwan.net/poem56532.html","الطويل"],[369,"أيها المقتدى بأفعاله الغرر","https://www.aldiwan.net/poem57054.html","الخفيف"],[369,"وأقول إني لو ظفرت","https://www.aldiwan.net/poem57331.html","مجزوء الكامل"],[429,"أما الكواكب فاحتموا بمواكب","https://www.aldiwan.net/poem12405.html","الكامل"],[438,"عظمت فلا شيء سواك عظيم","https://www.aldiwan.net/poem14293.html","الطويل"]],"verses":[["لَقَطَت نُفوسَهُمُ شِفاهُ صَوارِمٍ","فَرَغَت وَأَسيافُ العَوامِلِ روقُ",0,"ق",1,0],["لقطوبهِ من بشرِهِ شِيَعٌ","ولحِلْمه من بطشهِ حِزْبُ",1,"ب",1,0],["لقطتْ قوائمه الأوابدَ شُرّداً","قد كانَ منهُ لِجَمعها تَشتيتُ",2,"ت",1,0],["لَقَطْرَةٌ من دَمِي في اللهِ أبذلُها","أبقى وأنفعُ لي مِن هذهِ الطِّوَلِ",3,"ل",1,0],["لَقَطَ الحَواسِدُ عَيبَها فَنَشَرنَهُ","وَالغِلُّ أَبصَرُ وَالحواسِدُ عورُ",4,"ر",1,0],["لَقَطَت حَبَّةً وَجاءَت بِها الأَف","راخَ ثُمَّ اِستَقَت لَها في الحَواصِل",5,"ل",1,0],["لقط الربيعُ الطَّيفَ ثم طلى به","أزهارهُ فأَخذنَ بالأبصار",6,"ر",1,0],["لقطفناه لو أن الحس","ن داني الثمرات",7,"ت",1,0],["لَقَطَت دُرَّ الأَغاني طَرَفا","قَدَمَيهِ وَبِها الأَلبابُ تَغنى",8,"ن",2,0],["لِقطبٍ أَبي إسحاق في بصرةٍ بَدت","مِنَ السيّد المرواني ألوية الفخرِ",9,"ر",1,0],["لَقطاتٌ كالغانِياتِ ولكِن","يتبدَّلنَ في ثِيابٍ وحُسنِ",10,"ن",1,0],["لقَطعتُ أَفراسَ الغِنى","سَبقاً عَلى حُمُر القَناعَه",11,"ع",2,0],["لَقَطَتْ أَنَامِلُك السَّحابَ فخِلْتُها","بَرْقاً وكَفَّكَ هاطِلاتِ سَحَائِبِ",12,"ب",1,0],["لقطعت أنفاسي بأرداف أنةٍ","لها بين أثناء الضلوع حطيم",13,"م",1,0]]}