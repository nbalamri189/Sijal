tabudhabi.ae/diwan/poem/67663","المتقارب"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81712","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73145","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58099","السريع"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35097","الطويل"],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124649","الطويل"],[4738,"طَوايا نِظامي في الزَّمانِ لها نَشرُ","https://www.poetsgate.com/ViewPoem.aspx?id=205737",""],[4578,"راع القلوب مصابٌ جاء بالعجب","https://www.poetsgate.com/ViewPoem.aspx?id=49352",""],[4935,"حسن المطالع في صفاء براعة","https://www.poetsgate.com/ViewPoem.aspx?id=129288",""],[4935,"إلهي فرج الكربا","https://www.poetsgate.com/ViewPoem.aspx?id=129287",""],[4954,"أتَتْني فتَاةُ","https://www.poetsgate.com/ViewPoem.aspx?id=207725",""],[4962,"سطور في حواء","https://www.poetsgate.com/ViewPoem.aspx?id=201627",""],[4962,"لعينيك يا بلقيس","https://www.poetsgate.com/ViewPoem.aspx?id=201629",""],[4980,"خَلَعتُ ثِيَابَ الصَّبرِ","https://www.poetsgate.com/ViewPoem.aspx?id=190630",""],[4119,"غدرتم بنا غدر الشباب الذي مضى","https://www.poetsgate.com/ViewPoem.aspx?id=16117",""],[5193,"من وحي العزّة","https://www.poetsgate.com/ViewPoem.aspx?id=213569",""],[5338,"يا مدخلي بالهجر ذات وقود","https://www.poetsgate.com/ViewPoem.aspx?id=187990",""],[592,"إذا رمت أن تنجو من النار سالماً","https://www.poetsgate.com/ViewPoem.aspx?id=128832",""],[5411,"إنْ تكُ مُنْصِفا","https://www.poetsgate.com/ViewPoem.aspx?id=193118",""],[5413,"سيبقى المعلى","https://www.poetsgate.com/ViewPoem.aspx?id=200569",""],[5413,"مررنَ كأحلام الكرى!","https://www.poetsgate.com/ViewPoem.aspx?id=200636",""],[5483,"تصدق بوصل إن دمعي سائل","https://www.poetsgate.com/ViewPoem.aspx?id=186113",""],[5568,"هي الحوادث لا ترمي سوى العلم","https://www.poetsgate.com/ViewPoem.aspx?id=169348",""],[5636,"وَمضَةُ أَمَلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=207172",""],[5664,"سلامات","https://www.poetsgate.com/ViewPoem.aspx?id=176698",""],[5689,"محيط الليالي كلنا بك نسبح","https://www.poetsgate.com/ViewPoem.aspx?id=143407",""],[469,"محيّكِ أحيا الوجدَ بل اتلفَ الصبّا","https://www.poetsgate.com/ViewPoem.aspx?id=76783",""],[5956,"أُلامُ لأني أحبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=182085",""],[5956,"أمامَ جمالك","https://www.poetsgate.com/ViewPoem.aspx?id=182649",""],[5956,"لأجل شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=182675",""],[5956,"ذكرياتُ مشاهدَ من حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=184838",""],[5956,"الجمال الحنون","https://www.poetsgate.com/ViewPoem.aspx?id=184945",""],[5956,"مضى عبدُ هادي لخلدِ النعيم","https://www.poetsgate.com/ViewPoem.aspx?id=192987",""],[5956,"صديقي المفدى مُزيلَ الصعابِ","https://www.poetsgate.com/ViewPoem.aspx?id=193771",""],[5956,"لقاءُ القلوبِ الطيبة","https://www.poetsgate.com/ViewPoem.aspx?id=207912",""],[6031,"لقَلَّدْتَنِيها مِنَّةً لَيسَ تُجْحَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=46341",""],[161,"أخيرا أثلجت","https://www.poetsgate.com/ViewPoem.aspx?id=176767",""],[6056,"العيون الإنتهازية","https://www.poetsgate.com/ViewPoem.aspx?id=130347",""],[6189,"قراءة في جسد اللؤلؤة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83584&r=&rc=51",""],[463,"سل الركبَ إن أعطاك حاجتك الركبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59987&r=&rc=43",""],[6352,"كذا يظهر المعجز الباهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22746&r=&rc=7",""]],"verses":[["مُحياً تهادته الملوك وأبرقت","حرائره كُتباً الى من تختما",0,"م",2,0],["مُحَيَّا كَمِثْلِ الشَّمْسِ فِي رَوْنَقِ الضُّحَى","وَكَفُّ كَمَا حُدِّثْتَ عَنْ وَاكِفِ السُّحْبِ",1,"ب",1,0],["مُحَيّاكَ بَدرٌ وَالبُدورُ أَهِلَّةٌ","وَيُمناكَ بَحرٌ وَالبُحورُ ثِعابُ",2,"ب",1,0],["محيّاك أجلى في العيون من الضحى","وذكرك أحلى في الشفاه من الشهدِ",3,"د",1,0],["محّييك في بغداد إذ جئت قادماً","يحييك في بيروت إذ جئت آيبا",4,"ب",2,0],["مَحى طَلَلاً بَينَ المُنيفَةِ فَالنَقا","صَباً راحَةٌ أَو ذو حَبِيَّينِ رائِحُ",5,"ح",1,0],["محى ظلم الهوى رشدي كما قد","محى قاضي الورَى ظلم الظلامه",6,"م",2,0],["محيط الندَى بالعالمين كأنَّما","لهُ الأرض دارٌ والبرية ضيفان",7,"ن",1,0],["مُحَيَّرَةَ العَينَين في غَيرِ سَكرَةٍ","مَتى شَرَبت أَلحاظُ عَينَيك اِسفَنطا",8,"ط",2,0],["مُحيِ اللَيالي صَلاةً لا يُقَطِّعُها","إِلّا بِدَمعٍ مِنَ الإِشفاقِ مُنسَجِمِ",9,"م",1,0],["مُحيطاً بِالجِبالِ لَهُ ظِلالٌ","مَعَ الجَرباءِ قَد بَلَغَ الطِبابا",10,"ب",2,0],["محياك داري ومنك نهاري","إذا ضمك الصدر والساعد",11,"د",1,0],["محيي الثغور ندىً مجني الكفور ردىً","مولي الشكورِ هدىً كفَّاهُ كالسُّحُبِ",12,"ب",1,0],["مَحْيَا النُّفوسِ وَقَى الإلهُ حَيَاتَهُ","وسلامُها المأمولُ راح سليما",13,"م",2,0],["مَحيصةُ بلّغْ ما أُمِرتَ فإنّما","هو الدينُ دينُ المسلمِينَ أو القتلُ",14,"ل",1,1],["مُحَيّا قَد لاحَ لِلزَهرِ","عَن لَحظٍ مَبهوت",15,"ت",1,0],["مُحَيَّاهُ طَلْقٌ باسِمٌ رَوْضُ كَفِّهِ","أرِيضٌ وَماءُ البِشْرِ منه نمِيرُ",16,"ر",1,0],["محيل القسوة الكبرى حناناً","ورافعها إلى فن جميل",17,"ل",1,0],["مُحَيَّرَةَ الطيفِ في مائجٍ","من النُّور يَغْمرها حَيْثُ جالْ",18,"ل",1,0],["مُحيَّا وعينانِ ما في الرجالِ","سوى كلِّ أصيدَ سبْطِ القوام",19,"م",1,0],["مُحِيطاً بِأَطْوَارِ السِّياسِةِ سَاعِياً","بِرِفْقٍ إِلى إِدْرَاكِ مَا هُوَ نَاشِد",20,"د",1,0],["مُحَيّا كَالصَّبَاحِ لَهُ نَقَاءٌ","يُكَادُ يَشِفُّ عَنْ أَقْصَى الضَّمِيرِ",21,"ر",1,0],["مُحْيي القَضَاءِ رَمَاه في رَيَعَانِهِ","سَهْمُ القضاءِ فما له من فادي",22,"د",2,0],["مُحَيًّا كساهُ الشُّحوبُ جمالاً","وبعضُ الشُّحوب جمالٌ يَزين",23,"ن",1,0],["محيط العلم مفصال القضايا","عميد الفضل ذي الشرف الرصين",24,"ن",1,0],["محيًّا كمثل الشمسِ في رَوْق الضُّحى","وكفٍّ كما حُدِّثت عن واكف السُّحب",25,"ب",1,0],["مُحيطٌ خَوَتْ فيه النفوسُ وأفسِدتْ","طباعُ أهاليه بعدوْى التجاور",26,"ر",1,0],["محيت أشهر الرّبيع فلا أيّار","من دهرنا ولا نيسان",27,"ن",1,0],["محيط بالمعارف لا يجاري","وكيف يشابه البحر الخليج",28,"ج",1,0],["محيت قدرتي ولا أستطيع الصب","ر عنها فالصب شيمة خالي",29,"ل",2,0],["محيي الشريعة بعد عدمها وهقا","وهو الوثيق لها كأنه الوهق",30,"ق",1,0],["محيَّاك كالأقمارِ بَل هو أوضحُ","وحلمُكَ كالأجْبال بَل هو أرجحُ",31,"ح",1,0],["محيطيط الدريجة من فسيق","مغيلل اليدية من بخيل",32,"ل",1,0],["مُحيِى عُلُومٍ تَعَفَّت آىُ أرسُمِهَا","مُدَوِّنِيهَا بِتَحرِيرِ وتَدوِينِ",33,"ن",1,0],["مُحَيبِيباً سُويقَتِهِ الرُّوَيَّا","اُنَيبِيبٌ مُسَيقِىُّ الغُيَيلِ",34,"ل",1,0],["مُحَيذِيفُ الرُّتَيبَةِ في النُّوَيدِى","مُحَيمِيلُ النُّفيقَةِ كالطَُّفَيلِ",34,"ل",1,0],["مُحيِى العدالةَ بعد الموت مُبرِزَها","في زَىِّ عَذرَاء في دَلٍّ وفي حَوَرِ",35,"ر",1,0],["محى اسم كسرى بإسماعيل معدله","صرفاً به لا بكسرى يضربُ المثلا",36,"ل",2,0],["مُحَيّاهُ صُبحٌ لِلهُدى وَبَنانُهُ","بِحارٌ غِزارٌ للِنّدى لا ضَخاضخُ",37,"خ",1,0],["مُحيي البِلادِ وَقَد أَشفَت عَلى جُرُفٍ","هارٍ وَمانِعُها بِالبيضِ وَالأَسَلِ",38,"ل",1,0],["محيا روض فيه لحظك نرجس","وخدك روض فيه صدغك ريحان",39,"ن",1,0],["محياك لما كان يا بدر روضة","تسلسل فيه دمع عيني كالنهر",40,"ر",1,0],["محيى المدارس بعد محوِ دروسِها","وَالعلمَ أَلبَسَ حلَّةَ التَجديد",41,"د",1,0],["مُحيي النَدى وَقاتِلِ الإِفلاسِ","مُخجِلِ صَوبِ العارِضِ الرَجّاسِ",42,"س",1,0],["مُحَيِي النوالِ مُميتُ السُؤالِ","رَبُّ المَنائِح",43,"ح",1,0],["محيَّاهُ مثلُ البَدر ليلةَ تمِّهِ","فقد زانَ فيه الأفقَ بدر تمامِ",44,"م",1,0],["محيّاه بدر الأنس قد لاح طالعاً","عليه بأنوار السيادة والسعد",45,"د",1,0],["محيّاكِ يَحوي كلَّ لونٍ ونفحةٍ","من الزهرِ حيثُ القطفُ كان حَراما",46,"م",2,0],["محيّاكِ حيّاني على كلِّ زَهرةٍ","وفي كل ريحٍ من أريجِ صَباك",47,"ك",1,0],["محيّاً عليهِ من ليالي جبالنا","سكونٌ ونورٌ اشتهي أن يعودا لي",48,"ل",2,0],["مُحَيَّاكَ المُبَشِّرُ بالأمَاني","ومَحْيَاكَ المُبَصِّرُ للأَنَامِ",49,"م",1,0],["مُحيٍ بِجَدواهُ الكَرَم","مازالَ قَتّالَ العَدَم",50,"م",1,0],["محيرة رجراجة الكفل غضة","نحيلة خضر ذات خال على الخد",51,"د",1,0],["محياه كالشمس عند الضحى","ويا حسنه في المعالي أصيلُ",52,"ل",1,0],["محياه له حسنٌ بديعٌ","غدا روض الخدود به مزهر",53,"ر",1,1],["محي الدين كنز اليقين بح","ر العلم طود الحلم والأفضال",54,"ل",1,0],["مُحيّا المعالي مُسفرُ ذو تهلّل","طليقُ جبينٍ بالسرورِ مكلّلِ",55,"ل",1,1],["مُحيّا الهَنا طلقٌ وَثَغر المُنى اِفترّا","فيا لكَ من بشرٍ يروقُ وَمن بُشرى",56,"ر",2,1],["مُحيطٌ بِأسرارِ الوزارة