m9811.html","مجزوء الوافر"],[501,"منهاجنا أوله محبة","https://www.aldiwan.net/poem37753.html","الرجز"],[501,"روق كؤوسك هذا الوقت قد راق","https://www.aldiwan.net/poem37939.html","البسيط"],[501,"من خلف مسدل ستر الغيب لاح لنا","https://www.aldiwan.net/poem38084.html","البسيط"],[507,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[514,"فداك اخوك اليوم يوم سرور","https://www.aldiwan.net/poem67678.html","عموديه"],[516,"أوجبت في ذمة الأشعار والخطب","https://www.aldiwan.net/poem12014.html","البسيط"],[516,"أفخر فحسبك ما أوتيت من حسب","https://www.aldiwan.net/poem12019.html","البسيط"],[516,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[516,"إن كان عطفك للإعجاب يختال","https://www.aldiwan.net/poem12212.html","البسيط"],[516,"لئن قل صبر فالمصاب عظيم","https://www.aldiwan.net/poem12255.html","الطويل"],[516,"بقاؤك يا فارس المسلمينا","https://www.aldiwan.net/poem12283.html","المتقارب"],[537,"الحمد لله على الإسلام","https://www.aldiwan.net/poem23860.html","الرجز"],[539,"ألا فاسمعا لي ما أعيد وما أبدي","https://www.aldiwan.net/poem48223.html","عموديه"],[541,"عهدي بهم وسراب البيد منصدع","https://www.aldiwan.net/poem56905.html","البسيط"],[552,"من ذا عذيري من قوم أذاقهم","https://www.aldiwan.net/poem47241.html","البسيط"],[552,"ومن سفه لما مررت على الحمى","https://www.aldiwan.net/poem47243.html","الطويل"],[552,"لغير الغواني ما تجن الأضالع","https://www.aldiwan.net/poem47726.html","الطويل"],[552,"أنجد إذا شئت في الأرزاق أو أغر","https://www.aldiwan.net/poem47787.html","البسيط"],[552,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[552,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[552,"أدلت بحسن خولت ولو انها","https://www.aldiwan.net/poem48035.html","الطويل"],[559,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[559,"أدر صرفا خمور الأندرينا","https://www.aldiwan.net/poem33755.html","الوافر"],[559,"الكل حق والكل باطل","https://www.aldiwan.net/poem34254.html","مخلع البسيط"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[559,"يا شمعة هي في كل الفوانيس","https://www.aldiwan.net/poem34446.html","البسيط"],[559,"لحرب نفوسنا قد جاء فارس","https://www.aldiwan.net/poem34448.html","الوافر"],[560,"أيا سعد قل للقس من داخل الدير","https://www.aldiwan.net/poem69361.html","الطويل"],[563,"دعاني من هوى هند وأسما","https://www.aldiwan.net/poem52779.html","الوافر"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"],[576,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[576,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"]],"verses":[["وقد رفعتْ رأس الحسين ملائكٌ","وأوداجه كالمُزن مما تصرما",0,"م",2,0],["وَقَد رَجَّلَ البيضُ مِن لِمَّتي","بِطِفلِ الأَنامِلِ بَضِّ البَنانِ",1,"ن",1,0],["وَقَد رَمَتِ الأَيّامُ مِن حَيثُ لا أَرى","صَميمِيَ بِالداءِ العَنيفِ عَلى عَمدِ",2,"د",1,0],["وَقَد رَكِبوهُ مَرَّةً بَعدَ مَرَّةٍ","فَيا لِذَلولِ البَغيِ مِن مَركَبٍ مُردي",2,"د",2,0],["وَقَد رَفَعَ الشُّعثُ المُلَبُّونَ أيدِياً","بحاجاتِهِم وَاللَّهُ مُعطٍ وَغافِرُ",3,"ر",1,0],["وَقَد رَدَّ غَربيَ عَما أَرومُ","زَمانٌ تَضايَقَ فيهِ مَجالي",4,"ل",2,0],["وَقَد رَمَتِ الذِّكرى جُفونيَ وَالحَشا","بِمُجتَلَبَيْ شَوقٍ قَديمٍ وَحادِثِ",5,"ث",1,0],["وَقَد رَمَتني غَداةَ الخَيفِ غانيَةٌ","بِناظِرٍ إِن رَمى لَم تُخطىءِ الغَرَضا",6,"ض",2,0],["وقد رَنا نَرْجِسُهُ بمُقْلَةٍ","يَحارُ فيها الدّمْعُ منْ صَوْبِ الحَيا",7,"ا",1,0],["وقد رَماني نَكَدُ الدّهْرِ بهِمْ","وما دَرى أيَّ معاوِيٍّ رَمى",7,"ا",1,0],["وقد رَمى بِكَ ركْنُ الدينِ مُعضلةً","يَهابُ كلُّ كَميٍّ دونَها قُحَما",8,"م",2,0],["وقدْ رَنَتِ النّجومُ إليّ خُوصاً","بأعْيُنِ كاسِراتِ الطَّرْفِ رُمْدِ",9,"د",1,0],["وقد رَضِيتُ منَ المَعْروفِ تَبذُلُهُ","أنْ يُنْجِزَ الطَّيْفُ في مَسْراهُ مِيعادا",10,"د",2,0],["وقُدْرَةُ الوقْتِ إنْ فكّرتُ تقْصُرُ عنْ","نفْسي وتقصُرُ نفْسي عنْ أمانِيها",11,"ي",3,0],["وَقَدْ رَأَيْتُ مَسِيرِي عَزَّ مَطلبُهُ","وَالطَّرفُ وَالظَّرفُ يُبْكِينِي ويَكْوِينِي",12,"ن",2,0],["وَقَدْ رَفَّ جِيدُ الْغُصْنِ فِي حَلْي زَهْرِهِ","وَنَافَحَ رَاحَ الطَّلِّ فَارتَاحَ نَشْوَانَا",13,"ن",2,0],["وقدْرُكَ قدْرُ النيلِ عنْدي وإنّني","لدى قدْرِكَ العالي أدَقُّ منَ الذرِّ",14,"ر",1,0],["وَقَد رَحَلتُ المَطِيَّ مُنتَخِلا","أُزجي ثِقالاً وَقُلقُلاً وَقِلا",15,"ل",2,0],["وَقَد رَمَيا بِالطَرفِ بَينَ جُموعِكُم","وَلَم يَشهَدا في المَشهَدَينِ مَكاني",16,"ن",2,0],["وَقَدَرتُم دَقيقَةَ العُمرِ حِرصاً","وَسِواكُم لا يَقدُرُ الأَجيالا",17,"ل",2,0],["وَقَد رَأَتكَ الأَماني","رِضىً فَلَم تَتَعَدَّك",18,"ك",1,0],["وَقَد رابَني قَولُها يا هَناهُ","وَيحَكَ أَلحَقتَ شَرّاً بِشَر",19,"ر",1,0],["وَقَد رَكَدَت وَسطَ السَماءِ نُجومُه","رُكودَ نَوادي الرَبرَبِ المُتَوَرِّقِ",20,"ق",1,0],["وَقَدْ رَأَى مِنْ بَلائِي فِي وَلائِمِهَا","بَلاءَ حُرٍّ جَمِيلِ الظَّنِّ بِالكَرَمِ",21,"م",1,0],["وَقَد رَأى البُردَ وَمَن","يَلبَسُهُ بَعدَ النَبي",22,"ب",2,0],["وَقَد رَفَعوا رَأسَ الحُسَينِ عَلى القَنا","وَساقوا نِساهُ حُسَّراً وَلِهاتِ",23,"ت",1,0],["وَقَد رَفَعَ الإِلَهُ بِكُلِّ أَرضٍ","لِضوئِكَ يا بِلالُ سَناً طِوالا",24,"ل",2,0],["وقد ركزت به الرايات خافقة","ما بين طاقين مرفوعين في نسق",25,"ق",1,0],["وقد رأيت أناساً واصلين بها","وهم بباريز مِلْبارود أنبوبا",26,"ب",2,0],["وَقَد رَغِبَت عَن شاعِرَيها مُجاشِعٌ","وَماشِئتَ فاشوا مِن رُواةٍ لِتَغلِبِ",27,"ب",1,0],["وَقَد رُعنا فَوارِسَ آلِ بِشرٍ","بِذاتِ الشيحِ مِن طُرُقِ الإِيادِ",28,"د",1,0],["وَقَد رَفَعَ الظَعائِنُ يَومَ رَهبى","بِروحٍ مِن فُؤادِكِ مُستَطارِ",29,"ر",1,0],["وقد رأينا بها حوراً منعمة","بيضاً تكامل فيها الدلّ والشنبُ",30,"ب",1,0],["وَقَدَّرتُ أَنَّ الصَبرَ بَعدَ فِراقِهِم","يُساعِدُني وَقتاً فَعُزّيتُ عَن صَبري",31,"ي",1,0],["وَقَد رُحنَ مِن مُهَجاتِ القُلوبِ","بِأَوفَرِ غُنمٍ وَأَغلى نَشَب",32,"ب",1,0],["وَقَد رَضيتُ بِأَهلِ الشَأمِ زافِرَةً","وَبِالأَميرِ وَبِالإِخوانِ إِخوانا",33,"ن",2,0],["وقدّ روت عن لينه واعتداله","صحاح العوالي مسنداً بعد مسند",34,"د",1,0],["وقد رقمت وشيَ الرّبى أبرُ الحيا","وجرَّت على وادِي دمشق برُوده",35,"د",2,0],["وقدراً إذا أضحى به الذكر طائراً","غدا واقعاً عنه من الليل نسره",36,"ر",2,0],["وقد رويت الثناء متَّصلاً","في الجودِ عن مالك ابن دينار",37,"ر",1,0],["وقد رفعت عينايَ قصة دمعها","فوقّع فيها الوجد يجري على الرسم",38,"م",1,0],["وقد رماه بشُؤبوبٍ فأحْصَنَهُ","جَدٌّ وأَنجاه شؤبوبٌ من الهربِ",39,"ب",1,0],["وقد رأى شيبةً فأنكرها","وتلك من فعله لو اعتبره",40,"ر",2,0],["وقد رأى الناسُ جِدّي","في الحادثات ونَهْضِي",41,"ض",2,0],["وقدر الله فيها أن يذللها","فهان مطلبها للجاهل الحمق",42,"ق",1,0],["وَقَد رَقَمَت أَغضانَها في أَديمَةٍ","كِتاباً مِنَ الأَوراقِ سَطراً عَلى سَطرِ",43,"ر",1,0],["وَقَد رابَني يا أَهلَ وُدِّيَ أَنَّكُم","مَطَلتُم وَأَنتُم قادِرونَ دُيوني",44,"ن",2,0],["وَقَد رابَني أَنَّ الغَيورَ يَوَدُّني","وَأَنَّ نَدامايَ الكُهولُ الجَحاجِحُ",45,"ح",1,0],["وَقِدرٍ كَرَألِ الصَحصَحانِ وَئيَّةٍ","أَنَختُ لَها بَعدَ الهُدُوِّ الأَثافِيا",46,"ي",2,0],["وَقَد رُمناكِ مِن بَلَدٍ بَعيدٍ","فَأَدناكِ الإِلَهُ بِلا تَوانِ",47,"ن",1,0],["وَقَد رَأَيتِ صَنيعي","وَقَد سَمِعتِ ثَنائي",48,"ي",1,0],["وَقَدَّرتُ لِلنُعمانِ يَوماً وَضِدَّهُ","فَما اِغتَرَّتِ البوسى وَلا غَرَّتِ النُعمى",49,"م",2,0],["وَقَد رَأَيتُ المُلوكَ قاطِبَةً","وَسِرتُ حَتّى رَأَيتُ مَولاها",50,"ا",3,0],["وقدَّرتَ من فرطِ الجهالة أنّني","أُقيمُ على كذبٍ رصيفٍ مُضَيَّعِ",51,"ع",1,0],["وقد رابني منكَ الصدود وليتَهُ","صدودُ اشتغالٍ لا صدودُ كلالِ",52,"ل",1,0],["وَقَد رَفَعتُ وَما طَأطَأتُها وَهَلاً","عَصا الهِجاءِ لِأَهلِ الحينِ وَالحوبِ",53,"ب",1,0],["وَقَد رَدَّتِ الخَمسونَ رَدَّ صَريمَةٍ","إِلى الشَيبِ مَن وَلّى عَنِ الشَيبِ يَهرُبُ",54,"ب",1,0],["وَقَد رَأَت وَجهَ مَن تُراسِلُهُ","فَاِنحَرَفَت عَنكَ شَرَّ مُنحَرَفِ",55,"ف",1,0],["وَقَد رَحَلَت وَما اِفتَكَّت أَسيراً","يُفالِتُ لُبَّهُ عَنَتُ الوَثاقِ",56,"ق",1,0],["وَقَد رَجَعَت وُفودُ الأَرضِ تُثني","بِذاكَ الطَولِ وَالمِنَنِ الجِسامِ",57,"م",1,0],["وَقَد رُفِعَت عَن نَجرِهِم آيَةُ النَدى","كَما رُفِعَت مَنسِيَّةً آيَةُ الرَجمِ",58,"م",1,0],["وَقَد راعَني مِنها الصُدودُ وَإِنَّما","تَصُدُّ لِشَيبٍ في عِذاري يَروعُها",59,"ع",3,0],["وَقَد رَأى مُصعَبٌ في ساطِعٍ سَبِطٍ","مِنها سَوابِقَ غاراتٍ أَطانيبِ",60,"ب",1,0],["وَقَد رُمتَ أَمراً يا مُعاوِيَ دونَهُ","خَياطِفُ عِلوَدٍّ صِعابٌ مَراتِبُه",61,"ب",2,0],["وَقَد راعَ لِلحَجّاجِ راعيهِما مَعاً","صَبوراً عَلى المَيتِ الكَريمِ مُفَجَّعا",62,"ع",2,0],["وَقِدرٍ فَثَأنا غَليَها بَعدَما غَلَت","وَأُخرى حَشَشنا بِالعَوالي تُؤَثَّفُ",63,"ف",1,0],["وقد رَدَّ غِلمانُنا شُقرَنا","وقادَ لنا الدُّهْمَ مَلاَّحُنا",64,"ن",2,0],["وقد رَقَّ جلِبابُ النَّسيمِ على النَّدى","ولكنْ جلابيبُ الغُيومِ صِفاقُ",65,"ق",1,0],["وقد رَقَّ ثَوبُ الغيمِ حتَّى كأنما","تُنَشَّرُ دُونَ الأُفْقِ منه سُجوفُ",66,"ف",1,0],["وقد رُفِعَتْ لنا سُودٌ","نجومُ سَمَائِها الحَبَبُ",67,"ب",1,0],["وَقَدرُ كُلِّ اِمرِئٍ ما كاَن يُحسِنُهُ","وَلِلرِجالِ عَلى الأَفعالِ اسماءُ",68,"ا",2,0],["وَقَدرُكَ ما بَينَ الأَنامِ مُمَنَّعاً","لَكَ العِزُّ ثَوبٌ وَالحَياءُ نِقابُ",69,"ب",1,0],["وَقَدَّرَ الخالَ عَلى خَدِّهِ","ذَلِكَ تَقديرُ العَزيزِ العَليم",70,"م",1,0],["وَقَدرُكَ المُعتَلي عَن ذاكَ يُغنينا","كَم قَد وُصِفتَ بِأَوصافٍ مُشَرِّفَةٍ",71,"ه",1,0],["وَقَد رَمى عَمرٌو بِسَه","مِ كَيدِهِ قَلبَ العُلى",72,"ا",1,0],["وقد رقَّت حواشيه إلى أن","رأيتُ الطودَ يخضرُّ اخضرارَا",73,"ر",2,0],["وَقَدْ رَضِيتُ بِهِمْ لَوْ يَسْفِكُونَ دَمِي","لكن أَعُوذُ بِهِمْ أَنْ يَسْفِكُوهُ سُدَى",74,"د",2,0],["وقَدرُكَ أعلى من مدائحِنا الَّتي","أبَرّتْ على إِحسانِ مِصْقَعِ وائِلِ",75,"ل",1,0],["وَقَد رَكِبتْ فرسانها صَهَوَاتها","فأرْجَلَهُمْ عنها التذلّلُ والذعرُ",76,"ر",1,0],["وَقَد رَفَدَتهُ الخَنصَرانِ وَشَدَّدَت","ثَلاثَ نَواحيهِ الثَلاثُ الأَنامِلُ",77,"ل",1,0],["وَقَدَّرَ الشَّمْسَ تَجْرِي فِي مَنَازِلِهَا","وَالنَّجْمَ وَالْقَمَرَ السَّارِي بِحُسْبَانِ",78,"ن",1,0],["وَقَد رابَني مِنها صُدودٌ رَأَيتُهُ","وَإِعراضُها عَن جانِبي وَبُسورُها",79,"ر",3,0],["وَقَد رَثى مِن سَهَري في الدُجى","شَقيقُكَ البَدرُ وَلَم تَرثِ لي",80,"ل",2,0],["وَقِدراً إِذا ما أَنفَضَ القَومُ أَوفَضَت","إِلى نارِها سَعياً إِلَيها الأَرامِلُ",81,"ل",1,0],["وَقَد رَكَضَت بِنا خَيلُ المَلاهي","وَقَد طِرنا بِأَجنِحَةِ السُرورِ",82,"ر",1,0],["وَقَد رَكِبوا بَغيَهُم وَاِرتَقَوا","بِزَلّاءَ تُردي بِرُكّابِها",83,"ب",3,0],["وَقَدْرُكُ أَعْلَى أَنْ تُهَنَّى بِمَنْصِبٍ","وَأنتَ منَ الدُّنيا أَجَلُّ وَأَكْبَرُ",84,"ر",1,0],["وقد ركزْتَ القَنا بينَ السحاب وقد","أنزَلْتَ قِرْنَكَ من بينِ الدراريّ",85,"ي",1,0],["وقد رُبّيَتْ فيهِ الملوكُ مراتِباً","فمن بين متبوعٍ وآخَرَ يَتبَع",86,"ع",1,0],["وَقَد راحَت تُرَوِّحُنا المَنايا","لِمَخذولٍ وَأَحرَزَهُ الفِرارُ",87,"ر",1,0],["وَقَد رابَني قَلبٌ يُكَلِّفُني الصِبا","وَما كُلَّ حينٍ يَتبَعُ القَلبَ صاحِبُه",88,"ب",2,0],["وَقُدرَةُ اللَهِ حَقٌّ لَيسَ يُعجِزُها","حَشرٌ لِخَلقٍ وَلا بَعثٌ لِأَمواتِ",89,"ت",1,0],["وَقَد رَأَينا كَثيراً بَينَنا جَسَدا","بِغَيرِ رَوحٍ فَهَل رَوحٌ بِلا جَسَدِ",90,"د",1,0],["وَقَد رَفَقَ الَّذي أَوصى أُناساً","بِعُشرٍ في الزَكاةِ وَنِصفِ عُشرِ",91,"ر",1,0],["وَقُدرَةُ اللَهِ نَجَّت راجِلاً وَرَعاً","يَومَ الهِياجِ وَأَردَت فارِساً بَطَلا",92,"ل",2,0],["وَقَد رَفَعَت غَمائِمَ لِلرَزايا","عَلى وَجهِ التُرابِ فَطَبَّقَتهُ",93,"ت",2,0],["وَقَد رَكِبَ الَّذينَ مَضَوا سَبيلاً","إِلى عَليائِهِم لَم يَركَبوهُ",94,"ب",3,0],["وَقَد رآني أدنو منه مسترقاً","ففضَّل الصمتَ فعل الخائف الحذر",95,"ر",1,0],["وَقَد رأَيتك في المو","ج فوق وجه الغدير",96,"ر",1,0],["وَقَد رَموني بإلحاد وزندقة","وَما رَموني به زور وبهتان",97,"ن",1,0],["وقدروه بميزان له وضعوا","من العروض وهل للشعر ميزان",97,"ن",1,0],["وَقَد رَأَتني قُرَيشٌ ساحِباً رَسَني","إِلَيكَ عَن طَلقِها وَجهاً وَكالِحِها",98,"ح",3,0],["وقد رقَّ مَا وَرْدُ تلك الخُدُودِ","بما سال مِن مِسْك تِلْكَ اللِّمَمْ",99,"م",1,0],["وَقَد رابَني أَنَّ الصَبا لا تُجيبُني","وَقَد كانَ يَدعوني الصَبا فَأُجيبُ",100,"ب",1,0],["وَقَدْرُ الْهَوَى فِي ذِي الْهَوَى قَدْرُ نَفْسِهِ","وَمِرْآتُهُ قلْبُ المُتَيَّمِ وَالفِكْرُ",101,"ر",1,0],["وقد رَأْيتُ العَدْلَ في بَلْدَةٍ","فَقيهُها الشَّعْبِيُّ قاضِيها",102,"ي",3,0],["وَقَد رابَهُ مِنهُ تَوَرُّمُ نَرجسٍ","غَضيضٍ وَنِسرينٍ وَوَردٍ مُضعَّفِ",103,"ف",1,0],["وَقَدّر المَوتَ وَالنُشورَ عَلى ال","خَلقِ فَما بالُ مَن يَموتُ طَغى",104,"غ",2,0],["وَقَد رَكَدَت وَسطَ السَماءِ نُجومُها","رُكودَ نَوادي الرَبرَبِ المُتَوَرِّقِ",105,"ق",1,0],["وقد رَماني هواكُمْ في الغرامِ إلى","مَقامِ حُبٍّ شريفٍ شامخٍ سامِ",106,"م",1,0],["وقَدْ رُفِعَتْ أعلامُ مِصْرَ خَوَافِقاً","يُغَازِلُهَا مَسُّ الصَّبَا وتُغَأزلُهْ",107,"ل",2,0],["وقد رف جيد الغصن في حلي زهره","ونافح راح الظل فارتاح نشوانا",108,"ن",2,0],["وقد رفعوا الإنجيل فوق رؤوسهم","وقد قدسوا الروح المقدس تقديسا",109,"س",2,0],["وقدراً إذا ما أنفضَ القومُ أوفضتْ","إلى نارها مشياً إليها الأراملُ",110,"ل",1,0],["وقد رَضِيت بكِنٍّ أستكِنُّ به","ناءٍ عن العالَمِ المنحطِّ مهجور",111,"ر",1,0],["وقد رددتُ رزايا الدهرِ أجْمَعَها","إلى سِجِلَّيْنِ محفوظٍ ومكتوب",112,"ب",1,0],["وقد راعني حول الفرات منازل","تخلين عن ألافها ، ومرابع",113,"ع",1,0],["وقد رقمت أغصانها في أديمه","كتابا من الأوراق ، سطرا على سطر",114,"ر",1,0],["وَقَدْ رَاعَ للحجّاجِ ناعِيهِما معاً","صَبُوراً عَلى المَيْتِ الكَرِيمِ مُفَجَّعا",115,"ع",2,0],["وَقَدر جاهك في الآفاق مُرتَفع","ما حَطَ يَوماً وَإِن لَم يَخل مِن حَسَد",116,"د",1,0],["وَقَد رَأى ماجد كَريم","وَالدهُ لَيلُهُ مَلاما",117,"م",2,0],["وقد رفع الغوث الرفاعي مجده","وبالصيد صياد المفاخر ناظمه",118,"م",2,0],["وقد رحت ترميني بطرحي للوفا","واخطأُ رام فوّق النبل للبدر",119,"ر",1,0],["وقد رأى من التجلي مشعبا","أهلا وسهلا يا غريب الغربا",120,"ا",1,0],["وقدرت المقادير اجتماعا","على إيثار كلٍّ الإغترابا",121,"ب",2,0],["وقد رباك في نعم ولكن","أتاك اليومَ في الكِبرِ انتقام",122,"م",1,0],["وقد رقم الحور ولدانها","نفيسة فازت بأوج النعيمْ",123,"م",1,1],["وقد رقصت أغصانه وتبسمت","أزاهره والكون منه تعطرا",124,"ر",2,0],["وقد رأيت من الشمسِ المنيرة ما","تهوى وعاد بها عيش اللقا رغدا",125,"د",2,0],["وَقَد رُمتُ أَن أَلقى الصُدودَ بِمِثلِهِ","مُقابَلَةً لَكِنَّني أَتَهَيَّبُ",126,"ب",1,0],["وقد رفعت عنها الإزار فلج به","وبرد فؤاداً من زلال نداها",127,"ا",3,0],["وَقَد رَفَعَت مِن شأَنِهِ وَأَجَلَّتِ","أَضاءَت سَناهُ فاِستَبانَت سَناءَهُ",128,"ه",1,0],["وقَد رأَيتُ مِنَ الأسرارِ أَروعَهَا","وإنَّ أروعَهَا أَسْرارُ تَكوِيني",129,"ن",2,0],["وقدرُك لا يخفى فأخفاه عنهم","وأعماهم عمى اقتضى الرشد والحلمُ",130,"م",1,0],["وقد رفعوا الايدى إلى الله بالدعا","على من هداهم كاشفين العمائما",131,"م",2,0],["وقدرةُ الله للأسباب لازمةٌ","كما تلازم روح الآدمي الشبحا",132,"ح",2,0],["وقد رأينا وخير الرأى أصوبه","أن لا يقلد فيها غير أنفسنا",133,"ن",2,0],["وقد رد من فوق الثريا إلى الثرى","فالقى كما يلقي القلام من الظفر",134,"ر",1,0],["وقدرة الله أخفاها بحكمته","عن الورى وهي في الأسباب منسبكه",135,"ك",2,0],["وقد رسا فيها وطالا على الورى","وأذعن من فيها لقولهما ذلا",136,"ل",2,0],["وقد رفع الشيطان بالكفر صوته","وكاد بأن يصفى إناء الهدى صفوا",137,"و",2,0],["وقد رأيتُ أعاجيبَ الزمانِ وما","رأيتُ وصلاً يكونُ الهَجْرُ رونَقَهُ",138,"ه",1,0],["وَقَد رُبَّما يَجزي عَلى الصَدِّ وَالقِلى","أَبٌ وَأَخٌ وَالمَرءُ مِمَّن يُساعِدُ",139,"د",1,0],["وقد راقَ لما رقَّ عذبُ زُلالِه","فأصبح ملآنَ المَواردِ زائدا",140,"د",2,0],["وقَدْرُك في سماءِ الفخر سامٍ","وعيشُك في رياضِ العِزّ غَض",141,"ض",1,0],["وقَدِّرْ فؤادَك قبرا له","وقُلْ باللسانِ صَمامِ صَمام",142,"م",1,0],["وقدّر أن يعفّ النفس خيرا","وألزمها رأى رأيا محالا",143,"ل",2,0],["وقد ركّب الله ما اشتهي","ه فيهنّ من طيّبات الوطر",144,"ر",1,0],["وقد رفعتكِ الناسُ حتى ظننتهم","لأجلكِ يدعونَ النجومَ جواريا",145,"ي",2,0],["وقد رُحنَ أسراباً وخفتُ وشاتَها","فعيني في سربٍ وقلبي في سربِ",146,"ب",1,0],["وقدرُه فوق ما تملَّكه","فليس حبّي له بمستكثَرْ",147,"ر",1,0],["وقد رموا جمرات الشوق في كبدي","لما تولوا ومنهم ما بلغت مني",148,"ن",2,0],["وقد رقّت دموع العين حتى","لتحسبها لرقتها خدودا",149,"د",2,0],["وقد راسلته جهدى","فضاعت عنده الكتب",150,"ب",1,0],["وَقَد رَوَّعتُهُم قِدماً بِخَيلٍ","جَوانِفَ في الأَعِنَّةِ كَالسَراحِ",151,"ح",1,0],["وقد راح مختفياً كل حي","وقد لزم الصمت حتى الكلاب",152,"ب",1,0],["وَقِدرُ الدينِ في الجَهّالِ تَغلي","وَلم يُسمَع لِطَبل الدينِ طَرقُ",153,"ق",1,0],["وقد رضِيتكُمُ شَرْباً بها ولها","كما رضيتُ بها قِدْماً لكم دارا",154,"ر",2,0],["وَقَْد رَاقَتْ مَبَانِيهَا","فَأَعْيَتْ وَصْفَ أَبْيَاتِي",155,"ت",2,0],["وَقَدْ رَامَ مِنْهُ الآنَ كَتْبَ إِجَازَةٍ","تَكُونُ لَهُ حِلْياً كَأَسْلاَكِ أَجْيَادِ",156,"د",1,0],["وقَدْ رَقَّتِ الشِّعْرَى ا