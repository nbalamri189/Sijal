oem24394.html","الوافر"],[80,"متى صدرت عيناك عن أرض بابل","https://www.aldiwan.net/poem31321.html","الطويل"],[80,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[44,"متى أنت عن ذهلية الحي ذاهل","https://www.aldiwan.net/poem30372.html","الطويل"],[87,"ما أطيب العيش لولا أنه فاني","https://www.aldiwan.net/poem8209.html","البسيط"],[33,"لكل لقاء نلتقيه بشاشة","https://www.aldiwan.net/poem25918.html","الطويل"],[81,"لا تطلبوا ثأري فلا حق لي","https://www.aldiwan.net/poem61502.html","السريع"],[22,"أرى العير تحدى بين قو وضارج","https://www.aldiwan.net/poem22003.html","الطويل"],[52,"شربنا بالصغير والكبير","https://www.aldiwan.net/poem26982.html","الوافر"],[52,"ألا من لعين وتسكابها","https://www.aldiwan.net/poem27305.html","المتقارب"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[75,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[50,"أأحزنك الألى ظعنوا فساروا","https://www.aldiwan.net/poem63810.html","الوافر"],[50,"وللموت خير من حياة على أذى","https://www.aldiwan.net/poem64792.html","الطويل"],[46,"مر الزمان فأضحى في الثرى جسد","https://www.aldiwan.net/poem22210.html","البسيط"],[46,"ما يحسن المرء غير الغش والحسد","https://www.aldiwan.net/poem22461.html","البسيط"],[46,"بحكمة خالقي طيي ونشري","https://www.aldiwan.net/poem22685.html","الوافر"],[46,"الرمح أبلغ من قس تخاطبه","https://www.aldiwan.net/poem23163.html","البسيط"],[46,"أخوك معذب يا أم دفر","https://www.aldiwan.net/poem23560.html","الوافر"],[46,"قد اختل الأنام بغير شك","https://www.aldiwan.net/poem23561.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85597","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85587","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85600","البسيط"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1149","البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30494","المتقارب"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10689","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54867","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43891","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43778","المنسرح"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1941","الطويل"],[68,"","https://poetry.dctabudhabi.ae/diwan/poem/25961","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54231","الطويل"],[77,"سقى علم الجنتين فالجزع فالبانا","https://www.poetsgate.com/ViewPoem.aspx?id=34162",""],[77,"طرقنا ديور القوم وهنا وتليسا","https://www.poetsgate.com/ViewPoem.aspx?id=34193",""],[22,"أرى العير تحدى بين قنٍّ وضارجٍ","https://www.poetsgate.com/ViewPoem.aspx?id=19793",""],[90,"وحي الرستمية","https://www.poetsgate.com/ViewPoem.aspx?id=179135",""],[90,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[90,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[91,"فنون الوصف","https://www.poetsgate.com/ViewPoem.aspx?id=53081",""],[28,"لئن صبر الحجاج ما من مصيبة","https://www.poetsgate.com/ViewPoem.aspx?id=2459",""]],"verses":[["وَقَد رَجَّلَ البيضُ مِن لِمَّتي","بِطِفلِ الأَنامِلِ بَضِّ البَنانِ",0,"ن",1,0],["وَقَد رَمَتِ الأَيّامُ مِن حَيثُ لا أَرى","صَميمِيَ بِالداءِ العَنيفِ عَلى عَمدِ",1,"د",1,0],["وَقَد رَكِبوهُ مَرَّةً بَعدَ مَرَّةٍ","فَيا لِذَلولِ البَغيِ مِن مَركَبٍ مُردي",1,"د",2,0],["وَقَد رَفَعَ الشُّعثُ المُلَبُّونَ أيدِياً","بحاجاتِهِم وَاللَّهُ مُعطٍ وَغافِرُ",2,"ر",1,0],["وَقَد رَدَّ غَربيَ عَما أَرومُ","زَمانٌ تَضايَقَ فيهِ مَجالي",3,"ي",1,0],["وَقَد رَمَتِ الذِّكرى جُفونيَ وَالحَشا","بِمُجتَلَبَيْ شَوقٍ قَديمٍ وَحادِثِ",4,"ث",1,0],["وَقَد رَمَتني غَداةَ الخَيفِ غانيَةٌ","بِناظِرٍ إِن رَمى لَم تُخطىءِ الغَرَضا",5,"ض",2,0],["وقد رَنا نَرْجِسُهُ بمُقْلَةٍ","يَحارُ فيها الدّمْعُ منْ صَوْبِ الحَيا",6,"ا",1,0],["وقد رَماني نَكَدُ الدّهْرِ بهِمْ","وما دَرى أيَّ معاوِيٍّ رَمى",6,"ا",1,0],["وقد رَمى بِكَ ركْنُ الدينِ مُعضلةً","يَهابُ كلُّ كَميٍّ دونَها قُحَما",7,"م",2,0],["وقدْ رَنَتِ النّجومُ إليّ خُوصاً","بأعْيُنِ كاسِراتِ الطَّرْفِ رُمْدِ",8,"د",1,0],["وقد رَضِيتُ منَ المَعْروفِ تَبذُلُهُ","أنْ يُنْجِزَ الطَّيْفُ في مَسْراهُ مِيعادا",9,"د",2,0],["وقُدْرَةُ الوقْتِ إنْ فكّرتُ تقْصُرُ عنْ","نفْسي وتقصُرُ نفْسي عنْ أمانِيها",10,"ي",3,0],["وَقَدْ رَأَيْتُ مَسِيرِي عَزَّ مَطلبُهُ","وَالطَّرفُ وَالظَّرفُ يُبْكِينِي ويَكْوِينِي",11,"ي",1,0],["وَقَدْ رَفَّ جِيدُ الْغُصْنِ فِي حَلْي زَهْرِهِ","وَنَافَحَ رَاحَ الطَّلِّ فَارتَاحَ نَشْوَانَا",12,"ن",2,0],["وقدْرُكَ قدْرُ النيلِ عنْدي وإنّني","لدى قدْرِكَ العالي أدَقُّ منَ الذرِّ",13,"ر",1,0],["وَقَد رَحَلتُ المَطِيَّ مُنتَخِلا","أُزجي ثِقالاً وَقُلقُلاً وَقِلا",14,"ل",2,0],["وَقَد رَمَيا بِالطَرفِ بَينَ جُموعِكُم","وَلَم يَشهَدا في المَشهَدَينِ مَكاني",15,"ي",1,0],["وَقَدَرتُم دَقيقَةَ العُمرِ حِرصاً","وَسِواكُم لا يَقدُرُ الأَجيالا",16,"ل",2,0],["وَقَد رَأَتكَ الأَماني","رِضىً فَلَم تَتَعَدَّك",17,"ك",1,0],["وَقَد رابَني قَولُها يا هَناهُ","وَيحَكَ أَلحَقتَ شَرّاً بِشَر",18,"ر",1,0],["وَقَد رَكَدَت وَسطَ السَماءِ نُجومُه","رُكودَ نَوادي الرَبرَبِ المُتَوَرِّقِ",19,"ق",1,0],["وَقَدْ رَأَى مِنْ بَلائِي فِي وَلائِمِهَا","بَلاءَ حُرٍّ جَمِيلِ الظَّنِّ بِالكَرَمِ",20,"م",1,0],["وَقَد رَأى البُردَ وَمَن","يَلبَسُهُ بَعدَ النَبي",21,"ب",2,0],["وَقَد رَفَعوا رَأسَ الحُسَينِ عَلى القَنا","وَساقوا نِساهُ حُسَّراً وَلِهاتِ",22,"ت",1,0],["وَقَد رَفَعَ الإِلَهُ بِكُلِّ أَرضٍ","لِضوئِكَ يا بِلالُ سَناً طِوالا",23,"ل",2,0],["وقد ركزت به الرايات خافقة","ما بين طاقين مرفوعين في نسق",24,"ق",1,0],["وقد رأيت أناساً واصلين بها","وهم بباريز مِلْبارود أنبوبا",25,"ب",2,0],["وَقَد رَغِبَت عَن شاعِرَيها مُجاشِعٌ","وَماشِئتَ فاشوا مِن رُواةٍ لِتَغلِبِ",26,"ب",1,0],["وَقَد رُعنا فَوارِسَ آلِ بِشرٍ","بِذاتِ الشيحِ مِن طُرُقِ الإِيادِ",27,"د",1,0],["وَقَد رَفَعَ الظَعائِنُ يَومَ رَهبى","بِروحٍ مِن فُؤادِكِ مُستَطارِ",28,"ر",1,0],["وقد رأينا بها حوراً منعمة","بيضاً تكامل فيها الدلّ والشنبُ",29,"ب",1,0],["وَقَدَّرتُ أَنَّ الصَبرَ بَعدَ فِراقِهِم","يُساعِدُني وَقتاً فَعُزّيتُ عَن صَبري",30,"ي",1,0],["وَقَد رُحنَ مِن مُهَجاتِ القُلوبِ","بِأَوفَرِ غُنمٍ وَأَغلى نَشَب",31,"ب",1,0],["وَقَد رَضيتُ بِأَهلِ الشَأمِ زافِرَةً","وَبِالأَميرِ وَبِالإِخوانِ إِخوانا",32,"ن",2,0],["وقدّ روت عن لينه واعتداله","صحاح العوالي مسنداً بعد مسند",33,"د",1,0],["وقد رقمت وشيَ الرّبى أبرُ الحيا","وجرَّت على وادِي دمشق برُوده",34,"د",2,0],["وقدراً إذا أضحى به الذكر طائراً","غدا واقعاً عنه من الليل نسره",35,"ر",2,0],["وقد رويت الثناء متَّصلاً","في الجودِ عن مالك ابن دينار",36,"ر",1,0],["وقد رفعت عينايَ قصة دمعها","فوقّع فيها الوجد يجري على الرسم",37,"م",1,0],["وقد رماه بشُؤبوبٍ فأحْصَنَهُ","جَدٌّ وأَنجاه شؤبوبٌ من الهربِ",38,"ب",1,0],["وقد رأى شيبةً فأنكرها","وتلك من فعله لو اعتبره",39,"ر",2,0],["وقد رأى الناسُ جِدّي","في الحادثات ونَهْضِي",40,"ض",2,0],["وقدر الله فيها أن يذللها","فهان مطلبها للجاهل الحمق",41,"ق",1,0],["وَقَد رَقَمَت أَغضانَها في أَديمَةٍ","كِتاباً مِنَ الأَوراقِ سَطراً عَلى سَطرِ",42,"ر",1,0],["وَقَد رابَني يا أَهلَ وُدِّيَ أَنَّكُم","مَطَلتُم وَأَنتُم قادِرونَ دُيوني",43,"ي",1,0],["وَقَد رابَني أَنَّ الغَيورَ يَوَدُّني","وَأَنَّ نَدامايَ الكُهولُ الجَحاجِحُ",44,"ح",1,0],["وَقِدرٍ كَرَألِ الصَحصَحانِ وَئيَّةٍ","أَنَختُ لَها بَعدَ الهُدُوِّ الأَثافِيا",45,"ي",2,0],["وَقَد رُمناكِ مِن بَلَدٍ بَعيدٍ","فَأَدناكِ الإِلَهُ بِلا تَوانِ",46,"ن",1,0],["وَقَد رَأَيتِ صَنيعي","وَقَد سَمِعتِ ثَنائي",47,"ي",1,0],["وَقَدَّرتُ لِلنُعمانِ يَوماً وَضِدَّهُ","فَما اِغتَرَّتِ البوسى وَلا غَرَّتِ النُعمى",48,"م",2,0],["وَقَد رَأَيتُ المُلوكَ قاطِبَةً","وَسِرتُ حَتّى رَأَيتُ مَولاها",49,"ا",3,0],["وقدَّرتَ من فرطِ الجهالة أنّني","أُقيمُ على كذبٍ رصيفٍ مُضَيَّعِ",50,"ع",1,0],["وقد رابني منكَ الصدود وليتَهُ","صدودُ اشتغالٍ لا صدودُ كلالِ",51,"ل",1,0],["وَقَد رَفَعتُ وَما طَأطَأتُها وَهَلاً","عَصا الهِجاءِ لِأَهلِ الحينِ وَالحوبِ",52,"ب",1,0],["وَقَد رَدَّتِ الخَمسونَ رَدَّ صَريمَةٍ","إِلى الشَيبِ مَن وَلّى عَنِ الشَيبِ يَهرُبُ",53,"ب",1,0],["وَقَد رَأَت وَجهَ مَن تُراسِلُهُ","فَاِنحَرَفَت عَنكَ شَرَّ مُنحَرَفِ",54,"ف",1,0],["وَقَد رَحَلَت وَما اِفتَكَّت أَسيراً","يُفالِتُ لُبَّهُ عَنَتُ الوَثاقِ",55,"ق",1,0],["وَقَد رَجَعَت وُفودُ الأَرضِ تُثني","بِذاكَ الطَولِ وَالمِنَنِ الجِسامِ",56,"م",1,0],["وَقَد رُفِعَت عَن نَجرِهِم آيَةُ النَدى","كَما رُفِعَت مَنسِيَّةً آيَةُ الرَجمِ",57,"م",1,0],["وَقَد راعَني مِنها الصُدودُ وَإِنَّما","تَصُدُّ لِشَيبٍ في عِذاري يَروعُها",58,"ع",3,0],["وَقَد رَأى مُصعَبٌ في ساطِعٍ سَبِطٍ","مِنها سَوابِقَ غاراتٍ أَطانيبِ",59,"ب",1,0],["وَقَد رُمتَ أَمراً يا مُعاوِيَ دونَهُ","خَياطِفُ عِلوَدٍّ صِعابٌ مَراتِبُه",60,"ب",2,0],["وَقَد راعَ لِلحَجّاجِ راعيهِما مَعاً","صَبوراً عَلى المَيتِ الكَريمِ مُفَجَّعا",61,"ع",2,0],["وَقِدرٍ فَثَأنا غَليَها بَعدَما غَلَت","وَأُخرى حَشَشنا بِالعَوالي تُؤَثَّفُ",62,"ف",1,0],["وقد رَدَّ غِلمانُنا شُقرَنا","وقادَ لنا الدُّهْمَ مَلاَّحُنا",63,"ن",2,0],["وقد رَقَّ جلِبابُ النَّسيمِ على النَّدى","ولكنْ جلابيبُ الغُيومِ صِفاقُ",64,"ق",1,0],["وقد رَقَّ ثَوبُ الغيمِ حتَّى كأنما","تُنَشَّرُ دُونَ الأُفْقِ منه سُجوفُ",65,"ف",1,0],["وقد رُفِعَتْ لنا سُودٌ","نجومُ سَمَائِها الحَبَبُ",66,"ب",1,0],["وَقَدرُ كُلِّ اِمرِئٍ ما كاَن يُحسِنُهُ","وَلِلرِجالِ عَلى الأَفعالِ اسماءُ",67,"ا",2,0],["وَقَدرُكَ ما بَينَ الأَنامِ مُمَنَّعاً","لَكَ العِزُّ ثَوبٌ وَالحَياءُ نِقابُ",68,"ب",1,0],["وَقَدَّرَ الخالَ عَلى خَدِّهِ","ذَلِكَ تَقديرُ العَزيزِ العَليم",69,"م",1,0],["وَقَدرُكَ المُعتَلي عَن ذاكَ يُغنينا","كَم قَد وُصِفتَ بِأَوصافٍ مُشَرِّفَةٍ",70,"ه",1,0],["وَقَد رَمى عَمرٌو بِسَه","مِ كَيدِهِ قَلبَ العُلى",71,"ا",1,0],["وقد رقَّت حواشيه إلى أن","رأيتُ الطودَ يخضرُّ اخضرارَا",72,"ر",2,0],["وقَدرُكَ أعلى من مدائحِنا الَّتي","أبَرّتْ على إِحسانِ مِصْقَعِ وائِلِ",73,"ل",1,0],["وَقَد رَكِبتْ فرسانها صَهَوَاتها","فأرْجَلَهُمْ عنها التذلّلُ والذعرُ",74,"ر",1,0],["وَقَد رَفَدَتهُ الخَنصَرانِ وَشَدَّدَت","ثَلاثَ نَواحيهِ الثَلاثُ الأَنامِلُ",75,"ل",1,0],["وَقَدَّرَ الشَّمْسَ تَجْرِي فِي مَنَازِلِهَا","وَالنَّجْمَ وَالْقَمَرَ السَّارِي بِحُسْبَانِ",76,"ن",1,0],["وَقَد رابَني مِنها صُدودٌ رَأَيتُهُ","وَإِعراضُها عَن جانِبي وَبُسورُها",77,"ر",3,0],["وَقَد رَثى مِن سَهَري في الدُجى","شَقيقُكَ البَدرُ وَلَم تَرثِ لي",78,"ل",2,0],["وَقِدراً إِذا ما أَنفَضَ القَومُ أَوفَضَت","إِلى نارِها سَعياً إِلَيها الأَرامِلُ",79,"ل",1,0],["وَقَد رَكَضَت بِنا خَيلُ المَلاهي","وَقَد طِرنا بِأَجنِحَةِ السُرورِ",80,"ر",1,0],["وَقَد رَكِبوا بَغيَهُم وَاِرتَقَوا","بِزَلّاءَ تُردي بِرُكّابِها",81,"ب",3,0],["وَقَدْرُكُ أَعْلَى أَنْ تُهَنَّى بِمَنْصِبٍ","وَأنتَ منَ الدُّنيا أَجَلُّ وَأَكْبَرُ",82,"ر",1,0],["وقد ركزْتَ القَنا بينَ السحاب وقد","أنزَلْتَ قِرْنَكَ من بينِ الدراريّ",83,"ي",1,0],["وقد رُبّيَتْ فيهِ الملوكُ مراتِباً","فمن بين متبوعٍ وآخَرَ يَتبَع",84,"ع",1,0],["وَقَد راحَت تُرَوِّحُنا المَنايا","لِمَخذولٍ وَأَحرَزَهُ الفِرارُ",85,"ر",1,0],["وَقَد رابَني قَلبٌ يُكَلِّفُني الصِبا","وَما كُلَّ حينٍ يَتبَعُ القَلبَ صاحِبُه",86,"ب",2,0],["وَقُدرَةُ اللَهِ حَقٌّ لَيسَ يُعجِزُها","حَشرٌ لِخَلقٍ وَلا بَعثٌ لِأَمواتِ",87,"ت",1,0],["وَقَد رَأَينا كَثيراً بَينَنا جَسَدا","بِغَيرِ رَوحٍ فَهَل رَوحٌ بِلا جَسَدِ",88,"د",1,0],["وَقَد رَفَقَ الَّذي أَوصى أُناساً","بِعُشرٍ في الزَكاةِ وَنِصفِ عُشرِ",89,"ر",1,0],["وَقُدرَةُ اللَهِ نَجَّت راجِلاً وَرَعاً","يَومَ الهِياجِ وَأَردَت فارِساً بَطَلا",90,"ل",2,0],["وَقَد رَفَعَت غَمائِمَ لِلرَزايا","عَلى وَجهِ التُرابِ فَطَبَّقَتهُ",91,"ت",2,0],["وَقَد رَكِبَ الَّذينَ مَضَوا سَبيلاً","إِلى عَليائِهِم لَم يَركَبوهُ",92,"ب",3,0],["وَقَد رآني أدنو منه مسترقاً","ففضَّل الصمتَ فعل الخائف الحذر",93,"ر",1,0],["وَقَد رأَيتك في المو","ج فوق وجه الغدير",94,"ر",1,0],["وَقَد رَموني بإلحاد وزندقة","وَما رَموني به زور وبهتان",95,"ن",1,0],["وقدروه بميزان له وضعوا","من العروض وهل للشعر ميزان",95,"ن",1,0],["وَقَد رَأَتني قُرَيشٌ ساحِباً رَسَني","إِلَيكَ عَن طَلقِها وَجهاً وَكالِحِها",96,"ح",3,0],["وقد رقَّ مَا وَرْدُ تلك الخُدُودِ","بما سال مِن مِسْك تِلْكَ اللِّمَمْ",97,"م",1,0],["وَقَد رابَني أَنَّ الصَبا لا تُجيبُني","وَقَد كانَ يَدعوني الصَبا فَأُجيبُ",98,"ب",1,0],["وَقَدْرُ الْهَوَى فِي ذِي الْهَوَى قَدْرُ نَفْسِهِ","وَمِرْآتُهُ قلْبُ المُتَيَّمِ وَالفِكْرُ",99,"ر",1,0],["وقد رَأْيتُ العَدْلَ في بَلْدَةٍ","فَقيهُها الشَّعْبِيُّ قاضِيها",100,"ي",3,0],["وَقَد رابَهُ مِنهُ تَوَرُّمُ نَرجسٍ","غَضيضٍ وَنِسرينٍ وَوَردٍ مُضعَّفِ",101,"ف",1,0],["وَقَدّر المَوتَ وَالنُشورَ عَلى ال","خَلقِ فَما بالُ مَن يَموتُ طَغى",102,"غ",2,0],["وَقَد رَكَدَت وَسطَ السَماءِ نُجومُها","رُكودَ نَوادي الرَبرَبِ المُتَوَرِّقِ",103,"ق",1,0],["وقد رَماني هواكُمْ في الغرامِ إلى","مَقامِ حُبٍّ شريفٍ شامخٍ سامِ",104,"م",1,0],["وقَدْ رُفِعَتْ أعلامُ مِصْرَ خَوَافِقاً","يُغَازِلُهَا مَسُّ الصَّبَا وتُغَأزلُهْ",105,"ل",2,0],["وقد رف جيد الغصن في حلي زهره","ونافح راح الظل فارتاح نشوانا",106,"ن",2,0],["وقد رفعوا الإنجيل فوق رؤوسهم","وقد قدسوا الروح المقدس تقديسا",107,"س",2,0],["وقدراً إذا ما أنفضَ القومُ أوفضتْ","إلى نارها مشياً إليها الأراملُ",108,"ل",1,0],["وقد رَضِيت بكِنٍّ أستكِنُّ به","ناءٍ عن العالَمِ المنحطِّ مهجور",109,"ر",1,0],["وقد رددتُ رزايا الدهرِ أجْمَعَها","إلى سِجِلَّيْنِ محفوظٍ ومكتوب",110,"ب",1,0],["وقد راعني حول الفرات منازل","تخلين عن ألافها ، ومرابع",111,"ع",1,0],["وقد رقمت أغصانها في أديمه","كتابا من الأوراق ، سطرا على سطر",112,"ر",1,0],["وَقَدْ رَاعَ للحجّاجِ ناعِيهِما معاً","صَبُوراً عَلى المَيْتِ الكَرِيمِ مُفَجَّعا",113,"ع",2,0]]}