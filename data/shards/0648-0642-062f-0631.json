"https://www.aldiwan.net/poem37753.html","الرجز"],[500,"روق كؤوسك هذا الوقت قد راق","https://www.aldiwan.net/poem37939.html","البسيط"],[500,"من خلف مسدل ستر الغيب لاح لنا","https://www.aldiwan.net/poem38084.html","البسيط"],[506,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[513,"فداك اخوك اليوم يوم سرور","https://www.aldiwan.net/poem67678.html","عموديه"],[515,"أوجبت في ذمة الأشعار والخطب","https://www.aldiwan.net/poem12014.html","البسيط"],[515,"أفخر فحسبك ما أوتيت من حسب","https://www.aldiwan.net/poem12019.html","البسيط"],[515,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[515,"إن كان عطفك للإعجاب يختال","https://www.aldiwan.net/poem12212.html","البسيط"],[515,"لئن قل صبر فالمصاب عظيم","https://www.aldiwan.net/poem12255.html","الطويل"],[515,"بقاؤك يا فارس المسلمينا","https://www.aldiwan.net/poem12283.html","المتقارب"],[536,"الحمد لله على الإسلام","https://www.aldiwan.net/poem23860.html","الرجز"],[538,"ألا فاسمعا لي ما أعيد وما أبدي","https://www.aldiwan.net/poem48223.html","عموديه"],[540,"عهدي بهم وسراب البيد منصدع","https://www.aldiwan.net/poem56905.html","البسيط"],[551,"من ذا عذيري من قوم أذاقهم","https://www.aldiwan.net/poem47241.html","البسيط"],[551,"ومن سفه لما مررت على الحمى","https://www.aldiwan.net/poem47243.html","الطويل"],[551,"لغير الغواني ما تجن الأضالع","https://www.aldiwan.net/poem47726.html","الطويل"],[551,"أنجد إذا شئت في الأرزاق أو أغر","https://www.aldiwan.net/poem47787.html","البسيط"],[551,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[551,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[551,"أدلت بحسن خولت ولو انها","https://www.aldiwan.net/poem48035.html","الطويل"],[558,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[558,"أدر صرفا خمور الأندرينا","https://www.aldiwan.net/poem33755.html","الوافر"],[558,"الكل حق والكل باطل","https://www.aldiwan.net/poem34254.html","مخلع البسيط"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[558,"يا شمعة هي في كل الفوانيس","https://www.aldiwan.net/poem34446.html","البسيط"],[558,"لحرب نفوسنا قد جاء فارس","https://www.aldiwan.net/poem34448.html","الوافر"],[559,"أيا سعد قل للقس من داخل الدير","https://www.aldiwan.net/poem69361.html","الطويل"],[562,"دعاني من هوى هند وأسما","https://www.aldiwan.net/poem52779.html","الوافر"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"],[575,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[575,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"]],"verses":[["وَقَد رَجَّلَ البيضُ مِن لِمَّتي","بِطِفلِ الأَنامِلِ بَضِّ البَنانِ",0,"ن",1,0],["وَقَد رَمَتِ الأَيّامُ مِن حَيثُ لا أَرى","صَميمِيَ بِالداءِ العَنيفِ عَلى عَمدِ",1,"د",1,0],["وَقَد رَكِبوهُ مَرَّةً بَعدَ مَرَّةٍ","فَيا لِذَلولِ البَغيِ مِن مَركَبٍ مُردي",1,"د",2,0],["وَقَد رَفَعَ الشُّعثُ المُلَبُّونَ أيدِياً","بحاجاتِهِم وَاللَّهُ مُعطٍ وَغافِرُ",2,"ر",1,0],["وَقَد رَدَّ غَربيَ عَما أَرومُ","زَمانٌ تَضايَقَ فيهِ مَجالي",3,"ي",1,0],["وَقَد رَمَتِ الذِّكرى جُفونيَ وَالحَشا","بِمُجتَلَبَيْ شَوقٍ قَديمٍ وَحادِثِ",4,"ث",1,0],["وَقَد رَمَتني غَداةَ الخَيفِ غانيَةٌ","بِناظِرٍ إِن رَمى لَم تُخطىءِ الغَرَضا",5,"ض",2,0],["وقد رَنا نَرْجِسُهُ بمُقْلَةٍ","يَحارُ فيها الدّمْعُ منْ صَوْبِ الحَيا",6,"ا",1,0],["وقد رَماني نَكَدُ الدّهْرِ بهِمْ","وما دَرى أيَّ معاوِيٍّ رَمى",6,"ا",1,0],["وقد رَمى بِكَ ركْنُ الدينِ مُعضلةً","يَهابُ كلُّ كَميٍّ دونَها قُحَما",7,"م",2,0],["وقدْ رَنَتِ النّجومُ إليّ خُوصاً","بأعْيُنِ كاسِراتِ الطَّرْفِ رُمْدِ",8,"د",1,0],["وقد رَضِيتُ منَ المَعْروفِ تَبذُلُهُ","أنْ يُنْجِزَ الطَّيْفُ في مَسْراهُ مِيعادا",9,"د",2,0],["وقُدْرَةُ الوقْتِ إنْ فكّرتُ تقْصُرُ عنْ","نفْسي وتقصُرُ نفْسي عنْ أمانِيها",10,"ي",3,0],["وَقَدْ رَأَيْتُ مَسِيرِي عَزَّ مَطلبُهُ","وَالطَّرفُ وَالظَّرفُ يُبْكِينِي ويَكْوِينِي",11,"ي",1,0],["وَقَدْ رَفَّ جِيدُ الْغُصْنِ فِي حَلْي زَهْرِهِ","وَنَافَحَ رَاحَ الطَّلِّ فَارتَاحَ نَشْوَانَا",12,"ن",2,0],["وقدْرُكَ قدْرُ النيلِ عنْدي وإنّني","لدى قدْرِكَ العالي أدَقُّ منَ الذرِّ",13,"ر",1,0],["وَقَد رَحَلتُ المَطِيَّ مُنتَخِلا","أُزجي ثِقالاً وَقُلقُلاً وَقِلا",14,"ل",2,0],["وَقَد رَمَيا بِالطَرفِ بَينَ جُموعِكُم","وَلَم يَشهَدا في المَشهَدَينِ مَكاني",15,"ي",1,0],["وَقَدَرتُم دَقيقَةَ العُمرِ حِرصاً","وَسِواكُم لا يَقدُرُ الأَجيالا",16,"ل",2,0],["وَقَد رَأَتكَ الأَماني","رِضىً فَلَم تَتَعَدَّك",17,"ك",1,0],["وَقَد رابَني قَولُها يا هَناهُ","وَيحَكَ أَلحَقتَ شَرّاً بِشَر",18,"ر",1,0],["وَقَد رَكَدَت وَسطَ السَماءِ نُجومُه","رُكودَ نَوادي الرَبرَبِ المُتَوَرِّقِ",19,"ق",1,0],["وَقَدْ رَأَى مِنْ بَلائِي فِي وَلائِمِهَا","بَلاءَ حُرٍّ جَمِيلِ الظَّنِّ بِالكَرَمِ",20,"م",1,0],["وَقَد رَأى البُردَ وَمَن","يَلبَسُهُ بَعدَ النَبي",21,"ب",2,0],["وَقَد رَفَعوا رَأسَ الحُسَينِ عَلى القَنا","وَساقوا نِساهُ حُسَّراً وَلِهاتِ",22,"ت",1,0],["وَقَد رَفَعَ الإِلَهُ بِكُلِّ أَرضٍ","لِضوئِكَ يا بِلالُ سَناً طِوالا",23,"ل",2,0],["وقد ركزت به الرايات خافقة","ما بين طاقين مرفوعين في نسق",24,"ق",1,0],["وقد رأيت أناساً واصلين بها","وهم بباريز مِلْبارود أنبوبا",25,"ب",2,0],["وَقَد رَغِبَت عَن شاعِرَيها مُجاشِعٌ","وَماشِئتَ فاشوا مِن رُواةٍ لِتَغلِبِ",26,"ب",1,0],["وَقَد رُعنا فَوارِسَ آلِ بِشرٍ","بِذاتِ الشيحِ مِن طُرُقِ الإِيادِ",27,"د",1,0],["وَقَد رَفَعَ الظَعائِنُ يَومَ رَهبى","بِروحٍ مِن فُؤادِكِ مُستَطارِ",28,"ر",1,0],["وقد رأينا بها حوراً منعمة","بيضاً تكامل فيها الدلّ والشنبُ",29,"ب",1,0],["وَقَدَّرتُ أَنَّ الصَبرَ بَعدَ فِراقِهِم","يُساعِدُني وَقتاً فَعُزّيتُ عَن صَبري",30,"ي",1,0],["وَقَد رُحنَ مِن مُهَجاتِ القُلوبِ","بِأَوفَرِ غُنمٍ وَأَغلى نَشَب",31,"ب",1,0],["وَقَد رَضيتُ بِأَهلِ الشَأمِ زافِرَةً","وَبِالأَميرِ وَبِالإِخوانِ إِخوانا",32,"ن",2,0],["وقدّ روت عن لينه واعتداله","صحاح العوالي مسنداً بعد مسند",33,"د",1,0],["وقد رقمت وشيَ الرّبى أبرُ الحيا","وجرَّت على وادِي دمشق برُوده",34,"د",2,0],["وقدراً إذا أضحى به الذكر طائراً","غدا واقعاً عنه من الليل نسره",35,"ر",2,0],["وقد رويت الثناء متَّصلاً","في الجودِ عن مالك ابن دينار",36,"ر",1,0],["وقد رفعت عينايَ قصة دمعها","فوقّع فيها الوجد يجري على الرسم",37,"م",1,0],["وقد رماه بشُؤبوبٍ فأحْصَنَهُ","جَدٌّ وأَنجاه شؤبوبٌ من الهربِ",38,"ب",1,0],["وقد رأى شيبةً فأنكرها","وتلك من فعله لو اعتبره",39,"ر",2,0],["وقد رأى الناسُ جِدّي","في الحادثات ونَهْضِي",40,"ض",2,0],["وقدر الله فيها أن يذللها","فهان مطلبها للجاهل الحمق",41,"ق",1,0],["وَقَد رَقَمَت أَغضانَها في أَديمَةٍ","كِتاباً مِنَ الأَوراقِ سَطراً عَلى سَطرِ",42,"ر",1,0],["وَقَد رابَني يا أَهلَ وُدِّيَ أَنَّكُم","مَطَلتُم وَأَنتُم قادِرونَ دُيوني",43,"ي",1,0],["وَقَد رابَني أَنَّ الغَيورَ يَوَدُّني","وَأَنَّ نَدامايَ الكُهولُ الجَحاجِحُ",44,"ح",1,0],["وَقِدرٍ كَرَألِ الصَحصَحانِ وَئيَّةٍ","أَنَختُ لَها بَعدَ الهُدُوِّ الأَثافِيا",45,"ي",2,0],["وَقَد رُمناكِ مِن بَلَدٍ بَعيدٍ","فَأَدناكِ الإِلَهُ بِلا تَوانِ",46,"ن",1,0],["وَقَد رَأَيتِ صَنيعي","وَقَد سَمِعتِ ثَنائي",47,"ي",1,0],["وَقَدَّرتُ لِلنُعمانِ يَوماً وَضِدَّهُ","فَما اِغتَرَّتِ البوسى وَلا غَرَّتِ النُعمى",48,"م",2,0],["وَقَد رَأَيتُ المُلوكَ قاطِبَةً","وَسِرتُ حَتّى رَأَيتُ مَولاها",49,"ا",3,0],["وقدَّرتَ من فرطِ الجهالة أنّني","أُقيمُ على كذبٍ رصيفٍ مُضَيَّعِ",50,"ع",1,0],["وقد رابني منكَ الصدود وليتَهُ","صدودُ اشتغالٍ لا صدودُ كلالِ",51,"ل",1,0],["وَقَد رَفَعتُ وَما طَأطَأتُها وَهَلاً","عَصا الهِجاءِ لِأَهلِ الحينِ وَالحوبِ",52,"ب",1,0],["وَقَد رَدَّتِ الخَمسونَ رَدَّ صَريمَةٍ","إِلى الشَيبِ مَن وَلّى عَنِ الشَيبِ يَهرُبُ",53,"ب",1,0],["وَقَد رَأَت وَجهَ مَن تُراسِلُهُ","فَاِنحَرَفَت عَنكَ شَرَّ مُنحَرَفِ",54,"ف",1,0],["وَقَد رَحَلَت وَما اِفتَكَّت أَسيراً","يُفالِتُ لُبَّهُ عَنَتُ الوَثاقِ",55,"ق",1,0],["وَقَد رَجَعَت وُفودُ الأَرضِ تُثني","بِذاكَ الطَولِ وَالمِنَنِ الجِسامِ",56,"م",1,0],["وَقَد رُفِعَت عَن نَجرِهِم آيَةُ النَدى","كَما رُفِعَت مَنسِيَّةً آيَةُ الرَجمِ",57,"م",1,0],["وَقَد راعَني مِنها الصُدودُ وَإِنَّما","تَصُدُّ لِشَيبٍ في عِذاري يَروعُها",58,"ع",3,0],["وَقَد رَأى مُصعَبٌ في ساطِعٍ سَبِطٍ","مِنها سَوابِقَ غاراتٍ أَطانيبِ",59,"ب",1,0],["وَقَد رُمتَ أَمراً يا مُعاوِيَ دونَهُ","خَياطِفُ عِلوَدٍّ صِعابٌ مَراتِبُه",60,"ب",2,0],["وَقَد راعَ لِلحَجّاجِ راعيهِما مَعاً","صَبوراً عَلى المَيتِ الكَريمِ مُفَجَّعا",61,"ع",2,0],["وَقِدرٍ فَثَأنا غَليَها بَعدَما غَلَت","وَأُخرى حَشَشنا بِالعَوالي تُؤَثَّفُ",62,"ف",1,0],["وقد رَدَّ غِلمانُنا شُقرَنا","وقادَ لنا الدُّهْمَ مَلاَّحُنا",63,"ن",2,0],["وقد رَقَّ جلِبابُ النَّسيمِ على النَّدى","ولكنْ جلابيبُ الغُيومِ صِفاقُ",64,"ق",1,0],["وقد رَقَّ ثَوبُ الغيمِ حتَّى كأنما","تُنَشَّرُ دُونَ الأُفْقِ منه سُجوفُ",65,"ف",1,0],["وقد رُفِعَتْ لنا سُودٌ","نجومُ سَمَائِها الحَبَبُ",66,"ب",1,0],["وَقَدرُ كُلِّ اِمرِئٍ ما كاَن يُحسِنُهُ","وَلِلرِجالِ عَلى الأَفعالِ اسماءُ",67,"ا",2,0],["وَقَدرُكَ ما بَينَ الأَنامِ مُمَنَّعاً","لَكَ العِزُّ ثَوبٌ وَالحَياءُ نِقابُ",68,"ب",1,0],["وَقَدَّرَ الخالَ عَلى خَدِّهِ","ذَلِكَ تَقديرُ العَزيزِ العَليم",69,"م",1,0],["وَقَدرُكَ المُعتَلي عَن ذاكَ يُغنينا","كَم قَد وُصِفتَ بِأَوصافٍ مُشَرِّفَةٍ",70,"ه",1,0],["وَقَد رَمى عَمرٌو بِسَه","مِ كَيدِهِ قَلبَ العُلى",71,"ا",1,0],["وقد رقَّت حواشيه إلى أن","رأيتُ الطودَ يخضرُّ اخضرارَا",72,"ر",2,0],["وَقَدْ رَضِيتُ بِهِمْ لَوْ يَسْفِكُونَ دَمِي","لكن أَعُوذُ بِهِمْ أَنْ يَسْفِكُوهُ سُدَى",73,"د",2,0],["وقَدرُكَ أعلى من مدائحِنا الَّتي","أبَرّتْ على إِحسانِ مِصْقَعِ وائِلِ",74,"ل",1,0],["وَقَد رَكِبتْ فرسانها صَهَوَاتها","فأرْجَلَهُمْ عنها التذلّلُ والذعرُ",75,"ر",1,0],["وَقَد رَفَدَتهُ الخَنصَرانِ وَشَدَّدَت","ثَلاثَ نَواحيهِ الثَلاثُ الأَنامِلُ",76,"ل",1,0],["وَقَدَّرَ الشَّمْسَ تَجْرِي فِي مَنَازِلِهَا","وَالنَّجْمَ وَالْقَمَرَ السَّارِي بِحُسْبَانِ",77,"ن",1,0],["وَقَد رابَني مِنها صُدودٌ رَأَيتُهُ","وَإِعراضُها عَن جانِبي وَبُسورُها",78,"ر",3,0],["وَقَد رَثى مِن سَهَري في الدُجى","شَقيقُكَ البَدرُ وَلَم تَرثِ لي",79,"ل",2,0],["وَقِدراً إِذا ما أَنفَضَ القَومُ أَوفَضَت","إِلى نارِها سَعياً إِلَيها الأَرامِلُ",80,"ل",1,0],["وَقَد رَكَضَت بِنا خَيلُ المَلاهي","وَقَد طِرنا بِأَجنِحَةِ السُرورِ",81,"ر",1,0],["وَقَد رَكِبوا بَغيَهُم وَاِرتَقَوا","بِزَلّاءَ تُردي بِرُكّابِها",82,"ب",3,0],["وَقَدْرُكُ أَعْلَى أَنْ تُهَنَّى بِمَنْصِبٍ","وَأنتَ منَ الدُّنيا أَجَلُّ وَأَكْبَرُ",83,"ر",1,0],["وقد ركزْتَ القَنا بينَ السحاب وقد","أنزَلْتَ قِرْنَكَ من بينِ الدراريّ",84,"ي",1,0],["وقد رُبّيَتْ فيهِ الملوكُ مراتِباً","فمن بين متبوعٍ وآخَرَ يَتبَع",85,"ع",1,0],["وَقَد راحَت تُرَوِّحُنا المَنايا","لِمَخذولٍ وَأَحرَزَهُ الفِرارُ",86,"ر",1,0],["وَقَد رابَني قَلبٌ يُكَلِّفُني الصِبا","وَما كُلَّ حينٍ يَتبَعُ القَلبَ صاحِبُه",87,"ب",2,0],["وَقُدرَةُ اللَهِ حَقٌّ لَيسَ يُعجِزُها","حَشرٌ لِخَلقٍ وَلا بَعثٌ لِأَمواتِ",88,"ت",1,0],["وَقَد رَأَينا كَثيراً بَينَنا جَسَدا","بِغَيرِ رَوحٍ فَهَل رَوحٌ بِلا جَسَدِ",89,"د",1,0],["وَقَد رَفَقَ الَّذي أَوصى أُناساً","بِعُشرٍ في الزَكاةِ وَنِصفِ عُشرِ",90,"ر",1,0],["وَقُدرَةُ اللَهِ نَجَّت راجِلاً وَرَعاً","يَومَ الهِياجِ وَأَردَت فارِساً بَطَلا",91,"ل",2,0],["وَقَد رَفَعَت غَمائِمَ لِلرَزايا","عَلى وَجهِ التُرابِ فَطَبَّقَتهُ",92,"ت",2,0],["وَقَد رَكِبَ الَّذينَ مَضَوا سَبيلاً","إِلى عَليائِهِم لَم يَركَبوهُ",93,"ب",3,0],["وَقَد رآني أدنو منه مسترقاً","ففضَّل الصمتَ فعل الخائف الحذر",94,"ر",1,0],["وَقَد رأَيتك في المو","ج فوق وجه الغدير",95,"ر",1,0],["وَقَد رَموني بإلحاد وزندقة","وَما رَموني به زور وبهتان",96,"ن",1,0],["وقدروه بميزان له وضعوا","من العروض وهل للشعر ميزان",96,"ن",1,0],["وَقَد رَأَتني قُرَيشٌ ساحِباً رَسَني","إِلَيكَ عَن طَلقِها وَجهاً وَكالِحِها",97,"ح",3,0],["وقد رقَّ مَا وَرْدُ تلك الخُدُودِ","بما سال مِن مِسْك تِلْكَ اللِّمَمْ",98,"م",1,0],["وَقَد رابَني أَنَّ الصَبا لا تُجيبُني","وَقَد كانَ يَدعوني الصَبا فَأُجيبُ",99,"ب",1,0],["وَقَدْرُ الْهَوَى فِي ذِي الْهَوَى قَدْرُ نَفْسِهِ","وَمِرْآتُهُ قلْبُ المُتَيَّمِ وَالفِكْرُ",100,"ر",1,0],["وقد رَأْيتُ العَدْلَ في بَلْدَةٍ","فَقيهُها الشَّعْبِيُّ قاضِيها",101,"ي",3,0],["وَقَد رابَهُ مِنهُ تَوَرُّمُ نَرجسٍ","غَضيضٍ وَنِسرينٍ وَوَردٍ مُضعَّفِ",102,"ف",1,0],["وَقَدّر المَوتَ وَالنُشورَ عَلى ال","خَلقِ فَما بالُ مَن يَموتُ طَغى",103,"غ",2,0],["وَقَد رَكَدَت وَسطَ السَماءِ نُجومُها","رُكودَ نَوادي الرَبرَبِ المُتَوَرِّقِ",104,"ق",1,0],["وقد رَماني هواكُمْ في الغرامِ إلى","مَقامِ حُبٍّ شريفٍ شامخٍ سامِ",105,"م",1,0],["وقَدْ رُفِعَتْ أعلامُ مِصْرَ خَوَافِقاً","يُغَازِلُهَا مَسُّ الصَّبَا وتُغَأزلُهْ",106,"ل",2,0],["وقد رف جيد الغصن في حلي زهره","ونافح راح الظل فارتاح نشوانا",107,"ن",2,0],["وقد رفعوا الإنجيل فوق رؤوسهم","وقد قدسوا الروح المقدس تقديسا",108,"س",2,0],["وقدراً إذا ما أنفضَ القومُ أوفضتْ","إلى نارها مشياً إليها الأراملُ",109,"ل",1,0],["وقد رَضِيت بكِنٍّ أستكِنُّ به","ناءٍ عن العالَمِ المنحطِّ مهجور",110,"ر",1,0],["وقد رددتُ رزايا الدهرِ أجْمَعَها","إلى سِجِلَّيْنِ محفوظٍ ومكتوب",111,"ب",1,0],["وقد راعني حول الفرات منازل","تخلين عن ألافها ، ومرابع",112,"ع",1,0],["وقد رقمت أغصانها في أديمه","كتابا من الأوراق ، سطرا على سطر",113,"ر",1,0],["وَقَدْ رَاعَ للحجّاجِ ناعِيهِما معاً","صَبُوراً عَلى المَيْتِ الكَرِيمِ مُفَجَّعا",114,"ع",2,0],["وَقَدر جاهك في الآفاق مُرتَفع","ما حَطَ يَوماً وَإِن لَم يَخل مِن حَسَد",115,"د",1,0],["وَقَد رَأى ماجد كَريم","وَالدهُ لَيلُهُ مَلاما",116,"م",2,0],["وقد رفع الغوث الرفاعي مجده","وبالصيد صياد المفاخر ناظمه",117,"م",2,0],["وقد رحت ترميني بطرحي للوفا","واخطأُ رام فوّق النبل للبدر",118,"ر",1,0],["وقد رأى من التجلي مشعبا","أهلا وسهلا يا غريب الغربا",119,"ا",1,0],["وقدرت المقادير اجتماعا","على إيثار كلٍّ الإغترابا",120,"ب",2,0],["وقد رباك في نعم ولكن","أتاك اليومَ في الكِبرِ انتقام",121,"م",1,0],["وقد رقم الحور ولدانها","نفيسة فازت بأوج النعيمْ",122,"م",1,1],["وقد رقصت أغصانه وتبسمت","أزاهره والكون منه تعطرا",123,"ر",2,0],["وقد رأيت من الشمسِ المنيرة ما","تهوى وعاد بها عيش اللقا رغدا",124,"د",2,0],["وَقَد رُمتُ أَن أَلقى الصُدودَ بِمِثلِهِ","مُقابَلَةً لَكِنَّني أَتَهَيَّبُ",125,"ب",1,0],["وقد رفعت عنها الإزار فلج به","وبرد فؤاداً من زلال نداها",126,"ا",3,0],["وَقَد رَفَعَت مِن شأَنِهِ وَأَجَلَّتِ","أَضاءَت سَناهُ فاِستَبانَت سَناءَهُ",127,"ه",1,0],["وقَد رأَيتُ مِنَ الأسرارِ أَروعَهَا","وإنَّ أروعَهَا أَسْرارُ تَكوِيني",128,"ي",1,0],["وقدرُك لا يخفى فأخفاه عنهم","وأعماهم عمى اقتضى الرشد والحلمُ",129,"م",1,0],["وقد رفعوا الايدى إلى الله بالدعا","على من هداهم كاشفين العمائما",130,"م",2,0],["وقدرةُ الله للأسباب لازمةٌ","كما