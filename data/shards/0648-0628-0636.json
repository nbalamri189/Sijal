{"poems":[[89,"أبكي ومثلي بالبكاء حقيق","https://www.aldiwan.net/poem44893.html","الكامل"],[85,"أهلا وسهلا بحاميها وفاديها","https://www.aldiwan.net/poem7586.html","البسيط"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[48,"خلق الشباب وشرتي لم تخلق","https://www.aldiwan.net/poem64445.html","الكامل"],[67,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[113,"سيدنا الشيخ على الخزام","https://www.aldiwan.net/poem41756.html","السريع"],[164,"أنت الذي أوليتني مننا","https://www.aldiwan.net/poem46905.html","أحذ الكامل"],[351,"زن بالفضائل مجد جدك","https://www.aldiwan.net/poem40385.html","مجزوء الكامل"],[429,"لو أن ذا قلمي قوى كلمي","https://www.aldiwan.net/poem12401.html","أحذ الكامل"],[446,"شوقي إليكم مثل وجدي فيكم","https://www.aldiwan.net/poem53724.html","الكامل"],[466,"اليوم يا ذا الفخر والمجد","https://www.aldiwan.net/poem60223.html","السريع"]],"verses":[["وبضفدع لولا اطراد نقيقه","ما كنت اعلم انه مخلوق",0,"ق",1,0],["وبِض لها بيضة للنصر كافلة","إن الدجاج عقيم في نواحيها",1,"ي",3,0],["وبِضَرْبَةٍ يَدَعُ المُدَجَّجَ وِترُها","شَفْعاً كما شاء الرَّدَى مَجدُولا",2,"ل",2,0],["وَبِضاعَةُ الشُعَراءِ إِن أَنفَقتَها","نَفَقَت وَإِن أَكسَدتَها لَم تَنفُقِ",3,"ق",1,0],["وبضربة ٍ يَدَعُ المُدجَّجَ وِتْرُها","صَمَمٍ وَكَمْ داءٍ أزالَ دَخِيلا",4,"ل",2,0],["وبضعة الصياد قطب الورى","سبط سراج الدين عالي المقام",5,"م",1,0],["وبِضاعتي نفقتْ لديكَ وكَمْ","كسدتْ لدى الجُهّالِ أَسواقي",6,"ق",2,0],["وَبضدّه تَلقى الهَوا","ن مُعارِضاً بِسَبيل قَصدِك",7,"ك",1,0],["وبضاعَتِي نُطْقِي وأَكسَدُ ما","بِيع الكلامُ على ذَوي الصَّمَم",8,"م",1,0],["وبضجة الركبان فى بطحائها","طربا اذا ما شارفوه وسلموا",9,"م",3,0],["وَبضعدَ هَذا فَلَنا نَرجِسٌ","لَو كانَ دُرّاً كانَ في العِقدِ",10,"د",1,0]]}