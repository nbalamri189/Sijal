{"poems":[[91,"أبكي ومثلي بالبكاء حقيق","https://www.aldiwan.net/poem44893.html","الكامل"],[87,"أهلا وسهلا بحاميها وفاديها","https://www.aldiwan.net/poem7586.html","البسيط"],[69,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[50,"خلق الشباب وشرتي لم تخلق","https://www.aldiwan.net/poem64445.html","الكامل"],[106,"","https://poetry.dctabudhabi.ae/diwan/poem/142181","الكامل"],[69,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[119,"سيدنا الشيخ على الخزام","https://www.aldiwan.net/poem41756.html","السريع"],[170,"أنت الذي أوليتني مننا","https://www.aldiwan.net/poem46905.html","أحذ الكامل"],[358,"زن بالفضائل مجد جدك","https://www.aldiwan.net/poem40385.html","مجزوء الكامل"],[438,"لو أن ذا قلمي قوى كلمي","https://www.aldiwan.net/poem12401.html","أحذ الكامل"],[453,"شوقي إليكم مثل وجدي فيكم","https://www.aldiwan.net/poem53724.html","الكامل"],[473,"اليوم يا ذا الفخر والمجد","https://www.aldiwan.net/poem60223.html","السريع"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138245",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122666","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122645","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59419","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78173","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124731","الكامل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100456","الرجز"],[2177,"","https://poetry.dctabudhabi.ae/diwan/poem/138794",""],[2675,"","https://poetry.dctabudhabi.ae/diwan/poem/200263","الكامل"],[2753,"","https://poetry.dctabudhabi.ae/diwan/poem/20053","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100293","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58436","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205020","السريع"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74233","الطويل"],[3232,"","https://poetry.dctabudhabi.ae/diwan/poem/100431","الكامل"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106687","الخفيف"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112685","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112613","الرجز"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126951","المديد"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138534",""],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73088","الخفيف"],[4782,"الى معلمتي \" الملاك الحارس\"","https://www.poetsgate.com/ViewPoem.aspx?id=208645",""],[5302,"فؤاد شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=200489",""],[5397,"أبسفح حاجر منك يسفح محجر","https://www.poetsgate.com/ViewPoem.aspx?id=157963",""],[5431,"احرق بربك قد جُعِلْتُ لتحْرقا","https://www.poetsgate.com/ViewPoem.aspx?id=195162",""],[5442,"مادون رامة من معرس","https://www.poetsgate.com/ViewPoem.aspx?id=114778",""],[5751,"طِفلة الورد","https://www.poetsgate.com/ViewPoem.aspx?id=214766",""]],"verses":[["وبضفدع لولا اطراد نقيقه","ما كنت اعلم انه مخلوق",0,"ق",1,0],["وبِض لها بيضة للنصر كافلة","إن الدجاج عقيم في نواحيها",1,"ي",3,0],["وبِضَرْبَةٍ يَدَعُ المُدَجَّجَ وِترُها","شَفْعاً كما شاء الرَّدَى مَجدُولا",2,"ل",2,0],["وَبِضاعَةُ الشُعَراءِ إِن أَنفَقتَها","نَفَقَت وَإِن أَكسَدتَها لَم تَنفُقِ",3,"ق",1,0],["وبضاعة في السوق باعتها","العصابة للعصابة",4,"ب",2,0],["وبضربة ٍ يَدَعُ المُدجَّجَ وِتْرُها","صَمَمٍ وَكَمْ داءٍ أزالَ دَخِيلا",5,"ل",2,0],["وبضعة الصياد قطب الورى","سبط سراج الدين عالي المقام",6,"م",1,0],["وبِضاعتي نفقتْ لديكَ وكَمْ","كسدتْ لدى الجُهّالِ أَسواقي",7,"ق",2,0],["وَبضدّه تَلقى الهَوا","ن مُعارِضاً بِسَبيل قَصدِك",8,"ك",1,0],["وبضاعَتِي نُطْقِي وأَكسَدُ ما","بِيع الكلامُ على ذَوي الصَّمَم",9,"م",1,0],["وبضجة الركبان فى بطحائها","طربا اذا ما شارفوه وسلموا",10,"م",3,0],["وَبضعدَ هَذا فَلَنا نَرجِسٌ","لَو كانَ دُرّاً كانَ في العِقدِ",11,"د",1,0],["وبضاعتي المزجاة دون الوحي ما","حالت وجثت الآن شعري منشدا",12,"د",2,0],["وبِضاعَةٌ ليسَت بِمُزجاةٍ إذا","أزجى الغَنيُّ إلى الغَنيِّ بَضائِعا",13,"ع",2,0],["وبِضعَةٌ مِن رسُولِ اللهِ مُعظِمَةٌ","مُنيفَةٌ عن أبي شاسٍ وعَن شاس",14,"س",1,0],["وبضربة هد الكثيب ولم يكن","لولاه يشكو حالة المتصدع",15,"ع",1,0],["وبضربة هدا الكثيب وقد عصى","عن هد محتكم بضرب المعول",16,"ل",1,0],["وَبِضاعة العُلَماء مِن فَرط العَمى","وَالجَهل مُلقاةٌ بِسوق كَساد",17,"د",1,0],["وبضاع من كاتبته","حجرٌ عليك لدى البضاعِ",18,"ع",1,0],["وبضعة من جعفر مغموسةً","بريق موسى لقبوها اللعسا",19,"س",2,0],["وبضعة المصطفى لم يرع جانبها","حتى قضت وهي غضبى داؤها داء",20,"ا",2,0],["وبضمر الأقلام يبلغ أهلها","ما ليس يبلغ بالجياد الضّمّر",21,"ر",1,0],["وَبِضَرغَدٍ وَعلى السُديرِ وَحاضِرٍ","وَبِذي أَمَرَّ حَريمُهُم لَم يُقسَمِ",22,"م",1,0],["وبضوء صبح جبي","نك الصلت الذي بالصبح سافر",23,"ر",1,0],["وَبضَربةٍ من ذي حُسامٍ منتضى","يَفري الفريسة من جهولٍ مُفترى",24,"ر",2,0],["وبضع أوراق بطياتها","حوت شظايا قلبي الثائر",25,"ر",1,0],["وَبضعته الزَهراء أمك وَالفَتى","علي أبوك القاسم الأسد الوردا",26,"د",2,0],["وبضعت عرق الشك منك بمبضع","أجرى النجيع ونبضه المؤذي سكن",27,"ن",1,0],["وبِضَربِ الهِندِيِّ كَم قَد طَرَحتُم","مِن ضُرُوبِ العِدَى بِجَمعِ الكُسورِ",28,"ر",1,0],["وبضعة المعصوم كالمعصوم","في الحكم بالخصوص والعموم",29,"م",1,0],["وبَضعَةَ الهادي شفيع الأمّه","والغُرّ من أبنائها الأئمه",30,"ه",1,0],["وبضوء من سناه بدا","وجه هذا العصر في بلج",31,"ج",1,0],["وبضلعها بالعصر كسر مبهضٌ","والجسم منتحلٌ من الارزاء",32,"ا",2,0],["وبضوءِ الصبَّاحِ ثغراً وبالظَّل","ماءِ شَعراً وبالبُدورِ جمَالا",33,"ل",2,0],["وبضاعتي المزجاةُ أحرف حامدٍ","وحمائمٌ بيضاء تقرِئكِ السلام؟",34,"م",1,0],["وبضافي الضياء يغمر دنيا","ه حثيثا ويستجيش البصائر",35,"ر",1,0],["وبضربه هدم الصفوف ثوابتا","ولهن طاح مقدم ومؤخر",36,"ر",1,0],["وبضحكة العينين ألف فراشة","طارت إليّ مع الهلاك تشوقا",37,"ق",2,0],["وبضاعتي التوحيد مع","حب الرسول فلست أبخس",38,"س",1,0],["وبضِحكةٍ وَرديَّة لا تَنطفي","شُقّي المَدى كي يَضحكَ الشِّريانُ",39,"ن",1,0]]}