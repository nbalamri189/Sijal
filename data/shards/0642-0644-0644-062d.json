{"poems":[[55,"ألهاك عنا ربة البرقع","https://www.aldiwan.net/poem30157.html","السريع"],[71,"قل لحسود ذمني","https://www.aldiwan.net/poem28779.html","مجزوء الرجز"],[83,"يا سمي المصطفى يا بغيتي","https://www.aldiwan.net/poem61480.html","الرمل"],[50,"قل لحمدان ما لكا","https://www.aldiwan.net/poem65020.html","مجزوء الخفيف"],[52,"قل لحبى قربيني","https://www.aldiwan.net/poem64739.html","مجزوء الرمل"],[52,"قل لحباء إن تعيشي فموتي","https://www.aldiwan.net/poem64750.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43760","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[283,"قل لحادي عشر البروج أبي العاشر","https://www.aldiwan.net/poem2479.html","الخفيف"],[353,"لو وجد اللائم بعض ماوجد","https://www.aldiwan.net/poem20074.html","مجزوء الرجز"],[422,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[556,"من لداع لا يجاب","https://www.aldiwan.net/poem48097.html","مجزوء الرمل"],[580,"يأيها البرق الذي","https://www.aldiwan.net/poem2864.html","مجزوء الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53125","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74098","الرمل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102456","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[5061,"الوفاء والطيب","https://www.poetsgate.com/ViewPoem.aspx?id=147176",""],[6124,"خانت غنائي","https://www.poetsgate.com/ViewPoem.aspx?id=194521",""]],"verses":[["قُل لِحَسودِ النَجمِ في فَوتِهِ","عِشتَ بِداءِ الكَمَدِ المَوجِعِ",0,"ع",1,0],["قلْ لحسودٍ ذمَّني","جوراً وظلماً واعتدى",1,"د",2,1],["قُل لِحِبِّ الصَبِّ عَنهُ اِسلَم وَكُن","مِن سَلُوّي وَاِصطِباري في أَمانِ",2,"ن",1,0],["قُل لِحَمدانَ ما لَكا","أَصلَحَ اللَهُ حالَكا",3,"ك",2,1],["قُل لِحُبّى قَرِّبيني","أَنتِ نَفسي وَحَياتي",4,"ت",2,1],["قُل لِحُبّاءَ إِن تَعيشي فَموتي","سَوفَ نَرضى لَكِ الَّذي قَد رَضيتِ",5,"ت",1,1],["قُل لِحُماةِ الحُروبِ فهرٍ","ما لِأَشِدّائِكُم يَهونا",6,"ن",2,1],["قلْ لِحَسَّانَ إِنْ مَرَرْتَ عَلَيْهِ","فِي ظِلالِ الْفِرْدَوْسِ يُطْري الرَّسُولاَ",7,"ل",2,0],["قل لحادي عشر البروج أبي العا","شر منها رب القران الثاني",8,"ن",2,1],["قُلْ لَحسُودٍ قَدْ عَوَى سَماءَهُمْ","لمَّا رَأَى شِهَابَهُمْ وَقَدْ وَقَدْ",9,"د",1,0],["قلْ لحُسَّاد معاليه اقصُروا","لم تَزَلْ أَيديه في المجد طوالا",10,"ل",2,0],["قُلْ لِحُسَّادي أَفيقوا","فاتَكم عِندي الطِلابُ",11,"ب",1,0],["قل لحبيبي إِنَّني","صادٍ إِلى ميمِ فَمِه",12,"م",2,0],["قل لحسام الدين ينبوع الندى","محيي الندى مُمَوِّل الفقير",13,"ر",1,1],["قل لحاديه أَجِب تسآلنا","قَد نَراك اليَوم أَعجلت الحِذاءَ",14,"ا",2,0],["قل لحادي المطي خفض قليلا","تجعل العيس سيرهن ذميلا",15,"ل",2,1],["قلْ لحُلْوٍ حالٍ من الحُسنِ في هج","رِكَ حالي حَزْنٌ وعَيْشي مَريرُ",16,"ر",1,0],["قل لحاسدنا ترا والله تهبي","انت دلخ ودلخ تتبعه الدلوخ",17,"خ",1,0],["قُلْ لِحَسْنَاءَ: إِنْ عَصَيْنَا فَمُوتِي","سَوفَ أَرْضَى مِنكِ الَّذِي قَدْ بَرِيْتِ",18,"ت",1,1]]}