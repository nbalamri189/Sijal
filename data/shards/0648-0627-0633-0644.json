307.html","الطويل"],[462,"لا يعجزنك المجد من بعده","https://www.aldiwan.net/poem16003.html","السريع"],[465,"قف أن وقفت فذاك وادي المنحى","https://www.aldiwan.net/poem3179.html","عموديه"],[467,"ألا ليت شعري والخطوب كثيرة","https://www.aldiwan.net/poem50420.html","الطويل"],[476,"هل تعرف المنزل بالأهيل","https://www.aldiwan.net/poem1825.html","السريع"],[480,"أسفي على هذا الزمان وأهله","https://www.aldiwan.net/poem37188.html","الكامل"],[483,"عرج بمنعرج الكثيب الأخضد","https://www.aldiwan.net/poem24364.html","عموديه"],[501,"كتب الظلام على الوجود سطورا","https://www.aldiwan.net/poem38003.html","مجزوء الكامل"],[501,"تحل بالصدق واذكر خاشعا وأمط","https://www.aldiwan.net/poem38067.html","البسيط"],[501,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[506,"التوبة","https://www.aldiwan.net/poem27892.html","الطويل"],[516,"يا من تظل له الكواكب حسدا","https://www.aldiwan.net/poem12095.html","الكامل"],[516,"دانت لأمرك طاعة الأقدار","https://www.aldiwan.net/poem12106.html","الكامل"],[516,"العلم مذ كان محتاج إلى العلم","https://www.aldiwan.net/poem12262.html","البسيط"],[530,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[539,"واسلك سبيل المفلسين ودار","https://www.aldiwan.net/poem48172.html","عموديه"],[552,"إن العقيق يزيدني خبلا","https://www.aldiwan.net/poem47321.html","أحذ الكامل"],[552,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[552,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[552,"يا خير باد في الأنام وحاضر","https://www.aldiwan.net/poem47789.html","الكامل"],[552,"قرت عيون بني النبي محمد","https://www.aldiwan.net/poem47856.html","الكامل"],[552,"ما في السلو لنا نصيب يطلب","https://www.aldiwan.net/poem48091.html","الكامل"],[553,"ونشقى بالأمل","https://www.aldiwan.net/poem24832.html","عموديه"],[559,"عدم يحيط به الوجود وإنما","https://www.aldiwan.net/poem34075.html","الكامل"],[559,"بدر تم لاح في الغسق","https://www.aldiwan.net/poem34335.html","المديد"],[559,"يا نسبة أدخلت سلمان في النسب","https://www.aldiwan.net/poem34930.html","البسيط"],[565,"عنوان مجدك ظاهر وضاح","https://www.aldiwan.net/poem833.html",""],[576,"لما دعا في الركب داعي الفراق","https://www.aldiwan.net/poem2701.html","السريع"],[580,"رجواك في الله لاتخطأ مراميه","https://www.aldiwan.net/poem56780.html","البسيط"],[587,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"]],"verses":[["وَاِسلَم أَميرَ المُؤمِنينَ إِذا","شَرَعَ الحِمامُ وَصَمَّمَ الأَجَلُ",0,"ل",1,0],["وأسْلكَ نهْجَ الحقِّ مَنْ حادَ بعْدَما","تُنوسِيَ ذِكْراهُ وضَلَّ سديدُهُ",1,"د",2,0],["واسْلُكْ منَ السّيْرِ بهِ مَنْهَجاً","عنْ مادِحٍ جلَّ وعمّنْ هَجا",2,"ج",2,0],["وَأَسلَمَهُ أَحبابُهُ لِقُضاتِهِ","وَفَرَّ وَلَم يَخشَ المَعَرَّةَ كاتِبُه",3,"ب",2,0],["وَاِسلُل حَياةً مِن يَمينِ الرَدى","أَوشَكَ يَدعوها ظَلامُ الرُموس",4,"س",1,0],["وَأَسلَمنا الرِياسَةَ في نِزارٍ","وَكانَت مِنهُمُ في الأَحوَصينا",5,"ن",2,0],["وَأَسلاكَ سَلمى وَالشَبابَ الَّذي مَضى","وَفاةُ اِبنِ لَيلى إِذ أَتاكَ خَبيرُها",6,"ر",3,0],["وَأَسلَمَت بَعدَ نَقفِ البيضِ وَاِعتَسَفَت","مِن بَعدِ لَذَّةِ عَيشٍ غَيرِ مَقتورِ",7,"ر",1,0],["وَاسْلَم لهَا وَلْتَحيَا مِنْ","نُعْمَاكَ فِي ظِلِّ ظَلِيلْ",8,"ل",1,0],["وَأَسلَمَتني مِن بَعدِ ما صَوَّحَ الكَلا","وَغاضَت بَقايا الحَسي وَالمُزنُ أَنجَما",9,"م",2,0],["وَأَسلَمتُمُ حَظَّ الصَليبِ وَقَد رَأَوا","كَتائِبَ قَيسٍ تَستَديرُ عُقابُها",10,"ب",3,0],["وَأَسلَمتُمُ لِاِبنَي أُسَيدَةَ حاجِباً","وَلاقى لَقيطٌ حَتفَهُ فَتَقَطَّرا",11,"ر",2,0],["وَأَسلَمَتِ القَلحاءُ لِلقَومِ مَعبَداً","يُجاذِبُ مَخموساً مِنَ القِدِّ أَسمَرا",11,"ر",2,0],["وَأَسلَمتُم شُعَيثَ بَني مُلَيلٍ","أَصابَ السَيفُ عاتِقَهُ فَمالا",12,"ل",2,0],["واسلمْ على الدهر في نعماءَ سابغةٍ","وارجِعْ مُوقّىً مُلقّىً خيرَ مُنقلَبِ",13,"ب",1,0],["وأسْلافُ صِدق من عَرَانِين مَذْحجٍ","طوَالُ المسَاعِي ليْس فيهِمْ مزنَّدُ",14,"د",1,0],["وأسلفتَ إنذاراً وقدّمت عذْرَةً","لتقويم مُعوَجٍّ وإصلاح فاسدِ",15,"د",1,0],["واسلمْ على حدث الزما","ن وأنت بالحُسنى أثيرُ",16,"ر",1,0],["واسلم على ريب الحوادث ما","سجع الحمام مرجعاً سجعه",17,"ع",2,0],["واسلم أبا إسحاق لابس غبطة","وعِداك للإبعاد والإسحاق",18,"ق",1,0],["واسلمْ سلامَةَ مأمولٍ فواضلهُ","إذا رأوْه لبني الآمال كالقبلِ",19,"ل",1,0],["واسلمْ أبا الصقرِ للإسلام تمنعهُ","منعَ امرئٍ لا يرى إسلامَ إسلامِ",20,"م",1,0],["واسلم لراجيك مَسعوداً وإن تربَتْ","ممَّن يُعاديكَ آنافٌ وأذقان",21,"ن",1,0],["وَأَسلَمَ اِبنُ شُمُشقيقٍ أَلِيَّتَهُ","أَلّا اِنثَنى فَهوَ يَنأى وَهيَ تَبتَسِمُ",22,"م",1,0],["واسلمْ على الأيام تأمُرُها","أبداً بما تهوَى وتمتثلُ",23,"ل",1,0],["وأسلتَ دمعاً في الجفونِ مُعَلَّقَا","وأطرتَ قلباً في الضلوع مزعزعَا",24,"ع",2,0],["وأسلمني للنائباتِ بِعَادُهُ","كما أَسلمَ العظمَ المَهيضَ جبائِرُهْ",25,"ر",2,0],["وَأَسلَمَ مَولاهُ وَخَلَّفَ بَينَهُ","وَنَجّاهُ خِنذيذٌ كَخافِيَةِ النَسرِ",26,"ر",1,0],["وَأَسلى الغَواني عَنهُ مُبيَضُّ فَودِهِ","وَكانَ يُعَنّيهُنَّ مُسوَدُّهُ الوَحفُ",27,"ف",1,0],["وَأَسلَمَهُم وَكانَ كَأُمِّ حِلسٍ","أَقَرَّت بَعدَ نَزوَتِها فَغابا",28,"ب",2,0],["واسلَمْ فقد سَلِمَتْ خِلالُكَ كلُّها","من عُرِّ أخلاقِ اللئيمِ وعارِه",29,"ر",2,0],["وأَسلَمَني الزَمانُ إِلى صَديقٍ","كَثيرِ الغَدرِ لَيسَ لَهُ رَعاءُ",30,"ا",2,0],["وَاِسلُ في دُنياكَ عَمّا اِسطَعتَهُ","وَاِلهُ عَن تَكليفِ ما لَم تَستَطِع",31,"ع",1,0],["وَأَسلَمَكَ اِبنُ عَمِّكَ فيهِ فَرداً","وَأَرسَلَ مِن يَدَيهِ أَخوكَ حَبلَك",32,"ك",1,0],["وَاِسلَم عَلى كَيدِ العِدى","جَذلانَ في عَيشٍ رَغيدِ",33,"د",1,0],["وأسلمني لليلِ كالقبرِ بارداً","يهبُّ على وجهي به نَفَسُ اللحدِ",34,"د",1,0],["وأسلمني للكونِ كالوحشِ راقداً","تمزقني أنيابُه في الدجى وحدي",34,"د",2,0],["وأسْلَمَ للحتْفِ المقدَّرِ نَفْسَهُ","وقد كان لا يرقى إليه بِسُلّمِ",35,"م",1,0],["وَاسلَمْ لِملكِكَ في تَقَاعُسِ عِزَّةٍ","وَأَبِدْ بِسَيفِكَ مَن عَدا واستَكبَرا",36,"ر",2,0],["واسلَمْ لِعِزِّ بني الإِسلامِ ما سَجَعَتْ","سَوامِرُ الطَّيرِ وانآدت بِها السَّمُرُ",37,"ر",1,0],["واسْلَمْ فَإِنَّكَ في الندى مَطَرٌ","يَمحُو المحولَ ولِلهدى وَزَرُ",38,"ر",1,0],["وَاِسلَم أَبا يَحيى لَها مِن دَولَةٍ","كَسَتِ اللَيالي رَونَقَ الأَسحارِ",39,"ر",1,0],["وَاِسلَم بِمُعتَرِكِ الفَوارِسِ وَالظُبى","تَحني قِراعاً وَالعَوالي تُحطَمُ",40,"م",1,0],["وَأَسلَمَتِ الأَيّامُ فيها عَجائِباً","بِمَوتِكُما إِنّي أُحِبُّ رِداكُما",41,"م",2,0],["واسْلُك بها النّهجَ السَّوِيَّ فإنّها","مهما تكن تُقبِلْ عليكَ وتَتْبَعِ",42,"ع",1,0],["وَأَسْلَمَ لا يَرَى للّهِ نِدّاً","تَدينُ له الخلائِقُ والعِبادُ",43,"د",1,0],["واِسلَم تُنيرُ دُجىً وَتُخصِبُ مُجدِباً","وَتُبيدُ جَبّاراً وَتُغني مُقتِرا",44,"ر",2,0],["وَاِسلَم لِكَي تَبقى المَكارِمُ وَالعُلا","وَإِذا سَلِمتَ فَكُلُّ يَومٍ عيدُ",45,"د",1,0],["واسلكُ بهمَّتِكَ السَّبي","لَ ولا تقلْ كيف السَّبيلُ",46,"ل",1,0],["وَأَسلَمَتهُ لِلسُيوفِ وَالقَنا","جُندٌ تَخَلّوا عَنهُ حينَ قَد دَنا",47,"ن",2,0],["واسْلُكْ طَرِيقَ مُحَمَّدِيِّ شَرِيعَةٍ","وَحَقِيقةٍ ومُحَمَّديِّ المَحْتِدِ",48,"د",1,0],["وَاسْلُبْهُمْ نِعَماً قَدْ شاطرُوكَ بِها","كَما يُشاطَرُ فَلاَّحٌ الْفدَادِينِ",49,"ن",1,0],["واسلَمْ لغَضّ شبيبَةٍ ولدولَةٍ","عَزّتْ وعَزّ مؤيَّداً سلطانها",50,"ن",3,0],["وأسْلمتْ صاحبَها مَقهورا","حتى أتى بدرٌ به مَأسُورا",51,"ر",2,0],["وأَسلمُوا حِصْنَهُمُ المَنيعا","وسَمحوا بِخَرجِهم خُضوعا",51,"ع",2,0],["وأَسَلْتُهَا ذَوْبَ الجُفُونِ كَأَنَّهَا","أَيْدِي بَنِي المَنصْور في سَيَلانِهَا",52,"ن",3,0],["وأَسلَمَت رَبَّها بِلَيلَتِها","تَظُنُّ أنَّ الرَّئيسَ خاطِبُها",53,"ب",3,0],["وَاسْلَمْ لَهُ دَهْراً مَدِيداً وَلْيَدُمْ","عُنْوَانَ فَضْلٍ فِي الحِمَى وَكَمَالِ",54,"ل",1,0],["وَاسْلَمِ الدَّهْرَ فَائِزاً بِمَزِيدٍ","فَمزِيدٍ مِنْ سَابِغِ الآلاَءِ",55,"ا",2,0],["وأسلم الزهر أجياداً منضرة","للشوك جفت على دامي أظافره",56,"ر",2,0],["وَأَسلَمُ أَهلِها مِنها فَريدٌ","إِذا اِنبَسَطَت لَهُ اِزدادَ اِنقِباضا",57,"ض",2,0],["واسلَمْ لمصرَ فأنتَ أنتَ فؤادُها","وحياتُها ولُبابُها المتخَيَّر",58,"ر",1,0],["واسلْكي إنْ ضَللْت في الأُفْق يومًا","نهْجَهُ تسلُكين نهجًا رشيدا",59,"د",2,0],["واسلك في السير به منهجا","عن مادح جل وعمن هجا",60,"ج",2,0],["وَاسْلمْ لإِخْوانٍ هُمُ فِي","الفَضْلِ آحَادُ الجُّمُوعِ",61,"ع",1,0],["وأسلَمَني عند جِدِّ الخطوبِ","كأني قلتُ له عادِني",62,"ن",2,0],["وأسَلْتَها وهي التي عَجَزَتْ","عن أن تُسيلَ فوادحَ الغِيَر",63,"ر",1,0],["وأَسْلى الغَوانِي عَنْهُ مُبيضُّ فَوْردهِ","وَكانَ يُغَنَّيهِنَّ مُسْودُّهُ الوَحْفُ",64,"ف",1,0],["واسلبوا ما ترونه من حطام","لكم وحدكم جمعنا الحطاما",65,"م",2,0],["وأسلست الرّيح القياد كأنها","نسيم هفا من شمأل وجنوب",66,"ب",1,0],["واسلمْ أبا الصقرِ للإسلام تمنعهُ","منعَ امرىء ٍ لا يرى إسلامَ إسلام",67,"م",1,0],["وَأَسلَمَت أَهلَها بِلَيأَتِها","تَظُنُّ أَنَّ الرَئيسَ خاطِبُها",68,"ب",3,0],["وَأَسلم عَلى مَر الدُهور مُلاحِظاً","بِالعَون وَالإِسعاد وَالإِسعاف",69,"ف",1,0],["وَاسلم عَلى مَرّ الدُهور مُقبِلاً","أَقدام سَعدِكَ في السَماءِ سَماكُ",70,"ك",1,0],["وَأَسلمني فيكَ الغَرام إِلى الرَدا","فَإِن كُنت مَن يَرضى بِذَلِكَ فَأَسلَم",71,"م",1,0],["وَأَسلَم مَدى الدَهر نَفّاعاً أَخا كَرَم","فَرض عَلى كُلِ مَخلوق مَدائحهُ",72,"ح",2,0],["واسلاك بها افلاذ در","تنظم مع عقود من جمان",73,"ن",1,0],["واسلم ورح امينا","من نوب الايام",74,"م",1,0],["وَاِسلُك سَبيلَ وَصلِهِ وَصُنهُ","إِن كانَ غَدّاراً فَلا تَكُنهُ",75,"ن",2,0],["واسلكن طرقَ المعالي والتقى","وَدَعَنْ ذكرَ المناني والطللْ",76,"ل",1,0],["واسلُ واسترْ واستفدْ وترمَّق","واهدِ وارحمْ وجدْ وزدْ واعزُ وارقَا",77,"ق",2,0],["واسْلَم سَلِمْت مبرَّأً","مِن كل لُؤْمٍ أو فَنَدْ",78,"د",1,0],["واسلمْ سلمتَ سلامةً محروسةً","في حصن بهلا في النعيم مُخلَّدَاً",79,"د",2,0],["وأسلمَ مما أثلثهُ جُدودهُ","نجومَ قِلاعٍ تزحَمُ الأنجمَ الزُّهرا",80,"ر",2,0],["واسلُ الأغاني والغوا","ني واسأل الرحمن عدنا",81,"ن",2,0],["وَاِسلَم لِمَعروفٍ رَفَعتَ مَنارَهُ","فَفَشا بِأَرضِكَ مُذ قَمَعتَ المُنكَرا",82,"ر",2,0],["وَاِسلَم عَلى الأَيّامِ أَزكى صائِمٍ","صَوماً وَأَسعَدَ مُفطِرٍ إِفطارا",83,"ر",2,0],["وَاِسلَم وَلا زالَتِ الأَعيادُ عائِدَةً","وَالعِزُّ مُقتَبَلٌ وَالظِلُّ مُنسَدِلُ",84,"ل",1,0],["واسلك طريق رضاهم واحذر من","الإعراض فالاعراض شر حجاب",85,"ب",1,0],["وَأَسلَمَني للبَينِ حُكمٌ جَرى بِهِ","فَقَلبي لا يَنفَكُّ نَضوَ اِضطِرابِهِ",86,"ه",1,0],["واسلم ودم أنل ولا تنقص وزن","حبته من خردل وذر",87,"ر",1,0],["وَاِسلَم وَدُم في نَعيمٍ شامِلٍ وَعُلاً","ما دامَ لِلعَيشِ بِالوَعساءِ إِرقالُ",88,"ل",1,0],["وَأَسلَمَني الشَقاءُ إِلى زَمانٍ","مَصائِبُهُ كَما اِنهَلَّ الغَمامُ",89,"م",1,0],["واسلُ الكُؤوسَ يُديرُها","رَشأٌ كَغُصنِ البانِ مائِسْ",90,"س",1,0],["واسلمني الأدنى وأوسعني الردى","زمان بكرّ النائبات بصير",91,"ر",1,0],["وَأسلمُ الأمرِ تسليمٌ يُجانِبهُ","مَعنى الحدوث كما يرضى الإله بهِ",92,"ب",2,0],["واسلكوا ما سلكت إخوتكم","أنمر النيل وآساد الهرم",93,"م",1,0],["واسلم وعش عمرا طويلا بلا","مضارع في فرح كامل",94,"ل",1,0],["وأسلم اللوم تلحاني قوارصهُ","إسراف لاه طروب الروح جذلان",95,"ن",1,0],["وأسْلُكُ نَهْجَ السالفينَ قريضَهم","ولي مِن بقايا الجاهليةِ عَجْرَفُ",96,"ف",1,0],["واسلم بنفسك إنني لك ناصح","وسل الخبير بها ودع خطط الخطر",97,"ر",1,0],["وَاِسلَخ فُضولَ النَهار","مِن بَعضِهِ الباقي",98,"ي",1,0],["وَاِسلَموا تُنجِزونَ أَعداءَكُم ما","رَضِعَ الطِفلُ وَاِستَهَلَّ الجَنينُ",99,"ن",1,0],["وَاِسلَم تَدومُ لَكَ النُعمى فَإِنَّكَ ما","سَلِمتَ في جَذَلٍ فَالدَهرُ جَذلانُ",100,"ن",1,0],["وَأَسلَّمَني الزَمانُ إِلى هُمومٍ","يَشيبُ لِحَملِ أَيسَرِها الغُرابُ",101,"ب",1,0],["وَأَسْلَمَنِي لِلتَّوَى شَادِنٌ","يَخُُّد فُؤَادِي بِخَدٍّ أَسِيلْ",102,"ل",1,0],["واسلم عَلى رُغمِ الحَسودِ مُخلَّداً","في حالِ عِزٍّ مالَها تَحويلُ",103,"ل",1,0],["واسلك به مسالكَ الفضائلِ","واجنبهُ فضلاً مسلك الرذائلِ",104,"ل",1,0],["واسلم فدهرك لا يزال مسالما","من أم بابك مسلماً ومسلما",105,"م",2,0],["واسلم فوعدك من وعيد صروفه","مغنى الغنى والمأمن المنحاز",106,"ز",1,0],["واسلم ودم انسان ناظر دهرنا","دهراً ومدحك موقه والأثمد",107,"د",1,0],["واسلم فأنت حيا بوجه زماننا","وبوجنتي شهبائنا توريد",108,"د",1,0],["واسلم الدهر على اعياده","خيرى مستجدى واندي مسماح",109,"ح",1,0],["واسلم الدهر فما يشكى الصدى","ومرائيك تجلت عن صداء",110,"ا",2,0],["وأسِل لُجينَكَ للتُرابِ مُفَضَّضاً","فطلاوَةُ الأشياء حُسنُ طلاء",111,"ا",2,0],["وأَسْلَمَ دُنْيَا النَّاسِ للنَّاسِ غانِما","مِن الدِّينِ في الدّارَيْنِ أُنْسَ المَغَارِمِ",112,"م",1,0],["وأَسْلمَها الجيشُ العَرَمرَمُ للرَّدى","كأن لَم تكُن أحْمَى مِن النجمِ الزُّهرِ",113,"ر",1,0],["واسلَمْ على طول الزَّما","ن لكلّ ذي أمل قصيرِ",114,"ر",1,0],["وَاسْلَمْ عَلَى الأَيّامِ تَكبِتُ حاسِداً","وَتُذِلُّ أَعْداءً وَتَبْلُغُ سُولا",115,"ل",2,0],["وَأَسلَمَنا إِلى زَمَنٍ غَشومٍ","ظَلومٍ فَاِشتَفى الحُسّادُ مِنّا",116,"ن",2,0],["واِسلُك بحيث سَلكوا","واِبذل لهم ما تملكُ",117,"ك",1,0],["واِسلم على مرِّ اللَيالي راتعاً","في طيبِ عيشٍ طيِّب الأَنفاسِ",118,"س",1,0],["واِسلم مدى الأَيّام مُرتَقياً","رُتباً يضيق لعدِّها الحصرُ",119,"ر",1,0],["وَاِسلَم ودُم في نِعمَةٍ","غرّاءَ في دارِ السُرورِ",120,"ر",1,0],["واِسلم ودُم راقياً في عزَّةٍ رُتباً","من دونها أَنفسُ الأَعداءِ مُنقهِرَه",121,"ر",2,0],["واِسلم على دَرَج المَعالي راقياً","بأَجلِّ أَخبارٍ وأَصدَقِ مخبَرِ",122,"ر",1,0],["واِسلم ودُم في نعمةٍ طولَ المدى","تَختالُ من أَبرادِها بقَشيبها",123,"ب",3,0],["وَأسلمني دهري لكلِّ ملمَّة","وَأنكرني صحي وأَدنى أَقاربي",124,"ب",2,0],["وَأسلس لي بعد الجموح قيادُها","أصرِّفُه ما شئت بالبسط والقبض",125,"ض",1,0],["وَاِسلَم بِراووقٍ حُبيتَ بِهِ","وَاِنعِم صَباحاً أَيُّها الجَبرُ",126,"ر",1,0],["وَاِسلُك سَبيلاً إِلى الرَحمَنِ قيمَةً","بِها أَتاكَ أَمام البَدوِ وَالحَضَرِ",127,"ر",1,0],["وَاِسلم وَدم دهراً فكلّ فضيلةٍ","مَهما سلمتَ وَدمت فينا تسلمِ",128,"م",1,0],["وَأَسلمتُ نَفسي في يديهِ فَلِم غَدا","يُقاتلُ بِالألحاظِ مَن لا يُقاتِله",129,"ل",2,0],["وَاِسلَم وَدُم يا أمير المِؤمنين لنا","دَهراً محاطاً بِحفظ الواحد الأزلي",130,"ل",2,0],["وَاِسلم وَدم بين أبناءٍ وحاشيةٍ","مُمتّعينَ بكم ما مرّت الحقبُ",131,"ب",1,0],["وَأَسلُبُ العَجزَ وَالتَخطيطِ حَيثُ بَدا","مِنهُ لِإِظهارِ ما أَبدا مِنَ القَدَرِ",132,"ر",1,0],["وَاِسلَم لِسَيفِ الوَقتِ تَغدُ مُسَلِّماً","وَلَمّا تُؤَمِّلُ مِن زَمانِكَ مُدرَكا",133,"ك",2,0],["وَاِسلَم كَإِسلامي لَها تَسلَم بِها","في قَصدِها مِنَ العَناءِ وَالكَلَل",134,"ل",1,0],["وَاِسلُك سَبيلي في هَواها نَحوَها","وَلا تَمَل دونَ الحِمى إِلى الطَلَل",134,"ل",1,0],["وَاِسلم وَدُم لِيُرى لِعزّك في الوَرى","نَصرٌ عَزيزٌ لا يَزال مُبينا",135,"ن",2,0],["وَاِسلك طَريق الهُدى إِلَيهِ فَقَد","أَحياهُ ذو الفَضل أَوحَد الكبرا",136,"ر",2,0],["وَاِسلم وَدُم شَمسَ عِزٍّ لا مَغيبَ لَها","يا مَن مَتى تَلقه شَمسُ الضُحى تَغبِ",137,"ب",1,0],["وَأسلَم أمينَ اللهِ تَصدَعُ بِالهُدى","وَتَلِي بِحَدِّ السَّيفِ كُ