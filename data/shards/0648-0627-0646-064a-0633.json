{"poems":[[55,"سننت لهذا الرمح غربا مذلقا","https://www.aldiwan.net/poem29931.html","الطويل"],[9,"لعمرك ما طول هذا الزمن","https://www.aldiwan.net/poem21986.html","المتقارب"],[75,"ألا هل درى الداعي المثوب إذ دعا","https://www.aldiwan.net/poem11947.html","الطويل"],[90,"لا يبلغ المرء منتهى أربه","https://www.aldiwan.net/poem45001.html","المنسرح"],[49,"أبى غرب هذا الدمع إلا تسرعا","https://www.aldiwan.net/poem25234.html","الطويل"],[91,"لقد كان سعد خير قوم مجاهد","https://www.aldiwan.net/poem44614.html","الطويل"],[47,"سلاها كيف ضيعت الوصالا","https://www.aldiwan.net/poem65574.html","البسيط"],[33,"أقل الملام يا عتيق فإنني","https://www.aldiwan.net/poem41820.html","الطويل"],[69,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85589","المتقارب"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55271","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[92,"الوطن والشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179071",""],[127,"لقد بت أمس كما بت أنت","https://www.aldiwan.net/poem23766.html","المتقارب"],[234,"سبح لربك في الظلام الداجي","https://www.aldiwan.net/poem44595.html","الكامل"],[257,"سراب","https://www.aldiwan.net/poem24957.html","مجزوء الرمل"],[264,"قسما هذه القوافي الحسان","https://www.aldiwan.net/poem38167.html","الخفيف"],[283,"أما وعتاق العيس لو وجدت وجدي","https://www.aldiwan.net/poem60687.html","الطويل"],[307,"قد كفاني علم ربي","https://www.aldiwan.net/poem16762.html","مجزوء الرمل"],[307,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[308,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[308,"يا قرة العين وقيت الأسى","https://www.aldiwan.net/poem56504.html","السريع"],[406,"جاء يهدي نحوي بديع النظام","https://www.aldiwan.net/poem33414.html","الخفيف"],[412,"أيا غائبا يدنيه شوقي على النوى","https://www.aldiwan.net/poem32328.html","الطويل"],[419,"سقى الطلل الغمام وجاد رسما","https://www.aldiwan.net/poem54028.html","الوافر"],[442,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[463,"أمنع الأحياء بأسا وحمى","https://www.aldiwan.net/poem15489.html","الرمل"],[463,"تمنى مقامي من تميم كليبها","https://www.aldiwan.net/poem15669.html","الطويل"],[463,"تأففت بالأيام ثم حمدتها","https://www.aldiwan.net/poem16250.html","الطويل"],[466,"ألمت نع الظلماء يهدى سلامها","https://www.aldiwan.net/poem3195.html","عموديه"],[481,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[497,"رعاك الله من شرفات دار","https://www.aldiwan.net/poem9861.html","الوافر"],[571,"رب أمور قد بريت لحاءها","https://www.aldiwan.net/poem52036.html","الطويل"],[1080,"","https://poetry.dctabudhabi.ae/diwan/poem/2522","الوافر"],[1103,"","https://poetry.dctabudhabi.ae/diwan/poem/20879","المنسرح"]],"verses":[["وَإِن يَسعَ في الأَمرِ العَظيمِ فَإِنَّما","سَعى لَكَ في ذاكَ الطَريقِ مُطَرِّقا",0,"ق",2,0],["وَإِن يُستَضافوا إِلى حُكمِهِ","يُضافُ إِلى هادِنٍ قَد رَزَن",1,"ن",1,0],["وَإِن يَسَلِ العافونَ جَدواكَ يُعطِهِم","جَوادٌ إِذا لَم يَسأَلوهُ تَبَرَّعا",2,"ع",2,0],["وأن يَسُد جاهل فسؤدده","بعد قليل يُفضي إلى عَطَبه",3,"ب",2,0],["وَإِن يَستَجِدَّ الناسَ بَعدي فَلا يَزَل","بِذاكَ البَديلِ المُستَجَدِّ مُمَتَّعا",4,"ع",2,0],["وإني سأودي مثل غيري فتنتهي","على الأرض أو طاري وكل مقاصدي",5,"د",2,0],["وَإِن يَسَّرتَ لِلمَعروفِ قَولاً","فَإِنَّكَ تُتبَعُ القَولَ الفَعالا",6,"ل",2,0],["وَأَنّى سُلُوُّ القَلبِ عَنها وَقَد سَبا","فُؤادِيَ مِنها ذو غَدائِرَ فاحِمُ",7,"م",1,0],["وإن يَسبِقُوا لِلبَابِ دوني فإنّهم","بما صَنَعُوا بالنّاسِ أَحرَى وأَجدَرُ",8,"ر",1,0],["وإني سأذكرها شاكراً","أَيادي منكم عليّ جساما",9,"م",2,0],["وإنْ يُسكَّنْ سابعُ الحُروفِ","فإِنّه يُعرفُ بالمَوْقوفِ",10,"ف",1,0],["وَأَنْ يَسِيرَ الاجتِ","مَاعُ فِي الطَّرِيقِ الأقوَمِ",11,"م",1,0],["وَأَنْ يَسْبُّوا سائِقِيهِمْ إلى","مَا حَضَرُوا مِن رَائِعِ الْمَحْضَرِ",12,"ر",1,0],["وأن يسعى ليصلحها شعوباً","بنوها أوسعت فيها فسادا",13,"د",2,0],["وإني سعيد بما قد لقيت","وإني شقي لأَوري زناد",14,"د",1,0],["وأنيسه في الغار عند تتبع ال","أعداء بالطلبات والإرهاج",15,"ج",1,0],["وأنيسُ الروحِ أبدى","لي نفوراً في انقلابِ",16,"ب",1,0],["وأنيسي مع المهولات فيها","سابح أجرد أقب حصان",17,"ن",1,0],["وَأَنْ يَسَعَ الأَمْرَ الَّذِي حَرِجَتْ بِهِ","مَذاهِبُ خَطِيِّ الْقَنا وَظُبى الْهِنْدِ",18,"د",1,0],["وَأَنيسي وَجَليسي","طولَ لَيلي وَنَهاري",19,"ي",1,0],["وأن يستقيم الحق والدين فيهما","وتحيا من الإسلام كل الدوائر",20,"ر",1,0],["وَأَن يَسوق لَه من فيض رحمتهِ","سُحباً تدرُّ بِها الأخلاف والديمُ",21,"م",1,0],["وَإن يَستَعِن بكَ من قصدهِ","إِحياءُ علمٍ كادَ أَن يدرُسا",22,"س",2,0],["وإني سائلاً بسيال ذهن","لذكاه في العلم أي اضطرام",23,"م",1,0],["وأنّي سِآوِى من حِماهُ إلى حِمىً","يُرَى كلّ خَطبٍ دونَه يَتَذَبْذَبُ",24,"ب",1,0],["وإنِّي سوف أركبها لآمرٍ","أُحاول شأوه إمَّا وإمَّا",25,"م",2,0],["وأن يَسمعوا من ضَيْفِهِ فِي ثَنائِهِ","غَرَائِبَ حَلّى من جَوَاهِرِها الدُّنْيا",26,"ي",2,0],["وأنيسٌ بالعُلى مُسْترسلٌ","فاذا العارُ دَنا كانَ نَوارا",27,"ر",2,0],["وأِني سأجْزيهِ بغُرِّ مَحامدٍ","سوالِمَ من عيبِ الكلام كَرائمِ",28,"م",1,0],["وإِني سأجْزيهِ بكلِّ غَريبَةٍ","مُعَمَّرَةٍ الرَّاوينَ خالِدَةِ النَّقْلِ",29,"ل",1,0],["وإن يسمَ خلقاً غيرهُ قبلُ صاحباً","فقد عدَّ من سحب السماءِ جهامها",30,"م",3,0],["وأنيسها في رمسها","تحنو عليه الأضلع",31,"ع",1,0],["وإن يسطع بأرض الخيف نوري","فقد ضاءت بأرض الضيف ناري",32,"ر",2,0],["وإِنّي سألقى اللَه لَم ارم حرّة","وَلَم تتمنَّ يومَ سرِّ فخنتها",33,"ت",3,0],["وَإِنّي سَوفَ أَحكُمُ غَيرَ عادٍ","وَلا قَذِعٍ إِذا اِلتُمِسَ الجَوابُ",34,"ب",1,0],["وإني سوف أبتدي لكما","يا صاحبي الغداة فاستمعا",35,"ع",2,0]]}