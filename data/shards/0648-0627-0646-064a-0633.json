{"poems":[[55,"سننت لهذا الرمح غربا مذلقا","https://www.aldiwan.net/poem29931.html","الطويل"],[9,"لعمرك ما طول هذا الزمن","https://www.aldiwan.net/poem21986.html","المتقارب"],[75,"ألا هل درى الداعي المثوب إذ دعا","https://www.aldiwan.net/poem11947.html","الطويل"],[90,"لا يبلغ المرء منتهى أربه","https://www.aldiwan.net/poem45001.html","المنسرح"],[49,"أبى غرب هذا الدمع إلا تسرعا","https://www.aldiwan.net/poem25234.html","الطويل"],[91,"لقد كان سعد خير قوم مجاهد","https://www.aldiwan.net/poem44614.html","الطويل"],[47,"سلاها كيف ضيعت الوصالا","https://www.aldiwan.net/poem65574.html","البسيط"],[33,"أقل الملام يا عتيق فإنني","https://www.aldiwan.net/poem41820.html","الطويل"],[69,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85589","المتقارب"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55271","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[92,"الوطن والشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179071",""],[128,"لقد بت أمس كما بت أنت","https://www.aldiwan.net/poem23766.html","المتقارب"],[236,"سبح لربك في الظلام الداجي","https://www.aldiwan.net/poem44595.html","الكامل"],[259,"سراب","https://www.aldiwan.net/poem24957.html","مجزوء الرمل"],[266,"قسما هذه القوافي الحسان","https://www.aldiwan.net/poem38167.html","الخفيف"],[285,"أما وعتاق العيس لو وجدت وجدي","https://www.aldiwan.net/poem60687.html","الطويل"],[309,"قد كفاني علم ربي","https://www.aldiwan.net/poem16762.html","مجزوء الرمل"],[309,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[310,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[310,"يا قرة العين وقيت الأسى","https://www.aldiwan.net/poem56504.html","السريع"],[409,"جاء يهدي نحوي بديع النظام","https://www.aldiwan.net/poem33414.html","الخفيف"],[415,"أيا غائبا يدنيه شوقي على النوى","https://www.aldiwan.net/poem32328.html","الطويل"],[422,"سقى الطلل الغمام وجاد رسما","https://www.aldiwan.net/poem54028.html","الوافر"],[445,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[466,"أمنع الأحياء بأسا وحمى","https://www.aldiwan.net/poem15489.html","الرمل"],[466,"تمنى مقامي من تميم كليبها","https://www.aldiwan.net/poem15669.html","الطويل"],[466,"تأففت بالأيام ثم حمدتها","https://www.aldiwan.net/poem16250.html","الطويل"],[469,"ألمت نع الظلماء يهدى سلامها","https://www.aldiwan.net/poem3195.html","عموديه"],[484,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[500,"رعاك الله من شرفات دار","https://www.aldiwan.net/poem9861.html","الوافر"],[574,"رب أمور قد بريت لحاءها","https://www.aldiwan.net/poem52036.html","الطويل"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107232","الوافر"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82791","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126806","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48792","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48773","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38228","الطويل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90547","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145811","الوافر"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124610","الوافر"],[287,"","https://poetry.dctabudhabi.ae/diwan/poem/69875","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56214","الرمل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78162","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108696","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96271","الطويل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114772","الطويل"],[1993,"","https://poetry.dctabudhabi.ae/diwan/poem/199033","الطويل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123176","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27426","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27428","الخفيف"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65974","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58285","المنسرح"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58255","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204985","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86313","الطويل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61282","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45767","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91126","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91283","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91608","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114147","المتقارب"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114593","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114105","الطويل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2522","الوافر"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139394",""],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20879","المنسرح"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90863","الكامل"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111187","الرمل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135091","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72823","الطويل"],[4775,"سأقسم يوما","https://www.poetsgate.com/ViewPoem.aspx?id=175771",""],[4859,"قواعد الاِصطبار","https://www.poetsgate.com/ViewPoem.aspx?id=195288",""],[4908,"وللأحْزَانِ في مَهْدِ الخَيَالِ","https://www.poetsgate.com/ViewPoem.aspx?id=211480",""],[5038,"كم قريب","https://www.poetsgate.com/ViewPoem.aspx?id=189379",""],[592,"ألا أيها الباغي طريقاً إلى الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128716",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5376,"وقامت أُخيَّة تلقي السلام......من حماه","https://www.poetsgate.com/ViewPoem.aspx?id=188421",""],[5411,"دُروب السَّالِكين","https://www.poetsgate.com/ViewPoem.aspx?id=185377",""],[5596,"أستودع الله من أزرى به الوجل","https://www.poetsgate.com/ViewPoem.aspx?id=206690",""],[5638,"غزة.. لا تخرُّ مع الساجدين","https://www.poetsgate.com/ViewPoem.aspx?id=198036",""],[5670,"أُحاذر أن يشتَمَّ قلبي عبيرَها","https://www.poetsgate.com/ViewPoem.aspx?id=215260",""],[2220,"إن قلبي وخاطري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11397&r=&rc=271",""],[6305,"وَشَيْطانٍ يُقاسِمُني نَصِيبي !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87329&r=&rc=2",""]],"verses":[["وَإِن يَسعَ في الأَمرِ العَظيمِ فَإِنَّما","سَعى لَكَ في ذاكَ الطَريقِ مُطَرِّقا",0,"ق",2,0],["وَإِن يُستَضافوا إِلى حُكمِهِ","يُضافُ إِلى هادِنٍ قَد رَزَن",1,"ن",1,0],["وَإِن يَسَلِ العافونَ جَدواكَ يُعطِهِم","جَوادٌ إِذا لَم يَسأَلوهُ تَبَرَّعا",2,"ع",2,0],["وأن يَسُد جاهل فسؤدده","بعد قليل يُفضي إلى عَطَبه",3,"ب",2,0],["وَإِن يَستَجِدَّ الناسَ بَعدي فَلا يَزَل","بِذاكَ البَديلِ المُستَجَدِّ مُمَتَّعا",4,"ع",2,0],["وإني سأودي مثل غيري فتنتهي","على الأرض أو طاري وكل مقاصدي",5,"د",2,0],["وَإِن يَسَّرتَ لِلمَعروفِ قَولاً","فَإِنَّكَ تُتبَعُ القَولَ الفَعالا",6,"ل",2,0],["وَأَنّى سُلُوُّ القَلبِ عَنها وَقَد سَبا","فُؤادِيَ مِنها ذو غَدائِرَ فاحِمُ",7,"م",1,0],["وإن يَسبِقُوا لِلبَابِ دوني فإنّهم","بما صَنَعُوا بالنّاسِ أَحرَى وأَجدَرُ",8,"ر",1,0],["وإني سأذكرها شاكراً","أَيادي منكم عليّ جساما",9,"م",2,0],["وإنْ يُسكَّنْ سابعُ الحُروفِ","فإِنّه يُعرفُ بالمَوْقوفِ",10,"ف",1,0],["وَأَنْ يَسِيرَ الاجتِ","مَاعُ فِي الطَّرِيقِ الأقوَمِ",11,"م",1,0],["وَأَنْ يَسْبُّوا سائِقِيهِمْ إلى","مَا حَضَرُوا مِن رَائِعِ الْمَحْضَرِ",12,"ر",1,0],["وأن يسعى ليصلحها شعوباً","بنوها أوسعت فيها فسادا",13,"د",2,0],["وإني سعيد بما قد لقيت","وإني شقي لأَوري زناد",14,"د",1,0],["وأنيسه في الغار عند تتبع ال","أعداء بالطلبات والإرهاج",15,"ج",1,0],["وأنيسُ الروحِ أبدى","لي نفوراً في انقلابِ",16,"ب",1,0],["وأنيسي مع المهولات فيها","سابح أجرد أقب حصان",17,"ن",1,0],["وَأَنْ يَسَعَ الأَمْرَ الَّذِي حَرِجَتْ بِهِ","مَذاهِبُ خَطِيِّ الْقَنا وَظُبى الْهِنْدِ",18,"د",1,0],["وَأَنيسي وَجَليسي","طولَ لَيلي وَنَهاري",19,"ي",1,0],["وأن يستقيم الحق والدين فيهما","وتحيا من الإسلام كل الدوائر",20,"ر",1,0],["وَأَن يَسوق لَه من فيض رحمتهِ","سُحباً تدرُّ بِها الأخلاف والديمُ",21,"م",1,0],["وَإن يَستَعِن بكَ من قصدهِ","إِحياءُ علمٍ كادَ أَن يدرُسا",22,"س",2,0],["وإني سائلاً بسيال ذهن","لذكاه في العلم أي اضطرام",23,"م",1,0],["وأنّي سِآوِى من حِماهُ إلى حِمىً","يُرَى كلّ خَطبٍ دونَه يَتَذَبْذَبُ",24,"ب",1,0],["وإنِّي سوف أركبها لآمرٍ","أُحاول شأوه إمَّا وإمَّا",25,"م",2,0],["وأن يَسمعوا من ضَيْفِهِ فِي ثَنائِهِ","غَرَائِبَ حَلّى من جَوَاهِرِها الدُّنْيا",26,"ي",2,0],["وأنيسٌ بالعُلى مُسْترسلٌ","فاذا العارُ دَنا كانَ نَوارا",27,"ر",2,0],["وأِني سأجْزيهِ بغُرِّ مَحامدٍ","سوالِمَ من عيبِ الكلام كَرائمِ",28,"م",1,0],["وإِني سأجْزيهِ بكلِّ غَريبَةٍ","مُعَمَّرَةٍ الرَّاوينَ خالِدَةِ النَّقْلِ",29,"ل",1,0],["وإن يسمَ خلقاً غيرهُ قبلُ صاحباً","فقد عدَّ من سحب السماءِ جهامها",30,"م",3,0],["وأنيسها في رمسها","تحنو عليه الأضلع",31,"ع",1,0],["وإن يسطع بأرض الخيف نوري","فقد ضاءت بأرض الضيف ناري",32,"ر",2,0],["وإِنّي سألقى اللَه لَم ارم حرّة","وَلَم تتمنَّ يومَ سرِّ فخنتها",33,"ت",3,0],["وإنّي سادَتي لكُمُ ومِنكُم","خذُوا بيدِي تَرَوا حسنَ انقِيادِي",34,"د",2,0],["وَأَني سَلكتم فَاِجعَلوا مَصر قُبلة","وَحَول عُلاها المُلتَقى وَالتَجَمُع",35,"ع",1,0],["وأن يَستَعيدوا بالصوارمِ مجدهم","وأن يَقطعوا ممّن يُحاربهم عرقا",36,"ق",2,0],["وإني سجلُّ الطيبات أعدها","مخلدة والشاعر المترنم",37,"م",1,0],["وأن يسعى لك الجبار طوعاً","وكم لاقيت منه ما يؤود",38,"د",1,0],["وَإِنْ يَسقِني ماءَ الحَياةِ بِثَغرِهِ","وَمِتُّ بِهِ وَجْداً فَلا تَتَعجَّبوا",39,"ب",3,0],["وإنيَ ساعٍ في رضاها مُسارِعٌ","أطارحُ بالإِخبارِ عنها مُسامري",40,"ر",2,0],["وأنْ يستمكن َالأقزامُ","فوقَ ثراك َوالدَرَنُ",41,"ن",1,0],["وان يسد الجحاجح في إباء","فنسخةُ من يسوس ومن يسود",42,"د",1,0],["وَإِنّي سَوفَ أُدرِكُ في مَعادي","بِمَدحِ بَني رَسولِ اللَهِ سولا",43,"ل",2,0],["وأنيس الروض في الفن العجيب","إذ تغنّى بسّم السن فصاحْ",44,"ح",1,0],["وَأَنيس الرَوض غَنّى","وَالبَلابل لِلصَباح",45,"ح",1,0],["وأن يساوي به بين العباد فلا","يلامس الصفو في أيامه الكدر",46,"ر",1,0],["وإن يستغيثوه يغاثوا وإنما","بذي لهب يشوي الوجوه محرق",47,"ق",1,0],["وإن يسخط الأيام بالجمع بيننا","ويرضي المنى حتى يرينيه سالما",48,"م",2,0],["وإن يَسمُ نحو الأبلَقِ الفَردِ يُملَكِ","وأيُّ مَرامٍ رامَهُ يَتَصَعَّبُ",49,"ب",1,0],["وإن يستدل الشيخ في كل مسكر","حرام فقول الشيخ بالسكر باطل",50,"ل",1,0],["وإني سأبدي بعضَ ما قد علمته","ليعلم أني من ذوي اللم والحجى",51,"ا",1,0],["وأنيسي الذي أرا","ه أنيسي مجالسي",52,"س",2,0],["وأنيسي مَن يعمر الس","يِّد لا يعمر القُرى",53,"ر",2,0],["وأن يستخفوا بالاله ورسله","معاً والكرام الكاتبين الملائك",54,"ك",1,0],["وإن يُسَيّسُهُ الغلامُ يحتك","بالحيطان حتى كنْ لم يَسسِ",55,"س",1,0],["وأنيسةٍ وشّى نَهارَ أديمِها","ليل نجومُ ظَلامه العينانِ",56,"ن",1,0],["وأنَّى سرت أو سافرت أسمع","قريضي سابقا لحضور ذاتي",57,"ت",2,0],["وَاِن يَسمَعوا شَرّاً اِذاعوه جهدَهُم","وَزادوا بِبُهتان عَلى رَقمه صِفرا",58,"ر",2,0],["وَأَنيسُهُ في الغارِ وَالفادي لَهُ","بِالنَفس حينَ يَجوسُهُ وَيَمهِّدُ",59,"د",1,0],["وَإِن يَسر المَولى سَعيت إِلى الصَفا","وَإِن مَنَّ بِالتَوفيق زُرتُ محمدا",60,"د",2,0],["وَإِني سدتهم شهماً فشهماً","وَذل لعزتي جبار عَصري",61,"ر",2,0],["وَإِني سَوف أَدفعه بحزم","يَردّ جماحه مَهما تَعالى",62,"ل",2,0],["وَإِن يسالمك دَهرٌ كُن بِهِ حذراً","وَإِن يحاربك صَرفُ الدَهرِ لا تَطش",63,"ش",1,0],["وَإِن يَستَعِذهَا تُعِذهُ وَعَادَت","لَهُ نَارُ عادٍ سَلاَماً وَبَردَا",64,"د",2,0],["وأنيسٌ من مَسَّهُ من سواهُ","قال أح أح دعني لخلِّي أح أح",65,"ح",1,0],["وَإِن يَستَبِن فِي العَينِ مِنَّا انتِقَاصُكُم","فَلَيسَ بِعَيبٍ انتِقَاصُ أهِلَّةِ",66,"ل",2,0],["وَإِنّي سَوفَ أَحكُمُ غَيرَ عادٍ","وَلا قَذِعٍ إِذا اِلتُمِسَ الجَوابُ",67,"ب",1,0],["وإن يسقك اليوم من آجنٍ","صرى لا يذاقُ ولا يزدرد",68,"د",1,0],["وإني سوف أبتدي لكما","يا صاحبي الغداة فاستمعا",69,"ع",2,0],["وأنيسة لم أنس مسعاما وقد","سعت السعود بأسعد الأوقات",70,"ت",1,0],["وانيس الموحش الثا","وي عرته الموحشات",71,"ت",1,0],["وإني سحاب بالوفا لاحبتي","وهيهات مثلي مات أهل الوفا بعدي",72,"د",2,0],["وإني سديدُ الراي بالعلم عاملٌ","وإني شديدُ الحزمِ بالبأسِ باسلُ",73,"ل",1,0],["وأني سأصرخ في كل يوم","وأجهر صوتا بشعب أصم",74,"م",1,0],["وأنِيسي بوحدتِي ذكرياتٌ","وطيوفُ الهوى بليليْ دثاري",75,"ر",2,0],["وإنْ يسألْ غريبٌ عن بلادي","سأخبرهٌ: فَسَادٌ في انْحِلالِ",76,"ل",1,0],["وأنيسٍ رابهُ سمري","كالحا يبدو لمبْتسمي",77,"م",2,0],["وأن يستغيث المشركون بغيره","تعالى عن الإشراك والجعل للند",78,"د",1,0],["وإن يستر الذنب الذي يجهلونه","ويعلمه مني وقد كان في الأزل",79,"ل",1,0],["وأن يسكتوا إذا كان في الصمت راحة","ولو كان يدري ما هذي وتكلما",80,"م",2,0],["وأني سعيد بيومٍ تراءى","عرفت الأخلة ناسا كرامْ",81,"م",1,0],["وإنّي سَمِعْتُ الذِّكْرَ في رُجُمِ المَلا","وَفيهِ مِنَ السَّبْعِ الْطباق شُرُوحُ",82,"ح",1,0],["وأن يسدد خطواً يرتضيه لنا","فالخير فيما ارتضاه جلّ يكتمل",83,"ل",1,0],["وَأَنِّي سَجَدْتُ لِرَبٍّ رَحِيمٍ","فَكَيْفَ أَخِرُّ مَعَ السَّاجِدِينْ؟!",84,"ن",1,0],["‏وأن يُستَبى شعري لجيش دلالها","‏فما يهتدي في غيرها لمقالِ",85,"ل",1,0],["وأنيسي مَن يعمر الس","بيدَ لا يعمرُ القرى",86,"ر",2,0],["وأنِّي ساكنٌ دارَ المعالي","وقد أسكنتُها كلَّ القلوب",87,"ب",1,0]]}