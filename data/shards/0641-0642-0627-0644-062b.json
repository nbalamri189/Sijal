{"poems":[[9,"شريح لا تتركني بعدما علقت","https://www.aldiwan.net/poem21933.html","البسيط"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130838",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94240","المجتث"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91700","البسيط"]],"verses":[["فَقالَ ثُكلٌ وَغَدرٌ أَنتَ بَينَهُما","فَاِختَر وَما فيهِما حَظٌّ لِمُختارِ",0,"ر",1,0],["فقال ثلاثة رفعت عمادي","ونلت بها ذرى المجد المكين",1,"ن",1,0],["فقال ثغر الأقاحي","يا خدمه لا تعارض",2,"ض",1,0],["فَقالَ ثق بِالَّذي أَمضى بنا وَقَضى","وَاذكر ففي يوسفِ الصدّيق معتبر",3,"ر",1,0]]}