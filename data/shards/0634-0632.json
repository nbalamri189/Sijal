{"poems":[[65,"رنا وناظره بالسحر مكتحل","https://www.aldiwan.net/poem46198.html","البسيط"],[4,"درس المنا بمتالع فأبان","https://www.aldiwan.net/poem21206.html","الكامل"],[15,"يا خليلي اربعا واستخبرا المنزل","https://www.aldiwan.net/poem45251.html","الرمل"],[190,"جيران بيتي كنت آملهم","https://www.aldiwan.net/poem43970.html","الكامل"],[199,"شطت بجارتك النوى فتحمل","https://www.aldiwan.net/poem54423.html","الكامل"],[362,"ما عسى تبلغ شكراً ما عسى","https://www.aldiwan.net/poem4166.html","الرمل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122609","الخفيف"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119608","الرمل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66156","الرمل"],[5651,"سفرَتْ فقال أدلّةُ السّفْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=107008",""]],"verses":[["شَزْرُ المَريرَةِ سَبّاقٌ إِلى أمَدٍ","يَزْوَرُّ عنْ شَأوِهِ الهَيّابَةُ الوَكَلُ",0,"ل",1,0],["شَزَراً عَلى نَبضِ القُلوبِ وَمُقدِماً","فَكَأَنَّما يَختَلُّها بِسِنانِ",1,"ن",1,0],["شُزَّباً يَغشَينَ مِن مَجهولَةِ ال","أَرضِ وَعثاً مِن سُهولٍ وَجِبالِ",2,"ل",1,0],["شزر العيون إذا دعوتهم","عند الصريخ حسدت في العدد",3,"د",1,0],["شُزَّبٌ ذوابِلُ يَتَقينَ لَبانَهُ","وَجَبينَهُ بِسنابِكٍ كَالجَندَلِ",4,"ل",1,0],["شُزّباً قُدتَ صَحيحَاتِ الشَّوَى","ضُمَّرَ الخَصرِ سَلِيمَاتِ النَّسَا",5,"س",2,0],["شُزَّباً ذُو الخِمارِ والدّاحسُ البَح","رُ أبوها والوِردُ والخَطّار",6,"ر",1,0],["شزروني بأعين تقدح الن","يران خوص إلى العدو زواني",7,"ن",2,0],["شزرة الأذنين أما نَسرها","فهو دامٍ من قتال للرعال",8,"ل",1,0],["شَزَرَتْها بِسَهامٍ فاتِكاتْ","نافِذاتٍ نِظْرَةَ المُتَّهِمِ",9,"م",1,0],["شزْرِ اللّحاظِ الى الكميّ إذا","شرِقَ القَنا بطِعانِه الشّزْرِ",10,"ر",1,0]]}