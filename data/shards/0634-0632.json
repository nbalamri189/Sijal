{"poems":[[63,"رنا وناظره بالسحر مكتحل","https://www.aldiwan.net/poem46198.html","البسيط"],[4,"درس المنا بمتالع فأبان","https://www.aldiwan.net/poem21206.html","الكامل"],[15,"يا خليلي اربعا واستخبرا المنزل","https://www.aldiwan.net/poem45251.html","الرمل"],[186,"جيران بيتي كنت آملهم","https://www.aldiwan.net/poem43970.html","الكامل"],[195,"شطت بجارتك النوى فتحمل","https://www.aldiwan.net/poem54423.html","الكامل"],[357,"ما عسى تبلغ شكراً ما عسى","https://www.aldiwan.net/poem4166.html","الرمل"]],"verses":[["شَزْرُ المَريرَةِ سَبّاقٌ إِلى أمَدٍ","يَزْوَرُّ عنْ شَأوِهِ الهَيّابَةُ الوَكَلُ",0,"ل",1,0],["شَزَراً عَلى نَبضِ القُلوبِ وَمُقدِماً","فَكَأَنَّما يَختَلُّها بِسِنانِ",1,"ن",1,0],["شُزَّباً يَغشَينَ مِن مَجهولَةِ ال","أَرضِ وَعثاً مِن سُهولٍ وَجِبالِ",2,"ل",1,0],["شزر العيون إذا دعوتهم","عند الصريخ حسدت في العدد",3,"د",1,0],["شُزَّبٌ ذوابِلُ يَتَقينَ لَبانَهُ","وَجَبينَهُ بِسنابِكٍ كَالجَندَلِ",4,"ل",1,0],["شُزّباً قُدتَ صَحيحَاتِ الشَّوَى","ضُمَّرَ الخَصرِ سَلِيمَاتِ النَّسَا",5,"س",2,0]]}