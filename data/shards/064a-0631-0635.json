{"poems":[[47,"من قائل للزمان ما أربه","https://www.aldiwan.net/poem11054.html","المنسرح"],[164,"إذا جادت الروض الحديث غمائمه","https://www.aldiwan.net/poem59001.html","الطويل"],[457,"لك الطائر الميمون فاسرج به طرفا","https://www.aldiwan.net/poem13844.html","الطويل"],[543,"مقامك يا أبا حفص عظيم","https://www.aldiwan.net/poem47955.html","عموديه"],[1534,"","https://poetry.dctabudhabi.ae/diwan/poem/206190",""],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109795","الطويل"],[3667,"","https://poetry.dctabudhabi.ae/diwan/poem/125778","المنسرح"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105133","الرجز"],[585,"أنا في الطائف أستوحي الشعور","https://www.poetsgate.com/ViewPoem.aspx?id=161867",""],[6019,"أَسكِنِينِي الفضا الذي تَسكُنِينَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=160583",""]],"verses":[["يُرصِدُ لي إِن وَصَلتُهُ مَلَلَ ال","جافي وَأَشتاقُ حينَ أَجتَنِبُه",0,"ب",2,0],["يرصع تاج الملك للطفل منهم","وليدا ولم توضع عليه تمائمه",1,"م",2,0],["يُرصِّعُ تيجان الإِجابة في الدجى","بدرّ دعاء ظَلّ يرصفُه رصفا",2,"ف",2,0],["يرَصِّعُ باليراعِ له طرُوساً","كثوبِ الأُفقِ رَصَّعَه النُّجومُ",3,"م",1,0],["يرصد «زحل» بِحْسابه لا يْكونِ","مختلٍّ في العدد",4,"د",1,0],["يرصعها نظم الحباب بلؤلؤٍ","كما دار حول الجيد منتظم العقد",5,"د",1,0],["يرصدها كالعقاب مقتنصاً","لنهمةٍ صائدٌ لها قهرا",6,"ر",2,0],["يرصد كنزاً راق في","لجينه عقيانه",7,"ن",2,0],["يرصد الغفلة أن يعلق بي","علق الفاجر بالعف الوقور",8,"ر",1,0],["يَرصِفُ الليلُ من سَنَا البَدرِ دَربَاً","أَسكِنِينِي الفضا الذي تَسكُنِينَهْ",9,"ن",2,0]]}