{"poems":[[85,"الملك أصبح علينا","https://www.aldiwan.net/poem54204.html","مجزوء الرمل"],[93,"أيهذا الشاكي وما بك داء","https://www.aldiwan.net/poem62667.html","عموديه"],[52,"طال في هند عتابي","https://www.aldiwan.net/poem64825.html","مجزوء الرمل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43692","المديد"],[463,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[563,"كن غنيا في صورة الفقراء","https://www.aldiwan.net/poem35079.html","الخفيف"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121182","البسيط"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99087","الرجز"],[2664,"","https://poetry.dctabudhabi.ae/diwan/poem/143085","الخفيف"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145140","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66430","السريع"],[4797,"بكرتي ماهي تروح فالغبار","https://www.poetsgate.com/ViewPoem.aspx?id=178131",""],[5736,"أين المفر","https://www.poetsgate.com/ViewPoem.aspx?id=203876",""],[5753,"كُن أنت","https://www.poetsgate.com/ViewPoem.aspx?id=204600",""],[5126,"سخرية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87827&r=&rc=42",""]],"verses":[["كن غفلاً فالخبيّا","وشعاع الشمس قد طل",0,"ل",1,0],["كُن غَديراً يَسيرُ في الأَرضِ رَقرا","قاً فَيَسقي مِن جانِبَيهِ الحُقولا",1,"ل",2,0],["كُن غُراباً حينَ تَأتي","بَينَنا أَو كَغُرابِ",2,"ب",1,0],["كُن غَداً نورَ الشَقِيِّ إِذا","ما سَعى نورُ الألى سَعِدوا",3,"د",3,0],["كن غيوراً عليّ من أن يلي غي","رك نصري إن الكريمَ غيورُ",4,"ر",1,0],["كن غنيّاً في صورة الفقراءِ","لا فقيراً في صورة الأغنياءِ",5,"ا",2,1],["كنغمة العود والسنطير رنته","وطيب الحان بادي الغنج ان ضربا",6,"ب",2,0],["كن غصناً كن قمراً","كن شمس دجن في الأفق",7,"ق",1,0],["كن غنياً إن استطعت وإلا","كن حكيماً فما عدا ذين غفل",8,"ل",1,1],["كن غارسا ما فيه نفع فإنما","ستجني الذي قد كنت بالأمس غارسا",9,"س",2,0],["كنغمة العود إذا أنشدت","وما سواها كطنين الذباب",10,"ب",1,0],["كن غاربها ظهرمدرج مطار","والترايب من صدور مصارعين",11,"ن",1,0],["كنْ غيمةً، كنْ ممطرًا شعرًا فكمْ","رُوِيَتْ قوافٍ من أحاديثِ المطرْ",12,"ر",1,0],["كُنْ غيمةً واهطل على هذا الثرى","حتى يدورَ الماءُ في قلبِ الحجَرْ",13,"ر",1,0],["كُنْ غنيّاً.. فقد وُلدْتَ فقيراً","لا شعاراً تزهو به أو دِثارَا",14,"ر",2,0]]}