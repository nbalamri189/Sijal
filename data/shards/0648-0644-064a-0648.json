لإرادة القوية","https://www.poetsgate.com/ViewPoem.aspx?id=199295",""],[5055,"صفوف الظل","https://www.poetsgate.com/ViewPoem.aspx?id=101655",""],[585,"ولي وطنٌ قد أخلب البرق دونه","https://www.poetsgate.com/ViewPoem.aspx?id=161957",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[2365,"ألم تسألا بجنوب السلام","https://www.poetsgate.com/ViewPoem.aspx?id=200657",""],[5266,"جَوَى الْوَطَنْ","https://www.poetsgate.com/ViewPoem.aspx?id=210298",""],[5302,"ولي وطن","https://www.poetsgate.com/ViewPoem.aspx?id=200125",""],[3294,"ربع محا الحدثان رسمه","https://www.poetsgate.com/ViewPoem.aspx?id=173276",""],[5493,"طعنةُ الآلام","https://www.poetsgate.com/ViewPoem.aspx?id=197008",""],[5508,"وقفنا على حكم الهوى نعلن الشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=110819",""],[5616,"قلم وقرطاس","https://www.poetsgate.com/ViewPoem.aspx?id=203337",""],[5689,"ذروني أقل أن الوجود ظلام","https://www.poetsgate.com/ViewPoem.aspx?id=143424",""],[5725,"ضرباً بهارية الصفاح","https://www.poetsgate.com/ViewPoem.aspx?id=177494",""],[5753,"حصاد","https://www.poetsgate.com/ViewPoem.aspx?id=214927",""],[402,"دم سالما يا صاحب اليوبيل","https://www.poetsgate.com/ViewPoem.aspx?id=36177",""],[5851,"شهقة السنديان","https://www.poetsgate.com/ViewPoem.aspx?id=175298",""],[5874,"الدَّرْوِيشَة","https://www.poetsgate.com/ViewPoem.aspx?id=212177",""],[520,"في مثل ذا الموقف المشهود تنتخب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577437",""],[6259,"وليَّ ولم يقض من أحبابه وطرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59376&r=&rc=24",""],[402,"يا من بكى والخطب جد أليم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54088&r=&rc=940",""],[5190,"أُحقِّركُم وأكرَهُكُم جميعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85050&r=&rc=125",""],[572,"لستُ على عذلِكَ صَبَّارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9316&r=&rc=173",""]],"verses":[["وَلّى وَقَد أَردَفَ هَدّارَةً","يَقظى عَلى اللَيلِ لَغوطَ الفَمِ",0,"م",1,0],["وَلِي وَطْأَةٌ فَوْقَ الزَّمَانِ ثَقِيلَةٌ","يُطَأَطِىءُ خَدَّيْهِ لَهَا وَيُمِيلُ",1,"ل",1,0],["ولى وَلَها في النَّاسِ قَولٌ وسُمعَةٌ","ولى وَلَهَا في كلِّ نَاحِيَةٍ مَثَل",2,"ل",1,0],["وَلَّى وَلَمْ يَحْجُبْ مِنْ الدُّنْيَا قِذَىً","عَنْهُ تَجَلِّي رَبِّهِ القَيُّومِ",3,"م",1,0],["وَلَّى وَفِي الغَدِ عَادَ يَعْتَامُ الحِمَى","أَكْرِمْ بِهِ مِنْ عَائِدٍ مُعْتَامِ",4,"م",1,0],["ولي وطن أفنَيْت عمري بحبّه","وشتَّتُّ شملي في هواه مُبدّدا",5,"د",2,0],["ولى وأسأر في الجوانح حسرة","لو شاء عائد وصله لأزالها",6,"ل",3,0],["ولَّى وما أوليتُهُ سيئاً","أتبعه اللَه قفا أمسِه",7,"س",2,0],["ولي وطنٌ آليت ألا أبيعَهُ","وألا أرى غيري له الدهرَ مالكا",8,"ك",2,0],["وليومِك التأخيرُ ما امتدَّ المدى","بمعمَّرٍ ولشأوِك التقديمُ",9,"م",1,0],["وَلّى وَوَلَّت كَخَيالِ الكَرى","يَلوحُ في الذُهن وَلَم يوجَدِ",10,"د",1,0],["وَلي وَعدٌ إِلى سَنَةٍ فَإِن لَم","يَكُن فيها يَكُن فيما يَليها",11,"ي",3,0],["وَلي واحِدٌ ما لي مِنَ الناسِ غَيرُهُ","أَرى أَنَّهُ الدُنيا وَإِن قُلتُ واحِدُ",12,"د",1,0],["وَلّى وَكُلُّ مُخالِمٍ وَمُنادِمٍ","بَعدَ اللُزومِ مُشَيِّعٌ وَمُوَدِّعُ",13,"ع",1,0],["وَلُيوثٌ مِن طَيِّئٍ وَغُيوثٌ","لَهُمُ المَجدُ طارِفاً وَتَليدا",14,"د",2,0],["وَلّى وَخَيلُكَ تَحتَ اللَيلِ تَنشُدُهُ","مُستَعصِماً بِحِبالِ الرومِ مُعتَسِفا",15,"ف",2,0],["وَلّى وَقَد أَولى الوَرى مِن جودِهِ","نِعَماً يَقومُ بِشُكرِها الأَقوامُ",16,"م",1,0],["وَلَّى ورَدْعُ العَبيرِ يمنحُه","رَيَّاهُ طيبَ العناقِ لارتَدَعا",17,"ع",2,0],["وَلِيَومِ فَقرِكَ عُدَّةٌ ضَيَّعتَها","وَالمَرءُ أَفقَرُ ما يَكونُ هُناكا",18,"ك",2,0],["وَلّى وما كنتُ أدري ما حقيقتُه","كأنّما كان ظلَّ الطائر الحَذِرِ",19,"ر",1,0],["وَلُيوثٍ صالَ فيهِم فانثَنَوْا","وضَواريهم له كالنّقَدِ",20,"د",1,0],["وَلّى وَلَم يَظلِم وَهَل ظَلَمَ اِمرِؤٌ","حَثَّ النَجاءَ وَخَلفَهُ التِنّينُ",21,"ن",1,0],["وَلّى وَقَد أَلجَمَ الخَطِّيُّ مَنطِقَهُ","بِسَكتَةٍ تَحتَها الأَحشاءُ في صَخَبِ",22,"ب",1,0],["ولي ولكم هُناك دمٌ وحنا","وخدرٌ شاردٌ وأخٌ طريد",23,"د",1,0],["وَلّى وَسارَ المَجدُ تَحتَ مَسيرِهِ","وَلِسَيفِهِ وَلِجَفنِهِ اِستِعبارُ",24,"ر",1,0],["وَلّى وَخَلَّفَني لِغائِرَةٍ","بِالمُخزِياتِ السودِ وَالأَفنِ",25,"ن",1,0],["وَلي وَكيلٌ كَيِّسٌ","ما شاءَ مِن أَمرٍ قُضي",26,"ي",1,1],["ولُيُوثٌ يُتَّقَى مَكرُوهُها","وعَناجِيجٌ طِوالٌ تَنْجرِد",27,"د",1,0],["وَلّى وَخَلَّفَ عِرسَهُ وَبَناتِهِ","يَجنينَ أَطيَبَ مَطعَمٍ مِن عَوسَجِ",28,"ج",1,0],["ولي ولكم هُناك دمٌ وهَنّا","وخدرٌ شاردٌ وأخٌ طريد",29,"د",1,0],["وَلَّى وَلَمْ يُعْقِبْ سِوَى حَسْرَةٍ","بَيْنَ الْحَشَا كَالصَّارِمِ الْمُنْتَضَى",30,"ض",2,0],["وَلْيُولِهِ بِسَلِيله مِنْ بَعْده","أَمناً عَلى الذِّكْرَى وَطِيبَ قرَارِ",31,"ر",1,0],["وَلْيُولِ فِي أَيَّامِهِ رَعِيَّةً","تُحِبُّهُ مِنْ فَضْلِهِ الجَزِيلِ",32,"ل",1,0],["ولي وطأة فوق الزمان ثقيلة","يطأطىء هديها لها ويميل",33,"ل",1,0],["ولى ، ولا خبر يهدى اليه وفي","حقائب الريح ، من أخباره تحف",34,"ف",1,0],["وَلُيُوثٌ مِنْ طَيِّءٍ، وَغُيُوثٌ","لَهُمُ المَجْدُ طارِفاً، وَتَلِيدَا",35,"د",2,0],["وَلّى وما كنتُ أدري ما حقيقتُه","كأنَّما كان ظلَّ طائر الحَذِر",36,"ر",1,0],["ولي وطن أكبرته عن ملامة","وأغليه أن يدعى _ على الذّنب مذنبا",37,"ب",2,0],["ولي وطينٌ آليت ألا أبيعَهُ","وألا أرى غيري له الدهرَ مالكا",38,"ك",2,0],["وليٌّ وفيٌّ اريحي مهذب","حليم سليم طاهر السر والسير",39,"ر",1,0],["ولي وأنتم مرادي حاجة صعبت","إذا اقتضيت زماني كونها مطلا",40,"ل",2,0],["وَلي وَقفَةٌ في دارِهِم إِثرَ وَقفَةٍ","وما ذاكَ في أَشباهِ قَومي بِشائِكِ",41,"ك",1,0],["ولي والدٌ فرقاه نارٌ بأكبدي","ولكنَّ عبدَ اللهِ ليس له أمرُ",42,"ر",1,0],["وَلّى وَما بَرَحَت نَضارَةَ عودِهِ","وَجَمالُ تاجِ جَمالِهِ في ناظِري",43,"ر",2,0],["وَلَيوفي عَلى أَقاصي خُراسا","نَ غَداً مِنكَ غارَةٌ شَعواءُ",44,"ا",2,0],["وَلي واحِدٌ مِثل فَرخِ القَطا","صَغيرٌ تَخلَّفَ قَلبي لَدَيه",45,"ي",2,1],["وَليوَللخلق يوم","يشيب منه الوَليد",46,"د",1,0],["ولِي وَجْدُ خَنْسَاء وَرِقَّةُ عُرْوَةٍ","وتَهْيَامُ غِيلانٍ وحُزْنُ مُتَمِّمِ",47,"م",1,0],["وَلىَّ وَخَلَّفَ كُلَّ فَضْلٍ فِيكُمُ","والْغَيْثُ تُحْمَدُ بُعْدَهُ الآثارُ",48,"ر",1,0],["وليومِنا وَسُقاةِ أَكؤسِنا","صُبحٌ أَغَرُّ وأَوجهٌ غُرُّ",49,"ر",1,0],["وَلِيوسُفَ أَهلٌ لِكُلِّ فَضيلَةٍ","بِمَحاسِنِ الأَخلاقِ وَالأَعمالِ",50,"ل",1,0],["وَلّى وَما الدُنيا بِأَقطارِها","لِليَومِ وَالساعَةِ مِنهُ ثَمَن",51,"ن",1,0],["وَلي وَلَهُ إِذا الكاساتُ دارَت","خَفا سِحرٍ يَحُلُّ عُرى الهُمومِ",52,"م",1,1],["وَلي وَلَها بَينَ الظِلالِ تَواصُلٌ","بِغَيرِ مِزاجٍ وَالجُسومُ تُرابُ",53,"ب",1,0],["وَلّى وَقَهقهر وَاِكفهرّ بخلقةٍ","شَخناءَ تَكسوها الدجنّة عنجسا",54,"س",2,0],["ولي وَطَنٌ ولي وَطَرٌ جَميعاً","سَيُدْني لي بَعيدَهُما جَداكا",55,"ك",2,0],["وَلَّى وفي الخَدِّ ما في العِقْدِ من دُرَرٍ","كأنّ ذائبَها في جِيدِه جَمَدا",56,"د",2,0],["وليِومٍ يُعِدُّك المُلْكُ ذي جَدْ","دٍ وجِدِّ وذي سناً وسَناء",57,"ا",2,0],["وَلي وَلِرَبّي الحَمدُ عِصمَةُ صابِرٍ","فَلا مِنهُما تَجري دُموعي وَلا الدَمُ",58,"م",1,0],["ولَّى ولِلأرضِ على أنَّها","لم يحتَملها قطُّ مِقدارُ",59,"ر",1,0],["وَلّى وَلَم يَقضِ مِن أَحبابِهِ وَطراً","لَمّا دَعاهُ مُنادي الشَوق وَلا وزَرا",60,"ر",2,1],["ولى وراحته صفر وقد ملئت","بعد الطماعة من يأس ومن ندم",61,"م",1,0],["وليوثٍ يُظَنُّ يا بْنَ مَصَالٍ","أَنَّ يُمْنَاكَ عَلَّمَتْها المَصَالا",62,"ل",2,0],["ولّى ولم يقض منكمُ وطره","صبّ أطاع الغرام إذ أمره",63,"ر",2,1],["ولي ولم يحضر فغاب كأنه","قد عاش في الأوهام والأفكار",64,"ر",1,0],["ولي ولإخوتي أمل وطيد","بنا أمسى وأصبح في ازدياد",65,"د",1,0],["ولّى وَلَو أَحبَبتَ حينَ نَجا","إِدراكَهُ لَم يُنجِهِ الهَرَبُ",66,"ب",1,0],["ولي وصى كامل متكمّل","تقى نقي زاهد متسرع",67,"ع",1,0],["ولي وصي حين حصر صفاته","تصور ادراك المعارف باطل",68,"ل",1,0],["ولى ويا بئس ما أولى مواليه","ولو تعاينتما لم ينجه الهرب",69,"ب",1,0],["ولي والله إخوانٌ كثيرٌ","نصيبي من فعالهم سواءُ",70,"ا",2,1],["وَلِي وَطَرٌ يُنجِي الجيادَ اِدّكارُه","ولم يشقَ منِّي في تذكّرهِ فِكرُ",71,"ر",1,0],["وَلّى وَقَد جَرَعَت مِنهُ القَنى جُرَعاً","حَيَّ المَخافَةِ مَيتاً غَيرَ مَوؤودِ",72,"د",1,0],["ولَّى وأبقَى حسرةً لا تّنْقَضِي","ومَناحةً تعلو ودمعاً ساجِمَا",73,"م",2,0],["ولَّى وأبقَى حَسرةً لفراقهِ","كادت تُذيبُ بحرِّها شحمَ الكُلَى",74,"ا",1,0],["وَلّى وقد سارَ عَنّا غَيرَ مُلتَفِتٍ","نبكي فيَضحَكُ مِنَّا غيرَ مُبتَسِمِ",75,"م",1,0],["وَلَّى وآثارُ العَدالةِ زادُنا","منهُ وأدعِيةُ المَوَدَّةِ زادُهُ",76,"د",2,0],["وُلي وَاحِدٌ ما زَالَ باثْنَيْنِ مُغْرَما","على واحدٍ ما زالَ باثنَينِ مُغْرَما",77,"م",2,0],["وَلّى وَخَلَّفَ في ذَويهِ مِنَ الأَسى","حالاً أَشَقَّ مِنَ الحِمامِ المودي",78,"د",2,0],["وَلَّى وَجيش بَياض الصبح يَطرده","فعل المظفر في أَعقاب منهزم",79,"م",1,0],["وَلِيوشَعٍ وَلِخَمرِهِ الحَمرا","ءِ مِثلَ العَندَمِ",80,"م",1,0],["ولي وقتان غرّة كل يوم","اجلٌّ على موايدهم وارفعْ",81,"ع",1,0],["ولى وولاني عليكم بعده","ففجعت منه بالعزيز الغالي",82,"ل",2,0],["وَلَّى وأَدْبَرَ عَنْ حِمَاهُ عَدُوُّهُ","وَالحَرْبُ تَدْعُوهُ إِلَى اسْتِقْصَاصِ",83,"ص",1,0],["ولي ولدُ عمرُه تِسعةٌ","ويا حبَّذا التسعةُ الأَشهرُ",84,"ر",1,1],["وليوم منكباً إذا جرحه","في أنفهِ كان أو الثغرِ",85,"ر",1,0],["ولي وقفةٌ في طلول الحمى","أناشد عن ساكنيه الطلولا",86,"ل",2,0],["ولي وطنٌ قنعتُ به صغيراً","على أن لا يهون لمستبد",87,"د",1,1],["وليون لا يهابون الردى","حين تهتز السيوف الماضيه",88,"ي",2,0],["ولى وخلى كنوزاً ما تصورها","قارون يوماً فهل اغنته قطميرا",89,"ر",2,0],["ولّى وأبقى لي تذكّره","تكف الدموع بصفحة الخدّ",90,"د",1,0],["ولي ولم يشعر به أحدُ","عامٌ كأمس مضى به الأبدُ",91,"د",1,1],["وَلّى وَكانَ البَدرَ","يَلتَمس الهُدى فينا طُلوته",92,"ه",1,0],["وليوسف الحج المفدى روعة","في شعره شهدت به الادباء",93,"ا",2,0],["وَلّى وَخَلّى جَمرَةً مَشبوبَةً","تُذكى عَلى الأَحشاءِ نارَ سَمومِ",94,"م",1,0],["وَلي وَليدٌ ولم اقضِ النُفاس بِهِ","يا مَوتُ ما ذنبُ اطفالٍ وَوِلدانِ",95,"ن",1,0],["وليوث حرب صيرت","سمر الرماح لهن أجمه",96,"م",2,0],["ولي ولدٌ لم أَعصِهِ مُذ ولدتُهُ","ولا شكَّ في بِرِّي به مُذْ تَرَعْرَعا",97,"ع",2,1],["وَليَوم ذكرك المبارك في الخل","ق قَرين الخَيرات وَالبركاتِ",98,"ت",1,0],["وَلّى وَأَسلمها الثَبات وَلَم يَكُن","وَلّى وَأَسلَم أَمرها اِستِسلاما",99,"م",2,0],["وَلّى وَما غنّى الكِرا","م وَلا عَلى وَتَرٍ ضَرب",100,"ب",1,0],["وليوثٌ مثل الصقورِ على الخَ","بورِ يَحْمُونَهُ من الوُرادِ",101,"د",1,0],["ولَيوْمِ بَدْرٍ بادَروا فاسْتأصلوا","فِئَةً تَمادى كُفْرُها وجُحودُها",102,"د",3,0],["وَلي وَلَها في النَشأَتَين مَطامِعُ","اِذا هَجرها مِنّي دُموعي اسالَها",103,"ه",2,0],["وليوم التحكيم أعظم يوم","كابد المرتضى وما التحكيم",104,"م",1,0],["وليوسف عند الخروج جلالةٌ","خضعت له أعداؤه وتذللوا",105,"ل",3,0],["وليوم الأحزاب السامي","ما بين الأمة لا ينكر",106,"ر",1,0],["وليوث غاب خيسهم اجم القنا","من كل مدرع هناك وحاسر",107,"ر",1,0],["وَليومِ بَدرٍ أَيُّ فَخرٍ دائمٍ","حَيث التظت بِأُوارها الهيجاء",108,"ا",2,0],["وَلّى وَصُرِّعنَ في حَيثُ اِلتَبَسنَ بِهِ","مُضَرَّجاتٌ بِأَجراحٍ وَمَقتولُ",109,"ل",1,0],["ولي والورى من عنفوني بحبه","وما علموا مني ولكنهم راموا",110,"م",3,1],["ولي وحِبِّي كمِّلَنْ مقاصدِ","وصلِّ ما دمتَ على محمَّدِ",111,"د",1,0],["ولّى وقَد شَرِبَت ظُباك كُمَاتَه","تحت العَجاج وأَسْلَمَتْه حُمَاتُهُ",112,"ت",2,0],["ولُيُوثٌ حينَ يشتدُّ الوَغى","غيرُ أنكاسٍ ولا ميلٍ كُشُف",113,"ف",1,0],["وَلّى وَبِرَسم هَجرِهِ القَلبَ كَوى","ينبينيَ أَنَّ آخِرَ الداءِ الكيّ",114,"ي",1,0],["وَلّى وَبِلَحظِ عينه خاطَبَني","بالسَيفِ كَذا يُخاطَبُ العشّاقُ",115,"ق",1,0],["وَلّى وَنَأى فَكَيف أَستَعطِفُهُ","عَن وجهته الغَداةَ مَن يَصرِفهُ",116,"ه",1,1],["وليؤموا إلى زعيم لوي","أسد اللَه حيدر الكرار",117,"ر",1,0],["ولَّى وجوهَهُمُ سوادُ وجوهِهمْ","نَحو السَّوادِ وآذَنُوا بهوانِ",118,"ن",1,0],["ولي وقارٌ كطودٍ لا يُزَحزحُهُ","وقع الصواعق إذ تُرخى أَعنَّتُهُ",119,"ت",2,0],["وَلَّى وَلَهُ في وَجنَتَيهِ نُقَطُ","كالمِسكِ إِذا ما فُضَّ عَنهُ السَّفَطُ",120,"ط",1,1],["وليوثُ عسكرك الألى ما فيه","الاّ أبيٌ أو وفيّ ذمِام",121,"م",1,0],["ولّى ولم أجن في ريعان غرّتِه","جنى أنال به برّاً وإحسانا",122,"ن",2,0],["وليوم رأيت شخصك فيه","يوم عيد يطفي فداك الغليلا",123,"ل",2,0],["وَلُيوثٌ تُتَّقى عُرَّتُها","ساكَنو الريحَ إِذا طارَ القَزَع",124,"ع",1,0],["ولي وشمر ذيله تشميرا","وافى الحبور وزال عن جسمي العنا",125,"ن",2,0],["ولي وغادر في المرابع بعده","مهجاً تذوب وأكبداً تتفطر",126,"ر",1,0],["ولي وطنٌ كالمحيط ِكبيرٌ","عميقٌ به ِ فرحتي ناشفة",127,"ف",2,0],["وَلِيْ وَطَن فِيه الضَمَائر تُشتَرَى","وَفِيه دِمَاء الكَادِحينَ تُباعُ",128,"ع",1,1],["وليومه الموعود بالمرصاد قد","أمسي فليس لوقعه متناسي",129,"س",2,0],["وليومَ أسرابُنَا في الجو منظرُها","يشقى به الطيرُ في ساحِِ السما رَهَبَا",130,"ب",2,0],["ولي وكّد الشاهين ما راعه الغرْب","لأن الحرار أللي أطلقت من طباعة",131,"ع",2,0],["ولي وطنٌ قد أخلب البرق دونه","فناء بأعباء الأسى والمصائب",132,"ب",1,1],["ولى وطلعة وجهه مسودة","والصدر فيه وساوس السوداء",133,"ا",2,0],["ولي وصي ومولاهم","على رغم آنف من قد رغم",134,"م",1,0],["وَلِي وَطَنٌُ فِي القَلْبِ لَسْتُ أَبِيعُهُ","وَإِنّيَ مَا أُبْقِيتُ يَبْقَى مُكَرّمَا",135,"م",2,1],["ولي وطن قد حل فكري ووجداني","وصار عيوني في الوجود وعنواني",136,"ن",2,1],["وليوث حرب صيرت","سمر العوالي اللدن اجمه",137,"م",2,0],["ولى ولم يسأل لماذا مُزقت","أشلاؤه وتفرق الجمعانِ",138,"ن",1,0],["ولي وقفة بين الحمول تقسّمت","فؤادي أقسام النّوى بينهم تنوى",139,"و",2,0],["ولي وترٌ تغرّبَ عنه قوسٌ","أما حنّت إلى الأوتار قوس!؟",140,"س",1,0],["ولي والد قد طالما عز جانبي","وجل به ليفي السرات مقام",141,"م",1,0],["وليوث غابٍ قسوروا","هزواً بانعام المراحِ",142,"ح",1,0],["ولي وطنٌ تُؤرجِحُهُ المنَايا","على قلقٍ كَأرزاقِ العِبادِ",143,"د",1,0],["وليول في أياما رعية","تحبه من فضله الجزيل",144,"ل",1,0],["ولى وأودع للسحائب سره","تشدو بصمته والرذاذ غناؤه",145,"ا",3,0],["وَلِي وَلَهَا قِصَّةٌ وَفُصُولُ","وَلِي - لا لَهَا - تَدَّعِيهِ النُّحُولُ",146,"ل",1,0],["ولي ويا بئس ما ألوى مواليه","ولو تعاينتما لم ينجه الهرب",147,"ب",1,0],["وليَّ ولم يقض من أحبابه وطرا","لما دعاه منادي الشوق لا وزرا",148,"ر",2,1],["ولي ولم يحجب من الدنيا قذى","عنه تلجلي ربه القيوم",149,"م",1,0],["ولي وَطَنٌ كمثلِ النفسِ غالٍ","فلا نرضى سواهُ ولن نبيعا",150,"ع",2,0],["وَلَّى وأُبقِي ذِكرُهُ بَعدَهُ","لِسائرِ الطرَّادِ أَسمارا",151,"ر",2,0]]}