{"poems":[[53,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[77,"سرى والدجى قد آن منه رحيل","https://www.aldiwan.net/poem36376.html","الطويل"],[0,"لمن طلل بين الجدية والجبل","https://www.aldiwan.net/poem84.html","الطويل"],[93,"يا من بكى والخطب جد أليم","https://www.aldiwan.net/poem11284.html","الكامل"],[93,"بلغت من عيشي أعز مرام","https://www.aldiwan.net/poem11394.html","الكامل"],[88,"تريد لي الأيام أن أتقيد","https://www.aldiwan.net/poem45016.html","الطويل"],[72,"أهوى بمرشفه الشهي وقال ها","https://www.aldiwan.net/poem19469.html","الكامل"],[51,"وصاحب لم أك من جنسه","https://www.aldiwan.net/poem64563.html","السريع"],[51,"أعوذ بحقويك العزيزين أن أرى","https://www.aldiwan.net/poem65771.html","الطويل"],[51,"لأمورك التكميل والتتميم","https://www.aldiwan.net/poem66061.html","الكامل"],[91,"مالي وما للرشء الأغيد","https://www.aldiwan.net/poem8803.html","عموديه"],[70,"كتبت إليك أشرح في كتابي","https://www.aldiwan.net/poem42414.html","الوافر"],[70,"بروحي من قد زارني وهو خائف","https://www.aldiwan.net/poem42941.html","الطويل"],[43,"الحزن يقلق والتجمل يردع","https://www.aldiwan.net/poem9724.html","الكامل"],[45,"إنما الغي أن يكون رشيدا","https://www.aldiwan.net/poem63464.html","الخفيف"],[45,"إستقبلا الركب في أطلالهم وقفا","https://www.aldiwan.net/poem65170.html","البسيط"],[45,"أنظر إلى العلياء كيف تضام","https://www.aldiwan.net/poem65657.html","الكامل"],[61,"أإن دنا الشوق بعد ما شسعا","https://www.aldiwan.net/poem51574.html","المنسرح"],[49,"ما لي رأيتك راكبا لهواكا","https://www.aldiwan.net/poem62207.html","الكامل"],[80,"لم نؤت ليلتنا الغراء من قصر","https://www.aldiwan.net/poem31448.html","البسيط"],[80,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[44,"بذ الجلاد فهو دفين","https://www.aldiwan.net/poem30335.html","الرجز"],[44,"السيف أصدق أنباء من الكتب","https://www.aldiwan.net/poem30591.html","البسيط"],[90,"أعيذك أن يعاصيك القصيد","https://www.aldiwan.net/poem60159.html","عموديه"],[81,"يشقى بريب زمانها الأحرار","https://www.aldiwan.net/poem61519.html","الكامل"],[52,"ضمن اللقاء رواح ناجية","https://www.aldiwan.net/poem26664.html","الكامل"],[52,"ولي وكيل كيس","https://www.aldiwan.net/poem26883.html","مجزوء الرجز"],[75,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[46,"وصل الهجير إلى الهجير لعله","https://www.aldiwan.net/poem22265.html","الكامل"],[90,"","https://poetry.dctabudhabi.ae/diwan/poem/147230","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42669","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55158","الرجز"],[77,"سرى والدجى قد آن منه رحيل","https://www.poetsgate.com/ViewPoem.aspx?id=34205",""],[100,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[45,"إنّما الغَيّ أنْ يكونَ رَشيدَا","https://www.poetsgate.com/ViewPoem.aspx?id=31696",""],[80,"لم نؤت ليلتنا الغرّاء من قِصَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=3221",""],[94,"البلبل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=12827",""],[51,"أعوذ بحقْوِيْك العزيزيْن أن أُرى","https://www.poetsgate.com/ViewPoem.aspx?id=30023",""],[115,"الا عذر لا كان الهوى في الهوى العذر","https://www.aldiwan.net/poem41119.html","عموديه"],[160,"والله ما صدق الواشي الذي نقلا","https://www.aldiwan.net/poem58999.html","البسيط"],[169,"أمن دمنة بين اللوى والدكادك","https://www.aldiwan.net/poem1642.html",""],[212,"تغيرت الأوقات وانقبض الدهر","https://www.aldiwan.net/poem37880.html","الطويل"],[232,"عودي علي ولو كلمح الناظري","https://www.aldiwan.net/poem14832.html","الكامل"],[235,"خجلت من عطائك الأنواء","https://www.aldiwan.net/poem32200.html","الخفيف"],[257,"ولي واحد مثل فرخ القطا","https://www.aldiwan.net/poem2679.html","المتقارب"],[271,"تنبهوا يا رقود","https://www.aldiwan.net/poem52048.html","المجتث"],[275,"تقدم يحيى المرتضى كل من مضى","https://www.aldiwan.net/poem25520.html","الطويل"],[280,"ببهاء وجهك تشرق الأنوار","https://www.aldiwan.net/poem60769.html","الكامل"],[297,"شق الدجى عن نحره الفجر","https://www.aldiwan.net/poem33263.html","أحذ الكامل"],[320,"الأنس ساد برتبة الجمال","https://www.aldiwan.net/poem67217.html","الكامل"],[338,"سقيا لأيام تولت بها","https://www.aldiwan.net/poem68689.html","السريع"],[346,"ولي وله إذا الكاسات دارت","https://www.aldiwan.net/poem24107.html","الوافر"],[349,"لعلوة دون العاشقين حجاب","https://www.aldiwan.net/poem15533.html","الطويل"],[353,"لا تعتب الوغد اللئيم إذا أسا","https://www.aldiwan.net/poem40167.html","الكامل"],[364,"عداك الحادثات إلى عداكا","https://www.aldiwan.net/poem60815.html","الوافر"],[364,"ألم صبحا وجمر الحلي قد بردا","https://www.aldiwan.net/poem60940.html","البسيط"],[364,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[366,"أما فوقها إلا نجود وأنهم","https://www.aldiwan.net/poem17330.html","الطويل"],[371,"يا حار إن الركب قد حاروا","https://www.aldiwan.net/poem57442.html","السريع"],[406,"ولى ولم يقض من أحبابه وطرا","https://www.aldiwan.net/poem50171.html","البسيط"],[409,"الناصر الملك الموفى بذمته","https://www.aldiwan.net/poem31644.html","عموديه"],[432,"ضرب الناس في العلا الأمثالا","https://www.aldiwan.net/poem12373.html","الخفيف"],[437,"ولى ولم يقض منكم وطره","https://www.aldiwan.net/poem2609.html","المنسرح"],[453,"أين الربيع سألت عنه فلم أجد","https://www.aldiwan.net/poem61275.html","الكامل"],[479,"أناديها وما لي لا أنادي","https://www.aldiwan.net/poem37581.html","الوافر"],[493,"ورد الدمستق دون منظره","https://www.aldiwan.net/poem67423.html","أحذ الكامل"],[504,"هواك لا نوار الملامة ملمع","https://www.aldiwan.net/poem38404.html","الطويل"],[504,"يحرك وجدي قدك المتمايل","https://www.aldiwan.net/poem38405.html","الطويل"],[515,"في مثل ذا الموقف المشهود تحتلب","https://www.aldiwan.net/poem12012.html","البسيط"],[527,"ولي والله إخوان كثير","https://www.aldiwan.net/poem45960.html","الوافر"],[551,"لقل غناء العتب والمجرم الدهر","https://www.aldiwan.net/poem47826.html","الطويل"],[553,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[562,"يا ويح يوسف عسكر الغصن الذي","https://www.aldiwan.net/poem52540.html","الكامل"],[562,"تحت الثرى سيصير من فوق الثرى","https://www.aldiwan.net/poem52774.html","الكامل"],[562,"قوموا بنا نسأل الأموات في الرجم","https://www.aldiwan.net/poem52816.html","الكامل"],[562,"غاب الفؤاد ولم تغب آثاره","https://www.aldiwan.net/poem52834.html","البسيط"],[586,"ليت شعري من قد أحل الخياما","https://www.aldiwan.net/poem17744.html","الخفيف"]],"verses":[["وَلّى وَقَد أَردَفَ هَدّارَةً","يَقظى عَلى اللَيلِ لَغوطَ الفَمِ",0,"م",1,0],["وَلِي وَطْأَةٌ فَوْقَ الزَّمَانِ ثَقِيلَةٌ","يُطَأَطِىءُ خَدَّيْهِ لَهَا وَيُمِيلُ",1,"ل",1,0],["ولى وَلَها في النَّاسِ قَولٌ وسُمعَةٌ","ولى وَلَهَا في كلِّ نَاحِيَةٍ مَثَل",2,"ل",1,0],["وَلَّى وَلَمْ يَحْجُبْ مِنْ الدُّنْيَا قِذَىً","عَنْهُ تَجَلِّي رَبِّهِ القَيُّومِ",3,"م",1,0],["وَلَّى وَفِي الغَدِ عَادَ يَعْتَامُ الحِمَى","أَكْرِمْ بِهِ مِنْ عَائِدٍ مُعْتَامِ",4,"م",1,0],["ولي وطن أفنَيْت عمري بحبّه","وشتَّتُّ شملي في هواه مُبدّدا",5,"د",2,0],["ولى وأسأر في الجوانح حسرة","لو شاء عائد وصله لأزالها",6,"ل",3,0],["ولَّى وما أوليتُهُ سيئاً","أتبعه اللَه قفا أمسِه",7,"س",2,0],["ولي وطنٌ آليت ألا أبيعَهُ","وألا أرى غيري له الدهرَ مالكا",8,"ك",2,0],["وليومِك التأخيرُ ما امتدَّ المدى","بمعمَّرٍ ولشأوِك التقديمُ",9,"م",1,0],["وَلّى وَوَلَّت كَخَيالِ الكَرى","يَلوحُ في الذُهن وَلَم يوجَدِ",10,"د",1,0],["وَلي وَعدٌ إِلى سَنَةٍ فَإِن لَم","يَكُن فيها يَكُن فيما يَليها",11,"ي",3,0],["وَلي واحِدٌ ما لي مِنَ الناسِ غَيرُهُ","أَرى أَنَّهُ الدُنيا وَإِن قُلتُ واحِدُ",12,"د",1,0],["وَلّى وَكُلُّ مُخالِمٍ وَمُنادِمٍ","بَعدَ اللُزومِ مُشَيِّعٌ وَمُوَدِّعُ",13,"ع",1,0],["وَلُيوثٌ مِن طَيِّئٍ وَغُيوثٌ","لَهُمُ المَجدُ طارِفاً وَتَليدا",14,"د",2,0],["وَلّى وَخَيلُكَ تَحتَ اللَيلِ تَنشُدُهُ","مُستَعصِماً بِحِبالِ الرومِ مُعتَسِفا",15,"ف",2,0],["وَلّى وَقَد أَولى الوَرى مِن جودِهِ","نِعَماً يَقومُ بِشُكرِها الأَقوامُ",16,"م",1,0],["وَلَّى ورَدْعُ العَبيرِ يمنحُه","رَيَّاهُ طيبَ العناقِ لارتَدَعا",17,"ع",2,0],["وَلِيَومِ فَقرِكَ عُدَّةٌ ضَيَّعتَها","وَالمَرءُ أَفقَرُ ما يَكونُ هُناكا",18,"ك",2,0],["وَلّى وما كنتُ أدري ما حقيقتُه","كأنّما كان ظلَّ الطائر الحَذِرِ",19,"ر",1,0],["وَلُيوثٍ صالَ فيهِم فانثَنَوْا","وضَواريهم له كالنّقَدِ",20,"د",1,0],["وَلّى وَلَم يَظلِم وَهَل ظَلَمَ اِمرِؤٌ","حَثَّ النَجاءَ وَخَلفَهُ التِنّينُ",21,"ن",1,0],["وَلّى وَقَد أَلجَمَ الخَطِّيُّ مَنطِقَهُ","بِسَكتَةٍ تَحتَها الأَحشاءُ في صَخَبِ",22,"ب",1,0],["ولي ولكم هُناك دمٌ وحنا","وخدرٌ شاردٌ وأخٌ طريد",23,"د",1,0],["وَلّى وَسارَ المَجدُ تَحتَ مَسيرِهِ","وَلِسَيفِهِ وَلِجَفنِهِ اِستِعبارُ",24,"ر",1,0],["وَلّى وَخَلَّفَني لِغائِرَةٍ","بِالمُخزِياتِ السودِ وَالأَفنِ",25,"ن",1,0],["وَلي وَكيلٌ كَيِّسٌ","ما شاءَ مِن أَمرٍ قُضي",26,"ي",1,1],["ولُيُوثٌ يُتَّقَى مَكرُوهُها","وعَناجِيجٌ طِوالٌ تَنْجرِد",27,"د",1,0],["وَلّى وَخَلَّفَ عِرسَهُ وَبَناتِهِ","يَجنينَ أَطيَبَ مَطعَمٍ مِن عَوسَجِ",28,"ج",1,0],["ولي ولكم هُناك دمٌ وهَنّا","وخدرٌ شاردٌ وأخٌ طريد",29,"د",1,0],["وَلَّى وَلَمْ يُعْقِبْ سِوَى حَسْرَةٍ","بَيْنَ الْحَشَا كَالصَّارِمِ الْمُنْتَضَى",30,"ض",2,0],["وَلْيُولِهِ بِسَلِيله مِنْ بَعْده","أَمناً عَلى الذِّكْرَى وَطِيبَ قرَارِ",31,"ر",1,0],["وَلْيُولِ فِي أَيَّامِهِ رَعِيَّةً","تُحِبُّهُ مِنْ فَضْلِهِ الجَزِيلِ",32,"ل",1,0],["ولي وطأة فوق الزمان ثقيلة","يطأطىء هديها لها ويميل",33,"ل",1,0],["ولى ، ولا خبر يهدى اليه وفي","حقائب الريح ، من أخباره تحف",34,"ف",1,0],["وَلُيُوثٌ مِنْ طَيِّءٍ، وَغُيُوثٌ","لَهُمُ المَجْدُ طارِفاً، وَتَلِيدَا",35,"د",2,0],["وَلّى وما كنتُ أدري ما حقيقتُه","كأنَّما كان ظلَّ طائر الحَذِر",36,"ر",1,0],["ولي وطن أكبرته عن ملامة","وأغليه أن يدعى _ على الذّنب مذنبا",37,"ب",2,0],["ولي وطينٌ آليت ألا أبيعَهُ","وألا أرى غيري له الدهرَ مالكا",38,"ك",2,0],["وليٌّ وفيٌّ اريحي مهذب","حليم سليم طاهر السر والسير",39,"ر",1,0],["ولي وأنتم مرادي حاجة صعبت","إذا اقتضيت زماني كونها مطلا",40,"ل",2,0],["وَلي وَقفَةٌ في دارِهِم إِثرَ وَقفَةٍ","وما ذاكَ في أَشباهِ قَومي بِشائِكِ",41,"ك",1,0],["ولي والدٌ فرقاه نارٌ بأكبدي","ولكنَّ عبدَ اللهِ ليس له أمرُ",42,"ر",1,0],["وَلّى وَما بَرَحَت نَضارَةَ عودِهِ","وَجَمالُ تاجِ جَمالِهِ في ناظِري",43,"ر",2,0],["وَلَيوفي عَلى أَقاصي خُراسا","نَ غَداً مِنكَ غارَةٌ شَعواءُ",44,"ا",2,0],["وَلي واحِدٌ مِثل فَرخِ القَطا","صَغيرٌ تَخلَّفَ قَلبي لَدَيه",45,"ي",2,1],["وَليوَللخلق يوم","يشيب منه الوَليد",46,"د",1,0],["ولِي وَجْدُ خَنْسَاء وَرِقَّةُ عُرْوَةٍ","وتَهْيَامُ غِيلانٍ وحُزْنُ مُتَمِّمِ",47,"م",1,0],["وَلىَّ وَخَلَّفَ كُلَّ فَضْلٍ فِيكُمُ","والْغَيْثُ تُحْمَدُ بُعْدَهُ الآثارُ",48,"ر",1,0],["وليومِنا وَسُقاةِ أَكؤسِنا","صُبحٌ أَغَرُّ وأَوجهٌ غُرُّ",49,"ر",1,0],["وَلِيوسُفَ أَهلٌ لِكُلِّ فَضيلَةٍ","بِمَحاسِنِ الأَخلاقِ وَالأَعمالِ",50,"ل",1,0],["وَلّى وَما الدُنيا بِأَقطارِها","لِليَومِ وَالساعَةِ مِنهُ ثَمَن",51,"ن",1,0],["وَلي وَلَهُ إِذا الكاساتُ دارَت","خَفا سِحرٍ يَحُلُّ عُرى الهُمومِ",52,"م",1,1],["وَلي وَلَها بَينَ الظِلالِ تَواصُلٌ","بِغَيرِ مِزاجٍ وَالجُسومُ تُرابُ",53,"ب",1,0],["وَلّى وَقَهقهر وَاِكفهرّ بخلقةٍ","شَخناءَ تَكسوها الدجنّة عنجسا",54,"س",2,0],["ولي وَطَنٌ ولي وَطَرٌ جَميعاً","سَيُدْني لي بَعيدَهُما جَداكا",55,"ك",2,0],["وَلَّى وفي الخَدِّ ما في العِقْدِ من دُرَرٍ","كأنّ ذائبَها في جِيدِه جَمَدا",56,"د",2,0],["وليِومٍ يُعِدُّك المُلْكُ ذي جَدْ","دٍ وجِدِّ وذي سناً وسَناء",57,"ا",2,0],["وَلي وَلِرَبّي الحَمدُ عِصمَةُ صابِرٍ","فَلا مِنهُما تَجري دُموعي وَلا الدَمُ",58,"م",1,0],["ولَّى ولِلأرضِ على أنَّها","لم يحتَملها قطُّ مِقدارُ",59,"ر",1,0],["وَلّى وَلَم يَقضِ مِن أَحبابِهِ وَطراً","لَمّا دَعاهُ مُنادي الشَوق وَلا وزَرا",60,"ر",2,1],["ولى وراحته صفر وقد ملئت","بعد الطماعة من يأس ومن ندم",61,"م",1,0],["وليوثٍ يُظَنُّ يا بْنَ مَصَالٍ","أَنَّ يُمْنَاكَ عَلَّمَتْها المَصَالا",62,"ل",2,0],["ولّى ولم يقض منكمُ وطره","صبّ أطاع الغرام إذ أمره",63,"ر",2,1],["ولي ولم يحضر فغاب كأنه","قد عاش في الأوهام والأفكار",64,"ر",1,0],["ولي ولإخوتي أمل وطيد","بنا أمسى وأصبح في ازدياد",65,"د",1,0],["ولّى وَلَو أَحبَبتَ حينَ نَجا","إِدراكَهُ لَم يُنجِهِ الهَرَبُ",66,"ب",1,0],["ولي وصى كامل متكمّل","تقى نقي زاهد متسرع",67,"ع",1,0],["ولي وصي حين حصر صفاته","تصور ادراك المعارف باطل",68,"ل",1,0],["ولى ويا بئس ما أولى مواليه","ولو تعاينتما لم ينجه الهرب",69,"ب",1,0],["ولي والله إخوانٌ كثيرٌ","نصيبي من فعالهم سواءُ",70,"ا",2,1],["وَلِي وَطَرٌ يُنجِي الجيادَ اِدّكارُه","ولم يشقَ منِّي في تذكّرهِ فِكرُ",71,"ر",1,0],["وَلّى وَقَد جَرَعَت مِنهُ القَنى جُرَعاً","حَيَّ المَخافَةِ مَيتاً غَيرَ مَوؤودِ",72,"د",1,0],["ولَّى وأبقَى حسرةً لا تّنْقَضِي","ومَناحةً تعلو ودمعاً ساجِمَا",73,"م",2,0],["ولَّى وأبقَى حَسرةً لفراقهِ","كادت تُذيبُ بحرِّها شحمَ الكُلَى",74,"ا",1,0],["وَلّى وقد سارَ عَنّا غَيرَ مُلتَفِتٍ","نبكي فيَضحَكُ مِنَّا غيرَ مُبتَسِمِ",75,"م",1,0],["وَلَّى وآثارُ العَدالةِ زادُنا","منهُ وأدعِيةُ المَوَدَّةِ زادُهُ",76,"د",2,0],["وُلي وَاحِدٌ ما زَالَ باثْنَيْنِ مُغْرَما","على واحدٍ ما زالَ باثنَينِ مُغْرَما",77,"م",2,0]]}