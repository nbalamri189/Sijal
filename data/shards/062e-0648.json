حكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[513,"قدومك أفرح قلب الهدى","https://www.aldiwan.net/poem12068.html","المتقارب"],[513,"من كان لا يعشق الأجياد والحدقا","https://www.aldiwan.net/poem12182.html","البسيط"],[527,"خود رداح ربحله","https://www.aldiwan.net/poem37219.html","مجزوء الرجز"],[536,"واسلك سبيل المفلسين ودار","https://www.aldiwan.net/poem48172.html","عموديه"],[538,"إن سليمى والله يكلؤها","https://www.aldiwan.net/poem56917.html","المنسرح"],[540,"ردا علي الكأس إنكما","https://www.aldiwan.net/poem34022.html","أحذ الكامل"],[542,"ما زال في الأرض","https://www.aldiwan.net/poem67255.html","عموديه"],[547,"أمن القتول منازل ومعرس","https://www.aldiwan.net/poem446.html",""],[549,"ما صيد قلبك إلا بابنة الكلل","https://www.aldiwan.net/poem47265.html","البسيط"],[549,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[549,"ناد امرءا غيب خلف النقا","https://www.aldiwan.net/poem48119.html","السريع"],[556,"طرف الذي طلب التحقيق سهران","https://www.aldiwan.net/poem33823.html","البسيط"],[556,"نحن ضياء الغارب الطالع","https://www.aldiwan.net/poem34396.html","السريع"],[556,"إني أنا جسم فنفس فروح","https://www.aldiwan.net/poem34668.html","السريع"],[559,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[560,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[560,"خود من العرب عافت شيمة الكرم","https://www.aldiwan.net/poem52840.html","البسيط"],[560,"قف بالديار إذا الليل البهيم سجا","https://www.aldiwan.net/poem52900.html","البسيط"],[560,"ما بين أعطاف القدود الهيف","https://www.aldiwan.net/poem52947.html","الكامل"],[562,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[565,"حلل الشبيبة مستعاره","https://www.aldiwan.net/poem69664.html","مجزوء الكامل"],[565,"يا لقومي من لمكتئب","https://www.aldiwan.net/poem69761.html","المديد"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["خَوارِجَ مِن ذَيلِ الغُبارِ كَأَنَّها","أَنامِلُ مَقرورٍ دَنا النارَ صالِيا",0,"ي",2,0],["خَوصاءُ تَحسَبُ عَينَها ماوِيَّةً","نَظَرَت بِها الفَلَواتُ شَخصَ غَمامِ",1,"م",1,0],["خَوارِجُ مِن لَيلٍ كَأَنَّ وَراءَهُ","يَدَ الفَجرِ في سَيفٍ جَلاهُ صِقالُ",2,"ل",1,0],["خوصٌ كَأَنَّ عُيونَها في هامِها","قُلبٌ بَعُدنَ عَنِ الوُرودِ غَوائِرُ",3,"ر",1,0],["خَوانِفُ مَهبوطٌ بِهِنَّ عَشِيَّةً","قَرارٌ وَمَطلوعٌ بِهِنَّ نِجادُ",4,"د",1,0],["خَوارِجُ مِن لَيلٍ كَأَنَّ نُجومَهُ","بَياضُ الحَصى بِالأَمعَزِ المُتَراكِبِ",5,"ب",1,0],["خَواطِرُ بِالأَيدي لَواعِبُ بِالخُطى","وَلِلطَعنِ في لَبّاتِهِنَّ لِعابُ",6,"ب",1,0],["خَودٌ كَأَنَّ بِريقِها","مِسكاً يَفوحُ لَدى كَراها",7,"ا",3,0],["خَودٌ تُشيرُ بِرَخصٍ حَفَّ مِعصَمَهُ","دُرٌّ وَساعِدُهُ لِلوَجهِ سَتّارُ",8,"ر",1,0],["خَوفاً مِنَ الناسِ أَن يَقولوا","فَضلُ فُلانٍ عَلى فُلانِ",9,"ن",1,0],["خَوْدٌ أَتَتْنِي آنَسَتْ مِنْ غُرْبَتِي","وَأَرَتْنِي الآمَالَ رَأْيَ عيَانِ",10,"ن",1,0],["خَوْدٌ تَجَلَّتْ فِي مِنَصَّةِ شَاهِقٍ","مُخْتَالَةً إِكْلِيلُهُا الإكْلِيلُ",11,"ل",1,0],["خَوصاءَ صافِيَةٍ تَجودُ بِمائِها","وَسطَ النهارِ كَنُطفَةِ الحَرّانِ",12,"ن",1,0],["خَوَتِ الدِيارُ فَلا اِختِرا","عَ وَلا اِقتِصادَ وَلا ذَخائِر",13,"ر",1,0],["خَوارِزمُ عِندِيَ خَيرُ البِلادِ","فَلا أَقلَعَت سحبُها المُغدِقَه",14,"ق",2,1],["خَودٌ تَعَثَّرُ كُلَّما رَقَصَت","مِن شعرِها بِمُسَلسَلٍ رَجِلِ",15,"ل",1,0],["خَوارِجَ مِن بَرِّيَّةٍ نَحوَ قَريَةٍ","يُجَدِّدنَ وَصلاً أَو يُقَرِّبنَ مَطمَعا",16,"ع",2,0],["خَوَّاضِ أَجْوَازِ العَنَانِ مُمَانِعٍ","غَيْرَ النُّهَى عَنْ أَخْذِهِ بِعِنَانِ",17,"ن",1,0],["خَوابِرٌ بِأُمورِ الناسِ تُخبِرُنا","عَن لُؤمِ قَومٍ وَعَن مَجدٍ بِتَصداقِ",18,"ق",1,0],["خَودٌ كَأَنَّ اِهتِزازِ الرُمحِ مِشيَتُها","لَفّاءُ مَمكورَةٌ مِن غَيرِ تَهبيجِ",19,"ج",1,0],["خوصُ العُيونِ إِذا اِستَقبَلنَ هاجِرَةً","يُحسَبنَ عوراً وَما فيهِنَّ مِن عورِ",20,"ر",1,0],["خورٌ لَهُم زَبَدٌ إِذا ما اِستَأمَنوا","وَإِذا تَتابَعَ في الزَمانِ الأَمرَعُ",21,"ع",1,0],["خوادمُ أكفاءٌ عليهن مَسْحَة","عن العِتْقِ أبداها بَنان ومَحْجِرُ",22,"ر",1,1],["خواضع في كلِّ ديمومة","يكاد الظليم به ينحَلُ",23,"ل",1,1],["خَوفَ أَن يَصطَفيكَ غَيرِيَ بَعدي","لا أَرى أَن أَقولَ قُدِّمتُ قَبلَك",24,"ك",1,0],["خود لها مثل ما في الظبي من ملح","وليسَ للظبي ما فيها من الأنس",25,"س",1,0],["خواتم اللّذّات محتاجة","في هذه الدنيا لهذي الفصوص",26,"ص",1,0],["خوَّفوني من مقلتيه سهاماً","وهي والله منتهى أغراضي",27,"ض",2,0],["خوَّفني الناس سهم مقلتها","وما دروا أن سهمها غرضي",28,"ي",1,0],["خَوَّله اللّهُ فلم يشكر له","ولن ترى شكراً لمدخول النسَبْ",29,"ب",1,0],["خوفاً وإشفاقاً وإر","صادُ الحتوفِ له رَواصدْ",30,"د",1,0],["خُوِّلْتَها كوكباً مُنِيراً","من تحْتِهِ سَرْوَةٌ تميدُ",31,"د",1,0],["خوارج مثل أنضية المُغالي","حدا أعجازَها الريش الظُهار",32,"ر",1,0],["خِوانُ عيسى من نصف ترمسةٍ","وصحفتاه من فِلْقتي عدَسَهْ",33,"س",2,1],["خَوْد لها وجه علي","ه من القسامة ملبسُ",34,"س",1,0],["خوفاً على نضوٍ براه البِلَى","فبعضُهُ يبكي على بعضِ",35,"ض",1,0],["خوصاً أَضَرَّ بِها اِبنُ يوسُفَ فَاِنطَوَت","وَالحَربُ لاقِحَةٌ لَهُنَّ زَجورُ",36,"ر",1,0],["خوصٍ كَأَنَّ شَكيمَهُنَّ مُعَلَّقٌ","بِقَنا رُدَينَةَ أَو جُذوعِ أَوالِ",37,"ل",1,0],["خَودٌ يَهَشُّ لَها قَلبي إِذا ذُكِرَت","يَوماً كَما يَفرَحُ الباغي بِما وَجَدا",38,"د",2,0],["خَودٌ إِذا نَطَقَت حَسِبتَ حَديثَها","دُرّاً وَلَكِن لَيسَ مِمّا يُشتَرى",39,"ا",1,0],["خَوفاً عَلَيها أَن تَساقَطَ حَسرَةً","أَو أَن تَفيضَ لَواعِجاً وَشُجونا",40,"ن",2,0],["خَوَّفوني جَهَنَّماً وَلَظاها","أَيُّ شَيءٍ جَهَنَّمٌ وَلَظاها",41,"ا",3,0],["خوصٌ نَواهِزُ بِالسُدوسِ إِذا","ضَمَّ الحُداةُ جَوانِبَ الرَكبِ",42,"ب",1,0],["خَودٌ تَمَلَّكَتِ الفُؤادَ فَريدَةً","بِنَدى الثَنايا وَالمُحَيّا المُشمِسِ",43,"س",1,0],["خوضي الى المجد الاثيل","مع الألى خاضوا الصعابا",44,"ب",2,0],["خَودٌ جَنَت بَيني وَبَينَ عَواذِلي","حَرباً وَغادَرَتِ الفُؤادَ وَطيسا",45,"س",2,0],["خَوفُ الجَبانِ في فُؤادِ العاشِقِ","كَأَنَّهُ في رَيدِ طَودٍ شاهِقِ",46,"ق",1,0],["خَوفاً مِنَ العَينِ أَن يُصابَ بِها","أَصابَ عَيناً بِها يُصابُ عَمى",47,"م",2,0],["خوفاً عليهِ أنْ يذو","بَ بَحَرِّ أنفاسي وحِذْرا",48,"ر",2,0],["خَونُ عَينٍ لَم أَحتَسِبهُ وَقَلبٍ","لَم أَخَف يَومَ رامَتَينِ اِنقِلابَه",49,"ب",2,0],["خوصَ العُيونِ إِذا أَبدَت سُرىً مَثَلَت","بِالأَرضِ أَو أَجحَفَت بِاللَيلِ إِجحافا",50,"ف",2,0],["خَوالِدُ في الأَقوامِ يُبعَثنَ مُثَّلاً","فَما نَدرُسُ الأَيّامُ مِنهُنَّ مُعلَما",51,"م",2,0],["خَودٌ كَبَدرٍ فَوقَ فَرعِ أَراكَةٍ","يَهتَزُّ مَثنِياً عَلى كُثبانِ",52,"ن",1,0],["خُواقُ حِياضِهِنَّ يَسيلُ سَيلاً","عَلى الأَعقابِ تَحسِبُهُ خِضابا",53,"ب",2,0],["خَواضِعُ يَعمينَ اللُغامَ كَأَنَّما","مَناسِمُها مَعلولَةٌ بِجِسادِ",54,"د",1,0],["خوصاً حَراجيجَ ما تَدري أَما نَقِبَت","أَشكى إِلَيها إِذا راحَت أَمِ الدَبَرُ",55,"ر",1,0],["خَودٌ مُنَعَّمَةٌ أَنيقٌ عَيشُها","فيها لِعَينِكَ مَكلَأٌ وَبَهاءُ",56,"ا",2,0],["خَوَّفني مُنَجِّمٌ أَخو خَبَل","تَراجَعَ المَريخُ في بَيتِ الحَمَل",57,"ل",1,1],["خَودٌ شَدَت بِلِسانِها وَبَنانِها","حَتّى تَشابَهَ ضَربُها وَنَشيدِها",58,"د",3,0],["خودٌ تلقّنُ تِرْبَها حُجَجاً","كالبنتِ مُصْغِيَةً إلى الأمِّ",59,"م",1,0],["خَوانِفُ يَظلِمنَ الظَليمَ إِذا عَدا","وَسيجَ أَبيهِ وَهوَ لِلبَرقِ شائِمُ",60,"م",1,0],["خَوَّلتَهُ عَيشاً أَغَنَّ وَجامِلاً","دَثراً وَمالاً صامِتاً وَأَثاثا",61,"ث",2,0],["خَوْدٌ جَلَتْ للشيخِ كاساتِها","تزفُّها بالدفِّ والجنكِ",62,"ك",1,1],["خوَّفَ فيه بالأميرِ العاذلُ","والصلحُ خيرٌ والأميرُ عادلُ",63,"ل",1,0],["خَودٌ إِذا قامَت إِلى خِدرِها","قامَت قَطوفُ المَشيِ مِكسالُهُ",64,"ل",2,0],["خَودٌ وَقَيرٌ نِصفُها","وَنِصفُها مُهَفهَفُ",65,"ف",1,0],["خَودٌ يَفوحُ المِسكُ مِن","أَردانِها وَالعَنبَرُ",66,"ر",1,0],["خَودٌ مُهَفهَفَةُ الأَعلى إِذا اِنصَرَفَت","تَكادُ مِن ثِقَلِ الأَردافِ تَنتَبِرُ",67,"ر",1,0],["خَودٌ تُضيءُ ظَلامَ البَيتِ صورَتُها","كَما يُضيءُ ظَلامَ الحِندِسِ القَمَرُ",68,"ر",1,0],["خَودٌ إِذا كَثُرَ الكَلامُ تَعَوَّذَت","بِحِمى الحَياءِ وَإِن تَكَلَّم تَقصِدِ",69,"د",1,0],["خَوارِجَ مِن نُعمانَ أَو مِن سُفوحِهِ","إِلى البَيتِ أَو يَطلُعنَ مِن نَجدِ كَبكَبِ",70,"ب",1,0],["خُوضوا الكريهةَ حاسرين فإن طغت","لُجَجُ الملاحمِ فاركبوا الأشلاءَ",71,"ا",2,0],["خُوضوا الغِمارَ فلن تنالوا مأرباً","حتى تَرَوْهَا تستطيرُ ضروسا",72,"س",2,0],["خُوضوا الغمارَ مُكبّرينَ فإنّما","هي للرّسولِ سَرِيّةٌ وغَزَاة",73,"ه",1,0],["خُوضوا الرُّماةَ وسيروا حَوْل رايتهِ","جُنداً من الحقِّ يرمي دُونَهُ اللهُ",74,"ه",1,0],["خوضي الغِمارَ إِلى الفُتوحِ نَرى لَها","غُرَراً تُضيءُ بِها الدُنى وَحُجولا",75,"ل",2,0],["خُوضي غِمارَ الخُطوبِ السودِ وَاِرتَقِبي","فُلكَ العِنايَةِ إِنَّ اللَهَ مُزجيها",76,"ي",3,0],["خُوضُوا الوغَى يا أهلَ وَادِي القرى","واستقبلوا الموتَ وأُسْد الشَرَى",77,"ر",2,1],["خَوفاً تَبينُ القُلوبُ واجِفَةً","تَكادُ عَنها الصُدورُ تَنفَلِقُ",78,"ق",1,0],["خَواشِعُ كَالهَيمى يَمِدنَ مِنَ الهَوى","وَذو البَثِّ فيهِ كِلَّةٌ وَخُشوعُ",79,"ع",1,0],["خَوداً لَعوباً لَها رَيّا وَرائِحَةٌ","تَشفي فُؤادَ رَذِيِّ الجِسمِ مِسقامِ",80,"م",1,0],["خَوازِنُ نَحضٍ في الجُلودِ كَأَنَّما","تُحَمَّلُ كُثباناً مِنَ الرَملِ أَصلابا",81,"ب",2,0],["خَوَّفتُماني اللَهَ رَبَّكُما","وَكَخيفَتيهِ رَجائُهُ عِندي",82,"ي",1,0],["خولِفَ في خِلعَةٍ فَوافى","يَمزِجُ مِن صالِحٍ بِفاسِد",83,"د",1,0],["خوصاً يُجاذِبنَ النُخَر","قَدِ اِنطَوَت مِنها السُرَر",84,"ر",1,0],["خَواضِعُ في البُرى أَفنى ذُراها","رَواحُ عَشِيَّةٍ ثُمَّ اِبتِكارُ",85,"ر",1,0],["خَودٌ إِذا جَنَحَ الظَلامُ فَإِنَّها","تَكفي الأَوانِسَ فَقدَةَ المِصباحِ",86,"ح",1,0],["خَوَدٍ إِذا جَنَحَ الظَلامُ فَإِنَّها","تَكفي المُؤانِسَ فَقدَةَ المِصباحِ",87,"ح",1,0],["خَودٌ إِذا اِنتَقَبَت سَبَتكَ بِنَظرَةٍ","وَأَغَرَّ أَبلَجَ غَيرَ ذاتِ نِقابِ",88,"ب",1,0],["خَواطِئُ غَيرُ أَسهُمِها خَواطٍ","لِكُلِّ كَبيرَةٍ مُتَعَمِّداتُ",89,"ت",1,0],["خَوى دَنُّ شَربٍ فَاِستَحابوا إِلى التُقى","فَعيسُهُمُ نَحوَ الطَوافِ خَوادي",90,"ي",1,1],["خَواتِمُ أَعمالِ الفَتى إِن بَغى الهُدى","هَدَتهُ وَإِلّا فَالهُمومُ ضَوافي",91,"ف",2,0],["خَوى لِيَ نَجمٌ في قَديمٍ وَحادِثٍ","وَتُذكَرُ أَوقاتٌ مَضَينَ خَوالِ",92,"ل",1,0],["خَوَّفونا مِنَ القِرانِ وَلا بُدَّ","لِنَفسٍ مَعَ الرَدى مِن قِرانِ",93,"ن",1,0],["خُوارَ المَطافيلِ المُلَمَّعَةِ الشَوى","وَأَطلائِها صادَفنَ عِرنانَ مُبقِلا",94,"ل",2,0],["خَودٌ مُبَتَّلَةُ العِظامِ كَأَنَّها","بَردِيَّةٌ نَبَتَت خِلالَ غُروسِ",95,"س",1,0],["خوف الجحيم هو الذي قد صير","الإنسان مشتاقاً إلى الجنات",96,"ت",1,0],["خوفاً من العين أن يصاب بها",