te.com/ViewPoem.aspx?id=35235",""],[585,"لله در مجاهدٍ ما يفتر","https://www.poetsgate.com/ViewPoem.aspx?id=161920",""],[5072,"نجاة الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=52564",""],[5121,"من نوركم","https://www.poetsgate.com/ViewPoem.aspx?id=34103",""],[5136,"صافحت ريح الصبا روض الخزامى","https://www.poetsgate.com/ViewPoem.aspx?id=121655",""],[5145,"ولقد نصحت مدامعي لما بكت","https://www.poetsgate.com/ViewPoem.aspx?id=108236",""],[5183,"حلبة الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180224",""],[5239,"أهدى إلى ملك الملوك دعائي","https://www.poetsgate.com/ViewPoem.aspx?id=190940",""],[5246,"لبيك من طلب القريض تكرما","https://www.poetsgate.com/ViewPoem.aspx?id=187070",""],[5246,"سل ما تريد فقد نريك جوابا","https://www.poetsgate.com/ViewPoem.aspx?id=187074",""],[5246,"يا نسيم الصبح هل أخبرتني","https://www.poetsgate.com/ViewPoem.aspx?id=187067",""],[5277,"القدسُ قصيدتنا","https://www.poetsgate.com/ViewPoem.aspx?id=194982",""],[5431,"احتواء","https://www.poetsgate.com/ViewPoem.aspx?id=185243",""],[5431,"إقرأ ....","https://www.poetsgate.com/ViewPoem.aspx?id=206810",""],[5464,"فضح الهوى سري","https://www.poetsgate.com/ViewPoem.aspx?id=698",""],[5464,"بهمومنا لا بالخمور سكارى","https://www.poetsgate.com/ViewPoem.aspx?id=697",""],[5582,"بَكَرَ الخَلِيطُ مِنَ الدِّيارِ وَراحُوا","https://www.poetsgate.com/ViewPoem.aspx?id=186853",""],[5582,"( نَفْسُ ) المُتَيَّمِ فِي الصَّبابَةِ شانُها","https://www.poetsgate.com/ViewPoem.aspx?id=63591",""],[5672,"نظرة الى تلك القبور","https://www.poetsgate.com/ViewPoem.aspx?id=206505",""],[5672,"عم الوباء","https://www.poetsgate.com/ViewPoem.aspx?id=213759",""],[5720,"خاتمُ النُّبَآءِ ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=198896",""],[4623,"ذكر الحبيب فأطلق العبرات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146689",""],[5818,"إذرفْ دموعك","https://www.poetsgate.com/ViewPoem.aspx?id=193230",""],[5853,"روحان في فلك المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=175614",""],[5885,"حلمي","https://www.poetsgate.com/ViewPoem.aspx?id=195058",""],[5910,"لِي في الهوى حَرْفَانِ","https://www.poetsgate.com/ViewPoem.aspx?id=206237",""],[6068,"طمع الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=177484",""],[6079,"إني إلى لقياكم مشتاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=213531",""],[6102,"دِيوانُ العَربِ...","https://www.poetsgate.com/ViewPoem.aspx?id=182739",""],[469,"ولقد نزلت بروضة حزنية","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574776",""],[6367,"أين الطريق إليك ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80597&r=&rc=0",""]],"verses":[["وَلَقَد نَضَحتُ مِنَ السُلُوِّ وَبَردِهِ","حَرَّ الجَوى فَبَرَدتُ أَيَّ ضِرامِ",0,"م",1,0],["وَلَقَد نَزَلتِ فَلا تَظُنّي غَيرَهُ","مِنّي بِمَنزِلَةِ المُحَبِّ المُكرَمِ",1,"م",1,0],["وَلَقَد ناحَ في الغُصونِ حَمامٌ","فَشَجاني حَنينُهُ وَالنَحيبُ",2,"ب",1,0],["وَلَقَد نَكَبتُ بَني حُريقَةَ نَكبَةً","لَمّا طَعَنتُ صَميمَ قَلبِ الأَخيَلِ",3,"ل",1,0],["وَلَقَد نَراكِ وَأَنتِ صادِقَةُ الهَوى","وَزَمانُنا بِكِ ساكِنٌ لا يَشغَبُ",4,"ب",1,0],["وَلَقَد نَزَلتُ بِخَيرِ مَن وَطِئَ الحَصى","قَيسٍ فَأَثبَتَ نَعلَها وَقِبالَها",5,"ل",3,0],["وَلَقَد نَظَرتُ فَلا اِغتِرابٌ يَقتَضي","كَدَرَ المَآلِ وَلا تَوَقٍّ يَعصِمُ",6,"م",1,0],["وَلَقَدْ نَبَيْتَ مُبَرِّحاً بِكَ مِنْ","أَلَمٍ وَلا تَشْكُو مِنَ الأَلَمِ",7,"م",1,0],["وَلَقَد نَظَرتُ وَما تَمَتُّعُ نَظرَةٍ","في اللَحدِ حَيثُ تَمَكَّنَ المِحفارُ",8,"ر",1,0],["وَلَقَد نَزَلتَ فَكُنتَ أَخبَثَ نازِلٍ","وَظَعَنتَ لا جَذِلاً وَلا مُختارا",9,"ر",2,0],["وَلَقَد نَهَيتُكَ أَن تَسُبَّ مُخَرِّقاً","وَفِراشُ أُمِّكَ كَلبَتانِ وَكيرُ",10,"ر",1,0],["وَلَقَد نَفَعتَ بِما مَنَعتَ تَحَرُّجاً","مَكسَ العُشورِ عَلى جُسورِ الساحِلِ",11,"ل",1,0],["وَلَقَد نَراكِ وَأَنتِ جامِعَةُ الهَوى","إِذ عَهدُ أَهلِكِ كانَ غَيرَ ذَميمِ",12,"م",1,0],["وَلَقَد نِلتُم وَنِلنا مِنكُمُ","وَكَذاكَ الحَربُ أَحياناً دُوَل",13,"ل",1,0],["ولقد نَفيْتَ عن التطوّلِ عيبَهُ","فغدا وأصعبهُ مراماً يسهلُ",14,"ل",1,0],["ولقد نهتْه لو أُعينَ بنهيةٍ","وحِجَىً نواهٍ بعدهُنَّ نواه",15,"ه",1,0],["وَلَقَد نَظَرتُ إِلى الحَمائِمِ في الرُبى","فَعَجِبتُ مِن حالِ الأَنامِ وَحالِها",16,"ل",3,0],["وَلَقَد نَظَرتُ إُِلَيكُم فَكَأَنَّما","أَنا في الرَبيعِ وَفي رُبى لُبنانِ",17,"ن",1,0],["وَلَقَد نَقَلتُ لِنَملِهِ ما تَدَّعي","فَتَعَجَّبَت مِمّا حَكَيتَ كَثيرا",18,"ر",2,0],["وَلَقَد نَصَحتُكَ وَاِجتَهَد","تُ وَأَنتَ بَعدُ تَخَيَّرا",19,"ر",2,0],["ولَقَد نَظَرتُ فَفَاضَ دَمعِي بَعدَما","مَضَتِ الظَّعَائِنُ واحتَجَبنَ بآلِ",20,"ل",1,0],["وَلَقَد نَزَلتَ بِها فَلَم نَرَ قَبلَها","فَلَكاً جَلا شَمسَ النَهارِ عِشاءَ",21,"ا",2,0],["وَلَقَد نَظَرتُكَ وَالرَدى بِكَ مُحدِقٌ","وَالداءُ مِلءُ مَعالِمِ الجُثمانِ",22,"ن",1,0],["وَلَقَد نَهَيتُ الدَمعَ يَومَ سُوَيقَةٍ","فَأَبَت غَوالِبُ عَبرَةٍ ماتُغلَبُ",23,"ب",1,0],["وَلَقَد نَهى لَو كانَ مُنتَهِياً","فَودٌ يُنازِعُ شَيبَهُ نَزَعُه",24,"ع",2,0],["وَلَقَد نَظَرنا في الكِتابِ فَلَم نَجِد","لِمَقالِكُم في آيِهِ تَحقيقا",25,"ق",2,0],["وَلَقَد نَهَيتُ مُخَرِّقاً فَتَخَرَّقَت","بِمُخَرِّقٍ شُطنُ الدِلاءِ شَغورُ",26,"ر",1,1],["وَلَقَد نَهَيتُكَ مَرَّتَينِ وَلَم أَكُن","أُثني إِذا حَمِقٌ ثَنى مَغرورُ",26,"ر",1,0],["وَلَقَد نَمَت بِكَ لِلمَعَلّى سورَةً","رَفَعَت بِناءَكَ في أَشَمَّ طَويلِ",27,"ل",1,0],["وَلَقَد نَهَضنَ مِنَ العِراقِ بِلُقَّحٍ","قَد أوثِقَت حَلَقاتُهُنَّ وَحولِ",27,"ل",1,0],["وَلَقَد نَهَيتُكُمُ وَقُلتُ لَكُم","لا تَقرَبُنَّ فَوارِسَ الصَيداءِ",28,"ا",2,1],["وَلَقَد نَصَحتُكَ إِن قَبِلتَ نَصيحَتي","وَالنُصحُ أَرخَصُ ما يُباعُ وَيوهَبُ",29,"ب",1,0],["ولقد نَحسَبُها هَشَّت إذا","عائدٌ هَشَّ لها أو عائده",30,"ه",1,0],["ولقد نَحسَبُها تسأَلُنا","حين نَمضِي أفِراقٌ لِعِدَه",30,"ه",1,0],["ولقد نادمْتُ ندامى الرّا","حِ بِمُطّرفي وبِمُتّلَدي",31,"د",2,0],["وَلَقَد نَكونُ وَلا كَريمَ نَنالُهُ","حَتّى نَخوضَ إِلَيهِ أَلفَ لَئيمِ",32,"م",1,0],["وَلَقَدْ نَرَى فِيهَا مَلاعِبَ لَمْ تَزَلْ","تُشْجِي الْفُؤَادَ وَلا نَرَى إِنْسَانَا",33,"ن",2,0],["ولقد نُعرّضُ باللِّقاء لموعدٍ","فيها ونُسْلكُها طريقَ عِتاب",34,"ب",1,0],["وَلَقَد نَعيت لَهُ فَباتَ وَحُزنه","عَين تَسيل بِهِ وَعَين تَجمد",35,"د",1,0],["وَلَقَد نَهَضتُ لِوَطإِكُم فَأَبى","مِثقالُ حِلمٍ راجِحَ الوَزنِ",36,"ن",1,0],["ولقد نزَلْتِ بَنيَّةً علمتْ","ما قد طَوَتْهُ فَهْيَ تَفتَخرُ",37,"ر",1,0],["ولقد نَصَحْتَهُمُ على عُدْوانهم","لكنّهم لا يَقْبلونَ نَصيحَا",38,"ح",2,0],["وَلَقَد نَهَزتُ مَعَ الغُواةِ بِدَلوِهِم","وَأَسَمتُ سَرحَ اللَهوِ حَيثُ أَساموا",39,"م",3,0],["وَلَقَد نُبِّئتُها بَر","صاءَ قُبلاً وَعِجانا",40,"ن",2,0],["ولقد نِكنا بدَين","وقرنّا كم غلاما",41,"م",2,0],["وَلَقَد نَعِمتُ بِروحِها","وَدَفَعتُ عَن جَسَدٍ مُساعِد",42,"د",1,0],["وَلَقَد نضرت إِلى المجر","رة نظرة ذات اِختبار",43,"ر",1,0],["ولقد نعيش وماشيانا بيننا","صلفان وهي غريزة الاتراب",44,"ب",1,0],["ولقد نظرت إلى المنار فما انثنى","طرفي. وهل يثنيه جسم معتم؟",45,"م",1,0],["ولقد نُقِلتُ، فلم أجد لي مكتبًا","يا ضيعةَ الأوراق والأقلام!",46,"م",1,0],["ولقد نمتك إلى الخطابة نسبة","فإذا تنوسيت إلاكم فاذكرا",47,"ر",2,0],["ولقد نظرت إلى الحمائم في الربى","فعجبت من حال الأنام وحمالها",48,"ل",3,0],["ولقدْ نعيشُ وواشِيانا بينَنا","صَلِفَانِ،وَهْيَ غَرِيرَة ُ الأتْرَابِ",49,"ب",1,0],["ولقد نظرت بعين صدق ذا الورى","ووراءها وأمامها والمكتما",50,"م",2,0],["ولقد نزلتَ بمنزلٍ فرداً به","مع جيرة متقاربي الأوطان",51,"ن",1,0],["وَلَقَد نازَلَت مَدينَتُهُ العُظ","مى حُماةٌ لا يَألَمونَ الجِلادا",52,"د",2,0],["وَلَقَد نَزَلتَ بِحَضرَةٍ","مِن كُلِّ نائِبَةٍ مُزيلَه",53,"ل",2,0],["ولقد نهجت لمقتفيك طريقة","ما سنَّها أحد من الأقوام",54,"م",1,0],["ولقد نصحت وللنَّصي","حةِ قابل ومجانب",55,"ب",1,0],["ولقد نظمتُ على النوى","شعراً فلم أحمد نِظَامه",56,"م",2,0],["ولقد نصحتكَ إن قبلتَ نصيحتي","يا حاضراً وكأنه لم يحضر",57,"ر",1,0],["ولقد نهاكم عن عبادة غيرة","نهياً تكرر أيها الثقلان",58,"ن",1,0],["وَلَقَد نَظَرتُ فَرَدَّ طَرفي خاسِئاً","حَذَرُ العِدى وَبَهاءُ ذاكَ المَنظَرِ",59,"ر",1,0],["وَلَقد نَزَلتَ بِعَرشِ رَبك تارِكاً","دارَ الفَناءِ فَكُنتَ أَطيَبَ مَنزِلا",60,"ل",2,0],["ولقد نهضتَ إلى العلا فحويتَ ما","قد كان أَعيا معشرا ورِجالا",61,"ل",2,0],["ولقد نهضتُ بعزمةٍ ما تَنثَني","عمّا أريد وفَتْكةٍ ما تَضْعفُ",62,"ف",1,0],["وَلَقَد نَضا صِبغُ الشَبا","بِ وَكانَ خَيرَ الصِبغَتَينِ",63,"ن",1,0],["وَلَقَد نَزَعتُ عَنِ الغِوا","يَةِ لابِساً ثَوبَ الوَقارِ",64,"ر",1,1],["ولقد نلتها من بعده خير لامة","وأنت بهذا الأرث دون الورى احرى",65,"ر",2,0],["ولَقَدْ نَظَرْتُ فَلَمْ أَجِدْ أقْوَى عَلَى","غَصْبِ النُّهَى مِنْ فَاتِرِ الأجْفَانِ",66,"ن",1,0],["وَلَقَدْ نَعَشْتَ الدِّينَ أَمْسِ مِنَ الَّتِي","ما كادَ واصِمُ عارِها أَنْ يُرْحَضا",67,"ض",2,0],["وَلَقَد نَهاهُ الناصحون عَن الهَوى","فأَبى وَكان هو الرَشيدَ لو اِنتَهى",68,"ه",2,0],["وَلَقَد نَبَذتُ اللَهوَ لا أَرجو سِوى","في أَحمَدَ خَيري وَنِعمَ رَجائي",69,"ا",2,0],["وَلَقَدْ نَزَّهْتُهُمْ فَوْ","قَكَ في مَاءِ وَخُضْرَهْ",70,"ر",2,1],["وَلَقَد نَظَرت دَمي عَلى خَدّ الَّذي","أَجرى دَمي مِن مُقلَتيهِ بِأَسهُمِ",71,"م",1,1],["وَلَقَد نِلتَ في حِمى العزِّ وَالجاه","مِن رِحاب الأَمين عَيشاً خضالا",72,"ل",2,0],["وَلَقد نَظَرت إِلى الحمى فَوَجدته","يَختالُ في حُلَلٍ مِن الإِعجابِ",73,"ب",1,0],["وَلَقَد نظمت مِنَ الدُموع قَلائِدا","وَفَتنت فيك وَأَنتَ بي لا تَشعر",74,"ر",1,0],["ولقد نَزلتُ من الملوكِ بماجدٍ","فَقْرُ الرِّجالِ إليه مِفْتاحُ الغنى",75,"ن",2,0],["ولقد نشَرْتَ العلمَ نَشْراً في الوَرى","في الأرضِ حتّى لم تُخَلِّ جَهُولا",76,"ل",2,0],["ولَقَد نَجوتُ وللأَخامِصِ مِنهُمُ","خلفِي العثارُ وللوُجُوهِ العِثيَرُ",77,"ر",1,0],["وَلَقَد نَظَرنا حِلمَه","فَإِذا الجِبالُ سَرابُ حِلمِه",78,"ه",1,0],["ولَقَد نَجا إِذ لَم يَدَع","في مِثلِ ذاكَ الصَّدر غِلا",79,"ل",2,0],["ولقد نصحتُ عليكَ إذ","حلَّت بساحتِك الوفودُ",80,"د",1,0],["ولقد نصحتُك لو سَمِعْتَ","ولو قبلتَ نصيحتي",81,"ت",2,0],["ولقَدْ نَزَلْتُ بها فقلتُ مؤرِّخاً","دارُ الإِمارة قد بُنِيتِ بجابر",82,"ر",1,0],["ولقد نزعتُ عن الغرامِ فشاقَني","أرَجٌ نماهُ مندلٌ وكِباءُ",83,"ا",2,0],["ولقد نزعتْ لأمةٍ نبطيّة","تُبديك آنفةً لها الفُصَحاءُ",83,"ا",2,0],["ولقد نهتني الأربعون وأصرخت","شيبي ففضي عندهنّ مميل",84,"ل",1,0],["ولقد نَدَبْتَ لِحَرْبِهِ فِي بَطْنِها","قَرْعَ الظُنونِ ومُرْجِفَ الأوْهامِ",85,"م",1,0],["ولقد نَثَرْتُ عَلَيْكَ شَكلَكَ جَوْهَراً","لا مَا قمَشتُ وضمَّ حبلُ الحاطبِ",86,"ب",1,0],["ولقد نزلنا مكة في رابع ال","أيام بعد منى بنيل الأمنيه",87,"ي",2,0],["ولقد نصحتُ له لوَ انّ 