,0],["ولقد نما للعلم أنك متعبٌ","صيّرتَ قلبَك بالهموم شغيلا",191,"ل",2,0],["ولقد نظرت إلى مقاطع شعركم","فسررت حين قرأتها إعجابا",192,"ب",2,0],["ولقد نفستَ عني كربة","إذا رماني الدهر منه بالبعاد",193,"د",1,0],["ولقدْ نسينا سنةَ الهادي الَّتي","فيها ينابيعُ الهدى وعيونُ",194,"ن",1,0],["ولقد نظرتُ إليَّ نظرة عاشقٍ","إذْ قد لمحتك بالحشا تؤويني",195,"ن",2,1],["ولقد نظرتُ فما رأيت على المدى","إلاك من وطأ البسيطة قائدا",196,"د",2,0],["ولقد نرى لنزيفنا سبباً","وجحود من خذل المنى سبباً",197,"ب",2,0],["ولقد نمجّد في السياسة فاجراً","باسم النضال ونشتم الأبرارا",198,"ر",2,0],["وَلَقَدْ نَجُودُ لَهُنَّ نَحْنُ بِأَنْفُسٍ","مِنَّا وَبِالتَّسْهِيلِ هُنَّ شِحاحُ",199,"ح",1,0],["وَلَقَدْ نَظَمْتُ لَكَ القَرِيضَ مَدائِحاً","وَكأَنَّما أَلفاظُها مَرْجانُها",200,"ن",3,0],["ولقد نظرت قبورهم فوجدتها","تحكي العيون مواجعا ودموعا",201,"ع",2,1],["ولقد نُرانا باعتزالٍ نبتغي","من تلكم العدوى وقاء وقاءِ",202,"ا",2,0],["ولقد نُعِتَّ بخاتمِ النُّبَآءِ في","خيرِ الكلامِ .. بمُحكمِ القرآنِ",203,"ن",1,0],["ولقد نظرت لمانعي من قربه","فوجدت مانع قربه زلاتي",204,"ت",2,0],["ولقد نصحتك لمْ تصخْ لنصيحتي","إحفظْ هواها يا لحسْن الملْبسِ",205,"س",1,0],["ولقد نرى في العمر غايتنا التي","للعاشقين تبسما..وتمكنا!",206,"ن",2,0],["ولقد نأتي غدا زمرا","بدم يقضي على الورم",207,"م",1,0],["ولقد نصحتُ لئامَ قومٍ أدبروا","واستبدَلُوا بالودِّ شرَّ عنادِ",208,"د",1,0],["ولقد نفضت أصاحبي وأقاربي","ولقد أطعت كلامها بسنائها",209,"ا",3,0],["ولقد نزلتُ بمنزلٍ مُتقلِّبٍ","فالكأسُ يُملأُ تارةً ويُراقُ",210,"ق",1,0],["وَلَقَد نَظَرتُ, فَما وَجَدتُ سِوايَ مِن","ثَغرِ الحِمامِ يَمُرُّ, حِينَ يُحَمحِمُ",211,"م",1,0],["ولقد نزلتُ بروضة حَزْنِيَّةٍ","رتعت نواظرنا بها والأَنفسُ",212,"س",1,1],["ولقد نسينا والهوان سعى بنا","للذكريات ولم نعش ذكراكا",213,"ك",2,0]]}