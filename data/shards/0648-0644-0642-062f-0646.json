امل"],[364,"قسما لقد رجع النسيم عليلا","https://www.aldiwan.net/poem60803.html","الكامل"],[366,"أما الذي يخفي الفؤاد فأكبر","https://www.aldiwan.net/poem16985.html","الكامل"],[366,"أما السماح فلم يحط","https://www.aldiwan.net/poem17817.html","مجزوء الكامل"],[371,"سل من أقام من استقلا","https://www.aldiwan.net/poem57228.html","مجزوء الكامل"],[371,"ما بال همك لا يزيد","https://www.aldiwan.net/poem57503.html","مجزوء الكامل"],[402,"يا طرف أنجد بالدموع","https://www.aldiwan.net/poem46723.html","مجزوء الكامل"],[416,"لله منزل جابر من منزل","https://www.aldiwan.net/poem54076.html","الكامل"],[432,"هذا اللوى لا حط منه لواء","https://www.aldiwan.net/poem12549.html","الكامل"],[437,"أشفيت حر جوى ودمعك يهمل","https://www.aldiwan.net/poem2502.html","الكامل"],[439,"أقدمت دون معالم الإسلام","https://www.aldiwan.net/poem34781.html","الكامل"],[439,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[441,"ثم اعتمدنا رمي أول جمرة","https://www.aldiwan.net/poem14327.html","الكامل"],[458,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[461,"فخرت بك الأزمان والحقب","https://www.aldiwan.net/poem16420.html","أحذ الكامل"],[464,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[464,"ولقد نزلت بروضة حزينة","https://www.aldiwan.net/poem3231.html","عموديه"],[464,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[464,"ولقد نزلت ولا أغشك منزلاً","https://www.aldiwan.net/poem3472.html","عموديه"],[464,"كم بين أكناف العذيب وحاجر","https://www.aldiwan.net/poem3505.html","عموديه"],[464,"ولقد نزلت من الجزيرة منزلاً","https://www.aldiwan.net/poem3551.html","عموديه"],[470,"يا بيت عاتكة الذي أتعزل","https://www.aldiwan.net/poem4779.html","الكامل"],[477,"أشجاك قمري الأراك مغردا","https://www.aldiwan.net/poem15234.html","الكامل"],[490,"ذهب الذين عهدتُ أمس برأيهم","https://www.aldiwan.net/poem660.html",""],[537,"ولقد نظرت إلى الشموس ودونها","https://www.aldiwan.net/poem69394.html","الكامل"],[538,"عبد العزيز أنا فداك","https://www.aldiwan.net/poem48004.html","عموديه"],[551,"كم للنواظر من دم مطلول","https://www.aldiwan.net/poem47277.html","الكامل"],[551,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[551,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[558,"بيني وبينك يا قديم جدار","https://www.aldiwan.net/poem34529.html","الكامل"],[562,"أبدى الحسين لنا العذار فقل له","https://www.aldiwan.net/poem52583.html","الكامل"],[575,"شهد اللمى في المرشفين لها","https://www.aldiwan.net/poem3031.html","أحذ الكامل"],[575,"نعم المشوق وأنعم المعشوق","https://www.aldiwan.net/poem3046.html","الكامل"],[575,"نظر الحبيب إلي من طرف خفى","https://www.aldiwan.net/poem3048.html","الكامل"]],"verses":[["وَلَقَد نَضَحتُ مِنَ السُلُوِّ وَبَردِهِ","حَرَّ الجَوى فَبَرَدتُ أَيَّ ضِرامِ",0,"م",1,0],["وَلَقَد نَزَلتِ فَلا تَظُنّي غَيرَهُ","مِنّي بِمَنزِلَةِ المُحَبِّ المُكرَمِ",1,"م",1,0],["وَلَقَد ناحَ في الغُصونِ حَمامٌ","فَشَجاني حَنينُهُ وَالنَحيبُ",2,"ب",1,0],["وَلَقَد نَكَبتُ بَني حُريقَةَ نَكبَةً","لَمّا طَعَنتُ صَميمَ قَلبِ الأَخيَلِ",3,"ل",1,0],["وَلَقَد نَراكِ وَأَنتِ صادِقَةُ الهَوى","وَزَمانُنا بِكِ ساكِنٌ لا يَشغَبُ",4,"ب",1,0],["وَلَقَد نَزَلتُ بِخَيرِ مَن وَطِئَ الحَصى","قَيسٍ فَأَثبَتَ نَعلَها وَقِبالَها",5,"ل",3,0],["وَلَقَد نَظَرتُ فَلا اِغتِرابٌ يَقتَضي","كَدَرَ المَآلِ وَلا تَوَقٍّ يَعصِمُ",6,"م",1,0],["وَلَقَدْ نَبَيْتَ مُبَرِّحاً بِكَ مِنْ","أَلَمٍ وَلا تَشْكُو مِنَ الأَلَمِ",7,"م",1,0],["وَلَقَد نَظَرتُ وَما تَمَتُّعُ نَظرَةٍ","في اللَحدِ حَيثُ تَمَكَّنَ المِحفارُ",8,"ر",1,0],["وَلَقَد نَزَلتَ فَكُنتَ أَخبَثَ نازِلٍ","وَظَعَنتَ لا جَذِلاً وَلا مُختارا",9,"ر",2,0],["وَلَقَد نَهَيتُكَ أَن تَسُبَّ مُخَرِّقاً","وَفِراشُ أُمِّكَ كَلبَتانِ وَكيرُ",10,"ر",1,0],["وَلَقَد نَفَعتَ بِما مَنَعتَ تَحَرُّجاً","مَكسَ العُشورِ عَلى جُسورِ الساحِلِ",11,"ل",1,0],["وَلَقَد نَراكِ وَأَنتِ جامِعَةُ الهَوى","إِذ عَهدُ أَهلِكِ كانَ غَيرَ ذَميمِ",12,"م",1,0],["وَلَقَد نِلتُم وَنِلنا مِنكُمُ","وَكَذاكَ الحَربُ أَحياناً دُوَل",13,"ل",1,0],["ولقد نَفيْتَ عن التطوّلِ عيبَهُ","فغدا وأصعبهُ مراماً يسهلُ",14,"ل",1,0],["ولقد نهتْه لو أُعينَ بنهيةٍ","وحِجَىً نواهٍ بعدهُنَّ نواه",15,"ه",1,0],["وَلَقَد نَظَرتُ إِلى الحَمائِمِ في الرُبى","فَعَجِبتُ مِن حالِ الأَنامِ وَحالِها",16,"ل",3,0],["وَلَقَد نَظَرتُ إُِلَيكُم فَكَأَنَّما","أَنا في الرَبيعِ وَفي رُبى لُبنانِ",17,"ن",1,0],["وَلَقَد نَقَلتُ لِنَملِهِ ما تَدَّعي","فَتَعَجَّبَت مِمّا حَكَيتَ كَثيرا",18,"ر",2,0],["وَلَقَد نَصَحتُكَ وَاِجتَهَد","تُ وَأَنتَ بَعدُ تَخَيَّرا",19,"ر",2,0],["ولَقَد نَظَرتُ فَفَاضَ دَمعِي بَعدَما","مَضَتِ الظَّعَائِنُ واحتَجَبنَ بآلِ",20,"ل",1,0],["وَلَقَد نَزَلتَ بِها فَلَم نَرَ قَبلَها","فَلَكاً جَلا شَمسَ النَهارِ عِشاءَ",21,"ا",2,0],["وَلَقَد نَظَرتُكَ وَالرَدى بِكَ مُحدِقٌ","وَالداءُ مِلءُ مَعالِمِ الجُثمانِ",22,"ن",1,0],["وَلَقَد نَهَيتُ الدَمعَ يَومَ سُوَيقَةٍ","فَأَبَت غَوالِبُ عَبرَةٍ ماتُغلَبُ",23,"ب",1,0],["وَلَقَد نَهى لَو كانَ مُنتَهِياً","فَودٌ يُنازِعُ شَيبَهُ نَزَعُه",24,"ع",2,0],["وَلَقَد نَظَرنا في الكِتابِ فَلَم نَجِد","لِمَقالِكُم في آيِهِ تَحقيقا",25,"ق",2,0],["وَلَقَد نَهَيتُ مُخَرِّقاً فَتَخَرَّقَت","بِمُخَرِّقٍ شُطنُ الدِلاءِ شَغورُ",26,"ر",1,1],["وَلَقَد نَهَيتُكَ مَرَّتَينِ وَلَم أَكُن","أُثني إِذا حَمِقٌ ثَنى مَغرورُ",26,"ر",1,0],["وَلَقَد نَمَت بِكَ لِلمَعَلّى سورَةً","رَفَعَت بِناءَكَ في أَشَمَّ طَويلِ",27,"ل",1,0],["وَلَقَد نَهَضنَ مِنَ العِراقِ بِلُقَّحٍ","قَد أوثِقَت حَلَقاتُهُنَّ وَحولِ",27,"ل",1,0],["وَلَقَد نَهَيتُكُمُ وَقُلتُ لَكُم","لا تَقرَبُنَّ فَوارِسَ الصَيداءِ",28,"ا",2,1],["وَلَقَد نَصَحتُكَ إِن قَبِلتَ نَصيحَتي","وَالنُصحُ أَرخَصُ ما يُباعُ وَيوهَبُ",29,"ب",1,0],["ولقد نَحسَبُها هَشَّت إذا","عائدٌ هَشَّ لها أو عائده",30,"ه",1,0],["ولقد نَحسَبُها تسأَلُنا","حين نَمضِي أفِراقٌ لِعِدَه",30,"ه",1,0],["ولقد نادمْتُ ندامى الرّا","حِ بِمُطّرفي وبِمُتّلَدي",31,"د",2,0],["وَلَقَد نَكونُ وَلا كَريمَ نَنالُهُ","حَتّى نَخوضَ إِلَيهِ أَلفَ لَئيمِ",32,"م",1,0],["وَلَقَدْ نَرَى فِيهَا مَلاعِبَ لَمْ تَزَلْ","تُشْجِي الْفُؤَادَ وَلا نَرَى إِنْسَانَا",33,"ن",2,0],["ولقد نُعرّضُ باللِّقاء لموعدٍ","فيها ونُسْلكُها طريقَ عِتاب",34,"ب",1,0],["وَلَقَد نَعيت لَهُ فَباتَ وَحُزنه","عَين تَسيل بِهِ وَعَين تَجمد",35,"د",1,0],["وَلَقَد نَهَضتُ لِوَطإِكُم فَأَبى","مِثقالُ حِلمٍ راجِحَ الوَزنِ",36,"ن",1,0],["ولقد نزَلْتِ بَنيَّةً علمتْ","ما قد طَوَتْهُ فَهْيَ تَفتَخرُ",37,"ر",1,0],["ولقد نَصَحْتَهُمُ على عُدْوانهم","لكنّهم لا يَقْبلونَ نَصيحَا",38,"ح",2,0],["وَلَقَد نَهَزتُ مَعَ الغُواةِ بِدَلوِهِم","وَأَسَمتُ سَرحَ اللَهوِ حَيثُ أَساموا",39,"م",3,0],["وَلَقَد نُبِّئتُها بَر","صاءَ قُبلاً وَعِجانا",40,"ن",2,0],["ولقد نِكنا بدَين","وقرنّا كم غلاما",41,"م",2,0],["وَلَقَد نَعِمتُ بِروحِها","وَدَفَعتُ عَن جَسَدٍ مُساعِد",42,"د",1,0],["وَلَقَد نضرت إِلى المجر","رة نظرة ذات اِختبار",43,"ر",1,0],["ولقد نظرت إلى المنار فما انثنى","طرفي. وهل يثنيه جسم معتم؟",44,"م",1,0],["ولقد نُقِلتُ، فلم أجد لي مكتبًا","يا ضيعةَ الأوراق والأقلام!",45,"م",1,0],["ولقد نمتك إلى الخطابة نسبة","فإذا تنوسيت إلاكم فاذكرا",46,"ر",2,0],["ولقد نظرت إلى الحمائم في الربى","فعجبت من حال الأنام وحمالها",47,"ل",3,0],["ولقد نظرت بعين صدق ذا الورى","ووراءها وأمامها والمكتما",48,"م",2,0],["ولقد نزلتَ بمنزلٍ فرداً به","مع جيرة متقاربي الأوطان",49,"ن",1,0],["وَلَقَد نازَلَت مَدينَتُهُ العُظ","مى حُماةٌ لا يَألَمونَ الجِلادا",50,"د",2,0],["وَلَقَد نَزَلتَ بِحَضرَةٍ","مِن كُلِّ نائِبَةٍ مُزيلَه",51,"ل",2,0],["ولقد نهجت لمقتفيك طريقة","ما سنَّها أحد من الأقوام",52,"م",1,0],["ولقد نصحت وللنَّصي","حةِ قابل ومجانب",53,"ب",1,0],["ولقد نظمتُ على النوى","شعراً فلم أحمد نِظَامه",54,"م",2,0],["ولقد نصحتكَ إن قبلتَ نصيحتي","يا حاضراً وكأنه لم يحضر",55,"ر",1,0],["ولقد نهاكم عن عبادة غيرة","نهياً تكرر أيها الثقلان",56,"ن",1,0],["وَلَقَد نَظَرتُ فَرَدَّ طَرفي خاسِئاً","حَذَرُ العِدى وَبَهاءُ ذاكَ المَنظَرِ",57,"ر",1,0],["وَلَقد نَزَلتَ بِعَرشِ رَبك تارِكاً","دارَ الفَناءِ فَكُنتَ أَطيَبَ مَنزِلا",58,"ل",2,0],["ولقد نهضتَ إلى العلا فحويتَ ما","قد كان أَعيا معشرا ورِجالا",59,"ل",2,0],["ولقد نهضتُ بعزمةٍ ما تَنثَني","عمّا أريد وفَتْكةٍ ما تَضْعفُ",60,"ف",1,0],["وَلَقَد نَضا صِبغُ الشَبا","بِ وَكانَ خَيرَ الصِبغَتَينِ",61,"ن",1,0],["وَلَقَد نَزَعتُ عَنِ الغِوا","يَةِ لابِساً ثَوبَ الوَقارِ",62,"ر",1,1],["ولقد نلتها من بعده خير لامة","وأنت بهذا الأرث دون الورى احرى",63,"ر",2,0],["ولَقَدْ نَظَرْتُ فَلَمْ أَجِدْ أقْوَى عَلَى","غَصْبِ النُّهَى مِنْ فَاتِرِ الأجْفَانِ",64,"ن",1,0],["وَلَقَدْ نَعَشْتَ الدِّينَ أَمْسِ مِنَ الَّتِي","ما كادَ واصِمُ عارِها أَنْ يُرْحَضا",65,"ض",2,0],["وَلَقَد نَهاهُ الناصحون عَن الهَوى","فأَبى وَكان هو الرَشيدَ لو اِنتَهى",66,"ه",2,0],["وَلَقَد نَبَذتُ اللَهوَ لا أَرجو سِوى","في أَحمَدَ خَيري وَنِعمَ رَجائي",67,"ا",2,0],["وَلَقَدْ نَزَّهْتُهُمْ فَوْ","قَكَ في مَاءِ وَخُضْرَهْ",68,"ر",2,1],["وَلَقَد نَظَرت دَمي عَلى خَدّ الَّذي","أَجرى دَمي مِن مُقلَتيهِ بِأَسهُمِ",69,"م",1,1],["وَلَقَد نِلتَ في حِمى العزِّ وَالجاه","مِن رِحاب الأَمين عَيشاً خضالا",70,"ل",2,0],["وَلَقد نَظَرت إِلى الحمى فَوَجدته","يَختالُ في حُلَلٍ مِن الإِعجابِ",71,"ب",1,0],["وَلَقَد نظمت مِنَ الدُموع قَلائِدا","وَفَتنت فيك وَأَنتَ بي لا تَشعر",72,"ر",1,0],["ولقد نَزلتُ من الملوكِ بماجدٍ","فَقْرُ الرِّجالِ إليه مِفْتاحُ الغنى",73,"ن",2,0],["ولقد نشَرْتَ العلمَ نَشْراً في الوَرى","في الأرضِ حتّى لم تُخَلِّ جَهُولا",74,"ل",2,0],["ولَقَد نَجوتُ وللأَخامِصِ مِنهُمُ","خلفِي العثارُ وللوُجُوهِ العِثيَرُ",75,"ر",1,0],["وَلَقَد نَظَرنا حِلمَه","فَإِذا الجِبالُ سَرابُ حِلمِه",76,"ه",1,0],["ولَقَد نَجا إِذ لَم يَدَع","في مِثلِ ذاكَ الصَّدر غِلا",77,"ل",2,0],["ولقد نصحتُ عليكَ إذ","حلَّت بساحتِك الوفودُ",78,"د",1,0],["ولقد نصحتُك لو سَمِعْتَ","ولو قبلتَ نصيحتي",79,"ت",2,0],["ولقَدْ نَزَلْتُ بها فقلتُ مؤرِّخاً","دارُ الإِمارة قد بُنِيتِ بجابر",80,"ر",1,0],["ولقد نزعتُ عن الغرامِ فشاقَني","أرَجٌ نماهُ مندلٌ وكِباءُ",81,"ا",2,0],["ولقد نزعتْ لأمةٍ نبطيّة","تُبديك آنفةً لها الفُصَحاءُ",81,"ا",2,0],["ولقد نهتني الأربعون وأصرخت","شيبي ففضي عندهنّ مميل",82,"ل",1,0],["ولقد نَدَبْتَ لِحَرْبِهِ فِي بَطْنِها","قَرْعَ الظُنونِ ومُرْجِفَ الأوْهامِ",83,"م",1,0],["ولقد نَثَرْتُ عَلَيْكَ شَكلَكَ جَوْهَراً","لا مَا قمَشتُ وضمَّ حبلُ الحاطبِ",84,"ب",1,0],["ولقد نزلنا مكة في رابع ال","أيام بعد منى بنيل الأمنيه",85,"ي",2,0],["ولقد نصحتُ له لوَ انّ مكلَّفاً","بالعجب أرعَى سمعَه العذّالا",86,"ل",2,0],["ولقد نَصَرْتَ الدينَ في رَهَجٍ","كادَتْ بهِ الأرْواحُ تُنْتَهَبُ",87,"ب",1,0],["ولقد نثرت عليك نظمَ مدامعي","ويقلُّ أن لو كان نظم فريدِ",88,"د",1,0],["ولقد نزلت بروضة حزينة","رتعت نواظرنا بها والأنفس",89,"س",1,1],["ولقد نزعتُ عن المديح فلم تزل","حتى رجعتُ كأنني لم أنزع",90,"ع",1,0],["ولقد نزلت ولا أغشّك منزلاً","جنَّ الغمام به فليس يفيقُ",91,"ق",1,1],["ولقد نصرت على الليالي والعدى","باخي العزيز الملك وابن النَّاصر",92,"ر",1,0],["ولقد نزلتُ من الجزيرة منزلاً","شملُ السرور بمثله يتجمَّعُ",93,"ع",1,1],["وَلَقَد نَزَلتَ مِنَ الفُؤادِ بِمَنزِلٍ","ما كانَ غَيرُكَ والأَمانَة يَنزِلُ",94,"ل",1,0],["ولقد نهاكَ البينُ يومَ ترحَّلوا","والعيسُ تُحدَجُ فيه أن تتجلَّدا",95,"د",2,0],["وَلَقَد نَكونُ إذا تَحَلَّلَتِ الحُبا","مِنّا الرَئيسُ اِبنُ الرَئيسِ المَقنَع",96,"ع",1,0],["وَلَقَد نَظَرتُ إِلى الشَّموسِ ودونها","حَرَجٌ من الرّحمنِ غَيرُ قليل",97,"ل",1,1],["ولقد نَعَى الناعِي المَحا","مِدَ والمَحَاسنَ إذ نعَاك",98,"ك",1,0],["ولقد نَضَوْتَ الصّومَ عنك ولم تَعُجْ","فيه بجانبِ هفوةٍ وزليلِ",99,"ل",1,0],["وَلَقد نَفعتَ بأنْ ضررتَ وكم لنا","نفعٌ يزور رباعَنا لم ينفعِ",100,"ع",1,0],["وَلَقد نعى وَصْلي لكمْ وبكى بهِ","قبلَ الفراقِ الناعقُ الشَّحّاجِ",101,"ج",1,0],["ولقد نزلت فكنت جملة كوننا","وتفككت عنا بك الأزرار",102,"ر",1,0],["ولَقد نَرى في فِيكَ شَهْدَ فَصاحَةٍ","أرِّخ يحومُ عليهِ نملُ عِذارِ",103,"ر",1,0],["ولقد نَعِمْتَ بحقِّها طرباً","ولقد شَقِيتَ بزورةٍ ولَها",104,"ل",3,0],["ولقد نأَيتِ فضقتُ ذَرْعاً إِذْ أَتى","عبدُ الرَّحيم فزالَ عَنِّي الضَّيقُ",105,"ق",1,0],["ولقد نذرتُ على شفائِك حِجَّةً","ولقد شُفيتَ فقد تعيَّن أَنْ أَفي",106,"ي",1,0]]}