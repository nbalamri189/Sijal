ctabudhabi.ae/diwan/poem/109996","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109978","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72517","الرمل"],[4929,"تسونامي الأتراح","https://www.poetsgate.com/ViewPoem.aspx?id=213359",""],[5033,"عاشقٌ ليسَ إلّا","https://www.poetsgate.com/ViewPoem.aspx?id=183177",""],[5150,"ما كل ما يعلم يقال ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=202901",""],[5344,"عطره الشانيل ..","https://www.poetsgate.com/ViewPoem.aspx?id=180706",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5357,"صادفنّي ثلاث","https://www.poetsgate.com/ViewPoem.aspx?id=15692",""],[5409,"أنت والحق في العلو سواءُ","https://www.poetsgate.com/ViewPoem.aspx?id=155491",""],[3294,"عجبا لقوم مسلمين بزعمهم","https://www.poetsgate.com/ViewPoem.aspx?id=173277",""],[5442,"الذرك الشيب فهلا أرعويت","https://www.poetsgate.com/ViewPoem.aspx?id=114783",""],[5459,"كذبَتْ عليك ..","https://www.poetsgate.com/ViewPoem.aspx?id=213590",""],[5542,"نفحة من بستان الوحي","https://www.poetsgate.com/ViewPoem.aspx?id=10057",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[5774,"وَهِي كالدر مبسماً وكبد ال","https://www.poetsgate.com/ViewPoem.aspx?id=189577",""],[402,"راعنا خطبهم وكان جسيما","https://www.poetsgate.com/ViewPoem.aspx?id=36301",""],[5897,"على بركات الله","https://www.poetsgate.com/ViewPoem.aspx?id=177077",""],[6004,"في يومها الوطني","https://www.poetsgate.com/ViewPoem.aspx?id=59596",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6189,"مرثية للفارس المستقيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83558&r=&rc=25",""],[6265,"المهاجرة اليمنية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84177&r=&rc=0",""],[6302,"هنيئاً للشَّمالِ .. هُناك عيدُ!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86213&r=&rc=11",""]],"verses":[["وَاِستَدرَجَ العَبيدَ وَالأَربابا","سَيلُ رَدىً قَد مَلَأَ الشِعابا",0,"ب",2,0],["وأستَدِرُّ صَوْبَها بمِدْحَةٍ","تَغْرَى لَها الأسْنانُ بالأنامِلِ",1,"ل",1,0],["وَاسْتَدْرَكَ الفَلْتَةَ الشَّنْعَاءَ مِنْ زَمَنٍ","قَدْ أَلْبَسَ الدِّينَ ثَوْبَ الْعَارِ وَالشَّيْنِ",2,"ن",1,0],["واستِدّوا لردِّ كل عدوّ","أنكر الحق ناقضاً للعهود",3,"د",1,0],["واستدخلت إيري فعوَّذْتُه","بربّ ميكالَ وجبريلا",4,"ل",2,0],["واستدلّوا على النفادِ بعادٍ","يُذْهبُ الشكَّ باليقينِ الدليلُ",5,"ل",1,0],["وَاسْتَدَارَ النَّهَارُ حَتَّى تَساوَتْ","كَفَّتَاهُ بَيْنَ الدُّجَى وَالنَّهَارِ",6,"ر",1,0],["وَاسْتدْنَتِ البَلدَ القَصِيَّ فَلَمْ تَدَعْ","لِليَأْسِ مَعْنىً فِي مَجَالِ بِعَادِ",7,"د",1,0],["واستدارت تقص : إن أباها","من (زبيد) وامهّا من (ثقيف)",8,"ف",1,0],["واستدرّ البكا هواك من القل","ب فأفنّى الهوى وأبقى العزاء",9,"ا",2,0],["واستُدْرجَ الكوكَبُ الوضاءُ عن أُفُقٍ","عالي السَّنا يُحْسِرُ الأبصارَ مَرقاه",10,"ا",2,0],["وَاسْتُدْعِيَتْ فأَجابَتْ بعد ما ظَهَرَتْ","في وَجْنَةِ الفَجرِ قبلَ الصُّبحِ تَوريدُ",11,"د",1,0],["واسْتُدْرجَتْ فِي غَفْلَةٍ","طَوَتْهَا إذْ تَأَخَّرَتْ",12,"ت",1,0],["واستدركي فارط الأوقات واجتهدي","عساك بالصدق أن تحمي مساويك",13,"ك",1,0],["وَاِستَدرِكِ الفارِطَ في حَقِّهِ","وَاِخشَ عَلى بَغداذَ مِن مَكرِهِ",14,"ر",2,0],["واسْتدْع طائِفَة الإمام لِغَزْوها","تَسْبِق إلى أمثالِها استدْعاءَها",15,"ا",3,0],["وَاِستَدرَكَ الأَمرَ فَاِختارَ الخِداعَ دَها","للَكِنَّهُ اِحتارَ مُذ بانَت خَديعَتُهُ",16,"ت",2,0],["واستدارت كالعين تعشى وتن","شى بلحاظ مسحورة اللمحات",17,"ت",1,0],["واستدرات شفتاها","في حنانٍ وحنين",18,"ن",1,0],["وَاِستَدارَت رَحى الحَربِ بِقَومٍ","فَقَتيلٌ وَهارِبٌ وَأَسيرُ",19,"ر",1,0],["واستَدِلاّ على الحمى نَشْرَ مِسكٍ","من مَجَرِّ الحسانِ فيه البُرود",20,"د",1,0],["واستَدركت في ذاتها فتحقَّقت","ما ليس يُدرَك بالعيون الهُجَّع",21,"ع",1,0],["واستدت الطرقات حتى ليس","بين الجار والجار القريب سبيل",22,"ل",1,0],["واستدركوا بسعيكم حفيظةً","من أمره ما شعَبَ العجزُ وجَرّْ",23,"ر",1,0],["وَاِستَدارَت بِباهِرِ النورِ حَتّى","ظَنَّها الناظِرونَ قِطعَةَ شَمسِ",24,"س",1,0],["وَاِستَدفَعوا بِالمالِ كلَّ مضرَّةٍ","حتّى أتى الأمرُ العزيزُ المَدفَعِ",25,"ع",1,0],["واستدر به واعتقل وخذه حساما","عن كل حسام ابو المواهب اغناك",26,"ك",1,0],["واستدفعُ جُهْدي بَخْ","سَهُ حظِّي وتَطْفِيفَه",27,"ف",2,0],["وأستدفع العذَّال بالعزمة التي","تُعيدُ مطيلَ العتب وهْوَ مُقصرُ",28,"ر",1,0],["واستدرج السعي في نيل الكمال ولا","تزهد مباديه في عينيك محتقرا",29,"ر",2,0],["واستدم الشكر ولا تطو من","لم ير إلا شاكرا ناشرا",30,"ر",2,0],["واستدلا على الطريق بنشر","حين جرت ليلاي فيه الإزارا",31,"ر",2,0],["واستدلت بالبرق يومض لمحا","وهو بعض الوميض ينذر رعدا",32,"د",2,0],["واستدعت الأطيار طراًّ للغنا","من طل مصداحٍ تفاصح منطقا",33,"ق",2,0],["واستدلوا علي من امرءّاةٍ","ذات عهر كانت لهم دالولا",34,"ل",2,0],["واستدر به منه سحايب احسان","وفيض بهى ياتني ابدا",35,"د",2,0],["واستدفعتْ فيه على","أن لا مُغيثَ بلاءها",36,"ا",3,0],["واستدارت فشيدت","ما بقلبي من الطمع",37,"ع",1,0],["واستدعها فلعلها صرفت","يوم النوى ببلابل الوجد",38,"د",1,0],["وأستديمُ جميلَ الصُّنعِ عندكُمُ","ولا أُبالي أَجارَ الدهرُ أم عدلا",39,"ل",2,0],["واستدبروا أودين فانبعثوا","كالنيِّرات سماؤها المجر",40,"ر",1,0],["وَاِستَدرَجَتني إِلى ما لَستُ أَذكُرُهُ","وَاِفتَرَّ ضاحِكُها عَن لُؤلُؤٍ نَضِرِ",41,"ر",1,0],["وَاِستَدبَروهُم يُكفِئونَ عُروجَهُم","مَورَ الجَهامِ إِذا زَفَتهُ الأَزيَبُ",42,"ب",1,0],["واستدرجتني أمان ثَمّ كاذبة","تغادر الحيّ يحكي ميّتاً درجا",43,"ج",2,0],["وَاِستَدارَت رَحى المَنايا عَلَيهِم","بِلُيوثٍ مِن عامِرٍ وَجَنابِ",44,"ب",1,0],["واستدرك الحظ الذي فاته","قبلا ولا يخفاك أجر المصاب",45,"ب",1,0],["واستدلت أن قتلي عادلاً","كيف هذا صح من غير شهود",46,"د",1,0],["واستدمت الخلافَ رداً على منْ","قال إنّ الرُضابَ يحكي المُداما",47,"م",2,0],["واستدع مدام الأنس بها","واقتبس من جذوتها قبسا",48,"س",2,0],["واستدرك الأعمال قبل الفوت","ومت وأنت الحي قبل الموت",49,"ت",1,0],["واستدارت فهي تحرسه","من فمي بخلاً وترقبه",50,"ب",2,0],["واستدارت رحالهم","بالرديني شرعا",51,"ع",2,0],["واستدارتْ رحى الحروب وولتْ","هرباً حمير تَدوس رِداها",52,"ا",3,0],["واستداروا حول الوصي ولولا","حلمه ما أفادها التأليب",53,"ب",1,0],["واستدرِكوا إِحسانها لكنَّكم","بالإِحتشامِ إِزاءَ حضرتها قِفُوا",54,"ف",3,0],["واستدرِكَن فوتَ الزمانِ ولا تبِع","ياذا النُهى غالي الزمانِ ببخسِهِ",55,"س",2,0],["واستدارت بيننا أقداحها","مثل ما دارت قداح الميسر",56,"ر",1,0],["واستدارت اقدارُها بنُحوسِ الدَّهْ","ر تقتاتُ أهلَها أجيالا",57,"ل",2,0],["واسْتَدَلَّتْ لِنُقْطَةِ الضَّعْفِ لكنْ","كَيفَ تَرنُوْ لِمُنْتَشٍ صَاحَ \" كَلّا \"",58,"ل",2,0],["واستدركتْ.. من ذي سناءُ..؟ بغيرةٍ","ما كان ظني في النساءِ نظيرَها",59,"ر",3,0],["واستدارت بالمدور ألف سبه","لين حصل هالمدور وش يبيله",60,"ل",2,0],["واستدركوا بعد طول النأي عهدهم","لكن بنقض عرىً كانت من القدم",61,"م",1,0],["وإستدارن ،، بجنبي شخص ناداهن \"","\" قلت ذي فرصتي بأقصد وأسمّعهن",62,"ن",1,0],["واستدرجته شريعةٌ بسماحها","لا تعرف الإبهام والتعقيدا",63,"د",2,0],["واستدرك الخطأ الجلي بعزمة","منها تدكدك يذبل وشمام",64,"م",1,0],["واستدرك الباقي ولو ساعة","تكف عن بعض مساع سعيت",65,"ت",1,0],["وَ اسْتَدبِرِ الأحزانَ وارتقِبِ المُنَى","فجرًا يُغِيرُ عَلى حُشَاشَةِ غَيهَبِ ..",66,"ب",1,0],["واستدار التاريخُ لما رآنا","ننقش النور في يدِ الجوزاءِ",67,"ا",2,0],["واستدرجوه.. فدبّروا إدماجَهُ","فأبتْ عروبتُه له أن يُبلَعا!",68,"ع",2,0],["واستدلت بالبرق يُومِض لمحا","وَهُوَ بعد الوميض ينذر رعدا",69,"د",2,0],["واستدروا منك العطاء وفيرا","واصابوا منك الوفاء عميما",70,"م",2,0],["وَاسْتَدْرَجَتْهُ الْعَطَايَا غَيْرَ مُكْتَرِثٍ","كَأنَّهُ حَسِبَ الْأَيَامَ دُونَ غَدِ",71,"د",1,0],["وَاستَدَامتْ بِالشَّرعِ مَجدًا وَعزًّا","قَد عَلَتْ سفحَ الكَونِ بِالرُّحَمَاءِ",72,"ا",2,0],["وَاستد عَن حاجة كحيلة مبرشمة","وَعَن هَرم عاجز أَلف لحية خذونها",73,"ن",3,0],["واستدارت عقاربُ الوقت غرباً","فبدا قصرُنا العظيم ضريحا",74,"ح",2,0],["واستدار الجمالُ في الجسدِ النا","عمِ خَصْرًا حلْوًا وعينينِ أحلى !",75,"ل",2,0],["وأستدني الوجوهَ أطوفُ علِّي ...","أَرى شبهاً .. أُعاودُ .. أَستزيدُ",76,"د",1,0]]}