{"poems":[[57,"أزين نساء العالمين أجيبي","https://www.aldiwan.net/poem26547.html","الطويل"],[24,"ألا أسماء صرمت الحبالا","https://www.aldiwan.net/poem21875.html","الوافر"],[35,"طربت وهاجتك الديار البلاقع","https://www.aldiwan.net/poem25889.html","الطويل"],[42,"تلك عرسي تلومني في التصابي","https://www.aldiwan.net/poem42300.html","الخفيف"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29336","الطويل"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72185","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20985","المنسرح"],[87,"أنْدَلُسِيَّة ٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9527&r=&rc=17",""],[118,"لشماء بعد شتات النوى","https://www.aldiwan.net/poem20958.html","المتقارب"],[211,"أراني كلما قاربت قومي","https://www.aldiwan.net/poem27975.html","الوافر"],[234,"حللت عقد المعاني فاعتلى الكلم","https://www.aldiwan.net/poem50824.html","البسيط"],[240,"سقى منزلا بين الشقيقة والضال","https://www.aldiwan.net/poem31772.html","الطويل"],[415,"دعوني أبح ما مثل وجدي يجحد","https://www.aldiwan.net/poem32497.html","الطويل"],[583,"أتهجر أم لا اليوم من أنت عاشقه","https://www.aldiwan.net/poem710.html",""],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64588","الوافر"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67852","الوافر"],[2251,"","https://poetry.dctabudhabi.ae/diwan/poem/82123","البسيط"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26148","الطويل"],[2761,"","https://poetry.dctabudhabi.ae/diwan/poem/45537","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100287","الوافر"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20535","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123932","الطويل"],[3619,"","https://poetry.dctabudhabi.ae/diwan/poem/33110","الوافر"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21389","الطويل"],[4366,"","https://poetry.dctabudhabi.ae/diwan/poem/31513","الوافر"],[6031,"عَذِيريَ من هَذَا العَذُولِ المُفَنَّدِ","https://www.poetsgate.com/ViewPoem.aspx?id=46273",""]],"verses":[["أَجَشُّ هَزيمُ الرَعدِ دانٍ رَبابُهُ","يَجودُ بِسُقيا شَمأَلٍ وَجَنوبِ",0,"ب",1,0],["أَجَشُّ تَخالُه عَلِقاً إِذا ما","أَرَنَّ عَلى جَواحِرَها وَجالا",1,"ل",2,0],["أَجَشُّ جُمادِيٌّ إِذا عَجَّ عَجَّةً","وَأَقبَلَ يَستَتلي تُسَكُّ المَسامِعُ",2,"ع",1,0],["أَجشَمُ الهَولَ في الكَعابِ وَقِدماً","جَشِمَ الهَولَ ذُو الهَوى في الكَعابِ",3,"ب",1,0],["أجشّ صريحيّ كأن صهيله","مزامير شرب جاوبتها الجلاجل",4,"ل",1,0],["أَجَشَّ هَزِيمٍ في الخَبارِ إذا انْتَحى","هَوادِي عِطْفَيْهِ العِنان مُقرّبِ",5,"ب",1,0],["أَجَشمَها حُبُّها لِمَا فَعَلَت","إذ نامَ عنها لِلغَيِّ حاجِبُها",6,"ب",3,0],["اجشمت شوك السرى حتى أتيت لنا","بالورد كتباً وبالربا عناوينا",7,"ن",2,0],["أَجَشَّ رِبَحلاً لَهُ هَيدَبٌ","يُكَشِّفُ لِلخالَ رَيطاً كَشيفا",8,"ف",2,0],["أُجَشِّمُها مَهامِهَ طامِساتٍ","كَأَنَّ رِمالَ صَحصَحِها قُعودُ",9,"د",1,0],["أَجَشُّ يُبْدي إذا دَغْدَغْتَهُ ضَحِكاً","تُصغي إليه عُقولُ الناس والهِمَمُ",10,"م",1,0],["أُجَشِّمَها الأَخطارَ في غَسَقِ الدُجى","وَأُقذِفُها رَأدَ الضُحى لُجَجِ الآلِ",11,"ل",1,0],["أُجَشِّمُ نَفسي كَتْمَ ما أَنا كاظِمٌ","عَليهِ وما لي بالّذِي رُمتُهُ يَدُ",12,"د",1,0],["أَجَشَّ دَجوجِيٍّ إِذا جادَ جَودَةً","عَلى البيدِ أَوفى وَاِتلِأَبَّت دَوافِقُهْ",13,"ق",2,0],["أجشمها العزائم وهي نضو","وتحت عزائم النفس العلاء",14,"ا",2,0],["أجشَّ كأنَّما قابلتَ منهُ","تَبعُّقَ لُجَّةٍ وحريقَ غابِ",15,"ب",1,0],["أَجشّ مُغلَنطِقٌ مُغدَودِق غَدِقٌ","مُهرَورِق وَدِق مسحنفِرٌ دانِ",16,"ن",1,0],["أُجَشِّمهُم لَيلَ القِفارِ وَظُلَّمَةَ ال","بِحارِ وَكَم ريعوا وَلِلسَيرِ إِرخاءُ",17,"ا",2,0],["أَجَشَّ هَزيمٍ يَخرِقُ الأَرضَ وَبلُهُ","وَيَبري جَديدَ المَيثِ مِنها وَيَعرُقُ",18,"ق",1,0],["أجشم حزناميلاً فميلا","واقطع سهلها بيداً فبيدا",19,"د",2,0],["أَجَشُّ هَزيمُ سَيلُهُ مَعَ وَدقِهِ","تَرى خَشَبَ الغُلّان فِيهِ طَوَافِيا",20,"ي",2,0],["اجشمها اخطار كل مهولة","تماوت فيها الموت وانذعر الذعر",21,"ر",1,0],["أَجَشَّ مِنَ الصَواهِلِ ذي دَوِيٍّ","تَلوحُ البيضُ فيهِ وَالحِرابُ",22,"ب",1,0],["أَجَشُّ إِذا حَنَّت تَواليهِ أَرزَمَت","مَطافيلُهُ تِلقاءَ ما كادَ يَرشَحُ",23,"ح",1,0],["أَجَشُّ مُقَلِّصُ الطَرفَي","نِ في أَحشائِهِ قَبَبُ",24,"ب",1,0],["أَجَشُّ إذَا ما كَفَّ من سيلِهِ طَغَى","وإنْ رُدَّ من ريعانِ طاغيهِ يُزْبِدِ",25,"د",1,0]]}