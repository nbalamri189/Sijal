","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96637","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64698","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136155","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100996","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123141","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27829","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27200","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27933","المجتث"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121195","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93610","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93994","الكامل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122445","البسيط"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104684","الكامل"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/106041","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53026","الرجز"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108402",""],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85065","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85074","الكامل"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122229","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94327","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136452",""],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204233","البسيط"],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[4767,"يد المنون","https://www.poetsgate.com/ViewPoem.aspx?id=215536",""],[5122,"لا تجرح المجروح","https://www.poetsgate.com/ViewPoem.aspx?id=17972",""],[5198,"المسافة","https://www.poetsgate.com/ViewPoem.aspx?id=145107",""],[5273,"زوجتي","https://www.poetsgate.com/ViewPoem.aspx?id=28760",""],[5277,"حشرجة","https://www.poetsgate.com/ViewPoem.aspx?id=190908",""],[5277,"فيالقُ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=192284",""],[5431,"فيك الحسُ يُختزلُ...","https://www.poetsgate.com/ViewPoem.aspx?id=198568",""],[5582,"سَفَرَتْ فَكادَ تَأَلُّقُ الأَنْوارِ","https://www.poetsgate.com/ViewPoem.aspx?id=63514",""],[5587,"جاء الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=196779",""],[5829,"سعير الوجد","https://www.poetsgate.com/ViewPoem.aspx?id=152056",""],[5897,"بين الخوف والرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=156850",""],[5956,"أشكو لمن ليخففَ الأحزانا؟","https://www.poetsgate.com/ViewPoem.aspx?id=215830",""],[6043,"روعة الأمس","https://www.poetsgate.com/ViewPoem.aspx?id=204458",""],[6305,"حياتي ... أنْ أموتَ فِداك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87348&r=&rc=22",""]],"verses":[["أَنْتَ الْوَسِيلَةُ لِي إِلَيْكَ فَلاَ تُضِعْ","قَصْدِي فَمِثْلُكَ مَنْ يَقُولُ وَيَفْعَلُ",0,"ل",1,0],["أَنْتَ الْوَزِيرُ ابْنُ الْوَزيرٍ حَقِيقَةً","إِرْثٌ أَصِيلُ الْحَقِّ فِي الأَحْقَابِ",1,"ب",1,0],["أنت الوزير الذي وزارتُهُ","معدودةٌ في الكبائر الكُبَر",2,"ر",1,0],["أَنتِ الوَفِيَّةُ لا الذِمامُ لَدَيكِ مَذ","مومٌ وَلا عَهدُ الهَوى بِمُضَيَّعِ",3,"ع",1,0],["أَنتَ الوَحيدُ إِذا اِرتَكَبتَ طَريقَةً","وَمَنِ الرَديفُ وَقَد رَكِبتَ غَضَنفَرا",4,"ر",2,0],["أنتَ الورى فاعمُرْ حياةَ الوَرى","باسمٍ منَ الدَّعْوَةِ مُشْتَقّ",5,"ق",1,0],["أنت الوحيد إذا ركبت طريقةً","ومن الرّديف وقد ركبت غضنفرا",6,"ر",2,0],["أَنْتَ الوَزِيرُ مِنَ القَلِيلِ وَنَحْنُ فِي","زَمَنٍ بِهِ الوُزَرَاءُ غَيْرُ قَلِيل",7,"ل",1,0],["أنت الوحيد اللي أأأحبه ووديبه","ياطول فرقك عن العالم ويا عرضه",8,"ض",2,0],["أَنتَ الوَلِيُّ بِلا خَوفٍ وَلا رَهَبٍ","أَنتَ السَخِيُّ بِلا مَنٍّ وَلا كَدَرِ",9,"ر",1,0],["أنتِ الوصيةُ في شرعِ النبيِّ على","أبنائه فابلغي السنغالَ والكابا",10,"ب",2,0],["أَنتَ الوَفِيُّ فَما تُذَمُّ وَبَعضُهُم","تودي بِذِمَّتِهِ عُقابُ مَلاعِ",11,"ع",1,0],["أنتَ الوزيرُ وإنْ تُؤْتَ منشورا","والأمرُ بعدَكَ إنْ لم تُؤتَمَنْ شُورى",12,"ر",2,0],["أنت الودود العفو والرءوف الر","رحيم بل الكريم البر عفوك برنا",13,"ن",2,0],["أنت الوكيل الواسع المبدي ال","معيد الفرد يا تواب فاقبل توبنا",13,"ن",2,0],["أنتَ الوفيُّ الصادقُ الحُبِّ الذي","يَبقَى على طولِ الزَّمانِ الكاذبِ",14,"ب",1,0],["أَنتَ الوَليُّ له تصرّ","حُ بالولاءِ ولستَ تَكْنِي",15,"ن",2,0],["أنت الوزير وقدرك اعترفت به","بين العباد أوائل وأواخر",16,"ر",1,0],["أنت الوصيّ وصيّ المصطفى نَزلتْ","من ذي العلى فيك من فرقان آيونا",17,"ن",2,0],["أنت الوسيلة والآله مؤمل","طوعا له في حكمه ما انتجا",18,"ج",2,0],["أَنتَ الوَحيدُ هُنا وما","لي لا أَقولُ أَنا الوَحيدْ",19,"د",1,0],["أنت الوسيلة للمولى إذا التبست","أمورنا وادلهمت كل دهياء",20,"ا",2,0],["أنت الوغي فاعفني","من جاعل المنوين منا",21,"ن",2,0],["أنت الوجيه الشافع المقبول","لا تخشى مرد",22,"د",1,0],["أَنتَ الوحيدُ وحيدُ عصركَ في العلا","أبداً ومثلك في العلا لم يوجدِ",23,"د",1,0],["أَنت الوحيدُ وحيدُ عصرك لم تزل","في كلِّ مرتبةٍ بمجدكَ أوحدا",24,"د",2,0],["أَنتَ الوحيدُ وحيد العصرِ ما لك من","شكل وشكلك في الأملاك عنقاءُ",25,"ا",2,0],["أنتَ الوحيدُ وحيدُ عصرك لم يكن","لكَ مِن مجادٍ في العلا ومجارِ",26,"ر",1,0],["أَنتَ الوحيدُ وحيدُ العصرِ ما لك من","شكل وشكلُكَ فينا غير موجودِ",27,"د",1,0],["أَنتَ الوَقورُ إذا طاشَتْ حُلومُهمُ","فَزادَكَ اللهُ تَوقيراً وتَثْبِيتا",28,"ت",2,0],["أنت الوجود الصرف والسر الذي","بنيت عليه من الشهود قواعد",29,"د",1,0],["أنت الوزير الذي كانت لدولته","تسعى الأمانيُّ في شوق وتبتدر",30,"ر",1,0],["أنت الوسيلة يا خير الأنام ومَن","هو الملاذ لمن قد هاله الزّلل",31,"ل",1,0],["أنت الوجودُ فما في الكونِ غيركمُ","أما وجودُك أو ما كان من أثرِك",32,"ك",1,0],["أنت الوحيد الذي ضاق الزمان به","أنت المنزه عن كون وأقطار",33,"ر",1,0],["أنت الوليّ الذي قد","صيرت قلبي وليّا",34,"ي",2,0],["أنت الوزير الذي لولاه ما حفظ","الاسلام في عصرنا كلا ولا الدين",35,"ن",1,0],["أَنتَ الولي لِمَن بظلم قَتّلوا","وَعَلى العِدى سُلطانك المَنصور",36,"ر",1,0],["أنت الوحيد محاسناً","إذ ليس ثم مماثلك",37,"ك",1,0],["أنتَ الوَفيُّ وَإِنْ شَطَّ المزارُ فَما","تُْنسيكَ أَصْحَابكَ النَّائِينَ أَصْحَابُ",38,"ب",1,0],["أنت الوسيلة في النوائب كلها","عند المهيمن أكرم الكرماء",39,"ا",2,0],["أنت الولي لكل المؤمنين كما","صح الحديث وبالإسناد قد نقلا",40,"ل",2,0],["أنت الوحيدُ في العلاَ والجد","وفي المساعي ثابتُ الأقدامِ",41,"م",1,0],["انت الوفي لدن تخون أحبةٌ","بل من يمد الى مساعدةٍ يدا",42,"د",2,0],["أنت الوسيلة يا مولاي في أملي","فقم حبيبي باقلاً لي وأكثاري",43,"ر",2,0],["أنت الوسيلة للحبيب المصطفى","من خصه رب العلا بكتابه",44,"ب",2,0],["أنت الوسيلة للآله فسله لي","حسن الختام ونيل كل رجاء",45,"ا",2,0],["أنت الودود الَّذي لا يَنثَني أبداً","عن حُبِّ حبٍّ ولم تفسد محبتهُ",46,"ت",2,0],["أنت الوجود وفيك قد وجد الورى","ولأنت منظر ربنا والمسمع",47,"ع",1,0],["أنت الوزير الذي الدنيا تناط به","وأهلها تبعٌ من دونه خول",48,"ل",1,1],["أنت الوصي ووارثي وأبٌ لِوُل","دي أنتَ مَن فاز الذي قد تابَعه",49,"ع",2,0],["أنت الوفيُّ الذي لا نِدَّ يعدلُهُ","أنت الوفيُّ الذي أوفَى بما وعدا",50,"د",2,0],["أنت الوحيد اللي جدير تشافيه","قدر شعوره ناج روحه مناجا",51,"ج",2,0],["انت الوطن كله من اقصاه ل اقصاه","ارض وحياة وناس يانافل الجيل",52,"ل",1,0],["أنتِ الوريدُ لخافقي يا حُلوَتي","أنتِ العروقُ دِماؤها تَتوزَّعُ",53,"ع",1,0],["انتِ الوعودُ وانتِ العهدُ يحملني","ما بينَ دربِ الهوى من كلِّ منفرجِ",54,"ج",1,0],["أنتَ الوليُّ..وليُّ الخيرِ إنْ طفحتْ","فيَّ الشرورُ ..وأعيتْ خطوتي الحيلُ",55,"ل",1,0],["أنت الورود وقد فاحت محبتها","فيك اغتسلتُ وقلبي مورقٌ خضلُ",56,"ل",1,0],["أَنْتَ الوَحِيدُ وَحِيدُ عَصْرِكَ لَمْ يَكُنْ","لَكَ مِنْ مُحاذٍ فِي العُلا وَمُجارِ",57,"ر",1,0],["أَنْتَ الوَحِيدُ وَ إِنْ نَظَرْتُ خَيَالَهُ","فِيهِ الجَمَالُ بِوَجْهِهِ قَدْ يَفْخَرُ",58,"ر",1,0],["أنت الوليفة استغني بها أبداً","عن الأناسيّ إن غابوا وإن حضروا",59,"ر",3,0],["أنت الولي ونحن هلكى فاحمنا","وتولنا فرياحنا هوجاءُ",60,"ا",2,0],["أنت الوحيدة مَن بوُسْعِك حلُّ ما","هو عالقٌ يترقب الضَّيَعانا",61,"ن",2,0],["أنتِ الوجودُ وما في الأرضِ منطقةٌ","إلا وكانتْ لنا مندوحةَ اللمسِ",62,"س",1,0],["أنتَ الوجودُ ومعنى الكون ِأجمعِهِ","يا آية َاللهِ مَنْ تمشي معَ العُصُر",63,"ر",1,0]]}