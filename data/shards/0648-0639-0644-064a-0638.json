{"poems":[[53,"يا علي العلا ابن قاسم القاسم","https://www.aldiwan.net/poem65944.html","الخفيف"],[91,"فجع المشرقين خطب جليل","https://www.aldiwan.net/poem44704.html","الخفيف"],[91,"في الصدر حتى كدت تردى","https://www.aldiwan.net/poem44868.html","مجزوء الكامل"],[443,"يا هلالا في فلك","https://www.aldiwan.net/poem2494.html","مجزوء الرمل"],[572,"شارفتنا طلائع المهرجان","https://www.aldiwan.net/poem69480.html","الخفيف"],[6093,"تبرج صوت","https://www.poetsgate.com/ViewPoem.aspx?id=206314",""],[572,"شَارفَتْنَا طَلائعُ المهرجانِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9486&r=&rc=343",""]],"verses":[["وعلى ظهره من الدَّيْن ثِقْلٌ","يرتجى أن تحطَّهُ لا محالَهْ",0,"ل",2,0],["وعلى ظهر مدفع حملوه","انما يحمل الجليل الجليل",1,"ل",1,0],["وعلى ظلامتك اصطبر","حتى تعود النار بردا",2,"د",2,0],["وعلى ظلمي الذي","قد تمادى حملك",3,"ك",1,0],["وَعَلَى ظَهْرِهَا فَوَارِسُ تَلْهُو","بِبُزَاةْ تَعْدُو عَلَى غِزْلاَنِ",4,"ن",1,0],["وعلى ظهورِ أوابدٍ لدوائرٍ","غيدٌ تسافرُ والقوافيْ الهَودَجُ",5,"ج",1,0],["وعلى ظَهرِهَا فوراسُ تلهو","ببزاة ٍ تعدُو على غُزْلاَنِ",6,"ن",1,0]]}