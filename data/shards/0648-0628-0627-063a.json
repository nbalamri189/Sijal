{"poems":[[95,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[68,"ألا قل لشر عبيد الإله","https://www.aldiwan.net/poem41383.html","المتقارب"],[257,"أما وجفونك المرضى الصحاح","https://www.aldiwan.net/poem1418.html",""],[276,"لم يبق في الحي من ربع ولا طلل","https://www.aldiwan.net/poem52078.html","البسيط"],[469,"وباغ كفانا كل باغ من الأسى","https://www.aldiwan.net/poem3582.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86610","البسيط"],[469,"","https://poetry.dctabudhabi.ae/diwan/poem/205269","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56379","المجتث"],[3243,"","https://poetry.dctabudhabi.ae/diwan/poem/140230",""],[3672,"","https://poetry.dctabudhabi.ae/diwan/poem/144494","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114358","المنسرح"],[5050,"قضت أحسابنا ألا تدينا","https://www.poetsgate.com/ViewPoem.aspx?id=38191",""],[5101,"إنما الاقصى عقيدة","https://www.poetsgate.com/ViewPoem.aspx?id=197418",""]],"verses":[["وَبِأَغْلَى فَريدِهِ وَحِلاهُ","جَادَ فِي مَدْحِهِ اللِّسَانُ المُبِينُ",0,"ن",1,0],["وَباغي العِبادِ وَباغي العِنادِ","وَهاجي الكِرامِ وَمُغتابِها",1,"ب",3,0],["وَباغٍ أَن يُدال بِلا رِجالٍ","كَباغٍ أَن يَطيرَ بِلا جَناحِ",2,"ح",1,0],["وَباغض بشمت الاعداء بي حسدا","منه فسوموه ذل الويل بالنكل",3,"ل",1,0],["وباغٍ كفانا كلَّ باغ من الأسى","وزفَّ لنا بكرب المنى وهي ناهدُ",4,"د",1,1],["وَبِاغتِرارٍ يَقول الشعر مِن شَغف","بِحُب بَيتٍ لَهُ أَصبَحتَ مُنتَسِبا",5,"ب",2,0],["وباغٍ كفانا كلَّ باغ من الأسى","وزفَّ لنا بكر المنى وهي ناهدُ",6,"د",1,1],["وباغضوه تلاشت","وبادت الحسّاد",7,"د",1,0],["وباغ في عشيرته عزيز","تحالف قومه أن لا يهونا",8,"ن",2,0],["وبأغصان الأماني أبداً","لذوي البؤس من النجح ثمارُ",9,"ر",1,0],["وَبَاغِضٌ تَجُولُ","فِي قَلبِهِ نُصُولُ",10,"ل",1,0],["وباغ في عشيرته عزيز","تحالف قومه ألا يهونا",11,"ن",2,0],["وباغته عدوك كل حين","وسدد حيث لا تخطئ وريده",12,"د",2,0]]}