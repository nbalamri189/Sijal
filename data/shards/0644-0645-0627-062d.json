{"poems":[[77,"لمن طلل نائي المزار بعيده","https://www.aldiwan.net/poem36615.html","الطويل"],[77,"هل كنت تعلم في هبوب الريح","https://www.aldiwan.net/poem36635.html","الكامل"],[77,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[73,"هل النداء الذي أعلنت مستمع","https://www.aldiwan.net/poem11935.html","البسيط"],[30,"لما حططت الرحل عنها واردا","https://www.aldiwan.net/poem29495.html","الرجز"],[83,"أغرى سراة الحي بالإطراق","https://www.aldiwan.net/poem54268.html","الكامل"],[23,"ما بال عينك يا حسان لم تنم","https://www.aldiwan.net/poem21372.html","البسيط"],[51,"بدعة عندي كاسمها بدعه","https://www.aldiwan.net/poem65395.html","السريع"],[51,"لما حق من صد عن مشرب","https://www.aldiwan.net/poem65400.html","المتقارب"],[51,"كريم كثرت قدما","https://www.aldiwan.net/poem65895.html","الهزج"],[51,"قصيدة كرها مثقفها","https://www.aldiwan.net/poem65913.html","المنسرح"],[51,"للناس فيما يكلفون مغارم","https://www.aldiwan.net/poem66333.html","الكامل"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[91,"أنا لست بالحسناء أول مولع","https://www.aldiwan.net/poem8980.html","عموديه"],[85,"هو ذا مذهبي وهذا شعاري","https://www.aldiwan.net/poem7898.html","الخفيف"],[85,"ضمي قناعك يا سعاد أو ارفعي","https://www.aldiwan.net/poem63709.html","الكامل"],[85,"قم حي هذي النيرات","https://www.aldiwan.net/poem63775.html","مجزوء الكامل"],[43,"كفرندي فرند سيفي الجراز","https://www.aldiwan.net/poem9609.html","الخفيف"],[45,"لما حصلنا على العشر التي بقيت","https://www.aldiwan.net/poem65637.html","البسيط"],[61,"أمن العيون تروم فقد عنائه","https://www.aldiwan.net/poem51836.html","الكامل"],[49,"حيل البلى تأتي على المحتال","https://www.aldiwan.net/poem63053.html","الكامل"],[66,"زار وصبغ الظلام قد نصلا","https://www.aldiwan.net/poem40970.html","المنسرح"],[44,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[31,"يا من لقلب دنف مغرم","https://www.aldiwan.net/poem41819.html","السريع"],[105,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[40,"تلك عرسي تلومني في التصابي","https://www.aldiwan.net/poem42300.html","الخفيف"],[52,"قد أغتدي والليل قد تقضى","https://www.aldiwan.net/poem26881.html","الرجز"],[75,"طلب المجد من طريق السيوف","https://www.aldiwan.net/poem69060.html","الخفيف"],[50,"لاح الهوى واستنار العدل والبصر","https://www.aldiwan.net/poem63824.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85861","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16673",""],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67287","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43667","المجتث"],[77,"هل كنت تعلم في هبوب الريح","https://www.poetsgate.com/ViewPoem.aspx?id=33811",""],[51,"للناس فيما يكْلَفُونَ مغارمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=30502",""],[160,"يوم سرور وشفاء صدر","https://www.aldiwan.net/poem59024.html","الرجز"],[186,"إني تفكرت في حرفي على أدبي","https://www.aldiwan.net/poem44159.html","البسيط"],[195,"جزعت أن شت صرف الحي فانفرقوا","https://www.aldiwan.net/poem54414.html","البسيط"],[204,"لم أحضر المجلس شوقا الى","https://www.aldiwan.net/poem53263.html","السريع"],[223,"هذه الدنيا سآمه","https://www.aldiwan.net/poem41925.html","مجزوء الرمل"],[235,"يا مهدي الورد الجني لنا","https://www.aldiwan.net/poem31780.html","السريع"],[235,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[281,"يا من تقدس عن أن يحيط وصف بذاته","https://www.aldiwan.net/poem1360.html",""],[282,"حاولت تهنئة الوزير فلم أجد","https://www.aldiwan.net/poem32797.html","الكامل"],[297,"يا ملكا عم نداه الورى","https://www.aldiwan.net/poem33221.html","السريع"],[303,"لله ذاك الطرف كم فيه من","https://www.aldiwan.net/poem57989.html","السريع"],[377,"أزل يا شقيق الروح مني بقيتي","https://www.aldiwan.net/poem66906.html","الطويل"],[380,"من للمحب المستهام","https://www.aldiwan.net/poem48802.html","مجزوء الكامل"],[393,"ما بال علوى لا ترد جوابي","https://www.aldiwan.net/poem53671.html","الكامل"],[402,"لا ورمان النهود","https://www.aldiwan.net/poem46488.html","مجزوء الرمل"],[429,"أفديه ظبيا سندسي غلائل","https://www.aldiwan.net/poem40088.html","الكامل"],[429,"لله ما أبهي الحسين الذي","https://www.aldiwan.net/poem41002.html","السريع"],[441,"هذا المحصب يا قلوصي من منى","https://www.aldiwan.net/poem14320.html","الكامل"],[453,"من فؤادي يا أم هذي التحية","https://www.aldiwan.net/poem61332.html","الخفيف"],[453,"لم يحصر الفن فن ذهن وانان","https://www.aldiwan.net/poem61805.html","البسيط"],[458,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[464,"وجودك غادر النعمى معينا","https://www.aldiwan.net/poem3274.html","عموديه"],[468,"سكنت بعدك ربع الهم يا سكني","https://www.aldiwan.net/poem59597.html","البسيط"],[529,"قل للإمام ابن الإمام","https://www.aldiwan.net/poem37134.html","مجزوء الرجز"],[551,"صدت وما صدها إلا على ياس","https://www.aldiwan.net/poem47749.html","البسيط"],[558,"من مجيري من فاتر الطرف فاتك","https://www.aldiwan.net/poem34260.html","الخفيف"],[575,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"],[586,"لما حدا بالأيمنين يسار","https://www.aldiwan.net/poem17510.html","الكامل"],[586,"لما حكم الزمان بالتفريق","https://www.aldiwan.net/poem17633.html","الدوبيت"]],"verses":[["لَما حَمَلتْ منّا الضّلوعُ غَرامَها","ولا كانَ هَذا الشّوقُ يَخْبو وَقودُهُ",0,"د",2,0],["لمّا حطَطْتُ لخَيْرِ مَنْ وَطِئَ الثّرَى","بعِنانِ كُلِّ مولِّدٍ وصَريحِ",1,"ح",1,0],["لَمَّا حَلَلْتُ بِأَرضَهِ مُتَمَلِّياً","مَا شِئْتُ مِنْ بِرٍّ وَمِنْ تَرْحِيبِ",2,"ب",1,0],["لَم أَحظَ إِذ هُم عِداً بادٍ نِفاقُهُمُ","إِلّا كَما كُنتُ أَحظى إِذ هُمُ شِيَعُ",3,"ع",1,0],["لَمّا حَطَطتُ الرِحلَ عَنها وارِدا","عَلَفتُها تِبناً وَماءً بارِدا",4,"د",2,1],["لمّا حسبنا أَنْ تُحَوَّلَ أَبْؤُساً","كشفت عوان حروبها عن ساقِ",5,"ق",1,0],["لَم أَحسِبِ الشَمسَ تَبدو بِالعِشاءِ فَقَد","لاقَيتَ شَمساً تُجَلّي لَيلَةَ الظُلَمِ",6,"م",1,0],["لم أحفل الملك ولا ملكه","ما حنَّتِ النيبُ ولا نزعه",7,"ع",2,0],["لما حقُّ من صد عن مشربٍ","لبعض القذى فيه أن يمنعَهْ",8,"ع",2,1],["لما حاسنت إحساني","ولا جاملتَ إجمالي",9,"ل",2,0],["لم أحتشمْ كرَّها عليك ولا","سدَّد منها مواضعَ الخللِ",10,"ل",1,0],["لم أحتسِبْ فيكَ الثوابَ بِمدْحَتِي","إيّاك يا ابن أكارمِ الأقوام",11,"م",1,0],["لم أحاول بها سواك ولكن","شمِلتْ من يَضمُّه الأفقان",12,"ن",1,0],["لَمّا حَلِمتُ بِها حَلِمتُ بِزَهرَةٍ","لا تُجتَنى وَبِنَجمَةٍ لَم تَلُعِ",13,"ع",1,0],["لم أحاسَب وكان في البيت قط","كيف أرضى وليس في البيت فار",14,"ر",1,0],["لَمّا حَلَلتِ بِآدَمٍ حَلَّ الحِبا","وَمَشى عَلى المَلَأ السُجودِ الرُكَّعِ",15,"ع",1,0],["لَمّا حَضَنَّ لَنا القَضِي","يَةَ كُنَّ خَيرَ الحاضِناتِ",16,"ت",1,0],["لَم أُحَمِّلكَ مُعلَماً هَكَذا إِل","لا لِضَربِ الرِقابِ وَالأَجوازِ",17,"ز",1,0],["لَمّا حَصَلنا عَلى العَشرِ الَّتي بَقِيَت","وَأَدبَرَ الشَهرُ عَنّا بَعدَ إِقبالِ",18,"ل",1,1],["لما حماه القَرُّ سفكَ دمائِهم","أضحى يَعدُّ القَرَّ من أعدائِه",19,"ا",3,0],["لَمّا حَصَلتُ عَلى القَناعَةِ لَم أَزَل","مَلِكاً يَرى الإِكثارَ كَالإِقلالِ",20,"ل",1,0],["لَمّا حَوى ما بِهِ","الجَمالُ حَمى",21,"م",2,0],["لَمّا حَلَلتَ الثَغرَ أَصبَحَ عالِياً","لِلرومِ مِن ذاكَ الجِوارِ جُوارُ",22,"ر",1,0],["لَم أَحسَبِ الشَمسَ بِلَيلٍ بَدَت","قَبلي لِذي لَحمٍ وَلا ذي دَمِ",23,"م",1,0],["لمَّا حملتِ الحقَّ أجمعَ والهدى","أمسى بحبلِ اللهِ حَبلُكِ يُوصَلُ",24,"ل",1,0],["لَم أَحُل عَنكَ ما حَيِيتُ بِوُدّي","أَبَداً أَو يَحُولَ لَونُ الغُرابِ",25,"ب",1,0],["لَمّا حَمَلناهُ أَرادَ الفَرضا","أَنَلنَ بَعضاً وَمَنَعنَ بَعضاً",26,"ض",2,0],["لم أُحاربْ نورَ الهدى بالدَّياجي","وحرُوفَ القُرآنِ بالتَّحْريف",27,"ف",1,0],["لَما حَمِدتَ أَميراً بَعدَهُ أَبَداً","وَلا ذَمَمتَ لَنا مَن كانَ يَأتَمِرُ",28,"ر",1,0],["لما حبا الناس","من قبل يسلب",29,"ب",1,0],["لَمّا حَمَتْكَ مَهاتَها","بَعَثَتْ إليكَ خَيَالَها",30,"ل",3,0],["لمّا حواه آله يتيما","حوى فريدا سلكهم يتيما",31,"م",2,0],["لماحَةً لِلْغَيْبِ شَاعِرَةً بِهِ","حَتَّى لَيَحْضُرُهَا الْخَفِيُّ النَّائِي",32,"ا",2,0],["لما حامَتْ فَوارِسُكُمْ بِبَدْرٍ","ولا صَبَرُوا بِهِ عِنْدَ اللِّقاءِ",33,"ا",2,0],["لَم أَحتَمل أَن أَراهُ","بِمَنزِلي فَطَرَدتُه",34,"ت",2,0],["لما حططت لخير من وطيء الثرى","بعنان كل مولد وصريح",35,"ح",1,0],["لم أحتسِبْ فيكَ الثوابَ بِمدْحَتِي","إيّاك يا بن أكارمِ الأقوام",36,"م",1,0],["لما حملت منك وفرى مننا","قلت بصوت مسمع ذا وقر",37,"ر",1,0],["لم أحسد القرد لكنّي نظرت إلى","حالي ومالي كما للقرد مركوب",38,"ب",1,0],["لَمّاحَةً يَرفَعُ الشَخصُ البَعيدُ لَها","قَبلَ العُيونِ إِذا ما اِغرورقَ الحَدَقُ",39,"ق",1,0],["لم أحضر المجلسَ شوقاً الى","كلامِ منصورِ بن عمّارِ",40,"ر",1,1],["لَم أُحارِبهُ بِسَيف","بَل بِصِدقٍ وَاِستِقامَه",41,"م",2,0],["لَم أَحظَ مِنها وَهيَ حاضِرَةٌ","عِندي بِغَيرِ الشَمِّ وَالقُبَلِ",42,"ل",1,0],["لَم أَحظَ مِنها بِسِوى نَظرَةٍ","خالَستُها مِن جانِبِ الخِدرِ",43,"ر",1,0],["لما حباه بأوفى","صلاته في صلاته",44,"ت",2,0],["لَم أَحظَ إِلّا بِالقِيامِ لِمَن أَتى","فَلَقَد دُفِعتُ إِلى المُقيمِ المُقعِدِ",45,"د",1,0],["لمّا حللتَ الطائفَ المُشتَهى","وَصرتَ فيه مأمنَ الخائفِ",46,"ف",1,0],["لما حفظت السحر من جفنه","نظمت حرف النون في العين",47,"ن",1,0],["لما حل في ناسوت آدم ظاهراً","وأعلنه بالعار بين البرية",48,"ه",1,0],["لَم أَحس كاسَك يا حَيا","ة النَفس مِن خَوف الأَثام",49,"م",1,0],["لم أَحكِ الا ما رَوَتهُ نَواصِب","عادتك وَهيَ مُباحَة الأَسلاب",50,"ب",1,0],["لَمْ أحلْ عنكم ولا حُلَّتْ","عُقُودٌ مِنْ عُهودي",51,"د",2,0],["لما حكى الغصن الرطيب قوامهُ","أضحى يميس بحلة الأغصانِ",52,"ن",1,0],["لما حوى الآداب قد زانها","أرخ باطلاق جميل العذار",53,"ر",1,0],["لم أحص عد مديح أحمد لو أنا","كونت كلي للمدائح والسنا",54,"ن",2,0],["لم أحاول تسديديها ثم هيهات","فقد كنت كالشعاع الضحيّه",55,"ي",2,0],["لم أحى في قُربه روحاً ولا بدنا","بل فكرةً فوق أرواحٍ وأبدان",56,"ن",1,0],["لما حَلتْ رشَفاتُها","لم تحلُ لي أوزارُها",57,"ر",3,0],["لما حاربت صرف الدهر ألا","رأيت بوجهك الفتح المبينا",58,"ن",2,0],["لَمّا حَدا بِكَ إِفكُ الكاشِحينَ إِلى","سُبلِ الخِيانَةِ لي إِذ كُنتُ لَم أَخُنِ",59,"ن",1,0],["لَمّا حَلَلْتَ بسُوحِها","تاهَتْ على غُوَطِ الشآمْ",60,"م",1,0],["لمّا حماها سوادُ الليل عن نظرٍ","يهدي الطّريقَ تقرّتْهُ بأنفاسِ",61,"س",1,0],["لم أحل عنك دائماً فافهمي يا","نفس حتى إن كنت في غفلاتك",62,"ك",1,0],["لم أُحصِ كم عانَقْتُ قامَتَهُ","فتكسَّرتْ مِنْ ضمِّه الدُّرَرُ",63,"ر",1,0],["لَمَّا حَدَا بِالأَيْمَنِينَ يَسَارُ","وَسَرى اليَمانُونَ العَشِيَّ وَسَارُوا",64,"ر",3,1],["لَمَّا حَكَمَ الزَّمانُ بِالتَّفْرِيقِ","وَاسْتَبْطَنَ نادِيهِمْ ظُهُورَ النُّوقِ",65,"ق",1,1]]}