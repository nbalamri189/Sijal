{"poems":[[55,"لك السوابق والأوضاح والغرر","https://www.aldiwan.net/poem30458.html","البسيط"],[55,"لعل الدهر أمضى منك غربا","https://www.aldiwan.net/poem30706.html","الوافر"],[53,"لغيرك لا لك التفسير أنى","https://www.aldiwan.net/poem8330.html","الوافر"],[72,"سأعرض عمن راح عني معرضا","https://www.aldiwan.net/poem42835.html","الطويل"],[64,"لا أدعي أني وفيت بعهدكم","https://www.aldiwan.net/poem52494.html","الكامل"],[47,"إسمع مديحي في كعب وما وصلت","https://www.aldiwan.net/poem66803.html","البسيط"],[63,"نسالم هذا الدهر وهو لنا حرب","https://www.aldiwan.net/poem51800.html","الطويل"],[82,"وليل رسبنا في عباب ظلامه","https://www.aldiwan.net/poem31313.html","الطويل"],[71,"ما للزمان عن المروءة عار","https://www.aldiwan.net/poem28776.html","الكامل"],[35,"أأعقر من جرا كريمة ناقتي","https://www.aldiwan.net/poem25838.html","الطويل"],[107,"يا وفود النيل ترتج القرى","https://www.aldiwan.net/poem43055.html","الرمل"],[83,"سل النوم يا موسى وهنئت طيبه","https://www.aldiwan.net/poem61451.html","الطويل"],[77,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[50,"سأركب ما استطعت من الحرام","https://www.aldiwan.net/poem66280.html","الوافر"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62301","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39581","الكامل"],[106,"","https://poetry.dctabudhabi.ae/diwan/poem/199501","الوافر"],[106,"","https://poetry.dctabudhabi.ae/diwan/poem/199479","الهزج"],[106,"","https://poetry.dctabudhabi.ae/diwan/poem/142172","الطويل"],[53,"أُناديك يا من ليس في سمعه وَقْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=29179",""],[215,"صدقت ولكن كيف تلك رواية","https://www.aldiwan.net/poem46328.html","الطويل"],[234,"أأعذر قلبي وهو لي غير عاذر","https://www.aldiwan.net/poem50956.html","الطويل"],[242,"سلام عليكم والحوادث ألوان","https://www.aldiwan.net/poem19283.html","الطويل"],[286,"أتعتبني عمادي عمد عين","https://www.aldiwan.net/poem1395.html",""],[302,"ما بال قلبك لا يزال مولها","https://www.aldiwan.net/poem33086.html","الكامل"],[333,"قالوا الربيع فقلت لا","https://www.aldiwan.net/poem55037.html","مجزوء الكامل"],[354,"أمي الشريعة والمقيم لها أبي","https://www.aldiwan.net/poem15937.html","الكامل"],[369,"أأجفان بيض هن أم بيض أجفان","https://www.aldiwan.net/poem60628.html","الطويل"],[369,"سترن المحاسن إلا العيونا","https://www.aldiwan.net/poem60632.html","المتقارب"],[412,"فؤادي الفداء لها من قبب","https://www.aldiwan.net/poem50210.html","المتقارب"],[463,"أروم الوفاء الصعب بالمطلب السهل","https://www.aldiwan.net/poem56064.html","الطويل"],[463,"لعمر الواشيات بأم عمرو","https://www.aldiwan.net/poem56176.html","الوافر"],[558,"أأعلن ما بي أم أسر فأكتم","https://www.aldiwan.net/poem68411.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122739","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63907","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63981","المتقارب"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145893","المتقارب"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120098","المتقارب"],[1113,"","https://poetry.dctabudhabi.ae/diwan/poem/101180","الطويل"],[310,"","https://poetry.dctabudhabi.ae/diwan/poem/74744","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49544","الطويل"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116535","الكامل"],[2029,"","https://poetry.dctabudhabi.ae/diwan/poem/123711","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71078","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53098","الكامل"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33845","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93535","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93883","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200653","الوافر"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112547","الكامل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112509","الكامل"],[3209,"","https://poetry.dctabudhabi.ae/diwan/poem/79629","الوافر"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121619","الطويل"],[3243,"","https://poetry.dctabudhabi.ae/diwan/poem/140233",""],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62780","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62921","الطويل"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105815","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131087",""],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136912",""],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73227","المتقارب"],[4439,"","https://poetry.dctabudhabi.ae/diwan/poem/105893","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141683","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139499",""],[4727,"نسيبٌ وهجاءْ","https://www.poetsgate.com/ViewPoem.aspx?id=211408",""],[4961,"وصلَّى خلفكَ العملُ المثالي","https://www.poetsgate.com/ViewPoem.aspx?id=37240",""],[4984,"ما تخبئه النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=175560",""],[5001,"في مدح النبي صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=176233",""],[5050,"أعامر أنت عندي خير صاحب","https://www.poetsgate.com/ViewPoem.aspx?id=38196",""],[5186,"ما لواه الكلال والتهويم","https://www.poetsgate.com/ViewPoem.aspx?id=156453",""],[5277,"ابتسامةٌ بطعم الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=197842",""],[5281,"تحتَ أمرِكَ","https://www.poetsgate.com/ViewPoem.aspx?id=199313",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5457,"حوارٌ مع اليأس","https://www.poetsgate.com/ViewPoem.aspx?id=213111",""],[5542,"حسرة في قلب امرأة صومالية","https://www.poetsgate.com/ViewPoem.aspx?id=10029",""],[470,"وأنتِ هنا كأنكِ ما عليكِ!","https://www.poetsgate.com/ViewPoem.aspx?id=177989",""],[5616,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=204848",""],[463,"أروم الوفاءَ الصعبَ بالمطلبِ السهلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60203&r=&rc=259",""],[6259,"فؤادي الفداءُ لها من قببْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59354&r=&rc=2",""]],"verses":[["أَأَعذُرُ الدَهرَ إِذ جارَت حُكومَتُهُ","إِذاً فَفُسِّقَ عُذري حينَ أَعتَذِرُ",0,"ر",1,0],["أَأَعجَبُ مِن خِصامِكَ لي وَجَدّي","رَسولُ اللَهِ يوسَعُ مِنكَ سَبّا",1,"ب",2,0],["أأعرفُهُ ولستُ له نسيباً","وتجهلُهُ وأنتَ له نسيبُ",2,"ب",1,0],["أَأَعظَمُ مِن قَلبي عَلَيَّ مَعَزَّةً","وَإِنِّيَ في هَذا الهَوى لَصَريعُهُ",3,"ع",2,0],["أأعيشُ من بعد الفِراقِ وأدَّعِي","حُسنَ الرعايةِ إنَّني لَكذوبُ",4,"ب",1,0],["أَأَعجَزَتكُم مُكافاتي بِهِ وَلَكُم","مِصرٌ فَما خَلفَها فَالسِندُ فَاليَمَنُ",5,"ن",1,0],["أأعداءَه كفُّوا فإنَّ نصيبَكم","إذا رمتُمُ إدراكَ غايتِه النَّصْبُ",6,"ب",1,0],["أأُعْلِمَ في أحشائِها أنّ عُمْرَهُ","لدى وضعْهِ يومٌ فشيّبه الوهمُ",7,"م",1,0],["أَأُعدُّ منْ قصّادهم طلباً لما","يفنى وتبقى وصمةُ الأخبارِ",8,"ر",1,0],["أَأَعقَرَ مَن جَرّا كَريمَةَ ناقَتي","وَوَصلِيَ مَفروشٌ لِوَصلِ مُنازِلِ",9,"ل",1,1],["أأعدُّوها لأعيانِ القُرَى","أَمْ أعَدُّوها لقومٍ مُعوزِينْ",10,"ن",1,0],["أَأَعرَيتَني مِن ثَوبِ وَصلِكَ بَعدَما","كَسَوتَ الضَنى عِطفَيَّ وَالشَيبَ مَفرِقي",11,"ق",2,0],["أأُعِيرُ لَحظَ العَينِ بهجةَ منْظَرٍ","وأخُونُهُم إنّي إذاً لَخَؤون",12,"ن",1,0],["أأعصي خالقي وأخافُ جاري","وأكتم سرَّ قلبي المستهام",13,"م",1,0],["أَأَعْفوا كمَا يَعْفو الكَرِيمُ فَإِنَّني","أرى الشَّغْبَ فيما بَيْنَنَا مُتَماديا",14,"ي",2,0],["أأعزُّ منا تحتَ ضوئِك أمةٌ","هي بالحياة وبالسيادة أخْلَقُ",15,"ق",1,0],["أأعجب حينما تنسين وجهي؟","نسيتُ أنا ملامحه الخوالي!",16,"ل",2,0],["أأعتذر عن القلب الذي مات","وحلّ محله حجر؟",17,"ر",1,0],["أأعطيك آلامي أأعطيك غصتي؟","أأعطيك روضا صامتا واجم الزهر",18,"ر",1,0],["أَأَعدُو وأَمري لا يسوء مُنافسي","وأمرُك أمرٌ لا يعارضه أمر",19,"ر",1,0],["أأعشق طفلاتٍ وأهجر غادةً","جلاها بوحي الحب والحسن صيقل",20,"ل",1,0],["أأعذِر قلبي وهْوَ لي غير عاذِرٍ","أم أعصِي غرامي وهو ما بين أضلعي",21,"ع",2,1],["أَأَعْذَبَ شَيْءٍ مَا أَمَرَّ فِرَاقُكُمْ","فَمُذْ بِنْتُمُ مَا خَامَرَ الْقَلْبَ سُلْوَانُ",22,"ن",1,0],["أَأَعْلَمَ شَيْءٍ قَدْ جَهِلْتُ مَذَاهِبِي","وَقَدْ كُنْتُ قَبْلَ الْبَيْنِ قَلْبِيَ شَيْحَانُ",22,"ن",1,0],["أأعمدُ للبديع بديعِ عصري","بعين العيّ عنت بالمعين",23,"ن",1,0],["أَأَعادَ عيدَ غرامه طيرٌ شَدا","فَغَدا يحنُّ إِلى زَمانٍ قد زَها",24,"ه",2,0],["أأعيش حتى نلتقي","أم ذاك وهم الذاهل",25,"ل",1,0],["أَأَعَزُّ والِدَتي وَأَنكُرُ والِدي","وَإِلى عَدايَ أَفُرُّ مِن أَعواني",26,"ن",2,0],["أأعداءه لا تُخْرِجوه عنِ الرِّضا","ولا تُحْرِجوهُ فهْو والدّهرُ سِيَّان",27,"ن",1,0],["أأعداءه حاذِروا حِلْمَه","فقد تَخِذَ المَوتَ فيه كَمينا",28,"ن",2,0],["أَأَعطي المُهَنَّد من لا يُمَيِّزُ","بَينَ الفرند وَبينَ الحَرَب",29,"ب",1,0],["أأعذُله هيهاتَ أظلمه إذن","ومن لم ير الإحسانَ لم يُصغ للعذلِ",30,"ل",1,0],["أأعزِفُ عنكُمُ أبغي بصوني","لساني مع مُعاسرةٍ وفكرِ",31,"ر",1,0],["أَأُعلِنُ ما بي أَم أُسِرُّ فَأَكتُمُ","وَكَيفَ وَفي وَجهي مِنَ الحُبِّ مَعلَمُ",32,"م",1,1],["أأَعجَبُ مِن إقدامِهِ وَسماحِهِ","وَعِفَّتِهِ أم حُسنِهِ وَجمالِهِ",33,"ل",2,0],["أأعرضَ سُؤلي حين قيلَ هَجَوْتُه","فيا ليتَهُ يَرْضَى وأَهجو له نفسي",34,"س",2,0],["أأعملت كيدكَ في شاعرٍ","فهذا هو العمل الحابط",35,"ط",1,0],["أأعتِبُ ملّ الكلامُ العِتابَا","أأرقبُ أعيتْ عيوني ارتِقابَا",36,"ب",2,1],["أأعتبُ مُرٌ عِتابي كدمعي","كأنفاسِيَ المثخناتِ اضطرابا",36,"ب",2,0],["أأعزل من صبره يلتقي","كميّا من الحسن شاكي السلاحِ",37,"ح",1,0],["أأعدم رشدي في طلابي للعلى","وانتم بابراج المعالي بدورها",38,"ر",3,0],["أَأعسفُ في ظلماءِ ظُلمِ عَواذلي","وَبهجةِ وجهِ الحبّ وجهة مهجتي",39,"ت",2,1],["أأعفو لِصَرفِ الدَّهْرِ عن هَفَوَاتِهِ","على حينَ لا يأتي عليَّ عِقَاب",40,"ب",1,0],["أأُعاتبُ الأخوان في استبدادهم","دوني بها فأكون شرّ معاتبِ",41,"ب",1,0],["أأعدل عن طرق الهداية للهوى","وأبدل جداّ للوقار بهزله",42,"ل",2,0],["أَأَعْصِيك أَم أَعْصى العُلى وكِلاكما","له عقد قلبي مُوثراً وحَبيبا",43,"ب",2,0],["أأعد لي حقّاً عليك بمدحة","لولاك لم تسمح بلين قياد",44,"د",1,0],["أَأَعزِمُ عَزمَ اليَأسِ فَالمَوتُ دونَهُ","أَم اِقنَعُ بِالإِعراضِ وَالنَظَرِ الشَزرِ",45,"ر",1,0],["أَأُعزي الكَون أَن البَدر غابا","أَم أَهنِّيه بِأَنَّ السَعد آبا",46,"ب",2,1],["أأعرب شادي ألحان عن لحن أورق","وقد كاد يرقى منبر الأيك أو رقى",47,"ق",2,1],["أَأعداءَ العروبة كم أثرتم","علينا من وغىً فتحمّلوها",48,"و",3,1],["أأعيش بينهم شقيّا معدما","وهم غنى ناعم وموظّف",49,"ف",1,0],["أأعيش ينهم شقيا معدما","وهم غني ناعم وموظّف",50,"ف",1,0],["أأعْجبكَ الزّخرُّفُ رَحْلُ قيْسٍ","ألا فَتح النَّمارقَ والشَلِيلا",51,"ل",2,1],["أأعْداءُه خُشْبٌ مُسَنَّدةٌ ولم","تَحِنَّ حَنِينَ الجِذْعَ حين التَّألُّمِ",52,"م",1,0],["أأعتبه وكان من العجائب","قبول العذل في حكم النوائب",53,"ب",1,0],["أأعْذِرُ قومي والرِّماحُ تَلومُ","وذلكَ خَطبٌ في الزّمانِ عَظيمُ",54,"م",1,1],["أَأُعدِلُ قوماً في التمول والغِنى","بقومٍ رموني بالخَصَاصةِ والفقرِ",55,"ر",1,0],["أأعشَقُ لا عَشِقتُ أخا نحولٍ","سوى أني اخو الخَلقِ الظريف",56,"ف",1,0],["أأعجبه أني وفيّ لصاحبي","وإني ودود حين يلتمس الود",57,"د",1,0],["أأعيش السنينَ أضربُ بالجهل","وأزجي الظنون تلو الظنون",58,"ن",1,0],["أأُعرضُ عن دارها بالحمَى","ضلالاً وعنها بمن حلَّ نجدا",59,"د",2,0],["أأعيشُ فيهم ما بَلو","تُهم وقد جَهلوا الأنام",60,"م",1,0],["أأعجبكم له شكل فجئتم","لتبنوا مثله دار القِمار",61,"ر",1,0],["أاُعزيك إذ اُعزيك يا من","عن معاليه ضلت الآراء",62,"ا",2,0],["أأَعْلَقُ وُدَّهَا وأَحِيدُ عنهُ","معاذَ اللهِ مَعْذِرةَ النِّفاقِ",63,"ق",1,0],["أأعبرُ عالمَ الجنَّاتِ فيهِ","أتبرأُ كلُّ أشكال ِ اعتلالي",64,"ل",2,0],["أأعادت الذكرى ابتسامة دربنا","بين الورود فلا حسود أو خصوم",65,"م",1,0],["أأعود ظمئآنا وغيري يرتوي","أيرد عن حوض النبي ..هيام",66,"م",1,0],["أأعتبه وكان من العجائب","قبولي العذل في حكم النوائب",67,"ب",1,0],["أأعاجيب يقظة أم منام","آخذ الروع في مداها يهيم",68,"م",1,0],["أأعيشُ أعوامَ الجفافِ مناجلاً","وحصيدُ روحي يشتكيكِ حطاما",69,"م",2,0],["أَأعِيشُ دونَكَ كَيْفَ لِي بِتَنَفُّسٍ","ذَرَّاتُهُ لا تَحْتَويْكَ؟؛ أَجِبني.",70,"ن",2,0],["أأعود دون الناسإذا أنا مثقل","بالذنب محروم الشفاء عليلا",71,"ل",2,0],["أأعيشُ حقاً في الحياةِ بلا رؤىً!","لا، بلْ سأبقى كارهاً لكَ قائلُ",72,"ل",1,0],["أإعادة الأمل الجميل سجية","للغرب ، هذا يا بني كلاب",73,"ب",1,0],["أأعشقُ هكذا، وأموتُ عِشقاً","وأنتِ هنا كأنَّكِ ما عليك؟!",74,"ك",1,0],["أَأُعاب إن قلتُ الحقيقة مرةً","والظلم يجري مثلما الطوفانِ؟!",75,"ن",1,0],["أَأُعاب يا وطني إذا ما عر