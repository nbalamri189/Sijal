ا سروة في كثيب","https://www.aldiwan.net/poem60423.html","المجتث"],[483,"صبّ برته لواعجُ الش","https://www.aldiwan.net/poem24482.html","عموديه"],[501,"برق حماهم ينجلي","https://www.aldiwan.net/poem37805.html","مجزوء الرجز"],[515,"خطبت المجد بالأسل العوالي","https://www.aldiwan.net/poem20820.html","الوافر"],[530,"ما لبسك الديباج والتاج مع","https://www.aldiwan.net/poem37420.html","السريع"],[552,"ألا غاد دمع العين إن كنت غاديا","https://www.aldiwan.net/poem47140.html","الطويل"],[552,"خيالك يا أميمة كيف زارا","https://www.aldiwan.net/poem47801.html","الوافر"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[565,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"كحل العيون بمرود من عسجد","https://www.aldiwan.net/poem3085.html","الكامل"]],"verses":[["وَجُزنا بِسَيفِ البَحرِ وَالبَحرُ زاخِرٌ","بِلُجَّتِهِ حَتّى وَطِئنا عُبابَها",0,"ب",3,0],["وجَزالةُ البَدَوِيِّ في أثنائِه","مُفْتَرَّةٌ عن رِقَّةِ المُتَحَضِّرِ",1,"ر",1,0],["وجَزاكَ الإلاهُ أفضلَ ما يُجْ","زي كِرامَ الأئِمّةِ النُّصّاح",2,"ح",1,0],["وَجَزورِ أَيسارٍ دَعَوتُ لِحَتفِها","وَنِياطِ مُقفِرَةٍ أَخافُ ضَلالَها",3,"ل",3,0],["وَجَزاءُ رَبِّ المُحسِنينَ يَجِلُّ عَن","عَدٍّ وَعَن وَزنٍ وَعَن مِكيالِ",4,"ل",1,0],["وَجُزِيتمْ بِالخَيْرِ عَنِّيَ يَا مَنْ","أَكْرَمُونِي بِمَا عَدَا آمَالِي",5,"ل",2,0],["وَجَزورِ أَيسارٍ دَعَوتُ لِحَتفِها","بِمَغالِقٍ مُتَشابِهٍ أَجسامُها",6,"م",3,0],["وَجُزنَ المُروجَ وَقَرنَي حَماةَ","وَشَيزَرَ وَالفَجرُ لَم يُسفِرِ",7,"ر",1,0],["وَجُزنَ الصَحصَحانِ يَخِدنَ وَخداً","وَيَجتَبنَ الفَلاةَ بِنا اِجتِنابا",8,"ب",2,0],["وجزى الله جود كفّك عنَّا","وتولاَّك جوده ونواله",9,"ل",2,0],["وجزت بميدان العبادة غايةً","تذكرنا يوم السباق ابنَ أدهم",10,"م",1,0],["وجزتم مدا العلياء لم يتل سبقكم","ولكن على السماع ذكركمُ يتلى",11,"ل",2,0],["وجزاهم ربُّ الجزاء على ذا","لك ما يُشبه اللئيمَ جزاءَ",12,"ا",2,0],["وجزاءُ المدحِ بالمث","لةِ شيءٌ لسْتَ أهلَهْ",13,"ل",2,0],["وجَزَوْكَ أنْ أصبحتَ بين ضلوعِهم","قد بَوَّؤُوكَ من الصدور مدائِنا",14,"ن",2,0],["وجزَتْ جوازي الخيرِ صاحبَ أمرِه","فهُوَ النَّجاةُ أمام كلِّ تجاه",15,"ه",1,0],["وجزيت الخلد عن زمن","كان كل العهد بالزمن",16,"ن",1,0],["وَجَزائِيَ عَن خِدمَتي وَوَفائي","ثَمَنٌ لا يُكَلِّفُ الأَقواما",17,"م",2,0],["وَجُزيتَ أَعلى رُتبَةٍ مَأمولَةٍ","في جَنَّةِ الفِردَوسِ غَيرَ مُعَجَّلِ",18,"ل",1,0],["وجُزْنَ على الصعيدِ مُبَرقَعاتٍ","بَراقِعُهُنَّ ما نَسَجَ الصَّعيدُ",19,"د",1,0],["وَجُزتُ في المَتجَرِ مَع مَعشَرٍ","هَمُّهُمُ في الضَبطِ وَالبَخسِ",20,"س",1,0],["وَجُزتَ بِالحِلَّةِ الفَيحاءِ مُلتَمِحاً","آرامَ سِربٍ حَمَتها أُسدُ عَيّاصِ",21,"ص",1,0],["وجزلُ الأيادي مُغمِدٌ لعُفاتِهِ","سيوفَ الأماني في رقابِ الفواضلِ",22,"ل",1,0],["وجزى اللهُ مَنْ دعا لصديقٍ","بارتفاعٍ وقد رأى ما جرى لي",23,"ي",1,0],["وجزاها اللهُ عنْ آلامها","مِنْ قرى جنتِهِ خيرَ قرى",24,"ر",2,0],["وَجَزاني بِهَوائي","وَثَنائي في المَغيبِ",25,"ب",1,0],["وَجِزعٌ بِأَنداءِ الغَمامِ مُفَضَّضٌ","وَذَيلٌ عَلَيهِ لِلعَشِيِّ مُذَهَّبُ",26,"ب",1,0],["وَجَزَاهُم من وَجنتيه بمَا قَد","صَبَرُوا عَنهُ جَنَّةً وَحَرِيرَا",27,"ر",2,0],["وَجَزانا اليَومَ عاراً","حِينَ يُنثا وَعُيُوبا",28,"ب",2,0],["وَجَزِعَت مِن خَوفِهِ الفَراعِنَه","وَأَصبَحَت سُفنُ البِحارِ آمِنَه",29,"ه",1,0],["وَجُزازٍ فيها الغَريبُ إِذا جا","عَ قَراها فَمالَ بَطناً لِظَهرِ",30,"ر",1,0],["وَجِزيَةُ القَومِ صَدَّت عَنهُمُ فَغَدَت","مَساجِدُ القَومِ مَقروناً بِها البِيَعُ",31,"ع",1,0],["وَجَزَتهُ في عِرسٍ لَهُ أَيّامُهُ","بِفِعالِهِ وَلِكُلِّ حَبلٍ مُمسِكُ",32,"ك",1,0],["وجُزْ عَالمَ الأشباح فالليل شاخصٌ","إليكَ وأضواءُ النجومِ الزَّواهرِ",33,"ر",1,0],["وَجَزَوْهُ بِالذَّلِّ الْعَظِي","مِ كَذَاكَ يُجْزَى مَنْ لَؤُمْ",34,"م",1,0],["وَجَزَى بِالخَيْرِ مَنْ آزَرَهُمْ","فِي المُرُوءَاتِ مِنَ الْقَوْمِ الْخِيَارِ",35,"ر",1,0],["وَجَزَى المُعَمَّرَ مِنْهُمُ","نِعَماً تَدِرُّ بِلاَ نَفَادْ",36,"د",1,0],["وَجُزِيتَ مِنْ فَانِي الوُجُودِ بِخالِدٍ","وَمِنَ الأَسَى المَاضِي بِمُقْتبَلِ الصَّفا",37,"ف",2,0],["وَجَزَاءُ كَدِّكَ ذَلِكَ ال","دَّاءُ الدَّوِيُّ بِه تَثُوبُ",38,"ب",1,0],["وَجَزِعْتُ أَنَّكِ مَا انْتَهَيْتِ إِلى","وَطَرٍ وَلاَ قَصْدٍ مِنَ العُمْرِ",39,"ر",1,0],["وَجَزِعْتُ أَنَّكِ قَدْ وُكِلْتِ بِلاَ","ذَنْبٍ لِظَالِمَةٍ بِلاَ عُذْرِ",39,"ر",1,0],["وَجَزَعْتُ حِينَ فُجِعْتُ فِيهِ","أَنْ تَقَدَّمَ وَهْوَ تِرْبِي",40,"ب",2,0],["وَجُز صِراطَ اللَهِ ثُمَّ اِنتَظِر","أَباكَ في الجَنَّةِ إِن جازَهُ",41,"ه",1,0],["وَجزيتُ الغَدرَ مِنهُ بِغَدرٍ","إِنَّما أوفي بِعَهدِ الوَفِيِّ",42,"ي",1,0],["وَجَزاءُ السَيءِ سَيءٌ وَمَن لَم","يَنتَصِر باءَ بِذُلِّ الشَقيِّ",42,"ي",1,0],["وجزاك الإله أفضل ما يجزى","كرام الأيمة النصاح",43,"ح",1,0],["وَجَزّوا بُرُودَ العَصْبِ تَضْفُو ذُيوُلُها","عَطَاءَ جَوَادٍ، مَا تَكاءَدَهُ البُخْلُ",44,"ل",1,0],["وجزَى ففاتَ البَرْق سبقاً وانتهى","من قبلِ خطفته إلى مطلوبه",45,"ب",2,0],["وجَزَوْكَ أنْ أصبحتَ بين ضلوعِهم","قد بَؤّؤُكَ من الصدور مدائِنا",46,"ن",2,0],["وجزيل علم لا يباح لجاهل","قد حل زاخره مكين مكاني",47,"ن",2,0],["وَجُزتَ المَدى في خَفضِ عَيشٍ وَعِزَّةٍ","يَدينُ لَها سامٍ وَحامٍ وَيافِثُ",48,"ث",1,0],["وَجُزتَ المَدى في خَفضِ عَيشٍ وَدَولَةٍ","مُؤَيَّدَةٍ بِالأَمنِ وَالأَمرِ وَالنَصرِ",49,"ر",1,0],["وَجُزتَ المَدى يابا شُجاعٍ وَلا عَدَت","فِناءَكَ مِن بَعدِ الرِجالِ رِحالُ",50,"ل",1,0],["وجَزْلَ العَطايا والصَّنائعَ والعُلى","وطِيبَ الثَّنا والنظمَ والنثر والصُّحفا",51,"ف",2,0],["وَجَزَاكَ رَبُّ العَرْشِ أَفْضَلَ مَا جَزَى","سُبْحَانَهُ أَهْلَ الْعُلاَ وَالسُّؤْدَدِ",52,"د",1,0],["وَجُزْتَ بِرِيحِ الْحَزْمِ بَحْراً غَطَمْطَماً","فَحُزْتَ بِحَاراً مَا لَهُنَّ سَوَاحِلُ",53,"ل",1,0],["وَجَزَا الْبُرْطَالِ فَلْسٌ","وَجَزَائِي أَلْفُ مِثْقَالْ",54,"ل",1,0],["وَجَزَاكَ الإِلَهُ عَنَّا أَمَوْلاَ","يَ جِنَانَ الْعُلاَ خَيْرَ مُوَاسِ",55,"س",1,0],["وَجَزا كُلَّ مُعرِضٍ","ظَلَّ لِلمالِ يَجمَعُ",56,"ع",1,0],["وجزاء المحسن الوجل","التقي الصالح العمل",57,"ل",1,0],["وَجزئيُّ أربابِ الرئاسَةِ نفعهُ","إِلى الخلقِ كليٌّ إِذا حان تمّهُ",58,"م",2,0],["وَجَزائي بِحُسنِ وُدِّكَ كافٍ","وَوَفائي بِحُسنِهِ أَنتَ لَخَبَرُ",59,"ر",1,0],["وَجُزتُ مِن فَوقِ الصِرا","طِ سابِقاً لَمحَ البَصَر",60,"ر",1,0],["وَجَزيل الأَجر لَيسَ لَهُ","عِندَ ذي الإِحسان تَحديدُ",61,"د",1,0],["وجُزْنا جِبالاً مِلْؤُها كُلُّ ماردٍ","على صَعْبةٍ أعيَتْ على مَنْ يَقودها",62,"د",3,0],["وَجَزاؤُها مِن رُقيَةٍ نَسَقٍ","قُبَلٌ يُؤلِّفُها الهَوى نَسَقا",63,"ق",2,0],["وجزاء نُصحِكَ حينَ قمتَ بأمرِه","وسَرَيتَ بدراً في الظلام كما سرى",64,"ر",2,0],["وجُزيت خيراً بعدها عن أُمَّةٍ","علماؤها مما أفَدْتَ تفيد",65,"د",1,0],["وجزاك الله عنِّي خير ما","جُوزيَ المنعِمُ بالشّكران والحمد",66,"د",1,0],["وجزيتموه على الوفاء قطيعةً","أكذا من الإِنصاف كانَ جزاؤه",67,"ا",3,0],["وجَزلاً من عطاءِ اللهِ أَعْدَى","يَدَيْكَ بِهِ جزيلاتُ العَطَاءِ",68,"ا",2,0],["وجَزَاءُ مَا آوَيْتَ وَحْشَ تَغَرُّبِي","وفَسَحْتَ رَوْضَكَ لارْتِعاءِ سَوَامِي",69,"م",2,0],["وجزنا بوادي محسر ومحصب","وجئنا منى كيما ننال بها المنى",70,"ن",2,0],["وجزية يدفعها عن يد","كلكم المؤمن والمعرض",71,"ض",1,0],["وجُزْتَ الوصف حتى خِلتُ نقصاً","اذا مدحوكَ قولهمُ كَريمُ",72,"م",1,0],["وجزيلَ الصلات لا يعجب الح","سادُ منهُ إن أصبح القول جزلا",73,"ل",2,0],["وَجُزْ إلى الفَضل ِ..لِلصَّدريَّةِ النُّحِرَتْ","لِحارَةِ العَدل ِ ..يا سُوحَ القَرابين ِِ",74,"ن",1,0],["وَجُزتَ طَورَ التَجَنّي","عَلى المُعَنّى الكَئيبِ",75,"ب",1,0],["وجزت على فكري ول","كن طالبا أغرى الحسان",76,"ن",1,0],["وجُزْتُ فوقَ قَدَمي","برَثَّةِ الخُوَيْجِلِ",77,"ل",1,0],["وجُزتَ إلى الثّنا لُجَجَ المَنايا","فخُضْتَ اليمّ في طلبِ اللآلي",78,"ل",2,0],["وجُزَّ إن شِئْتَ بجَزَّازَةٍ","لِحْيَةَ مَنْ جَاءَ يُريدُ الْمِرا",79,"ر",2,0],["وجُزّوا رقابَ الخيلِ حولَ قبابهِ","فلستُ براضٍ أنْ تجزّوا النّواصيا",80,"ي",2,0],["وجُزتَهُمُ وما كانوا بِطاءً","وطُلتَهُمُ وما كانوا قِصارا",81,"ر",2,0],["وجزية كفار النفوس يكون عن","يدٍ وصغارٍ حيث قرر واضع",82,"ع",1,0],["وجز لهم بحراً خميساً عرمرماً","فمن جحفل يقفوه كالموج جحفل",83,"ل",1,0],["وجزيت بميته الإمام","في كل من خلف بالسهام",84,"م",1,0],["وجزَى الإِلَهُ نَدَى الوزيرِ فإِنَّه","أَرْوى صدايَ بِه كَمَا أَغْنَى يَدِي",85,"د",2,0]]}