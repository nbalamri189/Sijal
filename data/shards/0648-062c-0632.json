tsgate.com/ViewPoem.aspx?id=149465",""],[5147,"مددنا بصائرنا لا العيونا","https://www.poetsgate.com/ViewPoem.aspx?id=166673",""],[5338,"مديحك ما يزان به الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=187945",""],[5447,"ظل","https://www.poetsgate.com/ViewPoem.aspx?id=208359",""],[5582,"دَعِينِي وَيْكِ عاذِلَتِي دَعِينِي","https://www.poetsgate.com/ViewPoem.aspx?id=187306",""],[5804,"لا تلم في الزمان حرا غريبا","https://www.poetsgate.com/ViewPoem.aspx?id=215193",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[469,"عادَ من عيد وصلهِ ما تولَّى","https://www.poetsgate.com/ViewPoem.aspx?id=76835",""],[5953,"الله أكبر قددنا الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=93791",""],[5956,"أخشَى أموتُ ولا أراك بجانبي","https://www.poetsgate.com/ViewPoem.aspx?id=193713",""],[5956,"إن كان لا يُعطيك شعري بعضُهم","https://www.poetsgate.com/ViewPoem.aspx?id=194702",""],[5977,"سنابل المدينة","https://www.poetsgate.com/ViewPoem.aspx?id=213793",""],[5989,"يا نجمةً ومضت","https://www.poetsgate.com/ViewPoem.aspx?id=181494",""],[6013,"هكذا في حبكم أستوجب؟","https://www.poetsgate.com/ViewPoem.aspx?id=181606",""],[6031,"يا أَخَا هَاشِمَ أهْلا","https://www.poetsgate.com/ViewPoem.aspx?id=46348",""],[6031,"أَلاَ هَلْ تجاوَزْتَ الخِباءَ المحجَّبَا","https://www.poetsgate.com/ViewPoem.aspx?id=46274",""],[242,"مظنة اتلاف المحب العواذل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563706",""],[6237,"أنشودة العيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77865&r=&rc=7",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""]],"verses":[["وَجُزنا بِسَيفِ البَحرِ وَالبَحرُ زاخِرٌ","بِلُجَّتِهِ حَتّى وَطِئنا عُبابَها",0,"ب",3,0],["وجَزالةُ البَدَوِيِّ في أثنائِه","مُفْتَرَّةٌ عن رِقَّةِ المُتَحَضِّرِ",1,"ر",1,0],["وجَزاكَ الإلاهُ أفضلَ ما يُجْ","زي كِرامَ الأئِمّةِ النُّصّاح",2,"ح",1,0],["وَجَزورِ أَيسارٍ دَعَوتُ لِحَتفِها","وَنِياطِ مُقفِرَةٍ أَخافُ ضَلالَها",3,"ل",3,0],["وَجَزاءُ رَبِّ المُحسِنينَ يَجِلُّ عَن","عَدٍّ وَعَن وَزنٍ وَعَن مِكيالِ",4,"ل",1,0],["وَجُزِيتمْ بِالخَيْرِ عَنِّيَ يَا مَنْ","أَكْرَمُونِي بِمَا عَدَا آمَالِي",5,"ل",2,0],["وَجَزورِ أَيسارٍ دَعَوتُ لِحَتفِها","بِمَغالِقٍ مُتَشابِهٍ أَجسامُها",6,"م",3,0],["وَجُزنَ المُروجَ وَقَرنَي حَماةَ","وَشَيزَرَ وَالفَجرُ لَم يُسفِرِ",7,"ر",1,0],["وَجُزنَ الصَحصَحانِ يَخِدنَ وَخداً","وَيَجتَبنَ الفَلاةَ بِنا اِجتِنابا",8,"ب",2,0],["وجزى الله جود كفّك عنَّا","وتولاَّك جوده ونواله",9,"ل",2,0],["وجزت بميدان العبادة غايةً","تذكرنا يوم السباق ابنَ أدهم",10,"م",1,0],["وجزتم مدا العلياء لم يتل سبقكم","ولكن على السماع ذكركمُ يتلى",11,"ل",2,0],["وجزاهم ربُّ الجزاء على ذا","لك ما يُشبه اللئيمَ جزاءَ",12,"ا",2,0],["وجزاءُ المدحِ بالمث","لةِ شيءٌ لسْتَ أهلَهْ",13,"ل",2,0],["وجَزَوْكَ أنْ أصبحتَ بين ضلوعِهم","قد بَوَّؤُوكَ من الصدور مدائِنا",14,"ن",2,0],["وجزَتْ جوازي الخيرِ صاحبَ أمرِه","فهُوَ النَّجاةُ أمام كلِّ تجاه",15,"ه",1,0],["وجزيت الخلد عن زمن","كان كل العهد بالزمن",16,"ن",1,0],["وَجَزائِيَ عَن خِدمَتي وَوَفائي","ثَمَنٌ لا يُكَلِّفُ الأَقواما",17,"م",2,0],["وَجُزيتَ أَعلى رُتبَةٍ مَأمولَةٍ","في جَنَّةِ الفِردَوسِ غَيرَ مُعَجَّلِ",18,"ل",1,0],["وجُزْنَ على الصعيدِ مُبَرقَعاتٍ","بَراقِعُهُنَّ ما نَسَجَ الصَّعيدُ",19,"د",1,0],["وَجُزتُ في المَتجَرِ مَع مَعشَرٍ","هَمُّهُمُ في الضَبطِ وَالبَخسِ",20,"س",1,0],["وَجُزتَ بِالحِلَّةِ الفَيحاءِ مُلتَمِحاً","آرامَ سِربٍ حَمَتها أُسدُ عَيّاصِ",21,"ص",1,0],["وجزلُ الأيادي مُغمِدٌ لعُفاتِهِ","سيوفَ الأماني في رقابِ الفواضلِ",22,"ل",1,0],["وجزى اللهُ مَنْ دعا لصديقٍ","بارتفاعٍ وقد رأى ما جرى لي",23,"ي",1,0],["وجزاها اللهُ عنْ آلامها","مِنْ قرى جنتِهِ خيرَ قرى",24,"ر",2,0],["وَجَزاني بِهَوائي","وَثَنائي في المَغيبِ",25,"ب",1,0],["وَجِزعٌ بِأَنداءِ الغَمامِ مُفَضَّضٌ","وَذَيلٌ عَلَيهِ لِلعَشِيِّ مُذَهَّبُ",26,"ب",1,0],["وَجَزَاهُم من وَجنتيه بمَا قَد","صَبَرُوا عَنهُ جَنَّةً وَحَرِيرَا",27,"ر",2,0],["وَجَزانا اليَومَ عاراً","حِينَ يُنثا وَعُيُوبا",28,"ب",2,0],["وَجَزِعَت مِن خَوفِهِ الفَراعِنَه","وَأَصبَحَت سُفنُ البِحارِ آمِنَه",29,"ه",1,0],["وَجُزازٍ فيها الغَريبُ إِذا جا","عَ قَراها فَمالَ بَطناً لِظَهرِ",30,"ر",1,0],["وَجِزيَةُ القَومِ صَدَّت عَنهُمُ فَغَدَت","مَساجِدُ القَومِ مَقروناً بِها البِيَعُ",31,"ع",1,0],["وَجَزَتهُ في عِرسٍ لَهُ أَيّامُهُ","بِفِعالِهِ وَلِكُلِّ حَبلٍ مُمسِكُ",32,"ك",1,0],["وجُزْ عَالمَ الأشباح فالليل شاخصٌ","إليكَ وأضواءُ النجومِ الزَّواهرِ",33,"ر",1,0],["وَجَزَوْهُ بِالذَّلِّ الْعَظِي","مِ كَذَاكَ يُجْزَى مَنْ لَؤُمْ",34,"م",1,0],["وَجَزَى بِالخَيْرِ مَنْ آزَرَهُمْ","فِي المُرُوءَاتِ مِنَ الْقَوْمِ الْخِيَارِ",35,"ر",1,0],["وَجَزَى المُعَمَّرَ مِنْهُمُ","نِعَماً تَدِرُّ بِلاَ نَفَادْ",36,"د",1,0],["وَجُزِيتَ مِنْ فَانِي الوُجُودِ بِخالِدٍ","وَمِنَ الأَسَى المَاضِي بِمُقْتبَلِ الصَّفا",37,"ف",2,0],["وَجَزَاءُ كَدِّكَ ذَلِكَ ال","دَّاءُ الدَّوِيُّ بِه تَثُوبُ",38,"ب",1,0],["وَجَزِعْتُ أَنَّكِ مَا انْتَهَيْتِ إِلى","وَطَرٍ وَلاَ قَصْدٍ مِنَ العُمْرِ",39,"ر",1,0],["وَجَزِعْتُ أَنَّكِ قَدْ وُكِلْتِ بِلاَ","ذَنْبٍ لِظَالِمَةٍ بِلاَ عُذْرِ",39,"ر",1,0],["وَجَزَعْتُ حِينَ فُجِعْتُ فِيهِ","أَنْ تَقَدَّمَ وَهْوَ تِرْبِي",40,"ب",2,0],["وَجُز صِراطَ اللَهِ ثُمَّ اِنتَظِر","أَباكَ في الجَنَّةِ إِن جازَهُ",41,"ه",1,0],["وَجزيتُ الغَدرَ مِنهُ بِغَدرٍ","إِنَّما أوفي بِعَهدِ الوَفِيِّ",42,"ي",1,0],["وَجَزاءُ السَيءِ سَيءٌ وَمَن لَم","يَنتَصِر باءَ بِذُلِّ الشَقيِّ",42,"ي",1,0],["وجزاك الإله أفضل ما يجزى","كرام الأيمة النصاح",43,"ح",1,0],["وَجَزّوا بُرُودَ العَصْبِ تَضْفُو ذُيوُلُها","عَطَاءَ جَوَادٍ، مَا تَكاءَدَهُ البُخْلُ",44,"ل",1,0],["وجزَى ففاتَ البَرْق سبقاً وانتهى","من قبلِ خطفته إلى مطلوبه",45,"ب",2,0],["وجَزَوْكَ أنْ أصبحتَ بين ضلوعِهم","قد بَؤّؤُكَ من الصدور مدائِنا",46,"ن",2,0],["وجزيل علم لا يباح لجاهل","قد حل زاخره مكين مكاني",47,"ن",2,0],["وَجُزتَ المَدى في خَفضِ عَيشٍ وَعِزَّةٍ","يَدينُ لَها سامٍ وَحامٍ وَيافِثُ",48,"ث",1,0],["وَجُزتَ المَدى في خَفضِ عَيشٍ وَدَولَةٍ","مُؤَيَّدَةٍ بِالأَمنِ وَالأَمرِ وَالنَصرِ",49,"ر",1,0],["وَجُزتَ المَدى يابا شُجاعٍ وَلا عَدَت","فِناءَكَ مِن بَعدِ الرِجالِ رِحالُ",50,"ل",1,0],["وجَزْلَ العَطايا والصَّنائعَ والعُلى","وطِيبَ الثَّنا والنظمَ والنثر والصّ