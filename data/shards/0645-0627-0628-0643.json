{"poems":[[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[93,"كل ميت مهما علا في حياته","https://www.aldiwan.net/poem8780.html","عموديه"],[47,"بعض هذا العتاب والتفنيد","https://www.aldiwan.net/poem63476.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39567","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142048","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[108,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[98,"عَدْلِي يَكَنْ","https://www.poetsgate.com/ViewPoem.aspx?id=13198",""],[47,"بَعْضَ هَذا العِتَابِ وَالتّفْنيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=31628",""],[168,"لا يفوت الموت من حذر","https://www.aldiwan.net/poem67811.html","المديد"],[215,"فجعت بألطف العلماء روحا","https://www.aldiwan.net/poem46629.html","الوافر"],[215,"ما بكى باك على الحسن الأصيل","https://www.aldiwan.net/poem46773.html","الرمل"],[246,"أيها الفاتك الأثيم رويدا","https://www.aldiwan.net/poem45755.html","الخفيف"],[280,"لبانة المستهام لبنى","https://www.aldiwan.net/poem25508.html","مخلع البسيط"],[422,"جسد ذاب نحولا وسقاما","https://www.aldiwan.net/poem53951.html","الرمل"],[422,"هذه يا صاح أوقات الهنا","https://www.aldiwan.net/poem54091.html","الرمل"],[422,"بارق لاح فأبكاني ابتساما","https://www.aldiwan.net/poem54109.html","الرمل"],[463,"ليتها إذ منعت ماعونها","https://www.aldiwan.net/poem55830.html","الرمل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138092",""],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136897","الرمل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100912","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92050","الرمل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119410","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33430","الخفيف"],[4717,"فرجعناك إلى أمك كي (...)","https://www.poetsgate.com/ViewPoem.aspx?id=199882",""],[4728,"يا يبه","https://www.poetsgate.com/ViewPoem.aspx?id=177013",""],[4869,"جرح وطعون وقتيله","https://www.poetsgate.com/ViewPoem.aspx?id=151618",""],[3591,"يا وجوه الجمال في أرض باري","https://www.poetsgate.com/ViewPoem.aspx?id=149479",""],[5183,"الفقيد الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=180252",""],[5376,"مهما بلغْتَ من هوانِ الدنا","https://www.poetsgate.com/ViewPoem.aspx?id=194866",""],[2599,"بعد الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=14013",""],[5691,"شحرور القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=206593",""],[6056,"كل عصر له رجال ودولة","https://www.poetsgate.com/ViewPoem.aspx?id=130133",""],[6056,"شعاع الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=130143",""],[6056,"المرثية","https://www.poetsgate.com/ViewPoem.aspx?id=130571",""],[6056,"أبدع المنظوم","https://www.poetsgate.com/ViewPoem.aspx?id=156714",""],[6198,"الجدول المهزوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79240&r=&rc=14",""]],"verses":[["ما بُكاءُ الكَبيرِ بِالأَطلالِ","وَسُؤالي فَهَل تَرُدُّ سُؤالي",0,"ل",2,1],["ما بكاءُ الوليدِ إلا لأمرٍ","حُقَّ من مِثله مشيبُ القذالِ",1,"ل",1,0],["ما بَكَينا الرُفاتَ لَمّا بَكَينا","كَم رُفاتٍ في الأَرضِ مِثلُ رُفاتِه",2,"ت",2,0],["ما بَكَينا عَلى زَرودَ وَلَكِن","نا بَكَينا أَيّامَنا في زَرودِ",3,"د",1,0],["ما بكاءٌ على الذي تخذ الأو","طانَ دنياهُ في الحياةِ ودينه",4,"ن",2,0],["ما بكاءٌ على الذي حبس القل","بَ عليها وجيبَه وسكونه",4,"ن",2,0],["ما بكاءٌ عليه لو كان يُفدى","كنتِ يا مصرُ برةً تفتدينه",4,"ن",2,0],["مَا بِكِ صُعْلُوكٌ فأَيٌّ بدَا","أَمْرٌ لهُ في النَّاسِ فَلْيأْمُرِ",5,"ر",1,0],["ما بكت أم على واحدها","عصفَ الموتُ به ليلةَ عرسِ",6,"س",1,0],["ما بُكاءُ الأطفالِ أجدى عليهِ","لاَ ولاَ الصبرُ والتجلُّدُ أغنَى",7,"ن",2,0],["ما بكَت أو غنَّت سواقيك، لكن","لك رَتَّلن آية الشُّكران",8,"ن",1,0],["ما بكاءٌ على الذي اتَّخذَ الأو","طانَ دنياهُ في الحياةِ ودينَهْ؟",9,"ن",2,0],["مَا بَكَيْنَا عَلى زَرُودَ وَلكِنّا","بَكَيْنَا أيّامَنَا في زَرُودِ",10,"د",1,0],["ما بُكاهُم إِن هُمُ قُتِلوا","صَبرُهُم لِلقَتلِ تَفضيلُ",11,"ل",1,0],["ما بكت أدمعي عليك ولكن","قد بكى القلب وهو للحب مهد",12,"د",1,0],["ما بكى باكٍ على الحسن الأصيل","بالذي أبكيت بالشعر الأصيل",13,"ل",1,1],["ما بكى الفونس خشيةً بل غراماً","ودموعُ الغرامِ أَشرفُ قَصدا",14,"د",2,0],["ما بِكَمالاتِهِ ارْتِيابٌ","هَلْ يَسْتَحيل اليَقِين ظَنَّا",15,"ن",2,0],["ما بكى المغرم إلاَّ بدمٍ","بلَّ كُمَّيْهِ وما بلَّ أواما",16,"م",2,0],["ما بكاه القطر إلاَّ ابتسما","لبكاهُ بثغور من أقاحْ",17,"ح",1,0],["ما بكى إلاَّ جرتْ أدمُعُه","فوق خدَّيه سفوحاً وانسجاما",18,"م",2,0],["ما بك الصدُّ ولكن وفرةٌ","لوَّنَتْها نوبٌ تلوينَها",19,"ن",3,0],["ما بكاء الطفل الصغير المعنّى","كبكاء العظيم في اللأواء",20,"ا",2,0],["ما بكاء الطير إلا ذلة","واعتراف لقصور الصائدين",21,"ن",1,0],["ما بكائى علىالزمان وأنتم","أينَما رحتُ أو غدوتُ أمامى",22,"م",2,0],["ما بكى بعدي حسامٌ صارمٌ","لا وَلا ناحَت عَلى بُعدي الأَسل",23,"ل",1,0],["ما بكاء الرياض بالطل الا","خجلا من رياضها وافتضاحا",24,"ح",2,0],["ما بُكائي ولا حنيني ولا شو","قي يا من أحبُّ إلا إليكا",25,"ك",2,0],["ما بكائي الْيَوْمَ عن حُلْم مضى","هل يردُّ الدمعُ مفقوداً عليْ",26,"ي",1,0],["ما بكيت احدٍ بعمري ورب العالمين","غيرك انت الله يطيّب ثراك ويرحمِك",27,"ك",1,0],["مابكى من جور حآله قد مآيبكي خليله","كل مآفكّر يقآوم دقّة اوجآعه طبوله",28,"ل",2,0],["ما بكت مقلتي فى هجر دار","وبكتها يوم الفراق عيوني",29,"ن",2,0],["ما بكى غيرك يا غافل من","خدّد الخد بدمع ساكب",30,"ب",1,0],["ما بكتِ القدسُ ضياعا بها","فالقدسُ تبكي ما بكتْ عَرَبُ",31,"ب",1,0],["مابكائى على ليال ٍ تولت","تحت ظل من الحنان ظليل",32,"ل",1,0],["ما بكَ اليومَ فؤادي أوَ لَمْ","تألَفِ العيشَ حزيناً مُكْلَما ؟",33,"م",2,0],["ما بكل ٍ ، حدر دلوه ، تمكن ّ وعلّ","وما بكل ٍ ، سرى ليله ، بيشعب ذلوله",34,"ل",2,0],["مابكل ٍ ولو راقت ، لعيني تنوب","الغلا منغرس في القلب غرس السهام",35,"م",1,0],["مابكيت إعتراض ٍ للقضاء والقدر","ماكتب تم ، وكل ٍ بيذوق الوفاة",36,"ا",2,0],["مابكل ٍ ، بيصيد ، اللي رماه","إحتمال الرمي ، يخطي أو يصيب",37,"ب",1,0],["ما بكائي على ارتحالِكَ إلا","كبكائي على بريق النجوم",38,"م",1,0]]}