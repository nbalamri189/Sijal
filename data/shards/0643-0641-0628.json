{"poems":[[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66705","الخفيف"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96029","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93695","الكامل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129847","السريع"],[4216,"","https://poetry.dctabudhabi.ae/diwan/poem/20851","الكامل"],[4767,"بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=95450",""]],"verses":[["كفُّ بُرٍّ قال اصنعيه فإنّ","الله قد يجعلُ القليلَ كثيرا",0,"ر",2,0],["كف بها امك الزهراء قد ضربوا","هي التي اختك الحورا بها سلبوا",1,"ب",3,0],["كف بِها يَسطو بِأَمرك لَم نَخل","أَحَداً مِن الدُنيا يَقوم مَقامَها",2,"م",3,0],["كفّ بكفّ للنّدى والرّدى","بها معانٍ وهيَ خرسٌ فصاح",3,"ح",1,0],["كَفٌّ بِمَعروفٍ لَها مَعروفَةٌ","وَيَدٌ لِبَذلٍ بَذلُها مُعتادُ",4,"د",1,0],["كف بما تعطي لذى عوزٍ","يغدو به في خير معتصَمِ",5,"م",1,0]]}