{"poems":[[215,"يا قلب هذا نعيم","https://www.aldiwan.net/poem46564.html","المجتث"],[371,"يا صاحبي هل لك من حيلة","https://www.aldiwan.net/poem17376.html","السريع"],[385,"بكيت لتغريد الحمائم في الفجر","https://www.aldiwan.net/poem49260.html","الطويل"],[563,"إن قلت يا روحي لسبوحي","https://www.aldiwan.net/poem34673.html","السريع"],[563,"أحبني وأنا المعدوم في ذاتي","https://www.aldiwan.net/poem34699.html","المواليا"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64053","الوافر"],[5956,"تسجيل وتصوير ليلة دخلة عريس","https://www.poetsgate.com/ViewPoem.aspx?id=182669",""],[6180,"امرأة في داخلي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81072&r=&rc=6",""]],"verses":[["أحبّ نور الضلال","في ضافيات الغدائر",0,"ر",1,0],["أَحَبَّني الناسُ وَأَبغَضتَني","حَقّا فَما أَنتَ مِنَ الناسِ",1,"س",1,0],["أُحِب نُموّ الوَجد فيهِ صَبابَةً","وَإِن كانَ يَفضي بي إِلى البُؤس وَالضَر",2,"ر",1,0],["أحبني قدماً ومن فرط ما","أحبني صور ملموحي",3,"ح",2,0],["أحبني وأنا المعدوم في ذاتي","وهو الوجود تجلّى بالخيالات",4,"ت",1,1],["أُحِبُّ نحافةَ الرشأ النحيف","وهل يهوى اللطيفَ سوى اللطيفِ",5,"ف",1,1],["أحب نسيما يهب إليَّ","من الدانيات بروضٍ عَطِرْ",6,"ر",1,0],["أُحِبُّني بَعدَكِ في صوتِ الرَّصاصِ حولي","ذاكَ الذي يَغتالُني، يغتالُني تشهيرا",7,"ر",2,0],["أُحِبُّني في كُلِّ مَنْ أهدَيتُهُم أوطاناً","وأبصَروا من بعدِنا النُّورَ، فكانَ نورا",7,"ر",2,0],["أُحِبُّني في ذلِكَ القادِمِ حينَ يأتي","رغماً عن الزَّمانِ يأتي، ثائراً شِرِّيرا",7,"ر",2,0]]}