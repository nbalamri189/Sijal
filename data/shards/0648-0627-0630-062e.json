{"poems":[[48,"لا تخبأن لغد رزقا وبعد غد","https://www.aldiwan.net/poem22953.html","البسيط"],[154,"عن الحب في الهادي استحال سلونا","https://www.aldiwan.net/poem68587.html","الطويل"],[458,"هل كان قانون ابن سينا","https://www.aldiwan.net/poem61763.html","مجزوء الكامل"],[463,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64883","الهزج"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108625","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45459","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94308","البسيط"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109828","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131008",""],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70168","الوافر"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66102","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58111","البسيط"],[5344,"ان شفت طبع البشر كدرك..","https://www.poetsgate.com/ViewPoem.aspx?id=183174",""],[5670,"هَبُونِيْ صَدِيْقًا !","https://www.poetsgate.com/ViewPoem.aspx?id=211216",""]],"verses":[["وَاِذخَر جَميلاً لِأَدنى القوتِ تُدرِكُهُ","وَلِلقِيامَةِ تَعرِف ذاكَ أَجمَعَهُ",0,"ع",2,0],["وَإِذ خُطَّ في المَحفوظِ بِالأُثرَةِ اسمهُُ","غَفَت عَن مراقيهِ العُيونُ وَجِسمُهُ",1,"ه",1,0],["واذخره مثل أشعةِ ال","شمس المنيرة للحياة",2,"ا",2,0],["واذخرْ ثنائي لبني","ك كيمياء صَحَّا",3,"ح",2,0],["وإِذْ خدُّكَ قد زانَتْ","هُ إِذْ زادَ على الوَصْفِ",4,"ف",1,0],["وأذخرت في قلبي سطور عهودها","ولكنها ما أذخرت للوفا سطرا",5,"ر",2,0],["واذّخرت السهاد فيه قياما","لا منام لكم ولا إغفاء",6,"ا",2,0],["وَإِذْ خَطْرَتانا وَالعِلاطانِ حِليَةٌ","عَلى الهَجمَةِ الغُلبِ الطِوالِ السَرادِحِ",7,"ح",1,0],["وإذ خلا ذا الذي اشتدت مصيبته","والناس أني لهم أن يكتموا الأنات",8,"ت",1,0],["واذخر لنفسك صاحباً","سيفاً يبلل بالنجيع",9,"ع",1,0],["واذ خضب الاعداء بالدم ارضه","محوتم خضاب الأرض بالنائل الغمر",10,"ر",1,0],["وَإِذ خطب النُفوس لمن بَراها","وَجادَ بروحِهِ بِالحُبِّ مَهرا",11,"ر",2,0],["وإِذْ خَمَدَتْ نارُ الوَغَى عادَ بَعْضُهُ","لِبَعْضٍ كما شاءَ الخِلافُ مُناوِيا",12,"ي",2,0],["واذْخَرْ لنفسك زاداً للحسابِ غَداً","ما دمتَ في رِفْقٍ تمشي وفي مَهَل",13,"ل",1,0],["واذخر زهابك لمن ذاخرك،،","وبشر بشيٍ يجملهم..",14,"م",1,0],["‏وأذخرُهُ للنائباتِ فينبري","‏حُسامًا على هَمّي، ودِرعًا عن الضَرّا",15,"ر",2,0]]}