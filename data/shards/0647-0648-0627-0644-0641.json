,116,"ن",2,0],["هو الفائقُ الأقرانِ خالي، فديتُهُ","ومَن دأبُهُ الإنفاقُ والجود والبذلُ",117,"ل",1,0],["هو الفكر منطلق للنهوضِ","ومن دونه كل جهدٍ يُبدّدْ",118,"د",1,0],["هو الفضل لاكن صادف السيف كفه","ووافقت النعمى كريما منعما",119,"م",2,0],["هو الفارس الحامي الذمار محمد","حميد الثنا بدر الكمال المتمم",120,"م",1,0],["هو الفجر والتاريخ يكتب بالدما","صحائف تلقى العز خلف حروبه",121,"ب",2,0],["هو الفتحُ المظفّرُ والسرايا","وأغنى يعربٍ درساً وعلْما",122,"م",2,0],["هو الفتى المحمود رب العلى","من اسمه اشتق من الحمد",123,"د",1,0],["هِوَ الفؤادُ وسِرُّ الجذْبِ فانجُذُبوا","ف يومنا طالَ والسَّاعاتُ تبْتسمُ",124,"م",1,0],["هو الفلاق هامات الأعادي","بعضبٍ لا يفل له ذباب",125,"ب",1,0],["هو الفؤادُ بنعل البيْن قد هُرِسا","والحبُ ملَّ سياج الصبر فانتكسا",126,"س",2,1],["هُوَ الفاضِلُ القَرْمُ الَّذِي قَطُّ لَمْ يَكُنْ","تَأَرَّثَ إِلاَّ باذِخَ المَجْدِ فاضِلا",127,"ل",2,0],["هو الفرد في كل الكمال ومجمع","لكل جلال والجمال بورده",128,"د",2,0],["هوَ الفراقُ وما غيرُ الفراقِ به","غدا ً أكفّرُ عنْ ذنبي ومعصيتي",129,"ت",2,0],["هُوَ الفارسُ المَرْوِيُّ بَحْرُ عُذوبَةٍ","ويَنْسُجُ في سِحْرِ البَيانِ وَآلِهِ",130,"ل",2,0],["هو الفاتح الفتاح أقفال توحيد","بأول نشأة وأول دولتي",131,"ت",2,0],["هُوَ الفارسُ المنسيّ في كلِّ مهجة","تعوّدَ تجميعَ الجيوش ليهجما",132,"م",2,0]]}