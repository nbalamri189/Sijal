ry.dctabudhabi.ae/diwan/poem/216336","الطويل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28944","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33330","البسيط"],[4550,"","https://poetry.dctabudhabi.ae/diwan/poem/107129","الطويل"],[4560,"","https://poetry.dctabudhabi.ae/diwan/poem/143253","الهزج"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136446",""],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136403",""],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136441",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139524",""],[4691,"مبروك للعالمي متصدر لا تكلمني !!","https://www.poetsgate.com/ViewPoem.aspx?id=156952",""],[4784,"رعى الله صبا لا يزال مولعا","https://www.poetsgate.com/ViewPoem.aspx?id=170929",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4960,"السَّيِّد النُّبْل","https://www.poetsgate.com/ViewPoem.aspx?id=214474",""],[4978,"صباح من الفكر وافى وردّدْ","https://www.poetsgate.com/ViewPoem.aspx?id=177288",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5136,"أعاتبه وهو المليك المكرم","https://www.poetsgate.com/ViewPoem.aspx?id=121663",""],[5183,"من وحي الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=180196",""],[5277,"وما مثلُ العراق","https://www.poetsgate.com/ViewPoem.aspx?id=191713",""],[5362,"وردة ناولنيها فتى","https://www.poetsgate.com/ViewPoem.aspx?id=170338",""],[404,"جذْبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=192192",""],[5397,"بآل محمدٍ عرف الصواب","https://www.poetsgate.com/ViewPoem.aspx?id=157900",""],[5431,"لعل خبزي قد يكفي له وعسى ...","https://www.poetsgate.com/ViewPoem.aspx?id=196722",""],[5582,"قِفا وَاَسْعِدانِي كَيْ نُحَيِّي المَنازِلا","https://www.poetsgate.com/ViewPoem.aspx?id=187238",""],[1638,"رشا من بني الأتراك صاد بصاده","https://www.poetsgate.com/ViewPoem.aspx?id=123935",""],[5628,"طيش وفراق","https://www.poetsgate.com/ViewPoem.aspx?id=191436",""],[5781,"بحرٌ بما يكفي لحُبٍّ وعاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=202850",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[6300,"مصير آخر فارس عربيّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82875&r=&rc=46",""]],"verses":[["هُوَ الْفَنَاءُ وَالْبَقَاءُ بَعْدَهُ","وَاللَّهُ عَنْ حِكْمَتِهِ لاَ يُسْأَلُ",0,"ل",1,0],["هُوَ الفَتى الكامِلُ الحامي حَقيقَتَهُ","مَأوى الضَريكِ إِذا ما جاءَ مُنتابا",1,"ب",2,0],["هُوَ الفارِسُ المُستَعِدُّ الخَطيبُ","في القَومِ وَاليَسَرُ الوَعوَعُ",2,"ع",1,0],["هُوَ الفَرْعُ الكَرِيمُ بِنِبْعَتِهِ","زَكا وَتَقَيَّلَ الأَصلَ الزَّكِيَّا",3,"ي",2,0],["هُوَ الفارِسُ المَشهورُ وَالبَطَلُ الَّذي","يَصولُ إِذا ما كانَ يَومٌ مُحَجَّلُ",4,"ل",1,0],["هُوَ الفاتِحُ الغازي الَّذي لا تَرُدُّهُ","عَنِ الفاتِحِ الغازي قِلاع وَلا جُندُ",5,"د",1,0],["هو الفردوس قد قام","به الشاغور رضوانا",6,"ن",2,0],["هُوَ الفارِجُ اللَبسَ الشَديدَ اِلتِباسُهُ","إِذا عَيَّ عَن فَصلِ القَضاءِ رِجالُها",7,"ل",3,0],["هُو الفَتحُ حَقَّا مَا عَلى الشَّمسِ كَاتِمُ","فَمَن لَجَّ بِالهِندِيّ خصمٌ وحَاكِمُ",8,"م",1,1],["هُوَ الفَتحُ قَد فاجا فَأَحيا كَأَنَّما","هُوَ القَطرُ لَم يَضرِب مَعَ الأَرضِ مَوعِدا",9,"د",2,0],["هُوَ الفَلَكُ الدَوّارُ أَجراهُ رَبُّهُ","عَلى ماتَرى مِن قَبلِ أَن تَجري الفُلكُ",10,"ك",1,1],["هو الفتحُ منظوماً على إثرِهِ الفتحُ","وما فيهما عهدٌ ولا فيهما صُلحُ",11,"ح",1,1],["هو الفَزَعُ المؤجَّجُ لا الضَّرامُ","لقد أنذرتَ قومَكَ فاستطاروا",12,"ر",3,0],["هو الفنُّ لا ترتوي روحهُ","بأشهى من الأرجوانِ المذابْ",13,"ب",1,0],["هُوَ إِلْفُهُ وَحَلِيفُهُ لكِنهُ","لِلزهْوِ لمْ يَنُطِ النِّجَادَ بِعَاتِقِ",14,"ق",1,0],["هو الفراقُ! فماذا تامرين إذنْ؟ أنوحُ؟أصمتُ؟أجري عنك؟أتّئدُ؟","أقول\"شكراً\"؟ .. أكانت ليلةً هِبةً؟! يا للكريمة .. إذ تسخو .. وتقتصدُ!",15,"د",1,0],["هو \" الفرات \" وكم في أمره عَجَبٌ","في حالتيهِ وكم في آيِه عِبَر",16,"ر",1,0],["هو الفرع فرع الخلق والأمر أصله","فلا عزم للغير الضعيف ولا حولا",17,"ل",2,0],["هو الفخر إن فاخرت يوما منازعا","ففاخر به إن شئت كل منازع",18,"ع",1,0],["هو الفتحُ يا مولايَ ما فيهِ مريةٌ","ولا لليالي في تعذرِهِ عُذرُ",19,"ر",1,0],["هو الفخار الذي نفى الفخارَ وَفَى","وعداً ورعداً بفخر صدّ من فخروا",20,"ر",3,0],["هو الفرع والأصل الأصيل وفرعه","وثمرٌ لأصل الطيب بالطيب طامحا",21,"ح",2,0],["هُو الفاعلُ المعروف والعرف واللُّهَى","هُو المرتَضى الزاكِي الشفيقُ المُشافِقُ",22,"ق",1,0],["هو الفذُّ سلطان بن سيف بن مالكِ","له شهدتْ يوم الهياج مصارعُ",23,"ع",1,0],["هو الفتحُ أعيا وصفُهُ النظمَ والنثرا","وعمَّت جميعَ المسلمينَ به البُشرى",24,"ر",2,1],["هو الفتحُ أعيا من أطالَ مرجزاً","وفات مداه من أطال مقصداً",25,"د",2,0],["هُوَ الفَجرُ لا يَخفى عَلَيكَ اِتِضاحُهُ","هُوَ الفَخرُ لِلمَرءِ المُتاحِ فَلاحُهُ",26,"ه",1,0],["هُوَ الفَرعُ قَد أَربى عَلى طيبِ","أَصلِهِ فَمَن مِثلُهُ ما في الأَنامِ كَمِثلِهِ",27,"ه",1,0],["هُوَ الفِراقُ فَعِشْ إِنْ شِئْتَ أَوْ فَمُت","لَيْسَ الحَياةُ إِذا بانُوا بِمُعْجِبَتي",28,"ت",2,1],["هو الفتى يحمدُ الجيرانُ مشهدَه","عند الشتاءِ وقد همّوا بإخمادِ",29,"د",1,0],["هُوَ الفَتى كُلُّهُ مَجداً وَمَكرَمَةً","وَكُلُّ أَخلاقِهِ الخَيراتِ قَد كَمَلا",30,"ل",2,0],["هو الفاتح المبعوث والخاتم الذي","به كنز اسرار النبوة يختم",31,"م",1,0],["هو الفاضل المولى الذي حاز رتبة","تسامت به العليا ونالت به فخرا",32,"ر",2,0],["هو الفَلْحَسُ الذوّاقُ والسَمْحَجُ الذي","له المَيْنُ بَحْرٌ والمسبَّةُ ساحِلُ",33,"ل",1,0],["هو الفلكُ استَدار بها وكم قد","رأينا فيه من بُرجٍ سَعيدِ",34,"د",1,0],["هو الفرد بل والغوث فانظر تجد له","كواكب أتباعٍ هداهم لقد نما",35,"م",2,0],["هو الفرد بل والغوث همّته سرت","تروح بإذن الحيّ في الحيّ والميت",36,"ت",1,0],["هُوَ الفَتْحُ بَعْدَ الفَتْحِ يَأتِي مُسَوَّغَا","وَما وَلَجَتْ في مَسْمَعٍ لُجَّةُ الوَغَى",37,"غ",2,1],["هُوَ الفَتْحُ أَدْنى حَوْزِهِ المَغْرِبُ الأقْصَى","عَنِ الصَّوْلِ يُسْتَقْضَى وبِالعَدْلِ يُسْتَقْصَى",38,"ص",2,1],["هو الفلَكُ المُطِلُّ عُلاً ولكنْ","كواكبُه إذا طلَع السَّجايا",39,"ا",3,0],["هو الفاضل المشهور والناظم الذي","سما أدباً حتى رقى غاية المرقى",40,"ق",2,0],["هوَ الفتحُ أَمَّا يَومُهُ فَمُعَجَّلٌ","إليكَ وَأَمَّا صُنعُهُ فَجزِيلُ",41,"ل",1,0],["هو الفاجع النسرَ المحلِّقَ بابنه","على الطود والضبَّ المنقَّبَ بالمكْنِ",42,"ن",1,0],["هو الفاضل المفضال في العلم والندى","بمعروفهِ يُثري جَهولٌ ومُعْدمُ",43,"م",1,0],["هو الفارسُ الكرَّار في كلِّ معركٍ","إذا جَبُنَتْ أبطالُهُ ومَصاقِعُهْ",44,"ع",2,0],["هو الفارسُ الكرَّارُ في البأسِ والنَّدى","إذا صَدَقَتْ حَرْبٌ ومانَ سَحابُ",45,"ب",1,0],["هو الفاتح البيت المقدس بعدما","تحامته الدنا ومسودها",46,"ه",2,1],["هو الفاضل المرجوُّ فضلاً ونائلاً","إذا لم يجد قوم بفضل ونائل",47,"ل",1,0],["هو الفلك الدوّارُ في الوفد والعدى","ففي كفّهِ للخلق رزقٌ وحرمان",48,"ن",1,0],["هُوَ الفَرعُ مِن عَبدَي مَنافٍ كِلَيهِما","إِلَيهِ انتَهَت أَحسابُها وَالدَسائِعُ",49,"ع",1,0],["هو الفخر لم يسبق إليه وإن يكن","له قبلها في الناكثين نظائر",50,"ر",1,0],["هُوَ الفاعِلُ الخَيراتِ قُدِّرَ حَذفُهُ","فَثِق بِوُجوبِ الرَفعِ إِنَّكَ نائِبُه",51,"ب",2,0],["هو الفقيرُ إلى مولاهُ لو طَرَقَتْ","طوارقٌ حينَها لا شيءَ يَفديهِ!",52,"ي",2,0],["هُوَ الفارِسُ السِباقِ في كُلِّ حَلبَةٍ","تَجَمّضعَ فيها كُلُّ قِرنٍ مُمارِسِ",53,"س",1,0],["هو الفريدُ الذي قد بات منفرداً","في اللحد بينَ هوام الأرض والرِممِ",54,"م",1,0],["هُوَ الفاضل النحرير وَالكامل الَّذي","لَهُ بِالذكا وَالفَضل قَد شَهدت مَصر",55,"ر",1,0],["هو ألف في بدء كل عديد","وإلى الألف منتهى الأعداد",56,"د",1,0],["هو الفارسُ المُرْوي من الدمِ سيفَهُ","إذا لم يُطِقْ ريَّ السيوفِ الفوارس",57,"س",1,0],["هو الفارس الكرارُ في كل وقعة","شجاع له في كل معتركٍ ذكرُ",58,"ر",1,0],["هُوَ الفاضِل الفَخم اللّبيبُ أَخو الذّكا","يُزيحُ قِناعَ الخدرِ عَن غادَةِ الفكرِ",59,"ر",1,0],["هوَ الفاضِلُ النّحريرُ قالَ بِفَضلِهِ","أَفاضِلُ هَذا العَصر حتّى عِظامُهُ",60,"م",2,0],["هُوَ الفاعِلُ المُختارُ جَلَّ جَلالَهُ","وَما هُوَ بِالمَجبورِ يَفعلُ بالجبرِ",61,"ر",1,0],["هو الفضل حتى لا تعد المناقب","بل العزم حتى تطلبنك المطالب",62,"ب",1,1],["هُوَ الفاضِلُ المَنصورُ وَالرايَةُ الَّتي","أَدارَت عَلى الأَعداءِ كَأسَ مَماتِ",63,"ت",1,0],["هو الفوز كل الفوز يا من يؤمه","هو الأمن كل الأمن يا من يحوم",64,"م",1,0],["هو الفارس المقدام والضيغم الذي","يكيد بساحات العراك المقادما",65,"م",2,0],["هو الفراق وأدنى خطبه حلك","وصحة المرء في ساعاته مرض",66,"ض",1,0],["هو الفخر والفوز الذي ظفرت به الكرام","لحسن الاجتباء من المبدى",67,"د",2,0],["هُوَ الفَجْرُ قابَلَنا بِابْتِسامِ","لِيَصْرِفَ عَنّا عُبوسَ الظَّلامِ",68,"م",1,1],["هو الفاعل المختار ما شاء كائن","وما لم يشأ لم يأت ضد المشيئة",69,"ه",1,0],["هو الفَتى الماجِدُ الميمونُ طائرُهُ","والمشتري الحمدَ بالغالي من الثَّمَنَ",70,"ن",1,0],["هو الفِراق يذيب الكبد موقفه","فلا تلم من عليه البعد قد أخنَى",71,"ن",2,0],["هو الفيلقُ الفَاري الظلامِ بعزمةٍ","تنوءُ بِمرْمى أَصغريه الجَحافِل",72,"ل",1,0],["هو الفيلسوف التام والصارم الذي","وجت نوب الأيام صولته الكبرى",73,"ر",2,0],["هو الفائق المنتقى ذكره","جلاء هو الغيث في كل واد",74,"د",1,0],["هو الفَيضُ وابنُ الفَيضِ أبطأَ جَريهُ","إذا الخيل جاءت أن يجئ مُصدَّرا",75,"ر",2,0],["هو الفَوْزُ لو يَقْضِي به لَي مُهْرِقاً","بقيّةَ ما يُذْكي سِراجي من الدُّهْن",76,"ن",1,0],["هو الفلَكُ الأسْنَى هي الشمسُ بهجةً","وسمطٌ لها النجومُ الشوابكُ",77,"ك",1,0],["هو الفقير الذي قد باع متجراً","أضلاله بالهدى لله والدِّين",78,"ن",1,0],["هوَ الفاضِلُ القَرمُ الهُمَامُ لَدى الوَغى","إِذا حَمِيَت يَوماً هو الفَيضُ لِلنَّدى",79,"د",2,0],["هو الفاضل المولى الجليل ومن حوى","كمالا لأزهار المحاسن أثمرا",80,"ر",2,0],["هو الفرع الذي بنيت عليه","بيوت الأطيبين ذوي الحجاب",81,"ب",1,0],["هو الفنا لا بد من لقائه","ففي اللقا لقاؤه حميد",82,"د",1,0],["هو الفلك المحيط بكل معنى","وفياض الفضائل في الأنام",83,"م",1,0],["هو الفلك الأعلى تنزل وازدهى","بزهر الدراري جمعاً كل فرقد",84,"د",1,0],["هو الفرضى زيد باكتساب","وسحبان البلاغة بالسليقه",85,"ق",2,0],["هو الفقر من كَسْرِ الفَقار اشتقاقه","نِقابٌ به تخفى وجوهُ المَناقب",86,"ب",1,0],["هو الفرد في الرسل العديم مثيله","لقد عز موجودٌ وقل نظير",87,"ر",1,0],["هو الفَيْصل المِقدام والشيد الَّذِي","تُعانقه العَلْياء شوقاً وتَلْثم",88,"م",1,0],["هو الفيصل المعروف فِي البأْس والندى","تَذِلُّ لَهُ الأبطال رُعباً وتُحجِم",88,"م",1,0],["هوَ الفتحُ عزّتْ أرْضُ أنْدلسٍ بهِ","وذلّ المُناوِي والعدُوُّ المُناكِثُ",89,"ث",1,0],["هو الفاضل الألمعيّ الذي","يروق المديح له والثنا",90,"ن",2,0],["هو الفجر عوَّدني أن أراكِ","هناك على الحائظ الأرفع",91,"ع",1,0],["هو الف