{"poems":[[75,"عذري إن عذلت في خلع عذري","https://www.aldiwan.net/poem11944.html","الخفيف"],[95,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[45,"كم قتيل كما قتلت شهيد","https://www.aldiwan.net/poem9532.html","الخفيف"],[63,"لمحة البارق من حيث لمح","https://www.aldiwan.net/poem51745.html","الرمل"],[51,"يا نفس ما أوضح قصد السبيل","https://www.aldiwan.net/poem63082.html","البسيط"],[68,"لو يرد الردى ببذل الأيادي","https://www.aldiwan.net/poem40136.html","الخفيف"],[89,"واطول شوقي إليك يا وطن","https://www.aldiwan.net/poem8237.html","المنسرح"],[52,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[1,"أسلمني قومي ولم يغضبوا","https://www.aldiwan.net/poem20969.html","السريع"],[78,"أشرقت لي بدور","https://www.aldiwan.net/poem39308.html","مجزوء الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54887","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54257","الرمل"],[190,"شره الإنسان يقتله","https://www.aldiwan.net/poem43435.html","المديد"],[193,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[193,"ليت أحبابنا بأرض الحجاز","https://www.aldiwan.net/poem35163.html","الخفيف"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[199,"منع النوم طارقات الهموم","https://www.aldiwan.net/poem54415.html","الخفيف"],[214,"صد من أهواه عني وسلا","https://www.aldiwan.net/poem13370.html","الرمل"],[215,"منظر رائع الجمال رهيب","https://www.aldiwan.net/poem46588.html","الخفيف"],[215,"ما على الغادرين نسكب دمعا إن","https://www.aldiwan.net/poem46763.html","الخفيف"],[230,"نحن لله ما لحي بقاء","https://www.aldiwan.net/poem55098.html","الخفيف"],[259,"أقبلي","https://www.aldiwan.net/poem25015.html","مجزوء الرمل"],[261,"كل خفيف الرجلين ثقل","https://www.aldiwan.net/poem48530.html","مخلع البسيط"],[287,"فك أسري طيف لعلوة أسرى","https://www.aldiwan.net/poem32769.html","الخفيف"],[295,"قرح الدمع ناظري","https://www.aldiwan.net/poem11667.html","مجزوء الخفيف"],[333,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[369,"من سره العيد فإني امرؤ","https://www.aldiwan.net/poem60848.html","السريع"],[396,"يا مريدين السعاده والتعلم والعباده","https://www.aldiwan.net/poem54447.html","عموديه"],[409,"مهجة طول التنائي قد براها","https://www.aldiwan.net/poem33362.html","الرمل"],[463,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[556,"عرج على الدارسة القفر","https://www.aldiwan.net/poem47777.html","الرجز"],[564,"صب على عهدكم مقيم","https://www.aldiwan.net/poem69343.html","مخلع البسيط"],[580,"كل خطب إذا تخطاك عمدا","https://www.aldiwan.net/poem2785.html","الخفيف"],[580,"ما على الدهر بعد رؤياك عتب","https://www.aldiwan.net/poem3096.html","الطويل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2488","الخفيف"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2452","الخفيف"],[627,"","https://poetry.dctabudhabi.ae/diwan/poem/146117","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48822","الخفيف"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123689","المديد"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120048","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59124","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133819","الخفيف"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/20008","الخفيف"],[1385,"","https://poetry.dctabudhabi.ae/diwan/poem/178072","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108752","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202066","الخفيف"],[2071,"","https://poetry.dctabudhabi.ae/diwan/poem/122423","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53116","الرمل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132539","الرمل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87573","الخفيف"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105627","الخفيف"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123906","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108021","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109896","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205958","الخفيف"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36734","الخفيف"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32415","المنسرح"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93314","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73230","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83663","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83588","الخفيف"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62130","الخفيف"],[4119,"أين عزي من روحتي بعزاز","https://www.poetsgate.com/ViewPoem.aspx?id=16169",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5186,"عتبي على الشعرآء نزق شعورهم","https://www.poetsgate.com/ViewPoem.aspx?id=156498",""],[5192,"~ [ نَسل شيبي ] ~","https://www.poetsgate.com/ViewPoem.aspx?id=36630",""],[5198,"مزهرية","https://www.poetsgate.com/ViewPoem.aspx?id=135379",""],[5431,"قلتُ كلا ...","https://www.poetsgate.com/ViewPoem.aspx?id=210687",""],[5461,"يزحف الموت","https://www.poetsgate.com/ViewPoem.aspx?id=5305",""],[5461,"نادميني","https://www.poetsgate.com/ViewPoem.aspx?id=1312",""],[5463,"زاد شكّك في غرامي","https://www.poetsgate.com/ViewPoem.aspx?id=30343",""],[5525,"الهوى لو تمنى","https://www.poetsgate.com/ViewPoem.aspx?id=7309",""],[5525,"ديمة","https://www.poetsgate.com/ViewPoem.aspx?id=942",""],[5563,"ما للهوى دكتور","https://www.poetsgate.com/ViewPoem.aspx?id=213090",""],[5717,"يا صانعا شيئا بديعا محكما","https://www.poetsgate.com/ViewPoem.aspx?id=170601",""],[5848,"يا مسافر للجفا","https://www.poetsgate.com/ViewPoem.aspx?id=49227",""],[6056,"طريق المدرسة","https://www.poetsgate.com/ViewPoem.aspx?id=130179",""]],"verses":[["كُلُّ خِرقٍ يَكادُ يَنهَلُّ ظَرفاً","زانَ مَرأىً بِهِ بِأَكرَمِ خُبرِ",0,"ر",1,0],["كل خطاه عثراتٍ تقال","وعزمه لا شيء فيه يقال",1,"ل",1,0],["كُلُّ خَمصانَةٍ أَرَقُّ مِنَ الخَم","رِ بِقَلبٍ أَقسى مِنَ الجَلمودِ",2,"د",1,0],["كل خَفَّاقِ الجَناحين إذا","فارَقَته غَمْرةُ الماءِ جَنَح",3,"ح",1,0],["كُلُّ خَليلٍ فَلَهُ فُرقَةٌ","لابُدَّ يَوماً مِن فِراقِ الخَليل",4,"ل",1,0],["كُلُّ خَطٍّ سَوادُهُ في بَياضٍ","وَتَراهُ بَياضُهُ في السَوادِ",5,"د",1,0],["كُلُّ خَلِيلٍ لِخِلِّهِ وَزَرٌ","وَكُلُّ دَارٍ لأَهْلِهَا أَمَنُ",6,"ن",1,0],["كُلُّ خَيفانَةٍ تُصانُ عَلى الأَق","رَبِ صَونَ العَروسِ في الزَمهَريرِ",7,"ر",1,0],["كُلُّ خَليلٍ كُنتُ خالَلتُهُ","لا تَرَكَ اللَهُ لَهُ واضِحَه",8,"ح",2,0],["كلُّ خَطْبٍ إنْ لم تكُو","نوا غَضِبْتُمْ يَسيرُ",9,"ر",1,0],["كُلُّ خُلْقٍ مَا رَاضَهُ الدَّهرُ يوْماً","بِكِبَارِ الصُّرُوفِ غَيْرُ كَبِيرِ",10,"ر",1,0],["كلُّ خَطْبٍ كُلَ صَعْبٍ","هَيَنٍ إنْ صَحَّ عَزْمُ الصابرينْ",11,"ن",1,0],["كل خطب نازل عسر","ذكره والرزق أشمله",12,"ل",2,0],["كلُّ خَلقٍ مِن نداهُ اِغتَرفا","وَهوَ باللَّه وهم خير الجدود",13,"د",1,0],["كلُّ خيرٍ قد جازَ لي من لَدُنهم","غيرَ وَصلي فما له من جوازِ",14,"ز",1,0],["كلُّ خلقِ الرحمنِ أمّتهُ النا","سُ رَعايا والأنبيا وزراءُ",15,"ا",2,0],["كلُّ خلقٍ هناك دونك في كل","لِ كمالٍ تعذّرَ الإحصاءُ",15,"ا",2,0],["كُلَّ خَيفانَةٍ وَأَجرَدَ نَهدٍ","حَبَشِيِّ الشَوى كُمَيتِ الأَديمِ",16,"م",1,0],["كل خمر فحرام ما عدا","ريقه فهو مدام لي حلا",17,"ل",2,0],["كل خير من السماء جميل","ساقه اللَه رحمةً للجميع",18,"ع",1,0],["كل خطب يهون إلا خداعا","يصطليه متيّم من حبيب",19,"ب",1,0],["كلُّ خَطبٍ في جَنبِ خطبِك يا مِص","رُ يُرَجّى للناسِ فيه عزاء",20,"ا",2,0],["كلَّ خِلٍّ، عن دواءٍ","من طبيبٍ، لا يُلَبّي",21,"ب",2,0],["كل خفيف الرجلين ثقّل","خفة رجليه بالحديد",22,"د",1,1],["كُلُّ خُمصانَةٍ شَهِيٍّ لَماها","طَرفُها الهاروتِيُّ يَنفُثُ سِحرا",23,"ر",2,0],["كل خودٍ كأنها","فتنة للنواظر",24,"ر",1,0],["كل خير مضيّعٌ في حماهم","كلّ حقّ مهدّدٌ باستلاب",25,"ب",1,0],["كُلّ خليلٍ بَعْدَ أُنْسى به","أَكبرُ حَظّي منا تَشْييع",26,"ع",1,0],["كل خير فالزموه","واتركو إلى كل عاده",27,"د",2,0],["كل خير منه لا من غيره","فسواه لا يرجى لسواها",28,"ا",3,0],["كلُّ خوفٍ بهم أمانٌ ومهجو","رِ خرابٍ بعدلهم معمورُ",29,"ر",1,0],["كلِّ خميصِ البطن بادي الطَّوى","ممتلئِ الجلد من الضُّرِّ",30,"ر",1,0],["كلّ خَلى الفُؤاد صَاح","عَذابُه عِنْدنَا ألِيمُ",31,"م",1,0],["كُلُّ خطْبٍ إِذا تخطَّاك عَمْدا","وتعدَّاك إِنَّه مَا تعدَّى",32,"د",2,1],["كلُّ خَلْقٍ في قَلْبِه من سُطاهُ","ونَدى رَاحَتيه حُبٌّ ورُعْبُ",33,"ب",1,0],["كُلُّ خِرقٍ سَمَيدَعٍ وَشَنونٍ","ساهِمِ الوَجهِ تَحتَ أَحناءِ سَرجِ",34,"ج",1,0],["كُلَّ خَيفانَةٍ مُجَنَّبَةِ الرِج","لَينِ عَجلى خَفيفَةٍ في الشَمالِ",35,"ل",1,0],["كلُّ خسيسٍ وكلُّ نذلٍ","متَّع بالطيبات أيره",36,"ر",2,0],["كلُّ خصم سهلٌ وكل غريم","هينٌ بعد ذلك الجبار",37,"ر",1,0],["كل خير في الوجود فمن","يمنه حقاً لقد وصلا",38,"ل",2,0],["كل خود تعذب المغرم الصب","ب بعذب من ثغرها البراقِ",39,"ق",1,0],["كُلُّ خُودٍ إذَا انْثَنَتْ وَتَبَدَّتْ","خِلْتَ شَمْساً تَلُوحُ في أمْلُودِ",40,"د",1,0],["كل خير جفاهما ونبا الحسن","واستردَّ الورودَ والريحانا",41,"ن",2,0],["كُلُّ خَلقٍ سِوى الإِما","مِ للأَنعامِهِ خَوَل",42,"ل",1,0],["كل خِلٍ يجتني لذَّتهُ","وأنا الجاني أراكا وبَشاما",43,"م",2,0],["كل خودٍ تشددت","قطَّعت حظها قطعْ",44,"ع",1,0],["كل خزي بدت به ذات بغي","هو أدنى من سبة ركباها",45,"ا",3,0],["كل خطب الا فراقك سهل","كل صبر الا عليك جميل",46,"ل",1,0],["كُلُّ خيرٍ يزينهُم هُوَ فيهِ","ولَهُ دونَهُم خِصالٌ يَزينُه",47,"ن",2,0],["كل خلق له سواه شبيهٌ","حين يدعى بنو العُلا ونظير",48,"ر",1,0],["كل خواض وغى يمشي لها","مشية الظامي إلى الماء العذب",49,"ب",1,0],["كُلُّ خَودٍ منهنَّ باهت بشيءٍ","وَبها ما حوتهُ تلك النسآءُ",50,"ا",2,0],["كل خود أحلى من العين في العين","دعتني شوقا إليها الدواعي",51,"ع",2,0],["كل خطبٍ أتتْ به نوَبُ الده","رِ يسيرٌ بجنْبِ مصرَعِ زَنْكي",52,"ك",2,0],["كلٌّ خودٍ للسحر في مقلتيها","عقدٌ قد خلبن بالنفثات",53,"ت",1,0],["كلُّ خِلٍّ سِوايَ فَهوَ خَلِيٌّ","وحبيبٍ سِواكَ فَهوَ مُحابِ",54,"ب",1,0],["كل خافٍ يريد أن يتجلى","في الربيع المزخرف المشهود",55,"د",1,0],["كلُّ خَمصانَةِ الوِشاح دَعاها","لِلتَصابي هَوىً فَلَبّت مُطيعَه",56,"ع",2,0],["كُلُّ خَليلٍ مَضى فَفارَقَني","كانَ شَوى لَو ثَوى فَلَم يَغَبِ",57,"ب",1,0],["كل خَمْصانةٍ ثَنَتْ طرف","الزُّنّار من سُرَّةٍ على هوَّاز",58,"ز",1,0],["كلُّ خودٍ بيضاءَ كالشَّمسِ كم دُو","نَ جَناها من صعدةٍ سمراءَ",59,"ا",2,0],["كُلّ خطبٍ دونَ المَنِيَّة سهلٌ","عندَ مُستَهلّ الخطوبِ الجسامِ",60,"م",1,0],["كُلّ خَوفي من أَن أَموتَ بَعيداً","رَبِّ آمِن خَوف بِقُربٍ يودُّ",61,"د",1,0],["كل خمرية ولم تسق خمراً","تلبس الحسن والدلال خمارا",62,"ر",2,0],["كل خمصانة ثنت طرف الزنار","من تكة على هواز",63,"ز",1,0],["كُلُّ خَطْوٍ فِي شُرُوعِي","يَسْتَوِي فِي الْحُبِّ جِسْرَا",64,"ر",2,0],["كل خفيف الروح كل مغرم،","كل بأذيال الهوى متشبث",65,"ث",1,0],["كل خلق الله دم وعظم وأجساد غريقة","زادني إني نسل شيبي أصلي بالطهر فرق",66,"ق",1,0],["كل خطوة غرور وكل نظرة سهام","شف ضحايا عيونك كم صويب وصريع",67,"ع",1,0],["كلّ خلقٍ بانفرادٍ","بيد أنّ الأنثى أحلى",68,"ل",2,0],["كل خاين ترى حبله قصير","دام للحق طلاّب وطلب",69,"ب",1,0],["كل خف(ن) يرسم بدربي حذر","لاهل ركب(ن) ما بعد طبّ الشعيب",70,"ب",1,0],["كل خلق الله تفرح كل يوم وكل عيد","وأنا أفراحي تتلاشى لو زماني يوم خان",71,"ن",1,0],["كل خلٍ .. تهنى في الهوى مع خليله","فاتنا السعد حنا يوم نفسه بخيله",72,"ل",2,0],["كلٍ خصيم .. وذاق لوعة خصيمه","واللي خصيم الوقت يا بنت خسران",73,"ن",1,0],["كلٍّ خذا له من هوى البال مصلوح","وانا منى قلبي على الصدّ معتاد",74,"د",1,0],["كل خليقة تنادي انها","مخلوقة لغاية من منعم",75,"م",1,0],["كل خطوة بعد تطرد اخر فلول الأماني","ذي نهاية واقعية كل واحد في طريقه",76,"ق",2,0],["كل خيّال ٍ حسب عسفه وترويض افرسه","فيه منهو من يعاني وفيه منهو إهتنا",77,"ن",2,0]]}