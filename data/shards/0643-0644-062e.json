{"poems":[[73,"عذري إن عذلت في خلع عذري","https://www.aldiwan.net/poem11944.html","الخفيف"],[93,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[43,"كم قتيل كما قتلت شهيد","https://www.aldiwan.net/poem9532.html","الخفيف"],[61,"لمحة البارق من حيث لمح","https://www.aldiwan.net/poem51745.html","الرمل"],[49,"يا نفس ما أوضح قصد السبيل","https://www.aldiwan.net/poem63082.html","البسيط"],[66,"لو يرد الردى ببذل الأيادي","https://www.aldiwan.net/poem40136.html","الخفيف"],[87,"واطول شوقي إليك يا وطن","https://www.aldiwan.net/poem8237.html","المنسرح"],[50,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[1,"أسلمني قومي ولم يغضبوا","https://www.aldiwan.net/poem20969.html","السريع"],[76,"أشرقت لي بدور","https://www.aldiwan.net/poem39308.html","مجزوء الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54887","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54257","الرمل"],[184,"شره الإنسان يقتله","https://www.aldiwan.net/poem43435.html","المديد"],[187,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[187,"ليت أحبابنا بأرض الحجاز","https://www.aldiwan.net/poem35163.html","الخفيف"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[193,"منع النوم طارقات الهموم","https://www.aldiwan.net/poem54415.html","الخفيف"],[208,"صد من أهواه عني وسلا","https://www.aldiwan.net/poem13370.html","الرمل"],[209,"منظر رائع الجمال رهيب","https://www.aldiwan.net/poem46588.html","الخفيف"],[209,"ما على الغادرين نسكب دمعا إن","https://www.aldiwan.net/poem46763.html","الخفيف"],[223,"نحن لله ما لحي بقاء","https://www.aldiwan.net/poem55098.html","الخفيف"],[252,"أقبلي","https://www.aldiwan.net/poem25015.html","مجزوء الرمل"],[254,"كل خفيف الرجلين ثقل","https://www.aldiwan.net/poem48530.html","مخلع البسيط"],[280,"فك أسري طيف لعلوة أسرى","https://www.aldiwan.net/poem32769.html","الخفيف"],[288,"قرح الدمع ناظري","https://www.aldiwan.net/poem11667.html","مجزوء الخفيف"],[326,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[362,"من سره العيد فإني امرؤ","https://www.aldiwan.net/poem60848.html","السريع"],[388,"يا مريدين السعاده والتعلم والعباده","https://www.aldiwan.net/poem54447.html","عموديه"],[400,"مهجة طول التنائي قد براها","https://www.aldiwan.net/poem33362.html","الرمل"],[456,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[549,"عرج على الدارسة القفر","https://www.aldiwan.net/poem47777.html","الرجز"],[557,"صب على عهدكم مقيم","https://www.aldiwan.net/poem69343.html","مخلع البسيط"],[573,"كل خطب إذا تخطاك عمدا","https://www.aldiwan.net/poem2785.html","الخفيف"],[573,"ما على الدهر بعد رؤياك عتب","https://www.aldiwan.net/poem3096.html","الطويل"]],"verses":[["كُلُّ خِرقٍ يَكادُ يَنهَلُّ ظَرفاً","زانَ مَرأىً بِهِ بِأَكرَمِ خُبرِ",0,"ر",1,0],["كل خطاه عثراتٍ تقال","وعزمه لا شيء فيه يقال",1,"ل",1,0],["كُلُّ خَمصانَةٍ أَرَقُّ مِنَ الخَم","رِ بِقَلبٍ أَقسى مِنَ الجَلمودِ",2,"د",1,0],["كل خَفَّاقِ الجَناحين إذا","فارَقَته غَمْرةُ الماءِ جَنَح",3,"ح",1,0],["كُلُّ خَليلٍ فَلَهُ فُرقَةٌ","لابُدَّ يَوماً مِن فِراقِ الخَليل",4,"ل",1,0],["كُلُّ خَطٍّ سَوادُهُ في بَياضٍ","وَتَراهُ بَياضُهُ في السَوادِ",5,"د",1,0],["كُلُّ خَلِيلٍ لِخِلِّهِ وَزَرٌ","وَكُلُّ دَارٍ لأَهْلِهَا أَمَنُ",6,"ن",1,0],["كُلُّ خَيفانَةٍ تُصانُ عَلى الأَق","رَبِ صَونَ العَروسِ في الزَمهَريرِ",7,"ر",1,0],["كُلُّ خَليلٍ كُنتُ خالَلتُهُ","لا تَرَكَ اللَهُ لَهُ واضِحَه",8,"ح",2,0],["كلُّ خَطْبٍ إنْ لم تكُو","نوا غَضِبْتُمْ يَسيرُ",9,"ر",1,0],["كُلُّ خُلْقٍ مَا رَاضَهُ الدَّهرُ يوْماً","بِكِبَارِ الصُّرُوفِ غَيْرُ كَبِيرِ",10,"ر",1,0],["كلُّ خَطْبٍ كُلَ صَعْبٍ","هَيَنٍ إنْ صَحَّ عَزْمُ الصابرينْ",11,"ن",1,0],["كل خطب نازل عسر","ذكره والرزق أشمله",12,"ل",2,0],["كلُّ خَلقٍ مِن نداهُ اِغتَرفا","وَهوَ باللَّه وهم خير الجدود",13,"د",1,0],["كلُّ خيرٍ قد جازَ لي من لَدُنهم","غيرَ وَصلي فما له من جوازِ",14,"ز",1,0],["كلُّ خلقِ الرحمنِ أمّتهُ النا","سُ رَعايا والأنبيا وزراءُ",15,"ا",2,0],["كلُّ خلقٍ هناك دونك في كل","لِ كمالٍ تعذّرَ الإحصاءُ",15,"ا",2,0],["كُلَّ خَيفانَةٍ وَأَجرَدَ نَهدٍ","حَبَشِيِّ الشَوى كُمَيتِ الأَديمِ",16,"م",1,0],["كل خمر فحرام ما عدا","ريقه فهو مدام لي حلا",17,"ل",2,0],["كل خير من السماء جميل","ساقه اللَه رحمةً للجميع",18,"ع",1,0],["كل خطب يهون إلا خداعا","يصطليه متيّم من حبيب",19,"ب",1,0],["كلُّ خَطبٍ في جَنبِ خطبِك يا مِص","رُ يُرَجّى للناسِ فيه عزاء",20,"ا",2,0],["كلَّ خِلٍّ، عن دواءٍ","من طبيبٍ، لا يُلَبّي",21,"ي",1,0],["كل خفيف الرجلين ثقّل","خفة رجليه بالحديد",22,"د",1,1],["كُلُّ خُمصانَةٍ شَهِيٍّ لَماها","طَرفُها الهاروتِيُّ يَنفُثُ سِحرا",23,"ر",2,0],["كل خودٍ كأنها","فتنة للنواظر",24,"ر",1,0],["كل خير مضيّعٌ في حماهم","كلّ حقّ مهدّدٌ باستلاب",25,"ب",1,0],["كُلّ خليلٍ بَعْدَ أُنْسى به","أَكبرُ حَظّي منا تَشْييع",26,"ع",1,0],["كل خير فالزموه","واتركو إلى كل عاده",27,"د",2,0],["كل خير منه لا من غيره","فسواه لا يرجى لسواها",28,"ا",3,0],["كلُّ خوفٍ بهم أمانٌ ومهجو","رِ خرابٍ بعدلهم معمورُ",29,"ر",1,0],["كلِّ خميصِ البطن بادي الطَّوى","ممتلئِ الجلد من الضُّرِّ",30,"ر",1,0],["كلّ خَلى الفُؤاد صَاح","عَذابُه عِنْدنَا ألِيمُ",31,"م",1,0],["كُلُّ خطْبٍ إِذا تخطَّاك عَمْدا","وتعدَّاك إِنَّه مَا تعدَّى",32,"د",2,1],["كلُّ خَلْقٍ في قَلْبِه من سُطاهُ","ونَدى رَاحَتيه حُبٌّ ورُعْبُ",33,"ب",1,0]]}