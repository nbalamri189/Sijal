em.aspx?id=128745",""],[585,"هي الحرب فانظر كيف ومض البوارق","https://www.poetsgate.com/ViewPoem.aspx?id=161905",""],[5147,"أيقل أرحلك الصعيد الهامد","https://www.poetsgate.com/ViewPoem.aspx?id=166697",""],[5183,"وَقَارُ الحَوَادِثُ","https://www.poetsgate.com/ViewPoem.aspx?id=186446",""],[5183,"البدوي والوهم","https://www.poetsgate.com/ViewPoem.aspx?id=180279",""],[5185,"الوعد","https://www.poetsgate.com/ViewPoem.aspx?id=71576",""],[5268,"ماسَت يداكِ","https://www.poetsgate.com/ViewPoem.aspx?id=207007",""],[5320,"البسمة الصفراء","https://www.poetsgate.com/ViewPoem.aspx?id=43257",""],[5338,"معارضة قصيدة بات سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=187941",""],[5401,"من هيرتز الموجات","https://www.poetsgate.com/ViewPoem.aspx?id=85370",""],[5409,"شقاءٌ في شبابي والمشيب","https://www.poetsgate.com/ViewPoem.aspx?id=155252",""],[5431,"ومازال للعشاق غيمٌ ومرتفعْ!!","https://www.poetsgate.com/ViewPoem.aspx?id=199292",""],[5442,"اعمل حساب النفس عن هفواتها","https://www.poetsgate.com/ViewPoem.aspx?id=114757",""],[5484,"ثمرة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=206308",""],[5528,"دمعة على أطلال \" ميّ \"","https://www.poetsgate.com/ViewPoem.aspx?id=201383",""],[5542,"شعري وحبي فيكَ يلتقيانِ","https://www.poetsgate.com/ViewPoem.aspx?id=24756",""],[5616,"قُرّاء","https://www.poetsgate.com/ViewPoem.aspx?id=203331",""],[5689,"باتت اليك يد الأشواق تدفعه","https://www.poetsgate.com/ViewPoem.aspx?id=143392",""],[5725,"على جيدك المصقول","https://www.poetsgate.com/ViewPoem.aspx?id=177422",""],[5732,"يا فزعة المظيوم","https://www.poetsgate.com/ViewPoem.aspx?id=177835",""],[5781,"بطاقاتُ الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=208771",""],[5809,"عجيب","https://www.poetsgate.com/ViewPoem.aspx?id=205394",""],[5818,"أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=193071",""],[5845,"سجعتْ بأيمنِ ذى الأراكِ حمائمهْ","https://www.poetsgate.com/ViewPoem.aspx?id=198488",""],[5851,"وصية مرتحلة","https://www.poetsgate.com/ViewPoem.aspx?id=175272",""],[5910,"إذا ذكرتَ النَّوى","https://www.poetsgate.com/ViewPoem.aspx?id=206979",""],[5956,"الغجرية سارقة الطفل *","https://www.poetsgate.com/ViewPoem.aspx?id=184538",""],[5956,"اعترافٌ عادل","https://www.poetsgate.com/ViewPoem.aspx?id=192316",""],[5956,"معنى جديد لعبارة شُذَّاذ الأفق","https://www.poetsgate.com/ViewPoem.aspx?id=192723",""],[5956,"يوم التقائك","https://www.poetsgate.com/ViewPoem.aspx?id=192932",""],[6078,"صمتُ الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=203262",""],[6142,"ولادة المرتضى لم يحوها أحد","https://www.poetsgate.com/ViewPoem.aspx?id=155710",""],[5464,"نسيب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66708&r=&rc=9",""],[6213,"زمان الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76263&r=&rc=20",""],[406,"موقف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63258&r=&rc=68",""],[463,"ذكرتُ وما وفايَ بحيثُ أنسى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60101&r=&rc=157",""],[6290,"فِرَار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85171&r=&rc=0",""],[5696,"إلى الخرطوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65222&r=&rc=1",""]],"verses":[["يَحدو بِها سَفَهاً وَقَد","عَلِقَت يَمينُكَ بِالخُطامِ",0,"م",1,0],["يُحَدِّثُ النَفسَ بِما فاتَهُ","تَطاوُلَ الغَمرِ لِمَجنى السَحوق",1,"ق",1,0],["يُحدى بِسَوطِ الريحِ تَحفِزُهُ","هَفّافَةٌ في سَوقِها عَنَفُ",2,"ف",1,0],["يَحدو عَلى العُنفِ أُخرانا لِيَلحَقَنا","عَجلانَ أَبرَكَ أَولانا بِجَعجاعِ",3,"ع",1,0],["يَحدو بِعوجٍ كَالحَنِيِّ أَطاعَهُ","مُعتاصُها فَطَغى عَلى مُنقادِها",4,"د",3,0],["يحدِّثُ عنهُ البَدرُ بالشّرقِ أهلَهُ","ويسألُ عنهُ الشّمسَ مَنْ سَكَن الغَرْبا",5,"ب",2,0],["يُحَدِّدُ ظُفْراً يَمُجُّ المَنونَ","إذا ساوَرَ القِرْنَ أدْمى شَباهْ",6,"ا",2,0],["يُحدِّثُ عنْ مَسراهُ فجرٌ وبارِقٌ","أفَجْرُكَ غَدّارٌ وبَرقُكَ خَوّانُ",7,"ن",1,0],["يَحِدّونَ بِالأَيدي الشَفارَ وَكُلُّهُم","لِحَلقِكَ لَو يَستَطيعُ حَلقَكَ ذابِحُ",8,"ح",1,0],["يَحدو بِهِنَّ أَخو قاذورَةٍ حَذِرٌ","كَأَنَّهُ بِجَميعِ الناسِ مَوتورُ",9,"ر",1,0],["يَحْدُوكُمُ الإِيمَانُ وَالإِيمَانُ إِنْ","يَكُ صَادِقاً فَلَزِيمُهُ الإِقْدَامُ",10,"م",1,0],["يَحدو نَحائِصَ أَشباهاً مُحَملَجَةً","وُرقَ السَرابيلِ في أَلوانِها خَطَبُ",11,"ب",1,0],["يَحدو بِهِم زَجِلٌ لِلبَينِ مُعتَرِفٌ","قَد كُنتُ ذا حاجَةٍ لَو يَربُعُ الحادي",12,"د",2,0],["يَحدو بِهِنَّ مُشَمِّرٌ عَن ساقِهِ","مِثلُ المَنيحِ نَحى قِداحَ الياسِرِ",13,"ر",1,0],["يحدّث عن علاه رغيم أنفٍ","فيتبع ما يحدّث بالزفير",14,"ر",1,0],["يحدث بالجفن الذي يجرح الحشا","فأجفانه في الحالتين تكلم",15,"م",1,0],["يحدثني من أحاديثه","بما لا يلذ به السامع",16,"ع",1,0],["يحدُرُ الماءَ من محاجرِ عيني","ها على خدّها مسيلٌ أسيلُ",17,"ل",1,0],["يَحِدنَ بِنا عَن كُلِّ شَيءٍ كَأَنَّنا","أَخاريسُ عَيّوا بِالسَلامِ وَبِالنَسبِ",18,"ب",1,0],["يَحدو خِماصاً كَأَعطالِ القَسِيِّ لَهُ","مِن وَقعِهِنَّ إِذا عاقَبنَ تَخبيلُ",19,"ل",1,0],["يَحِدنَ عَنِ المُستَخبِرينَ وَأَتَّقي","كَلامَ المُنادي إِنَّني خائِفٌ حَذرُ",20,"ر",1,0],["يُحَدِّثُني زَيدٌ عَنِ البانِ وَالحِمى","أَحاديثَ يَحلو ذِكرُها وَيَطيبُ",21,"ب",1,1],["يُحَدِّثنَنا بِالمُضمَراتِ وَفَوقَها","ظِلالُ الخُدورِ وَالمَطِيُّ جَوانِحُ",22,"ح",1,0],["يَحدونَ حُدباً مائِلاً أَشرافُها","في كُلِّ مَنزِلَةٍ يَدَعنَ رَعيلا",23,"ل",2,0],["يَحدِجنَ بِالحَدقِ الحَواسِدِ دُميَةً","كَظِباءِ وَجرَةَ مُقلَتَينِ وَجيدا",24,"د",2,0],["يُحدِّثُنا عنْ قَوْمِ هُودٍ وصالحٍ","وأغربِ مَنْ لاقاهُ عَمْرُو بنُ مرثدِ",25,"د",1,0],["يُحَدَّثُ عَن فَضلِهِ مُكرَهاً","كَأَنَّ لَهُ مِنهُ قَلباً حَسودا",26,"د",2,0],["يُحَدِّثُ عَمّا بَينَ عادٍ وَبَينَهُ","وَصُدغاهُ في خَدَّي غُلامٍ مُراهِقِ",27,"ق",1,0],["يُحَدِّثُ مُقلَتَيهِ النَومُ عَنّي","فَلَيتَ النَومَ حَدَّثَ عَن نَداكا",28,"ك",2,0],["يُحَدِّثنَ بَعدَ اليَأسِ مِن غَيرِ ريبَةٍ","أَحاديثَ تَشفي المُدنَفينَ وَتَشغَفُ",29,"ف",1,0],["يَحدُرنَ مِن أُمُلِ الكَثيبِ عَشِيَّةً","رَقَصَ اللِقاحِ وَهُنَّ غَيرُ أَوالِ",30,"ل",1,0],["يُحدُّرُ في الأكنانِ حيّاً مُسنَّداً","ويُصْلَبُ في الجُدْرانِ وهوَ قَتيلُ",31,"ل",1,0],["يُحدِّثُ عنكَ المَشرَفيُّ مجرَّداً","ويُثني عليك السَّمهريُّ مُسَدَّدا",32,"د",2,0],["يُحَدّثُ بالإقدامِ نفْساً كأنّما","يَطيرُ إلى الحربِ اشتياقاً عن السلمِ",33,"م",1,0],["يُحدى بِهِنَّ وَفي الظَعا","ئنِ رَبرَبٌ حورُ العُيونِ",34,"ن",1,0],["يُحدِثنَ في الحبِّ ديناً كلُّه بِدعٌ","والحبُّ دِينُ الهُدَى ما فيه تبديلُ",35,"ل",1,0],["يَحدو إِلَيَّ قُذاذَةً مَقذوذَةً","قَذَّ الحَواجِبِ بِالدِماءِ مُوَلَّغِ",36,"غ",1,0],["يَحدوا لَواقِحَ لا تَمَلُّ طِرادِها","في كَوكَبٍ مِن قَيظِهِ وَهّاجِ",37,"ج",1,0],["يَحدو بِحُقبٍ كَالأُكَر","تَرى بِأَثباجِ القُصُر",38,"ر",1,0],["يُحَدِّثُ عَنها الناسَ مِن غَيرِ رُؤيَةٍ","سِوى صورَةٍ ما إِن تُمَرَّ وَلا تُحلي",39,"ل",2,0],["يُحَدِّثُكُم أَنَّ البِلادَ مُقيمَةٌ","عَلى ما عَهِدتُم ذَلِكَ الهَضبَ وَالوَهدا",40,"د",2,0],["يُحَدِّثُها ما لا تُريدُ اِستِماعَهَ","وَلَم يَبقَ عِندَ الشَيخِ غَيرُ كَلامِ",41,"م",1,0],["يُحَدِّثُنا عَمّا يَكونُ مُنَجِّمٌ","وَلَم يَدرِ إِلّا اللَّهُ ماُ هُوَ كائِنُ",42,"ن",1,0],["يَحْدُو قَنَابِلَهُمْ شُعْثٌ مَقَادِمُهُمْ","بِيضُ الوُجُوهِ مَغَالِيقُ الضُّحَى خُلُعُ",43,"ع",1,0],["يحدوكَ بالنغم السكرانِ أرغنُها","في مَسْبحٍ ماؤه زهرٌ وصهباءُ",44,"ا",2,0],["يُحَدِّرنَ الدُّموعَ على عَديٍ","كَشنٍ خانَهُ خَرزُ الرَّبيبِ",45,"ب",1,0],["يُحْدَى بِهِمْ متَطَوِّعِينَ كَأَنَّهُمْ","عِيسٌ وَلَكِنَّ الْفَنَاءَ الْحَادِي",46,"د",2,0],["يُحَدِّثُ عَنْهُ مَنْ حَدَّثْتَ مِنْهُمْ","فَما يَخْشَى التَّغَالي في الثَّنَاءِ",47,"ا",2,0],["يُحَدِّثُ في رِفْقٍ وَلَيْسَتْ أَنَاتُهُ","تُثَبِّطُ عَزْماً أَوْ تَعُوقُ مَضَاءَ",48,"ا",2,0],["يحدث عنك بطيب الهُبوب","نسيمٌ له عبَقٌ نافح",49,"ح",1,0],["يُحدِّثني بجودك كلُّ ركْب","وكلُّهُمُ بشعري فيك يشْدو",50,"د",2,0],["يُحَدِّثُهَا كُلٌّ بِأَمْرٍ تَجَدَّدَا","وَيُفْشِي لَهَا أَسْرَارَهُ مُتَوَدِّدَا",51,"د",2,0],["يحدثني عنهم صديقي ومهجتي","متى ما دعت ذاك الحديث اطمأنت",52,"ت",1,0],["يحدّثُنا بالفَناء البقاءُ","ويُخبرنا بالرحيلِ المقامُ",53,"م",1,0],["يحدث عما كان أو هو كائن","فقس آخراً من صدقه بالأوائل",54,"ل",1,0],["يُحَدِّثُ مِنهُ عَن عُلومِ جَنانِهِ","بَصيرٌ بِسِرِّ الغَيبِ قَبلَ كيانِهِ",55,"ه",1,0],["يَحْدُو المُفِيقَ إِلى الخُمَارِ لأَنَّ في","نِصْفِ اسْمِهِ ثَمَل الفَتى السَّكْرانِ",56,"ن",1,0],["يَحدي بِنا حادٍ عَنيفٌ سَيرُهُ