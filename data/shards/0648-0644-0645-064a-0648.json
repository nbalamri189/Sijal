{"poems":[[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[39,"ولم يوانم لهم في رتبها ثبجا","https://www.aldiwan.net/poem6842.html","البسيط"],[49,"وزائر حببه إغبابه","https://www.aldiwan.net/poem25361.html","الرجز"],[47,"فدتك يدي من عاتب ولسانيا","https://www.aldiwan.net/poem66867.html","الطويل"],[77,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[164,"كلات ودين الله أفضل ما تكلا","https://www.aldiwan.net/poem59159.html","الطويل"],[193,"لمن ربع بأكناف المصلى","https://www.aldiwan.net/poem35174.html","الوافر"],[280,"ولي العهد أم عهد الولي","https://www.aldiwan.net/poem25452.html","الوافر"],[287,"بقلبي حوري الجنان المنعم","https://www.aldiwan.net/poem32629.html","الطويل"],[580,"","https://poetry.dctabudhabi.ae/diwan/poem/47865","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137716",""],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44790","السريع"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67832","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108537","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118306","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27855","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28049","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27425","الوافر"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104956","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121181","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203487","الوافر"],[3098,"","https://poetry.dctabudhabi.ae/diwan/poem/131896","الطويل"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145541","الطويل"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45259","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85195","الرجز"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107486","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81697","البسيط"],[4778,"كل امريءٍ راعي","https://www.poetsgate.com/ViewPoem.aspx?id=191694",""],[3859,"رنت بلابلُ في ودٍ من السلم","https://www.poetsgate.com/ViewPoem.aspx?id=124438",""]],"verses":[["وَلَم يودِ مَن كُنتَ تَسعى لَهُ","كَما قيلَ في الحَيِّ أَودى دَرِم",0,"م",1,0],["ولم يوانم لهم في رتْبها ثبجاً","ولم يكن لهم فيها أبا كربِ",1,"ب",1,1],["وَلَم يُؤَمِّن فَقدَهُ إِيابُهُ","شَيخٌ كَبيرٌ عادَهُ شَبابُهُ",2,"ب",2,0],["وَلَم يورِثاكَ القَولَ لا فِعلَ بَعدَهُ","وَما خَيرُ حَليِ السَيفِ إِن كانَ نابِيا",3,"ي",2,0],["ولم يُؤتَ مَرْءٌ حِكمَةَ القولِ كلَّها","إذا هُوَ لم يَفْهَمْ ولم يَتَفَهّم",4,"م",1,0],["ولم يؤت الا من ذويه وربما","أتى من فروع الاصل مايقطع الأصلا",5,"ل",2,0],["وَلَم يوجِد لهُ في العلمِ مِثلاً","وَلَم يخلُق له في العدل عدلا",6,"ل",2,0],["وَلَمْ يُؤْثِرْهُ بالتَّأْمِيرِ لكِنْ","بِهِ مُسْتَأثِرُ الأَمْرِ العَلِيِّ",7,"ي",1,0],["وَلَم يُؤتَ سُؤلَ النَفسِ إِلا مُدَنَّرٌ","يَجودُ بِما يَقضي الهَوى أَو مُدَرهَمُ",8,"م",1,0],["ولم يودِعُوه السجنَ إِلاَّ مخافةً","من العَيْنِ أَنْ تَعْدُو على ذَلِك الحُسْنِ",9,"ن",1,0],["ولم يوجد المال في البدء كي","يكون حلى أو لتشرى الحلى",10,"ل",2,0],["وَلَم يُوَدِّعكَ حَبيبٌ وَقَد","يُهَوِّنُ الصَعبَ وَداعُ الحَبيبْ",11,"ب",1,0],["وَلَمْ يُوْصَفُوا يَوْماً بِعَيْبٍ وَزَلَّةٍ","وَهُمْ صُفَرَاءُ اللَّوْنِ مِنْ غَيْرِ عِلَّةٍ",12,"ه",1,0],["ولم يؤخر كلام الكاشحين يدي","عما أريد ولكن أخر الذهب",13,"ب",1,0],["ولم يؤب فوق ركاب خيب","من انتهوا لولد المسيب",14,"ب",1,0],["ولم يولد فلم يدركه عقلٌ","فإنْ ظفروا به فبحكم وهم",15,"م",1,0],["ولم يؤاخذه بما قد مضى","إذا يتوب العبد عنه إذا",16,"ذ",2,0],["ولم يُولد فكيف الأمر قل لي","وليس لهم سواه من دَليلِ",17,"ل",1,0],["ولم يؤمن التبليغ منهم من الخطا","إذا كان يعروهم من السهو ما يعرو",18,"ر",2,0],["ولم يور قدحا حافر بعد ان جرت","دماء نحور من جسود ومبسل",19,"ل",1,0],["ولم يؤمن بها العباد يوما","فهم بعيوبها أدرى تماما",20,"م",2,0],["ولم يؤثروا دنيا لهم عن وصوله","ولا ولدا أو وصل خودِ الحلائل",21,"ل",1,0],["ولم يوه شهر الصوم من جسمك القوى","لما اعتدت من إدمان صوم المواصل",22,"ل",1,0],["وَلَم يولِهِم خَيراً أَبوا أَن يَسودَهُم","وَهانَ عَلَيهِم رَغمُهُ وَهوَ أَظلَمُ",23,"م",1,0],["ولم يوفوا حقاها من عرفه","وكيف لي أدري حقيقة الصفه",24,"ه",1,0],["ولم يوتَ علمَ الغيب لكن بدَت لهُ","دلائلُ مما قبلهُ وشهودُ",25,"د",1,0],["ولم يؤخِّرْكَ عن تكميل ما بدأَتْ","علياك غير مشيئآتٍ وأَقدار",26,"ر",1,0],["ولم يؤثر النفس اللجوجة لو بها","خصاصة عيش قلَّ أو كان باديا",27,"ي",2,0],["ولم يوسوس بفرشٍ وطئت له أو","وسواسِ حلي لذات القصر في الخيمِ",28,"م",1,0]]}