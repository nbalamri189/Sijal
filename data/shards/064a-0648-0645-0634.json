{"poems":[[95,"ما أنس من طيب عيشي","https://www.aldiwan.net/poem11193.html","المجتث"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126128","الرجز"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49580","البسيط"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202066","الخفيف"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199638","المسحوب"],[4791,"خلها تلعب","https://www.poetsgate.com/ViewPoem.aspx?id=37104",""],[4987,"لمثلها والا بلاش","https://www.poetsgate.com/ViewPoem.aspx?id=49571",""],[5344,"إلتقينا","https://www.poetsgate.com/ViewPoem.aspx?id=180697",""],[5480,"(هذا الزمن) في غلاء المهور","https://www.poetsgate.com/ViewPoem.aspx?id=4166",""],[5573,"كل ماقلت هانت واحتكمها حكيم","https://www.poetsgate.com/ViewPoem.aspx?id=200089",""],[5573,"جيت اعبر شعوري يوم ليلي سكن","https://www.poetsgate.com/ViewPoem.aspx?id=204545",""],[5606,"مرفوع العتب","https://www.poetsgate.com/ViewPoem.aspx?id=194453",""],[5732,"ونات الحشا","https://www.poetsgate.com/ViewPoem.aspx?id=177861",""],[5841,"نرجسيه","https://www.poetsgate.com/ViewPoem.aspx?id=37040",""],[5848,"الدلوعه","https://www.poetsgate.com/ViewPoem.aspx?id=50613",""],[5848,"أغرق","https://www.poetsgate.com/ViewPoem.aspx?id=53458",""],[6113,"نوال","https://www.poetsgate.com/ViewPoem.aspx?id=12877",""]],"verses":[["يَومَ شَفَى النَّفْسَ فِيهِ","لِقَاءُ مَنْ يَهْوَانِي",0,"ن",2,0],["يوم شديد كربه وهوله","ما أحد يسمع فيه قوله",1,"ه",1,0],["يوم شديد كربه وهوله","ما احد يحمل عنه ذنبه",1,"ه",1,0],["يومٌ شتِيمُ المحيّا لا يُزَيّنُهُ","حليٌ وإن كانَ لا يُزري به العَطَلُ",2,"ل",1,0],["يوم شق العصا فريق ودس ال","سم قوم ورام شرا قبيل",3,"ل",1,0],["يوم شفت اسبابك المايس","غصن خضري فايق الصور",4,"ر",1,0],["يوم شفت الجيد والطرف الخرس","أحسب الأسماء وأضيع بعدها",5,"د",3,0],["يوم شق النور من ليل القماش","شفت حبّة خالها فى خدّها",6,"د",3,0],["يوم شفته ما تمالكت الحنين،","واجتمعته جَمعة اوراق الملَف",7,"ف",1,0],["يوم شفت اللي غدا طايح عليل","من غلا مهر الحبيب اللي يوده",8,"د",2,0],["يوم شيطان جاهم وإسمعوللرجيم","خلوالعودحايرمنعمي في خلاه",9,"ا",2,0],["يوم شوف الغوالي زاد قلبي شجن","ذكرياتي جديده والله المستعان",10,"ن",1,0],["يوم شفت الشعر بالحبر انكتب","ماتمالكت المشاعر والشعور",11,"ر",1,0],["يوم شفته فز قلبي وانتشا","وابدلت روحي بعد شوفه بروح",12,"ح",1,0],["يوم شفته كالغزاله في امانن هي طليقه","وارتسم هو في خيالي لا صحيت وفي مماتي",13,"ت",2,0],["يوم شفت الشوق في كل العروق استشرى","قلت احبك يا الثقيلة  عفواً  الدلوعة",14,"ع",2,0],["يوم شفتك ضعت في لبسك وريح عطورك","دوك قلبي يوم شافك بالدموع اغرورق",15,"ق",1,0],["يوم شفت الأسم وإلاهونوال","وقتهاضاعت شمالي من يمين",16,"ن",1,0]]}