tps://www.poetsgate.com/ViewPoem.aspx?id=53367",""],[5943,"بدايات ونهايات","https://www.poetsgate.com/ViewPoem.aspx?id=61814",""],[5956,"فاجعُ المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=182538",""],[5956,"لا ينبع النُّصْحُ إلا مِن مُحِبِّين","https://www.poetsgate.com/ViewPoem.aspx?id=183684",""],[5956,"لا دين إلا لذي النوايا الطيبة","https://www.poetsgate.com/ViewPoem.aspx?id=192044",""],[5956,"القاضي الظالم","https://www.poetsgate.com/ViewPoem.aspx?id=193647",""],[5956,"أمُّ الحبيبِ مُحمدٍ والمصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=207118",""],[5957,"أنا لست شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=187339",""],[5966,"بردة المجد","https://www.poetsgate.com/ViewPoem.aspx?id=158309",""],[5980,"جئت والوقوف بالمكارم أظلم","https://www.poetsgate.com/ViewPoem.aspx?id=146262",""],[6004,"في يومها الوطني","https://www.poetsgate.com/ViewPoem.aspx?id=59596",""],[6152,"مروا خفافا بالقلوب","https://www.poetsgate.com/ViewPoem.aspx?id=208535",""],[1583,"نحن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73058&r=&rc=15",""]],"verses":[["ما أتى منهمُ نذيرٌ بعَتْبٍ","فَيُلَقَّى هناك داءٌ دواءَ",0,"ا",2,0],["ما اتصلت آية بشعري","تكفل باليسر مرتين",1,"ن",1,0],["ما أَتَينا إِلى الحَياةِ لِنَشقى","فَأَريحوا أَهلا العُقولِ العُقولا",2,"ل",2,0],["ما اِتَّعَظتُم بِالسِنينَ البارِحَه","لا وَلا أَنتُم غَداً مُتَّعِظون",3,"ن",1,0],["ما أتلفت إلا لتوجد فائقا","ما أحكم الإيجاد في الاتلاف",4,"ف",1,0],["ما اتى الكهرباء في الذكر الا","كان للفضل باسمه مقرونا",5,"ن",2,0],["ما أَتى عِندي اِبنُ طاهِرِ شَيئاً","مِثلَ حَطّي إِلى اِرتِجاءِ نَوالِك",6,"ك",1,1],["ما أَتاني شَعبانُ مِن قَبلُ إِلّا","وَفُؤادي مِن خَوفِهِ شَعبانِ",7,"ن",1,0],["ما أتعس الناي بين ال","منى وبين المنايا",8,"ا",3,0],["ما أتعس الأرضَ بعُبَّادها","تُبهِجُ من أخلاطِهم ما تُبيح",9,"ح",1,0],["ما أَتعَبَ اللُوّامَ إن مَلَكَ الهَوى","رِقَّ القُلوبِ وَطَوَّقَ الأَعناقا",10,"ق",2,0],["ما أَتى ما كَرَهتَ قَطُّ وَلا أَذ","نَبَ ذَنباً مُستَأهِلاً لِلعِقابِ",11,"ب",1,0],["مَا أتى بالعقِيدَتَيْنِ كتابٌ","واعتقادٌ لا نَصَّ فيه ادِّعاءُ",12,"ا",2,0],["ما أتاني منها ولا الدِّرْهَمُ الفَرْ","دُ وَهذا حقيقةُ العُدْوانِ",13,"ن",1,0],["ما اِتَّقَت سُخطي وَلا رَوَّعَها","مُرهَفٌ النابِ بِزَأرٍ مَأسَدا",14,"د",2,0],["ما أَتعَس الحسناء يم","لك أَمرها الزوج العَنيف",15,"ف",1,0],["ما اتّبع الحقّ إذا تغلّبا","كرجلٍ في باطلٍ تصلّبا",16,"ب",2,0],["مَا اتْخَذْتَ الثَّرَاءَ إِلاَّ سَبِيلاً","لِدِرَاكِ العُلَى وَنِعْمَ السَّبِيلُ",17,"ل",1,0],["ما أَتعَبَ الناسَ أَحياءً وَأَروَحَهُم","مَوتى لَوَ اِنَّ رَميماً غَيرَ مَبعوثِ",18,"ث",1,0],["ما أتعسَ الزمنَ الجديدَ بِفِتْيةٍ","قتلوه في التصفيفِ والتدليك",19,"ك",1,0],["ما أتينا إلى الحياة لنشقى","فأريحوا ، أهل العقول، العقولا",20,"ل",2,0],["ما أتعبنا … يا أخت ، وما","أقوى وأمرّ عدى الإنسان",21,"ن",1,0],["ما أتاك العبد الضعيف ينادي","يا نبياً علا على الأنبياء",22,"ا",2,0],["ما أتاهُ مِن قومهِ السخطُ إلّا","كانَ مِنها لقلبه إرضاءُ",23,"ا",2,0],["ما أتركنها ولو نموت جميعا","ما أقبل الشرع ما استمع قائليه",24,"ي",2,0],["ما أتى بالجناس واللف والنش","ر ولا بالتعجيز والتصدير",25,"ر",1,0],["ما اتّقى الله بأحشائي ولا","راقبَ المأثم فيما أثما",26,"م",2,0],["ما أتيت الحظّ طول الدهر من أسلٍ","غادرتهُ وله من هامهم ثمرُ",27,"ر",1,0],["ما أتعب المحرومَ يأ","مُلُ أنّ حرصاً يرزقُهْ",28,"ق",2,0],["مَا أَتَتْه تِلك السِّيادَةُ عن ج","دٍّ وَلكن أَتَتْه عَنْ أَجْدَاد",29,"د",1,0],["ما أتعب الراح إذا","بريقه لم تمز",30,"ز",1,0],["ما أتعبَ الإنسانَ في مَسعاتهِ","إلاّ إذا واتاه جَدٌّ صاعدٌ",31,"د",1,1],["ما أتى الناسَ مثلُ ذا العامِ عامٌ","لا ولا جاء مثلُ ذا الحينِ حين",32,"ن",1,0],["ما أَتّقي الموتَ عند ذِكرِكُمُ","إلاّ بوَضْعي يدي على كبِدي",33,"د",2,0],["ما أترفَ الدهرُ إنسانا وساعده","إلا وقد ضاره يوماً وقد ظَلَما",34,"م",2,0],["ما أتعسَ الأرضَ تدمى فوقَ مذبحِها","وقد تساوى عليها الجُحْرُ والقِممُ",35,"م",1,0],["ما أتاكم يبغي قِراكَ ولكن","شاقه من صفاتك الاسلامُ",36,"م",1,0],["ما أتته نفس بعلة فقر","لعلاج إلا أراها دَواها",37,"ا",3,0],["ما أَتاهُ معدم مجتدياً","قطّ إلّا صارَ معدوم العدَم",38,"م",1,0],["ما أتى الدهر بمولى فخّما","مثله تخت الفخار الأنسِ",39,"س",1,0],["ما اتى وارد بفياض غيب","أو تجلت حقيقة في المثال",40,"ل",1,0],["ما أتمَّ المجدُ فيكم فالزمان","منكُم العليا به في كلِّ حين",41,"ن",1,0],["ما أترع الشام يا خير الورى نعما","إلّا نداك الذي بالطيبات همى",42,"م",2,1],["ما اِتَّسَعَت أَرضٌ إِذا كانَ مَن","تُبغِضُ في شَيءٍ مِنَ الأَرضِ",43,"ض",1,1],["ما أتى عالم الشهادة حتى","ضاق من معجزاته فطواها",44,"ا",3,0],["ما أتاه الظهير إلاَّ لواه ال","رعب حتى كأنَّهُ ما أتاها",44,"ا",3,0],["ما اتسعت طرق الهوى فيه لي","إلا وضاقت في الجفا حيلتي",45,"ت",2,0],["ما أَتَى زَائرٌ لَهُ","فَرَجَع خائِباً وَعاد",46,"د",1,0],["ما أتت تستميح رفداً وإن","كانت أيادي كفكم غير نَزْرَه",47,"ر",2,0],["ما أتانا به لضربِ مثالٍ","نعلم الحقَّ منه حقاً يقينا",48,"ن",2,0],["ما أتينا محرَماً نحذره","بل أتينا فيه ما الله عفا",49,"ف",2,0],["ما اتاه سائل الا ومن","فضله يعطيه ما قد سألا",50,"ل",2,0],["ما أتى آخرا سوى لمزايا","فيه ذو العرش حكمة أخفاها",51,"ا",3,0],["ما اتفقنا إِلّا عَلى صُحبَةِ الدَّه","رِ وَلَكِن بَدا لَكُم فَبَدا لي",52,"ل",2,0],["مَا اتعب العَذَالِ يَلْحُونني","فيكم ومَنْ ذا يسمعُ العُذَّلاَ",53,"ل",2,0],["مَا أتْعب الشيخ الكبير وُلوعُه","وتعاف صحبتَه الفتاةُ الناهدُ",54,"د",1,0],["ما اتخذوا مهداً له وإنما","ظهر السماك مهده الممهد",55,"د",1,0],["ما أَتينا وَقَد ثَملنا جُناحاً","ما عَلى حاملي الهَوى مِن جُناح",56,"ح",1,0],["ما أتانا في المعالي مدحةً","بلسان الصدق الا الكن",57,"ن",1,0],["ما أَتَيتُ الغَداةَ أَمراً دَنِيّاً","وَلَدى اللَهِ كابِرُ الأَعمالِ",58,"ل",1,0],["ما أتعب العيش اذا كان في","جنب مليك مستبدّ الفخار",59,"ر",1,0],["ما اتخذوا النقد لهم حرفة","الا لخبث في النوايا أصيل",60,"ل",1,0],["ما اتخذ الله حبيباً غيره","فكيف لا يخلق أحسن الصور",61,"ر",1,0],["ما أتلع الجيد من بيضاء عاطلة","جادت صحيفته من غير تجويد",62,"د",1,0],["مَا أتاه وافدٌ إِلاَّ انثنى","وعليه من سحاب الجودِ سَحّ",63,"ح",1,0],["ما أَتاهُ الشَقُى يَرجوه إِلا","أُفعِمَ القَلبُ منه بِالإيمانِ",64,"ن",1,0],["ما أتت غرةً ترجى حياةً","لا ولا كان نهجها مسدودا",65,"د",2,0],["ما أتى للعراق مثل عل","ومتى أعقب النهار النهارا",66,"ر",2,0],["ما أتينا بها المثاني فلا غر","وإذا ما سمناك بالتنزيل",67,"ل",1,0],["ما أَتعب الأَجسامَ في طلب المُنى","بَين ازدجار نُهاك أَو تحريصها",68,"ص",3,0],["ما أَتعب الإنسان إِلا بذله","للمعتفي وَالكدّ غب طلابه",69,"ب",2,0],["ما أَتحَفَت شَمسُ الضُحى بَدرَها","وَأَسعَفَت بِالصُفودِ وَالاِمتِنانِ",70,"ن",1,0],["ما أتى صبح وما ليل مضى","عدد الأيام طراً والسنين",71,"ن",1,0],["ما اتخَّذتَ المِلاحَ جُنداً إلى أن","قُمتَ بالحُسنِ بينَهُم سُلطانا",72,"ن",2,0],["ما أتعَبته المكرماتُ لثقلها","مُذ قامَ يحملُ باسماً أعباءها",73,"ا",3,0],["ما أتاك الفوريُّ داعيك يملي","دُرَرَ المدحِ من صحائفِ علمِ",74,"م",1,0],["ما أتاح اللَه ايامَ النوى","عنهمُ إلا لنا الموتُ اتاحا",75,"ح",2,0],["ما اتخذوا غير أثير العلا","لهم وهم أسد الشرى مربضا",76,"ض",2,0],["ما اتحف الأشياء حين تواترت","عن نصرة الأشبال وقت توطد",77,"د",1,0],["ما أتى مستفسرٌ حيرانَ إلا","جاء من بَحر الهدى الردُّ ارتجالا",78,"ل",2,0],["ما أتى مجدبٌ إلى الرفد إلا","عاد والوجه من نداها خضيل",79,"ل",1,0],["ما أتى ذكره على الناس إلا","جاءه الجود خاضعاً والسخاء",80,"ا",2,0],["ما أتاها ذو حشاً قد جفَّ إلا","دونَ رِيٍّ ردَّ عنها وهو صادِ",81,"د",1,0],["ما أتفه الشعر إن لم تعلُ درته","هام الطغاة وما لم يحطم الوثنا",82,"ن",2,0],["ما اتحدنآ بعض السوآلف على العيب","العيب حآجه مآنقدّر مدآهآ",83,"ا",3,0],["مآآتنكر السآعه مرور الثوآني","وحتى العشير اشلون ينكر عشيره",84,"ر",2,0],["ما أتبع المقفي ولا أنشد اسباب","فرقى الردي مكسب ولا هو كُفوٍ لّي",85,"ل",2,0],[".. ما أتْفَهَ العُمْرَ لو عِشْنَا نُبَدِّدُهُ","كَمَا يُبَدِّدُ حُرَّ المَالِ أغْرَارُ",86,"ر",1,0],["ما اتخذت أعيننا مقاصدا","حتى أرتها المهج المقاتلا",87,"ل",2,0],["ما اتّخذتُ الصحبَ مُرْتَكَنًا","واتّخذتُ اللهَ لي سندا",88,"د",2,0],["ما أتقن الإنسان أسدى له","مجد جميل الصّنع في الآخر",89,"ر",1,0],["ما اتى قبلها ولابعد ,ياتي","مثلها اذ تحدت الازمانا",90,"ن",2,0],["ما أتعب الحر يرضى العقل عن شيم","للنفس أو عنه يرضها بلا سأم",91,"م",1,0],["ما أتمّ ما أوضحا","ما أورقا ما أنمّ",92,"م",1,0],["ما اتخذتُ الإرهابَ دينا ونهجٍا","لا، ولا حتي فكرةً وحوارا",93,"ر",2,0],["ماأتفه العبد منسوبا لثورته","وثورة العبد إفلاسٌ بإفلاسِ",94,"س",1,0],["ماأتينا الحياة إلا لفعلٍ","يتسامى عن زلةٍ رعناء",95,"ا",2,0],["ماأتعس العشق إنْ لم يُغره الخطأ","هل في الممات جمالٌ أيها الصدأ؟",96,"ا",1,1],["ماأتعسَ النفس إنْ في غيّها انصرفت","عن وصل فاطرها القُدوس فانقطعا!!",97,"ع",2,0],["مااتباعي هوية الجهل فوزا","إنما المرء بالفضائل فائز",98,"ز",1,0],["ما أتعسَ القلبَ حَظًّا حينَ تَذبَحُهُ","كَفُّ الجَرِيمَةِ عُدوَانًا بِلا سَبَبِ",99,"ب",1,0],["ما أتلفت مالى مشعشعة","في كأسها كتوقّد الجمر",100,"ر",1,0],["ما أتعبَتهُ العَوادي عَدّها وعَدا","وكلما ضيّقوها حوله سَمَقا",101,"ق",2,0],["ما أتفه الشعر كانه هالحكي اللي نقول","لا تعدى المديح ولا تعدى الغزل",102,"ل",1,0],["ما أتعس العمر والدنيا بفتنتها","ذات احتضارٍ وآلامٍ تقلّبهُ",103,"ب",2,0],["ما أَتاهُ مُعْدِمٌ مُجْتَدِياً","قَطُّ إِلاَّ سارَ مَعْدُومَ العَدَمْ",104,"م",1,0],["ما أتعس الشعر إن كانت موائدهم","تملي عليه ومنها راح يرتزق!!",105,"ق",1,0],["ما اترك طريق العدل في كل الاحوال","لو يرحل المريخ للفرقدينا",106,"ن",2,0],["ما اتوقع جروحي في غيابه تطيب","دام بي شوق يغمرني لنبضه غمر",107,"ر",1,0],["ما أتعسَ النفسَ إن تعثرْ بويلاتِ","وينزوي القلبُ خفَّاقًا بأنَّاتِ",108,"ت",1,1],["ما أتْعَسَ الإنسان يعشق مخلصاً","لكنَّما الثاني يُعِدُّ شِراكا",109,"ك",2,0],["ما أتعسَ العمر إنْ نُجْهِزْ على خطإٍ","هُمْ أخطؤوه، وإنْ نخطِئْ يُحِبُّونا",110,"ن",2,0],["ما أتفه المخلوق يقبل موقفاً","يدعو إلى وجهين بالتغريرِ",111,"ر",1,0],["ما أتفه القاضي الذي يصغي إلى","همس الدسائسِ ليس يردعه دمُ",112,"م",1,0],["ما أتعسَ الأحْيا بعزم شبابهم","ما أيأس الأحيا وصاروا الأضعَفا",113,"ف",2,0],["ما أتعس الأشياء إن يتصنعوا","وترى بها زيف المشاعر خيّما",114,"م",2,0],["ما اتعسَ الركبُ والمرؤوسُ في خطرٍ","أجسادُه تشتكي والزرعُ مأكولُ",115,"ل",1,0],["ما أتى حيّه طريدَ خطوبٍ","يشتكيها الاّ وأجلى وأنعم",116,"م",1,0],["مَا اتَبَعْتَ الأَهوَاءَ حِينًا بِأمرٍ","وانتهجتَ الإنصافَ للفقرَاءِ",117,"ا",2,0],["ما أتعس الدنيا بغير قناعة","ما أجمل الدنيا بنفس قانعة",118,"ع",2,0],["ما أَتانا المحال إِلا سأَلناه:","أَعفوٌ ما يبتغي أَم حُماة.",119,"ا",2,0]]}