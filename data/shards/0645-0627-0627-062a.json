{"poems":[[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"أقول لما رأيت عرسي","https://www.aldiwan.net/poem66512.html","مخلع البسيط"],[91,"أيهذا الشاكي وما بك داء","https://www.aldiwan.net/poem62667.html","عموديه"],[91,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[89,"حول الحقيقة في الحياة طوافي","https://www.aldiwan.net/poem44615.html","الكامل"],[89,"عاث هذا المنون يسرف فينا","https://www.aldiwan.net/poem44774.html","الخفيف"],[45,"ما أتى عندي ابن طاهر شيئا","https://www.aldiwan.net/poem65550.html","الخفيف"],[66,"دق شوال في قفا رمضان","https://www.aldiwan.net/poem39193.html","الخفيف"],[97,"كم مرة يا حبيبي","https://www.aldiwan.net/poem24797.html","المجتث"],[97,"يا أيها العالي الغفور الصفوح","https://www.aldiwan.net/poem24918.html","السريع"],[105,"هل ليم نضو صبابة فأفاقا","https://www.aldiwan.net/poem43377.html","الكامل"],[52,"يا إمام الهدى ويا أحكم الناس","https://www.aldiwan.net/poem27265.html","الخفيف"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"ليت شعري ما مقتضى حرماني","https://www.aldiwan.net/poem18113.html","الخفيف"],[50,"يا ابنة الخير عدينا موعدا","https://www.aldiwan.net/poem63924.html","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85373","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43675","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[91,"فلسفة الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=53232",""],[100,"ساعة نقاش مع طالبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67693&r=&rc=180",""],[115,"يا نبيا على الأنبياء","https://www.aldiwan.net/poem42164.html","الخفيف"],[189,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[391,"عجبا للزمان مع أهليه","https://www.aldiwan.net/poem54451.html","عموديه"],[403,"ما يصان الغرام بالتستير","https://www.aldiwan.net/poem33908.html","الخفيف"],[416,"هاتها حمراء تحكي العندما","https://www.aldiwan.net/poem54068.html","الرمل"],[437,"نصر من الله وافانا به الخبر","https://www.aldiwan.net/poem2611.html","البسيط"],[458,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[575,"سلام عليه لا على الدهر بعده","https://www.aldiwan.net/poem3075.html","الطويل"]],"verses":[["ما أتى منهمُ نذيرٌ بعَتْبٍ","فَيُلَقَّى هناك داءٌ دواءَ",0,"ا",2,0],["ما اتصلت آية بشعري","تكفل باليسر مرتين",1,"ن",1,0],["ما أَتَينا إِلى الحَياةِ لِنَشقى","فَأَريحوا أَهلا العُقولِ العُقولا",2,"ل",2,0],["ما اِتَّعَظتُم بِالسِنينَ البارِحَه","لا وَلا أَنتُم غَداً مُتَّعِظون",3,"ن",1,0],["ما أتلفت إلا لتوجد فائقا","ما أحكم الإيجاد في الاتلاف",4,"ف",1,0],["ما اتى الكهرباء في الذكر الا","كان للفضل باسمه مقرونا",5,"ن",2,0],["ما أَتى عِندي اِبنُ طاهِرِ شَيئاً","مِثلَ حَطّي إِلى اِرتِجاءِ نَوالِك",6,"ك",1,1],["ما أَتاني شَعبانُ مِن قَبلُ إِلّا","وَفُؤادي مِن خَوفِهِ شَعبانِ",7,"ن",1,0],["ما أتعس الناي بين ال","منى وبين المنايا",8,"ا",3,0],["ما أتعس الأرضَ بعُبَّادها","تُبهِجُ من أخلاطِهم ما تُبيح",9,"ح",1,0],["ما أَتعَبَ اللُوّامَ إن مَلَكَ الهَوى","رِقَّ القُلوبِ وَطَوَّقَ الأَعناقا",10,"ق",2,0],["ما أَتى ما كَرَهتَ قَطُّ وَلا أَذ","نَبَ ذَنباً مُستَأهِلاً لِلعِقابِ",11,"ب",1,0],["مَا أتى بالعقِيدَتَيْنِ كتابٌ","واعتقادٌ لا نَصَّ فيه ادِّعاءُ",12,"ا",2,0],["ما أتاني منها ولا الدِّرْهَمُ الفَرْ","دُ وَهذا حقيقةُ العُدْوانِ",13,"ن",1,0],["ما اِتَّقَت سُخطي وَلا رَوَّعَها","مُرهَفٌ النابِ بِزَأرٍ مَأسَدا",14,"د",2,0],["ما أَتعَس الحسناء يم","لك أَمرها الزوج العَنيف",15,"ف",1,0],["ما اتّبع الحقّ إذا تغلّبا","كرجلٍ في باطلٍ تصلّبا",16,"ب",2,0],["مَا اتْخَذْتَ الثَّرَاءَ إِلاَّ سَبِيلاً","لِدِرَاكِ العُلَى وَنِعْمَ السَّبِيلُ",17,"ل",1,0],["ما أَتعَبَ الناسَ أَحياءً وَأَروَحَهُم","مَوتى لَوَ اِنَّ رَميماً غَيرَ مَبعوثِ",18,"ث",1,0],["ما أتعسَ الزمنَ الجديدَ بِفِتْيةٍ","قتلوه في التصفيفِ والتدليك",19,"ك",1,0],["ما أتينا إلى الحياة لنشقى","فأريحوا ، أهل العقول، العقولا",20,"ل",2,0],["ما أتعبنا … يا أخت ، وما","أقوى وأمرّ عدى الإنسان",21,"ن",1,0],["ما أتاك العبد الضعيف ينادي","يا نبياً علا على الأنبياء",22,"ا",2,0],["ما أتاهُ مِن قومهِ السخطُ إلّا","كانَ مِنها لقلبه إرضاءُ",23,"ا",2,0],["ما أتركنها ولو نموت جميعا","ما أقبل الشرع ما استمع قائليه",24,"ي",2,0],["ما أتى بالجناس واللف والنش","ر ولا بالتعجيز والتصدير",25,"ر",1,0],["ما اتّقى الله بأحشائي ولا","راقبَ المأثم فيما أثما",26,"م",2,0],["ما أتيت الحظّ طول الدهر من أسلٍ","غادرتهُ وله من هامهم ثمرُ",27,"ر",1,0],["ما أتعب المحرومَ يأ","مُلُ أنّ حرصاً يرزقُهْ",28,"ق",2,0],["مَا أَتَتْه تِلك السِّيادَةُ عن ج","دٍّ وَلكن أَتَتْه عَنْ أَجْدَاد",29,"د",1,0]]}