{"poems":[[50,"أقول وقد رأت بالوجه مني","https://www.aldiwan.net/poem62487.html","الوافر"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[4709,"من أين لي بحروف أخرى","https://www.poetsgate.com/ViewPoem.aspx?id=214868",""],[4884,"حروفٌ أربعٌ","https://www.poetsgate.com/ViewPoem.aspx?id=202264",""],[4884,"قهوة أمي","https://www.poetsgate.com/ViewPoem.aspx?id=210383",""]],"verses":[["وَياءَحلى وَأَشهى الناسِ طُرّاً","وَإِن شُبِّهتِ ظُلماً بِالسِماجِ",0,"ج",1,0],["وياء نفس ثم في المضاف","أليه والمضاف غير خاف",1,"ف",1,0],["وياء كالقاضي برفع أو بجر","يجري كمنصوب وفي نظم ظهر",2,"ر",1,0],["وياءُ خسفٍ إن أتى الهابط به","كصاعدٍ تصحيحُهُ لم يشتبِه",3,"ه",1,0],["وَيَاءً اقلِب ألِفاً كَسراً تَلاَ","أو ياءَ تَصغِيرٍ بِوَاوٍ ذَا افعَلاَ",4,"ل",2,0],["وياءٍ يطيبُ الوصالُ ويحلو","فطيبُ اللقاءِ عناقٌ مُريحُ",5,"ح",1,0],["وياءُ يدِ المُعْطينَ طولى بخيمةٍ","تجودُ بها كفُّ النّبيِّ سواقيا",6,"ي",2,0],["وياءُ يديها يستقي من جَنانِها","وينهلُّ فيضاً بالحنانِ تبجّسا",7,"س",2,0]]}