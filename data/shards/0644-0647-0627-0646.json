oetry.dctabudhabi.ae/diwan/poem/131284",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114516","البسيط"],[3890,"","https://poetry.dctabudhabi.ae/diwan/poem/124624","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70154","الوافر"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69900","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123514","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102735","الطويل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117302","الطويل"],[4526,"","https://poetry.dctabudhabi.ae/diwan/poem/75839","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72617","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139530",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139591",""],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101941","المتقارب"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204369","الكامل"],[416,"همامٌ إمامٌ لهُ قدرة ٌ","https://www.poetsgate.com/ViewPoem.aspx?id=22330",""],[4846,"ألا يا من لقلبٍ مستحسن","https://www.poetsgate.com/ViewPoem.aspx?id=82707",""],[5102,"ضربة شمس في شاطئ الراحة","https://www.poetsgate.com/ViewPoem.aspx?id=15691",""],[5136,"نعم أنا لا أرجو إذا ألوت اللوى","https://www.poetsgate.com/ViewPoem.aspx?id=121784",""],[5277,"الذهول","https://www.poetsgate.com/ViewPoem.aspx?id=184871",""],[5431,"على ثغرِ مزمار الرياح معلّقُ","https://www.poetsgate.com/ViewPoem.aspx?id=195131",""],[5431,"أبانا الروحي...","https://www.poetsgate.com/ViewPoem.aspx?id=210262",""],[5582,"بَدَتْ بِالسَّلامِ وَلانَتْ مَقالا","https://www.poetsgate.com/ViewPoem.aspx?id=187239",""],[5582,"أَرَسْماً تَرَى أَمْ ذاكَ رَجْعُ وِشامِ","https://www.poetsgate.com/ViewPoem.aspx?id=63569",""],[5864,"يومٌ يظلُّ بسِفرِ الدَّهر عنوانا","https://www.poetsgate.com/ViewPoem.aspx?id=190052",""],[5867,"مَرِيضَة كرّ الطّرف مجدولة الحشا","https://www.poetsgate.com/ViewPoem.aspx?id=189666",""],[5916,"الى ليلى ...","https://www.poetsgate.com/ViewPoem.aspx?id=190587",""],[6209,"نعيقْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82549&r=&rc=18",""]],"verses":[["لَهانَ الغِمدُ ما بَقِيَ الحُسامُ","وَبَعضُ النَقصِ آوِنَةً تَمامُ",0,"م",1,1],["لَها نَسَبُ العِتاقِ مُرَدَّداتٍ","إِلى الغاياتِ أَيّامَ النِضالِ",1,"ل",1,0],["لَهانَ عَلَينا ذَهابُ الرَديفِ","ما بَقِيَ الظَهرُ وَالراكِبُ",2,"ب",1,0],["لَها نَظرَةٌ عَجلى عَلى دَهَشِ النَّوى","كَما نَظَرَتْ مَذعورَةً أُمُّ شادِنِ",3,"ن",1,0],["لَها نَظرَةٌ تُهدي إِلى الصَبِّ سَكرَةً","كَأَنَّ بِعَينَيها كؤوساً تُديرُها",4,"ه",2,0],["لها نَظَراتُ الرّيمِ تَملأُ سَمْعهُ","حَفيفاً بأيدي القانِعينَ نِبالُ",5,"ل",1,0],["لَهَا نَبَرَاتُ صَوْتِ تَسْبِيِّنَا","إذَا عَجَلَتْ وَتَصْبِي فِي التَأَنِّي",6,"ن",2,0],["لَهانَ عَلى سَراةِ بَني لُؤَيٍّ","حَريقٌ بِالبُوَيرَةِ مُستَطيرُ",7,"ر",1,0],["لَها نَزَقُ مِثلُ الجُنونِ وَمَصرَعٌ","دَنيءٌ وَأَنَّ العَقلَ يَنأى وَيَعزُبُ",8,"ب",1,0],["لها نبات بالمنى مغدوقة","من طيبةٍ واحدة مخلوقة",9,"ه",1,0],["له أن يَذُبَّ الليثَ عن ظلم ثعلبٍ","وليس له إذلالُ ليثٍ لثعلبِ",10,"ب",1,0],["لها ناظرٌ بالسحر في القلب نافثُ","ووجهٌ على كسبِ الخطيئات باعثُ",11,"ث",1,1],["له أنثى تَزِيفُ إلى سواه","وتأخُذُه بِتَرْبِيةِ الفِرَاخِ",12,"خ",1,0],["لهان على سُليمى كم قتيلٌ","يُغادرُ في المَكرِّ وكم صريعُ",13,"ع",1,1],["لها نكهةٌ تحكي بها إنْ تَكَلَّمتْ","فأهدتْ إلى المُشْتَمِّ من رِيحها الفَسْوَى",14,"و",2,0],["لَهانَ عَلَينا وَالَّذي أَنا عَبدُهُ","دُعاؤُكَ في أَرماحِنا يالَ عامِرِ",15,"ر",1,0],["لَهانَ عَلى فِتيانِ بَكرِ اِبنِ وائِلِ","وَتَغلِبَ إِصعادٌ بِذاتِ الجَحافِلِ",16,"ل",1,1],["لَهانَ عَلَيهِ المَوتُ لَو كانَ عَسكَراً","يُلاقيهِ أَوخَصماً أَلَدَّ يُخاصِمُه",17,"م",2,0],["لَها نَفَسٌ بَعدَ الكَرى مِن رُقادِها","كَأَنَّ فُغامَ المِسكِ بِاللَيلِ شامِلُه",18,"ل",2,0],["لها نظيرُ أقاحٍ ما به صدأ","بإسحلٍ زار من أطرافها عنما",19,"م",2,0],["لَها نَغَمٌ لَيسَت دُموعاً فَإِن عَلَت","مَضَت حَيثُ لا تَمضي الدُموعُ السَواجِمُ",20,"م",1,0],["لَهانَ عَلَينا أَن نَقولَ وَتَفعَلا","وَنَذكُرَ بَعضَ الفَضلِ عَنكَ وَتُفضِلا",21,"ل",2,1],["لَهَا نَظْرَةٌ لَوْ خَامَرَتْ قَلْبَ حَازِمٍ","لأَصْبَحَ مَسْلُوبَ النُّهَى غَيْرَ حَازِمِ",22,"م",1,0],["لَها نَفَسٌ يَسري مَعَ اللَيلِ عاطِرٌ","كَأَنَّ لَهُ سِرّاً هُناكَ يَريبُ",23,"ب",1,0],["لَها نُضرَةٌ سِمتُها نَظرَةً","وَتَكلَفُ بِالأَنفُسِ الأَنفُسُ",24,"س",1,0],["لَهانَ على نُعاتِكَ أن نُصابا","وإن فزِعوا لخطبك حين نابا",25,"ب",2,1],["له إن آثَرَ الإسلامَ دِيناً","عَطَاءٌ لا تُجاوِزُهُ الأماني",26,"ن",2,0],["لَها نَصَفاتٌ حَولَها يَستَلِمنَها","كَما اِستَلَمَ الرُكنَ النَواسِكُ بِالراحِ",27,"ح",1,0],["لَها ناظِرٌ لَم يَدرِ ما سِنَةُ الكَرى","وَلا ذُرَّ مُذ قالَ المَليكُ لَهُ ذُرّا",28,"ر",2,0],["لَهانَ عَلى أَقارِبِكِ الأَداني","قِيامُكِ عَن خَديجٍ غَيرِ تَمِّ",29,"م",1,0],["لَهانَ عَلَينا أَن تَمُرَّ كَأَنَّها","هَوازِنُ طَيرٍ نِسوَةٌ مِن هَوازِنِ",30,"ن",1,1],["لها نظر كالسيف ماض غرارُهُ","وَوجه كمثل الزهر أَو هو أَزهر",31,"ر",1,0],["لَهَا نَظْرَةٌ سَكْرَى إِذَا أَرْسَلَتْ بِهَا","إِلَى كَبِدٍ فَالْوَيْلُ مِنْ ذَاكَ وَالثُكْلُ",32,"ل",1,0],["لَهُ إِنْ يَشَأْ نَقْضُ مَا أَبْرَمَتْ","وَلا يَنْقُضُ الدَّهْرُ مَا يُبْرِمُ",33,"م",1,0],["له أنَّةُ المجروحِ أعيا طبيبَه","وضجَّ لما يشكو وسادٌ ومَضْجَع",34,"ع",1,0],["لها نشوةٌ لو أنَّ للكرمِ مثلها","لما كانَ إثْماً أنْ تساغَ ابنةُ الكرْمِ",35,"م",1,0],["لها نَهَلٌ من الأممِ المواضي","ومما تَنْسُلُ الأيامُ عَلّ",36,"ل",1,0],["له انتمي في طي كوني وانني","رشفت حمياه الشريفة في مهدي",37,"د",2,0],["لهان عليّ أن ألقى حمامي","وأطوى تحت طيات الرغام",38,"م",1,1],["لَها ناهِضٌ في الوَكرِ قَد مَهَدَت لَهُ","كَما مَهَدَت لِلبَعلِ حَسناءُ عاقِرُ",39,"ر",1,0],["لَها نَظَرُ الأَجادِلِ إِذ تُخَلّى","وَعِندَ الأَرضِ أَجنِحَةُ الأَجادِل",40,"ل",1,0],["له أنة من شوقه بعد أنة","إذا الليل جاشت بالهموم عساكره",41,"ر",2,0],["لها نعمةٌ لو في المعاد تقسمت","لعاشت بها الموتى الى نفخ صُورها",42,"ر",3,0],["لَها نَسيمٌ بَرَيّا","أَخلاقِكَ الغِرُّ فائِح",43,"ح",1,0],["لها نفَسٌ لو كان في هبَّةِ الصِّبا","لعطَّرت الأغصان والماءَ والثَّرى",44,"ر",2,0],["لَهَانَ عَلَيَّ الصَّعْبُ في حُبِّ عمرَةٍ","وإنْ غاب في أعقابِ رِحْلتها العُمرُ",45,"ر",1,0],["لَهانَ بَنو التُركِ حَتّى غَدَوا","مَماليكَ كُلِّ لَئيمٍ خَسيسِ",46,"س",1,1],["له إن دعته للسماح بواعثٌ","تفرد واعٍ إذ تفر دواعي",47,"ي",1,0],["لَها نَظرَةً لا يَدَّعي فِعلَها الخَمرُ","وَلي سَكرَةٌ لا يَقتَضي مِثلَها السُكرُ",48,"ر",1,1],["لَها نَظرَةٌ إِذ تُحَيّي بِها","يَغُضُّ لَها عَينَهُ النَرجِسُ",49,"س",1,0],["له انفرادٌ بخصالٍ تُذكَر","بأن شاه ستره ليس يُستَر",50,"ر",1,0],["لها نبض يكاد يذوب وجداً","بماللشوق فيها من لهيب",51,"ب",1,0],["لَهُ إِن رَأَى سائِلاً يَجتَديهِ","نَفسٌ تَجودُ بِأَقواتِها",52,"ت",3,0],["لها ناظرٌ في ذُرى ناضِرٍ","كما رُكِّبَ السنُّ فوق القناةِ",53,"ه",1,1],["لها نسَبٌ في الشعر كالفَجر في الدُّجى","متى تُظلِمِ الأنسابُ تُرفَعْ مشاعلُهْ",54,"ل",2,0],["لها نَفَحاتٌ بالعَشيِّ كأنها","لَطيمةُ داريٍّ يُفتُّ عَبيرها",55,"ر",3,0],["لَهان على لمياءَ يومَ سويقةٍ","وقد أعرضت قلبٌ بلمياءَ متروح",56,"ح",1,0],["لهَان عَلى النَّفسِ حُسَّادُها","لهَان على النَّاس إنجَادُها",57,"د",3,0],["لهان خطبُ لِيوثِ الغابِ ما رَضِيَت","تأبّداً في بطونِ الغيلِ والأجمِ",58,"م",1,0],["لها ناظرٌ يا حيرةَ الظبي إِذْ رنا","به كَحَلٌ ناداه يا خَجلة الكُحل",59,"ل",1,0],["له أنف حكى خرطوم فيل","إلى شفتين مثل الكلبتين",60,"ن",1,1],["لَها نَشَرٌ في كُلِّ آخِرِ لَيلَةٍ","تَذكُرُ أَعراسَ المُلوكِ الأَكابِرِ",61,"ر",1,0],["لهان ما انا لاق من فراقكم","لو يرتدع عني اللاجي بمرتدع",62,"ع",1,0],["لهان عليَّ البعدُ منك تجلداً","وإن كان قلبي دائِمَ الحسرات",63,"ت",1,0],["لهان عليك الوجد إذ بات مؤرقي","بليل كأنَّ الهجر منك يطاوله",64,"ل",2,0],["لها نظام إذا انظمت فواصله","إلى بروج السما أغنت عن الشهب",65,"ب",1,0],["له أن الأفلاك والأرضين قاطبة","درج عريض له بالمد تطويل",66,"ل",1,0],["لها ناظر ماضي الولاية شاهد","بتوحيد معنى حينها عن مضارع",67,"ع",1,0],["لَهَا نَاظِرٌ كَالنَّرْجِسِ الغَضّ ذَابِلٌ","وَقَدٌّ كَغُصْنِ البَانِ رَيَّانُ نَاضِرُ",68,"ر",1,0],["لَهُ اِنقادت الأملاك قسراً لأنّه","عَليهم وليٌّ مالكٌ متصرّفُ",69,"ف",1,0],["له اِنقادتِ الدنيا وذلّت كأنّه","لما يَنبغي قد قادها بزمامِ",70,"م",1,0],["لَهُ اِنشَقَّ قُرصُ البَدرِ شِقَّينِ وَاِرتَوى","بِماءٍ هَمى مِن كَفِّهِ كُلُّ ظَمآنِ",71,"ن",1,0],["لَها نَجرٌ عَلى الأَجدادِ سامٍ","لِأَقيالٍ شَوامِخَ في عُلاها",72,"ا",3,0],["له أنمل في الحرب نارٌ شديدةٌ","وفي الجود سحبان تسيل وأبحرُ",73,"ر",1,0],["له أنةٌ لا يملك الحلم ردها","إذا هبّ من ذاك الجنابِ جنوبُ",74,"ب",1,0],["له أنملٌ سُحبٌ عشرُها","وراحٌ أساريرُها أبحرُ",75,"ر",1,0],["لها ناظر يعدو على القلب لحظه","وخد على لحظ النواظر يستعدى",76,"د",2,0],["لَها نَفس حي وَنفس مضيئة","هُداها وَأَهداها صفي لمصطفى",77,"ف",2,0],["لها نسب محض من النور والضياء","لَها سبب فرض من البيت وَالصفا",77,"ف",2,0],["لها ناظرٌ لا يعرف الزور فاترٌ","ولكنه واللَه لا يجهل السحرا",78,"ر",2,0],["له أنطق اللَه الجماد وكلمت","له الوحش والحيوان بالقول أطنبا",79,"ب",2,0],["له انثرُ الدمع السخيّ تشوُّقاً","درّاً وفي سلك الهوى لهُ انظمُ",80,"م",1,0],["لَهانَ عَلَيَّ ما أَلقى وَلَكِن","تَعالي فَانظُري بِمَنِ اِبتَلاني",81,"ن",2,0],["له إن هزّ بإشنين رماحاً","بأتراس من الورق اتقاء",82,"ا",2,0],["لهان على قلبي احتمال فراقه","وكنت على الوجد المبرح اصبر",83,"ر",1,0],["له إِن عَوى للخصمِ كَلْبٌ لدى الوغَى","زئيرُ أسودٍ تحتَ وقعِ الصوارمِ",84,"م",1,0],["لها نفحات الروض في خلل القنا","كأن على الارماح منهن اسحارا",85,"ر",2,0],["لَهانَ عَلَيها أَمسَ مَوقِف راكِبٍ","إِلى جانِبِ السَرَحاتِ أَخيَبَ خائِب",86,"ب",1,0],["لها نسب كماء المزن صافٍ","وشيمتها المودة والوفاء",87,"ا",2,0],["لها نسب عالٍ ومجد مؤثلٌ","وثاقب رأي يزدري مرهف النصل",88,"ل",1,0],["له أنف أو نخوة أو حمية","على ذمة أو همة في المكارم",89,"م",1,0],["له إن شاء إنشاء المعاني","قواف دونها درر النظام",90,"م",1,0],["لها نظر شزر تعالق حبها","وسيان حد السيف والنظر الشزر",91,"ر",1,0],["لها نفثات تعقد السحر بالحجا","وهيهات حل العقد من نفثة السحر",92,"ر",1,0],["لها نور إفرند ورونق جوهر","يكدره أدنى التنفس واللمس",93,"س",1,0],["لَهُ اِنفلق البَحر الَّذي طابَ وَرده","وَفرعونه في جَهله بات مغرقا",94,"ق",2,0],["لَها نَسب في العرب عال فَطبعها","رَقيق وَأَما لَفظها فَصَحيح",95,"ح",1,0],["لَها نِبالٌ من الجفونِ","تُصمي قلوباً بها تذوب",96,"ب",1,0],["لهُ انطوَت مهامِهُ القِفارِ","وكلّمتهُ الحوتُ في البِحارِ",97,"ر",1,0],["ل