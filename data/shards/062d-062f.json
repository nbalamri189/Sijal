/www.poetsgate.com/ViewPoem.aspx?id=179602",""],[106,"سفينة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179666",""],[106,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[106,"حديث خرافة","https://www.poetsgate.com/ViewPoem.aspx?id=179406",""],[106,"الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=179448",""],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[77,"حديثٌ على رغم العلا غيرُ كاذبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33316",""],[77,"زمانك أفراح لدينا وأعياد","https://www.poetsgate.com/ViewPoem.aspx?id=33809",""],[100,"الشهيدة","https://www.poetsgate.com/ViewPoem.aspx?id=50326",""],[98,"مصرع النسر","https://www.poetsgate.com/ViewPoem.aspx?id=55338",""],[7,"حَدِّثُوني بني الشَقيقَة ِ","https://www.poetsgate.com/ViewPoem.aspx?id=17585",""],[90,"المازني وداغر","https://www.poetsgate.com/ViewPoem.aspx?id=179154",""],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[90,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[90,"ضحايا الأنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=179024",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[90,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[91,"معركة شمولبو","https://www.poetsgate.com/ViewPoem.aspx?id=53085",""],[91,"تلك المنازل","https://www.poetsgate.com/ViewPoem.aspx?id=53242",""],[91,"ليتهم عرفوه!","https://www.poetsgate.com/ViewPoem.aspx?id=53128",""],[46,"جرى المَينُ فيهمْ، كابراً","https://www.poetsgate.com/ViewPoem.aspx?id=20061",""],[51,"نادمْتُ بدرَ السماءِ في فَلكْه","https://www.poetsgate.com/ViewPoem.aspx?id=30024",""],[51,"قبَّلتْه فمجَّ في جوفِ فيها","https://www.poetsgate.com/ViewPoem.aspx?id=29575",""],[31,"","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19021&r=&rc=284",""],[88,"أقول لهم وقد جدّ الفراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19548&r=&rc=51",""]],"verses":[["حَدَثٌ عَلى الأَحبابِ لا أَشكو الَّذي","يَشكو وَلا أَنسى الَّذي يَنساني",0,"ي",1,0],["حَدَوتَ إِلى فارِسٍ بِالرِماحِ","بِكَرِّ الرَدى يَومَ حَربٍ عَوانِ",1,"ن",1,0],["حَديدُ السَمعِ في حَيثُ","تَكونُ الأُذُنُ العَينا",2,"ن",2,0],["حَدوا عَزَماتٍ ضاعَتِ الأَرضُ بَينَها","فَصارَ سُراهُم في صُدورِ العَزائِمِ",3,"م",1,0],["حَداً فَقَدُهُ كُلَّ العُيونِ إِلى البُكا","فَقَطَّعَ أَرسانَ الدُموعِ السَواجِمِ",4,"م",1,0],["حَدَوا لَهُ مِن حَيثُ لا يَتَّقي","عيراً مِنَ الطَعنِ مِلاءَ الوُسوق",5,"ق",1,0],["حَديثٌ يَضَلُّ القَلبُ عِندَ اِستِماعِهِ","فَليسَ عَجيباً أَن يَضَلَّ قَطيعُ",6,"ع",1,0],["حَدا بِأَظعانِهِم حَتّى اِستَمَرَّ بِها","حادي المَقاديرِ لا يَلوي بِهِم ظَلَعُ",7,"ع",1,0],["حَدَتهُ مِنَ الغَورَينِ هَوجاءَ كُلَّما","وَنى عَجرَفَت فيهِ فَخَبَّ وَأَوضَعا",8,"ع",2,0],["حَدا غَيرَ الغَمامِ إِلَيهِ كَوماً","تَعِزُّ عَلى المَقاوِدِ أَن تُقادا",9,"د",2,0],["حَدَت بِعَصاها آلَ ساسانَ وَالتَوَت","يَداها بِآلِ المُنذِرَينِ الأَشاهِبِ",10,"ب",1,0],["حَدَوا بِالمَطايا يَومَ جالَت غُروضُها","وَيَومَ اِتَّقَت رُكبانُها بِرُغاءِ",11,"ا",2,0],["حَديثٌ رقيقٌ منْ سُعادَ كأنّها","تَشوبُ لَنا ماءَ الغَمامَةِ بالخَمْرِ",12,"ر",1,0],["حَدَبَتْ عليّ قَبائلٌ مُضَريّةٌ","طَلَعَتْ عليكِ أهِلّةً ونُجوما",13,"م",2,0],["حَدَوْتُ بِهمْ أُخرى المَطيِّ ولمْ أكُنْ","لِصَحْبيَ لولا حُبُّ ظَمياءَ حادِيا",14,"ي",2,0],["حَدِّثيني عَمَّن أَشاعَ حَديثاً","أَنا فيهِ وَأَنتِ مُشتَرِكانِ",15,"ن",1,0],["حَدِّثوني عَنِ النَهارِ حَديثاً","أَو صِفوه فَقَد نَسيتُ النَهارا",16,"ر",2,0],["حَدَّثتُ قَلبي كاذِباً عَنكُمُ","حَتّى اِستَحَت عَينَيَ مِن قَلبي",17,"ي",1,0],["حديقة زهر في النهار إذا اجتلى","ومطلع أقمار إذا الليل عسعسا",18,"س",2,0],["حدِّثْ عنِ الكُدْيَةِ مَنْ شِئْتَهُ","يظُنّ أخْبارَكَ تصْحيفَا",19,"ف",2,1],["حَدائِقُ دِيباجٍ سَقَتْها منَ الحَيا","سَحائِبُ أفْكارٍ مهنّأةِ الوِرْدِ",20,"د",1,0],["حَديثٌ لهُ في المَشْرَفيِّ رِوايَةٌ","وعنْدَ العَوالي السّمْهَريّةِ إسْنادُ",21,"د",1,0],["حَديثٌ تَهاداهُ الرّكائِبُ في السّرَى","وتُجْلَى علَى راحِ المسَرّةِ راحُهُ",22,"ح",2,0],["حَدِيثٌ عَلَى رَغْمِ الْعُلاَ غَيْرُ كَاذِبٍ","يَغَصُّ النَّوَادِي عِنْدَه بالنَّوادِبِ",23,"ب",1,1],["حَديثاً أَضَعناهُ كِلانا فَلَن أُرى","وَأَنتَ نَجيّاً آخِرَ الدَهرِ أَجمَعا",24,"ع",2,0],["حَديداً نابُهُ مُستَد","لِقاً مُتَخَمِّطاً قَطِما",25,"م",2,0],["حَدَوا أَكتافُهُم ضَرباً وَطَعناً","وَرَمياً بالمُرَيَّشَةِ اللِطافِ",26,"ف",1,0],["حَديثُ أَناسِيٍّ فَلَما سَمِعتُهُ","إِذا لَيسَ فيهِ ما أَبينُ فَأَعقِلُ",27,"ل",1,0],["حُدَّت عُلا صيدِ المُلو","كِ وَلا أَرى لِعُلاكَ حَدّا",28,"د",2,0],["حَديقَةً لَكَ لَم نَعهَد لَها شَبَهاً","بَينَ الحَدائِقِ في زَهرٍ وَأَفنانِ",29,"ن",1,0],["حَديثَ المُبارِزِ مِنّي اِسأَلوا","أُنَبِّئكُمُ بِأَحاديثِهِ",30,"ه",1,1],["حَدَّثَ عَن أَنفاسِهِ آخِرَ اللَي","لِ وَعَن جَفنٍ لَهُ فاتِرِ",31,"ر",1,0],["حَديثُ صِقالِ الخَدِّ لَم يَذوِ وَردُهُ","وَلا دبَّ كَالريحانِ فيهِ عِذارُهُ",32,"ر",2,0],["حُدَيّا الناسِ كُلِّهِمُ جَميع","مُقارَعَةً بَنيهِم عَن بَنينا",33,"ن",2,0],["حَديدُ السِنانِ ذَليقُ اللِسانِ","يُجازي المَقارِضَ أَمثالَها",34,"ل",3,0],["حَدِّثْ عَنِ الآرَاءِ يَنْ","بُو دُونَهَا النَّصْلُ الْيَمَانِي",35,"ي",1,0],["حَدِيثٌ تَصْدُرُ الأَلْبَابُ عَنْهُ","وَمَا تَدْرِي أَسِحْرٌ أَمْ كَلامُ",36,"م",1,0],["حَدِّثْ عَنْ الْبَلْسَمِ الشَّافِي يُمَرُّ بِهِ","عَلَى الْجِرَاحِ قَدْ اسْتَشْرَتْ فَتَلتَئِمُ",37,"م",1,0],["حَدِّثْ عَنِ البُلْبُلِ الْغِرِّيدِ مُخْتَلِفاً","بَيْنَ الأَفَانِينِ مِنْ تَطْرِيبِهِ النَّغمُ",37,"م",1,0],["حَدِّثْ عَنِ الضَّيْغَمِ السَّاجِي يَثُورُ بِهِ","تَحَرُّشٌ بِحِمَى الأَشْبَالِ لا الْقَرَمُ",37,"م",1,0],["حَدِّثْ عَنِ السَّيْلِ يَجْرِي وَهْوَ مُصْطَخِبٌ","حَدِّثْ عَنِ النَّارِ تَعْلُو وَهْيَ تَحْتَدِمُ",37,"م",1,0],["حَدِّثْ عَنِ الْبَحْرِ وَالأَرْوَاحِ عَاصِفَةٌ","وَالسُّحْبُ عَازِفَةٌ وَالْفُلْكِ تَرْتَطِمُ",37,"م",1,0],["حَدِّثْ عَنِ المَرْأَةِ الجَدِيدَةِ مَا","شِئْتَ وَلا تَحْفَلْنَ بِالتُّهَمِ",38,"م",1,0],["حَدْبٌ عَلَى العَافِينَ لِلضُّعَ","فَاءِ وَالعَانِينَ رَاحِمْ",39,"م",1,0],["حَدِيدُ النَّاظِرَيْنِ إذَا أُثِيرَا","فَمِصْبا