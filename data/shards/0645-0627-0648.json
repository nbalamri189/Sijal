{"poems":[[53,"خير الهوى ما نجا من الكمد","https://www.aldiwan.net/poem30628.html","المنسرح"],[77,"أأزاهير رياض","https://www.aldiwan.net/poem36001.html","مجزوء الرمل"],[42,"ما ولدت أمي من القوم عاجزا","https://www.aldiwan.net/poem50408.html","الطويل"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[10,"أنى تأوبني الأحزان والسهر","https://www.aldiwan.net/poem21087.html","البسيط"],[10,"يا لهف نفسي على صخر وقد فزعت","https://www.aldiwan.net/poem21139.html","البسيط"],[88,"حي هل يا أخا مصر","https://www.aldiwan.net/poem44435.html","مجزوء الخفيف"],[23,"ما ولدتكم قروم من بني أسد","https://www.aldiwan.net/poem21312.html","البسيط"],[23,"ولأصدقن إلى حذيفة مدحتي","https://www.aldiwan.net/poem21598.html","الكامل"],[51,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[51,"أبشر بفتح لك مفتوح","https://www.aldiwan.net/poem9415.html","السريع"],[51,"أتود أنك تجتني ثمر العلا","https://www.aldiwan.net/poem64100.html","الكامل"],[51,"بكعبة الله بل بخالقها","https://www.aldiwan.net/poem65716.html","المنسرح"],[51,"إني إذا ما الخصم في الغي ابترك","https://www.aldiwan.net/poem65823.html","الرجز"],[51,"قل لمن ألبس الجمال جمالا","https://www.aldiwan.net/poem65878.html","الخفيف"],[51,"لا زلت تفخم والثناء ضئيل","https://www.aldiwan.net/poem65988.html","الكامل"],[91,"ما وعظ الإنسان مثل الحمام","https://www.aldiwan.net/poem62748.html","عموديه"],[89,"إن فعل الرجال غير الكلام","https://www.aldiwan.net/poem44616.html","الخفيف"],[85,"ما وصل من تهوى على أنسة","https://www.aldiwan.net/poem7121.html","السريع"],[62,"قد خرج التنين من بحرنا","https://www.aldiwan.net/poem52176.html","السريع"],[45,"نفست قربها علينا كنود","https://www.aldiwan.net/poem62739.html","الخفيف"],[61,"طلب الدهر ثأره","https://www.aldiwan.net/poem51353.html","مجزوء الخفيف"],[61,"ما ودع اللهو لما بان منصرما","https://www.aldiwan.net/poem51437.html","البسيط"],[58,"ما ودني أحد إلا بذلت له","https://www.aldiwan.net/poem31085.html","البسيط"],[49,"ما وعظ العاقل من واعظ","https://www.aldiwan.net/poem62132.html","السريع"],[69,"لهجوا سنين بجوسلين فإنه","https://www.aldiwan.net/poem28047.html","الكامل"],[31,"قرب جيراننا جمالهم","https://www.aldiwan.net/poem42239.html","المنسرح"],[31,"إن الخليط الذي تهوى قد ائتمروا","https://www.aldiwan.net/poem42543.html","البسيط"],[105,"هتف الداعي فلبى واعتزم","https://www.aldiwan.net/poem41931.html","الرمل"],[105,"انبعث في الأرض يا وحي السماء","https://www.aldiwan.net/poem41932.html","الرمل"],[105,"سيري الهوينى دومة الجندل","https://www.aldiwan.net/poem44201.html","السريع"],[102,"هو ذا البحر مزبدا يتعالى","https://www.aldiwan.net/poem33132.html","الخفيف"],[52,"للمكتفي دولة مباركة","https://www.aldiwan.net/poem27188.html","المنسرح"],[48,"ما مثل هذا اليوم في طيبه","https://www.aldiwan.net/poem64375.html","الكامل"],[46,"إن يقرب الموت مني","https://www.aldiwan.net/poem22148.html","المجتث"],[46,"ما وفقوا حسبوني من خيارهم","https://www.aldiwan.net/poem22330.html","البسيط"],[46,"ماوية المرأة لا تصحب الما","https://www.aldiwan.net/poem22356.html","السريع"],[46,"ما وقع التقصير في لفظنا","https://www.aldiwan.net/poem23491.html","السريع"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39541","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16703","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1661","الكامل"],[106,"شبل بشبل","https://www.poetsgate.com/ViewPoem.aspx?id=179705",""],[106,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[106,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[106,"ناصر الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179359",""],[90,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""],[109,"كما كنت","https://www.poetsgate.com/ViewPoem.aspx?id=8398",""],[94,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[133,"حى المنازل حول نهى الضال","https://www.aldiwan.net/poem54763.html","الطويل"],[133,"هذه البئر قنة جار كما أن","https://www.aldiwan.net/poem54835.html","الخفيف"],[136,"شقوا القلوب وغادروا الأطواقا","https://www.aldiwan.net/poem49169.html","الكامل"],[148,"عج بي فديتك في أباطح دمر","https://www.aldiwan.net/poem47628.html","الكامل"],[156,"رحلوا فعاج على الربوع","https://www.aldiwan.net/poem55629.html","مجزوء الكامل"],[186,"لله يومي بالثغر في الجوسق","https://www.aldiwan.net/poem14609.html","المنسرح"],[190,"أموا المدينة حيث جل المغنم","https://www.aldiwan.net/poem35107.html","الكامل"],[196,"قمر السماء وشمسها اجتمعا","https://www.aldiwan.net/poem54378.html","أحذ الكامل"],[198,"حي الأساتذة الكرام تحية","https://www.aldiwan.net/poem39949.html","الكامل"],[211,"ماس من التيه في غلائل","https://www.aldiwan.net/poem13335.html","مخلع البسيط"],[224,"زارع الحقل في البكور","https://www.aldiwan.net/poem41457.html","مجزوء الخفيف"],[224,"سل البدر بالضياء الظلاما","https://www.aldiwan.net/poem41867.html","الخفيف"],[224,"لا يشقنا أرب","https://www.aldiwan.net/poem41901.html","المقتضب"],[230,"ظلموا البين والنوى والرقيبا","https://www.aldiwan.net/poem51215.html","الخفيف"],[232,"لمن المطايا في رباها تنفخ","https://www.aldiwan.net/poem44593.html","الكامل"],[238,"أين عهدكم المؤكد أينا","https://www.aldiwan.net/poem19098.html","الخفيف"],[276,"لبانة المستهام لبنى","https://www.aldiwan.net/poem25508.html","مخلع البسيط"],[281,"لئن عداني زمان عن لقائكم","https://www.aldiwan.net/poem60782.html","البسيط"],[283,"فاز قدحي وهو المعلى وقدحي","https://www.aldiwan.net/poem32824.html","الخفيف"],[329,"في طريق يحفه الزهر النضر","https://www.aldiwan.net/poem54972.html","الخفيف"],[343,"يوم الهوان وصيحة المرتاب","https://www.aldiwan.net/poem55365.html","الكامل"],[343,"دمعة حرى على وطن","https://www.aldiwan.net/poem55385.html","المديد"],[350,"لولا سنى ربة الخدر بدا","https://www.aldiwan.net/poem15643.html","الرجز"],[367,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[372,"لا رعى الله عزمة ضمنت لي","https://www.aldiwan.net/poem57051.html","الخفيف"],[381,"أخلق الدار بالعقيق الدثور","https://www.aldiwan.net/poem49208.html","الخفيف"],[404,"قد نظرنا الأبحاث في غاية السؤل","https://www.aldiwan.net/poem33947.html","الخفيف"],[410,"حمائم الأيك هيجتن أشجانا","https://www.aldiwan.net/poem31850.html","البسيط"],[410,"ما وجد من فارق أحبابه","https://www.aldiwan.net/poem32344.html","السريع"],[417,"باكر نداماك بكأس العقار","https://www.aldiwan.net/poem53938.html","السريع"],[417,"ما ودع الصب المشوق وما قلى","https://www.aldiwan.net/poem53997.html","الكامل"],[417,"نبهت الورقاء ذات الجناح","https://www.aldiwan.net/poem54157.html","الطويل"],[417,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[430,"للصيد أنشاها الشهابي","https://www.aldiwan.net/poem40728.html","مجزوء الكامل"],[433,"أنجد الصب وغاروا","https://www.aldiwan.net/poem12645.html","مجزوء الرمل"],[459,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[459,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[465,"هاتيك دراهم وتلك الأربع","https://www.aldiwan.net/poem3193.html","عموديه"],[465,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[465,"يا زمان الحمى عليك السلام","https://www.aldiwan.net/poem3413.html","عموديه"],[465,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[467,"ما وجد علوي الهوى جن واجتوى","https://www.aldiwan.net/poem50418.html","الطويل"],[469,"صاح عبد الكريم بحر فرده","https://www.aldiwan.net/poem60310.html","الخفيف"],[469,"قالوا التحي فاسل عنه","https://www.aldiwan.net/poem60344.html","المجتث"],[478,"عهد الصبا ومعاهد الأحباب","https://www.aldiwan.net/poem15221.html","الكامل"],[478,"ربع وقفت عليه بعد أهليه","https://www.aldiwan.net/poem15251.html","البسيط"],[478,"ما لحبل الوصل قد أمسى رماما","https://www.aldiwan.net/poem15278.html","الرمل"],[501,"دع وهم أهل الوحدة المطلقه","https://www.aldiwan.net/poem37935.html","السريع"],[501,"لله موقفنا بأم عبيدة","https://www.aldiwan.net/poem38028.html","الكامل"],[515,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[541,"أرسم سودة محل دارس الطلل","https://www.aldiwan.net/poem56707.html","البسيط"],[552,"أرسلها ترعى ألاء ونفل","https://www.aldiwan.net/poem47254.html","الرجز"],[552,"لا تسأل المرء ما تجني عشيرته","https://www.aldiwan.net/poem47764.html","البسيط"],[552,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[559,"واحد وهو في الظهور ثلاثه","https://www.aldiwan.net/poem33515.html","الخفيف"],[563,"بين قلب المحب والأحداق","https://www.aldiwan.net/poem52949.html","الخفيف"],[568,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"]],"verses":[["ما وَتَرَ الدَهرُ لِمَّتي وَيَدي","تَأخُذُ قَبلَ المَشيبِ بِالقَودِ",0,"د",1,0],["مَا وَشَى الصُّبْحُ الدَّيَاجِي","فِي سَوَادٍ بِبَيَاضِ",1,"ض",1,0],["ما وَلَدَت أُمّي مِنَ القَومِ عاجِزاً","وَلا كانَ ريشي مِن ذُنابي وَلا لَغبِ",2,"ب",1,1],["ما واقَعَ الرُّومَ إلاّ فَرَّ قارِحُها","ولا رَمَى الفُرسَ إلاّ طاشَ راميها",3,"ي",3,0],["مَأوى الضَريكِ وَمَأوى كُلِّ أَرمَلَةٍ","عِندَ المُحولِ إِذا ما هَبَّتِ القُرَرُ",4,"ر",1,0],["مَأوى الأَرامِلِ وَالأَيتامِ إِن سَغِبوا","شَهّادُ أَنجِيَةٍ مِطعامُ ضيفانِ",5,"ن",1,0],["ما ورى فيه وريه","قبله كلّ من شعر",6,"ر",1,0],["ما وَلَدَتكُم قُرومٌ مِن بَني أَسَدِ","وَلا هُصَيصٌ وَلا تَيمٌ وَلا عُمَرُ",7,"ر",1,1],["مَأوى الضَريكِ إِذا الرِياحُ تَناوَحَت","ضَخمُ الدَسيعَةِ مِحلَبٍ مِتلافِ",8,"ف",1,0],["ما وجدتُ امْرَأً يرى أنه يو","قِن إلّا وفيه شَوْبُ امْتِراءِ",9,"ا",2,0],["مَأْوىً لجارٍ غيرِ مُسْتَهْلَكٍ","مَثْوَىً لِضَيْفٍ غيرِ مَنْبُوحِ",10,"ح",1,0],["ما ودَّ ذا ذو مِرّةٍ ولو أنه","نالت يداه عطارداً والمشتري",11,"ر",2,0],["ما وقعت كفه وقد جعلت","من شدة الكرب تطلب العُلقا",12,"ق",2,0],["ما وطئتْ رجلُ امرئٍ حيث سلكْ","إلا وهُنَّ العُدَواء والببكْ",13,"ك",1,0],["ما وجدناهُ للرَّغائبِ مُحتا","لا وإن كان للعُلا محتالا",14,"ل",2,0],["ما وجَّه التأميلَ نحوك آملٌ","إلا الْتَقى التأميلُ والتمويلُ",15,"ل",1,0],["ما وَعَظَ الإِنسانَ مِثلُ الحِمام","فَليَتَّعِظ بِالصَمتِ أَهلُ الكَلام",16,"م",1,1],["ما وراء الشكوك إلا يقين","قد توارى كالبدر خلف الغمام",17,"م",1,0],["ما وصل من تهوى على أنسةٍ","بالبدر في ظل الربيع الظليل",18,"ل",1,1],["مأوى الشياطين ومن فوقه","غرفة اخيار وابرارِ",19,"ر",1,0],["ما وَفى البُعدُ بِالدُنُوِّ وَلا كا","نَ قَضاءً مِنَ الوِصالِ الصُدودُ",20,"د",1,0],["ما وقوف المحب منك","على منزل عفا",21,"ف",2,0],["ما وَدَّعَ اللَّهوَ لمَّا بانَ مُنصَرِما","حتى تَلفَّتَ في أعقابِه نَدَما",22,"م",2,1],["ما وَدَّني أَحَدٌ إِلّا بَذَلتُ لَهُ","صَفوَ المَوَدَّةِ مِنّي آخِرَ الأَبَدِ",23,"د",1,1],["ما وَعَظَ العاقِلَ مِن واعِظٍ","أَبلَغُ في العاقِلِ مِن نَفسِهِ",24,"س",2,1],["ما وحدَهُ أسروهُ إذْ أسروه بل","أسروا الصليبَ بأسرِهِ في أسرِهِ",25,"ه",1,0],["ما وَدَّعونا كَما زَعَمتَ وَلا","مِن بَعدِ أَن فارَقوا لَنا طَمَعُ",26,"ع",1,0],["ما وافَقَ النَفسَ مِن شَيءٍ تُسَرُّ بِهِ","وَأَعجَبَ العَينَ إِلّا فَوقَهُ عُمَرُ",27,"ر",1,0],["ما وجودُ الشّعبِ مغلوباً على","أمرِه إلا شَبيهٌ بالعَدمْ",28,"م",1,0],["ما وَعَى للمؤمنين الحُكماءْ","وَكَّلَ اللهُ به مِن أَهْلِهِ",29,"ه",1,0],["ما وَعَى الذّكرُ من الآي الوِضاءْ","يا رِجَالَ اللهِ زِيدُوا اللَه نَصْرا",29,"ر",2,0],["ما وقعةُ اللصِ بمأمونةٍ","ولا أذاةُ الضَّرِعِ الذُّمَّلِ",30,"ل",1,0],["ما وَنَت عَن جهادها الدَهر لَكن","لطف الصُبح كرّها وَالنِضالا",31,"ل",2,0],["ما وَلَدَت هاشِمٌ لَهُ شَبَهاً","مِن أَينَ مِن أَينَ مِثلُهُ هاتوا",32,"ت",3,0],["ما وَجَدَ الناسُ وَلا جَرَّبوا","لِلهَمِّ شَيئاً مِثلَها مَدفَعا",33,"ع",2,0],["ما وَمضَةٌ مِن عَقيقٍ","إِلّا تَهَيِّجُ طَربَه",34,"ب",2,0],["ما وُفِّقوا حَسِبوني مِن خِيارِهُمُ","فَخَلِّهِم لا يُرَجّى مِنهُمُ الرَشَدُ",35,"د",1,1],["ماوِيَّةُ المَرأَةِ لا تَصحَبُ الما","وِيَّةَ المَرأَةَ مِن عُجبِها",36,"ب",3,1],["ما وَقَعَ التَقصيرُ في لَفظِنا","لَو صَدَقَت أَفعالُنا الأَلسِنَه",37,"ن",2,1],["مَأوى المَمالِكِ وَالشُعوبِ وَمالَهُم","وَصَفوَكَ ظُلماً بِالغَريبِ المُعدِمِ",38,"م",1,0],["ما وراءَ السّهادِ في ليلك الدَّا","جي وهلَّا فرغتَ من أحزانِكْ",39,"ك",1,0],["ماوِيّةٌ تَهْوي هُوِيّ الماءِ من","دَهْماءَ تُهْدي عَذْبَهُ لبِقاعها",40,"ع",3,0],["ما وسع العلم والاختراعا","أرحب منها في اللّغى ذراعا",41,"ع",2,0],["مَأوى الجِياعِ إِذا السُنونَ تَتابَعَت","وَفَتى الطِعانِ عَشِيَّةَ العِصوادِ",42,"د",1,0],["ما ونى بعدَ ذاك بل كان شيخًا","عزمهِّ مثلُ رأسه في اشتعال",43,"ل",1,0],["ماؤُك سِرُّ النَّسْل والإخْصَاب","وواضعُ البذور في الأَصْلاب",44,"ب",1,0],["ماؤك العَذْبُ كان في الصخر أمضى","من شِفَار الفئوس في اللَّبنات",45,"ت",1,0],["ما وَحَّد العُرْبَ كالفصحى، فإن وَهَنَتْ","فَبَشِّر القومَ بالخذلان والفشل",46,"ل",1,0],["ما وحدَهُ غرَّدَ الشادي لِيرْقِصَهُ","الماءُ والشجرُ المهتزُّ غِرِّيد",47,"د",1,0],["ماوقفّة دنيا بكبرها .. على ..... بنت","اللي يوقّفها؟؟؟ الرفيق وضياعه",48,"ع",2,0],["ما وفيناك بعض حقّك فاعذر","إنّ عذر الكريم أسمى وأجدى",49,"د",2,0],["مَأوى الأَرَامِلِ واليَتَامَى قَلَّدَت","كُلَّ الوَرَى بِالنَّالِ دُونَ سُؤَالِ",50,"ل",1,0],["ماؤُهَا للأَنَامِ جَارٍ كَمَا أن","نَ نَدَى أهلِهَا عَلَى الجَارِ جَارِ",51,"ر",1,0],["ما وفق الله امرءاً في أمة","إلا وكان لنفعها مُنساقا",52,"ق",2,0],["مأوى تفرّد بالمحاسن كيف لا","وبه انجلى سر الولي الأكبر",53,"ر",1,0],["ما وَدَّعوا بَلْ أَوْدَعُو","هُ تَحَرُّقاً بَيْنَ الضُّلوعِ",54,"ع",1,0],["مأوىً لما دَبَّ من مَصائبها","وغاص تحت البحار أو حَلَّق",55,"ق",1,0],["مأوَى الرَّزايا من حينِ يَنْبِذه ال","ظهرُ إلى حيث لَحْدُه الموبِق",55,"ق",1,0],["مَأوى الرِسالةِ والبسالةِ والندى","مَأوى أجلّ الرسل طرّاً أحمدا",56,"د",2,0],["ما وارَت الأَستارُ مِثلَهُما","مَن ذا رَأى هَذا وَمَن سَمِعا",57,"ع",2,0],["ما وَعدُ بلفورٍ سوى أُمنيةٍ","ونداؤُهُ ضربٌ منَ الهذَيانِ",58,"ن",1,0],["ما ولد الجود غيث فضل","وباب ضرع النوال حافل",59,"ل",1,0],["ماؤُكَ الطاهِرُ الزَلال","مِن سَواقيكَ يَقطُرُ",60,"ر",1,0],["ما وَراءَ الأَدغالِ مرَّ خيال","حَمَّلَ القَلبَ أَدمُعاً وَكَلاما",61,"م",2,0],["ماؤُها يُمازِجُه","في مُروجِها الضَربُ",62,"ب",1,0],["ما وشَى به سوى الدموعِ ولا أض","حى سوى مهجتي عليه رقيبا",63,"ب",2,0],["مأواه جنات القلوب فلا أبٌ","يحتل موضعه العزيز ولا أخ",64,"خ",1,0],["مَا وَفَيْتُمْ حَتَّى نَقَضْتُمْ لَدَيْهِمْ","كُلَّمَا كُنْتُمُ غَزَلْتُمْ لَدَيْنَا",65,"ن",2,0],["مَا وَجَدَتْ مِنْ ظُباه كَهْفاً","يَقِي ولا مِن قَنَاهُ حَصْنا",66,"ن",2,0],["ما وَجْدُ مَنْ فارَقَ الْقَوْمَ الأُلى ظَعَنُوا","كَوَجْدِ مَنْ فَارَقَ الْعَليْاءَ وَالشَّرَفا",67,"ف",2,0],["ما وَقاهُ الإِلَهُ شحّاً بِوَصلٍ","وَهوَ مَع ذاكَ مُفلِحٌ بِالشُحِّ",68,"ح",1,0],["ما وراء الحياة ما غاية الده","ر وما كان قبل بدءِ الروايه",69,"ه",1,0],["ما وراءك من صحائف حلكة","تطوي الليالي في الغد الصخاب",70,"ب",1,0],["ماؤه عذب واربعه","غضة بالمنظر الحسن",71,"ن",1,0],["ما وَرَدَ الصادي زُلالَ مَورِدي","مِن عَينَيهِ إِلّا اِنتَفى عَنهُ الصَدى",72,"د",2,0],["ما وَجهُ مَن دِنتَ لَهُ قِبلَةٌ","قُلتُ وَلا قَولُكَ قَرآنُ",73,"ن",1,0],["ما وَفَت غيرَ لَيلةٍ ثمَّ صارَت","مثلَ قَلبي تقولُ لابدَّ مِنهُ",74,"ه",1,0],["ما وَفوا بِالعُهود صَحبي وَمثلي","لَكِ يا دار بِالوَفاءِ جَديرُ",75,"ر",1,0],["ما وَفى لي بَعد المَدامع إِلّا","ساجِعاتٌ وَرقٌ لَهُنَّ هَديرُ",75,"ر",1,0],["ما وراه التلويح نصاً عن الجم","هور فيه وصاحب التجريد",76,"د",1,0],["ما وجدُ صادحَةٍ في كلّ شارقَةٍ","تُرجِّعُ النَّوحَ في الأفنان أَلحانا",77,"ن",2,0],["ما وَجْدُ مَن فارَق أحبَابَه","كَوجْد من فارَق رَوْحَ الحيَاهْ",78,"ا",2,1],["ما وعد الله بها المتَّقي","في جنَّة الخلد ودار القرار",79,"ر",1,0],["ما ودَّع الصبُّ المشوقُ وما قلى","رشأً أغنَّ من السوانح أكحلا",80,"ل",2,1],["ما وجد الرَّاحة إلاَّ امرؤٌ","أعرض عن عاذله واستراح",81,"ح",1,0],["مأوى أولي الفضل وشمس عزهم","والملتجى والمقتفى والمنتدى",82,"ا",1,0],["مأوى المسرةِ والصفا","أرخ ردوها خير دار",83,"ر",1,0],["ماؤها عذْبٌ وفي ال","عذبِ لجينٌ ونُضارُ",84,"ر",1,0],["ماؤها بَسْلٌ على أظمائِها","أو تَرَى بالنَّعف هاتيك الخياما",85,"م",2,0],["ما وَسَمتْ عِرضاً على أنه","حلٍ وإلا جَمَّلَتْه الوُسُومْ",86,"م",1,0],["ما ودّعوا بل أودعوكَ صبابةً","أودى بقلبكَ مودعٌ ومودّع",87,"ع",1,0],["ما وشى الوشي بالحيا حين والى","بيد أن النمام خاف فنما",88,"م",2,0],["ما وصال الحبيب إلاَّ حياةٌ","وفراقُ الوزير إلاَّ حمامُ",89,"م",1,0],["ما وجدنا اللّحاظ إلاّ سيوفاً","أرهفتْ والجفونَ إلاّ سهاما",90,"م",2,0],["ما وَجدُ عُلوِيُّ الهَوى جَنَّ وَاِجتَوى","بِوادي الشَرى وَالغورِ ماءً وَمَرتَعا",91,"ع",2,1],["ما ؤُهُ لِلصَديقِ عَذبٌ فُراتٌ","وَلِغَيرِ الصَديقِ مِلحٌ أُجاجُ",92,"ج",1,0],["ما واجِبُ الرَوضِ يُخفى","عِندَ اِنفِتاحِ نَباتِه",93,"ه",1,0],["مأوى الرعابيبِ الملاحِ وملعبَ","الغيدِ الحسانِ ومجمعَ الأترابِ",94,"ب",1,0],["مأوى الحسانِ غدا عَنْ وصلهنَّ كما","قد كانَ بينٌ أظلَّتنا عواديهِ",95,"ي",2,0],["ما وجدنا لليالي حاجرٍ","ولأيامِ الحمى في الدهرِ ذاما",96,"م",2,0],["ما وحَّدَ اللهَ تَعالى امرؤٌ","مُعْتَقِدٌ بالوَحدَةِ المُطلَقَهْ",97,"ق",2,0],["مأوى العُفاةِ ومهبَطُ النَّفَحاتِ بل","حَرَمُ الهُداةِ وكعبَةُ المُسْتَرْشِدِ",98,"د",1,0],["ماؤها شهدٌ هَواها قرقَفٌ","طينُها العنبرُ والمِسْكُ ثَراها",99,"ا",3,0],["ما وَصلُ سَودَةَ إِلّا وَصلُ صارِمَةٍ","أَحَلَّها الدَهرُ داراً مأكلَ الوَعَلِ",100,"ل",1,0],["ما وُلدوا إلّا وفي أيديهمُ","أزمّةُ الدَّوْلاتِ مِن عَقْدٍ وَحلْ",101,"ل",1,0],["ما ودّني لاِنتِفاعٍ بي ولا عَلِقَتْ","بنانُهُ بإزاري خوفَ أحذاري",102,"ر",2,0],["ما وِرْدُنا في الدّهرِ إلّا رَنقُهُ","وَلَنا الإضاعةُ فيه والإمراجُ",103,"ج",1,0],["ماؤه والدقيق منا عجين","واحد وهي خلطة وعلاثه",104,"ث",2,0],["ما وَثِقنا بِسحرِ بابلَ حتى","فَتَنَتْنا بسِحرها المِصْداقِ",105,"ق",1,0],["ما وَفَى لي بِوَعْدِهِ الدّهْرُ إلاَّ","لِيَفي عِنْدَ وَعْدِهِ بالوَعِيْدِ",106,"د",1,0]]}