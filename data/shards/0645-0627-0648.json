{"poems":[[53,"خير الهوى ما نجا من الكمد","https://www.aldiwan.net/poem30628.html","المنسرح"],[77,"أأزاهير رياض","https://www.aldiwan.net/poem36001.html","مجزوء الرمل"],[42,"ما ولدت أمي من القوم عاجزا","https://www.aldiwan.net/poem50408.html","الطويل"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[10,"أنى تأوبني الأحزان والسهر","https://www.aldiwan.net/poem21087.html","البسيط"],[10,"يا لهف نفسي على صخر وقد فزعت","https://www.aldiwan.net/poem21139.html","البسيط"],[88,"حي هل يا أخا مصر","https://www.aldiwan.net/poem44435.html","مجزوء الخفيف"],[23,"ما ولدتكم قروم من بني أسد","https://www.aldiwan.net/poem21312.html","البسيط"],[23,"ولأصدقن إلى حذيفة مدحتي","https://www.aldiwan.net/poem21598.html","الكامل"],[51,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[51,"أبشر بفتح لك مفتوح","https://www.aldiwan.net/poem9415.html","السريع"],[51,"أتود أنك تجتني ثمر العلا","https://www.aldiwan.net/poem64100.html","الكامل"],[51,"بكعبة الله بل بخالقها","https://www.aldiwan.net/poem65716.html","المنسرح"],[51,"إني إذا ما الخصم في الغي ابترك","https://www.aldiwan.net/poem65823.html","الرجز"],[51,"قل لمن ألبس الجمال جمالا","https://www.aldiwan.net/poem65878.html","الخفيف"],[51,"لا زلت تفخم والثناء ضئيل","https://www.aldiwan.net/poem65988.html","الكامل"],[91,"ما وعظ الإنسان مثل الحمام","https://www.aldiwan.net/poem62748.html","عموديه"],[89,"إن فعل الرجال غير الكلام","https://www.aldiwan.net/poem44616.html","الخفيف"],[85,"ما وصل من تهوى على أنسة","https://www.aldiwan.net/poem7121.html","السريع"],[62,"قد خرج التنين من بحرنا","https://www.aldiwan.net/poem52176.html","السريع"],[45,"نفست قربها علينا كنود","https://www.aldiwan.net/poem62739.html","الخفيف"],[61,"طلب الدهر ثأره","https://www.aldiwan.net/poem51353.html","مجزوء الخفيف"],[61,"ما ودع اللهو لما بان منصرما","https://www.aldiwan.net/poem51437.html","البسيط"],[58,"ما ودني أحد إلا بذلت له","https://www.aldiwan.net/poem31085.html","البسيط"],[49,"ما وعظ العاقل من واعظ","https://www.aldiwan.net/poem62132.html","السريع"],[69,"لهجوا سنين بجوسلين فإنه","https://www.aldiwan.net/poem28047.html","الكامل"],[31,"قرب جيراننا جمالهم","https://www.aldiwan.net/poem42239.html","المنسرح"],[31,"إن الخليط الذي تهوى قد ائتمروا","https://www.aldiwan.net/poem42543.html","البسيط"],[105,"هتف الداعي فلبى واعتزم","https://www.aldiwan.net/poem41931.html","الرمل"],[105,"انبعث في الأرض يا وحي السماء","https://www.aldiwan.net/poem41932.html","الرمل"],[105,"سيري الهوينى دومة الجندل","https://www.aldiwan.net/poem44201.html","السريع"],[102,"هو ذا البحر مزبدا يتعالى","https://www.aldiwan.net/poem33132.html","الخفيف"],[52,"للمكتفي دولة مباركة","https://www.aldiwan.net/poem27188.html","المنسرح"],[48,"ما مثل هذا اليوم في طيبه","https://www.aldiwan.net/poem64375.html","الكامل"],[46,"إن يقرب الموت مني","https://www.aldiwan.net/poem22148.html","المجتث"],[46,"ما وفقوا حسبوني من خيارهم","https://www.aldiwan.net/poem22330.html","البسيط"],[46,"ماوية المرأة لا تصحب الما","https://www.aldiwan.net/poem22356.html","السريع"],[46,"ما وقع التقصير في لفظنا","https://www.aldiwan.net/poem23491.html","السريع"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39541","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16703","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1661","الكامل"],[106,"شبل بشبل","https://www.poetsgate.com/ViewPoem.aspx?id=179705",""],[106,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[106,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[106,"ناصر الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179359",""],[90,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""]],"verses":[["ما وَتَرَ الدَهرُ لِمَّتي وَيَدي","تَأخُذُ قَبلَ المَشيبِ بِالقَودِ",0,"د",1,0],["مَا وَشَى الصُّبْحُ الدَّيَاجِي","فِي سَوَادٍ بِبَيَاضِ",1,"ض",1,0],["ما وَلَدَت أُمّي مِنَ القَومِ عاجِزاً","وَلا كانَ ريشي مِن ذُنابي وَلا لَغبِ",2,"ب",1,1],["ما واقَعَ الرُّومَ إلاّ فَرَّ قارِحُها","ولا رَمَى الفُرسَ إلاّ طاشَ راميها",3,"ي",3,0],["مَأوى الضَريكِ وَمَأوى كُلِّ أَرمَلَةٍ","عِندَ المُحولِ إِذا ما هَبَّتِ القُرَرُ",4,"ر",1,0],["مَأوى الأَرامِلِ وَالأَيتامِ إِن سَغِبوا","شَهّادُ أَنجِيَةٍ مِطعامُ ضيفانِ",5,"ن",1,0],["ما ورى فيه وريه","قبله كلّ من شعر",6,"ر",1,0],["ما وَلَدَتكُم قُرومٌ مِن بَني أَسَدِ","وَلا هُصَيصٌ وَلا تَيمٌ وَلا عُمَرُ",7,"ر",1,1],["مَأوى الضَريكِ إِذا الرِياحُ تَناوَحَت","ضَخمُ الدَسيعَةِ مِحلَبٍ مِتلافِ",8,"ف",1,0],["ما وجدتُ امْرَأً يرى أنه يو","قِن إلّا وفيه شَوْبُ امْتِراءِ",9,"ا",2,0],["مَأْوىً لجارٍ غيرِ مُسْتَهْلَكٍ","مَثْوَىً لِضَيْفٍ غيرِ مَنْبُوحِ",10,"ح",1,0],["ما ودَّ ذا ذو مِرّةٍ ولو أنه","نالت يداه عطارداً والمشتري",11,"ر",2,0],["ما وقعت كفه وقد جعلت","من شدة الكرب تطلب العُلقا",12,"ق",2,0],["ما وطئتْ رجلُ امرئٍ حيث سلكْ","إلا وهُنَّ العُدَواء والببكْ",13,"ك",1,0],["ما وجدناهُ للرَّغائبِ مُحتا","لا وإن كان للعُلا محتالا",14,"ل",2,0],["ما وجَّه التأميلَ نحوك آملٌ","إلا الْتَقى التأميلُ والتمويلُ",15,"ل",1,0],["ما وَعَظَ الإِنسانَ مِثلُ الحِمام","فَليَتَّعِظ بِالصَمتِ أَهلُ الكَلام",16,"م",1,1],["ما وراء الشكوك إلا يقين","قد توارى كالبدر خلف الغمام",17,"م",1,0],["ما وصل من تهوى على أنسةٍ","بالبدر في ظل الربيع الظليل",18,"ل",1,1],["مأوى الشياطين ومن فوقه","غرفة اخيار وابرارِ",19,"ر",1,0],["ما وَفى البُعدُ بِالدُنُوِّ وَلا كا","نَ قَضاءً مِنَ الوِصالِ الصُدودُ",20,"د",1,0],["ما وقوف المحب منك","على منزل عفا",21,"ف",2,0],["ما وَدَّعَ اللَّهوَ لمَّا بانَ مُنصَرِما","حتى تَلفَّتَ في أعقابِه نَدَما",22,"م",2,1],["ما وَدَّني أَحَدٌ إِلّا بَذَلتُ لَهُ","صَفوَ المَوَدَّةِ مِنّي آخِرَ الأَبَدِ",23,"د",1,1],["ما وَعَظَ العاقِلَ مِن واعِظٍ","أَبلَغُ في العاقِلِ مِن نَفسِهِ",24,"س",2,1],["ما وحدَهُ أسروهُ إذْ أسروه بل","أسروا الصليبَ بأسرِهِ في أسرِهِ",25,"ه",1,0],["ما وَدَّعونا كَما زَعَمتَ وَلا","مِن بَعدِ أَن فارَقوا لَنا طَمَعُ",26,"ع",1,0],["ما وافَقَ النَفسَ مِن شَيءٍ تُسَرُّ بِهِ","وَأَعجَبَ العَينَ إِلّا فَوقَهُ عُمَرُ",27,"ر",1,0],["ما وجودُ الشّعبِ مغلوباً على","أمرِه إلا شَبيهٌ بالعَدمْ",28,"م",1,0],["ما وَعَى للمؤمنين الحُكماءْ","وَكَّلَ اللهُ به مِن أَهْلِهِ",29,"ه",1,0],["ما وَعَى الذّكرُ من الآي الوِضاءْ","يا رِجَالَ اللهِ زِيدُوا اللَه نَصْرا",29,"ر",2,0],["ما وقعةُ اللصِ بمأمونةٍ","ولا أذاةُ الضَّرِعِ الذُّمَّلِ",30,"ل",1,0],["ما وَنَت عَن جهادها الدَهر لَكن","لطف الصُبح كرّها وَالنِضالا",31,"ل",2,0],["ما وَلَدَت هاشِمٌ لَهُ شَبَهاً","مِن أَينَ مِن أَينَ مِثلُهُ هاتوا",32,"ت",3,0],["ما وَجَدَ الناسُ وَلا جَرَّبوا","لِلهَمِّ شَيئاً مِثلَها مَدفَعا",33,"ع",2,0],["ما وَمضَةٌ مِن عَقيقٍ","إِلّا تَهَيِّجُ طَربَه",34,"ب",2,0],["ما وُفِّقوا حَسِبوني مِن خِيارِهُمُ","فَخَلِّهِم لا يُرَجّى مِنهُمُ الرَشَدُ",35,"د",1,1],["ماوِيَّةُ المَرأَةِ لا تَصحَبُ الما","وِيَّةَ المَرأَةَ مِن عُجبِها",36,"ب",3,1],["ما وَقَعَ التَقصيرُ في لَفظِنا","لَو صَدَقَت أَفعالُنا الأَلسِنَه",37,"ن",2,1],["مَأوى المَمالِكِ وَالشُعوبِ وَمالَهُم","وَصَفوَكَ ظُلماً بِالغَريبِ المُعدِمِ",38,"م",1,0],["ما وراءَ السّهادِ في ليلك الدَّا","جي وهلَّا فرغتَ من أحزانِكْ",39,"ك",1,0],["ماوِيّةٌ تَهْوي هُوِيّ الماءِ من","دَهْماءَ تُهْدي عَذْبَهُ لبِقاعها",40,"ع",3,0],["ما وسع العلم والاختراعا","أرحب منها في اللّغى ذراعا",41,"ع",2,0],["مَأوى الجِياعِ إِذا السُنونَ تَتابَعَت","وَفَتى الطِعانِ عَشِيَّةَ العِصوادِ",42,"د",1,0],["ما ونى بعدَ ذاك بل كان شيخًا","عزمهِّ مثلُ رأسه في اشتعال",43,"ل",1,0],["ماؤُك سِرُّ النَّسْل والإخْصَاب","وواضعُ البذور في الأَصْلاب",44,"ب",1,0],["ماؤك العَذْبُ كان في الصخر أمضى","من شِفَار الفئوس في اللَّبنات",45,"ت",1,0],["ما وَحَّد العُرْبَ كالفصحى، فإن وَهَنَتْ","فَبَشِّر القومَ بالخذلان والفشل",46,"ل",1,0],["ما وحدَهُ غرَّدَ الشادي لِيرْقِصَهُ","الماءُ والشجرُ المهتزُّ غِرِّيد",47,"د",1,0]]}