,"https://www.poetsgate.com/ViewPoem.aspx?id=181734",""],[6229,"ذلك الصوت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65179&r=&rc=2",""],[406,"نحن أدرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=850&r=&rc=41",""],[463,"في كلّ دارٍ عدوٌ لي أقاذعهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60140&r=&rc=196",""],[572,"عَجِبَتْ من قَنَاعَتي وقُعُودي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9230&r=&rc=87",""]],"verses":[["ما وَتَرَ الدَهرُ لِمَّتي وَيَدي","تَأخُذُ قَبلَ المَشيبِ بِالقَودِ",0,"د",1,0],["مَا وَشَى الصُّبْحُ الدَّيَاجِي","فِي سَوَادٍ بِبَيَاضِ",1,"ض",1,0],["ما وَلَدَت أُمّي مِنَ القَومِ عاجِزاً","وَلا كانَ ريشي مِن ذُنابي وَلا لَغبِ",2,"ب",1,1],["ما واقَعَ الرُّومَ إلاّ فَرَّ قارِحُها","ولا رَمَى الفُرسَ إلاّ طاشَ راميها",3,"ي",3,0],["مَأوى الضَريكِ وَمَأوى كُلِّ أَرمَلَةٍ","عِندَ المُحولِ إِذا ما هَبَّتِ القُرَرُ",4,"ر",1,0],["مَأوى الأَرامِلِ وَالأَيتامِ إِن سَغِبوا","شَهّادُ أَنجِيَةٍ مِطعامُ ضيفانِ",5,"ن",1,0],["ما ورى فيه وريه","قبله كلّ من شعر",6,"ر",1,0],["ما وَلَدَتكُم قُرومٌ مِن بَني أَسَدِ","وَلا هُصَيصٌ وَلا تَيمٌ وَلا عُمَرُ",7,"ر",1,1],["مَأوى الضَريكِ إِذا الرِياحُ تَناوَحَت","ضَخمُ الدَسيعَةِ مِحلَبٍ مِتلافِ",8,"ف",1,0],["ما وجدتُ امْرَأً يرى أنه يو","قِن إلّا وفيه شَوْبُ امْتِراءِ",9,"ا",2,0],["مَأْوىً لجارٍ غيرِ مُسْتَهْلَكٍ","مَثْوَىً لِضَيْفٍ غيرِ مَنْبُوحِ",10,"ح",1,0],["ما ودَّ ذا ذو مِرّةٍ ولو أنه","نالت يداه عطارداً والمشتري",11,"ر",2,0],["ما وقعت كفه وقد جعلت","من شدة الكرب تطلب العُلقا",12,"ق",2,0],["ما وطئتْ رجلُ امرئٍ حيث سلكْ","إلا وهُنَّ العُدَواء والببكْ",13,"ك",1,0],["ما وجدناهُ للرَّغائبِ مُحتا","لا وإن كان للعُلا محتالا",14,"ل",2,0],["ما وجَّه التأميلَ نحوك آملٌ","إلا الْتَقى التأميلُ والتمويلُ",15,"ل",1,0],["ما وَعَظَ الإِنسانَ مِثلُ الحِمام","فَليَتَّعِظ بِالصَمتِ أَهلُ الكَلام",16,"م",1,1],["ما وراء الشكوك إلا يقين","قد توارى كالبدر خلف الغمام",17,"م",1,0],["ما وصل من تهوى على أنسةٍ","بالبدر في ظل الربيع الظليل",18,"ل",1,1],["مأوى الشياطين ومن فوقه","غرفة اخيار وابرارِ",19,"ر",1,0],["ما وَفى البُعدُ بِالدُنُوِّ وَلا كا","نَ قَضاءً مِنَ الوِصالِ الصُدودُ",20,"د",1,0],["ما وقوف المحب منك","على منزل عفا",21,"ف",2,0],["ما وَدَّعَ اللَّهوَ لمَّا بانَ مُنصَرِما","حتى تَلفَّتَ في أعقابِه نَدَما",22,"م",2,1],["ما وَدَّني أَحَدٌ إِلّا بَذَلتُ لَهُ","صَفوَ المَوَدَّةِ مِنّي آخِرَ الأَبَدِ",23,"د",1,1],["ما وَعَظَ العاقِلَ مِن واعِظٍ","أَبلَغُ في العاقِلِ مِن نَفسِهِ",24,"س",2,1],["ما وحدَهُ أسروهُ إذْ أسروه بل","أسروا الصليبَ بأسرِهِ في أسرِهِ",25,"ه",1,0],["ما وَدَّعونا كَما زَعَمتَ وَلا","مِن بَعدِ أَن فارَقوا لَنا طَمَعُ",26,"ع",1,0],["ما وافَقَ النَفسَ مِن شَيءٍ تُسَرُّ بِهِ","وَأَعجَبَ العَينَ إِلّا فَوقَهُ عُمَرُ",27,"ر",1,0],["ما وجودُ الشّعبِ مغلوباً على","أمرِه إلا شَبيهٌ بالعَدمْ",28,"م",1,0],["ما وَعَى للمؤمنين الحُكماءْ","وَكَّلَ اللهُ به مِن أَهْلِهِ",29,"ه",1,0],["ما وَعَى الذّكرُ من الآي الوِضاءْ","يا رِجَالَ اللهِ زِيدُوا اللَه نَصْرا",29,"ر",2,0],["ما وقعةُ اللصِ بمأمونةٍ","ولا أذاةُ الضَّرِعِ الذُّمَّلِ",30,"ل",1,0],["ما وَنَت عَن جهادها الدَهر لَكن","لطف الصُبح كرّها وَالنِضالا",31,"ل",2,0],["ما وَلَدَت هاشِمٌ لَهُ شَبَهاً","مِن أَينَ مِن أَينَ مِثلُهُ هاتوا",32,"ت",3,0],["ما وَجَدَ الناسُ وَلا جَرَّبوا","لِلهَمِّ شَيئاً مِثلَها مَدفَعا",33,"ع",2,0],["ما وَمضَةٌ مِن عَقيقٍ","إِلّا تَهَيِّجُ طَربَه",34,"ب",2,0],["ما وُفِّقوا حَسِبوني مِن خِيارِهُمُ","فَخَلِّهِم لا يُرَجّى مِنهُمُ الرَشَدُ",35,"د",1,1],["ماوِيَّةُ المَرأَةِ لا تَصحَبُ الما","وِيَّةَ المَرأَةَ مِن عُجبِها",36,"ب",3,1],["ما وَقَعَ التَقصيرُ في لَفظِنا","لَو صَدَقَت أَفعالُنا الأَلسِنَه",37,"ن",2,1],["مَأوى المَمالِكِ وَالشُعوبِ وَمالَهُم","وَصَفوَكَ ظُلماً بِالغَريبِ المُعدِمِ",38,"م",1,0],["ما وراءَ السّهادِ في ليلك الدَّا","جي وهلَّا فرغتَ من أحزانِكْ",39,"ك",1,0],["ماوِيّةٌ تَهْوي هُوِيّ الماءِ من","دَهْماءَ تُهْدي عَذْبَهُ لبِقاعها",40,"ع",3,0],["ما وسع العلم والاختراعا","أرحب منها في اللّغى ذراعا",41,"ع",2,0],["مَأوى الجِياعِ إِذا السُنونَ تَتابَعَت","وَفَتى الطِعانِ عَشِيَّةَ العِصوادِ",42,"د",1,0],["ما ونى بعدَ ذاك بل كان شيخًا","عزمهِّ مثلُ رأسه في اشتعال",43,"ل",1,0],["ماؤُك سِرُّ النَّسْل والإخْصَاب","وواضعُ البذور في الأَصْلاب",44,"ب",1,0],["ماؤك العَذْبُ كان في الصخر أمضى","من شِفَار الفئوس في اللَّبنات",45,"ت",1,0],["ما وَحَّد العُرْبَ كالفصحى، فإن وَهَنَتْ","فَبَشِّر القومَ بالخذلان والفشل",46,"ل",1,0],["ما وحدَهُ غرَّدَ الشادي لِيرْقِصَهُ","الماءُ والشجرُ المهتزُّ غِرِّيد",47,"د",1,0],["ماوقفّة دنيا بكبرها .. على ..... بنت","اللي يوقّفها؟؟؟ الرفيق وضياعه",48,"ع",2,0],["ما وفيناك بعض حقّك فاعذر","إنّ عذر الكريم أسمى وأجدى",49,"د",2,0],["مَأوى الأَرَامِلِ واليَتَامَى قَلَّدَت","كُلَّ الوَرَى بِالنَّالِ دُونَ سُؤَالِ",50,"ل",1,0],["ماؤُهَا للأَنَامِ جَارٍ كَمَا أن","نَ نَدَى أهلِهَا عَلَى الجَارِ جَارِ",51,"ر",1,0],["ما وفق الله امرءاً في أمة","إلا وكان لنفعها مُنساقا",52,"ق",2,0],["مأوى تفرّد بالمحاسن كيف لا","وبه انجلى سر الولي الأكبر",53,"ر",1,0],["ما وَدَّعوا بَلْ أَوْدَعُو","هُ تَحَرُّقاً بَيْنَ الضُّلوعِ",54,"ع",1,0],["مأوىً لما دَبَّ من مَصائبها","وغاص تحت البحار أو حَلَّق",55,"ق",1,0],["مأوَى الرَّزايا من حينِ يَنْبِذه ال","ظهرُ إلى حيث لَحْدُه الموبِق",55,"ق",1,0],["مَأوى الرِسالةِ والبسالةِ والندى","مَأوى أجلّ الرسل طرّاً أحمدا",56,"د",2,0],["ما وارَت الأَستارُ مِثلَهُما","مَن ذا رَأى هَذا وَمَن سَمِعا",57,"ع",2,0],["ما وَعدُ بلفورٍ سوى أُمنيةٍ","ونداؤُهُ ضربٌ منَ الهذَيانِ",58,"ن",1,0],["ما ولد الجود غيث فضل","وباب ضرع النوال حافل",59,"ل",1,0],["ماؤُكَ الطاهِرُ الزَلال","مِن سَواقيكَ يَقطُرُ",60,"ر",1,0],["ما وَراءَ الأَدغالِ مرَّ خيال","حَمَّلَ القَلبَ أَدمُعاً وَكَلاما",61,"م",2,0],["ماؤُها يُمازِجُه","في مُروجِها الضَربُ",62,"ب",1,0],["ما وشَى به سوى الدموعِ ولا أض","حى سوى مهجتي عليه رقيبا",63,"ب",2,0],["مأواه جنات القلوب فلا أبٌ","يحتل موضعه العزيز ولا أخ",64,"خ",1,0],["مَا وَفَيْتُمْ حَتَّى نَقَضْتُمْ لَدَيْهِمْ","كُلَّمَا كُنْتُمُ غَزَلْتُمْ لَدَيْنَا",65,"ن",2,0],["مَا وَجَدَتْ مِنْ ظُباه كَهْفاً","يَقِي ولا مِن قَنَاهُ حَصْنا",66,"ن",2,0],["ما وَجْدُ مَنْ فارَقَ الْقَوْمَ الأُلى ظَعَنُوا","كَوَجْدِ مَنْ فَارَقَ الْعَليْاءَ وَالشَّرَفا",67,"ف",2,0],["ما وَقاهُ الإِلَهُ شحّاً بِوَصلٍ","وَهوَ مَع ذاكَ م