{"poems":[[57,"أتطمع يا عباس في غير مطمع","https://www.aldiwan.net/poem26259.html","الطويل"],[90,"نجيت بالسد بغدادا من الغرق","https://www.aldiwan.net/poem44443.html","البسيط"],[23,"إن شرخ الشباب والشعر الأس","https://www.aldiwan.net/poem21379.html","الخفيف"],[53,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[53,"لشاعرنا خالد في استه","https://www.aldiwan.net/poem65010.html","المتقارب"],[87,"لنا رقيب كان ما أثقله","https://www.aldiwan.net/poem7302.html","السريع"],[87,"الحرب لا بد منها","https://www.aldiwan.net/poem7753.html","المجتث"],[60,"عرفت ومن يعتدل يعرف","https://www.aldiwan.net/poem30961.html","المتقارب"],[99,"بأي لفظ يفيك شعري","https://www.aldiwan.net/poem24969.html","مجزوء البسيط"],[46,"قرى دارهم مني الدموع السوافك","https://www.aldiwan.net/poem30391.html","الطويل"],[76,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[42,"لقد أرسلت في السر ليلى تلومني","https://www.aldiwan.net/poem42302.html","الطويل"],[50,"أقلني قد ندمت على ذنوبي","https://www.aldiwan.net/poem62601.html","الوافر"],[92,"الوطن والشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179071",""],[136,"أدينك أن تذمى الخيزرانا","https://www.aldiwan.net/poem54721.html","الوافر"],[227,"قوت روحي هواك بل روح ذاتي","https://www.aldiwan.net/poem55470.html","الخفيف"],[234,"الآن قد الفؤاد نصفين","https://www.aldiwan.net/poem50780.html","المنسرح"],[234,"ومجلس قد حاز من حسنه","https://www.aldiwan.net/poem51176.html","السريع"],[264,"عن المرء لا تسأل وسل عن قرينه","https://www.aldiwan.net/poem35514.html","الطويل"],[275,"جبينك لاح فجرا في حماك","https://www.aldiwan.net/poem35421.html","الوافر"],[308,"يا ماجدا نجهد في وصفه","https://www.aldiwan.net/poem57733.html","السريع"],[382,"ألا إحذر ملاقاة الرزايا","https://www.aldiwan.net/poem59170.html","الوافر"],[391,"هل عند غان لفؤاد","https://www.aldiwan.net/poem1847.html","السريع"],[438,"وليلة أطلعت في جنحها","https://www.aldiwan.net/poem12571.html","السريع"],[463,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[463,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[470,"من لي ببغداد","https://www.aldiwan.net/poem36225.html","عموديه"],[484,"خذ من أبيك وصايا يا سمي أبي","https://www.aldiwan.net/poem36945.html","البسيط"],[556,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[556,"لي من رضابك ما يغني عن الراح","https://www.aldiwan.net/poem47891.html","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66816","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70677","المنسرح"],[1008,"","https://poetry.dctabudhabi.ae/diwan/poem/95765","البسيط"],[1114,"","https://poetry.dctabudhabi.ae/diwan/poem/124083","الطويل"],[1165,"","https://poetry.dctabudhabi.ae/diwan/poem/101339","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65084","المجتث"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65060","السريع"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112956","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128696","البسيط"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127962","الخفيف"],[1713,"","https://poetry.dctabudhabi.ae/diwan/poem/123322","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52077","الرمل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124725","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27224","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109371","البسيط"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121018","المجتث"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121031","الرجز"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121019","السريع"],[2352,"","https://poetry.dctabudhabi.ae/diwan/poem/140166",""],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129848","السريع"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93927","الخفيف"],[2848,"","https://poetry.dctabudhabi.ae/diwan/poem/199293","الوافر"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140047",""],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122470","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204652",""],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74171","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74196","السريع"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133955","الرجز"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/138013",""],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62828","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103964","السريع"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103622","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86291","الرمل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108029","البسيط"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199176","الرجز"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125946","المجتث"],[3672,"","https://poetry.dctabudhabi.ae/diwan/poem/144494","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216489",""],[3768,"","https://poetry.dctabudhabi.ae/diwan/poem/130447","السريع"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131243",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135691","الوافر"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143841","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119634","الخفيف"],[4296,"","https://poetry.dctabudhabi.ae/diwan/poem/103332","الهزج"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83509","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83354","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83663","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83556","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72347","البسيط"],[4927,"لَغْطُ النَّاْصِحِيْن","https://www.poetsgate.com/ViewPoem.aspx?id=29836",""],[4929,"كفانا هوانا","https://www.poetsgate.com/ViewPoem.aspx?id=208894",""],[5054,"‏ثورة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=213745",""],[585,"عليك وإلا ما عقدت رجاء","https://www.poetsgate.com/ViewPoem.aspx?id=161913",""],[5187,"عيد الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=33005",""],[5289,"مَوْسِمُ الْكَلامِ!","https://www.poetsgate.com/ViewPoem.aspx?id=126297",""],[5363,"بينونة كبرى","https://www.poetsgate.com/ViewPoem.aspx?id=144160",""],[5510,"بلسم الروح","https://www.poetsgate.com/ViewPoem.aspx?id=206163",""],[5717,"بحار دم أجرت عيون محبيه","https://www.poetsgate.com/ViewPoem.aspx?id=170591",""],[5794,"غرور الشعر ..","https://www.poetsgate.com/ViewPoem.aspx?id=122796",""],[5853,"رؤى الحب","https://www.poetsgate.com/ViewPoem.aspx?id=175649",""]],"verses":[["وَأَن تُصبِحي صُبحي وَأَن تَتَضَجَّعي","إِذا اللَيلُ أَلقى سِترَهُ كَتَضَجُّعي",0,"ع",2,0],["وإن تصاممت الأيام عن طلب","أسمعتهنّ بصوت منك صهصلق",1,"ق",1,0],["وَاِنتَصَينا نَواصِيَ اللَهوِ يَوماً","وَبَعَثنا جُناتَنا يَجتَنونا",2,"ن",2,0],["وأنت صاحٍ من الأسقام منتقِبٌ","دِيباجةً ذات إشراق وإسفار",3,"ر",1,0],["وأنت صبورٌ لعضَّ الهوانِ","كصبر البعير على الضاغط",4,"ط",1,0],["وإن تصف قنبلة لم ينم","من هول ذكرى حادث القنبله",5,"ل",2,0],["وإن تصالح قوم","تقاتلت أقوام",6,"م",1,0],["وَإِن تَصرَعوا تَحتَ أَسيافِنا","كَمصرَعِ كَعبٍ أَبي الأِشرَفِ",7,"ف",1,0],["وأنت صدر العباب رحباً","وبسمة الشط والمنار",8,"ر",1,0],["وَأَن تُصبِحوا تَحتَ الأَظَلِّ وَأَنتُمُ","غَوارِبُ حَيَّي تَغلِبٍ وَالحَوارِكُ",9,"ك",1,0],["وَاِنتَصَفنا مِن مَظالِمِنا","وَأَخَذنا أَخذَ مُحتَكِمِ",10,"م",1,0],["وَإِن تَصرِمِيني لا أَرَ الدَهرَ لَذَّةً","لِشَيءٍ وَلَن أَلقى سُروراً وَلا سَعدا",11,"د",2,0],["وَإِن تَصفَح فَإِحسانٌ جَديدٌ","سَبَقتَ بِهِ إِلى شُكرٍ جَديدِ",12,"د",1,0],["وأن تصفو مواردُهم فتحلوا","لهمْ وبنوكً لا يَجِدونَ زادا",13,"د",2,0],["وأن تَصِلِى الخِلَىَّ وأن تَبتِّى","شَجِيًّا لاَعجَ الأشجَانَ عَانَى",14,"ن",2,0],["وانتصب في الهوى لرفع الحميا","تر جز الأسى وخفض النهات",15,"ت",1,0],["وانتصَبتْ نِصفُ صادِ شاربه","وخطّ مِن عارِضَيهِ لامَيْن",16,"ن",1,0],["وانتصب الليمون من حوله","مثل انتصاب النَّهد للنَّهد",17,"د",1,0],["وإن تصطحب قوماً فصاحب خيارهم","لتصبح في ثوب الكمالات مرتدي",18,"د",2,0],["وأنتِ صبيَّةٌ وأنا صبيٌّ","فما أحنى صِبايَ على صِباك",19,"ك",1,0],["وإن تصحف بعضها فهي ما","زالت ترى في أذن شنفا",20,"ف",2,0],["وإن تُصلَب به طوعاً وحبّاً","بِمُورثه ترثْ إرث البقايا",21,"ا",3,0],["وَاِنتَصَبَ القَلبُ لِتَقسيمِهِ","أَمراً فَريقَينِ وَلَم يَبلُدِ",22,"د",1,0],["وانتصبَ الشمْعُ فكلّفتَهُ","أن يُطلعَ الأترُجّ فوقَ الذّهبْ",23,"ب",1,0],["وانتصفَ الفضلُ بهم مذ جُعلت","منه إلى حُكمهم المظالمُ",24,"م",1,0],["وإن تصارمنا فما بيننا","وشائجٌ ليس لهنّ انفصالْ",25,"ل",1,0],["وأنتِ صامِدَة ٌتَستَصرِخينَ لَهُم","مَوجَ الدِّماءِ على مَوج ِالثَّعابين ِ",26,"ن",1,0],["وان تصبيت فانظر للجمال وقل","سبحان واهبه سبحان مرتقبي",27,"ب",2,0],["وإنْ تُصَبْ بالرّدى فليس ترى","دمعاً لعينٍ عليك مُنسَجِما",28,"م",2,0],["وَأَنتَ صاحٍ وَلاحٍ مَنْ به سُكرٌ","وَما اِستَوى في الهَوى السّكرانُ والصَّاحِي",29,"ح",2,0],["وأنتَ صراطُه الهادي إليهِ","وغيرُك ما يُنجِّي الماسِكينا",30,"ن",2,0],["وإنْ تصنْ عِرضَك العزيزَ بما","لديكَ صُنْهُ بطاعة اللَّه",31,"ه",1,0],["وَإن تَصرَّم هذا اليوم بي فغداً","يَمشي الغلامُ ولا يمشي بيَ الفَرس",32,"س",1,0],["وإن تصابى الشيب فعل مقبح","به طبت نفسا لو تطيب به نفسا",33,"س",2,0],["وانت صنو مليك عز منصبه","وصين بالماضيين البيض والسمر",34,"ر",1,0],["وإِنْ تصادَفْتَ عنهمْ","فإِنَّ لِلهِ دَرَّكْ",35,"ك",1,0],["وإِنْ تُصَحِّفْهُ فتَصْحيفُهُ","مَدينةٌ مِنْ بَعْدِها لا تُرامْ",36,"م",1,0],["وأن تصحب ذا بدعه واجتنب من","الطغاة ولا تركن إلى صاحب السحر",37,"ر",1,0],["وإن تصدت لقتل العاشقين ففي","أجفانها مرهف الحدّين مصقول",38,"ل",1,0],["وانتصارى للحق فيك بعزم","واهتمام ويقظة وسداد",39,"د",1,0],["وأنت صلّى عليك اللّه تقدمهم","في بهو إشراق نور منك متكمِلأ",40,"ل",2,0],["وَانْتَصَى مِنْ عَزمِهِ مَا يُنتَضَى","وَرَمَتْ أنْحَاؤُهُ بالشُّعَلِ",41,"ل",1,0],["وإن تصدق للشيطان لم أرهُ","شيئاً وفي الجن عشرُ المالِ والخولِ",42,"ل",1,0],["وإنْ تصاممتَ عن إدراك ما نثرت","لديك كانت لك الأكوان أشراكا",43,"ك",2,0],["وان تصدَّى لهُ والعجزُ أخره","فالعذر منهُ جميع الناس ترضاه",44,"ا",2,0],["وإن تُصَحِّف بعكسِ","ففيه للقبط شَرعُ",45,"ع",1,0],["وإن تصحِّفِ اسمه","فبعضُ أوصافِ اللّئيم",46,"م",1,0],["وإن تصحِّف بعد قلبٍ له","فمذهبٌ يعزى لأهل النزاع",47,"ع",1,0],["وانتصبنا على السواد إلى حي","ث بدا للجنان منه خشوع",48,"ع",1,0],["وانتصب المهديُّ لما أن مضى","والدهُ وكان سيفاً منتضي",49,"ي",1,0],["وإن تصحّفه فلا حبّذا","ما قد أتى تصحيفه بانتزاح",50,"ح",1,0],["وانتصح قلت لا ولا بحبيب الْ","لَه دعني فما أراك نصوحا",51,"ح",2,0],["وأن تصغي إلى الواشي وأنت ال","عليم بصدق ودي وانتمائي",52,"ي",1,0],["وانتصار بالرعب مدة شهر","فتصير العد من الهراب",53,"ب",1,0],["وإن تصحِّف لفظَهُ","كَانَ مِنَ الثقلِ رسي",54,"س",2,0],["وان تصدني كفها","أمت فدا شبابها",55,"ب",3,0],["وَأَنتَ صَلى عَلَيك اللَه تقدمهم","في بَهو إشراق نور مِنك مُكتمل",56,"ل",1,0],["وَإِن تَصحفه غَدا اسماً بِه","يوصف فَرد مِن ضُروب الجَماد",57,"د",1,0],["وَإِن تصحفه بَدا قَلبه","ذماً لِمَن أَضحى قَليل الرماد",57,"د",1,0],["وان تصرح بالمشبه فقط","فإنها مكنية فاخش الغلط",58,"ط",1,0],["وانت صححت راضي ليس مكره ومغصوب","قلت يا قوم بابلغ لكم كل مطلوب",59,"ب",1,0],["وإنْ تصحبِ العلياءَ ذرعُكَ ضيقاً","وهمُّكَ من كسْبِ المَحامِدِ خالِيا",60,"ي",2,0],["وإن تصادف صائغاً ماهراً","ميز بين المحض والحائل",61,"ل",1,0],["وان تصطنعني تصطنع ذا حفيظة","شديداً على الأعداء صعب الشكائم",62,"م",1,0],["وَاِنتَصر لِلحَقذِ ان تُؤتي القَضا","ان خَير الناسِ فيهِم من عَدل",63,"ل",1,0],["وًإن تَصِل فَلَفظُ مَن لاَ يَختَلِف","وَنَادِرٌ مَنُونَ فِى نَظمٍ عُرِف",64,"ف",1,0],["وإن تصوح روض العلم فيه فقد","عرا أيادي ساقي روضه الشلل",65,"ل",1,0],["وانتصرت إذ ذاك أجناد العرب","على أنكجرّيتها وسودوا",66,"د",3,0],["وأنت صب عليل","من حبها لست تبرا",67,"ر",2,0],["وانتصاري بك يا من لم يزل","أبداً منه لراجيه انتصارُ",68,"ر",1,0],["وإن تصدوا لك بالنكران","أو ضحكوا سخرًا فقل: سيان",69,"ن",1,0],["وإن تصحف عكس نصف اسمه","أمنت من صد وهجران",70,"ن",1,0],["وأن تصافيكم الأيام في بلدٍ","رحب الجوانب فيه يكرم النزل",71,"ل",1,0],["وإن تصفُ الزجاجة والشرابُ","فذا ألا يجيء عمّا وعمّا",7