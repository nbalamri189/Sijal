ttps://www.aldiwan.net/poem54994.html","المتقارب"],[371,"متى بلغت مذ قط أرض إلى سما","https://www.aldiwan.net/poem17390.html","الطويل"],[411,"أراح الله من زمان","https://www.aldiwan.net/poem49652.html","الوافر"],[420,"غداة سعى أبو بكر إليهم","https://www.aldiwan.net/poem4481.html","الوافر"],[422,"فخار الملوك بأعوانها","https://www.aldiwan.net/poem54168.html","المتقارب"],[466,"نعمت صباحيا يا بن عم محمد","https://www.aldiwan.net/poem15486.html","الطويل"],[484,"القول كالبرق والأعمال كالمطر","https://www.aldiwan.net/poem37185.html","البسيط"],[500,"قبحا لهذا الزمان ما أربه","https://www.aldiwan.net/poem9768.html","المنسرح"],[556,"لمن ضرم أعلى اليفاع تعلقا","https://www.aldiwan.net/poem47366.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83326","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122600","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112958","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109126","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108985","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53170","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27612","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93538","البسيط"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111254","المتقارب"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26216","الوافر"],[2610,"","https://poetry.dctabudhabi.ae/diwan/poem/22599","الهزج"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201489","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204873","الطويل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104225","الوافر"],[302,"","https://poetry.dctabudhabi.ae/diwan/poem/90097","المجتث"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62797","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48440","المتقارب"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205600",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216706","الوافر"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85026","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59479","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114570","السريع"],[4025,"","https://poetry.dctabudhabi.ae/diwan/poem/122155","البسيط"],[4288,"","https://poetry.dctabudhabi.ae/diwan/poem/95803","السريع"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73163","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136619",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72829","البسيط"],[4119,"هو السيف لا يغنيك إلا جلاده","https://www.poetsgate.com/ViewPoem.aspx?id=16111",""],[585,"أتطوي الليل تهتف بالنشيد","https://www.poetsgate.com/ViewPoem.aspx?id=161881",""],[5348,"مسافرة","https://www.poetsgate.com/ViewPoem.aspx?id=59561",""],[5902,"جوى يتلظى فِي الْفُؤَاد استعاره","https://www.poetsgate.com/ViewPoem.aspx?id=189170",""]],"verses":[["أَراحَت عَلَينا ثَلَّةُ الوَجدِ تَرتَعي","ضَمائِرَنا أَيّامَها وَاللَيالِيا",0,"ي",2,0],["أَراحوا فَوقَ أَعضادِ المَطايا","قَدِ اِفتَرَشوا زَرابِيَّ الرِمالِ",1,"ل",1,0],["أَراحَ بَني عامِرٍ ذُلُّهُم","وَعَرَّضَنا عِزُّنا لِلتَعَب",2,"ب",1,0],["أَراحُ إِذا راحَ النَسيمُ شَآمِياً","كَأَنَّ شَمولاً ما تُديرُ الشَمائِلُ",3,"ل",1,0],["أَراحَ فَريقُ جيرَتِكَ الِجمالا","كَأَنَّهُم يُرُيدونَ اِحتِمالا",4,"ل",2,1],["أَراحَ الحَيُّ مِن إِرَمِ الطِرادِ","فَما أَبقَوا لِعَينِكَ مِن سَوادِ",5,"د",1,1],["أراحنا اللَّه منك يا قَذِرَهْ","فأنت عين الثقيلة الوَضِرَهْ",6,"ر",2,1],["أَراحَ اللَهُ عَبدَ القَيسِ مِنّا","وَنَحنُ كَذاكَ مِنهُم نَستَريحُ",7,"ح",1,1],["أراح بالىَ أنى","بحاسدي لا أبالى",8,"ل",2,0],["أراح الله منك حدِيدَتَيه","وأنسى الناس ما علموا عليه",9,"ه",1,0],["أَراحِلَةٌ لَيلى وَفي الصَدرِ حاجَةٌ","أَقامَ بِها وَجدٌ فَما يَتَرَحَّلُ",10,"ل",1,0],["أَراحوا مَطاياهُم فَلا الحَمدُ يُبتَغى","وَلا المَجدُ يُستَبقى وَلا المالُ يُهضَمُ",11,"م",1,0],["أَراحوهُ مِن رَأسٍ وَعَينَينِ كانَتا","بَعيدَينِ طَرفاً بِالخِيانَةِ أَحزَرا",12,"ر",2,0],["أراحةٌ فيك للضمير","أم موعدٌ فيك من حبيب",13,"ب",1,0],["أَراحَ اللَهُ مِن بَصَري","كَما قَد سامَني نَظَري",14,"ر",2,1],["اراح شعوب الخلق بالحق وانبرى","حساما لنصر الحق يرضى المتاعبا",15,"ب",2,0],["أرَاحَت لِقَلبي عَازِبَ الهَمِّ والهَوَى","رُبُوعٌ بِذَاتش الرِّيعِ شَرقِىِّ ذِى الهُوَى",16,"و",2,1],["أراحني الرحمن إذ زاحه","جوزيت خيراً شعرَ هذا الغلام",17,"م",1,0],["أَراحَت مِنَ الهَمِّ الدَخيلِ وَشَجَّعَت","جَباناً وَسَنَّت لِلبَخيلِ التَكَرُّما",18,"م",2,0],["أَراحَ مِنهُ قُلوبَ المُسلِمينَ وَلَم","يَصحَب وَبَدَّلَهُ نِكلاً مِن النَكَلِ",19,"ل",1,0],["أَراحَ بِها مِنهُ الحَميرَ فَأَصبَحَت","تَناهَقُ في المَرعى وَيَعلُو رُدامُها",20,"م",3,0],["أراحَها جَدوَاهُ من كلِّ ما","تشكوه من دَقٍ ومن عَصرِ",21,"ر",1,0],["أراحها الدهر وطُوبَى لمن","يُريحُهُ في آخرِ العُمرِ",21,"ر",1,0],["أراحمة قلبي وقد شفني الصبر","فدنياك لولا الصبر ما عرف الحر",22,"ر",1,1],["اراحنا بعطاياه واتعبنا","في عدها الدهر احصاء واحصار",23,"ر",1,0],["أراحوه من نكبات الحياة","ومن دهره الكافر الحاقد",24,"د",1,0],["أَراحَت مِنَ الهَمِّ الدَخيلِ وَأَعدَت الذَلي","لَ وَسَنَّت لِلبَخيلِ التَكَرُّما",25,"م",2,0],["أراحَ الله مِن زَمانٍ","محَتْ يدُه سُروري بالإساءَهْ",26,"ه",1,1],["أراح على نواهقها علياً","ومج لهن مهجته حبال",27,"ل",1,0],["أراح البلاد وسرّ العباد","وكان جلاءً لأحزانها",28,"ن",3,0],["أراح عزيب المجد بالسعي واحتوى","على مخفرٍ كان الشَّتيتَ المُقسَّما",29,"م",2,0],["أراح فيها ضميري نور محكمه","مما تلوناه من آي ومن سور",30,"ر",1,0],["أراحنا اللّه منك يا زمناً","أرْعنَ يصطاد صقره حَزَبُه",31,"ب",2,0],["أَراحَكُمُ ذاك الّذي لِيَ مُتعِبٌ","وَنوّمكمْ ذاك الّذي لِيَ أرّقا",32,"ق",2,0],["أَراحِلَةٌ مِن عالَمِ المَوتِ لِلبَقا","وَيا حَبَّذا مِن ذَلِكَ الحَيِّ راحِلُهُ",33,"ل",2,0],["أراحت إلى المهدي عازب همِّنا","قِلاصٌ بُراةُ الطَّيرِ تَحتَ قُيودِها",34,"د",3,0],["اراحك ربي واصفا نال وصله","وشفع فينا من يقول أنا لها",35,"ه",2,0],["أراحك من هول الحياة وبؤسها","فكان وفاءً ما تبدى لنا غدرا",36,"ر",2,0],["أراح بالي من الدنيا وعالمها","ومن همومٍ كثيراتٍ بلاياها",37,"ا",3,0],["أراح قِلاصي من وجى السير نصُّها","إليك فقد أضحت أزمتها عقلا",38,"ل",2,0],["أراح به الأتباعَ أتباعَ رُسْله","فكم بين معلولٍ وبين معللِ",39,"ل",1,0],["أَراحه حمرة مِن خَده اِكتَسبت","أَم خده حمرة مِن راحة اِكتَسَبا",40,"ب",2,0],["أراح المجاري يأس اللحاق","وذو اليأس من همه مستريح",41,"ح",1,0],["أَراحِلَةً وَما أَبقَيتِ مِنّي","سِوى لَحظٍ يُتَرجِمُ عَن قَتيلِ",42,"ل",1,0],["أَراحَ اللَّهُ عَمّاراً","مِنَ الدُّنيا وَمِنهُنَّه",43,"ن",2,0],["أراحني من هواكم لؤم أنفسكم","يا من جمالكم بالشّعر لا يوحي",44,"ي",1,1],["أراح لنا الآذان زئر أسودنا","ولا صوت الا زأرها بمريح",45,"ح",1,0],["اراحوا نفسهم مما عليهم","من التكليف أو حذر العقاب",46,"ب",1,0],["أَراحَ يَسقيك شَهداً","من ثغره قُلتُ راحا",47,"ح",2,0],["أَراحَني اللهُ من قلبٍ بُليتُ بهِ","يهوى القعودَ ويهوَى أشرفَ الرّتبِ",48,"ب",1,0],["أراحَتْ فُؤاداً لديْها مَشوقا","غَداةَ قضَتْ منْ هواها حُقوقا",49,"ق",2,1],["أراحه الله من ضنًى","أنقذه القبر من عذابْ",50,"ب",1,0],["أراح الورد عازفة النفوس","وأشرق نجمه بعد الخنوس",51,"س",1,1],["أَراحَت مُهجَتي بِالوَصلِ سَلمى","وَأَولَت بَعدَ حَربِ الهَجرِ سِلما",52,"م",2,1],["أراح أهيل موذية النياقا","كأن فريقهم عزموا الفراقا",53,"ق",2,1],["أراحَكَ اللَّهُ ونِلتَ المُنَى","نَم نَومَةَ العَرُوسِ في خِدرِها",54,"ه",2,0],["أراحلٌ أنت لم تحلُل بمنقبَةٍ","وتاركٌ أنتَ أمّ الفضلِ بالحرمِ",55,"م",1,1],["أراحَنا منه الذي صاغَه","من جَبَل الجوديّ كالجَندل",56,"ل",1,0],["أراحني من مواعيدٍ مُزَخرفةٍ","أجريتُ منهنَّ آمالي على يأَسِ",57,"س",1,0],["أراحوا بأعلام المُصلى نياقَهم","وقد أتعَبوا قلبي بقطَع المراحل",58,"ل",1,0],["أراح منا قلوباً بل أزال عنا","فلم نُقل بعدها يا أزمة انفرجي",59,"ج",2,0],["أراح قلوبا طرن من وكناتها","عليها فوافى كل صدر فؤاده",60,"د",2,0],["أراح الخيل من خببٍ وكدٍّ","وأغنى اليعملات عن الوخيد",61,"د",1,0],["أراحلة أنتِ .. يا للعيون","يعابث أهدابهنّ المدارْ",62,"ر",1,0],["أراحة نَفسِي كَيفَ صرت عَذَابهَا","وجنة قلبِي كَيفَ مِنْك استعاره",63,"ر",2,0]]}