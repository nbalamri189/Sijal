ps://www.poetsgate.com/ViewPoem.aspx?id=208510",""],[5493,"هذي الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=197567",""],[5577,"وألوذ من عجم الشعور إليها","https://www.poetsgate.com/ViewPoem.aspx?id=177006",""],[5626,"يحيا العراق","https://www.poetsgate.com/ViewPoem.aspx?id=189695",""],[5644,"من هي حواء","https://www.poetsgate.com/ViewPoem.aspx?id=211090",""],[5691,"أنَا والدجى","https://www.poetsgate.com/ViewPoem.aspx?id=206743",""],[5720,"أُمِّيْ","https://www.poetsgate.com/ViewPoem.aspx?id=199988",""],[5722,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12685",""],[5736,"نيفين","https://www.poetsgate.com/ViewPoem.aspx?id=208413",""],[5751,"أنثى الماس","https://www.poetsgate.com/ViewPoem.aspx?id=214776",""],[5776,"لعنة القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=199405",""],[5794,"غرور الشعر ..","https://www.poetsgate.com/ViewPoem.aspx?id=122796",""],[5848,"هي بإختصار","https://www.poetsgate.com/ViewPoem.aspx?id=53447",""],[5910,"لغةُ الضَّادِ","https://www.poetsgate.com/ViewPoem.aspx?id=206217",""],[5953,"هيكل الجسم تأليف حكيم","https://www.poetsgate.com/ViewPoem.aspx?id=93915",""],[5956,"في الذكرى* الأولى لوفاة شقيقي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=192406",""],[5956,"مِزاحٌ مع ابنتي آنَ النحيلة","https://www.poetsgate.com/ViewPoem.aspx?id=203443",""],[5956,"لله درُّ الأريحية سامِيا","https://www.poetsgate.com/ViewPoem.aspx?id=208562",""],[6019,"غيابُ (هلالٍ)","https://www.poetsgate.com/ViewPoem.aspx?id=205482",""],[6068,"هل تنجزيني الموعدا -09-","https://www.poetsgate.com/ViewPoem.aspx?id=175856",""],[6108,"نفاق","https://www.poetsgate.com/ViewPoem.aspx?id=192750",""],[433,"نومة الراعي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87053&r=&rc=6",""],[5567,"لدمشق آيات الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82079&r=&rc=132",""],[572,"يا نَدِيمِي أَطْلِقِ الكأْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9351&r=&rc=208",""]],"verses":[["هيكله في شحمه غارقٌ","واللحم في تفصيله بالجمل",0,"ل",1,0],["هَيْكَلُ اللهِ مِنْهُ حِرْزٌ حَرِيزٌ","فَاسْتَقِرَّا فِي غِبْطَةٍ وَجَمَامِ",1,"م",1,0],["هِيَ كَالأَشِعَّةِ فِي تَنَائِي نَجْمِهَا","ولَهَا إِلى كُلِّ القُلُوبِ سَبِيلُ",2,"ل",1,0],["هي كانت قبل التجرّد منه","كوكباً غمّ نوره بغمام",3,"م",1,0],["هي كالشمس في البعاد وأن كا","ن إلينا منها الشعاع قريبا",4,"ب",2,0],["هي كالبرق سرعة والتماعاً","كل أفق بفضلها مشمول",5,"ل",1,0],["هي كلّ ما شكت الشكا","ة وكل ما بعث الشكاية",6,"ا",3,0],["هي كل ما وعت العقو","ل وكل ما روت الرواية",6,"ا",3,0],["هي كوكب حملت مطالع نير","بين التقى والفضل نعم الطالع",7,"ع",1,0],["هَيكَلِيُّ الجِسمِ نورِيُّ الصَميم","صَمَدِيُّ الروحِ دَيّانٌ عَليم",8,"م",1,1],["هِيَ كَالمُسافِرِ آبَ بَعدَ مَشَقَّةٍ","وَأَنا كَأَنّي قائِدٌ مَنصورُ",9,"ر",1,0],["هِيَ كَالمَدائِنِ غَيرَ أَن نُزيلَها","أَبَداً بِها يَتَوَقَّعُ الأَخطارا",10,"ر",2,0],["هِيَ كَالغَديرِ إِذا أَتى فَصلُ الشِتا","فَقدَ الخَريرَ وَصارَ يَحكي المَيتا",11,"ت",2,0],["هِيَ كيمِياؤُكَ لا خُرافَةُ جابِرٍ","تَذَرُ المُقِلَّ مِنَ الجَماعَةِ مُكثِرا",12,"ر",2,0],["هَيكَلُ الشَقاءِ لهُ","مِن مَدامِعٍ عَمَدُ",13,"د",1,0],["هِيَ كِلمَةُ اللَهِ القَديرِ وَروحُهُ","في الكائِناتِ وَسِرُّهُ المُستَغلِقُ",14,"ق",1,0],["هَيكَلٌ تُنثَرُ الدِياناتُ فيهِ","فَهيَ وَالناسُ وَالقُرونُ هَباءُ",15,"ا",2,0],["هيكلٌ يرزح في","آلامِه عاماً فعامَا",16,"م",2,0],["هِيَ كَالدُّهْمِ جَامِحَاتٌ وَلَكِنْ","لَيْسَ يُثْنَى جِمَاحُهَا بِلِجَامِ",17,"م",1,0],["هِيَ كالقميصِ قميصِ يُوسفَ إذ أتَى","يعقوبَ فَانْظُرْ كيف كان الحالُ",18,"ل",1,0],["هِيَ كيمياءُ الحقِّ لولا أنّها","تَهدِي العقولَ لَخِلتُها لا تُعقَلُ",19,"ل",1,0],["هِيَ كَالشَمسِ في الجَلاءِ وَكَالبَد","رِ إِذا قُنِّعَت عَلَيها الرِداءُ",20,"ا",2,0],["هيكلٌ من حقيقةٍ وخيالٍ","مَلَكَ الحبُّ والجمالُ زمامَه",21,"م",2,0],["هِيَ كالأَشِعَّةِ غَيْرَ أَنَّ ضِيَاءَها","مِنْ ذاتِها لا مِنْ ثُقُوبِ ضِياءِ",22,"ا",2,0],["هِيَ كَالْبُرْتُقَالِ لَوْلاَ شِفَاهٌ","قدَّمَتْهَا لِلْعُودِ بُغْيَةَ وَردِ",23,"د",1,0],["هَيكَلٌ يَسْقُطُ فِي قَعْقعة","وَذمَاءٌ مِنْ حَشىً يَصْعدُ زَفْرَا",24,"ر",2,0],["هي كالورد تحمل الشوق والعط","ر وان خيّر اللبيبُ اختارا",25,"ر",2,0],["هي كنهُ إحساسي وروحُ قصائدي","ومطافُ أحلامي وركنُ ودادي",26,"د",2,0],["هيكلٌ من هياكِل اللهِ سُدَّ البابُ","منه وكفنَّوا صُلبانه",27,"ن",2,0],["هي كذا.....؟ والذيب.؟ عاوي ليل...؟ عاوي","والوعد قدام..؟ والنيه سليمه",28,"م",2,0],["هِيَ كَالحِجارة فَاِدخرها عدَّة","لِتَهابك القَوم اللئام كِلابها",29,"ه",2,0],["هيكل فرد تجلى قدسه","ما له إلاه أهل ومحل",30,"ل",1,0],["هي كالدرِّ والجُمانِ نقاء","بنت فكرٍ كريمةِ الميلادِ",31,"د",1,0],["هِيَ كَالقَلائِدِ في النُحورِ فَإِن صَغَت","تِلكَ النُحورُ أَحَلتَها أَغلالا",32,"ل",2,0],["هي كالخمرة تبدو حبباً","أول الدن وتخفي شررا",33,"ر",2,0],["هي كالحياة فقدتها","فلقيتُ أهوال القيامه",34,"م",2,0],["هِيَ كَأْسٌ في شروقٍ","وهي قرطٌ في غُروبِ",35,"ب",1,0],["هِيَ كَالحَمامةِ في الوَداعةِ وَالنَقا","طارَت فَحَلَّقَ في السَماءِ مَطيرُها",36,"ر",3,0],["هِيَ كانَت أَرواحُهُم وَبِها كا","نَ لَهُم بَعدَ مَوتِهِم إِحياءُ",37,"ا",2,0],["هي كالصيحة في شدتها","أو جبالٍ تتصادم بجبال",38,"ل",1,0],["هي كالفراشة ترتمي","حول السراج على العذاب",39,"ب",1,0],["هي كالآل إن صفت لفتى","أو بروق ومضن عن بعد",40,"د",1,0],["هيكَلَ الإِثم لَم أُبِح لَكَ ذُلي","شَبحَ الرَقِّ لَم أُسَلِّمك نيري",41,"ر",2,0],["هَيكَلَ الفَنِّ وَالجَمالِ سَلامٌ","وَسَلامُ يا هَيكَلَ البُؤَساءِ",42,"ا",2,0],["هي كالرياض إذا تَضاحَكَ نَوْرُها","وصفاء ودّك فيه كالكافور",43,"ر",1,0],["هي كالنِّثار من الملائك للورى","فرحا به ولكل عات ترجم",44,"م",1,0],["هي كالطاوسِ من زهو الصِبا","وهو من غلوائه مهرٌ أَرِنْ",45,"ن",1,0],["هي كالأقدار معناها","قريب وبعيد",46,"د",1,0],["هيكل اللفظ فارقته المعاني","وهي نساكه فأنتج عقمه",47,"ه",1,0],["هِيَ كَالمَوارِدِ في العُيونِ وَطالَما","نَقَعوا بِهاماتِ الكُماةِ صَداها",48,"ا",3,0],["هي كالرِّياض تفتَّحت أزهارها","أو كالحِسان تفكَّكتْ أزرارها",49,"ر",3,0],["هي كعبة الحجاج تل","ك وكعبة المحتاج هذي",50,"ي",1,0],["هي كعبة الغيب المقدس طائف","أبداً بها ما يظهر الحدثان",51,"ن",1,0],["هيكل تسرح النواظر منه","في جمالٍ فردٍ بغير اشتراك",52,"ك",1,0],["هيكلي سام سليم الشبحِ","طاهر الذيل نظيف القدحِ",53,"ح",1,1],["هي كالشمسِ تلالا نورها","فمتى ما إِن ترُمةُ عاد فيْ",54,"ي",1,0],["هيَ كالمرآة تُبدي صوراً","قابَلَتْها وبها ما حل شيءْ",54,"ي",2,0],["هيَ كَعْبةُ القُصَّادِ بل هيَ منَهلُ ال","وُرَّادِ بل هيَ غُصَّة الحُسَّادِ",55,"د",1,0],["هيَ كالسَّرابِ يَزيدُ مُهجةَ وارِدٍ","ظَمأً ويَملأُ مُقلتَيهِ مَنظَرا",56,"ر",2,0],["هيَ كالهباءِ فماسكٌ بحبِالها","تحتَ الرَّجاءِ كماسكٍ بمثالِهِ",57,"ل",2,0],["هِيَ كَالْوَرْدَةِ فِي سَوْسَنَةٍ","أَوْ كَرَاحٍ فِي زُجَاجٍ أَزْرَقِ",58,"ق",1,0],["هي كالفِجار الصَّعبِ أو كحُنين أو","كالشّعب أو كبُعاثِ أو ذي قار",59,"ر",1,0],["هي كالهلال سحابها عرفانها","فغدت لمقتطف الفضائل مصعدا",60,"د",2,0],["هي كاعبٌ حسناءُ إلا أنها","مع ذاك منْ قَبْلِ النكاحِ تُطَلَّق",61,"ق",1,0],["هِيَ كانَت عَلى عُلومِيَ وَالآدابِ وَال","فِقهِ عُدَّتي وَسِلاحي",62,"ح",2,0],["هِيَ كانَت غِذاءَ زَوري إِذا زارَ","وَرِيَّ النَديمِ يَومَ اِصطِباحي",62,"ح",2,0],["هي كالكواكب لا يقوم بحصرها","نظمي وإن كنت الخطيب المصقعا",63,"ع",2,0],["هي كالبدر سناءً","وسنىً طَلْقاً وسَنّا",64,"ن",2,0],["هي كانت من قبل هذا قبوراً","فإذا ما حللت فهي خيام",65,"م",1,0],["هي كالفجر كالندى كالأماني","هي بيضاء كالصباح الطهور",66,"ر",1,0],["هي كهفي ومستظلي من الح","ر وذخري لنائبات الزمان",67,"ن",1,0],["هي كانت من سواها أقربا","عنده زُلفى وأعلاها مقاما",68,"م",2,0],["هي كالغزالةِ في الضُّحى رمحتْ","تزري الغصونَ بمائلِ الخصْرِ",69,"ر",1,0],["هي كربلاء فقف على عرصاتها","ودع الجفون تجود في عبراتها",70,"ت",3,1],["هَيكَلٌ لِلعَفافِ دَنَّسَهُ العُه","رُ وَفَجرٌ لِلطُهرِ جازَ أَصيلَه",71,"ل",2,0],["هي كالليل لا يضيء بشهب","غير أني لما شعرت بحب",72,"ب",1,0],["هيكل أنت للمرؤة في جث","مان إنسان والهدى لك صاحب",73,"ب",1,0],["هيَ كعبةُ المولى الكريمِ وكُلُّ مَن","وافى إليها حقُّهُ أن يُكرَما",74,"م",2,0],["هي كالمصباح نيَّرة","مدَّه زيتٌ يكاد يُضي",75,"ض",2,0],["هي كعبة الوفاد بل هي قبلة ال","قصاد بل نحج المنى بديارها",76,"ر",3,0],["هيَ كالغزالةِ لا تزالُ جديدَةً","والطرفُ دونَ ضبابِها مغموزُ",77,"ز",1,0],["هي كالفجر على الزهر النضير","وهي كالايمان للقلب المنير",78,"ر",1,0],["هي كالغصنِ يانعاً يتثنى","في بكورٍ من الربيعِ النضير",79,"ر",1,0],["هيكل نهدُ القصير شيظم","سابح ينفح بالخيل احتضارا",80,"ر",2,0],["هي كالوهم ألبسته خيوط","الفكر ثوباً من الخيال جليّا",81,"ي",2,0],["هيكل الجمع عند فرق المعاني","دورة الفرق سر حرز الأمان",82,"ن",1,0],["هيَ كالدُّر فِي الغنا إِنْ يُؤلَف كا","نَ فضْلاً أَوْ لا اكْتَفَتْ آحادُهْ",83,"د",2,0],["هي كعبة الحرم الشريف تعلقت","مهج وأرواح بها وقلوب",84,"ب",1,0],["هي كعبة الآمال روض هدى","هي بيت أهل البيت والمجد",85,"د",1,0],["هِيَ كَيفَ شاءَت بِالحَشاشة حُكمُها","وَأَنا كَما شاءَ الغَرامُ أُعاني",86,"ن",2,0],["هي كالراووق للنور فلا","صفو إلا صفوها العذب المصونْ",87,"ن",1,0],["هي كأس من كؤوس الخالدينْ","لم يشبها المزج من ماء وطينْ",88,"ن",1,1],["هيكل انت للجمال عظيم","جسمته يد البها فتجسم",89,"م",1,0],["هي كالأتوموبيل إذ تمشي وإن","وثبت جوى فكأنها المنطاد",90,"د",1,0],["هي كالغزالة خفة وتلفتا","والقد منها والقضيب سواء",91,"ا",2,0],["هيكل طلسمته أيدي المعالي","فحشت جانبي هيولاه فضلا",92,"ل",2,0],["هَيكَلُ الأَحزانِ في مِحرابِهِ","قَرَّبَ العُشّاقَ قُربانَ العُيون",93,"ن",1,0],["هَيكَلُ الأَحزانِ في مَذبَحِهِ","قَرَّبَ العُشّاقَ قُربانَ العُيون",94,"ن",1,0],["هي كالفضة لاقت ذهبا","وغدت ممتازة في سبكها",95,"ه",2,0],["هيكل عارق من اللحم يكسوه","رداء تجول فيه عظام",96,"م",1,0],["هيَ كالسُرجِ في الزُجاجِ إِذا ما","صَبَّها في الزُجاجةِ الوُصَفاءُ",97,"ا",2,0],["هي كُتبي فليس تصلحُ من بع","دي لغيرِ العطّارِ والإسكافي",98,"ي",1,1],["هي كاترينا قنس دوح كرامة","يبدي السجود لوصفها التعظيمُ",99,"م",1,0],["هِيَ كَف الدَهر وَالدَهر بِها","يوسع الغادة أَخذاً بِالطرر",100,"ر",1,0],["هي كعبةٌ طافت ملائكة السَما","فيها وفيها غابَ ليثٌ أروع",101,"ع",1,0],["هي كهف النجاة طور المناجا","ة ثمال العفاة مأوى الدخيل",102,"ل",1,0],["هِيَ كِلمَةٌ عَبَرَت كَزَعمِكِ مُرَّةً","وسَرِيعَةً كَسَعادَتِي وأَمَانِي",103,"ن",2,0],["هِيَ كَبوَةٌ ونَعُودُ.. \"قِيلَ لَنا\"","وإِلى الأَمَامِ سَيُصبِحُ العَدْوُ",104,"و",1,0],["هي ..كالدليلِ .. إذا الفِجاجُ تبعثرتْ","ميلادُ كونٍ .. عيدُها \"تشرينُ\"",105,"ن",1,0],["هي كلمتين صغار ماهي عريضه","أقولها ما أبيك في كل الأحوال",106,"ل",1,0],["هي كالفراش تطير دون ت