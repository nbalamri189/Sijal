{"poems":[[65,"وحي من بني جشم بن بكر","https://www.aldiwan.net/poem45693.html","الوافر"],[95,"من يبتني للعلم دارا إنما","https://www.aldiwan.net/poem11198.html","الكامل"],[49,"أغص لذكره أبدا بريقي","https://www.aldiwan.net/poem25336.html","الوافر"],[74,"ديار شعري سقاك السعد ماطره","https://www.aldiwan.net/poem18709.html","البسيط"],[74,"مقسم الخاطر ولهانه","https://www.aldiwan.net/poem20166.html","السريع"],[53,"أغصان بان تحتهن وعاث","https://www.aldiwan.net/poem9230.html","الكامل"],[72,"أغصن النقا لولا القوام المهفهف","https://www.aldiwan.net/poem42817.html","الطويل"],[63,"أعددت لليل إذا الليل غسق","https://www.aldiwan.net/poem51533.html","الرجز"],[63,"مرضت جفونك والحتوف شعارها","https://www.aldiwan.net/poem51680.html","الكامل"],[41,"أصاح ألا هل من سبيل إلى هند","https://www.aldiwan.net/poem53784.html","الطويل"],[15,"تبصر خليلي هل ترى من ظعائن","https://www.aldiwan.net/poem45262.html","الطويل"],[132,"بعادك يا عذب الثنايا ولا الصد","https://www.aldiwan.net/poem50635.html","الطويل"],[275,"إذا غاب جسمي في الثرى رافقي ظلي","https://www.aldiwan.net/poem35631.html","الطويل"],[275,"أدمشق أين بنو أمية قولي","https://www.aldiwan.net/poem35651.html","الكامل"],[366,"بالجد والجد حاول ذروة الشرف","https://www.aldiwan.net/poem68088.html","البسيط"],[463,"يا عينِ لو أغضيتِ يوم النوى","https://www.aldiwan.net/poem56312.html","السريع"],[520,"أنهي إليك من خفي حالي","https://www.aldiwan.net/poem12216.html","السريع"],[572,"أذابت قلبه الزفره","https://www.aldiwan.net/poem69677.html","مجزوء الرجز"],[591,"حديث غرامي في هواك قديم","https://www.aldiwan.net/poem17714.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138307",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138365",""],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66833","السريع"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59677","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119895","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120004","المنسرح"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56172","المتدارك"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79992","المتقارب"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11914","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77744","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77782","المنسرح"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118389","الوافر"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100469","المنسرح"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53161","الكامل"],[2251,"","https://poetry.dctabudhabi.ae/diwan/poem/82123","البسيط"],[2328,"","https://poetry.dctabudhabi.ae/diwan/poem/113035","السريع"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60860","الكامل"],[2954,"","https://poetry.dctabudhabi.ae/diwan/poem/138921",""],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103835","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132116","المتدارك"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99237","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69899","البسيط"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123468","الكامل"],[4766,"أغصان وردٍ زينت درر الندى","https://www.poetsgate.com/ViewPoem.aspx?id=181432",""],[4767,"أرضي الجرداء","https://www.poetsgate.com/ViewPoem.aspx?id=214759",""],[4802,"انا المخلص لأبونا آدم","https://www.poetsgate.com/ViewPoem.aspx?id=32675",""],[5092,"إلى الفاتنة","https://www.poetsgate.com/ViewPoem.aspx?id=139721",""],[5152,"وأنت ربي","https://www.poetsgate.com/ViewPoem.aspx?id=184242",""],[5431,"غاصت الروح ضمن الروح مُرتحلا","https://www.poetsgate.com/ViewPoem.aspx?id=182963",""],[5470,"سديم التداني","https://www.poetsgate.com/ViewPoem.aspx?id=11241",""],[5690,"حياة المرءِ في الدنيا منامُ","https://www.poetsgate.com/ViewPoem.aspx?id=172186",""],[5790,"متى بت إلا في هواك موحدا","https://www.poetsgate.com/ViewPoem.aspx?id=112031",""],[6225,"الصلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81026&r=&rc=263",""],[402,"من يبتني للعلم دارا إنما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54176&r=&rc=1028",""],[6339,"وطن النماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87894&r=&rc=6",""],[572,"أذَابَتْ قلبَهُ الزّفرهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9323&r=&rc=180",""]],"verses":[["أَغصُّ العَينَ بالعَبَراتِ وَجداً","لأَنّي بِالهَوى شَرِقُ الفؤادِ",0,"د",1,0],["أَغْصَانُ بَانٍ لا يَمِيلُ بِهَا الهَوَى","للهِ مَيْلُكِ يَا غُصُونَ البَانِ",1,"ن",1,0],["أَغَصُّ لِذِكرِهِ أَبَداً بِريقي","وَأَشرَقُ مِنهُ بِالماءِ القَراحِ",2,"ح",1,1],["أغصان رزق لديه أو نجوم هدًى","فقل أزاهره أو قل زواهره",3,"ر",2,0],["أغصّه النيل بدمعِ الأسى","ومرَّرتْ ذكراه حلوانه",4,"ن",2,0],["أَغصانُ بانٍ تحتهنَّ وِعَاثُ","أَنَّى يَنُؤْنَ بنا وهُنَّ دِماثُ",5,"ث",1,1],["أَغُصنَ النَقا لَولا القَوامُ المُهَفهَفُ","لَما كانَ يَهواكَ المُعَنّى المُعَنَّفُ",6,"ف",1,1],["أغصانَ تِبْرٍ عُرِّيَتْ عن الوَرَقْ","ثِمارُها مثلُ مَصابيحِ الأُفُقْ",7,"ق",1,0],["أغصانُ بانٍ أعربتْ في حَمْلِها","فغَرائِبُ الوَرْدِ الجَنيِّ ثِمارُها",8,"ر",3,0],["أَغصَّت عَلَيكَ الأَرضَ قَحطانُ بِالقَنا","وَبِالهُندُوانِيّاتِ وَالقُرَّحِ الجُردِ",9,"د",1,0],["أُغِصُّ إِذاً شَغبَ الأَلَدِّ بِريقِهِ","فَيَنطِقُ بَعدي وَالكَلامُ خَفيضُ",10,"ض",1,0],["أغصنٌ نقَا ذيَّاك أم خُوطٌ بانةٍ","تميلُ به الأردافُ أم ذلك القدُّ",11,"د",1,0],["أغصُّ بريقي باكياً ما شَهدتها","وما غصّتِ الساحاتُ بالخَيل والرجل",12,"ل",1,0],["أغصانُ جذعٍ أو مرازحُ كرمةٍ","وجميعُها صلةٌ من الموصول",13,"ل",1,0],["أَغصان فَضل بِطيب الغرس دانِيَة","فُروعِها فاجنها ان شِئت وَاِقتَطف",14,"ف",1,0],["أَغَصُّ بالماء حِفاظا لِما","فارقُته فى فمه من لَمَى",15,"ا",1,0],["أغصني الزمان بالزلال","أصبحت والشكوى لذي الجلال",16,"ل",1,0],["أغصّ الله من يكرِ","هُ ما قُلْتُ بما يَكْرَهْ",17,"ر",2,0],["أَغُصْنَ النَّقا إنّي أَغارُ إِذَا غَدَا","يُلاعِبُ عِطْفيْكَ الرّشاقَ نَسِيمُ",18,"م",1,0],["أغصانها تلك الملاح يميلها","نسم كأنفاس لهن معنبر",19,"ر",1,0],["اغصانها مثل الاصول عريقة","في معرج الشرف الرفيع توقلوا",20,"ل",3,0],["أغصانها ناعمةٌ جَمَّةٌ","من ذهبٍ أحمرَ عِقيانِ",21,"ن",1,0],["أُغصن بهبات النسيم يميلُ","أم القدُّ تثنيه صَباً وقبول",22,"ل",1,1],["اغصانها من لينها هيفا","تحكي الخصور وماؤها خصرُ",23,"ر",1,0],["أغصُّ العذلِ في هواه كما","بِساقِه العبلِ غصّ خلخالُه",24,"ل",2,0],["أغصان المجد طوالعهم","تزهو بالسعد بلا تلمِ",25,"م",1,0],["أغصناً ولم أجنِ منه الثمارَ","جنته يدُ الموت غصناً رطيبا",26,"ب",2,0],["أَغصانُ بانٍ إِذا هَبَّ النَسيمُ بِها","تَرَنَّحَت بَينَ كُثبانٍ وَاِقمارِ",27,"ر",1,0],["أَغصان ياسون الهوى جنوية","جمعت بها أَنفاس حور العين",28,"ن",1,0],["أَغصان باسونا","لَو أَشرقت حينا",29,"ن",2,0],["أغص مخلخلاها كل حجل","فنادت من يغيثني الحجول",30,"ل",1,0],["أغصان علمٍ حلا بهم ثمراً","فروع مجدٍ زكت جرائمها",31,"م",3,0],["أغصانها سمر الرماح وغدرها","خضر السوابغ والسيوف جداول",32,"ل",1,0],["أَغصانها نُضُر أَوراقُها خُضُر","أَنهارُها غُزُر من ضرب شَفّانِ",33,"ن",1,0],["أغصُّ من دمعي حفاظاً لما","فارقته من ريقك السلسلِ",34,"ل",1,0],["أغصانه مخضرّة ورياضُه","مُفتَرَّة ونسيمُه وصَبَاه",35,"ه",1,0],["أغصون قد انثنت أم قدود","وشقيق ما قد زها أم خدود",36,"د",1,1],["أَغصان بان ببستان قد اِشتبكت","المهرقين دماء في الجهاد زَكَت",37,"ت",1,0],["أغص بالماء إن أذكر تباعده","كمن تثاءب وسط النقع والوهج",38,"ج",1,0],["أغصان الوادي حانية","تهتز لسمع أغانينا",39,"ن",2,0],["أغصانُ بانٍ ما تميدُ بها الصَّبَا","وتمرُّ أَنفاسي بها فتميد",40,"د",1,0],["اغصانهُ تحملُ الاثمارَ يانعةً","وَالشَعبُ يحملها بالعزِّ منصورا",41,"ر",2,0],["أغصانُ روضِ العلمِ بانَ ذبولُها","فتَساقطت مصفرَّةَ الأكمام",42,"م",1,0],["أغصان وردٍ زينت درر الندى","أجيادها بمخانقٍ وعقود",43,"د",1,1],["أغصانُها غضَّةٌ في سُوقِها اعتدلَت","وكل أعواد زرعي اليوم ملتوية",44,"ي",2,0],["أغص بدمعة العزة وبعض الناس شماته","ينادوني يا أول شخص بنى مجده من جراحه",45,"ح",2,0],["أغصانُ عشقي قد تمدَّدَ ظلها","فتراقصتْ لمَّا رأيتكِ ثانيهْ",46,"ي",2,0],["أَغُصُّ بِحُرقَةِ البلوى وأبكي","وَأَرْكَنُ للهمومِ وأنتَ قُربي !",47,"ب",2,0],["أغصان كرمي قطوف الحب دانيةٌ","فاعصر حنينك كأس الشوق قد ثملا",48,"ل",2,0],["أغْصَنَ الجُرحُ في شِغَافِ المُعَنَّى ","ودِمَائِي حَمَائِمٌ وهَدِيلُ",49,"ل",1,0],["أغصنٌ أخضرٌ ألقاه قصفاً","هواءٌ أصفرٌ فيهِ الحِمامُ",50,"م",1,0],["أغصن النقا ما أنت عندي شبيهه","وإن كنت مياس المعاطف أملدا",51,"د",2,0],["أغصانُ الفرحةِ في دَمِنا","تمتدُّ مُحَلِّقةَ الشهُبِ",52,"ب",1,0],["أغصان بان لا يميل بها الهوى","للله ميلك يا غصون البان",53,"ن",1,0],["‏أغصانك الميادة ابتهجت","فيها الثمار وعطرتك ندى",54,"ا",1,0],["أغَصّ اللهُُ مَنء يكرَ","هُ مَا قلتُ بِمَنْ يَكْرَهْ",55,"ر",2,0]]}