{"poems":[[9,"شاقتك من قتلة أطلالها","https://www.aldiwan.net/poem21944.html","السريع"],[5,"ليجز الله من جشم بن بكر","https://www.aldiwan.net/poem278.html",""],[0,"أيا هند لا تنكحي بوهة","https://www.aldiwan.net/poem67.html",""],[90,"هي النفس أغشى في رضاها المعاطبا","https://www.aldiwan.net/poem44814.html","الطويل"],[74,"خلفت بالقلب بيتا منك معمورا","https://www.aldiwan.net/poem18733.html","البسيط"],[74,"يا سيدا حاز المعا","https://www.aldiwan.net/poem19127.html","مجزوء الرجز"],[53,"أحب المهرجان لأن فيه","https://www.aldiwan.net/poem7934.html","الوافر"],[80,"أنا في الحب مغرم مستنيل","https://www.aldiwan.net/poem14255.html","الخفيف"],[87,"لي جدة ترأف بي","https://www.aldiwan.net/poem7998.html","مجزوء الرجز"],[30,"كم من مناد والشريفان دونه","https://www.aldiwan.net/poem5113.html","الطويل"],[30,"تظل بعينيها إلى الجبل الذي","https://www.aldiwan.net/poem5351.html","الطويل"],[30,"دعاهم مزوني فجاؤوا كأنهم","https://www.aldiwan.net/poem5352.html","الطويل"],[51,"يا راكب الغي غير متئد","https://www.aldiwan.net/poem62035.html","المنسرح"],[68,"لي جار كأنه البوم في الشك","https://www.aldiwan.net/poem38605.html","الخفيف"],[71,"أنا في الحب قانع باليسير","https://www.aldiwan.net/poem28994.html","الخفيف"],[83,"سل عن سهادي وعن سقمي وعن جلدي","https://www.aldiwan.net/poem61364.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39683","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202527","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1929","المتقارب"],[161,"قلمي","https://www.aldiwan.net/poem23654.html","الهزج"],[203,"هي الأفلاك لا شم القباب","https://www.aldiwan.net/poem45404.html","الوافر"],[298,"أيا هند لا تنكحي بوهةً","https://www.aldiwan.net/poem411.html",""],[369,"خطبن وأيمان الكماة المنابر","https://www.aldiwan.net/poem60906.html","الطويل"],[382,"ذريني فجدي حيثما كنت مرشدي","https://www.aldiwan.net/poem66877.html","الطويل"],[409,"ولما عراني الضعف من كل جانب","https://www.aldiwan.net/poem33893.html","الطويل"],[445,"ثنائي عليك ونعماك فينا","https://www.aldiwan.net/poem34861.html","المتقارب"],[445,"تخيرت فاستمسكت بالعروة الوثقى","https://www.aldiwan.net/poem34892.html","الطويل"],[469,"حال في الحب عهده","https://www.aldiwan.net/poem3575.html","عموديه"],[505,"قل لغزلان بقيعان النقا","https://www.aldiwan.net/poem37937.html","الرمل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83315","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66820","الرمل"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88631","الكامل"],[749,"","https://poetry.dctabudhabi.ae/diwan/poem/97584","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137552",""],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62562","البسيط"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119336","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122077","الخفيف"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101921","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125401","المتقارب"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76834","المديد"],[2010,"","https://poetry.dctabudhabi.ae/diwan/poem/143783","المجتث"],[2076,"","https://poetry.dctabudhabi.ae/diwan/poem/105239","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53119","الكامل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/83071","الرمل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129904","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100369","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58276","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201654","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200744","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202817","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204827","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204793","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199938","السريع"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97996","المتدارك"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91167","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205673","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35610","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95065","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73121","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73319","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83588","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83540","الوافر"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83188","الرجز"],[4818,"إعثار","https://www.poetsgate.com/ViewPoem.aspx?id=204635",""],[4865,"ألا أيها الويلات ويلة من بكى","https://www.poetsgate.com/ViewPoem.aspx?id=213877",""],[3591,"أين الذي كان في باريس يزدهر","https://www.poetsgate.com/ViewPoem.aspx?id=149476",""],[5183,"أَلْفَرَاهيدِيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=186453",""],[5232,"جذوة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=212801",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5410,"آهات","https://www.poetsgate.com/ViewPoem.aspx?id=144495",""],[5431,"(سأزرع الأرضَ آلافا من القُبَلِ)!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200121",""],[5431,"مجنون ذئبة ...","https://www.poetsgate.com/ViewPoem.aspx?id=207159",""],[5431,"وحقك لاتعتب....","https://www.poetsgate.com/ViewPoem.aspx?id=214590",""],[5461,"لواجب اكبر","https://www.poetsgate.com/ViewPoem.aspx?id=5309",""],[5751,"خطوتانِ لقَمَرٍ هارب","https://www.poetsgate.com/ViewPoem.aspx?id=214718",""],[5753,"دهشتان","https://www.poetsgate.com/ViewPoem.aspx?id=215188",""],[5899,"عطر النار","https://www.poetsgate.com/ViewPoem.aspx?id=31488",""],[5943,"حروفي المسكُ في طهرٍ تسامى","https://www.poetsgate.com/ViewPoem.aspx?id=34364",""],[5953,"سئمت المقام بأرض الشّام","https://www.poetsgate.com/ViewPoem.aspx?id=93800",""],[5956,"ثلاث قصائد لصديق","https://www.poetsgate.com/ViewPoem.aspx?id=207975",""],[6003,"في حضرة النبي","https://www.poetsgate.com/ViewPoem.aspx?id=188899",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""]],"verses":[["لَيَجعَلَنّي سُبَّةً بَعدَها","جُدِّعتَ يا عَلقَمُ مِن ناذِرِ",0,"ر",1,0],["لِيَجزِ اللَّهُ مِن جُشَمَ بنِ بَكرٍ","فَوارِسَ نَجدَةٍ خَيرَ الجَزاءِ",1,"ا",2,1],["لِيَجعَلَ في رِجلِهِ كَعبَه","حِذارَ المَنِيَّةِ أَن يُعطَبا",2,"ب",2,0],["ليجمع من أبناء يعرب شملهم","ويَقضي حقاً للمَواطن واجبا",3,"ب",2,0],["ليجبر الحسن لي قلباً مضى عمرٌ","له بحسنِ ابن فضلِ الله معمورا",4,"ر",2,0],["لي جبةٌ رفوت من","ها البعض إذ لم أرضها",5,"ه",2,0],["ليجعَلَه فداءَك إنْ رآه","فداءك أيها الغالي الفداءِ",6,"ا",2,0],["لي جُثمانُ مَن يَظُنُّ صَحيحاً","وَفُؤادي مِنَ الغَرامِ عَليلُ",7,"ل",1,0],["لي جَدَّةٌ تَرأَفُ بي","أَحنى عَلَيَّ مِن أَبي",8,"ب",2,1],["لِيَجتَرَّ مِنكُم إِن رَأى بارِزاً لَهُ","مِنَ الجِيَفِ اللائي عَلَيكُم حَظائِرُه",9,"ر",2,0],["لِيَجعَلَهُ اللَهُ الخَليفَةَ وَالَّذي","لَهُ المِنبَرُ الأَعلى عَلى كُلِّ ناطِقِ",10,"ق",1,0],["لِيَجزِيَ عَنهُم مِنهُمُ كُلَّ مُصعَبٍ","مِنَ الغادِياتِ الرائِحاتِ السَوابِقِ",11,"ق",1,0],["لَيَجرِيَنَّ البَلى عَلَينا بِما","كانَ جَرى قَبلَنا عَلى لُبَدِ",12,"د",1,0],["لِيَ جارٌ كَأَنَّهُ البومُ في الشَك","لِ وَلَكِن في عُجبِهِ فَغُرابُ",13,"ب",1,1],["ليَ جفنٌ وللوزير لواءٌ","دُعيا بالسفاح والمنصورِ",14,"ر",1,0],["لِي جُذوَةٌ في حَشَاءِ الصَّدرِ ضارِمَةٌ","حَسبِي أذَاهَا لَقَد وَضَعتُهَا بِيَدِي",15,"د",2,0],["ليجير شعباً أو يحرّر أمّة","لا تستباح ولا يضامُ نجيبها",16,"ب",3,0],["ليجد الناشئ في الجديد","من لذة ما ليس في الترديد",17,"د",1,0],["لَيُجِدَّنَّ بِهَا مُعْجِزَةً","تُرْهِبُ الأَعْقابَ مَا النَّجْمُ ازْمهَرَّا",18,"ر",2,0],["لِيَجعَلَ الصالِحاتِ في عَقبي","باقِيَةً بِالحَميدِ عُقباهُ",19,"ا",2,0],["ليَجعَلَ اللَهُ لَها","أَطوَلَ عُمرٍ عُمُرَك",20,"ك",1,0],["لِيَجعَلَ في رِجلِهِ كَعبَها","حِذارَ المَنِيَّةِ أَن يُعطَبا",21,"ب",2,0],["لِيَجْرِي سَيْلُهُ مَدًّا","عَلَى الأوراقِ يَنْصَبُّ",22,"ب",1,0],["ليجحدْ من يشاءُ فربَّ قشرٍ","يكونُ وراءهُ عجبُ اللبابِ",23,"ب",1,0],["لِيَجعَلَ في يَدِهِ كَعبها","حِذارَ المَنيَّةِ أَن يُعطَبا",24,"ب",2,0],["لِيجمعَ كُلاً ظِلُّ دولتِكَ التي","علينا الغِنَى من سُحْبِها مُتَقاطر",25,"ر",1,0],["ل يجب الإكرام من كل واحدٍ","من الناس والأملاكِ يوماً وفي غد",26,"د",1,0],["ليجري لمن قد سن ذلك أجره","كما صح في الأخبار عند ذوي القدر",27,"ر",1,0],["لِيَجْلُوَ أَستارَكَ الخُضْرَ عنَّا","ويمحُوَ آثارَكَ الغُرَّ فِينا",28,"ن",2,0],["لِيجُلو عن الدنيا بكَ الهَمَّ والأَسى","ويجمعَ فِي سلطانِكَ الغَرْبَ والشَّرْقا",29,"ق",2,0],["ليَ جسمي وسق","مه وفؤادي ووجده",30,"د",2,0],["ليَ جَفْنٌ من دَواهي هَجْرِكُمْ","طولَ ليلي بالكَرَى ما انْطَبَقَا",31,"ق",2,0],["لِيُجهِدَ في اِستِرجاعِ رَونَقَ شَرقَنا","وَتَجديدَ ما مِن مَجدِهِ قَد تَهدِما",32,"م",2,0],["لِيجيبوه إلى الل","هِ فكانوا أربَعينا",33,"ن",2,0],["لي جمره تحت الضلوع دفينه","ولك اخضرار الغصن منه ولينه",34,"ه",1,0],["ليجبر صَدعي إنّه خير جابرٍ","ويمنعني مِن ذي الظلامة جابرِ",35,"ر",1,0],["ليجبر مرآه قلبا كسيرا","وتنفح يمناه نفح الزهر",36,"ر",1,0],["لي جانبَ السنح أوطارٌ وأوطانُ","سقى لياليَها الغراءِ هتّانُ",37,"ن",1,1],["ليجمعنا ال له همة همت","تلألأ لا لاغ غلامك كامل",38,"ل",1,0],["لِيجزِي المُؤمن بِالثَّواب","وَيجزِي الكافِر بِالعِقاب",39,"ب",1,0],["لِيَ جَفْنٌ إِذَا ذُكِرْتَ مَعِينْ","لَيْسَ يَأْتِي إِلاَّ بِدَمْعٍ هَتُونْ",40,"ن",1,1],["لي جسم أضناه ذكر المغاني","وفؤاد أصماه حب الغواني",41,"ي",1,1],["ليجر القصاء بأحكامه","ومن يستيطعُ عِنادَ القَدَر",42,"ر",1,0],["لي جُنوبٌ عَن مضاجِعها","تَتَجافى إذ بها نَبَتِ",43,"ت",1,0],["ليجزينك ودي","بمثل فعلك فعلاً",44,"ل",2,0],["لي جنة من وجنتيه وحورها","ألحاظه والثغر نهر الكوثر",45,"ر",1,0],["لي جنة رضوانها منك الرضا","وندى يديك إذا ظمئت الكوثر",46,"ر",1,0],["لي جارٌ لستُ أرجوهُ","ولا آمنُ شَرَّه",47,"ه",1,1],["لي جيرةٌ ضنّوا عليّ وجاروا","فنبَت بيَ الأوطانُ والأوطارُ",48,"ر",1,1],["لي جوى فيهم يبرّح وجداً","وهوىً قاتلٌ ودمعٌ همولُ",49,"ل",1,0],["لي جَبّة فَنيَتْ ممّا أنَشيِّها","وما أُخَيِّطُها ألا بأشراسِ",50,"س",1,1],["لي جارة راحت بلا رجعةٍ","بعد شقاء معها نلتُه",51,"ه",1,1],["لي جوهرٌ ببسيط اللبس محتجبٌ","من فرط حبي لبحّاثٍ وفحّاصٍ",52,"ص",1,1],["لي جوهر باقٍ ولكن عندهم","في الكون أعراضٌ لهم تتجدد",53,"د",1,0],["لي جنة في هواك تسعدني","وإن يكن لي في النار مرتفق",54,"ق",1,0],["لي جهاد لم يدره أي شخص","لاحتفاظي بروح قومي وذاتي",55,"ت",2,1],["لي جارة قد حرت في أمرها","ودلها الممقوت أو كبرها",56,"ر",3,1],["لي جسمٌ فيه حساسيةٌ","يرويه الفن وينجعه",57,"ع",2,0],["لي جانب لحبيبي هين أَبداً","وَجانب لعدوّي ثَمَّ لَم يَلن",58,"ن",1,0],["لي جنة يا يوم أجمع في يدي","ما شئتُ من زهر بها متبسم",59,"م",1,0],["لي جَليسٌ عَجِبت كَيفَ اِستَطاعَت","هَذِهِ الأَرض وَالجِبالُ تُقلّه",60,"ل",2,1],["لِيَجرى عليهِ العدل إيجاب فعلهِ","ولن تتخطّى العدلَ أفعالُ رحمة",61,"ه",1,0],["لِيَجُر ويظلِم كيفَ شاءَ فَهكذا","هذا الورى طُرّاً وهذا الجِيلُ",62,"ل",1,0],["لِيَ جِسمٌ من خَصرِهِ وَسَقامي","هُوَ أَوهَى قُوىً وأَضعَفُ حَيلا",63,"ل",2,0],["لِيَ جَدٌّ ما مِثلُهُ قَطُّ جَدُّ","كلُّ فَضلٍ من فَضلِهِ مستَمَدُّ",64,"د",1,1],["لِيَجلو عَن بَصائِرِنا ظَلاماً","أَحاطَ بِه وَقَد عَمَّ البَلاءُ",65,"ا",2,0],["لِيَجمُلَ المَذاقُ","وَيَحلُوَ الحُراقُ",66,"ق",1,0],["لي جبُّ يوسفَ والشقا جبلٌ","جودي قلبيَ صابه الخدَر",67,"ر",1,0],["ليجزيكم بالقتل قتلا مضعفا","وما في دماء الخمس يا مال من بوا",68,"ا",1,0],["ليجز ربّك من أولي الجميل بها","وليس أحسن للصّلاح يدّخر",69,"ر",1,0],["ليجاوزا الغايات في مضمارها","في حاكي الأقدام والإدبار",70,"ر",1,0],["لي جذوةٌ بالرّوح نَشوتُها","مشبوبةٌ توقاً إلى القدسي .",71,"س",2,0],["ليجعلهم كالترك في كل حالهم","بغير دليل يستدل به الأقل",72,"ل",1,0],["ليجعل صبحك الزاهي لهاثاً","وتودع في السهاد دجىً جفونُ",73,"ن",1,0],["ليجمع النملُ شيئا من حلاوتها","ويخزن القمح مثمولا من العسلِ",74,"ل",1,0],["ليجعله انفعالا شاعريا","ويشرب من خلاياه المحِبةْ",75,"ب",2,0],["ليجرحني طورا وطورا ليهتدي","تبرّأ إيمانا وشكّا تخَطّأ",76,"ا",1,0],["