{"poems":[[9,"شاقتك من قتلة أطلالها","https://www.aldiwan.net/poem21944.html","السريع"],[5,"ليجز الله من جشم بن بكر","https://www.aldiwan.net/poem278.html",""],[0,"أيا هند لا تنكحي بوهة","https://www.aldiwan.net/poem67.html",""],[88,"هي النفس أغشى في رضاها المعاطبا","https://www.aldiwan.net/poem44814.html","الطويل"],[72,"خلفت بالقلب بيتا منك معمورا","https://www.aldiwan.net/poem18733.html","البسيط"],[72,"يا سيدا حاز المعا","https://www.aldiwan.net/poem19127.html","مجزوء الرجز"],[51,"أحب المهرجان لأن فيه","https://www.aldiwan.net/poem7934.html","الوافر"],[78,"أنا في الحب مغرم مستنيل","https://www.aldiwan.net/poem14255.html","الخفيف"],[85,"لي جدة ترأف بي","https://www.aldiwan.net/poem7998.html","مجزوء الرجز"],[28,"كم من مناد والشريفان دونه","https://www.aldiwan.net/poem5113.html","الطويل"],[28,"تظل بعينيها إلى الجبل الذي","https://www.aldiwan.net/poem5351.html","الطويل"],[28,"دعاهم مزوني فجاؤوا كأنهم","https://www.aldiwan.net/poem5352.html","الطويل"],[49,"يا راكب الغي غير متئد","https://www.aldiwan.net/poem62035.html","المنسرح"],[66,"لي جار كأنه البوم في الشك","https://www.aldiwan.net/poem38605.html","الخفيف"],[69,"أنا في الحب قانع باليسير","https://www.aldiwan.net/poem28994.html","الخفيف"],[81,"سل عن سهادي وعن سقمي وعن جلدي","https://www.aldiwan.net/poem61364.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39683","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202527","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1929","المتقارب"]],"verses":[["لَيَجعَلَنّي سُبَّةً بَعدَها","جُدِّعتَ يا عَلقَمُ مِن ناذِرِ",0,"ر",1,0],["لِيَجزِ اللَّهُ مِن جُشَمَ بنِ بَكرٍ","فَوارِسَ نَجدَةٍ خَيرَ الجَزاءِ",1,"ا",2,1],["لِيَجعَلَ في رِجلِهِ كَعبَه","حِذارَ المَنِيَّةِ أَن يُعطَبا",2,"ب",2,0],["ليجمع من أبناء يعرب شملهم","ويَقضي حقاً للمَواطن واجبا",3,"ب",2,0],["ليجبر الحسن لي قلباً مضى عمرٌ","له بحسنِ ابن فضلِ الله معمورا",4,"ر",2,0],["لي جبةٌ رفوت من","ها البعض إذ لم أرضها",5,"ه",2,0],["ليجعَلَه فداءَك إنْ رآه","فداءك أيها الغالي الفداءِ",6,"ا",2,0],["لي جُثمانُ مَن يَظُنُّ صَحيحاً","وَفُؤادي مِنَ الغَرامِ عَليلُ",7,"ل",1,0],["لي جَدَّةٌ تَرأَفُ بي","أَحنى عَلَيَّ مِن أَبي",8,"ي",1,1],["لِيَجتَرَّ مِنكُم إِن رَأى بارِزاً لَهُ","مِنَ الجِيَفِ اللائي عَلَيكُم حَظائِرُه",9,"ر",2,0],["لِيَجعَلَهُ اللَهُ الخَليفَةَ وَالَّذي","لَهُ المِنبَرُ الأَعلى عَلى كُلِّ ناطِقِ",10,"ق",1,0],["لِيَجزِيَ عَنهُم مِنهُمُ كُلَّ مُصعَبٍ","مِنَ الغادِياتِ الرائِحاتِ السَوابِقِ",11,"ق",1,0],["لَيَجرِيَنَّ البَلى عَلَينا بِما","كانَ جَرى قَبلَنا عَلى لُبَدِ",12,"د",1,0],["لِيَ جارٌ كَأَنَّهُ البومُ في الشَك","لِ وَلَكِن في عُجبِهِ فَغُرابُ",13,"ب",1,1],["ليَ جفنٌ وللوزير لواءٌ","دُعيا بالسفاح والمنصورِ",14,"ر",1,0],["لِي جُذوَةٌ في حَشَاءِ الصَّدرِ ضارِمَةٌ","حَسبِي أذَاهَا لَقَد وَضَعتُهَا بِيَدِي",15,"ي",1,0],["ليجير شعباً أو يحرّر أمّة","لا تستباح ولا يضامُ نجيبها",16,"ب",3,0],["ليجد الناشئ في الجديد","من لذة ما ليس في الترديد",17,"د",1,0],["لَيُجِدَّنَّ بِهَا مُعْجِزَةً","تُرْهِبُ الأَعْقابَ مَا النَّجْمُ ازْمهَرَّا",18,"ر",2,0],["لِيَجعَلَ الصالِحاتِ في عَقبي","باقِيَةً بِالحَميدِ عُقباهُ",19,"ا",2,0],["ليَجعَلَ اللَهُ لَها","أَطوَلَ عُمرٍ عُمُرَك",20,"ك",1,0],["لِيَجعَلَ في رِجلِهِ كَعبَها","حِذارَ المَنِيَّةِ أَن يُعطَبا",21,"ب",2,0]]}