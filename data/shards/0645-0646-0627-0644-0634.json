{"poems":[[65,"سرت والليل يرمز بالصباح","https://www.aldiwan.net/poem46156.html","الوافر"],[37,"لعزة هاج الشوق فالدمع سافح","https://www.aldiwan.net/poem39173.html","الطويل"],[53,"دع الأجمال مرتحله","https://www.aldiwan.net/poem65935.html","مجزوء الوافر"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[31,"ألا يا اسلمي يا أم بشر على الهجر","https://www.aldiwan.net/poem6070.html","الطويل"],[87,"ضج الحجاز وضج البيت والحرم","https://www.aldiwan.net/poem63747.html","البسيط"],[45,"من الشوق والوجد المبرح أنني","https://www.aldiwan.net/poem10635.html","الطويل"],[30,"من الشأم حتى باشرت أهل بابل","https://www.aldiwan.net/poem5325.html","الطويل"],[68,"إذا لم تعني في علاك المدائح","https://www.aldiwan.net/poem41360.html","الطويل"],[71,"مرت بخدي شقيق","https://www.aldiwan.net/poem28963.html","المجتث"],[42,"لمن طلل وخيم قد عرينا","https://www.aldiwan.net/poem42308.html","الوافر"],[17,"ألا أيها الضيفُ الذي عاب سادتي","https://www.aldiwan.net/poem1202.html",""],[77,"قد أدبر الليل عنا فا حد بالإبل","https://www.aldiwan.net/poem69022.html","البسيط"],[52,"مللت مبيتي بالقرين وشاقني","https://www.aldiwan.net/poem63905.html","الطويل"],[52,"ألا من لصب عازب النوم ساهد","https://www.aldiwan.net/poem63940.html","الطويل"],[48,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[1,"من الشر والتبريح أولاد معشر","https://www.aldiwan.net/poem34000.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85595","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62233","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39657","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54899","السريع"],[92,"غازي...","https://www.poetsgate.com/ViewPoem.aspx?id=179077",""],[30,"لقد كنت أحيانا صبورا فهاجني","https://www.poetsgate.com/ViewPoem.aspx?id=16950",""],[119,"الا عذر لا كان الهوى في الهوى العذر","https://www.aldiwan.net/poem41119.html","عموديه"],[139,"عقبى الحياة لمثل هذا المنزل","https://www.aldiwan.net/poem48874.html","الكامل"],[190,"عظ النفس أن تصبو إلى شهواتها","https://www.aldiwan.net/poem44109.html","الطويل"],[211,"هجوت صريح الكاهنين وفيكم","https://www.aldiwan.net/poem27981.html","الطويل"],[275,"على الشاطىء المصري ضل فتى الشام","https://www.aldiwan.net/poem35638.html","الطويل"],[287,"بي غادة سمراء مثل الأسمر","https://www.aldiwan.net/poem32788.html","الكامل"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[327,"ألا طرقتنا بالقرينين موهنا","https://www.aldiwan.net/poem56343.html","الطويل"],[327,"ألا طال التنظر والثواء","https://www.aldiwan.net/poem56353.html","الوافر"],[376,"أرى جنبات الأرض باسمك ترجف","https://www.aldiwan.net/poem57307.html","الكامل"],[385,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[422,"رآها قد أضر بها الكلال","https://www.aldiwan.net/poem54006.html","الوافر"],[438,"هو النادي وأنت به أنادي","https://www.aldiwan.net/poem12423.html","الوافر"],[463,"أشاقك من حسناء وهنا طروقها","https://www.aldiwan.net/poem56101.html","الطويل"],[466,"ولما رأيت الخيل تهدي فقاصر","https://www.aldiwan.net/poem15431.html","الطويل"],[475,"رمى أهل نهري بابل إذ أضلهم","https://www.aldiwan.net/poem4739.html","الطويل"],[499,"من الشامة القصوى أخذنا فأصبحت","https://www.aldiwan.net/poem2027.html","الطويل"],[567,"أتحسب من حمر الشقيق خدودها","https://www.aldiwan.net/poem52860.html","الطويل"],[703,"","https://poetry.dctabudhabi.ae/diwan/poem/122952","الهزج"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48830","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38936","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59408","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50041","الهزج"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122053","الطويل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100447","الطويل"],[1993,"","https://poetry.dctabudhabi.ae/diwan/poem/199044","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27429","الطويل"],[2376,"","https://poetry.dctabudhabi.ae/diwan/poem/115238","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200762","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200686","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204795","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204702","الطويل"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102353","الطويل"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/106581",""],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71365","الوافر"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97912","المتقارب"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46873","المتقارب"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89424","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48329","الطويل"],[3663,"","https://poetry.dctabudhabi.ae/diwan/poem/111142","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59469","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135511","الطويل"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105531","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90808","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4679,"من الشهبُ المحاطة بالضبابِ","https://www.poetsgate.com/ViewPoem.aspx?id=142741",""],[4755,"لِإِيْلَافِ قَلبي","https://www.poetsgate.com/ViewPoem.aspx?id=183517",""],[4767,"أيام التكريم","https://www.poetsgate.com/ViewPoem.aspx?id=180898",""],[4829,"الملحمة اليعربيّة","https://www.poetsgate.com/ViewPoem.aspx?id=36397",""],[4869,"مغشا بدويه","https://www.poetsgate.com/ViewPoem.aspx?id=138046",""],[4869,"من جهينه إلى الاشراف","https://www.poetsgate.com/ViewPoem.aspx?id=151700",""],[4984,"فَتَلْتَ خُيُوطَ الظَّنِ","https://www.poetsgate.com/ViewPoem.aspx?id=215863",""],[5150,"منوّر ...!","https://www.poetsgate.com/ViewPoem.aspx?id=204353",""],[5351,"إليها","https://www.poetsgate.com/ViewPoem.aspx?id=202129",""],[5431,"فلسطين-حق العودة","https://www.poetsgate.com/ViewPoem.aspx?id=197949",""],[5525,"أنا النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=860",""],[402,"عش يا فريدا في شباب الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=35684",""],[5956,"البِرُّ بالوالدَيْن","https://www.poetsgate.com/ViewPoem.aspx?id=192713",""],[5997,"أعوذُ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=214253",""],[6152,"شكرا لحرفك","https://www.poetsgate.com/ViewPoem.aspx?id=206270",""],[5309,"من الشعر اشباح تعربد في الفكر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573819",""],[2220,"إذا أنا بالقرعِ الشديد لبابهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11201&r=&rc=75",""],[4222,"نصر أنار لملككم برهانه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52911&r=&rc=203",""],[2944,"حياة التشرّد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86016&r=&rc=0",""]],"verses":[["منَ الشُّمِّ الأنوفِ بَني عُوَيْفٍ","ذَوي النّخَواتِ والأُدْمِ الصِّحاحِ",0,"ح",1,0],["مِن الشُمِّ مِشرافٌ يُنيفُ بِقُرطِها","أَسيلٌ إِذا ما قُلِّدَ الحَليَ واضِحُ",1,"ح",1,0],["من الشعراءِ والعلما","ءِ أهل الألسنِ الجَدِلَهْ",2,"ل",2,0],["من الشعراء الأعذبين قريحةً","وعلّامَةٌ بحرٌ من العلم مُفْعَمُ",3,"م",1,0],["مِنَ الشُهبِ أَكتافاً تُناخُ إِذا شَتا","وَحُبَّ القُتارُ بِالمُهَنَّدَةِ البُترِ",4,"ر",1,0],["مِنَ الشَريفِ وَمِن أَعوانِهِ فَعَلَت","نُعمى الزِيادَةِ ما لا تَفعَلُ النِقَمُ",5,"م",1,0],["منَ الشوقِ والوجدِ المُبَرِّحِ أنَّني","يُمَثَّلُ لي من بعدِ لُقياكَ لُقياكا",6,"ك",2,1],["مِنَ الشَأمِ حَتّى باشَرَت أَهلَ بابِلٍ","وَأَكذَبتَ مِمّا جَمَّعوا كُلَّ عائِفِ",7,"ف",1,1],["مِنَ الشُهبِ في إِدراكِهِ الشُهبَ طامِعٌ","فَناظِرُهُ نَحوَ الكَواكِبِ طامِحُ",8,"ح",1,0],["من الشقائقِ هذا","قالتْ وشقِّ المرائرْ",9,"ر",1,0],["مِنَ الشَوقِ المُبَرِّحِ إِن شَوقي","لَهُنَّ يَكُونُ أُهوَنُهُ رَصِينا",10,"ن",2,0],["مِنَ الشَمسِ وَالأَمطارِ كانَت صِيانَةً","تَجيرُ نَواديهِم نُزولَ الغَوائِلِ",11,"ل",1,0],["من آل شيبانَ والموفين إذ عقدوا","لجار بيتهمُ في الأعصر الأول",12,"ل",1,0],["مِنَ الشَوسِ دَلّافاً لِكُلِّ كَتيبَةٍ","بِأَبيَضَ يَستَبكي عُيونَ العَوابِدِ",13,"د",1,0],["مِنَ الشَمسِ وَالرائينَ وَالريحِ وَالسَفا","كَما سُتِرَ الضَوءُ الَّذي في المَساجِدِ",14,"د",1,0],["مِنَ الشُمطِ اِعتَزَلنَ بِكُلِّ عودٍ","وَأَفنَينَ السِنينَ مُجَرَّماتِ",15,"ت",1,0],["مِنَ الشَرِّ وَالتَبريحِ أَولادُ مَعشَرٍ","كَثيرٍ وَلا يُعطونَ في حادِثٍ بَكرا",16,"ر",2,1],["من الشعر ما يَلقى الردى قبل ربه","إذا قصر المعنى المراد فما أَغنى",17,"ن",2,0],["مِنَ الشُّمُسِ العُرْبِ مِنْ ذَاتِهَا","يُدَانِينَ حَالاً ويَنْأَيْنَ حَالاَ",18,"ل",2,0],["من الشام والأرز والرافدين","وأقصى الجزيرة صحباً وآلا",19,"ل",2,0],["مِنْ آلِ شَكُّوِر الْكِرَامِ الأُولى","هُمْ نُخْبَةٌ فِي النُّخَبِ الغُّرِّ",20,"ر",1,0],["مَن الشاعرُ المستثيرُ الشجونَ","اذا هزَّت الصدرَ أشجانه",21,"ن",2,0],["مِنَ الشّأمِ حتى باشَرَتْ أهْلَ بابلٍ","وَأكْذَبْتَ مِمّا مّعُوا كلَّ عائِفِ",22,"ف",1,0],["من الشم ابناء الرفاعي من علوا","وعموا صنوف الناس بالنائل الغمر",23,"ر",1,0],["من آل شركسَ حافظ لذماره","كلِف بآيات الكتاب المنزلِ",24,"ل",1,0],["من الشهوات الموبقات إذا مشى","قليل التقى أو طاح في ظلماتها",25,"ت",3,0],["مِنَ الشُكرِ إِنَّ الشُكرَ خَيرٌ مَغَبَّةً","وَأَوفَقُ فِعلاً لِلَّذي كانَ أَصوَبا",26,"ب",2,0],["من الشامِ في طيّاتِ بُردي حملتُها","إليكَ وفي قلبٍ على الحسنِ حوّام",27,"م",1,0],["مِن آلِ شادي شادَ مُلكاً باذِخاً","كَم جامِعٍ يُعلي وَكَم مِن مِنبَرِ",28,"ر",1,0],["مِنَ الشَياطينِ يَقفو أَثَرَ مُنهَزِمِ","لِوَقعَةِ الفيلِ قَبلاً غَيرَ مُشبَهة",29,"ه",1,0],["مِنَ الشِعرِ سَمٌّ يَقتُلُ المَرءُ طُعمُهُ","كَما تَقتُلُ الصُمُّ الأَساوِدُ بِالعَض",30,"ض",1,0],["مِنَ الشُعَراءِ أَكِفّاءٌ فُحولٌ","وَفَرّاثونَ إِن نَطَقوا أَساءوا",31,"ا",1,0],["من الشعرِ ما قامَت براهينُ صدقهِ","ومنهُ حَديثٌ في سِواك يؤلفُ",32,"ف",1,0],["من الشروطِ الصمتُ والتأمُّلُ","والصبرُ والسكونُ والتمهُّلُ",33,"ل",1,0],["من الشّمِّ الشَّوامخ في المعالي","يطولُ الرَّاسيات ولا يُطال",34,"ل",1,0],["من الشعراءِ أَضحى فيك قلبي","يهيم صبابة في كل وادِ",35,"د",1,0],["مَن الشعراءُ القائمون مَقاوِمي","لديك ومَن ذا إن سكتُّ نطوقُها",36,"ق",3,0],["من الشهب ذكراً واشتهاراً ولم تكن","من الدُّهْمِ لولا مِزْبرٌ ومِداد",37,"د",1,0],["مِنَ الشامِ حَتَّى صَبَّحَتهُم جُموعُه","بِأَرضِهِم وَالمُقرَباتُ النَزائِعُ",38,"ع",1,0],["من الشامةِ القُصْوى أخَذْنا فأصبحتْ","تُلَقِّفُ أيديها بذاتِ السَّلاسِلِ",39,"ل",1,1],["منَ الشِّعرِ مَدْحٌ قَلَّ مَنْ يَستَحِقُّهُ","وصَنعةُ هَجْوٍ لَسْتُ ممَّن يُرِيدُها",40,"د",3,0],["من الشوق إلى البدر ال","ذي يطلع بالكوفه",41,"ه",1,0],["من الشرق يأتي أم من الغرب عابث","وقد عرض الود العتيد المتاخم",42,"م",1,0],["مِنَ الشّرفِ الأَعلى تَحَلَّى بِسُؤددٍ","وَمِن حُلل العَلياءِ كاسٍ وَلابسُ",43,"س",1,0],["من الشهب المسومة اللواتي","يفتن البرق والشهب الجواري",44,"ر",2,0],["من الشّرق إلى الغرب","أتى يزجي مطاياهُ",45,"ا",2,0],["مِنَ الشَّدْقَمِيَّاتِ الرَّوَاسِمِ جَسْرَة","شَدِيدٌ عَلَى قَطْعِ الفَلاَةِ مِحَالُهَا",46,"ل",3,0],["من الشدنيات النجيبات طرفها","إلى حيث قد يممتها هو طامح",47,"ح",1,0],["من الشوس سحابون كل عرمرم","يقوم لها بالفخر طول نجادها",48,"د",3,0],["من الشوق للمطلوب إذ جاء خارجاً","وسرَّ وجودُ الابِ عين حجابه",49,"ه",1,0],["من الشر ظل الناس فيها كأنهم","وقد جاء بالأخبار من لا يحيلها",50,"ه",2,0],["من الشاي والصّحف اصطباحي ولذتي","فلم أدر من أي المدامين لي سكر",51,"ر",1,0],["من الشّعر هل من مفرٍّ وملجإٍ","فها أنا أعدو وهو يعدو على إثري",52,"ي",1,1],["من الشعر لا تعجبي ان غدا","هجاء وقد كان شعر الغرام",53,"م",1,1],["من الشعب أستملي وأملي دروسه","على الكتب والنادي وحلقة مسجد",54,"د",1,0],["من الشياطين يَقفوا إِثر منهزم","وَلى الجَميع بأَشباح مشوَّهة",55,"ه",1,0],["من الشتات الكزم أنكرت مسها","وليست من البيض السباط اللطائف",56,"ف",1,0],["من الشامخين الاصل قوم فروعهم","مكرمة التنسيق عالية النظم",57,"م",1,0],["مِنَ الشُّعَرَاءِ دَمْعي في هَوَاهَا","تَهِيمُ سُيُولُهُ في كُلِّ وَادِ",58,"د",1,0],["من الشعر لكن به حمكة","تقدم كالراح للشارب",59,"ب",1,0],["مِنَ الشُّكرِ مُتصِلاً بِالخُلوصِ","مِنَ السِّحرِ مُتَّصِفاً بِالحَلالِ",60,"ل",1,0],["من الشعب الذي مرعاه عشبٌ","بلا شبع وتسقيه السقي",61,"ي",1,0],["من الشّوقِ أُهديها