{"poems":[[57,"أتيناكم وقد كنا غضابا","https://www.aldiwan.net/poem26495.html","الوافر"],[56,"سألت أبي وكان أبي خبيرا","https://www.aldiwan.net/poem27405.html","الوافر"],[29,"متى كان المنازل بالوحيد","https://www.aldiwan.net/poem5711.html","الوافر"],[29,"متى كان الخيام بذي طلوح","https://www.aldiwan.net/poem5991.html","الوافر"],[47,"علقنا بأسباب الوزير ولم نجد","https://www.aldiwan.net/poem62763.html","الطويل"],[82,"شددت على صدر الزماع حزامي","https://www.aldiwan.net/poem31296.html","الطويل"],[46,"أيوسف جئت بالعجب العجيب","https://www.aldiwan.net/poem30065.html","الوافر"],[46,"متى كان سمعي خلسة للوائم","https://www.aldiwan.net/poem30358.html","الطويل"],[48,"ألا إن الظباء لفي غرور","https://www.aldiwan.net/poem22262.html","الوافر"],[78,"نجوم في المفارق ما تغور","https://www.aldiwan.net/poem39312.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[119,"سهام هواك صائبة المرامي","https://www.aldiwan.net/poem40489.html","عموديه"],[119,"اعلل بالخيال جريح قلبي","https://www.aldiwan.net/poem40627.html","عموديه"],[131,"متى كان للقينين قين طمية","https://www.aldiwan.net/poem24204.html","الطويل"],[135,"متى كان الملوك لكم قطينا","https://www.aldiwan.net/poem23979.html","الوافر"],[139,"متى كان في دور الحياة بقية","https://www.aldiwan.net/poem48970.html","الطويل"],[189,"متى كانت الأيام تسعف بالمنى","https://www.aldiwan.net/poem14544.html","الطويل"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[203,"أرى الإنسان يطغى حين يغنى","https://www.aldiwan.net/poem45407.html","الوافر"],[234,"نأت بعد ما بان العزاء سعاد","https://www.aldiwan.net/poem51154.html","الطويل"],[333,"أراقت عليها معاني الفناء","https://www.aldiwan.net/poem54979.html","المتقارب"],[354,"متى كان للصب في مذهب الهوى","https://www.aldiwan.net/poem15502.html","المتقارب"],[371,"وحوشي أن يقال لها عتابي","https://www.aldiwan.net/poem17143.html","الوافر"],[374,"نهاري في عمر النوى كله جنح","https://www.aldiwan.net/poem4302.html","الطويل"],[382,"أراك غني الفضل تنتهر البوسا","https://www.aldiwan.net/poem59381.html","الطويل"],[382,"أرى الشيطان يرمينا بحرب","https://www.aldiwan.net/poem66941.html","الوافر"],[385,"تباعدت عن ألفي فيا حر أشجاني","https://www.aldiwan.net/poem48777.html","الطويل"],[463,"إذا عارض نحو أرض عدل","https://www.aldiwan.net/poem56076.html","المتقارب"],[463,"أشاقك من حسناء وهنا طروقها","https://www.aldiwan.net/poem56101.html","الطويل"],[482,"أضر بعيني دمعها وانسكابه","https://www.aldiwan.net/poem15358.html","الطويل"],[520,"الطويل","https://www.aldiwan.net/poem12121.html","الطويل"],[556,"على مثل هذا اليوم تحنى الرواجب","https://www.aldiwan.net/poem48099.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18525","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120050","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96028","الطويل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47160","الطويل"],[2600,"","https://poetry.dctabudhabi.ae/diwan/poem/145208","المجتث"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201662","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65175","الطويل"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28834","الطويل"],[3456,"","https://poetry.dctabudhabi.ae/diwan/poem/206005","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129389","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91885","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91703","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91283","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91440","الوافر"],[3996,"","https://poetry.dctabudhabi.ae/diwan/poem/114901","المتقارب"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103255","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83653","الوافر"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67458","المتقارب"],[382,"","https://poetry.dctabudhabi.ae/diwan/poem/112063","الطويل"],[4717,"وطيفٍ قد سقى سهدي خمارا","https://www.poetsgate.com/ViewPoem.aspx?id=199641",""],[4755,"هو الآنَ يَنهارُ.. أَو يُوشِكُ","https://www.poetsgate.com/ViewPoem.aspx?id=201066",""],[2052,"فقال الناس عند قبول بر","https://www.poetsgate.com/ViewPoem.aspx?id=189611",""],[4860,"ذاك المسى","https://www.poetsgate.com/ViewPoem.aspx?id=32390",""],[5186,"رمى النهب عن قوس الهوى رآئش التهم","https://www.poetsgate.com/ViewPoem.aspx?id=156476",""],[5271,"ليالي بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=60069",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5387,"مطاردة","https://www.poetsgate.com/ViewPoem.aspx?id=53768",""],[5431,"كثيرٌ أبا الخطاب","https://www.poetsgate.com/ViewPoem.aspx?id=204980",""],[5691,"قرارات حمقاء","https://www.poetsgate.com/ViewPoem.aspx?id=206313",""],[5758,"أَحْلَامٌ عَربيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=200513",""],[6031,"وراءَ كُما إنَّ المُصَابَ جَليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=46289",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""]],"verses":[["مَتى كانَت ظَلومُ إِذا أَتاها","كِتابٌ لا تَرُدُّ لَهُ جَوابا",0,"ب",2,0],["مَتى كانَت إِيادُ تَريسُ قَوماً","لَقَد غَضِبَ الاِلَهُ عَلى العِبادِ",1,"د",1,0],["مَتى كانَ المَنازِلُ بِالوَحيدِ","طُلولٌ مِثلُ حاشِيَةِ البُرودِ",2,"د",1,1],["مَتى كانَ الخِيامُ بِذي طُلوحٍ","سُقيتِ الغَيثَ أَيَّتُها الخِيامُ",3,"م",1,1],["مَتى كُنتَ يا خَيرَ الأَخِلّاءِ عائِداً","بِلَومِ عَلى أَلّا تَراني فَلُم سَعدا",4,"د",2,0],["متى كنتُ مختاراً على الوَصْل فُرْقةً","تُطيلُ إلى وِرْدِ اللقاءِ هيامي",5,"م",2,0],["مَتى كانَت قَوافيهِ عِيالاً","عَلى تَفسيرِ بُقراطِ الطَبيبِ",6,"ب",1,0],["مَتى كانَ سَمعي خُلسَةً لِلَّوائِمِ","وَكَيفَ صَغَت لِلعاذِلاتِ عَزائِمي",7,"م",2,1],["مَتّى كَشَّفتَ أَخلاقَ البَرايا","تَجِد ما شِئتَ مِن ظُلمٍ وَحِرجِ",8,"ج",1,0],["مَتى كذبتْ مَواعِدُها وخانَتْ","فَأوَّلُها وَآخِرُها غُرورُ",9,"ر",1,0],["متى كان صَبّاً عطوفَ الفؤاد","وهذي قصائدُه الجاحدهْ",10,"ه",1,0],["متى كان المحب صحيح حب","انام الطرف عن نصح الانام",11,"م",1,0],["متى كان الحبيب محل مدح","يطيب المدح يتسع المجال",12,"ل",1,0],["متى كان لِلْقَيْنَيْنِ قَيْنِ طَمِيَّةٍ","وقَيْنِ بَلِيٍّ مَعْدِنٌ بفران",13,"ن",1,1],["مَتى كانَ المُلوكُ لَكُم قَطينا","عَلَيَّ وِلايَةٌ صَمّاءُ مِنّي",14,"ي",1,1],["متى كان في دور الحياة بقيةٌ","تيسّرت الأسباب وانفرج الضِيقُ",15,"ق",1,1],["متى كانتِ الأيامُ تُسْعِف بالمُنَى","وروضُ الهوى غَضُّ النباتِ نَضيرُ",16,"ر",1,1],["مَتى كان حرّاً وهو مقهورُ قادرٍ","عَلى رغمهِ يُجري مقاديرهُ قَهرا",17,"ر",2,0],["مَتى كانَ شرطُ الدين جنّة أهلهِ","وَإِن أعمَلوا فِكراً به عملوا كُفرا",18,"ر",2,0],["مَتى كانَ شرطُ الدين إن قالَ قِسُّهم","لِزنجيّةٍ شَقرا يقالُ نعَم شقرا",18,"ر",2,0],["متى كانتْ جيوبكَ من نضارٍ","فقد صارتْ جنوبكَ من حديدِ",19,"د",1,0],["متى كان يوماً صخرُكم كعَليّهم","إذا عُدّ إيمان وعُدّ جهاد",20,"د",1,0],["متى كان عهدك بالراحلين","وفيهم أساةُ المريض الشفيف",21,"ف",1,0],["مَتى كانَ لِلصَبِّ في مَذهَبِ الهَوى","حَظُّ نَفسٍ فَما ذاكَ صَبُّ",22,"ب",1,1],["مَتى كانَ المَديحُ لَكُم كِفاءً","وَمَن يَعتَدُّهُ لَكُمُ وَفاءَ",23,"ا",2,0],["متى كان هذا الدهر سمحا بمثله","إلا إنه بالغدر في مثله سمح",24,"ح",1,0],["متى كنت منوسباً إليه فإنه","يقيك فلن تُلفَى على الدهر منحوسا",25,"س",2,0],["متى كان الخطا عندي شهيّاً","كرهتُ لأجله طبَّ الطبيب",26,"ب",1,0],["مَتى كلم القَلب المُشوق أَدكارَهُم","تَساوى لَدى الجُلاس سَري وَأَعلاني",27,"ن",2,0],["متى كان أمرُك لولا الشقيُّ","يُردُّ وحاشاك ممّا فعلْ",28,"ل",1,0],["متى كنتُ في شرط الأمانيّ عبدَها","فإني على شرط العفاف عتيقُها",29,"ق",3,0],["متى كَظَّهُ مِن جاحمِ الشوقِ زفرةٌ","أعدَّتْ تؤمُّ المازِمَيْنِ ركابُهُ",30,"ب",2,0],["متى كنت يا صدر الزمان بموضع","فرتبتك العليا وموضعك الصدر",31,"ر",1,0],["مَتى كُنتُمُ أَمثالَنا وَمَتى اِستَوتْ","بِنا وَبِكم في يَومِ فَخرٍ مَراتبُ",32,"ب",1,0],["متى كنت ذا قلب سليم فسلما","ودع عنك حكم العقل حيث تحكما",33,"م",2,0],["مَتى كُنتُ حَيَّي بَجيلَةَ فَاِستَمِع","فَإِنَّ لَها قَصفاً يَدَلُّ عَلى حَتفِ",34,"ف",1,0],["متى كنت مسبوقا إلى نيل سؤدد","أبت ذاك أعراق المطهة الجردِ",35,"د",1,0],["متى كانت العذال تنصح عاشقاً","متى كانت العشاق للنصح تقبل",36,"ل",1,0],["متى كَلَّ ذ وَجْهٍ جديدٍ فإنّه","على كِبَرٍ لم يتّسِمْ بكلال",37,"ل",1,0],["متى كتمت هواه","في قلبي المجروح",38,"ح",1,0],["متى كنتُ بين الناس اسمعْ حديثهم","وكل حديث النفس هدراً أضعته",39,"ت",2,1],["متى كسلت عن خدمة العلم صُحبةٌ","فخدمتهُ للعلم بالجدّ والحزم",40,"م",1,0],["مَتى كُنتُ عَدلَ الطودِ مِن آلِ مالِكٍ","وَهَل ضَرعٌ شَختٌ يُعادِلُ أَغلَبا",41,"ب",2,0],["متى كان غَزَّال له يا ابن حَوْشَبٍ","غلامٌ كعمرٍو أو كعيسى بن حاضِرِ",42,"ر",1,1],["متى كل شيء تنبت الأرض بره","حرام على داعيك إلا شعيرها",43,"ر",3,0],["متى كانَ ما شاء المهيمن واقعاً","فَسيّانِ أَن تَشقى بجدّ وَتفويت",44,"ت",1,0],["مَتى كانَ البَقاءُ إِلى فَناءٍ","وَغاياتُ المقرّ هوَ العبور",45,"ر",1,0],["مَتى كانَ اللقاء نَصيب عُمري","وَما شَيء دَهى إلا وَزالا",46,"ل",2,0],["متى كفٌّ تُمَدُّ إِلى كؤوسٍ","إِذا ما مهجةٌ فَقَدت مُناها",47,"ا",3,0],["متى كان مالُك لي مغنماً","من الدهر أن اعوزتني الكسوبُ",48,"ب",1,0],["متى كانت البحرين بعض بلادكم","فيعزل ملك لا تعد فضائله",49,"ل",2,0],["متى كانَ العدوُّ لك محبّاً","مَتى كان المجِدُّ كذي المزاحِ",50,"ح",1,0],["متى كان يعرف فيما مضى","وزيران في دولة واحده",51,"ه",1,0],["متى كنت منسوباً إليه فإنه","يقيك فلن تُلفَى على الدهر منحوسا",52,"س",2,0],["مَتَى كَانَ الْغَرَامُ دَفِينَ قَلْبٍ","تَوَلَّتْ فَضْحَهُ مُقَلٌ حَيَارَى",53,"ر",2,0],["متى كانَ لِلظُّلمِ دِينٌ؟ متى","غفَا اللّهُ عَن مَحقِ مَن يَسفكُ؟!",54,"ك",1,0],["متى كانت تخادعك العطايا","وسصبيك اللجين أو النضار",55,"ر",1,0],["متى كان الحظن جنه؟! تداعب فيني أغصاني","متى كان الحزن ملجأ..عذر ما ودي تأجيله",56,"ل",2,0],["متى كان طبع الجود عيبا وأي متى","رأى الدهر أن الحلم مجلبة الذم",57,"م",1,0],["متى كان الفرات العذب","للأحياء غسلينا؟",58,"ن",2,0],["متى كنتمو أهل لكل فضيلة","وهل لكمو ومن قوم رفعتم تكرما",59,"م",2,0],["متى كنتمو أهلا لكل فضيلة","وهل لكمو في العلم أيد لتعلما",59,"م",2,0],["متى كنتمو نصار دين محمد","متى كنتمو الأعلام للناس والكما",59,"م",2,0],["متى كان كفواً للكرام وثلبهم","لذا صار زنديقاً غوياً مجسما",60,"م",2,0],["متى كان الهوى والحب قسراً","وإرغاماً وإكراهاً أجبني",61,"ن",2,0],["متى كان نمل الأرض يرقى لنجمها؟!!","يعيشُ بأبعاد السطوح ويقبرُ",62,"ر",1,0],["متى كانَ للشُّذّاذِ مثْقالُ ذرَّةٍ","منَ الرَّمْلِ فيها خضَّبوهُ مَذابِحا ؟",63,"ح",2,0],["مَتى كانَ شعري في الشَّمالِ قدَاسةٌ","سيبعَثُني \"شنْقيطُ\" شعْري نبِيَّا",64,"ي",2,0],["متى كُلِّفَ الأَمواتُ في عَرْصَةِ البِلَى","وكانَ لأَصْحَابِ القُبُورِ رَسُولُ",65,"ل",1,0],["متى كان عيش الحرِّ إلا مرارة","يذوق لظاها شدة وتناميا",66,"ي",2,0]]}