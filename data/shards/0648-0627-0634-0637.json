{"poems":[[13,"وبالشعب إذ سدت بجيلة فجه","https://www.aldiwan.net/poem2213.html","الطويل"],[264,"منك الكتاب يا علي","https://www.aldiwan.net/poem35796.html","مجزوء الرجز"],[264,"قم نحو حماه وانصرف","https://www.aldiwan.net/poem35942.html","المتدارك"],[563,"إن الخريف هو الربيع الثاني","https://www.aldiwan.net/poem33745.html","الكامل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78127","المتدارك"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118786","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85114","السريع"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85080","الكامل"],[4702,"الصحبة اللي غرت القلب","https://www.poetsgate.com/ViewPoem.aspx?id=155197",""],[5190,"آخر فرصة","https://www.poetsgate.com/ViewPoem.aspx?id=76954",""]],"verses":[["وَأَشطَأَ غُنمَ الحَيِّ مُرَّةُ بَعدَما","حَوَتهُ إِلَيهِ كَفُّهُ وَالأَنامِلُ",0,"ل",1,0],["واشطح وعربد هائماً","لا تستمع للعذَّل",1,"ل",1,0],["واشطح واشرح ما تشهدُه","في مجلاه وانعت وصف",2,"ف",1,0],["واشطح على الناي الرخيم فإنك ال","ناي الرخيم بكف فرد داني",3,"ن",2,0],["وَاِشطَح فَهُنا طابَ الشَطحُ","وَهَوى الغادات هُوَ الريحُ",4,"ح",1,0],["واشطح على سائر النساك إن عذلوا","وقل لن لام من عجمٍ ومن عربِ",5,"ب",1,0],["واشطح به ما بين بان الحمى","وارغم به أنف العذول الجهول",6,"ل",1,0],["واشطح معي بالذوق لا","بالعلم يا خدن الحبور",7,"ر",1,0],["واشطب على بعض البشر فالملفات","بانت حقايقهم وخابت ظنوني",8,"ن",2,0],["وأَشطُبُ قِصَّةً كَانَت لِقَلبِي","وقَلبِكِ فِي كِتَابِ الحُبِّ أُنسَا",9,"س",2,0]]}