{"poems":[[53,"حييا دون الكثيب","https://www.aldiwan.net/poem30763.html","مجزوء الرمل"],[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[77,"وفدت عقيلتك التي أهديتها","https://www.aldiwan.net/poem35726.html","الكامل"],[77,"ما أوبق الأنفس إلا الأمل","https://www.aldiwan.net/poem36351.html","الرجز"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[71,"يا ابن الكرام المطعمين إذا شتوا","https://www.aldiwan.net/poem3984.html","الكامل"],[93,"تمضي وذكرك ملء كل جنان","https://www.aldiwan.net/poem11244.html","الكامل"],[93,"طيبوا قراراً أيها الأعلام","https://www.aldiwan.net/poem11358.html","الكامل"],[93,"وفدوا يسألونني كيف حالي","https://www.aldiwan.net/poem11468.html","الخفيف"],[88,"وفدفد قاتم الأعماق متسع","https://www.aldiwan.net/poem44438.html","البسيط"],[27,"ألا زارت وأهل منى هجود","https://www.aldiwan.net/poem5731.html","الوافر"],[27,"ما بال نومك بالفراش غرارا","https://www.aldiwan.net/poem5750.html","الكامل"],[72,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[72,"يا ناسيا عهدي ولست بناسي","https://www.aldiwan.net/poem19017.html","الكامل"],[72,"عش يا محمد سالما بيت العلى","https://www.aldiwan.net/poem19457.html","الكامل"],[72,"يا آل أيوب سقتكم","https://www.aldiwan.net/poem19540.html","الكامل"],[72,"عش يا ولي الوقت تنعش في الورى","https://www.aldiwan.net/poem19654.html","الكامل"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[51,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[51,"لك الطائر الميمون والطالع السعد","https://www.aldiwan.net/poem10887.html","الطويل"],[51,"رق آب وما ترق لعبدك","https://www.aldiwan.net/poem65772.html","الخفيف"],[85,"أيها الثغر بلغت الأملا","https://www.aldiwan.net/poem7143.html","الرمل"],[85,"سألتك بالوداد أبا حسين","https://www.aldiwan.net/poem8058.html","الوافر"],[85,"سماؤك يا دنيا خداع سراب","https://www.aldiwan.net/poem62924.html","الطويل"],[85,"أعقاب في عنان الجو لاح","https://www.aldiwan.net/poem62979.html","الرمل"],[85,"هل تهبط النيرات الأرض أحيانا","https://www.aldiwan.net/poem63732.html","الطويل"],[28,"لا قوم أكرم من تميم إذ غدت","https://www.aldiwan.net/poem5479.html","الكامل"],[80,"وفدت عليك سعادة الأعوام","https://www.aldiwan.net/poem31285.html","الكامل"],[80,"ملك جديد مثل طبع المنصل","https://www.aldiwan.net/poem31324.html","الكامل"],[80,"ما للوشاة غدوا علي وراحوا","https://www.aldiwan.net/poem31513.html","الكامل"],[31,"يا نعم قد طالت مماطلتي","https://www.aldiwan.net/poem41843.html","الكامل"],[105,"صلوا إخوانكم واقضوا الذماما","https://www.aldiwan.net/poem42079.html","الوافر"],[105,"وفد البحيرة جاء طوع يقينه","https://www.aldiwan.net/poem42098.html","الكامل"],[105,"مدوا السواعد وارفعوا الأبصارا","https://www.aldiwan.net/poem43075.html","الكامل"],[105,"وفد الكنانة هل حملت رجاءها","https://www.aldiwan.net/poem43080.html","الكامل"],[105,"وفد الفارس الذي تفرق الأب","https://www.aldiwan.net/poem44008.html","الخفيف"],[105,"مرحبا بالوفد وافى من هجر","https://www.aldiwan.net/poem44012.html","المتقارب"],[105,"وفد نجران إن أردت الرشادا","https://www.aldiwan.net/poem44017.html","الوافر"],[105,"قم ودع الأوثان والأصناما","https://www.aldiwan.net/poem44047.html","الكامل"],[105,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[50,"أخشاب حقا أن دارك تزعج","https://www.aldiwan.net/poem63985.html","الطويل"],[19,"وفدت أمي وما قد ولدت","https://www.aldiwan.net/poem327.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39581","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1691","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55059","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55120","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54944","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[50,"أ\"خشاب\" حقا أن دارك تزعج","https://www.poetsgate.com/ViewPoem.aspx?id=21629",""],[90,"ليلة معها","https://www.poetsgate.com/ViewPoem.aspx?id=179141",""],[105,"وفد الكنانة هل حملت رجاءها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54980&r=&rc=150",""],[31,"يَا نُعْمُ، قَدْ طَالَتْ مُمَاطَلَتي،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19026&r=&rc=289",""],[110,"وفد الصباح وزالت الأحلاك","https://www.aldiwan.net/poem16210.html","الكامل"],[110,"وفد الربيع فقم لحث الكاس","https://www.aldiwan.net/poem16246.html","الكامل"],[119,"ما بالرزايا وما بالنأي من باس","https://www.aldiwan.net/poem492.html",""],[133,"ألما بي على الربع القديم","https://www.aldiwan.net/poem54742.html","الوافر"],[151,"يا سيد الرسل المكين مكانه","https://www.aldiwan.net/poem68545.html","الكامل"],[159,"وفد الرشيد لشرقنا فتهللا","https://www.aldiwan.net/poem4425.html","الكامل"],[159,"وفد الرشيد فعز دين محمد","https://www.aldiwan.net/poem4426.html","الكامل"],[167,"وسقت الركائب حتى أنخن","https://www.aldiwan.net/poem46823.html","المتقارب"],[208,"إما تري يا أم فروة خيلنا","https://www.aldiwan.net/poem27940.html","الكامل"],[212,"لقد طالت الساعات إني أعدها","https://www.aldiwan.net/poem46283.html","الطويل"],[212,"وفدت على بغداد والقلب موجع","https://www.aldiwan.net/poem46574.html","الطويل"],[236,"طرقت ودون طروقها","https://www.aldiwan.net/poem32143.html","مجزوء الكامل"],[276,"نادتك أندلس فلب نداءها","https://www.aldiwan.net/poem25647.html","الكامل"],[283,"عدم الإسلام معدوم المثال","https://www.aldiwan.net/poem32634.html","الرمل"],[286,"الله أكبر ساد الحق وانتصرا","https://www.aldiwan.net/poem39420.html","البسيط"],[306,"عظم الأجر عن عظيم المصاب","https://www.aldiwan.net/poem56609.html","الكامل"],[354,"بالفتح لاح لنا الهناء مبشرا","https://www.aldiwan.net/poem40350.html","الكامل"],[365,"وجد الصبا للعاشقين رسولا","https://www.aldiwan.net/poem60791.html","الكامل"],[367,"جنابك منه تستفاد الفوائد","https://www.aldiwan.net/poem18046.html","الطويل"],[404,"تحفة تهدى لمن يهوى عليا","https://www.aldiwan.net/poem33355.html","الرمل"],[417,"قام يجلوها وبرد الليل معلم","https://www.aldiwan.net/poem54025.html","الرمل"],[417,"أعلمت أي معالم ومعاهد","https://www.aldiwan.net/poem54097.html","الطويل"],[417,"وميض البرق هيج منك وجدا","https://www.aldiwan.net/poem54190.html","الوافر"],[454,"أهل الحمية والحمية أنتمو","https://www.aldiwan.net/poem61679.html","الكامل"],[459,"ما على منجد رأى ما أهمه","https://www.aldiwan.net/poem55903.html","الخفيف"],[459,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[465,"مضى صاحب الصدر الذي حازه الصدر","https://www.aldiwan.net/poem3394.html","عموديه"],[494,"ما المال إلا ما أفاد ثناء","https://www.aldiwan.net/poem67427.html","الكامل"],[515,"بقيت بقاء الدهر يا بهجة الدهر","https://www.aldiwan.net/poem20808.html","الطويل"],[516,"إن قلت قد خرست خلاخل ساقها","https://www.aldiwan.net/poem12193.html","الكامل"],[552,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[552,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[552,"ليس للقلب في السلو نصيب","https://www.aldiwan.net/poem48092.html","الخفيف"],[563,"عجب نراه فسبحوا من أبدعا","https://www.aldiwan.net/poem52756.html","الكامل"],[563,"هذه عروس الزهر نقطها الندى","https://www.aldiwan.net/poem52865.html","الكامل"],[563,"رأى أطلالهم دمعي فسالا","https://www.aldiwan.net/poem52925.html","الوافر"],[568,"عادات طيفك أن يعاود","https://www.aldiwan.net/poem69711.html","مجزوء الكامل"],[576,"قمر بات بين سحري ونحري","https://www.aldiwan.net/poem3061.html","الخفيف"]],"verses":[["وَفِداً جاءَ مِنَ الإِق","بالِ في زَورٍ غَريبِ",0,"ب",1,0],["وَفَدَيناهُمُ بِتِسعَةِ أَملا","كٍ نَدَامى أَسلابُهُم أَغلاءُ",1,"ا",2,0],["وفَدَتْ عَقيلَتُكَ التي أهْدَيْتَها","حسْناءَ تسْحَب للبَيانِ ذُيولا",2,"ل",2,1],["وَفِدْ إِلَى اللَّهِ بِهَا مُضْطَرَّة","حَتَّى تَرَى السَّيْرَ عَلَيْهَا يَسْهُلُ",3,"ل",1,0],["وَفَدَاكَ شَيْخُ الأَوْلِيَاءِ بِنَفْسِهِ","وَالنَّفْسُ آثَرُ كُلِّ شَيْءٍ يُبْذَلُ",4,"ل",1,0],["وَفَدَت عَلَيكَ وَقَد تَدانى حَتفُها","فَحَيوتها بِبَقائِها المُستَأنفِ",5,"ف",1,0],["وَفَدُوا لآخِرِ مَرَّةٍ فَتَزَوَّدُوا","أسَفاً وَأقْوَى مَرْبَعُ الضِّيفَانِ",6,"ن",1,0],["وَفِدىً لَهَا البَطَلُ الَّذِي مِنْ أَجْلِهَا","أَكْرَمْتُمُوهُ وَحَقُّهُ الإِكْرَامُ",7,"م",1,0],["وَفَدُوا يَسأَلُونَنِي كَيْفَ حَالِي","لَوْ دَرَوْا مَا جَوابُ هَذَا السؤَالِ",8,"ل",1,1],["وفدفدٍ قاتم الأعماق متسع","طويت أجوازه طيّ المكاتيب",9,"ب",1,1],["وَفَدنا حينَ أُغلِقَ دونَ تَيمٍ","شَبا الأَبوابَ وَاِنقَطَعَ الوُفودُ",10,"د",1,0],["وَفَدَ الوُفودُ إِلى المُلوكِ فَأَنجَحوا","فَذَروا الوِفادَةَ وَاِنفُخوا الأَكيارا",11,"ر",2,0],["وفدٌ وخيلٌ وآبالٌ محبرة","مدحاً قد اختلفت فيهِ العبارات",12,"ت",1,0],["وفدًى لها من بلدةٍ كم نثرةٍ","فيها لأسراب الدموع أقاسي",13,"س",2,0],["وفدًى لك المملوك بالأمس انقضى","يا سيدي وفدًى لك المملوك",14,"ك",1,0],["وفدًى لكم متسرّع أنحى على","أموالكم فأزالها وأذلَّها",15,"ل",3,0],["وفديت خطّك في الرقاع مجاوباً","بالجودِ فهو حقيقة خط الولي",16,"ي",1,0],["وفَدَاكَ الذي يرى الطَّوْلَ ذَنْباً","كان منه عن هَفْوَةٍ فيتوبُ",17,"ب",1,0],["وفداكُمْ من شانَ مِنَّتَه المن","نُ وأَزرتْ بعزِّهِ الجبروتُ",18,"ت",1,0],["وفداءٌ لما بنته مساعيْ","كُم من المجد ما بَنَتْهُ النُّحوتُ",18,"ت",1,0],["وفدتُ وآمالي ومدحي عليكما","ولا عذرَ ما لم يَغْش وفدَكما وفْدُ",19,"د",1,0],["وَفَدَت رغبتي إليك وما زل","تَ تُحيّي بالنُّجح أوجه وفْدك",20,"ك",1,0],["وفدك اللهم كن جارهمو","في بعيد البحر أو قاصى الفلا",21,"ل",2,0],["وَفَدتَ عَلى رُبوعِكَ غِبَّ نَأيٍ","وَكُنتَ البَدرَ مَأمولَ الوُفودِ",22,"د",1,0],["وَفَدتَ عَلى الفُصحى بِخَيراتِ غَيرِها","فَوَاللَهِ ما ضاقَت مَناكِبَ بابِ",23,"ب",1,0],["وَفِدى فائِزَةٍ سُمرُ القَنا","وَفِدى حارِسِها بيضُ الصِفاح",24,"ح",1,0],["وَفدَ المَمالِكِ هَزَّ النيلُ مَنكَبَهُ","لَمّا نَزَلتُم عَلى واديهِ ضيفانا",25,"ن",2,0],["وَفَدَت عَلَيهِ شُيوخُ آلِ مُجاشِعٍ","مِنهُم بِكُلِّ مُسامِحٍ مِفضالِ",26,"ل",1,0],["وَفَدَتْ عَلَيكَ سعادةُ الأعوامِ","لِعُلى يديكَ ونُصرَةِ الإسلامِ",27,"م",1,1],["وَفَدَتْ عَلَيكَ سعودُ عامٍ مُقْبِلٍ","فَتَلَقَّهُ بِسعودِ عِزٍّ مقبلِ",28,"ل",1,0],["وَفَدَ السرورُ على النفوس بشَدْوها","وتمايلتْ طَرَباً بنا الأقداحُ",29,"ح",1,0],["وَفَدَيتُ مَن كانَت مَساكِنُهُ","بِالسَهلِ أَو مُستَوعَرٌ جَبَلُه",30,"ل",2,0],["وَفَدْتُمْ في مَواكبَ من عُصورٍ","أُعِيدَ جلالُها فَبَدتُ عِظاما",31,"م",2,0],["وَفدُ البحيرةِ جاء طَوْع يَقينهِ","يَقضِي لك الحقَّ المُؤَكَّدَ شاكرا",32,"ر",2,1],["وَفدَ الكِنانَةِ وَالرَجاءُ مُعَلَّقٌ","بِكَ وَالنُفوسُ كَما عَلِمتَ حَيارى",33,"ر",2,0],["وَفدَ الكِنانَةِ هَل حَمَلتَ رَجاءَها","أَم قَد حَمَلتَ أَمانَةَ الأَوطانِ",34,"ن",1,1],["وَفَدَ الفارسُ الذي تَفرُقُ الأب","طالُ مِنهُ وتَفزعُ الفُرسانُ",35,"ن",1,1],["وفْدَ عبدِ القيسِ لا تعدِلْ بكم","ظُلمةُ الرأيِ عن النهْجِ الأغرّ",36,"ر",1,0],["وَفَدَ نَجرانَ إن أردتَ الرَّشادا","فَاتَّقِ اللهَ واتَّبِعْ ما أرادا",37,"د",2,1],["وَفَدوا كِراماً يؤمنون بربّهم","ورسولِهِ بيضَ الوجوهِ وِساما",38,"م",2,0],["وفدان هذا من ورائِكَ يرتَمي","عَجِلاً وهذا من أمامِكَ يَنسِلُ",39,"ل",1,0],["وَفَدَّينَها كَيما تَخِفَّ فَأَعرَضَت","تَحَشَّمُ مِمّا سُمنَها وَتَغَنَّجُ",40,"ج",1,0],["وَفَدَت أُمّي وَما قَد وَلَدَت","غَيرَ مَفقودٍ فَضالَ بنَ كَلَد",41,"د",1,1],["وفداءُ عرشكما المؤثَّلِ أمةٌ","أمستْ خناصرُها عليه تُوَثَّقُ",42,"ق",1,0],["وَفَدنا عَلَيكُم بِالعَناجيجِ وَالقَنا","وَأَعناقُ تَيمٍ في خُماسِيَّةٍ سُمرِ",43,"ر",1,0],["وَفِدىً لِلإِخَاءِ بَيْنَ شُعُوبِ","الضَّادِ أَغْلَى النُّفُوسِ وَالأَعْلاَقِ",44,"ق",1,0],["وَفْدَ الْحِمَى مِنْ قَادَةٍ وَأُولِي نُهىً","فَوْقَ التَّصَارِيفِ الكِبَارِ كِبَارِ",45,"ر",1,0],["وَفُدِّيتِ يَا أُخْتَ الْكِرَامِ بِمَا انْطَوَتْ","عَلَيْهِ حَنَايَا عَاذِلاَتٍ وَعُذَّلِ",46,"ل",1,0],["وَفَدْتُ وَمِصْرُ فِي الظَّلْمَاءِ","مُوِحشةٌ كمَا تدْرِي",47,"ر",2,1],["وَفَدَ الرَّبِيعُ إِلَيْكِ قَبْلَ أَوَانِهِ","يُهْدِي حِلَى جَنَّاتِهِ الْفَيْحَاءِ",48,"ا",2,1],["وَفَدَّيْنَهَا كَيْمَا تَخِفَّ فَاعْرَضَتْ","تَجَشَّمُ مِمَّا سُمْنَهَا وَتَغَنَّجُ",49,"ج",1,0],["وفداء \" محتضن \" سمحتِ به","ما تفجع الاحداثُ والغير",50,"ر",1,0],["وفد الكنانة هل حملت رجاءها","أم قد حلت أمانة الأوطان",51,"ن",1,1],["وَفَدَيْتُ مَنْ كَانَتْ مَسَاكِنُهُ","بِکلسَّهْلِ، أَوْ مُسْتَوْعَرٌ جَبَلُهْ",52,"ل",2,0],["وَفد الصَباح وَزالَت الأَحلاكُ","وَتَنصَلَت مِن نحسها الأَفلاكُ",53,"ك",1,1],["وَفَدَ الرَّبيعُ فَقُم لِحَثِّ الكاسِ","وَذَرِ المقام بِأَربُعٍ أَدراسِ",54,"س",1,1],["وفد الإمام الذي خاضت صواعقُهُ","صدورَ كلّ شريف كابن عبّاس",55,"س",1,0],["وَفَّدتني الخَرَائِدُ فِيهِ إني","مُفَدًّى غَيرُ مَقِلىِّ الهُجُومِ",56,"م",1,0],["وَفَدَت عليك ركابُ أربابِ التُّقى","والمذنبُ الخطَّاء كُفَّ عنانه",57,"ن",2,0],["وَفَدَ الرَّشيدُ لِشَرقِنا فَتَهَلَّلا","وَرَأَى بِهِ الإِسلامُ ما قَد أَمَّلا",58,"ل",2,1],["وَفَدَ الرَّشيدُ فَعَزَّ دينُ مُحَمَّدِ","وَتَقابَلَت مِنهُ نُجومُ الأَسعدِ",59,"د",1,1],["وفَدْتُ إليكَ معَ الوافدينَ","وُفودَ البِشارَةِ غِبَّ النّعِيِّ",60,"ي",1,0],["وَفدٌ أَبو قَطَنٍ حُزابَةُ مِنهُمُ","وَأَبو الغَيوثِ وَواسِعٌ وَالمُقنِعُ",61,"ع",1,0],["وفدت على قلبي فزالت كروبه","وأصبحتُ ألهو بالحياة وأنعم",62,"م",1,0],["وفدت وروحي يعصر الوجد روحه","سأنجو إذا صافيت روحي وأسلم",62,"م",1,0],["وفدتُ على بغدادَ والقلب موجعٌ","فهل فرّجت كربى وهل أبرأت دائي",63,"ي",1,1],["وَفدُ الهَناءِ فَلا خَلا","لَكَ مِن وَفودِ الحَمدِ بابُ",64,"ب",1,0],["وفَدَت على الدّار العَزيزة تَجْتَني","آلاءَهَا أوْ تَجْتَلِي آرَاءَها",65,"ا",3,0],["وَفَدَتهُ بِنُفوسٍ طائِعاتٍ","أُسُدٌ حُمسٌ وَرَبّاتُ حِجالِ",66,"ل",1,0],["وفد على نصرة الدين الحنيفي قد","لبى النداء فجاب البحر وابتدرا",67,"ر",2,0],["وَفدى اللّه مجدَك المعتلي من","ها فداء العيون بالأهدابِ",68,"ب",1,0],["وَفدت بشارات السُعود وَحَبَّذا","تِلكَ الوُفود لَها مَحامدنا قِرى",69,"ر",2,0],["وفَداكَ مَن يَفْدي برِفْدِك نَفْسَه","إذْ لا خليلَ بها يُجيرُ خَليلا",70,"ل",2,0],["وفَدْتُ عليكم بالمَدِيحِ وَكلُّكم","عليه كتابُ اللَّهِ بالمَدْحِ وَافِدُ",71,"د",1,0],["وفداه ليلة همت به","فتية تابعت الشيخ الغويا",72,"ي",2,0],["وفداك القوم أمَّا كفُّهم","فجمادٌ ونداهم فمحرَّم",73,"م",1,0],["وفدت عليك مع الخلوص قصيدة","ولأنت أوَّل مكرم للوافد",74,"د",1,0],["وَفَدَّتْكَ الأماجد والأعالي","ومثلك في الأماجد من يُفدَّى",75,"د",2,0],["وفدوا عليكم تحت راية حُبِّهم","وولائهم متبتلين وَأحرمُوا",76,"م",3,0],["وفَدَى تُربَ أخمَصَيْك بعيني","ه أصمُّ الأذْنين إن سِيلَ أكمَهْ",77,"م",2,0],["وفَدَاك كلُّ محافزٍ حسداً","جاريتَه ففلَجت بالخَصْلِ",78,"ل",1,0],["وفدته أيامٌ تعدُّ كثيرةٌ","تصافح في لباتها النصل والنصر",79,"ر",1,0],["وَفَدَيتَ مِن أَسرِ العَدُوِّ مَعاشِراً","لَولاكَ ما عَرَفوا الزَمانَ فِداءَ",80,"ا",2,0],["وفَدّتْ مُحيّاكَ النُجومُ بشَمسِها","ولا زِلْتَ منها تَجتَني هالةَ البَدْرِ",81,"ر",1,0],["وفد إليك وطالبون ودائعاً","قيدت ما جهلوه من إطلاقها",82,"ق",3,0],["وفديتُ عِرْضِي من لئامِ عشيرتي","بنزاهتِي عن سَيِّئِي وعزُوفِي",83,"ف",2,0],["وفَدَتْ وقد آلتْ بأنّ ضياءَها","ما يمّحي وَعطاءها لم يرجعِ",84,"ع",1,0],["وَفِداكم مِنَ الأَذاة رجالٌ","دَنِساتٌ ذيولهم والجيوبُ",85,"ب",1,0],["وَفْدٌ جميلُ الوجهِ أبهَجَ مَنظراً","ضُربَتْ بشائِرُهُ فأبهَجَ مَسمَعا",86,"ع",2,0],["وَفَدَتْ إليكَ قصيدةٌ خَيَّرتُها","فتَخيَّرتْ دُرَّ الجَوابِ مُقلَّدا",87,"د",2,0],["وَفَدْنا بالقريضِ على ثَناهُ","نُطاوِلُهُ فَقَصَّرنا وطالا",88,"ل",2,0],["وَفَدَتْكَ نفسي والأنا","مُ وكلُّ مُطَّرِفٍ وَتَالِدْ",89,"د",1,0],["وفَدى مَنزلاً على النيل فَرْداً","كُلُّ ربعٍ لآلِ ميّةَ قَفْرِ",90,"ر",1,0]]}