{"poems":[[53,"لا تخش من لا يقتنيك الأسى","https://www.aldiwan.net/poem61848.html","السريع"],[53,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[53,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[81,"يا أصبحي اِهنأ فكم نعمة","https://www.aldiwan.net/poem29560.html","السريع"],[87,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[70,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55163","البسيط"],[92,"البادية في إيران","https://www.poetsgate.com/ViewPoem.aspx?id=179050",""],[159,"لما تحققت ودي","https://www.aldiwan.net/poem55705.html","المجتث"],[287,"لي غريم لازم وهو الغرام","https://www.aldiwan.net/poem32465.html","الرمل"],[382,"من مشرق العين أو من مغرب الدمع","https://www.aldiwan.net/poem59339.html","البسيط"],[398,"يا أصفهان سقيت الغيث من كثب","https://www.aldiwan.net/poem53397.html","البسيط"],[398,"ما بال علوى لا ترد جوابي","https://www.aldiwan.net/poem53671.html","الكامل"],[505,"أزعج الليل الندامى","https://www.aldiwan.net/poem37800.html","مجزوء الرمل"],[563,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/107325","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80185","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136098","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79875","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77786","الرجز"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67197","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137466",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93898","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94187","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93867","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93792","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112318","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62894","الخفيف"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126980","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132110","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133256","البسيط"],[4699,"اعتذار للحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=153984",""],[5045,"مشاعر مستقيه من شعور","https://www.poetsgate.com/ViewPoem.aspx?id=184831",""],[5277,"ذاكرةُ النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=186653",""],[5277,"يا أصبحَ الوجهِ","https://www.poetsgate.com/ViewPoem.aspx?id=193727",""],[5277,"بؤسى","https://www.poetsgate.com/ViewPoem.aspx?id=205255",""],[5376,"ذاك دمعي في مدامي فاشربي","https://www.poetsgate.com/ViewPoem.aspx?id=191881",""],[5409,"تحولت بعدك الأرياف والمدن","https://www.poetsgate.com/ViewPoem.aspx?id=155486",""],[5596,"نغزى وسحرا","https://www.poetsgate.com/ViewPoem.aspx?id=206186",""],[2678,"بعلاك بدر المجد أضحى ينجلى","https://www.poetsgate.com/ViewPoem.aspx?id=167475",""],[5764,"الاصدقاء الثلاثه","https://www.poetsgate.com/ViewPoem.aspx?id=175121",""],[5969,"أنثى من روحي أفديها","https://www.poetsgate.com/ViewPoem.aspx?id=198928",""],[6038,"الاقصى","https://www.poetsgate.com/ViewPoem.aspx?id=27219",""],[5309,"يا اصدقائي الألى املت نصرتهم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573611",""]],"verses":[["يا أصدق الناس إذا ما أبى","وأكذب الناس إذا ما وَعَدْ",0,"د",1,0],["يا أصلم الكُوش هاكَ ضَامِنَةً","جدعَ أنوفٍ وصلم أكواش",1,"ش",1,0],["يا أصبغيّ المُلك إنّ ظواهراً","أَكْسَفتها منا وإنَّ بواطنا",2,"ن",2,0],["يا أصبحي اِهنأ فكم نعمة","جاءَتك من ذي العرشِ ربّ المنن",3,"ن",1,1],["يا أصل ما قد اكتسب","من ثروة ومن تعب",4,"ب",1,0],["يا أُصَيْحَابِي تمادى بَينُنا","ولِبُعْدٍ بينَنا لم يُقْضَ طَي",5,"ي",1,0],["يَا أَصْدِقَائِي قُروا عُيوناً","وَلاَ عَدَاكُمْ رَفَاهُ بَالِ",6,"ل",1,0],["يا أصيلاً هاجَتْ الذكرى به","نسمةً أنسَتْ نسيمَ السحر",7,"ر",1,0],["يا أَصْفَقَ النَّاسِ وجهاً","يا ناقِضاً كلَّ عَهْدِ",8,"د",1,0],["يا أُصَيحابي أَمِن عَدلِ الهَوى","أَنَّني أَحمِلُ جوراً وَأُضامُ",9,"م",1,0],["يا أصل توبة فرعٍ فيك مغرسُه","والأصل من شانه يحنو على الفرع",10,"ع",1,0],["يا أَصفَهان سُقيتِ الغَيثَ من كثب","فَأَنتِ مجمعُ أَوطاري وَأَوطاني",11,"ن",2,1],["يا أَصلَ عترةِ أَحمدٍ لَولاكَ لَم","يكُ أَحمدُ المَبعوثُ ذا أَعقابِ",12,"ب",1,0],["يا أُصولِيَّ غَرامي","بحرُ دَمعي منكَ عَامَا",13,"م",2,0],["يا أصيحابي بأكناف الحمى","عللاني إن صبري فقدا",14,"د",2,0],["يا أصيحاباً بهَجر خيَّمُوا","لم أُبِن مِن بعدكم لِلضِّحك سِنّا",15,"ن",2,0],["يا أصبح الناس وجها عج علي بما","أرجو فقد سودت وجهي الخطيات",16,"ت",1,0],["يا أَصدَق الخِلانِ في حفظِ الوَلا","بَينَ المَلا يا أَلطَفَ الندمانِ",17,"ن",1,0],["يا أصولي الذين خصوا بسر الق","رب جودوا علي بالاقتراب",18,"ب",1,0],["يا أصدقَ الناس وأوفى مَن وعَد","ما أنتَ من أعطى الجميلَ واسترد",19,"د",1,1],["يا أَصل أَصليصال كل صلصال","يا بهت حالي ما تركت لي حال",20,"ل",1,0],["يا أصيداً عمَّ العوالمَ عدلُه","وغدتْ به الأيامُ حالته الطلى",21,"ل",2,0],["يا أصدق الناس ودا في محبته","وأعطر الناس في الأوصاف مختبرا",22,"ر",2,0],["يا أصيل الآباء يا نسل عرب","فاز منصور هم بحظ السعاده",23,"د",2,0],["يا آصفي العصر يا","من بالعلى اتصفت أمورك",24,"ك",1,1],["يا أصيل الجدين يا نجل طه","وسليل الصديق يا ذا الفخار",25,"ر",1,0],["يا آصفي العصر يا من قد صفت","منه يدان مواهب ومغانم",26,"م",1,0],["يا أُصَيحابي الأولى قد رَتَعُوا","في بلاد الظلم حيثُ الجور عم",27,"م",1,0],["يا أَصحَ الأنامِ رأياً وتدبي","راً ويا أَكملَ الخلائقِ عَقْلا",28,"ل",2,0],["يا أصيدا بعلاه يوم مفخره","يعزى لغر كرام فتية صيد",29,"د",1,0],["يا أصدق الخلق في وعدٍ لذي رحمٍ","لو لم تكن تنقضى الوعد المفاعيل",30,"ل",1,0],["يا أصحاب باس على الكفار ديدنهم","بعصبة الكفر تقتيل وتنكيل",31,"ل",1,0],["يا أصْفَىَ النَّاسَ وأعدَلُهُمْ","إني أخطأتُ وأعتذرُ",32,"ر",1,0],["يا أصحاب كيف أصبح لهذا الوقت تقليب الامور","مجاملة من سار قمنا كلنا ونسايرة",33,"ر",2,0],["يا أصبحَ الوجهِ ما كحلّتُ ذائقتي","إلا بشوقي..وما قاربتُ نسيانا",34,"ن",2,0],["يا أصبحَ الوجهِ من عينيك يغمرني","بِشرٌ..ويأسرني عطرٌ وتسبيحُ",35,"ح",1,1],["يا أصبحَ الوجهِ قدْ دارَ الزمانُ بنا","والظلمُ والخسفُ صارا اليومَ عنوانا",36,"ن",2,0],["يا اصيلا راح عني غائبا","فانتهينا عند شمس المغرب",37,"ب",1,0],["يا أصلب الناس عوداً كل عاجمه","منه كما قد نبا عن بريه السفن",38,"ن",1,0],["يا أصبح الناس وجهاً","قد اصبح العيش مُرّا",39,"ر",2,0],["يا آصفى المجد مالك مشبه","فيما حويت من الفخار الأكمل",40,"ل",1,0],["يا أصدقائي ثلاثتكم ، انا ابيكم","ومن دونكم لو رحلتوا يوم مابيني",41,"ن",2,0],["يا أَصْدَقَ مِنْ شِعرِ الماضي","مُدي الأَجفانَ لِأُغويها",42,"ي",3,0],["يا اصحاب الفلسفه اتركوا التنظير","عن قولة اسكت هذا مو مجالك",43,"ك",1,0],["يا أَصدِقائِي الأُلى أَمَّلتُ نُصرَتَهُم","في حُبِّ مَيٍّ فَكانَت مَيُّ مِحنَتَهُم",44,"م",1,1]]}