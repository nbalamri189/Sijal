{"poems":[[51,"لا تخش من لا يقتنيك الأسى","https://www.aldiwan.net/poem61848.html","السريع"],[51,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[51,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[79,"يا أصبحي اِهنأ فكم نعمة","https://www.aldiwan.net/poem29560.html","السريع"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55163","البسيط"],[90,"البادية في إيران","https://www.poetsgate.com/ViewPoem.aspx?id=179050",""],[153,"لما تحققت ودي","https://www.aldiwan.net/poem55705.html","المجتث"],[280,"لي غريم لازم وهو الغرام","https://www.aldiwan.net/poem32465.html","الرمل"],[374,"من مشرق العين أو من مغرب الدمع","https://www.aldiwan.net/poem59339.html","البسيط"],[390,"يا أصفهان سقيت الغيث من كثب","https://www.aldiwan.net/poem53397.html","البسيط"],[390,"ما بال علوى لا ترد جوابي","https://www.aldiwan.net/poem53671.html","الكامل"],[498,"أزعج الليل الندامى","https://www.aldiwan.net/poem37800.html","مجزوء الرمل"],[556,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"]],"verses":[["يا أصدق الناس إذا ما أبى","وأكذب الناس إذا ما وَعَدْ",0,"د",1,0],["يا أصلم الكُوش هاكَ ضَامِنَةً","جدعَ أنوفٍ وصلم أكواش",1,"ش",1,0],["يا أصبغيّ المُلك إنّ ظواهراً","أَكْسَفتها منا وإنَّ بواطنا",2,"ن",2,0],["يا أصبحي اِهنأ فكم نعمة","جاءَتك من ذي العرشِ ربّ المنن",3,"ن",1,1],["يا أصل ما قد اكتسب","من ثروة ومن تعب",4,"ب",1,0],["يا أُصَيْحَابِي تمادى بَينُنا","ولِبُعْدٍ بينَنا لم يُقْضَ طَي",5,"ي",1,0],["يَا أَصْدِقَائِي قُروا عُيوناً","وَلاَ عَدَاكُمْ رَفَاهُ بَالِ",6,"ل",1,0],["يا أصيلاً هاجَتْ الذكرى به","نسمةً أنسَتْ نسيمَ السحر",7,"ر",1,0],["يا أَصْفَقَ النَّاسِ وجهاً","يا ناقِضاً كلَّ عَهْدِ",8,"د",1,0],["يا أُصَيحابي أَمِن عَدلِ الهَوى","أَنَّني أَحمِلُ جوراً وَأُضامُ",9,"م",1,0],["يا أصل توبة فرعٍ فيك مغرسُه","والأصل من شانه يحنو على الفرع",10,"ع",1,0],["يا أَصفَهان سُقيتِ الغَيثَ من كثب","فَأَنتِ مجمعُ أَوطاري وَأَوطاني",11,"ي",1,1],["يا أَصلَ عترةِ أَحمدٍ لَولاكَ لَم","يكُ أَحمدُ المَبعوثُ ذا أَعقابِ",12,"ب",1,0],["يا أُصولِيَّ غَرامي","بحرُ دَمعي منكَ عَامَا",13,"م",2,0],["يا أصيحابي بأكناف الحمى","عللاني إن صبري فقدا",14,"د",2,0]]}