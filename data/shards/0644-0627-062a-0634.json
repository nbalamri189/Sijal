://www.aldiwan.net/poem61224.html","البسيط"],[459,"نفرها عن وردها بحاجر","https://www.aldiwan.net/poem56177.html","الرجز"],[459,"أصبت لو أحمدت أن أصيبا","https://www.aldiwan.net/poem56297.html","الرجز"],[462,"لا تشمتن بمن أسا وهوى","https://www.aldiwan.net/poem16071.html","أحذ الكامل"],[465,"ما كنت بالباكي ولا المتباكي","https://www.aldiwan.net/poem3512.html","عموديه"],[501,"حب النبي الهاشمي ديني","https://www.aldiwan.net/poem37768.html","الرجز"],[501,"لا تشوش لك سرا","https://www.aldiwan.net/poem37924.html","مجزوء الرمل"],[501,"رقمت في معارفي الأشياء","https://www.aldiwan.net/poem38098.html","الخفيف"],[530,"لا تشتغل بملبس فكل ذي","https://www.aldiwan.net/poem37214.html","الرجز"],[539,"إن عدت عاد إلى النفوس سرور","https://www.aldiwan.net/poem48150.html","عموديه"],[552,"جسيمة حملها جسيم","https://www.aldiwan.net/poem47244.html","الرجز"],[552,"حييت يا ربع اللوى من مربع","https://www.aldiwan.net/poem47702.html","الكامل"],[552,"خل من كان للجنادل جارا","https://www.aldiwan.net/poem47802.html","الخفيف"],[568,"بكرت تلوم ومثلها لك لائمه","https://www.aldiwan.net/poem69523.html","الرجز"],[568,"يا أيها الصلف المدل بحسنه","https://www.aldiwan.net/poem69737.html","الكامل"],[586,"لا تلق دهرك بالعتاب","https://www.aldiwan.net/poem1570.html",""]],"verses":[["لا تَشمِتَنَّ بِهِ الأَعادي بَعدَما","عَرَضوا مِنَ الأَحقادِ وَالأَوغامِ",0,"م",1,0],["لا تَشكُوَنَّ إِلَيَّ وَجداً بَعدَها","هَذا الَّذي جَرَّت عَلَيَّ يَداكا",1,"ك",2,0],["لا تُشعِرَنَّ النَفسَ يَأساً فَإِنَّما","يَعيشُ بِجَدٍّ حازِمٌ وَبَليدُ",2,"د",1,1],["لا تَشوبَنَّ بِحَقٍّ باطِلاً","إِنَّ في الحَقِّ لِذي الحَقِّ سَعَه",3,"ع",2,0],["لا تَشَكّي إِلَيَّ مِن أَلَمِ النِس","عِ وَلا مِن حَفاً وَلا مِن كَلالِ",4,"ل",1,0],["لا تَشَكّي إِلَيَّ وَاِنتَجِعي الأَس","وَدَ أَهلَ النَدى وَأَهلَ الفِعالِ",4,"ل",1,0],["لا تَشتَكي مِنّا وَلا","يَشكو عَواقِبَها النَديمُ",5,"م",1,0],["لا تَشتَكي سَقطَةً مِنها وَقَد رَقَصَت","بِها المَفاوِزُ حَتّى ظَهرُها حَدِبُ",6,"ب",1,0],["لا تَشْكُ للناس يوماً عُسرة الحال","وأن أدامتك في همّ وبِلبال",7,"ل",1,1],["لا تَشغَلَنّي بِأَمرِ الشامِ أَحرُسُهُ","إِنَّ الشَآمَ عَلى مَن حَلَّهُ حَرَمُ",8,"م",1,0],["لاتُشعِلَنَّ فَما يَدري بِحُرقَتِهِ","أَأَنتَ عاذِلُهُ أَم أَنتَ عاذِرُهُ",9,"ر",2,0],["لا تشتكي الجور إلاَّ من تعاندهم","ولا تذمهمُ في المحلِ جارات",10,"ت",1,0],["لا تشغلَنِّي بالعتاب فإن لي","شُغلاً بمدحك يُنْفدُ الأحقابا",11,"ب",2,0],["لا تشربَ الماءَ إلا من ذؤابتها","إذا الغمام عليها من علٍ نَضحا",12,"ح",2,0],["لا تَشمتوا واذكروا منجَى طليقكُمُ","وجوهُكُمْ يا بني العباس للعَفَر",13,"ر",1,0],["لا تَشُدَّ الأغراضَ إلا إليه","ثم أطلِقْ معاقدَ الأغراض",14,"ض",1,0],["لا تَشِم للمزن برقا","إن نأى المزن فسحقا",15,"ق",2,1],["لا تُشْقني بِعبوس وج","هك والسعادةُ منه تَنجُمْ",16,"م",1,0],["لا تَشفينَّ غليلَ صدرك بالتي","تُدوِي فليست للغليلِ بشافيه",17,"ف",3,0],["لا تَشرَبُ الخَمرَ النُجومُ وَإِن تَكُن","مَعصورَةً مِن أَنفُسِ الشُعَراءِ",18,"ا",2,0],["لا تَشقي عَلى ثَوبُكِ حُزناً","لا وَلا تَذرُفي الدُموعَ السَخينَه",19,"ن",2,0],["لا تَشكُوَنَّ الضُرَّ مِن حَشَراتِهِ","حَشَراتُ هَذا الناسِ أَقبَحُ مَنظَرا",20,"ر",2,0],["لا تَشتَرِ العَبدَ إِلّا وَالعَصا مَعَهُ","إِنَّ العَبيدَ لَأَنجاسٌ مَناكيدُ",21,"د",1,0],["لا تَشرَكُ الأَجسامَ في الهُزالِ","إِذا تَلَفَّتنَ إِلى الأَظلالِ",22,"ل",1,0],["لا تُشْمِتَنَّ الأعادي صدمةٌ وقعتْ","لي بغتةً ولصرفِ الدهر مصطَدَمُ",23,"م",1,0],["لا تَشمَتَنَّ فَإِنَّهُ","مَولى يُؤَدِّبُ عَبدَهُ",24,"د",2,0],["لا تُشعِروا مِصرَ الغليلَ ولا يكن","منكم لِمُضْطغِنٍ شِفاءُ غليلِ",25,"ل",1,0],["لا تُشمِتوا الأَعداءَ إِنَّ عُيونَهُم","نُصِبَت لَكُم في جَيئَةٍ وَذَهابِ",26,"ب",1,0],["لا تشتكِي إصبعٌ من إصبعٍ وَهَنَاً","ولا تُغايِرُها إذ تَشتكِي الألما",27,"م",2,0],["لا تَشَكَّي إِلَيَّ وَاِنتَجِعي الأَع","وَرَ رَحبَ الفِناءِ جَزلَ النَوالِ",28,"ل",1,0],["لا تَشرَبَنَّ سِواها","أَو مِن حَبيبِكَ ريقا",29,"ق",2,0],["لا تَشرَبِ الخَمرَ إِلّا","مَبزولَةً مِن قارِ",30,"ر",1,0],["لا تَشيمُ البُروقَ عَيني وَلا أَج","عَلُ إِلّا إِلى العِدى أَسفاري",31,"ر",2,0],["لا تُشْرِكَنَّ به امرأ في وَصْفِهِ","فتكونَ قد خالفْتَ كلَّ مُوَحِّدِ",32,"د",1,0],["لا تَشِنها بِالَّتي كَرِهَت","فَهيَ تَأبى دَعوَةَ النَسَبِ",33,"ب",1,0],["لا تَشرَبِ الراحاَ غَيرَ مَمزوجِ","مِن كَفِّ ظَبيٍ أَغَنَّ مَغنوجِ",34,"ج",1,1],["لا تَشرَبَنَّ وجَعفَراً في مَجلِسٍ","أَبَداً وَلا تَحمِل دَمَ الأَخَوَينِ",35,"ن",1,0],["لا تَشتَرينَ مَنِيَّتي بِهَواكُمُ","فِإِلى المَماتِ بِما لَقيتُ أَصيرُ",36,"ر",1,0],["لا تَشتَهي طُرَفَ النَعيمِ وَتَشتَهي","طَيَّ البِلادِ بِأَرحَبِيٍّ شاحِبِ",37,"ب",1,0],["لا تَشتَكي الأَينَ إِذا ما اِنتَحَت","تُهدى بِهادٍ بَعدَها قُلَّبِ",38,"ب",1,0],["لا تَشكُرَنَّ الَّذي يُوَلّيكَ عارِفَةً","حَتّى يَكونَ لِما أَولاكَ مُعتَمِدا",39,"د",2,0],["لا تَشرَبَن ماعِشتَ مِن دَمِ أَبيَضٍ","سَبِطٍ وَلا سودٍ يَلُحنَ جِعادِ",40,"د",1,0],["لا تَشكُوَنَّ فَفي الشِكايَةِ ذِلَّةٌ","وَلِتُعرَضَنَّ الخَيلُ بِالمِشوارِ",41,"ر",1,0],["لا تَشرَبَنَّ الخَمرَ فَهِيَ غَويَّةٌ","ساقَت بِأَنعامِها طَويلَ الأَبُؤسِ",42,"س",1,0],["لا تَشمَخِ الأُنُفُ الشُمُّ الَّتي رُزِقَت","ما لا يَدومُ فَما يَبقى لَها الشَمَمُ",43,"م",1,0],["لا تَشْغَلُوا أَذْهَانَكُمْ","بِحٌقوقِ شَعْبٍ تُهْتَضَمْ",44,"م",1,0],["لاَ تُشْرُقُ الشَّمْسُ إِلاَّ في مَنَائِرِهَا","وَلَيْسَ يَغْرُبُ عَنْهَا الْبَدْرُ مَا غَرُبَا",45,"ب",2,0],["لا تَشغَليني أَبَداً بَعدَها","إِلّا وَنَمّامُكِ مَنزوعُ",46,"ع",1,0],["لا تَشرَبَ الدَهرَ صِرفا","فَالصِرفُ يورِثُ حَتفا",47,"ف",2,1],["لا تَشْكُ من عَنَتِ الحَياةِ، فإِنَّما","شَكْوَى العَزِيز بِدَايَةُ الإذْلاَلِ",48,"ل",1,0],["لا تشتهي أيّ شيء","كلّ ما فيك طاو",49,"ا",2,0],["لا تشغلَنِّي بالعتاب فإن لي","شُغلاً بمدحك يُنْفذُ الأحقابا",50,"ب",2,0],["لا تشعروا مصر الغليل ولا يكن","منكم لمضطغين شفاء غليل",51,"ل",1,0],["لا تشك من قصر الحياة فربّما","أغنت إشارتها عن الإفصاح",52,"ح",1,0],["لا تشمتن بي الأعدا فقد حكموا","أني تلفت وأموري آل للعدم",53,"م",1,0],["لا تُشغِل القلبَ بالدنيا وزُخرفها","فإنَّ طالبَها مِنها عَلى خطّرِ",54,"ر",1,0],["لا تشئلنَّ عن مدى معروفه","أو تسل الوسمىَّ عن مَصابهِ",55,"ب",2,0],["لا تَشتَكي ظُلماً وَعَدلُكَ جارُها","كَلّا وَلا ظُلَماً وَأَنتَ شِهابُها",56,"ب",3,0],["لا تُشعِرَنَّ الدَهرَ أَنَّكَ جازِعٌ","مِن فِعلِهِ فَيَلَجَّ في غَدراتِهِ",57,"ت",2,0],["لا تَشتَكي جَدباً وَرَوضُكَ مُمرِعٌ","كَلّا وَلا ظَمَأً وَحَوضُكَ مُترَعُ",58,"ع",1,0],["لا تشربن نقيع السم متكلا","على عقاقر قد جربن بالعمل",59,"ل",1,0],["لا تُشْبِهُ الحَمّامُ في وَضْعِها","إلا حُمَيّا الخمرِ في طَبْعِها",60,"ع",3,1],["لا تَشكوَنَّ إلىّ وَجْدَا بعدها","هذا الذي جَرَّتْ عليك يداكا",61,"ك",2,1],["لا تشرهنّ فكم من أكلة قتلت","فالطير في الجو ترديه مناصبه",62,"ب",2,0],["لا تُشرِعي طَرْفَ السِّنان لمغرمٍ","مثلي فحسبكِ منه طَرْفٌ أحور",63,"ر",1,0],["لا تشك من صبواتي إنها قبسٌ","من نار وجهك يذكى في أهوائي",64,"ي",1,0],["لا تَشكِهِ ظالِماً فَما فَسُدَ الدَهرُ","وَلَكِن أَبناؤُهُ فَسُدوا",65,"د",3,0],["لا تشركوا بالله ربا ثانيا","سبحانه لا ينتمي لقرين",66,"ن",1,0],["لا تشن للشؤون في كلّ شأنٍ","فتسيءَ الظنون مثل الغويّ",67,"ي",1,0],["لا تشمت الأعدا به إلهي","بجاه أحمد العظيم الجاهِ",68,"ه",1,0],["لا تَشربنَّ رعاكَ اللهُ مع نفرٍ","لا ظرفَ منهم ولا لطفٌ وإيناس",69,"س",1,0],["لا تَشْمَتُوا بِيَ إنْ ذَلَلْتُ لِعِزِّها","فَهَوى الغَواني أَصْلُ كُلِّ هَوانِ",70,"ن",1,0],["لا تشكُ دهراً عندهم","ولا تكدِّر وِردَهم",71,"م",1,0],["لا تُشغل البال بماضي الزمان","ولا بآتِ العيشِ قبلَ الأوان",72,"ن",1,0],["لا تشتغل بالرزق إذ رب الورى","متكفل رزق الذي يتعلمُ",73,"م",1,0],["لا تشتر الدنيا بأخرى يا فتى","من باع نورا بالدجى فسيندمُ",73,"م",1,0],["لا تُشعِرَن قَلبَكَ حبَّ الغَنى","إِنَّ مِنَ العِصمَةِ أَلّا تَجِد",74,"د",1,1],["لا تشمتوا يا هؤلاء فاننا","قوم على رغم الزمان كرام",75,"م",1,0],["لا تشمت بي حسودي","عد لدربي منصفا",76,"ف",2,0],["لا تَشكونَّ الجَفا ما دُمت ذا سعة","فَالمال يبرئ جرحَ العاشق الدَنفِ",77,"ف",1,0],["لا تَشبها بِالماء فَالماءُ كالما","لِ رَهين الاِقذار وَالاقِذاء",78,"ا",2,0],["لا تَشكُرِ الدُنيا لِأَوَّلِ حالَةٍ","مِنها فَإِنَّ الحُكمَ عِندَ الآخِرِ",79,"ر",1,0],["لا تَشغَلِ الوَقتَ في تَسبيبِ مَسأَلَةٍ","فَلَيسَ كُلُّ عَطاياهُم لَها سَبَبُ",80,"ب",1,0],["لا تشكُ ضيقاً بليلٍ قمتَ متشحاً","ثوبَ الصلاة به إن كنتَ سهرانا",81,"ن",2,0],["لا تشهدنَّ شهادةً منقولةً","أبداً ولو سمعت بها أُذُناكا",82,"ك",2,1],["لا تشْكُ أنك مجبرٌ","فيما تراه يا فتى",83,"ا",1,0],["لا تَشتكي من عَبرةٍ ولا رَمَد","وكحلهَا السهر عسى طُول الأمد",84,"د",1,0],["لا تَشرَح الرسل وَالكُت","ب بَعض ما في الضَمير",85,"ر",1,0],["لا تشتهيها وإن هي كحلت أحداقها","لأنها كثرت أذوتها ونقناقها",86,"ق",3,0],["لا تشغلوا عن بدكم بفضوله","لا تشغلوا لا تشغلوا لا تشغلوا",87,"ل",3,0],["لا تشغلوا بالرزق عن رزاقكم","وثقوا بصدق ضمانه وتوكلوا",87,"ل",3,0],["لا تُشْعلوا غضبي فأَحلف أنَّني","متسوّل يَسْعَى وراءَ لئامِ",88,"م",1,0],["لا تَشتغِلْ بي فقَلبي عَنكَ في شُغَلِ","بما أَكابدُ من شجوٍ وأَشجانِ",89,"ن",1,0],["لا تشغل الفكر الشريف بشجْوِها","واشرح هواك لأعشق العشاق",90,"ق",1,0],["لا تَشِنْ وجهَكَ الجَمي","لَ بِفعْلٍ مُشَوَّهِ",91,"ه",1,0],["لا تشيمُ البرقَ منه خلباً","لا ولا تسأَل وبلاً من جهام",92,"م",1,0],["لا تشتكِي السَّيْرَ على أَنَّ السُّرَى","أَبادَ مَتْنَ ظهرِها والكاهِلا",93,"ل",2,0],["لا تشكُ للمخلوقِ أمراً قد قضى","عليك ربّ العرش فيما قد قضى",94,"ا",1,0],["لا تشتكي لعباً في السير أو تعباً","ولا بها الحس حتى تشتهي الشبقا",95,"ق",2,0],["لا تشتكي حُزناً فيها ولا لغبا","ولا من الدهر تضريساً ولا عضضا",96,"ض",2,0],["لا تشخروا من ودادي حين أرمقها","وحين أعشقها من دون أسماء",97,"ا",2,0],["لا تشتكيك والملالُ حظُّها","منك وأن ريعتْ بهجرِ الهاجرِ",98,"ر",1,0],["لا تشكُرنَّ من فتىً فضيلةً","وليس فيها مُعْرِقا نسيبا",99,"ب",2,0],["لا تَشْمُتنَّ بمن أسا وهَوى","واسْتكْفِ ربَّكَ سوءَ مُنْقلبهْ",100,"ب",2,1],["لا تشركنَّ بهِ سواهُ فإنهُ","ضربٌ من الإلحاد والإشراك",101,"ك",1,0],["لا تُشْغِليني بسِوى أخْبارِهِمْ","وبالسِّوى لا تُدْنِسي يَقينِي",102,"ن",2,0],["لا تُشَوِّشْ لكَ سِرًّا","كلُّ هذا الكَوْنِ زائلْ",103,"ل",1,1],["لا تُشاوِرْ يوماً نِساءً بأمرٍ","إنَّما الرَّأيُ لم ينلْهُ النِّساءُ",104,"ا",2,0],["لا تَشْتَغِلْ بمَلْبَسٍ فَكُلُّ ذِي","فَضْلٍ تَرَى أَسْمالَهُ أَسْمى لَهُ",105,"ل",2,1],["لا تُشرِقُ الدنيا وتُبهِجُ طَلعَةً","إن لم يُضِئها مِن وُجودِكَ نُورُ",106,"ر",1,0],["لا تَشكُوَنْ وغيرُك المظلومُ","كلٌّ بما لاقيتَهُ أميمُ",107,"م",1,0],["لا تَشتَكي مَعْ طولِ إدمانِ السُّرى","مَسَّ اللُّغوبِ ولا كَلالَ الظُّلَّعِ",108,"ع",1,0],["لا تشكّنَّ بالّذي