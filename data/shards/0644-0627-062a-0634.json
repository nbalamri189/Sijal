{"poems":[[53,"هي سلوة ذهبت بكل غرام","https://www.aldiwan.net/poem29797.html","الكامل"],[53,"يا قلب ليتك حين لم تدع الهوى","https://www.aldiwan.net/poem29918.html","الكامل"],[42,"لا تشعرن النفس يأسا فإنما","https://www.aldiwan.net/poem50300.html","الطويل"],[42,"ليت شعري عن خليلي ما الذي","https://www.aldiwan.net/poem50429.html","الرمل"],[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[86,"ملكت علي مذاهبي","https://www.aldiwan.net/poem68864.html","مجزوء الكامل"],[30,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[88,"لا تشك للناس يوما عسرة الحال","https://www.aldiwan.net/poem44974.html","البسيط"],[47,"أشدة ما أراه منك أم كرم","https://www.aldiwan.net/poem25155.html","البسيط"],[47,"كيف السبيل إلى طيف يزاوره","https://www.aldiwan.net/poem25289.html","البسيط"],[72,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[51,"قد كنت تبذل لي كتابك مرة","https://www.aldiwan.net/poem8293.html","الكامل"],[51,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[51,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[51,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[51,"لا تشم للمزن برقا","https://www.aldiwan.net/poem65494.html","مجزوء الرمل"],[51,"عطفا بني وهب علي","https://www.aldiwan.net/poem66309.html","مجزوء الكامل"],[51,"قد ذقت أنواع الطعوم فلم أجد","https://www.aldiwan.net/poem66731.html","البسيط"],[91,"تلك السنون الغاربات ورائي","https://www.aldiwan.net/poem8726.html","عموديه"],[91,"أنا إن أغمض الحمام جفوني","https://www.aldiwan.net/poem62792.html","عموديه"],[85,"اليوم أصعد دون قبرك منبرا","https://www.aldiwan.net/poem62866.html","الكامل"],[43,"عيد بأية حال عدت يا عيد","https://www.aldiwan.net/poem9555.html","البسيط"],[43,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[62,"يا شامتا لزمان قد تنكر لي","https://www.aldiwan.net/poem52292.html","البسيط"],[44,"أعطاك دمعك جهده","https://www.aldiwan.net/poem30269.html","مجزوء الكامل"],[105,"هتف الدليل وسار ركب النيل","https://www.aldiwan.net/poem42143.html","الكامل"],[105,"نبئت ما صنع الذين تألفوا","https://www.aldiwan.net/poem43090.html","الكامل"],[105,"يا مطعم الجيش أشبعت السيوف دما","https://www.aldiwan.net/poem44069.html","البسيط"],[22,"شكت العنتريس نصي وإدلا","https://www.aldiwan.net/poem21677.html","الخفيف"],[52,"سل بالصبوح غبوقا","https://www.aldiwan.net/poem26792.html","المجتث"],[52,"يا مسكة العطار","https://www.aldiwan.net/poem26955.html","المجتث"],[52,"أي رسم لآل هند ودار","https://www.aldiwan.net/poem27050.html","الخفيف"],[67,"أهل التقى والعلم أهل السؤدد","https://www.aldiwan.net/poem18059.html","الكامل"],[48,"عد عن رسم وعن كثب","https://www.aldiwan.net/poem10780.html","المديد"],[48,"لا تشرب الراحا غير ممزوج","https://www.aldiwan.net/poem62486.html","المنسرح"],[48,"ما في النبيذ مع المعربد لذة","https://www.aldiwan.net/poem66157.html","الطويل"],[50,"أهجرت عبدة أم عداك مسير","https://www.aldiwan.net/poem63827.html","الكامل"],[50,"خفض على عقب الزمان العاقب","https://www.aldiwan.net/poem64865.html","الكامل"],[50,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[46,"الخير كالعرفج الممطور ضرمه","https://www.aldiwan.net/poem22427.html","البسيط"],[46,"جهل مرامي أن تكون موافقي","https://www.aldiwan.net/poem22489.html","الكامل"],[46,"أنوار تحسب من سنا الأنوار","https://www.aldiwan.net/poem22703.html","الكامل"],[46,"حمى ثلاث في حميا علة","https://www.aldiwan.net/poem22841.html","الكامل"],[46,"الموت نوم طويل لا هبوب له","https://www.aldiwan.net/poem23300.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54620","البسيط"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12745","السريع"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10141","المجتث"],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[51,"قد كنتَ تبذُلُ لي كتابك مرة","https://www.poetsgate.com/ViewPoem.aspx?id=26821",""],[105,"هتف الدليل وسار ركب النيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55016&r=&rc=186",""]],"verses":[["لا تَشمِتَنَّ بِهِ الأَعادي بَعدَما","عَرَضوا مِنَ الأَحقادِ وَالأَوغامِ",0,"م",1,0],["لا تَشكُوَنَّ إِلَيَّ وَجداً بَعدَها","هَذا الَّذي جَرَّت عَلَيَّ يَداكا",1,"ك",2,0],["لا تُشعِرَنَّ النَفسَ يَأساً فَإِنَّما","يَعيشُ بِجَدٍّ حازِمٌ وَبَليدُ",2,"د",1,1],["لا تَشوبَنَّ بِحَقٍّ باطِلاً","إِنَّ في الحَقِّ لِذي الحَقِّ سَعَه",3,"ع",2,0],["لا تَشَكّي إِلَيَّ مِن أَلَمِ النِس","عِ وَلا مِن حَفاً وَلا مِن كَلالِ",4,"ل",1,0],["لا تَشَكّي إِلَيَّ وَاِنتَجِعي الأَس","وَدَ أَهلَ النَدى وَأَهلَ الفِعالِ",4,"ل",1,0],["لا تَشتَكي مِنّا وَلا","يَشكو عَواقِبَها النَديمُ",5,"م",1,0],["لا تَشتَكي سَقطَةً مِنها وَقَد رَقَصَت","بِها المَفاوِزُ حَتّى ظَهرُها حَدِبُ",6,"ب",1,0],["لا تَشْكُ للناس يوماً عُسرة الحال","وأن أدامتك في همّ وبِلبال",7,"ل",1,1],["لا تَشغَلَنّي بِأَمرِ الشامِ أَحرُسُهُ","إِنَّ الشَآمَ عَلى مَن حَلَّهُ حَرَمُ",8,"م",1,0],["لاتُشعِلَنَّ فَما يَدري بِحُرقَتِهِ","أَأَنتَ عاذِلُهُ أَم أَنتَ عاذِرُهُ",9,"ر",2,0],["لا تشتكي الجور إلاَّ من تعاندهم","ولا تذمهمُ في المحلِ جارات",10,"ت",1,0],["لا تشغلَنِّي بالعتاب فإن لي","شُغلاً بمدحك يُنْفدُ الأحقابا",11,"ب",2,0],["لا تشربَ الماءَ إلا من ذؤابتها","إذا الغمام عليها من علٍ نَضحا",12,"ح",2,0],["لا تَشمتوا واذكروا منجَى طليقكُمُ","وجوهُكُمْ يا بني العباس للعَفَر",13,"ر",1,0],["لا تَشُدَّ الأغراضَ إلا إليه","ثم أطلِقْ معاقدَ الأغراض",14,"ض",1,0],["لا تَشِم للمزن برقا","إن نأى المزن فسحقا",15,"ق",2,1],["لا تُشْقني بِعبوس وج","هك والسعادةُ منه تَنجُمْ",16,"م",1,0],["لا تَشفينَّ غليلَ صدرك بالتي","تُدوِي فليست للغليلِ بشافيه",17,"ف",3,0],["لا تَشرَبُ الخَمرَ النُجومُ وَإِن تَكُن","مَعصورَةً مِن أَنفُسِ الشُعَراءِ",18,"ا",2,0],["لا تَشقي عَلى ثَوبُكِ حُزناً","لا وَلا تَذرُفي الدُموعَ السَخينَه",19,"ن",2,0],["لا تَشكُوَنَّ الضُرَّ مِن حَشَراتِهِ","حَشَراتُ هَذا الناسِ أَقبَحُ مَنظَرا",20,"ر",2,0],["لا تَشتَرِ العَبدَ إِلّا وَالعَصا مَعَهُ","إِنَّ العَبيدَ لَأَنجاسٌ مَناكيدُ",21,"د",1,0],["لا تَشرَكُ الأَجسامَ في الهُزالِ","إِذا تَلَفَّتنَ إِلى الأَظلالِ",22,"ل",1,0],["لا تُشْمِتَنَّ الأعادي صدمةٌ وقعتْ","لي بغتةً ولصرفِ الدهر مصطَدَمُ",23,"م",1,0],["لا تَشمَتَنَّ فَإِنَّهُ","مَولى يُؤَدِّبُ عَبدَهُ",24,"د",2,0],["لا تُشعِروا مِصرَ الغليلَ ولا يكن","منكم لِمُضْطغِنٍ شِفاءُ غليلِ",25,"ل",1,0],["لا تُشمِتوا الأَعداءَ إِنَّ عُيونَهُم","نُصِبَت لَكُم في جَيئَةٍ وَذَهابِ",26,"ب",1,0],["لا تشتكِي إصبعٌ من إصبعٍ وَهَنَاً","ولا تُغايِرُها إذ تَشتكِي الألما",27,"م",2,0],["لا تَشَكَّي إِلَيَّ وَاِنتَجِعي الأَع","وَرَ رَحبَ الفِناءِ جَزلَ النَوالِ",28,"ل",1,0],["لا تَشرَبَنَّ سِواها","أَو مِن حَبيبِكَ ريقا",29,"ق",2,0],["لا تَشرَبِ الخَمرَ إِلّا","مَبزولَةً مِن قارِ",30,"ر",1,0],["لا تَشيمُ البُروقَ عَيني وَلا أَج","عَلُ إِلّا إِلى العِدى أَسفاري",31,"ر",2,0],["لا تُشْرِكَنَّ به امرأ في وَصْفِهِ","فتكونَ قد خالفْتَ كلَّ مُوَحِّدِ",32,"د",1,0],["لا تَشِنها بِالَّتي كَرِهَت","فَهيَ تَأبى دَعوَةَ النَسَبِ",33,"ب",1,0],["لا تَشرَبِ الراحاَ غَيرَ مَمزوجِ","مِن كَفِّ ظَبيٍ أَغَنَّ مَغنوجِ",34,"ج",1,1],["لا تَشرَبَنَّ وجَعفَراً في مَجلِسٍ","أَبَداً وَلا تَحمِل دَمَ الأَخَوَينِ",35,"ن",1,0],["لا تَشتَرينَ مَنِيَّتي بِهَواكُمُ","فِإِلى المَماتِ بِما لَقيتُ أَصيرُ",36,"ر",1,0],["لا تَشتَهي طُرَفَ النَعيمِ وَتَشتَهي","طَيَّ البِلادِ بِأَرحَبِيٍّ شاحِبِ",37,"ب",1,0],["لا تَشتَكي الأَينَ إِذا ما اِنتَحَت","تُهدى بِهادٍ بَعدَها قُلَّبِ",38,"ب",1,0],["لا تَشكُرَنَّ الَّذي يُوَلّيكَ عارِفَةً","حَتّى يَكونَ لِما أَولاكَ مُعتَمِدا",39,"د",2,0],["لا تَشرَبَن ماعِشتَ مِن دَمِ أَبيَضٍ","سَبِطٍ وَلا سودٍ يَلُحنَ جِعادِ",40,"د",1,0],["لا تَشكُوَنَّ فَفي الشِكايَةِ ذِلَّةٌ","وَلِتُعرَضَنَّ الخَيلُ بِالمِشوارِ",41,"ر",1,0],["لا تَشرَبَنَّ الخَمرَ فَهِيَ غَويَّةٌ","ساقَت بِأَنعامِها طَويلَ الأَبُؤسِ",42,"س",1,0],["لا تَشمَخِ الأُنُفُ الشُمُّ الَّتي رُزِقَت","ما لا يَدومُ فَما يَبقى لَها الشَمَمُ",43,"م",1,0],["لا تَشْغَلُوا أَذْهَانَكُمْ","بِحٌقوقِ شَعْبٍ تُهْتَضَمْ",44,"م",1,0],["لاَ تُشْرُقُ الشَّمْسُ إِلاَّ في مَنَائِرِهَا","وَلَيْسَ يَغْرُبُ عَنْهَا الْبَدْرُ مَا غَرُبَا",45,"ب",2,0],["لا تَشغَليني أَبَداً بَعدَها","إِلّا وَنَمّامُكِ مَنزوعُ",46,"ع",1,0],["لا تَشرَبَ الدَهرَ صِرفا","فَالصِرفُ يورِثُ حَتفا",47,"ف",2,1],["لا تَشْكُ من عَنَتِ الحَياةِ، فإِنَّما","شَكْوَى العَزِيز بِدَايَةُ الإذْلاَلِ",48,"ل",1,0],["لا تشغلَنِّي بالعتاب فإن لي","شُغلاً بمدحك يُنْفذُ الأحقابا",49,"ب",2,0],["لا تشعروا مصر الغليل ولا يكن","منكم لمضطغين شفاء غليل",50,"ل",1,0]]}