{"poems":[[87,"منك يا هاجر دائي","https://www.aldiwan.net/poem63683.html","مجزوء الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[193,"أقبل على مدح النبي مفخما","https://www.aldiwan.net/poem35104.html","الكامل"],[259,"لا تخف","https://www.aldiwan.net/poem25016.html","مجزوء الرمل"],[275,"قلت للحسناء همسا","https://www.aldiwan.net/poem35322.html","مجزوء الرمل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83320","الخفيف"],[614,"","https://poetry.dctabudhabi.ae/diwan/poem/105271","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56188","البسيط"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216644",""],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87490","الرجز"],[3362,"","https://poetry.dctabudhabi.ae/diwan/poem/31691","الخفيف"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126914","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135198","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101937","الرجز"],[4691,"أنتِ يا هيفُ شامة ٌ في فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=157675",""],[4869,"غريبه بس تتشابه","https://www.poetsgate.com/ViewPoem.aspx?id=137908",""],[4940,"نجمة عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=210432",""],[5092,"هذا ليلي","https://www.poetsgate.com/ViewPoem.aspx?id=180064",""],[5136,"صافحت ريح الصبا روض الخزامى","https://www.poetsgate.com/ViewPoem.aspx?id=121655",""],[5284,"غيث الاشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=191798",""],[5725,"يا رشيقا","https://www.poetsgate.com/ViewPoem.aspx?id=195333",""],[5725,"الهوبر والهوجل","https://www.poetsgate.com/ViewPoem.aspx?id=213857",""],[5956,"تَغْزِل العينان","https://www.poetsgate.com/ViewPoem.aspx?id=182075",""],[5956,"لو تكرمتِ أريد الزنجبيلا","https://www.poetsgate.com/ViewPoem.aspx?id=182376",""]],"verses":[["مِنكَ يا هاجِرُ دائي","وَبِكَفَّيكَ دَوائي",0,"ا",3,1],["منك يا أَيُّها الأثير بدا الكَو","ن وَفيه الوجود للأشياء",1,"ا",2,0],["مِن كيدِ أبرهة الخبيث وفيلهِ","الفيلُ أحجمَ باركاً بسبيلهِ",2,"ه",1,0],["منك يجري في عروقي","ثم يُبدي ما يُدينُ",3,"ن",1,0],["منكِ يَهوى الناسُ جسماً","وأنا أشتاقُ نَفسا",4,"س",2,0],["مِنكَ يَرجى يا سَيِّدي يا جَمال الد","دينِ وَصلَ الحِبالِ وَهيَ رَمامُ",5,"م",1,0],["من كيده أجلى لهم","شركا تردى بالغرر",6,"ر",1,0],["منكي العدا قسورٌ في الحرب ذو جلَدٍ","وفي الجدا حاتميٌّ زانه الكرمُ",7,"م",1,0],["مِنْ كيلوات الدرب اميه وستين","سباق يعذر طوله الصلب لَي لان",8,"ن",1,0],["من كيد كل حاسدٍ جفانا","يا رب فاجعل كيده في النحر",9,"ر",1,0],["مَن كَيفَما قلَّبتَهُ","اراك منهُ رَجُلا",10,"ل",2,0],["مِنْكَ يا شَمْسَنا تَعَلَّمَتِ الشَّمْ","سُ دُنُوَّ السَّنا وبُعْدَ المَنالِ",11,"ل",1,0],["منك يخشى الزمان بل لك راج","فهو ما بين خشية ورجاء",12,"ا",2,0],["منك يرجى فضلٌ ويرجى الرباح","يا جزيل العطاء يا فتّاح",13,"ح",1,1],["منك يا من حيا قد استبقاني","أنظر النور ساطعاً بالأمان",14,"ن",1,0],["من كيد كل كايد","وشر حاسد حسد",15,"د",1,0],["منْكِ يا هيفَ نبْضُهُ يتَوَهَّجْ","عِشْقُهُ كَالبحورِ شوقًا تَمَوَّجْ",16,"ج",1,1],["منّك يديني غدت للكل كتّابه","المشكله ماجفاني غير اصحابي",17,"ب",2,0],["من: كيف حال القلب حتى المنتهى","ثَمِلت على همساتك الأجواءُ",18,"ا",2,0],["منك يا ألله يا أملي","(أستمدُّ العون والمددا )",19,"د",2,0],["منك يا خير البرايا أرتجي","عن قريب نيل ما يرجو المراما",20,"م",2,0],["مِنك ياحِمصُ انطلقنا صِبْيةً","وعلى صدركِ يغفُو عُمرُنا",21,"ن",2,0],["منك يا عذب اللمى عذّبني","حرقة النار وصمت الوثنِ",22,"ن",1,0],["منك يا هوبر أو من هوجلِ","يستثار الشعر في صدر الخلي",23,"ل",2,1],["‏ ‏منكِ يا ظَبْية أوطاني حياتي","‏ ‏ ومماتي أصبحا وقفاً عليكِ",24,"ك",1,0],["‏منك يا حلوة إشباعُ ميولي","‏ ‏ فيك أخلاق تحاكي المستحيلا",25,"ل",2,0]]}