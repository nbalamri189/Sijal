{"poems":[[53,"نحمد الله حين من وأبقى","https://www.aldiwan.net/poem65511.html","الخفيف"],[94,"قد سكرنا بحبنا واكتفينا","https://www.aldiwan.net/poem38928.html","الخفيف"],[91,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[91,"افتحوا للفتى الهضيم الطريقا","https://www.aldiwan.net/poem44844.html","الخفيف"],[91,"رمت للقوم نهضة في الحياة","https://www.aldiwan.net/poem44919.html","الخفيف"],[87,"كل يوم مهرجان كللوا","https://www.aldiwan.net/poem62933.html","الرمل"],[47,"إنما الغي أن يكون رشيدا","https://www.aldiwan.net/poem63464.html","الخفيف"],[48,"عشت من أيسر حل","https://www.aldiwan.net/poem23258.html","مجزوء الرمل"],[48,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/86022","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39557","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141955","الخفيف"],[108,"الوحدة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=179293",""],[96,"ذكرى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=15593",""],[136,"فت بين الرباب في العين صابا","https://www.aldiwan.net/poem54893.html","الطويل"],[203,"أي ذنب جنيت حتى تجنى","https://www.aldiwan.net/poem45568.html","الخفيف"],[234,"أيها الدعص والقضيب الذي قابل","https://www.aldiwan.net/poem51023.html","الخفيف"],[422,"أيها الدار لقد نلت الحبورا","https://www.aldiwan.net/poem53995.html","الرمل"],[438,"أسف موثق ودمع طليق","https://www.aldiwan.net/poem12681.html","الخفيف"],[543,"أيها الأنف وداعا","https://www.aldiwan.net/poem47571.html","عموديه"],[556,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97046","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70922","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62660","الرمل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56694","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48210","الخفيف"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70315","الرمل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127399","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74050","الخفيف"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101236","الخفيف"],[3641,"","https://poetry.dctabudhabi.ae/diwan/poem/202289","الرمل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109944","الخفيف"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32417","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44898","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44904","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72789","الرمل"],[5013,"لي عزم كمرهف الحد ماض","https://www.poetsgate.com/ViewPoem.aspx?id=170968",""],[5302,"يا عجولا","https://www.poetsgate.com/ViewPoem.aspx?id=201222",""],[5561,"شيّعوا شمسي","https://www.poetsgate.com/ViewPoem.aspx?id=192737",""],[5691,"سراب المصالحة","https://www.poetsgate.com/ViewPoem.aspx?id=206735",""],[5952,"أيها الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=202282",""]],"verses":[["أيها الدهر إنه واحد النا","س فرفقاً بواحد الناس رفقا",0,"ق",2,0],["أَيُّها الدَّهْرُ أَيُّها الزَّمَنُ الجاري","إلى غيرِ وُجهةٍ وقرارِ",1,"ر",1,0],["ايها الدوح كان لي","فيك ظل قد انحسر",2,"ر",1,0],["ايها الدائسون بالرجل حقى","ليس حقي بان يداس حقيقا",3,"ق",2,0],["ايها الداعي أن شعبك ما زال","الى الماضي ويحده ذا التفات",4,"ت",1,0],["أَيُّها الدَرويشُ قُم بُثَّ الجَوى","وَاِشرَحِ الحُبَّ وَناجِ الشُهَداء",5,"ا",2,0],["أَيُّها الدَهرُ حَبَّذا أَنتَ دَهراً","قِف حَميداً وَلا تُوَلِّ حَميدا",6,"د",2,0],["أَيُّها الدُنيا لَحاكِ اللَهُ","مِن رَبَّةِ دَلِّ",7,"ل",1,0],["أيّها الدُّرّ إنّما فِضْتَ مِن بَحْ","رٍ مُخَلّى الطريقِ للجَرَيانِ",8,"ن",1,0],["ايها الدمع في سبيل مصابي","سر اذا شئت راشداً مهديا",9,"ي",2,0],["أيُّها الدهرُ حسبك الله ماذا","برجالِ الفُنون هذي المهانَه",10,"ن",2,0],["أيها الدوح دوح دمّر إني","لستُ أنسى تلكَ الليالي اليتامى",11,"م",2,0],["أيها الدهر، إننا عربٌ، لس","نا على الذَّحل نَغْمِضُ الأجفانا",12,"ن",2,0],["أيُّها الدنيا ارشفي من كأسِنا","إن عطرَ الشامِ من عطرِ السماء",13,"ا",2,0],["أيها الدهر لو تفكرتَ في دَه","رٍ بِلاَهُ انتحبَت منهُ انتِحَابا",14,"ب",2,0],["أيها الدائمُ التجني علينا","زادكَ اللهُ في تجنيكَ حسنا",15,"ن",2,0],["أيها الدِعْص والقضيب الذي قا","بَلَ بدرَ الدُّجى ببدر منيرِ",16,"ر",1,1],["أيُّها الدارُ لقد نلت الحبورا","وبَلَغْتِ اليوم مقداراً كبيرا",17,"ر",2,1],["أيها الدهرُ خذ إليكَ فما في","مَنهَلي عريضٌ ولا ترنيقُ",18,"ق",1,0],["أيها الدكانِي قُننِي","مَن شَنَى فيكَ وبَاعَا",19,"ع",2,0],["أيّها الدانِي إلينا","لا يكنْ منك النُّزوحُ",20,"ح",1,0],["أيها الدهر قد فعلت جميلاً","بدنوي من كل ظبي جميل",21,"ل",1,0],["أيها الدهر لو أطلتَ حياتي","فيك سيَّان كبْوتي وانتعاشى",22,"ش",2,0],["أيهَّا الداعي بربع قد عفا","فلقد أسمعت لو ناديت حَيّ",23,"ي",1,0],["أيها الدهر كم تطيف عليّ ال","كأس جاوزت غاية الإسكار",24,"ر",1,0],["أيها الدارُ لم تَغُلْكِ الدهورُ","زالَ عنك الأسىَ ودامَ السرورُ",25,"ر",1,1],["أَيها الدهر أَقلنِي","جُزتَ في الجَوْر الحدودا",26,"د",2,0],["أيها الدمع كنت في السجن","لا تظهر منه فما لك اليوم باد",27,"د",1,0],["أَيُّها الدهر وَالنصول تباع","كفَّ عَنّا مؤللات النصولِ",28,"ل",1,0],["أيها الدهر كف عني فقلبي","حمل هذي الخطوب لن يستطيعا",29,"ع",2,0],["أيها الداعي لقد أسمعتني","ثم ما بي عن نداكم من صمم",30,"م",1,1],["أَيُّها الدمعُ إِن تَكُن مُنجِداً لي","فاهمِ من مُقلتي بغيرِ تمادِ",31,"د",1,0],["أَيُّها الداخِلُ الثَقيلُ عَلَينا","حينَ طابَ الحَديثُ لي وَلِصَحبي",32,"ب",2,0],["أَيُّها الدَهرُ فيم ظُلمكَ لِلعا","شِقِ حَتّى في لَحظةِ الميعادِ",33,"د",1,0],["أَيُّها الدَهرُ كَم تَروحُ وَتَغدو","في رِحابِ البِلادِ تَعثو وَتُفسِدْ",34,"د",1,0],["أَيُّها الدَّهرُ زِد عُلوّاً وَكَيداً","تَر مِنَّا عَزيمةً لَيسَ تَنَهدْ",34,"د",1,0],["أيها الدستورُ خذ من خادمٍ","مدحةً يستوقفُ الطرفَ سناها",35,"ا",3,0],["أيها الدهر سوف تنظر بأسي","وترى أينا أشد خصاما",36,"م",2,0],["أيها الدائم التعجل مهلا","سوف لن تستقر حتى تجنا",37,"ن",2,0],["أيُّها الدّربُ قصيراً كنتَ ؟ أم","صرتَ في همِّ المسافاتِ مداها",38,"ا",3,0],["أيها الدائرون حول بنود الصلح","تعطيلاً ليس يخفى مبينا !",39,"ن",2,0],["أيُّها الدهر هاكَ شِعري وحَسْبيْ","قولُ قلبيْ أنْ اتَّخِذْه خليلا",40,"ل",2,0]]}