{"poems":[[83,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[51,"بدا الشيب إلا ما تداوي المواشط","https://www.aldiwan.net/poem65000.html","البسيط"],[70,"رحل الشباب ولم أنل","https://www.aldiwan.net/poem43017.html","مجزوء الكامل"],[67,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/55641","الوافر"],[51,"سقتْه ابنة ُ العَمْريِّ من خمر عينها","https://www.poetsgate.com/ViewPoem.aspx?id=29564",""],[180,"زر قبر طنوس الكريم فإنه","https://www.aldiwan.net/poem61131.html","البسيط"],[180,"زر بالكرامة قبر سجعان الذي","https://www.aldiwan.net/poem66990.html","الكامل"],[229,"ما بال أنفاس النسيم إذا سرت","https://www.aldiwan.net/poem44597.html","الكامل"],[268,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[268,"أفي دار قومي يسكن الغرباء","https://www.aldiwan.net/poem35648.html","الطويل"],[268,"قد أبهجتك بنورها وصباها","https://www.aldiwan.net/poem35687.html","الكامل"],[269,"فؤادي بربع الظاعنين أسير","https://www.aldiwan.net/poem52084.html","الطويل"],[364,"أؤدي إليكم من ضميري رسالة","https://www.aldiwan.net/poem17371.html","الطويل"],[388,"الحمد لله ذا سؤالي وذا أملى","https://www.aldiwan.net/poem54545.html","عموديه"],[447,"لا تخدعنك كثرة الزراع","https://www.aldiwan.net/poem982.html",""],[456,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[477,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[536,"أكتم مابي لو يدوم التكتم","https://www.aldiwan.net/poem47962.html","عموديه"]],"verses":[["فقلْ أرقصت منها البحيرة متنها","كما يُرقصُ المولودَ من كان لاهيا",0,"ي",2,0],["فقل أيها المُطري العلاءَ بن صاعدٍ","وإن كَثُرتْ من حاسديه المساخِطُ",1,"ط",1,0],["فَقُلِ السَلامُ عَلَيكَ يا","وَصلَ الحَبيبَةِ وَالحَبيبِ",2,"ب",1,0],["فَقُلِ السَّلامُ عليكَ يا بَحْرَ النَّدَى ال","طامِي ويا بَحْرَ العلومِ المُزْبِدِ",3,"د",1,0],["فقُلْ إذا شئْتَ في الدنيا وبهجتِها","وقُل إذا شئْتَ في السَّرّاء والجَذل",4,"ل",1,0],["فقل إني تحير فيك فكري","كذاك تحير المتفكر ونا",5,"ن",2,0],["فقل أمزجيها بالرُّضاب لعلَّه","يُسكَّنُ من سكر الهوى ويخفِّفُ",6,"ف",1,0],["فَقُلِ السَلامُ عَلى ثَراكَ وَلا تَزل","أَرَّخَتُ تَصحبك المَراحِمُ وَالرِضى",7,"ض",2,0],["فَقُلِ السَلامَ عَلى ثَراهُ مُؤرِّخاً","وَتَحلُّ جانِبَهُ المَراحِمُ وَالرِضَى",8,"ض",2,0],["فقل السلام عليك يا حرم الهدى","من مهجة بك أفلحت وتبصرت",9,"ت",1,0],["فقل أيُّها المُستذئبونَ ترقَّبوا","من العربِ الأقتالَ يوماً مُشهَّرا",10,"ر",2,0],["فَقُل أيها الكذّابُ إن كنتَ صادقاً","إِلى اللهِ تُب قد طالَ منكَ رياء",11,"ا",2,0],["فقلِ السلامُ على ثلاثة أشهرٍ","ما كان أجملها وما أحلاها",12,"ا",3,0],["فقل أَنتَ في الدارين في خربنا وَمن","يَليك صَغير سنه وَكَبير",13,"ر",1,0],["فَقُل إِن تَقُل قَد جِئتُ مِن أَرضِ بابِلٍ","صَدَقتَ وَلَكِن لَم تُعَلَّم بِها السِحرا",14,"ر",2,0],["فقل إذا طفت بالبيت العتيق وفي","مواطن الخير بالتفصيل والجمل",15,"ل",1,0],["فقل السلام على الثقافة والحج","فالجهل في زمن كهذا أجدر",16,"ر",1,0],["فقل السلامُ ومن تباريح الجوى","بعثُ القتيلِ تحيةً للقاتلِ",17,"ل",1,0],["فقل أجدى الورى نفعا","لهم من كان مقداما",18,"م",2,0],["فَقُل أى ورَبِّي إنَّهُ الحَقُّ واعتَرِف","ونفسَكَ لا تَخدَع فإِنَّك مُسلِمُ",19,"م",1,0]]}