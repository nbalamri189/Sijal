{"poems":[[85,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[90,"أجدك يا كواكب لا ترينا","https://www.aldiwan.net/poem45071.html","الوافر"],[53,"بدا الشيب إلا ما تداوي المواشط","https://www.aldiwan.net/poem65000.html","البسيط"],[72,"رحل الشباب ولم أنل","https://www.aldiwan.net/poem43017.html","مجزوء الكامل"],[69,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[77,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[53,"سقتْه ابنة ُ العَمْريِّ من خمر عينها","https://www.poetsgate.com/ViewPoem.aspx?id=29564",""],[186,"زر قبر طنوس الكريم فإنه","https://www.aldiwan.net/poem61131.html","البسيط"],[186,"زر بالكرامة قبر سجعان الذي","https://www.aldiwan.net/poem66990.html","الكامل"],[236,"ما بال أنفاس النسيم إذا سرت","https://www.aldiwan.net/poem44597.html","الكامل"],[275,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[275,"أفي دار قومي يسكن الغرباء","https://www.aldiwan.net/poem35648.html","الطويل"],[275,"قد أبهجتك بنورها وصباها","https://www.aldiwan.net/poem35687.html","الكامل"],[276,"فؤادي بربع الظاعنين أسير","https://www.aldiwan.net/poem52084.html","الطويل"],[371,"أؤدي إليكم من ضميري رسالة","https://www.aldiwan.net/poem17371.html","الطويل"],[396,"الحمد لله ذا سؤالي وذا أملى","https://www.aldiwan.net/poem54545.html","عموديه"],[454,"لا تخدعنك كثرة الزراع","https://www.aldiwan.net/poem982.html",""],[463,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[484,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[543,"أكتم مابي لو يدوم التكتم","https://www.aldiwan.net/poem47962.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83290","الطويل"],[614,"","https://poetry.dctabudhabi.ae/diwan/poem/105268","الرمل"],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102034","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86619","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137563",""],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100151","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112889","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132822","الطويل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102047","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132240","الوافر"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108447","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53142","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27709","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27455","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27926","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109408","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47163","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137140",""],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82959","الرمل"],[2900,"","https://poetry.dctabudhabi.ae/diwan/poem/102192","الرجز"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104681","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74261","الطويل"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110777","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87634","الوافر"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97910","البسيط"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97936","الوافر"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104366","المتقارب"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89388","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138592",""],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46029","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91546","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91450","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91195","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76440","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94967","الوافر"],[585,"هي الحرب فانظر كيف ومض البوارق","https://www.poetsgate.com/ViewPoem.aspx?id=161905",""],[5136,"يا شمس أفق سما المجد والجود","https://www.poetsgate.com/ViewPoem.aspx?id=121560",""],[5284,"لا تقرع الباب","https://www.poetsgate.com/ViewPoem.aspx?id=191797",""],[5612,"في يوم عيد الحج","https://www.poetsgate.com/ViewPoem.aspx?id=199230",""],[5751,"المعشوق والعاشق","https://www.poetsgate.com/ViewPoem.aspx?id=214763",""],[5809,"عين الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205336",""],[5910,"إذا ذكرتَ النَّوى","https://www.poetsgate.com/ViewPoem.aspx?id=206979",""],[6167,"لا رجعية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85486&r=&rc=15",""],[186,"قد ناح جبريل نحاس قرينته","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55839&r=&rc=102",""],[454,"لا تخدعنك كثرة الزراع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82674&r=&rc=38",""],[2220,"ألمْ ترَ أنَّ اللهَ أكرمَ أحمداً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11292&r=&rc=166",""]],"verses":[["فقلْ أرقصت منها البحيرة متنها","كما يُرقصُ المولودَ من كان لاهيا",0,"ي",2,0],["فقل، إني تحيَّر فيك فكري","كذاك تحير المتفكرونا",1,"ن",2,0],["فقل أيها المُطري العلاءَ بن صاعدٍ","وإن كَثُرتْ من حاسديه المساخِطُ",2,"ط",1,0],["فَقُلِ السَلامُ عَلَيكَ يا","وَصلَ الحَبيبَةِ وَالحَبيبِ",3,"ب",1,0],["فَقُلِ السَّلامُ عليكَ يا بَحْرَ النَّدَى ال","طامِي ويا بَحْرَ العلومِ المُزْبِدِ",4,"د",1,0],["فقُلْ إذا شئْتَ في الدنيا وبهجتِها","وقُل إذا شئْتَ في السَّرّاء والجَذل",5,"ل",1,0],["فقل أمزجيها بالرُّضاب لعلَّه","يُسكَّنُ من سكر الهوى ويخفِّفُ",6,"ف",1,0],["فَقُلِ السَلامُ عَلى ثَراكَ وَلا تَزل","أَرَّخَتُ تَصحبك المَراحِمُ وَالرِضى",7,"ض",2,0],["فَقُلِ السَلامَ عَلى ثَراهُ مُؤرِّخاً","وَتَحلُّ جانِبَهُ المَراحِمُ وَالرِضَى",8,"ض",2,0],["فقل السلام عليك يا حرم الهدى","من مهجة بك أفلحت وتبصرت",9,"ت",1,0],["فقل أيُّها المُستذئبونَ ترقَّبوا","من العربِ الأقتالَ يوماً مُشهَّرا",10,"ر",2,0],["فَقُل أيها الكذّابُ إن كنتَ صادقاً","إِلى اللهِ تُب قد طالَ منكَ رياء",11,"ا",2,0],["فقلِ السلامُ على ثلاثة أشهرٍ","ما كان أجملها وما أحلاها",12,"ا",3,0],["فقل أَنتَ في الدارين في خربنا وَمن","يَليك صَغير سنه وَكَبير",13,"ر",1,0],["فَقُل إِن تَقُل قَد جِئتُ مِن أَرضِ بابِلٍ","صَدَقتَ وَلَكِن لَم تُعَلَّم بِها السِحرا",14,"ر",2,0],["فقل إذا طفت بالبيت العتيق وفي","مواطن الخير بالتفصيل والجمل",15,"ل",1,0],["فقل السلام على الثقافة والحج","فالجهل في زمن كهذا أجدر",16,"ر",1,0],["فقل السلامُ ومن تباريح الجوى","بعثُ القتيلِ تحيةً للقاتلِ",17,"ل",1,0],["فقل أجدى الورى نفعا","لهم من كان مقداما",18,"م",2,0],["فَقُل أى ورَبِّي إنَّهُ الحَقُّ واعتَرِف","ونفسَكَ لا تَخدَع فإِنَّك مُسلِمُ",19,"م",1,0],["فَقُل أَيُّ وَجدٍ في الجَوانِحِ مَحرِقٌ","عَلى أَيِّ غُصنٍ في التُرابِ رَطيبِ",20,"ب",1,0],["فقل الآن لمن يبغي الندى","ويروم الأمن من مولى العرب",21,"ب",1,0],["فقل أي شيء كان يمنع عنهم","سنا العلم أو يخفيه جد خفاء",22,"ا",2,0],["فَقُل أَنتَ لا تَثريب مِن حَيث أَنَّهُ","أَتى تائِباً لَما تَوالَت مَصائبه",23,"ب",2,0],["فقل أنا لا شيء عند القياس","وخف من سلوك سبيل الضلال",24,"ل",1,0],["فقل السلام عليكم يا سادتي","من عبد عبدكم المسيء الجاني",25,"ن",2,0],["فقل أنت في الدارين في حزبنا ومن","احبك قد ترخى عليه ستور",26,"ر",1,0],["فقل أعمروه وقل أزيدنيه","أعامراه أجليبيب إنيه",27,"ه",1,0],["فقلاو لِطَبِعي يزولَ فإنَّه","يرى لكما حَقَّ الموالي على العبد",28,"د",1,0],["فقل ابنى ها ما ترتجيه أتاك بل","مراما بما تهوى وتروى وتنجل",29,"ل",1,0],["فقل إن شئت ذو علم وعز","وقل إن شئت منسكب الأيادي",30,"د",2,0],["فقل اهديك يا أملي فؤادي","فقد نلت المنى فلك البشارة",31,"ه",1,0],["فقل أنا جار الصاحب بن محمد","وَبِتْ آمناً مما تخافُ وتجزع",32,"ع",1,0],["فقل إن له في خلقه نسَباً","وهو التقي فأنا في الكدِّ والنَصَب",33,"ب",1,0],["فقل إنه هو أو فقل ليس هو بهو","وإياك أن تبتغي لنفسك موعدا",34,"د",2,0],["فقل إلى سمرٍ شوقي إلى السمر","فإنَّ في عمري خيراً إلى عمري",35,"ي",1,0],["فقل إذا ما ادعاها غيره سفهاً","يا ليت شعري على دعواك من شهدا",36,"د",2,0],["فقل السّلام عليه يا ابْنَ المصطفى","بابن الختِام الغَوْثِ في أيّامه",37,"م",2,0],["فقل أي قلب ما تقطع لوعةً","ومن لم تسل حزناً مدامعه الحمر",38,"ر",1,0],["فقلِ الحَقَّ وَإِن قي","لَ لك الحقُّ ثَقيل",39,"ل",1,0],["فقل إني بعده","ودمع عينيه همى",40,"م",2,0],["فقل أنت في الدارين من حزبنا ومن","إليك التجاه نؤوه ونجير",41,"ر",1,0],["فَقُل أَي هضب قَبله ساخ في الثَرى","وَأَي عباب قَبله ضمه الترب",42,"ب",1,0],["فقل إن مضى الفضل بن يحيى بن خالد","ليحيى بن حجى إن فضلك خالد",43,"د",1,0],["فقل ارّخ يَعيش بخير حِرزٍ","وَيدعون اسمَهُ عمّا نيلا",44,"ل",2,0],["فقل إذن علها من قبل عاقلةٌ","وعلَّ من خلقَ النسيان ينسيها",45,"ي",3,0],["فقل إنا وإن كنا خلقنا","من العلقات واكتمل الوليد",46,"د",1,0],["فقل ان نزلت بمولى ثواه","أبا حسن أنت عين الإله",47,"ه",1,0],["فقلائد العقيان من ألفاظها","حلَّت لأخوان الصفا آذانها",48,"ن",3,0],["فقل ابا حسن ياغوث من نزلت","به النوائب والكشاف للغمم",49,"م",1,0],["فقل البلية أرخوا أَو قل قَضى","نَجل الأَميرِ نَجيب عَبد القادِر",50,"ر",1,0],["فقل السلامُ عَلى السلُوِّ وَمرحباً","بِالوَجدِ وَالتسهادِ وَالأَشجان",51,"ن",1,0],["فَقل السلام عَلى الشَبا","ب وَطيبِ أَيام الشَراب",52,"ب",1,0],["فَقل العفاء عَلى العَنا","فليمسِ ضدٌّ في لَهف",53,"ف",1,0],["فقل أَيُّها الانسان هل انت ناقم","وَهَل أَنتَ راضي كيفما كنت في خسر",54,"ر",1,0],["فقل الآن لي صريحاً مناكا","كم نهاراً تبغي لدفن فتاكا",55,"ك",2,0],["فَقُل آياسُ صَخراً هائِلاً وَعَلى","أفِكلِسِ خِلٍّ سَرفيدونِهِم طَرَحا",56,"ح",2,0],["فقلْ أَيما عُرْفٍ حداكَ على النوى","ومن ضَلةٍ أَنْ تطلبَ العُرْفَ بالنكرِ",57,"ر",1,0],["فقل إن شئتَ ما التاريخ تدري","بنَصر اللَه شُيّدَتِ المباني",58,"ن",2,0],["فقل أين أنت الآن يا كل لفظةٍ","من الحزن من ماضٍ حواك ولاحق",59,"ق",1,0],["فقل أذنت على اسم الله في سعة","وفي أمان وعيش ناضر رود",60,"د",1,0],["فَقُلْ أُهَيْلُكِ قَدْ غابُوا وقدْ فَنِيَتْ","دُمُوعُهُمْ أَسَفًا، لاتَحْمِلِي الآنا",61,"ن",2,0],["فقُلِ السَْلامُ عَلَيْكَ يا بَدْرَ الدُّجَى","في بُقْعَةٍ مَبْروكَةِ الجَنَباتِ",62,"ت",1,0],["فَقُلْ أبا الشعرِ صَداكَ المدى","وكلُ عصرٍ من مداك السحيقْ",63,"ق",1,0],["فقُلْ إن شئتَ تقرضُهُ عيونا","فَدونَ العينِ يغدو الشعرُ شرّا",64,"ر",2,0],["فقل أفيقوا فليس مِن شِيَمي","صبرٌ على الظُّلمِ لو ألمَّ بِنا",65,"ن",2,0],["فقل إنى ولدتُ على انطلاقٍ","بغيرِ كِفاحِ نفسى لنْ أُفاخِرْ",66,"ر",1,0],["فقلا تاريخنا كفوا فقيدتكم","كريمة في الأعالي عند مولاها",67,"ا",3,0],["فقل السلام على الثقافة والحجا","فالجهل في زمن كهذا أجدر",68,"ر",1,0],["فقلْ إنه هوَ أو فقلُ ليسَ هو بهوٌ","وإياكَ أن تبغي لنفسكَ موعدا",69,"د",2,0]]}