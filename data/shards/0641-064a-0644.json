ذ شبت ألا تعوجا","https://www.aldiwan.net/poem50197.html","الطويل"],[416,"ما قضى إلا على الصب العميد","https://www.aldiwan.net/poem54016.html","الرمل"],[416,"هذه الدار ما عسى أن تكونا","https://www.aldiwan.net/poem54080.html","الخفيف"],[416,"هذه يا صاح أوقات الهنا","https://www.aldiwan.net/poem54091.html","الرمل"],[416,"هل تركتم غير الجوى لفؤادي","https://www.aldiwan.net/poem54177.html","الخفيف"],[416,"يا ليلة في آخر الشهر","https://www.aldiwan.net/poem54175.html","أحذ الكامل"],[429,"يرق بدا ام ثغرك الجوهر","https://www.aldiwan.net/poem41418.html","السريع"],[432,"كم مرضت صبوتي فجاءت","https://www.aldiwan.net/poem12521.html","مخلع البسيط"],[439,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[439,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[441,"أقنع بما أنا فيه منه أقاسي","https://www.aldiwan.net/poem14374.html","الكامل"],[441,"رزء بنا حل حتى صار محلولا","https://www.aldiwan.net/poem14473.html","البسيط"],[449,"لا تخدعنك كثرة الزراع","https://www.aldiwan.net/poem982.html",""],[458,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[458,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[461,"حي نجدا وأين من مرو نجد","https://www.aldiwan.net/poem15112.html","الخفيف"],[464,"في لأذني عن كل لاح صمم","https://www.aldiwan.net/poem3159.html","عموديه"],[464,"يا من تلون عهده وتغيرا","https://www.aldiwan.net/poem3198.html","عموديه"],[464,"قلبي بذاك الخال ليس بخال","https://www.aldiwan.net/poem3230.html","عموديه"],[464,"يا من لابيض كل جفن اسود","https://www.aldiwan.net/poem3536.html","عموديه"],[468,"أغضى فآمن خائفا","https://www.aldiwan.net/poem59850.html","مجزوء الكامل"],[468,"يا رب ظمآن الوشاح","https://www.aldiwan.net/poem60285.html","مجزوء الكامل"],[477,"أعائد لي أيام نعمت بها","https://www.aldiwan.net/poem15239.html","البسيط"],[479,"ما للقريض تعاصى","https://www.aldiwan.net/poem36906.html","المجتث"],[479,"هب لي بيانك في ممدوحك الهادي","https://www.aldiwan.net/poem36957.html","البسيط"],[482,"لاح لي برق بنجد فسبا","https://www.aldiwan.net/poem24283.html","الرمل"],[486,"يشتاق قلبي إلى مليكة","https://www.aldiwan.net/poem455.html",""],[500,"قد أبصر الزمان علوى وغفا","https://www.aldiwan.net/poem37959.html","الرجز"],[515,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[515,"طرقتها والليل وحف الجناح","https://www.aldiwan.net/poem12054.html","السريع"],[515,"لا وعيون لحظها ساهر","https://www.aldiwan.net/poem12116.html","السريع"],[529,"مسامع من ناديت يا عمرو سدت","https://www.aldiwan.net/poem37501.html","الطويل"],[538,"إسألوني عما رأيت بعيني","https://www.aldiwan.net/poem47588.html","عموديه"],[538,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[551,"زارك زوار الحلم","https://www.aldiwan.net/poem47191.html","مجزوء الرجز"],[551,"قالوا الحبيبة تيمتك","https://www.aldiwan.net/poem47322.html","مجزوء الكامل"],[551,"قد كان يدرك عندكن السول","https://www.aldiwan.net/poem47333.html","الكامل"],[551,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[551,"مرت بنا بمصلى الخيف سانحة","https://www.aldiwan.net/poem47343.html","البسيط"],[551,"أرق عيني طارق","https://www.aldiwan.net/poem47360.html","مجزوء الرجز"],[551,"قل للذي يحسدنا في الهوى","https://www.aldiwan.net/poem47832.html","السريع"],[551,"بالله يا أيام يثرب عودي","https://www.aldiwan.net/poem47844.html","الكامل"],[558,"نزل الحديد فكان سيفا قاضبا","https://www.aldiwan.net/poem34972.html","الكامل"],[561,"يا رب أنت تجبر الكسيرا","https://www.aldiwan.net/poem27849.html","الرجز"],[562,"زر قبر جرجي الغلام اللاذقي سحرا","https://www.aldiwan.net/poem52534.html","البسيط"],[562,"هذا الكريم حبيب ابن الجدي على","https://www.aldiwan.net/poem52691.html","البسيط"],[567,"حي الربيع تحية المستقبل","https://www.aldiwan.net/poem69531.html","الكامل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[586,"أهلا بوجهك لا حجبت عن نظري","https://www.aldiwan.net/poem17534.html","البسيط"]],"verses":[["في لَيلَةٍ أَوعَدَت بِالبَينِ فَاِختَلَسَت","مِنَ العُيونِ بَقايا غُبَّرِ الوَسَنِ",0,"ن",1,0],["في لَيلَةٍ غابَ مَعي بَدرُها","وَحارَبَتها في الظَلامِ النُجوم",1,"م",1,0],["فَيلَقٌ جَرَّ عَلى أَر","بُقَ أَذيالَ الفَليقَه",2,"ق",2,0],["فَيُلجِمُ أَعناقَها بِالجِبالِ","وَيُنعِلُ أَرساغَها بِالبِطاحِ",3,"ح",1,0],["في لَيالٍ كَاللَآلي","بِالغَواني مُقمِراتِ",4,"ت",1,0],["في لَيلَةٍ ما كانَ مِن","هُ سِوى دُجاها مَن يُغيثُ",5,"ث",1,0],["فَيَلينُ طَوراً لِلرَّجاءِ وَتارَةً","يَشتَدُّ بَينَ جَوانِحي وَيَزيدُ",6,"د",1,0],["في لَيلَةٍ مِثلِ عَرضِ البَحرِ حالِكَةِ ال","جلباتِ قامَت بِها لا تَهتَدي الشُهُبُ",7,"ب",1,0],["فَيُلْقِي مِنْ مَحَبَّتِهِ عَلَيْهِ","وَتُوشِكُ أنْ تُوحِّدَهُ الأنَامُ",8,"م",1,0],["فَيُلوينَ بِالأَذنابِ خَوفاً وَطاعَةً","لأَشَوسَ نَظّارٍ إِلى كُلِّ راكِبِ",9,"ب",1,0],["في ليلة حسد الضياء ظلامها","وعنا لفضل نجومها القمران",10,"ن",1,0],["في لَيلَتَينِ إِذا حَدَوتُ قَصيدَةً","بَلَغَت عُمانَ وَطَيِّئَ الأَجبالِ",11,"ل",1,0],["في ليلة مطلع الجوزاء أولها","دهماً لا قُرَح فيه ولا رَجَلُ",12,"ل",1,0],["في ليلِ وصلٍ لا رقيب به","إلا الحباب بأكوس الشرب",13,"ب",1,0],["في ليل أفراح كأنَّ هلاله","للشرب ما بين الندامى زَوْرَقُ",14,"ق",1,0],["فيلقى الجوينيّ في الوفد من","ندًى عنده ما لقى المالقي",15,"ق",2,0],["في لُجِّ بِحرِ الفِكرِ تَجري بِهِ","لِطائِفٌ مِن قُدرَةِ القادِرِ",16,"ر",1,0],["فيلٌ وأَوْزَنُ منه لو يُوازِنُهُ","في الحلم والعلم لا في الجسم يَعسوبُ",17,"ب",1,0],["فيلْقَى المتَمَادُونَ","لِجَاماً صادقَ الكبْحِ",18,"ح",1,0],["في لين سمورة تخيَّرها ال","فراء أو لين جيد الدلق",19,"ق",1,0],["في لؤم كلبيْن إن كشفتهما","كشف امتحانٍ وقبحِ قردين",20,"ن",1,0],["في لَيلَةٍ طامِسَةِ الأَنجُمِ","تَسَلَّلَ المَوتُ إِلى القَصرِ",21,"ر",1,0],["فَيَلحَقُ بِالخَيراتِ مَن كانَ أَهلَها","وَتَعلَمُ عَبسٌ رَأسُ مَن يَتَصَوَّب",22,"ب",1,0],["في لاحِبٍ بِرَقاقِ الأَرضِ مُحتَفِلٍ","هادٍ إِذا عَزَّهُ الأُكمُ الحَدابيرُ",23,"ر",1,0],["في ليلِ الوَحْشَةِ مسْراهُ","وبِكَهْفِ الوَحْدَةِ مرقَدُهُ",24,"د",2,0],["في لُجَّةِ الغاباتِ","في صوتِ الرُّعودِ القاصِفهْ",25,"ه",1,0],["في لمعَةِ البرق الخَفُوقِ","وفي هُوِيِّ الصَّاعقهْ",25,"ه",1,0],["في لَيلَةٍ دارَت عَليّ نُجومُها","حَتّى سَكِرتُ بِكَفّ قوت الأَنفُسِ",26,"س",1,0],["في ليل حزني كانت الظلماء","عابسة تروع",27,"ع",1,0],["فيلوح في هذا السحا","ب الجهم فوق الافق شر",28,"ر",1,0],["في لَيلَةٍ مِن لَيالي الدَهرِ طَيِّبَةٍ","مَحا بِها كُلَّ ذَنبٍ غَيرِ مُغتَفَرِ",29,"ر",1,0],["في لَيلَةٍ قَدِمَ الوُجودَ هِلالُها","فَدَنَت كَواكِبُها تُعَلِّمُهُ السُرى",30,"ر",2,0],["في لُلِّ يَومٍ مِنَّةٌ ما بَعدَها","مَنٌّ يُعابُ الصادِرونَ بِغِبِّهِ",31,"ب",2,0],["في لِباسِ المَصيفِ وَالوَقتُ قَد جا","ءَ بِأَمرٍ مِنَ الشِتاءِ عَجيبِ",32,"ب",1,0],["في لَفيفٍ مِنَ المَنايا يُمَزِّق","نَ غَداةَ الهَيجاءِ كُلَّ لَفيفِ",33,"ف",1,0],["في لَيلَةٍ لا يَنالُ الصُبحُ آخِرَها","عَلِقتُ بِالراحِ أُسقاها وَأَسقيها",34,"ي",3,0],["في لحظة تجمع الآباد حاضرها","وما يجيء وما قد مر منصرما",35,"م",2,0],["في لمعة تومض في فرقد","في فلك أنت محياه",36,"ا",2,0],["في لحظة يقفز فيها دمي","وتعقد الدهشة فيها فمي",37,"ي",1,0],["فيلق بعد فيلق حجب الشمس","ولم يبق للنواظر أفقا",38,"ق",2,0],["في ليلة ليلاء أر","رَقني عصيب ظلامها",39,"م",3,0],["في لَيلَةٍ لَبِسَتْ لِتَستُرَ شَخْصَهُ","عنّا فلم تَلْحَظْهُ عَينُ الفَرقَدِ",40,"د",1,0],["في ليلِ لمته ضللتُ عن الهوى","وبنورِ غُرّتِهِ إليه هديتُ",41,"ت",1,0],["في لَيالٍ تَكادُ تُبقي بِخَدِّ ال","شَمسِ مِن ريحِها البَليلِ شُحوبا",42,"ب",2,0],["في لَيالٍ مِنهُنَّ لَيَلةَ باتَت","ناقَتي والِهاً تَجُرُّ الزِماما",43,"م",2,0],["في لَيلَةٍ كانَت مُبارَكَةً","ظَلَّت عَلَيَّ كَلَيلَةِ القَدرِ",44,"ر",1,0],["في لَيلَةٍ طَخياءَ يُخشى هَولُها","ظَلماءَ مِن لَيلِ التَمامِ الأَسوَدِ",45,"د",1,0],["في لَيلَةٍ قَد باتَ يَلحَسُ تَحتَها","حِبراً لِسانُ البارِقِ المُتَوَقِّدِ",46,"د",1,0],["فَيَلوي مِن غُصنِهِ هَصرُهُ","وَيُمكِنُ مِن وَردِهِ قَطفُهُ",47,"ف",2,0],["في لَيلَةٍ خَصِرَت صَباها فَاِصطَلى","فيها أَخو التَقوى بِنارِ مُدامِ",48,"م",1,0],["في لَيلة لَم أَدرِ ساعاتها","أَضَعت طولاها وَقُصراها",49,"ا",3,0],["فَيلَسوف الفَريكةِ الصائب الرَأ","يِ رَبيب الحُرية الفكريه",50,"ي",2,0],["في لَيلَةٍ ما مِثلَها لَيلَةٌ","لَستُ لَها ما عِشتُ بِالناسي",51,"ي",1,0],["في لَيلَةٍ فيها السَماءُ مُرِزَّةٌ","سَوداءُ مُظلِمَةٌ كَقَلبِ الكافِرِ",52,"ر",1,0],["في لَيلَةٍ أَكَلَ المُحاقُ هِلالَها","حَتّى تَبَدّى مِثلَ وَقفِ العاجِ",53,"ج",1,0],["في لَهَبٍ عَنهُ وَخَتلٍ إِدِّ","مِثلَ اِنسِيابِ الحَيَّةِ العِربَدِّ",54,"د",1,0],["في لسان الشربِ منها","مثلُ لذع الزَنجبيل",55,"ل",1,0],["في لَيلَةٍ خَلفَ شَهرِ الصَومِ ناقِصَةٍ","تِسعاً وَعِشرينَ قَد أَحصَيتُها عَدَدا",56,"د",2,0],["في لِقاءِ الرَبابِ شافٍ مِنَ الشَو","قِ إِلى وَجهِها وَأَينَ الرَبابُ",57,"ب",1,0],["في لاحِبٍ لا يَعودُ السالِكونَ بِهِ","مِثلَ اِبنِ الأَبرَصِ لَمّا عادَ مَلحوبا",58,"ب",2,0],["في ليلةٍ أسرت بِهِ فكأنَّما","خِيلَتْ لديهِ ليلةَ المعراجِ",59,"ج",1,0],["فَيَلقاه صقر ذو مخالب أَجدَلٌ","فيخطفه من قبل ما هو يشعر",60,"ر",1,0],["في ليلة سوداء لم","أبصر بها للنجم وقدا",61,"د",2,1],["في لَيل بغداد من فقد الأمان به","لا يَستَطيع امرؤ يَمشي بلا خفر",62,"ر",1,0],["في لَيلة بدت","بَيضاء بالسنى",63,"ن",2,0],["في لحظةٍ لم يجل بذهنٍ","قضاؤها الفاجع الرهيب",64,"ب",1,0],["في لونِ خدَّيْكِ اقطِفِي ما شِئتِهِ","من زهرةٍ أو كوكبٍ وضّاءِ",65,"ا",2,0],["في ليلةٍ للنفس فيها هِزَّةٌ","ولكلِّ قلبٍ صبوةٌ وتشوُّقُ",66,"ق",1,0],["في لجة قامصة سفنها","ويصرع المستمسك القامص",67,"ص",1,0],["في ليلة للختل كانت موعدا","قد نصبتها شركاً أيدي العدا",68,"د",2,0],["في لَيلَةٍ لا نَرَى بِها أَحَداً","يَحكي عَلَينَا إلاَّ كَواكِبُها",69,"ب",3,0],["فِي ليْلَةٍ نَفَحَتْ غوَالِي عِطْرَهَا","نفْحاً يُذَّكيهُ أَرِيجُ القرْقفِ",70,"ف",1,0],["فِي لَهْوِهِ وَسُرُورِهِ فِي زُهْوِهِ","وَغُرُورِهِ فِي الْبَثِّ وَالإِشْكَاءِ",71,"ا",2,0],["فِي لُغَاتٍ شَتَّى وَفِي لُغَةِ الضَّ","ادِ تُجِندِينَ صَوْغَ مَا تَكْتُبِينَا",72,"ن",2,0],["فَيُلْقِي شُعَاعٌ عَلَيْهَا نَصِيفاً","وَيَنْزِعُ آخرُ عَنْهَا النَّصِيفْ",73,"ف",1,0],["فِي لَفظِهَا الشُّهْدُ الَّذِي تَشْتَارُهُ","أَسْمَاعُنَا وَالسَّمْعُ قَدْ يَشْتَارُ",74,"ر",1,0],["فِي لَفْظِهِ الجَزْلِ وَفِي أُسْلُوبِهِ","بَلاَغَةٌ فَاقِدَةٌ المَثِيلِ",75,"ل",1,0],["فِي لَحْظِكِ العَجَبِ الَّذِي لاَ يَنْقَضِي","نَاهِيكِ مِنْ سُحْرٍ ِبِه ناهِيكِ",76,"ك",1,0],["فِي لَيْلَةٍ وَالنَّهَارُ يَخْرِجُهَا","أَبْكَارَ صَوْغٍ مِنَ صَدْرِكِ الْبِكْرِ",77,"ر",1,0],["في لَيْلَةٍ وَرَدَتْ عَلَيَّ هُمُومُهَا","طَوْراً أحِنُّ وَتَارَةً أتَمَلْمَلُ",78,"ل",1,0],["في ليلةٍ من سوادِ العينِ قد خُلِقَتْ","جَلَّ الذي من سوادِ العينِ جَلاَّها",79,"ا",3,0],["في ليلة القدْر على واديك","كالبدر يجلو ظلمةَ الشكوك",80,"ك",1,0],["في لحية (المريخ) ، لي مكتب","نهد (الثريا) فوق بابي شعار",81,"ر",1,0],["فيلوكون معجزات (فقيه)","يحشد الجنّ والظلام يشاهد",82,"د",1,0],["فيلوكون من \" مريض \" التواريخ","حروفا من فهرسات التراجم",83,"م",1,0],["فيلله أنّك لاتحاسبني بزلّه","وأنك أتوفّقني وتستر كنيني",84,"ن",2,0],["في ليلة ليلاء أرّ","قني عصيب ظلامها",85,"م",3,0],["في لَيلِةٍ لا يُرى بِها أَحَدٌ","يَحكي عَلَيها إِلّا كَواكِبُها",86,"ب",3,0],["في ليلة كان فيها الحر متقدا","ترمي جهنمه الاجسام بالشرر",87,"ر",1,0],["فَيْلَسُوفٌ وواعظٌ، وخطيبٌ","واحَةً يرتعي مِن الزَّيْفَ خَصْبَةْ",88,"ب",2,0],["فيلمس الشوق قلبي في جوانبه","وتأنس الوجد نفسي في نواحينا",89,"ن",2,0],["فِي لِي بِوَعدِي فَإبرِيلٌ مَضَى وَأَتَت","مِن بَعدِه أشهرٌ فِي لِي بِمَوعُودِي",90,"ي",1,0],["في لفظه والخطِّ مندوحةٌ","عن صارم الحدَّين ذَلاَّقِ",91,"ق",1,0],["فيلقى مناخ الجود والفضل واسعا","ويلقى فراتا طاب نهلا فما القطر",92,"ر",1,0],["في ليت شعري هل لقربك كَرَّةٌ","وهيهات كم بيني وبينك من قفر",93,"ر",1,0],["فَيَلفَحُ أَحيانا فُؤادي وَيَلدَغُ","أَلا لَيتَ شِعري وَالخُطوبُ مُلِمَّةٌ",94,"ه",1,0],["في لَيْلَةٍ طَرَزَتْ غِلالَةَ خَدَّيْ","هِ لَدى فَجْرِهِ طِرازَيْنِ",95,"ن",1,0],["في ليلة كأنما سعودها","مسروقة من غفلات الدهر",96,"ر",1,0],["في لحظ عينيه سكر من رحيق فمه","قد زاده حوما طار على حومه",97,"م",2,1],["في ليلةٍ من هَجرِها شَتَويّةٍ","مَمْدودةٍ مَخْضوبةٍ بمدادِ",98,"د",1,0],["في لَيلةٍ أَبرَزَتْ كَأسَ المُدامِ بِها","وَأَوجهَ الشُّربِ نيراناً وَأَنوارا",99,"ر",2,0],["في لَيلَةٍ لَم يَكُن لِلحلم مُنتَجِعٌ","فيها وَلا في الكَرى لِلطَّرفِ مِن أَرَبِ",100,"ب",1,0],["في لحظِها مرضٌ للتِّيهِ تحسَبُه","وَسْنانَ أو كقريبِ العهدِ من رمد",101,"د",1,0],["في ليلة ذابت بهجر الشمس","فك