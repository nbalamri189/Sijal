الأمس وأطربه","https://www.aldiwan.net/poem38886.html","المتدارك"],[92,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[78,"أزف الصيام وزار نور النرجس","https://www.aldiwan.net/poem14052.html","الكامل"],[89,"خطبت تؤبنك الدموع","https://www.aldiwan.net/poem44716.html","مجزوء الكامل"],[89,"جو السياسة مكفهر","https://www.aldiwan.net/poem44852.html","مجزوء الكامل"],[85,"بالله يا نسمات النيل في السحر","https://www.aldiwan.net/poem63666.html","البسيط"],[85,"لا السهد يدنيني إليه ولا الكرى","https://www.aldiwan.net/poem63716.html","الطويل"],[45,"من سائل لمعذر عن خطبه","https://www.aldiwan.net/poem10888.html","الكامل"],[45,"يا أبا نهشل نداء غريب","https://www.aldiwan.net/poem10891.html","الخفيف"],[45,"مرحبا بالخيال منك المطيف","https://www.aldiwan.net/poem65145.html","الخفيف"],[45,"ميلوا إلى الدار من ليلى نحييها","https://www.aldiwan.net/poem66851.html","البسيط"],[97,"طوى السنين وشق الغيب والظلما","https://www.aldiwan.net/poem24940.html","البسيط"],[97,"أبي أخي كعبة آمالنا","https://www.aldiwan.net/poem24966.html","السريع"],[97,"يا شطر نفسي وغرامي الوحيد","https://www.aldiwan.net/poem24986.html","السريع"],[97,"أجل أهواك أنت منى حياتي","https://www.aldiwan.net/poem25069.html","الوافر"],[97,"ذوت الصبابة وانطوت","https://www.aldiwan.net/poem25071.html","مجزوء الكامل"],[80,"الآن أفرخ روع كل مهيد","https://www.aldiwan.net/poem31473.html","الكامل"],[80,"الدمع ينطق واللسان صموت","https://www.aldiwan.net/poem31531.html","الكامل"],[44,"من سجايا الطلول ألا تجيبا","https://www.aldiwan.net/poem30582.html","الخفيف"],[31,"يا ثريا الفؤاد ردي السلاما","https://www.aldiwan.net/poem41340.html","الخفيف"],[31,"أطوي الضمير على حرارته","https://www.aldiwan.net/poem42495.html","الكامل"],[31,"نام الخلي وبت غير موسد أ","https://www.aldiwan.net/poem42571.html","الكامل"],[74,"وغمامة لم يستقل بها السرى","https://www.aldiwan.net/poem12898.html","الكامل"],[74,"أيجني على مهجتي طرفه","https://www.aldiwan.net/poem13177.html","المتقارب"],[74,"ومقنع بخلا بنضرة حسنه","https://www.aldiwan.net/poem13241.html","الكامل"],[102,"رسالة واها لها واها","https://www.aldiwan.net/poem33108.html","السريع"],[102,"مرحبا بالثقافة الغربيه","https://www.aldiwan.net/poem33122.html","الخفيف"],[52,"لا عذر للعاذل في الكاس","https://www.aldiwan.net/poem26916.html","السريع"],[52,"كم قد قطعت إليك من ديمومة","https://www.aldiwan.net/poem26945.html","الكامل"],[52,"حث الفراق بواكر الأحداج","https://www.aldiwan.net/poem27171.html","الكامل"],[48,"قد أغتدي والليل أحوى السد","https://www.aldiwan.net/poem63254.html","الرجز"],[48,"أسقياني من شمول","https://www.aldiwan.net/poem66633.html","مجزوء الرمل"],[50,"تعجبت جارتي مني وقد رقدت","https://www.aldiwan.net/poem63950.html","البسيط"],[50,"طرقتنا بالزابيين الرباب","https://www.aldiwan.net/poem64816.html","الخفيف"],[46,"سرحوب عمن سرى لله مبتعثا","https://www.aldiwan.net/poem22129.html","البسيط"],[76,"الحق أبلج واضح المنهاج","https://www.aldiwan.net/poem39466.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85582","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85478","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85304","المنسرح"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39674","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39655","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39581","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147493","السريع"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21125","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55028","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55437","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55025","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54833","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55158","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55106","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54862","المنسرح"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67336","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54248","البسيط"],[106,"تحية فريال","https://www.poetsgate.com/ViewPoem.aspx?id=179501",""],[97,"رسائل محترقة","https://www.poetsgate.com/ViewPoem.aspx?id=25528",""],[20,"لم أر مثل الفتيان في غبن ال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69760&r=&rc=1",""],[88,"وصاحب قد دعانا ان نلمّ به","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19574&r=&rc=77",""]],"verses":[["في لَيلَةٍ أَوعَدَت بِالبَينِ فَاِختَلَسَت","مِنَ العُيونِ بَقايا غُبَّرِ الوَسَنِ",0,"ن",1,0],["في لَيلَةٍ غابَ مَعي بَدرُها","وَحارَبَتها في الظَلامِ النُجوم",1,"م",1,0],["فَيلَقٌ جَرَّ عَلى أَر","بُقَ أَذيالَ الفَليقَه",2,"ق",2,0],["فَيُلجِمُ أَعناقَها بِالجِبالِ","وَيُنعِلُ أَرساغَها بِالبِطاحِ",3,"ح",1,0],["في لَيالٍ كَاللَآلي","بِالغَواني مُقمِراتِ",4,"ت",1,0],["في لَيلَةٍ ما كانَ مِن","هُ سِوى دُجاها مَن يُغيثُ",5,"ث",1,0],["فَيَلينُ طَوراً لِلرَّجاءِ وَتارَةً","يَشتَدُّ بَينَ جَوانِحي وَيَزيدُ",6,"د",1,0],["في لَيلَةٍ مِثلِ عَرضِ البَحرِ حالِكَةِ ال","جلباتِ قامَت بِها لا تَهتَدي الشُهُبُ",7,"ب",1,0],["فَيُلْقِي مِنْ مَحَبَّتِهِ عَلَيْهِ","وَتُوشِكُ أنْ تُوحِّدَهُ الأنَامُ",8,"م",1,0],["فَيُلوينَ بِالأَذنابِ خَوفاً وَطاعَةً","لأَشَوسَ نَظّارٍ إِلى كُلِّ راكِبِ",9,"ب",1,0],["في ليلة حسد الضياء ظلامها","وعنا لفضل نجومها القمران",10,"ن",1,0],["في لَيلَتَينِ إِذا حَدَوتُ قَصيدَةً","بَلَغَت عُمانَ وَطَيِّئَ الأَجبالِ",11,"ل",1,0],["في ليلة مطلع الجوزاء أولها","دهماً لا قُرَح فيه ولا رَجَلُ",12,"ل",1,0],["في ليلِ وصلٍ لا رقيب به","إلا الحباب بأكوس الشرب",13,"ب",1,0],["في ليل أفراح كأنَّ هلاله","للشرب ما بين الندامى زَوْرَقُ",14,"ق",1,0],["فيلقى الجوينيّ في الوفد من","ندًى عنده ما لقى المالقي",15,"ق",2,0],["في لُجِّ بِحرِ الفِكرِ تَجري بِهِ","لِطائِفٌ مِن قُدرَةِ القادِرِ",16,"ر",1,0],["فيلٌ وأَوْزَنُ منه لو يُوازِنُهُ","في الحلم والعلم لا في الجسم يَعسوبُ",17,"ب",1,0],["فيلْقَى المتَمَادُونَ","لِجَاماً صادقَ الكبْحِ",18,"ح",1,0],["في لين سمورة تخيَّرها ال","فراء أو لين جيد الدلق",19,"ق",1,0],["في لؤم كلبيْن إن كشفتهما","كشف امتحانٍ وقبحِ قردين",20,"ن",1,0],["في لَيلَةٍ طامِسَةِ الأَنجُمِ","تَسَلَّلَ المَوتُ إِلى القَصرِ",21,"ر",1,0],["فَيَلحَقُ بِالخَيراتِ مَن كانَ أَهلَها","وَتَعلَمُ عَبسٌ رَأسُ مَن يَتَصَوَّب",22,"ب",1,0],["في لاحِبٍ بِرَقاقِ الأَرضِ مُحتَفِلٍ","هادٍ إِذا عَزَّهُ الأُكمُ الحَدابيرُ",23,"ر",1,0],["في ليلِ الوَحْشَةِ مسْراهُ","وبِكَهْفِ الوَحْدَةِ مرقَدُهُ",24,"د",2,0],["في لُجَّةِ الغاباتِ","في صوتِ الرُّعودِ القاصِفهْ",25,"ه",1,0],["في لمعَةِ البرق الخَفُوقِ","وفي هُوِيِّ الصَّاعقهْ",25,"ه",1,0],["في لَيلَةٍ دارَت عَليّ نُجومُها","حَتّى سَكِرتُ بِكَفّ قوت الأَنفُسِ",26,"س",1,0],["في ليل حزني كانت الظلماء","عابسة تروع",27,"ع",1,0],["فيلوح في هذا السحا","ب الجهم فوق الافق شر",28,"ر",1,0],["في لَيلَةٍ مِن لَيالي الدَهرِ طَيِّبَةٍ","مَحا بِها كُلَّ ذَنبٍ غَيرِ مُغتَفَرِ",29,"ر",1,0],["في لَيلَةٍ قَدِمَ الوُجودَ هِلالُها","فَدَنَت كَواكِبُها تُعَلِّمُهُ السُرى",30,"ر",2,0],["في لُلِّ يَومٍ مِنَّةٌ ما بَعدَها","مَنٌّ يُعابُ الصادِرونَ بِغِبِّهِ",31,"ب",2,0],["في لِباسِ المَصيفِ وَالوَقتُ قَد جا","ءَ بِأَمرٍ مِنَ الشِتاءِ عَجيبِ",32,"ب",1,0],["في لَفيفٍ مِنَ المَنايا يُمَزِّق","نَ غَداةَ الهَيجاءِ كُلَّ لَفيفِ",33,"ف",1,0],["في لَيلَةٍ لا يَنالُ الصُبحُ آخِرَها","عَلِقتُ بِالراحِ أُسقاها وَأَسقيها",34,"ي",3,0],["في لحظة تجمع الآباد حاضرها","وما يجيء وما قد مر منصرما",35,"م",2,0],["في لمعة تومض في فرقد","في فلك أنت محياه",36,"ا",2,0],["في لحظة يقفز فيها دمي","وتعقد الدهشة فيها فمي",37,"ي",1,0],["فيلق بعد فيلق حجب الشمس","ولم يبق للنواظر أفقا",38,"ق",2,0],["في ليلة ليلاء أر","رَقني عصيب ظلامها",39,"م",3,0],["في لَيلَةٍ لَبِسَتْ لِتَستُرَ شَخْصَهُ","عنّا فلم تَلْحَظْهُ عَينُ الفَرقَدِ",40,"د",1,0],["في ليلِ لمته ضللتُ عن الهوى","وبنورِ غُرّتِهِ إليه هديتُ",41,"ت",1,0],["في لَيالٍ تَكادُ تُبقي بِخَدِّ ال","شَمسِ مِن ريحِها البَليلِ شُحوبا",42,"ب",2,0],["في لَيالٍ مِنهُنَّ لَيَلةَ باتَت","ناقَتي والِهاً تَجُرُّ الزِماما",43,"م",2,0],["في لَيلَةٍ كانَت مُبارَكَةً","ظَلَّت عَلَيَّ كَلَيلَةِ القَدرِ",44,"ر",1,0],["في لَيلَةٍ طَخياءَ يُخشى هَولُها","ظَلماءَ مِن لَيلِ التَمامِ الأَسوَدِ",45,"د",1,0],["في لَيلَةٍ قَد باتَ يَلحَسُ تَحتَها","حِبراً لِسانُ البارِقِ المُتَوَقِّدِ",46,"د",1,0],["فَيَلوي مِن غُصنِهِ هَصرُهُ","وَيُمكِنُ مِن وَردِهِ قَطفُهُ",47,"ف",2,0],["في لَيلَةٍ خَصِرَت صَباها فَاِصطَلى","فيها أَخو التَقوى بِنارِ مُدامِ",48,"م",1,0],["في لَيلة لَم أَدرِ ساعاتها","أَضَعت طولاها وَقُصراها",49,"ا",3,0],["فَيلَسوف الفَريكةِ الصائب الرَأ","يِ رَبيب الحُرية الفكريه",50,"ي",2,0],["في لَيلَةٍ ما مِثلَها لَيلَةٌ","لَستُ لَها ما عِشتُ بِالناسي",51,"ي",1,0],["في لَيلَةٍ فيها السَماءُ مُرِزَّةٌ","سَوداءُ مُظلِمَةٌ كَقَلبِ الكافِرِ",52,"ر",1,0],["في لَيلَةٍ أَكَلَ المُحاقُ هِلالَها","حَتّى تَبَدّى مِثلَ وَقفِ العاجِ",53,"ج",1,0],["في لَهَبٍ عَنهُ وَخَتلٍ إِدِّ","مِثلَ اِنسِيابِ الحَيَّةِ العِربَدِّ",54,"د",1,0],["في لسان الشربِ منها","مثلُ لذع الزَنجبيل",55,"ل",1,0],["في لَيلَةٍ خَلفَ شَهرِ الصَومِ ناقِصَةٍ","تِسعاً وَعِشرينَ قَد أَحصَيتُها عَدَدا",56,"د",2,0],["في لِقاءِ الرَبابِ شافٍ مِنَ الشَو","قِ إِلى وَجهِها وَأَينَ الرَبابُ",57,"ب",1,0],["في لاحِبٍ لا يَعودُ السالِكونَ بِهِ","مِثلَ اِبنِ الأَبرَصِ لَمّا عادَ مَلحوبا",58,"ب",2,0],["في ليلةٍ أسرت بِهِ فكأنَّما","خِيلَتْ لديهِ ليلةَ المعراجِ",59,"ج",1,0],["فَيَلقاه صقر ذو مخالب أَجدَلٌ","فيخطفه من قبل ما هو يشعر",60,"ر",1,0],["في ليلة سوداء لم","أبصر بها للنجم وقدا",61,"د",2,1],["في لَيل بغداد من فقد الأمان به","لا يَستَطيع امرؤ يَمشي بلا خفر",62,"ر",1,0],["في لَيلة بدت","بَيضاء بالسنى",63,"ن",2,0],["في لحظةٍ لم يجل بذهنٍ","قضاؤها الفاجع الرهيب",64,"ب",1,0],["في لونِ خدَّيْكِ اقطِفِي ما شِئتِهِ","من زهرةٍ أو كوكبٍ وضّاءِ",65,"ا",2,0],["في ليلةٍ للنفس فيها هِزَّةٌ","ولكلِّ قلبٍ صبوةٌ وتشوُّقُ",66,"ق",1,0],["في لجة قامصة سفنها","ويصرع المستمسك القامص",67,"ص",1,0],["في ليلة للختل كانت موعدا","قد نصبتها شركاً أيدي العدا",68,"د",2,0],["في لَيلَةٍ لا نَرَى بِها أَحَداً","يَحكي عَلَينَا إلاَّ كَواكِبُها",69,"ب",3,0],["فِي ليْ