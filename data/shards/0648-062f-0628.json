{"poems":[[53,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[63,"علوت فدونك السبع الشداد","https://www.aldiwan.net/poem46157.html","الوافر"],[63,"مراحك إنه البرق اليماني","https://www.aldiwan.net/poem46172.html","الوافر"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"رقدت وما ليل الغريب براقد","https://www.aldiwan.net/poem61941.html","الطويل"],[91,"إذا سحقت أرضنا القنبله","https://www.aldiwan.net/poem62634.html","عموديه"],[70,"عندي أحاديث أشواق أضن بها","https://www.aldiwan.net/poem42758.html","البسيط"],[85,"رأيت على لوح الخيال يتيمة","https://www.aldiwan.net/poem63690.html","الطويل"],[43,"أود من الأيام مالا توده","https://www.aldiwan.net/poem9553.html","الطويل"],[62,"موازين الطبائع في يدينا","https://www.aldiwan.net/poem52159.html","الوافر"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[90,"أعيذك أن يعاصيك القصيد","https://www.aldiwan.net/poem60159.html","عموديه"],[52,"صحوت ولكن بعد أي فتون","https://www.aldiwan.net/poem26609.html","الطويل"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[46,"أعن وخد القلاص كشفت حالا","https://www.aldiwan.net/poem23633.html","الوافر"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9484","الطويل"],[106,"صدى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179584",""],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[16,"طَحَا بكَ قَلبٌ في الحِسان طروبُ","https://www.poetsgate.com/ViewPoem.aspx?id=4900",""],[51,"رقدْتُ وما ليلُ الغريب براقدِ","https://www.poetsgate.com/ViewPoem.aspx?id=28472",""],[51,"أخفُّ مناطاً في الرقاب وأوْكَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=25837",""],[141,"بسعدك دارت في السماء الكواكب","https://www.aldiwan.net/poem11734.html","الطويل"],[141,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[145,"أتت مهنئة فليهن مهديها","https://www.aldiwan.net/poem47653.html","البسيط"],[158,"قضى الله فينا وهو حكم بحكمه","https://www.aldiwan.net/poem58859.html","الطويل"],[158,"يا بحر قلدت أخاك البحرا","https://www.aldiwan.net/poem59050.html","الرجز"],[183,"لقد جمع الكانون نورا وظلمة","https://www.aldiwan.net/poem14621.html","الطويل"],[184,"أفدي الذي عندما أبصرته قدحت","https://www.aldiwan.net/poem43917.html","البسيط"],[197,"أما حدثوك بأخبارها","https://www.aldiwan.net/poem45644.html","المتقارب"],[221,"نحن الأطفال عصب","https://www.aldiwan.net/poem41453.html","عموديه"],[280,"دعا مهجة الصب لا تردعاها","https://www.aldiwan.net/poem32310.html","المتقارب"],[295,"قم هاتها كالنار ذات الوقود","https://www.aldiwan.net/poem33291.html","السريع"],[336,"إذا ما انتسبت إلى آدم","https://www.aldiwan.net/poem68813.html","المتقارب"],[351,"ألام بحبه فأزيد وجدا","https://www.aldiwan.net/poem40390.html","الوافر"],[374,"سمعت بأذني رنة السهمِ في قلبي","https://www.aldiwan.net/poem66952.html","الطويل"],[377,"ما كان أغناك يا قلبي عن القلق","https://www.aldiwan.net/poem48818.html","البسيط"],[413,"أسرك من باد لعينيك حاضر","https://www.aldiwan.net/poem54066.html","الطويل"],[413,"أنيخاها فقد بلغت مناها","https://www.aldiwan.net/poem54083.html","الوافر"],[429,"أرقصها مطرب الأغاريد","https://www.aldiwan.net/poem12414.html","المنسرح"],[434,"قف العيس هذا ربع سلمى فسلم","https://www.aldiwan.net/poem2538.html","الطويل"],[456,"تعالين نعالج نفرة","https://www.aldiwan.net/poem55850.html","الهزج"],[456,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[456,"من العار لولا أن طيفك يطرق","https://www.aldiwan.net/poem56098.html","الطويل"],[456,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[456,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[456,"حرم عليها نزهات الوادي","https://www.aldiwan.net/poem56222.html","البسيط"],[456,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[456,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[456,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[462,"قالوا الإمام عماد الدين معتقل","https://www.aldiwan.net/poem3120.html","عموديه"],[462,"مضى صاحب الصدر الذي حازه الصدر","https://www.aldiwan.net/poem3394.html","عموديه"],[477,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[491,"ومجلس حل من يحل به","https://www.aldiwan.net/poem67406.html","المنسرح"],[512,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[512,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"]],"verses":[["وَدَبَّرَ أَطرافَ الرِماحِ وَإِنَّما","يُدَبِّرُ قَبلَ الطَعنِ رَأياً مُسَدَّدا",0,"د",2,0],["ودبّرَها فدمّرَها برأيٍ","تُجانِبُهُ الإصابةُ والسّدادُ",1,"د",1,0],["ودَبّتْ نَشْوَةُ الخُيَلاءِ فيهمْ","دَبيبَ النّارِ في سَعَفِ الإهانِ",2,"ن",1,0],["ودبَّ كَلالٌ في عظامي أدَبَّني","جَنِيبَ العصا أَنأَدُّ أو أتَأيَّدُ",3,"د",1,0],["ودبَّ عليه الموتُ غضبانَ مسرعاً","باباته من محكمات المصائدِ",4,"د",1,0],["وَدَبَّ الفَنا في ذَواتِ الجَناحِ","وَغَلغَلَ في النَبتِ فَاِستَأصَلَه",5,"ل",2,0],["وُدٌّ بِلا مَلَقٍ مِنّا يُزَخرِفُهُ","يُغني المَليحَةَ عَن حَليٍ وَعَن حُلَلَلِ",6,"ل",1,0],["وَدَبّابَةٍ تَحتَ العُبابِ بِمَكمَنٍ","أَمينٍ تَرى الساري وَلَيسَ يَراها",7,"ا",3,0],["وَدَبِّرهُ تَدبيرَ الَّذي المَجدُ كَفُّهُ","إِذا حارَبَ الأَعداءَ وَالمالُ زَندُهُ",8,"د",2,0],["ودبّر معدن الحكماء واصبر","عليه فهوملك لا يبيدُ",9,"د",1,0],["ودبَّ في القلبِ من تأمورِه ضرمٌ","ما انفكَّ يُثلج صدري حين يُصليني",10,"ن",2,0],["ودبوا فوقها ولهم لحودُ","وذابو تحتها ولهم لحود",11,"د",1,0],["وَدَبَّ مَشيبي بَعضَهُ فَوقَ بَعضِهِ","وَأَخرَجَني مِن أَنفُسٍ وَعُيونِ",12,"ن",1,0],["ودَبَّر المُلْكَ تَدْبيراً يُقَصِّرُ عَنْ","إدْرَاكِ أَيْسَرِهِ الأَفْهَامُ والفِكَرُ",13,"ر",1,0],["وَدَبّتْ فوْقه حُمْرُ المَنَايا","ولكِنْ بَعدما مُسِخَتْ نِمالا",14,"ل",2,0],["وَدِبسِيَّةٌ بِالإِسمِ لَكِنَّ صَوتَها","كَصَوتِ حِمارٍ قَطَّعَ النَهقَ مُفحَما",15,"م",2,1],["ودَبَّ إلى أعْظُم الشُّهَداءِ","فكادَتْ تَهَشُّ بوادي العَدَمْ",16,"م",1,0],["ودبَّتْ مَدَبَّ الروحِ في الكونِ رحمةً","وشدَّتْ لجسمٍ خائرٍ مُتْعَبٍ صُلبا",17,"ب",2,0],["ودُ بنفسٍ، لا يُجادُ بمثلها","وأنتَ بها يوْم اللّقاء تطيبُ",18,"ب",1,0],["ودبَّ إليه الموتُ غضبانَ مسرعاً","باباته من محكمات المصائدِ",19,"د",1,0],["ودبّ كلالٌ في عظامي أدبَّني","ويوصف إلا أنه لا يُحَدّدُ",20,"د",1,0],["وَدَبَّرَ أَمرَ المُلكِ قَبلَ بُلوغِهِ","وَما نَزَعَت عَنهُ السِخابَ الرَبائِبُ",21,"ب",1,0],["وَدَبَّرَهُ اِبنُ مُسلِمَةٍ سَفاهاً","بِرَأيٍ ما أَشارَ بِهِ رَشيدُ",22,"د",1,0],["ودبّ في الجسم من أنفاسها طربٌ","دبيب حبي لهذا الخير منشيها",23,"ي",3,0],["ودبّرهُ تدبير الحفي بعبده","فأنت الذي استخلفته في الخليفْةِ",24,"ه",1,0],["ودبج الروض الؤياح وشيها","منمم الرقم يكاد يقرا",25,"ر",2,0],["ودَبَّت سُلافُ النارِ في قارِ فحمِه","كمادَبَّ نورُ الشمسِ في طَرف الظِّلِّ",26,"ل",1,0],["ودبذ من سقم عينيه إلى جسدي","سقم أشاع نحولا منه في جسدي",27,"د",2,0],["ودبَّ النسيمُ لعيدانهم","فباتت تنوحُ بأوتارها",28,"ر",3,0],["وَدَبّابات","عِندي جِياد",29,"د",1,0],["وَدَبَّ عَلى الوَردِ مَرُّ النَسيمِ","بِرِفق سُحَيراً فَهَبَّ اِنتِباها",30,"ا",3,0],["وَدَبَّجَ الرَوضَ بأَلوانِه","حُسناً وأَحيا الأَرضَ بعد الهُمود",31,"د",1,0],["وَدَبَّ البَياضَ خِلالَ السَوادِ","فَأَصبَحتَ في شِيَةِ الأَشهبِ",32,"ب",1,0],["وَدبَّ عِذارهُ كَالنمل يَسعى","لمبسمه ليرشف مِنهُ شَهدا",33,"د",2,0],["ودَبَّرَهُ بالحلِّ والعقد كاملاً","فبالحلِّ عن روحٍ وبالعقد من تُرب",34,"ب",1,0],["وَدَبَّ تَوريدها في وَجهِهِ خَجَلاً","فَراحَ دَمعِيَ مثل العارض الغَدق",35,"ق",1,0],["ودبَّرْتَ إكسير الرِّياسة والعُلى","بما لا يفي يوماً به علم جابر",36,"ر",1,0],["ودبَّرها بلطفٍ لا بعنفٍ","فأرشَدَها وألهَمَها هداها",37,"ا",3,0],["ودبَّ خمرُ السُّرَى بأَذْرُعِها","فَهْيَ على البِيدِ في عَرَابِيدِ",38,"د",1,0],["ودبّرت أمرا الملك بالدين والحجا","ورأي اصيل في الملمات محكم",39,"م",1,0],["ودبَّت نائباتُ الده","رِ حيَّاتٍ تلوَّيْنا",40,"ن",2,0],["ودَبَى الأرضِ إذا قيل اركبوا","ورواسيها إذا قيل نَزالِ",41,"ل",1,0],["ودبَّا على أمنٍ وخصبٍ فلفَّقا","بجسميهما جسماً يقي ويُمرِّقُ",42,"ق",1,0],["ودبّر الملكَ السحي","لَ رأيُه المستحصِفُ",43,"ف",1,0],["ودبَّر الأيّامَ مرتاضاً بها","فلقَّبته الناهضَ المضطلعا",44,"ع",2,0],["ودبَّروا المجدَ فسدُّوا ما وَلُوا","سدَّ السيوف ثُغَرَ الأغمادِ",45,"د",1,0],["ودبَّر الدنيا على عِلاَّتها","فصَلَحَتْ والدهرُ دهرٌ فاسدُ",46,"د",1,0],["ودبَّر الدنيا برأي واحدٍ","يأنَفُ أن يَشركَه فيها أحدْ",47,"د",1,0],["ودبُّوا لها تحت الظلام عقارباً","ولو حسبوا وطء الأخامِص ما دبُّوا",48,"ب",3,0],["ودب فوق لماه نمل شاربه","فذل أن رضاباً تحنه عسل",49,"ل",1,0],["ودّبج متنَ الأرض نسجُ سمائها","فغودر وجهاً كلّه ذلك المظهر",50,"ر",1,0],["ودبج في الصحائف ما روينا","ليصبح ما رقمته في انتشار",51,"ر",1,0],["وَدَبَّ صِبغُ اللَهيبِ فيهِ بِتَض","ريجِ خُدودِ الشَقائِقِ الضُرُجِ",52,"ج",1,0],["ودبّروا الأمرَ سرّاً وهوَ متّكِلٌ","وربّهُ فوقَ أيديهم يدبّرُهُ",53,"ر",2,0],["ودبّ عِذارُهُ فسعتْ إلينا","أفاعي الموتِ في صُوَر النِّمالِ",54,"ل",1,0]]}