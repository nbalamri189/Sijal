{"poems":[[53,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[63,"علوت فدونك السبع الشداد","https://www.aldiwan.net/poem46157.html","الوافر"],[63,"مراحك إنه البرق اليماني","https://www.aldiwan.net/poem46172.html","الوافر"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"رقدت وما ليل الغريب براقد","https://www.aldiwan.net/poem61941.html","الطويل"],[91,"إذا سحقت أرضنا القنبله","https://www.aldiwan.net/poem62634.html","عموديه"],[70,"عندي أحاديث أشواق أضن بها","https://www.aldiwan.net/poem42758.html","البسيط"],[85,"رأيت على لوح الخيال يتيمة","https://www.aldiwan.net/poem63690.html","الطويل"],[43,"أود من الأيام مالا توده","https://www.aldiwan.net/poem9553.html","الطويل"],[62,"موازين الطبائع في يدينا","https://www.aldiwan.net/poem52159.html","الوافر"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[90,"أعيذك أن يعاصيك القصيد","https://www.aldiwan.net/poem60159.html","عموديه"],[52,"صحوت ولكن بعد أي فتون","https://www.aldiwan.net/poem26609.html","الطويل"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[46,"أعن وخد القلاص كشفت حالا","https://www.aldiwan.net/poem23633.html","الوافر"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9484","الطويل"],[106,"صدى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179584",""],[100,"كلمة كل نهار","https://www.poetsgate.com/ViewPoem.aspx?id=50427",""],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[16,"طَحَا بكَ قَلبٌ في الحِسان طروبُ","https://www.poetsgate.com/ViewPoem.aspx?id=4900",""],[51,"رقدْتُ وما ليلُ الغريب براقدِ","https://www.poetsgate.com/ViewPoem.aspx?id=28472",""],[51,"أخفُّ مناطاً في الرقاب وأوْكَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=25837",""],[144,"بسعدك دارت في السماء الكواكب","https://www.aldiwan.net/poem11734.html","الطويل"],[144,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[148,"أتت مهنئة فليهن مهديها","https://www.aldiwan.net/poem47653.html","البسيط"],[161,"قضى الله فينا وهو حكم بحكمه","https://www.aldiwan.net/poem58859.html","الطويل"],[161,"يا بحر قلدت أخاك البحرا","https://www.aldiwan.net/poem59050.html","الرجز"],[186,"لقد جمع الكانون نورا وظلمة","https://www.aldiwan.net/poem14621.html","الطويل"],[187,"أفدي الذي عندما أبصرته قدحت","https://www.aldiwan.net/poem43917.html","البسيط"],[200,"أما حدثوك بأخبارها","https://www.aldiwan.net/poem45644.html","المتقارب"],[224,"نحن الأطفال عصب","https://www.aldiwan.net/poem41453.html","عموديه"],[283,"دعا مهجة الصب لا تردعاها","https://www.aldiwan.net/poem32310.html","المتقارب"],[298,"قم هاتها كالنار ذات الوقود","https://www.aldiwan.net/poem33291.html","السريع"],[339,"إذا ما انتسبت إلى آدم","https://www.aldiwan.net/poem68813.html","المتقارب"],[354,"ألام بحبه فأزيد وجدا","https://www.aldiwan.net/poem40390.html","الوافر"],[378,"سمعت بأذني رنة السهمِ في قلبي","https://www.aldiwan.net/poem66952.html","الطويل"],[381,"ما كان أغناك يا قلبي عن القلق","https://www.aldiwan.net/poem48818.html","البسيط"],[417,"أسرك من باد لعينيك حاضر","https://www.aldiwan.net/poem54066.html","الطويل"],[417,"أنيخاها فقد بلغت مناها","https://www.aldiwan.net/poem54083.html","الوافر"],[433,"أرقصها مطرب الأغاريد","https://www.aldiwan.net/poem12414.html","المنسرح"],[438,"قف العيس هذا ربع سلمى فسلم","https://www.aldiwan.net/poem2538.html","الطويل"],[459,"تعالين نعالج نفرة","https://www.aldiwan.net/poem55850.html","الهزج"],[459,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[459,"من العار لولا أن طيفك يطرق","https://www.aldiwan.net/poem56098.html","الطويل"],[459,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[459,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[459,"حرم عليها نزهات الوادي","https://www.aldiwan.net/poem56222.html","البسيط"],[459,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[459,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[459,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[465,"قالوا الإمام عماد الدين معتقل","https://www.aldiwan.net/poem3120.html","عموديه"],[465,"مضى صاحب الصدر الذي حازه الصدر","https://www.aldiwan.net/poem3394.html","عموديه"],[480,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[494,"ومجلس حل من يحل به","https://www.aldiwan.net/poem67406.html","المنسرح"],[515,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[515,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"]],"verses":[["وَدَبَّرَ أَطرافَ الرِماحِ وَإِنَّما","يُدَبِّرُ قَبلَ الطَعنِ رَأياً مُسَدَّدا",0,"د",2,0],["ودبّرَها فدمّرَها برأيٍ","تُجانِبُهُ الإصابةُ والسّدادُ",1,"د",1,0],["ودَبّتْ نَشْوَةُ الخُيَلاءِ فيهمْ","دَبيبَ النّارِ في سَعَفِ الإهانِ",2,"ن",1,0],["ودبَّ كَلالٌ في عظامي أدَبَّني","جَنِيبَ العصا أَنأَدُّ أو أتَأيَّدُ",3,"د",1,0],["ودبَّ عليه الموتُ غضبانَ مسرعاً","باباته من محكمات المصائدِ",4,"د",1,0],["وَدَبَّ الفَنا في ذَواتِ الجَناحِ","وَغَلغَلَ في النَبتِ فَاِستَأصَلَه",5,"ل",2,0],["وُدٌّ بِلا مَلَقٍ مِنّا يُزَخرِفُهُ","يُغني المَليحَةَ عَن حَليٍ وَعَن حُلَلَلِ",6,"ل",1,0],["وَدَبّابَةٍ تَحتَ العُبابِ بِمَكمَنٍ","أَمينٍ تَرى الساري وَلَيسَ يَراها",7,"ا",3,0],["وَدَبِّرهُ تَدبيرَ الَّذي المَجدُ كَفُّهُ","إِذا حارَبَ الأَعداءَ وَالمالُ زَندُهُ",8,"د",2,0],["ودبّر معدن الحكماء واصبر","عليه فهوملك لا يبيدُ",9,"د",1,0],["ودبَّ في القلبِ من تأمورِه ضرمٌ","ما انفكَّ يُثلج صدري حين يُصليني",10,"ن",2,0],["ودبوا فوقها ولهم لحودُ","وذابو تحتها ولهم لحود",11,"د",1,0],["وَدَبَّ مَشيبي بَعضَهُ فَوقَ بَعضِهِ","وَأَخرَجَني مِن أَنفُسٍ وَعُيونِ",12,"ن",1,0],["ودَبَّر المُلْكَ تَدْبيراً يُقَصِّرُ عَنْ","إدْرَاكِ أَيْسَرِهِ الأَفْهَامُ والفِكَرُ",13,"ر",1,0],["وَدَبّتْ فوْقه حُمْرُ المَنَايا","ولكِنْ بَعدما مُسِخَتْ نِمالا",14,"ل",2,0],["وَدِبسِيَّةٌ بِالإِسمِ لَكِنَّ صَوتَها","كَصَوتِ حِمارٍ قَطَّعَ النَهقَ مُفحَما",15,"م",2,1],["ودَبَّ إلى أعْظُم الشُّهَداءِ","فكادَتْ تَهَشُّ بوادي العَدَمْ",16,"م",1,0],["ودب ثان ، خريفي المدى ، قلق","يفني ، ويفنى ، ويحيا ، وهو ينتحر",17,"ر",1,0],["ودبَّتْ مَدَبَّ الروحِ في الكونِ رحمةً","وشدَّتْ لجسمٍ خائرٍ مُتْعَبٍ صُلبا",18,"ب",2,0],["ودُ بنفسٍ، لا يُجادُ بمثلها","وأنتَ بها يوْم اللّقاء تطيبُ",19,"ب",1,0],["ودبَّ إليه الموتُ غضبانَ مسرعاً","باباته من محكمات المصائدِ",20,"د",1,0],["ودبّ كلالٌ في عظامي أدبَّني","ويوصف إلا أنه لا يُحَدّدُ",21,"د",1,0],["وَدَبَّرَ أَمرَ المُلكِ قَبلَ بُلوغِهِ","وَما نَزَعَت عَنهُ السِخابَ الرَبائِبُ",22,"ب",1,0],["وَدَبَّرَهُ اِبنُ مُسلِمَةٍ سَفاهاً","بِرَأيٍ ما أَشارَ بِهِ رَشيدُ",23,"د",1,0],["ودبّ في الجسم من أنفاسها طربٌ","دبيب حبي لهذا الخير منشيها",24,"ي",3,0],["ودبّرهُ تدبير الحفي بعبده","فأنت الذي استخلفته في الخليفْةِ",25,"ه",1,0],["ودبج الروض الؤياح وشيها","منمم الرقم يكاد يقرا",26,"ر",2,0],["ودَبَّت سُلافُ النارِ في قارِ فحمِه","كمادَبَّ نورُ الشمسِ في طَرف الظِّلِّ",27,"ل",1,0],["ودبذ من سقم عينيه إلى جسدي","سقم أشاع نحولا منه في جسدي",28,"د",2,0],["ودبَّ النسيمُ لعيدانهم","فباتت تنوحُ بأوتارها",29,"ر",3,0],["وَدَبّابات","عِندي جِياد",30,"د",1,0],["وَدَبَّ عَلى الوَردِ مَرُّ النَسيمِ","بِرِفق سُحَيراً فَهَبَّ اِنتِباها",31,"ا",3,0],["وَدَبَّجَ الرَوضَ بأَلوانِه","حُسناً وأَحيا الأَرضَ بعد الهُمود",32,"د",1,0],["وَدَبَّ البَياضَ خِلالَ السَوادِ","فَأَصبَحتَ في شِيَةِ الأَشهبِ",33,"ب",1,0],["وَدبَّ عِذارهُ كَالنمل يَسعى","لمبسمه ليرشف مِنهُ شَهدا",34,"د",2,0],["ودَبَّرَهُ بالحلِّ والعقد كاملاً","فبالحلِّ عن روحٍ وبالعقد من تُرب",35,"ب",1,0],["وَدَبَّ تَوريدها في وَجهِهِ خَجَلاً","فَراحَ دَمعِيَ مثل العارض الغَدق",36,"ق",1,0],["ودبَّرْتَ إكسير الرِّياسة والعُلى","بما لا يفي يوماً به علم جابر",37,"ر",1,0],["ودبَّرها بلطفٍ لا بعنفٍ","فأرشَدَها وألهَمَها هداها",38,"ا",3,0],["ودبَّ خمرُ السُّرَى بأَذْرُعِها","فَهْيَ على البِيدِ في عَرَابِيدِ",39,"د",1,0],["ودبّرت أمرا الملك بالدين والحجا","ورأي اصيل في الملمات محكم",40,"م",1,0],["ودبَّت نائباتُ الده","رِ حيَّاتٍ تلوَّيْنا",41,"ن",2,0],["ودَبَى الأرضِ إذا قيل اركبوا","ورواسيها إذا قيل نَزالِ",42,"ل",1,0],["ودبَّا على أمنٍ وخصبٍ فلفَّقا","بجسميهما جسماً يقي ويُمرِّقُ",43,"ق",1,0],["ودبّر الملكَ السحي","لَ رأيُه المستحصِفُ",44,"ف",1,0],["ودبَّر الأيّامَ مرتاضاً بها","فلقَّبته الناهضَ المضطلعا",45,"ع",2,0],["ودبَّروا المجدَ فسدُّوا ما وَلُوا","سدَّ السيوف ثُغَرَ الأغمادِ",46,"د",1,0],["ودبَّر الدنيا على عِلاَّتها","فصَلَحَتْ والدهرُ دهرٌ فاسدُ",47,"د",1,0],["ودبَّر الدنيا برأي واحدٍ","يأنَفُ أن يَشركَه فيها أحدْ",48,"د",1,0],["ودبُّوا لها تحت الظلام عقارباً","ولو حسبوا وطء الأخامِص ما دبُّوا",49,"ب",3,0],["ودب فوق لماه نمل شاربه","فذل أن رضاباً تحنه عسل",50,"ل",1,0],["ودّبج متنَ الأرض نسجُ سمائها","فغودر وجهاً كلّه ذلك المظهر",51,"ر",1,0],["ودبج في الصحائف ما روينا","ليصبح ما رقمته في انتشار",52,"ر",1,0],["وَدَبَّ صِبغُ اللَهيبِ فيهِ بِتَض","ريجِ خُدودِ الشَقائِقِ الضُرُجِ",53,"ج",1,0],["ودبّروا الأمرَ سرّاً وهوَ متّكِلٌ","وربّهُ فوقَ أيديهم يدبّرُهُ",54,"ر",2,0],["ودبّ عِذارُهُ فسعتْ إلينا","أفاعي الموتِ في صُوَر النِّمالِ",55,"ل",1,0]]}