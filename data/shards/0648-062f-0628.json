{"poems":[[55,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[65,"علوت فدونك السبع الشداد","https://www.aldiwan.net/poem46157.html","الوافر"],[65,"مراحك إنه البرق اليماني","https://www.aldiwan.net/poem46172.html","الوافر"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[53,"رقدت وما ليل الغريب براقد","https://www.aldiwan.net/poem61941.html","الطويل"],[93,"إذا سحقت أرضنا القنبله","https://www.aldiwan.net/poem62634.html","عموديه"],[72,"عندي أحاديث أشواق أضن بها","https://www.aldiwan.net/poem42758.html","البسيط"],[87,"رأيت على لوح الخيال يتيمة","https://www.aldiwan.net/poem63690.html","الطويل"],[45,"أود من الأيام مالا توده","https://www.aldiwan.net/poem9553.html","الطويل"],[64,"موازين الطبائع في يدينا","https://www.aldiwan.net/poem52159.html","الوافر"],[92,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[92,"أعيذك أن يعاصيك القصيد","https://www.aldiwan.net/poem60159.html","عموديه"],[54,"صحوت ولكن بعد أي فتون","https://www.aldiwan.net/poem26609.html","الطويل"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[48,"أعن وخد القلاص كشفت حالا","https://www.aldiwan.net/poem23633.html","الوافر"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29360","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/9484","الطويل"],[108,"صدى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179584",""],[102,"كلمة كل نهار","https://www.poetsgate.com/ViewPoem.aspx?id=50427",""],[92,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[16,"طَحَا بكَ قَلبٌ في الحِسان طروبُ","https://www.poetsgate.com/ViewPoem.aspx?id=4900",""],[53,"رقدْتُ وما ليلُ الغريب براقدِ","https://www.poetsgate.com/ViewPoem.aspx?id=28472",""],[53,"أخفُّ مناطاً في الرقاب وأوْكَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=25837",""],[147,"بسعدك دارت في السماء الكواكب","https://www.aldiwan.net/poem11734.html","الطويل"],[147,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[151,"أتت مهنئة فليهن مهديها","https://www.aldiwan.net/poem47653.html","البسيط"],[164,"قضى الله فينا وهو حكم بحكمه","https://www.aldiwan.net/poem58859.html","الطويل"],[164,"يا بحر قلدت أخاك البحرا","https://www.aldiwan.net/poem59050.html","الرجز"],[189,"لقد جمع الكانون نورا وظلمة","https://www.aldiwan.net/poem14621.html","الطويل"],[190,"أفدي الذي عندما أبصرته قدحت","https://www.aldiwan.net/poem43917.html","البسيط"],[203,"أما حدثوك بأخبارها","https://www.aldiwan.net/poem45644.html","المتقارب"],[228,"نحن الأطفال عصب","https://www.aldiwan.net/poem41453.html","عموديه"],[287,"دعا مهجة الصب لا تردعاها","https://www.aldiwan.net/poem32310.html","المتقارب"],[302,"قم هاتها كالنار ذات الوقود","https://www.aldiwan.net/poem33291.html","السريع"],[343,"إذا ما انتسبت إلى آدم","https://www.aldiwan.net/poem68813.html","المتقارب"],[358,"ألام بحبه فأزيد وجدا","https://www.aldiwan.net/poem40390.html","الوافر"],[382,"سمعت بأذني رنة السهمِ في قلبي","https://www.aldiwan.net/poem66952.html","الطويل"],[385,"ما كان أغناك يا قلبي عن القلق","https://www.aldiwan.net/poem48818.html","البسيط"],[422,"أسرك من باد لعينيك حاضر","https://www.aldiwan.net/poem54066.html","الطويل"],[422,"أنيخاها فقد بلغت مناها","https://www.aldiwan.net/poem54083.html","الوافر"],[438,"أرقصها مطرب الأغاريد","https://www.aldiwan.net/poem12414.html","المنسرح"],[443,"قف العيس هذا ربع سلمى فسلم","https://www.aldiwan.net/poem2538.html","الطويل"],[463,"تعالين نعالج نفرة","https://www.aldiwan.net/poem55850.html","الهزج"],[463,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[463,"من العار لولا أن طيفك يطرق","https://www.aldiwan.net/poem56098.html","الطويل"],[463,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[463,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[463,"حرم عليها نزهات الوادي","https://www.aldiwan.net/poem56222.html","البسيط"],[463,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[463,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[463,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[469,"قالوا الإمام عماد الدين معتقل","https://www.aldiwan.net/poem3120.html","عموديه"],[469,"مضى صاحب الصدر الذي حازه الصدر","https://www.aldiwan.net/poem3394.html","عموديه"],[484,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[498,"ومجلس حل من يحل به","https://www.aldiwan.net/poem67406.html","المنسرح"],[519,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[519,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86938","الرجز"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137724",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48729","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77536","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59126","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59090","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59107","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61075","البسيط"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216696",""],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136122","الطويل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76628","الطويل"],[2037,"","https://poetry.dctabudhabi.ae/diwan/poem/34881","الطويل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137926",""],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53065","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27389","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105025","المتقارب"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82205","الرجز"],[2365,"","https://poetry.dctabudhabi.ae/diwan/poem/34715","المتقارب"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121177","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93599","الوافر"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205808","السريع"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68098","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86337","الطويل"],[3550,"","https://poetry.dctabudhabi.ae/diwan/poem/206257","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91161","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85254","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131217",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131218",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114105","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77099","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77152","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45109","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73134","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83547","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83360","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83146","الرمل"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119566","الكامل"],[4520,"","https://poetry.dctabudhabi.ae/diwan/poem/26625","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72831","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120467","الوافر"],[4927,"الشبيح الصفوي","https://www.poetsgate.com/ViewPoem.aspx?id=80796",""],[4935,"لئام الناس أيديها","https://www.poetsgate.com/ViewPoem.aspx?id=129368",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5277,"هروب العائذين","https://www.poetsgate.com/ViewPoem.aspx?id=185702",""],[5277,"القدسُ..القدسُ..يا عربُ","https://www.poetsgate.com/ViewPoem.aspx?id=194614",""],[5399,"حنى الدهر من بعد استقامته ظهري","https://www.poetsgate.com/ViewPoem.aspx?id=181171",""],[5436,"قصيدة أسدلوا الستار","https://www.poetsgate.com/ViewPoem.aspx?id=36243",""],[6020,"قد خرج الهجر على الوصل","https://www.poetsgate.com/ViewPoem.aspx?id=180998",""],[6148,"بشري","https://www.poetsgate.com/ViewPoem.aspx?id=202057",""],[463,"منَ العارِلولا أنَّ طيفكِ يطرقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60159&r=&rc=215",""]],"verses":[["وَدَبَّرَ أَطرافَ الرِماحِ وَإِنَّما","يُدَبِّرُ قَبلَ الطَعنِ رَأياً مُسَدَّدا",0,"د",2,0],["ودبّرَها فدمّرَها برأيٍ","تُجانِبُهُ الإصابةُ والسّدادُ",1,"د",1,0],["ودَبّتْ نَشْوَةُ الخُيَلاءِ فيهمْ","دَبيبَ النّارِ في سَعَفِ الإهانِ",2,"ن",1,0],["ودبَّ كَلالٌ في عظامي أدَبَّني","جَنِيبَ العصا أَنأَدُّ أو أتَأيَّدُ",3,"د",1,0],["ودبَّ عليه الموتُ غضبانَ مسرعاً","باباته من محكمات المصائدِ",4,"د",1,0],["وَدَبَّ الفَنا في ذَواتِ الجَناحِ","وَغَلغَلَ في النَبتِ فَاِستَأصَلَه",5,"ل",2,0],["وُدٌّ بِلا مَلَقٍ مِنّا يُزَخرِفُهُ","يُغني المَليحَةَ عَن حَليٍ وَعَن حُلَلَلِ",6,"ل",1,0],["وَدَبّابَةٍ تَحتَ العُبابِ بِمَكمَنٍ","أَمينٍ تَرى الساري وَلَيسَ يَراها",7,"ا",3,0],["وَدَبِّرهُ تَدبيرَ الَّذي المَجدُ كَفُّهُ","إِذا حارَبَ الأَعداءَ وَالمالُ زَندُهُ",8,"د",2,0],["ودبّر معدن الحكماء واصبر","عليه فهوملك لا يبيدُ",9,"د",1,0],["ودبَّ في القلبِ من تأمورِه ضرمٌ","ما انفكَّ يُثلج صدري حين يُصليني",10,"ن",2,0],["ودبوا فوقها ولهم لحودُ","وذابو تحتها ولهم لحود",11,"د",1,0],["وَدَبَّ مَشيبي بَعضَهُ فَوقَ بَعضِهِ","وَأَخرَجَني مِن أَنفُسٍ وَعُيونِ",12,"ن",1,0],["ودَبَّر المُلْكَ تَدْبيراً يُقَصِّرُ عَنْ","إدْرَاكِ أَيْسَرِهِ الأَفْهَامُ والفِكَرُ",13,"ر",1,0],["وَدَبّتْ فوْقه حُمْرُ المَنَايا","ولكِنْ بَعدما مُسِخَتْ نِمالا",14,"ل",2,0],["ودبلت أمثال الأثافي كأنها","رؤوس نقاد قطعت يوم تجمع",15,"ع",1,0],["وَدِبسِيَّةٌ بِالإِسمِ لَكِنَّ صَوتَها","كَصَوتِ حِمارٍ قَطَّعَ النَهقَ مُفحَما",16,"م",2,1],["ودَبَّ إلى أعْظُم الشُّهَداءِ","فكادَتْ تَهَشُّ بوادي العَدَمْ",17,"م",1,0],["ودب ثان ، خريفي المدى ، قلق","يفني ، ويفنى ، ويحيا ، وهو ينتحر",18,"ر",1,0],["ودبَّتْ مَدَبَّ الروحِ في الكونِ رحمةً","وشدَّتْ لجسمٍ خائرٍ مُتْعَبٍ صُلبا",19,"ب",2,0],["ودُ بنفسٍ، لا يُجادُ بمثلها","وأنتَ بها يوْم اللّقاء تطيبُ",20,"ب",1,0],["ودبَّ إليه الموتُ غضبانَ مسرعاً","باباته من محكمات المصائدِ",21,"د",1,0],["ودبّ كلالٌ في عظامي أدبَّني","ويوصف إلا أنه لا يُحَدّدُ",22,"د",1,0],["وَدَبَّرَ أَمرَ المُلكِ قَبلَ بُلوغِهِ","وَما نَزَعَت عَنهُ السِخابَ الرَبائِبُ",23,"ب",1,0],["وَدَبَّرَهُ اِبنُ مُسلِمَةٍ سَفاهاً","بِرَأيٍ ما أَشارَ بِهِ رَشيدُ",24,"د",1,0],["ودبّ في الجسم من أنفاسها طربٌ","دبيب حبي لهذا الخير منشيها",25,"ي",3,0],["ودبّرهُ تدبير الحفي بعبده","فأنت الذي استخلفته في الخليفْةِ",26,"ه",1,0],["ودبج الروض الؤياح وشيها","منمم الرقم يكاد يقرا",27,"ر",2,0],["ودَبَّت سُلافُ النارِ في قارِ فحمِه","كمادَبَّ نورُ الشمسِ في طَرف الظِّلِّ",28,"ل",1,0],["ودبذ من سقم عينيه إلى جسدي","سقم أشاع نحولا منه في جسدي",29,"د",2,0],["ودبَّ النسيمُ لعيدانهم","فباتت تنوحُ بأوتارها",30,"ر",3,0],["وَدَبّابات","عِندي جِياد",31,"د",1,0],["وَدَبَّ عَلى الوَردِ مَرُّ النَسيمِ","بِرِفق سُحَيراً فَهَبَّ اِنتِباها",32,"ا",3,0],["وَدَبَّجَ الرَوضَ بأَلوانِه","حُسناً وأَحيا الأَرضَ بعد الهُمود",33,"د",1,0],["وَدَبَّ البَياضَ خِلالَ السَوادِ","فَأَصبَحتَ في شِيَةِ الأَشهبِ",34,"ب",1,0],["وَدبَّ عِذارهُ كَالنمل يَسعى","لمبسمه ليرشف مِنهُ شَهدا",35,"د",2,0],["ودَبَّرَهُ بالحلِّ والعقد كاملاً","فبالحلِّ عن روحٍ وبالعقد من تُرب",36,"ب",1,0],["وَدَبَّ تَوريدها في وَجهِهِ خَجَلاً","فَراحَ دَمعِيَ مثل العارض الغَدق",37,"ق",1,0],["ودبَّرْتَ إكسير الرِّياسة والعُلى","بما لا يفي يوماً به علم جابر",38,"ر",1,0],["ودبَّرها بلطفٍ لا بعنفٍ","فأرشَدَها وألهَمَها هداها",39,"ا",3,0],["ودبَّ خمرُ السُّرَى بأَذْرُعِها","فَهْيَ على البِيدِ في عَرَابِيدِ",40,"د",1,0],["ودبّرت أمرا الملك بالدين والحجا","ورأي اصيل في الملمات محكم",41,"م",1,0],["ودبَّت نائباتُ الده","رِ حيَّاتٍ تلوَّيْنا",42,"ن",2,0],["ودَبَى الأرضِ إذا قيل اركبوا","ورواسيها إذا قيل نَزالِ",43,"ل",1,0],["ودبَّا على أمنٍ وخصبٍ فلفَّقا","بجسميهما جسماً يقي ويُمرِّقُ",44,"ق",1,0],["ودبّر الملكَ السحي","لَ رأيُه المستحصِفُ",45,"ف",1,0],["ودبَّر الأيّامَ مرتاضاً بها","فلقَّبته الناهضَ المضطلعا",46,"ع",2,0],["ودبَّروا المجدَ فسدُّوا ما وَلُوا","سدَّ السيوف ثُغَرَ الأغمادِ",47,"د",1,0],["ودبَّر الدنيا على عِلاَّتها","فصَلَحَتْ والدهرُ دهرٌ فاسدُ",48,"د",1,0],["ودبَّر الدنيا برأي واحدٍ","يأنَفُ أن يَشركَه فيها أحدْ",49,"د",1,0],["ودبُّوا لها تحت الظلام عقارباً","ولو حسبوا وطء الأخامِص ما دبُّوا",50,"ب",3,0],["ودب فوق لماه نمل شاربه","فذل أن رضاباً تحنه عسل",51,"ل",1,0],["ودّبج متنَ الأرض نسجُ سمائها","فغودر وجهاً كلّه ذلك المظهر",52,"ر",1,0],["ودبج في الصحائف ما روينا","ليصبح ما رقمته في انتشار",53,"ر",1,0],["وَدَبَّ صِبغُ اللَهيبِ فيهِ بِتَض","ريجِ خُدودِ الشَقائِقِ الضُرُجِ",54,"ج",1,0],["ودبّروا الأمرَ سرّاً وهوَ متّكِلٌ","وربّهُ فوقَ أيديهم يدبّرُهُ",55,"ر",2,0],["ودبّ عِذارُهُ فسعتْ إلينا","أفاعي الموتِ في صُوَر النِّمالِ",56,"ل",1,0],["وَدبرت لي حيلة","لِغارس ما قَد غَرَس",57,"س",1,0],["ودبوس شعر بدر ترص","ع فيها كما علم يجعل",58,"ل",1,0],["ودبرت أمراً بعد أمر مجرباً","عسى تخلف اليوم العيوبَ المحاسن",59,"ن",1,0],["وَدبَّ في الكنز وَفيهِ ما اِحترك","لِأَن هَذا الكنز كانَ في الشرك",60,"ك",1,0],["وَدَبَّجَ مِرْطَ النَّقْعِ بِالخَيْلِ وَالظُّبَى","فَأسْيَافُهُ بِيِضٌ وَأفْرَاسُهُ نَبْطُ",61,"ط",1,0],["وَدَبَّجَتْ رَاحَةُ الحُسْنَى لَهُ حُلَلاً","أبْهَى وَأبْهَرَ مِنْ تَدْبِيجِ صنعاءِ",62,"ا",2,0],["وَدَبَّ عِذَارُ الاسِ فِي وردِ خَده","كَمَا جَالَ صدغ الظِّلّ في وجنة النهرِ",63,"ر",1,0],["وَدَبجت فَوقَ مَتن الروض مِن حلل","وَنمقتهُ بِأَلوان مِن الزهر",64,"ر",1,0],["ودْبَيّ في ثوب الزفافِ","تختال بين الخرّد الغيد",65,"د",1,0],["ودبج اكناف المصلى ورامة","بغيث هتون ينبت الزع والعشبا",66,"ب",2,0],["ودبت من الأصداغ فيه عقارب","لها في فؤاد المستهام دبيب",67,"ب",1,0],["وَدَبّابَةٍ لا أَحسَنَ اللَهُ حِفظَها","تَظَلُّ عَلى غَلّاتِنا تَتَطَوَّفُ",68,"ف",1,0],["ودب اليه في القوقاس سوس ال","خطوب وعظمه اوهاه نخرا",69,"ر",2,0],["وَدَّ بها المغرم لو أنه","ذاق الردى من قبلها فاستراحْ",70,"ح",1,0],["ودَبور تأتي خلفه لتسوقه","لصبا القبول لكونها تستقبل",71,"ل",1,0],["ودبَّت عقارب أصداغه","على الخد تحرس ورداً أنق",72,"ق",1,0],["ودب بين كبدي ومحزمي","وساطه الله بلحمي ودمي",73,"م",2,0],["وَدَبّابَةٌ مِن ذَواتِ القُ","رونِ حَسراءُ مُفسِدَةٌ فاسِدَه",74,"د",2,0],["ودبجت من نسج الخيال مطارفا","ممسكة الاردان قد عبقت نشرا",75,"ر",2,0],["وَدب النمل كَي يشتار مِنهُ","فَلَما أَن رَأى النار اِستَدارا",76,"ر",2,0],["ودبَّ في نفسي دبيب المنى","والبرء في اليأس والموجع",77,"ع",1,0],["ودَبَّر الرزق تَقْديراً بحكمته","والكونُ أمسى أسيراً رَهْنَ قَبضته",78,"ه",1,0],["وَدَبَّت اِفاعي صَدغِها مِن سَوالِفٍ","فَيا وَيلَ قَلبي مِن اِفاعي السَوالِفِ",79,"ف",1,0],["ودبرها بتدبير لطيف","حكاه عن سنان أو حنين",80,"ن",1,0],["وَدبّر وَالأَقدار تُمضي سِهامَها","وَحاربها وَالحَظ هيْنٌ مسالم",81,"م",1,0],["ودبت به روح الصبابة فاستوى","ولو كان محمولاً حوته الجنائز",82,"ز",1,0],["ودبابة في جوفها الويل كامنٌ","تسير ولا يبدو هنالك راكب",83,"ب",1,0],["ودبابة فولاذها يصدع الصفا","ورشاشها كالمغدقات همول",84,"ل",1,0],["وَدَبُّهُمُ والدَّبُّ عَنهُم وَهَديُهُم","وَهَديٌ لَهُم وَإِن غَنُوا عَن أدِلَّةِ",85,"ل",2,0],["وَدَبَت إِلى خَدّي عَقارِبُ صَدغِها","تَمج عَلَيهِ المِسكُ مِن إِبر الشِعر",86,"ر",1,0],["وَدُبتَ مِنَ الأَصداغِ سودَ عَقارِب","لِتَمنَعَ في حُرِّ الهَوى مَورِدَ اللَمى",87,"م",2,0],["وَدَبَّجَتها سَما نيسانُ فاِبتَهَجَت","وَقامَت الطَيرُ في أَفنانِها خُطَبا",88,"ب",2,0],["وُدبجِّت لكِ يا سَطر سُطورُ ربيً","منَ الرِّياضِ لَها بالزَّهرِ ألوانُ",89,"ن",1,0],["وَدَبَّ بِها البَلا من كلّ صَوبٍ","وَأَيمُ اللَهِ دَبَّ بِها دَبيبا",90,"ب",2,0],["وَدبِّر شُؤوني منعِماً مُتَفَضِّلاً","فَما لي بِشَأنٍ مِن شُؤوني مدَبِّرُ",91,"ر",1,0],["وَدَبيبَ الحُبِّ في أَوَّله","وَالجَوى مُلتَهِباً حِينَ تَناهى",92,"ا",3,0],["ود بدا لذوي الاخاء جميلة","وبدت عليه بهجة وقبول",93,"ل",1,0],["وَدَبَّ هَواها في عِظامي فَشَفَّها","كَما دَبَّ في المَلسوعِ سُمُّ العَقارِبِ",94,"ب",1,0],["ودبّجتِ الخضراءَ في كل زهرة","بمختلَفِ الألوانِ جاء معطّرُ",95,"ر",1,0],["ودبر كل امر بالتاني","فتم على ارادتها المراد",96,"د",1,0],["وَدَبَّتْ بِأَهْلِ اللاْذِقِيَّةِ نَخْوَةٌ","وَخَاْفَتْ جُمُوْعَ الْمُنْتَخِيْنَ الثَّعَاْلِبُ",97,"ب",1,0],["ودب دبيبها فينا","فالقتا على الجمر",98,"ر",1,0],["ودبر مسيري في مدارج غيبه","على قدر في السير لا أتعداه",99,"ا",2,0],["ودَبَتْ دبيبَ الزاحفاتِ بحسّه","كي تستعيذ من الجفا بعتابهِ",100,"ب",2,0],["ودبَّ فينا من الأدواءِ ما عجزتْ","عنهُ الأطباءُ...دبَّ الوهْنُ والتعبُ",101,"ب",1,0],["ودب البلى في كل عضو ومفصل","ومن ذا الذي يبقى سليماً على الدهر؟",102,"ر",1,0],["وَدَباباتكُمْ: أَبهَا انتفَاعٌ","لغَيْرِ العَرْضِ إِنْ زُعِمَ انتصَارُ؟",103,"ر",1,0],["ودبق الهجر جناح الهوى","وانفلت الوصل من البخل",104,"ل",1,0],["ودبيب دمعك في عيونك صدفة","وحنين كفك للوليد تبسما",105,"م",2,0],["ودبَّاً على أمنٍ وخصبٍ فلفَّقا","بجسمها جسماً يقي ويمرِّقُ",106,"ق",1,0]]}