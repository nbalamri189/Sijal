{"poems":[[55,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[65,"علوت فدونك السبع الشداد","https://www.aldiwan.net/poem46157.html","الوافر"],[65,"مراحك إنه البرق اليماني","https://www.aldiwan.net/poem46172.html","الوافر"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[53,"رقدت وما ليل الغريب براقد","https://www.aldiwan.net/poem61941.html","الطويل"],[93,"إذا سحقت أرضنا القنبله","https://www.aldiwan.net/poem62634.html","عموديه"],[72,"عندي أحاديث أشواق أضن بها","https://www.aldiwan.net/poem42758.html","البسيط"],[87,"رأيت على لوح الخيال يتيمة","https://www.aldiwan.net/poem63690.html","الطويل"],[45,"أود من الأيام مالا توده","https://www.aldiwan.net/poem9553.html","الطويل"],[64,"موازين الطبائع في يدينا","https://www.aldiwan.net/poem52159.html","الوافر"],[92,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[92,"أعيذك أن يعاصيك القصيد","https://www.aldiwan.net/poem60159.html","عموديه"],[54,"صحوت ولكن بعد أي فتون","https://www.aldiwan.net/poem26609.html","الطويل"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[48,"أعن وخد القلاص كشفت حالا","https://www.aldiwan.net/poem23633.html","الوافر"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29360","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/9484","الطويل"],[108,"صدى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179584",""],[102,"كلمة كل نهار","https://www.poetsgate.com/ViewPoem.aspx?id=50427",""],[92,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[16,"طَحَا بكَ قَلبٌ في الحِسان طروبُ","https://www.poetsgate.com/ViewPoem.aspx?id=4900",""],[53,"رقدْتُ وما ليلُ الغريب براقدِ","https://www.poetsgate.com/ViewPoem.aspx?id=28472",""],[53,"أخفُّ مناطاً في الرقاب وأوْكَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=25837",""],[146,"بسعدك دارت في السماء الكواكب","https://www.aldiwan.net/poem11734.html","الطويل"],[146,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[150,"أتت مهنئة فليهن مهديها","https://www.aldiwan.net/poem47653.html","البسيط"],[163,"قضى الله فينا وهو حكم بحكمه","https://www.aldiwan.net/poem58859.html","الطويل"],[163,"يا بحر قلدت أخاك البحرا","https://www.aldiwan.net/poem59050.html","الرجز"],[188,"لقد جمع الكانون نورا وظلمة","https://www.aldiwan.net/poem14621.html","الطويل"],[189,"أفدي الذي عندما أبصرته قدحت","https://www.aldiwan.net/poem43917.html","البسيط"],[202,"أما حدثوك بأخبارها","https://www.aldiwan.net/poem45644.html","المتقارب"],[226,"نحن الأطفال عصب","https://www.aldiwan.net/poem41453.html","عموديه"],[285,"دعا مهجة الصب لا تردعاها","https://www.aldiwan.net/poem32310.html","المتقارب"],[300,"قم هاتها كالنار ذات الوقود","https://www.aldiwan.net/poem33291.html","السريع"],[341,"إذا ما انتسبت إلى آدم","https://www.aldiwan.net/poem68813.html","المتقارب"],[356,"ألام بحبه فأزيد وجدا","https://www.aldiwan.net/poem40390.html","الوافر"],[380,"سمعت بأذني رنة السهمِ في قلبي","https://www.aldiwan.net/poem66952.html","الطويل"],[383,"ما كان أغناك يا قلبي عن القلق","https://www.aldiwan.net/poem48818.html","البسيط"],[419,"أسرك من باد لعينيك حاضر","https://www.aldiwan.net/poem54066.html","الطويل"],[419,"أنيخاها فقد بلغت مناها","https://www.aldiwan.net/poem54083.html","الوافر"],[435,"أرقصها مطرب الأغاريد","https://www.aldiwan.net/poem12414.html","المنسرح"],[440,"قف العيس هذا ربع سلمى فسلم","https://www.aldiwan.net/poem2538.html","الطويل"],[460,"تعالين نعالج نفرة","https://www.aldiwan.net/poem55850.html","الهزج"],[460,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[460,"من العار لولا أن طيفك يطرق","https://www.aldiwan.net/poem56098.html","الطويل"],[460,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[460,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[460,"حرم عليها نزهات الوادي","https://www.aldiwan.net/poem56222.html","البسيط"],[460,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[460,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[460,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[466,"قالوا الإمام عماد الدين معتقل","https://www.aldiwan.net/poem3120.html","عموديه"],[466,"مضى صاحب الصدر الذي حازه الصدر","https://www.aldiwan.net/poem3394.html","عموديه"],[481,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[495,"ومجلس حل من يحل به","https://www.aldiwan.net/poem67406.html","المنسرح"],[516,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[516,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[1169,"","https://poetry.dctabudhabi.ae/diwan/poem/26625","الطويل"]],"verses":[["وَدَبَّرَ أَطرافَ الرِماحِ وَإِنَّما","يُدَبِّرُ قَبلَ الطَعنِ رَأياً مُسَدَّدا",0,"د",2,0],["ودبّرَها فدمّرَها برأيٍ","تُجانِبُهُ الإصابةُ والسّدادُ",1,"د",1,0],["ودَبّتْ نَشْوَةُ الخُيَلاءِ فيهمْ","دَبيبَ النّارِ في سَعَفِ الإهانِ",2,"ن",1,0],["ودبَّ كَلالٌ في عظامي أدَبَّني","جَنِيبَ العصا أَنأَدُّ أو أتَأيَّدُ",3,"د",1,0],["ودبَّ عليه الموتُ غضبانَ مسرعاً","باباته من محكمات المصائدِ",4,"د",1,0],["وَدَبَّ الفَنا في ذَواتِ الجَناحِ","وَغَلغَلَ في النَبتِ فَاِستَأصَلَه",5,"ل",2,0],["وُدٌّ بِلا مَلَقٍ مِنّا يُزَخرِفُهُ","يُغني المَليحَةَ عَن حَليٍ وَعَن حُلَلَلِ",6,"ل",1,0],["وَدَبّابَةٍ تَحتَ العُبابِ بِمَكمَنٍ","أَمينٍ تَرى الساري وَلَيسَ يَراها",7,"ا",3,0],["وَدَبِّرهُ تَدبيرَ الَّذي المَجدُ كَفُّهُ","إِذا حارَبَ الأَعداءَ وَالمالُ زَندُهُ",8,"د",2,0],["ودبّر معدن الحكماء واصبر","عليه فهوملك لا يبيدُ",9,"د",1,0],["ودبَّ في القلبِ من تأمورِه ضرمٌ","ما انفكَّ يُثلج صدري حين يُصليني",10,"ن",2,0],["ودبوا فوقها ولهم لحودُ","وذابو تحتها ولهم لحود",11,"د",1,0],["وَدَبَّ مَشيبي بَعضَهُ فَوقَ بَعضِهِ","وَأَخرَجَني مِن أَنفُسٍ وَعُيونِ",12,"ن",1,0],["ودَبَّر المُلْكَ تَدْبيراً يُقَصِّرُ عَنْ","إدْرَاكِ أَيْسَرِهِ الأَفْهَامُ والفِكَرُ",13,"ر",1,0],["وَدَبّتْ فوْقه حُمْرُ المَنَايا","ولكِنْ بَعدما مُسِخَتْ نِمالا",14,"ل",2,0],["ودبلت أمثال الأثافي كأنها","رؤوس نقاد قطعت يوم تجمع",15,"ع",1,0],["وَدِبسِيَّةٌ بِالإِسمِ لَكِنَّ صَوتَها","كَصَوتِ حِمارٍ قَطَّعَ النَهقَ مُفحَما",16,"م",2,1],["ودَبَّ إلى أعْظُم الشُّهَداءِ","فكادَتْ تَهَشُّ بوادي العَدَمْ",17,"م",1,0],["ودب ثان ، خريفي المدى ، قلق","يفني ، ويفنى ، ويحيا ، وهو ينتحر",18,"ر",1,0],["ودبَّتْ مَدَبَّ الروحِ في الكونِ رحمةً","وشدَّتْ لجسمٍ خائرٍ مُتْعَبٍ صُلبا",19,"ب",2,0],["ودُ بنفسٍ، لا يُجادُ بمثلها","وأنتَ بها يوْم اللّقاء تطيبُ",20,"ب",1,0],["ودبَّ إليه الموتُ غضبانَ مسرعاً","باباته من محكمات المصائدِ",21,"د",1,0],["ودبّ كلالٌ في عظامي أدبَّني","ويوصف إلا أنه لا يُحَدّدُ",22,"د",1,0],["وَدَبَّرَ أَمرَ المُلكِ قَبلَ بُلوغِهِ","وَما نَزَعَت عَنهُ السِخابَ الرَبائِبُ",23,"ب",1,0],["وَدَبَّرَهُ اِبنُ مُسلِمَةٍ سَفاهاً","بِرَأيٍ ما أَشارَ بِهِ رَشيدُ",24,"د",1,0],["ودبّ في الجسم من أنفاسها طربٌ","دبيب حبي لهذا الخير منشيها",25,"ي",3,0],["ودبّرهُ تدبير الحفي بعبده","فأنت الذي استخلفته في الخليفْةِ",26,"ه",1,0],["ودبج الروض الؤياح وشيها","منمم الرقم يكاد يقرا",27,"ر",2,0],["ودَبَّت سُلافُ النارِ في قارِ فحمِه","كمادَبَّ نورُ الشمسِ في طَرف الظِّلِّ",28,"ل",1,0],["ودبذ من سقم عينيه إلى جسدي","سقم أشاع نحولا منه في جسدي",29,"د",2,0],["ودبَّ النسيمُ لعيدانهم","فباتت تنوحُ بأوتارها",30,"ر",3,0],["وَدَبّابات","عِندي جِياد",31,"د",1,0],["وَدَبَّ عَلى الوَردِ مَرُّ النَسيمِ","بِرِفق سُحَيراً فَهَبَّ اِنتِباها",32,"ا",3,0],["وَدَبَّجَ الرَوضَ بأَلوانِه","حُسناً وأَحيا الأَرضَ بعد الهُمود",33,"د",1,0],["وَدَبَّ البَياضَ خِلالَ السَوادِ","فَأَصبَحتَ في شِيَةِ الأَشهبِ",34,"ب",1,0],["وَدبَّ عِذارهُ كَالنمل يَسعى","لمبسمه ليرشف مِنهُ شَهدا",35,"د",2,0],["ودَبَّرَهُ بالحلِّ والعقد كاملاً","فبالحلِّ عن روحٍ وبالعقد من تُرب",36,"ب",1,0],["وَدَبَّ تَوريدها في وَجهِهِ خَجَلاً","فَراحَ دَمعِيَ مثل العارض الغَدق",37,"ق",1,0],["ودبَّرْتَ إكسير الرِّياسة والعُلى","بما لا يفي يوماً به علم جابر",38,"ر",1,0],["ودبَّرها بلطفٍ لا بعنفٍ","فأرشَدَها وألهَمَها هداها",39,"ا",3,0],["ودبَّ خمرُ السُّرَى بأَذْرُعِها","فَهْيَ على البِيدِ في عَرَابِيدِ",40,"د",1,0],["ودبّرت أمرا الملك بالدين والحجا","ورأي اصيل في الملمات محكم",41,"م",1,0],["ودبَّت نائباتُ الده","رِ حيَّاتٍ تلوَّيْنا",42,"ن",2,0],["ودَبَى الأرضِ إذا قيل اركبوا","ورواسيها إذا قيل نَزالِ",43,"ل",1,0],["ودبَّا على أمنٍ وخصبٍ فلفَّقا","بجسميهما جسماً يقي ويُمرِّقُ",44,"ق",1,0],["ودبّر الملكَ السحي","لَ رأيُه المستحصِفُ",45,"ف",1,0],["ودبَّر الأيّامَ مرتاضاً بها","فلقَّبته الناهضَ المضطلعا",46,"ع",2,0],["ودبَّروا المجدَ فسدُّوا ما وَلُوا","سدَّ السيوف ثُغَرَ الأغمادِ",47,"د",1,0],["ودبَّر الدنيا على عِلاَّتها","فصَلَحَتْ والدهرُ دهرٌ فاسدُ",48,"د",1,0],["ودبَّر الدنيا برأي واحدٍ","يأنَفُ أن يَشركَه فيها أحدْ",49,"د",1,0],["ودبُّوا لها تحت الظلام عقارباً","ولو حسبوا وطء الأخامِص ما دبُّوا",50,"ب",3,0],["ودب فوق لماه نمل شاربه","فذل أن رضاباً تحنه عسل",51,"ل",1,0],["ودّبج متنَ الأرض نسجُ سمائها","فغودر وجهاً كلّه ذلك المظهر",52,"ر",1,0],["ودبج في الصحائف ما روينا","ليصبح ما رقمته في انتشار",53,"ر",1,0],["وَدَبَّ صِبغُ اللَهيبِ فيهِ بِتَض","ريجِ خُدودِ الشَقائِقِ الضُرُجِ",54,"ج",1,0],["ودبّروا الأمرَ سرّاً وهوَ متّكِلٌ","وربّهُ فوقَ أيديهم يدبّرُهُ",55,"ر",2,0],["ودبّ عِذارُهُ فسعتْ إلينا","أفاعي الموتِ في صُوَر النِّمالِ",56,"ل",1,0],["وَدَبَّ هَواها في عِظامي فَشَفَّها","كَما دَبَّ في المَلسوعِ سُمُّ العَقارِبِ",57,"ب",1,0]]}