{"poems":[[3,"يا دار أين ترحل السكان","https://www.aldiwan.net/poem218.html",""],[88,"كم تحت أذيال الظلام متيم","https://www.aldiwan.net/poem10862.html","الكامل"],[90,"قل للحكومات في البلقان هل علقت","https://www.aldiwan.net/poem44467.html","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141960","البسيط"],[146,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[228,"وما سرى في مقاصير اللظى خبر","https://www.aldiwan.net/poem41466.html","البسيط"],[325,"بك العلا تظاهر","https://www.aldiwan.net/poem67198.html","مجزوء الرجز"],[371,"أما ومنك على أعدائك الطلب","https://www.aldiwan.net/poem17155.html","البسيط"],[463,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[500,"أنعت جهما لم أجد فيما مضى","https://www.aldiwan.net/poem10223.html","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48563","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48593","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79998","الكامل"],[1661,"","https://poetry.dctabudhabi.ae/diwan/poem/67814","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47166","الكامل"],[4110,"","https://poetry.dctabudhabi.ae/diwan/poem/101162","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45011","البسيط"],[4755,"سِيرَةُ أَيلُول","https://www.poetsgate.com/ViewPoem.aspx?id=183562",""],[5616,"حماس","https://www.poetsgate.com/ViewPoem.aspx?id=205248",""],[5688,"الجيش الأبيض","https://www.poetsgate.com/ViewPoem.aspx?id=213689",""],[5790,"الله أكبر أي طرف يطمح","https://www.poetsgate.com/ViewPoem.aspx?id=111868",""],[6093,"الهاربة إلى المجهول","https://www.poetsgate.com/ViewPoem.aspx?id=202107",""]],"verses":[["حَتّى أَطيرَ مُسائِلاً عَن عَبلَةٍ","إِن كانَ يُمكِنُ مِثلِيَ الطَيَرانُ",0,"ن",1,0],["حَتّى اِطمَأَنَّت بِالشِفاءِ نُفوسُهُم","وَطَلَعتَ بِالسَعدِ العَميمِ عَلَيهِمُ",1,"م",1,0],["حتى اطمأنّت قلوب الناس هادئة","وكل قلب لكم من غَيظه ناز",2,"ز",1,0],["حتى أطلا على مصر فراعهما","ما زخرف النيل من إبداع ساحره",3,"ر",2,0],["حتى اطمأنَّ من الوزارة نافرٌ","وثُنى إليه لِيتُها والأَخدعُ",4,"ع",1,0],["حَتّى أَطَلَّت مِن الأَشباحِ طائِفَة","في هودجٍ يَتَنَزّى تَحتَهُ الشررُ",5,"ر",1,0],["حَتّى أَطيرَ فَرحَةً","وَمَن أَوَدُّ ناظِرُ",6,"ر",1,0],["حَتّى أَطَرتَ رِقاباً ما لَهُنَّ دَمٌ","وَحُزتَ نَهبَ نُفوسٍ ما لَها سَلَبُ",7,"ب",1,0],["حتى اطَّلعتُ وغربهُ","يبكي عليه ومشرِقُهْ",8,"ق",2,0],["حتى أطيل في الثناء وأعرضا","حجر على عيني أن تغتمضا",9,"ض",2,0],["حتى اطلعت على موارد رزقه","وعلمت نائي ملكه والداني",10,"ن",2,0],["حتى أطلَّت وهي قائلة","من في الدياجي ينشد الشعرا",11,"ر",2,0],["حتَّى أطلَّ بوثبةٍ فتبيَّنت","ذاك الوعيدَ بيومها الموعود",12,"د",1,0],["حتى اطمأن ضميره وكأنما","هتك العلائن عامل وسنانه",13,"ن",2,0],["حتى أطاعَكَ فيهُمُ النّصر الذي","خضعوا به قَسْراً خضوعَ لِئَام",14,"م",1,0],["حتى أطل على الأنام بمدهش","ذهبت به الآراء والأحلام",15,"م",1,0],["حَتّى أَطيرَ سُرورّا في الحَياةِ وَفي","يَوِ المَعادِ إِذا ما الناسُ في دَهَشِ",16,"ش",1,0],["حتَّى أَطَلَّ الفَجْرُ مُسْتَجْمِعًا","أنوَارَهُ الظَّمْأَى لِكَي يَثأَرَا",17,"ر",2,0],["حتى أطلَّت كالصباحِ (حَماسُنا)","وحُداؤها التهليل والتكبيرُ",18,"ر",1,0],["حَتَّى أَطَلَّ وَبَاءُ كُورُونَا الذِي","صَارَتْ صَرَاصِرَ عِنْدَهُ الآسَادُ",19,"د",1,0],["حتى أطوف بذلك الحرم الذي","ما فاز إلا من به يتمسح",20,"ح",1,0],["حتَّى أطعتِ له وعدَاً لِزخرفهِ","حُلمُ المُراهقِ كم أوْدَى لنا وَلدَا",21,"د",2,0]]}