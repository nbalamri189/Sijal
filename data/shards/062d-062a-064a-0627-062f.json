{"poems":[[53,"أمسى الشباب رداء عنك مستلبا","https://www.aldiwan.net/poem8649.html","البسيط"],[53,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[52,"يا طول هذا الليل لم أرقد","https://www.aldiwan.net/poem63954.html","السريع"],[53,"أما الزمانُ إلى سلمى فقد جَنَحا","https://www.poetsgate.com/ViewPoem.aspx?id=27419",""],[362,"يا خيل محيي ملة الإسلام","https://www.aldiwan.net/poem4147.html","الكامل"],[409,"زارت فكان لها الفؤاد مقيلا","https://www.aldiwan.net/poem33489.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68025","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[5401,"السندان والطارق","https://www.poetsgate.com/ViewPoem.aspx?id=78140",""],[5442,"يا مظهر حب الرسول وجهله","https://www.poetsgate.com/ViewPoem.aspx?id=114781",""]],"verses":[["حتى أدالك عنها ثم أبدلها","كفؤاً رضيّاً لذات اللَه مُنتَجَبا",0,"ب",2,0],["حتى أدِلْتُمْ وهبّتْ ريح نصركمُ","وخاب وجه عدو الحق وافتضخا",1,"خ",2,0],["حَتّى أَدَلَّت بَل ثَنى لُبَّها","عَنّي مَقالُ الكاشِحِ المُفسِدِ",2,"د",1,0],["حتى أدِلْتُمْ وهبّتْ ريح نصركمُ","وخاب وجه عدو الحق وافتضحا",3,"ح",2,0],["حَتَّى أَدامَ عَلَى الزَّمَانِ وَأهلِهِ","نِعَماً تَبَزُّ حوادث الأيَّامِ",4,"م",1,0],["حتى أدار علي كأس بلاغة","وسقى المسامع باليراع شمولا",5,"ل",2,0],["حتى أداخ كل غاو ناصب","وافتتح الشرق مع المغارب",6,"ب",1,0],["حَتَّى أُدَسَّ صاغِراً","فِي جَدثٍ مُلتئمِ",7,"م",1,0],["حتى ادَّعى بأنه نصراني","أخفُّ وصفٍ عنده القيادهْ",8,"ه",1,0],["حتى أدركتني رصاصة مشعلٍ خارق","من عين قناص مركي لي على الكوعي",9,"ع",2,0],["حتى أدالهم وصب بنصره","منهم على الكفار سوط عذابه",10,"ب",2,0]]}