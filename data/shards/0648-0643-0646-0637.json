{"poems":[[55,"ليس على الشيب للغواني","https://www.aldiwan.net/poem30431.html","مجزوء البسيط"],[60,"ترد رداء الصبر عند النوائب","https://www.aldiwan.net/poem31184.html","الطويل"],[382,"أمانا لقلب طال فيه اعتناؤه","https://www.aldiwan.net/poem66968.html","الطويل"],[396,"سلام على أهل الظنون الجميلة","https://www.aldiwan.net/poem54605.html","عموديه"],[2031,"","https://poetry.dctabudhabi.ae/diwan/poem/140123",""],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71312","المنسرح"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83192","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58005","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58006","الطويل"]],"verses":[["وَكُنَّ طَربى إِلى طُروقي","إِذ لَيلُ رَأسي بِلا دَراري",0,"ر",2,0],["وَكُن طالِباً لِلرِزقِ مِن بابِ حِلَّةٍ","يُضاعَف عَلَيكَ الرِزقُ مِن كُلِّ جانِبِ",1,"ب",1,0],["وكن طَلِقاً فالبِشرُ في الوجه يا أخي","دليلٌ كما قد دل عنه جفاؤه",2,"ا",3,0],["وكن طالب للعلم واعمل به تنل","من الله توفيقا لسيل الهداية",3,"ه",1,0],["وكن طالبا تبغى إقامة سنة","فقلدتها عن سادة من ذوي الستر",4,"ر",1,0],["وَكُنْ طُفَيْلَتَهُمْ عَلى أَدَبٍ","فَمَا أَرَى شَافِعاً سِوىَ الأَدَبِ",5,"ب",1,0],["وَكُن طَريفَ القَولِ وَالمُحاضَرَه","وَكُن رَقيقاً حَسَن المسامَرَه",6,"ه",1,0],["وكن طامعاً فيه سؤولاً لفضله","يُفِدْك غِنى الدارين غير مُبَدَّدِ",7,"د",1,0],["وكن طامعاً فيه سَؤولاً لفضله","يُفِدْك عني الدارين غير مُبَدَّد",8,"د",1,0]]}