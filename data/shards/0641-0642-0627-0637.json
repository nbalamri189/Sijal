{"poems":[[93,"قالت وصفت لنا الرحيق وكوبها","https://www.aldiwan.net/poem8857.html","عموديه"],[68,"قد أيقظ الصبح ذوات الجناح","https://www.aldiwan.net/poem39082.html","السريع"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[371,"وقفنا على قصر العزيز وقد عفا","https://www.aldiwan.net/poem17353.html","الطويل"],[466,"أبا الفوارس والأيام شاهدة","https://www.aldiwan.net/poem15151.html","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64721","السريع"],[3557,"","https://poetry.dctabudhabi.ae/diwan/poem/140210",""],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"]],"verses":[["فَقاطَعَتني وَقالَت قَد بَعدتَ بِنا","ما ذي الصِفاتُ الشاعِرِ الفَطِنِ",0,"ن",1,0],["فَقاطِعِ الغُمضَ وَصِل نَشوَةً","توليكَ مِن بَعدِ الصِبا صَبوَةً",1,"ه",1,0],["فقاطعُ الوِصالِ","كقاطع الأَوصالِ",2,"ل",1,0],["فَقاطِع بِنا أَبناءَ حَوّا وَآدَمٍ","وَواصِل بِنا آلَ الجُدَيلِ وَشَدقَما",3,"م",2,0],["فقاطعٌ وسيوف الهند نابيةٌ","ونافذٌ ونحور الحُمْسِ تنقصِمُ",4,"م",1,0],["فقاطِعْ مَنْ يَصُدُّكَ عَنْ سُرورٍ","وصِلْ بُعرَا الغَبُوقِ عُرَا الصُّبوح",5,"ح",1,0],["فقاطعتُها لِيناً وقلتُ لها اسمعي","حديثَ الهوى ليلاً معَ الأنجُمِ الزُّهْر",6,"ر",1,0],["فَقاطَعتُ نِدماني وَواصَلتُ لَوعَتي","وَهاجَرتُ أَوطاني فَبانَت مَرابِعُ",7,"ع",1,0]]}