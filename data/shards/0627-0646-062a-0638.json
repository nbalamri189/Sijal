{"poems":[[90,"أقول لصاحبي والشمس تدنو","https://www.aldiwan.net/poem44416.html","الوافر"],[91,"وصف الدنيا كثيرون","https://www.aldiwan.net/poem44886.html","مجزوء الرمل"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[99,"يا من طواها الليل في ظلمائه","https://www.aldiwan.net/poem24355.html","الكامل"],[71,"","https://poetry.dctabudhabi.ae/diwan/poem/57154","الرمل"],[396,"يا علي ماتوا اللي مانباهم يموتون","https://www.aldiwan.net/poem54469.html","عموديه"],[422,"شرف البصرة مولانا المشير","https://www.aldiwan.net/poem54069.html","الرمل"],[438,"هذا اللوى لا حط منه لواء","https://www.aldiwan.net/poem12549.html","الكامل"],[458,"اضحكوا ثم اضحكوا يا هازلين","https://www.aldiwan.net/poem61608.html","الرمل"],[505,"قل لمستصغرنا عن حسد","https://www.aldiwan.net/poem38008.html","الرمل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138257",""],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59785","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109138","البسيط"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82355","الخفيف"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115837","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93954","الخفيف"],[3271,"","https://poetry.dctabudhabi.ae/diwan/poem/142240","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216832","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205881","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29303","الخفيف"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123868","الخفيف"],[4715,"مرثية أمي","https://www.poetsgate.com/ViewPoem.aspx?id=204454",""],[4739,"عاشقك","https://www.poetsgate.com/ViewPoem.aspx?id=28042",""],[4767,"ساعة الصفر","https://www.poetsgate.com/ViewPoem.aspx?id=179844",""],[5012,"كف شالت شموع","https://www.poetsgate.com/ViewPoem.aspx?id=22795",""],[5055,"صوت العيد","https://www.poetsgate.com/ViewPoem.aspx?id=101656",""],[5061,"في المطار","https://www.poetsgate.com/ViewPoem.aspx?id=155988",""],[5064,"أحزَان الشّارع اللّيلي","https://www.poetsgate.com/ViewPoem.aspx?id=199144",""],[5111,"غَسَقُ الليْلِ","https://www.poetsgate.com/ViewPoem.aspx?id=212394",""],[5204,"أحباب قلبى كم يكون القل","https://www.poetsgate.com/ViewPoem.aspx?id=200374",""],[5304,"السنين المرهقه","https://www.poetsgate.com/ViewPoem.aspx?id=157710",""],[5561,"لستَ أنتَ...","https://www.poetsgate.com/ViewPoem.aspx?id=192896",""],[5561,"الحوار الحادي عشر","https://www.poetsgate.com/ViewPoem.aspx?id=201774",""],[5606,"القلوب تطير لكن من دون أجنحه","https://www.poetsgate.com/ViewPoem.aspx?id=194769",""],[5619,"العزبة ١","https://www.poetsgate.com/ViewPoem.aspx?id=211364",""],[5691,"فتنَةُ كربُلاء...!","https://www.poetsgate.com/ViewPoem.aspx?id=206635",""],[5739,"حضن السراب","https://www.poetsgate.com/ViewPoem.aspx?id=126714",""],[5746,"انتظرني..","https://www.poetsgate.com/ViewPoem.aspx?id=207108",""],[5747,"رحلة المليون ميل","https://www.poetsgate.com/ViewPoem.aspx?id=61608",""],[402,"مصابك حيا عرا جعفرا","https://www.poetsgate.com/ViewPoem.aspx?id=35746",""],[5794,"صمت المدينة ..","https://www.poetsgate.com/ViewPoem.aspx?id=122799",""],[5848,"مشكلة قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=53446",""],[5880,"الوحيدة","https://www.poetsgate.com/ViewPoem.aspx?id=208578",""],[5939,"صدفة","https://www.poetsgate.com/ViewPoem.aspx?id=195304",""],[5956,"نُواح الكون على محمد عبده يماني","https://www.poetsgate.com/ViewPoem.aspx?id=194549",""],[5973,"مساء عينيك فضة ٌ وعطور","https://www.poetsgate.com/ViewPoem.aspx?id=13276",""],[6056,"البارعة","https://www.poetsgate.com/ViewPoem.aspx?id=156701",""],[6120,"أعطني سببًا وحيدًا","https://www.poetsgate.com/ViewPoem.aspx?id=213489",""],[6275,"الشاردة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83618&r=&rc=10",""]],"verses":[["أنتظر في الأصيل إلى غيوم","بأقصى الأفق مذهبة الحواشي",0,"ش",2,0],["انتظر فهي حياة","تنقضي ثم تباب",1,"ب",1,0],["اِنتَظَمت دَولَتُهُ أَفريقيا","وارِفَةَ الظلِّ خَصيبَةَ الذَرا",2,"ا",1,0],["إن تظمئي ليَ كم ظمئتُ إِليك","جَمَعَ الوفاءُ شقيةً وشقيَّا",3,"ي",2,0],["أنتَ ظبييْ أنتَ مسكي","أنتَ درّي أنتَ غصني",4,"ي",1,1],["إن تظنوا بهم خير الكم ماتظنون","أو يظن بهم شرا فهو عبد مفتون",5,"ن",1,0],["أنتَ ظلٌّ مدَّه الله على","أهْلِ هذا القطر أن حان الهجير",6,"ر",1,0],["إن تظلِم الأفدارُ فهو مهنّدٌ","أو تُظلِم الأخطارُ فهو ضياءُ",7,"ا",2,0],["إن تظُّنوا الأمرَ في الدنيا لمن","خادعَ الدنيا فعدتهُ الأمين",8,"ن",1,0],["أَنْتَ ظنَّيتَ بنا ما لم يكنْ","كم عَجولٍ حينَ يَمشي يَعْثُرُ",9,"ر",1,0],["أن تظهر الصلاح فينا مثله","فالأرض تطهر والفساد يبدد",10,"د",1,0],["أنت ظَبيِ السِّرب ظرفاً","أنت وردُ الرَّوض خدا",11,"د",2,0],["إن تظلم الناس ترحم أو رحمتهم","ظلمت نفسك فاغتل قبل تغتال",12,"ل",1,0],["أَنتَ ظَلَّلتَني الغَمامَ بِنُعما","كَ وَوَطَّأتَني وِطاءً وَثيرا",13,"ر",2,0],["إن تظلموا فعليكم أستغيثُ بكم","مُستَعدِياً وإليكم منكمُ الهربُ",14,"ب",1,0],["أنت ظبي حلو المراشف ألمي","أدعج الطرف مائس الجيد أغيد",15,"د",1,0],["انتظرني هنا مع الليل إنّي","أنا في صدركَ المحطَّم سِرُّ",16,"ر",1,1],["انتظرني هنا وذابتْ كحُلمٍ","صدَّه عن خُطاه للروح فجر",16,"ر",1,0],["انتظرني هنا ومرَّ زمانٌ","وأنا في ترقّبي مُستمِرّ",16,"ر",1,0],["انتظرتُ الصَّباحَ حتَّى أَتاني","وبه كالظلام سُهْدٌ وفِكر",16,"ر",1,0],["انتظرْني هنا وطال انتظاري","وَهْيَ في أعيني التفاتٌ وذُعر",16,"ر",1,0],["أنت ظل الدوام بل أنت ظل ال","موت بل أنت ظل حرب زبون",17,"ن",1,0],["انتظر يا صديق شيئًا فشيئًا","تطبخ القوت كله بيديكا",18,"ك",2,0],["انتظرْ يا صديق مليون عام","أو ملايين لستُ والله أدري",18,"ي",1,0],["انتظرْ سوف تفهم الشيء باسمٍ","بعد رسمٍ وغابر بعد حالِ",18,"ل",1,0],["أَنتِ ظِلٌّ مُقَدَّسٌ أَنتِ كَهفٌ","طائِفِيٌّ في رَبوَةِ الأَحلامِ",19,"م",1,0],["أنت ظلّ اللّه الظليل على الأ","رض ومأمونه وخير رشيد",20,"د",1,0],["أنتظرتيني على جمرٍ ونار","ويشهد الله اني عملت المستحيلي",21,"ل",2,0],["انتظرتك بعمري يا بعد كل امسي","انتظرتك وقلبي ينتظرني معاك",22,"ك",1,0],["أن تظهرَ اليوم للإصلاح مُمتشقاً","سيفَ الردى ضد من بالله قد عدلوا",23,"ل",3,0],["انتظرتك حبيبي في عيون الولا","ياحبيب المكان وحاكمه بستريح",24,"ح",1,0],["انتظرت الصبح من عقب الجدال","يا شروق الشمس في يوم النفلّ",25,"ل",1,0],["أنتظر رحلة ذهابي . . واستجيب","هاجسٍ نااوي . . على حالي نكد",26,"د",1,0],["أن تظلَّ الحيَاةُ مشروعَ بُؤسٍ","وكُرُوتًا على الحزَانى تُوزَّعْ",27,"ع",1,0],["انْتَظِرْ .. يَا قُدْسنَا إنِّي عَلَى عَهْدِي","غَدًا تَجْتاحُ أحْلامي بِقَاعَا",28,"ع",2,0],["أنتظر القادم من برّكم","وما لصوم الهجر إفطار",29,"ر",1,0],["أنتظر ردك وردك مطرقه","يا حياة ناعمه ولا هلاك",30,"ك",1,0],["انتظرنا يومَ اللقاءِ طويلا","فالمواعيدُ فرحَةٌ وعطور",31,"ر",1,0],["انتظرنا سويّةً أن تجيئي","نفرشُ الارضَ خضرةً ونضارا",32,"ر",2,1],["انتظرنا النسيمَ يأتي إلينا","بالبشاراتِ ضحكةً واعتذارا",32,"ر",2,0],["أنتظم شعري وبوحي ولافيه الصعاب","بنثر إحساسي ولو هو غلط مابمسحه",33,"ح",2,0],["انتظر الجاى ولو غاوى.....","نقط بطقيتك عزبتنا مليانه بلاوى.....",34,"ا",1,0],["إنْ تَظُنّوا الحُسَيْنَ أنْ ليْسَ مِنّا","وهْوَ سِبْطُ النَّبِيِّ نلْتُمْ إثْما",35,"م",2,0],["إنتظرتك..! في حقيقه مع حلوم.","لين شرقي إنمحى بوجه الغياب.",36,"ب",1,0],["انْتَظِرْنِي وَخَلِّ عَنْكَ ظُنُونَكْ","هَل تُرانِي أَسْتَعْذِبُ العَيْشَ دُوْنَكْ؟",37,"ك",1,1],["انْتَظِرْنِي وافْهَمْ - فَدَيْتُكَ - حَالِي","لَا تَزِدْنِي عَلَى جُنُونِي جُنُونَكْ",37,"ك",1,0],["إنتظرت ولابقالي من وجودي راس مال","وأرتحلّت وجاء مكاني في ضياع أكبر دليل",38,"ل",1,0],["أنتظر غير قضاء رحيب","تحاكي النجوم به العثيرا",39,"ر",2,0],["أنتظم لحن السواني وأرتفع للعشق صوت","أنكتب للحب حرف بالقلم أحجم ونينه",40,"ن",2,0],["إنتظرتك لين عاتبني مكاني","واعترفت اني معك ذقت الهزيمة",41,"م",2,0],["إن تظلي وحيدةً وعلى","عمركِ الغضِّ يطبقِ الغسقُ",42,"ق",1,0],["إنْ تظني ذاكِ عشقا فاكتبي للوَصْلِ وصفةْ","أو تظني ذاكِ لهوًا أمتعي قلبي بِطُرْفةْ",43,"ف",2,0],["إنْ تُظهرِ الأشعار منك فضيلةً","سيؤرّخُ الأفضالَ عنك الدهرُ",44,"ر",1,0],["أنتظرٌ الردَّ منك ِ غيرَ مُُُؤج","ل ٍٍ ..لأجلي.. فقد دنا الأجلُ",45,"ل",1,0],["أنتظر نور الفجر يبدأ الطلوع","ساهر، وكل الخلايق غافية",46,"ف",3,0],["أن تظُنَّ البَينَ حَلًّا","لن ترىٰ غيرَ اقترابي",47,"ب",2,0],["أنتظرك والعالم فكره","والكون الرائع في حيره",48,"ر",2,1]]}