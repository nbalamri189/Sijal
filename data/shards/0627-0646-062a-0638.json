{"poems":[[88,"أقول لصاحبي والشمس تدنو","https://www.aldiwan.net/poem44416.html","الوافر"],[89,"وصف الدنيا كثيرون","https://www.aldiwan.net/poem44886.html","مجزوء الرمل"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[97,"يا من طواها الليل في ظلمائه","https://www.aldiwan.net/poem24355.html","الكامل"],[69,"","https://poetry.dctabudhabi.ae/diwan/poem/57154","الرمل"],[388,"يا علي ماتوا اللي مانباهم يموتون","https://www.aldiwan.net/poem54469.html","عموديه"],[413,"شرف البصرة مولانا المشير","https://www.aldiwan.net/poem54069.html","الرمل"],[429,"هذا اللوى لا حط منه لواء","https://www.aldiwan.net/poem12549.html","الكامل"],[451,"اضحكوا ثم اضحكوا يا هازلين","https://www.aldiwan.net/poem61608.html","الرمل"],[498,"قل لمستصغرنا عن حسد","https://www.aldiwan.net/poem38008.html","الرمل"]],"verses":[["أنتظر في الأصيل إلى غيوم","بأقصى الأفق مذهبة الحواشي",0,"ي",1,0],["انتظر فهي حياة","تنقضي ثم تباب",1,"ب",1,0],["اِنتَظَمت دَولَتُهُ أَفريقيا","وارِفَةَ الظلِّ خَصيبَةَ الذَرا",2,"ا",1,0],["إن تظمئي ليَ كم ظمئتُ إِليك","جَمَعَ الوفاءُ شقيةً وشقيَّا",3,"ي",2,0],["أنتَ ظبييْ أنتَ مسكي","أنتَ درّي أنتَ غصني",4,"ي",1,1],["إن تظنوا بهم خير الكم ماتظنون","أو يظن بهم شرا فهو عبد مفتون",5,"ن",1,0],["أنتَ ظلٌّ مدَّه الله على","أهْلِ هذا القطر أن حان الهجير",6,"ر",1,0],["إن تظلِم الأفدارُ فهو مهنّدٌ","أو تُظلِم الأخطارُ فهو ضياءُ",7,"ا",2,0],["إن تظُّنوا الأمرَ في الدنيا لمن","خادعَ الدنيا فعدتهُ الأمين",8,"ن",1,0],["أَنْتَ ظنَّيتَ بنا ما لم يكنْ","كم عَجولٍ حينَ يَمشي يَعْثُرُ",9,"ر",1,0]]}