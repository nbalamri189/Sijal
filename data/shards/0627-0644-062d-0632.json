[5956,"لو مثلاً","https://www.poetsgate.com/ViewPoem.aspx?id=183948",""],[5956,"الطائرة المنكوبة","https://www.poetsgate.com/ViewPoem.aspx?id=193917",""],[5956,"أمُّ الحبيبِ مُحمدٍ والمصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=207118",""],[6050,"الشّمسُ تُنسَجُ مِنْ فَم الشُّعراءِ","https://www.poetsgate.com/ViewPoem.aspx?id=103311",""],[6089,"صاحبُها الوحيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=213749",""],[6089,"خذ غيومك وارتحلْ","https://www.poetsgate.com/ViewPoem.aspx?id=214046",""],[6152,"ثوب يوسف","https://www.poetsgate.com/ViewPoem.aspx?id=203032",""],[6202,"انفض السامر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86710&r=&rc=11",""],[6312,"البؤرُ المتحركةُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82949&r=&rc=4",""],[5001,"جاءت تسيّر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83394&r=&rc=0",""],[5001,"فى كل يوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80714&r=&rc=4",""],[5567,"خدعة العمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81878&r=&rc=127",""]],"verses":[["الحُزنُ مُجتَمِعٌ وَالصَبرُ مُفتَرِقُ","وَالحُبُّ مُختَلِفٌ عِندي وَمُتَّفِقُ",0,"ق",1,1],["الحُزنُ في مُهجَتي وَالنارُ في كَبِدي","وَالدَمعُ يَشهَدُ لي فَاِستَشهِدوا بَصَبري",1,"ر",2,0],["الحزنُ منحلٌّ ومنعَقِدُ","لاثنين ذا باكٍ وذا كَمِدُ",2,"د",1,1],["الحُزنُ يُقلِقُ وَالتَجَمُّلُ يَردَعُ","وَالدَمعُ بَينَهُما عَصِيٌّ طَيِّعُ",3,"ع",1,1],["الحَزمُ وَالعَزمُ كانا مِن صَنيعَتِهِ","ما كُلَّ آلائِهِ يا قَومُ أُحصيها",4,"ي",3,0],["الحَزمُ هادٍ وَالسِياسَةُ مَركَبٌ","وَالعَزمُ حادٍ وَالمَضاءُ قَرينُ",5,"ن",1,0],["الحزب للحزب لا ينسى تواضعه","كَما تواضعُ للأَقران أَقران",6,"ن",1,0],["الحَزْمُ فِي تَقْديرِه وَالعَزمُ فِي","تَدْبِيرِهِ يَمْضِي مَضَاءَ البَاتِرِ",7,"ر",1,0],["أَلحُزْنُ يَخْمُدُ وَالمَذَلَّةُ جَمْرَةٌ","لاَ تَنْطَفِي إِلاَّ بِسَيْلِ جَسَادِ",8,"د",1,0],["ألحزنُ حيثُ أبيتُ ملءُ جوانحي","والنارُ مِلءُ جَوَانِبِ الغَبْرَاءِ",9,"ا",2,0],["الحزن يحزن ، من فوضى غرابته","فيها ويفزع ، من تهويشه الفزع",10,"ع",1,0],["الحزن يملؤُها أسىً ومهابةً","ويُمدُّها بالروح منه شباب",11,"ب",1,0],["الحزن أرسلها ووقّع لحنها","واختار في شوط القريض جيادها",12,"د",3,0],["الحزن يصهُرنا معاً ويذيبنا","من حيث لا أدري ولا تدرينا",13,"ن",2,0],["الحزن في عينيك مرتجف","واليأس في شفتيك يضطرب",14,"ب",1,0],["الحزانى على الأسى عاكفونا","بعد أن صارت الأماني مَنونا",15,"ن",2,1],["أَلِحَزمُ زَينٌ لِلفَتى","وَشينُهُ التَهَوُّرُ",16,"ر",1,1],["الحزن يُظلِمُ أنفساً فيُضلُّها","عن منظر اللَه العلي على الورى",17,"ر",2,1],["الحُزنُ والدَّمعُ ساقيهِ وَخَمرَتُهُ","وَخَيلُهُ شَوقُهُ .. لَو أنَّها تَصِلُ",18,"ل",1,0],["الحَزمُ تَخريقُهُ إِن كُنتَ ذا حَذرٍ","وَإِنَّما الحَزمُ سوءُ الظَنِّ بِالناسِ",19,"س",1,1],["الحزن عم الناس قاطبةً على","شهم فكل آسف متحسر",20,"ر",1,0],["الحَزنَ بَعدَ الحَزنِ لَيلَكِ والسُّرَى","يا ناقَتي والبَينَ بَعدَ البَينِ",21,"ن",1,0],["الحزن شوك البيد في أحشائها","والغربة الظلما مخاض ثانِ",22,"ن",1,0],["الحزنَ فالهمّ فالدمعَ الموَرَّدَ فالط","طَرفَ المسَهَّد فالأوصاب فالتَعبا",23,"ب",2,0],["الحزنُ حزني والضّلوع ضلوعي","والجفنُ جَفني والدّموعُ دموعي",24,"ع",2,1],["الحزم في المشاورة","العزم في المبادرة",25,"ه",1,0],["الحَزم ثُم العَزم","كُل وَضيع يَسمو",25,"و",1,0],["الحَزم سوء الظَّن","لا تكثر التَّجني",26,"ي",1,0],["الحزم والصبر سيفاً كل نازلةٍ","كل بحديهما لا شك مغلول",27,"ل",1,0],["الحزن يصهرها فتب","لى مثلما بلى الحديد",28,"د",1,0],["الحزن والبكاء من يعقوب","والشوق والصبابة مطلوب",29,"ب",1,0],["الحزنُ معتقلٌ لديّ","ببُعدكم والصَّبرُ آبق",30,"ق",1,0],["الحزم والعزم موجودان والنّظر","واليمن والسعد مضمونان والظّفر",31,"ر",1,1],["الحزم في الأبيات أن يزاد في","أوائل الأجزاء بعض الأحرف",32,"ف",1,0],["أَلَحَّ زيارة ليلف زاداً","مُعداً لابن فاطمة الحُسين",33,"ن",1,0],["الحزم في المنصب السامي هو السبب","ولم تكن بسواه تدرك الرتب",34,"ب",1,1],["الحزنُ أفعلُ شيءٍ بالنفوسِ فلا","تجعل لنفسك حُكماً فيهِ أو حَكَما",35,"م",2,0],["الحزن أدّبني وهذب خاطري","وأنالني أفق الخيال السامي",36,"م",2,0],["الحزم يأبى أن تؤنب من","قطعت عرى حيزومه الغيلُ",37,"ل",1,0],["الحزم قبل العزم فاحرم واعزم","وإذا استبان لك الصواب فصمم",38,"م",1,1],["الحزم ينجي المرء من خدع الورى","كيف النجاة من المحيط الخادع",39,"ع",1,0],["الحزم والقوة خير من ال","إدهان والفكة والهاع",40,"ع",1,0],["الحزمُ يصلح حرب اليَأس وَالأَملِ","وَالعَزمُ يجمعُ خيرَ القَول وَالعَملِ",41,"ل",1,1],["الحزم قبل العزم فيما تبتغي","شيمُ الَّذي اختبر الأمورَ وجرَّبا",42,"ب",2,1],["الحَزمُ وَالصَبرُ وَالإِذعانُ دأبُهُمُ","في حُسنِ سَمتٍ بعز النَصرِ مَقرون",43,"ن",1,0],["الحزن عم بني الدنيا طماطمه","ودار بالملأ الأعلى دوائره",44,"ر",2,0],["الحزن لا تبكيه عيني إنما","تبكي جراحي وانكسار مشاعري",45,"ي",1,1],["الحزن سيد قلبي لا مفر له","منه وسيد ساعاتي وأيامي",46,"م",2,0],["الحزن يسكن في جميع معالمي","والظلم يخرس ثورتي ولساني",47,"ن",2,0],["الحُزنُ دَارِي, وهذا الشِّعرُ نافِذَتِي","لِلقَلبِ, والقَلبُ كالصِّلصَالِ يَنكَسِرُ",48,"ر",1,0],["الحُزنُ أَكرَمُ صاحِبٍ قاسَمْتُهُ","رُوحي, ورُوحي غُربةٌ ويَبابُ",49,"ب",1,0],["الحزنُ ظلّي حيثُ أتّجِهُ","وأنا وحزني بيننا شبهُ",50,"ب",2,1],["الحزن ما يذبح كلام ودعايات","هذا انا ما مت في تالي ابريل",51,"ل",1,0],["الحُزنُ يَنسُجُ آلامِي وَيَنظِمُهَا","عِقداً مِنَ الوَجدِ مَنْضُوداً ومُتَّسِقَا",52,"ق",2,0],["الحزن مهما كان، ما يستاهل إلا دمعتين","كلًّ وله جرحه، وكلًّ من همومه ممتلي",53,"ل",2,0],["الحزن يآآآقو قلبه مانجى منهو دخيله","سمّح الله ضيق ليلي يوم غآآرت بي خيوله",54,"ل",2,0],["الحزن هو والابتسامه مخاشير","كن القهر مبدع وهُم صفقوله",55,"ل",2,0],["الحزن كلّه بالقصآيد تسرّب","ومبطي ماجآت مْن الليالي بشآره",56,"ر",2,0],["الحزن :هو الدمعه:هيّ","لاتعتذر لي لو سمحت",57,"ت",1,0],["الحزنُ ألجَمَني ودَقَّ عِظامي","وأقامَ في قلبي ونبضِ كلامي",58,"م",2,1],["الحزن خيّم والألم بالحشا ساد","والغمّ ساري في عروق الودادي",59,"د",2,0],["الحزن في القلب في الأعماق في دمنا","يأس طويل فكيف الجرح يندمل",60,"ل",1,0],["الحزن يملأ يا حبيب جوارحي","فالمسلمون عن الطريق تعاموا",61,"م",3,0],["الحزن..أصبح خبزنا فمساؤنا","شجن ..وطعم صباحنا أسقام",61,"م",1,0],["الحزن طول عمرنا","له من حياتنا حياه",62,"ه",1,0],["الحُزنُ يَقذِفُ في شِفاهِكَ قَبْضَةً","لِلسَّامِرِيِّ ولا مِساسَ بِفِتْنَه",63,"ن",2,0],["الحزن لامنه طغا واحتواني","مالي سوا شكواي للرب وادعيه",64,"ه",1,1],["الحُزنُ يَعرِفُ مَا أُرِيدُ فلَمْ أزَلْ","أُصغِي ويعزِفُ مَا أشَاءُ وأصطفِي",65,"ف",2,0],["الحزنُ يصرخُ في دمي","ورجولتي تأبى النُواحْ",66,"ح",1,0],["الحزن شيَّبني وها قدري","حتى كآني شيخُ أهْمامي",67,"م",2,0],["الحزنُ سَيَّجَ وحدتي وكأنّما","طيرُ الرجاءِ على الغصونِ أسيرُ",68,"ر",1,0],["الحزنُ أوفى من صديقٍ خاننا","علّمْ همومَكَ مرّةً أن تَفْرَحا",69,"ح",2,0],["الحزن فاضَ وجرحي لا ضفافَ لهُ","دمي يسيلُ ودمع العين ينهملُ",70,"ل",1,0],["الحزم فيها اعتدادا نور مشرقة","والعزم فيها اتقادا نار بركان",71,"ن",1,0],["الحُزنُ يُلهبُ ما في الرّوحِ مِن ألمٍ","تُزَيّنُ الوَجهَ مِن أحداقِها الدُّرَرُ",72,"ر",1,0],["الحزنُ يغمرُ أحداقي بدمعته","فأُغرقتْ من دموعي تلكم المقلُ",73,"ل",1,0],["الحزنُ في وسطِ القلوبِ مديدُ","والناسُ ما بينَ الدمارِ رقودُ",74,"د",1,0],["الحزنُ يغمرُ أحداقي بدمعتِهِ","فأغرورقتْ من دموعي تلكمُ المقلُ",75,"ل",1,0],["الحزن قلبي ملاذه ومرتعه","والسعادة لدنيتي ماهي بربيع",76,"ع",1,0],["الحزنُ يضغطُ كالأفعى ويبلعني","والسّمُ يزعفُ والأحشاءُ تخترمُ",77,"م",1,0],["الحزن ضرّ والدموعُ بلاسمٌ","والدمعُ من بين العيونِ سكيبُ",78,"ب",1,0],["الحُزْنُ داخلَ أضْلعي يَحْتلّني","وَتُقطِّرُ الأوْجاعَ بي وَيُقَطِّرُكْ",79,"ك",1,0],["الحزنُ في المسكين يُنكرني","والجوع والآلامُ والآه",80,"ا",2,0],["الحزن لى ضاق في صدري شديده","أبتسم لين يغبطني من لقاني",81,"ن",2,0],["الحزن في صوتك ازعج ساكني","لين صار الكون من حولي حزين",82,"ن",1,1],["الحزنُ في عمق الفؤاد تجذرا","والدمع يجري من عيونك أنهُرا",83,"ر",2,1],["الحزن بين في ضلوعي له دوي","ماعاد للصبر احتمال",84,"ل",1,0],["الحزنُ خيّم في شوارع دجلة","حتى تراءى الموتُ في الأبوابِ",85,"ب",1,0],["الحزن ولّى وفارق .. ما بقى له أي أثر","في حياتي من عرفتك .. والله يا الحب الأكيد",86,"د",1,0],["الحزن ما الحزن إلا أدمعٌ رقصت","فغنت الآه في بعد ارتماءاتي",87,"ت",2,0],["الحزنُ فينا رسمُ خارطةٍ إلى","طعمِ الحقيقةِ كي يذوقَ (أخيلا)",88,"ل",2,0],["الحزنُ ثغرُ قصيدةٍ شربَ الهوى","فتفجّرت أبياته لتقولا",88,"ل",2,0],["الحزنُ حلَّ وصمتُ الآهِِ ينكشفُ","أماهُ جئتُ إليكِ الآن أعترفُ",89,"ف",1,1],["الحزن وجهي والضياع مساري","فرحي يغادر راحلاً عن داري ..",90,"ر",2,1],["الحزمُ والعزمُ القويُّ ، سبيلُهُ","من أجلِ دكِّ براثنِ الشيطانِ",91,"ن",1,0],["الحزمُ .. بثَّ عواصفاً مملوءةً","ناراً .. يُذيبُ سعيرُها الأكبادا",92,"د",2,0],["الحزمُ عزمٌ .. دكَّ فكرَ عُصابةٍ","بغتِ الدمارَ .. وأفسدتْ إفسادا",92,"د",2,0],["الحزمُ .. صبحٌ في نفوسٍ كبَّرتْ","للهِ .. تبغي من هداه رشادا",92,"د",2,0],["الحُزْنُ فِي عُنِقِ المَاضِي – أَتْذُكُرُهُ –","قِلادَةٌ قِيلَ عَنْهَا تَمْنَعِ الحَسَدا",93,"د",2,0],["الحُزْنُ فِي دَفْتَرِي حَرْفَانِ خِذْ بِهِمَا","وَ أَطْعِمِ السَطْرَ طُهْرَ الرُوحِ وَ الجَسَدَا",93,"د",2,0],["الحُزْنُ سَيِّدُ أَحْرُفِي","أُخْفِي وَ أُظْهِرُ مِنْهُ قُبْحَهْ",94,"ح",2,0],["الحزنُ يأكلُ من رأسي ويصلبني","واليأسُ ينعقُ يا مصلوبُ خذ ولعي",95,"ع",2,1],["الحزم في تقديره والعزم في","تدبير يمضي مضاء الباتر",96,"ر",1,0],["ألحزن حيث أبيت ملء جوانحي","والناء ملء جوانب الغبراء",97,"ا",2,0],["الحزن ( فعلٍ ) على طول السهر ( مبني )","( ماضيه ) مُتعِب وب( امره ) جفت اغصاني",98,"ن",2,0],["الحزن للقلب ولراعيه تنهيده","لا ميّل الليل غصن وطاح عنقوده",99,"د",2,1],["الحزن لا سكنا به سكن فينا","يرسم دروب والخطوات مرتها",100,"ت",3,0],["الحزن أسُّ العمر مجبول به","جسدُ الخليقة من ذراه رُكِّبا",101,"ب",2,0],["الحزن شيمة عصرنا","لا شيئَ إلا يُفْزعُهْ",102,"ع",2,0],["الحزن أساسُ طبيعتنا","كم عربدَ فينا كم آذى",103,"ذ",2,0],["الحزن مكتوب علينا والهنا","والصبرُ، واللاَّصبرُ، تلك وغيرها..",104,"ه",2,0],["الحزن حالفها بكل مراحلٍ","من عمرها صِدقاً بلا أن يَحْلفا",105,"ف",2,0],["الحزنُ أوهى في الخُطَى أحلامها","تُغضي على الأجفان ِ بالأقذاء ِ",106,"ا",2,0],["الحزنُ صاحبُها الوحيدُ وصبرُها","سراً عليهِ إجابةٌ وسؤالُ",107,"ل",1,0],["الحزن يأكل من لسانك صمته","والوقت يضرب بيننا بجدار",108,"ر",1,0],["الحُزن يأتي دقيقا في مواجعه","يظل بالألم المخبوء يؤذينا",109,"ن",2,0],["الحزن يعرفني رقيقا باكيا","فأقام خيمته بقلبي عسكرا",110,"ر",2,0],["الحُزنُ بوصِلتي، شِراعاتي الأسى،","قلعي الضَّياعُ، شواطئي أكوابي!",111,"ب",2,0],["الحزن في أضلعي غاصت أظافره","وأستوطن السهد أحدقي وأنظاري",112,"ر",2,0],["الحزن يطحننا فاين المهرب","والجرح ينزفنا فاين المشفق",113,"ق",1,0],["الحزن فوق جدار القلب قد كتبا","وعانق الصمت رب الشعر وانتحبا",114,"ب",2,1]]}