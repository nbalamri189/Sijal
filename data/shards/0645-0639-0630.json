ps://www.poetsgate.com/ViewPoem.aspx?id=149424",""],[5168,"بيه اترفقي","https://www.poetsgate.com/ViewPoem.aspx?id=33613",""],[5189,"رياض الصالحين","https://www.poetsgate.com/ViewPoem.aspx?id=208537",""],[5266,"مُقَاسَاةُ لَيْلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=210314",""],[5277,"روحي وهذا الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=191230",""],[5277,"ضميرٌ منفصل","https://www.poetsgate.com/ViewPoem.aspx?id=203966",""],[307,"متى نعود أيا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=213657",""],[5431,"نصف الحقيقة ...","https://www.poetsgate.com/ViewPoem.aspx?id=192236",""],[5431,"يامصر...","https://www.poetsgate.com/ViewPoem.aspx?id=202807",""],[5461,"أيوه","https://www.poetsgate.com/ViewPoem.aspx?id=27112",""],[5464,"أوصيك بي شراً اذا خنت الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=7560",""],[5536,"كفي عن الركض!!","https://www.poetsgate.com/ViewPoem.aspx?id=22809",""],[5609,"نزوة عشق","https://www.poetsgate.com/ViewPoem.aspx?id=215571",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5652,"رثاء ( اُمي )","https://www.poetsgate.com/ViewPoem.aspx?id=206701",""],[5674,"معذورة تلك الحروف تحن لي","https://www.poetsgate.com/ViewPoem.aspx?id=185909",""],[5674,"الدروب تخونني","https://www.poetsgate.com/ViewPoem.aspx?id=189654",""],[5690,"رضيت بنظرة بدل الوصالِ","https://www.poetsgate.com/ViewPoem.aspx?id=172175",""],[5732,"اللي هتف باسماه قلبي وناداه","https://www.poetsgate.com/ViewPoem.aspx?id=177868",""],[5759,"مُسَهِّدَتي","https://www.poetsgate.com/ViewPoem.aspx?id=213782",""],[5848,"مولاتي","https://www.poetsgate.com/ViewPoem.aspx?id=50538",""],[5975,"معذبتي","https://www.poetsgate.com/ViewPoem.aspx?id=53260",""],[6056,"ملمس الديباج والمخملي","https://www.poetsgate.com/ViewPoem.aspx?id=130141",""],[6102,"قاتِلان !!","https://www.poetsgate.com/ViewPoem.aspx?id=184625",""],[6102,"شَظايا خَزَف ..","https://www.poetsgate.com/ViewPoem.aspx?id=184420",""],[6102,"فرات وذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=184550",""],[5355,"حبٌّ فرديٌّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87214&r=&rc=39",""],[6275,"الشاردة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83618&r=&rc=10",""]],"verses":[["مُعَذِّبَتي فيمَ الصُدودُ وَما الَّذي","أُفَنِّدُ حَتّى لا يَكونَ صُدودُ",0,"د",1,0],["معذّبة القلب في حبِّها","لتهنك عيشتك الراضيه",1,"ي",2,0],["معذَّل لا يفيق الدهرَ عاذلُهُ","وليس في قَرَن غاو بملزوز",2,"ز",1,0],["مُعَذَّرٌ فوق مُوَرَّدَيْهِ","قد ضربَ الحسنُ على خَدَّيْهِ",3,"د",3,1],["معذَّباً بذماءٍ لو يُرَدُّ إِلى","جُثمان مَيْتٍ ألُوفٍ منه ما نُشِرَا",4,"ر",2,0],["معذرةً في القليل إني","والله أعيا الكثيرُ جُهدي",5,"د",2,0],["معذَّرٌ عشتُ بتقبيلِهِ","فمتُّ منْ عشقٍ وَمَنْ عاشَ ماتْ",6,"ت",1,1],["معذَّرٌ عشْتُ بتقبيلهِ","فمتُّ مِنْ عشقي وَمَنْ عاشَ ماتْ",7,"ت",1,1],["مُعَذَّبونَ وجَنَّاتُ النَّعيمِ بنا","وعاطِشونَ ونَمْري الجَوْنَةَ الغَدَقا",8,"ق",2,0],["مُعَذِّبَتي لَولاكِ ما كُنتُ سائِلاً","أَدورُ عَلى الأَبوابِ في الناسِ عارِيا",9,"ي",2,0],["مُعَذِّبَتي لَولاكِ ما كُنتُ هائِماً","أَبيتُ سَخينَ العَينِ حَرّانَ باكِيا",10,"ي",2,0],["مُعَذِّبَتي قَد طالَ وَجدي وَشَفَّني","هَواكِ فَيا لِلناسِ قَلَّ عَزائِيا",10,"ي",2,0],["مُعَذِّبَتي أَورَدتِني مَنهَلَ الرَدى","وَأَخلَفتِ ظَنّي وَاِحتَرَمتِ وِصالِيا",10,"ي",2,0],["مُعَذِّبَتي رِفْقاً بِقَلبٍ مُعذَّبِ","وإِنْ كانَ يُرْضِيْكِ العَذابُ فَعَذِّبي",11,"ب",2,1],["معذّب تاريخه قصّة","حيرى كقلب التاجر الخاسر",12,"ر",1,0],["معذّبة إذا لمحت جمالا","هفت وجدا وعاودها ضناها",13,"ا",3,0],["معذورة أي والغرام لانها","قد فارقت من بعد وصل جارها",14,"ر",3,0],["معذب لكن عذيب اللمى","حلو يذاق الصبر من حاله",15,"ل",2,0],["معذِّبٌ مهجتي والقلبُ في يدهِ","يا قلبُ إن لم يزر مرَّ الهوى قاسِ",16,"س",1,0],["مُعذّبُ اللَيلِ إِلى ضُحاهُ","تَلهبُ نارُ الشَوقِ في حَشاه",17,"ا",2,0],["معذبٌ بالغرام يبكى","ودمع أجفانه السهود",18,"د",1,0],["مُعَذِّرٌ قَد بانَ عُذ","ري في هَواهُ وَاِتَّضَح",19,"ح",1,0],["معذِّبتي عروبٌ ذلَّ كِسرى","وقيصرُ في هواها والعزيز",20,"ز",1,0],["معذِّبتي الحسناءُ رَبُّكِ مُحسنٌ","فلا تجحدي رَبَّ المحاسنِ بالصدّ",21,"د",1,0],["مُعَذِّبَتي حَتّامَ ذا الهَجرُ وَالهُجرُ","وَهَل لي وَقَد جَرَّعتني صَبراً صَبرُ",22,"ر",1,1],["معذرٌ قال لنا حسنه","ما ذا الذي يأتي به واصفي",23,"ي",1,1],["مُعَذِّبي كَالخَمرِ في أَخذِهِ","قَلبي بِما يُجري مِنَ الناظِرِ",24,"ر",1,0],["معذَّباً بالجَث","ممزقاً بالجِث",25,"ث",1,0],["مَعذّلٌ في النّدَى لكنَّ راحَتَهُ","تأبَى مع العَذْلِ إلاّ البَذْلَ والسَّرَفَا",26,"ف",2,0],["معذبتي لا تجحدي الحب بيننا","لما اتهم الواشي فإني الفتى الخال",27,"ل",1,0],["معذبي بالهوى عطفا على كبد","اسير ايدي النوى والحب أغراه",28,"ا",2,0],["معذبي وليالي بالهوى سلفت","وخمر ثغر رشفناها فكان شفا",29,"ف",2,0],["مَعَ ذي دلالٍ ما نَحَوتُ مَسَرَّةً","حَتّى يَسيرَ بِنا دَليلُ غِنائِهِ",30,"ا",3,0],["مُعذِّبَتي لولاك لم يَعذُبِ الرَّدى","ولا كنتُ في جناتِ عدن مُعذَّبا",31,"ب",2,0],["مَعْ ذَا وَذَا كَيْفَ اشْتَهَيْتَ فَكُنْ أَنا ال","موثوقُ بِي في صِحَّةِ المِيثاقِ",32,"ق",1,0],["مُعَذِّبُهُ بِالهَجرِ لَيسَ يُريحُهُ","وَمُسهِرُهُ بِاللَّيلِ لَيسَ يُنيمُهُ",33,"م",2,0],["معذّبتي بالصَدِّ ما لي وَما لَها","وَما مالَ قَلبي عَن هَواها وَما لها",34,"ل",3,1],["معذِّبَ قَلبي هَل تَمنُّ بزورَةٍ","يلَذُّ بِها روحي وَيَجتمع الشملُ",35,"ل",1,0],["مُعَذِّراتُ خُدُودٍ أُشْرِبَتْ خَجَلاً","لَمّا أُضِيفَتْ إلى وَجناتِ عُشَّاقِ",36,"ق",1,0],["مُعَذَّبَتي حُزْتِ الْمَلاَحَةَ فَاحْكُمِي","عَلَى عاشق حِلْفِ الصَّبَابَةِ مُغْرَمِ",37,"م",1,0],["مُعذبتي حَتّى إِذا شئت سلوة","أَتَت بِفُؤادي مِن هَواك صدوع",38,"ع",1,0],["معذبي بالهوى عطفاً على كبدٍ","أسير أيري النى الحب اغراهُ",39,"ا",2,0],["مع ذا فقد وافيت نحوك","بالمقال المقتصر",40,"ر",1,0],["مُعْذِباً بِالسَّقَامِ فِيهِ نَسِيماً","شَغَلَ الوُرْقَ عَنْ مُوَاصَلِ سَجْعِ",41,"ع",1,0],["معذولةُ الأيدي على جودها","والغيثُ فيه بعض عذّالها",42,"ل",3,0],["معذَّبةَ الفؤاد إلك روحي","أُقرِّبها لعينيك احتسابا",43,"ب",2,0],["معذَّبٌ في هَواكُم","يَرُومُ يَومَ التَّلاقِ",44,"ق",1,0],["مُعَذّبِي أوجعوه ضرباً","ولم يكن عندهُم بَلاغُ",45,"غ",1,1],["مَعَ ذا وَحُبُّهُمُ عَلامةُ مُؤمنٍ","بِاللَهِ جا ذا في حديثٍ يُسنَدُ",46,"د",1,0],["معذب الجوى قد عز مصطبري","إذا بدا ا