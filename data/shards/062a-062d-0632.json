{"poems":[[74,"صحا القلب لولا نسمة تتخطر","https://www.aldiwan.net/poem18693.html","الطويل"],[60,"أفادتني القناعة كل عز","https://www.aldiwan.net/poem30982.html","الوافر"],[111,"بصائرنا في القضا خامدة","https://www.poetsgate.com/ViewPoem.aspx?id=522",""],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[193,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[303,"عاطيتني السحر أم صرفا من الراح؟","https://www.aldiwan.net/poem36844.html","عموديه"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145818","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145777","المتقارب"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25359","الرجز"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65362","الرمل"],[3266,"","https://poetry.dctabudhabi.ae/diwan/poem/198810","الطويل"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35838","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85237","الطويل"],[4693,"سطّر بيانك","https://www.poetsgate.com/ViewPoem.aspx?id=53059",""],[4797,"أقول لها .. رد على قطري بن الفجاءة","https://www.poetsgate.com/ViewPoem.aspx?id=29434",""],[4829,"الصمصامة (ملحمة بدر الكبرى)","https://www.poetsgate.com/ViewPoem.aspx?id=34259",""],[4829,"تتبّعني البلاوي","https://www.poetsgate.com/ViewPoem.aspx?id=34263",""],[5956,"الخرير وراحة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=183160",""],[5956,"تحزّ حربة أحزاني لفرقتكم","https://www.poetsgate.com/ViewPoem.aspx?id=193442",""],[6048,"معراجُ الوجع","https://www.poetsgate.com/ViewPoem.aspx?id=197747",""]],"verses":[["تحزم جبريلٌ لخدمة وحيه","وأقبل عيسى بالبشارة يجهر",0,"ر",1,0],["تَحُز رِبحاً وَتُغني عَن بَخيلٍ","وَتَنعَمُ في الجِنانِ بِصَبرِ ساعَه",1,"ع",2,0],["تحزمت المجد في غارة","شناخيب رضوى بها مائده",2,"د",2,0],["تحزبت الأحزاب بعد محمد","فكل إلى نهج رآه يصير",3,"ر",1,0],["تَحزّبا وغدا السبكيُّ مُنفرداً","كِلاهُما ذو اِعتداءٍ في تحزّبهِ",4,"ب",2,0],["تحزُّ في كبدي الذكرى وَتوهجها","وَربما فَرَّجَتْ همي وَأَتراحي",5,"ح",2,0],["تحزُّ بالماءِ حزَّ السيف فاضَ دمُ ال","خطيئةِ البِكْر واستعصى الدمُ النبأُ",6,"ا",1,0],["تَحُزُّ القُيُودُ يَديِّهَا فَتَصْبِ","رُ حتى تَحُزَّ القُيُودَ يَدَاهَا",7,"ا",3,0],["تَحزِيبُ أَمْرِ الفِتَنِ الأَحْزامِ","مِنَ العِدَى وَالجِدُّ ذُو اغْتِرامِ",8,"م",1,0],["تحزنُ الأوتارُ عنّي","كلّها حُزنا جميلا",9,"ل",2,0],["تحز بنفسي المؤلماتُ العوائدُ","فلله مفقودٌ، ولله فاقد",10,"د",1,1],["تُحَزُّ دُرَراً مَنظومَةً في قَلائِدٍ","مِنَ الكَلِماتِ الغُرِّ صيغَت لِكاتِبِ",11,"ب",1,0],["تحزمها نحر الهجير وأنها","لتعهد منه فري ناب ومفصد",12,"د",1,0],["تحزن لأحزانهم تفرح لفرحتهم","يا من يفيض ندى كفيه كالديم",13,"م",1,0],["تحزمت بقصيدي والقبايل ..",".. وجا شعري على الدفع الرباعي",14,"ع",2,0],["تحزمت وشهر كفي مصيبة","فلا يارس مابين الناس ارس",15,"س",1,0],["تحزمت السماء واسرجت دهري","وسليت المنايا من خيالي",16,"ل",2,0],["تَحُزْ أعصابُك الحمقاءُ عقلا","به تَهدي مسيركَ فاتَّبِعْهُ",17,"ع",2,0],["تحزّ حربة أحزاني لفرقتكم","بعمق صدري كتحزيز السكاكينِ",18,"ن",1,1],["تَحزَبوا كُتَلاً واسْتَعصَموا سَفّهاً","وكُلُّهُم كُلُّهم في طَبعِهم خَدَمُ",19,"م",1,0]]}