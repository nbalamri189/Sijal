{"poems":[[88,"كم تحت أذيال الظلام متيم","https://www.aldiwan.net/poem10862.html","الكامل"],[87,"طال عليها القدم","https://www.aldiwan.net/poem63695.html","مجزوء السريع"],[51,"اهرب بنفسك من دنيا مضللة","https://www.aldiwan.net/poem63073.html","البسيط"],[99,"أصبحت من يأسي لو ان الردى","https://www.aldiwan.net/poem25075.html","السريع"],[48,"هذا طريق للهدى لا حب","https://www.aldiwan.net/poem22107.html","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39641","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[92,"على سعد","https://www.poetsgate.com/ViewPoem.aspx?id=179079",""],[230,"لا القوم قومي ولا الأعوان أعواني","https://www.aldiwan.net/poem55113.html","البسيط"],[399,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[412,"بعثت إليك بطيفها تعليلا","https://www.aldiwan.net/poem50139.html","الطويل"],[543,"سقيت بكأس للمنون دهاق","https://www.aldiwan.net/poem47552.html","عموديه"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138135",""],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130629","المديد"],[1846,"","https://poetry.dctabudhabi.ae/diwan/poem/147707","المجتث"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109332","الخفيف"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106859","المنسرح"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93653","الرمل"],[3145,"","https://poetry.dctabudhabi.ae/diwan/poem/128318","الكامل"],[3277,"","https://poetry.dctabudhabi.ae/diwan/poem/125986","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69993","البسيط"],[4778,"أهرقتم الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=204698",""],[4888,"يحتلني هواها","https://www.poetsgate.com/ViewPoem.aspx?id=207748",""],[4929,"الموت القادم من الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=199561",""],[5190,"بغداد لم تحن للمحتل هامتها","https://www.poetsgate.com/ViewPoem.aspx?id=10040",""],[5216,"إهداء إلى سائح","https://www.poetsgate.com/ViewPoem.aspx?id=187001",""],[5324,"مخادعة","https://www.poetsgate.com/ViewPoem.aspx?id=207160",""],[5431,"ولكم خشعت..","https://www.poetsgate.com/ViewPoem.aspx?id=185262",""],[5736,"وصل العاشقين محرما","https://www.poetsgate.com/ViewPoem.aspx?id=208418",""],[5956,"إني لأخضعُ لاحترامك باكيا","https://www.poetsgate.com/ViewPoem.aspx?id=182371",""],[6108,"خطيئة","https://www.poetsgate.com/ViewPoem.aspx?id=192749",""],[6115,"أذا نظمت القصيد ابدع بيوت جزال","https://www.poetsgate.com/ViewPoem.aspx?id=196456",""],[6203,"من منفاه يحدّثك!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88022&r=&rc=0",""],[6213,"غياب الأحبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76260&r=&rc=17",""],[6259,"بعثت إليك بطيفها تعليلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59390&r=&rc=38",""]],"verses":[["أَهرَمتَني يا لَيلُ في شَرخِ الصِبا","كَم فيكَ ساعاتٍ تُشيبُ وَتُهرِمُ",0,"م",1,0],["أَهرَقَ عُنقودَها","تَقدِمَةً لِلصَنَم",1,"م",1,0],["اُهرُب بِنَفسِكَ مِن دُنيا مُضَلَّلَةٍ","قَد أَهلَكَت قَبلَكَ الأَحياءَ وَالمِلَلا",2,"ل",2,1],["أهرب من يأسي لكأسي التي","أدفن فيها أملي الحيّا",3,"ا",1,0],["أَهرُب مِنَ الناسِ فَإِن جِئتُهُم","فَمِثلَ سَأبٍ جَرَّهُ الساحِبُ",4,"ب",1,0],["أهرَامُكَ المُثلى نتاجُ قرائحٍ","خلَّاقةٍ موصُولةِ الإِمدادِ",5,"د",1,0],["أَهْرَامُ مِصْرَ عَتِيدُهَا بَعْثٌ لَهَا","وَعَهِيدُهَا للفَخْرِ والتَّذكارِ",6,"ر",1,0],["أهرامَ مصرَ وقد بناكِ لغاية","\" فرعونُ \" ذو الأوتاد حين بناك",7,"ك",1,0],["أهرامُهُم تلك حيّ الفَنِّ مُتَّخِذاً","من الصُخورِ بُروجاً فوقَ كيوانِ",8,"ن",1,0],["اهربوا لا تدّنسوا عالم الفنّ","بهذي العواطف الآدميّه",9,"ه",1,0],["أُهرب بِنَفسِك لا يهبك فَرُبَّما","أَعطى العذول الرِفد وَالمَعذولا",10,"ل",2,0],["أهُرَيرتِي أوَ مَأ عِلمتِ بأنَّ سه","مَ البينِ يُضنِي مُهجَةَ المشتَاق",11,"ق",1,0],["أهرامهم حجر أصم خالد","أبدا وأهرام البنين وئام",12,"م",1,0],["اهرق الكأس نديمي وامل","نبا فهم كذا رسالا رسيسا",13,"س",2,0],["اهرب إلى الله وابرأ","من أحمد بن قسيّ",14,"ي",1,1],["أهرم الدهر آل عثمان حتى","قد طوت حكمهم عوامل غصب",15,"ب",1,0],["اهرب ممن تقلى ودادي وما","لداءِ قلبي أشفى من الهرب",16,"ب",1,0],["أَهرق الراح وَعاقرني لمى","ما أَحيلاه وَما أَحلى اِرتِشافه",17,"ف",2,0],["أهراق نطفتهُ فلمّا جاءها","وجد المنيّة عندها لم تخلف",18,"ف",1,0],["أهرامهم راسخات لا يلمُّ بها","ريب ولو كرّت الأيام والحقب",19,"ب",1,0],["أَهرامها الشمُّ وَالآثارُ شاهِدَةٌ","بعزةِ الملكِ مِن اعصار بانيها",20,"ي",3,0],["أهرقتم الدمع والأحبار ساقية","فهل أعادت لنا أحباركم وطنا ؟!",21,"ن",2,1],["أهرامُها رمزُ الحضارة والعلا","كجُمانةٍ تختالُ ما أبهاها",22,"ا",3,0],["أهربْ فلا تدري أتذبح ذبحةً","شرعيةً أم بالنعالِ ستسحقُ؟",23,"ق",1,0],["أهرقتَ أدمعَنا ، رفقاً بأعينِنَا","فاْبيَضَّ أسودُها من شدة الحَزَنِ",24,"ن",1,0],["أهرامنا مثل نور الشمسِ تبصرها","لمْ يستطع غيرنا سِحراً كبانينا",25,"ن",2,0],["أهرقت أشواقي لها وعواطفي","وحسبت أني قد بلغت ذراها",26,"ا",3,0],["آه رماح الحسن آهٍ منيتي","ماأُشعلت روحٌ لغيرِ شفاه",27,"ا",2,0],["أهرقتُ في ليلِ الضنى دمعًا همى","ورويتُ حرفًا في القوافي قدْ سما",28,"م",2,1],["أهرمتُ روحك بالمشاكل والأذى","ورهنتِ نفسك في سبيل نجاتيا",29,"ي",2,0],["اهربْ من الحب المحال فإنّه","بحرٌ يراود شطَه الإغراقُ",30,"ق",1,0],["أهرج متى صار للحكمةمكان ومجال","وامسك لساني مع أهل الزيف والثرثرْه",31,"ر",2,0],["اهْرُبْ إلى حضنِ القصيدةِ مُشْرِعًا","بوحَ الجراحِ.. إذا وَجَدْتَ قصيدا!!",32,"د",2,0],["أهرقتُ بنت العين بعد فراقكم","سيلا يموج وبحر روحي متعبُ",33,"ب",1,1],["اهرب بنفسك لا يهبّكَ فربما","أعطى العذول الوفدَ والمعذولا",34,"ل",2,0]]}