tml","الرمل"],[299,"هل من يعين على التجلد ساعة","https://www.aldiwan.net/poem36292.html","عموديه"],[299,"برزت بزينتها إليك الشام","https://www.aldiwan.net/poem36300.html","عموديه"],[299,"لو رأيت الكأس والوجه الصبيحا","https://www.aldiwan.net/poem36853.html","عموديه"],[301,"حي الديار بسيل فالقهر","https://www.aldiwan.net/poem45482.html","أحذ الكامل"],[321,"أشرقت بالبشر أنوار التهاني","https://www.aldiwan.net/poem61663.html","الوافر"],[323,"خل قلبي من سليمى نبلها","https://www.aldiwan.net/poem56347.html","الرمل"],[329,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[329,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[329,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[329,"أطرقت في ضراعة تذكر الله","https://www.aldiwan.net/poem55062.html","الخفيف"],[354,"أسرار أشواقي الفؤاد أكنها","https://www.aldiwan.net/poem40147.html","الكامل"],[367,"طفل كفاه القلب دارا له","https://www.aldiwan.net/poem17678.html","السريع"],[404,"طفا على قهوتنا المصطكى","https://www.aldiwan.net/poem33752.html","السريع"],[430,"طفل السرور من الصهباء مولود","https://www.aldiwan.net/poem40519.html","البسيط"],[430,"لله دار غدت بالحسن مشرقة","https://www.aldiwan.net/poem40530.html","البسيط"],[430,"سعد العلياء جلا ثغرا","https://www.aldiwan.net/poem40840.html","المتدارك"],[442,"فوضت أمري إلى ذي القدرة الصمد","https://www.aldiwan.net/poem14302.html","البسيط"],[447,"طفلة ما ابنة المجلل بيضاء","https://www.aldiwan.net/poem23940.html","الخفيف"],[459,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[465,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[483,"عج ساحل الدير سل عنها الشماميسا","https://www.aldiwan.net/poem24427.html","عموديه"],[483,"طفنا بكعبة حسن قد ألفنا بها","https://www.aldiwan.net/poem24495.html","عموديه"],[501,"أي ورد قد شممناه ضحى","https://www.aldiwan.net/poem37781.html","الرمل"],[506,"تائية القافلة","https://www.aldiwan.net/poem27889.html","البسيط"],[516,"أأرجو بقاء أم صفاء حياة","https://www.aldiwan.net/poem12043.html","الطويل"],[530,"ألا هكذا من يروم الفخارا","https://www.aldiwan.net/poem37413.html","المتقارب"],[554,"أأعلن ما بي أم أسر فأكتم","https://www.aldiwan.net/poem68411.html","الطويل"],[559,"طوبى لمن كشفت بصيرته الغطا","https://www.aldiwan.net/poem33544.html","الكامل"],[559,"يعلم الحق نفسه بالذي قد","https://www.aldiwan.net/poem34093.html","الخفيف"],[559,"قف جانب الدير سل عنها القساسيسا","https://www.aldiwan.net/poem34453.html","البسيط"],[559,"أنا دائما يا نور كل مليح","https://www.aldiwan.net/poem34680.html","الكامل"],[563,"طفح الأنس فوق ساحات جلق","https://www.aldiwan.net/poem52784.html","الخفيف"],[563,"حزن القلوب على الغريب غريب","https://www.aldiwan.net/poem52792.html","الكامل"],[563,"يا نفس هل من أمر ربك عاصم","https://www.aldiwan.net/poem52796.html","الكامل"],[563,"إن كان يلبس ما أفاد تجملا","https://www.aldiwan.net/poem52963.html","الكامل"],[563,"خطرت وفي قلبي لذاك خفوق","https://www.aldiwan.net/poem52991.html","الكامل"],[568,"كأنما الراووق وانتصابه","https://www.aldiwan.net/poem69791.html","الرجز"]],"verses":[["طَفَحَ الدّمُ المُهَراقُ في أرْجائِها","دُفَعاً تُضَرَّمُ حَولَها النّيرانُ",0,"ن",1,0],["طُف بِالأَريكَةِ ذاتِ العِزِّ وَالشانِ","وَاِقضِ المَناسِكِ عَن قاصٍ وَعَن داني",1,"ن",2,1],["طُفْتُ وَالصُّبْحُ طَالِباً فِي الجَنَانِ","سَلْوَةً مِنْ نَوَاصِبِ الأَشْجَانِ",2,"ن",1,1],["طِفْلانِ كَالأَخَوَيْنِ مُؤْتَلِفَانِ","شَبَّا وَشَبَّ عَلَى الهَوَى القَلْبَانِ",3,"ن",1,1],["طُفْ بِالقُرَى تلْقَ أُلُوفاً بِهَا","مِنْهُمُ رَقِيقُ الحَالِ وَالمُعْدِمُ",4,"م",1,0],["طَفِيءَ الصَّبَاحُ بَعَيْنِيَ الإِلهَامِ","وَتَغَمَّدَ الَّلأْلاءَ جَفْنُ ظَلامِ",5,"م",1,1],["طفقت أرانِبُهُ غداة أثرتها","تبغي الفرار ولات حين فرارِ",6,"ر",1,0],["طُفنَ بِالكَأسِ بَينَ شَربٍ كِرامٍ","مَهَّدوا حُرَّ صالِحِ الأَنماطِ",7,"ط",1,0],["طفقت له مزوياً نبْتَهُ","زماناً بطافحك الطافق",8,"ق",1,0],["طفِقت تجود بذَوْبها جُوذابة","قَانَى لبابَ اللوز فيها السكّر",9,"ر",1,0],["طفقت تؤنبني سادراً","لتُلزمني الذنب في الظاهر",10,"ر",1,0],["طفِقوا يَعجبون منه فقال ال","شيْخ لا تنْكِرُنَّ للَّهِ قُدْرَه",11,"ر",2,0],["طفِقْت تُحلِّي البحر درّاً ودرُّهُ","عتيدٌ فلم تبعد عليكَ الملاقط",12,"ط",1,0],["طفِّل على من حَصُلت عنده","فبعض تطفيل الفتى رفعه",13,"ع",2,0],["طفتَ بالبيت ثم أبت من الحج","ج فأصبحت للعفاة مطافا",14,"ف",2,0],["طفقت رواياه تجر مزادها","فوق الربا ومزادها مشقوق",15,"ق",1,0],["طفقت تمطر العفاة سماءٌ","من جداكم فما أساءت طُفوقا",16,"ق",2,0],["طفلٌ أراد وصيفاً كيّساً فبكى","حتى أتاهُ مليحُ القدِّ مجدولُ",17,"ل",1,0],["طفيليّون من نحلُل ذراهُ","فأمُّ طعامِه الأمُّ الثكُولُ",18,"ل",1,0],["طُفتُ بأكنافك لا هاجماً","وداءُ عمروٍ أمّنهُ هَجْمي",19,"م",2,0],["طَفَت في الضُحى أَحداجُ أَروى كَأَنَّها","قُرىً مِن جُواثى مُحزَئِلٌّ نَخيلُها",20,"ل",3,0],["طِفلَةٌ ساذَجَةٌ أَطهَرُ مِن","زَهرَةِ الرَوض وَأَنقى جَوهَرا",21,"ر",2,0],["طَفَحَتْ بأَعْماقِ الوُجُودِ","سَكِينَةُ الصَّبْرِ الجَلِيدْ",22,"د",1,0],["طُف بِالسَرير مسلِّماً","واِرجع لِتَوديعِ المَنابِرْ",23,"ر",1,0],["طف بديوان حافظ واجن زهرا","فهو لا نافض ولا ممنوع",24,"ع",1,0],["طفلٌ صغيرٌ في السن جداً","كصورة الحسن والجمال",25,"ل",1,0],["طفل علينا أمير","مقبل الركبتين",26,"ن",1,0],["طُفنا بِقَبرِكَ وَاِستَلَمنا جَندَلاً","كَالرُكنِ أَزكى وَالحَطيمِ مُطَهَّرا",27,"ر",2,0],["طَفِقَت تَلومُ وَلاتَ حينَ مَلامِهِ","لا عِندَ كَبرَتِهِ وَلا إِحجامِهِ",28,"م",2,1],["طَفَحَت نَشوَةُ المُدامِ وَقَد شَط","طَت عَلى الشارِبينِ أَيَّ اِشتِطاطِ",29,"ط",1,0],["طِفلُ صُبحٍ لَهُ مِنَ الشَرقِ مَهدٌ","وَلَهُ حُلَّةُ الدُجى كَالقِماطِ",29,"ط",1,0],["طُفَيلٌ تُقادُ بِأَذنابِها","وُقودُ الجِيادِ بِأَرسانِها",30,"ه",2,1],["طَفَحَ السُرورُ عَلَيَّ حَتّى إِنَّهُ","مِن عِظمِ ما قَد سَرَّني أَبكاني",31,"ن",2,0],["طفا وقد قبّل أنوارها","ورفَّ مثل الطائر الحاسي",32,"س",2,0],["طَفْلَةٌ تسرَحُ في أعطافِها","لِلأَظانين وللدَلِّ مراح",33,"ح",1,0],["طفتُ في الآفاق حتى اكتهلَتْ","غُرْبَتِي واحتنكت سنّ الأدب",34,"ب",1,0],["طُفْتُ الْبِلادَ وَجَرَّبْتُ الْعِبَادَ فَلَمْ","أَرْكَنْ لِخِلٍّ وَلَمْ أَجْنَحْ إِلَى سَكَنِ",35,"ن",1,0],["طَفِقَ النَّسِيمُ يَحُوكُ وَشْيَ بُرُودِهِ","بِأَنَامِلٍ تَمْرِي خُيُوطَ الْمِرْزَمِ",36,"م",1,0],["طَفلَةٌ كَالمَهاةِ لَيسَ لِمَن عا","بَ إِذا تُذكَروا المَعايِبُ وَصمُ",37,"م",1,0],["طِفلَةٌ وَعثَةُ الرَوادِف خَودٌ","كَمَهاةٍ إِنسابَ عَنها الصُوارُ",38,"ر",1,0],["طَفلَةٌ بارِدَةُ القَيظِ إِذا","مَعمَعانُ الصَيفِ أَضحى يَتَّقِد",39,"د",1,0],["طُفْ بالبيانِ الطّلقِِ عذباً سائغاً","إنّا شَرِبْنا الدّينَ فيه كُؤوسا",40,"س",2,0],["طُفْ بالمناصبِ والأرائكِ سائلاً","ماذا تُعاني الأعظُمُ النَّخِراتُ",41,"ت",1,0],["طُف بِالمَشارِقِ هَل تُصادِفُ جاحِداً","وَجُبِ المغَارِبَ هَل تَرى مُرتابا",42,"ب",2,0],["طُف بِالمَشارِقِ وَالمَغارِبِ هَل تَرى","دَعَةً تُرامُ وَغَبطَةً تُرتادُ",43,"د",1,0],["طُف بِالرُقادِ عَلى سَهارى أَعيُنٍ","أَلوى بِنَضرَتِها أَسىً وَسُهادُ",43,"د",1,0],["طُف بِالحُماةِ فَهَل تَرى ذا نَجدَةٍ","إِلّا بِحَيثُ تَرى الدَمَ المُهراقا",44,"ق",2,0],["طفقت تَمضغُ مِن أفلاذِها","عَلقماً مُرّاً وسُماً مُنقَعا",45,"ع",2,0],["طُفْ بالمصارعِ وَاسْتَمِعْ نَجواها","وَالْثِمْ بأفياءِ الجِنانِ ثَراها",46,"ا",3,1],["طفِقَ الثرى من حولها لمّا ارتوى","من ذَوْبِ مهجتها يجفُّ ويَبلحُ",47,"ح",1,0],["طفلة عَن والديها نسخة","كرمت أَصلاً وَطابَت مَعدَنا",48,"ن",2,0],["طفتُ بين الأّزهار والنَّشْر من نش","ركِ فيها ودقةُ التكوين",49,"ن",1,0],["طَفِقْتُ أعُدُّ منها مَوْجَ بَحْرٍ","وَقَطْراً غَيْثُهُ أَبَداً يَصُوبُ",50,"ب",1,0],["طَفلَةٌ كَالغَزالِ ذاتُ دَلالٍ","فِتنَةٌ في النِقابِ وَالإِسفارِ",51,"ر",1,1],["طَفِقتُ أُفَدّيهِ وَأَدعوهُ بِاسمِهِ","فَقالَ مُجيباً ما تَشا بِتَثاقُلِ",52,"ل",1,0],["طَفلَةٌ خَودٌ رَداحٌ","هامَ قَلبي بِهَواها",53,"ا",3,1],["طَفَئَت عُيونُ الناظِرينَ وَأَشرَقَت","عَينُ الغَزالَةِ ما بِها عُوّارُ",54,"ر",1,1],["طَفَونا وَنَرسو الآنَ لا سُرَّ أَسوَدي","بِمِلكِ البَرايا ما العِراقُ وَما النَرسُ",55,"س",1,0],["طف بقلبي تجد به ألف دنيا","لا يلاقي الشقيق فيها الشقيقا",56,"ق",2,0],["طَفاها أَسوَدٌ مِن آلِ عَبسٍ","بِأَبيَضَ صارِمٍ حَسَنِ الصِقالِ",57,"ل",1,0],["طُفْ فِي قُرَاهُ فَمَا تَرَى","مِنْ يَأْسِ كُل أَبٍ وَأُمْ",58,"م",1,0],["طفِئَ الَيْومَ ذَلِكَ الكَوْكَبُ الهَا","دِي فَهَلْ دَالَ وَاسْتَتَبَّ الظَّلامُ",59,"م",1,0],["طِفْلٌ لِسَامٍ كانَ وَعْدَ سَعَادَةٍ","وَعَدَ الزّمَانُ بِهِ ذوِيهِ وَقَدْ وَفَى",60,"ف",2,1],["طَفا نَجْمُ الْحَبَابِ بِهَا","عَلَى شَفَقٍ مِنَ الخَمْرِ",61,"ر",1,0],["طُفْ بِالمَحَلَّةِ تُلْفِ كَيْفَ تَبدِلَتْ","بِالبالِيَاتِ حدِيثَةُ الأَنْوَالِ",62,"ل",1,0],["طفلتك القديمة.. المثيرهْ","لم يخجل الغروبُ وهو يقتلُ الأميرهْ",63,"ه",1,0],["طِفلٌ وَلَستُ أَرى حجاهُ بِأَشيَبٍ","حَتّى أَرى طولَ الطلاةِ",64,"ه",1,0],["طُف بي عَلى قَبرِ طفلٍ","كَالشَيخِ فيهِ وقارُ",65,"ر",1,1],["طِفلٌ تَعالى وَجَلَّ رَبٌّ","هَداهُ في مَهدِهِ الصِراطا",66,"ط",2,0],["طفِئَتْ أنوارُ أُميَّةَ فِي","قَصْرِ الخُلفاءِ فقلتَ قِدِ",67,"د",1,0],["طُفْ ببغداد وسَلْ آثارَها","أيُّ سِرٍ كَتَمَتْهُ شَفَتاها",68,"ا",3,0],["طفِقْتُ أمدُّ نحوَ الركبِ طَرْفي","فَغَصَّ الطرفَ كُثْبانٌ ورمل",69,"ل",1,0],["طفلٌ بريءٌ ذاق من","يد أمِّه كأسَ الحِمام",70,"م",1,0],["طفل جاري كان يستسقي أنا","كنت أرجو ، لحظة حبلى جواده",71,"د",2,0],["طفلة ما ابنة المحلل بيضا","لعوب لذيذة في العناق",72,"ق",1,1],["طفقتُ أدُّ منها موجَ بحرٍ","وَقَطْراً غَيْثُهُ أَبداً يَصُوبُ",73,"ب",1,0],["طفل فإن نال ضيم من كرامته","ما البحر يزأر . ما البركان ينفجر",74,"ر",1,0],["طفولة الروح أغلى ما أدلّ به","والحبّ أعنفه عندي وأوفاه",75,"ا",2,0],["طفولةٌ كما تبوحُ الربى","ومبسمٌ كأنَّه الفاتحَهْ..",76,"ح",2,0],["طفِقوا يَعجبون منه فقال الشْ","شَيْخ لا تُنْكِرُن للهِ قُدْره",77,"ر",2,0],["طفقتْ رَوَايَاهُ تجرّ مزادَها","فوق الربى ومزادُها مشقوق",78,"ق",1,0],["طفلة ٌ كالمهاة ِ، ليس لمن عا","بَ، إذا تُذْكَرُ المَعَايِبُ، وَصْمُ",79,"م",1,0],["طفقَ النسيمُ يحوكُ برودهِ","بأناملٍ تمرى خيوطَ المرزمِ",80,"م",1,0],["طفل يَبيت وَمَهدُهُ","في الأُفق مَحسود الهِلال",81,"ل",1,0],["طَفَوتُ على بَحرٍ مَنَ الحُبِّ زاخرٍ","فهَا أنا أبدُو تارَةً ثمَّ أنقَطُّ",82,"ط",1,0],["طَفَونا بِهِ فَوقَ البَريَّةِ كُلِّها","فَما غَضَّ مِنّا لا رُسوبٌ وَلا غَطُّ",83,"ط",1,0],["طَفِقَت تَجدَعُ فيهِ رِجالُ ال","أزدِ جَهلاً بِالأَكُفِّ الأُنوفا",84,"ف",2,0],["طِفلٌ تَفنَّنَ فيه الحُسْنُ مُبتدِعا","تكاد من طَرْفِه الأبصارُ تَخْتطفُهْ",85,"ف",2,1],["طفوليّة في المهد