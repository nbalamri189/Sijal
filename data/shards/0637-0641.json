مِنْ مُتَرَدَّمِكَمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23829&r=&rc=91",""]],"verses":[["طَفَحَ الدّمُ المُهَراقُ في أرْجائِها","دُفَعاً تُضَرَّمُ حَولَها النّيرانُ",0,"ن",1,0],["طُف بِالأَريكَةِ ذاتِ العِزِّ وَالشانِ","وَاِقضِ المَناسِكِ عَن قاصٍ وَعَن داني",1,"ن",2,1],["طُفْتُ وَالصُّبْحُ طَالِباً فِي الجَنَانِ","سَلْوَةً مِنْ نَوَاصِبِ الأَشْجَانِ",2,"ن",1,1],["طِفْلانِ كَالأَخَوَيْنِ مُؤْتَلِفَانِ","شَبَّا وَشَبَّ عَلَى الهَوَى القَلْبَانِ",3,"ن",1,1],["طُفْ بِالقُرَى تلْقَ أُلُوفاً بِهَا","مِنْهُمُ رَقِيقُ الحَالِ وَالمُعْدِمُ",4,"م",1,0],["طَفِيءَ الصَّبَاحُ بَعَيْنِيَ الإِلهَامِ","وَتَغَمَّدَ الَّلأْلاءَ جَفْنُ ظَلامِ",5,"م",1,1],["طفقت أرانِبُهُ غداة أثرتها","تبغي الفرار ولات حين فرارِ",6,"ر",1,0],["طُفنَ بِالكَأسِ بَينَ شَربٍ كِرامٍ","مَهَّدوا حُرَّ صالِحِ الأَنماطِ",7,"ط",1,0],["طفقت له مزوياً نبْتَهُ","زماناً بطافحك الطافق",8,"ق",1,0],["طفِقت تجود بذَوْبها جُوذابة","قَانَى لبابَ اللوز فيها السكّر",9,"ر",1,0],["طفقت تؤنبني سادراً","لتُلزمني الذنب في الظاهر",10,"ر",1,0],["طفِقوا يَعجبون منه فقال ال","شيْخ لا تنْكِرُنَّ للَّهِ قُدْرَه",11,"ه",1,0],["طفِقْت تُحلِّي البحر درّاً ودرُّهُ","عتيدٌ فلم تبعد عليكَ الملاقط",12,"ط",1,0],["طفِّل على من حَصُلت عنده","فبعض تطفيل الفتى رفعه",13,"ع",2,0],["طفتَ بالبيت ثم أبت من الحج","ج فأصبحت للعفاة مطافا",14,"ف",2,0],["طفقت رواياه تجر مزادها","فوق الربا ومزادها مشقوق",15,"ق",1,0],["طفقت تمطر العفاة سماءٌ","من جداكم فما أساءت طُفوقا",16,"ق",2,0],["طفلٌ أراد وصيفاً كيّساً فبكى","حتى أتاهُ مليحُ القدِّ مجدولُ",17,"ل",1,0],["طفيليّون من نحلُل ذراهُ","فأمُّ طعامِه الأمُّ الثكُولُ",18,"ل",1,0],["طُفتُ بأكنافك لا هاجماً","وداءُ عمروٍ أمّنهُ هَجْمي",19,"م",2,0],["طَفَت في الضُحى أَحداجُ أَروى كَأَنَّها","قُرىً مِن جُواثى مُحزَئِلٌّ نَخيلُها",20,"ل",3,0],["طِفلَةٌ ساذَجَةٌ أَطهَرُ مِن","زَهرَةِ الرَوض وَأَنقى جَوهَرا",21,"ر",2,0],["طَفَحَتْ بأَعْماقِ الوُجُودِ","سَكِينَةُ الصَّبْرِ الجَلِيدْ",22,"د",1,0],["طُف بِالسَرير مسلِّماً","واِرجع لِتَوديعِ المَنابِرْ",23,"ر",1,0],["طف بديوان حافظ واجن زهرا","فهو لا نافض ولا ممنوع",24,"ع",1,0],["طفلٌ صغيرٌ في السن جداً","كصورة الحسن والجمال",25,"ل",1,0],["طفل علينا أمير","مقبل الركبتين",26,"ن",1,0],["طُفنا بِقَبرِكَ وَاِستَلَمنا جَندَلاً","كَالرُكنِ أَزكى وَالحَطيمِ مُطَهَّرا",27,"ر",2,0],["طَفِقَت تَلومُ وَلاتَ حينَ مَلامِهِ","لا عِندَ كَبرَتِهِ وَلا إِحجامِهِ",28,"م",2,1],["طَفَحَت نَشوَةُ المُدامِ وَقَد شَط","طَت عَلى الشارِبينِ أَيَّ اِشتِطاطِ",29,"ط",1,0],["طِفلُ صُبحٍ لَهُ مِنَ الشَرقِ مَهدٌ","وَلَهُ حُلَّةُ الدُجى كَالقِماطِ",29,"ط",1,0],["طُفَيلٌ تُقادُ بِأَذنابِها","وُقودُ الجِيادِ بِأَرسانِها",30,"ه",2,1],["طَفَحَ السُرورُ عَلَيَّ حَتّى إِنَّهُ","مِن عِظمِ ما قَد سَرَّني أَبكاني",31,"ن",2,0],["طفا وقد قبّل أنوارها","ورفَّ مثل الطائر الحاسي",32,"ي",1,0],["طَفْلَةٌ تسرَحُ في أعطافِها","لِلأَظانين وللدَلِّ مراح",33,"ح",1,0],["طفتُ في الآفاق حتى اكتهلَتْ","غُرْبَتِي واحتنكت سنّ الأدب",34,"ب",1,0],["طُفْتُ الْبِلادَ وَجَرَّبْتُ الْعِبَادَ فَلَمْ","أَرْكَنْ لِخِلٍّ وَلَمْ أَجْنَحْ إِلَى سَكَنِ",35,"ن",1,0],["طَفِقَ النَّسِيمُ يَحُوكُ وَشْيَ بُرُودِهِ","بِأَنَامِلٍ تَمْرِي خُيُوطَ الْمِرْزَمِ",36,"م",1,0],["طَفلَةٌ كَالمَهاةِ لَيسَ لِمَن عا","بَ إِذا تُذكَروا المَعايِبُ وَصمُ",37,"م",1,0],["طِفلَةٌ وَعثَةُ الرَوادِف خَودٌ","كَمَهاةٍ إِنسابَ عَنها الصُوارُ",38,"ر",1,0],["طَفلَةٌ بارِدَةُ القَيظِ إِذا","مَعمَعانُ الصَيفِ أَضحى يَتَّقِد",39,"د",1,0],["طُفْ بالبيانِ الطّلقِِ عذباً سائغاً","إنّا شَرِبْنا الدّينَ فيه كُؤوسا",40,"س",2,0],["طُفْ بالمناصبِ والأرائكِ سائلاً","ماذا تُعاني الأعظُمُ النَّخِراتُ",41,"ت",1,0],["طُف بِالمَشارِقِ هَل تُصادِفُ جاحِداً","وَجُبِ المغَارِبَ هَل تَرى مُرتابا",42,"ب",2,0],["طُف بِالمَشارِقِ وَالمَغارِبِ هَل تَرى","دَعَةً تُرامُ وَغَبطَةً تُرتادُ",43,"د",1,0],["طُف بِالرُقادِ عَلى سَهارى أَعيُنٍ","أَلوى بِنَضرَتِها أَسىً وَسُهادُ",43,"د",1,0],["طُف بِالحُماةِ فَهَل تَرى ذا نَجدَةٍ","إِلّا بِحَيثُ تَرى الدَمَ المُهراقا",44,"ق",2,0],["طفقت تَمضغُ مِن أفلاذِها","عَلقماً مُرّاً وسُماً مُنقَعا",45,"ع",2,0],["طُفْ بالمصارعِ وَاسْتَمِعْ نَجواها","وَالْثِمْ بأفياءِ الجِنانِ ثَراها",46,"ا",3,1],["طفِقَ الثرى من حولها لمّا ارتوى","من ذَوْبِ مهجتها يجفُّ ويَبلحُ",47,"ح",1,0],["طفلة عَن والديها نسخة","كرمت أَصلاً وَطابَت مَعدَنا",48,"ن",2,0],["طفتُ بين الأّزهار والنَّشْر من نش","ركِ فيها ودقةُ التكوين",49,"ن",1,0],["طَفِقْتُ أعُدُّ منها مَوْجَ بَحْرٍ","وَقَطْراً غَيْثُهُ أَبَداً يَصُوبُ",50,"ب",1,0],["طَفلَةٌ كَالغَزالِ ذاتُ دَلالٍ","فِتنَةٌ في النِقابِ وَالإِسفارِ",51,"ر",1,1],["طَفِقتُ أُفَدّيهِ وَأَدعوهُ بِاسمِهِ","فَقالَ مُجيباً ما تَشا بِتَثاقُلِ",52,"ل",1,0],["طَفلَةٌ خَودٌ رَداحٌ","هامَ قَلبي بِهَواها",53,"ا",3,1],["طَفَئَت عُيونُ الناظِرينَ وَأَشرَقَت","عَينُ الغَزالَةِ ما بِها عُوّارُ",54,"ر",1,1],["طَفَونا وَنَرسو الآنَ لا سُرَّ أَسوَدي","بِمِلكِ البَرايا ما العِراقُ وَما النَرسُ",55,"س",1,0],["طَفاها أَسوَدٌ مِن آلِ عَبسٍ","بِأَبيَضَ صارِمٍ حَسَنِ الصِقالِ",56,"ل",1,0],["طُفْ فِي قُرَاهُ فَمَا تَرَى","مِنْ يَأْسِ كُل أَبٍ وَأُمْ",57,"م",1,0],["طفِئَ الَيْومَ ذَلِكَ الكَوْكَبُ الهَا","دِي فَهَلْ دَالَ وَاسْتَتَبَّ الظَّلامُ",58,"م",1,0],["طِفْلٌ لِسَامٍ كانَ وَعْدَ سَعَادَةٍ","وَعَدَ الزّمَانُ بِهِ ذوِيهِ وَقَدْ وَفَى",59,"ف",2,1],["طَفا نَجْمُ الْحَبَابِ بِهَا","عَلَى شَفَقٍ مِنَ الخَمْرِ",60,"ر",1,0],["طُفْ بِالمَحَلَّةِ تُلْفِ كَيْفَ تَبدِلَتْ","بِالبالِيَاتِ حدِيثَةُ الأَنْوَالِ",61,"ل",1,0],["طفلتك القديمة.. المثيرهْ","لم يخجل الغروبُ وهو يقتلُ الأميرهْ",62,"ه",1,0],["طِفلٌ وَلَستُ أَرى حجاهُ بِأَشيَبٍ","حَتّى أَرى طولَ الطلاةِ",63,"ه",1,0],["طُف بي عَلى قَبرِ طفلٍ","كَالشَيخِ فيهِ وقارُ",64,"ر",1,1],["طِفلٌ تَعالى وَجَلَّ رَبٌّ","هَداهُ في مَهدِهِ الصِراطا",65,"ط",2,0],["طفِئَتْ أنوارُ أُميَّةَ فِي","قَصْرِ الخُلفاءِ فقلتَ قِدِ",66,"د",1,0],["طُفْ ببغداد وسَلْ آثارَها","أيُّ سِرٍ كَتَمَتْهُ شَفَتاها",67,"ا",3,0],["طفِقْتُ أمدُّ نحوَ الركبِ طَرْفي","فَغَصَّ الطرفَ كُثْبانٌ ورمل",68,"ل",1,0],["طفلٌ بريءٌ ذاق من","يد أمِّه كأسَ الحِمام",69,"م",1,0],["طفلة ما ابنة المحلل بيضا","لعوب لذيذة في العناق",70,"ق",1,1],["طفقتُ أدُّ منها موجَ بحرٍ","وَقَطْراً غَيْثُهُ أَبداً يَصُوبُ",71,"ب",1,0],["طفِقوا يَعجبون منه فقال الشْ","شَيْخ لا تُنْكِرُن للهِ قُدْره",72,"ر",2,0],["طفقتْ رَوَايَاهُ تجرّ مزادَها","فوق الربى ومزادُها مشقوق",73,"ق",1,0],["طفلة ٌ كالمهاة ِ، ليس لمن عا","بَ، إذا تُذْكَرُ المَعَايِبُ، وَصْمُ",74,"م",1,0],["طفقَ النسيمُ يحوكُ برودهِ","بأناملٍ تمرى خيوطَ المرزمِ",75,"م",1,0]]}