25609.html","البسيط"],[286,"وفتاة حسنها عم وخص","https://www.aldiwan.net/poem32722.html","الرمل"],[302,"هل من يعين على التجلد ساعة","https://www.aldiwan.net/poem36292.html","عموديه"],[302,"برزت بزينتها إليك الشام","https://www.aldiwan.net/poem36300.html","عموديه"],[302,"لو رأيت الكأس والوجه الصبيحا","https://www.aldiwan.net/poem36853.html","عموديه"],[304,"حي الديار بسيل فالقهر","https://www.aldiwan.net/poem45482.html","أحذ الكامل"],[324,"أشرقت بالبشر أنوار التهاني","https://www.aldiwan.net/poem61663.html","الوافر"],[326,"خل قلبي من سليمى نبلها","https://www.aldiwan.net/poem56347.html","الرمل"],[332,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[332,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[332,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[332,"أطرقت في ضراعة تذكر الله","https://www.aldiwan.net/poem55062.html","الخفيف"],[357,"أسرار أشواقي الفؤاد أكنها","https://www.aldiwan.net/poem40147.html","الكامل"],[370,"طفل كفاه القلب دارا له","https://www.aldiwan.net/poem17678.html","السريع"],[407,"طفا على قهوتنا المصطكى","https://www.aldiwan.net/poem33752.html","السريع"],[433,"طفل السرور من الصهباء مولود","https://www.aldiwan.net/poem40519.html","البسيط"],[433,"لله دار غدت بالحسن مشرقة","https://www.aldiwan.net/poem40530.html","البسيط"],[433,"سعد العلياء جلا ثغرا","https://www.aldiwan.net/poem40840.html","المتدارك"],[445,"فوضت أمري إلى ذي القدرة الصمد","https://www.aldiwan.net/poem14302.html","البسيط"],[461,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[467,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[485,"عج ساحل الدير سل عنها الشماميسا","https://www.aldiwan.net/poem24427.html","عموديه"],[485,"طفنا بكعبة حسن قد ألفنا بها","https://www.aldiwan.net/poem24495.html","عموديه"],[503,"أي ورد قد شممناه ضحى","https://www.aldiwan.net/poem37781.html","الرمل"],[508,"تائية القافلة","https://www.aldiwan.net/poem27889.html","البسيط"],[518,"أأرجو بقاء أم صفاء حياة","https://www.aldiwan.net/poem12043.html","الطويل"],[532,"ألا هكذا من يروم الفخارا","https://www.aldiwan.net/poem37413.html","المتقارب"],[556,"أأعلن ما بي أم أسر فأكتم","https://www.aldiwan.net/poem68411.html","الطويل"],[561,"طوبى لمن كشفت بصيرته الغطا","https://www.aldiwan.net/poem33544.html","الكامل"],[561,"يعلم الحق نفسه بالذي قد","https://www.aldiwan.net/poem34093.html","الخفيف"],[561,"قف جانب الدير سل عنها القساسيسا","https://www.aldiwan.net/poem34453.html","البسيط"],[561,"أنا دائما يا نور كل مليح","https://www.aldiwan.net/poem34680.html","الكامل"],[565,"طفح الأنس فوق ساحات جلق","https://www.aldiwan.net/poem52784.html","الخفيف"],[565,"حزن القلوب على الغريب غريب","https://www.aldiwan.net/poem52792.html","الكامل"],[565,"يا نفس هل من أمر ربك عاصم","https://www.aldiwan.net/poem52796.html","الكامل"],[565,"إن كان يلبس ما أفاد تجملا","https://www.aldiwan.net/poem52963.html","الكامل"],[565,"خطرت وفي قلبي لذاك خفوق","https://www.aldiwan.net/poem52991.html","الكامل"],[570,"كأنما الراووق وانتصابه","https://www.aldiwan.net/poem69791.html","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/22534","الطويل"]],"verses":[["طَفَحَ الدّمُ المُهَراقُ في أرْجائِها","دُفَعاً تُضَرَّمُ حَولَها النّيرانُ",0,"ن",1,0],["طُف بِالأَريكَةِ ذاتِ العِزِّ وَالشانِ","وَاِقضِ المَناسِكِ عَن قاصٍ وَعَن داني",1,"ن",2,1],["طُفْتُ وَالصُّبْحُ طَالِباً فِي الجَنَانِ","سَلْوَةً مِنْ نَوَاصِبِ الأَشْجَانِ",2,"ن",1,1],["طِفْلانِ كَالأَخَوَيْنِ مُؤْتَلِفَانِ","شَبَّا وَشَبَّ عَلَى الهَوَى القَلْبَانِ",3,"ن",1,1],["طُفْ بِالقُرَى تلْقَ أُلُوفاً بِهَا","مِنْهُمُ رَقِيقُ الحَالِ وَالمُعْدِمُ",4,"م",1,0],["طَفِيءَ الصَّبَاحُ بَعَيْنِيَ الإِلهَامِ","وَتَغَمَّدَ الَّلأْلاءَ جَفْنُ ظَلامِ",5,"م",1,1],["طفقت أرانِبُهُ غداة أثرتها","تبغي الفرار ولات حين فرارِ",6,"ر",1,0],["طُفنَ بِالكَأسِ بَينَ شَربٍ كِرامٍ","مَهَّدوا حُرَّ صالِحِ الأَنماطِ",7,"ط",1,0],["طفقت له مزوياً نبْتَهُ","زماناً بطافحك الطافق",8,"ق",1,0],["طفِقت تجود بذَوْبها جُوذابة","قَانَى لبابَ اللوز فيها السكّر",9,"ر",1,0],["طفقت تؤنبني سادراً","لتُلزمني الذنب في الظاهر",10,"ر",1,0],["طفِقوا يَعجبون منه فقال ال","شيْخ لا تنْكِرُنَّ للَّهِ قُدْرَه",11,"ر",2,0],["طفِقْت تُحلِّي البحر درّاً ودرُّهُ","عتيدٌ فلم تبعد عليكَ الملاقط",12,"ط",1,0],["طفِّل على من حَصُلت عنده","فبعض تطفيل الفتى رفعه",13,"ع",2,0],["طفتَ بالبيت ثم أبت من الحج","ج فأصبحت للعفاة مطافا",14,"ف",2,0],["طفقت رواياه تجر مزادها","فوق الربا ومزادها مشقوق",15,"ق",1,0],["طفقت تمطر العفاة سماءٌ","من جداكم فما أساءت طُفوقا",16,"ق",2,0],["طفلٌ أراد وصيفاً كيّساً فبكى","حتى أتاهُ مليحُ القدِّ مجدولُ",17,"ل",1,0],["طفيليّون من نحلُل ذراهُ","فأمُّ طعامِه الأمُّ الثكُولُ",18,"ل",1,0],["طُفتُ بأكنافك لا هاجماً","وداءُ عمروٍ أمّنهُ هَجْمي",19,"م",2,0],["طَفَت في الضُحى أَحداجُ أَروى كَأَنَّها","قُرىً مِن جُواثى مُحزَئِلٌّ نَخيلُها",20,"ل",3,0],["طِفلَةٌ ساذَجَةٌ أَطهَرُ مِن","زَهرَةِ الرَوض وَأَنقى جَوهَرا",21,"ر",2,0],["طَفَحَتْ بأَعْماقِ الوُجُودِ","سَكِينَةُ الصَّبْرِ الجَلِيدْ",22,"د",1,0],["طُف بِالسَرير مسلِّماً","واِرجع لِتَوديعِ المَنابِرْ",23,"ر",1,0],["طف بديوان حافظ واجن زهرا","فهو لا نافض ولا ممنوع",24,"ع",1,0],["طفلٌ صغيرٌ في السن جداً","كصورة الحسن والجمال",25,"ل",1,0],["طفل علينا أمير","مقبل الركبتين",26,"ن",1,0],["طُفنا بِقَبرِكَ وَاِستَلَمنا جَندَلاً","كَالرُكنِ أَزكى وَالحَطيمِ مُطَهَّرا",27,"ر",2,0],["طَفِقَت تَلومُ وَلاتَ حينَ مَلامِهِ","لا عِندَ كَبرَتِهِ وَلا إِحجامِهِ",28,"م",2,1],["طَفَحَت نَشوَةُ المُدامِ وَقَد شَط","طَت عَلى الشارِبينِ أَيَّ اِشتِطاطِ",29,"ط",1,0],["طِفلُ صُبحٍ لَهُ مِنَ الشَرقِ مَهدٌ","وَلَهُ حُلَّةُ الدُجى كَالقِماطِ",29,"ط",1,0],["طُفَيلٌ تُقادُ بِأَذنابِها","وُقودُ الجِيادِ بِأَرسانِها",30,"ه",2,1],["طَفَحَ السُرورُ عَلَيَّ حَتّى إِنَّهُ","مِن عِظمِ ما قَد سَرَّني أَبكاني",31,"ن",2,0],["طفا وقد قبّل أنوارها","ورفَّ مثل الطائر الحاسي",32,"س",2,0],["طِفلَةٌ ما اِبنَةُ المُجَلِّلِ بَيضا","ءُ لَعوبٌ لَذيذَةٌ في العِناقِ",33,"ق",1,1],["طَفْلَةٌ تسرَحُ في أعطافِها","لِلأَظانين وللدَلِّ مراح",34,"ح",1,0],["طفتُ في الآفاق حتى اكتهلَتْ","غُرْبَتِي واحتنكت سنّ الأدب",35,"ب",1,0],["طُفْتُ الْبِلادَ وَجَرَّبْتُ الْعِبَادَ فَلَمْ","أَرْكَنْ لِخِلٍّ وَلَمْ أَجْنَحْ إِلَى سَكَنِ",36,"ن",1,0],["طَفِقَ النَّسِيمُ يَحُوكُ وَشْيَ بُرُودِهِ","بِأَنَامِلٍ تَمْرِي خُيُوطَ الْمِرْزَمِ",37,"م",1,0],["طَفلَةٌ كَالمَهاةِ لَيسَ لِمَن عا","بَ إِذا تُذكَروا المَعايِبُ وَصمُ",38,"م",1,0],["طِفلَةٌ وَعثَةُ الرَوادِف خَودٌ","كَمَهاةٍ إِنسابَ عَنها الصُوارُ",39,"ر",1,0],["طَفلَةٌ بارِدَةُ القَيظِ إِذا","مَعمَعانُ الصَيفِ أَضحى يَتَّقِد",40,"د",1,0],["طُفْ بالبيانِ الطّلقِِ عذباً سائغاً","إنّا شَرِبْنا الدّينَ فيه كُؤوسا",41,"س",2,0],["طُفْ بالمناصبِ والأرائكِ سائلاً","ماذا تُعاني الأعظُمُ النَّخِراتُ",42,"ت",1,0],["طُف بِالمَشارِقِ هَل تُصادِفُ جاحِداً","وَجُبِ المغَارِبَ هَل تَرى مُرتابا",43,"ب",2,0],["طُف بِالمَشارِقِ وَالمَغارِبِ هَل تَرى","دَعَةً تُرامُ وَغَبطَةً تُرتادُ",44,"د",1,0],["طُف بِالرُقادِ عَلى سَهارى أَعيُنٍ","أَلوى بِنَضرَتِها أَسىً وَسُهادُ",44,"د",1,0],["طُف بِالحُماةِ فَهَل تَرى ذا نَجدَةٍ","إِلّا بِحَيثُ تَرى الدَمَ المُهراقا",45,"ق",2,0],["طفقت تَمضغُ مِن أفلاذِها","عَلقماً مُرّاً وسُماً مُنقَعا",46,"ع",2,0],["طُفْ بالمصارعِ وَاسْتَمِعْ نَجواها","وَالْثِمْ بأفياءِ الجِنانِ ثَراها",47,"ا",3,1],["طفِقَ الثرى من حولها لمّا ارتوى","من ذَوْبِ مهجتها يجفُّ ويَبلحُ",48,"ح",1,0],["طفلة عَن والديها نسخة","كرمت أَصلاً وَطابَت مَعدَنا",49,"ن",2,0],["طفتُ بين الأّزهار والنَّشْر من نش","ركِ فيها ودقةُ التكوين",50,"ن",1,0],["طَفِقْتُ أعُدُّ منها مَوْجَ بَحْرٍ","وَقَطْراً غَيْثُهُ أَبَداً يَصُوبُ",51,"ب",1,0],["طَفلَةٌ كَالغَزالِ ذاتُ دَلالٍ","فِتنَةٌ في النِقابِ وَالإِسفارِ",52,"ر",1,1],["طَفِقتُ أُفَدّيهِ وَأَدعوهُ بِاسمِهِ","فَقالَ مُجيباً ما تَشا بِتَثاقُلِ",53,"ل",1,0],["طَفلَةٌ خَودٌ رَداحٌ","هامَ قَلبي بِهَواها",54,"ا",3,1],["طَفَئَت عُيونُ الناظِرينَ وَأَشرَقَت","عَينُ الغَزالَةِ ما بِها عُوّارُ",55,"ر",1,1],["طَفَونا وَنَرسو الآنَ لا سُرَّ أَسوَدي","بِمِلكِ البَرايا ما العِراقُ وَما النَرسُ",56,"س",1,0],["طف بقلبي تجد به ألف دنيا","لا يلاقي الشقيق فيها الشقيقا",57,"ق",2,0],["طَفاها أَسوَدٌ مِن آلِ عَبسٍ","بِأَبيَضَ صارِمٍ حَسَنِ الصِقالِ",58,"ل",1,0],["طُفْ فِي قُرَاهُ فَمَا تَرَى","مِنْ يَأْسِ كُل أَبٍ وَأُمْ",59,"م",1,0],["طفِئَ الَيْومَ ذَلِكَ الكَوْكَبُ الهَا","دِي فَهَلْ دَالَ وَاسْتَتَبَّ الظَّلامُ",60,"م",1,0],["طِفْلٌ لِسَامٍ كانَ وَعْدَ سَعَادَةٍ","وَعَدَ الزّمَانُ بِهِ ذوِيهِ وَقَدْ وَفَى",61,"ف",2,1],["طَفا نَجْمُ الْحَبَابِ بِهَا","عَلَى شَفَقٍ مِنَ الخَمْرِ",62,"ر",1,0],["طُفْ بِالمَحَلَّةِ تُلْفِ كَيْفَ تَبدِلَتْ","بِالبالِيَاتِ حدِيثَةُ الأَنْوَالِ",63,"ل",1,0],["طفلتك القديمة.. المثيرهْ","لم يخجل الغروبُ وهو يقتلُ الأميرهْ",64,"ه",1,0],["طِفلٌ وَلَستُ أَرى حجاهُ بِأَشيَبٍ","حَتّى أَرى طولَ الطلاةِ",65,"ه",1,0],["طُف بي عَلى قَبرِ طفلٍ","كَالشَيخِ فيهِ وقارُ",66,"ر",1,1],["طِفلٌ تَعالى وَجَلَّ رَبٌّ","هَداهُ في مَهدِهِ الصِراطا",67,"ط",2,0],["طفِئَتْ أنوارُ أُميَّةَ فِي","قَصْرِ الخُلفاءِ فقلتَ قِدِ",68,"د",1,0],["طُفْ ببغداد وسَلْ آثارَها","أيُّ سِرٍ كَتَمَتْهُ شَفَتاها",69,"ا",3,0],["طفِقْتُ أمدُّ نحوَ الركبِ طَرْفي","فَغَصَّ الطرفَ كُثْبانٌ ورمل",70,"ل",1,0],["طفلٌ بريءٌ ذاق من","يد أمِّه كأسَ الحِمام",71,"م",1,0],["طفل جاري كان يستسقي أنا","كنت أرجو ، لحظة حبلى جواده",72,"د",2,0],["طفلة ما ابنة المحلل بيضا","لعوب لذيذة في العناق",73,"ق",1,1],["طفقتُ أدُّ منها موجَ بحرٍ","وَقَطْراً غَيْثُهُ أَبداً يَصُوبُ",74,"ب",1,0],["طفل فإن نال ضيم من كرامته","ما البحر يزأر . ما البركان ينفجر",75,"ر",1,0],["طفولة الروح أغلى ما أدلّ به","والحبّ أعنفه عندي وأوفاه",76,"ا",2,0],["طفولةٌ كما تبوحُ الربى","ومبسمٌ كأنَّه الفاتحَهْ..",77,"ح",2,0],["طفِقوا يَعجبون منه فقال الشْ","شَيْخ لا تُنْكِرُن للهِ قُدْره",78,"ر",2,0],["طفقتْ رَوَايَاهُ تجرّ مزادَها","فوق الربى ومزادُها مشقوق",79,"ق",1,0],["طفلة ٌ كالمهاة ِ، ليس لمن عا","بَ، إذا تُذْكَرُ المَعَايِبُ، وَصْمُ",80,"م",1,0],["طفقَ النسيمُ يحوكُ برودهِ","بأناملٍ تمرى خيوطَ المرزمِ",81,"م",1,0],["طفل يَبيت وَمَهدُهُ","في الأُفق مَحسود الهِلال",82,"ل",1,0],["طَفَوتُ على بَحرٍ مَنَ الحُبِّ زاخرٍ","فهَا أنا أبدُو تارَةً ثمَّ أنقَطُّ",83,"ط",1,0],["طَفَونا بِهِ فَوقَ البَريَّةِ كُلِّها","فَما غَضَّ مِنّا لا رُسوبٌ وَلا غَطُّ",84,"ط",1,0],["طَفِقَت تَجدَعُ فيهِ رِجالُ ال","أز