","https://www.aldiwan.net/poem49169.html","الكامل"],[143,"ليت الهوى يصرفه الراقى","https://www.aldiwan.net/poem58422.html","السريع"],[148,"خليلي لا تجزع من الجوع إنه","https://www.aldiwan.net/poem47654.html","الطويل"],[161,"أبشر ببشرى بابها قد فتحا","https://www.aldiwan.net/poem58772.html","الرجز"],[161,"هذي خطوطك في كفي مشاهدة","https://www.aldiwan.net/poem58798.html","البسيط"],[167,"يا خالق الخلق حملت الورى","https://www.aldiwan.net/poem46825.html","السريع"],[182,"ألا يا سلم عوجى تخبرينا","https://www.aldiwan.net/poem58837.html","الوافر"],[183,"رمس به من آل صافي نازل","https://www.aldiwan.net/poem61160.html","الكامل"],[183,"هذا ضريح طبيبنا الشهم الذي","https://www.aldiwan.net/poem61189.html","الكامل"],[187,"يا سيدي وعدك تحصيل","https://www.aldiwan.net/poem43469.html","السريع"],[224,"كل حي يموت إلا هوانا","https://www.aldiwan.net/poem39719.html","الخفيف"],[260,"ربنا إننا لهجنا بذكرك","https://www.aldiwan.net/poem35973.html","الخفيف"],[271,"على الشاطىء المصري ضل فتى الشام","https://www.aldiwan.net/poem35638.html","الطويل"],[271,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[271,"عودي الى ماضيك يا بغداد","https://www.aldiwan.net/poem35650.html","الكامل"],[283,"ذكرتك إذ شمت بالشام برقا","https://www.aldiwan.net/poem32694.html","المتقارب"],[298,"أما وابتسام الروض عن شنب الزهر","https://www.aldiwan.net/poem33260.html","الطويل"],[301,"فمثلك ألوى بالفؤاد وزار بالعداد","https://www.aldiwan.net/poem45486.html","الطويل"],[305,"فيم الركون إلى حقيقتها","https://www.aldiwan.net/poem16750.html","البسيط"],[305,"مرحباً بالشادن الغزل","https://www.aldiwan.net/poem16881.html","المديد"],[306,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[306,"عظم الأجر عن عظيم المصاب","https://www.aldiwan.net/poem56609.html","الكامل"],[329,"هدم الليل ما بناه النهار","https://www.aldiwan.net/poem55005.html","الخفيف"],[329,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[329,"هات الدموع فأنت شاعر","https://www.aldiwan.net/poem55048.html","مجزوء الكامل"],[343,"وليلة طاب بها مجلسي","https://www.aldiwan.net/poem55340.html","السريع"],[350,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[350,"أنا والورى باسم الهوى سيان","https://www.aldiwan.net/poem15971.html","الكامل"],[365,"حياءك من غصن بدمعي ثابت","https://www.aldiwan.net/poem60980.html","الطويل"],[365,"ألم يأن يا صاح أم قد أنى","https://www.aldiwan.net/poem61009.html","المتقارب"],[366,"لقد أيقنت عنتر أن حربي","https://www.aldiwan.net/poem44369.html","الوافر"],[366,"إنني بالنبي موقنة نفسي","https://www.aldiwan.net/poem44475.html","الخفيف"],[381,"بأي حال تراه يصطبر","https://www.aldiwan.net/poem48834.html","المنسرح"],[394,"شيب لغير أوانه يعتاد","https://www.aldiwan.net/poem53667.html","الكامل"],[394,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[395,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[404,"ألم بجسمي عارض طال مكثه","https://www.aldiwan.net/poem33451.html","الطويل"],[404,"هذا كتاب كله جهل","https://www.aldiwan.net/poem33466.html","الكامل"],[404,"وأكفر أهل الأرض من قال إنه","https://www.aldiwan.net/poem33952.html","الطويل"],[413,"وعبد كلال حاز كل عظيمة","https://www.aldiwan.net/poem46.html","الطويل"],[417,"هلم بنا نزور أبا الخصيب","https://www.aldiwan.net/poem54011.html","الوافر"],[433,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[440,"عزم حداه السعد والإقبال","https://www.aldiwan.net/poem34802.html","الكامل"],[440,"دواليك من دهر يواليك بالنجح","https://www.aldiwan.net/poem34846.html","الطويل"],[459,"إذا لم يرع عندكم الوداد","https://www.aldiwan.net/poem56241.html","المتقارب"],[459,"أفلح قوم إذا دعوا وثبوا","https://www.aldiwan.net/poem56299.html","المنسرح"],[462,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[462,"إذا ما بحار الأرض جاشت وأجلبت","https://www.aldiwan.net/poem16350.html","الطويل"],[469,"أيا من يهاب ومن يتقى","https://www.aldiwan.net/poem59813.html","المتقارب"],[501,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[501,"هل العناية إلا أن ترى رجلا","https://www.aldiwan.net/poem38034.html","البسيط"],[530,"إذا لم تطق للخطوب اصطبارا","https://www.aldiwan.net/poem37389.html","المتقارب"],[539,"إني بعثت لسيدي بكتابي","https://www.aldiwan.net/poem48294.html","عموديه"],[559,"إني أنا لست أنا","https://www.aldiwan.net/poem33847.html","مجزوء الرجز"],[559,"لا تظلم الله بما لا يليق","https://www.aldiwan.net/poem34298.html","السريع"]],"verses":[["وَعِبءٌ عَلى عَينَيَّ رُؤيَةُ غَيرِهِ","وَلَو كانَ لي فيهِ مُنىً وَطِلابُ",0,"ب",1,0],["وَعَبدٌ قَد يَنامُ عَلى حَريرٍ","وَذو نَسَبٍ مَفارِشُهُ التُرابُ",1,"ب",1,0],["وَعَبَثتَ مِنهُ بِطُرَّةٍ","سَوداءَ لَمّا تَنصُلِ",2,"ل",1,0],["وَعَبَأتُم لِلفِسقِ ظُفرَ سِعايَةٍ","لَم يَعدُكُم أَن رُدَّ وَهُوَ مُقَلَّمُ",3,"م",1,0],["وَعَبساً صَبَحنا بِثَهلانِهِم","بِكَأسٍ وَلَيسَ بِكَأسِ المُدامِ",4,"م",1,0],["وَعَبَدْتُ أَحْرُفَهُ كَرَمْزٍ حَاجِبٍ","صَنَماً رَآهُ عَابِدُ الأَوْثَانِ",5,"ن",1,0],["وَعَبَسَ الأُفْقُ فَلا يُجْتَلَى","سِوَى نُجَيْمٍ رَاجِفٍ بَاسِمِ",6,"م",1,0],["وَعَبدَ يَغوثَ اِستَنزَلَتهُ رِماحُنا","بِبَطنِ كُلابٍ بَينَ غابٍ وَقَسطَلِ",7,"ل",1,0],["وَعَبدُ يَغوثٍ تَحجِلُ الطَيرُ حَولَهُ","قَدِ اِحتَزَّ عُرشَيهِ الحُسامُ المُذكَّرُ",8,"ر",1,0],["وَعَبسٌ وَهُم يَومَ الفَروقَينِ طَرَّقوا","بِأَسيافِهِم قُدموسَ رَأسِ صُلادِمِ",9,"م",1,0],["وَعَبسٌ بِالثَنيَّةِ يَومَ عَمروٍ","سَقَوهُ ذَواعِفَ الأَسَلِ النِهالِ",10,"ل",1,0],["وَعَبدُ القَيسِ قَد رَجَعوا خَزايا","وَأَهلُ عُمانَ قَد لاقوا غَراما",11,"م",2,0],["وَعَبدُ يَغوثٍ تَحجُلُ الطَيرُ حَولَهُ","وَقَد ثَلَّ عَرشيهِ الحُسامُ المُذَكَّرُ",12,"ر",1,1],["وعبد الرحيم جِماعُ الأمور","إليه انتهى اللَقَمُ المُعْمَلُ",13,"ل",1,1],["وَعَبدُ يَغُوثَ قَد لاَقى نِزَاراً","غَداةَ التَّيم غَيرَ مهللِينَا",14,"ن",2,0],["وعَبرةٌ للغيثِ مسفوحةٌ","إذا سقاها الأرضَ لم تُخْصِبِ",15,"ب",1,0],["وعبدُك العبدُ لا يُخلّفه","عن حظّه غيرَ ما نثاهُ لكا",16,"ك",2,0],["وعبَّستِ الحسانُ إلى مَشيبي","فما لثُغورها برقٌ يُشامُ",17,"م",1,0],["وَعَبدُ القَيسِ مُصفَرٌّ لِحاها","كَأَنَّ فُساءَها قِطَعُ الضَبابِ",18,"ب",1,0],["وَعِبادَةً لِلحَقِّ أَينَ وَجَدتُهُ","وَالحُسنِ في الأَحياءِ وَالأَشياءِ",19,"ا",2,0],["وَعَبَروا غَفلَتَها","إِلى الظُهورِ قَنطَرَه",20,"ر",2,0],["وَعَبدُكَ أَحظَتهُ إِلَيكَ نَصيحَةٌ","وَأَرضاكَ مِنهُ مَشهَدٌ وَمَغيبُ",21,"ب",1,0],["وَعُبَيداً وَمُسهِراً وَجُدَيّاً","وَتَدولاً وَبُحتُراً وَعَتودا",22,"د",2,0],["وعَبرةٌ في احمرارِ الخدِّ حائرةٌ","كأنما مَرَحُ الصَّهباءِ جَارِيها",23,"ي",3,0],["وَعَبيدٍ خُوِّلوا ساداتِهِم","فَاِستَقَرَّ المُلكُ فيهِم وَرَسَب",24,"ب",1,0],["وَعَبَروا الدُنيا إِلى غَيرِها","فَإِنَّما الدُنيا لَهُم مَعبَرُ",25,"ر",1,0],["وَعِبْتِ لَبوسي إذ غدا دونَ هِمّتي","وكم شَمْلَةٍ فيها كريمُ الشّمائلِ",26,"ل",1,0],["وعبِيدُكَ الغلمانُ إن نادَيْتَهُم","نَهَضُوا مُوَاثَبَةَ الأسود وثاروا",27,"ر",3,0],["وَعِبادَةُ الأَهواءِ في تَطويحِها","بِالدينِ فَوقَ عِبادَةِ الأَصنامِ",28,"م",1,0],["وَعَبدَةُ بَيضاءُ المَحاجِرِ طَفلَةٌ","مُنَعَّمَةٌ تُصبى الحَليمَ وَلا تَصبو",29,"ب",2,0],["وعبادةُ الأصنامِ قام دُعاتُها","مِلءَ الممالكِ ما على يدهم يَدُ",30,"د",1,0],["وَعبدُ اللَّهِ فِيمَ قَتلتموهُ","وَسُقْتُمْ صاحِبَيْهِ بشرِّ حالِ",31,"ل",1,0],["وعَبَّ عُبابُ الموكبِ الفخم حولَهُ","وزَفّ كما زَف الصّباحُ المُلَمَّع",32,"ع",1,0],["وعَبْدُ غيْرِكَ مضْرُورٌ بخِدْمَتِهِ","كالغِمْدِ يُبْليه صَوْنُ الصّارِمِ الذّكَرِ",33,"ر",1,0],["وَعَبلَةٍ كَمَهاةِ الجَوِّ ناعِمَةٍ","كَأَنَّ ريقَتَها شيبَت بِسَلسالِ",34,"ل",1,0],["وعَبَرْنا رحابها","فأشارتْ لمن عَبَرْ",35,"ر",1,0],["وعبدت ربي ما استطع","ت ومن بريته بريت",36,"ت",1,0],["وَعُبَابٌ مَا مَاجَ إِلاَّ بِإِبْراقِ","أَسَارِيرِهِ مِنَ السَّرَّاءِ",37,"ا",2,0],["وَعِبْئُهُ فِي هَوَى حِمَاهُ","لَمْ يَلْقَهُ فِي الْحُمَاةِ لاَقِ",38,"ق",1,0],["وعبرَ دِجلة: شعبٌ قامَ قَوْمتِهُ ال","كُبْرى، وثار على الطُّغْيان ثائره",39,"ر",2,0],["وعبرنا ليلا كألسنة الحيّات","والدرب عاصف بالتلاحي",40,"ح",2,0],["وَعَبدُكَ أحْظَتْهُ لَدَيْكَ نَصِيحَةٌ،","وأرْضَاكَ منهُ مَشهَدٌ وَمَغيبُ",41,"ب",1,0],["وعبادة لا الحشر أملاها عليّ ولا الحساب","وإذا سألت عن الذنوب فإن ّ أدمعي الجواب",42,"ب",1,0],["وَعَبَأتُ للباغي عَلَيْكَ هِجَاءَ","وَنَفَضْتُ إلاّ مِنْ هَوَاكَ خَوَاطرِي",43,"ي",1,0],["وعبد القادر الجيلي شيخ ال","شيوخ العارف الاسد الشهير",44,"ر",1,0],["وَعَبّاسٌ يُدِبُّ لِيَ المَنايا","وَما أَذنَبتُ إِلّا ذَنبَ صُحرِ",45,"ر",1,0],["وعبرةً وعظاتٍ ثم منفعةً","للسائلين وأفكاراً لمعتبِرِ",46,"ر",1,0],["وَعَبدُ يَغوثَ تَحجُلُ الطَيرُ حَولَهُ","وَعَزَّ المُصابُ جَثوَ قَبرٍ عَلى قَبرِ",47,"ر",1,0],["وَعَبساً قَتَلناهُم بِحُرِّ بِلادِهِم","بِمَقتَلِ عَبدِ اللَهِ يَومَ الذَنائِبِ",48,"ب",1,0],["وعبارة تشفى الغليل ومنطق","بمجامع المعنى يحيط نطاقا",49,"ق",2,0],["وعبد قِنٍّ لك لم يلتمس","من رقِّهِ راحةَ إعتاقِ",50,"ق",1,0],["وعبدك إن يشفيه مولاه في غد","سيأكل أكل الفيل فاهنأ بها بشرى",51,"ر",2,0],["وعبدك الدهر فلا تنسَ له","صنيعة فانه قد نصحا",52,"ح",2,0],["وعبدك ابني قَد ضاقت مذاهبه","منهم وقد عارضوه بعد ما وثقا",53,"ق",2,0],["وعبدُك الآنَ طغى ماؤُهُ","في الصُّلب فاحملْهُ على جارِيَهْ",54,"ه",1,0],["وعبّاساً أخا رعلٍ قَطَعنا","بِأَبيَضَ لَهذَمٍ مِنهُ الوَتِينَا",55,"ن",2,0],["وَعِبارةُ التاريخِ تَنطقُ أَنَّهُ","بِالبِرِّ قَد نالَ الكَرامةَ يُوسُفُ",56,"ف",1,0],["وَعِبارةُ التأريخِ أَمْلَتْ فَوقَهُ","نالَ السَليمُ سَلامةَ الأَبرارِ",57,"ر",1,0],["وعبدك الأحنف يا سيّدي","ملقى بسيف الفقر مقتول",58,"ل",1,0],["وَعَبيرُ النِسرين يَنهَلُّ حُبّاً","في العَبيرِ المَنشورِ مِن نَجوانا",59,"ن",2,0],["وَعَبَدناكَ حَيثُما أَنتَ أَهلٌ","وَحَمَدناكَ مَع تَزايُدِ شُكرِك",60,"ك",1,0],["وعبرتُه بين الجفونِ عزيزةٌ","يضنُّ بها إلا على موقفٍ سام",61,"م",1,0],["وعبدُ رحمانِها يَلهو بزخرفِها","والفنُّ يعشقُ تشييداً وتزيينا",62,"ن",2,0],["وعبيدُهم متحكِّمونَ بِدَولةٍ","مع أهلِها ذهبَ الندى والآد",63,"د",1,0],["وَعَبدُكَ قَد طالَ تَثقيلُهُ","عَلَيكَ وَما يَبتَغي مِنكَ عتقا",64,"ق",2,0],["وَعبرة عَينٍ لا تجفُّ جفونُها","إِذا هتفت أَيكيَّةٌ أَقبلت تَجري",65,"ر",2,0],["وَعَبَّرنَ عَن فَرقيسَياءَ لِعَرعَرٍ","وَفُرضَةِ نُعمٍ ساءَ ذاكَ مَعَبَّرا",66,"ر",2,0],["وَعَبَدوا الناسَ حَتّى أَصبَحوا ذُلَلاً","لِأَمرِهِم بَينَ مَغلوبٍ وَمُمتَهِنِ",67,"ن",1,0],["وعبيد اللَه يتبعه","علوى المذكور في سمل",68,"ل",1,0],["وَعَبرتَ عَن دُنياكَ عبرةَ نازعٍ","عَنها إِلى وطنِ المقامةِ ينزعُ",69,"ع",1,0],["وَعِباد الرحمنِ قومٌ لديه","نَفَضوا الإختيار نفض الجرابِ",70,"ب",1,0],["وعبيداً يشدون شتّى لحونٍ","في حمى القصر سجّداً وقياما",71,"م",2,0],["وعبدتم أنتم عبيد تراب","وبذلتم حياءكم قربانا",72,"ن",2,0],["وعبير روحك خالد","التطواف معبود النفاح",73,"ح",1,0],["وعبلة الحسناء ترنو إلى","خطيبها اللابس المحبس",74,"س",1,0],["وعبلد الطفلة يا عبلة ال","طفلة يا ريحانة الانفس",74,"س",1,0],["وَعَبدُها بِحُبِّهِ تَعَبُّدي","وَإِن قَلاهُ مَن عَنِ الحَقِّ اِنبَتَر",75,"ر",1,0],["وَعَبَرتُ مِن فَوقِ الصِراطِ مَسَلِّماً","لِما بَدا الرَجحانُ في ميزاني",76,"ن",2,0],["وعِبثين من هَمٍّ حَملْتُ وهِمّةٍ","كَذي ضاغطٍ يَطْوي الفلاةَ وناكت",77,"ت",1,0],["وعِبْءٌ على جَفْنِ عينِ الجَهولِ","لِقاءُ أخى العلم مهما رأى",78,"ا",1,0],["وعبسٌ فوقَها طيرُ المنايا","ومُعضِلةٌ تَحُفُّ بها جليله",79,"ل",2,0],["وَعَبَدنا الإِلهَ حقاً وكنَّا","للجهالاتِ نَعبُدُ الأَوثانا",80,"ن",2,0],["وَعبرة في أَنصاب عبرَتِهِ","لَو أَن صِبا بِذاكَ يَعتبر",81,"ر",1,0],["وَعبادةٌ لو قَسِّمَت بَينَ الوَرى","عادَ العِبادُ وَكلُّهُم عُبّاد",82,"د",1,0],["وَعِبادَةٍ ما نالَ عَبد مِثلَها","لِأَداءِ فرضٍ أَو أَداءِ تَنَفُّلِ",83,"ل",1,0],["وعبير النارنج أحلى وأندى","من غبار المدينة المتراكم",84,"م",1,0],["وعُبَّادُ عجل السامري على هدى","وهارون أخطى إذ أتى بملام",85,"م",1,0],["وعبادة الأوثان مكرمة","فيها يطيب القول والفعل",86,"ل",1,0],["وعُبَّادُ عجل السامري على هدى","ولائمهم في اللوم ليس على رشد",87,"د",1,0],["وعَبدُ كُلاَلٍ حَازَ كُلَّ عَظِيمَةٍ","سَمِعتُ بِهَا فِي حِميَرٍ وكَفِيلِهَا",88,"ه",2,1],["وعبد الواحد الموصوف فيهم","بطول الباع والصَّدر الرَّحيب",89,"ب",1,0],["وعَبَّ الصُّبحُ في كأْسِ الثُّرَيَّا","وكان برحَةِ القَمَرِ المنيرِ",90,"ر",1,0],["وعبيدُ مملكَةٍ وشِيعَةُ دَوْلَةٍ","قَدْ أَيْقَنُوا أَنَّ الحياةَ قِتالُ",91,"ل",1,0],["وعَبْرَةِ ثكلى مَا تقلِّبُ ناظِراً","إِلَى أُفُقٍ إِلّا يقولُ لَهَا سُحِّي",92,"ح",2,0],["وعبتِ وليس غيرُ الشيب شيئاً","أُذادُ له بعيبٍ أو أُكادُ",93,"د",1,0],["وعَبْرةٍ ريُّه وَحِليتُه","يُشرَبُ من مائها ويُختضَبُ",94,"ب",1,0],["وعَبَّ عُبابٌ هاشميٌّ فلم يكُنْ","له جبلٌ من مغرق الشرِّ يُعْصِم",95,"م",1,0],["وعبَّ عُبابٌ يُلحقُ القعْرَ بالذُّرى","ويقذفُ دُرّاً في مواطنَ جنْدَلِ",96,"ل",1,0],["وَعَبّا البَوارِدِ في جونَةٍ","أَجَنَّ مِنَ الخَوفِ أَن تُطبِقا",97,"ق",2,0],["وعُبَيْدٌ ضَلِلْتُ فاجْتَذَبَتْني","ودَعَتْني بالسَّيِّدِ المَهْدِيِّ",98,"ي",1,0],["وعبدُ بارِئهِ في ظلِّ رأفَتِه","فَظلُّهُ بِجناحِ العِزِّ مَمْدودُ",99,"د",1,0],["وَعِبْءُ الرّئاسَةِ إنْ كُنْتَ لاَ","تَنُوءُ بِهِ فاطَّرِحْهُ جِهارا",100,"ر",2,0],["وعُبيدَكُم يرجُو الصَّويرَة ثم لاَ","يَلقَى سَبيلا مِن فراغٍ وِطَابِ",101,"ب",1,0],["وعبدوه مثل قو","م يعبدون الوثنا",102,"ن",2,0],["وعبدوا الأصنام جهلاً وقد","خروا إليها سُجَّداً بالحقيق",103,"ق",1,0]]}