85,"هذه الشام لا تقولي كفانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86807&r=&rc=0",""],[6318,"لآلئ الشِّعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66159&r=&rc=9",""],[6355,"يد الحلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66611&r=&rc=71",""]],"verses":[["وَعِبءٌ عَلى عَينَيَّ رُؤيَةُ غَيرِهِ","وَلَو كانَ لي فيهِ مُنىً وَطِلابُ",0,"ب",1,0],["وَعَبدٌ قَد يَنامُ عَلى حَريرٍ","وَذو نَسَبٍ مَفارِشُهُ التُرابُ",1,"ب",1,0],["وَعَبَثتَ مِنهُ بِطُرَّةٍ","سَوداءَ لَمّا تَنصُلِ",2,"ل",1,0],["وَعَبَأتُم لِلفِسقِ ظُفرَ سِعايَةٍ","لَم يَعدُكُم أَن رُدَّ وَهُوَ مُقَلَّمُ",3,"م",1,0],["وَعَبساً صَبَحنا بِثَهلانِهِم","بِكَأسٍ وَلَيسَ بِكَأسِ المُدامِ",4,"م",1,0],["وَعَبَدْتُ أَحْرُفَهُ كَرَمْزٍ حَاجِبٍ","صَنَماً رَآهُ عَابِدُ الأَوْثَانِ",5,"ن",1,0],["وَعَبَسَ الأُفْقُ فَلا يُجْتَلَى","سِوَى نُجَيْمٍ رَاجِفٍ بَاسِمِ",6,"م",1,0],["وَعَبدَ يَغوثَ اِستَنزَلَتهُ رِماحُنا","بِبَطنِ كُلابٍ بَينَ غابٍ وَقَسطَلِ",7,"ل",1,0],["وَعَبدُ يَغوثٍ تَحجِلُ الطَيرُ حَولَهُ","قَدِ اِحتَزَّ عُرشَيهِ الحُسامُ المُذكَّرُ",8,"ر",1,0],["وَعَبسٌ وَهُم يَومَ الفَروقَينِ طَرَّقوا","بِأَسيافِهِم قُدموسَ رَأسِ صُلادِمِ",9,"م",1,0],["وَعَبسٌ بِالثَنيَّةِ يَومَ عَمروٍ","سَقَوهُ ذَواعِفَ الأَسَلِ النِهالِ",10,"ل",1,0],["وَعَبدُ القَيسِ قَد رَجَعوا خَزايا","وَأَهلُ عُمانَ قَد لاقوا غَراما",11,"م",2,0],["وَعَبدُ يَغوثٍ تَحجُلُ الطَيرُ حَولَهُ","وَقَد ثَلَّ عَرشيهِ الحُسامُ المُذَكَّرُ",12,"ر",1,1],["وعبد الرحيم جِماعُ الأمور","إليه انتهى اللَقَمُ المُعْمَلُ",13,"ل",1,1],["وَعَبدُ يَغُوثَ قَد لاَقى نِزَاراً","غَداةَ التَّيم غَيرَ مهللِينَا",14,"ن",2,0],["وعَبرةٌ للغيثِ مسفوحةٌ","إذا سقاها الأرضَ لم تُخْصِبِ",15,"ب",1,0],["وعبدُك العبدُ لا يُخلّفه","عن حظّه غيرَ ما نثاهُ لكا",16,"ك",2,0],["وعبَّستِ الحسانُ إلى مَشيبي","فما لثُغورها برقٌ يُشامُ",17,"م",1,0],["وَعَبدُ القَيسِ مُصفَرٌّ لِحاها","كَأَنَّ فُساءَها قِطَعُ الضَبابِ",18,"ب",1,0],["وَعِبادَةً لِلحَقِّ أَينَ وَجَدتُهُ","وَالحُسنِ في الأَحياءِ وَالأَشياءِ",19,"ا",2,0],["وَعَبَروا غَفلَتَها","إِلى الظُهورِ قَنطَرَه",20,"ر",2,0],["وَعَبدُكَ أَحظَتهُ إِلَيكَ نَصيحَةٌ","وَأَرضاكَ مِنهُ مَشهَدٌ وَمَغيبُ",21,"ب",1,0],["وَعُبَيداً وَمُسهِراً وَجُدَيّاً","وَتَدولاً وَبُحتُراً وَعَتودا",22,"د",2,0],["وعَبرةٌ في احمرارِ الخدِّ حائرةٌ","كأنما مَرَحُ الصَّهباءِ جَارِيها",23,"ي",3,0],["وَعَبيدٍ خُوِّلوا ساداتِهِم","فَاِستَقَرَّ المُلكُ فيهِم وَرَسَب",24,"ب",1,0],["وَعَبَروا الدُنيا إِلى غَيرِها","فَإِنَّما الدُنيا لَهُم مَعبَرُ",25,"ر",1,0],["وَعِبْتِ لَبوسي إذ غدا دونَ هِمّتي","وكم شَمْلَةٍ فيها كريمُ الشّمائلِ",26,"ل",1,0],["وعبِيدُكَ الغلمانُ إن نادَيْتَهُم","نَهَضُوا مُوَاثَبَةَ الأسود وثاروا",27,"ر",3,0],["وَعِبادَةُ الأَهواءِ في تَطويحِها","بِالدينِ فَوقَ عِبادَةِ الأَصنامِ",28,"م",1,0],["وَعَبدَةُ بَيضاءُ المَحاجِرِ طَفلَةٌ","مُنَعَّمَةٌ تُصبى الحَليمَ وَلا تَصبو",29,"ب",2,0],["وعبادةُ الأصنامِ قام دُعاتُها","مِلءَ الممالكِ ما على يدهم يَدُ",30,"د",1,0],["وَعبدُ اللَّهِ فِيمَ قَتلتموهُ","وَسُقْتُمْ صاحِبَيْهِ بشرِّ حالِ",31,"ل",1,0],["وعَبَّ عُبابُ الموكبِ الفخم حولَهُ","وزَفّ كما زَف الصّباحُ المُلَمَّع",32,"ع",1,0],["وعَبْدُ غيْرِكَ مضْرُورٌ بخِدْمَتِهِ","كالغِمْدِ يُبْليه صَوْنُ الصّارِمِ الذّكَرِ",33,"ر",1,0],["وَعَبلَةٍ كَمَهاةِ الجَوِّ ناعِمَةٍ","كَأَنَّ ريقَتَها شيبَت بِسَلسالِ",34,"ل",1,0],["وعَبَرْنا رحابها","فأشارتْ لمن عَبَرْ",35,"ر",1,0],["وعبدت ربي ما استطع","ت ومن بريته بريت",36,"ت",1,0],["وَعُبَابٌ مَا مَاجَ إِلاَّ بِإِبْراقِ","أَسَارِيرِهِ مِنَ السَّرَّاءِ",37,"ا",2,0],["وَعِبْئُهُ فِي هَوَى حِمَاهُ","لَمْ يَلْقَهُ فِي الْحُمَاةِ لاَقِ",38,"ق",1,0],["وعبرَ دِجلة: شعبٌ قامَ قَوْمتِهُ ال","كُبْرى، وثار على الطُّغْيان ثائره",39,"ر",2,0],["وعبرة تسفحها أرملة","كالخلق السحق اصارها الضوى",40,"ا",1,0],["وعبرنا ليلا كألسنة الحيّات","والدرب عاصف بالتلاحي",41,"ح",2,0],["وَعَبدُكَ أحْظَتْهُ لَدَيْكَ نَصِيحَةٌ،","وأرْضَاكَ منهُ مَشهَدٌ وَمَغيبُ",42,"ب",1,0],["وعبادة لا الحشر أملاها عليّ ولا الحساب","وإذا سألت عن الذنوب فإن ّ أدمعي الجواب",43,"ب",1,0],["وعبادة الحركات والسكنات في","حكم القلوب وها هنا الشأن انحصر",44,"ر",1,0],["وَعَبَأتُ للباغي عَلَيْكَ هِجَاءَ","وَنَفَضْتُ إلاّ مِنْ هَوَاكَ خَوَاطرِي",45,"ي",1,0],["وعبد القادر الجيلي شيخ ال","شيوخ العارف الاسد الشهير",46,"ر",1,0],["وَعَبّاسٌ يُدِبُّ لِيَ المَنايا","وَما أَذنَبتُ إِلّا ذَنبَ صُحرِ",47,"ر",1,0],["وعبرةً وعظاتٍ ثم منفعةً","للسائلين وأفكاراً لمعتبِرِ",48,"ر",1,0],["وَعَبدُ يَغوثَ تَحجُلُ الطَيرُ حَولَهُ","وَعَزَّ المُصابُ جَثوَ قَبرٍ عَلى قَبرِ",49,"ر",1,0],["وَعَبساً قَتَلناهُم بِحُرِّ بِلادِهِم","بِمَقتَلِ عَبدِ اللَهِ يَومَ الذَنائِبِ",50,"ب",1,0],["وعبارة تشفى الغليل ومنطق","بمجامع المعنى يحيط نطاقا",51,"ق",2,0],["وعبد قِنٍّ لك لم يلتمس","من رقِّهِ راحةَ إعتاقِ",52,"ق",1,0],["وعبدك إن يشفيه مولاه في غد","سيأكل أكل الفيل فاهنأ بها بشرى",53,"ر",2,0],["وعبدك الدهر فلا تنسَ له","صنيعة فانه قد نصحا",54,"ح",2,0],["وعبدك ابني قَد ضاقت مذاهبه","منهم وقد عارضوه بعد ما وثقا",55,"ق",2,0],["وعبدُك الآنَ طغى ماؤُهُ","في الصُّلب فاحملْهُ على جارِيَهْ",56,"ه",1,0],["وعبّاساً أخا رعلٍ قَطَعنا","بِأَبيَضَ لَهذَمٍ مِنهُ الوَتِينَا",57,"ن",2,0],["وَعِبارةُ التاريخِ تَنطقُ أَنَّهُ","بِالبِرِّ قَد نالَ الكَرامةَ يُوسُفُ",58,"ف",1,0],["وَعِبارةُ التأريخِ أَمْلَتْ فَوقَهُ","نالَ السَليمُ سَلامةَ الأَبرارِ",59,"ر",1,0],["وعبدك الأحنف يا سيّدي","ملقى بسيف الفقر مقتول",60,"ل",1,0],["وَعَبيرُ النِسرين يَنهَلُّ حُبّاً","في العَبيرِ المَنشورِ مِن نَجوانا",61,"ن",2,0],["وَعَبَدناكَ حَيثُما أَنتَ أَهلٌ","وَحَمَدناكَ مَع تَزايُدِ شُكرِك",62,"ك",1,0],["وعبرتُه بين الجفونِ عزيزةٌ","يضنُّ بها إلا على موقفٍ سام",63,"م",1,0],["وعبدُ رحمانِها يَلهو بزخرفِها","والفنُّ يعشقُ تشييداً وتزيينا",64,"ن",2,0],["وعبيدُهم متحكِّمونَ بِدَولةٍ","مع أهلِها ذهبَ الندى والآد",65,"د",1,0],["وَعَبدُكَ قَد طالَ تَثقيلُهُ","عَلَيكَ وَما يَبتَغي مِنكَ عتقا",66,"ق",2,0],["وَعبرة عَينٍ لا تجفُّ جفونُها","إِذا هتفت أَيكيَّةٌ أَقبلت تَجري",67,"ر",2,0],["وَعَبَّرنَ عَن فَرقيسَياءَ لِعَرعَرٍ","وَفُرضَةِ نُعمٍ ساءَ ذاكَ مَعَبَّرا",68,"ر",2,0],["وَعَبَدوا الناسَ حَتّى أَصبَحوا ذُلَلاً","لِأَمرِهِم بَينَ مَغلوبٍ وَمُمتَهِنِ",69,"ن",1,0],["وعبيد اللَه يتبعه","علوى المذكور في سمل",70,"ل",1,0],["وَعَبرتَ عَن دُنياكَ عبرةَ نازعٍ","عَنها إِلى وطنِ ال