ldiwan.net/poem38034.html","البسيط"],[527,"إذا لم تطق للخطوب اصطبارا","https://www.aldiwan.net/poem37389.html","المتقارب"],[536,"إني بعثت لسيدي بكتابي","https://www.aldiwan.net/poem48294.html","عموديه"],[556,"إني أنا لست أنا","https://www.aldiwan.net/poem33847.html","مجزوء الرجز"],[556,"لا تظلم الله بما لا يليق","https://www.aldiwan.net/poem34298.html","السريع"]],"verses":[["وَعِبءٌ عَلى عَينَيَّ رُؤيَةُ غَيرِهِ","وَلَو كانَ لي فيهِ مُنىً وَطِلابُ",0,"ب",1,0],["وَعَبدٌ قَد يَنامُ عَلى حَريرٍ","وَذو نَسَبٍ مَفارِشُهُ التُرابُ",1,"ب",1,0],["وَعَبَثتَ مِنهُ بِطُرَّةٍ","سَوداءَ لَمّا تَنصُلِ",2,"ل",1,0],["وَعَبَأتُم لِلفِسقِ ظُفرَ سِعايَةٍ","لَم يَعدُكُم أَن رُدَّ وَهُوَ مُقَلَّمُ",3,"م",1,0],["وَعَبساً صَبَحنا بِثَهلانِهِم","بِكَأسٍ وَلَيسَ بِكَأسِ المُدامِ",4,"م",1,0],["وَعَبَدْتُ أَحْرُفَهُ كَرَمْزٍ حَاجِبٍ","صَنَماً رَآهُ عَابِدُ الأَوْثَانِ",5,"ن",1,0],["وَعَبَسَ الأُفْقُ فَلا يُجْتَلَى","سِوَى نُجَيْمٍ رَاجِفٍ بَاسِمِ",6,"م",1,0],["وَعَبدَ يَغوثَ اِستَنزَلَتهُ رِماحُنا","بِبَطنِ كُلابٍ بَينَ غابٍ وَقَسطَلِ",7,"ل",1,0],["وَعَبدُ يَغوثٍ تَحجِلُ الطَيرُ حَولَهُ","قَدِ اِحتَزَّ عُرشَيهِ الحُسامُ المُذكَّرُ",8,"ر",1,0],["وَعَبسٌ وَهُم يَومَ الفَروقَينِ طَرَّقوا","بِأَسيافِهِم قُدموسَ رَأسِ صُلادِمِ",9,"م",1,0],["وَعَبسٌ بِالثَنيَّةِ يَومَ عَمروٍ","سَقَوهُ ذَواعِفَ الأَسَلِ النِهالِ",10,"ل",1,0],["وَعَبدُ القَيسِ قَد رَجَعوا خَزايا","وَأَهلُ عُمانَ قَد لاقوا غَراما",11,"م",2,0],["وَعَبدُ يَغوثٍ تَحجُلُ الطَيرُ حَولَهُ","وَقَد ثَلَّ عَرشيهِ الحُسامُ المُذَكَّرُ",12,"ر",1,1],["وعبد الرحيم جِماعُ الأمور","إليه انتهى اللَقَمُ المُعْمَلُ",13,"ل",1,1],["وَعَبدُ يَغُوثَ قَد لاَقى نِزَاراً","غَداةَ التَّيم غَيرَ مهللِينَا",14,"ن",2,0],["وعَبرةٌ للغيثِ مسفوحةٌ","إذا سقاها الأرضَ لم تُخْصِبِ",15,"ب",1,0],["وعبدُك العبدُ لا يُخلّفه","عن حظّه غيرَ ما نثاهُ لكا",16,"ك",2,0],["وعبَّستِ الحسانُ إلى مَشيبي","فما لثُغورها برقٌ يُشامُ",17,"م",1,0],["وَعَبدُ القَيسِ مُصفَرٌّ لِحاها","كَأَنَّ فُساءَها قِطَعُ الضَبابِ",18,"ب",1,0],["وَعِبادَةً لِلحَقِّ أَينَ وَجَدتُهُ","وَالحُسنِ في الأَحياءِ وَالأَشياءِ",19,"ا",2,0],["وَعَبَروا غَفلَتَها","إِلى الظُهورِ قَنطَرَه",20,"ر",2,0],["وَعَبدُكَ أَحظَتهُ إِلَيكَ نَصيحَةٌ","وَأَرضاكَ مِنهُ مَشهَدٌ وَمَغيبُ",21,"ب",1,0],["وَعُبَيداً وَمُسهِراً وَجُدَيّاً","وَتَدولاً وَبُحتُراً وَعَتودا",22,"د",2,0],["وعَبرةٌ في احمرارِ الخدِّ حائرةٌ","كأنما مَرَحُ الصَّهباءِ جَارِيها",23,"ي",3,0],["وَعَبيدٍ خُوِّلوا ساداتِهِم","فَاِستَقَرَّ المُلكُ فيهِم وَرَسَب",24,"ب",1,0],["وَعَبَروا الدُنيا إِلى غَيرِها","فَإِنَّما الدُنيا لَهُم مَعبَرُ",25,"ر",1,0],["وَعِبْتِ لَبوسي إذ غدا دونَ هِمّتي","وكم شَمْلَةٍ فيها كريمُ الشّمائلِ",26,"ل",1,0],["وعبِيدُكَ الغلمانُ إن نادَيْتَهُم","نَهَضُوا مُوَاثَبَةَ الأسود وثاروا",27,"ر",3,0],["وَعِبادَةُ الأَهواءِ في تَطويحِها","بِالدينِ فَوقَ عِبادَةِ الأَصنامِ",28,"م",1,0],["وَعَبدَةُ بَيضاءُ المَحاجِرِ طَفلَةٌ","مُنَعَّمَةٌ تُصبى الحَليمَ وَلا تَصبو",29,"ب",2,0],["وعبادةُ الأصنامِ قام دُعاتُها","مِلءَ الممالكِ ما على يدهم يَدُ",30,"د",1,0],["وَعبدُ اللَّهِ فِيمَ قَتلتموهُ","وَسُقْتُمْ صاحِبَيْهِ بشرِّ حالِ",31,"ل",1,0],["وعَبَّ عُبابُ الموكبِ الفخم حولَهُ","وزَفّ كما زَف الصّباحُ المُلَمَّع",32,"ع",1,0],["وعَبْدُ غيْرِكَ مضْرُورٌ بخِدْمَتِهِ","كالغِمْدِ يُبْليه صَوْنُ الصّارِمِ الذّكَرِ",33,"ر",1,0],["وَعَبلَةٍ كَمَهاةِ الجَوِّ ناعِمَةٍ","كَأَنَّ ريقَتَها شيبَت بِسَلسالِ",34,"ل",1,0],["وعَبَرْنا رحابها","فأشارتْ لمن عَبَرْ",35,"ر",1,0],["وعبدت ربي ما استطع","ت ومن بريته بريت",36,"ت",1,0],["وَعُبَابٌ مَا مَاجَ إِلاَّ بِإِبْراقِ","أَسَارِيرِهِ مِنَ السَّرَّاءِ",37,"ا",2,0],["وَعِبْئُهُ فِي هَوَى حِمَاهُ","لَمْ يَلْقَهُ فِي الْحُمَاةِ لاَقِ",38,"ق",1,0],["وعبرَ دِجلة: شعبٌ قامَ قَوْمتِهُ ال","كُبْرى، وثار على الطُّغْيان ثائره",39,"ر",2,0],["وَعَبدُكَ أحْظَتْهُ لَدَيْكَ نَصِيحَةٌ،","وأرْضَاكَ منهُ مَشهَدٌ وَمَغيبُ",40,"ب",1,0],["وَعَبَأتُ للباغي عَلَيْكَ هِجَاءَ","وَنَفَضْتُ إلاّ مِنْ هَوَاكَ خَوَاطرِي",41,"ي",1,0],["وعبد القادر الجيلي شيخ ال","شيوخ العارف الاسد الشهير",42,"ر",1,0],["وَعَبّاسٌ يُدِبُّ لِيَ المَنايا","وَما أَذنَبتُ إِلّا ذَنبَ صُحرِ",43,"ر",1,0],["وعبرةً وعظاتٍ ثم منفعةً","للسائلين وأفكاراً لمعتبِرِ",44,"ر",1,0],["وَعَبدُ يَغوثَ تَحجُلُ الطَيرُ حَولَهُ","وَعَزَّ المُصابُ جَثوَ قَبرٍ عَلى قَبرِ",45,"ر",1,0],["وَعَبساً قَتَلناهُم بِحُرِّ بِلادِهِم","بِمَقتَلِ عَبدِ اللَهِ يَومَ الذَنائِبِ",46,"ب",1,0],["وعبارة تشفى الغليل ومنطق","بمجامع المعنى يحيط نطاقا",47,"ق",2,0],["وعبد قِنٍّ لك لم يلتمس","من رقِّهِ راحةَ إعتاقِ",48,"ق",1,0],["وعبدك إن يشفيه مولاه في غد","سيأكل أكل الفيل فاهنأ بها بشرى",49,"ر",2,0],["وعبدك الدهر فلا تنسَ له","صنيعة فانه قد نصحا",50,"ح",2,0],["وعبدك ابني قَد ضاقت مذاهبه","منهم وقد عارضوه بعد ما وثقا",51,"ق",2,0],["وعبدُك الآنَ طغى ماؤُهُ","في الصُّلب فاحملْهُ على جارِيَهْ",52,"ه",1,0],["وعبّاساً أخا رعلٍ قَطَعنا","بِأَبيَضَ لَهذَمٍ مِنهُ الوَتِينَا",53,"ن",2,0],["وَعِبارةُ التاريخِ تَنطقُ أَنَّهُ","بِالبِرِّ قَد نالَ الكَرامةَ يُوسُفُ",54,"ف",1,0],["وَعِبارةُ التأريخِ أَمْلَتْ فَوقَهُ","نالَ السَليمُ سَلامةَ الأَبرارِ",55,"ر",1,0],["وعبدك الأحنف يا سيّدي","ملقى بسيف الفقر مقتول",56,"ل",1,0],["وَعَبيرُ النِسرين يَنهَلُّ حُبّاً","في العَبيرِ المَنشورِ مِن نَجوانا",57,"ن",2,0],["وَعَبَدناكَ حَيثُما أَنتَ أَهلٌ","وَحَمَدناكَ مَع تَزايُدِ شُكرِك",58,"ك",1,0],["وعبرتُه بين الجفونِ عزيزةٌ","يضنُّ بها إلا على موقفٍ سام",59,"م",1,0],["وعبدُ رحمانِها يَلهو بزخرفِها","والفنُّ يعشقُ تشييداً وتزيينا",60,"ن",2,0],["وعبيدُهم متحكِّمونَ بِدَولةٍ","مع أهلِها ذهبَ الندى والآد",61,"د",1,0],["وَعَبدُكَ قَد طالَ تَثقيلُهُ","عَلَيكَ وَما يَبتَغي مِنكَ عتقا",62,"ق",2,0],["وَعبرة عَينٍ لا تجفُّ جفونُها","إِذا هتفت أَيكيَّةٌ أَقبلت تَجري",63,"ر",2,0],["وَعَبَّرنَ عَن فَرقيسَياءَ لِعَرعَرٍ","وَفُرضَةِ نُعمٍ ساءَ ذاكَ مَعَبَّرا",64,"ر",2,0],["وَعَبَدوا الناسَ حَتّى أَصبَحوا ذُلَلاً","لِأَمرِهِم بَينَ مَغلوبٍ وَمُمتَهِنِ",65,"ن",1,0],["وعبيد اللَه يتبعه","علوى المذكور في سمل",66,"ل",1,0],["وَعَبرتَ عَن دُنياكَ عبرةَ نازعٍ","عَنها إِلى وطنِ المقامةِ ينزعُ",67,"ع",1,0],["وَعِباد الرحمنِ قومٌ لديه","نَفَضوا الإختيار نفض الجرابِ",68,"ب",1,0],["وعبيداً يشدون شتّى لحونٍ","في حمى القصر سجّداً وقياما",69,"م",2,0],["وعبدتم أنتم عبيد تراب","وبذلتم حياءكم قربانا",70,"ن",2,0],["وعبير روحك خالد","التطواف معبود النفاح",71,"ح",1,0],["وعبلة الحسناء ترنو إلى","خطيبها اللابس المحبس",72,"س",1,0],["وعبلد الطفلة يا عبلة ال","طفلة يا ريحانة الانفس",72,"س",1,0],["وَعَبدُها بِحُبِّهِ تَعَبُّدي","وَإِن قَلاهُ مَن عَنِ الحَقِّ اِنبَتَر",73,"ر",1,0],["وَعَبَرتُ مِن فَوقِ الصِراطِ مَسَلِّماً","لِما بَدا الرَجحانُ في ميزاني",74,"ي",1,0],["وعِبثين من هَمٍّ حَملْتُ وهِمّةٍ","كَذي ضاغطٍ يَطْوي الفلاةَ وناكت",75,"ت",1,0],["وعِبْءٌ على جَفْنِ عينِ الجَهولِ","لِقاءُ أخى العلم مهما رأى",76,"ا",1,0],["وعبسٌ فوقَها طيرُ المنايا","ومُعضِلةٌ تَحُفُّ بها جليله",77,"ل",2,0],["وَعَبَدنا الإِلهَ حقاً وكنَّا","للجهالاتِ نَعبُدُ الأَوثانا",78,"ن",2,0],["وَعبرة في أَنصاب عبرَتِهِ","لَو أَن صِبا بِذاكَ يَعتبر",79,"ر",1,0],["وَعبادةٌ لو قَسِّمَت بَينَ الوَرى","عادَ العِبادُ وَكلُّهُم عُبّاد",80,"د",1,0],["وَعِبادَةٍ ما نالَ عَبد مِثلَها","لِأَداءِ فرضٍ أَو أَداءِ تَنَفُّلِ",81,"ل",1,0],["وعبير النارنج أحلى وأندى","من غبار المدينة المتراكم",82,"م",1,0],["وعُبَّادُ عجل السامري على هدى","وهارون أخطى إذ أتى بملام",83,"م",1,0],["وعبادة الأوثان مكرمة","فيها يطيب القول والفعل",84,"ل",1,0],["وعُبَّادُ عجل السامري على هدى","ولائمهم في اللوم ليس على رشد",85,"د",1,0],["وعَبدُ كُلاَلٍ حَازَ كُلَّ عَظِيمَةٍ","سَمِعتُ بِهَا فِي حِميَرٍ وكَفِيلِهَا",86,"ه",2,1],["وعبد الواحد الموصوف فيهم","بطول الباع والصَّدر الرَّحيب",87,"ب",1,0],["وعَبَّ الصُّبحُ في كأْسِ الثُّرَيَّا","وكان برحَةِ القَمَرِ المنيرِ",88,"ر",1,0],["وعبيدُ مملكَةٍ وشِيعَةُ دَوْلَةٍ","قَدْ أَيْقَنُوا أَنَّ الحياةَ قِتالُ",89,"ل",1,0],["وعَبْرَةِ ثكلى مَا تقلِّبُ ناظِراً","إِلَى أُفُقٍ إِلّا يقولُ لَهَا سُحِّي",90,"ح",2,0],["وعبتِ وليس غيرُ الشيب شيئاً","أُذادُ له بعيبٍ أو أُكادُ",91,"د",1,0],["وعَبْرةٍ ريُّه وَحِليتُه","يُشرَبُ من مائها ويُختضَبُ",92,"ب",1,0],["وعَبَّ عُبابٌ هاشميٌّ فلم يكُنْ","له جبلٌ من مغرق الشرِّ يُعْصِم",93,"م",1,0],["وعبَّ عُبابٌ يُلحقُ القعْرَ بالذُّرى","ويقذفُ دُرّاً في مواطنَ جنْدَلِ",94,"ل",1,0],["وَعَبّا البَوارِدِ في جونَةٍ","أَجَنَّ مِنَ الخَوفِ أَن تُطبِقا",95,"ق",2,0],["وعُبَيْدٌ ضَلِلْتُ فاجْتَذَبَتْني","ودَعَتْني بالسَّيِّدِ المَهْدِيِّ",96,"ي",1,0],["وعبدُ بارِئهِ في ظلِّ رأفَتِه","فَظلُّهُ بِجناحِ العِزِّ مَمْدودُ",97,"د",1,0],["وَعِبْءُ الرّئاسَةِ إنْ كُنْتَ لاَ","تَنُوءُ بِهِ فاطَّرِحْهُ جِهارا",98,"ر",2,0],["وعُبيدَكُم يرجُو الصَّويرَة ثم لاَ","يَلقَى سَبيلا مِن فراغٍ وِطَابِ",99,"ب",1,0],["وعبدوه مثل قو","م يعبدون الوثنا",100,"ن",2,0],["وعبدوا الأصنام جهلاً وقد","خروا إليها سُجَّداً بالحقيق",101,"ق",1,0]]}