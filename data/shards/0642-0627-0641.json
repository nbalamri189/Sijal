{"poems":[[9,"من ديار بالهضب هضب القليب","https://www.aldiwan.net/poem21913.html","الخفيف"],[91,"أيتها النفس اقترب","https://www.aldiwan.net/poem44672.html","مجزوء الرجز"],[40,"قافية الميممِنْ كُلِّ بَذَّاءَ فِي البُرْدَيْنِ","https://www.poetsgate.com/ViewPoem.aspx?id=21225",""],[202,"ألف ألا انعم بالمحبة حالا","https://www.aldiwan.net/poem51903.html","الكامل"],[308,"إن كان يا مولاي لا بد أن","https://www.aldiwan.net/poem57643.html","السريع"],[398,"ألف أمير المؤمنين علي","https://www.aldiwan.net/poem53656.html","الكامل"],[487,"فيض بجمع الجمع صار حديثه","https://www.aldiwan.net/poem24480.html","عموديه"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140092",""],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117867","الخفيف"],[3464,"ألفٌ أمعاني من يذكرْ","https://www.poetsgate.com/ViewPoem.aspx?id=158742",""],[4797,"ذالليل كن نجومه شوي واشتات","https://www.poetsgate.com/ViewPoem.aspx?id=132228",""],[4829,"ملحمة الليث والمهاة وبنات آوى","https://www.poetsgate.com/ViewPoem.aspx?id=34252",""],[4829,"غاروا علي القوم","https://www.poetsgate.com/ViewPoem.aspx?id=34262",""],[4829,"الجابريّة","https://www.poetsgate.com/ViewPoem.aspx?id=35605",""],[4829,"ولاد المضا","https://www.poetsgate.com/ViewPoem.aspx?id=36743",""],[5092,"القدسُ صوتُ الحق","https://www.poetsgate.com/ViewPoem.aspx?id=176452",""],[5759,"سنظلُّ نبكي","https://www.poetsgate.com/ViewPoem.aspx?id=212934",""],[6008,"الصدر ضاق","https://www.poetsgate.com/ViewPoem.aspx?id=59160",""]],"verses":[["قافِلٍ جُرشُعٍ تَراهُ كَتَيسِ ال","رَبلِ لا مُقرِفٍ وَلا مَخشوبِ",0,"ب",1,0],["قافية ركبتها","فهي تسير بي الخبب",1,"ب",1,0],["قافية الميممِنْ كُلِّ بَذَّاءَ فِي البُرْدَيْنِ يَشْغَلُهَا","عنْ مهنة ِ الحيِّ ترحيلٌ وعلاّمُ",2,"م",1,1],["قاف قُدِ العلياء يا قطب النهى","واجعل لها كرم الخلال عقالا",3,"ل",2,0],["قافيةُ البيت اطرح لفظها","وقم خذ الكل بلا قافيه",4,"ه",1,0],["قافٌ قَفا طرقَ النَبِيِّ المُصطَفى","كافٌ كَريمُ المُنتَمى قرشي",5,"ي",1,0],["قاف وهاء ثم كاف سيننا","لا شيء في شيء منيع طلسم",6,"م",1,0],["قافية النظم البديع المؤتلف","في حدها أهل العروض تختلف",7,"ف",1,0],["قاف محيط بالأراضي كلها","قالوا زمردة شديد الخضرة",8,"ه",1,0],["قافياً في السلوك آثار من لف","عليهم من الرسول الكساء",9,"ا",2,0],["قافٌ قد حاز العز ومن","مثل البيك فهو الأفخر",10,"ر",1,0],["قافي لو يوصف لزينه حركات","قاموا بتقليده بنيات ذالجيل",11,"ل",1,0],["قاف نافذ مثل نبلن من خلالي","يوم قالوا باقي وترحل شويّة",12,"ي",2,0],["قاف(ن)وثيج(ن)ارج(ن)ناج حاسمه","هواتف(ن)منها تقفي جحارمه",13,"م",2,0],["قافي لاهو ذا لا ولاهو هذا","قافي لكم قاف ولي الصمصامي",14,"م",2,0],["قافي فداها لابغيته شيصب","وليا بغيته من حديثن عامي",14,"م",2,0],["قاف(ن)تليد(ن) من طروق الجنّي","المارد الوارد ( شُرَيْدَّ الدومي )",15,"م",2,0],["قافُ اللقاءِ وقافُ قدسيَ روضةٌ","يمضي لها الشُعَرَا بلا أجسادِ",16,"د",1,0],["قافيَّةً تَقفو على قافِيَّةٍ","شَجَنًا أجازَ ختامُها والمطلَعُ",17,"ع",1,0],["قاف ٍ بدعته ماتقرض قروضي","حيث البحر بالوُرد ما قيل قاضي",18,"ض",2,0]]}