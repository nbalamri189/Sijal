{"poems":[[75,"الهوى في طلوع تلك النجوم","https://www.aldiwan.net/poem11917.html","الخفيف"],[95,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[29,"حيوا أمامة واذكروا عهدا مضى","https://www.aldiwan.net/poem5655.html","الكامل"],[29,"حي الديار على سفي الأعاصير","https://www.aldiwan.net/poem5763.html","البسيط"],[29,"بان الخليط فعينه لا تهجع","https://www.aldiwan.net/poem5801.html","الكامل"],[29,"أواصل أنت سلمى بعد معتبة","https://www.aldiwan.net/poem6007.html","البسيط"],[23,"قومي الذين هم آووا نبيهم","https://www.aldiwan.net/poem21570.html","البسيط"],[74,"حاشاك يا عارض المكارم من","https://www.aldiwan.net/poem18574.html","المنسرح"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[53,"أحمد الله نية وثناء","https://www.aldiwan.net/poem7941.html","الخفيف"],[53,"ما علمنا من لؤلؤ ما ذكرتا","https://www.aldiwan.net/poem8703.html","الخفيف"],[53,"يا ابن حرب كسوتني طيلسانا","https://www.aldiwan.net/poem9434.html","الخفيف"],[93,"آه من الحب كله عبر","https://www.aldiwan.net/poem8830.html","عموديه"],[87,"يا عزيزاً لنا بمصر علمنا","https://www.aldiwan.net/poem8061.html","الخفيف"],[87,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[47,"لازال محتفل الغمام الباكر","https://www.aldiwan.net/poem63617.html","الكامل"],[63,"لا يعرف العدل وهو معتدل","https://www.aldiwan.net/poem51483.html","السريع"],[63,"أ أقحوانا أرته أم بردا","https://www.aldiwan.net/poem51719.html","المنسرح"],[63,"عوجا على ذاك الكثيب من كثب","https://www.aldiwan.net/poem51787.html","الرجز"],[107,"حيوا الهلال وحيوا أمة النيل","https://www.aldiwan.net/poem43087.html","البسيط"],[104,"ديننا حبك يا هذا الوطن","https://www.aldiwan.net/poem32909.html","الرمل"],[69,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[52,"هل من رسول مخبر","https://www.aldiwan.net/poem64796.html","مجزوء الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85446","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54516","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43788","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[147,"يطمع الناس في البقاء وتابى","https://www.aldiwan.net/poem11735.html","الخفيف"],[154,"يا أبا الفضل وابنه وأخاه","https://www.aldiwan.net/poem68472.html","الخفيف"],[170,"سرنا ومرآة الزمان بحالها","https://www.aldiwan.net/poem46877.html","الكامل"],[204,"سقنا رفيدة حتى احتل أولها","https://www.aldiwan.net/poem2061.html","البسيط"],[207,"ما بال عينك قد أزرى بها السهد","https://www.aldiwan.net/poem68168.html","البسيط"],[303,"لله وللمثل الأعلى","https://www.aldiwan.net/poem36299.html","عموديه"],[309,"قل لأحبابنا بسوح المقام","https://www.aldiwan.net/poem16829.html","الخفيف"],[371,"أهذه سير في المجد أم سور","https://www.aldiwan.net/poem17202.html","البسيط"],[398,"أنا من شيعة الرضا","https://www.aldiwan.net/poem53655.html","مجزوء الخفيف"],[409,"حبذا حبذا بديع نظامك","https://www.aldiwan.net/poem33411.html","الخفيف"],[422,"هل عرفت الديار من آل نعمى","https://www.aldiwan.net/poem54169.html","الخفيف"],[463,"يا دار لهوي بالنجيل من قطن","https://www.aldiwan.net/poem55854.html","الرجز"],[463,"مطل الدين ولو شاء قضى","https://www.aldiwan.net/poem56147.html","الرمل"],[505,"سرنا على شطط النوى بجمالكم","https://www.aldiwan.net/poem37739.html","الكامل"],[505,"من تملى بكلامي","https://www.aldiwan.net/poem37770.html","مجزوء الرمل"],[505,"نحن شموس الحضرة المشعشعه","https://www.aldiwan.net/poem37973.html","الرجز"],[558,"تدعي الشوق إن نأت","https://www.aldiwan.net/poem68341.html","مجزوء الخفيف"],[566,"ورأس أعداء شديد أضمه","https://www.aldiwan.net/poem27859.html","الرجز"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83344","البسيط"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44582","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63854","السريع"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62500","الرمل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65054","الكامل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117787","البسيط"],[1438,"","https://poetry.dctabudhabi.ae/diwan/poem/28798","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77847","الكامل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105433","الرمل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96486","البسيط"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101700","الكامل"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103726","الخفيف"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105667","الكامل"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124672","السريع"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132794","الرجز"],[3177,"","https://poetry.dctabudhabi.ae/diwan/poem/113907","الرجز"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130047","الرمل"],[3281,"","https://poetry.dctabudhabi.ae/diwan/poem/114048","الكامل"],[3420,"","https://poetry.dctabudhabi.ae/diwan/poem/177881","الكامل"],[3491,"","https://poetry.dctabudhabi.ae/diwan/poem/31404","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48412","البسيط"],[3625,"","https://poetry.dctabudhabi.ae/diwan/poem/204075","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66328","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109887","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132162","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85275","البسيط"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131110",""],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2578","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111436","الرمل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77115","الرجز"],[3984,"","https://poetry.dctabudhabi.ae/diwan/poem/147201","الخفيف"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136927",""],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102729","البسيط"],[4487,"","https://poetry.dctabudhabi.ae/diwan/poem/18792","البسيط"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101940","الرمل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52164","الكامل"],[4692,"نحن الغريبان","https://www.poetsgate.com/ViewPoem.aspx?id=191369",""],[4767,"اذهب","https://www.poetsgate.com/ViewPoem.aspx?id=93594",""],[4830,"جراحات النوى","https://www.poetsgate.com/ViewPoem.aspx?id=194984",""],[4856,"قمر مسافر/لضياء عواد","https://www.poetsgate.com/ViewPoem.aspx?id=35880",""],[5050,"حدث أخي عن العجب","https://www.poetsgate.com/ViewPoem.aspx?id=38218",""],[5064,"بينَ .. بينَ","https://www.poetsgate.com/ViewPoem.aspx?id=199135",""],[5092,"حبلٌ من الهجران","https://www.poetsgate.com/ViewPoem.aspx?id=178350",""],[5111,"مَرَاكِبُ التِّحْنَانِ","https://www.poetsgate.com/ViewPoem.aspx?id=212287",""],[5136,"أضحك النصر مبسم العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=121488",""],[5160,"بنو الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=175256",""],[5183,"قلن","https://www.poetsgate.com/ViewPoem.aspx?id=186480",""],[5410,"ثورة أنين","https://www.poetsgate.com/ViewPoem.aspx?id=133057",""],[5419,"نقوش","https://www.poetsgate.com/ViewPoem.aspx?id=31470",""],[5458,"ملكة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=72162",""],[5523,"وقفات","https://www.poetsgate.com/ViewPoem.aspx?id=201355",""],[5584,"ولقد رجوت الله بعد رحيلها","https://www.poetsgate.com/ViewPoem.aspx?id=175149",""],[5616,"عناد","https://www.poetsgate.com/ViewPoem.aspx?id=203328",""],[5717,"يا حسرة من فؤاد محتدم","https://www.poetsgate.com/ViewPoem.aspx?id=170590",""],[5851,"هينمات من ظلال البدايات","https://www.poetsgate.com/ViewPoem.aspx?id=175277",""],[5968,"سميت بالله من ياني الخبر جدام","https://www.poetsgate.com/ViewPoem.aspx?id=175413",""]],"verses":[["سَرَّنا عَيشُنا الرَقيقُ الحَواشي","لَو يَدومُ السُرورُ لِلمُستَديمِ",0,"م",1,0],["سرنا كجيش غانم ظافر","أولنا في المجد كالآخر",1,"ر",1,0],["سِرنا إِلَيكَ مِنَ المَلا عيدِيَّةً","يَخبِطنَ في سُرُحِ النِعالِ عَلى الوَجى",2,"ا",1,0],["سِرنا مِنَ الدامِ وَالرَوحانِ وَالأُدَمى","تَنوي يَزيدَ يَزيدَ المَجدِ وَالخيرِ",3,"ر",1,0],["سِرنا عَلى ثِقَةٍ حَتّى نَزَلتُ بِكُم","مُستَبشِراً بِمَريعِ النَبتِ مَمطورِ",3,"ر",1,0],["سِرنا مِنَ الأُدَمى وَرَملِ مُخَفِّقٍ","نَرجو الحَيا وَجَنابَ غَيثٍ يُربَعُ",4,"ع",1,0],["سِرنا إِلَيكَ مَطايانا نُكَلِّفُها","سَيرَ النَهارِ وَما في اللَيلِ تَهويمُ",5,"م",1,0],["سِرنا إِلَيكَ نُصادِيها شَآمِيَةً","لا يُدفِئُ القَلبَ مِن صُرّادِها نيمُ",5,"م",1,0],["سِرنا وَساروا إِلى بَدرٍ لِحَينِهِمُ","لَو يَعلَمونَ يَقينَ العِلمَ ما ساروا",6,"ر",3,0],["سرَن لمغناك من مآربنا","نجائبٌ فاستوت على الجودي",7,"د",2,0],["سرنا على اسم الله والمناجح","نعومُ في الأقطارِ بالسوابح",8,"ح",1,0],["سرّني برَّني رعاني كفاني","جازَهُ السوءُ إنه ما أساءَ",9,"ا",2,0],["سُرَّنا بالسكوت يرحَمُكَ الل","هُ فإنَّا في نِعمةٍ ما سَكَتَّا",10,"ت",2,0],["سرَّني صوتُه وقلت لصحبي","لم يُصَوِّتْ إلاَّ وفيه طَبَاخُ",11,"خ",1,0],["سِرنا الهُوَيناءَ ما بِنا تَعَبٌ","وَقَد سَكَتنا وَما بِنا حَصَرُ",12,"ر",1,0],["سَرَّنا أَنَّكَ اِرتَقَيتَ وَتَرقى","فَكَأَنّا نَحوزُ ما أَنتَ حائِزُ",13,"ز",1,0],["سِرنَ أَمثالاً فَلَو لَم يُحيِهِ","سَيفُهُ أَحيَينَهُ في الغابِرين",14,"ن",1,0],["سِرنا وَأَنتِ مُقيمَةٌ وَلَرُبَّما","كانَ المُقيمُ عَلاقَةً لِلسائِرِ",15,"ر",1,0],["سِرْنا فلم يَثْنِ عَزمَنا مَلَلٌ","عَنِ السُّرى إذ حَدا بنا الأَمَلُ",16,"ل",1,0],["سِرْنا بآمالِنا إلى مَلِكٍ","يُسَرُّ بالآمِلِ الذي وفَدَا",17,"د",2,0],["سِرْنَ فقد عُوِّضَ قلبي طَرَباً","للحُزنِ من فَرْطِ السرورِ والطَّرَبْ",18,"ب",1,0],["سِرنا عَلى النَهجِ نَبغي خُطَّةً رَشَداً","تَمحو الظُنونَ وَتَنفي كُلَّ تَأويلِ",19,"ل",1,0],["سرُّنا فيهِ سواء وَالعَلن","فَاروِ يا تاريخ وَاشهد يا زَمَن",20,"ن",1,0],["سِرْنَ مِنْ حُسْنِهِنَّ في الشَّرْقِ والغَرْ","بِ فَكُنَّ الكَواكِبَ السَّيَّارَهْ",21,"ر",2,0],["سِرنا إِلى مِصرَ بِها","في جَحفَلٍ ذي لَجَبِ",22,"ب",1,0],["سرني مطلع النجوم فَلَمّا","أَفلت عَن عيني بكيت الأفولا",23,"ل",2,0],["سِرْنَا بِجَانِبِ مَنْزِلٍ","مُتَطَامِنٍ وَاهِي الْبِنَاءْ",24,"ا",2,0],["سَرَّني لمّا اِندَمى لَو","حُمِدَت عُقبى رُعافِه",25,"ه",1,1],["سِرْنا معا فُبخارُ النار يدفَعُها","إلى اللقاء ونارُ الشوقِ تُزجينا",26,"ن",2,0],["سَرَّني حاضِراً وَأَدنى وَأَغنى","فَعَدِمتُ السُرورَ لَمّا غابا",27,"ب",2,0],["سرّني القرب منك والدهر دأباً","مازج طيب وصله بنواه",28,"ا",2,0],["سِرنا ومرآةُ الزَّمانِ بحالها","فالآنَ قد مُحقت وصرت مِنْجَلا",29,"ل",2,1],["سِرنا إليهم وفينا كارهون لنا","وقد يصادَفُ في المكروهةِ الرَّشَدُ",30,"د",1,0],["سِرنا إِلَيهِم بِجَيشٍ في جَوانِبِهِ","قَوانِسُ البيضِ وَالمَحبوكَةُ السُرَدُ",31,"د",1,0],["سرْنا في خطتِنا المثلى","بالعلمِ وَبالخلق الحسن",32,"ن",1,0],["سر نا غير الندى مهاجراً لل","أجداد والآباء والأعمام",33,"م",1,0],["سِرنا وَسارَ شُجاعٌ وَهوَ يَقدُمُنا","وَعَزمُنا آمِرٌ وَالدَهرُ مُؤتَمِرُ",34,"ر",1,0],["سِرنَ شرقاً وَمَغرِباً","حَولَها أَلفُ مِحبَره",35,"ر",2,0],["سرني ما به بعثت وقبلت","كتاباً من قبل فض ختامك",36,"ك",1,0],["سرَّني في الأشراف نجل عليّ","وهو عبد الرحمن فضلاً وفهما",37,"م",2,0],["سِرْنا وعهدي بكِ مغنَى غِبطةٍ","أمسِ وعدنا اليومَ في مغنَى حَزَنْ",38,"ن",1,0],["سرّني يومَ مِنىً معترضاً","ملء عيني وشجاني مُعرِضا",39,"ض",2,0],["سِرْنا على شَطَطِ النَّوى بِجِمالِكُمْ","ولنا قُلوبٌ تَحتَ ظِلِّ نِعالِكُمْ",40,"م",1,1],["سِرُّ نَظْمي للمَعالي","بأكُفِّ الذَّوقِ يُومِي",41,"م",2,0],["سِرُّ نِكاتِ الطَّمْسِ في بحرِ العَما","موجَتُهُ الهائجةُ المُندَلِعَهْ",42,"ع",2,0],["سَرَّني لَو صَبَرتُ عَن","ها فَتُجزى بِما جَنَت",43,"ت",1,0],["سِرنا إِلَيهِ أَو أَتانا أَعظَمُه","بِلَجِبٍ يَنفي الأُسودَ هَزَمُه",44,"م",2,0],["سَر نَحوَ رَبِّكَ مُبَكِّياً بِكُلِّ دَمٍ","قانٍ عَلى صَفحَةِ الخَدَّينِ مَصبوبِ",45,"ب",1,0],["سِرّ نَباتٍ حُسنُهُ إِعلانُه","إِذا سِواهُ زانَهُ كِتمانُهُ",46,"ه",1,0],["سرْ ناشداً يا أيّها السائرُ","ما حار مَنْ مَقْصِدُه الحائرُ",47,"ر",1,1],["سرَّني حيناً وحينا","طلعت منه بوادرْ",48,"ر",1,0],["سِرْنا نَشُقُّ إِليكَ أَجوازَ الفَلا","ونسوقُ نَحْوكَ كُلَّ حَوْفٍ يَعْمَلِ",49,"ل",1,0],["سِرنا عن الحيِّ والأشواقُ تجذبُنا","إليه والوجدُ يطوينا وينشرنا",50,"ن",2,0],["سِرنا بِأَرعَنَ جَرَّارٍ كَلاكِلُهُ","تَخالُ أَنَّ عَلَيهِ البَرقَ يَشتَعِلُ",5