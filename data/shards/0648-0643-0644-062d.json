spx?id=207561",""],[5323,"حجزٌ مؤكد ..!","https://www.poetsgate.com/ViewPoem.aspx?id=207798",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[5369,"ستشرق شمس","https://www.poetsgate.com/ViewPoem.aspx?id=177450",""],[5431,"يشاء لمن يرضى حبيبا لكشفه","https://www.poetsgate.com/ViewPoem.aspx?id=197599",""],[5459,"أخو الذل","https://www.poetsgate.com/ViewPoem.aspx?id=191780",""],[5493,"شَفْشاوُن سليلة الأندلس","https://www.poetsgate.com/ViewPoem.aspx?id=200238",""],[5587,"جراح قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=196786",""],[5751,"كذبةُ سيف","https://www.poetsgate.com/ViewPoem.aspx?id=214773",""],[6300,"نقش قديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82860&r=&rc=31",""]],"verses":[["وَكُلُّ حَشىً عَليكَ كَأَنَّ فيهِ","سِنانَ الرُمحِ أَو طَرَفَ الحُسامِ",0,"م",1,0],["وكلُّ حيٍّ فالموْتُ غايَتُهُ","وكلُّ نفْعٍ يُدْني الى ضرَرِ",1,"ر",1,0],["وَكُلُّ حَثيثِ الوَدقِ مُنبَعِقِ العُرى","مَتى تُزجِهِ الريحُ اللَواقِحُ يَسجُمِ",2,"م",1,0],["وكلّ حيّ حسن الوسامه","كأنَّه في أفقهِ غمامه",3,"ه",1,0],["وكلَّحَ الدهرُ من نابيْهِ عنْ عَصَلٍ","فيه المنايا ومن شِدْقيْهِ عن هَرَتِ",4,"ت",1,0],["وَكُلُّ حَضارَةٍ في الأَرضِ طالَتْ","لَها مِن سَرحِكِ العُلوِيِّ عِرقُ",5,"ق",1,0],["وَكُلُّ حينٍ يَخونُ قَوماً","أَيُّ الأَحايِينِ لا يَخونُ",6,"ن",1,0],["وَكُلَّ حَرْبٍ أَتَاها للوَرَى أَنَسَاً","وَاْسْتَعْرَضَ الجُنْدَ قَبْلَ الصَّفِّ وَالعُدَدَا",7,"د",2,0],["وَكُلُّ حِميمٍ أَو أَخٍ ذي قَرابَةٍ","لَكَ اليَومَ حَتّى آخِرِ الدَهرِ لائِمُ",8,"م",1,0],["وَكُلُّ حُسنٍ فَمِن عَينَيكَ أَوَّلُهُ","مُذ خَطَّ هاروتُ في عَينَيكَ عَسكَرَهُ",9,"ر",2,0],["وَكُلُّ حَياةٍ إِلى مُنتَهى","أَجَل وَلِكُلِّ حِمامٍ أَجَل",10,"ل",1,0],["وَكُلُّ حَياةٍ تَثلِمُ العرضَ سُبّةٌ","وَلا كَحياةٍ جَلَّلتها المَآثمُ",11,"م",1,0],["وَكُلُّ حَسُودٍ ما عَدَتْهُ مَلامَةٌ","وَكُلُّ لَئِيمٍ ما عَلَيْهِ مُعَوَّلُ",12,"ل",1,0],["وَكُلُّ حِبٍّ سَيَستَشفي بِحِبَّتِهِ","ساقَت إِلى الغَيِّ أَو ساقَت إِلى الرَشَدِ",13,"د",1,0],["وَكُلَّ حينٍ حَوبٌ وَمَعصِيَةٌ","زادَتها في الذُنوبِ حَوباءُ",14,"ب",3,0],["وَكُلُّ حَيٍّ إِذا كانَت لَهُ أُذُنٌ","لَم تُخلِهِ مِن وِشاياتٍ وَتَخبيبِ",15,"ب",1,0],["وَكُلُّ حَيٍّ فَوقَها ظالِمٌ","وَما بِها أَظلَمُ مِن ناسِها",16,"س",3,0],["وكل حكومة بالسيف تقضي","فإن أَمامها يوماً عَصيبا",17,"ب",2,0],["وكل حيٍّ وادعٌ أو قرير","ما اختلف الشأن ولا الحظ دار",18,"ر",1,0],["وكل حسن كامن أو باد","أودعه الله اللسان البادي",19,"ي",1,0],["وكُلُّ حيٍّ من بني حَوّاء","فغيرُ مَعْصومٍ مِنَ الخَطاءِ",20,"ا",2,0],["وَكُلُّ حُسْنِ الْبَيَانِ بَادٍ","فِي صَوْغِ أَلْفَاظِهِ الرَّقَاقِ",21,"ق",1,0],["وَكُلُّ حَبيبٍ ما خَلا الوَلد الَّذي","تَقرُّ بِهِ العَينان في حُبِّهِ غشُّ",22,"ش",1,0],["وكلَّحَ الدهرُ من نابيْهِ عنْ عَضَلٍ","فيه المنايا ومن شِدْقيْهِ عن هَرَتِ",23,"ت",1,0],["وكل حزبك أصحاب المكارم يا","بحر المراحم بل يا خير منعوت",24,"ت",1,0],["وكل حِمَامٍ نازلٍ فهو مُفْظِعٌ","ولكنه في أشرفِ الخلق أَفْظَعُ",25,"ع",1,0],["وَكُلُّ حَديثٍ سارَ لَم يَكُ فيكُمُ","هَباءٌ أَثارَتهُ صَباً وَجَنائِبُ",26,"ب",1,0],["وكلّ حيّ أطال الله مدّته","لموته سببٌ يجتثّ أجل",27,"ل",1,0],["وَكلُّ حرف منهُ ذو الفقارِ","حازَ بهِ الإسلامُ كلّ النصرِ",28,"ر",1,0],["وكل حسناءَ بين الناس ان شقيت","فمن محاسنها لا من مساوينا",29,"ن",2,0],["وَكلُّ حمى لم يحمه آلُه وَإِنْ","يكنْ حَرَماً في عصرنا لا يحرم",30,"م",1,0],["وكل حلقه من تحت رأسٍ","وهذا الرأس يصبح تحت حلقه",31,"ه",1,0],["وكل حادثة ما لي بها قبل","وكل نائبة خدائة الظفر",32,"ر",1,0],["وَكُلُّ حَملِ شَعيرٍ عَدلٍ خَردَلَةً","وَالقَمحُ خَمسونَ أَردَباً بِدينارِ",33,"ر",1,0],["وَكُلُّ حالٍ بِلا اِستِثنا رَضيتَ بِها","مِنَ الحَبيبِ سِوى ذي اللَومِ يَشمَتُهُ",34,"ت",2,0],["وَكُلُّ حَظِّ أَبي الزَهراءِ خَصَّ بِهِ","فَالعِزُّ وَالفَوزُ في الدارَينِ قِسمَتُهُ",34,"ت",2,0],["وكل حسن بديع","لحسنها منتهاه",35,"ه",1,0],["وكل حينٍ عنده مأتم","لميت في قلبه يحتضر",36,"ر",1,0],["وَكُلّ حَديث ذَمٍّ لَليالي","حَديث خرافة يا أمَّ عَمرِو",37,"ر",2,0],["وكلُّ حَراكٍ كان بي نحْوَ لذّةٍ","تَبدَّلَ منّي عَهْدُه بسُكون",38,"ن",1,0],["وكلُّ حسودٍ ناكِصِ السَّعْيِ ناقِصٍ","مُعنّىً إذا أَملكْتَ في الرَّأْيِ أَمرَغا",39,"غ",2,0],["وكلُّ حَيٍّ فقد أولَيتَه نِعَماً","فهل لرأيِكَ إنعامٌ على شاس",40,"س",1,0],["وكلُّ حسودٍ فُوهُ خالٍ لبَغْيِه","من الشُّكْرِ لكنْ عينُه من دَمٍ شَكْرى",41,"ر",2,0],["وكل حشيش السُبت","تقشفاً للذهب",42,"ب",1,0],["وكل حلالا وجانب للشبه والحرام","ولا تشهي وخذ منه بقصد القوام",43,"م",1,0],["وكل حله بها","تارك لفرض الصلاة",44,"ه",1,0],["وكل حديثٍ كان أو هو كائنٌ","شمائلُه تُنبيكَ عنه وتشهدُ",45,"د",1,0],["وكل حي له عن يومه أمد","إن جاز لم يبق عن أيامه عدد",46,"د",1,0],["وكل حولي في شعر أجود به","كما أجود بأنفاسي لمن سمعوا",47,"ع",3,0],["وكلُّ حُلوبِها عندي سواءٌ","مشوباً أو صريفاً أو مَذيقا",48,"ق",2,0],["وكل حبل ولاء لا يناط إلى","ولائكم فهو عند الله منقضب",49,"ب",1,0],["وكُلُّ حُظوظِ بَني جِنْسِهِ","تَراها لَدَى حَظِّهِ تَصْغُرُ",50,"ر",1,0],["وَكلّ حَيٍّ منّا يجاذب حَبْ","ل العمرِ أيّامَه لوِ اِنجَذبا",51,"ب",2,0],["وكل حيٍّ جعلوا","بالوصف فيه وطنا",52,"ن",2,0],["وكل حب","له علائم",53,"م",1,0],["وكل حكم له مضاء","وكل ذات لها صفات",54,"ت",1,0],["وكلٌّ حينَ دَعْوتهِ يُلبِّي","إذا ما جاءَهُ ذاكَ الرَّسولُ",55,"ل",1,0],["وكلُّ حَلاوةٍ طَعْمٌ شَهيٌّ","وأكثَرُها وَجَدناهُ مُضِرَّا",56,"ر",2,0],["وكلُّ حيٍّ لهُ يومٌ يموتُ بهِ","فيفرُغُ العُمرُ مهما زادَ في المُدَدِ",57,"د",1,0],["وكلُّ حِصانٍ بالحديد ملثَّمٌ","عليه كميٌّ بالحديد مُقَلْنَسُ",58,"س",1,0],["وَكُلُّ حَكيمٍ كَالرَئيسِ الَّذي جَرى","وَخَلى أَرِسطو خَلفَهُ بِمَراحِلِ",59,"ل",1,0],["وكلُّ حديثٍ من أولئك فاتحٌ","له ألفَ بابٍ فاحتواها كما هيا",60,"ي",2,0],["وَكُلُّ حُسنٍ مِن جَميعِ الوَرى","مُختَصَرٌ مِن ذلِكَ الجامِعِ",61,"ع",1,0],["وَكُلُّ حَكيمٍ مِنهُما قالَ كلمَةً","بِها عَن فُنون الطبِّ لا يَتَحوَّلُ",62,"ل",1,0],["وَكلّ حزب بِالَّذي لَدَيهِ","راض بِما لَهُ وَما عَلَيه",63,"ه",1,0],["وَكُلُّ حَطابٍ بِغَير فاسِ","لا يَعرف الراحَةَ بَينَ الناس",64,"س",1,0],["وكل حلو التثني","مر الصدود غرير",65,"ر",1,0],["وكل حديث سماح يصح","إذا كان عن جوده مسندا",66,"د",2,0],["وكلُّ حصن وإن طالتْ سلامتهُ","يوماً سيدخلهُ النّكراءُ والحوبُ",67,"ب",1,1],["وكل حرف صلخدات لها عنق","مهما تسير وإرفال وتدميل",68,"ل",1,0],["وكل حبر لوذعي ألمعي","في ذلك التفصيل والحكم معي",69,"ي",1,0],["وكلُّ حبيبٍ لَنا واصِلٌ","وكُلُّ عَذولٍ لَنا عاذِرُ",70,"ر",1,0],["وكل حرف صالح له سوى","ست وعشر صد عنها من روى",71,"ر",3,0],["وكل حرف في مثالٍ قُدّما","يتبعه التالي بوضع القُدّما",72,"م",2,0],["وكل حشى عليك كأن فيه","لسان الرمح أو طرف الحسام",73,"م",1,0],["وَكُلُّ حَيٍّ وَإِن طالَت سَلامَتَهُم","يَوماً طَريقُهُم في الشَرِّ دُعبوبُ",74,"ب",1,0],["وكلُّ حبيبٍ ذاق فقدَ حبيبهِ","فلا بُدَّ أن يبكى لسالف دهرِهِ",75,"ر",2,0],["وَكُلُّ حَيٍّ لَهُ قَلبٌ يَعيشُ بِهِ","في الناسِ أَصبحَ يَرجونا وَيَخشانا",76,"ن",2,0],["وَكُلّ حُزن يبلى عَلى قِدم الد","دَهرِ وَحُزني يُجِدّه الكَمَد",77,"د",1,0],["وكلُّ حيٍّ عيشه منهلٌ","ما أقرب الإِصدارَ من ورده",78,"د",2,0],["وكل حسنٍ فجزءٌ من محاسنه","فاق الأنام وضوء الانجم الزهر",79,"ر",1,0],["وكلُّ حياةٍ فالمنِيَّةُ بَعْدَها","وللمرءِ آمالٌ تجور وتعدلُ",80,"ل",1,0],["وكل حلفٍ إذا استثنيت منهدمٌ","غير الطلاق وغير العتقِ للخول",81,"ل",1,0],["وكل حابس ذي دينٍ على عدمٍ","فآثمٌ أن يسل ميسورهُ قطبا",82,"ب",2,0],["وكل حصنٍ قائمٌ سمكه","وإن تراخى عمره يصرع",83,"ع",1,0],["وكل حين يدعو لم يزدكم","دوام دعائه الا فرارا",84,"ر",2,0],["وكل حزين حُزنه سوف ينعدم","وحزن فقيد الحب غير عديم",85,"م",1,0],["وكل حزين حزنه سوف ينقضي","وفاقد مضن يهوى يظل حزين",86,"ن",1,0],["وَكُلُّ حَبيبٍ فِى الدُّنا فَهُوَ أَنَّهُ","سِوَاها وَما طَهَّرتَها بالمَدَامِعِ",87,"ع",1,0],["وكلُّ حمىً يحميه لا زال مُورِقاً","وكلُّ حمىً يَعْصِيه لا زال في مَصْحِ",88,"ح",1,0],["وكل حرّ ضائع","في ارضه يا ولدي",89,"د",2,0],["وكلُّ حمدٍ ليس فيه أنا","يقبله الله بلا أرْشِ",90,"ش",1,0],["وكلُّ حدٍّ فمنه","فلستُ في ذاك وحدي",91,"د",2,0],["وكل حيّ لموته سبب","من لم يمت في غد فبعد غده",92,"د",2,0],["وكلُّ حاجٍ لفلانٍ او لهن","قاموا فَشدُّوها لما يشقى الأرن",93,"ن",1,0],["وكُلُّ حُزنٍ يَبلى على قِدَم الدَّ","هرِ وحُزني يُجِدُّهُ الأَبَدُ",94,"د",1,0],["وَكُلُّ حَريصٍ لَن يُجاوِزَ رِزقَهُ","وَكَم مِن مُوَفّى رِزقَهُ وَهوَ وادِعُ",95,"ع",1,0],["وكل حامضٍ من التفاحِ","مبرِّدٌ مُوَلِّدُ الرياح",96,"ح",1,0],["وكل حسن به فاعلم ولا عجب","ان كان ذاك