ِ أَوْعَدَهُ","لو عاش دهراً وأحقاباً وأحْيانَا",123,"ن",2,0],["وكل حرف نطقت به الشفه","حقيقة الحال به منكشفه",124,"ه",1,0],["وَكُلُّ حَكيمٍ كانَ أَو هُوَ كائِنٌ","فَمِن نورِيَ الوَضّاحِ في الخَلقِ لامِعُ",125,"ع",1,0],["وكل حَمام طار نحوكِ والهًا","وهيض جناحاه فذاكَ حِمامي",126,"م",2,0],["وكل حين لنا قومٌ أولو شرفٍ","بدورهم في سما الفضل لم تغب",127,"ب",1,0],["وكل ُّحروفِه عشْقٌ تدلَّى","وثمرتُه لقد زرِعتْ بذِكري",128,"ر",2,0],["وكلُّ حبيبة ٕحَضَنَتْ خَلِيلاَ","وأختّ ضِلْعُها حاو ٕظليلاَ",129,"ل",2,0],["وكل حلم أتاه المرء مقتدراً","أمضى وأفتك من سيف بمعارك",130,"ك",1,0],["وكلُّ حصانٍ له كبوةٌ","ولابدّ بالكبوة أن يجودْ",131,"د",1,0],["وكل حافر بئر كف محنته","من جهلة أوقعته في الذي حفرت",132,"ت",1,0],["وكلُّ حروفِ القوافي تمنّى","بأنْ يصطفيها لهُ قافيه !!",133,"ف",3,0],["وكلُّ حقيقةٍ فيها تنادي :","‏بأنْ لا شيءَ في الدنيا مخلّدْ",134,"د",1,0],["وكل حبرٍ فقيه عالمٍ ثقة","يدري الحقائق لا يبغي لها خلقا",135,"ق",2,0],["وكل حقير قائدٌ ومحنّكٌ","حكيمٌ، عظيمٌ، ثاقبُ الرأي عَنْبَس [2]",136,"س",1,0],["وكلّ حنايا القلب لله أمرها","وكلّ اضطرام الروح وقْفٌ لحرفه",137,"ف",2,0],["وَ كُلُّ حَيَاتِهِ رَهْنٌ لِهُدْبٍ","يَرِفُّ بِعَيْنِ لَيْلَى أَو سُعَادِ..",138,"د",1,0],["وكل حوراءَ مالت بالجِنانِ لها","أصلٌ تجذّر في الماضي وقال لهَا",139,"ه",2,0],["وكلُّ حزينٍ لي قريبُ محبَّةٍ","وَ كُلُّ غَرِيمٍ فِي الغِوَايَةِ يَحْقِدُ",140,"د",1,0],["وكلُّ حربٍ بنا تبدو مُباركةً","فمن دمانا لها وشيٌ من القُشُبِ",141,"ب",1,0],["وكل حُلْم جميل ٍريحُه عَطرٌ","في روحِنا فارق َالأنفاسَ وانتقلا",142,"ل",2,0]]}