abi.ae/diwan/poem/124273","الرجز"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35536","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125909","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86388","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54438","المنسرح"],[4296,"","https://poetry.dctabudhabi.ae/diwan/poem/103274","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133165","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83129","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58166","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33608","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72463","المنسرح"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72451","المنسرح"],[4593,"","https://poetry.dctabudhabi.ae/diwan/poem/130296","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120555","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139731",""],[4679,"جاد الكريم على السليم فقلبه","https://www.poetsgate.com/ViewPoem.aspx?id=142794",""],[4701,"ركعة الشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=176663",""],[4755,"مأساة سهيل اليماني كاملة","https://www.poetsgate.com/ViewPoem.aspx?id=211329",""],[4858,"صبراً أُخَيَّ","https://www.poetsgate.com/ViewPoem.aspx?id=29944",""],[4908,"سَمَرٌ شِتائيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=207420",""],[4935,"فارقت من أهوى بغير إرادتي","https://www.poetsgate.com/ViewPoem.aspx?id=129356",""],[4987,"يقصر الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=49590",""],[4988,"مدرسة دنياي","https://www.poetsgate.com/ViewPoem.aspx?id=214087",""],[5055,"المهر","https://www.poetsgate.com/ViewPoem.aspx?id=106076",""],[3591,"تحكي الإمام اليازجيّ بطلعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=149438",""],[5111,"كُفِّي جَحِيمَكِ","https://www.poetsgate.com/ViewPoem.aspx?id=212042",""],[5189,"بديعُ الله","https://www.poetsgate.com/ViewPoem.aspx?id=193551",""],[307,"طافَ الوباءُ بقاع الأرضِ","https://www.poetsgate.com/ViewPoem.aspx?id=215607",""],[5338,"إلى البرلمان العراقي العابث","https://www.poetsgate.com/ViewPoem.aspx?id=187953",""],[5397,"بشرا بوجهك ثغر الدهر مبتسم","https://www.poetsgate.com/ViewPoem.aspx?id=157924",""],[5542,"شعري وحبي فيكَ يلتقيانِ","https://www.poetsgate.com/ViewPoem.aspx?id=24756",""],[1547,"ميلوا إلى الدار من ذات اللمى ميلوا","https://www.poetsgate.com/ViewPoem.aspx?id=16822",""],[5628,"الشاعر وأنين الناي الحزين","https://www.poetsgate.com/ViewPoem.aspx?id=191333",""],[5694,"من العايدين","https://www.poetsgate.com/ViewPoem.aspx?id=132100",""],[6019,"يا أَيُّهَا ( الجَمرِيُّ ) أَشعَلَ أَضلُعِي","https://www.poetsgate.com/ViewPoem.aspx?id=137671",""],[6056,"نفحة نسانيس","https://www.poetsgate.com/ViewPoem.aspx?id=130322",""],[6106,"تحية للمستشارة : د . نهى الصادق الزيني","https://www.poetsgate.com/ViewPoem.aspx?id=6309",""],[6127,"لولاك عدنا في الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=188606",""]],"verses":[["هَذَا بِذَاكَ فَشَفِّعِ الثَّانِي الَّذِي","أَرْضَاكَ فِيمَا قَدْ جَنَاهُ الأَوَّلُ",0,"ل",1,0],["هَذَا بِإِجْمَاعٍ فَمَاذَا عَارَضَتْ","دَعْوَى دَعِيٍّ مِنْ سَنَى البُرْهَانِ",1,"ن",1,0],["هذا ببعض اللهو مشغولٌ وذا","كلّ المحامد والعلى من شغله",2,"ل",2,0],["هَذا بِلا مَجدٍ وَهَذا بِلا","ذُلٍّ فَلا باغٍ وَلا ثائِرُ",3,"ر",1,0],["هذا بألقاب يتي","ه وذا بأنساب يفاخر",4,"ر",1,0],["هَذا بَشيرُ الأَمسِ أَصبَحَ ناعِياً","كَالحُلمِ جاءَ بِضِدِّهِ التَأويلُ",5,"ل",1,0],["هذا به تغلب الأجساد وانفركت","ألوانها وهي مثل الماء تنسبكُ",6,"ك",1,0],["هذا بناءُ المتّقينَ لِربِّهم","لم يجعلوه على الهُدى مَوقوفا",7,"ف",2,0],["هذا بناؤُكَ مَالَهُ مِن هادمٍ","وكفَى بِربِّك حافظاً لِبنائِه",8,"ا",3,0],["هَذا بَشيرُ الخيرِ أيُّ طَلاقةٍ","تَحكِي طلاقَةَ وجههِ الغَضِّ النَّدِ",9,"د",1,0],["هذا بِناءُ القومِ مَالَ عَمودُه","فَوهَى وأصبحَ رُكنهُ مُتداعيا",10,"ي",2,0],["هَذا بَخيلٌ وَعِندَهُ جِدَةٌ","وَذا جَوادٌ بِغَيرِ ذاتِ يَدِ",11,"د",1,0],["هذا بياض الشيب واعجبي","من مغرب في زِي إشراق",12,"ق",1,0],["هذا بعبرته يجودُ وهذه","ما بين نقْسٍ في الربى وزفيفِ",13,"ف",1,0],["هذا بِهِ كَانَ رأيٌ في قَرَابَتِهِ","لَمْ يَحْظَ شيئاً مِنَ الدّنْيَا وَلَمْ يَخُنِ",14,"ن",1,0],["هذا بقيَّةُ معشرٍ قد خطَّ في","صُحُف الجهاد كتابَه بدمائه",15,"ا",3,0],["هذا بريدٌ. أم فتاتُ عواطفٍ","إني خُدعتُ. ولن أعودَ فأُخدعا.",16,"ع",2,0],["هذا بذاك فطبعُ الدهرِ مختلف","لا بد من راحةٍ فيه ومن تعب",17,"ب",1,0],["هذا بلا حيلة له نعم","فائضة والحيول محروم",18,"م",1,0],["هذا بن زمزم والمشاعر والصفا","وابن الحطيم وبطن ذاك الوادي",19,"د",2,0],["هذا به يبلغ الآمال قاصده","وصاحب البحر موقوف على الخطر",20,"ر",1,0],["هذا بماء يجود يوما","وذا بمال يجود بذلا",21,"ل",2,0],["هَذا بَهاءُ الدينِ قَد جاءَ مِن","بَعدِ أَبيهِ لَم يُشَفَّع بِثان",22,"ن",1,0],["هذا بسبعة أيام مقدمة","وبعدها سبعة خذها ولا تلم",23,"م",1,0],["هَذا بِمصنعةِ الحفصيّةِ اِنسَبكا","عَن إِذنِ مَن قطرَ إِفريقيّةٍ مَلَكا",24,"ك",2,1],["هَذا بِنصفيه وَالخالي ومهملهِ","مُؤرّخاً مُرغماً مِن شامخ أَنَفه",25,"ف",2,0],["هَذا بَخيل وَعِندهُ سَعَةٌ","وَذا جَواد بِغَيرِ ذاتِ يَدِ",26,"د",1,0],["هذا بَيانٌ لِرِجال الفَضلِ","وَكلِّ مَن أَصغى لِقَولٍ فَصل",27,"ل",1,0],["هذا بفضل اللّه ربي وحده","والفضل عند الموت منه باقي",28,"ق",2,0],["هذا بنظرته يقو","د جحافلاً قتلاً وأسرا",29,"ر",2,0],["هذا بن إسحق الذي جمع العلى","فغدا فريداً في الزمان الآخر",30,"ر",1,0],["هذا بتنسخ وذا","بشرائها بالمال نقدا",31,"د",2,0],["هذا بلا ريب لكل أريب","عين الجهاد لمعتد ومريب",32,"ب",1,1],["هذا بتاج أبيه عاصبٌ وعلى","هذا اختيالُ فتىً بالسيفِ خطَّارِ",33,"ر",1,0],["هذا بُروزٌ سابقٌ","بهِ عَطاءٌ سابقُ",34,"ق",1,1],["هذا بمسجدِه يزهُو ومِنبَرِه","وذاك أصنامُه تَزدَادُ تَشوِيها",35,"ي",3,0],["هذا بريدٌ بارِدُ","فيه المُوظف جَامدُ",36,"د",1,1],["هذا به طوراً يكون حضوره","فتراه قطباً قائماً مقصودا",37,"د",2,0],["هَذَا بِلا ذنبٍ أَتا","هُ جَزَيتَهُ عنه بِحَقِّهْ",38,"ق",2,0],["هذا بلا مأثمٍ أُحاذرُهُ","أيْ والصفا والحجون والخيف",39,"ف",1,0],["هَذا بُرود قلَّة الدِماء","وَقَد لَقيتُ سَبباً لِلداءِ",40,"ا",2,0],["هذا بُكاها والقَرينُ حاضرٌ","فكيف مَن قد فارَق القَرينا",41,"ن",2,0],["هذا بقايا موسى بنا وكذا","خير البقايا كانت بقاياه",42,"ا",2,0],["هذا بقية موسى والعصا بيد","بيضاء منه تعاطي لثمها الصيد",43,"د",1,0],["هذا بأمرٍ من الطاغوت يحبسه","وذلك يشتمه ظلماً بلا أدب",44,"ب",1,0],["هذا بناءٌ في الإخاء مشيدٌ","دام الإخاء ودام من هم شيّدوا",45,"د",3,0],["هذا بَديعُ البَديعِ قَد سَما عَدَداً","في عامِ يَومٍ ضحى من مفرد الحُرمِ",46,"م",1,0],["هذا بقيَّةُ جدِّه","هل فيكمُ تجدون كفوه",47,"و",2,0],["هَذا بُكائي عَليهِما وَهِيَ حاضِرَةٌ","لا فَرسَخٌ بَينَنا يَوماً وَلا ميلُ",48,"ل",1,0],["هذا بقيَّة مهجةٍ اتلفتها","في محبسٍ اتفقت فيهِ شبابي",49,"ي",1,0],["هذا بذاك وعدنا للوداد وإن","عادوا فصارمه ما زال صرّاما",50,"م",2,0],["هذا بدا قرآنه في كفّه","دوماً وذاك تأبط الإنجيلا",51,"ل",2,0],["هذا به يسمو وهذا لم يزل","متكأداً مما به مكدودا",52,"د",2,0],["هذا بعزمة زايد وجهاده","من شاد مجدا للبلاد ظليلا",53,"ل",2,0],["هَذا بِما عَلِقَت أَظفارُهُ بِهِم","وَظَنُّ أَكدَرَ غَيرُ الأَفَنِ وَالحَتنِ",54,"ن",1,0],["هذا بكائي بدا مديحا","وذا اشتياقي وذا النحيب",55,"ب",1,0],["هذا بحسب تفاوت الفقراء في أس","تحقاق سبقهم الى الاحسان",56,"ن",1,0],["هذا بذكرك حال عود يابس","أتلومني إن طرت من أشواقي",57,"ي",1,0],["هذا بلا بصرٍ هنا","ك وبي يخب الحاملان",58,"ن",1,0],["هذا بشير قد اتى فاسرني","فمتى اكون ممتعاً بوصالها",59,"ل",3,0],["هذا بذا قَد بَطَشا","وَذا لذا قَد خَرمَشا",60,"ش",2,0],["هذابه نصّ القران مصرّحا","خذ ما تريد هداية وضلالا",61,"ل",2,0],["هذا بدا فما الذي سدتُم بهِ","وفِقتمُ عن كلّ ذي مطلَبِ",62,"ب",1,0],["هذا بها يرقى وتلك نجومه","ترقى وذا يهوى وتلك رجوم",63,"م",1,0],["هذا بعيد من القياس وما","اعزه في الدنو والبعد",64,"د",1,0],["هذا بقة من كل الأمور له","والخلق ثم إِذا ما خاف تهضيض",65,"ض",1,0],["هذا بيوم القضا مولى أولى الغرف","هذا الذي حين جانا بالرسالة في",66,"ي",1,0],["هذا بقية مال أمسكته يدي","هذا ثمالة عيشٍ ظل في كوبي",67,"ب",2,0],["هذا بها يحظى فيأكل لقمة","ويعيدها لرفيقه إنعاما",68,"م",2,0],["هَذا بَشير المَعالي جاء مُبتهِجاً","فاسمع لِما قالَهُ يا صاح وَابتهج",69,"ج",1,0],["هذا بباناتها ينال هوى","وذا ثوابا إذا سعى ودعا",70,"ع",2,0],["هذا به ابتدأ الرقاد","وذا لمرقده ابتدر",71,"ر",1,0],["هَذا بِها يَشقى وَذا","فيها يَبيت منعّما",72,"م",2,0],["هذا بها يَبكي قواهُ","وَتلك تندب بختها",73,"ت",3,0],["هذا بكفِّ مليكٍ بَأسُهُ قَدَرٌ","وذا بكفِّ وزيرٍ رأيُه ضَرَمُ",74,"م",1,0],["هَذَا بِلاَ كلفَة مِنِّي وَلاَ حَرَس","وَلاَ عَديدٍ وَلاَ إنفاق مُكتَسَبِ",75,"ب",1,0],["هذا به صدقت مقالة شاعرٍ","هيهات إن يأتي الزمان بمثله",76,"ل",2,0],["هذا بوصفك فكري لم يصب هدفا","وذا لساني يبدي العي والخرسا",77,"س",2,0],["هذا بشير الزمان","فانشر دفين الأماني",78,"ي",1,1],["هذا بناؤك فاهنأ أيها الباني","ما أوطد الأس من دينٍ وإيمانِ",79,"ن",1,1],["هذا بني مستجير عائذ","خاف الشقاء فرآكم عوذا",80,"ذ",2,0],["هَذا بِهِ أَولى وَما ضَرّه","تَقريب أَهل اللَهوِ في النّدره",81,"ر",2,0],["هذا براه بالحسام وذا","بمثقفٍ للموت منصلت",82,"ت",1,0],["هذا بما لاق مستعد","وذاك يرنو إلى الهلال",83,"ل",1,0],["هذا بمدحك آخذٌ","ويروح ذا بمزيد شكرك",84,"ك",1,0],["هذا بسلبِ الفؤادِ يظلمني","وهو بقتلِ الأَعداءِ يُنصفُها",85,"ف",3,0],["هذا باذنك أم برأيك أم رأى","هذا عليك العبد والبَوابُ",86,"ب",1,0],["هذا بما خالفوا من أمر خالقهم","فأمةٌ خالفت في دينها خسرت",87,"ت",1,0],["هَذا بِسابِقَةٍ يَمُنُّ وَإِنَّهُ","إِن يسد فَهو لِنَفسِهِ يُسدِيها",88,"ي",3,0],["هذا بعدلِ الله لكنْ بَعْدَها","بُشْرَاكم برغائِبٍ وأماني",89,"ن",2,0],["هَذا بِسُقمٍ وَذا بِدمعٍ","وهَكَذا يَفعلُ الحَزينُ",90,"ن",1,0],["هذا بديع الزمان قد نشرا","أم ذا حريري الوقت قد ظهرا",91,"ر",2,1],["هذا بساطور الشر يسلخها","وذا بسكين القهر يذبحها",92,"ح",3,0],["هذا بأن رسول الله جدهم","أوصى بحفظهم في السر والعلن",93,"ن",1,0],["هذا بلاغ للغوى يسومه","في العرض خسفا ان يكن لم يرجع",94,"ع",1,0],["هذا بناءٌ قد سما هامَ السما","وطال أعلاها علاه عظمَا",95,"م",2,1],["هذا بشيرٌ بالسعادة واردٌ","لأجل بيتٍ صادرٌ من صادرِ",96,"ر",1,0],["هذا بريد الله كل سحابةٍ","شهدت على صدرى صلاة الماء",97,"ا",2,0],["هذا بَيَانِي إِلَيكُم، صُغتُهُ جُمَلًا","ما لُحنَ لِلعَينِ إِلَّا فُحنَ أَلحانا",98,"ن",2,0],["هَذا بِلالٌ شَامِخٌ بِسُجودِهِ","وابْنُ الأَرَتِّ وَمُصْعَبٌ وَإِمَاءُ",99,"ا",2,0],["هذا بساطُ القلبِ يبدو مأمناً","للخائفين ولي فؤادٌ شَيِّقُ",100,"ق",1,0],["هذا بياتي ظاهر لألي النهي","وبديع قولي معرب عن فطنتي",101,"ي",1,0],["هذا بعض شعري وصف بعض مافيك","الشعر شعري والفعايل فعولك",102,"ك",1,0],["هذا بعض ما قلت في قاف واحساس","واهمال من يبغض وجودك علاجه",103,"ج",2,0],["هذا بعض ما أذكره","هيا تحرك لا سؤال",104,"ل",1,0],["هذا بفضلك يا حبيب ولم أصل","لولا التفاتك للوزير الفاضل",105,"ل",1,0],["هَذَا بِلالُ بِهِ تَسْمُو مَآذِنُنَا","عَبْرَ الزمانِ ِ،بصَوْتِ الْحَقِّ صَدَّاحُ",106,"ح",1,0],["هذا بديعُ الله جلَّ جلالهُ","شَهدتْ له الأقطارُ والأمصارُ",107,"ر",1,0],["هذا بلاءٌ لعلّ الناسَ من فزع","لله تخشعُ حتّى تنجلي الخطبُ",108,"ب",1,0],["هَذَا بِظِلِّ الطَّائِفِيَّةِ سَادِرًا","فِي غَدْرِهِ فَمُخِّخًا وَمُفَجِّرَا",109,"ر",2,0],["هذا بصفو لبان الوحي مرتضع","وشب وهو بحجر القدس منفطم",110,"م",1,0],["هذا بناءُ الخير أنتَ بَنَيتَه","وعلامةُ التوفيق في البنيانِ",111,"ن",1,0],["هذا بكائي عليها وهي حاضرة ٌ","لا فرسخٌ بيننا يوماُ ولا ميلُ",112,"ل",1,0],["هذا بأحضانِ أهليهِ يودّعها","وذاك يمضي غريبا ً في منافيها",113,"ي",3,0],["هذا بعض مافالضمير من العلوم","واللي بقا نعطيه رعيان الإبل",114,"ل",1,0],["هذا بُحَيرُكَ قَدْ تَشَظَّى مَوجُهُ","آهاتُ حُزنٍ ألهَبَتْ شُطآنَا",115,"ن",2,0],["هذا بياض الكف ، وإلاّ قراطيس","وإلاّ ، شعاع ٍ حاضنه ، في يدينه",116,"ن",2,1],["هذا بنان الحق يكتب أحرفاً","كوسام عدل قد أناط صدورا",117,"ر",2,0],["هذا به الدين استقام عماده","كيف استحلت غدره الجرذان",118,"ن",1,0]]}