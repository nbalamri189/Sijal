{"poems":[[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[95,"وارحمتا لي من صروف زماني","https://www.aldiwan.net/poem11180.html","الكامل"],[74,"ما مثل قلبي ساليا عن مثله","https://www.aldiwan.net/poem19480.html","الكامل"],[93,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[87,"لمن المساكن كالمقابر","https://www.aldiwan.net/poem7768.html","مجزوء الكامل"],[87,"انظر إلى الأقمار كيف تزول","https://www.aldiwan.net/poem62837.html","الكامل"],[64,"للجسم إن داخلته روحه فرع","https://www.aldiwan.net/poem52158.html","البسيط"],[107,"وضح السبيل فما لهن وقوفا","https://www.aldiwan.net/poem42082.html","الكامل"],[107,"نادى الشباب فهب من إغفائه","https://www.aldiwan.net/poem42094.html","الكامل"],[107,"بشراك أم حبيبة بمحمد","https://www.aldiwan.net/poem44057.html","الكامل"],[107,"أقبل نعيم هداك ربك ساريا","https://www.aldiwan.net/poem44192.html","الكامل"],[52,"الناس إثنان في زمانك ذا","https://www.aldiwan.net/poem63890.html","المنسرح"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125511","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39568","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67353","البسيط"],[108,"شيخ القضاة","https://www.poetsgate.com/ViewPoem.aspx?id=179683",""],[101,"بريدها التي لا يأتي","https://www.poetsgate.com/ViewPoem.aspx?id=16904",""],[189,"هل لي إلى الثغر من عود ومنقلب","https://www.aldiwan.net/poem14106.html","البسيط"],[190,"لا تحسدن امرأ على جدة","https://www.aldiwan.net/poem43287.html","المنسرح"],[214,"قسما بحفظ عهودكم وودادي","https://www.aldiwan.net/poem13298.html","الطويل"],[214,"يا ظبية البان يا غصن النقا النضر","https://www.aldiwan.net/poem13316.html","البسيط"],[214,"يا متهمي بالسلو مهلا","https://www.aldiwan.net/poem13319.html","مخلع البسيط"],[286,"ألاح أن لاح بريق يمان","https://www.aldiwan.net/poem32388.html","السريع"],[289,"حمام قربس أبدى من منافعه","https://www.aldiwan.net/poem39335.html","البسيط"],[309,"هذا بمصنعة الحفصية انسبكا","https://www.aldiwan.net/poem56439.html","البسيط"],[309,"در أيادي التهاني فتحت صدفه","https://www.aldiwan.net/poem56474.html","البسيط"],[342,"إني إذا ملكت قوت غد","https://www.aldiwan.net/poem68783.html","المنسرح"],[397,"حمدا لرب جل عن نديد","https://www.aldiwan.net/poem53683.html","الرجز"],[407,"الحمد كل الحمد للخلاق","https://www.aldiwan.net/poem33620.html","الكامل"],[407,"أحلى الهوى ما كان جهرا","https://www.aldiwan.net/poem33914.html","مجزوء الكامل"],[407,"عبر الصبا سحرا بكيرة حاجر","https://www.aldiwan.net/poem33917.html","الكامل"],[407,"شكرا لربي دائما","https://www.aldiwan.net/poem33982.html","مجزوء الكامل"],[407,"هذا بلا ريب لكل أريب","https://www.aldiwan.net/poem34119.html","الكامل"],[461,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[503,"هذا بروز سابق","https://www.aldiwan.net/poem37947.html","مجزوء الرجز"],[541,"حسب المليحة حسنها ويغنيها","https://www.aldiwan.net/poem47512.html","عموديه"],[541,"هذا بريد بارد","https://www.aldiwan.net/poem48243.html","عموديه"],[561,"هذا وهذا ثم هذا بعده","https://www.aldiwan.net/poem34608.html","الكامل"],[578,"أنا غرس بيتك إن أرد","https://www.aldiwan.net/poem2761.html","مجزوء الكامل"]],"verses":[["هَذَا بِذَاكَ فَشَفِّعِ الثَّانِي الَّذِي","أَرْضَاكَ فِيمَا قَدْ جَنَاهُ الأَوَّلُ",0,"ل",1,0],["هَذَا بِإِجْمَاعٍ فَمَاذَا عَارَضَتْ","دَعْوَى دَعِيٍّ مِنْ سَنَى البُرْهَانِ",1,"ن",1,0],["هذا ببعض اللهو مشغولٌ وذا","كلّ المحامد والعلى من شغله",2,"ل",2,0],["هَذا بِلا مَجدٍ وَهَذا بِلا","ذُلٍّ فَلا باغٍ وَلا ثائِرُ",3,"ر",1,0],["هذا بألقاب يتي","ه وذا بأنساب يفاخر",4,"ر",1,0],["هَذا بَشيرُ الأَمسِ أَصبَحَ ناعِياً","كَالحُلمِ جاءَ بِضِدِّهِ التَأويلُ",5,"ل",1,0],["هذا به تغلب الأجساد وانفركت","ألوانها وهي مثل الماء تنسبكُ",6,"ك",1,0],["هذا بناءُ المتّقينَ لِربِّهم","لم يجعلوه على الهُدى مَوقوفا",7,"ف",2,0],["هذا بناؤُكَ مَالَهُ مِن هادمٍ","وكفَى بِربِّك حافظاً لِبنائِه",8,"ا",3,0],["هَذا بَشيرُ الخيرِ أيُّ طَلاقةٍ","تَحكِي طلاقَةَ وجههِ الغَضِّ النَّدِ",9,"د",1,0],["هذا بِناءُ القومِ مَالَ عَمودُه","فَوهَى وأصبحَ رُكنهُ مُتداعيا",10,"ي",2,0],["هَذا بَخيلٌ وَعِندَهُ جِدَةٌ","وَذا جَوادٌ بِغَيرِ ذاتِ يَدِ",11,"د",1,0],["هذا بياض الشيب واعجبي","من مغرب في زِي إشراق",12,"ق",1,0],["هذا بعبرته يجودُ وهذه","ما بين نقْسٍ في الربى وزفيفِ",13,"ف",1,0],["هذا بِهِ كَانَ رأيٌ في قَرَابَتِهِ","لَمْ يَحْظَ شيئاً مِنَ الدّنْيَا وَلَمْ يَخُنِ",14,"ن",1,0],["هذا بقيَّةُ معشرٍ قد خطَّ في","صُحُف الجهاد كتابَه بدمائه",15,"ا",3,0],["هذا بريدٌ. أم فتاتُ عواطفٍ","إني خُدعتُ. ولن أعودَ فأُخدعا.",16,"ع",2,0],["هذا بذاك فطبعُ الدهرِ مختلف","لا بد من راحةٍ فيه ومن تعب",17,"ب",1,0],["هذا بلا حيلة له نعم","فائضة والحيول محروم",18,"م",1,0],["هذا بن زمزم والمشاعر والصفا","وابن الحطيم وبطن ذاك الوادي",19,"د",2,0],["هذا به يبلغ الآمال قاصده","وصاحب البحر موقوف على الخطر",20,"ر",1,0],["هذا بماء يجود يوما","وذا بمال يجود بذلا",21,"ل",2,0],["هَذا بَهاءُ الدينِ قَد جاءَ مِن","بَعدِ أَبيهِ لَم يُشَفَّع بِثان",22,"ن",1,0],["هذا بسبعة أيام مقدمة","وبعدها سبعة خذها ولا تلم",23,"م",1,0],["هَذا بِمصنعةِ الحفصيّةِ اِنسَبكا","عَن إِذنِ مَن قطرَ إِفريقيّةٍ مَلَكا",24,"ك",2,1],["هَذا بِنصفيه وَالخالي ومهملهِ","مُؤرّخاً مُرغماً مِن شامخ أَنَفه",25,"ف",2,0],["هَذا بَخيل وَعِندهُ سَعَةٌ","وَذا جَواد بِغَيرِ ذاتِ يَدِ",26,"د",1,0],["هذا بَيانٌ لِرِجال الفَضلِ","وَكلِّ مَن أَصغى لِقَولٍ فَصل",27,"ل",1,0],["هذا بفضل اللّه ربي وحده","والفضل عند الموت منه باقي",28,"ق",2,0],["هذا بنظرته يقو","د جحافلاً قتلاً وأسرا",29,"ر",2,0],["هذا بن إسحق الذي جمع العلى","فغدا فريداً في الزمان الآخر",30,"ر",1,0],["هذا بتنسخ وذا","بشرائها بالمال نقدا",31,"د",2,0],["هذا بلا ريب لكل أريب","عين الجهاد لمعتد ومريب",32,"ب",1,1],["هذا بتاج أبيه عاصبٌ وعلى","هذا اختيالُ فتىً بالسيفِ خطَّارِ",33,"ر",1,0],["هذا بُروزٌ سابقٌ","بهِ عَطاءٌ سابقُ",34,"ق",1,1],["هذا بمسجدِه يزهُو ومِنبَرِه","وذاك أصنامُه تَزدَادُ تَشوِيها",35,"ي",3,0],["هذا بريدٌ بارِدُ","فيه المُوظف جَامدُ",36,"د",1,1],["هذا به طوراً يكون حضوره","فتراه قطباً قائماً مقصودا",37,"د",2,0],["هَذَا بِلا ذنبٍ أَتا","هُ جَزَيتَهُ عنه بِحَقِّهْ",38,"ق",2,0]]}