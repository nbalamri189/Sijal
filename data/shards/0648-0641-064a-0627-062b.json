{"poems":[[369,"رمتني بلحظ واتقتني بمعصم","https://www.aldiwan.net/poem60649.html","الطويل"],[369,"ألا من عذيري من جوى في الجوانح","https://www.aldiwan.net/poem60966.html","الطويل"],[408,"هم أودعوه الذي أودعوا","https://www.aldiwan.net/poem46728.html","المتقارب"],[422,"بحيث انعطف البان","https://www.aldiwan.net/poem54026.html","الهزج"],[457,"سقت مستهلات الحيا المتضاعف","https://www.aldiwan.net/poem13843.html","الطويل"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121126","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70030","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72518","المتقارب"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120448","الوافر"],[592,"ألا يا أيها الإنسان سمعا","https://www.poetsgate.com/ViewPoem.aspx?id=128822",""],[5436,"حديثُ الموت والنصر (تركي عبد الغني )","https://www.poetsgate.com/ViewPoem.aspx?id=33447",""]],"verses":[["وفي إثْرِه زَوْجا رماحٍ تَصاحبا","وسارا معاً من كلِّ لَدْنٍ مُقوَّم",0,"م",1,0],["وفي إثْرِهِ منّي على القُرْبِ والنّوى","ثناءً كأنفاسِ الرّياضِ النّوافح",1,"ح",1,0],["وفي أثرِ العيسِ لمَّا سروا","فتىً قلبُه مُؤلَمٌ موجَعُ",2,"ع",1,0],["وفي آثارك الغُرّ","من السادات أعيان",3,"ن",1,0],["وفي إِثرها الشِعرى العَبُور كأنّها","تقلّبُ طَرْفاً مُنْكِراً غير عارف",4,"ف",1,0],["وفي إثره تأتوا ابنه السيف أحمدا","فيسمع منكم أصرح القول في عنف",5,"ف",1,0],["وفي آثاره في السهل","صال عليه مهتصرا",6,"ر",2,0],["وفي إثره النهر حيث التوى","تعقبه طاغياً ودوى",7,"د",3,0],["وفي إثره كرت عجالهم على","هديدٍ نما للجو عزمهم ينمي",8,"ي",1,0],["وَفي أَثنا رِئاسَتِهِ تَسامى","نِظامُ بِنائِهِ فنظمتُ شعري",9,"ر",2,0],["وفي أثر الظعن مني الفؤاد","لكالجمل الحائر الخائر",10,"ر",1,0],["وفي اثنائها حكم توالت","يمج بها يراع وهو ماض",11,"ض",1,0],["وفي آثار أصحاب كرام","وسر في أثر كل التابعينا",12,"ن",2,0],["وفي آثارِ مؤْتَةَ ما يُوافي","وفي حِطّينَ بَيِّنَةُ الفَوارِقْ",13,"ق",1,0]]}