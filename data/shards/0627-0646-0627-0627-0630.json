{"poems":[[55,"إنا إذا حلب البخيل لبانها","https://www.aldiwan.net/poem30658.html","الكامل"],[3,"عفت الديار وباقي الأطلال","https://www.aldiwan.net/poem190.html",""],[95,"أين الجينه وكيف ضاع صباحاً","https://www.aldiwan.net/poem11066.html","الكامل"],[29,"أهوى أراك برامتين وقودا","https://www.aldiwan.net/poem5732.html","الكامل"],[29,"حي الهدملة من ذات المواعيس","https://www.aldiwan.net/poem5787.html","البسيط"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[49,"إنا إذا اشتد الزمان","https://www.aldiwan.net/poem25157.html","مجزوء الكامل"],[53,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[53,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[63,"ليس التجلد شيمة العشاق","https://www.aldiwan.net/poem51519.html","الكامل"],[60,"نحن الكرام بنو الكرام","https://www.aldiwan.net/poem30834.html","مجزوء الكامل"],[89,"أحبب بهن معاهداً ومعانا","https://www.aldiwan.net/poem8235.html","الكامل"],[107,"صفوا المواكب وامشوا حولها مرحا","https://www.aldiwan.net/poem43049.html","البسيط"],[77,"قد أدبر الليل عنا فا حد بالإبل","https://www.aldiwan.net/poem69022.html","البسيط"],[15,"يا ذا المخوفنا بقت","https://www.aldiwan.net/poem45242.html","مجزوء الكامل"],[15,"حلت كبيشة بطن ذات رؤام","https://www.aldiwan.net/poem45247.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85539","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9960","الكامل"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/1053","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141930","البسيط"],[108,"في البصرة","https://www.poetsgate.com/ViewPoem.aspx?id=179307",""],[203,"أيك العصافير والدنيا علي أسى","https://www.aldiwan.net/poem45344.html","البسيط"],[203,"أم يكيد لها من نسلها العقب","https://www.aldiwan.net/poem45409.html","البسيط"],[215,"ما على الغادرين نسكب دمعا إن","https://www.aldiwan.net/poem46763.html","الخفيف"],[230,"إنا إذا سلبت وظائفنا","https://www.aldiwan.net/poem55133.html","أحذ الكامل"],[287,"صاد الفؤاد برمل رامة ريم","https://www.aldiwan.net/poem32627.html","الكامل"],[300,"سائل بنا خابر أكفائنا","https://www.aldiwan.net/poem1136.html",""],[384,"إنا إذا قلت طخارير القزع","https://www.aldiwan.net/poem4565.html","الرجز"],[443,"أترى حان لكم نحوي التفات","https://www.aldiwan.net/poem2562.html","الرمل"],[470,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[508,"إنا إذا ما احتسبنا الوغى","https://www.aldiwan.net/poem21745.html","المتقارب"],[941,"","https://poetry.dctabudhabi.ae/diwan/poem/31384","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25359","الرجز"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145153","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49932","البسيط"],[1668,"","https://poetry.dctabudhabi.ae/diwan/poem/31380","السريع"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141322","الخفيف"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118404","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28594","البسيط"],[2346,"","https://poetry.dctabudhabi.ae/diwan/poem/18020","الرجز"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17736","الكامل"],[2656,"","https://poetry.dctabudhabi.ae/diwan/poem/124602","الكامل"],[2815,"","https://poetry.dctabudhabi.ae/diwan/poem/105738","الكامل"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9620","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200926","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199955","الخفيف"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67598","الكامل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126274","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74076","السريع"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62898","الرجز"],[4068,"","https://poetry.dctabudhabi.ae/diwan/poem/206127","البسيط"],[4176,"","https://poetry.dctabudhabi.ae/diwan/poem/96544","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33693","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120233","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120515","السريع"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120356","الكامل"],[5061,"انا اذنب ياربي","https://www.poetsgate.com/ViewPoem.aspx?id=153002",""],[5096,"أوجاعٌ متَّقدةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=206636",""],[5436,"ياعيد اهلي / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177540",""],[5536,"أنا وعشتار!!","https://www.poetsgate.com/ViewPoem.aspx?id=37059",""],[5842,"يا أيها المسجون في عشق الأنا / محمد حسام الدين دوي","https://www.poetsgate.com/ViewPoem.aspx?id=136246",""],[5956,"طيوف الشقيق الباسمة","https://www.poetsgate.com/ViewPoem.aspx?id=192920",""],[6031,"إِنَّا إِذَا جَارَ الزَّمانُ وَسَامَنا","https://www.poetsgate.com/ViewPoem.aspx?id=46270",""],[6032,"غرام وشجون","https://www.poetsgate.com/ViewPoem.aspx?id=181505",""],[6093,"حَبْرُ المدينةِ","https://www.poetsgate.com/ViewPoem.aspx?id=199237",""],[6115,"زلة الرفيق","https://www.poetsgate.com/ViewPoem.aspx?id=180512",""],[6213,"مغارات السلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76300&r=&rc=48",""]],"verses":[["إِنّا إِذا حَلَبَ البَخيلُ لِبانَها","أَمسَيتُ أَحلُبُها دَمَ الأَوداجِ",0,"ج",1,1],["إِنّا إِذا حَمِسَ الوَغى نُروي القَن","وَنَعِفُّ عِندَ تَقاسُمِ الأَنفالِ",1,"ل",1,0],["إنا إذا مر النسيم بقربنا","من حبكم قلنا لهذا حا حا",2,"ح",2,0],["إِنّا إِذا قَرَعَ العَدُوُّ صَفاتَنا","لاقَوا لَنا حَجَراً أَصَمَّ صَلودا",3,"د",2,0],["إِنّا إِذا مَعشَرٌ كَشَّت بَكارَتُهُم","صُلنا بِأَصيَدَ سامٍ غَيرِ مَعكوسِ",4,"س",1,0],["إِنّا إِذا اِلتَقَتِ المَجامِعُ لَم يَزَل","مِنّا لِزازُ عَظيمَةٍ جَشّامُها",5,"م",3,0],["إِنّا إِذا اِشتَدَّ الزَمان","نُوَنابَ خَطبٌ وَاِدلَهَم",6,"م",1,1],["إنا إذا تاجَرَنا صاحبٌ","أضحى وما ذُمّ له مَتْجرُ",7,"ر",1,0],["إنا إذا صعَّر الجبار صفحتَهُ","شفاءُ صفحتِه من ذلك الصعَرِ",8,"ر",1,0],["إنا إذا المرزوق فاز برزقه","مثل الدبى خلقت بلا أرزاق",9,"ق",1,0],["إِنّا إِذا قَعَدَ اللِئ","مُ عَلى بِساطِ العِزِّ قُمنا",10,"ن",2,0],["إِنَّا إِذَا مَا الْحَرْبُ شَبَّ سَعِيرُهَا","نَحْمِي النَّزِيلَ وَنَمْنَعُ الْجِيرَانَا",11,"ن",2,0],["إنّا إذا ابتدرَ الساعونَ منزلةً","لَنُدرِكُ الأمد الأَقْصَى وإن نزحا",12,"ح",2,0],["إنا إذا صحصحانٌ خلته شبحاً","وأشبه الليل درعَ الفارس البطل",13,"ل",1,0],["إِنّا إِذا عَضَّ الثِقا","فُ بِرَأسِ صَعدَتِنا لَوَينا",14,"ن",2,0],["إِنّا إِذا عَضَّ الثِقافُ قَناتَنا","حالَت وَرامَت ثُمَّ خَيرَ مَرامِ",15,"م",1,0],["إنا إذا ما كنتَ عنّا سائلاً","أسراء موعودون بالتَحرير",16,"ر",1,0],["إِنّا إِذا حَمِسَ الوَغى نُروي القَنا","وَنَعِفُّ عِندَ تَقاسُمِ الأَنفالِ",17,"ل",1,0],["إِنّا إِذا اِشتَدَّ الزَما","نُ وَنابَ خَطبٌ وَاِدلَهَم",18,"م",1,1],["إِنَّا إِذَا ضَيَّعَ الأوْطَانَ فِتْيَتُها","واسْتَوثَقُوا بِسِوَاها ما أَضَعْنَاها",19,"ا",3,0],["إنَّا إذا عَثَرتْ في السَّاحِ أرْجُلِنا","فليس منا جَوَادٌ في الحروب كبا",20,"ب",2,0],["أنا إذا عذلوا عانٍ وإذا عذروا","فآنٍ وإن حكموا لي أولها جاني",21,"ن",2,0],["إنَّا إذاً سبةٌ في الشرقِ فاضحةٌ","والشرقُ منا وإن كنا به خربُ",22,"ب",1,0],["أنا أذنبت في اشتياقي إليكم","إن صدق الغرام بعض ذنوبي",23,"ي",1,0],["إِنّا إذا سُلِبَت وَظائِفُنا","وَتَأَلَّفَت من غيرِنا دُوَلُ",24,"ل",1,1],["أَنا إِذ بَعُدتُ كَصاحِبِ الحوتِ الَّذي","نادى الإِلَهَ وَإِنَّهُ لَكَظيمُ",25,"م",1,0],["إنا إذا نحكمُ في ديننا","نرضى بحكم العادلِ الفاصِلِ",26,"ل",1,0],["إنا إذا قلت طخارير القزع","موفيات الكيل بالمد الترع",27,"ع",1,1],["أنا إذا سار فيكم","كسير الشمس مدحي والصفات",28,"ت",1,0],["أنَّا ، إذا لُحْتَ ، أومأنا بِألفِ يَدٍ","مُنَبِّهينَ بِها أفراخَنا الزُّغُبا !",29,"ب",2,0],["إنَّا إِذَا مَا احتَسَبنَا الوَغَى","أَدرَنا الرَّحَى بِصُنُوفِ الحُدُل",30,"ل",1,1],["إِنّا إِذا حَطمَةٌ حُتَّت لَنا وَرَقاً","نُمارِسُ العودَ حَتّى يَنبُتَ الوَرَقُ",31,"ق",1,0],["إِنَّا إِذَا الحَرْبُ خَبَتْ حَوامِ","وَامْتُرِيَتْ بَعْدَ أَنَى الإِعْتامِ",32,"م",1,0],["إنا إذا ما ليل نجد عسعسا","وغربت هذي الجواري خنسا",33,"س",2,1],["إنّا إذا ما نوينا حبَّ غيْرَ بني","نبْهان كُنَّا كعُبَّادِ الطَّواغيتِ",34,"ت",1,0],["إنا إذا جارت دواعي الهوَى","وأنصتَ السامِعُ للقائِلِ",35,"ل",1,0],["أنا أذري بالعيش والموت والما","ل ومجد الملوك والملكات",36,"ت",1,0],["انا اذا بلد نبا يوما بنا","حملت لاخر نجبنا اثقالنا",37,"ن",2,0],["إِنّا إِذا الخَيُّ لا تَرعى سَوائِمُهُ","إِلّا تَذكُّرَ ريحِ الضّالِ وَالسَّلَمِ",38,"م",1,0],["إِنّا إِذا صيحَ بِنا أَتَينا","وَبِالصِياحِ عَوِّلوا عَلَينا",39,"ن",2,0],["إِنّا إِذا اِجتَمَعَ النَفيرُ بِمَجمَعٍ","يَنفي الأَذَلَّ بِهِ الأَعَزُّ الأَكثَرُ",40,"ر",1,0],["إنا إذا عثر الصديق فإنّنا","غفر له زلّاته سمحاء",41,"ا",2,0],["انا اذا ما غِبتَ عنّا لم نجد","مما تخلّفَ عِندَنا ما ينفعُ",42,"ع",1,0],["إِنّا إِذا غَرَبَت شَمسٌ أَوِ اِرتَفَعَت","وَفي مَبارِكِها بُزلُ المَصاعيبِ",43,"ب",1,0],["أنا إذا أدعوك تيسا","أو حماراً أو شقيقهْ",44,"ق",2,0],["أنا اذكى أم انت مني اذكى","أنت تجري كما الإله براكا",45,"ك",2,0],["إنا إذا جَلسَ الجبا","نُ على بساطِ الذُّلِّ في قمنا",46,"ن",2,0],["انا اذا ماغاب منا فيلق","أخذ اللواء لوا المحامد فيلق",47,"ق",1,0],["إِنّا إِذا ما قيل أَوطاننا","حمنا عليها حومان الفِراش",48,"ش",1,0],["انا اذا النَّقْعُ سَطَعْ","وطارتِ البِيضُ قَزَعْ",49,"ع",1,0],["إنّا إذا اجتمعت يوماً دراهِمنا","ظلّت إلى طرق الخيراتِ تستبقُ",50,"ق",1,0],["إنا إذا كثرت يوماً دراهمنا","ظلَّت إلى سُبُلِ المعروف تستبق",51,"ق",1,0],["أنا أذنبتُ أو فتورٌ بجفنَي","هِ دَعا مُقلتي إلى مُقلتيهِ",52,"ي",2,0],["انا اذا جدنا بدينار","على ذا فهو ذاهب",53,"ب",1,0],["انا اذا رمنا مديحا له","اطاعنا فيه عصى البيان",54,"ن",1,0],["انا اذا قامت بنا","محن فلست بقعدد",55,"د",1,0],["أنا إذنبت يّ ربي وراجي منگْ الغفران","الا يلي تعلم الغﯾب والنيه وما فيهہا",56,"ي",3,1],["أَنَا إِذَا ضَيَّعَتْنِي شِقْوَتِي زَمَنًا","عمِدْتُ رَفْعًا فَمَا عَافَ الحَشَا اللَّهَبُ",57,"ب",1,0],["انّا اذا اشتدّ الطراد بخيلنا","صهلتْ وقسْورٓ في الكتيبة ضيغمُ",58,"م",1,0],["انا اذا حررت نصف العطر من سجن الغراش","اقدر من الاف الانوف البائسة ابني وطن",59,"ن",1,0],["إنا إذا رمنا الخلاص من الضنى","لُذنا بحبل الله لا نتفرقُ",60,"ق",1,0],["أنا أذوي في احتياجٍ","لتعازٍ واعتناءْ",61,"ا",2,0],["إِنَّا إِذَا جَارَ الزَّمانُ وَسَامَنا","ظُلْماً وجَشَّمَنا رُكُوبَ الحَيْفِ",62,"ف",1,1],["إنّا إذا ما الحب أرق ليلنا","ونأى بنا قلنا له آمينا",63,"ن",2,0],["إنَّا إذا حُمَّ القضا","ءُ وحَانَ حِينٌ للوَفاةْ",64,"ا",2,0],["انا اذا جت من رفيقي زله","غضيت عن زلة رفيقي طرفي",65,"ف",2,1],["إنا إذا نبكي نهين نفوسنا","ذلاَّ، فلا يجدي البكاء عن الضرام",66,"م",1,0]]}