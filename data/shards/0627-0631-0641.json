,2,1],["إِرفِقوا بِالقَلبِ قَد أَوثَقتُمُ","قَيدَهُ وَالعِشقُ قَيدٌ موثِقُ",1,"ق",1,0],["أَرُفَاتُ حِيٍّ كَانَ فَرْدَ زَمَانِهِ","بِذَكَائِهِ بَلْ فَرْدَ كُلِّ زَمَانِ",2,"ن",1,0],["أرفعوا للأنس ريّا","فالمبيت في فحص ريّا",3,"ي",2,1],["أرفَعُهم رتبةً وأدفعهم","عنهم لأمرٍ مُحاذَرٍ عَطَبُهْ",4,"ب",2,0],["أرفقتَهم في خرجِهم ووفرتَهم","وكذا المُدِرُّ يُقدّمُ التحفيلا",5,"ل",2,0],["اِرفَع حِدادَ العالَمينَ وَعُد لَهُم","كَيما يُعَيِّدَ بائِسٌ وَفَقيرُ",6,"ر",1,0],["أُرفُق قَليلاً إِنَّها ضَرطَةٌ","لَم تَأتِ بِالفَتحِ عَلى هَيئَتِه",7,"ت",2,0],["أَرفَعُ قَدري عَنهُ وَيَحسِبُني","أَترُكُهُ لِلمُقامِ في بَلَدِه",8,"د",2,0],["أَرفَعُ العالَمينَ قُلَّةَ مَجدٍ","وَأَمَدُّ الأَنامِ بَسطَةَ قَدرِ",9,"ر",1,0],["أَرفَعُ مِن ذَيلِيَ ما كُنتَ أَجُر","وَأَجمَعُ الأَمرَ الشَتيتَ المُنتَشِر",10,"ر",1,0],["اِرفُق فَعُمرُكَ عودُ ذي","أَوَدٍ رَأَيتُ لَهُ اعوِجاجا",11,"ج",2,0],["اِرفَعوهُ غَسِّلوهُ","كَفِّنوهُ حَنِّطوهُ",12,"و",2,0],["أَرفَعُ قَدرَ عَيشَتي بِالخَفضِ","لا أَكحُلُ الجَفنَ بِها بِغَمضِ",13,"ض",1,0],["ارفَعْ من الأَعْوامِ صَرْحَ هِدايةٍ","بَرَّ الشُّهورِ مُبارَكَ الأيّامِ",14,"م",1,0],["ارفَعْ عن الإسلامِ سَوْطَكَ واكْفِهِ","ضَرَبَاتِ قومٍ من بنيهِ طَغامِ",15,"م",1,0],["ارفَع جَناحَكَ وَاِنطَلِق في إِثرِهِ","وَخُذِ الدُهورَ عَلَيهِ وَالأَجيالا",16,"ل",2,0],["إِرفعْ كِتابَكَ يا سُرا","قَةُ إنّه عَلَمُ النَّجاةِ",17,"ه",1,1],["ارفعِ الصّوتَ وأَذِّنْ بِالوغَى","يا بلالَ الخيرِ أذّنْ واقتصِدْ",18,"د",1,0],["إرفَعِي يا دولةَ الحقِّ العِمادا","وأَقيمِي يا طواغيتُ الحِدادا",19,"د",2,0],["ارفعِ المسجدَ المباركَ وَاصْنَعَ","للِبرايا صَنِيعَك المشكورا",20,"ر",2,0],["اِرفِق عَلَيَّ فَإِنَّ النَفسَ قَد تَلَفَت","وَاِنظُر إِلَيَّ فَإِنَّ الروحَ قَد زُهِقا",21,"ق",2,0],["إِرفَع ضَعيفَكَ لا يُحِر بِكَ ضَعفُه","يَوماً فَتُدرِكَهُ العَواقِبُ قَد نَما",22,"م",2,1],["إرفض إخوّةَ مَن نسَك","والزم مودّةَ من فتَك",23,"ك",1,1],["اِرفُق بِعَمرٍو إِذا حَرَّكتَ نِسبَتَهُ","فَإِنَّهُ عَرَبِيٌّ مِن قَواريرِ",24,"ر",1,1],["أُرفُق بِهِ فَشَهِدتُ أَنَّكَ ظالِمٌ","في ظالِمينَ أَباعِدٍ وَأَقارِبِ",25,"ب",1,0],["إِرفَع مِجَنَّكَ أَو ضَع لِلفَتى قَدَرٌ","يُلِمُّ بِالنَفسِ دونَ الدَرعِ وَالتُرُسِ",26,"س",1,1],["أرفع من فكر الورى مَعدِنا","وكل فضلي أنني صُغتُهُ",27,"ه",1,0],["إرفعوا الأقداحَ ملأى واشربوا نخْبَ الحسانِ","فالربيعُ السَّمْحُ يدعوكم إلى أقربِ حانِ",28,"ن",1,0],["ارفع قواعد الفخار وابنِ","لا تدّعم على أب ولا ابن",29,"ن",1,0],["إِرْفَعْ تَجَلَّتِنَا إِلى عَلْيَائِهَا","وَاسْلَمْ وَيَسْلَمُ دَاعِيانَا سَرْمَدَا",30,"د",2,0],["أرفدتُه لك لا كبائر سلعة","لكن كما هنّا الصديق صديقه",31,"ق",2,0],["أُرفِّهُ ما أُرفِّهُ في التقاضي","وليس لديكَ غيْرَ المطْل نقْدُ",32,"د",1,0],["ارفق بِنَفسك وَاِعتَصم","بِحِمى المُهيمن تَنشَرح",33,"ح",1,0],["ارفق بجسم هد ل","كن في خفاه هواك عامر",34,"ر",1,0],["ارفق بعبدك واسقه متمهلا","إن قام يستسقيك مالا يغرق",35,"ق",1,0],["أرفع الصوت وما لي من مجيب","غير هذا الشعر من لحن النحيب",36,"ب",1,0],["أَرفَعُها لِلمَجدِ في أَوجِهِ","لِأَنَّه جذوَةُ قَلبٍ صدي",37,"د",2,0],["إرفَعيني يا قوَّةَ المَكرِ إن لم","تُنزِلي الجُبنةَ التي في السماءِ",38,"ا",2,0],["أَرْفَعُهَا رُتَباً وَأَعْظَمُهَا","جَاهاً وَأَصْعَدُهَا وَأَسْعَدُهَا",39,"د",3,0],["أرفيقُ المحراثِ يحيا سعيداً","ورفيقُ اليراعِ يَقضى افتقارا",40,"ر",2,0],["ارفق عليهم فلن يعودوا","إليك حتى يعود أمس",41,"س",1,0],["أرفع بالخفض أكُفّي معربا","ضمير شأني إذ بنا الفتحُ نبا",42,"ب",2,0],["ارفعن راية الهلال افتخارا","كي ترى في القلوب أعظم قدرا",43,"ر",2,0],["ارفل امامي رقيقا","في حلة من شعاعِ",44,"ع",1,0],["أَرفق بِقَلبي قَليلاً تُعذبهُ","وَكَم عَلى الجَمر يا سؤلي تَقلبهُ",45,"ه",1,0],["ارفع الهمة لا ترض بما","يرضه كل دنى محتقر",46,"ر",1,0],["إرفعيني إلى السماء إذا شئ","ت بوحي من سحرك الشاعريّ",47,"ي",1,0],["ارفعوا رايةَ العقيدةِ حتى","تُبصروا الفجر ضاحكاً مُستبينا",48,"ن",2,0],["أرفقْ بجسْمٍ أنتَ سالبُ روحِهِ","أيَعيشُ جِسْمٌ فَارقتْه الرّوحُ",49,"ح",1,0],["ارفع الرأس ثم قل يسمع القو","ل تشفع يا سيد الشفعاء",50,"ا",2,0],["ارفُق بما اِغتصب الغرامُ فقد أتى","خَطّ العِذار موقعاً في ردّه",51,"د",2,0],["إرفيني إلى سمائك حتى","لا أرى في الوجود إلا الجمالا",52,"ل",2,1],["اُرفُقوا يا ربما ذاق الهوى","واثقٌ من قسوة ألا يذوقَهْ",53,"ق",2,0],["أرفع الضيم بالتجمل حتى","مرَدَ الخرقُ عن خياطِ الرقعِ",54,"ع",1,0],["ارفعوا فيها رؤوسكمو","تاجكم تزهو لآليه",55,"ي",2,0],["أَرْفِقوني بتَوالي عيسِكُمْ","ولكُمْ قلبي على هذا ثمَنْ",56,"ن",1,0],["أرفقةُ بنِ رسولِ اللهِ خيرٌ أمْ","بقاؤُه عبدَ عبدٍ لاهُهُ الجِبْتُ؟!",57,"ت",1,0],["اِرْفَعْ بِفَضْلِكَ شَاني","عَلَى عَدُوٍّ وشانِي",58,"ن",2,0],["أُرفُق به فَإِنَّهُ","يَرى جميلاً ظَنَّهُ",59,"ه",1,0],["أرفعُها لِطَرفي","مُصَعِّدا لِزفرَتي",60,"ي",1,0],["أرفلُ منهنّ وكم ماشٍ أرى","على الثّرى في مثلهنّ ما رَفَلْ",61,"ل",1,0],["ارفع يديك إلى السماء تضرعاً","لله في كل الأمور لتغنما",62,"م",2,1],["ارفق بصب مدنفٍ","البعد عنك ألمه",63,"م",2,0],["أرْفُقْ بِما فَعلَ الغَرامُ فَقدْ أَتى","حَظُّ العِذَارِ مُوقَّعاً في رَدِّهِ",64,"د",2,0],["إِرفَع يَديك أَنتَ فَوقَ الماء","وَرَأسك اِرفَعها إِلى السَماء",65,"ا",2,0],["أَرفَوسُ لَيسَ بِمُستَطي","عٍ أَن يُهَدهِدَ لي جَناني",66,"ن",2,0],["أَرفَه بِعَيشِ فَتى يَغدو عَلى ثِقَة","إِنَّ الَّذي قَسَّمَ الأَرزاقَ يَرزُقُه",67,"ق",2,1],["ارفع رأسي بعد الإنحناء","إذ لا أريد الآن أن أموت",68,"ت",1,0],["أرفَعُ مِن كُلِّ حِصَانٍ حَجَبَا","وَسَاعَةَ الرَّوعِ يَعُطُّ الحُجُبَا",69,"ب",2,0],["ارفق بنفسك لا تقوى على سقر","وافزع إلى اللّه من ذنب سيخزيها",70,"ي",3,0],["إرفع بحقك عن مصر الغلا وقنا","صعيد نار بها ربع الرخاء عفا",71,"ف",2,0],["أرفعُ كلّ الورى مقامَ عُلًى","معظمٌ للثناء أكسبها",72,"ب",3,0],["ارفُقْ بها ارفق فقد كانت أناملها","تكاد من ترفٍ تدمى من الحَبَر",73,"ر",1,0],["ارفق بها ارفق فقد أُعطيتُها قمراً","كوردة الشمس في نسرينة السحر",74,"ر",1,0],["ارفقوا بالألباب قطعتموها","وأربعوا إن فعلكم غلواء",75,"ا",2,0],["إِرفع ضَعيفَكَ لا يُحِربِكَ ضُعفَهُ","يَوماً فَتُدرِكُهُ عَواقِبُ ما جَنى",76,"ا",1,1],["إرفق ولا تجسي على من يلبّيك","فالعمر كلّه واقفٍ في لزومك",77,"ك",1,0],["ارفع لواء العزّة السامية","واسحب ذيول العيشة الراضية",78,"ه",1,1],["أَرفق بِنَفسك ما سؤالك نافع","بَل رُبما غَط النُفوس سؤالها",79,"ل",3,0],["إِرفَعوا مِن شَأنها ما اسطعتم","وَأَشيدوا بِعُلى مِنها وَشان",80,"ن",1,0],["إرفَعهُ نِصفاً عِندَ عَكس