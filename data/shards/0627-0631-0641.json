{"poems":[[77,"إرفع قسي المنشآت بسعده","https://www.aldiwan.net/poem36530.html","الكامل"],[71,"مقلة قرحى وقلب شيق","https://www.aldiwan.net/poem3907.html","الرمل"],[93,"أحننت من شوق إلى لبنان","https://www.aldiwan.net/poem11270.html","الكامل"],[83,"أرفعوا للأنس ريا","https://www.aldiwan.net/poem54203.html","مجزوء الرمل"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[85,"ما جل فيهم عيدك المأثور","https://www.aldiwan.net/poem62883.html","الكامل"],[45,"أليس طبعا في بني آدم","https://www.aldiwan.net/poem62663.html","السريع"],[45,"هاجي بني بحتر وطيئها","https://www.aldiwan.net/poem62765.html","المنسرح"],[45,"غال صبري إما سألت بصبري","https://www.aldiwan.net/poem63641.html","الخفيف"],[58,"إني عجزت عجزة لا أعتذر","https://www.aldiwan.net/poem31033.html","الرجز"],[49,"الله أكرم من يناجى","https://www.aldiwan.net/poem62026.html","مجزوء الكامل"],[49,"يسلم المرء أخوه","https://www.aldiwan.net/poem63192.html","مجزوء الرمل"],[66,"وليلة في طول يوم العرض","https://www.aldiwan.net/poem40689.html","الرجز"],[105,"حملت سناك مواكب الأعوام","https://www.aldiwan.net/poem42074.html","الكامل"],[105,"قل للحسين ولات حين ملام","https://www.aldiwan.net/poem43043.html","الكامل"],[105,"قل للوزير إذا خلا لك وجهه","https://www.aldiwan.net/poem43062.html","الكامل"],[105,"إرفع كتابك يا سرا","https://www.aldiwan.net/poem44031.html","مجزوء الكامل"],[105,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[105,"تلك عقبى البغي فانظر كيف عادا","https://www.aldiwan.net/poem44219.html","الرمل"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[81,"ياسالب القلب مني عندما رمقالم","https://www.aldiwan.net/poem61452.html","الكامل"],[17,"إرفع ضعيفك لا يحر بك ضعفه","https://www.aldiwan.net/poem1188.html",""],[48,"إرفض إخوة من نسك","https://www.aldiwan.net/poem66605.html","مجزوء الكامل"],[50,"ارفق بعمرو إذا حركت نسبته","https://www.aldiwan.net/poem63794.html","البسيط"],[46,"خبر الحياة شرورها وسرورها","https://www.aldiwan.net/poem22353.html","الكامل"],[46,"إرفع مجنك أو ضع للفتى قدر","https://www.aldiwan.net/poem22827.html","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39603","الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202541","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54780","الكامل"],[90,"خل النديم","https://www.poetsgate.com/ViewPoem.aspx?id=178950",""],[51,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""]],"verses":[["إرْفَعْ قِسِيَّ المُنْشَآتِ بسَعدِهِ","واسْتَنْجِزِ النّصْرَ العَزيزَ لوعْدِهِ",0,"د",2,1],["إِرفِقوا بِالقَلبِ قَد أَوثَقتُمُ","قَيدَهُ وَالعِشقُ قَيدٌ موثِقُ",1,"ق",1,0],["أَرُفَاتُ حِيٍّ كَانَ فَرْدَ زَمَانِهِ","بِذَكَائِهِ بَلْ فَرْدَ كُلِّ زَمَانِ",2,"ن",1,0],["أرفعوا للأنس ريّا","فالمبيت في فحص ريّا",3,"ي",2,1],["أرفَعُهم رتبةً وأدفعهم","عنهم لأمرٍ مُحاذَرٍ عَطَبُهْ",4,"ب",2,0],["أرفقتَهم في خرجِهم ووفرتَهم","وكذا المُدِرُّ يُقدّمُ التحفيلا",5,"ل",2,0],["اِرفَع حِدادَ العالَمينَ وَعُد لَهُم","كَيما يُعَيِّدَ بائِسٌ وَفَقيرُ",6,"ر",1,0],["أُرفُق قَليلاً إِنَّها ضَرطَةٌ","لَم تَأتِ بِالفَتحِ عَلى هَيئَتِه",7,"ت",2,0],["أَرفَعُ قَدري عَنهُ وَيَحسِبُني","أَترُكُهُ لِلمُقامِ في بَلَدِه",8,"د",2,0],["أَرفَعُ العالَمينَ قُلَّةَ مَجدٍ","وَأَمَدُّ الأَنامِ بَسطَةَ قَدرِ",9,"ر",1,0],["أَرفَعُ مِن ذَيلِيَ ما كُنتَ أَجُر","وَأَجمَعُ الأَمرَ الشَتيتَ المُنتَشِر",10,"ر",1,0],["اِرفُق فَعُمرُكَ عودُ ذي","أَوَدٍ رَأَيتُ لَهُ اعوِجاجا",11,"ج",2,0],["اِرفَعوهُ غَسِّلوهُ","كَفِّنوهُ حَنِّطوهُ",12,"و",2,0],["أَرفَعُ قَدرَ عَيشَتي بِالخَفضِ","لا أَكحُلُ الجَفنَ بِها بِغَمضِ",13,"ض",1,0],["ارفَعْ من الأَعْوامِ صَرْحَ هِدايةٍ","بَرَّ الشُّهورِ مُبارَكَ الأيّامِ",14,"م",1,0],["ارفَعْ عن الإسلامِ سَوْطَكَ واكْفِهِ","ضَرَبَاتِ قومٍ من بنيهِ طَغامِ",15,"م",1,0],["ارفَع جَناحَكَ وَاِنطَلِق في إِثرِهِ","وَخُذِ الدُهورَ عَلَيهِ وَالأَجيالا",16,"ل",2,0],["إِرفعْ كِتابَكَ يا سُرا","قَةُ إنّه عَلَمُ النَّجاةِ",17,"ه",1,1],["ارفعِ الصّوتَ وأَذِّنْ بِالوغَى","يا بلالَ الخيرِ أذّنْ واقتصِدْ",18,"د",1,0],["إرفَعِي يا دولةَ الحقِّ العِمادا","وأَقيمِي يا طواغيتُ الحِدادا",19,"د",2,0],["ارفعِ المسجدَ المباركَ وَاصْنَعَ","للِبرايا صَنِيعَك المشكورا",20,"ر",2,0],["اِرفِق عَلَيَّ فَإِنَّ النَفسَ قَد تَلَفَت","وَاِنظُر إِلَيَّ فَإِنَّ الروحَ قَد زُهِقا",21,"ق",2,0],["إِرفَع ضَعيفَكَ لا يُحِر بِكَ ضَعفُه","يَوماً فَتُدرِكَهُ العَواقِبُ قَد نَما",22,"م",2,1],["إرفض إخوّةَ مَن نسَك","والزم مودّةَ من فتَك",23,"ك",1,1],["اِرفُق بِعَمرٍو إِذا حَرَّكتَ نِسبَتَهُ","فَإِنَّهُ عَرَبِيٌّ مِن قَواريرِ",24,"ر",1,1],["أُرفُق بِهِ فَشَهِدتُ أَنَّكَ ظالِمٌ","في ظالِمينَ أَباعِدٍ وَأَقارِبِ",25,"ب",1,0],["إِرفَع مِجَنَّكَ أَو ضَع لِلفَتى قَدَرٌ","يُلِمُّ بِالنَفسِ دونَ الدَرعِ وَالتُرُسِ",26,"س",1,1],["أرفع من فكر الورى مَعدِنا","وكل فضلي أنني صُغتُهُ",27,"ه",1,0],["إرفعوا الأقداحَ ملأى واشربوا نخْبَ الحسانِ","فالربيعُ السَّمْحُ يدعوكم إلى أقربِ حانِ",28,"ن",1,0],["ارفع قواعد الفخار وابنِ","لا تدّعم على أب ولا ابن",29,"ن",1,0],["إِرْفَعْ تَجَلَّتِنَا إِلى عَلْيَائِهَا","وَاسْلَمْ وَيَسْلَمُ دَاعِيانَا سَرْمَدَا",30,"د",2,0],["أرفدتُه لك لا كبائر سلعة","لكن كما هنّا الصديق صديقه",31,"ق",2,0],["أُرفِّهُ ما أُرفِّهُ في التقاضي","وليس لديكَ غيْرَ المطْل نقْدُ",32,"د",1,0]]}