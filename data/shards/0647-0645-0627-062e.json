{"poems":[[53,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[45,"إذا لم تجد ما يبتر الفقر قاعدا","https://www.aldiwan.net/poem9570.html","الطويل"],[64,"ملائكة السماء هم أمدوا","https://www.aldiwan.net/poem52206.html","الوافر"],[47,"ليالينا بين اللوى فزرود","https://www.aldiwan.net/poem63519.html","الطويل"],[30,"رأيت بلالا يشتري بتلاده","https://www.aldiwan.net/poem5456.html","الطويل"],[107,"قصوا الحديث عن الفريق النائي","https://www.aldiwan.net/poem42116.html","الكامل"],[104,"هادئ القلب مطبق الأجفان","https://www.aldiwan.net/poem33126.html","الخفيف"],[13,"إذَا المَرْءُ لَمْ يَحْتَلْ وقَدْ جَدَّ جِدُّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=180815",""],[47,"ليالينا بين اللوى فزرود","https://www.poetsgate.com/ViewPoem.aspx?id=31334",""],[203,"على الشمس من نسج الغمام ستور","https://www.aldiwan.net/poem45202.html","الطويل"],[401,"أتاني ولم أخشَ الذي تبعثانه","https://www.aldiwan.net/poem590.html",""],[409,"أجزتك يا علي وأنت عندي","https://www.aldiwan.net/poem33931.html","الوافر"],[534,"هم أخذوا عني العلوم بذلة","https://www.aldiwan.net/poem37500.html","الطويل"],[556,"أفي دارهم من بعدما ارتحلوا تبكي","https://www.aldiwan.net/poem47342.html","الطويل"],[556,"أمنك سرى طيف وقد كان لا يسري","https://www.aldiwan.net/poem47792.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64356","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62450","السريع"],[1954,"","https://poetry.dctabudhabi.ae/diwan/poem/188168","الوافر"],[2753,"","https://poetry.dctabudhabi.ae/diwan/poem/20049","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132608","السريع"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26120","الوافر"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104247","الطويل"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46917","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62815","الوافر"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69246","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81683","الكامل"],[4888,"تحية وطن","https://www.poetsgate.com/ViewPoem.aspx?id=207745",""],[5102,"غنائم حربك","https://www.poetsgate.com/ViewPoem.aspx?id=12895",""],[5183,"هو العيد","https://www.poetsgate.com/ViewPoem.aspx?id=180231",""],[5191,"الحُمق","https://www.poetsgate.com/ViewPoem.aspx?id=211971",""],[6160,"هَلْوسَات فِي غُرْفَة سَودَاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87108&r=&rc=25",""],[6184,"من القدس الى الفرات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78623&r=&rc=15",""]],"verses":[["هما خُطتا خَسْفٍ ولا بُدَّ منهما","أو السِّيرُ لا شيءٌ سواه لرائمِ",0,"م",1,0],["هُما خَلَّتانِ ثَروَةٌ أَو مَنِيَّةٌ","لَعَلَّكَ أَن تُبقي بِواحِدَةٍ ذِكرا",1,"ر",2,0],["هما خلقان من قدس ولكن","ملوك الأرض تخلق بعد حين",2,"ن",1,0],["هُمُ أَخمَدوا نارَ العَدوِّ وَأَوقَدوا","مِنَ الحَربِ ناراً غَيرَ ذاتِ خُمودِ",3,"د",1,0],["هُما خَيرُ كَفَّي مُستَغاثٍ وَغَيرِهِ","إِذا ما بَخيلُ القَومِ عَرَّدَ نائِلُه",4,"ل",2,0],["هم أخطأوا معنى المحبَّةِ وادَّعوا","حِذقَ الثّقاتِ وفطنةَ الحكماءِ",5,"ا",2,0],["همّ إِخوانِنا الجِهاد وَأَضحى","هَمّنا في مَجالسٍ وَلِجان",6,"ن",1,0],["هُمَا خُطَّتَا إمَّا إسَارٌ وَمِنَّةٌ","وَإمَّا دَمٌ وَالْقَتْلُ بالحُرِّ أَجْدَرُ",7,"ر",1,0],["هم أخمدوا نار العدو وأوقدوا","من الحرب نار غير ذات خمود",8,"د",1,0],["هما خطتا ذلٍ فإما ارتوى الهوى","وإما صبرنا والكريمُ صبورُ",9,"ر",1,0],["هُما خيباني كل يومٍ غنيمةً","وأهلكتُهم لو أنّ ذلك نافِعُ",10,"ع",1,0],["هُمُ أخوالنا ولهم علينا","حقوق لا يقوم بها اقتداري",11,"ر",2,0],["هُمْ أَخَذُوا عَنِّي الْعُلُومَ بِذِلَّةٍ","فَلَمّا حَوَوْها عامَلُونِي بغِلْظَةِ",12,"ه",1,1],["هُمُ أخرجوا مِن ضيقِ سخطٍ إلى رضىً","وهمْ أبدلوا قلبي اليقين من الشكِّ",13,"ك",1,0],["هُمُ أخصبوا مرعايَ فيهمْ ومسرحي","وهمْ آمنوا ما بين أظهرهمْ وَكْري",14,"ر",2,0],["هما خير ماشٍ مشى جدة","وجدا وأزكاه أما وأب",15,"ب",1,0],["هم إخوة كلهم ماجدٌ","ترفّعوا في الشرف الأغلبِ",16,"ب",1,0],["هم اختاروك ما أسمى اختيارا","لعام أنت قائده المثالي",17,"ل",2,0],["هُمُ إِخوَتي ديناً فَلا تَقرُبَنَّهُم","أَبا حَشرَج وَأَفحَصَ لِجَنبَيكَ مَضجَعا",18,"ع",2,0],["هم أخوة والشرق أوطانها","تحمي حماه بحدود الشفار",19,"ر",1,0],["هُمُ اِختاروا عَليكَ غَداةَ حَلّوا","وَبَيتُ ابنِ المَراغَةِ بِالمَسيلِ",20,"ل",1,0],["هما خطتا حق فإن فاتتا معاً","سقطت ولو جزت السماكين مصعدا",21,"د",2,0],["هُمْ أخْرَجُونا مِنَ الأَوْطانِ عَنْ حَنَقٍ","وزَحْزَحُونا عن الجِيرانِ مِن ضَغَنِ",22,"ن",1,0],["هُما خَطبا ثَناي فكانَ عرضي","أعزُّ من العطاءِ الهَيلُماني",23,"ن",2,0],["هما خُطَّتا خَسفٍ نَجاؤُكَ منهما","رُكوبُكَ حَوليّاً مِن الثَلجِ أَشهَبا",24,"ب",2,0],["هم إخوةُ الهادي لأمَّته التي","بالغَرْبِ قد سمَّاهمُ غرباءها",25,"ا",3,0],["هم إخوةٌ في السِّلْمِ في الحربِ، ارتوَوْا","بأسًا، أثاروا في الحروبِ قَتاما",26,"م",2,0],["هم إخوتي في الله لست ألومهمْ","عَتْبُ الأحبةِ لا أراه سِجالا",27,"ل",2,0],["هم إخوة كانوا على الدهر كتلة","إذا شد شدوه فضاق وعاؤه",28,"ا",3,0],["همُ اختاروا الجهالةَ عن يقينٍ","بأنّ الجهلَ بالإنسانِ لصقُ",29,"ق",1,0],["هُمْ أَخبَرُوهُ بِاَنَّ رُمْحَ الشِّعْرِ أَخْطَرُ","مِنْ رَصَاصٍ في المُسَدَّسِ يُمْلَى",30,"ل",2,0],["هما خُطّتا خسف ٍ ، حنين وحرقة","بخصم له وجهان والكون مختلّ",31,"ل",1,0]]}