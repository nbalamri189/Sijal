{"poems":[[95,"باعوا المخلد بالحطام الفاني","https://www.aldiwan.net/poem11248.html","الكامل"],[39,"أورثته الحصان أم هشام","https://www.aldiwan.net/poem7072.html","الخفيف"],[53,"هل تعرف الدار بذي الأثأب","https://www.aldiwan.net/poem8512.html","السريع"],[53,"لا يبعدن شبابك الغرنيق","https://www.aldiwan.net/poem65701.html","الكامل"],[53,"قد لعمري اقتصصت من كل ضرس","https://www.aldiwan.net/poem65806.html","الخفيف"],[87,"أنا إن بذلت الروح كيف ألام","https://www.aldiwan.net/poem63020.html","الكامل"],[45,"كفي أراني ويك لومك ألوما","https://www.aldiwan.net/poem10530.html","الكامل"],[47,"بأبي أنت كيف أخلفت وعدي","https://www.aldiwan.net/poem62754.html","الخفيف"],[47,"للفضل أخلاق يلقن بفضله","https://www.aldiwan.net/poem65547.html","الكامل"],[63,"أخلت أن جنابا منك يجتنب","https://www.aldiwan.net/poem51814.html","البسيط"],[46,"إحدى بني بكر بن عبد مناه","https://www.aldiwan.net/poem30327.html","الكامل"],[71,"أرح النفس قليلا","https://www.aldiwan.net/poem28876.html","مجزوء الرمل"],[33,"خطرت لذات الخال ذكرى بعدما","https://www.aldiwan.net/poem42633.html","الكامل"],[22,"إن عمروا وما تجشم عمرو","https://www.aldiwan.net/poem21709.html","الخفيف"],[48,"تورعوا يا بني حواء عن كذب","https://www.aldiwan.net/poem22541.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39612","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39554","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54575","الكامل"],[22,"إنْ عمراً وما تجشّمَ عمروٌ","https://www.poetsgate.com/ViewPoem.aspx?id=19810",""],[113,"لم أنس قولة هاتف","https://www.aldiwan.net/poem16410.html","مجزوء الكامل"],[119,"يقول يعقوب لسر خفي","https://www.aldiwan.net/poem40891.html","عموديه"],[193,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[228,"حين أقبلت والهوى فيك يحبو","https://www.aldiwan.net/poem39723.html","الخفيف"],[257,"عجباً لطيفك حين أسعف موهنا","https://www.aldiwan.net/poem1440.html",""],[303,"ساجع حن إلى ذات جناح","https://www.aldiwan.net/poem36843.html","عموديه"],[398,"يا وصل مالك لا تعاود","https://www.aldiwan.net/poem53658.html","مجزوء الكامل"],[458,"خطرت آسيا بعيد أبيها","https://www.aldiwan.net/poem61621.html","الخفيف"],[463,"من عذيري يوم شرقي الحمى","https://www.aldiwan.net/poem56251.html","الرمل"],[469,"ما على الركب من تلافي تلافي","https://www.aldiwan.net/poem3215.html","عموديه"],[484,"الحب داء دفين","https://www.aldiwan.net/poem36935.html","المجتث"],[484,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[484,"لست المبدل جنسي","https://www.aldiwan.net/poem37608.html","المجتث"],[556,"ما بال حقف بكثيب اللوى","https://www.aldiwan.net/poem47287.html","السريع"],[556,"قربا مني القلاص العتاقا","https://www.aldiwan.net/poem47367.html","المديد"],[556,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[556,"صد عني كارها قربي","https://www.aldiwan.net/poem48073.html","مجزوء الرمل"],[591,"لم تجرح السكين كف معذبي","https://www.aldiwan.net/poem17616.html","الكامل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2452","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138302",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83291","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96985","الخفيف"],[806,"","https://poetry.dctabudhabi.ae/diwan/poem/110735","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63765","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96724","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96661","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61171","الرمل"],[1170,"","https://poetry.dctabudhabi.ae/diwan/poem/146937","البسيط"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69195","المنسرح"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79967","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79943","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79960","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101005","السريع"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105429","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66286","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108460","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53084","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109428","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93677","الرمل"],[2607,"","https://poetry.dctabudhabi.ae/diwan/poem/34891","الرمل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129990","البسيط"],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124712","الكامل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93409","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94270","الكامل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109800","الكامل"],[3181,"","https://poetry.dctabudhabi.ae/diwan/poem/105093","الكامل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121774","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62817","المنسرح"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127052","الخفيف"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126981","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132129","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117922","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114331","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102982","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35584","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86354","الرمل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136452",""],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66126","البسيط"],[4927,"الجمال والحب","https://www.poetsgate.com/ViewPoem.aspx?id=4576",""],[5064,"الطّريق إلى الرّب","https://www.poetsgate.com/ViewPoem.aspx?id=199124",""],[5072,"هو عيدكم","https://www.poetsgate.com/ViewPoem.aspx?id=51804",""],[5397,"غير بدع بأن يخون الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=157911",""],[5414,"الهابطون والصاعدون","https://www.poetsgate.com/ViewPoem.aspx?id=12938",""],[5459,"المتخم","https://www.poetsgate.com/ViewPoem.aspx?id=190892",""],[5459,"كذبَتْ عليك ..","https://www.poetsgate.com/ViewPoem.aspx?id=213590",""],[5691,"شحرور القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=206593",""],[5691,"الكوكب الأحمر... الوطن القادم...!","https://www.poetsgate.com/ViewPoem.aspx?id=206733",""],[402,"باعوا المخلد بالحطام الفاني","https://www.poetsgate.com/ViewPoem.aspx?id=36493",""],[5956,"كلُّ هاوٍ","https://www.poetsgate.com/ViewPoem.aspx?id=181846",""],[5956,"غليل وعويل","https://www.poetsgate.com/ViewPoem.aspx?id=181971",""],[6019,"ضاق الفصاء وباب جودك مشرع","https://www.poetsgate.com/ViewPoem.aspx?id=175588",""],[6070,"قولي بربكِ ما الذي أبكاكِ","https://www.poetsgate.com/ViewPoem.aspx?id=189501",""],[6117,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=182777",""],[6142,"مادت الأرض انقلاباً والسما","https://www.poetsgate.com/ViewPoem.aspx?id=155750",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""],[6152,"الصبر على البلاء","https://www.poetsgate.com/ViewPoem.aspx?id=204603",""],[3155,"إلى قُمْريَّة الشط","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75612&r=&rc=35",""],[6237,"يا ربيع الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77871&r=&rc=13",""],[6328,"آمنة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84422&r=&rc=20",""]],"verses":[["لَمْ تَجْرِ فِي عَبَثٍ وَلَمْ تُنْكِرْ بِهَا","لُطْفَ المَكَانِ رَوَائعُ الْقُرْآنِ",0,"ن",1,0],["لم تجهم له البطاح ولكن","وجدتها له معاناً ودورا",1,"ر",2,0],["لم تجرِ فيها حيوانيةٌ","فهي كمثلِ الحَجَر الصُّلَّبِ",2,"ب",1,0],["لم تجمع الأيام شمل أحبةٍ","إلا وشرط صروفها التفريق",3,"ق",1,0],["لم تَجِدْ حيلةً لنا إذ وَترنا","ك فحاربْتنا بشرّ دِنانِكْ",4,"ك",1,0],["لَم تَجرِ بَينَ جَوانِحي إِلّا كَما","جَرَتِ الدِنانَ بِها وَسالَ الجامُ",5,"م",1,0],["لَم تُجمَعِ الأَضدادُ في مُتَشابِهٍ","إِلّا لِتَجعَلَني لِغُرمي مَغنَما",6,"م",2,0],["لَم تَجِد مِثلَ ما وَجَدتُ وَما أَن","صَفتَ إِن لَم تَجِد مِثلَ وَجدي",7,"د",2,0],["لَم تُجهِدِ الأَجوادَ غايَةُ سُؤدُدٍ","إِلّا تَناوَلَها بِأَهوَنِ رُسلِهِ",8,"ل",2,0],["لم تجلُبِ الخيلَ تَردي نحوَهم قُدُماً","إلا انثنتْ وذوو تيجانِها جَلَبُ",9,"ب",1,0],["لَم تَجتَمِع أَمثالُها في مَوطِنٍ","لَولا صِفاتٌ في كِتابِ اللَهِ",10,"ه",1,0],["لمْ تجدْ إلا قؤولاً","للتقى ليس فعولا",11,"ل",2,0],["لَم تَجزِ أُمُّ الصَلتِ يَومَ فِراقِنا","بِالخَيفِ مَوقِفَ صُحبَتي وَرِكابي",12,"ب",2,0],["لَم تَجِد غالِبٌ وَراءَكَ مَعدىً","لِتُراثٍ وَلا دَمٌ مَطلولُ",13,"ل",1,0],["لَم تُجدِبوا لِقَبيحٍ مِن فِعالِكُمُ","وَلَم يَجِئكُم لِحُسنِ التَوبَةِ المَطَرُ",14,"ر",1,0],["لم تجْرِ مَلحَمةٌ بوصفِ كفاحِه","لكن جرت بدمائهِ الأنهارُ",15,"ر",1,0],["لم تَجُزْ عن ثراك قيدَ ذراعٍ","أو تُنَبِّه جفنَ الصباحِ الغافي",16,"ف",2,0],["لَمْ تَجْتَمِعْ إِلاَّ وَقَدْ","قَرُبَ الْبَعِيدُ مِنَ الطِّلاَبِ",17,"ب",1,0],["لَمْ تَجِدْ عَالِبٌ وَرَاءَكَ مَعْدًى","لِتِرَاتٍ ولا دَمٌ مَطْلُولُ",18,"ل",1,0],["لَم تَجد أه بَعدَ ما","رَحَل الخَليط وَقَول حيف",19,"ف",1,0],["لم تجب النار له قائلا","وعينه القرحاء لم تنصف",20,"ف",1,0],["لَم تجعلِ المُصطفى أهلاً لزائرهِ","بِشدّهِ الرَحل أو من يستغيث بهِ",21,"ب",2,0],["لَم تَجيئني بِدون قَلبٍ بَريءٍ","إِنَّما أَلسُنُ الوُشاةِ أَراقِم",22,"م",1,0],["لَم تجلهِ سِنَةُ الكَرى حَتّى اِنجلَت","عَنّي عَلى رُغمي فَودَّعَ واِنثَنى",23,"ن",2,0],["لم تجدْ عينيَ أحلى غَزَلا","لا وَلا أَلطف من ذاك المراح",24,"ح",1,0],["لَم تَجتَري عُصَبُ الهبو","طِ عَلى مُناوَأَةِ الفَراقِد",25,"د",1,0],["لم تجدها كفؤاً لمعنى اله","دايا أو لمعنى حَوته غير مُباحِ",26,"ح",1,0],["لم تجِد أبكارُهُ أو عُونُهُ","عنك في خُطَّابها مُنتدَحا",27,"ح",2,0],["لم تجد في الورى سواك لها بع","لاً قريع الأجداد والأسلاف",28,"ف",1,0],["لم تجد رقية راق","فيه ولم يلق راق",29,"ق",1,0],["لم تجده في سبب","للزحاف مرتكبا",30,"ب",2,0],["لم تجد بيض وصفر","تعطيكها أم دفر",31,"ر",1,0],["لم تُجرِها في خاطرٍ فكرةٌ","ولم يَنَلْها أَمَلُ الآملِ",32,"ل",1,0],["لم تَجدْ إلّا مَجرّاً لرمحٍ","أو نجيعاً من عدوٍّ مُراقا",33,"ق",2,0],["لَم تَجنِهِ إلّا الهمومُ بِمَفْرقي","ويُخالُ جاءَ بهِ معَ الميلادِ",34,"د",1,0],["لَم تَجِدْ ذَنباً وَلَكِنْ","أنتَ لفَّقتَ ذنوبا",35,"ب",2,0],["لَمْ تَجْرَحِ السِّكّينُ كَفَّ مُعَذِّبِي","إِلَّا لِمعنىً حُسْنُه مُتَحَقِّقُ",36,"ق",1,1],["لَم تُجِبني مِنها الطُلولُ وَلَم أَم","لِك دُموعاً تَسيلُ كَالأَوشالِ",37,"ل",1,0],["لم تجن جرما بل عليها قد جنى","من ليس في سوء المغبة فاكرا",38,"ر",2,0],["لَم تَجتَزِئ بِتَليدِ مَجدِكَ عالَماً","أَنَّ الرِجالَ إِذا مَضَت أَخبارُ",39,"ر",1,0],["لم تجاوز سنوه عشرين لكن","هو راياً من ابن ستين أحزم",40,"م",1,0],["لم تجد من محدث بسواهم","أبداً في الأغوار والأنجاد",41,"د",1,0],["لم تَجْلُهُ الريحُ قطُّ إلاّ","ظَلَّتْ عليه القلوبُ تُنْشَر",42,"ر",1,0],["لَم تجرِ أقلامهُ في طرسه أبداً","إلّا تولّد منها البؤس والنعمُ",43,"م",1,0],["لَم تجرِ في القرطاسِ أقلامٌ له","إلّا عَلى قَدرٍ من الأقدارِ",44,"ر",1,0],["لَم تَجد عَيناي عَنهُ مَصرفا","أَرقم أَبصرته منعطفا",45,"ف",2,1],["لم تجد مالاً ولا جاهاً فكيف غداً","عند التباهي بذا أو ذاك مفتخرا",46,"ر",2,0],["لَم تجتَلِ الشَمسُ حسنَ بهجتها","حَتّى اجتلتها حَربٌ تُباشرها",47,"ر",3,0],["لم تجل في مجلسٍ إلاَّ بوصفكم","تبسَّمتْ كابتسام الروض بالزهر",48,"ر",1,0],["لم تجر أهلُ السبق في شأوهِ","إلاَّ غدا العجزُ قُصاراها",49,"ا",3,0],["لم تجترحْ ذنباً جوارحُ جسمه","بل كانَ عن خطط الذنوب بعيدا",50,"د",2,0],["لَم تجِدي كَربي ولم تحملي","ناراً عليها تنطوي أضلعي",51,"ع",2,0],["لم تجد فيه مطمعاً فاطو عنه","كلما أوجعته قرما وغمزا",52,"ز",2,0],["لم تجر ذكرى نيّرٍ وصفاته","إلا ذكرتك والحديث شجون",53,"ن",1,0],["لم تجد في الورى سواهُ ظهيراً","وهو ما جاء كي يشيد سواهُ",54,"ا",2,0],["لم تجد ملجأ سوى أن تلاوت","وهو في كل معرس ملجاها",54,"ا",3,0],["لم تَجِد غير عزمة العروة الوث","قى إذا ناب ما يحل عراها",54,"ا",3,0],["لم تجن أزهار التهاني أولا","حتى جنت ثمر التعازي ثانيا",55,"ي",2,0],["لم تجد بالخيال أم الوليد","حين لجَّت في نأيها والصدود",56,"د",1,1],["لم تجد فكرة إذا سبرته","فيه عيباً إلا السخا والنجابه",57,"ب",2,0