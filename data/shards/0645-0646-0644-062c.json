{"poems":[[93,"ليت الذي خلق الحياة جميلة","https://www.aldiwan.net/poem62628.html","عموديه"],[93,"تأملات","https://www.poetsgate.com/ViewPoem.aspx?id=53220",""],[164,"سم سمة تحمد آثارها","https://www.aldiwan.net/poem59021.html","السريع"],[463,"ما للدسوت وللسروج تسائل","https://www.aldiwan.net/poem56069.html","الكامل"],[469,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[505,"من لجسم من لوعة الهجر بالي","https://www.aldiwan.net/poem37923.html","الخفيف"],[543,"حي فيها الإخلاص ولاإقداما","https://www.aldiwan.net/poem47934.html","عموديه"],[794,"","https://poetry.dctabudhabi.ae/diwan/poem/101203","الرمل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100495","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74097","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114503","الرمل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146765","المنسرح"],[5239,"ومقشعر الجلد مزوَرُّ الحدق","https://www.poetsgate.com/ViewPoem.aspx?id=190936",""]],"verses":[["مَن لَجَّ في ضَيمي تَرَكتُ سَمائَهُ","تَبكي عَلَيَّ بِشَمسِها وَهِلالِها",0,"ل",3,0],["من لجّ في ضيمي تركت سماءه","تبكي علّي بشمسها وهلالها",1,"ل",3,0],["من لج مهيوجا ترى أى له","من ابن إسمعيل من لجمه",2,"م",2,0],["مَن لجلج الناعي يحدِّث أنه","أودَى فقيل أقائلٌ أم قاتلُ",3,"ل",1,0],["من لجمعِ الشتيت من بدد الف","ضلِ وفضّ الزحام يومَ الزحامِ",4,"م",1,0],["مَنْ لِجِسْمٍ من لَوعةِ الهَجرِ بالي","نَظَّمَتْهُ البَلْوى بِسِلْكِ الخَيالِ",5,"ل",1,1],["من لُجينٍ يذوبُ عاماً فعاما","آهِ مالي سواهُ ماءً زلالاً",6,"ل",2,0],["من لجين صيغ لكن","قد أطلوه نضارا",7,"ر",2,0],["من لجسم في الترب بات تريبا","من لرأس فوق السنان أديرا",8,"ر",2,0],["من لجفني بغفوة في ليال","أَنكر الجفن عندها الإِغفاءَ",9,"ا",2,0],["من لجينٍ قد لوى في","وجنتيهِ صُدغَه",10,"ه",1,0],["من لجوىً حلّ بي عساكره","وحطّ بين الحشى مضاربه",11,"ب",2,0],["من لج في البحر تغشّاه الغرق","أو سارع الدهر إلى الحتف اختنق",12,"ق",1,0]]}