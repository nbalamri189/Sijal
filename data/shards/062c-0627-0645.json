https://poetry.dctabudhabi.ae/diwan/poem/83121","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72759","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72896","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72588","الرمل"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/199652","الرجز"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204197",""],[4753,"عاشق السوسن","https://www.poetsgate.com/ViewPoem.aspx?id=108350",""],[4767,"ربيع الثاني","https://www.poetsgate.com/ViewPoem.aspx?id=175100",""],[4791,"ياملاك الغيد","https://www.poetsgate.com/ViewPoem.aspx?id=37111",""],[4806,"عطر الياسمين","https://www.poetsgate.com/ViewPoem.aspx?id=180933",""],[4852,"جامل زمانك","https://www.poetsgate.com/ViewPoem.aspx?id=214271",""],[4980,"لَاحَت ذِكرَاهَا","https://www.poetsgate.com/ViewPoem.aspx?id=190613",""],[5009,"جيل الصحوة","https://www.poetsgate.com/ViewPoem.aspx?id=68820",""],[5061,"ماكتبت الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=154888",""],[5150,"إلى أختي ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203764",""],[5156,"يا والي الإمام هنأك الله","https://www.poetsgate.com/ViewPoem.aspx?id=99178",""],[5388,"ارحل","https://www.poetsgate.com/ViewPoem.aspx?id=208766",""],[5397,"أترع لي في سفحه الأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=157902",""],[5442,"اشرفت في السواد ذات الثور","https://www.poetsgate.com/ViewPoem.aspx?id=114768",""],[5461,"من يقول الزين ما يكمل","https://www.poetsgate.com/ViewPoem.aspx?id=8547",""],[5536,"المسيح ومريم العذرا وجذع النخلة!!","https://www.poetsgate.com/ViewPoem.aspx?id=27505",""],[5573,"الياس جمره تشتعل داخل الجوف","https://www.poetsgate.com/ViewPoem.aspx?id=200075",""],[5596,"تقريظ كتاب التاريخ الإباضي","https://www.poetsgate.com/ViewPoem.aspx?id=206483",""],[5893,"شجون الغلا","https://www.poetsgate.com/ViewPoem.aspx?id=141495",""],[6056,"الحكي والوشاية","https://www.poetsgate.com/ViewPoem.aspx?id=156706",""]],"verses":[["جامِحٌ أَقصَعَهُ مِن","قائِمِ العَضبِ لِجامُ",0,"م",1,0],["جامِدُ اللَحظِ حَيرَةَ البَينِ إِلّا","أَنَّ مِنهُ ذَوبَ الدَمِ المُهراقِ",1,"ق",1,0],["جامِعُ لينٍ وَصِيالٍ مَعاً","إِطراقَ ذي حِلمٍ وَصَولِ الحَنيق",2,"ق",1,0],["جامِعٌ لي بَينَ فَخرٍ وَأَذىً","رُبَّما بَرَّحَ بِالأُذنِ القُرُط",3,"ط",1,0],["جَامِعُ النُّبْل وَالنُّبُوغِ إِلَى","فَضْلِ عِلْمٍ وَحُسْنِ تِبْيَانِ",4,"ن",1,0],["جامعاً أفصح اللغى","حاوياً أكبر العبر",5,"ر",1,0],["جامع في الجودِ والع","لم صفات كوكبيَّه",6,"ي",2,0],["جامعاتٍ بذاك أمرين في أم","رٍ فعالَ المُسْتَمْتِعِ المستديم",7,"م",1,0],["جامِلِ الناسَ تَحُز رِقَّ الجَميع","رُبَّ قَيدٍ مِن جَميلٍ وَصَنيع",8,"ع",1,0],["جامَلوني إِذ تَمَّ لي رُبعُ قَرنٍ","مِثلَما جامَلوا المُلوكَ العِظاما",9,"م",2,0],["جامِلْ أخاك إِذا استربْتَ بوُدِّهِ","وانْظُرْ به عُقَبَ الزمان يعاودِ",10,"د",1,1],["جاملْ عدوَّكَ ما استطعتَ فإنهُ","بالرِفْقِ يُطْمَعُ في صلاح الفاسدِ",11,"د",1,1],["جامِعُ الرَأيِ لَيسَ يَخفى عَلَيهِ","أَينَ وَجهُ الصَوابِ في التَدبيرِ",12,"ر",1,0],["جامِعُ المَّكرُماتِ إِذ باتَ يَأبى","هُنَّ جَمعَ البَخيلِ وَاِستِئثارُه",13,"ر",2,0],["جامِحٌ في العِنانِ لايَسمَعُ الزَج","رَ وَلا يَنثَني إِلى الرُوّاضِ",14,"ض",1,0],["جامٌ يجمِّعُ شربُهُ لذّاتِنا","وعقولُنا بالسكر منه تُبَدّدُ",15,"د",1,0],["جامعُ الحظِّ والذكاءِ قليلٌ","يصعبُ الجمعُ بينَ ماءٍ ونارِ",16,"ر",1,0],["جامع الفَضل في الرِواية وَالشع","ر إِلى الأَصمَعيّ طَبع الوَليدِ",17,"د",1,0],["جامَلَني بِالقَولِ حَتّى إِذا","صارَ لَهُ مالٌ وَتَمكينُ",18,"ن",1,0],["جامِحاً إنْ سِيمَ صَبراً عنكُمُ","وعليكُمْ جانِحاً لم يتَأيْ",19,"ي",1,0],["جامع للضدين من مثل بخلٍ","وندىً أَو بلادةٍ وسداد",20,"د",1,0],["جامعة بين البيان الرائع","وبين عليا حكم الشرائع",21,"ع",1,0],["جَامِعاً فِيهَا الأَفانِينَ الَّتِي","يَدَّعِي إِتْقَانَهَا عِلْماً وَخُبْرَا",22,"ر",2,0],["جَامِعٌ لِلسَّمَاءِ وَالمَاءِزَخَّا","رٌ بِمَوْجٍ عَالٍ وَضَوْءٍ شَدِيدِ",23,"د",1,0],["جامع من ذخائر العلم والحك","مة ذخرا ً يبقى ليوم المعاد",24,"د",1,0],["جامعاتٍ – كلَّ ما لا يلتَقي","من نَقيضَيْن – شَناراً واحتِفالا",25,"ل",2,0],["جامِعُ المَكرُماتِ، إذْ باتَ يأبا","هُنّ جَمعُ البَخيلِ، وَاستِكثارُهْ",26,"ر",2,0],["جامع السر معدن البر والخي","ر وكنز النوال للفقراء",27,"ا",2,0],["جامعٌ في صَدرِهِ ما","ليسَ تَحويه الصُدور",28,"ر",1,0],["جامعا ذِلةً وعجزا وكبراَ","وعقوقا وغيبةً ونينما",29,"م",2,0],["جامٌ يَكونُ مِنَ العَقيقِ الأَحمَرِ","فُرِشَت قَرارَتُهُ بِمِسكٍ أَذفَرِ",30,"ر",1,1],["جامٌ حَوَى في الظَّرْفِ كلَّ بابِ","مُستملَحٍ منه ومستطابِ",31,"ب",1,1],["جامٌ من البلّور قد حَفَّه","غشاؤه الأخضر من سُنْدس",32,"س",1,0],["جامِلِ الناسَ في المَعا","شِ وَخَلِّ المُزاحَمَه",33,"ه",1,1],["جامع المنقبات ذو الخلق المح","مود من بعضه حديث الجيوش",34,"ش",1,0],["جامِعِ البَأسِ وَالسَما","حَةِ وَالرَأيِ في قَرَن",35,"ن",1,0],["جَامٌ بَدِيعٌ يُسَلِّي الْمَرْءَ بِالنَّظَرِ","وَلَوْ غَدَا قَلْبُهُ أقْسَى مِنَ الْحَجَرِ",36,"ر",1,1],["جامليني لو بوعدٍ","منك واهٍ لا يدومُ",37,"م",1,0],["جامع المكرمات بعد شتاتٍ","وهو للمنكرات عنّا مبيد",38,"د",1,0],["جامد الكفين يندي وجهه","خجلاً عند مديحي لا هجائي",39,"ا",2,0],["جامِعُ الحُسنِ كُلُّ قَل","بي عَلَيهِ وَقَفتُهُ",40,"ت",2,0],["جامح الفكر مستثار الخيالات","قصاراه لذّة وانتشاء",41,"ا",2,0],["جامِعٌ لِلنَقيضِ فِيَّ عَلَيهِ","دونَ قَومي جَعَلتُ وَقفاً هَوائي",42,"ا",3,0],["جامِعُ الحُسنِ وَقفُهُ","مِن فُؤادي جَميعُهُ",43,"ع",2,0],["جامعاً شَملَكُم وذلك أَوْلى","شَمْلِ مُلْكٍ أَن يُخْلِدَ اللهُ جَمْعه",44,"ع",2,0],["جامعةٌ في كلِّ بيتِ شِعر","معنىً رقيقا تحتَ لفظِ حُرِّ",45,"ر",1,0],["جامِعُ الزَّيتونةِ الأسمى سيبْقى","رمْزَكِ الأسمى ، فزيدِيهِ ارتفاعا",46,"ع",2,0],["جامع كل صفات للعلى","فهو في جيد العلى عقد حلاها",47,"ا",3,0],["جامع للعلوم شفع المعالي","مفرد الفضل واحد الآحاد",48,"د",1,0],["جامحُ الصدر حين يلجمُ بالر","يح إلى غاية المقام الكريم",49,"م",1,0],["جامعاً بين صدودٍ ووصال","جمعاً بين حياةٍ وحمامِ",50,"م",1,0],["جامعيٌ بمدرسي تلاقي","في صعيد والكل حر غيور",51,"ر",1,0],["جامعَةٌ لِكُلِّ خَيرٍ بيِّنٍ","سِوى طَريقِها مُناطٌ بالفَشَلْ",52,"ل",1,0],["جامِحَ القلبِ لَيسَ يَحفِلُ فيكم","بِمَقالِ العُذّالِ واللّوّامِ",53,"م",1,0],["جامع للكمال والنقص شمس","هي بالنشأتين في أبراج",54,"ج",1,0],["جامعاً فارقاً بقدرته","حاش لله أن أكون أنا",55,"ن",2,0],["جامع للكل منفرد","ما سيأتي فيك والأول",56,"ل",1,0],["جامعوه يلقون فيه شكوكاً","تنتج الريب في أمور الناس",57,"س",1,0],["جامد الذات خامداً","حامداً ظلمة الدجا",58,"ج",2,0],["جامدي صار مائعاً","كله يا أولي الحجا",58,"ج",2,0],["جَامِعُ السَّيْفِ للخليْفِةِ والأق","لاَمِ أَعظِمْ بِسيِّدٍ ومَسُودِ",59,"د",1,0],["جامع التوبة قد قل","دني منه أمانه",60,"ن",2,0],["جامَ زُجاجٍ أَزرَقٍ","قَد نُثِرَت فيهِ دُرَرْ",61,"ر",1,0],["جامعاً رأيك في حجته","وقديماً نفع الرأي الشجاعا",62,"ع",2,0],["جامُوس ذبحٍ جمَّ المعالِف قد","صُيِّرَ للذبحِ ثم قد لُزِّز",63,"ز",1,0],["جامِعُ العِلمِ في زَوايا فهومٍ","رَكَعَت عِندَها نُهى الفضلاءِ",64,"ا",2,0],["جامِد وَفي الأَرضِ مَنكوت","عالي شَبيه الجَهامه",65,"ه",1,0],["جَامعَاتٍ لِلأَمْرِ بَعْدَ افْتِراقٍ","جَابِرَاتٍ لِلْعَظْمِ بَعْدَ انْهِيَاضِ",66,"ض",1,0],["جاملّتمو سُرَّاقهُ","ذا صامتٌ ذا قانِعُ",67,"ع",1,0],["جامع من مجمع التأويل ما","عنه منشي مجمع البحرين حادْ",68,"د",1,0],["جامع الصبر إذا احتفّ الملا","واسع الصدر إذا ضاق الفضا",69,"ض",2,0],["جامع عبد شريف كامل","فاضل من أمه فاز وجد",70,"د",1,0],["جامع الخيرات يمن المرتجى","ابدا والغيث والغوث السريع",71,"ع",1,0],["جامعة لجملة الأوزان","وتقتضي الرضى على شعبان",72,"ن",1,0],["جامع الناس للقيامة يا اللّه","يا اللّه اجمع شتاتي وشملي",73,"ل",2,0],["جامع الفضل المبين إم","ام العطايا قبلة الكرم",74,"م",1,0],["جامعٌ قسوة الحميَّة للدين","انتصاراً ورقَّة الإِيمان",75,"ن",1,0],["جامعاً ما بين آل المصطفى","من بني قومي وعبّاد المسيح",76,"ح",1,0],["جامعُ الناسِ والموازينِ قِسطٌ","يومَ لم تجدِ زَفرَةُ الندمانِ",77,"ن",1,0],["جامعاتِ الأقواتِ من كلِّ فجٍّ","ما ثناها عن عزمِها ما تعانى",77,"ن",2,0],["جامِعُ الأنبياءِ تحت لِوَاءٍ","رفعتهُ يمينُهُ السَّمحاء",78,"ا",2,0],["جامع الفضل الذي ما حازه","غيرهُ وهو بهِ أضحى فريدا",79,"د",2,0],["جامع اشتات العلوم وهي لو","لاه لكانَت ابدا ايدى سبا",80,"ب",2,0],["جامع الفضل الذي لم يجمع","ولتهن منه أعلى أسرة",81,"ه",1,0],["جامع شارد العلوم ولولا","ه لكانت أم الفضائل ثكلى",82,"ل",2,0],["جَامِس فُلَه وقَدح إذ يَبدُوا","والسِّيفُ والسِّيلانُ إِصبَع فَردُ",83,"د",1,0],["جامع الاشتات يوم الغمرات","حيث ينسى الناس للماضي الشجون",84,"ن",1,0],["جامع في صفاته كل حسن","كان فيها بين الأنام تقسم",85,"م",1,0],["جامِلُ الكل وَافرُ الفضْل وَا","فى العدلَ هَنيُّ المرامِ سَهْلٌ قياده",86,"د",2,0],["جامعٌ رِقَّةَ الحجازِ وسْحْرَ الشَّ","امِ حُسْناً في سِلْكِ لُطْفِ العِراقِ",87,"ق",1,0],["جامع المال والخصاصةِ رفقا","لك حالٌ من التناقض تخزى",88,"ز",2,1],["جامع بنقوسا فكف المصطفى","عليه نور فوق نور رفرفا",89,"ف",2,0],["جامع العلم والفصاحة والحل","م وحسن الأخلاق والأفعال",90,"ل",1,0],["جامعُ الفكرِ شاسع الذِّكْر يَقْظا","ن إذَا الفَسل بالجهالةِ ناما",91,"م",2,0],["جَامِحَاتٍ على الأعنةِ تَنْزُو","صَعْبَةً وهي سَمْحَةٌ في القِيَادِ",92,"د",1,0],["جام يدور ومزهر نسلو به","وزهور ورد غضّة وبنفسج",93,"ج",1,0],["جامع الاموي حاوي العابدين","في دياجي الليل والناس نيام",94,"م",1,0],["جامعٌ ذو الجلال والإكرامِ","كلَّ خيرٍ فاجمع لنا يا مجيبُ",95,"ب",1,0],["جامعا بين ملك طمغاج في الشر","ق ومراكس الطويل مطالا",96,"ل",2,0],["جامع الخيل للرجال ومخلي","من جموع الضراغم ألا جاما",97,"م",2,0],["جاموسَتي يا ساحِرَه","جوبي الحُقولَ الناضِرَه",98,"ه",1,0],["جامِحاتٍ تُغِيرُ بَينَ الجُنودِ","فَيُوافي ذِيُومِذٌ بالحَديدِ",99,"د",1,0],["جامع الشمل مذ عرفناه حيَّاً","وعلى قبره التقى الخُصَماء",100,"ا",2,0],["جامع الذكر في المصاحف ذى النو","رين شيخ الاحسان كهف الحياء",101,"ا",2,0],["جامع الخير مانع الضير كهف","الأمن من مولى العفاة منا ونحجا",102,"ح",3,0],["جامع الفرق أمام الجمع في","جامع العلم النزيه الأطهر",103,"ر",1,0],["جامعُ الشّمْلِ بعدَ طولِ الفراقِ","للمحبيّن كافلٌ بالتلاقِ",104,"ق",1,1],["جامِعِ العَلمَينِ وَهوَ ابنُ أَبي","بَكرٍ الحاوي الجَلالَ القُرَشي",105,"ي",1,0],["جامُ الأماني بالصفا قد دارا","شمس التهاني أسفرت أستارا",106,"ر",2,1],["جامِحاتٍ أَعيَت عَلى الدين كَبحاً","رَغم إِنذارِها بِسوءِ المَصيرِ",107,"ر",1,0],["جامعا للتاريخ إن عد يوما","مثل عد المسكوك من ابريز",108,"ز",1,0],["جامعٌ للرموزِ قد حازه الغر","وهو السيد الشريفُ الثاني",109,"ي",1,1],["جامه ات رابخوا ندجون برجيس","منبرش كشت بايه بله بست",110,"ت",1,0],["جامع فخر ليس في مجمع","حتى إذ