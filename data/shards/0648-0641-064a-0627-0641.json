{"poems":[[139,"بظلك كل شخص يستقيل","https://www.aldiwan.net/poem49110.html","الوافر"],[275,"سلام أيها الدير القديم","https://www.aldiwan.net/poem35238.html","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87105","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87182","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69349","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93737","الهزج"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65451","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62813","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120457","الوافر"],[4958,"الشيءْ ..","https://www.poetsgate.com/ViewPoem.aspx?id=53952",""],[4978,"تشطير وطني","https://www.poetsgate.com/ViewPoem.aspx?id=177411",""],[5277,"يا أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=187773",""],[5533,"كَنَفُ القَوافِي","https://www.poetsgate.com/ViewPoem.aspx?id=176741",""],[5542,"غدا يتحدث الرطب","https://www.poetsgate.com/ViewPoem.aspx?id=10030",""],[6102,"قَبِّليني","https://www.poetsgate.com/ViewPoem.aspx?id=184635",""],[5190,"على بُعدِ شاطئين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85032&r=&rc=107",""]],"verses":[["وفي أفق الوفاء رقيت أوجاً","يعزّ على سواك له وصول",0,"ل",1,0],["وفي آفاقِكَ ازدَحَمت غيومٌ","وفي الوادي طغى سَيلٌ عظيم",1,"م",1,0],["وَفي أَفراحه عَمّا قَليل","سُرور لا يُغادره نَعيم",2,"م",1,0],["وَفي أُفق التقدّم قَد أَضاءَت","بِهِ شَمس المَعارف وَالبَيان",3,"ن",1,0],["وفي أفق علياه تراءوا كأنجم","أحاط بها البدر المنير المتمم",4,"م",1,0],["وَفَيافي النَبِيِّ مِن دونِها الغُب","رُ وَمَوماةُ أَرضِها التَيهاءُ",5,"ا",2,0],["وَفي أَفكاركم أَظهَ","ر للإسلام خافيها",6,"ي",3,0],["وفي أفقها العذراءُ لمّا بدا بدت","ونادى العلى أرّخ له الطّالعُ العذرا",7,"ر",2,0],["وفي أفقِ الدبرينِ منها غَمامةٌ","بوارِقُها مشبوبةٌ ورعودُها",8,"د",3,0],["وفي افعاله للدين عز","ومن اقواله الدنيا تزان",9,"ن",1,0],["وفي أُفُقي انْبِعاثٌ وارْتِدادٌ","وَمَزْجٌ والْتِحامٌ وانْشِطارُ",10,"ر",1,0],["(وفي أفواهنا غصص وكبتٌ )","وملء عيوننا هذاا العَذابُ",11,"ب",1,0],["وفيٌّ أفيك العهدَ والوعدَ صادقا","وأعطي الذي أهواه ماكان يطلبُ",12,"ب",1,0],["وفي أَفْيَائِهِ يَزْهُو نَشِيْدي","وأَرْوِي خَافِقي بَعْدَ الجَفَافِ",13,"ف",1,0],["وفي أفكارها خلل","على الإيمان ينسحب",14,"ب",1,0],["وَفَيافِيَّ بَعدَما دَبَّ فِيها","بِخُطَى اليَأسِ- سُوءُ حَظِّيَ- تَخضَرْ",15,"ر",1,0],["وفِي أُفْقِهِ المُندَاحِ تَلهُو نَوَارِسٌ","يُقَرِّبها مَدٌّ ، ويُبعِدُها جَزْرُ",16,"ر",1,0]]}