ttps://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81282","الخفيف"],[5136,"ومهاة ذات صد وملل","https://www.poetsgate.com/ViewPoem.aspx?id=121643",""],[5392,".. للقافياتِ عيون","https://www.poetsgate.com/ViewPoem.aspx?id=132112",""],[5409,"أتراهم من وحشةِ الأرض طاروا","https://www.poetsgate.com/ViewPoem.aspx?id=155269",""],[5848,"اطيب قلب","https://www.poetsgate.com/ViewPoem.aspx?id=53168",""],[5910,"حيِّ قبرًا بجانبِ الآكامِ","https://www.poetsgate.com/ViewPoem.aspx?id=207124",""],[5939,"ظامئٌ لارتشافِكِ شِعري","https://www.poetsgate.com/ViewPoem.aspx?id=178620",""],[6056,"ساعة الصبر","https://www.poetsgate.com/ViewPoem.aspx?id=130358",""],[6102,"فرادة","https://www.poetsgate.com/ViewPoem.aspx?id=184552",""],[6102,"هبط الليل","https://www.poetsgate.com/ViewPoem.aspx?id=185296",""],[6218,"آن للصبر يغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65868&r=&rc=22",""]],"verses":[["كَيْفَ قُوِّضْتَ يَا عَلَمْ","وَانْطَوَى ذَلِكَ العَلَمْ",0,"م",1,1],["كَيْفَ قَصْدُ الْجَوَادِ وَالْجُودُ طَبْعٌ","كَيْفَ إِثْرَاءُ ذِي الضَّمِيرِ الْقَوِيمِ",1,"م",1,0],["كيف قد حاولوا اغتيالك غدرا","خاب من دسّهم إليك وأغرى",2,"ر",2,1],["كيفَ قاسوا قدَّ الحبيب بغصنٍ","ذاك يجنى وذا على الناسِ يجني",3,"ن",2,1],["كيف قلتُ الفصيح في فاحش العُج","مةِ كالطَمْطَميِّ من بَدْليس",4,"س",1,0],["كيفَ قابَلتَها أَرَتْكَ رِياضاً","وسَماءً مُخْضَرَّةَ الآفاقِ",5,"ق",1,0],["كَيفَ قَد أَقفَرَت وَحارَ بِها الدَه","رُ وَغَنّى الجِنانَ فيها البومُ",6,"م",1,0],["كيفَ قارنتَ منه بَدراً تماماً","وله منكَ جَوزَهِرُّ الكسوف",7,"ف",1,0],["كيف قلبي عنه اصرفه","وهواه غير منصرف",8,"ف",1,0],["كيف قد ألفته وهي شتيت","بين دان من الشقوق وناء",9,"ا",2,0],["كَيفَ قوَّضتُم بِناءَ القَضاءِ","في سَبيلِ النجاةِ بِالحَسناءِ",10,"ا",2,1],["كيف قامت بلا عماد وفكر","في معاني ديباجها المنقوش",11,"ش",1,0],["كيف قريت ضيفك الأزبا","لما أتاك بائساً قرشبا",12,"ب",2,1],["كيف قد غاله الردى","فجأة غادرا وفر",13,"ر",1,0],["كَيف قدّرتَ أنّنِي من أُناسٍ","قُدْتَهمْ نحو حَيْنِهمْ باِختداعِ",14,"ع",1,0],["كَيْفَ قَاسُوا نَدى يَديْهِ بِمَرّ الرّ","يح جَرْياً ولِلرِّيَاحِ رُكُودُ",15,"د",1,0],["كَيفَ قرَّت في فقد ممسكها الا","رض وقد آن بعده أَن تمورا",16,"ر",2,0],["كيفَ قُلْ لي عَن الهَوى يَتَسَلَّى","مَنْ حَشاهُ بِوَجْدِهِ يَتَصَلَّى",17,"ل",2,0],["كيفَ قَراري ولا سبيلَ إِلى الصَّ","بْرِ ولا في اللِّقاءِ لِي مَطْمَعْ",18,"ع",1,0],["كيف قد بدلت ما قلت به","فالحصى ليس يحاكي الدررا",19,"ر",2,0],["كيف قرت ولا تزلزل أرض","أنت تلقى شلواً على أرجاها",20,"ا",3,0],["كيف قلبي عن اللقا يتسلى","وينار من الجوى يتسلى",21,"ل",2,1],["كيف قام النطاق بالخصر منه","هل يقوم الموجود بالمعدوم",22,"م",1,0],["كيف قل لم تخف فجئت إلى الفل","ك وحيداً لمن بنيك انتابا",23,"ب",2,0],["كيف قلتُمْ ما عندَ عينيْه ثارُ","وبخدَّيْه من دمي آثارُ",24,"ر",1,1],["كيفَ قُلتم في مقلتيهِ فتورُ","وأَراها بلا فتورٍ تجورُ",25,"ر",1,0],["كيف قد غادرتني يا ذا الحُمام","نائحاً عمري كما ناح الحمام",26,"م",1,0],["كَيفَ قُولوا بِجانب النيل شَط","يه وَيَجري عَلى شواطئ أُخرى",27,"ر",2,0],["كيف قد أنكرته قالت لها","لست أدري ما به الدهر فعل",28,"ل",1,0],["كيفَ قولٌ إلى فتى للغواني","والغواني .. لقافياتي عُيونُ ؟",29,"ن",1,0],["كيف قد أصبحوا خفافاً على الري","ح وقد أثقلتهم الأوزار",30,"ر",1,0],["كيف قلبك ما التفت لي ؟ وكيف الحب هان ؟","يوم تتركني على الدرب في يدين الطعون",31,"ن",1,0],["كيف قاد الرَّدى أبي اليوم عنَّا","كيف أمسيتَ دوننا للحِمامِ",32,"م",1,0],["كيفَ قد يُصبحُ العِطرُ نارًا","مِن جَوَى زَهرةٍ أَتضوّأْ؟",33,"ا",1,0],["كيف قلبك على هجران خلك ضرى","صارمثل الحجرفي قسوته الطبوع",34,"ع",1,0],["كَيفَ قَدَّرتِ أَنَّهُم بُدَلائِي؟!","وَبِأَنِّي بِمِثلِ ذَلِكِ أَقبَلْ؟!",35,"ل",1,0],["كَيفَ ؟ قُولِي بِرَبِّكِ - اللَّهِ - هَاجَتْ","نَصْلَةُ الغَدْرِ , إِذْ طَعَنْتِ عَيَانا ؟",36,"ن",2,0],["كيف قلبٌ بغير نبضٍ يغني","كيف طفلٌ بلا يدين سيلعبْ",37,"ب",1,0]]}