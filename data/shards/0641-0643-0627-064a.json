{"poems":[[32,"خليلي عوجا اليوم حتى تسلما","https://www.aldiwan.net/poem29528.html","الطويل"],[32,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[4,"أعاذل قومي فاعذلي الآن أو ذري","https://www.aldiwan.net/poem21164.html","الطويل"],[23,"على قتلى معونة فاستهلي","https://www.aldiwan.net/poem21358.html","الوافر"],[31,"ما زال ألسنة الناطقين","https://www.aldiwan.net/poem6122.html","المتقارب"],[40,"أفي أثر الأظعان عينك تلمح","https://www.aldiwan.net/poem7695.html","الطويل"],[40,"ألا يا اسلمي حييت أخت بني بكر","https://www.aldiwan.net/poem7715.html","الطويل"],[40,"ألم يسأل الركب الديار العوافيا","https://www.aldiwan.net/poem7821.html","الطويل"],[64,"أفنى الليالي شبابي","https://www.aldiwan.net/poem52489.html","المجتث"],[47,"تذكر محزونا وأنى له الذكرى","https://www.aldiwan.net/poem10214.html","الطويل"],[47,"نبر على تباعدنا فنجفى","https://www.aldiwan.net/poem10909.html","الوافر"],[47,"سقيت الغوادي من طلول وأربع","https://www.aldiwan.net/poem64652.html","الطويل"],[47,"أكنت معنفي يوم الرحيل","https://www.aldiwan.net/poem65576.html","الرمل"],[30,"تقول ابنة الغوثي ما لك ههنا","https://www.aldiwan.net/poem1290.html",""],[30,"نحن أرينا الباهلية ما شفت","https://www.aldiwan.net/poem5346.html","الطويل"],[46,"أيا ويل الشجي من الخلي","https://www.aldiwan.net/poem30326.html","الوافر"],[48,"جمجم هذا الزمان قولا","https://www.aldiwan.net/poem23484.html","مجزوء البسيط"],[70,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[173,"ألا رحلت نعم وأقفر نعمان","https://www.aldiwan.net/poem1683.html",""],[211,"تقطع باقي وصل أم مؤمل","https://www.aldiwan.net/poem27930.html","الطويل"],[240,"سقى منزلا بين الشقيقة والضال","https://www.aldiwan.net/poem31772.html","الطويل"],[266,"هو الدهر يستثني المخلوف بالأمن","https://www.aldiwan.net/poem38170.html","الطويل"],[285,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63936","الهزج"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26671","الطويل"],[2188,"","https://poetry.dctabudhabi.ae/diwan/poem/20908","الطويل"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28059","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75946","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100824","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59463","الوافر"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69246","الطويل"],[4666,"","https://poetry.dctabudhabi.ae/diwan/poem/198799","الكامل"]],"verses":[["فَكائِن نَضَت مِن جَوزِ رَملٍ وَجاوَزَت","إِلَيكَ المَهارى مِن رِعانِ المَخارِمِ",0,"م",1,0],["فَكائِن تَرى مِن رَشدَةٍ في كَريهَةٍ","وَمِن غَيَّةٍ تُلقى عَلَيها الشَراشِرُ",1,"ر",1,0],["فَكائِن رَأَيتُ مِن بَهاءٍ وَمَنظَرٍ","وَمِفتَحِ قَيدٍ لِلأَسيرِ المُكَفَّرِ",2,"ر",1,0],["فَكائِن قَد أُصيبَ غَداةَ ذاكُم","مِنِ اِبيَضَ ماجِدٍ مِن سِرِّ عَمروِ",3,"ر",2,0],["فَكائِن تَرى مِن ذُكورِ السُيوفِ","يُطِرنَ قَمَحدُوَةً أَو جَبينا",4,"ن",2,0],["فَكائِن تَرى في القَومِ مِن مُتَقَنِّعٍ","عَلى عَبرَةٍ كادَت بِها العَينُ تَسفَحُ",5,"ح",1,0],["فَكائِن رَأَيتِ مِن حَميمٍ تَجُرُّهُ","صُدورُ العَوالي وَالجِيادُ بِنا تَجري",6,"ر",2,0],["فَكائِن تَرى مِن مُسعِفٍ بِمَنِيَّةٍ","يُجَنَّبُها أَو مُعصَمٍ لَيسَ ناجِيا",7,"ي",2,0],["فكايدتْهُ الليالي","في وَكْرهِ بالخرابِ",8,"ب",1,0],["فَكائِن لَهُ مِن ضَربَةٍ بَعدَ طَعنَةٍ","وَقَتلى إِلى جَنبِ الثَنِيَّةِ أَو أَسرى",9,"ر",2,0],["فَكائِن فيكَ مِن خُلُقٍ لَئيمٍ","تَكَرَّمُ أَو تَعاطاهُ الكِلابُ",10,"ب",1,0],["فَكائِن لَنا بَعدَ النَوى مِن تَفَرُّقٍ","تُزَجّيهِ أَحلامُ الكَرى وَتَجَمُّعِ",11,"ع",1,0],["فَكائِن فُضَّ مِن دَمعٍ غَزيرٍ","وَأُضرِمَ مِن جَوى كَمَدٍ دَخيلِ",12,"ل",1,0],["فَكائِن تَخَطَّت مِن فَساطيطِ عامِلٍ","إِلَيكَ وَمِن خَرقٍ تَعاوى ثَعالِبُه",13,"ب",2,0],["فَكائِن بِقَندابيلَ مِن جَسَدٍ لَهُم","وَبِالعَقرِ مِن رَأسٍ يُدَهدى وَمِرفَقِ",14,"ق",1,0],["فَكائِن فيهِ مِن مَعنىً خَطيرٍ","وَكائِن فيهِ مِن لَفظٍ بَهِيِّ",15,"ي",1,0],["فَكائِنٌ فاسِدٌ لِأَمرٍ","وَرَبُّهُ مُفسِدٌ كِيانَه",16,"ن",2,0],["فكَأَيٍّ منْ أسىً أعيا الإِسا","نال لو يعِنيهِ قَولي وكأي",17,"ي",1,0],["فَكائِن لَهُ مِن نِعمَةٍ بَعدَ نِعمَةٍ","عَلَيكُم وَإِحسانٍ يُوالِيهِ إِحسانُ",18,"ن",1,0],["فَكائِن تَرَكنا مِن قَتيلٍ مُلَحَّبٍ","وَأَرمَلَةٍ تَدعو عَلى بَعلِها لَهفا",19,"ف",2,0],["فَكائِن لَنا مِن وَقفَةٍ في ظِلالِهِ","وَمِن غَدَواتٍ موبِقاتٍ وَآصالِ",20,"ل",1,0],["فكايلته صاعاً بصاع موفيا","وما منكم من يدعى ردة الغين",21,"ن",1,0],["فَكائِنْ مَحا بِنَداهُ الْعُفاةُ","ذُنُوبَ الزَّمانِ وَكَمْ مَحَّصُوا",22,"ص",3,0],["فكائن ثَمَّ من مُسْتَأ","ثِرٍ بالحُسْنِ مُخْتَصِّ",23,"ص",1,0],["فكايَلَهُ صاعَ المودّة وافياً","وكلُّ مُثيبٍ بالوفاءِ مثاب",24,"ب",1,0],["فَكائِن تَرى مِن ماجِدٍ وَاِبنِ ماجِدٍ","بِهِ طَعنَةٌ نَجلاءُ لِلوَجهِ تَشهَقُ",25,"ق",1,0],["فَكائِنُ جَزَعنا مِن سَنيحٍ وَبارِحٍ","إِلَيها وَأَفواهُ الأَشاحيجِ تَنعَبُ",26,"ب",1,0],["فَكائن بِهِ مِن آهبٍ قَد تَمَزَّقَت","وَشِلوِ لجام ماتَ مَن هُوَ ناهِسُه",27,"س",2,0],["فكائن رأيت الخمر يحلو وذا فمي","على فمها يحسو الرحيق المشعشعا",28,"ع",2,0],["فكائن جُبتُ نحوكِ من فَلاةٍ","ورملٍ مثل أوراكِ العَذارى",29,"ر",2,0],["فَكائِن تَرى مِن مُكرِهِ العدوٍ مُسمِنٍ","تَحَمَّمَ حِنوَ السَرجِ حَتّى تَجنَبّا",30,"ب",2,0],["فكأي مجد ذا المزين عرشه","إن الجمان بعرش زايد أليق",31,"ق",1,0]]}