abudhabi.ae/diwan/poem/85372","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39584","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30463","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30464","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9873","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9960","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20998","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54516","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54837","الكامل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23852","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54244","الكامل"],[106,"تحية وتقدير","https://www.poetsgate.com/ViewPoem.aspx?id=179700",""],[106,"خيال في يقظة","https://www.poetsgate.com/ViewPoem.aspx?id=179676",""],[106,"في مهرجان دار العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=179366",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[106,"حي البيان","https://www.poetsgate.com/ViewPoem.aspx?id=179367",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[66,"كن عن همومك معرضاً","https://www.poetsgate.com/ViewPoem.aspx?id=178182",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[90,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[90,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[90,"ليلة معها","https://www.poetsgate.com/ViewPoem.aspx?id=179141",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[45,"رَحَلَتْ ، وأَوْدَعَتِ الفُؤَادَ لَوَاحِظاً","https://www.poetsgate.com/ViewPoem.aspx?id=31700",""],[46,"أمتارُ من هذا الأنامِ، وكيفَ لي،","https://www.poetsgate.com/ViewPoem.aspx?id=20120",""],[51,"يا منْ سكونُ النفس في تأميلهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30331",""],[51,"لازلْتَ تفخمُ والثناءُ ضئيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=30333",""],[51,"لا تَلْحَ مَنْ يبكي شبيبته","https://www.poetsgate.com/ViewPoem.aspx?id=25857",""]],"verses":[["وَلَرُبَّ قِرنٍ فاتَ أَطرافَ القَنا","حَتّى أَخَذتَ عَلَيهِ بِالأَقلامِ",0,"م",1,0],["وَلَرُبَّ فاعِلِ فِعلَةٍ لا تَنثَني","لَو رامَ رَجعَتَها بِكُلِّ مَرامِ",0,"م",1,0],["وَلَرُبَّ مَصحوبٍ شَرِقتُ بَلُؤمِهِ","فَلَفَظتُهُ قَبلَ الإِساغَةِ عاجِلا",1,"ل",2,0],["وَلَرُبَّما بُكِيَ الفَقيدُ لِنَفسِهِ","أَو لِلمَطامِعِ فيهِ وَالتَأميلِ",2,"ل",1,0],["وَلَرُبَّما اِبتَسَمَ الفَتى وَفُؤادُهُ","شَرِقُ الجَنانِ بِرَنَّةٍ وَعَويلِ",2,"ل",1,0],["وَلَرُبَّما اِحتَمَلَ اللَبيبُ مُمَوِّهاً","عَضَّ الزَمانِ بِبِشرِهِ المَبذولِ",2,"ل",1,0],["وَلَرُبَّ يَومٍ قَد مَلَأتَ فُروجَهُ","خَيلاً تَدَرَّعُ بِالغُبارِ وَتُرقِلُ",3,"ل",1,0],["وَلَرُبَّ مَولىً لا يَغُضُّ جِماحَهُ","طولُ العِتابِ وَلا عَناءُ العُذَّلِ",4,"ل",1,0],["وَلَرُبَّ مَجهولٍ رَكائِبُهُ","خَلفَ الرِياحِ الهوجِ تَخرُقُهُ",5,"ق",2,0],["وَلَرُبَّ وِردٍ بِتَّ قارِبَهُ","لا يَطمَئِنُّ بِهِ تَدَفُّقُهُ",5,"ق",2,0],["وَلَرُبَّ يَومٍ شِمتَ بارِقَهُ","وَالمَوتُ يُهطِلُهُ وَيودِقُهُ",5,"ق",2,0],["وَلَرُبَّ يَومٍ هاجَ مِن طَرَبي","وَلَقَد يَضيقُ بِغيرِهِ ذَرعي",6,"ي",1,1],["وَلَرُبَّ أَصغَرَ عاقِدٍ عِرنينَهُ","أَمسى لَهُ في الأَرضِ خَدٌّ أَضرَعُ",7,"ع",1,0],["وَلَرُبَّ مُنذَلِقٍ تَمَنطَقَ سَيفَهُ","بِنَجيعِ كُلِّ مُمَنطَقٍ وَمُسَوَّرِ",8,"ر",1,0],["وَلَرُبَّ رَوعٍ رُعتُهُ بِفَوارِسٍ","قَلَبوا صُدورَ رِماحِهِم لِلأَظهُرِ",8,"ر",1,0],["وَلَرُبَّما رُزِقَ الغِنى","رَبُّ الشُوَيهَةِ وَالبَعيرِ",9,"ر",1,0],["وَلَرُبَّ مَصحوبٍ غَرِضتُ بِهِ","غَرَضَ الخَوامِسِ مِن قَذى الوِردِ",10,"د",1,0],["وَلَرُبَّ لَيلٍ قَد طَوَيتَ رِداءَهُ","وَعَلى الإِكامِ مِنَ الظَلامِ جَلابِبُ",11,"ب",1,0],["ولَرُبَّما غَطَّ البِكارُ وإنّما","رفَعَ الهَديرَ بهِ الفَنيقُ المُقْرَمُ",12,"م",1,0],["وَلَرُبَّ مُشعِلَةٍ وَزَعتُ رِعالَه","بِمُقَلَّصٍ نَهدِ المَراكِلِ هَيكَلِ",13,"ل",1,0],["وَلَرُبَّما عَثَرَ الجَوادُ بِفارِسٍ","وَيَخالُ أَنَّ جَوادَهُ لَم يَعثُرِ",14,"ر",1,0],["وَلَرُبَّ قِرنٍ قَد تَرَكتُ مُجَدَّل","وَلَبانُهُ كَنَواضِحِ الجِريالِ",15,"ل",1,0],["وَلَرُبَّ خَيلٍ قَد وَزَعتُ رَعيلَه","بِأَقَبَّ لا ضِغنٍ وَلا مِجفالِ",15,"ل",1,0],["وَلَرُبَّ شَربٍ قَد صَبَحتُ مَدامَةً","لَيسوا بِأَنكاسٍ وَلا أَوغالِ",15,"ل",1,0],["وَلَرُبَّ نازِلَةٍ يَضيقُ لَها الفَتى","ذَرعاً وَعِندَ اللَهِ مِنها المَخرَجُ",16,"ج",1,1],["ولَرُبَّ زُرْقِ عِدىً لَقيتُ مُواجِهاً","كفّتْ أكُفُّهمْ وقايَةُ واقِي",17,"ي",1,1],["وَلَرُبَّ مُعْتَادِ السِّفارِ رَمَتْ بِهِ","أَيْدِي الرِّكَابِ نَوَازِحَ الْبُلْدَانِ",18,"ن",1,0],["وَلِربّنا الرُّجْعَى وَإِنْ طَالَ الْمَدَى","وَاللهُ نِعْمَ الْمُرْتَجَى وَالْمُؤَمَلُ",19,"ل",1,0],["ولَرُبَّ رَكْبٍ أُعمِلَتْ لمَزارِها","أقْتادُهُ واستوْثَرَتْ أكْوارُهُ",20,"ر",2,0],["وَلَرُبَّ حُرٍّ عابَهُ نَفَرٌ","لا يَصلُحونَ لِنَعلِهِ شِسعا",21,"ع",2,0],["وَلَرُبَّما ضَنَّ الفَقيرُ بِقوتِهِ","وَسَخا بِمُهجَتِهِ عَلى مَن يَغصِبُ",22,"ب",1,0],["وَلَرُبَّ مُنبَتٍّ وَصَلتَ بِصَحبِهِ","وَطَريقُهُ لِخَفائِهِ قَد أَغمَضا",23,"ض",2,0],["وَلَرُبَّ مَلهوفٍ دَعاهُ لِحادِثٍ","جَلَلٍ فَكانَ جَوابُهُ قَبلَ الصَدى",24,"د",2,0],["وَلَرُبَّ لائِمَةٍ عَلَيَّ حَريصَةٍ","باتَت وَقَد جَمَعَت عَلَيَّ العُذَّلا",25,"ل",2,0],["وَلَرُبَّمَا عَجَزَتْ بَلاغَاتُ الوَرَى","عَمَّا يَخُطُّ هُدًى طِفْلانِ",26,"ن",1,0],["ولربما أشجى فؤادي عنده","ورقاءُ تَنْفُثُ شجوها بترنُمِ",27,"م",1,0],["ولربَّ لمّاعِ الصّقال مشهّرٌ","ماضٍ ولنْ فعلُهُ مستقبلُ",28,"ل",1,0],["ولرُبَّ روضٍ للقنا متأوّدٍ","ناب الصهيل به عن الأطيارِ",29,"ر",1,0],["وَلَرُبَّ ممتدِّ الأباطح موحش","عالي الربى متباعد الأقطارِ",30,"ر",1,0],["ولربَ مُرْبَدِّ الجوانح مزبدٍ","سبح الهلالُ بلُجّهِ الزخّار",31,"ر",1,0],["ولرُبَّ ليلٍ بالوصالِ قطعْتُهُ","أجلو دجاهُ بأوجهِ الندمَاءِ",32,"ا",2,0],["ولربما سقطت فقام حيالها","للضرب عبل الساعدَين همام",33,"م",1,0],["ولَرُبّ ذئب قد أتا","ك من ابن آدم في اهابه",34,"ب",2,0],["ولربّ قافية كمُئتِلق السنى","يجلو الشكوك يقينها الممحوض",35,"ض",1,0],["ولربّما أنتَجْن كل كريهة","سوداء تَقنأ في وغاها البيض",35,"ض",1,0],["ولربما كانت سلاحاً نافذاً","عند اللئام دسائس ومكايد",36,"د",1,0],["ولربّ خافيه يكتّمها الفتى","والوجه منه بسرّها يتكلم",37,"م",1,0],["ولرب وجه في تبسّمه البكا","ولرب وجه في بكاء تبسّم",37,"م",1,0],["ولربّ وجه يستبيك بحسنه","فتروح منه وأنت صبّ مغرم",37,"م",1,0],["وَلَرُبَّ فِعلٍ جاءَني مِن فاعِلٍ","أَحمَدتُهُ وَذَمَمتُ مَن يَأتي بِهِ",38,"ه",1,0],["ولرُبَّ ليلٍ في الهمومِ كدمل","صابرته حتَّى ظفرت بفجرِه",39,"ر",2,0],["ولربَّما يجني الزمان على امرئٍ","مجنى ويا عجباً حلاوة صبرِه",39,"ر",2,0],["ولربَّما أصبحت قاضي معشرٍ","فاصْبر على حلو الزمان ومرِّه",39,"ر",2,0],["ولرُبَّ ليلٍ قد عطفتُ وما انْتشى","فيه قوامكِ يا سعاد وما ارْتشى",40,"ش",2,0],["ولربَّ ذي عذلٍ إذا بلَّ البكى","رُدْنيّ باكر مسمعي بنشاف",41,"ف",1,0],["ولربَّ وردٍ عفته لتدلكٍ","ولو أنه نهر المجرَّة طاف",41,"ف",1,0],["ولربَّما عطفت وغصن قوامها","بالحلي أثمر والذوائب أورقا",42,"ق",2,0],["ولرُبما أهوى بكأس مدامة","لولاه ما حملت يدي جرياً لها",43,"ل",3,0],["ولربَّما منح الرضا واليوم لا","وأبيكَ مالكه ولا رضوانه",44,"ن",2,0],["ولراجيكَ قبلها كلماتٌ","هُذِّبتْ فيك أَيَّما تهذيبِ",45,"ب",1,0],["ولربما كان انتصا","بُ المرءِ للفعل انكبابهْ",46,"ب",2,0],["ولرُبَّ مثلك قد أطَلْ","تُ على خطيئته انتحابهْ",46,"ب",2,0],["ولربما امتَحَنَ الوليُّ وليَّهُ","ليرى له جَلَداً يغيظ الحُسَّدا",47,"د",2,0],["ولربُّ مقسوطٍ عليه بغرَّةٍ","حَلَّتْ بليَّتُهُ برأس القاسِطِ",48,"ط",1,0],["ولربما عدلت عليك صروفه","فأصابك المأمول والمتخوف",49,"ف",1,0],["ولربَّ شِمّيرٍ يُجَر","رُ بعقْبهِ الذيلُ الرّفلُّ",50,"ل",1,0],["ولرُبَّ مرجوّ سواك مُؤمَّل","ألفاه راجيهِ عليك محيلا",51,"ل",2,0],["ولربما جُنَّتْ لها","فترى عواليها سوافلْ",52,"ل",1,0],["ولربَّ عيبٍ قد تَبَيْ","يَنَ بالشواهدِ والدلائلْ",52,"ل",1,0],["ولراحتيك بداءةٌ وعُوادةٌ","وليومِ عُرفك بكرةٌ وأصيلُ",53,"ل",1,0],["ولربّ شيءٍ ذي محاسنَ جمَّة","وله مقابحُ إن أُديم تأمُّلُ",54,"ل",1,0],["ولربما شقي الفتى بجوداه","ولربما حظي الفتى بنخيلِهِ",55,"ل",2,0],["ولرُبَّ شيءٍ لا يُبَيِّنُهُ","وجدانُهُ إلّا معَ العدمِ",56,"م",1,0],["ولربما اختُطفا جميعاً خطفة","والدهرُ أخطفُ ما تراه مُحاجنا",57,"ن",2,0],["وَلَرُبَّ قائِلَةٍ تُعاتُبُني عَلى","صَمتي وَبَعضُ القَولِ حَزُّ مَواسي",58,"ي",1,0],["وَلَرُبَّما اِلتَبَسَت حَوادِثُ يَومِهِ","بِالغابِرِ الماضي وَبِالمُتَقَّعِ",59,"ع",1,0],["وَلَرُبَّما كَرِهَ الجُمودَ وَإِنَّما","صَعبٌ عَلى الإِنسانِ أَن يَتَخَلَّقا",60,"ق",2,0],["وَلَرُبَّما جَبَلٌ أُشَبِّهُهُ بِهِ","مُستَرسِلاً مَعَ رَوعَةِ التَشبيهِ",61,"ي",2,0],["وَلَرُبَّما صَيَّرتُهُ","غَزَلاً يُكَفِّرُهُ مَديحُه",62,"ح",2,0],["ولرُبَّما شاقَ الرَّدى الدَّاجي","وأعماقُ المنونْ",63,"ن",1,0],["وَلَرُبَّما سَلَّت لَنا مِن مائِها","سَيفاً وَكانَ عَنِ النَواظِر مُغمَدا",64,"د",2,1],["ولرب فاتنة العيو","ب لحاظها تحكي الحرابا",65,"ب",2,0],["ولربما اطرى افاعيلا له","كانت اذا استقرأتها آثاما",66,"م",2,0],["ولرب حرب تختفي ابطالها","تحت الستار ولا تثير قتاما",66,"م",2,0],["ولرب امر ليس يعرف ماله","من قيمة الا لدى فقدانه",67,"ن",2,0],["ولربما ابعدت في دلج الهوى","والليل ساج والكواكب ترعف",68,"ف",1,0],["ولرب امر جئته بجهالة","واليوم من ندم لسني اقرع",69,"ع",1,0],["ولرب فرد يوم تدعو","الحرب أكثر من ألوف",70,"ف",1,0],["ولربما حليتها بقصائدى","وجعلت أبيات الخلود وعاءها",71,"ا",3,0],["ولرأسك العالى تناثر لبه","ونزا وصار نسيجه لفساد",72,"د",1,0],["ولربما عقدا نِجادا للعصا","والصارم الماضي بغير نجاد",72,"د",1,0],["وَلَرُبَّما قَتَلَ الغَرامُ رِجالَها","قُتِلَ الغَرامُ كَمِ اِستَباحَ قَتيلا",73,"ل",2,0],["وَلَرُبَّ أَعراسٍ خَبَأنَ مَأتَماً","كَالرُقطِ في ظِلِّ الرِياضِ تَقيلُ",74,"ل",1,0],["وَلَرُبَّ بُؤسٍ في الحَياةِ مُقَنَّعٍ","أَربى عَلى بُؤسٍ بِغَيرِ قِناعِ",75,"ع",1,0],["وَلَرُبَّما حَسَدَت عَلَيكَ مَكانَها","تِربٌ تَمَسَّحُ بِالعَروسِ وَتُحدِقُ",76,"ق",1,0],["وَلَرُبَّ تَعليمٍ سَرى","بِالنَشءِ كَالمَرَضِ المُنيمِ",77,"م",1,0],["وَلِروما المُلكُ الَّذي طالَما وا","فاهُ في السِرِّ نُصحُها وَالوَلاءُ",78,"ا",2,0],["وَلَرُبَّما أَطَرَ القَناةَ بِفارِسٍ","وَثَنى فَقَوَّمَها بِآخَرَ مِنهُمُ",79,"م",1,0],["وَلَرُبَّما طَعَنَ الفَتى أَقرانَهُ","بِالرَأيِ قَبلَ تَطاعُنِ الأَقرانِ",80,"ن",1,0],["ولربما كانَ الحياةُ عقوبةً","حتى يعذَّبَ بالبقاءِ شقيُّهُ",81,"ي",2,0],["ولَربَّما نالَ المُرادَ مرفَّهٌ","لم يَسْعَ فيه وخابَ سَعْيُ الجاهدِ",82,"د",1,0],["ولَربَّما رَضِيَ العدوُّ إِذا رأى","منك الجميلَ فصار غيرَ معاندِ",83,"د",1,0],["ولربما انتفع الفتى بعدوّهِ","والسّمُ أحياناً يكون دواءَ",84,"ا",2,0],["وَلَرُبَّ مُغرٍ لي بِعِرضِكَ زادَني","غَيظاً بِجَيئَةِ قَولِهِ وَذَهابِهِ",85,"ب",2,0],["وَلَرُبَّما كانَ الزَمانُ مُحَبَّباً","فينا بِمَن فيهِ مِنَ الأَحبابِ",86,"ب",1,0],["وَلَرُبَّ عَيشٍ قَد تَبَسَّمَ ضاحِكاً","عَن طُرَّتي زَمَنٍ بِهِنَّ مُدَبَّجِ",87,"ج",1,0],["وَلَرُبَّ خَرقٍ لا يُمارَسُ هَولُهُ","خَرَّقتُ فيهِ دُجى اللَيالي السودِ",88,"د",1,0],["وَلَرُبَّما نَجّى الفَتى مِن هَمِّهِ","وَخدُ القِلاصِ وَلَيلُهُنَّ الدامِسُ",89,"س",1,0],["وَلَرُبَّ لَهوٍ قَد أَشادَ بِهِ","مُصطافُ ذي سَلَمٍ وَمُرتَبَعُه",90,"ع",2,0],["وَلَرُبَّما كانَ الكَرى سَبَباً لَنا","بَعدَ الفِراقِ إِلى اللِقاءِ فَنَلتَقي",91,"ق",2,0],["وَلَرُبَّ جيدٍ واضِحٍ زُرنا بِها","وَمُقَبَّلٍ عَذبٍ وَطَرفٍ أَكحَلِ",92,"ل",1,0],["وَلَرُبَّ رُتبَةِ سُؤدَدٍ شَفَعَت بِهِ","مِن قَبلِ أَن يُدعى لَها وَيُؤَهَّلا",93,"ل",2,0],["وَلَرُبَّ يَومٍ قَد قَتَلتُ بِقُمرِهِ","وَقَطَعتُهُ في ظِلِّ لَهوٍ دانِ",94,"ن",1,0],["وَلَرُبَّما أَرتَعتُ رَوضَةَ حُسنِها","طَرفي وَأَعطَيتُ الفُؤادَ مُناهُ",95,"ا",2,0],["وَلَرُبَّما عَثَرَ الجَوادُ وَشَأوُهُ","مُتَقَدِّمٌ وَنَبا الحُسامُ القاطِعُ",96,"ع",1,0],["ولرُبَّ خيلِ بَطَالةٍ خَلَّيتَها","تطأُ الملامَة في الهوى واللُّوَّما",97,"م",2,0],["وَلرُبَّ يومٍ لا تزالُ جِيادُه","تَطأُ الوَشيجَ مُخضَّباً ومُحطَّما",97,"م",2,0],["وَلرُبَّ تعريضٍ لَدَيك نجاحُه","جاءته تصريحُ الغَمامِ الهاطِلِ",98,"ل",1,0],["ولربَّما استمتعْتَ فيه بنُزهَةٍ","لولاه لم تَبرُزْ من الأستارِ",99,"ر",1,0],["ولرُبَّ لَيلاتٍ بهنَّ تَفرَّجَتْ","أسدافُها وتأرَّجَتْ أَسحارُها",100,"ر",3,0],["ولربَّ ساقٍ توَّجَتْ يدُه يدي","بإناءِ ياقوتِ المُدامِ الأحمرِ",101,"ر",1,0],["ولربَّما أغضَتْ وفي أحشائهِ","ما شاءَ من جَمْرِ الغَضا المُتسعِّرِ",102,"ر",1,0],["ولربَّما حَالت شَوازبُ أُسْدِها","بين المُحِبِّ وبين سِرْبِ ربائبِ",103,"ب",1,0],["وَلَرُبَّما اِختَزَنَ الكَريمُ لِسانَهُ","حَذَرَ الجَوابِ وَإِنَّهُ لَمُفَوَّهُ",104,"و",2,0],["وَلَرُبَّما اِبتَسَمَ الوَقورُ مِنَ الأَذى","وَفُؤادُهُ مَن حَرِّهِ يَتَأَوَّهُ",104,"و",2,0],["وَلَرُبَّ مَزحَةِ صادِقٍ بَرَزَت","في لَفظَةٍ وَكَأَنَّها أَفعى",105,"ا",1,0],["وَلَرُبُّ مُلهِيَةٍ لِصاحِبِ لَذَّةٍ","أَلفَيتُها تَبكي عَلَيهِ وَتَندُبُه",106,"ب",2,0],["وَلَرُبَّ غادِيَةٍ وَرائِحَةٍ","لَم يُنجِ مِنها هارِباً هَرَبُه",107,"ب",2,0],["وَلَرُبَّ ذي نَشَبٍ تَكَنَّفَهُ","حُبُّ الحَياةِ وَغَرَّهُ نَشَبُه",107,"ب",2,0],["وَلَرُبَّما صَدَعَ الصَفا","وَلَرُبَّما شَعَبَ الزُجاجا",108,"ج",2,0],["وَلَرُبَّ عَذبٍ صارَ بَع","دَ عُذوبَةٍ مِلحاً أُجاجا",108,"ج",2,0],["وَلَرُبَّ أَخلاقٍ حِسا","نٍ عُدنَ أَخلاقاً سِماجا",108,"ج",2,0],["وَلَرُبَّما اِنتَفَعَ الفَتى بِضِرارِ مَن","يَنوي الضِرارَ وَضَرَّهُ مَن يَنفَعُ",109,"ع",1,0],["وَلَرُبَّ مُرٍّ قَد أَفادَ حَلاوَةً","وَلَرُبَّ حُلوٍ في مَغَبَّتِهِ شُنَع",110,"ع",1,0],["وَلَرُبَّما مُحِقَ الكَثيرُ وَرُبَّما","كَثُرَ القَليلُ إِلى القَليلِ إِذا جُمِع",110,"ع",1,0],["وَلَرُبَّما خانَ الأَري","بَ مِنَ الأُمورِ وَثيقُها",111,"ق",3,0],["وَلَرُبَّما ضَحِكَ الكَذوبُ تَكَلُّفاً","وَبَكى مِنَ الشَيءِ الَّذي لَم يُبكِهِ",112,"ك",2,0],["وَلَرُبَّما صَمَتَ الكَذوبُ تَخَلُّقاً","وَشَكى مِنَ الشَيءِ الَّذي لَم يُشكِهِ",112,"ك",2,0],["وَلَرُبَّما كَذَبَ اِمرُؤٌ بِكَلامِهِ","وَبِصَمتِهِ وَبُكائِهِ وَبِضِحكِهِ",112,"ك",2,0],["وَلَرُبَّما ارتَفَعَ الوَضيعُ بِفِعلِهِ","وَلَرُبَّما سَفَلَ الرَفيعُ العالي",113,"ل",2,0],["وَلَرُبَّ ذي عُلَقٍ لَهُنَّ حَلاوَةٌ","سَيَعُدنَ يَوماً ما عَلَيهِ وَبالا",114,"ل",2,0],["وَلَرُبَّ جيلٍ قَد مَضى","يَتلوهُ بَعدَ الجيلِ جيلُ",115,"ل",1,0],["وَلَرُبَّ باكِيَةٍ عَلَيَّ","غَنائُها عَنّي قَليلُ",115,"ل",1,0],["وَلَرُبَّ أَقوامٍ مَضَوا لِسَبيلِهِم","وَلَتَمضِيَنَّ كَما مَضى الأَقوامُ",116,"م",1,0],["وَلَرُبَّ ذي فُرُشٍ مُمَهَّدَةٍ لَهُ","أَمسى عَلَيهِ مِنَ التُرابِ رُكامُ",116,"م",1,0],["وَلَرُبَّ ذي إِلفٍ يُفارِقُهُ","فَإِذا تَذَكَّرَ إِلفَهُ حَنّا",117,"ن",2,0],["وَلَرُبَّما احتَقَرَ الفَتى","مَن لَيسَ في شَرَفٍ بِدونِه",118,"ن",2,0],["وَلَرُبَّما حَجَبَ الحَليمُ جَوابَهُ","بِالصَمتِ مِنهُ وَإِنَّهُ لَمُفَوَّهُ",119,"ه",1,0],["وَلَرُبَّما جَمَحَ اسِفاهُ بِذي الحِجا","حَتّى يُذَلِّلُهُ الدَنيءُ الأَسفَهُ",119,"ه",1,0],["وَلَرُبَّما نَسِيَ الوَقورَ وَقارَهُ","حَتّى تَراهُ جاهِلاً يَتَدَهدَهُ",119,"ه",1,0],["وَلَرُبَّما نَهنَهتَ عَنكَ ذَوي الخَنا","بِالصَمتِ إِلّا أَحجَموا وَتَنَهنَهوا",119,"ه",3,0],["وَلَرُبَّ صَيلَمِ لَفظَةٍ","عَلِقَت بِها أُذُنٌ تَعيها",120,"ي",3,0],["وَلَرُبَّ مُغتَرٍّ بِهِ","حَتّى رَماهُ بِداهِيَه",121,"ي",2,0],["وَلَرُبَّما حَذِرَ الفَتى","ما لَيسَ يُنجي مِنهُ حِذر",122,"ر",1,1],["وَلَرُبَّما اِستَيأَستُ ثُمَّ أَقولُ لا","إِنَّ الَّذي ضَمِنَ النَجاحَ كَريمُ",123,"م",1,0],["وَلَرُبَّ إِنسانٍ بِلا عَينٍ غَدا","وَكَأَنَّهُ عَينٌ بِلا إِنسانِ",124,"ن",1,0],["وَلَرُبَّما جَلّى العَجاجَ بِسَيفِهِ","وَالنَقعُ أَحلَكُ مِن جَناحِ غُدافِ",125,"ف",1,0],["وَلَرُبَّ جانٍ وَهوَ غَيرُ مُجانِبٍ","وَلَرُبَّ وافٍ وَهوَ غَيرُ مُوافِ",125,"ف",1,0],["وَلَرُبَّما عَوَتِ الكِلابُ فَأَرشَدَت","نَحوَ الكِرامِ شَوارِدَ الأَضيافِ",125,"ف",1,0],["وَلَرُبَّما أَبكى السُرورُ إِذا أَتى","فَرطاً وَفي بَعضِ الشَدائِدِ يُضحِكُ",126,"ك",1,0],["وَلَرُبَّما طَلَبَ الحَريصُ زِيادَةً","فَغَدَت مُؤَدِّيَةً إِلى النُقصانِ",127,"ن",1,0],["ولَرُبَّ آمالٍ عليكِ حبستُها","وخشيتُ لو تبدو قِتَالَ ذويكِ",128,"ك",1,0],["ولربما خطر النَّوى فبكيته","من قبل أن يأتي البعاد سجاما",129,"م",2,0],["ولربّ محتقَرٍ تركتُ جوابَهُ","والليثُ يأنفُ عن جوابِ الثعلبِ",130,"ب",1,0],["ولَرُبَّما فَرَشَتْ لزائر لحظِهِ","وردَ الخدودِ مَحَبّةً وَوِدادا",131,"د",2,0],["ولربّ مُنْتَهِبِ المدى يجري به","عرقٌ عريقٌ في الجيادِ وَلِيتُ",132,"ت",1,0],["وَلَرُبَّما اِستَبكَتهُ نَكبَةُ حادِثٍ","نَكَأَت بِباطِنِ صَفحَتَيهِ نُدوبا",133,"ب",2,0],["وَلَرُبَّ كِفلٍ في الخُطوبِ تَرَكتَهُ","لِصِعابِها حِلساً مِنَ الأَحلاسِ",134,"س",1,0],["وَلِراحَتَيهِ ديمَتانِ قَديمَةٌ","لي بِالوِدادِ وَديمَةٌ بِالعَسجَدِ",135,"د",1,0],["وَلَرُبَّ حربٍ حائِلٍ لَقَّحتَها","وَنَتَجتَها مِن قَبلِ حينِ المَولِدِ",135,"د",1,0],["وَلَرُبَّ مَلْحَمَةٍ سَرَيْتُ قِنَاعَهَا","عَن وَجْهِ نَصْرٍ بِالْغُبَارِ مُلَثَّمِ",136,"م",1,0],["وَلَرُبَّ غَضِّ الجِسمِ مَدَّ بِخَوضِهِ","شَبَحاً كَما شَقَّ السَماءَ شِهابُ",137,"ب",1,0],["وَلَرُبَّما ذَبّوا وَذادوا عَن حِمى","مَلِكٍ هَوى فَكَأَنّهُم ماذادوا",138,"د",3,0],["وَلَرُبَّ لَيلٍ قَد صَدَعتُ","ظَلامَهُ بِجَبينِ بَدرِك",139,"ك",1,0],["وَلَرُبَّ رَوّاعٍ هُنالِكَ أَنبَطٍ","خَلقِ المَسامِعِ أَطلَسِ الأَطمارِ",140,"ر",1,0],["وَلَرُبَّ طَيّارٍ خَفيفٍ قَد جَرى","فَشَلا بِجارٍ خَلفَهُ طَيّارِ",140,"ر",1,0],["وَلَرُبَّ صِفرِ الكَفِّ هاذٍ بِالمُنى","كَلِفٍ بِأَطوارٍ مِنَ الأَوطارِ",140,"ر",1,0],["وَلَرُبَّما مَنَّ النَسيمُ بِنَفحَةٍ","تَندى عَلى كَبِدٍ تَذوبُ أُوارا",141,"ر",2,0],["وَلَرُبَّما سالَت أَباطِحُها بِها","في مُنتَحى أَنهارِها أَنهارا",141,"ر",2,0],["وَلَرُبَّ رامٍ مِن بَنيهِ مُلَثَّمٍ","وَمُحارِبٍ شاكي السِلاحِ مُقَنَّعِ",142,"ع",1,0],["وَلَرُبَّما أَحيا أَميرٌ أُمَّةً","وَرَمى بِأُخرى في اللُحودِ أَميرُ",143,"ر",1,0],["وَلَرُبَّ مَغلولِ العَزيمَةِ يَشتَكي","في كُلِّ عِضوٍ رِبقَةً وَوثاقا",144,"ق",2,0],["وَلَرُبَّما غَشَّ الطَبيبُ عَليلَهُ","لِيَعودَ مِنهُ الداءُ وَهوَ عُقامُ",145,"م",1,0],["وَلربّما ركب المجرَّةَ فَاعتَلى","وَهَوى المُنيفُ عَلى العُبابِ المُشرِفُ",146,"ف",1,0],["ولربَّما ازْدانَ الفتى بسجيَّةٍ","كانت له شَرَفاً أشمَّ وسُؤْدَدا",147,"د",2,0],["وَلرُبَّما خَفِيَ الصّوابُ فأسفَرتْ","عنه وُجوهُ الرأيِ بعد خَفاءِ",148,"ا",2,0],["وَلَرُبَّما تَندى اِقتِصادَ مُخَفِّفٍ","فَتَرى غُلُوَّكَ بِالنَدى فَتَزيدُ",149,"د",1,0],["وَلَرُبَّ مُشعَلَةٍ يَشُبُّ وَقودُها","أَطفَأتُ حَرَّ رِماحِها بِرِماحي",150,"ح",2,0],["وَلِرُبَّ لَيلٍ لا تَجِفُّ جُفونُهُ","مِن دَمعَةٍ مُلقٍ عَلَيهِ سُدولا",151,"ل",2,0],["وَلَرُبَّ مُهلِكَةٍ يَحارُ بِها القَطا","مَسجورَةٍ بِالشَمسِ خَرقٍ مُجهَلِ",152,"ل",1,0],["وَلَرُبَّ قِرنٍ قَد تَرَكتُ مُجَدَّلاً","جَزَراً لِضارِيَةِ الذِئابِ العُسَّلِ",152,"ل",1,0],["وَلَرُبَّما رَوّاكَ مِن قُبَلٍ","ظَبيٌ مُجاجَةُ ريقِهِ خَمرُ",153,"ر",1,0],["وَلَرُبَّ مَعنى حِكمَةٍ أَفرَغتَهُ","في قالِبٍ مِن لَفظَةٍ أَوجَزتَها",154,"ت",3,0],["وَلَرُبَّ هاجِرَةٍ يَقِل","لُ لِحَرِّها صَبرُ الرَكائِب",155,"ب",1,0],["وَلَرُبَّ أَشرارٍ لِنَفسٍ نالَها","أَعدائُها مِن خِلِّها وَحَبيبِها",156,"ب",3,0],["وَلَرُبَّ سَمعٍ قَد قَرَعتَ بِحُجَّةٍ","هَذَّبتُها مِن شَكِّها وَعُيوبِها",156,"ب",3,0],["وَلَرُبّما التَمَسُوهُ بالمالِ الذي","سَرَقُوا فأصْبَحَ لامِساً مَلْمُوسا",157,"س",2,0],["وَلَرُبَّما نَزَّهتُ عَي","ني في مَحاسِنِ ذي وَسامَه",158,"م",2,0],["وَلِرَهطِ يَحيى في القَريض خَبيئَةٌ","تَنوي زيارَتَهُم وَسَوفَ تَزورُ",159,"ر",1,0],["وَلَرُبَّ عودٍ قَد يُشَقُّ لِمَسجِدٍ","نِصفاً وَسائِرُهُ لِحُشِّ يَهودي",160,"د",2,0],["وَلِرَهطِ حَرّابٍ وَقَدٍّ سورَةٌ","في المَجدِ لَيسَ غُرابُهُم بِمُطارِ",161,"ر",1,0],["وَلَرُبَّ ومُشتارٍ تَرَقّى في الذُرى","فَجَنى المَنِيَّةَ في الَّذي يَشتارُ",162,"ر",1,0],["وَلَرُبَّ أَجسادٍ جَديراتِ الثَرى","بِالصَونِ عادَت في طَلاءِ جِدارِ",163,"ر",1,0],["وَلِرُبَّ جَدٍّ مُكثِرٍ أَبناوُهُ","يَبغَونَ عَيشَهُمُ بِجَدٍّ تاعِسِ",164,"س",1,0],["وَلَرُبَّما وَرِثَتهُ أَو سَبَقت بِها","أَقدارٌ ميتَتِها فَكانَ طَليقَها",165,"ق",3,0],["وَلَرُبَّما قَضَتِ الأَناةُ مَآرِباً","مِن نازِحٍ وَلِكُلِّ عالٍ سُلَّمُ",166,"م",1,0],["وَلَرُبَّ سَيِّدِ مَعشَرٍ","ضَخمِ الدَسيعَةِ قَد رَمَينا",167,"ن",2,0],["ولربَّ نائحةٍ على فَنَنٍ","تُشْجي الخليَّ وما بهِ شَجوُ",168,"و",1,1],["وَلرُبَّ خافِقَةِ الذَّوائِبِ قدْ غدَتْ","مَعْقُودةً بِلِوائِهِ المَنْصورِ",169,"ر",1,1],["ولربَّ إلفٍ قد طَويْ","تُ على مُراقبةِ الرقيبْ",170,"ب",1,0],["ولرب يوم فيه قد","بان العشيُّ لدى الغداة",171,"ه",1,0],["ولربَّ عاطرةِ النسيمِ عليلةٍ","طالعتُ فيها الليلةَ القمراءَ",172,"ا",2,0],["ولَرُبَّ حانٍ قد أدَرْتُ بدَيْرِهِ","خَمْرَ الصِّبا مُزِجَتْ بِصَفْوِ خُمُورِه",173,"ر",2,1],["ولَرُبَّ لَيْلٍ للهُمُومِ تَهَلَّلَتْ","أَستارُه فَمحا الصُّوى بِسُتُورِه",174,"ر",2,0],["وَلَرُبَّ مُشعِلَةٍ وَزَعتُ رِعالَها","بِمُقَلَّصٍ نَهدِ المَراكِلِ هَيكَلِ",175,"ل",1,0],["وَلَرُبَّ قِرنٍ قَد تَرَكتُ مُجَدَّلاً","وَلَبانُهُ كَنَواضِحِ الجِريالِ",176,"ل",1,0],["وَلَرُبَّ خَيلٍ قَد وَزَعتُ رَعيلَها","بِأَقَبَّ لا ضِغنٍ وَلا مِجفالِ",176,"ل",1,0],["وَلِرفعي على الرَّبَاوَةِ ناري","عَلَماً لِلمُضلِّ واللَّيلُ داجِ",177,"ج",1,0],["وَلَرِيْبِ الزَّمَانِ يَعْتَدُّ مَا يَعْ","تَدُّهُ لِلطَّوَارِيءِ الأحْزَامُ",178,"م",1,0],["وَلَرُبَّمَا رَاعَ الحَقِيقَةَ رَسْمُهَا","فِيهِ فَمَا اعْتَصَمَتْ مِنَ الخُيَلاَءِ",179,"ا",2,0],["وَلِرَوْعَةٍ فِي مَائِهِ","مُتَوَهِّجاً وَهْجَ الضِّرَامِ",180,"م",1,0],["وَلَرُبَّمَا كَذَبَ الْجَوَا","دُ فَكَانَ أَصْدَقَ فِي السَّخَاءْ",181,"ا",2,0],["وَلَرُبَّمَا مُنِحَ الْجَمَادُ كَرَامَةً","فَأَجَلَّ قَدْرَ الزَّائِرِيَنَ مَزَارُ",182,"ر",1,0],["وَلَرُبَّ يَومٍ غَضَّةٍ أَطرافُهُ","صُقِلَت بِخَطوِ رَوائِحٍ وَغَوادي",183,"ي",1,0],["وَلَرُبَّما دَعَتِ الشَبيبَةُ لِلهُدى","وَأَضَلَّ شَيبُ الرَأسِ وَالتَقويسُ",184,"س",1,0],["ولَراعهُ وجهٌ من ال","تَحْسين قيءٌ أملس",185,"س",1,0],["وَلَرُبَّ قَافِيَةٍ بهَا","مَا شِئْتَ مِنْ خَيْلٍ وَجُنْدِ",186,"د",1,0],["وَلرُبَّ نفسٍ ضَمَّها صدرُ الفتَى","ويضيقُ صدرُ الأرضِ عن فيَّاحها",187,"ح",3,0],["ولربَّما كان امتدا","حُ كتابه أقصى ثوابه",188,"ب",2,0],["ولرُبَّما امتلأَت جُيو","بُ الناشرين على حسابه",188,"ب",2,0],["ولربَّ عينٍ فوق خدٍّ ناعمٍ","خطبت؛ فأسمعت الأصمَّ الأعجما",189,"م",2,0],["ولرُبِّ مدرسةٍ تحطم قلعةً","وتُبِيدُ أسطولاً، وتَهْزِمُ عَسْكرا",190,"ر",2,0],["ولرب يوم مِصْر فيهِ شَيَّدَتْ","أهرامَها، والغَرْبُ في سِنَةِ الكِرى",190,"ر",2,0],["وَلَرُبَّ ضرْغَام أُصيب بلدْغَة","من عَقْربٍ دبَّتْ على وجه الثَّرى",191,"ر",2,0],["وَلَرُبَّمَا نَسِيَ المُعَلِّم نَفْسَهُ","وَجَنَي عليه جهِادُه المُتَوالِي",192,"ل",2,0],["ولرُبّ قاض تَنْقَضِي أيامُه","في صُحْبَة السَّفَّاكِ والنَّشَّالِ!",192,"ل",1,0],["ولَرب أُسْتَاذ لهُ مُتَفَرِّغٍ","أحْرَى به لو عُدَّ من طُلاَّبه!",193,"ب",2,0],["ولرُبَّمَا عقَدَتْ على النَّ","وَم الجُفونَ وأنت ساهر",194,"ر",1,0],["ولرب أمر مسخط","لك في عواقبه رضى",195,"ض",2,0],["ولربَّما ضَحِكتْ بسائطُها","هُزْءاً بنا ممَّا نُعَقِّده",196,"د",2,0],["ولربما جزِع الفتى من علّة","كانت سبيلَ الشكر عند شِفائه",197,"ا",3,0],["ولربَّ أشعثَ لأغبرٍ ذي هامة","تُلقي على كَتَفيهِ ثقلاَ آيدا",198,"د",2,0],["وَلَرُبَّ نفسٍ بان رَوْنَقُها","جراءَ حُزْنٍ غير مُنْتَظَر",199,"ر",1,0],["ولرغبة في النفس حائرة","مكبوتة يتطايرُ الشرر",200,"ر",1,0],["ولربما ظنَّ الرواجمُ أنّهمْ","سيرَوْنَ من هذا \" المنخَّل \" غُولا",201,"ل",2,0],["ولَرُبَّ يَوْمٍ قَدْ فَتَكْتُ بقُمْرِهِ","وقَطَعْتُهُ في ظِلِّ لَهْوٍ دَانِ",202,"ن",1,0],["ولرُبّ مُشتارٍ في الذُّرى،","فجنى المنيّةَ في الذي يشتار",203,"ر",1,0],["ولربما شقي الفتى بجوداه","ولربما حظي الفتى بنجيلهِ",204,"ل",2,0],["ولراحتيك بدأة ٌ وعُوادة ٌ","وليومِ عُرفك بكرة ٌ وأصيلُ",205,"ل",1,0],["ولرب شئ لا يبيّنه","وجدانُه الاَّ مع العدم",206,"م",1,0]]}