{"poems":[[55,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[9,"أرقت وما هذا السهاد المؤرق","https://www.aldiwan.net/poem21956.html","الطويل"],[95,"أيها البالغ الثريا مقاماً","https://www.aldiwan.net/poem11412.html","الخفيف"],[90,"أكب على الخوان وكان خفا","https://www.aldiwan.net/poem44978.html","الوافر"],[29,"أتزور أم محمد أم تهجر","https://www.aldiwan.net/poem5738.html","الكامل"],[29,"ألا تصحو وتقصر عن صباكا","https://www.aldiwan.net/poem5946.html","الوافر"],[49,"أتزعم ياضخم اللغاديد أننا","https://www.aldiwan.net/poem25367.html","الطويل"],[53,"أدار العامرية بالوحيد","https://www.aldiwan.net/poem61884.html","الوافر"],[53,"أتاني عتاب من أخ فاغتفرته","https://www.aldiwan.net/poem64967.html","الطويل"],[93,"كم تشتكي وتقول إنك معدم","https://www.aldiwan.net/poem62676.html","عموديه"],[60,"دواؤك فيك وما تبصر","https://www.aldiwan.net/poem31063.html","المتقارب"],[68,"سوى حسن وجهك لم يحل لي","https://www.aldiwan.net/poem40964.html","المتقارب"],[107,"رويدك أيها الجبار فينا","https://www.aldiwan.net/poem43385.html","الوافر"],[48,"إذا وفت لتجار الهند فائدة","https://www.aldiwan.net/poem22616.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85558","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42522","الطويل"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/862","المتقارب"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141976","الرجز"],[102,"صنعاء والحلم والزمان","https://www.poetsgate.com/ViewPoem.aspx?id=50404",""],[93,"كم تشتكي","https://www.poetsgate.com/ViewPoem.aspx?id=53234",""],[102,"صنعاء والحلم والزمان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67673&r=&rc=160",""],[119,"الا عذر لا كان الهوى في الهوى العذر","https://www.aldiwan.net/poem41119.html","عموديه"],[146,"ترى رائح يأتى بأخبار من غدا","https://www.aldiwan.net/poem58445.html","الطويل"],[164,"بكيت لأخفى بالدموع السوافح","https://www.aldiwan.net/poem58950.html","الطويل"],[216,"أتزعم يا جاري وسؤلي ومنيتي","https://www.aldiwan.net/poem37911.html","الطويل"],[230,"أتزودت من ضياء البدور","https://www.aldiwan.net/poem55172.html","الخفيف"],[408,"أتزعمني لديك أجل خل","https://www.aldiwan.net/poem46502.html","الوافر"],[409,"أتزعم حب أقوام وتنسى","https://www.aldiwan.net/poem33465.html","الوافر"],[427,"أدرها لنا صرفا ودع مزجها عنا","https://www.aldiwan.net/poem46357.html","الطويل"],[505,"تجرأ حزب الجاحدين كما تشا","https://www.aldiwan.net/poem37564.html","الطويل"],[558,"دار الغواني بدلت آياتها","https://www.aldiwan.net/poem68387.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122535","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122721","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86613","الوافر"],[826,"","https://poetry.dctabudhabi.ae/diwan/poem/140227",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63751","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38824","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37888","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37894","الطويل"],[1483,"","https://poetry.dctabudhabi.ae/diwan/poem/130660","الطويل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126644","البسيط"],[2448,"","https://poetry.dctabudhabi.ae/diwan/poem/33004","الطويل"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70351","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75961","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76158","الطويل"],[3479,"","https://poetry.dctabudhabi.ae/diwan/poem/101959","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66369","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110227","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92101","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91722","الطويل"],[3791,"","https://poetry.dctabudhabi.ae/diwan/poem/145985","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44672","الطويل"],[4680,"قدرٌ هواك","https://www.poetsgate.com/ViewPoem.aspx?id=185018",""],[5010,"بِشُكْرِ النَّعِيْمِ تَدُوْمُ النِّعَم","https://www.poetsgate.com/ViewPoem.aspx?id=190322",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5431,"السيجارة تتكلم ...","https://www.poetsgate.com/ViewPoem.aspx?id=205897",""],[5538,"إني قرير العين حين أراكا","https://www.poetsgate.com/ViewPoem.aspx?id=142632",""],[5648,"ريح ضميرك","https://www.poetsgate.com/ViewPoem.aspx?id=154661",""],[5701,"أرى نفسي تكاد أسى تذوب","https://www.poetsgate.com/ViewPoem.aspx?id=164603",""],[5956,"شوقي إليك أيا سمير شديدُ","https://www.poetsgate.com/ViewPoem.aspx?id=194268",""],[6102,"رَسولُ الهَوى...","https://www.poetsgate.com/ViewPoem.aspx?id=182740",""]],"verses":[["أَتَزحَمُ البَحرَ في غُطامِطِهِ","أَم تَتَعاطى السِيولَ يا وَشَلُ",0,"ل",1,0],["أَتَزعُمُ لِلأَكفاءِ ما أَنتَ أَهلُهُ","وَتَختالُ إِذ جارُ اِبنِ عَمِّكَ مُرهَقُ",1,"ق",1,0],["أَتَزُورُ الأَرْضَ المَوَاتَ وَتَعْتَا","مُ شَقَاءً مُخَيِّماً وَقَتَامَا",2,"م",2,0],["أتزدرد الطعام بغير مضغ","على أيام صحتك السلام",3,"م",1,0],["أَتَزورُ أُمَّ مُحَمَّدٍ أَم تَهجُرُ","أَم عادَ قَلبَكَ بَعضُ ما تَتَذَكَّرُ",4,"ر",1,1],["أَتَزعُمُ ذا المَناخِرِ كانَ سَبطاً","يَهودِيّاً وَنَزعُمُهُ أَباكا",5,"ك",2,0],["أَتَزعَمُ ياضَخمَ اللَغاديدِ أَنَّنا","وَنَحنُ أُسودُ الحَربِ لانَعرِفُ الحَربا",6,"ب",2,1],["أتزعم فعل ربك كان ظلماً","بأُمَّةِ صالحٍ وبقوم هودِ",7,"د",1,0],["أتزعُمُ أني إن وليتُ قُريَّةً","رأيت ازوراري عن صديقي من الفرض",8,"ض",1,0],["أَتَزورُ روحَكَ جَنَّةٌ فَتَفوتَها","كَيما تَزورُكَ بِالظُنونِ جَهَنَّمُ",9,"م",1,0],["أَتَزعُمُ أَنَّكَ جُرمٌ صَغير","وَفيكَ اِنطَوى العالَمُ الأَكبَرُ",10,"ر",1,0],["أَتَزعُمُ أَنّي أُطيعُ الوُشاةَ","وَأَصغي إِلى عَذَلِ العُذَّلِ",11,"ل",1,0],["أَتَزعُمُ ما جَنى الجُهَلاءُ ديناً","وَتَأخُذُنا بِذَنبِ الجاهِلينا",12,"ن",2,0],["أَتَزجُرونَ أَميراً أَن يُكَلِّفَكُم","ضَيماً فَيُحمَدَ غِبَّ الشَأنِ مَن زَجَرا",13,"ر",2,0],["أَتَزعم أن الشرق يلبث صاغراً","أمامك مغصوباً وأَنت المكرَّم",14,"م",1,0],["أَتَزْعُمُنِي خِلاًّ وَتَهْجُرُ ساحَتِي","عَلَى غَيْرِ ذَنْبٍ إِنَّ ذَا لَعَجِيبُ",15,"ب",1,1],["أَتَزعُمُ أَنَّكَ خِدنُ الوَفاءِ","وَقَد حَجَبَ التُربُ مَن قَد حَجَب",16,"ب",1,1],["إت زقت العود أناشيد الهوى","حن لها العود وجن الوتر",17,"ر",1,0],["أتزاحمين العالم المجنون ؟","يا بنت الخدور",18,"ر",1,0],["أتزور روحك جنّة فتفوقها","كيما تزورك بالظنون جهنّم ؟",19,"م",1,0],["أتزاحمين العالم المجنون ؟","يا بنت الحدور",20,"ر",1,0],["اتزعمني من قد دهاك تسلقت","ذووه المعالي وهي من غلط الدهر",21,"ر",1,0],["أتزعمُ أنّ الصبرَ فيك سجيّةٌ","وتشجَى إذا البرق التِّهامىُّ أنجدا",22,"د",2,0],["أَتزعم اللاحون قد أَضرموا الحشا","وأنت تماليهم بأَنك ناصحي",23,"ح",2,0],["أتَزْعمُ يا جاري وسُؤلي ومُنْيتي","بأني عدوّ لا ولكنْ مودتي",24,"ي",1,1],["أَتَزوَّدتَ من ضِياءِ البُدورِ","لِليالٍ كثيفَةِ الدَيجورِ",25,"ر",1,1],["أتزعمني لديك أجل خلٍّ","يعزّ عليكَ من حيّ وميت",26,"ت",1,1],["أتزعم حب أقوام وتنسى","مذاهبهم وتجهل ما تقول",27,"ل",1,1],["أتزعم فيما قلت أنك صادق","رويدك ما العرفان قالوا ولا قلنا",28,"ن",2,0],["أتزعم أنَّ الله يهمل حزبه","كذبت يد الإحسان للقوم واقيه",29,"ي",2,0],["أَتَزيدُ كَم لَكَ مِن يَدٍ وَصَنيعَةٍ","عَمَّت فَقامَ بِشُكرِها الثَقَلانِ",30,"ن",1,0],["أتزرين في غِبِّ الزِّيارَةِ ضَلَّةً","عَليَّ وأحلاماً وأعشقُها الغِبُّ",31,"ب",1,0],["أتَزيدُ عَبدَكَ غيرَ ما أكرَمتَهُ","زُلفى وَأنتَ شَريبُهُ وأكيلُه",32,"ل",2,0],["أَتَزعم يا مهين بِأَن غَمراً","يَنال العِز ما دامَ السَحاب",33,"ب",1,0],["أتزيدونيَ لوماً ويحكم","أَقْصِروا عنا كفانا ما بنا",34,"ن",2,0],["أتَزْعُمُ أَن الفِطْرَ طُوَّقَنا شُكْرا","ووجهُكَ قبلَ الفطرِ كان لنا فطرا",35,"ر",2,1],["أَتَزعمُ أَنّ المِسكَ عَنهُ لَقَد خَلا","سِواك أَلا فَاِنظُر تَرى المِسكَ في خالي",36,"ي",1,0],["أَتَزورُني بِعدَ التباعُدِ والجَفا","وعلى المتيَّم حُرِّمت زَوراتُها",37,"ت",3,0],["أَتَزعمُ أَنّي لِلأمانِيِّ بالِغٌ","وَأَنَّ الأماني كَالظُّنونِ كَواذبُ",38,"ب",1,0],["اتزعم ان ابني شكاني وانه","ظلوم يجوب الزور حيث يجوب",39,"ب",1,0],["أتزعمن بأن الأمن منتشر","وكل يوم نرى منكم مهاريتا",40,"ت",2,0],["أَتَزعُمُ أَنَّ الخارِجِيَّ عَلى الهُدى","وَأَنتَ مُقيمٌ بَينَ لِصٍّ وَجاحِدِ",41,"د",1,0],["أتزعم ليلى أنني لا أحبها","وأني لما ألقاه غير حمول",42,"ل",1,1],["أَتَزهى بِصوفٍ وَهوَ بِالأَمسِ مُصبِحٌ","عَلى نَعجَةٍ وَالآن مُمسٍ عَلى تيسِ",43,"س",1,0],["أَتَزعُم أَنَّ الذهن يُوضِحُ مشكلاً","بِلا موضح كَلا لَقَد كَذَبَ الذِهنُ",44,"ن",1,0],["أتزعم نصح الصب حين تلومه","وتحسب ان النصح يقبله الصب",45,"ب",1,0],["أتزعم أنني أسلو","ه لا والواحد الفرد",46,"د",1,0],["أَتزهو بعُمرِ آنَ جُرفُ نَهارهِ","وعن كَثَبٍ يندكُّ وَشكاً ويَخرَبُ",47,"ب",1,0],["أتزعم ليلي أن فيَّ بقيةً","وقد ذهبت بالأطيبينِ الذواهبُ",48,"ب",1,1],["أَتزعم ليلي أَنّ في العود مطمعاً","لَقَد أَخطأت ليلي وَهَيهات مبلغ",49,"غ",1,0],["أتزعم أنني قد قلت هجواً","وعرضك لا يدنس بالهجاء",50,"ا",2,0],["أتزعم أن حديد الكلام","يصد الطراود يوم الصدام",51,"م",1,0],["أََتَزعَمُ يا مَغرور أَنَّك دينُ","وَحبّك لِلباري العليِّ مَكينُ",52,"ن",1,1],["آتٍ زمان سناك رغم أنوفهم","وإلى مداك ستفتح الأبوابُ",53,"ب",1,0],["أَ تَزْعُمُ أَنكَ فِيْ شِدَّةٍ","وَنعْمَاؤُهُ لَمْ تَزَلْ تَنْسَجِمْ",54,"م",1,0],["أتزعم أنه عين البرايا","فهذا الاتحاد لكل غال",55,"ل",1,0],["أتزمع ترك ماتهواه حقا!؟","فرفقا ياحبيب القلب رفقا",56,"ق",2,0],["أتزيع سرك ما يفيدك قل لنا","شيء عجيب ما أباح سواكا",57,"ك",2,0],["اتزاحم الفكر بالافكار","والنفس تتعب من الجاير",58,"ر",1,0],["أتزرعه ليحصده سواها","وذلكم هو العجب العجيب",59,"ب",1,0],["أ تَزاحم الإسكندرية هيّنٌ","أ بوسعنا حملٌ له وصمودُ؟",60,"د",1,0],["أَتَزدَرِينَ عَذابِي؟ وَهْوَ حَوضُ دَمِي!","وَتُنكِرِينَ فُؤادِي؟ وَهْوَ بَلُّورُ!",61,"ر",1,0]]}