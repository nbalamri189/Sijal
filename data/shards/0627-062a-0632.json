{"poems":[[53,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[9,"أرقت وما هذا السهاد المؤرق","https://www.aldiwan.net/poem21956.html","الطويل"],[93,"أيها البالغ الثريا مقاماً","https://www.aldiwan.net/poem11412.html","الخفيف"],[88,"أكب على الخوان وكان خفا","https://www.aldiwan.net/poem44978.html","الوافر"],[27,"أتزور أم محمد أم تهجر","https://www.aldiwan.net/poem5738.html","الكامل"],[27,"ألا تصحو وتقصر عن صباكا","https://www.aldiwan.net/poem5946.html","الوافر"],[47,"أتزعم ياضخم اللغاديد أننا","https://www.aldiwan.net/poem25367.html","الطويل"],[51,"أدار العامرية بالوحيد","https://www.aldiwan.net/poem61884.html","الوافر"],[51,"أتاني عتاب من أخ فاغتفرته","https://www.aldiwan.net/poem64967.html","الطويل"],[91,"كم تشتكي وتقول إنك معدم","https://www.aldiwan.net/poem62676.html","عموديه"],[58,"دواؤك فيك وما تبصر","https://www.aldiwan.net/poem31063.html","المتقارب"],[66,"سوى حسن وجهك لم يحل لي","https://www.aldiwan.net/poem40964.html","المتقارب"],[105,"رويدك أيها الجبار فينا","https://www.aldiwan.net/poem43385.html","الوافر"],[46,"إذا وفت لتجار الهند فائدة","https://www.aldiwan.net/poem22616.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85558","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42522","الطويل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/862","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141976","الرجز"],[100,"صنعاء والحلم والزمان","https://www.poetsgate.com/ViewPoem.aspx?id=50404",""],[91,"كم تشتكي","https://www.poetsgate.com/ViewPoem.aspx?id=53234",""],[100,"صنعاء والحلم والزمان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67673&r=&rc=160",""],[115,"الا عذر لا كان الهوى في الهوى العذر","https://www.aldiwan.net/poem41119.html","عموديه"],[142,"ترى رائح يأتى بأخبار من غدا","https://www.aldiwan.net/poem58445.html","الطويل"],[160,"بكيت لأخفى بالدموع السوافح","https://www.aldiwan.net/poem58950.html","الطويل"],[212,"أتزعم يا جاري وسؤلي ومنيتي","https://www.aldiwan.net/poem37911.html","الطويل"],[225,"أتزودت من ضياء البدور","https://www.aldiwan.net/poem55172.html","الخفيف"],[402,"أتزعمني لديك أجل خل","https://www.aldiwan.net/poem46502.html","الوافر"],[403,"أتزعم حب أقوام وتنسى","https://www.aldiwan.net/poem33465.html","الوافر"],[421,"أدرها لنا صرفا ودع مزجها عنا","https://www.aldiwan.net/poem46357.html","الطويل"],[500,"تجرأ حزب الجاحدين كما تشا","https://www.aldiwan.net/poem37564.html","الطويل"],[553,"دار الغواني بدلت آياتها","https://www.aldiwan.net/poem68387.html","الكامل"]],"verses":[["أَتَزحَمُ البَحرَ في غُطامِطِهِ","أَم تَتَعاطى السِيولَ يا وَشَلُ",0,"ل",1,0],["أَتَزعُمُ لِلأَكفاءِ ما أَنتَ أَهلُهُ","وَتَختالُ إِذ جارُ اِبنِ عَمِّكَ مُرهَقُ",1,"ق",1,0],["أَتَزُورُ الأَرْضَ المَوَاتَ وَتَعْتَا","مُ شَقَاءً مُخَيِّماً وَقَتَامَا",2,"م",2,0],["أتزدرد الطعام بغير مضغ","على أيام صحتك السلام",3,"م",1,0],["أَتَزورُ أُمَّ مُحَمَّدٍ أَم تَهجُرُ","أَم عادَ قَلبَكَ بَعضُ ما تَتَذَكَّرُ",4,"ر",1,1],["أَتَزعُمُ ذا المَناخِرِ كانَ سَبطاً","يَهودِيّاً وَنَزعُمُهُ أَباكا",5,"ك",2,0],["أَتَزعَمُ ياضَخمَ اللَغاديدِ أَنَّنا","وَنَحنُ أُسودُ الحَربِ لانَعرِفُ الحَربا",6,"ب",2,1],["أتزعم فعل ربك كان ظلماً","بأُمَّةِ صالحٍ وبقوم هودِ",7,"د",1,0],["أتزعُمُ أني إن وليتُ قُريَّةً","رأيت ازوراري عن صديقي من الفرض",8,"ض",1,0],["أَتَزورُ روحَكَ جَنَّةٌ فَتَفوتَها","كَيما تَزورُكَ بِالظُنونِ جَهَنَّمُ",9,"م",1,0],["أَتَزعُمُ أَنَّكَ جُرمٌ صَغير","وَفيكَ اِنطَوى العالَمُ الأَكبَرُ",10,"ر",1,0],["أَتَزعُمُ أَنّي أُطيعُ الوُشاةَ","وَأَصغي إِلى عَذَلِ العُذَّلِ",11,"ل",1,0],["أَتَزعُمُ ما جَنى الجُهَلاءُ ديناً","وَتَأخُذُنا بِذَنبِ الجاهِلينا",12,"ن",2,0],["أَتَزجُرونَ أَميراً أَن يُكَلِّفَكُم","ضَيماً فَيُحمَدَ غِبَّ الشَأنِ مَن زَجَرا",13,"ر",2,0],["أَتَزعم أن الشرق يلبث صاغراً","أمامك مغصوباً وأَنت المكرَّم",14,"م",1,0],["أَتَزْعُمُنِي خِلاًّ وَتَهْجُرُ ساحَتِي","عَلَى غَيْرِ ذَنْبٍ إِنَّ ذَا لَعَجِيبُ",15,"ب",1,1],["أَتَزعُمُ أَنَّكَ خِدنُ الوَفاءِ","وَقَد حَجَبَ التُربُ مَن قَد حَجَب",16,"ب",1,1],["إت زقت العود أناشيد الهوى","حن لها العود وجن الوتر",17,"ر",1,0],["أتزاحمين العالم المجنون ؟","يا بنت الخدور",18,"ر",1,0],["أتزور روحك جنّة فتفوقها","كيما تزورك بالظنون جهنّم ؟",19,"م",1,0],["أتزاحمين العالم المجنون ؟","يا بنت الحدور",20,"ر",1,0],["اتزعمني من قد دهاك تسلقت","ذووه المعالي وهي من غلط الدهر",21,"ر",1,0],["أتزعمُ أنّ الصبرَ فيك سجيّةٌ","وتشجَى إذا البرق التِّهامىُّ أنجدا",22,"د",2,0],["أَتزعم اللاحون قد أَضرموا الحشا","وأنت تماليهم بأَنك ناصحي",23,"ح",2,0],["أتَزْعمُ يا جاري وسُؤلي ومُنْيتي","بأني عدوّ لا ولكنْ مودتي",24,"ي",1,1],["أَتَزوَّدتَ من ضِياءِ البُدورِ","لِليالٍ كثيفَةِ الدَيجورِ",25,"ر",1,1],["أتزعمني لديك أجل خلٍّ","يعزّ عليكَ من حيّ وميت",26,"ت",1,1],["أتزعم حب أقوام وتنسى","مذاهبهم وتجهل ما تقول",27,"ل",1,1],["أتزعم فيما قلت أنك صادق","رويدك ما العرفان قالوا ولا قلنا",28,"ن",2,0],["أتزعم أنَّ الله يهمل حزبه","كذبت يد الإحسان للقوم واقيه",29,"ي",2,0],["أَتَزيدُ كَم لَكَ مِن يَدٍ وَصَنيعَةٍ","عَمَّت فَقامَ بِشُكرِها الثَقَلانِ",30,"ن",1,0]]}