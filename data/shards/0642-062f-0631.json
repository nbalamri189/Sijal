https://poetry.dctabudhabi.ae/diwan/poem/202531","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21081","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55011","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54919","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55437","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55009","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54910","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43854","البسيط"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8910","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54301","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54249","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54299","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205801","الخفيف"],[106,"الشهيد الأول","https://www.poetsgate.com/ViewPoem.aspx?id=179492",""],[106,"أدب الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=179476",""],[106,"ثورة على الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=179425",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[106,"الوحدة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=179293",""],[77,"خَطْبٌ ألمَّ فأذْهبَ الأخ والأبا","https://www.poetsgate.com/ViewPoem.aspx?id=33306",""],[90,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[90,"في طهران","https://www.poetsgate.com/ViewPoem.aspx?id=179053",""],[90,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[90,"ساعة مع البحتري في سامراء ...","https://www.poetsgate.com/ViewPoem.aspx?id=179035",""],[45,"مُخْلِفٌ في الذي وَعدْ","https://www.poetsgate.com/ViewPoem.aspx?id=31599",""],[46,"ضَحِكُ الدّهرِ، في محيّاكَ، مَكرُ،","https://www.poetsgate.com/ViewPoem.aspx?id=20141",""],[99,"قدر أنتِ بشكل إمرأه","https://www.poetsgate.com/ViewPoem.aspx?id=14388",""],[51,"وقفَ الهوى بك بعد طولِ وجيفه","https://www.poetsgate.com/ViewPoem.aspx?id=29921",""],[51,"لم يزلْ قلْبُهُ إليهم مَشوقا","https://www.poetsgate.com/ViewPoem.aspx?id=29924",""],[101,"جدّدي يا رشيدُ للحبّ عَهْدَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62414&r=&rc=6",""],[20,"أنعم صباحاً علقم بن عدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70003&r=&rc=25",""],[18,"هَلْ عَرَفْتَ الْغَدَاة َ مِنْ أَطْلاَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26460&r=&rc=26",""]],"verses":[["قَد رَجَعنا ضَواحِكاً","وَمَضَينا بَواكِيا",0,"ي",2,0],["قَدَّرَ العاجِزُ أَنَّ ال","غيلَ يُخليهِ الهُمامُ",1,"م",1,0],["قَدِرتُ مِنها بِلا رُقبى وَلا حَذَرٍ","عَلى الَّذي نامَ عَن لَيلي وَلَم أَنَمِ",2,"م",1,0],["قَد رَضِيَ المَقتولُ كُلَّ الرِضا","يا عَجَبا لِم غَضِبَ القاتِلُ",3,"ل",1,0],["قَدَرَت فَذَلَّ لَها العَزيزُ مَهابَةً","لَيسَ الذَليلُ لِقادِرٍ بِذَليلِ",4,"ل",1,0],["قَدَّروا جَدَّ نِزارٍ واقِفاً","وَمَشى الجَدُّ فَما عَزّوا نِزارا",5,"ر",2,0],["قَد رَأَينا الإِحسانَ مِنكُم عِياناً","وَسَمِعناهُ عَنكُمُ أَخبارا",6,"ر",2,0],["قَدَّرْتَ أَمْرَكَ سَهْلاً تَسْتَقِلُّ بِهِ","قِلاَدَةُ اللهِ فَاعْلَمْ ذَاتُ أَثْقَالِ",7,"ل",1,0],["قَدَرٌ جَرَى فِي الخَلْقِ لاَ يَجِدُ امْرُؤٌ","عَمَّا بِهِ جَرَتِ المَقَادِرُ مَهْرَبا",8,"ب",2,0],["قَد رابَهُم مِن بَعدِ حُسنِ تَواصُلٍ","مِنّا مُباعدَةٌ وَبَينٌ مُفصِحُ",9,"ح",1,0],["قَد رامَها حِجَجاً مُذ طَرَّ شارِبُهُ","حَتّى تَسَعسَعَ يَرجوها وَقَد خَفَقا",10,"ق",2,0],["قَدَرٌ شاءَ أَن يُزَلزِلَ مِصراً","فَتَغالى فَزَلزَلَ الأَلبابا",11,"ب",2,0],["قَد راعَ دارَ العَدلِ طُغ","يانٌ وَراعَ الجامِعَه",12,"ع",2,1],["قَدَرٌ مُتاحٌ نَظرَةٌ أَرسَلتُها","فَكَأَنَّني ناضَلتُ أَحذقَ رامي",13,"م",2,1],["قَد راعَني الدَهرُ فَبُؤساً لَهُ","بِفارِسِ الفُرسانِ وَالخَنشَليل",14,"ل",1,0],["قَدْرْهَا الأَرْفَعُ لا يُبْلَغُ فِي","فَضْلِ دُنْيَا وَلا فَضْلِ دِينْ",15,"ن",1,0],["قَدْ رُزِئْنَا فَتَى عُلًى وَعُلُومٍ","أَكْبَرَتْ رُزْءهُ العُلَى وَالْعُلُومُ",16,"م",1,0],["قَدَرٌ سَاقَهُمْ فَلَمْ يُغْنِ مِمَّا","حَتَمَ الْجَهْلُ أَنْ تَكُونَ كَرِيمَا",17,"م",2,0],["قد رحم رب ودارك","إلى أهل ذا الجزيرا",18,"ر",2,0],["قد رُحت للحيّ مذعوراً أيمّمه","ولي عن الزُمَر الباكين تسآل",19,"ل",1,0],["قدرته في البيان واسعة","يتيه فيها السؤال والسأله",20,"ل",2,0],["قد رمتني يد الزمان بخطبٍ","جللٍ ما لليله أصباح",21,"ح",1,0],["قد رضِينا بذاك لولا عُتُوٌّ","أظهروه لنا على كلّ حاله",22,"ل",2,0],["قد رَثَّ عِرضاً وإن جَدّت مآزره","من كل مُخزية في وجهه شَرَط",23,"ط",1,0],["قَد رابَني نَزَعٌ وَشَيبٌ شائِعٌ","بَعدَ الشَبابِ وَعَصرِهِ الفَينانِ",24,"ن",1,0],["قُدِرنَ عَلَيهِمُ وَخُلِقنَ مِنهُم","فَما يَبلينَ ما بَقِيَ الجُلودُ",25,"د",1,0],["قَد رابَني وَلَمِثلُ ذاكَ يَريبُني","لِلغانِياتِ تَجَهُّمٌ وَنِفارُ",26,"ر",1,0],["قِدرَينِ لم يَقتَدِح وَقُودَهما","بالمَرخِ تَحتَ العَفَارِ مُنتَصِبُ",27,"ب",1,0],["قدرين لم تقتدح وقودهما","بالمرخ تحت العقار منتصب",28,"ب",1,0],["قَد رَغِبوا زَعَموا عَنّي بِأُختِهِمُ","وَفي الذُرى نَسَبي وَالمَجدُ مَرفوعُ",29,"ع",1,0],["قَد رامَني الشُعَراءُ فَاِنقَلَبوا","مِنّي بِأَفوَقَ ساقِطِ النَصلِ",30,"ل",1,0],["قدرٌ علا فرأى في كلّ شمس ضحىً","جماله فكأنَّ الشمس مرآة",31,"ه",1,0],["قدرت على الإحسان سراً وكيف لي","بنوح نسيم الشكر أصنعه سرا",32,"ر",2,1],["قد رجع الدّمع إلى غرْبه","وعن غزال الشرق لا أرجع",33,"ع",1,0],["قد رسم الحسن عليه فما","أقرأه إلا بمرسوم",34,"م",1,0],["قد رخمت فسطت بعنق حسودها","يا حبَّذا الصيغتين مرخمه",35,"ه",1,0],["قد رماني بضرّ أيوب منها","كلّ خدٍّ بصدغهِ ذي النون",36,"ن",1,0],["قد رعى الله ببقيا","ملكه هذي الرعيَّه",37,"ي",2,0],["قد رَمَيْتَ الغَرضَ المَرْ","مِيَّ إن كنتَ رميتَهْ",38,"ت",2,0],["قد ركبنا الذي ركبتَ زماناً","وركضنا في حلبةٍ وركضتا",39,"ت",2,0],["قَدَّرْتُ أنْ تَنْفُقَ الزُّيُوفُ عَلَى","طَوْلِكَ لا أن يُزَيَّفَ الوَضحُ",40,"ح",1,0],["قد رفع اللَه قدر مثلِك بال","قدْرة يا من يُطيعُهُ القَدر",41,"ر",1,0],["قدَّر اللّه حسنها فتناهَى","ويدُ اللَه تحسن التقديرا",42,"ر",2,0],["قد رأى من قد رأى يو","مَ عليٍّ يوم تعسه",43,"س",2,0],["قد رمى الناس به أختكمُ","من سفيه وحليم مستخف",44,"ف",1,0],["قدر يبور المترفون بسيفه","بحر يلوذ المعتفون بِسِيفه",45,"ف",2,0],["قد رضينا الحبيب لو كان مرضي","ياً لدينا بعهده موثوقا",46,"ق",2,0],["قد رمينا ما تبرّدْتَ به","بلظى ذوَّبٍ من جامدتك",47,"ك",1,0],["قد رددناه فادَّخِرْهُ لسِكْبا","جك والنائبات من أزمانِك",48,"ك",1,0],["قدَرِي لديك مُظاهرٌ لبليَّتي","فاصرفْ بطرفك عن جلالِ جليلِهِ",49,"ل",2,0],["قد رأيت الذي هويتَ فأرْضَيْ","تَ وأرغمتَ فارْضَ لي إرغامي",50,"م",2,0],["قَد رَأَيتُ الحُسنَ يُنسى مِثلَما تُنسى العُيوبُ","وَطُلوعُ الشَمسِ يُرجى مِثلَما يُرجى الغُروبُ",51,"ب",1,0],["قَد رَأَيتُ الشُهبَ لا تَدري لِماذا تُشرِقُ","وَرَأَيتُ السُحبَ لا تَدري لِماذا تُغدِقُ",51,"ق",1,0],["قَد رَأَيتُ النَملَ يَسعى مِثلَما أَسعى لِرِزقي","وَلَهُ في العَيشِ أَوطار وَحَقٌّ مِثلُ حَقّي",51,"ي",1,0],["قَد رَوِّعَت حَتّى لَتَخشى بُردَها","مِن أَن يَبوحَ بِسِرِّها المَكنونِ",52,"ن",1,0],["قَدَّرتُها اليَومَ الَّذي","مِقدارُهُ أَلفُ سَنَه",53,"ن",2,0],["قَد راحَ رَسولي وَكما راحَ أَتى","بِاللَهِ مَتى نَقَضتُمُ العَهدَ مَتى",54,"ت",2,1],["قَدْ رقصْنا معَ الحَيَاةِ طويلاً","وشدوْنا مع الشَّبابِ سنينا",55,"ن",2,0],["قَدْ رأيْنا الشُّعورَ مُنْسَدِلاتٍ","كلّلَتْ حُسْنَها صباحُ الورودِ",56,"د",1,0],["قَد رُمتُ يَومَ نِزالِهم","أَلا تُحصّنَني الدُروعُ",57,"ع",1,0],["قد ركبوا الهوى كأنما","الهوى مطهم",58,"م",1,0],["قد رضعنا منها الافاويق ايا","ماً فكانت لذيذة في المذاق",59,"ق",1,0],["قد رأيتم رأياً رأيت سواها","فكأنا كنا من الأضداد",60,"د",1,0],["قد رآك الغرب في كبر","ما رآك الغرب في الصغر",61,"ر",1,0],["قد رضينا قسمة الله لنا","وقرنّا بالرضا شكر الإرادة",62,"د",2,0],["قَد رَجع الأَمر بِهِ لِلأَربعِ","وَاِجتَمَع الأَمر لَهُ