{"poems":[[53,"يا عاذلان أسأتما العذلا","https://www.aldiwan.net/poem29827.html","الكامل"],[53,"بعادا فليت اليم دونك أزبدا","https://www.aldiwan.net/poem30494.html","الطويل"],[55,"بدا من أبي الفضل الهوى المتقادم","https://www.aldiwan.net/poem26122.html","الطويل"],[55,"تموت النفوس بآجالها","https://www.aldiwan.net/poem26152.html","المتقارب"],[93,"سادتي جاز فضلكم آمالي","https://www.aldiwan.net/poem9161.html","الخفيف"],[93,"وفاء كهذا العهد فليكن العهد","https://www.aldiwan.net/poem9845.html","الطويل"],[93,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[27,"ودع أمامة حان منك رحيل","https://www.aldiwan.net/poem5975.html","الكامل"],[72,"صدودك يا لمياء عني ولا البعد","https://www.aldiwan.net/poem18549.html","الطويل"],[51,"أكف الغواني بالخنا خضرات","https://www.aldiwan.net/poem9201.html","الطويل"],[51,"لعن الله خالدا","https://www.aldiwan.net/poem61945.html","مجزوء الخفيف"],[51,"أسأت فأحسن بي جهده","https://www.aldiwan.net/poem64067.html","المتقارب"],[51,"إلهي أجرني من شنيف وزيرك","https://www.aldiwan.net/poem64922.html","الطويل"],[51,"يا ليت شعري حين فارقتكم","https://www.aldiwan.net/poem66085.html","السريع"],[51,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[45,"لامت علي أنها في الدمع لم تلم","https://www.aldiwan.net/poem66653.html","البسيط"],[49,"دار وعورة سهلها","https://www.aldiwan.net/poem63094.html","مجزوء الكامل"],[69,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[102,"برقت له مسنونة تتلهب","https://www.aldiwan.net/poem33042.html","الكامل"],[46,"طرق العلكا مجهولة فكأنها","https://www.aldiwan.net/poem22571.html","الكامل"],[46,"جهلتك بل عرفتك ما خشوعي","https://www.aldiwan.net/poem23238.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55011","السريع"],[106,"ما نسيناك","https://www.poetsgate.com/ViewPoem.aspx?id=179363",""],[100,"حين يصحو الشعب","https://www.poetsgate.com/ViewPoem.aspx?id=50112",""],[90,"أمنعم القلب الخلى","https://www.poetsgate.com/ViewPoem.aspx?id=178972",""],[109,"الاولين","https://www.poetsgate.com/ViewPoem.aspx?id=8407",""],[45,"لامَتْ ، عَلَى أَنَّها في الدَّمْعِ لم تَلُمِ","https://www.poetsgate.com/ViewPoem.aspx?id=31887",""],[110,"عدة المجد يراع وحسام","https://www.aldiwan.net/poem16326.html","الرمل"],[125,"يا راهب الدير تبنا عن محبتهم","https://www.aldiwan.net/poem23769.html","البسيط"],[127,"بليت بحبِّ بين جنبيَّ مشتعل","https://www.aldiwan.net/poem796.html",""],[136,"مني لسيد الزجاله","https://www.aldiwan.net/poem48846.html","عموديه"],[165,"مقل الجآذر نبلها الألحاظ","https://www.aldiwan.net/poem67839.html","البسيط"],[175,"أعذر لفظ المحب بالعذر","https://www.aldiwan.net/poem46048.html","البسيط"],[212,"بربك هل أبقيت للناس نتفة","https://www.aldiwan.net/poem46295.html","الطويل"],[230,"أعذب الأشياء عندي","https://www.aldiwan.net/poem51169.html","مجزوء الرمل"],[230,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[271,"أعيناك حينا ترنوان إلى الزهر","https://www.aldiwan.net/poem35619.html","الطويل"],[367,"تعاور قلبي نازل بعد نازل","https://www.aldiwan.net/poem17079.html","الطويل"],[392,"يا صاح فك الناس والزم الدار","https://www.aldiwan.net/poem54577.html","عموديه"],[410,"مالي وللشفعاء فيما أرتجي","https://www.aldiwan.net/poem32268.html","الكامل"],[430,"من مجيري من قده السمهري","https://www.aldiwan.net/poem40092.html","الخفيف"],[433,"ما ضر ذاك الريم ألا يريم","https://www.aldiwan.net/poem12725.html","السريع"],[442,"وحسن جمال ليلى أن ليلى","https://www.aldiwan.net/poem14305.html","الوافر"],[459,"عجلت بحطك فيها الرحالا","https://www.aldiwan.net/poem56065.html","المتقارب"],[459,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[459,"ألا يا خليلي المجتبى من خزيمة","https://www.aldiwan.net/poem56184.html","الطويل"],[459,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[465,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[465,"خصرك هذا المخطف","https://www.aldiwan.net/poem3240.html","عموديه"],[480,"غب التحية أنهي","https://www.aldiwan.net/poem36939.html","المجتث"],[483,"سأبكي عليكم بالدموع السواكب","https://www.aldiwan.net/poem24285.html","الطويل"],[499,"يا راكضاً في طلاب دنيا","https://www.aldiwan.net/poem3693.html","مخلع البسيط"],[501,"أزعج الليل الندامى","https://www.aldiwan.net/poem37800.html","مجزوء الرمل"],[501,"والحواميم وهي أقسام مثلي","https://www.aldiwan.net/poem38024.html","الخفيف"],[525,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[552,"قباء لها أعلى الربى وخيام","https://www.aldiwan.net/poem47236.html","الطويل"],[554,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[568,"اعذر أخاك فما عليه جناح","https://www.aldiwan.net/poem69757.html","الكامل"],[587,"خافت من الرقباء يوم وداعي","https://www.aldiwan.net/poem17593.html","الكامل"]],"verses":[["أَعَذَلتُما مَن لَم يَمَلَّ هَوىً","وَتَرَكتُما عَذلَ الَّذي مَلّا",0,"ل",2,0],["أَعَذلاً عَلى أَن أُصحِبَ الجودَ مِقوَدي","وَأَرهُنَ في كَسبِ المَكارِمِ لي يَدا",1,"د",2,0],["أُعَذِّبُ عَيني بِالبُكاءِ كَأَنَّني","عَدُوٌّ لَعَيني جاهِداً لا أُسالِمُ",2,"م",1,0],["أُعَذِّبُ نَفسي بِهِجرانِها","أَخافُ إِذا زُرتُها أَن تَمَلّ",3,"ل",1,0],["اعذروا ضعف طائرٍ يتغنى","بتراجيع من بقايا الليالي",4,"ل",2,0],["أعذت برب العرش من عين حاسدٍ","طلاقة ذاك النور في الوجه إذ تبدو",5,"د",2,0],["إِعْذِرُوا فِتْيَةَ الحِمَى إِنْ يَحِيدُوا","حَيْدَةً عَنْ صِرَاطِهِ المُسْتَقِيمِ",6,"م",1,0],["أَعذَرتُ في طَلَبِ النَوالِ إِلَيكُمُ","لَو كانَ مَن مَلَكَ النَوالَ يُنيلُ",7,"ل",1,0],["أعذَّالنا مهلاً فقد بان حمقكم","وقد زاد حتى ما لحمقكُم حد",8,"د",1,0],["أعِذْ كلماتي فيه من قول قائلٍ","أرى شَجَراتٍ ما لها ثَمراتُ",9,"ت",1,0],["اعذروا الشيخ فَاستُهُ","أوردَتْهُ المواردا",10,"د",2,0],["اعذِرُوا خالداً ولا تَعذِلوه","أيها الناس قد تبيَّنتُ عُذرَه",11,"ر",2,0],["أعِذْنيَ من تلك البلاعيمِ إنها","دَهَنشارُ والدُّردور يا صاحب العرش",12,"ش",1,0],["أعذر من أنذر فليحتنِكْ","غِرٌّ وعزمي بعدها عزمي",13,"م",2,0],["أعذِر الطِرف الذي أجررتَه","في المعاني والقوافي رَسَنه",14,"ن",2,0],["أَعذَرتَ بِالسِلمِ حَتّى ظَنَّ جاهِلُهُم","أَن قَد لَهَوتَ وَقَد أَغضَيتَ مِن صَمَمِ",15,"م",1,0],["أَعذَرتَ نَفسَكَ يا أُخَي","يَ بِغَيّها وَبِجَهلِها",16,"ل",3,0],["أعذبُ الألفاظِ قولي لكَ خذْ","وأمرُّ القولِ قولي بِلَعَلْ",17,"ل",1,0],["اعذُر شُعوبَ المُسلِمينَ إِذا هَفَت","إِنّي أَرى الحَرَمَينِ يَنتَفِضانِ",18,"ن",1,0],["أعذابهُ يُدْعى حَلاوةَ روحِه","كْم منطق فيه الحقيقةُ تُقلب",19,"ب",1,0],["أَعذَرتَ طِفلَكَ سالِكاً نَهجَ الهُدى","وَلِذاكَ في طَلَبِ العُلا إِعذارُ",20,"ر",1,0],["أَعِذني مُحسِناً مِن شَرِّ نَفسي","وَأَتبِع ذاكَ لي بِشُرورِ أَهلي",21,"ل",2,0],["أُعْذِرُ مَنْ يَبْكِي حبِيباً مَضَى","وَلَيْسَ بَعْدَ اليَوْمِ بِالراجِعِ",22,"ع",1,0],["اعذُرِ السُّقْمَ إنْ عَرَاك؛ فما للسّ","قم حِسٌّ بهِ يذوق بيانك",23,"ك",1,0],["أعذر الظلم وحمّلنا الملاما","نحن أرضعناه في المهد احتراما",24,"م",2,1],["أعذَرْتُمُ لولا النوى","ووَفَيْتُمُ لو لا الزمن",25,"ن",1,0],["أعذر ولو أن العذر ,, ماهو سمين","وأصفح لنا .. يصدق من أحلام الصغار",26,"ر",1,0],["أَعْذَرْتَ بالسِّلْمِ حتى ظَنَّ جاهِلُهُنْ","أَنْ قَدْ لَهَوْتَ وقد أَغْضَيْتَ مِن ْصَمَمِ",27,"م",1,0],["أَعذَب الأَشياء في مَمنوعِها","وَبِأَعراض الدُمى يَحلو الغَرام",28,"م",1,0],["اعذرنني يا أخياتي فما برحت","لها بقايا هوى في سؤر تحناني",29,"ن",2,0],["أعذراء هذا الاسم منك نقشته","بصفحة قلبي ببالغرام ولم يزل",30,"ل",1,0],["أعذر صديقك في التأخيرْ","لأن حالُه كان واقف",31,"ف",1,0],["أَعذِر حَسودَكَ أَن يَبيتَ وَقَلبُهُ","لَهفانُ مُستَولٍ عَلَيهِ كِظاظُ",32,"ظ",1,0],["أَعْذَرَ لَفْظُ الْمُحِّب بالْعُذْر","وَاخْتَلَطَ السِّرُّ مِنْهُ بالْجَهْرِ",33,"ر",1,1],["أعذنى من أهل الخمول فإنني","أرى قربهم يدعون الشجاع إلى الجبن",34,"ن",1,0],["أعذبُ الأشياء عندي","قُبْلةٌ في صَحْن خدِّ",35,"د",1,1],["أعَذْلاً وَما عَذَلَتْنِي النُّهَى","وَلا طرَد الحِلمَ عَنّي الصِّبا",36,"ا",1,1],["أعذَّبُ في ناري وأُبصِرُ جنّتي","وما ظمأي إلا على ضَفّةِ النَّهر",37,"ر",1,0],["أَعذّالَهَ ذَكَّرتُموهُ فَأَنتُمُ","بِرُجعانِ ما ذَكَّرتُمُ كَالصَياقِلِ",38,"ل",1,0],["أعذارذى توجب له الملامه","وليس هي تنجيه في القيامه",39,"ه",1,0],["أعْذَبتَ لِي من جُودِ كفّكَ مَوردي","فصَفَا وأمْرَعَ من نَدَاكَ ربيعِي",40,"ع",2,0],["أعذارٌ للحسن أم هو لامٌ","حررتهُ يدُ الفتى البحري",41,"ي",1,0],["أُعْذُرْ فؤادي إنّه شاعرٌ","في كلّ وادٍ في هواهُ يَهيمْ",42,"م",1,0],["أعذالي على التوديع ليلى","فضدي أنت كالخازناز",43,"ز",1,0],["أعذني فقد كدّني في اللّئا","م سومي بها حاجةً لن تُنالا",44,"ل",2,0],["أعذُل منها صخرةً","ليس لها من مَصدعِ",45,"ع",1,0],["أعذيكُمُ من أن يقالَ عليكُمُ","ثوى مَعَه جودُ الجماعةِ في القبرِ",46,"ر",1,0],["اُعذُرْ أخاك فما تهجَّر مُشمِساً","حتى تقلَّص عنه ظلُّ الدَّوحةِ",47,"ه",1,0],["أعذرَ في أنني أوحدهُ","وهو على الجود فيَّ معذول",48,"ل",1,0],["أعذلاً وقد نجا","العذال سواكم أقف",49,"ف",1,0],["أعذار خل فإن هي","قد أقنعته وإلا",50,"ل",2,0],["أعذنا من البين الكثير ورعبه","وشفعه فينا فهو خير الحجائب",51,"ب",1,0],["أَعذَرُ مِنكَ الفَراشُ حالا","عَلمتَ ما يَجهَل الفَراشُ",52,"ش",1,0],["أُعْذُروا باللهِ قَلباً","عَشِقَ الحِبَّ فَهَامَا",53,"م",2,0],["أُعْذُروني ما أَرْشَدَتني المَعاني","لسَناهُ إِلاَّ وغَيَّبْتُ رُشدِي",54,"د",2,0],["اعذل وَعَنّف وَقُل ما اِسطَعتَ لا تَرَني","إِلّا كَما شاءَ وَجدي حافِظاً ذِمَمي",55,"م",2,0],["أعِذْنِيَ من قول الوشاة ومعشرٍ","لهمْ كلماتٌ حشوهنّ كِلامُ",56,"م",1,0],["أَعذَرَ مَن فَرَّ مِن حَربٍ صَبَرتَ لَها","يَومَ الحُصَينِ شِعارٌ غَيرُ مَجحودِ",57,"د",1,0],["اعْذِرْ أَخَاكَ فما عَلَيْهِ جُنَاحُ","لا غَرْوَ أَنْ تَتَأَلّفَ الأَرْوَاحُ",58,"ح",1,1],["أَعذُولُ مِنْ عَلق الهَوَى بِي عَادةٌ","فَلَقَدْ أُمِرْتُ بِأَمْرِ غَيْرِ مُطَاعِ",59,"ع",1,0]]}