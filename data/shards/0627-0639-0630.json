https://www.poetsgate.com/ViewPoem.aspx?id=155269",""],[5470,"سديم التداني","https://www.poetsgate.com/ViewPoem.aspx?id=11241",""],[5559,"من يرد للقدس نصرا","https://www.poetsgate.com/ViewPoem.aspx?id=204217",""],[5582,"أَراكَ كَئِيباً أَراكَ أَراكَا","https://www.poetsgate.com/ViewPoem.aspx?id=187214",""],[5582,"جَفا جَفْنَهُ يَوْمَ الفِراقِ رُقادُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=186903",""],[5582,"أعذّالي أعذّالي","https://www.poetsgate.com/ViewPoem.aspx?id=63558",""],[5587,"هيا نتسامح","https://www.poetsgate.com/ViewPoem.aspx?id=194341",""],[5732,"حار قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=177943",""],[5756,"اربع خناجر","https://www.poetsgate.com/ViewPoem.aspx?id=5190",""],[5756,"من تحت لتحت","https://www.poetsgate.com/ViewPoem.aspx?id=5425",""],[402,"ذلك كالرزء في الصديق الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=36332",""],[402,"ألا أيها الشهم النبيل الذي له","https://www.poetsgate.com/ViewPoem.aspx?id=35347",""],[5841,"بالقوافي وهمسها وعذب الخواطر والفصيح","https://www.poetsgate.com/ViewPoem.aspx?id=34910",""],[5848,"ماعاد الايام بيض","https://www.poetsgate.com/ViewPoem.aspx?id=48846",""],[6082,"ربما كيف وليس","https://www.poetsgate.com/ViewPoem.aspx?id=58825",""],[6082,"كفاني","https://www.poetsgate.com/ViewPoem.aspx?id=58991",""],[6097,"نُورُ الأُخُوَّةِ","https://www.poetsgate.com/ViewPoem.aspx?id=190690",""],[6102,"قَبِّليني","https://www.poetsgate.com/ViewPoem.aspx?id=184635",""],[6152,"حبك عالمي الأروع","https://www.poetsgate.com/ViewPoem.aspx?id=204685",""],[6229,"دمية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65180&r=&rc=1",""],[6233,"متى قررتِ اغتيالي!؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82692&r=&rc=35",""],[6321,"نحن من علَّم الغرامَ الغراما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63419&r=&rc=2",""],[6355,"ضمائر تُشترى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66657&r=&rc=117",""]],"verses":[["أَعَذَلتُما مَن لَم يَمَلَّ هَوىً","وَتَرَكتُما عَذلَ الَّذي مَلّا",0,"ل",2,0],["أَعَذلاً عَلى أَن أُصحِبَ الجودَ مِقوَدي","وَأَرهُنَ في كَسبِ المَكارِمِ لي يَدا",1,"د",2,0],["أُعَذِّبُ عَيني بِالبُكاءِ كَأَنَّني","عَدُوٌّ لَعَيني جاهِداً لا أُسالِمُ",2,"م",1,0],["أُعَذِّبُ نَفسي بِهِجرانِها","أَخافُ إِذا زُرتُها أَن تَمَلّ",3,"ل",1,0],["اعذروا ضعف طائرٍ يتغنى","بتراجيع من بقايا الليالي",4,"ل",2,0],["أعذت برب العرش من عين حاسدٍ","طلاقة ذاك النور في الوجه إذ تبدو",5,"د",2,0],["إِعْذِرُوا فِتْيَةَ الحِمَى إِنْ يَحِيدُوا","حَيْدَةً عَنْ صِرَاطِهِ المُسْتَقِيمِ",6,"م",1,0],["أَعذَرتُ في طَلَبِ النَوالِ إِلَيكُمُ","لَو كانَ مَن مَلَكَ النَوالَ يُنيلُ",7,"ل",1,0],["أعذَّالنا مهلاً فقد بان حمقكم","وقد زاد حتى ما لحمقكُم حد",8,"د",1,0],["أعِذْ كلماتي فيه من قول قائلٍ","أرى شَجَراتٍ ما لها ثَمراتُ",9,"ت",1,0],["اعذروا الشيخ فَاستُهُ","أوردَتْهُ المواردا",10,"د",2,0],["اعذِرُوا خالداً ولا تَعذِلوه","أيها الناس قد تبيَّنتُ عُذرَه",11,"ر",2,0],["أعِذْنيَ من تلك البلاعيمِ إنها","دَهَنشارُ والدُّردور يا صاحب العرش",12,"ش",1,0],["أعذر من أنذر فليحتنِكْ","غِرٌّ وعزمي بعدها عزمي",13,"م",2,0],["أعذِر الطِرف الذي أجررتَه","في المعاني والقوافي رَسَنه",14,"ن",2,0],["أَعذَرتَ بِالسِلمِ حَتّى ظَنَّ جاهِلُهُم","أَن قَد لَهَوتَ وَقَد أَغضَيتَ مِن صَمَمِ",15,"م",1,0],["أَعذَرتَ نَفسَكَ يا أُخَي","يَ بِغَيّها وَبِجَهلِها",16,"ل",3,0],["أعذبُ الألفاظِ قولي لكَ خذْ","وأمرُّ القولِ قولي بِلَعَلْ",17,"ل",1,0],["اعذُر شُعوبَ المُسلِمينَ إِذا هَفَت","إِنّي أَرى الحَرَمَينِ يَنتَفِضانِ",18,"ن",1,0],["أعذابهُ يُدْعى حَلاوةَ روحِه","كْم منطق فيه الحقيقةُ تُقلب",19,"ب",1,0],["أَعذَرتَ طِفلَكَ سالِكاً نَهجَ الهُدى","وَلِذاكَ في طَلَبِ العُلا إِعذارُ",20,"ر",1,0],["أَعِذني مُحسِناً مِن شَرِّ نَفسي","وَأَتبِع ذاكَ لي بِشُرورِ أَهلي",21,"ل",2,0],["أُعْذِرُ مَنْ يَبْكِي حبِيباً مَضَى","وَلَيْسَ بَعْدَ اليَوْمِ بِالراجِعِ",22,"ع",1,0],["اعذُرِ السُّقْمَ إنْ عَرَاك؛ فما للسّ","قم حِسٌّ بهِ يذوق بيانك",23,"ك",1,0],["أعذر الظلم وحمّلنا الملاما","نحن أرضعناه في المهد احتراما",24,"م",2,1],["أعذَرْتُمُ لولا النوى","ووَفَيْتُمُ لو لا الزمن",25,"ن",1,0],["أعذر ولو أن العذر ,, ماهو سمين","وأصفح لنا .. يصدق من أحلام الصغار",26,"ر",1,0],["أَعْذَرْتَ بالسِّلْمِ حتى ظَنَّ جاهِلُهُنْ","أَنْ قَدْ لَهَوْتَ وقد أَغْضَيْتَ مِن ْصَمَمِ",27,"م",1,0],["أَعذَب الأَشياء في مَمنوعِها","وَبِأَعراض الدُمى يَحلو الغَرام",28,"م",1,0],["اعذرنني يا أخياتي فما برحت","لها بقايا هوى في سؤر تحناني",29,"ن",2,0],["أعذراء هذا الاسم منك نقشته","بصفحة قلبي ببالغرام ولم يزل",30,"ل",1,0],["أعذر صديقك في التأخيرْ","لأن حالُه كان واقف",31,"ف",1,0],["أَعذِر حَسودَكَ أَن يَبيتَ وَقَلبُهُ","لَهفانُ مُستَولٍ عَلَيهِ كِظاظُ",32,"ظ",1,0],["أَعْذَرَ لَفْظُ الْمُحِّب بالْعُذْر","وَاخْتَلَطَ السِّرُّ مِنْهُ بالْجَهْرِ",33,"ر",1,1],["أعذنى من أهل الخمول فإنني","أرى قربهم يدعون الشجاع إلى الجبن",34,"ن",1,0],["أعذبُ الأشياء عندي","قُبْلةٌ في صَحْن خدِّ",35,"د",1,1],["أعَذْلاً وَما عَذَلَتْنِي النُّهَى","وَلا طرَد الحِلمَ عَنّي الصِّبا",36,"ا",1,1],["أعذَّبُ في ناري وأُبصِرُ جنّتي","وما ظمأي إلا على ضَفّةِ النَّهر",37,"ر",1,0],["أَعذّالَهَ ذَكَّرتُموهُ فَأَنتُمُ","بِرُجعانِ ما ذَكَّرتُمُ كَالصَياقِلِ",38,"ل",1,0],["أعذارذى توجب له الملامه","وليس هي تنجيه في القيامه",39,"ه",1,0],["أعْذَبتَ لِي من جُودِ كفّكَ مَوردي","فصَفَا وأمْرَعَ من نَدَاكَ ربيعِي",40,"ع",2,0],["أعذارٌ للحسن أم هو لامٌ","حررتهُ يدُ الفتى البحري",41,"ي",1,0],["أُعْذُرْ فؤادي إنّه شاعرٌ","في كلّ وادٍ في هواهُ يَهيمْ",42,"م",1,0],["أعذالي على التوديع ليلى","فضدي أنت كالخازناز",43,"ز",1,0],["أعذني فقد كدّني في اللّئا","م سومي بها حاجةً لن تُنالا",44,"ل",2,0],["أعذُل منها صخرةً","ليس لها من مَصدعِ",45,"ع",1,0],["أعذيكُمُ من أن يقالَ عليكُمُ","ثوى مَعَه جودُ الجماعةِ في القبرِ",46,"ر",1,0],["اُعذُرْ أخاك فما تهجَّر مُشمِساً","حتى تقلَّص عنه ظلُّ الدَّوحةِ",47,"ه",1,0],["أعذرَ في أنني أوحدهُ","وهو على الجود فيَّ معذول",48,"ل",1,0],["أعذلاً وقد نجا","العذال سواكم أقف",49,"ف",1,0],["أعذار خل فإن هي","قد أقنعته وإلا",50,"ل",2,0],["أعذنا من البين الكثير ورعبه","وشفعه فينا فهو خير الحجائب",51,"ب",1,0],["أَعذَرُ مِنكَ الفَراشُ حالا","عَلمتَ ما يَجهَل الفَراشُ",52,"ش",1,0],["أُعْذُروا باللهِ قَلباً","عَشِقَ الحِبَّ فَهَامَا",53,"م",2,0],["أُعْذُروني ما أَرْشَدَتني المَعاني","لسَناهُ إِلاَّ وغَيَّبْتُ رُشدِي",54,"د",2,0],["اعذل وَعَنّف وَقُل ما اِسطَعتَ لا تَرَني","إِلّا كَما شاءَ وَجدي حافِظاً ذِمَمي",55,"م",2,0],["أعِذْنِيَ من قول الوشاة ومعشرٍ","لهمْ كلماتٌ حشوهنّ كِلامُ",56,"م",1,0],["أَعذَرَ مَن فَرَّ مِن حَربٍ صَبَرتَ لَها","يَومَ الحُصَينِ شِعارٌ غَيرُ مَجحودِ",57,"د",1,0],["اعْذِرْ أَخَاكَ فما عَلَيْهِ جُنَاحُ","لا غَرْوَ أَنْ تَتَأَلّفَ الأَرْوَاحُ",58,"ح",1,1],["أَعذُولُ مِنْ عَلق الهَوَى بِي عَادةٌ","فَلَقَدْ أُمِرْتُ بِأَمْرِ غَيْرِ مُطَاعِ",59,"ع",1,0],["أعذُرُ مَن عَقَّني لأجلِك إذ","لَيسَ لَهُ في عُقُوقِه عاذر",60,"ر",1,0],["أَعذنا مِنَ الأَهواء وَالفِتَن الَّتي","أَواخرها توهي القوى وَالأَوائِلُ",61,"ل",1,0],["أَعَذولَ وَجْدي لَيْسَ عُشّكِ فادْرُجي","ونَصيحَ رُشْدي بان نصحكَ فاجْلِسِ",62,"س",1,0],["أَعِذني من قطيعةِ مستهينٍ","بما يلقى المحبُّ منَ القطيعه",63,"ع",2,0],["أعِذْ عيني من السَّهَرِ","أعِذْ قلبي من الفِكَرِ",64,"ر",1,1],["أَعَذْلُك هذا أنْ رَأَيْتَهمُ شَطُّوا","وفي الآلِ إذْ غَطَّوْا هَوادِجَهُمْ غَطُّوا",65,"ط",3,1],["أَعذُلُ فيهِ النَفسَ إِذا حيلَ دونَهُ","وَتَأبى إِلَيهِ النَفسُ إِلّا تَطَلَّعا",66,"ع",2,0],["أعُذْر بن سعدٍ لا يزالُ عليكمُ","برحْرَحَ يومٌ من فزارةَ ناصرُ",67,"ر",1,1],["أعذاره للوفود ضيقة","إن رحبت للبخيل أعذارُ",68,"ر",1,0],["أعذب اللمى وَالجنا هَل ترى","جنا النحل أعذبُ لي أَم جناكا",69,"ك",2,0],["أعذّالي أعذّالي","دَعوا حالي على حالي",70,"ل",2,1],["أعذار تأخير الصلاة تسمع","في تسعة وفي سواها تمنع",71,"ع",1,1],["أعذبُ من لفظ ابنِ مشكان في","توقيعهِ عن ملكِ المشرقِ",72,"ق",1,0],["إِعذِلي إِنَّ سَفاهاً","مِن كَبيرٍ لَكَبيرُ",73,"ر",1,0],["أَعِذَارَهُ رِفقاً عَلَيهِ فَقَد","صَدَرَ الصِّبا غَضبانَ عَنكَ أَسِف",74,"ف",1,1],["أعذني من أهل الخمول فإنني","أرى قربهم يدعو الشجاع إلى الجبن",75,"ن",1,0],["اعذارٌ عَلَى الشقيقين لاحا","ام دجى الليل قد بدالي صباحا",76,"ح",2,1],["أعُذَّالنا مهلاً فقد بان حمقُكُم","وقد زاد حتى ما لعذلكُم حدُّ",77,"د",1,0],["اعذُر أخاكَ فليس من","تِلكَ الرَّفاهة والرَّفاغَه",78,"غ",2,0],["أَعِذني رَبِّ مِن حَصَرٍ وَعيٍ","وَمِن نَفسٍ أُعالِجُها عِلاجا",79,"ج",2,1],["أَعِذني عَياذاً يا سُلَيمانُ إِنَّني","أَتيتُكَ لَمّا لَم أَجِد عَنك مُقعَدا",80,"د",2,0],["أَعذل عَينيَّ عَلى ما قَد جنت","فَكلما قاسيت مِن تَسبيبها",81,"ب",3,0],["أعذار بدا بخدّيك هذا","أم لصيد الألباب أضحى شرائك",82,"ك",1,0],["أُعذِرتَ فيهِ فَمَن تَبيّنَ عُذرهُ","وَلّى المَلامَة كُلّ مَن لَم يَعذُرِ",83,"ر",1,0],["أعذل النفس في صفات رديئاتٍ","وتلك الصفاتُ عين صفاتي",84,"ت",2,0],["أعذر الطفل مع معلمه","إن أضاع الإرشاد أو سخرا",85,"ر",2,0],["اعذرت الدنيا بانذارها","ان بنيها غرض النائبات",86,"ت",1,0],["أعذول ليس العذل منك يروعني","فيمن فتنت به ولا تدري بمن",87,"ن",1,0],["أعذتك منه باسم اللَه لما","سقى الأرواح كاسات الممات",88,"ت",1,0],["أعذره في تعذيره يا عاذرُ","فالقدح فيك قربة الرحمنِ",89,"ن",1,0],["أعذني بسيفِ الدولةِ اليومَ أن أُرى","أُخادعُ أعدائي بهِ وأُصانِعُ",90,"ع",1,0],["أعذر فتاك ولا تنكر صبابته","ولم جمالك فهو المجرم الجاني",91,"ي",1,0],["اعذر مريضاً أتى يثني عليك إذا","ما صدّه عن وفاء المدحة السقم",92,"م",1,0],["اعذر أخاك فإنه مفتونُ","ولدى فتون القلب ليس خدينُ",93,"ن",1,1],["اعذر العاشقين يا أيها الظب","ي فما هم يستوجبون الملاما",94,"م",2,0],["أعذناه بالرحمن من كيد كائدٍ","ومن شر شيطان وخبٍ مخادع",95,"ع",1,0],["أَعذَبُ الأَلحانِ لَحنٌ أَفرَغَت","فيهِ أَناتُ الأَسى طَيَّ الحَنين",96,"ن",1,0],["أُعْذُرا إِنْ أَرَدتُما أَو فَلُوما","في بَديعٍ حَسبي عِذاراهُ عُذرا",97,"ر",2,0],["أعذر أخاك فإنني ذو فطنة","عمياء بل ذو فطنة تَتَكَدَّرُ",98,"ر",1,0],["أعذب من عذب وأحلى من ضرب","عقوده قد أخرجت من صدف",99,"ف",1,0],["أعذ أصولى كذا فروعى والصحب","وبلغهمو بك الوطرا",100,"ر",2,0],["أعذب الخلق منطقا اصدق النا","س مقالا ما فاه بالفحشاء",101,"ا",2,0],["أعذابي عندكم قد عذبا","أم مطالي لذة المستأنس",102,"س",1,0],["أعذب بشعر رايق بالصدق إذ","في غير أحمد عذبه بإلا كذب",103,"ب",1,0],["أعذنا من النيران والخزي والردا","ومن كل هولٍ يا لجأ كل حائر",104,"ر",1,0],["أعذنا من المكروه وأهلك عداتنا","أنلنا منانا حسبما أنت عالمه",105,"م",2,0],["أعذر الناس من أتته المضره","من أخٍ كان يرتجي منه نصره",106,"ه",1,1],["اعذر أخا الفقر في أن","يضيق ذرعاً بنفسه",107,