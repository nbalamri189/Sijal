",""],[50,"منَعَ النَّوْمَ طارقٌ منْ «حُبابهْ»","https://www.poetsgate.com/ViewPoem.aspx?id=17108",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[90,"فطار الحمام","https://www.poetsgate.com/ViewPoem.aspx?id=178939",""],[45,"ها هوَ الشّيبُ لائِماً، فأفيقي","https://www.poetsgate.com/ViewPoem.aspx?id=32844",""],[45,"أَيُّمَا خُلَّةٍ وَوَصْلُ قَدِيمِ،","https://www.poetsgate.com/ViewPoem.aspx?id=31880",""],[91,"فتنة 13 أبريل","https://www.poetsgate.com/ViewPoem.aspx?id=53245",""],[91,"بنت سورية","https://www.poetsgate.com/ViewPoem.aspx?id=53216",""],[64,"أقتلوني ياتقاتي","https://www.poetsgate.com/ViewPoem.aspx?id=3131",""],[99,"تَفَرُّد","https://www.poetsgate.com/ViewPoem.aspx?id=16636",""],[99,"لحمُها .. وأظَافري","https://www.poetsgate.com/ViewPoem.aspx?id=16934",""],[99,"رصاصة الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=36624",""],[99,"قدر أنتِ بشكل إمرأه","https://www.poetsgate.com/ViewPoem.aspx?id=14388",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[105,"أهذا هو العدل الذي فيه أطنبوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54866&r=&rc=36",""],[105,"أتلك مصارع المستضعفينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54861&r=&rc=31",""],[31,"رَاحَ صَحبي وَلَمْ أُحَيِّ النَّوارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18873&r=&rc=136",""],[31,"","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19021&r=&rc=284",""],[20,"طال الليل علينا واِعتكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69774&r=&rc=15",""],[20,"ليس شيء على المنون بباق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70018&r=&rc=40",""],[18,"جَارَتْ بَنُو بَكْرٍ وَلَمْ يَعْدِلُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26453&r=&rc=19",""],[18,"هَلْ عَرَفْتَ الْغَدَاة َ مِنْ أَطْلاَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26460&r=&rc=26",""],[10,"لا تَخَلْ أنّني لقيتُ رواحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10487&r=&rc=12",""]],"verses":[["إِن ناطَحَ الأَكرادَ وَالأَرواما","يُرَوِّحُ الإِحسانَ وَالإِنعاما",0,"م",2,0],["إِن نَكَّسَ الإِسلامُ بَعدَكَ رَأسَهُ","فَلَقَد رُزي بِكَ مَوئِلاً وَمَآلا",1,"ل",2,0],["إِنَّ نَعّاقَ الأَعادي","أَسكَتَ الذُلُّ نَعيقَه",2,"ق",2,0],["إِن نَجتَمِع يَوماً أَكُن لَكَ جُذوَةً","حَمراءَ توسِعُ جانِبَيكَ ثِقافا",3,"ف",2,0],["إِن نَزَلوا الجَوَّ أَماتوا شَمسَهُ","وَالأَرضُ كانوا أَبَداً طِلاعَها",4,"ع",3,0],["إِنَّ نَهنَهوا زادوا مُقارَبَةً","فَكَأَنَّما يَدعونَ بِالزَجرِ",5,"ر",1,0],["إِن نالَ مِنكَ زَمانٌ في تَصَرُّفِهِ","ما لا يُمَلِّكُهُ مِن غَيرِكَ القَدَرُ",6,"ر",1,0],["إِن نَهَضَ الجَأشُ بِكُم","فَما نُبالي مَن عَثَر",7,"ر",1,0],["إِنَّني عائِذٌ بِنُعماكَ أَن أُك","ثِرَ قَولي وَأَن أُطَوِّلَ عَتبي",8,"ي",1,0],["إِن نالَ مِنكُم وِصالاً زادَهُ سَقماً","كَأَنَّ كُلَّ دَواءٍ عِندَهُ داءُ",9,"ا",2,0],["أَنَنسى لا وَمَن حَجَّتْ قُرَيشٌ","بَنِيَّتَهُ الحَبيبَ وَتَذكُرينا",10,"ن",2,0],["إنْ نَفَذَتْ فيها الرِّماحُ خِلْتَها","أراقِماً يَسْبَحنَ في الماءِ الرّوى",11,"ا",1,0],["إِن نَبَشتُم ما بَينَ مِلحَةَ فَالصا","قِبِ فيهِ الأَمواتُ وَالأَحياءُ",12,"ا",2,0],["إِنَّني لَولا خَيالٌ طارِقٌ","مِنكِ ما ذُقتُ هُجوعَ المُقَلِ",13,"ل",1,0],["إِنَّ نَفسي مُطيعَةٌ لِهَواها","لَهِجَت بِالهَوى فَقَد أَشقاها",14,"ا",3,1],["إِنَّني وَدَّعتُ قَلبي","حينَ بِالحُبِّ جَمَح",15,"ح",1,1],["إِنَّني وَدَّعتُ قَلبي طائِعاً","بَينَ سِحرٍ وَضِياءٍ وَخُنُث",16,"ث",1,1],["إِن نَأَت عَنّي فَيا وَجدي بِها","وَإِذا ما قَرَّبَتني أَقتَرِب",17,"ب",1,0],["أَنَّنِي قَدْ نَزَعْتُ عَنِ سَنَنِ الْغَي","يِ وَيَا طَالَمَا انْتَحَلْتُ مُحالَهْ",18,"ل",2,0],["إنْ نالَتِ الشُّهَداءُ جَنّاتِ العُلى","ولهُمْ نَعيمٌ عنْدَها وخُلودُ",19,"د",1,0],["إِنْ نَامَ كَانَتْ حُلْمَ أَفْكَارِهِ","أَوْ قَامَ كَانَتْ نُصْبَ مِحْرَابِهِ",20,"ب",2,0],["إِنَّني مُجرِمٌ وَأَنتَ أَحَقُّ الن","ناسِ أَن تَقبَلَ الغَداةَ اِعتِذاري",21,"ي",1,1],["إِنَّني مِنهُمُ وَإِنَّهُمُ قَو","مي وَإِنّي إِلَيهِمُ مُشتاقُ",22,"ق",1,0],["إِنَّنا لَن نَحولَ عَن عَهدِ مِصرٍ","أَو تَرَونا في التُربِ عَظماً رَميما",23,"م",2,0],["إِنَّني حُرَّةٌ كَسَرتُ قُيودي","رَغمَ رُقبى العِدا وَقَطَّعتُ قِدّي",24,"ي",1,0],["إِنَّنا عِندَ فَجرِ لَيلٍ طَويلٍ","قَد قَطَعناهُ بَينَ سُهدٍ وَوَجدِ",24,"د",1,0],["إِنَّني قَد شَهِدتُ فيكَ عَجيباً","ضاقَ عَن وَصفِهِ نِطاقُ الكَلامِ",25,"م",1,0],["إِنَّني لا آمَنُ الرُسلَ وَلا","آمَنُ الكُتبَ عَلى ما تَحتَوين",26,"ن",1,0],["إِنَّني وَالَّذي يَرى ما بِنَفسي","لَمَشوقٌ لِظِلِّ تِلكَ الرِحابِ",27,"ب",1,0],["إِنَّ نَفسَ الإِمامِ فَوقَ مُناهُم","ما تَمَنَّوا وَإِنَّني غَيرُ صابي",27,"ب",2,0],["إِنَّني مُذ هَجَرتَني","لَم أَذُق لَذَّةَ الوَسَن",28,"ن",1,0],["إِنَّني قَد عَلِمتُ وَجدَكَ بِالحَم","دِ وَإِطلاقَكَ العُناةَ سَماحاَ",29,"ح",2,0],["إِنَّ نَفسي بَعدَ صَخرٍ","بِالرَدى مُعتَرِفَه",30,"ف",2,0],["إِنْ نَبْقَ وَالأَرْوَاحُ قَدْ","ذَهَبَتْ فَمَا الأَسْمَاءُ تَعْنِي",31,"ن",2,0],["إِنْ نَبْغِ إِعْلاءهَا لا شَيْءَ يَخْفِضُهَا","فَهَلْ تَمُوتُ وَفِيهَا هَذِهِ النَسَمُ",32,"م",1,0],["إِن نَمْشِ زَحْفاً فَمَا كَزَّاتُ مُعْتَزِمٍ","مِنَّا هُدِيتُمْ وَمَا مَنْجَاةُ مُعْتَصِمِ",33,"م",1,0],["إِنَّ نَفْساً تِلْكَ الوَدَاعَةُ فِيهَا","لاَ تُسَامَى كَرَامَةً وَجَلالاَ",34,"ل",2,0],["إِن نَأَت كَانَ نأيُها الموتَ صِرفاً","أَو دَنَت لِي فَثَّم يَبدُو خَبَالِي",35,"ي",1,0],["إنني مبصرٌ تباشير صبح","مستفيض على ظلام الأماني",36,"ن",2,0],["إنني أستشف من غِيَر الده","ر انقلاباً يعمّ كل مكان",36,"ن",1,0],["أننا يا شمس في مُضطَرَب","قد ألِفْناه فلم نأتلف",37,"ف",1,0],["أنني أُبصر منكم أنجُما","لامعاتٍ في ظلام الأمل",37,"ل",1,0],["إن نفسي عن همّها ذات شغلٍ","بهموم العباد كلّ العباد",38,"د",1,0],["إن نفسي إلى الحقيقة عطشى","أفتشفين غلّةً من صاد",38,"د",1,0],["إن نَزَلُوا فالغُيُوثُ بَاكِرَةٌ","والأُسدُ أُسدُ العَرِينِ إن رَكِبُوا",39,"ب",3,0],["إِنَّنا قَومٌ إِذا ما","صَعُبَ الأَمرُ كَفَينا",40,"ن",2,0],["إن ناسبت مدحِي معاليكَ التي","شرُفت فإنَّ لكلِّ سوقٍ جالِبا",41,"ب",2,0],["إنَّ نظم المديح فرضٌ علينا","كلّ يوم لعزمه المسنون",42,"ن",1,0],["إن نطقوا بالجميلِ أو فعلوا","فللريا والكمال لله",43,"ه",1,0],["إنني لَلْحقيق بالشِّبَعِ السا","ئغِ من أكلِهِ وإن كان ماءَ",44,"ا",2,0],["إنني إنْ نفرتُ أمعنتُ في النَّف","رِ ومثلي عمن تَناءَى تناءَى",45,"ا",2,0],["إنني مؤمنٌ وإني أخو الحق","قِ عليمٌ بفَرْعهِ والنِّصابِ",46,"ب",1,0],["أنني لا أروع قلبك بالأك","ل لما فيه عندكم من بشاعه",47,"ع",2,0],["إنني إنْ خشيتُ بأسَك يا عم","رَو المخازي لمُخلصٌ توحيدَك",48,"ك",1,0],["إنْ نُبادلْ بسكنه فعلى ضنْ","نٍ بتلك الأعلاقِ عند البِدالِ",49,"ل",1,0],["إن نُعماكما تشملُ قوماً","منهمُ المرءُ لا يفي بقبالي",49,"ل",2,0],["إنَّني شاكِرٌ إذا عَنَّ بالشكْ","ر شَكورٌ وجدَّ مُطْرٍ ومُثْنِي",50,"ي",1,0],["إنني من حَمْأة مسنونة","وأرى أنك من خير الطِّيَن",51,"ن",1,0],["إن نابَهم خطبٌ درأتَ وإن بَغَوْا","مالاً ملأتَ خزائناً وخزائنا",52,"ن",2,0],["إِنَّني أَلمَحُ في أَوجُهِكُم","دَفقَةَ النورِ عَلى تِلكَ الرَوابي",53,"ي",1,0],["إِنَّني يا بَحرُ بَحرٌ شاطِئاهُ شاطِئاكا","الغَدُ المَجهول وَالأَمسُ اللَذانِ اِكتَنَفاكا",54,"ك",2,0],["إِنَّني أَشهَدُ في نَفسي صِراعا وَعِراكا","وَأَرى ذاتِيَ شَيطانا وَأَحياناً مَلاكا",54,"ك",2,0],["إِنَّني جِئت وَأَمضي وَأَنا لا أَعلَمُ","أَنا لُغز وَذَهابي كَمَجيإي طَلسَمُ",54,"م",1,0],["إِن نَفِدَ الدَمعُ مِن تَذَكُّرِها","فَجادَها بَعدَ أَدمُعي المَطَرُ",55,"ر",1,0],["إِن نامَ لَم تَرقُد هَواجِسُ روحِهِ","وَإِذا اِستَفاقَ رَأَيتَهُ كَالتَائِهِ",56,"ه",1,0],["إِن ناحَ فَالأَرواحُ في عَبَراتِهِ","وَإِذا شَدا فَالحُبُّ في نَغَماتِهِ",56,"ه",1,0],["إِنَّني بُعتُ اليَراعَ بِهِ","لا أَبيعُ الصَيفَ بِالقَلَمِ",57,"م",1,0],["إِنَّ نَفساً لَم يُشرِقِ الحُبُّ فيها","هِيَ نَفسٌ لَم تَدرِ ما مَعناها",58,"ا",3,0],["إِنَّني كُلَّما تَأَمَّلتُ طِفلاً","خِلتُ أَنّي أَرى مَلاكاً نَجِيّا",59,"ي",2,0],["إنَّني لم أجدْهُ في هاتهِ الدُّن","يا فهلْ خَلْفَ أُفْقِها من إِلهِ",60,"ه",1,0],["إنَّ نارَ الحَيَاةِ والكوثرَ المن","شودَ في ثغرِكِ الشَّهيِّ الحزينِ",61,"ن",1,0],["إنَّني ذاهبٌ إلى الغابِ يا شعبي","لأقضي الحَيَاةَ وحدي بيأسِ",62,"س",1,0],["إنَّني ذاهبٌ إلى الغابِ علِّي","في صميم الغاباتِ أَدفنُ بؤسي",62,"ي",1,0],["إِن نَشَرت تِلكَ الدُروع حَنادِساً","مَلأت لَنا هَذي الكُؤوسَ ضِياءَ",63,"ا",2,0],["إنني في شك من الأمر لا أد","ري لماذا نمضى لماذ نأتي",64,"ي",1,0],["إننا أحجمنا وهم أقدموا شو","ساً وليس الإحجام كالإقدام",65,"م",1,0],["إنني مبصر على البعد ماء","فلعلي به أبل أوامي",65,"م",2,0],["انني كلما له جئت اتلو","اقرأ الحسن والهدى واليقينا",66,"ن",2,0],["انني شاعر على الرغم من ان سبيلي","كثيرة العقبات",67,"ت",1,0],["اننا والفراق صعب سننفض","الى غير ملتقى وشهود",68,"د",1,0],["انني في شك وان ملأوا","سمعي بوعد يروونه ووعيد",68,"د",1,0],["انني ان اهلك فمن لقريضي","يتغنى به ومن لقصيدي",68,"د",2,0],["انني منذ كنت اشدو بشعري","كان يوحي الي بالتحديد",68,"د",1,0],["انني ما سجدت يوما لغير الله","فالله وحده معبودي",68,"د",2,0],["انني في جميع ما انا آت","مكره ليس في يدي قيادي",69,"ي",1,0],["انني لا اخشى عليه زوالا","انه للخلود لا للزوال",70,"ل",1,0],["انني ان تكن صروف الليالي","احوجتني صبرت صبرا جميلا",71,"ل",2,1],["انني يالشقائي","جئت في غير زماني",72,"ي",1,0],["انني لا اعد من هو يحيا","في قلوب الورى من الهالكينا",73,"ن",2,0],["انني لا ادور في بال ليلى","وسوى ليلى لا يدور ببالي",74,"ي",1,0],["انني لا اقيم في","بلد فيه احتقر",75,"ر",1,0],["انني مؤمن على الشك مني","ومن اللَه اطلب التوفيقا",76,"ق",2,0],["ان ناموس الدور اشمل نامو","س وان لم يرق هناك فريقا",76,"ق",2,0],["انني لا التذّ الا بدنيا","ي وان لم اكن بها مرزوقا",76,"ق",2,0],["انني اهوى ضحا","ك واهوى طفلك",77,"ك",1,0],["اننا يا ليلى بغير ترو","قد ركبنا من النوى شر مركب",78,"ب",1,0],["انني شاعر وغيري مثر","فانظري اينا الى المجد اقرب",78,"ب",1,0],["انني شاعر ولكنني في","كل عمري بالشعر لم اتكسب",78,"ب",1,0],["ان نفسي لا ترتضي ان تهوني","لشجوني وان ملأن اهابي",79,"ي",1,0],["انني ان بكيت ابكي شعري","ولقد أهديه الى الاحقاب",79,"ب",1,0],["انني في دنياي مثلك مدفوع","فما ذنبي ان هببت عجولا",80,"ل",2,0],["انني ان حمدت ربي على ما","اتشكى منه اكذب نفسي",81,"ي",1,0],["إنني قد أسأت ظني وربي","واقف للمسيء بالمرصاد",82,"د",1,0],["إنني قد ندمت غفرانك اللهم","من سوء مذهبي واعتقادي",82,"ي",1,0],["إنني قد زرعت إثماً فويلي","ثم ويلي إن حان يوم الحصاد",82,"د",1,0],["أننفض اليد من عز نؤمله","وتحت رايتك الآساد تزجيها",83,"ي",3,0],["إن نام عنها الحافظو","ن فان جفن الشر ساهر",84,"ر",1,0],["إننا نطمع من هذا الصبا","بالذرارىّ الكثير المستزاده",85,"د",2,0],["إِن نامَتِ الأَحياءُ حالَت بَينَهُ","سَحراً وَبَينَ فِراشِهِ الأَحلامُ",86,"م",1,0],["إِن نَحنُ أَكرَمنا النَزيلَ حِيالَها","فَالضَيفُ عِندَكِ مَوضِعُ الإِرفادِ",87,"د",1,0],["إِن نامَ عَنكَ فَكُلُّ طِبٍّ نافِعٌ","أَو لَم يَنَم فَالطِبُّ مِن أَذنابِهِ",88,"ب",2,0],["إِنَّ نُيوبَ الزَمانِ تَعرِفُني","أَنا الَّذي طالَ عَجمُها عودي",89,"د",2,0],["إِنَّني أَصيَدُ البُزاةِ وَلَكِن","نَ أَجَلَّ النُجومِ لا أَصطادُه",90,"د",2,0],["أَنَنقُصُهُ مِن حَظِّهِ وَهوَ زائِدٌ","وَنَبخَسُهُ وَالبَخسُ شَيءٌ مُحَرَّمُ",91,"م",1,0],["إنْ نامَ جَفْنُ برقِها","صاحَ به الريحُ فَهَبّْ",92,"ب",1,0],["إِن نِكتَها اللَيلَةَ فَاُنظُر إِلى","عَهدِ بَنانٍ عِندَها البارِحَه",93,"ح",2,0],["إِنَّني ما حَلَلتُ في الأَرضِ إِلّا","كُنتُ في أَهلِها المُجَلَّ المُفَدّى",94,"د",2,0],["إِن نَظَرَت قُلتُ بِها ذِلَّةٌ","أَو خَطَرَت قُلتُ بِها كِبرُ",95,"ر",1,0],["إِنَّ نَبهانَ لَم تَزَل وَعَتوداً","كَالشَقيقِ اِستَمالَ الشَقيقِ",96,"ق",1,0],["إِن نَحنُ جِئناهُ لَم تَكسُد بِضاعَتُنا","وَلَم يَحُل دونَ ما جِئنا نُحاوِلُهُ",97,"ل",2,0],["إِنَّني لاجِئٌ إِلى عَزَماتٍ","مُعدِياتٍ عَلى طُروقِ الهُمومِ",98,"م",1,0],["إِن نَحنُ لَم نَمنَع بِطاعَتِنا","وَالحُبِّ لِلمَهدِيِّ وَالشُكرِ",99,"ر",1,0],["إنني جارك يا سيدتي","والربى تسأل عن جيرانها",100,"ن",3,0],["إنني السندباد.. مزقه البحر","وعينا حبيبتي الميناء",101,"ا",2,0],["إنني أخزن الرعود بصدري","مثلما يخزن الرعود الشتاء",101,"ا",2,0],["إنني رافضٌ زماني وعصري","ومن الرفض تولد الأشياء",101,"ا",2,0],["إنني قادمٌ إليكم.. وقلبي","فوق كفي حمامةٌ بيضاء",101,"ا",2,0],["إنني والعِدا على الدَّهْرِ شَرْبٌ","نتَساقَى الرَّدَى بكأسٍ دِهاقِ",102,"ق",1,0],["إن نَكَّسُوها لم تَسَلْ فَمليكُها","فيما حَوَتْهُ عاجلاً لا يَطْمَعُ",103,"ع",1,0],["أَن نِعمَ مُعتَرَكُ الحَيِّ الجِياعِ إِذا","خَبَّ السَفيرُ وَمَأوى البائِسِ البَطِنِ",104,"ن",1,0],["أَن نِعمَ مُعتَرَكُ الجِياعِ إِذا","خَبَّ السَفيرُ وَسابِئُ الخَمرِ",105,"ر",1,0],["إِنَّني مِنها غَداً مُرتَحِل