{"poems":[[87,"كنيسة صارت إلى مسجد","https://www.aldiwan.net/poem63722.html","السريع"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16655","الكامل"],[119,"روح الوجود بآل المصطفى انتعشت","https://www.aldiwan.net/poem41793.html","البسيط"],[119,"يا آل الرسول ويا طه","https://www.aldiwan.net/poem41955.html","مجزوء الكامل"],[208,"صار التغزل في هواه عتابا","https://www.aldiwan.net/poem53367.html","الكامل"],[230,"لو أن أطلال المنازل تنطق","https://www.aldiwan.net/poem55213.html","الكامل"],[257,"ظبى المواضي وأطراف القنا الذبل","https://www.aldiwan.net/poem1419.html",""],[563,"يا شرفي بأنه يعلمني","https://www.aldiwan.net/poem33732.html","الرجز"],[563,"لا تأخذ الخلاق يا قوم","https://www.aldiwan.net/poem34085.html","أحذ الكامل"],[563,"في الكون للحق أمثال بها نطقا","https://www.aldiwan.net/poem34300.html","البسيط"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131559",""],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71041","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93544","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204651","المجتث"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74064","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74095","الكامل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125923","السريع"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132127","الكامل"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122229","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90972","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141677","الكامل"],[5102,"استفتاء","https://www.poetsgate.com/ViewPoem.aspx?id=14097",""],[5183,"روض الاخاء","https://www.poetsgate.com/ViewPoem.aspx?id=180204",""],[5189,"متى الريادة أيها العرب","https://www.poetsgate.com/ViewPoem.aspx?id=201758",""],[5365,"الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=190439",""],[5694,"من العايدين","https://www.poetsgate.com/ViewPoem.aspx?id=132100",""],[5961,"اليوم أبيض","https://www.poetsgate.com/ViewPoem.aspx?id=199807",""]],"verses":[["وَاللَهُ عَن هَذا وَذا في غِنىً","لَو يَعقِلُ الإِنسانُ أَو يَهتَدي",0,"د",2,0],["واللُه عَدْلٌ لا يَضُرّ بما","قَلْبي جَناهُ جميعَ أوْصالي",1,"ل",2,0],["واللَه عظمهم فضلاً وأكرمهم","فهم أجل عيال السادة الرسل",2,"ل",1,0],["واللَه عظمها بنص","ص كتابه فسمت ذراها",3,"ا",3,0],["واللَهُ عن علم أتاك مواهباً","إذ كنتَ تُحسِن تشكر الوهّابا",4,"ب",2,0],["وَاللَهُ عونُك إن رَكبتَ إلى العُلا","طُرُقاً تَضِلُّ بها الهُداةُ وَتَفرَق",5,"ق",1,0],["وَاللَه عَونكَ فيما أَنتَ مُزمِعُهُ","كَما أَعانَكَ في أَيّامِكَ الأَوَلِ",6,"ل",1,0],["والله علم وكلام أزلاً","وهو حروفنا لأجل الفتن",7,"ن",1,0],["والله عن روح وعن جسد","قد جلَّ لا يحكيه مفهومُ",8,"م",1,0],["والله عنه جميع الكون منتشر","كالضوء يبدو عن الضوء الذي انفتقا",9,"ق",2,0],["والله على جمع الغريب قادر","والكل في قبضة عزيز قهار",10,"ر",1,0],["واللهُ عَدْلٌ لا يجور وفِعْلُهُ","حِكَمٌ تبين لنا سَنا آياتِها",11,"ت",3,0],["واللهُ عَزَّ وَجَلَّ مُوصٍ آمِرٌ","نَاهٍ مُثيبٍ مُرسِلٌ لِبَيَانِ",12,"ن",1,0],["وَاللهُ عَابَ المُشرِكِينَ بِأنَّهُم","عَبَدُوا الحِجَارَةَ فِي رِضَى الشَّيطَانِ",12,"ن",1,0],["وَاللَه عَونك وَالسُيوف قَواطع","وَالجُند شمَّر وَالخُيول نَجائب",13,"ب",1,0],["والله عدل حكيم","ما جار بالتقسيم",14,"م",1,0],["وَاللَهُ عَونٌ للأُلى","لَهمُ عَلى اللَهِ اِعتماد",15,"د",1,0],["وَاللَه عونك يوم تنقذ للهدى","حرماً به هبط الأمين مقدّسا",16,"س",2,0],["واللّه عار يا رجال النهى","أن يظلم القانون هذا الشهيد",17,"د",1,0],["والله عن ضرع الخلائق معرض","والأرض غاضبة على الإنسان",18,"ن",1,0],["واللَه عودني الجميل فلم أزل","أرجو الجميل كما رجت آبائي",19,"ي",1,0],["وَاللهُ عَن أفعَالِه لاَ يُسأَلُ","وَالقدَرِىُّ لَم يَقُل مَا يعقَلُ",20,"ل",1,0],["واللَه عوضك الرضى وأثابنا","عنك التعوض بالمصابيح الغرر",21,"ر",1,0],["واللّه عز يداول الأيام ما","بين العباد لسابق ولقاصر",22,"ر",1,0],["والله عَدْلٌ لن يحاسبنا بما","فعل العُصاة فإنهم سفهاءُ",23,"ا",2,0],["والله عند المتقين يدا","ما كان في مرضاته الأمر",24,"ر",1,0],["والله عيبٌ ما نراهُ وما","أفتتْ به الأديان والكتبُ",25,"ب",1,0],["واللهِ عن ناظري ما غِبْتُمُ أبداً","حتى أراني كأنِّي مَسَّني العَجَبُ",26,"ب",1,0],["والله على الطاعه يجمع شملكم","أبرك مايسعدنا تجماع الشمل",27,"ل",1,0],["والله عند الظن فاغنم وصله","واشهد فقد وافاك فيك شهيد",28,"د",1,0]]}