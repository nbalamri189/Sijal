{"poems":[[63,"وله تشف وراءه الأشجان","https://www.aldiwan.net/poem46179.html","الكامل"],[9,"أصرمت حبلك من لمي","https://www.aldiwan.net/poem21911.html","مجزوء الكامل"],[70,"رق في الجو النسيم","https://www.aldiwan.net/poem42713.html","مجزوء الرمل"],[89,"إن فعل الرجال غير الكلام","https://www.aldiwan.net/poem44616.html","الخفيف"],[49,"المرء آفته هوى الدنيا","https://www.aldiwan.net/poem10322.html","الكامل"],[49,"ولقد طربت إليك","https://www.aldiwan.net/poem63233.html","مجزوء الكامل"],[48,"أنت يا ابن الربيع ألزمتني النسك","https://www.aldiwan.net/poem62603.html","الخفيف"],[48,"قد هجرت النديم والندمانا","https://www.aldiwan.net/poem65311.html","الخفيف"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/3061","الكامل"],[106,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[143,"ألكم إلى رد الشباب سبيل","https://www.aldiwan.net/poem58447.html","الكامل"],[199,"يا برق نجد هل شعرت بمتهم","https://www.aldiwan.net/poem51892.html","الكامل"],[230,"يا من به تزهى الدهور","https://www.aldiwan.net/poem51062.html","مجزوء الكامل"],[232,"يا حداة الركب الحجازي ميلوا","https://www.aldiwan.net/poem44577.html","الخفيف"],[298,"ولقد طرقت الحي من سعد","https://www.aldiwan.net/poem33289.html","أحذ الكامل"],[299,"ذهب الهوى بشغاف قلب الموجع","https://www.aldiwan.net/poem36280.html","عموديه"],[347,"ولقد طعنت الليل في أعجازه","https://www.aldiwan.net/poem23974.html","الطويل"],[353,"فرض الحبيب","https://www.aldiwan.net/poem948.html",""],[362,"أيها الخل قد صحبناك دهرا","https://www.aldiwan.net/poem68109.html","الخفيف"],[417,"من لصب في هواكم مستهام","https://www.aldiwan.net/poem54021.html","الرمل"],[417,"أكرم بطيف خيالكم من زائر","https://www.aldiwan.net/poem54150.html","الكامل"],[433,"نمت بسر غرامه الأجفان","https://www.aldiwan.net/poem12412.html","الكامل"],[459,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[465,"نظرت إلي بطرف أحوى أحور","https://www.aldiwan.net/poem3579.html","عموديه"],[467,"يا أم عمرو أنجزي الموعودا","https://www.aldiwan.net/poem50367.html","الكامل"],[467,"يا أم عمرو أنجزي الموعودا","https://www.aldiwan.net/poem50442.html","الكامل"],[483,"لي في الغرام صبابة قد أسكرت","https://www.aldiwan.net/poem24326.html","عموديه"],[501,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[516,"إن قلت قد خرست خلاخل ساقها","https://www.aldiwan.net/poem12193.html","الكامل"],[516,"خلعت عليك مواسم الأيام","https://www.aldiwan.net/poem12251.html","الكامل"],[552,"يوم الحمى ما أنت من همي","https://www.aldiwan.net/poem47212.html","أحذ الكامل"],[552,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[552,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[552,"برباعكم يا أهل يثرب حاجي","https://www.aldiwan.net/poem47907.html","الكامل"],[576,"شاب فيه العذار فازددت عجباً","https://www.aldiwan.net/poem2880.html","الخفيف"]],"verses":[["ولقد طَرَقْتُ الحيَّ يحْمِلُ شِكّتي","ظامي الفُصوصِ أديمُهُ ريّانُ",0,"ن",1,0],["وَلَقَد طَرَقتُ الحَيَّ بَع","دَ النَومِ تَنبَحُني كِلابُه",1,"ب",2,0],["وَلَقَد طافَ بِها سا","قٍ رَخيمٌ وَرَحيمُ",2,"م",1,0],["ولقد طاشت العقول عن الأغ","راض في قصد هن طيش السهام",3,"م",1,0],["وَلَقَد طَلَبتُ فَلَم أَجِد كَرَماً","أَعلى بِصاحِبِهِ مِنَ التَقوى",4,"ا",1,0],["وَلَقَد طَرِبتُ إِلَيكِ حَت","ى صِرتُ مِن أَلَمِ التَصابي",5,"ي",1,1],["وَلَقَد طالَ ما شَقيتُ وَلَكِن","أَدرَكَتني عَلى يَدَيكَ السَعادَه",6,"د",2,0],["وَلَقَد طالَ ما أَبَيتُ عَلَيهِ","في أُمورٍ خَلَعتُ فيها العِنانا",7,"ن",2,0],["وَلَقَد طَرِبتُ إِلَيكِ حَت","تى صِرتُ مِن أَلَمِ التَصابي",8,"ي",1,1],["ولقد طَلَعْتَ على بني العباس إذ","جلس الرشيد مع السُّها في مقعد",9,"د",1,0],["ولقد طرقتُ البيتَ يُكره ربُّه","والشوقُ ليس يَعيبه التطفيلُ",10,"ل",1,0],["ولقد طرقتُ الحيَّ في غَبَش الدجى","والليلُ في زِيِّ الجوادِ الأدهم",11,"م",1,0],["ولقد طرِبتُ عليه حتْ","تى كِدتُ من طربٍ أطير",12,"ر",1,0],["ولقد طاب والمهيمن ربي","منبت أصله الخليل الجليل",13,"ل",1,0],["وَلَقَد طَرَقتُ الحيَّ مِن سَعدِ","تحتَ الدُجى كالخادِرِ الوَردِ",14,"د",1,1],["ولقد طرقتُ خباءَها من بعد ما","أعفى الرقيبُ بمدلهمّ أَسفع",15,"ع",1,0],["وَلَقَد طَعَنتُ اللَيلَ في أَعجازِهِ","بِالكاسِ بَينَ غَطارِفٍ كَالأَنجُمِ",16,"م",1,1],["ولقد طربتُ لصوتِه ودلالِهِ","واحتلّتْ اللفتاتُ فيّ الأضلُعَا",17,"ع",2,0],["وَلَقَد طالَ ما اِختَبَرناك حلما","فَرَأَيناكَ أَحلم الناس صَدرا",18,"ر",2,0],["ولقد طالت عليهم حَسْرتي","فاقصروا إن تُنْصفاني من ملام",19,"م",1,0],["ولقد طربت لذكركم فكأنني","بغداد يوم قدوم عبد القادر",20,"ر",1,0],["ولقد طوى صُحُفَ الصبابَةِ كاتِمًا","فَبَدَا لها من دمعِهِ عُنْوانُ",21,"ن",1,0],["ولقد طربتُ كما حزنتُ لصوتِها","فشككتُ هل غنَّت بشجوٍ أو بكتْ",22,"ت",1,0],["ولقد طربت إلى شقائق خدّها","طربَ المشوق ولستُ بابنِ المنذر",23,"ر",1,0],["وَلَقَد طَرَقتُ كِلابَ أهلِكِ بالضُّحَى","حَتَّى تَرَكتُ عَقورهُنَّ رُكُودا",24,"د",2,0],["وَلَقَد طَرَقتُ كِلابَ أَهلِكِ بِالضُحى","حَتّى تَرَكنَ عُقورَهُنَّ رُقودا",25,"د",2,0],["ولقد طربت في حبها كلي على","يد حانها فمحوت حسن طويتي",26,"ت",2,0],["ولقد طويت بكلِّ منشورٍ بدا","سرّاً على التوحيد فيه شاهد",27,"د",1,0],["ولقد طويت السابقين بهمة","سيان خاطف برقها وبراقها",28,"ق",3,0],["ولقد طويت حياة أروع لم يزل","مغرى بنشر العلم والأعلام",29,"م",1,0],["وَلَقد طَرقتِ وَما طروقُكِ في","عِلمٍ لِقائِفِهِم ولا رجمِ",30,"م",1,0],["وَلَقد طَرقتُ الخِدْرَ فيه عقائلٌ","ما قِلْنَ إلّا في ضَمير فؤادِي",31,"د",2,0],["ولقد طَرقتَ وما طَرقتَ صبابةً","عيني ونحن إلى الرّحالِ هُجودُ",32,"د",1,0],["ولقد طلبتُ على العظيمةِ مُسعِداً","فرجعتُ منقلباً على أدراجي",33,"ج",2,0],["ولقد طَفَّل المشيبُ فقُلنا","أَحسنَ الطِّفْلَ ذا المشيبُ الطُفَيلي",34,"ل",2,0]]}