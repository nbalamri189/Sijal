{"poems":[[65,"وله تشف وراءه الأشجان","https://www.aldiwan.net/poem46179.html","الكامل"],[9,"أصرمت حبلك من لمي","https://www.aldiwan.net/poem21911.html","مجزوء الكامل"],[72,"رق في الجو النسيم","https://www.aldiwan.net/poem42713.html","مجزوء الرمل"],[91,"إن فعل الرجال غير الكلام","https://www.aldiwan.net/poem44616.html","الخفيف"],[51,"المرء آفته هوى الدنيا","https://www.aldiwan.net/poem10322.html","الكامل"],[51,"ولقد طربت إليك","https://www.aldiwan.net/poem63233.html","مجزوء الكامل"],[50,"أنت يا ابن الربيع ألزمتني النسك","https://www.aldiwan.net/poem62603.html","الخفيف"],[50,"قد هجرت النديم والندمانا","https://www.aldiwan.net/poem65311.html","الخفيف"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/3061","الكامل"],[108,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[146,"ألكم إلى رد الشباب سبيل","https://www.aldiwan.net/poem58447.html","الكامل"],[202,"يا برق نجد هل شعرت بمتهم","https://www.aldiwan.net/poem51892.html","الكامل"],[234,"يا من به تزهى الدهور","https://www.aldiwan.net/poem51062.html","مجزوء الكامل"],[236,"يا حداة الركب الحجازي ميلوا","https://www.aldiwan.net/poem44577.html","الخفيف"],[302,"ولقد طرقت الحي من سعد","https://www.aldiwan.net/poem33289.html","أحذ الكامل"],[303,"ذهب الهوى بشغاف قلب الموجع","https://www.aldiwan.net/poem36280.html","عموديه"],[351,"ولقد طعنت الليل في أعجازه","https://www.aldiwan.net/poem23974.html","الطويل"],[357,"فرض الحبيب","https://www.aldiwan.net/poem948.html",""],[366,"أيها الخل قد صحبناك دهرا","https://www.aldiwan.net/poem68109.html","الخفيف"],[422,"من لصب في هواكم مستهام","https://www.aldiwan.net/poem54021.html","الرمل"],[422,"أكرم بطيف خيالكم من زائر","https://www.aldiwan.net/poem54150.html","الكامل"],[438,"نمت بسر غرامه الأجفان","https://www.aldiwan.net/poem12412.html","الكامل"],[463,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[469,"نظرت إلي بطرف أحوى أحور","https://www.aldiwan.net/poem3579.html","عموديه"],[471,"يا أم عمرو أنجزي الموعودا","https://www.aldiwan.net/poem50367.html","الكامل"],[471,"يا أم عمرو أنجزي الموعودا","https://www.aldiwan.net/poem50442.html","الكامل"],[487,"لي في الغرام صبابة قد أسكرت","https://www.aldiwan.net/poem24326.html","عموديه"],[505,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[520,"إن قلت قد خرست خلاخل ساقها","https://www.aldiwan.net/poem12193.html","الكامل"],[520,"خلعت عليك مواسم الأيام","https://www.aldiwan.net/poem12251.html","الكامل"],[556,"يوم الحمى ما أنت من همي","https://www.aldiwan.net/poem47212.html","أحذ الكامل"],[556,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[556,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[556,"برباعكم يا أهل يثرب حاجي","https://www.aldiwan.net/poem47907.html","الكامل"],[580,"شاب فيه العذار فازددت عجباً","https://www.aldiwan.net/poem2880.html","الخفيف"],[657,"","https://poetry.dctabudhabi.ae/diwan/poem/200323","الكامل"],[814,"","https://poetry.dctabudhabi.ae/diwan/poem/104448","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48531","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38162","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70817","الخفيف"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17564","الكامل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107209","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136297","الخفيف"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35793","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69375","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69359","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77360","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67234","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93561","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137160",""],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100929","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93952","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93832","الخفيف"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71334","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62886","الكامل"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104835","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103008","الكامل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62164","الكامل"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22799","الرمل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204255","الكامل"],[4984,"من رواق جميل بثينة","https://www.poetsgate.com/ViewPoem.aspx?id=175550",""],[5183,"الدويّ الحيران","https://www.poetsgate.com/ViewPoem.aspx?id=180175",""],[5183,"طوى","https://www.poetsgate.com/ViewPoem.aspx?id=180160",""],[5324,"مرثيّة الغرم .","https://www.poetsgate.com/ViewPoem.aspx?id=207570",""],[5908,"أسفر الحي حين زارت نوار","https://www.poetsgate.com/ViewPoem.aspx?id=170973",""],[6102,"خامِس الفُصُول !!","https://www.poetsgate.com/ViewPoem.aspx?id=183982",""],[520,"خلعت عليك مواسم الأيام","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577640",""],[6202,"سبعون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86728&r=&rc=29",""]],"verses":[["ولقد طَرَقْتُ الحيَّ يحْمِلُ شِكّتي","ظامي الفُصوصِ أديمُهُ ريّانُ",0,"ن",1,0],["وَلَقَد طَرَقتُ الحَيَّ بَع","دَ النَومِ تَنبَحُني كِلابُه",1,"ب",2,0],["وَلَقَد طافَ بِها سا","قٍ رَخيمٌ وَرَحيمُ",2,"م",1,0],["ولقد طاشت العقول عن الأغ","راض في قصد هن طيش السهام",3,"م",1,0],["وَلَقَد طَلَبتُ فَلَم أَجِد كَرَماً","أَعلى بِصاحِبِهِ مِنَ التَقوى",4,"ا",1,0],["وَلَقَد طَرِبتُ إِلَيكِ حَت","ى صِرتُ مِن أَلَمِ التَصابي",5,"ي",1,1],["وَلَقَد طالَ ما شَقيتُ وَلَكِن","أَدرَكَتني عَلى يَدَيكَ السَعادَه",6,"د",2,0],["وَلَقَد طالَ ما أَبَيتُ عَلَيهِ","في أُمورٍ خَلَعتُ فيها العِنانا",7,"ن",2,0],["وَلَقَد طَرِبتُ إِلَيكِ حَت","تى صِرتُ مِن أَلَمِ التَصابي",8,"ي",1,1],["ولقد طَلَعْتَ على بني العباس إذ","جلس الرشيد مع السُّها في مقعد",9,"د",1,0],["ولقد طرقتُ البيتَ يُكره ربُّه","والشوقُ ليس يَعيبه التطفيلُ",10,"ل",1,0],["ولقد طرقتُ الحيَّ في غَبَش الدجى","والليلُ في زِيِّ الجوادِ الأدهم",11,"م",1,0],["ولقد طرِبتُ عليه حتْ","تى كِدتُ من طربٍ أطير",12,"ر",1,0],["ولقد طاب والمهيمن ربي","منبت أصله الخليل الجليل",13,"ل",1,0],["وَلَقَد طَرَقتُ الحيَّ مِن سَعدِ","تحتَ الدُجى كالخادِرِ الوَردِ",14,"د",1,1],["ولقد طرقتُ خباءَها من بعد ما","أعفى الرقيبُ بمدلهمّ أَسفع",15,"ع",1,0],["وَلَقَد طَعَنتُ اللَيلَ في أَعجازِهِ","بِالكاسِ بَينَ غَطارِفٍ كَالأَنجُمِ",16,"م",1,1],["ولقد طربتُ لصوتِه ودلالِهِ","واحتلّتْ اللفتاتُ فيّ الأضلُعَا",17,"ع",2,0],["وَلَقَد طالَ ما اِختَبَرناك حلما","فَرَأَيناكَ أَحلم الناس صَدرا",18,"ر",2,0],["ولقد طالت عليهم حَسْرتي","فاقصروا إن تُنْصفاني من ملام",19,"م",1,0],["ولقد طربت لذكركم فكأنني","بغداد يوم قدوم عبد القادر",20,"ر",1,0],["ولقد طوى صُحُفَ الصبابَةِ كاتِمًا","فَبَدَا لها من دمعِهِ عُنْوانُ",21,"ن",1,0],["ولقد طربتُ كما حزنتُ لصوتِها","فشككتُ هل غنَّت بشجوٍ أو بكتْ",22,"ت",1,0],["ولقد طربت إلى شقائق خدّها","طربَ المشوق ولستُ بابنِ المنذر",23,"ر",1,0],["وَلَقَد طَرَقتُ كِلابَ أهلِكِ بالضُّحَى","حَتَّى تَرَكتُ عَقورهُنَّ رُكُودا",24,"د",2,0],["وَلَقَد طَرَقتُ كِلابَ أَهلِكِ بِالضُحى","حَتّى تَرَكنَ عُقورَهُنَّ رُقودا",25,"د",2,0],["ولقد طربت في حبها كلي على","يد حانها فمحوت حسن طويتي",26,"ت",2,0],["ولقد طويت بكلِّ منشورٍ بدا","سرّاً على التوحيد فيه شاهد",27,"د",1,0],["ولقد طويت السابقين بهمة","سيان خاطف برقها وبراقها",28,"ق",3,0],["ولقد طويت حياة أروع لم يزل","مغرى بنشر العلم والأعلام",29,"م",1,0],["وَلَقد طَرقتِ وَما طروقُكِ في","عِلمٍ لِقائِفِهِم ولا رجمِ",30,"م",1,0],["وَلَقد طَرقتُ الخِدْرَ فيه عقائلٌ","ما قِلْنَ إلّا في ضَمير فؤادِي",31,"د",2,0],["ولقد طَرقتَ وما طَرقتَ صبابةً","عيني ونحن إلى الرّحالِ هُجودُ",32,"د",1,0],["ولقد طلبتُ على العظيمةِ مُسعِداً","فرجعتُ منقلباً على أدراجي",33,"ج",2,0],["ولقد طَفَّل المشيبُ فقُلنا","أَحسنَ الطِّفْلَ ذا المشيبُ الطُفَيلي",34,"ل",2,0],["ولقد طعنت أبا براء طعنة","شرق السنان بها وصدر الثعلبي",35,"ب",2,0],["ولقد طويت دجى الظ","لام وشبه امسين كدرا",36,"ر",2,0],["ولقد طلعت على فؤا","دي قبلما عيني تراك",37,"ك",1,0],["وَلَقَد طُبِعتُ عَلى الهَوى وَاِعتَدتُهُ","وَتغيُّرُ العادات غيرُ مسلَّمِ",38,"م",1,0],["ولقد طال ما سمُجْتَ فعالا","ولقد طال ما شُنِئتَ وشِنْتا",39,"ت",2,0],["وَلَقَد طَلَبنا في البِلادِ فَلَم نَجِد","أَحَداً سِواكَ إِلى المَكارِمِ يُنسَبُ",40,"ب",1,1],["ولَقَد طَوَيتُ عَلى هَواكِ جَوانِحي","وَسَرى الغَرامُ بِباطِني وَبِظاهِري",41,"ر",2,0],["ولقد طفت عندما هزني الشو","ق إلى الحي في الجنان الظليله",42,"ل",2,0],["وَلَقَد طَعنّا اللَيلَ في إِعجازِهِ","بِالكَأسِ بَينَ غَطارِفٍ كَالأَنجُمِ",43,"م",1,0],["وَلَقَد طُلتَ عَن مَديحي فَما أَد","رِي أَيُرضِيكَ ما أُحَبِّرُ أَم لا",44,"ل",2,0],["ولَقَد طَلَبتُ المُستَغاثَ مِنَ الهَوى","فَوَجَدتُ مِن جُودِ المُعِزِّ غِياثا",45,"ث",2,0],["وَلَقَد طَرَقتُ نَدِيَّهُمُ في لَيلَةٍ","مُستَطلِعاً فَنَظَرتُ ما لَم أَنظُرِ",46,"ر",1,0],["ولقد طالَ ليه فمتى يط","لعُ فيه جمالُ وجهك بَدرا",47,"ر",2,0],["وَلَقَد طُبعت عَلى السَماح الغمر في","زَمَن بِهِ حَتّى السَحاب شحاح",48,"ح",1,0],["ولقد طلبت لي العزاء فلم اجد","الا بنيه السادة الاحرارا",49,"ر",2,0],["ولقد طلعنَ من العُبا","ب أهلةً وسنحنَ عُفرا",50,"ر",2,0],["ولقد طالما ظننت رضاه","وأراني خلاف ما كان ظني",51,"ن",2,0],["ولقد طال ما تمنيت أني","بنصيب من مدح بابك أظفر",52,"ر",1,0],["وَلَقَدْ طَرَقْتُ الحَيَّ بَيْنَ خِيَامِهِ","فَكَأَنَّنِي لِلسُّقْمِ مِنْ أَطْنَابِهَا",53,"ب",3,0],["ولقد طعنتُ دُجى الظلامِ بِمَرجَمٍ","يُغنيهِ عن اِدلاجهِ التَّأْويْبُ",54,"ب",1,0],["ولقد طمعت بما تحدثني المنى","والشوق يغري الصب في اطباعه",55,"ع",2,0],["ولقد طمعتم أن تنالوا نيلنا","طمع الجهول بمستحيل الحال",56,"ل",1,0],["ولقد طلبت رضا البرية جاهداً","فإذا رضاهم غاية لا تدرك",57,"ك",1,1],["وَلَقَد طالَ بأَبوا","بِ الخُرَيمِيِّ اِقتِصاصي",58,"ص",2,0],["ولقد طلبت فلم أجد شيئاً سوى","كافورة لم آل في إعدادها",59,"د",3,0],["ولقد طرحت على الزمان تساؤلي","أترى أشد إلى الديار رحاليا",60,"ل",3,0],["ولقد طالما تخيلها العق","ل فأوفى منها على المحجوب",61,"ب",1,0],["ولقد طال قبلك الواصل الأو","ل لما تبين الأعلاما",62,"م",2,0],["ولقد طويتُ من الغرامِ صحائفا","ولقد محوتُ برغبتي ذكراكِ",63,"ك",1,0],["ولقد طاب للورى منه خلق","وبدت فيه عفة ووقار",64,"ر",1,0],["وَلَقَد طَرَقتُ جَماجِمَ الإِحساسِ تَح","تَ مَطارِقِي, فاهتَزَّ مِنها الآيِسُ",65,"س",1,0],["ولقد طويت حياة أروع لم يزل","مغرىً بنثر العلم والإعلام",66,"م",1,0],["ولقد طلبت المستحيل فلا أرى","عوْدا لما يمضي من الأعمار",67,"ر",1,0]]}