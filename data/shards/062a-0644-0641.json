aspx?id=37624",""],[5438,"زَبَدُ الأَسَى","https://www.poetsgate.com/ViewPoem.aspx?id=202062",""],[5461,"لا هنت","https://www.poetsgate.com/ViewPoem.aspx?id=8541",""],[5563,"بيروت تثعب","https://www.poetsgate.com/ViewPoem.aspx?id=215318",""],[5649,"ركب الخير","https://www.poetsgate.com/ViewPoem.aspx?id=39018",""],[5660,"مِنَ اللَيلِ أَشواقٌ أَضَرَّت جَوانِحي","https://www.poetsgate.com/ViewPoem.aspx?id=27422",""],[5664,"الجراح","https://www.poetsgate.com/ViewPoem.aspx?id=46385",""],[5693,"رباعيات . خفقات قلب.","https://www.poetsgate.com/ViewPoem.aspx?id=34848",""],[5725,"حفظتك في قلبي عراقا مبجلا","https://www.poetsgate.com/ViewPoem.aspx?id=179745",""],[5748,"وفتيانٍ مصاليتٍ كرامِ","https://www.poetsgate.com/ViewPoem.aspx?id=26242",""],[5756,"ادلعها واولعها","https://www.poetsgate.com/ViewPoem.aspx?id=5414",""],[5790,"تلفت والله روحي","https://www.poetsgate.com/ViewPoem.aspx?id=111989",""],[5848,"بديت انهار","https://www.poetsgate.com/ViewPoem.aspx?id=48992",""],[5909,"تَلُفَ الحِجا لمّا ولجتُ حِماكا","https://www.poetsgate.com/ViewPoem.aspx?id=210245",""],[5909,"تلفتُّ حتى لم يَبِنْ من خيالها","https://www.poetsgate.com/ViewPoem.aspx?id=210575",""],[6093,"تلفت قلب","https://www.poetsgate.com/ViewPoem.aspx?id=207221",""],[6124,"تلفتنا","https://www.poetsgate.com/ViewPoem.aspx?id=174705",""],[6142,"في ذكره الله آخى المسلمين وسا","https://www.poetsgate.com/ViewPoem.aspx?id=155717",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[6167,"بحرُ الكِذَاب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85575&r=&rc=58",""],[6198,"عيناكِ أسطورتان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79269&r=&rc=43",""],[6201,"بقايا سهر!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87484&r=&rc=8",""],[406,"خيام المبعدين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=854&r=&rc=45",""],[406,"نقش على حائط الجراح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63257&r=&rc=76",""],[5561,"حلو الكلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86130&r=&rc=4",""],[6310,"السُّبات الدَّامي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74588&r=&rc=16",""],[6316,"العشق أبها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65166&r=&rc=1",""],[5190,"يا رائعَ النَّفَحاتِ عُد مُتَفَضِّلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85081&r=&rc=156",""]],"verses":[["تَلَفَّتُّ وَالرَملُ ما بَينَنا","وَأَعلامُ ذي بَقَرٍ أَو رُباهُ",0,"ا",2,1],["تَلَفُّتَ جُوَّعِ الآسادِ فاتَت","فَرائِسَها النُيوبُ وَقَد دَمينا",1,"ن",2,0],["تَلَفَّعَ في ثَنيِ عَباءٍ مُشَبرَقٍ","أَصابيغُ أَلوانِ الدِماءِ تَبُلُّهُ",2,"ل",2,0],["تَلَفَّت إِلى آبائِكَ الغُرِّ هَل تَرى","مِنَ القَومِ باقٍ جاوَزَتهُ حُبولُ",3,"ل",1,0],["تُلِفُّ بِأَعرافِ الجِيادِ رِماحَها","وَتَنشُرُ مِن أَطمارِ بيضٍ بَواتِكِ",4,"ك",1,0],["تَلُفُّ بِهِ لَفَّ الحُداةِ جَمائِلاً","يُزادُ عَنِ البَيداءِ طَرداً مُدَفَّعا",5,"ع",2,0],["تَلَفَّتَ دونَ الرَكبِ وَالعَينُ غَمرَةٌ","وَقَد مَدَّها سَيلُ الدُموعِ بِما مَدّا",6,"د",2,0],["تَلَفَّتَ حَتّى لَم يَبِن مِن بِلادِكُم","دُخانٌ وَلا مِن نارِهِنَّ وُقودُ",7,"د",1,0],["تَلَفَّتَ القَلبُ نَحوَالرَّكبِ حينَ ثَنى","عَنِ التأَمُّلِ طَرْفِي دَمعِيَ الهَتِنُ",8,"ن",1,0],["تَلَفَّتُ نَحوي في اِرتِقابٍ وَخيفَةٍ","تَلَفُّتَ ظَبيٍ في الصَّريمَةِ سانِحِ",9,"ح",1,0],["تَلَفَّتَ بالثَّوِيّةِ نحوَ نَجْدِ","فَباتَ فؤادُهُ عَلِقاً بوَجْدِ",10,"د",1,1],["تَلَفَّتُّ خَلفي حَيثُ لَم تَبقَ حيلَةٌ","وَزَوَّدتُ عَيني نَظرَةً وَهيَ تَدمَعُ",11,"ع",1,0],["تُلفى السِيادَةُ ثَمَّ إِن أَضلَلتِها","وَمَتى فَقَدتِ السَروَ فَهوَ هُناكِ",12,"ك",1,0],["تلفت الجيد للرجوع انصياعاً","كفطيم رأى على البعد ذيبا",13,"ب",2,0],["تَلَفّعت بدَريس منن تخرُّقه","تخال طُرَّتَه بعضَ التقازيح",14,"ح",1,0],["تلفون به إلى الغيب نُصغي","وتلسكوبنا إلى الأرواح",15,"ح",1,0],["تَلَفَّتُ وَهيَ تَحتَكَ يا اِبنَ قَينٍ","إِلى الكيرَينَ وَالفَأسِ الكَهامِ",16,"م",1,0],["تُلفى العِلاب إذا أدررتُمُ دِرراً","ملأْن بين قرارات وأصبار",17,"ر",1,0],["تَلفَحُهُنَّ حَرورٌ كُلَّ هاجِرَةٍ","فَكُلُّها نَقِبُ الأَخفافِ مَجهودُ",18,"د",1,0],["تَلَفي فيكَ حَياتي","وَضَلالي فيكَ رُشدي",19,"د",2,0],["تُلْفي الشَّديدَ صَريعاً","تُبْقي الأديبَ حِمارا",20,"ر",2,0],["تلفت الروض لما صحت هاتفة","كما تلفتت الركبان بالحادي",21,"د",2,0],["تلفتت الفنون وقد تولى","فلم تجد النصير ولا الوليا",22,"ي",2,0],["تَلَفُ الَّذي اِتَّخَذَ الجَراءَةَ خُلَّةً","وَعَظَ الَّذي اِتَّخَذَ الفِرارَ خَليلا",23,"ل",2,0],["تَلَفَّتَ فَوقَ القائِمينَ فَطالَهُم","تَشَوُّفُ بَسّامٍ إِلى الوَفدِ قاعِدِ",24,"د",1,0],["تَلَفَّتُّ مِن عُليا دِمَشقَ وَدونَنا","لِلُبنانَ هَضبٌ كَالغَمامِ المُعَلَّقِ",25,"ق",1,0],["تَلَفُ الحِلمِ أَن يُطاعَ التَصابي","وَرَدى اللَهوِ أَن يَشيبَ القَذالُ",26,"ل",1,0],["تلفتي... تجدينا في مباذلنا..","من يعبد الجنس، أو من يعبد الذهبا",27,"ب",2,0],["تلفتُّ في أوطانِهم فتكلمتْ","دموعي وهمَّ الشَّوقُ أن يتكلَّما",28,"م",2,0],["تَلَفَّتُّ بعدَ الأربعينَ وأسرَعَت","عِجالاً فلم يَربَعْ عليَّ رَبِيعُها",29,"ع",3,0],["تَلفُ النُضارِ عَلى العُقارِ غَنيمَتي","وَفَراغُ راحاتي عَلى الراحاتِ",30,"ت",1,0],["تُلَفِّقُ كِذباً ثُمَّ تَأتي بِضِدِّهِ","إِذا سَأَلوا تَكريرَ ما كُنتَ حاكِيا",31,"ي",2,1],["تلفَّت القلبُ مطعوناً لوحدته","وأين وحدته باتت كما باتا",32,"ت",2,0],["تلفت القلب مكروبا لها حسرا","وعض من أسف إبهامه ندما",33,"م",2,0],["تَلفّتُ أحياناً بعينٍ كحيلةٍ","وجيدٍ على طول اللواءِ مظلّلِ",34,"ل",1,0],["تَلِفَتْ مكاتيبُ الأنامِ بفعلهِ","وأبانَ عن طيشٍ وكثرةِ مَخْرَقهْ",35,"ه",1,1],["تَلَفَّتُ نَحوَ الحَيِّ حَتّى وَجَدتُني","وَجِعتُ مِنَ الإِصغاءِ ليتاً وَأُخدَعا",36,"ع",2,0],["تَلفُّ الدُجى في غَمرةِ الهَمّ بِالدُجى","وَتَلبس أَهوالَ السُرى وَالدَواهيا",37,"ي",2,0],["تَلفَّتتِ النِّساءُ ولا رِجالٌ","سِوَى السُّرُجِ الزواهرِ كالدّراري",38,"ر",2,0],["تلفتوا ينظرون الدورَ شاهقةً","من حولها النخلُ تحنيها العثاكيل",39,"ل",1,0],["تَلُفُّهُما في العُنصُرِ الحُرِّ نِسبَةٌ","كَما قُبِسَ المِصباحُ أَو قُسِمَ الرِدا",40,"د",2,0],["تلفت قَلبي إِلى الكرملِ","وَحنَّ إِلى عَهدِهِ الأَوِّلِ",41,"ل",1,1],["تلفت كَما شئت وَاخفق لَهُ","سَحائِبُ هَمك لا تَنجلي",41,"ل",2,0],["تَلَفَّتَ في دُنياهُ سابِحُ غَمرَةٍ","إِلى السَيفِ لَهَفاً بَعدَ ما وَسِطَ اللُجا",42,"ج",2,0],["تَلَفَّعَ بِالعَباءِ رِجالُ صِدقٍ","وَأَوسَعَ غَيرُهُم سَرَقاً وَلاذا",43,"ذ",2,1],["تُلفي الكَبيرَ عَلى تَقادُمِ سِنِّهِ","وَالطَبعُ فيهِ طَماعَةٌ وَكِثارُ",44,"ر",1,0],["تَلَفُ البَصائِرِ وَالزَمانُ مُفَجَّعٌ","أَدهى وَأَفجَعُ مَن تَوى الأَبصارِ",45,"ر",1,1],["تُلفي بِها رَيبَ الزَمانِ مُوَكَّلاً","إِن لَم يَزُرها بِالنَهارِ سَرى لَها",46,"ل",3,0],["تلفِظُها في الصكِّ أَقلامُهُمْ","كأَنَّما أَقلامُهُمْ أَلسُنُ",47,"ن",1,0],["تلفت يا عليُّ تجد وفاء","وما احتاج الوفاء إلى دليل",48,"ل",1,0],["تلفَّتْ فهذا خيالُ التي","مَرِحت وغرَّدَت في وَكرِها",49,"ر",3,0],["تلفَّتَ القلبُ في ليلاءَ باردةٍ","يبكي لياليك الغُرَّ المضيئاتِ",50,"ت",1,0],["تُلْفى لها ثِقَةُ الحَمائمِ أنها","في مَرْبَعٍ فتَهيجُ في تَسْجاعها",51,"ع",3,0],["تلفت الناس وراعهم عجب","الكوكب الشرقي في الغرب احتجب",52,"ب",1,0],["تلفتت ظبية الوادي فقلت لها","لا اللحظ فاتك من ليلى ولا الجيد",53,"د",1,1],["تَلَفَّتَ يَرْنُو بِيَاقُوتَتَيْنِ","وَسَالَ دَماً صُلْبُهُ وَالذَّنَبْ",54,"ب",1,0],["تَلِفتِ يا نَفسُ إِثرَ قَومٍ","راعَكِ مِن حَبلِهِم بَتاتُ",55,"ت",1,0],["تَلَفَّتُّ أَيْنَ الرَّوْضُ أينَ مكانَهُ","وأَيْنَ مَجاليه وأَيْن بَوَاكِره",56,"ر",2,0],["تلفَّتَ في الأضلاعِ حَيْرانَ يائساً","وأنَّ كما أنَّ السجينُ المُعذَّبُ",57,"ب",1,0],["تلفّت حوله فرأى عليّا","ولم يبصر له في الطب نِدَّا",58,"د",2,0],["تَلفَّتَ في الآفاقِ شَرْقاً وَمغْرِباً","فَلمْ يرَ في أَنحائِهَا مَن يُماثلُه",59,"ل",2,0],["تلفَّت الجيش عبر المَنْشِ من فزع","إذ ذاك، وانتْقَضَ الأُسطول مذعورا",60,"ر",2,0],["تلفّتت كالسارق الخائف","إلى العشيق اللّاهث الراجف",61,"ف",1,1],["تلُفُ طَغامَهمْ نِكساً فنِكساً","إلى يَومٍ تَلفُّهُمُ جِماعا",62,"ع",2,0],["تلفعت بالتقوى وثوبك غيره","فلله ذياك الضلال الملفع",63,"ع",1,0],["تَلفَّتُّ أطرافي ألمُّ شتائتاً","من الذكرياتِ الذّاهباتِ الرواجع",64,"ع",1,0],["تَلَفُ الحِلْمِ أَنْ بُطَاعَ التَّصَابي ،","وَرَدَى اللَّهْوِ أَنْ يَشِيب القَذَالُ",65,"ل",1,0],["تلّفّت لا شملي جميع ولا الهوى","قريب ولا فرع الصبى عبق نضر",66,"ر",1,0],["تلفِتُ الجيد للرجوع انصياعا","كفطيم رأي على البعد ذِيا"