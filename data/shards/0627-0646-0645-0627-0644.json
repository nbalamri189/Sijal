{"poems":[[57,"أخذ الله لقلبي من ظلوم","https://www.aldiwan.net/poem26101.html","الرمل"],[53,"سلني قد مللت طول الغرام","https://www.aldiwan.net/poem66361.html","الخفيف"],[93,"أي خطب دها فبات المهجر","https://www.aldiwan.net/poem8965.html","عموديه"],[93,"أشرف البدر على الغاية","https://www.aldiwan.net/poem62629.html","عموديه"],[51,"سكن يبقى له سكن","https://www.aldiwan.net/poem63121.html","المديد"],[52,"حييا صاحبي أم العلاء","https://www.aldiwan.net/poem64891.html","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21141","الرمل"],[108,"شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=179472",""],[102,"ضائع في المدينة","https://www.poetsgate.com/ViewPoem.aspx?id=50409",""],[133,"شعشع الخمر وهات","https://www.aldiwan.net/poem67438.html","مجزوء الرمل"],[214,"سواه لو ذبت من نواه","https://www.aldiwan.net/poem13359.html","مخلع البسيط"],[227,"رق لما هواك عقلي فما يقدر","https://www.aldiwan.net/poem55469.html","الخفيف"],[234,"عن لي أن أقبلك","https://www.aldiwan.net/poem50890.html","مجزوء الخفيف"],[259,"في الهوى لست وحدي","https://www.aldiwan.net/poem25017.html","مجزوء الرمل"],[264,"ليس يخفى ما كان بالحب فاشي","https://www.aldiwan.net/poem35780.html","الخفيف"],[275,"هبط الليل ولما أن دجا","https://www.aldiwan.net/poem35240.html","الرمل"],[275,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[284,"لا تلوموا عليه قلب محب","https://www.aldiwan.net/poem2643.html","الخفيف"],[411,"وبصير بمعاني الشعر","https://www.aldiwan.net/poem49609.html","مجزوء الرمل"],[453,"بالشعب من شرقي نجد غزال","https://www.aldiwan.net/poem53735.html","السريع"],[484,"جنحت للغروب شمس الأصيل","https://www.aldiwan.net/poem37184.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122745","الخفيف"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137343",""],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101496","الرمل"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124040","الخفيف"],[357,"","https://poetry.dctabudhabi.ae/diwan/poem/142203","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59039","السريع"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72315","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56309","الرمل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48954","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48222","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109425","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60913","الخفيف"],[2598,"","https://poetry.dctabudhabi.ae/diwan/poem/17377","الرمل"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70336","الرجز"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112286","الرمل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112347","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91457","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132141","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111450","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4217,"","https://poetry.dctabudhabi.ae/diwan/poem/123948","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83442","الخفيف"],[4727,"عش عزيزا ولا تعش تحت قِدّ","https://www.poetsgate.com/ViewPoem.aspx?id=208016",""],[5013,"كم ذا يقاطعني من لا أقاطعه","https://www.poetsgate.com/ViewPoem.aspx?id=170965",""],[5150,"أي قلب تملكين ...؟!","https://www.poetsgate.com/ViewPoem.aspx?id=203781",""],[5324,"رواء .","https://www.poetsgate.com/ViewPoem.aspx?id=207629",""],[5376,"لا تكلُّوا يا صحابي","https://www.poetsgate.com/ViewPoem.aspx?id=188464",""],[5376,"الشهد بالزهر ما ان نلت أحلاه","https://www.poetsgate.com/ViewPoem.aspx?id=188553",""],[5691,"الأماني الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=206740",""],[5937,"قهوةُ البلابِلْ","https://www.poetsgate.com/ViewPoem.aspx?id=211802",""],[6089,"عجبي للعقولِ","https://www.poetsgate.com/ViewPoem.aspx?id=212942",""]],"verses":[["إِنَّما لاطَفتُهُ أَخدَعُهُ","قُلتُ كَي يَشفَعَ لي عِندَ ظَلوم",0,"م",1,0],["إنَّ ما لا يكونُ نقصانُ وجْدي","كيف أرجو نقصانَ ما هو نامي",1,"م",2,0],["إِنَّما لَم يَغِب عَنِ الأَفهامِ","فَهوَ باقٍ فينا مَدى الأَيّامِ",2,"م",1,0],["إِنَّما لَو كُنتَ لَيثاً","ذا نُيوبٍ وَمَخالِب",3,"ب",1,0],["إِنَّ مالَ المَرءِ لَيسَ لَهُ","مِنهُ إِلّا ذِكرُهُ الحَسَنُ",4,"ن",1,0],["إِنَّما لَذَّةُ الجَوادِ اِبنِ سَلمٍ","في عَطاءٍ وَمَركَبٍ لِلِقاءِ",5,"ا",2,0],["إنَّمَا لِقحَتُنَا باطِيَةٌ","جَونَةٌ يَتبَعُهَا بِرزِينُهَا",6,"ه",2,1],["إنما للشعر محيط، فاسلمي","ودعي أمواجه تقذف بي",7,"ب",2,0],["انما لو لمست جيب غني","في قوي قبضتيه قوتي ، ومنعي",8,"ع",2,0],["إِنَّ ما لاحَ هو غيرُ","الذي خَلفَ السُتور",9,"ر",1,0],["ان مال عني فلا عجيب","للغصن ان مال مع هواه",10,"ا",2,0],["إنما لاح من لطافتها إن","سان عين الراءين عند العيان",11,"ن",1,0],["إنما لاح بدر وج","هِك عِندِي بِلا فَلَكْ",12,"ك",1,0],["إنما لومي حسوداً","كالَ لي غَمّاً وذُلا",13,"ل",2,0],["إنّما للمحبّ رقّة طبعٍ","مثل ريح الصبا رقيق الحواشي",14,"ش",2,0],["إنَّما لي وطرٌ في وطني","ليسَ يُقضى فرَحيلي عن حِجى",15,"ج",2,0],["إن مالَ مالت به الغبراء واجفةً","أو قالَ قالت له العلياءُ آمينا",16,"ن",2,0],["إنما لحظُه أَراق دماءً","وبدا أُثْرها على وَجْنَتَيْه",17,"ه",1,0],["إنّ مالي يا حبيبي","لازِمٌ لا يتَعدّى",18,"د",2,0],["إن مال عني أو إلى وصلتي","غصن النقام",19,"م",1,0],["إنما ليس للحوادث حين","أغطش الليل وادلهم الظلام",20,"م",1,0],["إنَّما لِابنِ حِميَرٍ قَدَمُ السَّب","قِ وَحيداً وتَستَوي الأقَدامُ",21,"م",1,0],["إِنما لبنانُ يُزهى بكما","مثلما تُزهى السما بالنبرين",22,"ن",1,0],["انما لحبُّ انفصالٌ واتصا","لٌ لشكوى او عتابٍ وسَمَر",23,"ر",1,0],["أن مالي من اصطبار تولّى","إذ تولّى إنسانُ عين الوجود",24,"د",1,0],["إنما لا أنتشي إلا بها","فهي خمر تسكن الأفراح دنه",25,"ن",2,0],["إن مالَ هَزَّ الطرفُ بيضَ الظُّبَى","أو قالَ هَزَّ العطفُ سُمْرَ الرّمَاحْ",26,"ح",1,0],["إن مال عني فقد مال النعيم وإن","يمل إلي أجده غاية الأمل",27,"ل",1,0],["إنما لي شرفٌ يشفي الأسى","وكذا ينفي عظيم الوجلِ",28,"ل",1,0],["إنما لومُنا علينا لأَنَّا","نرتضي من حُكّامِنا اْستعبادا",29,"د",2,0],["إِن مالَ غصنٌ خلت قدَّكِ ماَئِساً","أو ذقتُ كأساً خِلْتُ ذلكَ فاكِ",30,"ك",1,0],["ان مال عِطفاً لا يميل تعطفاً","نحو المحب الهائم الولهان",31,"ن",1,0],["إنما لابن حِمْيَر قدمُ السَّبْقِ","وحيداً أو تستوي الأقدام",32,"م",1,0],["إِنَّما لِقحَتُنَا بَاطِيَةٌ","فَإِذا ما مُزِجَت كَانَت عَجَب",33,"ب",1,1],["إنما لذة عيشي في الهوى","لا أبالي بنعيم أو شقا",34,"ق",2,0],["إنّما لما بها الخطبُ طمى","علِموا كيفَ اصطِدام الرّاسيات",35,"ت",1,0],["إنّما لمّا طوينَا ساعةً","يعلمُ اللهُ بها كم قد طوينَا",36,"ن",2,0],["إِن مالَ مالَت دُونه قُضُبُ النَقا","وَإِذا رَنا ردّ الظُّبا خَجِلات",37,"ت",1,0],["إن مالاً جمعته مستفيضاً","هو في عرف غيرك المستحيل",38,"ل",1,0],["إنما للسرور يلقى سبيلا","ذاك أن أبلغوه حيّاً أخيلا",39,"ل",2,0],["إنما لي فوق الجميع شجاكا","آهٍ لو فهمت لي ببعض الكلام",39,"م",1,0],["إِنَّما لي بِالأَمرِ غَيرُ مَرامٍ","فادَّكِرهُ إِذَا بَطَشتُ ادِّكارا",40,"ر",2,0],["إنما لأفخار يبقى ولا أم","ن لنكسٍ يوم الوغى فرار",41,"ر",1,0],["إنما لذة الحياة صحاب","وشراب على غنى وغناء",42,"ا",2,0],["إنما للنوح داعٍ لي ولي","من رأى صابي وأوصابي عَذَر",43,"ر",1,0],["إِنَّما لَذَّةُ الرِضى بِقَضاءِ ال","لهِ قد أَذهبت جَميعَ البَلاءِ",44,"ا",2,0],["إنما لذة الحياة إباءٌ","وبها الفرقُ بين حُرّ وعبدِ",45,"د",1,0],["إن مال عني لأوهام وودعني","فإنني وذمامي لا أوادعه",46,"ع",2,0],["إنما لم يخبروا عن خمرةٍ","أخذتْ بالنومِ من بينِ الجفونْ",47,"ن",1,0],["أنّما للشمس لابد غروب..","وحياة المرء.... سعد وشقاءُ",48,"ا",2,0],["انمَّا للظلم يومٌ","من زنودٍ بالشبابِ",49,"ب",1,0],["ان مال قلبي وقلب الالف ساكنه","اعود من قلبه للعمر أحياه",50,"ا",2,0],["إنما لي قصة ٌمعْ","هذه الدنيا البخيلهْ",51,"ل",2,0],["إنما ، لم أزل بعشقي ،، وقلبي","قمرٌ في هواكِ ، دُونَ مَنَازِلِ",52,"ل",1,0],["إنما لي قصيدةٌ علّمتْني","في الملماتِ كيف ألقى الرياحا",53,"ح",2,0]]}