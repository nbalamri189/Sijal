{"poems":[[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77610","الرجز"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110333","الكامل"],[5561,"قل لي من تكون ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86133&r=&rc=1",""]],"verses":[["وَلَمَّ ما جَمَّعَهُ وَحَصَّلا","وَرَكب البَحر وَفارق الخَلا",0,"ل",2,0],["ولممتم الشمل الشتيت من المنى","فهفت إليَّ مناي بعد شتات",1,"ت",1,0],["ولممتَ أشتاتي تُعلّمني هروب المرسلينْ","وتَجرُّني الآثامُ نحوَ التيهِ,تيهِ الآثمينْ",2,"ن",1,0]]}