{"poems":[[31,"صدع الخليط فشاقني أجواري","https://www.aldiwan.net/poem6065.html","الكامل"],[64,"لجلال قدرك تخضع الأقدار","https://www.aldiwan.net/poem52392.html","الكامل"],[47,"أطلب النوم كي يعود غراره","https://www.aldiwan.net/poem63577.html","الخفيف"],[99,"ها أنا عدت إلى حيث التقينا","https://www.aldiwan.net/poem24925.html","الرمل"],[99,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85373","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39609","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55418","الخفيف"],[47,"أطلُبُ النّوْمَ كَيْ يَعودَ غِرَارُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31262",""],[275,"هذا مليك القبة الزرقاء","https://www.aldiwan.net/poem35689.html","الكامل"],[280,"جدد لنيتك القصية نية","https://www.aldiwan.net/poem25396.html","الكامل"],[369,"أسعداني في الحب ما تعلمان","https://www.aldiwan.net/poem60609.html","الخفيف"],[422,"عد عن من لج في قال وقيل","https://www.aldiwan.net/poem54131.html","الرمل"],[438,"أتروم خلا في الوداد صدوقا","https://www.aldiwan.net/poem12679.html","الكامل"],[463,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[543,"إني بعثت لسيدي بكتابي","https://www.aldiwan.net/poem48294.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138288",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122540","الخفيف"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66699","الرمل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96980","الكامل"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122912","الخفيف"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122049","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108650","الخفيف"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28560","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106971","الرمل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/198651","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93790","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94312","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93904","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132587","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132689","الرمل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87573","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85221","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90899","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90827","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90816","الكامل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147256","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72965","الرمل"],[4578,"رق النرجس في وجه الرياض","https://www.poetsgate.com/ViewPoem.aspx?id=49456",""],[4898,"هذا هُو المختارُ !","https://www.poetsgate.com/ViewPoem.aspx?id=180920",""],[4955,"وصفوه بدرا للدجى","https://www.poetsgate.com/ViewPoem.aspx?id=188773",""],[5111,"غَسَقُ الليْلِ","https://www.poetsgate.com/ViewPoem.aspx?id=212394",""],[5183,"خفة الأروى","https://www.poetsgate.com/ViewPoem.aspx?id=186382",""],[5183,"ثلمة الأبد","https://www.poetsgate.com/ViewPoem.aspx?id=180256",""],[5183,"الجلال","https://www.poetsgate.com/ViewPoem.aspx?id=186602",""],[5302,"ذنوب وتوبة","https://www.poetsgate.com/ViewPoem.aspx?id=202728",""],[5409,"أيار شهرك بالكوارث مفعم","https://www.poetsgate.com/ViewPoem.aspx?id=155316",""],[5410,"فحضارة الإسلام حصن صامد","https://www.poetsgate.com/ViewPoem.aspx?id=73563",""],[5431,"((أني معك!))","https://www.poetsgate.com/ViewPoem.aspx?id=198345",""],[5491,"سيدة المكان","https://www.poetsgate.com/ViewPoem.aspx?id=215040",""],[5512,"عيد الثامن من آذار","https://www.poetsgate.com/ViewPoem.aspx?id=204502",""],[5618,"وردة في محراب عقبة","https://www.poetsgate.com/ViewPoem.aspx?id=208918",""],[5848,"فستان عيدك","https://www.poetsgate.com/ViewPoem.aspx?id=53181",""],[5937,"صلاةُ الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=211799",""],[6124,"أحلام العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=125194",""]],"verses":[["وَعَلى خُزاعَةَ وَالسُكونِ تَعَطَّفَت","وَأَصابَهُم ظُفُرٌ مِنَ الأَظفارِ",0,"ر",1,0],["وعلى خليجِ الرومِ منكَ مَهابَةٌ","من خوفِها يتطامنُ التيارُ",1,"ر",1,0],["وَعَلى خَيلِهِ أُسودٌ عَلَيها","حَلَقٌ يَدرَءُ السِلاحَ مُدارُه",2,"ر",2,0],["وعلى خَيمَته حارسُه","عَرَبِيُّ الجودِ شَرقِيُّ الضيَافه",3,"ه",1,0],["وعلى خيمته أسوده","عربي الجود شرقي الضيافه",4,"ه",1,0],["وَعَلى خَفاياها وقف","تُ فَما أَفادنيَ الوقوف",5,"ف",1,0],["وَعَلى خط محور لك دوري","مَع أَطواد سطحك الشماء",6,"ا",2,0],["وعلى خدِّه جَرَتْ","عبراتٌ من الندمْ",7,"م",1,0],["وَعَلَى خَيْرِ مَا تَمَنَّاهُ نَشَّأْ","تِ لِخَيْرِ الآبَاءِ خَيْرَ البَنِينِ",8,"ن",1,0],["وَعَلى خَيلِهِ أُسُودٌ، عَلَيْهَا","حَلْقٌ يَدْرَأُ السّلاحَ مَدارُهْ",9,"ر",2,0],["وعلى خليجٍ منهُ تطلعُ جمرةً","من فحمةٍ في ليلةِ الرمضاء",10,"ا",2,0],["وعلى خلائقها الخلائق ركبوا","أو ما ترى أوفاهم خوّانا",11,"ن",2,0],["وعلى خاطري وخِطاري من دو","نِ قَصدي ومَقْصدي عُقْلَتان",12,"ن",1,0],["وعلى خِفَّتها في وزنها","تطأ الحساد بالقول الثقيل",13,"ل",1,0],["وعلى خيانتك الوفاءَ لأنّني","ما زلتُ في حبلِ الهوى مَوثوقا",14,"ق",2,0],["وعلى خطّة العلا بعد قومٍ","طال باعي فيهم وأرحبَ ذرعي",15,"ع",2,0],["وعلَى خديمِك فاسمَحن بجَوابِه","لا تبخَلُوا عنه برَدِّ جوَابِ",16,"ب",1,0],["وعلى خوانك كل لون فاخر","وأخوك ليس له من الخبز الكسر",17,"ر",1,0],["وعَلَى خاطِري هَواتِفُ تَدعُو","ني إلى ما يَسُرُّكُم فأُجيب",18,"ب",1,0],["وعليٌّ خازنُ الوحي الذي","كان مستودَع آياتِ السُّورْ",19,"ر",1,0],["وعلى خليلي اللَه قد عادت بكم","برداً لظى نار تشب وتشعل",20,"ل",1,0],["وعلى خير صاحب","وعلى خير ما سكن",21,"ن",1,0],["وَعَلَى خُدُودِ الوَرْدِ قَدْ أَجْرَى الحَيَا","دَمْعاً يُكَفْكِفُهُ النَّسِيمُ دِرَاكَا",22,"ك",2,0],["وعلى خده الأسيل حميمٌ","كلل الورد لؤلؤاً منثورا",23,"ر",2,0],["وَعَلى خَليجِ الرّومِ بَرقُ صَفائِحٍ","تَفري ذُيولَ النَّقعِ وَهيَ صِفاقُ",24,"ق",1,0],["وعلى خد فتاة أم شقيق","تتجلى بيننا وهي تدار",25,"ر",1,0],["وعلى خد كعضب أبيض","وأذن مثل سنان أزرق",26,"ق",1,0],["وعلى خاتم النبيين أذكى","صلوات للمسك نفحاً تضاهي",27,"ا",3,0],["وعلى خاتم النبيين أربى","صلوات يهدي شذاها الأريبا",28,"ب",2,0],["وعلى خصصته بين البرايا","بالمزايا وفيض ربي عميم",29,"م",1,0],["وعلى خصرها يجول وشاح","كل قلب به اغتدى معقودا",30,"د",2,0],["وعلى خوف عقاب أو عتاب","أنا بالعفو المرجى طامع",31,"ع",1,0],["وَعلى خدِّها من الورد لَونٌ","وَبِفيها للورد طيبٌ وَمآءُ",32,"ا",2,0],["وعلى خلائقك التي كرمت","مني السلام على مدى الدهر",33,"ر",1,0],["وعلى ختام الرسل طه جده","أزكى صلاة بالسلام النادي",34,"د",2,0],["وعلى ختام الرسل طه جدكم","أزكي صلاة بالسلام العاطر",35,"ر",1,0],["وعلى خليقته خليفته الذي","آباؤه من قبله الخلفاء",36,"ا",2,0],["وعلى خطوط عوالمي قد ينجلي","سر التناقض والتناقض َمظهر",37,"ر",1,0],["وعلى خبزي تمنّى","وضع سكباجة ذمّي",38,"م",2,0],["وعلى خد الرشا قد تثنت مرحاً","بقدود تورث القلب انتفاض",39,"ض",1,0],["وَعلى خُطاهُ جَمِيْعُنا حَثَّ الخُطى","حَثَّ اللَّبِيْبِ الرَّاغِبِ المِطْواعِ",40,"ع",1,0],["وعلى خطاهُ مشى الصحابةُ دربَهم","كانوا مصابيح الهدى ما تاهوا",41,"ا",1,0],["وَعَلى'خَاصِرَتِي قَيْظٌ يُنَاجِي","ألمًا يَنْهمُ بؤْسًا وَجِيَاعَا",42,"ع",2,0],["وعلى خفة أروى نفرت الجسم والدعج","وإلى محراب الطهر على علياك تعالى تندمج",43,"ج",1,0],["وعلى خاتم النبيين في الخت","م صلاة من عرفها فاح ند",44,"د",1,0],["وعلى خليفة في ربا قطر الثنا","حيث السمو وعزه وعلاؤه",45,"ا",3,0],["وعلى خطايانا وسوء فعالنا","في الدار نبقى نحمل الإيمانا",46,"ن",2,0],["وعلى خطاياها نموت وهكذا","شأن البغي باثمها تتوحم",47,"م",1,0],["وعلى خُطا المختارِ باتتْ واحةً","ذِكْرُ الحَبيبِ مُعَطِّّرٌ أَنسامَها",48,"م",3,0],["وعلى خُطىً رعناءَ من","وهجِ النوى قد لفّعكْ!",49,"ك",1,0],["وعلى خمائلك الرقيقة ينتهي","فيك الدلالُ فكيف لا أتخيَّرُ؟",50,"ر",1,0],["وعلى خطى ثوَّارِها نمضي معاً","فالجيش في ساحاتِنا كرَّارُ",51,"ر",1,0],["وعلى خطاك نسير لا نلوي على","أحدٍ ، نمد لكل مظلومٍ يدا",52,"د",2,0],["وعلى خدك..... أبكتب بيت..... يسوى........ كل... أشعاري","بعدها .... ماعلي .... ان مات شاعر .... في رجاْ الافكار",53,"ر",1,0],["وعلى خدودِي من يديك عِمامةٌ","وعلى خدودِكِ من يدي لثامُ",54,"م",1,0],["وَعَلَىْ خَفُوْقٍ ضَمَّنِيْ ضَمَّ الكَرَىْ","هَذَا سَرَابٌ مَاجَرَىْ هَلْ يُكْتَمُ؟",55,"م",1,0]]}