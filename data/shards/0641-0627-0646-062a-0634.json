id=5339",""],[5596,"دار الغشّام","https://www.poetsgate.com/ViewPoem.aspx?id=206479",""],[5906,"آمال نافقة","https://www.poetsgate.com/ViewPoem.aspx?id=188823",""],[5969,"شِفاءْ","https://www.poetsgate.com/ViewPoem.aspx?id=204788",""],[5997,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=214263",""],[6019,"طيفه حين عناق","https://www.poetsgate.com/ViewPoem.aspx?id=179242",""],[6093,"يا طارق الباب *","https://www.poetsgate.com/ViewPoem.aspx?id=199800",""],[6102,"حَماقَة !!","https://www.poetsgate.com/ViewPoem.aspx?id=183657",""],[6124,"نكتب الأوتار","https://www.poetsgate.com/ViewPoem.aspx?id=121830",""],[6124,"وباء","https://www.poetsgate.com/ViewPoem.aspx?id=159878",""],[6225,"رؤية المصطفى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78023&r=&rc=108",""],[6229,"تفاحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82506&r=&rc=41",""],[6237,"اليتيم السعيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77872&r=&rc=14",""],[463,"هل عند هذا الطلل الماحلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60291&r=&rc=347",""]],"verses":[["فَإِن تَشُكَّ فَدبِّر قَولَ صاحِبِكُم","حَتّى يَقولُ بِنَفيِ الشَكِّ هَذا هو",0,"و",1,0],["فأنت شريكي في الذي قد جَنيته","وإن كنتُ عينَ الجارِمِ المتمرِّدِ",1,"د",1,0],["فَإِن تَشَء أَودَعتُ أَحشائُهُ بَرَداً","وَإِن تَشَء أَودَعتُ أَحشائَهُ لَهَبا",2,"ب",2,0],["فَإِن تَشَء أَن لا يَذوقَ الهَنا","قَلبي فَجَرِّدني مِنَ الحِسِّ",3,"س",1,0],["فَإِن تَشَأ فَهَذِهِ حِكايَه","تُعَدُّ في هَذا المَقامِ غايَه",4,"ه",1,0],["فانتشر النسل وضاق الفضا","بهم وطاب الفرع والأصلُ",5,"ل",1,0],["فإن تَشْتَهِرْ في كلِّ شَرْقٍ ومَغْرِبٍ","معالي ابنِ فَهدٍ فالثناءُ يَزيدُها",6,"د",3,0],["فَأَنتَ شامِلُ جَمعي","وَأَنتَ جامِعُ شَملي",7,"ي",1,0],["فَاِنتَشَرَت حينَ بَدا طَيُّهُ","سَرائِرٌ يَكتُمُها الجَهرُ",8,"ر",1,0],["فانتشرت خيل قريش تطلبه","من ينصر الرحمن من ذا يغلبه",9,"ه",1,0],["فإن تشأ أودعت أحشاءه بردا","وإن تشأ أودعت أحشاءه لهبا",10,"ب",2,0],["فانتشى من طيوفهنّ وجنّت","قطرات علقن بين النّهود",11,"د",1,0],["فانتشى الكون وقد أصغى إلى","صوتها العذب الحنون الغرد",12,"د",1,0],["فأنتَ شمسُ ضُحَاه","وأنت بَدْرُ دُجَاه",13,"ا",2,0],["فَانْتَشَتْ أَنْفُسٌ لَنَا بِشَذَاهَا","وَطَرِبْنَا لِعَرْفِهَا بَعْدَ يَاسِ",14,"س",1,0],["فإن تشك الخطا يُسعدْك وقتٌ","رهيبٌ لا تفيد به الشكايا",15,"ا",3,0],["فانتشقْنا نوافجَ المسك لمَّا","فضَّ عنها السُّقاة مسك الختام",16,"م",1,0],["فانتشيتم وللهوى نشوات","فكأَنّي بكم سقيتم شمولا",17,"ل",2,0],["فإنْ تشكَّكْتَ في الحديث إذاً","فانظُر إلى ليّها بأسنانِه",18,"ه",1,0],["فإن تَشُجَّ تباريحُ الهوى كَبِدِي","فقد تَعَوَّضتُ قُرْباً منكَ يأْسُرني",19,"ن",2,0],["فانتشينا وكل عيد","سينسى غير عيد لفك أشرى واسرى",20,"ر",2,0],["فَإِن تَشبَعي مِنّي وَتَروَي مَلالَةً","فَإِنّي وَرَبّي مِنكِ أَروَى وَأَشبَعُ",21,"ع",1,1],["فَأَنتَ شَمسُ الضُّحى للسّاربينَ وَلل","سارينَ في جُنحِ ليل ضوءُك القمرُ",22,"ر",1,0],["فَإِنْ تَشحَطوا بعدَ اِجتِماعٍ وإلْفَةٍ","ببعض الرّزايا الهاجمات الفوادِحِ",23,"ح",1,0],["فَإِنْ تَشحَط فَما أَهوى اِقتِراباً","وَإِن تَرحل فَما أَرجو إِيابا",24,"ب",2,0],["فَإِن تَشكُروني تَشكُروا ليَ نِعمَةً","وَإِن تَكفُروني لا أُكَلِّفُكم شُكري",25,"ر",2,0],["فانتشقنا نسمات","وتأملنا النهورا",26,"ر",2,0],["فأنت شريف الذات طبعاً وعنصراً","فمن شرفٍ تسمو إلى شرفٍ يسموا",27,"م",3,0],["فَإن تَشَبَّه بِالصَّيادِ مِن بَلَهٍ","عُميُ الوُجُوهِ فَليسَ الصِّلُ كالبَرمِ",28,"م",1,0],["فإن تشأ فأداء لا أوان له","وإن تشأ فأداء بعد ساعات",29,"ت",1,0],["فأنتشي مِن شذا ريّاهُ عاطرةً","كأنّما اتّخذت فاهُ لها مثوى",30,"و",2,0],["فَاِنتَشَرَ المَنشور في البَوادي","وَأَقبَلَت وحوش هَذا الوادي",31,"ي",1,0],["فإنْ تشاجعتَ صدَّعتَ البسيطة مِنْ","حُصَاصِك الفُحْشِ أو من صوتك القصفِ",32,"ف",1,0],["فإن تُشرِْف عليها من بعيد","حسبت غمامة حدقت بشمسِ",33,"س",1,0],["فأنت شفيع المذنبين إذ دعوا","لعرض حساب هوله يقصم الظهرا",34,"ر",2,0],["فإن تشي واصلي أو شئت فانصرفي","فإن حبك من طي الحشا انصرما",35,"م",2,0],["فاِنتَشى شُرباً وَأَضحى مائِلاً","مثلَ نشوانٍ وَقَد خَرَّ لقى",36,"ق",2,0],["فان تشا قلت ذا هلال","وان تشاقلت ذاك قسور",37,"ر",1,0],["فإن تشتهي موتاً يرق لك كأسه","وإن تسأمي هوناً فمثلك سائم",38,"م",1,0],["فأنت شفيع المذنبين وذخرهم","وإني على حرف المهالك والكرب",39,"ب",1,0],["فأنت شفيع المذنبين ومشفق","بهم فاشفعن لي كي بتقريبكم أبوا",40,"ب",3,0],["فإن تُشَرّق فبا لطرحاء منزلَةٌ","لم تبدُ إلّا بآيات خفيات",41,"ت",1,0],["فَإِن تَشبَعي مِنّا وَتَروي ضَلالَةً","فَإِنّا وَرَبِّ البَيت أَروى وَأَشبَع",42,"ع",1,1],["فأنت شمس الهدى والملك مطلعكم","لا غرو أن أنتجت أنوارك القمرا",43,"ر",2,0],["فانتشتني من قعر موردة الردى","أمناً ولم تسمع مقالة زاجر",44,"ر",1,0],["فإن تشكر فقد أولى جميلا","وإن تكفر فإنك للكفور",45,"ر",1,0],["فانتشقا نَشْرَ التُّقَى إنَّهُ","أطْيَبُ مِنْ نَشْرِ الرَّياحين",46,"ن",1,0],["فانتشقها أريجة كأريض ال","روض ظلت تضوع الريح عطره",47,"ر",2,0],["فإن تشاقلت به أو بنا","فإنه بكلِّ ذا أملك",48,"ك",1,0],["فإنْ تشكروا لله نعماهُ فيكمُ","وإلا أتتكمْ حِميرٌ بالعَجارفِ",49,"ف",1,0],["فَاِنتَشِلني مِن غياباتِ الأَسى","يا غَياثي كُلَّما خَطبٌ طَغى",50,"ا",1,0],["فإن تشأ جنة وفوزاً","بلا جهاد ولا تقحم",51,"م",1,0],["فَأَنتَ شَمس العُلا والبرح ساحتها","وَنُور فَضلك بِالعَلياء هَناها",52,"ا",3,0],["فأنت شريك فانصرن يا محمد","الاهك والاخوان نصر المشارك",53,"ك",1,0],["فانتشت روحي بأحلام وذكرى","وانجلت رؤيا عيوني في صفاها",54,"ا",3,0],["فان تَشأ علم تأريخٍ لِعَودتها","سمَّيتَ جُرجُسَ اولقَّبتَ بالبازي",55,"ز",2,0],["فان تشأ نظم تأريخ العزآءِ فقل","نالَت من اللَه ما تَرجوهُ روجينا",56,"ن",2,0],["فَإِن تَشغَبي فَالشَغَبُ مِنّي سَجِيَّةٌ","إِذا شيمَتي لَم يُؤتَ مِنها سَجيحُها",57,"ح",3,0],["فأنتَ شِهابي في الخطوبِ إذا دَجَتْ","وغيثي إذا جفّتْ جُفونُ السّحائبِ",58,"ب",1,0],["فإن تَشِبِ الذؤابةُ أمَّ زيدٍ","فقد لاقيتُ أياماً شِدادا",59,"د",2,0],["فَإِن تَشتَكي العيسُ الدياجيرَ فاجعلا","لها الشوق أَو فالدمع إن تشتكي الظَما",60,"م",2,0],["فإن تشأ فالبث يسيراً ترى","وإن تعل صبراً لفرع الصعاد",61,"د",1,0],["فانتشروا كالثلج في شمألٍ","ترمي به فامتد أي امتداد",61,"د",1,0],["فان تشربِ الأَرطى دَماً مِن صَديقِنا","فَلا بُدَّ أَن يُسقى دِماءَكمُ النَخلُ",62,"ل",1,0],["فانتشتني من قبر موردة الردي","أمنا ولم تسمع مقالة زاجر",63,"ر",1,0],["فان تشكك فاعتبر","أعداد أحرف اسمه",64,"ه",1,