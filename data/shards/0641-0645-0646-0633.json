ps://www.poetsgate.com/ViewPoem.aspx?id=190793",""],[5277,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=206330",""],[5408,"عروبيٌّ صوتي","https://www.poetsgate.com/ViewPoem.aspx?id=190873",""],[5459,"طال الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=205766",""],[5477,"حمداً من ردّ أهل الزيغ والزلل","https://www.poetsgate.com/ViewPoem.aspx?id=124908",""],[5582,"أَتَرْدَعُنِي بِاللَّوْمِ وَالدَّهْرُ أَرْدَعُ","https://www.poetsgate.com/ViewPoem.aspx?id=63534",""],[5596,"ردا على الشيخ صالح بن خلفان البراشدي","https://www.poetsgate.com/ViewPoem.aspx?id=206749",""],[5649,"درة صور","https://www.poetsgate.com/ViewPoem.aspx?id=38967",""],[5776,"يوسف يماني ينفض رماد الأخدود","https://www.poetsgate.com/ViewPoem.aspx?id=206944",""],[5781,"حينَ يصيرُ الغيمُ أبيضَ","https://www.poetsgate.com/ViewPoem.aspx?id=202845",""],[5781,"آخر نفسٍ أنت وأوَّله....","https://www.poetsgate.com/ViewPoem.aspx?id=208825",""],[5937,"حتى يليقَ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=211823",""],[5956,"من مشكلات الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=192456",""],[5956,"لحل المشكلات","https://www.poetsgate.com/ViewPoem.aspx?id=194892",""],[6093,"عَلى أَطْلالِ بَعْضِيَ قَامَ بَعْضِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=191508",""],[6139,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=212330",""],[6152,"حُلم عمري","https://www.poetsgate.com/ViewPoem.aspx?id=203097",""],[1376,"وارقني خيال من حبيب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=599386",""],[6187,"نبضُ الحكمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82478&r=&rc=1",""],[6320,"أَقْتَاتُ حُزْنِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83620&r=&rc=1",""]],"verses":[["فَمِنْ سَابِقٍ وَلَّى عَلَى إِثْرِ سَابِقٍ","كَمَا اسْتَبَقَتْ غُرَّ الْجِيَادِ بِمَيْدَانِ",0,"ن",1,0],["فَمِنْ سُحُبٍ لاَحَتْ بِهَا شُهُب الْقَنَا","وَمِنْ كُتُبٍ بِيضٍ بَدَتْ فَوْقً كُثْبَانِ",1,"ن",1,0],["فَمَن سَرَّهُ تَأنيثُها أَنَّثَ اِسمَها","وَمَن سَرَّهُ التَذكيرُ فَهوَ مُذَكّرُ",2,"ر",1,0],["فَمِن سُمرِ الرِماحِ لَهُ عِمادٌ","وَمِن بيضِ الصِفاحِ لَهُ أَساسُ",3,"س",1,0],["فَمن سامَنا قسراً على الضيم يلقَنا","مصاعيب لا تُعطي المقادة بالقسر",4,"ر",1,0],["فَمِن سَعيدِ بنِ حَمدانٍ وِلادَتُهُ","وَمِن عَلِيِّ بنِ عَبدِ اللَهِ سائِرُهُ",5,"ر",2,0],["فمن سبر الأحوالَ لم يتعجب لها","ومن عرف الأيامَ لم يرَ منكرا",6,"ر",2,0],["فمن ساد قوماً أوجب الطولُ أن يُرى","مُجِدّاً لأدناهُمْ وهم في الملاعبِ",7,"ب",1,0],["فمَنْ سختْ نفسُهُ بحرمته","فهْو الذي ليس بعدهُ كرما",8,"م",2,0],["فمن سَحَر السماء فأمطرتنا","فكان الدر والذهب الذهابا",9,"ب",2,0],["فَمِنْ سانحٍ بالخيرِ في إثْرِ سابحٍ","ومُختضِبِ الأطرافِ من دمِ خاضبِ",10,"ب",1,0],["فَمَن سالَ أَينَ ثَوَت جارَتي","فَإِنَّ لَها بِاللَوى مَنزِلا",11,"ل",2,0],["فَمِن سَيفٍ وَمِن رُمحٍ وَسَهمٍ","وَنَصلٍ أَرهَفوهُ وَذَرَّبوهُ",12,"ب",3,0],["فمن سابقٍ كيلا يقال محاذرٌ","وَمستعجلٍ كيلا يقال كسول",13,"ل",1,0],["فمن سجن إلى من","فى لآخر شط أبوانا",14,"ن",2,0],["فمن سجن إلى منفى","ومن منفي إلى غربة",15,"ب",2,0],["فمن سيف الجفون وُقِيتَ حتفي","ومن خمر اللمى يا صاح سكري",16,"ر",2,0],["فمن سواه تراه آخذ بيدي","ومن سواك إذا رمت الحنو حنا",17,"ن",2,0],["فمن سعيرٍ إلى نعيم","ومن حرام إلى حلال",18,"ل",1,0],["فمن سواك نصيري","ومن سواك دليلي",19,"ل",2,0],["فَمِن سائِسٍ لِلمُلكِ فيها مُدَبِّرٍ","وَمِن عالِمٍ حَبرٍ وَمِن حاكِمٍ عَدلِ",20,"ل",1,0],["فمن سار فيه سُرَّ بالسرّ سرُّهُ","ومن حضرة التقريب حقّاً تقدّما",21,"م",2,0],["فمن سره ما ساءنا ساء لنفسه","ومن راشه ما هاننا جد نادم",22,"م",1,0],["فمن سَكبها تسكابُ نارٍ وجلمدٍ","لخيرِ دفاعٍ دون حقٍّ وحرمة",23,"ه",1,0],["فمِنْ سماح إذا القطر المُلِثُّ ونَى","أوْ مِنْ مَضاء إِذا العَضْبُ الحُسامُ نَبا",24,"ب",2,0],["فمن سنة سنّت على الرأس تربَها","ومكرمةٍ ناحت لأكرم هالك",25,"ك",1,0],["فَمِن سَبَبٍ يُراجِفُهُ وَوَدٍّ","يُشَعِّبُهُ وَيَقطَعُ منهُ زَائِدْ",26,"د",1,0],["فمَنْ سواهُ يُقصَدُ","عند حلولِ المحَنِ",27,"ن",1,0],["فمن سجعةٍ لم تُلْفَ في لفظِ شاعر","ومن فَقْرةٍ لم تأتِ من مترسَّل",28,"ل",1,0],["فَمن سَرَّهُ المَحْيا فسمع وطاعةٌ","ومن يَحْسُدِ المَوتى فكُفْرٌ وعِصيانُ",29,"ن",1,0],["فمن سان القفار السج","د والمحسن فالجود",30,"د",1,0],["فمن سره تشتيت علم ودفنه","فهذا دليل في الملم المشتت",31,"ت",1,0],["فَمَن سَعى عَن طَريقِ الغَيِّ مُبتَعِداً","فَحَبلُ مَسعاهُ بِالخَيراتِ مَوصولُ",32,"ل",1,0],["فمن سيّد الأطواد لاِبن محمّد","له في جنان الخلد خير حباءِ",33,"ا",2,0],["فمن سمك السبع الشداد بني لكم","على ذا الورى بيتا رفيع المسامك",34,"ك",1,0],["فمن ساق مرقاة صرح صعودا","هبوطا يسيرها بعصا",35,"ص",2,0],["فمن سواي إليكا","قد عِيلَ فيك اصطباري",36,"ي",1,0],["فمِنْ سيفِه رعدُ الغمام وبرقُه","ومِن كفّه وبْلُ الغمامِ وطَلُهُ",37,"ل",2,0],["فَمِن سَنى فَكرِكَ التَهذيبُ مُنتَشِرٌ","وَمِن ضَيا فَهمِكَ الإِرشادُ مُنسَكِبُ",38,"ب",1,0],["فمِنْ سِوَى فَضْلِكَ لا أَجْتَدي","ومِنْ سَوَى لَفْظِكَ لم أَسْرِقِ",39,"ق",1,0],["فمن سهري يلم فما أراه","ومن سقمي يطوف فما يراني",40,"ي",1,0],["فمن سايرت أسماء فيها تواضعت","ومن طاعن الخرطات فيهن يكلم",41,"م",1,0],["فمن سالهم يظفر بما سال منهم","وما شيّدوا في المجد لا يتهدّم",41,"م",1,0],["فَمِنْ سَحَابِ نَدَى يُرْضِيهِ هَامِلُهَا","وَمِنْ سَحَابِ دَمٍ يَشْفِيهِ هَامِيهَا",42,"ي",3,0],["فمن سائر ينقض في البيد زائراً","فتحسبه طيفاً من الجن مُفزعا",43,"ع",2,0],["فمن سواه قد بنى كعبة","كانت هي المأوى لنا والمآل",44,"ل",1,0],["فَمَن سَلَّ سَيفَ البَغيِ فَاِجعَلهُ نُسكَهُ","وَمَن شَبَّ ناراً فَاِرمِهِ وَسطَ ما شَبّا",45,"ب",2,0],["فمن سمر تُسَمَّرُ في نحور","ومن بيض يقد بها قدودا",46,"د",2,0],["فمن سيب وسيف عامَ جَدب","وحرب لِلقراء وللقِراع",47,"ع",1,0],["فمن سائلي عن سائل الدمع لِمْ جرى","لعل فؤادي بالوجيب يجاوبه",48,"ب",2,0],["فمن سالكٍ نهجَ الطريقِ مسافر","إلى سَفَرٍ يسمو وفي الغيبِ ما سما",49,"ا",1,0],["فمن سبر الأمر الذي قد سبرته","يكون إماما لا يخافُ ولا يخشى",50,"ش",2,0],["فمن سنّ خيراً حاز من كل معتد","به خيره بالفعلِ إذ كان سنه",51,"ن",2,0],["فمن سره أن لا يرى ما يسوءه","فلا يتخذ شيئاً ينال به فقدا",52,"د",2,0],["فمن سطر صفصاف يروقك منظراً","وسطر فسيل حسنه يتجدد",53,"د",1,0],["فمن سرّ سين الانس كانت سعادتي","ومن شين شرّ النفس شاووش شقوتي",54,"ي",1,0],["فمن سوداء مقلته جنوني","وذابل قدَه منه سقامي",55,"م",2,0],["فَمَن سعِيد