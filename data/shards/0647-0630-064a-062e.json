{"poems":[[56,"مات الثلاثة لما مات مطلب","https://www.aldiwan.net/poem27419.html","البسيط"],[53,"أمسى الشباب رداء عنك مستلبا","https://www.aldiwan.net/poem8649.html","البسيط"],[108,"تحيّة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179608",""],[108,"بطل الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179606",""],[53,"أمسى الشبابُ رداءً عنك مستلبا","https://www.poetsgate.com/ViewPoem.aspx?id=27201",""],[128,"لما وجدت مكارم الأخلاق","https://www.aldiwan.net/poem23750.html","مجزوء الكامل"],[164,"هذي خطوطك في كفي مشاهدة","https://www.aldiwan.net/poem58798.html","البسيط"],[164,"لا تأخذنك رأفة أو رحمة","https://www.aldiwan.net/poem58804.html","الكامل"],[369,"حيث انتهيت من الهجران بي فقف","https://www.aldiwan.net/poem60841.html","البسيط"],[406,"رسالة اعتذار إلى أم المؤمنين خديجة (رضي الله عنها)","https://www.aldiwan.net/poem10309.html","عموديه"],[457,"تنبهت في الروابي نسمة الفلق","https://www.aldiwan.net/poem13863.html","البسيط"],[458,"شمس الربيعِ تبرجي وتناسي","https://www.aldiwan.net/poem61590.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48677","الكامل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145971","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56209","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56604","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108579","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52120","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46469","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202734","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205072",""],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139923","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74095","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48324","الكامل"],[3576,"","https://poetry.dctabudhabi.ae/diwan/poem/128403","الكامل"],[3590,"","https://poetry.dctabudhabi.ae/diwan/poem/121983","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205690","البسيط"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/198890","البسيط"],[4097,"","https://poetry.dctabudhabi.ae/diwan/poem/147253","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94624","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94327","البسيط"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121283","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120500","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120488","الكامل"],[4691,"طفلة الأشعار","https://www.poetsgate.com/ViewPoem.aspx?id=151408",""],[5055,"الهلاهيل","https://www.poetsgate.com/ViewPoem.aspx?id=102733",""],[5621,"صلاة الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=24567",""],[5720,"أَهْلُ الْبِر","https://www.poetsgate.com/ViewPoem.aspx?id=206964",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[5956,"قلبي على زوجتي السائحة النائحة في إيطاليا والمتفضلين على الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=203551",""],[6113,"قصتي مع هيله...","https://www.poetsgate.com/ViewPoem.aspx?id=77497",""],[6152,"خيالات زائرة","https://www.poetsgate.com/ViewPoem.aspx?id=203306",""],[6200,"غَابَةُ الأَطْفالِ وَ الحِجَارَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81373&r=&rc=15",""],[6242,"مَنْ ضيّعَك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87556&r=&rc=3",""],[557,"كأن العمر ماكان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69242&r=&rc=148",""]],"verses":[["هَذي خُدودُ بَني قَحطانَ قَد لَصِقَت","بِالتُربِ مُنذُ اِستَوى مِن فَوقِكَ التُربُ",0,"ب",1,0],["هذي خراسان قد جاشت غواربُها","تُزْجي لنصر أخيها عارضاً لَجِبَا",1,"ب",2,0],["هذي خيولُ الصلاحيين قد زَحفَتُ","كأنها -وهْيَ تطوي الأرض- عِقْبان",2,"ن",1,0],["هذِي خيولُهُمو تهُبُّ","كأنَّها ريحُ السَّمُومِ",3,"م",1,0],["هذي خراسان قد جاشت حلائبُها","تُزْجي لنصر أخيها عارضاً لَجِبَا",4,"ب",2,0],["هذي خيام الهبر فاحبب","بالمخيم والخيام",5,"م",1,0],["هذي خطوطك في كفي مشاهدةٌ","من خطِ غيركِ قالوا إِنه سبقا",6,"ق",2,1],["هذى خلائقه ولكن قلبه","بيد الإِله فما عليه حجة",7,"ه",1,0],["هذي خصومي وهذا فاعجبوا عملي","لقد بُليتُ بسُوء الكَيلِ والحَشَف",8,"ف",1,0],["هذي خديجةُ‘ نَبْضُ قلبٍ لم يَزَلْ","يأْوي إليه المصطفى ويَشِيْدُ",9,"د",1,0],["هذي خديجةُ ‘ بيتها بَيْتٌ التُّقَىَ","بَيْتٌ له في المَكْرُمَاتِ وُجُودُ",9,"د",1,0],["هذي خديجةُ‘ كيف يَلْعَبُ باسمه","في عصرنا مَنْ طَبْعُهنَّ كَنُود",9,"د",1,0],["هذي خديجةُ لا يليقُ بفَضْلِه","عَزْفٌ وحَفْلٌ للغناء وعُودُ",9,"د",1,0],["هذي خديجةُ رمزُ كل فضيلةٍ","فمتى يداوي قلبَه المَفؤودُ",9,"د",1,0],["هذي خلائق ما حاكَ الربيعُ وهل","لغبرانسي حكى يا صاحِ من خلق",10,"ق",1,0],["هذى خيوطُكِ في دُعابةِ ساخرٍ","ما مسَّهُ حرقى ولا وسواسي",11,"س",2,0],["هذي خواطريَ الحسان وغيرتي","أرأيتني أغريك أم أوصيكا",12,"ك",2,0],["هَذي خِصَالُهُمَا وَأنَّكَ","ذا وَريثهُمَا خِصَالا",13,"ل",2,0],["هذي خلايق مولانا الذي كملت","صفاتُه ولسان الترك فيه شدا",14,"د",2,0],["هذي خطوب ليس يحملها","جلد وينفد عندها الصبر",15,"ر",1,0],["هذي خدودك بالعذار تدرعت","لقتال من خال الهوى مزّاحا",16,"ح",2,0],["هذي خزائن مصرفي","أكناف تونس تنفد",17,"د",1,0],["هَذي خِلالك قَد نُشِرَت مَلاءَها","مَشهورة الأَسماء وَالأَنباء",18,"ا",2,0],["هذي خفايا الكون في شعري بدت","فكأن قلبي مَرْقب أو مَجْهر",19,"ر",1,0],["هذي خيول الموت تعدو","أم سيول كالخيول",20,"ل",1,0],["هذي خليلتُك التي زوجتها","فاجلس هنا معها ليوم السابعِ",21,"ع",1,0],["هَذي خَلائِقنا وَتِلكَ أُصولنا","تأبى البَوازِل أَن تَكون العنّسا",22,"س",2,0],["هَذي خِلافةُ ناصرِ الدّين الذي","يغْزو وأمْلاكُ السّماءِ جُنودُها",23,"د",3,0],["هذي خطوطهما لديك شهيدة","والخط شاهدكم على إنشائه",24,"ا",3,0],["هذى خناصر أسرتى مسرودةً","فى الجيد منى مثل سمط الكاعب",25,"ب",1,0],["هذي خلاصةُ إنسان مقدسةٌ","ليست خلاصةَ أعنابٍ وصهباء",26,"ا",2,0],["هذي خصالك والأفعال شاهدة","وأنت كالشمس تجلي العارض القاني",27,"ن",2,0],["هذي خطي كتبت علىّ ومَن له","يوماً خطي فوق اللهيبِ مشاها",28,"ا",3,0],["هذي خلالة هذا العصر في ملاءِ","أين العشيرُ ومن سادت عشائرهُ",29,"ر",2,0],["هذي خلالة هذا العصر كن حذراً","تعساً لعصر غدت هذي خلالتهُ",30,"ت",2,0],["هذي خلالَ الزاكيات وصفتهُ","لمحمّدِ بن محمد بن محمد",31,"د",1,0],["هذي خلائق ليس يخلق مدحها","بل لا يزال على المدى يتجدد",32,"د",1,0],["هذي خرافات تطن باذن من","الف البيان طنين نفس الناقس",33,"س",1,0],["هذي \" خلودُ \" وهذا الدّلُ والغنجُ","يهزّنِي موجُهُ قولوا متى الفرجُ",34,"ج",1,1],["هذي خيوط الشمس والورد تاجه","وتشاكلت ما بين وضحا وديجور",35,"ر",1,0],["هذي خنازيرُ العلوجِ برِجْسِها","وطِئتْ حَوافِرُها ثرى بغدادِ",36,"د",1,0],["هَٰذِيْ خَصَائِصُ أَهْلِ الْبِرِّ مِنْ قِدَمٍ","مَنْ أَخْلَصُوْا سَعيَهُمْ لِلهِ بالصِّدْقِ",37,"ق",1,0],["هذي خواطرُ شاعرٍ .. غنّى بها","في ( الثورة الكبرى ) فقال .. وأسمعا",38,"ع",2,0],["هذي خطايا أنفسٍ مشحونةٍ","ضدَّ البراءةِ.. لم تكن أخطاءَها",39,"ا",3,0],["هذي خذتني بالعيون الكحيله","والروح في هيله غدت منتهيه",40,"ي",2,0],["هذي خيالات تداعب مهجتي","والنوم إن زار الخيال محال",41,"ل",1,0],["هذِي خُيُولِي لَمْ تُحَطُّ رِكَابُهَا","وَ صَهِيلُهَا مَا زَالَ يَمْلأُ وَاِديَا",42,"ي",2,0],["هذي خريطة نأينا فامسك بها","واسلك -بربك- جاهداً ما أوسعَكْ",43,"ك",1,0],["هَذِى خُيُولُكَ تحتَ السَّفْحِ قدْ وَهَنَتْ","وأَغْمَضَتْ عَيْنَهَا بُؤْسًا.. وحِرْمَانَا",44,"ن",2,0]]}