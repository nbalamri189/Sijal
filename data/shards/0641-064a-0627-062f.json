{"poems":[[55,"ألا يا ليالي الخيف هل يرجع الهوى","https://www.aldiwan.net/poem30437.html","الطويل"],[65,"فؤاد ببين الظاعنين مروع","https://www.aldiwan.net/poem45790.html","الطويل"],[88,"مرضنا فما عادنا عائد","https://www.aldiwan.net/poem10502.html","المتقارب"],[93,"صاحت الضفضع لما شاهدت","https://www.aldiwan.net/poem62742.html","عموديه"],[87,"أعفريت من الجن","https://www.aldiwan.net/poem7746.html","مجزوء الوافر"],[87,"نراوح بالحوادث أو نغادى","https://www.aldiwan.net/poem8105.html","الوافر"],[64,"بالزوابيق زال ظل النحاس","https://www.aldiwan.net/poem52173.html","الخفيف"],[101,"لا تسألوني","https://www.aldiwan.net/poem5901.html","عموديه"],[68,"وفى لي فيك الدمع إذ خانني الصبر","https://www.aldiwan.net/poem40123.html","الطويل"],[82,"عسى للصبا علم برسم المعالم","https://www.aldiwan.net/poem31293.html","الطويل"],[82,"أغمر الهوى كم ذا تقطعني عذلا","https://www.aldiwan.net/poem31329.html","الطويل"],[76,"لذكرك ماعب الخليج يصفق","https://www.aldiwan.net/poem13194.html","الطويل"],[48,"أمالي الزمان على بنيه","https://www.aldiwan.net/poem23236.html","الوافر"],[48,"بني الحسب الوضاح والشرف الجم","https://www.aldiwan.net/poem23627.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39590","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16663","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42684","السريع"],[92,"يافا الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179202",""],[111,"قد اهتزت الأكوان وارتعد الملا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66832&r=&rc=11",""],[132,"ثقيل على كل الورى من تكبر","https://www.aldiwan.net/poem50587.html","الطويل"],[164,"إلى كم تمادى في غرور وغفلة","https://www.aldiwan.net/poem59149.html","الطويل"],[186,"زمان الحمى هل من معاد فنطمعا","https://www.aldiwan.net/poem67052.html","الطويل"],[189,"لعل زماني بالعذيب يعود","https://www.aldiwan.net/poem14502.html","الطويل"],[189,"سلام على القصرين من منشأ الصبا","https://www.aldiwan.net/poem14536.html","الطويل"],[202,"لمغناك سح المزن أدمع باك","https://www.aldiwan.net/poem51909.html","الطويل"],[202,"قفا نقتبس من نور تلك الركائب","https://www.aldiwan.net/poem51987.html","الطويل"],[203,"من الصدع في قلبي غداة تهدما","https://www.aldiwan.net/poem45161.html","الطويل"],[215,"عن الوطن الغالي أهاجر مرغما","https://www.aldiwan.net/poem46627.html","الطويل"],[227,"أشعة من مقلتيك ملهبه","https://www.aldiwan.net/poem39698.html","الرجز"],[241,"لي الله قلبي كم يذوب من الذكرى","https://www.aldiwan.net/poem18191.html","الطويل"],[256,"أبى جلد أن أحمل البين والقلى","https://www.aldiwan.net/poem1415.html",""],[263,"إذا لم تكن أنت الدليل فلا هدى","https://www.aldiwan.net/poem35576.html","الطويل"],[265,"أظن الصبا جابت إليك المسالكا","https://www.aldiwan.net/poem38220.html","الطويل"],[275,"أغيب وذو اللطائف لا يغيب","https://www.aldiwan.net/poem52126.html","الوافر"],[309,"أقضي زماني بين صد وهجران","https://www.aldiwan.net/poem56381.html","الطويل"],[370,"أبى الدمع أن يشفى به هم هائم","https://www.aldiwan.net/poem17262.html","الطويل"],[407,"تشابه حالنا في كل فن","https://www.aldiwan.net/poem33386.html","الوافر"],[407,"إلي أحاديث الصبابة تسند","https://www.aldiwan.net/poem33978.html","الطويل"],[420,"فؤاد كطرفك أمسى عليلا","https://www.aldiwan.net/poem54167.html","المتقارب"],[467,"جد بقلبي وهزل","https://www.aldiwan.net/poem3313.html","عموديه"],[474,"ألا يا لقوم للجديد المصرم","https://www.aldiwan.net/poem753.html",""],[530,"ألست ترى السيف كيف انثلم","https://www.aldiwan.net/poem45972.html","المتقارب"],[532,"وفود حبيب أم ورود عهاد","https://www.aldiwan.net/poem37457.html","الطويل"],[554,"أفي دارهم من بعدما ارتحلوا تبكي","https://www.aldiwan.net/poem47342.html","الطويل"],[554,"تراءت لنا بالأبرقين بروق","https://www.aldiwan.net/poem47376.html","الطويل"],[554,"لنا من ثناياك الغريض المرشف","https://www.aldiwan.net/poem47403.html","الطويل"],[554,"ما لي تطيح الدهر أخياري","https://www.aldiwan.net/poem47788.html","البسيط"],[578,"قدمت بالنصر وبالمغنم","https://www.aldiwan.net/poem3014.html","السريع"],[588,"أتطمع في عقالك أن يحلا","https://www.aldiwan.net/poem1564.html",""],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/21","المتقارب"],[1123,"","https://poetry.dctabudhabi.ae/diwan/poem/202303","الطويل"]],"verses":[["فَيا دينَ قَلبي مِن ثَلاثٍ عَلى مِنىً","مَضَينَ وَلَم يُبقينَ غَبرَ جَوى الذِكرِ",0,"ر",1,0],["فَيا دَهرُ رِفقاً إِنَّ بَينَ جوانِحي","حُشاشَةَ نَفسٍ مِن أَسىً تَتَقَطَّعُ",1,"ع",1,0],["فَيا دَولَةً آذَنَت بِالزَوالِ","رَجَعنا لِعَهدِ الهَوى فَاِرجِعي",2,"ع",2,0],["في أَديمِ الماءِ مِن أَصواتِها","رَعدَةُ الحُمّى وَفي اللَيلِ وُجوم",3,"م",1,0],["فيا دى ويت يا ليت","وهل ينفعكم ليت",4,"ت",1,0],["فَيا داراً مِن الهِمَمِ العَوالي","سُقيتِ التِبرَ لا أَرضى العِهادا",5,"د",2,0],["في أداة مسدودة الرأس لا تخ","رج منها الأنفاس عند الزفير",6,"ر",1,0],["في أدمع الشتاء حين يبكي","وفي عطاء الديمة السكوب",7,"ب",1,0],["فَيا دَوحَةَ المَجدِ الَّذي عِندَما ذَوَت","سَمَت وَنَمَت في المَجدِ أَغصانُها الخُضرُ",8,"ر",1,0],["فيا دَوْلَةً قعساءَ دَرّتْ فأرْضَعَتْ","ثُديّ المنايا أو ثُديّ المكارمِ",9,"م",1,0],["فيا دارُ أغضى الدهرُ عنكِ وأكثرتْ","أُسودُكِ نَسلاً فيه يَختَتِلُ النّسلا",10,"ل",2,0],["فَيا دَوحَةَ العَلياءِ حَيَّتكَ رَوضَةٌ","عَلَيها رِداءٌ لِلرَبيعِ مُنَمَّقُ",11,"ق",1,0],["فَيا دارَ الخَسارِ أَلا خَلاصٌ","فَأَذهَبَ في الجَنوبِ أَو الشِمالِ",12,"ل",1,0],["فيَا دافنيهِ في الثّرَى إنّ لحدَهُ","مَقَرُّ الثّرَيّا فادْفِنوهُ على عِلْمِ",13,"م",1,0],["فيا دُرَّةً لم يحوِها تاجُ قيصر","ولا انتظمتْ إلَّا مفارقَ شاعرِ",14,"ر",1,0],["فيا دارَهَا بالحَزْنِ إنّ مَزارَها","قرِيبٌ ولكنْ دونَ ذلكَ أهْوال",15,"ل",1,0],["فَيَا دموعَ الْقَطْرِ سِيلِي دَماً","وَيَا بَنَاتِ الأَيْكِ نُوحِي مَعِي",16,"ع",2,0],["فيا داري إذا ضاقَت ديارٌ","ويا صَحبيْ إذا قلَّ الصِحاب",17,"ب",1,0],["فيا دعوة لم يغلق الله بابها","بها ركن عرش الظالمين تزلزلا",18,"ل",2,0],["فيا داء مَن يرنُو إلى قبحِ وجهه","ويا مَن على كلِّ الورى بغضهُ فرضُ",19,"ض",1,0],["فيا درة بين المزابل ألقيت","وجوهرة بيعت بأبخس قيمة",20,"ه",1,0],["فَيا دَهرُ جَدٌّ ذاكَ أَم أَنتَ هازِلٌ","وَكَيفَ بِمَن لَم يَدرِ لِلهَزَلِ مَنزَعا",21,"ع",2,0],["فيا دهر مَهْلا ما بقي فيَّ مَطْمعٌ","لحادثةٍ تنَتْاشُنى فتَؤود",22,"د",1,0],["فيا دهرُ ألاَّ كان ليلَى كُله","كليلةِ شَرْقيِّ الخَليِج من الثغر",23,"ر",1,0],["فيا دُرُّ إن أمسيتِ عُطلاً فطالما","غدا الدرُّ والياقوتُ بعض حلاكِ",24,"ك",1,0],["فيا دَيْنَ قلبي من تألُّقِ بارقٍ","سرى فاتَّقَتْه مُقلتي بسحائبِ",25,"ب",1,0],["فيا دمع ايام الحداثة ليتني","حفظتك للبؤسى لقد كنت أَنعما",26,"م",2,0],["فيا دار لا دارت عليك دوائرٌ","ولا ذُقت في ليليك غائلة السهد",27,"د",1,0],["في أَدمُعِ الأَيِّمِ وَاليَتيمِ","في صَرخَةِ البَريءِ وَالمَظلومِ",28,"م",1,0],["فَيَا دَارَنَا الْغَرَّا عَلَى الرَّبْوَةِ الْخَضْرَا","لَدَى الصَّدَفَيْنِ الْمُشْرِفَيْنِ عَلَى الْحَمْرَا",29,"ر",2,0],["فَيا ديَمَ الاحسانِ سَحّاً وَديمَةً","وَهَطلاً فَقَد صادَفتَ أَجرد مُمحِلا",30,"ل",2,0],["فيا دعوة المضطرّ قد آن وقتها","ويا بارئ الأسقام جُد ليَ باللطف",31,"ف",1,0],["فيا دهر مذ الجأتني لفنائه","أمنت مع الأيام بؤسي وبأسكا",32,"ك",2,0],["فَيا ديات يوم الدين فرج","هموما في الفؤاد لها دَبيب",33,"ب",1,0],["فَيا دمعَ أَجفاني وَيا حرّ أَضلُعي","أَجدّكما لا ترثيانِ لأشجاني",34,"ن",2,0],["فَيا دارُ ما أَيّامُنا بِذَمائِمٍ","لَدَيكَ وَلا أَشواقُنا بِرَمائِمِ",35,"م",1,0],["فيا دهري الذي قد غاب عني","أقلني في الذي قد كان مني",36,"ن",2,0],["فيا دار أوطاني ومنزل صَبْوَتِي","ومَرْبَع أُنْسِي هل بك الدهر يسعد",37,"د",1,0],["فيا دارنا لا عداك الحيا","وجرَّت عليكِ الغوادي ذيولا",38,"ل",2,0],["في أدهم القطر رمى","وأشقر السيل حمل",39,"ل",1,0],["فَيا دارَ سَلمى بِالصَريمَةِ فَاللِوى","إِلى مَدفَعِ القيقاءِ فَالمُتَثَلَّمِ",40,"م",1,0],["فيا دهر سحقاً ولا تحتشم","فقد ذهب الرجل المحتشم",41,"م",1,0],["فَيَا دَهْرُ قُمْ فاسْحَبْ ذُيولَ مَخِيلَةٍ","وَرَنِّحَ أَعْطَافاً بِرَنَّةِ شَادي",42,"د",2,0],["فيا دِمْنَة الحيّ الّذين تحمّلوا","بوادي الغَضا ماذا ألمَّ بنا منك",43,"ك",1,0],["فيا داءَ قلبي ما أراك تُغِبُّنِي","ويا سُكرَ قلبي ما أراك تفيقُ",44,"ق",1,0],["فيا دارَهمْ سقّاك مِن شَعَفٍ بهمْ","سِجالاً من النَّوْءِ السِّماكين أَوْطَفُ",45,"ف",1,0],["فَيا دُموعيَ كوني فيه واكِفةً","وَيا فؤادي اِحتَرقْ جرّاه بالنّارِ",46,"ر",1,0],["في أَدْهَمِيِّ ليلٍ وقيدٍ ومَنْ","خُيِّر لم يختر سِوَى الأَسْلَمِ",47,"م",1,0],["فيا دهرُ ارتدِع عني وإِلاّ","ستلقى من مُعين الدين نَصْلا",48,"ل",2,0],["فَيا دَهرُ قَدكَ فَأَسجِح بِنا","فَلَسنا بِصَخرٍ وَلَسنا حَديدا",49,"د",2,0],["فيا دهر قدما كنت صعبا فلم تزل","بسهمك ترمي كل عظم ومفصل",50,"ل",1,0]]}