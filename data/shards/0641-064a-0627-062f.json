نزُلَ الرِّجامُ","https://www.poetsgate.com/ViewPoem.aspx?id=160398",""],[4856,"عنيد","https://www.poetsgate.com/ViewPoem.aspx?id=36737",""],[4884,"عزائي للهوى","https://www.poetsgate.com/ViewPoem.aspx?id=201771",""],[4954,"هلْ لي منْ غزالٍ سماحةً","https://www.poetsgate.com/ViewPoem.aspx?id=208832",""],[5232,"مدخل إلى رثائية الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=213661",""],[5277,"سلامٌ على أرضِ البراق","https://www.poetsgate.com/ViewPoem.aspx?id=194416",""],[5376,"في ادلب الحسناء لم تزلِ","https://www.poetsgate.com/ViewPoem.aspx?id=191851",""],[5397,"بكى الدين والدنيا عليك فأفجعا","https://www.poetsgate.com/ViewPoem.aspx?id=157901",""],[5431,"مادمت بالأحياء مشغولا","https://www.poetsgate.com/ViewPoem.aspx?id=198405",""],[5431,"ماكيافيلي والحصاد...","https://www.poetsgate.com/ViewPoem.aspx?id=205414",""],[5638,"فلسفتي في الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=197919",""],[5720,"دكتور موسىٰ","https://www.poetsgate.com/ViewPoem.aspx?id=201848",""],[5748,"قفا نقتبس من نور تلك الركائب","https://www.poetsgate.com/ViewPoem.aspx?id=26035",""],[5758,"رثاء أميرة","https://www.poetsgate.com/ViewPoem.aspx?id=200519",""],[5906,"شحّ الدنانير","https://www.poetsgate.com/ViewPoem.aspx?id=188017",""],[5939,"شعورُ الحبِّ لا يكفي!","https://www.poetsgate.com/ViewPoem.aspx?id=178603",""],[6152,"عيادة قلب","https://www.poetsgate.com/ViewPoem.aspx?id=206620",""],[557,"أحزان مصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67203&r=&rc=65",""],[276,"أغيبُ وذو اللطائفِ لا يغيبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59272&r=&rc=11",""]],"verses":[["فَيا دينَ قَلبي مِن ثَلاثٍ عَلى مِنىً","مَضَينَ وَلَم يُبقينَ غَبرَ جَوى الذِكرِ",0,"ر",1,0],["فَيا دَهرُ رِفقاً إِنَّ بَينَ جوانِحي","حُشاشَةَ نَفسٍ مِن أَسىً تَتَقَطَّعُ",1,"ع",1,0],["فَيا دَولَةً آذَنَت بِالزَوالِ","رَجَعنا لِعَهدِ الهَوى فَاِرجِعي",2,"ع",2,0],["في أَديمِ الماءِ مِن أَصواتِها","رَعدَةُ الحُمّى وَفي اللَيلِ وُجوم",3,"م",1,0],["فيا دى ويت يا ليت","وهل ينفعكم ليت",4,"ت",1,0],["فَيا داراً مِن الهِمَمِ العَوالي","سُقيتِ التِبرَ لا أَرضى العِهادا",5,"د",2,0],["في أداة مسدودة الرأس لا تخ","رج منها الأنفاس عند الزفير",6,"ر",1,0],["في أدمع الشتاء حين يبكي","وفي عطاء الديمة السكوب",7,"ب",1,0],["فَيا دَوحَةَ المَجدِ الَّذي عِندَما ذَوَت","سَمَت وَنَمَت في المَجدِ أَغصانُها الخُضرُ",8,"ر",1,0],["فيا دَوْلَةً قعساءَ دَرّتْ فأرْضَعَتْ","ثُديّ المنايا أو ثُديّ المكارمِ",9,"م",1,0],["فيا دارُ أغضى الدهرُ عنكِ وأكثرتْ","أُسودُكِ نَسلاً فيه يَختَتِلُ النّسلا",10,"ل",2,0],["فَيا دَوحَةَ العَلياءِ حَيَّتكَ رَوضَةٌ","عَلَيها رِداءٌ لِلرَبيعِ مُنَمَّقُ",11,"ق",1,0],["فَيا دارَ الخَسارِ أَلا خَلاصٌ","فَأَذهَبَ في الجَنوبِ أَو الشِمالِ",12,"ل",1,0],["فيَا دافنيهِ في الثّرَى إنّ لحدَهُ","مَقَرُّ الثّرَيّا فادْفِنوهُ على عِلْمِ",13,"م",1,0],["فيا دُرَّةً لم يحوِها تاجُ قيصر","ولا انتظمتْ إلَّا مفارقَ شاعرِ",14,"ر",1,0],["فيا دارَهَا بالحَزْنِ إنّ مَزارَها","قرِيبٌ ولكنْ دونَ ذلكَ أهْوال",15,"ل",1,0],["فَيَا دموعَ الْقَطْرِ سِيلِي دَماً","وَيَا بَنَاتِ الأَيْكِ نُوحِي مَعِي",16,"ع",2,0],["فيا داري إذا ضاقَت ديارٌ","ويا صَحبيْ إذا قلَّ الصِحاب",17,"ب",1,0],["فيا دعوة لم يغلق الله بابها","بها ركن عرش الظالمين تزلزلا",18,"ل",2,0],["فيا داء مَن يرنُو إلى قبحِ وجهه","ويا مَن على كلِّ الورى بغضهُ فرضُ",19,"ض",1,0],["فيا درة بين المزابل ألقيت","وجوهرة بيعت بأبخس قيمة",20,"ه",1,0],["فَيا دَهرُ جَدٌّ ذاكَ أَم أَنتَ هازِلٌ","وَكَيفَ بِمَن لَم يَدرِ لِلهَزَلِ مَنزَعا",21,"ع",2,0],["فيا دهر مَهْلا ما بقي فيَّ مَطْمعٌ","لحادثةٍ تنَتْاشُنى فتَؤود",22,"د",1,0],["فيا دهرُ ألاَّ كان ليلَى كُله","كليلةِ شَرْقيِّ الخَليِج من الثغر",23,"ر",1,0],["فيا دُرُّ إن أمسيتِ عُطلاً فطالما","غدا الدرُّ والياقوتُ بعض حلاكِ",24,"ك",1,0],["فيا دَيْنَ قلبي من تألُّقِ بارقٍ","سرى فاتَّقَتْه مُقلتي بسحائبِ",25,"ب",1,0],["فيا دمع ايام الحداثة ليتني","حفظتك للبؤسى لقد كنت أَنعما",26,"م",2,0],["فيا دار لا دارت عليك دوائرٌ","ولا ذُقت في ليليك غائلة السهد",27,"د",1,0],["في أَدمُعِ الأَيِّمِ وَاليَتيمِ","في صَرخَةِ البَريءِ وَالمَظلومِ",28,"م",1,0],["فَيَا دَارَنَا الْغَرَّا عَلَى الرَّبْوَةِ الْخَضْرَا","لَدَى الصَّدَفَيْنِ الْمُشْرِفَيْنِ عَلَى الْحَمْرَا",29,"ر",2,0],["فَيا ديَمَ الاحسانِ سَحّاً وَديمَةً","وَهَطلاً فَقَد صادَفتَ أَجرد مُمحِلا",30,"ل",2,0],["فيا دعوة المضطرّ قد آن وقتها","ويا بارئ الأسقام جُد ليَ باللطف",31,"ف",1,0],["فيا دهر مذ الجأتني لفنائه","أمنت مع الأيام بؤسي وبأسكا",32,"ك",2,0],["فَيا ديات يوم الدين فرج","هموما في الفؤاد لها دَبيب",33,"ب",1,0],["فَيا دمعَ أَجفاني وَيا حرّ أَضلُعي","أَجدّكما لا ترثيانِ لأشجاني",34,"ن",2,0],["فَيا دارُ ما أَيّامُنا بِذَمائِمٍ","لَدَيكَ وَلا أَشواقُنا بِرَمائِمِ",35,"م",1,0],["فيا دهري الذي قد غاب عني","أقلني في الذي قد كان مني",36,"ن",2,0],["فيا دار أوطاني ومنزل صَبْوَتِي","ومَرْبَع أُنْسِي هل بك الدهر يسعد",37,"د",1,0],["فيا دارنا لا عداك الحيا","وجرَّت عليكِ الغوادي ذيولا",38,"ل",2,0],["في أدهم القطر رمى","وأشقر السيل حمل",39,"ل",1,0],["فَيا دارَ سَلمى بِالصَريمَةِ فَاللِوى","إِلى مَدفَعِ القيقاءِ فَالمُتَثَلَّمِ",40,"م",1,0],["فيا دهر سحقاً ولا تحتشم","فقد ذهب الرجل المحتشم",41,"م",1,0],["فَيَا دَهْرُ قُمْ فاسْحَبْ ذُيولَ مَخِيلَةٍ","وَرَنِّحَ أَعْطَافاً بِرَنَّةِ شَادي",42,"د",2,0],["فيا دِمْنَة الحيّ الّذين تحمّلوا","بوادي الغَضا ماذا ألمَّ بنا منك",43,"ك",1,0],["فيا داءَ قلبي ما أراك تُغِبُّنِي","ويا سُكرَ قلبي ما أراك تفيقُ",44,"ق",1,0],["فيا دارَهمْ سقّاك مِن شَعَفٍ بهمْ","سِجالاً من النَّوْءِ السِّماكين أَوْطَفُ",45,"ف",1,0],["فَيا دُموعيَ كوني فيه واكِفةً","وَيا فؤادي اِحتَرقْ جرّاه بالنّارِ",46,"ر",1,0],["في أَدْهَمِيِّ ليلٍ وقيدٍ ومَنْ","خُيِّر لم يختر سِوَى الأَسْلَمِ",47,"م",1,0],["فيا دهرُ ارتدِع عني وإِلاّ","ستلقى من مُعين الدين نَصْلا",48,"ل",2,0],["فيا دهرُ كن آمناً فالذي","تهاب مضاه إِلى الله عاد",49,"د",1,0],["فيا دمعَ عيني لا تجفَّ من البكا","ويا جدمرَ قلبي لا برَحتَ مُصَاحبي",50,"ب",2,0],["فَيا دَوحة المَجد المؤثَّل وَالنَدى","وَيا صاحب الرَأي السَديد بِعصره",51,"ر",2,0],["فَيا دَجال هَذا العَصر يا مَن","غَدا في المسخ أَشبَهَ بِالقُرود",52,"د",1,0],["فَيا دَهرَنا مِن قَبلِ مَقتَلِ مُصعَبٍ","أَلا اِرجِع بِدُنيانا الرَفيعَةِ تَخصِبِ",53,"ب",1,0],["فيا دَوْلَةَ البُعدِ الوَخيمةَ أَقْشِعي","ويا مُدّةَ القُرب الكريمةَ عُودي",54,"د",2,0],["فيا دهر هلا منك بعضُ إراحةٍ","لذي كمد بادي الأسى والتحرق",55,"ق",1,0],["فَيا دارهم حيث الحَنايا وَصائِغ","وَحيث تهادى الدوح واِنعطف البان",56,"ن",1,0],["فيا دهر رفقاً فربع العلوم","وربع المكارم قد أعصرا",57,"ر",2,0],["فَيَا دَاعِي الخَلِيّ إلَى التَّصَابِي","لقد أسْمَعْتَ لَوْ نَادَيْتَ حَيَّا",58,"ي",2,0],["فيا دمع لا تغضب ولو عدت نحوه","ويا قلب ان الصبر ضاع بلا اجر",59,"ر",1,0],["فيا دهر ساعد على بغيتي","ويا عمر كن بعض أسبابها",60,"ب",3,0],["فيا دين يهنيك منهم امام","أقام عمادك بعد الميل",61,"ل",1,0],["فيا دمع قد وردت خدا مخددا","ويا ليل طرفى بالسهاد كحيل",62,"ل",1,0],["فيا دولةَ الضّيْمِ اجْمِلِي أوْ تَجَامَلي","فقد أصْحَبَت تلك العرى والعرائك",63,"ك",1,0],["فيا دارنا يالشام هل لك رجعة","لصب يصب الدمع طوراً ويغدق",64,"ق",1,0],["فيادارَها لا تجزعي إنَّ بينها","سحابةُ صيف على قليل تقشَّع",65,"ع",1,0],["فيا دمعي بعيني كُن مُعيني","ويا صبري على ذا كُن نصيري",66,"ر",2,0],["فيا داراً بها العشاق ناحت","شكوت إلى المليحة حين راحت",67,"ت",1,0],["فيا دعوةَ الملهوفِ قد آنَ وقتُها","ويا باديَ الألطافِ جد ليَ باللطفِ",68,"ف",1,0],["فيا در دم في لج بحرك ساكنا","وأنت له يا فكر لا تبغ معبرا",69,"ر",2,0],["فيا دماً سال عن تقوى فعاد له","بين الدماء طهوراً طيباً زانا",70,"ن",2,0],["فيا دمية القصر اسحبي ذيل عزّةٍ","وتيمي فقد وشاك ما شاءه علي",71,"ل",2,0],["فيا دهري وبيعي كان خسراً","لحاك اللَه هل مثلي يباع",72,"ع",1,0],["فيا دوحة المجد الذي طاب أصلها","واينع من أغصانها ثمر الشكر",73,"ر",1,0],["فيا دهر رفقا فالعلا قد غدا على","شفا جرف بالنائبات كما ترى",74,"ر",2,0],["فيا دار الأحبة كم يُداني","خيالك مقلتي وقت الرقادِ",75,"د",1,0],["فيا ديباجة الخد","تلوناك قراطيسا",76,"س",2,0],["فيا دهر وقّع للغناء بريشة","على سلك قلبي لا توقّع بمعول",77,"ل",1,0],["فيا درة نزلت في حصىً","ويا زهرة سكنت بلقعا",78,"ع",2,0],["فَيا دَوحة الأَشراف مِن آل هاشم","سَقَيتُم مِن الغَيث الهتون زلالا",79,"ل",2,0],["فيا دهر كم تسطو عل الناس قالبا","لظهر مجنّ مُولِغاً فيهم المدى",80,"د",2,0],["فيا دمعَ عيني أنت تمنع ناظري","نعيماً به فارفق فإنك ظالمه",81,"م",2,0],["فيا دهرُ عَجِّل بالتراجع بَيْنَنا","فإنك للرُّجْعى مُعِيناً ومُشفِقا",82,"ق",2,0],["فيَا دهرُ هل فيكَ مثلي فتى","يلاقي الرّزايا بوَجه لطيف",83,"ف",1,0],["فَيَا دمع هل أنتَ من لجّةِ","ويا نار هل أنتِ من موقِدِ",84,"د",1,0],["فَيا دهرُ إن أشكُ لا تغترر","فما أنا في موقف المجتدي",84,"د",2,0],["فَيا دَهرُ قَدكَ فَأَسجِح بِنا","فَلَسنا بِصَخرٍ وَلَسنا حَديدا",85,"د",2,0],["فَيا دَهْرُ قد حاولتُ عندكَ مَطمَعاً","فحَقُّكَ أنْ تُعْطي وتُسْرِفُ في البذْلِ",86,"ل",1,0],["فيا دار لم يقفرك منا اختيارنا","ولو أننا نتسطيع كنت لنا قبرا",87,"ر",2,0],["فَيا دَهرُ وَيك اليَوم قَد خَنَت عَهدَنا","امالَك في حِفظ العُهودِ زِمامُ",88,"م",1,0],["في أديم الغبراء تذهب عنى","من حياتي أدران من هم صحابي",89,"ب",2,0],["فيا دهريَ المعتاد طبعاً على الجفا","ومن عُرفت في الخافقين معايبه",90,"ب",2,0],["فيا دهرُ سالم أو فحارب فانني","رأيت مرير الصبر تحلو عواقبه",90,"ب",2,0],["فيا دامت مساعيه ودامت","له البشرى لتبلغه مناه",91,"ا",2,0],["فيا دافنيه ما دفنتم محمداً","ولكن دفنتم آية الله في اللحد",92,"د",1,0],["فياديمة للعمر كيف تقشعت","وما اخضرّ منها للأماني يابس",93,"س",1,0],["فيا ديمة للعمر ما بالها انجلت","وما اخضرّ منها للأماني يابس",94,"س",1,0],["فيا ديرة الغراء عذرا فإنني","عجزت عن الشكر الذي هو واجب",95,"ب",1,0],["فيا دهرُ قد نِلتَ ما ترتجي","ظفرتَ لَعَمري بكنز الورى",96,"ر",2,0],["فيا دهر قدما كنت صعبا فلم تزل","بسهمك ترمي كل عظم ومفصل",97,"ل",1,0],["فيا دهر هل بعد التفرق رجعة","فيهتف بي للوصل يا دهر هاتف",98,"ف",1,0],["فيا دهرُ قد أجريتَ عين العلى دَماً","بانسان عين المجد يا دهرُ لو تدري",99,"ر",2,0],["فيا دائم النعمى أجرني من النوى","ولا تحرمني ما عهدت من الفضل",100,"ل",1,0],["فَيا دَهرُ دَع لي مِن فُؤادِي بَقيَّةً","لِوَصلِ وَدُودٍ أَو تَذكُّرِ غائِبِ",101,"ب",1,0],["فيا دهر فاتتك الهداية بعده","وما أن أرى عنك الغواية تنجلي",102,"ل",2,0],["فيا ديمة في كل أرض تهللت","وبدر علاً في كل فيفاء أشرقا",103,"ق",2,0],["فيا دمت ملجا كل من شد رحله","لمغنى به للوفد والجود مألف",104,"ف",1,0],["في أديمها ضحِكٌ","في غُضونها حِكمُ",105,"م",1,0],["فيا دهرُ المصائب كُفْ مصابا","لقد اثخنتني الجُرحَ انتيابا",106,"ب",