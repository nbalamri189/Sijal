{"poems":[[53,"ألا يا ليالي الخيف هل يرجع الهوى","https://www.aldiwan.net/poem30437.html","الطويل"],[63,"فؤاد ببين الظاعنين مروع","https://www.aldiwan.net/poem45790.html","الطويل"],[86,"مرضنا فما عادنا عائد","https://www.aldiwan.net/poem10502.html","المتقارب"],[91,"صاحت الضفضع لما شاهدت","https://www.aldiwan.net/poem62742.html","عموديه"],[85,"أعفريت من الجن","https://www.aldiwan.net/poem7746.html","مجزوء الوافر"],[85,"نراوح بالحوادث أو نغادى","https://www.aldiwan.net/poem8105.html","الوافر"],[62,"بالزوابيق زال ظل النحاس","https://www.aldiwan.net/poem52173.html","الخفيف"],[99,"لا تسألوني","https://www.aldiwan.net/poem5901.html","عموديه"],[66,"وفى لي فيك الدمع إذ خانني الصبر","https://www.aldiwan.net/poem40123.html","الطويل"],[80,"عسى للصبا علم برسم المعالم","https://www.aldiwan.net/poem31293.html","الطويل"],[80,"أغمر الهوى كم ذا تقطعني عذلا","https://www.aldiwan.net/poem31329.html","الطويل"],[74,"لذكرك ماعب الخليج يصفق","https://www.aldiwan.net/poem13194.html","الطويل"],[46,"أمالي الزمان على بنيه","https://www.aldiwan.net/poem23236.html","الوافر"],[46,"بني الحسب الوضاح والشرف الجم","https://www.aldiwan.net/poem23627.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39590","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16663","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42684","السريع"],[90,"يافا الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179202",""],[128,"ثقيل على كل الورى من تكبر","https://www.aldiwan.net/poem50587.html","الطويل"],[160,"إلى كم تمادى في غرور وغفلة","https://www.aldiwan.net/poem59149.html","الطويل"],[182,"زمان الحمى هل من معاد فنطمعا","https://www.aldiwan.net/poem67052.html","الطويل"],[185,"لعل زماني بالعذيب يعود","https://www.aldiwan.net/poem14502.html","الطويل"],[185,"سلام على القصرين من منشأ الصبا","https://www.aldiwan.net/poem14536.html","الطويل"],[198,"لمغناك سح المزن أدمع باك","https://www.aldiwan.net/poem51909.html","الطويل"],[198,"قفا نقتبس من نور تلك الركائب","https://www.aldiwan.net/poem51987.html","الطويل"],[199,"من الصدع في قلبي غداة تهدما","https://www.aldiwan.net/poem45161.html","الطويل"],[211,"عن الوطن الغالي أهاجر مرغما","https://www.aldiwan.net/poem46627.html","الطويل"],[223,"أشعة من مقلتيك ملهبه","https://www.aldiwan.net/poem39698.html","الرجز"],[237,"لي الله قلبي كم يذوب من الذكرى","https://www.aldiwan.net/poem18191.html","الطويل"],[252,"أبى جلد أن أحمل البين والقلى","https://www.aldiwan.net/poem1415.html",""],[259,"إذا لم تكن أنت الدليل فلا هدى","https://www.aldiwan.net/poem35576.html","الطويل"],[261,"أظن الصبا جابت إليك المسالكا","https://www.aldiwan.net/poem38220.html","الطويل"],[271,"أغيب وذو اللطائف لا يغيب","https://www.aldiwan.net/poem52126.html","الوافر"],[305,"أقضي زماني بين صد وهجران","https://www.aldiwan.net/poem56381.html","الطويل"],[366,"أبى الدمع أن يشفى به هم هائم","https://www.aldiwan.net/poem17262.html","الطويل"],[403,"تشابه حالنا في كل فن","https://www.aldiwan.net/poem33386.html","الوافر"],[403,"إلي أحاديث الصبابة تسند","https://www.aldiwan.net/poem33978.html","الطويل"],[416,"فؤاد كطرفك أمسى عليلا","https://www.aldiwan.net/poem54167.html","المتقارب"],[464,"جد بقلبي وهزل","https://www.aldiwan.net/poem3313.html","عموديه"],[471,"ألا يا لقوم للجديد المصرم","https://www.aldiwan.net/poem753.html",""],[527,"ألست ترى السيف كيف انثلم","https://www.aldiwan.net/poem45972.html","المتقارب"],[529,"وفود حبيب أم ورود عهاد","https://www.aldiwan.net/poem37457.html","الطويل"],[551,"أفي دارهم من بعدما ارتحلوا تبكي","https://www.aldiwan.net/poem47342.html","الطويل"],[551,"تراءت لنا بالأبرقين بروق","https://www.aldiwan.net/poem47376.html","الطويل"],[551,"لنا من ثناياك الغريض المرشف","https://www.aldiwan.net/poem47403.html","الطويل"],[551,"ما لي تطيح الدهر أخياري","https://www.aldiwan.net/poem47788.html","البسيط"],[575,"قدمت بالنصر وبالمغنم","https://www.aldiwan.net/poem3014.html","السريع"],[585,"أتطمع في عقالك أن يحلا","https://www.aldiwan.net/poem1564.html",""]],"verses":[["فَيا دينَ قَلبي مِن ثَلاثٍ عَلى مِنىً","مَضَينَ وَلَم يُبقينَ غَبرَ جَوى الذِكرِ",0,"ر",1,0],["فَيا دَهرُ رِفقاً إِنَّ بَينَ جوانِحي","حُشاشَةَ نَفسٍ مِن أَسىً تَتَقَطَّعُ",1,"ع",1,0],["فَيا دَولَةً آذَنَت بِالزَوالِ","رَجَعنا لِعَهدِ الهَوى فَاِرجِعي",2,"ع",2,0],["في أَديمِ الماءِ مِن أَصواتِها","رَعدَةُ الحُمّى وَفي اللَيلِ وُجوم",3,"م",1,0],["فيا دى ويت يا ليت","وهل ينفعكم ليت",4,"ت",1,0],["فَيا داراً مِن الهِمَمِ العَوالي","سُقيتِ التِبرَ لا أَرضى العِهادا",5,"د",2,0],["في أداة مسدودة الرأس لا تخ","رج منها الأنفاس عند الزفير",6,"ر",1,0],["في أدمع الشتاء حين يبكي","وفي عطاء الديمة السكوب",7,"ب",1,0],["فَيا دَوحَةَ المَجدِ الَّذي عِندَما ذَوَت","سَمَت وَنَمَت في المَجدِ أَغصانُها الخُضرُ",8,"ر",1,0],["فيا دَوْلَةً قعساءَ دَرّتْ فأرْضَعَتْ","ثُديّ المنايا أو ثُديّ المكارمِ",9,"م",1,0],["فيا دارُ أغضى الدهرُ عنكِ وأكثرتْ","أُسودُكِ نَسلاً فيه يَختَتِلُ النّسلا",10,"ل",2,0],["فَيا دَوحَةَ العَلياءِ حَيَّتكَ رَوضَةٌ","عَلَيها رِداءٌ لِلرَبيعِ مُنَمَّقُ",11,"ق",1,0],["فَيا دارَ الخَسارِ أَلا خَلاصٌ","فَأَذهَبَ في الجَنوبِ أَو الشِمالِ",12,"ل",1,0],["فيَا دافنيهِ في الثّرَى إنّ لحدَهُ","مَقَرُّ الثّرَيّا فادْفِنوهُ على عِلْمِ",13,"م",1,0],["فيا دُرَّةً لم يحوِها تاجُ قيصر","ولا انتظمتْ إلَّا مفارقَ شاعرِ",14,"ر",1,0],["فيا دارَهَا بالحَزْنِ إنّ مَزارَها","قرِيبٌ ولكنْ دونَ ذلكَ أهْوال",15,"ل",1,0],["فَيَا دموعَ الْقَطْرِ سِيلِي دَماً","وَيَا بَنَاتِ الأَيْكِ نُوحِي مَعِي",16,"ي",1,0],["فيا داري إذا ضاقَت ديارٌ","ويا صَحبيْ إذا قلَّ الصِحاب",17,"ب",1,0],["فيا داء مَن يرنُو إلى قبحِ وجهه","ويا مَن على كلِّ الورى بغضهُ فرضُ",18,"ض",1,0],["فيا درة بين المزابل ألقيت","وجوهرة بيعت بأبخس قيمة",19,"ه",1,0],["فَيا دَهرُ جَدٌّ ذاكَ أَم أَنتَ هازِلٌ","وَكَيفَ بِمَن لَم يَدرِ لِلهَزَلِ مَنزَعا",20,"ع",2,0],["فيا دهر مَهْلا ما بقي فيَّ مَطْمعٌ","لحادثةٍ تنَتْاشُنى فتَؤود",21,"د",1,0],["فيا دهرُ ألاَّ كان ليلَى كُله","كليلةِ شَرْقيِّ الخَليِج من الثغر",22,"ر",1,0],["فيا دُرُّ إن أمسيتِ عُطلاً فطالما","غدا الدرُّ والياقوتُ بعض حلاكِ",23,"ك",1,0],["فيا دَيْنَ قلبي من تألُّقِ بارقٍ","سرى فاتَّقَتْه مُقلتي بسحائبِ",24,"ب",1,0],["فيا دمع ايام الحداثة ليتني","حفظتك للبؤسى لقد كنت أَنعما",25,"م",2,0],["فيا دار لا دارت عليك دوائرٌ","ولا ذُقت في ليليك غائلة السهد",26,"د",1,0],["في أَدمُعِ الأَيِّمِ وَاليَتيمِ","في صَرخَةِ البَريءِ وَالمَظلومِ",27,"م",1,0],["فَيَا دَارَنَا الْغَرَّا عَلَى الرَّبْوَةِ الْخَضْرَا","لَدَى الصَّدَفَيْنِ الْمُشْرِفَيْنِ عَلَى الْحَمْرَا",28,"ر",2,0],["فَيا ديَمَ الاحسانِ سَحّاً وَديمَةً","وَهَطلاً فَقَد صادَفتَ أَجرد مُمحِلا",29,"ل",2,0],["فيا دعوة المضطرّ قد آن وقتها","ويا بارئ الأسقام جُد ليَ باللطف",30,"ف",1,0],["فيا دهر مذ الجأتني لفنائه","أمنت مع الأيام بؤسي وبأسكا",31,"ك",2,0],["فَيا ديات يوم الدين فرج","هموما في الفؤاد لها دَبيب",32,"ب",1,0],["فَيا دمعَ أَجفاني وَيا حرّ أَضلُعي","أَجدّكما لا ترثيانِ لأشجاني",33,"ي",1,0],["فَيا دارُ ما أَيّامُنا بِذَمائِمٍ","لَدَيكَ وَلا أَشواقُنا بِرَمائِمِ",34,"م",1,0],["فيا دهري الذي قد غاب عني","أقلني في الذي قد كان مني",35,"ي",1,0],["فيا دار أوطاني ومنزل صَبْوَتِي","ومَرْبَع أُنْسِي هل بك الدهر يسعد",36,"د",1,0],["فيا دارنا لا عداك الحيا","وجرَّت عليكِ الغوادي ذيولا",37,"ل",2,0],["في أدهم القطر رمى","وأشقر السيل حمل",38,"ل",1,0],["فَيا دارَ سَلمى بِالصَريمَةِ فَاللِوى","إِلى مَدفَعِ القيقاءِ فَالمُتَثَلَّمِ",39,"م",1,0],["فيا دهر سحقاً ولا تحتشم","فقد ذهب الرجل المحتشم",40,"م",1,0],["فَيَا دَهْرُ قُمْ فاسْحَبْ ذُيولَ مَخِيلَةٍ","وَرَنِّحَ أَعْطَافاً بِرَنَّةِ شَادي",41,"ي",1,0],["فيا دِمْنَة الحيّ الّذين تحمّلوا","بوادي الغَضا ماذا ألمَّ بنا منك",42,"ك",1,0],["فيا داءَ قلبي ما أراك تُغِبُّنِي","ويا سُكرَ قلبي ما أراك تفيقُ",43,"ق",1,0],["فيا دارَهمْ سقّاك مِن شَعَفٍ بهمْ","سِجالاً من النَّوْءِ السِّماكين أَوْطَفُ",44,"ف",1,0],["فَيا دُموعيَ كوني فيه واكِفةً","وَيا فؤادي اِحتَرقْ جرّاه بالنّارِ",45,"ر",1,0],["في أَدْهَمِيِّ ليلٍ وقيدٍ ومَنْ","خُيِّر لم يختر سِوَى الأَسْلَمِ",46,"م",1,0],["فيا دهرُ ارتدِع عني وإِلاّ","ستلقى من مُعين الدين نَصْلا",47,"ل",2,0]]}