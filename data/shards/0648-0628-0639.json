/9976","الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20987","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54855","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55505","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55093","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55178","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54618","المجتث"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5577","الطويل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/854","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141994","الوافر"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13598","الكامل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199476","المنسرح"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43736","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43697","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54242","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54296","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[106,"إلى الوزير الأديب","https://www.poetsgate.com/ViewPoem.aspx?id=179707",""],[106,"ظلع وشيب!","https://www.poetsgate.com/ViewPoem.aspx?id=179321",""],[106,"حديث خرافة","https://www.poetsgate.com/ViewPoem.aspx?id=179406",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[77,"الحمدُ لله مَوْصُولا كما وجبا","https://www.poetsgate.com/ViewPoem.aspx?id=33314",""],[22,"يأيُّها المَلِكُ الذي أَمْسَتْ لَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=19777",""],[100,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[50,"طَرَقَتَنَا بالزَّابيَيْنِ الرَّبَابُ","https://www.poetsgate.com/ViewPoem.aspx?id=17925",""],[90,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[90,"عتاب مع النفس ..","https://www.poetsgate.com/ViewPoem.aspx?id=179099",""],[54,"تولّى طاهرٌ منْ بعدِ أنْ قدْ","https://www.poetsgate.com/ViewPoem.aspx?id=14478",""],[45,"أكْثَرُ هَذي الخُطوبِ أشكَالُ","https://www.poetsgate.com/ViewPoem.aspx?id=32121",""],[91,"الإبريق","https://www.poetsgate.com/ViewPoem.aspx?id=1192",""],[35,"بَكَى سائِبٌ لمّا رأى رَمْلَ عَالِجٍ","https://www.poetsgate.com/ViewPoem.aspx?id=22047",""],[51,"طلب البيهقي قَرناً فلم يُحْ","https://www.poetsgate.com/ViewPoem.aspx?id=30689",""],[39,"قفَا فاسألاَ الدِّمنَة َ المَاصحَة ْ","https://www.poetsgate.com/ViewPoem.aspx?id=4239",""],[24,"أمِنْ أُمِّ شَدّادٍ رُسُومُ المَنَازِلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10881&r=&rc=22",""],[20,"ليت شعري عنِ الهمام ويأتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70014&r=&rc=36",""],[88,"تحرّ إذا صادقتَ مَن رُدُّه مَحض","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19572&r=&rc=75",""],[4,"أصْبَحْتُ أمْشي بَعْدَ سَلْمى بن مالكٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10906&r=&rc=2",""]],"verses":[["وَبُعداً لَعَيني لِم أَصابَتهُ بِالأَذى","وَأَلّا تَلَقَّت واقِعَ السوءِ قَبلَه",0,"ل",2,0],["وَبَعضُ مَوالي المَرءِ يَغمِزُ عودَهُ","كَما غَمَزَ القِدحَ الخَليعُ المُقامِرُ",1,"ر",1,0],["وَبَعضُ العُدمِ مَأثَرَةٌ وَفَخرٌ","وَبَعضُ المالِ مَنقَصَةٌ وَعابُ",2,"ب",1,0],["وَبَعدَكُمُ أَناخَ إِلى مَحَلٍّ","يُطَلِّقُ عِندَهُ الدَلوَ الرِشاءُ",3,"ا",2,0],["وَبِعَينَيكَ أَوقَدَت هِندٌ النا","رَ أَخيراً تُلوي بِها العَلياءُ",4,"ا",2,0],["وَبَعَثتَ مِن وُلدِ الأَغرِّ مُعَتِّباً","صَقراً يَلوذُ حَمامُهُ بِالعَوسَجِ",5,"ج",1,0],["وَبِعَينَيكِ وَما قَد ضَمِنَت","مِن دَواهي سِحرِها وَالكَحَلِ",6,"ل",1,0],["وَبَعدَ العُسرِ قَد لاقَيتُ يُسر","وَمَلكاً لا يُحيطُ بِهِ الكَلامُ",7,"م",1,0],["وبعَثْتُها لتَنوبَ قبْلَ توصُّلي","لكَ إذْ عَراني عنْكَ عُذْرٌ ظاهِرُ",8,"ر",1,0],["وَبَعْدَ فَرْضِ الْحَجِّ لاَبُدَّ لِي","مِنْ دَارِ مَوْلاَيَ وَمِنْ بَابِهِ",9,"ب",2,0],["وَبَعْدُ عُثْمَانُ ذُو النُّورَيْنِ ثَالِثُهُمْ","مَنْ أَحْرَزَ الْمَجْدَ مَوْرُوثاً وَمُكْتَسَبَا",10,"ب",2,0],["وَبَعْدُ أَنْصَارُهُ الأَرْضَوْنَ إِنَّ لَهْمْ","فَضَائِلاً أَعْجَزَتْ مَنْ عَدَّ أَوْ حَسَبَا",10,"ب",2,0],["وَبَعْد هَذَا الَّذِي قَدَّمْتُ مِنْ كَلَمٍ","صِدْقٍ يُقَدِّمُهُ مَنْ خَطَّ أَوْ خَطَبَا",10,"ب",2,0],["وَبَعضُ الرِزقِ في دعَةٍ وَخَفضٍ","وَبَعضُ الرِزقَ يُكسَبُ بِالعَناءِ",11,"ا",2,0],["وَبَعدَ لَيالٍ قَد خَلونَ وَأَشهُرٍ","عَلى إِثرِ حَولٍ قَد تَجَرَّمَ كامِلِ",12,"ل",1,0],["وَبَعضٌ تَجَلّى في مَصابيحَ زَيتُها","يُضيءُ وَلا نارٌ وَبَعضٌ مُكَهرَبُ",13,"ب",1,0],["وَبَعدَ ذا عُوِّضَ عَن دارِهِ","عَدناً وَمِن ديباجِهِ السُندُسا",14,"س",2,0],["وَبَعضُ المَوالي تُتَّقى دَرَءاتُهُ","كَما تُتَّقى روسُ الأَفاعي الأَضالِعِ",15,"ع",1,0],["وبعده سمكة تختار","من خير ما جادت به البحار",16,"ر",1,0],["وبعهده الثرثارة الفيلسوف","حسين القاضي السفيه العسوف",17,"ف",1,0],["وَبَعَثْتَ الأَشْخَاصَ بَعْثاً عَجِيباً","وَسَبَكْتَ الأَغْرَاضَ سَبكاً رَصِينَا",18,"ن",2,0],["وَبِعَارِضَيْهِ الهَابِطَيْنِ وَلِمَّةٍ","شَعْثَاءَ لَمْ تُلمَمْ مِنَ الثَّوَرَانِ",19,"ن",1,0],["وَبَعْدَ غرِّ مَسَاعٍ","لِلحَمْدِ غَيْرِ ذَمَائِمْ",20,"م",1,0],["وَبَعْضُ مَا عَاقَبُوكُمْ فِيهِ جَعْلُكُمُو","صِدقَ الهَوَى لِلْحِمَى دِيناً وَتَعْلِيمَا",21,"م",2,0],["وَ بَعْلَبكُّ تُعَانِي","آلامَ خَطْبٍ جَسِيمِ",22,"م",1,0],["وَبَعضٌ في خُزاعَةَ مُنتَماهُ","وَلاءٌ غَيرُ مَجهولٍ قَديمُ",23,"م",1,0],["وَبَعضُهُمُ يَهَشُّ لِآلِ كِسرى","وَيَزعُمُ أَنَّهُ عِلجٌ لَئيمُ",23,"م",1,0],["وَبِعِ السَفاهَةَ بِالوَقارِ وَبِالنُهى","ثَمَنٌ لَعَمرُكَ إِن فَعَلتَ رَبيحُ",24,"ح",1,0],["وَبعَينِ أَحوَرَ يَرتَعي","سَقطَ الكثيبِ منَ العَقِيق",25,"ق",1,0],["وبَعدَ عُبَيدَةَ المحمودِ فِيهم","وبَعدَ سَمَاعةَ العَودِ العَتيقِ",26,"ق",1,0],["وبَعدَ ابنِ المُفضَّلِ وابنِ كافٍ","هما أَخَواكَ في الزَّمنِ الأَنيقِ",26,"ق",1,0],["وَبَعدَ شَدَّ القَرَبِ المَمسودِ","يَخرُجنَ مِن ذي ظُلَمٍ مَنضودِ",27,"د",1,0],["وَبعضُ الهَوى بِالهَجرِ يُمحى فَيمتَحي","وَحُبُّكِ عِندي يَستَجِدُّ وَيَربَحُ",28,"ح",1,0],["وبعزك وظهورك","تشرق الحمرا المنيفا",29,"ف",2,0],["وبعدما قتلوه هكذا علموا","بأنهم قد أصابوا المجد والشرفا",30,"ف",2,0],["وبعض من مطاعمنا وَقود","تُديم به حرارتها الجسوم",31,"م",1,0],["وبعضهم تمرع وديانه","وبعضهم واديه لا يمرع",32,"ع",1,0],["وَبَعدَ أَبي عَمرٍ وَذي الفَضلِ عامِرٍ","وَبَعدَ المُرَجّى عُروَةَ الخَيرِ لِلكُرَب",33,"ب",1,0],["وَبَعدَ طُفَيلٍ ذي الفِعالِ تَعَلَّقَت","بِهِ ذاتُ ظُفرٍ لا تُوَرَّعُ بِاللَجَب",33,"ب",1,0],["وَبَعدَ أَبي حَيّانَ يَومَ حَمومَةٍ","أُتيحَ لَهُ زَأوٌ فَأُزلِقَ عَن رَتَب",33,"ب",1,0],["وبعدُ في غزوة كانت مباركةً","تروى زراعة أقوام وتحتصدُ",34,"د",1,1],["وبعد إشارتهم بالسيا","ط هوجاءُ ليلتَها هو جَلْ",35,"ل",1,1],["وَبَعدُ فَلا تَنفَكُّ تَنزِلُ بَينَهُم","قَوارِعُ ذُلٍّ لا تُرَدُّ صُروفُها",36,"ف",3,0],["وَبِعَمِّكَ المَسلوبِ بِزَّتَهُ","وَأَخيكَ مُنعَفِرَينِ في الجَفرِ",37,"ر",1,0],["وَبَعدَ الشَبابِ الشَيبُ وَالضَعفُ وَالفَنا","وَمَوتٌ لَهُ قَدرٌ عَبوسٌ مُكَدِّرُ",38,"ر",1,0],["وبعثت من فرحي خرو","فاً لو قدرت لزدته",39,"ت",2,0],["وبعض تدبيره الدُّنيا وما وسعتْ","فالكيمياء على ذا الحكم تدبير",40,"ر",1,0],["وبعد ذا والله ما أنسيت","محامدي الحلوة تكديري",41,"ر",2,0],["وبعدُ فإنّ عذري في قصوري","عن الباب المحجَّب ذي البهاءِ",42,"ا",2,0],["وبعدَ التَّهاجُر من وُصْلَةٍ","وبَعدَ التفرُّقِ من مُلتقى",43,"ا",1,0],["وبعدُ فإنَّني في مُشْمَخِرٍّ","عصائبُ رأسِه قِطَعُ الضَّبَابِ",44,"ب",1,0],["وبِعَدْلِكُمْ أضحى مَراداً واسعَ ال","بُنْيان فيه سُرُوحه وسَرَاحُه",45,"ح",2,0],["وبَعْدُ فقد تَرَى اسْتِغْلاَقَ أَمْرِي","وطُولَ حِرَانِهِ ما يَسْتَقيدُ",46,"د",1,0],["وبَعدُ فإني يا قَرِيعَيْ زماننا","مُبِثُّكُما وجدي فما مثله وجْدُ",47,"د",1,0],["وبعد فإنِّي المرءُ أجديتُ قاعداً","ولم يجدِ قبلي قاعدٌ بقعودِهِ",48,"د",2,0],["وبعيدِ المنال من مُتعاطي","ه قَريبِ النَّوال من مُرْتادِهْ",49,"د",2,0],["وبعد كرب الرزايا والهلاع لها","رَوحٌ من اللَّه آتٍ غير محبوس",50,"س",1,0],[