{"poems":[[88,"بلابل وادي النيل بالمشرق اسجعي","https://www.aldiwan.net/poem68896.html","الطويل"],[32,"ألا حبذا أهل الملا غير أنه","https://www.aldiwan.net/poem29429.html","الطويل"],[74,"ما بت فيك بدمع عيني أشرق","https://www.aldiwan.net/poem19350.html","الكامل"],[74,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[93,"شوق يروح مع الزمان ويغتدي","https://www.aldiwan.net/poem8800.html","عموديه"],[30,"ومن عجب الأيام والدهر أن ترى","https://www.aldiwan.net/poem5610.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42596","الطويل"],[108,"فقيدُ الإسلام!","https://www.poetsgate.com/ViewPoem.aspx?id=179686",""],[119,"سلطان الحي وسيده","https://www.aldiwan.net/poem41169.html","عموديه"],[119,"علمتم بأني مغرم بكم صب","https://www.aldiwan.net/poem41234.html","عموديه"],[173,"إلى كم مناجاة الهموم العوازب","https://www.aldiwan.net/poem1604.html",""],[173,"إلى كم مداراة العدى واحترامها","https://www.aldiwan.net/poem1663.html",""],[275,"هلا وفيت كما وعدت حزينا","https://www.aldiwan.net/poem35582.html","الكامل"],[276,"سقاك الحيا الوسمى ربعا تأيدا","https://www.aldiwan.net/poem52098.html","الطويل"],[287,"أراني غريبا في دمشق وأهلها","https://www.aldiwan.net/poem32368.html","الطويل"],[303,"إذا الشعر لم ينفث به ربه السحرا","https://www.aldiwan.net/poem36848.html","عموديه"],[445,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[445,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[505,"يا رب بكل بارز غيبي","https://www.aldiwan.net/poem37706.html","الدوبيت"],[556,"مدحتكم علما بأن مدائحي","https://www.aldiwan.net/poem47385.html","الطويل"],[569,"أعيدوا لنا التاريخ احيوا لنا الذكرى","https://www.aldiwan.net/poem854.html",""],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107243","المتقارب"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126701","الطويل"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/105614","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62496","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62509","السريع"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90621","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122004","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96038","البسيط"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96034","الكامل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177823","الطويل"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107167","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200142","الوافر"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101640","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206149","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132110","البسيط"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107041","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83179","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120275","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52173","الكامل"],[4761,"هي الشمس أم نار على علم تبدو","https://www.poetsgate.com/ViewPoem.aspx?id=127120",""],[5051,"عيدُ الجُرح","https://www.poetsgate.com/ViewPoem.aspx?id=192269",""],[5314,"زورة للمغرب","https://www.poetsgate.com/ViewPoem.aspx?id=214748",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5376,"يا زائرَ البيتِ لو حُمِّلت من مُقلِ","https://www.poetsgate.com/ViewPoem.aspx?id=188424",""],[5397,"بكى الدين والدنيا عليك فأفجعا","https://www.poetsgate.com/ViewPoem.aspx?id=157901",""],[5431,"من يخبر الأرض؟...","https://www.poetsgate.com/ViewPoem.aspx?id=198396",""],[5431,"ليس إلاه راحما قمْ تقرّبْ","https://www.poetsgate.com/ViewPoem.aspx?id=199933",""],[5512,"خلف السواتر ..قمحانة","https://www.poetsgate.com/ViewPoem.aspx?id=204501",""],[6193,"فقا وانثرا دمعاً على التراب أحمرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55426&r=&rc=2",""],[6251,"وَثائِق ُالشَّمْس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76466&r=&rc=6",""]],"verses":[["فَيا ضَيعَةَ الأَقلامِ إِن لَم نَقُم بِها","دِعامَةَ رُكنِ المَشرِقِ المُتَزَعزِعِ",0,"ع",1,0],["فَيا ضَيعَةَ الشِعرِ الَّذي لَجَّ فَاِنقَضى","بِمَيًّ وَلَم أَملِك ضَلالاً فُؤادِيا",1,"ي",2,0],["فياض سيب حين يزهى مجلس","وخضيب سيف حين يعرو فيلق",2,"ق",1,0],["فياض سيب في الورَى فلم يقل","في هبةٍ يا هب مَن هذا الرجل",3,"ل",1,0],["في أَضلُعي نارٌ أَذابَت أَضلُعي","وَمَشَت إِلى كَبِدي وَلَمّا تَخمَدِ",4,"د",1,0],["فَيا ضَبَّ إِن جارَ الإِمامَ عَلَيكُمُ","فَجوروا عَلَيهِ بِالسُيوفِ الصَوارِمِ",5,"م",1,0],["فَيَا ضَارِباً فِي الأَرْضِ يَرْتَادُ غَايَةً","رُوَيْدَكَ إِنَّ الْفَوْزَ مِنْكَ بَعِيدُ",6,"د",1,0],["فيا ضيعةَ الآمالِ من بعدِ مصطفى!","لقد كان للآمال في مصرَ معقدا",7,"د",2,0],["فياض الراحة احمد من","يتلى للوصلة مسنده",8,"د",2,0],["فيا ضاحكا ابكى لبارق ثغره","كذا عند لمع البرق تنهمر السحب",9,"ب",1,0],["فَيا ضَيعَةَ المَدحِ الَّذي سارَ فيكُمُ","عَلى أَلسُنِ الرَواينِ سَيرَ الكَواكِبِ",10,"ب",1,0],["فَيا ضَيعَةَ المَسعى وَكَم مِن صَنيعَةٍ","غَدَت ضَلَّةً لَم يَبقَ إِلّا مَلامُها",11,"م",3,0],["في أضلعي قلبٌ يضيقُ عن المُنى","ما كان إلا في هواكِ سجينا",12,"ن",2,0],["فَيا ضيعة الايام ان هي أَدبرت","وَما انجزت بَيني وَبينك موعدا",13,"د",2,0],["فَيا ضَيعَتي فيهِم وَفَضلِيَ ظاهِرٌ","كَأَنّي لَدَيهِم مُصحَفٌ عِندَ باطِني",14,"ي",1,0],["فيا ضيعة المعنى إِذا اللفظُ خانه","وَواهاً له حياً لقد سَكَنَ القبرا",15,"ر",2,0],["فيا ضِيقَ ذَرْعِي لَهُمْ بالزَّفِيرِ","عَلَى ضِيقِ ذَرْعِي بِضِيقِ الشِّتاءِ",16,"ا",2,0],["فيا ضَلالَ نُجومِ اللَّيلِ إِذْ عَدِمَتْ","بَدْرَ السماءِ وَفِي حِجري مَضاجِعُهُ",17,"ع",2,0],["فياض معانٍ حققن كل بيانٍ","وفاً بمبانٍ أيدن كل ولي",18,"ي",1,0],["فيا ضيعةً للطّالعاتِ إليكُمُ","طلوعَ المطايا من خلالِ النّفانِفِ",19,"ف",1,0],["فيا ضارباً طبل الأباطيل معلناً","بابن الرفادة الآن فاضرب الصدرا",20,"ر",2,0],["فيا ضاحِكَ البَرقِ مِن أُفقِهِ","كَوجهِ الكَريمِ إِذا استُرفِدا",21,"د",2,0],["فيا ضيفنا المحبوب يا اِبن محمّد","ويا اِبن البهاليل الكرام الأطائبِ",22,"ب",1,0],["فيا ضيعة الإسلام إذ ساس أهله","من الروم والأتراك ذئب وقشعم",23,"م",1,0],["فياض أودية المكا","رمِ مخصِب سُمُرَ القَنا",24,"ن",2,0],["فياض بحر الجود بدر الدّجى","وضاح سبل الخير مُولي الجدَا",25,"د",2,0],["فياضيعةَ الأشعارِ إذ يقرضُونها","وأضيعُ منها من يَرى أنها شِعرُ",26,"ر",1,0],["فَيَّاضُ سُحْبِ الْجُودِ مَلْكٌ عَدْلُهُ","ظِلٌّ عَلَى كُلِّ الرَّعَايَا سَجْسَجُ",27,"ج",1,0],["فياض مكرمة خواض ملحمة","فضاض معضلة عار من الوصم",28,"م",1,0],["فياضة الكربات مثل","البحر يلتطم التطامه",29,"م",2,0],["فيا ضلة الأحلام ضلوا بجهلهم","عكوفا على الأصنام قد عبدوا ودا",30,"د",2,0],["فَيا ضَيغَماً بَل يا شِهاباً إِذا اِنجَلَى","تَنَحَّت شَياطِينُ الضَّلالِ عَلَى كَدِّ",31,"د",1,0],["فيا ضيف السجون كرمت ضيفاً","ويا نزل السجون قبحت نزلا",32,"ل",2,0],["في أضلعي من لهيب الحبِّ نارُ جوىً","ما زلتُ أسكب فيها ماءَ أَجفاني",33,"ن",2,0],["فيا ضيعة الدنيا إذا لم يكن بها","غنًى عنك للمحزون حين يثور",34,"ر",1,0],["فياض عندك مال المنجديك به","ممزّقٌ بنيوب الغدر ماكول",35,"ل",1,0],["فيا ضامري إن كنت تسمع بالمنى","فما هو إلا ما تظم ربي نجد",36,"د",1,0],["فَيا ضَيعَةُ الأَوراقِ في غَيرِ طائِلٍ","وَيا طُولَ ما تَشكو رَفُوفُ المَكاتِبِ",37,"ب",1,0],["فيا ضحكة قد اغرقتني في البكا","فلم يبق منا من يرى خصمه الاشنا",38,"ن",2,0],["فيّاضُ هذه نفثَةٌ لو لم تَرِدْ","شِعراً لسالت أدمعاً ونجيعا",39,"ع",2,0],["فيا ضيغم الغارات والأروع الذي","إذا لحظ الصم الجلاميد تنقد",40,"د",1,0],["فيَا ضَيْعَةَ الدُّنيا إذا الشَّعبُ لَمْ يَزَلْ","على مَهْدِهِ المسروقِ يعْدِمُ منْزِلا !",41,"ل",2,0],["فياضة بشعوري حلف بارقة","من التواريخ أغرت كل أفكاري",42,"ر",2,0],["فيا ضيعة الأعمار تمضي سهللاً","إذا كان هذا مدحكم كيف بالعدل",43,"ل",1,0],["فيَّاضةٌ يا نبيُّ اللهِ دمْعتُنا","أشكوك ما ثَقُلَتْ يا صفوةَ الرُسُلِ",44,"ل",1,0],["فيا ضربة قدت من الدين بيضة","غداة نضت بيضاً من الغي قطعا",45,"ع",2,0],["في أضلع البحر أسرار القلوب هوت","والماء يحفظ سرّ الشوق منعقدا",46,"د",2,0],["في اضطراب وحرّقة رحتَ تشكو","رمية النرد أنت لا شيئَ أصعبْ!!",47,"ب",1,0],["فياضُ والأصحابُ ضحُّوا بالدِّمَا","فكأنَّها فوقَ الترابِ مَعينُ",48,"ن",1,0],["فيا ضربة أهوت بضاربها ومن","يواليه في الكفر الصريح إلى الثرى",49,"ر",2,0],["ِفيْ أََْضْلُعِيْ تَبْكِيْ كَلَوْ أَنَّ","قِدِّيَسًا كَبِيْرَاً فِيْ ضُلُوْعِيْ انْتَحَرْ",50,"ر",1,0]]}