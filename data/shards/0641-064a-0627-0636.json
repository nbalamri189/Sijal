{"poems":[[86,"بلابل وادي النيل بالمشرق اسجعي","https://www.aldiwan.net/poem68896.html","الطويل"],[30,"ألا حبذا أهل الملا غير أنه","https://www.aldiwan.net/poem29429.html","الطويل"],[72,"ما بت فيك بدمع عيني أشرق","https://www.aldiwan.net/poem19350.html","الكامل"],[72,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[91,"شوق يروح مع الزمان ويغتدي","https://www.aldiwan.net/poem8800.html","عموديه"],[28,"ومن عجب الأيام والدهر أن ترى","https://www.aldiwan.net/poem5610.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42596","الطويل"],[106,"فقيدُ الإسلام!","https://www.poetsgate.com/ViewPoem.aspx?id=179686",""],[115,"سلطان الحي وسيده","https://www.aldiwan.net/poem41169.html","عموديه"],[115,"علمتم بأني مغرم بكم صب","https://www.aldiwan.net/poem41234.html","عموديه"],[169,"إلى كم مناجاة الهموم العوازب","https://www.aldiwan.net/poem1604.html",""],[169,"إلى كم مداراة العدى واحترامها","https://www.aldiwan.net/poem1663.html",""],[270,"هلا وفيت كما وعدت حزينا","https://www.aldiwan.net/poem35582.html","الكامل"],[271,"سقاك الحيا الوسمى ربعا تأيدا","https://www.aldiwan.net/poem52098.html","الطويل"],[282,"أراني غريبا في دمشق وأهلها","https://www.aldiwan.net/poem32368.html","الطويل"],[298,"إذا الشعر لم ينفث به ربه السحرا","https://www.aldiwan.net/poem36848.html","عموديه"],[439,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[439,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[500,"يا رب بكل بارز غيبي","https://www.aldiwan.net/poem37706.html","الدوبيت"],[551,"مدحتكم علما بأن مدائحي","https://www.aldiwan.net/poem47385.html","الطويل"],[564,"أعيدوا لنا التاريخ احيوا لنا الذكرى","https://www.aldiwan.net/poem854.html",""]],"verses":[["فَيا ضَيعَةَ الأَقلامِ إِن لَم نَقُم بِها","دِعامَةَ رُكنِ المَشرِقِ المُتَزَعزِعِ",0,"ع",1,0],["فَيا ضَيعَةَ الشِعرِ الَّذي لَجَّ فَاِنقَضى","بِمَيًّ وَلَم أَملِك ضَلالاً فُؤادِيا",1,"ي",2,0],["فياض سيب حين يزهى مجلس","وخضيب سيف حين يعرو فيلق",2,"ق",1,0],["فياض سيب في الورَى فلم يقل","في هبةٍ يا هب مَن هذا الرجل",3,"ل",1,0],["في أَضلُعي نارٌ أَذابَت أَضلُعي","وَمَشَت إِلى كَبِدي وَلَمّا تَخمَدِ",4,"د",1,0],["فَيا ضَبَّ إِن جارَ الإِمامَ عَلَيكُمُ","فَجوروا عَلَيهِ بِالسُيوفِ الصَوارِمِ",5,"م",1,0],["فَيَا ضَارِباً فِي الأَرْضِ يَرْتَادُ غَايَةً","رُوَيْدَكَ إِنَّ الْفَوْزَ مِنْكَ بَعِيدُ",6,"د",1,0],["فيا ضيعةَ الآمالِ من بعدِ مصطفى!","لقد كان للآمال في مصرَ معقدا",7,"د",2,0],["فياض الراحة احمد من","يتلى للوصلة مسنده",8,"د",2,0],["فيا ضاحكا ابكى لبارق ثغره","كذا عند لمع البرق تنهمر السحب",9,"ب",1,0],["فَيا ضَيعَةَ المَدحِ الَّذي سارَ فيكُمُ","عَلى أَلسُنِ الرَواينِ سَيرَ الكَواكِبِ",10,"ب",1,0],["فَيا ضَيعَةَ المَسعى وَكَم مِن صَنيعَةٍ","غَدَت ضَلَّةً لَم يَبقَ إِلّا مَلامُها",11,"م",3,0],["في أضلعي قلبٌ يضيقُ عن المُنى","ما كان إلا في هواكِ سجينا",12,"ن",2,0],["فَيا ضيعة الايام ان هي أَدبرت","وَما انجزت بَيني وَبينك موعدا",13,"د",2,0],["فَيا ضَيعَتي فيهِم وَفَضلِيَ ظاهِرٌ","كَأَنّي لَدَيهِم مُصحَفٌ عِندَ باطِني",14,"ي",1,0],["فيا ضيعة المعنى إِذا اللفظُ خانه","وَواهاً له حياً لقد سَكَنَ القبرا",15,"ر",2,0],["فيا ضِيقَ ذَرْعِي لَهُمْ بالزَّفِيرِ","عَلَى ضِيقِ ذَرْعِي بِضِيقِ الشِّتاءِ",16,"ا",2,0],["فيا ضَلالَ نُجومِ اللَّيلِ إِذْ عَدِمَتْ","بَدْرَ السماءِ وَفِي حِجري مَضاجِعُهُ",17,"ع",2,0],["فياض معانٍ حققن كل بيانٍ","وفاً بمبانٍ أيدن كل ولي",18,"ي",1,0],["فيا ضيعةً للطّالعاتِ إليكُمُ","طلوعَ المطايا من خلالِ النّفانِفِ",19,"ف",1,0],["فيا ضارباً طبل الأباطيل معلناً","بابن الرفادة الآن فاضرب الصدرا",20,"ر",2,0]]}