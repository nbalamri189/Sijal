.dctabudhabi.ae/diwan/poem/11245","البسيط"],[3601,"","https://poetry.dctabudhabi.ae/diwan/poem/104451","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110139","البسيط"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125925","الرمل"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114560","الرمل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104541","البسيط"],[4578,"لعارضي الشيب من هول النوى وخطا","https://www.poetsgate.com/ViewPoem.aspx?id=49461",""],[243,"أعاصير","https://www.poetsgate.com/ViewPoem.aspx?id=50473",""],[463,"طرفُ نجديّة ُ وطرفُ عراقيُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60153&r=&rc=209",""]],"verses":[["مَوضوعَةً صِفاحُهُ","وَضعَ المَطِيِّ الثَفِنا",0,"ن",2,0],["مَوضِعُ الذَمِّ زَماني","وَخَلاكَ اليَومَ ذامُ",1,"م",1,0],["مَوضوعُها التاجُ فَإِن حاوَلوا","بِها طَريقَ العَكسِ لَم تَصدُقِ",2,"ق",1,0],["مُوَضَّعٌ يستكدُّ فقْحَتَهُ","مُلتَمساً للبنين والحفدَهْ",3,"د",2,0],["موضعِ أسرارِكَ التي سُترتْ","وزيركَ المرتضي ومؤتمنِكْ",4,"ك",1,0],["مَوضِعٌ لا يَنالَهُم فيهِ ضَيمٌ","لا وَلا يُدرِكُ الشَبابَ الفَناءُ",5,"ا",2,0],["مُوَضَّحٌ لَيسَ بِذي رُجلَةٍ","أَشأَمَ وَالأَرجُلُ مِنها بَسوس",6,"س",1,0],["مَوْضِعُ البَيْتِ مَهْبِطُ الوَحْي مأْوى ال","رسلِ حيثُ الأنوارُ حيثُ البَهاءُ",7,"ا",2,0],["مَوضوعُها زَولٌ وَمَرفوعُها","كَمَرِّ صَوبٍ لَجِبٍ وَسطَ ريح",8,"ح",1,0],["موضع يولد الرّجاء من اليأس","إذا مات في القلوب الرجاء",9,"ا",2,0],["موضوعه في الجنة الخلود","حصة من في كيسه نقود",10,"د",1,0],["مَوضِعُ الأَنضادِ لَأياً ما يُرى","وَرَمادٌ مِثلَ كُحلِ العَينِ هابِ",11,"ب",1,0],["مُوَضِّحَاتٍ فَلاَ تَخْفَى عَلَى أَحَدٍ","إِلاَّ عَلَى جَاهِلٍ قَدْ رَاحَ يَنْفِيهَا",12,"ي",3,0],["موضع الشعر منهمُ موضع العذ","ذال يومَ النوى من العشّاقِ",13,"ق",1,0],["مُوضَحةٌ على ثلاثٍ نارُهُ","إن سَرِفوا النيرانَ في الرَّمادِ",14,"د",1,0],["موضوعةَ الرحل تُل","سّ حَكْمَها وتَرِدُ",15,"د",1,0],["موضُوعُه مِيزَةٌ أراهَا","في كرَة الأرضِ ذاتُ فقدِ",16,"د",1,0],["موضُع الحاكمين والأمرُ شورى","بينهم مثل موضع الأُجَراء",17,"ا",2,0],["مًوضِعٌ سُبْلَ التجارا","تِ إذا ضلَّ التجار",18,"ر",1,0],["موضوع سهدي ودمعي إن أمرت به","يا ناظري فعلى عيني محمول",19,"ل",1,0],["موضعُ القسِّ جنةُ الخُلدِ أضحت","مهجتي كل ساعةٍ تشتهيها",20,"ه",2,1],["موضونَةٌ كمَروحِ النَهيِ تحسَبُها","قد بَثَّ منهُ علَيها الجُندَبُ الحَدَقا",21,"ق",2,0],["موضوعها لفظا ومعنى لقد","أعرب عنه الدر والكوثر",22,"ر",1,0],["موضعُ سرَّ الله بَلْ أكرم من","كانَ لسرّهِ المَصون مَوضعا",23,"ع",2,0],["موضوعه كل كلام عربي","يبحث في مبنيه والمعرب",24,"ب",1,0],["موضوعه كل مقال عربي","يورد معناه بأي مشرب",25,"ب",1,0],["مَوضِعُ أَسرارِكَ المُريبُ","وَحَشوُ أَثوابِكَ العُيوبُ",26,"ب",1,1],["موضوعه الموجود كالإله","لكن على قانون دين اللَه",27,"ه",1,0],["موضوعُ جمع عبارات العِبادةِ اذ","تاريخهُ وضعُ مجموعِ العِباراتِ",28,"ت",1,0],["موضع الوجدان في أجسامنا","ودليلا للرزايا والنعم",29,"م",1,1],["موضوعها إن كان شخصا سميت","شخصية مخصوصة فيما ثبت",30,"ت",1,0],["موضحٌ ما يجبُ الستر له","جنبٌ لم يبد في الماء انغماسه",31,"س",2,0],["موضوعة بيد الأخلاق رايتها","أما إلى النجم أو للأرض تلقيها",32,"ي",3,0],["موضع صبري بمحمول الغرام غدت","نتيجة الشكل منه في القياس خطا",33,"ط",2,0],["موضع القيد بعد حين سيمسي","فوق انحانه الجريحات غار",34,"ر",1,0],["موضعُ الشَّعرُمنهمُ موضعَ الع","ذّالِ يومَ النّوى منَ العشَّاقِ",35,"ق",1,0]]}