ُ (جيش العراق)","https://www.poetsgate.com/ViewPoem.aspx?id=198923",""],[5720,"خير الورىٰﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=200910",""],[5861,"شكوى أم","https://www.poetsgate.com/ViewPoem.aspx?id=188057",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[5956,"وصلتْ إليّ رسالةٌ من درِّ","https://www.poetsgate.com/ViewPoem.aspx?id=193810",""],[6068,"قَدْ جُزْتُ بالسلفيّ عَادِلْ -09-","https://www.poetsgate.com/ViewPoem.aspx?id=175812",""],[6079,"سنن الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=212718",""],[6093,"فِيْ وَدَاعِ المُخْلِصينَا","https://www.poetsgate.com/ViewPoem.aspx?id=176427",""],[463,"أتُراها يومَ صدت أن أراها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60281&r=&rc=337",""]],"verses":[["فَجُزوا أَن قَضَيتُهُم","مِن يَدي أَو لِسانِيا",0,"ي",2,0],["فجَزَوْني جزاءَ منْ يخدُمُ السلْ","طانَ فيما مضى من الأعْصارِ",1,"ر",1,0],["فجَزاكَ بالأجْرِ الجَزيلِ صِيامُهُ","وحَباكَ بالنّصْرِ المؤزَّرِ عِيدُهُ",2,"د",2,0],["فَجُزنا بَطنَ مَكَة وَاِمتَنَعنا","بِتَقوى اللَهِ وَالبيضِ الخِفافِ",3,"ف",1,0],["فَجُزِيتِ خَيرَ جَزاءِ ناقَةِ واحِدٍ","وَرَجَعتِ سالِمَةَ القَرا بِسَلامِ",4,"م",1,0],["فَجَزاكِ رَبُّكِ في عَشيرِكِ نَظرَةً","وَسَقى صَداكِ مُجَلجِلٌ مِدرارُ",5,"ر",1,0],["فجزوه أن حفروا له حفراً","جذب المهيمن دونها ضَبعه",6,"ع",2,0],["فجزاهُ الإلهُ عنِّي خُلوداً","ونعمياً في ظِلِّ دار السلام",7,"م",1,0],["فَجَزاؤُها حُبّانِ حُبُّ بَاِسمِها","مِنّا وَحُبٌّ عَن جَميلِ فَعالِ",8,"ل",1,0],["فَجَزاكَ الإِلَهُ عَن ذَلِكَ الصَب","رِ عَلى الهَولِ جَنَّةً وَحَريرا",9,"ر",2,0],["فجزى الله بخيرٍ مَنْ نأى","ووقى مِنْ كلِّ خيرٍ مَنْ دَنا",10,"ن",2,0],["فَجَزانا إِذ حَمَدنا","وُدَّهُ لي أَن يَغيبا",11,"ب",2,0],["فجَزاهم ربُّهم من فضلهِ","صَالِحَ الأجرِ ومَوفورَ الجزاءْ",12,"ا",2,0],["فجزاهم من نَكالٍ ما لَقَوْا","وَيْ كأنَّ اللهيَجزِي المُفسِدا",13,"د",2,0],["فَجَزَتني بِما عَمِلتُ ثَواباً","حَسَناً كُنتُ أَهلَ ذاكَ الثَوابِ",14,"ب",1,0],["فَجَزانا أَن حَمَدنا","وُدَّهُ أَن لا يَغيبا",15,"ب",2,0],["فَجَزى الإِلَهُ أَخي بَغي","ضاً خَيرَ ما يُجزى المُعاشِر",16,"ر",1,0],["فَجَزاها لَعنَةً لِصاحِبٍ","لَيسَ لِلزَرّاعِ أَصلاً مِن مَعادِ",17,"د",1,0],["فَجَزاكِ الإِلَهُ حَقَّكِ عَنّي","لَم يُخَفِّف عَنّي بَلائي وَزِدتا",18,"ت",2,0],["فَجَزَتْهُ عنها بِبِيعَةِ رِضْوا","نٍ يَدٌ مِنْ نَبِيِّهِ بَيْضَاءُ",19,"ا",2,0],["فجزِعتُ حتى ليسَ بي جَزَعٌ","وحَذِرتُ حتى ليس بي حَذَر",20,"ر",1,0],["فَجَزى اللَهُ عَن أَخيكَ اِبنَ سِلمٍ","حينَ قَلَّ المَعروفُ خَيرَ الجَزاءِ",21,"ا",2,0],["فجزَوْهُمُ حُلوَ الكلامِ وطرَّزوا","إكليلَ ربِّ المُلْك مِن إكليله",22,"ل",2,0],["فَجَزعُ الحُلَيفِ إِلى واسِطٍ","فَذَلِكَ مُبدىً وَذا مَحضَرُ",23,"ر",1,0],["فجزى الله مؤمنا كل خير","دَفَعَ الواغلَ الظلوم المشوما",24,"م",2,0],["فَجَزاهُ حَظُّ الصالِحينَ وَلَم يَزَل","أرِّخ بغيثِ اللّطفِ يَسقي لحدَهُ",25,"د",2,0],["فجَزاك اللهُ عن إسلامه","خيرَ ما جازَى به مَن يَجْتَبي",26,"ب",2,0],["فجزالةُ العلماءِ في أثنائه","ممزوجةٌ بحلاوةِ الكتّاب",27,"ب",1,0],["فَجَزَيتُ أَفضَلَ ما عَلِمَت مُضاعَفاً","وَتَمَلَّ حُلوَ العَيشِ غَيرَ مُمَلَّلِ",28,"ل",1,0],["فجزى اللَه أهله كل خيرٍ","إنهم أحسنوا اشتقاقَ القياسِ",29,"س",1,0],["فجزاهم ربّ العباد بجنّةٍ","تجرى لهم من تحت بالأنهار",30,"ر",1,0],["فجزاكَ عَنَّا اللهُ أَفْضَلَ ما جَزَى","مَلِيكاً وخَصَّك بالبقاءِ الأَطَولِ",31,"ل",1,0],["فجزاك اللهُ صالحةً","من مُحِبٍّ مُخْلِصٍ وَولِي",32,"ل",2,0],["فجزيت أفضل ما يُجازى مرسل","عن أمة رشدت به وتبررت",33,"ت",1,0],["فَجَزاكَ الإِلَهُ أَفضَلَ ما جا","زى إِماماً عَن سَعيِهِ المَشكورِ",34,"ر",1,0],["فجزاه رب العرش خيرَ جزائه","بسلامه الزاكي لناريّاه",35,"ا",2,0],["فَجَزا كُلُّ مُؤمِنٍ","لِلهَوى كانَ يَقمَعُ",36,"ع",1,0],["فجزيتهم كل صالحة","وبلغتهم منتهى الهمم",37,"م",1,0],["فجزاء الظالم الخطل","الغوي الغرور بالمهل",38,"ل",1,0],["فَجَزَى الإِلَهُ مُعِزَّ دِينِ نَبِيِّه","جَنّاتِ رضوانٍ وَدَارَ مُقَامِ",39,"م",1,0],["فجزاكَ رَبُكَ يا خليفةَ أحمدٍ","عَمَّا نظَمْتَ به خِلافةَ أحمَدِ",40,"د",1,0],["فجزاكَ عني محبَّةٌ ما بعتُها","برخيص ذمِّك والجزاءُ محقَّق",41,"ق",1,0],["فَجَزاهُ اللَهُ مِن ذي نِعمَةٍ","وَجَزاهُ اللَهُ إِن عَبدٌ كَفَر",42,"ر",1,0],["فجزاك الإِله عني خيراً","يا عماداً وزاد في أيامك",43,"ك",1,0],["فجزاهَا الإلهُ عَنِّيَ خَيْراً","صَيَّرَتْني شَيئاً ولم أكُ شَيَّا",44,"ي",2,0],["فجزاهُما رَبُّ الورى","في الخُلدِ بالدَّرَجِ المُنِيفَه",45,"ف",2,0],["فَجُزِيتُم سيِّدي عن شاعرٍ","ناثرٍ فيكم مدى الدَّهر وناظم",46,"م",1,0],["فجزاه الله عنَّا خير ما","جوزيَ المنعمُ فيما نوّلا",47,"ل",2,0],["فجزاك الله عنّا خيره","وجزَيْناك الدعاءَ المستجابا",48,"ب",2,0],["فجزاه الله عنها خير ما","جُوزي المنعم عمَّا أنعما",49,"م",2,0],["فجزيتم عن أجركم بنعيم","تتوالى الأرواح والأجسادا",50,"د",2,0],["فجزيرةِ النَّعْتِ التي هيَ ملجأٌ","أَوصَيِّلِ الناموسِ فوقَ الشَّوْرَت",51,"ت",1,0],["فَجَزَاكَ من كَرَمِ القُدومِ وفاءَ ما","أبليتَهُ من صادِقِ الإقدامِ",52,"م",1,0],["فَجَزَرْتَ حَتَّى باتَ من عادَيْتَهُ","حَذِراً يراقِبُ أن يكونَ جَزُورا",53,"ر",2,0],["فجزاه الإِله خيرَ جزاءٍ","معْ ذوي القُرْب في جِنان الخلودِ",54,"د",1,0],["فجزاها اللهُ مِن فتكتها","في حريم الله سوءاً ما جزاها",55,"ا",3,0],["فجزت مرارا وقت سوق مغلق","وصحت هناك للظباء المنعما",56,"م",2,0],["فَجَزاهُ رَبُّنا عَنّا وَعَنْ","كُلِّ هَذَا الْخَلْقِ أَعْلَى مَنْزِلِ",57,"ل",1,0],["فجزئ قبل الوقت بالنص يا فتى","وفي الوقت حظر النفل للمتعبد",58,"د",1,0],["فجزاه رب العرش خير جزا على","حسناته فهو المكافئ محسنا",59,"ن",2,0],["فجزتها في جواز المستحيل به","والناس في طرق الأوهام كالعدد",60,"د",1,0],["فَجَزاهُ في هَذِهِ الخزي وَالذُل","لَ وَنار الجَحيم يَوم المعاد",61,"د",1,0],["فَجَزاهُما اللَهُ الكَريمُ بِفَضلِهِ","أَجراً بناءُ عَلاهُ لا يَتَهَدَّمُ",62,"م",1,0],["فَجَزاهُ عَنّا اللَهُ أَفضَلَ ما جَزى","مَن في الديانَةِ أَبطلَ التَرديدا",63,"د",2,0],["فجزاه رب العرش أوفر نعمةٍ","محروسةٍ من حادث الأزمانِ",64,"ن",1,0],["فجزاه رب العرش عنَّا عيشةً","مَكلوءةً تذر الخطوب نياما",65,"م",2,0],["فجزاه الإله خيراً ولا زا","ل حفيفاً بالحسن والإحسانِ",66,"ن",1,0],["فجزاك من سوَّاك فينا حجة","أعلى المقام بجنّة الأبرارِ",67,"ر",1,0],["فَجَزاه اللّه عنّي ال","خيرَ إذ صدّق ظنّي",68,"ي",1,0],["فجزاهم بصبرهم جنة الخلد","بها من كواعب خيرات",69,"ت",1,0],["فجزاه في هذا الصنيع إلهه","ما قد أحب من الحبا واختارا",70,"ر",2,0],["فجزاءُ الحب عندي اليوم ان","كان للمفضال ان لم يحسِ",71,"س",1,0],["فجزاه عند الله مولاه الذي","أنشدت فيه مؤرخاً أجرٌ عظيمْ",72,"م",1,0],["فَجَزِعْتُ مِنْ أَلمِ الهَوَى وجَزِعْتُ مِنْ","وَشْكِ النَّوى وجَزِعتُ إِنْ لم أَجْزَعِ",73,"ع",1,0],["فجزاك الاله خير جزاء","عن فواد الفتى المعنى العميد",74,"د",1,0],["فجزاك الله من ذي نعمة","وجزاه الله من عبد كفر",75,"ر",1,0],["فَجزّوا خُصاكم وَاِبتَغوا من تحالفوا","مِنَ النَّاسِ حَيّاً غَيرَ أزدِ عُمانِ",76,"ن",1,0],["فجزى الله خاتم الرسل عنا","وشفيع الأنام خير جزاء",77,"ا",2,0],["فجزاكَ سلطانُ الأَنامِ بنعمةٍ","كجزاءِ حَنظَلةٍ من النُعمان",78,"ن",1,0],["فجز واسع إِلى المسعى","فمن باب الصفا تدعى",79,"ع",2,0],["فجَزاءُ قَوْمٍ حارَبوا مِنْ دونِهِ","واسْتُشْهِدُوا غُرَفُ الجِنانِ العالِيَهْ",80,"ي",2,0],["فجزك تيمٌ بالضلالة بعده","للحشد لا يأتي عليه سكون",81,"ن",1,0],["فجزاك الاله من ملك حر","ر بقاء التمكين والتمهيد",82,"د",1,0],["فجزاهم لي الفضل خير جزائه","عنا وعن إطراء أفضل مرسلي",83,"ل",2,0],["فجزاكم الهنا جل عنا","وعن المسلمين خير جزاء",84,"ا",2,0],["فَجَزَاكَ اللهُ خَيرَ جَزَا","يا مُنِيرَ الكَونِ بالبَلَجِ",85,"ج",1,0],["فجزاها خيراً فليت لنفسي","بعض حظ مما به قد جزاها",86,"ا",3,0],["فجزيت عن رعي الرعية خير ما","يرجى بسيرته إمام مفضل",87,"ل",1,0],["فجزتُ بحرَ الدنوِّ حتى","أبصرت جهراً من لا اسمي",88,"م",2,0],["فجزمتم لي فؤاداً تَعِباً","عَجَباً كيف يُرَى الجزْم بكَيْ",89,"ي",1,0],["فَجُزنَا بَطنِ مَكَّةَ وامتنعنَا","بِتَقوى اللَهِ في البيض الخِفافِ",90,"ف",1,0],["فجزَاكَ رَبِّي خَيرَ ما يُجزَى به","أهلُ الوفاءِ الواضحِ الأشهادِ",91,"د",1,0],["فجزَّارُكم في جبةٍ وعمامة","وجزاركم في مثل ذلك أفضل",92,"ل",1,0],["فَجز للجنتين بِهِ وَأرخ","وَقُل نعم الصِراط المُستَقيم",93,"م",1,0],["فَجَزى الإِلَهُ سُراةَ قَومي نُصرَةً","وَسَقاهُمُ بِمَشارِبِ الأَبرارِ",94,"ر",1,0],["فجزاه مولاه خير جزاء","يتحلى به حلى الجنه",95,"ن",2,0],["فَجَزاك لِلإله خَير جَزاء","وَحَباك الإِله عزاً وَنَصرا",96,"ر",2,0],["فجزيت الثواب والحب من ك","كل فؤاد ومدح كل لسان",97,"ن",1,0],["فجزيت الشرق بما صنعا","يا غرب فهج