"","https://poetry.dctabudhabi.ae/diwan/poem/124304","الطويل"],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96062","الطويل"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99101","الوافر"],[4783,"أ أسْلو؟","https://www.poetsgate.com/ViewPoem.aspx?id=185446",""],[5127,"أﻻ عللاني بطيفِ الحبيبْ","https://www.poetsgate.com/ViewPoem.aspx?id=177330",""],[5191,"طفلٌ في ثيابِ شيخ","https://www.poetsgate.com/ViewPoem.aspx?id=212281",""],[5213,"سل السرب يوم الظعن ما فعل السرب","https://www.poetsgate.com/ViewPoem.aspx?id=170411",""],[5219,"شدوا الرحال","https://www.poetsgate.com/ViewPoem.aspx?id=195038",""],[5376,"اذا غاب عني راح عن أنسنا ينحو","https://www.poetsgate.com/ViewPoem.aspx?id=200211",""],[5431,"رِعشة الأفيون...","https://www.poetsgate.com/ViewPoem.aspx?id=211447",""],[5492,"بوجد فقد أضحى فؤادي مضرما","https://www.poetsgate.com/ViewPoem.aspx?id=169346",""],[5582,"أَأَسْطُرُ إِعْجامٍ تَراءَتْ وَأَحْرُفُ","https://www.poetsgate.com/ViewPoem.aspx?id=63536",""],[5582,"أَلا هَلْ فَتَحْتَ مِنَ الشَّوْقِ بَابَا","https://www.poetsgate.com/ViewPoem.aspx?id=63469",""],[5616,"أغرِّد بالقصيدة كلَّ يومٍ","https://www.poetsgate.com/ViewPoem.aspx?id=205220",""],[5784,"ارتجال سريع","https://www.poetsgate.com/ViewPoem.aspx?id=190800",""],[5914,"أَلا هَل لهجر العامرية أقصار","https://www.poetsgate.com/ViewPoem.aspx?id=190300",""],[5956,"نزهات في سيارة خالية","https://www.poetsgate.com/ViewPoem.aspx?id=182419",""],[5956,"الجنة العظمَى","https://www.poetsgate.com/ViewPoem.aspx?id=194703",""],[6031,"وراءَ كُما إنَّ المُصَابَ جَليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=46289",""],[6068,"إذا ذكر الأحباب آضت تهزّني -24-","https://www.poetsgate.com/ViewPoem.aspx?id=175862",""],[6102,"جيهان ..","https://www.poetsgate.com/ViewPoem.aspx?id=183612",""],[6164,"فتاتان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66064&r=&rc=73",""]],"verses":[["أَأَسَأتَ بِالمُشتاقِ حينَ مَلَكتَهُ","وَجَزَيتَ فَرطَ نِزاعِهِ بِنُزوعِ",0,"ع",1,0],["أَأَستَنشِقُ الرِّيحَ عُلويَّةً","أَجَلْ وَبِكوفَنَ أَهلي وَما لي",1,"ل",2,0],["أأسْحَبُ ذَيلي في الهَوانِ وأُسْرَتي","تَجُرُّ إِلى العِزِّ الدِّلاصَ المُسَرّدا",2,"د",2,0],["أَأُسلَبُ مِن وِصالِكِ ما كُسيتُ","وَأُعزَلُ عَن رِضاكِ وَقَد وَليتُ",3,"ت",1,1],["أَأَسماءُ أَمسى وُدُّها قَد تَغَيَّر","سَنُبدِلُ إِن أَبدَلتِ بِالوُدِّ آخَرا",4,"ر",2,0],["أَأَسبَلتَ دَمعَ العَينِ بِالعَبَراتِ","وَبِتَّ تُقاسي شِدَّةَ الزَفَراتِ",5,"ت",1,1],["أَأَسلَمُ ما تَأتِي بِهِ من عَدَاوَةٍ","وَبُغضٍ لَهُم لاَجَيرِ بَل هو أشجَبُ",6,"ب",1,0],["أإسماعيلُ من رَجلٍ","تَعرَّب بعد ما شاخا",7,"خ",2,1],["أأسماءُ أيُّ الواعدين تَرَيْنَهُ","أشدَّكُما مطلاً فإنيَ لا أدري",8,"ي",1,1],["أأستنْشِقُ الأرواحَ بعدك طائعاً","وأشربُ عذْبَ الماء إني لذو نَهمْ",9,"م",1,0],["أَأَسْمَعَكِ اللَّيلُ نَدْبَ القُلُوبِ","أَأَرْشَفَكِ الفَجْرُ كأسَ الأَسى",10,"س",2,0],["أَأَسأمُ ظَبيا في ضُلوعي كِناسهُ","وَبَدرَ تَمامٍ في فُرادي مَطالِعُهْ",11,"ع",2,0],["أَأَسعى لأَحْظَى فيكَ بالأَجْرِ إنّهُ","لَسَعْيٌ إِذَنْ مِنِّيْ لَدَى اللّهِ خَائِبُ",12,"ب",1,0],["أَإِسحاقُ تَفديكَ مِن ماجِدٍ","مُناسِبُ طَيٍّ وَأَعراضُها",13,"ض",3,0],["أَأَسطيعُ العَزاءَ وَقَد تَراءَت","عُيونُ العَينِ تُؤذِنُ بِالفِراقِ",14,"ق",1,0],["أَأَسقَيتَها وَالعودُ يَهتَزُّ في النَدى","كَأَنَّ بِجَنبَيهِ زَرابِيَّ عَبقَرا",15,"ر",2,0],["أَأَسلَمتَني لِلمَوتِ أُمُّكَ هابِلٌ","وَأَنتَ دَلَنظى المَنكِبَينِ سَمينُ",16,"ن",1,1],["أَأُسَرُّ في الدُنيا بِكُلِّ زِيادَةٍ","وَزِيادَتي فيها هِيَ النُقصانُ",17,"ن",1,0],["أَأَسمَعُ ما قالَ الحَمامُ السَواجِعُ","وَصايَحَ بَينٌ في ذُرى الأَيكِ واقِعُ",18,"ع",1,1],["أأسْماءُ ما عهْدي ولا عهدُ عاهِدٍ","بخِدرِكِ يسري في الفيافي المَجاهل",19,"ل",1,0],["أَأَسلَمتَني يا جَعفَرُ بنَ أَبي الفَضلِ","فَمَن لي إِذا أَسلَمتَني يا أَبا الفَضلِ",20,"ل",1,1],["أَأُسْوَةَ بَاكٍ حَاوَلتْ أُمُّ عَاصِمٍ","بِمَا حَدَّثتْنِي أَمْ أَرَادَتْ لأَكْمَدَا",21,"د",2,0],["أَأَسماءُ أَمسى وُدُّها قَد تَغَيَّرا","سَنُبدِلُ إِن أَبدَلتِ بِالوُدِّ آخَرا",22,"ر",2,0],["أإسارُ الحرِّ حقٌّ سائغٌ","وإباءُ الحرِّ شيءٌ لا يُبَاح",23,"ح",1,0],["أأسعى لأحظى فيكَ بالأجرِ إنَّهُ","لسعيٌ إذنْ مني إلى الله خائبُ",24,"ب",1,0],["أأسعدُ إنَّ حديثي إليكَ","حديثُ مقيمٍ إلى ظاعِن",25,"ن",1,0],["أأسلمتوه وهو عقد مضنة","يناضل عن أمثاله ويدافع",26,"ع",1,0],["أَإِسحَاق تَفديِيكَ مِن ماجِد","مُنَاسِبُ طَيٍّ وأَعْراضُها",27,"ض",3,0],["أأستنطقُ الصخرَ عن ناحِتيه","وأستنهضُ الميتَ من رمسه ؟",28,"س",2,0],["أأسجن الناس ارضاء لخاطركم","وخشية العزل من ذا المنصب الدون",29,"ن",1,0],["أأسرفتَ في الجودِ حتى استما","حَ أحبابَك الزمنُ الخادعُ",30,"ع",1,0],["أأسومهم وهم الأجانب طاعةً","وهواى بين جوانحى يُصبينى",31,"ن",2,0],["أأسير في الليل البهيم فأهتدى","وأَضِلُّ في إدلاجِ ليلٍ مقمرِ",32,"ر",1,0],["أَأَسماءُ لَم تسئَلي عَن أَبي","كِ وَالقَومُ قَد كانَ فيهِم خُطوب",33,"ب",1,1],["أأسلوا وقد غِبتَ عن ناظري","وَمثَّلَكَ الشوقُ في خاطري",34,"ر",2,1],["أاسلو حبيبا نصب عيني خياله","ومن أين لي من بعده كبد تسلو",35,"ل",2,0],["أَأَسكُت عَن مَولى الوَرى أَم أُعاتِبُه","وَأُهمِلُ وَعدِي عِندَهُ أَم أُطالِبُهْ",36,"ب",2,1],["أاسمع قول شيطان رجيم","يلوم اعوذ بالله السميع",37,"ع",1,0],["أأسأل عنهم قد سألت فما الذي","أجابوا به إني عليهم لمشفق",38,"ق",1,0],["أأسهر وحدي دامي القلب ثائراً","وأنت من الإدلال بالحسن في سكر",39,"ر",1,0],["أَأُستاذَ المؤَيَّدِ هل أُعَزّى","فَجُهدي اليَوم تَعزِيَةٌ جَميلَه",40,"ل",2,0],["أَأَسأل حظًا من لئيم ومُقْرِفٍ","وأخْضَعُ للنِّكْسِ البخيل وأطلبُ",41,"ب",1,0],["أَأَسيحُ في هَذي البسيطةِ آملاً","وسُهولُها لي رحبَةٌ وبِحارها",42,"ر",3,0],["أَأَستَسقي لِدارِهِمُ وَدَمعي","لَها مِن سَيلِهِ نَهلٌ وَعلُّ",43,"ل",1,0],["أأَسلو أَمْ أُصَبِّرُ عنه نفسي","وَعودُ صبابتي غضٌ وَريق",44,"ق",1,0],["أَأَسماءُ إِنّي قَد أَتاني مُخَبِّرٌ","بِضَيقَةَ يَنشو مَنطِقاً غَيرَ صالِحِ",45,"ح",1,0],["أإسماعيلُ لو أصبحْتَ يوماً","وأنت مُعاصِرٌ أبناءَ مُقْلَهْ",46,"ه",1,1],["أأسماءُ قد حالَ النّوى دونَ وَصلِكُمْ","وما القلبُ عمّا قد عَهدْتُمْ بحائل",47,"ل",1,0],["أأسماءُ ما بي من غَيورٍ مُحاربٍ","كما بِيَ من خوفي لواشٍ مُخافت",48,"ت",1,0],["أأَسمَعُ فيكَ العَذلَ ممَّن يَلومُني","فَلا سَمِعَت أُذني إذاً بَعدهُم شَيَّا",49,"ي",2,0],["أأسْلو ولا صبغ المشيبِ بعارِضي","يلوحُ ولا صبغُ الشبيبة مُنحَلَ",50,"ل",1,0],["أأسلُو هوى قومٍ قَضَى باجْتبائِهمْ","وتَفْضيلهمْ بينَ الورى العقلُ والنّقلْ",50,"ل",1,0],["أأسلو حبيباً طالما قد مدحته","ووصفيَ في علياه باق مخلّدُ",51,"د",1,0],["أأُسأمُ خَسفاً ثمّ لا","آبَى فلستُ إذاً أُسَامَهْ",52,"م",2,0],["أأستجبر عليهم دمعي الجاري","والدمع يظهر إعلاني وأسراري",53,"ر",2,1],["أأسي بموسى مستهاما معذّباً","أرى مرما ألقاه في حبّه عذبا",54,"ب",2,0],["أَأُسَرُّ دونَكَ بالحياةِ وَكَمْ يَدٍ","لَكَ بَشَّرَتْنِي بالحياةِ وكمْ وكمْ",55,"م",1,0],["أأستاق بالبيداء جسما أُرِثُّه","وأُبلي وقلبي مستعار بلا شغلِ",56,"ل",1,0],["أأسمعُ فيه العذلَ منه ولو غدا","عليَّ وقد عاصيتُه القولَ يَنْقُمُ",57,"م",1,0],["أأسلو وقد جادَتْ بطيبِ وصالِها","لقد شابَ مِن امر ترومانِه الطَّفْلُ",58,"ل",1,0],["أإسماعيل من راع زعيم","إذا ما نام لم تنم الرعايا",59,"ا",3,0],["أأسْتَسقي السّحائِبَ نازِحاتٍ","وهذا البحرُ معترِضاً حِيالي",60,"ل",2,0],["أأسلو عن ابن عزتي بتغربي","سأبكي عليه مدتي وحياتي",61,"ت",2,0],["أأُسقى نميرَ الماءِ ثمَّ يَلذُّ لي","ودورُكُمُ آلَ الرّسولِ خَلاءُ",62,"ا",2,1],["أأسمَعُ فيكِ الكاشِحينَ مَلالَةً","جُعِلتُ أنا والكاشِحُونَ فِداكِ",63,"ك",1,0],["أَأَسلُو حَبيباً أَرى سُخطَهُ","رِضىً وَفَنائِي عَلَيهِ وَجُودا",64,"د",2,0],["أَأَسلو هَواه وَهوَ في الحسن مُفردٌ","كَما الداوري في عَدله وَاعتِداله",65,"ل",2,0],["أَأَسلو هَواهُ وَالغَرامُ يثيرُهُ","وَوَجدي بِهِ ما زالَ فيهِ يضعِّفُ",66,"ف",1,0],["أأسألهم ما ذا تطيق قلوبهم","صدعت إذن بالظلم قلب المراحم",67,"م",1,0],["أَأَسطرُ إِعجامٍ تَراءَت وأحرف","لَنا أَم دِيارٌ بالأماراتِ تعرفُ",68,"ف",1,1],["أَأَسلو وَبَينَ المُنحَنى مِن جَوانِحي","حَشاً بِلَهيبِ الشَوقِ فيكَ نَضيجُ",69,"ج",1,0],["أَأُسْرَتُهُ الكرام الصبرُ أَولى","على ما أحدثَ الزمنُ اللئيم",70,"م",1,0],["أَأَسماءُ هل عَيْشي بذي الأَثْلِ عائدٌ","يُبَدَّلُ مَغْناهُ مِنَ الوَحْشَةِ الأُنْسَا",71,"س",2,0],["أَأُسودُ غيلٍ أَمْ ظِباءُ كِناسِ","هَدَمَتْ رَجايَ وأَسَّسَتْ وَسْواسي",72,"س",2,1],["أَأَسلو التى لو لاحَ للبدر وجهُهَا","لَعاودَهُ نُقصانُه وَهوَ كامِلُ",73,"ل",1,0],["أإسحاق لا تبعد وإن كان قد رمى","بك الموت ورداً ليس يصدر وارده",74,"د",2,0],["أأسلو بعد ماقد عيل صبرى","وقد ملى الحشا منهم كلاما",75,"م",2,0],["أأسلمُ القلبَ خوَّاناً فوا أسفاً","إني كأني لهذا القلبُ خوّانُ",76,"ن",1,0],["أأسود حوله رابضة","أم قرود أم يهود يلعبون",77,"ن",1,0],["أأسْلُو ونارُ الشوق تصْلَى حَشَاشتي","وأهجرُ مَنْ إِيَّاهُ ما عشتُ هجرانا",78,"ن",2,0],["أأسكت والجمادُ يئز حولي","ويهدر طالباً للنطق مجرى",79,"ر",2,0],["أأستسقي الغمام له وكانت","بغرة جده سقيا الغمام",80,"م",1,0],["أَأَسماءُ ما أَسماءُ لَيلَةَ أَدلَجَت","إِليَّ وأَصحابي بأَيٍّ وأيَّما",81,"م",2,0],["أأسلوك يا إلف الشبيبة والصبا","وهل يتسلى عن هوى إلف الإلف",82,"ف",1,0],["أأسلو وهل اسلو نجيب ابن مشرق","وقد كان عوناً لي على نوب الدهر",83,"ر",1,0],["أأسعد قر عيناً ان ماري","اليها كل مكرمة تؤول",84,"ل",1,0],["أأسر في خطب أصابك اذبه","حزت الشهادة أم لفقدك أجزع",85,"ع",1,0],["أأسيدُ إن مالٌ ملك","تَ فَسِر بهِ سَيراً جميلا",86,"ل",2,0],["أأسيدُ إن المالَ لا","يُبكي إذا فقَدَ الخليلا",86,"ل",2,0],["أآس عذار فوق خديه منثور","ألم الورد في روض به حف منثور",87,"ر",1,1],["أأسلو رقيقَ القِوامِ","مَلالاً وَقَد رقَّ لي",88,"ي",1,0],["أآسى على خاتمي ضائعاً","أم أسى على صحتي الضائعه",89,"ع",2,0],["أإسلامٌ وتغلبهم يهودٌ","وآسادٌ وتقهرهم ضباع",90,"ع",1,0],["أأسلب منهم غرور النفوس","ولا يرسلون علي الحمم",91,"م",1,0],["أأسجنُ من عون اللهيف وغوثه","ونصرتي المظلوم سجنا مؤبدا",92,"د",2,0],["أأستسقي الغوادي كي تروي","قبوركم وأجفان الغوادي",93,"د",2,0],["أأسأل صاغراً مثلي","بشيءٍ جلَّ أودقا",94,"ق",2,0],["أأسكن الشام ومن واليتهم","في النجف الأعلى وطف كربلا",95,"ل",2,0],["أَأَسْلُو حادِي البين جَدَّتْ رَكائِبُهْ","وناحتْ عَلَى دَوْحِ المنايا نَوادِبُهْ",96,"ب",2,1],["أآسى على الفاني ولو كنت باقياً","لطال بكائي منه لكنني فاني",97,"ن",2,0],["أأسلوا وتلك الدار يوحش ربعها","أليست بدار كان يعطو بها السرب",98,"ب",1,0],["أأسْتَطيعُ الآن كتْمَ الهَوى","وقدْ غَدا سِرُّ غَرامي مُباحْ",99,"ح",1,0],["أَاسلو الهَوى وَالصَبُّ لِلعِشقِ مُذعِنٌ","وَمني لِذِكراها الجَوارِح السنٌ",100,"ن",1,0],["أأسي ولي منكم حماة وللورى","عيون إلى ابناء عثمان تنظر",101,"ر",1,0],["أأسيد إن مالا ملك","ت فسر به سيرا جميلا",102,"