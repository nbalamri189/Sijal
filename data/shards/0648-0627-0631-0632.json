{"poems":[[46,"قرنت جيشين فكم من دم","https://www.aldiwan.net/poem23535.html","السريع"],[46,"تنازع في الدنيا سواك وما له","https://www.aldiwan.net/poem23569.html","الطويل"],[165,"أماطت لثاما عن أقاح الدمائث","https://www.aldiwan.net/poem67812.html","الطويل"],[187,"شربت بالمكاره في نهاري","https://www.aldiwan.net/poem43265.html","الوافر"],[232,"قم فبادر قبيل رفع النعوش","https://www.aldiwan.net/poem44587.html","الخفيف"],[321,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[442,"عجبا لراج فوز ناج سابق","https://www.aldiwan.net/poem14317.html","الكامل"],[483,"أما لغراب البين ينحل مقتضى","https://www.aldiwan.net/poem24337.html","عموديه"],[483,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"]],"verses":[["وارٍ زِنادُ الشَرِّ في هَذِهِ الدُن","يا فَقُل يا جَدَثي وارِني",0,"ن",2,0],["وَأَرزاقُها تَغشى أَناساً بِفَترَةٍ","وَتَقصُرُ حيناً دونَ مُكتَرِفيها",1,"ي",3,0],["وَأَرزَمَتِ الدُهمُ الرِغابُ كَأَنَّها","تُرَدِّدُ إِرزامَ المَتالي الرَواغِثِ",2,"ث",1,0],["وأرزاق البريّة بين حلّ","ومشتبه ومحظور المرام",3,"م",1,0],["وارزقني الإخلاص في ساعة المو","ت وأنساً في لحد قبر نبيش",4,"ش",1,0],["وَارزُقهُ قَبلَ التَناهي حُسنَ خاتِمَةٍ","وَاِذَن لِسَحبِ صَلاةٍ مِنكَ دائِمَةِ",5,"ه",1,0],["وأرزقني اللهم حج البيت ثم","م زيارة الهادي النبي الصادق",6,"ق",1,0],["وارزق أصيحابي الذي أرزقتني","واقبل دعاي على الولا يا رازقي",6,"ق",2,0],["وأرزا للأحرار نأي أحبّة","خصوصا إذا ملوا زيارة نازح",7,"ح",1,0],["وأرزق سر الفتح من كل حضرة","وأكسى جلابيب العلوم الإدريسيه",8,"ي",2,0]]}