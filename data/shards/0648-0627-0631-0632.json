{"poems":[[48,"قرنت جيشين فكم من دم","https://www.aldiwan.net/poem23535.html","السريع"],[48,"تنازع في الدنيا سواك وما له","https://www.aldiwan.net/poem23569.html","الطويل"],[168,"أماطت لثاما عن أقاح الدمائث","https://www.aldiwan.net/poem67812.html","الطويل"],[190,"شربت بالمكاره في نهاري","https://www.aldiwan.net/poem43265.html","الوافر"],[236,"قم فبادر قبيل رفع النعوش","https://www.aldiwan.net/poem44587.html","الخفيف"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[447,"عجبا لراج فوز ناج سابق","https://www.aldiwan.net/poem14317.html","الكامل"],[487,"أما لغراب البين ينحل مقتضى","https://www.aldiwan.net/poem24337.html","عموديه"],[487,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53749","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87092","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70666","السريع"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35355","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112839","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112763","الخفيف"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112752","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112740","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112833","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112846","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64576","الرجز"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102722","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82807","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117889","السريع"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133215","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133240","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135761","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135753","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135741","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135733","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135729","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135742","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135738","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135775","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135751","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135743","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135744","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135740","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135728","الرجز"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107297","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94553","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94581","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94385","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94550","البسيط"],[4330,"","https://poetry.dctabudhabi.ae/diwan/poem/122967","البسيط"],[4532,"","https://poetry.dctabudhabi.ae/diwan/poem/45305","الرجز"],[4658,"","https://poetry.dctabudhabi.ae/diwan/poem/111555","المتقارب"],[4679,"بذكراك لا ذكرى حبيبٍ ومنزلِ","https://www.poetsgate.com/ViewPoem.aspx?id=142719",""],[4778,"أُسعدتِ صبحاً والمساء","https://www.poetsgate.com/ViewPoem.aspx?id=188160",""],[4830,"بين جدران الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=195193",""],[4858,"دعاء بلسان ولدي ( إسلام ) وهو في السحن","https://www.poetsgate.com/ViewPoem.aspx?id=137669",""],[5183,"بين الهيمنة والهينمة","https://www.poetsgate.com/ViewPoem.aspx?id=180155",""],[5198,"نود الاشعار","https://www.poetsgate.com/ViewPoem.aspx?id=136094",""],[5755,"حظ الحفاة العراه","https://www.poetsgate.com/ViewPoem.aspx?id=133252",""],[5956,"مهما اجتمعنا لا نطيق تباعداً","https://www.poetsgate.com/ViewPoem.aspx?id=193941",""],[6202,"استبد الهوى عشقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86702&r=&rc=3",""],[6202,"طول مسيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86734&r=&rc=35",""],[6290,"الْعَدْلُ مَفْقُودٌ فَكَيْفَ رُقِيُّنَا؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85160&r=&rc=11",""]],"verses":[["وارٍ زِنادُ الشَرِّ في هَذِهِ الدُن","يا فَقُل يا جَدَثي وارِني",0,"ن",2,0],["وَأَرزاقُها تَغشى أَناساً بِفَترَةٍ","وَتَقصُرُ حيناً دونَ مُكتَرِفيها",1,"ي",3,0],["وَأَرزَمَتِ الدُهمُ الرِغابُ كَأَنَّها","تُرَدِّدُ إِرزامَ المَتالي الرَواغِثِ",2,"ث",1,0],["وأرزاق البريّة بين حلّ","ومشتبه ومحظور المرام",3,"م",1,0],["وارزقني الإخلاص في ساعة المو","ت وأنساً في لحد قبر نبيش",4,"ش",1,0],["وَارزُقهُ قَبلَ التَناهي حُسنَ خاتِمَةٍ","وَاِذَن لِسَحبِ صَلاةٍ مِنكَ دائِمَةِ",5,"ه",1,0],["وأرزقني اللهم حج البيت ثم","م زيارة الهادي النبي الصادق",6,"ق",1,0],["وارزق أصيحابي الذي أرزقتني","واقبل دعاي على الولا يا رازقي",6,"ق",2,0],["وأرزا للأحرار نأي أحبّة","خصوصا إذا ملوا زيارة نازح",7,"ح",1,0],["وأرزق سر الفتح من كل حضرة","وأكسى جلابيب العلوم الإدريسيه",8,"ي",2,0],["وأرزاق العباد مُقَدَّرات","لهم وعليك أرزاق الأيورِ",9,"ر",1,0],["وَأَرزاق بَيت المال مدّت لقبضها","عَلى موجب الشَرع الشَريف مَعاصم",10,"م",1,0],["وارْزُقنِّي خير دين","ونشاطاً في نشاط",11,"ط",1,0],["وَأَرزَمَ إِرزامَ الرُعودِ هَديرها","فَسَدَّ الفِجاجَ الفيحَ مِنهُ ضَجيجُ",12,"ج",1,0],["وارزق حلاوة قربكم وسروره","وامنن به للمسرف الظمآن",13,"ن",1,0],["وارزقن يا كريم منك كمالا","دائماً مع رضاً وحسن مآب",14,"ب",1,0],["وارزق انابة صادق","يا رب قبل حمامه",15,"م",2,0],["وارزقه شكرا مثل من عبروا من","الأحباب واكرم بخير وفاة",16,"ه",1,0],["وارزق عبيدك حجا فيه قربته","واقبل وظفر وبشرنا بكل منا",17,"ن",2,0],["وارزق محبته على قدم رفيع القدر","واملا القلب من بركاته",18,"ت",2,0],["وارزقه في أمته مناه","بحق لا إله إلا اللّه",19,"ه",1,0],["وارزُقنا برداً لعفو والرضا أبدا","وكن لطيفاً بنا بأفضَلِ الرسُل",20,"ل",1,0],["وارزقني صحة فقر منك يا سندي","اليك دأباً بها اغسنى عن الامم",21,"م",1,0],["وَارزِقنّي بِالحَجِّ قبل مَماتي","فَاُهَنّا بزمزَمٍ وَالمقامِ",22,"م",1,0],["وارزقهم رزقاً حلالاً وضا","عف للمقيمين الصلاة الصلات",23,"ت",1,0],["وارزقهم العز وامنحهم إجازتهم","عما قريب ولا تحكم بإبعاد",24,"د",1,0],["وارزقهم العز وامنحهم شهادتهم","عما قريب ولا تحكم بإبعاد",25,"د",1,0],["وارزق لنا مكرُمةً بالميمِ","والنورَ بالنونِ مع النسيمِ",26,"م",1,0],["وارزق لنا شهودَ ذات الذاتِ","وصفة الصفاتِ في الذواتِ",27,"ت",1,0],["وارزق لنا رؤيةَ وجه المصطفى","ورؤيةَ الباري الجميل وكفى",28,"ف",2,0],["وارزق لنا الغيث بفضلك الشهيرْ","بإسمك المقتدر العليّ الكبيرْ",29,"ر",1,0],["وارزق لي ما أريد من كل الأمورْ","وصدري اشرحه واشرح لي الصدورْ",30,"ر",1,0],["وارزقهم جميع ما أردتُ","وزدهمُ على الذي قد قلتُ",31,"ت",1,0],["وارزق لنا فهماً به يحفظُ ما","سمعَه السامعُ صحِّحْ جِسْما",32,"م",2,0],["وارزق لنا العلمَ من المغيّبِ","مع المشاهدِ وكل مطلبِ",33,"ب",1,0],["وارزق لنا منك بلوغَ الأمنيهْ","وعظِّمن بك لنا العطيّهْ",34,"ه",1,0],["وارزق لنا أرغد عيش في الحياةْ","ووالِنا حسن الختام في المماتْ",35,"ت",1,0],["وارزق له الذي العقولُ تنحصرْ","عنه من الفضل العظيمِ المشتهِرْ",36,"ر",1,0],["وارزق له جميع ما أرادا","به وواله به الزيادا",37,"د",2,0],["وارزق لنا من كل ما من ثمراتْ","لعلنا نشكر منك العطياتْ",38,"ت",1,0],["وارزُقنِيَ العِلمَ الشَريفَ فإِنَّهُ","لِصُعُودِ أُفقِ المَجدِ نِعمَ السُلَّمُ",39,"م",1,0],["وأرزهُ قد سما حتى السماك علاً","وفاق في فخرهم عن كل مفتخرِ",40,"ر",1,0],["وأرزه قد دعى الجرباءَ موطئهُ","فوق المجرَّة قد جُرَّت مآزرهُ",41,"ر",2,0],["وأَرزهُ قد سما سَمكَ السحاب عُلاً","في ظل مَلكٍ رقى أسمى السما دارا",42,"ر",2,0],["وأرزهُ فوق شمِّ الشامخات سما","علوّا وفخراً وإيناعاً بواليهِ",43,"ي",2,0],["وارزق قبائلهم إقبال أنفسهم","واجعل عصائبهم من خيرة العصب",44,"ب",1,0],["وَاِرزُق عِيالَ المُسلِمينَ رِزقَهُ","وَاِقصِد إِلى الجودِ وَلا تَوَقَّهُ",45,"ق",2,0],["وارزن حلماً في الراسيات","إذا ماز ذا الحلم حلو الحيا",46,"ا",1,0],["وارزاك تمثال العصور التي مضت","أراه سيبقى للعصور التي تلي",47,"ل",2,0],["وارزقنا ربي أنعُما","عُقبى السنين الخاليه",48,"ي",2,0],["وارزقني خيرَ الدين والدنيا معاً","واذقني منكَ حلاوةَ الأيمانِ",49,"ن",1,0],["وارزقْني عِلْماً ينفعُني","في يوم الدّينِ إذا قاما",50,"م",2,0],["وارزقه إيماناً لوجهك خالصا","يا مؤمن المنبت يوم بلائه",51,"ا",3,0],["وارزقه يا صمدُ الصمودَ إلى العلى","واكفله شان غذائه وروائه",51,"ا",3,0],["وارزقه صبراً يا صبور بيوم لا","يجديه غير الصبر عند بلائه",51,"ا",3,0],["وارزقه يا رزاق رزقاً طيبا","حسنا حلالا واسعا لكفائه",51,"ا",3,0],["وارزقه يا محيي حياة موله","بك والجلالة منك في حوبائه",51,"ا",3,0],["وارزقني بحبّك مع الناس الابرار","ووفقني لخير العمل والعبادة",52,"د",2,0],["وارزقني اللي عطيته من رظاك الدعاه","والهمني الحق حتى للطريق اهتدِي",53,"د",2,0],["وارزقهمُ اللهمَّ أحسنَ صحة","وانصرهمُ اللهمَّ نصراً حاسما",54,"م",2,0],["وارزق لذريتي في الخلد متكأ","واجعل لمن ولدوا رضوان أبرار",55,"ر",1,0],["وارزق أبي , أمي وكل أحبتي","وسلالتي ما فيه حال يصلح",56,"ح",1,0],["وَ ارْزُقْ أهالِيَهَا الأكارمَ أَنْعُمًا","بِيَدَيْكَ خَيْرُ الْأَرْضِ وَ الْأَكْوَانِ",57,"ن",1,0]]}