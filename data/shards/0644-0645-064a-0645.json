{"poems":[[86,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[93,"بقي الذكر والرغام فني","https://www.aldiwan.net/poem11249.html","الخفيف"],[51,"ومدامة أغنت عن المصباح","https://www.aldiwan.net/poem9412.html","الكامل"],[51,"إذا تغنت شنطف مرة","https://www.aldiwan.net/poem65930.html","السريع"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[89,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[85,"لم يمت من له أثر","https://www.aldiwan.net/poem62861.html","مجزوء الخفيف"],[85,"ناشئ في الورد من أيامه","https://www.aldiwan.net/poem63769.html","الرمل"],[45,"ما أنت للكلف المشوق بصاحب","https://www.aldiwan.net/poem10671.html","الكامل"],[45,"لامت علي أنها في الدمع لم تلم","https://www.aldiwan.net/poem66653.html","البسيط"],[49,"ماذا يريك الزمان من عبره","https://www.aldiwan.net/poem62113.html","المنسرح"],[49,"في عداد الموتى وفي ساكني الدن","https://www.aldiwan.net/poem64299.html","الخفيف"],[66,"دق شوال في قفا رمضان","https://www.aldiwan.net/poem39193.html","الخفيف"],[66,"لو أفادتنا العزائم حالا","https://www.aldiwan.net/poem40128.html","المديد"],[66,"أسلبن من فوق النهود ذوائبا","https://www.aldiwan.net/poem41382.html","الكامل"],[80,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[102,"ضمها الطير مطبقا بجناحي","https://www.aldiwan.net/poem32972.html","الخفيف"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[46,"عجبي للطبيب يلحد في الخا","https://www.aldiwan.net/poem22293.html","الخفيف"],[46,"شكوت من أهل هذا العصر غدرهم","https://www.aldiwan.net/poem22983.html","البسيط"],[46,"أنسل أو اعقم فالتوحد راحة","https://www.aldiwan.net/poem23146.html","الكامل"],[46,"افهم عن الأيام فهي نواطق","https://www.aldiwan.net/poem23179.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85452","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39567","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42644","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54330","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[67,"البردة","https://www.poetsgate.com/ViewPoem.aspx?id=14575",""],[94,"بدعة الذل","https://www.poetsgate.com/ViewPoem.aspx?id=12816",""],[101,"صادِحَ الشَّرْقِ قَدْ سَكَتَّ طَوِيلاَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62417&r=&rc=9",""],[144,"شرف المعالي من يساجلك العلى","https://www.aldiwan.net/poem11790.html","الكامل"],[165,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[170,"صدت فجذت حبل وصلك زينب","https://www.aldiwan.net/poem1606.html",""],[200,"ثوب السماء مطرز بالعسجد","https://www.aldiwan.net/poem45645.html","الكامل"],[212,"أسرفت يوما على شبابي","https://www.aldiwan.net/poem46222.html","مخلع البسيط"],[224,"ملي النور قبل عهد البدور","https://www.aldiwan.net/poem39689.html","الخفيف"],[236,"لو أن قلبك مثل قلبي مغرم","https://www.aldiwan.net/poem31768.html","الكامل"],[236,"لميمون وجه يسوء العيون","https://www.aldiwan.net/poem31798.html","المتقارب"],[306,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[306,"وافى رسولكم وأعفاج الحشا","https://www.aldiwan.net/poem56616.html","الكامل"],[329,"هو ناي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[365,"إذا الحمام على الأغصان غنانا","https://www.aldiwan.net/poem60616.html","البسيط"],[372,"قالوا ألم تحضر عليا عندما","https://www.aldiwan.net/poem57412.html","البسيط"],[433,"أنجد الصب وغاروا","https://www.aldiwan.net/poem12645.html","مجزوء الرمل"],[454,"في الشتاء العويل والأشجان","https://www.aldiwan.net/poem61727.html","الخفيف"],[459,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[462,"يسوس الأمر وجبته ضجاج","https://www.aldiwan.net/poem16427.html","الوافر"],[480,"الله أكبر في ضريح واحد","https://www.aldiwan.net/poem37048.html","الكامل"],[515,"هذا الحمى يا فتى فانزل بحومته","https://www.aldiwan.net/poem20832.html","البسيط"],[516,"يا مالك الرق ومن حقه","https://www.aldiwan.net/poem12168.html","السريع"],[516,"أيها الناس والخطاب إلى من","https://www.aldiwan.net/poem12291.html","الخفيف"],[539,"أتركوه يهذي فإن كلامه","https://www.aldiwan.net/poem47945.html","عموديه"],[552,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[552,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[552,"شطت عليك لبانة الصدر","https://www.aldiwan.net/poem47783.html","أحذ الكامل"],[559,"لم أزل في الحب يا أملي","https://www.aldiwan.net/poem34255.html","المديد"],[576,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"]],"verses":[["لَم يَمحُ مِنها وَلا مِن حُسنِ جِدَّتِها","عَلى التَعاقُبِ ما يَمحو الجَديدانِ",0,"ن",1,0],["لَمْ يُمَالِيءْ عَلَى الصَّوَابِ هَوى","أوْ يُجَنِبْ مَا اسْتَدَّ مِنْ سَنَنِ",1,"ن",1,0],["لم يمنعوا الشاكين ريْبَ زمانهم","أُذُناً ولا سمعوا ملامةَ لاحي",2,"ح",2,0],["لم يملأ الآفاقَ لكنّه","قد دَوَّخَ الآفاقَ تجويلا",3,"ل",2,0],["لمْ يُمسِ قطُّ ولم يُصْبِحْ مَحلُّهُمُ","إلا التقى فيه إيتاءٌ وإتيان",4,"ن",1,0],["لم يمت في حقيقة الأمر سعد","انه لا يزال يخطب بعد",5,"د",1,0],["لَم يَمُت مَن لَهُ أَثَر","وَحَياةٌ مِنَ السِيَر",6,"ر",1,1],["لَم يُمَتَّع مِن صِبا أَيّامِهِ","وَلَياليهِ أَصيلٌ وَسَحَر",7,"ر",1,0],["لَم يَمشِ واشٍ بَينَهُنَّ وَلا دَعا","بَيناً لَهُنَّ صَدى الغُرابِ الناعِبِ",8,"ب",1,0],["لَم يُمسِ إِلّا بِمالٍ مِنهُ مُقتَسَمٍ","أَيدي سَبا وَبِعِرضٍ غَيرِ مُقتَسَمِ",9,"م",1,0],["لَم يَمضِ مِنّا قُدّامَنا أَحَدٌ","إِلّا وَمَن خَلفَهُ عَلى أَثَرِه",10,"ر",2,0],["لَم يَمُت ميتَةَ الوَفاةِ وَلَكِن","ماتَ عَن كُلِّ صالِحٍ وَجَميلِ",11,"ل",1,0],["لَم يَمَسَّ التُرابَ نَعلاكَ إِل","لا حَسَدَتهُ مَعاقِدُ التيجانِ",12,"ن",1,0],["لَم يَمُت مَن طابَ ذِكراً وَأَبقى","بَعدَهُ شِبهاً لَهُ أَو مِثالا",13,"ل",2,0],["لَم يَملَأوا فيكَ البُيوتَ غَرائِباً","إِلّا وَقَد مَلَأوا البُيوتَ رَغائِبا",14,"ب",2,0],["لم يمتْ أحمد أخو البأسِ حتّى","ماتَ ما بيننا العزاءُ الجميلُ",15,"ل",1,0],["لَم يُمتَّع بِنَشوة الحُب حَتّى","أَشرَعَت شَوكة تَلظّى شباها",16,"ا",3,0],["لَمْ يَمْتَحِنَّا بما تعْمل العُقولُ بِهِ","حِرْصاً علينا فلمْ ولَمْ نَهَمِ",17,"م",1,0],["لَم يُمارِس مِنَ السِقامِ طَويلاً","وَمَضى لَم يُكابِدِ التَبريحا",18,"ح",2,0],["لَم يَمض كَونٌ مِنَ الأَكوانِ في زَمَنٍ","عَلَيَّ إِلّا بِهِ لِلحَتفِ أَزدَلِفُ",19,"ف",1,0],["لَم يَمنَعِ اِبنَ المَلكِ مِن آفاتِهِ","عُوَذٌ تُناطُ بِكَشحِهِ وَمَراسِلُ",20,"ل",1,0],["لَم يَمضِ في دُنياكَ أَمرٌ مُعجِبٌ","إِلّا أَرَتكَ لِما مَضى تِمثالا",21,"ل",2,0],["لَم يمنع الأقوام من إذعانهم","شمم من الأقوام في الآناف",22,"ف",1,0],["لم يَمُتْ مَنْ حديثُه يملأ الوا","دي ويطوي سهولَه وحزونه",23,"ن",2,0],["لَمْ يَمْضِ مِنْ حُسْنِهِ مَا كُنْتُ أَعْهَدُهُ","حَتَّى أَصَابَ سَوَادَ الْقَلْبِ نَاقِرُهُ",24,"ر",2,0],["لم يمتْ مَنْ سعى الخلودُ إليه","وجرى ذِكرهُ بكلِّ لسان",25,"ن",1,0],["لَمْ يَمُتْ مَنْ يَزُولُ مِنْ عَالَمِ الْحِسِّ","وَتَأبَى آثارُهُ أَنْ تَزُولاَ",26,"ل",2,0],["لم يمتَحِنَّا بما تَعيَا العقولُ به","حِرصَاً علينا فلم نرتَبْ ولم نَهِمِ",27,"م",1,0],["لم يميّز محبّبا من بغيض","في الدّجى لا تميّز الألوان",28,"ن",1,0],["لَمْ يَمُتْ من يَزُولُ مِنْ عَالَم ِالْحِ","ناً وَمَثْوًى رَحبْاً وَظِلاًّ ظَلِيلاَ",29,"ل",2,0],["لَم يُمنَ جَبّارٌ بِبَأسِكَ ساعَةً","إِلّا وَعاوَدَ خاضِعاً مُتَذَلِّلا",30,"ل",2,0],["لَم يَملِكِ الماءُ عَلَيها أَمرَها","وَلَم يُدَنِّسها الضِرامُ المُختَضى",31,"ا",1,0],["لَم يُمنَعِ العافونَ إِلّا عِرضَهُ","وَالعِرضُ عِندَ ذَوي النُهى لا يُوهَبُ",32,"ب",1,0],["لم يمنعِ القصرُ المشيدُ ملوكهُ","منها فكيفَ وفاكها الغصنُ الندي",33,"د",2,0],["لم يمض ليل بلا ظلام","لم يمض صبح بلا ضباب",34,"ب",1,0],["لَم يَمُت شاعِرُ اللَيالي فَعَينا","هُ تَشعّانِ في الكِتابِ الصَغيرِ",35,"ر",1,0],["لَم يَمدَحِ الخُلَفاءَ قَبلُ بِمِثلِها","فيما رَوَيناهُ الوَلَيدِ وَمُسلِمُ",36,"م",1,0],["لِمَيمونَ وَجهٌ يَسوءُ العُيونَ","مَنظَرُهُ الأَسوَدُ الحالِكُ",37,"ك",1,1],["لَم يمنحِ اللّه عبداً فضلَ عارفةٍ","إلّا وَأَنت لها منشا ومستلمُ",38,"م",1,0],["لَم يمضِ آنٌ منذُ أيّامٍ خلَت","إلّا وعبدكمُ حليفُ إناءِ",39,"ا",2,0],["لم يمثله سواه وهو فان","في سواه",40,"ه",1,0],["لم يَملأِ العَيْنَ من أحبابِه نظَراً","إذ غادرَ الدَّمعُ منه الجَفْنَ مَلآنا",41,"ن",2,0],["لم يمضِ قبلَكَ من أراه أُسوَةً","فأَقولُ هذا مثلُ ذاك وأصبرُ",42,"ر",1,0],["لم يمرّ العيدُ إلا","بندًى منْك يُمارُ",43,"ر",1,0],["لم يُميَّز ربيعهم من شتاءٍ","في قلوبٍ إجدابُها ألوان",44,"ن",1,0],["لم يمضِ من قبلي فمٌ لأُذُنٍ","بمثلهِنّ مُوعَباً ولم يَطِرْ",45,"ر",1,0],["لَميْمونِ النَّقيبَةِ والمَساعي","مَطالِبُهُ ثَناءٌ أوْ ثَوابُ",46,"ب",1,0],["لم يمض يوم من زماني لم يكن","ذكراهما في ضمن ذاك العائد",47,"د",1,0],["لم يُمكِنِ المرءَ حِفظاً للفؤادِ به","يوماً ولو كان مَقبوضاً بعَشْرَتِهِ",48,"ت",2,0],["لم يمنع الخادم من قصده","سعياً إلى بابك غير المرض",49,"ض",1,0],["لم يميز بين البرية إلا","حسنات يزينها الإنسان",50,"ن",1,0],["لم يَمُت قبلَ أن يُتمِّمَ معنى الدينِ","أو يَبتَنِي صُروحَ الفَخامَه",51,"م",2,0],["لم يمضِ عنّا من مضى وظلامُهُ","لِتَهجُّدٍ ونهارُهُ لصيامِ",52,"م",1,0],["لم يمضِ ماضٍ بان وهو محمّدٌ","وَنأى أَشدَّ النّأي وهو مذمَّمُ",53,"م",1,0],["لَم يَمتَطوا كَتَدَ المَعابِ ولا","عقدوا مآزهم على وِزْرِ",54,"ر",1,0],["لم يمل عن أمره أحد","دائماً في سائر الملل",55,"ل",1,0],["لم يُمِتْني إِلاَّ الحَبِيبُ ولم يُحْ","يي الْمَعَالي إِلاَّ أَبو الْفَضْلِ جَعْفَر",56,"ر",1,0]]}