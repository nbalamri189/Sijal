20,"قلعة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=40442",""],[5397,"جلى صباح الهدى للخطب جنح دجى","https://www.poetsgate.com/ViewPoem.aspx?id=157955",""],[5397,"أترع لي في سفحه الأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=157902",""],[5409,"أيار شهرك بالكوارث مفعم","https://www.poetsgate.com/ViewPoem.aspx?id=155316",""],[5409,"عدتها والفكر منها","https://www.poetsgate.com/ViewPoem.aspx?id=155256",""],[5409,"عصفت بها ريح الهوى فتدلهت","https://www.poetsgate.com/ViewPoem.aspx?id=155257",""],[5628,"المخادعة","https://www.poetsgate.com/ViewPoem.aspx?id=178801",""],[5749,"سعداتك ايلا بغاتك","https://www.poetsgate.com/ViewPoem.aspx?id=179968",""],[4623,"أعلى الزمان أخذت عهد أمان (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146772",""],[402,"بقي الذكر والرغام فني","https://www.poetsgate.com/ViewPoem.aspx?id=36474",""],[402,"أمر من يطلب الخلود عسير","https://www.poetsgate.com/ViewPoem.aspx?id=35552",""],[5823,"بكائية لياسمين دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=59163",""],[5885,"حلمي","https://www.poetsgate.com/ViewPoem.aspx?id=195058",""],[5939,"لستِ أنثى!","https://www.poetsgate.com/ViewPoem.aspx?id=185492",""],[5956,"إني أحدد يا حبيبة موقعَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=182108",""],[5970,"ينقم الناقمون فعل الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=130600",""],[4442,"لم يمت من يعيش في جناته","https://www.poetsgate.com/ViewPoem.aspx?id=171233",""],[520,"يا مالك الرق ومن حقه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577567",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""]],"verses":[["لَم يَمحُ مِنها وَلا مِن حُسنِ جِدَّتِها","عَلى التَعاقُبِ ما يَمحو الجَديدانِ",0,"ن",1,0],["لَمْ يُمَالِيءْ عَلَى الصَّوَابِ هَوى","أوْ يُجَنِبْ مَا اسْتَدَّ مِنْ سَنَنِ",1,"ن",1,0],["لم يمنعوا الشاكين ريْبَ زمانهم","أُذُناً ولا سمعوا ملامةَ لاحي",2,"ح",2,0],["لم يملأ الآفاقَ لكنّه","قد دَوَّخَ الآفاقَ تجويلا",3,"ل",2,0],["لمْ يُمسِ قطُّ ولم يُصْبِحْ مَحلُّهُمُ","إلا التقى فيه إيتاءٌ وإتيان",4,"ن",1,0],["لم يمت في حقيقة الأمر سعد","انه لا يزال يخطب بعد",5,"د",1,0],["لَم يَمُت مَن لَهُ أَثَر","وَحَياةٌ مِنَ السِيَر",6,"ر",1,1],["لَم يُمَتَّع مِن صِبا أَيّامِهِ","وَلَياليهِ أَصيلٌ وَسَحَر",7,"ر",1,0],["لَم يَمشِ واشٍ بَينَهُنَّ وَلا دَعا","بَيناً لَهُنَّ صَدى الغُرابِ الناعِبِ",8,"ب",1,0],["لَم يُمسِ إِلّا بِمالٍ مِنهُ مُقتَسَمٍ","أَيدي سَبا وَبِعِرضٍ غَيرِ مُقتَسَمِ",9,"م",1,0],["لَم يَمضِ مِنّا قُدّامَنا أَحَدٌ","إِلّا وَمَن خَلفَهُ عَلى أَثَرِه",10,"ر",2,0],["لَم يَمُت ميتَةَ الوَفاةِ وَلَكِن","ماتَ عَن كُلِّ صالِحٍ وَجَميلِ",11,"ل",1,0],["لَم يَمَسَّ التُرابَ نَعلاكَ إِل","لا حَسَدَتهُ مَعاقِدُ التيجانِ",12,"ن",1,0],["لَم يَمُت مَن طابَ ذِكراً وَأَبقى","بَعدَهُ شِبهاً لَهُ أَو مِثالا",13,"ل",2,0],["لَم يَملَأوا فيكَ البُيوتَ غَرائِباً","إِلّا وَقَد مَلَأوا البُيوتَ رَغائِبا",14,"ب",2,0],["لم يمتْ أحمد أخو البأسِ حتّى","ماتَ ما بيننا العزاءُ الجميلُ",15,"ل",1,0],["لَم يُمتَّع بِنَشوة الحُب حَتّى","أَشرَعَت شَوكة تَلظّى شباها",16,"ا",3,0],["لَمْ يَمْتَحِنَّا بما تعْمل العُقولُ بِهِ","حِرْصاً علينا فلمْ ولَمْ نَهَمِ",17,"م",1,0],["لَم يُمارِس مِنَ السِقامِ طَويلاً","وَمَضى لَم يُكابِدِ التَبريحا",18,"ح",2,0],["لَم يَمض كَونٌ مِنَ الأَكوانِ في زَمَنٍ","عَلَيَّ إِلّا بِهِ لِلحَتفِ أَزدَلِفُ",19,"ف",1,0],["لَم يَمنَعِ اِبنَ المَلكِ مِن آفاتِهِ","عُوَذٌ تُناطُ بِكَشحِهِ وَمَراسِلُ",20,"ل",1,0],["لَم يَمضِ في دُنياكَ أَمرٌ مُعجِبٌ","إِلّا أَرَتكَ لِما مَضى تِمثالا",21,"ل",2,0],["لَم يمنع الأقوام من إذعانهم","شمم من الأقوام في الآناف",22,"ف",1,0],["لم يَمُتْ مَنْ حديثُه يملأ الوا","دي ويطوي سهولَه وحزونه",23,"ن",2,0],["لَمْ يَمْضِ مِنْ حُسْنِهِ مَا كُنْتُ أَعْهَدُهُ","حَتَّى أَصَابَ سَوَادَ الْقَلْبِ نَاقِرُهُ",24,"ر",2,0],["لم يمتْ مَنْ سعى الخلودُ إليه","وجرى ذِكرهُ بكلِّ لسان",25,"ن",1,0],["لَمْ يَمُتْ مَنْ يَزُولُ مِنْ عَالَمِ الْحِسِّ","وَتَأبَى آثارُهُ أَنْ تَزُولاَ",26,"ل",2,0],["لم يمتَحِنَّا بما تَعيَا العقولُ به","حِرصَاً علينا فلم نرتَبْ ولم نَهِمِ",27,"م",1,0],["لم يميّز محبّبا من بغيض","في الدّجى لا تميّز الألوان",28,"ن",1,0],["لَمْ يَمُتْ من يَزُولُ مِنْ عَالَم ِالْحِ","ناً وَمَثْوًى رَحبْاً وَظِلاًّ ظَلِيلاَ",29,"ل",2,0],["لَم يُمنَ جَبّارٌ بِبَأسِكَ ساعَةً","إِلّا وَعاوَدَ خاضِعاً مُتَذَلِّلا",30,"ل",2,0],["لَم يَملِكِ الماءُ عَلَيها أَمرَها","وَلَم يُدَنِّسها الضِرامُ المُختَضى",31,"ا",1,0],["لَم يُمنَعِ العافونَ إِلّا عِرضَهُ","وَالعِرضُ عِندَ ذَوي النُهى لا يُوهَبُ",32,"ب",1,0],["لم يمنعِ القصرُ المشيدُ ملوكهُ","منها فكيفَ وفاكها الغصنُ الندي",33,"د",2,0],["لم يمض ليل بلا ظلام","لم يمض صبح بلا ضباب",34,"ب",1,0],["لَم يَمُت شاعِرُ اللَيالي فَعَينا","هُ تَشعّانِ في الكِتابِ الصَغيرِ",35,"ر",1,0],["لَم يَمدَحِ الخُلَفاءَ قَبلُ بِمِثلِها","فيما رَوَيناهُ الوَلَيدِ وَمُسلِمُ",36,"م",1,0],["لِمَيمونَ وَجهٌ يَسوءُ العُيونَ","مَنظَرُهُ الأَسوَدُ الحالِكُ",37,"ك",1,1],["لَم يمنحِ اللّه عبداً فضلَ عارفةٍ","إلّا وَأَنت لها منشا ومستلمُ",38,"م",1,0],["لَم يمضِ آنٌ منذُ أيّامٍ خلَت","إلّا وعبدكمُ حليفُ إناءِ",39,"ا",2,0],["لم يمثله سواه وهو فان","في سواه",40,"ه",1,0],["لم يَملأِ العَيْنَ من أحبابِه نظَراً","إذ غادرَ الدَّمعُ منه الجَفْنَ مَلآنا",41,"ن",2,0],["لم يمضِ قبلَكَ من أراه أُسوَةً","فأَقولُ هذا مثلُ ذاك وأصبرُ",42,"ر",1,0],["لم يمرّ العيدُ إلا","بندًى منْك يُمارُ",43,"ر",1,0],["لم يُميَّز ربيعهم من شتاءٍ","في قلوبٍ إجدابُها ألوان",44,"ن",1,0],["لم يمضِ من قبلي فمٌ لأُذُنٍ","بمثلهِنّ مُوعَباً ولم يَطِرْ",45,"ر",1,0],["لَميْمونِ النَّقيبَةِ والمَساعي","مَطالِبُهُ ثَناءٌ أوْ ثَوابُ",46,"ب",1,0],["لم يمض يوم من زماني لم يكن","ذكراهما في ضمن ذاك العائد",47,"د",1,0],["لم يُمكِنِ المرءَ حِفظاً للفؤادِ به","يوماً ولو كان مَقبوضاً بعَشْرَتِهِ",48,"ت",2,0],["لم يمنع الخادم من قصده","سعياً إلى بابك غير المرض",49,"ض",1,0],["لم يميز بين البرية إلا","حسنات يزينها الإنسان",50,"ن",1,0],["لم يَمُت قبلَ أن يُتمِّمَ معنى الدينِ","أو يَبتَنِي صُروحَ الفَخامَه",51,"م",2,0],["لم يمضِ عنّا من مضى وظلامُهُ","لِتَهجُّدٍ ونهارُهُ لصيامِ",52,"م",1,0],["لم يمضِ ماضٍ بان وهو محمّدٌ","وَنأى أَشدَّ النّأي وهو مذمَّمُ",53,"م",1,0],["لَم يَمتَطوا كَتَدَ المَعابِ ولا","عقدوا مآزهم على وِزْرِ",54,"ر",1,0],["لم يمل عن أمره أحد","دائماً في سائر الملل",55,"ل",1,0],["لم يُمِتْني إِلاَّ الحَبِيبُ ولم يُحْ","يي الْمَعَالي إِلاَّ أَبو الْفَضْلِ جَعْفَر",56,"ر",1,0],["لم يمُت مَن له مآثر جلّت","وعلينا له أيادٍ فواضل",57,"ل",1,0],["لَم يَمضِ يَومٌ عَنكَ إلاَّ غارِمٌ","أَو غارِمٌ مِن مالِهِ عَن غارِمٍِ",58,"م",1,0],["لم يمس في المزاح إلا يداه","حذر القصف فوق خصر نحيل",59,"ل",1,0],["لم يمض عام الخطب حتى أحرجوا","صدر المؤله فاستقال سقيما",60,"م",2,0],["لم يَمُتْ مِيتة الوفاةِ ولكنْ","مات من كلِّ صالحٍ وجميلِ",61,"ل",1,0],["لَمْ يُمَحِّضْ بِمِثْلِهِ مُقْرَبُ الدَّهْ","رِ وَلاَ اسْتَامَ شِبْهَهُ مَنْ يَسُومُ",62,"م",1,0],["لم يمنعوا سؤالهم بل مانعوا","عن بيضة الإسلام أن يتهضما",63,"م",2,0],["لم يمدح الفتح الوليد بمثله","يوما ولا بعث البعيث إلى الحكم",64,"م",1,0],["لم يمتنع عن طلب الزيادة","ويرغب السلطان والسيادة",65,"ه",1,0],["لَم يَمُتِ الفِقهُ وَلَكِنَّهُ","حُوِّل مِن صَدر إِلى صدر",66,"ر",1,0],["لم يمت من يدومُ ما دامت","الأيام حيا في زمرة الخالدينا",67,"ن",2,0],["لَم يَملِكِ المَاءُ عَلَيهَا أمرَهَا","وَلَم يُدَنِّسهَا الضِّرَامُ المُحتَضَا",68,"ض",2,0],["لم يمسحنَّ جفونَه إلاَّ رأى","شوكَ القنا الأهدابَ رأي يقين",69,"ن",1,0],["لم يَمِل عودُه بَطوعِ هوىً","وكذا الريحُ تَقصفُ الصلْبا",70,"ب",2,0],["لم يمل قلبه إلى الغير قلبا","غائباً في الشهود ما زال حبا",71,"ب",2,0],["لم يمت فيصل ولا مات مجده","عهده في الحياة والموت عهده",72,"د",2,1],["لم يمت فيصل وفي الملك غاز","مستقل وذلك الجند جنده",72,"د",2,0],["لَم يَمُت وَالأَميرُ طاهِرُ حَيٌّ","دائِمُ الإِنتِقامِ وَالإِنعامِ",73,"م",1,0],["لم يمت يكذب الحسود ولكن","هذه تخمة من الفضلات",74,"ت",1,0],["لم يمض عزمك مثلما تمضي الظبا","لكنْ كما نفذ القضاء المبرم",75,"م",1,0],["لَم يَمتَنِع مِنكَ عَلى غِرَّةٍ","وَهَو كَثيرُ الجَمعِ جَمُّ العَدَد",76,"د",1,0],["لم يملني سواهما ولهذا","شغلاني عن كل غصنٍ وريق",77,"ق",1,0],["لم يمنعُوا منَّا مقاماً واحداً","إلا جدَارَهُم وبطنِ الخندَقِ",78,"ق",1,0],["لم يمت موسراً من المال لكن","موسراً من محامد وفعال",79,"ل",1,0],["لَم يَمُت مَن عاشَ فينا بِالثَنا","وَالفِعال الغُرّ وَالخُلقِ الحَميد",80,"د",1,0],["لم يملكوها وقد جادوا لمالكها","لما دعوا سمحوا طوعاً وما بخلوا",81,"ل",3,0],["لم يمت من غدا الثناء عليه","بين أحيائنا يدير كؤوسا",82,"س",2,0],["لم يمت ضيغم أتانا بشبل","خلفا منه عند كل مظنات",83,"ت",1,0],["لم يمل عنك صبوة وهواه","ليس يرضى توحيده لك شركا",84,"ك",2,0],["لم يمت من يعيش في كل قلب","شبّ فيه من الحنين ضراما",85,"م",2,0],["لم يمدحوا غير ذي جاه وذي جدة","مضللّين عقول الناس تضليلا",86,"ل",2,0],["لم يملكوا تسكين أوجاع الورى","يوما فصاروا للورى أوجاعا",87,"ع",2,0],["لم يمتهن فن السؤال ولم يجد","للشحذ لفظا في النفوس مؤثرا",88,"ر",2,0],["لم يمت سعد ولكن هزة","غادرت خضراء وادى النيل جردا",89,"د",2,0],["لم يمت سعد ولكن ضربة","برءت من تهمة القتل عمدا",89,"د",2,0],["لم يمت سعد ولكن وثبة","مهدت في الخلد للراحل مهدا",89,"د",2,0],["لم يمت سعد ولكن حمرة","لمست جسم أبي الهول فقدا",89,"د",2,0],["لَم يمتحنا بما تعيا القول به","علماً بأَنَّ مزيد الخير في الأمَم",90,"م",1,0],["لَم يَمتحنا بِما تعيي العُقول بِه","خَوفاً عَلَينا مِن الإيقاع في الوَهَم",91,"م",1,0],["لم يمدح الشعراء قبلكَ ماجداً","إلّا وأنت تفوقه وتسودُ",92,"د",1,0],["لم يمنَعوه السيرَ في الطريق","ويأخذوا عليه بالمضيقِ",93,"ق",1,0],["لم يمتع من الشباب يزيد","صار في الترب وهو غض جديد",94,"د",1,1],["لم يمتزج صفوها في القلب مع نكد","ولا تمازجَ بين الصفو والكدر",95,"ر",1,0],["لَم يَمضِ عام وَالحَياة عَزيزَة","حَتّى تراجع عزّها أَعواما",96,"م",2,0],["لَم يَمشِ مَركوبٌ بِهم فَنفوسهُم","حثُّوا النجاءَ كَما تُحَثُّ الأَينُقُ",97,"ق",1,0],["لم يماكس إن قام سوق ثناء","لا كمن يشتري ثناءاً ببخس",98,"س",1,0],["لم يُمتَدَح داوُدُ في غَلَباتِهِ","كالعفوِ عن شاوُلَ حينَ بهِ ظفر",99,"ر",1,0],["لم يمنع الشرب منها غير أن نطقت","حمامة في غصون ذاتِ أوقال",100,"ل",1,0],["لم يمضِ بعد على تفرق شمله","إلا كما فرق الكرى الأجسادا",101,"د",2,0],["لم يمسك العلم في ماضي دراسته","إلا كما يمسك الماء الغرابيل",102,"ل",1,0],["لم يمح عن جان بغي","ر التوب سيّئَ الاجتراح",103,"ح",1,0],["لم يمت والعياذ بالله حتى","نر عن ملة الرسول ارتداده",104,"د",2,0],["لم يَمُتْ من سَدَدْتَ ثُلْمتَه يا","مَن على الدّين كظَّه إشفاقُه",105,"ق",2,0