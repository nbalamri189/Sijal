 لَيْسَ بِبَالِ",262,"ل",1,0],["لاَ نَبْتَغِي عَلَى الهَوَى مِنْ عَوَضٍ","وَلِلْهَوَى مِنْ نَفْسهِ كُلِّ العَوَضْ",263,"ض",1,0],["لاَنَتْ مَعَاطِفُهُا وَصَالَتْ عِزَّةٌ","قَعْسَاءُ مِنْ أَجْفَانِهَا بِقَوَاضِبِ",264,"ب",1,0],["لاَنَتْ لَهُ الصُّمُّ الصِّلاَدُ وَلَمْ تَلِنْ","شَيْئاً قُلُوبُ الصَّفْوَةِ الفُضَلاَءِ",265,"ا",2,0],["لأَنّا عَبَدْنَا اللهَ لم نَرْجُ غَيْرَهُ","رَجَاءَ الجِنَانِ إذْ أَتَانَا زَعِيمُها",266,"م",3,0],["لأني أحب كل طفله","أحب كل خصلة",267,"ه",1,0],["لانت لَيالِيَّ ثُمَّ عادَت","تَشتَدُّ مِن لَوعَتي طِوالا",268,"ل",2,0],["لَأَنتُم وَإِن خُنتُم مَواثيقَ عَهدِنا","أَحِبَّةُ قَلبي لا أُريدُ بَديلا",269,"ل",2,0],["لَأَن تُحسِنوا أَولى بِكُم مِن إِساءَةٍ","وَما كانَ أَولى بِالجَميلِ جَميلا",269,"ل",2,0],["لأنتنَّ أشفَى للسليمِ من الرُّقَى","وأطيبُ للظمآنِ من كلِّ سَلْسَلِ",270,"ل",1,0],["لأنّ أبا حنيفَةَ كان برّاً","تقياً عابداً لا مثل جيفَه",271,"ف",2,0],["لأنَّ إحاطتها بالأيور","تُوَهِّمُنِيهِ أخي من أبي",272,"ي",1,0],["لأنّه من لا هنا","أو من مزائد العلن",273,"ن",1,0],["لا نَرى فيك غيرَ عهدٍ مَجيدٍ","قَرَنتْهُ العُلاَ بعهدٍ مَجيدِ",274,"د",1,0],["لانَتْ به الدُّنيا وأَخْصب عَيْشُها","وبيُمْنِهِ اخْضرَّ الزمانُ المُقْفِر",275,"ر",1,0],["لانتْ لشعري كما لانتْ معاطفُها","والشعرُ سحرٌ له بحرٌ وأوزانُ",276,"ن",1,0],["لا نسمِّيه فيكفي وصفُه","فيه عن كلِّ تعريفٍ غَناء",277,"ا",2,0],["لا نورَ في الآفاق إلا أن ترى","طيارة قد طاردتها أسهم",278,"م",1,0],["لأنتَ في كلِّ حرْب سيفُ معركةٍ","وأَنتَ في كلِّ سِلمٍ كفُّ عُمْرانِ",279,"ن",1,0],["لأنت أسلم -يا بن الصلب- عاقبة","من أنفس ملئت حقدًا وبغضاء",280,"ا",2,0],["لا نثني فزعًا أمامَ أزيزهِ","بل نحمل الأرُواحَ فوق الراحِ",281,"ح",1,0],["لأنعامها ودُّهُ صافيًا","ويا رُبَّ ودٍ بغير صفاء",282,"ا",2,0],["لانت قناتهمو لدعوته، وما","لانت قناتهمو لغمز ثقاف",283,"ف",1,0],["لأني رضِيعُ بَيانٍ وصَرفْ","أَجوعُ لِحرفٍ.. وأقتاتُ حرفْ",284,"ف",1,1],["لأَني وُلِدتُ ببابِ النُّحَاةِ","أَظَلُّ أُوَاصِلُ هَرْفًا بهَرفْ",284,"ف",1,0],["لأنني منها ، فمي بعضها","يخاف لا تدري غداً أين فوك",285,"ك",1,0],["لا نبتغي ربّاً سواهُ ناصر