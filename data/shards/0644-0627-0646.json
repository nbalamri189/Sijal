ي السد","https://www.poetsgate.com/ViewPoem.aspx?id=179600",""],[106,"الإنسان الآلي","https://www.poetsgate.com/ViewPoem.aspx?id=179449",""],[106,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[106,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[106,"ذكرى محمد ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=179428",""],[100,"لِعينيكَ يا مَوطني","https://www.poetsgate.com/ViewPoem.aspx?id=183583",""],[100,"بنوك .. وديوك","https://www.poetsgate.com/ViewPoem.aspx?id=183585",""],[23,"واللهِ ربي لا نفارقُ ماجداً","https://www.poetsgate.com/ViewPoem.aspx?id=11419",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[90,"غضبة","https://www.poetsgate.com/ViewPoem.aspx?id=179231",""],[90,"جمال الدين الأفغاني","https://www.poetsgate.com/ViewPoem.aspx?id=179201",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[45,"طَفِقَتْ تَلومُ وَلاتَ حينَ مَلامِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=185700",""],[64,"مراحل على الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=3097",""],[64,"لأَنوار نور الدين في الخلق أنوارُ","https://www.poetsgate.com/ViewPoem.aspx?id=8510",""],[64,"جواب في حقيقة الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=3095",""],[51,"ومولًى يجرُّ الشرَّ لي غيرَ مؤْتَل","https://www.poetsgate.com/ViewPoem.aspx?id=30229",""],[51,"لو أنَّ لي أختاً فأنكَحْتُها","https://www.poetsgate.com/ViewPoem.aspx?id=30718",""],[88,"لقد طوَّحتني في البلادُ مُضاعَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19522&r=&rc=25",""],[85,"يا ربِّ، ما حكمكَ؟ ماذا ترى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9649&r=&rc=139",""]],"verses":[["لَأَنتِ النَفسُ خالِصَةً فَإِن لَم","تَكونيها فَأَنتِ إِذاً مُناها",0,"ا",3,0],["لَأَنتُم أَسِنَّةُ يَومِ الطِعانِ","إِذا أَسلَمَ السَرحَ فُرسانُهُ",1,"ن",2,0],["لَأَنتُم أَعَزُّ عَلى مُهجَتي","مِنَ الماءِ يَنقَعُ مِنهُ الأُواما",2,"م",2,0],["لا ناصِرٌ غَيرَ دَمعي إِن هُمُ ظَلَموا","وَالدَمعُ عَونٌ لِمَن ضاقَت بِهِ الحِيَلُ",3,"ل",1,0],["لا نالَهُ الداءُ الَّذي نالَني","مِنهُ وَإِن شَفَّ وَإِن أَمرَضا",4,"ض",2,0],["لا ناظِراً أَثَراً وَلا","مُتَوَجِّساً لِلقَومِ رِزّا",5,"ز",2,0],["لا نارُهُم نارٌ مُغَمَّضَةٌ وَلا","أَبياتُهُم بِالغائِطِ المُتَزاوِرِ",6,"ر",1,0],["لِأَنّي ما تَحَيَّفَني زَمانٌ","فَأَحوَجَني الحُسامُ إِلى نَصيرِ",7,"ر",1,0],["لا نَتَرَجّى مِنهُمُ إِيابا","وَلا نَعُدُّ لَهُمُ الأَحقابا",8,"ب",2,0],["لأَنتِ إِلى نَفسي أَحَبُّ مِنَ الغِنَى","وَذِكرُكِ أَحلى في فُؤادي مِنَ الأَمْنِ",9,"ن",1,0],["لأن بني (قايين) أضحوا عوالم","على الارض أمست للشياطين منزغا",10,"غ",2,0],["لأن الثرى وارى البراءات، لا الكَل","يفوحُ، ولا يزقو صهيلٌ، ولا رُغا",10,"غ",2,0],["لأن حنايا والدي من خرائبٍ","فمن ما به أعطاكِ هذا وأسبغا؟",10,"غ",2,0],["لأّنا التقينا ، ولدنا الشروق","وأهدى لنا كل نجم وشاح",11,"ح",1,0],["لِأَنَّ أَرضَهُمُ مِن بَعدِ رِحلَتِن","تَبقى بِلا فارِسٍ يُدعى وَلا بَطَلِ",12,"ل",1,0],["لِأَنَّ هَواكِ في صَدري مُقيمٌ","أَظُنُّ هَواكِ أَقسَمَ لا يَزولُ",13,"ل",1,0],["لَأَنتِ عَلى التَناءِ فَاِعلَميهِ","أَحَبُّ إِلَيَّ مِن بَصَري وَسَمعي",14,"ي",1,0],["لاَ نَاقَةٌ ليَ فِي صَبْرِي وَلاَ جَمَلُ","مِنْ بَعْدِ مَا ظَعَنَ اْلأَحْبَابُ وَاحْتَمَلُوا",15,"ل",3,1],["لأَنْتَ يا موْلايَ شمْسُ العُلا","حقّاً وهَذا البُرْجُ بُرْجُ الأسَدْ",16,"د",1,0],["لأَنْتَ صَباحُ ظَلامِ الخُطوبِ","وكفُّكَ مِفْتاحُ بابِ السّعودْ",17,"د",1,0],["لأَنْتَ عِمَادُ الْمُلْكِ وَالله رَافِعٌ","وَأَنْتَ حُسَامُ الدِّيِنِ وَاللهُ ضَارِبُ",18,"ب",1,0],["لا ناقِصِي حَسَبٍ وَلا","أَيدٍ إِذا مُدَّت قِصارَه",19,"ر",2,0],["لا نَقيها حَدَّ السُيوفِ وَلا نَأ","لَمُ جوعاً وَلا نُبالي السُهاما",20,"م",2,0],["لا نَرتَضي العَيشَ يَجري","في ذِلَّةٍ وَهَوانِ",21,"ن",1,0],["لا نَحنُ مَوتى وَلا الأَحياءُ تُشبِهُنا","كَأَنَّنا فيكِ لَم نَشهَد وَلَم نَغِبِ",22,"ب",1,0],["لا نَيلُنا يُرجى وَلا أَضيافُنا","تُقرى وَلا نُدعى لدَفعِ مَخوفِ",23,"ف",1,0],["لا نَوْمَ حتى تَقودوا الخَيلَ عابِسَة ً","يَنْبُذْنَ طِرْحاً بمُهْراتٍ وأمْهارِ",24,"ر",1,0],["لانَتْ صِلابُ العَزَائِمْ","وانْبَتَّ عِقْدُ العَظَائِمْ",25,"م",1,1],["لِأَنَّ ذا العَقلِ إِذا لَم يُزَع","عَن حِلمِهِ اِستَحيا فَلَم يَخرُقِ",26,"ق",1,0],["لأَنظُرَ هَل تَبدو لِعينَيَّ نَظرَةً","بِحومانَةِ الزُرقِ الحُمولُ البَواكِرُ",27,"ر",1,0],["لانَت عَريكَتُها مِن طولِ ما سَمِعَت","بَينَ المَفاوِزِ تَنآمَ الصَدى الغَرِدِ",28,"د",1,0],["لأنها تنفي الهم","مقاتلي لش ترقود",29,"د",1,0],["لأندلسٍ ثكلٌ عليه مُرَدَّدٌ","له لبست سودَ المسوح نواحيها",30,"ي",3,0],["لأنتَ مُنَى قلبي ونزهة خاطري","ومورد آمالي وإن كنت أُحرمُ",31,"م",1,0],["لأنت الذي مهما دجا ليلُ مشكلٍ","قَدَحْتَ به للنور وارية الزِّندِ",32,"د",1,0],["لأن الأرض تسبح في فضاء","وما تلك السماء سوى الفضاء",33,"ا",2,0],["لا نَطرُقُ الجاراتِ مِن بَعدِ هَجعَةٍ","مِنَ اللَيلِ إِلّا بِالهَدِيَّةِ تُحمَلُ",34,"ل",1,1],["لِأَنّا نَرى حَقَّ الجِوارِ أَمانَةً","وَيَحفَظُهُ مِنّا الكَريمُ المُعاهِدُ",35,"د",1,0],["لا نَخذُلُ الجارَ وَلا نُسلِمُ ال","مَولى وَلا نُخصَمُ يَومَ الخِصام",36,"م",1,0],["لِأَنَّ اللُؤمَ فيهِم مُستَبينٌ","إِذا كانَ الوَقائِعُ وَالمِصاعُ",37,"ع",1,0],["لِأَنَّ أَبي خِلافَتُهُ شَديدٌ","وَأَنَّ أَباكَ مِثلُكَ ما عَداكَ",38,"ك",1,1],["لِأَنَّهُمُ يَرجونَ مِنهُ شَفاعَةً","إِذا لَم يَكُن إِلّا النَبِيِّينَ شافِعُ",39,"ع",1,0],["لا نَبتَغي رَبّاً سِواهُ ناصِراً","حَتّى تُوافِيَ ضَحوَةُ الميعادِ",40,"د",1,0],["لِأَنَّ ثَوابَ اللَهِ كُلَّ مُوَحِّدٍ","جِنانٌ مِنَ الفِردَوسِ فيها يُخَلَّدُ",41,"د",1,0],["لَأَنتُم بِحَملِ المُخزِياتِ وَجَمعِها","أَحَقُّ مِنا اِن تَستَجمِعوا لِعَفافِ",42,"ف",1,0],["لا نعتب الأيَّامَ كيفَ تقلَّبت","بالقاطنينَ وأنتَ من حسناتها",43,"ت",3,0],["لأنتم خيرُ من ركبَ المطايا","وأندَى العالمينَ بطونَ راح",44,"ح",1,0],["لأنصحنك نصحاً إن مشيت به","فيالهُ من سبيلٍ للعلى جددِ",45,"د",1,0],["لأنك قد أوهنت جهدي باللهى","وأنسيتني أهلي وأكثرتَ حسَّدي",46,"د",2,0],["لا نهدَ إلاَّ من صدرِ غانيةٍ","ولا كميتَ إلاَّ منَ الكاس",47,"س",1,0],["لأنجمها وصل السعود بذكرِكم","إذا أنجمٌ أخنت عليها قطوعها",48,"ع",3,0],["لا نبالي إن قيل شهر جمادى","كل شهر براحتيك ربيع",49,"ع",1,0],["لأنف حاسدك الرغم الطويل فقد","ظهرت يا ابن عليّ مظهراً حسنا",50,"ن",2,1],["لا نلت قربك من دارِ النعيمِ غداً","إن كانَ قلبي المعنى عن هواكَ سلا",51,"ل",2,0],["لِأَنَّ البَدرَ مُحتا","جٌ إِلى وَجهِكَ يا بَدرُ",52,"ر",1,0],["لِأَنَّ الخَلقَ خُدّامُ الأَماني","وَحقُ الحَقِّ في التَقديسِ قُدسُ",53,"س",1,0],["لِأَنوارِ نورِ النورِ في الخَلقِ أَنوارُ","وَلِلسِرِّ في سِرِّ المُسِرّينَ أَسرارُ",54,"ر",1,1],["لِأَنَّ روحي قَديماً فيه قَد عَطِشَت","وَالجِسمُ ما مَسَّهُ مِن قَبلُ تَركيبُ",55,"ب",1,0],["لأنه شابَهُ بجودٍ","أحيا به الناسَ كلَّ مَحْيا",56,"ا",1,0],["لأن الناس لا يخفى عليهم","أمنعٌ كان منهُ أم عطاءُ",57,"ا",2,0],["لا نَبْتغي شيئاً سواك وإنما","طَلَبُ امرىءٍ ما بعدَ حاجتهِ كَلَبْ",58,"ب",1,0],["لأنَّ إحاطتها بالأيور","تُوَهِّمُنِيهِ أخي من أبيب",59,"ب",1,0],["لأنتِ شَيْنُ القيانِ يا غَنِجَهْ","ذميمةُ القدِّ في الورى سَمِجَهْ",60,"ج",2,1],["لأن إشاراتهم لا تزا","ل قد نفضت نحو عَيْنٍ يدا",61,"د",2,0],["لأني أتيت الحظ من نحو بابه","فإن يك حرمانٌ فذاك على جَدِّي",62,"ي",1,0],["لأن الجود منه كل يوم","وأنت تجود أياماً عِدادا",63,"د",2,0],["لأن احتيال الدهرِ في ابنٍ وفي ابنةٍ","يسيرٌ وكرُّ الدهر شيخيك أعسر",64,"ر",1,0],["لا نَخلُ من جملة ألطافكم","لا يخلُ من شكركُم مَحضر",65,"ر",1,0],["لأنك معدوم الوجود وإنما","يرينيك ظني ريثما أتدير",66,"ر",1,0],["لأنه أولاك جلّ اسمه","ما لا يجازَى عنه بالشكر",67,"ر",1,0],["لأنك أعطيت الجزيل وإنما","يُرجِّي المرجِّي عودةَ النائِل النزر",68,"ر",1,0],["لأنك طالبتَ ما عندَهُ","كأنك ترقيهِ أو تسحرُهْ",69,"ه",1,0],["لأنك لم تثِقْ منه بمجدٍ","يَنوب عن المديح ولا بِخير",70,"ر",1,0],["لأنت أشهرُ قبل الشَعر من عَلمٍ","عليه نارٌ ومن مرآة بُرجَاس",71,"س",1,0],["لأن أصلِّي كصلاة الفُرسِ","للَهِ والنجم وعينِ الشمسِ",72,"س",1,1],["لأني متى أتلفتُه احتجتُ حاجةً","تُذيل مصونَ العِرض في طلب القرضِ",73,"ض",1,0],["لأن وجهي بقبح صورته","ما زال لي كالمشيب والصَّلعِ",74,"ع",1,0],["لأني على ثقة أنني","متى رمت رفدك لم يمتنع",75,"ع",1,0],["لا نفع في ذاك إن نظرت وإن","قوَّم منك الحياء والورع",76,"ع",1,0],["لأنه ليس فيك من بدع ال","أشياء كلّا ولا من الطُّرف",77,"ف",1,0],["لأني أرى الناس قد خُبِّلوا","وأصبح زِيُّهُمُ من خلاف",78,"ف",1,0],["لا نكر قد تصبح العيدان مورقة","كما تَبدَّلُ عرياً بعد إيراق",79,"ق",1,0],["لأنك نِلْت مني فاجتباني","بذاك جميعُ من لا يجتبيكا",80,"ك",2,0],["لأن لفظة سُكَّان إذا قُلبَتْ","حروفها ناكس لا شك في ذاكا",81,"ك",2,0],["لأنك يأسُوكَ الذي هو كَلمُهُ","بلا جُرمٍ لو أن جورَكَ يعدلُ",82,"ل",1,0],["لأن في الخُرء نفعاً","للنخلِ والخلُّ يؤكَلْ",83,"ل",1,0],["لأنني عالمٌ بأنك لا","تعتِبُ فيما أصلحتُ من عملي",84,"ل",2,0],["لأنك لا يُعْتَدُّ جُودُكَ فُرْصَةً","تفوتُ وإن أضحتْ لُهاك تُقَسَّمُ",85,"م",1,0],["لأنني يلزمني","كلُّ الذي يلزمُهُ",86,"م",2,0],["لَانْتقامُ المظلومِ أرْبى على الظَّا","لمِ من ظُلمه على المظلومِ",87,"م",1,1],["لأنْفيَ نَوْمي لا لأشفِيَ غُلَّتي","على أنَّ عيني مُذْ فقدتُكِ لم تنمْ",88,"م",1,0],["لأنَّك لم تثقْ منه بِمَجْدٍ","فتقنَعَ باللِّقاءِ وبالسلام",89,"م",1,0],["لا نُلْزَمُ الذكرَ إنّا لم نُسَمَّ به","ولا مُنِحْناهُ بل للذِّكر ذُكران",90,"ن",1,0],["لا ندَّعي الفضلَ بل فينا لطائفةٍ","منهمْ أبو الصَّقر تسليمٌ وإذعان",90,"ن",1,0],["لأن جرذانَ أبي غانم","في اللوحِ مشكولٌ بتسكينه",91,"ن",2,0],["لأنني إن تُهْتُ في جيرتي","بنائِكٍ أخْتيَ سُفِّهْتُ",92,"ت",1,0],["لَأُنبِئتِ أَنّا نَجتَدي الفَضلَ إِنَّما","نُكَلَّفُهُ مِنَ النُفوسِ خَيارُها",93,"ر",3,0],["لِأَنَّكَ أَشجَعُ الأَبطالِ طُرّاً","وَأَعظَمُ قادَةِ الدُنيا فُتوحا",94,"ح",2,0],["لا نَتَّقي عَينَ الرَقي","ب وَلا نُبالي بِالغَيورِ",95,"ر",1,0],["لا نابَ غَيرَ عَدُوِّكُم ما نابَكُم","وَبَلَغتُمُ ما تَأمَلونَ وَنَأمَلُ",96,"ل",1,0],["لا نِبغيضُ الروسَ لَكِن لا نُحِبُّهُمُ","فَحَربُنا حَربُ أَقرانٍ لِأَقرانِ",97,"ن",1,1],["لا نُبغِضُ الروسَ لَكِن لا نُحِبُّهُمُ","فَحَربُنا حَربُ أَقرانٍ لِأَقرانِ",97,"ن",1,0],["لِأَنّي كُلَّما رَفَّهتُ عَنهُ","طَرِبتُ كَأَنَّني رَفَّهتُ عَنّي",98,"ي",1,0],["لَأَنتُمُ النورُ لي وَالنورُ مُنطَمِسٌ","وَأَنتُمُ الماءُ إِذ لا ماءَ يَرويني",99,"ن",2,0],["لِأَنَّكَ قَد بُرِّئتَ مِن كُلِّ مَأثَمٍ","وَأَنَّكَ في الدينِ الحَنيفِيِّ غَيرانُ",100,"ن",1,0],["لِأَنِّيَ أَدري أَنَّ لي مِنكَ جانِباً","سَيُسعِدُني طولَ الزَمانِ وَيُسعِفُ",101,"ف",1,0],["لأنَّهم يجهلونَ الوَحْيَ","الَّذي تُضْمِرينا",102,"ن",2,0],["لا نَسْأَمُ اللَّهْوَ الجميلَ","وليس يُدْرِكُنا الفُتُورْ",103,"ر",1,0],["لا نَحْفَلُ الدُّنيا تدور","بأَهلها أَو لا تَدورْ",103,"ر",1,0],["لأنتُمُ القَومُ إِن خطّوا يُجِد قَلَمٌ","وَإِن يَقولوا يُصِب فصل الخِطاب فَمُ",104,"م",1,0],["لا نُرَع لِلدَمع في آماقِنا","مَزَجته بِدَمٍ أَيدي الحُرَقْ",105,"ق",1,0],["لا نفع في طول الحياة فانها","كالماء ان يمكث طويلا يفسد",106,"د",1,0],["لأنت وان عذبت نفسي حبيبها","وانت على الهجران ملء جناني",107,"ي",1,1],["لا ناره نار ولا","خميسه عرمرم",108,"م",1,0],["لانت اضعف مخلوق ويدهشني","مافي سلاحك من سحر واسرار",109,"ر",1,0],["لانت اعدى عدو لي يطاردني","وانت اجدر من عادي باكباري",109,"ي",1,0],["لانت اقدر من غنى بقافية","لحنا يرجعه من بعد ترنيم",110,"م",1,0],["لا نبالي بعد ان حم الردى","أهناك الموت وافى ام هنا",111,"ن",2,0],["لانهضة من غير حرية","فهي من البنيان كالأس",112,"س",1,0],["لأنت جميل في الحياة وبعدها","كذلك في عينيَّ أنت جميل",113,"ل",1,0],["لأنك أنت للأوطان كهف","وأنت حقوق مصرِك والطِلاب",114,"ب",1,0],["لأنهم يظلمون العُلى","وأنت وحقك مظلومها",115,"م",3,0],["لأن السعد للقدمين نعل","ومن ذا يغلب السعد الغلوبا",116,"ا",1,0],["لِأَنَّ الروحَ عِندَكَ وَهيَ أَصلٌ","وَحَيثُ الأَصلُ تَسعى المُلحَقاتُ",117,"ت",1,0],["لا نَسأَلُهُ ثَمَنَ المُهَجِ","وَكَفى بِالواجِبِ مِن ثَمَنِ",118,"ن",1,0],["لِأَنَّني قَد حِرتُ في التَفَكُّرِ","لَمّا سَمِعتُ أَنَّهُ مِن سُكَّرِ",119,"ر",1,0],["لِأَنَّ بِالسَعيِ يَقومُ الكَونُ","وَاللَهُ لِلساعينَ نِعمَ العَونُ",120,"ن",1,0],["لا نَحنُ جِرمانُ لَنا حِصَّةٌ","وَلا بِرومانَ فَنُعطى فَتيل",121,"ل",1,0],["لانوا لَها في شِدَّةٍ وَصَلابَةٍ","لَينَ الحَديدِ مَشَت عَلَيهِ النارُ",122,"ر",1,0],["لأَنْتِ المُنَى يا زَيْنَ كُلِّ مَليحَةٍ","وأَنْتِ الهَوى أُدْعَى لَهُ فَأُجِيبُ",123,"ب",1,0],["لا نَعذُلُ المَرَضَ الَّذي بِكَ شائِقٌ","أَنتَ الرِجالَ وَشائِقٌ عِلّاتِها",124,"ت",3,0],["لِأَنّي كُلَّما فارَقتُ طَرفي","بَعيدٌ بَينَ جَفني وَالصَباحِ",125,"ح",1,0],["لا ناقَتي تَقبَلُ الرَديفَ وَلا","بِالسَوطِ يَومَ الرِهانِ أُجهِدُها",126,"د",3,0],["لِأَنَّكَ بَحرٌ وَإِنَّ البِحارَ","لَتَأنَفَ مِن مَدحِ هَذي البِرَك",127,"ك",1,0],["لِأَنَّكَ مُبغِضٌ حَسَباً نَحيفا","إِذا أَبصَرتَ دُنياهُ ضِناكا",128,"ك",2,0],["لِأَنَّ حِلمَكَ حِلمٌ لا تَكَلَّفُهُ","لَيسَ التَكَحُّلُ في العَينَينِ كَالكَحَلِ",129,"ل",1,0],["لأن به الماسُ على يبسه","وانحلَّ منه الطلق حتى جرى",130,"ر",2,0],["لأنتِ صميمُ القلبِ والنفسِ والذي","إِذا رُمتُ حُبَّاً غيرَهُ فهو ما أعني",131,"ي",1,0],["لا نارُهُ تخبُو ولا يدُهُ","تنبو ولا إِقبالُه يكبُو",132,"ب",2,0],["لا نَعدَمُ الطَولَ في رِضاهُ وَلا","نَخافُ حَيفَ الغُلُوِّ مِن غَضَبِه",133,"ب",2,0],["لِأَنَّ لِكُلٍّ مِنهُما وَقتَ غَيبَةٍ","وَأَنَّكَ لا غُيِّبتَ لَستَ بِغائِبِ",134,"ب",1,0],["لا ناهِلُ الأَجفانِ إِن كانَ الكَرى","خِمساً لِصادِيَةِ العُيونِ الوُرَّدِ",135,"د",1,0],["لِأَن طالَ حِرمانُ الزَمانِ فَإِنَّهُ","سَيُسليهِ يَومٌ مِن عَطائِكَ واحِدُ",136,"د",1,0],["لَأَنتَ أَمَدُّ بِالمَعروفِ كَفّاً","وَأَوهَبُ لِلُّجَينِ وَلِلنُضارِ",137,"ر",1,0],["لَأَنظِمَنَّ القَوافي في مَثالِبِهِ","كَنَظمِ عِقدِ كَسولِ المَشيِ مِعطارِ",138,"ر",1,0],["لانَت مَعاطِفُهُ فَخَيَّلَ أَنَّهُ","لِلشَيزَرانِ مُناسِبٌ بِعِظامِهِ",139,"م",2,0],["لانَرهَبُ الأَيامَ بَل مِن بَأسِنا","يُخشى الرَدى وَحَوادِثُ الأَزمانِ",140,"ن",1,0],["لِأَنَّ لَها نِصفَ المِلاحَةِ قِسمَةً","مَعَ الفَترَةِ الحَسناءِ عِندَ التَهانُفِ",141,"ف",1,0],["لا نَعْدَمَنْ غُرَّةَ الأميرِ فقد","أعدَمَ مِنْ جُودِ كَفِّهِ العَدَما",142,"م",2,0],["لا نُبالي وَلا نَراهُ غَراماً","ذا لَعَمري لَوِ اِتَّعَظنا الغَرامُ",143,"م",1,0],["لأن الهوى يدنو إذا ما دنوتم","وقرب الهوى يذكي التلهب بالطبع",144,"ع",1,0],["لا نِلتُ مِن طيبِ وَصلِكُم أَمَلا","إِن أَنا حاوَلتُ عَنكُمُ بَدَلا",145,"ل",2,1],["لَأَنتَ مِن مَعشَرٍ بَعَدلِهِمِ","قُوِّمَ زَيغُ الزَمانِ فَاِعتَدَلا",145,"ل",2,0],["لانَ لَكَ الدَهرُ بَعدَ شِدَّتِهِ","فَجادَ لِلناسِ بَعدَما بَخِلا",145,"ل",2,0],["لَأَنتَ عِندي أَخَصُّ الناسِ مَنزِلَةً","إِذ كُنتَ أَقدَرَهُم عِندي عَلى السَلَمِ",146,"م",1,0],["لِأَنّي سَأَلتُكَ رَدَّ الجَوابِ","وَلا تَعرِفُ الرَدَّ لِلسائِلِ",147,"ل",1,0],["لِأَنَّهُ مُشفِقٌ تَنهاهُ رَأفَتُهُ","عَن أَن يَراني في شَيءٍ مِنَ الأَلَمِ",148,"م",1,0],["لِأَنَّكَ دُنيايَ الَّتي هِيَ فِتنَتي","فَلا عَجَبٌ أَلّا تَدومَ عَلى حالِ",149,"ل",1,0],["لِأَنّي لا أَخونُ عُهودَ خِلٍّ","وَلَو حَفَّت بِيَ النُوَبُ الثِقالُ",150,"ل",1,0],["لا نَملِكُ الدَمعَ وَالأَحزانُ تَملِكُنا","إِنَّ الزَمانَ الَّذي قَد كانَ يُضحِكُنا",151,"ن",2,0],["لِأَنَّ إِفراطَ هَذا البِرِّ يُبعِدُني","عَنكُم وَقَد كُنتُ مِنهُ دائِمَ الحَذَرِ",152,"ر",1,0],["لِأَنِّيَ مِن أَهلِ اليَقينِ عَلى الوَفا","وَقَد يَحدُثُ التَغييرُ عِندَ ذَوي الشَكِّ",153,"ك",1,0],["لِأَنّي قَد حَلَلتُ حِمى مُلوكٍ","رُبوعُ عَبيدِهِم كَهفُ الطَريدِ",154,"د",1,0],["لِأَنَّكَ سِرُّ اللَهِ الأَيَّدِ الَّتي","تَجَلَّت فَجَلّى ظُلمَةَ الشَكِّ نورُها",155,"ر",3,0],["لِأَنّي رَأَيتُ العُربَ تَخفُرُ بِالعَصا","وَتَحمي إِذا ما أَمَّها مُستَجيرُها",155,"ر",3,0],["لِأَنَّكَ كُلَّما حاولَتَ أَمراً","يُصَوِّبُ فَعلَكَ الرَأيُ السَديدُ",156,"د",1,0],["لِأَنّي فَعَلتُ وَما قُلتُ قَطُّ","وَأَنتَ تَقولُ وَلا تَفعَلُ",157,"ل",1,0],["لا نار تُذْكَى في الدجى لسَفْرِهِ","إلا بريقُ مُقلَةِ السمعمعِ",158,"ع",1,0],["لا نُشورٌ لِشَبابي بَعدَ ما","ماتَ مِن عُمري إلى يَومِ النُّشور",159,"ر",1,0],["لا نأيَ لي بِتَنائي السّيرِ عن بَلَدي","فقد رضيتُ بحمصٍ بَعْدَهُ بلَدا",160,"د",2,0],["لَأُنَكِّلَنَّكَ أَن تَكونَ لِشاعِرٍ","مِن بَعدِها غَرَضاً وَأَصلُكَ فاسِدُ",161,"د",1,0],["لَأَنفَدَنَّ أَسىً إِذ لَم أَمُت أَسَفاً","أَو يَنفَدُ العُمرُ بي أَو يَنفَدُ الأَبَدُ",162,"د",1,0],["لانَت مَهَزَّتُهُ فَعَزَّ وَإِنَّما","يَشتَدُّ بَأسُ الرُمحِ حينَ يَلينُ",163,"ن",1,0],["لا نَزَعَ اللَهُ مِنكَ صالِحَةً","أَبلَيتَها مِن بَلائِكَ الحَسَنِ",164,"ن",1,0],["لا نالَكَ العَثرُ مِن دَهرٍ وَلا زَلَلُ","وَلا يَكُن لِلعُلا في فَقدِكَ الثُكَلُ",165,"ل",1,1],["لا نَجمَ مِن مَعشَرٍ إِلّا وَهِمَّتُهُ","عَلَيكَ دائِرَةٌ يا أَيُّها القُطُبُ",166,"ب",1,0],["لأنني منْ بينكمْ","رُبيتُ حرّاً ديِّنا",167,"ن",2,0],["لأنفْتُ مِنْ مدحي لهم متكسِّباً","فالكسبُ بالأمداحِ ثوبُ صَغارِ",168,"ر",1,0],["لأنني كلُّ الفنا","ألقاهُ منْ بعضِ الفندْ",169,"د",1,0],["لأنها داثرةٌ","علا عليها ذلُّها",170,"ل",3,0],["لأن في يس جا","ء ذكرُها وفضلُها",170,"ل",3,0],["لا نعرِف الوِّد إلا أنَّه دنَفٌ","من الصبابةِ يعتاد المُحبينا",171,"ن",2,0],["لَأَنتُم حِبُّ شَيءٍ إِن جَلَسنا","وَإِن زُرنا فَأَوجَهُ مَن نَزورُ",172,"ر",1,0],["لا نَنثُرُ الدُرَّ فيهِ بَينَنا كَلِماً","حَتّى أُقَبِّلُهُ مِن مَبسَمٍ نَسَقا",173,"ق",2,0],["لَإِن ظَعَنَ الأَحبابُ يا أُمَّ مالِكٍ","لَما ظَعَنَ الحُبُّ الَّذي في فُؤادِيا",174,"ي",2,0],["لَإِن كانَ ما أَلقى مِنَ الحُبِّ أَنَّني","بِهِ كَلِفٌ جَمُّ الصَبابَةِ مُغرَمُ",175,"م",1,0],["لَإِن نَزَحَت دارٌ بِلَيلى لَرُبَّما","غَنينا بِخَيرٍ وَالزَمانُ جَميعُ",176,"ع",1,1],["لَإِن كانَ يُهدى بَردَ أَنيابِها العُلا","لِأَفقَرَ مِنّي إِنَّني لَفَقيرُ",177,"ر",1,0],["لا نومَ بعدَ اليّوم عن أسلابنا","فَخُذِي العُهودَ ورَدِّدي الأخبارا",178,"ر",2,0],["لانوا بأيدي الغاصِبينَ فلم تَلِنْ","للقومِ في جِدّ الأُمورِ قَناةُ",179,"ه",1,0],["لأَنْتَ على رُكودِك مُستطيرٌ","من الأرواحِ مُطّرِدُ الهُبوبِ",180,"ب",1,0],["لأَنتِ سلاحُ كلِّ فتىً أبيٍّ","يَصولُ فيصرعُ البطلَ النَّجيدا",181,"د",2,0],["لا نَدِبُّ الضَراءَ يوماً ولا نط","لبُ سِلماً ونحن نبغي القتالا",182,"ل",2,0],["لَأَنتُم خَيرُ مَن يُرجى لِمِصرٍ","وَلَكِنّا نَرى العَجَبَ العُجابا",183,"ب",2,0],["لا نُحِبُّ العَطاءَ نَمتاحُهُ مِن","كُم وَلا نَبتَغي لَدَيكُم نَوالا",184,"ل",2,0],["لا نَبتَغي غَيرَ دُنيا الأَنبِياءِ وَلا","نَرضى سِوى اللَهِ مِن رَبٍّ لَنا ثانِ",185,"ن",1,0],["لا نَعرِفُ اليَأسَ المُميتَ وَلا نَرى","أَنَّ الحَياةَ سَبيلُها مَسدودٌ",186,"د",1,0],["لا نَنشُدُ العَهدَ المُؤَكَّدَ بَينَنا","النيلُ عَهدٌ دائِمٌ وَذِمامُ",187,"م",1,0],["لا نَستَكينُ لَدى الطِلابِ وَلا نَرى","عَنَتَ الزَمانِ إِذا اِستَمَرَّ غَراما",188,"م",2,0],["لأنتَ لنا عدوٌّ نتّقيهِ","فلا صُلحٌ يكونُ ولا سَلامُ",189,"م",1,0],["لإنقاذِ النُّفوسِ من البلايا","تُلِحُّ على مَبَاضِعها الأُساةُ",190,"ه",1,0],["لأنتَ رسولُ اللَّهِ ما فيك مِرْيةٌ","لِمن يَمترِي والحقُّ بادِي المعالِمِ",191,"م",1,0],["لأنتَ أعظمُ منه في جلالتِهِ","وما جلالةُ غاوي الرأيِ مُختبلِ",192,"ل",1,0],["لأنتِ أكرمُ عند اللَّهِ مَنزلةً","يا زَوجَ أحمدَ إذ أعطاكِ إيّاهُ",193,"ا",2,0],["لأنتَ الحجَّةُ الكُبرى عليهم","فما نَفْعُ المِراءِ أوِ الجدالِ",194,"ل",1,0],["لأُنزِلنَّ ذوي الطُّغيانِ مَنزلةً","تستفرغُ الكبرَ من هامٍ وأبصارِ",195,"ر",1,0],["لأنتَ المَنزِلُ المَعمُورُ مَجداً","وَكُلُّ النَّاسِ دُونَكَ كَالطُّلُولِ",196,"ل",1,0],["لا نلت قربي والهِجران فِي قَرنٍ","ضِدٌّ بِضِدّ كَجَمعِ القُطنِ بِالشُّعَلِ",197,"ل",1,0],["لاَ نَالَ مِنكَ الزَّمَانُ حَظَّا","إلاَّ الذِي نِلتُ مِن وِصَالِك",198,"ك",1,0],["لا نَخافُ المُحولَ إِن هَرَشَ","الدَهرُ وَلا نَنتَوي لِأَهلٍ سِواكا",199,"ك",2,0],["لِأَني كُلَّما أَرسَ","لَ أَن إِيتِ أُمَنِّيهِ",200,"ي",2,0],["لا نَلتَقي إِلّا ثَلاثَ منىً","حَتّى يُشَتِّتَ بَينَنا النَفرُ",201,"ر",1,0],["لا ناصِرٌ مِن رُعبِهِ","أَبَداً يُوَلّيني القَفا",202,"ف",2,0],["لِأَنَّكَ مَجبولٌ عَلى الجودِ وَحدَهُ","وَلَستَ عَلى بُخلٍ يَخافُ بِقادِرِ",203,"ر",1,0],["لأنت لمن قد مزق الدهر شمله","ومعشره بالبين أهل ومعشر",204,"ر",1,0],["لأنْتَ ذا الجيشُ ثمّ الجيشُ نافلَةٌ","وما سِواكَ فلَغْوٌ غيرُ مْحتسَبِ",205,"ب",1,0],["لِأَنَّكَ إِن جَدّاكَ عُدّا فَإِنَّما","تَصيرُ رِلى المَنصورِ مِن حَيثُ تُنسَبُ",206,"ب",1,0],["لِأَنّي رُمتُ قُبلَتَهُ","عَلى ميقاتِ غَفلَتِهِ",207,"ت",2,0],["لِأَنّي عالِمٌ أَن سَوفَ تَنأى","مَسافَةُ بَينِ جُثماني وَروحي",208,"ح",2,0],["لا نَستَخِفُّ بِساقينا لِعِزَّتِهِ","وَلا يَرُدُّ عَلَيهِ حُكمَهُ أَحَدُ",209,"د",1,0],["لِأَنّي وَإِن كانَت مِنَ الناسِ واثِقٌ","لِنَفسِيَ مِنها بِالدَوامِ عَلى العَهدِ",210,"د",1,0],["لِأَنَّ الشَمسَ تَغرُبُ حينَ تُمسي","وَأَنَّ البَدرَ يُنقِصُهُ المَسيرُ",211,"ر",1,0],["لِأَنَّني أُكرِمُ عِرضي وَلا","أَقرُنُهُ يَوماً إِلى عِرضِكا",212,"ك",2,0],["لِأَنَّ حُبَّكِ حُبٌّ","في القَلبِ مِنّي دَخيلُ",213,"ل",1,0],["لِأَنَّ الكَرمَ مِن كَرَمٍ وَجودٍ","وَماءُ الكَرمِ لِلرَجُلِ الكَريمِ",214,"م",1,0],["لِأَنالَ مِنهُم عِندَ ذاكَ تَحِيَّةً","إِمّا بِوَجهٍ أَو بِطَرفِ لِسانِ",215,"ن",1,0],["لا نائِلٌ مِنكَ وَلا مَوعِدٌ","وَلا رَسولٌ فَعَلَيكَ السَلام",216,"م",1,0],["لا نَشرَبُ الماءَ إِلا قالَ شارِبُنا","نِعمَ الأَميرُ كَفاهُ السَمعُ وَالبَصَرُ",217,"ر",1,0],["لا نَرهَبُ القَتلَ إِنَّ القَتلَ مَكرُمَةٌ","وَلا نَضِنُّ عَلى راحٍ بِأَصفادِ",218,"د",1,0],["لَأَنتِ خَيرٌ مِن غُلامٍ بَتّا","يُصبِحُ سَكرانَ وَيُمسي بَهتا",219,"ت",2,0],["لا نَبوَتي رُشدَهُ إِلّا تَخَوُّنَهُ","غِمداً لِأَيرٍ غَوِيٍّ بِاِستِ مُنجابِ",220,"ب",1,0],["لا ناكِثاً عَهداً وَلا طالِباً","سُخطَكَ ما غَنّى الحَمامُ الطِراب",221,"ب",1,0],["لا نَستَطيعُ وَلا نُسطاعُ مِن سَرَفٍ","فَالصَفحُ أَمثَلُ مِن وَصلٍ عَلى رُقَبِ",222,"ب",1,0],["لِأَنَّكَ مَوضِعُ القُسطاسِ مِنها","فَتَمنَعُ جانِبَيها أَن تَميلا",223,"ل",2,0],["لا نالَ خَيراً فَتىً أَمسَت أَنامِلُهُ","مَدارِيَ السَرحِ مَوصولاً بِها العُقَصُ",224,"ص",1,0],["لا نَعلَمُ المَوتى تَهُمُّ بِكَرَّةٍ","لَكِنَّ أَحياءً تَرومُ لَحاقا",225,"ق",2,0],["لانَت عَلى المَسِّ بِالأَيدي جُسومُهُم","وَفي الصُدورِ لَعَمري يَنبُتُ الحَسَكُ",226,"ك",1,1],["لا نَقي بِالأَحسابِ مالاً وَلَكِن","نَجعَلُ المالَ جُنَّةَ الأَحسابِ",227,"ب",1,0],["لأَنّه في عسكرٍ قدِ انخرَمْ","بِنَدْبِ كلِّ العُرفاءِ والحشَمْ",228,"م",1,0],["لانَ حتى لو مَشى الذَّرْ","رُ عليهِ كادَ يُدْميهِ",229,"ي",2,0],["لأنت شاعر هذا الروض أجمعه","وأنت تنطق إما قلت بالغرر",230,"ر",1,0],["لا نَرى إلا أَنجماً زاهرات","لو نظرنا إلى سماء الماضي",231,"ض",2,0],["لأنت سَعيدٌ أيُّها البدر فالتمِعْ","كَما شئتَ لا زالَت بك الأَرض تزهر",232,"ر",1,0],["لأنت أَرض هوىً لي","قد تم فيها الفطام",233,"م",1,0],["لأنت هوى نَفسي وأَنتَ سرورها","وأَنتَ رَبيع النفس في سنة الأزل",234,"ل",1,0],["لأَنت بنت الأَماني","مَنزوعة من جناني",235,"ي",1,0],["لأنت يا كوكب الصُّب","حِ للدُجُنَّة ماحي",236,"ي",1,0],["لانَت احسن ما شاهدت من حسن","وأَنت أَكبر ما منيت من أَرب",237,"ب",1,0],["لا نجح إلا وَالمشقة أمُّه","كالنور يظهر حيث تَذكو النار",238,"ر",1,0],["لأنت جَدير بالظهور عَلى العدى","وَأَنتَ بتأييد الخلافة أَجدَرُ",239,"ر",1,1],["لأن حلمك حلمٌ لا تكلّفه","ليس التحكّل في العينين كالكحل",240,"ل",1,0],["لأنك بحرٌ وإن البحار","لتأنف من حال هذي البرك",241,"ك",1,0],["لأنتَ حيٌّ برغم الموت أسمَعُهُ","كعهده وأراهُ مِلء وجداني",242,"ي",1,0],["لأنتَ مثلُ الرجال طُرّا","يا أيُّها الخائنُ الجميلُ",243,"ل",