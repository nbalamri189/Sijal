{"poems":[[9,"ما تعيف اليوم في الطير الروح","https://www.aldiwan.net/poem21921.html","الرمل"],[86,"أثنى الحجيج عليك والحرمان","https://www.aldiwan.net/poem68941.html","الكامل"],[93,"يا ابن لبنان عد إلى لبنان","https://www.aldiwan.net/poem11175.html","الخفيف"],[93,"لحق اليوم بالرفاق أمين","https://www.aldiwan.net/poem11209.html","الخفيف"],[88,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[70,"أنا في البستان وحدي","https://www.aldiwan.net/poem42401.html","مجزوء الرمل"],[70,"قد تجاسرت وفيك المحتمل","https://www.aldiwan.net/poem42739.html","الرمل"],[70,"غبت عني فما الخبر","https://www.aldiwan.net/poem42903.html","مجزوء الخفيف"],[92,"بالأمس قد كانت حياتي","https://www.aldiwan.net/poem38891.html","المجتث"],[89,"قد أسمعتك أنينها الأوطان","https://www.aldiwan.net/poem44941.html","الكامل"],[45,"شرخ الشباب أخو الصبا وأليفه","https://www.aldiwan.net/poem65161.html","الخفيف"],[61,"أمحل صبوتنا دعاء مشوق","https://www.aldiwan.net/poem51532.html","السريع"],[66,"من لصب أدنى البعاد وفاته","https://www.aldiwan.net/poem40641.html","الخفيف"],[44,"بأي نجوم وجهك يستضاء","https://www.aldiwan.net/poem29991.html","الوافر"],[87,"من لعين إنسانها لا يناميب كفا","https://www.aldiwan.net/poem8242.html","الخفيف"],[90,"أرج الشباب وخمره المسكوب","https://www.aldiwan.net/poem60158.html","عموديه"],[31,"نام الخلي وبت غير موسد أ","https://www.aldiwan.net/poem42571.html","الكامل"],[74,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[33,"أحقا عباد الله أن لست ناظرا","https://www.aldiwan.net/poem25909.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85314","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55003","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54687","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43877","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[100,"يوم العلم","https://www.poetsgate.com/ViewPoem.aspx?id=50183",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[129,"الموت أبكى جملة الأقوام","https://www.aldiwan.net/poem50524.html","الكامل"],[133,"راق قلبي ومقلتي والطور","https://www.aldiwan.net/poem54825.html","الطويل"],[156,"قد جحدت الهوى فلم يغن جحدي","https://www.aldiwan.net/poem55707.html","الخفيف"],[161,"لك في الملوك خوارق العادات","https://www.aldiwan.net/poem58905.html","الكامل"],[161,"قل لمن الغز السؤال وأرجى","https://www.aldiwan.net/poem59128.html","البسيط"],[161,"ظهرت عجائب قدرة الرحمن","https://www.aldiwan.net/poem59156.html","الكامل"],[190,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[193,"يا شبيه الفالوذ في حمرة الخد","https://www.aldiwan.net/poem27574.html","الخفيف"],[211,"يا بديع الزمان في كل فن","https://www.aldiwan.net/poem13413.html","الخفيف"],[230,"عند أهل العلوم والآداب","https://www.aldiwan.net/poem50720.html","الخفيف"],[230,"قد عزمنا على التصيد والنزهة","https://www.aldiwan.net/poem50865.html","الخفيف"],[240,"في ليلة صبغ الظلام أديمها","https://www.aldiwan.net/poem23837.html","الكامل"],[271,"سلام أيها الغيم الملث","https://www.aldiwan.net/poem35291.html","الوافر"],[306,"أسبل الدمع عند نشر دخان","https://www.aldiwan.net/poem56449.html","البسيط"],[306,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[329,"اسبقي الشمس كالشعاع وثوبا","https://www.aldiwan.net/poem54975.html","الخفيف"],[362,"ان من يحفظ المودة أحرى","https://www.aldiwan.net/poem68108.html","الخفيف"],[365,"قلب المشوق بأن يساعد أجدر","https://www.aldiwan.net/poem60910.html","الكامل"],[381,"عظمت من الله المواهب","https://www.aldiwan.net/poem48755.html","مجزوء الكامل"],[417,"تذكر بالخيف عهدا قديما","https://www.aldiwan.net/poem53932.html","المتقارب"],[417,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[417,"سكب الدمع لها فانسكبا","https://www.aldiwan.net/poem54052.html","الرمل"],[417,"بارق لاح فأبكاني ابتساما","https://www.aldiwan.net/poem54109.html","الرمل"],[433,"إن كسر الخليج صادفه اليو","https://www.aldiwan.net/poem12325.html","الخفيف"],[433,"قف بقفراء يباب","https://www.aldiwan.net/poem12547.html","مجزوء الرمل"],[435,"كم كان فيها من كرام سادة","https://www.aldiwan.net/poem25692.html","الكامل"],[444,"لله رب العرش والأكوان","https://www.aldiwan.net/poem56035.html","عموديه"],[453,"يا أديباً يبدي من الأدب الغض","https://www.aldiwan.net/poem13684.html","الخفيف"],[453,"صيبت خمائلنا بأيمن وافد","https://www.aldiwan.net/poem13709.html","الكامل"],[459,"أقريش لا فلم أراك ولا يد","https://www.aldiwan.net/poem56235.html","الكامل"],[462,"فضلت تهاني الأيام طرا","https://www.aldiwan.net/poem16096.html","الوافر"],[469,"يا أخا لا يمر حلو الإخاء","https://www.aldiwan.net/poem60521.html","الخفيف"],[501,"متكين بصرتنا وأحمد أحمد","https://www.aldiwan.net/poem38030.html","الكامل"],[506,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[516,"خفة الروح واجتناب الثقاله","https://www.aldiwan.net/poem12198.html","الخفيف"],[544,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[559,"أيها الطلعة التي أخذتنا","https://www.aldiwan.net/poem34407.html","الخفيف"],[564,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[568,"ما ترى في الصبوح أيدك الله","https://www.aldiwan.net/poem69743.html","الخفيف"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["فَتَفانَوا بِضِرابٍ صائِبٍ","مَلَأَ الأَرضَ نَجيعاً فَسَفَح",0,"ح",1,0],["فَتَفَيَّئوا ظِلَّ الهِلالِ فَإِنَّهُ","جَمُّ المَبَرَّةِ واسِعُ الإِحسانِ",1,"ن",1,0],["فَتَفَقَّدَ سَفْحاً فَخُوراً تَوَارَى","تَحْتَ حَانٍ مِنْ سَرْحِهِ شَاعِرَانِ",2,"ن",1,0],["فَتَفَرَّغْتَ لِلتَّآلِيفِ يُمْلِي","هَا ضَمِيرٌ حَيٌّ وَذِهْنٌ رَصِينُ",3,"ن",1,0],["فتفجرت في السفوح عيوناً","نبعت من مخازن الأطواد",4,"د",1,0],["فتفاءلتُ إذ بدتْ في شعورٍ","كشعورِ المعيز أصدقَ فالِ",5,"ل",1,0],["فَتَفَضَّل يا حَبيبي","نَغتَنِم هَذي العَشِيَّه",6,"ي",2,0],["فَتَفَضَّل بِقَبولٍ حَسَنٍ","فَلَكَ الفَضلُ قَديماً لَم يَزَل",7,"ل",1,0],["فَتَفَضَّل فَيَومُنا","بِكَ إِن زُرتَنا أَغَر",8,"ر",1,0],["فَتَفيضُ أَلحانُ الصَّبابَةِ","عَذْبَةً مِثْلَ الأَمَلْ",9,"ل",1,0],["فتفرَّق العادون بين بيوتها","وأتوا فظائع جمة وأهانوا",10,"ن",3,0],["فَتَفَتَّحَت بِالإِذنِ لي أَبوابُهُ","وَتَرَفَّعَت عَنّي إِلَيهِ سُجوفُهُ",11,"ف",2,0],["فتفرَّقَتْ عَبَراتُه في خَدِّه","إذ لا مُجيرَ له من التَّفريقِ",12,"ق",1,0],["فَتَفَضَّل بِالأُنسِ وَاِهدِ إِلى عَب","دِكَ مِن مِسكِكَ الزَكِيَّ فُتاتَه",13,"ت",2,0],["فَتَفعَلَ ما يَشاءُ المَجدُ فيهِ","فَإِنَّ المَجدَ يَفعَلُ ما يَشاءُ",14,"ا",2,0],["فَتَفَرَّدْ تَعِشْ بِنَفْسِكَ حُرّاً","رُبَّ فَرْدٍ يَخْشَاهُ جَيْشٌ لُهَامُ",15,"م",1,0],["فتفهمّوا إنَّ العراق بخيره","وثرائه ، لطَغامِهِمْ منهوب",16,"ب",1,0],["فَتَفَرَّجَ البابانِ عَن ذي مِرَّةٍ","ماضٍ عَلى العِلّاتِ لَيسَ بِقُعدُدِ",17,"د",1,0],["فَتَفرّى الجَيشُ عَن مِلكٍ","سافِرٍ عَن وَجهِ مُلتَثِمِ",18,"م",1,0],["فَتَفتُرُ عَينٌ ما تَمَلُّ مِنَ البُكا","وَيَسكُنُ قَلبٌ ما يُنَهنَهُ بِالزَجرِ",19,"ر",1,0],["فتفرح أَعداء وَتأسى أَحِبَّة","وَتنهَمِر اللعنات فوق دموع",20,"ع",1,0],["فَتفقَّدَتْ صُبْحاً أَلِيفَتَهَا الَّتِي","كَانَتْ سَلَتْهَا حَسْرَةً وَتَوَجُّعَا",21,"ع",2,0],["فَتَفَضَّلْ وَادْنُ بِتَهْنِئَةٍ","ادْمُجُ فِيهَا مَا عَنَّ لِي تَلْمِيحَا",22,"ح",2,0],["فتفاءلْتُ أنَّه قد تهَدَّى","لهُزالي فقَال لي يا سَمِينُ",23,"ن",1,0],["فتفرّق الأعداءُ عنكِ بَدائداً","والطعنُ فوق قفاهُمُ المصكوك",24,"ك",1,0],["فتفهّموا ما خلف كلّ تستّر","إنّ الحقيقة دربه وتفهّمُ",25,"م",1,0],["فتفتقرُ المواهبُ والمزايا","وتندَحرُ العزيمةُ والفَتاء",26,"ا",2,0],["فتفكرُوا وقد برُوا وتدكرُوا","ما دامتِ الأَرواحُ في الأَجسامِ",27,"م",1,0],["فَتَفَرَّستُ أنَّهُ مُجتَبَى شَذ","رِ اللاّلِي المنظومِ والمَنثُورِ",28,"ر",1,0],["فَتَفَضَّلْ بِزَوْرَةٍ فَعَساها","أَوَّلُ العَهدِ بي وآخِرُ عَهْدِي",29,"ي",1,0],["فتفرّقوا شذراً الخراب مزارع","ألقت عليهم ذِلةَ الأموَاتِ",30,"ت",1,0],["فتفطن لما أقول ففيه","لك عما سألتني عنه كشف",31,"ف",1,0],["فتفرقت تلك الجموع وادعت","لك بالخضوع وما التقى الجمعان",32,"ن",1,0],["فَتفسيرهُ مِن رأيهِ ليس خالياً","فَإمّا يُرى فِسقاً وإما يرى كفرا",33,"ر",2,0],["فَتَفَضَّلَ عَلى العَميدِ بِيَوم","جَد بِوَصلِ يَكبِتُ بِهِ أَعدائي",34,"ا",2,0],["فتفضل مولاي منك ببرد","او بظهر فالبرد حرق ظهري",35,"ر",2,0],["فتفضّلْ يا من حَوَى قَصَباتِ السْ","سّبْقِ في كلّ جَيْئَةٍ وذهابِ",36,"ب",1,0],["فَتَفَضَّلْ بباشِقَ كُلُّ ما فِي","هِ جَناحٌ ومِخْلَبٌ فِيهِ نَصْل",37,"ل",1,0],["فتفتحت أبوابها لقدومه","سبع على غير الرسول شداد",38,"د",1,0],["فتُفرج عَنكَ إن أفرَجتَ عنها","وللأقداحِ في الأعراقِ نفث",39,"ث",1,0],["فَتفاءلتُ إِنّ في اليأسِ مينٌ","وَتبيّنتُ فيهِ ليناً ورقّه",40,"ه",1,0],["فَتفرّقوا شيعاً لكلٍّ وجهةٌ","فيه وَأمرهمُ الجميع تقطّعُ",41,"ع",1,0],["فتفجرت في وجودي دماءً","وتدفّقت في دمائي لهيبا",42,"ب",2,0],["فَتَفضل وَراعِها بِقبول","فهي بكر تود صدرك خدرا",43,"ر",2,0],["فتفاخَرَ الفَتْحانِ حتّى لم يَبِنْ","للنّاسِ أيُّهما أجَلُّ وأكبَر",44,"ر",1,0],["فَتَفَرَّجَت كَرب القُلو","ب بِهِ كَما صَفَت المَشارب",45,"ب",1,0],["فتفضحُني عبرتي في الهوى","ولن ترى صبًّا لسرٍّ كتوما",46,"م",2,0],["فتفاءل باسمه في سَيْبه","فاسْمه كانَ لكن يرجوه فالا",47,"ل",2,0],["فتفضَّل يا ابن بنت المصطفى","أشرف العالم أُمًّا وأبا",48,"ب",2,0],["فتفضَّل وتقبَّل كلّ ما","جمعت فيك من الحقِّ كلاما",49,"م",2,0],["فتفضَّلْ عليه فالفَضْلُ أَوْلَى","بكَ يا مَنْ أَقَلُّ جَدْوَاهُ بَحْرُ",50,"ر",1,0],["فتفرّقْنا جميعاً","بعد ذاك الإصطحابِ",51,"ب",1,0],["فَتَفَرَّقُوا أَيْدي سَبا وَتَشَتَّتُوا","بَعْدَ اجْتِماعِهِمُ على الأَوْطان",52,"ن",1,0],["فتفرس الاختان كل منهما","في أختها كتفرس الحيران",53,"ن",1,0],["فتفضل مع الرسول إِذا شئ","ت بريحانة الشهاب الخفاجي",54,"ج",2,0],["فتفعت من نَوْره بوشائع","وتقرطت من زهره بفرائد",55,"د",1,0],["فتفَتْ بذكرِك فأرها فتفاوحت","نعما تَأَرَّجُ لي بِطيب المولدِ",56,"د",1,0],["فتَفْرَعُ كلَّ شامخةٍ كَؤَودٍ","يَزِلُّ الطَّيْرُ عنها والسِّامُ",57,"م",1,0],["فَتَفَضَّل بِما تَيَسَّرَ مِنها","فَوَنُعماكَ ما عَداكَ رَجائي",58,"ا",2,0],["فتفضَّلوا كَرَماً بوِصْلَةِ حبلِهِ","فلأَنتُمُ آياتُكُمْ لا تُجْحَدُ",59,"د",1,0],["فتفصحَ العينُ عن يقينٍ","يجلوْ بهِ كلُّ ما يريبُ",60,"ب",1,0],["فتفضل بسكر وكباش","كيفما شئت نقدة أو حواله",61,"ل",2,0],["فَتَفادَيتُم وَأَبقَت مِنكُمُ","ذَنَبِيّاتٍ كَذا يَبقى الشَرارُ",62,"ر",1,0],["فتفهم تعلم وجاهد تشاهد","يا مريدي ومن مزيديَ تُعطى",63,"ط",2,0],["فَتَفصِلُ مِسكَ تُبَّتَ دونَ لَبسٍ","مِنَ الحَتّيتِ جارِحَةُ الشَميمِ",64,"م",1,0],["فَتَفَضَّلْ وَكُنْ جَوَابَ كِتَابي","واعْصِ في اللَّهْوِ قَوْلَ كُلِّ نَصِيْحِ",65,"ح",1,0],["فتفل النبي قالوا ودعى","فزالت العلة عنهما معا",66,"ع",2,0]]}