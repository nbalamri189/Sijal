{"poems":[[55,"أعلى الغور تعرفت الخياما","https://www.aldiwan.net/poem29816.html","الرمل"],[55,"ومقبل كفي وددت بأنه","https://www.aldiwan.net/poem29878.html","الكامل"],[53,"ناشدتك الله أن تستفسد المننا","https://www.aldiwan.net/poem66517.html","البسيط"],[91,"خدعوها بقولهم حسناء","https://www.aldiwan.net/poem44939.html","الخفيف"],[87,"يا قلب ويحك والمودة ذمة","https://www.aldiwan.net/poem8110.html","الكامل"],[87,"خدعوها بقولهم حسناء","https://www.aldiwan.net/poem61201.html","عموديه"],[47,"أأفاق صب من هوى فأفيقا","https://www.aldiwan.net/poem65176.html","الطويل"],[76,"وظلام ليل لا شهاب بأفقه","https://www.aldiwan.net/poem13246.html","الكامل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[111,"جرد النفس وانهها عن هواها","https://www.poetsgate.com/ViewPoem.aspx?id=530",""],[92,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[113,"هجوعك بعد بينهم حرام","https://www.aldiwan.net/poem16261.html","الوافر"],[113,"أتدري ما حوى الشعب اليماني","https://www.aldiwan.net/poem16407.html","الوافر"],[128,"ما ذم شعرك إلا معشر سمج","https://www.aldiwan.net/poem23757.html","البسيط"],[190,"دنياي شر كلها","https://www.aldiwan.net/poem43835.html","مجزوء الكامل"],[215,"أموج البحر أسعفني فإني","https://www.aldiwan.net/poem46226.html","الوافر"],[266,"جور حكم الهوى يهين النفيسا","https://www.aldiwan.net/poem38256.html","الخفيف"],[276,"خطرت كغصن البانة المتأود","https://www.aldiwan.net/poem52072.html","الكامل"],[333,"هتف البحر بالعذارى فلبين","https://www.aldiwan.net/poem54984.html","الخفيف"],[353,"جاذبت نسمة الصباح ردائي","https://www.aldiwan.net/poem19823.html","الخفيف"],[387,"منع النوم ماوي التهمام","https://www.aldiwan.net/poem433.html",""],[422,"بلغ الشوق لعمري ما أراد","https://www.aldiwan.net/poem53890.html","الرمل"],[435,"وافى يطوف بشمس كاسه","https://www.aldiwan.net/poem40239.html","مجزوء الكامل"],[435,"أبدا وصد حيا براسه","https://www.aldiwan.net/poem40269.html","مجزوء الكامل"],[438,"طار عن برقة برق فشم","https://www.aldiwan.net/poem12350.html","الرمل"],[453,"تهادت أهيل الأبرقين المراحل","https://www.aldiwan.net/poem53690.html","الطويل"],[463,"أيوما مثل يوم الجزع","https://www.aldiwan.net/poem55890.html","مجزوء الوافر"],[463,"يا قلب من أين على فترة","https://www.aldiwan.net/poem56272.html","السريع"],[469,"ما للمطايا تكثر الحنينا","https://www.aldiwan.net/poem3574.html","عموديه"],[484,"الخفيف","https://www.aldiwan.net/poem36924.html","الخفيف"],[572,"من يبك من وجد على هالك","https://www.aldiwan.net/poem69768.html","السريع"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39045","السريع"],[790,"","https://poetry.dctabudhabi.ae/diwan/poem/142575","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63731","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70804","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59540","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59605","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59125","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96679","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64898","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122086","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79861","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125365","الخفيف"],[2029,"","https://poetry.dctabudhabi.ae/diwan/poem/123705","الكامل"],[2129,"","https://poetry.dctabudhabi.ae/diwan/poem/111094","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53062","الكامل"],[2447,"","https://poetry.dctabudhabi.ae/diwan/poem/198713","المنسرح"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106996","الرجز"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106977","الكامل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87685","المجتث"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201742","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74296","الكامل"],[3526,"","https://poetry.dctabudhabi.ae/diwan/poem/76586","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110022","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117894","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131261",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36273","الدوبيت"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36531","الدوبيت"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90965","الرمل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136574",""],[4729,"جَاذِبِ العيسَ نُسوعاً وزَماما","https://www.poetsgate.com/ViewPoem.aspx?id=109474",""],[4830,"حَوالِكُ النأي","https://www.poetsgate.com/ViewPoem.aspx?id=211128",""],[4942,"ساحر","https://www.poetsgate.com/ViewPoem.aspx?id=188681",""],[5022,"البردة المالكية","https://www.poetsgate.com/ViewPoem.aspx?id=186512",""],[5183,"ملْغِزَة (2)","https://www.poetsgate.com/ViewPoem.aspx?id=186411",""],[5183,"الحسناء","https://www.poetsgate.com/ViewPoem.aspx?id=186492",""],[5183,"الزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=186596",""],[5183,"روضة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=180198",""],[5183,"خميلة الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=185682",""],[5186,"جاذبتها حلو أطراف الحديث، وقد","https://www.poetsgate.com/ViewPoem.aspx?id=156519",""],[5191,"فتمنّعا","https://www.poetsgate.com/ViewPoem.aspx?id=212454",""],[5277,"قطرة ندى","https://www.poetsgate.com/ViewPoem.aspx?id=185338",""],[5277,"شيء من التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=191291",""],[592,"ألا حدثاني بالأمور الحوادث","https://www.poetsgate.com/ViewPoem.aspx?id=128835",""],[5401,"من هيرتز الموجات","https://www.poetsgate.com/ViewPoem.aspx?id=85370",""],[463,"نظرة ٌ منكِ ويومٌ بالجريبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59977&r=&rc=33",""]],"verses":[["جاذَبَت فُرسانَها أَعناقَها","كُلَّما نَهنَهنَ طالَبنَ أَماما",0,"م",2,0],["جاذَبتُهُ فَضلَ العِتابِ وَبَينَنا","كِبَرُ المَلولِ وَرِقَّةُ المَملولِ",1,"ل",1,0],["جاذَبتَني الحبلَ حتى كدت تصرِمُه","عن غير جُرم فصادفتَ امرأً طبِنا",2,"ن",2,0],["جاذبتني ثوبي العصى وقالت","ببكاء وهل يفيد البكاء",3,"ا",2,0],["جاذَبتَني جَنبي عَشِيَّةَ نَعيِهِ","وَخَفَقتَ خَفقَةَ موجَعٍ أَوّاهِ",4,"ا",2,0],["جاذَبَتني ثَوبي العصِيَّ وَقالَت","أَنتُمُ الناسُ أَيُّها الشُعَراءُ",5,"ا",2,0],["جاذَبتَهُ فُضُلَ الحَياةِ فَأَفلَتَت","مِن كَفِّهِ قَمَناً بِذاكَ حَقيقا",6,"ق",2,0],["جاذَبتُهُ فَضلَ العِنانِ وَقَد طَغى","فَاِنصاعَ يَنسابُ اِنسِيابَ الأَرقَمِ",7,"م",1,0],["جاذَبتُهُ صافي أَديمِ هَجيرِهِ","وَاليَعمَلاتُ شَواحِبُ الأَعضادِ",8,"د",1,0],["جاذبي كفة الحبالة فالحا","بل موف بمدية قد نضاها",9,"ا",3,0],["جاذبنه فضل الحياة فقصّرت","منه وما قصُرت فضول رادئه",10,"ا",2,0],["جآذر غَير أَنَهُمُ رُماةٌ","سِهامك مِن لَواحظها السِهام",11,"م",1,0],["جَآذر دونَها الآساد صَرعى","بِسحر لِحاظها لا بِالطِعانِ",12,"ن",1,0],["جآذر الحي من غسان ليس لنا","عند انتجاع الهوى عنكن منتهج",13,"ج",1,0],["جاذبتها فتعذرت","فغذرتها والدهر أعذر",14,"ر",1,0],["جآذر ثبج الأمواج ملعبهم","وهن أشبه لطفا بالعصافير",15,"ر",1,0],["جاذب جوده إليه بآمالي","حتى حسبته مغنطيسا",16,"س",2,0],["جاذبتها طرف العتاب فأعرضت","عني وَقالَت ما أَراكَ بمسعدي",17,"د",2,0],["جاذبتها من لهفتي واحتراقي","صرخات مجنونة سكرانه",18,"ن",2,0],["جَاذَبَتْ نَسْمَةُ الصَّباحِ رِدائي","عَبَثاً جَدَّ في الهوى مِنهُ دَائي",19,"ا",2,1],["جاذِياتٌ عَلى السَنابِكِ قَد أَف","زَعَهُنَّ الإِسراجُ وَالإِلجامُ",20,"م",1,0],["جاذَبوا العَلياءَ فانقادت لهم","يوم قادوها من الخيل جيادا",21,"د",2,0],["جاذبته بيد الهوى","حتى غدوت أعز ناسه",22,"س",2,0],["جاذبته بيد الهوى","حتى غدوت أغرناسه",23,"س",2,0],["جاذَبَ الأَحْدَاجَ أَطرافَ البُرَى","فاستجارَتْ بالرَّسِيمِ المِيسَمِ",24,"م",1,0],["جآذر حسن حازها دون سربها","برغمى من أيدى الفراق حبائل",25,"ل",1,0],["جآذر من ظباء الإن","س كنَّ دُمىً ولسنَ دمى",26,"م",2,0],["جاذبه الناسُ يرومونَهُ","دهراً فلم يعلَقْ به جاذبُ",27,"ب",1,0],["جاذبها الشوقُ وأنضاها الأسى","فخلّها تجاذب البرينا",28,"ن",2,0],["جاذبتني ثوب العصي وقالت","أتصابي ويلاه واستعصاء",29,"ا",2,0],["جاذبنيها رَشَأٌ أَغِيدٌ","فجاذَبَ النّفْسَ بها مُحْرَجَهْ",30,"ج",2,0],["جاذَبتُها ضَمّاً إلى أضْلُعي","أُطفئُ عَنْها لَوْعةَ الحُزْنِ",31,"ن",1,0],["جاذبَتْني الهوى بهمسة أجفان تجيد الإعراب والإفصاحا","عن فتون الدلال، عن سطوة الحسن، وعن خافق سَبَتْه فناحا",32,"ح",2,0],["جاذبَ الخصرَ ردفُهُ إِنَّ مِنْ أَحْ","سنِ شيءٍ ردفٌ يُجاذِبُ خصرا",33,"ر",2,0],["جآذر إلا أنهن أوانس","من البيض حُمْر الحلي سودُ الغدائرِ",34,"ر",1,0],["جاذبت مَن لا ينثني","ودعوتُ من لا يستجيب",35,"ب",1,0],["جاذبتُ أعطاف المسوح كأنها","جنح الدُّجى يُهديك بدر سعود",36,"د",1,0],["جَاذِرُ تَصْطَادُ الأسُودَ حِبَالُهَا","وَيَا كَيْفَ تَصْطَادُ الأسُودَ الجَآذِرُ",37,"ر",1,0],["جآذرُ إِلّا إنّما هنّ خرّدٌ","ربايب أنسٍ لم يرعهنّ رايعُ",38,"ع",1,0],["جاذَبْتهُ أَطَرافَ كلِّ طَريفةٍ","في العَتْبِ لم تَنْفَقْ بسُوقِ نِفاقِ",39,"ق",1,0],["جَاذِعٌ أَنْفَ كُلِّ قِرْنٍ مُعَادٍ","بِالطِعَانِ الدِّرَاكِ أَعْظَمَ جَدْعِ",40,"ع",1,0],["جاذبتُها فضلَ الرداءِ فأقبلت","بالعُنف تجمعُ ما جذبتُ وأرفق",41,"ق",1,0],["جاذِباً نحوَهُ النفوسَ بفضلٍ","وحنانٍ يدعو إلى الإذعانِ",42,"ن",1,0],["جاذبته حسن الحديث وجدته","من كل معنى باللطافة مكتفي",43,"ف",2,0],["جآذر يمشين الهوينا تلفتا","ينادين بالأهواء في السر والجهر",44,"ر",1,0],["جاذبته فتأرجت أبراده","ولحظته فتضرجت وجناته",45,"ت",2,0],["جاذبته الحبل فاستقاد وكم","جريت جري الجموح في الطلق",46,"ق",1,0],["جاذبتها فضل البرى فانبعثت","تعتسف الرمل وسيرها رمل",47,"ل",1,0],["جاذبته فضل العتاب وخذه","بأديمه طل الحيا يترشح",48,"ح",1,0],["جَآذرَ الرَمل أَنتنَّ","الباعِثاتُ لِحيني",49,"ي",1,0],["جاذبي بالجمال مُغرىً بردّي","عجباً لاجتماع دفع وجذب",50,"ب",1,0],["جاذبته فَتوردت وَجناته","خَجلاً وَكانَت قَبل ذَلِك جَوهَرا",51,"ر",2,0],["جاذبتُها طَرَفَ الحَديثِ وَرُبّما","شاطَرتُها لَحظِي لانظُرَ في الكَحَل",52,"ل",1,0],["جاذَبتَ بالذَنب الذي","لك وَهوَ مَعنَى سُوءِ رآئك",53,"ك",1,0],["جاذبتها ملح الهوى وبثثتها","شكوى الغرام وحرّه المتوهّج",54,"ج",1,0],["جاذبنني هدب الحديث عشيةً","وحديثهن كما علمت شجون",55,"ن",1,0],["جاذِبٌ للقَلبِ الحَدِيدِ بِمِغنا","طِيسِ طَبعٍ تُنسَى بِهِ الأقرِباءُ",56,"ا",2,0],["جاذَبتُ يَدَ الحَبيبِ إِذ جاذَبَني","واِختَرتُ عِتابَهُ كَما عاتَبَني",57,"ي",1,1],["جاذبت عَنانَها لَدى التَوديعِ","أَبكي وَأَحِنُّ ساعَةَ التَشييعِ",58,"ع",1,1],["جاذبته يد قيسون إلى","أحمر الكبريت حتما فانجذب",59,"ب",1,0],["جاذبته للعِّز آباؤه الصِيد","وقد قادَه الهوى للخُضوع",60,"ع",1,0],["جَاذِبِ العيسَ نُسوعاً وزَماما","إنْ تَعرضنَ فَنَاوَشَن البَشَاما",61,"م",2,1],["جاذبَتْني جوامحُ الدّهر هجراً","خامرَ القلبَ في هواكَ ظُنونُ",62,"ن",1,0],["جاذبته طرف الحدي","ثِ وما علمت بما حدث",63,"ث",1,0],["جآذر كشفت خمرا على لِمم","نفثن في عقد تبغي به لمَمي",64,"م",2,1],["جاذبتني والهوى يجذبها","فتلوى خصرها لياً عليْ",65,"ي",1,1],["جاذبتني الحسناء ثوبي غراما","فتدافعت إثرها أترامى",66,"م",2,1],["جاذبتني نياطها الزوراء","ودعتني إلى الهوى عفراء",67,"ا",2,1],["جاذبتهم ثم أطراف الحديث به","فلم أفق من تعاطي أكؤس الأدب",68,"ب",1,0],["جاذبته ثني العنان على المدى","فأبان تجربتي عن الألماس",69,"س",1,0],["جاذبتها حلو أطراف الحديث، وقد","أولتني الفضل، يوم الوصل، والنعما",70,"م",2,1],["جاذبتُهُ حلوَ الهوى، فَتَمنّعا","رشأ يصدّ البدرَ ألّا يطلعا",71,"ع",2,1],["جاذبتُها بيدي فاستعصمتْ هربا","كأنّها ظبيةٌ تعدو بغيرِ هدى",72,"د",2,0],["جاذبتها طرفَ الحديثِ بنشوةٍ","خضراءَ تقربُ للضجيجِ بهمسِها",73,"س",3,0],["جآذرها ما هاجها قط هائج","فأزعجها فدح أتى بالحراكث",74,"ث",1,0],["جاذبتها من ريهجان العد لو ينضح نضيح","غربٍ سقى غرس الضمير اللي هشيم زراعته",75,"ت",2,0],["جاذبَ الرواضَ عن مقودهِ","مرسٌ تنكرهُ كفُّ الجذيبِ",76,"ب",1,0]]}