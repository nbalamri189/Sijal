غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[135,"اليوم أوفت على خمس وعشرينا","https://www.aldiwan.net/poem49192.html","البسيط"],[143,"سل عن فضائلك الزمان لتخبرا","https://www.aldiwan.net/poem11760.html","الكامل"],[150,"ضعوا فوق قلبي راحة الصبر إنني","https://www.aldiwan.net/poem68562.html","الطويل"],[164,"أماطت لثاما عن أقاح الدمائث","https://www.aldiwan.net/poem67812.html","الطويل"],[164,"ضمان أن يكنف مذ تولى","https://www.aldiwan.net/poem67863.html","الوافر"],[181,"ألا حييا الأطلال بالجرع العفر","https://www.aldiwan.net/poem59043.html","الطويل"],[182,"يا أربع الخيف يسقي الماء واديها","https://www.aldiwan.net/poem67024.html","البسيط"],[186,"إن الخطوب سقيني","https://www.aldiwan.net/poem43215.html","مجزوء الكامل"],[186,"طالعت نجمي بالحساب","https://www.aldiwan.net/poem43474.html","مجزوء الكامل"],[199,"ضنت وما أنا لو تشاء ضنين","https://www.aldiwan.net/poem45348.html","الكامل"],[225,"أَيصيخ لي الملك الهمام قليلا","https://www.aldiwan.net/poem55085.html","الكامل"],[235,"إلام أكتم فضلا ليس ينكتم","https://www.aldiwan.net/poem31760.html","البسيط"],[235,"جد بقلبي ومزح","https://www.aldiwan.net/poem32108.html","مجزوء الرجز"],[250,"ضننت على نفسي وقد كنت قادرا","https://www.aldiwan.net/poem15068.html","الطويل"],[261,"هو المجد ما يقظانه مثل نائم","https://www.aldiwan.net/poem38191.html","الطويل"],[275,"ضن السماح عليه بالترحال","https://www.aldiwan.net/poem25539.html","الكامل"],[297,"لقد آن أن تثني أبي زمامها","https://www.aldiwan.net/poem33176.html","الطويل"],[298,"إن كان باليمن هذا اليوم قد سنحا","https://www.aldiwan.net/poem36252.html","عموديه"],[305,"خطب عيون الدين منه ثجوجه","https://www.aldiwan.net/poem56586.html","الكامل"],[320,"محمود در في سلوك من ذهب","https://www.aldiwan.net/poem67145.html","الكامل"],[356,"زارت وليل غطمطم الظلما دجا","https://www.aldiwan.net/poem24535.html","الكامل"],[409,"وإني لعصاء العواذل لا أرى","https://www.aldiwan.net/poem32065.html","الطويل"],[409,"يا ناق شطت دارهم فحني","https://www.aldiwan.net/poem32367.html","الرجز"],[437,"قف العيس هذا ربع سلمى فسلم","https://www.aldiwan.net/poem2538.html","الطويل"],[443,"عيسى بنطق المدح حتى لو أنه","https://www.aldiwan.net/poem55959.html","عموديه"],[458,"ضنا بأن يعلم الناس الهوى لمن","https://www.aldiwan.net/poem55861.html","البسيط"],[458,"متى وصلت تحية مستهامِ","https://www.aldiwan.net/poem55870.html","الوافر"],[458,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[458,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[461,"ما طاب شيء في الزمان لسامع","https://www.aldiwan.net/poem15678.html","الكامل"],[464,"سري وعقود الأفق منثالة النظم","https://www.aldiwan.net/poem3173.html","عموديه"],[464,"ما للمطايا تكثر الحنينا","https://www.aldiwan.net/poem3574.html","عموديه"],[468,"صب جوارحه للسقم أوطان","https://www.aldiwan.net/poem59569.html","البسيط"],[470,"ضنت عقيلة لما جئت بالزاد","https://www.aldiwan.net/poem4672.html","البسيط"],[477,"ماذا تسائل من نؤي وأوتاد","https://www.aldiwan.net/poem15209.html","البسيط"],[477,"كم رضت جامح قلبي عنكم فأبى","https://www.aldiwan.net/poem15242.html","البسيط"],[506,"يا زائرا لم يقض أن ألقاه","https://www.aldiwan.net/poem2374.html","الكامل"],[538,"ضنت بهذا اليوم قبل عصور","https://www.aldiwan.net/poem48154.html","عموديه"],[551,"ضن عني بالنزر إذ أنا يقظا","https://www.aldiwan.net/poem47194.html","الخفيف"],[551,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[551,"ضنت عليك ضنينة الخدر","https://www.aldiwan.net/poem47786.html","أحذ الكامل"],[551,"ضنت عليك بوصلها لك زينب","https://www.aldiwan.net/poem48104.html","الكامل"],[558,"ضرري نفع حاسدي بالنقيض","https://www.aldiwan.net/poem33545.html","الخفيف"],[558,"ضل الذي عن ضوء شمسك يعرض","https://www.aldiwan.net/poem34418.html","الكامل"],[567,"ويلاه من قلبي ومن كبدي","https://www.aldiwan.net/poem69717.html","السريع"],[575,"لا أجازى حبيب قلبي بجرمه","https://www.aldiwan.net/poem2856.html","الخفيف"],[575,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"],[575,"ما ضر من أهدى إلي الخيال","https://www.aldiwan.net/poem3039.html","السريع"],[575,"تنزه طرفي بين زاه وزاهر","https://www.aldiwan.net/poem3073.html","الطويل"]],"verses":[["ضَنينٌ بِوَدّي لا يَزالُ بِوَجهِهِ","كَلامُ العِدى عَنّي وَنَفثُ النَوافِثِ",0,"ث",1,0],["ضَنَّ الطَبيبُ عَلى المَري","ضِ المُبتَلى بِدَوائِهِ",1,"ا",3,1],["ضَنّ برَجْعِ الطّرْفِ يوْمَ النّوى","هَلاّ رَعَى عهْدِي كَما أرْعى",2,"ع",2,0],["ضَنَيتُ بِهِ حتّى رَثَت لي عَواذِلي","وَرَقَّ لِما أَلقى العَدوُّ المُناصِبُ",3,"ب",1,0],["ضَنينٌ بِبَذلِ السِرِّ سَمحٌ بِغَيرِهِ","أَخو ثِقَةٍ عَفُّ الوِصالِ سَمَيدَعُ",4,"ع",1,0],["ضَنينَةُ جَفنِ العَينِ بِالمآءِ كُلَّما","تَضَرَّجَ مِن هَجمِ الهَواجِرِ جيدُها",5,"د",3,0],["ضَنْكُ المعيشة أضوى جسمها فبدت","شروى خيال بطرق العين ملموح",6,"ح",1,0],["ضَنَّت بِمَورِدَةٍ كانَت لَنا شَرَعاً","تَشفي صَدى مُستَهامِ القَلبِ صَديانا",7,"ن",2,0],["ضنيت والدَّمع ملءُ جفني","فلا تراني ولا أراها",8,"ه",2,0],["ضنيت والدمع ملء جفني","فما تراني ولا أراها",9,"ه",2,0],["ضنَّ بك الدهرُ عن حوادثِهِ","فأنت مأمولُهُ ومرتَقبُهْ",10,"ب",2,0],["ضَنْكاً إذا زُرَّتْ عليك زُرُورُه","ضاق الخناق فلم يَسَعْكَ بلادُ",11,"د",1,0],["ضَنَّت بماء العيش لكنها","من يقتَبسْ نار الجوى تُقبِس",12,"س",1,0],["ضَنيتُ مِنَ الهَوى وَشَقيتُ مِنهُ","وَأَنتَ تُجيبُ كُلَّ هَوىً دَعاكا",13,"ك",2,0],["ضنا بمائك أن يسقى الصعيد به","ورب حرص على الأشياء يؤذيها",14,"ي",3,0],["ضَنّوا بِعِرضِكِ أَن يُباعَ وَيُشتَرى","عِرضُ الحَرائِرِ لَيسَ فيهِ سُوامُ",15,"م",1,0],["ضَنّوا بِضائِعِ حَقِّهِم","وَضَنَنتَ بِالدُنيا الغَرور",16,"ر",1,0],["ضَنىً في الهَوى كَالسُمِّ في الشَهدِ كامِناً","لَذِذتُ بِهِ جَهلاً وَفي اللَذَّةِ الحَتفُ",17,"ف",1,0],["ضناً بسر الله في أرضه","وخفية للفتن الثائره",18,"ر",2,0],["ضنَّتْ لِثاتُكِ للثراءِ ولم تَرَيْ","نُخَبَ الثناءِ معوضةَ المعتاضِ",19,"ض",1,0],["ضَنْكُ المعارج في مدارجِ كيدِه","يهفو بمنْبَتِّ القُوى مُنهاضِ",19,"ض",1,0],["ضَنْكٍ إذا جَلَتِ السُّيوفُ قَناتَه","رَفَعَتْ حوافِزُهُ ظَلاماً مُغْدِفا",20,"ف",2,0],["ضَنَّ السَحابُ بِمائِهِ فَرَوَت","كَفُّ اِبنِ أُرتُقَ غُلَّةَ الأَرضِ",21,"ض",1,0],["ضَنكٍ إِذا خَرِسَت أَبطالُهُ نَطَقَت","فيهِ الصَوارِمُ وَالخَطِّيَةُ الذُبُلُ",22,"ل",1,0],["ضنَّ بالطيفِ يا أخيَّ وقدْ كا","نَ بطيبِ الوصالِ غيرَ ضنينِ",23,"ن",1,0],["ضَنَّت بِنائِلِها عَنّا فَقَد تَرَكَت","مِن غَيرِ ذَنبٍ أَبا الخَطّابِ مُختَلَجا",24,"ج",2,0],["ضَنَّت بِنائِلِها فَقُلتُ لِصاحِبي","ما كانَ أَكثَرَها لَنا وَأَقَلَّها",25,"ل",3,0],["ضِنُّوا بميراثِ الدُّهور وحَصِّنوا","شرفَ البنين وسُؤدُدَ الآباءِ",26,"ا",2,0],["ضنّتْ عليه بما يُريدُ وأَيقنتْ","أن سوف يتركها بلا أَوصالِ",27,"ل",1,0],["ضَنّت بِصِبيَتِها وَرَونَقِ وَجهِها","فَتَحَدَّرَت عَبَراتُها تَنساحُ",28,"ح",1,0],["ضَنّ الخبيثُ بِمُلكِهِ وغَداً يرى","يد غَيْرِه في مُلْكِهِ تتصرَّفُ",29,"ف",1,0],["ضَنَنْتَ بأُمِّ الحَيِّ تُغْلِي فِدَاءَها","فَيَا لَكَ رأياً غَيرُهُ كانَ أجْدَرَا",30,"ر",2,0],["ضَنَّ عَنّي فَلَم يَضِرني حَسودي","وَحَباني رَبٌّ عَلِيٌّ سَخِيُّ",31,"ي",1,0],["ضَنَّت شُرَيرُ بِوَصلِها وَلَطالَما","لَعِبَت مَواعِدُها بِكُلِّ غَريمِ",32,"م",1,0],["ضَنَّ أَخي عُكلٍ عَلى عَطائِهِ","يَبيعُ بِاِسمِ اللَهِ في أَشلائِهِ",33,"ا",3,0],["ضَنَّت عُبَيدَةُ بِالتَسليمِ فَاِحتَجَبَت","فَهَيَّجَت دَمعَ عَينٍ كانَ قَد جَمَدا",34,"د",2,0],["ضَنَّت بِخَدٍّ وَجَلَت عَن خَدِّ","ثُمَّ اِنثَنَت كَالنَفسِ المُرتَدِّ",35,"د",1,0],["ضَنَّت يَداهُ وَتِلكَ مِنهُ سَجيَّةٌ","أَن تُجرِيا أَحَداً عَلى الإيثارِ",36,"ر",1,0],["ضننتُ بها ضنَّ معتزَّةٍ","وتحت الوسادة أودعتُها",37,"ه",2,0],["ضَنَّ بالقطرة منها وكذا شرعُ الولاءِ","ومضى جيلٌ وجيلٌ وهو مشبوبُ الدماءِ",38,"ا",2,0],["ضَنّ بها رَبُّها لضِنَّتِها","به وكم ضِنَّةٍ من الكَرَم",39,"م",1,0],["ضَنَنتَ بالذهَبِ ابن التربِ تمنَعهُ","عنه وجاءك بالأفلاك يهديها",40,"ي",3,0],["ضَنىً كانَ أَبداهُ الهَوى فَأَعادَهُ","سَوادٌ بَدا في حمرَةٍ وَبَياضِ",41,"ض",1,1],["ضننتُ بِسُلواني وَجُدتُ بِمُهجَتي","فَهَل أَنتَ عَن فِعلِ المُتَيَّمِ راضِ",41,"ض",1,0],["ضننتُ به فلم يهتِف بعمرٍو","ولم تستهوهِ بَسَماتُ سُعدَى",42,"د",2,0],["ضَنْتُ به وجُدتُ له بنفسي","وإنّ الحبَّ تبذيرٌ وبُخل",43,"ل",1,0],["ضَنْكُ المسَفَّةِ يَدَّني عَطَشاً","وتَموُّجُ الآذيِّ يُبعِده",44,"د",2,0],["ضنكُ المنافذِ لا مكانَ به","لمَسَرَةٍ واليومَ ينتشر",45,"ر",1,0],["ضنّت الشام بالوفاء علينا","طلعة سمحة وودّ بخيل",46,"ل",1,0],["ضَنْنتُ به وجُدتُ له بنفسي","وإنّ الحبَّ تبذيرٌ وبُخل",47,"ل",1,0],["ضَنَّتْ بِنَائِلِها هِنْدٌ فَقَدْ تَرَكَتْ","مِنْ غَيْرِ ذنبٍ أبَاالخَطَّابِ مُخْتَلَجا",48,"ج",2,0],["ضننت باسمك حتى لا تدنسه","أفواه ذي الناس أن الناس ديدان",49,"ن",1,0],["ضَنّوا على مُعْوِزيهم بالقليل فلم","يصّدقوا غير ألفٍ أو يزيدونا",50,"ن",2,0],["ضَنّاً بِمَن يَغشى الوَغى مُتَبَرِّجاً","غِرّاً وإِن وَهَبَ الجَزيلَ تَسَتَّرا",51,"ر",2,0],["ضنِيتُ بِحُبٍّ لَيسَ يَعدوكَ لحظَةً","لأصبحتُ وَقفاً لا أجِيءُ ولا أمضي",52,"ض",2,0],["ضَنِيتُ بِسرِّي عَن نَواكَ ورُبَّما","خَرَجتُ إلى بَعضٍ بِسرِّكَ عَن بَعضِ",52,"ض",1,0],["ضَنَنتَ بِهِ حَيّاً وَبُؤتَ بِإِصرِهِ","وَقَد آضَ نَهباً بَينَ أَيدٍ قَواعِثِ",53,"ث",1,0],["ضَنيتُ وَكَيفَ لا يَضنى مُحِبٌّ","يُشَرِّدُ نَومَهُ دَمعٌ يَفيضُ",54,"ض",1,0],["ضِناكِ مَلاثِ المِرطِ مَمكورةِ الحَشا","بَعِيدَةِ مَهوَى القُرطِ مَهضومَةِ الخَصر",55,"ر",1,0],["ضَنىً وَوَجدٌ وَسَهدٌ بي وَحُرُّ صَدَىً","وَصَبوَةُ حَتفِ صَبٍّ مِن مَجانيها",56,"ي",3,0],["ضنّوا بما حوت الأكفّ","واقصروا من بسطهنّه",57,"ن",2,0],["ضنك المنالة ما يني","ل لهى فمي بندى نواله",58,"ل",2,0],["ضنتْ وما أنا لو تشاءُ ضنينُ","والبخلُ إلا في الحسانِ يشينُ",59,"ن",1,1],["ضَنّاً بِبَيتِ محمّدٍ أن يَغتَدي","بِسِوى بِنَيهِ بني العلا مَأهولا",60,"ل",2,0],["ضَنَّت عَلَيَّ بِزورٍ مِن مَواعِدِها","فَجادَ مِن غَيرِ ميعادٍ بِها الحُلمُ",61,"م",1,0],["ضَنَّ فَما يَسمَحُ بِال","وَصلِ وَلَو شاءَ سَمَح",62,"ح",1,0],["ضننتُ على نفسي وقد كنتُ قادراً","فدعني إلى أن يَقضي اللَه ما يقضي",63,"ي",1,1],["ضننت بها إلا لمجدك انها","الى خير مخدوم هدية خادم",64,"م",1,0],["ضَنّ السَّمَاحُ عَلَيْه بِالتَّرحالِ","وأفَادَهُ الإحْسَانُ حُسْنَ الحَالِ",65,"ل",1,1],["ضننتُ بها عن كُلِّ سمعٍ وإنَّما","مديحُك كانَ اليومَ فضُّ خِتامها",66,"م",3,0],["ضنّوا عليهمْ (بعمان) ودمنتها","كأنَّ واعدهمْ في وعده مزحا",67,"ح",2,0],["ضنكٌ بِدُنيانا معاشُ جميعنا","لكن نُحاولُ بالمنى تمزيجه",68,"ج",2,0],["ضَنَّ الزَمانُ وَقَد يَضِنُّ بِمِثلِهِ","خَلقاً وَأَخلاقاً وَعِلماً وَأَدَب",69,"ب",1,0],["ضنت بنائلها كما ضن الزما","ن بوصل بابٍ بابه لن يرتجا",70,"ج",2,0],["ضنينٌ بمن صاحبتُ أحسَبُ أنَّه","إذا بانَ لا ألقى له أبداً مِثْلا",71,"ل",2,0],["ضَنّا بِهم عن أَنْ يطورَ ذكْرُهُم","بمَسْمَعٍ وَهُمْ مكانُ الضّنّ",72,"ن",1,0],["ضننتم بتكليم وقد خالط الهوى","هواكم أضاميم الفؤاد المكلم",73,"م",1,0],["ضنين بلفظ الشكر يحسب انه","إذا جاد بالشين استفاضت مواهبه",74,"ه",1,0],["ضنًّاً بأن يعلم الناسُ الهوى لمَنِ","وهبتُ للسرِّ فيه لذّةَ العلنِ",75,"ن",1,1],["ضننتَ بقطرةٍ من ماء وجهٍ","إذا القطراتُ دامت فهو دامي",76,"ي",1,0],["ضنَّت عليك يَقظَي","وسمحَتْ في الحُلْمِ",77,"م",1,0],["ضنَّتْ بجوهرها وما في حِرْزِها","من مُنفساتِ ذخائرٍ وفوائدِ",78,"د",1,0],["ضنْكُ الجوانح بالهضميةِ مُحرج","واذا حَلُمْت فان صدرك سبْسبُ",79,"ب",1,0],["ضنينٌ على قلبي بصحّة وعده","جوادٌ بسقم المقلتين على جسمي",80,"م",2,0],["ضنينةٌ بالحسن أعدتْ خلقي","فصرتُ من وجدي بها ضنيناً",81,"ن",2,0],["ضَنَّت عَلَيهِ بِنُعماها مُنَّعَمَةٌ","أَجفانُها لِظُبى الأَلحاظِ أَجفانُ",82,"ن",1,0],["ضَنَّت عَقيلَةُ لَمّا جِئتُ بِالزّادِ","وَآثَرَت حاجَةَ الثاوي عَلى الغادي",83,"د",2,1],["ضنتْ بقربي وقد كانتْ تجودُ بهِ","تَبَرُّعاً قبلَ اِقصائي واِبعادي",84,"ي",1,0],["ضنَّتْ بزُوْرِ مواعيدٍ تريحُ بها","قلباً اليها على علاّتِها انجذبا",85,"ب",2,0],["ضنّ الزمان وقد سمحت فلم يكن","من زرته للحين من معناه",86,"ا",2,0],["ضَنَّت بهذا اليومِ قبلُ عُصورُ","حتى أتَى مَلِكُ الورَى المَنصورُ",87,"ر",1,1],["ضنَّ عنّي بالنَّزرِ إذْ أنا يقظا","نُ وأعطى قليلَه في مَنامي",88,"م",2,1],["ضنّوا عليك من النّدى بقليله","وكثيرُ حبّك عندهمْ وقليلُهُ",89,"ل",2,0],["ضَنّتْ عليك ضنينةُ الخِدْرِ","يومَ الوداع بطلعة البدرِ",90,"ر",1,1],["ضَنَّتْ عَليك بِوَصْلها لكَ زينبُ","وَطلبتَ لمّا عزَّ منها المطلبُ",91,"ب",1,1],["ضنك عيش لجاهل ليس يدري","ما درينا والعيش عيش النهيض",92,"ض",1,0],["ضنَّ العليم بك الحكيم على السوى","وإليك كلٌّ بالجوى يتعرض",93,"ض",1,0],["ضَنّتْ بموعدِهَا فقلتُ لها","يا هذه فعِدي بأنْ تَعِدي",94,"د",2,0],["ضنَّ عني بريقه فتحيَّل","تُ إِلى أَنْ سَرقْتُه عِنْد لَثْمِهْ",95,"م",2,0],["ضنَّت بطَرْفِ ظلَّ بعدي سُقْمُهُ","أَرأَيتمُ من ضنَّ حتَّى بالضَّنَى",96,"ن",2,0],["ضننتُم من بعد جودٍ فيا","قبحَ انفصالٍ بَعْد حسنِ اتِّصال",97,"ل",1,0],["ضَنيتُ به حتَّى ظننتُ بأَنَّني","غداةَ اعْتَنقنا شعرةً في ضَفَائِر",98,"ر",1,0]]}