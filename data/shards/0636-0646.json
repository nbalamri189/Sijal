""],[475,"ضَنَّتْ عَقِيلَة ُ لَمَّا جِئْتُ بِالزَّادِ","https://www.poetsgate.com/ViewPoem.aspx?id=20531",""],[5545,"قيد التلاعب","https://www.poetsgate.com/ViewPoem.aspx?id=195407",""],[5573,"واوٌ وباءٌ وكافٌ وتاء - (وبكت)","https://www.poetsgate.com/ViewPoem.aspx?id=204564",""],[2110,"ضوء الأهلة أم برق الحمى ومضا","https://www.poetsgate.com/ViewPoem.aspx?id=156277",""],[5648,"صباحك غير","https://www.poetsgate.com/ViewPoem.aspx?id=155670",""],[5956,"نلملمُ أشلاءنا","https://www.poetsgate.com/ViewPoem.aspx?id=192808",""],[6035,"كم كان أَعْدَل لو أَزْرَى بنا الحَجرُ .. !","https://www.poetsgate.com/ViewPoem.aspx?id=177617",""],[6127,"أبى الليل","https://www.poetsgate.com/ViewPoem.aspx?id=190758",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6185,"حاولت ريّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86944&r=&rc=4",""],[231,"الشاعر في وادي الموتى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79142&r=&rc=17",""],[463,"هل تحت ليلك بالغضا من رائد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60040&r=&rc=96",""],[572,"وَيْلاهُ من قلبي ومن كبدِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9239&r=&rc=96",""]],"verses":[["ضَنينٌ بِوَدّي لا يَزالُ بِوَجهِهِ","كَلامُ العِدى عَنّي وَنَفثُ النَوافِثِ",0,"ث",1,0],["ضَنَّ الطَبيبُ عَلى المَري","ضِ المُبتَلى بِدَوائِهِ",1,"ا",3,1],["ضَنّ برَجْعِ الطّرْفِ يوْمَ النّوى","هَلاّ رَعَى عهْدِي كَما أرْعى",2,"ع",2,0],["ضَنَيتُ بِهِ حتّى رَثَت لي عَواذِلي","وَرَقَّ لِما أَلقى العَدوُّ المُناصِبُ",3,"ب",1,0],["ضَنينٌ بِبَذلِ السِرِّ سَمحٌ بِغَيرِهِ","أَخو ثِقَةٍ عَفُّ الوِصالِ سَمَيدَعُ",4,"ع",1,0],["ضَنينَةُ جَفنِ العَينِ بِالمآءِ كُلَّما","تَضَرَّجَ مِن هَجمِ الهَواجِرِ جيدُها",5,"د",3,0],["ضَنْكُ المعيشة أضوى جسمها فبدت","شروى خيال بطرق العين ملموح",6,"ح",1,0],["ضَنَّت بِمَورِدَةٍ كانَت لَنا شَرَعاً","تَشفي صَدى مُستَهامِ القَلبِ صَديانا",7,"ن",2,0],["ضنيت والدَّمع ملءُ جفني","فلا تراني ولا أراها",8,"ه",2,0],["ضنيت والدمع ملء جفني","فما تراني ولا أراها",9,"ه",2,0],["ضنَّ بك الدهرُ عن حوادثِهِ","فأنت مأمولُهُ ومرتَقبُهْ",10,"ب",2,0],["ضَنْكاً إذا زُرَّتْ عليك زُرُورُه","ضاق الخناق فلم يَسَعْكَ بلادُ",11,"د",1,0],["ضَنَّت بماء العيش لكنها","من يقتَبسْ نار الجوى تُقبِس",12,"س",1,0],["ضَنيتُ مِنَ الهَوى وَشَقيتُ مِنهُ","وَأَنتَ تُجيبُ كُلَّ هَوىً دَعاكا",13,"ك",2,0],["ضنا بمائك أن يسقى الصعيد به","ورب حرص على الأشياء يؤذيها",14,"ي",3,0],["ضَنّوا بِعِرضِكِ أَن يُباعَ وَيُشتَرى","عِرضُ الحَرائِرِ لَيسَ فيهِ سُوامُ",15,"م",1,0],["ضَنّوا بِضائِعِ حَقِّهِم","وَضَنَنتَ بِالدُنيا الغَرور",16,"ر",1,0],["ضَنىً في الهَوى كَالسُمِّ في الشَهدِ كامِناً","لَذِذتُ بِهِ جَهلاً وَفي اللَذَّةِ الحَتفُ",17,"ف",1,0],["ضناً بسر الله في أرضه","وخفية للفتن الثائره",18,"ر",2,0],["ضنَّتْ لِثاتُكِ للثراءِ ولم تَرَيْ","نُخَبَ الثناءِ معوضةَ المعتاضِ",19,"ض",1,0],["ضَنْكُ المعارج في مدارجِ كيدِه","يهفو بمنْبَتِّ القُوى مُنهاضِ",19,"ض",1,0],["ضَنْكٍ إذا جَلَتِ السُّيوفُ قَناتَه","رَفَعَتْ حوافِزُهُ ظَلاماً مُغْدِفا",20,"ف",2,0],["ضَنَّ السَحابُ بِمائِهِ فَرَوَت","كَفُّ اِبنِ أُرتُقَ غُلَّةَ الأَرضِ",21,"ض",1,0],["ضَنكٍ إِذا خَرِسَت أَبطالُهُ نَطَقَت","فيهِ الصَوارِمُ وَالخَطِّيَةُ الذُبُلُ",22,"ل",1,0],["ضنَّ بالطيفِ يا أخيَّ وقدْ كا","نَ بطيبِ الوصالِ غيرَ ضنينِ",23,"ن",1,0],["ضَنَّت بِنائِلِها عَنّا فَقَد تَرَكَت","مِن غَيرِ ذَنبٍ أَبا الخَطّابِ مُختَلَجا",24,"ج",2,0],["ضَنَّت بِنائِلِها فَقُلتُ لِصاحِبي","ما كانَ أَكثَرَها لَنا وَأَقَلَّها",25,"ل",3,0],["ضِنُّوا بميراثِ الدُّهور وحَصِّنوا","شرفَ البنين وسُؤدُدَ الآباءِ",26,"ا",2,0],["ضنّتْ عليه بما يُريدُ وأَيقنتْ","أن سوف يتركها بلا أَوصالِ",27,"ل",1,0],["ضَنّت بِصِبيَتِها وَرَونَقِ وَجهِها","فَتَحَدَّرَت عَبَراتُها تَنساحُ",28,"ح",1,0],["ضَنّ الخبيثُ بِمُلكِهِ وغَداً يرى","يد غَيْرِه في مُلْكِهِ تتصرَّفُ",29,"ف",1,0],["ضَنَنْتَ بأُمِّ الحَيِّ تُغْلِي فِدَاءَها","فَيَا لَكَ رأياً غَيرُهُ كانَ أجْدَرَا",30,"ر",2,0],["ضَنَّ عَنّي فَلَم يَضِرني حَسودي","وَحَباني رَبٌّ عَلِيٌّ سَخِيُّ",31,"ي",1,0],["ضَنَّت شُرَيرُ بِوَصلِها وَلَطالَما","لَعِبَت مَواعِدُها بِكُلِّ غَريمِ",32,"م",1,0],["ضَنَّ أَخي عُكلٍ عَلى عَطائِهِ","يَبيعُ بِاِسمِ اللَهِ في أَشلائِهِ",33,"ا",3,0],["ضَنَّت عُبَيدَةُ بِالتَسليمِ فَاِحتَجَبَت","فَهَيَّجَت دَمعَ عَينٍ كانَ قَد جَمَدا",34,"د",2,0],["ضَنَّت بِخَدٍّ وَجَلَت عَن خَدِّ","ثُمَّ اِنثَنَت كَالنَفسِ المُرتَدِّ",35,"د",1,0],["ضَنَّت يَداهُ وَتِلكَ مِنهُ سَجيَّةٌ","أَن تُجرِيا أَحَداً عَلى الإيثارِ",36,"ر",1,0],["ضننتُ بها ضنَّ معتزَّةٍ","وتحت الوسادة أودعتُها",37,"ه",2,0],["ضَنَّ بالقطرة منها وكذا شرعُ الولاءِ","ومضى جيلٌ وجيلٌ وهو مشبوبُ الدماءِ",38,"ا",2,0],["ضَنّ بها رَبُّها لضِنَّتِها","به وكم ضِنَّةٍ من الكَرَم",39,"م",1,0],["ضَنَنتَ بالذهَبِ ابن التربِ تمنَعهُ","عنه وجاءك بالأفلاك يهديها",40,"ي",3,0],["ضَنىً كانَ أَبداهُ الهَوى فَأَعادَهُ","سَوادٌ بَدا في حمرَةٍ وَبَياضِ",41,"ض",1,1],["ضننتُ بِسُلواني وَجُدتُ بِمُهجَتي","فَهَل أَنتَ عَن فِعلِ المُتَيَّمِ راضِ",41,"ض",1,0],["ضننتُ به فلم يهتِف بعمرٍو","ولم تستهوهِ بَسَماتُ سُعدَى",42,"د",2,0],["ضَنْتُ به وجُدتُ له بنفسي","وإنّ الحبَّ تبذيرٌ وبُخل",43,"ل",1,0],["ضنائن الله أنتم لا يزال لكم","في نصرة الله صولات وسلطان",44,"ن",1,0],["ضَنْكُ المسَفَّةِ يَدَّني عَطَشاً","وتَموُّجُ الآذيِّ يُبعِده",45,"د",2,0],["ضنكُ المنافذِ لا مكانَ به","لمَسَرَةٍ واليومَ ينتشر",46,"ر",1,0],["ضنّت الشام بالوفاء علينا","طلعة سمحة وودّ بخيل",47,"ل",1,0],["ضَنْنتُ به وجُدتُ له بنفسي","وإنّ الحبَّ تبذيرٌ وبُخل",48,"ل",1,0],["ضَنَّتْ بِنَائِلِها هِنْدٌ فَقَدْ تَرَكَتْ","مِنْ غَيْرِ ذنبٍ أبَاالخَطَّابِ مُخْتَلَجا",49,"ج",2,0],["ضننت باسمك حتى لا تدنسه","أفواه ذي الناس أن الناس ديدان",50,"ن",1,0],["ضَنّوا على مُعْوِزيهم بالقليل فلم","يصّدقوا غير ألفٍ أو يزيدونا",51,"ن",2,0],["ضَنّاً بِمَن يَغشى الوَغى مُتَبَرِّجاً","غِرّاً وإِن وَهَبَ الجَزيلَ تَسَتَّرا",52,"ر",2,0],["ضنِيتُ بِحُبٍّ لَيسَ يَعدوكَ لحظَةً","لأصبحتُ وَقفاً لا أجِيءُ ولا أمضي",53,"ض",2,0],["ضَنِيتُ بِسرِّي عَن نَواكَ ورُبَّما","خَرَجتُ إلى بَعضٍ بِسرِّكَ عَن بَعضِ",53,"ض",1,0],["ضَنَنتَ بِهِ حَيّاً وَبُؤتَ بِإِصرِهِ","وَقَد آضَ نَهباً بَينَ أَيدٍ قَواعِثِ",54,"ث",1,0],["ضَنيتُ وَكَيفَ لا يَضنى مُحِبٌّ","يُشَرِّدُ نَومَهُ دَمعٌ يَفيضُ