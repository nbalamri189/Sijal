{"poems":[[53,"خذوا نفثات من جوى القلب نافث","https://www.aldiwan.net/poem30663.html","الكامل"],[55,"ضن الطبيب على المري","https://www.aldiwan.net/poem26549.html","مجزوء الكامل"],[77,"ما ضر لو سلم أو ودعا","https://www.aldiwan.net/poem35995.html","السريع"],[71,"حبيب نأى وهو القريب المصاقب","https://www.aldiwan.net/poem4021.html","الطويل"],[35,"تقطع من ظلامة الوصل أجمع","https://www.aldiwan.net/poem39137.html","الطويل"],[30,"ألا لا أرى كالدار بالزرق موقفا","https://www.aldiwan.net/poem29595.html","الطويل"],[88,"مرت تقول ألا يا رب خذ روحي","https://www.aldiwan.net/poem44460.html","البسيط"],[27,"بان الخليط ولو طوعت ما بانا","https://www.aldiwan.net/poem4432.html","البسيط"],[72,"أشكو جفا غادة عراني","https://www.aldiwan.net/poem18960.html","مخلع البسيط"],[72,"أشكو جفا غادة عراني","https://www.aldiwan.net/poem20521.html","مخلع البسيط"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[51,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[51,"ما رشأ الأنس بمستأنس","https://www.aldiwan.net/poem64702.html","الطويل"],[70,"نهاك عن الغواية ما نهاكا","https://www.aldiwan.net/poem42781.html","الوافر"],[85,"أعياد عزك للدنيا مجاليها","https://www.aldiwan.net/poem7533.html","البسيط"],[85,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[85,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[43,"لجنية أم غادة رفع السجف","https://www.aldiwan.net/poem9728.html","الطويل"],[62,"الحمد لله الذي خصنا","https://www.aldiwan.net/poem52241.html","السريع"],[62,"ضيف سرى والليل ينفض صبغه","https://www.aldiwan.net/poem52365.html","الكامل"],[61,"هذي المعارف منهم فتعرفا","https://www.aldiwan.net/poem51553.html","الكامل"],[66,"ضحكت ثغور حدائق الأرض","https://www.aldiwan.net/poem38487.html","الكامل"],[44,"فحواك عين على نجواك يا مذل","https://www.aldiwan.net/poem30389.html","البسيط"],[69,"صاح إن كنت في الغرام معيني","https://www.aldiwan.net/poem28372.html","الخفيف"],[31,"يا ربة البغلة الشهباء هل لكم","https://www.aldiwan.net/poem42593.html","البسيط"],[33,"إن التي زعمت فؤادك ملها","https://www.aldiwan.net/poem25829.html","الكامل"],[105,"قصوا الحديث عن الفريق النائي","https://www.aldiwan.net/poem42116.html","الكامل"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[105,"طغت الدماء وفاضت الأرواح","https://www.aldiwan.net/poem43145.html","الكامل"],[105,"الكتب تترى والكتائب تدلف","https://www.aldiwan.net/poem43999.html","الكامل"],[105,"عيينة أمسكت العجوز تريدها","https://www.aldiwan.net/poem44035.html","الطويل"],[52,"صاح بالوعظ شيب رأس مضي","https://www.aldiwan.net/poem26582.html","الخفيف"],[52,"يا لائمي قد لمت غير مليم","https://www.aldiwan.net/poem26694.html","الكامل"],[48,"لما غدا الثعلب في اعتدائه","https://www.aldiwan.net/poem10417.html","الرجز"],[50,"ودع عبيدة إن البين قد أفدا","https://www.aldiwan.net/poem63908.html","البسيط"],[50,"يا طلل الحي بذات الصمد","https://www.aldiwan.net/poem63943.html","الرجز"],[46,"الدهر يصمت وهو أبلغ ناطق","https://www.aldiwan.net/poem22715.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39628","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39605","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16686","المنسرح"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43644","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54235","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54232","الوافر"],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"ليلة معها","https://www.poetsgate.com/ViewPoem.aspx?id=179141",""],[101,"أقاموا بعضَ يومٍ فاستقلّوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62447&r=&rc=39",""],[31,"يا ربة َ البغلة ِ الشهباءِ، هلْ لكمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18810&r=&rc=73",""]],"verses":[["ضَنينٌ بِوَدّي لا يَزالُ بِوَجهِهِ","كَلامُ العِدى عَنّي وَنَفثُ النَوافِثِ",0,"ث",1,0],["ضَنَّ الطَبيبُ عَلى المَري","ضِ المُبتَلى بِدَوائِهِ",1,"ا",3,1],["ضَنّ برَجْعِ الطّرْفِ يوْمَ النّوى","هَلاّ رَعَى عهْدِي كَما أرْعى",2,"ع",2,0],["ضَنَيتُ بِهِ حتّى رَثَت لي عَواذِلي","وَرَقَّ لِما أَلقى العَدوُّ المُناصِبُ",3,"ب",1,0],["ضَنينٌ بِبَذلِ السِرِّ سَمحٌ بِغَيرِهِ","أَخو ثِقَةٍ عَفُّ الوِصالِ سَمَيدَعُ",4,"ع",1,0],["ضَنينَةُ جَفنِ العَينِ بِالمآءِ كُلَّما","تَضَرَّجَ مِن هَجمِ الهَواجِرِ جيدُها",5,"د",3,0],["ضَنْكُ المعيشة أضوى جسمها فبدت","شروى خيال بطرق العين ملموح",6,"ح",1,0],["ضَنَّت بِمَورِدَةٍ كانَت لَنا شَرَعاً","تَشفي صَدى مُستَهامِ القَلبِ صَديانا",7,"ن",2,0],["ضنيت والدَّمع ملءُ جفني","فلا تراني ولا أراها",8,"ه",2,0],["ضنيت والدمع ملء جفني","فما تراني ولا أراها",9,"ه",2,0],["ضنَّ بك الدهرُ عن حوادثِهِ","فأنت مأمولُهُ ومرتَقبُهْ",10,"ب",2,0],["ضَنْكاً إذا زُرَّتْ عليك زُرُورُه","ضاق الخناق فلم يَسَعْكَ بلادُ",11,"د",1,0],["ضَنَّت بماء العيش لكنها","من يقتَبسْ نار الجوى تُقبِس",12,"س",1,0],["ضَنيتُ مِنَ الهَوى وَشَقيتُ مِنهُ","وَأَنتَ تُجيبُ كُلَّ هَوىً دَعاكا",13,"ك",2,0],["ضنا بمائك أن يسقى الصعيد به","ورب حرص على الأشياء يؤذيها",14,"ي",3,0],["ضَنّوا بِعِرضِكِ أَن يُباعَ وَيُشتَرى","عِرضُ الحَرائِرِ لَيسَ فيهِ سُوامُ",15,"م",1,0],["ضَنّوا بِضائِعِ حَقِّهِم","وَضَنَنتَ بِالدُنيا الغَرور",16,"ر",1,0],["ضَنىً في الهَوى كَالسُمِّ في الشَهدِ كامِناً","لَذِذتُ بِهِ جَهلاً وَفي اللَذَّةِ الحَتفُ",17,"ف",1,0],["ضناً بسر الله في أرضه","وخفية للفتن الثائره",18,"ر",2,0],["ضنَّتْ لِثاتُكِ للثراءِ ولم تَرَيْ","نُخَبَ الثناءِ معوضةَ المعتاضِ",19,"ض",1,0],["ضَنْكُ المعارج في مدارجِ كيدِه","يهفو بمنْبَتِّ القُوى مُنهاضِ",19,"ض",1,0],["ضَنْكٍ إذا جَلَتِ السُّيوفُ قَناتَه","رَفَعَتْ حوافِزُهُ ظَلاماً مُغْدِفا",20,"ف",2,0],["ضَنَّ السَحابُ بِمائِهِ فَرَوَت","كَفُّ اِبنِ أُرتُقَ غُلَّةَ الأَرضِ",21,"ض",1,0],["ضَنكٍ إِذا خَرِسَت أَبطالُهُ نَطَقَت","فيهِ الصَوارِمُ وَالخَطِّيَةُ الذُبُلُ",22,"ل",1,0],["ضنَّ بالطيفِ يا أخيَّ وقدْ كا","نَ بطيبِ الوصالِ غيرَ ضنينِ",23,"ن",1,0],["ضَنَّت بِنائِلِها عَنّا فَقَد تَرَكَت","مِن غَيرِ ذَنبٍ أَبا الخَطّابِ مُختَلَجا",24,"ج",2,0],["ضَنَّت بِنائِلِها فَقُلتُ لِصاحِبي","ما كانَ أَكثَرَها لَنا وَأَقَلَّها",25,"ل",3,0],["ضِنُّوا بميراثِ الدُّهور وحَصِّنوا","شرفَ البنين وسُؤدُدَ الآباءِ",26,"ا",2,0],["ضنّتْ عليه بما يُريدُ وأَيقنتْ","أن سوف يتركها بلا أَوصالِ",27,"ل",1,0],["ضَنّت بِصِبيَتِها وَرَونَقِ وَجهِها","فَتَحَدَّرَت عَبَراتُها تَنساحُ",28,"ح",1,0],["ضَنّ الخبيثُ بِمُلكِهِ وغَداً يرى","يد غَيْرِه في مُلْكِهِ تتصرَّفُ",29,"ف",1,0],["ضَنَنْتَ بأُمِّ الحَيِّ تُغْلِي فِدَاءَها","فَيَا لَكَ رأياً غَيرُهُ كانَ أجْدَرَا",30,"ر",2,0],["ضَنَّ عَنّي فَلَم يَضِرني حَسودي","وَحَباني رَبٌّ عَلِيٌّ سَخِيُّ",31,"ي",1,0],["ضَنَّت شُرَيرُ بِوَصلِها وَلَطالَما","لَعِبَت مَواعِدُها بِكُلِّ غَريمِ",32,"م",1,0],["ضَنَّ أَخي عُكلٍ عَلى عَطائِهِ","يَبيعُ بِاِسمِ اللَهِ في أَشلائِهِ",33,"ا",3,0],["ضَنَّت عُبَيدَةُ بِالتَسليمِ فَاِحتَجَبَت","فَهَيَّجَت دَمعَ عَينٍ كانَ قَد جَمَدا",34,"د",2,0],["ضَنَّت بِخَدٍّ وَجَلَت عَن خَدِّ","ثُمَّ اِنثَنَت كَالنَفسِ المُرتَدِّ",35,"د",1,0],["ضَنَّت يَداهُ وَتِلكَ مِنهُ سَجيَّةٌ","أَن تُجرِيا أَحَداً عَلى الإيثارِ",36,"ر",1,0],["ضننتُ بها ضنَّ معتزَّةٍ","وتحت الوسادة أودعتُها",37,"ه",2,0],["ضَنَّ بالقطرة منها وكذا شرعُ الولاءِ","ومضى جيلٌ وجيلٌ وهو مشبوبُ الدماءِ",38,"ا",2,0],["ضَنّ بها رَبُّها لضِنَّتِها","به وكم ضِنَّةٍ من الكَرَم",39,"م",1,0],["ضَنَنتَ بالذهَبِ ابن التربِ تمنَعهُ","عنه وجاءك بالأفلاك يهديها",40,"ي",3,0],["ضَنىً كانَ أَبداهُ الهَوى فَأَعادَهُ","سَوادٌ بَدا في حمرَةٍ وَبَياضِ",41,"ض",1,1],["ضننتُ بِسُلواني وَجُدتُ بِمُهجَتي","فَهَل أَنتَ عَن فِعلِ المُتَيَّمِ راضِ",41,"ض",1,0],["ضننتُ به فلم يهتِف بعمرٍو","ولم تستهوهِ بَسَماتُ سُعدَى",42,"د",2,0],["ضَنْتُ به وجُدتُ له بنفسي","وإنّ الحبَّ تبذيرٌ وبُخل",43,"ل",1,0],["ضَنْكُ المسَفَّةِ يَدَّني عَطَشاً","وتَموُّجُ الآذيِّ يُبعِده",44,"د",2,0],["ضنكُ المنافذِ لا مكانَ به","لمَسَرَةٍ واليومَ ينتشر",45,"ر",1,0],["ضَنْنتُ به وجُدتُ له بنفسي","وإنّ الحبَّ تبذيرٌ وبُخل",46,"ل",1,0],["ضَنَّتْ بِنَائِلِها هِنْدٌ فَقَدْ تَرَكَتْ","مِنْ غَيْرِ ذنبٍ أبَاالخَطَّابِ مُخْتَلَجا",47,"ج",2,0]]}