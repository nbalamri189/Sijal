{"poems":[[84,"فتح الحب نوره فحسبنا","https://www.aldiwan.net/poem29406.html","الخفيف"],[90,"لقيتها ليتني ما كنت القاها","https://www.aldiwan.net/poem44448.html","البسيط"],[94,"أنت يا شعر فلذة من فؤادي","https://www.aldiwan.net/poem38953.html","الخفيف"],[64,"علم الماء قتال النار","https://www.aldiwan.net/poem52174.html","مجزوء الرمل"],[64,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[46,"دنف بكى آيات ربع مدنف","https://www.aldiwan.net/poem30401.html","الكامل"],[54,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85379","الخفيف"],[53,"رُبَّ كعاب في حجابٍ لم تزلْ","https://www.poetsgate.com/ViewPoem.aspx?id=30250",""],[159,"بهواك إذ قال الهوى","https://www.aldiwan.net/poem55763.html","مجزوء الكامل"],[290,"أمحمد بن الشيخ يا فخر القضا","https://www.aldiwan.net/poem39394.html","الكامل"],[382,"بيني وبين المبدعين مرامي","https://www.aldiwan.net/poem59267.html","الكامل"],[409,"زارت فكان لها الفؤاد مقيلا","https://www.aldiwan.net/poem33489.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53810","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63789","المنسرح"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46527","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1403,"","https://poetry.dctabudhabi.ae/diwan/poem/115349","البسيط"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115887","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52112","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27526","السريع"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87325","الرجز"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3168,"","https://poetry.dctabudhabi.ae/diwan/poem/35042","البسيط"],[3439,"","https://poetry.dctabudhabi.ae/diwan/poem/130864","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78195","الرجز"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81931","الكامل"],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""]],"verses":[["ثم أجرى نواره عن سلوك","من حرير فيها فصوص عقيق",0,"ق",1,0],["ثم اجتذبت لها من جيب ملحفتي","دراهماً كنت استبقي بقاياها",1,"ا",3,0],["ثُمَّ أَجْني في صيفِ أَحلاميَ","السَّاحِرِ مَا لَذَّ من ثمارِ الخُلودِ",2,"د",1,0],["ثم اجمِد ذاك بالكح","لِ النحاسيّ الثقيلِ",3,"ل",1,0],["ثم اجعل الكل في التعفين تتركه","ميقات موسى وقد وافى على قدرِ",4,"ر",1,0],["ثُمَّ اِجتَنَت شَلوي فَصِرتُ جَنينَها","مُتَمَكِّناً بِقَرارِ بَطنٍ مُسدِفِ",5,"ف",1,0],["ثُمَّ أَجي وَالصُبحَ في عِنانِ","مِن قَبلِ أَن يُبدَأَ بِالآذانِ",6,"ن",1,0],["ثم أَجلستها إلى الجنب مني","ثم قلبت شعرها ببناني",7,"ن",2,0],["ثم أجنَّتها غياباتُ الكِلل","فكان ما نلتُ وكانت في المَثل",8,"ل",1,0],["ثمَّ اجْهدي أَنْ تحسني","فإِذا أَسأْتِ فلا تتوبي",9,"ب",2,0],["ثم اجتذبت مجاوراً طود التقى","حسا ومعنى نعم ذا التحويل",10,"ل",1,0],["ثم اجلسوا في باب بطرس راسِكم","لا خير في جسمٍ خلا عن هام",11,"م",1,0],["ثم اجتلاها الفكر وهو من الحيا","في خجلة قد أورثته نحولا",12,"ل",2,0],["ثم أجاز لعتيق وعمر","إمامة الأمة جهلا بالنظر",13,"ر",1,0],["ثم أجلوك كالعروس على الشر","ب تهادى في مجسد مصقول",14,"ل",1,0],["ثم اجتلينا عذراءَ تحسِرُ عن","جسمِ عقيقٍ في ثوبِ بَلُّور",15,"ر",1,0],["ثُمَّ اجلسي في السجن عِندَ بعلك","حَسبي ذا مَعونة مِن فعلك",16,"ك",1,0],["ثم اجعل المضارعَ الذي وُضع","كشبهه الذي له فيها تبع",17,"ع",1,0],["ثم اجتلاها السقاة صفوا","تحوزه الاعين النضار",18,"ر",1,0],["ثم اجتنينا ببيض الهندِ ما غرسوا","والنارنِ ما زرعوا فيه وما حصدُوا",19,"د",3,0],["ثمّ أجمعتُ بعد ذلك رأياً","أن أوالي جماعة الأوغاد",20,"د",1,0],["ثم اجتمعنا في المعاني وقد","زدت بميل الحسِّ إذ تشعر",21,"ر",1,0],["ثُمَّ آجرِ في التِّيرِ وَنَسرِ الطايرِ","والكحل في اليَسَارِ بالأمَايرِ",22,"ر",1,0],["ثم اجتباهُ ربهُ فتابا","مكتسياً من قربه جلبابا",23,"ب",2,0],["ثُمَّ أَجَدّوا وَعَن أَيمانِهِم دِيَرٌ","وَعَن شَمائِلِهِم مِن فَردَةٍ بُرَقُ",24,"ق",1,0],["ثم اجعل التمثيل دأبك صابراً","ما أدرك المأمول مثل صبور",25,"ر",1,0],["ثم اجمعوا أعظم فطرقل الأولى","تبرز إذ في الوسط كان اعتزلا",26,"ل",2,0],["ثُمَّ اِجتَباهُ مَولاهُ اِذ","تابَ عَلَيهِ وَهُدى",27,"د",2,0],["ثم اجتباه بوحيه وبقربه","فتنزَّل القرآن والتأييد",28,"د",1,0],["ثم أجرى بها بجهد وجدّ","فلجاً ماؤه (بعزّ) تماهى",29,"ا",3,0]]}