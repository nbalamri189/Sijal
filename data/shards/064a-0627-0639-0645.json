732,"ابيه يرحمني","https://www.poetsgate.com/ViewPoem.aspx?id=177905",""],[5732,"دايم يباريني","https://www.poetsgate.com/ViewPoem.aspx?id=177907",""],[5732,"يضوي ويسري","https://www.poetsgate.com/ViewPoem.aspx?id=177920",""],[5732,"حي جرح قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=177917",""],[5732,"ما طاع عذاله","https://www.poetsgate.com/ViewPoem.aspx?id=177911",""],[5732,"حل الفرقا","https://www.poetsgate.com/ViewPoem.aspx?id=177903",""],[5732,"قالو تنوح","https://www.poetsgate.com/ViewPoem.aspx?id=177936",""],[5732,"حي نوده","https://www.poetsgate.com/ViewPoem.aspx?id=177896",""],[5732,"يا زين جرحك","https://www.poetsgate.com/ViewPoem.aspx?id=177949",""],[5732,"إلى عذلت القلب","https://www.poetsgate.com/ViewPoem.aspx?id=177953",""],[5732,"عزي لمن مثلي","https://www.poetsgate.com/ViewPoem.aspx?id=177918",""],[5732,"الله من قلب","https://www.poetsgate.com/ViewPoem.aspx?id=177901",""],[5732,"ما من خطا","https://www.poetsgate.com/ViewPoem.aspx?id=177898",""],[5732,"بعدك يزيد القلب","https://www.poetsgate.com/ViewPoem.aspx?id=177947",""],[5732,"ذكرتني يا زين","https://www.poetsgate.com/ViewPoem.aspx?id=177946",""],[5732,"صفقت بالأصبع","https://www.poetsgate.com/ViewPoem.aspx?id=177955",""],[5742,"رثاء الصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=206959",""],[469,"جزتَ في المجد والفعال الشريفِ","https://www.poetsgate.com/ViewPoem.aspx?id=76859",""],[5843,"أهم إحساسي","https://www.poetsgate.com/ViewPoem.aspx?id=51299",""],[5861,"صرخة أم","https://www.poetsgate.com/ViewPoem.aspx?id=188056",""],[5885,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=194688",""],[5950,"دع الشعر ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128339",""],[6100,"حضرة جناب الفقر","https://www.poetsgate.com/ViewPoem.aspx?id=52597",""],[6113,"حزينه","https://www.poetsgate.com/ViewPoem.aspx?id=14417",""],[6144,"أعوذ بالله","https://www.poetsgate.com/ViewPoem.aspx?id=21838",""],[566,"قد جبر الدين الإله فجبر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=507608",""]],"verses":[["يا عِمادَ الدينِ الَّذي رَفَعَ المَج","دَ وَقَد مالَ بِالعِمادَينِ ضُعفا",0,"ف",2,0],["يا عَمرُو لا أَعرِفُ ثِقلاً بَهَظَك","خُلَّةُ حُرٍّ فَأَعِرها مَلحَظَك",1,"ك",1,1],["يا عَمرُو ذا الجُمَّةِ وَالوَجهِ الأَغَرّ","قُمِ اِضطِراراً جاوَزَ الأَمرُ الخَبَر",2,"ر",1,0],["يَا عِمَادِي صَحَّ عَنِّي أَنَّنِي","لَكَ مَمْلُوكٌ وَتِلْمِيذٌ وَصَاحِبْ",3,"ب",1,1],["يا عَمرو ما وقفَةٌ في رَسمِ مَنزِلَةٍ","أَثارَ شَوقَكَ فيها مَحوُ آثارِ",4,"ر",1,0],["يا عمر الخير لقد نبهت","منك المعالي طرف راعٍ حكيم",5,"م",1,0],["يا عمرو لا تمنعنّا ما نُسرُّ به","فإن ذلك لؤم منك أو خور",6,"ر",1,0],["يا عمرو لو قلبت ميمٌ مُسكَّنةٌ","باءً محرَّكةً لم تُخطأ الفُقَر",6,"ر",1,0],["يا عمرُو صبراً للقِصا","ص بما جنيتَ عليَّ صبرا",7,"ر",2,0],["يا عمرو فخراً فقد أعْطيتَ منزلةً","ليست لِقَسٍّ ولا كانت لشمّاسِ",8,"س",1,1],["يا عمرو سالتْ بك السيولُ","لأمّك الويل والهبولُ",9,"ل",1,0],["يا عَمرو قَد لاقَيتَ فارِسَ هِمَّةٍ","عِندَ اللِقاءِ مُعاوِدَ الإقدامِ",10,"م",1,1],["يا عَمرو وَيحَكَ قَد أَتا","كَ مُجيبُ صَوتِكَ غَيرُ عاجِزِ",11,"ز",1,1],["يا عَمودَ الإِسلامِ خَيرَ عَمودِ","وَالَّذي صيغَ مِن حَياءٍ وَجودِ",12,"د",1,1],["يا عَمرُو قُل لِلقَمَرِ الطالِعِ","إِتَّسَعَ الخَرقُ عَلى الراقِعِ",13,"ع",1,1],["يا عَمرَ حُمَّ فِراقُكُم عَمرا","وَعَدَلتِ عَنّا النَأيَ وَالهَجرا",14,"ر",2,1],["يا عَمْرو دِينَ اللَّهِ لسنا كالأُلَى","جعلوا الحلالَ من الأمورِ حَراما",15,"م",2,0],["يا عمرو خُذها من عليٍّ ضربةً","هِيَ إن سألتَ عن الجحيمِ جوابُ",16,"ب",1,0],["يا عَمرَ إِنّي فَاصرميني أَو صِلي","لَجَّت بِحُبِّكُمُ بَناتُ فُؤادي",17,"د",2,0],["يا عَمروُ مَن لَم يَختَنِق","بِالبَينِ لَم يَختَنِقِ",18,"ق",1,1],["يا عَمروُ لا لاقَيتَ ما","لاقَيتُ مِن مُنطَلَقي",18,"ق",2,0],["يا عَمروُ ما لِلناسِ قَد","كَلِفوا بِلا وَنَسَوا نَعَم",19,"م",1,1],["يا عَمروُ ما هَذا الغُلامُ الَّذي","مَرَّ بِنا في الحَيِّ مُستَنّا",20,"ن",2,1],["يا عمرو ما بالُ المدينيّه","لا تأكل العصبانَ مشويّه",21,"ي",2,0],["يا عمرو أضحت مبضةً كبَدي","فاصبغ بياضاً بعُصفرِ العنَب",22,"ب",1,1],["يا عَمروُ ما راحَ مِن قَومٍ وَلا اِبتَكَروا","إِلّا وَلِلمَوتِ في آثارِهِم حادي",23,"د",2,0],["يا عُمرَكِ اللَهَ أَلّا قُلتِ صادِقَةً","أَصادِقاً وَصَفَ المَجنونَ أَم كَذِبا",24,"ب",2,0],["ياعَمَّرَ اللَهُ سَيفَ الدينِ مُغتَبِطاً","فَكُلُّ حادِثَةٍ يُرمى بِها جَلَلُ",25,"ل",1,1],["يا عمدتي يا غيوث الأرض حسبكم","مسح الملائك تبريكا ومنتفعا",26,"ع",2,0],["يا عِمادي صحَّ عندي أنني","لك مملوكٌ وتلميذٌ وصاحِبُ",27,"ب",1,1],["يا عم دبابات !! .. إني أرى","هذا انقلاب جدّتي عارفه",28,"ف",2,0],["يا عم دبابات !! قل : لعبة","سخيفة كاللعبة السّالفه",28,"ف",2,0],["يا عماد القوم طيا للابد","يا علي يا اسد الله المدد",29,"د",1,1],["يا عم أنا مالي مسُوجر","مال الصبا ماليش غيرُه",30,"ه",1,0],["يا عِمادي أنتَ أَدرى بالزمان","ما لأهليهِ وفاءٌ وعهود",31,"د",1,0],["يا عمِّ لا زلتَ في النعماء محبوراً","سامي المحلّ قريرَ العين مسرورا",32,"ر",2,1],["يا عِمادَ الدينِ يا مَن","هُوَ بِالجودِ جَديرُ",33,"ر",1,1],["يا عِمادَ الدينِ يا مَن","هُوَ في اللَأواءِ ذُخري",34,"ر",2,1],["يا عِمادَ الدينِ يا أَك","رَمَ مَن تَحتَ السَماءِ",35,"ا",2,1],["يا عَمْرُو أَيُّ عَظِيمِ خَطْبٍ لَمْ يَكُنْ","خَطْبُ الْفِراقِ أَشَدَّ مِنْهُ وَأَوْبَقا",36,"ق",2,0],["يَا عُمَرَ الخَيْرِ أَعِني فَقَدْ","هَنَّأتُ بِالشِّعْرِ وَعَزَّيْتُ",37,"ت",1,1],["يا عمدَتي وَذَخيرَتي وَوَسيلَتي","يا سيديا أَسلافِه أَخيار",38,"ر",1,0],["يا عُمدتي في شِدَّتي","ناري بنورِكَ تَطفأُ",39,"ا",1,0],["يا عَمرُو لا تَفجُر بِمَكْ","ةَ إِنَّها بَلَدٌ حَرامُ",40,"م",1,1],["ياعمر بن براهم كيف تطلب وصيه","من فتى همه كسب الأمور الدنيه",41,"ي",2,0],["يا عمران زرت سيدنا الرسول","وكذا الشيخين والزهر البتول",42,"ل",1,1],["يا عَمرو مَن ذا الَّذي أَنا لَكَ مِن","صارِمِهِ الحَتفَ حينَ أَلقاهُ",43,"ا",2,0],["يا عمادي حين لا معتمد","وصدى صوتي في الخطب الملم",44,"م",1,1],["يا عماد المجد في المجد ويا","دُرَّة التَّاج ويا بيت القصيد",45,"د",1,0],["يا عماد الدِّين القويم وما زل","ت عظيم البنا رفيع العماد",46,"د",1,0],["يا عِمادِي وقد حُرِمْتُ العِمادا","ووِدادي وقد نَسِيتُ الوِدادا",47,"د",2,0],["يا عُمَرُ الطّلاّءُ إياكَ أنْ","تعرِضَ لي يا عُمرُ الطّلاّ",48,"ل",2,1],["يا عُمدَتي يا عُدّتي","يا جُنّتي في النّوَب",49,"ب",1,0],["يا عمدةَ الملكِ وأيُّ شرفٍ","طالَ ولم ترفعه منكم عَمَدُ",50,"د",1,0],["يا عمرو دُلَّ عَلَى الْعَقيقِ وأهْلِهِ","فَلَقَدْ تَضَايق كُلُّ فَيْحٍ أَوْسَعِ",51,"ع",1,0],["يا عَمْروُ إنّي مَنْ عَرَفْتَ فَما الذي","أَنْكَرْتَ مِنْ قَوْلي الصَّحيحِ الْجَيِّدِ",52,"د",1,0],["يا عُمدةَ الدَولةِ العُظمَى التِّي بعَثَتْ","إلى المشارقِ منها كوكبَ السَّحَرِ",53,"ر",1,0],["يا عِماداً لدَولةٍ مَن تُصافي","هِ تُصَفيّهِ قبلَ أن تَصطفيهِ",54,"ي",2,0],["يا عمرو عمري في هواه لعمره","يفنى وما سعد عليه مساعد",55,"د",1,0],["يا عماد الدين يا من","حمد الناس زمانه",56,"ن",2,0],["يا عُمَرَ الخَيراتِ والمكارمِ","وعُمرَ الدسائعِ العظائمِ",57,"م",1,1],["يا عمدة الوقت في إيضاح ما قصرتْ","عن الوصول إلى إدراكهِ الفكرُ",58,"ر",1,1],["يا عَمروُ إِن كانَ النَبيُّ مُحمدٌ","أَودى بِه الأَمرُ الَّذي لا يُدفَعُ",59,"ع",1,1],["يا عمروُ إِنَّ حياتَه كَوَفاتِهِ","فينا وَنبصرُ ما نَقولُ وَنَسمَعُ",59,"ع",1,0],["يا عمر العدل أنت زيد","تحت مثار الوغى وعرر",60,"ر",1,0],["يَا عِمَادِي وَيَا شِفَا بَلْوَايْ","مِنْ جَفَا المَرْبَعِ",61,"ع",1,0],["يا عمرو إِنّكَ قد قَشَرْتَ لي العَصَا","برضاكَ في وسط العجاجِ بِرازِي",62,"ز",2,1],["يا عمرو إنّكَ قد أشَرْتَ بِظِنّةٍ","إِنّ المبارِزَ كالجُدَيّ النّازِي",62,"ز",2,0],["يا عَمرُو حَسبُكَ مِن خَدعٍ وَوِسواسِ","فَاِذهَب فَلَيسَ لِداءِ الجَهلِ مِن آسي",63,"س",2,1],["يا عَمرُو إِنَّكَ عارٍ مِن مَغارِمِها","وَالراقِصاتِ وَمِن يَومِ الجَزا كاسي",63,"س",2,0],["يا عمرو قد أينع البهار","واعتدل الليل والنهار",64,"ر",1,1],["يا عمدة الخلق يا من قد علا وسما","بشر وظفر وقل لي لا تخف جرما",65,"م",2,0],["يا عُمَر الحَقِّ وقيتَ الأبؤسا","ولا لقيت ما بقيت الأَنْحُسا",66,"س",2,0],["ياعمرو قد قيل إن في الشركة","خيراً وقد قيل ما بها بركة",67,"ه",1,0],["يا عمرو زيدٌ وخالد نجبا","لأن زيداً وخلداً أدبا",67,"ا",1,0],["يا عمرو ليس التجارة الأدبا","أخضتَّ في المعمعان معتركا",67,"ا",1,0],["يا عمرو للاشتراك مطلّب","اللين فيه اخص ما يجب",67,"ب",1,0],["يا عمدةَ الأمراءِ والوزراءِ","يا عِدَّةَ الأدباءِ والشعراءِ",68,"ا",2,1],["يا عمرك الله نسيت وقفة","مضت لنا بالجزع من سقط اللوى",69,"ا",1,0],["يا عمري زد في المدى فسحة","ويا ليالٍ ذهبت عودي",70,"د",2,0],["يا عمرك الله الظعائن حملت","وتوجهوا نحو الحبيب وأسرعوا",71,"ع",3,0],["يا عمادَ القومِ في اليومِ ويا","حليَةَ النادي إذا النادي احتَفَل",72,"ل",1,0],["يا عَمرُو ردَّ عَلى الصُدورِ قُلوبَها","مِن غَيرِ تَقطيعٍ وَلا تَحريقِ",73,"ق",1,1],["يا عمرُو لَو نبّهتهُ لَوجدتهُ","لا طائِشاً رعشَ الجنان ولا اليدِ",74,"د",1,0],["يا عَمْرُو هلْ عجِبْتَ منْ فِلْو الرَّحىَ","والخيلُ من ورائِه تشكو الوجَى",75,"ج",2,1],["يا عَمرُو لا تَفجُر بِمَكْ","كةَ إِنَّها بَلَدٌ حَرامُ",76,"م",1,1],["يا عَمرو دونكَ صارماً ذا رونقٍ","عَضب المهزّة ليسَ بِالخوّارِ",77,"ر",1,1],["يا عمرو يا مُكنى بعثمانِ","أصبحَ دينارك ذا شانِ",78,"ن",1,1],["يا عُمرَ بن عُمَرَ بن الخطاب","إن وقوفَ الحرّ عند الأبواب",79,"ب",1,1],["يا عِمادَ الحَزم نَعتاً صادِقاً","وَمِنَ الأَلقابِ مَينٌ وَالكُنى",80,"ن",2,0],["يا عماد الهدى وخير عميد","قد أقاما الايمان والاسلاما",81,"م",2,0],["يا عَمرُو إِني قَد هَويتُ جِماعَكُم","وَلِكُلِّ مَن يَهوى الجِماعَ فِراقُ",82,"ق",1,1],["يا عَمروُ إِن تُسدِ الأَمانَةَ بَينَنا","فَأَنا الَّذي إِن خُنتَها يَرعاها",83,"ا",3,1],["يا عَمروُ لَيسَ أَخو الأَمانَةِ بِالَّذي","ما رابَهُ مِن خُطَّةٍ أَفشاها",83,"ا",3,0],["يا عَمروُ إِنَّ أَخا الأَمانَةِ كاتِمٌ","لَو يَستَطيعُ بِجِلدِهِ أَخفاها",83,"ا",3,0],["يا عَمروُ قَد أَعجَبتَني مِن صاحِبٍ","حيناً تَشُجُّ وَتارَةً تَأسوني",84,"ن",2,1],["يا عَمرو ناشدتُكَ بالمَسيحِ","أَلا اِستَمَعتَ القَولَ مِن فَصيحِ",85,"ح",1,0],["يا عَمرو بالحَقّ من اللاهوت","وَالروحِ روحِ القُدسِ وَالناسوتِ",85,"ت",1,0],["يا عمرو علك بعد النوم تنتبه","وتهتدي بعد أن أودى بك العمه",86,"ه",1,1],["يا عِماد الدنيا وَيا عدّة الدي","ن وَيا كَوكَب الهُدى الوَضّاءَ",87,"ا",2,0],["يا عَمرَ حُمَّ فِراقُكُم عَمرا","وَعَزَمتِ مِنّا النَأيَ وَالهَجرا",88,"ر",2,1],["يا عَمرَ شَيخُكِ وَهوَ ذو كَرَمٍ","يَحمي الذِمارَ وَيُكرِمُ الصِهرا",88,"ر",2,0],["يا عَمرو لا تَلقى المُفَضّلَ بَعدَها","بِلِواءِ قَومِكَ إِذ سُلِبتَ لِواءَكا",89,"ك",2,1],["يا عُمدتي في شِدَّتي ومَعُونتي","ببليَّتي والفوزُ فيما يَعظُمُ",90,"م",1,0],["يا عميد الفنون ص