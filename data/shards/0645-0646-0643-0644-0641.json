=188216",""],[5939,"ليلى وأخواتها","https://www.poetsgate.com/ViewPoem.aspx?id=190078",""],[5944,"2020","https://www.poetsgate.com/ViewPoem.aspx?id=213794",""],[6093,"سَيْلُ البَيَاضِ","https://www.poetsgate.com/ViewPoem.aspx?id=191152",""],[520,"من كل فدم لا يزال لسانه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577578",""],[6202,"طول مسيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86734&r=&rc=35",""],[6237,"اليوم الخالد (يوم عرفة)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77877&r=&rc=19",""],[2220,"ناحتْ مطوقة ٌ فحنَّ حزينُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19271&r=&rc=813",""],[2220,"عُج بالرّكائِبِ نحوَ بُرْقَة ِ ثَهْمَدِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19279&r=&rc=821",""]],"verses":[["منْ كُلِّ فَتْلاءِ الذِّراعِ مِرْقالْ","يَفحَصْنَ أُدْحِيَّ الظّليمِ المِجْفالْ",0,"ل",1,0],["مِن كُلِّ فاتِنَةٍ تَلَفَّتَ جيدُه","مَرَحاً كَسالِفَةِ الغَزالِ الأَغيَدِ",1,"د",1,0],["من كلّ فاتنة الترسُّل لو بدت","لنُهاك يا عبد الرحيمِ لغابا",2,"ب",2,0],["من كلّ فاتح أرضٍ غير طائعةٍ","مبارك الفتح أنى سار والقفل",3,"ل",1,0],["من كلِّ فهدٍ عنتريّ الحمله","إذا رأى شخص مهاة عَبله",4,"ه",1,0],["من كل فطحاءَ علتْ مُدمَجاً","يُربي على القبضة والشبرِ",5,"ر",1,0],["مِن كُلِّ فَظٍّيُريكَ القِردَ مُحتَشِماً","وَيَضحَكُ القِردُ مِنهُ غَيرَ مُحتَشِمِ",6,"م",1,0],["من كل فضفاض الغرور ببرده","نمرود أو فرعون ذو الأوتاد",7,"د",1,0],["من كل فاكهة وكل فكاهة","هيأت نحلا واتخذت شرابا",8,"ب",2,0],["مِن كَلَفٍ أَن تَنقَضي ساعَةٌ","يَأتي بِها الدَهرُ وَلَم أَكلَفِ",9,"ف",1,0],["مِن كُلِّ فاضِحَةِ الجَبينِ كَأَنَّها","شَمسُ النَهارِ بَدَت بِلَيلٍ أَدكَنِ",10,"ن",1,0],["من كلّ فتّاكٍ بأقرانِه","له حياةٌ تَغْتذي بالحِمام",11,"م",1,0],["مِن كُلِّ فَرجٍ لِلعَدُوِّ كَأَنَّهُ","فَرجٌ حِمىً إِلّا مِنَ الأَكفاءِ",12,"ا",2,0],["مِنْ كُلِّ فَدْمٍ لائِكٍ مُضْغَةً","يَمُجُّهَا كَالدَّمِ فِي الأَرْضِ فُوهْ",13,"و",2,0],["مِنْ كُلِّ فَظٍّ يَلُوكُ فِي فَمِهِ","مُضْغَةَ سُوءٍ مِزَاجُهَا عَفِنُ",14,"ن",1,0],["منْ كلِّ فنٍّ خذْ ولا تجهلْ بهِ","فالحرُّ مطَّلعٌ على الأسرارِ",15,"ر",1,0],["مِنْ كلِّ فظٍّ أعجمِي","غثِّ الكلامِ مذمَّمِ",16,"م",1,1],["مِن كُلِّ فَردٍ في الأَريكَةِ مالِكٍ","أُمَماً تَهولُ بَني الزَمانِ حِسابا",17,"ب",2,0],["مِن كُلِّ فَنٍّ فيهِ أُعجوبَةٌ","كَأَنَّهُ جامِعُ سُفيانِ",18,"ن",1,0],["مِن كُلِّ فاتِنَةٍ تَلَفَّتَ جيدُها","مَرَحاً كَسالِفَةِ الغَزالِ الأَغيَدِ",19,"د",1,0],["مِن كُلِّ فائِقَةِ الجَمالِ كَدُميَةٍ","مِن لُؤلُؤٍ قَد صُوِّرَت في عاجِ",20,"ج",1,0],["من كلّ فحشاءَ له إحْرامُ","ما زال والرشد له إمامُ",21,"م",1,0],["منْ كلَّ فدمٍ لائكٍ مضعة ً","يمجها كالدمِ في الأرض فوهُ",22,"و",2,0],["من كلّ فاتكةِ الأجفانِ إن نظرت","فأي قلب بسيف اللحظ ما انجرحا",23,"ح",2,0],["من كل فاتنة القوام بحسنها","تزدان لا بحليها ولباسها",24,"س",3,0],["مِنْ كُلِّ فَخْرٍ لِفَاخِرٍ","كَقَطْرَةٍ مِنْ رَكِيِّهِ",25,"ي",2,0],["من كل فج أتوا باسم الصليب وهم","به وباللَه والأديان قد كفروا",26,"ر",3,0],["مِن كُلّ فذٍّ وَمشفوعٍ بِتَوأمهِ","وَكُلّ عَذراء لا طولاً وَلا قِصَرا",27,"ر",2,0],["من كلِّ فَتلاء الذِّرا","عِ كأنّها حَبْلٌ مُمَرّ",28,"ر",1,0],["مِن كُلِّ فاتنةٍ لمِعْصَمِها","تُبدِي فيَشجَى القَلْبُ والقُلب",29,"ب",1,0],["من كل فاكهة حسناء حالية","تين وخوخ وبطيخ ورمان",30,"ن",1,0],["من كل فرد مقعد أو","كل شعب قاصر",31,"ر",1,0],["من كلّ فنٍ عبقر","يٍ للمحِّب وللحبيبِ",32,"ب",1,0],["من كلّ فتلاء تطيع المَرِسَ ال","مثْنى عليها أو تعودَ مَرِسا",33,"س",2,0],["من كل فاتكة بعيني مغزل","أداء متلعة إلى أطلائها",34,"ا",3,0],["من كلِّ فتلاءِ الذراعِ حُرَّةٍ","عجَّزَتِ العُذافِرَ الضليعا",35,"ع",2,0],["مِن كلِّ فارسِ مَعرَكٍ يردُ الردى","اِلْفاً ويُطربُه الثناءُ فَيُنْشُرُ",36,"ر",1,0],["من كلِّ فحلٍ كَبيرِ القلبِ ذي مَدَدٍ","له على شأنِهِ المَخْفِيِّ بُرْهَانُ",37,"ن",1,0],["من كلِّ فَحْلٍ باسلٍ","مُلَثَّمٍ مُرْبَلِ",38,"ل",1,0],["من كل فدم يزال لسانه","مغرى بحرف الراء أو بالقاف",39,"ف",1,1],["من كَلَفِي أنّنِي مررتُ به","فلم يَعِرْني من طَرْفِهِ طَرَفا",40,"ف",2,1],["من كل فاكهة به زوجان بل","ثمر لكل القاطفين كثير",41,"ر",1,0],["مِنْ كُلٍّ فَجٍّ أَتَتْكَ التَّهْنِئَاتُ بِهَا","مِنْ صَادِقِ الحُبِّ مَا تُزْهي بِهِ الكَلِمُ",42,"م",1,0],["مِن كلِّ فجٍّ أميرٌ مِنك منبَعِثٌ","يَسيرُ تحتَ لِواءٍ مِنك مَعقُود",43,"د",1,0],["مِن كلِّ فاتِنةٍ تَمَلَّكَتِ النّهى","مِن كلِّ لَيثٍ في اللّيوثِ غَضَنفَرِ",44,"ر",1,0],["من كلف النفسَ ما لا تستطيع غدا","بين الأنام مُمَيليكا لمنْ خبَزَا",45,"ز",2,0],["من كل فاترة الألحاظ فاتنة","حوراء أحسن من حور وولدان",46,"ن",1,0],["من كل فارعة هيفاء ناهدة","يسعى لها الموج ارواداً وايجافا",47,"ف",2,0],["مِن كُلِ فاكِهَةٍ بِها زَوجان في","كُلٍّ مِن الأَنحاءِ وَالأَحيا",48,"ا",1,0],["من كل فجٍّ يُقبلون كأنهم","سيل الحجيج انصبَّ في عَرفاتهِ",49,"ت",2,0],["من كل فعل صالح جميل","أعده لسفر طويل",50,"ل",1,0],["من كَلَف النفوس ضَد طَبعِها","وَراضها مُجتَهداً في نَزعِها",51,"ه",2,0],["من كل فنٍّ قد حوت خبراً فخذ","ما تشتهيه محققاً مقبولا",52,"ل",2,0],["من كل فرد ليس تسمع بعده","الا صداه مرددا ترديدا",53,"د",2,0],["من كلِّ فاتِرَة الجُفونِ عزيزةٍ","أحلى من الرّشأ الأَغَنّ وامْلحا",54,"ح",2,0],["من كل فرعاء معَلْولُ مرَّجلُها","بالطَّوق والقُرْطِ بين النّحْرِ والّليتِ",55,"ت",1,0],["من كل فاترة العينين عن حَوَرٍ","كأنّما هي وَسْنى أَو بها سُكُرُ",56,"ر",1,0],["من كل فتانةٍ إذا ابتسمت","بالليل تمحو صحائف الظلم",57,"م",1,0],["من كل فارس خيل نال منزلة","يهدي لفار سكور بحرها طرفا",58,"ف",2,0],["من كل فاترة الجفون بطرفها","دعجٌ يدوس الطرف منه الراكبا",59,"ب",2,0],["من كل فج فاجأته أمة","عمت بتلبية وعم تفير",60,"ر",1,0],["من كل فياض الجوانح موجع","يجري بذكرك دمعه مهتاجا",61,"ج",2,0],["مِن كُلِّ فَجٍّ تَستَقيمُ طِمِرَّةٌ","شَوهاءُ أَو عَبلُ الجُزارَةِ مِنهَبُ",62,"ب",1,0],["مِن كُلِّ فَيّاضِ اليَدَينِ كَأَنَّما","جادَت يَداهُ مَجادَ غَيثٍ هامِ",63,"م",1,0],["مِن كُلِّ فاتِكَةٍ بِطَرفٍ أَحوَرٍ","مِن كُلِّ ثانِيَةٍ بِجيدٍ أَغيدِ",64,"د",1,0],["مِن كُلِّ فاتِكَةِ الأَلحاظِ مَريضَةٍ","أَجفانُها لِظُبى اللَحاظِ جُفونُ",65,"ن",1,0],["مِن كُلِّ فاتِكَةِ الأَلحاظِ مالِكَةٍ","تَخالُها فَوقَ عَرشِ الدُرِّ بِلقيسا",66,"س",2,0],["مِن كُلِّ فَتانِ الحُلى","ذاكِي الشَذا سامي الخلالِ",67,"ل",1,0],["من كل فياض القريحة ورده","عذب وبحر علومه زخار",68,"ر",1,0],["من كُلِّ فتى بالنّطْعِ بدا","مثلَ القصّارِ إذا احترما",69,"م",2,0],["من كل فاترةِ الاجفان باردةِ ال","رُّضاب ناريَّةِ الخدين تَوريدا",70,"د",2,0],["من كل فارس مهمة","ما همه إلا المهمه",71,"م",2,0],["من كل فاكهةٍ زوجانِ قَدْ نظِما","بسلكِ روضٍ بديعِ الحسنِ منتظِم",72,"م",1,0],["من كل فظ الجسم راحت روحه","تزهو بثقلتها على الثقلين",73,"ن",1,0],["من كل فظ جالسٍ عابسٍ","متى أُسَلِّمْ لا يرد السلام",74,"م",1,0],["مِن كُلِّ فذٍّ ماجِدٍ ألْفاظُهُ","مُسْتَمْتَعُ الأسْماعِ والألْبابِ",75,"ب",1,1],["من كل فج يَنسِلون فَاِترَعت","كَأس السُرور لَهم وَلَيسَ مدام",76,"م",1,0],["من كُل فَجٍّ يَشدونَ الرِحال لَهُ","كَأَنَّهُ كَعبَة قامَت لِمَن قَصدا",77,"د",2,0],["من كل فج تحج الخلق ساحتهم","للامن والاهتدا والنيل للنعم",78,"م",1,0],["من كل فن انشأوا كتباً لنا","بطلي السوى كانت عداً مترصعا",79,"ع",2,0],["من كل فيّاض اليدين غشمشمٍ","للحرب يَتلوه أَخوه عشمشم",80,"م",1,0],["مِن كُل فَيلقَ بِالحَديد مسربلٍ","يَتلوه مرهوبُ السَدادِ عَرمرم",80,"م",1,0],["مِن كُل فَردٍ بالمفاخر مفردٍ","يَسمو عَلى الأَشباه وَالنظراء",81,"ا",2,0],["من كل فاتنةٍ حسناء تحسبها","من ورد نيسان أو من ورد أيار",82,"ر",1,0],["من كلَّف النفوسَ ضِدَّ طَبْعِهَا","أعْيَى بما لا يُرْتجَى مِن نَفْعِهَا",83,"ه",2,0],["من كل فج عميق قد أتوك ولم","يدركهم من عناء السير إعياء",84,"ا",2,0],["من كل فارس أقدام ومكرمة","لاقى المنايا بلاغمٍ ولا منن",85,"ن",1,0],["مِن كُلِّ فَنٍّ جَنى اَحلى خلاصتِهِ","فَكانَ كَالنَحلِ لَكن ما بِهِ إِبرُ",86,"ر",1,0],["مِن كُلِّ فاضِل نَقِيِّ العَرضِ","أَشَم غَطريف جَواد مَرضي",87,"ي",1,0],["من كل فتانه مَهما رنت تركت","أَسد الثَرى بين ماسور وَمنتهب",88,"ب",1,0],["من كل فجٍّ قد تداعت حَلَبُ","في قَحَط وفي غلاءٍ مزمن",89,"ن",1,0],["من كل فدم كالرصاص ثقالة","فظ غليظ دابه التجحير",90,"ر",1,0],["من كل فاترة اللحاظ إذا رنت","يا للرجال من اللحاظ الفاتر",91,"ر",1,0],["من كلّ فجٍّ عَميقٍ يقبلون إِلى ال","بيتِ العَتيق لحجِّ البَيتِ إِقبالا",92,"ل",2,0],["من كل فتَّانةِ العينيْنِ واضحةِ","الخدَّيْنِ ميَّاسةٍ مثلِ الشموسِ تُرَى",93,"ر",2,0],["من كل فتَّانة العينين واضحةِ","الخدَّيْنِ مَيَّاسَةٍ دُرِّيَّةِ الأَشَر",94,"ر",1,0],["من كل فضلٍ صانَها أنفساً","من كل أمر سىءٍ فاسد",95,"د",1,0],["من كل فجٍ عميق جاءَ يقصدها","من كان عاني جهل للكمال عنا",96,"ن",2,0],["من كل فاتنة إذا ما أنشدت","ألقت على الأسماع مسحة ساحر",97,"ر",1,0],["من كل فاتنة بكر ضرائرها","عون وهل يستوي عون وأبكار",98,"ر",1,0],["من كل فاكهةٍ وناعم نبتةٍ","هي في الرغام وليدة الأدران",99,"ن",1,0],["من كلّ فجٍ قد أتاكَ عويلها","ورعاة أبواب السماء تغيبوا",100,"ب",3,0],["من كل فارس بهمة","ما همة إلا المهمه",101,"م",2,0],["مِنْ كُلِّ فَجٍّ يَقُودُ الْهَوْلَ مُنْتَقِمًا","مِمَّنْ عَصَى أَمْرَهُ أَوْ لَمْ يَخَفْ بَطَرَهْ",102,"ر",2,0],["من كلِّ فَواكهِ دُنْيَانا","وخُضَارِ الحَقْلِ الريَّانِ",103,"ن",1,0],["مِنْ كُلِّ فَاتِنَةٍ تَعَلَقَ قَلْبَهَا","بِجَمَالِ شَوْقٍ مَالَهُ مِيثَاقُ",104,"ق",1,0],["من كلِّ فاكهةٍ وألوانٍ بدتْ","نعماً .. تطيبُ لمن أتاها زائِرا",105,"ر",2,0],["مِنْ كُلِّ فَجٍّ قَدْ لَفانا شَرْذِمٌ","وَيؤُمُ شَرْذِمَةَ الحَضيرَةِ( أَزعَرُ )",106,"ر",1,0],["مِن كلِّ فجِّ أُنوثةٍ مُتفجّرٍ","في فتنةٍ يأتينَ كالأسرابِ",107,"ب",1,0],["2-مِن كلِّ فنٍّ لِخَطبِ نازلةٍ","أتَيْتِهِ ما ادَّخرتِ مُصطلَحا",108,"ح",2,0],["مِنْ كُلِّ فَجًّ جَاءَ دَفْقُ مَسِيْلِهِ","والشَّامُ فِيْهِ يُشَايْعُ الصُّوْمَالا",109,"ل",2,0],["من كل فدم لا يزال لسانه","مغرىً بحرف الزاي أو بالقاف",110,"ف",1,1],["من كل فرعونٍ غشيم ظالم","ومكابر من جهله يتبجح",111,"ح",1,0],["من كل فج أقبلوا حُسّراً","شوقاً إلى البيت العتيق الحرامْ",112,"م",1,0],["من كلِّ فاتكة ِ اللِّحاظِ مريضة ٍ","أجفانُها لِظُبا اللِّحاظِ جفونُ",113,"ن",1,0],["منْ كلِّ فاتكة ٍ بطرفٍ أحورٍ،","من كلِّ ثانية ٍ يجيدِ أغيدِ",114,"د",1,0]]}