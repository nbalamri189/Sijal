[435,"قفا فاسألا مني زفيرا وأدمعا","https://www.aldiwan.net/poem12378.html","الطويل"],[437,"غزا القلوب غزال","https://www.aldiwan.net/poem25684.html","المجتث"],[440,"سقاه الصبا خمر الدلال المردد","https://www.aldiwan.net/poem2561.html","الطويل"],[442,"لتهنئ سلامتك المسلمينا","https://www.aldiwan.net/poem34797.html","المتقارب"],[444,"ألا من لصب دائب المهجات","https://www.aldiwan.net/poem14439.html","الطويل"],[446,"بالله يا نسمات الرند والبان","https://www.aldiwan.net/poem55955.html","عموديه"],[460,"أيا ليل جو من بشيرك بالصبح","https://www.aldiwan.net/poem56252.html","الطويل"],[463,"أسى وسرور ناصر ومخذل","https://www.aldiwan.net/poem15268.html","الطويل"],[463,"بقيت غياث الدين ما أظلم الدجى","https://www.aldiwan.net/poem15275.html","الطويل"],[463,"وما فاخرته في المضاء قواضب","https://www.aldiwan.net/poem15622.html","الطويل"],[463,"أقول لساري الليل والليل غابر","https://www.aldiwan.net/poem16236.html","الطويل"],[463,"ولما تراءت كعبة البيت كعبة","https://www.aldiwan.net/poem16377.html","الطويل"],[466,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[466,"وأحور في عينيه هاروت بابل","https://www.aldiwan.net/poem3344.html","عموديه"],[470,"أصبح لا يخشى من الذم","https://www.aldiwan.net/poem59681.html","السريع"],[470,"غزال تدلله دله","https://www.aldiwan.net/poem59767.html","المتقارب"],[470,"ترى بركات بورك فيه بدري","https://www.aldiwan.net/poem59975.html","الوافر"],[470,"خليلي لا عذر على مذهب الهوى","https://www.aldiwan.net/poem60192.html","الطويل"],[470,"بدا بين أثواب حسان الترائب","https://www.aldiwan.net/poem60427.html","الطويل"],[470,"غزال تبدى فأبدى لنا","https://www.aldiwan.net/poem60462.html","المتقارب"],[470,"أمات السرور وأحيا الأسى","https://www.aldiwan.net/poem60525.html","الوافر"],[470,"أيا من ذب عن حرم الإخاء","https://www.aldiwan.net/poem60545.html","الوافر"],[479,"هو الوجد ما بالي أنؤ بحمله","https://www.aldiwan.net/poem15255.html","الطويل"],[479,"هوى بين أحناء الضلوع دفين","https://www.aldiwan.net/poem15260.html","الطويل"],[502,"أواه من ذاك الغزيل الأغن","https://www.aldiwan.net/poem37569.html","الرجز"],[517,"فؤاد بجمر الشوق والوجد يحرق","https://www.aldiwan.net/poem12190.html","الطويل"],[517,"خذ حديثي فإنه معسول","https://www.aldiwan.net/poem12218.html","الخفيف"],[546,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[553,"ألا هل أتاها كيف حزني بعدها","https://www.aldiwan.net/poem47860.html","الطويل"],[560,"غزال ذاك الحمى صبري قضى فيه","https://www.aldiwan.net/poem33644.html","البسيط"],[560,"معان بدت فينا حروف سطورها","https://www.aldiwan.net/poem34471.html","الطويل"],[564,"غزالة معشر فيها نفار","https://www.aldiwan.net/poem52714.html","الوافر"],[564,"خذوا حذركم من طرفه فهو قتال","https://www.aldiwan.net/poem52839.html","الطويل"],[564,"أتعلم ما هاجت بقلبي من الشغل","https://www.aldiwan.net/poem52926.html","الطويل"],[569,"شطت لليلى باللوى","https://www.aldiwan.net/poem69615.html","مجزوء الرجز"],[569,"غدا وغدا تورد وجنتيه","https://www.aldiwan.net/poem69626.html","الوافر"],[577,"طراز غرامي في المحبة مذهب","https://www.aldiwan.net/poem2984.html","الطويل"],[577,"لست الملوم بما تجني علي بصري","https://www.aldiwan.net/poem3066.html","البسيط"],[588,"غرامي فيكم ما ألذ وأطيبا","https://www.aldiwan.net/poem17429.html","الطويل"],[588,"خذوا خبرا عن نظم دمعي ونثره","https://www.aldiwan.net/poem17548.html","الطويل"],[588,"غدا نافرا يدني الهوى وهو شاحط","https://www.aldiwan.net/poem17580.html","الطويل"],[975,"","https://poetry.dctabudhabi.ae/diwan/poem/79680","الوافر"],[1139,"","https://poetry.dctabudhabi.ae/diwan/poem/29462","المتقارب"]],"verses":[["غَزالٌ ماطِلٌ دَيني","بِأَجزاعِ الغَديرَينِ",0,"ن",1,1],["غَزالٌ رَعى نَبتَ العِراقِ وَطُرقُهُ","رِحابٌ فَأَمسَت في الحِجازِ مَراتِعُه",1,"ع",2,0],["غَزالٌ مَراتِعُهُ بِالبَليخِ","إِلى دَيرِ زَكّى وَقَصرِ الخَشَب",2,"ب",1,0],["غَزالَةِ رَبْرَبٍ ومَهاةِ قَفْرٍ","تَعوّدَ طَرْفُها صَيْدَ الأسودِ",3,"د",1,0],["غَزَى فأبْلى وخَيْلُ اللهِ قد عُقِدت","باليُمنِ والنَّصْرِ والبُشْرَى نَواصِيها",4,"ي",3,0],["غَزالُكَ بِالوَعساءِ مِن أَرضِ وَجرَةٍ","يصيفُ وَيَشتو مِن وَراءِ الخَوَرنَقِ",5,"ق",1,1],["غَزَالٌ أَدعَجُ العَينِ","رَبيبُ خَدَلَّجِ ساقُه",6,"ق",2,0],["غزوت غزو سلام دون غايته","غَزو الحروب فأنت الفاتح الغازي",7,"ز",2,0],["غَزا نَمِرٌ وَقادَ بَني تَميمٍ","وَمَرَّ لَهُ الأَيامِنُ بِالسُعودِ",8,"د",1,1],["غَزا الرومَ لَم يَقصِد جَوانِبَ غِرَّةٍ","وَلا سَبَقَتهُ بِالمُرادِ النَذائِرُ",9,"ر",1,0],["غزال رعت في الحب أخضر عيشتي","لقد أعرض الظبي الأغن عن الطلح",10,"ح",1,0],["غزاني جفنه وشكا فتوراً","فواحرباه من شاكي السلاح",11,"ح",1,0],["غزالٌ يناجيني بلفظٍ معرّب","ولكنه يسطو بلحظٍ مهند",12,"د",1,0],["غزالٌ كالغزالة في سناها","تحجبه الملاحة بالستور",13,"ر",1,0],["غزَا إلى الجيش منصور اللوا ودنا","جيش السؤال إلى أمواله فغزي",14,"ز",2,0],["غزال رملٍ ولكن غير ملتفتٍ","وغصنُ بانٍ ولكن غير منعطف",15,"ف",1,0],["غزالة الجفن من غزلان مصر لقد","ملأت من غزلك الدنيا ومن غزل",16,"ل",1,0],["غزالةَ الحيّ إشراقاً وملتفتاً","ما كفؤ جيدك إلا عقد أغزالي",17,"ل",2,0],["غزالُ رملٍ تحلو جنايته","وغصن بانٍ يعزّ مجناه",18,"ا",2,0],["غزلت عيناك لي","ثوب سقم ليس يبلى",19,"ل",2,0],["غزاني بخديه بياض وحمرة","فويلاه من قيسيه يمنيّه",20,"ي",2,0],["غَزَليّاً وتارةً جَدَليَّا","مستعداً لكل خصم عنيدِ",21,"د",1,0],["غزال رمتْ بالنبل أهدابُ جفنه","وكم صادتِ الآسادَ بالشَرك الشَّعر",22,"ر",1,0],["غزالٌ وإبريق رذُومٌ وغادةٌ","تُحرّكُ من أوتارها وتُنَغِّمُ",23,"م",1,0],["غَزَلٌ وَمَدحٌ بِتُّ أَغرَقُ فيهِما","كَالخَمرِ مازَجَتِ الزُلالَ السَلسَلا",24,"ل",2,0],["غَزَلٌ أَرَقُّ مِنَ الصَبابَةِ وَالصِبا","وَجَعَلتُ مَدحي في الأَميرِ مُكَفِّرا",25,"ر",2,0],["غَزوٌ عَلَيكَ مُبارَكٌ","في طَيِّهِ الفَتحُ القَريبْ",26,"ب",1,0],["غَزاليَّةُ العَينَينِ شَمسيَّةُ السَنا","كَثيبيَّةُ الرِدفَينِ غُصنيَّةُ القَدِّ",27,"د",1,0],["غزال في يديه التي","ه بين الغيد يقسمه",28,"م",2,0],["غَزالَةٌ مَرَّت عَلى أَتانِ","تُقَبِّلُ الفَطيمَ في الأَسنانِ",29,"ن",1,1],["غَزَواتُ أَدهَمَ كُلِّلَت بَذَوابِلٍ","وَفُتوحُ أَنوَرَ فُصِّلَت بِصِفاحِ",30,"ح",1,0],["غَزَتِ القُرونَ الذاهِبينَ غَزالَةٌ","دَمُهُم بِذِمَّةِ قَرنِها الرَعّافِ",31,"ف",1,0],["غَزَوتَ بِها دورَ المُلوكِ فَباشَرَت","سَنابِكُها هاماتِهِم وَالمَغانِيا",32,"ي",2,0],["غزالٌ له مرعىً من القلب مخصبٌ","وظِلٌّ صفيقُ الجانبين ظليلُ",33,"ل",1,0],["غزِلاً يدرِّسُكَ التصابي صارمٌ","سَحُّ المقاطعِ لا حمامٌ ساجعُ",34,"ع",1,0],["غُزرَهُ وِجهَةَ العِدى وَتِجاهي","خُلفَ إيماضِ بَرقِهِ وَخُمودُه",35,"د",2,0],["غَزاهُم فَأَفناهُم وَلَم يَقتَصِر لَهُم","عَلى العامِ حَتّى جَدَّدَ الغَزوَ قابِلا",36,"ل",2,0],["غَزاكُمُ بِقُلوبٍ ما لَها خَلَلٌ","مِن خَلفِها وَسُيوفٍ ما لَها خَلَلُ",37,"ل",1,0],["غَزالٌ فيهِ إِعراضٌ","وَإِبعادٌ وَهِجرانُ",38,"ن",1,0],["غَزالَةُ الشَمسِ لا يَصحو الفُؤادُ بِها","حَتّى تَرَوَّحتُ لَأياً بَعدَ إيصالِ",39,"ل",1,0],["غَزا مِن أُصولِ النَخلِ حَتّى إِذا اِنتَهى","بِكِنهِلَ أَدّى رُمحُهُ شَرَّ مَغنَمِ",40,"م",1,0],["غَزَونا بِهِ أَرضَ العَدُوِّ وَمَوَّلَت","صَعاليكَنا أَنفالُهُ وَمَقاسِمُه",41,"م",2,0],["غَزْوٌ إذا العامُ أبقَى منه باقيةً","أتاه يُزْجي لحَتْفِ الثَّغْرِ قَابِلُه",42,"ل",2,0],["غَزَت سِماناً فَآبَت ضُمَّراً خُدُجاً","مِن بَعدِ ما جَنَبوها بُدَّناً عُقُقا",43,"ق",2,0],["غَزالَةُ سِربٍ كُنتُ أَخشى نِفارَها","فَأَصبَحتُ مَع فَوزي بِها آمِنَ السَربِ",44,"ب",1,0],["غَزاهُم لِساني بَعدَ غَزوِ يَدي لَهُم","فَلا عَجَبٌ أَن يَستَمِروا عَلى بُغضي",45,"ض",2,0],["غَزَوْتَ عدوّكَ في أرضهِ","ففرّ إلى طرَفِ الناحيه",46,"ه",1,1],["غزالةُ السرب التي جسمها","مَعَانُ مسكٍ ما علاه ختام",47,"م",1,0],["غزالٌ سقيمُ الطّرْفِ أفْنيتُ صحّتي","ولم تغنِ شيئاً في عِلاجِ سقامهِ",48,"م",2,0],["غَزالٌ تَراني ناصِباً من تَغَزّلي","له شَرَكاً في كلّ حالٍ يُشارِكُه",49,"ك",2,0],["غَزوَةٌ مُتبِعٌ وَلَو كانَ رَأيٌ","لَم تَفَرَّد بِهِ لَكانَت سَلوبا",50,"ب",2,0],["غَزَالٌ أَحْوَرُ الْعَيْنَيْ","نِ لا يَسْلُو مُتَيَّمُهُ",51,"م",2,0],["غزا وصلَّى صائماً عاكفاً","وكُمِّل الظاهرُ بالباطنِ",52,"ن",1,1],["غزالَيْ فلا وهلالَيْ دجى","وشمسَيْ ضحى وقضيبَيْ نقا",53,"ق",2,0],["غَزالِيَّةُ الأَلحاظِ ريمِيَّةُ الطُلى","مُدامِيَّةُ الأَلمى حَبابِيَّةُ الثَغرِ",54,"ر",1,0],["غَزالانِ شَبّا في نَعيمٍ وَغِبطَةٍ","مِنَ الناسِ مَذعورانِ مُحتَبِسانِ",55,"ن",1,0],["غُزاةُ الشَّعبِ والشّعبُ المواضي","وأسرابُ الصوافنِ والجنودُ",56,"د",1,0],["غزاكم بمن لا تَعرِفُ الحربُ غيرَهم","إذا انتسبَ الأبطالُ في كلِّ مَشهدِ",57,"د",1,0],["غَزَالٌ فِي لَوَاحِظشهِ لُيوثٌ","وَفِي وَجَنَاتِهِ مَاءٌ وَنَارُ",58,"ر",1,0],["غَزالٌ بَراهُ اللَهُ مِن مِسكَةٍ سَبى","بِها الحُسنُ مِنّا مُسكَةَ المُتَجَلِّدِ",59,"د",1,0],["غَزالاً شَفَّهُ هَمٌّ","لِأَنّي لَستُ آتِيهِ",60,"ي",2,0],["غَزالٌ مُخطَفُ الكَشحِ","لَطيفُ الخَصرِ وَالحَقوِ",61,"و",1,0],["غَزالٌ صَفا ماءُ الشَبابِ بِخَدِّهِ","فَضاقَت عَلَيهِ سورُهُ وَدَمالِجُه",62,"ج",2,0],["غَزْوٌ رَمَى صُمَّ الجِبالِ بعزمِهِ","حتى ألانَ متونَها بمُتونِهِ",63,"ن",2,0],["غَزَوتُهُ بُمُخطَفٍ وَثَوبِ","مُضَمَّرِ الكَشحَينِ كَاليَعسوبِ",64,"ب",1,0],["غَزالٌ لَم يَحُز هَذا","لِخَلقٍ غَيرِهِ عِندي",65,"د",2,0],["غَزالٌ بِهِ فَترٌ وَفيهِ تَأَنُّثٌ","وَأَحسَنُ مَخلوقٍ وَأَجمَلُ مَن مَشى",66,"ش",2,1],["غزالٌ ليس مخلوقاً","كخلقِ الناس من طينِ",67,"ن",1,0],["غزالَ العمر في خلل الديار","فِداكَ مع اللحى شكلُ الجواري",68,"ر",2,1],["غَزالَةٌ غَصَبَت لَيثاً بِمُقلَتِها","لَم أَرَ كَاليَومَ مَغصوباً وَمُغتَصِبا",69,"ب",2,0],["غَزالٌ مِنْ بَني العاصِ","أَحَسَّ بِصَوتِ قَنَّاصِ",70,"ص",1,1],["غَزا وكانَ أَنجدَ الأَنجادِ","وقائداً من أَفحلِ القُوَّادِ",71,"د",1,0],["غزا الإمامُ في ذوي السُّلطانِ","يَؤُمُّ أَهلَ النُّكْثِ والطُّغيانِ",71,"ن",1,0],["غزا الإمامُ يَنْتحي بِبُشْتَرا","في عسْكرٍ أَعظمْ بذاكَ عَسْكرا",71,"ر",2,0],["غزا الإمامُ حولَه كتائبُه","كالبدْرِ محفوفاً به كواكبُه",71,"ه",1,0],["غزا وسيفُ النَّصر في يَمينهِ","وطالعُ السَّعدِ على جَبينهِ",71,"ه",1,0],["غَزالٌ ليسَ لي منْهُ","سوى الحزنِ الطَّويلِ",72,"ل",1,0],["غزالٌ زانَهُ الحَوَرُ","وساعَدَ طَرفَهُ القَدَرُ",73,"ر",1,1],["غَزَالُ خَلاَءٍ تَصَدَّى لَهُ","لِتُرْضِعَهُ دِرَّةً أَوْ عُلاَلاَ",74,"ل",2,0],["غَزلاً يملك بالشعر مقاليدَ النساءِ","كلما هام بأُنثى أو صَبا بعد اشتهاءِ",75,"ا",2,0],["غَزالُكِ تَفْرَقُ منه اللُّيُوثُ","وتَهْرُبُ منه كُمَاةُ المصاعِ",76,"ع",1,0],["غَزَتني جُنودُ الحُبِّ مِن كُلِّ جانِبٍ","إِذا حانَ مِن جُندٍ قُفولٌ أَنى جُندُ",77,"د",1,0],["غَزالانِ شَبّا في نَعيمٍ وَغِبطَةٍ","وَرَغدَةِ عَيشٍ ناعِمٍ عَطِرانِ",78,"ن",1,0],["غَزَالٌ لَهُ نَظْرَةٌ","أَعَانَتْ عَليَّ الْكَلَفْ",79,"ف",1,0],["غَزَونْ وَهلْ فِي النَّصْرِ شَكٌ إِذَا غَزَتْ","فَوَاتِكَ بِالأَسيَافِ وَالسَّمْرِ وَالْقَسِي",80,"س",2,0],["غَزَانَا عَامُنَا المَاضِي","غَزَاةَ الظُّلْمِ وَالقَهْرِ",81,"ر",1,0],["غزا الهدى الكفر لا فرسٌ ولا عرب","يا وقعة هزت الدنياتهانيها",82,"ي",3,0],["غَزالٌ تَحَلّى بِالبَهاءِ وَبِالسَّنا","وَناهيكَ مِن حليٍ لَهُ اللَهُ صائِغُ",83,"غ",1,0],["غَزَتني عُيونٌ أَيَّدَتها عَلى دَمي","عَقارِبُ مِسكٍ لِلقُلوبِ لَوادِغُ",83,"غ",1,0],["غَزَلٌ أذهل الغواني عن الحس","نِ ومن أين مثلُه للغواني",84,"ن",2,0],["غَزَلٌ كالشَّبَابِ ينْضَحُ آما","لاً ويهْتزُّ في حلىً فَتَّانَهْ",85,"ن",2,0],["غزُوه بجيشٍ بالدهاءِ مُحارِبٌ","ولكنّه بالسيف غير محاربِ",86,"ب",1,0],["غَزَلٌ كالشبَابِ أَسْجَحُ رَيَّا","نُ يُذِيبُ الْقَاسي ويُدْنِي الْمَلُولا",87,"ل",2,0],["غزتِ القلوبَ بسحرها؛ فكأنها","قد لامست منهن كل شَغَاف",88,"ف",1,0],["غزوْتَ العروشَ، وبعد العروش","تَتَبَّعْتَ بالغزو عُبَّادها",89,"د",3,0],["غزالك تفرق منه الليوث","وتنصاع منه كماة المصاع",90,"ع",1,0],["غَزَتْ أمم الغربِ الحياةَ تُريدُها","وما زوُدَّت غيرَ الشبابِ متاعا",91,"ع",2,0],["غَزَتْ مُهجتي حتَّى ألانَتْ صَفاتَها","ولاثَتْ دمي حتى أضَرَّتْ بطابَعي",92,"ع",2,0],["غَزَلْتَهُ وَهْوَ مَذْمُومٌ عَلَى صُغُرٍ","ولمْ يَكَدْ لِلَجَاجِ الغيِّ يَنْعَزِلُ",93,"ل",1,0],["غزل يسكر النفوس ويدني","ما نأى من خيالها المنشود",94,"د",1,0],["غزل يفارق من أحبّ وسرّه","أن فارق التكبير والتهليلا",95,"ل",2,0],["غَزَاليّاً وتارة ً جَدَليَّا","مستعداً لكل خصم عنيدِ",96,"د",1,0],["غزال ، وأبريق رذومٌ ، وغادة","لتَفتَرَّ عنه في مواطن جَمَّة ٍ",97,"م",2,0],["غزا الجهلُ أرض الرافدْينِ فحلَّها","كثيرَ السَّرايا مُستجاشَ الكتائب",98,"ب",1,0],["غَزالة الأُفق سَعدي حينَ قارنها","بِرَوعِها لِسَواد الحَظ ذابحهُ",99,"ح",2,0],["غَزالية تَغشي العُيون جَلالة","مَغاربها أَحشاؤُنا وَالمَشارِقُ",100,"ق",1,0],["غزيل فاتر الاجفان ذو حور","الله كم اقطرت عيناه اجفانا",101,"ن",2,0],["غزال حل في شطحات قلبي","وصيرها له بعض المضاحى",102,"ح",2,0],["غزا اهل النهى بوجو