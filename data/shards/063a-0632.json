{"poems":[[53,"غزال ماطل ديني","https://www.aldiwan.net/poem29739.html","الهزج"],[55,"عفا الله عمن لم يزرني مودعا","https://www.aldiwan.net/poem26248.html","الطويل"],[55,"سلام على النازح المغترب","https://www.aldiwan.net/poem26493.html","المتقارب"],[77,"أدرها بين مزمار وعود","https://www.aldiwan.net/poem36609.html","الوافر"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[71,"غزالك بالوعساء من أرض وجرة","https://www.aldiwan.net/poem3911.html","الطويل"],[41,"أبى القلب اليماني","https://www.aldiwan.net/poem42364.html","الهزج"],[88,"قل للحكومات في البلقان هل علقت","https://www.aldiwan.net/poem44467.html","البسيط"],[27,"غزا نمر وقاد بني تميم","https://www.aldiwan.net/poem5719.html","الوافر"],[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[72,"سرت قمرا من مسبل الشعر في جنح","https://www.aldiwan.net/poem18478.html","الطويل"],[72,"خلقت على مرادي واقتراحي","https://www.aldiwan.net/poem18479.html","الوافر"],[72,"عذيري من ساجي اللواحظ أغيد","https://www.aldiwan.net/poem18545.html","الطويل"],[72,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[72,"قد أمكنت فرص اللذات فانتهز","https://www.aldiwan.net/poem18999.html","البسيط"],[72,"يحير الغصن بين اللين والهيف","https://www.aldiwan.net/poem19267.html","البسيط"],[72,"إنسان عيني بتعجيل السهاد بلي","https://www.aldiwan.net/poem19471.html","البسيط"],[72,"في ثغرها الحلو أو في جيدها الحالي","https://www.aldiwan.net/poem19473.html","البسيط"],[72,"له إذا غازلتك عيناه","https://www.aldiwan.net/poem20512.html","المنسرح"],[72,"يا حبيب القلب أهلا","https://www.aldiwan.net/poem20550.html","مجزوء الرمل"],[72,"تبسم عن حلو الرضاب شهيه","https://www.aldiwan.net/poem20563.html","الطويل"],[51,"أيها السيد الذي ورث السؤدد","https://www.aldiwan.net/poem10880.html","الخفيف"],[51,"نسيم الصبا حيا الندامى من الزهر","https://www.aldiwan.net/poem64114.html","الطويل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[70,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[70,"أعلمتم أن النسيم إذا سرى","https://www.aldiwan.net/poem42922.html","السريع"],[78,"لا بد من فرج قريب","https://www.aldiwan.net/poem14180.html","مجزوء الكامل"],[78,"رعى الله من يصلى فؤادي بحبه","https://www.aldiwan.net/poem14243.html","الطويل"],[85,"به هجر يتيمه","https://www.aldiwan.net/poem7140.html","مجزوء الوافر"],[85,"غزالة مرت على أتان","https://www.aldiwan.net/poem8007.html","الرجز"],[85,"عادت أغاني العرس رجع نواح","https://www.aldiwan.net/poem21008.html","الكامل"],[85,"أجل وإن طال الزمان موافي","https://www.aldiwan.net/poem62840.html","الكامل"],[43,"كفى بك داء أن ترى الموت شافيا","https://www.aldiwan.net/poem10604.html","الطويل"],[62,"تصدى وللحي الجميع رحيل","https://www.aldiwan.net/poem52316.html","الطويل"],[62,"إن العيون إذا نطقت تخاوصت","https://www.aldiwan.net/poem52341.html","الكامل"],[45,"لا يرم ربعك السحاب يجوده","https://www.aldiwan.net/poem63508.html","الخفيف"],[45,"أرى بين ملتف الأراك منازلا","https://www.aldiwan.net/poem65533.html","الطويل"],[45,"لا دمنة بلوى خبت ولا طلل","https://www.aldiwan.net/poem65579.html","البسيط"],[45,"فؤادي منك ملآن","https://www.aldiwan.net/poem66687.html","الهزج"],[28,"كم للملاءة من أطلال منزلة","https://www.aldiwan.net/poem5379.html","البسيط"],[28,"وقائلة والدمع يحدر كحلها","https://www.aldiwan.net/poem5499.html","الطويل"],[28,"غنمنا فقيما إذ فقيم غنيمة","https://www.aldiwan.net/poem5521.html","الطويل"],[61,"أجل هو الفتح لا فتح يشاكله","https://www.aldiwan.net/poem51478.html","البسيط"],[2,"إن الخليط أجد البين فانفرقا","https://www.aldiwan.net/poem25062.html","البسيط"],[66,"تراءت لنا بين الأكلة والحجب","https://www.aldiwan.net/poem38517.html","الطويل"],[66,"قليل إلى غير اكتساب العلى نهضي","https://www.aldiwan.net/poem41579.html","الطويل"],[80,"غزوت عدوك في أرضه","https://www.aldiwan.net/poem31248.html","المتقارب"],[80,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[80,"أقول لبرق شمته في غمامه","https://www.aldiwan.net/poem31298.html","الطويل"],[80,"أخذت برأي في الصبا أنا تاركه","https://www.aldiwan.net/poem31356.html","الطويل"],[44,"من سجايا الطلول ألا تجيبا","https://www.aldiwan.net/poem30582.html","الخفيف"],[87,"عليل أنت مسقمه","https://www.aldiwan.net/poem8277.html","مجزوء الوافر"],[69,"غزا وصلى صائما عاكفا","https://www.aldiwan.net/poem27997.html","السريع"],[69,"رأيت مليحين لو أنصفا","https://www.aldiwan.net/poem28250.html","المتقارب"],[74,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[33,"أيا جبل الدوم الذي في ظلاله","https://www.aldiwan.net/poem25777.html","الطويل"],[105,"أتسأل مصر ما حمل العميد","https://www.aldiwan.net/poem42123.html","الوافر"],[105,"بني مذحج ما ثم من متردد","https://www.aldiwan.net/poem43587.html","الطويل"],[81,"خليلي قم لقد صفت العقار","https://www.aldiwan.net/poem61363.html","الطويل"],[81,"أقلد وجدي فليبرهن مفندي","https://www.aldiwan.net/poem61539.html","الطويل"],[40,"إني زائر ظبيا","https://www.aldiwan.net/poem42304.html","الهزج"],[52,"أللمنزل بالحنو","https://www.aldiwan.net/poem26584.html","الهزج"],[52,"ألا ما لقلب لا تقضى حوائجه","https://www.aldiwan.net/poem27179.html","الطويل"],[75,"متهلل والبدر فوق جبينه","https://www.aldiwan.net/poem69030.html","الكامل"],[48,"يا رب خرق نازح حديب","https://www.aldiwan.net/poem62452.html","الرجز"],[48,"أميري حال عن عهدي","https://www.aldiwan.net/poem62590.html","الهزج"],[48,"غزال به فتر وفيه تأنث","https://www.aldiwan.net/poem64352.html","الطويل"],[48,"أما والطورِ والنورِ","https://www.aldiwan.net/poem66557.html","الهزج"],[48,"غزال العمر في خلل الديار","https://www.aldiwan.net/poem66576.html","الوافر"],[50,"يا شوق من بات مشغوفا ومجتنبا","https://www.aldiwan.net/poem64811.html","البسيط"],[76,"غزال من بني العاص","https://www.aldiwan.net/poem38841.html","مخلع البسيط"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[76,"متى أشفي غليلي","https://www.aldiwan.net/poem39009.html","الهزج"],[76,"غزال زانه الحور","https://www.aldiwan.net/poem39307.html","مجزوء الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39605","الرمل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30469","المتقارب"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10743","الطويل"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10950","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42698","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54972","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54824","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43648","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54197","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[106,"ذكرى محمد ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=179428",""],[106,"أعياد النصر","https://www.poetsgate.com/ViewPoem.aspx?id=179343",""],[84,"وناظرة تحت طي القناع","https://www.poetsgate.com/ViewPoem.aspx?id=26333",""],[90,"شباب ضائع","https://www.poetsgate.com/ViewPoem.aspx?id=179161",""],[90,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[45,"للهِ ما تَصْنَعُ الأَجْيادُ والمُقَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32071",""],[51,"أيها السيد الذي ورث السؤ","https://www.poetsgate.com/ViewPoem.aspx?id=27683",""],[51,"وصفراء بكرٍ ، لاقذاها مغيَّبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=25878",""],[90,"لعبة التجارب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66767&r=&rc=175",""]],"verses":[["غَزالٌ ماطِلٌ دَيني","بِأَجزاعِ الغَديرَينِ",0,"ن",1,1],["غَزالٌ رَعى نَبتَ العِراقِ وَطُرقُهُ","رِحابٌ فَأَمسَت في الحِجازِ مَراتِعُه",1,"ع",2,0],["غَزالٌ مَراتِعُهُ بِالبَليخِ","إِلى دَيرِ زَكّى وَقَصرِ الخَشَب",2,"ب",1,0],["غَزالَةِ رَبْرَبٍ ومَهاةِ قَفْرٍ","تَعوّدَ طَرْفُها صَيْدَ الأسودِ",3,"د",1,0],["غَزَى فأبْلى وخَيْلُ اللهِ قد عُقِدت","باليُمنِ والنَّصْرِ والبُشْرَى نَواصِيها",4,"ي",3,0],["غَزالُكَ بِالوَعساءِ مِن أَرضِ وَجرَةٍ","يصيفُ وَيَشتو مِن وَراءِ الخَوَرنَقِ",5,"ق",1,1],["غَزَالٌ أَدعَجُ العَينِ","رَبيبُ خَدَلَّجِ ساقُه",6,"ق",2,0],["غزوت غزو سلام دون غايته","غَزو الحروب فأنت الفاتح الغازي",7,"ز",2,0],["غَزا نَمِرٌ وَقادَ بَني تَميمٍ","وَمَرَّ لَهُ الأَيامِنُ بِالسُعودِ",8,"د",1,1],["غَزا الرومَ لَم يَقصِد جَوانِبَ غِرَّةٍ","وَلا سَبَقَتهُ بِالمُرادِ النَذائِرُ",9,"ر",1,0],["غزال رعت في الحب أخضر عيشتي","لقد أعرض الظبي الأغن عن الطلح",10,"ح",1,0],["غزاني جفنه وشكا فتوراً","فواحرباه من شاكي السلاح",11,"ح",1,0],["غزالٌ يناجيني بلفظٍ معرّب","ولكنه يسطو بلحظٍ مهند",12,"د",1,0],["غزالٌ كالغزالة في سناها","تحجبه الملاحة بالستور",13,"ر",1,0],["غزَا إلى الجيش منصور اللوا ودنا","جيش السؤال إلى أمواله فغزي",14,"ز",2,0],["غزال رملٍ ولكن غير ملتفتٍ","وغصنُ بانٍ ولكن غير منعطف",15,"ف",1,0],["غزالة الجفن من غزلان مصر لقد","ملأت من غزلك الدنيا ومن غزل",16,"ل",1,0],["غزالةَ الحيّ إشراقاً وملتفتاً","ما كفؤ جيدك إلا عقد أغزالي",17,"ي",1,0],["غزالُ رملٍ تحلو جنايته","وغصن بانٍ يعزّ مجناه",18,"ا",2,0],["غزلت عيناك لي","ثوب سقم ليس يبلى",19,"ل",2,0],["غزاني بخديه بياض وحمرة","فويلاه من قيسيه يمنيّه",20,"ي",2,0],["غَزَليّاً وتارةً جَدَليَّا","مستعداً لكل خصم عنيدِ",21,"د",1,0],["غزال رمتْ بالنبل أهدابُ جفنه","وكم صادتِ الآسادَ بالشَرك الشَّعر",22,"ر",1,0],["غزالٌ وإبريق رذُومٌ وغادةٌ","تُحرّكُ من أوتارها وتُنَغِّمُ",23,"م",1,0],["غَزَلٌ وَمَدحٌ بِتُّ أَغرَقُ فيهِما","كَالخَمرِ مازَجَتِ الزُلالَ السَلسَلا",24,"ل",2,0],["غَزَلٌ أَرَقُّ مِنَ الصَبابَةِ وَالصِبا","وَجَعَلتُ مَدحي في الأَميرِ مُكَفِّرا",25,"ر",2,0],["غَزوٌ عَلَيكَ مُبارَكٌ","في طَيِّهِ الفَتحُ القَريبْ",26,"ب",1,0],["غَزاليَّةُ العَينَينِ شَمسيَّةُ السَنا","كَثيبيَّةُ الرِدفَينِ غُصنيَّةُ القَدِّ",27,"د",1,0],["غزال في يديه التي","ه بين الغيد يقسمه",28,"م",2,0],["غَزالَةٌ مَرَّت عَلى أَتانِ","تُقَبِّلُ الفَطيمَ في الأَسنانِ",29,"ن",1,1],["غَزَواتُ أَدهَمَ كُلِّلَت بَذَوابِلٍ","وَفُتوحُ أَنوَرَ فُصِّلَت بِصِفاحِ",30,"ح",1,0],["غَزَتِ القُرونَ الذاهِبينَ غَزالَةٌ","دَمُهُم بِذِمَّةِ قَرنِها الرَعّافِ",31,"ف",1,0],["غَزَوتَ بِها دورَ المُلوكِ فَباشَرَت","سَنابِكُها هاماتِهِم وَالمَغانِيا",32,"ي",2,0],["غزالٌ له مرعىً من القلب مخصبٌ","وظِلٌّ صفيقُ الجانبين ظليلُ",33,"ل",1,0],["غزِلاً يدرِّسُكَ التصابي صارمٌ","سَحُّ المقاطعِ لا حمامٌ ساجعُ",34,"ع",1,0],["غُزرَهُ وِجهَةَ العِدى وَتِجاهي","خُلفَ إيماضِ بَرقِهِ وَخُمودُه",35,"د",2,0],["غَزاهُم فَأَفناهُم وَلَم يَقتَصِر لَهُم","عَلى العامِ حَتّى جَدَّدَ الغَزوَ قابِلا",36,"ل",2,0],["غَزاكُمُ بِقُلوبٍ ما لَها خَلَلٌ","مِن خَلفِها وَسُيوفٍ ما لَها خَلَلُ",37,"ل",1,0],["غَزالٌ فيهِ إِعراضٌ","وَإِبعادٌ وَهِجرانُ",38,"ن",1,0],["غَزالَةُ الشَمسِ لا يَصحو الفُؤادُ بِها","حَتّى تَرَوَّحتُ لَأياً بَعدَ إيصالِ",39,"ل",1,0],["غَزا مِن أُصولِ النَخلِ حَتّى إِذا اِنتَهى","بِكِنهِلَ أَدّى رُمحُهُ شَرَّ مَغنَمِ",40,"م",1,0],["غَزَونا بِهِ أَرضَ العَدُوِّ وَمَوَّلَت","صَعاليكَنا أَنفالُهُ وَمَقاسِمُه",41,"م",2,0],["غَزْوٌ إذا العامُ أبقَى منه باقيةً","أتاه يُزْجي لحَتْفِ الثَّغْرِ قَابِلُه",42,"ل",2,0],["غَزَت سِماناً فَآبَت ضُمَّراً خُدُجاً","مِن بَعدِ ما جَنَبوها بُدَّناً عُقُقا",43,"ق",2,0],["غَزالَةُ سِربٍ كُنتُ أَخشى نِفارَها","فَأَصبَحتُ مَع فَوزي بِها آمِنَ السَربِ",44,"ب",1,0],["غَزاهُم لِساني بَعدَ غَزوِ يَدي لَهُم","فَلا عَجَبٌ أَن يَستَمِروا عَلى بُغضي",45,"ي",1,0],["غَزَوْتَ عدوّكَ في أرضهِ","ففرّ إلى طرَفِ الناحيه",46,"ه",1,1],["غزالةُ السرب التي جسمها","مَعَانُ مسكٍ ما علاه ختام",47,"م",1,0],["غزالٌ سقيمُ الطّرْفِ أفْنيتُ صحّتي","ولم تغنِ شيئاً في عِلاجِ سقامهِ",48,"م",2,0],["غَزالٌ تَراني ناصِباً من تَغَزّلي","له شَرَكاً في كلّ حالٍ يُشارِكُه",49,"ك",2,0],["غَزوَةٌ مُتبِعٌ وَلَو كانَ رَأيٌ","لَم تَفَرَّد بِهِ لَكانَت سَلوبا",50,"ب",2,0],["غَزَالٌ أَحْوَرُ الْعَيْنَيْ","نِ لا يَسْلُو مُتَيَّمُهُ",51,"م",2,0],["غزا وصلَّى صائماً عاكفاً","وكُمِّل الظاهرُ بالباطنِ",52,"ن",1,1],["غزالَيْ فلا وهلالَيْ دجى","وشمسَيْ ضحى وقضيبَيْ نقا",53,"ق",2,0],["غَزالِيَّةُ الأَلحاظِ ريمِيَّةُ الطُلى","مُدامِيَّةُ الأَلمى حَبابِيَّةُ الثَغرِ",54,"ر",1,0],["غَزالانِ شَبّا في نَعيمٍ وَغِبطَةٍ","مِنَ الن