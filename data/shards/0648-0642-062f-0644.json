.ae/diwan/poem/131649",""],[4178,"","https://poetry.dctabudhabi.ae/diwan/poem/146401","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94457","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94594","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94434","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73314","الوافر"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136468",""],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117228","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133075","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58068","الطويل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116059","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141676","الطويل"],[4660,"","https://poetry.dctabudhabi.ae/diwan/poem/143982","الطويل"],[4740,"لا نامت أعين الجبناء","https://www.poetsgate.com/ViewPoem.aspx?id=206374",""],[1012,"لقد دارت على رغم الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=124956",""],[4578,"بسادس شعبان جنى اليمين أينما","https://www.poetsgate.com/ViewPoem.aspx?id=49469",""],[4927,"عودة العيد","https://www.poetsgate.com/ViewPoem.aspx?id=4584",""],[585,"رعى الله ريماً أهيف القد أهضما","https://www.poetsgate.com/ViewPoem.aspx?id=161933",""],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[5106,"الطَّيَِبُوْنَ .. شَرِبْنَا المِسْكَ وَالصَ","https://www.poetsgate.com/ViewPoem.aspx?id=148667",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5376,"تناغي الهوى في قلبها العشق والوصلُ","https://www.poetsgate.com/ViewPoem.aspx?id=190151",""],[5397,"هي الدنيا لها وصل وصد","https://www.poetsgate.com/ViewPoem.aspx?id=157913",""],[5397,"تطارحني الحمائم بالنواح","https://www.poetsgate.com/ViewPoem.aspx?id=157915",""],[5431,"وإن ضاقتِ السُبْلُ","https://www.poetsgate.com/ViewPoem.aspx?id=190098",""],[5582,"كَئِيبٌ نَأَى عَنْهُ أَحْبابُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=186704",""],[5582,"أَلا حَيِّ مِنْ دارِ سُعْدَى مُقامَا","https://www.poetsgate.com/ViewPoem.aspx?id=63572",""],[5691,"مأمن الله","https://www.poetsgate.com/ViewPoem.aspx?id=206667",""],[5776,"الغلام والملكة","https://www.poetsgate.com/ViewPoem.aspx?id=199336",""],[5809,"حروف","https://www.poetsgate.com/ViewPoem.aspx?id=205351",""],[469,"وصاحب أنسٍ تعشق الفضلَ نفسه","https://www.poetsgate.com/ViewPoem.aspx?id=39824",""],[5943,"نبضُ القلبِ","https://www.poetsgate.com/ViewPoem.aspx?id=11703",""],[5992,"ولاحَتْ بأرجاءِ السماءِ كواكبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=41842",""],[6069,"سرى طيف الأحبة من بعيد","https://www.poetsgate.com/ViewPoem.aspx?id=105657",""],[6102,"لحظة وداع","https://www.poetsgate.com/ViewPoem.aspx?id=184862",""],[6102,"مَرسُوم ..","https://www.poetsgate.com/ViewPoem.aspx?id=185051",""],[456,"حنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84503&r=&rc=2",""],[5393,"لماذا أتيتَ بهذا الزمانْ ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85467&r=&rc=34",""]],"verses":[["وَقَد لاحَت بِأَعيُنِنا ذُكاءٌ","وَراءَ الفَجرِ كَالخَدِّ اللَطيمِ",0,"م",1,0],["وَقَد لَمَعَت مِن حَواشي الغُمودِ","كَما نَصَلَت أَغُلٌ مِن غَنَم",1,"م",1,0],["وَقَد لفَّتِ الشُمُّ الغَطاريفُ عِرقَهُ","بِعِرقِكَ وَالأَرحامُ تُرعى وَتُكرَمُ",2,"م",1,0],["وقد لامَني مَنْ لو تأمَّلْتُ قَوْلَهُ","علمتُ يَقيناً أنهُ كان ألْوَما",3,"م",2,0],["وَقَد لاقَيتُ في سَفَري أُمور","تُشَيِّبُ مَن لَهُ في المَهدِ عامُ",4,"م",1,0],["وَقَد لَقِيتُ زياداً ثُمَّ قُلتُ لَهُ","وَقبلَ ذَلِكَ ما خَبَّت بِهِ الرُسُلُ",5,"ل",1,0],["وَقَد لَمَعَ المَشيبُ وَذاكَ سَيفٌ","عَلى فَودَيكَ عَلَّقَهُ الحِمامُ",6,"م",1,0],["وَقَد لَبِسَت لُبسَ الهَلوكِ ثِيابَها","تَراءى لَكَ الدُنيا بِكَفٍّ وَمِعصَمِ",7,"م",1,0],["وَقَد لَفَّنا في أَوَّلِ الدَهرِ نِعمَةٌ","فَعِشنا زَماناً آمِنينَ اِنفِتالَها",8,"ل",3,0],["وَقَد لاحَ لِلسّاري سُهَيلُ كَأَنَّهُ","قَرِيعُ هِجانٍ عارَضَ الشَولَ جافِرُ",9,"ر",1,0],["وَقَد لاحَ للسّاري الَّذي كَمَّلَ السُرَ","عَلى أُخرَياتِ اللَيلِ فَتقٌ مٌشَهَّرُ",10,"ر",1,0],["وقد لبس خضر الثياب","وفرط حسن قد بهر",11,"ر",1,0],["وقد لاحت مبرقعة المحيّا","من الغيم الرقيق بثوب شاش",12,"ش",1,0],["وقد لبِس الفضيلة وارتداها","وشَدّ عليه من حَزمِ حزاما",13,"م",2,0],["وقد لاح لي محمود شوكت جالساً","به فوق كرسي الجلالة والمجد",14,"د",1,0],["وَقَد لَيَّنتَ وَحشَهُمُ بِرِفقٍ","وَتُعيّ الناسَ وَحشُكَ أَن تُصادا",15,"د",2,0],["وَقَد لَحِقَ الثَمائِلُ بَعدَ بُدنٍ","وَقَد أَفنى عَرائِكَها الوُخودُ",16,"د",1,0],["وَقَد لامَ العَواذِلُ في سُلَيمى","وَقَلَّ إِلى عَواذِلي اِعتِذاري",17,"ر",2,0],["وَقَد لَحِقَ الفَرَزدَقُ بِالنَصارى","لِيَنصُرَهُم وَلَيسَ بِهِ اِنتِصارُ",18,"ر",1,0],["وَقَد لاحَ المَشيبُ فَما أَراهُ","عَداكَ وَقَد صَبَوتَ وَلا نَهاكا",19,"ك",2,0],["وَقَد لَبِسَت بَعدَ الزُبَيرِ مُجاشِعٌ","ثِيابَ الَّتي حاضَت وَلَم تَغسِلِ الدَما",20,"م",2,0],["وقد لقيت ظباء الأنس غاديةً","من كل أحورَ بالمكِّي مؤتتبُ",21,"ب",1,1],["وقد لبست من النوعين أردية","شتى وجربت من جَد ومن لعب",22,"ب",1,0],["وَقدّ لاَقى لِصَعبَتِهِ نِزَاراً","شَراحِيلُ بن أصهَبَ رَائِضَينَا",23,"ن",2,0],["وقد لاقيتُ من علياكَ بحراً","يلذّ مديحه في كلّ بحر",24,"ر",1,0],["وقد لقيت في الحبِّ ما لقيت عدى","لآلاءِ سيف الملك عاشت لشومها",25,"م",3,0],["وقد لقبوه نهر بوقٍ تعسفاً","وفي الوغد أشباه من البوق والنهر",26,"ر",1,0],["وقد لمعت حتى كأن بريقها","قلائد درٍّ فُصِّلت بعقيقِ",27,"ق",1,0],["وقد لاحظها الفاسِ","قُ من بين الشبابيكِ",28,"ك",1,0],["وقد لُمسَتُ من صفحتيك ملامسٌ","وجُرّبْتَ قِدْماً والمجرّبُ أعلمُ",29,"م",1,0],["وَقَد لَبِستُ لِهَذا الدَهرِ أَعصُرَهُ","حَتّى تَجَلَّلَ رَأسي الشَيبُ وَاِشتَعَلا",30,"ل",2,0],["وقد لا ارى في القول لي من سلامة","فاسكت عنه وهو يقدح في صدري",31,"ر",2,0],["وَقَد لَبِسَت دِمائَهُمُ عَلَيهِم","حِداداً لَم تَشُقَّ لَها جُيوباً",32,"ب",2,0],["وقد لفظتني الأرضُ حتى تراجعتْ","برحلي إِلى أكنافِ جانبكَ السَهْلِ",33,"ل",1,0],["وَقَد لَبِسَت بَغدادُ أَحسَنَ زِيِّها","لِإِقبالِهِ وَاِستَشرَفَت لِعُدولِهِ",34,"ل",2,0],["وَقَد لَبِستُ الهَوى وَإِن كانَ ضُرّاً","وَتَحَمَّلتُهُ وَإِن كانَ ثِقلا",35,"ل",2,0],["وَقَدٍّ لَو يَمُرُّ بِهِ نَسيمٌ","لَكادَ يَؤودُهُ مَرُّ النَسيمِ",36,"م",1,0],["وقد لبسوا الغدْرانَ وهي تموّجتْ","دروعاً وسلُّوا المرهفاتِ سواقيا",37,"ي",2,0],["وَقَد لاحَ نَجمُ الصُّبحِ حَتَّى كَأَنَّهُ","مَطرِقُ جَيشٍ مُؤذِنٌ بِأَميرِهِ",38,"ر",2,0],["وَقَد لَبِسوا من نَسجِ داود أعيُناً","مُداخَلَةً خُوصاً هي الحَلَقُ السرْدُ",39,"د",1,0],["وقدٌّ لقلبي فيهِ ألفُ بثينةٍ","فكلُّ رداءٍ ترتديهِ جميلُ",40,"ل",1,0],["وقدْ لا أراهُ كما قيلَ لي","وقدْ لا يراني كما قيلَ لَهْ",41,"ه",1,0],["وَقَد لَثَمَ النَقعُ أُسدَ الشَرى","وَكَرَّت بِها الخَيلُ تَعدو تُبا",42,"ب",2,0],["وَقَد لاحَ صُبحُ الشَيبِ وَاِنسَلَخَ الصِبا","فَيا صُبحُ ما أَجلى وَيا لَيلُ ما أَسرى",43,"ر",2,0],["وَقَد لاحَ وَجهُ الصُبحِ يَندى كَأَنَّهُ","وَراءَ قِناعِ اللَيلِ وَجهُ بَشيرِ",44,"ر",1,0],["وَقَد لَفَّ العَدُوَّ كَأَنَّ ريحاً","عَلى شَرَفٍ تَلُفُّ بِهِ هَشيما",45,"م",2,0],["وَقَد لَوى أَنفَهُ بِمَشفَرِها","طِلحُ قَراشيمَ شاحِبٌ جَسَدُه",46,"د",2,0],["وَقَد لاحَ دَوءُ الفَجرِ عَرضاً كَأَنَّهُ","بِلَمحَتِهِ أَقرابُ أَبلَقَ أَدهَمِ",47,"م",1,0],["وَقَد لَهَوتُ بِمَصقولٍ عَوارِضُها","بَكرٍ تُنازِعُني كَأساً وَعِنقادا",48,"د",2,0],["وَقَد لامَ عَقلي فيهِ نَفسي فَما اِنتَهَت","وَقالَت أَعِنّي بِاِحتِيالِكَ أَو دَعني",49,"ن",2,0],["وَقَد لاحَت لِساريها الثُرَيّا","كَأَنَّ نُجومَها نَورُ الأَقاحِ",50,"ح",1,0],["وَقَد لَمَعَت حَتّى كَأَنَّ بَريقَها","قَواريرُ فيها زِئبَقٌ يَتَرَجرَجُ",51,"ج",1,0],["وَقَد لاحَ الدُجى مَرآةَ قَينٍ","قَد اِنصَقَلَت وَمَقبِضُها الخَليجُ",52,"ج",1,0],["وَقَد لاحَ لِلساري سُهَيلٌ كَأَنَّهُ","عَلى كُلِّ نَجمٍ في السَماءِ رَقيبُ",53,"ب",1,0],["وَقَد لامَني فيها المُعَلّى وَلَو بَدا","لَهُ ما بَدا لي مِن مَحاسِنِها سَجَد",54,"د",1,0],["وَقَد لُمتُ نَفسي في الرَبابِ فَسامَحَت","مَراراً وَلَكِن في الفُؤادِ عِصاءُ",55,"ا",2,0],["وَقَد لاحَ شَيبٌ في الذَرا فَصَحَوتُمُ","وَصَحَّ لَكُم أَنَّ الشَبابَ مِنَ السُكرِ",56,"ر",1,0],["وَقَد لَهَوتُ بِمِثلِ الرِئمِ آنِسَةٍ","تُصبي الحَليمَ عَروبٍ غَيرِ مِكلاحِ",57,"ح",1,0],["وقد لبست دماؤهم عليهم","حداداً لم تشق لها جيوبا",58,"ب",2,0],["وَقَد لاقَيتُ في سَفَري أُموراً","تُشَيِّبُ مَن لَهُ في المَهدِ عامُ",59,"م",1,0],["وَقَد لاقَيتُ بَينَ يَدَيهِ لَيثاً","كَريهَ المُلتَقى مُرَّ المَذاقِ",60,"ق",1,0],["وَقَدْ لاحَ بِالظَّلْماءِ فَجْرٌ كَأَنَّهُ","بَياضُ مَشِيبٍ فِي سَوَادِ شَبابِ",61,"ب",1,0],["وقد لمحوا من نورِ طه شُعاعةً","فكل ظلامٍ في الوجود ضِياءُ",62,"ا",2,0],["وقد لوَّحتْ أيْدِيهِمَا فكأنّها","إِشاراتُ راياتِ تروحُ وتَلتَقي",63,"ق",2,0],["وقدْ لهوتُ بمثلِ الرّثمِ آنسة ٍ","تُصْبي الحليمَ عَرُوبٍ غير مِكْلاحِ",64,"ح",1,0],["وَقَدْ لاَحَ ضَوْءُ الْفَجرِ عَرْضاً كَأَنَّهُ","بِلَمْحَتِهِ أَقْرَابُ أَبْلَقَ أَدْهَمِ",65,"م",1,0],["وقد لاح نجمُ الصبح حتى كأنَّه","مطرق جيش مؤدن بأميره",66,"ر",2,0],["وقد لا يراك فتى أو عجوز","ولا يلمح الجار تلك الضعيفه",67,"ف",2,0],["وقد لفتوا لرؤيتها العيونا","ألا يا راحلين لحرب قوم",68,"م",1,0],["وَقَد لَقِيا مِنَ الإِشراقِ خَيلاً","تَسوفُ الوَحشَ تَحسَبُها خِياما",69,"م",2,0],["وقد لوى عن سوى مولاه وجهته","بعزم قلب لغير الله لم يمل",70,"ل",1,0],["وقد لثمت يمين المصطفى علنا","والقوم منهم هناك العسكر اللجب",71,"ب",1,0],["وقد لدت في أعتاب آل محمد","حمى كل مسكين محب وخادم",72,"م",1,0],["وقد لجأنا لعليا عزه وبلا","شك محمدنا المحمود حامينا",73,"ن",2,0],["وقد للكأس تهفو نف","س من يسلوه أَحيانا",74,"ن",2,0],["وَقَدٌ لَينٌ رَخصٌ وغَيلٌ","نَقِىُّ اللَّونِ مُمتَلِىءُ السِّوَارِ",75,"ر",1,0],["وَقَد لَبِسَت أَبهى الكُسى وَتَعَطَّرَت","بِما حَمَلَت مِن طيبِ أَخبارِكَ البُردُ",76,"د",1,0],["وَقَد لَبّاكَ قِرواشٌ مُجيباً","فَبَوَّأَ مُلكَهُ حِصناً حَصينا",77,"ن",2,0],["وَقَد لاحَ وَالغاوي يَغُضُّ جُفونَهُ","لِطَيبَةَ نُورٌ تَقصُرُ الشَمسُ دونَهُ",78,"ه",1,0],["وقد لبسوا السكينة واستلاثوا","جلابيب الحيا والإِحتشام",79,"م",1,0],["وَقد لَزِموا مَعنى الخِلافِ فَكُلُّهُم","إِلى نَحوِ ما عابَ الخَليقَةَ مائِلُ",80,"ل",1,0],["وقد لامَنِي العُذّالُ فيكم وَأَكْثَروا","فما غَيَّروني بالمَلامِ عن الودّ",81,"د",1,0],["وقد لزموا مني الخلاف فكلُّهم","إلى كل من عادَى الخلائقَ مائل",82,"ل",1,0],["وقد ليقت دويّ البغ","ي والأقلام مقطوطه",83,"ط",2,0],["وقد لقبوها بستِّ اللحى","لتعظيمها ولتبجيلها",84,"ل",3,0],["وقد لمحت فودي به الشَّعرُ باسمٌ","تجلَّى لها وجهٌ عليَّ عُبوسُ",85,"س",1,0],["وَقَد لَبِسَت ثَوبَها الزَنبَقِيَّ","عَلَيهِ نَسيجٌ بِلَونِ الخِضَر",86,"ر",1,0],["وَقد لَمَّني بِخُشوعٍ وَقال","تَعالَي أُرَوِّكِ مِن دَمعَتي",87,"ي",1,0],["وقد لوى صُدْغَهُ دلالا","وهزّ ألحاظَه الضِعافا",88,"ف",2,0],["وقد لاح الضُّحى مِرآةُ فَيْن","قد انصقلَت ومَقْبِضُها الخليجُ",89,"ج",1,0],["وَقَد لَسَعَتني مِن زَماني أَراقِمٌ","بِسُمِّ الأَذى ظُلماً وَلَم أَلقَ راقِيا",90,"ي",2,0],["وقد لَعِبَت بهِ الأهواءُ حتى","رأيتُ دَمي حلالاً أو جبارا",91,"ر",2,0],["وَقَدْ لَبِسَت مَفَارِقُها","مِن الأنْداءِ تِيجانا",92,"ن",2,0],["وَقد لبِسَ الأصيلُ هناكَ دِرعا","فَكأن علَيهِ رَدعاً في عَبيرِ",93,"ر",1,0],["وَقَد لَبِسوا غُدراً وَاِنتَضَوا","جَداوِلَ وِردُ الرَدى في لَظاها",94,"ا",3,0],["وَقَد لاحَ في الصُبحِ الثُرَيّا لِمَن رَأى","كَعُنقودِ مُلّاحِيَّةٍ حينَ نَوَّرا",95,"ر",2,1],["وَقَد لَبِسَت عِندَ الإِلَهَةِ ساطِعاً","مِنَ الفَجرِ لَمّا صاحَ بِاللَيلِ بَقَّرا",96,"ر",2,0],["وَقَدْ لَبِسَتْ أَوْراقُهُ الخُضْرُ صُفْرَةً","يَصُوغُ لَكَ العُنْقُودُ دُرّاً مُذَهَّبَا",97,"ب",2,0],["وقَد لاحَ بَعد العُسر يُسر لَدى المَلا","وَلا شَكّ أَن العُسر يَعقبه اليُسرُ",98,"ر",1,0],["وقد لامَ سَعْدٌ يومَ عُجْنا رِكابَنا","على حينَ رُمْنا منه أن يَتَلَوَّما",99,"م",2,0],["وقد لَحّنتْ كُلَّ أَبياتِها","كفِعْلِ الفُحولِ وحُذّاقها",100,"ق",3,0],["وقد لاحَ للسّاري من الصُّبْحِ ساطِعٌ","أمالَ خِباءَ الليّلِ منه عَمود",101,"د",1,0],["وقَد لاحَ ذلكَ في وَجهِها","فجاءَتكَ في عابسٍ باسِمِ",102,"م",1,0],["وقد لحِقا فهذا عن يَميني","يطاردُها وهذا عن يَساري",103,"ر",2,0],["وقد لعبت فيهم عواملُ رُسْلِه","كما لعبت بالمعربات العوامل",104,"ل",1,0],["وقد لمحوا موسى بنَ عمران قائماً","لديه وإيليّا النبيَّ المُشيَّع",105,"ع",1,0],["وَقَد لَبس السَواد وَجاءَ يَسعى","كَما شَقَ الحَنادس بَدر تَم",106,"م",1,0],["وقد لاحَ في عارِضيكَ الوَقَ","ارُ وأضْحى ينادي الوَقارُ الوقارا",107,"ر",2,0],["وقد لَبِسَتْ فيه الرِّياض ملابساً","مُدَنَّرة منها لجين وعسجد",108,"د",1,0],["وقد لوى اللهُ له","أخدعَ كلّ أصيدِ",109,"د",1,0],["وقد لاح صبح الشيب ي ليل المنى","فاسفر في راسي وفودي ومفرقي",110,"ق",2