 القدر","https://www.aldiwan.net/poem40345.html","الطويل"],[362,"هم منعوا مني الخيال المسلما","https://www.aldiwan.net/poem60668.html","الطويل"],[362,"رمين القلوب بأشواقها","https://www.aldiwan.net/poem60835.html","المتقارب"],[362,"من القاتلات الصب بالهجر في الهوى","https://www.aldiwan.net/poem60956.html","الطويل"],[369,"تولى بتهويمة الهائم","https://www.aldiwan.net/poem57151.html","المتقارب"],[369,"وراءك إن زندك غير واري","https://www.aldiwan.net/poem57454.html","الوافر"],[374,"لقد نزل المولى العلي وهو رافل","https://www.aldiwan.net/poem59289.html","الطويل"],[374,"جلا مذ تجلى أعينا فيك تدمع","https://www.aldiwan.net/poem59341.html","الطويل"],[377,"على ثقة باتلافي وعلم","https://www.aldiwan.net/poem49243.html","الوافر"],[399,"ألم يأن أن تستقيل العثارا","https://www.aldiwan.net/poem47000.html","المتقارب"],[413,"هنيئا لكم هذا الهناء المجدد","https://www.aldiwan.net/poem54042.html","الطويل"],[429,"مالك قلبي عن يد","https://www.aldiwan.net/poem12587.html","مجزوء الرجز"],[434,"سعاد اسعدي بالطيف بعد التفرق","https://www.aldiwan.net/poem2554.html","الطويل"],[436,"إذا شئت كان النجم عندك شاهدي","https://www.aldiwan.net/poem34811.html","الطويل"],[436,"هنيئا لهذا الدهر روح وريحان","https://www.aldiwan.net/poem34894.html","الطويل"],[436,"لئن سرت الدنيا فأنت سرورها","https://www.aldiwan.net/poem34913.html","الطويل"],[438,"على الذنب لي قلب شجاع مجرب","https://www.aldiwan.net/poem14379.html","الطويل"],[438,"فؤاد بنيران المصاب مفأد","https://www.aldiwan.net/poem14450.html","الطويل"],[438,"أريقي الدمع يا مقلي أريقي","https://www.aldiwan.net/poem14467.html","الوافر"],[456,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[459,"أأهجع أم آوي إلى لين مرقد","https://www.aldiwan.net/poem15111.html","الطويل"],[462,"وصاحب أنس تعشق الفضل نفسه","https://www.aldiwan.net/poem3262.html","عموديه"],[462,"أرى سيرها عنقاً أو خيدا","https://www.aldiwan.net/poem3276.html","عموديه"],[462,"سقى الله أطلال ما صبا","https://www.aldiwan.net/poem3384.html","عموديه"],[466,"ألا رب خمار طرقت تعسفا","https://www.aldiwan.net/poem60225.html","الطويل"],[480,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[480,"وقد لاقيت من وقع سهمها","https://www.aldiwan.net/poem24490.html","عموديه"],[480,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[484,"وقد لاح في الصبح الثريا لمن يرى","https://www.aldiwan.net/poem489.html",""],[499,"أجدك لم تعرف أثافي دمنة","https://www.aldiwan.net/poem2247.html","الطويل"],[549,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[549,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[549,"لي من رضابك ما يغني عن الراح","https://www.aldiwan.net/poem47891.html","البسيط"],[549,"أتنسين يا لمياء شملك جامعا","https://www.aldiwan.net/poem48098.html","الطويل"],[556,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[565,"بدت في نسوة مثل المها","https://www.aldiwan.net/poem69764.html","الهزج"],[573,"لقد ذهبت نفسي وقد صفرت يدي","https://www.aldiwan.net/poem2970.html","الطويل"]],"verses":[["وَقَد لاحَت بِأَعيُنِنا ذُكاءٌ","وَراءَ الفَجرِ كَالخَدِّ اللَطيمِ",0,"م",1,0],["وَقَد لَمَعَت مِن حَواشي الغُمودِ","كَما نَصَلَت أَغُلٌ مِن غَنَم",1,"م",1,0],["وَقَد لفَّتِ الشُمُّ الغَطاريفُ عِرقَهُ","بِعِرقِكَ وَالأَرحامُ تُرعى وَتُكرَمُ",2,"م",1,0],["وقد لامَني مَنْ لو تأمَّلْتُ قَوْلَهُ","علمتُ يَقيناً أنهُ كان ألْوَما",3,"م",2,0],["وَقَد لاقَيتُ في سَفَري أُمور","تُشَيِّبُ مَن لَهُ في المَهدِ عامُ",4,"م",1,0],["وَقَد لَقِيتُ زياداً ثُمَّ قُلتُ لَهُ","وَقبلَ ذَلِكَ ما خَبَّت بِهِ الرُسُلُ",5,"ل",1,0],["وَقَد لَمَعَ المَشيبُ وَذاكَ سَيفٌ","عَلى فَودَيكَ عَلَّقَهُ الحِمامُ",6,"م",1,0],["وَقَد لَبِسَت لُبسَ الهَلوكِ ثِيابَها","تَراءى لَكَ الدُنيا بِكَفٍّ وَمِعصَمِ",7,"م",1,0],["وَقَد لَفَّنا في أَوَّلِ الدَهرِ نِعمَةٌ","فَعِشنا زَماناً آمِنينَ اِنفِتالَها",8,"ل",3,0],["وَقَد لاحَ لِلسّاري سُهَيلُ كَأَنَّهُ","قَرِيعُ هِجانٍ عارَضَ الشَولَ جافِرُ",9,"ر",1,0],["وَقَد لاحَ للسّاري الَّذي كَمَّلَ السُرَ","عَلى أُخرَياتِ اللَيلِ فَتقٌ مٌشَهَّرُ",10,"ر",1,0],["وقد لبس خضر الثياب","وفرط حسن قد بهر",11,"ر",1,0],["وقد لاحت مبرقعة المحيّا","من الغيم الرقيق بثوب شاش",12,"ش",1,0],["وقد لبِس الفضيلة وارتداها","وشَدّ عليه من حَزمِ حزاما",13,"م",2,0],["وقد لاح لي محمود شوكت جالساً","به فوق كرسي الجلالة والمجد",14,"د",1,0],["وَقَد لَيَّنتَ وَحشَهُمُ بِرِفقٍ","وَتُعيّ الناسَ وَحشُكَ أَن تُصادا",15,"د",2,0],["وَقَد لَحِقَ الثَمائِلُ بَعدَ بُدنٍ","وَقَد أَفنى عَرائِكَها الوُخودُ",16,"د",1,0],["وَقَد لامَ العَواذِلُ في سُلَيمى","وَقَلَّ إِلى عَواذِلي اِعتِذاري",17,"ي",1,0],["وَقَد لَحِقَ الفَرَزدَقُ بِالنَصارى","لِيَنصُرَهُم وَلَيسَ بِهِ اِنتِصارُ",18,"ر",1,0],["وَقَد لاحَ المَشيبُ فَما أَراهُ","عَداكَ وَقَد صَبَوتَ وَلا نَهاكا",19,"ك",2,0],["وَقَد لَبِسَت بَعدَ الزُبَيرِ مُجاشِعٌ","ثِيابَ الَّتي حاضَت وَلَم تَغسِلِ الدَما",20,"م",2,0],["وقد لقيت ظباء الأنس غاديةً","من كل أحورَ بالمكِّي مؤتتبُ",21,"ب",1,1],["وقد لبست من النوعين أردية","شتى وجربت من جَد ومن لعب",22,"ب",1,0],["وَقدّ لاَقى لِصَعبَتِهِ نِزَاراً","شَراحِيلُ بن أصهَبَ رَائِضَينَا",23,"ن",2,0],["وقد لاقيتُ من علياكَ بحراً","يلذّ مديحه في كلّ بحر",24,"ر",1,0],["وقد لقيت في الحبِّ ما لقيت عدى","لآلاءِ سيف الملك عاشت لشومها",25,"م",3,0],["وقد لقبوه نهر بوقٍ تعسفاً","وفي الوغد أشباه من البوق والنهر",26,"ر",1,0],["وقد لمعت حتى كأن بريقها","قلائد درٍّ فُصِّلت بعقيقِ",27,"ق",1,0],["وقد لاحظها الفاسِ","قُ من بين الشبابيكِ",28,"ك",1,0],["وقد لُمسَتُ من صفحتيك ملامسٌ","وجُرّبْتَ قِدْماً والمجرّبُ أعلمُ",29,"م",1,0],["وَقَد لَبِستُ لِهَذا الدَهرِ أَعصُرَهُ","حَتّى تَجَلَّلَ رَأسي الشَيبُ وَاِشتَعَلا",30,"ل",2,0],["وقد لا ارى في القول لي من سلامة","فاسكت عنه وهو يقدح في صدري",31,"ي",1,0],["وَقَد لَبِسَت دِمائَهُمُ عَلَيهِم","حِداداً لَم تَشُقَّ لَها جُيوباً",32,"ب",2,0],["وقد لفظتني الأرضُ حتى تراجعتْ","برحلي إِلى أكنافِ جانبكَ السَهْلِ",33,"ل",1,0],["وَقَد لَبِسَت بَغدادُ أَحسَنَ زِيِّها","لِإِقبالِهِ وَاِستَشرَفَت لِعُدولِهِ",34,"ل",2,0],["وَقَد لَبِستُ الهَوى وَإِن كانَ ضُرّاً","وَتَحَمَّلتُهُ وَإِن كانَ ثِقلا",35,"ل",2,0],["وَقَدٍّ لَو يَمُرُّ بِهِ نَسيمٌ","لَكادَ يَؤودُهُ مَرُّ النَسيمِ",36,"م",1,0],["وقد لبسوا الغدْرانَ وهي تموّجتْ","دروعاً وسلُّوا المرهفاتِ سواقيا",37,"ي",2,0],["وَقَد لاحَ نَجمُ الصُّبحِ حَتَّى كَأَنَّهُ","مَطرِقُ جَيشٍ مُؤذِنٌ بِأَميرِهِ",38,"ر",2,0],["وَقَد لَبِسوا من نَسجِ داود أعيُناً","مُداخَلَةً خُوصاً هي الحَلَقُ السرْدُ",39,"د",1,0],["وقدٌّ لقلبي فيهِ ألفُ بثينةٍ","فكلُّ رداءٍ ترتديهِ جميلُ",40,"ل",1,0],["وقدْ لا أراهُ كما قيلَ لي","وقدْ لا يراني كما قيلَ لَهْ",41,"ه",1,0],["وَقَد لَثَمَ النَقعُ أُسدَ الشَرى","وَكَرَّت بِها الخَيلُ تَعدو تُبا",42,"ب",2,0],["وَقَد لاحَ صُبحُ الشَيبِ وَاِنسَلَخَ الصِبا","فَيا صُبحُ ما أَجلى وَيا لَيلُ ما أَسرى",43,"ر",2,0],["وَقَد لاحَ وَجهُ الصُبحِ يَندى كَأَنَّهُ","وَراءَ قِناعِ اللَيلِ وَجهُ بَشيرِ",44,"ر",1,0],["وَقَد لَفَّ العَدُوَّ كَأَنَّ ريحاً","عَلى شَرَفٍ تَلُفُّ بِهِ هَشيما",45,"م",2,0],["وَقَد لَوى أَنفَهُ بِمَشفَرِها","طِلحُ قَراشيمَ شاحِبٌ جَسَدُه",46,"د",2,0],["وَقَد لاحَ دَوءُ الفَجرِ عَرضاً كَأَنَّهُ","بِلَمحَتِهِ أَقرابُ أَبلَقَ أَدهَمِ",47,"م",1,0],["وَقَد لَهَوتُ بِمَصقولٍ عَوارِضُها","بَكرٍ تُنازِعُني كَأساً وَعِنقادا",48,"د",2,0],["وَقَد لامَ عَقلي فيهِ نَفسي فَما اِنتَهَت","وَقالَت أَعِنّي بِاِحتِيالِكَ أَو دَعني",49,"ي",1,0],["وَقَد لاحَت لِساريها الثُرَيّا","كَأَنَّ نُجومَها نَورُ الأَقاحِ",50,"ح",1,0],["وَقَد لَمَعَت حَتّى كَأَنَّ بَريقَها","قَواريرُ فيها زِئبَقٌ يَتَرَجرَجُ",51,"ج",1,0],["وَقَد لاحَ الدُجى مَرآةَ قَينٍ","قَد اِنصَقَلَت وَمَقبِضُها الخَليجُ",52,"ج",1,0],["وَقَد لاحَ لِلساري سُهَيلٌ كَأَنَّهُ","عَلى كُلِّ نَجمٍ في السَماءِ رَقيبُ",53,"ب",1,0],["وَقَد لامَني فيها المُعَلّى وَلَو بَدا","لَهُ ما بَدا لي مِن مَحاسِنِها سَجَد",54,"د",1,0],["وَقَد لُمتُ نَفسي في الرَبابِ فَسامَحَت","مَراراً وَلَكِن في الفُؤادِ عِصاءُ",55,"ا",2,0],["وَقَد لاحَ شَيبٌ في الذَرا فَصَحَوتُمُ","وَصَحَّ لَكُم أَنَّ الشَبابَ مِنَ السُكرِ",56,"ر",1,0],["وَقَد لَهَوتُ بِمِثلِ الرِئمِ آنِسَةٍ","تُصبي الحَليمَ عَروبٍ غَيرِ مِكلاحِ",57,"ح",1,0],["وقد لبست دماؤهم عليهم","حداداً لم تشق لها جيوبا",58,"ب",2,0],["وَقَد لاقَيتُ في سَفَري أُموراً","تُشَيِّبُ مَن لَهُ في المَهدِ عامُ",59,"م",1,0],["وَقَد لاقَيتُ بَينَ يَدَيهِ لَيثاً","كَريهَ المُلتَقى مُرَّ المَذاقِ",60,"ق",1,0],["وَقَدْ لاحَ بِالظَّلْماءِ فَجْرٌ كَأَنَّهُ","بَياضُ مَشِيبٍ فِي سَوَادِ شَبابِ",61,"ب",1,0],["وقد لمحوا من نورِ طه شُعاعةً","فكل ظلامٍ في الوجود ضِياءُ",62,"ا",2,0],["وقد لوَّحتْ أيْدِيهِمَا فكأنّها","إِشاراتُ راياتِ تروحُ وتَلتَقي",63,"ق",2,0],["وقدْ لهوتُ بمثلِ الرّثمِ آنسة ٍ","تُصْبي الحليمَ عَرُوبٍ غير مِكْلاحِ",64,"ح",1,0],["وَقَدْ لاَحَ ضَوْءُ الْفَجرِ عَرْضاً كَأَنَّهُ","بِلَمْحَتِهِ أَقْرَابُ أَبْلَقَ أَدْهَمِ",65,"م",1,0],["وقد لاح نجمُ الصبح حتى كأنَّه","مطرق جيش مؤدن بأميره",66,"ر",2,0],["وقد لفتوا لرؤيتها العيونا","ألا يا راحلين لحرب قوم",67,"م",1,0],["وَقَد لَقِيا مِنَ الإِشراقِ خَيلاً","تَسوفُ الوَحشَ تَحسَبُها خِياما",68,"م",2,0],["وقد لوى عن سوى مولاه وجهته","بعزم قلب لغير الله لم يمل",69,"ل",1,0],["وقد لثمت يمين المصطفى علنا","والقوم منهم هناك العسكر اللجب",70,"ب",1,0],["وقد لدت في أعتاب آل محمد","حمى كل مسكين محب وخادم",71,"م",1,0],["وقد لجأنا لعليا عزه وبلا","شك محمدنا المحمود حامينا",72,"ن",2,0],["وقد للكأس تهفو نف","س من يسلوه أَحيانا",73,"ن",2,0],["وَقَدٌ لَينٌ رَخصٌ وغَيلٌ","نَقِىُّ اللَّونِ مُمتَلِىءُ السِّوَارِ",74,"ر",1,0],["وَقَد لَبِسَت أَبهى الكُسى وَتَعَطَّرَت","بِما حَمَلَت مِن طيبِ أَخبارِكَ البُردُ",75,"د",1,0],["وَقَد لَبّاكَ قِرواشٌ مُجيباً","فَبَوَّأَ مُلكَهُ حِصناً حَصينا",76,"ن",2,0],["وَقَد لاحَ وَالغاوي يَغُضُّ جُفونَهُ","لِطَيبَةَ نُورٌ تَقصُرُ الشَمسُ دونَهُ",77,"ه",1,0],["وقد لبسوا السكينة واستلاثوا","جلابيب الحيا والإِحتشام",78,"م",1,0],["وَقد لَزِموا مَعنى الخِلافِ فَكُلُّهُم","إِلى نَحوِ ما عابَ الخَليقَةَ مائِلُ",79,"ل",1,0],["وقد لامَنِي العُذّالُ فيكم وَأَكْثَروا","فما غَيَّروني بالمَلامِ عن الودّ",80,"د",1,0],["وقد لزموا مني الخلاف فكلُّهم","إلى كل من عادَى الخلائقَ مائل",81,"ل",1,0],["وقد ليقت دويّ البغ","ي والأقلام مقطوطه",82,"ط",2,0],["وقد لقبوها بستِّ اللحى","لتعظيمها ولتبجيلها",83,"ل",3,0],["وقد لمحت فودي به الشَّعرُ باسمٌ","تجلَّى لها وجهٌ عليَّ عُبوسُ",84,"س",1,0],["وَقَد لَبِسَت ثَوبَها الزَنبَقِيَّ","عَلَيهِ نَسيجٌ بِلَونِ الخِضَر",85,"ر",1,0],["وَقد لَمَّني بِخُشوعٍ وَقال","تَعالَي أُرَوِّكِ مِن دَمعَتي",86,"ي",1,0],["وقد لوى صُدْغَهُ دلالا","وهزّ ألحاظَه الضِعافا",87,"ف",2,0],["وقد لاح الضُّحى مِرآةُ فَيْن","قد انصقلَت ومَقْبِضُها الخليجُ",88,"ج",1,0],["وَقَد لَسَعَتني مِن زَماني أَراقِمٌ","بِسُمِّ الأَذى ظُلماً وَلَم أَلقَ راقِيا",89,"ي",2,0],["وقد لَعِبَت بهِ الأهواءُ حتى","رأيتُ دَمي حلالاً أو جبارا",90,"ر",2,0],["وَقَدْ لَبِسَت مَفَارِقُها","مِن الأنْداءِ تِيجانا",91,"ن",2,0],["وَقد لبِسَ الأصيلُ هناكَ دِرعا","فَكأن علَيهِ رَدعاً في عَبيرِ",92,"ر",1,0],["وَقَد لَبِسوا غُدراً وَاِنتَضَوا","جَداوِلَ وِردُ الرَدى في لَظاها",93,"ا",3,0],["وَقَد لاحَ في الصُبحِ الثُرَيّا لِمَن رَأى","كَعُنقودِ مُلّاحِيَّةٍ حينَ نَوَّرا",94,"ر",2,1],["وَقَد لَبِسَت عِندَ الإِلَهَةِ ساطِعاً","مِنَ الفَجرِ لَمّا صاحَ بِاللَيلِ بَقَّرا",95,"ر",2,0],["وَقَدْ لَبِسَتْ أَوْراقُهُ الخُضْرُ صُفْرَةً","يَصُوغُ لَكَ العُنْقُودُ دُرّاً مُذَهَّبَا",96,"ب",2,0],["وقَد لاحَ بَعد العُسر يُسر لَدى المَلا","وَلا شَكّ أَن العُسر يَعقبه اليُسرُ",97,"ر",1,0],["وقد لامَ سَعْدٌ يومَ عُجْنا رِكابَنا","على حينَ رُمْنا منه أن يَتَلَوَّما",98,"م",2,0],["وقد لَحّنتْ كُلَّ أَبياتِها","كفِعْلِ الفُحولِ وحُذّاقها",99,"ق",3,0],["وقد لاحَ للسّاري من الصُّبْحِ ساطِعٌ","أمالَ خِباءَ الليّلِ منه عَمود",100,"د",1,0],["وقَد لاحَ ذلكَ في وَجهِها","فجاءَتكَ في عابسٍ باسِمِ",101,"م",1,0],["وقد لحِقا فهذا عن يَميني","يطاردُها وهذا عن يَساري",102,"ي",1,0],["وقد لعبت فيهم عواملُ رُسْلِه","كما لعبت بالمعربات العوامل",103,"ل",1,0],["وقد لمحوا موسى بنَ عمران قائماً","لديه وإيليّا النبيَّ المُشيَّع",104,"ع",1,0],["وَقَد لَبس السَواد وَجاءَ يَسعى","كَما شَقَ الحَنادس بَدر تَم",105,"م",1,0],["وقد لاحَ في عارِضيكَ الوَقَ","ارُ وأضْحى ينادي الوَقارُ الوقارا",106,"ر",2,0],["وقد لَبِسَتْ فيه الرِّياض ملابساً","مُدَنَّرة منها لجين وعسجد",107,"د",1,0],["وقد لوى اللهُ له","أخدعَ كلّ أصيدِ",108,"د",1,0],["وقد لاح صبح الشيب ي ليل المنى","فاسفر في راسي وفودي ومفرقي",109,"ق",2,0],["وَقَدْ لَبِسَتْ آفاقُهُ من دُجُونِهِ","حِدادَ نواعٍ للصباحِ فَوَاقِدُ",110,"د",1,0],["وقد لَمَعَتْ حوْلَيْكَ منهمْ أَسِنَّةٌ","تُخَيِّلُ أَنَّ الحَزْنَ والسَّهْلَ نِيرانُ",111,"ن",1,0],["وقد لاح بالنصر العزيز لواؤها","وأَعْلَنَ بالفتحِ المبين بَشِيرُهَا",112,"ر",3,0],["وقد لذ لي في كل حين توقفي","ولو مر فيه مربع ومصيف",113,"ف",1,0],["وقد لذت الأحزان عندي لأنها","غدت ديدنا حيث الأَسى يتجدد",114,"د",1,0],["وقد لذت لي الأحزان حتى","لنفسي لم أقل يا نفس ذوقي",115,"ق",2,0],["وقد لبستم فاخلعوا إن الندى ال","عادلَ أن تُقَسَّمَ المغانمُ",116,"م",1,0],["وقد لفظوا عن عيسهم كل مُثْقلٍ","من الرَّحْل حتى بُلْغةَ المُتزود",117,"د",1,0],["وقد لقبوه الشمس جهلاً بقدره","ولم أر شمساً قبلة كلها ظل",118,"ل",1,0],["وقد لبست أكمه الوهاد","من صنعة الغاديات البرودا",119,"د",2,0],["وقد لقب السيف وهو النضار","واسم السيوف يخص الحديدا",119,"د",2,0],["وقد لاح في فوديَّ بيض كأنها","كواكب في الظلماء ذاتُ شروق",120,"ق",1,0],["وَقَد لاحَ لِأَلاءُ الصَباحِ كَصارِمٍ","عَلى قِمَّةِ اللَيلِ البَهيمِ مُجَرَّدِ",121,"د",1,0],["وقد لبثت فينا دهاق كؤوسها","دهورا وقد غنت بوصل كيوان",122,"ن",1,0],["وقد لاقيت من وقع سهمها","هموما وأشجانا تثير هوان",123,"ن",1,1],["وقد لاح للعينين إسراؤه به","بجثمانه العبدي بأحلاك همسيّه",124,"ي",2,0],["وَقَد لاحَ في الصُبحِ الثُرَيّا لِمَن يَرى","كَعُنقودِ مُلّاحِيَّةِ حينَ نَوَّرا",125,"ر",2,1],["وَقَد لَفَّ شَخصَينا سُرادِقُ هَبوَةٍ","فَخانَكَ صَبرٌ يَومَ ذَلِكَ مُخدَجُ",126,"ج",1,0],["وَقَد لَمسوا بأيديهمْ صَفاتي","فما وجدوا على الأيّامِ لِينا",127,"ن",2,0],["وقد لامَ ولكنْ لي","سَ يعدو عن هوى عادِ",128,"د",1,0],["وقد لَحَوْني على وجْدِي فقلْ لهمُ","كَيفَ اِنثَنى خائِباً مِن طاعَتي اللّاحِي",129,"ي",1,0],["وَقد لفّنا ضيقُ العناقِ وَبيننا","عِتابٌ كعرفِ المسكِ أو هو أطيبُ",130,"ب",1,0],["وقد لاح عصياني علي ومذ بدت","طفقت بأوراق أخصف سوءتي",131,"ي",1,0],["وقد لاثَتْ من الكَوْرِ","على مَفْرِقِها تَاجَا",132,"ج",2,0],["وقد لامَ فيها كلُّ غثٍّ ملامةً","وما قلبُه قلبي ولا وَجْدهُ وَجْدِي",133,"ي",1,0]]}