{"poems":[[53,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[53,"أما آن للدمع أن يستجم","https://www.aldiwan.net/poem29769.html","المتقارب"],[63,"ألا يا صفي الملك هل أنت سامع","https://www.aldiwan.net/poem45818.html","الطويل"],[63,"على عذب الجرعاء من أيمن الحمى","https://www.aldiwan.net/poem46170.html","الطويل"],[3,"فؤاد لا يسليه المدام","https://www.aldiwan.net/poem206.html",""],[42,"نبئت أن زيادا ظل يشتمني","https://www.aldiwan.net/poem50452.html","البسيط"],[86,"لقد نصل الدجى فمتى تنام","https://www.aldiwan.net/poem10686.html","الوافر"],[35,"عرج بأطراف الديار وسلم","https://www.aldiwan.net/poem38831.html","الطويل"],[35,"خليلي إن أم الحكيم تحملت","https://www.aldiwan.net/poem39117.html","الطويل"],[30,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[30,"خليلي لا ربع بوهبين مخبر","https://www.aldiwan.net/poem29588.html","الطويل"],[83,"ما أملح مه فصل الربيع","https://www.aldiwan.net/poem54198.html","مجزوء الرجز"],[88,"أقول لصاحبي والشمس تدنو","https://www.aldiwan.net/poem44416.html","الوافر"],[88,"لدار شنلر في القدس فضل","https://www.aldiwan.net/poem44996.html","الوافر"],[88,"لقد بت مطروف النواظر بالسهد","https://www.aldiwan.net/poem45057.html","الطويل"],[27,"أبت عيناك بالحسن الرقادا","https://www.aldiwan.net/poem5721.html","الوافر"],[27,"عفا النسران بعدك والوحيد","https://www.aldiwan.net/poem5726.html","الوافر"],[27,"أهاج الشوق معرفة الديار","https://www.aldiwan.net/poem5744.html","الوافر"],[27,"أتذكرهم وحاجتك ادكار","https://www.aldiwan.net/poem5757.html","الوافر"],[27,"ألا تصحو وتقصر عن صباكا","https://www.aldiwan.net/poem5946.html","الوافر"],[27,"لمن طلل هاج الفؤاد المتيما","https://www.aldiwan.net/poem6019.html","الطويل"],[37,"وقد لقيت ظباء الأنس غادية","https://www.aldiwan.net/poem6474.html","البسيط"],[37,"لو أن أهل الشباب الغض بايعهم","https://www.aldiwan.net/poem6853.html","البسيط"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[72,"أما والله قد شرفت شعري","https://www.aldiwan.net/poem18740.html","الوافر"],[72,"سقت بجوار الدمع عني جواريا","https://www.aldiwan.net/poem19987.html","الطويل"],[51,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[51,"كأن الثريا إذ تجمع شملها","https://www.aldiwan.net/poem65749.html","الطويل"],[51,"ألا يا قاتل الديك","https://www.aldiwan.net/poem65825.html","الهزج"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[29,"هل تعرف اليوم من ماوية الطللا","https://www.aldiwan.net/poem6034.html","البسيط"],[89,"أسائلكم ماذا على الشاعر الحر","https://www.aldiwan.net/poem44918.html","الطويل"],[43,"ضروب الناس عشاق ضروبا","https://www.aldiwan.net/poem9501.html","الوافر"],[62,"هم الحي ما بين العذيب إلى الرمل","https://www.aldiwan.net/poem52322.html","الطويل"],[45,"أبى الليل إلا أن يعود بطوله","https://www.aldiwan.net/poem65540.html","الطويل"],[45,"إن سير الخليط حين استقلا","https://www.aldiwan.net/poem65546.html","الخفيف"],[66,"بدت تختال في ذيل النعيم","https://www.aldiwan.net/poem39924.html","الوافر"],[80,"أباد حياتي الموت إن كنت ساليا","https://www.aldiwan.net/poem31246.html","الطويل"],[80,"ومطرد الأجزاء يصقل متنه","https://www.aldiwan.net/poem31461.html","الطويل"],[80,"بكى فقدك العز المؤيد والمجد","https://www.aldiwan.net/poem31472.html","الطويل"],[69,"لفاتنتي خيل عتاق سوابق","https://www.aldiwan.net/poem28165.html","الخفيف"],[69,"ومالي في زائر رغبة","https://www.aldiwan.net/poem28389.html","المتقارب"],[74,"شأوت مطايا الصبا مطلبا","https://www.aldiwan.net/poem12866.html","المتقارب"],[74,"ألا قانع من ملك كسرى بكسرة","https://www.aldiwan.net/poem12953.html","الطويل"],[74,"تشفع بعلق للشباب خطير","https://www.aldiwan.net/poem12959.html","الطويل"],[74,"ألا سرت القبول ولو نسيما","https://www.aldiwan.net/poem13250.html","الوافر"],[39,"طال في رسم مهدد أبده","https://www.aldiwan.net/poem53781.html","المنسرح"],[13,"جزى الله فتياناً على العوص أمطرت","https://www.aldiwan.net/poem2200.html","الطويل"],[13,"أنا الذي نكح الغيلاء في بلد","https://www.aldiwan.net/poem2228.html","البسيط"],[52,"تبدى فأين الغصن من ذلك الغصن","https://www.aldiwan.net/poem26624.html","الطويل"],[52,"لمن دار وربع قد تعفى","https://www.aldiwan.net/poem27164.html","الوافر"],[52,"كأن الثريا هودج فوق ناقة","https://www.aldiwan.net/poem27165.html","الطويل"],[52,"كأن البركة الغناء","https://www.aldiwan.net/poem27167.html","الوافر"],[52,"ألا فاسقنيها قد نعى الليل ديكه","https://www.aldiwan.net/poem27245.html","الطويل"],[50,"ألا راعه صوت الأذين وما هجد","https://www.aldiwan.net/poem63907.html","الطويل"],[50,"أجارتنا ما بالهوان خفاء","https://www.aldiwan.net/poem64883.html","الطويل"],[46,"إذا سعد البازي البعيد مغاره","https://www.aldiwan.net/poem22650.html","الطويل"],[19,"ودع لميس وداع الصارم اللاحي","https://www.aldiwan.net/poem326.html",""],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140900",""],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9976","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9948","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42512","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54193","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54228","الطويل"],[19,"ودّعْ لميسَ وداعَ الصّارمِ اللاحِي","https://www.poetsgate.com/ViewPoem.aspx?id=17914",""],[13,"جَزَى اللَّهُ فِتْيَاناً عَلَى العَوْصِ أَمْطَرَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=180822",""],[80,"وَمُطَّرِدِ الأجزاءِ يصقل مَتْنهُ","https://www.poetsgate.com/ViewPoem.aspx?id=3209",""],[88,"لقد سمعوا من الوطن الأنينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19527&r=&rc=30",""]],"verses":[["وَقَد لاحَت بِأَعيُنِنا ذُكاءٌ","وَراءَ الفَجرِ كَالخَدِّ اللَطيمِ",0,"م",1,0],["وَقَد لَمَعَت مِن حَواشي الغُمودِ","كَما نَصَلَت أَغُلٌ مِن غَنَم",1,"م",1,0],["وَقَد لفَّتِ الشُمُّ الغَطاريفُ عِرقَهُ","بِعِرقِكَ وَالأَرحامُ تُرعى وَتُكرَمُ",2,"م",1,0],["وقد لامَني مَنْ لو تأمَّلْتُ قَوْلَهُ","علمتُ يَقيناً أنهُ كان ألْوَما",3,"م",2,0],["وَقَد لاقَيتُ في سَفَري أُمور","تُشَيِّبُ مَن لَهُ في المَهدِ عامُ",4,"م",1,0],["وَقَد لَقِيتُ زياداً ثُمَّ قُلتُ لَهُ","وَقبلَ ذَلِكَ ما خَبَّت بِهِ الرُسُلُ",5,"ل",1,0],["وَقَد لَمَعَ المَشيبُ وَذاكَ سَيفٌ","عَلى فَودَيكَ عَلَّقَهُ الحِمامُ",6,"م",1,0],["وَقَد لَبِسَت لُبسَ الهَلوكِ ثِيابَها","تَراءى لَكَ الدُنيا بِكَفٍّ وَمِعصَمِ",7,"م",1,0],["وَقَد لَفَّنا في أَوَّلِ الدَهرِ نِعمَةٌ","فَعِشنا زَماناً آمِنينَ اِنفِتالَها",8,"ل",3,0],["وَقَد لاحَ لِلسّاري سُهَيلُ كَأَنَّهُ","قَرِيعُ هِجانٍ عارَضَ الشَولَ جافِرُ",9,"ر",1,0],["وَقَد لاحَ للسّاري الَّذي كَمَّلَ السُرَ","عَلى أُخرَياتِ اللَيلِ فَتقٌ مٌشَهَّرُ",10,"ر",1,0],["وقد لبس خضر الثياب","وفرط حسن قد بهر",11,"ر",1,0],["وقد لاحت مبرقعة المحيّا","من الغيم الرقيق بثوب شاش",12,"ش",1,0],["وقد لبِس الفضيلة وارتداها","وشَدّ عليه من حَزمِ حزاما",13,"م",2,0],["وقد لاح لي محمود شوكت جالساً","به فوق كرسي الجلالة والمجد",14,"د",1,0],["وَقَد لَيَّنتَ وَحشَهُمُ بِرِفقٍ","وَتُعيّ الناسَ وَحشُكَ أَن تُصادا",15,"د",2,0],["وَقَد لَحِقَ الثَمائِلُ بَعدَ بُدنٍ","وَقَد أَفنى عَرائِكَها الوُخودُ",16,"د",1,0],["وَقَد لامَ العَواذِلُ في سُلَيمى","وَقَلَّ إِلى عَواذِلي اِعتِذاري",17,"ي",1,0],["وَقَد لَحِقَ الفَرَزدَقُ بِالنَصارى","لِيَنصُرَهُم وَلَيسَ بِهِ اِنتِصارُ",18,"ر",1,0],["وَقَد لاحَ المَشيبُ فَما أَراهُ","عَداكَ وَقَد صَبَوتَ وَلا نَهاكا",19,"ك",2,0],["وَقَد لَبِسَت بَعدَ الزُبَيرِ مُجاشِعٌ","ثِيابَ الَّتي حاضَت وَلَم تَغسِلِ الدَما",20,"م",2,0],["وقد لقيت ظباء الأنس غاديةً","من كل أحورَ بالمكِّي مؤتتبُ",21,"ب",1,1],["وقد لبست من النوعين أردية","شتى وجربت من جَد ومن لعب",22,"ب",1,0],["وَقدّ لاَقى لِصَعبَتِهِ نِزَاراً","شَراحِيلُ بن أصهَبَ رَائِضَينَا",23,"ن",2,0],["وقد لاقيتُ من علياكَ بحراً","يلذّ مديحه في كلّ بحر",24,"ر",1,0],["وقد لقيت في الحبِّ ما لقيت عدى","لآلاءِ سيف الملك عاشت لشومها",25,"م",3,0],["وقد لقبوه نهر بوقٍ تعسفاً","وفي الوغد أشباه من البوق والنهر",26,"ر",1,0],["وقد لمعت حتى كأن بريقها","قلائد درٍّ فُصِّلت بعقيقِ",27,"ق",1,0],["وقد لاحظها الفاسِ","قُ من بين الشبابيكِ",28,"ك",1,0],["وقد لُمسَتُ من صفحتيك ملامسٌ","وجُرّبْتَ قِدْماً والمجرّبُ أعلمُ",29,"م",1,0],["وَقَد لَبِستُ لِهَذا الدَهرِ أَعصُرَهُ","حَتّى تَجَلَّلَ رَأسي الشَيبُ وَاِشتَعَلا",30,"ل",2,0],["وقد لا ارى في القول لي من سلامة","فاسكت عنه وهو يقدح في صدري",31,"ي",1,0],["وَقَد لَبِسَت دِمائَهُمُ عَلَيهِم","حِداداً لَم تَشُقَّ لَها جُيوباً",32,"ب",2,0],["وقد لفظتني الأرضُ حتى تراجعتْ","برحلي إِلى أكنافِ جانبكَ السَهْلِ",33,"ل",1,0],["وَقَد لَبِسَت بَغدادُ أَحسَنَ زِيِّها","لِإِقبالِهِ وَاِستَشرَفَت لِعُدولِهِ",34,"ل",2,0],["وَقَد لَبِستُ الهَوى وَإِن كانَ ضُرّاً","وَتَحَمَّلتُهُ وَإِن كانَ ثِقلا",35,"ل",2,0],["وَقَدٍّ لَو يَمُرُّ بِهِ نَسيمٌ","لَكادَ يَؤودُهُ مَرُّ النَسيمِ",36,"م",1,0],["وقد لبسوا الغدْرانَ وهي تموّجتْ","دروعاً وسلُّوا المرهفاتِ سواقيا",37,"ي",2,0],["وَقَد لاحَ نَجمُ الصُّبحِ حَتَّى كَأَنَّهُ","مَطرِقُ جَيشٍ مُؤذِنٌ بِأَميرِهِ",38,"ر",2,0],["وَقَد لَبِسوا من نَسجِ داود أعيُناً","مُداخَلَةً خُوصاً هي الحَلَقُ السرْدُ",39,"د",1,0],["وقدٌّ لقلبي فيهِ ألفُ بثينةٍ","فكلُّ رداءٍ ترتديهِ جميلُ",40,"ل",1,0],["وقدْ لا أراهُ كما قيلَ لي","وقدْ لا يراني كما قيلَ لَهْ",41,"ه",1,0],["وَقَد لَثَمَ النَقعُ أُسدَ الشَرى","وَكَرَّت بِها الخَيلُ تَعدو تُبا",42,"ب",2,0],["وَقَد لاحَ صُبحُ الشَيبِ وَاِنسَلَخَ الصِبا","فَيا صُبحُ ما أَجلى وَيا لَيلُ ما أَسرى",43,"ر",2,0],["وَقَد لاحَ وَجهُ الصُبحِ يَندى كَأَنَّهُ","وَراءَ قِناعِ اللَيلِ وَجهُ بَشيرِ",44,"ر",1,0],["وَقَد لَفَّ العَدُوَّ كَأَنَّ ريحاً","عَلى شَرَفٍ تَلُفُّ بِهِ هَشيما",45,"م",2,0],["وَقَد لَوى أَنفَهُ بِمَشفَرِها","طِلحُ قَراشيمَ شاحِبٌ جَسَدُه",46,"د",2,0],["وَقَد لاحَ دَوءُ الفَجرِ عَرضاً كَأَنَّهُ","بِلَمحَتِهِ أَقرابُ أَبلَقَ أَدهَمِ",47,"م",1,0],["وَقَد لَهَوتُ بِمَصقولٍ عَوارِضُها","بَكرٍ تُنازِعُني كَأساً وَعِنقادا",48,"د",2,0],["وَقَد لامَ عَقلي فيهِ نَفسي فَما اِنتَهَت","وَقالَت أَعِنّي بِاِحتِيالِكَ أَو دَعني",49,"ي",1,0],["وَقَد لاحَت لِساريها الثُرَيّا","كَأَنَّ نُجومَها نَورُ الأَقاحِ",50,"ح",1,0],["وَقَد لَمَعَت حَتّى كَأَنَّ بَريقَها","قَواريرُ فيها زِئبَقٌ يَتَرَجرَجُ",51,"ج",1,0],["وَقَد لاحَ الدُجى مَرآةَ قَينٍ","قَد اِنصَقَلَت وَمَقبِضُها الخَليجُ",52,"ج",1,0],["وَقَد لاحَ لِلساري سُهَيلٌ كَأَنَّهُ","عَلى كُلِّ نَجمٍ في السَماءِ رَقيبُ",53,"ب",1,0],["وَقَد لامَني فيها المُعَلّى وَلَو بَدا","لَهُ ما بَدا لي مِن مَحاسِنِها سَجَد",54,"د",1,0],["وَقَد لُمتُ نَفسي في الرَبابِ فَسامَحَت","مَراراً وَلَكِن في الفُؤادِ عِصاءُ",55,"ا",2,0],["وَقَد لاحَ شَيبٌ في الذَرا فَصَحَوتُمُ","وَصَحَّ لَكُم أَنَّ الشَبابَ مِنَ السُكرِ",56,"ر",1,0],["وَقَد لَهَوتُ بِمِثلِ الرِئمِ آنِسَةٍ","تُصبي الحَليمَ عَروبٍ غَيرِ مِكلاحِ",57,"ح",1,0],["وقد لبست دماؤهم عليهم","حداداً لم تشق لها جيوبا",58,"ب",2,0],["وَقَد لاقَيتُ في سَفَري أُموراً","تُشَيِّبُ مَن لَهُ في المَهدِ عامُ",59,"م",1,0],["وَقَد لاقَيتُ بَينَ يَدَيهِ لَيثاً","كَريهَ المُلتَقى مُرَّ المَذاقِ",60,"ق",1,0],["وَقَدْ لاحَ بِالظَّلْماءِ فَجْرٌ كَأَنَّهُ","بَياضُ مَشِيبٍ فِي سَوَادِ شَبابِ",61,"ب",1,0],["وقد لمحوا من نورِ طه شُعاعةً","فكل ظلامٍ في الوجود ضِياءُ",62,"ا",2,0],["وقد لوَّحتْ أيْدِيهِمَا فكأنّها","إِشاراتُ راياتِ تروحُ وتَلتَقي",63,"ق",2,0],["وقدْ لهوتُ بمثلِ الرّثمِ آنسة ٍ","تُصْبي الحليمَ عَرُوبٍ غير مِكْلاحِ",64,"ح",1,0],["وَقَدْ لاَحَ ضَوْءُ الْفَجرِ عَرْضاً كَأَنَّهُ","بِلَمْحَتِهِ أَقْرَابُ أَبْلَقَ أَدْهَمِ",65,"م",1,0],["وقد لاح نجمُ الصبح حتى كأنَّه","مطرق جيش مؤدن بأميره",66,"ر",2,0],["وقد لفتوا لرؤيتها العيونا","ألا يا راحلين لحرب قوم",67,"م",1,0]]}