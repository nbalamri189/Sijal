{"poems":[[75,"ألا هل درى الداعي المثوب إذ دعا","https://www.aldiwan.net/poem11947.html","الطويل"],[39,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[12,"إن بالشعب الذي دون سلع","https://www.aldiwan.net/poem1231.html",""],[87,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[45,"يا ديار العباهر الأتراب","https://www.aldiwan.net/poem10613.html","الخفيف"],[13,"إنا بالشعب الذي دون سلع","https://www.aldiwan.net/poem2182.html","المديد"],[22,"أتاني وأهلي بذات الدماخ","https://www.aldiwan.net/poem21688.html","المتقارب"],[70,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[22,"أَتَانِي وأهْلي بذَاتِ الدِّمَاخِ","https://www.poetsgate.com/ViewPoem.aspx?id=19729",""],[124,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[128,"علمك بعمان قرية","https://www.aldiwan.net/poem23740.html","البسيط"],[287,"في مدحي الصاحب ماض عزمي","https://www.aldiwan.net/poem32459.html","الرجز"],[369,"أتراها تظنني الطيف لطفا","https://www.aldiwan.net/poem60838.html","الخفيف"],[409,"أحسن ما يبدي به الكلام","https://www.aldiwan.net/poem33344.html","الرجز"],[409,"لا زلتم في نفس","https://www.aldiwan.net/poem33709.html","مجزوء الرجز"],[422,"شام برقا راعه مبتسما","https://www.aldiwan.net/poem53999.html","الرمل"],[435,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[463,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[469,"صعدة القد وسيف الكحل","https://www.aldiwan.net/poem3530.html","عموديه"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86940","الكامل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130629","المديد"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130625","الكامل"],[1319,"","https://poetry.dctabudhabi.ae/diwan/poem/128301","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64543","الخفيف"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78172","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53159","الرجز"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129866","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132709","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216779","السريع"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114399","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135728","الرجز"],[3928,"","https://poetry.dctabudhabi.ae/diwan/poem/131345","الخفيف"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123868","الخفيف"],[4717,"تباً لزوجكِ با هميسُ","https://www.poetsgate.com/ViewPoem.aspx?id=199684",""],[4843,"مسبّحٌ من لهُ في الخلقِ آياتُ","https://www.poetsgate.com/ViewPoem.aspx?id=142689",""],[4876,"مسٌ بشعرك","https://www.poetsgate.com/ViewPoem.aspx?id=207498",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""],[5956,"ما عادل بتاتاً","https://www.poetsgate.com/ViewPoem.aspx?id=193523",""]],"verses":[["مُسَبِّحَةُ الآناءِ قانِتَةُ الضُحى","ثَوَت فَزَوى مَغنى التَأَوُّهِ بَلقَعا",0,"ع",2,0],["مسبورة مشارفا مصرمة","محلولها الصاب تحتلب",1,"ب",1,0],["مُسبِلٌ في الحَيِّ أَحوى رِفَلٌّ","وإِذا يَعدُو فَسِمعٌ أَزَلُّ",2,"ل",1,0],["مُسَبِّحٍ لِلِقاءِ اللَهِ مُضطَرِمٍ","شَوقاً عَلى سابِخٍ كَالبَرقِ مُضطَرِمِ",3,"م",1,0],["مُسَبِّحاً لَكَ جُنحَ اللَيلِ مُحتَمِلاً","ضُرّاً مِنَ السُهدِ أَو ضُرّاً مِنَ الوَرَمِ",3,"م",1,0],["مسبلاً مثل راحة ابن عبيد ال","لهِ معطى الورى بغير حساب",4,"ب",1,0],["مُسبِلٌ في الحَيِّ أَحوى رِفَلُ","وَإِذا يَغزو فَسِمعٌ أَزَلُّ",5,"ل",1,0],["مَسَبُّ اِبنِ لُقمانَ عِرضَ اِمرِئٍ","شَديدِ الأَناةِ بَعيدِ الغَضَب",6,"ب",1,0],["مُسْبِلاً للنأي طَرْفاً جادَ إن","ضَنّ نَوءُ الطّرْفِ إذ يسقط خَي",7,"ي",1,0],["مَسَبُّ ابْنِ لُقْمانَ عِرْضَ امْرِىء ٍ","شَدِيدِ الأَنَاة ِ بَعِيدِ الغَضَبْ",8,"ب",1,0],["مسبحاً باسمه في كل آونةٍ","كما يسبح باسم اللَه رهبان",9,"ن",1,0],["مسبة الدين تسبيح بمطرحها","وأتعس الخلق من بالوعد ترضيه",10,"ه",1,0],["مُسَبِّحاً خَريرُهُ يَدعو لَهُ ال","لَهَ تَعالى بِالبَقاءِ الجَمِّ",11,"م",1,0],["مُسبَغاً ظِلُّكَ الظّليلَ عليها","وعلَينا ما حَنّتِ النِّيبُ مُضْفَى",12,"ف",2,0],["مسبحاً لفظ الثنا والشكر","ببذله التسهيل بعد اليسر",13,"ر",1,0],["مسبحاً معظماً","ذاك الجناب الأقدس",14,"س",1,0],["مسبغاً فيها عَلَيْنا نِعَماً","أسْبَغَ الله عليك النِعما",15,"م",2,0],["مسبولةٌ أجناحهُ مزرقه","متسع الصدر بهي الخلقه",16,"ه",1,0],["مسبوقة أخَّرها عصرُها","وهي إلى الإحسان لم تُسبَقِ",17,"ق",1,0],["مسبلاً يتلو لنا والليل والخ","دُّ يتلو والنهار المنجلي",18,"ل",2,0],["مسبعة يأتي لسابع سبعة","إذا أُحصيت صحت لنا ايامه",19,"ه",1,0],["مس بِالحَجر الَّذي","فيهِ اللظى جَهلاً بِغَير قِياسِ",20,"س",1,0],["مس باعطافك واثن قواما","وترنح بالتثني عروسا",21,"س",2,0],["مسبيّة مسلوبة مهتوكة","حملت على عجف النياق الرسم",22,"م",1,0],["مسبح بلغات العارفات به","لم تدر ما غيره رباً ولم تجد",23,"د",1,0],["مسبغ النعمتين ذا المن يا اللّه","يا اللّه طول منك طولي",24,"ل",2,0],["مَسبوكَةً بِلآلئٍ وَجَواهِرٍ","وَوُجوه تَحسين كَصُبحٍ سافر",25,"ر",1,0],["مسبَّل الرفد لكل وافد","ليس على باب نداه غَلَق",26,"ق",1,0],["مسبلا سترَهُ منّعم بالٍ","وجفوني من سهده في كفاح",27,"ح",1,0],["مسبغاً في البلاد ظلا من الع","دل ظليلا للناس فيه مقيل",28,"ل",1,0],["مسبحاً لله مستغفراً","من أول الليل إلى فجره",29,"ر",2,0],["مُسَبِّحاً وَهُوَ التسبيحُ يَطرُدُ عَن","رَوضِ القُلُوبِ طُيُورَ الوَهمِ والسَّقَمِ",30,"م",1,0],["مسبِّبٌ يا مبهجٌ يا منجزُ","أنجز لنا وعداً به نعزّزُ",31,"ز",1,0],["مُسْبِلاً دَمْعَهُ كأنَّ حبِيباً","بعد قُرْبٍ رَماهُ منه ببُعْدِ",32,"د",1,0],["مسبغ الأنعم التي قد توالت","وغدت كالأطواق في كل جيد",33,"د",1,0],["(مسْبِيرُ) صرْحٌ للكنانةِ صادحٌ","أمَّا (عميرُكمُو) غرابٌ ينعقُ",34,"ق",1,0],["مسبّحٌ من لهُ في الخلقِ آياتُ","أثمّةٌ ذكرهم حيٌّ وإن ماتوا",35,"ت",3,1],["مسٌّ بشِعركَ أَيُّها الصخاب","شابتْ ذَوائبُ حامليهِ فَذابُوا",36,"ب",3,1],["مسٌ بشِعرك والقصيدة حرةٌ","مسٌّ.. ويمسكُ رأسَها القصَّابُ",36,"ب",1,0],["مسبلاً مئزر الرجاء بمشيٍ","عثّر الخوفُ خطوه أعواما",37,"م",2,0],["مُسَبّبِ التشتيتِ","وقادحِ الكبريتِ",38,"ت",1,0]]}