{"poems":[[53,"أيا جبلي نجد أبينا سقيتما","https://www.aldiwan.net/poem29656.html","الطويل"],[53,"أظن الليالي بعدكم ستريع","https://www.aldiwan.net/poem30150.html","الطويل"],[53,"رضيت من الأحباب دون الذي يرضي","https://www.aldiwan.net/poem30167.html","الطويل"],[53,"أيا لله أي هوى أضاء","https://www.aldiwan.net/poem30781.html","الوافر"],[73,"لبيض الطلى ولسود اللمم","https://www.aldiwan.net/poem11934.html","المتقارب"],[35,"خليلي هذا ربع عزة فاعقلا","https://www.aldiwan.net/poem39177.html","الطويل"],[93,"هدايا الناس من زهر الجنان","https://www.aldiwan.net/poem11187.html","الوافر"],[88,"قل لسلمان بعدما كان حرا","https://www.aldiwan.net/poem44799.html","الخفيف"],[47,"دعوتك للجفن القريح المسهد","https://www.aldiwan.net/poem25322.html","الطويل"],[23,"ما بال عيني دموعها تكف","https://www.aldiwan.net/poem21478.html","المنسرح"],[72,"أقيما فروض الحزن فالوقت وقتها","https://www.aldiwan.net/poem18388.html","الطويل"],[72,"لثمت ثغر عذولي حين سماك","https://www.aldiwan.net/poem19438.html","البسيط"],[51,"أناديك يا من ليس في سمعه وقر","https://www.aldiwan.net/poem64064.html","الطويل"],[26,"أمن آل ليلى بالضجوع وأهلنا","https://www.aldiwan.net/poem24084.html","الطويل"],[91,"هذه ملفرد قد لاحت رباها","https://www.aldiwan.net/poem62802.html","عموديه"],[85,"أنادي الرسم لو ملك الجوابا","https://www.aldiwan.net/poem63784.html","الوافر"],[43,"أبعد نأي المليحة البخل","https://www.aldiwan.net/poem10113.html","المنسرح"],[105,"كيف القرار ونار الحرب تستعر","https://www.aldiwan.net/poem43164.html","البسيط"],[81,"مضى الوصل إلا منية تبعث الأسى","https://www.aldiwan.net/poem61446.html","البسيط"],[48,"أسقياني من شمول","https://www.aldiwan.net/poem66633.html","مجزوء الرمل"],[46,"روح ذبيحك لا تعجله ميتته","https://www.aldiwan.net/poem22242.html","البسيط"],[46,"إني ونفسي أبدا في جذاب","https://www.aldiwan.net/poem22373.html","السريع"],[46,"كم تنصح الدنيا ولا نقبل","https://www.aldiwan.net/poem23149.html","السريع"],[46,"لعمري الخير الذخر في كل شدة","https://www.aldiwan.net/poem23557.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9958","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42682","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54513","الرمل"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/19824","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141981","الكامل"],[106,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[113,"رعى الله أياما تقضت بشيخون","https://www.aldiwan.net/poem41763.html","الطويل"],[113,"وهى حملي وضقت لثقل حوبي","https://www.aldiwan.net/poem42160.html","الوافر"],[113,"لقد أكثر الباغي التعدي بقوله","https://www.aldiwan.net/poem42162.html","الطويل"],[113,"لجأت بأعتاب الحبيب ابن هاشم","https://www.aldiwan.net/poem42165.html","الطويل"],[113,"بدأت ببسم الله في مبدأ الأمر","https://www.aldiwan.net/poem42205.html","الطويل"],[118,"أناديك لو رد النداء رميم","https://www.aldiwan.net/poem49281.html","الطويل"],[118,"آنستني بالأملا المغري","https://www.aldiwan.net/poem49283.html","السريع"],[130,"هويت فقالوا لي تسل أو ارعو","https://www.aldiwan.net/poem54685.html","الوافر"],[130,"بالسب من يدعى ما ليس فيه حر","https://www.aldiwan.net/poem54822.html","البسيط"],[133,"سواي بهذه الدنيا يبالي","https://www.aldiwan.net/poem48852.html","الوافر"],[184,"ولي هر رميت به خبيث","https://www.aldiwan.net/poem43306.html","الوافر"],[187,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[195,"هات يا ساق هات بنت النخيل","https://www.aldiwan.net/poem39944.html","الخفيف"],[197,"أناديك يا قلب مذ ودعوا","https://www.aldiwan.net/poem45607.html","المتقارب"],[209,"وفدت على بغداد والقلب موجع","https://www.aldiwan.net/poem46574.html","الطويل"],[209,"أسافر في يوم الثلاثاء ليتني","https://www.aldiwan.net/poem46608.html","الطويل"],[219,"ليالي النوى علمتني النحيبا","https://www.aldiwan.net/poem55301.html","المتقارب"],[221,"أتجهل قدر بشر إن بشرا","https://www.aldiwan.net/poem39691.html","الوافر"],[227,"أأظهر أم أخفي الذي بي من السقم","https://www.aldiwan.net/poem50791.html","الطويل"],[233,"أبثك مجد الدين حالا سماعها","https://www.aldiwan.net/poem32199.html","الطويل"],[269,"بارق بالابرق الفرد سرى","https://www.aldiwan.net/poem52054.html","الرمل"],[288,"هند عذراء أسلمتها المقادير","https://www.aldiwan.net/poem11680.html","الخفيف"],[295,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[302,"يلومونني واللوم ما أنا تاركه","https://www.aldiwan.net/poem16748.html","الطويل"],[311,"قل لإخوان رأوني ميتا","https://www.aldiwan.net/poem59500.html","الرمل"],[326,"وسألتني من أنت لما جئت","https://www.aldiwan.net/poem54986.html","مجزوء الكامل"],[347,"هم المنى والأمل","https://www.aldiwan.net/poem15858.html","مجزوء الرجز"],[351,"جانب معاشرة الملوك لزينة","https://www.aldiwan.net/poem40029.html","الكامل"],[369,"باتت أساطير الهوى تتلى","https://www.aldiwan.net/poem57176.html","السريع"],[374,"طهارة نفس لا تفيد وتنفع","https://www.aldiwan.net/poem59338.html","الطويل"],[377,"لقد هان عندي العدل في جانب الحب","https://www.aldiwan.net/poem49247.html","الطويل"],[390,"إنا دعوناك على انبساط","https://www.aldiwan.net/poem53510.html","مشطور الرجز"],[399,"أنا غيظ كل مناصب","https://www.aldiwan.net/poem46976.html","مجزوء الكامل"],[403,"ألا هل لعهد العامرية جاحد","https://www.aldiwan.net/poem50184.html","الطويل"],[413,"ألما على لومي وجدا مجددا","https://www.aldiwan.net/poem54134.html","الطويل"],[434,"منازلهم بين اللوى فالدكادك","https://www.aldiwan.net/poem2528.html","الطويل"],[437,"أیدرك قومي أن بالأرض مغنما","https://www.aldiwan.net/poem68017.html","عموديه"],[438,"أعد نظراً في السرب بالرمل من حزوي","https://www.aldiwan.net/poem14343.html","الطويل"],[438,"على تالد الأيام لي طارف الحزن","https://www.aldiwan.net/poem14484.html","الطويل"],[444,"أنادي بركب الموت للموت غلسوا","https://www.aldiwan.net/poem23951.html","الطويل"],[447,"أناديك هل تدرين ما سبب النّدا ؟","https://www.aldiwan.net/poem1015.html",""],[456,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[475,"ولوع بتذكار الأحبة لا يفنى","https://www.aldiwan.net/poem15292.html","الطويل"],[477,"أناديها وما لي لا أنادي","https://www.aldiwan.net/poem37581.html","الوافر"],[513,"أنادي من الإخوان غير مجيب","https://www.aldiwan.net/poem12038.html","الطويل"],[513,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[536,"أنادي رصيفا لي هناك وإنني","https://www.aldiwan.net/poem48139.html","عموديه"],[556,"أنا صاحب الأمر الإلهي","https://www.aldiwan.net/poem33662.html","مجزوء الكامل"],[556,"أحرف في سكونها الإعدام","https://www.aldiwan.net/poem33863.html","الخفيف"],[556,"أنا دائما يا نور كل مليح","https://www.aldiwan.net/poem34680.html","الكامل"],[562,"ولما رأيت الدل في شرعة الهوى","https://www.aldiwan.net/poem877.html",""],[567,"إِن ادع مسكينا فلست بمنكر","https://www.aldiwan.net/poem52002.html","الطويل"],[567,"إن أدع مسكينا فما قصرت","https://www.aldiwan.net/poem52007.html","أحذ الكامل"],[567,"إن أدع مسكينا فاني ابن معشر","https://www.aldiwan.net/poem52028.html","الطويل"]],"verses":[["أُناديكُما شَوقاً وَأَعلَمُ أَنَّهُ","وَإِن طالَ رَجعُ القَولِ لا تَعِيانِ",0,"ن",1,0],["أُناديكَ مِن تَحتِ الخُطوبِ غَدا لَها","بِمَظهَريَ رَحلٌ ضاغِطٌ وَقُطوعُ",1,"ع",1,0],["أُناديكَ فَاِرجِع مِن قِريبٍ فَإِنَّني","إِذا ضاقَ بي ذَرعي مَضَيتُ كَما تَمضي",2,"ي",1,0],["أُنادي الرَكبَ دونَكُمُ ثَراهُ","لَعَلَّ بِهِ لِذي داءٍ دَواءَ",3,"ا",2,0],["أُناديكَ عَن مِقَةٍ عَهدُها","كَما وَشَتِ الرَوضَ أَيدي الرِهَم",4,"م",1,0],["أُناديكَ ما حَجَّ الحَجِيجُ وَكَبَّرَت","بِفَيفاء آل رُفقَةٌ وَأَهَلَّتِ",5,"ت",1,0],["أَنَادِرَةُ الرِّجَالِ نُهًى وَعِلْماً","وَنُضْجاً بِاليَرَاعَةِ وَاللِّسَانِ",6,"ن",1,0],["إن أدمون في الوزارة باق","يُترجّى في بهوِها ويزار",7,"ر",1,0],["أُناديكَ لا أَنّي أَخافُ مِنَ الرَدى","وَلا أَرتَجي تَأخيرَ يَومٍ إِلى غَدِ",8,"د",1,0],["إِن أَدعُ في المَجدِ أَلقَهُم سَلَفاً","أَهلَ فِعالٍ يَبدوا إِذا وُصِفوا",9,"ف",3,0],["أنادي ثرى الحسناء والترب بيننا","وعزَّ على صمتِ المتيمِ صمتها",10,"ت",3,0],["إن ادّعيت من البشرِ المصيف بهِ","غيظاً فقد ثبتت في الوجهِ دعواك",11,"ك",1,0],["أناديك يا من ليس في سمعه وَقْرُ","نداءَ مُحقّ لا يُنَهْنههُ الزجرُ",12,"ر",1,1],["أُنادي إِذا أوفي مِنَ الأَرضِ مَرقَباً","وَإِنّي سَميعٌ لَو أُجابُ بَصيرُ",13,"ر",1,0],["أَنا دُنيا مِن شَبابٍ وَهَوىً","وَهيَ كَالرَوضَةِ قَد تَمَّت حَلاها",14,"ا",3,0],["أُنادي الرَسمَ لَو مَلَكَ الجَوابا","وَأُجزيهِ بِدَمعِيَ لَو أَثابا",15,"ب",2,1],["إِن أَدبَرَت قُلتَ لا تَليلَ لَها","أَو أَقبَلَت قُلتَ ما لَها كَفَلُ",16,"ل",1,0],["إِن أَدعُهُم لِجَلاءِ الغَمرَةِ اِبتَدَروا","وَإِن أَصِح فيهِمُ مُستَنفِراً نَفَروا",17,"ر",3,0],["أُنادي سُلُوّي لِلَّذي حَلَّ مِنكَ بي","كَأَنّي أُنادي أَو أُكَلِّمُ أَخرَسا",18,"س",2,0],["أن أدعها قوتَ أُخرى","من مزاجٍ الزنجبيلِ",19,"ل",1,0],["إِن أَدلَجوا وَتَخَلَّفنا وَراءَهُمُ","شَيئاً يَسيراً فَإِنّا سَوفَ نَدَّلِجُ",20,"ج",1,0],["إِن أَدخُلِ النارَ فَلي خالِقٌ","يَحمِلُ عَنّي مُثقَلاتِ العَذاب",21,"ب",1,0],["إِنَّ أَديماً لي أَنا وَقتُهُ","فَأَينَ مِنّي الشَجَرُ المَعبِلُ",22,"ل",1,0],["إِنِ اِدَّعَيا في وُدِّهِ الجَهدُ صُدِّقا","وَما اِتُّّهِما فيهِ فَيَنتَحِلاهُ",23,"ل",3,0],["إن أَدنى توابع الشمس فيما","علموه عطارد في السماء",24,"ا",2,0],["أَنا دَمعي يَفيضُ وَأَنتَ باكٍ","بِلا دَمعٍ فَذاكَ بُكاءُ سالي",25,"ي",1,0],["أُنَادِي بِأَعْلَى الصَّوْتِ أَسْأَلُ عَنْهُمُ","فَهَلْ أَنْتَ يَا دَهْرَ الأَعَاجِيبِ سَامِعُ",26,"ع",1,0],["أَنَّ أَدْلِينَ عَرُوسٌ كَمُلَتْ","بِمَعَانٍ خَيْرِ مَا فيها الوَفَاءْ",27,"ف",3,0],["أُنادي لِجيرانِنا يَقصِدوا","فَنَقضي اللُبانَةَ أَو نَعهَدُ",28,"د",1,1],["أنا دمعة الأدب الحزي","ن رسالة الألم المذيب",29,"ب",1,0],["إن أدرتمُ أن تَبتَنُوا مجدَ مصرٍ","فاجعلوا الاقتصاد أسَّ البناء",30,"ا",2,0],["أناديه ملهوف الفؤاد وليس لي","سواه من الأعداء راع يحاميني",31,"ن",2,0],["أناديه وأخجل من ذنوبي","وليس سواه أطلب من مجيب",32,"ب",1,0],["أناديه يا سر البرايا وأصلها","ويا من فروع الكون تنمي لأصله",33,"ل",2,0],["أناديه مجروح الفؤاد وليس لي","سواه وحالي حال عاص ونادم",34,"م",1,0],["أناديه ياللَه جد لي تكرما","وبالفضل يا رحمن كن جابراً كسرى",35,"ر",2,0],["أناديك لو رد النداء رميم","وأبكيك لو أجدي عليك سجيم",36,"م",1,1],["أناديه وما أفتري","يا زهرة صيغت من الصخر",37,"ر",1,0],["أُنَادِيهِ بِالمصبَاحِ مِثل مَفَازَةٍ","وَلَم يَدر اللهُ مَا هُو مَنتَوِ",38,"و",1,0],["إن ادَّعَى رُتبَةً في الدِّينِ عَالِيَةً","قَد كَذَّبَتهَا نُصُوصُ الآىِ والخَبَرِ",39,"ر",1,0],["أنادي واحدٌ فيجيب طه","ويتبعه محمدُ في المقالِ",40,"ل",1,0],["أنادي زبرجا والليل هاد","وزبرج في خرابات العوام",41,"م",1,0],["أُنادي بِأعلى الصوتِ في الناس صارخاً","لِشدّةِ وجدٍ أجّجت في الحَشا الجَمرا",42,"ر",2,0],["أنا ديني الهوى ودمعي نبيّي","حينَ أصبو ووحيُهُ إنجيلي",43,"ل",2,0],["أناديكَ يا قلبُ مذ ودعوا","فما لي أنادي ولا تسمعُ",44,"ع",1,1],["أنادمهم بالوهم والقلب عارفٌ","بأني لدى كأس من الدمع حمراء",45,"ا",2,0],["أنادم أحبابي وفي الحق أنني","لهول الذي ألقى أصاول أعدائي",45,"ي",1,0],["أنادمهُ والكاس منه بعيدةٌ","ففي روحه كأس تصول وتجهل",46,"ل",1,0],["أناديك عثمان والقلب مضنى","وما كان عهدي أن لا تجيبا",47,"ب",2,0],["أَنا دَهرٌ وَأَيّامي سَعيرٌ","إِذا نازَلتَني نازَلتَ دَهرا",48,"ر",2,0],["أناديك أم أشكو إليك ظُلامتي","أم أشكوك أم أكني عن الأمر أم أُسمي",49,"ي",1,0],["أُناديكَ مَرجُوّاً لِسَدِّ خَصاصَتي","وَمِثلُكَ مَن لَبّى نَداهُ نِدائي",50,"ي",1,0],["ان أدنىواجب الخدمة أن","تبلغوا عَبد الرَحيم الوطرا",51,"ر",2,0],["أنا دنست بالخطيئة عرضي","أنا لم أبق للفضيلة سترا",52,"ر",2,0],["إِن أَدنُ ينأوا وما قَلبي كقلبهم","وَهَل يُطابَقُ مصدوعٌ بملتئِمِ",53,"م",1,0],["أُنادي قَريباً قَد سَبَّتهُ حُظوظُهُ","وَأَدعو بَعيداً أَسَرَتهُ مَهالِكُه",54,"ك",2,0],["أنادر قد حواه صدف","كنت ممحوناً فعفت المحنا",55,"ن",2,0],["أنا دمعةُ الجفن","الكسير وآهة القلب الحزين",56,"ن",1,0],["إِن أَدبَروا بِوُدِّهِم","فَصِدقُ وُدي مُقبِلُ",57,"ل",1,0],["أن أَدخَلَت مِن مائه في جَوفِها","يَغتالها مَع مائها في جَوفهِ",58,"ه",1,0],["إن أدرَكَ العيدَ وأفعالَه","فَالعيدُ لَم يُدرِك لَه مِثلا",59,"ل",2,0],["أنادي وقد ناديت من لا يجيبني","سواك أعن يا رب والقلب يَهلع",60,"ع",1,0],["أَنادمهُ مُستملياً وَحديثهُ","وَصورَتُهُ ما لا يَخف عَلى قَلبي",61,"ي",1,0],["إنّا دَعوناكَ عَلى اِنبِساطِ","وَالجوعُ قَد أَثَّرَ في الأَخلاطِ",62,"ط",1,1],["أنا دينُ آلِ محمدٍ","سفنُ النَّجا شهْبُ الأمانِ",63,"ن",1,0],["أَناديكِ مِن شَوقٍ إِلَيكَ وَصبوة","وَما بَينَ دارينا مَدىً مُتباعِدُ",64,"د",1,0],["أُنادي الحمى بالنوح عن ساكن الحمى","فيا حبّذا لو أنَّه يسمع الندا",65,"د",2,0],["أنادي بمحاديهم ترفق فإنما","فراق لبيني تاركي في الهوالك",66,"ك",1,0],["أنادي بإنشاء المدارس ليتني","أری بذرة الآمال تنمو وتثمر",67,"ر",1,0],["أنادي فلا یجدي النداء سوی الحزن","ومن منجم الأحزان یستورد الجمر",67,"ر",1,0],["أنادي سعاداً ودعينا سعادةً","وأعلو بصوتي وهي تعرفه علوى",68,"و",2,0],["أناديك محزوناً وأدعوك راجياً","سل اللَه أن ألقاك في جنتي عدن",69,"ن",1,0],["أُنادي بِرَكبِ المَوتِ لِلمَوتِ غَلِّسوا","فَإِنَّ تِلاعَ العَمقِ بِالمَوتِ دَرَّتِ",70,"ت",1,1],["أناديك هل تدرين ما سبب النّد","فؤاد عليه جفنك الفاتن اعتدى",71,"د",2,1],["أناديه وتَنشُدُه المغاني","ولكن لا حياةَ لمن تُنادي",72,"ي",1,0],["أُنادي به لُبنى واِن كنت لا أرى","سوى مربع بالي الرسومِ ولا لُبنى",73,"ن",2,0],["أناديها وما لي لا أنادي","بلادي تونس الخضرا بلادي",74,"ي",1,1],["أنادي من الإخوان غير مجيب","وأمدح بالأشعار غير مثيب",75,"ب",1,1],["أناديه قل كيف شئت فهذه","خصائصه مأثورة وحصائله",76,"ل",2,0],["أُنادي رَصيفاً لي هُناك وإنَّني","أُحِبُّ رَصيفي فوقَ حَبِّ الورَى طُرَّا",77,"ر",2,1],["أنا درة البحر المحي","ط بما يحيط من المياه",78,"ا",2,0],["إن إدغام أحرف الكون فيه","لسكون بها هو الإنعام",79,"م",1,0],["أنا دائما يا نور كل مليحِ","بين الكناية فيك والتصريحِ",80,"ح",1,1],["أناديه إذ ادعوه يا نور مقلتي","ويا بهجتي إني بحبك موثق",81,"ق",1,0],["إِن ادع مسكيناً فَلَستُ بمنكر","وهل ينكرنّ الشمس ذر شعاعها",82,"ه",2,1],["إِن أَدع مسكيناً فما قصرت","قدري بيوت الحي والجدرُ",83,"ر",1,1],["إِن أَدعَ مسكيناً فاني ابن معشر","من الناس أَحمي عنهم وأَذودُ",84,"د",1,1]]}