هًى وَعِلْماً","وَنُضْجاً بِاليَرَاعَةِ وَاللِّسَانِ",6,"ن",1,0],["إن أدمون في الوزارة باق","يُترجّى في بهوِها ويزار",7,"ر",1,0],["أُناديكَ لا أَنّي أَخافُ مِنَ الرَدى","وَلا أَرتَجي تَأخيرَ يَومٍ إِلى غَدِ",8,"د",1,0],["إِن أَدعُ في المَجدِ أَلقَهُم سَلَفاً","أَهلَ فِعالٍ يَبدوا إِذا وُصِفوا",9,"ف",3,0],["أنادي ثرى الحسناء والترب بيننا","وعزَّ على صمتِ المتيمِ صمتها",10,"ت",3,0],["إن ادّعيت من البشرِ المصيف بهِ","غيظاً فقد ثبتت في الوجهِ دعواك",11,"ك",1,0],["أناديك يا من ليس في سمعه وَقْرُ","نداءَ مُحقّ لا يُنَهْنههُ الزجرُ",12,"ر",1,1],["أُنادي إِذا أوفي مِنَ الأَرضِ مَرقَباً","وَإِنّي سَميعٌ لَو أُجابُ بَصيرُ",13,"ر",1,0],["أَنا دُنيا مِن شَبابٍ وَهَوىً","وَهيَ كَالرَوضَةِ قَد تَمَّت حَلاها",14,"ا",3,0],["أُنادي الرَسمَ لَو مَلَكَ الجَوابا","وَأُجزيهِ بِدَمعِيَ لَو أَثابا",15,"ب",2,1],["إِن أَدبَرَت قُلتَ لا تَليلَ لَها","أَو أَقبَلَت قُلتَ ما لَها كَفَلُ",16,"ل",1,0],["أُنادي بِرَكبِ المَوتِ لِلمَوتِ غَلِّسوا","فَإِنَّ تِلاعَ العَمقِ بِالمَوتِ دَرَّتِ",17,"ت",1,1],["إِن أَدعُهُم لِجَلاءِ الغَمرَةِ اِبتَدَروا","وَإِن أَصِح فيهِمُ مُستَنفِراً نَفَروا",18,"ر",3,0],["أُنادي سُلُوّي لِلَّذي حَلَّ مِنكَ بي","كَأَنّي أُنادي أَو أُكَلِّمُ أَخرَسا",19,"س",2,0],["أن أدعها قوتَ أُخرى","من مزاجٍ الزنجبيلِ",20,"ل",1,0],["إِن أَدلَجوا وَتَخَلَّفنا وَراءَهُمُ","شَيئاً يَسيراً فَإِنّا سَوفَ نَدَّلِجُ",21,"ج",1,0],["إِن أَدخُلِ النارَ فَلي خالِقٌ","يَحمِلُ عَنّي مُثقَلاتِ العَذاب",22,"ب",1,0],["إِنَّ أَديماً لي أَنا وَقتُهُ","فَأَينَ مِنّي الشَجَرُ المَعبِلُ",23,"ل",1,0],["إِنِ اِدَّعَيا في وُدِّهِ الجَهدُ صُدِّقا","وَما اِتُّّهِما فيهِ فَيَنتَحِلاهُ",24,"ل",3,0],["إن أَدنى توابع الشمس فيما","علموه عطارد في السماء",25,"ا",2,0],["أَنا دَمعي يَفيضُ وَأَنتَ باكٍ","بِلا دَمعٍ فَذاكَ بُكاءُ سالي",26,"ل",2,0],["أُنَادِي بِأَعْلَى الصَّوْتِ أَسْأَلُ عَنْهُمُ","فَهَلْ أَنْتَ يَا دَهْرَ الأَعَاجِيبِ سَامِعُ",27,"ع",1,0],["أَنَّ أَدْلِينَ عَرُوسٌ كَمُلَتْ","بِمَعَانٍ خَيْرِ مَا فيها الوَفَاءْ",28,"ف",3,0],["أُنادي لِجيرانِنا يَقصِدوا","فَنَقضي اللُبانَةَ أَو نَعهَدُ",29,"د",1,1],["أنا دمعة الأدب الحزي","ن رسالة الألم المذيب",30,"ب",1,0],["إن أدرتمُ أن تَبتَنُوا مجدَ مصرٍ","فاجعلوا الاقتصاد أسَّ البناء",31,"ا",2,0],["أناديك للجلى وأنت شهابها","وقمقامها ان أعوزتها القماقم",32,"م",1,0],["أناديه ملهوف الفؤاد وليس لي","سواه من الأعداء راع يحاميني",33,"ن",2,0],["أناديه وأخجل من ذنوبي","وليس سواه أطلب من مجيب",34,"ب",1,0],["أناديه يا سر البرايا وأصلها","ويا من فروع الكون تنمي لأصله",35,"ل",2,0],["أناديه مجروح الفؤاد وليس لي","سواه وحالي حال عاص ونادم",36,"م",1,0],["أناديه ياللَه جد لي تكرما","وبالفضل يا رحمن كن جابراً كسرى",37,"ر",2,0],["أناديك لو رد النداء رميم","وأبكيك لو أجدي عليك سجيم",38,"م",1,1],["أناديه وما أفتري","يا زهرة صيغت من الصخر",39,"ر",1,0],["أُنَادِيهِ بِالمصبَاحِ مِثل مَفَازَةٍ","وَلَم يَدر اللهُ مَا هُو مَنتَوِ",40,"و",1,0],["إن ادَّعَى رُتبَةً في الدِّينِ عَالِيَةً","قَد كَذَّبَتهَا نُصُوصُ الآىِ والخَبَرِ",41,"ر",1,0],["أنادي واحدٌ فيجيب طه","ويتبعه محمدُ في المقالِ",42,"ل",1,0],["أنادي زبرجا والليل هاد","وزبرج في خرابات العوام",43,"م",1,0],["أُنادي بِأعلى الصوتِ في الناس صارخاً","لِشدّةِ وجدٍ أجّجت في الحَشا الجَمرا",44,"ر",2,0],["أنا ديني الهوى ودمعي نبيّي","حينَ أصبو ووحيُهُ إنجيلي",45,"ل",2,0],["أناديكَ يا قلبُ مذ ودعوا","فما لي أنادي ولا تسمعُ",46,"ع",1,1],["أنادمهم بالوهم والقلب عارفٌ","بأني لدى كأس من الدمع حمراء",47,"ا",2,0],["أنادم أحبابي وفي الحق أنني","لهول الذي ألقى أصاول أعدائي",47,"ي",1,0],["أنادمهُ والكاس منه بعيدةٌ","ففي روحه كأس تصول وتجهل",48,"ل",1,0],["أناديك عثمان والقلب مضنى","وما كان عهدي أن لا تجيبا",49,"ب",2,0],["أَنا دَهرٌ وَأَيّامي سَعيرٌ","إِذا نازَلتَني نازَلتَ دَهرا",50,"ر",2,0],["أناديك أم أشكو إليك ظُلامتي","أم أشكوك أم أكني عن الأمر أم أُسمي",51,"م",2,0],["أُناديكَ مَرجُوّاً لِسَدِّ خَصاصَتي","وَمِثلُكَ مَن لَبّى نَداهُ نِدائي",52,"ي",1,0],["ان أدنىواجب الخدمة أن","تبلغوا عَبد الرَحيم الوطرا",53,"ر",2,0],["أنا دنست بالخطيئة عرضي","أنا لم أبق للفضيلة سترا",54,"ر",2,0],["إِن أَدنُ ينأوا وما قَلبي كقلبهم","وَهَل يُطابَقُ مصدوعٌ بملتئِمِ",55,"م",1,0],["أُنادي قَريباً قَد سَبَّتهُ حُظوظُهُ","وَأَدعو بَعيداً أَسَرَتهُ مَهالِكُه",56,"ك",2,0],["أنادر قد حواه صدف","كنت ممحوناً فعفت المحنا",57,"ن",2,0],["أنا دمعةُ الجفن","الكسير وآهة القلب الحزين",58,"ن",1,0],["إِن أَدبَروا بِوُدِّهِم","فَصِدقُ وُدي مُقبِلُ",59,"ل",1,0],["أن أَدخَلَت مِن مائه في جَوفِها","يَغتالها مَع مائها في جَوفهِ",60,"ه",1,0],["إن أدرَكَ العيدَ وأفعالَه","فَالعيدُ لَم يُدرِك لَه مِثلا",61,"ل",2,0],["أنادي وقد ناديت من لا يجيبني","سواك أعن يا رب والقلب يَهلع",62,"ع",1,0],["أَنادمهُ مُستملياً وَحديثهُ","وَصورَتُهُ ما لا يَخف عَلى قَلبي",63,"ب",2,0],["إنّا دَعوناكَ عَلى اِنبِساطِ","وَالجوعُ قَد أَثَّرَ في الأَخلاطِ",64,"ط",1,1],["أنا دينُ آلِ محمدٍ","سفنُ النَّجا شهْبُ الأمانِ",65,"ن",1,0],["أَناديكِ مِن شَوقٍ إِلَيكَ وَصبوة","وَما بَينَ دارينا مَدىً مُتباعِدُ",66,"د",1,0],["أُنادي الحمى بالنوح عن ساكن الحمى","فيا حبّذا لو أنَّه يسمع الندا",67,"د",2,0],["أنادي بمحاديهم ترفق فإنما","فراق لبيني تاركي في الهوالك",68,"ك",1,0],["أنادي بإنشاء المدارس ليتني","أری بذرة الآمال تنمو وتثمر",69,"ر",1,0],["أنادي فلا یجدي النداء سوی الحزن","ومن منجم الأحزان یستورد الجمر",69,"ر",1,0],["أنادي سعاداً ودعينا سعادةً","وأعلو بصوتي وهي تعرفه علوى",70,"و",2,0],["أناديك محزوناً وأدعوك راجياً","سل اللَه أن ألقاك في جنتي عدن",71,"ن",1,0],["أناديك هل تدرين ما سبب النّد","فؤاد عليه جفنك الفاتن اعتدى",72,"د",2,1],["أناديه وتَنشُدُه المغاني","ولكن لا حياةَ لمن تُنادي",73,"د",2,0],["أُنادي به لُبنى واِن كنت لا أرى","سوى مربع بالي الرسومِ ولا لُبنى",74,"ن",2,0],["أناديها وما لي لا أنادي","بلادي تونس الخضرا بلادي",75,"د",2,1],["أنادي من الإخوان غير مجيب","وأمدح بالأشعار غير مثيب",76,"ب",1,1],["أناديه قل كيف شئت فهذه","خصائصه مأثورة وحصائله",77,"ل",2,0],["أُنادي رَصيفاً لي هُناك وإنَّني","أُحِبُّ رَصيفي فوقَ حَبِّ الورَى طُرَّا",78,"ر",2,1],["أنا درة البحر المحي","ط بما يحيط من المياه",79,"ا",2,0],["إن إدغام أحرف الكون فيه","لسكون بها هو الإنعام",80,"م",1,0],["أنا دائما يا نور كل مليحِ","بين الكناية فيك والتصريحِ",81,"ح",1,1],["أناديه إذ ادعوه يا نور مقلتي","ويا بهجتي إني بحبك موثق",82,"ق",1,0],["إِن ادع مسكيناً فَلَستُ بمنكر","وهل ينكرنّ 