tabudhabi.ae/diwan/poem/95354","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95318","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86369","الخفيف"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203266","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90861","الرمل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93747","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83532","السريع"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115315","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133145",""],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83195","الرجز"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99110","السريع"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113822","البسيط"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204270","الطويل"],[5147,"روح النفس فهي ضيف بمغناك","https://www.poetsgate.com/ViewPoem.aspx?id=166733",""],[5183,"الهمة الوثابة","https://www.poetsgate.com/ViewPoem.aspx?id=185637",""],[5186,"أبدا تعن عليكم الأرباح","https://www.poetsgate.com/ViewPoem.aspx?id=156526",""],[5213,"صل معنى يشكو اليك الصدودا","https://www.poetsgate.com/ViewPoem.aspx?id=170439",""],[4045,"أأحزنك الأولى ردّوا","https://www.poetsgate.com/ViewPoem.aspx?id=200274",""],[5277,"غزلُ الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=187523",""],[5353,"مخاض من الغيظ","https://www.poetsgate.com/ViewPoem.aspx?id=214898",""],[5367,"شُهود","https://www.poetsgate.com/ViewPoem.aspx?id=197191",""],[5431,"إنَّ الحب فردوسٌ وروحي بابها التاسع","https://www.poetsgate.com/ViewPoem.aspx?id=185122",""],[709,"خطبتَ المجدَ بالأسلِ العوالي","https://www.poetsgate.com/ViewPoem.aspx?id=2924",""],[5461,"يا سحايب سراة ابها","https://www.poetsgate.com/ViewPoem.aspx?id=8548",""],[5533,"جَفانِي النَّوْم","https://www.poetsgate.com/ViewPoem.aspx?id=176665",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[6031,"أكفُّ البَرَايَا مِنْ تُرَاثِهِمُ صُفْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=46279",""],[161,"شهادة ميلاد هبة الرحمانِ","https://www.poetsgate.com/ViewPoem.aspx?id=166671",""],[4442,"لم يمت من يعيش في جناته","https://www.poetsgate.com/ViewPoem.aspx?id=171233",""],[463,"أفاقَ بها منْ طولِ سكرته الدَّهرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60097&r=&rc=153",""],[6259,"فؤادي الفداءُ لها من قببْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59354&r=&rc=2",""]],"verses":[["وَأَرعى المُنى دونَ أَن أَستَشير","قَناً خالِقاً وَظُبىً فارِيَه",0,"ي",2,0],["وَاِرعَ لِغَرسٍ أَنتَ أَنهَضتَهُ","لَولاكَ ما قارَبَ أَن يَنهَضا",1,"ض",2,0],["وَأَرعِ مَقالي مِنكَ أُذناً سَميعَةً","لَها بِلِقاءِ السائِلينَ عَوائِدُ",2,"د",1,0],["وَأَرعَنَ دَمّاغِ الرُبى في مَجَرِّهِ","يُطَبِّقُ عَرضَ البيدِ ذاتِ المَناكِبِ",3,"ب",1,0],["وَأَرعَيتُهُ سَمعي ليَحسَبَ أَنَّني","سَريعٌ إِلى الأَمرِ الَّذي هُوَ طالِبُهْ",4,"ب",2,0],["وَأُرْعِيها مَسامِعَ لَمْ يُمِلْها","إِلى نَغَماتِها إِلَّا الرَّنينُ",5,"ن",1,0],["وَأَرْعَى نُجومَ اللَّيْلِ وَالعَيْنُ ثَرَّةٌ","تُرَاقِبُها مَطْروفَةً بِسُهادِها",6,"د",3,0],["وأَرْعِ عِتاباً تَحْتَهُ الوُدُّ كامِنٌ","مَسامِعَ يَمْلأَْ الثّناءَ المُنَخَّلا",7,"ل",2,0],["وأرْعِفْ شَباةَ الرُّمحِ فالنّصْرُ حائِمٌ","عليكَ إذا ما الطّعْنُ بالدَّمِ أوْزَغا",8,"غ",2,0],["وَأَرْعَيْتُهُ مِنْ حُسْنِ عَهْدِي جَمِيمَهُ","فَأَجْدَبَ آمَالِي وَأَوْحَشَ أَزْمَانِي",9,"ن",2,0],["وَارْعَ السَّوَابِقَ لاَ تُضِعْهَا إِنَّهَا","دَيْنٌ يُلاَمُ لأَجْلِهِ مَنْ يَمْطُلُ",10,"ل",1,0],["وَارْعَ المُحَصَّنَةَ الَّتِي بَرَّتْ بِهِ","بِرَّ الشَّرِيكِ المُسْعِفِ المِعْوَانِ",11,"ن",1,0],["وَارْعَهُ وَارْعَهَا وَيَسِّرْ لَهُ الأمْ","رَ وَيَسِّرْ لَهَا وَدَامَتْ وَدَامَا",12,"م",2,0],["وَأَرعَ سَرحَ اللَهوِ مُغتَدِياً","غَيرَ مُستَبِطٍ وَلا سَئِمِ",13,"م",1,0],["وَأَرعاهُمُ بِالغَيبِ مِن أَجلِ حُبِّها","وَأوليهِمُ مِنّي الكَرامَةَ وَالبَذلا",14,"ل",2,0],["وارعَ لي حُرمةَ المودَّةِ والخد","مةِ والمدحِ تُعْجِبِ الكرماءَ",15,"ا",2,0],["وأرع الصداقة لا تَمِيل بعهودها","بعد الصديق ولا تضع أشياءها",16,"ا",3,0],["وَاِرعَ مِصراً وَلَم تَزَل خَيرَ راعٍ","فَلَها بِالَّذي أَرَتكَ زِمامُ",17,"م",1,0],["وأرعنُ بحرٍ لو جرى البحرُ فوقَهُ","لما نضخَ الغبراءَ من مائِه كُوبُ",18,"ب",1,0],["وَأَرعَنَ جَرّارٍ إِذا ما تَطَلَّقَت","كَتائِبُهُ خَرَّت لَهُ الجِنُّ سُجَّدا",19,"د",2,1],["وَاِرعَ الجِوارَ لِأَهلِهِ مُتَبَرِّعاً","بِقَضاءِ ما طَلَبوا مِنَ الحاجاتِ",20,"ت",1,0],["وَاِرعَب قُلوبَ العِدى تُنصَر بِخَذلِهِمُ","إِنَّ النَبِيَّ بِفَضلِ الرُعبِ قَد نُصِرا",21,"ر",2,0],["وَارْعَ لِي حَقَّ وِدَادٍ","فِيكَ لَمْ أَقْطَعْ حِبَالَهْ",22,"ل",2,0],["وَأَرعَنَ طَمّاحِ الذُؤابَةِ باذِخٍ","يُطاوِلُ أَعنانَ السَماءِ بِغارِبِ",23,"ب",1,0],["وَاِرعَوى باطِلي وَبَرَّ حَديثُ ال","نَفسِ مِنّي وَعَفَّتِ الأَحلامُ",24,"م",1,0],["وأرعَيْتُها سَمْعي وقد راعَني لها","صَهِيلُ المَذاكي قبلَ قَرقرةِ النَّعَم",25,"م",1,0],["وأرْعَنَ يحْمُوم كأنّ أديمَهُ","إذا شُرِعَتْ أرماحُهُ ظَهرُ شَيهَم",26,"م",1,0],["وَاِرعَي وِدادي غائِباً","فَلَقَد رَعَيتُكِ في المَغيب",27,"ب",1,0],["وَأَرعَنَ يَغشى الشَمسَ لَونُ حَديدِهِ","وَتَخلِسُ أَبصارَ الكُماةِ كَتائِبُه",28,"ب",2,0],["وأُرْعِدَتِ القنا زَمَعاً وخَوْفاً","لذلك والمُهنّدَةُ الحِدادُ",29,"د",1,0],["وأَرْعَى الأَمَانَةَ فِيمَنْ رَعَى","ومَنْ لاَ َتِجدْهُ أَمِيناً يَخُنْ",30,"ن",1,0],["وارعَ في الدنيا طريداً شارداً","عنه ضاقتْ رقعةُ الأرض اتساعا",31,"ع",2,0],["وَارْعَ ما حَوَتْ","هَذِهِ الْمُلَحْ",32,"ح",1,0],["وَارْعَيْ أَبَاهُمَا فَمَا أَحْوَجَهُ","إلى الَّتي رَعَتْهُ مِنْ عَهْدِ الصِّبَا",33,"ب",2,0],["وارع الشباب وصن كريم عهودهم","فهم لصفحة مجدك العنوان",34,"ن",1,0],["وأرْعَيْتِني شَرَّ المراعي وبِيلةً","وأوْرَدْتِني مُسْتَوَبآتِ الشَّرائع",35,"ع",1,0],["وأرعَبْنَ أطيافي وشَرَدْنَ طائفاً","مِن النوم يَسري في العيون الهواجع",35,"ع",1,0],["وارع حقا للآدميين طرا","الزمتنا بذلك الاحكام",36,"م",1,0],["وارع الذمام لكل خل صادق","ودع الكذوب بغيه وضلاله",37,"ل",2,0],["وارْعَ مَن راعَاك في كلِّ الوَرَى","واقبلِ المعروفَ منه إنْ قَبِلْ",38,"ل",1,0],["وارْعَ عشبَ الخيراتِ من ثمر الرا","حة واشكُر لفضل رب شكورِ",39,"ر",1,0],["وَأَرعَنَ مَوّارِ الحَواشي لِأَرضِهِ","بِعِثيَرِهِ مِن ناظِرِ الجَوِّ حاجِبُ",40,"ب",1,0],["وأرعبت صيحةُ الجاووش أَفئدة","منهم وقد راعها ما راع إذ دخلوا",41,"ل",3,0],["وَأَرعَنَ ظَلَّ يَنفُضُ مِذرَوَيهِ","وَيُبرِقُ لي وَيُرعِدُ بِاللسانِ",42,"ن",1,0],["وارعدُ وَهناً كالجناح تهزُّهُ","حمامتهُ في عطفها مذ تحطما",43,"م",2,0],["وَارْعَ ذَا الْقَلْبَ وَالْمُحَرَّفَ مِنْهَا","وَاقْفُ مَنْ قَالَ فَالْمُفَسِّرُ قَائِلْ",44,"ل",1,0],["وأرعى جبيناً من زنابقِ غيضةٍ","ونحراً عليه من بياضِ حليب",45,"ب",1,0],["وارعي بنيكِ وصوني إرثَهم أبداً","فالدهرُ قد أَكلبَ الإفرنج إكلابا",46,"ب",2,0],["وارع الكَريم اذا ضاق الخناق به","ما خابَ من أَنتَ في الدارين ملزمه",47,"م",2,0],["وأرعها في جنان","دانيات جَناها",48,"ا",3,0],["وَأَرعى الرَعِيَّةَ عَدلاً إِلى ال","دُعاءِ لَهُ كُلَّ وَقتٍ دَعاها",49,"ا",3,0],["واِرعَ صلاحَ حالِهم","واِشفق على إِمحالِهم",50,"م",1,0],["وارع الزمام لجيرة حلوا به","وانشد فؤاداً ضاع في ذاك الفنا",51,"ن",2,0],["وَارع روعكَ ما اِستكفاك مضطلعاً","ومثلُ روعك راعٍ غير مجهودِ",52,"د",1,0],["وَاِرعَ لها الروع المريع جنابه","لِتتلو حمداً يَملأ السمع والقلبا",53,"ب",2,0],["وأرْعِ فدْتكَ النّفسُ سمعَك مَرّةً","لنُسمِعَك الشّكْوى الّتي بَلغتْ منّا",54,"ن",2,0],["وَأَرعى صُحُفَ اللَيلِ","لَها مِن شُهبِها نَقطُ",55,"ط",1,0],["وارْعَها فهْي كالمُوَصّاةِ للحس","ناءِ تَرضَى منك الكَفاءةَ مَهرا",56,"ر",2,0],["وارْعَ ما بيننا منَ الأدبِ المُدْ","ني وإنّ كنتَ أنت أعلى وأَهْدى",57,"د",2,0],["وأرْعاك سلطانُ الورى أمْرَ مُلْكه","فناصَحْتَهُ والنُّصْحُ سِلْكَ المَناقب",58,"ب",1,0],["وأرعى له عهد الوداد محافظاً","عليه ولو سُلَّت عليّ القواضب",59,"ب",1,0],["وأَرعِ سَمعَكَ أمثالاً أُفَصِّلُها","كما يُفَصَّلُ يَاقوتٌ ومَرْجانُ",60,"ن",1,0],["وأرعى ذِمامَكَ ما دمتْ حَيَاً","ولا أستحيلُ ولا أنتَفي",61,"ف",2,0],["وَأَرعَن أَخرٍ من كَثرَةِ اللُ","غاتِ بِأرجائِهِ وَاللَجَب",62,"ب",1,0],["وأَرعى نجوم اللَّيل وهي طوالع","إلى حين تلقى الغرب وهي أفول",63,"ل",1,0],["وأرعفوها من دماءٍ دناً","تمرد بالطعن عيون الجراح",64,"ح",1,0],["وأرْعدي من غضَبٍ","عليَّ أو فأبْرِقي",65,"ق",2,0],["وأَرْعَيْتُ سعدانَ سَعْدِ السُّعُودِ","نِواءَ المُنى وصَفايا الصَّفاءِ",66,"ا",2,0],["وأَرعشها حنين الشول حتى","بقائم مخذمي التوتا يداها",67,"ا",3,0],["وأرعَى ساهرا منهم","عيونا ليس يرعَيْنا",68,"ن",2,0],["وأرعيتها الإمهال علماً بأنها","إليك وإن طال التنازعُ تضطرُّ",69,"ر",1,0],["وأرْعَن خفَّاق البنود مُزمْجرٍ","تضيق به بيداؤه حين يغْتدي",70,"د",2,0],["وَاِرعَ مِن شَيبِكَ ضَيفاً","ما لَهُ مِنكَ مُراعِ",71,"ع",1,0],["وارع الأمومة فيمن كنت مجهدها","حملا ووضعا وإرضاعا وأنت صبي",72,"ب",2,0],["وارْعَ بنيَّ العهدَ لا تهمِلْ له","أَمراً فحكْمُ العهدِ ديناً يُبْتَغَى",73,"ا",1,0],["واِرْعوا الجوارِحَ أن تصيّدَها المَها","فمنَ العُيونِ لها شِراكٌ تُنصَبُ",74,"ب",1,0],["وأرْعَشْتَ القَنا حتّى ظننّا","نفَحْتَ بهنّ أرواحَ الصِلالِ",75,"ل",1,0],["وَأَرْعَى الكَواكِبَ أَنَّى سَرَيْنَ","وَأَرْقبُ بَدْرَ الدُّجى حَيْثُ سَارا",76,"ر",2,0],["وأرعى حق من يرعى حقوقي","وأغضي عن جنايته احتشاما",77,"م",2,0],["وَأَرعَنَ قَد جَرَرتَ إِلى عَدُوٍّ","يُزَيِّنُهُ التَأَوُّهُ وَالصَهيلُ",78,"ل",1,0],["وَاِرعَ الحَنيفِيَّةَ البَيضاءَ مُعتَصِماً","بِالحَقِّ وَاللَهُ بِالتَوفيقِ مَسلولُ",79,"ل",1,0],["وأرعى عهدَ حُبك كلَّ عمري","وأَبقى في الضريح على ولاكا",80,"ك",2,0],["وارع العهود لهم غابوا وإن حضروا","شط المزار بهم أو كان مقتربا",81,"ب",2,0],["وأرعى لهم منه القديم الذي مضى","ومر سريعاً رعي قدحِ ابن مقبل",82,"ل",1,0],["وأرعى لمن عندي أياديه حقه","ومن جاهه جاهي وفي عزمه عزمي",83,"م",2,0],["وارع الألى ملأوا البلاد تقاضياً","فعسى يفي لهمُ الغريم الماطل",84,"ل",1,0],["وارع شعباً طائعاً مستسلماً","حبه فيك تجلى للعيان",85,"ن",1,0],["وأرعى وداداً ليس يرعون بعضه","وأحمل جوراً في ولاهم وأعدل",86,"ل",1,0],["وارعى له حسن اعتقادي جدوده","وللدين فوقى والولاء رواق",87,"ق",1,0],["وَاِرعَ الصديقَ بودٍّ ليسَ يفسدهُ","ما يُفسدُ الودَّ مِن قالٍ ومن شانِ",88,"ن",1,0],["وارع عينيك في عيون من الد","هر حلاها نور كنور الأقاح",89,"ح",1,0],["وارع المودة مع بنيك لانه","هو من بنيك بلسالف الازمان",90,"ن",1,0],["وَأَرْعَنَ كَالْبَحْرِ الْخِضَمِّ تَخُوضُهُ","سَفَائِنُ لَكِنْ مِنْ مُضَمَّرَةٍ جُرْدِ",91,"د",1,0],["وَأَرْعَفَ أَنْفَ الصُّبْحِ كَثْرَةُ شَمِّهِ","لِمِسْكِ الدُّجَى حَتَّى رَمَى الْمِسْكَ مِنْ يَدِ",92,"د",1,0],["وارعوى الملحدون وانقاد كل","بعد ما كان صاحب الإلحاد",93,"د",1,0],["وأَرعى بطرفي هلالَ العُلى","بلبنانَ والكلُّ في المرصد",94,"د",1,0],["وارعى تلادك أن يحيط به البلى","فيحول أو ينتابه التبديل",95,"ل",1,0],["وَاِرعَوى ظالِمٌ وَكَفَّ جَهولٌ","وَأَظَلَّ الوَلِيَّ ظِلٌّ ظَليلُ",96,"ل",1,0],["وأرعيهِ سَمعي كلَّما ذُكِرَ الأسى","وفي الصدرِ مِنّي لَوعةٌ ما تُزايِلُه",97,"ل",2,0],["وَاِرعَ الأَمانَةِ وَالخِيانَةِ فَاِجتَنِب","وَاِعدل وَلا تَظلِم يَطِب لَكَ مَكسَب",98,"ب",1,0],["وَاِرعَ سَعداً وَآلَ سَعدٍ وَوَفِّق","بَينَ آمالِنا وَبَينَ السَفيرِ",99,"ر",1,0],["وارعوا العهد الذي ما بيننا","واذكرونا مثل ذكرانا لكم",100,"م",1,0],["وارعَ صباً ما انثنى عن حُبّكم","قطُّ يوماً لا ولا خانَ الوفا",101,"ف",2,0],["وارعيتها من رياض الشئام","منابت حوذانها والنفل",102,"ل",1,0],["وأرعدت الأرض السماء وأبرقت","بصيّب ودق للمنية ينهمي",103,"م",2,0],["وأرعى لها أيامَ إذ هيَ جارتي","وإذ خدْرُها المضروبُ قيد عَيَاني",104,"ن",2,0],["وَأَرعى النجم أَوَّل ما تبدّى","إِلى أَن لَفّ شَملته فَغابا",105,"ب",2,0],["وارع العهود لها فانك خير من","يرعى العهود وينجز الموعودا",106,"د",2,0],["وارعُوا العهد فالوفاء كفيل","بعلا مصر وهو نعم الامام",107,"م",1,0],["وارع الفضيلة والتقى","فالعيش عيش الآخره",108,"ر",2,0],["وارع السطور التي قالت تؤرخها","يدوم طبع به شمس الطروس بدت",109,"ت",1,0],["وأرعدَتِ الكوساتُ والبيضُ في الطلى","بَوارقَ لَمْ تُبرقْ منَ الدّم خُلبا",110,"ب",2,0],["وارعَوا فضائِلَ في آبائِكُم قَدُمَت","فالفضلُ فِي الخَلقِ لا يُزرِي بِهِ القدَمُ",111,"م",1,0],["وارعَ الإِمَامَةَ والرَّعيَّةَ مشفِقاً","بسياسَةٍ وَرَوِيَّةٍ وتعَهُّدِ",112,"د",1,0],["وَاِرعَ قَوماً هُم إِلَينا أَحسَنوا","أَمَدَ الدَهرِ وَمَن يَجهَلُنا",113,"ن",2,0],["وارعى نجوم الليل شوقا الأوجه","تطلعن في ليل الذوائب انجما",114,"م",2,1],["وارع الخواطر واعرف حكمها بفتى","قد خاض اودية العرفان والحكم",115,"م",1,0],["وارعي صلاح الدين في أحفاده","لصنيعه المأثور في الأخيار",116,"ر",1,0],["وارعوا لجار البيت ما قد رعى","قبلكم ذاك بنو عمرو",117,"ر",2,0],["وَأَرعى الجَميل وإِن لم يَكُن","عَلى سالف الدهرِ يرعانيَه",118,"ي",2,0],["وأَرعف بِالتَحبير شمّ أُنوفَها","بِمسك عَلى كافور طرس مُجَسَد",119,"د",1,0],["وارع الكفاف ولا تجاوز حده","ما بعده يجنى عليك هموما",120,"م",2,0],["وَارع الوفاء عَلى الجَفاء فكم رَعى","جفني الكَواكب بعد فقد مساعدي",121,"د",2,0],["وَارع العُهود وَإِن يَكُن","غَدَرَ الوَفا وَالخلُّ خان",122,"ن",1,0],["وارعف سيف نقمته إلى أن","تبوأ من ذرى المجد السناما",123,"م",2,0],["وارعوا الذمام فقد أضحت بلادكم","كناظر من قذى الاغيار مرمود",124,"د",1,0],["وَأَرعَدُ مُهجَتي مِن بَرقِ ثَغرِ","بِهِ سَحبُ اللَواحِظِ في هُطولِ",125,"ل",1,0],["وارع صلاح حالهم","واشفق على محالهم",126,"م",1,0],["وارع الرعية ما وليت أمورها","بإقامة العدل السنوي الأمثل",127,"ل",1,0],["وَارعَ رُوَيداً لا تَسُمنا دَنِيَّةً","لَعَلَّكَ في غِبِّ الحَوادِثِ نادِمُ",128,"م",1,0],["وارعي عهود متيم","فالحبّ رونقه الوفا",129,"ا",1,0],["وأرْعَفْنا القنَا الخَطّي نجْعاً","وارْهبنا المخاِترَ والمُعادى",130,"د",2,0],["وأَرعني سمعك معناه استمع","والكلب قد أَشليته حتى رجع",131,"ع",1,0],["وَأَرعن موَّارٍ ألمَّ بمورِها","فَلم يغنِ فيها جَرُّ مجرٍ وتكتيبُ",132,"ب",1,0],["وارع لي ذمة لديك وعهدا","يوم تنسى العهود أو تتناسى",133,"س",2,0],["وارع النظير من القوم الأولى سلفوا","من الشباب ومن طفل ومن هرم",134,"م",1,0],["وارع بالأملاك وانصره وصن","ملكه من كل شيطان رحيم",135,"م",1,0],["وَأَرعن لم تحمد لديهِ محاسن","وَأَخرق لم تذمم لديهِ عُيوب",136,"ب",1,0],["وَاِرعَ لوجهِ اللَه آمالَهُ","من كُلّ وجهٍ لا تُجِبهُ بلا",137,"ل",2,0],["وأرعنَ فيهِ للسوابغ جُنَّةٌ","وسَقفَ سَماءٍ أنشأتهُ الحَوافرُ",138,"ر",1,0],["وارعه احفظه وارحم ذله واغترابه","وانفراده بحالٍ في البلد واكتسابه",139,"ب",2,0],["وَارعَ لَهُ الودادَ في الرَخاءِ","كَما رَعى وُدّك في البَأساءِ",140,"ا",2,0],["وارع رياض العز في غبطةٍ","واسكن مدى الأيام ظلَّ التهاني",141,"ن",2,0],["وأرع الجوار ولا تنس الجميل ولو","طال المدى واخش من أعداك عن كمل",142,"ل",1,0],["وأرعن من سكر الحداثة ما صحا","دفعنا إلى تعظيمه وهو ما التحى",143,"ح",2,1],["وارعها صاغراً لديها وضمها","مقاماً ووفها تبجيلا",144,"ل",2,0],["وارع حق الله فيمن سنته","راجياً ما عنده محتسبا",145,"ب",2,0],["وارعوا مهاجركم وداروا أهلها","فالصبر أجر والثبات سماح",146,"ح",1,0],["وارع عهداً لذي غرام محب","لم يزل يا رعيت يرعى العهودا",147,"د",2,0],["وأر عن ذي كتائب بال","فضاء غذاءه المهج",148,"ج",1,0],["وأرعدتْ حسرتي والبرقُ يخطِفُها","من ناظريَّ..وصَبَّ الخوفُ رعدتَهُ",149,"ت",2,0],["وأرعدَ كالبرقِ لمَّا همى","وألوى على الغيظِ كلَّ الهِمَمْ",150,"م",1,0],["وارْعَ النّوافلَ بَعدَ فَرْضِكَ قُرْبةً","للهِ وانْأَ عن الحرامِ مُفارقا",151,"ق",2,0],["وأرعى حبي الغالي","وألثم قلبه الواسعْ",152,"ع",1,0],["وَاَرْعَشْتَ الْقَنَا حَتَّى ظَنَنَّا","نَفَخْتَ بِهِنَّ اَرْوَاحَ الصِلاَلِ",153,"ل",1,0],["وارعدي يا سحابه فوق هاك التلال","صوري له حنيني عقب طول البعاد",154,"د",1,0],["وأَرْعَى في اللَّيَالِي ضَوْءَ نَجْمٍ","وطَيْفُ حَبِيْبَتِي صَدْرٌ رَحِيْبُ",155,"ب",1,0],["وأرعن سد الأفق عثر خيوله","حشاه عنا جيجا وزرق الأسنةِ",156,"ه",1,0],["وأُرعِشَتِ المُلْدُ المثقّفةُ السُّمرُ","وأقبلتِ الخَيْلُ المُسَوَّمَةُ الشُّقْرُ",157,"ر",1,0],["19- وارْعَيْ رِيَاضَ مَكَارِمِ الأخْلَاقِ فِي","سِيَرِ الأَوَائِلِ مَأْمَنُ الإحْسَانِ",158,"ن",1,0],["وارع ذاكراه بعد حول وأرخ","(طاهر) النفس عاش في جناته",159,"ت",2,0],["وأرعيتها الإهمالَ علماً بأنَّها","إليكَ وإنْ طالَ التَّنازعُ تضطرُّ",160,"ر",1,0],["وأرعن أخرسَ من كثرة ال","لغاتِ بأرجائه واللجب",161,"ب",1,0]]}