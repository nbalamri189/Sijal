{"poems":[[55,"أأنكر والمجد عنوانيه","https://www.aldiwan.net/poem29619.html","المتقارب"],[55,"كيف أضاء البرق إذ أومضا","https://www.aldiwan.net/poem30175.html","السريع"],[55,"أعاتب أيامي وما الذئب واحد","https://www.aldiwan.net/poem30632.html","الطويل"],[55,"ألا حيها رب العلى من غوارب","https://www.aldiwan.net/poem30755.html","الطويل"],[65,"أدار بأكناف الحمى جادها الحيا","https://www.aldiwan.net/poem45799.html","الطويل"],[65,"وحماء العلاط إذا تغنت","https://www.aldiwan.net/poem46074.html","الوافر"],[65,"وساجية الألحاظ تفتر إن رنت","https://www.aldiwan.net/poem46087.html","الطويل"],[65,"تجنى علينا طيفها حين أرسلا","https://www.aldiwan.net/poem46150.html","السريع"],[65,"طلبنا النوال الغمر والخير يبتغى","https://www.aldiwan.net/poem46193.html","الطويل"],[79,"بنفسي وما نفسي علي بهينة","https://www.aldiwan.net/poem36063.html","الطويل"],[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[95,"باعوا المخلد بالحطام الفاني","https://www.aldiwan.net/poem11248.html","الكامل"],[95,"أيها البالغ الثريا مقاماً","https://www.aldiwan.net/poem11412.html","الخفيف"],[56,"عاذلي لو شئت لم تلم","https://www.aldiwan.net/poem27479.html","المديد"],[29,"عشية أعلى مذنب الجوف قادني","https://www.aldiwan.net/poem5953.html","الطويل"],[53,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[87,"هو مأتم الأخلاق فاتل رثاءها","https://www.aldiwan.net/poem7109.html","الكامل"],[87,"رضي المسلمون والإسلام","https://www.aldiwan.net/poem63740.html","الخفيف"],[64,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[30,"وأرعن جرار إذا ما تطلقت","https://www.aldiwan.net/poem5004.html","الطويل"],[51,"أشرب فؤادك بغضة اللذات","https://www.aldiwan.net/poem10396.html","الكامل"],[68,"لا يمتطي المجد من لم يركب الخطرا","https://www.aldiwan.net/poem41548.html","البسيط"],[89,"أهلال بين هاله","https://www.aldiwan.net/poem8365.html","مجزوء الرمل"],[76,"بعيشك هل تدري أهوج الجنائب","https://www.aldiwan.net/poem12863.html","الطويل"],[54,"أخذت من شبابي الأيام","https://www.aldiwan.net/poem26679.html","الخفيف"],[77,"نظرت كما جلت عقاب على إرم","https://www.aldiwan.net/poem69035.html","الطويل"],[77,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[52,"يا عبد حي عن قريب","https://www.aldiwan.net/poem64759.html","مجزوء الكامل"],[52,"جفا وده فازور أو مل صاحبه","https://www.aldiwan.net/poem64818.html","الطويل"],[48,"أفوق البدر يوضع لي مهاد","https://www.aldiwan.net/poem23638.html","الوافر"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62240","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39540","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42554","المتدارك"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54635","الرجز"],[92,"العلم والوطنية","https://www.poetsgate.com/ViewPoem.aspx?id=178949",""],[92,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[119,"ما كفى الصد والغريم الغرام","https://www.aldiwan.net/poem40594.html","عموديه"],[119,"جانب زمانك ان اردت وواله","https://www.aldiwan.net/poem40616.html","عموديه"],[132,"شمر الذيل وبادر للعمل","https://www.aldiwan.net/poem50540.html","الرمل"],[132,"خذ نصيبين من صفاء السرور","https://www.aldiwan.net/poem50603.html","الطويل"],[147,"بسعدك دارت في السماء الكواكب","https://www.aldiwan.net/poem11734.html","الطويل"],[164,"عيد حظى بك والأعياد تقتتل","https://www.aldiwan.net/poem58929.html","البسيط"],[173,"على م وفي م ظلماً تلحياني","https://www.aldiwan.net/poem1688.html",""],[203,"من الصدع في قلبي غداة تهدما","https://www.aldiwan.net/poem45161.html","الطويل"],[241,"ما أخو خمسة جلته لعاقل","https://www.aldiwan.net/poem19067.html","الخفيف"],[274,"تصبته ريحا شمأل وجنوب","https://www.aldiwan.net/poem35639.html","الطويل"],[274,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[275,"خل الغرام لصب دمعه دمه","https://www.aldiwan.net/poem52119.html","البسيط"],[275,"من لنفس ثناها","https://www.aldiwan.net/poem52122.html","مجزوء الرمل"],[286,"دعا مهجة الصب لا تردعاها","https://www.aldiwan.net/poem32310.html","المتقارب"],[301,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[308,"يا راحلاً إن جئت وادي المنحنى","https://www.aldiwan.net/poem16793.html","الكامل"],[309,"أحيا قدومك مرعى الجود والجود","https://www.aldiwan.net/poem56574.html","البسيط"],[309,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[368,"دع العين مني تسكب الدمع أو تفنى","https://www.aldiwan.net/poem60624.html","الطويل"],[368,"بدا في فرعك الوخط","https://www.aldiwan.net/poem60858.html","الهزج"],[368,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[368,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[368,"لها في حمى مني وراء الترائب","https://www.aldiwan.net/poem60994.html","الطويل"],[373,"بنفسي من أغلقت كفي بحبله","https://www.aldiwan.net/poem4316.html","الطويل"],[409,"زيادة المرء في دنياه نقصان","https://www.aldiwan.net/poem49713.html","البسيط"],[409,"فديتك عز الصديق الصدوق","https://www.aldiwan.net/poem49846.html","المتقارب"],[410,"فؤادي الفداء لها من قبب","https://www.aldiwan.net/poem50210.html","المتقارب"],[420,"خليلي هل لي بعد أسنمة النقا","https://www.aldiwan.net/poem53952.html","الطويل"],[420,"نبهت الورقاء ذات الجناح","https://www.aldiwan.net/poem54157.html","الطويل"],[436,"يا هذه لا تنطقي","https://www.aldiwan.net/poem12812.html","مجزوء الرجز"],[443,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[445,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[461,"تعالين نعالج نفرة","https://www.aldiwan.net/poem55850.html","الهزج"],[461,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[464,"أأهجع أم آوي إلى لين مرقد","https://www.aldiwan.net/poem15111.html","الطويل"],[471,"يا كثير الإنخلاع","https://www.aldiwan.net/poem59886.html","مجزوء الرمل"],[482,"خذ من أبيك وصايا يا سمي أبي","https://www.aldiwan.net/poem36945.html","البسيط"],[503,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[517,"ميلوا بنا نحو الحجون ونكبوا","https://www.aldiwan.net/poem20800.html","الكامل"],[517,"خطبت المجد بالأسل العوالي","https://www.aldiwan.net/poem20820.html","الوافر"],[589,"أقلب قلبي شوقا إليه","https://www.aldiwan.net/poem17993.html","المتقارب"],[590,"ألا يا راكباً قف لي فواقا","https://www.aldiwan.net/poem11557.html","عموديه"],[999,"","https://poetry.dctabudhabi.ae/diwan/poem/202295","السريع"]],"verses":[["وَأَرعى المُنى دونَ أَن أَستَشير","قَناً خالِقاً وَظُبىً فارِيَه",0,"ي",2,0],["وَاِرعَ لِغَرسٍ أَنتَ أَنهَضتَهُ","لَولاكَ ما قارَبَ أَن يَنهَضا",1,"ض",2,0],["وَأَرعِ مَقالي مِنكَ أُذناً سَميعَةً","لَها بِلِقاءِ السائِلينَ عَوائِدُ",2,"د",1,0],["وَأَرعَنَ دَمّاغِ الرُبى في مَجَرِّهِ","يُطَبِّقُ عَرضَ البيدِ ذاتِ المَناكِبِ",3,"ب",1,0],["وَأَرعَيتُهُ سَمعي ليَحسَبَ أَنَّني","سَريعٌ إِلى الأَمرِ الَّذي هُوَ طالِبُهْ",4,"ب",2,0],["وَأُرْعِيها مَسامِعَ لَمْ يُمِلْها","إِلى نَغَماتِها إِلَّا الرَّنينُ",5,"ن",1,0],["وَأَرْعَى نُجومَ اللَّيْلِ وَالعَيْنُ ثَرَّةٌ","تُرَاقِبُها مَطْروفَةً بِسُهادِها",6,"د",3,0],["وأَرْعِ عِتاباً تَحْتَهُ الوُدُّ كامِنٌ","مَسامِعَ يَمْلأَْ الثّناءَ المُنَخَّلا",7,"ل",2,0],["وأرْعِفْ شَباةَ الرُّمحِ فالنّصْرُ حائِمٌ","عليكَ إذا ما الطّعْنُ بالدَّمِ أوْزَغا",8,"غ",2,0],["وَأَرْعَيْتُهُ مِنْ حُسْنِ عَهْدِي جَمِيمَهُ","فَأَجْدَبَ آمَالِي وَأَوْحَشَ أَزْمَانِي",9,"ن",2,0],["وَارْعَ السَّوَابِقَ لاَ تُضِعْهَا إِنَّهَا","دَيْنٌ يُلاَمُ لأَجْلِهِ مَنْ يَمْطُلُ",10,"ل",1,0],["وَارْعَ المُحَصَّنَةَ الَّتِي بَرَّتْ بِهِ","بِرَّ الشَّرِيكِ المُسْعِفِ المِعْوَانِ",11,"ن",1,0],["وَارْعَهُ وَارْعَهَا وَيَسِّرْ لَهُ الأمْ","رَ وَيَسِّرْ لَهَا وَدَامَتْ وَدَامَا",12,"م",2,0],["وَأَرعَ سَرحَ اللَهوِ مُغتَدِياً","غَيرَ مُستَبِطٍ وَلا سَئِمِ",13,"م",1,0],["وَأَرعاهُمُ بِالغَيبِ مِن أَجلِ حُبِّها","وَأوليهِمُ مِنّي الكَرامَةَ وَالبَذلا",14,"ل",2,0],["وارعَ لي حُرمةَ المودَّةِ والخد","مةِ والمدحِ تُعْجِبِ الكرماءَ",15,"ا",2,0],["وأرع الصداقة لا تَمِيل بعهودها","بعد الصديق ولا تضع أشياءها",16,"ا",3,0],["وَاِرعَ مِصراً وَلَم تَزَل خَيرَ راعٍ","فَلَها بِالَّذي أَرَتكَ زِمامُ",17,"م",1,0],["وأرعنُ بحرٍ لو جرى البحرُ فوقَهُ","لما نضخَ الغبراءَ من مائِه كُوبُ",18,"ب",1,0],["وَأَرعَنَ جَرّارٍ إِذا ما تَطَلَّقَت","كَتائِبُهُ خَرَّت لَهُ الجِنُّ سُجَّدا",19,"د",2,1],["وَاِرعَ الجِوارَ لِأَهلِهِ مُتَبَرِّعاً","بِقَضاءِ ما طَلَبوا مِنَ الحاجاتِ",20,"ت",1,0],["وَاِرعَب قُلوبَ العِدى تُنصَر بِخَذلِهِمُ","إِنَّ النَبِيَّ بِفَضلِ الرُعبِ قَد نُصِرا",21,"ر",2,0],["وَارْعَ لِي حَقَّ وِدَادٍ","فِيكَ لَمْ أَقْطَعْ حِبَالَهْ",22,"ل",2,0],["وَأَرعَنَ طَمّاحِ الذُؤابَةِ باذِخٍ","يُطاوِلُ أَعنانَ السَماءِ بِغارِبِ",23,"ب",1,0],["وَاِرعَوى باطِلي وَبَرَّ حَديثُ ال","نَفسِ مِنّي وَعَفَّتِ الأَحلامُ",24,"م",1,0],["وأرعَيْتُها سَمْعي وقد راعَني لها","صَهِيلُ المَذاكي قبلَ قَرقرةِ النَّعَم",25,"م",1,0],["وأرْعَنَ يحْمُوم كأنّ أديمَهُ","إذا شُرِعَتْ أرماحُهُ ظَهرُ شَيهَم",26,"م",1,0],["وَاِرعَي وِدادي غائِباً","فَلَقَد رَعَيتُكِ في المَغيب",27,"ب",1,0],["وَأَرعَنَ يَغشى الشَمسَ لَونُ حَديدِهِ","وَتَخلِسُ أَبصارَ الكُماةِ كَتائِبُه",28,"ب",2,0],["وأُرْعِدَتِ القنا زَمَعاً وخَوْفاً","لذلك والمُهنّدَةُ الحِدادُ",29,"د",1,0],["وأَرْعَى الأَمَانَةَ فِيمَنْ رَعَى","ومَنْ لاَ َتِجدْهُ أَمِيناً يَخُنْ",30,"ن",1,0],["وارعَ في الدنيا طريداً شارداً","عنه ضاقتْ رقعةُ الأرض اتساعا",31,"ع",2,0],["وَارْعَ ما حَوَتْ","هَذِهِ الْمُلَحْ",32,"ح",1,0],["وَارْعَيْ أَبَاهُمَا فَمَا أَحْوَجَهُ","إلى الَّتي رَعَتْهُ مِنْ عَهْدِ الصِّبَا",33,"ب",2,0],["وارع الشباب وصن كريم عهودهم","فهم لصفحة مجدك العنوان",34,"ن",1,0],["وأرْعَيْتِني شَرَّ المراعي وبِيلةً","وأوْرَدْتِني مُسْتَوَبآتِ الشَّرائع",35,"ع",1,0],["وأرعَبْنَ أطيافي وشَرَدْنَ طائفاً","مِن النوم يَسري في العيون الهواجع",35,"ع",1,0],["وارع حقا للآدميين طرا","الزمتنا بذلك الاحكام",36,"م",1,0],["وارع الذمام لكل خل صادق","ودع الكذوب بغيه وضلاله",37,"ل",2,0],["وارْعَ مَن راعَاك في كلِّ الوَرَى","واقبلِ المعروفَ منه إنْ قَبِلْ",38,"ل",1,0],["وارْعَ عشبَ الخيراتِ من ثمر الرا","حة واشكُر لفضل رب شكورِ",39,"ر",1,0],["وَأَرعَنَ مَوّارِ الحَواشي لِأَرضِهِ","بِعِثيَرِهِ مِن ناظِرِ الجَوِّ حاجِبُ",40,"ب",1,0],["وأرعبت صيحةُ الجاووش أَفئدة","منهم وقد راعها ما راع إذ دخلوا",41,"ل",3,0],["وَأَرعَنَ ظَلَّ يَنفُضُ مِذرَوَيهِ","وَيُبرِقُ لي وَيُرعِدُ بِاللسانِ",42,"ن",1,0],["وارعدُ وَهناً كالجناح تهزُّهُ","حمامتهُ في عطفها مذ تحطما",43,"م",2,0],["وَارْعَ ذَا الْقَلْبَ وَالْمُحَرَّفَ مِنْهَا","وَاقْفُ مَنْ قَالَ فَالْمُفَسِّرُ قَائِلْ",44,"ل",1,0],["وأرعى جبيناً من زنابقِ غيضةٍ","ونحراً عليه من بياضِ حليب",45,"ب",1,0],["وارعي بنيكِ وصوني إرثَهم أبداً","فالدهرُ قد أَكلبَ الإفرنج إكلابا",46,"ب",2,0],["وارع الكَريم اذا ضاق الخناق به","ما خابَ من أَنتَ في الدارين ملزمه",47,"م",2,0],["وأرعها في جنان","دانيات جَناها",48,"ا",3,0],["وَأَرعى الرَعِيَّةَ عَدلاً إِلى ال","دُعاءِ لَهُ كُلَّ وَقتٍ دَعاها",49,"ا",3,0],["واِرعَ صلاحَ حالِهم","واِشفق على إِمحالِهم",50,"م",1,0],["وارع الزمام لجيرة حلوا به","وانشد فؤاداً ضاع في ذاك الفنا",51,"ن",2,0],["وَارع روعكَ ما اِستكفاك مضطلعاً","ومثلُ روعك راعٍ غير مجهودِ",52,"د",1,0],["وَاِرعَ لها الروع المريع جنابه","لِتتلو حمداً يَملأ السمع والقلبا",53,"ب",2,0],["وأرْعِ فدْتكَ النّفسُ سمعَك مَرّةً","لنُسمِعَك الشّكْوى الّتي بَلغتْ منّا",54,"ن",2,0],["وَأَرعى صُحُفَ اللَيلِ","لَها مِن شُهبِها نَقطُ",55,"ط",1,0],["وارْعَها فهْي كالمُوَصّاةِ للحس","ناءِ تَرضَى منك الكَفاءةَ مَهرا",56,"ر",2,0],["وارْعَ ما بيننا منَ الأدبِ المُدْ","ني وإنّ كنتَ أنت أعلى وأَهْدى",57,"د",2,0],["وأرْعاك سلطانُ الورى أمْرَ مُلْكه","فناصَحْتَهُ والنُّصْحُ سِلْكَ المَناقب",58,"ب",1,0],["وأرعى له عهد الوداد محافظاً","عليه ولو سُلَّت عليّ القواضب",59,"ب",1,0],["وأَرعِ سَمعَكَ أمثالاً أُفَصِّلُها","كما يُفَصَّلُ يَاقوتٌ ومَرْجانُ",60,"ن",1,0],["وأرعى ذِمامَكَ ما دمتْ حَيَاً","ولا أستحيلُ ولا أنتَفي",61,"ف",2,0],["وَأَرعَن أَخرٍ من كَثرَةِ اللُ","غاتِ بِأرجائِهِ وَاللَجَب",62,"ب",1,0],["وأَرعى نجوم اللَّيل وهي طوالع","إلى حين تلقى الغرب وهي أفول",63,"ل",1,0],["وأرعفوها من دماءٍ دناً","تمرد بالطعن عيون الجراح",64,"ح",1,0],["وأرْعدي من غضَبٍ","عليَّ أو فأبْرِقي",65,"ق",2,0],["وأَرْعَيْتُ سعدانَ سَعْدِ السُّعُودِ","نِواءَ المُنى وصَفايا الصَّفاءِ",66,"ا",2,0],["وأَرعشها حنين الشول حتى","بقائم مخذمي التوتا يداها",67,"ا",3,0],["وأرعَى ساهرا منهم","عيونا ليس يرعَيْنا",68,"ن",2,0],["وأرعيتها الإمهال علماً بأنها","إليك وإن طال التنازعُ تضطرُّ",69,"ر",1,0],["وأرْعَن خفَّاق البنود مُزمْجرٍ","تضيق به بيداؤه حين يغْتدي",70,"د",2,0],["وَاِرعَ مِن شَيبِكَ ضَيفاً","ما لَهُ مِنكَ مُراعِ",71,"ع",1,0],["وارع الأمومة فيمن كنت مجهدها","حملا ووضعا وإرضاعا وأنت صبي",72,"ب",2,0],["وارْعَ بنيَّ العهدَ لا تهمِلْ له","أَمراً فحكْمُ العهدِ ديناً يُبْتَغَى",73,"ا",1,0],["واِرْعوا الجوارِحَ أن تصيّدَها المَها","فمنَ العُيونِ لها شِراكٌ تُنصَبُ",74,"ب",1,0],["وأرْعَشْتَ القَنا حتّى ظننّا","نفَحْتَ بهنّ أرواحَ الصِلالِ",75,"ل",1,0],["وَأَرْعَى الكَواكِبَ أَنَّى سَرَيْنَ","وَأَرْقبُ بَدْرَ الدُّجى حَيْثُ سَارا",76,"ر",2,0],["وأرعى حق من يرعى حقوقي","وأغضي عن جنايته احتشاما",77,"م",2,0],["وارعوا لجار البيت ما قد رعى","قبلكم ذاك بنو عمرو",78,"ر",2,0]]}