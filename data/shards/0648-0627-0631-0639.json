 راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[304,"يا راحلاً إن جئت وادي المنحنى","https://www.aldiwan.net/poem16793.html","الكامل"],[305,"أحيا قدومك مرعى الجود والجود","https://www.aldiwan.net/poem56574.html","البسيط"],[305,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[364,"دع العين مني تسكب الدمع أو تفنى","https://www.aldiwan.net/poem60624.html","الطويل"],[364,"بدا في فرعك الوخط","https://www.aldiwan.net/poem60858.html","الهزج"],[364,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[364,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[364,"لها في حمى مني وراء الترائب","https://www.aldiwan.net/poem60994.html","الطويل"],[369,"بنفسي من أغلقت كفي بحبله","https://www.aldiwan.net/poem4316.html","الطويل"],[405,"زيادة المرء في دنياه نقصان","https://www.aldiwan.net/poem49713.html","البسيط"],[405,"فديتك عز الصديق الصدوق","https://www.aldiwan.net/poem49846.html","المتقارب"],[406,"فؤادي الفداء لها من قبب","https://www.aldiwan.net/poem50210.html","المتقارب"],[416,"خليلي هل لي بعد أسنمة النقا","https://www.aldiwan.net/poem53952.html","الطويل"],[416,"نبهت الورقاء ذات الجناح","https://www.aldiwan.net/poem54157.html","الطويل"],[432,"يا هذه لا تنطقي","https://www.aldiwan.net/poem12812.html","مجزوء الرجز"],[439,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[441,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[458,"تعالين نعالج نفرة","https://www.aldiwan.net/poem55850.html","الهزج"],[458,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[461,"أأهجع أم آوي إلى لين مرقد","https://www.aldiwan.net/poem15111.html","الطويل"],[468,"يا كثير الإنخلاع","https://www.aldiwan.net/poem59886.html","مجزوء الرمل"],[479,"خذ من أبيك وصايا يا سمي أبي","https://www.aldiwan.net/poem36945.html","البسيط"],[500,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[514,"ميلوا بنا نحو الحجون ونكبوا","https://www.aldiwan.net/poem20800.html","الكامل"],[514,"خطبت المجد بالأسل العوالي","https://www.aldiwan.net/poem20820.html","الوافر"],[586,"أقلب قلبي شوقا إليه","https://www.aldiwan.net/poem17993.html","المتقارب"],[587,"ألا يا راكباً قف لي فواقا","https://www.aldiwan.net/poem11557.html","عموديه"]],"verses":[["وَأَرعى المُنى دونَ أَن أَستَشير","قَناً خالِقاً وَظُبىً فارِيَه",0,"ي",2,0],["وَاِرعَ لِغَرسٍ أَنتَ أَنهَضتَهُ","لَولاكَ ما قارَبَ أَن يَنهَضا",1,"ض",2,0],["وَأَرعِ مَقالي مِنكَ أُذناً سَميعَةً","لَها بِلِقاءِ السائِلينَ عَوائِدُ",2,"د",1,0],["وَأَرعَنَ دَمّاغِ الرُبى في مَجَرِّهِ","يُطَبِّقُ عَرضَ البيدِ ذاتِ المَناكِبِ",3,"ب",1,0],["وَأَرعَيتُهُ سَمعي ليَحسَبَ أَنَّني","سَريعٌ إِلى الأَمرِ الَّذي هُوَ طالِبُهْ",4,"ب",2,0],["وَأُرْعِيها مَسامِعَ لَمْ يُمِلْها","إِلى نَغَماتِها إِلَّا الرَّنينُ",5,"ن",1,0],["وَأَرْعَى نُجومَ اللَّيْلِ وَالعَيْنُ ثَرَّةٌ","تُرَاقِبُها مَطْروفَةً بِسُهادِها",6,"د",3,0],["وأَرْعِ عِتاباً تَحْتَهُ الوُدُّ كامِنٌ","مَسامِعَ يَمْلأَْ الثّناءَ المُنَخَّلا",7,"ل",2,0],["وأرْعِفْ شَباةَ الرُّمحِ فالنّصْرُ حائِمٌ","عليكَ إذا ما الطّعْنُ بالدَّمِ أوْزَغا",8,"غ",2,0],["وَأَرْعَيْتُهُ مِنْ حُسْنِ عَهْدِي جَمِيمَهُ","فَأَجْدَبَ آمَالِي وَأَوْحَشَ أَزْمَانِي",9,"ي",1,0],["وَارْعَ السَّوَابِقَ لاَ تُضِعْهَا إِنَّهَا","دَيْنٌ يُلاَمُ لأَجْلِهِ مَنْ يَمْطُلُ",10,"ل",1,0],["وَارْعَ المُحَصَّنَةَ الَّتِي بَرَّتْ بِهِ","بِرَّ الشَّرِيكِ المُسْعِفِ المِعْوَانِ",11,"ن",1,0],["وَارْعَهُ وَارْعَهَا وَيَسِّرْ لَهُ الأمْ","رَ وَيَسِّرْ لَهَا وَدَامَتْ وَدَامَا",12,"م",2,0],["وَأَرعَ سَرحَ اللَهوِ مُغتَدِياً","غَيرَ مُستَبِطٍ وَلا سَئِمِ",13,"م",1,0],["وَأَرعاهُمُ بِالغَيبِ مِن أَجلِ حُبِّها","وَأوليهِمُ مِنّي الكَرامَةَ وَالبَذلا",14,"ل",2,0],["وارعَ لي حُرمةَ المودَّةِ والخد","مةِ والمدحِ تُعْجِبِ الكرماءَ",15,"ا",2,0],["وأرع الصداقة لا تَمِيل بعهودها","بعد الصديق ولا تضع أشياءها",16,"ا",3,0],["وَاِرعَ مِصراً وَلَم تَزَل خَيرَ راعٍ","فَلَها بِالَّذي أَرَتكَ زِمامُ",17,"م",1,0],["وأرعنُ بحرٍ لو جرى البحرُ فوقَهُ","لما نضخَ الغبراءَ من مائِه كُوبُ",18,"ب",1,0],["وَأَرعَنَ جَرّارٍ إِذا ما تَطَلَّقَت","كَتائِبُهُ خَرَّت لَهُ الجِنُّ سُجَّدا",19,"د",2,1],["وَاِرعَ الجِوارَ لِأَهلِهِ مُتَبَرِّعاً","بِقَضاءِ ما طَلَبوا مِنَ الحاجاتِ",20,"ت",1,0],["وَاِرعَب قُلوبَ العِدى تُنصَر بِخَذلِهِمُ","إِنَّ النَبِيَّ بِفَضلِ الرُعبِ قَد نُصِرا",21,"ر",2,0],["وَارْعَ لِي حَقَّ وِدَادٍ","فِيكَ لَمْ أَقْطَعْ حِبَالَهْ",22,"ل",2,0],["وَأَرعَنَ طَمّاحِ الذُؤابَةِ باذِخٍ","يُطاوِلُ أَعنانَ السَماءِ بِغارِبِ",23,"ب",1,0],["وَاِرعَوى باطِلي وَبَرَّ حَديثُ ال","نَفسِ مِنّي وَعَفَّتِ الأَحلامُ",24,"م",1,0],["وأرعَيْتُها سَمْعي وقد راعَني لها","صَهِيلُ المَذاكي قبلَ قَرقرةِ النَّعَم",25,"م",1,0],["وأرْعَنَ يحْمُوم كأنّ أديمَهُ","إذا شُرِعَتْ أرماحُهُ ظَهرُ شَيهَم",26,"م",1,0],["وَاِرعَي وِدادي غائِباً","فَلَقَد رَعَيتُكِ في المَغيب",27,"ب",1,0],["وَأَرعَنَ يَغشى الشَمسَ لَونُ حَديدِهِ","وَتَخلِسُ أَبصارَ الكُماةِ كَتائِبُه",28,"ب",2,0],["وأُرْعِدَتِ القنا زَمَعاً وخَوْفاً","لذلك والمُهنّدَةُ الحِدادُ",29,"د",1,0],["وارعَ في الدنيا طريداً شارداً","عنه ضاقتْ رقعةُ الأرض اتساعا",30,"ع",2,0],["وَارْعَ ما حَوَتْ","هَذِهِ الْمُلَحْ",31,"ح",1,0],["وَارْعَيْ أَبَاهُمَا فَمَا أَحْوَجَهُ","إلى الَّتي رَعَتْهُ مِنْ عَهْدِ الصِّبَا",32,"ب",2,0],["وارع الشباب وصن كريم عهودهم","فهم لصفحة مجدك العنوان",33,"ن",1,0],["وأرْعَيْتِني شَرَّ المراعي وبِيلةً","وأوْرَدْتِني مُسْتَوَبآتِ الشَّرائع",34,"ع",1,0],["وأرعَبْنَ أطيافي وشَرَدْنَ طائفاً","مِن النوم يَسري في العيون الهواجع",34,"ع",1,0],["وارع حقا للآدميين طرا","الزمتنا بذلك الاحكام",35,"م",1,0],["وارع الذمام لكل خل صادق","ودع الكذوب بغيه وضلاله",36,"ل",2,0],["وارْعَ مَن راعَاك في كلِّ الوَرَى","واقبلِ المعروفَ منه إنْ قَبِلْ",37,"ل",1,0],["وارْعَ عشبَ الخيراتِ من ثمر الرا","حة واشكُر لفضل رب شكورِ",38,"ر",1,0],["وَأَرعَنَ مَوّارِ الحَواشي لِأَرضِهِ","بِعِثيَرِهِ مِن ناظِرِ الجَوِّ حاجِبُ",39,"ب",1,0],["وأرعبت صيحةُ الجاووش أَفئدة","منهم وقد راعها ما راع إذ دخلوا",40,"ل",3,0],["وَأَرعَنَ ظَلَّ يَنفُضُ مِذرَوَيهِ","وَيُبرِقُ لي وَيُرعِدُ بِاللسانِ",41,"ن",1,0],["وارعدُ وَهناً كالجناح تهزُّهُ","حمامتهُ في عطفها مذ تحطما",42,"م",2,0],["وَارْعَ ذَا الْقَلْبَ وَالْمُحَرَّفَ مِنْهَا","وَاقْفُ مَنْ قَالَ فَالْمُفَسِّرُ قَائِلْ",43,"ل",1,0],["وأرعى جبيناً من زنابقِ غيضةٍ","ونحراً عليه من بياضِ حليب",44,"ب",1,0],["وارعي بنيكِ وصوني إرثَهم أبداً","فالدهرُ قد أَكلبَ الإفرنج إكلابا",45,"ب",2,0],["وارع الكَريم اذا ضاق الخناق به","ما خابَ من أَنتَ في الدارين ملزمه",46,"م",2,0],["وأرعها في جنان","دانيات جَناها",47,"ا",3,0],["وَأَرعى الرَعِيَّةَ عَدلاً إِلى ال","دُعاءِ لَهُ كُلَّ وَقتٍ دَعاها",48,"ا",3,0],["واِرعَ صلاحَ حالِهم","واِشفق على إِمحالِهم",49,"م",1,0],["وارع الزمام لجيرة حلوا به","وانشد فؤاداً ضاع في ذاك الفنا",50,"ن",2,0],["وَارع روعكَ ما اِستكفاك مضطلعاً","ومثلُ روعك راعٍ غير مجهودِ",51,"د",1,0],["وَاِرعَ لها الروع المريع جنابه","لِتتلو حمداً يَملأ السمع والقلبا",52,"ب",2,0],["وأرْعِ فدْتكَ النّفسُ سمعَك مَرّةً","لنُسمِعَك الشّكْوى الّتي بَلغتْ منّا",53,"ن",2,0],["وَأَرعى صُحُفَ اللَيلِ","لَها مِن شُهبِها نَقطُ",54,"ط",1,0],["وارْعَها فهْي كالمُوَصّاةِ للحس","ناءِ تَرضَى منك الكَفاءةَ مَهرا",55,"ر",2,0],["وارْعَ ما بيننا منَ الأدبِ المُدْ","ني وإنّ كنتَ أنت أعلى وأَهْدى",56,"د",2,0],["وأرْعاك سلطانُ الورى أمْرَ مُلْكه","فناصَحْتَهُ والنُّصْحُ سِلْكَ المَناقب",57,"ب",1,0],["وأرعى له عهد الوداد محافظاً","عليه ولو سُلَّت عليّ القواضب",58,"ب",1,0],["وأَرعِ سَمعَكَ أمثالاً أُفَصِّلُها","كما يُفَصَّلُ يَاقوتٌ ومَرْجانُ",59,"ن",1,0],["وأرعى ذِمامَكَ ما دمتْ حَيَاً","ولا أستحيلُ ولا أنتَفي",60,"ف",2,0],["وَأَرعَن أَخرٍ من كَثرَةِ اللُ","غاتِ بِأرجائِهِ وَاللَجَب",61,"ب",1,0],["وأَرعى نجوم اللَّيل وهي طوالع","إلى حين تلقى الغرب وهي أفول",62,"ل",1,0],["وأرعفوها من دماءٍ دناً","تمرد بالطعن عيون الجراح",63,"ح",1,0],["وأرْعدي من غضَبٍ","عليَّ أو فأبْرِقي",64,"ي",1,0],["وأَرْعَيْتُ سعدانَ سَعْدِ السُّعُودِ","نِواءَ المُنى وصَفايا الصَّفاءِ",65,"ا",2,0],["وأَرعشها حنين الشول حتى","بقائم مخذمي التوتا يداها",66,"ا",3,0],["وأرعَى ساهرا منهم","عيونا ليس يرعَيْنا",67,"ن",2,0],["وأرعيتها الإمهال علماً بأنها","إليك وإن طال التنازعُ تضطرُّ",68,"ر",1,0],["وأرْعَن خفَّاق البنود مُزمْجرٍ","تضيق به بيداؤه حين يغْتدي",69,"د",2,0],["وَاِرعَ مِن شَيبِكَ ضَيفاً","ما لَهُ مِنكَ مُراعِ",70,"ع",1,0],["وارع الأمومة فيمن كنت مجهدها","حملا ووضعا وإرضاعا وأنت صبي",71,"ب",2,0],["وارْعَ بنيَّ العهدَ لا تهمِلْ له","أَمراً فحكْمُ العهدِ ديناً يُبْتَغَى",72,"ا",1,0],["واِرْعوا الجوارِحَ أن تصيّدَها المَها","فمنَ العُيونِ لها شِراكٌ تُنصَبُ",73,"ب",1,0],["وأرْعَشْتَ القَنا حتّى ظننّا","نفَحْتَ بهنّ أرواحَ الصِلالِ",74,"ل",1,0],["وَأَرْعَى الكَواكِبَ أَنَّى سَرَيْنَ","وَأَرْقبُ بَدْرَ الدُّجى حَيْثُ سَارا",75,"ر",2,0],["وأرعى حق من يرعى حقوقي","وأغضي عن جنايته احتشاما",76,"م",2,0]]}