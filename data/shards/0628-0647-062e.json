{"poems":[[55,"ترى نوب الأيام ترجي صعابها","https://www.aldiwan.net/poem30759.html","الطويل"],[30,"تروم على نعمان في الفجر ناقتي","https://www.aldiwan.net/poem5225.html","الطويل"],[21,"لك الحمد والمن رب العباد","https://www.aldiwan.net/poem36163.html","المتقارب"],[50,"رأيت المسجد الجام","https://www.aldiwan.net/poem64327.html","الهزج"],[193,"كتاب سعادة الدارين سفر","https://www.aldiwan.net/poem35139.html","الوافر"],[255,"يروحي نسيم هب من أرض طيبة","https://www.aldiwan.net/poem15055.html","الطويل"],[287,"عصر الشبيبة أنفس","https://www.aldiwan.net/poem32737.html","المجتث"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[309,"خليلي إن الشوق قد كاد أن يبلى","https://www.aldiwan.net/poem16904.html","الطويل"],[463,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80041","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49602","الوافر"],[1754,"","https://poetry.dctabudhabi.ae/diwan/poem/107351","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53122","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27612","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27915","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27917","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109373","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88661","الطويل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122454","الوافر"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74300","الهزج"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65100","الطويل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139979","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108348",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4755,"عَلِّقِي في كُلِّ نَصٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=183543",""],[475,"بِهِ خَالِدَاتٌ مَا يَرُمْنَ وهَامِدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=20582",""],[4623,"كتمت الهوى لكن نحولي به باحا ومن (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146769",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""]],"verses":[["بِهِ خَفَّ عَنّي ثِقلُ فادِحَةِ النُوى","وَحَبَّبَ عِندي نَأيَها وَاِغتِرابَها",0,"ب",3,0],["بِهِ خَيرُ أَهلِ الأَرضِ حَيّاً وَمَيِّتاً","سِوى مَن بِهِ دينُ البَرِيَّةِ أَسفَرا",1,"ر",2,0],["بِهِ خَتَمَ اللَهُ مِن قَبلَه","ومَن بَعدَهُ مِن نَبيٍّ خَتم",2,"م",1,0],["بِهِ خِلتُ ظِباءَ الإِن","سِ في أَقبَحِ مَأنوسِ",3,"س",1,0],["بهِ خيرُ الأماني والأمالي","فرائدُ لَن تمنَّ ولن تملّا",4,"ل",2,0],["به خيرُ مبعوث إلى الخَلقِ كُلِّهم","رسالَتُه قد عمَّت العُجمَ والعُربا",5,"ب",2,0],["بِهِ خَلَعتُ عِذاري","وَاللَهوُ لي فيهِ مَلبَس",6,"س",1,0],["به ختم اللَه النبوة وابتدا","فللَه من ختم به وبداية",7,"ه",1,0],["به ختم اللضه النبوة وابتدا","وقدمه في الذكر فاستجمع الفضلا",8,"ل",2,0],["به خُدوشٌ يتعجَّلْنهُ","قدائمٌ من لاحقِ الأكلبِ",9,"ب",1,0],["به خمدتْ نار العدا حين أرَّخوا","أتى المصطفى يا عزَّ آية مولده",10,"د",2,0],["به خُدَعُ المنى وَرُقَى المنايا","وصَرْفُ الدَّهْرِ يَخْشُنُ أو يلين",11,"ن",1,0],["به خمرة قدسيّة فيها الشفا","ويعود حيّا من غدا مرموسا",12,"س",2,0],["به خُمار لوعة كأنها","أدارت الذكرى عليه مسكرا",13,"ر",2,0],["به ختم الله الشرائعَ فاعلمن","ولا تعملن يا صاح في غير معمل",14,"ل",1,0],["به خلوتُ وما بالدارِ من أحد","إذ الوجودُ الذي ما زلتُ أبغيه",15,"ي",2,0],["به خُصصتُ على كشفٍ ومعرفة","ولم يكن فيه لي من قبل ذا قدم",16,"م",1,0],["به ختمت أهل المكارم واحتوى","كمالاً إليهِ النقصُ لا يتطرَّق",17,"ق",1,0],["به خلف المهدي نفسا زكيَّة","تفوق سموا في جميع فعالها",18,"ل",3,0],["بِهِ خَفَّ المُصَابُ وَكَيفَ نَأسَى","وَنَحنُلِوَجهِ سَيِّدِنَا شهُودُ",19,"د",1,0],["بِهِ خَير الوَرى قَد حَل","وَفيهِ السَيد الأَكمَل",20,"ل",1,1],["به ختم الرّسل الإلاهُ وتمّما","وأسرى به الرحمانُ ليلا إلى السّما",21,"م",2,0],["به ختم اللّه النبيين كلَّهم","وكلُّ فعال صالح هو خاتمه",22,"م",2,0],["به خلق حب الانام ولم يكن","تودده نحو الورى بالتخلق",23,"ق",1,0],["به خيل ابن فيلا","قد طوت ووايله السهلا",24,"ل",2,0],["بهِ خُضتُ أَعماقِي, وأَينَعتُ بَعدَمَا","أَحَالَت عَنَاقِيدِي غُبارًا مَعَارِكِي",25,"ك",2,0],["بِهِ خَالِدَاتٌ مَا يَرُمْنَ وهَامِدٌ","وأشعثُ أرستهُ الوليدة ٌ بالفهرِ",26,"ر",1,1],["به ختم الله النبوءة في الورى","ونال به أهل السعادة أفراحا",27,"ح",2,0],["به ختم الله النبوة إذ غدا","ختاما لها وذات كل نبوة",28,"ه",1,0]]}