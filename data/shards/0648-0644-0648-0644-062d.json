{"poems":[[79,"إذا فاتني ظل الحمى ونعيمه","https://www.aldiwan.net/poem36117.html","الطويل"],[45,"وصفت لنا ولم نره سلاحا","https://www.aldiwan.net/poem9966.html","الوافر"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140988",""],[445,"أخفضا نوت فينا النوى ولعلها","https://www.aldiwan.net/poem34863.html","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67818","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69410","البسيط"],[2515,"","https://poetry.dctabudhabi.ae/diwan/poem/198791","الطويل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146764","الطويل"]],"verses":[["وَلَوْ لَحَظَتْنِي مٍنْ جَنَابِكَ لَحْظَةٌ","لَمَا رَامَنِي عِنْدَ الْبَيَاتِ نُجُومُهُ",0,"م",2,0],["وَلَو لَحَظَ الدُمُستُقُ جانِبَيهِ","لَقَلَّبَ رَأيَهُ حالاً لِحالِ",1,"ل",1,0],["ولو لحظ الدمستق حافتيه","لقلّب رأيه حالا لحال",2,"ل",1,0],["ولَوْ لَحِقَتْ مَجْرى الكواكِبِ خَلَّةٌ","لَقِيلَ لَهُ سُسْتَ العُلا فَتَوَلَّها",3,"ل",3,0],["وَلَوْ لَحَّ بي فِي غُدْوَتي وَمَسَائي","تَرَى الْعَيْشَ يَصْفُو بَيْنَ تلْكَ المَرَابِعِ",4,"ع",1,0],["وَلَو لَحِقتَ زَمانَ الوَحيِ ما نَزَلَت","إِلّا بِتَفضِيلِكِ الآياتُ وَالسُوَرُ",5,"ر",1,0],["ولو لحت نحو الغرب للشمس لحظة","لعزَّ عليها إذ تراك غروبها",6,"ب",3,0],["ولو لحظت جنات تدمر حسنها","درت كيف تبني بعدهن المجادلا؟",7,"ل",2,0]]}