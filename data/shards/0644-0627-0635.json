{"poems":[[53,"أبا نزار تفسد القوم النعم","https://www.aldiwan.net/poem29802.html","الرجز"],[53,"يا ناشد النعماء يقفو إثرها","https://www.aldiwan.net/poem30480.html","الرجز"],[53,"إنا نعيب ولانعاب","https://www.aldiwan.net/poem30746.html","مجزوء الكامل"],[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[73,"أَما وَأَلحاظٍ مِراضٍ صِحاح","https://www.aldiwan.net/poem11927.html","السريع"],[0,"لمن طلل بين الجدية والجبل","https://www.aldiwan.net/poem84.html","الطويل"],[35,"أشاقك برق آخر الليل خافق","https://www.aldiwan.net/poem39128.html","الطويل"],[35,"أهاجتك سلمى أم أجد بكورها","https://www.aldiwan.net/poem39144.html","الطويل"],[93,"يا مزهراً صيغ من جذوع","https://www.aldiwan.net/poem11160.html","مخلع البسيط"],[27,"ألا حي المنازل بالجناب","https://www.aldiwan.net/poem5664.html","الوافر"],[60,"لا تعذليه فإن العذل يولعه","https://www.aldiwan.net/poem13279.html","البسيط"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[85,"أروى لكم خرافة","https://www.aldiwan.net/poem7773.html","مجزوء الرجز"],[43,"ضروب الناس عشاق ضروبا","https://www.aldiwan.net/poem9501.html","الوافر"],[45,"لي سيد قد سامني الخسفا","https://www.aldiwan.net/poem65155.html","البسيط"],[28,"إن تميما كل جد لجدها","https://www.aldiwan.net/poem5428.html","الطويل"],[61,"صبابة منك لجت في تماديها","https://www.aldiwan.net/poem51400.html","البسيط"],[61,"تحية الغيث منهلا سحائبه","https://www.aldiwan.net/poem51806.html","البسيط"],[49,"كل حي إلى الممات يصير","https://www.aldiwan.net/poem62086.html","الخفيف"],[97,"بي ما تحس وفي فؤادك ما بي","https://www.aldiwan.net/poem24400.html","الكامل"],[97,"من شاطئ لشواطئ جدد","https://www.aldiwan.net/poem24763.html","أحذ الكامل"],[97,"هي صفحة طويت وحان ختام","https://www.aldiwan.net/poem24984.html","الكامل"],[80,"أذابل النرجس في مقلتيك","https://www.aldiwan.net/poem31351.html","السريع"],[80,"إذا كان في الكتب اتصال لقائنا","https://www.aldiwan.net/poem31392.html","الطويل"],[80,"أيا رشاقة غصن البان ما هصرك","https://www.aldiwan.net/poem31444.html","البسيط"],[80,"كتابك راق الوشي من خط كاتبه","https://www.aldiwan.net/poem31552.html","الطويل"],[44,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[44,"يد الشكوى أتتك على البريد","https://www.aldiwan.net/poem30533.html","الوافر"],[87,"ويلاه من نار الهوى","https://www.aldiwan.net/poem8195.html","مجزوء الرجز"],[87,"من لعين إنسانها لا يناميب كفا","https://www.aldiwan.net/poem8242.html","الخفيف"],[31,"ولقد أشهد المحدث عند ال","https://www.aldiwan.net/poem41284.html","الخفيف"],[31,"أبت البخيلة أن تنولني","https://www.aldiwan.net/poem42478.html","الكامل"],[81,"أما لك لا ترثي لحاله مكمد","https://www.aldiwan.net/poem61538.html","الطويل"],[52,"الآن سرت فؤادي مقلة الريم","https://www.aldiwan.net/poem26682.html","البسيط"],[52,"لا صيد إلا بوتر","https://www.aldiwan.net/poem26974.html","مجزوء الرجز"],[75,"سرى وجناح الليل أقتم أفتخ","https://www.aldiwan.net/poem69093.html","الطويل"],[48,"لا صيد إلا بالصقور اللمح","https://www.aldiwan.net/poem62542.html","الرجز"],[48,"كفى حزنا ألا أرى وجه حيلة","https://www.aldiwan.net/poem65323.html","الطويل"],[48,"لا صحب الله فتية طربوا","https://www.aldiwan.net/poem66553.html","المنسرح"],[19,"ألم تكسف الشمس والبدر والكواكبُ","https://www.aldiwan.net/poem325.html",""],[76,"وا كبدا قد تقطعت كبدي","https://www.aldiwan.net/poem39438.html","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39682","المنسرح"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20992","الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21121","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42574","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1946","الطويل"],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[51,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[60,"لا تعذليه فإن العذل يولعه","https://www.poetsgate.com/ViewPoem.aspx?id=15018",""],[31,"أَبَتِ البَخِيلَة ُ أَنْ تُنَوِّلَني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18920&r=&rc=183",""]],"verses":[["لَأَصدَعَن عِرضَكَ صَدعاً لا يُلَم","عَطّاً كَما عَطَّ الفَزارِيُّ الأَدَم",0,"م",1,0],["لَأَصبَحَتنا وَوُقينا شَرَّها","ظَلماءُ أَمرٍ لا تَكونُ فَجرَها",1,"ر",3,0],["لا صُلحَ حَتّى تَطمَئِن","نَ إِلى مَناسِمِها الرِكابُ",2,"ب",1,0],["لاصِقٌ يَكلَأُ الشَريعَةَ لا يُغ","في فُواقاً مُدَمِّراً تَدميرا",3,"ر",2,0],["لَأُصفِيَنَّ المُصطَفى جَهوراً","عَهداً لِرَوضِ الحُسنِ عَنهُ اِنتِضاح",4,"ح",1,0],["لَأَصبَحَ مَفتُوناً مُعَنَّى بِحُبِّهَ","كأَن لَم يَصُم لِلّهِ يَوماً ولَم يُصَل",5,"ل",1,0],["لَأَصبَحتُ خِلواً مِن هُمومٍ وَما سَرَت","عَلَيَّ خَيالاتُ الحَبيبِ الطَوارِقُ",6,"ق",1,0],["لَأَصبَحتَ هَدَّتكَ الحَوادِثُ هَدَّةً","نَعَم فَشَواةُ الرَأسِ بادٍ قَتيرُها",7,"ر",3,0],["لا صَوْتَ أَشْجَى مِنْ صَوْتِ عُودٍ","كَيْفَ بِهِ وَهْوَ عُودُ هَانِي",8,"ن",2,0],["لَأَصبَحَ دونَهُ رَقَماتُ فَلجٍ","وَغُبرُ اللامِعاتِ مِنَ الحِدابِ",9,"ب",1,0],["لَأَصبِرَنَّ لِمَهرٍ لا يُمَتِّعُنِي","بِهِ وَلا بِيَ فِي حالٍ يُمَتِّعُهُ",10,"ع",2,0],["لأصبح مَنْ سامَى الأميرَ كرائمٍ","منالَ الثريّا وهو أعسمُ أجذَمُ",11,"م",1,0],["لا صبر لي معها ولا","أرى بيها لي قِبَلا",12,"ل",2,0],["لِأَصبِحَ آمِناً فيكَ الرَزايا","كَما أَنا آمِنٌ فيكَ العُيوبا",13,"ب",2,0],["لا صِدقُ إِسماعيلَ فيها وَلا","وَفاءُ إِبراهيمَ إِذ وَفّى",14,"ف",2,0],["لَأَصيَدَ لَو يُلقي عَلى رُكنِ يَذبُلٍ","يَدَيهِ إِذاً لَاِنقَضَّ مِنهُ جَنادِلُه",15,"ل",2,0],["لأصفحَنَّ عن الأيّامِ إذ صَفَحَتْ","عنِّي بأفعالِك الحُسنى مَساوِيها",16,"ي",3,0],["لأصبِرنَّ على إخلالِ عُرفِكَ بي","حتى يثوبَ إلى المعهودِ ثائبُه",17,"ب",2,0],["لا صَغيرٌ يَبقى عَلى حادِثِ الدَه","رِ أَلا لا وَلَيسَ يَنجو الكَبيرُ",18,"ر",1,0],["لا صِدقَ إلا في لهيبِكَ وحده","وجلاله الباقي على الأحقابِ",19,"ب",1,0],["لا صوت يسمع في الدنى لأحد","إلا صدى المجداف والموج",20,"ج",1,0],["لا صحو من سِنة المنون وإنما","سهر الخلود عليك حيث تنام",21,"م",1,0],["لا صَبرَ لي عَنكِ وَإِن كانَ لي","عَلى جِناياتك صَبرٌ عَلَيك",22,"ك",1,0],["لأصْبَحْتُ في الدّنْيا حريصاً عليكمُ","ألا إِنّ مثلي زاهدٌ في متاعها",23,"ع",3,0],["لا صبرَ عنكِ وكيف الصبر عنكِ وقد","طواكِ عن عينيَ الموجُ الذي نَشَرك",24,"ك",1,0],["لأصبحتَ مثل البَحر يَزخَر وَحدَه","وإن كثُرَ الأنهار مِن عن جوانِبه",25,"ب",2,0],["لَأَصبَحَت كَالأَثافي السُفعِ أَوجُهُكُم","سوداً مِنَ العارِ لا سوداً مِنَ الحُمَمِ",26,"م",1,0],["لَأَصبَحَ حَبلُ شِعري طَوقَ غُلٍّ","مِنَ الأَيّامِ في عُنُقي وَجيدي",27,"د",2,0],["لا صَاحِبٌ وَافَى وَلا","خِلٌّ إِلَى حَالِي أَوَى",28,"و",2,0],["لا صَدِيقٌ يَرْثِي لِمَا بِتُّ أَلْقَا","هُ وَلا مُسْعِدٌ فَأَيْنَ الْكِرَامُ",29,"م",1,0],["لا صَديقاً كُنتَ اِتُّخِذتَ وَلا نُص","حُكَ عِندي زَجرٌ لَهُ ميزانُ",30,"ن",1,0],["لا صَبرَ لي عَنها إِذا بَرَزَت","كَالبَدرِ أَو قَرنٍ مِنَ الشَمسِ",31,"س",1,0],["لَأَصبِرُ طَوعاً وَاِحتِمالاً فَرُبَّما","صُروفُ اللَيالي مُسعِداتٌ بِأَسعُدِ",32,"د",1,0],["لا صاحَبَتني يَدٌ لَم تُغنِ أَلفَ يَدٍ","وَلَم تَرُدَّ القَنا حُمرَ الخَياشيمِ",33,"م",1,0],["لا صَيدَ إِلّا بِوَتَر","أَصفَرَ مَجدولٍ مُمَر",34,"ر",1,1],["لأصْليتَها ناراً هي النّارُ لا التي","تُنَتِّخُ فيها ألفَ عامٍ وتُمْرَخ",35,"خ",1,0],["لا صَيدَ إِلّا بِالصُقورِ اللُمَّحِ","كُلَّ قِطامِيٍّ بَعيدِ المَطرَحِ",36,"ح",1,1],["لَأَصبَحتُ مِنها دانِيَ الدارِ لاصِقاً","وَلَكِنَّ ما أَخشى فُديتَ عَداني",37,"ي",1,0],["لا صحَبَ اللَهُ فتيةً طربوا","إلى ذواتِ الثُدِيِّ والحبَل",38,"ل",1,1],["لَأَصبَحَ رَتماً دُقاقَ الحَصى","كَمَتنِ النَبِيِّ مِنَ الكاثِبِ",39,"ب",1,0],["لا صَبْرَ لي بَعْدَهُ ولا جَلَدٌ","فُجعْتُ بالصَّبْرِ فِيهِ وَالجَلَدِ",40,"د",1,0],["لا صوتَ إلا صوتُ حُبّك في دَمي","أُصغي له وأراه في أطواقي",41,"ي",1,0],["لأصهبَ من أُسودِ الحرب يمشي","بأصهَبَ تُمسِكُ الدنيا لجامهْ",42,"م",2,0],["لا صوت لا اشباح","إنّي هنا وحدي",43,"ي",1,0],["لا صَغِيرٌ ضارِعٌ ذُو سَقطَةٍ","أو كَبيرٌ كارِبٌ سنَّ الهَرَم",44,"م",1,0],["لا صَفَايَا دُهم فأسَمَها الرِّس","لُ ولا جِلَّة قَطيعٍ هِجَان",45,"ن",1,0],["لا صَاحِبٌ إِنْ شَكَوْتُ حَالِي","يَرْثِي وَلا سَامِعٌ يَرُدُّ",46,"د",1,0],["لاَ صَوْتَ أَنْكَرُ إِذْ تُرَاجِعُ أُمَّةٌ","تَارِيخَهَا مِنْ صَيْحَةِ الدَّلاَّلِ",47,"ل",1,0],["لاَ صَفْوَ أَرْوَح مِن","تحَيُّرِ خَصْمِكِ المتَضَعْضِعِ",48,"ع",1,0],["لَأَصبَحَ مَفتُوناً مُعَنَّى بِحُبِّهَا","كأَن لَم يَصُم لِلّهِ يَوماً ولَم يُصَل",49,"ل",1,0],["لا صولة الحكم استخفَّتهم، ولا","عاشوا لسلطان الحطام عبيدا",50,"د",2,0],["لا صَدَيَتْ هاتيكم العِظامُ","ولا أغَبَّتْ سقْيها الرّهامُ",51,"م",1,0],["لَأَصبِرَنَّ لِدهرٍ لا يُمَتِّعُنِي","بِهِ وَلا بِيَ فِي حالٍ يُمَتِّعُهُ",52,"ع",2,0],["لا صبرَ لي عنها، إذا برزت،","كکلْبَدْرِ أَوْ قَرْنٍ مِنَ الشَّمْسِ",53,"س",1,0]]}