oem.aspx?id=179479",""],[94,"يا وحشة الثأر","https://www.poetsgate.com/ViewPoem.aspx?id=12821",""],[51,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[60,"لا تعذليه فإن العذل يولعه","https://www.poetsgate.com/ViewPoem.aspx?id=15018",""],[31,"أَبَتِ البَخِيلَة ُ أَنْ تُنَوِّلَني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18920&r=&rc=183",""],[116,"الى الغوث الحسيني الدسوقي","https://www.aldiwan.net/poem40870.html","عموديه"],[118,"الشعر","https://www.aldiwan.net/poem24070.html","السريع"],[151,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[151,"لكل نبي عصمة وأمانة","https://www.aldiwan.net/poem68578.html","الطويل"],[161,"إلى أى باب غير بابك أقرع","https://www.aldiwan.net/poem59097.html","الطويل"],[165,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[165,"لا تصغيا في الهوى لمن عذلا","https://www.aldiwan.net/poem67850.html","المنسرح"],[170,"إلى م أورد عتباً غير مستمع","https://www.aldiwan.net/poem1637.html",""],[186,"عسى يجري الزمان على اختياري","https://www.aldiwan.net/poem14534.html","الوافر"],[187,"أما والذي حلت بساحة بيته","https://www.aldiwan.net/poem43295.html","الطويل"],[205,"صنم تسربل شكله من وصفه","https://www.aldiwan.net/poem53241.html","الكامل"],[205,"لا أستطيع من الضنى شكوى الضنى","https://www.aldiwan.net/poem53364.html","الكامل"],[211,"يا أيها المولى الذي جوده","https://www.aldiwan.net/poem13320.html","السريع"],[212,"لأصبحت نهب الأسى والحزن","https://www.aldiwan.net/poem46592.html","المتقارب"],[230,"جرحي بعينيك ليس يندمل","https://www.aldiwan.net/poem50867.html","المنسرح"],[232,"حيتك السنة الحيا من دار","https://www.aldiwan.net/poem44590.html","الكامل"],[236,"لا بارك الله في قوم صحبتهم","https://www.aldiwan.net/poem31813.html","البسيط"],[250,"أنية الغداة أم انتقال","https://www.aldiwan.net/poem2099.html","الوافر"],[250,"أليلى على شحط المزار تذكر","https://www.aldiwan.net/poem2118.html","الطويل"],[262,"وإني وإن حال التفرق بيننا","https://www.aldiwan.net/poem38328.html","الطويل"],[271,"طال التمنع يا مليحة فامنحي","https://www.aldiwan.net/poem35461.html","الكامل"],[276,"وكيف يقر صب مستهام","https://www.aldiwan.net/poem25563.html","الوافر"],[283,"حلفت لي هند فخانت يميني","https://www.aldiwan.net/poem32333.html","الخفيف"],[286,"أمحمد بن الشيخ يا فخر القضا","https://www.aldiwan.net/poem39394.html","الكامل"],[301,"حي الديار بسيل فالقهر","https://www.aldiwan.net/poem45482.html","أحذ الكامل"],[305,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[321,"كتابكم مذ بدا لعيني","https://www.aldiwan.net/poem61708.html","مخلع البسيط"],[329,"لولا ولولا ولولا","https://www.aldiwan.net/poem54933.html","المجتث"],[354,"يا راحلين بقلبي والنهى أفلا","https://www.aldiwan.net/poem39587.html","البسيط"],[367,"وأرضيت فيك الحب والحب جائر","https://www.aldiwan.net/poem17170.html","الطويل"],[372,"جعلت على الطرف السهور","https://www.aldiwan.net/poem57441.html","مجزوء الكامل"],[404,"لا صبر لا صبر على ذا البعاد","https://www.aldiwan.net/poem33937.html","السريع"],[407,"لمن الرسوم بعرصة البردان","https://www.aldiwan.net/poem50100.html","الكامل"],[410,"لأصبرن لدهري صبر محتسب","https://www.aldiwan.net/poem32152.html","البسيط"],[410,"من كان لي من حماه خيس ذي لبد","https://www.aldiwan.net/poem32214.html","البسيط"],[410,"ما يريد الشوق من قلب مغنى","https://www.aldiwan.net/poem32369.html","الرمل"],[410,"لا صبر لي عن بدر تم مشرق","https://www.aldiwan.net/poem32586.html","الكامل"],[433,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[433,"ثنت عنك يوم الرحيل العنانا","https://www.aldiwan.net/poem12741.html","المتقارب"],[442,"لا طارف عاد عندي لا ولا تلد","https://www.aldiwan.net/poem14301.html","البسيط"],[454,"رمضان يا حلو الشمائل","https://www.aldiwan.net/poem61335.html","مجزوء الكامل"],[465,"نعم هذه آثارهم والمنازل","https://www.aldiwan.net/poem3164.html","عموديه"],[465,"ما نال من وصلكم بعض الذي وجبا","https://www.aldiwan.net/poem3498.html","عموديه"],[466,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[469,"لا صاحب إلا الذي أعضاؤه","https://www.aldiwan.net/poem59578.html","الكامل"],[480,"قم بالمهمة في حل ومرتحل","https://www.aldiwan.net/poem36964.html","البسيط"],[494,"سلوا الصبابة عني هل خلوت بمن","https://www.aldiwan.net/poem67292.html","عموديه"],[515,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[516,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[552,"أرق عيني طارق","https://www.aldiwan.net/poem47360.html","مجزوء الرجز"],[552,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[576,"ألوم نفسي على هذا العتاب وما","https://www.aldiwan.net/poem2760.html","البسيط"]],"verses":[["لَأَصدَعَن عِرضَكَ صَدعاً لا يُلَم","عَطّاً كَما عَطَّ الفَزارِيُّ الأَدَم",0,"م",1,0],["لَأَصبَحَتنا وَوُقينا شَرَّها","ظَلماءُ أَمرٍ لا تَكونُ فَجرَها",1,"ر",3,0],["لا صُلحَ حَتّى تَطمَئِن","نَ إِلى مَناسِمِها الرِكابُ",2,"ب",1,0],["لاصِقٌ يَكلَأُ الشَريعَةَ لا يُغ","في فُواقاً مُدَمِّراً تَدميرا",3,"ر",2,0],["لَأُصفِيَنَّ المُصطَفى جَهوراً","عَهداً لِرَوضِ الحُسنِ عَنهُ اِنتِضاح",4,"ح",1,0],["لَأَصبَحَ مَفتُوناً مُعَنَّى بِحُبِّهَ","كأَن لَم يَصُم لِلّهِ يَوماً ولَم يُصَل",5,"ل",1,0],["لَأَصبَحتُ خِلواً مِن هُمومٍ وَما سَرَت","عَلَيَّ خَيالاتُ الحَبيبِ الطَوارِقُ",6,"ق",1,0],["لَأَصبَحتَ هَدَّتكَ الحَوادِثُ هَدَّةً","نَعَم فَشَواةُ الرَأسِ بادٍ قَتيرُها",7,"ر",3,0],["لا صَوْتَ أَشْجَى مِنْ صَوْتِ عُودٍ","كَيْفَ بِهِ وَهْوَ عُودُ هَانِي",8,"ن",2,0],["لَأَصبَحَ دونَهُ رَقَماتُ فَلجٍ","وَغُبرُ اللامِعاتِ مِنَ الحِدابِ",9,"ب",1,0],["لَأَصبِرَنَّ لِمَهرٍ لا يُمَتِّعُنِي","بِهِ وَلا بِيَ فِي حالٍ يُمَتِّعُهُ",10,"ع",2,0],["لأصبح مَنْ سامَى الأميرَ كرائمٍ","منالَ الثريّا وهو أعسمُ أجذَمُ",11,"م",1,0],["لا صبر لي معها ولا","أرى بيها لي قِبَلا",12,"ل",2,0],["لِأَصبِحَ آمِناً فيكَ الرَزايا","كَما أَنا آمِنٌ فيكَ العُيوبا",13,"ب",2,0],["لا صِدقُ إِسماعيلَ فيها وَلا","وَفاءُ إِبراهيمَ إِذ وَفّى",14,"ف",2,0],["لَأَصيَدَ لَو يُلقي عَلى رُكنِ يَذبُلٍ","يَدَيهِ إِذاً لَاِنقَضَّ مِنهُ جَنادِلُه",15,"ل",2,0],["لأصفحَنَّ عن الأيّامِ إذ صَفَحَتْ","عنِّي بأفعالِك الحُسنى مَساوِيها",16,"ي",3,0],["لأصبِرنَّ على إخلالِ عُرفِكَ بي","حتى يثوبَ إلى المعهودِ ثائبُه",17,"ب",2,0],["لا صَغيرٌ يَبقى عَلى حادِثِ الدَه","رِ أَلا لا وَلَيسَ يَنجو الكَبيرُ",18,"ر",1,0],["لا صِدقَ إلا في لهيبِكَ وحده","وجلاله الباقي على الأحقابِ",19,"ب",1,0],["لا صوت يسمع في الدنى لأحد","إلا صدى المجداف والموج",20,"ج",1,0],["لا صحو من سِنة المنون وإنما","سهر الخلود عليك حيث تنام",21,"م",1,0],["لا صَبرَ لي عَنكِ وَإِن كانَ لي","عَلى جِناياتك صَبرٌ عَلَيك",22,"ك",1,0],["لأصْبَحْتُ في الدّنْيا حريصاً عليكمُ","ألا إِنّ مثلي زاهدٌ في متاعها",23,"ع",3,0],["لا صبرَ عنكِ وكيف الصبر عنكِ وقد","طواكِ عن عينيَ الموجُ الذي نَشَرك",24,"ك",1,0],["لأصبحتَ مثل البَحر يَزخَر وَحدَه","وإن كثُرَ الأنهار مِن عن جوانِبه",25,"ب",2,0],["لَأَصبَحَت كَالأَثافي السُفعِ أَوجُهُكُم","سوداً مِنَ العارِ لا سوداً مِنَ الحُمَمِ",26,"م",1,0],["لَأَصبَحَ حَبلُ شِعري طَوقَ غُلٍّ","مِنَ الأَيّامِ في عُنُقي وَجيدي",27,"د",2,0],["لا صَاحِبٌ وَافَى وَلا","خِلٌّ إِلَى حَالِي أَوَى",28,"و",2,0],["لا صَدِيقٌ يَرْثِي لِمَا بِتُّ أَلْقَا","هُ وَلا مُسْعِدٌ فَأَيْنَ الْكِرَامُ",29,"م",1,0],["لا صَديقاً كُنتَ اِتُّخِذتَ وَلا نُص","حُكَ عِندي زَجرٌ لَهُ ميزانُ",30,"ن",1,0],["لا صَبرَ لي عَنها إِذا بَرَزَت","كَالبَدرِ أَو قَرنٍ مِنَ الشَمسِ",31,"س",1,0],["لَأَصبِرُ طَوعاً وَاِحتِمالاً فَرُبَّما","صُروفُ اللَيالي مُسعِداتٌ بِأَسعُدِ",32,"د",1,0],["لا صاحَبَتني يَدٌ لَم تُغنِ أَلفَ يَدٍ","وَلَم تَرُدَّ القَنا حُمرَ الخَياشيمِ",33,"م",1,0],["لا صَيدَ إِلّا بِوَتَر","أَصفَرَ مَجدولٍ مُمَر",34,"ر",1,1],["لأصْليتَها ناراً هي النّارُ لا التي","تُنَتِّخُ فيها ألفَ عامٍ وتُمْرَخ",35,"خ",1,0],["لا صَيدَ إِلّا بِالصُقورِ اللُمَّحِ","كُلَّ قِطامِيٍّ بَعيدِ المَطرَحِ",36,"ح",1,1],["لَأَصبَحتُ مِنها دانِيَ الدارِ لاصِقاً","وَلَكِنَّ ما أَخشى فُديتَ عَداني",37,"ن",2,0],["لا صحَبَ اللَهُ فتيةً طربوا","إلى ذواتِ الثُدِيِّ والحبَل",38,"ل",1,1],["لَأَصبَحَ رَتماً دُقاقَ الحَصى","كَمَتنِ النَبِيِّ مِنَ الكاثِبِ",39,"ب",1,0],["لا صَبْرَ لي بَعْدَهُ ولا جَلَدٌ","فُجعْتُ بالصَّبْرِ فِيهِ وَالجَلَدِ",40,"د",1,0],["لا صوتَ إلا صوتُ حُبّك في دَمي","أُصغي له وأراه في أطواقي",41,"ي",1,0],["لأصهبَ من أُسودِ الحرب يمشي","بأصهَبَ تُمسِكُ الدنيا لجامهْ",42,"م",2,0],["لا صوت لا اشباح","إنّي هنا وحدي",43,"ي",1,0],["لا صَغِيرٌ ضارِعٌ ذُو سَقطَةٍ","أو كَبيرٌ كارِبٌ سنَّ الهَرَم",44,"م",1,0],["لا صَفَايَا دُهم فأسَمَها الرِّس","لُ ولا جِلَّة قَطيعٍ هِجَان",45,"ن",1,0],["لا صَاحِبٌ إِنْ شَكَوْتُ حَالِي","يَرْثِي وَلا سَامِعٌ يَرُدُّ",46,"د",1,0],["لاَ صَوْتَ أَنْكَرُ إِذْ تُرَاجِعُ أُمَّةٌ","تَارِيخَهَا مِنْ صَيْحَةِ الدَّلاَّلِ",47,"ل",1,0],["لاَ صَفْوَ أَرْوَح مِن","تحَيُّرِ خَصْمِكِ المتَضَعْضِعِ",48,"ع",1,0],["لَأَصبَحَ مَفتُوناً مُعَنَّى بِحُبِّهَا","كأَن لَم يَصُم لِلّهِ يَوماً ولَم يُصَل",49,"ل",1,0],["لا صولة الحكم استخفَّتهم، ولا","عاشوا لسلطان الحطام عبيدا",50,"د",2,0],["لا صيد غسّان والهيجاء ضارية","على السروج ولا أقيال مروانا",51,"ن",2,0],["لا صَدَيَتْ هاتيكم العِظامُ","ولا أغَبَّتْ سقْيها الرّهامُ",52,"م",1,0],["لَأَصبِرَنَّ لِدهرٍ لا يُمَتِّعُنِي","بِهِ وَلا بِيَ فِي حالٍ يُمَتِّعُهُ",53,"ع",2,0],["لا صبرَ لي عنها، إذا برزت،","كکلْبَدْرِ أَوْ قَرْنٍ مِنَ الشَّمْسِ",54,"س",1,0],["لاصحاب العبا رفعته حقا","ذؤابة اصله العالي العريق",55,"ق",1,0],["لا صَبْرَ، لَكِنْ أَدَّعِي أَنَّني","أكبَرُ صَبٍّ، ما وَهَى صَبْرُهُ",56,"ر",2,0],["لا صبر لي من بعدهم لا صبر لي","لو أنني في حلم شمس الدين",57,"ن",1,0],["لأَصبَحَ في الدارَينِ لِلكُلِّ سَيِّداً","وَدونَكَ فاسأل هَل تُحِسُّ لَهُ مِثلا",58,"ل",2,0],["لأصبح نحوى النجم يرفع طرفه","كما كنت نحو النجم طرفي أرفع",59,"ع",1,0],["لا صَكَكٌ يشينُهُ وَلا فَجا","وَلا دَخيسٌ واهِنٌ وَلا شَظى",60,"ا",1,0],["لا صَبرَ عَمَّن إِذا تَصَوَّرَ لي","رَأَيتُ بَدرَ السَماءِ قَد أَفلا",61,"ل",2,0],["لا صاحَبَتنِيَ نَفسٌ لا تُبَلِّغُني","مَراتِبَ العِزِّ لَو في ناظِرِ السَبُعِ",62,"ع",1,0],["لأَصبح فوقَها طوفانُ نوحٍ","يجِلُّ عن السواحلِ والقَرار",63,"ر",1,0],["لأصبح قد أوهى ذراه مهدّما","رضيضا هشيما صلده ومهدّم",64,"م",1,0],["لا صبر لي عن أُنسه وحديثه","والإلف ليس بصابرٍ عن إلفِهِ",65,"ف",2,0],["لا صبر لي أنَّى عليك تصبري","والتيهُ دابُكَ والتذلُّل دابي",66,"ب",2,0],["لا صلة القى ولا عائدا","يجود لي من بره الواصل",67,"ل",1,0],["لأصبحتُ نهب الأسى والحزن","لجسم أقام وقلب ظعن",68,"ن",1,1],["لا صَحَبْتَنِي يَدِي وَلا اتَّسَعَت","إلى بلوغِ العُلاُ بيَ السُّبُل",69,"ل",1,0],["لا صرّحن اليوم فيك بلوعة","كفلت بما في الطول ونار",70,"ر",1,0],["لَأَصبُرَنَّ عَلى إِدمانِ ظُلمِهِمُ","عَسى اللَيالي تُواتيني فَأَنتَصِفُ",71,"ف",1,0],["لَأَصبَحَتِ السَفينُ مُخَوِّياتٍ","عَلى القُذُفاتِ لَيسَ لَها بِلالُ",72,"ل",1,0],["لَأَصبَحَ كَالشَقراءِ لَم يَعدُ شَرُّها","سَنابِكَ رِجلَيها وَعِرضُكَ أَوفَرُ",73,"ر",1,0],["لأصدقكم مني الوداد على النوى","وصدق ما كان الوداد على البعد",74,"د",1,0],["لأصونَ جوهرَ دَمعِها وأقولَ يا","غوّاصُ درُّكَ عِندَهُ لم يَربَح",75,"ح",1,0],["لآصالٍ بهِ حسنت وَطَابَت","كَما حدّثْتَ عَنْ نوْر العَرارِ",76,"ر",1,0],["لأَصوغَنَّ فيهِ مَدحاً أَريجاً","مِثلَ مِسكِ الدَّاري مِن دارينِ",77,"ن",1,0],["لا صبر بعدك ما تطاول عمرنا","والدمع ما امتد الزمان يسيل",78,"ل",1,0],["لا صابَ جارَهُمُ الرَبيعُ وَلا","زادَت حُمولَتُهُ عَلى عَشرِ",79,"ر",1,0],["لاصحابك اذكر كل وصف يسرهم","من أوصافهم في الخلق والخلق والشان",80,"ن",1,0],["لَأَصبَحَ اليَومَ في هَناءِ","وَطارَ بِشراً بِما تَخولُ",81,"ل",1,0],["لأصبح السر جهرا","منى وأصبحت قولا",82,"ل",2,0],["لا صبَّ مَدمَع صَبٍّ مِنكَ يَوم نَوى","وَلا مَلا بِالجَوى مِنّا قُلوب ملا",83,"ل",2,0],["لَأَصلَحَت مِن حالي وقد كانَ رازِحاً","وَأَعجَزتَ شُكري بَعدَها فَهوَ رازِحُ",84,"ح",1,0],["لا صدَّني جزعُ الجزو","ع لهنَّ عن صَبر الصبورِ",85,"ر",1,0],["لا صبر لا صبر على ذا البعاد","فاسلك بنا الرفق ونهج السداد",86,"د",1,1],["لأصادفنَّ العَيشَ بَعدَ رويَّةٍ","تَحبو وَمسألة لِغَير أَوانِ",87,"ن",1,0],["لأصبرنَّ لدهري صبرَ مُحتَسِبٍ","حتّى يَرى غيرَ ما قَد كان يَحسَبُهُ",88,"ب",2,1],["لأَصْرِفَ العينَ عنهُ إنها أبداً","عن الكمالِ برؤيا النَّقصِ تَنصَرِفُ",89,"ف",1,0],["لا صَفَا لي العيشُ من بَعدِكُمُ","ما تَمادَتْ مُدّةُ البينِ وعِشْنَا",90,"ن",2,0],["لا صبرَ لي عن بدرِ تمٍّ مُشرقٍ","أضحَى لَهُ البينُ المشتُّ سرَارَا",91,"ر",2,1],["لأصرفنّ الهمّ عني إن أتى","بذَعْلَبٍ معتادةٍ جِدّ السُّرى",92,"ا",1,0],["لأصبِحَ في السادةِ الأكرمين","أعزّ جُواراً وأعلى مكانا",93,"ن",2,0],["لا صبر لي عن لقا ليلى وإن بعدت","والحب سيان إن يدنو ويبتعد",94,"د",1,0],["لا صام من جعل الصيام","ذريعة للفاجر",95,"ر",1,0],["لا صام كالتمساح أفطر","في شهية غادر",95,"ر",1,0],["لا صام من لم يدر","فلسفة الصيام الثائر",95,"ر",1,0],["لأصبح برد الماء في كل جدول","غساقاً وأضحى ظلها وهو زائل",96,"ل",1,0],["لا صحَّ نشرُ الخزامى في دياركم","كلاَّ ولا اعتلَّ من بعدي نسيمُ صبا",97,"ب",2,0],["لا صَيفُها كانَ ذا زَرع ٍ فَيُطعِمُنا","ولا شِتاها بِذي ضَرْع ٍفَيُرْوينا",98,"ن",2,0],["لا صاحِبٌ إِلّا الَّذي أَعضاؤُهُ","تَحلو لِصاحِبِهِ جَناهُ إِذا جَنى",99,"ن",2,1],["لا صبر إلا إذا كلّت يراعتنا","ولا نراها بحول الله في كلل",100,"ل",1,0],["لا صاحبتني نفسٌ إن هممت لما","أرضى بها غمرات الموت لم تطع",101,"ع",1,0],["لا صحّتِ النّسَماتُ فيه ولا صحَتْ","سَكْرى عُيونِ رجالِه ونِساءِ",102,"ا",2,0],["لا صيام نهاهم لا إمام","طاهر ترب أخمصيه طهور",103,"ر",1,0],["لا صبرَ لِي وكلَّما","أمسكتُ صبراً مَرَقا",104,"ق",2,0],["لا صوتَ فيها للأنيسِ وإنّما","لِعصائبِ الجنَّانِ جَرْسُ عزيفِ",105,"ف",1,0],["لأَصْبرنَّ على ما قد مُنِيتُ به","فالدَّهرُ يومانِ محمودٌ ومذْمُومُ",106,"م",1,0]]}