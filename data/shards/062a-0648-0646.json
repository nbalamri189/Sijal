{"poems":[[66,"غبت وما غبت عن ضميري","https://www.aldiwan.net/poem67642.html","مخلع البسيط"],[68,"تؤنسني الوحدة في خلوتي","https://www.aldiwan.net/poem38537.html","الطويل"],[77,"هنالك عهدي بالخليط المزايل","https://www.aldiwan.net/poem69044.html","الطويل"],[202,"شموس جلتهن النجوم الشوابك","https://www.aldiwan.net/poem51910.html","الطويل"],[310,"تونس الأنس بلدة ميمونه","https://www.aldiwan.net/poem56392.html","الخفيف"],[406,"تونس الخضراء","https://www.aldiwan.net/poem10308.html","عموديه"],[409,"طال التأخر منكم أيها النجب","https://www.aldiwan.net/poem34137.html","البسيط"],[484,"قل معي يا ولدي","https://www.aldiwan.net/poem36926.html","مجزوء الرمل"],[484,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[484,"عارف ما الشعر صاغيه","https://www.aldiwan.net/poem37208.html","مجزوء الرمل"],[484,"أناديها وما لي لا أنادي","https://www.aldiwan.net/poem37581.html","الوافر"],[484,"عاطني يا تونسي في نخبها","https://www.aldiwan.net/poem37603.html","الرمل"],[484,"تونسي وحسبي","https://www.aldiwan.net/poem37610.html","مجزوء الخفيف"],[484,"بلبل في الروض غنى","https://www.aldiwan.net/poem37611.html","مجزوء الرمل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80217","الرمل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80218","الرمل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61176","المتقارب"],[1886,"","https://poetry.dctabudhabi.ae/diwan/poem/130695","الرمل"],[2115,"","https://poetry.dctabudhabi.ae/diwan/poem/116652","الطويل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132014","الرمل"],[5130,"راحة الصب غيبة الرقباء","https://www.poetsgate.com/ViewPoem.aspx?id=152663",""],[5277,"بقايا وحكايا","https://www.poetsgate.com/ViewPoem.aspx?id=188066",""],[5431,"تونس الحب...","https://www.poetsgate.com/ViewPoem.aspx?id=198948",""],[5861,"أنت عيدي","https://www.poetsgate.com/ViewPoem.aspx?id=189721",""],[5956,"تُنسينا السيارة","https://www.poetsgate.com/ViewPoem.aspx?id=193870",""]],"verses":[["تُؤنِسُني بِالنَهارِ حَقّاً","وَأَنتَ عِندَ الدُجى سَميري",0,"ر",2,0],["تُؤنِسُني الوَحدَةُ في خَلوَتي","وَهَذِهِ مِن صِفَةِ العالِمِ",1,"م",1,1],["تُؤنِّسُهُ الهَيجا ويُطرِبُ سَمعَهُ","صريرُ العَوالي في صُدورِ الجَحافل",2,"ل",1,0],["تؤنِّبني فيه العواذلُ ضلَّةً","لتسلكَ بي غيرَ الذي أنا سالك",3,"ك",1,0],["تُونس الأنسِ بلدةٌ ميمونه","وهيَ باللّطفِ في القضاءِ مَصونه",4,"ن",2,1],["تونُسَ الخضراءَ إنْ ناداكِ شعري","واهِنَ الصوتِ ، فهذا ما استطاعا",5,"ع",2,0],["تُونُسَ الخضراءَ إنَّ الظلمَ ليلٌ","سوف يلْقى ،كيفما طالَ ، انقشاعا",5,"ع",2,0],["تونُسَ الخضْراءَ إنَّ الحقَّ غُصْنٌ","مُثْمِرٌ يجنيهِ منْ مدَّ الذِّراعا",5,"ع",2,0],["تؤنسون به من طال شوقهم","فالقلب ملتهب والدمع منسكب",6,"ب",1,0],["تونسي كلنا","وطني أحمدي",7,"ي",1,0],["تونس لي وطن","ما لها بي ثمن",7,"ن",1,0],["تونس تؤرخها","فليعش لها حقها",8,"ه",2,0],["تونسي اليوم توقظه","بينكم ذكرى أهاليه",9,"ي",2,0],["تونس ليس لي في السجن إلا","محبّتك العريقة في فؤادي",10,"د",2,0],["تونس من شرقها لغربها","في ارتياح دل عن عيش هني",11,"ي",1,0],["تونسيّ وحسبي","انّني تونسي",12,"ي",1,1],["تونس للكلّ أمّ","يا بني الأمّ الحنون",13,"ن",1,0],["تونس الخضرا تنادي","لم يضع حقّ لطالب",13,"ب",1,0],["تونسُ الخَضراءُ قَد زادَت سَنىً","بِكَ وَالإِسعادُ قَد عَمَّ البِلاد",14,"د",1,0],["تونس الخَضراء أَهدَتكَ إِلى","أمراء العَصر بِالفَخر أَمير",15,"ر",1,0],["تُؤنس مَن شاءَ تَأنيسها","وَتولي الجَميل لِكُل البَشَر",16,"ر",1,0],["تُونسُ الأنس لها شوقي نما","نزهةُ النفسِ وروحُ النفسِ",17,"س",1,1],["تُؤَنِّبُنِي أَن صُنتُ عِرضِي عِصَابَةٌ","لها بَين أَطنَابِ اللِّئَامِ بصيصُ",18,"ص",1,1],["تونس مدت يديها تحتفي","بابنها البر الذي لا يجهل",19,"ل",1,0],["تونس الأنس زال نقطك من أس","فل فاحو علامة العلياء",20,"ا",2,0],["تؤنِّبُني شموسٌ مظلماتٌ","لها ظفرٌ ونابٌ في الرزايا",21,"ا",3,0],["تونس الحب نفحةٌ شعرية","تتجلى خرافة غيبيّة",22,"ي",2,1],["تونس القلب غيمة الله تهمي","لتلاقي بحبها البشريّة",22,"ي",2,0],["تونس الخير روحها سلسبيلٌ","منه تُسقى عروقها الأرضيّة",22,"ي",2,0],["تؤنبني شراييني وقلبي","بقولٍ زد من الأشواق زيدي",23,"د",2,0],["تُؤنسنا السيارة أنساً","وتحكُّ حوائطنا حكَّا",24,"ك",2,0]]}