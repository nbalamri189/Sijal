],[5963,"إِذا كنتَ وادي النمل","https://www.poetsgate.com/ViewPoem.aspx?id=187379",""],[6082,"سر فرقانا","https://www.poetsgate.com/ViewPoem.aspx?id=60177",""],[6093,"انا لن أعول في الحياة على أحد","https://www.poetsgate.com/ViewPoem.aspx?id=191127",""],[6093,"يا من أطلتم علينا","https://www.poetsgate.com/ViewPoem.aspx?id=198212",""],[6093,"نفاق درب","https://www.poetsgate.com/ViewPoem.aspx?id=203742",""],[6267,"سَأُصْرِمُ لُبْنَى حَبْلَ وَصلِكِ مُجْمِلاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=8345&r=&rc=54",""]],"verses":[["سَأَصبِرُ حَتّى يَعلَمَ الصَبرُ أَنَّني","مَلَكتُ بِهِ دَفعَ الخُطوبِ الهَواجِمِ",0,"م",1,0],["سَأَصبِرُ إِنَّ الصَبرَ مُرٌّ صُدورُهُ","أَلا رُبَّما لَذَّت لِقَلبي عَواقِبُه",1,"ب",2,1],["سَأَصرِمُ فَوزاً وَلا ذَنبَ لي","إِذا ما صَرَمتُ المَذوقَ المَلولا",2,"ل",2,1],["سَأَصبِرُ لا أَشكو إِلَيكِ وَأَكتَفي","بِعلمِكِ أَنّي قَد بَليتُ مِنَ الصَدِّ",3,"د",1,0],["سَأَصرُمُ لُبنى هَبلُ وَصلِكِ مُجمِلاً","وَإِن كانَ صَرمُ الحَبلِ مِنكِ يَروعُ",4,"ع",1,1],["سَأَصبِرُ لِلحِمامِ وَقَد أَتاني","وَإِلّا فَهُوَ آتٍ بَعدَ حينِ",5,"ن",1,1],["سأصْرِفُ عنْ قلْبي مُساعَدَةَ الهَوى","فقدْ كانَ في حوْلَيْنِ منْ ذاكَ ما يكْفي",6,"ف",2,0],["سَأَصبِرُ لِلقَضَاءِ فَكُلُّ حَيٍّ","سَيَلقَى سَكرَةَ المَوتِ المَذُوقِ",7,"ق",1,0],["سأصبر حتى تنتهي مدة الجفا","وما الصبر إلا بعض ما أتجرع",8,"ع",1,0],["سأصبرُ موقناً بوفور حظي","وأجر الصابرين بلا حسابِ",9,"ب",1,0],["سأصون مالك عن يدي","وأصون عرضَك عن لساني",10,"ن",2,0],["سَأَصبِرُ لا أَنّي عَلى ذاكَ قادِرٌ","لَعَلَّ لَيالي هَجرِهِ تَتَصَرَّمُ",11,"م",1,0],["سَأصْبِرُ عَنْكَ وأَعصي الهَوَى","إذا صَبَرَ الحوتُ عن مائِهِ",12,"ا",3,0],["سأصبرُ حتَّى تنجلي كلُّ غُمَّةٍ","وتأتي بما تهواهُ نفسي المقادرُ",13,"ر",1,1],["سَأَصبِرُ حَتّى أُلاقي رِضا","كَ إِمّا بَعيداً وَإِمّا قَريبا",14,"ب",2,0],["سَأَصبِرُ صَبرَ الضَبِّ في الماءِ أَو كَما","يَعيشُ بِدَيمومِ الصَريمَةِ حوتُها",15,"ت",3,0],["سَأَصبِرُ جُهدي لِما أَسمَعُ","فَإِن عيلَ صَبري فَما أَصنَعُ",16,"ع",1,1],["سَأَصبِرُ إِمّا أَن تَدورَ صُروفُها","عَلَيَّ وَإِمّا تَستَقيمُ أُمورُها",17,"ر",3,0],["سَأَصبِرُ لِلمَقدورِ يا أُمَّ مالِكٍ","وَأَعلَمُ أَنَّ الصَبرَ مُرُّ المَذائِقِ",18,"ق",1,0],["سَأَصبِرُ حَتّى يَعلَمَ الناسُ أَنَّني","عَلى نائِباتِ الدَهرِ أَقوى مِنَ الصَخرِ",19,"ر",1,0],["سأصب في سمع الرياح قصائدي","لا أرتجي غنماً ... ولا أتكسب",20,"ب",1,0],["سَأَصرِفُ صَرفَ الحُرِّ عَنهُ مَطامِعي","وَآوي بِهَذا القَلبِ مِنهُ إِلى الياسِ",21,"س",1,0],["سَأَصرِمُ وَصلاً مِن عُلَيَّةَ إِنَّها","صَرومٌ كَما أَوهى كَذوبُ المَواعِدِ",22,"د",1,0],["سَأَصبِرُ حَتّى تَطَّرِحني عَواذِلي","وَحَتّى يَضِجَّ الصَبرُ بَينَ جَوانِبي",23,"ب",2,0],["سَأَصُدُّ حَتّى لا يُقالَ مُتَيَّمٌ","وَأَزورُ حَتّى لا يُقالَ مَلولُ",24,"ل",1,0],["سا صورة أبدع تكوينها","في مطلع الفجر إله الفنون",25,"ن",1,0],["سأصرخ أما هاجت الريح صرخةً","تقول لها الموتى ألا أين نهرب",26,"ب",1,0],["سأصرِفُ نفسي عن مطَامعَ جمةٍ","وإن لم أجد لي قطُّ في الكفِّ درهمَا",27,"م",2,0],["سأصبرُ صبراً يقصرُ الصبرُ دونَه","إلى أنْ يصيحَ الصبرُ مني تألُّمَا",27,"م",2,0],["سأصْبرُ صبراً لا يشاكله صبرُ","وحتى يقولَ الناسُ قلبي له قبرُ",28,"ر",1,1],["سأصبرُ صبراً صبر أيوبَ دونَه","ولا أظهرُ الشكوى ولو مَسَّني الضرُّ",28,"ر",1,0],["سَأَصبِرُ صَبرَ الضَبِّ وَالماءُ ذو قَذىً","وَأَمشي عَلى السَعدانِ وَالذُلُّ مَركَبُ",29,"ب",1,0],["سأصمت حيث لا يصغى لقولي","إذا اختلط النهاق مع الصهيل",30,"ل",1,0],["سأصبر هذا اليوم بالكره جاهدا","لعل انكشاف الهمّ يأتي به غد",31,"د",1,0],["سأصدمُ أحشاءَ الظلامِ بعزمةٍ","ولو فَغَرَتْ فاهاً إليَّ المهالك",32,"ك",1,0],["سأصرعكم جهراً وفاءً لقاضب","حسام كصرف الدهر بل هو أهول",33,"ل",1,0],["سأصبرُ لكن كيف ما كل لوعة","يهوّنها الصب المعذب بالصبر",34,"ر",1,0],["سأصمت كارهاً والصمت حينا","يعدُّ من البراعة في الجواب",35,"ب",1,0],["سأصبِر للأيام صبراً لعلّها","تعود بما أهواه بعد قريب",36,"ب",1,0],["سأصفِيك شكراً ومدحاً إذا","تُنوشِد صَغّر أهلَ العُلا",37,"ا",1,0],["سأصبر فالأيام بؤس ونعمة","وقد يعقب البدر المنير سراره",38,"ر",2,0],["سأصبحُ في ميدانِهِ البطلَ الذي","يصول ولا من صائلٍ أو مبارز",39,"ز",1,0],["سَأَصْحَبُ آمَالي إِلى ابْنِ مُقَلَّدٍ","فَتُنْجِحُ مَا أَلْوَى الزَّمَانُ بِصَاحِبِ",40,"ب",1,0],["سأصبر حتى ينجزَ الله وعده","ولا بدّ للرحمن أنْ ينجزَ الوعدا",41,"د",2,1],["سأصبرُ كرهاً في الهوى غير طائعٍ","لعل زماني بالحبائب آئب",42,"ب",1,0],["سأصبرُ يا حمقاءُ إلّا عن البُكا","وعن ذِكرياتي آه من ذكرياتيا",43,"ي",2,0],["سأَصبر حَتّى لا تَظنَّ عَواذِلي","بِأَنّي أَرى تَعذيبهم لَيسَ بِالعَذبِ",44,"ب",1,0],["سَأُصبِحُ بَعدَها في خَيرِ دارٍ","وَيُصبِحُ فَوقَها في شَرِّ قَبرِ",45,"ر",1,0],["سَأَصبر لِلزَمان وَإِن تَجافى","فَإِن الحُر لِلبَلوى حَمول",46,"ل",1,0],["سأَصرف نَفسي الآن عَن كُل مَطمَع","وَأَزجرها مَهما يُؤديها الزجر",47,"ر",1,0],["سأَصْدَعُ أَحناءَ الضُّلوعِ بِزَفْرَةٍ","تُطيرُ إِلَيْكِ القلبَ لَوْ أَنَّ لي قَلْبا",48,"ب",2,0],["سأصبر أن أطقت الصبر حتى","يمل الصبر أو تهوى الوصالا",49,"ل",2,0],["سأصبر أن أطقت الصبر حتى","تمل الهجر أو تهوى الوصالا",50,"ل",2,0],["سأصبِرُ ما قَدَرتُ على اصطِبَارٍ","إلى أن يَقضِىَ الرحمانُ أمرا",51,"ر",2,0],["سَأَصْرِفُ عَنْكِ يَا دُنْيَايَ وَجْهِي","وَأَبْغِضُ مِنْكَ مَا قَدْ كُنْتُ أَهْوَى",52,"ه",3,1],["سَأَصرف ُالحزن َبعضَ الوقتِ مُتّئِدَاً","وَالحزن ُيُصْرَفُ أحياناً فيَنْصَرِفُ",53,"ف",1,0],["سأصبر للبلوى وإن جلَّ وقعها","فكم دق عندي الخطب وهو جليل",54,"ل",1,0],["سأصبر حتى ليس يُعلم صابِر","كمثلي وهل للعاشقين جُحود",55,"د",1,0],["سَأَصبِرُ باقيَ هذي الحَياة","وَأَيُّ الأَحِبَّةِ مِثلي صَبَرْ",56,"ر",1,0],["سَأصبر حَتَّى تنقضي مدّة الجفا","وَمَا الصبرُ إلاّ مِنْ خِلاَلِي وَحِلْيَتِي",57,"ي",1,0],["سأُصْبِحُ في حُكْمِ الصَّبابةِ عاصياً","عَذولي إِذا لم يُصْبِحِ البيْنُ في حكمي",58,"م",2,0],["ساصرف وقتي في اقتفاء سبيلهم","واتبعهم يا صاح في السهل والوعر",59,"ر",1,0],["سأصفيك ودي حفاظاً لها","فذاك الوفاء بظهر المغيبة",60,"ب",2,0],["سأصبرُ تسليماً إلى الله والفتى","إذا اشتدَّتِ البلوى كذا يتَصبّرُ",61,"ر",1,0],["سأصبِرُ الحرِّ عنك تجلُّداً","إذا لم أنل ممّا أُريدُ الأمانيا",62,"ي",2,0],["سأصبر حتى يأذن اللَه باللقا","ويفتح باباً أغلقته الكواشح",63,"ح",1,0],["سأصبر عن رفيقي إن جفاني","على كل الأذى إلا الهوانا",64,"ن",2,0],["سأصبر للأيام حتى أردها","بصبري لما أرجوه منها حبائلا",65,"ل",2,0],["سَأَصبِرُ حَتّى يَعلَمَ الصَبرُ أَنَّني","أَخوهُ الَّذي تُطوى عَلَيهِ جَوانِحُهْ",66,"ح",2,0],["سأصون عهد محبَّتي","يا ربةَ الحُسنِ البديعِ",67,"ع",1,0],["سأصبِرُ لا أشكو إليكِ صبابتي","ويفعل ربِّي ما يشاءُ ويأمُرُ",68,"ر",1,0],["سأصبر حتى يحكُمَ اللَهُ بَيننا","وإن كنت راحمةً فسوفَ أراكِ",69,"ك",1,0],["سأصبرُ حافظاً للحبِّ عهداً","وأرضى حكم علام الغيوبِ",70,"ب",1,0],["سأصبر إلا عن سَوابقِ عَبرَةٍ","أَرى أبداً جَفني بتصريفها يُغرى",71,"ر",2,0],["سأصبر إن جفوت فكم صبرنا","لمثلك من أمير أو وزيرِ",72,"ر",1,1],["سَأَصبِرُ حَتّى يَحكُمَ اللَهُ بَينَنا","فَأُدرِكَ ثَأري أَو أَموتَ فَأُعذَرُ",73,"ر",1,0],["سأصبر حتى يحكم الله بيننا","ويختار لي ما ليس أختار من أمري",74,"ر",2,0],["سأصرفُ عن آياتٍ كلَّ محققٍ","رجالاً أبوا إلا التبجج بالهزلِ",75,"ل",1,1],["سأصبر من صديقي إن جفاني","على كل الأذى إلا الهوانا",76,"ن",2,0],["ساصبر حتى يرجع الدهر تائبا","وترتد عن دين النفاق الاقارب",77,"ب",1,0],["سأصبر طائعاً وأغض طرفي","وأحفظ عهد مطرحٍ لعهدي",78,"د",2,0],["سَأَصبِرُ للأَمرِ الَّذي جاءَ ناظِري","وَأَعلمُ أَن ما قَدَّرَ اللَهُ واقِعُ",79,"ع",1,0],["سَأَصبِرُ أَو تَأتي المَنيةُ أَو يُرى","يَلينُ لصَبٍّ ذاهبِ الحِسِّ هائِمِ",80,"م",1,0],["سأصبر يا فؤادُ على بعادي","وارضى نارَ وجدك خير زادِ",81,"د",1,0],["سأصدف عن ذكرِ البطالة والصِّبا","إلى الماجد القِرم الهُمامِ السَّميْذَعِ",82,"ع",1,0],["سأصبر صاغراً وأموت غماً","وإن جرعت فيك اليوم سما",83,"م",2,0],["سأصبر دهري ما حييت ومن يعش","بحلو معاش يعقب الحلو مرُّهُ",84,"ر",2,0],["سأصنع أو اصانعها وأَرضى","بسود من صنائعها وبيض",85,"ض",1,0],["سأصنع من غبارهم ثياباً","وألبس إن عَريِتُ عمى العيون",86,"ن",1,0],["سأصفع في القيامة منك وجهاً","إذا قابلت هيكلك الكسيحا",87,"ح",2,0],["سأصبر في الدنيا بنيّ لعلني","ألاقيك في الأخرى وأنت سعيد",88,"د",1,0],["سأصدر انضائي الهجان عن الأذى","إلى مورد تصفو لديه المشارب",89,"ب",1,0],["سأصبِرُ في حربِ الزمان وأهله","وإن جَمَعوا أَعوانهم وتألّبوا",90,"ب",3,0],["سَأصول فيكَ عَلى النَوائِب بَعدَما","كانَت عَليّ النائباتُ تَصولُ",91,"ل",1,0],["سَأَصْحَب سقماً يستوي في ظلاله","عواذرُ وجدي عنده وعواذِلِي",92,"ي",1,0],["سأَصْرِفُ