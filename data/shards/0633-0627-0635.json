{"poems":[[53,"ألا ليت أذيال الغيوث السواجم","https://www.aldiwan.net/poem29766.html","الطويل"],[53,"سأصبر إن الصبر مر صدوره","https://www.aldiwan.net/poem30709.html","الطويل"],[55,"سأصرم فوزا ولا ذنب لي","https://www.aldiwan.net/poem26165.html","المتقارب"],[55,"أهابك أن أشكو إليك وليس لي","https://www.aldiwan.net/poem26415.html","الطويل"],[34,"سأصرم لبنى هبل وصلك مجملا","https://www.aldiwan.net/poem4906.html","الطويل"],[57,"سأصبر للحمام وقد أتاني","https://www.aldiwan.net/poem24619.html","الوافر"],[77,"أشارت غداة البين من خلل السجف","https://www.aldiwan.net/poem35976.html","الطويل"],[41,"أراعك طائر بعد الخفوق","https://www.aldiwan.net/poem42367.html","الوافر"],[72,"لئن ضاع مثلي عند مثلك إنني","https://www.aldiwan.net/poem19190.html","الطويل"],[51,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[51,"يا من قسا لما شكوت","https://www.aldiwan.net/poem66509.html","مجزوء الكامل"],[70,"لنا منكم وعد فهلا وفيتم","https://www.aldiwan.net/poem42722.html","الطويل"],[56,"حبيبي مقيم على نائه","https://www.aldiwan.net/poem58658.html","المتقارب"],[62,"سأصبر حتى تنجلي كل غمة","https://www.aldiwan.net/poem52382.html","الطويل"],[45,"لوت بالسلام بنانا خضيبا","https://www.aldiwan.net/poem10668.html","المتقارب"],[45,"إذا كنت قوت النفس ثم هجرتها","https://www.aldiwan.net/poem62660.html","الطويل"],[49,"سأصبر جهدي لما أسمع","https://www.aldiwan.net/poem64234.html","الكامل"],[66,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[33,"وعار من الأرياش كاس من الهوى","https://www.aldiwan.net/poem25858.html","الطويل"],[33,"وداع دعا إذ نحن بالخيف من منى","https://www.aldiwan.net/poem25907.html","الطويل"],[104,"رسالة المتنبي الأخيرة إلى سيف الدولة","https://www.aldiwan.net/poem26161.html","عموديه"],[81,"أضاع وقاري من علقت جماله","https://www.aldiwan.net/poem61447.html","الطويل"],[50,"أبا كرب كلني لهم المجاهد","https://www.aldiwan.net/poem63946.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9899","الطويل"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5786","الكامل"],[118,"فؤادي من الآمال في العيش مجدب","https://www.aldiwan.net/poem49350.html","الطويل"],[126,"خليلي إن الهم والحزن خيما","https://www.aldiwan.net/poem50509.html","الطويل"],[126,"سأصبر صبرا لا يشاكله صبر","https://www.aldiwan.net/poem50597.html","الطويل"],[141,"لكم أن تجوروا معرِضين وتغضبوا","https://www.aldiwan.net/poem11720.html","الطويل"],[158,"بليت بكل أمعة جهول","https://www.aldiwan.net/poem59082.html","الوافر"],[184,"سهرت وما مثلي ينام ويرقد","https://www.aldiwan.net/poem43910.html","الطويل"],[196,"شموس جلتهن النجوم الشوابك","https://www.aldiwan.net/poem51910.html","الطويل"],[209,"صدقت ولكن كيف تلك رواية","https://www.aldiwan.net/poem46328.html","الطويل"],[209,"سلام على من لا أسميه إنني","https://www.aldiwan.net/poem46610.html","الطويل"],[209,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[227,"ترى الدهر يشفي علتي وكروبي","https://www.aldiwan.net/poem51234.html","الطويل"],[227,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[259,"لئن بعدت عن ناظر الصب داره","https://www.aldiwan.net/poem38144.html","الطويل"],[268,"نظمت ولم أطمع بحسن الجوائز","https://www.aldiwan.net/poem35057.html","الطويل"],[278,"يقيني يقيني حادثات النوائب","https://www.aldiwan.net/poem60788.html","الطويل"],[279,"سأصبر حتى ينجز الله وعده","https://www.aldiwan.net/poem1363.html",""],[301,"تذكرت عيشا مر حلوا بكم فهل","https://www.aldiwan.net/poem58199.html","الطويل"],[326,"أأبكى هوى أم فرحة أم أمانيا","https://www.aldiwan.net/poem55003.html","الطويل"],[351,"قضت ببعادي ربة التيه والعجب","https://www.aldiwan.net/poem40586.html","الطويل"],[364,"لكل مودة أجر وأجري","https://www.aldiwan.net/poem17316.html","الوافر"],[377,"أضر بمقلتي السهر الطويل","https://www.aldiwan.net/poem48829.html","الوافر"],[377,"فؤاد به من فقد أحبابه جمر","https://www.aldiwan.net/poem48833.html","الطويل"],[436,"غرام ولا شكوى وعتب ولا عتبى","https://www.aldiwan.net/poem34828.html","الطويل"],[511,"جعلت فداك قد طال اشتياقي","https://www.aldiwan.net/poem67684.html","الوافر"],[511,"نصحت لكم حذارا أن تعابوا","https://www.aldiwan.net/poem67710.html","الوافر"],[536,"صدعت بحبه من بعد كتمي","https://www.aldiwan.net/poem48161.html","عموديه"],[565,"سأصرف عنك يا دنياي وجهي","https://www.aldiwan.net/poem69477.html","الوافر"]],"verses":[["سَأَصبِرُ حَتّى يَعلَمَ الصَبرُ أَنَّني","مَلَكتُ بِهِ دَفعَ الخُطوبِ الهَواجِمِ",0,"م",1,0],["سَأَصبِرُ إِنَّ الصَبرَ مُرٌّ صُدورُهُ","أَلا رُبَّما لَذَّت لِقَلبي عَواقِبُه",1,"ب",2,1],["سَأَصرِمُ فَوزاً وَلا ذَنبَ لي","إِذا ما صَرَمتُ المَذوقَ المَلولا",2,"ل",2,1],["سَأَصبِرُ لا أَشكو إِلَيكِ وَأَكتَفي","بِعلمِكِ أَنّي قَد بَليتُ مِنَ الصَدِّ",3,"د",1,0],["سَأَصرُمُ لُبنى هَبلُ وَصلِكِ مُجمِلاً","وَإِن كانَ صَرمُ الحَبلِ مِنكِ يَروعُ",4,"ع",1,1],["سَأَصبِرُ لِلحِمامِ وَقَد أَتاني","وَإِلّا فَهُوَ آتٍ بَعدَ حينِ",5,"ن",1,1],["سأصْرِفُ عنْ قلْبي مُساعَدَةَ الهَوى","فقدْ كانَ في حوْلَيْنِ منْ ذاكَ ما يكْفي",6,"ف",2,0],["سَأَصبِرُ لِلقَضَاءِ فَكُلُّ حَيٍّ","سَيَلقَى سَكرَةَ المَوتِ المَذُوقِ",7,"ق",1,0],["سأصبر حتى تنتهي مدة الجفا","وما الصبر إلا بعض ما أتجرع",8,"ع",1,0],["سأصبرُ موقناً بوفور حظي","وأجر الصابرين بلا حسابِ",9,"ب",1,0],["سأصون مالك عن يدي","وأصون عرضَك عن لساني",10,"ن",2,0],["سَأَصبِرُ لا أَنّي عَلى ذاكَ قادِرٌ","لَعَلَّ لَيالي هَجرِهِ تَتَصَرَّمُ",11,"م",1,0],["سَأصْبِرُ عَنْكَ وأَعصي الهَوَى","إذا صَبَرَ الحوتُ عن مائِهِ",12,"ا",3,0],["سأصبرُ حتَّى تنجلي كلُّ غُمَّةٍ","وتأتي بما تهواهُ نفسي المقادرُ",13,"ر",1,1],["سَأَصبِرُ حَتّى أُلاقي رِضا","كَ إِمّا بَعيداً وَإِمّا قَريبا",14,"ب",2,0],["سَأَصبِرُ صَبرَ الضَبِّ في الماءِ أَو كَما","يَعيشُ بِدَيمومِ الصَريمَةِ حوتُها",15,"ت",3,0],["سَأَصبِرُ جُهدي لِما أَسمَعُ","فَإِن عيلَ صَبري فَما أَصنَعُ",16,"ع",1,1],["سَأَصبِرُ إِمّا أَن تَدورَ صُروفُها","عَلَيَّ وَإِمّا تَستَقيمُ أُمورُها",17,"ر",3,0],["سَأَصبِرُ لِلمَقدورِ يا أُمَّ مالِكٍ","وَأَعلَمُ أَنَّ الصَبرَ مُرُّ المَذائِقِ",18,"ق",1,0],["سَأَصبِرُ حَتّى يَعلَمَ الناسُ أَنَّني","عَلى نائِباتِ الدَهرِ أَقوى مِنَ الصَخرِ",19,"ر",1,0],["سأصب في سمع الرياح قصائدي","لا أرتجي غنماً ... ولا أتكسب",20,"ب",1,0],["سَأَصرِفُ صَرفَ الحُرِّ عَنهُ مَطامِعي","وَآوي بِهَذا القَلبِ مِنهُ إِلى الياسِ",21,"س",1,0],["سَأَصرِمُ وَصلاً مِن عُلَيَّةَ إِنَّها","صَرومٌ كَما أَوهى كَذوبُ المَواعِدِ",22,"د",1,0],["سَأَصبِرُ حَتّى تَطَّرِحني عَواذِلي","وَحَتّى يَضِجَّ الصَبرُ بَينَ جَوانِبي",23,"ي",1,0],["سَأَصُدُّ حَتّى لا يُقالَ مُتَيَّمٌ","وَأَزورُ حَتّى لا يُقالَ مَلولُ",24,"ل",1,0],["سأصرخ أما هاجت الريح صرخةً","تقول لها الموتى ألا أين نهرب",25,"ب",1,0],["سأصرِفُ نفسي عن مطَامعَ جمةٍ","وإن لم أجد لي قطُّ في الكفِّ درهمَا",26,"م",2,0],["سأصبرُ صبراً يقصرُ الصبرُ دونَه","إلى أنْ يصيحَ الصبرُ مني تألُّمَا",26,"م",2,0],["سأصْبرُ صبراً لا يشاكله صبرُ","وحتى يقولَ الناسُ قلبي له قبرُ",27,"ر",1,1],["سأصبرُ صبراً صبر أيوبَ دونَه","ولا أظهرُ الشكوى ولو مَسَّني الضرُّ",27,"ر",1,0],["سَأَصبِرُ صَبرَ الضَبِّ وَالماءُ ذو قَذىً","وَأَمشي عَلى السَعدانِ وَالذُلُّ مَركَبُ",28,"ب",1,0],["سأصمت حيث لا يصغى لقولي","إذا اختلط النهاق مع الصهيل",29,"ل",1,0],["سأصبر هذا اليوم بالكره جاهدا","لعل انكشاف الهمّ يأتي به غد",30,"د",1,0],["سأصدمُ أحشاءَ الظلامِ بعزمةٍ","ولو فَغَرَتْ فاهاً إليَّ المهالك",31,"ك",1,0],["سأصرعكم جهراً وفاءً لقاضب","حسام كصرف الدهر بل هو أهول",32,"ل",1,0],["سأصبرُ لكن كيف ما كل لوعة","يهوّنها الصب المعذب بالصبر",33,"ر",1,0],["سأصمت كارهاً والصمت حينا","يعدُّ من البراعة في الجواب",34,"ب",1,0],["سأصبِر للأيام صبراً لعلّها","تعود بما أهواه بعد قريب",35,"ب",1,0],["سأصفِيك شكراً ومدحاً إذا","تُنوشِد صَغّر أهلَ العُلا",36,"ا",1,0],["سأصبر فالأيام بؤس ونعمة","وقد يعقب البدر المنير سراره",37,"ر",2,0],["سأصبحُ في ميدانِهِ البطلَ الذي","يصول ولا من صائلٍ أو مبارز",38,"ز",1,0],["سَأَصْحَبُ آمَالي إِلى ابْنِ مُقَلَّدٍ","فَتُنْجِحُ مَا أَلْوَى الزَّمَانُ بِصَاحِبِ",39,"ب",1,0],["سأصبر حتى ينجزَ الله وعده","ولا بدّ للرحمن أنْ ينجزَ الوعدا",40,"د",2,1],["سأصبرُ كرهاً في الهوى غير طائعٍ","لعل زماني بالحبائب آئب",41,"ب",1,0],["سأصبرُ يا حمقاءُ إلّا عن البُكا","وعن ذِكرياتي آه من ذكرياتيا",42,"ي",2,0],["سأَصبر حَتّى لا تَظنَّ عَواذِلي","بِأَنّي أَرى تَعذيبهم لَيسَ بِالعَذبِ",43,"ب",1,0],["سَأُصبِحُ بَعدَها في خَيرِ دارٍ","وَيُصبِحُ فَوقَها في شَرِّ قَبرِ",44,"ر",1,0],["سَأَصبر لِلزَمان وَإِن تَجافى","فَإِن الحُر لِلبَلوى حَمول",45,"ل",1,0],["سأَصرف نَفسي الآن عَن كُل مَطمَع","وَأَزجرها مَهما يُؤديها الزجر",46,"ر",1,0],["سأَصْدَعُ أَحناءَ الضُّلوعِ بِزَفْرَةٍ","تُطيرُ إِلَيْكِ القلبَ لَوْ أَنَّ لي قَلْبا",47,"ب",2,0],["سأصبر أن أطقت الصبر حتى","يمل الصبر أو تهوى الوصالا",48,"ل",2,0],["سأصبر أن أطقت الصبر حتى","تمل الهجر أو تهوى الوصالا",49,"ل",2,0],["سأصبِرُ ما قَدَرتُ على اصطِبَارٍ","إلى أن يَقضِىَ الرحمانُ أمرا",50,"ر",2,0],["سَأَصْرِفُ عَنْكِ يَا دُنْيَايَ وَجْهِي","وَأَبْغِضُ مِنْكَ مَا قَدْ كُنْتُ أَهْوَى",51,"ه",3,1]]}