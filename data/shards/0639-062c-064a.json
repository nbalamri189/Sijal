1,"سَلام","https://www.poetsgate.com/ViewPoem.aspx?id=215998",""],[5121,"عَجِيب","https://www.poetsgate.com/ViewPoem.aspx?id=216023",""],[5127,"وهبتُكَ ما كانَ لي أقْرَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=177480",""],[5135,"الدُّنْيا","https://www.poetsgate.com/ViewPoem.aspx?id=206225",""],[5225,"رد صاحب السمو الشيخ زايد بن سلطان آل نهيان على قصي","https://www.poetsgate.com/ViewPoem.aspx?id=27613",""],[5246,"نصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=187036",""],[5277,"جوع الغوالي","https://www.poetsgate.com/ViewPoem.aspx?id=185301",""],[5277,"حبيبةٌ مطلسمة","https://www.poetsgate.com/ViewPoem.aspx?id=185608",""],[5277,"مهاةُ بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=193969",""],[5277,"من قصيدةٍ ضائعة","https://www.poetsgate.com/ViewPoem.aspx?id=204983",""],[5277,"مريمُ (ع).. حنينٌ بطعمِ القدسِ..","https://www.poetsgate.com/ViewPoem.aspx?id=206969",""],[5320,"غزال","https://www.poetsgate.com/ViewPoem.aspx?id=41641",""],[5413,"أحبكِ لا تكفي","https://www.poetsgate.com/ViewPoem.aspx?id=200622",""],[5430,"أضاع الحق وااا أسفي ؟؟!!","https://www.poetsgate.com/ViewPoem.aspx?id=1459",""],[5431,"ومازال للعشاق غيمٌ ومرتفعْ!!","https://www.poetsgate.com/ViewPoem.aspx?id=199292",""],[5533,"عَجيبٌ أَمْرُ أُمِّتنا","https://www.poetsgate.com/ViewPoem.aspx?id=176269",""],[5561,"إطلالة على الماضي والحاضر","https://www.poetsgate.com/ViewPoem.aspx?id=197572",""],[5605,"لولا..","https://www.poetsgate.com/ViewPoem.aspx?id=160030",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5675,"يحق لي انصب على أهل المجد ما تم","https://www.poetsgate.com/ViewPoem.aspx?id=170617",""],[5690,"صدقتم لحظهُ لحظ الغزالِ","https://www.poetsgate.com/ViewPoem.aspx?id=172173",""],[5818,"فصام","https://www.poetsgate.com/ViewPoem.aspx?id=182820",""],[5956,"عَجيبٌ أنت يا إكليلَ ورد","https://www.poetsgate.com/ViewPoem.aspx?id=182511",""],[5956,"مناهل إلهامي","https://www.poetsgate.com/ViewPoem.aspx?id=185878",""],[5956,"وكنتُ أعي التوائي في الصعودِ","https://www.poetsgate.com/ViewPoem.aspx?id=186211",""],[5970,"عجيب منك لومك لليالي","https://www.poetsgate.com/ViewPoem.aspx?id=130597",""],[4442,"أرني في العلا نجوم سمائك","https://www.poetsgate.com/ViewPoem.aspx?id=170993",""],[6102,"عَجِيب !!","https://www.poetsgate.com/ViewPoem.aspx?id=184446",""],[6106,"طيفها الساحر !","https://www.poetsgate.com/ViewPoem.aspx?id=6312",""],[6120,"عَجِيبٌ تَجعَلُونَ الهَجرَ حَلًّا","https://www.poetsgate.com/ViewPoem.aspx?id=213522",""],[6147,"مشروع حلال","https://www.poetsgate.com/ViewPoem.aspx?id=151492",""]],"verses":[["عَجِيْتُ مِنَ اثْنَيْنِ اسْتُضيما وَأَجْحَفَتْ","بِقَدْرَيْهِما أَيْدِي الخُطوبِ الفَوادِحِ",0,"ح",1,0],["عَجيبٌ تَزَايَدَ عُشَّاقُهَا","بِقَدْرِ اسْتِطَالَتِهِمْ سِنَّها",1,"ن",3,0],["عجيبة الإسم قيل خمسٌ","وقيل ستٌّ وقيل سبع",2,"ع",1,0],["عجيبٌ كالحبيب له هناتٌ","بها يُشفَى الجوى وبها يُهامُ",3,"م",1,0],["عَجيبٌ مَشيبِيَ قَبلَ الأَوانِ","وَأَعجَبُ أَن لا أَرى أَشيَبا",4,"ب",2,0],["عَجيبٌ أَن تَكونَ كَذا ضَنيناً","وَلَم تُبصِر بِنا إِلّا جَوادا",5,"د",2,0],["عَجيبٌ أَن تَعيشَ بِنا الأَماني","وَأَنّا لِلأَماني نَستَكينُ",6,"ن",1,0],["عجيبة أموره","والصحف منه أعجب",7,"ب",1,0],["عَجيبٌ رَداكَ وَأَعجَبُ مِنهُ","حَياتُكَ في طولِها وَالقِصَر",8,"ر",1,0],["عَجيبٌ تَركُكَ الدُنيا سَقيماً","وَكُنتَ النَحلَ تَملَؤُها شِفاءَ",9,"ا",2,0],["عَجيبٌ يُرَجّى مِشرَطاً أَو يَهابُهُ","مَنِ الغَربُ راجيهِ مَنِ الشَرقُ هائِبُه",10,"ب",2,0],["عَجيبٌ في الزَمانِ وَما عَجيبٌ","أَتى مِن آلِ سَيّارٍ عَجيبا",11,"ب",2,0],["عَجيبةٌ قد حارَ فيها الوَصْفُ","عِشرونَ حرفاً عَدُّها وحَرْفُ",12,"ف",1,0],["عجيبٌ من الأميِّ علم وحكمة","تضاءَل عن مرماهِمَا العُلماءُ",13,"ا",2,0],["عجيبة يا ريح ماذا جرى ؟","تشابه الميلاد ، والانتحار",14,"ر",1,0],["عجِيب له كيف لم يوِهِه","فقالوا صدقتَ لهذا عثر",15,"ر",1,0],["عجيب مشيبي قلب الأوان","وأعجب أن لا أرى أشيبا",16,"ب",2,0],["عَجِيبٌ أنتَ يا شِعْري","ويا تَسبيحَ قِيثاري",17,"ر",2,0],["عجيبٌ والعجائبُ بعدُ شتَّى","بأنّا في الورى شيءٌ عجابُ",18,"ب",1,0],["عَجيجُ المُذَكّي رَأى إِلفَهُ","تَرَوَّحَ في صادِرٍ مُحنِجِ",19,"ج",1,0],["عَجيبٌ منَ المَوتِ أَفعالُه","وَعَتبى على فعلِهِ أعجَبُ",20,"ب",1,0],["عَجيبٌ من الزَّهراءِ كُتمانُ سِرّها","بأنوارِها حَيثُ المُنجّمُ حائر",21,"ر",1,0],["عَجيجَ المُذَكّي شَدَّهُ بَعدَ هَدأَةٍ","مُجَحدِلُ آفاقٍ بَعيدُ المَذاهِبِ",22,"ب",1,0],["عجيب لمن يوصي سواه وإنه","لأجدر منه باتباع الوصية",23,"ه",1,0],["عجيب أيحدوني إليك حنين","وفي همساتي زفرة وأنينُ",24,"ن",1,1],["عَجيبةٍ تُضرَبُ في الهواء","بصَولَجَانٍ صادقِ الإيماء",25,"ا",2,0],["عجيبٌ أنك العذراء حبلى","برب قد تعالى في العجائب",26,"ب",1,1],["عَجيبٌ وَكَم لَزَورَتِهِ الدُجى","فُؤاداً سَقيماً أَو يَكونُ طَبيبُ",27,"ب",1,0],["عجيب له كيف ادعى الحب كاذباً","وأبرز في ضد الذي قال برهانا",28,"ن",2,0],["عُج يا نديم على الكؤوس ميمِّماً","وأدِر عليَّ سلافة الصهباء",29,"ا",2,0],["عجيباً لمغرور بدنيا دنية","سلامته منها ثأى وتغبط",30,"ط",1,0],["عجيباً ما تهد به الرواسي","وتحمله المفاصل والعروق",31,"ق",1,0],["عجيباً لميت يبك ميتاً وميتا","يعزيه ميت ثم في ميت مؤد",32,"د",1,0],["عجيب لمن يسعى إلى سجر مائه","براحته مع علمهِ أنها البحر",33,"ر",1,0],["عجيب لمن ذاق الهوى وهو عاقل","عجبت لطير صاد وهو مبرقع",34,"ع",1,0],["عجيب يغيض النهر في فيضانه","ويغرب بدر الأفق في ذلك القبر",35,"ر",1,0],["عجيب عجيب منك هذا فما الذي","دعاك إلى هذا وأنت تحقق",36,"ق",1,0],["عُج يا رُعيتَ بالعذيب فالقنا","فالمعهد الأيمن من وادي قبا",37,"ا",1,1],["عجيبة نظم ليس يدخل ربّها","إذا عجب الأقوام من حسنها عجب",38,"ب",1,0],["عَجِيباً لَهَا تَبدو وَتَخْفَى وإنَّمَا","تَسِيرُ عَلَى الحَالَينِ سَيْرَ الذَّوائِبِ",39,"ب",1,0],["عجيب ان سيفك ليس يروي","وسيفك في الوريد له ورود",40,"د",1,0],["عَجيباً فُنونُ الحُسنِ يَعشَقها الفتى","وكلُّ امرىءٍ يَهوى الجمالَ له الحقُّ",41,"ق",1,0],["عجيباً أراها وقد عبست","وكادت تبوحُ بِمُرِّ الكلام",42,"م",1,0],["عجيبان بالدارين في نسل آدم","لقد ضل عقلي فيهما يا منادي",43,"ي",1,1],["عجيبا عجيبا يا بنى الحب فانظروا","فقد أضحت الآساد في قبضة المها",44,"ه",2,0],["عجيب موسم الأشعار عندي","يجيء الشعر فيه بلا طلاب",45,"ب",1,1],["عجيب أنهم يأتون توّاً","الي ويتركون الموسرينا",46,"ن",2,0],["عجيب أنت يا ربي حكيم","وفي كفيك ميزان القضاء",47,"ا",2,0],["عجيبٌ لخلّ بدا بالصدود","وكان حقيقا بحفظ العهود",48,"د",1,1],["عجيب لهذا الجيل في طول صبره","على الجهل حتى أصبح الجهل باسما",49,"م",2,0],["عَجيبُ وضعٍ غَريبٌ في تصرُّفِهِ","حتىّ ليُحسَبُ موضوعاً من الجانِ",50,"ن",1,0],["عجيب منك أن تحي سعيداً","وجسمي قد أذابته القفار",51,"ر",1,0],["عجِيبٌ في مَعانيهِ","غريبٌ في مَزَاياهُ",52,"ا",2,0],["عجيزته صارت عجوزاً هزيلةً","وليس صبائي من هواها بمنسل",53,"ل",1,0],["عجيبٌ يا حمار الحج يدعو","عليك بطردك الجمُّ الغفير",54,"ر",1,0],["عجيب لمن يدعي للولا","وعلم الحقيقة في المدرس",55,"س",1,0],["عج يا نسيم معطّر الأنفاسِ","سحراً ببغدادٍ حمى الأكياسِ",56,"س",1,1],["عجيبٌ من تجاهله بحالي","أَلا تتعجبون أَيا ندامى",57,"م",2,0],["عَجيبٌ مِن عُيونك وَهيَ سَكرى","فعالُ السحر ما بين الأَنامِ",58,"م",1,1],["عجيبٌ لعمري موتُ كلِّ محبَّب","إلينا وقد كان التعجب أعجبا",59,"ب",2,0],["عجيب لخال بخديه إذ","بنار الجحيم استطاب القرارا",60,"ر",2,0],["عَجيجُهُ صَيّاح","كَالبوقِ في الآذان",61,"ن",1,0],["عَجيبا أَتَبكي بعد أن كنت ضاحِكا","وَتسكب ذاكَ الدمع هَذا المؤمل",62,"ل",1,0],["عَجيب بِبَحر الزين وَدَعى وَاِنَّها","لأَبعَد مِن زين كَبُعد الكَواكِب",63,"ب",1,0],["عجيب جمالها للسحر سحرٌ","أتعجب أن سبى مني شعوري",64,"ر",2,0],["عجيب فعال أوهنت كلّ ضيغمٍ","مخالبها أمتدت على غير صورةِ",65,"ه",1,0],["عَجيب أَنتَ يا قَلبي فَكَم ذا","يَهيب بِكَ الجَماك وَتَستَجيب",66,"ب",1,1],["عجيب ما تراه العين","أم منها يرى العجب",67,"ب",1,0],["عجيبةٌ تلك لا (خَضْرٌ) يفسِّرُها_","ولا سمعْنا بها في سورة الكهفِ",68,"ف",1,0],["عجيبه !! كيف هالدنيا ؟؟ تغير حالنا بالفور","لقيت الدانه اللي لي تنهل من عشق ثاني",69,"ن",2,0],["عَجيبة كيف لي قِدرة أناور ظلمة اوقاتي","واسايرها.. واحاورها .. بحيث انها تسليني",70,"ن",2,0],["عَجيبٍ حَالِنا والله .. ضَعيفٍ صَعبِ مَهزومي","كَئيبٍ بَاردٍ يا قَلب .. وذابَت كِلِ ألوانِه",71,"ن",2,0],["عجيب أمرنا حين اعترفنا","\"سيقتلنا الحنين\" وما اكتفينا",72,"ن",2,0],["عَجيبٌ أَمركُم يَا مَنْ لَبِستُم","لِباسَ الدِّينِ، يَا لَها مِن ثيابِ!!",73,"ب",1,0],["عجيبٌ أمرُ هذا القلب لما","تيقنَ منكَ بالإعتاق همَّا",74,"م",2,0],["عجيب تبكي الأسباب","وأسّبابكْ .. لترميني",75,"ن",2,0],["عَجِيبٌ أَمْرُهُا لَوْ كُنْتَ تَدْرِي","وَأَعْجَبُ مِنْهُ مَا أَبْقَتْ وَأَلْقَتْ",76,"ت",1,0],["عجيبة ذي الدّنيا أنا لم تر الورى","على حالتي في هذه الأرض من شكلي",77,"ل",2,0],["عَجِيبٌ حِينَمَا الرُّوحُ اسْتَهَامَت","أَذَابَ الشِّعْرَ فِي قَلْبِ الْوِفَاقِ",78,"ق",1,0],["عَجِيباً خُلِقْتَ وَلَيْتَكَ تَدْرِي","بِأَنِّي الْعَجَائِبُ بِنْتُ الْعَجَبْ",79,"ب",1,0],["عَجِيباً غَرِيباً مِنَ الشِّعْرِ تَأْتِي","فَمَيْلُ الْكَلَامِ بَلِيغُ احْتِفاءِ",80,"ا",2,0],["عَجِيبٌ أَنْتَ بِالشِّعْرِ الْفُجَائِي","كَنَجمٍ فِي سَمَاءِ القَولِ تَظْهَرْ",81,"ر",1,0],["عجيبٌ مِن القلبِ ما آلهُ","وجادَكَ دونَ الأنا مَأْرَبُ",82,"ب",1,0],["عَجِيْبٌ حَالُ ذِيْ الدُّنْيَا","ومَنْ في شَأْنِهَا يَسْعَى",83,"ع",2,1],["عجيد اليازياتْ اللّي سريحهْ","رعى عشب الشّوامخ في الرّوابي",84,"ب",2,0],["عجيب لأمر المرء لا يتفكرُ","وليس على النعماء لله يشكر",85,"ر",1,1],["عجيباتٌ ليالينا وإنّي","بهنَّ العمرَ مرخيَّ الحبالِ",86,"ل",1,0],["عجيبٌ..والعجيبُ يرقُّ قلبي","وفيه جراحُها أبداً ثقالُ",87,"ل",1,0],["عجيبةٌ كلُّ ما فيها يؤرِّقُها","وكلما آذنتْ عشقاً بها شَرِقا",88,"ق",2,0],["عجيبٌ..تشتكي مني غرامي","وقد كانتْ موسوسةً مَلولا",89,"ل",2,0],["عجيبٌ أمرُ هذا القلبِ عندي","حبيسُ الشوقِ من خلُقٍ ودينِ",90,"ن",1,0],["عجيب لخمر توارى العقول","ولكنها رغم سكر حلال",91,"ل",1,0],["عجيييييبٌ ولكنْ مَنْ رآكِ أمامهُ","ولو فاقَ سحبانًا سَيُصْبِحُ أَعْجَما",92,"م",2,0],["عجيبٌ أمركم قومي","أما ترضون بالقمم؟",93,"م",1,0],["عجيبٌ هيام الروح حين اشتعاله","يُقيم على الفن الطقوس بلا ورعْ",94,"ع",1,0],["عَجيبٌ أَمْرُ أُمِّتنا","فمَقْتولٌ ومَخْدوعُ",95,"ع",1,0],["عجيبٌ سكوتُ الناسِ عمّا يُحيطُهمْ","وأعجبُ منه الظلمُ يُظلمُ أبصارا",96,"ر",2,0],["عَجِيب ٌ فَهَذَا الحُرُ بالعَبدِ يَقتَدِي","وهذا زَعِيمُ الجيش ِشِيمَتُهُ الغَدرُ",97,"ر",1,0],["عجيبة تلكم الأرواحُ يُفْزعُها","أنْ تُبصر النورَ فوقَ الأرْضِ ينْعقدُ",98,"د",1,0],["عجيد أصياح منهم أبد ما تم","بس أديارهم أمست خليه",99,"ه",1,0],["عجيبٌ كلما مُيعت تحالت","وأحلى الحب ممنوع الوصالِ",100,"ل",1,0],["عجيب كيف تعشق صيد طير","أصياد القلوب بلا نبالِ",100,"ل",1,0],["عجيبٌ أمر مَن يَهَبُ العطايا","وينشرُ ها هنا بعضَ الوصايا",101,"ي",2,1],["عجيبٌ أنت يا إكليلَ وردٍ","تعطّرني وتعرف قدر ودّي",102,"د",2,0],["عجيبٌ فما ينبوعُ فني سوى الغنا","كمثل فريدٍ أو حليمٍ ترنّما",103,"م",2,0],["عجيبٌ لم أكن أخشى المعاني","أصوّر ما أشاء بلا قيودِ",104,"د",1,0],["عجيب منك لومك لليالي","وسمع اللوم من بعض المحال",105,"ل",1,1],["عجيبا يا شباب والجهل عر","بك لم لا يفر من عدوائك",106,"ك",1,0],["عَجِيبٌ أَنَّ فِينا مَنْ يُباهِي","بِلَسعِ البَردِ فِي زَمَنِ اللَّهِيبِ !",107,"ب",1,0],["عَجِيبٌ أَنَّ ضَربَ الآلِ دامٍ","وَ ضَربَ غُزاتِنا مِثلُ الزَّبِيبِ !",107,"ب",1,0],["عَجِيبٌ أَمرُ هَذا العَصرِ ! تَبًّا","عَجِيبٌ ! بَلْ وَ أَكثَرُ مِنْ عَجِيبِ !",107,"ب",1,0],["عجيب أمر روحك يا مرادي","يطوف بهيكلي فأشم عطرا",108,"ر",2,0],["عَجِيبٌ تَجعَلُونَ الهَجرَ حَلًّا","أَحَقًّا لا تَرُونَ الهَجرَ عَيبَ",109,"ب",1,1],["عجيباتٌ.. عيونٌ تستبيني","تُقتّلني. ويُرعبها القتال",110,"ل",1,0]]}