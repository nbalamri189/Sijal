,""],[90,"عقابيل داء","https://www.poetsgate.com/ViewPoem.aspx?id=179142",""],[90,"في الليل","https://www.poetsgate.com/ViewPoem.aspx?id=178935",""],[45,"يا يَوْمُ عَرّجْ بَلْ وَرَاءَكَ يا غَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=31631",""],[5,"معلقة عمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=11411",""],[80,"أين مني عتبُ أحبابٍ هجود","https://www.poetsgate.com/ViewPoem.aspx?id=3156",""],[91,"ومليحة","https://www.poetsgate.com/ViewPoem.aspx?id=53483",""],[51,"لا تَهُولنَّكَ شمسٌ كسفَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=26834",""],[105,"لبيك من حر المواقف عال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55000&r=&rc=170",""],[85,"بني مصرٍ مكانكموُ تهيَّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9731&r=&rc=221",""],[85,"يموت في الغابِ أو في غيرِه الأسدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9599&r=&rc=89",""]],"verses":[["نَشَدتُكُما أَن تَضُماني ساعَةً","لَعَلّي أَرى النارَ الَّتي تَرَيانِ",0,"ن",1,0],["نَشَرتُ عَلى الزَمانِ وِشاحَ عِزٍّ","تَرَنَّحُ دونَهُ المُقَلُ الرَواني",1,"ي",1,0],["نَشءُ مُزنٍ كَأَنَّ في الأُفقِ مِنهُ","نَفَسَ القَينِ في الحُسامِ اليَماني",2,"ن",2,0],["نَشَزَ الجَنيبُ عَلى ثَنِيّاتِ الهَوى","وَنَجَوتُ مَرمِيّاً إِلَيَّ زِمامي",3,"م",2,0],["نَشوانَةُ الأَعطافِ مِن دَمِ فِتيَةٍ","فيهِم صَبوحٌ لِلرَدى وَغَبوقُ",4,"ق",1,0],["نَشَدتُكُمُ هَل زالَ مِن بَعدِ أَهلِهِ","زَرودٌ وَرامَتهُ طُلولٌ وَأَربُعُ",5,"ع",1,0],["نِشاصُ الثَرَيّا كُلَّما هَبَّ بَرقُهُ","تَذَبذَبَ يُزجي عارِضاً مُتَرَفِّعا",6,"ع",2,0],["نَشَدَ التَصابي بَعدَ ما ضاعَ الصِبا","غَرَضاً لَعَمرُكِ يا أُمَيمَ بَعيدا",7,"د",2,0],["نَشَدتُكُمُ اللَهَ فَليُخبِرَنَّ","مَن كانَ أَقرَبَ بِالرَملِ عَهدا",8,"د",2,0],["نَشَرتَ مِنها خِماراً في الفَخارِ طَوى","مَعَ النَوائِبِ تيجانَ الصَناديدِ",9,"د",1,0],["نَشَرنا عَلى عَذَباتِ الرِيا","حِ كُلَّ لِواءٍ صَقيلِ النَواحي",10,"ح",2,0],["نُشاقُ إِلى أَوطانِنا وَتَعوقُنا","زِياداتُ سَيرٍ ما حَسِبنا حِسابَها",11,"ب",3,0],["نَشوانَةُ اللّحَظاتِ تُرْسِلُ نَظْرَةً","عَجِلَتْ بِها كالشّادِنِ المَطْروفِ",12,"ف",1,0],["نَشَزَتْ عَرانينُ العُداةِ على البُرى","فأذَلّها بأزِمّةٍ وخِشاشِ",13,"ش",1,0],["نُشِرَتْ رَفارِفُ دِرْعِهِ عنْ ضَيْغَمٍ","يَحْمي الحقيقَةَ والأسِنَّةُ غِيلُ",14,"ل",1,0],["نَشَرَ الصّباحُ بِها الجَناحَ ورَقْرَقَتْ","فيها منَ الشَّفَقِ النُّضارَ أصائِلُ",15,"ل",1,0],["نشأَتْ قَناتُكَ في فُروعِ هَوازِنٍ","ريّا المَعاقِدَ لا تُسِرُّ وُصوما",16,"م",2,0],["نشأنَ وظِئْراها القَواضِبُ والقَنا","لَديْكُمْ وتِرْباها الكَواكِبُ والدَّهْرُ",17,"ر",1,0],["نشرت عدل التساوي في الورى","فعلا الإنسان فيها وتسامى",18,"م",2,0],["نشيد منّي أمّة","تهدي إلى العليا وتهدي",19,"ي",1,0],["نَشكو الظَماءَ وَما نَشكوه عَن عَطَشٍ","لَكِن لِغُلَّةِ قَلبٍ باتَ مَحزونا",20,"ن",2,0],["نَشَدتُكُم عَلِّلوني","إِن لَم يَكُن تَنويلُ",21,"ل",1,0],["نشَدْتُكَ اللهَ نسيمَ الصَّبا","إنْ جِئْتَ في تَسْيارِكَ الأجْرَعا",22,"ع",2,0],["نَشْرَتَ لِوَاءَ الدِّينِ حِينَ طَوَيْتَهاَ","مَرَاحِلَ غَزْوٍ مِنْكَ فِي نَصْرِ آلِهِ",23,"ل",2,0],["نشَرْتَ بها ما قد طوَيْتُ بساطَهُ","زَماناً ولي طيُّ الأمورِ مع النّشْرِ",24,"ر",1,0],["نَشَدْتُكَ يا رَكْبَ الحِجازِ تضاءَلَتْ","لكَ الأرْضُ مهْما اسْتَعْرَضَ السَّهْبُ وامْتَدّا",25,"د",2,0],["نشَدْتُكَ هلْ أبْصَرْتَ قَبْلي أوْ بَعْدي","مُقوَّرَةً قوْراءَ كالقَمَرِ السّعْدِ",26,"د",1,1],["نَشَدْتُكُما باللّهِ هلْ تُبْصِرانِها","مَعالِمَ محّتْها الغَمائِمُ منْ بَعْدي",27,"د",2,0],["نَشَدتُكَ بِاللَهِ الَّذي حَولَ بَيتِهِ","بِمَكَّةَ حَيٌّ مِن لُؤيِّ بِن غالِبِ",28,"ب",1,1],["نَشاوى نَديمُ الكَأَسِ مِنا مُرَنَّحٌ","وَعَيسٌ مُناخاتٌ عَلَيهِنَّ أَرحُلُ",29,"ل",1,0],["نَشفى بِها وَهيَ داءٌ لَو تُصاقِبُنا","كما اِشتَفى بِعِيادِ الخَمرِ مَخمورُ",30,"ر",1,0],["نَشءَ مِصرٍ نَبِّئوا مِصراً بِكَم","تَشتَرونَ المَقصِدَ الأَسمى بِكَم",31,"م",1,0],["نُشِرَت عَلَيهِ غِلالَةٌ","بَيضاءُ حاكَتها الغُيومُ",32,"م",1,0],["نَشَرتَ فَضلَ كِرامٍ في مَضاجِعِهِم","جَرَّ الزَمانُ عَلَيهِم ذَيلَ نِسيانِ",33,"ن",1,0],["نَشُقُّ بِها رُؤوسَ القَومِ شَقّ","وَنُخليها الرِقابَ فَتَختَلينا",34,"ن",2,0],["نَشيمُ بَروقَ المُزنِ أَينَ مُصابُهُ","وَلا شَيءَ يُشفي مِنكِ يا اِبنَةَ عَفزَرا",35,"ر",2,0],["نَشيمُ عَلى أَرضِ اِبنِ لَيلى مَخيلَةً","عَريضاً سَناها مُكرَهِفّاً صَبيرُها",36,"ر",3,0],["نَشَأْتُ أَرْعَاهُ إِكْبَاراً وَأُكْرِمُهُ","وَظَلَّ يُكْرِمُنِي لُطْفاً وَيَرْعَانِي",37,"ن",2,0],["نَشَدْتُمُ العِلْمَ فِي دِيَارٍ","عَزِيزٌ اليَوْمَ أَنْ تُرامَا",38,"م",2,0],["نَشاصُ الدَلوِ أَو مَطَرُ الثُرَيّا","إِذا اِرتَجَزَت عَلى إِثرِ السُعودِ",39,"د",1,0],["نشاوى غَرامٍ يستميل رؤُوسهم","من النّوم والشوق المبرِّح سُكرانِ",40,"ن",1,0],["نشر الأزاهر بعدما نظم الندى","يا حسن ما نظم النسيم وما نَثَرْ",41,"ر",1,0],["نشر الهيب على البيوت ملاءة","حمراء تصفق جانبَيها الريح",42,"ح",1,0],["نشؤوا بها مثل العقارب دأبها","نفث السموم فمن هناك ومن هنا",43,"ن",2,0],["نشرنا لها من لفيف اشتياقنا","ونحن إناس نُحس النشر واللفّا",44,"ف",2,0],["نَشدت بشعري مطلباً عَزّ نَيْله","وأن هان عند الشعر ما كنت أنشُد",45,"د",1,0],["نشرب ماء الظنون عبّاً","فلم نَعد منه بارتواء",46,"ا",2,0],["نُشَرِّفُ عادِيّاً مِنَ المَجدِ لَم تَزَل","عَلالِيُّهُ تُبنى عَلى باذِخٍ صَعبِ",47,"ب",1,0],["نُشِرَت عَلَيكَ فَبَشَّرَت بَعدَ البِلى","ريحٌ يَمانِيَةٌ بِيَومٍ ماطِرِ",48,"ر",1,0],["نَشينُ صِحاحَ البيدِ كُلَّ عَشِيَّةٍ","بِعوجِ السَراءِ عِندَ بابٍ مُحَجَّبِ",49,"ب",1,0],["نَشيلٌ مِنَ البيضِ الصَوارِمِ بَعدَما","تَفَضَّضَ عَن سيلانِهِ كُلُّ قائِمِ",50,"م",1,0],["نَشَرَ الزَمانُ عَلَيهِ بَعدَ أَنيسِهِ","حُلَلَ الفَناءِ وَكُلُّ شَيءٍ فانِ",51,"ن",1,0],["نَشَدتُكَ اللَهَ لاتَسمَح بِنَفسِ عُلاً","حَياةُ صاحِبِها تَحيا بِها الأُمَمُ",52,"م",1,0],["نَشيدُ كَما شادوا وَنَبني كَما بَنَوا","لَنا شَرَفٌ ماضٍ وَآخَرُ حاضِرُ",53,"ر",1,0],["نُشَرِّدُهُم ضَرباً كَما شَرَّدَ القَطا","وَنَنظِمُهُم طَعناً كَما نُظِمَ العِقدُ",54,"د",1,0],["نَشَدتُ بَني النَجّارِ أَفعالَ والِدي","إِذا لَم يَجِد عانٍ لَهُ مَن يُوازِعُه",55,"ع",2,1],["نَشرَبُها صِرفاً وَمَمزوجَةً","ثُمَّ نُغَنّى في بُيوتِ الرُخام",56,"م",1,0],["نشوان من خمر الصبى ودلالهِ","فإذا تثنى أو تجنى عرْبدا",57,"د",2,0],["نشرَ الخُبر","من الخبر",58,"ر",1,0],["نشأ النوال الأفضليّ فلم نسل","في الأفق هل نشأ الغمام المغدق",59,"ق",1,0],["نشيطة العطف كحلا الطرف لو كحلت","لم يرفع الميل جفنيها من الكسل",60,"ل",1,0],["نشرت لك الأعراب فيما طويته","من الودِّ يا أوفى الأنام ذماما",61,"م",2,1],["نشأت بغيل الأسد يرضعها الحيا","فلذاك تقسو تارةً وتلين",62,"ن",1,0],["نشرت قريضي بعد ما قد طويته","وأغديته بعد امتناع طويّه",63,"ي",2,0],["نشير حول الملك المنصور","كالشهب حول القمر المنير",64,"ر",1,0],["نشدتكُمُ أن تظلموني وتُسكِنوا","جوى الحقد أضلاعاً على حبِّكم تُحْنَى",65,"ن",2,0],["نَشَّرَ آذارُ في الثرى حُللاً","قد كان كانونُ قبلُ طواها",66,"ا",3,1],["نشرت على الدنيا شعاعاً أضاءها","وكانت ظلاماً مُدلهِمَّ الغياهبِ",67,"ب",1,0],["نُشوبَ الشَّجا في الحلق لا هو سائغ","ولا هو ملفوظ كذا كلُّ ناشِب",67,"ب",1,0],["نشرتْ أسرةَ كسرى","دَسْتبْدا في دَوار",68,"ر",1,0],["نشوان من أريحيات الندى ثمِلٌ","لا من عصارة كَرْم بنت أعصار",69,"ر",1,0],["نشرتك من موت الخمول بقدرةٍ","لما هو أدهى لو علمت وأنكر",70,"ر",1,0],["نَشرتَهُمُ عن حسن فعلٍ فعلتَه","فواتِحُهُ موصولةٌ بالخواتمِ",71,"م",1,0],["نشكو إلى الله جهلاً قد أضرَّ بنا","بل ليس جهلاً ولكن علم مفتون",72,"ن",1,0],["نشدتُكَ يا سلامةُ لِمْ وأنَّى","زَمَرْتَ وكنتَ تعرفُ بالأغاني",73,"ي",1,0],["نَشَأتُ عَسيراً لَم تُدَيَّث عَريكَتي","وَلَم يَعلُ يَوماً فَوقَ ظَهري كورُها",74,"ر",3,0],["نُشَيبَةُ لَم توجَد لَهُ الدَهرَ عَثرَةٌ","يَبوحُ بِها في ساحَةِ الدارِ ناطِقُ",75,"ق",1,0],["نَشَرَ الطُيوبَ عَلى دُروبِ حَياتِهِ","وَسَرى هَوىً في الطيبِ وَالأَنداءِ",76,"ا",2,0],["نَشَزَ الجَواري وَالإِماءُ تَمَرَّدَت","وَوَنَت فَلَم تَنشُز وَلَم تَتَمَرَّدِ",77,"د",1,0],["نَشتاقُها في بُؤسِنا وَنَعيمِنا","وَنُحِبُّها في بُؤسِها وَنَعيمِها",78,"م",3,0],["نَشتاقُهُ وَالصَيفِ فَوقَ هِضابِهِ","وَنُحِبُّهُ وَالثَلجُ في وادِهِ",79,"ه",1,0],["نَشوانُ يَهُزُّهُ دَلالٌ","كَالغُصنِ مَعَ النَسيمِ مائِل",80,"ل",1,0],["نَشوانُ مِن خَمرِ الدَلا","لِ غَبوقُهُ وَبِها صَبوحُه",81,"ح",2,0],["نَشَحتُ بِها عَنساً تَجافى أَظَلُّها","عَنِ الأُكمِ إِلّا ما وَقَتها السَرائِحُ",82,"ح",1,0],["نَشَرناهُمُ أَيّامَ إِثبيتَ بَعدَما","شَفَينا غِلالاً بِالرِماحِ العَواتِرِ",83,"ر",1,0],["نشوانَ بالقلبِ الكئيب الدَّامي","أَلمعبدُ الحيُّ المقدَّسُ ها هنا