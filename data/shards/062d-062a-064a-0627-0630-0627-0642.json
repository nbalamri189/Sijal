{"poems":[[79,"يا ربة البيت الممنع جاره","https://www.aldiwan.net/poem36516.html","الكامل"],[10,"كنا كغصنين في جرثومة بسقا","https://www.aldiwan.net/poem21094.html","البسيط"],[32,"أإن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29580.html","البسيط"],[49,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[53,"راع فؤادي منك ما راعه","https://www.aldiwan.net/poem65408.html","السريع"],[53,"متهلل زجل تحن رواعد","https://www.aldiwan.net/poem65503.html","الكامل"],[31,"هل تعرف اليوم من ماوية الطللا","https://www.aldiwan.net/poem6034.html","البسيط"],[31,"تغير الرسم من سلمى بأحفار","https://www.aldiwan.net/poem6035.html","البسيط"],[93,"في ذلك الروض الأغن بدى فتى","https://www.aldiwan.net/poem8735.html","عموديه"],[40,"يا أهل ما بال هذا الليل في صفر","https://www.aldiwan.net/poem7718.html","البسيط"],[91,"حملته بين احشائي بلا برم","https://www.aldiwan.net/poem44857.html","البسيط"],[45,"ومنزل ليس لنا بمنزل","https://www.aldiwan.net/poem10111.html","الرجز"],[63,"لامت قبلك يا أخي لا باخلا","https://www.aldiwan.net/poem51287.html","الكامل"],[2,"لقد لحقت بأولى الخيل تحملني","https://www.aldiwan.net/poem25026.html","البسيط"],[51,"يا ابن العلاء ويا ابن القرم مرداس","https://www.aldiwan.net/poem64223.html","البسيط"],[68,"ما ماس منعطفا في قرطق وقبا","https://www.aldiwan.net/poem39203.html","البسيط"],[82,"هذا ابتداء له عند العلى خبر","https://www.aldiwan.net/poem31433.html","البسيط"],[76,"ركضوا الجياد إلى الجلاد صباحا","https://www.aldiwan.net/poem12884.html","الكامل"],[107,"يا ناقض العهد لا شكوى ولا أسف","https://www.aldiwan.net/poem43988.html","البسيط"],[42,"قد رابه ولمثل ذلك رابه","https://www.aldiwan.net/poem42339.html","الكامل"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[54,"رأيت فيها برقها لما وثب","https://www.aldiwan.net/poem27297.html","الرجز"],[50,"صبح فضل ظاهر التيه","https://www.aldiwan.net/poem66197.html","السريع"],[52,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[19,"هل عاجل من متاع الحي منظور","https://www.aldiwan.net/poem342.html",""],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54940","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[7,"عوجوا ، فحيوا لنعمٍ دمنة َ الدارِ ،","https://www.poetsgate.com/ViewPoem.aspx?id=17560",""],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[92,"شباب يذوي !","https://www.poetsgate.com/ViewPoem.aspx?id=179111",""],[164,"هنيته عيدا فصل وانحر","https://www.aldiwan.net/poem58821.html","الرجز"],[164,"قد أوعدتني بالزيارة في الكرى","https://www.aldiwan.net/poem58874.html","الكامل"],[164,"عيد حظى بك والأعياد تقتتل","https://www.aldiwan.net/poem58929.html","البسيط"],[168,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[170,"يا شمس والشمس لها حاجب","https://www.aldiwan.net/poem46831.html","السريع"],[211,"إما تري يا أم فروة خيلنا","https://www.aldiwan.net/poem27940.html","الكامل"],[234,"قد أغتدي والليل في دجاه","https://www.aldiwan.net/poem51274.html","الرجز"],[275,"فقن الخمائل نضرة وعبيرا","https://www.aldiwan.net/poem35469.html","الكامل"],[353,"لا تأخذن عنها السروج واللجم","https://www.aldiwan.net/poem20682.html","الرجز"],[355,"أقفر من سلمى يناضيبُ","https://www.aldiwan.net/poem641.html",""],[360,"أحببتها فوق ما ظن الرجال بنا","https://www.aldiwan.net/poem61034.html","البسيط"],[376,"شهد البكاء وما أتيت بشاهد","https://www.aldiwan.net/poem57494.html","الكامل"],[382,"هبطت إليك من المحل الأرفع","https://www.aldiwan.net/poem59343.html","الكامل"],[382,"ما بين جفني والأحبة برزخ","https://www.aldiwan.net/poem66880.html","الكامل"],[401,"أبني نُجيح إن أمكم","https://www.aldiwan.net/poem554.html",""],[408,"لو كان يعلم أنها الأحداق","https://www.aldiwan.net/poem46984.html","الكامل"],[435,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[466,"يا فارس الهولين عم رداهما","https://www.aldiwan.net/poem15443.html","الكامل"],[518,"دعاني الشوق والركبان قد هجدوا","https://www.aldiwan.net/poem67765.html","البسيط"],[520,"ردا أحاديث المنى وأعيدا","https://www.aldiwan.net/poem12092.html","الكامل"],[541,"قال النبي ولم أجزع يوقرني","https://www.aldiwan.net/poem23854.html","البسيط"],[558,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[558,"أغرى به الشوق ليل الساهر الرمد","https://www.aldiwan.net/poem68425.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66654","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46516","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46514","الرجز"],[1420,"","https://poetry.dctabudhabi.ae/diwan/poem/100692","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49994","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77804","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77965","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77755","البسيط"],[1732,"","https://poetry.dctabudhabi.ae/diwan/poem/97741","البسيط"],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96220","البسيط"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20448","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104977","البسيط"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101821","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60929","البسيط"],[2497,"","https://poetry.dctabudhabi.ae/diwan/poem/143742","السريع"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82963","الرجز"],[2961,"","https://poetry.dctabudhabi.ae/diwan/poem/111550","السريع"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22545","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100843","البسيط"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105622","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89030","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62898","الرجز"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61256","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138658",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138696",""],[3690,"","https://poetry.dctabudhabi.ae/diwan/poem/77721","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85262","البسيط"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76479","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111401","البسيط"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107478","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119615","السريع"],[4110,"","https://poetry.dctabudhabi.ae/diwan/poem/101162","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90803","الكامل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93768","السريع"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81931","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117312","الكامل"],[4472,"","https://poetry.dctabudhabi.ae/diwan/poem/144575","المنسرح"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119578","البسيط"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116076","الكامل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67508","البسيط"],[5120,"اَلْحَرْبُ اَلضَّرُوسُ","https://www.poetsgate.com/ViewPoem.aspx?id=180019",""],[5277,"رغبةٌ من جنون","https://www.poetsgate.com/ViewPoem.aspx?id=188248",""],[5409,"هدأ الدجى لولا أنين عليل","https://www.poetsgate.com/ViewPoem.aspx?id=155307",""],[5409,"ماذا حدا بك فاعتزمت رحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=155477",""],[5953,"خمسة أشياءٍ بها الله انفرد","https://www.poetsgate.com/ViewPoem.aspx?id=93813",""],[6093,"يَا هَاجِريْ ! عينٌ لبَعْضيَ أنكرتْ ( الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=176195",""],[520,"ردا احاديث المنى وأعيدا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577496",""],[6157,"زارت بأكرم ليلة وفى بها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=558676",""],[6277,"بوركت الأعمال والجهود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64483&r=&rc=46",""]],"verses":[["حتّى إذا قالوا تسعَّرَ ثاقِبٌ","عمَّ السّماءَ بلَفْحِهِ اسْتِسْعارُهُ",0,"ر",2,0],["حَتّى إِذا قيلَ قَد طالَت عُروقُهُما","وَطابَ غَرسُهُما وَاِستَوسَقَ الثَمَرُ",1,"ر",1,0],["حَتّى إِذا قالَ قَد نالَت أَوائِلَها","وَأَدركتَهُ جَميعا بِالأَظافيرِ",2,"ر",1,0],["حَتّى إِذا قارَبَ فيما يَحسَبُ","مَعقِلَهُ وَالمَوتُ مِنهُ أَقرَبُ",3,"ب",1,0],["حتى إذا قام على سوقه","سدت به ثقبة بلاعه",4,"ع",2,0],["حتى إذا قُضيت لقيعان الملا","عنه حقوق بعدهن حقوق",5,"ق",1,0],["حَتّى إِذا قُلتُ نالَتهُ سَوابِقُها","كَرَّ عَلَيها وَقَد أَمهَلنَهُ مَهَلا",6,"ل",2,0],["حَتّى إِذا قُلتُ نالَتهُ سَوابِقُها","وَأَرهَقَتهُ بِأَنيابٍ وَأَظفارِ",7,"ر",1,0],["حَتّى إِذا قَنِطَت دَنَت مِنهُ كَما","يَدنو أَخو الداءِ العُضالِ مِنَ الدَوا",8,"ا",1,0],["حَتّى إِذا قَتَلَت أَدنى الغَليلِ وَلَم","تَملَأ مَذاخِرَها لِلرَيِّ وَالصَدَرِ",9,"ر",1,0],["حتى اذا قلت ان الدهر من مقة","مسالم لي وان السعد ملتزمي",10,"م",2,0],["حَتّى إِذا قيلَ لَهُ نِلتَ اِفعَلِ","إِفتَرَّ عَن مَذروبَةٍ كَالأَنصُلِ",11,"ل",1,0],["حتى إذا قصد الحمام لنا","من بعد عمر وارد الحبل",12,"ل",1,0],["حَتّى إِذا قَبَضَت أولى أَظافِرِهِ","مِنها وَأَوشِك بِما لَم تَخشَهُ يَقَعُ",13,"ع",1,0],["حَتّى إِذا قيلَ ما أَعطاكَ مِن صَفَدٍ","طَأطَأتُ مِن سوءِ حالٍ عِندَها راسي",14,"س",2,0],["حَتّى إِذا قُدَّ ذَيلُ اللَيلِ مِن دُبُرٍ","بِها وَسَلَ عَلينا صُبحُها قُضُبا",15,"ب",2,0],["حَتَّى إِذا قيلَ قد حازَ العُلى حَسَنٌ","مَدّوا إلى أحمَدَ الألحاظَ وانتظروا",16,"ر",3,0],["حَتّى إِذا قُضِمَ المُهَنَّدُ نَبوَةً","وَاِندَقَّ صَدرُ السَمهَرِيِّ فَطاحا",17,"ح",2,0],["حتّى إذا قعدوا ظَلَّتْ بموقفِها","وأقبلَ الموتُ عن أيمانِها يَقِفُ",18,"ف",1,0],["حَتّى إِذا قُضِيَ الرَحيلُ وَقَد سَطا","نَقعٌ يَثُورُ إِلى السَماءِ ضَبابُهُ",19,"ب",2,0],["حَتّى إِذا قامَ إِلى الحَفيرَه","أُلفي كَعَنزٍ رَبَضَت كَسيرَه",20,"ه",1,0],["حَتّى إِذا قارَبَ عِندَ العَشرِ","في مُلكِهِ مِنَ السِنينَ الزُهرِ",20,"ر",1,0],["حَتّى إِذا قيلَ خَضيبٌ بِدَمٍ","نَجَمتُ فيها بِحُسامٍ مُختَضِب",21,"ب",1,0],["حَتّى إِذا قُمتُ عَلى بابِهِ","سَمَّيتُ لِلناسِ زَوانيهِ",22,"ي",2,0],["حَتّى إِذا قَرَّبَهُ حَينُهُ","مِنها وَلَولا الحَينُ لَم يَقرُبِ",23,"ب",1,0],["حَتّى إِذا قُلتَ نالَتهُ أَوائِلُها","وَلَو يَشاءُ لَنَجَّتهُ المَثابيرُ",24,"ر",1,0],["حتى إذا قيل خلتْ مروان","وذهب السلطان والأعوان",25,"ن",1,0],["حَتَّى إِذَا قَيَّضَ لِي فُرْصَةٌ","مِنْ بَعْدِ أَنْ ضَنَّ بِهَا الدَّهْرُ",26,"ر",1,0],["حَتّى إِذا قامَ قُمتُ أَتبعُهُ","وَكَيفَ لي فَوزُهُ وَبُشراهُ",27,"ا",2,0],["حتى إِذا قَوِيتْ لِدَانُ غُصونِه","واستَحْصَد المَرْجُوُّ من ثمَراتِه",28,"ت",2,0],["حتى إذا قَضَى منها لُبانَتَهُ،","وعادَ فيها بإقبالٍ وإدبارِ",29,"ر",1,0],["حتى إذا قَذفَ الحمى بحُماتِه","ورَمَت بأشبالٍ لها الآجام",30,"م",1,0],["حتى إذا قلتَ قولاً تستبينُ به","لُطفَ الحياةِ بتصريحٍ وإيماء",31,"ا",2,0],["حتى إِذا قضى الصباح شأنه","وما بقى لأهله من وطرِ",32,"ر",1,0],["حتى إذا قالوا ركبتَ تّموجوا","واثارت الخيلُ العجاج الأكدرا",33,"ر",2,0],["حتى إِذا قيل هذا أُحمدُ انقشعت","من القساطل عن من تحتها كللُ",34,"ل",1,0],["حَتّى إِذا قابَلَها اِستَعبَرَ لا","يَملِكُ دَمعَ العَينِ مِن حَيثُ جَرى",35,"ا",1,0],["حتى إذا قيلَ صَحا وارعَوى","عادَ كذا عادةُ أهلِ الهَوى",36,"و",2,0],["حَتّى إِذا قالَ الرَسولُ مَحَمَّدٌ","أَبَني سُلَيمَ قَد وَفَيتُم فَاِرفَعوا",37,"ع",3,0],["حتَّى إذا قارَبه عَلاَه","بَوَقْعةٍ بَزّ بها قُوَاه",38,"ا",2,0],["حتى إذا قابَلننا ذكَّرننا","أرضَ الشآمِ وطِيبها والنُّورا",39,"ر",2,0],["حَتى إذا قَضَى هناكَ الأَرَبَا","واشتاقَ سَفْحَيْ حاجرٍ والرَّبربَا",40,"ب",2,0],["حَتّى إِذا قُلنَ تَلافَينَهُ","وَالحَينُ للحاينِ مَجلوبُ",41,"ب",1,0],["حتى إذا قلت هذا الموتُ أدركني","ثبت الجنان ربيط الجأش للقَدر",42,"ر",1,0],["حتى إذا قادَ النداءُ إلى الندى","قام المقامُ له بشكرِ القائِد",43,"د",1,0],["حتى إذا قرب المسير إلى الحمى","وانحل تركيب الكثيف الأسفَع",44,"ع",1,0],["حتى إذا قَتل العداةَ بقلته","ولجنبه بالسمهرية يَزلَخ",45,"خ",1,0],["حتى إِذا قَمِلت بطونُكم","ورأيتُمُ أبناءَكم شَبُّوا",46,"ب",3,0],["حَتَى إذا قُبِضَ المُذلُّ سُطاهمُ","وَغَدتْ عليهِ مَن الثرى أطباقُ",47,"ق",1,0],["حتى إذا قامت وطارت صاحا","الرجل الصياح ثم لاحا",48,"ح",2,0],["حتى اذا قَذفَ اليراعُ بحالكٍ","أجرى النحور صَبيبَ قانٍ أحمرِ",49,"ر",1,0],["حتى إذا قلت شدوا قال بعضهم","قد جن هذا فخلوا عنه وابتعدوا",50,"د",3,0],["حتى إذا قدم الركاب يحفه","نصر يحف ميامناً وسعودا",51,"د",2,0],["حَتّى إِذا قُلتُ قَد أَنجَدنَ عارَضَنا","مِن مُدلِجِ فارِسٌ في مَنصِبٍ وارِ",52,"ر",1,0],["حَتّى إِذا قَرُبَت بِهِ آجالُهُ","وَلَو اِستَطاعَ لَباعَدَ الآجالا",53,"ل",2,0],["حَتّى إِذا قَبَضَ الإِدلاجُ بَسطَتَها","وَوُقِّفَت مِن مُنى الساري عَلى أَمَدِ",54,"د",1,0],["حتى إذا قارب شيث أجله","أقام فيهم أنوشا فجعله",55,"ه",1,0],["حتى إذا قارب قالوا وعده","خلف إدريسا وصيا بعده",55,"ه",1,0],["حتى إذا قتل قاموا بعده","مع الحسين حين قام وحده",55,"ه",1,0],["حتى إذا قصدوا لبابِ مغارِهِ","ألفَوْا عليهِ نسيجَ غَزلِ العَنْكَبِ",56,"ب",1,0],["حَتَّى إِذا قيل غَداً يَلقاكا","انظر فَهَذا هُو قَد أَتاكا",57,"ك",2,0],["حَتَّى إِذا قيل نزال فروا","وَخلفوه وَحده وَمروا",58,"ر",3,0],["حتى إذا قرب المسير من الحمى","ودنا الرحيل إِلى الفضاء الأوسع",59,"ع",1,0],["حتّى إذا قذفت بنا أيدي النّوى","بالبين عن دار الأحبة مَقْذَفا",60,"ف",2,0],["حَتّى إِذا قال المعنى يا أَنا","يَشكو العنا قالَ المعنى يا أَنا",61,"ن",2,0],["حَتّى إِذا قبض النوى أَيامه","ما كانَ أَصعب ذلك الأُياما",62,"م",2,0],["حَتّى إِذا قتلت بالخمر أَفئدة","أَحيت برائحتي ورد وَتفاح",63,"ح",1,0],["حتّى إِذا قيلَ قَد طالَت فُروعهما","وَطاب قَنواهما وَاِستُنضرَ الثّمرُ",64,"ر",1,0],["حتى إذا قربت من ذيل صاحبها","أصغى إلى سرها والرأس منتكس",65,"س",1,0],["حَتّى إِذا قَسَمَ النَصيبَ وَأَصفَقَت","يَدَهُ بِجِلدَةِ ضَرعِها وَحُوارِها",66,"ر",3,0],["حتى إذا قتلت عقلي بسورتها","فأحي سمعي بالأوتار والنغم",67,"م",1,0],["حتى إذا قطعوا عليه طريقه","بسداد جيش بارز وكمين",68,"ن",1,0],["حتى إذا قيل وافى بعد غيبته","عاودت أنشد أشعاري واشيها",69,"ي",3,0],["حتى إذا قلّصَ ظلُّ الضُّحى","عادت ثُدَيّاً وقُروناً جِعاد",70,"د",1,0],["حَتّى إِذا قيل رحل","نحو بِلادٍ وفَصل",71,"ل",1,0],["حتى إذا قابلها ثانياً","تشكه بالرمح في المفرق",72,"ق",1,0],["حَتّى إِذا قُلتُ هَذا المَوتُ أَدرَكَني","صَبرُ الكِرامِ وَضَربُ الجَأشِ لِلقَدَرِ",73,"ر",1,0],["حتى اذا قطعت يوما غلاصمه","وخضب الارض صبغ القانيء السرب",74,"ب",1,0],["حتى إذا قرص ذكا تسنما","وانتجعت شمس الضحى نصف السما",75,"م",2,0],["حتى إذا قطع المسيرَ بوصلِه","أوقاتَه بالبر والإصلاح",76,"ح",1,0],["حتى اذا قيلَ قَنَعْ","بِلَسِّ وشْمٍ لم يُطِعْ",77,"ع",1,0],["حَتّى إِذا قُضِيَت مَناسكُ كَعبة ال","مِقياسِ وَهيَ لَكُم عَوائِدُ سُبَّقُ",78,"ق",1,0],["حتى إذا قامت بنو العباس لم","ترقب بهم قربى لخير أمين",79,"ن",1,0],["حتى إذا قضى القضاء وآن أن","يغدو الهدى متزلزل الأركان",80,"ن",1,0],["حتى إذا قامتْ تَمدُّ بنورِها","متبلّجَ الإصباحِ حينَ يُنيرُ",81,"ر",1,0],["حتى إذا قام للهيجاء قائمها","واشعل الحرب مذكي الحرب إشعالا",82,"ل",2,0],["حَتّى إِذا قيل ان القطر صار لَنا","سجنا كَبيرا راينا اكبر الحجج",83,"ج",1,0],["حتى إِذا قاتلُوا في ظِلِّ فُلكهِمِ","ظَلَّ الأَخاءَةُ في أَمنٍ وفي سَلَمِ",84,"م",1,0],["حتى إذا قرصه بردُ الشتا","أيقنَ أن شملَه تشتتا",85,"ت",2,0],["حتى إذا قابل جمعاً لهم","ولوا وقالوا أنه جانا",86,"ن",2,0],["حتى إذا قدمت كبت اقدامها","فأعنها الاقدار لا الاقدام",87,"م",1,0],["حتى إذا قام الأمين بها على","قدم الشريعة زانها التوقير",88,"ر",1,0],["حَتّى إِذا قامَت قَناة الوَغى","هاب اقتمام المجمع الحاشد",89,"د",1,0],["حتى إذا قبض النبي وضمَّه","من بعد ذلك قبره الملحود",90,"د",1,0],["حَتَّى إذا قالت لنا شَمسُ الضُّحى","قِيلُوا فَقِلنا بَينَ عَينٍ وَجَبا",91,"ا",1,0],["حتى إذا قرت هناك قرارها","فاحلل بمكة والتمس أنوارها",92,"ه",2,0],["حتى إذا قرّتِ العُيونُ بكمْ","علمتُ أنّ الزمانَ غيرانُ",93,"ن",1,0],["حتى إذا قدرّ الرحمن ميتتنا","وحان من أمرنا ما ليس يعدونا",94,"ن",2,0],["حتى إذا قطعوا الجِفارَ بجحفلٍ","هو فى العديد ورملُهُ سِيَّانِ",95,"ن",1,0],["حتى إذا قام شرّ منه قلت لهم","الآن طاب عليه الهمّ والأسف",96,"ف",1,0],["حَتَّى إِذَا قَامَتِ اَلْحَرْبُ اَلضَّرُوسُ رَمَى","أَقْلاَمَهُ عَبَثِي،وَ اهْتَزَّتِ اَلصُّحُفُ...",97,"ف",1,0],["حتَّى إذا قلتُ: قدْ لجَّ الخصامُ بنا","أجابني: ما تُقاسي في الهوى وجبا",98,"ب",2,0],["حتى إذا قرب السرى وبدت لها","منه إشارة مؤذنٍ برحيل",99,"ل",1,0],["حتى إذا قطعوا الرجاء استنصروا","في خذلك التهديد والتهويلا",100,"ل",2,0],["حتى إذا قال عليٌ إنني","بها عليمٌ قال من فيه رشد",101,"د",1,0],["30. حتَّى إذا قهَرَ المحاولَ سَوْقُهُ","أعْطى القيادَ لفارسِ الكلماتِ",102,"ت",1,0],["حتى إذا قدم الركاب يحقه","نصرٌ يحف ميامناً وسعودا",103,"د",2,0],["حَتّى إِذا قامَت تَمدّ بِنُورها","مُتبلّجَ الإِصباح حينَ يَنورُ",104,"ر",1,0],["حتى إذا قيل لنا : أن عودوا","بوركت الأعمال والجهود",105,"د",1,1]]}