{"poems":[[51,"ما استعبد الحرص من له أدب","https://www.aldiwan.net/poem10331.html","المنسرح"],[99,"يا معجباً تاه على صحبه","https://www.aldiwan.net/poem24396.html","السريع"],[33,"ضحكت أم نوفل إذ رأتني","https://www.aldiwan.net/poem41286.html","الخفيف"],[33,"ألا من يرى رأي امرئ ذي قرابة","https://www.aldiwan.net/poem42247.html","الطويل"],[50,"كأن ما بي في المجانين","https://www.aldiwan.net/poem66565.html","الوافر"],[48,"إذا وقت السعادة زال عني","https://www.aldiwan.net/poem23525.html","الوافر"],[70,"ما اسم إذا ما سأل المرء عن","https://www.aldiwan.net/poem1555.html",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54654","الوافر"],[30,"","https://poetry.dctabudhabi.ae/diwan/poem/8081","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[51,"مَا استَعبَدَ الحِرْصُ مَنْ لهُ أدَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=16963",""],[102,"كلّنا في انتظار ميلاد الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=50117",""],[132,"عليكم وإن طال البعاد سلام","https://www.aldiwan.net/poem50501.html","الطويل"],[147,"كفى الدين عزا ما قضاه لك الدهر","https://www.aldiwan.net/poem11758.html","الطويل"],[240,"لو بات من يلحي عليك مسهدا","https://www.aldiwan.net/poem32100.html","الكامل"],[242,"أقول وحمد الله أول منطقي","https://www.aldiwan.net/poem19697.html","الطويل"],[242,"ألا فالذي تسمو إليه وترتقي","https://www.aldiwan.net/poem19698.html","الطويل"],[242,"إذا أنت لفقت الذي قاله الشقي","https://www.aldiwan.net/poem19699.html","الطويل"],[369,"هم منعوا مني الخيال المسلما","https://www.aldiwan.net/poem60668.html","الطويل"],[445,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[463,"إذا لم أحظ منك على التلاقي","https://www.aldiwan.net/poem56089.html","الوافر"],[469,"لقد أصبحت في سلطان ملك","https://www.aldiwan.net/poem3452.html","عموديه"],[520,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[532,"أيدري السيف أي فتى يبيد","https://www.aldiwan.net/poem45970.html","الوافر"],[534,"يجاهرني العدو بكل نكر","https://www.aldiwan.net/poem37467.html","الوافر"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138437",""],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130156","السريع"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67021","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104577","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38770","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120012","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96611","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128697","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48951","المتقارب"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203760","الخفيف"],[1877,"","https://poetry.dctabudhabi.ae/diwan/poem/115250","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124727","الطويل"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99058","الهزج"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123076","الوافر"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96031","الكامل"],[2175,"","https://poetry.dctabudhabi.ae/diwan/poem/101271","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27969","الطويل"],[2365,"","https://poetry.dctabudhabi.ae/diwan/poem/34714","الرمل"],[2409,"","https://poetry.dctabudhabi.ae/diwan/poem/80071","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129809","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87314","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76065","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83223","الكامل"],[2778,"","https://poetry.dctabudhabi.ae/diwan/poem/130320","الخفيف"],[2815,"","https://poetry.dctabudhabi.ae/diwan/poem/105738","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201854","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74259","الكامل"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22534","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68023","الكامل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118769","الطويل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199030","الرجز"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76494","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22084","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73310","الطويل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146754","الكامل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147269","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72494","الرجز"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139500",""],[4693,"سلام الله يا شعب العراق","https://www.poetsgate.com/ViewPoem.aspx?id=30098",""],[4755,"لِصَمتِكِ وهْو يَقرَؤُنِي استِماعا","https://www.poetsgate.com/ViewPoem.aspx?id=197893",""],[4830,"هو نفْسُ مُحمّد","https://www.poetsgate.com/ViewPoem.aspx?id=204707",""],[4876,"سيري على الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=207496",""],[4929,"سيأتي الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=200127",""],[4955,"سهامُ الغدرِ تأتينا","https://www.poetsgate.com/ViewPoem.aspx?id=187924",""],[4966,"أتوق إليك...","https://www.poetsgate.com/ViewPoem.aspx?id=196714",""],[5050,"مقام في القصور على قصور","https://www.poetsgate.com/ViewPoem.aspx?id=38189",""],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[5112,"من يرد؟","https://www.poetsgate.com/ViewPoem.aspx?id=213045",""],[5150,"إلام الصمت يا عرب ..؟؟!!!","https://www.poetsgate.com/ViewPoem.aspx?id=202873",""],[5150,"المرأة .. بنصف عقل ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203061",""],[5185,"نبوءة الحجاب","https://www.poetsgate.com/ViewPoem.aspx?id=72852",""],[5187,"من وحي الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=29701",""],[5271,"بريء مِن الحبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=62012",""],[5273,"رسالة إلى عمر بن الخطاب","https://www.poetsgate.com/ViewPoem.aspx?id=179801",""],[592,"أما والذي لا يعلم الغيب غيره","https://www.poetsgate.com/ViewPoem.aspx?id=128850",""],[5413,"هي سنة العشاق","https://www.poetsgate.com/ViewPoem.aspx?id=200545",""],[5413,"سامحيني","https://www.poetsgate.com/ViewPoem.aspx?id=200567",""],[5431,"وجهٌ له الأنوارحتما تُشرقُ","https://www.poetsgate.com/ViewPoem.aspx?id=187197",""],[5781,"قلوبٌ مَأهولةٌ بالظَّامئين","https://www.poetsgate.com/ViewPoem.aspx?id=202829",""],[402,"أيبلغ منك سمع المستجيب","https://www.poetsgate.com/ViewPoem.aspx?id=35350",""],[5818,"تعوّذت ِ الأمّ مِن دائها","https://www.poetsgate.com/ViewPoem.aspx?id=193227",""],[5818,"دماء العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=177740",""],[6093,"ثعالب النقد","https://www.poetsgate.com/ViewPoem.aspx?id=202605",""],[6213,"زمان الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76263&r=&rc=20",""]],"verses":[["فَنِصفُ خُلقِ اللِئامِ مُذ خُلِقوا","دُلٌّ ذَليلٌ وَنِصفُهُ شَغَبُ",0,"ب",1,0],["فنصفُه الأعلى به أجردٌ","عارٍ ولكنَّ القفا مكسي",1,"س",2,0],["فَنَصيدُ الغَريرَ مِن بَقَرِ الوَح","شِ وَنَلهو بِلَذَّةِ الفِتيانِ",2,"ن",1,0],["فَنَصرَكَ أَرجو لا العَداوَةَ إِنَّما","أَبوكَ أَبي وَإِنَّما صَفقُنا مَعا",3,"ع",2,0],["فنصفهُ نرجسةٌ غضّةٌ","ونصفهُ من فنَكِ الصينِ",4,"ن",1,0],["فَنَصلُ السَيفِ وَهوَ اللُجُّ يَرمي","غَريقاً فَوقَ سَيفٍ مُرفَئِنِّ",5,"ن",1,0],["فَنِصْفُ يَس لهُ أوّلٌ","مِنْ غيرِ ما شكٍّ ولا جَمجَمَهْ",6,"م",2,0],["فَنِصْفُ اَرْضِ فِي غَرَقٍن وَنِصٍْفٌ","تَجَلَّلَ بِالصَّوَاعِقِ وَاللَّهِيبِ",7,"ب",1,0],["فَنُصحي لَكُم قادَ الهَوى مِن بِلادِهِ","إِلى مَنبِتِ الزَيتونِ مِن مَنبِتِ النَخلِ",8,"ل",1,0],["فنصبتِ الفخَّ خدّاعَ المُنَى","خَشِنَ الكفِّ حديدَ المِخْلبِ",9,"ب",1,0],["فنِصْفُ خَلْقِ اللِّئامِ مُذْ خُلِقُوا","ذُلٌّ ذَليلٌ، ونِصْفُهُ شَغَبُ",10,"ب",1,0],["فنصتنا للطّيف إنصات صبّ","لمحت يقصّ قصّة هجر",11,"ر",1,0],["فنصرُ إمام المسلمين فريضةٌ","وعصيانُه هو المطيعُ حَرامُ",12,"م",1,0],["فَنَصرُ اِبنُ مَحمودِ اِبنِ نَصرِ اِبنِ صالِحٍ","لَها عِوَضٌ نِعمَ البَقِيَّةُ وَالذُخرُ",13,"ر",1,0],["فَنِصالُهُم بِأَكُفِّهِم مَشحوذَةُ","الشَفَراتِ إِمّا لِلنَدى أَو لِلعِدى",14,"د",2,0],["فَنِصْفُ اسْمِهِ بَخْتٌ وَلَوْ كَانَ لِي غَدَا","حَبِيبِي مُحِبّاً لِي عَظِيمَ التَّعَشُّقِ",15,"ق",1,0],["فَنِصْفَاهُ بَخْتٌ ثٌمَّ يَارٌ وَعَكْسُ ذَا","لِمَنْ رَامَهُ رَأْيٌ بِهِ الْمَرْءُ يَتَّقِي",16,"ق",2,0],["فَنِصْفُ اسْمِهِبَخْتٌ وَعَكْسُ الذِي بَقِي","وَذَلِكَ يَارٌ رَأْيُ مَنْ لَمْ يُحَمَّقِ",17,"ق",1,0],["فَنصْراً أبا نَصْرٍ لراجٍ بك العُلا","على الدّهرِ أن يُلْفَى له مُتَهضِّما",18,"م",2,0],["فنصرُكَ أَوَّلُ مَا نَسْتَمِدُّ","وعمرُكَ آخِرُ مَا نستديمُ",19,"م",1,0],["فنصراً يا مليك الأرض نصراً","على رغم المحايد والملاقي",20,"ق",2,0],["فنصَّ وقسْ تصب معنى مقالي","فإنَّ النصَّ يشفع بالقياس",21,"س",1,0],["فنصف في جفون مهندات","ونصف في جفان كالجواب",22,"ب",1,0],["فنصفٌ من مدامعها سخينٌ","ونصفٌ من مدامعها برودُ",23,"د",1,0],["فَنَصْرِي فيه إعْزازٌ لِدِينٍ","ونَصْرِي فِيه دَفْعٌ للفَسَادِ",24,"د",1,0],["فنصبوه بعده ضرورة","حجتكم في ذلكم مكسورة",25,"ه",1,0],["فنصب اعينها انهاض طائفة","إلى مراقى المعالي ارثذكسيه",26,"ي",2,0],["فنصفها الآخر من لفظها","أمر لمحبوبك عند انصرام",27,"م",1,0],["فَنَصْرُكَ أيّاً ما سَلَكْتَ مُسَايِرٌ","وفَتْحُكَ أيّاً ما اتَّجَهْتَ مُوَاجِهُ",28,"ه",1,0],["فنصرُكَ مجهولٌ لنا ومُعجَّلٌ","وبِرُّكَ معلومٌ لنا فهو مُعلمُ",29,"م",1,0],["فَنُصحِيَ عَن وَجدي مُحالٌ قَبولهُ","وَهَل حَلَّ نُصح الصبّ عِند ذَوي اللبِّ",30,"ب",1,0],["فنصحك لا يخالطه ارتياب","وودك ود صدق لا يشابُ",31,"ب",1,0],["فَنصفٌ غدا في ظعن حيٍّ مشرّق","ونصفٌ غدا في ظعن حيّ مغرّبِ",32,"ب",1,0],["فَنَصَرَ اللَّهُ بِهِ وَأَعْتَقا","فَالْحَمْدُ للَّهِ عَلَى ما وَفَّقا",33,"ق",2,0],["فنصبها الايمن قد ترطبا","ولامها بالاحدِ دابِ رُكبِّا",34,"ب",2,0],["فنصرته بالرعب ترمي العداة من","مسيرة شهر قبل يوم العريكة",35,"ه",1,0],["فنصعدَ هذا السنامَ ونحدو","إلى حيث يمكنُ أن تَهجَعي",36,"ع",2,0],["فنصيب العطاء آتٍ بحدٍ","ونصيبُ البلاء آتٍ بذنب",37,"ب",1,0],["فنصف معنّى بالعلا وطلابها","ونصف معنّى بالصبابة والحب",38,"ب",1,0],["فنصفٌ لعلياهن والسدس للتي","تليها ومما يحصد المرءُ يزرعُ",39,"ع",1,0],["فنصطاف على الثلج","ونشتو بلد التمر",40,"ر",1,0],["فنصف منه سف ولا تُثقل","ونصف مثل قول بُنيتي يو",41,"و",1,0],["فنصرتها ونضرتها فكأنها","غصن يرنحه الصبا املودا",42,"د",2,0],["فنصف بريد سيره في نهاره","وذلك منه غاية الجد والجهد",43,"د",1,0],["فنصفٌ لكم مثلُ الصلاةِ معيَّن","ونصفٌ لنا من غير نكث ولا نقضِ",44,"ض",1,0],["فَنُصيبُ الفَذَّ مِنها","بَعدَ أَلفٍ فائِتات",45,"ت",1,0],["فنِصْفٌ على بر فسيحٍ رحابُه","ونصفٌ على بحرِ أغرَّ يطيبُ",46,"ب",1,0],["فنصرتَ حتى لا يخالفك امرؤٌ","وبقيت حتى لا يحَدُّ بقاءُ",47,"ا",2,0],["فَنِصفُهَا أَوانُهُ النهارُ","في الليلِ لا تدركُهُ الأبصارُ",48,"ر",1,0],["فَنِصفُهَا السَّيلانُ من شَرقِهَا","بَل إنَّ دَورَتكَ تزيدُ فَضلَهَا",49,"ه",2,0],["فنُصبح في أنسٍ وَخَيرٍ وَصحةٍ","وَحسنِ شَبابٍ طالَ فيهِ دَوامكِ",50,"ك",1,0],["فَنَصيحَتي في ثوبِها","أَدَبٌ وَصِدقٌ وَاِحتِرام",51,"م",1,0],["فنصبنا له الشباك زماناً","ونصبنا مع الشباك فخاخا",52,"خ",2,0],["فنصيرَ بَعدَك ليس يُرفَعُ بيننا","ويذلُّنا اعداؤنا ونُضيّع",53,"ع",1,0],["فنصبت عيني في الطريق حبائلاً","وبعثت روحي تجذب الآراما",54,"م",2,0],["فَنصبت للشرع المطهر حاكِماً","وَأَزلت ظُلماً في الوَرى وَشقاقا",55,"ق",2,0],["فَنُصبِحُ لَم يُشعَر بِنا غَيرَ أَنَّهُم","عَلى كُلِّ ظَنٍّ يَحلِفونَ وَنَحلِفُ",56,"ف",1,0],["فنصبتَ فِي وادي عقولَ مُخيَّماً","كالسُّحْب أبيضَ مَا يكون وأنقى",57,"ق",2,0],["فنصبَ عيوني لا يزال خياله","وفي فكرتي حتى كأني أخاطبه",58,"ب",2,0],["فنصبوا دعوته طلسما","وقد محا الممات منه الرسما",59,"م",2,0],["فَنَصَحتهُ هون عليك فان في","ذا الكَون من لَم تستمت هماته",60,"ت",2,0],["فنصلٌ بظهر المجن وقع","بعسج هيفست حيث اتردع",61,"ع",1,0],["فَنُصيب مِن لَذّاتِهِ وَنَعيمِهِ","كَالعَهدِ إِذ هوَ في الزَمانِ الأوَّلِ",62,"ل",1,0],["فَنُصِبحَ والأَيَّامُ باسِمَةٌ بِكُم","وَغُصنُ لِقاكُم بالوِصالِ نَضيرُ",63,"ر",1,0],["فنص