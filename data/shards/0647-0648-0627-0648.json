{"poems":[[85,"يا وارث الأنصار وهي مزية","https://www.aldiwan.net/poem54253.html","الكامل"],[87,"قيل ما الفن قلت كل جميل","https://www.aldiwan.net/poem7122.html","الخفيف"],[87,"تجلد للرحيل فما استطاعا","https://www.aldiwan.net/poem63763.html","الوافر"],[47,"إن رق لي قلبك مما ألاقي","https://www.aldiwan.net/poem65188.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[92,"سلام على أرض الرصافة","https://www.poetsgate.com/ViewPoem.aspx?id=178976",""],[132,"بيضاء واضحة الترائب غادة","https://www.aldiwan.net/poem50502.html","الكامل"],[132,"ما زلت في لهو وفي طرب وفي","https://www.aldiwan.net/poem50542.html","الكامل"],[193,"وصل السراة وأنت ماكث","https://www.aldiwan.net/poem35170.html","مجزوء الكامل"],[228,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[234,"إني غريم والغريم مطالب","https://www.aldiwan.net/poem51018.html","الكامل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[242,"لمطة فيها ما تحب النفوس","https://www.aldiwan.net/poem19714.html","السريع"],[255,"سار والقلب في يديه مقيم","https://www.aldiwan.net/poem15026.html","الخفيف"],[276,"قف بالخضوع ونادربك يا هو","https://www.aldiwan.net/poem52132.html","الكامل"],[398,"يا وصل مالك لا تعاود","https://www.aldiwan.net/poem53658.html","مجزوء الكامل"],[412,"طيف ألم فزاد في آلامي","https://www.aldiwan.net/poem50127.html","الكامل"],[556,"أجر المدامع كيف شيتا","https://www.aldiwan.net/poem48033.html","مجزوء الكامل"],[563,"خذها إليك لها هدى وبيان","https://www.aldiwan.net/poem33803.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122640","المديد"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59562","الطويل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35357","الكامل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6770","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114772","الطويل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75989","الكامل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141206","الرجز"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140088",""],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79702","الخفيف"],[3667,"","https://poetry.dctabudhabi.ae/diwan/poem/125778","المنسرح"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123455","الخفيف"],[592,"يا طالباً مني جوابا شافيا","https://www.poetsgate.com/ViewPoem.aspx?id=128823",""],[5351,"المتناثر في يد الضياع","https://www.poetsgate.com/ViewPoem.aspx?id=201919",""],[5756,"خطاك السو","https://www.poetsgate.com/ViewPoem.aspx?id=5364",""],[5956,"محقُ السلاح أكبر ضامن للسلام","https://www.poetsgate.com/ViewPoem.aspx?id=194890",""],[6070,"راحَ الفؤادُ بشوقهِ يتحرقُ","https://www.poetsgate.com/ViewPoem.aspx?id=188643",""],[6102,"غُربَةُ الزَّمَكان!","https://www.poetsgate.com/ViewPoem.aspx?id=186283",""],[242,"لمطلة فيها ما تحب النفوس","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563760",""]],"verses":[["هو أول الأنوار في أفق الهدى","وترى الأهلة بعدها تسترسلُ",0,"ل",1,0],["هو أوفى من الزمان صِوانا","لبنات النهى واصدق خِذنا",1,"ن",2,0],["هَواؤُكِ وَالعُيونُ مُفَجَّراتٌ","كَفى بِهِما مِنَ الدُنيا مَتاعا",2,"ع",2,0],["هَواؤُها الفَضفاضُ غَضُّ النَدى","وَماؤُها السَلسالُ عَذبُ المَذاق",3,"ق",1,0],["هُوَ أَوَّلُ النُّخَبِ الْتَيِ أَبْرَزُتَهَا","وَلِذَلِكَ الهادِي النَّجِيبِ تُوَالِي",4,"ل",2,0],["هُوَ أَوْحَدُ الشَّرقَيْنِ مِنْ مُتَقَارِبٍ","مُتَكَلِّمٍ بِالضَّادِ أَوْ مُتَنَائِي",5,"ا",2,0],["هواؤكِ أم نشر من المسك نافح","وأرضك يا بغداد أم جنة الخلد",6,"د",1,0],["هو أولٌ هو آخرٌ في نضله","هو سابغ الآلاء والإنْعَامِ",7,"م",1,0],["هو أولٌ هو آخرٌ في جودِه","لا تحكه بأواخِر وأوائِل",8,"ل",1,0],["هوَ أوّلٌ والشمس ثا","ني نورهِ والبدرُ ثالِث",9,"ث",1,0],["هَواؤُهُ الطَيِّبُ روحُ الصِبا","وَماؤُهُ أَكدرهُ كَوثَرُ",10,"ر",1,0],["هو أوّلٌ في حسنه وكمالِه","وارى جميعَ الشعر بعدك آخِرا",11,"ر",2,0],["هُوَ أَوَّلُ البناءِ خَلقاً آخرٌ","في البَعثِ جَدَّدَ دارِسَ الأَديانِ",12,"ن",1,0],["هَوَاؤُهَا يُحْيِي قَتِيلَ الْمُنَى","وَمَاؤُهَا يَقْتُلُ حَيَّ النُّحُوسْ",13,"س",1,0],["هو أولى بالرفعِ إن أعرَبَ الدهرُ","وعُمرُ العِدا به مَجزُومُ",14,"م",1,0],["هُوَ أوّل هُوَ آخر هو ظاهر","هُوَ باطِن لَيسَ العيون تَراه",15,"ا",2,0],["هُوَ أَوحدٌ بَعدَ النَبِي","يِ المُصطَفى وَالحَقُّ واحِد",16,"د",1,0],["هوَ أَوَّلُ آخِرٌ في فَضلِهِ","هوَ باطِنٌ هوَ ظاهِرُ الإِنعامِ",17,"م",1,0],["هو أوّلٌ وتلوْتَهُ","في الباذخاتِ كما تُليتا",18,"ت",2,0],["هو أول هو آخر هو ظاهر","هو باطن هو واحد ديان",19,"ن",1,0],["هُوَ أوسٌ في سَماحَتِه","ولِعِزِّ الجارِ جَسّاسُ",20,"س",1,0],["هواؤك مِعطار وتربك منتقى","وماؤك سلسال وعيشك صالح",21,"ح",1,0],["هُوَ أَوَّلٌ هُوَ آخِرٌ هُوَ جامِعٌ","هُوَ فارِقٌ لِلغَيِّ عَن إِرشادِ",22,"د",1,0],["هُوَ أَوفى مِنَ السَمَوأَلِ عَهداً","وَلَما زالَ مُغرَماً بِالوَفاءِ",23,"ا",2,0],["هو أوصى كل الورى بهما لكنّ","ها ما وفت بما أوصاها",24,"ا",3,0],["هَواؤُك مختارٌ وتُربُكِ مُنتَقى","وجِسرُك للدُّنيا وللدّين مُلتَقى",25,"ق",2,0],["هُوَ أولٌ هو آخِرٌ هُو ظَاهِرٌ","هُو بَاطِنٌ هِي أربعٌ بوِزَانِ",26,"ن",1,0],["هُوَ أَوحَدٌ في العلمِ وِترٌ ما لَهُ","ثانٍ وَفي الإِحسانِ ذو إِشفاعِ",27,"ع",1,0],["هواؤها من الوباء جنة","كأنه من نفحات الجنة",28,"ه",1,0],["هواؤها يحيي النفوس إذ بدا","وماؤها يجلو عن القلب الصدا",28,"د",2,0],["هَواون القَنبَرة القَبيحَه","قَد سحبَت في أَنفُس جَريحَه",29,"ه",1,0],["هو اول وهو آخر وهو ظاهر","هو باطن هو فاطر البشرية",30,"ه",1,0],["هو أول إذا بكى بشفيع","يمسح الدمع أو يريه النعيما",31,"م",2,0],["هواؤُها ماؤُها وتربتها","تسمو على الأرض كلها قطرا",32,"ر",2,0],["هو أوحى الوحي في جنته","فسرى في الملأ الأعلا الصدى",33,"د",2,0],["هو أولى بالمومنين من الأنفس","إذ صار مُستحِقًَّ الولاء",34,"ا",2,0],["هو أول هو آخر سبحانه","هو ظاهر سبحانه هو باطن",35,"ن",1,0],["هو أول المتناثرين إلى العمى","هرباً وأدناه الذي أقصاهُ",36,"ا",2,0],["هو أول من حما شعبه من طعون الزمن وأ نصاب","هو اول من نذر نفسه يرد الحق لاصحابه",37,"ب",2,0],["هو أول الخطوات أكبرُ ضامنٍ","لحصار ما يؤذي وبتر المُفسِدِ",38,"د",1,0],["هوَ اولُ التاريخِ مُذْ طوفانِها","وكلامُ ربِّكَ ناطقٌ هو أصدقُ",39,"ق",1,0],["هُوَ أَوَّلُ القَتلَى! وَآخِرُ مَن نَجى","وَالبُعدُ كانَ شِراعَهُ وَحِصانَهُ!",40,"ن",2,0],["هَواؤُها يُحي قَتيلَ المُنى","وَماؤُها يَقتُلُ حَيَّ النُحوسِ",41,"س",1,0]]}