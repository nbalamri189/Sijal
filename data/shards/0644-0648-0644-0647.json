{"poems":[[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137156",""],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118783","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138605",""],[5525,"الطير","https://www.poetsgate.com/ViewPoem.aspx?id=993",""]],"verses":[["لو لها رخصت ان تبكيك لم","تجر الا من دماءٍ مقلتاها",0,"ا",3,0],["لولهمو ما جرى دمعي على طللٍ","ولا سعى نحو بان المنحنى قدمي",1,"م",2,0],["لوله الأمر انتهى سلمه","لإمام كان للباري شهيدا",2,"د",2,0],["لو له شبيه في الملى هو غزالان","راجي عل زينه يزود بشجاعه",3,"ع",2,0]]}