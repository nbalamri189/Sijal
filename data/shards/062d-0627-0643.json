12",""],[5525,"ليل التجافي","https://www.poetsgate.com/ViewPoem.aspx?id=7193",""],[5573,"طال السهر","https://www.poetsgate.com/ViewPoem.aspx?id=200217",""],[5573,"الفصول الاربعة","https://www.poetsgate.com/ViewPoem.aspx?id=200352",""],[243,"أعاصير","https://www.poetsgate.com/ViewPoem.aspx?id=50473",""],[5691,"بن تزيون(*)","https://www.poetsgate.com/ViewPoem.aspx?id=206351",""],[5781,"طُيوفكَ المنى ...وحبق","https://www.poetsgate.com/ViewPoem.aspx?id=208930",""],[5861,"مرثية لصبية","https://www.poetsgate.com/ViewPoem.aspx?id=188053",""],[5894,"حين استهل الظبيُ كالمصباح","https://www.poetsgate.com/ViewPoem.aspx?id=131415",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[5952,"ما ودَّعَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=203725",""],[5992,"وترى السماء كأنمّا هي غادة","https://www.poetsgate.com/ViewPoem.aspx?id=41853",""],[6032,"رند الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=181512",""],[6045,"وجمة غضب ونغمة طرب","https://www.poetsgate.com/ViewPoem.aspx?id=162864",""],[6056,"شعاع الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=130143",""],[6070,"قولي بربكِ ما الذي أبكاكِ","https://www.poetsgate.com/ViewPoem.aspx?id=189501",""],[6134,"سبحان من قد حباك الحسن أجمعه","https://www.poetsgate.com/ViewPoem.aspx?id=169573",""],[6277,"نَوَرٌ نسميهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64476&r=&rc=39",""]],"verses":[["حاكَهُ العِزُّ مِن خُيوطِ المَعالي","وَسَقاهُ النَعيمُ ماءَ الصَفاءِ",0,"ا",2,0],["حاكم مشيئته","لا تردها الحيل",1,"ل",1,0],["حاكيت عرقوب الوعود","وبتُّ دون الخلّ لاقط",2,"ط",1,1],["حاكوك شخصاً ولكن ما حكوا رشداً","إن المساجد تحكي شكلها البيع",3,"ع",1,0],["حاكوا لَكُمْ ثَوْبَ عِزٍّ","خَلَعْتُموهُ احتِقارا",4,"ر",2,0],["حاكم بأمره وشايل","على جناحه قانونه",5,"ه",1,0],["حاكَ الحَيا حُلَلَ الرَبيعِ فَعَطَّرَت","نَشرَ الصَبا بِأَريجِها الفَيّاحِ",6,"ح",1,0],["حاكِمٌ حَكَّمَ المُؤَمِّلَ في الما","لِ وَقاضٍ قَضى بِحَتفِ الأَعادي",7,"د",2,0],["حاكِمٍ رَأيُهُ إِذا أُشكِلَ الأَم","رُ سِراجٌ في ظُلمَةِ المُشكِلاتِ",8,"ت",1,0],["حاكِمٌ مَهَّدَ القَضاءَ بِقَلبٍ","ثاقِبِ الفَهمِ نافِذِ الإِدراكِ",9,"ك",1,0],["حاكمٌ يصدرُ منهُ","خلفَ كلِّ الناسِ حَفْرُ",10,"ر",1,1],["حاكِمُها يَظلِمُ العُقولَ وَلا","تَصلُحُ حالُ النُفوسِ إِن عَدَلا",11,"ل",2,0],["حاكَ مِنْ صَنْعَةِ القَرِيض بُرُوداً","لَكَ لم تحْكِ وشْيَها صَنْعَاءُ",12,"ا",2,0],["حاكِياتٍ بِلَفظِها","عُروَةً أَو مُرَقَّشا",13,"ش",2,0],["حاكياتٍ بطونها","عُرورةً أو مُرَقّشا",14,"ش",2,0],["حاكياً عَينَ وليٍّ إن عَلاَ","خَدَّ رَوضٍ تَبْكِ عن زهرٍ تُبَي",15,"ي",1,0],["حَاكَ الْقَرِيضَ بِلَهْجَةٍ عَرَبِيَّةٍ","أَغْنَتْ عَنِ الإِسْهَابِ بِالإِيْجَازِ",16,"ز",1,0],["حَاكِمٌ حَازِمٌ وَلِيٌّ مُطَاعٌ","ثَاقِبُ الْفِكْرِ صَادِقُ التَّقْدِيرِ",17,"ر",1,0],["حاكَيْتَ نَاسُوتَهُ كَمَالاً","وكُنْتَ تِلْميذَهُ المُطِيعَا",18,"ع",2,0],["حَاكَيْنَ نَظْمَ عُقُودِهِنَّ وَمَزَّقَتْ","أَزْوَاجُهُنَّ خَنَاصِراً لَمْ تُعْقَدِ",19,"د",1,0],["حاكٍ يُجيدُ النَّقلَ، إن أسكتَّه","يسكُت، وإن فُتحَ الصِّمامُ تكلما",20,"م",2,0],["حاكيت بازيَهم بلا","ظفر ولا ناب حديد",21,"د",1,0],["حاك من قبله الضلال نسيجا","غزلته خرقاؤه لشتاها",22,"ا",3,0],["حاكمته بعد ما ألحمته قرما","بعقر سبعين ألفا عقرة الجزر",23,"ر",1,0],["حاكمته بعد عمار وروحته","إلى الجنان وبعد السادة الطهر",23,"ر",1,0],["حاكمته بعد حكم الله فيه بما","يشفي الغليل وقد أيقنت بالظفر",23,"ر",1,0],["حاكمٌ مطَلَقٌ يكون بما يعرف","من خير شعبه مختارا",24,"ر",2,0],["حاكت عقودا في بنود بنفسج","ولألئا منسوجة باقاح",25,"ح",1,0],["حاكي التراب الوضيع منكسرا","ومنه للمصطفى علا النسب",26,"ب",1,0],["حاكه الحظ على قد المنى","فكأني كنت شمت البرحا",27,"ح",2,0],["حاكمك لاكمك","الكذب ملح الرجال وعيب علي يصدق",28,"ق",1,0],["حاكَها ماهرٌ حليفُ القوافي","حَزنُها الصعبُ عنده كالوهادِ",29,"د",1,0],["حاكَمتَهُم وَهُمُ لُدٌّ فَأَحصَرَهُم","عَن نُصرَةِ الغَيِّ طَعنٌ يَنصُرُ الرَشَدا",30,"د",2,0],["حاكمتهم يوم الجلاد إلى الظِّبا","وهي التي جارت على الحكام",31,"م",1,0],["حاكت بجسمي ثياب السقم مقلتها","اما ترى كيف لي اجفانها غزلت",32,"ت",1,0],["حاكاكَ أَنوَرُ مِثلَما حاكَيتَهُ","فيما مَضى فَتَبارَكَ الخَلّاقُ",33,"ق",1,0],["حَاكَتْ لَنَا أَيْدِي الْغَرَامِ مَطَارِفاً","غَزَلَ التَّوَلُّهُ فِي الْحَبِيبِ سَدَاهَا",34,"ا",3,0],["حَاكَ الرَّبيعُ لَهَا منْ صَوْبِهِ حِبراً","كأَنَّها الحُلَلُ الأَفْوافُ والصحُفُ",35,"ف",1,0],["حاكِمُ الرَأيِ في القَريضِ فَقَد أَص","بَحَ في الشِعرِ أَعدَلَ الحُكّامِ",36,"م",1,0],["حاكتْ عَلَى البحر لما أَزمعتْ غسلاً","غلالةً أَين منها كل حيّاك",37,"ك",1,0],["حاكَ النَصيحُ فَلَم يَرُق","في فِكرَتي القَولَ النَصيعُ",38,"ع",1,0],["حاكِم إلى بَكجُورَ كلَّ مُلِمَّةٍ","فَحُسامُه لكَ في المُلمَّةِ حاكِمُ",39,"م",1,0],["حاكِمٌ لا تَرَى لَهُ أبدَ الدَّه","رِ سِوَى الدَّهرِ وَحده مَظلُوما",40,"م",2,0],["حاكِمٌ عادِلُ الحكُومَةِ إلا","في عَطاياهُ والعُفاةُ خُصُومُ",41,"م",1,0],["حاكياً ومضُه وضوءُ سناه","من سُليمى تَبَسُّماً وجبينا",42,"ن",2,0],["حاكمٌ بالعدل علويُّ الثنا","عن عليٍّ قام بالحكم مقاما",43,"م",2,0],["حاكت الأفلاك في قوس لذا","ساريات الافق فيها اشرقت",44,"ت",1,0],["حاكي سليمان الحكيم بحكمة","وإلى سليمان الكريم حكيم",45,"م",1,0],["حاكت دوائر أفلا مطالعها","أو كالثريا بدت حسنا بمرتسم",46,"م",1,0],["حاكم الشهباء فيما قد غبر","ذاك سيف الدولة القرم المجيد",47,"د",1,0],["حاكت بهنَّ من القريضِ رسالةً","ألْقَتْ إِليَّ بودّها تأنيسا",48,"س",2,0],["حاكياتٌ وقد تكسرنَ ما بي","ن شقيقِ الكلوم نورَ الأقاح",49,"ح",1,0],["حاكم بالهدى مصيبٌ فلا تق","رع في ساحتيه صم العصي",50,"ي",1,0],["حاكت كتاب كليلةٍ","فمتى ترى كأخيهِ دمنة",51,"ن",2,0],["حاكى مواعيد الغواني خلباً","وأراد أن يحكي الثغور فأومضا",52,"ض",2,0],["حاكَ الربيعُ عليه مِن سحائبهِ","بَرداً يُوَشِّعُ في ساحاتهِ النَّفَلا",53,"ل",2,0],["حاكَ الغمامُ لها مِن وشيهِ حُلَلاً","فيها فيا حسنَ ما وشَّى وما رَقَما",54,"م",2,0],["حاكني النجم بترك للكرى","خانة الليل بليل غضبا",55,"ب",2,0],["حاكَتْ زُجاجةُ كأسِها القنديلَ إذ","مِشكاتُها اِتّقدَتْ بلا زَيتونِ",56,"ن",1,0],["حاكيت نيلك إذ غمرت بلادنا","بعوارف فاضت على الأرجاء",57,"ا",2,0],["حاكت ملائكة السما يصلاحها","وفؤادها من كل قلب ارحم",58,"م",1,0],["حاكى أخاهُ أبا محمّد هيبة","وَحَكى أخاه أبا العليّ كمالا",59,"ل",2,0],["حاكم أنت في الصفاتِ وبالإس","مِ وبالجودِ