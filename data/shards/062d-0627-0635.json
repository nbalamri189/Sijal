m/ViewPoem.aspx?id=184760",""],[5111,"طعْنَةً","https://www.poetsgate.com/ViewPoem.aspx?id=212315",""],[5150,"القصيدة الأخيرة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203084",""],[5387,"حضارة الغاب","https://www.poetsgate.com/ViewPoem.aspx?id=53796",""],[5410,"ما عاد في العمر اتساعٌ للصدى","https://www.poetsgate.com/ViewPoem.aspx?id=78958",""],[5533,"يا عُرَاةً من ضَمِيْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=176716",""],[5542,"الأمل القادم","https://www.poetsgate.com/ViewPoem.aspx?id=10027",""],[5550,"أيها الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=212912",""],[5573,"الله وكيلي","https://www.poetsgate.com/ViewPoem.aspx?id=200181",""],[5573,"يا سحابه حال قطرك دون شوفك سامحيني","https://www.poetsgate.com/ViewPoem.aspx?id=205472",""],[5739,"كم ليل صحيته","https://www.poetsgate.com/ViewPoem.aspx?id=126411",""],[6171,"غرفتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86323&r=&rc=6",""],[6212,"مُكَاشَفَاتٌ أَخِيْرَةٌ في مَهَبِّ اللَّيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1623&r=&rc=4",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""],[6288,"رسالة تعزية إلى علي بن الجهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76417&r=&rc=3",""],[6328,"حتّى متى ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84883&r=&rc=24",""]],"verses":[["حاصوا خَصاصاتِ قُرَيشٍ بِالقَنا","شَوارِعاً وَجَمَّعوا شَعاعَها",0,"ع",3,0],["حاصلاتٍ وهُنَّ من عظم القَدْ","رِ كَبَعْضِ المُنَى أوِ الأحلامِ",1,"م",1,0],["حاصِدٌ حَقلَهُ الوجود وَما الأَحياءُ","إِلّا كَشَوكِه وَنَباتِه",2,"ت",2,0],["حاصَرُوا مكَّةَ في صُيّانَةٍ","عَقَدوا خيرَ حبىً في خيرِ ناد",3,"د",1,0],["حاصر من معارف القوم ما يف","تح للسكالكين باب المراد",4,"د",1,0],["حاصَرَ الطائفَ النبيُّ على إِث","رِ حُنينٍ وصحبهُ الأقوياءُ",5,"ا",2,0],["حاصرتموني وحلتم دون إحساني","كما أود وجُزتُم كل حسباني",6,"ن",2,1],["حاصر فاحْتملتِ عدا فابتسَمْ","تِ فما رقّ أو لانَ بلْ فسَقا",7,"ق",2,0],["حاصل الأمر كله ليس غير ال","علم بالله أهله العلماء",8,"ا",2,0],["حاصل الأمر لا أنا أبداً","حاش لله أن أكون أنا",9,"ن",2,0],["حاصل الأمر جمال كله","ظاهر في الكون عفواً وانتقاما",10,"م",2,0],["حاصل التحصيل لكن ينبغي","أنت في دور منيع في دور",11,"ر",1,0],["حَاصِدٍ لِلْعِدَى بِأَقْلاَمِ رَأْيٍ","تَقْطَعُ السيفَ عَنْدَ حَمْيِ الْوَطِيسِ",12,"س",1,0],["حاصر من معارف القوم ما يف","تح للسالكين بابَ المراد",13,"د",1,0],["حاصرَ القلبَ ليس في الأذن سمعي","لم يفده وقلبيَ الحصن نصح",14,"ح",1,0],["حاصوا كحمر الوحش من حينهم","وأضطرب المجلس أحيانا",15,"ن",2,0],["حاصروها وما الذي بانَ من ذَب","كَ عنها وحفظها محصورُ",16,"ر",1,0],["حاصرونا في بحرنا مابنا رجلٍ رشيد","جوعو اطفال غزه مابنا من صدها",17,"د",3,0],["حاصَرْتْ بَك نَفسي, وكانت نَفَسْ","واظمَيتْ بَك رُوحِي, وكانت سَحَابْ",18,"ب",1,0],["حاصَرَتنِي بنارِها.. ثُمَّ لَمَّا","صَعَّرَ القلبُ خَدَّهُ مِنهُ عَبَّتْ",19,"ت",1,0],["حَاصَرُوكَ وما وَثَبُوا","ناصَرُوكَ وما دَرَأُوا",20,"ا",1,0],["حاصروا الإصلاحَ في كل النواحي","ينشرون السوءَ مِن نادٍ لنادِ",21,"د",1,0],["حاصروني بحبّهم دونَ قيدٍ","ثمّ بعدَ الهيامِ فكّوا حِصاري",22,"ر",2,0],["حاصرتني فلم أجد غير حضنٍ","فرشه الشوك ضمَّني يا دروبي!",23,"ب",2,0],["حَاصَرَ الأوْطانَ أضحى سَابقًا","كلًَ ريحٕ... لَيتَهُ عنَّا انْحَرَفْ",24,"ف",1,0],["حاصِريني إنِ استطعتِ حِصاري","والزِمِيني إنِ استطعتِ مداري",25,"ر",2,1],["حَاصَرَتْنِي كَأسِيْرٍ","فِيْ قُيُودٍ حَضَّرَتَهَا",26,"ت",3,0],["حاصرْتِني بين الشعورِ وحدْسِهِ","واللاشعورُ اجتازَ عن ذاك الحصارْ",27,"ر",1,0],["حاصرها الرعب وأرهبها","تجار سلاحٍ وغذاءِ",28,"ا",2,0],["حاصرتني حتى دخلتِ مدائني","وغزوتِ قلباً كالقلاعِ مرمَّما",29,"م",2,0],["حاصِرُوْهُمْ لَنْ يَذِلُّوا","لَنْ يُبَالُوا بالمَصْيرِ",30,"ر",1,0],["حاصرتني في نصف دائرة الهوى","وأنا بحظي من حصارك قانع",31,"ع",1,0],["حاصَرتْني الظلماءُ منْ كلِّ صوْبٍ","فغَدتْ شرَّ حاجزٍ قدَّامي",32,"م",2,0],["حاصد كفافي مابعد جيت محتاج","عندي غناتي ماعدمت المحاصيل",33,"ل",1,0],["حاصرتني في فراقك من يسار ومن يميني","وامطرت فيها عيوني فقد من طول غيابه",34,"ب",2,0],["حاصرني اغيابك ... وزوّد خناقي.","عهد ٍ قطعته بالمحاني .... تمرجح.",35,"ح",1,0],["حاصر الأيام في ردهتها","ومشى يستلهم الدنيا الغيوبا !!",36,"ب",2,0],["حاصرْ حصانَكَ،لا هان الخيولُ! غداً","يأتيكَ دورُكَ ؛ فالجزّارُ ينتظِرُ!‏",37,"ر",1,0],["حاصِرْ شِفَاهيَ بالمقارضِ إنني","فوقَ الحصارِ مخلَّدٌ ومقرَّبُ",38,"ب",1,0],["حاصرها الظلم وقد داهمها الوصب","جاعت فكان قوتها (نشارة) الخشب",39,"ب",1,0],["حاصرتُها، قيّدتني، عُدْتُ منكسراً","دمي،دموعي،ضحايا الأمس ِوالحاضرْ",40,"ر",1,0]]}