{"poems":[[53,"اسقني فاليوم نشوان","https://www.aldiwan.net/poem29667.html","المديد"],[53,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[72,"هن الوجوه الناضره","https://www.aldiwan.net/poem18696.html","مجزوء الكامل"],[91,"يمشي الزمان بمن ترقب حاجة","https://www.aldiwan.net/poem8796.html","عموديه"],[70,"هات يا صاح غنني","https://www.aldiwan.net/poem42432.html","مجزوء الخفيف"],[70,"رق في الجو النسيم","https://www.aldiwan.net/poem42713.html","مجزوء الرمل"],[70,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[85,"مرحبا بالفتى العظيم الشان","https://www.aldiwan.net/poem7532.html","الخفيف"],[85,"كاتب محسن البيان صناعه","https://www.aldiwan.net/poem62841.html","الخفيف"],[45,"ما أنت للكلف المشوق بصاحب","https://www.aldiwan.net/poem10671.html","الكامل"],[45,"ما بعيني هذا الغزال الغرير","https://www.aldiwan.net/poem63566.html","الخفيف"],[66,"خذ أحاديثها من العارفيها","https://www.aldiwan.net/poem38639.html","الخفيف"],[66,"أنف الخمار من فرط خباها","https://www.aldiwan.net/poem39074.html","الرمل"],[66,"أرسلت في الكؤوس بالمعجزات","https://www.aldiwan.net/poem39185.html","الخفيف"],[66,"أذكروا لما أروها النديما","https://www.aldiwan.net/poem39208.html","الخفيف"],[66,"أوضحت نار خده للمجوس","https://www.aldiwan.net/poem39917.html","الخفيف"],[97,"رب ليلٍ قد صفا الأفق به","https://www.aldiwan.net/poem24358.html","الرمل"],[80,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[80,"عجبي من سكينتي ووقاري","https://www.aldiwan.net/poem31439.html","الخفيف"],[80,"أشهاب في دجى الليل ثقب","https://www.aldiwan.net/poem31545.html","الرمل"],[105,"طاف بالقوم يحيي المؤمنين","https://www.aldiwan.net/poem43102.html","الرمل"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[81,"هاتها كالمنار لاح النهار","https://www.aldiwan.net/poem61524.html","الخفيف"],[52,"قد نعا الديك الظلاما","https://www.aldiwan.net/poem26681.html","مجزوء الرمل"],[52,"من لأذني بعذول","https://www.aldiwan.net/poem26728.html","مجزوء الرمل"],[52,"ونديم قمرته","https://www.aldiwan.net/poem26983.html","مجزوء الرمل"],[48,"عاذلي في المدام غير نصيح","https://www.aldiwan.net/poem62497.html","الخفيف"],[48,"باكر اليوم الصبوحا","https://www.aldiwan.net/poem62517.html","مجزوء الرمل"],[48,"أحي لي يا صاح روحي","https://www.aldiwan.net/poem62519.html","مجزوء الرمل"],[48,"غرد الديك الصدوح","https://www.aldiwan.net/poem62532.html","مجزوء الرمل"],[48,"اسقني سبعا تباعا","https://www.aldiwan.net/poem64378.html","مجزوء الرمل"],[48,"اسقني واسق ذفافه","https://www.aldiwan.net/poem64391.html","مجزوء الرمل"],[48,"اسقني يا ابن أذين","https://www.aldiwan.net/poem65290.html","مجزوء الرمل"],[76,"ذكرت من طيزناباذ","https://www.aldiwan.net/poem39331.html","المديد"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39612","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/3821","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24804","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54314","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[106,"مضيفة الطائرة","https://www.poetsgate.com/ViewPoem.aspx?id=179675",""],[106,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""]],"verses":[["قَهوَةً ما زالَ يَقلَقُ مِن","مُجتَناها المِسكُ وَالبانُ",0,"ن",1,0],["قَهقَروا الشِركَ عَلى أَعقابِهِ","بَعدَما اِستَقدَمَ غَيّاً وَضِرارا",1,"ر",2,0],["قهرت حماة ليَ العِدى","فحماة عندي القاهره",2,"ر",2,0],["قَهَرَ الوَرى وَأَذَلَّهُم أَنَّ الوَرى","مُتَعَلِّلٌ أَو طامِعٌ أَو مُجتَدِ",3,"د",1,0],["قَهوَةٌ ذاتُ بَهجَةٍ","في قُلوبٍ وَأَعيُنِ",4,"ن",1,0],["قَهوَةٌ رَقَّت فَما في","كَأسِها إِلّا نَسيمُ",5,"م",1,0],["قَهَرَ الزَمانَ وَقَد عَراني صَرفُهُ","حَتّى مَشى في خِدمَتي مُتَرَجَّلا",6,"ل",2,0],["قهرت أربعين شعبا إلى أن","قبرتها طوارق الحدثان",7,"ن",1,0],["قَهَرَ المَوتَ وَالحَياةَ وَقَد تَح","كُمُ في رائِضِ السِباعِ سِباعُه",8,"ع",2,0],["قَهَرَ الأُمورَ بَديهَةً كَرَوِيَّةٍ","مِن حازِمٍ وَقَريحَةً كَتَجارِبِ",9,"ب",1,0],["قَهَرَ الدَهرَ أَوَّلاً وَأَخيراً","بِحِجىً مِنهُ أَوَّلٍ وَأَخيرِ",10,"ر",1,0],["قَهوَةٌ لا يَخافُ شارِبُها الحد","دَ وَلا تَجعَلُ الحَليمَ سَفيها",11,"ي",3,0],["قَهوَةٌ لَو قيلَ لِلشَمسِ اِسجُدوا","وَبَدَت حُقَّت عَلى الناسِ اِشتِباها",12,"ا",3,0],["قَهوَةٌ بَردُها يَنوبُ عَنِ الما","ءِ وَتُغني طَوراً عَنِ الأَقواتِ",13,"ت",1,0],["قَهوَةٌ أَفنَتِ الزَمانَ فَأَفنى ال","رَطبَ مِن جِرمِها وَأَبقى الصَميما",14,"م",2,0],["قَهوَةً تَحسُدُ العَمائِمَ لا تَس","كُنُ لَمّا تُدارُ غَيرَ الرُؤوسِ",15,"س",1,0],["قهقه الرعدُ ودوَّى ساخراً","فكأنَّ الرعدَ عربيدٌ سكر",16,"ر",1,0],["قَهَرَتْ ظُبَا توحيده تثليثَهمْ","وقَضى بذاكَ الواحِدُ القهّارُ",17,"ر",1,0],["قهوةٌ مَزّقَتْ بكفِّ سناها","بُرْقُعَ اللَّيلِ عَن مُحَيّا النَّهارِ",18,"ر",1,0],["قهوَةً لو سُقِيَتْها صخرةٌ","أورقتْ باللّهو منها والطّرب",19,"ب",1,0],["قَهَرَ الطاغوتَ في عُبّادِهِ","وَقَضى المَوتَ عَلَيهِم أَجمَعينْ",20,"ن",1,0],["قهروها صِناعةً أعجبُ الأرْ","بابِ ما كان عاجزاً مقهورا",21,"ر",2,0],["قَهوَةٌ إِن جَرى النَسيمُ عَلَيها","كادَ يَعلوهُ مِن سَناها اِحمِرارُ",22,"ر",1,0],["قَهوَةٌ بِنتُ دِنانٍ","عُتِقَت خَمسينَ عاما",23,"م",2,0],["قَهوَةٍ تَذهَبُ عَنّا","بِهُمومٍ وَعُقولِ",24,"ل",1,0],["قَهوَةٌ سُرُّ القَذى مِن","ها لِعَينَيكَ جُبار",25,"ر",1,0],["قَهوَةٌ تَترُكُ الصَحيحَ سَقيماً","وَتُعيرُ السَقيمَ ثَوبَ الصَحيحِ",26,"ح",1,0],["قَهوَةً تُقرِنُ في جِس","مِكَ مَع روحِكَ روحا",27,"ح",2,0],["قَهوَةً صَهباءَ بِكراً","غُرِسَت أَزمانَ نوحِ",28,"ح",1,0],["قَهوَةً تَذكُرُ نوحاً","حينَ شادَ الفُلكَ نوحُ",29,"ح",1,0],["قَهوَةٌ يَحسَبُها النا","ظِرُ إِن صُبَّت شُعاعا",30,"ع",2,0],["قَهوَةً ذاتَ اِختِيالٍ","سَلِمَت مِن كُلِّ آفَه",31,"ف",2,0],["قَهوَةً عُمِّيَ عَنها","ناظِرا رَيبِ المَنونِ",32,"ن",1,0],["قَهوةً لَيْسَتْ بِبَاذِقةٍ","لا وَلا بِتْعٍ ولا داذِي",33,"ذ",2,0],["قهَرَ الطبيعةَ صيفَها وشتاءَها","حتى أتاهُ شِتاؤكِ القهَّارُ",34,"ر",1,0],["قهرتني واستذلّتني بها","غيرَةٌ ينهشُ قلبي عقرباها",35,"ا",3,0],["قَهوَةً عَتَّقَها خَمّارُها","زَمَناً في الدَنِّ بَحتاً وَحَبَس",36,"س",1,0],["قهقهت من شائديه الجهل","أنا لو خيرت لاخترت البقا",37,"ق",2,0],["قهوةٌ عن طرائف الطِّيب تُقْهِي","شاربيها إذا أُديرت وتُغني",38,"ي",1,0],["قَهَرَتْ صَوْلَةَ الزمان وكانتْ","قَبَسَ النور في شبابِ الزمان",39,"ن",1,0],["قهروا الزمانَ ولن تضيعَ كرامةٌ","للحقِّ بين أسِنةٍ ورماح",40,"ح",1,0],["قهوةٌ أَغدقت عليها قليلاً","من سواد العُيون والأهداب",41,"ب",1,0],["قهرته برقة الحَبَاب","والنسمات الحلوة الرِّطاب",42,"ب",1,0]]}