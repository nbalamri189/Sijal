{"poems":[[92,"غنني أنشودة الفجر الضحوك","https://www.aldiwan.net/poem38961.html","الرمل"],[56,"سمعوا الصلاة على النبي توالى","https://www.aldiwan.net/poem58532.html","الكامل"],[45,"لا يبعد اللهو في أيامنا المودي","https://www.aldiwan.net/poem63451.html","البسيط"],[105,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[409,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[575,"إني ثنيت عن الحبيب عناني","https://www.aldiwan.net/poem2848.html","الكامل"]],"verses":[["أَنْ يُثِيرَ الشَّدْوُ في صَمْتِ الفُؤَادْ","أَنَّةَ الأَوْتَارْ",0,"ر",1,0],["إِنْ يُثْنَ مَنْ صَلّى عليهِ كَرامَةً","فاللّهُ قَدْ صَلّى عليهِ تَعالَى",1,"ل",2,0],["إِن يَثلِمِ الحُبُّ في رَأيٍ فَرُبَّتَما","عَزمٍ ثَلَمتُ بِهِ صُمَّ الجَلاميدِ",2,"د",1,0],["إن يَثْقُلِ العِبءُ الذي حُمِّلتَهُ","فَلما يُحمَّلُ ذو التَّباعةِ أثقلُ",3,"ل",1,0],["أنَّى ثَوى اللَّيْثُ فَهو الخِيْسُ للأسَدِ","ولستُ آسَى على التَّرحالِ عن بَلد",4,"د",1,0],["إِنِّي ثَنَيْتُ عن الحبيبِ عناني","وأَطَعْت فيه دَوَاعِيَ السُّلوانِ",5,"ن",1,1]]}