{"poems":[[79,"وجودك حي الملك والدين والدنيا","https://www.aldiwan.net/poem35717.html","الطويل"],[53,"تلق نصيحتي يا ابن الوزير","https://www.aldiwan.net/poem62978.html","الوافر"],[45,"أنا منك بين فضائل ومكارم","https://www.aldiwan.net/poem10142.html","الكامل"],[45,"فؤاد ما تسليه المدام","https://www.aldiwan.net/poem10538.html","الوافر"],[54,"عليك بذا وذا واقطع وواصل","https://www.aldiwan.net/poem26856.html","الوافر"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54235","الوافر"],[102,"لعيني أم بلقيس","https://www.poetsgate.com/ViewPoem.aspx?id=50431",""],[147,"لا فات ملكك ما أعيا به الطلب","https://www.aldiwan.net/poem11730.html","البسيط"],[147,"ما مرتقاك على من رامه أمم","https://www.aldiwan.net/poem11824.html","البسيط"],[190,"لقد هاج لي الوجد","https://www.aldiwan.net/poem43978.html","الهزج"],[201,"غادة حطم الفؤاد بكاها","https://www.aldiwan.net/poem39820.html","الخفيف"],[285,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[369,"خيال زائر مني خيالا","https://www.aldiwan.net/poem60676.html","الوافر"],[369,"أحن إلى تلك الضحى والأصائل","https://www.aldiwan.net/poem60806.html","الطويل"],[422,"رمى ولم يرم عن قوس ولا وتر","https://www.aldiwan.net/poem54110.html","البسيط"],[438,"طرحنا فوق غاربها الزمانا","https://www.aldiwan.net/poem12375.html","الوافر"],[445,"عيد ووعد صادق لك بالمنى","https://www.aldiwan.net/poem34852.html","الكامل"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82790","الطويل"],[666,"","https://poetry.dctabudhabi.ae/diwan/poem/147421","الكامل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110441","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48741","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48705","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38281","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115981","الوافر"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82518","المجتث"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48922","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127999","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124742","البسيط"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99058","الهزج"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123040","الرجز"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110347","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110345","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28014","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87736","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87322","الرجز"],[2761,"","https://poetry.dctabudhabi.ae/diwan/poem/45537","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205438","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87354","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112680","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74059","البسيط"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105841","الطويل"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33123","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133286","الوافر"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44900","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90840","الوافر"],[4261,"","https://poetry.dctabudhabi.ae/diwan/poem/124290","الطويل"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123465","البسيط"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139129","الرمل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66138","الكامل"],[4755,"رَحَلَت يَدَاكِ.. فَأَينَ أَختَبئُ","https://www.poetsgate.com/ViewPoem.aspx?id=184119",""],[4759,"ومن أحرى بحبك؟","https://www.poetsgate.com/ViewPoem.aspx?id=204362",""],[4767,"نبع الإيثار","https://www.poetsgate.com/ViewPoem.aspx?id=197294",""],[5046,"من عاند الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=198513",""],[6212,"جُبَر.. ومئةُ عامٍ من المطر!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1625&r=&rc=6",""],[2220,"إنَّ المقرَ من يستعبدْ الدولا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11722&r=&rc=592",""],[6344,"طُقُوسُ العاشِقين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87967&r=&rc=7",""]],"verses":[["ومنْ أحْمَرٍ تحْتَ العَجاجِ كأنّهُ","سَنا شَفَقٍ يلْتاحُ في اللّيْلَةِ الدَّجْيا",0,"ي",2,0],["ومن إحلال قارعةٍ بنفسٍ","رجتك لدى مخاذلة النصير",1,"ر",1,0],["وَمِنِ اِحتِقارِكَ كُلَّ ما تَحبو بِهِ","فيما أُلاحِظُهُ بِعَينَي حالِمِ",2,"م",1,0],["وَمَن إِحدى فَوائِدِهِ العَطايا","وَمَن إِحدى عَطاياهُ الدَوامُ",3,"م",1,0],["وَمَن أَحبَبتَ فَاِعذِر وَاِسلُ عَنهُ","وَمَقلوبُ الوَفا أَن لا تَدَعهُ",4,"ه",1,0],["ومن أحصَى مآثرك الغوالي","فقد أحصى نجومَ الليل عدّا",5,"د",2,0],["ومن أحلام أطفالي","ومن أطياف أمواتي",6,"ت",2,0],["وَمَن أَحَقُّ بِذا التَنويهِ مِن مَلِكٍ","ماضي الغِرارِإِذا ما كَلَّتِ القُضُبُ",7,"ب",1,0],["وَمَن أَحَقُّ بِمُلكِ الأَرضِ مِن مَلِكٍ","بِسَيفِهِ اِنكَشَفَت عَن أَهلِها الغُمَمُ",8,"م",1,0],["ومن أحلافنا قوم","فمن مولى ومن عبد",9,"د",1,0],["ومن أحضانه أعدّ لها قب","راً وهذا ما اختاره أبواها",10,"ا",3,0],["وَمِنْ أَحْمَرٍ شابَهُ زُرْقَةٌ","حَكى الْوَجَناتِ إِذا تُقْرَصُ",11,"ص",1,0],["ومَنْ أَحمدْتَ أَنت له خِلالاً","فلا تَدعنَّه يشكو اخْتِلالا",12,"ل",2,0],["ومِنْ أحوَرِ العَينَيْنِ في القُرْب سائفٍ","بألحاظِهِ سِحْراً وفي البُعْدِ نابل",13,"ل",1,0],["ومن أحبُّ كما أهواه معتنقي","ومرشفي السّكَّر المصريّ في السكر",14,"ر",1,0],["ومِنْ أَحكامِهِ أَنْ ليسَ يُبْقَي","على الأَحرارِ للدهرِ احْتِكاما",15,"م",2,0],["ومنِ احْتَذَى من كلِّ بانٍ للعُلا","مَثَلاً وَلَمْ يُغْفِلْ عِمارَةَ مَا بَنى",16,"ن",2,0],["وَمَن أَحرَق العَذراء يَوماً تَشفيا","فَلَيسَ بِمُستثنِ مَسنا وَأَمردا",17,"د",2,0],["ومن احتمال حكاية","اخرى سنرحل لاحتمال",18,"ل",1,0],["ومَن أحرَى بطول الحزن مني","وأَجرَى في الأَسَى دمعاً هَطُولا",19,"ل",2,0],["ومن أحب فتى أصفى إخاه له","إن كان يوماً على الإثنين يتكل",20,"ل",1,0],["ومن أحبَّ اغتدى","يقول إني براء",21,"ا",2,0],["وَمِن أَحمَرٍ وردٍ أَغرَّ محجَّلٍ","وَغرَّتُه كَالنَّجمِ وَالنَّجمُ ثاقِبُ",22,"ب",1,0],["ومن أحمر قد سود الليل ذيله","وأطرافه لما تغشاه عندم",23,"م",1,0],["ومن إحدى العجائب أن ليثاً","يُقادُ زِمامُهُ بيَدى غزالِ",24,"ل",1,0],["وَمَن أَحَق بعهد","من الأَمير المُؤَيَّد",25,"د",1,0],["ومن أَحسنِ اللذات في عيشة الفتى","معانقةُ الإخوان في ساعة اللِقا",26,"ق",2,0],["ومن أحب على لهوى يساعدنى","والدهر عبدى فلا أخشى من الغير",27,"ر",1,0],["ومن أحيل عليه فهو مرتجعٌ","على المحيل إذا ما قاعه جدبا",28,"ب",2,0],["ومنّا حافر الطرس","بلا خرطٍ ولا جهر",29,"ر",1,0],["ومَن أحلّ هجره","ووصله مَن حرّمه",30,"م",2,0],["ومناحة للضاد في أفيائها","من سفح لبنان إلى بغداد",31,"د",1,0],["ومناحةٍ في المعهد العلمي يعقدها","شبابٌ من رفاقِ صباكا",32,"ك",2,0],["ومَن أحال وجود الريّ فهو فتى","قد جاءه الأمر في الأذواق من قبل",33,"ل",1,0],["وَمَن أَحفَظ الآساد في أَجماتها","فَلا يُنكرَنَّ الوَثب ثمَّة وَالزَأرا",34,"ر",2,0],["ومَن أَحَبَّ مَعرفة الزامِ","وقسمةَ الجُمَّة بالتَّمامِ",35,"م",1,1],["ومن أحَبَّ معرفة الزَّوجي","دخولِهِ الأخنانَ والخروجِ",35,"ج",1,0],["وَمِنّا حُماةُ الجَيشِ لَيلَةَ أَقبَلَت","إِيادُ يُزَجّيها الهُمامُ المُحَرِّقُ",36,"ق",1,0],["ومناحيك مسرح الفكر تجلو","لخيالي مآلف التذكار",37,"ر",1,0],["ومن احاديثهُ راحٌ لسامعها","وَطيبُ أَنفاسهِ رَوحٌ وَرَيحانُ",38,"ن",1,0],["ومن أحبّ عملاً وما فعَل","أُشرِكَ يومَ البعثِ في ذاكَ العمَل",39,"ل",1,0],["ومن أَحبَّ الأَوطان يَغدو","لخصم أَوطانه خَصيما",40,"م",2,0],["ومن أحمرٍ كالارجوان إذا بدا","وكالراحِ صرفاً أو كخدٍّ مورّدِ",41,"د",1,0],["وَمَن أَحَقُّ بِمُلكِ الأَرضِ مِن مَلِكٍ","كَأَنَّهُ مَلِكٌ في الخَلقِ حَنانُ",42,"ن",1,0],["ومن أحيا لمولدكم شعاراً","جميل الوضع ليس له مثيل",43,"ل",1,0],["وَمِن اِحتَواكَ أَكُنتُ تَشعر بِالهَوى","يسري بِهِ سَريان بُرءٍ في السَقَمْ",44,"م",1,0],["ومن إحسانه المأثوران قد","أحل الدر في أبهى عقود",45,"د",1,0],["ومن أحسن الاشعار عندي نسيبها","ولم تلك الا بالنسيب معان",46,"ن",1,0],["ومن أحبَّ بنيهِ الأكرمين نجا","يوم اللقاء وحاز السُّؤالَ والأربا",47,"ب",2,0],["ومن احتجت إليه","أنت بالرغم أسيره",48,"ر",2,0],["ومَنِ احْتَمَى حَذَرَ الرَّدَى بِفِرارِهِ","يُقْصِدْهُ حَيْثُ يَفِرُّ سَهْمُ قَضائهِ",49,"ا",3,0],["ومَنِ احتَفَوا بالماءِ وهْو على","كَتِفِ الغَمَامِ.. ودُونَهُ ظَمِئُوا",50,"ا",1,0],["ومن أحرى بحبك غير أرض","رعتك بخيرها ونماك ورد",51,"د",1,0],["ومَن (أحُدٌ) فيها و(بدرٌ) حسامُه","نفوسَ ذوي الإضلال في النار أوردا",52,"د",2,0],["ومَنْ أحقُّ بهذا الثَّغر منك فتىً","لو أنَّه عن شفاهِ الشوق ما حُرما",53,"م",2,0],["ومَنْ أَحاطَ رِقَابَ الجِيْلِ مَأْثُرَةً","مِنْ بَعْدِهِ الجِيْلُ يَتْلُوْها ويَأْتَثِرُ",54,"ر",1,0],["ومَن أحال وجود الريّ فهو فتى","قدْ جاءَ الأمرُ في الأذواقِ من قبلِ",55,"ل",1,0],["وَمِنْ أَحْدَاقِ عَينَيكِ امْنَحِينِي","طَوَافًا حَوْلَ سِحْرِهِمَا وَسِحْرِكْ",56,"ك",1,0]]}