{"poems":[[39,"حتى طرقن خليجا دب جدوله","https://www.aldiwan.net/poem6479.html","البسيط"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[93,"أعد حديثك عندي أيها الرجل","https://www.aldiwan.net/poem9053.html","عموديه"],[94,"يا لاابتسامة قلب","https://www.aldiwan.net/poem38892.html","مجزوء الكامل"],[87,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[47,"أخفي هوى لك في الضلوع وأظهر","https://www.aldiwan.net/poem63638.html","الكامل"],[63,"هي الصوارم والخطية الذبل","https://www.aldiwan.net/poem51493.html","البسيط"],[107,"عرف الزمان مصارع الأبطال","https://www.aldiwan.net/poem43391.html","الكامل"],[104,"رسالة واها لها واها","https://www.aldiwan.net/poem33108.html","السريع"],[54,"يا دار يا دار أطرابي وأشجاني","https://www.aldiwan.net/poem26663.html","البسيط"],[54,"بان الخليط ولم يطق صبرا","https://www.aldiwan.net/poem27038.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85587","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39607","الكامل"],[47,"أُخْفي هَوًى لكِ في الضّلوعِ، وأُظهِرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31199",""],[113,"صاد الأسود بمقلة وسناء","https://www.aldiwan.net/poem16412.html","الكامل"],[164,"هنيته عيدا فصل وانحر","https://www.aldiwan.net/poem58821.html","الرجز"],[164,"لو يستطيع تخطي الأيام","https://www.aldiwan.net/poem58849.html","الطويل"],[234,"يا لائمي في أن خلعت العذار","https://www.aldiwan.net/poem51030.html","السريع"],[303,"وخميلة نسج الربيع برودها","https://www.aldiwan.net/poem36829.html","عموديه"],[369,"أهلا بوجهك من صباح مقبل","https://www.aldiwan.net/poem60681.html","الكامل"],[369,"أهكذا يسري القمر","https://www.aldiwan.net/poem60902.html","مجزوء الرجز"],[445,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[463,"قالوا عساك مرجم فتبين","https://www.aldiwan.net/poem55859.html","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61121","السريع"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130623","الكامل"],[1205,"","https://poetry.dctabudhabi.ae/diwan/poem/147706",""],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118301","البسيط"],[1929,"","https://poetry.dctabudhabi.ae/diwan/poem/110707","البسيط"],[2027,"","https://poetry.dctabudhabi.ae/diwan/poem/101858","الرجز"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110320","الكامل"],[2839,"","https://poetry.dctabudhabi.ae/diwan/poem/102198","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131948","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102933","الكامل"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119541","الرجز"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99123","البسيط"],[4718,"الله من قلبٍ الهمه يزمه","https://www.poetsgate.com/ViewPoem.aspx?id=137299",""],[4760,"دنيتي والله بدونك لا تُعد","https://www.poetsgate.com/ViewPoem.aspx?id=35824",""],[4767,"طود العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=94353",""],[4767,"مركز الماجد","https://www.poetsgate.com/ViewPoem.aspx?id=97448",""],[4767,"سفينة النجاة","https://www.poetsgate.com/ViewPoem.aspx?id=179958",""],[4869,"التطفل","https://www.poetsgate.com/ViewPoem.aspx?id=137910",""],[5030,"لا تبعدي","https://www.poetsgate.com/ViewPoem.aspx?id=215657",""],[5431,"ليلاه تعرفه في العشق منفردا","https://www.poetsgate.com/ViewPoem.aspx?id=197753",""],[5561,"ومضة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=193806",""],[5956,"أيها البحر الحبيب ‏","https://www.poetsgate.com/ViewPoem.aspx?id=183232",""],[6147,"سفر على الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=151691",""],[6180,"الأعداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81071&r=&rc=5",""]],"verses":[["حتى طرقن خليجاً دب جدوله","من المعين عليه البُتر تصطخبُ",0,"ب",1,1],["حتَّى طوى الأفق رداء الورس","والْتقمَ المغرب قرص الشمس",1,"س",1,0],["حَتّى طَلَعتَ مِنَ القوقاسِ في لَجِبٍ","تَضيقُ عَنهُ فِجاجُ الأَرضِ وَالسُبُلُ",2,"ل",1,0],["حتَّى طَوَتْهُ منَ","العاصِفاتِ رِيحٌ شَرُودُ",3,"د",1,0],["حَتّى طَلَعتَ عَلى أَزميرَ في فَلَكٍ","مِن نابِهِ الذِكرِ لَم يَسمُك عَلى الشُهُبِ",4,"ب",1,0],["حَتّى طَلَعتَ بِضَوءِ وَجهِكَ فَاِنجَلى","ذاكَ الدُجى وَاِنجابَ ذاكَ العِثيَرُ",5,"ر",1,0],["حتّى طَلَعْتَ على طَرسوسَ مُبتَسِماً","كما تَبسَّمَ فيها العارضُ الهَطِلُ",6,"ل",1,0],["حَتّى طَواكَ المَوتُ غَيرَ مُجامِلٍ","شَعباً يُجِلُّكَ أَيَّما إِجلالِ",7,"ل",1,0],["حَتّى طَغى الصُبح بِأَنواره","عَلى نُجوم اللَيل يَغشاها",8,"ا",3,0],["حَتّى طَوَيتُ عَلى أَحشاءِ ناجِيَةٍ","كَأَنَّما خَلقُها تَشيِيدُ بُنيانِ",9,"ن",1,0],["حَتّى طَرَقتُ عَلى مُخاطَرَةٍ","أَطَأُ الصَوارِمَ وَالقَنا السُمرا",10,"ر",2,0],["حتى طلعت مضيئاً","كما تضيء الدراري",11,"ي",1,0],["حتى طَلَعْتَ بهِ فكنتَ حديثهُ","عجباً وأيُّ عجائبِ الأنباءِ",12,"ا",2,0],["حتّى طَلَعتَ بضَوْءِ وَجهِكَ فانجلتْ","ذاكَ الدّجَى وانجابَ ذاكَ العِثْيَرُ",13,"ر",1,0],["حَتّى طَعنت بأَسمر مِن قَدِهِ","وَقَتَلت مِن أَلحاظِهِ بِظِباءِ",14,"ا",2,0],["حتى طلعتَ مطلع الشمس ضحىً","يقهرّ ضوءُها مبادى النظر",15,"ر",1,0],["حتى طلعتَ بنور وجهك فانجلى","ذاك العمى وانجاب كلَ قَتامِ",16,"م",1,0],["حتى طرقتُ الحيَّ من وائل","ولجوّ مكحول النواحي بِقار",17,"ر",1,0],["حتى طلعتِ فكنتِ أحسنَ طلعة","من باسمِ النوارِ في أكمامه",18,"م",2,0],["حتّى طلَعْتَ معَ السُّعودِ فأصبحَتْ","تلك الخُطوبُ عن النَّواظرِ تَنْجَلي",19,"ل",2,0],["حتّى طرقْنا عن عَفَر","فِناءَ عزٍّ مُحْتَضَر",20,"ر",1,0],["حَتَّى طَلَعْتَ لَهُم بأسعدِ غرَّةٍ","طَلَعَتْ عَلَيْهِم فِي السَّماء سُعودُها",21,"د",3,0],["حتى طلعتَ فكنتَ شمسا مزَّقتْ","بيد الشَّمال ضبابَ يومٍ مُدجنِ",22,"ن",1,0],["حَتّى طَوَت لَيل السرى دونَهُم","كَأَن من نهواه عَنهُ الفرار",23,"ر",1,0],["حتى طغوا وبغوا ومن كفر أبوا","منها البكاء على عظيم مصابها",24,"ب",3,0],["حتى طلعتم لدى عجاج","كالليل غشّى من النواحي",25,"ح",2,0],["حتى طوى خير عدنان على ججر","كشحا ولو شاء دنياها فاق كسراها",26,"ا",3,0],["حتى طرقت كناس الخود مزدهيا","ولم ترعني بطعن السمر خرصان",27,"ن",1,0],["حتى طرقت الخدر نضواً سحراً","وملء أجفاني سهد وأرق",28,"ق",1,0],["حتى طلعت وكل بؤس مختفٍ","لما طلعت وكل سعد باد",29,"د",1,0],["حتى طرقت حجالة في سحرة","فكأنني نجم عليه قد هوى",30,"و",2,0],["حتى طلعت على الكنانة كوكبا","وأذعت ما نلقاه من أكدار",31,"ر",1,0],["حتى طويت بغيرهم عن ذكرهم","كالقشر يطوي فيه كل لباب",32,"ب",1,0],["حتى طرقت فنسيت ما مضى","سألته حويجة فأعرضا",33,"ض",2,0],["حتى طلعت وعين السعد ترمقني","كالصبح منبلجاً عن حالك الظلم",34,"م",1,0],["حتى طفح كيله وكزه الفمه","مسامعا للناس تسمع وتشريه",35,"ي",2,0],["حتى طيفك لو جفاني وابتعد","شاعر ٍ بك في جميع الامكنه",36,"ن",2,0],["حتى طغت بين العباد مساوىء","ومكاره وفوادح ومظالم",37,"م",1,0],["حتى طلوع الفجر بعد الدجى","يعلن عن موقفه الصامد",38,"د",1,0],["حتى طغت أمواجه تُخفي الذي","أبديتمُ للمسلمين فما بدا",39,"د",2,0],["حتى طيوري مآتت بليّا نذير","وانكسر غصن الغلآ في وآحتي",40,"ت",2,0],["حتى طيور الجو في خفقانِها","كقلوبنا عند الوداعِ تُرفرِفُ",41,"ف",1,0],["حتى طويت به الأشجان حالمة","أسري مشعشة الآمال إنْ وعدا",42,"د",2,0],["حتى طغى الوجد في عينيك منسكبا","يا ظلمُهُ الوجد ممّا قد جنى الغِمر",43,"ر",1,0],["‏ ‏حتى طعامهمُ هو الطُّعْم الذي","‏ ‏ لا يترك الأسماك فيك لتشبعَك",44,"ك",1,0],["حتى طُرِحنا وبات الرَّايُ منتكسا","هاجتْ على وطئه الأحْقادُ في النَّزَقِ",45,"ق",1,0],["حتّى طواحينُ الهواءِ مشتْ","وزوارِقُ \"ابنِ زِيادَ\" يَشتَعِلُ",46,"ل",1,0]]}