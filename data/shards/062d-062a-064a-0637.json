{"poems":[[37,"حتى طرقن خليجا دب جدوله","https://www.aldiwan.net/poem6479.html","البسيط"],[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[91,"أعد حديثك عندي أيها الرجل","https://www.aldiwan.net/poem9053.html","عموديه"],[92,"يا لاابتسامة قلب","https://www.aldiwan.net/poem38892.html","مجزوء الكامل"],[85,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[45,"أخفي هوى لك في الضلوع وأظهر","https://www.aldiwan.net/poem63638.html","الكامل"],[61,"هي الصوارم والخطية الذبل","https://www.aldiwan.net/poem51493.html","البسيط"],[105,"عرف الزمان مصارع الأبطال","https://www.aldiwan.net/poem43391.html","الكامل"],[102,"رسالة واها لها واها","https://www.aldiwan.net/poem33108.html","السريع"],[52,"يا دار يا دار أطرابي وأشجاني","https://www.aldiwan.net/poem26663.html","البسيط"],[52,"بان الخليط ولم يطق صبرا","https://www.aldiwan.net/poem27038.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85587","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39607","الكامل"],[45,"أُخْفي هَوًى لكِ في الضّلوعِ، وأُظهِرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31199",""],[107,"صاد الأسود بمقلة وسناء","https://www.aldiwan.net/poem16412.html","الكامل"],[158,"هنيته عيدا فصل وانحر","https://www.aldiwan.net/poem58821.html","الرجز"],[158,"لو يستطيع تخطي الأيام","https://www.aldiwan.net/poem58849.html","الطويل"],[227,"يا لائمي في أن خلعت العذار","https://www.aldiwan.net/poem51030.html","السريع"],[296,"وخميلة نسج الربيع برودها","https://www.aldiwan.net/poem36829.html","عموديه"],[362,"أهلا بوجهك من صباح مقبل","https://www.aldiwan.net/poem60681.html","الكامل"],[362,"أهكذا يسري القمر","https://www.aldiwan.net/poem60902.html","مجزوء الرجز"],[436,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[456,"قالوا عساك مرجم فتبين","https://www.aldiwan.net/poem55859.html","الكامل"]],"verses":[["حتى طرقن خليجاً دب جدوله","من المعين عليه البُتر تصطخبُ",0,"ب",1,1],["حتَّى طوى الأفق رداء الورس","والْتقمَ المغرب قرص الشمس",1,"س",1,0],["حَتّى طَلَعتَ مِنَ القوقاسِ في لَجِبٍ","تَضيقُ عَنهُ فِجاجُ الأَرضِ وَالسُبُلُ",2,"ل",1,0],["حتَّى طَوَتْهُ منَ","العاصِفاتِ رِيحٌ شَرُودُ",3,"د",1,0],["حَتّى طَلَعتَ عَلى أَزميرَ في فَلَكٍ","مِن نابِهِ الذِكرِ لَم يَسمُك عَلى الشُهُبِ",4,"ب",1,0],["حَتّى طَلَعتَ بِضَوءِ وَجهِكَ فَاِنجَلى","ذاكَ الدُجى وَاِنجابَ ذاكَ العِثيَرُ",5,"ر",1,0],["حتّى طَلَعْتَ على طَرسوسَ مُبتَسِماً","كما تَبسَّمَ فيها العارضُ الهَطِلُ",6,"ل",1,0],["حَتّى طَواكَ المَوتُ غَيرَ مُجامِلٍ","شَعباً يُجِلُّكَ أَيَّما إِجلالِ",7,"ل",1,0],["حَتّى طَغى الصُبح بِأَنواره","عَلى نُجوم اللَيل يَغشاها",8,"ا",3,0],["حَتّى طَوَيتُ عَلى أَحشاءِ ناجِيَةٍ","كَأَنَّما خَلقُها تَشيِيدُ بُنيانِ",9,"ن",1,0],["حَتّى طَرَقتُ عَلى مُخاطَرَةٍ","أَطَأُ الصَوارِمَ وَالقَنا السُمرا",10,"ر",2,0],["حتى طلعت مضيئاً","كما تضيء الدراري",11,"ي",1,0],["حتى طَلَعْتَ بهِ فكنتَ حديثهُ","عجباً وأيُّ عجائبِ الأنباءِ",12,"ا",2,0],["حتّى طَلَعتَ بضَوْءِ وَجهِكَ فانجلتْ","ذاكَ الدّجَى وانجابَ ذاكَ العِثْيَرُ",13,"ر",1,0],["حَتّى طَعنت بأَسمر مِن قَدِهِ","وَقَتَلت مِن أَلحاظِهِ بِظِباءِ",14,"ا",2,0],["حتى طلعتَ مطلع الشمس ضحىً","يقهرّ ضوءُها مبادى النظر",15,"ر",1,0],["حتى طلعتَ بنور وجهك فانجلى","ذاك العمى وانجاب كلَ قَتامِ",16,"م",1,0],["حتى طرقتُ الحيَّ من وائل","ولجوّ مكحول النواحي بِقار",17,"ر",1,0],["حتى طلعتِ فكنتِ أحسنَ طلعة","من باسمِ النوارِ في أكمامه",18,"م",2,0],["حتّى طلَعْتَ معَ السُّعودِ فأصبحَتْ","تلك الخُطوبُ عن النَّواظرِ تَنْجَلي",19,"ل",2,0],["حتّى طرقْنا عن عَفَر","فِناءَ عزٍّ مُحْتَضَر",20,"ر",1,0],["حَتَّى طَلَعْتَ لَهُم بأسعدِ غرَّةٍ","طَلَعَتْ عَلَيْهِم فِي السَّماء سُعودُها",21,"د",3,0],["حتى طلعتَ فكنتَ شمسا مزَّقتْ","بيد الشَّمال ضبابَ يومٍ مُدجنِ",22,"ن",1,0]]}