{"poems":[[88,"لا رعى الله عهدها من جدود","https://www.aldiwan.net/poem10688.html","الخفيف"],[87,"الضلوع تتقد","https://www.aldiwan.net/poem62893.html","المقتضب"],[68,"رب يوم قد رفلت به","https://www.aldiwan.net/poem39186.html","المديد"],[68,"خذ من الدهر لي نصيب","https://www.aldiwan.net/poem41371.html","مجزوء الخفيف"],[71,"صاح إن كنت في الغرام معيني","https://www.aldiwan.net/poem28372.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54933","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141927","الخفيف"],[111,"نكس العلام يا خير الملل","https://www.poetsgate.com/ViewPoem.aspx?id=67046",""],[96,"عيد الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=12815",""],[231,"داعي الحياة","https://www.aldiwan.net/poem24239.html","عموديه"],[264,"يا نبيا عليك مولاك صلى","https://www.aldiwan.net/poem35968.html","الخفيف"],[276,"عاهدوا الربع ولوعا وغراما","https://www.aldiwan.net/poem52089.html","الرمل"],[369,"أتراها تظنني الطيف لطفا","https://www.aldiwan.net/poem60838.html","الخفيف"],[371,"لا يضيع الله من عمل","https://www.aldiwan.net/poem17251.html","المديد"],[422,"من لصب متيم مستهام","https://www.aldiwan.net/poem53989.html","الخفيف"],[466,"حي نجدا وأين من مرو نجد","https://www.aldiwan.net/poem15112.html","الخفيف"],[469,"صحة الوجد بالجفون المراض","https://www.aldiwan.net/poem3588.html","عموديه"],[556,"فضح الشيب شبابي فافتضح","https://www.aldiwan.net/poem47884.html","الرمل"],[563,"كن مع الله تر الله معك","https://www.aldiwan.net/poem34279.html","الرمل"],[563,"ذهب الخوف والرجا","https://www.aldiwan.net/poem34695.html","مجزوء الخفيف"],[563,"بين أهل الجحود والتكذيب","https://www.aldiwan.net/poem34966.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48862","الخفيف"],[975,"","https://poetry.dctabudhabi.ae/diwan/poem/28234","الرمل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56692","الخفيف"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/116000","الخفيف"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111809","الرمل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202173",""],[2027,"","https://poetry.dctabudhabi.ae/diwan/poem/101856","الرمل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110275","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53138","الرمل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67256","الرمل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101679","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93916","الخفيف"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104680","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204495","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62923","الرمل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125933","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205923","الخفيف"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36790","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85015","الخفيف"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93306","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73120","الخفيف"],[4670,"","https://poetry.dctabudhabi.ae/diwan/poem/143600","الخفيف"],[4729,"لمنْ النارُ على مَرفُوعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=109452",""],[4799,"صوت الشوارع","https://www.poetsgate.com/ViewPoem.aspx?id=12260",""],[5055,"كومة أحزاب","https://www.poetsgate.com/ViewPoem.aspx?id=101660",""],[5061,"يامهاجر","https://www.poetsgate.com/ViewPoem.aspx?id=147155",""],[5061,"الخيزرانه","https://www.poetsgate.com/ViewPoem.aspx?id=147172",""],[5090,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=184309",""],[5092,"دنيا","https://www.poetsgate.com/ViewPoem.aspx?id=179344",""],[5111,"أَرِيج","https://www.poetsgate.com/ViewPoem.aspx?id=212319",""],[5274,"يا زمان الوصل","https://www.poetsgate.com/ViewPoem.aspx?id=203257",""],[5358,"الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=21884",""],[5573,"يا أنين السراب الهم فيني بليه","https://www.poetsgate.com/ViewPoem.aspx?id=202277",""],[5644,"هل تراني سوف ألقى بغيتي","https://www.poetsgate.com/ViewPoem.aspx?id=211268",""],[5720,"الْصُّفَّةُ *","https://www.poetsgate.com/ViewPoem.aspx?id=199180",""],[5770,"نحن سبعة","https://www.poetsgate.com/ViewPoem.aspx?id=178734",""],[5821,"حزت دوامك","https://www.poetsgate.com/ViewPoem.aspx?id=113760",""],[5956,"هذه الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=184233",""],[5956,"مجرمو حرب وينجون من العقاب؟","https://www.poetsgate.com/ViewPoem.aspx?id=192219",""],[5956,"دائماً صهيون تنجو من العقاب","https://www.poetsgate.com/ViewPoem.aspx?id=192311",""],[5956,"أنا سكرانٌ بحبي لحفيدي","https://www.poetsgate.com/ViewPoem.aspx?id=193151",""],[5956,"فيه سرُّ الله في أسمى البشرْ","https://www.poetsgate.com/ViewPoem.aspx?id=193919",""],[5997,"لَا تلُوْمِيْنِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=214225",""],[6001,"لمحت لك","https://www.poetsgate.com/ViewPoem.aspx?id=410",""],[6142,"حبذا المصطفى مدينة علم","https://www.poetsgate.com/ViewPoem.aspx?id=155699",""]],"verses":[["كُلَّما نِلتَ غايَةً لَم تَنَلها","هِمَّةُ الدَهرِ قُلتَ هَل مِن مَزيدِ",0,"د",1,0],["كُلَّما نَقَضتَ لَها","عُقدَةً بَدَت عُقَدُ",1,"د",1,0],["كُلَّما ناحَت عَلى شَجَنٍ","خِلتُها غَنَّت عَلى قَدَحِ",2,"ح",1,0],["كُلَّما ناحَ عَندَليب","نَقَّطَ الدَوحَ بِالزَهَر",3,"ر",1,0],["كلما ناحَ جاوبتْهُ فكلٌّ","ناحَ شجواً على قدودِ الغصونِ",4,"ن",1,0],["كُلَّمَا نَلْتَقِي اعْتَنَقْنَا كَأَنَّا","جِدُّ سَفْرٍ عَادُوا مِنَ الأسْفَارِ",5,"ر",1,0],["كلما نافسَ الصبا بجمال","عبقري السنا نماه إليك",6,"ك",1,0],["كل ما نهفو إليه عبر","لو فقهنا الشأن أو ضرب المثل",7,"ل",1,0],["كلّما نادين فتيان الحمى","كبّر الفتيان وارتدّ النداء",8,"ا",2,0],["كلما نادى المنادي حي هلا","يقطف المحروم ما طاب جناه",9,"ا",2,0],["كُلُّ ما نُهدي مِن صَلاتِكَ فَالأَم","لاكُ مِنّا قَد بَلَّغَتها إِلَيكا",10,"ك",2,0],["كلما ناحَت حَمامات الحمى","في أَراكَ الشعب ناوحت الحماما",11,"م",2,0],["كُلَّما نَمّقَتْ بيُمْناهُ سَطْراً","زادَتِ المُلْكَ قُوّةً وهْي ضَعْفَى",12,"ف",2,0],["كُلُّ ما نِلتُم وَنيلَ بِكُم","فَبِحَولِ اللَهِ لا الحِيَلِ",13,"ل",1,0],["كلَّما نسّمت رياح صباها","قلتُ يا ريح بلِّغيها سلامي",14,"م",2,0],["كلما ناسَ بالمَطيِّةِ عِشْرٌ","فمنَ السَّبْتِ والذميلِ الورْد",15,"د",1,0],["كلما نازلَ الكتائبَ والفَقْ","ر شكا جحفلٌ وأثنى وفْدُ",15,"د",1,0],["كلما نشّر الغمام ملاءً","طرزّتها البروق بالإيماض",16,"ض",1,0],["كُلّما ناديتُهُ نَحوي مضى","وَإِذا قلتُ دنا مِنِّي اِنتَزحْ",17,"ح",1,0],["كلما نابك أمر ثق به","واحترز للغير تشكو وجعك",18,"ك",1,0],["كلما ناح طائر","حث شوقي وهيجا",19,"ج",2,0],["كلما نبهوا على الحق ناموا","عنه بالإضطرار والتغليب",20,"ب",1,0],["كلما نال نابهٌ منه عطفاً","شمل العطف سائر الإخوان",21,"ن",1,0],["كُلَّما نادى مُنادٍ مِنهُم","يا لَتَيمِ اللَهِ قُلنا يا لَمالِ",22,"ل",1,1],["كلما نزعها عاد كفي","بقليل من بعضه منزوع",23,"ع",1,0],["كُلَّما نُحنَ هِجنَ شوقا ومَاها","جَ لك الشَّوقَ مثلُ نَوحِ الحَمامِ",24,"م",1,0],["كلما نحسبهُ فيها لنا","سوفَ نبقيهِ على غير رضى",25,"ض",2,0],["كلَّما ناح الحمام هَمى","مُسْتَهِلٌّ منه هَنّانُ",26,"ن",1,0],["كلما نغم صوتاً حسناً","خلته نغمة صوت الموسيقى",27,"ق",2,0],["كلما نحنح عن اوجاعه","ارسل الانات من فيه ذمما",28,"م",2,0],["كلَّما ناشدته الوصل أبى","أن يروض العَتْب منه رَيِّضا",29,"ض",2,0],["كلّما ناولنيها أوهَما","أنها الشمس بدت في سَحر",30,"ر",1,0],["كلما نلت نعمة تبعتها","منك أخرى واستتبع البدء عودا",31,"د",2,0],["كلما نسمة الشمائل هبت","حدثت عن شمائل وطباع",32,"ع",1,0],["كلما ناحت حمامات الحمى","سحراً تنهل عيناي انسجاما",33,"م",2,0],["كلما نابني مصاب تفيض ال","صحب منه بشراً وتفترُّ ثغرا",34,"ر",2,1],["كلما نابني من الدهر خَطْب","قيل لي أنظم لنا من الشعر درّا",34,"ر",2,0],["كلما نسَّ عليه قدُّهُ","لين النسّ يحاذيه الشِّعَارُ",35,"ر",1,0],["كل ما نهواه يمضى عاجلا","ليته يمشي بنا في مهل",36,"ل",1,0],["كلما نالها نصيب من الخي","ر فأنتم لكم نصيب تالي",37,"ل",2,0],["كُلَّما ناحَت عَلى أَفنانِها","هاجَتِ الصَبَّ غَراماً وَوُلُوعا",38,"ع",2,0],["كُلَّما نِسمَةٌ أَتَت مِن رُباهُم","هَيَّجَت مِن فُؤادِهِ خَفَقانِهِ",39,"ن",2,0],["كلّما ناظَرَ العواذلُ فيه","رُحْتُ من دَلِّه قويَّ الأَدِلَّه",40,"ل",2,0],["كلَّما ناحَ ذا ولاح مجدَّاً","ذاكَ وهناً شكت ضُلوعيَ وَهنا",41,"ن",2,0],["كلّما نمَّ للفُضول سوارٌ","كذّبتْه قَلائدٌ وعقود",42,"د",1,0],["كُلما نَادوا أَبَا ذي شَرَفٍ","في الوغا ناء فلََّباهُ نزارُ",43,"ر",1,0],["كل ما ندهتي له يجي في حنينه","توّه صغير ولا عرف هم أو شال",44,"ل",1,0],["كُلّما نمَرّ بْشيخ يحلف لكذاب","يضحك ويستهزئ ألا الريح هبّي",45,"ب",2,0],["كل ماناديت باسمك من بعيد","اعشق اسمك يوم يرجع لي صداه",46,"ا",2,1],["كلما نويت الجفا جّانيّ وعلمني","أن الخيانه مهي مَن سالف أجدادي",47,"د",2,0],["كلما ناحَ بلبلٌ","أو تغنى على فننْ",48,"ن",1,0],["كلّما نامت على كفِّ المنى","جاءت الأحلامُ فيها ساهره",49,"ر",2,0],["كُلَّمَا نَاءَتْ بَعِيدًا","أنْشَدَ الْقَلْبُ رِضَاهَا",50,"ا",3,0],["كلَّمَا ناجَيْتُ طِيْفَا لَاْحَ لِيْ","لِثَوَانٍ ثُمّ قَفّىْ وانْسَحَبْ",51,"ب",1,0],["كلَّما ناشدْتُهُ عنكِ جرى","نهْرُ أحزاني إلى كلِّ نَهَرْ",52,"ر",1,0],["كل ماناض برق الغيمه العقربيه","فيض سيله تباشره الحضر والبوادي",53,"د",2,0],["كلما ناجت عيوني قلبكم","لم تجد إلا صدودا نحوها",54,"ه",2,0],["كلما ناديتُها جاءتْ .. وفي","ذكرِها عِطرٌ .. بأبهىٰ حللِ",55,"ل",1,0],["كلما ناغمتُها .. فاضَ الهوىٰ","من فؤادي .. وتراءىٰ طللي",55,"ل",2,0],["كلما ناديتهم عاد الصدى موحشٌ فيه خشوع وجلال","خمسة أنتم إذا يا حلوتي إذ مضى اثنان إلى دنيا المُحال",56,"ل",1,0],["كل مانضرني واحدٍ قال وشفيك","حالي مريره وانت بالحال حاوي",57,"ا",3,0],["‏ ‏كلما نبصر وجها ذا ابتسام","‏ ‏ تتلقّانا وجوه ٌ تكفهرُّ",58,"ر",1,0],["‏ ‏كلما ننقذ نفساً من شقاء","‏ ‏ يتحداها مصيرٌ لا يسُرُّ",58,"ر",1,0],["كلما نحن ابتسمنا لحظةً","بعدها نُزْجى لأن ننتحبا",59,"ب",2,0],["كلما نحن اعتلينا هُضُباً","جاءنا أمرٌ لنُخْلي الهُضُبَا",59,"ب",2,0],["كلما نحن ابتسمنا لحظة","بعدها نُدعى لأن ننتحبا",60,"ب",2,0],["كل ما نرجوه موجودٌ وفيرٌ","من غذاءٍ ودواءٍ ونقودِ",61,"د",1,0],["كلما نُودي مٌلبٍّ للندا","دون تأخير فما من منتظِرْ",62,"ر",1,0],["كُلَّمَا نَادَى الْمُنَادِي يرتجي","مِن كَرِيمٍ أَن يَرَى وَجْهَ السَّلَامْ",63,"م",1,0],["كل ما نصحته آزم يصيح","ماله على الصبر احتمالي",64,"ل",2,0],["كلما نالت السواغب منها","مطعماً قيل للمطاعم زيدي",65,"د",2,0]]}