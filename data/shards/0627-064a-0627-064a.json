{"poems":[[88,"أيا يدا قد خصها ربها","https://www.aldiwan.net/poem68890.html","السريع"],[33,"عوجا نحي الطلل المحولا","https://www.aldiwan.net/poem41853.html","السريع"],[109,"ياسمينُ التي من حَلبْ","https://www.poetsgate.com/ViewPoem.aspx?id=208770",""],[33,"عوجا نحيِّ الطللَ المحولا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19017&r=&rc=280",""],[119,"باحيا علوم الدين أفنيت مدةً","https://www.aldiwan.net/poem41692.html","الطويل"],[203,"قتل الحب يا ليالي الوداد","https://www.aldiwan.net/poem45191.html","الخفيف"],[280,"لم يخن في الحب تأويلي","https://www.aldiwan.net/poem25541.html","المديد"],[409,"هتف القمري في الروض وغنى","https://www.aldiwan.net/poem33384.html","الرمل"],[505,"ما بين جرعاء اليلملم والعلم","https://www.aldiwan.net/poem37799.html","الكامل"],[556,"لك الليل بعد الذاهبين طويلا","https://www.aldiwan.net/poem47299.html","الطويل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39193","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63852","الخفيف"],[1122,"","https://poetry.dctabudhabi.ae/diwan/poem/98089","المجتث"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64908","المتقارب"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136294","الطويل"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79449","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108759","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108705","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66234","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27726","الكامل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123930","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48328","الدوبيت"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109988","الطويل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66552","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33379","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139524",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139549",""],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4859,"فما المجد إلا رفيق الجراح","https://www.poetsgate.com/ViewPoem.aspx?id=200039",""],[5277,"نونٌ وذكراها","https://www.poetsgate.com/ViewPoem.aspx?id=201749",""],[5781,"وارفةُ العشقِ...أنا","https://www.poetsgate.com/ViewPoem.aspx?id=190949",""],[5818,"من أجل ذلك ....","https://www.poetsgate.com/ViewPoem.aspx?id=181545",""],[5829,"ذكاء","https://www.poetsgate.com/ViewPoem.aspx?id=192054",""],[2220,"لولا قبولي ما رأيتُ وجودي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11330&r=&rc=204",""],[4222,"أيا يوسف الإحسان والحسن خير من","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52775&r=&rc=67",""]],"verses":[["أَيا يَداً قَد خَصَّها رَبُّها","بِآيَةِ الإِعجازِ في الخَلقِ",0,"ق",1,1],["إِيايَ لا إِيّاكُما هَيَّجَ ال","مَنزِلُ لِلشَوقِ فَلا تَعجَلا",1,"ل",2,0],["أيا ياسمينُ التي من حَلبْ","..اهلكُ تُركٌ واهلي عربْ",2,"ب",1,1],["إيايَ، لا إيّاكُما، هَيَّجَ کلْ","زلُ للشوقِ، فلا تعجلا",3,"ل",2,0],["أيا يوسف الصديق باللَه أفتنا","أذلك خلق الأقربا والمحبين",4,"ن",1,0],["أيّ أيدٍ قد بدلت ذلكَ الدر","بحبِ الرصاصِ فوقَ الهوادي",5,"د",2,0],["أيُّ آيٍ لِلْجَمَالِ غَدَتْ","جُلَّ تَرتيبِي وتَرحيلِي",6,"ل",2,0],["أي أيام لنا قد سلفت","جمعت وصفين إحساناً وحسنا",7,"ن",2,0],["إيَّايَ يا قاضي الغَرامِ فلَوْعَتي","عَظُمَتْ وحِبِّي بالدَّلالِ قدِ احْتَكَمْ",8,"م",1,0],["أيا يوم عاشوراء كم من فجيعةٍ","عل الغُرّ آلِ اللّه كنتَ نَزولا",9,"ل",2,0],["إيَّايَ أعْني فيا وَيْحي ويا أسفي","إنْ لَمْ يَكُنْ مِنْهُ لي عَفْوٌ وغُفرانُ",10,"ن",1,0],["أيّ أَيرٍ يهوى القيامَ على من","فوهُ للصَّقْرِ واستُه للحُبارى",11,"ر",2,0],["إيّايَ تعني بهذا","عليكَ فاجلد عُمَيرَه",12,"ه",1,1],["أيا يوسُفُ بنَ المَليكِ العَزيزِ","ووارِثَ يوسُفَ فيما مَلَكْ",13,"ك",1,1],["أيا يومنا المسعود بالحي هل ترى","تعود علينا قبل ان يقضي الأجل",14,"ل",1,0],["أيا يا مَنْ مجدُهُ للدهرِ غُرَّه","وطلعتُهُ لعينِ المُلْكِ قُرَّهْ",15,"ر",2,1],["أيا يوسفي الحسن يا أملح المهى","عيوناً وواوات البنفسج أصداغا",16,"غ",2,1],["أياي أعني إذ نجوت به","وانجاب عني اللاعج المر",17,"ر",1,0],["أيّ آيٍ أبديتها في القوافي","قد هَوَت سجّداً لها الشعراءُ",18,"ا",2,1],["أي آي بين العراق ونجد","هو للعالمين قد أبداها",19,"ا",3,0],["إياي فانظر في معالم حكمتي","يدري بهل من كان أصل وجودي",20,"د",2,0],["أي آي يتلو لنا غابر ال","دهر ولكن على العقول غبار",21,"ر",1,0],["أيا يُوسُفاً في الحسْنِ أو في المُلْكِ","نظامِي كَدُرٍّ رائِقٍ في السّلْكِ",22,"ك",1,0],["ايا يوسُفُ الصِدِّيقُ يا خيرَ شافعٍ","تَشفَّع بنا يومَ القيامةِ والعَرضِ",23,"ض",1,0],["أَيا يُوسُفِيَّ الْحُسْنِ لَوْلاَكَ لَمْ يَهُنْ","فَتىً مُوسَوِيُّ الْمُنْتَمَى أشْرَفِيُّهُ",24,"ي",2,0],["أيا يومَ الفِراقِ صَدعتَ قلباً","متى يصحو فتلتئمَ الصُّدوعُ",25,"ع",1,0],["أيا يمَّ جودٍ أبدل الفقر بالغنى","وأخصب فيه الدهر من بعد جدبه",26,"ب",2,0],["أيا يمَّ فضلٍ يفيض القريض","وما زال يقذفُ درّاً رطيبا",27,"ب",2,0],["أَيا يوسُفَ الدُنيا لِفَقدِكَ في الحَشا","مِنَ الحُزنِ يَعقوبٌ فَهَل أَنتَ راجِعُ",28,"ع",1,0],["أيا يمني طالَ فيكَ الكفاح","وحوصِر في مقلتيكَ الصّباح",29,"ح",1,1],["أيا يمن الخيرِ صبراً فلن","يدومَ الشقاءُ بأغلى البطاح",29,"ح",1,0],["إيّايَ منها..وإيّاها..إذا غضبتْ","كأنّها لبوةٌ تغتالُ قتلاها",30,"ا",3,0],["إيَّايَ حبًّا! فعِشقي في تملُّكهِ","في البَدءِ كنتُ، وما كانت خواتِمُهُ",31,"م",2,0],["أيًّا يكن .... ف صدى الإجابةِ دونها","ما أحقر الدنيا .. وما أشقانا",32,"ن",2,0],["أيا يوما به رقصت","وما أهديتني رشدا",33,"د",2,0],["إياي فانظر في معالم حكمتي","يدري بها من كان أصل وجودي",34,"د",2,0],["أيا يوسف الإحسان والحسن خير من","حوى الفضل والإفضال والنهى والأمرا",35,"ر",2,1]]}