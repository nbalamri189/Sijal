{"poems":[[47,"أريحيات صبوة ومشيب","https://www.aldiwan.net/poem62638.html","الخفيف"],[47,"قد أهدف الغث العمى لو لم يكن","https://www.aldiwan.net/poem65167.html","الكامل"],[48,"قد أهملت للخياط إبرتها","https://www.aldiwan.net/poem22358.html","المنسرح"],[48,"قد أهبط الرودة الزهراء عارية","https://www.aldiwan.net/poem22458.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85594","المجتث"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85375","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54519","المتقارب"],[47,"أريحيات صبوة ومشيب","https://www.poetsgate.com/ViewPoem.aspx?id=33102",""],[48,"قد أهبِطُ الرّوضةَ الزهراء، عاريَةً،","https://www.poetsgate.com/ViewPoem.aspx?id=18560",""],[76,"وَمعينُ ماءِ البِشرِ أبرَقَ هَشّة ً،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13964&r=&rc=5",""],[111,"قد اهتزت الأكوان وارتعد الملا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66832&r=&rc=11",""],[162,"تبت يدا مرج الكحول فإنه","https://www.aldiwan.net/poem4420.html","الكامل"],[182,"موت يشتهيه الرثاء","https://www.aldiwan.net/poem50697.html","الكامل"],[228,"كنت بالأمس ربة العاشقينا","https://www.aldiwan.net/poem41911.html","الخفيف"],[408,"كيف يرضيك على الضيم المقام","https://www.aldiwan.net/poem46920.html","الرمل"],[409,"مثلي بهذا منك لا يرضى","https://www.aldiwan.net/poem33696.html","الكامل"],[463,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104089","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72328","السريع"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64616","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49604","الوافر"],[1949,"","https://poetry.dctabudhabi.ae/diwan/poem/105281","السريع"],[2053,"","https://poetry.dctabudhabi.ae/diwan/poem/132441","الرجز"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133982","الكامل"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140310",""],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130048","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67970","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89075","الرجز"],[3550,"","https://poetry.dctabudhabi.ae/diwan/poem/206277",""],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127159","البسيط"],[216,"","https://poetry.dctabudhabi.ae/diwan/poem/56505","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54462","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4767,"بهدلة","https://www.poetsgate.com/ViewPoem.aspx?id=212767",""],[5533,"يا غَزَّةُ يا صَوْتَ الأُمَّة","https://www.poetsgate.com/ViewPoem.aspx?id=176419",""],[5691,"وفاق","https://www.poetsgate.com/ViewPoem.aspx?id=206444",""],[463,"كمِ النّوى قدْ جزعَ الصَّابرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60086&r=&rc=142",""]],"verses":[["قَد أَهابَ الرَجاءُ بِاِبنِ المُعَلّى","بِلِسانِ القَريضِ وَهُوَ خَطيبُ",0,"ب",1,0],["قَد أَهدَفَ الغَثُّ العَمى لَو لَم يَكُن","وَغداً وَلَيسَ الوَغدُ مِن أَهدافي",1,"ف",2,1],["قَد أَهمَلَت لِلخِياطِ إِبرَتَها","فَصادَفَت إِبرَةً لِعَقرَبِها",2,"ب",3,1],["قَد أَهبِطُ الرَودَةَ الزَهراءَ عارِيَةً","سَدّى لَها الغَيثُ نسجاً فَالنَباتُ سَدِ",3,"د",1,1],["قد اِهتَديت إلى الحق","قِ تارة وغويتُ",4,"ت",1,0],["قَد اِهتَدى من له علم بغايته","أما الَّذي هو ذو جهل فقد خبطا",5,"ط",2,0],["قَدِ اهْتَزَّ جَانِبُهَا وَانْتَحَتْ","تَخَطَّرُ بَيْنَ السَّنَى وَالسَّنَاءْ",6,"ا",2,0],["قد أهاب الرجاء ب بابن المعلى","بلسان القريض وهو خطيب",7,"ب",1,0],["قد أهبِطُ الرّوضةَ الزهراء، عاريَةً،","سدّى لها الغيثُ نسجاً، فالنباتُ سَدِ",8,"د",1,1],["قد أهبت فتذهبت فكأنها","لسكونِ شرّ شرارها لم تلهبِ",9,"ب",1,0],["قد اهتزت الأكوان وارتعد الملا","لقتل امام قام لله فيصلا",10,"ل",2,1],["قَد أَهلَكَ الإِسلامَ شُؤمُ مَديحِهِ","هَلا أَشارَ بِمَدحَةٍ لِلرُّومِ",11,"م",1,0],["قد أهْلَكْتْكَ لواعجٌ لا تنتهي","وتمنَّعَتْ عَنْ لحدِكَ البَطْحاءُ",12,"ا",2,0],["قَد أَهَنتِ الحَياةَ بَعدَ عليٍّ","فَاِستَحي اليَومَ لا تُهيني المنونا",13,"ن",2,0],["قد أهِينَتْ عُصَبُ الحقِّ به","وأعزّتْ عُصَبُ النّصبِ ينامُ",14,"م",1,0],["قد أهمل العليا فلست ترى","نفْلاً يقوم به ولا فرضا",15,"ض",2,0],["قد أهملَ النوَّامُ من سَرحها","ما كان يَرعَى طرفُك الساهرُ",16,"ر",1,0],["قد أُهملت في حلبَةٍ من خلقِها","فإذا جَرت رفعَ العجاجَ هشيمها",17,"م",3,0],["قد أهل الرحمن جل اسمه","لبيتكم خدمة جبرين",18,"ن",1,0],["قد اهتزت الأكوان وارتعد الملا","لقتل امام قامَ اللّه فيصَلا",19,"ل",2,1],["قد اهلكوا ابطالنا وحماتنا","وقضوا عَلَى اموالنا بنهاب",20,"ب",1,0],["قد اهتزَّتْ بأنْعُمِكَ الليالي","كما تهتزُّ بالثَّمَرِ الغصون",21,"ن",1,0],["قد أهلك الناس أما آن أن","تهلكه منك يد السخط",22,"ط",1,0],["قد أهل الجهل بالأموالِ","وبالبنين الحسّد الرجالِ",23,"ل",1,0],["قد اهلتني للتقدم دائماً","مهما تنقل بي سرى الأسفار",24,"ر",1,0],["قد أهملوا لترعى والذئاب معاً","والذئب ليس على شاة بمأمون",25,"ن",1,0],["قد أهملَ الشرقُ إعلاءَ النساء وفي","رُقيّهنّ فخارُ الشرقِ لو علِما",26,"م",2,0],["قد أُهنِّي بالفتح لكنْ","حقُّ أهلِ البلاد شكرُ المَواهب",27,"ب",1,0],["قد أهديا نوّارة تزاهت","من ماطرٍ وروضة نضيده",28,"د",2,0],["قد أهملت كل الأمور فما","يعنى بمصلحة ولا يغنى",29,"ن",2,1],["قد أهلك الله جبارا تمرد في","أرض الطفوف وآذى أكثر الناس",30,"س",1,1],["قد اهتزت الدهناءُ يوم كفاحِه","وترجف من أفعالهِ الأنجمُ الزُهْرُ",31,"ر",1,0],["قد أُهدِيَ الإثراءُ في الإيفاضِ لي","مذ فاضَ لي بالرَّحبِ بحرُ الفاضلِ",32,"ل",1,1],["قد أهلك الأُحبُوش طَيرٌ قد رَمى","جُيُوشَهُم بِمَكَّةٍ بِما رَمَى",33,"ا",1,0],["قد أهملَتها مَن ترى أنني","أحتاج في حبي إلى تكمِلة",34,"ل",2,0],["قد أَهْدَتْ فَلْذَةَ أَكْبادٍٍ","ما بَخِلَتْ يَوْماً في أَزْمَة",35,"م",2,0],["قدْ أهْملوا الأسْرى وما ضَمِنوا","حقّاً كَما وعَدوا لمأْسورِ !",36,"ر",1,0],["قدْ أهملَ النَّوامُ في سرحها","ما كانَ يرعى طرفكَ السَّاهرُ",37,"ر",1,0]]}