{"poems":[[55,"عطون بأعناق الظباء وأشرقت","https://www.aldiwan.net/poem29798.html","الطويل"],[37,"أبائنة سعدى نعم ستبين","https://www.aldiwan.net/poem38821.html","الطويل"],[37,"ألا حييا ليلى أجد رحيلي","https://www.aldiwan.net/poem39100.html","الطويل"],[33,"تمشي الهوينا إذا مشت فضلا","https://www.aldiwan.net/poem42553.html","المنسرح"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20535","الطويل"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45265","الطويل"],[3774,"","https://poetry.dctabudhabi.ae/diwan/poem/21493","المتقارب"],[5694,"نرهب عدو الدين","https://www.poetsgate.com/ViewPoem.aspx?id=129915",""]],"verses":[["تَأَطُّرَ أَغصانِ الأَراكِ أَمالَها","وَقَد رَقَّ جِلبابُ الظَلامِ نَسيمُ",0,"م",1,0],["تَأَطَّرنَ في الميناءِ ثُمَّ تَرَكنَهُ","وَقَد لاحَ مِن أَثقالِهِنَّ شحونُ",1,"ن",1,0],["تَأَطَّرنَ حَتّى قُلتُ لَسنَ بَوارِحاً","رَجاءَ الأَماني أَن يَقِلنَ مَقيلي",2,"ل",2,0],["تَأَطَّرنَ حَتّى قُلتُ لَسنَ بَوارِحاً","وَذُبنَ كَما ذابَ السَديفُ المُسَرهَدُ",3,"د",1,0],["تَأَطَّرنَ حتّى قُلتُ لَسنَ بَوارِحاً","ولا لاحِقاتِ الحَيِّ إِلَا سَوارِيا",4,"ي",2,0],["تَأَطَّرنَ بِالميناءِ ثُمَّ جَزَعنَهُ","وَقَد لَحَّ مِن أَحمالِهِنَّ شُجونُ",5,"ن",1,1],["تَأَطُّرَ صَعدَةٍ مُرّانَةٍ","مِنَ الهيفِ مُلتَبِسٍ غابُها",6,"ه",2,0],["تاطا نواصيكم حوافر خيلنا","والأرض تلبس ثوبها العنابي",7,"ب",2,0]]}