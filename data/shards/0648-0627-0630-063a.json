{"poems":[[48,"إرْكَعْ لربّكَ في نَهارِكَ واسجُدِ،","https://www.poetsgate.com/ViewPoem.aspx?id=18584",""],[164,"بشراك بشراك هبت نسمة الفلق","https://www.aldiwan.net/poem59101.html","البسيط"],[275,"أبعد التقى أهفو إلى هفواتي","https://www.aldiwan.net/poem35583.html","الطويل"],[290,"قدر تم فبسطتم سحب حلمكم","https://www.aldiwan.net/poem39426.html","البسيط"],[347,"أبا غازي ابا الفضل","https://www.aldiwan.net/poem55349.html","مجزوء الوافر"],[382,"يا صاح إسمع مذ سمت","https://www.aldiwan.net/poem66909.html","مجزوء الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38755","الطويل"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96454","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93887","البسيط"],[3386,"","https://poetry.dctabudhabi.ae/diwan/poem/124618","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86264","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86244","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86338","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36719","السريع"],[3727,"","https://poetry.dctabudhabi.ae/diwan/poem/124072","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114336","البسيط"],[5302,"تطاول ليلي","https://www.poetsgate.com/ViewPoem.aspx?id=201153",""]],"verses":[["وإذ غلا البُرُّ النّقيُّ، فشارِك ال","فرسَ الكريمَ وساوِ طِرفَك تَمجُدِ",0,"د",1,0],["وإذ غراب الدجى قد طار من فزع","لما رأت مقلتاه بارق الفلق",1,"ق",1,0],["واذ غاضَها درٌّ يفاخرُ ثَغرها","ترامت عقودُ الدرّ مُنتثرات",2,"ت",1,0],["وإذ غدا برياض العفو مغتبطا","وفي ظلال الرضا يختال في النعم",3,"م",1,0],["واذ غلت فلم تنقذ","فؤادينا من الغل",4,"ل",1,0],["وإذ غدا بالجُدِّ","فداه مولى الأدب",5,"ب",1,0],["وَإِذ غِبت قَد أَوحَشتها أَيَّ وَحشَةِ","يَكادُ بِها يَبدو حُلول الغَياهِبِ",6,"ب",1,0],["وَإِذَ غَضِبتَ فَلاَ تَكُن أُنشُوطَة","مُستَعتِداً لَفَحَاشَةٍ وَتَبَسُّلِ",7,"ل",1,0],["وإذ غدا عالماً عبد العليم بها","سعى إلى الحان والألحان مقترحا",8,"ح",2,0],["وإذ غادروني في رجا مدلهمّة","وحين أتى في القبر من هو سائلي",9,"ل",2,0],["وَإِذ غَرَّدَت وُرق التَهاني بِوَفدِهِ","فَنادى بِتاريخَين يَشدو بَشيرُها",10,"ر",3,0],["وَاِذ غَرَّدَت وُرق التَهاني لِوَفدِها","وَاضحى بِها عَهدَ السُرورِ وَثيقاً",11,"ق",2,0],["وَاِذ غَدا بابليَّ الطَرف لا عجبٌ","عُقولَ اهلِ الهَوى بِاللَحظِ اِن سحرا",12,"ا",1,0],["وَإِذ غُصونُ الأُنس فَينانةٌ","قَد جاذبتها الوَصل أَيدي العِتاب",13,"ب",1,0],["وإذ غدا في ربيع الألّ مولدُه","غدا ربيعٌ ربيع القلب والكبد",14,"د",1,0],["وَإذ غَدَوتَ مُشَاركاً ضَعُفتَ فَلَم","تُعمَل وَأهمِلتَ عِندِي كُلَّ إهمَالِ",15,"ل",1,0],["وإذ غاب بدر وأوغلت في","مسائي الكئيب وحظي الردي",16,"د",2,0]]}