{"poems":[[55,"غزال ماطل ديني","https://www.aldiwan.net/poem29739.html","الهزج"],[79,"حديث على رغم العلا غير كاذب","https://www.aldiwan.net/poem36768.html","الطويل"],[88,"ما بال دندرة تميس تهاديا","https://www.aldiwan.net/poem68897.html","الكامل"],[26,"صبا صبوة بل لج وهو لجوج","https://www.aldiwan.net/poem24100.html","الطويل"],[99,"إني على كاسي أعيد السنين","https://www.aldiwan.net/poem24921.html","السريع"],[41,"أصاح ألا هل من سبيل إلى هند","https://www.aldiwan.net/poem53784.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85550","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54854","المجتث"],[92,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[146,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[146,"لو كنت أشفق من خضيب بنان","https://www.aldiwan.net/poem58451.html","الكامل"],[147,"محض الإباء وسؤدد الآباء","https://www.aldiwan.net/poem11717.html","الكامل"],[151,"الحمد لله تعظيما وإجلالا","https://www.aldiwan.net/poem47640.html","البسيط"],[234,"قد أغتدي قبل الصباح المسفر","https://www.aldiwan.net/poem51001.html","الرجز"],[369,"بعد الصباح الذي ودعتكم فيه","https://www.aldiwan.net/poem60602.html","البسيط"],[422,"أينكر معروفنا المنكر","https://www.aldiwan.net/poem54039.html","المتقارب"],[435,"برزت تفاخر بالجبين الأقمر","https://www.aldiwan.net/poem41402.html","الكامل"],[445,"أخو ظمأ يمص حشاه سبع","https://www.aldiwan.net/poem34835.html","الوافر"],[568,"حمدنا الله ذا العرش المجيد","https://www.aldiwan.net/poem13602.html","الوافر"],[572,"متى تنشط للأكل","https://www.aldiwan.net/poem69479.html","الهزج"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138262",""],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122306","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70682","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101062","الوافر"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20380","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53193","الرجز"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100904","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65104","الطويل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126252","الخفيف"],[3506,"","https://poetry.dctabudhabi.ae/diwan/poem/107335","المتقارب"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66490","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91233","السريع"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/141499","المتقارب"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81688","المقتضب"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72489","الكامل"],[4755,"رَبِيبَةَ الوَحيِ.. يا مَن باسمِها نَزَلَا","https://www.poetsgate.com/ViewPoem.aspx?id=184185",""],[4767,"شكوى البقيع","https://www.poetsgate.com/ViewPoem.aspx?id=175092",""],[4961,"زهرةُ آخرِالأنبياء","https://www.poetsgate.com/ViewPoem.aspx?id=40463",""],[5187,"ذكريات وعتاب","https://www.poetsgate.com/ViewPoem.aspx?id=29255",""],[5273,"مُغتَصَبة","https://www.poetsgate.com/ViewPoem.aspx?id=28769",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5720,"الْمُشَلْوِي","https://www.poetsgate.com/ViewPoem.aspx?id=204050",""],[5887,"التحدي","https://www.poetsgate.com/ViewPoem.aspx?id=30412",""],[5956,"تشبيه بلا تشويه","https://www.poetsgate.com/ViewPoem.aspx?id=192411",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["كَما زُجِّيَتِ الرَجزاءُ","زَحفاً بِعِقالَينِ",0,"ن",1,0],["كَمَا زِينَ نَحْرٌ بِالْفَريدِ الْمُقَلَّدِ","وَكَانُوا نُجُوماً فِي الزَّمَانِ لِمُهْتَدِي",1,"ي",1,0],["كَم أَزمَةٍ مَرَّت بِنا فَاِجتاحَها","سَعدٌ بِسَيلِ بَيانِهِ المُتَدَفِّقِ",2,"ق",1,0],["كَما زالَ نَخلٌ بِالعِراقِ مُكَمَّمٌ","أُمِرَّ لَهُ مِن ذي الفُراتِ خَليجُ",3,"ج",1,0],["كم أزرع السّلوان في خاطري","وكيف ينمو في مَحيلٍ جديب",4,"ب",1,0],["كَما زَعَموا إِذ أَنتَ في البَيتِ مُطِرقٌ","وَلَو غِبتَ فيمَن غابَ لَم تَكُ ذا فَقدِ",5,"د",1,0],["كم أزبدوا حنقاً عليَّ وزمجروا","وعلا ضجيجهمُ إلى العيّوق",6,"ق",1,0],["كمْ أَزْمَة تتَوَلَّى","فَتُتْبِعُ العُسرَ يسْرَا",7,"ر",2,0],["كم أزمةٍ لو كنتِ حاضرةً","فَرَّجْتِها بمسيلِك العَطِر",8,"ر",1,0],["كم أزمةٍ خَرِسَتْ رواعدُ سُحبها","وسحابةٍ فيها خطيبٌ مِصقَعُ",9,"ع",1,0],["كم أزمةٍ ضحِكت بها أنواءُهُ","والغيثُ لا يلوِى على طمآنِ",10,"ن",1,0],["كَم أَزمَةٍ سَوداءَ راعَت إِذ عَرَت","جَلَّيتَها بِنَدى يَدٍ بَيضاءِ",11,"ا",2,0],["كم أزمة فرجوا كم غمة كشفوا","كم فككوا عن رقاب الخلق أغلالا",12,"ل",2,0],["كما زهت قِلادةٌ من جوهر","سبقتُ أوُلي فجرها المنوِّر",13,"ر",1,0],["كما زهَتْ أَصفهانٌ إذْ ألَمَّ بها","مُؤيّدُ المُلْكِ فاهتزَّتْ من التيه",14,"ي",2,0],["كما زُيِّنَتْ بالنقيب الشَّريف","وحسن مناقبه الأَعصرُ",15,"ر",1,0],["كم أزمة قد حلها بذكائه","وكريهة قد حلها بالأبتر",16,"ر",1,0],["كما زَجَرُوا مِن اسْمِ أَبِيكَ فَأْلاً","فَرُدَّتْ فِيهِ قَبْلَ الزَّايِ رَاءُ",17,"ا",2,0],["كَما زَجَرَتهُ عَن أَضرارِ الإِسلا","مِ إِذ رَفَعَت لَهُ إِحدى النُهودِ",18,"د",1,0],["كَمَا زَيَّنَ صَوْبُ الغَيْ","ثِ فِي الرَّوْضِ أَفَانِيْنَهْ",19,"ن",2,0],["كم آزورا بشجاعة أقرانهم","ولكم وقوهم من عدى وعوادي",20,"د",2,0],["كم ازرع الشكر وما لزرعه","إذا أتى الا بأن من حصاد",21,"د",1,0],["كم أَزجرُ النفس عنه وهْيَ تحسدني","على الهدى وعدوُّ المرء حاسده",22,"د",2,0],["كما زهيت بزينتها العذارى","وقد شغلت عيون الناظرينا",23,"ن",2,0],["كَم أَزالَت رِماحنا مِن قَتيلٍ","قاتَلونا بِنَكبَةٍ وَشَقاءِ",24,"ا",2,0],["كما زعم قال نعم","يا صاح كم هذا السأم",25,"م",1,0],["كم أزمة حلَّت بمصر ففرّجت","واذا الشقاء اشتدَّ حالَ نعيما",26,"م",2,0],["كما زعمت لمّاشُ تنجو بغربها","فكان لها في القلب غربٌ يؤثّرُ",27,"ر",1,0],["كم أزاحت يد الذكا منك عن خو","د المعانى براقعا وعقاده",28,"د",2,0],["كَمَا زانَ آلُ عُمَيرِ الوَرى","بعلمٍ وَفِعلٍ بعيد المَدى",29,"د",2,0],["كما زعمت فإنّي جئت معتذراً","فسامحي واذكري من ليس ينساكِ",30,"ك",1,0],["كَما زَهى في عَصره حمزةٌ","ربُّ السَجايا وَالنُهى المقالْ",31,"ل",1,0],["كما زاهد ضدَّه راغب","كذا راغبٌ ضده زاهد",32,"د",1,0],["كم أَزار أَرضهمُ","ضُمَّراً لها خبَب",33,"ب",1,0],["كَم أَزْهَرَتْ وَجْهَ عاصٍ بَعْدَ غَيْهَبِهِ","كَأَنَّها الحَوْضُ تَبْيَضُّ الوُجُوهُ بِهِ",34,"ه",1,0],["كم أزبدت من مهجتي نار الهوى","بحرين يروي منهما صاد الروى",35,"ر",3,0],["كَم أَزهَرَ الشِّعرُ ضادًا غَيرَ ذابلةٍ","وأَسهَرَ اللَّيلَ شَدْوٌ بالنَّدَى اغتَسَلا",36,"ل",2,0],["كم أزهقت أنفساً في دارنا سفهاً","والدار لما تزل تغلي على الحِمَم",37,"م",1,0],["كم أزهرتْ منكِ للإسلام ِ رايتُهُ","وشقَّ معناكِ أنوارَ الهُدى دربا",38,"ب",2,0],["كمْ أزحتُ السِّترَ عن ماضٍ تولى","جادَ فيهِ الدَّهرُ يوماً واصْطفانا",39,"ن",2,0],["كما زوجي بِلا شَرَفٍ","سَتبدو لي نِهاياتي",40,"ت",2,0],["كما زاد اليهود النون بغيا","فأنتم واليهود ذوو محال",41,"ل",1,0],["كَمْ أَزْهَرَتْ مَنْ عِلْمِهِ وَبِهَدْيِهِ","هِمَمٌ زَهَا فِيْ قَدْرِهَا تَقْدِيْرُ",42,"ر",1,0],["كم أزكمت منا الأنوف ترى وكم","قد بح من فرط النباح بها حناجر",43,"ر",1,0],["كما زوجي تفيض عليَّ نورا","لسُقْمي بعدما أرقَى كثيرا",44,"ر",2,1],["كم أزمة فرج بعد الأزمه","ما خاب من لاذ به وأمه",45,"ه",1,0]]}