{"poems":[[55,"هو الدهر فينا خليع اللجام","https://www.aldiwan.net/poem29771.html","المتقارب"],[87,"بنى عبد السلام على أبيكم","https://www.aldiwan.net/poem7142.html","الوافر"],[47,"طلا سألت بجو ثهمد","https://www.aldiwan.net/poem63467.html","مجزوء الكامل"],[82,"طرقت والليل ممدود الجناح","https://www.aldiwan.net/poem31522.html","الرمل"],[33,"يا قضاة العباد إن عليكم","https://www.aldiwan.net/poem42665.html","الخفيف"],[203,"يا من لهذا المريض المدنف العاني","https://www.aldiwan.net/poem45158.html","البسيط"],[382,"نصحتك نصحا قل من شأنه النصح","https://www.aldiwan.net/poem66888.html","الطويل"],[385,"يا مكثرا من ذم كل ذميم","https://www.aldiwan.net/poem48760.html","الخفيف"],[463,"لها بعد خطو لات حين مراح","https://www.aldiwan.net/poem56257.html","الطويل"],[524,"تعقد خيط عقدها من آخر","https://www.aldiwan.net/poem419.html",""],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2452","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63846","المتقارب"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105414","الطويل"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33850","الوافر"],[2922,"","https://poetry.dctabudhabi.ae/diwan/poem/105352","الرجز"],[3108,"","https://poetry.dctabudhabi.ae/diwan/poem/146676","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26113","الوافر"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123944","الخفيف"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34683","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86358","الرمل"],[4260,"","https://poetry.dctabudhabi.ae/diwan/poem/200369","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83175","الوافر"],[5213,"انجزك الدهر بما قد وعد","https://www.poetsgate.com/ViewPoem.aspx?id=170452",""],[5277,"أيائلٌ وأوائلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187716",""],[5431,"فصنه بعمق الروح دهرا إذا أتى!","https://www.poetsgate.com/ViewPoem.aspx?id=195171",""],[5848,"سعاد الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=53195",""]],"verses":[["تَعَقَّلَ شارِدُ وَهجِ الهَجيرِ","في جَوِّها بِخُيوطِ السُهامِ",0,"م",1,0],["تعقَّلَ في محبتها فتيا","وأخلص في المحبة وهو كهل",1,"ل",1,0],["تَعقيدُ أَحمَدَ ضَرَّني","وَإِذا أَمَرتَ أَطاعَ أَحمَد",2,"د",1,0],["تعقلُ الطَّرفَ أزاهير به","ثمّ تعطيه أزاهيرَ صراح",3,"ح",1,0],["تَعقِدُ المِرطَ فَوقَ دِعصٍ مِنَ الرَم","لِ عَريضٍ قَد حُفَّ بِالأَنقاءِ",4,"ا",2,0],["تعقَّدت والتوَت كالمستحيل فما","تُريك من موضع فيها لإِمكانِ",5,"ن",1,0],["تعقل إذن يا صاح من سبب الزنا","لجرحٍ عميقٍ عز في طبه النجح",6,"ح",1,0],["تَعقيب فَاِعتبروا بِفَحوى يا أُولي ال","أَلباب مِن شَأن هُناكَ عَظيم",7,"م",1,0],["تعقَّبْ غداً يُمناً وسعداً بها أبا ال","حسين وسعياً مؤذناً بنجاحِ",8,"ح",1,0],["تَعقِدُ خَيطَ عِقدِها مِن آخِرِ","في واضِحِ السالِفَتَينِ عاطِرِ",9,"ر",1,1],["تَعقِدُ المِئزَرَ السُخامَ مِنَ الخَز","زِ عَلى حَقوِ بادِنٍ مِكسالِ",10,"ل",1,0],["تعقَّبْتَ أمرَكَ في وعدِنا","تعقُّبَ ذي دُرْبَةٍ بالأمور",11,"ر",1,0],["تعقبه شجو تلظى شجوته","بأحشاي حتى يجمع الشمل جامعه",12,"ع",2,0],["تَعَقَّدَ وَاِستَوى الطَرَفانِ مِنهُ","كَمِثلِ الدالِ مِن خَطِّ الكِتابِ",13,"ب",1,0],["تعقد زناراً على موشح","من لطفه يكاد ان ينهشما",14,"م",2,0],["تعقبهم قلبي وأعقب في الحشا","علائق حب من عقائل كالدمى",15,"م",2,0],["تَعَقَّبتُ الكَليبَ وَرَنَّحَتها","ضَواحي السَبِّ تَلتَهِبُ اِلتِهابا",16,"ب",2,0],["تعقد الراحتين بالقلب مهما","نثرت بالدموع عقد جمان",17,"ن",1,0],["تعقد عز متصلٍ بكسرى","وملته وذل المسلمونا",18,"ن",2,0],["تعقبت رتّاً جريحاً طمعت","فيه فمال نحوها فجزعت",19,"ت",1,0],["تعقبها بصرصرةٍ","تذيب لباب مهجتها",20,"ه",2,0],["تعقد الزنار من أوساطها","وتريك البرق من أقراطها",21,"ه",2,0],["تعقر الثور والظليم وتلوي","بلبون الترعية المعزاب",22,"ب",1,0],["تَعَقَّدتِ المَشاكِلُ وَاكفَهَرَّت","وُجُوهُ الرَأيِ وَاِربدَّ السَحابُ",23,"ب",1,0],["تعقد زنارا على خصرها","لو تعقد القلب بها لا نعقد",24,"د",1,0],["تعقَّدتْ بعد نأي العينِ غربتُنا","متى تعودينَ كيما تذهبُ العقدُ",25,"د",1,0],["تعقّل ولا تتركْ حبيبا إلى الردى","وجمّع مع الغفران حبا تشتتا",26,"ت",2,0],["تعقد حجاج عينك واعرف انك ذبوح","بس اداريك خوف تزيد قلبي جراح",27,"ح",1,0]]}