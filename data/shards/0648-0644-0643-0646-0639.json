 ... بلا مدى.","https://www.poetsgate.com/ViewPoem.aspx?id=151491",""]],"verses":[["ولكنْ عُرَيْقٌ فيَّ مِنْ عَرَبيّةٍ","يُحامي وراءَ ابنَيْ نِزارٍ ويأْنَفُ",0,"ف",1,0],["وَلَكِن عَلى الحَمدِ إِنفاقُهُ","وَقَد يَشتَريهِ بِأَغلى الثَمَن",1,"ن",1,0],["وَلَكِن عَرَرتَ المَلكَ مِن حَيثُ لا يَرى","فَلَم يَستَطِع لِلحادِثِ الحَتمِ مَدفَعا",2,"ع",2,0],["وَلَكِنَّ عُقْبَى السُّوءِ سُوءٌ مُحَتَّمٌ","وَمَا كَانَ إِحْسَاناً فَعُقْبَاهُ إِحْسَانِ",3,"ن",1,0],["وَلَكِنْ عَنْ وَلاءٍ بِي أكِيدٍ","وَعَنْ رَعْيٍ وَثِيقٍ لِلذِّمَامِ",4,"م",1,0],["وَلَكِن عَطاءُ اللَهِ مِن كُلِّ رِحلَةٍ","إِلى كُلِّ مَحجوبِ السُرادِقِ خِضرِمِ",5,"م",1,0],["وَلَكِن عذَاني أَن أَكونَ أَتَيتُهُ","عَقائِلَ أَوصافٍ يُشَبَّهنَ بِالخَبلِ",6,"ل",1,0],["ولكن على الجِذع الذي هو نابت","بمنبِت سوء فالنقيصة في الجذع",7,"ع",1,0],["ولكنّ عاراً أن تَزَيّا رجالكم","على مسرح التمثيل ِزيّ نساء",8,"ا",2,0],["ولكن عاد مُحتَقباً إليها","فَخار الأرض والشرف السماوي",9,"ي",1,0],["ولكنّ عتباً منك في غير كُنهه","أضاق محلِّي من سمائي ومن أرضي",10,"ض",2,0],["ولكنّ عفوكَ عفوٌ يحلُّ","إذا كان قدرُك قدراً يجلُّ",11,"ل",1,0],["وَلَكِن عَدَتني أَن أَقولَ حَوادِثٌ","إِذا نَزَلَت بِالطَودِ كادَ يَزولُ",12,"ل",1,0],["وَلَكِن عَراني أَن أَراكَ ضَرورَةٌ","إِذا رُمتُ أَمراً فَهيَ رَأيي وَحاكِمي",13,"م",2,0],["وَلَكِن عَلى الجَيشِ تَقوى البِلادُ","وَبِالعِلمِ تَشتَدُّ أَركانُها",14,"ن",3,0],["وَلَكِنَّ عُذرَكَ بَعدَ الوَفاءِ","وَالعُذرُ أَقبَحُ ما يُفعَلُ",15,"ل",1,0],["وَلَكِن عَضاريطُ مُستَأخِرونَ","زَعانِفَةٌ خَلفَ أَدبارِها",16,"ر",3,0],["وَلَكِنَّ عَدلاً لَو سَبَبتُ وَسَبَّني","بَنو عَبدِ شَمسٍ مِن مَنافٍ وَهاشِمِ",17,"م",1,0],["وَلَكِن عَدِمتُ الحُبَّ إِن كانَ هَكَذا","إِذا ما أَحَبَّ المَرءُ كانَ لَهُ حَتفا",18,"ف",2,0],["وَلَكِن عَلى أَن يَعلَمَ الناسُ أَنَّني","عَلى غَيرِ شَيءٍ مِن نَوالِكِ أَتبَعُ",19,"ع",1,0],["وَلَكِن عَجوزاً بِنتَ كِسرى قَديمَةً","مُعَتَّقَةً قَد دَبَّ في طَيِّها الحِلمُ",20,"م",1,0],["وَلَكِنَّ عَقلي مَجلِساً بَعدَ مَجلِسٍ","لِنَفسِكَ مِمّا لا تَنالُ فَسادُ",21,"د",1,0],["وَلَكِن عِرسُ ذَلِكَ بِنتُ دَهرٍ","تَجَنَّبَت الوُجوهَ مُحَمَّماتِ",22,"ت",1,0],["ولكن عداني أن أروم احتفاظها","رسولك وهو الفاضل المتفضل",23,"ل",1,0],["وَلَكِنْ عَجِيباً أَن بَيْنَ جَوانِحِي","هَوى كَشَرَارِ الجمْرةِ المتطايِرِ",24,"ر",1,0],["وَلَكِنَّ عَصْراً فِي الأَبَاطِيلِ جُزْتَهُ","تَقَضَّى بِمَا فِيه وَصِرْت إِلى عَصْرِ",25,"ر",1,0],["ولكنْ عارُكُمْ داءٌ قديمٌ","وداءُ الغدْرِ فاعْلمْ شرّ داءِ",26,"ا",2,0],["ولكنْ عداني أنْ أكونَ أتيتهُ","عقابيلُ أوصابٍ يشبَّهنَ بالخبلِ",27,"ل",1,0],["ولكن على قدْر ما أستطيعُ","أتيت أقابل طوداً بِذر",28,"ر",1,0],["ولكن عدتني أن لأقول حوادث","إذا نزلت بالطود كاد يزول",29,"ل",1,0],["ولكنّ عفوي عفوُ حرٍّ ولم يكن","ليسبقَني لولاه بالوتر واترُ",30,"ر",1,0],["ولكن عصتني واستبدّت بأمرها","فأنتِ هواها يا بثين وشاؤها",31,"ا",3,0],["ولكن عجيبٌ إن تبسمتُ ضَاحِكاً","سلوَّا وما لي في رجوعِك مَهْيَعُ",32,"ع",1,0],["ولكن عداني أن رأيت مذمما","دنيا بتنقيص لنا متصديا",33,"ي",2,0],["وَلَكِن عَنَّ لي غَرَضٌ فَطَرِّز","بِتَبليغيهِ أَنعُمَكَ الجِساما",34,"م",2,0],["وَلكِن عَلَينَا أَن تَجُودِى بنائلٍ","لِغَيرِى وَيَلحَانى عَلَيكِ اللَّوَائِمُ",35,"م",1,0],["وَلكِنّ عُقبى الأمرِ للمتّقي له","بِدُنياهُ والأُخرى له فيهِما البُشرى",36,"ر",2,0],["وَلَكن عَلى علمٍ بسرِّ جمالها","تَعشّقتُها قِدماً وكنتُ بها أدرى",36,"ر",2,0],["ولكن عليه الدهر اخنى وفاؤه","وزادت بؤس الفقر ضرّا على ضر",37,"ر",1,0],["ولكن عينُه حشدت","ليّ الغُنْجَ والحَوَرا",38,"ر",2,0],["وَلَكِنَّ عاراً أَن يُقالَ مُخَيِّبٌ","لِسُؤالِهِ أَو ناكِثُ العَهدِ غادِرُ",39,"ر",1,0],["وَلَكِن عَجيبٌ أَن يَبيتَ مُصَمِّماً","عَلى الفَتكِ مَطبوعُ السَجايا عَلى الصَفحِ",40,"ح",1,0],["وَلَكِنَّ عُمُومَ الْعَجْزِ عَمَّ جَمِيعَنَا","فَلَيْسَ لِمَا يَقْضِي بِهِ اللهُ مَانِعُ",41,"ع",1,0],["ولكن على العلات تزداد رونقا","كما جرب الياقوت في جمراته",42,"ت",2,0],["ولكن على علم بأن صروفها","يموت بها ندب ويحي بها نذل",43,"ل",1,0],["ولكن عيناًلا تراك سخينة","وسمع يحليه سواك معطل",44,"ل",1,0],["ولكن على الإهمالِ ضاعَ فعالكم","فهلا لحقتم باهتمامٍ وهمة",45,"ه",1,0],["وَلكن عداها بالحجاز واحمد","فماقصدها الا الحجاز وَأَحمد",46,"د",1,0],["ولَكِنْ عَلَى أعْقَابِ هَيْجاءَ نَارُها","بماءِ الحَديدِ السَّكْبِ مُضْرَمَةُ الوَقْدِ",47,"د",1,0],["وَلكن عليهِ سعيهُ متوخّيا","وَإِن هو لم ينجَح فَقد أبلغ العُذرا",48,"ر",2,0],["ولكن على مقدار إحسانك الذي","عممت به تخصيص كوني بخلقتي",49,"ي",1,0],["وَلَكِنَّ عِلمي بِما في الثَوا","بِ عِندَ المُصيبَةِ يُنسي المُصيبَه",50,"ه",1,0],["ولكنعار هل ذابت","ليالي الفصل والوصل",51,"ل",1,0],["ولكنّ عينيَ تشَتاقُ أن","تكونَ إلى رَبِّها ناظِره",52,"ر",2,0],["ولكنْ عليك إذا ما أَحلْتُ","مَلأْتَ ليَ الحِجْرَ بِيضاً وصُفرا",53,"ر",2,0],["ولكنْ عَذّرْتُ العَينَ مِمَّا أَتتْ به","وقالتْ وبعضُ القولِ أوضَحُ واضح",54,"ح",1,0],["ولكنْ عدتْني أنْ أعودَ إليكمُ","من الدّهرِ هذي الحادثاتُ الغرائب",55,"ب",1,0],["وَلَكِن عَدلاً صحَّ ميزانُ قِسطِهِ","فَما فيهِ إِنسانٌ يُحامي لِإِنسانِ",56,"ن",1,0],["ولكن عزماً تزعم النفسُ غيرَه","وكيف لها والعزمُ للعزم طاردُ",57,"د",1,0],["ولكن عافني عنه أمور","سأحفي بعضها والبعض أبدي",58,"د",2,0],["وَلكِن عَطاءُ اللَهِ مِن كُلِّ مِدحَةٍ","جَزيلٌ مِنَ المُستخلَفينَ ثَوابُها",59,"ب",3,0],["ولكِنْ عَدَّلُوا مِنْها حِساباً","لَهُ فِيما دَعَوْكَ لَهُ قَضاءُ",60,"ا",2,0],["ولكن علي اجتهاداً لا أضيعه","أنلت سعد اجتهادي أم لقيت شقا",61,"ق",2,0],["ولكن عندهم لي ذاهبات","وتدرك في الجليل وفي الخسيس",62,"س",1,0],["ولكن عَنيّون بي إذ حضَرتُ","عنِيّون بالأمر بعدِي المُلِمّْ",63,"م",1,0],["وَلَكِن عَطَاءٌ مِن إِمامٍ مُبارَكٍ","مَلا الأَرضَ مَعروفاً وَعَدلاً وَسُؤدُدا",64,"د",2,0],["ولكن عداني عنه دهر مكدّر","ومن ذا الذي واتاه في دهره الصفا",65,"ف",2,0],["ولَكِنْ عِنانُ رَشادي غَدَا","مَنُوطاً بِكَفِّ الْقَضا في شُؤوني",66,"ن",2,0],["ولكن عالم الأوها","م يمشي بي على مهل",67,"ل",1,0],["ولكنّ عندي للوفاء شريعةً","تركت بها الإسلام يبكي على الكفر",68,"ر",1,0],["وَلَكن عَلى التَفريط أَصبَحتُ نادِماً","نَدامة صبّ لَم يَفز بِمَرام",69,"م",1,0],["ولكن علمٌ به الجهل انتفى","وتوارى ما له من غبش",70,"ش",1,0],["ولكن على أَنّي أعَلِّقُ فَوْقَهُ","تعاويذَ تحميه من الجِنِّ والإِنس",71,"س",1,0],["وَلَكِن عَن كُؤوسٍ مُترَعاتٍ","كَأَنَّ سَرِيَّ شارِبِها نَضيحُ",72,"ح",1,0],["وَلَكِن عَلى فَيّاضِ بَكرِ بنِ وائِلٍ","سَأُثني وَخَيرُ القَولِ ما لَم يُكَذَّبِ",73,"ب",1,0],["ولكن عداه الجبنُ عما يريده","إلى أن أصار الرعبُ هامتَه رِجْلا",74,"ل",2,0],["ولكن على الآلاتِ والخلقِ عوّلوا","فجاء لأجل الخلق رزقهم كدَّا",75,"د",2,0],["وَلَكِنَّ عِشقي في ضَمانٍ جُفونِهِ","فَيَأمَنُ سَلواني وَيَرجو غَرامِيا",76,"ي",2,0],["ولكن عجيبُ الأمر علمي وغَفلَتي","فديتُكم أيَّ المحاسِن أكشِفُ",77,"ف",1,0],["ولكن على ما قيل للناس جنة","لمن سار في مرضاة ملاه باقيه",78,"ي",2,0],["ولكن علم المرء يورث خرفة","وللجهل حظ وافر ومراتب",79,"ب",1,0],["ولكن عادة الأيام فيها","يقدم قاصر ويذاد ندب",80,"ب",1,0],["وَلَكِنْ عَلَى عَفْوٍ جُبِلْتَ تَكَرُّماً","كَمَا جُبِلَتْ نَفْسُ الْجَبَانِ عَلَى الذُّعْرِ",81,"ر",1,0],["وَلكِنّ عَبد اللَّهِ لما حَوى الغنى","وَصارَ لَهُ من دونِ إِخوَتِهِ مال",82,"ل",1,1],["ولكن على كلِّ حالٍ أخالُ","بأن لكَ نفسك لا تَعذرُ",83,"ر",1,0],["ولكن عجزت فما لي يدٌ","بما يستقلُّ بهدى الحكم",84,"م",1,0],["وَلَكِنَّ عِزَ الدينِ قَد نابَ عَنهُم","فَتىً قَد تَساوى عِندَهُ التِبنُ وَالتِبرُ",85,"ر",1,0],["ولكن عقرب الأصداغ باقٍ","لكل متيمٍ يهواك لاسب",86,"ب",1,0],["ولكن على دار السعادة والصفا","فعامٌ سعيدٌ زانه أسعد الشهم",87,"م",1,0],["ولكن عناها حين وافت حميّها","رأته صريعاً فوقه النقع ثائر",88,"ر",1,0],["ولكنَّ عينيها الجميلةَ أشفَقَت","على قلبي المُضنَي العليلِ المهدَّدِ",89,"د",1,0],["وَلَكِنْ عَدَتْنِي الآن عَنْهُ عَوارِضٌ","أسَاءَتْ إلَى قَلْبِي وَرُضَّ لَهَا الفِكْرُ",90,"ر",1,0],["ولكن عليك من علاك عقائل","على بابها من ان تزار رقيب",91,"ب",1,0],["ولكن عَداني عنكِ خَطبٌ له شانُ","ومَوطئُ آثارٍ تُعَدّ وتُكتَبُ",92,"ب",1,0],["وَلَكِن عَدانِي سُوءُ حَظّي وَعاقَنِي","عَنِ الواجِبِ المَفروضِ فَرطُ التَأَلُّمِ",93,"م",1,0],["ولكن عيني تبصر الموت زاحفاً","على كبدٍ مرضى وقلبٍ مصدع",94,"ع",1,0],["وَلكن عَلى الرانِ القُلوبُ كَأَنَّنا","بِما قد عَلمناهُ يَقيناً تُكذِّبُ",95,"ب",1,0],["ولكن علمى أننى عنه عاجز","شفيعى لديكم والضعيف يراعى",96,"ع",2,0],["ولكن عن الأبصار والشمسُ نورها","بها لم يزل يعطي العيون جلاء",97,"ا",2,0],["ولكن عيون الغيد تظهر جبننا","وتقتلنا في السلم لحظُ الكواعب",98,"ب",1,0],["وَلَكِن عايِشٌ ما عاشَ حَتّى","إِذا ما كادَهُ الأَيّامُ كيدا",99,"د",2,0],["ولكن عقبى كل ضيق وشدة","رخاء وإن العسر من بعده يسر",100,"ر",1,0],["ولكن عرض النفس يبذل ضائعاً","فذلك بين الناس ما لستُ أفهم",101,"م",1,0],["وَلَكن عَلَيهِ لي مِن اللَه ناصر","يَقيني وَيَجلو الكَرب عَني وَيَكشف",102,"ف",1,0],["ولكن على قدر المصائب تحتوي","وقد ترد الآهات وهي غلوب",103,"ب",1,0],["وَلَكِن على قَدري أتيتُ وإنَّهُ","حَقيرٌ ومِثلي في مديحك حائِرُ",104,"ر",1,0],["ولكن عيش الريف أروح للذي","يريد بقاء النفس في حيز الطهر",105,"ر",1,0],["وَلكِن عَلى قَرمٍ هِجانٍ مُشَرَّفٍ","بِلُؤمَتِهِ أَو ذاتِ نيرَينِ عَيطَلِ",106,"ل",1,0],["ولكنّ عرفني على أي مذهب","هم إِذ هم حصن من الجور مانع",107,"ع",1,0],["ولكن علت في الانجم الزهر همتي","فلم أرض بالاخلاد بين الكرائم",108,"م",1,0],["ولكن عسى يحيى بيحي سليله","وكم شبل ليث إثر والده اقتفى",109,"ف",2,0],["ولكن عفت زهو صباك لما","نهاك عن الهوى فيه نهاكا",110,"ك",2,0],["ولكن على تصحيح أخطاء آدم","أعود فلا أعطي لحواء ما تهوى",111,"ا",1,0],["ولكن عندي صافي الفؤاد","وظاهرة عين ما يضمر",112,"ر",1,0],["ولكن عصاني خُفوق الفؤاد","ينادي فيسمعه الجلمد",113,"د",1,0],["ولكنّ عاداتي بروحي تأصّلت","وان كان مني العقل يسعى لقلعها",114,"ع",3,0],["ولكن عبقر نيرانها","يؤججها شعرك العبقري",115,"ر",2,0],["ولكن عجزي عن كفافي يؤودني","فلم أدر طولا للجهاد ولا عرضا",116,"ض",2,0],["ولكن عُلا فضلي أساءت لهم ولي","فكلّ به وصفُ الإساءة قائم",117,"م",1,0],["ولكنْ عبير فاح منك كوردة ،","على الرغم منها عطرها حولها يسري",118,"ر",2,0],["ولكن على الأحرار حمل مؤونتي","إذا ذهبت بي نبوة الدهر مذهبا",119,"ب",2,0],["ولكن على مهلٍ سرت وتولدت","بطول امتزاجٍ فاستقر عمادها",120,"د",3,0],["وَلكِن عَزائي اِنَّهُ راحَ طاهِراً","بِتولاً فَلا وَزرَ عَلَيهِ يُشامُ",121,"م",1,0],["ولكن عند هذا البين طعنٌ","نصادف منهُ قهراً مستمرَّا",122,"ر",2,0],["ولكن على عُمرٍ تَقضَّى ولم يَعُد","لهُ زَمَنٌ يُحظيهِ في لَذَّة الجِسمِ",123,"م",1,0],["وَلَكن عجيب أَن نصحَّ وَتسقم","وَيحيى عليلٌ بعدَ مَوتك يسلم",124,"م",1,0],["وَلكن علمت الرشدَ بعد اختباره","وَأَدركتُ معنى الجدّ من سوء مزحه",125,"ح",2,0],["وَلَكن عُقول