مِيْزَاْنَ الْهُدَاْةِ فَيَرْجَحُ",151,"ح",1,0],["وَلَكِنَّ عِشْقَكَهَا إِنْ سَمَا","وَأَلْقَيْتَ عِبْءَ نِفَاقٍ وَمَيْن 2",152,"ن",1,0],["ولكن على ما قيل جيت انثر اللي جال","بقلبي واثر قلبي يقول ازهل آ وعادي",153,"د",2,0],["ولكن عداهم عنه موت شعورهم","فلم يفقهوا قولاً وظنوك فانيا",154,"ي",2,0],["ولكن عُزْلَةٌ وعذابُ نَفْسٍ","فهل قد نِلْتَ ما زَرَعَتْ يداكا ؟",155,"ك",2,0],["ولكنْ عزَّ مطلبُهُ","تحوَّلنا لنسوانِ",156,"ن",1,0],["ولَكنْ عَرَتْنِي مِنْ هَوَاكِ صَبَابَةٌ","كما كُنتُ أَلقْى مِنْكِ إذْ أَنَا مُطْلَقُ",157,"ق",1,0],["ولكن على باب من بابه","كفيل بعزي وإغنائيه",158,"ي",2,0],["وَلكن على جَزمٍ رَأى حُكمَهُ جَرَى","عَلَى مِلَّةِ التَّلوينِ أرْبَى مِنَ الحَرْبَا",159,"ب",2,0],["ولكنَّ عَينَ الحاسدينَ تَلُوكُهُ","تُحَوِّلُ وهماً ما مُناهُ يُحاوِلُهْ",160,"ل",2,0],["ولكن عاد مخذولا..","فلا صوتٌ يناديهِ",161,"ي",2,0],["ولكن على الكفر البواح الذي به","أباح دماء القوم من كل ذي جحد",162,"د",1,0],["ولكن على النهج القويم كلامه","بآي من القرآن والسنة الغرا",163,"ر",2,0],["ولكن على تقديم سنة أحمد","أقاويل قوم ما أرادوا التقدما",164,"م",2,0],["ولكن عطا خله بقايا حلاله","وفي مفرق الدربين غرّب وشرّقت",165,"ت",1,0],["ولكن على اللهِ رزقُ العبادِ","ويجزي الالهُ غطاءً جزيلا",166,"ل",2,0],["ولكنَّ عشقاً كبيراً عُجَاب!","لكلِّ شريفٍ يصُونُ الثمَرْ",167,"ر",1,0],["ولكنْ عينه نبعٌ لوجدي","تظلّ مكانها من ألفِ مجرى",168,"ر",2,0],["ولكن عسى شِعري يُؤدِّي رِسالةً","يُقابِلُها مِنك الرِّضى والتَّلَطُّفُ",169,"ف",1,0],["ولكنّ عقبى الدار عزٌّ ورفعة","وغيمةُ أمن كل يوم ستمطر",170,"ر",1,0],["وَلَكِنْ عَجِبْتُ لِهَذَا الطَّرِيق","لأَشْوَاكِهِ لَذَّةُ الشَّهَوَاتْ",171,"ت",1,0],["وَلَكِنْ عَلَى شَعْبٍ يَذِلُّ، دِمَاؤُهُ","كَبَحْرٍ، كَأَنَّ الْمَوْتَ قَدْ صَارَ دَيْدَنَا",172,"ن",2,0],["ولكن عقبى السوء سوء محتم","وما كان إحسانا فعقباه غحسان",173,"ن",1,0],["ولكن علوم الشرع حاطت بما يكو","نُ أو كان في سرِّ الغيوب العميقتي",174,"ت",2,0],["ولكنْ عجبتُ لهذا الزمانِ","متى ما اتفقنا .. بنا يَغْدِرُ ..",175,"ر",1,0],["ولكن عاطفيٌّ مستقيمٌ","نزيهٌ أريحيٌ ما تعدّى",176,"د",2,0],["ولكنْ عفّ من سدّ الخطايا