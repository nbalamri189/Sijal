{"poems":[[55,"يا حبذا فوق الكثيب الأعفر","https://www.aldiwan.net/poem30452.html","الرجز"],[51,"طالما احلولى معاشي وطابا","https://www.aldiwan.net/poem10344.html","المديد"],[71,"أفشى إلي صاحبي","https://www.aldiwan.net/poem28738.html","مجزوء الرجز"],[50,"أضرمت نار الحب في قلبي","https://www.aldiwan.net/poem10811.html","السريع"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141988","الكامل"],[242,"يا دار من أهوى رعاك الله","https://www.aldiwan.net/poem19729.html","الكامل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96486","البسيط"],[1955,"","https://poetry.dctabudhabi.ae/diwan/poem/45417","الكامل"],[2394,"","https://poetry.dctabudhabi.ae/diwan/poem/146277","السريع"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52165","الكامل"],[4578,"رنا إلي بعينيه فقلت رشا","https://www.poetsgate.com/ViewPoem.aspx?id=49448",""],[4927,"رثاء الشهيدين برزان التكريتي وعواد البندر","https://www.poetsgate.com/ViewPoem.aspx?id=12987",""],[4958,"هكذا تكلم المجنون","https://www.poetsgate.com/ViewPoem.aspx?id=155102",""],[4968,"كيف احتمالي","https://www.poetsgate.com/ViewPoem.aspx?id=208090",""],[5106,"في روحه قمر تناثر من قمر","https://www.poetsgate.com/ViewPoem.aspx?id=150037",""],[5776,"هَذَيَانُ الليل","https://www.poetsgate.com/ViewPoem.aspx?id=199454",""],[178,"أقرح القلب والحشا","https://www.poetsgate.com/ViewPoem.aspx?id=200970",""],[5809,"المطلع","https://www.poetsgate.com/ViewPoem.aspx?id=205135",""],[5829,"إنه شعبان","https://www.poetsgate.com/ViewPoem.aspx?id=204021",""],[5956,"أخلاق الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=192555",""]],"verses":[["أَفشى حَنينُ رِكابِهِم سِرَّ السُرى","لَغَباً فَأَضمَرَ في نَزائِعَ ضُمَّرِ",0,"ر",1,0],["أَفشِ مَعروفَكَ فيهِم وَأَكثِر","ثُمَّ لا تَبغِ عَلَيهِ ثَوابا",1,"ب",2,0],["أفشى إليَّ صاحبي","سراً وَقَدْ لقيتُهُ",2,"ه",1,1],["أَفشَيتُ سِرّي وَتَناسيتَني","ما هاكَذا الإِنصافُ يا حِبّي",3,"ب",2,0],["أفشامخ منها بمفرق تائه","ولأنت أجمل وردة فى مفرق",4,"ق",1,0],["أَفْشَتْ نَوَاسِمُهَا سَرَائِرَ نَوْرِهَا","لِلَّهِ سِرُّ النَّوْرِ مَا أَفْشَاهُ",5,"ا",2,0],["أفشى هنالك مما كان قد عصروا","فيهم صنائع مما كان يدخر",6,"ر",1,0],["أَفشى عَلَيَّ مَقالَةٌ ما قُلتُها","وَسَعى بِأَمرٍ كانَ غَيرُ سَديدِ",7,"د",1,1],["أفش التحيّات إلى أهلها","ونبّه الناس على رتبتك",8,"ك",1,0],["افش السلام وصافح للذكور اذا","كان المصافح غير المرد من نسم",9,"م",1,0],["أفشى لنا سرَّ البلاغة علمُهُ","بعضُ الذي يُفشي يكون حلالا",10,"ل",2,0],["أفشى حديث الهوى من طيب شامته","نشرٌ به خبري في العالمين فشا",11,"ش",2,0],["أَفْشَى الرَّذَاْئِلَ فِيْ عِرَاْقِ عُرُوْبَةٍ","عَرَبِيَّةٍ أَعْدَاْؤُهَا الزُّعْرَاْنُ",12,"ن",1,0],["أفْشَيْتُ للصّمْتِ ابْتِهالات النّهارِ","وَتَمْتَماتِ الليلِ وهْوَ يُلَيِّلُ",13,"ل",1,0],["أفشتْ بسرّي حروفٌ زانَها ولهٌ","موجُ اليراعِ من الأشواقِ يرتجف",14,"ف",1,0],["أَفْشَتْ عَصَاْفيْرُ المُنَىْ أَحْلاْمَهُ","فَوْقَ الوِقَاْرِ تَحَاْمُلاً تَنْوِيْ السَّهَرْ",15,"ر",1,0],["أفشى إليّ الليلُ ما أفشى","إذ همّ أنْ يغشى... ولا يغشى",16,"ش",2,1],["افش وصلا فإنّ","هجرك لا كان قد فشا",17,"ش",2,0],["أفشَتْ لنا العينانِ سرَّ فؤادِها","كتبَتْهُ في الخدينِ منها الأدمعُ",18,"ع",1,1],["أفشوا السلام فإن فيه إذا فشى","عدل يسود وتحفظ الأوطان",19,"ن",1,0],["أفشي السلام ومُطعمٌ أهلي ومَن","يأتي من الضيفانِ مما اكتسبْ",20,"ب",1,0]]}