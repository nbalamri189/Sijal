38,"علامك غيوبي","https://www.poetsgate.com/ViewPoem.aspx?id=25686",""],[6093,"إبحار نحو الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=199940",""],[6093,"عَقِيْقَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=204951",""],[5724,"ربيعك للروح كالبلسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55133&r=&rc=0",""],[6223,"حثالة الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1211&r=&rc=6",""],[6359,"قرية ٍ ماتت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69087&r=&rc=1",""]],"verses":[["يُحَرِّكُني مَن ماتَ لي بِسُكونِهِ","وَتَجديدُ دَهري أَن أُرى الدَهرَ باكِيا",0,"ي",2,0],["يحرِّكُ طِرْفَهُ وبهِ لُغوبٌ","ويَمْسَحُ طَرْفَهُ وبهِ سُهادُ",1,"د",1,0],["يُحرِّمُ الغسلَ إيلاءً ويطلقه","برّاً فيوخفه بالثأر إيخافا",2,"ف",2,0],["يُحَرِّكُ وَجدي في الأَراكَةِ طائِرٌ","وَيَبعَثُ شَجوي في الدُجَنَّةِ بارِقُ",3,"ق",1,0],["يُحَرِّمُ شُربها غاوٍ رآني","أَخا شَيْبٍ فقلتُ الآنَ حَلاَّ",4,"ل",2,1],["يُحَرِّمُ أَن يَمَسَّ الطيبَ بَعدي","وَقَد عَبِقَ العَبيرُ بِهِ وَصاكا",5,"ك",2,0],["يُحَرّمُهُ لَمْعُ الأسِنّةِ فَوْقَهُ","فَلَيْسَ لِظَمْآنٍ إلَيْهِ وُصُولُ",6,"ل",1,0],["يحرق ما مرَّ به راجفاً","من حيوانات وأشجارِ",7,"ر",1,0],["يُحَرِّقُ تَحريقَ الصَواعِقِ أُلهِبَت","بِرَعدٍ وَيَنقَضُّ اِنقِضاضَ الكَواكِبِ",8,"ب",1,0],["يحرك أنفاس الرياح حراكها","كأن نسيم الريح فيهن كامن",9,"ن",1,0],["يُحرِّكن أعطافَ العَليلِ صَبابةً","إذا حرَّكَتْ أعطافُهنّ الغَلائِلا",10,"ل",2,0],["يُحَرِّكنَ في الكَفَّينِ شيزاً كَأَنَّهُ","قِداحٌ بِكَفَّي ياسِرٍ تَتَقَلقَلُ",11,"ل",1,0],["يُحَرَّكُ أَوتاراً تُناسِبُ حِسَّها","بِها تَسكُنُ الأَرواحُ حينَ تُحَرَّكُ",12,"ك",1,0],["يُحَرِّضُها الطَرادُ عَلى الأَعادي","كَأَنَّ الكَرَّ يُذكِرُها المَخالي",13,"ل",2,0],["يحرّفُ بالتأليل أذناً كأنّما","ترى قلماً منها يخطّ كتابا",14,"ب",2,0],["يَحرُسنَ بِالبَذلِ عَرضاً ما يَزالُ مِنَ ال","آفاتِ بِالنَفحاتِ الغُرِّ مَحروسا",15,"س",2,0],["يُحَرِّمُ حُسنَ مَنظَرِهِ مَليكٌ","يُحَرِّمُ مُلكَهُ القَدَرُ المُتاحُ",16,"ح",1,0],["يُحَرِّقُكَ مِنهُ سَنا شُعلَةٍ","هُناكَ وَيُغرِقُكَ طَوراً وَشَل",17,"ل",1,0],["يَحرسُ القُبّةَ ما فيها سِوَى","حارسُ الجيشِ وحَامي العَلَمِ",18,"م",1,0],["يُحَرَّقُ في الأُخرى بِجَدِّكَ جِسمُهُ","وَيُحرَقُ في الدُنيا بِخَدِّكَ قَلبُهُ",19,"ه",1,0],["يحرس اللَهُ مَجدَنا ما بَذَلنا","في سَبيل الأَوطان نَفساً وَمالا",20,"ل",2,0],["يُحْرِمنَ في الرَّيطِ من مثنىً وواحدةٍ","وليسَ يَحْرِمْنَ إلاّ في الموَاعيدِ",21,"د",1,0],["يُحَرِّمُ فيكُمُ الصَهباءَ صُبحاً","وَيَشرَبُها عَلى عَمَدٍ مَساءَ",22,"س",3,0],["يُحَرِّقُ نَفسَهُ الهِندِيُّ خَوفاً","وَيَقصُرُ دونَ ما صَنَعَ الجِهادُ",23,"د",1,1],["يحرك الكون طرا","ولا تخور قواه",24,"ا",2,0],["يحرِّكُني والمَوْتُ يَحْفُرُ مُهجتي","ويهتاجُني والنَّفْسُ عِنْدَ حناجري",25,"ر",2,0],["يُحَرِّكُ رِجلَهُ رُعباً وَفيهِ","سِنانُ الرِمحِ يَلمَعُ كَالشِهابِ",26,"ب",1,0],["يُحَرِّكُ الْطَّوْدَ إِذَا ثَارَ أَوْ","يَهْدَأُ رِفْقاً فيَهِزُّ السَّرِيرْ",27,"ر",1,0],["يحْرُسُ الْفَنَّ في ظِلالِ نَوَاحِيهِ","وَيَرْمِي عَنْ دَوْحِهِ غِرْبَانَه",28,"ن",2,0],["يحرر نفسا من عبودة مطمع","سوى رغب فيه الى الله طامع",29,"ع",1,0],["يحرس الأثرى، يباكي مَن بكى","يرتدي أجفان \"عيسى\" وهو \"سادي\"",30,"د",2,0],["يحركني والموت يحفز مهجتي","ويهتاجني والنفس عند حناجري",31,"ر",2,0],["يحَرِّمُهَا جَفْنٌ تَرَصَّدَ بِالنِّبْلِ","ورَأْسٌ إِذَا مَا زَانَهُ تَاجُ شَعْرِهَا",32,"ه",2,0],["يُحَرِّضُ قَومَهُ كَي يَقتُلوني","عَلى المُزَنّي إِذ كَثُرَ الوُعوثُ",33,"ث",1,0],["يحرك اشجانا وينهض همة","ويحيى من الآمال رمة ميت",34,"ت",1,0],["يَحرُسُ أَكلاءَهُ وَيَحفَظُهُ","طِرفٌ كَتَيسِ الظِباءِ مُنجَرِدِ",35,"د",1,0],["يُحرِزُونَ المَدى وَتَذهَبُ بِالحَم","دِ فَما يَربَحونَ إِلّا العَناءَ",36,"ا",2,0],["يحرك في النفس أسما الخصال","بريء من السخط والانفعال",37,"ل",1,0],["يَحرِثُ الاِرضَ هادِئاً مطمئنّاً","فَيَشقُّ الاتلام كَالجَرّاحِ",38,"ح",1,0],["يحرسُها فِرعَونُ في قَبرِهِ","فِرعونُ حيٌّ فيهِ لا يُنكَرُ",39,"ر",1,0],["يحرم الحر من مناه ويعطي","نعمة الله للعبيد السود",40,"د",1,0],["يَحرِقُ النابَ عَلَينا عاتِباً","كُلَّ وَقتٍ في حَرامٍ وَحَلالِ",41,"ل",1,0],["يحرمُه ما عندَه","ولا يُراعي ودَّه",42,"ه",1,0],["يُحرك أَشجان القُلوب بَديعُهُ","وَيُطربها حَتّى تَكاد تَطيرُ",43,"ر",1,0],["يحرس ويسلم من ندامه","يفرح إذا حان الحمام",44,"م",1,0],["يحرق أحشائي بنار الهوى","وأدمعي من مقلتي تسبل",45,"ل",1,0],["يحرضني فيه على العلَم والتُّقى","ويدعو إلى العليا ويهوى ويُرْشدُ",46,"د",1,0],["يحرِّموني فلا عودي بمهتصَرٍ","فيهم ولا خُضْرُ أوراقي لمن خرطا",47,"ط",2,0],["يَحرُسها وليس من حُماتِها","مثلُ الشَّغَا ينقُصُ وهو زائدُ",48,"د",1,0],["يَحُرُّ عَلَيَّ أبيضُها خمولاً","وكنت بجاهِ أَسْوَدِها أَسودُ",49,"د",1,0],["يحرك أعطاف المعالي سماعهُ","ويبعثُ أطراب النهى ويهيّج",50,"ج",1,0],["يحرس المال ولا يأكله","نظر البازي على مربأته",51,"ت",2,0],["يحرك وجدي قدك المتمايل","وقلبي الى ذاك التحول مايل",52,"ل",1,1],["يَحَر بِهِ عَلى مَدى الأَيّامِ","وَيَصلَ ناراً مِن حَميمٍ حامِ",53,"م",1,0],["يحرق الكف للجهول إذا جسّْ","ثم قالوا لكلِّ من يطلب المسّْ",54,"س",1,0],["يحركها صوت السماع بوقعه","فتظهر منها للعيان الأشائر",55,"ر",1,0],["يحرر في علم ابن إدريس للورى","دروساً تولى جملها خير حامل",56,"ل",1,0],["يَحرّضهم لَدى الهَيجا كُلَيبٌ","عَلى لَيث تذلّ لَهُ الرِقاب",57,"ب",1,0],["يحرّمون عليكم ما لأنفسهم","يحللون بلا شرع ولا دين",58,"ن",1,0],["(يُحَرِّرُهُ) !! مَنْ غدَا سِجْنَه","وَسَجَّانَهُ.. وَالدِمَا لا تَعِي",59,"ع",2,0],["يحركها من خالص الشوق نسمةً","لتحظى بمرأى من هواني وأهواه",60,"ا",2,0],["يحركني الهوى شوقاً إليها","فيمسي في معالمها سكوني",61,"ن",2,0],["يحركه بخار فيه يقوى","وطيس النار فيه على اتقاد",62,"د",1,0],["يُحَرّرُ كُتْباً أوْ يَجُرُّ كَتَائِباً","لِتَشْيِيدِ ملكٍ أوْ لِتَبْيينِ مُبْهَمِ",63,"م",1,0],["يُحَرِّكُ شَجوَ النَّفسِ ذِكرى سُكونِهِ","وَأُنسِي بِهِ بَينَ التَّرائِبِ وَالنَّحرِ",64,"ر",1,0],["يُحرم بيع الخمر في الشرع كما","يحرم شربها بنص أحكما",65,"م",2,0],["يُحرَمُ بَيضاءَ مَمكورَة","وَيَغنيهِ في البَضعِ عَنها غَلامُ",66,"م",1,0],["يُحرِقها ذا وَذاكَ يَهدِمها","وَيشتَفي بالنِهاب شاطرها",67,"ر",3,0],["يحرم الرضاع ما يسبقه","من النكاح كالذي يلحقه",68,"ه",1,1],["يحرم بالرضاع ما قد حرما","من نسب على الذي قد رسما",69,"م",2,1],["يحرك الدل منه غصناً","ويطلع الحسن فيه بدرا",70,"ر",2,0],["يُحرّكني إليه سُكون وجدي","ولا تعجب لتحريك السكون",71,"ن",1,0],["يحرسها الناطور في البستان","خوفاً عليها من يد الزمان",72,"ن",1,0],["يحرسه في الدجى ويحظى","بحسنه والعيون يقظى",73,"ا",1,0],["يحركها الشوق الملح فتغتدي","من الشوق مما قد ألح بها نشوى",74,"و",2,0],["يحركها من حرك الكون كله","وهادي جميع الكائنات لها يهدي",75,"د",2,0],["يحرس البيت أن يغيبوا وإن عا","دوا تلقى الجميع بالترحاب",76,"ب",1,0],["يحرك ذيله اما يراني","ويقفز قفزة الظبي الأغن",77,"ن",1,0],["يُحركه الشَوق القَوي فَلَو رَأى","مَجالاً بِأَذيال النَسيم تَعَلقا",78,"ق",2,0],["يحرر مصرا ويبنى لها","صروح السعادة في القابل",79,"ل",1,0],["يُحركني برقُ الحجاز إذا سَرَى","فأدعوا لأوطان الأحبّة بالسقيا",80,"ي",2,0],["يُحرِّمُ ختلانَ الرقادِ عليهم","فتىً لا يرى أنَّ الرقادَ حَلالُ",81,"ل",1,0],["يحرمُ الناس بعضهم لذة العي","ش وما بينهم عليها قتال",82,"ل",1,0],["يحر العلوم وفضله","موف على الفضلاء زاري",83,"ر",2,0],["يُحرَمُ اللَيثُ صَيدَهُ وَهوَ مِنهُ","بَينَ حَدِّ الأَنيابِ وَالأَظفارِ",84,"ر",1,0],["يحرق الجمرُ يابسَ الحطب الجز","ل ويأبى الحريق لدنٌ مريع",85,"ع",1,0],["يحرك الذكر مني كل عاطفة","كالريح إذ تلمس الأغصان تلويها",86,"ي",3,0],["يحرك مبضعاً كالبرق يمضي","كأن البرء يقطر من شباه",87,"ا",2,0],["يُحرِّكُ بالأعْطافِ أجْنحِةَ الهوَى","إذا حرَّكَتْ من فَوْقهِنَّ الغلائلا",88,"ل",2,0],["يحرزن الأسطول والمجد الأغر","تلكم منيته اغتر بها",89,"ه",2,0],["يُحَرِّقُهُم داعي الضَّرُورَةِ لِلوَغى","لِتُحفَظَ أَعرَاضٌ وَتَسلَمُ وُلدُهُم",90,"م",1,0],["يَحرِقُ أَفخاذاً مِنَ الثيرانِ","لِزَفسِ يَستَرضيهِ بِالقُربانِ",91,"ن",1,0],["يحرر ما مِنهُ يُحرر شَعبنا","وَما صَده عَن ذاكَ قيل وَلا قال",92,"ل",1,0],["يحركني من ليس يدرك غايتي","ولم يدر ما تصبو إليه جوارحي",93,"ح",2,0],["يحرّك الشوق منه ريحُ أسحار","ويثبت الوجدَ فيه سجعُ أطيار",94,"ر",1,0],["يحركها ريح الدلال ولينها","وثبتها حفف لذا تتمايل",95,"ل",1,0],["يحرك أوتار القلوب ادكاره","ليالي كنا والحبيب بها معا",96,"ع",2,0],["يحركُ الدهر منا ساكناً أبداً","ويوقظ الموتُ منا طرف مسْبوتِ",97,"ت",1,0],["يحرسُ النَّرجسُ الُمضاعَفُ من عَي","نَيهِ فيهِ شَقائقَ النُّعمانِ",98,"ن",1,0],["يحرسُ وردَ خدِّه بمرهُفٍ","قد حا