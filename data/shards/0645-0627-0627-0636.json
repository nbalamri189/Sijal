{"poems":[[55,"من رأى البرق بغوري السند","https://www.aldiwan.net/poem30636.html","الرمل"],[57,"مرت بنا تشرق الدنيا ببهجتها","https://www.aldiwan.net/poem26419.html","البسيط"],[56,"ما أضيع الغمد بغير نصله","https://www.aldiwan.net/poem27345.html","الرجز"],[87,"كل يوم مهرجان كللوا","https://www.aldiwan.net/poem62933.html","الرمل"],[47,"من سائل لمعذر عن خطبه","https://www.aldiwan.net/poem10888.html","الكامل"],[47,"إن سير الخليط حين استقلا","https://www.aldiwan.net/poem65546.html","الخفيف"],[68,"أترى البارق الذي لاح ليلا","https://www.aldiwan.net/poem40649.html","الخفيف"],[99,"ما أضيع الصبر في جرح أداريه","https://www.aldiwan.net/poem24863.html","البسيط"],[46,"عنت فأعرض عن تعريضها أربي","https://www.aldiwan.net/poem29680.html","البسيط"],[46,"وعاذل عذلته في عذله","https://www.aldiwan.net/poem29687.html","الرجز"],[92,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[107,"قل للحسين ولات حين ملام","https://www.aldiwan.net/poem43043.html","الكامل"],[107,"يا دولة من بقايا الظلم طاف بها","https://www.aldiwan.net/poem43379.html","البسيط"],[108,"تكلمي يا كتائب","https://www.poetsgate.com/ViewPoem.aspx?id=179636",""],[108,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[47,"إنّ سَيْرَ الخَليطِ، حينَ اسْتَقَلاّ","https://www.poetsgate.com/ViewPoem.aspx?id=32060",""],[102,"ساعة نقاش مع طالبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67693&r=&rc=180",""],[124,"قمر يحلم في لج السما","https://www.aldiwan.net/poem49267.html","الرمل"],[124,"آنستني بالأملا المغري","https://www.aldiwan.net/poem49283.html","السريع"],[124,"ما أضعت الهوى ولا خنتك الغيب","https://www.aldiwan.net/poem49339.html","الخفيف"],[164,"أرخا أثيث الدجى الجاني على الفلق","https://www.aldiwan.net/poem59000.html","البسيط"],[214,"يا عين جودي لفقد الألف بالسهر","https://www.aldiwan.net/poem13571.html","البسيط"],[240,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[323,"رباعيات الخيام","https://www.aldiwan.net/poem63242.html","عموديه"],[382,"اليوم يخفق كل نجم مرجف","https://www.aldiwan.net/poem59331.html","الكامل"],[385,"البدر يغار إذا سفرا","https://www.aldiwan.net/poem48784.html","المتدارك"],[458,"شاعر الحب والجمال دعوني","https://www.aldiwan.net/poem61250.html","الخفيف"],[468,"الرب باق والخلائق فانيه","https://www.aldiwan.net/poem925.html",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122696","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59436","السريع"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56335","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108931","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108933","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123046","البسيط"],[2263,"","https://poetry.dctabudhabi.ae/diwan/poem/140242",""],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106875","الكامل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111273","الخفيف"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100929","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100895","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93959","المجتث"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104684","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100761","الكامل"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71387","الخفيف"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97978","البسيط"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101234","الخفيف"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36725","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77115","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77116","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77080","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77114","البسيط"],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141837","الكامل"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136760",""],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133091","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133170","الكامل"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139196","السريع"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35445","الكامل"],[4690,"أنا لا أراك","https://www.poetsgate.com/ViewPoem.aspx?id=120303",""],[4755,"لَيلٌ.. وصَنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=203125",""],[4755,"لَيلٌ دَقَائِقُهُ سَمِيكةْ","https://www.poetsgate.com/ViewPoem.aspx?id=205604",""],[5147,"ما أضمرت مني الضمائر","https://www.poetsgate.com/ViewPoem.aspx?id=166704",""],[5149,"أيها القدرُ","https://www.poetsgate.com/ViewPoem.aspx?id=212221",""],[5183,"ثلمة الأبد","https://www.poetsgate.com/ViewPoem.aspx?id=180256",""],[5186,"ما اضطهاد الذين يثني اللواتي","https://www.poetsgate.com/ViewPoem.aspx?id=156493",""],[5293,"المتكبرة","https://www.poetsgate.com/ViewPoem.aspx?id=186134",""],[5376,"للقلبِ في أحزانِه أنَّاتُ","https://www.poetsgate.com/ViewPoem.aspx?id=193284",""],[5409,"لم ينل من علاك كل أثيم","https://www.poetsgate.com/ViewPoem.aspx?id=155489",""],[5431,"هي المحبة سر الله ...","https://www.poetsgate.com/ViewPoem.aspx?id=191429",""],[5533,"ما بَيْنَ بُرْدَيَّ","https://www.poetsgate.com/ViewPoem.aspx?id=181664",""],[5628,"الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=178539",""],[5736,"حروف مهزومة","https://www.poetsgate.com/ViewPoem.aspx?id=203159",""],[5736,"أضغاث عاطفة","https://www.poetsgate.com/ViewPoem.aspx?id=208867",""],[5956,"الهواء لفح جيد فراس","https://www.poetsgate.com/ViewPoem.aspx?id=193304",""],[6260,"ذكرى الهجرة النبوية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68351&r=&rc=43",""]],"verses":[["ما أَضَلَّ الرَمحُ فيها مِنهُمُ","عَثَرَ السَيفُ بِهِ فيما وَجَد",0,"د",1,0],["ما أَضمَرَ القَلبُ شَيئاً تَغضَبينَ لَهُ","إِلا رَفَعتُ إِلَيكِ الطَرفَ مُعتَمِدا",1,"د",2,0],["ما أَضيعَ الغِمدَ بِغَيرِ نَصلِهِ","وَالعُرفَ ما لَم يَكُ عِندَ أَهلِهِ",2,"ه",1,1],["ما أَضَلَّ الناسَ حَتّى المَوتُ لَم","يَخلُ مِن زورٍ لَهُم أَو مِن رِياء",3,"ا",2,0],["ما أَضعَفَ الإِنسانَ إِلّا هِمَّةً","في نُبلِهِ أَو قُوَّةً في لُبِّهِ",4,"ب",2,0],["ما أُضيعَ الهَوى وَلا نُسِيَ الخِل","لُ الَّذي ضَيَّعَ الهَوى وَتَخَلّى",5,"ل",2,0],["ما أَضا البارِقُ العِراقيُّ إِلّا","أَرسَلَت مُقلَتي مِنَ الدَمعِ سَيلا",6,"ل",2,0],["ما أضيع الصبر في جُرح أداريه","أريد أنسَى الذي لا شيء يُنسيه",7,"ه",1,1],["ما أَضيَعَ العَقلَ إِن لَم يَرعَ ضَيعَتَهُ","وَفرٌ وَأَيُّ رَحىً دارَت بِلا قُطُبِ",8,"ب",1,0],["ما أَضيَعَ الغِمدَ بِغَيرِ نَصلِهِ","وَالشِعرَ ما لَم يَكُ عِندَ أَهلِهِ",9,"ل",2,0],["ما أضيعَ الماسَ مصنوعاً ومتطَبِعاً","حتى لدى أهلِ تمييزٍ وتثمين",10,"ن",1,0],["ما أَضْيعَ الحرمَيْن في يد عُصبةٍ","ملكت سبيلَ الحجّ والإحرامِ",11,"م",1,0],["ما أَضيعَ التاجَ يَرمي الشَعبَ صاحِبُهُ","بِالمُحفظاتِ وَيُؤذيهِ بِما كَسَبا",12,"ب",2,0],["ما أضعَفَ «المكروبَ» في تكوينه","لكنَّه يفري أديمَ الضَّيغَم!",13,"م",1,0],["ما أضعف الإنسان مق","درةً، وأكثرَ ما ادعاه!",14,"ا",2,0],["ما أضيع النبل اذا تطاولت","خساسة العرق عليه بالحبى",15,"ا",1,0],["ما أُضِيعَ الهَوَى وَلا نُسِيَ الخِلُّ","الذي ضَيّعَ الهَوَى، وَتَخَلّى",16,"ل",2,0],["ما أضيعنا يا شاعرتي","في عصر الوزن بلا ميزان",17,"ن",1,0],["((ما أضعفنا شيء إلا","ما فينا من طين الإذعان))",17,"ن",1,0],["ما أضل القلب بالليل وما","أضرب الوجد عليه بالسدد",18,"د",1,0],["ما أضأل الأمال زاداص وما","أخونها في موقف النصر",19,"ر",1,0],["ما أضعت الهوى ولا خنتك الغي","ب وحاشا لمثلنا أن يخونا",20,"ن",2,1],["ما أضمروا لك مكروها ولا اجتعموا","لنقض عهد ولكن الشقي شقي",21,"ق",2,0],["ما اضحكت بالهنا يوما اخا طرب","الا وابكته في ايامه الاخر",22,"ر",1,0],["ما أَضمَرَت وَجداً وَلا اِشتَمَلَت لَها","يَومَ الوَداعِ عَلى غَرامٍ أَضلُعُ",23,"ع",1,0],["ما أضيَعَ اليومَ الذي مَرَّ بي","من غيرِ أن أهوى وأن أعشقَ",24,"ق",1,0],["ما أضيع استيفاءَ وصفي قدرَه","يفنى الزمانُ وفيه ما لم يوصف",25,"ف",1,0],["ما أَضمَرَ شَيئاً لا يَرضي","ك إِذا ما ذاعَ وَلا عذرا",26,"ر",2,0],["ما اضطهادي بنائل من جناني","لو رأيت الضياء يعو لغبن",27,"ن",1,0],["ما اضحكتني بعض يوم غلطة","الا وابكتني بقية عاميه",28,"ي",2,0],["ما أضمرت نَفسٌ لِشَخصِكَ غِيلَة","إلاَّ كَفاكَ الخالِقُ المخلُوقا",29,"ق",2,0],["ما أضحكت من امرئ بالمنى","إلا وبكته الدموع الدوام",30,"م",1,0],["ما أضا بدرٌ وشمنا أنجما","في ليالٍ أشرقت بالأنسِ",31,"س",1,0],["ما أضعف الإنسان بين جفونها","وإذا تسطَّى يضعف الإنسان",32,"ن",1,0],["ما أضعف الآساد من خفّانِ","إن قاتلت بفواتر الأجفانِ",33,"ن",1,1],["ما أضل الأنام من مبدء الده","ر إلى أن يكاد أن يثناها",34,"ا",3,0],["ما أضمر المرء يبدو من شمائله","قولاً وفعلاً وأمسى غيرُ مكتتم",35,"م",1,0],["ما أضيع العمران أصبحت تصحبه","سبهللا فارغ الأشغال والمهن",36,"ن",1,0],["ما أضيع الأيام مجفلةً","في قلب صب يألف الذكرى",37,"ر",2,0],["ما اضمحل الدجا وأسفر صبح","وأضاءت كواكب بسلام",38,"م",1,0],["ما أضيعَ الدنيا لدى","من لا يرى للعيش قدرا",39,"ر",2,0],["ما أضيعَ المرء فى دار اذا استبقت","فيها الغيوث ورجى جرعة مُنِعَا",40,"ع",2,0],["ما اضطره الحب حتى","يرضى ويختار فعله",41,"ل",2,0],["ما أضحك الرحمن سنك عندما","حمى الوطيس وشب في الهيجاء",42,"ا",2,0],["ما اضحك النبلاء في أيامهم","الا تبجح معشر جهلاء",43,"ا",2,0],["مَا أَضَاء البَرْقُ اللَّمُوعُ بِنَجْدِ","إِنَّمَا ذَاكَ مِنْ تَبَسُّمِ هِنْدِ",44,"د",1,1],["ما أضيع العمر من معنى","حياته لوعة وشكل",45,"ل",1,0],["ما أضل النفوس إلا نفوس","عن عداها ضلت وحظ تعيس",46,"س",1,0],["ما آض طَرفُ اللحظِ فيكَ مُسلِّماً","إِلّا وَفاضَت مُهجَتي بِسَلامِ",47,"م",1,0],["ما أَضحَكَ الرَوضُ بُكاء المَزن","أَو كَشَّفَ البَدرُ خِمارَ الدجَن",48,"ن",1,0],["ما أَضحَكَ المَزنُ أَزهارَ الرِياضِ وَما","غَنى بِمَدحِكَ شادَ قَدَّم الغَزلا",49,"ل",2,0],["ما أَضحَكَ الرَوضِ المُدَبج في رُبى","مَزن يَسح بِواكِفِ رَجاسِ",50,"س",1,0],["ما أَضحَكَ الرَوضُ هامي وَدق غادية","وَقامَ في زَهرِهِ مِن طائِرٍ غرد",51,"د",1,0],["ما أضحكت دار الغرور منعما","إلا وأبكت بالدماء نواظره",52,"ر",2,0],["ما أضيق العمر لولا فسحة الآمل","لو لم يكن لي من العلياء منزلة",53,"ه",1,0],["ما أضحكت في الوغى يوماً بوارقها","إلا وأبكت على الأرواح أبدانا",54,"ن",2,0],["ما أضحكت أحداً يوماً بصافيةٍ","إلا وأبكى غداً تكدير صافيها",55,"ي",3,0],["ما أضحكت إلا وأبكت بعده","وما بنت إلا وأخربت البنا",56,"ن",2,0],["ما أضيع الفاضل يا ويحه","كأنه ليس من الخلق",57,"ق",1,0],["ما أَضحَكَ الرَحمنُ سِنّكَ عِندَما","تُولي الجَزيلَ بِكَفِّكَ المِعطاءِ",58,"ا",2,0],["مَا أضْيَعَ العُمْرَ الذِّي","أَنْفَقْتُهُ أَبْغِي رِضَاكِ",59,"ك",1,0],["ما أَضْيَعَ العُمرَ في هذي البِلادِ.. وما","أَمَرَّ ما ذاقَ مِنها كُلُّ مُبتَعِدِ",60,"د",1,0],["ما أَضيَعَ المَعنَى الكَبيرَ","أَمَامَ قافِيةٍ رَكِيكة",61,"ك",2,0],["ما أضمرت مني الضمائر","غير المنى في ربوع حاجر",62,"ر",1,1],["مَا أَضْيَقَ العَيْشَ لِلسَّاعِينَ في عَجَلٍ","اقْصِدْ بِمَمْشَاكَ إنَّ الحَتْفَ يَنتَظِرُ",63,"ر",1,0],["ما أضاعتك حوطة الله لكن","عانقتك الحوراء فانفك عقد",64,"د",1,0],["ما اضطهاد الذين يثني اللواتي","عن أداء الفروض والواجبات",65,"ت",1,1],["مَا أَضْيَعَ الحُسْنَ لمْ تُنْصِفْهُ رَائِعَةٌ","مِنَ القَصَائِدِ أَو لحَنٌ يُنَاجِيهِ",66,"ي",2,1],["ما أضيق العيش الذي نهفو له","لولا التأسي ما دنتْ بسماتُ",67,"ت",1,0],["ما أضل التاريخ إن كان فيه","يستوي المجرمون والأولياء",68,"ا",2,0],["ماأضيق العيش لولا الحب يسحره","فيجعل المرّ في أطباقنا عسلا",69,"ل",2,0],["\"ما أَضْيقَ العَيْشَ\" في ظُلْمَةٍ أَكَلَتْ","ضَوْءَ النَّهارِ فما يُرْجَى لهُ ضَرَمُ",70,"م",1,0],["ما أضيع العمْرَ أحياهُ على أمل ٍ","بين الأكاذيبِ مُنْذ ُالبدءِ مقتولِ",71,"ل",1,0],["ما أضيع الحرف في كفيك لو أخذت","معاول اليأسِ في الأرواح تعتملُ",72,"ل",1,0],["ما أضيق العيش لو حطت رواحلها","أطياف شوقٍ سَموم السهد تصلينا",73,"ن",2,0],["ما أضعف الإنسان يحسب نفسه","بغروره بطلاً وتهزمه القنا",74,"ن",2,0],["ما أضر الشعب كاليأس فإن","يئس الشعب يكون اليأس قبره",75,"ر",2,0]]}