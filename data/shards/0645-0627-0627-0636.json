{"poems":[[53,"من رأى البرق بغوري السند","https://www.aldiwan.net/poem30636.html","الرمل"],[55,"مرت بنا تشرق الدنيا ببهجتها","https://www.aldiwan.net/poem26419.html","البسيط"],[54,"ما أضيع الغمد بغير نصله","https://www.aldiwan.net/poem27345.html","الرجز"],[85,"كل يوم مهرجان كللوا","https://www.aldiwan.net/poem62933.html","الرمل"],[45,"من سائل لمعذر عن خطبه","https://www.aldiwan.net/poem10888.html","الكامل"],[45,"إن سير الخليط حين استقلا","https://www.aldiwan.net/poem65546.html","الخفيف"],[66,"أترى البارق الذي لاح ليلا","https://www.aldiwan.net/poem40649.html","الخفيف"],[97,"ما أضيع الصبر في جرح أداريه","https://www.aldiwan.net/poem24863.html","البسيط"],[44,"عنت فأعرض عن تعريضها أربي","https://www.aldiwan.net/poem29680.html","البسيط"],[44,"وعاذل عذلته في عذله","https://www.aldiwan.net/poem29687.html","الرجز"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[105,"قل للحسين ولات حين ملام","https://www.aldiwan.net/poem43043.html","الكامل"],[105,"يا دولة من بقايا الظلم طاف بها","https://www.aldiwan.net/poem43379.html","البسيط"],[106,"تكلمي يا كتائب","https://www.poetsgate.com/ViewPoem.aspx?id=179636",""],[106,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[45,"إنّ سَيْرَ الخَليطِ، حينَ اسْتَقَلاّ","https://www.poetsgate.com/ViewPoem.aspx?id=32060",""],[100,"ساعة نقاش مع طالبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67693&r=&rc=180",""],[121,"قمر يحلم في لج السما","https://www.aldiwan.net/poem49267.html","الرمل"],[121,"آنستني بالأملا المغري","https://www.aldiwan.net/poem49283.html","السريع"],[121,"ما أضعت الهوى ولا خنتك الغيب","https://www.aldiwan.net/poem49339.html","الخفيف"],[161,"أرخا أثيث الدجى الجاني على الفلق","https://www.aldiwan.net/poem59000.html","البسيط"],[211,"يا عين جودي لفقد الألف بالسهر","https://www.aldiwan.net/poem13571.html","البسيط"],[236,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[319,"رباعيات الخيام","https://www.aldiwan.net/poem63242.html","عموديه"],[378,"اليوم يخفق كل نجم مرجف","https://www.aldiwan.net/poem59331.html","الكامل"],[381,"البدر يغار إذا سفرا","https://www.aldiwan.net/poem48784.html","المتدارك"],[454,"شاعر الحب والجمال دعوني","https://www.aldiwan.net/poem61250.html","الخفيف"],[464,"الرب باق والخلائق فانيه","https://www.aldiwan.net/poem925.html",""]],"verses":[["ما أَضَلَّ الرَمحُ فيها مِنهُمُ","عَثَرَ السَيفُ بِهِ فيما وَجَد",0,"د",1,0],["ما أَضمَرَ القَلبُ شَيئاً تَغضَبينَ لَهُ","إِلا رَفَعتُ إِلَيكِ الطَرفَ مُعتَمِدا",1,"د",2,0],["ما أَضيعَ الغِمدَ بِغَيرِ نَصلِهِ","وَالعُرفَ ما لَم يَكُ عِندَ أَهلِهِ",2,"ه",1,1],["ما أَضَلَّ الناسَ حَتّى المَوتُ لَم","يَخلُ مِن زورٍ لَهُم أَو مِن رِياء",3,"ا",2,0],["ما أَضعَفَ الإِنسانَ إِلّا هِمَّةً","في نُبلِهِ أَو قُوَّةً في لُبِّهِ",4,"ب",2,0],["ما أُضيعَ الهَوى وَلا نُسِيَ الخِل","لُ الَّذي ضَيَّعَ الهَوى وَتَخَلّى",5,"ل",2,0],["ما أَضا البارِقُ العِراقيُّ إِلّا","أَرسَلَت مُقلَتي مِنَ الدَمعِ سَيلا",6,"ل",2,0],["ما أضيع الصبر في جُرح أداريه","أريد أنسَى الذي لا شيء يُنسيه",7,"ه",1,1],["ما أَضيَعَ العَقلَ إِن لَم يَرعَ ضَيعَتَهُ","وَفرٌ وَأَيُّ رَحىً دارَت بِلا قُطُبِ",8,"ب",1,0],["ما أَضيَعَ الغِمدَ بِغَيرِ نَصلِهِ","وَالشِعرَ ما لَم يَكُ عِندَ أَهلِهِ",9,"ل",2,0],["ما أضيعَ الماسَ مصنوعاً ومتطَبِعاً","حتى لدى أهلِ تمييزٍ وتثمين",10,"ن",1,0],["ما أَضْيعَ الحرمَيْن في يد عُصبةٍ","ملكت سبيلَ الحجّ والإحرامِ",11,"م",1,0],["ما أَضيعَ التاجَ يَرمي الشَعبَ صاحِبُهُ","بِالمُحفظاتِ وَيُؤذيهِ بِما كَسَبا",12,"ب",2,0],["ما أضعَفَ «المكروبَ» في تكوينه","لكنَّه يفري أديمَ الضَّيغَم!",13,"م",1,0],["ما أضعف الإنسان مق","درةً، وأكثرَ ما ادعاه!",14,"ا",2,0],["ما أُضِيعَ الهَوَى وَلا نُسِيَ الخِلُّ","الذي ضَيّعَ الهَوَى، وَتَخَلّى",15,"ل",2,0],["ما أضيعنا يا شاعرتي","في عصر الوزن بلا ميزان",16,"ن",1,0],["((ما أضعفنا شيء إلا","ما فينا من طين الإذعان))",16,"ن",1,0],["ما أضل القلب بالليل وما","أضرب الوجد عليه بالسدد",17,"د",1,0],["ما أضأل الأمال زاداص وما","أخونها في موقف النصر",18,"ر",1,0],["ما أضعت الهوى ولا خنتك الغي","ب وحاشا لمثلنا أن يخونا",19,"ن",2,1],["ما أضمروا لك مكروها ولا اجتعموا","لنقض عهد ولكن الشقي شقي",20,"ق",2,0],["ما اضحكت بالهنا يوما اخا طرب","الا وابكته في ايامه الاخر",21,"ر",1,0],["ما أَضمَرَت وَجداً وَلا اِشتَمَلَت لَها","يَومَ الوَداعِ عَلى غَرامٍ أَضلُعُ",22,"ع",1,0],["ما أضيَعَ اليومَ الذي مَرَّ بي","من غيرِ أن أهوى وأن أعشقَ",23,"ق",1,0],["ما أضيع استيفاءَ وصفي قدرَه","يفنى الزمانُ وفيه ما لم يوصف",24,"ف",1,0],["ما أَضمَرَ شَيئاً لا يَرضي","ك إِذا ما ذاعَ وَلا عذرا",25,"ر",2,0],["ما اضطهادي بنائل من جناني","لو رأيت الضياء يعو لغبن",26,"ن",1,0],["ما اضحكتني بعض يوم غلطة","الا وابكتني بقية عاميه",27,"ي",2,0]]}