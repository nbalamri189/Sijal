{"poems":[[65,"صبابة نفس ليس يشفى غليلها","https://www.aldiwan.net/poem46134.html","الطويل"],[74,"عذيري من ساجي اللواحظ أغيد","https://www.aldiwan.net/poem18545.html","الطويل"],[63,"قد وفت المزن بميعادها","https://www.aldiwan.net/poem51702.html","السريع"],[119,"حجت لمنعرج الحي المصاليت","https://www.aldiwan.net/poem41204.html","عموديه"],[164,"شمل بفضل رسول الله ينتظم","https://www.aldiwan.net/poem59218.html","البسيط"],[242,"يا هذه الزيتونه","https://www.aldiwan.net/poem19284.html","الرجز"],[276,"أنسمة طيب أم صبا طيبة هبا","https://www.aldiwan.net/poem52104.html","الطويل"],[302,"سل البان عنهم أين بانوا ويمموا","https://www.aldiwan.net/poem33179.html","الطويل"],[354,"بي للورى فليطل العجب","https://www.aldiwan.net/poem15535.html","السريع"],[376,"وأخ مسه نزولي عليه","https://www.aldiwan.net/poem57511.html","الخفيف"],[422,"قدمت فحياك المهيمن بندرا","https://www.aldiwan.net/poem53902.html","الطويل"],[463,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[466,"لتهن قصور المجد زيدت جلالة","https://www.aldiwan.net/poem16249.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120021","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59423","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59408","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59425","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56204","الطويل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78168","الطويل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113756","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28594","البسيط"],[2958,"","https://poetry.dctabudhabi.ae/diwan/poem/100569","الطويل"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67587","المتقارب"],[3479,"","https://poetry.dctabudhabi.ae/diwan/poem/101959","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85259","البسيط"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101373","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90810","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94541","الوافر"],[4303,"","https://poetry.dctabudhabi.ae/diwan/poem/110655","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120250","الوافر"],[4984,"فيا رمضان الجد","https://www.poetsgate.com/ViewPoem.aspx?id=175575",""],[5582,"أَلا هَلْ تَوَلَّتْ نَوارٌ نَوارا","https://www.poetsgate.com/ViewPoem.aspx?id=186999",""],[5845,"أنسمة ُ طيبٍ أمْ صبا طيبة ً هبا","https://www.poetsgate.com/ViewPoem.aspx?id=198483",""],[5873,"حصون العز","https://www.poetsgate.com/ViewPoem.aspx?id=215408",""],[5975,"أبعد النوى يا ميُّ!!","https://www.poetsgate.com/ViewPoem.aspx?id=58506",""],[6102,"مَرسُوم ..","https://www.poetsgate.com/ViewPoem.aspx?id=185051",""],[6120,"أَتُرِيدُنِي أَنْ أَعْتَرِفْ","https://www.poetsgate.com/ViewPoem.aspx?id=213513",""]],"verses":[["وأخمَصُهُ مِنْ تَحتِهِ هامَةُ السُّها","وهِمّتُهُ في المَجْدِ عالٍ تَليلُها",0,"ل",3,0],["وأخملت أرباب القريض كأنني","أدرتُ على أسماعهم كأس مرقدِ",1,"د",1,0],["وأخمدَتْ شُعْلَةَ إبراقِها","وسكَّنَتْ ضَجَّةَ إرعادِها",2,"د",3,0],["واخمد النار جهرا صوت نادبه","فناطق اللهب المكثار سكيت",3,"ت",1,0],["وأخمد الله نار بعد ما لبثت","في فارس ألف عام وهي تضطرم",4,"م",1,0],["وَأَخْمَدَتْ نِيرَانَهُ","وَصَدَّعَتْ مَاعُونَهْ",5,"ن",2,0],["وأخمدت النيرات في أَرض فارِس","وَكل يَهود الشام قد عدموا خبا",6,"ب",2,0],["وأَخمدَ نيرانَ المجوس قدومُه","وَكانَت على عُبّادِها تتضرَّمُ",7,"م",1,0],["وَأَخمُصي واطِئَةٌ ما عَلى","رُؤوسِهِم حَلِّ بِهِ القُطُبُ",8,"ب",1,0],["وأخٍ مسَّه نُزولي عليه","مثل ما مسني من الجوع قرحُ",9,"ح",1,1],["وأَخْمَدْتَ تلكَ النَّار بعدَ وقودها","وقَد أَوْشَكَتْ لولاك أَنْ تتسعَّرا",10,"ر",2,0],["وأَخٍ مع السّراء من عُدَدِي","وعليّ في الضَّراء والشرِّ",11,"ر",1,0],["وأخْمد نيران القِرى صرْصَريَّةٌ","تَهُزُّ رِعانَ الطَّوْدِ بالعُرَواءِ",12,"ا",2,0],["وأخمد الحرب وأطفى نارها","حتى إذا ما وضعت أوزارها",13,"ه",2,0],["واخ ما زال بالعط","ب ملجا في خصامي",14,"م",2,0],["وأخمد اللاة والعزى سناه كما","غشى يغوث ونسر الكفر فانخسفا",15,"ف",2,0],["وأخمد نارهم بعد اشتعال","وغور ماءهم بعد انجار",16,"ر",1,0],["وأخمند من نيران فارس جمرها","وقد غيض من ساوى أصول المنابع",17,"ع",1,0],["وأخمد اللاة والعزة سناه كما","رمى يغوث ونسر الكفر فانهدما",18,"م",2,0],["وأخمد شرّاً كان لولاه يصطلي","وهاب سطاه حين وافاه ينهرُ",19,"ر",1,0],["وَأَخمَد مِن شَر الأَعاجِمِ فِتنَة","وَقَوم مِن أَمر الوَرى ما تَأَوَدا",20,"د",2,0],["وأخمدَ نورُ أحمدٍ نارَ فارسٍ","وقد أوقَدَتها ألفَ عامٍ بلا قَطعِ",21,"ع",1,0],["وَأَخمَدَ البَرقَ حَتّى في بُيوتِهِمُ","ما يُظهِرُ الزَّندُ ما فيهِ مِنَ الضَّرَّمِ",22,"م",1,0],["وأخمد مصباح الهدى ولطالما","بأنواره قدماً تضيء المشاهد",23,"د",1,0],["وأخمدتُ بالسيفِ نارَ الحروبِ","وشَمَّرَّ فيها ابنُ زيدٍ عمرْ",24,"ر",1,0],["وأخمد نار الغي بعد لهيبها","بو كف يراع لا طعان ولا ضرب",25,"ب",1,0],["وأخمدت ليلة الميلاد طلعته","نار المجوس فنالوا غاية الأسف",26,"ف",1,0],["واخمد شرار الحقد إن كنت مصلحاً","فكم أحرقت شعباً شرارة قادح",27,"ح",1,0],["وأخمدتم لظى سفهائها إذ","بها اشتعل البلا أي اشتعال",28,"ل",1,0],["وأخمد نار ذاك الجور منها","وآب إلى الحياة بها الرمادُ",29,"د",1,0],["واخملت بالخزامى الغض ساحته","وفاوحت في الدجى مسكا ازاهره",30,"ر",2,0],["واخمد نار احزاني ووجدي","تسعر في الحشا ولها لهيب",31,"ب",1,0],["وأخمد براكين الحروب فإنها","أثيرت وغذَّاها التنازع والعنف",32,"ف",1,0],["وَأَخْمَدْتَ بِالعَدْلِ دِينَ المَجُوسِ","وَدِينَ اليَهُودِ وَدِينَ النَّصارَى",33,"ر",2,0],["وأخمدتِ النيرانُ في أرضِ فارسٍ","وكلُّ يهودِ الشامِ قدْ عدموا خبا",34,"ب",2,0],["وأخمدْ جمرة الأشواق دوماً","إذا أذكى الحبيب لك الفراقا",35,"ق",2,0],["وأخمدُ لوّاماً وأكبتُ حسّداً وأذهلُ أربابَ النهى متألّقاً","فردّي إليكِ الروحَ تسرحُ حرّةً لديكِ وفكّي القيدَ لطفاً محقَّقا",36,"ق",2,0],["وَ أَخمَصَينِ ؛ إِذا ما اثَّاقَلا رَهَقًا","زَجَرتُ كَعبَيهِما : ( إِيَّاكُما ؛ قُوما )",37,"م",2,0],["وَاِخْمِدْ أَجِيجَ صَبَابَتِي","مِنْ نَظَرَةٍ أَوْ لَمْسِ كَفْ",38,"ف",1,0]]}