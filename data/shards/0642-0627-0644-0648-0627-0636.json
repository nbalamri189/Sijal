{"poems":[[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59589","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49605","البسيط"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121365","الكامل"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107289","الكامل"]],"verses":[["قالوا ضعيف نظم هذا قلت لا","كم شُدَّ ضعْف مُهتَّم بمشيَّد",0,"د",1,0],["قالوا ضَلَلْتَ طَرِيقَ الرُّشْدِ قلتُ لهم","يهنيكمُ الرشدُ إنَّ الغيَّ يَهْنيني",1,"ن",2,0],["قالوا ضللتَ فقلتُ ويحكمُ","أيضلُّ سارٍ قادهُ البدر",2,"ر",1,0],["قالوا ضَعُفتَ عَنِ الإِمارَةِ فانعَزِل","دَعوى خَصِيمٍ ما لَدَيهِ مدَاعِ",3,"ع",1,0]]}