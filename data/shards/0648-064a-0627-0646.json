iwan/poem/118052","السريع"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127058","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127240","السريع"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143040","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73208","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73254","الهزج"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73267","السريع"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83401","الطويل"],[4396,"","https://poetry.dctabudhabi.ae/diwan/poem/111570","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133141","الرجز"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33324","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72835","المنسرح"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52136","المتقارب"],[4679,"هو البشرُ للفؤاد فيطربُ","https://www.poetsgate.com/ViewPoem.aspx?id=142759",""],[4755,"لَقَد عادُوا .. لِماذا لا نَعُودُ ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=187865",""],[4761,"هي الشمس أم نار على علم تبدو","https://www.poetsgate.com/ViewPoem.aspx?id=127120",""],[5072,"كفى هوساً","https://www.poetsgate.com/ViewPoem.aspx?id=52569",""],[5131,"أخذت المبادئ عن عصبةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=42206",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5183,"على بيتي المأمون","https://www.poetsgate.com/ViewPoem.aspx?id=180283",""],[5183,"رد التهنئة","https://www.poetsgate.com/ViewPoem.aspx?id=180229",""],[5183,"لشيخنا ابن عُبيد","https://www.poetsgate.com/ViewPoem.aspx?id=180219",""],[5183,"إلى الحسنى","https://www.poetsgate.com/ViewPoem.aspx?id=180186",""],[5213,"لهوّن بعد اليوم ما يفعل الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=170487",""],[5277,"البحثُ عن الذات","https://www.poetsgate.com/ViewPoem.aspx?id=206877",""],[308,"سلوا الدموع فإن الصب مشغول","https://www.poetsgate.com/ViewPoem.aspx?id=118851",""],[5431,"عجِبتُ","https://www.poetsgate.com/ViewPoem.aspx?id=182970",""],[5431,"بوابة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=190084",""],[470,"حشودٌ من الحب والكبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=194105",""],[5582,"فَما كُنْتُ أَدْرِي أَنْ يَكُونَ سَعِيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=186978",""],[5686,"دروب الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=203361",""],[5756,"المملكة عندنا غير","https://www.poetsgate.com/ViewPoem.aspx?id=5189",""],[5790,"سلوا أجفانه الكحلا","https://www.poetsgate.com/ViewPoem.aspx?id=112107",""],[5953,"بإسماعيل تهتم يا رعاء","https://www.poetsgate.com/ViewPoem.aspx?id=93799",""],[5953,"لاح ضياء القمر الزاهر","https://www.poetsgate.com/ViewPoem.aspx?id=93849",""],[5956,"حكيماً كان سيدنا","https://www.poetsgate.com/ViewPoem.aspx?id=192635",""],[6106,"هم الطهارة ( سادتنا أهل البيت )","https://www.poetsgate.com/ViewPoem.aspx?id=6304",""],[6115,"رحمك الله يابو حاتم","https://www.poetsgate.com/ViewPoem.aspx?id=180484",""],[242,"أهاجك بينهم اذ نأوا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563791",""],[6174,"الشِّعر في عُرس النجومِ الخُضر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86185&r=&rc=2",""],[6175,"عبيدكَ ليسوا حَجَرْ!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72850&r=&rc=75",""],[6225,"تقويم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80905&r=&rc=174",""],[6247,"أراودُ نفسي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80267&r=&rc=6",""],[6310,"جمر الشتات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72001&r=&rc=5",""]],"verses":[["وَيا نَصلاً تَطَلَّعُ مِن","غِرارَيهِ مَحاذِرُه",0,"ر",2,0],["وَيَأنَفُ عَزمي أَن يُرَدَّ رِماحَها","إِذا اِشتَبَهَت خُرصانُها وَزِجاجُها",1,"ج",3,0],["وَيا نَفسُ كَم جَشَّمتُكِ الصَبرَ وَالرِضا","وَجَشَّمتِني أَن أَلبَسَ المَجدَ مُعلَما",2,"م",2,0],["وَيا نوحاً جَنَيتَ عَلى البَرايا","وَلَم تَمنَحهُمُ الوُدَّ الصَحيحا",3,"ح",2,0],["وَيا نَسيمَ الصَبا بَلِّغ تَحِيَّتَنا","مَن لَو عَلى البُعدِ حَيّا كانَ يُحَيّينا",4,"ن",2,0],["وَيا نَعيماً خَطَرنا مِن غَضارَتِهِ","في وَشيِ نُعمى سَحَبنا ذَيلَهُ حينا",4,"ن",2,0],["وَيَأنَفُ مِن لينِ المِهادِ تَعَوُّضاً","بِصَهوَةِ طَيّارٍ إِلى الرَوعِ أَجرَدا",5,"د",2,0],["ويا نبيلاً أولاه نصراً","وكان خيراً له معينا",6,"ن",2,0],["ويانعاً من جنى العناب تتبعه","قلب المودع تذكاراً وتأسافا",7,"ف",2,0],["ويا نداماي لا عدمتكم","يا صفوة النفس من أصادقها",8,"ق",3,0],["وَيا ناقِلَ الأَنباءِ يَجهَلُ كُنهَها","كَرِهناكَ حَتّى قادِماً بِالبَشائِرِ",9,"ر",1,0],["وَيَأنَفُ الغَدرَ قَلبي وَهُوَ مُحتَرِقٌ","النارُ وَاللَهِ في هَذا وَلا العارُ",10,"ر",1,0],["ويا نهار كنت بسا","ما فمن ذا بدلك",11,"ك",1,0],["ويا نفس ارحلي عنا ففينا","بقاؤك لم يكن إلا ضلالا",12,"ل",2,0],["وَيا نَشَأَ النيلِ الكَريمِ عَزاءَكُم","وَلا تَذكروا الأَقدارَ إِلّا بِإِجمالِ",13,"ل",1,0],["ويا نظرةً شنَّتْ على القلبِ غارةً","وغادرتِ الصبرَ الجميلَ له سبيا",14,"ي",2,0],["ويا نسيمَ الصَّبا في الطِيب منغمِسَاً","أنفاسُه ونسيمُ المِسْكِ والبانِ",15,"ن",1,0],["ويا نسيماً عليلاً زارني سَحَراً","هيَّجتَ ما بيَ لا اهتاجتْ بك العِلَلُ",16,"ل",1,0],["ويا نُغْبةً بالأجرع الفردِ عَذْبَةً","أراكِ ولكنْ ما إليكِ سبيلُ",17,"ل",1,0],["ويا نَسَماتِ الريحِ رفْقاً بمهجتي","ففي القلب نارٌ كُلَّما هجتِ تُنْفَخُ",18,"خ",1,0],["ويا نارَ قلبي ما لجمرِكَ كُلَّما","نضحتُ عليه الماءَ لا يتبوَّخُ",18,"خ",1,0],["وَيا ناعِيَ المَعروفِ أَسمَعتَ طالِباً","فَأَكدى وَمَطلوباً فَأُسلِمَ جارِمُه",19,"م",2,0],["ويا ناصرَ الأدبِ المُستضامِ","إذا قعدَ النَّاسُ عن نَصْرِه",20,"ر",2,0],["وَيا نَشَرَ الصِبا بَلَّغ سَلامي","إِلى الفَيحاءِ بَينَ القَلعَتَينِ",21,"ن",1,0],["وَيا نَسيمَ الصَبا بَلِّغ تَحِيَّتَنا","مَن لَو عَلى البُعدِ مُتنا كانَ يُحيينا",22,"ن",2,0],["وَيا ناعِيَيهِ اليَومَ غُضّا عَلى قَذىً","فَقَد زِدتُما قَلبي عَلى وَجدِهِ وَجدا",23,"د",2,0],["ويا نظامَ نثارِ الدرِّ حُقَّ لهُ","لقدْ فدى كلَّ بيتٍ منكَ ديوانُ",24,"ن",1,0],["ويا نسائمَ إصباحٍ تصفِّقُ لي","ندى الغصون بليلاتٍ وتَسقيني",25,"ن",2,0],["وَيا ناعِيَي لَيلى بِجانِبِ هَضبَةٍ","فَمَن بَعدِ لَيلى لا أُمِرَّت قُواكُما",26,"م",2,0],["وَيا ناعِيَي لَيلى لَقَد هِجتُما لَنا","تَباريحَ نَوحٍ في الدِيارِ كِلاكُما",26,"م",2,0],["وَيا نيلُ أَنتَ الصَديقُ الوَفِيُّ","وَأَنتَ الأَخُ الأَصدَقُ الأَطيَبُ",27,"ب",1,0],["وَيا نَفسي الوَفِيَّةُ لا تَكوني","مِراحَ خِيانَةٍ وَمَسيلَ غَدرِ",28,"ر",1,0],["وَيا نَفسِ إِنَّ العُذرَ لا شَكَّ ساعَةٌ","تَعيشينَها بَعدَ الحَبيبِ فَموتي",29,"ي",1,0],["وَيا نَفحَةَ نِسرينٍ","وَيا وَردَةَ أَشجارِ",30,"ر",1,0],["وَيانِعُ النَخلِ مِن دُموعي","يَعُمُّها سائِحٌ مَعينُ",31,"ن",1,0],["وَيا نَفسي الَّتي تَسكُ","بُ كُنُ بَينَ الجَنبِ وَالجَنبِ",32,"ب",1,0],["وَيا ناظِراً في فُصولِ الخِضابِ","شَغَلَكَ عَن لِمَمٍ أَو عُقَص",33,"ص",1,0],["وَيا نَسيمُ تحرك","من أَجل لَيلى وأجلي",34,"ل",2,0],["وَيا نَواتِئَ مِنْ مَوجٍ وَمنْ زَبَدٍ","أَثْنى عَلَيْكَ وَحَسْبُ الفَخْرِ نَهْداها",35,"ا",3,0],["ويا نفسي التي تس","كُنُ بَيْنَ الْجَنْبِ والْجَنْبِ",36,"ب",1,0],["ويا نواتىء من موج ومن زبد","أثنى عليك وحسب الفخر نهداها",37,"ا",3,0],["ويا نابغاً حينَ جَفَّ النُّبوغ","وضلت عن الفكر أهلُ الفكر",38,"ر",1,0],["ويا نفسي عبدتك عن يقين","وحسبي قد عبدت بك الإلها",39,"ا",1,0],["ويا ناعيي ليلى لقد هجمتا لنا","تباريح نوح في الديار كلاكما",40,"م",2,0],["ويا نائب المختار في كل مشهد","ويا بدل المقتول في كربلا ظلما",41,"م",2,0],["ويا نجل كرار الرجال الذي جلا","لنا بضيا إشراق حكمته عتما",41,"م",2,0],["ويا نور عيشي فيم صدك والقلى","وفيم ارتداد الطرف وهو طبيب",42,"ب",1,0],["ويا نفس ذوبى حسرةً وكآبةً","على فقدِ معدومِ المماثلِ عالمِ",43,"م",1,0],["ويا نسلَ الأولى سَادُوا وجادُوا","وصارُوا في الحروبِ أشدَّ وَفْعَا",44,"ع",2,0],["ويا نديميَ حدثني بصبوتهِ","فإن فيه شفائي من أسَى عللي",45,"ل",2,0],["وَيَأنَفُ أَن يَستَصحِبَ السَيفُ كَفَّهُ","إِذا لَم يَقُدَّ السابِرِيَّ المُضَعَّفا",46,"ف",2,0],["ويأنف من تدبير رأي وحيلة","لغير المواضي البيض والأسل السمر",47,"ر",1,0],["وَيا نَسمَاتَ المُنحَنى كَيفَ أَهلهُ","وَهَل طابَ بَعدي ذَلِكَ الحَيُّ مَرتَعا",48,"ع",2,0],["وَيا نَفسِ ما لِلدَّهرِ فَوقَكِ مِن يَد","إِزاءَ أَيادٍ لَم تَكُن تُرهِبُ الدَّهرا",49,"ر",2,0],["ويا نفحاتُ الصباحِ احملي","بجيبِ الصبا نفحاتِ السلامْ",50,"م",1,0],["ويا نسيم صبا بجد لقد عرفت","روحي بمسراك وهناً عرف مهديكي",51,"ك",2,0],["وَيا نَجماً يُضيءُ لِكُلِّ سارٍ","وَصَوبَ حَياً يَجودُ لِكُلِّ طالِب",52,"ب",1,0],["وَيَا نَفَسَ الأَسْحَارِ هُبَّ عَلَيْهِمُ","وَطَارِحْهُمْ شَوْقِي الذِي أَنَا حَامِلُ",53,"ل",1,0],["وَيَا نَفْحَةَ الْخِيرِيِّ عُوجِي بِدُورِهِمْ","وَنُثِّي لَهُمْ أَنِّي بَرَتْنِي الْبَلاَبِلُ",53,"ل",1,0],["وَيَا نَفْحَةَ الرَّوْضِ طِيبِي بِهِمْ","فَإِنّهُمُ قَدْ زَكَوْا وَذَكَوْا",54,"و",2,0],["ويا نسمات الروح روحي وروّحي","لريحانة الروح الّذي اللطف جامع",55,"ع",1,0],["ويأنف ذكرى من يسيء بغيبة","إذا ساء والحر الكريم انوف",56,"ف",1,0],["ويا نهوداً أطلّت","كما أطَلّ السجين",57,"ن",1,0],["وَيا نَبْعَ أَمْواهِ الحَديدِ خِلالَها","بِما ضَاقَ عَنْهُ كُلَّ مُنْفَسِحٍ فَهْقَا",58,"ق",2,0],["وَيا ناسجاً ثوباً ليُلبس غيرَه","وَثوبُك لو أَبصرتَ بالٍ ممزق",59,"ق",1,0],["ويا ناظري إن كنت تنكرُ حسنهم","وإحسانهم ما أنت عندي بإنساني",60,"ي",1,0],["ويا نظرات اللَه يا لحظاته","ويا نسمات القرب أمي بهبة",61,"ه",1,0],["وَيانِعُ أَترُجٍّ كأَنَّ نَسِيمَهُ","ثَناؤكَ إذْ لا يُسْتطاعُ لِكاتِمِ",62,"م",1,0],["وَيا نَسيم التَهاني هَل مَرَرت عَلى","رَوض المَعالي وَهَل حَيّاك مزهرهُ",63,"ر",2,0],["وَيا نَسمات القُرب مِن أَيمن اللوى","أَلا فاِحملي عَنّي لمتنِ الهَوى شَرحا",64,"ح",2,0],["وَيانِع ورد الوُجنَتَين يَكادُ من","عَظيم الحيا يُجنيه وَهمي وَيَقطِف",65,"ف",1,0],["ويا نَفسُ صَبراً إن خطَتْ قَدمُ الرَّدى","إلينا على حال فكم قد تَخَطّتْنا",66,"ن",2,0],["وَيا ناصِحي ما خُنتَني في نَصيحَةٍ","وَلَكِن أَمينُ الحُبِّ يَتَّهِمُ النُصحا",67,"ح",2,0],["ويا نار الجحيم قِدِي وزيدي","على حزب اليهود ولن تَزالي",68,"ل",2,0],["ويا نَقولا الذي في اللَه نُزهتُهُ","وفي محبته شبت جوانحه",69,"ح",2,0],["وَيا نوى شَطت بِناهل أَوحش ال","أَحباب فَقدي أَم تَناسوا عَهدي",70,"د",2,0],["ويا نسمة الروض التي عبرت ضحى","فرقَّصتِ الأغصان فهي تأوَّد",71,"د",1,0],["ويا ناقِضاً عَهداً حسِبتُ بأَنَّهُ","مُمِرُّ على مَرِّ الدَّوائرِ والحِقَبْ",72,"ب",1,0],["ويأنف أنْ يُلقي القياد لنكبة","يرى فرج الله القريب وراها",73,"ا",3,0],["ويا نسيماً سرى من أرض 