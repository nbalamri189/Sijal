أنا ابنُ بجدتهم علماً وتجربة","https://www.poetsgate.com/ViewPoem.aspx?id=19772",""],[22,"لَعَمْرِي لقد أَمْسَى على الأَمْرِ سَائِسٌ","https://www.poetsgate.com/ViewPoem.aspx?id=18934",""],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[34,"جَزَى الرَّحْمن أفْضَلَ ما يُجَازِي","https://www.poetsgate.com/ViewPoem.aspx?id=22473",""],[91,"المرأة والمرآة","https://www.poetsgate.com/ViewPoem.aspx?id=53188",""],[28,"حرف الياء لعمري لقد نبهت يا هند ميتا","https://www.poetsgate.com/ViewPoem.aspx?id=17969",""],[20,"أرِقت لمكفهِر بات فيه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69759&r=&rc=0",""],[88,"تيقَّظ فما انت بالخالدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19512&r=&rc=15",""],[85,"ما باتَ يُثني على علياكَ إنسانُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9735&r=&rc=225",""],[18,"جَارَتْ بَنُو بَكْرٍ وَلَمْ يَعْدِلُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26453&r=&rc=19",""]],"verses":[["سَعى وَالشَمسُ تَرقى في أَناةٍ","فَجازَ وَسَيرُها في الجَوِّ وانِ",0,"ن",1,0],["سَعى بي إليه لا هَدى اللهُ سَعيَهُ","ولو نالَ عندي ما ابْتغاهُ لَما سَعى",1,"ع",2,0],["سَعى بي إِلَيكِ الحُبُّ عَزماً عَلى دَمي","فَلِلَّهِ دَرُّ الحُبِّ أَينَ سَعى بي",2,"ي",1,0],["سَعى الدَهرُ وَالواشونَ بَيني وَبَينَها","فَقُطِّعَ هَبلُ الوَصلِ وَهوَ وَثيقُ",3,"ق",1,0],["سَعى في جَمعِ شَملي بَعدَ صَدعٍ","وَرَأيٍ هِدتُ فيهِ عَنِ الطَريقِ",4,"ق",1,0],["سُعُودُكَ بَعْدَ مَوْتِكَ فِي حَيَاةٍ","وَإِنْ جُرِّعْتَ أَكْوْاسَ الْحِمَامِ",5,"م",1,0],["سَعِيدٌ فَابْتَهِجْ لَفْظاً وَمَعْنَى","يُطَاوِعُهُ الزَّمَانُ بِلاَ زِمَامِ",5,"م",1,0],["سَعْدٌ وَمَا أَدْرَاكَ سَعْدُ عُبَادَةٍ","فِي مَجْدِهِ صَدَقَ الَّذِي يَتَوَغَّلُ",6,"ل",1,0],["سَعيدٌ على الإسْلامِ أنتَ وأهْلِهِ","فلازِلْتَ في سعْدٍ يَدومُ وفي نصْرِ",7,"ر",1,0],["سَعى نحْوَ وَردِ الثّغْرِ وانْسابَ نحْوَهُ","فتَحْسِبُهُ نمْلاً تدِبُّ الى شُهْدِ",8,"د",1,0],["سُعُودُكَ لاَ مَا تَدَّعِيِهِ الْكَوَاكِبُ","وَجُودُكَ فِينَا لاَ السَّحَابُ السَّوَاكِبُ",9,"ب",1,1],["سَعَيتُ وَكَم سَعى قَبلي أَديبٌ","فَآبَ بِخَيبَةٍ بَعدَ اِغتِرابِ",10,"ب",1,0],["سَعَيتُ إِلى أَن كِدتُ أَنتَعِلُ الدَما","وَعُدتُ وَما أُعقِبتُ إِلّا التَنَدُّما",11,"م",2,1],["سَعَوا إِلى الكَسبِ مَحموداً وَما فَتِئَت","أُمُّ اللُغاتِ بِذاكَ السَعيِ تَكتَسِبُ",12,"ب",1,0],["سَعَت عَقرَبا صُدغيهِ في صَحنِ خَدِّهِ","فَهُنَّ لِقَلبي سالِباتٌ لَواسِبُ",13,"ب",1,0],["سَعَيتِ لِتَكديرِ عَهدٍ صَفا","وَحاوَلتِ نَقصَ وِدادٍ كَمَل",14,"ل",1,0],["سَعيُهُ في كُلِّ بِرٍّ مَثَلٌ","إِذ مَساعي مَن يُناويهِ مُثُل",15,"ل",1,0],["سَعِدتَ كَما سَعِدَ المُشتَري","وَنِلتَ عُلاً لَم يَنَلها زُحَل",16,"ل",1,0],["سَعِيتِ سَعياً مثمراً مبارَكاً","وَعدتِ عوْداً راضِياً مرْضِيَّا",17,"ي",2,0],["سَعْدٌ وَعَدْلِيٌّ وَثَرْوَتُ وَالأُولَى","دَرَجُوا مِنَ الزَّعَمَاءِ وَالأَقْرَانِ",18,"ن",1,0],["سعْدَ السُّعُودِ اطْلُعْ بِمِصْرَ وَلا يَبِنْ","عَنْ مِصْرَ بَعْدَ ضِيَاؤُكَ البَسَّامُ",19,"م",1,0],["سَعْيُهُ هَوَّنَ العَسِيرَ عَلَيْنا","فَوَدِدْنَا لَوْ نَلْثَمُ الأَقْدَامَا",20,"م",2,0],["سَعى فَاِرتَضَحنَ المرَوَ حَتّى كَأَنَّهُ","خَذاريفُ مِن قَيضِ النَعامِ التَرائِكِ",21,"ك",1,0],["سعد امرؤ بذل الفواضل للورى","عفواً نفسه أن يحسنا",22,"ن",2,0],["سعدَيك من وطن جلّت مفاخره","عن الزوال فلا تَخشى بلىً وفنا",23,"ن",2,0],["سَعَروها في البحر حرباً ضروساً","تأكل المالَ نارُها والنفوسا",24,"س",2,1],["سعى للمعارف فأختازها","وصاد الأنيس مع الآبد",25,"د",1,0],["سعَوْا لحماية الأطفال منّا","بما أُوتُوه من كرم الطباع",26,"ع",1,0],["سعديك يا توماس إنك لم تمُت","ما دام ذكرك في الحياة عريقا",27,"ق",2,0],["سعيت إلى استقلال قومك مخلطصاً","وما كنت في يوم على القوم ممتنّا",28,"ن",2,0],["سعى لانقاذه بالرأي مجتهداً","بالعزم متشّحاً بالحزم مؤتزرا",29,"ر",2,0],["سعد وسعدون محمود مقامها","هذا بمصر وهذا ها هنا اشتهرا",29,"ر",2,0],["سعى الناس والأقدار مخبوءة لهم","وناموا وما ليلُ الخطوب بنائم",30,"م",1,0],["سعة تحسب المجرة فيها","حَلْقةً ألقيت بصحراء قفره",31,"ر",2,0],["سَعدٌ أَبَوا لَكَ أَن تَفي بِجِوارِهِم","أَو أَن يَفي لَكَ بِالجِوارِ جِوارُ",32,"ر",1,0],["سَعدُ بنُ زَيدِ مَناةَ عِزٌّ فاضِلٌ","جَمَعَ السُعودَ وَكُلَّ خَيرٍ يَجمَعُ",33,"ع",1,0],["سَعدُ بنُ زَيدِ مَناةَ فَكَّ كُبولَهُم","وَالتَيمُ عِندَ يَحابِرٍ وَجُذامِ",34,"م",1,0],["سَعدٌ هُمُ المُتَيَمَّنونَ بِأَمرِهِم","وَهُمُ الضِياءُ لِلَيلَةِ الإِظلامِ",34,"م",1,0],["سَعدٌ إِذا نَزَلَ العَدُوُّ حِماهُمُ","رَدّوا عَلَيهِ بِحَومَةِ القَمقامِ",34,"م",1,0],["سَعَرنا عَلَيكَ الحَربَ تَغلي قُدورُها","فَهَلّا غَداةَ الصِمَّتَينِ تُديمُها",35,"م",3,0],["سَعادَةُ المَرءِ في السَرّاءِ إِن رَجَحَت","وَالعَدلُ أَن يَتَساوى الهَمُّ وَالجَدَلُ",36,"ل",1,0],["سعياً لأبوابِ تاج الدِّين إنَّ لها","منهاج فضلٍ بريء الفضل من هاجي",37,"ي",1,0],["سعيد مساعٍ أو سعيد مناسبٍ","فقد سعدت في كلِّ حالٍ جدوده",38,"د",2,0],["سعدت بك الأرضُ التي وُلَّيتها","من بعد ما أمست بغيرك تكمد",39,"د",1,0],["سعادة جدّ بها يحتذى","ونهج أبٍ في العلى يشتهر",40,"ر",1,0],["سعادة لحظت أركان مستلمٍ","قد كادَ بعدك أن تدمي محاجره",41,"ر",2,0],["سعودك عندي زهر الربيع","وعند عدوك شقّ المراره",42,"ر",2,0],["سعى بالحميّا في نشاوى تهافتت","عليها بأيدٍ ما تكاد تطيعها",43,"ع",3,0],["سعيتُ في حبِّ هيفا","تحلو وتكوي طفليهْ",44,"ه",1,1],["سعيت لباب سلطان البرايا","ودمع الشوق ملءُ المقلتين",45,"ن",1,1],["سَعَر اللَّه في الجوانح منهم","سَعْرَةَ النار تكلُمُ البَغْضاءَ",46,"ا",2,0],["سعى لكُمُ مَسعاةَ سوء ذميمةً","سعى مثلَها مستكره الرِّجْلِ أعرجُ",47,"ج",1,0],["سَعِدتْ مقلتي بوَجْهِك لولا","أنها أُعْقِبَتْ بطول السهادِ",48,"د",1,1],["سَعِدْتَ سعادتين بغير شكٍّ","ولم يجمعهما إلا سعيدُ",49,"د",1,0],["سعدت بأجرٍ ذاك وأنْسِ هذا","كذاك اللّه يفعلُ ما يريدُ",49,"د",1,0],["سعيُ السُّعاةِ لفضل المال بعد غِنىً","حِرمٌ كما طلبُ الأقواتِ مُفترض",50,"ض",1,0],["سعيتَ لإيقاظ المقادير ضلة","وما كانت الأقدار لو نمت تهجع",51,"ع",1,0],["سعيتَ بمن أحياك من بعد ميتةٍ","وأدّى وفاءً ما وفاه السّموألُ",52,"ل",1,0],["سعيدان ميمونان تعرف فيهما","من اليُمن آياتٍ له ومعالما",53,"م",2,0],["سَعى بِأَوتارِ أَقوامٍ فَأَدرَكَها","لَولا أَياديهِ ما اِمتَنّوا وَلا اِنتَصَروا",54,"ر",3,0],["سَعَيتَ شَبابَ الدَهرِ لَم تَستَطِعهُمُ","أَفَالآنَ لَمّا أَصبَحَ الدَهرُ فانِيا",55,"ي",2,0],["سَعى لِيَ قَومي سَعيَ قَومٍ أَعِزَّةٍ","فَأَصبَحتُ أَسمو لِلعُلا