"","https://poetry.dctabudhabi.ae/diwan/poem/77956","الوافر"],[1653,"","https://poetry.dctabudhabi.ae/diwan/poem/32560","المجتث"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108564","الوافر"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87856","البسيط"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11139","الوافر"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21440","الوافر"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60968","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201814","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204651","المجتث"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99522","البسيط"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103515","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62821","البسيط"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26993","الوافر"],[3690,"","https://poetry.dctabudhabi.ae/diwan/poem/77724","الرجز"],[3955,"","https://poetry.dctabudhabi.ae/diwan/poem/198343","المجتث"],[4003,"","https://poetry.dctabudhabi.ae/diwan/poem/199237","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139709",""],[4699,"لدينا قلوب","https://www.poetsgate.com/ViewPoem.aspx?id=155949",""],[4830,"وقالوا صِفْ لنا","https://www.poetsgate.com/ViewPoem.aspx?id=203356",""],[4003,"وقائل ورأى من حجبتي عجباً","https://www.poetsgate.com/ViewPoem.aspx?id=181186",""],[5157,"قَالوا لي اركَنْ لأبواب السّلاطينِ","https://www.poetsgate.com/ViewPoem.aspx?id=180071",""],[5186,"غيد الهوى والجوى حاولن تجريبي","https://www.poetsgate.com/ViewPoem.aspx?id=156473",""],[5216,"وقالتْ لماذا تَغارُ عَلَيّ","https://www.poetsgate.com/ViewPoem.aspx?id=187642",""],[5216,"حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=187651",""],[6072,"القلبُ إذا تَلَكَّأ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84903&r=&rc=3",""]],"verses":[["فَقُلتُ حَسبُكَ لا تَخشَ اِجتِماعَكُما","فَالشَمسُ لا يَنبَغي أَن تُدرِكَ القَمَرا",0,"ر",2,0],["فَقُلتُ حُبّيكِ صِرفٌ لا مِزاجَ لَهُ","عِندي وَسائِرُ حُبِّ الناسِ مَمزوجُ",1,"ج",1,0],["فَقُلتُ حَيرانُ قَد ضَلَّ الطَريقُ بِهِ","فَأَرشِدوني فَلي في حَيِّكُم شُغُلُ",2,"ل",1,0],["فقلتُ حُكمي أن أنال المنى","من ذلك الردف وذاك البرود",3,"د",1,0],["فَقُلتُ حَمامَ الأَيكِ ما لَكَ باكِياً","أَفارَقتَ إِلفاً أَم جَفاكَ حَبيبُ",4,"ب",1,0],["فقلتُ حسبي الذي ألهبتكُنّ به","من لاعجٍ في حنايا الصدرِ مشبوب",5,"ب",1,0],["فقلت حبّك لي شغلٌ غنيت به","عمّا يقرّبني من حرفة الأدب",6,"ب",1,0],["فقلتُ حنانيكِ لا تَسخري","فجاري هناكَ هو الجوَّهري",7,"ي",1,0],["فقلت حاشاه بل أشار إلى ال","وصلِ بعينٍ تصبّ في عينِ",8,"ن",1,0],["فقلت حسبي ربي واكتفيت به","ولست أرضى بغير العلم والدين",9,"ن",1,0],["فقُلتُ حِمامي المالُ عِلمي بأنَّني","أخلِّفُ مالي أو فَمالي لمُخلِفِ",10,"ف",1,0],["فَقُلتُ حَلالٌ كَما قَد زَعم","تَ وَلكِن سَمحتَ بِصَدع العجوزِ",11,"ز",1,0],["فقلت حسبكما للّه دُرُّكُمَا","كل أتى بكلام كله حكم",12,"م",1,1],["فقلتُ حياةٌ للعُلى بعد موْتهِ","وناجمُ مجْدٍ بعد آخِرَ غاربِ",13,"ب",1,0],["فقلتُ حاشا أبا المَناقِبِ والعَلْياءِ","منْ وعْكَةٍ ومنْ وَصَبِ",14,"ب",1,0],["فَقُلتُ حَتّى تَراني","وَلي شَبابٌ مُحالُ",15,"ل",1,0],["فقلت حاشاك لكن","أجيد فيك رثائي",16,"ا",3,0],["فقلت حبيبي أي قصد نويته","فقد كنت من هذا وحقك أحذر",17,"ر",1,0],["فقلت حياء المرء ذي الدينِ والتّقى","يقلّ إذا قلّت لديهِ دراهمُه",18,"م",2,0],["فقلتُ حقٌّ يرعاه حرٌّ","يقظان في معشرٍ رقودِ",19,"د",1,0],["فَقلت حِمارُ الكتبِ مِثلي بِحملِها","وَرُبَّ سِلاحٍ عندَ مَنْ لا يُقاتِلُ",20,"ل",1,0],["فَقُلْتُ حَسْبِي فَقَالَ كَلاَّ","فَقُلْتُ زِدْنِي فَقَالَ إعْتَدْ",21,"د",1,0],["فقلت حَلٍ طالَ الوقوفُ وسامَحَت","قرينةُ مَن عاتبتُ والقلبُ آلِفُ",22,"ف",1,0],["فقلت: حبي، ماذا","تبغي بهذا الصنيع؟",23,"ع",1,0],["فَقُلت حفظ النَفس أَولا قُصِد","وَبَعد ذاكَ للفَخار أَجتهد",24,"د",1,0],["فقلتُ حبيبي شاهرٌ سيفَ طرفِهِ","ولا بدَّ للسيفِ الشهيرِ من النَّطْعِ",25,"ع",1,0],["فَقلت حَبيبي تقتلني","وَما أَلممت بالريب",26,"ب",1,0],["فَقُلتُ حُيّيتَ رِزقي","فَقالَ رِزقُكَ بِاِستي",27,"ت",2,0],["فقلت حلا الصبوح فمر عني","فلم أر بعد ما ولى صباحا",28,"ح",2,0],["فَقُلتُ حَسبُكِ هَذا الكُفرُ فَاِتَّئِدي","فَإِنَّما الخَمرُ إِثمٌ غَيرُ مُغتَفَرِ",29,"ر",1,0],["فَقُلتُ حَواصِناً يَندُبنَ بُحّاً","بِناحِيَةِ إِبنِ عَمِّكَ ذا الصَلاحِ",30,"ح",1,0],["فَقُلت حَمامَةٌ تَدعو حَماماً","وَكُلُّ الحبِّ نَزّاعٌ طَموحُ",31,"ح",1,0],["فقلتُ حبيبة رَجعتْ عدوّاً","فقال أعيذها من أن تُعادى",32,"د",2,0],["فقلت حسبيَ أني اليوم اسكن في","بيت بفكرك لا بيت بأحجار",33,"ر",1,0],["فقلت حكمت لكن","قد جرت بالتحكيم",34,"م",1,0],["فقلت حالي بحالٍ من رثائتها","وعلة الحال تنسي علة الجسدِ",35,"د",1,0],["فقلت حكاني في نحولٍ ودقةٍ","كذاك خطوط العاشقين تكون",36,"ن",1,0],["فقلتُ حلّوا الحِبى لأنامَ جدكم","وشَمِّروا إنّها أيامُ تَشْمِيرِ",37,"ر",1,0],["فَقُلتُ حَماقَةً مِنّي وَنوكاً","فَدَيتُكَ لَستُ مِن أَهلِ الشُمولِ",38,"ل",1,0],["فقلتُ حقاً قلتُمُ","لكنهُ سعدُ بلعْ",39,"ع",1,0],["فقلت حسبي التماحٌ","بحسن وجهٍ جميل",40,"ل",1,0],["فقلت: حلَّت نجوم العمر منذ بدا","نجم المشيب ودين الله مطلوب",41,"ب",1,0],["فقلت حينما انتهى نظامها","من درَّة الأسلاك أرِّخ فرغا",42,"غ",2,0],["فقلت حبيبتي .. هل تتركين","فؤاداً بنار الهوى يشتعل ؟!",43,"ل",1,0],["فقلتُ حَشاشةُ العُشاقِ أدرى","اِذا زادَ النّوى فيهُنَّ لَهْبا",44,"ب",2,0],["فقلت: حلت نجوم الدهر منذ بدا","نجم المشيب ودين الله مطلوب",45,"ب",1,0],["فقلتُ حسبيَ ربي واكتفيتُ به","ولستُ راضيَ غيرِ العلم والدينِ",46,"ن",1,0],["فقلت حور جنان قلن بل نجب","فخر الحمى زينة الشبان والشيب",47,"ب",1,0],["فقلتُ حياتي أحِبُّكِ لحناً","أغنيهِ وحدي على شَفَتيّ",48,"ي",1,0],["فقلتُ حبيبتي حلْمٌ","سماءٌ غيرُ أرضِيَّةْ",49,"ي",2,0],["فقلتُ : حاولتُ قولاً رُغْم أني هنا","ظلٌّ , أينفع ظِلٌّ ينتضي قَلَما !؟",50,"م",2,0]]}