https://www.aldiwan.net/poem56224.html","المتقارب"],[459,"يا باذل المال في عدم وفي سعة","https://www.aldiwan.net/poem15323.html","البسيط"],[459,"اذا افتخرت عليا ربيعة بالذي","https://www.aldiwan.net/poem15413.html","الطويل"],[459,"شربت دما ان حال ودي ساعة","https://www.aldiwan.net/poem15480.html","الطويل"],[459,"تقيل نوشروان بعد ذهابه","https://www.aldiwan.net/poem16034.html","الطويل"],[459,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[462,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[462,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[466,"أرض إله السماء عنك بما","https://www.aldiwan.net/poem59911.html","المنسرح"],[466,"لا تبع المعروف بالمنكر","https://www.aldiwan.net/poem59972.html","السريع"],[475,"على البان قمرية تسجع","https://www.aldiwan.net/poem15215.html","المتقارب"],[491,"وإن رأى المتناهى من سيادته","https://www.aldiwan.net/poem67397.html","البسيط"],[498,"أتانا من صبا نجد نسيم","https://www.aldiwan.net/poem37783.html","الوافر"],[512,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[527,"سلوا الناس من قد قام مثل مقامي","https://www.aldiwan.net/poem37141.html","الطويل"],[527,"وفود حبيب أم ورود عهاد","https://www.aldiwan.net/poem37457.html","الطويل"],[527,"مسامع من ناديت يا عمرو سدت","https://www.aldiwan.net/poem37501.html","الطويل"],[549,"دع الغنى لبنيه","https://www.aldiwan.net/poem47302.html","المجتث"],[549,"لنا من ثناياك الغريض المرشف","https://www.aldiwan.net/poem47403.html","الطويل"],[549,"أيا ملك الأملاك قد جاءني الذي","https://www.aldiwan.net/poem47842.html","الطويل"],[556,"نحن معاني الوجود فيه","https://www.aldiwan.net/poem33671.html","مخلع البسيط"],[556,"في الكلب عشر خصال كلها حمدت","https://www.aldiwan.net/poem33800.html","البسيط"],[556,"أنا المعروف لي بالله ألوان","https://www.aldiwan.net/poem33827.html","الهزج"],[556,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[571,"حدثني الشوق عن تباريحي","https://www.aldiwan.net/poem3653.html","المنسرح"],[573,"سواي يخاف الدهر أو يرهب الردى","https://www.aldiwan.net/poem2749.html","الطويل"],[573,"أيدفعني الدهر عن مطلبي","https://www.aldiwan.net/poem2750.html","المتقارب"],[573,"دع قضب نعمان أو كثبان يبرين","https://www.aldiwan.net/poem2851.html","البسيط"],[584,"خذوا خبرا عن نظم دمعي ونثره","https://www.aldiwan.net/poem17548.html","الطويل"],[585,"تعلم ففي العلم الشريف فوائد","https://www.aldiwan.net/poem11508.html","عموديه"]],"verses":[["وَإِنَّ رِباطَ بَني مالِكٍ","تُقادُ إِلى المَوتِ أَرسانُهُ",0,"ن",2,0],["وَإِنَّ رَجائي زَينَ مِلَّةِ هاشِمٍ","لَنُعمى وَحَسبي مِن جَوادٍ وَمُنعَمِ",1,"م",1,0],["وَإِن رامَ أَملاكَ البِلادِ بِفَتكَةٍ","مَشى الذُلُّ في تيجانِها وَالمَناطِقِ",2,"ق",1,0],["وَإِن رَكَضَ السُؤالُ إِلى نَداهُ","تَتَبَّعَ إِثرَ وَطأَتِهِ بِنُجحِ",3,"ح",1,0],["وَإِنَّ رُزأً رَماني","بِالبُعدِ عَنكِ لَصَعبُ",4,"ب",1,0],["وَإِن رامَ اِجتِناباً لَم يُطِقهُ","وَلا يَقوى المُحِبُّ عَلى اِجتِنابِ",5,"ب",1,0],["وَإِن رَأَوني بِخَيرٍ ساءَهُم فَرَحي","وَإِن رَأَوني بِشَرٍّ سَرَّهُم نَكَدي",6,"ي",1,0],["وإنْ راعَ دهْرٌ أو تنَكّرَ حادِثٌ","فلُذْ بحِمى منْ عامِرِ بْنِ محمَّدِ",7,"د",1,0],["وإنْ رُوِيَتْ عنْهُمْ عَوالي علائِهِمْ","فآثارُ عَلْياكَ الحِسانُ الصّحائِحُ",8,"ح",1,0],["وَإِن رَأَيتُم في يَدي زَهرَةً","فَإِنَّها مِن ذَلِكَ الغَرسِ",9,"س",1,0],["وَأَن رُكِزَت حَولَ الخُدورِ أَسِنَّةٌ","وَحَفَّت بِقُبِّ السابِحاتِ قِبابُ",10,"ب",1,0],["وَإِن رَمِدَت عَينايَ يَوماً كَحَلتُها","بِعَينَيكِ لَم أَبغِ الذَرورَ مِنَ الكُحلِ",11,"ل",1,0],["وَإِن رَزَحَ الْحَمَّالَ مِنْ وِقْرِ حِمْلِهِ","أَيُلْقِيهِ عَنْهُ أَمْ يُطَاوِعُ لُوَّمَا",12,"م",2,0],["وَأَن رَبَّ أَمثالِ البَلايا مِنَ السُرى","مُضِرٌ بِها الإِدلاجُ لَولا نِعالُها",13,"ل",3,0],["وَإِن رَفَعوا الذَميل لَقينَ مِنهُ","هَواناً حينَ يَرتَكِبُ الذَميلا",14,"ل",2,0],["وَإِن رَدَّهُنَّ الرَكبُ راجَعنَ هِزَّةً","دَريجَ المَحالِ اِستَثقَلَتهُ المَحاوِرُ",15,"ر",1,0],["وإن رُدَّ سيف الملك صوناً لغمدهِ","فقد سُلَّ من غمد الخلافة مُرْهَفُ",16,"ف",1,0],["وإن راعَ قلبَ الدين نعيُ إمامه","فقد هُزَّ منه بالبشارة مَعْطَفُ",16,"ف",1,0],["وإن رقيت نحو السماء فحبّذا","إذا أصبحت مأوىً لها الأنجم الزهر",17,"ر",1,0],["وَإن رَفَعُوا مَنَاسِبَهُم رَفَعنَا","إِلَى مُضَرَ الَّتي لاَ يَجهَلُونَا",18,"ن",2,0],["وَإِنَّ رِجالاً ما اِبنَكُم كَاِبنِ أُختِهِم","حَرِيّونَ أَن يُقضى لَهُم وَيُهابوا",19,"ب",3,0],["وإن رأيت قدّه العالي فصف","وقف على المنصوبِ منه بالألف",20,"ف",1,0],["وَإِن رُمتُ فَوقاً أَنتَ في الفَوقِ فَوقُهُ","وَإِن رُمتُ تَحتاً أَنتَ كُلُّ مَكانِ",21,"ن",1,0],["وإن رمت الحجامة فالثلاثا","فذاك اليوم مهراقُ الدماءِ",22,"ا",2,0],["وإن رام امرؤٌ يوماً دواءً","فنعم اليومُ يوم الأربعاءِ",22,"ا",2,0],["وإن رَجَوْا أخرى فمن قولهم","أفْلَحَ هذا الغائب الآيِبُ",23,"ب",1,0],["وإن رام من حَدِّ البطيحة مَطلعاً","ثَنَتْ شأوَهُ عنه المواصير والجِسر",24,"ر",1,0],["وإن رأى أو أحس آونةً","دخانَ نارٍ لجاره كَبَسَهْ",25,"س",2,0],["وإن رجائي فيك خيَّب نعمتي","فأضحتْ كإحدى الفاركاتِ النواشِص",26,"ص",1,0],["وإن راض للسلطان خشناءَ صعبةً","فناهيكَ روّاضا به ومروِّضا",27,"ض",2,0],["وأن ركايا الماء فيكم جَرورها","إذا كان في القوم الكرام نَزوعها",28,"ع",3,0],["وإن رضيتم رضينا عن مسالمكم","وإن غضبتم فنحن الشيعة الأنف",29,"ف",1,0],["وإن رفرفتْ يوماً عليك مُلمَّةٌ","فرفرف جبريل عليك وميكالُ",30,"ل",1,0],["وإن رمَى الدهرُ من يرمي صفاتَكمُ","ناديتُه لا رماك اللَّه بالشللِ",31,"ل",1,0],["وإن رمتَ من يُعنى به الحقّ والهوى","فإنك مخسوفٌ به أو مزلزلُ",32,"ل",1,0],["وإن رأى حيةً تهتزُّ في ركَبٍ","هوى لها بعصا موسى بن عمران",33,"ن",1,0],["وَإِن رَقَّ مِنّي مَنطِقٌ وَشَمائِلٌ","فَما هَمَّ مِنّي بِالقَبيحِ ضَميرُ",34,"ر",1,0],["وَإِن راقَ أَقواماً مِنَ الناس منطِقٌ","يرُقْ أَبَداً مني مَقالٌ وَأَفعالُ",35,"ل",1,0],["وَإِن رمتُ نَفسي كَيفَ آتي لِصَرمِها","وَرمتُ صدوداً ظَلَّتِ العَينُ تَدمَعُ",36,"ع",1,0],["وَإنّ رَحِيلاً وَاحِداً حَالَ بَيْنَنَا","وَفي المَوْتِ مِنْ بَعدِ الرّحيلِ رَحيلُ",37,"ل",1,0],["وَأنّ رِمَاحَ الخَطّ عَنْهُ قَصِيرَةٌ","وَأنّ حَديدَ الهِنْدِ عَنهُ كَليلُ",37,"ل",1,0],["وإن رُزقتَ فلا تأسف على أحد","بالفضل واحذر مصير البغي والبطرِ",38,"ر",1,0],["وإن رابتْ إساءتُه فَهبْهَا","لما فيه من الشِّيَمِ الحِسَانِ",39,"ن",1,0],["وإن رامَ بَرَّاً لم يدعْ سَرَعانُه","لساقتهِ في البَّرِ موقفَ راكبِ",40,"ب",1,0],["وَأَنَّ رِماحَنا تَأبى وَتَحمى","عَلى ما بَينَ عالِيَةٍ وَرومِ",41,"م",1,0],["وإن راحَ رُعيانُها أْطْرَبَتْكَ","فَواقِدُ أولادِها الثَّاغيه",42,"ي",2,0],["وإن رآه رقيقُ الوجهِ قال أَرِقْ","كأسَ الحياءِ بضَمٍّ أو ِبتَقْبيلِ",43,"ل",1,0],["وَأَنَّ رَحلي وَإِن أَوثَقتُهُ لَعَلى","مَطِيَّةٍ مِن مَطايا الحَينِ مَحمولُ",44,"ل",1,0],["وَأَنَّ رِجالَ النَفعِ تَحتَ مَداسِها","وَأَنَّ رِجالَ الضُرِّ فَوقَ سَنامِها",45,"ه",2,0],["وَإِن رَأى في بَيتِهِ فارَةً","بادَرَها بِالسَيفِ وَالتُرسِ",46,"س",1,0],["وَإِن رَكَزوا غِبَّ الطِعانِ رِماحَهُم","رَأَيتَ رُؤوسَ الأُسدِ فَوقَ الثَعالِبِ",47,"ب",1,0],["وإنَّ رَزايا العُمرِ مِنْهُنّ مركبي","ثقالٌ بأعطانِ المنايا مَبارِكُه",48,"ك",2,0],["وإن رُفعت فوق المفارق صَيّرَتْ","دبيبَ المنايا من مضاربها وثبا",49,"ب",2,0],["وَإِن رُمتُ أَمراً مُدبِرَ الوَجهِ إِنَّني","سَأَترُكُ حَظّاً في فِنائِكَ مُقبِلا",50,"ل",2,0],["وأنَّ رَوْحكِ رُحٌ تأنَسِينَ بها","إذا تململَ مَيْتٌ رُوْحُهُ نَكَد",51,"د",1,0],["وإن رميتَ بَنِي الدنيا بقُوَّتهِ","ردَّ العُبابَ دماً والأرضَ بُركانا",52,"ن",2,0],["وَإِن رابَت مَواقِفَها اللَيالي","فَمِن تاجيكَ يَنبَلِجُ اليَقينُ",53,"ن",1,0],["وإن راحَ يَسْتَسْقِي به الغيثَ مُسنِتٌ","تَقَشَّعَ عنه الجدبُ واطَّرَدَ الخِصْبُ",54,"ب",1,0],["وَإِن رَمى كانَ مَريضَ السَهمِ","ذا وَتَرٍ رِخوٍ ضَعيفِ الرَجمِ",55,"م",1,0],["وإنْ رَجَعُوا لأرْضِهِمْ بخَيْرٍ","فَلَمْ تَرَ كاتِباً إلاَّ حَزِينا",56,"ن",2,0],["وَإِن رَئيتُ الشُراةَ قَد طَلَعوا","أَلجَمتُ مُهري مِن جانِبِ الذَنَبِ",57,"ب",1,0],["وَإِن رَجَعتُ وَرائي","خَشيتُ زَأرَ أُسودِه",58,"د",2,0],["وَإِنَّ رِجالَ شَيبَةَ سادِنيها","إِذا راحَت لِكَعبَتِها الجِمارا",59,"ر",2,0],["وَإِن رُدِدتُ لِأَصلي","دُفِنتُ في شَرِّ تُربَه",60,"ب",2,0],["وَإِنَّ رِجالاً كانَ نَسرٌ لَدَيهِمُ","إِلهاً عَلَيهُم قَبلَنا طَلَعَ النَسرُ",61,"ر",1,0],["وَإِن رَأَيتَ هِزبَرَ الغابِ مُفتَرِساً","فَقَد يَكونُ زَماناً وَهُوَ فَرّاسُ",62,"س",1,0],["وَإِن رُزِقتَ النُهى فَأَنتَ عَلى ال","أَصحابِ حَليٌّ تَتَنازَعوهُ خُلَس",63,"س",1,0],["وَإِن رَأَيتَ الخَودَ مُختالَةً","يَصلُحُ أَن تُجعَلَ شَمّامَه",64,"م",2,0],["وَإِن رُقِّيَ الفَتى رُتَبَ المعالي","فَمِثلُ هُبوطِهِ ذاكَ الرُقِيُّ",65,"ق",2,0],["وإن رُمْتُمَا منطِقاً من فَمي","ولم تسْمَعَاهُ فصيحاً فَصِيحَا",66,"ح",2,0],["وأن رضا الأيام عنهم خديعة","وأن مصافاة الليالي لهم مكر",67,"ر",1,0],["وإن ركبوا الجرد العتاقد لغارةٍ","بدَوْا في وثاقٍ ركب نوقٍ وجامل",68,"ل",1,0],["وَأَنَّ رُمُوزاً فِي الرِّقَاعِ يَخطُّهَا","تُقِرُّ مَكَانَ الفَتْحِ حَيْثُ يُشيرُ",69,"ر",1,0],["وأنَّ رأسي يمشي عليهِ","تِيهاً عَدُوٌّ لهُ لَدود!",70,"د",1,0],["وأن راحَ سوطُ الذُّلِ يُلهب أمةً","كراهِيَةً يستاقُها وطَواعا",71,"ع",2,0],["وأنَّ رَوْحَكِ رُوحٌ تأنَسِينَ بها","إذا تململَ مَيْتٌ رُوحُهُ نَكَدُ",72,"د",1,0],["وأن رمت صبراً أو سلواً بغيرها","رأيت جميع الناس من دونها بعضا",73,"ض",2,0],["وان رحابه السامى المباني","مقام الامن للمتبتلين",74,"ن",1,0],["وإن رددنا عن الأبواب جملتها","بباه رحمة منه يحيينا",75,"ن",2,0],["وإنْ رَحَلَ النَّهارُ تَرى نُجومًا","وأقمارًا، وشَمْسًا هاشِمِيَّةْ",76,"ي",2,0],["وإن رمت اخفاء البلابل والجوى","تبوح دموعى بالذي كنت مخفيا",77,"ي",2,0],["وإن رامه سِلقُ الضراغم بَرَّه","ويحمى من الأسد الضوارى عرينَها",78,"ه",2,0],["وإن رَدَّ عَن قُربٍ فَالأقَوالُ خَمسَةٌ","فَالأكلُ بِإطلاَقٍ لَهُ ولِجَارِهِ",79,"ر",2,0],["وَإِن رُمتَ مِنهُ الخَطَّ قالَ تَكُبَّراً","لَقَد كُنتُ أُمِّياً مَفَخَّمَ شَانِ",80,"ن",1,0],["وَإِن رَامَ إنشَاءَ القَوَافي تَرَاهُ في","عَوَاصِى القَوافي حَاكِماً مُتَصَرِّفَا",81,"ف",2,0],["وإن رَفَعَ السَّرابُ على تَنَاءِ","بَلاَدكِ ظَلتُ مُرتَقِبَ السَّرَابِ",82,"ب",1,0],["وإن رَاءَ الهُوَينَا نَارَعَنها","نَوارَ الدَّلوِ صَرَّمَتِ الرَّشَاءَ",83,"ا",2,0],["وإن رويتُ أحاديثَ الذين نأَوا","فعَنْ نسيم الصَّبا والبرقِ إسنادي",84,"د",2,0],["وَإِنَّ رِجالاً فيكَ شَكَّت قُلوبُهُم","أُلئِكَ قَومٌ عَن سَبيلِ الهُدى صَدّوا",85,"د",3,0],["وإن رمت فقه الأصبحيّ فعج على","مجالسنا تشهد لواء العنا دوا",86,"و",2,0],["وَإِنْ رُمْتُ كِتْمانَ الهَوى نَطَقَتْ بِهِ","بَوَادِرُ دَمْعٍ سُحْبُهُنَّ جُفُونُ",87,"ن",1,0],["وإن راجيك دون الناس أحذرهم","بأن يعود بما قرّت نواظره",88,"ر",2,0],["وإن ركعت رماح الخط فيهم","خررن لها الجماجم ساجدات",89,"ت",1,0],["وإن رجالا بعده عن إلههم","تلقوا علوما كالبحار الزواخر",90,"ر",1,0],["وإن رسول الله يأتي وراءه","من الصين من يعلوه عند التفاخر",90,"ر",1,0],["وان رسول الله والصحب جلهم","قد انتشروا خلف المولى المبادر",90,"ر",1,0],["وَإِن رَأَيتَ نارَ حَربٍ تَلتَظي","فَاِعلَم بِأَنّي مُسعِرٌ ذاكَ اللَظى",91,"ا",1,0],["وإنْ رزقتَ في الملاهي نَفسَاً","فعُدَّ كُلَّ العُمرِ ذاك النَفَسا",92,"س",2,0],["وإِن رُمتَ فيهم دَفعَ ضَيمٍ وَنُصرَةٍ","بِهِم رُمتَ أَو شالاً مِنَ اِصطُمَّةِ الرَملِ",93,"ل",1,0],["وَإِن رُبِطَت بَينَ القِبابِ جِيادُهُ","فَهُنَّ بِأَكبادِ المُلوكِ جَوائِلُ",94,"ل",1,0],["وَإِن رَحَلَ الأَحياءُ عَن قُربِ مَنزِلٍ","لِخَوفٍ بَنوا في جَوِّهِ وَأَقامُوا",95,"م",3,0],["وإن رغِب المسكين عنهم بزهده","يقولون غَثٌّ بارد متثاقل",96,"ل",1,0],["وإن رام شَرّا جَسَّروه لفعله","وإن كان فيه تُستباح المَقاتل",96,"ل",1,0],["وإن رأوا حسنا أبدوه وابتهجوا","إخوان صدق لمن أخلاقهم عرفا",97,"ف",2,0],["وإن رمت غلق الباب ابدي تغضّبا","وأوما بشرّ حرّه متحرّد",98,"د",1,0],["وإن رحتُ أُمليهِنَّ ودَّ عُطاردٌ","لحسن معانيهنَّ لو كان كاتبي",99,"ب",2,0],["وإنَّ رخيصاً كل قولٍ وإن غلا","لملكِ بلادٍ تربهنَ من التبرِ",100,"ر",1,0],["وان رمت وردا وافر الجود وافيا","فدونك هذا البحر يا قاصدا مصرا",101,"ر",2,0],["وإن رمت وصلا منكم فوصالكم","مكانَ الثُرَيا من يُطِيقُ لها قَبْضا",102,"ض",2,0],["وَإِن رامَهُ سِربُ المَسَرّاتِ لم يَجِد","مَحَلّاً بهِ من لاعجِ الهَمِّ خاليا",103,"ي",2,0],["وَإن رُمتما لي بِالمَلامِ سَلامةً","أَرِفقُكُما يُرضى صِيالَ حُسامي",104,"ي",1,0],["وإن رامَ غَدْرا أَظهرَ اللّه سِرَّه","عليه وأَبدَى كلَّ ما هو كاتمُ",105,"م",1,0],["وإن روّحتني حادثات خطوبه","دهتني بِإلْفٍ أو بضرّ صديق",106,"ق",1,0],["وإن رَجَعْتُ إلى قلبي لأعذِله","وجدته باختياري ذاب واحترقا",107,"ق",2,0],["وإن رنا نحوك السَقامُ فقد","عاد غضيضَ الجفونِ والنظر",108,"ر",1,0],["وإن رُمتُ تقريظاً لغيرك عاقَنِي","لساني ورَاح القولُ فيه يُكذَّب",109,"ب",1,0],["وإن رَمتْنا الخُطوبَ عن عُرُضٍ","فاضَ نزارٌ فَجلاّها",110,"ا",3,0],["وأن رسول الله أحمد خيرهم","وأفصحهم عند البلاغ وأبرع",111,"ع",1,0],["وإن رُمت من أخلاقه ذكر بعضها","فتلك من المسك المعنبر أضوع",111,"ع",1,0],["وإن رمت عزاً شاملاً وصيانة","وعوناً على الدنيا بجانبه لُذ",112,"ذ",1,0],["وإن ربحت تجارته وزادت","بدنياه عواقبه المخاسر",113,"ر",1,0],["وان رجوت السوى جهلا بلا صلةٍ","فقد تقدمني من يعبد الوثنا",114,"ن",2,0],["وإن رَشفتُ الرِّضابَ أسكرَني","كأن خمراً دَبّت حميَّاها",115,"ا",3,0],["وإنّ رغيفَ الخبزِ أصعبُ خلسهُ","من الثروةِ الكبرى فكن سارقاً أمهر",116,"ر",1,0],["وإن ركِبوا الجردَ اليعابيبَ سابَقت","خيولَ المنايا والدّواهي دَواهم",117,"م",1,0],["وأنِر لهُم سُبُلاً عليها دَمعُهم","يَنهَلُّ وامزُج مزنة بضياء",118,"ا",2,0],["وان رأت الاعداء كيف تكيدني","فخذها بكف الكف من حيث لا أَدري",119,"ي",1,0],["وان رسول اللَه من مكة سرى","الى القدس وَالروح الامين سمير",120,"ر",1,0],["وإنْ رَقَّقْتُ مِنهُ عَن صَبُوحٍ","فَريقَتُها مُعَتَّقَةٌ شَمولُ",121,"ل",1,0],["وَإِن راقَتكَ بَزَّتُهُ","فَكَالدفلى أَكنَسى نَورا",122,"ر",2,0],["وإن رأَيتَ هفوَه","فاِنصحهُمُ في خَلوَه",123,"ه",1,0],["وإن رأَيت وَهنا","فلا تَسُمهم طعنا",123,"ن",2,0],["وإِن رمت لي فخراً عددتُ من العُلى","مزايا عظاماً لا عظاماً بواليا",124,"ي",2,0],["وإِن رُمتُ إِطفاءً لنار تلهُّفي","عليكَ غَدا حُزني لها أَبَداً يُذكي",125,"ك",2,0],["وإنْ رآني مقبلاً","رَفْرَفَ زنديه وَمدّ",126,"د",1,0],["وَإِن رُمتَ أَن تَحظى بِقَلبٍ مُنَوَّرٍ","نَقِيٍّ عَنِ الأَغيارِ فَاِعكِف عَلَيَّ الذِكرِ",127,"ر",1,0],["وَإِن رُمتَ أَمراً فَاِسأَلِ اللَهَ إِنَّهُ","هُوَ المُفَضَّلُ الوَهّابُ لِلخَيرِ وَالوَفرِ",127,"ر",1,0],["وإن رسول الله من غير مرية","إمام على الإطلاق في كل حضرة",128,"ه",1,0],["وَإِن رَحَلتَ إِلى مَلكٍ لِتَمدَحَهُ","فَاِرحَل بِشِعرٍ نَقِيٍّ غَيرِ مَخشوبِ",129,"ب",1,0],["وإن راودت قلبي الأماني تمثلت","له مدية خرقاء في كفّ جازر",130,"ر",1,0],["وَإِن رَمَيتَ بِها في طامِسٍ دَأَبَت","إِذا تَرَقرَقَ آلٌ بَعدَ رَقراقِ",131,"ق",1,0],["وإنْ رَوِيَتْ نُحورُهمُ دِماءً","روَيْنَ نُحورَنا دَمْعاً سِجاما",132,"م",2,0],["وَإِن رابَتكَ أَقوالي فَإِنّي","حَمَلتُ وَقارَهُ وَحَمَلتُ وِقرَه",133,"ر",2,0],["وإِن رأَيتُم عَرَضاً سالِماً","قُلتُم لِعرضٍ ليسَ بالسَّالِمِ",134,"م",1,0],["وإن رامَها ملكٌ قبلَهُ","سعَت لي إلى قَلبهِ تَشفَعُ",135,"ع",1,0],["وَان رجعتُ إِلى يومِ الغَديرِ وَكم","من مَفخرٍ فيهِ أَحكيهِ وَأَرويهِ",136,"ي",2,0],["وإنْ رأينا خياناتٍ تؤرِّقُن","من بعضنا ، ورأينا خائناً عَاقَا",137,"ق",2,0],["وإنْ رُتَبُ العليا فخزنَ بماجدٍ","فَحَسْبُ العُلَى فخراً بأنّي لها ربُّ",138,"ب",1,0],["وإن رأيت جميلاً فافشه كرما","وإن رأيت قبيحاً كن كذي صمم",139,"م",1,0],["وإن رمت إبراز الأدلة في الذي","تريد فما تدعو إليه تجاب",140,"ب",1,0],["وَإِن رمت أَن أَثني عَلَيكَ بِغَيرِهِ","فَماليَ في كُلِّ الأَنامِ مُساعِدُ",141,"د",1,0],["وَأَنَرتَ ما سدت أَكفَّ جِيادِهِ","وَهتكت ما نسجَت يَدا زِرادِهِ",142,"د",2,0],["وَإِن رَأيتَ رحاً لِلحرب دائِرَةً","كانوا لها دون هَذا الخلق كالقُطُبِ",143,"ب",1,0],["وإنَّ رضاباً قد سَقَتْنيه مرَّةً","على غفلة الواشين في أيمن الجزع",144,"ع",1,0],["وإنْ رابه منِّي أوامٌ أَبَلَّه","وكمْ بلَّ يوماً غُلَّتي وأوامي",145,"ي",1,0],["وإنْ رقمت فوق الأَنام حنادسٌ","جَلَيْتَ من الرَّأي السَّديد لها فجرا",146,"ر",2,0],["وإن رمت عزماً فهو سحبان همةٍ","وإن رمت حزما انه",147,"ه",1,0],["وإِنْ رَأَى حالَتِي غَيْرِي تَنَاشَدَها","مِنَ الخُسارَةِ سُوءُ الكَيْلِ والحَشَفُ",148,"ف",1,0],["وإَن رَمَتْني الليالي","يوماً بدَاهٍ أُدَاهِنْ",149,"ن",1,0],["وإن روى الأخبارَ منْ","مُرسِلِها والمسنَّدِ",150,"د",1,0],["وإن ركعتْ بيضُ الظُبى في أكفّهمْ","بحَرْب فهاماتُ الأعادي سواجِدُ",151,"د",1,0],["وإن رمتم وردا فها فيض عبرتي","لعيسكم إن مسها ظمأ ورد",152,"د",1,0],["وإِنْ رَضُوا أَشرقَ الليلُ البهِيمُ بِهِمْ","ويكشِفُ الموتُ عن ساقٍ إِذَا أَنِفُوا",153,"ف",3,0],["وإِن راعتِ الأرضُ منهم جنوباً","تسلَّوا برعيِ نجومِ السماءِ",154,"ا",2,0],["وإِنْ رَضِيَتْكَ لتاجِ البقاءِ","فأَنتَ الرَّفِيعُ بهِ والعَمِيمُ",155,"م",1,0],["وإِنْ رُدَّ زَحْفُ الخَيْلِ مِنْكَ بِأَنَّةٍ","فأَعْداؤُها رَهْنٌ بِكَرِّ زُحُوفِها",156,"ف",3,0],["وإِنْ رَجَعَتْ عن صِدْقِ وَعْدِكَ بُرْهَةً","حواجِبُ آمَالِ الغَرِيبِ بِصُوفِها",156,"ف",3,0],["وإِنْ رآهُ الهلالُ مُطَّلِعاً","يقول ربِّي وربُّكَ اللهُ",157,"ه",1,0],["وإن رأيي فرأي المسلمين ولو","هداك عن ذا ترى منهما افترقا",158,"ق",2,0],["وإن ركبت لليل بطن جارية","أو ظهر زيافة فهرية نجد",159,"د",1,0],["وإن رزق الإنسان طاعة ربه","تقلد سيفاً من يد اللَه مايزا",160,"ز",2,0],["وإن رمنا سؤالك يا كريم","ذكرناها فابلسنا خناها",161,"ا",3,0],["وإن رفعت عنه بغيب ذميمةٍ","وناشد عنها من وفاه خفيها",162,"ي",3,0],["وإن رشفت تطوف بكل ذهن","وتبدعه الطروب العبقريا",163,"ي",2,0],["وأن رُفِعَتْ صيفيّةٌ حَلَبِيَّةٌ","تحلُّ حُلولَ الطيف ثم تبينُ",164,"ن",1,0],["وإن ركب السريرَ وزيرُ ملك","رأيت التاجَ تَشرفُهُ العِمامَهْ",165,"م",2,0],["وإن ركبتَ خطَر البيد معي","ركوبَ من لا يستشير إن عزَمْ",166,"م",1,0],["وإن ريع جار أو تنكَّر منزلٌ","فربَّ جنابٍ للحسين مَريعِ",167,"ع",1,0],["وإن رأى ربها نِشدانها وقعت","في جانبٍ لم يُعرِّف أهلَه اللُّقطا",168,"ط",2,0],["وإن رَشَفَتْ ريقَها ألسُنٌ","وقاءَتْ ففي القيءِ أكبادُها",169,"د",3,0],["واِنْ رضيتُ به فالذلُّ منقَصةٌ","وكم تكلَّفتُه حملاً فلم اُطِقِ",170,"ق",1,0],["واِن رحتُ كالهنديِّ من غير ساعد","فعارٌ على الأبطال جهلُ البَواترِ",171,"ر",1,0],["وانْ رحُتُ الاَّ حامداً غير أنني","أَخو حالةٍ اِن لم أقل نطقتْ قبلي",172,"ل",2,0],["وأنَّ رَجائي في مَساعيهِ ضِلَّةٌ","ولم يبقَ منه غيرُ موقفِ راكبِ",173,"ب",1,0],["وإن رأوا بخس فضلي حقَّ قيمته","فالدرُّ دُرٌّ وإنْ لم يُشرَ بالقيمِ",174,"م",1,0],["وأن راسلته جياد العقول فات","مدى شوطها بالتأني",175,"ي",1,0],["وإن ركبوا الخيلَ العتاق لغايةٍ","رأيتَ عصابَ الأسدِ فوقَ الأجادل",176,"ل",1,0],["وَإِن رَكِبتَ الصوابَ مِنكَ فَلا","تَسِر بِهِ في مَسالِكِ الغَلَطِ",177,"ط",1,0],["وَإِن رَأَيتَ الإِثمَ في مَوسِمٍ","فَلا تُزايِد فيهِ مَن يَشتَري",178,"ي",1,0],["واِن ردَّدَ الركبُ ذكرَ الهوى","سَرَتْ والطريقُ بها مَهْيَعُ",179,"ع",1,0],["وَإِن رَأى المُتَناهى مِن سِيادَتهُ","إِلى المَحلِ الَّذي لَم يرقَهُ أَحَدُ",180,"د",1,1],["وأَنٍّ راح يتبعُهُ حَنينٌ","أَتى بعجائِبِ الأَلَمِ الأَليمِ",181,"م",1,0],["وإنْ رأيتَ بُدورَ الحيِّ وهي بهِم","فحيِّ بالسّرّ عنّي وجهَ أحياها",182,"ا",3,0],["وَإنَّ رَجائي أَنْ يُنَجِّزَ خالِقي","كَلامِي بِسَعْيٍ فَهْوَ جُلُّ مَرامِي",183,"ي",1,0],["وإنْ رُمْتُهُ يَجْري عَلَى ما أُريدُهُ","جَرَى جَامِحاً مُغْرىً بِشَوْطِ شِرادِ",184,"د",1,0],["وإنْ رُمْتَ فَكَّ الأَسْرِ عَنْها تَمَنَّعَتْ","وقالَتْ دَعونِي في الإسارِ ونِسْعَتي",185,"ي",1,0],["وإنْ رآك حريصاً","عليه يوماً تولّى",186,"ل",2,0],["وإنْ ركبوا ظهراً من الفخر أردفوا","وإِنْ طلبوا شيئاً من الذّكر ألْحَفوا",187,"ف",3,0],["وَإِن رامَ دَهرٌ أَن يسوءَك صرفُه","فأصغى بمصلومٍ وعضّ بأدْرَدِ",188,"د",1,0],["وإن رأيناه لا نراه","إذ نحن في رتبة تليه",189,"ي",2,0],["وإن رأى الأكل أضحى واقفاً تره","يرنو إليك كأخلاق المساكينا",190,"ن",2,0],["وإن رمتم لشرع إن تقيموه","على مثلي لكم قد قام ميزان",191,"ن",1,0],["وإن ركعوا مالوا إليه بكلهم","وصاروا لديه والقلوب خواضع",192,"ع",1,0],["وَأَنَّ روحُ الإِلهِ مُطَّلِعٌ","عَلى المُحِبّينَ في التَراويحِ",193,"ح",1,0],["وإِنَ رَفَعَ المقدارُ أَو وَضَعَ النَّدى","فمنه يرجَّى الجدُّ أَو يُرْتَجى الجَدى",194,"د",2,0],["وإِنْ رُمْتُ أَسْهَلَ شَيْءٍ عليهِ","تَرَاهُ يصلِّي عَلى أَشْعَبِ",195,"ب",1,0],["وإِن رأَيتَ انصرافي في تَعَشُّقِه","تعمّداً فالتَّثَنِّي منه يُثنِيني",196,"ي",1,0],["وَإِنْ رُمْتُمُ وَصْفِي بَدِيعَ جَمالِهِ","فَأَيْسَرُ مَا فِيهِ الجمالُ بِأَسْرِهِ",197,"ر",2,0],["وإن رمت مالاً كان في العلم كسبه","ففز بالرضا واختر لما هو أوفق",198,"ق",1,0]]}