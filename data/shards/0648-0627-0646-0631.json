www.aldiwan.net/poem55901.html","الرجز"],[461,"أمرتجع لي فارط العيش بالحمى","https://www.aldiwan.net/poem56129.html","الطويل"],[461,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[461,"وخرقاء معرقة في الضلال","https://www.aldiwan.net/poem56224.html","المتقارب"],[464,"يا باذل المال في عدم وفي سعة","https://www.aldiwan.net/poem15323.html","البسيط"],[464,"اذا افتخرت عليا ربيعة بالذي","https://www.aldiwan.net/poem15413.html","الطويل"],[464,"شربت دما ان حال ودي ساعة","https://www.aldiwan.net/poem15480.html","الطويل"],[464,"تقيل نوشروان بعد ذهابه","https://www.aldiwan.net/poem16034.html","الطويل"],[464,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[467,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[467,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[471,"أرض إله السماء عنك بما","https://www.aldiwan.net/poem59911.html","المنسرح"],[471,"لا تبع المعروف بالمنكر","https://www.aldiwan.net/poem59972.html","السريع"],[480,"على البان قمرية تسجع","https://www.aldiwan.net/poem15215.html","المتقارب"],[496,"وإن رأى المتناهى من سيادته","https://www.aldiwan.net/poem67397.html","البسيط"],[503,"أتانا من صبا نجد نسيم","https://www.aldiwan.net/poem37783.html","الوافر"],[517,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[532,"سلوا الناس من قد قام مثل مقامي","https://www.aldiwan.net/poem37141.html","الطويل"],[532,"وفود حبيب أم ورود عهاد","https://www.aldiwan.net/poem37457.html","الطويل"],[532,"مسامع من ناديت يا عمرو سدت","https://www.aldiwan.net/poem37501.html","الطويل"],[554,"دع الغنى لبنيه","https://www.aldiwan.net/poem47302.html","المجتث"],[554,"لنا من ثناياك الغريض المرشف","https://www.aldiwan.net/poem47403.html","الطويل"],[554,"أيا ملك الأملاك قد جاءني الذي","https://www.aldiwan.net/poem47842.html","الطويل"],[561,"نحن معاني الوجود فيه","https://www.aldiwan.net/poem33671.html","مخلع البسيط"],[561,"في الكلب عشر خصال كلها حمدت","https://www.aldiwan.net/poem33800.html","البسيط"],[561,"أنا المعروف لي بالله ألوان","https://www.aldiwan.net/poem33827.html","الهزج"],[561,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[576,"حدثني الشوق عن تباريحي","https://www.aldiwan.net/poem3653.html","المنسرح"],[578,"سواي يخاف الدهر أو يرهب الردى","https://www.aldiwan.net/poem2749.html","الطويل"],[578,"أيدفعني الدهر عن مطلبي","https://www.aldiwan.net/poem2750.html","المتقارب"],[578,"دع قضب نعمان أو كثبان يبرين","https://www.aldiwan.net/poem2851.html","البسيط"],[589,"خذوا خبرا عن نظم دمعي ونثره","https://www.aldiwan.net/poem17548.html","الطويل"],[590,"تعلم ففي العلم الشريف فوائد","https://www.aldiwan.net/poem11508.html","عموديه"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/216924","المتقارب"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/18007","الوافر"],[859,"","https://poetry.dctabudhabi.ae/diwan/poem/132486","الطويل"],[963,"","https://poetry.dctabudhabi.ae/diwan/poem/96097","الطويل"],[1079,"","https://poetry.dctabudhabi.ae/diwan/poem/97698","الطويل"],[1081,"","https://poetry.dctabudhabi.ae/diwan/poem/2540","المتقارب"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/114908","الوافر"]],"verses":[["وإنَّ رُزءَ الذي يدري جَهالَتَه","يهون عَمّن يخالُ الجَهلَ فيه هُدى",0,"د",2,0],["وَإِنَّ رِباطَ بَني مالِكٍ","تُقادُ إِلى المَوتِ أَرسانُهُ",1,"ن",2,0],["وَإِنَّ رَجائي زَينَ مِلَّةِ هاشِمٍ","لَنُعمى وَحَسبي مِن جَوادٍ وَمُنعَمِ",2,"م",1,0],["وَإِن رامَ أَملاكَ البِلادِ بِفَتكَةٍ","مَشى الذُلُّ في تيجانِها وَالمَناطِقِ",3,"ق",1,0],["وَإِن رَكَضَ السُؤالُ إِلى نَداهُ","تَتَبَّعَ إِثرَ وَطأَتِهِ بِنُجحِ",4,"ح",1,0],["وَإِنَّ رُزأً رَماني","بِالبُعدِ عَنكِ لَصَعبُ",5,"ب",1,0],["وَإِن رامَ اِجتِناباً لَم يُطِقهُ","وَلا يَقوى المُحِبُّ عَلى اِجتِنابِ",6,"ب",1,0],["وَإِن رَأَوني بِخَيرٍ ساءَهُم فَرَحي","وَإِن رَأَوني بِشَرٍّ سَرَّهُم نَكَدي",7,"د",2,0],["وإنْ راعَ دهْرٌ أو تنَكّرَ حادِثٌ","فلُذْ بحِمى منْ عامِرِ بْنِ محمَّدِ",8,"د",1,0],["وإنْ رُوِيَتْ عنْهُمْ عَوالي علائِهِمْ","فآثارُ عَلْياكَ الحِسانُ الصّحائِحُ",9,"ح",1,0],["وَإِن رَأَيتُم في يَدي زَهرَةً","فَإِنَّها مِن ذَلِكَ الغَرسِ",10,"س",1,0],["وَأَن رُكِزَت حَولَ الخُدورِ أَسِنَّةٌ","وَحَفَّت بِقُبِّ السابِحاتِ قِبابُ",11,"ب",1,0],["وَإِن رَمِدَت عَينايَ يَوماً كَحَلتُها","بِعَينَيكِ لَم أَبغِ الذَرورَ مِنَ الكُحلِ",12,"ل",1,0],["وَإِن رَزَحَ الْحَمَّالَ مِنْ وِقْرِ حِمْلِهِ","أَيُلْقِيهِ عَنْهُ أَمْ يُطَاوِعُ لُوَّمَا",13,"م",2,0],["وَأَن رَبَّ أَمثالِ البَلايا مِنَ السُرى","مُضِرٌ بِها الإِدلاجُ لَولا نِعالُها",14,"ل",3,0],["وَإِن رَفَعوا الذَميل لَقينَ مِنهُ","هَواناً حينَ يَرتَكِبُ الذَميلا",15,"ل",2,0],["وَإِن رَدَّهُنَّ الرَكبُ راجَعنَ هِزَّةً","دَريجَ المَحالِ اِستَثقَلَتهُ المَحاوِرُ",16,"ر",1,0],["وإن رُدَّ سيف الملك صوناً لغمدهِ","فقد سُلَّ من غمد الخلافة مُرْهَفُ",17,"ف",1,0],["وإن راعَ قلبَ الدين نعيُ إمامه","فقد هُزَّ منه بالبشارة مَعْطَفُ",17,"ف",1,0],["وإن رقيت نحو السماء فحبّذا","إذا أصبحت مأوىً لها الأنجم الزهر",18,"ر",1,0],["وَإن رَفَعُوا مَنَاسِبَهُم رَفَعنَا","إِلَى مُضَرَ الَّتي لاَ يَجهَلُونَا",19,"ن",2,0],["وَإِنَّ رِجالاً ما اِبنَكُم كَاِبنِ أُختِهِم","حَرِيّونَ أَن يُقضى لَهُم وَيُهابوا",20,"ب",3,0],["وإن رأيت قدّه العالي فصف","وقف على المنصوبِ منه بالألف",21,"ف",1,0],["وَإِن رُمتُ فَوقاً أَنتَ في الفَوقِ فَوقُهُ","وَإِن رُمتُ تَحتاً أَنتَ كُلُّ مَكانِ",22,"ن",1,0],["وإن رمت الحجامة فالثلاثا","فذاك اليوم مهراقُ الدماءِ",23,"ا",2,0],["وإن رام امرؤٌ يوماً دواءً","فنعم اليومُ يوم الأربعاءِ",23,"ا",2,0],["وإن رَجَوْا أخرى فمن قولهم","أفْلَحَ هذا الغائب الآيِبُ",24,"ب",1,0],["وإن رام من حَدِّ البطيحة مَطلعاً","ثَنَتْ شأوَهُ عنه المواصير والجِسر",25,"ر",1,0],["وإن رأى أو أحس آونةً","دخانَ نارٍ لجاره كَبَسَهْ",26,"س",2,0],["وإن رجائي فيك خيَّب نعمتي","فأضحتْ كإحدى الفاركاتِ النواشِص",27,"ص",1,0],["وإن راض للسلطان خشناءَ صعبةً","فناهيكَ روّاضا به ومروِّضا",28,"ض",2,0],["وأن ركايا الماء فيكم جَرورها","إذا كان في القوم الكرام نَزوعها",29,"ع",3,0],["وإن رضيتم رضينا عن مسالمكم","وإن غضبتم فنحن الشيعة الأنف",30,"ف",1,0],["وإن رفرفتْ يوماً عليك مُلمَّةٌ","فرفرف جبريل عليك وميكالُ",31,"ل",1,0],["وإن رمَى الدهرُ من يرمي صفاتَكمُ","ناديتُه لا رماك اللَّه بالشللِ",32,"ل",1,0],["وإن رمتَ من يُعنى به الحقّ والهوى","فإنك مخسوفٌ به أو مزلزلُ",33,"ل",1,0],["وإن رأى حيةً تهتزُّ في ركَبٍ","هوى لها بعصا موسى بن عمران",34,"ن",1,0],["وَإِن رَقَّ مِنّي مَنطِقٌ وَشَمائِلٌ","فَما هَمَّ مِنّي بِالقَبيحِ ضَميرُ",35,"ر",1,0],["وَإِن راقَ أَقواماً مِنَ الناس منطِقٌ","يرُقْ أَبَداً مني مَقالٌ وَأَفعالُ",36,"ل",1,0],["وَإِن رمتُ نَفسي كَيفَ آتي لِصَرمِها","وَرمتُ صدوداً ظَلَّتِ العَينُ تَدمَعُ",37,"ع",1,0],["وَإنّ رَحِيلاً وَاحِداً حَالَ بَيْنَنَا","وَفي المَوْتِ مِنْ بَعدِ الرّحيلِ رَحيلُ",38,"ل",1,0],["وَأنّ رِمَاحَ الخَطّ عَنْهُ قَصِيرَةٌ","وَأنّ حَديدَ الهِنْدِ عَنهُ كَليلُ",38,"ل",1,0],["وإن رُزقتَ فلا تأسف على أحد","بالفضل واحذر مصير البغي والبطرِ",39,"ر",1,0],["وإن رابتْ إساءتُه فَهبْهَا","لما فيه من الشِّيَمِ الحِسَانِ",40,"ن",1,0],["وإن رامَ بَرَّاً لم يدعْ سَرَعانُه","لساقتهِ في البَّرِ موقفَ راكبِ",41,"ب",1,0],["وَأَنَّ رِماحَنا تَأبى وَتَحمى","عَلى ما بَينَ عالِيَةٍ وَرومِ",42,"م",1,0],["وإن راحَ رُعيانُها أْطْرَبَتْكَ","فَواقِدُ أولادِها الثَّاغيه",43,"ي",2,0],["وإن رآه رقيقُ الوجهِ قال أَرِقْ","كأسَ الحياءِ بضَمٍّ أو ِبتَقْبيلِ",44,"ل",1,0],["وَأَنَّ رَحلي وَإِن أَوثَقتُهُ لَعَلى","مَطِيَّةٍ مِن مَطايا الحَينِ مَحمولُ",45,"ل",1,0],["وَأَنَّ رِجالَ النَفعِ تَحتَ مَداسِها","وَأَنَّ رِجالَ الضُرِّ فَوقَ سَنامِها",46,"ه",2,0],["وَإِن رَأى في بَيتِهِ فارَةً","بادَرَها بِالسَيفِ وَالتُرسِ",47,"س",1,0],["وَإِن رَكَزوا غِبَّ الطِعانِ رِماحَهُم","رَأَيتَ رُؤوسَ الأُسدِ فَوقَ الثَعالِبِ",48,"ب",1,0],["وإنَّ رَزايا العُمرِ مِنْهُنّ مركبي","ثقالٌ بأعطانِ المنايا مَبارِكُه",49,"ك",2,0],["وإن رُفعت فوق المفارق صَيّرَتْ","دبيبَ المنايا من مضاربها وثبا",50,"ب",2,0],["وَإِن رُمتُ أَمراً مُدبِرَ الوَجهِ إِنَّني","سَأَترُكُ حَظّاً في فِنائِكَ مُقبِلا",51,"ل",2,0],["وأنَّ رَوْحكِ رُحٌ تأنَسِينَ بها","إذا تململَ مَيْتٌ رُوْحُهُ نَكَد",52,"د",1,0],["وإن رميتَ بَنِي الدنيا بقُوَّتهِ","ردَّ العُبابَ دماً والأرضَ بُركانا",53,"ن",2,0],["وَإِن رابَت مَواقِفَها اللَيالي","فَمِن تاجيكَ يَنبَلِجُ اليَقينُ",54,"ن",1,0],["وإن راحَ يَسْتَسْقِي به الغيثَ مُسنِتٌ","تَقَشَّعَ عنه الجدبُ واطَّرَدَ الخِصْبُ",55,"ب",1,0],["وَإِن رَمى كانَ مَريضَ السَهمِ","ذا وَتَرٍ رِخوٍ ضَعيفِ الرَجمِ",56,"م",1,0],["وإنْ رَجَعُوا لأرْضِهِمْ بخَيْرٍ","فَلَمْ تَرَ كاتِباً إلاَّ حَزِينا",57,"ن",2,0],["وَإِن رَئيتُ الشُراةَ قَد طَلَعوا","أَلجَمتُ مُهري مِن جانِبِ الذَنَبِ",58,"ب",1,0],["وَإِن رَجَعتُ وَرائي","خَشيتُ زَأرَ أُسودِه",59,"د",2,0],["وَإِنَّ رِجالَ شَيبَةَ سادِنيها","إِذا راحَت لِكَعبَتِها الجِمارا",60,"ر",2,0],["وَإِن رُدِدتُ لِأَصلي","دُفِنتُ في شَرِّ تُربَه",61,"ب",2,0],["وَإِنَّ رِجالاً كانَ نَسرٌ لَدَيهِمُ","إِلهاً عَلَيهُم قَبلَنا طَلَعَ النَسرُ",62,"ر",1,0],["وَإِن رَأَيتَ هِزبَرَ الغابِ مُفتَرِساً","فَقَد يَكونُ زَماناً وَهُوَ فَرّاسُ",63,"س",1,0],["وَإِن رُزِقتَ النُهى فَأَنتَ عَلى ال","أَصحابِ حَليٌّ تَتَنازَعوهُ خُلَس",64,"س",1,0],["وَإِن رَأَيتَ الخَودَ مُختالَةً","يَصلُحُ أَن تُجعَلَ شَمّامَه",65,"م",2,0],["وَإِن رُقِّيَ الفَتى رُتَبَ المعالي","فَمِثلُ هُبوطِهِ ذاكَ الرُقِيُّ",66,"ق",2,0],["وإن رُمْتُمَا منطِقاً من فَمي","ولم تسْمَعَاهُ فصيحاً فَصِيحَا",67,"ح",2,0],["وأن رضا الأيام عنهم خديعة","وأن مصافاة الليالي لهم مكر",68,"ر",1,0],["وإن ركبوا الجرد العتاقد لغارةٍ","بدَوْا في وثاقٍ ركب نوقٍ وجامل",69,"ل",1,0],["وَأَنَّ رُمُوزاً فِي الرِّقَاعِ يَخطُّهَا","تُقِرُّ مَكَانَ الفَتْحِ حَيْثُ يُشيرُ",70,"ر",1,0],["وأنَّ رأسي يمشي عليهِ","تِيهاً عَدُوٌّ لهُ لَدود!",71,"د",1,0],["وأن راحَ سوطُ الذُّلِ يُلهب أمةً","كراهِيَةً يستاقُها وطَواعا",72,"ع",2,0],["وأنَّ رَوْحَكِ رُوحٌ تأنَسِينَ بها","إذا تململَ مَيْتٌ رُوحُهُ نَكَدُ",73,"د",1,0],["وأن رمت صبراً أو سلواً بغيرها","رأيت جميع الناس من دونها بعضا",74,"ض",2,0],["وأنّ رياضا هزّ لبنان فانتخت","شمائل في لبنان ميمونة غرّ",75,"ر",1,0],["وإن رجالاً حكموا اللّه حجة","على من بتحكيم الرجال يصور",76,"ر",1,0],["وان رحابه السامى المباني","مقام الامن للمتبتلين",77,"ن",1,0],["وإن رددنا عن الأبواب جملتها","بباه رحمة منه يحيينا",78,"ن",2,0],["وإنْ رَحَلَ النَّهارُ تَرى نُجومًا","وأقمارًا، وشَمْسًا هاشِمِيَّةْ",79,"ي",2,0],["وإن رمت اخفاء البلابل والجوى","تبوح دموعى بالذي كنت مخفيا",80,"ي",2,0],["وإن رامه سِلقُ الضراغم بَرَّه","ويحمى من الأسد الضوارى عرينَها",81,"ه",2,0],["وإن رَدَّ عَن قُربٍ فَالأقَوالُ خَمسَةٌ","فَالأكلُ بِإطلاَقٍ لَهُ ولِجَارِهِ",82,"ر",2,0],["وَإِن رُمتَ مِنهُ الخَطَّ قالَ تَكُبَّراً","لَقَد كُنتُ أُمِّياً مَفَخَّمَ شَانِ",83,"ن",1,0],["وَإِن رَامَ إنشَاءَ القَوَافي تَرَاهُ في","عَوَاصِى القَوافي حَاكِماً مُتَصَرِّفَا",84,"ف",2,0],["وإن رَفَعَ السَّرابُ على تَنَاءِ","بَلاَدكِ ظَلتُ مُرتَقِبَ السَّرَابِ",85,"ب",1,0],["وإن رَاءَ الهُوَينَا نَارَعَنها","نَوارَ الدَّلوِ صَرَّمَتِ الرَّشَاءَ",86,"ا",2,0],["وإن رويتُ أحاديثَ الذين نأَوا","فعَنْ نسيم الصَّبا والبرقِ إسنادي",87,"د",2,0],["وَإِنَّ رِجالاً فيكَ شَكَّت قُلوبُهُم","أُلئِكَ قَومٌ عَن سَبيلِ الهُدى صَدّوا",88,"د",3,0],["وإن رمت فقه الأصبحيّ فعج على","مجالسنا تشهد لواء العنا دوا",89,"و",2,0],["وَإِنْ رُمْتُ كِتْمانَ الهَوى نَطَقَتْ بِهِ","بَوَادِرُ دَمْعٍ سُحْبُهُنَّ جُفُونُ",90,"ن",1,0],["وإن راجيك دون الناس أحذرهم","بأن يعود بما قرّت نواظره",91,"ر",2,0],["وإن ركعت رماح الخط فيهم","خررن لها الجماجم ساجدات",92,"ت",1,0],["وإن رجالا بعده عن إلههم","تلقوا علوما كالبحار الزواخر",93,"ر",1,0],["وإن رسول الله يأتي وراءه","من الصين من يعلوه عند التفاخر",93,"ر",1,0],["وان رسول الله والصحب جلهم","قد انتشروا خلف المولى المبادر",93,"ر",1,0],["وَإِن رَأَيتَ نارَ حَربٍ تَلتَظي","فَاِعلَم بِأَنّي مُسعِرٌ ذاكَ اللَظى",94,"ا",1,0],["وإنْ رزقتَ في الملاهي نَفسَاً","فعُدَّ كُلَّ العُمرِ ذاك النَفَسا",95,"س",2,0],["وإِن رُمتَ فيهم دَفعَ ضَيمٍ وَنُصرَةٍ","بِهِم رُمتَ أَو شالاً مِنَ اِصطُمَّةِ الرَملِ",96,"ل",1,0],["وَإِن رُبِطَت بَينَ القِبابِ جِيادُهُ","فَهُنَّ بِأَكبادِ المُلوكِ جَوائِلُ",97,"ل",1,0],["وَإِن رَحَلَ الأَحياءُ عَن قُربِ مَنزِلٍ","لِخَوفٍ بَنوا في جَوِّهِ وَأَقامُوا",98,"م",3,0],["وإن رغِب المسكين عنهم بزهده","يقولون غَثٌّ بارد متثاقل",99,"ل",1,0],["وإن رام شَرّا جَسَّروه لفعله","وإن كان فيه تُستباح المَقاتل",99,"ل",1,0],["وإن رأوا حسنا أبدوه وابتهجوا","إخوان صدق لمن أخلاقهم عرفا",100,"ف",2,0],["وإن رمت غلق الباب ابدي تغضّبا","وأوما بشرّ حرّه متحرّد",101,"د",1,0],["وإن رحتُ أُمليهِنَّ ودَّ عُطاردٌ","لحسن معانيهنَّ لو كان كاتبي",102,"ب",2,0],["وإنَّ رخيصاً كل قولٍ وإن غلا","لملكِ بلادٍ تربهنَ من التبرِ",103,"ر",1,0],["وان رمت وردا وافر الجود وافيا","فدونك هذا البحر يا قاصدا مصرا",104,"ر",2,0],["وإن رمت وصلا منكم فوصالكم","مكانَ الثُرَيا من يُطِيقُ لها قَبْضا",105,"ض",2,0],["وَإِن رامَهُ سِربُ المَسَرّاتِ لم يَجِد","مَحَلّاً بهِ من لاعجِ الهَمِّ خاليا",106,"ي",2,0],["وَإن رُمتما لي بِالمَلامِ سَلامةً","أَرِفقُكُما يُرضى صِيالَ حُسامي",107,"م",2,0],["وإن رامَ غَدْرا أَظهرَ اللّه سِرَّه","عليه وأَبدَى كلَّ ما هو كاتمُ",108,"م",1,0],["وإن روّحتني حادثات خطوبه","دهتني بِإلْفٍ أو بضرّ صديق",109,"ق",1,0],["وإن رَجَعْتُ إلى قلبي لأعذِله","وجدته باختياري ذاب واحترقا",110,"ق",2,0],["وإن رنا نحوك السَقامُ فقد","عاد غضيضَ الجفونِ والنظر",111,"ر",1,0],["وإن رُمتُ تقريظاً لغيرك عاقَنِي","لساني ورَاح القولُ فيه يُكذَّب",112,"ب",1,0],["وإن رَمتْنا الخُطوبَ عن عُرُضٍ","فاضَ نزارٌ فَجلاّها",113,"ا",3,0],["وأن رسول الله أحمد خيرهم","وأفصحهم عند البلاغ وأبرع",114,"ع",1,0],["وإن رُمت من أخلاقه ذكر بعضها","فتلك من المسك المعنبر أضوع",114,"ع",1,0],["وإن رمت عزاً شاملاً وصيانة","وعوناً على الدنيا بجانبه لُذ",115,"ذ",1,0],["وإن ربحت تجارته وزادت","بدنياه عواقبه المخاسر",116,"ر",1,0],["وان رجوت السوى جهلا بلا صلةٍ","فقد تقدمني من يعبد الوثنا",117,"ن",2,0],["وإن رَشفتُ الرِّضابَ أسكرَني","كأن خمراً دَبّت حميَّاها",118,"ا",3,0],["وإنّ رغيفَ الخبزِ أصعبُ خلسهُ","من الثروةِ الكبرى فكن سارقاً أمهر",119,"ر",1,0],["وإن ركِبوا الجردَ اليعابيبَ سابَقت","خيولَ المنايا والدّواهي دَواهم",120,"م",1,0],["وأنِر لهُم سُبُلاً عليها دَمعُهم","يَنهَلُّ وامزُج مزنة بضياء",121,"ا",2,0],["وان رأت الاعداء كيف تكيدني","فخذها بكف الكف من حيث لا أَدري",122,"ر",2,0],["وان رسول اللَه من مكة سرى","الى القدس وَالروح الامين سمير",123,"ر",1,0],["وإنْ رَقَّقْتُ مِنهُ عَن صَبُوحٍ","فَريقَتُها مُعَتَّقَةٌ شَمولُ",124,"ل",1,0],["وَإِن راقَتكَ بَزَّتُهُ","فَكَالدفلى أَكنَسى نَورا",125,"ر",2,0],["وإن رأَيتَ هفوَه","فاِنصحهُمُ في خَلوَه",126,"ه",1,0],["وإن رأَيت وَهنا","فلا تَسُمهم طعنا",126,"ن",2,0],["وإِن رمت لي فخراً عددتُ من العُلى","مزايا عظاماً لا عظاماً بواليا",127,"ي",2,0],["وإِن رُمتُ إِطفاءً لنار تلهُّفي","عليكَ غَدا حُزني لها أَبَداً يُذكي",128,"ك",2,0],["وإنْ رآني مقبلاً","رَفْرَفَ زنديه وَمدّ",129,"د",1,0],["وَإِن رُمتَ أَن تَحظى بِقَلبٍ مُنَوَّرٍ","نَقِيٍّ عَنِ الأَغيارِ فَاِعكِف عَلَيَّ الذِكرِ",130,"ر",1,0],["وَإِن رُمتَ أَمراً فَاِسأَلِ اللَهَ إِنَّهُ","هُوَ المُفَضَّلُ الوَهّابُ لِلخَيرِ وَالوَفرِ",130,"ر",1,0],["وإن رسول الله من غير مرية","إمام على الإطلاق في كل حضرة",131,"ه",1,0],["وَإِن رَحَلتَ إِلى مَلكٍ لِتَمدَحَهُ","فَاِرحَل بِشِعرٍ نَقِيٍّ غَيرِ مَخشوبِ",132,"ب",1,0],["وإن راودت قلبي الأماني تمثلت","له مدية خرقاء في كفّ جازر",133,"ر",1,0],["وَإِن رَمَيتَ بِها في طامِسٍ دَأَبَت","إِذا تَرَقرَقَ آلٌ بَعدَ رَقراقِ",134,"ق",1,0],["وإنْ رَوِيَتْ نُحورُهمُ دِماءً","روَيْنَ نُحورَنا دَمْعاً سِجاما",135,"م",2,0],["وَإِن رابَتكَ أَقوالي فَإِنّي","حَمَلتُ وَقارَهُ وَحَمَلتُ وِقرَه",136,"ر",2,0],["وإِن رأَيتُم عَرَضاً سالِماً","قُلتُم لِعرضٍ ليسَ بالسَّالِمِ",137,"م",1,0],["وإن رامَها ملكٌ قبلَهُ","سعَت لي إلى قَلبهِ تَشفَعُ",138,"ع",1,0],["وَان رجعتُ إِلى يومِ الغَديرِ وَكم","من مَفخرٍ فيهِ أَحكيهِ وَأَرويهِ",139,"ي",2,0],["وإنْ رأينا خياناتٍ تؤرِّقُن","من بعضنا ، ورأينا خائناً عَاقَا",140,"ق",2,0],["وإنْ رُتَبُ العليا فخزنَ بماجدٍ","فَحَسْبُ العُلَى فخراً بأنّي لها ربُّ",141,"ب",1,0],["وإن رأيت جميلاً فافشه كرما","وإن رأيت قبيحاً كن كذي صمم",142,"م",1,0],["وإن رمت إبراز الأدلة في الذي","تريد فما تدعو إليه تجاب",143,"ب",1,0],["وَإِن رمت أَن أَثني عَلَيكَ بِغَيرِهِ","فَماليَ في كُلِّ الأَنامِ مُساعِدُ",144,"د",1,0],["وَأَنَرتَ ما سدت أَكفَّ جِيادِهِ","وَهتكت ما نسجَت يَدا زِرادِهِ",145,"د",2,0],["وَإِن رَأيتَ رحاً لِلحرب دائِرَةً","كانوا لها دون هَذا الخلق كالقُطُبِ",146,"ب",1,0],["وإنَّ رضاباً قد سَقَتْنيه مرَّةً","على غفلة الواشين في أيمن الجزع",147,"ع",1,0],["وإنْ رابه منِّي أوامٌ أَبَلَّه","وكمْ بلَّ يوماً غُلَّتي وأوامي",148,"م",2,0],["وإنْ رقمت فوق الأَنام حنادسٌ","جَلَيْتَ من الرَّأي السَّديد لها فجرا",149,"ر",2,0],["وإن رمت عزماً فهو سحبان همةٍ","وإن رمت حزما انه",150,"ه",1,0],["وإِنْ رَأَى حالَتِي غَيْرِي تَنَاشَدَها","مِنَ الخُسارَةِ سُوءُ الكَيْلِ والحَشَفُ",151,"ف",1,0],["وإَن رَمَتْني الليالي","يوماً بدَاهٍ أُدَاهِنْ",152,"ن",1,0],["وإن روى الأخبارَ منْ","مُرسِلِها والمسنَّدِ",153,"د",1,0],["وإن ركعتْ بيضُ الظُبى في أكفّهمْ","بحَرْب فهاماتُ الأعادي سواجِدُ",154,"د",1,0],["وإن رمتم وردا فها فيض عبرتي","لعيسكم إن مسها ظمأ ورد",155,"د",1,0],["وإِنْ رَضُوا أَشرقَ الليلُ البهِيمُ بِهِمْ","ويكشِفُ الموتُ عن ساقٍ إِذَا أَنِفُوا",156,"ف",3,0],["وإِن راعتِ الأرضُ منهم جنوباً","تسلَّوا برعيِ نجومِ السماءِ",157,"ا",2,0],["وإِنْ رَضِيَتْكَ لتاجِ البقاءِ","فأَنتَ الرَّفِيعُ بهِ والعَمِيمُ",158,"م",1,0],["وإِنْ رُدَّ زَحْفُ الخَيْلِ مِنْكَ بِأَنَّةٍ","فأَعْداؤُها رَهْنٌ بِكَرِّ زُحُوفِها",159,"ف",3,0],["وإِنْ رَجَعَتْ عن صِدْقِ وَعْدِكَ بُرْهَةً","حواجِبُ آمَالِ الغَرِيبِ بِصُوفِها",159,"ف",3,0],["وإِنْ رآهُ الهلالُ مُطَّلِعاً","يقول ربِّي وربُّكَ اللهُ",160,"ه",1,0],["وإن رأيي فرأي المسلمين ولو","هداك عن ذا ترى منهما افترقا",161,"ق",2,0],["وإن ركبت لليل بطن جارية","أو ظهر زيافة فهرية نجد",162,"د",1,0],["وإن رزق الإنسان طاعة ربه","تقلد سيفاً من يد اللَه مايزا",163,"ز",2,0],["وإن رمنا سؤالك يا كريم","ذكرناها فابلسنا خناها",164,"ا",3,0],["وإن رفعت عنه بغيب ذميمةٍ","وناشد عنها من وفاه خفيها",165,"ي",3,0],["وإن رشفت تطوف بكل ذهن","وتبدعه الطروب العبقريا",166,"ي",2,0],["وأن رُفِعَتْ صيفيّةٌ حَلَبِيَّةٌ","تحلُّ حُلولَ الطيف ثم تبينُ",167,"ن",1,0],["وإن ركب السريرَ وزيرُ ملك","رأيت التاجَ تَشرفُهُ العِمامَهْ",168,"م",2,0],["وإن ركبتَ خطَر البيد معي","ركوبَ من لا يستشير إن عزَمْ",169,"م",1,0],["وإن ريع جار أو تنكَّر منزلٌ","فربَّ جنابٍ للحسين مَريعِ",170,"ع",1,0],["وإن رأى ربها نِشدانها وقعت","في جانبٍ لم يُعرِّف أهلَه اللُّقطا",171,"ط",2,0],["وإن رَشَفَتْ ريقَها ألسُنٌ","وقاءَتْ ففي القيءِ أكبادُها",172,"د",3,0],["واِنْ رضيتُ به فالذلُّ منقَصةٌ","وكم تكلَّفتُه حملاً فلم اُطِقِ",173,"ق",1,0],["واِن رحتُ كالهنديِّ من غير ساعد","فعارٌ على الأبطال جهلُ البَواترِ",174,"ر",1,0],["وانْ رحُتُ الاَّ حامداً غير أنني","أَخو حالةٍ اِن لم أقل نطقتْ قبلي",175,"ل",2,0],["وأنَّ رَجائي في مَساعيهِ ضِلَّةٌ","ولم يبقَ منه غيرُ موقفِ راكبِ",176,"ب",1,0],["وإن رأوا بخس فضلي حقَّ قيمته","فالدرُّ دُرٌّ وإنْ لم يُشرَ بالقيمِ",177,"م",1,0],["وأن راسلته جياد العقول فات","مدى شوطها بالتأني",178,"ن",2,0],["وإن ركبوا الخيلَ العتاق لغايةٍ","رأيتَ عصابَ الأسدِ فوقَ الأجادل",179,"ل",1,0],["وَإِن رَكِبتَ الصوابَ مِنكَ فَلا","تَسِر بِهِ في مَسالِكِ الغَلَطِ",180,"ط",1,0],["وَإِن رَأَيتَ الإِثمَ في مَوسِمٍ","فَلا تُزايِد فيهِ مَن يَشتَري",181,"ر",2,0],["واِن ردَّدَ الركبُ ذكرَ الهوى","سَرَتْ والطريقُ بها مَهْيَعُ",182,"ع",1,0],["وَإِن رَأى المُتَناهى مِن سِيادَتهُ","إِلى المَحلِ الَّذي لَم يرقَهُ أَحَدُ",183,"د",1,1],["وأَنٍّ راح يتبعُهُ حَنينٌ","أَتى بعجائِبِ الأَلَمِ الأَليمِ",184,"م",1,0],["وإنْ رأيتَ بُدورَ الحيِّ وهي بهِم","فحيِّ بالسّرّ عنّي وجهَ أحياها",185,"ا",3,0],["وَإنَّ رَجائي أَنْ يُنَجِّزَ خالِقي","كَلامِي بِسَعْيٍ فَهْوَ جُلُّ مَرامِي",186,"م",2,0],["وإنْ رُمْتُهُ يَجْري عَلَى ما أُريدُهُ","جَرَى جَامِحاً مُغْرىً بِشَوْطِ شِرادِ",187,"د",1,0],["وإنْ رُمْتَ فَكَّ الأَسْرِ عَنْها تَمَنَّعَتْ","وقالَتْ دَعونِي في الإسارِ ونِسْعَتي",188,"ي",1,0],["وإنْ رآك حريصاً","عليه يوماً تولّى",189,"ل",2,0],["وإنْ ركبوا ظهراً من الفخر أردفوا","وإِنْ طلبوا شيئاً من الذّكر ألْحَفوا",190,"ف",3,0],["وَإِن رامَ دَهرٌ أَن يسوءَك صرفُه","فأصغى بمصلومٍ وعضّ بأدْرَدِ",191,"د",1,0],["وإن رأيناه لا نراه","إذ نحن في رتبة تليه",192,"ي",2,0],["وإن رأى الأكل أضحى واقفاً تره","يرنو إليك كأخلاق المساكينا",193,"ن",2,0],["وإن رمتم لشرع إن تقيموه","على مثلي لكم قد قام ميزان",194,"ن",1,0],["وإن ركعوا مالوا إليه بكلهم","وصاروا لديه والقلوب خواضع",195,"ع",1,0],["وَأَنَّ روحُ الإِلهِ مُطَّلِعٌ","عَلى المُحِبّينَ في التَراويحِ",196,"ح",1,0],["وإِنَ رَفَعَ المقدارُ أَو وَضَعَ النَّدى","فمنه يرجَّى الجدُّ أَو يُرْتَجى الجَدى",197,"د",2,0],["وإِنْ رُمْتُ أَسْهَلَ شَيْءٍ عليهِ","تَرَاهُ يصلِّي عَلى أَشْعَبِ",198,"ب",1,0],["وإِن رأَيتَ انصرافي في تَعَشُّقِه","تعمّداً فالتَّثَنِّي منه يُثنِيني",199,"ن",2,0],["وَإِنْ رُمْتُمُ وَصْفِي بَدِيعَ جَمالِهِ","فَأَيْسَرُ مَا فِيهِ الجمالُ بِأَسْرِهِ",200,"ر",2,0],["وإن رمت مالاً كان في العلم كسبه","ففز بالرضا واختر لما هو أوفق",201,"ق",1,0],["وإنْ راحَ يَنْهضُ نَهضَ الكَسِير","جَأجَأهُ الماءُ حتّى أسالا",202,"ل",2,0],["وَإِن رَسَلٌ تَرَفَّعَ بَعدَ طُعمٍ","فَعادَ لِكَي يُعادَ لَهُ أُعيدا",203,"د",2,0],["وإن رَأيَا لِي غِرَّةً أَغرَيَا بِهَا","أعَادِيَّ والأَعدَاءُ كَلبى كِلاَبُهَا",204,"ب",3,0],["وأن رجالاً بين سلع وواقم","لأير ابيهم في أبيك نصيبُ",205,"ب",1,0],["وَإِن ربّ جارٍ قَد حمينا وراءه","بِأسيافِنا وَالحرب يشري ذبابّها",206,"ب",3,0],["وَإِنَّ رِماحَ بَني عامِرٍ","يُقَطِّرنَ مِل عَلَقِ الأَحمَرِ",207,"ر",1,0],["وان رُمتَ الدُّخُول اليك وقتاً","تَراقَدُ لي وما بكَ من نُعَاس",208,"س",1,0]]}