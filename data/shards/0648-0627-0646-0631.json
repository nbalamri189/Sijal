{"poems":[[53,"أذاع بذي العهد عرفانه","https://www.aldiwan.net/poem29731.html","المتقارب"],[53,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[53,"بود الرذايا أنها في السوابق","https://www.aldiwan.net/poem29954.html","الطويل"],[53,"أعيذك من هجاء بعد مدح","https://www.aldiwan.net/poem30648.html","الوافر"],[53,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[55,"إذا هجر المحب بكى وأبدى","https://www.aldiwan.net/poem26538.html","الوافر"],[57,"إني صحبت الناس ما لهم عدد","https://www.aldiwan.net/poem24705.html","البسيط"],[77,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[77,"أثار سراها والديار نوازح","https://www.aldiwan.net/poem36644.html","الطويل"],[86,"أجاد مطران كعاداته","https://www.aldiwan.net/poem10857.html","السريع"],[73,"أما علمت أن الشفيع شباب","https://www.aldiwan.net/poem11916.html","الطويل"],[35,"وأنت لعيني قرة حين نلتقي","https://www.aldiwan.net/poem39093.html","الطويل"],[93,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[30,"دنا البين من مي فردت جمالها","https://www.aldiwan.net/poem29539.html","الطويل"],[30,"خليلي اسألا الطلل المحيلا","https://www.aldiwan.net/poem29549.html","الوافر"],[30,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[83,"عزاء فإن الشجو قد كان يسرف","https://www.aldiwan.net/poem54270.html","الطويل"],[88,"لعمرك ما كل انكسار له جبر","https://www.aldiwan.net/poem45069.html","الطويل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[47,"أما لجميل عندكن ثواب","https://www.aldiwan.net/poem25376.html","الطويل"],[72,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[64,"رقيبان مني شاهدان لحبه","https://www.aldiwan.net/poem67600.html","الطويل"],[51,"لنعم اليوم يوم السبت حقا","https://www.aldiwan.net/poem8145.html","الوافر"],[51,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[51,"أحباءنا ما كان لي عنكم صبر","https://www.aldiwan.net/poem64074.html","الطويل"],[51,"خوان عيسى من نصف ترمسة","https://www.aldiwan.net/poem64572.html","المنسرح"],[51,"رمين فؤادي من عيون الوصاوص","https://www.aldiwan.net/poem64935.html","الطويل"],[51,"يبتُ أخو البلوى إذا الخلو غمضا","https://www.aldiwan.net/poem64946.html","الطويل"],[51,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[51,"إذا ضحكتم ضحكنا في مفارحكم","https://www.aldiwan.net/poem65465.html","البسيط"],[51,"أبا حسن قد قلت لو كان فعال","https://www.aldiwan.net/poem65941.html","الطويل"],[51,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[51,"تأمل أبا عبد الإله فإنه","https://www.aldiwan.net/poem66003.html","الطويل"],[51,"أبو سليمان لا ترضى طريقته","https://www.aldiwan.net/poem66494.html","البسيط"],[70,"وعاذلة باتت تلوم على الهوى","https://www.aldiwan.net/poem42924.html","الطويل"],[78,"لعمرك إني بالمدامة قوال","https://www.aldiwan.net/poem14265.html","الطويل"],[32,"أهاجك أم لا بالمداخل مربع","https://www.aldiwan.net/poem27819.html","الطويل"],[43,"ليالي بعد الظاعنين شكول","https://www.aldiwan.net/poem9967.html","الطويل"],[62,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[62,"أخاك أخاك فهو أجل ذخر","https://www.aldiwan.net/poem52258.html","الوافر"],[62,"لقاء الأماني في ضمان القواضب","https://www.aldiwan.net/poem52506.html","الطويل"],[28,"ألا كيف البقاء لباهلي","https://www.aldiwan.net/poem5530.html","الوافر"],[61,"تذكر أيامه الخاليه","https://www.aldiwan.net/poem51396.html","المتقارب"],[61,"إذا المجرة مالت بعد تعديل","https://www.aldiwan.net/poem51485.html","البسيط"],[49,"طول التعاشر بين الناس مملول","https://www.aldiwan.net/poem63048.html","البسيط"],[49,"كفاك عن الدنيا الذميمة مخبرا","https://www.aldiwan.net/poem64912.html","الطويل"],[66,"مملوكك اليوم أبو حبه","https://www.aldiwan.net/poem38646.html","السريع"],[66,"لئن ثلمت حدي صروف النوائب","https://www.aldiwan.net/poem41586.html","الطويل"],[80,"أخذت برأي في الصبا أنا تاركه","https://www.aldiwan.net/poem31356.html","الطويل"],[80,"لها العتب هذا دأبها ولي العتبى","https://www.aldiwan.net/poem31544.html","الطويل"],[44,"لهان علينا أن نقول وتفعلا","https://www.aldiwan.net/poem30373.html","الطويل"],[90,"في ذمة الله ما ألقى وما أجد","https://www.aldiwan.net/poem47616.html","الكامل"],[105,"صونوا الذمام فإن الحر من صانا","https://www.aldiwan.net/poem42047.html","البسيط"],[105,"هواك هواك والدنيا شؤون","https://www.aldiwan.net/poem43372.html","الوافر"],[105,"توالت وفود الله تختار دينه","https://www.aldiwan.net/poem44000.html","الطويل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[48,"يا بشر ما لي والسيف والحرب","https://www.aldiwan.net/poem10776.html","المنسرح"],[48,"طاب الهوى لعميده","https://www.aldiwan.net/poem62606.html","مجزوء الكامل"],[46,"أقيمي لا أعد الحج فرضا","https://www.aldiwan.net/poem22042.html","الوافر"],[46,"إن يقرب الموت مني","https://www.aldiwan.net/poem22148.html","المجتث"],[46,"بيوت فمهدوم يرى ومقوض","https://www.aldiwan.net/poem22518.html","الطويل"],[46,"لا خير للفم في بسط الحياة له","https://www.aldiwan.net/poem22800.html","البسيط"],[46,"أف لما نحن فيه من عنت","https://www.aldiwan.net/poem22856.html","المنسرح"],[46,"ألمم بدار النسك إلمامه","https://www.aldiwan.net/poem23358.html","السريع"],[46,"تدين مغربي بانتحال","https://www.aldiwan.net/poem23605.html","الوافر"],[68,"خليلي إن جئتما منزلي","https://www.aldiwan.net/poem1490.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16630","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54830","الطويل"],[90,"عُدنا وقودا","https://www.poetsgate.com/ViewPoem.aspx?id=179221",""],[90,"شباب ضائع","https://www.poetsgate.com/ViewPoem.aspx?id=179161",""],[90,"ناجيت قبرك","https://www.poetsgate.com/ViewPoem.aspx?id=646",""],[33,"ألا أيُّهَا الشَّيْخُ الَّذِي مَا بِنَا","https://www.poetsgate.com/ViewPoem.aspx?id=2673",""]],"verses":[["وَإِنَّ رِباطَ بَني مالِكٍ","تُقادُ إِلى المَوتِ أَرسانُهُ",0,"ن",2,0],["وَإِنَّ رَجائي زَينَ مِلَّةِ هاشِمٍ","لَنُعمى وَحَسبي مِن جَوادٍ وَمُنعَمِ",1,"م",1,0],["وَإِن رامَ أَملاكَ البِلادِ بِفَتكَةٍ","مَشى الذُلُّ في تيجانِها وَالمَناطِقِ",2,"ق",1,0],["وَإِن رَكَضَ السُؤالُ إِلى نَداهُ","تَتَبَّعَ إِثرَ وَطأَتِهِ بِنُجحِ",3,"ح",1,0],["وَإِنَّ رُزأً رَماني","بِالبُعدِ عَنكِ لَصَعبُ",4,"ب",1,0],["وَإِن رامَ اِجتِناباً لَم يُطِقهُ","وَلا يَقوى المُحِبُّ عَلى اِجتِنابِ",5,"ب",1,0],["وَإِن رَأَوني بِخَيرٍ ساءَهُم فَرَحي","وَإِن رَأَوني بِشَرٍّ سَرَّهُم نَكَدي",6,"ي",1,0],["وإنْ راعَ دهْرٌ أو تنَكّرَ حادِثٌ","فلُذْ بحِمى منْ عامِرِ بْنِ محمَّدِ",7,"د",1,0],["وإنْ رُوِيَتْ عنْهُمْ عَوالي علائِهِمْ","فآثارُ عَلْياكَ الحِسانُ الصّحائِحُ",8,"ح",1,0],["وَإِن رَأَيتُم في يَدي زَهرَةً","فَإِنَّها مِن ذَلِكَ الغَرسِ",9,"س",1,0],["وَأَن رُكِزَت حَولَ الخُدورِ أَسِنَّةٌ","وَحَفَّت بِقُبِّ السابِحاتِ قِبابُ",10,"ب",1,0],["وَإِن رَمِدَت عَينايَ يَوماً كَحَلتُها","بِعَينَيكِ لَم أَبغِ الذَرورَ مِنَ الكُحلِ",11,"ل",1,0],["وَإِن رَزَحَ الْحَمَّالَ مِنْ وِقْرِ حِمْلِهِ","أَيُلْقِيهِ عَنْهُ أَمْ يُطَاوِعُ لُوَّمَا",12,"م",2,0],["وَأَن رَبَّ أَمثالِ البَلايا مِنَ السُرى","مُضِرٌ بِها الإِدلاجُ لَولا نِعالُها",13,"ل",3,0],["وَإِن رَفَعوا الذَميل لَقينَ مِنهُ","هَواناً حينَ يَرتَكِبُ الذَميلا",14,"ل",2,0],["وَإِن رَدَّهُنَّ الرَكبُ راجَعنَ هِزَّةً","دَريجَ المَحالِ اِستَثقَلَتهُ المَحاوِرُ",15,"ر",1,0],["وإن رُدَّ سيف الملك صوناً لغمدهِ","فقد سُلَّ من غمد الخلافة مُرْهَفُ",16,"ف",1,0],["وإن راعَ قلبَ الدين نعيُ إمامه","فقد هُزَّ منه بالبشارة مَعْطَفُ",16,"ف",1,0],["وإن رقيت نحو السماء فحبّذا","إذا أصبحت مأوىً لها الأنجم الزهر",17,"ر",1,0],["وَإن رَفَعُوا مَنَاسِبَهُم رَفَعنَا","إِلَى مُضَرَ الَّتي لاَ يَجهَلُونَا",18,"ن",2,0],["وَإِنَّ رِجالاً ما اِبنَكُم كَاِبنِ أُختِهِم","حَرِيّونَ أَن يُقضى لَهُم وَيُهابوا",19,"ب",3,0],["وإن رأيت قدّه العالي فصف","وقف على المنصوبِ منه بالألف",20,"ف",1,0],["وَإِن رُمتُ فَوقاً أَنتَ في الفَوقِ فَوقُهُ","وَإِن رُمتُ تَحتاً أَنتَ كُلُّ مَكانِ",21,"ن",1,0],["وإن رمت الحجامة فالثلاثا","فذاك اليوم مهراقُ الدماءِ",22,"ا",2,0],["وإن رام امرؤٌ يوماً دواءً","فنعم اليومُ يوم الأربعاءِ",22,"ا",2,0],["وإن رَجَوْا أخرى فمن قولهم","أفْلَحَ هذا الغائب الآيِبُ",23,"ب",1,0],["وإن رام من حَدِّ البطيحة مَطلعاً","ثَنَتْ شأوَهُ عنه المواصير والجِسر",24,"ر",1,0],["وإن رأى أو أحس آونةً","دخانَ نارٍ لجاره كَبَسَهْ",25,"س",2,0],["وإن رجائي فيك خيَّب نعمتي","فأضحتْ كإحدى الفاركاتِ النواشِص",26,"ص",1,0],["وإن راض للسلطان خشناءَ صعبةً","فناهيكَ روّاضا به ومروِّضا",27,"ض",2,0],["وأن ركايا الماء فيكم جَرورها","إذا كان في القوم الكرام نَزوعها",28,"ع",3,0],["وإن رضيتم رضينا عن مسالمكم","وإن غضبتم فنحن الشيعة الأنف",29,"ف",1,0],["وإن رفرفتْ يوماً عليك مُلمَّةٌ","فرفرف جبريل عليك وميكالُ",30,"ل",1,0],["وإن رمَى الدهرُ من يرمي صفاتَكمُ","ناديتُه لا رماك اللَّه بالشللِ",31,"ل",1,0],["وإن رمتَ من يُعنى به الحقّ والهوى","فإنك مخسوفٌ به أو مزلزلُ",32,"ل",1,0],["وإن رأى حيةً تهتزُّ في ركَبٍ","هوى لها بعصا موسى بن عمران",33,"ن",1,0],["وَإِن رَقَّ مِنّي مَنطِقٌ وَشَمائِلٌ","فَما هَمَّ مِنّي بِالقَبيحِ ضَميرُ",34,"ر",1,0],["وَإِن راقَ أَقواماً مِنَ الناس منطِقٌ","يرُقْ أَبَداً مني مَقالٌ وَأَفعالُ",35,"ل",1,0],["وَإِن رمتُ نَفسي كَيفَ آتي لِصَرمِها","وَرمتُ صدوداً ظَلَّتِ العَينُ تَدمَعُ",36,"ع",1,0],["وَإنّ رَحِيلاً وَاحِداً حَالَ بَيْنَنَا","وَفي المَوْتِ مِنْ بَعدِ الرّحيلِ رَحيلُ",37,"ل",1,0],["وَأنّ رِمَاحَ الخَطّ عَنْهُ قَصِيرَةٌ","وَأنّ حَديدَ الهِنْدِ عَنهُ كَليلُ",37,"ل",1,0],["وإن رُزقتَ فلا تأسف على أحد","بالفضل واحذر مصير البغي والبطرِ",38,"ر",1,0],["وإن رابتْ إساءتُه فَهبْهَا","لما فيه من الشِّيَمِ الحِسَانِ",39,"ن",1,0],["وإن رامَ بَرَّاً لم يدعْ سَرَعانُه","لساقتهِ في البَّرِ موقفَ راكبِ",40,"ب",1,0],["وَأَنَّ رِماحَنا تَأبى وَتَحمى","عَلى ما بَينَ عالِيَةٍ وَرومِ",41,"م",1,0],["وإن راحَ رُعيانُها أْطْرَبَتْكَ","فَواقِدُ أولادِها الثَّاغيه",42,"ي",2,0],["وإن رآه رقيقُ الوجهِ قال أَرِقْ","كأسَ الحياءِ بضَمٍّ أو ِبتَقْبيلِ",43,"ل",1,0],["وَأَنَّ رَحلي وَإِن أَوثَقتُهُ لَعَلى","مَطِيَّةٍ مِن مَطايا الحَينِ مَحمولُ",44,"ل",1,0],["وَأَنَّ رِجالَ النَفعِ تَحتَ مَداسِها","وَأَنَّ رِجالَ الضُرِّ فَوقَ سَنامِها",45,"ه",2,0],["وَإِن رَأى في بَيتِهِ فارَةً","بادَرَها بِالسَيفِ وَالتُرسِ",46,"س",1,0],["وَإِن رَكَزوا غِبَّ الطِعانِ رِماحَهُم","رَأَيتَ رُؤوسَ الأُسدِ فَوقَ الثَعالِبِ",47,"ب",1,0],["وإنَّ رَزايا العُمرِ مِنْهُنّ مركبي","ثقالٌ بأعطانِ المنايا مَبارِكُه",48,"ك",2,0],["وإن رُفعت فوق المفارق صَيّرَتْ","دبيبَ المنايا من مضاربها وثبا",49,"ب",2,0],["وَإِن رُمتُ أَمراً مُدبِرَ الوَجهِ إِنَّني","سَأَترُكُ حَظّاً في فِنائِكَ مُقبِلا",50,"ل",2,0],["وأنَّ رَوْحكِ رُحٌ تأنَسِينَ بها","إذا تململَ مَيْتٌ رُوْحُهُ نَكَد",51,"د",1,0],["وإن رميتَ بَنِي الدنيا بقُوَّتهِ","ردَّ العُبابَ دماً والأرضَ بُركانا",52,"ن",2,0],["وَإِن رابَت مَواقِفَها اللَيالي","فَمِن تاجيكَ يَنبَلِجُ اليَقينُ",53,"ن",1,0],["وإن راحَ يَسْتَسْقِي به الغيثَ مُسنِتٌ","تَقَشَّعَ عنه الجدبُ واطَّرَدَ الخِصْبُ",54,"ب",1,0],["وَإِن رَمى كانَ مَريضَ السَهمِ","ذا وَتَرٍ رِخوٍ ضَعيفِ الرَجمِ",55,"م",1,0],["وإنْ رَجَعُوا لأرْضِهِمْ بخَيْرٍ","فَلَمْ تَرَ كاتِباً إلاَّ حَزِينا",56,"ن",2,0],["وَإِن رَئيتُ الشُراةَ قَد طَلَعوا","أَلجَمتُ مُهري مِن جانِبِ الذَنَبِ",57,"ب",1,0],["وَإِن رَجَعتُ وَرائي","خَشيتُ زَأرَ أُسودِه",58,"د",2,0],["وَإِنَّ رِجالَ شَيبَةَ سادِنيها","إِذا راحَت لِكَعبَتِها الجِمارا",59,"ر",2,0],["وَإِن رُدِدتُ لِأَصلي","دُفِنتُ في شَرِّ تُربَه",60,"ب",2,0],["وَإِنَّ رِجالاً كانَ نَسرٌ لَدَيهِمُ","إِلهاً عَلَيهُم قَبلَنا طَلَعَ النَسرُ",61,"ر",1,0],["وَإِن رَأَيتَ هِزبَرَ الغابِ مُفتَرِساً","فَقَد يَكونُ زَماناً وَهُوَ فَرّاسُ",62,"س",1,0],["وَإِن رُزِقتَ النُهى فَأَنتَ عَلى ال","أَصحابِ حَليٌّ تَتَنازَعوهُ خُلَس",63,"س",1,0],["وَإِن رَأَيتَ الخَودَ مُختالَةً","يَصلُحُ أَن تُجعَلَ شَمّامَه",64,"م",2,0],["وَإِن رُقِّيَ الفَتى رُتَبَ المعالي","فَمِثلُ هُبوطِهِ ذاكَ الرُقِيُّ",65,"ق",2,0],["وإن رُمْتُمَا منطِقاً من فَمي","ولم تسْمَعَاهُ فصيحاً فَصِيحَا",66,"ح",2,0],["وأن رضا الأيام عنهم خديعة","وأن مصافاة الليالي لهم مكر",67,"ر",1,0],["وإن ركبوا الجرد العتاقد لغارةٍ","بدَوْا في وثاقٍ ركب نوقٍ وجامل",68,"ل",1,0],["وَأَنَّ رُمُوزاً فِي الرِّقَاعِ يَخطُّهَا","تُقِرُّ مَكَانَ الفَتْحِ حَيْثُ يُشيرُ",69,"ر",1,0],["وأنَّ رأسي يمشي عليهِ","تِيهاً عَدُوٌّ لهُ لَدود!",70,"د",1,0],["وأن راحَ سوطُ الذُّلِ يُلهب أمةً","كراهِيَةً يستاقُها وطَواعا",71,"ع",2,0],["وأنَّ رَوْحَكِ رُوحٌ تأنَسِينَ بها","إذا تململَ مَيْتٌ رُوحُهُ نَكَدُ",72,"د",1,0],["وأن رمت صبراً أو سلواً بغيرها","رأيت جميع الناس من دونها بعضا",73,"ض",2,0]]}