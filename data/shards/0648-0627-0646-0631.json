aldiwan.net/poem56141.html","البسيط"],[458,"وخرقاء معرقة في الضلال","https://www.aldiwan.net/poem56224.html","المتقارب"],[461,"يا باذل المال في عدم وفي سعة","https://www.aldiwan.net/poem15323.html","البسيط"],[461,"اذا افتخرت عليا ربيعة بالذي","https://www.aldiwan.net/poem15413.html","الطويل"],[461,"شربت دما ان حال ودي ساعة","https://www.aldiwan.net/poem15480.html","الطويل"],[461,"تقيل نوشروان بعد ذهابه","https://www.aldiwan.net/poem16034.html","الطويل"],[461,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[464,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[464,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[468,"أرض إله السماء عنك بما","https://www.aldiwan.net/poem59911.html","المنسرح"],[468,"لا تبع المعروف بالمنكر","https://www.aldiwan.net/poem59972.html","السريع"],[477,"على البان قمرية تسجع","https://www.aldiwan.net/poem15215.html","المتقارب"],[493,"وإن رأى المتناهى من سيادته","https://www.aldiwan.net/poem67397.html","البسيط"],[500,"أتانا من صبا نجد نسيم","https://www.aldiwan.net/poem37783.html","الوافر"],[514,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[529,"سلوا الناس من قد قام مثل مقامي","https://www.aldiwan.net/poem37141.html","الطويل"],[529,"وفود حبيب أم ورود عهاد","https://www.aldiwan.net/poem37457.html","الطويل"],[529,"مسامع من ناديت يا عمرو سدت","https://www.aldiwan.net/poem37501.html","الطويل"],[551,"دع الغنى لبنيه","https://www.aldiwan.net/poem47302.html","المجتث"],[551,"لنا من ثناياك الغريض المرشف","https://www.aldiwan.net/poem47403.html","الطويل"],[551,"أيا ملك الأملاك قد جاءني الذي","https://www.aldiwan.net/poem47842.html","الطويل"],[558,"نحن معاني الوجود فيه","https://www.aldiwan.net/poem33671.html","مخلع البسيط"],[558,"في الكلب عشر خصال كلها حمدت","https://www.aldiwan.net/poem33800.html","البسيط"],[558,"أنا المعروف لي بالله ألوان","https://www.aldiwan.net/poem33827.html","الهزج"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[573,"حدثني الشوق عن تباريحي","https://www.aldiwan.net/poem3653.html","المنسرح"],[575,"سواي يخاف الدهر أو يرهب الردى","https://www.aldiwan.net/poem2749.html","الطويل"],[575,"أيدفعني الدهر عن مطلبي","https://www.aldiwan.net/poem2750.html","المتقارب"],[575,"دع قضب نعمان أو كثبان يبرين","https://www.aldiwan.net/poem2851.html","البسيط"],[586,"خذوا خبرا عن نظم دمعي ونثره","https://www.aldiwan.net/poem17548.html","الطويل"],[587,"تعلم ففي العلم الشريف فوائد","https://www.aldiwan.net/poem11508.html","عموديه"]],"verses":[["وَإِنَّ رِباطَ بَني مالِكٍ","تُقادُ إِلى المَوتِ أَرسانُهُ",0,"ن",2,0],["وَإِنَّ رَجائي زَينَ مِلَّةِ هاشِمٍ","لَنُعمى وَحَسبي مِن جَوادٍ وَمُنعَمِ",1,"م",1,0],["وَإِن رامَ أَملاكَ البِلادِ بِفَتكَةٍ","مَشى الذُلُّ في تيجانِها وَالمَناطِقِ",2,"ق",1,0],["وَإِن رَكَضَ السُؤالُ إِلى نَداهُ","تَتَبَّعَ إِثرَ وَطأَتِهِ بِنُجحِ",3,"ح",1,0],["وَإِنَّ رُزأً رَماني","بِالبُعدِ عَنكِ لَصَعبُ",4,"ب",1,0],["وَإِن رامَ اِجتِناباً لَم يُطِقهُ","وَلا يَقوى المُحِبُّ عَلى اِجتِنابِ",5,"ب",1,0],["وَإِن رَأَوني بِخَيرٍ ساءَهُم فَرَحي","وَإِن رَأَوني بِشَرٍّ سَرَّهُم نَكَدي",6,"ي",1,0],["وإنْ راعَ دهْرٌ أو تنَكّرَ حادِثٌ","فلُذْ بحِمى منْ عامِرِ بْنِ محمَّدِ",7,"د",1,0],["وإنْ رُوِيَتْ عنْهُمْ عَوالي علائِهِمْ","فآثارُ عَلْياكَ الحِسانُ الصّحائِحُ",8,"ح",1,0],["وَإِن رَأَيتُم في يَدي زَهرَةً","فَإِنَّها مِن ذَلِكَ الغَرسِ",9,"س",1,0],["وَأَن رُكِزَت حَولَ الخُدورِ أَسِنَّةٌ","وَحَفَّت بِقُبِّ السابِحاتِ قِبابُ",10,"ب",1,0],["وَإِن رَمِدَت عَينايَ يَوماً كَحَلتُها","بِعَينَيكِ لَم أَبغِ الذَرورَ مِنَ الكُحلِ",11,"ل",1,0],["وَإِن رَزَحَ الْحَمَّالَ مِنْ وِقْرِ حِمْلِهِ","أَيُلْقِيهِ عَنْهُ أَمْ يُطَاوِعُ لُوَّمَا",12,"م",2,0],["وَأَن رَبَّ أَمثالِ البَلايا مِنَ السُرى","مُضِرٌ بِها الإِدلاجُ لَولا نِعالُها",13,"ل",3,0],["وَإِن رَفَعوا الذَميل لَقينَ مِنهُ","هَواناً حينَ يَرتَكِبُ الذَميلا",14,"ل",2,0],["وَإِن رَدَّهُنَّ الرَكبُ راجَعنَ هِزَّةً","دَريجَ المَحالِ اِستَثقَلَتهُ المَحاوِرُ",15,"ر",1,0],["وإن رُدَّ سيف الملك صوناً لغمدهِ","فقد سُلَّ من غمد الخلافة مُرْهَفُ",16,"ف",1,0],["وإن راعَ قلبَ الدين نعيُ إمامه","فقد هُزَّ منه بالبشارة مَعْطَفُ",16,"ف",1,0],["وإن رقيت نحو السماء فحبّذا","إذا أصبحت مأوىً لها الأنجم الزهر",17,"ر",1,0],["وَإن رَفَعُوا مَنَاسِبَهُم رَفَعنَا","إِلَى مُضَرَ الَّتي لاَ يَجهَلُونَا",18,"ن",2,0],["وَإِنَّ رِجالاً ما اِبنَكُم كَاِبنِ أُختِهِم","حَرِيّونَ أَن يُقضى لَهُم وَيُهابوا",19,"ب",3,0],["وإن رأيت قدّه العالي فصف","وقف على المنصوبِ منه بالألف",20,"ف",1,0],["وَإِن رُمتُ فَوقاً أَنتَ في الفَوقِ فَوقُهُ","وَإِن رُمتُ تَحتاً أَنتَ كُلُّ مَكانِ",21,"ن",1,0],["وإن رمت الحجامة فالثلاثا","فذاك اليوم مهراقُ الدماءِ",22,"ا",2,0],["وإن رام امرؤٌ يوماً دواءً","فنعم اليومُ يوم الأربعاءِ",22,"ا",2,0],["وإن رَجَوْا أخرى فمن قولهم","أفْلَحَ هذا الغائب الآيِبُ",23,"ب",1,0],["وإن رام من حَدِّ البطيحة مَطلعاً","ثَنَتْ شأوَهُ عنه المواصير والجِسر",24,"ر",1,0],["وإن رأى أو أحس آونةً","دخانَ نارٍ لجاره كَبَسَهْ",25,"س",2,0],["وإن رجائي فيك خيَّب نعمتي","فأضحتْ كإحدى الفاركاتِ النواشِص",26,"ص",1,0],["وإن راض للسلطان خشناءَ صعبةً","فناهيكَ روّاضا به ومروِّضا",27,"ض",2,0],["وأن ركايا الماء فيكم جَرورها","إذا كان في القوم الكرام نَزوعها",28,"ع",3,0],["وإن رضيتم رضينا عن مسالمكم","وإن غضبتم فنحن الشيعة الأنف",29,"ف",1,0],["وإن رفرفتْ يوماً عليك مُلمَّةٌ","فرفرف جبريل عليك وميكالُ",30,"ل",1,0],["وإن رمَى الدهرُ من يرمي صفاتَكمُ","ناديتُه لا رماك اللَّه بالشللِ",31,"ل",1,0],["وإن رمتَ من يُعنى به الحقّ والهوى","فإنك مخسوفٌ به أو مزلزلُ",32,"ل",1,0],["وإن رأى حيةً تهتزُّ في ركَبٍ","هوى لها بعصا موسى بن عمران",33,"ن",1,0],["وَإِن رَقَّ مِنّي مَنطِقٌ وَشَمائِلٌ","فَما هَمَّ مِنّي بِالقَبيحِ ضَميرُ",34,"ر",1,0],["وَإِن راقَ أَقواماً مِنَ الناس منطِقٌ","يرُقْ أَبَداً مني مَقالٌ وَأَفعالُ",35,"ل",1,0],["وَإِن رمتُ نَفسي كَيفَ آتي لِصَرمِها","وَرمتُ صدوداً ظَلَّتِ العَينُ تَدمَعُ",36,"ع",1,0],["وَإنّ رَحِيلاً وَاحِداً حَالَ بَيْنَنَا","وَفي المَوْتِ مِنْ بَعدِ الرّحيلِ رَحيلُ",37,"ل",1,0],["وَأنّ رِمَاحَ الخَطّ عَنْهُ قَصِيرَةٌ","وَأنّ حَديدَ الهِنْدِ عَنهُ كَليلُ",37,"ل",1,0],["وإن رُزقتَ فلا تأسف على أحد","بالفضل واحذر مصير البغي والبطرِ",38,"ر",1,0],["وإن رابتْ إساءتُه فَهبْهَا","لما فيه من الشِّيَمِ الحِسَانِ",39,"ن",1,0],["وإن رامَ بَرَّاً لم يدعْ سَرَعانُه","لساقتهِ في البَّرِ موقفَ راكبِ",40,"ب",1,0],["وَأَنَّ رِماحَنا تَأبى وَتَحمى","عَلى ما بَينَ عالِيَةٍ وَرومِ",41,"م",1,0],["وإن راحَ رُعيانُها أْطْرَبَتْكَ","فَواقِدُ أولادِها الثَّاغيه",42,"ي",2,0],["وإن رآه رقيقُ الوجهِ قال أَرِقْ","كأسَ الحياءِ بضَمٍّ أو ِبتَقْبيلِ",43,"ل",1,0],["وَأَنَّ رَحلي وَإِن أَوثَقتُهُ لَعَلى","مَطِيَّةٍ مِن مَطايا الحَينِ مَحمولُ",44,"ل",1,0],["وَأَنَّ رِجالَ النَفعِ تَحتَ مَداسِها","وَأَنَّ رِجالَ الضُرِّ فَوقَ سَنامِها",45,"ه",2,0],["وَإِن رَأى في بَيتِهِ فارَةً","بادَرَها بِالسَيفِ وَالتُرسِ",46,"س",1,0],["وَإِن رَكَزوا غِبَّ الطِعانِ رِماحَهُم","رَأَيتَ رُؤوسَ الأُسدِ فَوقَ الثَعالِبِ",47,"ب",1,0],["وإنَّ رَزايا العُمرِ مِنْهُنّ مركبي","ثقالٌ بأعطانِ المنايا مَبارِكُه",48,"ك",2,0],["وإن رُفعت فوق المفارق صَيّرَتْ","دبيبَ المنايا من مضاربها وثبا",49,"ب",2,0],["وَإِن رُمتُ أَمراً مُدبِرَ الوَجهِ إِنَّني","سَأَترُكُ حَظّاً في فِنائِكَ مُقبِلا",50,"ل",2,0],["وأنَّ رَوْحكِ رُحٌ تأنَسِينَ بها","إذا تململَ مَيْتٌ رُوْحُهُ نَكَد",51,"د",1,0],["وإن رميتَ بَنِي الدنيا بقُوَّتهِ","ردَّ العُبابَ دماً والأرضَ بُركانا",52,"ن",2,0],["وَإِن رابَت مَواقِفَها اللَيالي","فَمِن تاجيكَ يَنبَلِجُ اليَقينُ",53,"ن",1,0],["وإن راحَ يَسْتَسْقِي به الغيثَ مُسنِتٌ","تَقَشَّعَ عنه الجدبُ واطَّرَدَ الخِصْبُ",54,"ب",1,0],["وَإِن رَمى كانَ مَريضَ السَهمِ","ذا وَتَرٍ رِخوٍ ضَعيفِ الرَجمِ",55,"م",1,0],["وإنْ رَجَعُوا لأرْضِهِمْ بخَيْرٍ","فَلَمْ تَرَ كاتِباً إلاَّ حَزِينا",56,"ن",2,0],["وَإِن رَئيتُ الشُراةَ قَد طَلَعوا","أَلجَمتُ مُهري مِن جانِبِ الذَنَبِ",57,"ب",1,0],["وَإِن رَجَعتُ وَرائي","خَشيتُ زَأرَ أُسودِه",58,"د",2,0],["وَإِنَّ رِجالَ شَيبَةَ سادِنيها","إِذا راحَت لِكَعبَتِها الجِمارا",59,"ر",2,0],["وَإِن رُدِدتُ لِأَصلي","دُفِنتُ في شَرِّ تُربَه",60,"ب",2,0],["وَإِنَّ رِجالاً كانَ نَسرٌ لَدَيهِمُ","إِلهاً عَلَيهُم قَبلَنا طَلَعَ النَسرُ",61,"ر",1,0],["وَإِن رَأَيتَ هِزبَرَ الغابِ مُفتَرِساً","فَقَد يَكونُ زَماناً وَهُوَ فَرّاسُ",62,"س",1,0],["وَإِن رُزِقتَ النُهى فَأَنتَ عَلى ال","أَصحابِ حَليٌّ تَتَنازَعوهُ خُلَس",63,"س",1,0],["وَإِن رَأَيتَ الخَودَ مُختالَةً","يَصلُحُ أَن تُجعَلَ شَمّامَه",64,"م",2,0],["وَإِن رُقِّيَ الفَتى رُتَبَ المعالي","فَمِثلُ هُبوطِهِ ذاكَ الرُقِيُّ",65,"ق",2,0],["وإن رُمْتُمَا منطِقاً من فَمي","ولم تسْمَعَاهُ فصيحاً فَصِيحَا",66,"ح",2,0],["وأن رضا الأيام عنهم خديعة","وأن مصافاة الليالي لهم مكر",67,"ر",1,0],["وإن ركبوا الجرد العتاقد لغارةٍ","بدَوْا في وثاقٍ ركب نوقٍ وجامل",68,"ل",1,0],["وَأَنَّ رُمُوزاً فِي الرِّقَاعِ يَخطُّهَا","تُقِرُّ مَكَانَ الفَتْحِ حَيْثُ يُشيرُ",69,"ر",1,0],["وأنَّ رأسي يمشي عليهِ","تِيهاً عَدُوٌّ لهُ لَدود!",70,"د",1,0],["وأن راحَ سوطُ الذُّلِ يُلهب أمةً","كراهِيَةً يستاقُها وطَواعا",71,"ع",2,0],["وأنَّ رَوْحَكِ رُوحٌ تأنَسِينَ بها","إذا تململَ مَيْتٌ رُوحُهُ نَكَدُ",72,"د",1,0],["وأن رمت صبراً أو سلواً بغيرها","رأيت جميع الناس من دونها بعضا",73,"ض",2,0],["وأنّ رياضا هزّ لبنان فانتخت","شمائل في لبنان ميمونة غرّ",74,"ر",1,0],["وان رحابه السامى المباني","مقام الامن للمتبتلين",75,"ن",1,0],["وإن رددنا عن الأبواب جملتها","بباه رحمة منه يحيينا",76,"ن",2,0],["وإنْ رَحَلَ النَّهارُ تَرى نُجومًا","وأقمارًا، وشَمْسًا هاشِمِيَّةْ",77,"ي",2,0],["وإن رمت اخفاء البلابل والجوى","تبوح دموعى بالذي كنت مخفيا",78,"ي",2,0],["وإن رامه سِلقُ الضراغم بَرَّه","ويحمى من الأسد الضوارى عرينَها",79,"ه",2,0],["وإن رَدَّ عَن قُربٍ فَالأقَوالُ خَمسَةٌ","فَالأكلُ بِإطلاَقٍ لَهُ ولِجَارِهِ",80,"ر",2,0],["وَإِن رُمتَ مِنهُ الخَطَّ قالَ تَكُبَّراً","لَقَد كُنتُ أُمِّياً مَفَخَّمَ شَانِ",81,"ن",1,0],["وَإِن رَامَ إنشَاءَ القَوَافي تَرَاهُ في","عَوَاصِى القَوافي حَاكِماً مُتَصَرِّفَا",82,"ف",2,0],["وإن رَفَعَ السَّرابُ على تَنَاءِ","بَلاَدكِ ظَلتُ مُرتَقِبَ السَّرَابِ",83,"ب",1,0],["وإن رَاءَ الهُوَينَا نَارَعَنها","نَوارَ الدَّلوِ صَرَّمَتِ الرَّشَاءَ",84,"ا",2,0],["وإن رويتُ أحاديثَ الذين نأَوا","فعَنْ نسيم الصَّبا والبرقِ إسنادي",85,"د",2,0],["وَإِنَّ رِجالاً فيكَ شَكَّت قُلوبُهُم","أُلئِكَ قَومٌ عَن سَبيلِ الهُدى صَدّوا",86,"د",3,0],["وإن رمت فقه الأصبحيّ فعج على","مجالسنا تشهد لواء العنا دوا",87,"و",2,0],["وَإِنْ رُمْتُ كِتْمانَ الهَوى نَطَقَتْ بِهِ","بَوَادِرُ دَمْعٍ سُحْبُهُنَّ جُفُونُ",88,"ن",1,0],["وإن راجيك دون الناس أحذرهم","بأن يعود بما قرّت نواظره",89,"ر",2,0],["وإن ركعت رماح الخط فيهم","خررن لها الجماجم ساجدات",90,"ت",1,0],["وإن رجالا بعده عن إلههم","تلقوا علوما كالبحار الزواخر",91,"ر",1,0],["وإن رسول الله يأتي وراءه","من الصين من يعلوه عند التفاخر",91,"ر",1,0],["وان رسول الله والصحب جلهم","قد انتشروا خلف المولى المبادر",91,"ر",1,0],["وَإِن رَأَيتَ نارَ حَربٍ تَلتَظي","فَاِعلَم بِأَنّي مُسعِرٌ ذاكَ اللَظى",92,"ا",1,0],["وإنْ رزقتَ في الملاهي نَفسَاً","فعُدَّ كُلَّ العُمرِ ذاك النَفَسا",93,"س",2,0],["وإِن رُمتَ فيهم دَفعَ ضَيمٍ وَنُصرَةٍ","بِهِم رُمتَ أَو شالاً مِنَ اِصطُمَّةِ الرَملِ",94,"ل",1,0],["وَإِن رُبِطَت بَينَ القِبابِ جِيادُهُ","فَهُنَّ بِأَكبادِ المُلوكِ جَوائِلُ",95,"ل",1,0],["وَإِن رَحَلَ الأَحياءُ عَن قُربِ مَنزِلٍ","لِخَوفٍ بَنوا في جَوِّهِ وَأَقامُوا",96,"م",3,0],["وإن رغِب المسكين عنهم بزهده","يقولون غَثٌّ بارد متثاقل",97,"ل",1,0],["وإن رام شَرّا جَسَّروه لفعله","وإن كان فيه تُستباح المَقاتل",97,"ل",1,0],["وإن رأوا حسنا أبدوه وابتهجوا","إخوان صدق لمن أخلاقهم عرفا",98,"ف",2,0],["وإن رمت غلق الباب ابدي تغضّبا","وأوما بشرّ حرّه متحرّد",99,"د",1,0],["وإن رحتُ أُمليهِنَّ ودَّ عُطاردٌ","لحسن معانيهنَّ لو كان كاتبي",100,"ب",2,0],["وإنَّ رخيصاً كل قولٍ وإن غلا","لملكِ بلادٍ تربهنَ من التبرِ",101,"ر",1,0],["وان رمت وردا وافر الجود وافيا","فدونك هذا البحر يا قاصدا مصرا",102,"ر",2,0],["وإن رمت وصلا منكم فوصالكم","مكانَ الثُرَيا من يُطِيقُ لها قَبْضا",103,"ض",2,0],["وَإِن رامَهُ سِربُ المَسَرّاتِ لم يَجِد","مَحَلّاً بهِ من لاعجِ الهَمِّ خاليا",104,"ي",2,0],["وَإن رُمتما لي بِالمَلامِ سَلامةً","أَرِفقُكُما يُرضى صِيالَ حُسامي",105,"ي",1,0],["وإن رامَ غَدْرا أَظهرَ اللّه سِرَّه","عليه وأَبدَى كلَّ ما هو كاتمُ",106,"م",1,0],["وإن روّحتني حادثات خطوبه","دهتني بِإلْفٍ أو بضرّ صديق",107,"ق",1,0],["وإن رَجَعْتُ إلى قلبي لأعذِله","وجدته باختياري ذاب واحترقا",108,"ق",2,0],["وإن رنا نحوك السَقامُ فقد","عاد غضيضَ الجفونِ والنظر",109,"ر",1,0],["وإن رُمتُ تقريظاً لغيرك عاقَنِي","لساني ورَاح القولُ فيه يُكذَّب",110,"ب",1,0],["وإن رَمتْنا الخُطوبَ عن عُرُضٍ","فاضَ نزارٌ فَجلاّها",111,"ا",3,0],["وأن رسول الله أحمد خيرهم","وأفصحهم عند البلاغ وأبرع",112,"ع",1,0],["وإن رُمت من أخلاقه ذكر بعضها","فتلك من المسك المعنبر أضوع",112,"ع",1,0],["وإن رمت عزاً شاملاً وصيانة","وعوناً على الدنيا بجانبه لُذ",113,"ذ",1,0],["وإن ربحت تجارته وزادت","بدنياه عواقبه المخاسر",114,"ر",1,0],["وان رجوت السوى جهلا بلا صلةٍ","فقد تقدمني من يعبد الوثنا",115,"ن",2,0],["وإن رَشفتُ الرِّضابَ أسكرَني","كأن خمراً دَبّت حميَّاها",116,"ا",3,0],["وإنّ رغيفَ الخبزِ أصعبُ خلسهُ","من الثروةِ الكبرى فكن سارقاً أمهر",117,"ر",1,0],["وإن ركِبوا الجردَ اليعابيبَ سابَقت","خيولَ المنايا والدّواهي دَواهم",118,"م",1,0],["وأنِر لهُم سُبُلاً عليها دَمعُهم","يَنهَلُّ وامزُج مزنة بضياء",119,"ا",2,0],["وان رأت الاعداء كيف تكيدني","فخذها بكف الكف من حيث لا أَدري",120,"ي",1,0],["وان رسول اللَه من مكة سرى","الى القدس وَالروح الامين سمير",121,"ر",1,0],["وإنْ رَقَّقْتُ مِنهُ عَن صَبُوحٍ","فَريقَتُها مُعَتَّقَةٌ شَمولُ",122,"ل",1,0],["وَإِن راقَتكَ بَزَّتُهُ","فَكَالدفلى أَكنَسى نَورا",123,"ر",2,0],["وإن رأَيتَ هفوَه","فاِنصحهُمُ في خَلوَه",124,"ه",1,0],["وإن رأَيت وَهنا","فلا تَسُمهم طعنا",124,"ن",2,0],["وإِن رمت لي فخراً عددتُ من العُلى","مزايا عظاماً لا عظاماً بواليا",125,"ي",2,0],["وإِن رُمتُ إِطفاءً لنار تلهُّفي","عليكَ غَدا حُزني لها أَبَداً يُذكي",126,"ك",2,0],["وإنْ رآني مقبلاً","رَفْرَفَ زنديه وَمدّ",127,"د",1,0],["وَإِن رُمتَ أَن تَحظى بِقَلبٍ مُنَوَّرٍ","نَقِيٍّ عَنِ الأَغيارِ فَاِعكِف عَلَيَّ الذِكرِ",128,"ر",1,0],["وَإِن رُمتَ أَمراً فَاِسأَلِ اللَهَ إِنَّهُ","هُوَ المُفَضَّلُ الوَهّابُ لِلخَيرِ وَالوَفرِ",128,"ر",1,0],["وإن رسول الله من غير مرية","إمام على الإطلاق في كل حضرة",129,"ه",1,0],["وَإِن رَحَلتَ إِلى مَلكٍ لِتَمدَحَهُ","فَاِرحَل بِشِعرٍ نَقِيٍّ غَيرِ مَخشوبِ",130,"ب",1,0],["وإن راودت قلبي الأماني تمثلت","له مدية خرقاء في كفّ جازر",131,"ر",1,0],["وَإِن رَمَيتَ بِها في طامِسٍ دَأَبَت","إِذا تَرَقرَقَ آلٌ بَعدَ رَقراقِ",132,"ق",1,0],["وإنْ رَوِيَتْ نُحورُهمُ دِماءً","روَيْنَ نُحورَنا دَمْعاً سِجاما",133,"م",2,0],["وَإِن رابَتكَ أَقوالي فَإِنّي","حَمَلتُ وَقارَهُ وَحَمَلتُ وِقرَه",134,"ر",2,0],["وإِن رأَيتُم عَرَضاً سالِماً","قُلتُم لِعرضٍ ليسَ بالسَّالِمِ",135,"م",1,0],["وإن رامَها ملكٌ قبلَهُ","سعَت لي إلى قَلبهِ تَشفَعُ",136,"ع",1,0],["وَان رجعتُ إِلى يومِ الغَديرِ وَكم","من مَفخرٍ فيهِ أَحكيهِ وَأَرويهِ",137,"ي",2,0],["وإنْ رأينا خياناتٍ تؤرِّقُن","من بعضنا ، ورأينا خائناً عَاقَا",138,"ق",2,0],["وإنْ رُتَبُ العليا فخزنَ بماجدٍ","فَحَسْبُ العُلَى فخراً بأنّي لها ربُّ",139,"ب",1,0],["وإن رأيت جميلاً فافشه كرما","وإن رأيت قبيحاً كن كذي صمم",140,"م",1,0],["وإن رمت إبراز الأدلة في الذي","تريد فما تدعو إليه تجاب",141,"ب",1,0],["وَإِن رمت أَن أَثني عَلَيكَ بِغَيرِهِ","فَماليَ في كُلِّ الأَنامِ مُساعِدُ",142,"د",1,0],["وَأَنَرتَ ما سدت أَكفَّ جِيادِهِ","وَهتكت ما نسجَت يَدا زِرادِهِ",143,"د",2,0],["وَإِن رَأيتَ رحاً لِلحرب دائِرَةً","كانوا لها دون هَذا الخلق كالقُطُبِ",144,"ب",1,0],["وإنَّ رضاباً قد سَقَتْنيه مرَّةً","على غفلة الواشين في أيمن الجزع",145,"ع",1,0],["وإنْ رابه منِّي أوامٌ أَبَلَّه","وكمْ بلَّ يوماً غُلَّتي وأوامي",146,"ي",1,0],["وإنْ رقمت فوق الأَنام حنادسٌ","جَلَيْتَ من الرَّأي السَّديد لها فجرا",147,"ر",2,0],["وإن رمت عزماً فهو سحبان همةٍ","وإن رمت حزما انه",148,"ه",1,0],["وإِنْ رَأَى حالَتِي غَيْرِي تَنَاشَدَها","مِنَ الخُسارَةِ سُوءُ الكَيْلِ والحَشَفُ",149,"ف",1,0],["وإَن رَمَتْني الليالي","يوماً بدَاهٍ أُدَاهِنْ",150,"ن",1,0],["وإن روى الأخبارَ منْ","مُرسِلِها والمسنَّدِ",151,"د",1,0],["وإن ركعتْ بيضُ الظُبى في أكفّهمْ","بحَرْب فهاماتُ الأعادي سواجِدُ",152,"د",1,0],["وإن رمتم وردا فها فيض عبرتي","لعيسكم إن مسها ظمأ ورد",153,"د",1,0],["وإِنْ رَضُوا أَشرقَ الليلُ البهِيمُ بِهِمْ","ويكشِفُ الموتُ عن ساقٍ إِذَا أَنِفُوا",154,"ف",3,0],["وإِن راعتِ الأرضُ منهم جنوباً","تسلَّوا برعيِ نجومِ السماءِ",155,"ا",2,0],["وإِنْ رَضِيَتْكَ لتاجِ البقاءِ","فأَنتَ الرَّفِيعُ بهِ والعَمِيمُ",156,"م",1,0],["وإِنْ رُدَّ زَحْفُ الخَيْلِ مِنْكَ بِأَنَّةٍ","فأَعْداؤُها رَهْنٌ بِكَرِّ زُحُوفِها",157,"ف",3,0],["وإِنْ رَجَعَتْ عن صِدْقِ وَعْدِكَ بُرْهَةً","حواجِبُ آمَالِ الغَرِيبِ بِصُوفِها",157,"ف",3,0],["وإِنْ رآهُ الهلالُ مُطَّلِعاً","يقول ربِّي وربُّكَ اللهُ",158,"ه",1,0],["وإن رأيي فرأي المسلمين ولو","هداك عن ذا ترى منهما افترقا",159,"ق",2,0],["وإن ركبت لليل بطن جارية","أو ظهر زيافة فهرية نجد",160,"د",1,0],["وإن رزق الإنسان طاعة ربه","تقلد سيفاً من يد اللَه مايزا",161,"ز",2,0],["وإن رمنا سؤالك يا كريم","ذكرناها فابلسنا خناها",162,"ا",3,0],["وإن رفعت عنه بغيب ذميمةٍ","وناشد عنها من وفاه خفيها",163,"ي",3,0],["وإن رشفت تطوف بكل ذهن","وتبدعه الطروب العبقريا",164,"ي",2,0],["وأن رُفِعَتْ صيفيّةٌ حَلَبِيَّةٌ","تحلُّ حُلولَ الطيف ثم تبينُ",165,"ن",1,0],["وإن ركب السريرَ وزيرُ ملك","رأيت التاجَ تَشرفُهُ العِمامَهْ",166,"م",2,0],["وإن ركبتَ خطَر البيد معي","ركوبَ من لا يستشير إن عزَمْ",167,"م",1,0],["وإن ريع جار أو تنكَّر منزلٌ","فربَّ جنابٍ للحسين مَريعِ",168,"ع",1,0],["وإن رأى ربها نِشدانها وقعت","في جانبٍ لم يُعرِّف أهلَه اللُّقطا",169,"ط",2,0],["وإن رَشَفَتْ ريقَها ألسُنٌ","وقاءَتْ ففي القيءِ أكبادُها",170,"د",3,0],["واِنْ رضيتُ به فالذلُّ منقَصةٌ","وكم تكلَّفتُه حملاً فلم اُطِقِ",171,"ق",1,0],["واِن رحتُ كالهنديِّ من غير ساعد","فعارٌ على الأبطال جهلُ البَواترِ",172,"ر",1,0],["وانْ رحُتُ الاَّ حامداً غير أنني","أَخو حالةٍ اِن لم أقل نطقتْ قبلي",173,"ل",2,0],["وأنَّ رَجائي في مَساعيهِ ضِلَّةٌ","ولم يبقَ منه غيرُ موقفِ راكبِ",174,"ب",1,0],["وإن رأوا بخس فضلي حقَّ قيمته","فالدرُّ دُرٌّ وإنْ لم يُشرَ بالقيمِ",175,"م",1,0],["وأن راسلته جياد العقول فات","مدى شوطها بالتأني",176,"ي",1,0],["وإن ركبوا الخيلَ العتاق لغايةٍ","رأيتَ عصابَ الأسدِ فوقَ الأجادل",177,"ل",1,0],["وَإِن رَكِبتَ الصوابَ مِنكَ فَلا","تَسِر بِهِ في مَسالِكِ الغَلَطِ",178,"ط",1,0],["وَإِن رَأَيتَ الإِثمَ في مَوسِمٍ","فَلا تُزايِد فيهِ مَن يَشتَري",179,"ي",1,0],["واِن ردَّدَ الركبُ ذكرَ الهوى","سَرَتْ والطريقُ بها مَهْيَعُ",180,"ع",1,0],["وَإِن رَأى المُتَناهى مِن سِيادَتهُ","إِلى المَحلِ الَّذي لَم يرقَهُ أَحَدُ",181,"د",1,1],["وأَنٍّ راح يتبعُهُ حَنينٌ","أَتى بعجائِبِ الأَلَمِ الأَليمِ",182,"م",1,0],["وإنْ رأيتَ بُدورَ الحيِّ وهي بهِم","فحيِّ بالسّرّ عنّي وجهَ أحياها",183,"ا",3,0],["وَإنَّ رَجائي أَنْ يُنَجِّزَ خالِقي","كَلامِي بِسَعْيٍ فَهْوَ جُلُّ مَرامِي",184,"ي",1,0],["وإنْ رُمْتُهُ يَجْري عَلَى ما أُريدُهُ","جَرَى جَامِحاً مُغْرىً بِشَوْطِ شِرادِ",185,"د",1,0],["وإنْ رُمْتَ فَكَّ الأَسْرِ عَنْها تَمَنَّعَتْ","وقالَتْ دَعونِي في الإسارِ ونِسْعَتي",186,"ي",1,0],["وإنْ رآك حريصاً","عليه يوماً تولّى",187,"ل",2,0],["وإنْ ركبوا ظهراً من الفخر أردفوا","وإِنْ طلبوا شيئاً من الذّكر ألْحَفوا",188,"ف",3,0],["وَإِن رامَ دَهرٌ أَن يسوءَك صرفُه","فأصغى بمصلومٍ وعضّ بأدْرَدِ",189,"د",1,0],["وإن رأيناه لا نراه","إذ نحن في رتبة تليه",190,"ي",2,0],["وإن رأى الأكل أضحى واقفاً تره","يرنو إليك كأخلاق المساكينا",191,"ن",2,0],["وإن رمتم لشرع إن تقيموه","على مثلي لكم قد قام ميزان",192,"ن",1,0],["وإن ركعوا مالوا إليه بكلهم","وصاروا لديه والقلوب خواضع",193,"ع",1,0],["وَأَنَّ روحُ الإِلهِ مُطَّلِعٌ","عَلى المُحِبّينَ في التَراويحِ",194,"ح",1,0],["وإِنَ رَفَعَ المقدارُ أَو وَضَعَ النَّدى","فمنه يرجَّى الجدُّ أَو يُرْتَجى الجَدى",195,"د",2,0],["وإِنْ رُمْتُ أَسْهَلَ شَيْءٍ عليهِ","تَرَاهُ يصلِّي عَلى أَشْعَبِ",196,"ب",1,0],["وإِن رأَيتَ انصرافي في تَعَشُّقِه","تعمّداً فالتَّثَنِّي منه يُثنِيني",197,"ي",1,0],["وَإِنْ رُمْتُمُ وَصْفِي بَدِيعَ جَمالِهِ","فَأَيْسَرُ مَا فِيهِ الجمالُ بِأَسْرِهِ",198,"ر",2,0],["وإن رمت مالاً كان في العلم كسبه","ففز بالرضا واختر لما هو أوفق",199,"ق",1,0]]}