ewPoem.aspx?id=129888",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5741,"لله ليالٍ أقبلت بالنعم","https://www.poetsgate.com/ViewPoem.aspx?id=187439",""],[5937,"قهوةُ البلابِلْ","https://www.poetsgate.com/ViewPoem.aspx?id=211802",""],[5956,"بالجدِّ باركْ يا إلهُ وآلِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=192094",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6102,"بَرزَخُ الأُمنِيات !!","https://www.poetsgate.com/ViewPoem.aspx?id=183167",""],[6102,"لحم ودم","https://www.poetsgate.com/ViewPoem.aspx?id=184863",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6259,"إن الحمولَ غداة َ غربة غربِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59356&r=&rc=4",""],[6277,"بالجميل اللذيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64477&r=&rc=40",""]],"verses":[["بِالجَدِّ لا بِالمَساعي يُبلَغُ الشَرَفُ","تَمشي الجُدودُ بِأَقوامٍ وَإِن وَقَفوا",0,"ف",3,1],["بالجُرْدِ تَمتاحُ العَجاجَ وغِلْمةٍ","في الغابِ منْ أسَلِ القَنا كأُسودِ",1,"د",1,0],["بِالجانِبِ الغَربِيِّ فَو","قَ النيلِ وَالدُنيا نَعيمُ",2,"م",1,0],["بالجفان التي بها يترك الجو","ع قتيلاً ويفثأ الزمهريرا",3,"ر",2,1],["بالجفنِ والصدغِ يا عنائي","هذا سقيم وذا مشوش",4,"ش",1,0],["بالجنك من مغنى دمشق حمائمٌ","في دَفّ أشجا تشوق بلطفها",5,"ه",2,1],["بالجِلْد أندابْ دهرٍ لست أنكرها","وما بعرضي لعمرُ اللَّه من نَدَب",6,"ب",1,0],["بالجانبِ الشرقي شمسٌ أشرقتْ","فتضاءلت شمسُ النهارِ خمولا",7,"ل",2,1],["بِالجَيشِ تَمتَنِعُ الساداتُ كُلُّهُمُ","وَالجَيشُ بِاِبنِ أَبي الهَيجاءِ يَمتَنِعُ",8,"ع",1,0],["بالجاهليةِ ممّا هِيضَ جانبُها","ما ليس يَنفذُ من همٍّ ومن وَصَبِ",9,"ب",1,0],["بِالجَمالِ البَديعِ إِلّا رَثَيتُم","لِشَجٍ مُثخَنٍ بِخَوفِ الوَعيدِ",10,"د",1,0],["بالجَفْنِ بارَزْتِ القُلوبَ وإنّما","بالنّصْلِ يَبْرُزُ كلُّ شَهْمٍ مِحْرَبِ",11,"ب",1,0],["بِالجِدِّ يَكْسِبُ فِي النُّفُوسِ مَهَابَةٌ","وَيُقِلُّ مَا شَاءَ الكَمَالُ دِعَابَا",12,"ب",2,0],["بِالْجَمَالِ الَّذي رَأَتْهُ فَكَانَا","آيَةُ المُبْصِرَاتِ وَالسَّامِعَاتِ",13,"ت",1,0],["بالجزء الأول من تفسير حكمته","حل المثاني وآي الذكر في الثاني",14,"ن",2,0],["بالجِزْعِ ذى السَّمُراتِ لى قمرٌ","غلبَتْ عليه سحائب الأزُرِ",15,"ر",1,1],["بِالجانِبِ الغَربِيِّ فيها نَخلَةٌ","ناءٍ جَناها وَهوَ آنٍ مونِعُ",16,"ع",1,0],["بِالجِدِّ تَثني الحادِثاتِ فَتَنثَني","وَالجِدُّ يَقتادُ الحَرونَ فَيَتبَعُ",17,"ع",1,0],["بالجد يرتفع اللبيب وغيره","من كان ذا حنف ومن هو أقطعُ",18,"ع",1,0],["بِالجِزعِ إِذ ثَبَتَت لَنا أَفراسُنا","وَسَوابِحٌ يَكبونَ لِلأَذقانِ",19,"ن",1,0],["بالجود الامثال فيه سارت","وما له في الورى مماثل",20,"ل",1,0],["بالجود قد اينعت واضحت","تمدها بالندى الانامل",20,"ل",1,0],["بالجود في الأوراق تثمر كلما","جادت لها يمناه بالانداء",21,"ا",2,0],["بالجود أقلامه قد اينعت وزهت","محاسنا وعطاياه لها ثمر",22,"ر",1,0],["بِالجِيادِ الأَعوَجِيّا","تِ وَبِالبيضِ الصِفاحِ",23,"ح",1,0],["بالجاعلين من المساجد ويحهم","سقفا يهد على الرؤوس مهيلا",24,"ل",2,0],["بالجامع الفاروق في عرفانهِ","من دار قولُ الحقّ في لسانهِ",25,"ه",1,0],["بِالجَوارِي المُنْشَآتِ لَهُمْ","جَرْيُ تَبْتِيرٍ وَتَبْتيلِ",26,"ل",1,0],["بِالجامِعِ الصَّحنُ وَلَكِنَّهُ","مِن كُلِّ ما يُؤكَلُ مَغسولُ",27,"ل",1,0],["بِالجودِ يَرحَضُ إِعساراً وَيُرخِصُ أَس","عاراً وَتَغلو لَدى عَلياهُ أَشعارُ",28,"ر",1,0],["بالجد ساع حاميا بل جاذبا","روح العوالم بالدهاء الفاعل",29,"ل",1,0],["بِالجودِ سادوا وَبِالإيثارِ قَد بَسَطوا","بَسَطَ الغِياثُ مَتى قامَت قِيامَتُهُ",30,"ت",2,0],["بِالجِدّ وَالجِدّ حاول ذَروَة الشرف","فَما لا عداك نَجم غَير منكسف",31,"ف",1,1],["بالجِّدِ والجَدِّ انتَجِعْ تَنَلِ المُنَى","فإنِ اجتزأْتَ بواحدٍ لم تَنْجَع",32,"ع",1,0],["بِالجودِ مِنهُ ناشِرُ أَجسادُهُ","بَعدَ البِلى وَالجودُ حَشرُ السُؤدَدِ",33,"د",1,0],["بالجفا أنتم بدأتم والنوى","ما أتانا مثل ما كان خطاب",34,"ب",1,0],["بالجُودِ أوصاني أبي فحفِظُتُهُ","أهلاً وسَهلاً بالّذي أوصى بِهِ",35,"ه",1,0],["بالجَيْش كالعارِضِ الأَحَمِّ إِذا","أَتْبَعَ في الجَوِّ بَرْقَه بَرَدَه",36,"د",2,0],["بالجودِ والمكارِم","فمثلُه لم يكُنِ",37,"ن",1,0],["بالجودِ مُغْتَبِقٍ بالحمدِ مُصْطَبِحٍ","فِي السَّبقِ منقطعٍ بالحِلْمِ مُتَّصِلِ",38,"ل",1,0],["بالجمعة الزهرا وسادس عشرة","من ذي جمادى الآخر المنساب",39,"ب",1,0],["بالجهل بت لدى الملا","مثلا من الأمثال سائر",40,"ر",1,0],["بالجودِ أحْيَيْتُمو الدُّنيا وضَرَّتَها","فباللِّقاءِ عَلينا ساعةً جودوا",41,"د",3,0],["بالجِدِّ نلتُ الّذي بلغتُ ولم","تعملْ إليه كفّاً ولا قدما",42,"م",2,0],["بالجمع قرآنه والفرق أجمعه","فرقانه فتحقق فالمقام جلي",43,"ل",2,0],["بالجَذعِ بَعدَ الجَذعِ وَالتَلويحِ","وَالنَصِ بِالهاجِرَةِ الصَموحِ",44,"ح",1,0],["بِالجَدِّ وَالقَبصِ الَّذي لا يُنسَخُ","مِنّا فُحولٌ وَزَئيرٌ قُلَّخُ",45,"خ",1,0],["بالجِدِّ قَومٌ وقَومٌ بالجُدودِ لهُم","فخرٌ وهذا على الأمرَينِ يَشتَمِلُ",46,"ل",1,0],["بالجهل والكفر قد أرست معالمه","لا يعرف الناس إلا الكفر أزمانا",47,"ن",2,0],["بالجامع العمري سبلاً وقد","قالت لنا عنه بنو مصره",48,"ر",2,0],["بِالجُحفِ مِنكُم أَعظُمٌ عَبَقَ الثَّرَى","مِنها وَبِالدَّهناءِ مِنكُم أعظُمُ",49,"م",1,0],["بالجَدّ طوراً ثم بالجِدّ تارةٌ","كذاك جميعُ الناس في الجَدِّ والطَّلَبْ",50,"ب",1,1],["بالجد والتشمير أدركت العلى","وسواك عنها عاجز متخلفُ",51,"ف",1,0],["بِالجِدِّ حَتَّى تَخْفِضَ التَعْلِيسا","قالَتْ لِمَاضٍ لَمْ يَزَلْ حَدُوسا",52,"س",2,0],["بالجُفون اللَواتي يَرمين قَلبي","همت من قوس ما علمت اِنتشابه",53,"ب",2,0],["بالجانب الشرقي واد جنانه","محاسنها من جنة الخلد تسرق",54,"ق",1,0],["بالجنايا الحِمر نِشراكُم","وبالمعاني البيض تَشرُونا",55,"ن",2,0],["بالجود يوم الأخذ بالنواصي","بركن لا إله إلا اللّه",56,"ه",1,0],["بالجار والجار له حرمة","عليك والصاحب بالجنب",57,"ب",1,0],["بالجواهر والمظاهر والحرير","لين بات بدين مكسور اظْهَره",58,"ر",2,0],["بِالجِزعِ بَينَ الأَبرَقَينِ المَوعِدُ","فَأَنِخ رَكائِبَنا فَهذا المَورِدُ",59,"د",1,1],["بالجودِ أوجده بالكون حدّده","وبالتجلي يُغذيه ويرزقه",60,"ق",2,0],["بالجمعِ جاء من الذي أعطاكَه","ما سَلطَن المسؤول غير السائل",61,"ل",1,0],["بالجدول الصافي قد ارتوت النهى","وتنزهت برياضه الأبصار",62,"ر",1,1],["بِالجَهلِ والتَّشِبيهِ وَالتَّجسِيمِ والتَّ","بدِيعِ وَالتَّضلِيلِ وَالبُهتَانِ",63,"ن",1,0],["بِالجَدِّ فِي مِيرَاثِهِ وَكَلاَلَةٍ","وَبِبَعضِ أبوَابِ الرِّبَا الفَتَّانِ",63,"ن",1,0],["بالجِزع يومَ حَبَا لَنا أقرانُنَا","وسوابحٌ يكبُون للأذقَانِ",64,"ن",1,0],["بالجانب الشرقي شرقِ عُواجةٍ","نورٌ به تهدي الأنام فتهتدي",65,"د",2,0],["بالجوزاء ثم فاسر مِنهَا لِطَنَب","في مضطلَعِ الرامح وَهيَ بالقُرُب",66,"ب",1,0],["بالجانب الغربي من تنيخلف","حيث استكف عراؤها بالغاب",67,"ب",1,0],["بالجَدّ لا بالكَدّ تنتظم المُنى","نرجو الغِنى والفقر في طلب الغنى",68,"ن",2,1],["بالجوهري الفرد قد صحَّ ما","يرويه عنه جوهري الصحاح",69,"ح",1,0],["بالجد وَالجد سدتم كُل ذي شَرَف","فَمن كَجدكم خَير الوَرى طه",70,"ا",3,0],["بالجسم مني الذي يشتكي","ه طرفك من غير ما علته",71,"ت",2,0],["بالجدَ هازلني صحبي بقولهمِ","يهنيك أَخِصِب بجسم مذرأَ ورَمي",72,"م",2,0],["بِالجَرِّ وَالتَّتنوينِ وَالنِّدا وَأل","وَمُسنَدٍ لِلإِسمِ تَمييزٌ حَصَل",73,"ل",1,0],["بالجوع والحرمان تصلح أمة","أخنى عليها الجوع والحرمانُ",74,"ن",1,0],["بِالجِدِّ خَيرَ الخَلقِ غَيثُ النَدى","طَهَ الَّذي يَسقي كُؤسَ العَيانِ",75,"ن",1,0],["بالجُودِ يَرْقَى المرءُ مَرْقَى الحمدِ","إن السَّخاء سُلَّمٌ للمَجْدِ",76,"د",1,0],["بالجد يدنو كل أمرٍ شاسع","حاولته في مغرب أو مشرق",77,"ق",1,1],["بِالجِوَارِ استَعلَت وَيَا حَبَّذَا","مُحَمَّدٌ مِن جَارٍ بِهِ استِعلاَءُ",78,"ا",2,0],["بالجيم والحاء وسرِّ الخاءِ","اغفر لنا وغِثْ من السماءِ",79,"ا",2,0],["بالجبهة الغراء والوجه الذي","يزهو به القصر المنيف الأبلق",80,"ق",1,0],["بالجوهر المحض الذي مضر","اصدافه ووجوده الدر",81,"ر",1,0],["بِالجَهلِ أَنفَقتُ وَقتَ الجِدِّ في لعب","وَلَم تَخَف سوءَ ما يَأتي بِهِ القَدَر",82,"ر",1,0],["بِالجِدِّ وَالجِدِّ العَلِيِّ وَبِالظَبي","فَرّوا كَجافلَةِ الظِباء الشُرَّد",83,"د",1,0],["بِالجفن سَقم وَبِالاِهداب ايماء","وَفي اللَواحِظ تَحذير وَاِغراء",84,"ا",2,1],["بالجدِّ وبالجهاد نُجحُ الطلّب","والرَّاحةُ مستودعةُ في التّعَب",85,"ب",1,0],["بالجدِّ أَدركتَ ما أَدركتَ لا اللّعب","كم راحةٍ جُنيَتْ من دوحةِ التّعبِ",86,"ب",1,1],["بالجودِ للمعتفي حلو الجنى سلساً","بالبأْسِ للمعتدي مُرُّ الإبا عفصا",87,"ص",2,0],["بالجزعِ مُذ شطَّ الخَليطُ النازحُ","قَلبٌ بهِ للوَجد زَندٌ قادحُ",88,"ح",1,1],["بالجود قد طوقت أجياد الورى","حتى غَدت كعبيدك الاحرار",89,"ر",1,0],["بالجدّ هازَلَني صحبي بقولهمِ","يهنيه أخصب جسماً مذ رأوا ورمي",90,"م",2,0],["بِالجَزعِ مِن كَنَفَي سُوَيقَةٍ أَصبَحَت","كَالبُردِ بَعدَ بَني النَبِيِّ قِفارا",91,"ر",2,0],["بالجمعةِ الزهراءِ كان تمامُه","في يوم ثانٍ من جُمادَى الثاني",92,"ن",2,0],["بالجد والإقدام والعملِ","سيهاتُ بالإنجاز فاحتفلي",93,"ل",2,1],["بالجودِ والصبرِ والإحسانِ عانقنا","في خافِقيه جمالٌ زادنا ألقَا",94,"ق",2,0],["بالجدّ قد بلغ المعالي ناشئًا","ما قبله قد شبَّ غصنٌ فاهتجن",95,"ن",1,0],["بالجِدِّ لا بجدودِ المرءِ عزَّتُهُ","لا تلتفت نحوَ ألقابٍ وأسماءِ",96,"ا",2,1],["بالجوف ذيب ن ل انتهض كشر النّاب","واخر ضحيّه بالخطا جاب / شلّي",97,"ل",2,0],["بالجرحِ يغتالُنا والظلُم معجَمُه","قاموسُه لاسلامٌ تلك أغبان",98,"ن",1,0],["بِالجَهْلِ أنْكَرتَ الصَّحِيحَ عَمَايَةً","لَمَّا جَهَلتَ وعاقَكَ التَّحمِيْسُ",99,"س",1,0],["بالجمال ومنطق لسانك","صورك من حور لجناني",100,"ن",2,0],["بالجرحِ مثخنةٌ وعند هجيعِها","تتجرعُ الآهاتِ لا ترتاحُ",101,"ح",1,0],["بالجهل تفقئة العيون فلا ترى","من في اجتراحات النفوس تأبّدا",102,"د",2,0],["بالجيدِ مِنهُ كَواكبٌ زُهْرُ","شُغفتْ بقامتِهِ القَنَا فَلِذَا",103,"ذ",2,0],["بالجود في سرّا وفي ضررٍ","دوما يفيض يمينهم غدقا",104,"ق",2,0],["بالجود ماله لامثيل ولا شبيه","إلا هماليل المزون الرعدا",105,"د",2,0],["بالجزيرة مايهابون المنون","ثابتين كالجبال الراسيات",106,"ت",1,0],["بالجيزة والنيل بدا أوله","في مقتبل الشباب عند الهرم",107,"م",1,0],["بالجميلات وحدهن سنغزوا","دولة القبحِ حيث تأوي العواذلْ",108,"ل",1,0],["بالجدِّ باركْ يا إلهُ وآلهِ","واكلأه في المثوى براحةِ بالهِ",109,"ل",2,1],["بِالجاهِ والأَنسَابِ إنْ عظُمَتْ","أَو دَعوةٍ باللِّينِ والكَلِمِ",110,"م",1,0],["بِالجَثامِينِ يَفرَحُ الحانُوتُ","وَ بَمَنْ ذاعَ نَعيُهُ ُالتَّابُوتُ",111,"ت",1,1],["بِالجِنْسِ لَا , لَنْ تَسْتَطِيعَ هَزِيمَتِي","فَلَدَيَّ دِرْعٌ - عِفَّتِي - وَ سِلَاحُ",112,"ح",1,0],["بالجبرياء بالعلاء الأعظم","بالكرم الحق بحق الكرم",113,"م",1,0],["بالجودِ من فضلٍ لديك مشرّقٍ","أبداً ومالٌ في البلادِ مغرّب",114,"ب",1,0],["بالجميل اللذيذ لا تهجريني","أو تدرين ما الجميل اللذيذ!",115,"ذ",1,1]]}