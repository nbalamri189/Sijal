om/ViewPoem.aspx?id=190854",""],[5007,"مخالب الظّل","https://www.poetsgate.com/ViewPoem.aspx?id=177932",""],[4119,"لو كان سرك للوشاة معرضا","https://www.poetsgate.com/ViewPoem.aspx?id=16177",""],[5046,"مطرٌ تنزل والغرام لهيب","https://www.poetsgate.com/ViewPoem.aspx?id=183361",""],[585,"مهلاً فلست بجاحدٍ أو عات","https://www.poetsgate.com/ViewPoem.aspx?id=161934",""],[5122,"الكذب","https://www.poetsgate.com/ViewPoem.aspx?id=31517",""],[119,"أواه من ألم الفراق لأنه","https://www.poetsgate.com/ViewPoem.aspx?id=26001",""],[5273,"وداع","https://www.poetsgate.com/ViewPoem.aspx?id=180311",""],[5277,"صمتُ الوَقور","https://www.poetsgate.com/ViewPoem.aspx?id=199746",""],[5338,"دار النبي ومن بها ولد الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=187758",""],[5358,"معكم فؤادٌ","https://www.poetsgate.com/ViewPoem.aspx?id=202325",""],[5444,"نجومُ الأحساء","https://www.poetsgate.com/ViewPoem.aspx?id=205512",""],[5616,"كلمات","https://www.poetsgate.com/ViewPoem.aspx?id=203238",""],[5626,"الله اكبر رايةً نختارُ","https://www.poetsgate.com/ViewPoem.aspx?id=189693",""],[5752,"أماه","https://www.poetsgate.com/ViewPoem.aspx?id=665",""],[4623,"ماذا يضرك لو تركت ملامي ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146686",""],[4623,"ذكر الحبيب فأطلق العبرات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146689",""],[4623,"من يعذر المشتاق في شطحاته ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146691",""],[5770,"نحن سبعة","https://www.poetsgate.com/ViewPoem.aspx?id=178734",""],[402,"طيبوا قرارا أيها الأعلام","https://www.poetsgate.com/ViewPoem.aspx?id=36333",""],[5957,"يا غيثَ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=46976",""],[6053,"تِلْكَ الرِّسَالَةُ ... !","https://www.poetsgate.com/ViewPoem.aspx?id=197035",""],[6124,"أحلام العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=125194",""],[520,"يا دار عليك سعد المشتري","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577539",""],[6262,"وشْمٌ ثان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80113&r=&rc=11",""],[6339,"نون النسوة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87889&r=&rc=1",""]],"verses":[["وَعَلَى جَانِبَيْهِ مُشْتَرَفَاتٌ","جَزِعَاتٌ مَخْفُوضَةُ الأَعْلامِ",0,"م",1,0],["وَعَلَى جَوَانِبِكَ المَحَامِدُ إِنْ تُقِمْ","فِي بَلْدَةٍ أَوْ لَمْ يَسَعَكَ مُقَامُ",1,"م",1,0],["وَعَلى جَبينِكِ مِثلَ قَطَراتِ النَدى","وَالنَرجِسَ الوَسنانَ في عَينَيكِ",2,"ك",1,0],["وَعَلى جَوانِبِ نَعشِهِ صَفّانِ","مِن جُندِ أَلبِرتِ الرَفيعِ الشانِ",3,"ن",1,0],["وَعَلى جُؤجُئِها نورُ الهُدى","وَعَلى سُكّانِها نورُ اليَقين",4,"ن",1,0],["وعلى جناحك أو جنا","حي قد رقيتُ إلى الصفاء",5,"ا",2,0],["وَعَلى جميع حقوقها","من بعد لذته تعدَّى",6,"د",2,0],["وعلى جوانب أرضها وسمائها","شفق تقلّده السماء وشاحا",7,"ح",2,0],["وعلى \" جدّة \" تجدّد عهد ال","عرب واهتاج للوثوب المجيد",8,"د",1,0],["وعلى جبينك غار أكرم فاتح","وعلى محيّاك ابتسام نظفّر",9,"ر",1,0],["وعلى جَناحَيْك ارتَمتْ كِسَراً","مثلَّ الضَّباب عواصفٌ صِرُّ",10,"ر",1,0],["وَعَلَىْ جُمْجُمَتِيْ رَابِعَةً","أَمْحُو عَارَاً يُدْعَىْ «نَصْرِيْ»",11,"ر",2,0],["وعلى جميع الصحب والقوم الذي","ن مشوا على منواله أمر كماله",12,"ل",2,0],["وعلى جهابذة الطريق وحزبهم","أين انتحوا بالغور والأنجاد",13,"د",1,0],["وعلى جملة القرابة والآ","ل وصحب أماجد أخيار",14,"ر",1,0],["وعلى جميع التابعين وآلهم","والأولياء الأتقيا النجباء",15,"ا",2,0],["وعلى جمالك والشبا","ب الغضّ لهفي يا خميله",16,"ه",1,0],["وعلى جبينِكَ من سناهُ غُرَّةٌ","لم تعدَمِ اللالاءَ واللمَعانا",17,"ن",2,0],["وَعَلَى جَمِيعِ الآلِ وَالأَصْحَابِ مَنْ","سَلَكُوا الْهُدَى وَتَوَقَّلُوا بِجِبَالِهَا",18,"ل",3,0],["وَعَلَى جَمِيعِ الآلِ وَالأَصْحَابِ مَنْ","بَاعُوا نُفُوسَهُمْ بِرُوحِ اللهِ",19,"ه",1,0],["وعلى جبينكِ صفرةٌ جذَّابةٌ","عَذُبَت لقلبٍ مُلجَمِ الأهواء",20,"ا",2,0],["وعلى جبينِك تاجُ نجمٍ ساطعٍ","بضيائهِ وبهائهِ يَهدينا",21,"ن",2,0],["وَعَلى جَميع الآل والاصحاب ما","سجعت بأيمن ذي الاراك حمائمه",22,"م",2,0],["وَعلى جَفاهُ ما أَلَذَّ غَرامَهُ","لَو كُنتُ أَسلمُ في هَواهُ من الأَذى",23,"ذ",2,0],["وعلى جحيمك كم ديار أحرقت","في غفلة فإذا الديار خراب",24,"ب",1,0],["وَعَلى جَدّكُم كَم شَفيع البَرايا","أَشرَفُ الرُسُل سَيِّدُ الاِنبِياء",25,"ا",2,0],["وعلى جيادِ الخيلِ أغلمةٌ","غُرّ تُصَرَفُ تحتها غُرّا",26,"ر",2,0],["وعَلى جُودِكَ عَوَّلتُ به","مثل ما عَوَّل في الحُكمِ عَلَيك",27,"ك",1,0],["وعلى جُودِهِ نَحُطُ بما نَسْ","مع إلاَّ لفظَيْنِ هاكَ وهاتِ",28,"ت",1,0],["وعلى جميع الأنبيا","ء وآله المتواليه",29,"ي",2,0],["وعلى جزالتِها وجودةِ سكبِها","لم تمشِ يوماً مِسيةَ المختالِ",30,"ل",1,0],["وعلى جدِّه الصلاةُ مدى الأ","يامِ ما ناظمٌ اجاد قصيده",31,"د",2,0],["وعلى جَدِّكَ الصَلاةُ دَواماً","وعليكَ الرِّضْوانُ يا مَعْروفُ",32,"ف",1,0],["وعلى جبهَةِ آثارِ الوَرَى","أَحكَمَ الباري تَعالى سعْدَنَا",33,"ن",2,0],["وعلى جوانبها بساط خميلة","قد فرزوه بالنبات الأخضر",34,"ر",1,0],["وَعَلى جَميع المُرسَلين وآله","وَصحابه وَالتّابِعين وَمَن تَلا",35,"ل",2,0],["وعلى جبين الدهر قد رُقم الذي","ابدت يداه وحبذا المرقوم",36,"م",1,0],["وَعلى جميعِ الناس أوجب حبّكم","وَلَكم إليه لم نزل نتوسّلُ",37,"ل",1,0],["وعلى جناحَيهِ لسير بني الورى","قسمانِ قد وصفوهما احجارا",38,"ر",2,0],["وعلى جميع الأنبياء والرسل","والأملاك أهل الفخر والمجد الصميم",39,"م",1,0],["وَعَلى جَناحِ الأَزبَكيَّةِ مَنِزلٌ","فيهِ خَلَعتُ تَعقلي وَعَياني",40,"ن",2,0],["وعلى جودوا عاجلا لقيامكم","دمتم لنا امنا من الحسران",41,"ن",1,0],["وعلى جمال الحب فاشدد ما استطعت","يديك واعضض بالنواجذ تشرف",42,"ف",1,0],["وعلى جميع الانبياء وكل صحبك","والكرام والآل أهل ولاكا",43,"ك",2,0],["وعلي جودوا يا آل ودي باللقا","كرماً لأني ذلك الخل الوفي",44,"ف",2,0],["وَعَلى جِسمِهِ بَقايا رِداءٍ","تَتَبَدّى العِظامُ مِن أَجزائِه",45,"ا",3,0],["وعلى جدَّتِها الكبرى التي","بمعاليها تضاهى الكوكبا",46,"ب",2,0],["وعلى جميع الآل والصحب الأُولى","حسنُ المديح بهم يتمُّ ويكمل",47,"ل",1,0],["وَعلى جيدها الثنا لاح عقدا","من لآل تشع فوق طلاها",48,"ا",3,0],["وعلى جميعِ الأهل والصَّحبِ الألَى","حُبِّي لهم ذُخرٌ ليومِ وفاتِي",49,"ي",1,0],["وعلى جسمك تجري الصافنات","عافر الجسم لقىً بين الصفوف",50,"ف",1,0],["وعلى جدك الحبيب صلاة","ما شدا طائر على الأوراق",51,"ق",1,0],["وعلى جماعتِه السّلامُ فإنّهُم","مثلُ النجومِ من