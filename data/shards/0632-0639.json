","https://www.poetsgate.com/ViewPoem.aspx?id=179506",""],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[106,"ديك غير وديك","https://www.poetsgate.com/ViewPoem.aspx?id=179736",""],[106,"جنازة السلام !","https://www.poetsgate.com/ViewPoem.aspx?id=179424",""],[106,"بين عهدين","https://www.poetsgate.com/ViewPoem.aspx?id=179345",""],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[106,"الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179446",""],[77,"ودير أنخنا في قراراته العيسا","https://www.poetsgate.com/ViewPoem.aspx?id=34190",""],[50,"طَرَقَتَنَا بالزَّابيَيْنِ الرَّبَابُ","https://www.poetsgate.com/ViewPoem.aspx?id=17925",""],[7,"مِنَ آلِ مَيّة َ رائحٌ، أو مُغْتَدِ،","https://www.poetsgate.com/ViewPoem.aspx?id=17556",""],[90,"يا شعب","https://www.poetsgate.com/ViewPoem.aspx?id=178937",""],[45,"زَعَمَ الغُرَابُ مُنَبّىءُ الأنْبَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=32958",""],[29,"زعموا ولم أكُ شاهداً لمقامة","https://www.poetsgate.com/ViewPoem.aspx?id=14113",""],[91,"العبد المتنكر","https://www.poetsgate.com/ViewPoem.aspx?id=53315",""],[91,"الإله الثرثار","https://www.poetsgate.com/ViewPoem.aspx?id=53349",""],[51,"زعم الناس خالد بغاء","https://www.poetsgate.com/ViewPoem.aspx?id=26088",""],[31,"يَقُولُ عَتيقٌ إذْ شَكَوْتُ صَبَابَتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18855&r=&rc=118",""],[31,"بَانَ الخَلِيطُ وَبَيْنُهُمْ شَغَفُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18962&r=&rc=225",""],[7,"أمِنَ آلِ مَيّة َ رائحٌ، أو مُغْتَدِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13896&r=&rc=14",""],[18,"هَلْ عَرَفْتَ الْغَدَاة َ مِنْ أَطْلاَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26460&r=&rc=26",""]],"verses":[["زَعَمَت بِأَنَّ الدينَ سَوَّغَ قَتلَها","أَوَليسَ هَذا الدينُ عَن أَجدادِها",0,"د",3,0],["زَعانِفُ يَستَصرِخونَ العُلى","وَما اِستَلَبَ العِزَّ إِلّا نَجيبُ",1,"ب",1,0],["زَعانِفُ لا يَزالُ لهمْ خَطيبٌ","غَداةَ الفَخْرِ مُسْتَرَقَ اللِّسانِ",2,"ن",1,0],["زَعَمُوا أَنَّ كُلَّ مَن ضَرَبَ العَي","رَ مَوالٍ لَنا وَأَنّا الوَلاءُ",3,"ا",2,0],["زَعَمَ الرَسولُ بِأَنَّني راوَدتُهُ","كَذَبَ الرَسولُ وَمُنزِلِ الفُرقانِ",4,"ن",1,0],["زَعَموا لي أَنَّها صارَت تُحَمُّ","اِبتَلى اللَهُ بِهَذا مَن زَعَم",5,"م",1,1],["زَعَمَت في الكِتابِ أَنّى تَبَدَّل","تُ سِواها وَأَنَّ عَهدي ذَميمُ",6,"م",1,0],["زَعَمَ الرَسولُ بِأَنَّكُم قُلتُم لَهُ","إِنّا سِواكُم بِالوِصالِ نُحاوِلُ",7,"ل",1,1],["زَعَمَ الجاهِلونَ بي أَنَّ قَلبي","بِالجَنابِ الشَرقِيِّ صَبٌ عَميدُ",8,"د",1,0],["زَعَقْنا بهِمْ بعْدَ العَشيِّ فهَيْنَموا","كأنّا ذَعَرْنا غابَة منْهُ أو خيسا",9,"س",2,0],["زَعَقْنا براهِبِهِ زعْقَةً","وقُلْنا مدَدْنا الأكُفَّ افْتِقارا",10,"ر",2,0],["زَعَمَ النَّاسُ أَنَّ طَبْعَكَ حُلْوٌ","قُلْتُ وَالطَّبْعُ بِاصْطِلاَحِ الطَّبِيبِ",11,"ب",1,0],["زَعَموا قُتِلتَ وَعِندَهُم عُذرٌ","كَذَبوا وَقبرِكَ مالَهُم عُذرُ",12,"ر",1,0],["زَعَمَ الأَميرُ أَبو المُغيرَةِ إِنَّني","شَيخٌ كَبيرٌ قَد دَنَوتُ مِنَ البِلى",13,"ا",1,1],["زَعَمَت حَنيفَةُ لا تُجيرُ عَلَيهِمُ","بِدِمائِهِم وَأَظُنُّها سَتُجيرُ",14,"ر",1,0],["زَعَموا أَنَّني هَجَوتُ اِبنَ شيثٍ","كَيفَ أَهجوهُ وَهوَ في العِلمِ آيَه",15,"ه",1,1],["زَعَموا أَنَّهُ حَفيظٌ عَلى الما","لِ أَمينٌ قُلتُ اسكُتي يا فُلانَه",16,"ن",2,0],["زَعيمُ المَساعي أَن تَلينَ شَدائِدٌ","يُمارِسُها أَو أَن تَلينَ صِعابُ",17,"ب",1,0],["زَعيمُ الدَهاءِ أَن تُصيبَ مِنَ العِدا","مَكايِدُهُ مالا تُصيبُ الجَحافِلُ",18,"ل",1,0],["زَعيمٌ لِأَبناءِ السِيادَةِ بارِعٌ","عَلَيهِم بِهِ تُثنى الخَناصِرُ إِن عُدّوا",19,"د",3,0],["زَعَمَت قُتَيبَةُ أَنَّها مِن وائِلٍ","نَسَبٌ بَعيدٌ يا قُتَيبَ فَأَصعِدي",20,"ي",1,1],["زعموا أنني أبر ضعافا","وسوى السعي ليس لي من نوال",21,"ل",1,0],["زعمو لي التبريز في أدبائهم","فإذا أضاعوني فأي شنار",22,"ر",1,0],["زَعِيمَةُ النَّهْضَةِ هَلْ زرْتِ حِمى","وَلَمْ تيسِّري لَهُ الرُّقِيَّا",23,"ي",2,0],["زَعِيمَةُ رَبَّاتِ النُّهَى مِنْ دَرَارِيءٍ","سَوَافِرَ تَجْلُوهَا سَمَاوَاتُ عَدْنَانِ",24,"ن",1,1],["زُعَمَاؤُهَا مُتَكَافِلُونَ وَنَشْئُهَا","أجْنَادُهُمْ بِالطَّوْعِ وَالإذْعَانِ",25,"ن",1,0],["زَعَمَ الفَرَزدَقُ أَن سَيَقتُلُ مَربَعاً","أَبشِر بِطولِ سَلامَةٍ يا مَربَعُ",26,"ع",1,0],["زعم النضر والمُغيرة والنعم","ان والبحتري وابن عياض",27,"ض",1,1],["زَعَمَت بِأَنَّ المَرءَ يَكرُبُ يَومَهُ","عَدَمٌ لِمُعتَكِرٍ مِنَ الأَصرامِ",28,"م",1,0],["زَعَمَ اِبنُ نابِغَةَ اللَئيمُ بِأَنَّنا","لا نَجعَلُ الأَحسابَ دونَ مُحَمَّدِ",29,"د",1,1],["زَعَمَ الوَلائِدُ أَنَّها وَلَدَت","وَلَداً صَغيراً كانَ مِن عَهرِ",30,"ر",1,0],["زَعَمَت سَخينَتُ أَن تُغالِبَ رَبَّها","وَلَيُغلَبَنَّ مُغالِبُ الغَلّابِ",31,"ب",1,1],["زعم المشنع أنني واصلته","ليت المشنع عن تواصلنا صدق",32,"ق",1,0],["زعم الناسُ خالداً بَغّاءَ","كَذَبوا القولَ وافْتَرَوْهُ افتراءَ",33,"ا",2,1],["زعموا أن ذاك غزو وحجٌّ","تبَّب اللّهُ أمرهم تتبيبا",34,"ب",2,0],["زَعِ القلب إن الفاجعاتِ مصائبٌ","أصابت وكانت قبل مُحتسَباتِ",35,"ت",1,0],["زعموا أنك يا خا","لدُ مسترخي الحِتار",36,"ر",1,1],["زعموا لما رأوا أختكم","أسرفت في أمره كل السرف",37,"ف",1,0],["زعم الشيخ أن مولدك المي","مون في الغدر غير ما مسبوق",38,"ق",1,0],["زعَمْتَ بأنني نَحْسٌ وإني","مُجيبُك مُعْلِناً لا أتقيكا",39,"ك",2,0],["زعم الناس أن للسَّعْدِ نَجْماً","واحداً لا يزيدُ أَوْ نَجْمَيْنِ",40,"ن",1,1],["زَعْزعتِ الأيامُ جانبيه","قد هدمتْ أيامُه رُكنيه",41,"ي",2,0],["زَعَموا وَلَم أَكُ شاهِداً لِمَقالَةٍ","أَنَّ الخَطيبَ لَدى الإِمامِ الهَيثَمُ",42,"م",1,1],["زَعَمَ الخائِنونَ أَنّا بِما نَبغي","هِ نَبغي الوُصولَ لِلعَنقاءِ",43,"ا",2,0],["زَعَموا أَنَّ الغَواني لِعَبٌ","إِنَّما اللُعبَةُ طَبعاً لِلصَبي",44,"ي",1,0],["زَعَموا الإِنسانَ بِالعِلمِ اِرتَقى","وَأَراهُ لَم يَزَل إِنسانَ غابِ",45,"ب",1,0],["زَعَمتُم أَنَّهُنَّ خامِلاتِ نُهىً","وَلَو أَرَدنَ لَصَيَّرنَ الثَرى ذَهَبا",46,"ب",2,0],["زَعَموا ما زَعَموا لَكِنَّما","هُوَ عِندي لُعبَةٌ لا تُشتَرى",47,"ر",2,0],["زَعَموا تَبَذَّلنا وَلَم يَتَبذَّلوا","إِنَّ الحَقيقَةَ كُلُّنا مُتَبَذِّلُ",48,"ل",1,0],["زَعَموا الإِلَهَ أَعَدَّها لِعَذابِنا","حاشا وَرَبُّكَ رَحمَةٌ أَن يَظلِما",49,"م",2,0],["زَعقَةٌ سارَ صَداها في الدُجى","فَإِذا الشَطُّ شُخوصٌ وَحُسوم",50,"م",1,0],["زَعَمَ المُؤَدَّبُ أَنَّ عَيراً سا