://www.aldiwan.net/poem15400.html","الرجز"],[462,"بهاء الدين دعوة ذي ولاء","https://www.aldiwan.net/poem15429.html","الوافر"],[462,"أقول لمنطيق من الحي أفوه","https://www.aldiwan.net/poem16098.html","الطويل"],[465,"درت أنها شمس الضحى فتجلت","https://www.aldiwan.net/poem3592.html","عموديه"],[478,"زعموا أني خؤون في الهوى","https://www.aldiwan.net/poem15309.html","الرمل"],[480,"قالوا حبست فقلت ليس بضائري","https://www.aldiwan.net/poem37597.html","الكامل"],[501,"أجل نظرا في الكائنات ترى العجب","https://www.aldiwan.net/poem37679.html","الطويل"],[501,"تدرع بدرع البغي يا طامس القلب","https://www.aldiwan.net/poem37709.html","الطويل"],[501,"تركونا أي قوم تركوا","https://www.aldiwan.net/poem37930.html","الرمل"],[501,"زعمت نفسك أني جاهل","https://www.aldiwan.net/poem37986.html","الرمل"],[510,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[514,"زعمت بنفسي أنت أنك مغرم","https://www.aldiwan.net/poem67793.html","الطويل"],[515,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[516,"قولا لنجم الدين يا خير من","https://www.aldiwan.net/poem12103.html","السريع"],[543,"زعم العبد طاهر","https://www.aldiwan.net/poem34048.html","مجزوء الخفيف"],[552,"زعازع ثم نكب","https://www.aldiwan.net/poem48102.html","الطويل"],[559,"بين أهل الجحود والتكذيب","https://www.aldiwan.net/poem34966.html","الخفيف"],[564,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[568,"زعموا أن من أحب عليا","https://www.aldiwan.net/poem69797.html","الخفيف"],[568,"كثر الإحسان أعداى","https://www.aldiwan.net/poem69799.html","مجزوء الرمل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[574,"يا من لصبح الشيب كيف تنفسا","https://www.aldiwan.net/poem3649.html","الكامل"],[576,"ما على الدهر بعد رؤياك عتب","https://www.aldiwan.net/poem3096.html","الطويل"],[576,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"]],"verses":[["زَعَمَت بِأَنَّ الدينَ سَوَّغَ قَتلَها","أَوَليسَ هَذا الدينُ عَن أَجدادِها",0,"د",3,0],["زَعانِفُ يَستَصرِخونَ العُلى","وَما اِستَلَبَ العِزَّ إِلّا نَجيبُ",1,"ب",1,0],["زَعانِفُ لا يَزالُ لهمْ خَطيبٌ","غَداةَ الفَخْرِ مُسْتَرَقَ اللِّسانِ",2,"ن",1,0],["زَعَمُوا أَنَّ كُلَّ مَن ضَرَبَ العَي","رَ مَوالٍ لَنا وَأَنّا الوَلاءُ",3,"ا",2,0],["زَعَمَ الرَسولُ بِأَنَّني راوَدتُهُ","كَذَبَ الرَسولُ وَمُنزِلِ الفُرقانِ",4,"ن",1,0],["زَعَموا لي أَنَّها صارَت تُحَمُّ","اِبتَلى اللَهُ بِهَذا مَن زَعَم",5,"م",1,1],["زَعَمَت في الكِتابِ أَنّى تَبَدَّل","تُ سِواها وَأَنَّ عَهدي ذَميمُ",6,"م",1,0],["زَعَمَ الرَسولُ بِأَنَّكُم قُلتُم لَهُ","إِنّا سِواكُم بِالوِصالِ نُحاوِلُ",7,"ل",1,1],["زَعَمَ الجاهِلونَ بي أَنَّ قَلبي","بِالجَنابِ الشَرقِيِّ صَبٌ عَميدُ",8,"د",1,0],["زَعَقْنا بهِمْ بعْدَ العَشيِّ فهَيْنَموا","كأنّا ذَعَرْنا غابَة منْهُ أو خيسا",9,"س",2,0],["زَعَقْنا براهِبِهِ زعْقَةً","وقُلْنا مدَدْنا الأكُفَّ افْتِقارا",10,"ر",2,0],["زَعَمَ النَّاسُ أَنَّ طَبْعَكَ حُلْوٌ","قُلْتُ وَالطَّبْعُ بِاصْطِلاَحِ الطَّبِيبِ",11,"ب",1,0],["زَعَموا قُتِلتَ وَعِندَهُم عُذرٌ","كَذَبوا وَقبرِكَ مالَهُم عُذرُ",12,"ر",1,0],["زَعَمَ الأَميرُ أَبو المُغيرَةِ إِنَّني","شَيخٌ كَبيرٌ قَد دَنَوتُ مِنَ البِلى",13,"ا",1,1],["زَعَمَت حَنيفَةُ لا تُجيرُ عَلَيهِمُ","بِدِمائِهِم وَأَظُنُّها سَتُجيرُ",14,"ر",1,0],["زَعَموا أَنَّني هَجَوتُ اِبنَ شيثٍ","كَيفَ أَهجوهُ وَهوَ في العِلمِ آيَه",15,"ه",1,1],["زَعَموا أَنَّهُ حَفيظٌ عَلى الما","لِ أَمينٌ قُلتُ اسكُتي يا فُلانَه",16,"ن",2,0],["زَعيمُ المَساعي أَن تَلينَ شَدائِدٌ","يُمارِسُها أَو أَن تَلينَ صِعابُ",17,"ب",1,0],["زَعيمُ الدَهاءِ أَن تُصيبَ مِنَ العِدا","مَكايِدُهُ مالا تُصيبُ الجَحافِلُ",18,"ل",1,0],["زَعيمٌ لِأَبناءِ السِيادَةِ بارِعٌ","عَلَيهِم بِهِ تُثنى الخَناصِرُ إِن عُدّوا",19,"د",3,0],["زَعَمَت قُتَيبَةُ أَنَّها مِن وائِلٍ","نَسَبٌ بَعيدٌ يا قُتَيبَ فَأَصعِدي",20,"ي",1,1],["زعموا أنني أبر ضعافا","وسوى السعي ليس لي من نوال",21,"ل",1,0],["زعمو لي التبريز في أدبائهم","فإذا أضاعوني فأي شنار",22,"ر",1,0],["زَعِيمَةُ النَّهْضَةِ هَلْ زرْتِ حِمى","وَلَمْ تيسِّري لَهُ الرُّقِيَّا",23,"ي",2,0],["زَعِيمَةُ رَبَّاتِ النُّهَى مِنْ دَرَارِيءٍ","سَوَافِرَ تَجْلُوهَا سَمَاوَاتُ عَدْنَانِ",24,"ن",1,1],["زُعَمَاؤُهَا مُتَكَافِلُونَ وَنَشْئُهَا","أجْنَادُهُمْ بِالطَّوْعِ وَالإذْعَانِ",25,"ن",1,0],["زَعَمَ الفَرَزدَقُ أَن سَيَقتُلُ مَربَعاً","أَبشِر بِطولِ سَلامَةٍ يا مَربَعُ",26,"ع",1,0],["زعم النضر والمُغيرة والنعم","ان والبحتري وابن عياض",27,"ض",1,1],["زَعَمَت بِأَنَّ المَرءَ يَكرُبُ يَومَهُ","عَدَمٌ لِمُعتَكِرٍ مِنَ الأَصرامِ",28,"م",1,0],["زَعَمَ اِبنُ نابِغَةَ اللَئيمُ بِأَنَّنا","لا نَجعَلُ الأَحسابَ دونَ مُحَمَّدِ",29,"د",1,1],["زَعَمَ الوَلائِدُ أَنَّها وَلَدَت","وَلَداً صَغيراً كانَ مِن عَهرِ",30,"ر",1,0],["زَعَمَت سَخينَتُ أَن تُغالِبَ رَبَّها","وَلَيُغلَبَنَّ مُغالِبُ الغَلّابِ",31,"ب",1,1],["زعم المشنع أنني واصلته","ليت المشنع عن تواصلنا صدق",32,"ق",1,0],["زعم الناسُ خالداً بَغّاءَ","كَذَبوا القولَ وافْتَرَوْهُ افتراءَ",33,"ا",2,1],["زعموا أن ذاك غزو وحجٌّ","تبَّب اللّهُ أمرهم تتبيبا",34,"ب",2,0],["زَعِ القلب إن الفاجعاتِ مصائبٌ","أصابت وكانت قبل مُحتسَباتِ",35,"ت",1,0],["زعموا أنك يا خا","لدُ مسترخي الحِتار",36,"ر",1,1],["زعموا لما رأوا أختكم","أسرفت في أمره كل السرف",37,"ف",1,0],["زعم الشيخ أن مولدك المي","مون في الغدر غير ما مسبوق",38,"ق",1,0],["زعَمْتَ بأنني نَحْسٌ وإني","مُجيبُك مُعْلِناً لا أتقيكا",39,"ك",2,0],["زعم الناس أن للسَّعْدِ نَجْماً","واحداً لا يزيدُ أَوْ نَجْمَيْنِ",40,"ن",1,1],["زَعْزعتِ الأيامُ جانبيه","قد هدمتْ أيامُه رُكنيه",41,"ي",2,0],["زَعَموا وَلَم أَكُ شاهِداً لِمَقالَةٍ","أَنَّ الخَطيبَ لَدى الإِمامِ الهَيثَمُ",42,"م",1,1],["زَعَمَ الخائِنونَ أَنّا بِما نَبغي","هِ نَبغي الوُصولَ لِلعَنقاءِ",43,"ا",2,0],["زَعَموا أَنَّ الغَواني لِعَبٌ","إِنَّما اللُعبَةُ طَبعاً لِلصَبي",44,"ب",2,0],["زَعَموا الإِنسانَ بِالعِلمِ اِرتَقى","وَأَراهُ لَم يَزَل إِنسانَ غابِ",45,"ب",1,0],["زَعَمتُم أَنَّهُنَّ خامِلاتِ نُهىً","وَلَو أَرَدنَ لَصَيَّرنَ الثَرى ذَهَبا",46,"ب",2,0],["زَعَموا ما زَعَموا لَكِنَّما","هُوَ عِندي لُعبَةٌ لا تُشتَرى",47,"ر",2,0],["زَعَموا تَبَذَّلنا وَلَم يَتَبذَّلوا","إِنَّ الحَقيقَةَ كُلُّنا مُتَبَذِّلُ",48,"ل",1,0],["زعموا سلوتُكَ.. ليتَهم","نسبوا إليّ المُمكنا",49,"ن",2,0],["زَعَموا الإِلَهَ أَعَدَّها لِعَذابِنا","حاشا وَرَبُّكَ رَحمَةٌ أَن يَظلِما",50,"م",2,0],["زَعقَةٌ سارَ صَداها في الدُجى","فَإِذا الشَطُّ شُخوصٌ وَحُسوم",51,"م",1,0],["زَعَمَ المُؤَدَّبُ أَنَّ عَيراً سائَهُ","أَن لا يُسارَ بِهِ إِلى المَيدانِ",52,"ن",1,1],["زَعَمَ المَرءُ إِنَّما هُوَ رَبٌّ","كَم يَلوكُ الكَلامَ هَذا الإِلَهُ",53,"ا",3,1],["زَعَموا أَنَّهُ المَليكُ المُفَدّى","بِالرَعايا مِن شَرِّ كُلِّ بَلِيَّه",54,"ي",2,0],["زَعَموا الأَرواحَ تَبقى سَرمَدا","خَدعونا نَحنُ وَالشَمعُ سَواء",55,"ا",2,0],["زَعيمُ بَني اللَمطِيِّ في البَأسِ وَالنَدى","مُكَرَّمُها المَأمولِ في الدَهرِ إِن قَسا",56,"س",2,0],["زَعَمَت بُثَينَةُ أَنَّ فُرقَتَنا غَداً","لا مَرحَباً بِغَدٍ فَقَد أَبكاني",57,"ي",1,0],["زَعَمَ الناسُ أَنَّ دائي طِبّي","أَنتِ وَاللَهِ يا بُثَينَةُ طِبّي",58,"ب",2,0],["زعمت الغيب خلف لسان طير","جهلت لسانه فزعمت غيا",59,"ي",2,0],["زعموا الحياة نفيسها وخسيسها","قولا يطير مع الهباء عقيما",60,"م",2,0],["زعموا المسافة ليلة ونهارها","ما الدهر إلا ليلة ونهار",61,"ر",1,0],["زعموا اللؤلؤ من طول النوى","يظهر السقم ويبدى الاصفرار",62,"ر",1,1],["زعمت أنك أولى من أعزتها","بها وأحنى عليها من مواليها",63,"ي",3,0],["زعم المقطم أنه","ينشي وينشر فلسفه",64,"ه",1,1],["زَعَموا نَعِيَّكَ في المَجامِعِ مازِحاً","هَيهاتَ في رَيبِ المَنونِ مِزاحُ",65,"ح",1,0],["زُعَماءُ لُبنانَ وَأَهلَ نَدِيِّهِ","لُبنانُ في ناديكُمو عَظَمتُهُ",66,"ت",2,0],["زَعَموكِ دارَ خَلاعَةٍ وَمَجانَةٍ","وَدَعارَةٍ يا إِفكِ ما زَعَموكِ",67,"ك",1,0],["زَعَموكِ هَمّاً لِلخِلافَةِ ناصِباً","وَهَلِ المَمالِكُ راحَةٌ وَمَنامُ",68,"م",1,0],["زَعَموا الفَرَنسِيَّ المُحَجَّلَ صورَةً","في حَلبَةِ الفُرسانِ مِن حاميكِ",69,"ك",1,0],["زَعَموا أَنَّها دَعائِمُ شيدَت","بِيَدِ البَغيِ مِلؤُها ظَلماءُ",70,"ا",2,0],["زَعَمْتُمْ بأنِّي قَدْ سَلَوْتُ وِصَالكُمْ","فَلِمْ ذَرَفَتْ عَيني ولِمْ شَابَ مَفْرِقِي",71,"ي",1,1],["زَعيمٌ لِلقَنا الخَطِّيِّ عَزمي","بِسَفكِ دَمِ الحَواضِرِ وَالبَوادي",72,"د",2,0],["زَعَمتَ أَنَّكَ تَنفي الظَنَّ عَن أَدَبي","وَأَنتَ أَعظَمُ أَهلِ العَصرِ مِقدارا",73,"ر",2,1],["زعَمَ المقيمُ بكَوتكينَ بأنَّهُ","من آلِ هاشمٍ بنِ عبدِ منافِ",74,"ف",1,1],["زَعَمَ الغُرابُ مُنَبِّئُ الأَنباءِ","أَنَّ الأَحِبَّةَ آذَنوا بِتَناءِ",75,"ا",2,1],["زَعيماً خُطَّةٍ وَرَدا حِماماً","وُرودَهُما جَبا الماءِ الشَروبِ",76,"ب",1,0],["زَعَمَ العاذِلونَ أَنَّ الَّذي يُص","بيهِ نُجلُ العُيونِ غَيرُ رَشيدِ",77,"د",1,0],["زَعَمَت عَثمَةُ أَنّي لَم أَجِد","في هَواها قُلتُ بَل وَجدي أَشَدّ",78,"د",1,0],["زَعزَعَ الغَربُ ذِكرُ يَومٍ تَوارَت","شَمسُهُ وَاِكتَسى سَواداً نَهارُه",79,"ر",2,0],["زَعيمٌ بِخِدنِ السوءِ يوجَدُ عِندَهُ","إِذا ما اِبنُ مَيمونٍ أَتاهُ يُضارِطُه",80,"ط",2,0],["زَعيمٌ بِفَتحِ الأَمرِ عِندَ اِنغِلاقِهِ","عَلَيهِم وَرَتقِ الفَتقِ عِندَ اِتِّساعِهِ",81,"ع",2,0],["زَعَمتَ بِأَنَّكَ لَستَ الدَمارَ","وَلَستَ العِثارَ وَلَستَ الزَلَل",82,"ل",1,0],["زَعيمُ بَني ميكالَ حَيثُ تَكامَلوا","وَكانَ اِبتِداءَ النَقصِ فَرطُ التَكامُلِ",83,"ل",1,0],["زَعيمٌ لَهُم بِالعُظمِ مِمّا عَناهُمُ","وَلَو جَشَّموهُ ثِقلَ رَضوى تَجَشَّما",84,"م",2,0],["زَعيمُ حِزبَينِ مِن كُتّابِ أَندِيَةٍ","وَمِن فَوارِسِ إِسراجٍ وَإِلجامِ",85,"م",1,0],["زَعَقَت مَغارِبَةُ الخَميسِ وَراءَهُ","فَكَأَنَّما نَعَقَت بِهِ الغُربانُ",86,"ن",1,0],["زَعَمَت زَبينَةُ أَنَّما أَموالُها","غَنَمٌ وَلَيسَ لَها بَعيرٌ يُعلَمُ",87,"م",1,0],["زعموا أنني طعنت بلادي","وأنا الحب كله والوفاء",88,"ا",2,0],["زَعَمَ الناسُ أَنَّ ذَلِكَ ديني","حينَ عاجَلتُ فُرصَتي بِاِنتِهازِ",89,"ز",1,0],["زَعَمَ العُداةُ بِأَنَّ حُسنَكِ ناقِصٌ","حاشاكِ مِن قَولِ العِدى حاشاكِ",90,"ك",1,0],["زَعَمَ الوُشاةُ بِأَن هَوَيتُ سِواكُمُ","يا قوتِلَ الواشي فَأَنّى يُؤفَكُ",91,"ك",1,0],["زعموكم أمة هازلة","كذب الزاعم فيما قد زعم",92,"م",1,0],["زَعيماً بِالغِنى أَو نَدبِ نَوحٍ","تُعَطَّطُ في مَآتِمِهِ الجُيوبُ",93,"ب",1,0],["زَعَمَت هَواكَ عَفا الغَداةَ كَما عَفَت","مِنها طُلولٌ بِاللِوى وَرُسومُ",94,"م",1,0],["زَعَمتُ إِذاً بِأَنَّ الجودَ أَمسى","لَهُ رَبٌّ سِوى اِبنِ أَبي دُوادِ",95,"د",1,0],["زَعَمَ النَّصِيحَةَ بَعْدَ أَنْ بَلَغَتْ بِهِ","غِشّاً وَجَازَى الْحَقَّ بِالْبُهْتَانِ",96,"ن",1,0],["زَعَمُونِي أَتَيْتُ ذَنْبَاً وَمَا لِي","يَعْلَمُ ال