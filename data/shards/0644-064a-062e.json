{"poems":[[77,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[73,"أما علمت أن الشفيع شباب","https://www.aldiwan.net/poem11916.html","الطويل"],[27,"بان الخليط فودعوا بسواد","https://www.aldiwan.net/poem5712.html","الوافر"],[72,"يا شيخ أهل العلم والزهد في","https://www.aldiwan.net/poem19403.html","السريع"],[72,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"لي خادم لا أزال أحتسبه","https://www.aldiwan.net/poem8303.html","المنسرح"],[51,"ولما رأيت القيل ينبو شنيعه","https://www.aldiwan.net/poem65917.html","الطويل"],[91,"أنا لست بالحسناء أول مولع","https://www.aldiwan.net/poem8980.html","عموديه"],[49,"تبارك رب لايزال ولم يزل","https://www.aldiwan.net/poem10345.html","الطويل"],[33,"ألا لا أرى وادي المياه يثيب","https://www.aldiwan.net/poem26018.html","الطويل"],[46,"ابن خمسين ضمه عقد تسعين","https://www.aldiwan.net/poem22926.html","الخفيف"],[77,"أهاجتك ذكرى من خليط ومعهد","https://www.poetsgate.com/ViewPoem.aspx?id=33822",""]],"verses":[["ليَخْلُصَ تأمِيلي إلَيْكَ ووِجْهَتي","ويَبْرأُ عزْمي منْ سِواكَ ومَقْصَدي",0,"د",2,0],["لِيُخزِهِمُ إِن لَم تَرِدنِيَ نَبوَةٌ","يُساءُ الفَتى مِن مِثلِها وَيُرابُ",1,"ب",1,0],["لي خَمسَ عَشرَةَ مِن جُمادى لَيلَةً","ما أَستَطيعُ عَلى الفِراشِ رُقادي",2,"ي",1,0],["لي خرقة ضاعت وأنت الذي","نلبس من عرفانه الخرقهْ",3,"ه",1,0],["ليخبر الملك في يمناك عن قلمٍ","صان الأقاليم عن تخبير مستام",4,"م",1,0],["ليَ خمسون صاحباً لو سألتُ ال","قوتَ فيهم ألفيتهُم سُمَحَاءَ",5,"ا",2,0],["لي خادمٌ لا أزال أحتسِبُهْ","يغيب حتى يردَّه سغَبُهْ",6,"ب",2,1],["ليخرقْنَ أسداد المسامِع قبْله","فينْغلَّ في أزرار تلك الغلائل",7,"ل",1,0],["لِيَخِفَّ مَحمَلُهُ فَخَرَّ إِلى الثَرى","وَسَطا عَلَيهِ النَملُ غَيرَ مُرَوِّعِ",8,"ع",1,0],["لِيَخلُ امرُؤٌ دونَ الثِقاتِ بِنَفسِهِ","فَما كُلُّ مَوثوقٍ بِهِ ناصِحُ الجَيبِ",9,"ب",1,0],["لِيَخضَرَّ مَرعاها وَيُخصِبَ أَهلَها","وَيَنمي بِها ذاكَ المَحَلِّ خَصيبُ",10,"ب",1,0],["لِيَخَف صاحِبُ الدِيانَةِ وَالصَو","نِ مَقالاً مِن جاهِلٍ يَتَحَظّى",11,"ظ",2,0],["ليخلص تأميلي إليك ووجهتي","وبيرأ عزمي من سواك ومقصدي",12,"د",2,0]]}