{"poems":[[77,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[73,"أما علمت أن الشفيع شباب","https://www.aldiwan.net/poem11916.html","الطويل"],[27,"بان الخليط فودعوا بسواد","https://www.aldiwan.net/poem5712.html","الوافر"],[72,"يا شيخ أهل العلم والزهد في","https://www.aldiwan.net/poem19403.html","السريع"],[72,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"لي خادم لا أزال أحتسبه","https://www.aldiwan.net/poem8303.html","المنسرح"],[51,"ولما رأيت القيل ينبو شنيعه","https://www.aldiwan.net/poem65917.html","الطويل"],[91,"أنا لست بالحسناء أول مولع","https://www.aldiwan.net/poem8980.html","عموديه"],[49,"تبارك رب لايزال ولم يزل","https://www.aldiwan.net/poem10345.html","الطويل"],[33,"ألا لا أرى وادي المياه يثيب","https://www.aldiwan.net/poem26018.html","الطويل"],[46,"ابن خمسين ضمه عقد تسعين","https://www.aldiwan.net/poem22926.html","الخفيف"],[77,"أهاجتك ذكرى من خليط ومعهد","https://www.poetsgate.com/ViewPoem.aspx?id=33822",""],[187,"حادثات دهمن في أسبوع","https://www.aldiwan.net/poem43630.html","الخفيف"],[212,"مات رشدي مات آها ثم آه","https://www.aldiwan.net/poem46636.html","الرمل"],[283,"الشعر ما زال لسان الزمان","https://www.aldiwan.net/poem32335.html","السريع"],[350,"لي خمرة راس بها الراس","https://www.aldiwan.net/poem15732.html","السريع"],[358,"سلام من لدن روض السلام","https://www.aldiwan.net/poem4146.html","الوافر"],[367,"كفيت في البدر انتكاس الهلال","https://www.aldiwan.net/poem17071.html","السريع"],[378,"صار الإله بحبه متأنسا","https://www.aldiwan.net/poem66913.html","الكامل"],[465,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[469,"لي خليل ليس فيه","https://www.aldiwan.net/poem59748.html","المجتث"],[552,"قل لخل له وإن كان لا يد","https://www.aldiwan.net/poem47384.html","الخفيف"]],"verses":[["ليَخْلُصَ تأمِيلي إلَيْكَ ووِجْهَتي","ويَبْرأُ عزْمي منْ سِواكَ ومَقْصَدي",0,"د",2,0],["لِيُخزِهِمُ إِن لَم تَرِدنِيَ نَبوَةٌ","يُساءُ الفَتى مِن مِثلِها وَيُرابُ",1,"ب",1,0],["لي خَمسَ عَشرَةَ مِن جُمادى لَيلَةً","ما أَستَطيعُ عَلى الفِراشِ رُقادي",2,"د",2,0],["لي خرقة ضاعت وأنت الذي","نلبس من عرفانه الخرقهْ",3,"ه",1,0],["ليخبر الملك في يمناك عن قلمٍ","صان الأقاليم عن تخبير مستام",4,"م",1,0],["ليَ خمسون صاحباً لو سألتُ ال","قوتَ فيهم ألفيتهُم سُمَحَاءَ",5,"ا",2,0],["لي خادمٌ لا أزال أحتسِبُهْ","يغيب حتى يردَّه سغَبُهْ",6,"ب",2,1],["ليخرقْنَ أسداد المسامِع قبْله","فينْغلَّ في أزرار تلك الغلائل",7,"ل",1,0],["لِيَخِفَّ مَحمَلُهُ فَخَرَّ إِلى الثَرى","وَسَطا عَلَيهِ النَملُ غَيرَ مُرَوِّعِ",8,"ع",1,0],["لِيَخلُ امرُؤٌ دونَ الثِقاتِ بِنَفسِهِ","فَما كُلُّ مَوثوقٍ بِهِ ناصِحُ الجَيبِ",9,"ب",1,0],["لِيَخضَرَّ مَرعاها وَيُخصِبَ أَهلَها","وَيَنمي بِها ذاكَ المَحَلِّ خَصيبُ",10,"ب",1,0],["لِيَخَف صاحِبُ الدِيانَةِ وَالصَو","نِ مَقالاً مِن جاهِلٍ يَتَحَظّى",11,"ظ",2,0],["ليخلص تأميلي إليك ووجهتي","وبيرأ عزمي من سواك ومقصدي",12,"د",2,0],["لي خدّان مقرحان فخَذّ","لخضوعي وآخرٌ لدموعي",13,"ع",2,0],["ليخفّ الهول من هذا المصاب","بعدك العيش عذابٌ في عذاب",14,"ب",1,0],["لي خُطبَةٌ كَالدُرِّ نَثراً وَفي","ها النَظمُ أَبهى مِن عُقودِ الحِسان",15,"ن",1,0],["لي خَمرَةُ راسٍ بِها الراسُ","في مِزجِها لِلناسِ إيناسُ",16,"س",1,1],["لِيُخبِرَ عَن فُؤَادٍ فيكَ صَبٍّ","عَمِيدٍ مُنذُ بَينِك مُستَهامِ",17,"م",1,0],["لي خَلَفٌ لِلخَدِّ مِن وَردِهِ","وَردٌ بِهِ يُسقى بِماءٍ زُلال",18,"ل",1,0],["ليخلص الخاطي الأسير بموته","ويؤمه الإنسان وهو تراب",19,"ب",1,0],["ليخشَ نداهُ سائلٌ هزَّ عطفهُ","فما ظنّهُ بالبحر إذ يتموَّج",20,"ج",1,0],["لي خَليلٌ لَيسَ فيهِ","خُلَّةٌ فيها اِختِلالُ",21,"ل",1,1],["لِيَ خوفَ الوشاة ظاهرُ قالٍ","غيرَ أنّي بباطنٍ مشغوفِ",22,"ف",1,0]]}