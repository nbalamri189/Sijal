{"poems":[[79,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[75,"أما علمت أن الشفيع شباب","https://www.aldiwan.net/poem11916.html","الطويل"],[29,"بان الخليط فودعوا بسواد","https://www.aldiwan.net/poem5712.html","الوافر"],[74,"يا شيخ أهل العلم والزهد في","https://www.aldiwan.net/poem19403.html","السريع"],[74,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[53,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[53,"لي خادم لا أزال أحتسبه","https://www.aldiwan.net/poem8303.html","المنسرح"],[53,"ولما رأيت القيل ينبو شنيعه","https://www.aldiwan.net/poem65917.html","الطويل"],[93,"أنا لست بالحسناء أول مولع","https://www.aldiwan.net/poem8980.html","عموديه"],[51,"تبارك رب لايزال ولم يزل","https://www.aldiwan.net/poem10345.html","الطويل"],[35,"ألا لا أرى وادي المياه يثيب","https://www.aldiwan.net/poem26018.html","الطويل"],[48,"ابن خمسين ضمه عقد تسعين","https://www.aldiwan.net/poem22926.html","الخفيف"],[79,"أهاجتك ذكرى من خليط ومعهد","https://www.poetsgate.com/ViewPoem.aspx?id=33822",""],[190,"حادثات دهمن في أسبوع","https://www.aldiwan.net/poem43630.html","الخفيف"],[215,"مات رشدي مات آها ثم آه","https://www.aldiwan.net/poem46636.html","الرمل"],[287,"الشعر ما زال لسان الزمان","https://www.aldiwan.net/poem32335.html","السريع"],[354,"لي خمرة راس بها الراس","https://www.aldiwan.net/poem15732.html","السريع"],[362,"سلام من لدن روض السلام","https://www.aldiwan.net/poem4146.html","الوافر"],[371,"كفيت في البدر انتكاس الهلال","https://www.aldiwan.net/poem17071.html","السريع"],[382,"صار الإله بحبه متأنسا","https://www.aldiwan.net/poem66913.html","الكامل"],[469,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[473,"لي خليل ليس فيه","https://www.aldiwan.net/poem59748.html","المجتث"],[556,"قل لخل له وإن كان لا يد","https://www.aldiwan.net/poem47384.html","الخفيف"],[708,"","https://poetry.dctabudhabi.ae/diwan/poem/145987","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64307","الكامل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67840","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120001","الكامل"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44945","الرمل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46509","الرجز"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26682","الطويل"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101592","المنسرح"],[2256,"","https://poetry.dctabudhabi.ae/diwan/poem/216590",""],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121184","السريع"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102615","المواليا"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58484","الخفيف"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76548","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103860","البسيط"],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141840","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94828","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81937","البسيط"],[4444,"","https://poetry.dctabudhabi.ae/diwan/poem/34749","الخفيف"],[4737,"التنوير","https://www.poetsgate.com/ViewPoem.aspx?id=212156",""],[4755,"مِن أينَ نَحنُ اليَومَ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=184714",""],[4760,"رضوى ..","https://www.poetsgate.com/ViewPoem.aspx?id=35826",""],[4859,"بناء حنبلي!","https://www.poetsgate.com/ViewPoem.aspx?id=202335",""],[4908,"قِسْمَةٌ ضِيزَى","https://www.poetsgate.com/ViewPoem.aspx?id=209087",""],[4978,"يافا","https://www.poetsgate.com/ViewPoem.aspx?id=177226",""],[4987,"عطرها صلف","https://www.poetsgate.com/ViewPoem.aspx?id=49586",""],[5092,"لا موعدٌ لنا","https://www.poetsgate.com/ViewPoem.aspx?id=178713",""],[5143,"ولما أبوا إلا المضيَّ وقد رأوا","https://www.poetsgate.com/ViewPoem.aspx?id=186627",""],[5183,"النافقاء","https://www.poetsgate.com/ViewPoem.aspx?id=186606",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[5431,"زمانٌ لا يكفّ عن الخداع","https://www.poetsgate.com/ViewPoem.aspx?id=215980",""],[5569,"النبض والنبض الآخر","https://www.poetsgate.com/ViewPoem.aspx?id=60535",""],[5616,"نطيحة","https://www.poetsgate.com/ViewPoem.aspx?id=203339",""],[1583,"عيناكِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73061&r=&rc=18",""],[5190,"الشعر والمشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78334&r=&rc=47",""]],"verses":[["ليَخْلُصَ تأمِيلي إلَيْكَ ووِجْهَتي","ويَبْرأُ عزْمي منْ سِواكَ ومَقْصَدي",0,"د",2,0],["لِيُخزِهِمُ إِن لَم تَرِدنِيَ نَبوَةٌ","يُساءُ الفَتى مِن مِثلِها وَيُرابُ",1,"ب",1,0],["لي خَمسَ عَشرَةَ مِن جُمادى لَيلَةً","ما أَستَطيعُ عَلى الفِراشِ رُقادي",2,"د",2,0],["لي خرقة ضاعت وأنت الذي","نلبس من عرفانه الخرقهْ",3,"ه",1,0],["ليخبر الملك في يمناك عن قلمٍ","صان الأقاليم عن تخبير مستام",4,"م",1,0],["ليَ خمسون صاحباً لو سألتُ ال","قوتَ فيهم ألفيتهُم سُمَحَاءَ",5,"ا",2,0],["لي خادمٌ لا أزال أحتسِبُهْ","يغيب حتى يردَّه سغَبُهْ",6,"ب",2,1],["ليخرقْنَ أسداد المسامِع قبْله","فينْغلَّ في أزرار تلك الغلائل",7,"ل",1,0],["لِيَخِفَّ مَحمَلُهُ فَخَرَّ إِلى الثَرى","وَسَطا عَلَيهِ النَملُ غَيرَ مُرَوِّعِ",8,"ع",1,0],["لِيَخلُ امرُؤٌ دونَ الثِقاتِ بِنَفسِهِ","فَما كُلُّ مَوثوقٍ بِهِ ناصِحُ الجَيبِ",9,"ب",1,0],["لِيَخضَرَّ مَرعاها وَيُخصِبَ أَهلَها","وَيَنمي بِها ذاكَ المَحَلِّ خَصيبُ",10,"ب",1,0],["لِيَخَف صاحِبُ الدِيانَةِ وَالصَو","نِ مَقالاً مِن جاهِلٍ يَتَحَظّى",11,"ظ",2,0],["ليخلص تأميلي إليك ووجهتي","وبيرأ عزمي من سواك ومقصدي",12,"د",2,0],["لي خدّان مقرحان فخَذّ","لخضوعي وآخرٌ لدموعي",13,"ع",2,0],["ليخفّ الهول من هذا المصاب","بعدك العيش عذابٌ في عذاب",14,"ب",1,0],["لي خُطبَةٌ كَالدُرِّ نَثراً وَفي","ها النَظمُ أَبهى مِن عُقودِ الحِسان",15,"ن",1,0],["لي خَمرَةُ راسٍ بِها الراسُ","في مِزجِها لِلناسِ إيناسُ",16,"س",1,1],["لِيُخبِرَ عَن فُؤَادٍ فيكَ صَبٍّ","عَمِيدٍ مُنذُ بَينِك مُستَهامِ",17,"م",1,0],["لي خَلَفٌ لِلخَدِّ مِن وَردِهِ","وَردٌ بِهِ يُسقى بِماءٍ زُلال",18,"ل",1,0],["ليخلص الخاطي الأسير بموته","ويؤمه الإنسان وهو تراب",19,"ب",1,0],["ليخشَ نداهُ سائلٌ هزَّ عطفهُ","فما ظنّهُ بالبحر إذ يتموَّج",20,"ج",1,0],["لي خَليلٌ لَيسَ فيهِ","خُلَّةٌ فيها اِختِلالُ",21,"ل",1,1],["لِيَ خوفَ الوشاة ظاهرُ قالٍ","غيرَ أنّي بباطنٍ مشغوفِ",22,"ف",1,0],["لي خطيب واسطي","يعشق الخمر ديانه",23,"ن",2,0],["لَيَخضِبَنْ هَذِهِ مِنْ ذا أبا حَسَنٍ","في حينِ يَخضُبُها مِنْ أحمرٍ قاني",24,"ن",2,0],["لِيُخْبِرَكُمْ عَنْ شَرْحِ حَالي وَمَا جَرى","وَلي مُقْلَةٌ لَمْ يُهْنِهَا سِنَةُ الْكَرى",25,"ر",2,0],["لي خاطر في وصف مجدك طيع","وإذا انتخيت به سواك فجامعُ",26,"ع",1,0],["لي خَمسونَ صَديقاً","بَينَ قاضٍ وَأَميرِ",27,"ر",1,1],["ليخدع الشيخ فَلا يَسير","رَحيله حَتّى تَفوت العير",28,"ر",1,0],["ليخضب منها اليومُ والافقُ أشيبٌ","وينصلَ ثوبُ الليلِ وهو خضيب",29,"ب",1,0],["ليخفض الليل رفع رايته","فذاك جيش الضحى على الأفق",30,"ق",1,0],["ليخ الهَوَى فِيْ الغَرْب منصوب","يَا بِنْ سَنْد مِتْشَرْبكٍ فيه",31,"ي",2,1],["لي خادم مبارك جوهر","من فكرتي وخلوتي صافيه",32,"ي",2,0],["لي خلّ غائب مالي عن لقاه محاص","سمح الذوائب هو عندي أخص الخواص",33,"ص",1,0],["لَي خِلّ من الدّبابِ غليظ","الطبعِ عاتٍ عاصٍ يَصُّدُّ جِماحا",34,"ح",2,0],["لِيَختالَ ذاكَ القَصرُ في وَشيِ زَهرِهِ","كَما اِختالَ مَأمُونٌ عَلى فُرشِ بُورانِ",35,"ن",1,0],["لي خلتان إذا قاني الأسى جزعاً","ونغصا عيشي واستهلكا جلدي",36,"د",2,1],["ليخطف أبصار العدا ببروقها","ويرعب أنصار الصليب ويرعدا",37,"د",2,0],["لي خلَّةٌ يحمدون الصبر عن أربٍ","ويذهبون بأن الصبرَ مأكولُ",38,"ل",1,1],["ليختفي الحق عمن كان ينكره","لكل رجعة عصر في تنقله",39,"ل",2,0],["لي خَليطانِ مُحكَمانِ يُجيدا","نِ لِما يَعمَلانِهِ حاذِقانِ",40,"ن",1,1],["ليخرجَ مِنْ قبورِ الجهلِ موتى","تظنُّ عبادةَ التاريخِ دِينا",41,"ن",2,0],["لِي خَيمَةٌ في القَلبِ عَاهَدْتُهَا","أنْ لا تَرَانِي أرجِعُ القَهْقَرَى",42,"ر",2,0],["لي خلقك الله على روس الكرام","ما رضى تعتاش بالدنيا ذليل",43,"ل",1,0],["لي خافق مهما تمرّد أوهوى","أو تاه في دربِ الغوايةِ وافترى",44,"ر",2,1],["ليْ خوفُ موسى في البلادِ وقُنْبُلَةْ","لكَ مُلْكُ يوسف في الحياةِ وسُنْبُلَةْ",45,"ل",2,1],["ليخسأ أهلُ مؤتمرٍ وحزبٍ","ولو للإفك قد جُمِعَ النصابُ",46,"ب",1,0],["لي خاطر بينه وبين الشقا حلف","ياماعثت فيه المقادير ياما",47,"م",2,0],["ليْ خضارُ الحرف من عينهِ","صار شعري بعدهُ شاحبا",48,"ب",2,0],["لي خيالٌ جامحٌ دائما","فوقهُ أبقى دجىٍ راكبا",48,"ب",2,0],["لَيَخْتَضِمنَّ الهندوانيُّ منهمُ","مَعَاقِدَ يخشاها الطبيبُ المُزاولُ",49,"ل",1,0],["ليخيف القلوب وقع شباه","يا لحرب في كيدها كأداء",50,"ا",2,0],["ليخدع مأفوناً ومن كان جاهلاً","وليس على نهج من الحق والرشد",51,"د",1,0],["ليُخمد كل فكرٍ باشتعال","شرارا قد تطاول باندلاعِ",52,"ع",1,0],["ليخدعَ الحقَّ والآماقُ مبصرةٌ","فيجعل الحقَّ في أهوائه نُتَفا",53,"ف",2,0],["ليخضرّ الزمان على هوانا","ونصعد قمتيْن فنستريحا",54,"ح",2,0],["لي خافق عبث الزمان","به ، ولم يبلغ أَشُدَّه",55,"د",2,0],["لِيْ خافقٌ بين الضلوعِ عرفتُهُ","حُرّاً إذا طَغَتْ الحوادثُ صامدا",56,"د",2,0]]}