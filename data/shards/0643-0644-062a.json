{"poems":[[77,"والله ما البغلة عندي إذا","https://www.aldiwan.net/poem36735.html","السريع"],[71,"لله قاضي ديندوز فإنه","https://www.aldiwan.net/poem3928.html","الكامل"],[23,"أسألت رسم الدار أم لم تسأل","https://www.aldiwan.net/poem21245.html","الكامل"],[72,"الكأس في كف غادة رود","https://www.aldiwan.net/poem18573.html","المنسرح"],[72,"إلى م العشق واللائمة","https://www.aldiwan.net/poem19678.html","السريع"],[51,"قل للأمير أدام الله غبطته","https://www.aldiwan.net/poem10869.html","البسيط"],[51,"لأمورك التكميل والتتميم","https://www.aldiwan.net/poem66061.html","الكامل"],[85,"ابتغوا ناصية الشمس مكانا","https://www.aldiwan.net/poem62947.html","الرمل"],[45,"بسر من را لنا إمام","https://www.aldiwan.net/poem63615.html","مجزوء البسيط"],[28,"كم للملاءة من طيف يؤرقني","https://www.aldiwan.net/poem5089.html","البسيط"],[28,"بكرت علي نوار تنتف لحيتي","https://www.aldiwan.net/poem5269.html","الكامل"],[28,"هذا الذي تعرف البطحاء وطأته","https://www.aldiwan.net/poem5493.html","البسيط"],[49,"أنساك محياك المماتا","https://www.aldiwan.net/poem10844.html","مجزوء الكامل"],[66,"كفي القتال وفكي قيد أسراك","https://www.aldiwan.net/poem38480.html","البسيط"],[66,"قد صبرنا بالوعد منك شهورا","https://www.aldiwan.net/poem38740.html","الخفيف"],[102,"بيض الحمائم حسبهنه","https://www.aldiwan.net/poem33133.html","مجزوء الكامل"],[67,"انظر بحقك في أمر الدواوين","https://www.aldiwan.net/poem18116.html","البسيط"],[75,"هل تملك الدار رجع سائلها","https://www.aldiwan.net/poem69023.html","البسيط"],[50,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[46,"كل تسير به الحياة وما له","https://www.aldiwan.net/poem23318.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85428","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55240","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[106,"قطان","https://www.poetsgate.com/ViewPoem.aspx?id=179571",""],[45,"للنَّاسِ بَدْرانِ لا يَخْفَى طُلُوعُهُمَا","https://www.poetsgate.com/ViewPoem.aspx?id=33083",""],[107,"بك إرتوى وتولى الجور والألم","https://www.aldiwan.net/poem16215.html","البسيط"],[126,"أنت الحبيب المرتضى ولك الهنا","https://www.aldiwan.net/poem50490.html","الكامل"],[126,"يا حبذا بستان قيس الكامل","https://www.aldiwan.net/poem50535.html","الكامل"],[148,"أما يمين محمد","https://www.aldiwan.net/poem68458.html","مجزوء الكامل"],[369,"دارت عيون في محاجر","https://www.aldiwan.net/poem57443.html","مجزوء الكامل"],[377,"واحر غلة قلبي الوقاد","https://www.aldiwan.net/poem48838.html","الكامل"],[388,"كل تزودوولى وين جاابن حسين","https://www.aldiwan.net/poem54471.html","عموديه"],[400,"هذا النسيم أتاك من نجد","https://www.aldiwan.net/poem33970.html","الكامل"],[403,"أحياه بعد الله إذ حياه","https://www.aldiwan.net/poem50091.html","الكامل"],[407,"هاجت هواك بواكر الأظعان","https://www.aldiwan.net/poem67466.html","الكامل"],[407,"طرقتك زائرة فحي خيالها","https://www.aldiwan.net/poem67473.html","الكامل"],[451,"وطن الدولار هذا أم ترى","https://www.aldiwan.net/poem61565.html","الرمل"],[456,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[456,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[456,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[456,"رق لبغداد القضاء والقدر","https://www.aldiwan.net/poem56181.html","الرجز"],[462,"عاد مني الخيال طيف الخيال","https://www.aldiwan.net/poem3497.html","عموديه"],[477,"كل تمنى أن يشابه عودها","https://www.aldiwan.net/poem36894.html","الكامل"],[502,"كلت لسانا سقيما من تصرفه","https://www.aldiwan.net/poem38394.html","عموديه"],[556,"كل تحريك تراه وسكون","https://www.aldiwan.net/poem33843.html","الرمل"],[573,"ليس لي منه سوى لا","https://www.aldiwan.net/poem3032.html","مجزوء الرمل"],[584,"مولاي إنا في جوارك خمسة","https://www.aldiwan.net/poem17470.html","الكامل"]],"verses":[["كِلْتَاهُمَا يَأْتِي عَلَيْهِ الْمَدَى","وَإِنَّمَا النَّفْسُ بِمَطْلُوبِهَا",0,"ه",2,0],["كِلتا يَدَيكَ لِصُنعِها مَبسوطَةٌ","يَتَبارَيانِ كَلَمعِ بَرقٍ أَومَضا",1,"ض",2,0],["كِلتاهُما حَلَبُ العَصيرِ فَعاطِني","بِزُجاجَةٍ أَرخاهُما لِلمَفصِلِ",2,"ل",1,0],["كلتاهما جملةُ الجمالِ فما","بدرُ الدُّجى عندها بمعدود",3,"د",1,0],["كلتاهما للطالبي غوثة","في الفقه والجهل يدٌ حاسمهْ",4,"م",2,0],["كلتا يديك يمينٌ لا شمال لها","مخلوقتان لأمجادٍ وإنجادِ",5,"د",1,0],["كلتاهما لمقبِّلٍ ومؤمِّلٍ","يرجو غياثكَ زمزمٌ وحطيمُ",6,"م",1,0],["كُلُّ تَعليمٍ نَراهُ ناقِصاً","سُلَّمٌ رَثٌّ إِذا اِستُعمِلَ خانا",7,"ن",2,0],["كِلتا يَدَيهِ تَفيضُ سَحّاً","كَأَنَّها ضَرَّةٌ تَغارُ",8,"ر",1,0],["كِلتا يَدَيهِ يَمينٌ غَيرُ مُخلِفَةٍ","تُزجي المَنايا وَتَسقي المُجدَبَ المَطَرا",9,"ر",2,0],["كِلتاهُما أَسَدٌ إِذا حَرَّبتَها","وَرِضاهُما وَأَبيكَ خَيرُ مَعاشِ",10,"ش",1,0],["كِلتا يَدَيهِ غِياثٌ عَمَّ نَفعُهُما","يُستَوكَفانِ وَلا يَعروهُما عَدَمُ",11,"م",1,0],["كُلٌّ تُصَبِّحُهُ المَنِي","يَةُ أَو تُبَيِّتُهُ بَياتا",12,"ت",2,0],["كَلَّت لِحاظُكِ مِمّا قَد فَتَكتِ بِنا","فَمَن تُرى في دَمِ العُشّاقِ أَفتاكِ",13,"ك",1,0],["كُلُّ تِلكَ الشُهورِ بيضٌ وَلَكِن","لَيلَةُ القَدرِ خَيرٌ مِن أَلفِ شَهرِ",14,"ر",1,0],["كلٌّ تقبِّلُ رسمَها","في الماءِ ساعةَ شُربهنَّهْ",15,"ن",2,0],["كُلٌُّ تَرَى كاتِباً لِلسُّوءِ يُنْظَرُهُ","لِنَهْبِهِمْ كَمْ كَذَا عامٍ وكَمْ حِينِ",16,"ن",1,0],["كلتا يمينيك يا ابن ذي يمنٍ","تكرما عم من فواضلها",17,"ل",3,0],["كُلُّ تَيهورَةٍ تَرى دونَها الخا","لَ شُروقاً تُفضي إِلى تَيهورِ",18,"ر",1,0],["كُلٌّ تَسيرُ بِهِ الحَياةُ وَما لَهُ","عِلمٌ عَلى أَيِّ المَنازِلِ يَقدُمُ",19,"م",1,1],["كل تلك السنين وَهي عصور","لَم يزرها النَسيم إلا بَليلا",20,"ل",2,0],["كُلُّ تِلْكَ المَحَامِدِ الغُرِّ بَانَتْ","وَاسْتَقَرَّتْ تِلْكَ المَسَاعِي الجِسَامُ",21,"م",1,0],["كُلٌّ تَقُولُ بِلَحْظِهَا","يَا قَيْسُ إِنِّي بِنْتُ عَامِرْ",22,"ر",1,0],["كلُّ تاريخها كتابٌ منَ الَمْجدِ","كريمٌ مُطَرَّزُ الصَّفَحَاتِ",23,"ت",1,0],["كلٌّ تحدَّى أخاه، غير أنهما","لم يأمنا بطش ربِّ البيت، فاصطلحا",24,"ح",2,0],["كِلْتَا يَدَيْكَ يَمِينٌ لا شِماَل لَهَا","وفي يَمِينِكَ آجَالٌ وأَرْزَاقُ",25,"ق",1,0],["كِلتا يَدَيهِ العُلا حازَت فَباطنها","أَيدٍ وَظاهِرُها لِلناس مُستلم",26,"م",1,0],["كلَّت قريحتيَ التي كالبحرِ أنْ","تحصى ثناءك لو أقمتُ الأَزْمَنَا",27,"ن",2,0],["كلّتْ لسانُ فصاحتي عن وصفه","لوْ كُنت ذَا فَهْمِ كأني باقلُ",28,"ل",1,0],["كلتاهما إن صوّح ال","مرعى لنا طعم وماء",29,"ا",2,0],["كلٌّ تراهُ كالسحا","بةِ بالندى والبأسِ ماطِر",30,"ر",1,0],["كلَّت مَناكب حِيلَتي وَتَجَلُدي","مِما تَزاحَم قُسوة الأَضدادِ",31,"د",1,0],["كل تزودوولى وين جاابن حسين","ماشوف شيء زاد عنده وين زاده فين",32,"ن",1,1],["كل تغير عن خلائقه","حتى السحاب وصادق الرعد",33,"د",1,0],["كَلَّت ملاحظُ مُقلتيه وَإِنَّما","لحظ العُيونِ أَكلُّه أَمضاهُ",34,"ا",2,0],["كِلتا يَدَيكَ أَبا الوَليدِ مَعَ النَدى","خُلِقَت لِقائِمٍ مُنصُلِ وَعِنانِ",35,"ن",1,0],["كِلتا يَدَيكَ جَعَلتَ فَضلَ نَوالِها","لِلمُسلِمينَ وفي العَدُوِّ وَبالَها",36,"ل",3,0],["كل تقدير حباه إنما","كان تقديرا لما قد خلفه",37,"ف",2,0],["كلّ تَروك بالقاع سَقْباً إذا","لوتْ إليه خيشومَها خُرِما",38,"م",2,0],["كلُّ تالٍ أباه يجري كما يج","ري ويسعَى إلى العلاء ويُسعي",39,"ي",1,0],["كلّ تلعاءَ كالبنيّة تعطي","ك سَناماً طوراً وعيناً خفيرا",40,"ر",2,0],["كلتا اليمينين قياسٌ للعلا","ذا ذَرَعَ الأفقَ بها وذا شَبَرْ",41,"ر",1,0],["كلُّ تركيّة المناسب فيها","لمحٌ للغزال والرئبال",42,"ل",1,0],["كل تمنى أن يشابه عودها","مذ عانقته براحتين وساعد",43,"د",1,1],["كَلَّت لِساناً سَقيماً مِن تَصرفه","وصارت لآلي عقودِ النظم منثورا",44,"ر",2,1],["كل تحريك تراه وسكونْ","فانتقال من حياة لمنونْ",45,"ن",1,1],["كلَّتِ الحَرْبُ ولكن","ما شكا منها كَلاَلاَ",46,"ل",2,0],["كُلٌّ تراهُ مِنَ الكآبةِ والطَّوَى","شَبَحاً فَنَحْنُ الخَمْسةُ الأَشْباحُ",47,"ح",1,0]]}