بر القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=177228",""],[4984,"ودع رفاقك","https://www.poetsgate.com/ViewPoem.aspx?id=175794",""],[5187,"حواء وتجربتي","https://www.poetsgate.com/ViewPoem.aspx?id=29256",""],[5232,"سهرة مع الأخطل الصغير","https://www.poetsgate.com/ViewPoem.aspx?id=212497",""],[5277,"العفوُّ جلّ جلاله","https://www.poetsgate.com/ViewPoem.aspx?id=189515",""],[5397,"تبلجت ليلة في سعدها طلعا","https://www.poetsgate.com/ViewPoem.aspx?id=157936",""],[5409,"حياك وادي الرافدين وما به","https://www.poetsgate.com/ViewPoem.aspx?id=155250",""],[5431,"حتى نعود من الأجداث...يُحيينا","https://www.poetsgate.com/ViewPoem.aspx?id=187337",""],[5431,"ياعيد مالك؟....","https://www.poetsgate.com/ViewPoem.aspx?id=204751",""],[5431,"ليس لي في الأمر يد!!...","https://www.poetsgate.com/ViewPoem.aspx?id=214123",""],[5564,"يا لله يارب الخلايق يامعبود","https://www.poetsgate.com/ViewPoem.aspx?id=186844",""],[5605,"هذي المدينة","https://www.poetsgate.com/ViewPoem.aspx?id=159788",""],[2110,"كرعتها وحباب الكأس مشتبك","https://www.poetsgate.com/ViewPoem.aspx?id=156284",""],[5690,"هذا الصباح بدا أم ذا محياكِ","https://www.poetsgate.com/ViewPoem.aspx?id=172170",""],[5756,"الاسرى","https://www.poetsgate.com/ViewPoem.aspx?id=5366",""],[5956,"كل تقصير لديهم بأداء الضَّخِ","https://www.poetsgate.com/ViewPoem.aspx?id=194199",""],[5956,"ابتسم للكون يمنحْك ابتساما","https://www.poetsgate.com/ViewPoem.aspx?id=194582",""],[5956,"حارس الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=206676",""],[6031,"لو أنّ كُلَّ لِسَانٍ لِي يُعَبِّرُ مَا","https://www.poetsgate.com/ViewPoem.aspx?id=46383",""],[6127,"لَمُّ الجراحِ","https://www.poetsgate.com/ViewPoem.aspx?id=202685",""],[463,"رقَّ لبغدادَ القضاءُ والقدرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60077&r=&rc=133",""],[463,"سائلِ الدَّارَ غنْ سألتَ خبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60093&r=&rc=149",""],[6259,"أحياه بعد الله إذ حياه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59407&r=&rc=55",""],[5555,"فِيْ حَضْرَةِ المُتَنَبِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87405&r=&rc=1",""],[5567,"أبدو .. ولا أبدو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81749&r=&rc=21",""]],"verses":[["كِلْتَاهُمَا يَأْتِي عَلَيْهِ الْمَدَى","وَإِنَّمَا النَّفْسُ بِمَطْلُوبِهَا",0,"ه",2,0],["كِلتا يَدَيكَ لِصُنعِها مَبسوطَةٌ","يَتَبارَيانِ كَلَمعِ بَرقٍ أَومَضا",1,"ض",2,0],["كِلتاهُما حَلَبُ العَصيرِ فَعاطِني","بِزُجاجَةٍ أَرخاهُما لِلمَفصِلِ",2,"ل",1,0],["كلتاهما جملةُ الجمالِ فما","بدرُ الدُّجى عندها بمعدود",3,"د",1,0],["كلتاهما للطالبي غوثة","في الفقه والجهل يدٌ حاسمهْ",4,"م",2,0],["كلتا يديك يمينٌ لا شمال لها","مخلوقتان لأمجادٍ وإنجادِ",5,"د",1,0],["كلتاهما لمقبِّلٍ ومؤمِّلٍ","يرجو غياثكَ زمزمٌ وحطيمُ",6,"م",1,0],["كُلُّ تَعليمٍ نَراهُ ناقِصاً","سُلَّمٌ رَثٌّ إِذا اِستُعمِلَ خانا",7,"ن",2,0],["كِلتا يَدَيهِ تَفيضُ سَحّاً","كَأَنَّها ضَرَّةٌ تَغارُ",8,"ر",1,0],["كِلتا يَدَيهِ يَمينٌ غَيرُ مُخلِفَةٍ","تُزجي المَنايا وَتَسقي المُجدَبَ المَطَرا",9,"ر",2,0],["كِلتاهُما أَسَدٌ إِذا حَرَّبتَها","وَرِضاهُما وَأَبيكَ خَيرُ مَعاشِ",10,"ش",1,0],["كِلتا يَدَيهِ غِياثٌ عَمَّ نَفعُهُما","يُستَوكَفانِ وَلا يَعروهُما عَدَمُ",11,"م",1,0],["كُلٌّ تُصَبِّحُهُ المَنِي","يَةُ أَو تُبَيِّتُهُ بَياتا",12,"ت",2,0],["كَلَّت لِحاظُكِ مِمّا قَد فَتَكتِ بِنا","فَمَن تُرى في دَمِ العُشّاقِ أَفتاكِ",13,"ك",1,0],["كُلُّ تِلكَ الشُهورِ بيضٌ وَلَكِن","لَيلَةُ القَدرِ خَيرٌ مِن أَلفِ شَهرِ",14,"ر",1,0],["كلٌّ تقبِّلُ رسمَها","في الماءِ ساعةَ شُربهنَّهْ",15,"ن",2,0],["كُلٌُّ تَرَى كاتِباً لِلسُّوءِ يُنْظَرُهُ","لِنَهْبِهِمْ كَمْ كَذَا عامٍ وكَمْ حِينِ",16,"ن",1,0],["كلتا يمينيك يا ابن ذي يمنٍ","تكرما عم من فواضلها",17,"ل",3,0],["كُلُّ تَيهورَةٍ تَرى دونَها الخا","لَ شُروقاً تُفضي إِلى تَيهورِ",18,"ر",1,0],["كُلٌّ تَسيرُ بِهِ الحَياةُ وَما لَهُ","عِلمٌ عَلى أَيِّ المَنازِلِ يَقدُمُ",19,"م",1,1],["كل تلك السنين وَهي عصور","لَم يزرها النَسيم إلا بَليلا",20,"ل",2,0],["كُلُّ تِلْكَ المَحَامِدِ الغُرِّ بَانَتْ","وَاسْتَقَرَّتْ تِلْكَ المَسَاعِي الجِسَامُ",21,"م",1,0],["كُلٌّ تَقُولُ بِلَحْظِهَا","يَا قَيْسُ إِنِّي بِنْتُ عَامِرْ",22,"ر",1,0],["كلُّ تاريخها كتابٌ منَ الَمْجدِ","كريمٌ مُطَرَّزُ الصَّفَحَاتِ",23,"ت",1,0],["كلٌّ تحدَّى أخاه، غير أنهما","لم يأمنا بطش ربِّ البيت، فاصطلحا",24,"ح",2,0],["كِلْتَا يَدَيْكَ يَمِينٌ لا شِماَل لَهَا","وفي يَمِينِكَ آجَالٌ وأَرْزَاقُ",25,"ق",1,0],["كلّ تكبيرة على الرّمل نفح","وعبير سكب وأيك بليل",26,"ل",1,0],["كِلتا يَدَيهِ العُلا حازَت فَباطنها","أَيدٍ وَظاهِرُها لِلناس مُستلم",27,"م",1,0],["كلَّت قريحتيَ التي كالبحرِ أنْ","تحصى ثناءك لو أقمتُ الأَزْمَنَا",28,"ن",2,0],["كلّتْ لسانُ فصاحتي عن وصفه","لوْ كُنت ذَا فَهْمِ كأني باقلُ",29,"ل",1,0],["كلتاهما إن صوّح ال","مرعى لنا طعم وماء",30,"ا",2,0],["كلٌّ تراهُ كالسحا","بةِ بالندى والبأسِ ماطِر",31,"ر",1,0],["كلَّت مَناكب حِيلَتي وَتَجَلُدي","مِما تَزاحَم قُسوة الأَضدادِ",32,"د",1,0],["كل تزودوولى وين جاابن حسين","ماشوف شيء زاد عنده وين زاده فين",33,"ن",1,1],["كل تغير عن خلائقه","حتى السحاب وصادق الرعد",34,"د",1,0],["كَلَّت ملاحظُ مُقلتيه وَإِنَّما","لحظ العُيونِ أَكلُّه أَمضاهُ",35,"ا",2,0],["كِلتا يَدَيكَ أَبا الوَليدِ مَعَ النَدى","خُلِقَت لِقائِمٍ مُنصُلِ وَعِنانِ",36,"ن",1,0],["كِلتا يَدَيكَ جَعَلتَ فَضلَ نَوالِها","لِلمُسلِمينَ وفي العَدُوِّ وَبالَها",37,"ل",3,0],["كل تقدير حباه إنما","كان تقديرا لما قد خلفه",38,"ف",2,0],["كلّ تَروك بالقاع سَقْباً إذا","لوتْ إليه خيشومَها خُرِما",39,"م",2,0],["كلُّ تالٍ أباه يجري كما يج","ري ويسعَى إلى العلاء ويُسعي",40,"ع",2,0],["كلّ تلعاءَ كالبنيّة تعطي","ك سَناماً طوراً وعيناً خفيرا",41,"ر",2,0],["كلتا اليمينين قياسٌ للعلا","ذا ذَرَعَ الأفقَ بها وذا شَبَرْ",42,"ر",1,0],["كلُّ تركيّة المناسب فيها","لمحٌ للغزال والرئبال",43,"ل",1,0],["كل تمنى أن يشابه عودها","مذ عانقته براحتين وساعد",44,"د",1,1],["كَلَّت لِساناً سَقيماً مِن تَصرفه","وصارت لآلي عقودِ النظم منثورا",45,"ر",2,1],["كل تحريك تراه وسكونْ","فانتقال من حياة لمنونْ",46,"ن",1,1],["كلَّتِ الحَرْبُ ولكن","ما شكا منها كَلاَلاَ",47,"ل",2,0],["كُلٌّ تراهُ مِنَ الكآبةِ والطَّوَى","شَبَحاً فَنَحْنُ الخَمْسةُ الأَشْباحُ",48,"ح",1,0],["كلٌّ تراها يحاكي البدر طلعتها","والدرُّ مبسمهَا والوردُ منتقَبا",49,"ب",2,0],["كلتاهما حقا يمي","نٌ في قَضِيَّات البيان",50,"ن",1,0],["كل تاج وإن تعاظم قدرا","دون كبد من أحقر الأكباد",51,"د",1,0],["كلت الالسن من ان","تبلغن قدرك وصفا",52,"ف",2,0],["كل تلابس إلّا أن يميّزها","من ذا ومن ذين وسم الدلّ والخفَر",53,"ر",1,0],["كلتا يَداها","تين وَزَيتون",54,"ن",1,0],["كلٌّ ترى نفسها كلَّ الجمال بها","مستودع وعليها الحسن مُقتَصَرُ",55,"ر",1,0],["كلَّت قوى اللُّبِّ واعتلَّت مشاعِرُهُ","مهما البصائِرُ همَّت كشفَ لُجَّتُهُ",56,"ه",1,0],["كلتاهما راح السرور وإنما","أحلاهما الراح التي للعين",57,"ن",1,0],["كَلَّت فَقُلتُ لَها كَلالُكِ مُعقِبٌ","تَرفِيهَ ظَهرِكِ غابِرَ الأَزمانِ",58,"ن",1,0],["كَلَّتْ لساني من الشكوى إِليكِ فلا","وصلٌ ولا صلةٌ للمغرم الشاكي",59,"ك",2,0],["كلتاهما مدت اليها يداً","راغت على اعدائها ماصعه",60,"ع",2,0],["كِلتاهُما أُبطِنَت أَحشاؤُها قَصَباً","مِن بَطنِ حَليَةَ لا رَطباً وَلا نَقِدا",61,"د",2,0],["كَلَّتْ ظُبَا تصبري","في حب ظبي الكِلَّه",62,"ل",2,0],["كلتا يديّ يمين ربي خلقته","والله قد أخفى عليَّ شمالي",63,"ل",2,0],["كلتاهما حلب العصير فعاطني","ما كان يحلو في الزمان الأولِ",64,"ل",1,0],["كُلُّ تاجٍ إِلى التَفَكُّكِ يَوماً","غَيرُ تاجِ المُسَيطِرِ المَعبودِ",65,"د",1,0],["كُلّ تَختٍ مِنَ الزُمُرُّدِ مُه","تَزٌّ عَلَيهِ مُطربٌ يَقِفُ",66,"ف",1,0],["كِلتاهُما رَوضٌ وَلَكِن هَذِهِ","يُلفى جَناها لَو تُنَوِّلُ أَطيَبا",67,"ب",2,0],["كُلُّ تَعليمِهِم لَنا نِصفُ قَرنٍ","أَن يُهابَ الأَميرُ وَالمَأمورُ",68,"ر",1,0],["كلٌّ تساوى فيك لكنها","ذلك لم يحلم وهذا حليم",69,"م",1,0],["كلتا يديه ربيع عند ذي خلفٍ","بحريفيض وهادي عارض هزم",70,"م",1,0],["كُلٌّ تَراه بِحومة المي","دان بِالكرّار يَشبه",71,"ب",2,0],["كَلَتْ سيوفُ لَحْظِ مَنْ هَوَيْتُهُ","وَضُرِّجَتْ مِنَ القلوبِ بالدَّمِ",72,"م",1,1],["كلت رحالي واعواني وأحراسي","إلى الأمير وإدلاحي وإملاسي",73,"س",2,1],["كل تلك الجنان في القصر ليست","تتساوى وجنة من خدود",74,"د",1,0],["كل تلك العيوب أشباح ليل","تتراءى متى فقدنا ذكاء",75,"ا",2,0],["كلّ تخير في الحياة شريكةً","وشريكتي هذي هجرت سواها",76,"ا",3,0],["كل تعاوده الذكرى فيصرعها","وليس في نصره يوما بمرتاب",77,"ب",1,0],["كلتاهما نار تَوقَّدُ بالحَشا","هَذِي لتنضَحَ والدموعُ لتَنضُبا",78,"ب",2,0],["كَلّت يداي وضاق وُسْعُ قَريحتي","ولسانُ حالي عن لساني أَعْرَبا",78,"ب",2,0],["كُلٌّ تَمَنّى من جوى البرحاءِ","من أَكبد لوصلها ظماءِ",79,"ا",2,0],["كلت الثَناء إِلى اِمرئٍ","يثني عَلَيكَ مَدى الحقب",80,"ب",1,0],["كلٌّ تفاءل بالنجاح وبالهنا","حَسْبانُ جدِّك صائبٌ لا يُثلم",81,"م",1,0],["كلتهما تطبيني نحو جبلتها","كالصيد ينشب بين الذئب والأسد",82,"د",1,0],["كِلتَا كَذاكَ اثنانِ واثنتانِ","كابنَينِ وابنتَينِ يَجريَانِ",83,"ن",1,0],["كل تلوذ باخرى خيفةً أترى","ينجي المخوف مخوفاً أن إليه لجا",84,"ج",2,0],["كِلتَاهُما في أَصلِ مَذهَبِ مالِكٍ","خَمسونَ ميلاً نَقصُها ميلانِ",85,"ن",1,0],["كِلتاهُما تَبقى ثَلاثَةَ أَشهُرٍ","حُكماهُما في النَصِّ مُستَويانِ",85,"ن",1,0],["كِلتا يَديَ رَبّي يَمينٌ وَصفُها","وَهُما عَلى الثَقَلَينِ مُنفِقَتانِ",85,"ن",1,0],["كلّت لحاظكِ مما قد فَتكتِ بها","فهل جرى أحدٌ بالفتك مجراكِ",86,"ك",1,0],["كلٌّ تولّى فولّى العيشُ أَطيبه","وَعُدتُ أَنهجُ حُزناً غَير منتهج",87,"ج",1,0],["كُلٌّ تَفرّد في محاسنه كَما","بِالعلم أَحمد للكمالات اِرتَقى",88,"ق",2,0],["كُلٌّ تَولّى ما علمت بقدره","لَكن تحقّقت الَّذي قَد أَعقبا",89,"ب",2,0],["كُلُّ تَمدينٍ تَراهُ","زَخرٌف مِن صُنعِ وَبشِ",90,"ش",1,0],["كل تحمل فوق غاية جهده","منه وكل مجهد في ضعفه",91,"ف",2,0],["كل تنادي ولا غاوت يجيب ندا","أين السرايا سرايا إخوتي وأبي",92,"ب",2,0],["كُل تَفرعه الهَوى وَأَصابه","سَهم العُيون النَجل مِن أَحبابه",93,"ب",2,0],["كلتا يديه يمين في نوالهما","والناس من سيبه ما عاش في رغد",94,"د",1,0],["كَلَّت عِشارٌالُمزنِ عنها وانثنت","عَنا وَقد بَقيت هُناكَ شعابُها",95,"ب",3,0],["كل تراهُ بكل فضلٍ مفرداً","وهما بيوم كريهةٍ جمعان",96,"ن",1,0],["كِلتُ لَهُ بِالَّذي قَد كانَ لي زَمَناً","هذا بِذاكَ وَلا عَتب عَلى الزَمَنِ",97,"ن",1,0],["كلتاهما اذكت بمهجتي الهوى","وبذكر كل منهما يتسعر",98,"ر",1,0],["كلتاهما انسى ومطمح ناظري","شوقا واول ما ببالي يخطر",98,"ر",1,0],["كلتاهما قد قلدتني منة","كبرى لها ما دمت حيا اشكر",98,"ر",1,0],["كلٌّ تغذَّى بألبان الرشاد ومن","ثدى النبوة كلٌّ عاد مرتضعا",99,"ع",2,0