{"poems":[[23,"أبلغ ربيعة وابن أمه نوفلا","https://www.aldiwan.net/poem21450.html","الكامل"],[53,"لو كنت تخلد خلد لؤمك","https://www.aldiwan.net/poem11452.html","مجزوء الكامل"],[53,"يا خالد ابن الخالدات","https://www.aldiwan.net/poem65801.html","مجزوء الكامل"],[87,"أيها العمال أفنوا العمر","https://www.aldiwan.net/poem63778.html","مجزوء الرمل"],[63,"أهجرا كان صدك أم ملالا","https://www.aldiwan.net/poem51492.html","الوافر"],[99,"قسوت فلم نجد ظلا يقينا","https://www.aldiwan.net/poem24406.html","الوافر"],[33,"أنى تذكر زينب القلب","https://www.aldiwan.net/poem42650.html","الكامل"],[42,"تلك عرسي تلومني في التصابي","https://www.aldiwan.net/poem42300.html","الخفيف"],[52,"أهجرت عبدة أم عداك مسير","https://www.aldiwan.net/poem63827.html","الكامل"],[48,"لا تصحبن يد الليالي فاجرا","https://www.aldiwan.net/poem22573.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[102,"منها وإليها","https://www.poetsgate.com/ViewPoem.aspx?id=50159",""],[170,"أهجو متاعي بألف بيت","https://www.aldiwan.net/poem47031.html","مخلع البسيط"],[228,"إنزعوا مني قلبي","https://www.aldiwan.net/poem41878.html","مجزوء الرمل"],[230,"أهجر النوم في طلاب العلاء","https://www.aldiwan.net/poem55222.html","الخفيف"],[285,"أما والهوى يوم استقل فريقها","https://www.aldiwan.net/poem60780.html","الطويل"],[463,"مالك لا تطرب يا حادي النعم","https://www.aldiwan.net/poem55901.html","الرجز"],[463,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[466,"لمن جيرة دون اللوى والشقائق","https://www.aldiwan.net/poem15088.html","الطويل"],[511,"بشراي أبصرتك خير إمام","https://www.aldiwan.net/poem2462.html","الكامل"],[569,"اهجر معنى القلب عندك جائز","https://www.aldiwan.net/poem856.html",""],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66637","الكامل"],[1065,"","https://poetry.dctabudhabi.ae/diwan/poem/177909","الطويل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56640","السريع"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95575","الرمل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48954","الخفيف"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/12032","الخفيف"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109337","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89551","البسيط"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46754","المنسرح"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83245","الوافر"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93825","الكامل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127403","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201071","البسيط"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115679","الخفيف"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35856","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91667","الهزج"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132110","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114281","المجتث"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102750","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73237","الكامل"],[4755,"يا مَوطِنِي.. أَطَبَعْتَ ذُلَّكَ","https://www.poetsgate.com/ViewPoem.aspx?id=183839",""],[4788,"دنياك","https://www.poetsgate.com/ViewPoem.aspx?id=132268",""],[4915,"اهجريني","https://www.poetsgate.com/ViewPoem.aspx?id=211398",""],[5105,"أهجر رشادَكَ في وَصْلِ ابنةِ العنب","https://www.poetsgate.com/ViewPoem.aspx?id=135328",""],[5106,"مِنْ أَيْنَ أَبْدَأُ يَاْ أُمَيُّ خِطَابِيْ ..","https://www.poetsgate.com/ViewPoem.aspx?id=156841",""],[5284,"خيبَةُ أبي تمَّام","https://www.poetsgate.com/ViewPoem.aspx?id=190602",""],[5431,"المال...رأسُ الفضائل في الدُنى هجرانُه","https://www.poetsgate.com/ViewPoem.aspx?id=199562",""],[5561,"يوم ذي قار","https://www.poetsgate.com/ViewPoem.aspx?id=208542",""],[5573,"خيرتك اختار","https://www.poetsgate.com/ViewPoem.aspx?id=200220",""],[5660,"وَ كَم تَنَدَّرَ بِالعُقَلاءِ مِن خَبِلِ","https://www.poetsgate.com/ViewPoem.aspx?id=29466",""],[5841,"سافرت في فكري وْ هجيت","https://www.poetsgate.com/ViewPoem.aspx?id=37007",""],[5861,"وألوذ بي","https://www.poetsgate.com/ViewPoem.aspx?id=193774",""],[5923,"سورية الميساء","https://www.poetsgate.com/ViewPoem.aspx?id=150626",""],[5956,"شوقي لك يزدادُ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182224",""],[5956,"كم أبتغي إضحاككم","https://www.poetsgate.com/ViewPoem.aspx?id=192423",""],[5956,"آهِ جافاني","https://www.poetsgate.com/ViewPoem.aspx?id=192492",""],[5957,"ظنون الوقت","https://www.poetsgate.com/ViewPoem.aspx?id=204051",""],[6046,"أيها الخائفون...شكراً","https://www.poetsgate.com/ViewPoem.aspx?id=36245",""],[285,"أما وَالهَوى يَوْمَ اسْتَقَلَّ فَرِيقُها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7313&r=&rc=10",""],[6238,"فجر الخليل...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86776&r=&rc=5",""],[6129,"للمجاهدين في العراق وللبطلة العظيمة (ميسون)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74364&r=&rc=2",""]],"verses":[["أَهَجَوتَ حَمزَةَ أَن تُوَفِّيَ صابِراً","وَكَفاكَ أَهلُكَ كَالرِئالِ الرُزَّحِ",0,"ح",1,0],["أهجوتني وحسبتني","يا ابن الخبيثة راقدا",1,"د",2,0],["أهجوْتَني وحسِبتني","ممَّن يضيعُ لديه قرضُك",2,"ك",1,0],["اِهجُروا الخَمرَ تُطيعوا ال","لَهَ أَو تُرضوا الكِتابا",3,"ب",2,0],["أهجراً كانَ صَدُّك أم مَلاَلا","وبِرّاً كَان وصلُك أم خَيالا",4,"ل",2,1],["أهجراً في الصبابة بعد هجرٍ","أرى أيامَه لا ينتهينَا",5,"ن",2,0],["أَهَجَرتِنا ثُمَّ اِعتَلَلتِ لَنا","وَلَقَد نَرى أَن ما لَنا ذَنبُ",6,"ب",1,0],["أَهجَرَت في المَلامِ تَزعمُ أَنّي","لاحَ شَيبي وَقَد تَوَلّى شَبابي",7,"ب",2,0],["أًهَجَرتَ عَبدَةَ أَم عَداكَ مَسيرُ","لا بَل تُلِمُّ بِأَهلِها وَتَدورُ",8,"ر",1,1],["أَهجُر وَلا تَهجُر وَهَجِّر ثُمَّ لا","تُهجِر فَيُذهِبَ ماءَكَ الإِهجارُ",9,"ر",1,0],["اهجر بلاداً بها الشا","عر المجيد مضاع",10,"ع",1,0],["آه جفّ النشيد إلاّ نشيدا","أنا فيه أذوب عضوا فعضوا",11,"و",2,0],["أَهْجو متاعي بألفِ بيتٍ","إذْ رَدَّ بَيْتي بلا متاعِ",12,"ع",1,1],["أَهجرِ الكَونَ فَمِصباحُ الوُجود","لَيسَ فيهِ زَيت",13,"ت",1,0],["أهجُرِ النَومَ في طِلابِ العَلاءِ","وَصلِ الصُبحَ دائِباً بِالمَساءِ",14,"ا",2,1],["أَهَجْراً وَبَيْناً شَدَّ ما ضَمِنَ الْجَوى","لِقَلْبِيَ دانِي صَبْوةٍ وَسَحِيقُها",15,"ق",3,0],["اُهجُمْ على الأمر إذا اتقيتَه","وقم إذا قالت لك العلياءُ قُمْ",16,"م",1,0],["أهجره غيرَ جليدٍ على","هجرٍ وأجفوه لغير الملالْ",17,"ل",1,0],["أهجراً وما أضمرت غدراً ولا سرى","مشيبي في ليل الشباب الغُرانق",18,"ق",1,0],["أهجَعتُ نومي لابساً خِلعَ الدُّجى","وَحدي فَما عَرَجتُ بالنُّوّامِ",19,"م",1,0],["اهجر معنى القلب عندك جائز","وأنت له دون البرية حائز",20,"ز",1,1],["أَهَجَرْتَ قومَك طاعِناً في دينِهم","وسلكتَ غيرَ مسالكِ الفُقَهاء",21,"ا",2,0],["أهجرٌ وصد وافتراق وغربة","وبينٌ فيا لله كم يحمل الصبُّ",22,"ب",1,1],["أهجوك إن الهجو لي مأثم","وقدرك الأدنى به يرفع",23,"ع",1,0],["أهجر الخمرة إن كنت فتى","واحذر الميسر بئس الميسرُ",24,"ر",1,0],["أُهجُريه فبئسَ وصلُ حبيب","حبُّه يُنبت الغَضا والقَتاد",25,"د",1,0],["أُهجُرونا إِن شِئتُمُ أَوصِلونا","قَد شَرِبنا مِن كُلِّ مُرٍّ وَحُلوِ",26,"و",1,0],["أهجت علينا كل باغ مكشر","وأطمعت فينا كل طاغ مشمر",27,"ر",1,0],["أَهَجتُمُ أَسداً تُدمي أَظافِرهُ","كَم أَصيَدٍ تَرَكَت في التُربِ مُعتَفِرا",28,"ر",2,0],["أَهجُرُهُ ثُمَّ تَنقَضي غُبَّرُ ال","هِجرانِ عَنّي وَلَم أَقُل قَذَعا",29,"ع",2,0],["أَهَجتَ عَواطِفي فَذَكَرتُ عَهداً","قَطَعتُ بِهِ الصبا أَرعى الخَدينا",30,"ن",2,0],["أهجوتهم من حيث لم تلق المنى","أو ينبغي أغلى المنى للأرخص",31,"ص",1,0],["أهجت مني شعورا كامنا فبدا","رغمي وأبرزته في بعض أبيات",32,"ت",1,0],["أهجوهمُ بعطائي للهجاء لهم","يستقرضون الهجا واذلَّ قرضهمُ",33,"م",1,0],["اهجر الخلق ما استطعت مليا","تكتفى شرهم ويكفون شرك",34,"ك",1,1],["أُهجُر أَوالا مَجمَعَ الأَشرارِ","وَاِسلَم هُديتَ بِدينِكَ المُختارِ",35,"ر",1,1],["أَهجتَ الشوقَ من قَلبي","أَيا وادي الخَليلاتِ",36,"ت",1,1],["اهجر شريكك تسلم من غوائله","وانبذه فهو مريض الصيت معلول",37,"ل",1,0],["أهجُر وَتِه وَاجفُ وَابعُد","يَا لَيتَ بَينِي وَبَينَك",38,"ك",1,0],["أهجت مني غراما كان مكتنزا","في طي قلب بأنواع الشجون بلى",39,"ل",2,0],["أُهجر وَصُدَّ فَمَا جَفاكَ بضائري","مَن لي سَميُّكَ الظَّلامِ مُسَامِرُ",40,"ر",1,0],["أَهَجَرتَ مَن يُسقِطْنَ أَزمِنَةً","وعَشِقتَ مَن يَرفَعنَ أفخَاذا!",41,"ذ",2,0],["اهجر مجالسها وكب دلالها","لا شيمةٍ فيها ولا آداب",42,"ب",1,0],["اهجريني .. فلم أعُد أتسلَّى","بالهوى فالغرامُ صارَ مِملَّا",43,"ل",2,1],["أهجر رشادَكَ في وَصْلِ ابنةِ العنب","ولا تعقّنَّ أمرَ اللهوِ واللعبِ",44,"ب",1,1],["أَهَجَرْتَنِيْ .. وَتَرَكْتَ وَجْهَكَ ضَاْرِبَاً","تَحْتَ الجُفُونِ خَيَاْمَهُ لِعِتَاْبِيْ",45,"ب",2,0],["أَهَجَرْتِنَيْ .. وَالصَّوْتُ مِنْ طَرَفِ المَدَىْ","يَأْتِيْ صَدَاْهُ مَطْرَةً بِشِعَاْبِيْ",45,"ب",2,0],["أَهَجَرْتَنِيْ .. وَاللَّيلُ شَبَّبَ نَايَهُ","فَوْقَ الشُّمُوْعِ عَلَىْ ضَنَىْ أَهْدَاْبِي",45,"ب",2,0],["أَهَجَّنُوا السَّيفَ أمْ مازالَ مُنتشياً","في غمرةِ النَّصرِ يرويْ عِزَّةَ الحِقَبِ",46,"ب",1,0],["اهجره حقا تستقم في عيشةٍ","رأسُ الفضائل في الدُنى هجرانُه",47,"ن",2,0],["اهجر نشيجَكَ وامتشقْ سيفَ الغَضَبْ","واكتبْ لهيبَكَ إنَّ قلبَكَ يلتَهِبْ",48,"ب",1,1],["أهجرني أرجوك ارحل واترك اوطاني","معاد ابي منك بالهامك تسليني",49,"ن",2,1],["أَهجو فَأُنصِفُ لا أَبغي عَلى أَحَدٍ","أَنأى بِنَفسي عَنِ الأَحقادِ وَ الزَّلَلِ",50,"ل",1,0],["اهجي الحزن للغزل اهويت","شعري نقي وربي مْعافيه",51,"ف",3,0],["أهجوهُ في حرفي الكسير","وما هجوتُ لغيرِ أُفّي",52,"ف",2,0],["آهٍ جوابي كان حين أجبتها","فلهيب صدريَ ما انطفا بالماءِ",53,"ا",2,0],["أهجر المنزلَ.. أو في البيت أبقى","مستطيراً، كل شيء بيَ ضاقا",54,"ق",2,0],["أهجوك، لكن في فؤادي مادحٌ","إن الدّعابة تستريح لعبستكْ",55,"ك",1,0],["آهِ جافاني ولم يُقْبِلْ إليَّا","ليلةَ الأمس، وَيَأْسي قد تَهَيَّا",56,"ي",2,1],["أهجي ظنون الوقت في غفلةٍ","وأنزوي كناسكٍ يرجفُ",57,"ف",1,0],["اُهْجُرُوا واحةَ الهِدايةِ طَوْعاً","وانعُمُوا بِالصحراءِ... مَنْ يتردَّدْ ؟!",58,"د",1,0],["أهَجْراً وبيناً شدَّ ما ضمنَ الجَوى","لقلبيَ دانِي صبوة ٍ سحيقُها",59,"ق",3,0],["اُهجُرْ براءَتكَ التي طرّزتَها","وانهَضْ لِحتفِكَ فالشَّهادةُ قادِمةْ",60,"م",2,0],["اهجر الدنيا ولاتحفل بها","لغبيٍ أو جباناً يرتعد",61,"د",1,0]]}