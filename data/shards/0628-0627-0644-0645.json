,""],[5975,"وداعاً","https://www.poetsgate.com/ViewPoem.aspx?id=52976",""],[5975,"في ولاء آل بيت الرسول2","https://www.poetsgate.com/ViewPoem.aspx?id=53467",""],[6056,"شمس حبي","https://www.poetsgate.com/ViewPoem.aspx?id=130140",""],[6056,"الحظ الأقشر","https://www.poetsgate.com/ViewPoem.aspx?id=156697",""],[6110,"في كاظمة أو ذي سلم","https://www.poetsgate.com/ViewPoem.aspx?id=141177",""],[6124,"المواعيد الحزينة","https://www.poetsgate.com/ViewPoem.aspx?id=174940",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[463,"سائلِ الدَّارَ غنْ سألتَ خبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60093&r=&rc=149",""],[402,"بالمس أمته من بيته اتخذت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54034&r=&rc=886",""],[4222,"ما بعد يومك للمعنى المدنف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52838&r=&rc=130",""]],"verses":[["بِالمالِ طَوراً وَبِالأَهلينَ آوِنَةً","ما أَضيَعَ المَرءَ بَعدَ الأَهلِ وَالمالِ",0,"ل",1,0],["بالمُسْتَثيرِ المَجْدَ منْ سَكَناتِهِ","حتّى يوَشِّحَ تالِداً بطَريفِ",1,"ف",1,0],["بِالمُرهَفاتِ كَأَنَّ لَمعَ ظُباتِها","لَمعُ السَواري في الصَبيرِ الساري",2,"ر",2,0],["بالمذهبات المعجبا","ت لمفحم منا وشاعرْ",3,"ر",1,0],["بالمضمحلّ المؤمل الخادع للارك","ب عمّا تضمن القرب",4,"ب",1,0],["بِالمَرجِ إِذ أُمُّ بَسّامٍ تُناشِدُني","بَناتُ عَمِّكَ يا حارِ بنَ حَمدانِ",5,"ن",1,0],["بِالمُستَوي دونَ نَعفِ القُفِّ مِن قَطَنٍ","فَالدافِعاتِ أُلاتِ الطَلحِ وَالضالِ",6,"ل",1,0],["بالمجتدي في يسره وخصاصة","والمجتلي في حلّةٍ ومرَفَّع",7,"ع",1,0],["بالمشبع الخمص حيثُ القاصدين له","كالطير تتبع إرسالاً بإرسال",8,"ل",1,0],["بالمنايا تَغْتال أَشْهى أَمانيَّ","وتُذوي محاجري وشِفاهي",9,"ي",1,0],["بالمجلس الممتع ما لم تزد","فيه ابنةَ الكرم وشعرَ الخليل",10,"ل",1,0],["بِالمالِ وَالزَرع وِبِالأَنفُسِ ما","أَنسى الوَباءَ وَالذِئابَ وَالدَبا",11,"ا",1,0],["بالمشتري برّده فهو له","نعم البرود إذا هما اعتنقا",12,"ق",2,0],["بِالمَهارى يَلبَسنَ ثَوباً جَديداً","مُستَفادَن في كُلِّ وَقتٍ جَديدِ",13,"د",1,0],["بِالمُردَفاتِ إِذا اِلتَقَينَ عَشِيَّةً","يَبكينَ خَلفَ أَواخِرِ الأَكوارِ",14,"ر",1,0],["بِالمَشرَفِيِّ وَالقَنا المُسَدَّدِ","وَالضَربَ بِالخَطِّيِّ وَالمُهَنَّدِ",15,"د",1,0],["بِالمُصعَبِيّينَ الَّذينَ كَأَنَّهُم","آسادُ أَغيالٍ وَجِنُّ صَريمِ",16,"م",1,0],["بِالمَهارى يَجُلنَ فيهِ وَقَد جا","لَت عَلى مُسنَماتِهِنَّ الغُروضُ",17,"ض",1,0],["بِالمُجتَبى وَالمُصطَفى وَالمُستَرى","لِلحَمدِ وَالحالي بِهِ وَالكاسي",18,"س",2,0],["بِالمُلكِ عَنكَ رِضاً وَجابِرُ عَظمِهِ","أَرضى وَبِالدُنيا عَلَيكَ قَرارُ",19,"ر",1,0],["بالمسلمين وأنتَ من آمالهم","ظَمَأٌ إليكَ مُبَرِّحٌ وأُوامُ",20,"م",1,0],["بالمانعين الحقَّ رِيعَ لِواؤُه","والدّافعينَ عن الحِمَى الأخطارا",21,"ر",2,0],["بِالمَغرِبَينِ مَمالِكٌ أَودى بِها","عَبَثُ الخَلائِفِ مِن بَني قَحطانِ",22,"ن",1,0],["بِالمُقرِباتِ المُبعِدا","تِ الطامِحاتِ مَعَ الطَوامِح",23,"ح",1,0],["بِالمَيسِ وَالحُصُرِ الجِيا","دِ يَزينُها رَقمُ العَثاكِل",24,"ل",1,0],["بِالمَرجِ مَرجِ الصينِ حَيثُ تَبَيَّنَت","مُضَرُ العِراقِ مَن الأَعَزُّ الأَكثَرُ",25,"ر",1,0],["بِالمَوتِ لا بِالسُلُوِّ عَنكِ فَقَد","حَمَّلتِني ما قَد اِنقَضَ الإِبلا",26,"ل",2,0],["بِالمُكتَفي كُفِيَ الأَنامُ هُمومَهُم","وَغَدا عَلَيهِم طالِعٌ مَسعودُ",27,"د",1,0],["بالمُصْطَفَى المُجْتَبَى خَيْرِ الأنامِ ومَنْ","جَلاَلَةً نَزَلَتْ في مَدْحِهِ السُّوَرُ",28,"ر",1,0],["بالمَشَرفيِّاتِ منَ البِيضِ أوْ","بالزّاعِبِيّاتِ مِنَ الزُّرْقِ",29,"ق",1,0],["بالمناديل والغِلالةِ","والنعلِ والرداء",30,"ا",2,0],["بِالمُقرِباتِ المُبعِداتِ الجُردِ","إِذا الفَتى أَكدى بِها لَم تُكدِ",31,"د",1,0],["بِالمُنْذِرِ بْنِ مُحمَّدٍ","شَرُفتْ بِلاد الأندَلُسْ",32,"س",1,1],["بالمُشْرَفيِّة كُلَّما صالوا بها","قَطَعَتْ عِظامَ سَواعِدٍ ورِقابِ",33,"ب",1,0],["بالمؤمنين نهض الأمير","مضطلع بأمرهم شمّير",34,"ر",1,0],["بالموت أذللت النفوس وبالهوى","وقهرت من وطىء التراب ومن هوى",35,"ه",3,0],["بالمرهَفِ المسموم فِيما قد ذُكِرْ","وكلُّ شيءٍ قَتَلَ، الماضي الذَّكِرْ",36,"ر",1,0],["بِالْمَاجِدِ الْمَنْسُوبِ بَلْ بِالأَرْوَعِ الْ","مَشْبُوبِ بَلْ بِالأَبْلَجِ الْمَعْصُوبِ",37,"ب",1,0],["بِالْمَالِ كَانَ غِنَاكَ إِذْ أَثَّلْتَهُ","وَالْيَوْمَ بِالحَمْدِ العَمِيمِ غَنَاكَا",38,"ك",2,0],["بالمنى الذابلاتِ، بالأمل الدا","مي، بثُكل الهوى، بفقد المراهم",39,"م",1,0],["بالمجدِ تَخلعُه الحُقوبُ","عليهِمُ تلوَ الحقوب",40,"ب",1,0],["بالمُبدعينَ \" الخالقينَ \" تنوَّرَتْ","شتَّى عوالمَ كُنَّ قبلُ خرائبا",41,"ب",2,0],["بالماءِ منساباً على حَصبائه","بالشَّمسِ طالعةً وراء تُلوله",42,"ل",2,0],["بالمِدفع استشهدي إن كنت ناطقةً","أو رُمْتِ أن تسمعي من يشتكي الصمما",43,"م",2,0],["بالمهارى يلبسن ثوباً جديداً","مستفاداً في كل وقت جديد",44,"د",1,0],["بالمُخرِساتِ ألسُنَ الخلاخل","إخراسَهُنَّ ألسُنَ العواذل",45,"ل",1,0],["بالمرشد الأعظم خير الخلق","وعلة الكون عظيم الخلق",46,"ق",1,0],["بِالمُقرَباتِ مُقَرِّباتٍ نَحوَهُم","لا تَعرِفُ الإيضاعَ وَالتَخويدا",47,"د",2,0],["بِالمُقرَباتِ مُقَرِّباتٍ ما نَأى","لَم يُعيِها بَلَدٌ بَعيدُ المَنزِعِ",48,"ع",1,0],["بِالمُصلِتينَ صَواعِقاً لا تَعتَدي","وَاللابِسينَ يَلامِقاً لا تُنزَعُ",49,"ع",1,0],["بِالمَشرَفِيَّةِ ما تُوازي دِجلَةً","عِندَ الزِيادَةِ ما أَراقَت مِن دَمِ",50,"م",1,0],["بِالمُبرِمِ الأَسواقَ وَالسُورِ الَّذي","مَنَعَ الأَعادي أَن تَميلَ مَمِيلا",51,"ل",2,0],["بِالمالكينَ هُمامٌ باتَ مُعتَكِفاً","عَلى وَفاءِ حُدودِ الحَقِّ يَقضيها",52,"ي",3,0],["بالمال يفعل يوم معترك الندا","ما تفعل الاعداء بالاعداء",53,"ا",2,0],["بِالمُستَضيءِ أَميرِ المُؤمِنينَ عَلَت","أَركانُها وَسَمَت مَجداً مَراقيها",54,"ي",3,0],["بِالمَشرَفِيّاتِ الرَواعِ","دِ وَالمُثَقَّفَةِ الرَواجِف",55,"ف",1,0],["بِالمَندَلِ الرَطبِ يُذكى في بُيوتِهِمُ","نارُ القِرى وَتُذَكّى حَولَها البِدَرُ",56,"ر",1,0],["بِالْمُوقِضَاتِ الْمُنْهِضَا","تِ عَزَائِمِ الْبَطَلِ النَّجِيدْ",57,"د",1,0],["بِالْمُصْطَف