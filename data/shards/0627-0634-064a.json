/www.poetsgate.com/ViewPoem.aspx?id=184888",""],[6031,"يا سَاكِنِيْ الخَطِّ في قَلْبي لَكُمْ خِطَطٌ","https://www.poetsgate.com/ViewPoem.aspx?id=46308",""],[6084,"أشياخ مكة نكست أعلامها","https://www.poetsgate.com/ViewPoem.aspx?id=170884",""],[6093,"وطن يقدسه الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=189390",""],[6093,"لا تلعن النص إن أعيتك قافية","https://www.poetsgate.com/ViewPoem.aspx?id=204337",""],[6100,"والدي","https://www.poetsgate.com/ViewPoem.aspx?id=52481",""],[6349,"صُورَة جماعِيَّة لِشَخْصٍ وَاحِد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85447&r=&rc=1",""],[6359,"عصفورتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69090&r=&rc=4",""]],"verses":[["أُشَيعِثُ رَأسُهُ بِالبيضِ يُفلى","وَيَغدو بِالدَمِ الجاري دَهينا",0,"ن",2,0],["أَشيمُهُ لِفِتيَةٍ","تَضَرَّعوا عَلى اللِمَم",1,"م",1,0],["أُشَيعِثُ الرَأسِ لا يَجري الدَهانُ بِهِ","وَإِن فُلي فَبِماضي الغَربِ قَطّاعِ",2,"ع",1,0],["أُشَيِّدُ ما بَناهُ أبي وجَدّي","وأحْمي العِرْضَ خِيفَةَ أن يُذالا",3,"ل",2,0],["أَشيمُهُ وضجيعي صارمٌ خَذِمٌ","ومِحمَلي بِرَشاشِ الدَّمعِ مَبلولُ",4,"ل",1,0],["أَشَيخَ المُسلِمينَ نَأَيتَ عَنّا","عَظيمَ الأَجرِ مَوفورَ الثَوابِ",5,"ب",1,0],["أش يقول مولاي عبدك","وكمالك لسّ يلحق",6,"ق",1,0],["اشئم وأعرق ورح من بعد محتجزاً","وايمننّ بعزم غير هزهاز",7,"ز",1,0],["أَشَيبانَ لَو كانَ القِتالُ صَبَرتُمُ","وَلاكِنَّ سَفعاً مِن حَريقٍ تَضَرَّما",8,"م",2,0],["أُشَيِّعُهُ وَالدَمعُ مِن شِدَّةِ الأَسى","عَلى خَدِّهِ نَظمٌ وَفي نَحرِهِ نَثرُ",9,"ر",1,0],["أشْيَاء منك تحرَّاني لتُورطَني","والحزُم يعْدل بي عن كل أُخْدُودِ",10,"د",1,0],["أشيخٌ من ذوي يمَنٍ صميم","وتشتم فارساً ناقضتَ أصلك",11,"ك",1,0],["أَشيَبٌ لَو أَنَّهُ يَخشى الدُجى","شابَ ذُعراً مِنهُ رَأسُ الغَيهَبِ",12,"ب",1,0],["أَشياءَ ذُقتُ لِفَقدِها","أَلَمَ الفِطامِ عَلى الرَضيعِ",13,"ع",1,0],["اشيم نارا سعرت","وانت انت الساعره",14,"ر",2,0],["أشيري يا أرامل للسماء","ويا أيتام ضجوا بالدعاء",15,"ا",2,0],["آشيم يا من بحبه نعلو","ومن أديم السهى له نعل",16,"ل",1,1],["أَشياعُ عيسى أَعَدّوا كُلَّ قاصِمَةٍ","وَلَم نُعِدُّ سِوى حالاتِ مُنقَصِمِ",17,"م",1,0],["أَشيمُ سَحابَ الغَربِ هَل رُكنُ جوشَنٍ","أَوِ المُنكَفا مِن بانَقوسا مَهابِطُه",18,"ط",2,0],["أَشيمُ مِنهُم بُروقَ الخُلَّباتِ فَهَل","شَخصٌ يُخَبِّرُنا عَن بارِقِ الخالِ",19,"ل",1,0],["أَشِيمُ عَفْوَكَ عِلْماً أنْ ستَنْشُرُه","عَليَّ تلك السَّجايا الغُرُّ والشِّيَمُ",20,"م",1,0],["أُشيعُ عَطاياكَ التي لو سترتُها","لَقامَ الغِنى عنَّي خَطيباً يُشيعُها",21,"ع",3,0],["أشياخُ عُمْرِ الزَّعفرانِ تراهُمُ","حولَ الصليبِ حَوانيَ الأصلابِ",22,"ب",1,0],["أشيمُ الثريّا فيه طالعةً كما","ثَنَيْتَ نظاماً فيه سَبْعُ لآل",23,"ل",1,0],["أَشَيبانُ لا ذاكَ الهِلالُ بِطالِعٍ","عَلَينا وَلا ذاكَ الغَمامُ بِعائِدِ",24,"د",1,0],["أَشَيبانُ ما جَدّي وَلا جَدُّ كاشِحٍ","وَلا جَدُّ شَيءٍ يَومَ وَلّى بِصاعِدِ",24,"د",1,0],["أَشَيبانُ عَمَّت نارُها مِن مُصيبَةٍ","فَما يُشتَكى وَجدٌ إِلى غَيرِ واجِدِ",24,"د",1,0],["أَشيري بِالسَلامِ لَهُ","إِذا هُوَ نَحوَنا نَظَرا",25,"ر",2,0],["أَشيمُ بِهِ سَنا بَرقٍ يَمانٍ","يُخَفِّرُني إِلى المَرعى الخَصيبِ",26,"ب",1,0],["أَشيمُ بِها بَرقَ الحَديدِ وَرُبَّما","عَثَرتُ بِأَطرافِ الرُدَينِيَّةِ السُمرِ",27,"ر",1,0],["أَشيمُ سَناهُ وَالسَماءُ مُغيمَةٌ","كَما اِغرَورَقَت عَيني لِرُؤيَتِهِ دَمعا",28,"ع",2,0],["أَشيمُ البَرقَ يومِضُ مِن نَداهُ","وَأَشمَمُ مِن نَواحيهِ النَسيما",29,"م",2,0],["أَشِيمُ سَناهُ مِن بَعِيدٍ وَرُبَّما","تُشامُ البُرُوقُ مِن بَعِيدٍ فَتَصدُقُ",30,"ق",1,0],["أشيمُكَ يا برق شيْمَ النُّجيم","وما فيك لي بَلَلٌ من صَدى",31,"ا",1,0],["أَشِيرِي إِلَى عَاصِي الهَوَى يَتَطَوَّعِ","وَنادِي المُنَى تُقْبِلْ عَلَيْكِ وَتَسْرِعِ",32,"ع",1,1],["ا شَيْءَ أَسْرَعُ مِنِّي لَيْسَ ذَا عُذَرٍ","وذا جَنَاحٍ بِجَنْبِ الرَّيْدِ خَفَّاقِ",33,"ق",1,0],["أشير إليها بالبنان مبيّناً","بأنّك أنت الروح والقصد والأمل",34,"ل",1,0],["أشَيخٌ لَيسَ يَعلَمُ فَرضَ عَينٍ","ولَم يَعلَم مَقاماً مِن مُقَامِ",35,"م",1,0],["أشير له ففيهمُ وَحىَ طَرفى","وخيرُ القول ما إن قَلَّ دلاَّ",36,"ل",2,0],["أُشَيِّعُهُ حِرصاً عَلى أَن أَكونَهُ","وَأُتبِعُهُ دَمعاً مَرَيتُ شؤُنَهُ",37,"ه",1,0],["اشير إلى الرشاد وأنت اعمى","أصم من الغواية لا تفيق",38,"ق",1,0],["أَشيبٌ ما بدا بك قلت لا بل","هو الملبوس من حُلَل الوقار",39,"ر",1,0],["أَشيخُ شيرازَ أبداهُ وحقّقهُ","في نصٍّ تنبيهه أو في مهذّبهِ",40,"ب",2,0],["أشيمُ للبرقِ منْ مسراهمُ قَبَساً","والليلُ يَسْحَبُ أذيالاً من الغَسَق",41,"ق",1,0],["أَشِيد ما شيّدوا وما رَفَعوا","وأَفعلُ الخيرَ مثلمَا ما فَعلوا",42,"ل",3,0],["أَشيم بروقا من غوير تهامة","وأخرى بنجد نصب تلك الغَوائِر",43,"ر",1,0],["أَشَيْخٌ مُفْلِسٌ يَهوَى","وَيْعْشَقُ فَاتَكَ الفَوْتُ",44,"ت",1,0],["أَشيعهُ بِأَنفاس مِداد","تَرددهنَّ أَحشاءٌ حِرار",45,"ر",1,0],["أشير وإن كنت لا تقبلا","مقالي وشوري بأن تُقْبِلاَ",46,"ا",1,1],["أشِيمُ بها برقَ الحيَا وهْو خُلَّبٌ","وأرتادُ أرضَ الروضِ وهْي مَحولُ",47,"ل",1,0],["أُشيرُ إلى بدر الدجنَّة طالعاً","وإيَّاه يعني بالإِشارة من عنى",48,"ن",2,0],["أشيمُ البرق يبكيني ابتساماً","وقد يُبكي الشجيَّ الابتسام",49,"م",1,0],["أشيمُ بروقه في كلّ يومٍ","وما كلٌّ بوارقه تُشام",49,"م",1,0],["أشيمُ به برق الثنايا وأصطلي","سنا نار كأس والحبيب ملائم",50,"م",1,0],["أشِيمُ نجوماً هَدَتْني إليكَ","تَلوحُ مَطَالِعُها مِنْ يَدَيْكا",51,"ك",2,0],["أشياد المعالي بالعوالي","أمبلس ألسن اللد الخصام",52,"م",1,0],["أشيمُ بروقَ عقَّاقٍ مُسِفٍّ","من الآراءِ يمْطُرني صَوابا",53,"ب",2,0],["أشيم برق رجاءٍ لا حيا معه","يرجى وأهصر عطفاً ليس ينعطف",54,"ف",1,0],["أشيمت ظبي ألحاظه أم سيوفهُ","وهزَّت لنا أعطافه أم ذوابله",55,"ل",2,0],["أشيمُه فَيَنِدُّ الدمعُ مِن حَرَقٍ","والدمعُ ما زالَ للمشتاقِ فضّاحا",56,"ح",2,0],["أَشَيْخَ شُيُوخِ الْعَصْرِ كَيْفَ تَركْتَنا","عِطاشاً وأَنْتَ الْبَحْرُ يا بنَ الأكارِمِ",57,"م",1,0],["أَشيمُ بُروقاً لا أرى الغيثَ بعدها","وأرقبُ سُحباً لا يَطُلُّ نَداها",58,"ا",3,0],["أَشَيباً ولمّا تَمضِ خَمسونَ حجّةً","وَلا قارَبتني إنّ هَذا منَ الظلمِ",59,"م",1,1],["أُشيرُ إِليها من بعيدٍ بقبلة","فأُبصرُها فيِ مائه تَتَلَهَّبُ",60,"ب",1,0],["أَشياخُ صِدقٍ نَموا بِمُعتَلِجِ ال","بَطحاءِ كانوا لِقَومِهِم عِصَما",61,"م",2,0],["أَشيمُ خِلالَها يا مَيُّ بَرقاً","فَهَل جادَت بِطَلعَتِها الرَبابُ",62,"ب",1,0],["أشيبُ وحُبُّ عُلوةَ في فُؤادي","وَليدٌ لا يُشابُ ولا يَشيب",63,"ب",1,0],["أشياء ليس لها إن غصت آصلة","يخالها نائم الأوهام كالحلم",64,"م",1,0],["أُشَيِّعُ القَلْبَ من رَغْمٍ عليَّ وما","بَقاءُ جِسْمٍ لَهُ للقَلْبِ تَشْييعُ",65,"ع",1,0],["أَشيَبُ الثَّغرِ وَعَذبُ المرشفِ","قَد جَرى في ثَغرِهِ ماءُ الحَياهْ",66,"ه",1,0],["أشياخَنا دمتم وقد","لُقِّيتمُ حسنَ الثواب",67,"ب",1,0],["أشيّعها يوماً وبين أضالعي","مِنَ الوجدِ نارٌ حرّها يتلهّبُ",68,"ب",1,0],["أَشيم لجودِ كفّك شيم برقٍ","لِوابلهِ اِنسكابٌ واِنهِمارُ",69,"ر",1,0],["أشياخنا يمشي بهم كلف","وشبابنا يجري بهم ولع",70,"ع",1,0],["أَشِيمُ بَرقاً سَرى مِن نَحو رَبعِكُم","وَفَضلُ ذَيلي بَوبل الدَمع مَبلولُ",71,"ل",1,0],["أشياءُ هوَّنَ حُسنُها عندى الهوى","شغفاً وجَسَّرَنى على أهوالِهِ",72,"ل",2,0],["اشياءُ لو كُلِّفَتها الشمسُ ما طلعَت","يوماً أو الصَّخرُ كادَ الصَّخرُ ينصدعُ",73,"ع",1,0],["أشياكمُ قد تاقت النّ","فسُ إليهَأ وصَبَت",74,"ت",1,0],["أُشَيِّعُ مِنهم كلَّ أبيضَ ناصِع","وأرجعُ حتّى لستُ يوماً بِراجعِ",75,"ع",1,0],["أشيحُ الفلا ما نم أم عنبر الشحر","أم العرف أهدت طيبةٌ طيب النشر",76,"ر",1,1],["أشيم على حاجر بارقا","على الشوق نبه قلبي وناما",77,"م",2,0],["أشيم للباخلين برقاً","ليس لأنوائه قِطَار",78,"ر",1,0],["أشيمُ عَفوكَ؟ والآمالُ تبسُطُه","ومَوقِفي منكَ مثلُ الأخذ بالكَظَمِ",79,"م",1,0],["أشيب ولم أقض الشباب حقوقه","ولم يمض من عهد الشباب قديم",80,"م",1,1],["أشيم بروق الشام شوقاً إليكم","وهيهات من دار السلام شئام",81,"م",1,0],["أَشيمُ بَرقَ ثَناياه فَيوهمني","تَأَلُّقَ البَرقِ نَجديّاً إِذا شيما",82,"م",2,0],["أَشيخ الكل قَد أَكثَرت بَحثاً","بِأَصل براءة وَباحتياط",83,"ط",1,1],["أَشَيبانُ ما أَدراكَ أَن كُلُّ لَيَلةٍ","غَبَقتُكَ فيها وَالغَبوقُ حَبيبُ",84,"ب",1,0],["أَشَيبانُ إِن تَأبى الجُيوشُ بِحَدِّهِم","يُقاسونَ أَيّاماً لَهُنَّ خُطوبُ",84,"ب",1,0],["أشيرُ لَهُ بِاللَثمِ إِن كانَ غافِلاً","وَيَأنَفُ صَوناً أَن يَرى بَينَنا لَمسُ",85,"س",1,0],["اشيعث عاصب العرنين منه","تعرّف اذ تنكَّر باللثام",86,"م",1,0],["اشير اليك يا من لا اسمي","فانت مقدر طي النوايا",87,"ا",3,0],["أشيبُ وتكثر الأشعار عندي","وشرُّ الوُلد أولاد المشيب",88,"ب",1,0],["أشياءَ من دلائل الخيراتِ","حتى أفوز بالرضى كغيري",89,"ي",