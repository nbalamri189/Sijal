,[6178,"قبلة ماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85528&r=&rc=4",""],[6202,"الشعر والسيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86705&r=&rc=6",""],[6320,"أَعْشَابُ المَزَابِل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84363&r=&rc=60",""],[5126,"صورة منّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87799&r=&rc=14",""]],"verses":[["حَتّى وَضَعتُ يَميني لا أُنازِعُهُ","في كَفِّ ذي نَقِماتٍ قيلُهُ القيلُ",0,"ل",1,0],["حَتّى وَرَدتُ بِآمالي إِلى مَلِكٍ","لَو رامَ رَدّاً لِماضي أَمسِهِ قَدَرا",1,"ر",2,0],["حَتّى وَرَدنَ عِذابَ المآءِ ذا بُرَق","عِدّاً يواعِدنَهُ الأَصرامَ وَالعَكَرا",2,"ر",2,0],["حتى وقفت وقلبي كلّه جزع","وأدمعي لجج طوراً وأوشال",3,"ل",1,0],["حتى وقفت وإيناساً لوحشتها","حنَيت رأسي وحني الرأس اجلال",3,"ل",1,0],["حتى وفى لي صديق قال حاسده","كبرت يا نمل أو صرت السليماني",4,"ي",1,0],["حتى وليت رقاب الناس كلهم","من شئت تخفضه منهم وترفعه",5,"ع",2,0],["حَتّى وَلا كَيفَ أَنتُم","وَلا السَلامُ عَلَيكُم",6,"م",1,0],["حَتّى وَصَلتُ سُرادِقَ المَلِكِ الَّذي","تَقِفُ المُلوكُ بِبابِهِ تَستَرزِقُ",7,"ق",1,0],["حَتّى وَرَدنَ لِتِمِّ خِمسٍ بائِصٍ","جُدّاً تَعاوَرَهُ الرِياحُ وَبيلا",8,"ل",2,0],["حتى وصلت الى الردى وثبا على","ان الطريق اليه غير معبد",9,"د",1,0],["حَتّى وَهَت مِنَ الفَتاةِ القُوَّه","فَنَزَلت عَن رَأسِها العُدُوَّه",10,"ه",1,0],["حَتّى وَصَلتُ إِلى نَفسٍ مُحَجَّبَةٍ","تَلقى النُفوسَ بِفَضلٍ غَيرِ مَحجوبِ",11,"ب",1,0],["حَتّى وَصَلتُ بِنَفسٍ ماتَ أَكثَرُها","وَلَيتَني عِشتُ مِنها بِالَّذي فَضَلا",12,"ل",2,0],["حَتّى وَرَدنَ بِسِمنينٍ بُحَيرَتِها","تَنِشُّ بِالماءِ في أَشداقِها اللُجُمُ",13,"م",1,0],["حتى وشى الصبحُ والطيبُ النَّمُومُ بنا","وصدَّقَ الحَلْيُ ما قالا بتِبيانِ",14,"ن",1,0],["حَتّى وَرَدنا بَحرَهُ فَتَقَطَّعَت","غُلَلُ الظَما عَن بَحرِهِ المَورودِ",15,"د",1,0],["حَتّى وَقَفتُ بِدارٍ ما بِها أَحَدٌ","وَلَيسَ يَنطِقُ مِن مَعروفِها حَجَرُ",16,"ر",1,0],["حَتّى وَصَلنَ بِنا إِلى","رَبِّ المَدائِنِ وَالقُصورِ",17,"ر",1,0],["حَتّى وَصَلتُ إِلى نَفسٍ مُؤَيَّدَةٍ","مِنها النُهى وَاللُهى وَالمَجدُ يُكتَسَبُ",18,"ب",1,0],["حَتّى وَعيتُ كَوَعيِ عَظ","مِ الساقِ لاحَمَهُ الجَبائِر",19,"ر",1,0],["حَتّى وَحَتّى لَستُ أَذكُرُهُم","إِنّي لَأُكرِمُ عَنهُمُ سَبّي",20,"ب",2,0],["حَتّى وَهَبتُم لِعَبدِ اللَهِ صاحِبَهُ","وَالقَولُ فِيكُم بإِذنِ اللَهِ ما فالا",21,"ل",2,0],["حتى وصلت إلى دمشق وإنها","بلد كَريم حافل بكرام",22,"م",1,0],["حَتَّى وَصَلْتُ إِلَى جَنابٍ أَفْيَحٍ","زَاهِي النَّبات بَعِيدِ أَعْماقِ الثَّرَى",23,"ا",1,0],["حَتّى وَعَيتَ صَغيراً","ما لا تَعيهِ الكِبارُ",24,"ر",1,0],["حتى وَقفْتَ به يمدُّ لهاتهُ","تَعَباً من الأثقال والأوصاب",25,"ب",1,0],["حتى ولو لم يفسد المعنى به","اذ لست في حكم الحديث بمعتبر",26,"ر",1,0],["حَتّى وَجَدتُ لَها هُماماً لَم تَزَل","أَوصافُهُ تَستَغرِقُ الأَشعارا",27,"ر",2,0],["حتى وصلت وشقَّ ظني بالوفا","شق الصباح عجاجة الظلماءِ",28,"ا",2,0],["حتى وقفتُ أمامَ دَسْتِك مُنشِدا","ما أنت أعلمُ سامعٍ بمقَولة",29,"ل",2,0],["حتى وليتَ فأدركتْها رحمةٌ","يَتتابعُ الغيثُ الغزيرُ بمثلها",30,"ل",3,0],["حَتّى وَرَدنا القُنَينِيّاتِ ضاحِيَةً","في ساعَةٍ مِن نَهارِ الصَيفِ تَلتَهِبُ",31,"ب",1,0],["حَتّى وَرَدنَ مِنَ الأَزارِقِ مَنهَلاً","وَلَهُنَّ مِن وَضَحِ النَهارِ أَصيلُ",32,"ل",1,0],["حتى ورَدْنا على ذُبيانَ ضاحِيةً","إنّا كذاك على ما خيَّلتْ نَرِدُ",33,"د",1,0],["حتى وَعدتَ بأن تأتي على طربٍ","حُرّاً يقود إلى اللذَّات أحرارا",34,"ر",2,0],["حَتّى وَهَت سوقي وَهَيهاتَ أَن","تَنفُقَ وَالأَشعارُ مِن بِزّي",35,"ز",2,0],["حتى وَلجتُ خباءَها متنكراً","وَكفأْتُ من خوفِ الرقيبِ سراجها",36,"ج",3,0],["حَتّى وَصَلت لِداره لا حُيّيت","طللا وَلا رحبت فناً وَمعرّسا",37,"س",2,0],["حتّى وَصلْتُ السُّرى بالسَّيرِ مُعتزِماً","عزْمَ امرئٍ غيرِ هيّابٍ ولا وُكَل",38,"ل",1,0],["حتَّى وَجَدتُ لَها كَريماً مُعدماً","أفَكلُّ مَن وَجدَت يَداهُ بَخيلُ",39,"ل",1,0],["حتى وصلْتُ إلى حِماه، فلا تسلْ","عن ظهره المشؤوم حين أدارا",40,"ر",2,0],["حَتّى وصلت إِلَيكَ يا بَدرُ العُلى","بِمَطيَّةِ مثل الهِلال نُحولا",41,"ل",2,0],["حتى وقعتُ ولم يَكُن","هذَا التلَّونُ في حِسابي",42,"ب",2,0],["حتى وَرَدْت فأَروانِي وأَحْسَنَ بي","صَدْرٌ موارِدُهُ يَشْجَى بها الصَّدِرُ",43,"ر",1,0],["حتى ولو أني غدوت حبايلاً","من الذي دعر عما أنهابني",44,"ن",2,0],["حتى وددت لوَ انَّ حُسنَ تصبُّري","في نائِبات الدهر أعدى حالي",45,"ل",2,0],["حتى وصلْنَ بالسُّرى عَليَّا","أبْلجَ سمح الكفِّ هاشميَّا",46,"ي",2,0],["حتّى وَفَتْ لك نَجدةٌ ألبستَها","في النّاكثين الوعد بالإيعادِ",47,"د",1,0],["حَتّى وَرَدنَ وَراءَ شاشَ بِمَنزِلٍ","تَرَكتَ بِهِ نَفَلاً لَهُ الأَتراكا",48,"ك",2,0],["حَتّى وَرَدنَ القَيرَوانَ وَدونَهُ","مَغدى الضُحى وَمَبيتُ لَيلِ الهُجَّدِ",49,"د",1,0],["حتَّى وصَلْنَا إِلى مِيقاتِ مأْمَنِه","يا صاحبيَّ فلو أبصرتُما عَمَلي",50,"ل",2,0],["حتى ولو كان قَيلاً فوق سدَّتهِ","يهابهُ العرش والدنيا ومَن فيها",51,"ي",3,0],["حتى وطئن لدن وطئن حمى فتىً","من هاشمٍ فوق الكواكب واطي",52,"ي",1,0],["حتى وهي الزلزال فانهارت به","سقف وأعمدة وطمّ فساد",53,"د",1,0],["حتى واقى نبأ أوهى","جلدي واقتاد لي السهرا",54,"ر",2,0],["حتى وَرَدنَ رَكيَّاتِ العُوَيرِ وَقَ","كادَ المُلاءُ من الكتّانِ يَشتَعِلُ",55,"ل",1,0],["حتى وان جيء بي نحو الصراط فقل","يا مادحي زكريا هات لي يدكا",56,"ك",2,0],["حتّى وقفتُ على حالٍ وقد وقفت","خوف الوشاةِ وفيض الدمعِ منسجمُ",57,"م",1,0],["حتى وجدت الوجد مني كامل","والصبر في قلبي بحال موزع",58,"ع",1,0],["حتى ولا أضحت ترى","بين القبور لهم قبور",59,"ر",1,0],["حتّى وَرَدْنا مِنْ ضَريحكَ مَوْرِداً","نُشْفَى بهِ مِنْ كلِّ داءِ مُعْضِلِ",60,"ل",1,0],["حتى وَفَدْنا إلى ضَريح","جنابُهُ للُوفودِ مَشْهدْ",61,"د",1,0],["حتَّى ورثتَ عظيمَ سؤددِهم","كرَم الغيوثِ ورفعةَ الشُهب",62,"ب",1,0],["حَتّى وَصَلتَ فَنِلتَ أَكلَةَ ضَيغَمٍ","مُتَضَمِّخٍ بِدَمٍ وَأَنفٍ ساقِطِ",63,"ط",1,0],["حتى وقفت على أقسى منازلها","وليس في القاع لا نبت ولا ثمر",64,"ر",1,0],["حتّى وردنَ بنَا العقيقَ فَرَاقَها","بِتِلاعِ هَاتِيكَ الرُّبَى تَنوِيمُهَا",65,"م",3,0],["حتى وصلتَ بساتينَ الفنونِ وقد","قامت تحيِّيك فيها زهرةُ الطرَبِ",66,"ب",1,0],["حتى وردنا كلنا شاطي الفلك","إذ شمت فلكا قبل آتيه سالك",67,"ك",1,0],["حَتّى وَصَلتُ إِلَيكَ يا بَحرَ النَدى","يا بنَ الكِرامِ ذَوي الفِعالَ الأَنجَبِ",68,"ب",1,0],["حتى وجدت عموم الوجد خصص بي","تقييد وجدي من إطلاق أفكاري",69,"ر",2,0],["حَتّى وَقَفتُ بِها برَملَةِ حا