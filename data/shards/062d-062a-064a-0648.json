{"poems":[[24,"بانت سعاد فقلبي اليوم متبول","https://www.aldiwan.net/poem21877.html","البسيط"],[71,"عجبت للطيف يا لمياء حين سرى","https://www.aldiwan.net/poem4012.html","البسيط"],[30,"يا دار مية بالخلصاء غيرها","https://www.aldiwan.net/poem29593.html","البسيط"],[88,"ما للديار تراءى وهي أطلال","https://www.aldiwan.net/poem44390.html","البسيط"],[72,"كم صار مثل دبيب النمل لي كلم","https://www.aldiwan.net/poem20485.html","البسيط"],[51,"هبك الفرات الذي بالروم مطلعه","https://www.aldiwan.net/poem65425.html","البسيط"],[70,"لكتموني رخيصا","https://www.aldiwan.net/poem42390.html","المجتث"],[70,"وعد الزيارة طرفه المتملق","https://www.aldiwan.net/poem42802.html","الكامل"],[38,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[89,"لهفي على شيخ العروبة احمد","https://www.aldiwan.net/poem44636.html","الكامل"],[85,"وهذه واقعة مستغربه","https://www.aldiwan.net/poem8047.html","الرجز"],[43,"من الجآذر في زي الأعاريب","https://www.aldiwan.net/poem9507.html","البسيط"],[43,"حيا وأيسر ما قاسيت ما قتلا","https://www.aldiwan.net/poem9983.html","البسيط"],[43,"عقبى اليمين على عقبى الوغى ندم","https://www.aldiwan.net/poem10529.html","البسيط"],[62,"يا حادي الظعن رفقا إنك الجاني","https://www.aldiwan.net/poem52253.html","البسيط"],[45,"شغلان من عذل ومن تفنيد","https://www.aldiwan.net/poem63493.html","الكامل"],[28,"بالعنبرية دار قد كلفت بها","https://www.aldiwan.net/poem5205.html","البسيط"],[49,"لهفي على الزمن القصير","https://www.aldiwan.net/poem64191.html","مجزوء الكامل"],[66,"ما هبت الريح إلا هزني الطرب","https://www.aldiwan.net/poem40984.html","البسيط"],[22,"شاقتك أظعان للي","https://www.aldiwan.net/poem21642.html","مجزوء الكامل"],[52,"نطق اللئام فمن يقول","https://www.aldiwan.net/poem27258.html","الكامل"],[8,"إما تري ظلل الأيام قد حسرت","https://www.aldiwan.net/poem21815.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85596","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42503","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43705","المجتث"],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[141,"ما ضر طيفك والكرى لو زارا","https://www.aldiwan.net/poem11768.html","الكامل"],[158,"بي من فتور المقلة الكحلاء","https://www.aldiwan.net/poem58775.html","الكامل"],[183,"صلى الإله عليك يا بن رسوله","https://www.aldiwan.net/poem14639.html","الكامل"],[183,"إن الخلافة لم تزل عن أصلها","https://www.aldiwan.net/poem14645.html","الكامل"],[193,"غابت سراة بني بحر ولو شهدوا","https://www.aldiwan.net/poem54395.html","البسيط"],[193,"أطربت أم رفعت لعينك غدوة","https://www.aldiwan.net/poem54404.html","الكامل"],[198,"سقنا رفيدة حتى احتل أولها","https://www.aldiwan.net/poem2061.html","البسيط"],[227,"أحسنت إحسان من تمت فطانته","https://www.aldiwan.net/poem51060.html","البسيط"],[233,"ما سمحت والله يا سادتي","https://www.aldiwan.net/poem31919.html","السريع"],[296,"برح الخفاء فلست أكتم لوعة","https://www.aldiwan.net/poem36808.html","عموديه"],[351,"لا تعتب الوغد اللئيم إذا أسا","https://www.aldiwan.net/poem40167.html","الكامل"],[362,"اليوم يومي ويوم الأينق الذلل","https://www.aldiwan.net/poem60675.html","البسيط"],[369,"أفلا رواق ندى نقوم بظله","https://www.aldiwan.net/poem57229.html","الكامل"],[397,"لا تسألوا عن جدة الأمطارا","https://www.aldiwan.net/poem10304.html","عموديه"],[403,"بعثت إليك بطيفها تعليلا","https://www.aldiwan.net/poem50139.html","الطويل"],[406,"قمر إذا عاتبته","https://www.aldiwan.net/poem32620.html","مجزوء الكامل"],[429,"زهرن فاعجب لروض ماله زهر","https://www.aldiwan.net/poem12341.html","البسيط"],[438,"شوقي إليك على نواك أهامني","https://www.aldiwan.net/poem14321.html","الكامل"],[456,"اليوم أنجز ماطل الآمال","https://www.aldiwan.net/poem56072.html","الكامل"],[459,"لله ما أكرمها مطيا","https://www.aldiwan.net/poem15642.html","الرجز"],[549,"قم فاثن لي فوق الوهاد وسادي","https://www.aldiwan.net/poem47843.html","الكامل"],[551,"وردت على خاقان خيلك بعدما","https://www.aldiwan.net/poem68275.html","الكامل"],[551,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[573,"ظبي بحسمي حالي الجيد بالعطل","https://www.aldiwan.net/poem2890.html","البسيط"]],"verses":[["حَتّى وَضَعتُ يَميني لا أُنازِعُهُ","في كَفِّ ذي نَقِماتٍ قيلُهُ القيلُ",0,"ل",1,0],["حَتّى وَرَدتُ بِآمالي إِلى مَلِكٍ","لَو رامَ رَدّاً لِماضي أَمسِهِ قَدَرا",1,"ر",2,0],["حَتّى وَرَدنَ عِذابَ المآءِ ذا بُرَق","عِدّاً يواعِدنَهُ الأَصرامَ وَالعَكَرا",2,"ر",2,0],["حتى وقفت وقلبي كلّه جزع","وأدمعي لجج طوراً وأوشال",3,"ل",1,0],["حتى وقفت وإيناساً لوحشتها","حنَيت رأسي وحني الرأس اجلال",3,"ل",1,0],["حتى وفى لي صديق قال حاسده","كبرت يا نمل أو صرت السليماني",4,"ي",1,0],["حتى وليت رقاب الناس كلهم","من شئت تخفضه منهم وترفعه",5,"ع",2,0],["حَتّى وَلا كَيفَ أَنتُم","وَلا السَلامُ عَلَيكُم",6,"م",1,0],["حَتّى وَصَلتُ سُرادِقَ المَلِكِ الَّذي","تَقِفُ المُلوكُ بِبابِهِ تَستَرزِقُ",7,"ق",1,0],["حَتّى وَرَدنَ لِتِمِّ خِمسٍ بائِصٍ","جُدّاً تَعاوَرَهُ الرِياحُ وَبيلا",8,"ل",2,0],["حتى وصلت الى الردى وثبا على","ان الطريق اليه غير معبد",9,"د",1,0],["حَتّى وَهَت مِنَ الفَتاةِ القُوَّه","فَنَزَلت عَن رَأسِها العُدُوَّه",10,"ه",1,0],["حَتّى وَصَلتُ إِلى نَفسٍ مُحَجَّبَةٍ","تَلقى النُفوسَ بِفَضلٍ غَيرِ مَحجوبِ",11,"ب",1,0],["حَتّى وَصَلتُ بِنَفسٍ ماتَ أَكثَرُها","وَلَيتَني عِشتُ مِنها بِالَّذي فَضَلا",12,"ل",2,0],["حَتّى وَرَدنَ بِسِمنينٍ بُحَيرَتِها","تَنِشُّ بِالماءِ في أَشداقِها اللُجُمُ",13,"م",1,0],["حتى وشى الصبحُ والطيبُ النَّمُومُ بنا","وصدَّقَ الحَلْيُ ما قالا بتِبيانِ",14,"ن",1,0],["حَتّى وَرَدنا بَحرَهُ فَتَقَطَّعَت","غُلَلُ الظَما عَن بَحرِهِ المَورودِ",15,"د",1,0],["حَتّى وَقَفتُ بِدارٍ ما بِها أَحَدٌ","وَلَيسَ يَنطِقُ مِن مَعروفِها حَجَرُ",16,"ر",1,0],["حَتّى وَصَلنَ بِنا إِلى","رَبِّ المَدائِنِ وَالقُصورِ",17,"ر",1,0],["حَتّى وَصَلتُ إِلى نَفسٍ مُؤَيَّدَةٍ","مِنها النُهى وَاللُهى وَالمَجدُ يُكتَسَبُ",18,"ب",1,0],["حَتّى وَعيتُ كَوَعيِ عَظ","مِ الساقِ لاحَمَهُ الجَبائِر",19,"ر",1,0],["حَتّى وَحَتّى لَستُ أَذكُرُهُم","إِنّي لَأُكرِمُ عَنهُمُ سَبّي",20,"ي",1,0],["حَتّى وَهَبتُم لِعَبدِ اللَهِ صاحِبَهُ","وَالقَولُ فِيكُم بإِذنِ اللَهِ ما فالا",21,"ل",2,0],["حتى وصلت إلى دمشق وإنها","بلد كَريم حافل بكرام",22,"م",1,0],["حَتَّى وَصَلْتُ إِلَى جَنابٍ أَفْيَحٍ","زَاهِي النَّبات بَعِيدِ أَعْماقِ الثَّرَى",23,"ا",1,0],["حَتّى وَعَيتَ صَغيراً","ما لا تَعيهِ الكِبارُ",24,"ر",1,0],["حتى وَقفْتَ به يمدُّ لهاتهُ","تَعَباً من الأثقال والأوصاب",25,"ب",1,0],["حَتّى وَجَدتُ لَها هُماماً لَم تَزَل","أَوصافُهُ تَستَغرِقُ الأَشعارا",26,"ر",2,0],["حتى وصلت وشقَّ ظني بالوفا","شق الصباح عجاجة الظلماءِ",27,"ا",2,0],["حتى وقفتُ أمامَ دَسْتِك مُنشِدا","ما أنت أعلمُ سامعٍ بمقَولة",28,"ل",2,0],["حتى وليتَ فأدركتْها رحمةٌ","يَتتابعُ الغيثُ الغزيرُ بمثلها",29,"ل",3,0],["حَتّى وَرَدنا القُنَينِيّاتِ ضاحِيَةً","في ساعَةٍ مِن نَهارِ الصَيفِ تَلتَهِبُ",30,"ب",1,0],["حَتّى وَرَدنَ مِنَ الأَزارِقِ مَنهَلاً","وَلَهُنَّ مِن وَضَحِ النَهارِ أَصيلُ",31,"ل",1,0],["حتى ورَدْنا على ذُبيانَ ضاحِيةً","إنّا كذاك على ما خيَّلتْ نَرِدُ",32,"د",1,0],["حتى وَعدتَ بأن تأتي على طربٍ","حُرّاً يقود إلى اللذَّات أحرارا",33,"ر",2,0],["حَتّى وَهَت سوقي وَهَيهاتَ أَن","تَنفُقَ وَالأَشعارُ مِن بِزّي",34,"ي",1,0],["حتى وَلجتُ خباءَها متنكراً","وَكفأْتُ من خوفِ الرقيبِ سراجها",35,"ج",3,0],["حَتّى وَصَلت لِداره لا حُيّيت","طللا وَلا رحبت فناً وَمعرّسا",36,"س",2,0],["حتّى وَصلْتُ السُّرى بالسَّيرِ مُعتزِماً","عزْمَ امرئٍ غيرِ هيّابٍ ولا وُكَل",37,"ل",1,0],["حتَّى وَجَدتُ لَها كَريماً مُعدماً","أفَكلُّ مَن وَجدَت يَداهُ بَخيلُ",38,"ل",1,0],["حتى وصلْتُ إلى حِماه، فلا تسلْ","عن ظهره المشؤوم حين أدارا",39,"ر",2,0],["حَتّى وصلت إِلَيكَ يا بَدرُ العُلى","بِمَطيَّةِ مثل الهِلال نُحولا",40,"ل",2,0],["حتى وقعتُ ولم يَكُن","هذَا التلَّونُ في حِسابي",41,"ي",1,0],["حتى وَرَدْت فأَروانِي وأَحْسَنَ بي","صَدْرٌ موارِدُهُ يَشْجَى بها الصَّدِرُ",42,"ر",1,0],["حتى ولو أني غدوت حبايلاً","من الذي دعر عما أنهابني",43,"ن",2,0],["حتى وددت لوَ انَّ حُسنَ تصبُّري","في نائِبات الدهر أعدى حالي",44,"ي",1,0],["حتى وصلْنَ بالسُّرى عَليَّا","أبْلجَ سمح الكفِّ هاشميَّا",45,"ي",2,0],["حتّى وَفَتْ لك نَجدةٌ ألبستَها","في النّاكثين الوعد بالإيعادِ",46,"د",1,0],["حَتّى وَرَدنَ وَراءَ شاشَ بِمَنزِلٍ","تَرَكتَ بِهِ نَفَلاً لَهُ الأَتراكا",47,"ك",2,0],["حَتّى وَرَدنَ القَيرَوانَ وَدونَهُ","مَغدى الضُحى وَمَبيتُ لَيلِ الهُجَّدِ",48,"د",1,0],["حتَّى وصَلْنَا إِلى مِيقاتِ مأْمَنِه","يا صاحبيَّ فلو أبصرتُما عَمَلي",49,"ل",2,0]]}