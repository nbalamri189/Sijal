{"poems":[[55,"يا دار ما طربت إليك النوق","https://www.aldiwan.net/poem29956.html","الكامل"],[74,"قل للإمام محمد","https://www.aldiwan.net/poem19196.html","مجزوء الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54870","الكامل"],[234,"في الطن معنى من التعنيق معترض","https://www.aldiwan.net/poem51213.html","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126836","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77547","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120091","الكامل"],[1341,"","https://poetry.dctabudhabi.ae/diwan/poem/124693","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69420","البسيط"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76795","البسيط"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88658","الرجز"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67196","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199931","الكامل"],[3024,"","https://poetry.dctabudhabi.ae/diwan/poem/138037","الخفيف"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101633","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87401","البسيط"],[409,"","https://poetry.dctabudhabi.ae/diwan/poem/60283","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118014","الرجز"],[3853,"","https://poetry.dctabudhabi.ae/diwan/poem/124002","البسيط"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36350","الدوبيت"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90872","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72525","الرمل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76746","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120365","الكامل"],[4767,"ك ر ب ل ا","https://www.poetsgate.com/ViewPoem.aspx?id=199934",""],[4578,"يا منيتي في الهوى ما كان أوفاك","https://www.poetsgate.com/ViewPoem.aspx?id=49499",""],[4883,"بنت_تهز الأسئله","https://www.poetsgate.com/ViewPoem.aspx?id=48368",""],[4978,"مع منى سليمان","https://www.poetsgate.com/ViewPoem.aspx?id=177219",""],[5397,"ما للزمان قديما طرده انعكسا","https://www.poetsgate.com/ViewPoem.aspx?id=157929",""],[5533,"اِرْتفاعُ ضَغْطِ الدَّم","https://www.poetsgate.com/ViewPoem.aspx?id=176252",""],[6019,"نَفَحَات غَدِيرِيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=150972",""],[5190,"عاشق الكنانة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85059&r=&rc=134",""]],"verses":[["في الطينَةِ البَيضاءِ غَرسُكَ إِنَّهُ","غَرسٌ تَداوَلُهُ البِقاعُ عَريقُ",0,"ق",1,0],["في الطرس من فرجيّتي ال","بيضاء أكتب بالرّقاع",1,"ع",1,0],["فِي الطِّبِّ آيَاتٌ تُرِينَا فَضْلَ مَا","يَمْحُو الْحَلِيمُ وَيُثْبِتُ الْقَهَّارُ",2,"ر",1,0],["في الطُّنّ معنّى من التَّعنيق معترضٌ","في الضَّم منه وفي التَّشديد بالقُضُب",3,"ب",1,1],["في الطفِّ نورُك قد تجلّى","قالَت لهُ العلياءُ أهلا",4,"ل",2,1],["في الطَيرِ لا يَخفاك صَوتُ البَجعه","وَأَنَّها إِلى الغِنا مُنقَطِعَه",5,"ه",1,1],["في الطول من كعب الندي","والقول من سحبان وائل",6,"ل",1,0],["في الطيب منك جنازة","أخت الزنابق والأقاحي",7,"ح",2,0],["في الطَرفِ غُنجٌ وَفِيما فَوقَهُ دَعجٌ","وَفِي الحَقِيبَةِ تَدقِيقٌ وَتَجليلُ",8,"ل",1,0],["في الطورِ أبصر موسى نجمَ سُؤدَدِهِ","والأفقُ قد شقَّ إجلالاً لهُ قمرَه",9,"ر",2,0],["فَيا لطيف الطبع لا احسبه","الا على خلق النسيم طبعا",10,"ع",2,0],["فيا لِطودٍ يَفوقُ الشامخاتِ عُلىَ","وبَحرِ جُودٍ مَدى الأزماتِ دفَّاق",11,"ق",1,0],["في الطُّولِ والعَرضِ على الجِهاتِ","كرامةً لِصحَّةِ الصَّلاةِ",12,"ه",1,0],["في الطير ببغاء تمثل معشري","وانا بهم كالطائر المترنم",13,"م",1,0],["فِي الطُّفوفِ مُجَدَّلاً وَمَنيعُ","وَجَرَى دَمْعُهُ وَسالَ نَجيعُ",14,"ع",1,0],["فيا لطلولٍ لا الزلازل زعزعت","بناها ولا الإنسان أو غير الدهر",15,"ر",1,0],["فَيا لِطولِ لَيالِ الهَجرِ قد أَرِقَت","عيني بها وَلَهاً ترعى دراريها",16,"ي",3,0],["في الطور والصافات فانظر فيهما","وانظر أحاديث النبي المرسل",17,"ل",1,0],["في الطول بُعدُ مصرَ للقرينِ","أفتت بذا أمامةُ الفتيانِ",18,"ن",1,0],["في الطرق إذ تزاحم الرجالا","أو أن تلين لهم المقالا",19,"ل",2,0],["في الطاهر الطيب ابن الطاهري ذرى","والطيبي كل ما لاثوابه الأزرا",20,"ر",2,0],["في الطيبِ أَرى فرعك أَصلاً رَسَخا","إِن فاحَ رَوائِحَ الغَوالي نَسَخا",21,"خ",2,1],["في الطيلسان وتحت طي لسانه","صل يصول وعقرب يترصد",22,"د",1,0],["في الطريق القادري منه زها سير السلوك","فهو صدر لسواه العجز عما نال أقعد",23,"د",1,0],["في الطيف لو سمح الكرى تعليل","يكفي المحب من الوفاء قليل",24,"ل",1,1],["في الطرس من اقلامه درر وفي","البابنا من فيه نشوة جاد",25,"د",1,0],["في الطف لمَّا بدا يجتاحهم وجلُ","والقلبُ أمسَى على الأطفال مُنكسرا",26,"ا",1,0],["في الطرس أقلامهُ تبدي بدائعها","عذارَ أحورَ فتانٍ وفتاكِ",27,"ك",1,0],["..في الطاولة ذيك، الثبات","بنت ٍ تهزّ الأسئلة !",28,"ل",2,0],["في الطرس ، في قلمي، في كل سانحة","في بسمتي في عيوني حين تنهمل",29,"ل",1,0],["في الطور أنوار موسى حين آنسها","سميه ظن نارا أوقدت قبسا",30,"س",2,0],["في الطبِّ عِلاجٌ ووَصَايا","مِنْ فَضْلِ اللهِ الرَّحْمَنِ",31,"ن",1,0],["في الطِّينِ مُذْ صُبَّ مَاءُ العِشقِ يَعجُنُهُ","رَبُّ السَّمَا فَاستَوى مِنْ عِشقِكَ البَشَرُ",32,"ر",1,0],["في الطبِّ ، في الكيمياءِ ، في علم الفضا","في الفنِّ ، في الآدابِ ، كُلٌّ حاذِقُ",33,"ق",1,0]]}