{"poems":[[280,"حديقة ياسمين لا","https://www.aldiwan.net/poem25425.html","مجزوء الوافر"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145893","المتقارب"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126655","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62870","الوافر"],[4767,"رجاءٌ وأمل","https://www.poetsgate.com/ViewPoem.aspx?id=213553",""],[5495,"مو جيتك","https://www.poetsgate.com/ViewPoem.aspx?id=175438",""],[5776,"نهم","https://www.poetsgate.com/ViewPoem.aspx?id=199443",""]],"verses":[["كأَطْرَافِ الأَهِلَّةِ سا","لَ فِي أثْنائِها الشَّفَقُ",0,"ق",1,0],["كإطراقتي وارتِبَاكاتِ صوتي","إذا قِيلَ أحنى النخيلُ الرقابا",1,"ب",2,0],["كأطفال من التبر","على خيل من الزهر",2,"ر",1,0],["كأَطرافِ الرِّماحِ مُسدَّدَاتٍ","الى ثُغَرِ الهَواجرِ والدَّياجِي",3,"ج",2,0],["كأطيارٍ إذا ما ازدان روضٌ","بمَا سرَّ العيونَ لها رفيف",4,"ف",1,0],["كاطع بالفرح كاظم اسماعيل","وانه كاظم حزن بس كلبي مكطوع",5,"ع",1,0],["كأطلال صرعى ما استبانوا بلوحها","وأجسادهم ما أحزنت لوحة الرسمِ",6,"م",1,0]]}