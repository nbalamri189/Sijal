{"poems":[[87,"آذار أقبل قم بنا يا صاح","https://www.aldiwan.net/poem7257.html","الكامل"],[87,"بالله يا نسمات النيل في السحر","https://www.aldiwan.net/poem63666.html","البسيط"],[87,"آذار أقبل قم بنا يا صاح","https://www.aldiwan.net/poem63723.html","الكامل"],[69,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[48,"الناس بالأقدار نالوا كل ما","https://www.aldiwan.net/poem22722.html","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16621","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[108,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179775",""],[189,"وعشية أهدت لعينك منظرا","https://www.aldiwan.net/poem14149.html","الكامل"],[190,"في الزمن الفاسد لا تختلط","https://www.aldiwan.net/poem43808.html","السريع"],[409,"فقلت حسبكما لله دركما","https://www.aldiwan.net/poem33440.html","البسيط"],[438,"قصر بمدرجه النسيم تحدثت","https://www.aldiwan.net/poem12641.html","الكامل"],[473,"وليلة أيقظني معانقي","https://www.aldiwan.net/poem59521.html","الرجز"],[549,"ما زال في الأرض","https://www.aldiwan.net/poem67255.html","عموديه"],[647,"","https://poetry.dctabudhabi.ae/diwan/poem/198758","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59436","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59428","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1507,"","https://poetry.dctabudhabi.ae/diwan/poem/144788","الكامل"],[1985,"","https://poetry.dctabudhabi.ae/diwan/poem/132426","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123158","المتدارك"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198479","الكامل"],[2606,"","https://poetry.dctabudhabi.ae/diwan/poem/198979","الكامل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129817","الكامل"],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124709","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100924","الكامل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146339","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133226","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123483","الكامل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104517","المجتث"],[3271,"على مذبح الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=103196",""],[5358,"أتى وحيدُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=183426",""],[5431,"ولم أزل ممشيا!","https://www.poetsgate.com/ViewPoem.aspx?id=192762",""],[5491,"أنت الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=197208",""],[5493,". وقفت بين الدوالي .","https://www.poetsgate.com/ViewPoem.aspx?id=197041",""],[5574,"يا أيّها الرّسام","https://www.poetsgate.com/ViewPoem.aspx?id=206043",""],[5626,"الله اكبر رايةً نختارُ","https://www.poetsgate.com/ViewPoem.aspx?id=189693",""],[5674,"الحظ العاثر","https://www.poetsgate.com/ViewPoem.aspx?id=207917",""],[5736,"أرض الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=208466",""],[5842,"الموت/ صباح الحكيم","https://www.poetsgate.com/ViewPoem.aspx?id=128792",""],[5960,"بغدادُ أغلى انتماءاتي","https://www.poetsgate.com/ViewPoem.aspx?id=30808",""],[6070,"راحَ الفؤادُ بشوقهِ يتحرقُ","https://www.poetsgate.com/ViewPoem.aspx?id=188643",""],[6127,"الطوطميون","https://www.poetsgate.com/ViewPoem.aspx?id=188251",""],[6152,"إني ذكرتك في الأفلاج","https://www.poetsgate.com/ViewPoem.aspx?id=203184",""],[6291,"رحلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87674&r=&rc=8",""]],"verses":[["والنخل ممشوق القدودِ معصَّب","متزين بمناطقِ ووِشاح",0,"ح",1,0],["وَالنَخلُ مُتَّشِحٌ بِالغَيمِ تَحسَبُهُ","هيفَ العَرائِسِ في بيضٍ مِنَ الأَزُرِ",1,"ر",1,0],["وَالنَخلُ مَمشوقُ العُذوقِ مُعَصَّبٌ","مُتَزَيِّنٌ بِمَناطِقٍ وَوِشاحِ",2,"ح",1,0],["والنَّخْلُ أثْمَرَ غَرْسُه في عامِه","وَبَدَا مُعَنْدَمُ زَهْوِهِ والمَذْهَبُ",3,"ب",1,0],["وَالنَّخْلُ أَثْمَرَ فِي عامٍ وسُرَّ بهِ","سَلْمانُ إِذْ بَسَقَتْ منهُ العثاكِيلُ",4,"ل",1,0],["وَالنَخلُ يُجنى حينَ يُرطِّبُ زَهوَه","وَالبَدرُ يُكسَفُ لَيلَةَ الإِبدارِ",5,"ر",1,0],["والنّخْلُ ما عكَفَتْ عليه طيورُه","إلاّ لِما علِمَتْهُ مِن إرْطابِهِ",6,"ب",2,0],["والنخيلُ النخيلُ أرخت شعوراً","مُرسَلاَتٍ ومدَّت الظلَّ مدّا",7,"د",2,0],["وَالنَخلُ ماسَتْ وَمَالَتْ","تَشَوُّقاً وَاجْتِذَابَا",8,"ب",2,0],["والنَّخلُ قد غَيبتْ في اليمِّ أكثرَها","وأظهرتْ سَعَفاًَ أحْوى وعُرْجونا",9,"ن",2,0],["والنخلَ يحملُ في يديه مِظَلَّةً","للزَّهو، لا للقيظ والأمطار",10,"ر",1,0],["والنخلُ كالهِيف الحِسانِ تَزيَّنت","فلَبِسْنَ من أثمارهن قلائدا",11,"د",2,0],["والنخلة الحائل مهجورة","لا يرفع الناس بها قدرا",12,"ر",2,0],["والنخل والكرم قالا قد حكمت بما","تراه حقاً وصار الكل يبتسم",13,"م",1,0],["والنخْلُ كالغِيدِ الكواعبِ قُرِّطَتْ","بسبائكِ المنظومِ والمنثورِ",14,"ر",1,0],["وَالنَخلُ ما بَينَ الرِياحِ باسِقُ","وَالطَيرُ في أَوكارِها نَواطِقُ",15,"ق",1,0],["والنخل لم يرتفع يوماُ بقامته","إلا ليرتق ما في الأفق من ثقب",16,"ب",1,0],["والنخل والسّدرُ والأشجار شاحبةٌ","تُطأطِئُ الهامَ والأغصانُ تضطرِبُ",17,"ب",1,0],["والنخل لما إن دعاها أتت","طوعا لما قد شاء منها ورام",18,"م",1,0],["والنخل جاءت نحوه تمشي على","ساق بلا قدم ولا أمراس",19,"س",1,0],["والنخل جاءت حوله تمشي على","ساق بلا قدم بغير تمهل",20,"ل",1,0],["والنخلتان كعاشقَيْنِ استَخلَصا","حذَرَ العدى حِصْنا منيعاً منهُمُ",21,"م",1,0],["والنخل والبحر من زبيد","يفديهما الخوخ والصخور",22,"ر",1,0],["والنخل يُرى فيه بلح","قالوا ويرى فيه رطب",23,"ب",1,0],["والنّخْلُ باسِقَةٌ على هَامَاتِها","نَغَمٌ من التَّكْبيرِ في آذانِهِ",24,"ن",2,0],["والنخل لما أن دعاه مشى له","ذا سرعة بعروقه وعذوقه",25,"ق",2,0],["والنخل أمثال العرائس لبسُها","خَزٌّ وحليتُها قلائدُ من ذهب",26,"ب",1,0],["والنخل مثل عرايس ذهبية ال","أنداء فيروزية الوفراتِ",27,"ت",1,0],["والنَّخلُ تزرعه الكهولُ لغيرهم","كم زارع يشقَى ويسعدُ جان",28,"ن",1,0],["والنّخل ما ثمراتُه بقريبةٍ","ويكون أَعذبَ كلّ عودٍ مُجْتَنى",29,"ن",2,0],["والنخل قد مالت إلى خير الورى","وتدانت الأثمار والأقناء",30,"ا",2,0],["والنخل عام الغرس منه أثمرت","وباصبعيه جرى وفاض الماء",31,"ا",2,0],["والنخل فيه مواثل","حبابها باسمات",32,"ت",1,0],["والنخلُ فيها ذاكرٌ مسترسلٌ","هيمانُ مسحورٌ على الورقاتِ",33,"ت",1,0],["والنخل في صمت الرياح كأنّه","نُسّاكُ فجرٍ آذنوا لصلاةِ",33,"ه",1,0],["والنَّخْلُ يوقِدُ منْ سَعْفٍ ومِنْ كَرَبٍ","نارَ القدورِ ويُقري الضيفَ أعْذاقا",34,"ق",2,0],["والنخل تفخر أن عيسى تحتها","مذ جاء عيسى هاديا مهديا",35,"ي",2,0],["والنخلُ يَسمُقُ في رُباكَ وينتشي","بالأفقِ والصفصافُ حلمٌ أخضرُ",36,"ر",1,0],["والنخل ناظرة للأفق أعينه","والساق ثابتة لم تستطع هربا",37,"ب",2,0],["١٩- والنّخْلَ والزّهْرَ البديعَ جِوارَهُ","من خلفِهم نهْرٌ يسيرُ روِيّا",38,"ي",2,0],["وَالنَّخْلُ ما عادَ الوقوفُ طِباعَهُ","إِذْ هَبَّ يُقْذَفُ مِنْ حَشاهُ شَرارُ",39,"ر",1,0],["والنخل يكابر لاتدري","مافيه من جرحٍ غائر",40,"ر",1,0],["والنخل يرثي إلى البطحاءِ هامته","إذِ انحنى طلعها من وطأة التعبِ",41,"ب",1,0],["والنخل أمسى يابسا","فكفى عتابا يا بشَرْ",42,"ر",1,0],["والنَّخلُ يَهتزُّ لا سعفٌ يعانقُهُ","ولا يُساقطُ تَمراً باهتِزازاتِ",43,"ت",1,0],["والنخلُ يعلو عالياً نحو السما","بعذوقِ تمرٍ سعفُهُ يتعشَّقُ",44,"ق",1,0],["والنخل لولا بقايا منه شامخة","لما بقيْ لعقال الأرض ذي أثر",45,"ر",1,0],["والنخل يرقص في البستان مبتهجا","لما أتى طيفكم يختال مشتاقا",46,"ق",2,0],["والنخلُ .. والزيتونُ ردّدَ أحرُفي","والشوقُ يلثمُ في سرورٍ مبسمَهْ",47,"م",2,0]]}