{"poems":[[53,"لو على قدر ما يحاول قلبي","https://www.aldiwan.net/poem30765.html","الخفيف"],[93,"يا مليك القلوب يحفظك الله","https://www.aldiwan.net/poem9827.html","عموديه"],[93,"مرحباً أيها الأمير الجليل","https://www.aldiwan.net/poem11476.html","الخفيف"],[88,"ظلموك أيتها الفتاة بجهلهم","https://www.aldiwan.net/poem44971.html","الكامل"],[51,"أرضى بصورته وصد فأغضبا","https://www.aldiwan.net/poem8652.html","الكامل"],[51,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[51,"يا كريما لم يزل محتمِا","https://www.aldiwan.net/poem66525.html","الرمل"],[91,"أيهذا الشاكي وما بك داء","https://www.aldiwan.net/poem62667.html","عموديه"],[85,"ليلة الأمس قد ذهبت","https://www.aldiwan.net/poem6833.html","الخفيف"],[85,"روعوه فتولى مغضبا","https://www.aldiwan.net/poem7519.html","الرمل"],[62,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[45,"لا أرى بالعقيق رسما يجيب","https://www.aldiwan.net/poem62639.html","الخفيف"],[45,"إن تأمل محاسن الأصبهاني","https://www.aldiwan.net/poem64696.html","الخفيف"],[61,"لمحة البارق من حيث لمح","https://www.aldiwan.net/poem51745.html","الرمل"],[105,"ما لي دعوت فلم أجد","https://www.aldiwan.net/poem42138.html","مجزوء الكامل"],[75,"الحب حيث المعشر الأعداء","https://www.aldiwan.net/poem69109.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54891","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54246","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[106,"تحية مولود","https://www.poetsgate.com/ViewPoem.aspx?id=179510",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[106,"ذكرى محمد ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=179428",""],[91,"فلسفة الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=53232",""],[110,"وقف الوجد بي على الأطلال","https://www.aldiwan.net/poem16226.html","الخفيف"],[129,"مني السلام على الولى الوالي","https://www.aldiwan.net/poem50536.html","الكامل"],[198,"أيهذا الشاعر المغ","https://www.aldiwan.net/poem39872.html","مجزوء الرمل"],[224,"حرم الجمال على سريرك يحلم","https://www.aldiwan.net/poem39695.html","الكامل"],[227,"تحية الحياة","https://www.aldiwan.net/poem24238.html","عموديه"],[230,"أيها الماجد الذي لم يقصر","https://www.aldiwan.net/poem51050.html","الخفيف"],[232,"طال في شرك المضايق حبسي","https://www.aldiwan.net/poem44588.html","الخفيف"],[272,"أنبي دونك عبرتي وتنهدي","https://www.aldiwan.net/poem52087.html","الكامل"],[272,"ضربت سعاد خيامها بفؤادي","https://www.aldiwan.net/poem52108.html","الكامل"],[298,"هذه الأرض قد سقتها السماء","https://www.aldiwan.net/poem33341.html","الخفيف"],[329,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[362,"قال لي قائل رأيتك تهوى","https://www.aldiwan.net/poem68059.html","الخفيف"],[362,"صاح قل لي ما هذه الانوار","https://www.aldiwan.net/poem68098.html","الخفيف"],[365,"لولا رجائي ثانيا للقائه","https://www.aldiwan.net/poem61006.html","الكامل"],[453,"هز من قده شبيه الرديني","https://www.aldiwan.net/poem13933.html","الخفيف"],[454,"وحدتي فيلسوفة تمسح الدمع","https://www.aldiwan.net/poem61234.html","الخفيف"],[466,"يا صاحب العيدين","https://www.aldiwan.net/poem36542.html","عموديه"],[501,"منن الرفاعي الرفيع الهمة","https://www.aldiwan.net/poem37634.html","الكامل"],[501,"حسد الولي الجاهل","https://www.aldiwan.net/poem37807.html","مجزوء الكامل"],[501,"عوجا إلى الوادي المقدس بالسرى","https://www.aldiwan.net/poem37817.html","الكامل"],[501,"إن معنى الهيام بالأولياء","https://www.aldiwan.net/poem38101.html","الخفيف"],[516,"سهلت حزونة وجده وغرامه","https://www.aldiwan.net/poem12254.html","الكامل"],[539,"قلت من ذا قال إبني","https://www.aldiwan.net/poem47515.html","عموديه"],[539,"أبخير عيد أم بخير إمام","https://www.aldiwan.net/poem47940.html","عموديه"],[559,"إياك تشهد غيره ودع العنا","https://www.aldiwan.net/poem33787.html","الكامل"],[559,"إن جسمي هنا وقلبي هناكا","https://www.aldiwan.net/poem34259.html","الخفيف"],[559,"هو كل شيء في الوجود الواحد","https://www.aldiwan.net/poem34584.html","الكامل"],[559,"فرحي يا فرحي يا فرحي","https://www.aldiwan.net/poem34662.html","الرمل"],[563,"دعني فلست على الزمان بعاتب","https://www.aldiwan.net/poem52746.html","الكامل"],[563,"ما بين أعطاف القدود الهيف","https://www.aldiwan.net/poem52947.html","الكامل"],[576,"أنا غرس بيتك إن أرد","https://www.aldiwan.net/poem2761.html","مجزوء الكامل"]],"verses":[["هُوَ عيدٌ وَلا يَمُرُّ عَلى وَج","هِكَ يَومٌ إِلّا يَروقُ وَيُصبي",0,"ب",2,0],["هُوَ عِيدُ الإِحْسَانِ فِي كُلِّ مَعْنَىً","وسُرورُ المَحْرُومِ وَالمَحْرُوبِ",1,"ب",1,0],["هُوَ عِيدُ النَّشءِ الجَدِيدِ وذِكْرَاهُ","سَتَبْقَى مَا أَعْقَبَ الْجِيلَ جِيلُ",2,"ل",1,0],["هو عندنا َرميُ الشِباك بلُجَّةٍ","أتُصيب أخبَثَ أم تصادف أطيبا",3,"ب",2,0],["هو عَارِضٌ زَجلٌ فمن شاء الحيا","أرضى ومن شاء الصواعق أغضبا",4,"ب",2,0],["هو عبدٌ تشتهي تَضميرَهُ","بالمجافاةِ وتَقلى سِمَنَه",5,"ن",2,0],["هو عزٌّ غامضٌ فافطِنْ له","يا ذكيَّ القلبِ والعين فطَن",6,"ن",1,0],["هُوَ عِبءٌ عَلى الحَياةِ ثَقيلٌ","مَن يَظُنُّ الحَياةَ عِبءً ثَقيلا",7,"ل",2,0],["هو عادي كرسيَّ كافور عمرا","هل يصافى لناصف كرسيا",8,"ي",2,0],["هو عند المالك الأولى به","كيف أشكو أنه قد سُلبا",9,"ب",2,0],["هو عِلّةُ المعروفِ لو صدقوا","أنّ الأمورَ لكونها عِلَلُ",10,"ل",1,0],["هُوَ عَهدٌ مِنَ اللَيالي حَميدٌ","إِن تَهَيّا وَنائِلٌ مَوهوبُ",11,"ب",1,0],["هُوَ عِلقٌ تاجَرَتني فيهِ بِالحي","لَةِ حَتّى غَبَنتَني بِإِبتِياعِه",12,"ع",2,0],["هو عَيشٌ عادَ في صِحَّتِه","وهلالٌ عادَ للسُّقْمِ شَبَح",13,"ح",1,0],["هو عُدَّةُ الشَعبِ الأبي","يِ وعِصمةُ الوادي الخصيبْ",14,"ب",1,0],["هُوَ عِلّةُ الدُّنيا ومن خُلقتْ له","ولِعِلّةٍ ما كانتِ الأشياء",15,"ا",2,0],["هو عني ناءٍ كما أنا عنه","فكلانا عمن أحبَّ شطير",16,"ر",1,0],["هُوَ عبْدُ الْهَادِي هُوَ الْحَكَمُ الْعا","دِلُ فِي الْقَوْمِ وَالشِّهَابُ الْمُنِيرُ",17,"ر",1,0],["هُوَ عِيدُ مِصرَ وَلاَ انْفِرَادَ لَهَا بِهِ","كَلاَّ وَلاَ لِلعَصْرِ دُونَ التَّالِي",18,"ل",2,0],["هُوَ عِيدُ رَابِطَةِ الشُّعُوبِ جَمِيعِهَا","فِي الشَّرْقِ بَعْدَ تَفَكُّكِ الأَوْصَالِ",18,"ل",1,0],["هُوَ عِيدُ حَاضِرِهَا وَمُقْبِلِهَا عَلَى","مُتَعَاقَبِ الأَحْقَابِ وَالأَجْيَالِ",18,"ل",1,0],["هو عهدُ الذئبِ يُمليه على","شاتِهِ المِخْلَبُ والنابُ الوَقَاح",19,"ح",1,0],["هو عِرِّيسٌ لآسادِ الْحِمَى","وكِناسٌ لِظباءِ الربْرَب",20,"ب",1,0],["هو عرش أساسُه الحبُّ، لا بْط","شَكَ نخشى، ولا نرومُ عطاءك",21,"ك",1,0],["هو عاملٌ، بل راهِبٌ مُتَبَتُلٌ","صُوَرُ العِبادة جَمَّةُ الأَشكالِ",22,"ل",1,0],["هو عيدُ ميلاد ابن عبدِ منافِ","لا عيدُ مخترع، ولا كشّافِ",23,"ف",1,1],["هو عبء على الحياة ثقيل","من يظنّ الحياة عبئا ثقيلا",24,"ل",2,0],["هُوَ عَبد الرَحمن نَجل العِماديّ","سَليل الأَقطاب وَالأَبدال",25,"ل",1,0],["هُو عدني ومَودتي مع شدَتي","أصفى أودّائي دواء سُعَالِى",26,"ل",2,0],["هو عند اللَه أزكى","من دماء الشهداء",27,"ا",2,0],["هُوَ عاشِقٌ لَم يَدرِ شِيَمُ الهَوى","فَإِذا أَحَسَّ فَعِرقُهُ المُتَأَثِّمُ",28,"م",1,0],["هو عاشق القبلات إن رنينها","لحن ينبه فيه كل خمول",29,"ل",1,0],["هو عندي ألذّ من مُلْك كِسَرى","وافتضاضِ الكواعب الأبكار",30,"ر",1,0],["هو عين السعد التي أين حلت","من عراص الدنيا نفت كل بخس",31,"س",1,0],["هو عدتي هو عمدتي هو ذخرتي","هُوَ نصرتي هو منقذي هو منجدي",32,"د",2,0],["هُو عمدة الامم الَّتي لَو لَم يَكُن","فيها لقد كانَت بغير عماد",33,"د",1,0],["هُوَ عَوني عَلى العُلى وَرَجائي","حبَّذا العَونُ في العُلى وَالرَجاءُ",34,"ا",2,0],["هو عقل الحياة خبله الشك","فأنساه نوره وظلامه",35,"ه",1,0],["هُوَ عُنوانُ مَجدِهِم فَاِذا لَم","نَرهم كانَ مَجدَهُ يحكيهِم",36,"م",1,0],["هُوَ عَبدُ الرَحمن قَطب ذَوي العر","فان من أَشرَقت بِهِ الأَمصار",37,"ر",1,0],["هو عَفْوُه اعتَصِموا بحَبْلِ ذمامه","وعِقابُه اجتَنِبوا حُلولَ فَنائه",38,"ا",3,0],["هو عبد الرحيم حامي ذمار ال","لهو من قد سمى على الفرقدين",39,"ن",1,0],["هو عقلي الذي تمثل","في الناس وأهى لهم رجاء مقيما",40,"م",2,0],["هوَ عيدُ أمجادِ الرُّجولَةِ كلِّها","يُحييهِ صدامُ الأعَزُّ الأروَعُ",41,"ع",1,0],["هو عن أردت حقيقةً لصفاته","نزَّهه يا هذا عن الغوثيَّة",42,"ه",1,0],["هو عن جَنابِ المُصْطَفى","بالطَّوْرِ سِرًّا ناقِلُ",43,"ل",1,0],["هو عينُ شيخِ المُشْرِقينَ حَقيقَةً","سامي الجَنابِ أَبي الذِّراعِ الأَطْوَلِ",44,"ل",1,0],["هو عِزِّي إن صادَمَتْني اللَّيالي","هو سيفي البَتَّارُ للأَعداءِ",45,"ا",2,0],["هو عمدة الملك العقيم وذخره ال","باقي وجامع شمله ونظامه",46,"م",2,0],["هوَ عبدُ الله حقًّا","وأنا عبدُ أَبِيه",47,"ب",3,0],["هو عيدُه أم عيدُنا في نِسبَةٍ","فالموردُ عذبٌ كثيرُ زِحامِ",48,"م",1,0],["هو عنك ممتاز هنا بوجوده","وبك امتياز عنه في عدم هنا",49,"ن",2,0],["هو علمٌ له تعالى فذِكْرٌ","نازلٌ منه فيه ليس انفكاكا",50,"ك",2,0],["هو علم الأسماءَ آدمَ كلَّها","هو كل مولود يكون ووالدِ",51,"د",1,0],["هو عين الكل لا كل سوى","عينه عين العطا والمنح",52,"ح",1,0],["هو عِصمةُ الدَّاعي وغَوْثُ الملتجي","وكِفايةُ الرَّاجي وكَنزُ الطالبِ",53,"ب",1,0],["هُوَ عارفٌ باللهِ قامَ بَنهْيِهِ","عن مُنكرٍ والأمرِ بالمعروفِ",54,"ف",1,0],["هو عبدُ أَنْعُمِكَ التي","لا ذاقَ منها طعمَ عِتْقِه",55,"ق",2,0]]}