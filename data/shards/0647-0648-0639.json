ate.com/ViewPoem.aspx?id=164607",""],[5777,"قم فَقد لاح بريق الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=157258",""],[5956,"بعد فحصي ونجاحي","https://www.poetsgate.com/ViewPoem.aspx?id=181931",""],[5956,"من أجل نقوده تقتله","https://www.poetsgate.com/ViewPoem.aspx?id=182526",""],[5956,"الحب خير وسيلة للتوعية","https://www.poetsgate.com/ViewPoem.aspx?id=192244",""],[5956,"أرسلتُ من أموالكم لمياتمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193833",""],[5956,"أ خْترْتَ يا ربي أبا الإحسانِ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=194020",""],[5956,"ما أنتما لكنه ربي الكريم السامي","https://www.poetsgate.com/ViewPoem.aspx?id=194264",""],[5956,"أنا أحتفي بإخائه البنَّاء","https://www.poetsgate.com/ViewPoem.aspx?id=194391",""],[5956,"رضيعٌ يزحف كسُلْحُفاةٍ حلوة","https://www.poetsgate.com/ViewPoem.aspx?id=205158",""],[5956,"سحُبٌ تفيد حياتنا","https://www.poetsgate.com/ViewPoem.aspx?id=208561",""],[5956,"يا جابراً بمهارة لكسورنا","https://www.poetsgate.com/ViewPoem.aspx?id=210305",""],[5956,"أخَّرْتُ في أغلى الصحاب قصائدي","https://www.poetsgate.com/ViewPoem.aspx?id=214991",""],[5977,"عالمي","https://www.poetsgate.com/ViewPoem.aspx?id=212746",""],[6046,"إسلامي في عصر الكفر","https://www.poetsgate.com/ViewPoem.aspx?id=37429",""],[6244,"ربيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=509&r=&rc=2",""],[6247,"بين عتابها وعتابهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80265&r=&rc=4",""],[433,"نومة الراعي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87053&r=&rc=6",""],[5190,"لا تسألي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85040&r=&rc=115",""]],"verses":[["هُوَ عيدٌ وَلا يَمُرُّ عَلى وَج","هِكَ يَومٌ إِلّا يَروقُ وَيُصبي",0,"ب",2,0],["هُوَ عِيدُ الإِحْسَانِ فِي كُلِّ مَعْنَىً","وسُرورُ المَحْرُومِ وَالمَحْرُوبِ",1,"ب",1,0],["هُوَ عِيدُ النَّشءِ الجَدِيدِ وذِكْرَاهُ","سَتَبْقَى مَا أَعْقَبَ الْجِيلَ جِيلُ",2,"ل",1,0],["هو عندنا َرميُ الشِباك بلُجَّةٍ","أتُصيب أخبَثَ أم تصادف أطيبا",3,"ب",2,0],["هو عَارِضٌ زَجلٌ فمن شاء الحيا","أرضى ومن شاء الصواعق أغضبا",4,"ب",2,0],["هو عبدٌ تشتهي تَضميرَهُ","بالمجافاةِ وتَقلى سِمَنَه",5,"ن",2,0],["هو عزٌّ غامضٌ فافطِنْ له","يا ذكيَّ القلبِ والعين فطَن",6,"ن",1,0],["هُوَ عِبءٌ عَلى الحَياةِ ثَقيلٌ","مَن يَظُنُّ الحَياةَ عِبءً ثَقيلا",7,"ل",2,0],["هو عادي كرسيَّ كافور عمرا","هل يصافى لناصف كرسيا",8,"ي",2,0],["هو عند المالك الأولى به","كيف أشكو أنه قد سُلبا",9,"ب",2,0],["هو عِلّةُ المعروفِ لو صدقوا","أنّ الأمورَ لكونها عِلَلُ",10,"ل",1,0],["هُوَ عَهدٌ مِنَ اللَيالي حَميدٌ","إِن تَهَيّا وَنائِلٌ مَوهوبُ",11,"ب",1,0],["هُوَ عِلقٌ تاجَرَتني فيهِ بِالحي","لَةِ حَتّى غَبَنتَني بِإِبتِياعِه",12,"ع",2,0],["هو عَيشٌ عادَ في صِحَّتِه","وهلالٌ عادَ للسُّقْمِ شَبَح",13,"ح",1,0],["هو عُدَّةُ الشَعبِ الأبي","يِ وعِصمةُ الوادي الخصيبْ",14,"ب",1,0],["هُوَ عِلّةُ الدُّنيا ومن خُلقتْ له","ولِعِلّةٍ ما كانتِ الأشياء",15,"ا",2,0],["هو عني ناءٍ كما أنا عنه","فكلانا عمن أحبَّ شطير",16,"ر",1,0],["هُوَ عبْدُ الْهَادِي هُوَ الْحَكَمُ الْعا","دِلُ فِي الْقَوْمِ وَالشِّهَابُ الْمُنِيرُ",17,"ر",1,0],["هُوَ عِيدُ مِصرَ وَلاَ انْفِرَادَ لَهَا بِهِ","كَلاَّ وَلاَ لِلعَصْرِ دُونَ التَّالِي",18,"ل",2,0],["هُوَ عِيدُ رَابِطَةِ الشُّعُوبِ جَمِيعِهَا","فِي الشَّرْقِ بَعْدَ تَفَكُّكِ الأَوْصَالِ",18,"ل",1,0],["هُوَ عِيدُ حَاضِرِهَا وَمُقْبِلِهَا عَلَى","مُتَعَاقَبِ الأَحْقَابِ وَالأَجْيَالِ",18,"ل",1,0],["هو عهدُ الذئبِ يُمليه على","شاتِهِ المِخْلَبُ والنابُ الوَقَاح",19,"ح",1,0],["هو عِرِّيسٌ لآسادِ الْحِمَى","وكِناسٌ لِظباءِ الربْرَب",20,"ب",1,0],["هو عرش أساسُه الحبُّ، لا بْط","شَكَ نخشى، ولا نرومُ عطاءك",21,"ك",1,0],["هو عاملٌ، بل راهِبٌ مُتَبَتُلٌ","صُوَرُ العِبادة جَمَّةُ الأَشكالِ",22,"ل",1,0],["هو عيدُ ميلاد ابن عبدِ منافِ","لا عيدُ مخترع، ولا كشّافِ",23,"ف",1,1],["هو عبء على الحياة ثقيل","من يظنّ الحياة عبئا ثقيلا",24,"ل",2,0],["هُوَ عَبد الرَحمن نَجل العِماديّ","سَليل الأَقطاب وَالأَبدال",25,"ل",1,0],["هُو عدني ومَودتي مع شدَتي","أصفى أودّائي دواء سُعَالِى",26,"ل",2,0],["هو عند اللَه أزكى","من دماء الشهداء",27,"ا",2,0],["هُوَ عاشِقٌ لَم يَدرِ شِيَمُ الهَوى","فَإِذا أَحَسَّ فَعِرقُهُ المُتَأَثِّمُ",28,"م",1,0],["هو عاشق القبلات إن رنينها","لحن ينبه فيه كل خمول",29,"ل",1,0],["هو عندي ألذّ من مُلْك كِسَرى","وافتضاضِ الكواعب الأبكار",30,"ر",1,0],["هو عين السعد التي أين حلت","من عراص الدنيا نفت كل بخس",31,"س",1,0],["هو عدتي هو عمدتي هو ذخرتي","هُوَ نصرتي هو منقذي هو منجدي",32,"د",2,0],["هُو عمدة الامم الَّتي لَو لَم يَكُن","فيها لقد كانَت بغير عماد",33,"د",1,0],["هُوَ عَوني عَلى العُلى وَرَجائي","حبَّذا العَونُ في العُلى وَالرَجاءُ",34,"ا",2,0],["هو عقل الحياة خبله الشك","فأنساه نوره وظلامه",35,"ه",1,0],["هُوَ عُنوانُ مَجدِهِم فَاِذا لَم","نَرهم كانَ مَجدَهُ يحكيهِم",36,"م",1,0],["هُوَ عَبدُ الرَحمن قَطب ذَوي العر","فان من أَشرَقت بِهِ الأَمصار",37,"ر",1,0],["هو عَفْوُه اعتَصِموا بحَبْلِ ذمامه","وعِقابُه اجتَنِبوا حُلولَ فَنائه",38,"ا",3,0],["هو عبد الرحيم حامي ذمار ال","لهو من قد سمى على الفرقدين",39,"ن",1,0],["هو عقلي الذي تمثل","في الناس وأهى لهم رجاء مقيما",40,"م",2,0],["هوَ عيدُ أمجادِ الرُّجولَةِ كلِّها","يُحييهِ صدامُ الأعَزُّ الأروَعُ",41,"ع",1,0],["هو عن أردت حقيقةً لصفاته","نزَّهه يا هذا عن الغوثيَّة",42,"ه",1,0],["هو عن جَنابِ المُصْطَفى","بالطَّوْرِ سِرًّا ناقِلُ",43,"ل",1,0],["هو عينُ شيخِ المُشْرِقينَ حَقيقَةً","سامي الجَنابِ أَبي الذِّراعِ الأَطْوَلِ",44,"ل",1,0],["هو عِزِّي إن صادَمَتْني اللَّيالي","هو سيفي البَتَّارُ للأَعداءِ",45,"ا",2,0],["هو عمدة الملك العقيم وذخره ال","باقي وجامع شمله ونظامه",46,"م",2,0],["هوَ عبدُ الله حقًّا","وأنا عبدُ أَبِيه",47,"ب",3,0],["هو عيدُه أم عيدُنا في نِسبَةٍ","فالموردُ عذبٌ كثيرُ زِحامِ",48,"م",1,0],["هو عنك ممتاز هنا بوجوده","وبك امتياز عنه في عدم هنا",49,"ن",2,0],["هو علمٌ له تعالى فذِكْرٌ","نازلٌ منه فيه ليس انفكاكا",50,"ك",2,0],["هو علم الأسماءَ آدمَ كلَّها","هو كل مولود يكون ووالدِ",51,"د",1,0],["هو عين الكل لا كل سوى","عينه عين العطا والمنح",52,"ح",1,0],["هو عِصمةُ الدَّاعي وغَوْثُ الملتجي","وكِفايةُ الرَّاجي وكَنزُ الطالبِ",53,"ب",1,0],["هُوَ عارفٌ باللهِ قامَ بَنهْيِهِ","عن مُنكرٍ والأمرِ بالمعروفِ",54,"ف",1,0],["هو عبدُ أَنْعُمِكَ التي","لا ذاقَ منها طعمَ عِتْقِه",55,"ق",2,0],["هو عبد الحسين شبل عليّ","وعليّ اِبنه الحميد الخصالِ",56,"ل",1,0],["هُوَ عَبدُ العالِ للجنَّةِ قَد","سارَ إِذْ ناداهُ ذو الفَضلِ العَميم",57,"م",1,0],["هو عني باد فإن راح منه","آخر عدتُ فيَّ جهراً أراه",58,"ا",2,0],["هو عين مذهبنا وحجتنا به","نسمو على هام السِمّاك الأعزلِ",59,"ل",1,0],["هُوَ عِندَهُ عاصٍ عَلَيَّ فَكَيفَ قَد","رَدَعَ العُصاةَ وَمِنهُ لَم يَستَنكِفِ",60,"ف",1,0],["هو عصمتي هو عروتي فاستمسكي","يا نفس بالمجد العظيم الامنع",61,"ع",1,0],["هو عين الإله يرعى مطيع ال","خلق باللطف والمعاند بالرد",62,"د",1,0],["هو عدة هو جَنة هو جُنة","عند الطعان وعند ضرب المرهف",63,"ف",1,0],["هو عبد وربه خير رب","ما لقلب الفتى عن الله ضد",64,"د",1,0],["هُوَ عَبد السَتار مَولى المَوالي","طَيب الفرع وَالثَنا وَالغِراس",65,"س",1,0],["هو عبد الحليم قد رقّ طبعا","عن علىِّ المضاء عن نصَّارِ",66,"ر",1,0],["هو عقدُ فضلٍ لم يزل أبداً","تتزيّن العلياء في درره",67,"ه",1,0],["هو عقدُ فضلٍ زانَ عاطل عصره","لو لم يهبه اللهُ عزَّ على الثمن",68,"ن",1,0],["هو عاد لي من لقى الأحباب شي يقسم","مره هي احسن من الدنيا وما فيها",69,"ي",3,0],["هو عاد شي من يدس يقسم","مما يجد فيه شفا الضاني",70,"ن",2,0],["هُوَ عِندي مِنَ الهُمومِ الَّتي يَح","سُنُ فيها العَزاءُ وَالتَسليمُ",71,"م",1,0],["هو عين الله التي كان يرعى","نشئات الورى بها ويراها",72,"ا",3,0],["هو عرض الإله والأملاك ما","فيه ونفس الباري عليه سراها",72,"ا",3,0],["هُوَ عِطرُ سُكّانِ العَمُودِ وَإِن أَتى","بَلَداً فَعِطرُ مَجالِسِ الأُدَباءِ",73,"ا",2,0],["هو عبد اللّه المحب الذي قد","بلغ القلب في هواه نجاحا",74,"ح",2,0],["هو عُدَّتي في كلِّ يومِ كريهةٍ","ومَلاذ آمالي ومَولى حاجي",75,"ج",2,0],["هو علمٌ عَنَتْ له","أعرُبٌ ثم أعجمُ",76,"م",1,0],["هو علم في أول الحالِ عار","وكذا كان في الوجود الثاني",77,"ن",2,0],["هو عينها لا غيرها فتكثّرت","بوجودهِ فيها وذكر سمات",78,"ت",1,0],["هُوَ عَينُ قَولِ الله جَلَّ جَلاَلُهُ","وَكَلاَمُهُ حَقًّا بلاَ نُكرَانِ",79,"ن",1,0],["هُوَ عَينُ هَذَا الكَونِ لَيسَ بِغَيرهِ","أنَّى وَلَيسَ مُبَايِنَ الأكوَانِ",79,"ن",1,0],["هُوَ عَينُهَا لاَ غَيرُهَا مَا هَا هُنَا","رَبٌّ وَعبدٌ كَيفَ يَفتَرِقَانِ",79,"ن",1,0],["هو عيلم العلماء والعلم الذي","بسوى مديح علائه لم أرغب",80,"ب",1,0],["هو عضبُ الوغَى وقُطبُ رحاها","وهو هذامُها الهَذُوذ اليماني",81,"ن",2,0],["هو عشق لا وهمَ لا فهمَ فيه","لا تواني لا فكرَ لا إذعانا",82,"ن",2,0],["هو عطارنا الذي من شذاه","كان عطر الهدى ذكي الشميم",83,"م",1,0],["هو عيدُ الجمالِ في كلّ ارضٍ","هو عرسُ المُنى وزفّ السرورِ",84,"ر",1,0],["هُو عقربٌ لذعاتُهُ بلسانه","فإذا بدا لك خُذ بنعلك واضرب",85,"ب",1,0],["هُوَ عَلاَّمَةُ الوُجُودِ الَّذي كَم","شُبُهاتس عَرَت فَحَلَّ عُرَاهَا",86,"ا",3,0],["هو عيبة العلم الذي في بعضه ال","علم المحيط بما استبان وما بطن",87,"ن",1,0],["هو عيدروس القوم معلى نهجهم","بمواهب عمت جميع الأعصر",88,"ر",1,0],["هو عيدروس زمانه وأوانه","ومكانه في الجهر والأسرار",89,"ر",1,0],["هو عصمة اللاجي فإن هو لم","يكن الأده للمستجير فلاده",90,"ه",1,0],["هو عبد لها بل العبد احمى","منه انفقاً وهل يعز الذليل",91,"ل",1,0],["هو عبد رق في فنائك طائع","للأمر من سلبٍ ومن إيجاب",92,"ب",1,0],["هُوَ عَصمَاءُ العِقدِ كَانَت وَفَاةُ","لأبِيهِ بِهَا اسّتَتَمَّت صِفَاتُ",93,"ت",1,0],["هو عارض الشرف الأثيل وما له","إلا الإفاضة بالجميل عهاد",94,"د",1,0],["هُوَ عاتٍ بِنَفسِهِ وغَشُومٌ","وَلَقَد زِدتَهُ عُتُوَّا وجَبرا",95,"ر",2,0],["هُوَ عِندِي كَشعرَةِ باحتِقارٍ","وأًَنا كُلَّ ما بِهِ جادَ باخِس",96,"س",1,0],["هو عيسويٌّ وهي مسلمة","تالله أين هما من الوطر",97,"ر",1,0],["هو عبد الحمد هو المفدّى","يحقُّ لهُ الدعاءُ المستديمُ",98,"م",1,0],["هو عُدَّة للسالكين وحُجَّةٌ","هو مَرهَمٌ يَشفي منَ الآلام",99,"م",1,0],["هو عِندَ الإِله خَيرُ حَبيب","وَلهُ عِندَهُ المَقامُ القَريبُ",100,"ب",1,0],["هو عينُ أَعيانِ الخَليقَة كلّها","إِنسانُ عينِ العالمينَ الأوحدُ",101,"د",1,0],["هو عدتي هو عمدَتي وَوسيلَتي","نعم الوَسيلَةُ للإله محمّدُ",101,"د",1,0],["هو عصمتي مما أخاف وحبّه","يوم القيامة للخطوب عمادى",102,"د",2,0],["هو عالم السر أرجوه يفك اختناقي","بجاه جدي شفيع الخلق يوم المساق",103,"ق",1,0],["هو عابدٌ نجلُ الوزير أخي الدَّها","عبدِ الإله الألكعيِّ الأوحد",104,"د",1,0],["هو عندَ الشمس مثل الشم","سِ عندَ العالمينا",105,"ن",2,1],["هو علم الكتاب في علمه او","فهو اللوح بل وما خط في اللو"