{"poems":[[287,"أقر نجدا ومن بنجد سلامي","https://www.aldiwan.net/poem32631.html","الخفيف"],[382,"عج بالحمى يا راكب الوجناء","https://www.aldiwan.net/poem66977.html","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37733","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110028","البسيط"],[5431,"لولا المحبة لم أعرف من الله","https://www.poetsgate.com/ViewPoem.aspx?id=191295",""],[5431,"ولربّ جهلٍ قد قتلْ!","https://www.poetsgate.com/ViewPoem.aspx?id=214015",""],[5525,"الله يحبك","https://www.poetsgate.com/ViewPoem.aspx?id=894",""],[5685,"في مدح الحبيب المصطفى صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=34734",""],[5853,"عيناكِ.. عيناكِ","https://www.poetsgate.com/ViewPoem.aspx?id=175688",""],[5922,"تحتاجك الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=185173",""],[6004,"في يومها الوطني","https://www.poetsgate.com/ViewPoem.aspx?id=59596",""],[6089,"يا سدرةَ النّجوى","https://www.poetsgate.com/ViewPoem.aspx?id=214099",""]],"verses":[["يا سدادَ الثَغرِ المَخوفِ بِطَعنا","تِ ثُغورِ العِدا وَضَربِ الهامِ",0,"م",1,0],["يا سُدَّةَ المجدِ التي قد شوهدَت","من دانيالَ بلَيلَةِ الرؤياءِ",1,"ا",2,0],["يا سِدْرَةَ المُنتهى يا كَعبَةَ الفضَلا","يا رَوضَ عِلمٍ به للفضلِ أزهارُ",2,"ر",1,0],["يا سِدرةَ المُنتَهى اللَهُ رقَّاكِ","طُوباكِ يا مُنتَهى الآمالِ طُوباكِ",3,"ك",1,1],["ياسدرة العشق ما للقلب إلاه","رفقا بروحيَ قد ذابت للقياه",4,"ا",2,1],["ياسدرة العشق قلبي قاب رحمته","يشفي بلمسته ماكان أدماه",4,"ا",2,0],["ياسدرة العشاق نوركَ طعمه","طعم البنفسج مبهجٌ مهما حصلْ",5,"ل",1,0],["ياسدرةٍ في نجد يلقى بها الورْق","للنوح غصن وللمعالي بيارق",6,"ق",1,0],["يا سدرةً في المنتهى لم يُرْتضى","إلا لأحمد أن يسير هناكا",7,"ك",2,0],["يا سدرة الحب آهاتٌ تبعثرني","فلتجمعيني هوىً نبضا ووجدانا",8,"ن",2,0],["يَا سِدْرَةَ اللهِ يَاقَلْبِي وَ عِطْرَ دَمِي","أَحْتَاجُ دِفْئًا ، عَلى أَمْثَالِهَا تَعْيَا",9,"ي",2,0],["يَا سَديدَ الرَأي الذِي فَاحَ صِدقًا","حَلَّ غيثًا وَشَافيًا كَالدَّواءِ",10,"ا",2,0],["يا سدرةَ النّجوى انتهيتُ لبابِها","والحبُّ عرشٌ والغرامُ مكينُ",11,"ن",1,0]]}