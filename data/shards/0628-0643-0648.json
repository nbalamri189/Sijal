{"poems":[[90,"أزمعت عنا إلى مولاك ترحالا","https://www.aldiwan.net/poem45053.html","البسيط"],[53,"تخلفت شنطف فقلنا","https://www.aldiwan.net/poem64013.html","مخلع البسيط"],[53,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[30,"لعمري لقد نبهت يا هند ميتا","https://www.aldiwan.net/poem5649.html","الطويل"],[82,"هذا ابتداء له عند العلى خبر","https://www.aldiwan.net/poem31433.html","البسيط"],[46,"لعلك ذاكر الطلل القديم","https://www.aldiwan.net/poem29686.html","الوافر"],[107,"أرى الدم يجري في الكنانة دائبا","https://www.aldiwan.net/poem43132.html","الطويل"],[104,"بكوري عند شباكي","https://www.aldiwan.net/poem33125.html","مجزوء الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55024","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54642","الوافر"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43682","الوافر"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43697","الطويل"],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[354,"بك وصلي عمن سواك انقطاعي","https://www.aldiwan.net/poem15770.html","الخفيف"],[457,"صح واني نسيمنا باعتلاله","https://www.aldiwan.net/poem13878.html","الخفيف"],[469,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[482,"برق على الجزع بدا يلمع","https://www.aldiwan.net/poem15226.html","السريع"],[482,"تضاعف ما ألقاه غير بديع","https://www.aldiwan.net/poem15269.html","الطويل"],[567,"لعمرك ليس في الدنيا خليل","https://www.aldiwan.net/poem52737.html","الوافر"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138283",""],[878,"","https://poetry.dctabudhabi.ae/diwan/poem/140217",""],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18510","المتقارب"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100137","المتدارك"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72280","الخفيف"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117422","الوافر"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47488","الطويل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78179","الرمل"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99058","الهزج"],[2037,"","https://poetry.dctabudhabi.ae/diwan/poem/34881","الطويل"],[2173,"","https://poetry.dctabudhabi.ae/diwan/poem/142793","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53127","المتقارب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27573","الطويل"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198480","الكامل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21491","المتقارب"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121216","الخفيف"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46740","الكامل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105666","الوافر"],[2708,"","https://poetry.dctabudhabi.ae/diwan/poem/80426","الرجز"],[2815,"","https://poetry.dctabudhabi.ae/diwan/poem/105750","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205022","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89244","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135740","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111437","الخفيف"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45934","الطويل"],[5121,"شَاعِرُ الدُّنْيَا","https://www.poetsgate.com/ViewPoem.aspx?id=212038",""],[5273,"زوجتي","https://www.poetsgate.com/ViewPoem.aspx?id=28760",""],[5661,"ويحكم يا كهول أو يا شيوخ ال","https://www.poetsgate.com/ViewPoem.aspx?id=181397",""],[5756,"قالها حامد","https://www.poetsgate.com/ViewPoem.aspx?id=5429",""],[402,"فتى خبثت له الدنيا وطابا","https://www.poetsgate.com/ViewPoem.aspx?id=35332",""]],"verses":[["بكوك حتى قد احمرتّ مدامعهم","كأنهم نضحوا فيهنّ جريالا",0,"ل",2,0],["بكّوا سراويلها المُلقّى","بدمعة منكُمُ غزيره",1,"ر",2,0],["بكورٌ على الأقناص غيرُ مُخلَّة","كأنَّ بها في كل شارقةٍ وحَمْ",2,"م",1,0],["بَكَوا بِسُيوفِ اللَهِ لِلدينِ إِذ رَأَوا","مَعَ السودِ وَالحُمرانِ بِالعَقرِ طاغِيا",3,"ي",2,0],["بَكَوْا أباك بأجفانٍ مؤَرَّقة","أمْوَاهُهُنّ مِنَ النيرانِ تَنفجرُ",4,"ر",1,0],["بُكورُكِ أَشعَرُ الثَقلَينِ طُرّاً","وَأَوفى الناسِ في حَسَبٍ صَميمِ",5,"م",1,0],["بَكوا لِأَناشيدِ الوَداعِ وَما دَروا","أَجَدَّ أَبوهُم أَم تَطَرَّبَ يَلعَبُ",6,"ب",1,0],["بكوري عند شباكي","لأَنشقَ طيب ريّاكِ",7,"ك",1,1],["بَكَوُا المُرجَّى فِي خِلاَفٍ عَارِضٍ","لِيُزِيلَ ذَاكَ العَارِضَ المُتَكشِّفَا",8,"ف",2,0],["بَكَوْا مِنْكَ الوَفَاءَ وَكُنْتَهُ اسْماً","وَفِعْلاً واكْتِسَاباً وانْتِسَابَا",9,"ب",2,0],["بَكَوهُ مَعي فَقَد نَضَحوا الث","ثَرى بِالدَمعِ بَل نَضَجوا",10,"ج",3,0],["بَكَوهُ وَقالوا أَيَّ برٍّ وَفالِذٍ","وَجَدناهُ مِن كُلٍّ أَبرّ وَأَفلَذا",11,"ذ",2,0],["بك والضحايا الغُرِّ يزهو شامخاً","علمُ الحساب ، وتفخر الأرقام",12,"م",1,0],["بك والذي ضمَّ الثرى من طيبِهم","تتعطَّرُ الارَضونَ والأيام",12,"م",1,0],["بِكَ وَصلي عَمَّن سِواكَ اِنقِطاعي","وَبِسَتري هَواكَ كَشفُ قَناعَتي",13,"ي",1,1],["بكؤوسٍ من المُدام على تَرْ","نامِ أطياره ومسْرى شَماله",14,"ل",2,0],["بكونك فينا جلالُ الديار","ولولا القواضبُ لم يسمُ غمد",15,"د",1,0],["بَكَوا مِنَ الوجدِ على جيرةٍ","ساروا عنِ الخَيْفِ وما ودَّعوا",16,"ع",3,0],["بكَوا في رسومٍ غيرَّتْها يدُ البِلى","بدمعٍ على أطلالهنَّ هموعِ",17,"ع",1,0],["بَكَوكَ بأدمُعٍ نَفِدَتْ وجَفَّتْ","فكانَ من الدِّماء لها بديلُ",18,"ل",1,0],["بك والد الأشبال قرت عينه","جذلا وذيل الفخر جر تكبرا",19,"ر",2,0],["بكوا حذيفة لم تبكوا مثله","حتى تعود قبائل لم تخلق",20,"ق",1,1],["بِكوفِيَّةٍ أَصلُها بِالفُرا","تِ تَبدو هُنالِكَ أَو تَحضُرُ",21,"ر",1,0],["بك والأقدار ممهدةً","علقت ناباً نشبت ظفرا",22,"ر",2,0],["بكؤس قد مزجت زنجبيلاً","لذة الشاربين تشفي الصدورا",23,"ر",2,0],["بكوا لجراحةٍ شَقَّت جبين ال","حَبيبِ فقال ما ضرَّ مباحُ",24,"ح",1,1],["بِكُؤُوسٍ حَكَيْنَ مِنْ شَفِّ قَلْبي","شَفَةً لَمْ تَذُقْ وَثَغْراً وَريقا",25,"ق",2,1],["بِكُؤسٍ طفح الدُر بِها","فَعلاه مِن أَديم الشَمس رَشحُ",26,"ح",1,0],["بكوفان وطيِّ كر","بلاكمْ ثمّ من قبر",27,"ر",1,0],["بِكوفَتِنا والٍ عَلى صَلَواتِنا","ظَلومٌ غَشومٌ ظاهِرُ الفِسقِ مُترَفُ",28,"ف",1,0],["بكِ وَجدي إذا النّجومُ استقلَّتْ","كهمومي في كَثرةٍ واشْتباكِ",29,"ك",1,0],["بكوا لانحطاطي وعسري فمذ","غَنِيت بكوا لارتفاعي ويسري",30,"ر",2,0],["بكوني إذا ما كنت خلعاً فإنه","نزيه عن أحكامٍ تكون عن الأكر",31,"ر",1,0],["بِكَ وُصِّلَتْ رَحِمُ العُروبَةِ وانْجَلَتْ","سُحْبُ القَطِيعَةِ والجَفَاءِ العَاني",32,"ن",2,0],["بُكوراً تُبَلِّغُها بِالسِّبا","لِ مِن عَينِ جَبَّةَ ريحِ الثَّرى",33,"ا",1,0],["بك والدهر بيننا يتعذر","قدر اللّه بعد حسن اقتران",34,"ن",1,0],["بِكَواعِبٍ كالدُرِّ أَخلصَ لَونَها","صَونٌ غُذينَ بِهِ مَعاً وَنَعيمُ",35,"م",1,0],["بكوخك أيها الفلاح لاذوا","وإن سكنوا القصور على الرصيف",36,"ف",1,0],["بِكَونه مخلل الغذاء","مَا لَمْ يَصِرْ بالسحق كالهباء",37,"ا",2,0],["بكوا لعيالهم من جهد عامٍ","خريق الريح منجردِ الغُيوم",38,"م",1,0],["بكوه وكيف لا يبكون خلا","وفيا قد قضى عنهم يذب",39,"ب",1,0],["بكواكب المجد الذين بنورهم","قاموا مقام سراجهم حين انطفى",40,"ف",2,0],["بكوثرٍ والكافرون النصرِ","تبَّتْ والاخلاصِ فظهِّرْ نصري",41,"ي",1,0],["بِكُؤُوسِ النُّضارِ دارَت عَلَبهِم","هِيبِيَا والسُّلافُ بالدَّورِ يُسكَب",42,"ب",1,0],["بِكَونِهَا تَرجَمَةَ الإِيمَانِ","فَالهَج بِذِكرِهَا مَعَ الإِدمَانِ",43,"ن",1,0],["بِكَونِ صَلاةِ الظُهرِ قَد حَلَّ فِعلُها","أَداءً وَأَنَّ الوَقتَ لِلظُّهرِ ما حَضَرْ",44,"ر",1,0],["بِكَ وَحْيِي يَحُومُ مُنْذُ سِنِينٍ","إِنْ أَتَانِي أَتَى بِمَا فِيكَ حَارَا",45,"ر",2,0],["بِكُؤوسِ أيَّامي أُجدِّد نَخْبَها","لأكونَ سَكراناً ومِنها أشْبَعُ",46,"ع",1,0],["بكؤوسٍ كأنها ورق النس","رين فيها شقائق النعمان",47,"ن",1,0],["بكون أكبر من الغلطة وبعلن للهوا ميلاد","إذا كان الخطا منك مجرّد ثورة الخامد",48,"د",1,0],["بكوا منك الوفاء وكنت اسما","وفعلا واكتسابا وانتسابا",49,"ب",2,0]]}