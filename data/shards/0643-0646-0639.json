{"poems":[[53,"كفي الدموع وإن كان الفراق غدا","https://www.aldiwan.net/poem10879.html","البسيط"],[53,"يا كريما لم يزل محتمِا","https://www.aldiwan.net/poem66525.html","الرمل"],[26,"هل الدهر إلا ليلة ونهارها","https://www.aldiwan.net/poem24105.html","الطويل"],[93,"هذه ملفرد قد لاحت رباها","https://www.aldiwan.net/poem62802.html","عموديه"],[51,"كن عند أحسن ظن من ظنا","https://www.aldiwan.net/poem63145.html","الكامل"],[71,"ما للزمان عن المروءة عار","https://www.aldiwan.net/poem28776.html","الكامل"],[50,"رفع الصوت فنادى","https://www.aldiwan.net/poem62598.html","مجزوء الرمل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62241","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55023","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[68,"كن عن همومك معرضاً","https://www.poetsgate.com/ViewPoem.aspx?id=178182",""],[132,"سمعا وطوعا للإمام","https://www.aldiwan.net/poem50606.html","مجزوء الكامل"],[132,"يا ذا النوال الغادر","https://www.aldiwan.net/poem50618.html","مجزوء الكامل"],[208,"ريح شوق للبين كانت سموما","https://www.aldiwan.net/poem53185.html","الخفيف"],[310,"سائل النفس قبل فوت الأوان","https://www.aldiwan.net/poem56386.html","الخفيف"],[366,"لا وعينيك والجبين المفدى","https://www.aldiwan.net/poem68122.html","الخفيف"],[376,"دنا فزاد اشتعال الشوق بالبلل","https://www.aldiwan.net/poem57208.html","البسيط"],[445,"أهنيك يا عيد الرغائب عيدا","https://www.aldiwan.net/poem34786.html","الطويل"],[463,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[469,"أهلك والليل منضيا جملك","https://www.aldiwan.net/poem3286.html","عموديه"],[473,"كن عبد خلك قبل أن","https://www.aldiwan.net/poem60332.html","مجزوء الكامل"],[563,"ما هذه عندنا الأجسام والصور","https://www.aldiwan.net/poem34482.html","البسيط"],[563,"كن عادلا في أمورك لا تكن جاير","https://www.aldiwan.net/poem34540.html","المواليا"],[563,"كن عارفا بنعمة الله وكن","https://www.aldiwan.net/poem34564.html","الرجز"],[563,"كن على الصدق مقيما والأدب","https://www.aldiwan.net/poem34940.html","الرمل"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146215","المديد"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38260","الكامل"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44994","المديد"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125491","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125487","الكامل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100470","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53088","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27211","الخفيف"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68318","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100255","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62932","الخفيف"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32379","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110064","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91069","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205536","الخفيف"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33139","الخفيف"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59475","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69898","الوافر"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70067","الكامل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44892","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54464","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83188","الرجز"],[4755,"كُن كما كُنتَ","https://www.poetsgate.com/ViewPoem.aspx?id=183777",""],[4755,"أنشودة المساكين","https://www.poetsgate.com/ViewPoem.aspx?id=215431",""],[4955,"إن تسل عني فإني مسلم","https://www.poetsgate.com/ViewPoem.aspx?id=198414",""],[5149,"أيها القدرُ","https://www.poetsgate.com/ViewPoem.aspx?id=212221",""],[5189,"طيِّبِ الأنفاس عِطرا","https://www.poetsgate.com/ViewPoem.aspx?id=208509",""],[5277,"بغداد ..مفتاحُ القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=191008",""],[5277,"رمالٌ وظلال","https://www.poetsgate.com/ViewPoem.aspx?id=212784",""],[5376,"يا ارضَ الملْبنِ والعسلِ","https://www.poetsgate.com/ViewPoem.aspx?id=188545",""],[5431,"للدار أنت مودِعٌ وموَدّعُ","https://www.poetsgate.com/ViewPoem.aspx?id=196999",""],[5718,"الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=213899",""],[5956,"فلسطين أرض العرب*","https://www.poetsgate.com/ViewPoem.aspx?id=182863",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[469,"أهلك والليل منضيا جملك","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574797",""],[6238,"لُباب الحُب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86777&r=&rc=6",""],[2220,"يا هلال الدياجِ لحْ بالنهارِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11413&r=&rc=287",""]],"verses":[["كن عند أخلاقك الزهر التي جُعلت","عليك موقوفةً مقصورةً أبدا",0,"د",2,0],["كن عزيزاً بالتغاضي إنه","يترك الجاني مسلوبَ اللَّسَن",1,"ن",1,0],["كَنَعتِ الَّتي ظَلَّت تُسَبِّعُ سُؤرَها","وَقالَت حَرامٌ أَن يُرَجَّلَ جارُها",2,"ر",3,0],["كَنِعاجٍ عَمِيَت أَبصارُها","وَوَهَت في طَلَبِ العُشبِ قُواها",3,"ا",3,0],["كُن عِندَ أَحسَنِ ظَنِّ مَن ظَنّا","وَإِذا ظَنَنتَ فَأَحسِنِ الظَنّا",4,"ن",2,1],["كنْ عالماً في الناسِ أو متعلّماً","أو سامعاً فالعلمُ ثوبُ فخارِ",5,"ر",1,0],["كُن عِماداً يا اِبنَ مَن كا","نَ غِياثاً وَعِمادا",6,"د",2,0],["كَنَعْجَةِ الحَاذَةِ الحَوَّاءِ أَلْجَأهَا","حَامِي الوَدِيقَةِ بَيْنَ السَّاقِ والفَنَنِ",7,"ن",1,0],["كُنْ عَلَى قَلْبِي نَصِيري","وَاغْتَصِبْهُ مِنْ ضُلُوعِي",8,"ي",1,0],["كُنْ عَلَيْهِ يا قَبْرُ رُوحاً وَرَيْحَا","ناً ومَثوىً رَحْباً وَظِلاً ظَلِيلاَ",9,"ل",2,0],["كن عن همومك معرضاً","وكل الأمور إلى القضا",10,"ض",2,1],["كن عاقلا ومميزاً","ذَا فطنةٍ وأخَا فِكَرْ",11,"ر",1,0],["كنْ عاذلاً فالبرى","ءُ مِن الورَى كالعاثرِ",12,"ر",1,0],["كن عنياً فإن كلَّ حبيبٍ","لم يزل قاسياً يكون رحيما",13,"م",2,0],["كُن على حالكَ الّذي أنت فيه","مُستقيماً في السرّ والإعلانِ",14,"ن",1,0],["كُن عَلى ما تُريد وَصَلا وَهَجرا","وَدنوّا اِن شِئت مُنى وَبعدا",15,"د",2,0],["كُن عافِياً تَلقَ منه كافِياً وأقِم","جاراً يُقِم لكَ عِزاً غير ذي مَيَلِ",16,"ل",1,0],["كنُعماك فينا فاتِحاً ومُتمِّماً","وجُهدِكَ فينا مُبدِئاً ومُعِيدا",17,"د",2,0],["كنْ عدوّاً مبدياً صفحتَه","أو فسالمني إذا لم تك قِرْني",18,"ن",2,0],["كن عتبك المرءَ أن أرادك بال","سوء وأن لم يرد فكن غزلك",19,"ك",1,0],["كُن عَبدَ خَلِّكَ قَبلَ أَن","تَغدو حَبائِلُهُ رِثاثا",20,"ث",2,1],["كن عارفاً مثلنا بالله لا بك في","ما قلته لك واصدق أيها البشر",21,"ر",1,0],["كن عادلاً في أموركْ لا تكن جايرْ","للحب تطلبْ وأنت الحب يا حايرْ",22,"ر",1,1],["كن عارفاً بنعمة الله وكن","محققاً لها بفرط رفده",23,"د",2,1],["كن على الصدق مقيماً والأدبْ","والزم العلم بفهم وطلبْ",24,"ب",1,1],["كن على منهاج معرفة","لا تغرّنك الأباطيل",25,"ل",1,0],["كُن عافِياً كُن صافِحاً","فَالصّفحُ أَليَقُ بِالكِرام",26,"م",1,0],["كُن عَلى مِنهاجِ مَعرِفَة","إِن وَجهَ المَرءِ حاجِبُه",27,"ب",2,0],["كن عوننا ياربنَّا","واكتب لنا الفَوزَ المُبين",28,"ن",1,0],["كن عونَنا وارأف بنا","يا من عليه الإعتماد",29,"د",1,0],["كن على كل ناظمٍ مستطيل","مستطيلاً بدرك المنظوم",30,"م",1,0],["كن عدتي عند دفع الحادثات فقد","هززت منك حساماً غير مغمود",31,"د",1,0],["كن عُبيداً بقصرها وملكياً","بعد محوينا لكم في السرار",32,"ر",1,0],["كن عارفا بوحدة الوجود","وقامعاً بكثرة الموجود",33,"د",1,1],["كن عبدَ جدّك واعلمنَّ","بأنني عبدٌ لجدّك",34,"ك",1,0],["كن عليهم في الجَهرِ سيفاً ورمحاً","وعليهم في السِّرِ عيناً وأُذنَا",35,"ن",2,0],["كُن عِتدَ طَيٍّ يا مُغي","رَ فَإِنَّما أَنا مِن عَميرَه",36,"ر",2,0],["كن عقرباً تُخشى وصِلّاً يُتَّقى","عندَ القِراعِ ليتَّقيكَ الأَرقَمُ",37,"م",1,0],["كُن عونه في ضيق صَدرٍ غاله","فَالمَوت فيهِ وَالحَياة سَواء",38,"ا",2,0],["كُنْ عظيمًا ولا تلومنَّ إلا","همَّة كلفتكَ همًّا جسيما",39,"م",2,1],["كُن عَزيزاً أَو عَزَّ عَمّا يَعِزُّ","سَتُرِح مِن قِرانِ هَمٍّ يَلِزُّ",40,"ز",1,1],["كنعاجٍ توضحَ شَدَّ فيها ضَيغمٌ","فغدت نَوَافر شَتُّها لا يجمعُ",41,"ع",1,0],["كُن عالماً جامعاً من كلِّ منقبةٍ","فَنّا يرقيك بَينَ البدوِ وَالحَضَرِ",42,"ر",1,0],["كنعان لا تَبكي القرينة أَنَّها","بِالمَجد قامَت عَن يَمين القادرِ",43,"ر",1,0],["كُن عَلى صَمتِكَ ذا إِنَّ دُموعي","قَولُها أَحلى وأجلى من فَمي",44,"ي",1,0],["كُنْ عاذري في حُبِّهم لا عاذلي","يا فارغاً من شُغلِ قلبي الشّاغلِ",45,"ل",1,1],["كُن عالِماً كَجاهِلِ","إِن كُنتَ جَدّ عاقِلِ",46,"ل",1,0],["كُن عَميقًا.. فأنتَ مِن كُلِّ جَفنٍ","جئتَ كالنَّهرِ حافِلًا بابتِلائِكْ",47,"ك",1,0],["كن عاقِلًا ما استَطَعتَ الآنَ يا قَلَقِي","إِنَّ المَجَانِينَ أَدرَى بِالمَجَانِينِ",48,"ن",1,0],["كن عزيزًا كن تقيًّا يا أخي","وابتغِ الأخرى لِتحيا في هناءِ",49,"ا",2,0],["كُنْ عَاِليَ النَّفْسِ لا تُردِيكَ نَازِلَةٌ","مِنَ الخُطُوبِ، كَطَوْدٍ، زانَهُ الشَّجَرُ",50,"ر",1,0],["كن على العهد قويمًا","كن من الأخلاقِ نهرا",51,"ر",2,0],["كنْ عاشقا كى تراها اليوم عاشقةً","أو لا ! فكنْ للهوى العذريِّ تنتقلُ",52,"ل",1,0],["كنْ عاقدا للأمر واشرق هاديا","فالنجمُ يهدي والسرابُ محالُ",53,"ل",1,0],["كنعانٌ وتَّدَ دولتَهُ","في أُوْرِالسالمَ في الازلِ",54,"ل",1,0],["كنعانٌ هذي آلهةٌ","عمَّت بالسهلِ وبالجبلِ",54,"ل",1,0],["كنْ عادلا فالظلم جرحٌ نازفٌ","هو عتمةٌ وسوادها لا يُقشعُ",55,"ع",1,0],["كُنْ عَزِيزًا في الدُّنَا لا","تَنْحَنِي مِنْهُ الجِبَاهُ",56,"ا",2,0],["كنعانُ مِن شِبْه الجزيرة هاجروا","للشامِ واختاروا فلسطيناً وطنْ",57,"ن",1,0],["كَنعورة الدُولاب تسمع حَنينها","وَرشق عَلى طُول المَدى فوار",58,"ر",1,0],["كن عَتْبَك المُرُّ إن أرداك بالسّ","وء وإن لم يُرد فكن عَزَلَكْ",59,"ك",1,0],["كُنْ عاشقاً ينتابُهُ مَسُّ الجَوى","واصْنَعْ سؤالكَ مِن جنون جَوابهِ",60,"ب",2,0],["كنْ عبيداً بقصرها ومليكاً","بعدَ محوينا لكمْ في السرارِ",61,"ر",1,0]]}