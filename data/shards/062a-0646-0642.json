te.com/ViewPoem.aspx?id=208771",""],[5843,"دبرة الله في خلقه","https://www.poetsgate.com/ViewPoem.aspx?id=51291",""],[5956,"اتركي الشمس تقبلْ وجنتيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=213429",""],[6056,"شقائق النعمان","https://www.poetsgate.com/ViewPoem.aspx?id=130320",""],[6093,"تنقل النَّاسِ من حالٍ إلى حالٍ","https://www.poetsgate.com/ViewPoem.aspx?id=176523",""],[6124,"الفارس الذي لا يأتي","https://www.poetsgate.com/ViewPoem.aspx?id=201237",""],[6142,"مذ صلصل الله من طين خليقته","https://www.poetsgate.com/ViewPoem.aspx?id=155709",""],[6142,"هي المضامير إن توجف مذاكيها","https://www.poetsgate.com/ViewPoem.aspx?id=155708",""],[6148,"أشواق القبة الخضراء","https://www.poetsgate.com/ViewPoem.aspx?id=202096",""],[469,"أما واللمى وجدا بساكنة الملا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574809",""],[6259,"أذهبت رونق ماء الصبح في العذل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59394&r=&rc=42",""],[5226,"سِواكِ .. لا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82796&r=&rc=89",""],[5001,"ماذا أريد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80713&r=&rc=3",""],[5126,"صَدْمَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87817&r=&rc=32",""]],"verses":[["تَنَقَّلُ في مَغافِرِه","كَما اِنتَقَلَت حَوافِرُه",0,"ر",2,0],["تَنَقَّيتُها دُهريَّةً ذاتَ مَصدَقٍ","لَها أَثَرٌ يَومَ المَغَبَّةِ لاحِبُ",1,"ب",1,0],["تَنَقَّيتُهُ مِن كُلِّ مُرٍّ فَمِزتُهُ","لِكُلِّ عُضاليٍّ مِنَ الداءِ نَكّاسِ",2,"س",1,0],["تنقل نوراً بين أصلاب سادة","فلله منه في سما الفضل نير",3,"ر",1,0],["تُنقِّش كف الغصن في الروض عندما","تجلت عروسُ الراح في الحلل الخضرِ",4,"ر",1,0],["تَنَقَّذتَها مِن عَبدِ عَمرِو بنِ مالِكٍ","وَأَنتَ صَفِيُّ النَفسِ مِنهُ وَخَيرُها",5,"ر",3,0],["تَنِقُّ بِلا شَيءٍ شُيوخُ مُحارِبٍ","وَما خِلتُها كانَت تَريشُ وَلا تَبري",6,"ر",2,0],["تَنَقَّلَتِ الدِيارُ بِها فَحَلَّت","بِحَزَّةَ حَيثُ يُمتَسَغُ البَعيرُ",7,"ر",1,0],["تَنقَضُّ وَالفُرسانُ في آثارِها","تَنقَضُّ مِثلَ كَواسِرِ العُقبانِ",8,"ن",1,0],["تَنقَضي مُدَّةُ هَذا ال","بُعدِ عَنّا وَتَزولُ",9,"ل",1,0],["تنقل ايها القمر المنير","لقد خُلق السرى لك والمسير",10,"ر",1,1],["تُنَقنِقُ الدَهرَ بِلا عِلَّةٍ","وَتَدَّعي في الماءِ ما تَدَّعي",11,"ع",2,0],["تَنَقَّل مِن يَدٍ لِيَدٍ كَريماً","كَروحِ اللَهِ إِذ خَلَفَ الكَليما",12,"م",2,0],["تَنَقَّلَ يافِعاً فيها وَكَهلاً","وَمِن أَسبابِها بَلَغَ اليَفاعا",13,"ع",2,0],["تَنَقَّلَ كَالنَجمِ مِن غَيهَبٍ","يَجوبُ العُصورَ إِلى عَيهَبِ",14,"ب",1,0],["تَنقَدِحُ النارُ مِن مَضارِبِها","وَصَبُّ ماءِ الرِقابِ يُخمِدُها",15,"د",3,0],["تَنَقَّلُ في خُلُقى سُؤدُدٍ","سَماحاً مُرَجّى وَبَأساً مَهيبا",16,"ب",2,0],["تَنَقَّلُ الدَهرِ لِلغِنى سَبَبٌ","وَالمَرءُ وَالدَهرَ حَيثُ يَنتَقِلُ",17,"ل",1,0],["تنقبَّت بالكسوفِ الشمسُ إذ طلعَت","شمسٌ تزيد ضياءً حين تنتقِبُ",18,"ب",1,0],["تَنقادُ مَعَ أَرائِهِ أَيّامُهُ","مِثلَ اِنقِيادِ اللَفظِ مَع إِعرابِهِ",19,"ب",2,0],["تَنَقّلَ من سرجِ الكميّ بحتْفِهِ","إلى حفرةٍ في جوفِ لحدٍ مُسَنَّمِ",20,"م",1,0],["تنَقّلَ والإكرامُ من ربّه له","إلى جَنّةٍ فيها له دار مكرمِ",20,"م",1,0],["تنقلُ الناسَ من حياةٍ إلى مو","تٍ على ذاكَ مرّ جيلٌ فجيلُ",21,"ل",1,0],["تَنقادُ لِيَ الأَوتارُ وَهيَ عَصِيَّةٌ","فَأُذِلُّ مِنها كُلَّ ذي اِستِكبارِ",22,"ر",1,1],["تَنقْلُ عنها نَسَماتُ الصَّبا","تحيةً لكلِّ قلبٍ صَبا",23,"ب",2,0],["تَنَقَّلُ كالحلمِ بينَ الجفونِ","وكالبرقِ بين رؤوسِ الجبالْ",24,"ل",1,0],["تنقضي الآجالُ فيه والسِّفارْ","أبديٌّ ويحَ من تُهلكهُ",25,"ه",1,0],["تنقلت فيهم ديانات الأول","تنقّل الأيام فيهم والدّول",26,"ل",1,0],["تَنْقَضُّ وَهْيَ عَوَابِسٌ","حَتَّى تُمِيتَ فَتَبْتَسِمْ",27,"م",1,0],["تَنقلْ رَعَاك اللهُ فِي كُل مَوْطِنٍ","مِنَ الشَّرْقِ تَعْلَمْ مَا أَصَبْتَ مِنَ الْفَخْرِ",28,"ر",1,0],["تنقضِي الحَادِثَات بعْدَك وَالرو","حُ مُقِيم فِيهِمْ عَلَى الابَادِ",29,"د",1,0],["تنقر في القبور الخرس","عن ميلادها الأصفى",30,"ف",2,0],["تنقر في قبور الخرس","عن ميلادها الأصفى",31,"ف",2,0],["تنقضّ والفرسان في آثارها","تنقضذ مثل كواسر العقبان",32,"ن",1,0],["تنقّر في القبور الحرس","عن ميلادها الأصفى",33,"ف",2,0],["تنقد بترا فاركني وكأنهم","رمضانهم ما بعده شوال",34,"ل",1,0],["تنقى القلوبَ من الوسا","وسِ والرءوس من الصداعِ",35,"ع",1,0],["تَنَقَّلَ الشامُ فيكُم بُرهَةً وَأَتى","مِن صِدقِ عَزمِكَ ما زالَت بِهِ النُقَلُ",36,"ل",1,0],["تنقّل الأنف في النَّوار ينشقه","من ياسمين إلى ورد إلى آس",37,"س",1,0],["تنقلت من قصر لآخر دونه","فأكسبته لما حللت به الفضلا",38,"ل",2,0],["تنقّلٌ فتَّ أعلام الملوك به","ما أبين الفرق بين الراس والقدم",39,"م",1,0],["تنقلت في الأملاك من عهد آدم","إِلى اليوم ملك عن مليك معظم",40,"م",1,0],["تَنقّلَ نوراً في جباهِ جدودهِ","فَنالوا بهِ عزّاً وصاروا بهِ غُرّا",41,"ر",2,0],["تنقّلَ نورهُ في خيرِ قومٍ","وَأَشرف مَعشرٍ أُنثى وَبعلا",42,"ل",2,0],["تنقضّ منه صواعق","لم تعد رصد المعتدين",43,"ن",1,0],["تَنقَّل تَنَقَّل عَلى الغُصنِ وَاِرفَل","فَشدوُكَ في مُهجَتي يرفَلُ",44,"ل",1,0],["تنقل من شيث إلى متوشلخ","ونوح وسام نجله وارفخشذ",45,"ذ",1,0],["تَنَقَّل إِنَّ في النَقلِ اِعتِلاءاً","وَعِزاً وَالهَوانُ مَعَ المُبِنِّ",46,"ن",1,0],["تَنقضّ منهُ عَلى زرقِ العِدى شهبٌ","تَفري دُجى الكفرِ إثخاناً فينهزمُ",47,"م",1,0],["تنقّل في جانبيه الجراح","وتأكل جثمانه المُشخنا",48,"ن",2,0],["تَنَقَّلَ عَن فعالِ الخَيرِ جَهلاً","مَخافَةَ أَن يَضُرَّ بِهِ العَناءُ",49,"ا",2,0],["تَنَقَّلتَ في حالٍ فحالٍ مَعَ الهَوى","فَأَنتَ حَبيبٌ ثُمَّ أَنتَ صَديقُ",50,"ق",1,0],["تَنقَشِعُ السُحبُ وَيَذوي عَلى","آثارِها النَبتُ وَيَبقى التُراب",51,"ب",1,0],["تنقادُ نحو الموت رغماً مثلما","ينقاد نحو الذبح والسلخ الحَمَل",52,"ل",1,0],["تَنقَضَّ مِنهُ بروقٌ خلتُها شُهُباً","مِنها الملائِك في خوفٍ وإغراءِ",53,"ا",2,0],["تَنقادُ نَحوَ هَواهُنَّ القُلوب كَما اِنقادت","إِلى هِبَةِ اللَهِ العلى ابن علي",54,"ل",2,0],["تَنَقَّلَ من دارِ الفَناء فأرِّخوا","عَليًّا وللجنَّات كانَ انتقالُهُ",55,"ل",2,0],["تنقضي أيَّامه موصولةٌ","بصلاتٍ وصَلاةٍ وصيام",56,"م",1,0],["تنقضي أيَّامه محمودةً","في أمان الله من حَرٍّ ومن برد",57,"د",1,0],["تنقَّلتَ من دارٍ لدارٍ تنقُّلاً","ومن عادة الأَقمار أنْ تنتقلا",58,"ل",2,0],["تَنَقَّلْتَ مثلَ البَدْر يا طلعةَ البَدْر","فمن منزل عزٍّ إلى منزل فخرِ",59,"ر",1,1],["تنقَّل في أوج المعالي منزلاً","وشاهد في كلٍّ من الأمر مشهدا",60,"د",2,0],["تنقل ا