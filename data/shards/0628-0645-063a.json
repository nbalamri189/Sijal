{"poems":[[65,"لك الخير هل في لفتة من متيم","https://www.aldiwan.net/poem46204.html","الطويل"],[40,"ظعنت وودعت الخليط اليمانيا","https://www.aldiwan.net/poem7822.html","الطويل"],[107,"ذراني أقم للشعر في مصر مأتما","https://www.aldiwan.net/poem43370.html","الطويل"],[8,"لمن الدار كأنضاء الخلل","https://www.aldiwan.net/poem21814.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[173,"إلام أناجي قلب حيران واجم","https://www.aldiwan.net/poem1668.html",""],[414,"تروق دمشق ولداناً وحوراً","https://www.aldiwan.net/poem4190.html","الوافر"],[487,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[563,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59562","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49956","الطويل"],[1626,"","https://poetry.dctabudhabi.ae/diwan/poem/131351","الطويل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137960",""],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86519","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76692","البسيط"]],"verses":[["بمَغْنىً أَلِفْناهُ وفي العَيشِ غِرَّةٌ","وعَصْرُ الشّبابِ الغَضِّ لمْ يتَصرَّمِ",0,"م",1,0],["بِمُغتَصِبٍ مِن لَحمِ بِكرٍ سَمينَةٍ","وَقَد شامَ رَبّاتُ العِجافِ المَناقِيا",1,"ي",2,0],["بِمَغرِسِهِ يَحيا النَباتُ فَإِن تُرِد","لَهُ مَغرِساً مِن دونِهِ ماتَ مُؤلما",2,"م",2,0],["بِمَغامِيدَ فَأعلى أُسُنٍ","فَحُناناتٍ فَأَوقٍ فالجَبَل",3,"ل",1,0],["بِمَ غرَّ القوْمَ حَتَّى غفَرُوا","ذلِكَ الذَّنْبِ لَهُ مَا شاءَ غفْرَا",4,"ر",2,0],["بِمَغنى أَميرِ المُؤمِنينَ الَّذي غَدا","لَهُ مَنسِمٌ يَعلُو جَميعَ المَخاطِمِ",5,"م",1,0],["بِمغدى صَبوة وَمراح أُنس","ومَورد ظَبية وَمَراد ريم",6,"م",1,0],["بمغناطيس من جاذبات فواعل","تزج بها في السابحات الشافعيه",7,"ي",2,0],["بمغفرة كن يا غفور مساعدي","وللشكر وفِّق يا شكور مراعيا",8,"ي",2,0],["بمغناكِ أهواء النفوس تجمعت","فما أملٌ إلا لقصدك جانح",9,"ح",1,0],["بمغنىً ورَوضاتٍ رواتع بينا","ربائبُ أَترابٌ عليها مجاسدُ",10,"د",1,0],["بمغبَرة للجن فيها غماغمٌ","تطير حشاشات النفوس بها جبنا",11,"ن",2,0],["بمغاويرَ كلهم يخطفُ البر","قَ سناهُ ويسبق المرءَ فكره",12,"ر",2,0],["بمغنى خلاه الفرش إلا عفاشةً","تمج أضاميم البعوض وتقذف",13,"ف",1,0],["بمغرب العدوة القصوى دجا أملي","فهل له بديار الشرق مشكاة",14,"ه",1,0]]}