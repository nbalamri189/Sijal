{"poems":[[55,"قنا آل فهر لا قنا غطفان","https://www.aldiwan.net/poem29661.html","الطويل"],[88,"مسدي الجميل بلا من يكدره","https://www.aldiwan.net/poem10374.html","البسيط"],[63,"صدودك علم النوم الصدودا","https://www.aldiwan.net/poem51720.html","الوافر"],[51,"أبا جعفر هلا اقتطعت مودتي","https://www.aldiwan.net/poem64237.html","الطويل"],[68,"فكم صاحب مذ بدا سخطه","https://www.aldiwan.net/poem38567.html","المتقارب"],[82,"خيالك للأجفان مثله الفكر","https://www.aldiwan.net/poem31436.html","الطويل"],[89,"لعزة هذي اللاهيات النواعم","https://www.aldiwan.net/poem8339.html","الطويل"],[69,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[164,"أقمن على قلبي رقيبا من الحب","https://www.aldiwan.net/poem58937.html","الطويل"],[173,"بنانك من مغدودق المزن أهطل","https://www.aldiwan.net/poem1659.html",""],[173,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[190,"وإني وإن أصبحت في دار غربة","https://www.aldiwan.net/poem43827.html","الطويل"],[201,"ذري القلب يطوي حبه ويواريه","https://www.aldiwan.net/poem39864.html","الطويل"],[266,"بداية داء الصب في حبه الجفا","https://www.aldiwan.net/poem38230.html","الطويل"],[275,"هزئتم بنفس تجهلون خلالها","https://www.aldiwan.net/poem35616.html","الطويل"],[276,"عسى من خفي اللطف سبحانه لطف","https://www.aldiwan.net/poem52135.html","الطويل"],[287,"أرقت لبرق من أهاضيب لبنان","https://www.aldiwan.net/poem32343.html","الطويل"],[369,"أحن إلى تلك الضحى والأصائل","https://www.aldiwan.net/poem60806.html","الطويل"],[412,"ألمت ودوني من تهامة بيدها","https://www.aldiwan.net/poem50189.html","الطويل"],[438,"تغير عن مودته وحالا","https://www.aldiwan.net/poem12316.html","الوافر"],[445,"بفتح الفتوح وسعد السعود","https://www.aldiwan.net/poem34864.html","المتقارب"],[457,"وظبي غرير أودع الله ثغره","https://www.aldiwan.net/poem13774.html","الطويل"],[519,"خطبت المجد بالأسل العوالي","https://www.aldiwan.net/poem20820.html","الوافر"],[556,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86735","المتقارب"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66968","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112850","الوافر"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82623","الطويل"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143007","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89537","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53105","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53167","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53051","الهزج"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53047","البسيط"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102560","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130833",""],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100174","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108091","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91801","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132153","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102965","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105266","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86463","الطويل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135068","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81710","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133089","الوافر"],[4767,"حصاد الخير","https://www.poetsgate.com/ViewPoem.aspx?id=88342",""],[4815,"صُراخ","https://www.poetsgate.com/ViewPoem.aspx?id=210474",""],[4927,"حب المشاغيف","https://www.poetsgate.com/ViewPoem.aspx?id=29721",""],[4927,"جواز السفر","https://www.poetsgate.com/ViewPoem.aspx?id=80800",""],[4929,"رنين الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=210844",""],[4980,"إذا حِرتَ","https://www.poetsgate.com/ViewPoem.aspx?id=199849",""],[585,"سلوه وقد مال السرير المطنب","https://www.poetsgate.com/ViewPoem.aspx?id=161851",""],[5092,"سؤال","https://www.poetsgate.com/ViewPoem.aspx?id=190569",""],[3591,"إذا ما أنشدت أهلي دمائي","https://www.poetsgate.com/ViewPoem.aspx?id=149383",""],[5216,"عَبَرْنا لِلْخُلود","https://www.poetsgate.com/ViewPoem.aspx?id=186939",""],[5353,"رئة من خشب","https://www.poetsgate.com/ViewPoem.aspx?id=212242",""],[5582,"خَيالٌ سَرَى نَوْمَةَ السَّامِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=187098",""],[5616,"أبها","https://www.poetsgate.com/ViewPoem.aspx?id=205245",""],[5653,"خليلي من قيس بن عيلان خليا","https://www.poetsgate.com/ViewPoem.aspx?id=26386",""],[5667,"الحياة ظل زائل","https://www.poetsgate.com/ViewPoem.aspx?id=214838",""],[5691,"صهيل وصليل","https://www.poetsgate.com/ViewPoem.aspx?id=206153",""]],"verses":[["فَكَم صاحِبٍ تَدمى عَلَيَّ بَنانُهُ","وَيُظهِرُ أَنَّ العِزِّ لَثمُ بَناني",0,"ن",2,0],["فَكَم صَفَحتَ عَنِ الجاني وَلَم تَرَهُ","وَكَم غَرَستَ وَكانَ المُعوِزُ الجاني",1,"ن",2,0],["فكم صَعَّدْنَ من أنفاسِ صَبٍّ","فأروى من مَدامِعِه الصَّعيدا",2,"د",2,0],["فَكَم صاحِبٍ قَد جَلَّ عَن قَدرِ صاحِبٍ","فَأَلقى لَهُ الأَسبابَ فَارتَفَعا مَعا",3,"ع",2,0],["فَكَم صاحِبٍ مُذ بَدا سُخطُه","بَذَلتُ لَهُ خُلُقاً مُرتَضى",4,"ض",2,1],["فَكَم صافَحَتْ مِنها الحروبَ صفائحٌ","وَفَتْ بحصادِ الهام أوراقها الخضرُ",5,"ر",1,0],["فَكَمْ صَاحِبٍ أَلْقَاهُ يَحْمِلُ صَدْرُهُ","فُؤَادَ عَدُوٍّ فِي ثِيَابِ مُسَالِمِ",6,"م",1,0],["فكَمْ صَخْرَةٍ عاديَّةٍ قَذَفَتْ بها","إليه سُهُولٌ جَمَّةٌ وَوُعُورُ",7,"ر",1,0],["فكم صححت أفعاله اليوم عندنا","غرائب تروى للأوائل في الكتب",8,"ب",1,0],["فَكَم صاحِبٍ صاحَبتُهُ لا مُؤَمِّلاً","نَدىً مِن يَدَيهِ غَيرَ أَنّي المُؤَمَّلُ",9,"ل",1,0],["فَكَم صَرِيعٍ هَوى عَفصاً بِشِكَّتِهِ","مِنهُم وَآخَرَ وَلّى الدُبرَ مُنهَزِما",10,"م",2,0],["فكم صابر والصبر أيسر حالة","تأويه بعد الخمول حبور",11,"ر",1,0],["فكم صغتها والدر صعب مناله","عقودا بها الوادي فخور براميه",12,"ي",2,0],["فكم صبوة من دل عزة ذلّلت","فتى كان لا يلقى سوى العز مألفا",13,"ف",2,0],["فكم صهلاتٍ في النَّوى تَستفزُّني","وكم نظراتٍ أستحبُّ اشتِعالها",14,"ل",3,0],["فَكَم صاحب رافقته ليَكون لي","رَفيقا فأَضحى وَهُو بادى الجفا خلف",15,"ف",1,0],["فَكَم صَفِرَت مِن راحَتي راحَتي وَكَم","عَضَضتُ لِندماني أَنامِلَ نَدمانِ",16,"ن",1,0],["فكم صِدْتُ في تلكَ الدِّيارِ وصادَني","على عِزِّ قَوْمي من غَزالٍ مُغازل",17,"ل",1,0],["فَكَم صَعِدَت خُطّابِها كل مِنبَرٍ","وَلَولاكُم واللَهُ قَلَّ صُعودُها",18,"د",3,0],["فكم صَرْفٍ صَرَفْتُ الفِكْرَ عنه","فما أدْرِي تَوَلَّى أَم توالَى",19,"ل",2,0],["فَكَمْ صَبَّحَتْكَ بِفَتْحٍ قَرِيبٍ","سُرى لَيْلَةٍ ذَاتِ صُبْحٍ بَعِيدِ",20,"د",1,0],["فكم صَدَعَ الأحشاء منا ببعده","وجاء بشيء من لواحظه يُقرى",21,"ر",2,0],["فكم صرعَتْ سُيوفُكَ من هِزَبْرٍ","بحيّهم وعفّتْ عن غَزالِ",22,"ل",1,0],["فكم صريعٍ عنده للرّدَى","وكم نجيعٍ حوله يُهرقُ",23,"ق",1,0],["فَكَم صَنَم جئتَه ساجِداً","وَكُنت لَربك لا تَسجُد",24,"د",1,0],["فكم صافَحَتْنِي في مِنَاهَا يَدُ المُنَى","وكم هَبَّ عَرْفُ اللَّهْوِ مِنْ عَرَفَاتِها",25,"ت",3,0],["فكم صب سقاه وما أفاقا","وصار من الكرام الهايمينا",26,"ن",2,0],["فَكَم صَبِيحٍ وَهوَ وَغبٌ مائِقُ","وَكَم قَبيحٍ وَهوَ نَدبٌ فائِقُ",27,"ق",1,0],["فَكَم صاحِب قَد جَلَّ عَن قدر صاحِب","فَمَدَّ لَهُ الأَسبابَ فَاِرتَفَعا مَعا",28,"ع",2,0],["فكم صاح منها هاديا غير خائف","تألب اعداء ومكر جفاة",29,"ه",1,0],["فَكَم صَرَعنَ بِسَهمِ اللَحظِ من بَطَلٍ","عَمداً فَعَلنَ وَما طولِبنَ بِالثارِ",30,"ر",1,0],["فكم صدر رمح دقّ في قلب فيلق","لصرف وجوه الشرك عن ذلك الثغر",31,"ر",1,0],["فكم صلحت بالصالح الملك حالة","لمن كان لا يجدي عليه وسائله",32,"ل",2,0],["فكم صالَ بأصلال","قنا بالدم مخضوبِ",33,"ب",1,0],["فكم صفحت وأغمدت الصفاح وكم","كادت تذوب لما فيها من اللهب",34,"ب",1,0],["فكم صاحب أرجوه عند ملمة","سداداً لها فازددن منه المصائب",35,"ب",1,0],["فكم صورة من كل شكل مهذب","جدير باعجابي وحبي مدى العمر",36,"ر",1,0],["فكم صال فتكاً غير مثنٍ عنانه","لسلم وكم كرت لحرب كتائبه",37,"ب",2,0],["فكم صادفوا في ظل غباس عزةٍ","وكم آنسوا في أرض مصر تنعما",38,"م",2,0],["فَكم صورةٍ حَسناء تقبُحُ عندما","يَنمّ عَليها بالمساوي فؤادها",39,"د",3,0],["فكم صبوت إلى دارٍ نشأت بها","وكم حننت إلى سلسالها الحصب",40,"ب",1,0],["فكم صاد إلى الأحباب يوما","وكم يوم إلى الأحباب صاد",41,"د",1,0],["فكم صنت إليوناً وصنتك فامتثل","وهب لإعمال الطعان الموارق",42,"ق",1,0],["فكم صارخ انقذته حين ما دعا","وكم يا عميد الخلق أغنيت معدما",43,"م",2,0],["فكم صرعت أيدي الردى من شمردلٍ","هزبر شديد البأس أشوش باسل",44,"ل",1,0],["فكم صفا قبلنا للطالبين له","أيام حتى أخذهم غير محتفل",45,"ل",1,0],["فكمْ صدىً قدْ سقَتْ ريًّا ذَوابلُهُ","وكمْ صدىً نقَعَتْ مِنْ صارخٍ نقعا",46,"ع",2,0],["فَكَم صَدىً فِيها وَهامٍ مُجتَلى","يَشكُو الصَدى ما بينَ هامٍ مُختَلى",47,"ا",1,0],["فكم صحت وصرحت بشاني","وما أدركت من يصغي لمن صاح",48,"ح",1,0],["فكم صرفت الوقت من أجلها","فكيف تلهو عنه أو تنسى",49,"س",2,0],["فكَمْ صِدْقٍ بِِها أضحى هُراءً","وكَمْ كَذِبٍ بِها أضحى صَحِيحَا",50,"ح",2,0],["فَكَمْ صَاْلَتْ عَلَىْ كَبِدِيْ","كَمَاْ صَاْلَ الْغَطَاْرِيْفُ",51,"ف",1,0],["6- فَكَمْ صَاْلُوْا وَجَاْلُوْا وَاسْتَبَاْحُوْا","حُقُوْقَ الشَّعْبِ، واخْتَلَسُوا الرِّكَاْزَاْ",52,"ز",2,0],["فكم صمتٍ بصاحبِهِ تسامى","وكم قولٍ لقائِلهِ أعابَا",53,"ب",2,0],["فَكَم صابِرٍ حُقَّت أمانيه كلّها","وكم حاذقٍ إغفالُه من عُجَاله",54,"ل",2,0],["فكم صائحٍ فيهم وكم متوعدٍ","وكم هاجمٍ بالسيف لا يتهيب",55,"ب",1,0],["فَكَمْ صلّى الفؤادُ وراءَ حلمٍ","وكَمْ أمَّ الخيالُ بيانَ عقلي",56,"ل",2,0],["فكم صبحٍ يظل بلا غذاءٍ","وكم مسيٍ يبيت بلا عشاءِ",57,"ا",2,0],["فكَمْ صَدَّتْ وكَمْ رَدَّتْ غُزاةً","بعصرِ زماننا وبعصرِ “مينا”",58,"ن",2,0],["فكم صبرنا وكم حمَّلتَ كاهلَنا","ما لا نُطيقُ وأعيى صبرَنا الحنقُ",59,"ق",1,0],["فَكَمْ صارَ فِي الرَّكْبِ مِنْ مُنْجِدٍ","بِها يَتَغَنَّى وَمِنْ غائِرِ",60,"ر",1,0],["فكم صعدْتُ جبالاً أوهنَتْ جسَدي","وكم سقطْتُ من الإعياءِ في حُفَرِ",61,"ر",1,0],["فكم صافحتني في مناهد يد المنى","وكم هب عرف اللهو من عرفاتها",62,"ت",3,0],["فكمْ صَحبتَ خليلاً دونَما هدف","وكمْ أساءكَ من أصحابِكَ الهَدَفُ",63,"ف",1,0],["فكمْ صوْلَةٍ فيها الرِّماحُ تكسَّرَتْ","وكانَ حِوارُ القاطِعاتِ صَليلا !",64,"ل",2,0]]}