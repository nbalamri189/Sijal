{"poems":[[53,"علني أحمد من الدوشاب","https://www.aldiwan.net/poem8651.html","الخفيف"],[53,"مقل العين لا عدمت كراك","https://www.aldiwan.net/poem65830.html","الخفيف"],[91,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/20203","الخفيف"],[193,"سيد الرسل قدره معلوم","https://www.aldiwan.net/poem35108.html","الخفيف"],[374,"عقني الصبر منذ أقوى العقيق","https://www.aldiwan.net/poem4296.html","الخفيف"],[409,"آه من برق إليكم قد روى","https://www.aldiwan.net/poem33915.html","الرمل"],[543,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[543,"لا مصاب في هذه الدنياء","https://www.aldiwan.net/poem48312.html","عموديه"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77555","الرمل"],[928,"","https://poetry.dctabudhabi.ae/diwan/poem/145673","الرمل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113977","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108752","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20387","الخفيف"],[1997,"","https://poetry.dctabudhabi.ae/diwan/poem/202565","المتقارب"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130832",""],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140047",""],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104671","الرمل"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89404","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81257","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81237","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136642",""],[5136,"زارني طيفه فأهلا وسهلا","https://www.poetsgate.com/ViewPoem.aspx?id=121785",""],[5145,"من لبرقٍ على البراق أنارا","https://www.poetsgate.com/ViewPoem.aspx?id=108062",""],[6084,"أشرقت شمس الضحى بالغلس","https://www.poetsgate.com/ViewPoem.aspx?id=170846",""]],"verses":[["ثم أومَى بالعود قلتُ له العَوْ","دُ حميدٌ لكنْ إلى مُسْتَطابِ",0,"ب",1,0],["ثم أوقعتني ومتّعتِ بالغم","ضِ برعي النجوم والأفلاك",1,"ك",1,0],["ثم اودعته حقائق تسمو","فاتي جامعاً لكل مفيد",2,"د",1,0],["ثمَّ أُوافيكَ على استِعجالِ","بالأهلِ والأَولادِ والعِيالِ",3,"ل",1,0],["ثُمَّ أَوفَت مِثلَ الجِبالِ عَلى الفُل","كِ وَلِلفُلكِ عَزمَةٌ لا تَخورُ",4,"ر",1,0],["ثمَّ أَوصى بالأهلِ والقرآنِ","قالَ هذان فيكمُ ثقلانِ",5,"ن",1,0],["ثم أودى به المشيبُ فمالي","منه إِلا تذكُرٌ وشهيقُ",6,"ق",1,0],["ثم أومى لي أن اقعد ههنا","خلف ذا الستر وللجفن كسر",7,"ر",1,0],["ثم أَوحِي لِي بمَا لم","به توحِي لِسِوائي",8,"ي",1,0],["ثُمَّ أولِ الدُّعاء منكَ ثَرَاهُ","فَهوَ سُبحَانه مجيبُ الدعاء",9,"ا",2,0],["ثُمَّ أَوصاها تدارى أَمره","قالَت أؤمر إِنَّما الأَمر مُطاع",10,"ع",1,0],["ثم أومى والثريا يده","وسهيل في سناها يتقد",11,"د",1,0],["ثُمَّ أورَدتُهُم سُحَيراً قليباً","مُطلِباً معيِياً على الدُلّالِ",12,"ل",1,0],["ثم أومت بطرفها","إن رب الحمى عرى",13,"ر",2,0],["ثم أوحى للبدر أن خُذ مداراً","حول سيَّارِها وسِر في أمانِ",14,"ن",1,0],["ثُمَّ أوحى ربُّ الوجودِ إليها","ملهمات أعيت علوم البيانِ",14,"ن",1,0],["ثم أوقفَتهُم لديه حيارى","يتمارَونَ حين ضَلَّ المِراء",15,"ا",2,0],["ثُمَّ أَوحَدتَني وَأَخلَلتَ عَرشي","بَعدَ فُقدانِ سَيِّدٍ وَمَسودِ",16,"د",1,0],["ثم أومت نحو مصباح لها","كاد يخبو سحرا أو قد خبا",17,"ب",2,0],["ثم أولادك رحمة من لدنه","كي يكون الجزاءُ بالميزان",18,"ن",1,0],["ثم أوحى لقلبه كل علم","من كلام منزل في كتاب",19,"ب",1,0],["ثُمَّ أَوحى اللَهُ ما أَوحى إِلى","حِبِّهِ في القُربِ لَمّا مَكَّنا",20,"ن",2,0],["ثم أويس بك صالح تقيّ","في الباب من مقامه محميّ",21,"ي",1,0],["ثم أولى الضلوع ناراً وولَّى","برقادي ومهجتي وظنوني",22,"ن",2,0],["ثُمَ أَودى يا وَيحه ضاقَت الدُن","يا بِهِ جُهدِها إِحتِمالا وَصَبرا",23,"ر",2,0],["ثُمَ أَوحى إِلَيهِ إِن قَد تَخَير","تك هَدياً فَاِصدَع بِأَمر القَدير",24,"ر",1,0],["ثم أومت نَحوي بطرفٍ وقالت","إنَّ لي من هَواك سراً مَصونا",25,"ن",2,0],["ثم أوحى من قاب قوسين أو أد","نى إلى عبده هواه وولى",26,"ل",2,0],["ثمّ أومأت للعناق فما عت","م حتى استكنّ منّي ونارا",27,"ر",2,0],["ثم أومت في حياة لهم","فاحتيت منها حياة المجلس",28,"س",1,0]]}