{"poems":[[53,"أعوذ بحقويك العزيزين أن أرى","https://www.aldiwan.net/poem65771.html","الطويل"],[139,"أضاعني الظبي على حفظه","https://www.aldiwan.net/poem49031.html","السريع"],[147,"لو أن شامخ قدر دافع قدرا","https://www.aldiwan.net/poem11764.html","البسيط"],[343,"وراغب في العلوم مجتهد","https://www.aldiwan.net/poem68793.html","المنسرح"],[396,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[396,"يا طالب الخير في الدينا ويوم النشور","https://www.aldiwan.net/poem54581.html","عموديه"],[438,"راح يوافي طراده طرده","https://www.aldiwan.net/poem12432.html","المنسرح"],[534,"تعاضدتم بغيا لنشر المظالم","https://www.aldiwan.net/poem37211.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86617","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64923","المنسرح"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112956","الطويل"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67385","الرجز"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139469",""]],"verses":[["وراغمني فيما أتى من ظُلامتي","وقال لي اجهدْ فيّ جُهْدَ احتيالكا",0,"ك",2,0],["وراغ منى رائماً روعتي","وكم غدا في نبذ وصلى ورا",1,"ر",2,0],["وَراغِبٍ عَن سَريرِ المُلكِ فارَقَهُ","فَعاضَهُ اللَهُ في جَنّاتِهِ سُرُرا",2,"ر",2,0],["وَراغِبٍ في العُلومِ مُجتَهِدٍ","لَكِنَّهُ في القَبولِ جُلمودُ",3,"د",1,1],["وراغبا في السلامه كف هذى اللهاه","فما يكب الخلائق في جهنم سواه",4,"ا",2,0],["وراغبا في السلامة من جميع الشرور","ويا محب الهدى المفضي لشرح الصدور",5,"ر",1,0],["وراغَ حتَّى دَعَوْهُ ثَعْلَبَهُ","وراعَ حتى دَعَوا بهِ أَسَده",6,"د",2,0],["وَرَاغَمْتُمُ الدِّينَ الْحَنيفَ وَصُلْتُمُ","عَلَى مَنْ دَعَا لِلحَقّ صَوْلَةَ ظالِمِ",7,"م",1,0],["وَراغِباً في عُموم النَفع لِلوَطن ال","مألوف بِالهمة المَمدودة الطنب",8,"ب",1,0],["وراغبٌ في الثَّناءِ يُحرِزُهُ","وزاهدٌ في البُدورِ يَبْذُلُها",9,"ل",3,0],["وراغب وأرغب منه حسن ولاية","تدوم فان تظفر فبشراك بالاجر",10,"ر",1,0],["وَرَاغَ لَمَّا سَمِعَ ارْتجَازِي","رَوْغَ الحُبَارَى منْ خَوَاتِ البَازِ",11,"ز",1,0],["وراغيةٍ ثنتكَ عن التصابي","كما ثنت الضعيف يد القويِّ",12,"ي",1,0]]}