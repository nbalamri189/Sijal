{"poems":[[73,"أضالع تنطوي على كرب","https://www.aldiwan.net/poem3834.html","المنسرح"],[74,"سيج ورد الخدود بالآس","https://www.aldiwan.net/poem19018.html","المنسرح"],[53,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[104,"هادئ القلب مطبق الأجفان","https://www.aldiwan.net/poem33126.html","الخفيف"],[92,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[92,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[136,"دمن الأحبة لو عصيت العاذلا","https://www.aldiwan.net/poem54777.html","الكامل"],[264,"نحن قوم لنا السماع غذاء","https://www.aldiwan.net/poem35546.html","الخفيف"],[367,"سر منقلبًا","https://www.aldiwan.net/poem11643.html","عموديه"],[422,"سلمه الرب من الأسواء","https://www.aldiwan.net/poem53860.html","الرجز"],[438,"يا نجم دين الله حي","https://www.aldiwan.net/poem12503.html","مجزوء الكامل"],[543,"بعد التطلع لي بعيد ندائي","https://www.aldiwan.net/poem48308.html","عموديه"],[563,"طاب وقتي بلطيف مسمع","https://www.aldiwan.net/poem33890.html","الرمل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122374","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120071","المجتث"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120048","الخفيف"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203786",""],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125359","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53030","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77211","الخفيف"],[2362,"","https://poetry.dctabudhabi.ae/diwan/poem/198790","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140092",""],[2995,"","https://poetry.dctabudhabi.ae/diwan/poem/198812","البسيط"],[3024,"","https://poetry.dctabudhabi.ae/diwan/poem/138037","الخفيف"],[3228,"","https://poetry.dctabudhabi.ae/diwan/poem/138836",""],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52971","الكامل"],[4750,"يآسوريآ عذراً","https://www.poetsgate.com/ViewPoem.aspx?id=180444",""],[4984,"عِيدِيَّةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=204720",""],[5072,"إدانة الصفصاف","https://www.poetsgate.com/ViewPoem.aspx?id=55364",""],[5150,"أم الدنيا .. مصر ..!","https://www.poetsgate.com/ViewPoem.aspx?id=202872",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[5344,"فنجال مع الوالده ..","https://www.poetsgate.com/ViewPoem.aspx?id=180707",""],[5409,"حدثينا يا فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=155283",""],[5573,"طال السهر","https://www.poetsgate.com/ViewPoem.aspx?id=200217",""],[5573,"الفصول الاربعة","https://www.poetsgate.com/ViewPoem.aspx?id=200352",""],[5596,"جامعة نزوى","https://www.poetsgate.com/ViewPoem.aspx?id=206686",""],[5776,"لحيةُ الصّبح","https://www.poetsgate.com/ViewPoem.aspx?id=199324",""]],"verses":[["وَالمغزلُ الحَنبَلِيُّ مُجتَهِداً","يفتلُ في لِستِ الثقَّالَةِ الكتبي",0,"ب",2,0],["والمغربي الوزير أصبح من","روعته يعتزي إلى فاس",1,"س",1,0],["والمغاويرُ بالياتٌ كما عا","يَنْتَ مَوْرَ الكتيبة الجأواءِ",2,"ا",2,0],["وَالمَغاني مَأهولة وَالرَوابي","باديات نَواضِراً للعَيان",3,"ن",1,0],["والمغرِياتُ مُراوداتٌ ترتجى","وتَخيبُ ، من عُونٍ ومن أبكار",4,"ر",1,0],["والمغدِقونَ على \" البياضِ \" نعيمَهُمْ","حَضْنَ الطيورِ الرائماتِ زواغبا",5,"ب",2,0],["والمُغني الفُقَراءَ مِن نَفحَاتِه","والمُولِىَ الضُّعَفَاءَ رِفقاً شَامِلا",6,"ل",2,0],["والمغنّي قد راح من راح كأسي","مطرباً إذ يديره الإصغاء",7,"ا",2,0],["والمغرِبُ قد أمسى شرقً","يتوَهَّجُ نورًا ولهيبا",8,"ب",2,0],["والمغرم العاشق من يهواه","إذا دعاه للمنى هواه",9,"ه",1,0],["والمغتدى للمُعتدى","بيديْ مَصالِ بني مَصالِ",10,"ل",1,0],["والمُغرِضُون بِرنتُ من أعراضِهم","وأنا عدُوَّهمُ وهُم أعدَائي",11,"ا",2,0],["والمغني والغنا آلته","تُوهَبُ الأسرار من حلقهما",12,"م",2,0],["والمغصون حوله","دلائل المنهمك",13,"ك",1,0],["والمغمد البيض حمرا","بين الطلى والنحورِ",14,"ر",1,0],["والمغاني غنية بشموس","قد فضلن الشموس في الأشراقِ",15,"ق",1,0],["والمغرب الدامي به","ضر الأسيرة والرزوحُ",16,"ح",1,0],["والمُغرياتِ الصَّافياتِ وما لها","في النَّفسِ من شوقٍ ومن تحنانِ",17,"ن",1,0],["والمغاني مأنوسة بالغواني","أمنت بالأسود فيها الظباء",18,"ا",2,0],["وَالمُغَنّونَ في بُلَهنِيةٍ","حَولَهُم مِن ثِمارِها طرفُ",19,"ف",1,0],["والمغرب العربي يلجمه الأسى","كمد يحل وكربة بكماء",20,"ا",2,0],["والمُغزِرَاتُ في الشَمالِ والوَسَط","وفي المَشَارِق لا تَكُونَ ذَا غَلَط",21,"ط",1,0],["والمغنطيس بمنسة احجاره","جبل يعلق فيه كل حديدة",22,"ه",1,0],["والمغرب العربي انقض مضجعه","وكاد من صدمة الأخبار ينفجر",23,"ر",1,0],["وَالْمُغيثينَ عِنْدَ كُلِّ بَلاءِ","أنْتُمْ مَلْجَأي وَكَهْفَ عَنائي",24,"ي",1,0],["والمغمدي السيف في هام الكماة إذا","شَظُّوا بطعنهمُ ضُمّ الأنانيب",25,"ب",1,0],["والمغربي لما حكى هذا نفى","وبوقته عن أرض طهطا قد نبا",26,"ب",2,0],["والمغرب الاقصى عليھ التحيآت","اوادم(ن) من فيدهم ميّسينآ",27,"ن",2,0],["والمغرضون تبادلوا","أدوار عُشَّاق الشعاع",28,"ع",1,0],["والمغرِيات ُ من الرِّغاب ِ تُعيدُني","لأبادرَ التّيارَ ساعة َ دورتِهْ",29,"ت",2,0],["والمغرب العربيُّ جرحٌ نازفٌ","وأرى الخليجَ ينوءُ بالإرهاقِ",30,"ق",1,0],["والمغرب الحر لايرضى اصالته","عبر التواريخ تقسيم وتذليل",31,"ل",1,0],["و(المغرب) الحر مناع لعزته","مستبسل وعرين الليث مشبول",31,"ل",1,0],["والمغترب فوج الفكر ينطح الفوج","من وين ما وجّه جروحه عطايب..",32,"ب",1,0],["والمغاني اللات من حو","لك قد أصبحن درسا",33,"ا",1,0],["والمغتني يعرف قدر كل تفصال","والي نسيجه مايجي بالدنانير",34,"ر",1,0],["والمغتني يعرف قدر كل تفصال","الي نسيجه مايجي بالدنانير",35,"ر",1,0],["و(المغتسي أحمدٌ بالعلم) رائدها","كسا المريدين بالأفضال يُسديها",36,"ي",3,0],["والمغنّى لأجلهِ ما تماهى","فيهما أو منْ المزيجِ سيُجنى",37,"ن",2,0]]}