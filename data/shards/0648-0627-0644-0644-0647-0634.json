{"poems":[[580,"قتلي لحبكم شهادة","https://www.aldiwan.net/poem3076.html","مجزوء الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118001","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90811","الكامل"],[5338,"أين الحميا من لمى من أرتجي","https://www.poetsgate.com/ViewPoem.aspx?id=187696",""],[5351,"جسد واحد","https://www.poetsgate.com/ViewPoem.aspx?id=202974",""]],"verses":[["واللهُ شرَّفه وفضَّ","لَه وأَعْطَاه وزَادَه",0,"د",2,0],["والله شرٌّ مِنهُمَا فَهُمَا عَلَى","أهلِ الضَّلاَلَةِ والشَّقَا عَلَمَانِ",1,"ن",1,0],["واللّه شاكر سعيكم ورسوله","وأمينه عبد الحميد الثاني",2,"ن",2,0],["والله شرفهم وطهرهم بأن","قد اذهب الإرجاس عنهم والعنا",3,"ن",2,0],["وَاللهُ شَرَّفَنا بِهِمْ لُطْفَاً بِنَا","لِوُرودِ تَسْنِيمٍ لَهُمْ لَمْ يُمْزَجِ",4,"ج",1,0],["والله شاهد والوقايع شاهدة","حسب المواقع حسب ميقات الجهاد",5,"د",1,0]]}