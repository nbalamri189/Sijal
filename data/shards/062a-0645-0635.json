{"poems":[[92,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[96,"عيد الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=12815",""],[473,"تمصبطرمت في عتبي عليه","https://www.aldiwan.net/poem59541.html","الوافر"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11195","الطويل"]],"verses":[["تَمُصُّ دماً ثُم تبغي دماً","وتبقى تُلِحُ وتستطعِم",0,"م",1,0],["تمّ صفو الدّهر لولا محنة","في فلسطين وبلوى وشقاء",1,"ا",2,0],["تَمَصبَطرَمتُ في عَتبي عَلَيهِ","كَأَنّي لَيسَ قَلبي في يَدَيهِ",2,"ي",2,1],["تَمَصَّخُ أَسناخَ الرُّخامى وَتَرعَوي","إِلى خَرِقٍ في عَهدِها مُتَضائِلِ",3,"ل",1,0]]}