{"poems":[[36,"أضوء سنا برق بدا لك لمعه","https://www.aldiwan.net/poem4863.html","الطويل"],[74,"ما البرق في كانونه قد قدح","https://www.aldiwan.net/poem18480.html","السريع"],[74,"أهلا بها صحف الإمام المسند","https://www.aldiwan.net/poem18563.html","الكامل"],[41,"طربت وشاقك البرق اليماني","https://www.aldiwan.net/poem53730.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42603","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54586","البسيط"],[108,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[178,"جدد البين كروبا","https://www.aldiwan.net/poem46061.html","مجزوء الرمل"],[458,"جزيرة النور تحيينا","https://www.aldiwan.net/poem61396.html","السريع"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101518","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59690","الخفيف"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111867","البسيط"],[2027,"","https://poetry.dctabudhabi.ae/diwan/poem/101860","السريع"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123042","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74230","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132794","الرجز"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93304","الخفيف"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117211","الكامل"],[4816,"اعد لك شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=8483",""],[5973,"مساء عينيك فضة ٌ وعطور","https://www.poetsgate.com/ViewPoem.aspx?id=13276",""]],"verses":[["أَضَوءُ سَنا بَرقٍ بَدا لَكَ لَمعُهُ","بِذي الأَثلِ مِن أَجراعِ بيشَةَ تَرقَبُ",0,"ب",1,1],["أضوأ من ذهنك ناراً ولا","أرقّ من لفظك كأساً طفح",1,"ح",1,0],["أضواؤها وسناؤها ووفاؤها","للمجتني والمجتلي والمجتدي",2,"د",2,0],["أَضَوءُ البَرقِ يَلمَعُ بَينَ سَلمى","وَبَينَ الهَضَبِ مِن جَبَلَي أَبانِ",3,"ن",1,0],["أَضَواءَ البَرقِ بِتَّ تَشيمُ وَهناً","لَقَد دانَيتَ وَيحَكَ غَيرَ داني",3,"ن",2,0],["أَضَوْءُ شَمْسٍ فَرَى سِرْبَالَ دَيْجُورِ","أَمْ نُورُ عِيدٍ بِعَقْدِ التَّاجِ مَشْهُورِ",4,"ر",1,1],["أَضْوَاؤُكُمْ فِي الْعُيُونِ شَتَّى","وَكُلُّ تِلْكَ الأَضْوَاءِ كَوْكَبْ",5,"ب",1,0],["أَضْوَعُ من مِسْكٍ ومن مَلاَب","ليُعرَف الزيفُ من اللباب",6,"ب",1,0],["أَضْوَأَ اللَّيْلُ سَناها","لَمَعاناً وَلَهِيبَا",7,"ب",2,0],["اضواؤها أبهج أشعارها","وألوانها تحكي أغانينا",8,"ن",2,0],["أضواؤها في الليل نور حُباحبٍ","ما إن تقيل بني السبيل عثارا",9,"ر",2,0],["آض وهْناً بعد ما","سح دمعي وأنسجم",10,"م",1,0],["اضوى الغرامُ فؤاداً غاب عاذرهُ","واتلف الشوقُ جسماً عزَّ ناصرهُ",11,"ه",1,1],["أضوء بدر أم محياه","ولمع برق أم ثناياه",12,"ا",2,1],["أضوء صُبح بدا أم ثغر مُبتسم","وليل شعر دجا أم حُندس الظُّلَم",13,"م",1,1],["أَضوء بان أم طَلعَ النَهار","وَبَدر لاحَ فَانكَشَف الغُبار",14,"ر",1,1],["اضوع مسكا وافوح عنبرا","والطعم يحكى شهدة وسكرا",15,"ر",2,0],["أضو سأَلتُمْ أَيُّ البديعيْن أَذْكى","جُلَّ ناري فذلك الجُلَّنار",16,"ر",1,0],["أضواء مجد شامخات في العلا","كرموا فسادوا محتداً ونجارا",17,"ر",2,0],["اضوي ليالك والشمع خمسة الراح","وأسقيك نن العين دمع نضوحي",18,"ح",2,0],["أضواء ُعمري حبيبتي اختنقت","فحاضري بالظلام ِ يشتَعلُ",19,"ل",1,0]]}