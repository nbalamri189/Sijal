{"poems":[[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[87,"فلوس الشغل ما تأخير","https://www.aldiwan.net/poem7900.html","الكامل"],[54,"منزل أقوى بسلمى وربوع","https://www.aldiwan.net/poem26865.html","الرمل"],[164,"أما الوشاة به فقد ظلموه","https://www.aldiwan.net/poem58961.html","الكامل"],[182,"هد الجوى ركبي","https://www.aldiwan.net/poem50687.html","المواليا"],[353,"عمر المعمر والصغير سواء","https://www.aldiwan.net/poem19830.html","الكامل"],[435,"سل البان هل مرت عليه النوافح","https://www.aldiwan.net/poem41406.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63803","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108773","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93691","الكامل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93389","السريع"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70138","الكامل"],[4767,"صرح الفضيلة","https://www.poetsgate.com/ViewPoem.aspx?id=100459",""],[3591,"ألم تزالوا على الحسن الذي سلفا","https://www.poetsgate.com/ViewPoem.aspx?id=149466",""],[5461,"في سحابه","https://www.poetsgate.com/ViewPoem.aspx?id=26286",""],[6127,"صوتك النور","https://www.poetsgate.com/ViewPoem.aspx?id=191300",""],[6131,"الجذرُ..العتيقْ","https://www.poetsgate.com/ViewPoem.aspx?id=189264",""]],"verses":[["ذا صَباحٍ فَلَم أُوافِ لَدَيهِ","غَيرَ عَذّالَةٍ تَهِرُّ هَريرا",0,"ر",2,0],["ذا صادر ذا وارد ذا ساير","هذا حسابات أبو البركات",1,"ت",1,0],["ذا صَباحٍ وَطُروقٍ بِظَلامٍ","وَبَكوراً وَقَطا الأَرضِ هُجوعُ",2,"ع",1,0],["ذا صادر راو وهذا وارد","ولو ارتوى الثقلان ما نزفوه",3,"و",2,0],["ذا صوتُ إنْساني","وكُلُّكُم إنْسانْ",4,"ن",1,0],["ذا صَنْدَلٌ فَوقَ الرؤوسِ مَكانُهُ","لِمْ لا وفيهِ لِلرؤوسِ شِفاءُ",5,"ا",2,0],["ذا صح لي منك الرضى بت شاكرا","وحققت ان الدهر بالعهد ناصح",6,"ح",1,0],["ذا صقيعٌ ذا زمهريرٌ كما كا","ن وهذي الثلوجُ والأمطار",7,"ر",1,0],["ذا صباح الصبوح يا ميُّ أشرقْ","أم محياك فهو أبهى وأشرقْ",8,"ق",1,1],["ذا صاحب الكَف الَّتي ديم الحَيا","تَمتار مِنها وَالأَنام عِيالها",9,"ل",3,0],["ذا صَولجانٍ أبنوسٍ وَتف","فاحِ لجينٍ صوغُ صَوَّاغِهِ",10,"غ",2,0],["ذا صَخرة مِنها الحَياة لِطالبٍ","كَم صادرَ عَنها وَكَم مِن وارِدِ",11,"د",1,0],["ذا صفحة بيضاءَ لم","تحمل عليها مَغرما",12,"م",2,0],["ذا صبّ باريس ما أبقت نواظرنا","له سوى رسم جسمٍ كالطلول عفا",13,"ف",2,0],["ذا صوابه .. عقب ما هو طعني","لو نسيته يذكرني صوابه",14,"ب",2,0],["ذا صاحب الدر مهموما يلملمه","متى تجمع كان العدل منتشرا",15,"ر",2,0],["ذا صوتِيَ الحُرُّ الكريمُ يؤزُّهمْ","وَ يُحيلُهمْ في مَسْمَعِ الدّنيَا صَدَى",16,"د",2,0]]}