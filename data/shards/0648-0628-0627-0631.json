m/ViewPoem.aspx?id=157929",""],[5409,"لم تنجب الأيام إلا","https://www.poetsgate.com/ViewPoem.aspx?id=155495",""],[5425,"شَوْقٌ ، أَمْ حَسَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=198953",""],[5444,"آيات الوصال","https://www.poetsgate.com/ViewPoem.aspx?id=205510",""],[5660,"حَماكَ اللهُ يا عَمرو","https://www.poetsgate.com/ViewPoem.aspx?id=24829",""],[5670,"دِيارٌ هجرناها !","https://www.poetsgate.com/ViewPoem.aspx?id=211212",""],[5690,"إذا الصارم البتار عزت مضاربه","https://www.poetsgate.com/ViewPoem.aspx?id=172139",""],[5709,"وشاح الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=197521",""],[5956,"رغم التآمرِ","https://www.poetsgate.com/ViewPoem.aspx?id=192938",""],[5969,"شِفاءْ","https://www.poetsgate.com/ViewPoem.aspx?id=204788",""],[6088,"حسان","https://www.poetsgate.com/ViewPoem.aspx?id=207592",""],[6142,"إذا ما سهام الدهر أغرق نزعها","https://www.poetsgate.com/ViewPoem.aspx?id=155756",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[313,"أمل المحروم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66512&r=&rc=34",""],[6202,"رسالة إلى الكبيسي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86725&r=&rc=26",""],[6222,"أطلق يدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1933&r=&rc=4",""],[6251,"وَثائِق ُالشَّمْس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76466&r=&rc=6",""]],"verses":[["وَبارِقٍ أَشيمُهُ","كَالطَرفِ أَغضى وَرَنا",0,"ن",2,0],["وَبارِقاتٌ كَما شَق","قَتِ العَجاجَ القُضبُ",1,"ب",1,0],["وَبارِقَةٍ تَمَخَّضُ بِالمنايا","صَخُوبِ الرّعْدِ دامِيَةِ الظِّلالِ",2,"ل",1,1],["وَبارِز تَميماً بِالغِنى إِنَّ لِلغِنى","لِساناً بِهِ المَرءُ الهَيوبَةُ يَنطِقُ",3,"ق",1,0],["وَبارِدٍ رَتِلٍ عَذبٍ مَذاقَتُهُ","كَأَنَّما عُلَّ بِالكافورِ وَاِغتَبَقا",4,"ق",2,0],["وَبارِدِ النِيَّةِ عايَنتُهُ","يُكَرِّرُ الرَعدَةَ وَالهَزَّه",5,"ه",1,1],["وبارقٌ وعُذيبٌ كلّ مبتسم","من الثغور يُجلّيها مُجَلِّيها",6,"ي",3,0],["وبارت فوقه خفقان قلبي","بحالتي أرتفاع وأنحطاط",7,"ط",1,0],["وَبارَكَ في مَسيرِكُم مَسيراً","وَبارَكَ في مَقامِكُم مَقاما",8,"م",2,0],["وبارق من أعالي الجذع أرَّقني","حتَّى دموعي على مرجانه لولو",9,"ل",2,0],["وبارزوا اللَّه في قربى النبي ولم","يرعوا له حرمة القربى ولا الإصر",10,"ر",1,0],["وباركَكِ النُّورُ فاستقبلي","شَبابَ الحَيَاةِ وخصْبَ العُمُرْ",11,"ر",1,0],["وَبِأَرعَنٍ لَبِسَ العَجاجَ إِلَيهِمِ","فَوقَ الحَديدِ وَجَرَّ مِن أَذيالِهِ",12,"ل",2,0],["وبأرضِ بُرقةَ والصعيدِ روائعٌ","لِلَهيبِها في الخافقَيْنِ شرارُ",13,"ر",1,0],["وَبارِزُ الوَجهِ يُبديهِ البَيانُ وَكَم","عَيٍّ تُغَطّي عَلى مَكنونِهِ الحُجُبُ",14,"ب",1,0],["وِباراً بِالفَضاءِ سَمِعنَ رَعداً","فَحاذَرنَ الصَواعِقَ حينَ ثارا",15,"ر",2,0],["وبارِقَتَيْنِ في يُمناكَ هذي","تُشامُ حَياً وهذي لا تُشامُ",16,"م",1,0],["وَبارِقٍ كَسَقيطِ الزَندِ مُقتَدَحاً","لَهُ يَدٌ لِزِنادِ الشَوقِ قَد قَدَحَت",17,"ت",1,0],["وبأرْبعٍ جاءتكَ في ترْكيبها","بالطّبْعِ مُفْرَغَةً على تركيبهِ",18,"ب",2,0],["وَبَارَاهُمَا الطَّائِيُّ فَاعْتَرَفَتْ لَهُ","شُهُودُ الْمَعَانِي بِالَّتِي هِيَ أَحْكَمُ",19,"م",1,0],["وَبارَكَ في نَواحيها وَزَكَّى","بِها ما كانَ مِن حَرثٍ وَمالِ",20,"ل",1,0],["وَبارقات مساء","يحمرُّ منها الدخان",21,"ن",1,0],["وَبَارَكَ اللهُ فِي قِرَانٍ","طَالِعُهُ فِي السُّعُودِ عَالِ",22,"ل",1,0],["وبارز الوجه يبديه البيان، وكم","عي تغطي علة مكنونه الحجب",23,"ب",1,0],["وبا ربّ هذي مهجتي وجراحها","سيبقين إلاّ عنك سرّا محجّبا",24,"ب",2,0],["وبارقَ بعضُ العالمينَ نساءَهم","وضاقَ بهم من ذلك الوعرُ والسهلُ",25,"ل",1,1],["وبَارَكَ في سَوَاكِنِهِ بِجِاهِ الن","نَبِيِّ وَجَاهِ أصحَابِ النَّبِيِّ",26,"ي",1,0],["وبَارَكَ في مَالٍ إذَا الدَّهرُ فَرَّعَن","كَوَالِحَ عُصلٍ وأشمَأزَّ وصَمَّمَا",27,"م",2,0],["وبَارَكَ في بَنِيهِ وفي بَنِيهِم","أهِلِّةِ دَهرِنَا الغُرُرِ الحُجُولِ",28,"ل",1,0],["وبَارِك لأهلِيهِ وأيِّد أمِيرَهُم","وتَمِّم عَلَيهِ النَّصرَ واليُسرَ والعُلا",29,"ل",2,0],["وبِأرجَاءِ ذِى السفي مَنزِلاَتٌ","كَالوِشَامِ المُكَفِّفِ التَّرجِيعِ",30,"ع",1,0],["وبَارَك فِيهِم وفي دارَهِم","ونَالوا من الله حُسنَ القَضَا",31,"ض",2,0],["وَبارَينَ الرِياحَ لِكَسبِ نَصرٍ","رَجَعنَ حَوامِلاً مِنهُ وَسوقا",32,"ق",2,0],["وَبَارَكَهُ الإِلَهُ بِعِزِّ قَوْلٍ","تَسَابَقَهُ الأُولَى نِعْمَ الرِّهَانُ",33,"ن",1,0],["وباريْتَ أملاكَ الزمان ففُقْتَهُمْ","وقَصَّرَ منهمْ عنك صِيدٌ أَكارم",34,"م",1,0],["وبارزةٍ بين أحبارِها","بروز الشموس لإسفارها",35,"ر",3,1],["وبارقٍ مثل الحريق المُوقَد","أَرَّق عيْنَيَّ فلم أوَسَّدِ",36,"د",1,0],["وَبارِقٍ لاحَ نَحوَ الجِذعِ هَيَّجَ لي","بِالرَقمَتَينِ صَباباتٍ قَديماتِ",37,"ت",1,0],["وَبارِقٌ هَيَّجَ لي","فَرطَ الأَسى وَالأَسَفا",38,"ف",2,0],["وَبارِقٍ مُستَطيرٍ","في لُجَّةِ اللَيلِ قادِح",39,"ح",1,0],["وَبَارَكَ اللهُ فِي ذَا النَّجْلِ إِنَّ لَهَا","بِهِ لَدَى الْفَخْرِ إِيرَادٌ وَإِصْدَارُ",40,"ر",1,0],["وَبَارَكَ اللهُ فِيمَنْ حَازَ مَا تَرَكُوا","فَصَاغَ مَا سَبَكُوا وَحَاكَ مَا حَبَكُوا",41,"ك",3,0],["وَبأَرضِ الهند طالَت غيبتي","إنَّها ساءَت مقرّاً وَمُقاما",42,"م",2,0],["وَبارقُ بشرٍ للقرى يُسجمُ النّدى","سَقيطاً وَيوري البأسَ يومَ الوغى سقطا",43,"ط",2,0],["وَبإِرثِها قَد قال رجلي هذهِ","مِن أولياءِ اللّه فوق رؤوسِ",44,"س",1,0],["وَبِأَرضِهِمْ سُمْرُ الرِّماحِ عَوَاطِفٌ","مَسَّاسَةٌ وَظُبَا الصّفَاحِ بَوَاتِرُ",45,"ر",1,0],["وَبارد يَحتَدّ مِنّا حمقا","إِذا رَأَينا مِنهُ رَأياً فاسِدا",46,"د",2,1],["وبارك في الأبناء من بركاته","وبارك في الاخوان إذ ألهموا الصبرا",47,"ر",2,0],["وبآرائه إذا ما استُضيئتْ","وبأقلامِه إذا ما استمَدّا",48,"د",2,0],["وَبارق باتَ جَنح اللَيل يُضحك في","جَوّ الحِجاز وَلي طَرف يُراعيه",49,"ي",2,0],["وَباري العِبادِ لَطيفٌ بِهِم","فَلا تؤيس النَفسَ من لُطفِهِ",50,"ف",2,0],["وبارقُ عارِضُكم وامضٌ","وعارضُ إحسانكم ممطر",51,"ر",1,0],["وبارَزْتَ حتَّى لم تجد من مبارزٍ","وصادَمْتَ حتَّى لم تجد من مصادم",52,"م",1,0],["وبارعاً حل في تربٍ وكان له","بين الورى رتبٌ زهرٌ علياتُ",53,"ت",1,0],["وبارى هُوِيَّ الرِّيحِ يَسْبِقُها هَوىً","وغالَ قِفارَ البِيدِ يَنْسِفُها طَيَّا",54,"ي",2,0],["وَبارِقَةٍ منْ مُقْلَتيْ أُمِّ مِلْدَمٍ","ثَنَتْنِي صريعاً لليَدَيْنِ وللجَنْبِ",55,"ب",1,0],["وبارقة تخايل في عذارى","على الأبصار من وجهي سناها",56,"ا",3,0],["وبارقة من الإقبا","ل تلفح عارضاً سِجما",57,"م",2,0],["وباراكَ المُلوكُ فكنت منهم","مكان الشامخاتِ من الوهادِ",58,"د",1,0],["وبارى الشمس في نَفْعٍ ونورٍ","فحاز الفخر رأدَ ضُحىً وظُهرا",59,"ر",2,0],["وباريْتُ أخلاقَ النساءِ بلوْعَةٍ","يعود لها الصَّفْوان وهو ثرىً سهل",60,"ل",1,0],["وبارقة في السحي من دون شمسه","كمنديل ساقٍ معلمٍ فوق جامهِ",61,"م",2,0],["وبارقٍ ما روتْ ليلاً شرارتُه","اِلاّ وقابلَ مِن وجدي بكم شررا",62,"ر",2,0],["وباري الخلق رزاق","رعاك الله قساما",63,"م",2,0],["وبارقٍ لألأَ من سَمائِهِمْ","فَفَجَّ في الأكوانِ ذاكَ البارِقُ",64,"ق",1,0],["وبارك كما تختار أنت وترتضى","مباركة في الهطل تحكي الغواديا",65,"ي",2,0],["وبأرض وسماء","ورياض وظلال",66,"ل",1,0],["وبارع يدري جهولاً ولم","يدر جهول قطُّ بالبارع",67,"ع",1,0],["وبأرض الحِجْر لم تحجر على","أمرها فينا فكنا قوم هود",68,"د",1,0],["وبآرائِه احْتَمَى فهْو إِمَّا","سُورٌ عَوَّذَتْه أَوْ أَسْوارُه",69,"ر",2,0],["وَبار بَني العَبّاسِ فيها أُمَيَّةً","وَجَروا عَلى بَغدادَ ذَيلَ التَبَخُّرِ",70,"ر",1,0],["وبارك اللَّهُ على دُعَّانِه","أطعَمَنَا عَونٌ على خِوَانِه",71,"ن",2,0],["وَبِأرض مكّة قد وُلِدتَ مُطهّرا","إذ إنّ أمّك قد زَكَت وأباكا",72,"ك",2,0],["وَبِأرواحهم إذا ما اِفتدَوها","كَي يُعيدوا كيانها المُتقادِم",73,"م",1,0],["وَبارزني مِن غَدره وَهوَ جاهلٌ","لَقدري بِماش مِن ذَويه وراكب",74,"ب",1,0],["وَبأرجائِها كُماة الجُنودِ","أَصبَحَت بِالصُفوف تَحتَ البُنودِ",75,"د",1,0],["وبأرض بغدادٍ على موسى، وفي","طوسٍ على ذاك الرَّضي المتفرِّد",76,"د",1,0],["وَبارِد طَبعٍ قَد تَقلَّد صارِماً","وَأَظهَرَ بَينَ النّاسِ إِفراطَ ضيرهِ",77,"ه",1,1],["وبارزَ الذلُّ شجعانَ الحياةِ بأفرا","س النحوسِ وأسيافِ القضا ففَتك",78,"ك",1,0],["وَبارقة ٍلمْ يكنْ خُلَّبَا ً","ضِيَاءُ مَطالِعِهَا السُطّعِ",79,"ع",1,0],["وبارك الله في مَبداهُ يوم بدا","وبارك الله في مسعاه يوم سعى",80,"ع",2,0],["وباركَ الرحمنِ يا ليث في","أشبالكَ الصيد حمى المذهبِ",81,"ب",1,0],["وبارك على آل النبي وصحبه","متى ما انثنى غصن وما كثيب",82,"ب",1,0],["وبارك عليه وأته منك نعمة","تعم البرايا بين شيخ ويافع",83,"ع",1,0],["وبا