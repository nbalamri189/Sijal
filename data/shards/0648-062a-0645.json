bi.ae/diwan/poem/42562","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42722","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54587","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54908","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54917","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54517","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54870","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141998","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141930","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/204512",""],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54293","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[106,"معترك السباب!","https://www.poetsgate.com/ViewPoem.aspx?id=179427",""],[106,"سلاح غاندي","https://www.poetsgate.com/ViewPoem.aspx?id=179409",""],[106,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[106,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[56,"أنظر إلى شمس القصور وبدرها","https://www.poetsgate.com/ViewPoem.aspx?id=11349",""],[100,"صدى","https://www.poetsgate.com/ViewPoem.aspx?id=50403",""],[100,"حيث التقينا","https://www.poetsgate.com/ViewPoem.aspx?id=50147",""],[84,"أما الرياح بجو عاصم","https://www.poetsgate.com/ViewPoem.aspx?id=26356",""],[18,"أَهَاجَ قَذَاءَ عَيْنِي الإِذِّكَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=22981",""],[43,"فؤاد ما تسليه المدام","https://www.poetsgate.com/ViewPoem.aspx?id=390",""],[90,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=179230",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"يوم فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=179165",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[45,"جُمِعَتْ أُمُورُ الدّينِ بَعدَ تَزَيُّلِ","https://www.poetsgate.com/ViewPoem.aspx?id=31869",""],[80,"كَمُلَتْ ليَ الخمسونَ والخمسُ","https://www.poetsgate.com/ViewPoem.aspx?id=3324",""],[80,"وساحبة ٍ ليلاً من الشّعَرِ الجَثْلِ","https://www.poetsgate.com/ViewPoem.aspx?id=3497",""],[94,"وذرني أحيّي الصباحا","https://www.poetsgate.com/ViewPoem.aspx?id=15649",""],[99,"اكتبي لي","https://www.poetsgate.com/ViewPoem.aspx?id=36388",""],[99,"يُحبني كثيراً","https://www.poetsgate.com/ViewPoem.aspx?id=14386",""],[86,"أثرتَ بنا مِنَ الشَّوقِ القديمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13053&r=&rc=9",""],[88,"اذا شئت ان تسرى بكافرة الصوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19534&r=&rc=37",""]],"verses":[["وَتَمَطَّتِ العُشَراءُ نا","هِضَةً وَقَد عُلِمَ الجَنينُ",0,"ن",1,0],["وَتَمَلَّكَتكَ خَديعَةٌ مِن قَولَةٍ","غَرّارَةِ الأَقسامِ وَالأَيمانِ",1,"ن",1,0],["وَتَمَلَّ أَيّامَ البَقاءِ وَلا تَزَل","تَطغى بِشُكرِكَ أَلسُنُ الأَقوامِ",2,"م",1,0],["وَتَمَّ عَلاؤُكُم بي بَعدَ نَقصٍ","تَمامَ الحَضرَميَّةِ بِالقِبالِ",3,"ل",1,0],["وَتَماسَكَت تِلكَ العَمائِمُ بَعدَما","أَرخى جَوانِبَها كَرىً وَخُفوقُ",4,"ق",1,0],["وَتَماسَكَت تِلكَ البَنانُ فَطالَما","عَبِثَ البِلى بِأَنامِلِ الأَجوادِ",5,"د",1,0],["وَتُمكِنُنا مِن مائِها كُلُّ مُزنَةٍ","وَتَمنَعُنا فَضلَ السَحابِ المَزاوِدُ",6,"د",1,0],["وَتَمادى بِما جَناهُ عَلى الأَي","يامِ حَتّى جَنى عَلَيهِ التَمادي",7,"د",2,0],["وَتُمَدَّ أَطنابُ البُيو","تِ وَتُضمِرَ القَومَ القِبابُ",8,"ب",1,0],["وَتَمَطَّتِ الزَفراتُ حَتّى قَوَّمَت","ضِلعاً عَلى أَضغانِها عَوجاءَ",9,"ا",2,0],["وَتَمتاحُ ماءَ العَينِ مِنيَ لَوعَةٌ","مِنَ الوَجدِ تَستَقري الجَوانِحَ نارُها",10,"ر",3,0],["وتَمْشي الهُوَيْنى بَيْنَ جَنْبَيَّ هِمّةٌ","تَذُمُّ زَماناً ضاقَ فيهِ مَجالي",11,"ي",1,0],["وتملأُ بالخَيْلِ عُرْضَ الفضا","ءِ حتى يئنَّ لها السّبْسَبُ",12,"ب",1,0],["وَتَموجُ مَوجَ البَحرِ إِلّا أَنَّه","لاقَت أُسوداً فَوقَهُنَّ حَديدُ",13,"د",1,0],["وَتَمَنَّت لِقايَ فَوزٌ وَدوني","فَلَواتٌ تَحارُ فيها الجَوازي",14,"ي",1,0],["وَتَمايُلي طَرَباً لِحَلِّ عَويصَةٍ","في الدَرسِ أَشهى مِن مُدامَةِ ساقِ",15,"ق",1,0],["وتَمْضي كَما يمْضي القَضاءُ بقُدْرَةٍ","منَ اللهِ لا يُلْفَى لَها الدّهْرَ دافِعُ",16,"ع",1,0],["وتمتّعْ منْهُ بهالَةِ مُلْكٍ","أطْلَعَتْ منْكَ أيَّ بَدْرٍ لَيَاحِ",17,"ح",1,0],["وَتُمَهِّدُ الْمُلْكَ الَّذِي بِكَ جَاوَزَتْ","أَسْيَافُ عَزْمَتِهِ تُخُومَ الزَّابِ",18,"ب",1,0],["وَتَمْضِي اللَّيَالِي وَالتَّزَاوُرُ مُعْوِزٌ","عَلَى الرَّغمِ مِنَّا إِنَّ ذَا لَغَرِيبُ",19,"ب",1,0],["وَتَماثَلتُ لِلشِفاءِ وَقَد دا","نَيتُ حَيني وَهَيَّأَ القَومُ لَحدي",20,"ي",1,0],["وَتَمشي السافِياتُ بِها حَيارى","إِذا نُقِلَ الهَجيرُ عَنِ الجَحيمِ",21,"م",1,0],["وَتَمَنَّوا أَن يَخونَ ال","عَهدَ مَولىً لا يَخونُ",22,"ن",1,0],["وَتَمَثَّلِ القَصرَ المُبارَكَ وَجنَةً","قَد وَسَّطَت فيها الثُرَيّا خالا",23,"ل",2,0],["وَتَمشي الهُوَينا إِذا أَقبَلَت","كَما بَهَرَ الجَزعَ سَيلاً ثَقيلا",24,"ل",2,0],["وَتَمنَحُ خَيلَكَ أَرضَ العِدى","وَتَنبُذُ بِالغَزوِ أَطفالَها",25,"ل",3,0],["وَتَمَامُ فَضْلِ اللهِ فِي","حَسَبٍ يُزَكِّيهِ النَّسَبْ",26,"ب",1,0],["وتمام السعد فيها إن ما","أوجب الفضل وشاء العدل كانا",27,"ن",2,0],["وَتَمَايَلَتْ فِي ثَوْبِ خَزٍّ مُورِقٍ","غُصْناً وَهَلِ لِلْغُصْنِ نَضْرَة جِسْمِهَا",28,"م",3,0],["وَتَمَادَتِ الأفْرَاحُ مِنْ مِصْرَ إلى","أعْلَى الصَّعِيد إلى ذُرَى أسْوَانِ",29,"ن",1,0],["وَتَمْحَضُ البَلَدَ الحُبَّ الخَلِيقَ بِهِ","وَتَحْفَظُ اليَدَ فِي سِرٍّ وَإِعْلانِ",30,"ن",1,0],["وَتَمُرُّ فِي جِدِّ الحَوَا","دِثِ وَهْيَ أَمْرَحُ مَا تَكُونُ",31,"ن",1,0],["وَتَمَلَّ عُمْراً لا يُكَدِّرُ صَفْوَهُ","بَعْدَ الصِّدَامِ العَالَمِيِّ صِدَامُ",32,"م",1,0],["وَتُمَارِسُ الآفَاتِ لاِسْتِبْطَانِهَا","وَتُحَقِّقُ النَّظَرَاتِ بِالإِنْعَامِ",33,"م",1,0],["وَتَمَلَّيَا هَذِي الحَيَاةَ","مَسِرَّةً وَنَعِمَ بَالِ",34,"ل",1,0],["وتمل كفّ من القبل","وقد سجادت ل من قبل",35,"ل",1,0],["وتُميل من أصغى لها فكأنّني","عاطيته منها كؤوس عُقار",36,"ر",1,0],["وتمنع ميسور الكلام أخا الهدى","وتبخل حتى بالخيال يزورُ",37,"ر",1,0],["وتمرّ لاغبة وفوق جبينها","عرق ووجنة خدّها حمراء",38,"ا",2,0],["وتمر واثبةً على وجه الثرى","مراً كما تتواثب الآرام",39,"م",1,0],["وتمتدّ بين النيل منها ودجلة","مدى الدهر أسباب التعارف والودّ",40,"د",1,0],["وتمتلئ العيون به ابتهاجاً","إذا نظرت وتنشرح القلوب",41,"ب",1,0],["وتمشي فما تدري إلى قعر هّوة","تروح بها أم للمدى المباعد",42,"د",1,0],["وتمضي مضيّ السهم فيه كأنما","ترى افعواناً هائجاً دخل الثقبا",43,"ب",2,0],["وتَمْزَع في الفلاة لغير وجهٍ","وآونةً لمَصْرَعه تؤوب",44,"ب",1,0],["وتمزح طوراً ثم تنصاع ذاهباً","إلى الجدّ تغري بالحقيقة من تغري",45,"ر",2,0],["وَتُمطِرُ مِن نَداكَ يَداكَ فَضلاً","إِلى كَرَمِ الشَمائِلِ وَالنِجارِ",46,"ر",1,0],["وَتَمدَحُ سَعداً لا عَلَيتَ وَمِنقَراً","لَدى حَومَلِ السيدانِ يَحبو عَقيرُها",47,"ر",3,0],["وَتَمضي كُلُّ مَظلِمَةٍ عَلَيكُم","وَما تَثنَونَ عادِيَةَ الظَلومِ",48,"م",1,0],["وَتَمنَعُني مُراقَبَةُ الأَعادي","غُدوّي لِلزِيارَةِ أَو رَواحي",49,"ي",1,0],["وتملكته سماحةٌ وحماسةٌ","جعلا له في كلِّ نادٍ ذاكرا",50,"ر",2,0],["وتمكث بالحجاز سيولُ رفدٍ","فما تهفو إلى نوءٍ مطير",51,"ر",1,0],["وتمنع رمحاً بينها من قوامه","ولكنَّه لا جرحَ فيها ولا طعنا",52,"ن",2,0],["وتمنيت أن تكون على الحي","رةِ تحت العَماية الطَّخْياءِ",53,"ا",2,0],["وتَمِّم يداً أَسْديْتَها يَنْمَ شكرُها","غداة غدٍ في الناس أيَّ نَماءِ",54,"ا",2,0],["وتَمتَّع به ففيه مَتاعٌ","وادّخارٌ لساعةٍ سَوْعاءِ",55,"ا",2,0],["وتمثّل بهداه إنه","خير أمثالك تلك السائره",56,"ر",2,0],["وتمام ما أسديتَ إذنُك لي","أو لا فعُرْفُكَ كلّه نُكْرُ",57,"ر",1,0],["وتمايلتْ فضحكتُ من أردافها","عجباً ولكني بكيتُ لخصرها",58,"ه",2,0],["وتَمدُّ في أمل ابن نشوتها","حتى يؤمل مرجعَ الأمس",59,"س",1,0],["وتماتن الجزع الأبيُّ مهزُّه","فأتت عليه ولم تُرَع بحفيفه",60,"ف",2,0],["وتمامُ اليد استماعُكَ فضلاً","من كلامي لا يُعجبُ العُذَّالا",61,"ل",2,0],["وتمتعتْ نفسي بروحِ رجائه","زمناً طويلاً والتمتعُ مالُ",62,"ل",1,0],["وتماسكت أوصال كفّ لم تزلْ","بنوالها تتماسك الأوصالُ",62,"ل",1,0],["وَتُمزَجُ بِالعَذبِ عَذبِ الفُرا","تِ زَعزَعَه الريحُ بَعدَ المَطَر",63,"ر",1,0],["وَتَمايَلَت فَالسَمهَرِيُّ مُصَمِّمٌ","وَرَنَت فَأَبصَرتُ السِهامَ تُصَوَّبُ",64,"ب",1,0],["وَتَمَشَّت فيها المَلالَةُ حَتّى","ضَجِرَت مِن طَعامِهِم وَالشَرابِ",65,"ب",1,0],["وَتَموتُ ذي لِلعُقمِ قَبلَ مَماتِها","وَتَعيشُ تِلكَ الدَهرَ في ساعاتِ",66,"ت",1,0],["وَتَمُدُّ صَوتَكَ في الفَضا مُتَلَهِّفاً","في ذَلَّةِ المُستَرحِمِ المُستَنجِدِ",67,"د",1,0],["وَتَموجُ ديدانُ الثَرى في أَكبُدٍ","كانَت تَموجُ بِها المُنى وَتَمورُ",68,"ر",1,0],["وَتَميدُ حَتّى لا يُشَكُّ بِأَنَّها","سَكرى وَلَم تَذُقِ السَفينُ عَقارا",69,"ر",2,0],["وَتَمادى القَومُ في غَفلَتِهِم","فَتَمادى في المَلاهي المُنكَرَه",70,"ر",2,0],["وَتَمشي في عُبابِ الما","ءِ الصَلِّ في الرَملِ",71,"ل",1,0],["وَتَمَشّى في الأَرضِ داراً فَداراً","فَسَمِعتِ دَوِيَّهُ وَرَنينَه",72,"ن",2,0],["وَتَمَتَّعي بِالشُهبِ في الأَفلاكِ ما دامَت تَلوح","مِن قَبلُ أَن يَأتي زَمانٌ كَالضَبابِ أَوِ الدُخان",73,"ن",1,0],["وَتُملَأُ أَحشاءَ البِلادِ مَخافَةً","وَتَرتَجُّ بَغدادٌ لَهُ وَخُراسانُ",74,"ن",1,0],["وَتَمَلَّكَتني مِن هَواهُ هِزَّةٌ","كادَت تُذيعُ عَنِ الغَرامِ المُضمَرا",75,"ر",2,0],["وَتَمَلَّيتَ مِنَ الصَحَّ","ةِ بِالثَوبِ الجَديدِ",76,"د",1,0],["وتَمْرَحُ بَيْنَ وُرودِ الصَّباحِ","وتنعَمُ بالنُّورِ أَنَّى تَرَاهْ",77,"ا",2,0],["وتَمْشي كما شِئْتَ بَيْنَ المروجِ","وتَقْطُفُ وَرْدَ الرُّبى في رُبَاهْ",77,"ا",2,0],["وتمرُّ الأَيَّامُ والحُزْنُ والمو","تُ بعيداً عن ظلِّهِ المأمونِ",78,"ن",1,0],["وتَمَلَّ الجمالَ في رِممِ الموتَى","بعيداً عَنْ سِحْرِها وصَداها",79,"ه",2,0],["وتملأُني نشوةٌ لا تُحَدُّ","كأَنِّيَ أَصبحتُ فوقَ البَشَرْ",80,"ر",1,0],["وتمرُّ بَيْنَ فجاجها اللَّذَّاتُ","حالمةً تميدْ",81,"د",1,0],["وتمرُّ أَيَّامَ الحَيَاةِ بنا","كأَسْرابِ الطُّيورْ",82,"ر",1,0],["وتمايلتُ في الظَّلامِ وعَطّرتُ","فَضاءَ الأسى بأنفاسِ وَردي",83,"د",2,0],["وتموت خامِلَةً كزهرٍ بائسٍ","ينمو ويذبُل في ظلامِ الغابِ",84,"ب",1,0],["وتمرد على تقا","ليد تفضى إلى الضرر",85,"ر",1,0],["وتملصوا من نير كل خرافة","خرقاء تلقي الرين في الافكار",86,"ر",1,0],["وتمسح عينيه اللتين أذالتا","دموعاً على الخدين منه تسلسل",87,"ل",1,0],["وتمسك بالأيدي بفضل ردائه","وما أن تخلِّى بعد للحرب يرحل",87,"ل",1,0],["وتمهَّل إنما تمشى على","حَرَم الدهر ونادى الأولين",88,"ن",1,0],["وتمشى مجمَّلة بالحلىّ","وقد تتجلى ذوات الخفر",89,"ر",1,0],["وتمحو آية العهد السفيه","وتجمع كلمة المتفرّقينا",90,"ن",2,0],["وَتَمايَلَت عيدانُهُنَّ تَحِيَّةً","وَتَرَنَّمَت أَوتارُهُنَّ ثَناءَ",91,"ا",2,0],["وَتَمامُ فَضلِكَ أَن يَعيبَكَ حُسَّدٌ","يَجِدونَ نَقصاً عِندَ كُلِّ تَمامِ",92,"م",1,0],["وَتَمَشَّينا يَدي في يَدِهِ","مَن رَآنا قالَ عَنّا أَخَوَين",93,"ن",1,0],["وَتَمُدُّ حِلمَكَ لِلسَفيهِ مُدارِياً","حَتّى يَضيقَ بِعَرضِكَ السُفَهاءُ",94,"ا",2,0],["وَتَمَنَّت حِياضُهُ","هَبَّةَ الصارِمِ الذَكَر",95,"ر",1,0],["وَتَملَأُكَ السُنونَ قِوىً وَعَزماً","إِذا قيلَ السِنونُ مُثَبِّطاتُ",96,"ت",1,0],["وَتَمَنَّت كُلُّ مُقَطَّعَةٍ","يَدَها لَو تُبعَثُ تَشهَدُهُ",97,"د",2,0],["وَتَمَنَّت لَو حَوَت أَعظُمَهُ","بَينَ أَبناءِ الشُموسِ العُظَماء",98,"ا",2,0],["وَتَمَهَّل إِنَّما تَمشي إِلى","حَرَمِ الدَهرِ وَمِحرابِ القُرون",99,"ن",1,0],["وَتَماثيلُ كَالحَقائِقِ تَزدا","دُ وُضوحاً عَلى المَدى وَإِبّانَه",100,"ن",2,0],["وَتَمشي تُعَلِّمُ في أُمَّةٍ","كَثيرَةِ مَن لا يَخُطُّ الأَلِف",101,"ف",1,0],["وَتَملِكُ أَطرافَ الشِعابِ وَتَلتَقي","وَتَأخُذُ عَفواً كُلَّ عالٍ وَتَغصِبُ",102,"ب",1,0],["وَتَمَّ لَنا النَصرُ المُبينُ عَلى العِدا","وَفَتحُ المَعالي وَالنَهارُ المُذَهَّبُ",102,"ب",1,0],["وَتَمضي السَرايا واطِئاتٍ بِخَيلِها","أَرامِلَ تَبكي أَو ثَواكِلَ تَندُبُ",102,"ب",1,0],["وَتَملِكُ أَنفُسَ الثَقَلَينِ طُرّاً","فَكَيفَ تَحوزُ أَنفُسَها كِلابُ",103,"ب",1,0],["وَتَمَنَّيتُ مِثلَهُ فَكَأَنّي","طالِبٌ لِاِبنِ صالِحٍ مَن يُوازي",104,"ي",1,0],["وَتَملِكُهُ المَسائِلُ في نَداهُ","وَأَمّا في الجِدالِ فَلا يُرامُ",105,"م",1,0],["وتمشّت من الفؤاد بنعلٍ","حُرُّ وجهي له مكانَ التراب",106,"ب",1,0],["وتم المزاج به والزواج","وأنشأ من بعد خلقاً جديدا",107,"د",2,0],["وتم لها طبائع مفرادات","خفيات لأظهرها بطونُ",108,"ن",1,0],["وتمعَّجَتْ فوقَ الخمائلِ طلقةً","تُجلَى عليها للرياضِ وشائعُ",109,"ع",1,0],["وتمسكوا بولاءِ شمعونَ الصَّفَا","فصفتْ قلوبُهم مِنَ الأحقادِ",110,"د",1,0],["وَتَمَنٍّ لِأَن أَراكَ وَأَن يَه","لِكَ إِذ ذاكَ مِن بِلادي الرَغيبُ",111,"ب",1,0],["وَتَماحَكوا في البُخلِ حَتّى خِلتُهُ","ديناً يُدانُ بِهِ الإِلَهُ وَيُعبَدُ",112,"د",1,0],["وَتَميلُ مِن لينِ الصِبا فَيُقيمُها","قَدٌّ يُؤَنَّثُ تارَةً وَيُذَكَّرُ",113,"ر",1,0],["وَتَماسَكتُ حينَ زَعزَعَني الدَه","رُ إِلتِماساً مِنهُ لِتَعسي وَنَكسي",114,"س",2,0],["وَتَمَنَّعَت في ظِلِّ عِزِّكَ فَاغتَدَت","في خَيرِ مَنزِلَةٍ وَأَحصَنِ مَعقِلِ",115,"ل",1,0],["وَتَمَّت عِندَهُ النَعما","ءُ فَهوَ المُنعِمُ المُفضِل",116,"ل",1,0],["وَتَمَنَّتِ الأَحياءُ أَنَّهُمُ","تَحتَ التُرابِ وَجيءَ بِالحَشرِ",117,"ر",1,0],["وَتَمنَعُ عَيني وَهيَ يَقظى شِفاءَها","وَيُبذَلُ لي عِندَ المَنامِ حَرامُها",118,"م",3,0],["وتَمَلَّ مدحي إنه رَيحانَةٌ","نَفَحَتْ فباشَرَها اللَّبيبُ طَليقا",119,"ق",2,0],["وتَمَلَّها غَرَّاءَ لستَ بمُلْبِسٍ","أفوافَها إلاّ أغرَّ شَريفا",120,"ف",2,0],["وتَمَلَّها بِكْراً فلستُ مُزوِّجاً","شَرَفَ الشريفِ من المدائحِ ثَيِّبا",121,"ب",2,0],["وتَمَلَّ سائرةً عليك مقيمةً","مَلكتْ وَدادَ أباعدٍ وأقاربِ",122,"ب",1,0],["وتمٌّ وغرنوقٌ ونسرٌ ومرزمٌ","وشبطر شرطٍ والأنيسة أبلغ",123,"غ",1,0],["وَتَمامُ السُرورِ عِندِيَ إِن أَم","كَن مِن وَجهِكَ الجَميلِ الحُضورُ",124,"ر",1,0],["وَتُميتُني الأَلحاظُ مِنكَ بِنَظرَةٍ","وَإِذا أَرَدتَ بِنَظرَةٍ تُحيِيني",125,"ن",2,0],["وَتُمسي اللاذِخِيَّةُ في رُقادٍ","تَوَهَّمُ فِعلَها طَيفَ الخَيالِ",126,"ل",1,0],["وَتَمَلُّقاً سَكبُ الدُموعِ عَلى الثَرى","إِن لَم يُمازِجها الدَمُ المَسكوبُ",127,"ب",1,0],["وَتَمَنَّيتُ لَو كَتَبتُ كِتابي","أَنَّ إِنسانَها مَكانَ المِدادِ",128,"د",1,0],["وتمتدُّ مثل امتداد العباب","وترجع كالموجة الساخره",129,"ر",2,0],["وتمرّ فارغة وحاشدة","وقد استوت ضيقاً ومتّسعا",130,"ع",2,0],["وتماسكت فلم يبق سوى","كبرياء هي درع للأبي",131,"ب",2,0],["وتمر في الذكرى خيال شبابها","فكأن يقظتها شباب ثانِ",132,"ن",1,0],["وتمشي بذي الإكبار جَبْهةُ ساجدٍ","إليه وفوقَ الترب أو فم لاثمِ",133,"م",1,0],["وتمهل بالرّاحاتِ مَن لم يَمُتْ بها","إلى حين خاضت في حشاه كروبها",134,"ب",3,0],["وَتَمَرَّهَت وَتَشَعَّثَت","جَزَعاً لِغَيبَتِهِ العِراقُ",135,"ق",1,0],["وَتَمَكَّنَ اِبنُ أَبي سَعيدٍ مِن حِجا","مَلِكٍ بِشُكرِ بَني المُلوكِ سَعيدِ",136,"د",1,0],["وتميزوا فهناك وجهٌ سافرٌ","منهمْ ، وآخرُ بالخنا محجوب",137,"ب",1,0],["وَتَمَكَّنَت في النَفسِ حَيثُ تَمَكَّنَت","نَفسُ المُحِبِّ مِنَ الحَبيبِ المُغرَمِ",138,"م",1,0],["وَتَمشى عَلى بَرديَّتينِ غَذاهُما","يَهاميمُ أَنهارٍ بِأَبطَحَ مُسهَلِ",139,"ل",1,0],["وَتَمشي في تَأَوُّدِها","هُوَينا المَشيِ في بَدَدِ",140,"د",1,0],["وَتَميسُ في أَثوابِهِ رَيحانَةٌ","كَرَعَت عَلى ظَمَإٍ بِجَدوَلِ ماءِ",141,"ا",2,0],["وَتَمضي بِهِ في الوَغى نَجدَةٌ","مَضى السَيفُ في كَفِّهِ أَو نَبا",142,"ب",2,0],["وَتَمَلَّكَتهُ هِزَّةٌ في عِزَّةٍ","فَاِرتَجَّ في وَرَقِ الشَبابِ الأَخضَرِ",143,"ر",1,0],["وَتَملَأُ عَينَ الشَمسِ لَألاءَ بَهجَةٍ","وَحُسنٍ وَأَنفَ الريحِ طيبَ تَنَفُّسِ",144,"س",1,0],["وَتَمَلَّكَتني لَوعَةٌ مَشبوبَةٌ","شَوقاً إِلَيكَ وَعَبرَةٌ تَتَرَقرَقُ",145,"ق",1,0],["وتمارَوا في النطاسيِّ الذي","يُصلِحُ الأمرَ إذا الأمرُ فَسَدْ",146,"د",1,0],["وتمر عينك بي وتهرع مثلما","عبر الغريب مروعاً يتوثب",147,"ب",1,0],["وَتُمطِرُنا لَياليها بَعوضاً","يَذُبُّ النَومَ عَنّا وَالسُباتا",148,"ت",2,0],["وتمادَيْتُ أَقْتَفي أَثَرَ القَوْ","مِ فطالَتْ مَسَافَةٌ واقْتِفَاءُ",149,"ا",2,0],["وتَمَخَّضَتْ ظُلَمَ اللَّيَالِي منهمُ","عَنْ رُكَّعٍ لا يَسْأَمُونَ وسُجَّدِ",150,"د",1,0],["وتُمْلِي عَلَى أَعدائِهِ ما يَسُوؤُهُم","وتُوحِي إلَى أَسماعِهِ ما يُحَبَّرُ",151,"ر",1,0],["وَتَمامُ السُرورِ فيها بِساقٍ","حَسَنِ الوَجهِ مُستَنيرِ الجَمالِ",152,"ل",1,0],["وَتُمَتِّعَ اللَهَواتِ مِنكَ بِطيبِها","وَالمِنخَرَينِ بِكَثرَةِ الشَمِّ",153,"م",1,0],["وَتَمَصُّصي ثَمَرَ الصَبابَةِ وَالصِبى","حَتّى فَنيتَ وَلِلفَناءِ مَصيرُ",154,"ر",1,0],["وَتُمسي وَالمَساءُ عَلَيكَ مُرٌّ","يُقَلِّبُكَ الهَوى جَنباً فَجَنبا",155,"ب",2,0],["وَتَمضي بِنا الساعاتُ مُضمِرَةً لَنا","قَبيحاً عَلى أَنَّ الوُجوهَ وَسائِمُ",156,"م",1,0],["وتمَتّعْ بنَضْرَةِ العَيْشِ إذْ جَا","ءتْكَ في رَونْقِ الزّمانِ النّضيرِ",157,"ر",1,0],["وَتملأ البر دبا","باتٌ تُقِلُّ الحماما",158,"م",2,0],["وَتَمشي بأقدام ضعفن عَن الخطى","إلى زوجها مشيَ المقيَّدِ في الوحل",159,"ل",1,0],["وَتَمشي عَلى الأموات في كل خطوة","وَتأَكل أَمواتاً وَتَلبس أَمواتا",160,"ت",2,0],["وَتمد ثانية أَشع","عتها إلى الأطراف مدا",161,"د",2,0],["وتَمحق الحزن وتَأسُو الكلوم","فما الذي أجرَى دموع النجوم",162,"م",1,0],["وَتَمَتَّع فَإِنَّ خَوفَكَ مِنها","سوءُ ظَنٍّ بِالواحِدِ المَنّانِ",163,"ن",1,0],["وتمنّى الذي كتبتَ عن البؤ","س وردّ الأصيلَ دون المعرّبْ",164,"ب",1,0],["وتمنَّيتَ وما أحلى المنى","خطواتٍ منه والمثوى قريبْ",165,"ب",1,0],["وتمشي الحياةُ على نورِهِ","وما نورُهُ غيرُ عينِ امرأه",166,"ه",1,0],["وتمشي لحاضرها في الحياة","بمصباحِ ماضٍ خَفيِّ الشعاعْ",166,"ع",1,0],["وتمسُّ القممَ الشمَّ يدي","فيُرى منحدِراً لي مُرتقاها",167,"ا",3,0],["وتمنَّت فيه لو تسبحُ ربَّاتُ الجمالِ","موجهُ الشّادي عشيقُ النُّورِ معبودُ الظلالِ",168,"ل",1,0],["وتمزَّق الشهباء والخضراء","أما الملائكة الكرام فقبس",169,"س",1,0],["وتَمايلَتْ أَيْدِي الثُّرَيْ","يَا وهي مُذْهَبةُ الخَواتِمْ",170,"م",1,0],["وَتَمنَعُهُنَّ أَن يَأكُلنَ مِنهُ","حَياةُ يَدٍ وَرِجلٍ تَركُضانِ",171,"ن",1,0],["وَتَموجُ مَوجَ البَحرِ إِلّا أَنَّها","لاقَت أُسوداً فَوقَهُنَّ حَديدُ",172,"د",1,0],["وتَمكُثُ بِينَ اللَّحظِ وَاللَّفظِ فِتنَةٌ","تحلّ عقالاً للتصابي عنِ العَقْلِ",173,"ل",1,0],["وَتَمَتَّعَتْ بِالْعَدْلِ مِنْكَ رَعِيَّةٌ","كَانَتْ فَرِيسَةَ كُلِّ بَاغٍ مُعْتَدِ",174,"د",1,0],["وَتَمَنَّى نَظْرَةً يَشْفِي بِهَا","عِلَّةَ الشَّوْقِ فَكَانَتْ مَهْلَكَا",175,"ك",2,0],["وَتَمْثُلُ أَجْيَالُ الوَرَى فِيهِ بَادِياً","خَفِيَّ طَوَايَاهَا لَدَى مَنْ يُرَاقِبُ",176,"ب",1,0],["وَتَمَتَّع بالقُرْبِ مِنْ عرْشِ رَبٍ","كُنْتَ فِي الأَرْضِ عَبْدَهُ المُخْتَارَا",177,"ر",2,0],["وَتَمُرّ الأَيامُ بِي بَيْنَ تَجْديدِ","لِقَاءٍ وَبَيْنَ تَجْديد هَجْرِ",178,"ر",1,0],["وَتَمَاثِيلُ مَنْ رَآهَا رَأَى أَخ","فَى دَبِيبِ الأَرْوَاحِ فِي الاجْسَادِ",179,"د",1,0],["وَتَمَلَّتْ غِبْطَةً ضَاعَفَهَا","بَاعِثُ العُجْبِ وَدَاعِي الخُيَلاَءْ",180,"ا",2,0],["وَتَمَاسَكتْ فِي الْبَأْسِ أَرْمَاقٌ بِهِ","وَنَجَتْ مِنَ الْبُؤْسِ المُبِيدِ دِيَارُ",181,"ر",1,0],["وتملّ الأحلام في الكاس غرقى","عاريات وبعضها عشاقا",182,"ق",2,0],["وَتَمْتَمَتْ نَجْمَةٌ في أذْنِ جارَتِها","لمَّا رَأَتْها وَجُنَّتْ عِنْدَ مَرآها",183,"ا",3,0],["وتمزّقت أملاكُها","تاجاً وفضّت صولجانْ",184,"ن",1,0],["وتمسَحُ دمعاً كي تجودَ بِمثْلِهِ","وتَنْسَى أَريباً بادِّكارِ أَريب",185,"ب",1,0],["وتمنّيتُ كلَّ شيءٍ على الل","هِ سوى أن أعيشَ من أوزاني",186,"ي",1,0],["وتمنَّى الأصيلُ لو نال يوماً","لمحةَ الحسن من سنا لمعانه",187,"ن",2,0],["وَتَمنَّى اخْضِرَارُ كُلِّ نَبَاتٍ","لَوْ غَدَا في سَمَاءِ مِصْرَ بُنُودا",188,"د",2,0],["وتمثّلتْ فيكِ الحياةُ فَتِيّةً","من بعدِ ما عبثَتْ بكِ الأيام",189,"م",1,0],["وتمخضتْ عزَماتهُمْ","عن قصة الملح المذاب؟",190,"ب",1,0],["وتمثالٍ أقيم لنا","من الإخلاص والزهد",191,"د",1,0],["وتمضى به عزمةٌ من حديدٍ","تُفسِّرُ للسهم معنى المضاء",192,"ا",2,0],["وتملأ الجوَّ أسرابًا محلَّقةً","تبثُّ في الأرض تدميرًا وعُمرانا",193,"ن",2,0],["وتمايلت فضحكن من أردافها","عجباً ولكني بكيت لخصرها",194,"ر",3,0],["وتمد اذرعها اليه ، وتنحني","تصغي ، وتجمع ظلّها ، أشلاء",195,"ا",2,0],["وتميس ، من خلف الثقوب ، كناهد","خجلى ، تريد وتحذر الإفشاء",195,"ا",2,0],["وتمنّينا الأغاني واللّقا","في شفاه الكأس لحن ومدام",196,"م",1,0],["وتمايلت أيدي الثريا","وهي مذهبة الخواتم",197,"م",1,0],["وَ تمنعُ أنْ يمسهمُ لسانٌ","مخافة َ منْ يجيرُ وَ لاَ يجارُ",198,"ر",1,0],["وَتَملِكُهُ المَسائِلُ في العطايا","وَأَمّا في الجِدالِ فَلا يُرامُ",199,"م",1,0],["وتمزّقي قِطَعاً مضرّجةً","تمتصُّ من نَضَحاتِه عَلَقا",200,"ق",2,0],["وتمسكَّ المتثبِّتون بجاحمٍ","جَمَراتُه تُشوى بها الأقدام",201,"م",1,0],["وتمشي الجموعُ على ضوئهِ","لتبكي على عبقريٍّ قضى",202,"ا",1,0],["وتمر الأمُّ غضبى ساءها","في سباق مِثلِهِ أن تُسبَقا",203,"ق",2,0],["وتماسَكْنَ – والطبيعةُ شِعرٌ -","كقوافٍ يَلْمَعْنَ غيرَ نوابي",204,"ب",2,0],["وتمنّى على الطبيعة شَكلا","هو من خير ما يكونُ فكانه",205,"ن",2,0],["وَتَمَنّعَتْ في ظِلّ عِزّكَ، فاغتَدتْ","في خَيرِ مَنْزِلَةٍ، وأحسَنِ مَعقِلِ",206,"ل",1,0],["وتموتُ فيها الجنّ والإنْس","لحظَ الهصورَ جآذَرٌ خُنْسُ",207,"س",1,0],["وتمكثُ بين اللحظ واللفظ فتنة","ٌ تحلّ عُقالاً لتصابي عن العَقْل",208,"ل",1,0],["وتمّهّل حتّى أودّ نور الشمس","إذ همّ أن يلوح فلاحا",209,"ح",2,0],["وتمتصُّ أهدابي انحناءاتِ ريشةٍ","نسائيةِ الرِعْشَات ناعمةِ النجوى",210,"و",2,0],[": وتمتمي بكل كبرياء","\" يُحبُني .. يُحبُني كثيرا .. \"",211,"ر",2,0],["وتَمشي السّافياتُ بها حَيارَى","إذا نُقِلَ الههجيرُ عن الجحيمِ",212,"م",1,0],["وتمشي فما تدري إلى قعر هُوَّة","تروح بها ام للمدى المتباعد",213,"د",1,0]]}