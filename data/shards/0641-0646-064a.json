{"poems":[[32,"ما هاج عينيك من الأطلال","https://www.aldiwan.net/poem29544.html","الرجز"],[72,"يومنا يوم مطير","https://www.aldiwan.net/poem42877.html","مجزوء الرمل"],[87,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[47,"شغلان من عذل ومن تفنيد","https://www.aldiwan.net/poem63493.html","الكامل"],[51,"كل امرئ فكما يدين يدان","https://www.aldiwan.net/poem63132.html","الكامل"],[107,"لمن الرواسم يرتمين صواديا","https://www.aldiwan.net/poem43382.html","الكامل"],[54,"فنيت سوى حشاشاة ترقى","https://www.aldiwan.net/poem26900.html","الوافر"],[15,"وهل رام عن عهدي وديك مكانه","https://www.aldiwan.net/poem45270.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39543","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43649","الطويل"],[111,"خذوا بجميل الصبر وارضوا وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=524",""],[92,"لولا...","https://www.poetsgate.com/ViewPoem.aspx?id=179023",""],[151,"يا سواد العين يا روح الجسد","https://www.aldiwan.net/poem47646.html","الرمل"],[154,"فضحت بدمعي سر قلبي صبابة","https://www.aldiwan.net/poem68557.html","الطويل"],[216,"ونشوانة الأعطاف غرثاء بضة","https://www.aldiwan.net/poem37848.html","الطويل"],[264,"عليك سلام يا جميل بثينتي","https://www.aldiwan.net/poem35734.html","الطويل"],[287,"سقت بنت كرمة بنت الكرم","https://www.aldiwan.net/poem32455.html","المتقارب"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[354,"فنيت بوجدي عن وجدي فدام لي","https://www.aldiwan.net/poem15570.html","الطويل"],[354,"فنى وجودي في وجود الهوى","https://www.aldiwan.net/poem15864.html","السريع"],[369,"البحر أجمع لو غدا أنقاسي","https://www.aldiwan.net/poem60869.html","الكامل"],[371,"خليلي قد ابصرت عيشي بعده","https://www.aldiwan.net/poem17344.html","الطويل"],[385,"هفا بفؤادي موهنا صوت صادح","https://www.aldiwan.net/poem49256.html","الطويل"],[458,"الشباب العزيم شعر جميل","https://www.aldiwan.net/poem61345.html","الخفيف"],[458,"باق نعم أنا في ولائي الباقي","https://www.aldiwan.net/poem61566.html","الكامل"],[482,"أظنك لو علمت بفرط حبي","https://www.aldiwan.net/poem15297.html","الوافر"],[505,"أظبي بطاح الأبرقين بحق من","https://www.aldiwan.net/poem37570.html","الطويل"],[505,"ولما توسطنا البطاح عشية","https://www.aldiwan.net/poem37797.html","الطويل"],[505,"جرى دمعي السياح من جفني البالي","https://www.aldiwan.net/poem37821.html","الطويل"],[505,"طيبوا بنا نحن طيب","https://www.aldiwan.net/poem38079.html","المجتث"],[563,"طريقتنا قل بأقوالها","https://www.aldiwan.net/poem33500.html","المتقارب"],[563,"فاز الذي شرب الشراب الصافي","https://www.aldiwan.net/poem33540.html","الكامل"],[563,"إليك من البعد قلبي دنا","https://www.aldiwan.net/poem33810.html","المتقارب"],[580,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"],[593,"","https://poetry.dctabudhabi.ae/diwan/poem/107085","الكامل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103105","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96977","الطويل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101539","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48705","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63865","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67839","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119997","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59346","الطويل"],[1165,"","https://poetry.dctabudhabi.ae/diwan/poem/101338","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136197","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128714","الوافر"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77973","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87849","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27269","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27856","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27654","الطويل"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84530","الطويل"],[2653,"","https://poetry.dctabudhabi.ae/diwan/poem/45356","الكامل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83212","الوافر"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118786","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68012","البسيط"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126981","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127018","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86340","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91281","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206168","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131229",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66557","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114405","الرمل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135387","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44631","البسيط"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75683","الكامل"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107041","الطويل"],[4220,"","https://poetry.dctabudhabi.ae/diwan/poem/104419","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81285","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83541","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83401","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83648","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28786","البسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117311","المتقارب"],[4399,"","https://poetry.dctabudhabi.ae/diwan/poem/130869","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58123","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57987","البسيط"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35418","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33250","الخفيف"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4578,"زفافٌ لبدر العز بالسعد أشرقا","https://www.poetsgate.com/ViewPoem.aspx?id=49491",""],[4927,"العشقُ والمؤرِّخ الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=29946",""],[4966,"أبى","https://www.poetsgate.com/ViewPoem.aspx?id=196967",""],[5111,"رَغْم َالمَسَافَةِ","https://www.poetsgate.com/ViewPoem.aspx?id=212684",""],[5136,"نفس على برحى الشوق أطويها","https://www.poetsgate.com/ViewPoem.aspx?id=121778",""],[5183,"الرثاء الباكي","https://www.poetsgate.com/ViewPoem.aspx?id=180250",""],[5206,"غابة الغرايب","https://www.poetsgate.com/ViewPoem.aspx?id=187358",""],[5206,"حَيَاةُ المُهَج","https://www.poetsgate.com/ViewPoem.aspx?id=187392",""],[5206,"أرى العدل عن لوم العذول هو العدل","https://www.poetsgate.com/ViewPoem.aspx?id=149039",""],[5431,"وإن ضاقتِ السُبْلُ","https://www.poetsgate.com/ViewPoem.aspx?id=190098",""],[5431,"مصر...والرؤيا","https://www.poetsgate.com/ViewPoem.aspx?id=197044",""],[5523,"غدر الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=201365",""],[5582,"هَلْ ما عَهِدْتُ مِنَ البَشاشَةِ عائِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=186883",""],[5889,"قلب المحب لحبه ثمن","https://www.poetsgate.com/ViewPoem.aspx?id=212598",""],[5943,"تشطير لقصيدة نجاة الظاهري","https://www.poetsgate.com/ViewPoem.aspx?id=138286",""],[5975,"هو الحبُّ ..","https://www.poetsgate.com/ViewPoem.aspx?id=53279",""],[5396,"نافذة الكهف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65504&r=&rc=3",""]],"verses":[["فَنَّينِ مِن هَماهِمِ الأَغوالِ","وَمَهمَهٍ أَخوَقَ خافٍ خالي",0,"ل",2,0],["فَنِيَت إِلّا يَسيراً","كُلُّها ذاكَ اليَسيرُ",1,"ر",1,0],["فَنِيَت أَهدابُهُ إِلّا دَماً","قامَ كَالياقوتِ لَم يَنبَجِسِ",2,"س",1,0],["فَنِيَت أَحاديثُ النُفوسِ بِذِكرِها","وَأَفاقَ كُلُّ مُنافِسٍ وَحَسودِ",3,"د",1,0],["فَنِيَ التَعَزُّزُ عَن مُلوكٍ أَصبَحَت","في ذِلَّةٍ وَهُمُ الأَعِزَّةَ كانوا",4,"ن",3,0],["فَنِيَت بَراكينُ القَريضِ وَلا أَرى","ما شَفَّني مِن جَهلِ قَومي فانِيا",5,"ي",2,0],["فَنَيتُ سِوى حُشاشاةٍ تَرَقّى","وَخَلَّفتُ الحَياةَ عَلى أُناسِ",6,"س",1,1],["فَنيتُ وَأَفناني الزَمانُ وَأَصبَحَت","لِداتي بَنو نَعشٍ وَزُهرُ الفَراقِدِ",7,"د",1,0],["فنِيَتْ في هواهُ منا قلوبٌ","وأصابتْ خلودَها الأرواحُ",8,"ح",1,0],["فَنيتُ هَوىً إِلّا حُشاشَة مُهجَتي","أَجولُ بِها في مَربَعٍ وَمَصيفِ",9,"ف",1,1],["فنيت وأبقيت المحامد انجما","لسان ثنائي عن مداهن مفحم",10,"م",1,0],["فَنِيَتْ قواف ما قرحن وإنما","خلدت بذكرى \" ذى القروح \" قروح",11,"ح",1,0],["فني الصبر ولم يفن الجوى","ما أراه فانيا حتى الأبد",12,"د",1,0],["فَنِيتُ وما أدري سوى الوجدِ لي ضَنىً","وَمِتُّ وما أدري سِوى البُعدِ لي حَتفا",13,"ف",2,0],["فَنَى مقلتي خالٌ بِنَبْتِ عذارها","وقد سلبتني النومَ بالأعينِ النُّجْلِ",14,"ل",1,0],["فنيت اشتياقاً في حياتي وحسرةً","ولم يُبق لي برحُ الأسى من بقيّة",15,"ه",1,0],["فَنيطَت بِمُعتَمَدٍ قائِمٍ","بِتَقوى الإِلَهِ إِذا ما حَكَم",16,"م",1,0],["فنيت جمرة الضلوع وكانت","قائدي إذ أتيه في صحرائك",17,"ك",1,0],["فَنَيتُ بِوَجدي عَن وَجدي فَدامَ لي","مَحَلَّ الفَنا رَغماً عَلى حاسِدي الخُلدُ",18,"د",1,1],["فَنى وَجودي في وُجودِ الهَوى","وَزالَ في أَحكامِهِ حَكمي",19,"ي",1,1],["فَنِيا ولم يَفِيا بذِكْرِ أقَلِّه","فقياسُ وَجْدي فوقَ كُلِّ قِياس",20,"س",1,0],["فَنيتُ أَسىً لمّا بَقيتَ مَكارِماً","فَأَصبَحتَ في دارٍ وَأَصبَحتُ في لَحدِ",21,"د",1,0],["فَنى الدَم بَعدَ الدَمع مِما سَجمتهُ","وَرَقَّ لِحالي كُلُ واشٍ وَكاشح",22,"ح",1,0],["فنيت حين ودّعتك الأماني","وهوت حين باعدتك الطلول",23,"ل",1,0],["فنّي لفنّي كيف كان ومجده","مجد السمو إلى أعز طباق",24,"ق",1,0],["فِنْ يكنِ الغرامُ ولا أُحاشي","إدا ذنبي إليكَ فدامَ ذنبي",25,"ب",2,0],["فنى فاجتلاه سرُّ حبِّك بالبقا","وحاشا فؤاداً فيه حُبُّك أن يفنى",26,"ن",2,0],["فَنينا بهِمْ عنَّا وعن كونِ غيرِنا","ومن كانَ مرمِيًّا هلِ العَدْلُ أن يُرمَى",27,"م",2,0],["فَنيتُ بكُمْ عن غيرِكُمْ وحَياتِكُمْ","وقد شَطَحَ العُذَّالُ بالقيلِ والقَالِ",28,"ل",1,0],["فَنِيتُ فيه غَراماً","ومزَّقَ الوَجْدُ لُبِّي",29,"ب",2,0],["فنيتهم فعلها لم يكن","لهم طاعة دون أفعالها",30,"ل",3,0],["فنيت رسوم وجوده وبدا له","وجه الحبيب فكان نعم الكافي",31,"ف",2,0],["فنينا بمن لم يزل سرمدا","ومنه به قد سمعنا الندا",32,"د",2,0],["فَنِيَتْ أَبْحُرُ القريضِ وما وفَّا","هُ وصْفاً بَسيِطُه وَمَدِيدُه",33,"د",2,0],["فنياز ذاك الشعب اصبح انورا","من سعي محمود بها مشكور",34,"ر",1,0],["فنيت بكلي وهة تحصيل حاصلي","وعن قيل أقوالي استقالة قائلي",35,"ي",1,0],["فنينا وما كنا حضرنا ولم نغب","وجدنا ولم نفقد ثبتنا وما زلنا",36,"ن",2,0],["فنيتم ولم تبلغ كهول قبيلكم","مشيباً ولا الشبان تلقى اكتهالها",37,"ل",3,0],["فنيتَ عمرك ساهداً متحرّقاً","متنهداً متألماً ملذوعا",38,"ع",2,0],["فنيت عشقاً وما","رأيت إلا الجفاءْ",39,"ا",2,0],["فنينا من الأحزانِ إلا نَحائزاً","وليس بمأمونِ فناءُ النحائز",40,"ز",1,0],["فَنى زَمَنِي وَالْعُمْرُ وَلى وَقَدْ بَدَا","نَذِيرُ مَشِيبي وَهْوَ يُؤْذِنُ بِالصَّرْفِ",41,"ف",1,0],["فنيرانه منتدى للضيوف","وجيرانه في حمى لا تضامُ",42,"م",1,0],["فَنَيِّرُنَا وَالزُّهْرُ وَالبَحْرُ وَالدُّجَى","وَمَالِكُنَا وَالصَّحْبُ وَالرَّوْضُ وَالْمَطَرْ",43,"ر",1,0],["فني الزمان ولا أرى","لقديم غيك من براح",44,"ح",1,0],["فنيت بهم عما سواهم وحق لي ال","فناء بهم يا صاح ان كنت ان تدري",45,"ر",2,0],["فنيت فليس في سوى لسان","بذكرك يا جميل الذكر رطب",46,"ب",1,0],["فني الخَليل وكل حي فان","سلمان ياللَّه من سلمان",47,"ن",1,1],["فَنيتُ وَأَفنَيتُ اللَيالي بِها هَوىً","وَزِدتُ وَزادَت في الوَلاءِ تَفانِيا",48,"ي",2,0],["فنيت عني بعين أني","وعن عداتي وعن ثقاتي",49,"ت",2,0],["فنيت عني به إليه","وذاك ما لم يقم بظني",50,"ن",2,0],["فنيتُ به عني فأدركَ ناظري","وجودي وغيري لو يكون تأسفا",51,"ف",2,0],["فنيت غَراماً هَل من الغيد منصف","يرق لمحزون وَبالوصل يسعف",52,"ف",1,1],["فَنِيَ الشَبابُ وَكُلُّ شُيءٍ فاني","وَعَلا لِداتي شَيبُهُم وَعَلاني",53,"ي",1,1],["فَنِيلُكَ قَد أَشاحَ إِلى دِرَفسٍ","تَجَلَّلَ بِالقُلوبِ هَوىً سِقابا",54,"ب",2,0],["فنيت عني بها يا صاح إذ برزت","وغبت إذ حضرت حقاً ولم تغب",55,"ب",1,0],["فنيتُ لولا أنيني مَا اهتدى أحد","لمنظري ساقه من سُقْمِيَ الكدر",56,"ر",1,0],["فنيخ في رحب المباءة منك في","بيت رفيع بالسماح مشيد",57,"د",1,0],["فنى هو في ميدان كل فضيلة","كآبائه الماضين أول سابق",58,"ق",1,0],["فَنَيلِ وِصالِهِ وَاللَهِ عِندي","نَوالٌ دونهُ كُلُّ النَوالِ",59,"ل",1,0],["فَنيتُ