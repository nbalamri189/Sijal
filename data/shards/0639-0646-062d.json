tsgate.com/ViewPoem.aspx?id=212773",""],[5459,"ضرع القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=202593",""],[5463,"بيع أم المحبّه","https://www.poetsgate.com/ViewPoem.aspx?id=27212",""],[5463,"قلبك أسود","https://www.poetsgate.com/ViewPoem.aspx?id=33699",""],[5525,"أنشد البحار","https://www.poetsgate.com/ViewPoem.aspx?id=874",""],[5809,"مراض","https://www.poetsgate.com/ViewPoem.aspx?id=205099",""],[5848,"تفاصيل الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=52029",""],[5854,"همًّ تعرّاني فبتُّ أسِيفا ((اعتذار إلى أخ حبيب))","https://www.poetsgate.com/ViewPoem.aspx?id=191828",""],[5956,"خذني إليك أيا ربي","https://www.poetsgate.com/ViewPoem.aspx?id=182488",""],[5956,"صرخة أهل فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192087",""],[5969,"لا نجمٌ ولا قَمَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=198951",""],[5977,"الفؤاد الهائم","https://www.poetsgate.com/ViewPoem.aspx?id=213262",""],[6115,"كيف حالك يايميني","https://www.poetsgate.com/ViewPoem.aspx?id=180460",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[5080,"عن حجّ شريان الحروف لقدسه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88136&r=&rc=6",""]],"verses":[["عَن حَملِ ما في اِحتِمالِهِ ضَعَةٌ","حَتّى يُوارِي عِظامِيَ التُرُبُ",0,"ب",1,0],["عَن حُبِّ أَحوى أَسيلِ الخَدِّ أَبيَضِهِ","ساجي الجُفونِ كَحيلِ الطَرفِ أَسوَدِهِ",1,"د",2,0],["عَن حُبِّكُم يا هِندُ ما","عُمِّرتُ حَيّاً أَغفُلُ",2,"ل",1,0],["عَن حُبِّكُم وَنَذَرتُ صرمَكُمُ","حِيناً وَهَل لِمُتَيَّمٍ نَذرُ",3,"ر",1,0],["عن حرف حر الوجه له","نفس غضبى وفم غضبان",4,"ن",1,0],["عن حبيبٍ كأنّه","بَسْمَةُ الصُّبْحِ إن ظَهَرْ",5,"ر",1,0],["عن حبهم وولائهم","ووفائهم لك معربين",6,"ن",1,0],["عن حياةِ المَجدِ والحبِّ كما","يَشتَهيها رَهطُ فرسانِ السَمَر",7,"ر",1,0],["عن حاله أضحى يترجم دمعه","وبيت ما بلقاه من أشواقه",8,"ق",2,0],["عن حالتي لا تَسأليني رُبَّما","راعَتكِ من قَلبي جروحُ شقاء",9,"ا",2,0],["عَن حَبَبٍ وَحُبِّ مُزنٍ وَلآ","لٍ وَأَقاحٍ يَبتَسِمنَ في الجَذَل",10,"ل",1,0],["عَن حَدَثٍ ذي أَدَبِ","وَخُلُقٍ مُهذَّبِ",11,"ب",1,0],["عَن حَظِّهِ سَفرت بَراعة خَطّهِ","يا حسن ما خَطَّ اليَراع وَما كَتَب",12,"ب",1,0],["عَن حَيَّةٍ في الخُدودِ ظالِمَةٍ","تَمنَعُ مِن شَمِّ وَردِها الخَضِلِ",13,"ل",1,0],["عن حميم وعن خليل رب أسألك يا كريم","فضلك الوافر الجزيل",14,"ل",1,0],["عن حكم أهل الشرك في أقطارنا","كالبانيان ومن سواهم جاحد",15,"د",1,0],["عن حبي الجمال حبي للعفة","حب المختار من غير حض",16,"ض",1,0],["عَنْ حُكْمِ لُبْسٍ للمُعَصْفَرِ مال الّذي","قَدْ صَحّ مما قَالَ فِيهِ الشارِعُ",17,"ع",1,0],["عن حبكم صح قلبي","فليس فيه غرام",18,"م",1,1],["عَن حَطّاب إِيد فاسه ضاعَت","وَاِلّا اِنسَرَقَت مِنهُ سرقَه",19,"ق",2,0],["عن حبِّنا وعن الغرامِ الأوّلِ","خمسون طفلًا يُذْبَحُونَ وتَسألي",20,"ل",2,1],["عَنْ حَيَاةِ النَّفْسِ عَنْ طِيبِ الحَيَا","عَنْ صبَاحِ السَّعْدِ عَنْ زَيْنِ الغَوَالْ",21,"ل",1,0],["عَنْ حافَتَي أَبْلَقَ مُجرَهِدِّ","مُخْرَوِّطٌ يَصْدُرُ بَعْدَ الوِرْدِ",22,"د",1,0],["عن حكاها لسان السيف والقلم","هذا يقر بفضلي ثغر مخذمه",23,"ه",1,0],["عَن حُبِهُم مَنَتعَ اللَما","ظُلماً وَعُدوان",24,"ن",1,0],["عَن حُب ذات الشُؤن لا شَيء يَثنينا","وَفي هَواها المَصون شابت نَواصينا",25,"ن",2,1],["عن حمى الزوراءِ ما دامت دواما","أوبةٌ جاءت بنيلِ المِنَحِ",26,"ح",1,0],["عن حملها ضعفت وفي","ها أُعطيتْ للسعيِ قوَّه",27,"و",2,0],["عن حال قلبٍ بهِ النيران تضطرمُ","مذ سرت عني تركت الدار ناعيةً",28,"ه",1,0],["عن حبكم قط لا أحول","ولو برى جسمي النحول",29,"ل",1,1],["عن حدود عندها كانت ممر","طالما أظلم في عين النبيل",30,"ل",1,0],["عن حاجب ترمي بِنَبلٍ منتضى","فما رمى الا وللموت وطن",31,"ن",1,0],["عن حسد ذاك ولا خير في","من لا ترى يوماً له حاسدا",32,"د",2,0],["عن حسن خلق ولطف","تشف منه السرائر",33,"ر",1,0],["عن حسنها غرر الاشعار قد قصرت","وصفاً وبالقصر إحسان وإجمال",34,"ل",1,0],["عن حيلة يُعمِلها بفركه","إذا غدا بكلبه وصقره",35,"ر",2,0],["عَن حافِرٍ كَالصَخرِ إِلّا أَنَّهُ","أَقوى وَأَصلَبُ مِنهُ في اِستِحكامِهِ",36,"م",2,0],["عن حديثٍ ذي أرب","وخلق مهذب",37,"ب",1,0],["عن حال سادات مضوا","في قرنه الثاني عشر",38,"ر",1,0],["عن حسنك المزرى بكل حسن","بالشمس أو بالبدر أو بالغصن",39,"ن",1,0],["عن حسنها قاصرات الطرف قد قصرت","أحبب بكاعبة النجدين عطبول",40,"ل",1,0],["عن حسنِ أوصافِ له مع رفعة","نزلت بسوح معاهد التنصيصِ",41,"ص",1,0],["عَن حِكمَةِ التَّصفِيقِ؟ عَن آيةِ ال","تَّدويرِ والتبريرِ لِلحانِثِ ؟",42,"ث",1,0],["عَن حِكمَةِ التَّصفِير؟! أَم آيةِ ال","تَّكفِيرِ والتبريرِ لِلحانِثِ؟!",43,"ث",1,0],["عن حبه لابن أبي طالب","من جُدِّلت في الحرب أقرانه",44,"ن",2,0],["عن حاجة المحتاج ما قدم اعذار","واللي زبن شرواه تبشر هقاويه",45,"ي",2,0],["عن حلمه المشنوق فوق جبينه","عن وعده المتقوس المحدودب",46,"ب",1,0],["عَنْ حياضِ الدين ذودوا","وادحَضُوا العادي البغيَّا",47,"ي",2,0],["عَن حَالِ أَهلِ النَّارِ، فِيْمَ شقاؤُهم؟","وصَفَ النبيُّ مُقامَهُم في النَّارِ",48,"ر",1,0],["عن حمى قبر جده منعته","عصبة ملء صدرها أضغان",49,"ن",1,0],["عن حقهم ناموا ومن شأن الكرى","أن يوقع النوام في الكابوس",50,"س",1,0],["عن حبّه ماكان منصرفا","هو خير خلق الله إذْ يهوى",51,"و",2,0],["عن حماقاتنا العنيفة يهذي","يتلوى وفي اللذاذة ذابا",52,"ب",2,0],["عن حروفٍ أثيمةٍ دون معنًى","دنّسَتْ بالسّوادِ بيضَ الصحاف ..",53,"ف",1,0],["عن حبيبي يا نجوم الليل عنّه خبّريني","وش علومه هالمتيّم وش علاجه وش يبي له ؟",54,"ل",2,0],["عن حنيني وإشتياقي .. عن غرامي خبّريه","وكيف كنتي الرعيّه وكان لك هالقلب راع",55,"ع",1,0],["عن حبال الشوق تظمأ للشطوط","عن حروق الملح في شفاه السنين",56,"ن",1,0],["عن حديثٍ حينما نسمعُهُ","لم نَعُدْ نحفظُ إلاّ ماروى",57,"و",2,0],["عن حزنها ..عن حسنها ..عنها.. عن اللي ما سلى","عن كل مرة قلت اب آمرها واجيها ب انصياع !",58,"ع",1,0],["عنْ حكمةِ اللهِ الحكيمِ تنزّلتْ","فكُنِ امرَأً قَبِلَ القضا وحصيفَا",59,"ف",2,0],["‏ ‏عن حلوة أكلت مالي وأنسجتي","‏ ‏ قد سمَّمتْ كلَّ خير بي وكلَّ كَلا",60,"ل",2,0],["عن حياة ليس فيها فرحة","كلها همٌّ وسُقْمٌ وانثِنا",61,"ن",2,0],["عَنْ حُبهِ عَنْ تَفاصيلٍ تَشي بِغَدٍ","لا صُبحَ فيه ولا لَيلٌ ولا سَمَرُ",62,"ر",1,0],["عن حنانِ الأم ...عن بسمتها","عن جمالِ الحب في روح أخيه",63,"ي",2,0],["عن حوالك هات علمك خبريني","ياعسى لايام تاليها سعاده",64,"د",2,0],["عَن حَمل باهظ هد حيلي وَقُوَتي","وَحالي العِدا ما حي مِنهُم رَثى لَها",65,"ل",3,0],["عن حَجّ شريانِ الحروف لقدسهِ","وعن اعتلاء القهر سدرةَ أمسهِ",66,"س",2,1]]}