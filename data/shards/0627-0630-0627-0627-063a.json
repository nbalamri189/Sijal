{"poems":[[53,"أراك ستحدث للقلب وجدا","https://www.aldiwan.net/poem30614.html","المتقارب"],[30,"خليلي عوجا عوجة","https://www.aldiwan.net/poem29570.html","الطويل"],[23,"ألم تسأل الربع الجديد التكلما","https://www.aldiwan.net/poem21236.html","الطويل"],[72,"دعوتك يا مولاي للحال عالما","https://www.aldiwan.net/poem18516.html","الطويل"],[29,"صحا القلب عن أروى وأقصر باطله","https://www.aldiwan.net/poem6057.html","الطويل"],[56,"غاد المدام بحث الكأس والطاس","https://www.aldiwan.net/poem58571.html","الطويل"],[45,"مغاني سليمى بالعقيق ودورها","https://www.aldiwan.net/poem63610.html","الطويل"],[45,"كفي الملامة أو دومي على العذل","https://www.aldiwan.net/poem65639.html","البسيط"],[28,"مهاريس أشباه كأن رؤوسها","https://www.aldiwan.net/poem4963.html","الطويل"],[28,"لنا ما تمنينا من العيش ما دعا","https://www.aldiwan.net/poem5337.html","البسيط"],[28,"ألم تر أني يوم جو سويقة","https://www.aldiwan.net/poem5654.html","الطويل"],[49,"إذا اغتاظ لم يقلق وإن صل لم يحم","https://www.aldiwan.net/poem64913.html","الطويل"],[66,"في مثل حضرتكم لا يزأر الأسد","https://www.aldiwan.net/poem41370.html","البسيط"],[33,"أيا جبل الدوم الذي في ظلاله","https://www.aldiwan.net/poem25777.html","الطويل"],[48,"ودار يؤدب فيها البزاة","https://www.aldiwan.net/poem62610.html","المتقارب"],[46,"غدوت على نفسي أثرب جاهدا","https://www.aldiwan.net/poem22081.html","الطويل"],[46,"حوائج نفسي كالغواني قصائر","https://www.aldiwan.net/poem22443.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16663","الطويل"],[90,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[45,"كُفِّي المَلاَمَةَ أَو دُومِي عَلَى العَذَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=31888",""],[28,"عزفت بأعشاش وما كدت تعزف","https://www.poetsgate.com/ViewPoem.aspx?id=22116",""],[120,"أخا ثقتي كما ثارت النفس ثورة","https://www.aldiwan.net/poem49365.html","الطويل"],[181,"ذكرتك والنجم اليمانى كأنه","https://www.aldiwan.net/poem58831.html","الطويل"],[186,"ما استشعر الصبر إلا وهو مجهود","https://www.aldiwan.net/poem43908.html","البسيط"],[261,"تذكر مهدا بالغوير ومعهدا","https://www.aldiwan.net/poem38337.html","الطويل"],[298,"عيون من كلامك قد","https://www.aldiwan.net/poem36803.html","عموديه"],[322,"ألا طال التنظر والثواء","https://www.aldiwan.net/poem56353.html","الوافر"],[353,"يطارحني هذا الزمان بهمه","https://www.aldiwan.net/poem39778.html","الطويل"],[366,"أما ومنك على أعدائك الطلب","https://www.aldiwan.net/poem17155.html","البسيط"],[366,"ما العجب في خلق ذاك الخلق بالعجب","https://www.aldiwan.net/poem17312.html","البسيط"],[406,"أبى زمني مذ شبت ألا تعوجا","https://www.aldiwan.net/poem50197.html","الطويل"],[406,"فؤادي الفداء لها من قبب","https://www.aldiwan.net/poem50210.html","المتقارب"],[437,"سقاه الصبا خمر الدلال المردد","https://www.aldiwan.net/poem2561.html","الطويل"],[461,"اذا اغبرت فجاج الأرض محلا","https://www.aldiwan.net/poem15373.html","الوافر"],[461,"تتيه به الأيام فخرا وغبطة","https://www.aldiwan.net/poem16121.html","الطويل"],[515,"إلى كم أحوك الشعر في الذم والمدح","https://www.aldiwan.net/poem12053.html","الطويل"],[553,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[562,"إذا طلع النهار أرى الرجالا","https://www.aldiwan.net/poem52866.html","البسيط"]],"verses":[["إِذا أَغرَقوا بيضَهُم في الطُلى","وَساموا القَنا مِن دَمِ الطَعنِ وِردا",0,"د",2,0],["إِذا اِغتَبَقَت نَجماً فَغارَ تَسَحَّرَت","عُلالَةَ نَجمٍ آخِرَ اللَيلِ طالِعِ",1,"ع",1,0],["إِذا اِغبَرَّ آفاقُ السَماءِ وَأَمحَلَت","كَأَنَّ عَلَيها ثَوبَ عَصبٍ مُسَهَّما",2,"م",2,0],["إذا أغلقت أبواب رزقي عشيرةٌ","فأنتَ أبو تسهيلها وأبو الفتح",3,"ح",1,0],["إِذا اِغتَرَّها مِن بَطنِ غَيبٍ تَكَشَّفَت","لِرَوعاتِهِ جُحشانُهُ وَحَلائِلُه",4,"ل",2,0],["إذا اغْتَدَى لِزُبُورِ الكُتْبِ يَدْرُسُها","أَلْهَى قُلوبَ الوَرَى عن كُلِّ مِدْراسِ",5,"س",1,0],["إِذا اِغتَرَبَت أُكرومَةٌ مِنهُ لَم تَجِد","مِنَ الناسِ إِلّا قائِلاً ما نَظيرُها",6,"ر",3,0],["إِذا اِغتَدى اِغتَدَتِ الآمالُ تَقدُمُهُ","إِلى نُفوسِ العِدى بِالخَبلِ وَالوَجَلِ",7,"ل",1,0],["إِذا اِغبَرَّ أَهلُ الشاءِ أَشرَقَ أَهلُها","وَكانَ لَها فَضلٌ مِنَ الأَدَواتِ",8,"ت",1,0],["إِذا اِغبَرَّ آفاقُ السَماءِ وَكَشَّفَت","كُسورَ بُيوتِ الحَيِّ حَمراءُ حَرجَفُ",9,"ف",1,0],["إِذا اِغرَورَقَت عَينايَ أَسبَلَ مِنهُما","إِلى أَن تَغيبَ الشِعرَيانِ بُكائِيا",10,"ي",2,0],["إِذا اغتاظَ لَم يَقلَق وَإِن صَلَ لَم يَحمِ","وَإِن قالَ لَم يَهجُر وَلَم يَتَأَثَّمِ",11,"م",1,1],["إِذا اِغتَدى نافِئاً بِالسِحرِ في عُقَدٍ","حُلَّت بِنَجواهُ مِن آمالِنا العُقَدُ",12,"د",1,0],["إِذا اِغرَورَقَت عَينايَ قالَ صَحابَتي","لَقَد أولِعَت عَيناكَ بِالهَمَلانِ",13,"ن",1,0],["إِذا اِغتامَها قَرِمُ المُعتَفينَ","طُروقاً غَدا رَهِمَ المِعدَه",14,"د",2,0],["إِذا أَغرَبَت يَوماً بِرُزءٍ عَلى الفَتى","فَلَيسَت عَلى نَفسي بِما حُمَّ تُغرِبُ",15,"ب",1,0],["إِذا أَغضَبَ الخَيلَ الشَكيمُ فَما لَها","عَلَيهِ اِقتِدارٌ غَيرَ أَزمِ الحَدائِدِ",16,"د",1,0],["إذا أغْرَبَ الرُّعْيانُ عنها سَوامَها","أُرِيحَ عليها الليلَ هَيْقٌ وَذَيّال",17,"ل",1,0],["إذا أُغرِيتْ هذي بأكلِ فريسةٍ","فهذا بأنْ يلهو بتعذيبها مُغرى",18,"ر",2,0],["إِذا اغْتَدَى اغْتَدَتِ الآمَالُ تَقْدُمُهُ","إِلى نُفُوسِ العِدَى بالخَيْلِ والوَجَل",19,"ل",1,0],["إذا اغْبَرّ آفَاقُ السّمَاءِ وَكَشّفَتْ","كُسُورَ كبُيوتِ الحَيّ حمرَاءُ حَرْجَفُ",20,"ف",1,0],["إذا اغتمضت عيناني فالقلب ساهرٌ","يظل طويل الليل يرعى ويرصد",21,"د",1,0],["إِذا اغرَورَقَت عَيناىَ قالَ صَحابَتِى","إِلى كَم تَرَى عَيناكَ تَبتَدِرَانِ",22,"ن",1,0],["إذا اغتدى فاتحا فاه رأيت فما","كأنما كل ناب فيه سفود",23,"د",1,0],["إذا اغتالت الظلماء وجه ذكائها","وابدت من الجوز شنفا منضدا",24,"د",2,0],["إذا إِغفاءَهُ سختْ","فأَنتِ الهاجسُ الآخرْ",25,"ر",1,0],["إِذا اِغتَبَقَت مِن الأَنداءِ طَلا","فَإِنَّ صَبوحَها مِنها رَواءُ",26,"ا",2,0],["إِذا أَغرقته مِنهُ لجّة زاخر","عَلى مدّهِ اِستَلقاه جزر خضمِّهِ",27,"م",2,0],["إِذا أَغَرتُ عَلى سَمعِ اللَبيبِ بِها","عادَت وَفي يَدِها مِن لُبِّهِ سَلَبُ",28,"ب",1,0],["إِذا أَغَرتَ عَلى قَلبي فَخُذ جَلَدي","وَنَومَ عَيني وَدَعهُ آخِرَ الطَلَبِ",29,"ب",1,0],["إِذا أَغمَدَت عَن مَعشَر عاد مِنهُما","وَإِن جرِّدَت في جَحفَل عاد منفجا",30,"ج",2,0],["إِذا اغتَرب اللَيثُ عن خدرِهِ","غَدا الشاء يَرتَع فيهِ العشب",31,"ب",1,0],["إذا أغلقت أبوابُ سعي عن أمريء","فتحتم له بأبي رجاء ومقصد",32,"د",1,0],["اذا اغبرت فجاجُ الأرض محْلاً","فغاضَ الغمرُ وابيضَّ النَّضيرُ",33,"ر",1,1],["إذا أغْنَم العافينَ بالرِّفْدِ مالَهُ","غدا وهو للحمدِ المُخَلَّدِ غانِمُ",34,"م",1,0],["إذا أغمضت عمن سواك جفونها","صدوداً ولم تسمح لغيرك باللمح",35,"ح",1,0],["إِذا أَغمَدَت هِمّاتُهُ خَطباً اِغتَدَت","عَلى مُنتَضى رَأيٍ مُمَرٍّ بِهِ السَحلُ",36,"ل",1,0],["إذا أغلَقتَ دُونَ المَوتِ باباً","تَناوَلَ ألفَ بابٍ كيفَ جالا",37,"ل",2,0]]}