{"poems":[[55,"أراك ستحدث للقلب وجدا","https://www.aldiwan.net/poem30614.html","المتقارب"],[32,"خليلي عوجا عوجة","https://www.aldiwan.net/poem29570.html","الطويل"],[23,"ألم تسأل الربع الجديد التكلما","https://www.aldiwan.net/poem21236.html","الطويل"],[74,"دعوتك يا مولاي للحال عالما","https://www.aldiwan.net/poem18516.html","الطويل"],[31,"صحا القلب عن أروى وأقصر باطله","https://www.aldiwan.net/poem6057.html","الطويل"],[58,"غاد المدام بحث الكأس والطاس","https://www.aldiwan.net/poem58571.html","الطويل"],[47,"مغاني سليمى بالعقيق ودورها","https://www.aldiwan.net/poem63610.html","الطويل"],[47,"كفي الملامة أو دومي على العذل","https://www.aldiwan.net/poem65639.html","البسيط"],[30,"مهاريس أشباه كأن رؤوسها","https://www.aldiwan.net/poem4963.html","الطويل"],[30,"لنا ما تمنينا من العيش ما دعا","https://www.aldiwan.net/poem5337.html","البسيط"],[30,"ألم تر أني يوم جو سويقة","https://www.aldiwan.net/poem5654.html","الطويل"],[51,"إذا اغتاظ لم يقلق وإن صل لم يحم","https://www.aldiwan.net/poem64913.html","الطويل"],[68,"في مثل حضرتكم لا يزأر الأسد","https://www.aldiwan.net/poem41370.html","البسيط"],[35,"أيا جبل الدوم الذي في ظلاله","https://www.aldiwan.net/poem25777.html","الطويل"],[50,"ودار يؤدب فيها البزاة","https://www.aldiwan.net/poem62610.html","المتقارب"],[48,"غدوت على نفسي أثرب جاهدا","https://www.aldiwan.net/poem22081.html","الطويل"],[48,"حوائج نفسي كالغواني قصائر","https://www.aldiwan.net/poem22443.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16663","الطويل"],[92,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[47,"كُفِّي المَلاَمَةَ أَو دُومِي عَلَى العَذَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=31888",""],[30,"عزفت بأعشاش وما كدت تعزف","https://www.poetsgate.com/ViewPoem.aspx?id=22116",""],[124,"أخا ثقتي كما ثارت النفس ثورة","https://www.aldiwan.net/poem49365.html","الطويل"],[185,"ذكرتك والنجم اليمانى كأنه","https://www.aldiwan.net/poem58831.html","الطويل"],[190,"ما استشعر الصبر إلا وهو مجهود","https://www.aldiwan.net/poem43908.html","البسيط"],[266,"تذكر مهدا بالغوير ومعهدا","https://www.aldiwan.net/poem38337.html","الطويل"],[303,"عيون من كلامك قد","https://www.aldiwan.net/poem36803.html","عموديه"],[327,"ألا طال التنظر والثواء","https://www.aldiwan.net/poem56353.html","الوافر"],[358,"يطارحني هذا الزمان بهمه","https://www.aldiwan.net/poem39778.html","الطويل"],[371,"أما ومنك على أعدائك الطلب","https://www.aldiwan.net/poem17155.html","البسيط"],[371,"ما العجب في خلق ذاك الخلق بالعجب","https://www.aldiwan.net/poem17312.html","البسيط"],[412,"أبى زمني مذ شبت ألا تعوجا","https://www.aldiwan.net/poem50197.html","الطويل"],[412,"فؤادي الفداء لها من قبب","https://www.aldiwan.net/poem50210.html","المتقارب"],[443,"سقاه الصبا خمر الدلال المردد","https://www.aldiwan.net/poem2561.html","الطويل"],[466,"اذا اغبرت فجاج الأرض محلا","https://www.aldiwan.net/poem15373.html","الوافر"],[466,"تتيه به الأيام فخرا وغبطة","https://www.aldiwan.net/poem16121.html","الطويل"],[520,"إلى كم أحوك الشعر في الذم والمدح","https://www.aldiwan.net/poem12053.html","الطويل"],[558,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[567,"إذا طلع النهار أرى الرجالا","https://www.aldiwan.net/poem52866.html","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38334","الطويل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123435","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112853","الطويل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21670","الطويل"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96324","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109460","الطويل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101724","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129835","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204477","الوافر"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112484","المتقارب"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28868","الطويل"],[3553,"","https://poetry.dctabudhabi.ae/diwan/poem/17666","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92103","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91772","الطويل"],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124660","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204313","الطويل"],[4755,"أَسَرَّت إِلى أُختِها","https://www.poetsgate.com/ViewPoem.aspx?id=190547",""],[4764,"أميرة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=24649",""],[4766,"وما شيءٍ له في الرأس رجل","https://www.poetsgate.com/ViewPoem.aspx?id=181429",""],[4903,"وَمَجلِسٌ موَفُورُ الجلالة تنثني","https://www.poetsgate.com/ViewPoem.aspx?id=96554",""],[4927,"جُنُوْحُ الْقَلْب","https://www.poetsgate.com/ViewPoem.aspx?id=29640",""],[3859,"رنت بلابلُ في ودٍ من السلم","https://www.poetsgate.com/ViewPoem.aspx?id=124438",""],[5183,"نكبات الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=186413",""],[5582,"تُلَوِّمُنِي فِي الحُبِّ وَالحِبُّ يُعْذَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=187140",""],[5638,"عيون.....","https://www.poetsgate.com/ViewPoem.aspx?id=198255",""],[466,"لقد علمت زوراء دجلة أنني","https://www.poetsgate.com/ViewPoem.aspx?id=38054",""],[5855,"ومأمورة امرأ وتأتي بغيره","https://www.poetsgate.com/ViewPoem.aspx?id=186558",""],[6089,"البحرُ المولّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=212945",""]],"verses":[["إِذا أَغرَقوا بيضَهُم في الطُلى","وَساموا القَنا مِن دَمِ الطَعنِ وِردا",0,"د",2,0],["إِذا اِغتَبَقَت نَجماً فَغارَ تَسَحَّرَت","عُلالَةَ نَجمٍ آخِرَ اللَيلِ طالِعِ",1,"ع",1,0],["إِذا اِغبَرَّ آفاقُ السَماءِ وَأَمحَلَت","كَأَنَّ عَلَيها ثَوبَ عَصبٍ مُسَهَّما",2,"م",2,0],["إذا أغلقت أبواب رزقي عشيرةٌ","فأنتَ أبو تسهيلها وأبو الفتح",3,"ح",1,0],["إِذا اِغتَرَّها مِن بَطنِ غَيبٍ تَكَشَّفَت","لِرَوعاتِهِ جُحشانُهُ وَحَلائِلُه",4,"ل",2,0],["إذا اغْتَدَى لِزُبُورِ الكُتْبِ يَدْرُسُها","أَلْهَى قُلوبَ الوَرَى عن كُلِّ مِدْراسِ",5,"س",1,0],["إِذا اِغتَرَبَت أُكرومَةٌ مِنهُ لَم تَجِد","مِنَ الناسِ إِلّا قائِلاً ما نَظيرُها",6,"ر",3,0],["إِذا اِغتَدى اِغتَدَتِ الآمالُ تَقدُمُهُ","إِلى نُفوسِ العِدى بِالخَبلِ وَالوَجَلِ",7,"ل",1,0],["إِذا اِغبَرَّ أَهلُ الشاءِ أَشرَقَ أَهلُها","وَكانَ لَها فَضلٌ مِنَ الأَدَواتِ",8,"ت",1,0],["إِذا اِغبَرَّ آفاقُ السَماءِ وَكَشَّفَت","كُسورَ بُيوتِ الحَيِّ حَمراءُ حَرجَفُ",9,"ف",1,0],["إِذا اِغرَورَقَت عَينايَ أَسبَلَ مِنهُما","إِلى أَن تَغيبَ الشِعرَيانِ بُكائِيا",10,"ي",2,0],["إِذا اغتاظَ لَم يَقلَق وَإِن صَلَ لَم يَحمِ","وَإِن قالَ لَم يَهجُر وَلَم يَتَأَثَّمِ",11,"م",1,1],["إِذا اِغتَدى نافِئاً بِالسِحرِ في عُقَدٍ","حُلَّت بِنَجواهُ مِن آمالِنا العُقَدُ",12,"د",1,0],["إِذا اِغرَورَقَت عَينايَ قالَ صَحابَتي","لَقَد أولِعَت عَيناكَ بِالهَمَلانِ",13,"ن",1,0],["إِذا اِغتامَها قَرِمُ المُعتَفينَ","طُروقاً غَدا رَهِمَ المِعدَه",14,"د",2,0],["إِذا أَغرَبَت يَوماً بِرُزءٍ عَلى الفَتى","فَلَيسَت عَلى نَفسي بِما حُمَّ تُغرِبُ",15,"ب",1,0],["إِذا أَغضَبَ الخَيلَ الشَكيمُ فَما لَها","عَلَيهِ اِقتِدارٌ غَيرَ أَزمِ الحَدائِدِ",16,"د",1,0],["إذا أغْرَبَ الرُّعْيانُ عنها سَوامَها","أُرِيحَ عليها الليلَ هَيْقٌ وَذَيّال",17,"ل",1,0],["إذا أُغرِيتْ هذي بأكلِ فريسةٍ","فهذا بأنْ يلهو بتعذيبها مُغرى",18,"ر",2,0],["إِذا اغْتَدَى اغْتَدَتِ الآمَالُ تَقْدُمُهُ","إِلى نُفُوسِ العِدَى بالخَيْلِ والوَجَل",19,"ل",1,0],["إذا اغْبَرّ آفَاقُ السّمَاءِ وَكَشّفَتْ","كُسُورَ كبُيوتِ الحَيّ حمرَاءُ حَرْجَفُ",20,"ف",1,0],["إذا اغتمضت عيناني فالقلب ساهرٌ","يظل طويل الليل يرعى ويرصد",21,"د",1,0],["إِذا اغرَورَقَت عَيناىَ قالَ صَحابَتِى","إِلى كَم تَرَى عَيناكَ تَبتَدِرَانِ",22,"ن",1,0],["إذا اغتدى فاتحا فاه رأيت فما","كأنما كل ناب فيه سفود",23,"د",1,0],["إذا اغتالت الظلماء وجه ذكائها","وابدت من الجوز شنفا منضدا",24,"د",2,0],["إذا إِغفاءَهُ سختْ","فأَنتِ الهاجسُ الآخرْ",25,"ر",1,0],["إِذا اِغتَبَقَت مِن الأَنداءِ طَلا","فَإِنَّ صَبوحَها مِنها رَواءُ",26,"ا",2,0],["إِذا أَغرقته مِنهُ لجّة زاخر","عَلى مدّهِ اِستَلقاه جزر خضمِّهِ",27,"م",2,0],["إِذا أَغَرتُ عَلى سَمعِ اللَبيبِ بِها","عادَت وَفي يَدِها مِن لُبِّهِ سَلَبُ",28,"ب",1,0],["إِذا أَغَرتَ عَلى قَلبي فَخُذ جَلَدي","وَنَومَ عَيني وَدَعهُ آخِرَ الطَلَبِ",29,"ب",1,0],["إِذا أَغمَدَت عَن مَعشَر عاد مِنهُما","وَإِن جرِّدَت في جَحفَل عاد منفجا",30,"ج",2,0],["إِذا اغتَرب اللَيثُ عن خدرِهِ","غَدا الشاء يَرتَع فيهِ العشب",31,"ب",1,0],["إذا أغلقت أبوابُ سعي عن أمريء","فتحتم له بأبي رجاء ومقصد",32,"د",1,0],["اذا اغبرت فجاجُ الأرض محْلاً","فغاضَ الغمرُ وابيضَّ النَّضيرُ",33,"ر",1,1],["إذا أغْنَم العافينَ بالرِّفْدِ مالَهُ","غدا وهو للحمدِ المُخَلَّدِ غانِمُ",34,"م",1,0],["إذا أغمضت عمن سواك جفونها","صدوداً ولم تسمح لغيرك باللمح",35,"ح",1,0],["إِذا أَغمَدَت هِمّاتُهُ خَطباً اِغتَدَت","عَلى مُنتَضى رَأيٍ مُمَرٍّ بِهِ السَحلُ",36,"ل",1,0],["إذا أغلَقتَ دُونَ المَوتِ باباً","تَناوَلَ ألفَ بابٍ كيفَ جالا",37,"ل",2,0],["إِذا اِغتابَهُ المُغتابُ مِن نَحوِ حاسِدٍ","وَأَحسِنْ بِما يغتابُ مِن قَولِ مُغتابِ",38,"ب",1,0],["إذا اغْتابَني فاشْكُرْهُ عنّي فإنَّما","يُقَرِّظُ مِثلي مِثلُه باغتيابه",39,"ب",2,0],["إذا اغبرت الغبرا بقحط واجدبت","ولم يأتها ماء من السحب يقطر",40,"ر",1,0],["إِذا اغرَقَت إِنسانَها وَسَوادَهُ","تَداعى بِمِلءِ الناظِرَينِ اِنسِكابُها",41,"ب",3,0],["اذا اغتربت منا هجان كريمة","وجدت ابنها اذ عد خالا ومنجبا",42,"ب",2,0],["إذا اغتابني يوماً عذولي صغى له","وحقٌ عليه أن يكون له الزجر",43,"ر",1,0],["إذا اغتنم الغضبان للفتك فرصة","رأى هو أن العفو من خير مغنم",44,"م",1,0],["إذا اغتربَ الإنسانُ عمّن يسوءهُ","فما هو في الإبعاد عنه غريبُ",45,"ب",1,0],["إذا أغراك بالأجسام عقل","فإنك منذ عقلك قد جهلت",46,"ت",1,0],["إذا أغفل الروض صوب الربيع","يحول إلى بلقع أو موات",47,"ت",1,0],["إِذا اِغتَبَقَتني بَلدَةٌ لَم أَكُن لَها","نَسيباً وَلم تَسْدَدْ عَلَيَّ المَطالِعُ",48,"ع",1,0],["إِذا اِغتَرَّهُ بَينُ الجَميعِ فَلَم تَكُن","لَهُ فَزعَةٌ إِلاّ الهَوادِجُ تُخدَرُ",49,"ر",1,0],["إذا اغترب الخَمولُ أفاد خيراً","ولكن لا يفيدُ به الحبيبُ",50,"ب",1,1],["إِذا اغرورقت عَيني بماء غروبها","يَزيد جَوى نارا الفؤاد لَهيب",51,"ب",1,0],["اذا اغلقت باب العلوم لدى الورى","يفك بفكر منه ما هو مغلق",52,"ق",1,0],["إذا اغتربت منك الموالاة عند من","ينافق فيها فهي عنديَ في الوطنْ",53,"ن",1,0],["إِذا أُغلِقَ البابُ في وَجهِهِ","غَدًا يَدخُلُ البَيتَ مِن سُورِهِ",54,"ر",2,0],["إذا اغتريتِ في حالي .. لي اسبابي .. ولي عِذري","بِعمري ما قَصدت الغير .. ولا عَزيتِ مَهبولي",55,"ل",2,0],["إذا أغمضت عينك أبصرته","وإن فتحت عينك لا تراه",56,"ه",1,0],["إذَا اغبرّت الآفاقُ بُلتْ سماؤُهُ","ثَرَاها بِأيدٍ ما يَجف رَغَابُهَا",57,"ب",3,0],["إِذَاْ أَغْضَتْº فَذَلِكَ عَنْ حَيَاْءٍ","وَإِنْ نَظَرَتْº سَتَنْطَلِقُ السِّهَاْمُ",58,"م",1,0],["إذا أغوصُ بحورَهُ تعطلتِ ال","نحُورُ تطمعُ فيما جلَّ من قيمِ",59,"م",1,0],["إذا أغلقت أبواب كسرى وقيصر","فبابك دون الناس لم يُلْف مغلقا",60,"ق",2,0],["إِذا اغْبَرَّت الآفاقُ وَجْهاً فَوَجْهُهُ","مُضِيءٌ وَمَغْناهُ لِعافِيهِ أَخْضَرُ",61,"ر",1,0],["إِذَا أُغْمِضَتْ كَالشَّمْسِ حِينَ غُرُوبِهَا","تُوَدِّعُهَا الدُّنْيَا مَعَ الشَّوْقِ قَدْ نَمَا",62,"م",2,0],["إذا أغمد البيض الصوارم في الطلى","وحطَّم مَّران الوغى في الحناجر",63,"ر",1,0],["إذا أغضبتني في العتاب سببتها","وما اتْبعت في ذاك غياً ولا رشدا",64,"د",2,0],["إذا أغمض البحرُ الوسيعُ عيونَهُ","فثمّ سماءٌ لا تنامُ عيونُها",65,"ن",3,0]]}