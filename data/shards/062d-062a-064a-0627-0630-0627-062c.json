{"poems":[[55,"أكذا المنون تقنطر الأبطالا","https://www.aldiwan.net/poem29888.html","الكامل"],[32,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[85,"هب النسيم على الرياض مع السحر","https://www.aldiwan.net/poem54309.html","الكامل"],[49,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[74,"شب الحشا قول الكواعب شابا","https://www.aldiwan.net/poem18236.html","الكامل"],[66,"أشار لحظي بعين علم","https://www.aldiwan.net/poem67612.html","مخلع البسيط"],[53,"حاجيت فضلا وهو ذو فطنة","https://www.aldiwan.net/poem64660.html","السريع"],[26,"أمن المنون وريبها تتوجع","https://www.aldiwan.net/poem24106.html","الكامل"],[93,"زعم المؤدب أن عيرا سائه","https://www.aldiwan.net/poem62774.html","عموديه"],[40,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[91,"كان النعي يثير في الأرواح","https://www.aldiwan.net/poem44718.html","الكامل"],[91,"ما الشعر الا نغم","https://www.aldiwan.net/poem44737.html","مجزوء الرجز"],[87,"أي الممالك أيها","https://www.aldiwan.net/poem63703.html","مجزوء الكامل"],[87,"مملكة مدبره","https://www.aldiwan.net/poem63766.html","مجزوء الرجز"],[30,"صيداء شأمية حرف كمشترف","https://www.aldiwan.net/poem5496.html","البسيط"],[68,"إن لم أزر ربعكم سعيا على الحدق","https://www.aldiwan.net/poem41377.html","البسيط"],[46,"يا ربع لو ربعوا على ابن هموم","https://www.aldiwan.net/poem30351.html","الكامل"],[33,"إن الخليط مع الصباح تصدعوا","https://www.aldiwan.net/poem42244.html","الكامل"],[107,"أأفاق ظالم نفسه فأنابا","https://www.aldiwan.net/poem43091.html","الكامل"],[50,"هل مخطئ حتفه عفر بشاهقة","https://www.aldiwan.net/poem64454.html","البسيط"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[92,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[147,"أما الفراق فقد عاصيته فأبى","https://www.aldiwan.net/poem11718.html","البسيط"],[173,"يا باكياً لدمنة وأربع","https://www.aldiwan.net/poem1635.html",""],[190,"وغائب كنت مهموما بغيبته","https://www.aldiwan.net/poem43838.html","البسيط"],[208,"وشادن مختصر الخصر","https://www.aldiwan.net/poem53286.html","السريع"],[234,"الحر لا يأتي الدنيه","https://www.aldiwan.net/poem50732.html","مجزوء الكامل"],[261,"والله أهل الحمد والشكر","https://www.aldiwan.net/poem48558.html","السريع"],[276,"خل الغرام لصب دمعه دمه","https://www.aldiwan.net/poem52119.html","البسيط"],[287,"أنى اهتدى طيف الحبيب لمرقدي","https://www.aldiwan.net/poem32794.html","الكامل"],[302,"لولا ازديارك في الكرى وهنا","https://www.aldiwan.net/poem33143.html","أحذ الكامل"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[347,"يوم الهوان وصيحة المرتاب","https://www.aldiwan.net/poem55365.html","الكامل"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[355,"أعرفت رسم الدار بالحبس","https://www.aldiwan.net/poem640.html",""],[369,"أوجست من جمر بخدك ساطع","https://www.aldiwan.net/poem60852.html","الكامل"],[408,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[438,"أرح المطية برهة يا حادي","https://www.aldiwan.net/poem12596.html","الكامل"],[466,"كبت جفان الحي من دارم","https://www.aldiwan.net/poem15098.html","السريع"],[520,"قد كان حبي محض","https://www.aldiwan.net/poem12302.html","المجتث"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138422",""],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97012","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34410","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64172","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61178","السريع"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111173","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46518","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49995","المنسرح"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48953","الكامل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126650","البسيط"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45451","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53195","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27578","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/61013","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93668","الرجز"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106985","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137181",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87343","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100907","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205806","الكامل"],[2840,"","https://poetry.dctabudhabi.ae/diwan/poem/101887","البسيط"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9609","الكامل"],[2961,"","https://poetry.dctabudhabi.ae/diwan/poem/111550","السريع"],[2973,"","https://poetry.dctabudhabi.ae/diwan/poem/107018","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132771","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132567","البسيط"],[3235,"","https://poetry.dctabudhabi.ae/diwan/poem/111107","الكامل"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105622","الرجز"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71334","الكامل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139966","الكامل"],[3420,"","https://poetry.dctabudhabi.ae/diwan/poem/177881","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52989","البسيط"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61261","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36733","الرجز"],[3763,"","https://poetry.dctabudhabi.ae/diwan/poem/124158","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86435","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91046","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90874","الكامل"],[4221,"","https://poetry.dctabudhabi.ae/diwan/poem/132504","البسيط"],[4767,"باب الحوائج","https://www.poetsgate.com/ViewPoem.aspx?id=179962",""],[4767,"معركة الحق","https://www.poetsgate.com/ViewPoem.aspx?id=184948",""],[4767,"زينة الكون","https://www.poetsgate.com/ViewPoem.aspx?id=212573",""],[4984,"هي القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=175730",""],[5147,"سر الهوى العذري مودع","https://www.poetsgate.com/ViewPoem.aspx?id=166721",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5184,"غرباء","https://www.poetsgate.com/ViewPoem.aspx?id=186054",""],[5213,"اخوان صدق خلتهم","https://www.poetsgate.com/ViewPoem.aspx?id=170517",""],[5493,"من وحيِ القرنفل","https://www.poetsgate.com/ViewPoem.aspx?id=197043",""],[5783,"لم تعقمي يا أمة الأحرار","https://www.poetsgate.com/ViewPoem.aspx?id=34050",""],[5795,"تبارك البارئ مبدع ألوى","https://www.poetsgate.com/ViewPoem.aspx?id=167913",""],[5829,"تحية الى اهل العلم","https://www.poetsgate.com/ViewPoem.aspx?id=159310",""],[5845,"خلِّ الغرامَ يصبٍّ دمعهُ دمهُ","https://www.poetsgate.com/ViewPoem.aspx?id=198429",""],[6045,"أملٌ ممتنع !","https://www.poetsgate.com/ViewPoem.aspx?id=125350",""],[6127,"عذبٌ لَمَاك","https://www.poetsgate.com/ViewPoem.aspx?id=188486",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""],[5724,"بيارق النصر رفي فوق وادينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55137&r=&rc=4",""],[5075,"ماذا جنى الأحرار ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82761&r=&rc=7",""],[6225,"اليقين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81036&r=&rc=273",""]],"verses":[["حَتّى إِذا جَلّى الظُنونَ يَقينُهُ","صَدَعَ القُلوبَ وَأَسقَطَ الأَحمالا",0,"ل",2,0],["حَتّى إِذا جَعَلَتهُ بَينَ أَظهُرِها","مِن عُجَمةِ الرَملِ أَثباجٌ لها حِبَب",1,"ب",1,0],["حتى إذا جحد الذي أَوْلَيْته","لم تُبق منه الحادثات ولم تذَرْ",2,"ر",1,0],["حَتّى إِذا جَدَّلَهُ كَالعَندَلِ","أَيقَنتُ أَنَّ العَظمَ غَيرُ الفَصلِ",3,"ل",1,0],["حتى إذا جاءت صواعقُ رعبهِ","أضحى جميع نباتها عنّابا",4,"ب",2,0],["حَتّى إِذا جُزتُ كُلَّ حَدٍّ","في فَلَواتِ الدُنُوِّ أَهمي",5,"م",2,0],["حتى إذا جاء بها فلتةً","نكَّسَ من سَوْءتها الراسا",6,"س",2,0],["حَتّى إِذا جَزَرَت مِياهُ رُزونِهِ","وَبِأَيِّ حينِ مِلاوَةٍ تَتَقَطَّعُ",7,"ع",1,0],["حَتّى إِذا جاءَ المُروضُ وَاِعتَلى","مَتنَيهِ رابَ الفارِسُ الكَشحانِ",8,"ن",1,0],["حَتّى إِذا جُمِعَت تُخَيِّرَ طِرقُها","وَثَنى الرِعاءُ شَكيرَها المَنخولا",9,"ل",2,0],["حتى اذا جاؤا بنعشك احشدت","امم من الانحاء ملء الساح",10,"ح",1,0],["حتى اذا جاش الشعو","ر مثلته الكلم",11,"م",1,0],["حَتّى إِذا جِئتَ الأَنا","مَ بِأَهلِ حِكمَتِهِ أَطاعَك",12,"ك",1,0],["حَتّى إِذا جاءَت بِهِ","جاسَت خِلالَ الأَدوِرَه",13,"ر",2,0],["حَتّى إِذا جَنَّ داجي اللَيلِ هَيَّجَها","ثَبتُ الخَبارِ وَثَوبٌ لِلجَراثيمِ",14,"م",1,0],["حَتّى إِذا جُرَّدَت في الرَوعِ أَغمَدَها","في كُلِّ سابِغَةٍ مَسرودَةِ الحَلَقِ",15,"ق",1,0],["حَتّى إِذا جَمَحوا هَتَكتَ بُيوتَهُم","بِاللَهِ ثُمَّ الثامِنِ المَعصومِ",16,"م",1,0],["حَتّى إِذا جَسَروا بِصارِعِ كُلَّها","وَبَدا لَهُم مِنها طَريقٌ مَهيَعُ",17,"ع",1,0],["حَتّى إِذا جَمَعَ القَياصِرَ مَوعِدٌ","بَعَثَ الإِلَهُ قَضاءَهُ فَاِنسابا",18,"ب",2,0],["حَتّى إِذا جَعَلَ الإِظلامُ يَعرِضُهُ","شَمائِلاً وَرَأى لِلصُبحِ إيلاقا",19,"ق",2,0],["حتى إذا جَاسُوا خلالَ دورِها","وأَسرع الخرابُ في مَعْمورها",20,"ه",2,0],["حتى إذا جَدَّتْ وغىً وتضرَّمَتْ","نارٌ تلُفُّ أباعِداً وأقارِبا",21,"ب",2,0],["حَتّى إِذا جاءَتِ البُشرى بِصِحَّتِهِ","قَضَت بِتَسكينِ قَلبٍ طالَما وَجَبا",22,"ب",2,0],["حَتّى إِذا جِئتُ لِما يُصلِحُكُم","مِن إِرثِ جَدّي وَذرَارِيهِ مَعي",23,"ع",2,0],["حتى إذا جاء أدنى الناس كلهم","غيري وأني ما أصبحت من وطره",24,"ر",2,0],["حتّى إذا جاوَزَ ميعادنا","والدمع يجري حذرَ الفَجرِ",25,"ر",1,0],["حتّى إذا جاءوا يزِي","دَ بهنّ واحتَضَروا نَديّه",26,"ي",2,0],["حتى إذا جئتك سلمتها","بذلك الإحصا إلى جحري",27,"ر",2,0],["حَتّى إِذا جاءَ بالتَنزيل معجزة","يَمحوا الشَرائِع وَالأَحكام تحكمه",28,"م",2,0],["حَتّى إِذا جارَ الخَيالُ كَأَنَّما","أَولاهُ سَلَّةَ بَعضِ سَيفٍ مُغمَدِ",29,"د",1,0],["حتّى إِذا جدَّ الرَحيلُ بها","بلَّت سجالُ دموعِها الرُدنا",30,"ن",2,0],["حَتّى إِذا جلَتِ الحقائقُ بان حك","مُ القَبضتَينِ فغانمٌ ومضيّعُ",31,"ع",1,0],["حتى إذا جد الزمان وامل","الاعراب بالاسلاب من سلاب",32,"ب",1,0],["حَتّى إِذا جازَ بِظُلمِ نَفسِهِ","قالَ عَلى الجَورِ إِلى العَدلِ جَبَر",33,"ر",1,0],["حَتّى إِذا جَنَّ الظَلامُ له","راحَت عليهِ بوابلٍ رجسِ",34,"س",1,0],["حتّى إذا جَدَّ الوداعُ وبيننا","سِرٌّ إلى الواشينَ ليس بذائع",35,"ع",1,0],["حتّى إذا جرَّعتهم كأسَ الرَّدى","قتلاً وأفْنَيتَ العديدَ الأكثرا",36,"ر",2,0],["حتى إذا جنّ الظلامُ وبحْتَ في","أسدافِه كالكوكبِ الوقّادِ",37,"د",1,0],["حتى إذا جُبْنَ بنا قسطلاً","من طائرٍ عنا ومن جاثم",38,"م",1,0],["حتى إذا جمحا لي","وحان وقت الطعان",39,"ن",1,0],["حتى إذا جاءه الايسار فاجأه","داء المشيب وكان الحين قد آنا",40,"ن",2,0],["حتى إذا جئنا رفيع جنابه","سقطت كما تتساقط الأوراق",41,"ق",1,0],["حَتّى إِذا جاء المَعالي كفؤُها","خضعت لَهُ مِن بعد فرط شِماسِ",42,"س",1,0],["حتى إذا جَزْرُ الفرا","تِ مضى وأعقبه بمد",43,"د",1,0],["حَتّى إِذا جاءَت بِمثل المهى","خَرائِداً نَعرف مِقدارَها",44,"ر",3,0],["حتى إذا جاءهم خانوا به","اختلفوا على الخلاف فرقا",45,"ق",2,0],["حَتّى إِذا جَفَ عَلَيهِ الطين","وَجسمه في جَوفِهِ دَفين",46,"ن",1,0],["حَتَّى إِذا جاءَ بِهِ إِلَيهم","أَلقاه مِن أَنيابِهِ لَدَيهِم",47,"م",1,0],["حتى إذا جَدَّة الصِّبى بليت","واعتيضَ منها مُلاءةٍ خَلَقُ",48,"ق",1,0],["حتى إذا جاد الإله بنظرة","بَكرَ الفلاح مُصلِّياً ومسلِّما",49,"م",2,0],["حتى إذا جئتكم ألفيت طائفة","أدهى وأخبث من كل الشياطين",50,"ن",1,0],["حَتّى إِذا جَنَّ أَغواءُ الظَلامِ لَهُ","مِن فَوزِ نَجمٍ مِنَ الجَوزاءِ مُلتَهِبِ",51,"ب",1,0],["حتى إذا جاذبت أصداغه","للثمة صارت لفيه لثامْ",52,"م",1,0],["حتى إذا جاء يومَ الحشرِ موقفنا","الخوفُ يبهمه والوزنُ يوضحه",53,"ح",2,0],["حتى إذا جئت المكان المنتهى","وبلغت سدرته وطابَ لك السفر",54,"ر",1,0],["حَتّى إِذا جاءَت حِماك وَاحتَوَت","عَلى رباك أَسبلت أَوداقَها",55,"ق",3,0],["حتى اذا جاء فيه كسر","والفتح فيه رأيت نصره",56,"ر",2,0],["حتى اذا جربته الفيته","لم يرع حادث ذمتي وقديمي",57,"م",2,0],["حتَّى إذا جيتَ يوماً أرضَ سَوقَرة