{"poems":[[55,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[10,"ألا ابكي على صخر وصخر ثمالنا","https://www.aldiwan.net/poem21099.html","الطويل"],[95,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[56,"بليت بزمردة كالعصا","https://www.aldiwan.net/poem27349.html","المتقارب"],[72,"أياديك عندي لا يغب سجامها","https://www.aldiwan.net/poem42724.html","الطويل"],[30,"ولم يك دون الحكم مال ولم تكن","https://www.aldiwan.net/poem5317.html","الطويل"],[82,"وقد تشق بنا الأهوال جارية","https://www.aldiwan.net/poem31376.html","البسيط"],[82,"ومن سفن القفر سباحة","https://www.aldiwan.net/poem31398.html","المتقارب"],[42,"أرقت بسلع إن ذا الشوق يأرق","https://www.aldiwan.net/poem42338.html","الطويل"],[77,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[50,"ألا خذها كمصباح الظلام","https://www.aldiwan.net/poem65116.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[136,"طبتنا اليوم عن ذكرى سعاد","https://www.aldiwan.net/poem54849.html","الطويل"],[207,"لهاشم وزهير فرع مكرمة","https://www.aldiwan.net/poem68165.html","البسيط"],[228,"أتجهل قدر بشر إن بشرا","https://www.aldiwan.net/poem39691.html","الوافر"],[240,"ليهنك أن عيني ما تنام","https://www.aldiwan.net/poem31761.html","الوافر"],[280,"أبقت لصحوي من علاقتها نشوى","https://www.aldiwan.net/poem25453.html","الطويل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[350,"أمولى بني تيم ألست مؤديا","https://www.aldiwan.net/poem4476.html","الطويل"],[371,"متى بلغت مذ قط أرض إلى سما","https://www.aldiwan.net/poem17390.html","الطويل"],[376,"تولى بتهويمة الهائم","https://www.aldiwan.net/poem57151.html","المتقارب"],[376,"أصار يألف فيض الدمع مدمعه","https://www.aldiwan.net/poem57321.html","البسيط"],[376,"سل الظعن هل من نظرة تستزيدها","https://www.aldiwan.net/poem57501.html","الطويل"],[463,"أإن تحدث عصفور على فننِ","https://www.aldiwan.net/poem55829.html","البسيط"],[463,"من العار لولا أن طيفك يطرق","https://www.aldiwan.net/poem56098.html","الطويل"],[556,"أما آن للسلوان أن يردع الصبا","https://www.aldiwan.net/poem48083.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103074","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137613",""],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67835","الطويل"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75779","البسيط"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96579","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128716","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113934","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26411","المتقارب"],[1993,"","https://poetry.dctabudhabi.ae/diwan/poem/199033","الطويل"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199631","المسحوب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27458","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93686","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137028",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137267",""],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100883","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202012","السريع"],[3043,"","https://poetry.dctabudhabi.ae/diwan/poem/145488","الطويل"],[3048,"","https://poetry.dctabudhabi.ae/diwan/poem/100613","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26121","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126964","الوافر"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36768","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119711","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123516","الطويل"],[4325,"","https://poetry.dctabudhabi.ae/diwan/poem/29462","المتقارب"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133088","البسيط"],[5002,"سحابٌ وأمل ٌ","https://www.poetsgate.com/ViewPoem.aspx?id=206885",""],[5334,"لها شاسِع تحت الثياب كأنه","https://www.poetsgate.com/ViewPoem.aspx?id=96972",""],[5376,"بغداد إن ضحكت فيها نواجذها","https://www.poetsgate.com/ViewPoem.aspx?id=188304",""],[5431,"به بيت القصيد وهم ضيوفي","https://www.poetsgate.com/ViewPoem.aspx?id=195143",""],[5493,"طيفُ امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=205292",""]],"verses":[["لِهاشِمٍ غُرَرٌ تُلقى لِسائِلِها","طَلاعَةٌ مِن ثَنايا البَأسِ وَالكَرَمِ",0,"م",1,0],["لَها شَرَفاتٌ لا تُنالُ وَمَنكِبٌ","مَنيعُ الذَرى عالٍ عَلى مَن يُثيرُها",1,"ر",3,0],["لَهَا شَعَرٌ كَاللَّيْلِ يَجْلُو سَوَادَهُ","بَيَاضُ نَهَارٍ يَبْهَرُ المُتَوَسِّمَا",2,"م",2,0],["لَها شَعرُ قِردٍ إِذا اُزَّيَّنَت","وَوَجهٌ كَبَيضِ القَطا الأَبرَشِ",3,"ش",1,0],["لَها شَربَةٌ في كُلِّ يَومٍ عَلى الطَوى","وَلو تَرَكَتها صَحَّ مِنها صِيامُها",4,"م",3,0],["لَهُ أَشرَقَت أَرضُ العِراقِ لِنورِهِ","وَأومِنَ إِلّا ذَنبَهُ كُلُّ خائِفِ",5,"ف",1,0],["لها شراعٌ ترى الملّاحَ يلحَظُهُ","ككاهنٍ يقسِمُ الألحاظ في كَتِفِ",6,"ف",1,0],["لها شِرّةٌ لا تُبالي بها","أطالَ لها سبْسَبٌ أم عَرُض",7,"ض",1,0],["لَها شاهِدٌ مِن دَمعِها كُلَّما رَقا","جَرى شاهِدٌ مِن دَمعِها مُتَرَقرِقُ",8,"ق",1,0],["لها شُعَلٌ فوقَ الغِمارِ كأنّها","دِماءٌ تَلَقّتْها ملاحفُ سود",9,"د",1,0],["لَها شَكلُ الإِناثِ وَبَينَ بَينَ","تَرى فيها تَكاريهَ الغُلامِ",10,"م",1,0],["لَهَا شِرْعَةٌ فِي كُلِّ حَالٍ نَقِيَّةٌ","مَصَادِرُهَا مَحْمُودَةٌ وَالمَوَارِدُ",11,"د",1,0],["لَهَا شَمَّاسَةٌ كَيَدٍ أُضِيفَت","لأخرَى في إنفرَاجٍ وانعِقَادِ",12,"د",1,0],["لَهاشِمٍ وَزُهيرٍ فَرعُ مَكرُمَةٍ","بِحَيثُ لاحَت نُجومُ الفُرعِ وَالأَسَدِ",13,"د",1,1],["لَها شَعرٌ كَأَنَّ اللَيلَ مِنهُ","تَمَنّى البَدرُ فيهِ أَن يَمُرّا",14,"ر",2,0],["لَها شِيَمٌ يَفوحُ لَها أَريجٌ","كَما اِنفَتَقَت عَنِ الرَوضِ الكِمامُ",15,"م",1,0],["لَهَا شِيَةٌ مَا شِئت حُسْناً وَمِشْيَةً","تَبُذُّ الجِيادَ السَّابِقَاتِ بِهَا عَدْوَا",16,"و",2,0],["لها شُروطٌ عِدَّة","على الرَخا والشِدَّه",17,"ه",1,0],["لَها شَعَرٌ ضافٍ وَجيدٌ مُقَلِّصٌ","وَجِسمٌ زُخارِيُّ وَضِرسٌ مُجالِحُ",18,"ح",1,0],["لَها شَبَقٌ في رَأسِ كُلِّ مُؤَنَّثِ","فَلا كَفَّ حَتّى يُخضَبَ الكَفُّ بِالدِما",19,"م",2,0],["لَها شُعَبٌ في بَني مُرَّةٍ","يَقومُ بِحقِّهمُ اللازِمِ",20,"م",1,0],["لهاشمٍ في النَّدى سَبقُ الرهانِ كَما","للناصِح بن عليٍّ مِنهُ أسرعُهُ",21,"ع",2,0],["لها شفَةٌ تشكو برقَّتها الصدى","وحمرتها تنبيكَ كيفَ ورودُها",22,"د",3,0],["لها شبابُ الهوى منّي ونضرتُه","والشيبُ إن كان عارا فهْو يلزمُني",23,"ن",2,0],["لها شافعٌ عند القلوب بأحمرٍ","حكى دمَها تحنو عليه وتُشفِقُ",24,"ق",1,0],["لَها شَفرة لا يَكْهَمُ الدّهرُ غربها","وَلَن تَترك الأيامُ في شفرةٍ غَرْبا",25,"ب",2,0],["لها شهوة من حظها ثم علة","دسائسها غلول مغانمها غُرم",26,"م",1,0],["لها شركات بأسلاكها","مدين قد اتصلت بمدين",27,"ن",1,0],["لَهُ أَشْرَقَتْ أَنْوَارُهُمْ وَتَجَلَّتِ","صَنَائِعُهُ تُرْجى لأُمَّتِهِ الَّتي",28,"ي",1,0],["لَها شهاب مِن الماء الزلال له","كِسف تساقطَ بين الماء وَالنار",29,"ر",1,0],["لها شِرَةٌ تَأتالها بعد شِرَّةٍ","وعَقبٌ كعقبِ الريحِ ما لم تَنَزَّلِ",30,"ل",1,0],["لها شرر كالقصر ترمي به العدا","إذا قدحت في الهام تلك المناصل",31,"ل",1,0],["لها شَرَباتٌ قد نَصَفنَ جُذوعَها","رواءُ الأعالي حملُها غيرُ مخدَجِ",32,"ج",1,0],["لَها شُرُفاتٌ كَأَنَّ الرَبيعَ","كَساها الرِياضَ بِأَنوارِها",33,"ر",3,0],["لها شرر لو طار عن قبساتها","لكادت لها تحكي الجمال البوازل",34,"ل",1,0],["له اشاف ذوابل والمباسم والشنب","تحت قوس الحواجب سل طرف الحسام",35,"م",1,0],["لها شطر من الفَلَكِ ال","ذي تبدي ضنائنها",36,"ن",3,0],["لَها شغف يَوماً وَيَوماً مَلالة","فَلا صَدها عَني يَدوم وَلا الوَصل",37,"ل",1,0],["لها شيم يفوح لها اريج","ووجه يشبه البدر التماما",38,"م",2,0],["لهاشيم تفوق المسك طيباً","وانفاس كأنفاس الخزامى",39,"م",2,0],["لها شَغَلٌ به عنها وكم من","عدوٍّ يُصلح المتخاصمينا",40,"ن",2,0],["لها شمٍ ينمى وأخلاقُه","تمنع أن ينمى الى آدم",41,"م",1,1],["لها شرر مثل النجوم تطايرت","فمرت دنانيراً وجاءت دراهما",42,"م",2,1],["لها شرف عالٍ على كل بقعةٍ","فليس لها إلا الحجاز نظير",43,"ر",1,0],["لَها شَجَنٌ ما قَد أَتى اليَأسُ دونَهُ","مِنَ الحاجِ وَالأَهواءُ جَمٌّ شجونُها",44,"ن",3,0],["لهاشم قد طوت أعلام عز","وكانت قبل خافقة البنود",45,"د",1,0],["لَها شَرَفٌ فَوقَ الثَوابِتِ ثابِتٌ","وَنور عُلاه في البَسيطة واقِعُ",46,"ع",1,0],["لها شَعَرٌ تصحيفه حلّ مهجتي","كذا قلبه في جثّتي آية تتلى",47,"ل",2,0],["له أشتكى من عصبة عصبية","بها الحول أضحى كاصطبارى أمحقا",48,"ق",2,0],["لَها شُعَبٌ كإِيادِ الغَبِيطِ","فَضَّضَ عَنها البُنَاةُ الشِجَارا",49,"ر",2,0],["له اشتغالٌ بحفظ السر عن دخلٍ","ليث النزال إذا ما عارك الرقبا",50,"ب",2,0],["لها شدوُها والأنينُ مقيمٌ","ويبقَى الَّسَّعيدُ يُعزِّي الحَيارى",51,"ر",2,0],["لها شاسِع تحت الثياب كأنه","قَفا الديك أوفَي عُرفُه ثم طرَّبا",52,"ب",2,1],["لها شموخٌ على الدنيا اذا بقيتْ","تعلو بأمجادِها بالعزِّ أمجادُ",53,"د",1,0],["له أشجار شعري مورقات","به بيت القصيد وهم ضيوفي",54,"ف",2,0],["لها شجرٌ يُميلُ الغصنَ كيْ لَا","تصيبَ الريحُ بالأرْزاءِ جِذعَا",55,"ع",2,0]]}