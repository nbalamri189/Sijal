{"poems":[[53,"أراعي بلوغ الشيب والشيب دائيا","https://www.aldiwan.net/poem29567.html","الطويل"],[53,"تطاط لها فيوشك أن تجلى","https://www.aldiwan.net/poem29856.html","الوافر"],[53,"تمنى رجال نيلها وهي شامس","https://www.aldiwan.net/poem30198.html","الطويل"],[53,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[53,"عجبت من الأيام إنجازها وعدي","https://www.aldiwan.net/poem30624.html","الطويل"],[53,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[53,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[3,"رمت الفؤاد مليحة عذراء","https://www.aldiwan.net/poem121.html",""],[77,"ما لليراع خواضع الأعناق","https://www.aldiwan.net/poem35907.html","الكامل"],[77,"أخذت وأمواج الردى متلاطمة","https://www.aldiwan.net/poem36100.html","الطويل"],[77,"سلو عن فؤادي بعدكم كيف حاله","https://www.aldiwan.net/poem36368.html","الطويل"],[77,"هلم فما بيني وبينك ثالث","https://www.aldiwan.net/poem36673.html","الطويل"],[9,"صحا القلب من ذكرى قتيلة بعدما","https://www.aldiwan.net/poem21967.html","الطويل"],[73,"أما في نسيم الريح عرف معرف","https://www.aldiwan.net/poem11914.html","الطويل"],[73,"أجل إن ليلى حيث أحياؤها الأسد","https://www.aldiwan.net/poem11946.html","الطويل"],[93,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[88,"تريد لي الأيام أن أتقيد","https://www.aldiwan.net/poem45016.html","الطويل"],[23,"إن الذوائب من فهر وإخوتهم","https://www.aldiwan.net/poem21254.html","البسيط"],[72,"لتهن عين إلى مراك قد طمحت","https://www.aldiwan.net/poem18476.html","البسيط"],[72,"قدمت كالسيف إلى غمده","https://www.aldiwan.net/poem18559.html","السريع"],[72,"تجلى فقلت البدر والليل شعره","https://www.aldiwan.net/poem18708.html","الطويل"],[72,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[72,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[72,"يحير الغصن بين اللين والهيف","https://www.aldiwan.net/poem19267.html","البسيط"],[72,"دعوني لذكرى حسنه أقتضي العذلا","https://www.aldiwan.net/poem20545.html","الطويل"],[51,"نظرت إلى الرغيف فرد روحي","https://www.aldiwan.net/poem64959.html","الطويل"],[51,"غدا الدهر مفترا أغر المضاحك","https://www.aldiwan.net/poem65812.html","الطويل"],[51,"عزمت على تطليق عرسي لعسرتي","https://www.aldiwan.net/poem66518.html","الطويل"],[51,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[91,"ليس يدري الهم غير المبتلي","https://www.aldiwan.net/poem9064.html","عموديه"],[70,"وعد الزيارة طرفه المتملق","https://www.aldiwan.net/poem42802.html","الكامل"],[78,"لك الحمد من بعد السيوف كبول","https://www.aldiwan.net/poem14222.html","الطويل"],[89,"افتحوا للفتى الهضيم الطريقا","https://www.aldiwan.net/poem44844.html","الخفيف"],[89,"سجن بغداد في الحقيقة قبر","https://www.aldiwan.net/poem44949.html","الخفيف"],[85,"خفضت لعزة الموت اليراعا","https://www.aldiwan.net/poem62859.html","الوافر"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[43,"فراق ومن فارقت غير مذمم","https://www.aldiwan.net/poem10570.html","الطويل"],[62,"لك الله هل عهد الشبيبة يرجع","https://www.aldiwan.net/poem52358.html","الطويل"],[45,"كم ليلة فيك بت أسهرها","https://www.aldiwan.net/poem63639.html","المنسرح"],[61,"مرضت جفونك والحتوف شعارها","https://www.aldiwan.net/poem51680.html","الكامل"],[66,"سفح المزاج على حميا الكاس","https://www.aldiwan.net/poem38490.html","الكامل"],[97,"قدم لبسيوني قريضك واعتذر","https://www.aldiwan.net/poem24384.html","الكامل"],[44,"أي رأي وأي عقل صحيح","https://www.aldiwan.net/poem30056.html","الخفيف"],[44,"قمر تبسم عن جمان نابت","https://www.aldiwan.net/poem30272.html","الكامل"],[44,"بذ الجلاد فهو دفين","https://www.aldiwan.net/poem30335.html","الرجز"],[87,"تصابيت بعد الحلم واعتادني زهوي","https://www.aldiwan.net/poem8193.html","الطويل"],[69,"سجادة أذكرتني","https://www.aldiwan.net/poem28984.html","المجتث"],[74,"سجعت وقد غنى الحمام فرجعا","https://www.aldiwan.net/poem13173.html","الطويل"],[33,"وأجهشت للتوباد حين رأيته","https://www.aldiwan.net/poem25776.html","الطويل"],[105,"من هيبة يغضي القريض ويطرق","https://www.aldiwan.net/poem42076.html","الكامل"],[105,"جددوا الذكرى لأهل المشرق","https://www.aldiwan.net/poem42122.html","الرمل"],[105,"لواء الله بورك من لواء","https://www.aldiwan.net/poem42133.html","الوافر"],[105,"الله أكبر باسم الله أهديها","https://www.aldiwan.net/poem43131.html","البسيط"],[105,"أمن صلف صدودك أم دلال","https://www.aldiwan.net/poem43412.html","الطويل"],[105,"جاء الرسول كتابه بيمينه","https://www.aldiwan.net/poem44005.html","الكامل"],[105,"أجيبي أم كلثوم أجيبي","https://www.aldiwan.net/poem44064.html","الوافر"],[105,"سيد الرسل وأم المؤمنين","https://www.aldiwan.net/poem44196.html","الرمل"],[75,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[48,"كنت من الحب في ذرى نيق","https://www.aldiwan.net/poem64447.html","المنسرح"],[48,"عجزت يا مهجور أن تذهلا","https://www.aldiwan.net/poem64974.html","السريع"],[48,"سجد الجمال لحسن وجهك","https://www.aldiwan.net/poem65001.html","مجزوء الكامل"],[46,"سجايا كلها غدر وخبث","https://www.aldiwan.net/poem22838.html","الوافر"],[15,"لمن الديار ببرقة الروحان","https://www.aldiwan.net/poem45136.html","الكامل"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49149","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85582","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85578","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85378","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202699","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202649","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42697","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42600","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42573","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55019","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55160","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54928","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54933","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43733","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43855","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54248","البسيط"],[106,"فقيد الفصحى!","https://www.poetsgate.com/ViewPoem.aspx?id=179487",""],[106,"استعطاف وتبرئة","https://www.poetsgate.com/ViewPoem.aspx?id=179393",""],[90,"يراع المجد","https://www.poetsgate.com/ViewPoem.aspx?id=179189",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"الليل والشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=178930",""],[90,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[51,"سجايا إذا هَمَّت بخيرٍ تَسرَّعَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=27137",""]],"verses":[["سَجِيَّةُ مَضّاءٍ عَلى ما يُريدُهُ","مُقِضٍّ عَلى الأَيّامِ ما كانَ قاضِيا",0,"ي",2,0],["سَجِيَّةُ مُستَميتٍ لا يُبالي","مِنَ العَليا يُعَطَّلُ أَم يُحَلّى",1,"ل",2,0],["سَجِيَّةُ بَسّامٍ يَقولُ عَدُوُّهُ","أَهَذا الَّذي يَلقى الوَغى وَهوَ عابِسُ",2,"س",1,0],["سَجِيَّةٌ مِن بَطَلٍ","لازَمَ ما تَعَوَّدا",3,"د",2,0],["سَجايا رَعَينَ المَجدَ في تَلَعاتِهِ","وَناقَلنَ في العَلياءِ غَوراً إِلى نَجدِ",4,"د",1,0],["سَجِيَّةٌ لَكَ فاتَت كُلَّ مَنزِلَةٍ","وَضَعضَعَت جَنَباتِ الحادِثِ الأَشِبِ",5,"ب",1,0],["سَجيَّةُ مَن رَعى الأَيّامَ حَتّى","أَشابَ جَماجِماً مِنها وَشابا",6,"ب",2,0],["سَجَدَت تُعَظِّمُ رَبَّها فَتَمايَلَت","لِجَلالِها أَربابُنا العُظَماءُ",7,"ا",2,0],["سجَعَتْ بِما طوّقْتَها منْ مِنّةٍ","حتّى زَرَتْ بحَمائِمِ الأطْواقِ",8,"ق",1,0],["سَجَايَاكَ تَقْضِي أَنَّكَ ابْنُ مُحَمَّدٍ","أَيُجْحَدُ حَقٌّ وَالشَّهَادَةُ قَائِمَهْ",9,"م",2,0],["سَجِيَّةُ آبَاءٍ كِرَامٍ وَرِثْتُهَا","بِحَقٍّ وَيَبْنِي الْمَجْدَ لِلْمَرْءِ آلُهُ",10,"ل",2,0],["سَجاياهُ تَرْوي منْ حَديثِ كَمالِهِ","صَحائِفَ فيها للعَلاءِ مَباحِثُ",11,"ث",1,0],["سَجُوّينَ بَرجاوَينِ في حُسنِ حاجِبٍ","وَخَدٍّ أَسيلٍ واضِحٍ مُتَهَلِّلِ",12,"ل",1,0],["سَجايا لِمَن والاهُ كَالأَريِ تُجتَنى","تَعودُ لِمَن عاداهُ كَالشَريِ يُنقَفُ",13,"ف",1,0],["سَجِيَّتُهُ الحُسنى وَشيمَتُهُ الرِضى","وَسيرَتُهُ المُثلى وَمَذهَبُهُ القَصدُ",14,"د",1,0],["سَجِيَّةُ العَرَبِيِّ الهَاشِمِيِّ لَهَا","مَعْنَى وَرَاءَ مَعَانِي الجَاهِ وَالرُّتَبِ",15,"ب",1,0],["سَجَا الحُسَيْنُ وَقَدْ وَرَّى مُسَاجِلَهُ","حَتّى يَئِينَ أَوَانُ الصَّائِدِ الدَّرِبِ",15,"ب",1,0],["سُجُودُ مَا كَانَ مَسْجُوداً لَهُ عِظَةٌ","فِي نَفْسِ كُلِّ لبِيبٍ ذَاتِ أَشْجَانِ",16,"ن",1,0],["سجَّية نفس لم أحُل عن عهودها","وأن لامني الأعمى عليها وفنّدا",17,"د",2,0],["سَجِيَّةٌ تِلكَ مِنهُم غَيرُ مُحدَثَةٍ","إِنَّ الخَلائِقَ حَقّاً شَرُّها البِدَعُ",18,"ع",1,0],["سجية في بني أيوب قد نفرت","وبين آل تقيّ الدين قد رجحت",19,"ت",1,0],["سجاهُ حبّ العفوِ حتَّى لقد","كادَ الفتى يذنب عن عمده",20,"د",2,0],["سجاياه لا زَهر الرِّياض وعرفها","وجدواه لا ظلّ الغمام وقطره",21,"ر",2,0],["سجية سابق الطلبات سامٍ","يظلّ على معاركة الأمور",22,"ر",1,0],["سجعت لك المداح في طرق الهدى","والمكرمات ومن تطوّق يسجع",23,"ع",1,0],["سجية في اقتضاء الحمد ناشئةٌ","على الندى والسدى والمجد والشرف",24,"ف",1,0],["سجيَّة آباءٍ كرمٍ ورثتها","وفقه عفاف يجمع الفرع والأصلا",25,"ل",2,0],["سجيتُهُ طِوال الدهر قبضٌ","وكلُّ سجيَّةٍ بسطٌ وقبضُ",26,"ض",1,0],["سجايا أبت إلا انتصافاً لجارِها","من الدهر إما عضَّ رحْلٌ بِحارك",27,"ك",1,0],["سجايا إذا هَمَّتْ بِخَيرٍ تَسَرَّعَتْ","إليه وإن هَمَّتْ بسوءٍ تأنَّتِ",28,"ت",1,0],["سَجَدُوا ولو عَنَدُوا مكانَ سجودهمْ","لرَماهُمُ مِنْ كيدهِ بدواهي",29,"ه",2,0],["سَجَّلَ العارَ عَلَينا مَعشَرٌ","سَجَّلوا المَرأَةَ بَينَ الهَمَلِ",30,"ل",1,0],["سَجَدَت لَهُ حَتّى العُيونُ مَهابَةً","أَوَما تَراها حينَ يُقبِلُ تُطرِقُ",31,"ق",1,0],["سُجودٌ عَلى إِثرِ الرُكوعِ مُتابَعٌ","هُناكَ بِأَرواحِ الكُماةِ تَسيلُ",32,"ل",1,0],["سجل الدهر في كتاب لديه","نسباً لي في الهالكين عريقا",33,"ق",2,0],["سجن بغداد في الحقيقة قبرٌ","موحش فيه تدفن الأحياءُ",34,"ا",2,1],["سَجَنَّ مُهَنَّداً وَنَفَينَ تِبراً","وَزِدنَ المِسكَ مِن ضَغطٍ فَضاعا",35,"ع",2,0],["سَجَدوا لِمَخلوقٍ وَظَنّوا خالِقاً","مَن ذا يُمَيِّزُ في الظَلامِ وَيَفرُقُ",36,"ق",1,0],["سَجَدَت مِصرُ في الزَمانِ لِإيزي","سَ النَدى مَن لَها اليَدُ البَيضاءُ",37,"ا",2,0],["سَجِيَّةُ نَفسٍ ما تَزالُ مُليحَةً","مِنَ الضَيمِ مَرمِيّاً بِها كُلُّ مَخرَمِ",38,"م",1,0],["سجيةُ مطبوعٍ على الحمدِ خِيمُهُ","إِذا شانَ أخلاقَ الرجالِ التطبّعُ",39,"ع",1,0],["سَجِيَّةٌ مِنهُ ما يُبَدِّلُها","وَسُنَّةٌ مِنهُ ما يُغَيِّرُها",40,"ر",3,0],["سجَرَتْ بحارُهُمُ دماً فَتَيَقَّنَتْ","أَنَّ الأُسودَ عرينُها سِنْجارُها",41,"ر",3,0],["سَجَعَت فَخِلنا الطَوقَ في أَعناقِها","مِنَنُ اِبنِ أُرتُقَ في رِقابِ الناسِ",42,"س",1,0],["سجد الربيعُ مكبراً لجلاله","وتلفَّتَ الوادي بخضرِ هضابِهِ",43,"ب",2,0],["سَجَرَت كَفُّهُ بُحورَ القَوافي","لَكَ عِندَ التَعريضِ وَالتَصريحِ",44,"ح",1,0],["سَجَدَ الجَمالُ لِوَجهِهِ لَمّا رَأى","دَهَشَ العُقولِ لِحُسنِهِ المُتَفاوِتِ",45,"ت",1,0],["سَجَنَت تَجارِبُهُ فُضولَ عُرامِهِ","إِنَّ التَجارِبَ لِلعُقولِ سُجونُ",46,"ن",1,0],["سَجِيَّةُ نَفْسٍ أَدْرَكَتْ مَا تُرِيدُهُ","مِنَ الدَّهْرِ فَاعْتَاضَتْ عَنِ السُّكْرِ بِالصَّحْوِ",47,"و",1,0],["سجادةٌ أذكرتني","منكَ الذي كنتُ أعلمْ",48,"م",1,1],["سَجَعتُ وَقَد غَنّى الحَمامُ فَرَجَّعا","وَما كُنتُ لَولا أَن يُغَنّي لَأَسجَعا",49,"ع",2,1],["سِجالاً وَتَهتاناً وَوَبلاً وَديمَةً","وَسَحّاً وَتَسجاماً إِلى هَمَلانِ",50,"ن",1,0],["سَجَدوا لما صَنعوا فأين حُلومُهم","ولِمَنْ جِباةٌ بالمهانةِ تُلصَقُ",51,"ق",1,0],["سجنوا الدُّستورَ طفلاً ناعماً","واستبدّوا بالسّجين الموثَقِ",52,"ق",1,0],["سَجِيَّتُنا وسنّةُ مَن ورِثنا","من السَّلفِ المُقدّمِ في السَّناءِ",53,"ا",2,0],["سَجِيَّةٌ لِبَني التاميزِ نَعرِفُها","وَخِدعَةٌ لَم تَغِب عَنّا مَراميها",54,"ي",3,0],["سَجِيَّةُ هَذِهِ الدُنيا وَخُلقٌ","تُريناهُ تَصاريفُ اللَيالي",55,"ي",1,0],["سجنوه حين رَأوْهُ يُطلِقُ نفسَهُ","في المعشرِ الطُلَقاءِ من سِجنِ الهَوى",56,"ه",3,0],["سَجِيَّتُكَ الوفاءُ وما عَلِمْنا","عليكَ الدَّهْرَ من خُلُقٍ مَ