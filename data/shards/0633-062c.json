l","الطويل"],[516,"مآثر لو تركنا شرح جملتها","https://www.aldiwan.net/poem12236.html","البسيط"],[539,"سجنت نفسي بيدي","https://www.aldiwan.net/poem47500.html","عموديه"],[539,"يا رعى الله إخوة كتبوا لي","https://www.aldiwan.net/poem47596.html","عموديه"],[539,"من كان ينوي فيك مصر بأنه","https://www.aldiwan.net/poem48210.html","عموديه"],[539,"السحر هذا ما أرى","https://www.aldiwan.net/poem48280.html","عموديه"],[545,"غراب على شجرة الميلاد","https://www.aldiwan.net/poem67243.html","عموديه"],[552,"قربا مني القلاص العتاقا","https://www.aldiwan.net/poem47367.html","المديد"],[559,"إذا كان كلي دائما يشبه البرقا","https://www.aldiwan.net/poem34320.html","الطويل"],[559,"يا نسبة أدخلت سلمان في النسب","https://www.aldiwan.net/poem34930.html","البسيط"],[559,"صريح كلامي في الوجود وإيمائي","https://www.aldiwan.net/poem35088.html","الطويل"],[563,"سلام الله أيتها القباب","https://www.aldiwan.net/poem52930.html","الوافر"],[564,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[568,"سجاياك من طيب أعراقها","https://www.aldiwan.net/poem69568.html","المتقارب"],[576,"سجا ليل همي بالعذار الذي سجا","https://www.aldiwan.net/poem3092.html","الطويل"]],"verses":[["سَجِيَّةُ مَضّاءٍ عَلى ما يُريدُهُ","مُقِضٍّ عَلى الأَيّامِ ما كانَ قاضِيا",0,"ي",2,0],["سَجِيَّةُ مُستَميتٍ لا يُبالي","مِنَ العَليا يُعَطَّلُ أَم يُحَلّى",1,"ل",2,0],["سَجِيَّةُ بَسّامٍ يَقولُ عَدُوُّهُ","أَهَذا الَّذي يَلقى الوَغى وَهوَ عابِسُ",2,"س",1,0],["سَجِيَّةٌ مِن بَطَلٍ","لازَمَ ما تَعَوَّدا",3,"د",2,0],["سَجايا رَعَينَ المَجدَ في تَلَعاتِهِ","وَناقَلنَ في العَلياءِ غَوراً إِلى نَجدِ",4,"د",1,0],["سَجِيَّةٌ لَكَ فاتَت كُلَّ مَنزِلَةٍ","وَضَعضَعَت جَنَباتِ الحادِثِ الأَشِبِ",5,"ب",1,0],["سَجيَّةُ مَن رَعى الأَيّامَ حَتّى","أَشابَ جَماجِماً مِنها وَشابا",6,"ب",2,0],["سَجَدَت تُعَظِّمُ رَبَّها فَتَمايَلَت","لِجَلالِها أَربابُنا العُظَماءُ",7,"ا",2,0],["سجَعَتْ بِما طوّقْتَها منْ مِنّةٍ","حتّى زَرَتْ بحَمائِمِ الأطْواقِ",8,"ق",1,0],["سَجَايَاكَ تَقْضِي أَنَّكَ ابْنُ مُحَمَّدٍ","أَيُجْحَدُ حَقٌّ وَالشَّهَادَةُ قَائِمَهْ",9,"م",2,0],["سَجِيَّةُ آبَاءٍ كِرَامٍ وَرِثْتُهَا","بِحَقٍّ وَيَبْنِي الْمَجْدَ لِلْمَرْءِ آلُهُ",10,"ل",2,0],["سَجاياهُ تَرْوي منْ حَديثِ كَمالِهِ","صَحائِفَ فيها للعَلاءِ مَباحِثُ",11,"ث",1,0],["سَجُوّينَ بَرجاوَينِ في حُسنِ حاجِبٍ","وَخَدٍّ أَسيلٍ واضِحٍ مُتَهَلِّلِ",12,"ل",1,0],["سَجايا لِمَن والاهُ كَالأَريِ تُجتَنى","تَعودُ لِمَن عاداهُ كَالشَريِ يُنقَفُ",13,"ف",1,0],["سَجِيَّتُهُ الحُسنى وَشيمَتُهُ الرِضى","وَسيرَتُهُ المُثلى وَمَذهَبُهُ القَصدُ",14,"د",1,0],["سَجِيَّةُ العَرَبِيِّ الهَاشِمِيِّ لَهَا","مَعْنَى وَرَاءَ مَعَانِي الجَاهِ وَالرُّتَبِ",15,"ب",1,0],["سَجَا الحُسَيْنُ وَقَدْ وَرَّى مُسَاجِلَهُ","حَتّى يَئِينَ أَوَانُ الصَّائِدِ الدَّرِبِ",15,"ب",1,0],["سُجُودُ مَا كَانَ مَسْجُوداً لَهُ عِظَةٌ","فِي نَفْسِ كُلِّ لبِيبٍ ذَاتِ أَشْجَانِ",16,"ن",1,0],["سجَّية نفس لم أحُل عن عهودها","وأن لامني الأعمى عليها وفنّدا",17,"د",2,0],["سَجِيَّةٌ تِلكَ مِنهُم غَيرُ مُحدَثَةٍ","إِنَّ الخَلائِقَ حَقّاً شَرُّها البِدَعُ",18,"ع",1,0],["سجية في بني أيوب قد نفرت","وبين آل تقيّ الدين قد رجحت",19,"ت",1,0],["سجاهُ حبّ العفوِ حتَّى لقد","كادَ الفتى يذنب عن عمده",20,"د",2,0],["سجاياه لا زَهر الرِّياض وعرفها","وجدواه لا ظلّ الغمام وقطره",21,"ر",2,0],["سجية سابق الطلبات سامٍ","يظلّ على معاركة الأمور",22,"ر",1,0],["سجعت لك المداح في طرق الهدى","والمكرمات ومن تطوّق يسجع",23,"ع",1,0],["سجية في اقتضاء الحمد ناشئةٌ","على الندى والسدى والمجد والشرف",24,"ف",1,0],["سجيَّة آباءٍ كرمٍ ورثتها","وفقه عفاف يجمع الفرع والأصلا",25,"ل",2,0],["سجيتُهُ طِوال الدهر قبضٌ","وكلُّ سجيَّةٍ بسطٌ وقبضُ",26,"ض",1,0],["سجايا أبت إلا انتصافاً لجارِها","من الدهر إما عضَّ رحْلٌ بِحارك",27,"ك",1,0],["سجايا إذا هَمَّتْ بِخَيرٍ تَسَرَّعَتْ","إليه وإن هَمَّتْ بسوءٍ تأنَّتِ",28,"ت",1,0],["سَجَدُوا ولو عَنَدُوا مكانَ سجودهمْ","لرَماهُمُ مِنْ كيدهِ بدواهي",29,"ه",2,0],["سَجَّلَ العارَ عَلَينا مَعشَرٌ","سَجَّلوا المَرأَةَ بَينَ الهَمَلِ",30,"ل",1,0],["سَجَدَت لَهُ حَتّى العُيونُ مَهابَةً","أَوَما تَراها حينَ يُقبِلُ تُطرِقُ",31,"ق",1,0],["سُجودٌ عَلى إِثرِ الرُكوعِ مُتابَعٌ","هُناكَ بِأَرواحِ الكُماةِ تَسيلُ",32,"ل",1,0],["سجل الدهر في كتاب لديه","نسباً لي في الهالكين عريقا",33,"ق",2,0],["سجن بغداد في الحقيقة قبرٌ","موحش فيه تدفن الأحياءُ",34,"ا",2,1],["سَجَنَّ مُهَنَّداً وَنَفَينَ تِبراً","وَزِدنَ المِسكَ مِن ضَغطٍ فَضاعا",35,"ع",2,0],["سَجَدوا لِمَخلوقٍ وَظَنّوا خالِقاً","مَن ذا يُمَيِّزُ في الظَلامِ وَيَفرُقُ",36,"ق",1,0],["سَجَدَت مِصرُ في الزَمانِ لِإيزي","سَ النَدى مَن لَها اليَدُ البَيضاءُ",37,"ا",2,0],["سَجِيَّةُ نَفسٍ ما تَزالُ مُليحَةً","مِنَ الضَيمِ مَرمِيّاً بِها كُلُّ مَخرَمِ",38,"م",1,0],["سجيةُ مطبوعٍ على الحمدِ خِيمُهُ","إِذا شانَ أخلاقَ الرجالِ التطبّعُ",39,"ع",1,0],["سَجِيَّةٌ مِنهُ ما يُبَدِّلُها","وَسُنَّةٌ مِنهُ ما يُغَيِّرُها",40,"ر",3,0],["سجَرَتْ بحارُهُمُ دماً فَتَيَقَّنَتْ","أَنَّ الأُسودَ عرينُها سِنْجارُها",41,"ر",3,0],["سَجَعَت فَخِلنا الطَوقَ في أَعناقِها","مِنَنُ اِبنِ أُرتُقَ في رِقابِ الناسِ",42,"س",1,0],["سجد الربيعُ مكبراً لجلاله","وتلفَّتَ الوادي بخضرِ هضابِهِ",43,"ب",2,0],["سَجَرَت كَفُّهُ بُحورَ القَوافي","لَكَ عِندَ التَعريضِ وَالتَصريحِ",44,"ح",1,0],["سَجَدَ الجَمالُ لِوَجهِهِ لَمّا رَأى","دَهَشَ العُقولِ لِحُسنِهِ المُتَفاوِتِ",45,"ت",1,0],["سَجَنَت تَجارِبُهُ فُضولَ عُرامِهِ","إِنَّ التَجارِبَ لِلعُقولِ سُجونُ",46,"ن",1,0],["سَجِيَّةُ نَفْسٍ أَدْرَكَتْ مَا تُرِيدُهُ","مِنَ الدَّهْرِ فَاعْتَاضَتْ عَنِ السُّكْرِ بِالصَّحْوِ",47,"و",1,0],["سجادةٌ أذكرتني","منكَ الذي كنتُ أعلمْ",48,"م",1,1],["سَجَعتُ وَقَد غَنّى الحَمامُ فَرَجَّعا","وَما كُنتُ لَولا أَن يُغَنّي لَأَسجَعا",49,"ع",2,1],["سِجالاً وَتَهتاناً وَوَبلاً وَديمَةً","وَسَحّاً وَتَسجاماً إِلى هَمَلانِ",50,"ن",1,0],["سَجَدوا لما صَنعوا فأين حُلومُهم","ولِمَنْ جِباةٌ بالمهانةِ تُلصَقُ",51,"ق",1,0],["سجنوا الدُّستورَ طفلاً ناعماً","واستبدّوا بالسّجين الموثَقِ",52,"ق",1,0],["سَجِيَّتُنا وسنّةُ مَن ورِثنا","من السَّلفِ المُقدّمِ في السَّناءِ",53,"ا",2,0],["سَجِيَّةٌ لِبَني التاميزِ نَعرِفُها","وَخِدعَةٌ لَم تَغِب عَنّا مَراميها",54,"ي",3,0],["سَجِيَّةُ هَذِهِ الدُنيا وَخُلقٌ","تُريناهُ تَصاريفُ اللَيالي",55,"ل",2,0],["سجنوه حين رَأوْهُ يُطلِقُ نفسَهُ","في المعشرِ الطُلَقاءِ 