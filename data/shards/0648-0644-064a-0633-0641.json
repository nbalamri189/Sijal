habi.ae/diwan/poem/66626","المتقارب"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32846","المنسرح"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135458","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111425","الرجز"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44701","البسيط"],[4021,"","https://poetry.dctabudhabi.ae/diwan/poem/143119","البسيط"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35046","الطويل"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35055","السريع"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83456","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33418","الرجز"],[4501,"","https://poetry.dctabudhabi.ae/diwan/poem/143312","المجتث"],[4574,"","https://poetry.dctabudhabi.ae/diwan/poem/146692","المنسرح"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141577","الرجز"],[4767,"الضياع","https://www.poetsgate.com/ViewPoem.aspx?id=180021",""],[4578,"زفافٌ لبدر العز بالسعد أشرقا","https://www.poetsgate.com/ViewPoem.aspx?id=49491",""],[4929,"مَيَلانُ الموازين. (من بحر المنسرح)","https://www.poetsgate.com/ViewPoem.aspx?id=207997",""],[5186,"في ليلة القدر أتاح الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=156523",""],[5213,"ياليت شعري لمن في الناس انميه","https://www.poetsgate.com/ViewPoem.aspx?id=170573",""],[5277,"الأملُ المورقُ","https://www.poetsgate.com/ViewPoem.aspx?id=194881",""],[5338,"لطيبة الغراء شدوا الرحال","https://www.poetsgate.com/ViewPoem.aspx?id=187891",""],[5431,"حبيبي ...","https://www.poetsgate.com/ViewPoem.aspx?id=189358",""],[5628,"المرأة الساحرة","https://www.poetsgate.com/ViewPoem.aspx?id=179898",""],[5697,"لحن الصباحات","https://www.poetsgate.com/ViewPoem.aspx?id=178328",""],[5785,"لا زالت الأيام لك يوم عيد","https://www.poetsgate.com/ViewPoem.aspx?id=131578",""],[5970,"كل بصفحة وجه العيش متبول","https://www.poetsgate.com/ViewPoem.aspx?id=130578",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[6191,"ما لن يكتب عنِ المسيحِ الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88108&r=&rc=6",""],[6289,"دِمّشْقْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81753&r=&rc=5",""]],"verses":[["وَلَيسَ فَتىً مَن يَدَّعي البَأسَ وَحدَه","إِذا لَم يُعَوِّذ بَأسَهُ بِسَخاءِ",0,"ا",2,0],["وَلَيْسَ فِي الأَرْضِ مَنْ يَطْوي إِليهِ فَلاً","يَجْلو لَمَى اللَّيْلِ فيها مَبسِمُ الفَلَقِ",1,"ق",1,0],["وَلَيسَ فيهِم أَخو نَفعٍ وَصالِحَةٍ","وَلا تَرى لَهُمُ بِرّاً وَإِحسانا",2,"ن",2,0],["وليس فرعونها ممن يشط به","بُعد عن العرب العرباء في النسب",3,"ب",1,0],["وليس في الإمكان عند النهى","أبدعُ ممّا خلق المبدع",4,"ع",1,0],["وَلَيسَ فِراقٌ ما اِستَطَعتُ فَإِن يَكُن","فِراقٌ عَلى حالٍ فَلَيسَ إِيابُ",5,"ب",1,0],["وليس فَقْدُ ضِياء الشمس أَجْزَعَني","بل فَقدُ وجهك أوْهَى رُكْنَ مَجْلُودي",6,"د",2,0],["وليس في خطرةٍ مغيرةٍ","لكنها سَرْمد مع الفِكرِ",7,"ر",1,0],["وليس فيها الرؤوس تُندَرُ بل","فيها أنوف الرجال تجتدع",8,"ع",1,0],["وليس فيه شيء تراه سوى ال","أعراض دون النفوس تُدَّرع",8,"ع",1,0],["وليس في السيِّئاتِ أكسبها","بعهدِ أمرٍ إذا امرؤٌ فتكا",9,"ك",2,0],["وَلَيسَ فيها خَصلَةٌ","واحِدَةٌ مُستَوِيَه",10,"ي",2,0],["وليس في شيبي من علة","بل انما العلة في نفسي",11,"س",2,0],["وليس فيه انتقالتي","منك اليك من عنا",12,"ن",2,0],["وَلَيسَ فَتىً مَن عاقَ عَن حَملِ سَيفِهِ","إِسارٌ وَحَلّاهُ عَنِ الطَلَبِ القِدُّ",13,"د",1,0],["وَلَيسَ في الدِماءِ آلِفاتِ","وَلَيسَ في الطِرادِ وَالغاراتِ",14,"ت",1,0],["وَلَيسَ في ذاكَ يَعدو","سَبّي صَباحاً وَمُمسى",15,"س",2,0],["وليس في المردِ من صغيرٍ","يرعى ذماماً ولا كبيرِ",16,"ر",1,0],["وَلَيسَ في الإِنسِ مِن نَفسٍ إِذا قُبِضَت","سافَ الَّذينَ لَدَيها طِيَبَها الأَرِجا",17,"ج",2,0],["وَلَيسَ فيمَن تَراهُ خَيرٌ","فَعَدِّهِ وَاِطلُب اِعتِزالَه",18,"ل",2,0],["وَلَيسَ فارِسُها إِلّا كَراجِلِها","وَقَد يُرى مُحتَذيها مِثلَ حافيها",19,"ي",3,0],["وَلَيسَ في الجسم روح","بالمَوت عنه يولي",20,"ل",2,0],["وَلَيسَ فوق الَّذي قَد","صبرت أسطيع صبرا",21,"ر",2,0],["وليس في الأرض من حياة","يظهر في بذرها نماء",22,"ا",2,0],["وليس في الحب من سمو","ما لم يكن خالصاً صُراحا",23,"ح",2,0],["وَلَيْسَ فِيهَا افْتِرَاضُ رَدٍّ","لِيَوْمِ نعْمَى أَوْ يَوْمِ يُؤْسِ",24,"س",1,0],["وَلَيْسَ فِيهِ إِلاَّ وَفَاءُ","شُعَاعُهُ يَمْلأُ الظِّلاَلاَ",25,"ل",2,0],["وَلَيْسَ فِي ذَاكَ بِدْعٌ","فَالصَّخْرُ عِنْدَكِ أَوْرَقْ",26,"ق",1,0],["وليس في الكفِّ بِيضٌ","وليس في الكفِّ سُمْر",27,"ر",1,0],["وليس في يدي عقد ماس","به أحيط جيدكِ الصغيرا",28,"ر",2,0],["وليس في البغض ما يعني","وخطبه ليس بالجسيم",29,"م",1,0],["وليس في ليلة تقضى بصحبتكم","لو أنصف الناس ما يزري بأقدار",30,"ر",1,0],["وليس في أن أقضي ليلة ثملاً","بين الخرابيش والندمان من عار",31,"ر",1,0],["وليس في الأمر إلاّ أن نسلّمها","لحكمة العادل الجبار راضينا",32,"ن",2,0],["وليس في طاقتي الرؤيا لغيرهم","ولو قلتني الورى في ذاك أو شاحوا",33,"ح",3,0],["وَلَيسَ في الشِعرِ مِن فَضلٍ يَطُولُ بِهِ","مِثلي وَلَو فاقَ أَعلى سَبعِها الطُوَلِ",34,"ل",1,0],["وَلَيسَ فيكُم أَخو حَزمٍ وَمَخبرةٍ","لِلعَقدِ وَالحَلِّ في الأَحكامِ يُنتخَبُ",35,"ب",1,0],["وَلَيسَ فيكُم أَخو علمٍ يُحكَّمُ في","فَصل القَضاءِ وَمِنكُم جاءَتِ الكُتُبُ",35,"ب",1,0],["وليس في منزلي شيء أطيف به","وبي من الجوع ما يدني من الموت",36,"ت",1,0],["وليس فرقٌ في السَّنا بينهما","والبها إنْ طلَعا في غَبَش",37,"ش",1,0],["وليس في ربة الخلخال لي ارب","بل خاتم الانبياء القصد والسول",38,"ل",1,0],["وليس فيه حنطة","صاعا ولا من مد",39,"د",1,0],["وليس في النفس باك","على النفوس الكئيبه",40,"ب",2,0],["وَلَيسَ فيهِ مِنَ المَعاني","شَيءٌ سِوى أَنَّهُ أَكولُ",41,"ل",1,0],["وَلَيسَ فيهم عاري","من اِدِّراع العارِ",42,"ر",1,0],["وَلَيسَ في الخَلقِ مِن تَحكيهِ سورَتُهُ","فَهوَ الَّذي تَمَّ مَعناهُ وَصورَتُهُ",43,"ه",1,0],["وَلَيْسَ فِيهِ إذا اسْتَنْظَرْتَهُ عَجَلٌ","وَلَيْسَ فيهِ إذا ياسَرْتَهُ عُسُرُ",44,"ر",1,0],["وَلَيْسَ في دارِ دُنياهُمْ ذَخِيرَتُهُمْ","وَدارِ أُخْراهُمُ إلاَّ الفتَى الدَّاري",45,"ر",2,0],["وَلَيسَ في الباطِنِ مَن","في الظاهِرِّيينَ ظَهَر",46,"ر",1,0],["وَلَيسَ في الحَقِّ شَيءٌ","بِباطِلِ الحَقِّ يُبطَل",47,"ل",1,0],["وَلَيسَ في شَيءٍ مِنَ الحَقِّ مَن","لا يَعرِفِ الحَقَّ بِتَبيينِهِ",48,"ه",1,0],["وَلَيسَ فَقد اِما عالِم علم","كَفَقدِ من لَيسَ ذا علم وَلا عمل",49,"ل",1,0],["وَلَيسَ في خاطِري أَيضاً وَلا زَمَني","وَلا لِمَعشارِ ما أَلقاهُ مُحتَمَلُ",50,"ل",1,0],["وليس فقيراً من رآك له غنىً","ولا آيساً مَن أنتَ ما عاش ذخره",51,"ر",2,0],["وليس فيه سوى أصداء عاطفة","ذبيحةٍ بين آلام وأشجان",52,"ن",1,0],["وليس في جسمك إل","لا جلدةٌ وأعظمُ",53,"م",1,0],["وليس فيهم قادحٌ بريبةٍ","فيك ولا قاضٍ عليك بوهَلْ",54,"ل",1,0],["وليس فيك إذا استنظرته عجل","وليس فيه ياسرته عسر",55,"ر",1,0],["وليس في الغربِ أدناهُ وما بعُدا","أضحوكةٌ ما بدا في متنِها حَمَلا!",56,"ل",2,0],["وليسَ فيْ سِيرتيْ نهارٌ","لا يُوصَفُ أنّهُ عصِيبُ",57,"ب",1,0],["وليس في حكم القوافي","يجوز في كل ساعة",58,"ع",2,0],["وَليسَ فينا كِظَّةٌ من مَطْعَمٍ","ولم نُعَبْ قطُّ بما تجني البِطَنْ",59,"ن",1,0],["وَلَيسَ في العدل ولا غيره","أنْ يظلم الظّالمُ مَن أنصفا",60,"ف",2,0],["وليس فيه غيره من زمن","جميع ما منه بدا في الزمن",61,"ن",1,0],["وليس فيهم سوى دعوى الوصول وقد","عاشوا بها في غرور زائد وعمى",62,"م",2,0],["وليس فيما مضى وما هو في","مستقبل غيره هم التهم",63,"م",1,0],["وليس فيه سواه دائماً أبداً","والكل فانٍ به فيه قد انسحقا",64,"ق",2,0],["وليس في مقاله علينا","لم أدر حجة إذا درينا",65,"ن",2,0],["وليس في الفرض ولا في السنة","إمارة أو جبها ذو المنة",65,"ه",1,0],["وليس في ذلك لو قد قيلا","من قوله ما يوجب التفضيلا",65,"ل",2,0],["وليس في ظاهر ما رووه","ما يوجب القول الذي ادعوه",65,"ه",1,0],["وليس في الواجب أن يستثنى","بقوله شيء بغير معنى",65,"ن",2,0],["وليس فيما بينهم في الحال","وبين أهل العدل والمقال",65,"ل",1,0],["وَلَيسَ في نَفسه ما يَرتَجيه سِوى","شَيء يَسير بِهِ تَسمو مَنابره",66,"ر",2,0],["وليس في الأعدادِ لِي بُغْيَةٌ","لكنْ لها اسمٌ وَافَقَ التَّسْمِيَهْ",67,"ه",1,0],["وَلَيسَ في الأَصل اللَئيم شُكرُ","وَلَيسَ في الطَبع الدَنيِّ نَصرُ",68,"ر",1,0],["وليس فيها كِرام","وليس فيها ذِمار",69,"ر",1,0],["وليسَ في حزنِها أو موتِها عَجَبٌ","لكِنْ سَلامتُها مِن أعجَبِ العَجَبِ",70,"ب",1,0],["وليس في الوصال فعل الفحشا","كن آمنا والله مما تخشى",71,"ش",2,0],["وليس في مغنى فيرجى زلفةً","من قاب قوسين إليه اقتربا",72,"ب",2,0],["وليس في جودك كلاّ ولا","في مِدحتي موجبٍ قصاري",73,"ر",2,0],["وليس فتى يؤثر المكرما","ت بعدك غير فتاك الأثيرِ",74,"ر",1,0],["وليس في الحول أن أصفي مدائحه","لكن بتوفيق مولى أكرم الكرما",75,"م",2,0],["وَلَيْسَ فِي خَصْمِ الْخَصُوْمِ حُجَّهْ","بِمِثْلِ ذَا وَلا بِهِ مَحَجَّهْ",76,"ه",1,0],["وَلَيْسَ فِي الْبابِ سِواها وَارْتَضَى","مَضْمُوْنَها الاََصْحابُ غَيْرُ الْمُرْتَضَى",76,"ض",2,0],["وَلَيسَ في قَولي اِمتِراء","قَد رَفع الشك وَالحِجاب",77,"ب",1,0],["وليس في لقلقة اللسان","ما العلم إلا خشية الرحمن",78,"ن",1,0],["وَلَيسَ في طَبع اللئيم الشُّكر","وَلَيسَ في الأَصل الدني نَصر",79,"ر",1,0],["وَلَيسَ في العالم ظلم جار","إِذ كل ما يَجري بِإذن الباري",80,"ي",1,0],["وَلَيسَ فيهم فائِدَه","إِلا ظُنون فاسِدَه",81,"ه",1,0],["وَلَيس في أَرضي من أَهواه","لَها وَلا ذو شَرف أَرضاه",82,"ه",1,0],["وَلَيس في قَتلي غَير العار","إِذا قَصَدت قَتلتي وَالعار",82,"ر",1,0],["وليس في خامسة الدوائر","من الثلاث عمل للشاعر",83,"ر",1,0],["وليس في الأرض نبت يشتكي رمداً","إلا وناظره بالطل مكحول",84,"ل",1,0],["وليس فيها سوى ذكر شذى","لمن به ورع محض وإحسانُ",85,"ن",1,0],["وليس في هذه الدنيا الإقامة بل","هى السبيل وفي الأخرى لنا المغنى",86,"ن",2,0],["وَلَيسَ فيهِم رَجُلٌ واحِدٌ","مِنّي إِلى حاجاتِهِ أَحوَجُ",87,"ج",1,0],["وَلَيْسَ فتَى الفِتْيانِ مَنْ راحَ واغْتَدَى","لِشُرْبِ صَبُوحٍ أَوْ لِشُرْبِ غَبوقِ",88,"ق",1,1],["وليس فيمن كتم حبه وفش","مثلي من اهل الحضر والباديه",89,"ي",2,0],["وليس في الحسبان يوم الهاويه","ان تنتحيني منه بلوى باديه",90,"ه",1,0],["وليس في جوابه من نقص","غذ لم يكن فضلا ينال شخصي",90,"ي",1,0],["وليس فينا لفعل الخندريس بنا","من تستقل به ساق على قدم",91,"م",1,0],["وليس في بيعهم يابساً","بأسٌ ولا قولٌ لمن يزرِ",92,"ر",1,0],["وليسَ في النظرةِ بأسٌ إلى","الكفين والوجهِ مع الثغر",92,"ر",1,0],["وليس في الوذي اغتسالٌ ولا","المذي ولا المني بلا نشر",92,"ر",1,0],["وليس في استجمامه عندهم","بأسٌ ولا في سُؤره الخضر",92,"ر",1,0],["وليسَ فيه إن جرى ذكرهُ","عذرٌ لأهلِ الحقِّ في الجهلِ",93,"ل",1,0],["وليس في ال