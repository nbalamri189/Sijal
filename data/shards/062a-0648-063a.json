{"poems":[[56,"أبا عبد الاله أصخ لقولي","https://www.aldiwan.net/poem27609.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39657","المتقارب"],[147,"هل العدل إلا دون ما أنت مظهر","https://www.aldiwan.net/poem11762.html","الطويل"],[189,"فوا أسفاه يا وطني","https://www.aldiwan.net/poem14590.html","مجزوء الوافر"],[280,"قضى صادق الآثار في أمرك الأرضى","https://www.aldiwan.net/poem25491.html","الطويل"],[457,"توغلت فيما لست مبديه جاهدا","https://www.aldiwan.net/poem13673.html","الطويل"],[463,"أمنك خيال ضوع الركب موهنا","https://www.aldiwan.net/poem55831.html","الطويل"],[463,"طوى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[463,"خصيماي من ظمياء واش وشامت","https://www.aldiwan.net/poem56262.html","الطويل"],[568,"هو الأجل الموقوت لا يتخلف","https://www.aldiwan.net/poem13603.html","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64710","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[4691,"حنينٌ إلى معزوفة الماءِ والنور","https://www.poetsgate.com/ViewPoem.aspx?id=196824",""],[5605,"أنا والشعر","https://www.poetsgate.com/ViewPoem.aspx?id=160694",""],[242,"مظنة اتلاف المحب العواذل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563706",""]],"verses":[["تَوَغَّلَ فيهِمُ سَفِلٌ وَخوزٌ","وَأَوباشٌ فَهُم لَهُمُ مِدادُ",0,"د",1,0],["توغَّل في ملكوت الشعاع","وصاد الكهاربَ فيه اغتيالا",1,"ل",2,0],["تَوَغَّلَ مُجتاباً مِنَ اللَيلِ جُنَّةً","وَعادَ وَأُخرى لِلكَرامَةِ تُذخَرُ",2,"ر",1,0],["توغّل في سواد القل","ب فهْو بحبها كَلِف",3,"ف",1,0],["تَوَغَّلْتَ فيها فاتَّقَتْكَ وُلاتُها","بِطَاعَتِهَا تَسْتَدْفِعُ الهَدَّ والهَضَّا",4,"ض",2,0],["توغلتُ فيما لستَ مبديه جاهداً","ولذَّتْ لي الشكوى وحاقَ بها الصمْت",5,"ت",1,1],["توغَّلَ من غربيِّ وجرةَ راكبا","قُنِيَّ العدا حتى أناف على قنَا",6,"ن",2,0],["توغّل يدرُس آثارَكم","فأنغض من دون آثارِهِ",7,"ر",2,0],["توغَّل يرجوها وتُخلفُ ظنَّه","مَنابعُ أكدَى ماؤها ومَنابتُ",8,"ت",1,0],["تَوَغَّلتَ سِجنَ الهَمِّ فَاِصبِرهُ حِسبَةً","يُجازيكَ مَن مَجزِيِّ يوسُفَ يوسُفُ",9,"ف",1,0],["تَوَغَّلُ حُرْقَتي أَجْرى دُموعي","فَقْلْ ما شِئْتَ في دَخْلٍ وخَرْجِ",10,"ج",1,0],["توغلا بشدةٍ في الوعر","بعرقٍ في الجهد رشحاً يجري",11,"ي",1,0],["توغلتِ في بالي ولامستِ غربتي","وفي جنتي كنتِ الأميرة للحورِ",12,"ر",1,0],["توغلت في عمق التراث وسحره","لأعلن عن سر يعاد إلى ا لجهر",13,"ر",1,0],["تَوَغَّلتُ أَنجادَ الصَبابَةِ بِالصِبا","وَخُضتُ بِحارَ الحُبِّ وَهيَ حَوافِلُ",14,"ل",1,0]]}