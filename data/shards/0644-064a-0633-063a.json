{"poems":[[74,"يا ملاذ الأنام هناك الل","https://www.aldiwan.net/poem20313.html","الخفيف"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[91,"افتحوا للفتى الهضيم الطريقا","https://www.aldiwan.net/poem44844.html","الخفيف"],[107,"يا ابن عوف سر حثيثا باللواء","https://www.aldiwan.net/poem43583.html","الرمل"],[107,"يا بني سعد بن بكر مرحبا","https://www.aldiwan.net/poem43987.html","الرمل"],[107,"ويح ذي القصة ماذا يشهد","https://www.aldiwan.net/poem43989.html","الرمل"],[77,"طلب المجد من طريق السيوف","https://www.aldiwan.net/poem69060.html","الخفيف"],[50,"كل ناع فسينعى كل باك فسيبكى","https://www.aldiwan.net/poem10765.html","مجزوء الرمل"],[154,"كل من قاس نبيا بسواه","https://www.aldiwan.net/poem68512.html","الرمل"],[190,"ليس غير الصبر للحر","https://www.aldiwan.net/poem43212.html","مجزوء الرمل"],[310,"عظم الأجر عن عظيم المصاب","https://www.aldiwan.net/poem56609.html","الكامل"],[408,"أتعزي في المصاب","https://www.aldiwan.net/poem46436.html","مجزوء الرمل"],[409,"حدث البارق عن صنعا وعن","https://www.aldiwan.net/poem33394.html","الرمل"],[458,"كم زعيم مسخر شرفه","https://www.aldiwan.net/poem61355.html","الخفيف"],[543,"قد أثرتم لواعجا وشجونا","https://www.aldiwan.net/poem47587.html","عموديه"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77306","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77373","الخفيف"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28584","الخفيف"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112568","الرمل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112582","الرمل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132747","الرمل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123934","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108092","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216801","الخفيف"],[5112,"يا حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=212819",""],[5160,"قد مضينا","https://www.poetsgate.com/ViewPoem.aspx?id=175137",""],[5956,"الصلة المقدسة","https://www.poetsgate.com/ViewPoem.aspx?id=192027",""]],"verses":[["ليس غيري في البيتِ قطعة لحمٍ","فتفضَّل من قبل أن يأكلوني",0,"ن",2,0],["ليس غيرُ العيونِ فيهنَّ من نَوْ","رٍ وغير الثُّديِّ من أحمالِ",1,"ل",1,0],["ليس غير القوي ممن يعيشون","على الارض بالبقاء خليقا",2,"ق",2,0],["ليس غير السيفِ يقضي بيننا","وَهْوَ أَوْلَى يا ابنَ عوفِ بالقَضَاءْ",3,"ا",2,0],["ليس غير النّهبِ ما يمنعه","منكم اليومَ امرؤٌ أن يُنهبَا",4,"ب",2,0],["ليس غير اللهِ في سُلطانِهِ","من إلهٍ يُتَّقَى أو يُعْبَدُ",5,"د",1,0],["ليس غُير الهَيجاء والضربةِ الأخْ","دودِ فيها والطّعْنَةِ الإخطيف",6,"ف",1,0],["لَيسَ غَيرَ اللَهِ يَبقى","مَن عَلا فَاللَهُ أَعلى",7,"ا",1,0],["ليس غاد في سنا عصمته","مثل سار في دياجير هواه",8,"ا",2,0],["ليس غير الصبر لل","حرّ يقيه أو يصنه",9,"ن",2,1],["لَيسَ غيرُ الإله شيءٌ لديهم","يُرتَجى إِن دعوا لردّ الجوابِ",10,"ب",1,0],["ليس غير الله يخلُو","من نَفادٍ وذهابِ",11,"ب",1,0],["ليس غيري عارفاً أسراره","إن سر البرق للمضنى علن",12,"ن",1,0],["ليس غير السلاح ما يفهم","الغاصب سكران عابدا ترفه",13,"ف",2,0],["ليس غير الكفاح في مهمه","الظلم صديقا لبالغ النصفه",13,"ف",2,0],["ليس غير الثورات ما يرهق المستعمر","حتى يرى بها جدفه",13,"ف",2,0],["ليس غيرُ الدعاءِ لي من جزاءٍ","فلتقولوا أنتم معي آمينا",14,"ن",2,0],["لَيسَ غَيرَ الدُستورِ حِصنٌ لِمِصرٍ","فَأَحيطوهُ مِن قُلوبٍ بِسورِ",15,"ر",1,0],["لَيسَ غَيرُ التُقى سَبيلُ فَجِدّي","مِثلَما جَدَّ سابِقوكِ الكِرامُ",16,"م",1,0],["لَيسَ غَيرَ المُقامِ أَستُرُ بِالجُد","رانِ ما يَعلَمونَ مِن سوءِ حالي",17,"ل",2,0],["ليس غير الحسن يبكى للجميل","ليس غير الطير والورد النضير",18,"ر",1,0],["ليس غير الدمع زادي وعتادي","موقف أقتل من وقع السنان",19,"ن",1,0],["ليس غير الشعب واستقلاله","لي شمل فهو اضحى ديدني",20,"ن",2,0],["ليس غير العلوم مالاً وجنداً","ليس غير العلوم عزاً ونصراً",21,"ر",2,0],["ليس غير العلوم ماضي سلاح","يقطع الماضيين بيضاً وسمرا",21,"ر",2,0],["ليس غير العلوم جداً ومجداً","ليس غير العلوم فخراً وذخرا",21,"ر",2,0],["ليس غير الجميل يطرد عني ال","هم أو يجلب العزاءَ الجميلا",22,"ل",2,0],["ليس غسلينهم سوى الشهد ممنو","عاً على قرب ورده في الرضاب",23,"ب",1,0],["ليسَ غيرَ الجرحِ ركنٌ ومقامٌ","ليسَ غيرَ النَّارِ أجْدَاثٌ ومَثْوى",24,"و",2,0],["ليسَ غير الله نخشى","خابَ أحفادُ القرودْ",25,"د",1,0],["ليس غير الله عندي مبتغى","ولدين الحقّ نبضي أذَّنا",26,"ن",2,0]]}