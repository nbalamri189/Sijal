,"https://www.poetsgate.com/ViewPoem.aspx?id=192393",""],[5277,"محاريبُ الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=196677",""],[5431,"قد جاء في (ظلل الغمام) وجنده","https://www.poetsgate.com/ViewPoem.aspx?id=197376",""],[5431,"ماروته شهرذاد...","https://www.poetsgate.com/ViewPoem.aspx?id=202447",""],[5574,"في كنفِ الإلٰهِ مُهدهِداً بدراً","https://www.poetsgate.com/ViewPoem.aspx?id=206002",""],[5739,"فرحة بخيل ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131229",""],[5758,"تَرَاتِيلُ الشَّمْس","https://www.poetsgate.com/ViewPoem.aspx?id=200496",""],[5789,"مغازلة الجِراح","https://www.poetsgate.com/ViewPoem.aspx?id=201410",""],[5818,"احشر الكون في لهاث المضيقِ","https://www.poetsgate.com/ViewPoem.aspx?id=196652",""],[5939,"أنثى الفصول الأربعة","https://www.poetsgate.com/ViewPoem.aspx?id=187751",""],[5950,"عمر ومسافة ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128118",""],[5956,"حيويتان متبادَلتان ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182266",""],[5962,"يا عسر","https://www.poetsgate.com/ViewPoem.aspx?id=206599",""],[6003,"الحب السرمدي","https://www.poetsgate.com/ViewPoem.aspx?id=207313",""],[6328,"ليته جاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82087&r=&rc=6",""]],"verses":[["غيم مدامعه سجام","فلديمتيه بها دوام",0,"م",1,1],["غيم نشا من شفق احمر","مرتفعا غشى سنا البدر",1,"ر",1,0],["غيم برّ ظلهمرحمة","لَم يزل صببه منهمرا",2,"ر",2,0],["غيَّمتَ يا قمرَ الآفاقِ من نَفَسي","فسرْتَ نَحْوي ولم تُبصِرْكَ عَيْنان",3,"ن",1,0],["غيم الرقيع فلم يكد","يبدو لأفق الشمس حاجب",4,"ب",1,1],["غيم الحوادث حال دون البازغِ","من شمس ممتلئ الحقيقة فارغِ",5,"غ",1,1],["غَيْمُ مَدَامِعِهِ تَفِيْضُ","وَثِيَابُهُ سُودٌ وَبِيْضُ",6,"ض",1,1],["غَيْمُ سَما أمْ دُخانُ نَدِّ","قَطْرٌ هَمَى أمْ مِياهُ وَرْدِ",7,"د",1,1],["غيم وطل وروض مونق وهوى","يجري مع الروح مجرى الروح في البدن",8,"ن",1,0],["غيَّمت بالنَّفْع أرجاءُ الوغى","وهَمَى صوبُ الدِّما حتى وكدْ",9,"د",1,0],["غيم ولا كالغيم فيه تجهم","ليث ولا كالليث لدن الأخدع",10,"ع",1,0],["غيمة فرَّت وهامت","في مجاهيل السما",11,"م",2,1],["غيٌّ مبينٌ رشدكم لي في الهوى","وهداكم للمستهام ملالُ",12,"ل",1,0],["غيمة هم فرقت همتي","ما علم من غطي على فكره",13,"ر",2,0],["غيمٌ وظِلٌّ وروْضٌ مُونِقٌ وهوىً","يجري من الروح مجرى الروح في البدنِ",14,"ن",1,0],["غيمة الأحزان ترقبنا","حيثما حلت سنفترق",15,"ق",1,0],["غيَّمت فوقنا صنوف الرزايا","ربِّ فَأْمر تزولُ بالانقشاع",16,"ع",1,0],["غيمة حنين آ وتمطر الشوق وتذب","ب ارض الأمل .. وامال تنطر وعدها",17,"د",3,0],["غَيْمي على شطِّ الهوى وكأنني","أسقي بماءِ محبّتي أنهارا",18,"ر",2,0],["غَيْمَةٌ تُمْطِرُ الْعَبِيرَ ابْتِهَاجًا","أمَلٌ يُْسكِبُ اللقَاءَ غَرَامَا",19,"م",2,0],["غيمة الحرمان راعدها قضيّة","صوته يزلزل ثرى البيد ومدرها",20,"ر",3,0],["غَيُّ مَخَالِبُهُ تَزْدَادُ غَطْرَسَةً","فَمَا لِذِي الحَقِّ مِنْ ذِي الظٌّلْمِ إِيفَاءُ",21,"ا",2,0],["غيم ٌعلى زبَدِِ الأمواج في عَدَنٍ","كثوبِ عُرْسٍ بموجِ البحرِ يلتَصِقُ",22,"ق",1,0],["غيمٌ على شُرفاتِ القلبِ يَرْتَقِبُ","أمْ طَيفُ زائرةٍ يَنأى ويَقْتَرِبُ",23,"ب",1,1],["غيمٌ شفيفٌ على وجهِ المدى يقفُ","وها هي الروحُ من سقياه ترتشفُ",24,"ف",1,1],["غيمي تكاثفَ فانْتشرْ","وبموطنِ الجدبِ انهمرْ",25,"ر",1,1],["غيمٌ على الستين يمطرُ مهجتي","وإذا تطلّبتُ المزيدَ...يزيدُ",26,"د",1,0],["غيمٌ من الأرزاءِ ظلّلَ دربَها","وغدٌ يخافُ شكيمةً من آتِ",27,"ت",1,0],["غيمٌ كثيفٌ موجَعٌ بك يمطرُ","والقلبُ من فرط العذابِ مكسرُ",28,"ر",1,1],["غيما يهاجر بالمسا","ليعود أدراج الصباح",29,"ح",1,0],["١- غيْمٌ تكسّرَ مزنُهُ بِسماءِ","جافى ولمُ يحْنُ على البطْحاءِ",30,"ا",2,1],["غيمة ٍ دلت على قاع ومدي.","وأرتوى الوارد من المعنى الجزيل.",31,"ل",1,0],["غَيْمٌ تَكَدَّسَ هَاهُنَا فِي ذِكْرِهِ","مَا الشِّعْرُ مَا لُغَتِي وَمَا الإِعْرَابُ",32,"ب",1,0],["غَيمانُ يَغرِسُ فِي أَعتَابِ قُبلَتِِها",".مآَتِماً.وَيُشظِّي....حُسنَها النَّضِرَا",33,"ر",2,0],["غيمة الله بالمسرّات حبلى","فانشر اللحن في جفاف العروقِ",34,"ق",1,0],["غيمُ الشتاءِ دموعُها","في الاشتياقِ مُلوّعةْ",35,"ع",2,0],["غيمك اللي مرّ عدّاني رفيفه","ماسقى جرد الضلوع ولا جفافه",36,"ف",2,0],["غيماتُ نظرتِها تفيض جداولاً","وفمي الحنونُ مواقدٌ وطيوبُ",37,"ب",1,0],["غيم السما اقتم","نوضه ثغر بسّام",38,"م",1,0],["غيم يظلنني من العطر الذي","أشتاقه وجداول وغصون",39,"ن",1,0],["غيمة مثقلة أتعبها","ودق الصبر فجادت بسخاء",40,"ا",2,0]]}