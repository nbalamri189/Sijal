{"poems":[[95,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[74,"أوجز مديحك فالمقام عظيم","https://www.aldiwan.net/poem19667.html","الكامل"],[74,"أخفي الأسى ولسان دمعي يعلن","https://www.aldiwan.net/poem20150.html","الكامل"],[93,"لا تقلقي يوم النوى أو فاقلقي","https://www.aldiwan.net/poem8985.html","عموديه"],[87,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[71,"قف وقفة المتألم المتأمل","https://www.aldiwan.net/poem28749.html","الكامل"],[71,"الله قد خولني","https://www.aldiwan.net/poem29016.html","مجزوء الرجز"],[107,"أأفاق ظالم نفسه فأنابا","https://www.aldiwan.net/poem43091.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85456","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[108,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[93,"ضرة جلق","https://www.poetsgate.com/ViewPoem.aspx?id=53143",""],[119,"الله قل واترك سواه فما السوى","https://www.aldiwan.net/poem42200.html","الكامل"],[125,"بالواسعات أرى الأشواق تنهمر","https://www.aldiwan.net/poem23811.html","البسيط"],[193,"أقبل على مدح النبي مفخما","https://www.aldiwan.net/poem35104.html","الكامل"],[275,"أبناء يعرب كلهم أمراء","https://www.aldiwan.net/poem35004.html","الكامل"],[275,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[287,"في عنفوان الصبا ما كنت بالغزل","https://www.aldiwan.net/poem32668.html","البسيط"],[382,"الله قد خلق الإنسان مرتسما","https://www.aldiwan.net/poem59268.html","البسيط"],[427,"الله قل وذر الوجود وما حوى","https://www.aldiwan.net/poem46406.html","الكامل"],[438,"يا حافظ الدين الذي","https://www.aldiwan.net/poem12534.html","مجزوء الرجز"],[447,"طيف لليلى على شحط النوى طرقا","https://www.aldiwan.net/poem14316.html","البسيط"],[447,"هذا المحصب يا قلوصي من منى","https://www.aldiwan.net/poem14320.html","الكامل"],[543,"فضلك لا أنساه","https://www.aldiwan.net/poem47510.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48679","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37940","البسيط"],[865,"","https://poetry.dctabudhabi.ae/diwan/poem/100582","البسيط"],[1022,"","https://poetry.dctabudhabi.ae/diwan/poem/143587","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56588","الكامل"],[1294,"","https://poetry.dctabudhabi.ae/diwan/poem/101110","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49974","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27799","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93579","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93688","البسيط"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11298","البسيط"],[3377,"","https://poetry.dctabudhabi.ae/diwan/poem/205994","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89271","الكامل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69935","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83378","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120516","السريع"],[4797,"ودي بك وابيك","https://www.poetsgate.com/ViewPoem.aspx?id=50257",""],[4929,"القدس بوابة العبور إلى المجد","https://www.poetsgate.com/ViewPoem.aspx?id=199179",""],[4929,"علامة الرفع بين الماضي والحاضر","https://www.poetsgate.com/ViewPoem.aspx?id=199213",""],[4929,"عربن الأسد","https://www.poetsgate.com/ViewPoem.aspx?id=202695",""],[5089,"عرِّجْ على هذا الجمال الأقدسِ","https://www.poetsgate.com/ViewPoem.aspx?id=128710",""],[5136,"ريحاننا لا إله إلا الله","https://www.poetsgate.com/ViewPoem.aspx?id=121768",""],[5150,"غربة","https://www.poetsgate.com/ViewPoem.aspx?id=202797",""],[5324,"هذا العراق والزمان شهادة.","https://www.poetsgate.com/ViewPoem.aspx?id=210997",""],[5327,"رابعةُ الصُّمود","https://www.poetsgate.com/ViewPoem.aspx?id=147699",""],[5463,"هام قلبي هام هام","https://www.poetsgate.com/ViewPoem.aspx?id=33697",""],[5561,"الجمرُ صبرُ النار","https://www.poetsgate.com/ViewPoem.aspx?id=195029",""],[5606,"مايستحق الحب مثلك وشرواك","https://www.poetsgate.com/ViewPoem.aspx?id=196449",""],[4623,"من يعذر المشتاق في شطحاته ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146691",""],[5804,"مساجلة ( الأمة )","https://www.poetsgate.com/ViewPoem.aspx?id=189658",""],[5829,"هوى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=211774",""],[5956,"إني لأخضعُ لاحترامك باكيا","https://www.poetsgate.com/ViewPoem.aspx?id=182371",""],[5956,"شاعر الأديان","https://www.poetsgate.com/ViewPoem.aspx?id=192499",""],[5976,"ميثاق احبّك","https://www.poetsgate.com/ViewPoem.aspx?id=36735",""],[6125,"عَاقَرتُ حُبَّكِ فَاستَحَلتُ مُرِيدَا","https://www.poetsgate.com/ViewPoem.aspx?id=209068",""],[6152,"سهم البعاد","https://www.poetsgate.com/ViewPoem.aspx?id=202541",""]],"verses":[["اللَه قد أحسنتما ثم من","أرفع ذي منزلةٍ في الوطن",0,"ن",1,0],["الله قد صلَّى عليك فكلّ ذي","مجدٍ لمجدِك دأبه التسليم",1,"م",1,0],["الله قدَّر في العزائم أنهم","يتحارفون وأنه يتسلطن",2,"ن",1,0],["اللَهُ قَدَّرَ أَن تَمُسَّ يَدُ الأَسى","أَرواحَنا كَيما تَرِقَّ وَتَرتَقي",3,"ق",2,0],["اللَهُ قَسَّمَ بَينَ الناسِ رِزقَهُمُ","وَأَنتَ خُيِّرتَ في الأَرزاقِ وَالقِسَمِ",4,"م",1,0],["اللّهُ قدَّرَ رحلتي عن ربعِها","يا قلبُ لا تهلكْ أسى وتجمَّلِ",5,"ل",1,0],["اللّهُ قدْ خوّلني","رزقاً عليه أشكرُهْ",6,"ه",1,1],["اللَهُ قَدَّرَها حَياةً غَضَّةً","وَأَعَدَّها لِلصالِحينَ ثَوابا",7,"ب",2,0],["اللَه قدَّر لي النجاة بفضله","من شره واللَه ذو تَقدير",8,"ر",1,0],["اللّهُ قد خَلَقَ المكارمَ والنَّدَى","شَجَراً يُظَلِّلُ في الهَجِير ويُثْمِر",9,"ر",1,0],["اللّه قد خلق الدنيا ليُسعدنا","ونحن نملؤُها حُزناً وتأبينا",10,"ن",2,0],["الله قد خلق الأنام سواسيًا","لا ترْضَ إلا وجهَهُ معبودا",11,"د",2,0],["أللّه قدّر أن تمسّ يد الأسى","لأرواحنا كيما ترقّ وترتقي",12,"ق",2,0],["اللَه قل واترك سواه فما السوى","الأحباب عمى لذي الأوهام",13,"م",1,1],["الله قَدَّره قبلاً وأرسله","بعداً وصوَّرهُ ومنه ذي الصُّورُ",14,"ر",1,0],["اللَّهُ قَد صلّى عليهِ وسلّما","هوَ سيّدُ الرسلِ الكرام محمّدُ",15,"د",1,0],["اللَّهُ قَد صلّى عليهِ وسلّما","خيرُ الوَرى نَسباً وأفضلُ عُنصرا",15,"ر",2,0],["اللَّهُ قَد صلّى عليهِ وسلّما","اللَّهُ أكرمهُ بفضلِ نبوّته",15,"ه",1,0],["اللَّهُ قَد صلّى عليهِ وسلّما","كانَت وصيّتُهم وقايةَ نورهِ",15,"ه",1,0],["اللَّهُ قَد صلّى عليهِ وسلّما","اللَّه أكرمهُ بحفظِ قبيلهِ",15,"ه",1,0],["اللَّهُ قَد صلّى عليهِ وسلّما","فَرمتهمُ بِحجارةٍ سجّيلها",15,"ه",2,0],["اللَّهُ قَد صلّى عليهِ وسلّما","حَمَلت بهِ تلكَ الأمينةُ آمنه",15,"ه",1,0],["اللَّهُ قَد صلّى عليهِ وسلّما","غارَت بُحيرةُ فارسٍ نيرانها",15,"ه",2,0],["اللَّهُ قَد صلّى عليهِ وسلّما","وَتَنكّست لقدومهِ أَصنامُهم",15,"م",1,0],["اللَّهُ قَد صلّى عليهِ وسلّما","شقّت مَلائكةُ المهيمنِ صدرهُ",15,"ه",1,0],["اللَّهُ قَد صلّى عليهِ وسلّما","في الخلقِ ربُّ الخلقِ أنفذ حكمهُ",15,"ه",1,0],["اللَّهُ قَد صلّى عليهِ وسلّما","فَأَجابهُ قَومٌ هناك قرومُ",15,"م",1,0],["اللَّهُ قَد صلّى عليهِ وسلّما","سَعدٌ أبو حفصٍ سعيدٌ حمزتُه",15,"ه",1,0],["اللَّهُ قَد صلّى عليهِ وسلّما","ثمّ اِنبرى نحوَ القبائل داعياً",15,"ي",2,0],["اللَّهُ قَد صلّى عليهِ وسلّما","فَرماهمُ مِن أرضِهم بِتُرابهم",15,"م",1,0],["اللَّهُ قَد صلّى عليهِ وسلّما","أَصحابهُ مِن كلّ ليثٍ كاسر",15,"ر",1,0],["اللَّهُ قَد صلّى عليهِ وسلّما","أَهلُ القليبِ وَما القليبُ لهم مَقر",15,"ر",1,0],["اللَّهُ قَد صلّى عليهِ وسلّما","لَو لَم يكُن يوم الوَغا جبريلهُ",15,"ه",1,0],["اللَّهُ قَد صلّى عليهِ وسلّما","فَتحٌ به أمرُ النبيِّ اِستَفحَلا",15,"ل",2,0],["اللَّهُ قَد صلّى عليهِ وسلّما","فَتحٌ لأسبابِ الرِضا مُستجمعُ",15,"ع",1,0],["اللَّهُ قَد صلّى عليهِ وسلّما","فَتحٌ به الدينُ المبينُ تأيّدا",15,"د",2,0],["اللَّهُ قَد صلّى عليهِ وسلّما","قَد جاءَ نصرُ اللَّهِ فيهِ وفتحهُ",15,"ه",1,0],["اللَّهُ قَد صلّى عليهِ وسلّما","ما كانَ يخطرُ عفوهُ في خاطر",15,"ر",1,0],["اللَّهُ قَد صلّى عليهِ وسلّما","ذَلّت قُريشٌ أيَّ ذلٍّ كاسر",15,"ر",1,0],["اللَّهُ قَد صلّى عليهِ وسلّما","هيَ ذاتُ فَضلٍ في الأنامِ مسلّمِ",15,"م",1,0],["الله قدَّرَ أن تسوسَ عبادَهُ","وتسودَ تِلكَ الأُمةُ الزهراء",16,"ا",2,0],["الله قدَّرَ أن تكونُ دليلةً","متبوعةً وعميدةً تتأمر",17,"ر",1,0],["اللَهُ قَدَّرَ لي رِزقاً سَأُدرِكُهُ","لا بُدَّ مِنهُ كَما لا بُدَّ مِن أَجَلي",18,"ل",2,0],["اللَه قد خلق الإنسان مرتسِماً","بشبهه وهو عين العاقل الفَهِمِ",19,"م",1,1],["الِلّه قل وذر الوجود وما حوى","إن كنتَ مرتاداً بلوغَ كمالِ",20,"ل",1,1],["الله قد عافى بك ال","مَجْدَ معاً والكَرَما",21,"م",2,0],["اللَه قال له في نون أنت على","خلق عظيم نشا أكرم به خلقا",22,"ق",2,0],["اللَه قد أثنى عليه فكيف لي","فيه الثنا واللَه أولاه ثنا",23,"ن",2,0],["أللهُ قد فضَّلهُ","واللهُ قد أعطَاه",24,"ا",2,0],["اللّه قدرها لهم وأعزهم","ما دام فيهم قانت ومقاتل",25,"ل",1,0],["اللَّهُ قَلَّدَ أَهلَ العِلمِ شِرعَتَهُ","وَحَفَّهُمْ مِنهُ بِالتَّأييدِ وَالنّعَمِ",26,"م",1,1],["اللَه قتلك كم ثلما سددت به","وإن يكن منه ركن الدين قد هدما",27,"م",2,0],["الله قد أعطاك ما لم يُعطه","مُلِّيتَهُ ولحقْتَ ما لم يلحَقِ",28,"ق",1,0],["الله قدّر أنّنا أبداً","نأبى الرشاد ونرتضي الغيّا",29,"ي",2,0],["اللَه قلب حاله","واللَه يفعل ما يريد",30,"د",1,0],["الله قدّر أسباب العُلى لهما","مَن قادرٌ دفعَ ما يأتي به القدرُ",31,"ر",1,0],["الله قوّاهم على تكليفه","إياهمُ في دولة الميزان",32,"ن",1,0],["اللَهُ قَيضه لِيحرس بَيته","وَتَحج آمنة لَه الوَفّاد",33,"د",1,0],["اللَهُ قَيَّضه لِلناس يرشدهم","حاشا الآله بِأَن يُبقى الوَرى هملا",34,"ل",2,0],["اللَهُ قَد عَوَّدَ الحُسنى فَما بَرَحَت","مِنهُ لَنا نِعَمٌ تَترى وَتَتَّصِلُ",35,"ل",1,0],["الله قلد هاروناً سياستنا","لما اصطفاه فأحيا الدين والسننا",36,"ن",2,0],["اللَه قدمهم لحكمة أن ترى","تنظيمه بالبُله لا تدبيركا",37,"ك",2,0],["اللَهُ قَد عَلِمَ السَعادَةَ وَالشَقا","وَهُما وَمَنزِلتاهُما ضِدَّانِ",38,"ن",1,0],["اللَهُ قاضٍ عادلٌ في حكمِهِ","لا يَترك الملتاع في حال الشَقا",39,"ق",2,0],["اللَهُ قدَّر إيجادي وَإِمدادي","فَلَن أُفَكّر في عَيشي وَلا زادي",40,"د",2,1],["الله قد احبظ اعمالهم","وردهم اخيب من عقر",41,"ر",1,0],["الله قسم يبلاك بي وانت يبلاك","باللي سواتي في العرب يرتجيها",42,"ي",3,0],["الله قَيَّضَهُمْ لمسرى عبدِهِ","جندًا فلم يُمسَسْ بِهِ محرابُ",43,"ب",1,0],["الله قرر ان تعلوا بعزته","وأن تتم بكم في خلقه النِّعمهْ",44,"م",2,0],["الله قرر ان تسموا بمنهجه","وتنشروا العدل والأحسان والرَّحمهْ",44,"م",2,0],["اللهُ قَيَّضهمْ للحقِّ مُعْتَصَمٌ","وشَاظَهُمْ لِشَيَاطِيْنِ الْوَرَى شُهُبَا**",45,"ب",2,0],["اللهُ قد أيّدها بالحسن من","نظم القوافي بل بها الحسنُ كُسي",46,"س",2,0],["الله قل واستقم كما أمر الله","الله ألا لا إله إلا الله",47,"ل",2,0],["اللهُ قد خلقَ النفوسَ مساكناً","من بعضها.. والشوقُ فيها مُفعمُ",48,"م",1,0],["الله قد خلق الزمان لأجله","نهران فيه من المحبة كوثرُ",49,"ر",1,0],["اللهُ قَدَّرَ مِحنَةً فى مِصرِنا","حتَّى يُبيِّنَ صادِقاً مِنْ إمَّعَة",50,"ع",2,0],["الله قدّر كل حاجه وقال بس كن للعظام","وصرت أنا إنسان عالي وأتنفس أكسجين",51,"ن",1,1],["اللهَ قد تركوا ودينَ محمّدٍ","فتخاذلوا حتى استطابوا العارا",52,"ر",2,0],["الله قسم لك عندنا الحب وأعطاك","ومفروض تشكر نعمته يوم يعطيك",53,"ك",1,0],["الله قدر أن يكون محمدا","أصلا لما أمضى بتقديراته",54,"ت",2,0],["اللهُ قد جعلَ الفقيرَ مُكرّمًا","أضحى بجنَّتِهِ يُعانقُ خَوْدَها",55,"د",3,0],["اللهُ قدْ وضعَ الكتابَ أمانةٌ","في ساعديها فخرُها العلماءُ",56,"ا",2,0],["الله قدَّر أن نفارق بعضنا","فمتى يقدّر أن نعيد تلاقيا؟",57,"ي",2,0],["الله قد أعطى لشعري قدرة","جعلت جناحاتي إليه تصعدُ",58,"د",1,0],["الله قسم لي طيوفك كل ما تطرين","والله قسم لك قصيد ٍ فيك .. يزهابك .. !!",59,"ك",1,0],["اللَّهُ قَد خَلَقَ الجَمَالَ ولَمْ يَزَلْ","طَرفُ البَهَاءِ بِوَجهِهَا مَعقُودَا",60,"د",2,0],["الله قدر بيننا آجالنا","مهما تشدق بالنجاح فصيح",61,"ح",1,0]]}