635","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73406","الخفيف"],[4483,"","https://poetry.dctabudhabi.ae/diwan/poem/101285","الخفيف"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89593","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139765",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139741",""],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124650","الطويل"],[1012,"فقر الأولياء","https://www.poetsgate.com/ViewPoem.aspx?id=186275",""],[4852,"رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=214379",""],[5038,"أنا أهواك","https://www.poetsgate.com/ViewPoem.aspx?id=195430",""],[5213,"ما عليهم لو يحبسون الركابا","https://www.poetsgate.com/ViewPoem.aspx?id=170406",""],[5302,"بلغوا هندا سلامي","https://www.poetsgate.com/ViewPoem.aspx?id=200950",""],[5320,"شكرا أمريكا","https://www.poetsgate.com/ViewPoem.aspx?id=41633",""],[592,"تبكي على رسم دارٍ دارس بال","https://www.poetsgate.com/ViewPoem.aspx?id=128863",""],[5533,"يا غَزَّةُ يا صَوْتَ الأُمَّة","https://www.poetsgate.com/ViewPoem.aspx?id=176419",""],[5582,"أَلا هَلْ سَرَوْا أَهْلُ العَقِيقِ وَراحُوا","https://www.poetsgate.com/ViewPoem.aspx?id=186793",""],[5759,"سنظلُّ نبكي","https://www.poetsgate.com/ViewPoem.aspx?id=212934",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[5926,"أغار","https://www.poetsgate.com/ViewPoem.aspx?id=215664",""],[5950,"نتابني ضيق وأخذ ضيقتي وأشرف","https://www.poetsgate.com/ViewPoem.aspx?id=139974",""],[5956,"فلسطين أرض العرب*","https://www.poetsgate.com/ViewPoem.aspx?id=182863",""],[5956,"فلسطين عربية باعتراف التوراة والإنجيل والقرآن","https://www.poetsgate.com/ViewPoem.aspx?id=192361",""],[5956,"الشر فينا منذ قابيلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=192436",""],[5975,"في ولاء آل بيت الرسول","https://www.poetsgate.com/ViewPoem.aspx?id=53465",""],[5992,"كأنمّا السُّحْبُ إذا ما سَرَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=41810",""],[6045,"لا تيأس","https://www.poetsgate.com/ViewPoem.aspx?id=138521",""],[6096,"عماء .. لكني أرى","https://www.poetsgate.com/ViewPoem.aspx?id=177111",""],[6259,"الليل حيثُ حللن فيه نهارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59377&r=&rc=25",""],[6289,"دِمّشْقْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81753&r=&rc=5",""],[6345,"رياح الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78670&r=&rc=41",""]],"verses":[["أَجَنَت بِها غُدرَ الوَفاءِ فَلَم تَغِض","وَالغُدرُ طامي الماءِ غَيرُ مُكَدَّرِ",0,"ر",1,0],["أُجَنُّ إذا جنّ الظّلامُ فليْسَ لي","سِوى نَسْمَةِ الفجْرِ اللّطيفةِ منْ راقِي",1,"ق",2,0],["اجْنَحْ لها بكتابِ اللهِ مُقْتدياً","إذ ذاكَ واسْتَبْقِ فلاًّ منْ ظُباكَ بَقي",2,"ق",2,0],["أَجْنَى إِلَيْهَا الرِّضَى جَنَانِي","مِنَ الْمَعَانِي جَنَى جِنَانِي",3,"ن",2,0],["أَجِنَّةَ كلِّ شازِبَةٍ مِزاقٍ","طَواها القَودُ وَاِكتَسَتِ أَقوِرارا",4,"ر",2,0],["أَجِنَّ الهَوى ما أَنسَ لا أَنسَ مَوقِفاً","عَشِيَّةَ جَرعاءِ الصَريفِ وَمَنظَرا",5,"ر",2,0],["أَجِنُّ الهَوى أَم طائِرُ البَينِ شَفَّني","بِجُمدِ الصَفا تَنعابُهُ وَمَحاجِلُه",6,"ل",2,0],["أجني على خدَّيهِ أو أجني","ورداً على أهيفٍ ميَّاد",7,"د",1,0],["أجني بها الحسن من تفضُّل محي الد","ين أنشى العلا وأحياها",8,"ا",3,0],["أَجِنُّوا بني العباس من شَنآنكم","وأوْكُوا على ما في العِيابِ وأشْرِجوا",9,"ج",3,0],["أجْنى جنَىً طابتْ مذاقَتُهُ","إذ كان غَرسَ مباركِ الغرس",10,"س",1,0],["أجْنَتْ لكَ الوجدَ أغصانٌ وكُثبانُ","فيهنَّ نوعانِ تُفَّاحٌ وَرُمَّانُ",11,"ن",1,1],["أَجِنايَةَ الطَرفِ الكَحيلِ عَلى الحَشا","اللَهُ حَسبي في الدَمِ المَسفوكِ",12,"ك",1,0],["أَجنِحَةُ الأَشواقِ مَقصوصَةٌ","أَو موثَقاتٌ وَالأَماني رِمام",13,"م",1,0],["أَجَنَّ الأَسى حَتّى إِذا ضاقَ بِالأَسى","تَدَفَّقَ مِن عَينَيَّ أَحمَرَ قانِيا",14,"ي",2,0],["أَجَندَلُ لَولا خِلَّتانِ أَناخَتا","إِلَيكَ لَقَد لامَتكَ أُمُّكَ جَندَلُ",15,"ل",1,1],["أَجْني بِهِ ثَمَرَ القَريِضِ فأَصْطَفي","منه الذي يُعيي سِوايَ مَرامُه",16,"م",2,0],["أَجُنُّ بِزَهرَةِ الدُنيا جُنوناً","وَأَفنِي العُمرَ مِنها بِالتَمَنّي",17,"ن",2,0],["أُجَنُّ بِزَهرَةِ الدُنيا جُنوناً","وَأُفني العُمرَ فيها بِالتَمَنّي",18,"ن",2,0],["أَجَنَت عَليَّ بِما رَأَيتِ مَعاشِرٌ","نَظَروا إِلَيَّ بِمُقلَةٍ عَمياءِ",19,"ا",2,0],["أَجناكَ مِن ثَمَراتِ البِرِّ أَينَعَها","رَبٌّ كَساكَ الأَثيثَ النَضرَ مِن وَرَقِه",20,"ق",2,0],["أَجَنتُنَّ بَعدَ الحَيِّ فَاِنصاحَتِ اللَوى","وَكُنتُنَّ عَهدي ما بِكُنَّ أُجونُ",21,"ن",1,0],["أَجني بِهِ زُخرُفَ المَعيشَةِ إِذ","لَم يُبقِ لي جودُ كَفِّهِ أَمَلا",22,"ل",2,0],["أجَنوبٌ أم شَمالٌ هَصَرَتْ","منك في الأيكة باناً فانخَضَد",23,"د",1,0],["أجني حديثاً كانَ ألطَفَ مَوقعاً","عندي من الراحِ الشَّمول وأعذَبا",24,"ب",2,0],["أَجِنانُ جارِيَةَ المُهَذ","ذَبِ بِالفَضائِلِ وَالسَماحِ",25,"ح",1,0],["أَجني لذاذة","ما أَطيب الجنى",26,"ن",2,0],["أَجْنَبِياً أَلْقَى المَرَاسِيَ حَتَّى","تُقْلِعَ الرَّاسِيَاتُ فِي الاطْوَادِ",27,"د",1,0],["أجنّ الموت أم هو رام كفؤاً","فهزّ شباب قومكَ واصطفاكا",28,"ك",2,0],["أجنت له أيها يدعو مجاعته ؟","وأي افنانها يحسو ويقتطف ؟",29,"ف",1,0],["أجنيك وأأصد عنك شوي وأتوبك","وأتّوبني ولاخذيت شوي .. تجناني",30,"ن",2,0],["أجْنى جنًى طابتْ مذاقَتهُ","إذا كان غَرسَ مباركِ الغرسِ",31,"س",1,0],["أجني حديثاً كانَ ألطفَ موقعاً","وأعلَمُ أنْ الله مُنجِزُ وعْدِهِ",32,"ه",1,0],["أَجنُّ غَراماً فيكَ خيفة كاشح","وَمِن مَدمَعي وَدَق وَفي كَبدي وَقَد",33,"د",1,0],["أجنوني إذا ما مت رمساً","ينادمني به خضل الغمام",34,"م",1,0],["أجني قُطُوفَ الملاهي وَهىَ دَانِيَةٌ","قَطفَ القُطُوفِ الدَّوَاني مُنيَةُ الجَاني",35,"ن",2,0],["أَجناهُ رَبُّ العَرشِ غَرسَ فَعالِهِ","وَقَضى لَهُ بِالخُلدِ في جَنّاتِهِ",36,"ت",2,0],["أَجنَيتَهُ ثَمَرَ النَصيحَةِ أَنعُماً","قَد فاقَتِ الإِحسانَ وَالإِجمالا",37,"ل",2,0],["أَجنَيتَ رُوّادَ السُؤالِ حَدائِقاً","شَتّى الفُنونِ ظَليلَةَ الأَفنانِ",38,"ن",1,0],["أجني وأحتالُ في تَزويرِ معذرةٍ","والعجزُ لمرءِ ليسَ العجزُ للحِيَلِ",39,"ل",1,0],["أجَنَّة وصلٍ نرتعي في نعيمها","أنارُ صدودٍ نصطلي في سعيرِها",40,"ر",3,0],["أجِنُّ حَنينَ النِيبِ شَوْقاً إليكُمُ","إذا شَرَّخَتْ ذيلَ الظلامِ بُروقُ",41,"ق",1,0],["أَجْنِي ثمارَ الخمر من مَضْحك","شفاهُه من ورق الوردِ",42,"د",1,0],["أَجنِحَةُ النَملِ إِذا ما بَدَت","بِجِسمِهِ دَلَّت عَلى فَقدِهِ",43,"ه",1,1],["أَجنيتَ كفّي مِن صنيعك روضةً","وَالشكرُ شادٍ في رياض الأنعمِ",44,"م",1,0],["أَجني جَنى خَدّه بِاللَحظ ثُمَّ إِذا","ما نمّ نَشر شَذاه جئت مُعتَرفا",45,"ف",2,0],["أَجني الرِضابُ مِنَ الغُصونِ وَحَبَّذا","تِلكَ الغُصونُ وَحَبَّذا الأَثمارُ",46,"ر",1,0],["أجني بأيدي اللحظِ من وجناتِه","ورداً ومن فيه أقاحاً أشنبا",47,"ب",2,0],["أجني العيونَ جليَّ نورِ جبينهِ","وجنى بمنعِ جنيِّ نورِ لِثاتِه",48,"ت",2,0],["أَجَنِّبُ أَنفاسِي أزاهِرَ حُسْنِهِ","لِعِلْمِيَ أَنَّ النَّوْرَ بالنَّارِ ساهِمُ",49,"م",1,0],["أجنحة الأيام لا تبقي على","صيف ولا من صاف في ذي البقعة",50,"ه",1,0],["أجنحة من الفرات تهفو","طرد النعام ما لهن زفُّ",51,"ف",1,0],["أجننته من الردى","وصدرهُ مستهدفُ",52,"ف",1,0],["أُجِنُّ بنجدٍ حاجةً لو بلغتها","ونجدٌ على مرمَى العراقيِّ شاسعُ",53,"ع",1,0],["أجنب الغضا يقبلُون الركا","بَ أم عَرْعَراً قال بل عَرْعَرُ",54,"ر",1,0],["أَجِنَتْ أوجهُ الرجالِ فما أن","كَرتُ من بِشر وجههِ العذبِ وِرْدا",55,"د",2,0],["أَجنيتُها من خَلَّةٍ في مَفرِقي","مَيلاءَ نادتها الديارُ فلبّتِ",56,"ت",1,0],["اُجنِّبُ أهل الأمر والنَّهي زورتي","وأغْشى امرءاً في بيتهِ وهو عاطلُ",57,"ل",1,1],["أجنَّها الفكر وأبداها العبقْ","ما كتم الليلُ ولا نمَّ الفلقْ",58,"ق",1,1],["أجني المحامد يا أبي بهداك لي","شكرا لربك فلتنم مأجورا",59,"ر",2,0],["أجنديا أراني رغم أنفي","وأخضع للحكومة بالتزام",60,"م",1,0],["أجنان نسر أم فسيح أجنة","أبدور ليل غار منها نهار",61,"ر",1,0],["أجنان أنس أم فسيح أجنة","أجموع شمل دائما محروسا",62,"س",2,0],["أجنيكم من ثمرات الثنا","ما غرست نعمتكم عندي",63,"د",2,0],["أجني سكون الجسم من حركاتها","وإذا القيام أفاد كان قعودا",64,"د",2,0],["أَجُنَّ أَم أَسلَمَتهُ الفاضِحاتُ إِلى","حَدٍّ مِنَ السَيفِ مَن يَعلَق بِهِ يودِ",65,"د",1,0],["أَجْني بها نَرْجسَةً لم تَزَلْ","ذابِلةً أَو وردةً غَضَّهْ",66,"ض",2,0],["أجني فيُطلبُ حابسي بجنايتي","وأنا قَتلتُ وفيّ آثارُ الدّمِ",67,"م",1,0],["أَجني عَلَيهِ وَمِنهُ زَهر تَواصُل","لا أَختَشي مَعهُ دُنُوَّ مريبِ",68,"ب",1,0],["أجنان خلد زخرفت أم مصنعُ","والعيد عاود أم صنيع يُصنَعُ",69,"ع",1,1],["أجنّاً عليها بدّل الدهر ناسها","فقد فعلوا ما ليس يفعله الجن",70,"ن",1,0],["إِجْن خيرياً بها بال","لحظِ لا تُحْرَم جَنَاها",71,"ا",3,0],["أجنحةَ الأجادلِ الضَّواري","حلَّتْ عقودَ دَمْعها المِدْرار",72,"ر",1,0],["أُجنُّ بِها إِنْ جَنّ لَيلٌ وكلّما","بَدا كَوكَبٌ أَو غابَ في الغَربِ كَوكبُ",73,"ب",1,0],["أجنبُ الله قد جنبوا بنيه","ولا يُرعى لهم فيه جَناب",74,"ب",1,0],["أَجني لذيذَ الوصلِ منهُ وأَحتسي","مِن ريقِ مبسمهِ اللذيذِ القرقفا",75,"ف",2,0],["أَجنِحَةً كَأَنَّها","أَردِيَةٌ مِن قَصَبِ",76,"ب",1,1],["أَجِنَّةً في مُسْتَكِنّاتِ الحَلَقْ","فَعَفَّ عَن أَسْرارِها بَعْد العَسَقْ",77,"ق",1,0],["أَجْنَيْتِني مِنْ لَماكِ نَوْراً","سَقَيْتُ ريحانَهُ بِراحِ",78,"ح",1,1],["أجنيه من روض الشبيبة ناضراً","هذا جناي وأنت كيف جناك",79,"ك",1,0],["اجنوا ثمار الأماني فهي يانعةٌ","واستنجعوا برقها فهو الذي ومضا",80,"ض",2,1],["أَجناد قهر أَهلكوا أَشياعهم","وَلهم عذاب اللَه بالمرصاد",81,"د",1,0],["أجن الناس يا مولاي فظٌ","لخير ملوكنا العظماء خانا",82,"ن",2,0],["أجناده أوراده","وبلاده الغر المساجد",83,"د",1,0],["أَجْنِي سلافةَ ثغره مترشفاً","والوَرْدَ من وجناته متنشقا",84,"ق",2,0],["أجننك الإفلاس حتى أتيتني","تعاتبني والذنب منك تحققا",85,"ق",2,0],["أَجنوناً ما نَراهُ","منكَ يَبدو أَم مجانَه",86,"ن",2,0],["أَجَنَةُ عَدنٍ قَد بَدا لي حورها","أَم الخَيمَةُ الزَرقاءُ لاحَت بدُورُها",87,"ر",3,1],["أجنديُّ جرمانيا له الامر كله","بقصر فرنسا ويح أهلك يا قصر",88,"ر",1,0],["أَجِنُّ لَكَ الحَنينَ عَلى وَفائي","وَأَمنَحُكَ المُهى ما الخَطبُ نابا",89,"ب",2,0],["اجنان عدن زخرفت للأنس","أم حور عين تنثني بالكأس",90,"س",1,1],["أجني على نفسي وأرضى ذلّها","وأرى الجناية أن تحسّ شكاتي",91,"ت",2,0],["أجنة نحن فيها","أم نحن في المرزجوش",92,"ش",1,1],["أَجنادُه أَرسَلَها في القَفرِ","حَتّى اِنتَهَت نَحو قَرايا العقرِ",93,"ر",1,0],["اجنّ اذا ما الليل جنَّ كأنما","يقوم لكم في امِّ رأسي اولقُ",94,"ق",1,0],["أُجنّب ناظري عنهم كأني","أرى الأقذاء فيهم والهواما",95,"م",2,0],["أجنّة الخلد في مصر مصوّحة","والنار في غيرها للخير مدّخر",96,"ر",1,0],["أجن إذا جن الظلام ولم أجد","أنيسي فتبكي من بكائي له الجان",97,"ن",1,0],["إِجناحَهم تِيطُسُ المَلكُ الذي ا