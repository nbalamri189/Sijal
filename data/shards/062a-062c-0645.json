],[5720,"الأَرض (*)","https://www.poetsgate.com/ViewPoem.aspx?id=200226",""],[5720,"كَأَنَّكَ الشَّمسُ","https://www.poetsgate.com/ViewPoem.aspx?id=201280",""],[5720,"أبنائي الطلاب","https://www.poetsgate.com/ViewPoem.aspx?id=202125",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5744,"عمان","https://www.poetsgate.com/ViewPoem.aspx?id=207274",""],[5786,"ما الغيث لمّا جرى بالسَّيل واديه","https://www.poetsgate.com/ViewPoem.aspx?id=50656",""],[5799,"تبسم فجر الحق وأنجابت الظلم","https://www.poetsgate.com/ViewPoem.aspx?id=124750",""],[5851,"جسر الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=175295",""],[5874,"طللية","https://www.poetsgate.com/ViewPoem.aspx?id=201851",""],[5902,"جوى يتلظى فِي الْفُؤَاد استعاره","https://www.poetsgate.com/ViewPoem.aspx?id=189170",""],[5956,"الإعجابُ والحبّ","https://www.poetsgate.com/ViewPoem.aspx?id=182655",""],[5956,"هنالك في عمق السعود كواكب","https://www.poetsgate.com/ViewPoem.aspx?id=193362",""],[5956,"يحب الأقاربُ أبهَى حفيدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=210841",""],[6008,"الجوف زانت","https://www.poetsgate.com/ViewPoem.aspx?id=60997",""],[6019,"عتاب على هامش الشوق ...!!","https://www.poetsgate.com/ViewPoem.aspx?id=53042",""],[6070,"أَضَفْتَ إلى سنينَ العمر ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=188673",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[6229,"شواظ جحيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65205&r=&rc=29",""],[6259,"هي البدرُ لكن تستسرّ مدى الدهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59382&r=&rc=30",""],[6300,"مصير آخر فارس عربيّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82875&r=&rc=46",""],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""]],"verses":[["تجمل أقوام عليك ببغيهم","وكفر أقوام لواك وحاددوا",0,"د",3,0],["تُجَمجِمُ لِلأَطماعِ في كُلِّ لَيلَةٍ","وَتُقلِعُ عَن قَلبي بِغَيرِ بَيانِ",1,"ن",1,0],["تَجُمَّ عَلى القَذى وَتَفيضُ دَمعاً","مَطالُ الداءِ وَادَعَ ثُمَّ هاجا",2,"ج",2,0],["تَجْمَعُ الْمَحْمَدَاتُ فِي","نَسَبٍ زِينَ بالحَسَبْ",3,"ب",1,0],["تجمَّعت فيه مزايا الهنا","فكلُّنا في دهرِه راغب",4,"ب",1,0],["تجمّع في علياك كلّ مفرَّق","من الوصف حتى الضدّ يظهره الضدُّ",5,"د",1,0],["تجمعتِ الأمصارُ في مصر طاعة","وهل تجمع الأمصار إلا على مصر",6,"ر",1,0],["تجمَّعت فيهِ أقسام الفخار كما","تجمَّعت قسم التفصيل في الجمل",7,"ل",1,0],["تجمعت في فتى العليا ولا عجبٌ","إن يجمع الله كلّ الناس في رجل",8,"ل",1,0],["تجمَّع في أوصافك اللطف والسطا","كأنَّك في أثنا ثنا حرّ نيسان",9,"ن",1,0],["تجمعْ لعينٍ وفمٍ طاهرٍ","ماءَيْ خدود وعناقيدِ",10,"د",1,0],["تجمع الفيء للخليفة جمعاً","لا يشذ الفتيل منه ضياعا",11,"ع",2,0],["تَجمُلُ الرِقَّةُ في العَضبِ فَإِن","كُنتَ تَهواها فَكُن كَالمِنصَلِ",12,"ل",1,0],["تَجَمَّعَتِ الهُمومُ عَلَيهِ تَترى","كَما اِجتَمَعَت عَلى الماءِ السُوامُ",13,"م",1,0],["تَجمَعُ مِن ذَيلِها","تَترُكُهُ لَم يُلَم",14,"م",1,0],["تَجمَعُ أَشرافَها","مِن عَرَبٍ أَو عَجَم",14,"م",1,0],["تَجَمَّعَ فيهِ كُلُّ لِسنٍ وَأُمَّةٍ","فَما تُفهِمُ الحُدّاثَ إِلّا التَراجِمُ",15,"م",1,0],["تَجَمَّعَت في فُؤادِهِ هِمَمٌ","مِلءُ فُؤادِ الزَمانِ إِحداها",16,"ا",3,0],["تجمَّلتِ الدُنيا بكم وتعطَّلتْ","وصوَّح منكم روضُها حين أُمْرِعَا",17,"ع",2,0],["تَجَمَّعَ فيها الحُسنُ حَتّى اِنتَهى بِها","وَأَفرَطَ فيها الظَرفُ حَتّى تَزَندَقا",18,"ق",2,0],["تَجَمَّعتُمُ لي في فَصيلٍ كَأَنَّما","تَجَمَّعتُمُ لي في أَغَرَّ مُحَجَّلِ",19,"ل",1,0],["تَجَمَّعَ فيهِ مَشمومٌ وَراحٌ","وَأَوتارٌ وَوِلدانٌ وَحورُ",20,"ر",1,0],["تَجَمَّعَ الأُسدُ فيها وَالظِباءُ كَما","مِن فَرطِ عَدلِكَ يَرعى الذِئبُ وَالنَقَدُ",21,"د",1,0],["تجمعتِ الأضدادُ فيها مصانعاً","ولم أرَ خَلْقاً قبلها جَمَعَ الشّمْلا",22,"ل",2,0],["تَجمّعَتِ الأحزانُ في عُقْرِ دارِهِ","وفرّقَتِ الأزمانُ عن بابِهِ الوَفدا",23,"د",2,0],["تَجَمَّعَت فِرَقُ الأَحلافِ وَاِقتَسَمَت","بِناءَهُ عَن تَراضٍ خَيرَ مُقتَسَمِ",24,"م",1,0],["تَجَمَّعُ فِيهِ الْحِلْمُ وَالْبَأْسُ وَالنَّدَى","فَلَيْسَ لَهُ فِي مَجْدِهِ مِنْ مُزَاحِمِ",25,"م",1,0],["تَجَمَّعُ في (جوهرٍ) خالِصٍ","تَنَزَّهَ عن ( عَرَضِ ) المَطْمَعِ",26,"ع",1,0],["تَجَمَّعنَ مِن شَتّى ثَلاثٌ وَأَربَعٌ","وَواحِدَةٌ حَتّى كَمُلنَ ثَمانِيا",27,"ي",2,0],["تَجَمَّعَت فيهِ أَشتاتُ الجَمالِ كَما","لِلمَجدِ فيهِ نَظيماً كُلُّ مُنتَثِرِ",28,"ر",1,0],["تجمعُ الهائجَ الخِضَم","إلى الراسخِ الأَشَمْ",29,"م",1,0],["تَجَمَّعَ السَّعْدُ والإبّانُ فاتّفَقَا","وزَهرةُ العيش تَتلو زهرةَ الأمَل",30,"ل",1,0],["تَجَمَّعَ فيها الشَكلُ وَالزَيُّ كُلَّهُ","فَلَيسَ يُوَفّي وَصفَها قَولُ ناطِقِ",31,"ق",1,0],["تَجَمَّعُ فيهِ أَصنافُ المَعاني","فَما يُلفى لَهُ في الحُسنِ ثانِ",32,"ن",1,0],["تَجمَعُ عَيني وَعَينُها لُغَةً","مُخالِفٌ لَفظُها لِمَعناها",33,"ا",3,0],["تَجَمَّعَ أَهلُهُ زُمَراً إِلَيهِ","وَصاحَت عِرسهُ أَودى فَصاحوا",34,"ح",3,1],["تَجُمُّ جُيوشُها فَيَضِلُّ فيها","فَتىً يَجتابُ صَفّاً بَعدَ صَفِ",35,"ف",1,0],["تجمع حشد من بني مصر ثائر","وقد ملأ الحشد الميادين والدربا",36,"ب",2,0],["تجملت الدنيا بأنك فوقها","ومثلك حقاً من به تتجمل",37,"ل",1,0],["تجمش من لا يبتغي اللهو عندها","وتطرد نوم الناسك المتأثم",38,"م",1,0],["تَجَمَّعَتِ الْبُلْغارُ وَالرُّومُ بَيْنَها","وزَاحَمَهَا التَّاتَارُ فَهْيَ حُشُودُ",39,"د",1,0],["تُجَمجِمُ بِالإِشعارِ كُلُّ قَبيلَةٍ","وَفي القَولِ مَحفوظٌ عَليها وَضائِعُ",40,"ع",1,1],["تجمَعَ الأنسُ حتى لم يَدَعْ أملاً","للنفسِ تَبْعَثُ شوقاً خَلْفَه واها",41,"ا",3,0],["تجمع بين: الصِّيد، والأَوشاب","بين رؤوس الناس، والأذناب",42,"ب",1,0],["تجمز جمزا بالكماة شزبا","عوابسا شمسا كسيدان الغضى",43,"ا",1,0],["تجمع القرية الشتات فتحوي","أمسيات من عاصفات الفدافد",44,"د",1,0],["تجَمع من أطرافها ثم مسّه","بروعته لالاؤها فتشعبا",45,"ب",2,0],["تجمعنا من أمره لو نطيعه","ووحدتناً من عهده لو نصونه",46,"ن",2,0],["تجمع للأحزان جو ملبدٌ","وهبّت من البلوى رياحٌ رواكد",47,"د",1,0],["تجمز جمزاً بالكماة شزباً","عوابساً شمساً كسيدان الشحا",48,"ا",1,0],["تجمعت المخازى فيك حتى","يعدّ الهجو فيك من المديح",49,"ح",1,0],["تَجَملت الدُنيا بِزُهدك وَاِزدَهَت","مَآثرك العُظمى وَأَيسَرَها العُلى",50,"ل",2,0],["تَجَمَّشَهُ بلحظِ الطَّرفِ كَفِّي","فأَخجلَهُ مِنَ النَّظرِ المُريبِ",51,"ب",1,1],["تَجمَّعَ لي عَبدٌ زَنيمٌ وَفاجِرٌ","أَثيمٌ وَأَبّارٌ عَظيمُ النَيارِبِ",52,"ب",1,0],["تَجمَّل صمتا والليالي مُصيخةٌ","لتسمعَه معْ ذاك كيف يصيح",53,"ح",1,0],["تجمُّلا منه خوفَ أن تُشاهده","عينُ العدو بحالِ العاجز الواهي",54,"ي",1,0],["تجمعت يا اخا الاوصاف من غصن","ومن غزال كناس جمع متحد",55,"د",1,0],["تجمّل بالسماح ودع ملامى","وكن عن المحب المستهام",56,"م",1,1],["تجمّع فيها الحسن من كلّ أمةٍ","كبغداد بين العرب والفرس والكرد",57,"د",1,0],["تجمّل بالسماح ودع ملامي","وكن عون المحب المستهامِ",58,"م",1,1],["تَجمَعُ العاشِقينِ في غَمرَةِ الزَه","رِ وَفي نَشوَةٍ مِنَ الأَشواقِ",59,"ق",1,0],["تجمع فيك الفضل والفقر كله","فلم يغلُ في وصف لديك قريض",60,"ض",1,0],["تجمَّع الحسنُ والإحسان فيه معاً","وإنما بالمعاني تُعشَقُ الصورُ",61,"ر",1,0],["تَجَمَّعَ فيهِ البأسُ وَالحلمُ وَالنَدى","وَضَمَّ إلى الفضل الغَزيرِ التَفَضُلا",62,"ل",2,0],["تجمع فيه وثبه وثباته","رزانة ثهلانٍ وطيش دبور",63,"ر",1,0],["تجمَّعَتِ المحاسنُ في محيّاً","يُريني في الهوى السحرَ الحلالا",64,"ل",2,0],["تجمَّدَ ما قد سالَ منّي فليتَ ما","تجمَّد مِنها سالَ وجداً على الصبّ",65,"ب",1,0],["تجمَّعت الفضائلُ في حِماهُ","فأصبَحَ دُونها حصناً حَصينا",66,"ن",2,0],["تجمَّعَ فيهِ الذكرُ والحسنُ والهوَى","ألستَ تراهُ بالعواطف يَطفَح",67,"ح",1,0],["تجمَّعَ فيهِ نورُها وذبولها","فلم يُبدِ إِلا ما لهذينِ من فعل",68,"ل",1,0],["تَجَمَّعَتْ وَهيَ أَشْتَاتٌ مَحاسِنُها","هَذا الغَديرُ وهَذِي الرَّوضَةُ الأُنفُ",69,"ف",1,0],["تَجَمَّعَ فِيهِ خِلالُ الْكِرامِ","وَقَد يُجْمَعُ الْفَضْلُ فِي واحِدِ",70,"د",1,0],["تجمع في عاقلٍ شملنا","وفرقنا البين لما ولى",71,"ل",2,1],["تجمع الأضداد في ولم يكن","بمستغرب لي في الهوى كل بدعة",72,"ه",1,0],["تجمعت المَحاسِن فيه حَتّى","لعمر أَبيكَ فاقَ عَلى كَثير",73,"ر",1,0],["تَجمّعَتْ عِلَلٌ شَتَّى فما تَركَتْ","عليّ جِسماً ولا فِكْراً ولا حَالا",74,"ل",2,0],["تجمَّعت في مديحي فيه أربعةٌ","سَبكٌ وَنَظمٌ وَإِنشاءٌ وَإِنشادُ",75,"د",1,0],["تَجَمَّع فيهِ ما تَفَرَّق في الوَرى","مِنَ الخَلقِ وَالأَخلاقِ وَالفَضلِ وَالعلى",76,"ل",2,1],["تَجَمَّع فيهِ ما تَفَرَّقَ في الرَدى","مِنَ الخَيرِ فَاِحصوهُ فَإِنّي أُعَدِّدُ",77,"د",1,0],["تجمعت نحوها من كل طائفة","طوائف حاشد منها وسفيان",78,"ن",1,0],["تجمجم عن سؤله هيبة","ويعلم قلبك تأويله",79,"ه",1,0],["تُجمِّل كل مملكة يَداهُ","وَإِن كانَت جَمالاً للأَنامِ",80,"م",1,0],["تَجَمَّعَ أَقسام العُلى في كِتابِهِ","فَكانَ العُلى في الكُلِّ وَالشَطر في السَطرِ",81,"ر",1,0],["تَجمَعُنا الأرضُ فكلُّ امرِئٍ","في لَحْدِهِ كالطّفْلِ في مَهْدِهِ",82,"د",2,0],["تجمّلها بالصبر لاعجها أعرى","إلى موقفٍ سرنا بغير توقّف",83,"ف",1,0],["تجمّع الحُسنُ به","من مزوَجٍ ومفردِ",84,"د",1,0],["تجمع فيه العلم والحلم والتقى","وبذل الندى والخير والدين والعقل",85,"ل",1,0],["تجملني ما لا أطيق من الأسى","ويوهمني أني اجترمت ليهجرا",86,"ر",2,0],["تجمعّن فيه أربع نبويّة","تأثّل منها عنده الفخر والمجد",87,"د",1,0],["تجمع المال بالآصار مؤتشبا","لزوج زوجتك القاليك في البشر",88,"ر",1,0],["تجمّعت غصص الدنيا وما فتئت","حربا عليّ وعادتني لإيثاري",89,"ر",2,0],["تَجمَعُ بين الفتك والجودِ له","وقلّما يبخلُ إلا من جَبُنْ",90,"ن",1,0],["تجمُلُ الدنيا ومن فيها به","وعلى ذاك لقد كنت جمالَهْ",91,"ل",2,0],["تجمُد إمّا بماء صارمه ال","باترِ أو ماءِ كفّه المائرْ",92,"ر",1,0],["تَجَمَّع في الأساورِ مِعصَماها","ويَقلَقُ خصرُها لكَ في الحِقَابِ",93,"ب",1,0],["تَجْمعُ بين الماءِ والنارِ يدٌ","وما جَمَعْتَ الرزقَ والأديبا",94,"ب",2,0],["تجمَّع عندك الضِّدانُ مجداً","وجمعُهما لمعتبرٍ فَخارُ",95,"ر",1,0],["تجمَّع من عِدَّيْ سخاءٍ ونجْدةٍ","أبرّا على صوْب الحَيا والمُهَنَّدِ",96,"د",1,0],["تجمَّع من لطفٍ وبأسٍ ويعْزُب اجْ","تِماعُهُما لكنَّما اللّهُ قادِرُ",97,"ر",1,0],["تجّمل بأثواب التقى والقنوع وال","تواضع ولا تبطر وتظهر تفاخرا",98,"ر",2,0],["تجمّع أضدادَ الملاحة فاغتنم","إذا شئت باكي العين أو ضاحك السنّ",99,"ن",1,0],["تَجَمَّعَت الدُّنيا عليكِ بِلَيلِها","بِكلِّ ضَواريها..فعاثُوا ، وأوبأوا",100,"ا",1,0],["تَجمَعُ بَينَ نارِهِ وَثَلجِهِ","لَم أَرمشهِ مُعتَمِداً لِشَجِّهِ",101,"ج",2,0],["تجمعت الأضداد فيه فإنني","على فعله شاك وشاكر إحسان",102,"ن",1,0],["تجمع فيه ما تفرق في الورى","على أنه أسنى وأسمى وأسمح",103,"ح",1,0],["تجملت بك أيام ذخرت لها","إن النفيس من الأشياء يدخر",104,"ر",1,0],["تجمل أجياد الملو