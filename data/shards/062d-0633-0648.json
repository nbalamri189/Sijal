{"poems":[[53,"يا عمرو فخرا فقد أعطيت منزلة","https://www.aldiwan.net/poem64656.html","البسيط"],[46,"سلام الله عدة رمل خبت","https://www.aldiwan.net/poem30572.html","الوافر"],[266,"وروضة طاب بها المحل","https://www.aldiwan.net/poem38213.html","الرجز"],[333,"بين يأسي وحيرتي ورجائي","https://www.aldiwan.net/poem54993.html","الخفيف"],[369,"أذاكرة يوم الوداع نوار","https://www.aldiwan.net/poem60917.html","الطويل"],[463,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[466,"وبالقصر أريحي","https://www.aldiwan.net/poem15360.html","المضارع"],[466,"لقد غنيت بالقيل من آل هاشم","https://www.aldiwan.net/poem15652.html","الطويل"],[466,"فصبح الوصل وضاح","https://www.aldiwan.net/poem16064.html","الهزج"],[580,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122811","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122732","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122700","الوافر"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103083","الكامل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138113",""],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111166","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77998","الطويل"],[1649,"","https://poetry.dctabudhabi.ae/diwan/poem/104397","الطويل"],[1959,"","https://poetry.dctabudhabi.ae/diwan/poem/96465","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109389","البسيط"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101724","الطويل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45735","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89057","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48427","السريع"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45755","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133311","البسيط"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121269","الكامل"],[1043,"معاودة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=93887",""],[5533,"لا تُصاحِب حَقُوداً","https://www.poetsgate.com/ViewPoem.aspx?id=176384",""],[2110,"حسبي من الوجد ما بي أيها اللاحي","https://www.poetsgate.com/ViewPoem.aspx?id=156268",""],[6070,"تَنَزَّهْ عَنْ مرافقةِ الكذوبِ","https://www.poetsgate.com/ViewPoem.aspx?id=190542",""]],"verses":[["حَسوتُ منها مراراً يا أبا حسنٍ","فاصبر فإنك أيضاً مثلها حاس",0,"س",1,0],["حَسودٌ قَصَّرَت كَفّاهُ عَنهُ","وَكَفُّكَ لِلنَوالِ وَلِلضِرابِ",1,"ب",1,0],["حسودها برخصها وتغلو","معذب بنارها يذل",2,"ل",1,0],["حسوةٌ ثم حسوةٌ ثم غيبو","بة حسٍّ ووسوسات نداء",3,"ا",2,0],["حَسودُك تُمسي طارقاتُ همومِه","وهنّ له دون الشِّعارِ شِعار",4,"ر",1,0],["حسوتُ بمُرِّ الدهر حبّاً لحلوه","فطوراً يُصفِّي لي وطوراً يُصبِّحُ",5,"ح",1,0],["حَسوداهُ في عُلاهُ","ظُبى البيض والقُطار",6,"ر",1,0],["حَسون الكرى رِيّاً بأرغد منزلٍ","فاُنْسين منهال اللِّوى والدَّكادكِ",7,"ك",1,0],["حسَوْا كأس الهوى صِرْفاً","وشِرْبُ الصِّرْفِ تغريرُ",8,"ر",1,0],["حَسودِي بك الحيرانُ حالي بِك الرِّضا","زمانِي بك النَّشوانُ عيْشِي بك الرَّغْدُ",9,"د",1,0],["حَسَوتُ بِثَغرِهِ لَما التَقًينا","مدامة دنة من الخِوانِ",10,"ن",1,0],["حَسَوتَهُمُ الأَسِنَّةَ واقِداتٍ","عَلى أعلَى الذَّوائِبِ كالذَّبالِ",11,"ل",1,0],["حَسَوتُ بِثَغرِها كَأساً دِهاقاً","غَنيتُ بِهِ عَنِ الكَأسِ الدِّهاقِ",12,"ق",1,0],["حس ومحسوس وعقل مدرك","والسابع المسكوت عنه الأكبر",13,"ر",1,0],["حسوت كئوس الطيش قبل هواكم","وكل امرئ للموبقات مسوق",14,"ق",1,0],["حسوا مدام الكؤوس لما","أطلعه الأطلس المورد",15,"د",1,0],["حسود لنا أو ظالم متجبر","وشيخ قبيل مفسد فيه فاسد",16,"د",1,0],["حسودهم خفض عليك فإنهم","بحور هدى من جانب اللَه في الورى",17,"ر",2,0],["حَسَوْها صلاةَ العصرِ والشمسُ حيةٌ","تدُارُ عليهم بالصغيرِ وبالضخْم",18,"م",1,0],["حسوده من علاه لم يصب غرضا","ولم تكن اخطأته قط نعمته",19,"ت",2,0],["حسود يرى النعماء في عينه قذى","فناظره من طول ما قد رأى عمى",20,"م",2,0],["حَسود مَريض القَلب يَخفي أَنينه","وَيُضحى كَئيب البال عِندي حَزينه",21,"ن",2,1],["حسودك قال كفى يا صفا","وقال محبك هل من مزيدْ",22,"د",1,1],["حسودُها التقْصيرُ نادَى بِه","ولَوْ غَدا يدْعو لها نادِيَهْ",23,"د",3,0],["حَسوا درَن الأَحقاد بُغضَاً وَأَنَّني","لَأَكرَه فَضلاً لا يَغيظ حَسَودا",24,"د",2,0],["حسونه الفضل من كانت شمائله","غرا وكان على الخيرات معوانا",25,"ن",2,0],["حسوُ المرارَةِ في كؤوسِ ملامَةٍ","حلوٌ إذا كان الحبيبُ مديرا",26,"ر",2,0],["حسوت كئوس الطيش قبل هواكم","وكل امرىء للموبقات مسوق",27,"ق",1,0],["حَسُودٌ في طَبائِعِه مَقِيْتٌ","يُعَلِّقُ قَلْبَهُ من كُلِّ رِجْسِ",28,"س",1,0],["حسوت كأس الهوى حتى طفحت به","سكرا فلا تلم السكران يا صاح",29,"ح",1,0],["حسوداً حاقداً منْ دونِ شيءٍ","سوى مَرضٍ تَأَصَّلَ في القلوبِ",30,"ب",1,0]]}