{"poems":[[53,"تخلفت شنطف فقلنا","https://www.aldiwan.net/poem64013.html","مخلع البسيط"],[96,"بدعة الذل","https://www.poetsgate.com/ViewPoem.aspx?id=12816",""],[259,"ليت شعري","https://www.aldiwan.net/poem24963.html","مجزوء الرمل"],[318,"قل لإخوان رأوني ميتا","https://www.aldiwan.net/poem59500.html","الرمل"],[343,"صاحب اليسر يرقب العسر والمعسر","https://www.aldiwan.net/poem68776.html","الطويل"],[369,"قربا لي يا صاحبي بعيدا","https://www.aldiwan.net/poem60938.html","الخفيف"],[469,"هذه دولة الندى والسماح","https://www.aldiwan.net/poem3162.html","عموديه"],[572,"ليس خلق إلا وفيه إذا ما","https://www.aldiwan.net/poem69684.html","الخفيف"],[591,"أسير ألحاظ بخد أسيل","https://www.aldiwan.net/poem17692.html","السريع"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59765","الخفيف"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18255","الرجز"],[2546,"","https://poetry.dctabudhabi.ae/diwan/poem/33927","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94276","المديد"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131286",""],[3591,"أيها الموت قد أخذلت الرجالا","https://www.poetsgate.com/ViewPoem.aspx?id=149461",""],[2546,"ليسَ خطبُ الهوى بخطبٍ يسيرِ","https://www.poetsgate.com/ViewPoem.aspx?id=17531",""],[6229,"مرة في الزمان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65207&r=&rc=31",""]],"verses":[["لَيُسخِننَّ الهجاءُ عيناً","من شنطفٍ بالزنا قريره",0,"ر",2,0],["ليس خلف البرود إلاّ هباء","فاحكم النّاس أيّها الطيلسان",1,"ن",1,0],["ليس خِزْياً، بل فخاراً","أنْ ترى الإدبار نصرا",2,"ر",2,0],["ليس خمراً سائغاً أو عسلا","لا ولا ماء ولكن لبنا",3,"ن",2,0],["لَيسَ خَلقٌ لَهُ عَلى اللَهِ حَقُّ","إِنَّما حَقُّهُ عَلى الناسِ طُرّا",4,"ر",2,0],["ليس خَطْباً لو تُسعِداني عظيماً","أن تَعوجا لمُغْرَمٍ وتَعودا",5,"د",2,0],["ليس خلقٌ يحكيهِ في قلة ال","أمثال فضلاً وكثرةِ المدَّاح",6,"ح",1,0],["ليسَ خُلُقٌ إلا وفيه إذا ما","وقَعَ الفَحْصُ عَنْهُ خيرٌ وشَرُّ",7,"ر",1,1],["لَيْسَ خَليلاً لي وَلَكِنَّهُ","أَضْرَمَ في الأَحْشاءِ نَارَ الخَلِيلْ",8,"ل",1,0],["ليس خِل على الوفاء بباقٍ","بعد قلبي وبعد طرفي كليلا",9,"ل",2,0],["ليس خطيب القوم باللجلاج","ولا الذي يزحل كالهلباجِ",10,"ج",1,1],["لَيسَ خَطبُ الهَوى بِخَطبٍ يَسيرٍ","لا يُنَبّيكَ عَنهُ مِثلُ خَبيرِ",11,"ر",1,1],["ليس خالى البال مثل فتى","لم يزل بالخال مشتغلا",12,"ل",2,0],["ليس خطباً ان يستذل رجالٌ","وتضام البنات والصبيان",13,"ن",1,0],["ليس خوفٌ على الخلاف فمن كا","ن عليه الخلاف يعظم زالا",14,"ل",2,0],["ليس خطب الهوى يدبَّرُ بالرَّأ","يِ ولا بالقياسِ والتقديرِ",15,"ر",1,0],["ليس خيراً ما شبّهَ الحقّ فيهِ","ليس شرّاً ما زانَ توبةَ خاطي",16,"ط",2,0]]}