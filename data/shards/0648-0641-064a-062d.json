poetsgate.com/ViewPoem.aspx?id=132540",""],[4927,"حِجابُ عفراء","https://www.poetsgate.com/ViewPoem.aspx?id=30186",""],[4927,"معاقيل الشهادة","https://www.poetsgate.com/ViewPoem.aspx?id=79608",""],[4927,"أبناء السحالي","https://www.poetsgate.com/ViewPoem.aspx?id=80797",""],[4968,"صولات الطويل","https://www.poetsgate.com/ViewPoem.aspx?id=208105",""],[4976,"في رحاب شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=207834",""],[5002,"حورية البحر","https://www.poetsgate.com/ViewPoem.aspx?id=202370",""],[5061,"محمد بن الذيب","https://www.poetsgate.com/ViewPoem.aspx?id=147169",""],[3749,"رفاهية الشهم اقتحام العظائم","https://www.poetsgate.com/ViewPoem.aspx?id=134962",""],[5129,"وجع النوى","https://www.poetsgate.com/ViewPoem.aspx?id=151605",""],[5136,"أذاب فؤاد عاقه غراما","https://www.poetsgate.com/ViewPoem.aspx?id=121666",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[4045,"نشدت بحقّ الله من كان مسلما","https://www.poetsgate.com/ViewPoem.aspx?id=200273",""],[5237,"مرادي من المولى وغاية آمال","https://www.poetsgate.com/ViewPoem.aspx?id=113106",""],[5273,"رسول النواعير","https://www.poetsgate.com/ViewPoem.aspx?id=215990",""],[5277,"الماجدة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=198500",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5351,"إليها","https://www.poetsgate.com/ViewPoem.aspx?id=202129",""],[5397,"أترع لي في سفحه الأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=157902",""],[5397,"بآل محمدٍ عرف الصواب","https://www.poetsgate.com/ViewPoem.aspx?id=157900",""],[5431,"قصيدة لثورة 26_سبتمبر النبيلة","https://www.poetsgate.com/ViewPoem.aspx?id=191307",""],[5431,"فتطوى له الأكوان طيّ الشرائح","https://www.poetsgate.com/ViewPoem.aspx?id=192308",""],[5431,"سبحان الله ...","https://www.poetsgate.com/ViewPoem.aspx?id=208038",""],[5493,"أراكَ","https://www.poetsgate.com/ViewPoem.aspx?id=206413",""],[5527,"قصيدة الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180853",""],[5717,"هذا الكتاب معجز مشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=170606",""],[5781,"أُمُّ الشَّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=198835",""],[5781,"ريحاني نَعيمُهُ والوَردْ","https://www.poetsgate.com/ViewPoem.aspx?id=208765",""],[5791,"بنيّة الخبز ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208643",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5829,"يا تراب المجد","https://www.poetsgate.com/ViewPoem.aspx?id=192052",""],[5847,"وردة الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=1228",""],[6068,"نصرنا الحق حتى صار فينا -10-","https://www.poetsgate.com/ViewPoem.aspx?id=175884",""],[6093,"اللومُ عنديَ أنْ تفنى على طللِ (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176200",""],[6093,"النظرة العجلى","https://www.poetsgate.com/ViewPoem.aspx?id=200869",""],[6093,"واحد طش*","https://www.poetsgate.com/ViewPoem.aspx?id=205484",""],[6102,"غيبوبة","https://www.poetsgate.com/ViewPoem.aspx?id=184544",""],[6102,"مَيس ..","https://www.poetsgate.com/ViewPoem.aspx?id=185073",""],[6167,"تحت العرش","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85552&r=&rc=35",""],[6355,"العيد ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66635&r=&rc=95",""]],"verses":[["وَفي حُسنِ العَزاءِ لَنا مُجيرٌ","يُخَلِّصُنا مِنَ الكُرَبِ العِظامِ",0,"م",1,0],["وَفي حِزبِ الشِمالِ لَدَيكَ أُسدٌ","كُماةٌ لا يَطيبُ لَها اِنهِزامُ",1,"م",1,0],["وفي حَديثِ فتَى غَسّانَ موعظةٌ","لكلِّ ذي نَغرَةٍ يأبى تَناسيها",2,"ي",3,0],["وَفي حَديثِ اِبنِ راشِدٍ زَبَدٌ","عَلى لِحى سامِعيهِ كَالشَبِّ",3,"ب",1,0],["وفي حَسَنٍ كَانَت مَصَادِقُ لاسمِهِ","رِئَابٌ لِصَدعَيهِ المُهَيمنُ يَرأَبُ",4,"ب",1,0],["وفي حُبِّهِم فَاتَّهِم عَاذِلاً","نَهَاكَ وفي حَبلِهم فَاحطِبِ",5,"ب",1,0],["وفي حمى الشام والدُّنيا لواحدها","ذكرٌ يعرّف عرف المسك ذاكره",6,"ر",2,0],["وفي حلبٍ راتبٍ قانعٍ","ولكن نعته يَدا ناعق",7,"ق",1,0],["وفى حاجبٌ راهناً قوسَه","وراقب فيها الحديث الشنِع",8,"ع",1,0],["وَفي حَربِ العَشيرَةِ مُؤيِداتٌ","تُضَعضِعُ تالِدَ العِزِّ المَهيبِ",9,"ب",1,0],["وَفي حَجرُها مَخزومَةٌ مِن وَرائِها","شُعَيثاءُ لَم يَتمِم لِحَولٍ فِصالُها",10,"ل",3,0],["وَفي حُسنِ السَريرَةِ كُلُّ أُنسٍ","وَفي خُبثِ السَريرَةِ كُلُّ باسِ",11,"س",1,0],["وَفي حُسنِ حالِ الرَوضِ أَعدَلُ شاهِدٍ","يُقِرُّ بِما أَسدَت إِلَيهِ يَدُ القَطرِ",12,"ر",1,0],["وَفِي حُنَينٍ إِذ اِرتَدَّت هَوازِنُ عَن","قَصدِ السَّبيلِ وَلَم تَرجِع إِلى الحَكَمِ",13,"م",1,0],["وفي حَرَمِ اللّواءِ لكلِ نَفْسِ","تَلُوذُ بهِ كِفايَةُ كُلِّ بأسِ",14,"س",1,0],["وفي حِصْنِ النّطاةِ لسانُ صدقٍ","يُعَلِّمُ كلَّ مَن جَهِلَ الحُبَابا",15,"ب",2,0],["وفي حياتك فانعم","إذا أردت نعيما",16,"م",2,0],["وَفي حلوك الليالي","وفي الصباح المنير",17,"ر",1,0],["وفي حنينٍ عظُمَ البلاءُ","وحلّت الألطاف والآلاءُ",18,"ا",2,0],["وَفِي حَرَكَاتِ الْبَرقِ لِلشَّوْقِ آيَةٌ","تَدُلُّ عَلَى مَا جَنَّهُ كُلُّ عَاشِقِ",19,"ق",1,0],["وفي حالةٍ أُرغِمتُ ان أصطلي بها","مُحَلِّقَ نفسٍ عاثرَ الجد كابيا",20,"ي",2,0],["وفي حكمة الشرع الشريف بلا مرى","مطيبتك انظر أي مرعى تسميها",21,"ه",2,0],["وفي حكم الفعال يرى دعيا","فلم تشكر له عما وخالا",22,"ل",2,0],["وفي حيثما تبدو لنا القدرة التي","دعته فلباها ولم يك عاصيا",23,"ي",2,0],["وَفي حاضِرِ التَوديعِ مَمنوعَةُ الحِمى","تُريكَ صَباحاً جامَعَ اللَيلَ مُسدِفا",24,"ف",2,0],["وفي حضرة الأحباب بي فادخلوا على","كمال ورضوان وأحصن جنة",25,"ه",1,0],["وفي حرض كان الخطان من بنى سبا","وهم لكم غلمان صدق بدا لك",26,"ك",1,0],["وفي حكم مادون الظبا مثنويةٌ","يناقش فيها حاكمٌ وشهودُ",27,"د",1,0],["وَفي حارِثٍ وَاللَيثِ غُرٌّ غَطارِفٌ","يُبِرُّ عَلى الخَصمِ الأَلَدِّ خِصامُها",28,"م",3,0],["وفي حضرة التقريب والانس ربه","حباه باحسان وحياه بالحسنى",29,"ن",2,0],["وَفي حينِ كانَت ترسل الفكرَ في الد","جى وَفي نَفسِها ماضٍ يَمُدُّ وَيجزرُ",30,"ر",1,0],["وَفِي حَصْبَا الْمُحَصَّبِ مِنْ حِمَاكُمْ","نَزَلْنَا وَالْعَنَا فِيهِ أَنَخْنَا",31,"ن",2,0],["وَفِي حِمَى سِبْطِ خَيْرِ الْخَلْقِ قَاطِبًَة","إِدْرِيسَ غَيْثِ الْوَرَى طُرّاً وَحَامِيهَا",32,"ي",3,0],["وفي حفظه نيل المعالي بدولةٍ","تدوم دوام الأنس في بهجة الورد",33,"د",1,0],["وفي حمرةٍ أو صفرةٍ من نجُومِها","مطامعُ مِنها قد غدَوتُ طريحا",34,"ح",2,0],["وفي حزني تُسلّيني كؤوسي","كأبوابٍ من العقدِ الفريد",35,"د",1,0],["وَفي حَربٍ مِنهُ أَهلُ الفَسادِ","وَأَهلُ الصَلاحِ بِهِ في حَرَم",36,"م",1,0],["وَفي حبيهُمُ قَدَمي اِستَقامَت","وَآلَت لا تَزولُ وَلا تَزِلُّ",37,"ل",1,0],["وَفي حَلَبٍ دَرَّت يَنابيعُ جودِهِ","فَكَم قَنَواتٍ جارِياتٍ بِمَزّازِ",38,"ز",1,0],["وَفي حَلَبٍ لَم يَخلُ أَهلُ مَحَلَّةٍ","لَدى الصَّومِ مِن طاهٍ وَشاوٍ وَخَبّازِ",38,"ز",1,0],["وفي حب الخليفة قد تفانوا","فقل عبد الحميد ولا نبالي",39,"ل",2,0],["وَفي (حلب) لمّا نزلنا بطاحَها","شهدنا بمغناها نجوماً دراريا",40,"ي",2,0],["وفي حنايا صدره خافقٌ","دقّاته ثرثارة لا تقر",41,"ر",1,0],["وَفي حِسابِ الحَرفِ مِن أَوَّ","لِ التَربيعِ تَثليثٌ هَوَ الحَسبُ",42,"ب",1,0],["وَفي حِجرِهِ حَجرٌ عَلى كُلِّ لائِذٍ","بِهِ أَن يُوالي عُصبَةَ العَصَبِيَّةِ",43,"ه",1,0],["وَفي حُبِّكُم إِن عافَ غَيري سَقامَهُ","فَأَعذَبُ ما يَحلو لِقَلبي بِهِ القَتلُ",44,"ل",1,0],["وَفِي حَشوِهِ نَبعٌ لِوَابِلِ نَبلِهِ","عَلَى الرُّومِ فِي الظّلماءِ نقعُ الوَغَى سَحّ",45,"ح",1,0],["وَفي حِفظِ وَدائِعِ أَخباري","كَما اِستَخزَنَ الماءَ المُرَوّقَ مَنهَلُ",46,"ل",1,0],["وفي حالةِ السُّخطِ لا في الرِّضا","يَبينُ المحبُّ من المُبغِضِ",47,"ض",1,0],["وفي حشر ونشر","وأهوال مسيبات",48,"ت",1,0],["وفي حسن عنه وفي ابن شقيقه","لنا عوض في العلم والبحث يشهد",49,"د",1,0],["وفي حمى جبل الرجاف مختلب","للناظرين وللأهوال ميدان",50,"ن",1,0],["وفي حرا زاره جبريل أول ما","وافاه حتى لمن خوف فقد صعقا",51,"ق",2,0],["وفي حليمة برهان يؤيده","مذ أرضعته فسال الدر مندفقا",51,"ق",2,0],["وفي حليمة برهان مؤيده","عند الرضاع وجم الرسل بالجلب",52,"ب",1,0],["وفي حليمة آياتٍ مبينة","في ثديها وخلوف الشاة مذ رضعا",53,"ع",2,0],["وفي حج وصوم واعتكاف","فساد غير ما جرم مواف",54,"ف",1,0],["وفي حِبالات الشباب لي دُمىً","أسرى ولا يُسْرَحْن لو فُدينا",55,"ن",2,0],["وفيحاءَ من دورهم زرتُها","وأخلِقْ بها جَنَّةً أن تُزارا",56,"ر",2,0],["وفي حكمه عند الرعيَّةِ عادلٌ","ولكنهُ بالجودِ في المالِ جائِرُ",57,"ر",1,0],["وفي حَشيَّة دست المجد ذو طَربٍ","لكن بحُبِّ المعالي ذلك الطَّرَبُ",58,"ب",1,1],["وفي 