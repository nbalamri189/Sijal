{"poems":[[53,"عجزنا عن مراغمة الحمام","https://www.aldiwan.net/poem29763.html","الوافر"],[86,"لقد نصل الدجى فمتى تنام","https://www.aldiwan.net/poem10686.html","الوافر"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[71,"أضالع تنطوي على كرب","https://www.aldiwan.net/poem3834.html","المنسرح"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[37,"طربت وهل بك من مطرب","https://www.aldiwan.net/poem7653.html","المتقارب"],[72,"ديار شعري سقاك السعد ماطره","https://www.aldiwan.net/poem18709.html","البسيط"],[72,"بطيفك يا بدر والطارق","https://www.aldiwan.net/poem19351.html","المتقارب"],[51,"ألا ليس شيبك بالمتزع","https://www.aldiwan.net/poem65398.html","المتقارب"],[45,"أمنك تأوب الطيف الطروب","https://www.aldiwan.net/poem10650.html","الوافر"],[28,"وكيف بنفس كلما قلت أشرفت","https://www.aldiwan.net/poem5383.html","الطويل"],[49,"ألا للموت كأس أي كاس","https://www.aldiwan.net/poem62125.html","الوافر"],[66,"سأشكر نعماك التي لو جحدتها","https://www.aldiwan.net/poem41345.html","الطويل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[105,"بني بكر وما يغني الملام","https://www.aldiwan.net/poem44045.html","الوافر"],[105,"أعدي النمل خيبر والذبابا","https://www.aldiwan.net/poem44062.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85843","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85587","المجتث"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42721","الطويل"],[90,"المآسي في حياة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179158",""],[116,"منينا باكدار الليالي وصوفها","https://www.aldiwan.net/poem40487.html","عموديه"],[116,"أقول لمطرب يحدو الجمالا","https://www.aldiwan.net/poem40618.html","عموديه"],[121,"فتى مزق الحب البرح قلبه","https://www.aldiwan.net/poem49299.html","الطويل"],[144,"تخلف عنه الصبر فيمن تخلفا","https://www.aldiwan.net/poem11783.html","الطويل"],[145,"منا القلب عطفا بالمسيء برحمة","https://www.aldiwan.net/poem4458.html","الطويل"],[161,"كذا فليعاني الملك من أعطي الملكا","https://www.aldiwan.net/poem58826.html","الطويل"],[161,"عليك برأي السيف فهو سديد","https://www.aldiwan.net/poem58940.html","الطويل"],[170,"إلى كم مداراة العدى واحترامها","https://www.aldiwan.net/poem1663.html",""],[211,"ألا بالحمى إن جزت يا راكب الوجنا","https://www.aldiwan.net/poem13296.html","الطويل"],[224,"أطلت من الشباك والليل نير","https://www.aldiwan.net/poem39705.html","الطويل"],[238,"إلى الخياط عبد الله جئنا","https://www.aldiwan.net/poem19091.html","الوافر"],[238,"بشرى لفاس وقد طمت دياجيها","https://www.aldiwan.net/poem19728.html","البسيط"],[260,"سلام على الملحوظ في القرب والبعد","https://www.aldiwan.net/poem35745.html","الطويل"],[271,"أرى أبدا قلبي الجريء جريحا","https://www.aldiwan.net/poem35214.html","الطويل"],[271,"شربناها على ذكر الوليد","https://www.aldiwan.net/poem35590.html","الوافر"],[283,"سقت بنت كرمة بنت الكرم","https://www.aldiwan.net/poem32455.html","المتقارب"],[283,"بكم قلبي عليل ما يبل","https://www.aldiwan.net/poem32664.html","الوافر"],[283,"ترجل عن شهبائه الظاهر الغازي","https://www.aldiwan.net/poem32741.html","الطويل"],[286,"هنيئا عزت المختار فاسعد","https://www.aldiwan.net/poem39419.html","الوافر"],[299,"ذر النفس لا يود الأسى بذمائها","https://www.aldiwan.net/poem36289.html","عموديه"],[329,"الحمد للَه على ماق ضى","https://www.aldiwan.net/poem54955.html","الكامل"],[350,"هب منطقي سمعك يا وهب","https://www.aldiwan.net/poem15536.html","السريع"],[350,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[350,"سوى حبكم يسلى وغيري له يسلو","https://www.aldiwan.net/poem15860.html","مجزوء الطويل"],[358,"هنيئا لك الإقبال واليمن والنجح","https://www.aldiwan.net/poem4174.html","الطويل"],[367,"لا أتضع إليه","https://www.aldiwan.net/poem17949.html","البسيط"],[372,"صددت فكنت مليح الصدود","https://www.aldiwan.net/poem56933.html","المتقارب"],[392,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[404,"سرى طيفها والطرف مني مسهد","https://www.aldiwan.net/poem33967.html","الطويل"],[428,"رحلة النيل","https://www.aldiwan.net/poem42147.html","عموديه"],[442,"طيف لليلى على شحط النوى طرقا","https://www.aldiwan.net/poem14316.html","البسيط"],[442,"ألق العصي فهذا مقتضى الأرب","https://www.aldiwan.net/poem14330.html","البسيط"],[442,"ليت الكفان الذي إن مت لي صنعا","https://www.aldiwan.net/poem14333.html","البسيط"],[442,"وتمنع كل موطأة بست","https://www.aldiwan.net/poem14411.html","الوافر"],[459,"أمن خفوق البرق ترزِمينا","https://www.aldiwan.net/poem55828.html","الرجز"],[459,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[462,"أبى الله أن تمسي همومي صواحبي","https://www.aldiwan.net/poem15375.html","الطويل"],[462,"وفي حشية دست المجد ذو طرب","https://www.aldiwan.net/poem16145.html","البسيط"],[478,"عشية عجنا بالمطي الرواسم","https://www.aldiwan.net/poem15247.html","الطويل"],[478,"لمن دمن بالرقمتين وأطلال","https://www.aldiwan.net/poem15250.html","الطويل"],[478,"يقر بعيني أن أرى الربع والدارا","https://www.aldiwan.net/poem15252.html","الطويل"],[478,"هوى بين أحناء الضلوع دفين","https://www.aldiwan.net/poem15260.html","الطويل"],[501,"رآني بمرط الإنكسار أخو الهوى","https://www.aldiwan.net/poem37972.html","الطويل"],[506,"الوصيّة","https://www.aldiwan.net/poem27795.html","الطويل"],[506,"المُحتلّ","https://www.aldiwan.net/poem42460.html","الهزج"],[525,"نبي له في كل فضل تقدم","https://www.aldiwan.net/poem13291.html","الطويل"],[539,"خضوعا ومثلي بالخضوع أخو فخر","https://www.aldiwan.net/poem48153.html","عموديه"],[539,"يغادر مراكشا فرج","https://www.aldiwan.net/poem48252.html","عموديه"],[539,"السحر هذا ما أرى","https://www.aldiwan.net/poem48280.html","عموديه"],[559,"تعلم حفظ آفات اللسان","https://www.aldiwan.net/poem33822.html","الوافر"],[564,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[576,"جاد وما ضن عليه ضناه","https://www.aldiwan.net/poem2996.html","السريع"]],"verses":[["وَفي حُسنِ العَزاءِ لَنا مُجيرٌ","يُخَلِّصُنا مِنَ الكُرَبِ العِظامِ",0,"م",1,0],["وَفي حِزبِ الشِمالِ لَدَيكَ أُسدٌ","كُماةٌ لا يَطيبُ لَها اِنهِزامُ",1,"م",1,0],["وفي حَديثِ فتَى غَسّانَ موعظةٌ","لكلِّ ذي نَغرَةٍ يأبى تَناسيها",2,"ي",3,0],["وَفي حَديثِ اِبنِ راشِدٍ زَبَدٌ","عَلى لِحى سامِعيهِ كَالشَبِّ",3,"ب",1,0],["وفي حَسَنٍ كَانَت مَصَادِقُ لاسمِهِ","رِئَابٌ لِصَدعَيهِ المُهَيمنُ يَرأَبُ",4,"ب",1,0],["وفي حُبِّهِم فَاتَّهِم عَاذِلاً","نَهَاكَ وفي حَبلِهم فَاحطِبِ",5,"ب",1,0],["وفي حمى الشام والدُّنيا لواحدها","ذكرٌ يعرّف عرف المسك ذاكره",6,"ر",2,0],["وفي حلبٍ راتبٍ قانعٍ","ولكن نعته يَدا ناعق",7,"ق",1,0],["وفى حاجبٌ راهناً قوسَه","وراقب فيها الحديث الشنِع",8,"ع",1,0],["وَفي حَربِ العَشيرَةِ مُؤيِداتٌ","تُضَعضِعُ تالِدَ العِزِّ المَهيبِ",9,"ب",1,0],["وَفي حَجرُها مَخزومَةٌ مِن وَرائِها","شُعَيثاءُ لَم يَتمِم لِحَولٍ فِصالُها",10,"ل",3,0],["وَفي حُسنِ السَريرَةِ كُلُّ أُنسٍ","وَفي خُبثِ السَريرَةِ كُلُّ باسِ",11,"س",1,0],["وَفي حُسنِ حالِ الرَوضِ أَعدَلُ شاهِدٍ","يُقِرُّ بِما أَسدَت إِلَيهِ يَدُ القَطرِ",12,"ر",1,0],["وَفِي حُنَينٍ إِذ اِرتَدَّت هَوازِنُ عَن","قَصدِ السَّبيلِ وَلَم تَرجِع إِلى الحَكَمِ",13,"م",1,0],["وفي حَرَمِ اللّواءِ لكلِ نَفْسِ","تَلُوذُ بهِ كِفايَةُ كُلِّ بأسِ",14,"س",1,0],["وفي حِصْنِ النّطاةِ لسانُ صدقٍ","يُعَلِّمُ كلَّ مَن جَهِلَ الحُبَابا",15,"ب",2,0],["وفي حياتك فانعم","إذا أردت نعيما",16,"م",2,0],["وَفي حلوك الليالي","وفي الصباح المنير",17,"ر",1,0],["وفي حنينٍ عظُمَ البلاءُ","وحلّت الألطاف والآلاءُ",18,"ا",2,0],["وَفِي حَرَكَاتِ الْبَرقِ لِلشَّوْقِ آيَةٌ","تَدُلُّ عَلَى مَا جَنَّهُ كُلُّ عَاشِقِ",19,"ق",1,0],["وفي حالةٍ أُرغِمتُ ان أصطلي بها","مُحَلِّقَ نفسٍ عاثرَ الجد كابيا",20,"ي",2,0],["وفي حكمة الشرع الشريف بلا مرى","مطيبتك انظر أي مرعى تسميها",21,"ه",2,0],["وفي حكم الفعال يرى دعيا","فلم تشكر له عما وخالا",22,"ل",2,0],["وفي حيثما تبدو لنا القدرة التي","دعته فلباها ولم يك عاصيا",23,"ي",2,0],["وَفي حاضِرِ التَوديعِ مَمنوعَةُ الحِمى","تُريكَ صَباحاً جامَعَ اللَيلَ مُسدِفا",24,"ف",2,0],["وفي حضرة الأحباب بي فادخلوا على","كمال ورضوان وأحصن جنة",25,"ه",1,0],["وفي حرض كان الخطان من بنى سبا","وهم لكم غلمان صدق بدا لك",26,"ك",1,0],["وفي حكم مادون الظبا مثنويةٌ","يناقش فيها حاكمٌ وشهودُ",27,"د",1,0],["وَفي حارِثٍ وَاللَيثِ غُرٌّ غَطارِفٌ","يُبِرُّ عَلى الخَصمِ الأَلَدِّ خِصامُها",28,"م",3,0],["وفي حضرة التقريب والانس ربه","حباه باحسان وحياه بالحسنى",29,"ن",2,0],["وَفي حينِ كانَت ترسل الفكرَ في الد","جى وَفي نَفسِها ماضٍ يَمُدُّ وَيجزرُ",30,"ر",1,0],["وَفِي حَصْبَا الْمُحَصَّبِ مِنْ حِمَاكُمْ","نَزَلْنَا وَالْعَنَا فِيهِ أَنَخْنَا",31,"ن",2,0],["وَفِي حِمَى سِبْطِ خَيْرِ الْخَلْقِ قَاطِبًَة","إِدْرِيسَ غَيْثِ الْوَرَى طُرّاً وَحَامِيهَا",32,"ي",3,0],["وفي حفظه نيل المعالي بدولةٍ","تدوم دوام الأنس في بهجة الورد",33,"د",1,0],["وفي حمرةٍ أو صفرةٍ من نجُومِها","مطامعُ مِنها قد غدَوتُ طريحا",34,"ح",2,0],["وفي حزني تُسلّيني كؤوسي","كأبوابٍ من العقدِ الفريد",35,"د",1,0],["وَفي حَربٍ مِنهُ أَهلُ الفَسادِ","وَأَهلُ الصَلاحِ بِهِ في حَرَم",36,"م",1,0],["وَفي حبيهُمُ قَدَمي اِستَقامَت","وَآلَت لا تَزولُ وَلا تَزِلُّ",37,"ل",1,0],["وَفي حَلَبٍ دَرَّت يَنابيعُ جودِهِ","فَكَم قَنَواتٍ جارِياتٍ بِمَزّازِ",38,"ز",1,0],["وَفي حَلَبٍ لَم يَخلُ أَهلُ مَحَلَّةٍ","لَدى الصَّومِ مِن طاهٍ وَشاوٍ وَخَبّازِ",38,"ز",1,0],["وفي حب الخليفة قد تفانوا","فقل عبد الحميد ولا نبالي",39,"ل",2,0],["وَفي (حلب) لمّا نزلنا بطاحَها","شهدنا بمغناها نجوماً دراريا",40,"ي",2,0],["وفي حنايا صدره خافقٌ","دقّاته ثرثارة لا تقر",41,"ر",1,0],["وَفي حِسابِ الحَرفِ مِن أَوَّ","لِ التَربيعِ تَثليثٌ هَوَ الحَسبُ",42,"ب",1,0],["وَفي حِجرِهِ حَجرٌ عَلى كُلِّ لائِذٍ","بِهِ أَن يُوالي عُصبَةَ العَصَبِيَّةِ",43,"ه",1,0],["وَفي حُبِّكُم إِن عافَ غَيري سَقامَهُ","فَأَعذَبُ ما يَحلو لِقَلبي بِهِ القَتلُ",44,"ل",1,0],["وَفِي حَشوِهِ نَبعٌ لِوَابِلِ نَبلِهِ","عَلَى الرُّومِ فِي الظّلماءِ نقعُ الوَغَى سَحّ",45,"ح",1,0],["وَفي حِفظِ وَدائِعِ أَخباري","كَما اِستَخزَنَ الماءَ المُرَوّقَ مَنهَلُ",46,"ل",1,0],["وفي حالةِ السُّخطِ لا في الرِّضا","يَبينُ المحبُّ من المُبغِضِ",47,"ض",1,0],["وفي حشر ونشر","وأهوال مسيبات",48,"ت",1,0],["وفي حسن عنه وفي ابن شقيقه","لنا عوض في العلم والبحث يشهد",49,"د",1,0],["وفي حمى جبل الرجاف مختلب","للناظرين وللأهوال ميدان",50,"ن",1,0],["وفي حرا زاره جبريل أول ما","وافاه حتى لمن خوف فقد صعقا",51,"ق",2,0],["وفي حليمة برهان يؤيده","مذ أرضعته فسال الدر مندفقا",51,"ق",2,0],["وفي حليمة برهان مؤيده","عند الرضاع وجم الرسل بالجلب",52,"ب",1,0],["وفي حليمة آياتٍ مبينة","في ثديها وخلوف الشاة مذ رضعا",53,"ع",2,0],["وفي حج وصوم واعتكاف","فساد غير ما جرم مواف",54,"ف",1,0],["وفي حِبالات الشباب لي دُمىً","أسرى ولا يُسْرَحْن لو فُدينا",55,"ن",2,0],["وفيحاءَ من دورهم زرتُها","وأخلِقْ بها جَنَّةً أن تُزارا",56,"ر",2,0],["وفي حكمه عند الرعيَّةِ عادلٌ","ولكنهُ بالجودِ في المالِ جائِرُ",57,"ر",1,0],["وفي حَشيَّة دست المجد ذو طَربٍ","لكن بحُبِّ المعالي ذلك الطَّرَبُ",58,"ب",1,1],["وفي حلبةِ الأشعارِ سابقُها الذي","ترفَّعتُ فيها عن دعيًّ مقاومِ",59,"م",1,0],["وفي حالَتَيْ هجرانهِ ووصالهِ","أُراعُ فقلْ لي فيهما كيفَ أحتالُ",60,"ل",1,0],["وفي حبَّهمْ أبليتُ بُردَ شبيبتي","فهلاّ اُراعى بعدَ ما صارَ أطمارا",61,"ر",2,0],["وفي حالتيهجرانكمْ ووصالكمْ","مكانُكمُ دونَ الشَّغافِ مكينُ",62,"ن",1,0],["وفي حوْمَةِ الهَيْجاءِ يا رُبَّ فارِسٍ","قد اغْتيلَ لو يوقِنْ بنكْبَةِ صرْعِهِ",63,"ع",2,0],["وفي حِجْرها اصطلي بشمسِ أصيلِ","وقاضي الهمومَ واطرُدي وأقيلي",64,"ل",2,0],["وفي حرّ من احتلّا","تلمُّ القِبلةُ الشّملا",65,"ل",2,0],["وَفي حَضرة التَّقريب أَعطاهُ رُتبَةً","تَأَخَر عَنها كُلّ صاحب منزلِ",66,"ل",1,0],["وفىَّ حياةُ للأنَامِ وضِدُّها","كمِثلِكَ يا مولاي في النُّهى والأمرِ",67,"ر",1,0],["وَفىٌّ حَفِىٌّ أخِلاَّؤُه","على نهجِه في الوفَا انتَهجُوا",68,"ج",3,0],["وفي حَشاهُ عَشَّشَت","فالشرقُ جارُ المغرِب",69,"ب",1,0],["وفي حال الصلاة وفي جماع","وفتح القول عند كبير شان",70,"ن",1,0],["وَفي حَديثِ رَسولِ اللَهِ مُستَنَداً","هَذا التَعارُضُ أَيضاً جاءَنا أَثَرا",71,"ر",2,0],["وفي حصاةِ القلْبِ طَوْدُ الهوى","فاعْجَبْ لطَوْدٍ كامنٍ في حَصَاه",72,"ا",2,0]]}