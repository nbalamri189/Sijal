{"poems":[[37,"أمن طلل أقوى من الحي ماثله","https://www.aldiwan.net/poem39102.html","الطويل"],[93,"لو أنني يا هند بدر السما","https://www.aldiwan.net/poem8978.html","عموديه"],[147,"لا زال ملكك بالعلى مأهولا","https://www.aldiwan.net/poem11789.html","الكامل"],[240,"أرقت للمع برق حاجري","https://www.aldiwan.net/poem31628.html","الوافر"],[266,"لمن المهارى اليعملات القود","https://www.aldiwan.net/poem38338.html","الكامل"],[463,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48771","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60847","البسيط"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101627","الكامل"],[5689,"أراك بذي الدنيا الجفاء حبورها","https://www.poetsgate.com/ViewPoem.aspx?id=143409",""],[5893,"لو أكتبك","https://www.poetsgate.com/ViewPoem.aspx?id=141384",""]],"verses":[["وَلَو أَكَلَت مِن نَبتِ عَيني بَهيمَةٌ","لَهَيَّجَ مِنها رَحمَةً حينَ تَأكُلُه",0,"ل",2,0],["وَلَو أَكونُ الأَرَجُ الذاكي","لَما هَجَرتُ لرَوضَ لَولاكِ",1,"ك",1,0],["وَلَوِ اِكتَفَيتَ كَما اِكتَفى أَعيانُهُم","كُلٌّ يَكونُ عَلى أَبيهِ مُحيلا",2,"ل",2,0],["وَلَو أَكرَمتِ دَمعَكِ يا شُؤوني","بَكَيتِ عَلى الإِمامِ الفاطِمِيِّ",3,"ي",1,0],["ولو اكتفوا بمضاء سحر عيونها","لقضى وليس عن القضاء محيد",4,"د",1,0],["ولو اكتفَى قيسٌ بفتوَى أمِّه","لمضى عَدِيٌّ طائحاً وخَطيمُ",5,"م",1,0],["ولو اكتفت صحف العناد بمنذر","ما كان إلغاء ولا إغلاق",6,"ق",1,0],["وَلُّوا كأن الذي يلقى بهم أسداً","فعاد ثعلب قفرٍ ذلك الأسد",7,"د",1,0],["ولو اكتفيت بسلب كل كنوزه","ومتاعبه وطعامه وثيابه",8,"ب",2,0],["ولو أكرمت بالحول منك لأرهقت","سواها من الخلق الضعيف نيورها",9,"ر",3,0],["ولو أكتبك شعر ومشاعر تموتين","وشلون لا غنيتها سااااااااامرية",10,"ي",2,0]]}