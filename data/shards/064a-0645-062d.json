.poetsgate.com/ViewPoem.aspx?id=60788",""],[5974,"فيالق النور","https://www.poetsgate.com/ViewPoem.aspx?id=200260",""],[5994,"كلام في الظل","https://www.poetsgate.com/ViewPoem.aspx?id=184662",""],[6004,"قرابين العِدا","https://www.poetsgate.com/ViewPoem.aspx?id=33754",""],[6093,"وِرْدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=200385",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""],[2220,"بأبي الغصونَ المايساتِ عواطفاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19286&r=&rc=828",""]],"verses":[["يمحو ويثبت أرزاقَ العباد به","فما المقادير إلا ما وحى ومحا",0,"ح",2,0],["يُمَحّي المَيتُ وَيَبلى رَمسُهُ","وَيَغولُ الرَبعَ ما غالَ القَطين",1,"ن",1,0],["يَمحو بِجودٍ بُخلَ إِخوانِهِ","وَالذَنبُ تَمحوهُ المَقاديرُ",2,"ر",1,0],["يَمحْنَ بِأَطْرَافِ الذُّيُولِ عَشِيَّةً","كَمَا بَهَرَ الوَعْثُ الهِجَانَ المَزَنَّمَا",3,"م",2,0],["يمحو بفكرته عبوسة دهره","بتبسم في آلهِ وحنان",4,"ن",1,0],["يمحو ( سايجون ) iبإصبعه","ويمزق ( خيبر ) بالمنجل",5,"ل",1,0],["يمحاامي الغيد....... صخيفات النعل..","يكثر حضورك والعرب...؟ تشاوته",6,"ت",2,0],["يِمُحْتَفِظِينَ إنْ فَضّلْتُمُونَا","عَليِهمْ في القَديمِ وَلا غِضَابِ",7,"ب",1,0],["يمحو (سابجون) بإصبعه","ويمزّق (خيبر) بالمنجل",8,"ل",1,0],["يَمحِّصُ هَذا الدَّهر صَبرَ رِجالهِ","فَيُوسعُهم سَبكاً لِيُخلِصهُم تِبرا",9,"ر",2,0],["يُمحى ظَلامي بنورِ بدرٍ","في طيبة الطيّبين بازِغ",10,"غ",1,0],["يَمحُو سَوادَ اللَّيْلِ أَلويَةٌ لها","حُمْرٌ تَسِيرُ أَمامَ كُلِّ لِواءِ",11,"ا",2,0],["يُمحَى بها ألْفٌ ويُث","بَتُ في مكانِ الألْفِ صفر",12,"ر",1,0],["يمحقون الضلالَ من ظلمة الكف","رِ كما يمحقُ الضّياء الظَّلاما",13,"ا",1,0],["يمحو ظلام الشك صبحُ يقينه","والشكُّ ينفيه ثبوت يقين",14,"ن",1,0],["يمحو ظلام سوادها","بضيا صوارمه الذكورِ",15,"ر",1,0],["يمحو سماتِ الممحلات إذا","كتبَ الوفودُ صحائف السُّؤل",16,"ل",1,0],["يمحو المحاق البدر عند تمامه","ونراك طول الدهر بدر تمام",17,"م",1,0],["يَمحوهُمُ بالرّغمِ مِن","آنافهمْ منها بِلاها",18,"ا",3,0],["يمحو ويثبت ما يشا بوجوده","كالبحر بالأمواج لم يظهر سدى",19,"د",2,0],["يمحو ويثبت دائماً","بالعلم من كرم وجود",20,"د",1,0],["يَمُحُّ ضَرْبَيْنِ مِنْ صَابٍ وَمِنْ عَسَلٍ","وَمَعْنَيَيْنِ مِنَ النَّضْنَاضِ وَالنَّحْلَهْ",21,"ل",2,0],["يمحى ويثبت فرضا في مناقضه","فالكل فيه بحكم الجمع مصدود",22,"د",1,0],["يَمحو ويُثبتُ ما يشاءُ وعندَه","علمُ الكتابِ وعلمُ ما لم يُكتْبِ",23,"ب",1,0],["يمحو أعاديها جنايتهم وما","يمحو المنافق من بنيها العارا",24,"ر",2,0],["يمحو ذنوب يويوليني برحمته","عند الممات ويزيني بحسناه",25,"ا",2,0],["يَمْحُو الظُّنُونَ بِأنْوَارِ اليقين إذَا","مَا اسْوَدَّ لَيْلُ الشكُوكِ الحالِكِ السُّجُفِ",26,"ف",1,0],["يمحو زللي ويطول به","بادي عملي يوم المعرض",27,"ض",1,0],["يمحو الخطوب من القلوب بصولة","فتاكةٍ بجوانح الإقلال",28,"ل",1,0],["يمحمد وكذا أبو بكرٍ السنى","ذوقاً باسماعيلَ أغدو داني",29,"ن",2,0],["يُمَحِّصُ أَقواماً لَهُم عِندَهُ الرِضى","وَيَمحَقُ أَقواماً لَهُم عِندَهُ التَبرُ",30,"ر",1,0],["يمحا لماك برشفه في ليلة","أرجت فلم تر غير صدغك عنبرا",31,"ر",2,0],["يَمحو بِفاضِلِ بُردِهِ آثارَهُ","فَتَحارُ لَو كُنتَ الدَليلَ القائِفا",32,"ف",2,0],["يمحو ويثبت ما يشاء بحكمة","وبعزة وبرحمة وحنان",33,"ن",1,0],["يَمحي سُطورَ الجيشِ في سَطوته","إن جالَ في مُعتركٍ مُعتَرضا",34,"ض",2,0],["يمحو الصفا عن بنى الدنيا ويمنحهم","مصائبا أصبحت للخلق بالرصد",35,"د",1,0],["يمحضُكَ الوُدَّ بِلا رياء","لا يَبرَحَ الأَيام في وَفاءِ",36,"ا",2,0],["يمْحِنَ بهِ ذُرى برَدٍ تداعى","بهِ المتَهلِّلات منَ الغمامِ",37,"م",1,0],["يمحو لدى الكريم ذنب العبد","مع ان عندي واضح الآيات",38,"ت",1,0],["يَمحو الجَليلَ عَظيم الاِعتِداء اِذا","ما سامَحَ الخَصم بِالاِخلاص فَاِتئب",39,"ب",1,0],["يَمحو سَلوى كَما يَمحو اِساءَتِهِ","حَسبي لَهُ فَعَذابي فيهِ كَالنَعيم",40,"م",1,0],["يمحو ماقد كان مني","من ذنوبٍ في الخوال",41,"ل",1,0],["يمحل الى صدّيت ويموت يا اللي","صديت عنّه والله احياه واخرجْه",42,"ج",2,0],["يمحو الأسى ويطيبُ نفسًا إنْ رأى","حظِّي الذي عَدِمَ الصفا قد راقا",43,"ق",2,0],["يمحوت يا ركن الوفى دار لابطال","ممشاك فالجوزا وروحك حصينه",44,"ن",2,0],["يَمْحُو شُعُورَ الْيَأسِ مِنْ نَبَضاتِهِ","لِتَدُقَّ أَجْرَاسُ الرَّجَا لَا تَنْحَنِى",45,"ن",2,0],["يُمْحِقُ الصَّمْتُ شُجُونِيْ","طَارِقًا بَابًا فَبَابَا",46,"ب",2,0],["يمحون أصل الألفاظ عن عمد","في حذف ما كان إرثكم جمعا",47,"ع",2,0],["يمحو الضلالة بالهداية والهدى","وكفى بربك هاديا ونصيرا",48,"ر",2,0],["يمحو النهارُ ظلامَ ليلٍ دامسٍ","ومعي الّليالي ثرّةٌ ببقاءِ",49,"ا",2,0],["يمحو ملامحَهُ المدى","لكنْ يظلُّ مُصوَّرا",50,"ر",2,0],["يمحو الجديدُ طيوفَ ذلك حاللا","عوضاً، وعن هذا الشَّجَى أتحدثُ",51,"ث",1,0],["يمحو لأيام الجوى","بمشاعر الحب الجميل",52,"ل",1,0],["يمحو الظلام .. يمد الكف مبتهجا","لقاصد العلم .. يجلو بالنقاء عمى",53,"م",2,0],["يمحو المساءَ، يعيد تشكيل الرؤى","تتوجع الأفكار فيه بلا عبرْ",54,"ر",1,0],["يَمْحو ، بِهِ الْمَولى ، لَنَا","مَاْ كَاْنَ مِنْ ذَنْبٍ ، بَدَا",55,"د",2,0],["يَمْحُو الذُّنُوبَ وَيَقْضِي حَاجةً سَنَحَتْ","وَفِيْهِ لِلنَّفْسِ بَعْدَ الذَّنْبِ تَصْحِيْحُ",56,"ح",1,0],["يمحو بهذين من ألواحها صورا","أجل ويثبت في قرطاسها الأجلا",57,"ل",2,0],["يمحو بفضلِ بردهِ آثارهُ","فتحارُ لو كنتَ الدّليلَ القَائِفا",58,"ف",2,0]]}