{"poems":[[63,"تأبى الصبابة أن تصيخ لعاذل","https://www.aldiwan.net/poem51494.html","الكامل"],[107,"رددي أخبار عمرو وعمر","https://www.aldiwan.net/poem43077.html","الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141925","السريع"],[463,"آنس برقا بالشريف لامعا","https://www.aldiwan.net/poem56123.html","الرجز"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49090","الخفيف"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198883","الطويل"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28066","الوافر"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[3484,"","https://poetry.dctabudhabi.ae/diwan/poem/216400",""],[5056,"<< نُحاةُ الأدب..>>","https://www.poetsgate.com/ViewPoem.aspx?id=34139",""],[585,"ملأنا السمع من صوتٍ رخيمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=161962",""],[5458,"لا تدخن","https://www.poetsgate.com/ViewPoem.aspx?id=72390",""]],"verses":[["نَحْفَى وَنَنْزلُ وهو أعظمُ حُرمةً","من أن يُذَالَ براكبٍ أو ناعلِ",0,"ل",1,0],["نَحفَظُ العَهدَ وَنَعصي مِن غَدَرْ","إِنَّما الدينُ عُهودٌ وَذِمَمْ",1,"م",1,0],["نحفظ بالأجفان اكمامها","ونسكب الأرواح تحت الغصون",2,"ن",1,0],["نحفظُ ما كان حديثاً حسَناً","منه وما أعجز كان ضائعا",3,"ع",2,0],["نحفظُ العهدَ والذِماما","وعُلى النفسِ والشَّمَمْ",4,"م",1,0],["نحف به يوم الحساب لشأنه","فثم له شان إذا عظم الشان",5,"ن",1,0],["نَحُفُّ المُترَعاتِ إِذا شَتَونا","إِذا النَكباءُ عاقَبَتِ الشَمالا",6,"ل",2,0],["نَحفر خَندَقاً وَنَبني سورا","وَنَحفَظ العِيال ثُمَّ الدورا",7,"ر",2,0],["نِحَّف الأزوار هِنْ مَنوَى القَصاد","حِيَّلٍ ومْن العشوب مْربّعات",8,"ت",1,0],["نَحفُ الرشيد .. مُحبٌ سخب.","نذمُ السخيف .. قليلُ الأدب.",9,"ب",1,0],["نحف المنشدين وقد تعالت","أغانيهم تبللها الدموع",10,"ع",1,0],["نحفظ الدرس ونلعب","نمتطي متن الفضاء",11,"ا",2,0]]}