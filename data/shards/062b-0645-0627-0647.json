{"poems":[[88,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[53,"أحمد الله نية وثناء","https://www.aldiwan.net/poem7941.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54831","الكامل"],[261,"صاح أيري ورمحه فوق خصييه","https://www.aldiwan.net/poem48374.html","الخفيف"],[534,"يا رب زدني نعما","https://www.aldiwan.net/poem37161.html","مجزوء الرجز"],[563,"ظلمات تقدرت تقديرا","https://www.aldiwan.net/poem34518.html","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79973","الخفيف"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136897","الرمل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58288","الخفيف"],[3439,"","https://poetry.dctabudhabi.ae/diwan/poem/130865","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128915","الخفيف"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34651","الرمل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40099","الخفيف"],[5121,"لَيْتَ شِعْرِي","https://www.poetsgate.com/ViewPoem.aspx?id=215772",""],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[5992,"ثمّ أهوى صِنْفٌ من الطيرِ للما","https://www.poetsgate.com/ViewPoem.aspx?id=41829",""],[6288,"فراديس الرند","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78520&r=&rc=0",""]],"verses":[["ثُمَّ أَهوَت إِلى الغَريقِ تُواسي","هِ بِأَحلى مِن مُنعِشاتِ المُدامِ",0,"م",1,0],["ثم أهدى لنا الفواكه شتّى","والتحياتِ جَلَّ ذاك عطاءَ",1,"ا",2,0],["ثُمَّ اهْنَإِي بِلُقَاءِ مَنْ آثَرْتِهِ","وَهْوَ الْجَدِيرُ بِذَلِك الإِيثارِ",2,"ر",1,0],["ثم أهوى بطعنةٍ بات منها","يرم ستي ذاك الشقي بحال",3,"ل",1,0],["ثُمّ أهْدِني إلَى الذي","يُرْضَى طَرِيقاً أَقْوَما",4,"م",2,0],["ثم أهل الجنان قسمان أدنى","ثم أعلى يرى بها التصديرا",5,"ر",2,0],["ثمَّ أُهدي إليكَ تحفةَ بشرٍ","ما حوتْ مثلَ درِّها الأصدافُ",6,"ف",1,0],["ثم أهوت راحة جبارة","ذهبت بالشعر والكنز الثمين",7,"ن",1,0],["ثمَّ أهوتْ يدُ المسرِّحِ بالمِشْ","طِ إلى صُبحِ فَرقهِ لانقسامِ",8,"م",1,0],["ثم أهديتها إليه وأقرر","ت بعجزي في القول والأفعال",9,"ل",1,0],["ثم أهديت لي خصالا حسانا","فقن في حسنهن حسن الغواني",10,"ن",2,0],["ثم أهدى سلماً بابكه","رهن حجلين نجياً للندم",11,"م",1,0],["ثمَّ أَهوى وَقالَ دونَكَ والتَغ","ميز من بعد كَسْرِ جَفْنٍ وغَمْزِ",12,"ز",1,0],["ثُمَّ أَهْوِي بِلَا جَنَاحٍ وَرِيشِي","يَتَهَاوَى إِلَى السَّمَا حَوْلَ مِنِّي",13,"ن",2,0],["ثم اهتديت بهدي هود مؤمنا","بالله قي أفضاله وحنانه",14,"ن",2,0],["ثمّ أهوى صِنْفٌ من الطيرِ للما","ءِ ودال الرياض غير مَكَيَّسْ",15,"س",1,1],["ثم اهديتها الى الحفل بيتا","ساحرالجرس من قصيد العراق",16,"ق",1,0]]}