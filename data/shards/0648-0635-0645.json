{"poems":[[77,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[0,"ألا عم صباحاً أيها الطلل البالي","https://www.aldiwan.net/poem51.html","الطويل"],[51,"أبا حسن طال المطال ولم يكن","https://www.aldiwan.net/poem64051.html","الطويل"],[46,"لأمواه الشبيبة كيف غضنه","https://www.aldiwan.net/poem23485.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43697","الطويل"],[94,"الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=13793",""],[121,"بالبحر قيلولة والشوق أختنق","https://www.aldiwan.net/poem23821.html","البسيط"],[128,"بحر الفصاحة غاض يا إخواني","https://www.aldiwan.net/poem50494.html","الكامل"],[237,"أعدت نبالا للحشا وهي ألحاظ","https://www.aldiwan.net/poem18845.html","الطويل"],[349,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[364,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[365,"تمناني ليقتلني وأنت","https://www.aldiwan.net/poem44519.html","مجزوء الوافر"],[371,"بركات مولانا عليك تعود","https://www.aldiwan.net/poem57476.html","الكامل"],[391,"ياطالبا للوصيه","https://www.aldiwan.net/poem54448.html","عموديه"],[391,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[391,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[409,"حسبي من العيش كم لاقيت فيه أذى","https://www.aldiwan.net/poem31849.html","البسيط"],[500,"وحياتكم يا أهل منعرج اللوى","https://www.aldiwan.net/poem37677.html","الكامل"],[505,"الحساب","https://www.aldiwan.net/poem56767.html","الطويل"],[514,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[527,"لعمرك لولا آل بوية في الورى","https://www.aldiwan.net/poem45990.html","الطويل"],[551,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[551,"منا الوصال ومنكم الهجر","https://www.aldiwan.net/poem47827.html","أحذ الكامل"],[551,"ألا هل أتاها كيف حزني بعدها","https://www.aldiwan.net/poem47860.html","الطويل"]],"verses":[["وَصَمَّ صَدَى الدُّنْيَا فَلَمَّا رَجَمْتَهَا","تَزَاحَمَ مُرْتَادٌ عَلَيْهَا وَمُخْتَطُّ",0,"ط",1,0],["وَصُمٌّ صِلابٌ ما يَقينَ مِنَ الوَجى","كَأَنَّ مَكانَ الرِدفِ مِنهُ عَلى رَألِ",1,"ل",1,0],["وصمتي ومطِّي حاجبي وإشاحتي","بوجهي إذا سمَّى ليَ اسمَك ذاكر",2,"ر",1,0],["وَصُم رَمَضانَ مُختاراً مُطيعاً","إِذِ الأَقدامُ مِن قَيظٍ رَمِضنَه",3,"ن",2,0],["وصمْتِ الخليقة في بعثهم","كأنهم الحدَثُ المنكرُ",4,"ر",1,0],["وَصُمُّ الأَعادي تَقشعرُّ لِذِكرِهِ","جُلودهُمُ حَتّى تَرى اللَيثَ قُنفُذا",5,"ذ",2,0],["وصمت مرير دون ما فيه من أسى","بكاء الثكالى والتفجّع والندب",6,"ب",1,0],["وصِمةٌ بطلٌ ذَمَرْكَمٍ دهقاً","كل الطغاة ومنه الطاغي مدّهقُ",7,"ق",1,0],["وصممُ علمِ النحو أصبحَ ذاوياً","بعد اخضرارِ العودِ والأغْصانِ",8,"ن",1,0],["وَصَمَّ صَدَى الأَسْمَاعِ عَنْ هَدْيِ عُذَّلِي","فَأَخْفَقَ عُذَّالٌ لِذَاكَ وَوُعَّاظُ",9,"ظ",1,0],["وَصُم لَها بِالصَونِ لِلسِرِّ الَّذي","حُمِّلتَ مِنها عَن جَهولٍ ما حَمَل",10,"ل",1,0],["وصُمْ وأَفطِرْ بسَعْدٍ وارْمِ أَفئدةَ ال","حسّادِ يُصبِحْنَ من مُصمىً ومُنفطِر",11,"ر",1,0],["وصمصاماً بكفِّي لا","يذوقُ الماءَ مَن يَرِدُه",12,"د",2,0],["وصمتهمُ لو وافقوا توفيقَهم","لِعُلا أمير المؤمنينَ عبيدُ",13,"د",1,0],["وصم لشهر الصيام","وقم بأحسن قيام",14,"م",1,0],["وصم لفرضك وحج البيت طف في فناه","ولازم الذكر لله أن أردت ولاه",15,"ا",2,0],["وصم رمضان واحفظه","من أشيا مضرات",16,"ت",1,0],["وصُمَّ عنِّي صَدى صوتي وأفردَني","ظِلِّي وملَّ الكَرى والطيفُ غِشياني",17,"ن",2,0],["وصميم وجدٍ في الفوآد محكَّمٍ","اضنى قواي ومدمعي السيال",18,"ل",1,0],["وصمتُ ندامتِي برأسيْ مُجَلجِلا","فلو أنّهُ يعيدُني فأَتوبا",19,"ب",2,0],["وصمتَةِ قلبٍ غصّ منها بمعصَمٍ","ووَسواسُهُ الخنّاسُ ينفثُ في صدري",20,"ر",2,0],["وصمت عن الدنيا وأفطرت بالمنى","ولم يك إلاّ بالحديث تأدُّمي",21,"ي",1,0],["وصمّاءٍ بَثَثْتُ لها التّشكِّي","أُهوِّنُها وتأبى أن تَهونا",22,"ن",2,0],["وَصممتُما عنهُ وليسَ بهِ","ممّا يَخاف عليكما وِقْرُ",23,"ر",1,0],["وَصمَّ عنِ المغرينَ بالصّبرِ إنّهمْ","يطفّون ناراً ألْهبَ اللّه وقْدَها",24,"د",3,0]]}