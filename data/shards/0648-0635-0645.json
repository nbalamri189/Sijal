{"poems":[[79,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[0,"ألا عم صباحاً أيها الطلل البالي","https://www.aldiwan.net/poem51.html","الطويل"],[53,"أبا حسن طال المطال ولم يكن","https://www.aldiwan.net/poem64051.html","الطويل"],[48,"لأمواه الشبيبة كيف غضنه","https://www.aldiwan.net/poem23485.html","الوافر"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29336","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43697","الطويل"],[96,"الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=13793",""],[125,"بالبحر قيلولة والشوق أختنق","https://www.aldiwan.net/poem23821.html","البسيط"],[132,"بحر الفصاحة غاض يا إخواني","https://www.aldiwan.net/poem50494.html","الكامل"],[242,"أعدت نبالا للحشا وهي ألحاظ","https://www.aldiwan.net/poem18845.html","الطويل"],[354,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[369,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[370,"تمناني ليقتلني وأنت","https://www.aldiwan.net/poem44519.html","مجزوء الوافر"],[376,"بركات مولانا عليك تعود","https://www.aldiwan.net/poem57476.html","الكامل"],[396,"ياطالبا للوصيه","https://www.aldiwan.net/poem54448.html","عموديه"],[396,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[396,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[415,"حسبي من العيش كم لاقيت فيه أذى","https://www.aldiwan.net/poem31849.html","البسيط"],[505,"وحياتكم يا أهل منعرج اللوى","https://www.aldiwan.net/poem37677.html","الكامل"],[510,"الحساب","https://www.aldiwan.net/poem56767.html","الطويل"],[519,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[532,"لعمرك لولا آل بوية في الورى","https://www.aldiwan.net/poem45990.html","الطويل"],[556,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[556,"منا الوصال ومنكم الهجر","https://www.aldiwan.net/poem47827.html","أحذ الكامل"],[556,"ألا هل أتاها كيف حزني بعدها","https://www.aldiwan.net/poem47860.html","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130197","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38208","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77640","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77552","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145821","المتقارب"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44790","السريع"],[1015,"","https://poetry.dctabudhabi.ae/diwan/poem/131918","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59414","السريع"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133824","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56205","الطويل"],[1192,"","https://poetry.dctabudhabi.ae/diwan/poem/74120","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64624","الكامل"],[1449,"","https://poetry.dctabudhabi.ae/diwan/poem/110675","الطويل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87833","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202152","المجتث"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104957","الرمل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124785","الوافر"],[2313,"","https://poetry.dctabudhabi.ae/diwan/poem/123318","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137097",""],[501,"","https://poetry.dctabudhabi.ae/diwan/poem/142582","الكامل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116501","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65972","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94316","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74202","الطويل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35918","المجتث"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131255",""],[3882,"","https://poetry.dctabudhabi.ae/diwan/poem/124627","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102931","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102977","الطويل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29277","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[3959,"","https://poetry.dctabudhabi.ae/diwan/poem/73860","الطويل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199069","الطويل"],[4250,"","https://poetry.dctabudhabi.ae/diwan/poem/31540","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133066","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72696","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120361","الوافر"],[4755,"عِندِي قَصِيدَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=183677",""],[4755,"لِأَنَّكَ كُنْتَهُنَّ ولَم يَكُنَّكْ","https://www.poetsgate.com/ViewPoem.aspx?id=183838",""],[4755,"هَدِيرٌ على الأَطلالِ","https://www.poetsgate.com/ViewPoem.aspx?id=207775",""],[4984,"الْعَرَبَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=201917",""],[231,"الإنسان الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=186167",""],[5111,"تَعْوِيذَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212213",""],[5111,"صَفْوَةُ الْعِشْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=212624",""],[5259,"ضاءت بنور غيابك الأيامُ","https://www.poetsgate.com/ViewPoem.aspx?id=186807",""],[5327,"وَصَماتُ الغَدرِ","https://www.poetsgate.com/ViewPoem.aspx?id=144598",""],[5431,"صفقة العهر ...ليس من خان منّا","https://www.poetsgate.com/ViewPoem.aspx?id=209119",""],[5730,"حديث مع النفس","https://www.poetsgate.com/ViewPoem.aspx?id=210347",""],[5913,"جريمة حب","https://www.poetsgate.com/ViewPoem.aspx?id=177073",""],[5956,"قد دهانا الانفصال","https://www.poetsgate.com/ViewPoem.aspx?id=192969",""],[5956,"لولا أحبكَ هل يجيشُ قصيدي؟","https://www.poetsgate.com/ViewPoem.aspx?id=193370",""],[5957,"وحرفكَ زاهٍ بلا شارحة","https://www.poetsgate.com/ViewPoem.aspx?id=181596",""],[6106,"ما بين الهجرة والهجمة على سيد الخلق صلى الله عليه","https://www.poetsgate.com/ViewPoem.aspx?id=6303",""],[6147,"عقيم العمر ينتظر الجنين","https://www.poetsgate.com/ViewPoem.aspx?id=151501",""],[242,"أعدت نبالا للحشا وهي الحاظ","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563779",""],[5724,"أم الربيعين ابسمي وتهللي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55135&r=&rc=2",""],[6256,"تحية أدباء المغرب العربي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65918&r=&rc=6",""],[6285,"هذه الشام لا تقولي كفانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86807&r=&rc=0",""]],"verses":[["وَصَمَّ صَدَى الدُّنْيَا فَلَمَّا رَجَمْتَهَا","تَزَاحَمَ مُرْتَادٌ عَلَيْهَا وَمُخْتَطُّ",0,"ط",1,0],["وَصُمٌّ صِلابٌ ما يَقينَ مِنَ الوَجى","كَأَنَّ مَكانَ الرِدفِ مِنهُ عَلى رَألِ",1,"ل",1,0],["وصمتي ومطِّي حاجبي وإشاحتي","بوجهي إذا سمَّى ليَ اسمَك ذاكر",2,"ر",1,0],["وَصُم رَمَضانَ مُختاراً مُطيعاً","إِذِ الأَقدامُ مِن قَيظٍ رَمِضنَه",3,"ن",2,0],["وصم الحوامي لا يبالي إذا عدا","أوعث نقاعنت له أو جنادل",4,"ل",1,0],["وصمْتِ الخليقة في بعثهم","كأنهم الحدَثُ المنكرُ",5,"ر",1,0],["وَصُمُّ الأَعادي تَقشعرُّ لِذِكرِهِ","جُلودهُمُ حَتّى تَرى اللَيثَ قُنفُذا",6,"ذ",2,0],["وصمت مرير دون ما فيه من أسى","بكاء الثكالى والتفجّع والندب",7,"ب",1,0],["وصِمةٌ بطلٌ ذَمَرْكَمٍ دهقاً","كل الطغاة ومنه الطاغي مدّهقُ",8,"ق",1,0],["وصممُ علمِ النحو أصبحَ ذاوياً","بعد اخضرارِ العودِ والأغْصانِ",9,"ن",1,0],["وَصَمَّ صَدَى الأَسْمَاعِ عَنْ هَدْيِ عُذَّلِي","فَأَخْفَقَ عُذَّالٌ لِذَاكَ وَوُعَّاظُ",10,"ظ",1,0],["وَصُم لَها بِالصَونِ لِلسِرِّ الَّذي","حُمِّلتَ مِنها عَن جَهولٍ ما حَمَل",11,"ل",1,0],["وصُمْ وأَفطِرْ بسَعْدٍ وارْمِ أَفئدةَ ال","حسّادِ يُصبِحْنَ من مُصمىً ومُنفطِر",12,"ر",1,0],["وصمصاماً بكفِّي لا","يذوقُ الماءَ مَن يَرِدُه",13,"د",2,0],["وصمتهمُ لو وافقوا توفيقَهم","لِعُلا أمير المؤمنينَ عبيدُ",14,"د",1,0],["وصم لشهر الصيام","وقم بأحسن قيام",15,"م",1,0],["وصم لفرضك وحج البيت طف في فناه","ولازم الذكر لله أن أردت ولاه",16,"ا",2,0],["وصم رمضان واحفظه","من أشيا مضرات",17,"ت",1,0],["وصُمَّ عنِّي صَدى صوتي وأفردَني","ظِلِّي وملَّ الكَرى والطيفُ غِشياني",18,"ن",2,0],["وصميم وجدٍ في الفوآد محكَّمٍ","اضنى قواي ومدمعي السيال",19,"ل",1,0],["وصمتُ ندامتِي برأسيْ مُجَلجِلا","فلو أنّهُ يعيدُني فأَتوبا",20,"ب",2,0],["وصمتَةِ قلبٍ غصّ منها بمعصَمٍ","ووَسواسُهُ الخنّاسُ ينفثُ في صدري",21,"ر",2,0],["وصمت عن الدنيا وأفطرت بالمنى","ولم يك إلاّ بالحديث تأدُّمي",22,"م",2,0],["وصمّاءٍ بَثَثْتُ لها التّشكِّي","أُهوِّنُها وتأبى أن تَهونا",23,"ن",2,0],["وَصممتُما عنهُ وليسَ بهِ","ممّا يَخاف عليكما وِقْرُ",24,"ر",1,0],["وَصمَّ عنِ المغرينَ بالصّبرِ إنّهمْ","يطفّون ناراً ألْهبَ اللّه وقْدَها",25,"د",3,0],["وصمصامة شكل المنون مصور","بها تقبض الآجال قبل التجرد",26,"د",1,0],["وَصَمَّموا عَزمَهُم في حَربِهِم بَطلاً","ظَلَّت أُسودُ الشّرى خَوفاً تُراضيهِ",27,"ي",2,0],["وَصَمم الأَعمى عَلى أَن يَحفَظَه","وَكَذَّب الشَيخ الَّذي قَد وَعَظَه",28,"ه",1,0],["وَصَمَّموا جَزماً عَلى اِجتِنابه","وَالمَكر لا يُطلى عَلى أَربابه",29,"ه",1,0],["وصمتكَ والخوفُ فأسان فيها","يذوبان في موقدٍ من نوايا",30,"ا",3,0],["وَصَمتُكَ الرائِعُ يا موحِشي","بَغَّضَ لي الصَوتَ الحَنونَ الطَروبْ",31,"ب",1,0],["وصم مسامعي زعقات جرد","اذا صهلت ومالت للطراد",32,"د",1,0],["وصمت في الرمضا وقمت الدجى","فقمت بالخدمة أوفى قيام",33,"م",1,0],["وصمة ان تظل في الأسر أخت","أهلها الأقربون في الأحياء",34,"ا",2,0],["وصمصامه الهنديّ في كفّه غدا","بسفك دماء الظالمين مكفّلا",35,"ل",2,0],["وَصمّاء ملء الكفّ مِن يابسِ الصفا","لَها قَلبُ مَحبوبٍ وَكَفُّ بَخيل",36,"ل",1,1],["وصمغه كزاجه في وزنه","وصف واكتب عاجلا من حينه",37,"ه",1,0],["وصمتني النكبات أن ألقيتني","أين الحلوم الراسيات أكامها",38,"م",3,0],["وصم لها سمعي وتأتأ مقولي","وطاش من العقل السليم بنا الفكر",39,"ر",1,0],["وَصَمةٌ غادَرَت حَياتَكِ جَردا","كَما غادَرَ الشِتاءُ الخَميلَه",40,"ل",2,0],["وصم عن نداها","محبذو السلام",41,"م",1,0],["وصمونا فيه بالرفض وذو ال","حلمِ لا يعنيه قول الجاهلينا",42,"ن",2,0],["وصم مهما استطعت تجده ريا","إذا ما قمت ظمآنا سغيبا",43,"ب",2,0],["وصمت وتسهيد وموت بحبه","وتحسين أوصاف وتجويع معدة",44,"ه",1,0],["وصموك وصمة عارهم وهم الألى","باءوا باثمهم وغيظ الباري",45,"ر",2,0],["وَصُمُودُنَا وَقَوَافِلُ الأبطَالِ، مَنْ ضَحّوا وَرَاحوا","يا شَامُ، يا بَوّابَةَ التّارِيخِ، تَحرُسُكِ الرِّمَاحُ",46,"ح",1,0],["وصمت عن مناد سواك مبعد مضمضة","عنى وعنه وعن هاد ومن عذلا",47,"ل",2,0],["وصمم أمام الحور فالحور في الوغي","تميط لثاماً بعدها في المعارك",48,"ك",1,0],["وصم وقم ليلا وأد فرضا","والزم تقى وبالقضاء فارصا",49,"ص",2,0],["وَصم عَن سراه وَاعتكف في شُهوره","وَحج إِلَيهِ تارك الجن وَالأُنس",50,"س",1,0],["وصم بسر عن الاغيار اجمعها","وافطر على تمر عين العين وائتدم",51,"م",1,0],["وَصُمتَ دَهرَكَ لا مُف","طِراً وَلا يَومَ جُمعَه",52,"ع",2,0],["وصمتاً فهو أفضل ما يقيكم","نوائب قد تنوبكم سراعا",53,"ع",2,0],["وصُم إن شَهِدتَّ الشهرَ لكن بِنِيَّةٍ","ولا تتعرض فيه كل البوائق",54,"ق",1,0],["وصمم إذا ما أمكنتك مضارب","الأرب خير كان بالشر يجلب",55,"ب",1,0],["وصمت ملوك الأرض عما أقوله","وماذا عسى تجدي الجياع الجواهر",56,"ر",1,0],["وَصَمتُها مَقطوع","يَنهَبُهُ الحُزنُ",57,"ن",1,0],["وصم أجوابٍ تصد الحمام","فطفقت تبسم تلك البطاح",58,"ح",1,0],["وَصَمَّاءَ مِلءِ الكَفِّ مِن يابِسِ الصَّفا","حَكَت قَلبَ مَحبوبٍ وَكَفَّ بَخيلِ",59,"ل",1,1],["وصمت بإيمان وقمت بطاعة","تقدم ما أولى وتستوعب الذكرا",60,"ر",2,0],["وَصَمَّمَ وَسطَهُم سُفيانُ لَمّا","أَلَمَّ بِهِم عَن الوِردِ الشِياحُ",61,"ح",1,0],["وصم وحج وبادر يا اخي فتناً","واخلص مع الله في سرٍ وإعلان",62,"ن",1,0],["وصمصامها بكفي صليل","ولأعلامها علي خفوق",63,"ق",1,0],["وصم عن الدليل ولم يزده","سوى هوج وافجاس قيح",64,"ح",1,0],["وصَمتٌ بلا رِجلَينِ يَعدُو وَرَاءَنا","وصَوتٌ على رِجلَيهِ مِن خَوفِهِ فَمُ",65,"م",1,0],["وصَمتُكَ صَوتُ والِدَةٍ تُناغِي","رَضِيعًا كَي تَقُولَ: سَبَقتَ سِنَّكْ",66,"ك",1,0],["وصَمْتٌ على الجدرانِ يَطْفُو كَأَنَّهُ","عِتابٌ لَهُ الرَّحمنُ في العَرشِ وَاقِفُ",67,"ف",1,0],["وصمموا أن يبيدوا كل ما صنعوا","ويتركوا أرضنا من خلفهم خربة",68,"ب",2,0],["وصمتٌ فما في الكون صوت ولا صدى","ولا خفقةٌ يُحيي بها الكون شاعر",69,"ر",1,0],["وَصُمُوتُهُ السَّكْرَى تَضُمُّ هُيَامَنَا","فَتُسَبّحُ الأشْوَاقُ فِي الأسْحَارِ",70,"ر",1,0],["وَصَمْتِي مَوْجَةُالرَّيَ