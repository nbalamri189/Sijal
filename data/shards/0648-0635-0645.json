{"poems":[[77,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[0,"ألا عم صباحاً أيها الطلل البالي","https://www.aldiwan.net/poem51.html","الطويل"],[51,"أبا حسن طال المطال ولم يكن","https://www.aldiwan.net/poem64051.html","الطويل"],[46,"لأمواه الشبيبة كيف غضنه","https://www.aldiwan.net/poem23485.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43697","الطويل"],[119,"بالبحر قيلولة والشوق أختنق","https://www.aldiwan.net/poem23821.html","البسيط"],[126,"بحر الفصاحة غاض يا إخواني","https://www.aldiwan.net/poem50494.html","الكامل"],[235,"أعدت نبالا للحشا وهي ألحاظ","https://www.aldiwan.net/poem18845.html","الطويل"],[347,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[362,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[363,"تمناني ليقتلني وأنت","https://www.aldiwan.net/poem44519.html","مجزوء الوافر"],[369,"بركات مولانا عليك تعود","https://www.aldiwan.net/poem57476.html","الكامل"],[388,"ياطالبا للوصيه","https://www.aldiwan.net/poem54448.html","عموديه"],[388,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[388,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[406,"حسبي من العيش كم لاقيت فيه أذى","https://www.aldiwan.net/poem31849.html","البسيط"],[498,"وحياتكم يا أهل منعرج اللوى","https://www.aldiwan.net/poem37677.html","الكامل"],[503,"الحساب","https://www.aldiwan.net/poem56767.html","الطويل"],[512,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[525,"لعمرك لولا آل بوية في الورى","https://www.aldiwan.net/poem45990.html","الطويل"],[549,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[549,"منا الوصال ومنكم الهجر","https://www.aldiwan.net/poem47827.html","أحذ الكامل"],[549,"ألا هل أتاها كيف حزني بعدها","https://www.aldiwan.net/poem47860.html","الطويل"]],"verses":[["وَصَمَّ صَدَى الدُّنْيَا فَلَمَّا رَجَمْتَهَا","تَزَاحَمَ مُرْتَادٌ عَلَيْهَا وَمُخْتَطُّ",0,"ط",1,0],["وَصُمٌّ صِلابٌ ما يَقينَ مِنَ الوَجى","كَأَنَّ مَكانَ الرِدفِ مِنهُ عَلى رَألِ",1,"ل",1,0],["وصمتي ومطِّي حاجبي وإشاحتي","بوجهي إذا سمَّى ليَ اسمَك ذاكر",2,"ر",1,0],["وَصُم رَمَضانَ مُختاراً مُطيعاً","إِذِ الأَقدامُ مِن قَيظٍ رَمِضنَه",3,"ن",2,0],["وصمْتِ الخليقة في بعثهم","كأنهم الحدَثُ المنكرُ",4,"ر",1,0],["وَصُمُّ الأَعادي تَقشعرُّ لِذِكرِهِ","جُلودهُمُ حَتّى تَرى اللَيثَ قُنفُذا",5,"ذ",2,0],["وصِمةٌ بطلٌ ذَمَرْكَمٍ دهقاً","كل الطغاة ومنه الطاغي مدّهقُ",6,"ق",1,0],["وصممُ علمِ النحو أصبحَ ذاوياً","بعد اخضرارِ العودِ والأغْصانِ",7,"ن",1,0],["وَصَمَّ صَدَى الأَسْمَاعِ عَنْ هَدْيِ عُذَّلِي","فَأَخْفَقَ عُذَّالٌ لِذَاكَ وَوُعَّاظُ",8,"ظ",1,0],["وَصُم لَها بِالصَونِ لِلسِرِّ الَّذي","حُمِّلتَ مِنها عَن جَهولٍ ما حَمَل",9,"ل",1,0],["وصُمْ وأَفطِرْ بسَعْدٍ وارْمِ أَفئدةَ ال","حسّادِ يُصبِحْنَ من مُصمىً ومُنفطِر",10,"ر",1,0],["وصمصاماً بكفِّي لا","يذوقُ الماءَ مَن يَرِدُه",11,"د",2,0],["وصمتهمُ لو وافقوا توفيقَهم","لِعُلا أمير المؤمنينَ عبيدُ",12,"د",1,0],["وصم لشهر الصيام","وقم بأحسن قيام",13,"م",1,0],["وصم لفرضك وحج البيت طف في فناه","ولازم الذكر لله أن أردت ولاه",14,"ا",2,0],["وصم رمضان واحفظه","من أشيا مضرات",15,"ت",1,0],["وصُمَّ عنِّي صَدى صوتي وأفردَني","ظِلِّي وملَّ الكَرى والطيفُ غِشياني",16,"ن",2,0],["وصميم وجدٍ في الفوآد محكَّمٍ","اضنى قواي ومدمعي السيال",17,"ل",1,0],["وصمتُ ندامتِي برأسيْ مُجَلجِلا","فلو أنّهُ يعيدُني فأَتوبا",18,"ب",2,0],["وصمتَةِ قلبٍ غصّ منها بمعصَمٍ","ووَسواسُهُ الخنّاسُ ينفثُ في صدري",19,"ر",2,0],["وصمت عن الدنيا وأفطرت بالمنى","ولم يك إلاّ بالحديث تأدُّمي",20,"ي",1,0],["وصمّاءٍ بَثَثْتُ لها التّشكِّي","أُهوِّنُها وتأبى أن تَهونا",21,"ن",2,0],["وَصممتُما عنهُ وليسَ بهِ","ممّا يَخاف عليكما وِقْرُ",22,"ر",1,0],["وَصمَّ عنِ المغرينَ بالصّبرِ إنّهمْ","يطفّون ناراً ألْهبَ اللّه وقْدَها",23,"د",3,0]]}