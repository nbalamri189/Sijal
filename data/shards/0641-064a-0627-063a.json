{"poems":[[53,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[51,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[70,"أما آن للبدر المنير طلوع","https://www.aldiwan.net/poem42827.html","الطويل"],[70,"يغيب إذا غبت عني السرور","https://www.aldiwan.net/poem42852.html","الطويل"],[80,"ننام من الأيام في غرض النبل","https://www.aldiwan.net/poem31332.html","الطويل"],[44,"هو الدهر لا يشوي وهن المصائب","https://www.aldiwan.net/poem30323.html","الطويل"],[50,"أصفراء ما أنسى هواك ولا ودي","https://www.aldiwan.net/poem63934.html","الطويل"],[46,"لأمواه الشبيبة كيف غضنه","https://www.aldiwan.net/poem23485.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85558","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142339","الرمل"],[95,"جبل","https://www.poetsgate.com/ViewPoem.aspx?id=716",""],[211,"وحقك ما للبدر حسنك في التم","https://www.aldiwan.net/poem13310.html","الطويل"],[212,"جلسنا نسطر أحلامنا","https://www.aldiwan.net/poem46268.html","المتقارب"],[230,"تميط الأذى عن حامليها الصوارم","https://www.aldiwan.net/poem50832.html","الطويل"],[236,"حان إسفار الصباح","https://www.aldiwan.net/poem32120.html","مجزوء الرمل"],[299,"ذر العين تقض اليوم بعضض ديونها","https://www.aldiwan.net/poem36325.html","عموديه"],[354,"لولا العذار ولولا طرفك الساجي","https://www.aldiwan.net/poem40547.html","البسيط"],[354,"قلوب الورى في مطمح الفكر قلب","https://www.aldiwan.net/poem40825.html","الطويل"],[370,"بما حوت الأجفان نفدي عصابة","https://www.aldiwan.net/poem4300.html","الطويل"],[372,"معي كلمات ما يطاق احتمالها","https://www.aldiwan.net/poem57213.html","الكامل"],[378,"نصحتك نصحا قل من شأنه النصح","https://www.aldiwan.net/poem66888.html","الطويل"],[404,"شكت بلسان الحال طول جفاها","https://www.aldiwan.net/poem33365.html","الطويل"],[404,"أما آن عما أنت فيه متاب","https://www.aldiwan.net/poem34163.html","الطويل"],[442,"نكابد في الدنيا هموما وأحزانا","https://www.aldiwan.net/poem14485.html","الطويل"],[465,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[507,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[552,"رقدت وأسهرت ليلا طويلا","https://www.aldiwan.net/poem47320.html","المتقارب"],[552,"رأيت فلم أر فيما رأيت","https://www.aldiwan.net/poem47836.html","المتقارب"]],"verses":[["فَيا غَيثاً يَغيضُ الغَي","ثُ إِن هَجَمَت هَوامِرُه",0,"ر",2,0],["فيا غَوثاً هناك بقَيْدِ ثأري","إذا ما الثأرُ فات يدَ الطِّلابِ",1,"ب",1,0],["فَيا غائِباً ما غابَ إِلّا بِوَجهِهِ","وَلي أَبَداً شَوقٌ لَهُ وَوَلوعُ",2,"ع",1,0],["فَيا غائِباً لَو وَجَدنا إِلَي","هِ سَبيلاً مَشَينا عَلى الأَرؤُسِ",3,"س",1,0],["فيا غرسةً للأجرِ كنتُ نقلتُها","إلى كَنَفَيْ صَوْني وألحَفتُها ظلِّي",4,"ل",2,0],["فَيا غالِباً لا غالِبٌ لِرَزِيَّةٍ","بَلِ المَوتُ لاشَكَّ الَّذي هُوَ غالِبُ",5,"ب",1,0],["فَيا غادِياً يَختالُ في العِطرِ وَالحُلى","وَيا واقِفاً يَبكي مُقيماً عَلى فَقدِ",6,"د",1,0],["فَيا غَضّاً مِنَ الفِتيانِ خَيرٌ","مِنَ اللَحَظاتِ أَبصارٌ غُضِضنَه",7,"ن",2,0],["فَيا غرب لا تجرح من الشرق قبله","بإيراد دعوى أنك اليوم أَعلم",8,"م",1,0],["فَيَا غَازِياً ذَاكَ إِعْجَازُهُ","وَيَا نَاظِماً ذَاك مَا صَوَّرَا",9,"ر",2,0],["في أغاني الشوق في الذكرى","وفي الحبذ الدفين",10,"ن",1,0],["فيا غربة الأحرار ما أطول السرى","وملء غيابات الدروب غياهب",11,"ب",1,0],["فيا غصن حتى ما تضاهى قوامه","وقد قصرت عنه طوال القنا الشم",12,"م",1,0],["فيا غصننا مزهرا في البلاد","أجبنى وقل لي متى تثمر",13,"ر",1,0],["فيا غالباً ما دَام يلقى محارِباً","ويأيّها المغلوبُ حين يُسالم",14,"م",1,0],["في اِغتِباقٍ بِتَباشي","رِ التَهاني وَاِصطِباحِ",15,"ح",1,0],["فيا غلةً لم يطفها فيضُ أدمعي","وكيف وما يرفضُّ غيرُ سخينها",16,"ن",3,0],["فَيا غَنيّاً عَن المَعنى البَديع ألا","رِفقاً بِصبٍّ إِلى لُقياك مُحتاجِ",17,"ج",1,0],["فَيا غايَةَ الآمال قُل لي إِلى مَتى","أُغالب فيكَ الشَوقَ وَالشَوقُ أَغلَبُ",18,"ب",1,0],["فيا غفلة الواشين عنا وعنهُم","وقد ضَّمنا ذاك الطريق وإياهم",19,"م",1,0],["فيا غيثُ لا تَعرِض ليُمناهُ بَعدَما","بدا لكَ عندَ الجودِ والبأسِ حالُها",20,"ل",3,0],["فيا غافلاً وابن العفاف فريسةٌ","لذئب الزنا يعتاده ذلك السفح",21,"ح",1,0],["فيا غادة قد نالها من يسوؤها","وطال عليها كربها وعناها",22,"ا",3,0],["فيا غربة هل يُرتجى منك أوبةٌ","فيجبر من هذا البعاد مصاب",23,"ب",1,0],["فيا غافلاً عما يراد بحاله","أراك نؤوما ميت القلب يقظانا",24,"ن",2,0],["فيا غيثُ طبقت كلَّ البقاعِ","فسيانِ عندك نجدٌ ووهد",25,"د",1,0],["فَيَا غُصُناً حَقَّت أزَاهِرُ حُسنِهِ","تُحَلِّيكَ أجفَانِي بشلُؤلُؤِهَا الرَّطبِ",26,"ب",1,0],["فيا غيثنا لا تَرِمْ أرضنا","ويا شمسَنا لا تجزنا أُفولا",27,"ل",2,0],["فيا غافلاً عن طروقِ الحمامِ","رَقدتَ اِغتراراً ولم يرقُدِ",28,"د",1,0]]}