{"poems":[[55,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[53,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[72,"أما آن للبدر المنير طلوع","https://www.aldiwan.net/poem42827.html","الطويل"],[72,"يغيب إذا غبت عني السرور","https://www.aldiwan.net/poem42852.html","الطويل"],[82,"ننام من الأيام في غرض النبل","https://www.aldiwan.net/poem31332.html","الطويل"],[46,"هو الدهر لا يشوي وهن المصائب","https://www.aldiwan.net/poem30323.html","الطويل"],[52,"أصفراء ما أنسى هواك ولا ودي","https://www.aldiwan.net/poem63934.html","الطويل"],[48,"لأمواه الشبيبة كيف غضنه","https://www.aldiwan.net/poem23485.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85558","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/142339","الرمل"],[97,"جبل","https://www.poetsgate.com/ViewPoem.aspx?id=716",""],[111,"سقى الله سوحا منبتي من جنابها","https://www.poetsgate.com/ViewPoem.aspx?id=518",""],[214,"وحقك ما للبدر حسنك في التم","https://www.aldiwan.net/poem13310.html","الطويل"],[215,"جلسنا نسطر أحلامنا","https://www.aldiwan.net/poem46268.html","المتقارب"],[234,"تميط الأذى عن حامليها الصوارم","https://www.aldiwan.net/poem50832.html","الطويل"],[240,"حان إسفار الصباح","https://www.aldiwan.net/poem32120.html","مجزوء الرمل"],[303,"ذر العين تقض اليوم بعضض ديونها","https://www.aldiwan.net/poem36325.html","عموديه"],[358,"لولا العذار ولولا طرفك الساجي","https://www.aldiwan.net/poem40547.html","البسيط"],[358,"قلوب الورى في مطمح الفكر قلب","https://www.aldiwan.net/poem40825.html","الطويل"],[374,"بما حوت الأجفان نفدي عصابة","https://www.aldiwan.net/poem4300.html","الطويل"],[376,"معي كلمات ما يطاق احتمالها","https://www.aldiwan.net/poem57213.html","الكامل"],[382,"نصحتك نصحا قل من شأنه النصح","https://www.aldiwan.net/poem66888.html","الطويل"],[409,"شكت بلسان الحال طول جفاها","https://www.aldiwan.net/poem33365.html","الطويل"],[409,"أما آن عما أنت فيه متاب","https://www.aldiwan.net/poem34163.html","الطويل"],[447,"نكابد في الدنيا هموما وأحزانا","https://www.aldiwan.net/poem14485.html","الطويل"],[469,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[511,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[556,"رقدت وأسهرت ليلا طويلا","https://www.aldiwan.net/poem47320.html","المتقارب"],[556,"رأيت فلم أر فيما رأيت","https://www.aldiwan.net/poem47836.html","المتقارب"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88612","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130210","البسيط"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104609","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38976","الرجز"],[966,"","https://poetry.dctabudhabi.ae/diwan/poem/146430","الكامل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107204","الطويل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105463","المتقارب"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105443","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119873","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59430","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61088","المتقارب"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61062","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55973","الوافر"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64662","المتقارب"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64975","المتقارب"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136326","الطويل"],[1264,"","https://poetry.dctabudhabi.ae/diwan/poem/105518","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125480","الرمل"],[2027,"","https://poetry.dctabudhabi.ae/diwan/poem/101857","الطويل"],[2076,"","https://poetry.dctabudhabi.ae/diwan/poem/105244","المتقارب"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53115","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120733","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93564","الطويل"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110656","الطويل"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110671","البسيط"],[2750,"","https://poetry.dctabudhabi.ae/diwan/poem/143736","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65981","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132666","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100773","المتقارب"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87381","الطويل"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28834","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62760","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62826","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48349","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138562",""],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129405","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85126","الوافر"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105266","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127135","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90810","الوافر"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136586",""],[4346,"","https://poetry.dctabudhabi.ae/diwan/poem/100671","البسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117302","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133127","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133107","الوافر"],[4473,"","https://poetry.dctabudhabi.ae/diwan/poem/130602","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58177","الطويل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89584","الوافر"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22804","الوافر"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35098","الطويل"],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124660","الطويل"],[4691,"صباح الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=215888",""],[3464,"شموس سعوده هلت تبيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=158759",""],[4929,"اتعظ بالطير","https://www.poetsgate.com/ViewPoem.aspx?id=199799",""],[4984,"على ألمٍ في العيد","https://www.poetsgate.com/ViewPoem.aspx?id=175529",""],[4984,"نعمة المال","https://www.poetsgate.com/ViewPoem.aspx?id=187271",""],[5002,"من المنفى ...","https://www.poetsgate.com/ViewPoem.aspx?id=204712",""],[5145,"أسير وقلبي في هواك أسير","https://www.poetsgate.com/ViewPoem.aspx?id=108064",""],[5213,"لهوّن بعد اليوم ما يفعل الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=170487",""],[4572,"حمامة بلّغي عنّي سلاماً","https://www.poetsgate.com/ViewPoem.aspx?id=15009",""],[5290,"سريتم وطرفي من كرى العزم ما هبا","https://www.poetsgate.com/ViewPoem.aspx?id=113129",""],[592,"شكت فجشت مذ أعلنت بجشاها","https://www.poetsgate.com/ViewPoem.aspx?id=128712",""],[5431,"أن يظلّوا كشعلة مستنيره...","https://www.poetsgate.com/ViewPoem.aspx?id=198462",""],[5563,"لا بيت لي ولا صاحب","https://www.poetsgate.com/ViewPoem.aspx?id=214534",""],[243,"مأساة الميناء","https://www.poetsgate.com/ViewPoem.aspx?id=50470",""],[5703,"نار القلب","https://www.poetsgate.com/ViewPoem.aspx?id=206349",""],[5912,"أفعى","https://www.poetsgate.com/ViewPoem.aspx?id=202306",""],[5963,"إِذا كنتَ وادي النمل","https://www.poetsgate.com/ViewPoem.aspx?id=187379",""],[5970,"لنا أمل في أن يذيل لنا الغد","https://www.poetsgate.com/ViewPoem.aspx?id=130638",""],[5997,"أَعزِّيُّكِ يَا صَنْعَاء","https://www.poetsgate.com/ViewPoem.aspx?id=214288",""]],"verses":[["فَيا غَيثاً يَغيضُ الغَي","ثُ إِن هَجَمَت هَوامِرُه",0,"ر",2,0],["فيا غَوثاً هناك بقَيْدِ ثأري","إذا ما الثأرُ فات يدَ الطِّلابِ",1,"ب",1,0],["فَيا غائِباً ما غابَ إِلّا بِوَجهِهِ","وَلي أَبَداً شَوقٌ لَهُ وَوَلوعُ",2,"ع",1,0],["فَيا غائِباً لَو وَجَدنا إِلَي","هِ سَبيلاً مَشَينا عَلى الأَرؤُسِ",3,"س",1,0],["فيا غرسةً للأجرِ كنتُ نقلتُها","إلى كَنَفَيْ صَوْني وألحَفتُها ظلِّي",4,"ل",2,0],["فَيا غالِباً لا غالِبٌ لِرَزِيَّةٍ","بَلِ المَوتُ لاشَكَّ الَّذي هُوَ غالِبُ",5,"ب",1,0],["فَيا غادِياً يَختالُ في العِطرِ وَالحُلى","وَيا واقِفاً يَبكي مُقيماً عَلى فَقدِ",6,"د",1,0],["فَيا غَضّاً مِنَ الفِتيانِ خَيرٌ","مِنَ اللَحَظاتِ أَبصارٌ غُضِضنَه",7,"ن",2,0],["فَيا غرب لا تجرح من الشرق قبله","بإيراد دعوى أنك اليوم أَعلم",8,"م",1,0],["فَيَا غَازِياً ذَاكَ إِعْجَازُهُ","وَيَا نَاظِماً ذَاك مَا صَوَّرَا",9,"ر",2,0],["في أغاني الشوق في الذكرى","وفي الحبذ الدفين",10,"ن",1,0],["فيا غربة الأحرار ما أطول السرى","وملء غيابات الدروب غياهب",11,"ب",1,0],["فيا غرباء الأرض هل هي نجعة","تمن برجعاها عقيب اغترابها",12,"ب",3,0],["فيا غصن حتى ما تضاهى قوامه","وقد قصرت عنه طوال القنا الشم",13,"م",1,0],["فيا غصننا مزهرا في البلاد","أجبنى وقل لي متى تثمر",14,"ر",1,0],["فيا غالباً ما دَام يلقى محارِباً","ويأيّها المغلوبُ حين يُسالم",15,"م",1,0],["في اِغتِباقٍ بِتَباشي","رِ التَهاني وَاِصطِباحِ",16,"ح",1,0],["فيا غلةً لم يطفها فيضُ أدمعي","وكيف وما يرفضُّ غيرُ سخينها",17,"ن",3,0],["فَيا غَنيّاً عَن المَعنى البَديع ألا","رِفقاً بِصبٍّ إِلى لُقياك مُحتاجِ",18,"ج",1,0],["فَيا غايَةَ الآمال قُل لي إِلى مَتى","أُغالب فيكَ الشَوقَ وَالشَوقُ أَغلَبُ",19,"ب",1,0],["فيا غفلة الواشين عنا وعنهُم","وقد ضَّمنا ذاك الطريق وإياهم",20,"م",1,0],["فيا غيثُ لا تَعرِض ليُمناهُ بَعدَما","بدا لكَ عندَ الجودِ والبأسِ حالُها",21,"ل",3,0],["فيا غافلاً وابن العفاف فريسةٌ","لذئب الزنا يعتاده ذلك السفح",22,"ح",1,0],["فيا غادة قد نالها من يسوؤها","وطال عليها كربها وعناها",23,"ا",3,0],["فيا غربة هل يُرتجى منك أوبةٌ","فيجبر من هذا البعاد مصاب",24,"ب",1,0],["فيا غافلاً عما يراد بحاله","أراك نؤوما ميت القلب يقظانا",25,"ن",2,0],["فيا غيثُ طبقت كلَّ البقاعِ","فسيانِ عندك نجدٌ ووهد",26,"د",1,0],["فَيَا غُصُناً حَقَّت أزَاهِرُ حُسنِهِ","تُحَلِّيكَ أجفَانِي بشلُؤلُؤِهَا الرَّطبِ",27,"ب",1,0],["فيا غيثنا لا تَرِمْ أرضنا","ويا شمسَنا لا تجزنا أُفولا",28,"ل",2,0],["فيا غافلاً عن طروقِ الحمامِ","رَقدتَ اِغتراراً ولم يرقُدِ",29,"د",1,0],["فَيا غائباً قد أَودع القلب لوعة","وَجرعني كأس النوى والنوائب",30,"ب",1,0],["فيا غلامي نحوت الجود مجتهداً","أخطأت فيه فلا تستعتب القدرا",31,"ر",2,0],["فيا غادي البعادِ ألامَ سعياً","على قُربِ المزارِ بوشكِ بينِ",32,"ن",1,0],["فَيا غَياثَ المُستَغيث","أَنتَ لَنا رَبّي تُغيثْ",33,"ث",1,0],["فيا غصن النقا ويحل قدراً","قوامك أن أشبهه بغصن",34,"ن",1,0],["فيا غالِبَ الأَمجادِ في كلِّ مَشهَدٍ","إِذا حشَدُوا لِلمَكرُماتِ وأَلَّبوا",35,"ب",3,0],["فيا غائباً لا أغب الحيا","ضريحك يعتاده ممطرا",36,"ر",2,0],["فيا غاسليه حسبكم من طهوره","دموع له من خشية اللَه تسكب",37,"ب",1,0],["فيا غمر الرداء فداك غمر","يرى بر العفاة من العقوق",38,"ق",1,0],["فيا غاديا يطوي الفلا بعزائم","لها في غرامي سابق ونجيب",39,"ب",1,0],["فَيا غادرين عَلى رُسلِكم","غَدا القَلب من حُبِّكم مُقفرا",40,"ر",2,0],["فَيا غائِباً غص الزَّمان بِقُربه","فَأسهَمني مِنهُ ضُروب النوائب",41,"ب",1,0],["فيا غوث الورى كن لي واجل","صدا قلبي بما فيه المرامُ",42,"م",1,0],["فَيا غايَةَ السُّؤلِ مِنْ مُهْجَةٍ","بِهِ لَبَّسَتْ كلَّ أَسْوائِها",43,"ا",3,0],["فيا غافَل القَلْبِ عن","جَوايَ إِذا اللَّيلُ جَنْ",44,"ن",1,0],["فيا غافر الزلات سلك امح زلتي","وحقق متابي واذهب الهم والغما",45,"م",2,0],["فيا غيرة الإسلام هبي لمعضلٍ","به الملة البيضاء أدمعها حمر",46,"ر",1,0],["في أغاريد الهنا","والغَزل",47,"ل",1,0],["فيا غيرة الإسلام أين حماته","وذي خفرات الوحي مسلوبة البرد",48,"د",1,0],["فيا غائباً عندنا حاضر","يرى كل أمر بنا قد نزل",49,"ل",1,0],["فيا غامري بالجاه والمال بعدما","رأيت بعيني أيمن الحظ أيسرا",50,"ر",2,0],["فيا غُصناً نضراً ذوى عندما استوى","فأوحشني أضعافَ ما كان أنَّسا",51,"س",2,0],["فَيا غُصن النادي مَتى ليَ تَنثني","وَيا جؤذر الوادي متى لي تسنح",52,"ح",1,0],["فيا غاسليه حسبكم عن طهوره","دموع له من خشية اللَه تسكب",53,"ب",1,0],["فيا غريب صفات الفخر عز بأن","تقضي غريبا تعاني وارداً جانا",54,"ن",2,0],["فيا غائباً عن ناظري وهو حاضِرٌ","بقلبي، رعاك الله، في البُعد والقُرب",55,"ب",1,0],["فيا غافر الذنب العظيم تعاظمت","ذنوبي فكفرها وحطَّ حمائلي",56,"ل",2,0],["فيا غريراً عليه دمعي","يبدع تجنيسة المصحف",57,"ف",1,0],["فيا غرب مالك من خاذل","ويا شرق مالك من ناصر",58,"ر",1,0],["فَيا غصَّةً بين الزُلال وَبينها","مَهامِه يُعيي طيرَها بعضُ مشرَبِ",59,"ب",1,0],["فَيا غَضّ نَبتٍ حَرّ