{"poems":[[55,"ألا يا لقومي للخطوب الطوارق","https://www.aldiwan.net/poem29952.html","الطويل"],[9,"تصابيت أم بانت بعقلك زينب","https://www.aldiwan.net/poem21908.html","الطويل"],[73,"ألا سقياني فالظلام قد انجلى","https://www.aldiwan.net/poem3842.html","الطويل"],[53,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[26,"عرفت الديار لأم الرهين","https://www.aldiwan.net/poem24082.html","المتقارب"],[26,"ألا زعمت أسماء أن لا أحبها","https://www.aldiwan.net/poem24103.html","الطويل"],[31,"لقد غدوت على الندمان لا حصر","https://www.aldiwan.net/poem6163.html","البسيط"],[30,"لبسن الفرند الخسرواني دونه","https://www.aldiwan.net/poem5336.html","البسيط"],[68,"عجبت لها تمسي العقول لها نهبا","https://www.aldiwan.net/poem39205.html","الطويل"],[82,"بحكم زمان يا له كيف يحكم","https://www.aldiwan.net/poem31310.html","الطويل"],[54,"أعاذل دع لومي وهاك وهات","https://www.aldiwan.net/poem27195.html","الطويل"],[54,"يا من يفندني في اللهو والترب","https://www.aldiwan.net/poem27251.html","البسيط"],[50,"يا ليلة بالكرخ كم لذة","https://www.aldiwan.net/poem62544.html","السريع"],[50,"هذا قناع الليل محسور","https://www.aldiwan.net/poem63258.html","السريع"],[50,"عج للوقوف على راح وريحان","https://www.aldiwan.net/poem65297.html","البسيط"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29336","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54237","الوافر"],[79,"أمحي رسوم الأنس إن شئت أن تبقي","https://www.poetsgate.com/ViewPoem.aspx?id=34185",""],[79,"طرقنا ديور القوم وهنا وتليسا","https://www.poetsgate.com/ViewPoem.aspx?id=34193",""],[9,"تَصَابَيتَ أمْ بانَتْ بعَقْلِكَ زَيْنَبُ،","https://www.poetsgate.com/ViewPoem.aspx?id=20018",""],[96,"الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=13793",""],[215,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[234,"وساقية ترتمي بالحباب","https://www.aldiwan.net/poem51085.html","المتقارب"],[234,"ألا من لنفسي وأوصابها","https://www.aldiwan.net/poem51210.html","المتقارب"],[302,"لمن ساريات بين وهن وتغليس","https://www.aldiwan.net/poem33236.html","الطويل"],[358,"أدر راح الصفا ولك الأمان","https://www.aldiwan.net/poem39769.html","الوافر"],[401,"قد أصبح الحبل من أسماء مصروما","https://www.aldiwan.net/poem614.html",""],[435,"شجا القلب تذكار الأحبة والحمى","https://www.aldiwan.net/poem40503.html","الطويل"],[435,"طفل السرور من الصهباء مولود","https://www.aldiwan.net/poem40519.html","البسيط"],[435,"ألا حيي بكاسك واستنيري","https://www.aldiwan.net/poem41439.html","الوافر"],[463,"أتكتم يوم بانة أم تبوح","https://www.aldiwan.net/poem56247.html","الوافر"],[463,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[469,"ألمت نع الظلماء يهدى سلامها","https://www.aldiwan.net/poem3195.html","عموديه"],[469,"ويوم كظل السمهري قصرته","https://www.aldiwan.net/poem3348.html","عموديه"],[469,"صبر قلبي عان ودمعي طليق","https://www.aldiwan.net/poem3398.html","عموديه"],[469,"وهبت وقد سرت ذات الوشاح","https://www.aldiwan.net/poem3519.html","عموديه"],[469,"أوجداً وذياك الحمى ومنازله","https://www.aldiwan.net/poem3610.html","عموديه"],[487,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[564,"تنبه قد بدى شمس العقار","https://www.aldiwan.net/poem69363.html","الوافر"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107266","المتقارب"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107246","الوافر"],[788,"","https://poetry.dctabudhabi.ae/diwan/poem/206067","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130146","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130199","البسيط"],[1077,"","https://poetry.dctabudhabi.ae/diwan/poem/147565","الطويل"],[1264,"","https://poetry.dctabudhabi.ae/diwan/poem/105521","البسيط"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79418","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79895","البسيط"],[1638,"","https://poetry.dctabudhabi.ae/diwan/poem/205527","البسيط"],[1936,"","https://poetry.dctabudhabi.ae/diwan/poem/105198","الطويل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110632","الطويل"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111153","البسيط"],[2467,"","https://poetry.dctabudhabi.ae/diwan/poem/111760","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76166","البسيط"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205878","البسيط"],[2903,"","https://poetry.dctabudhabi.ae/diwan/poem/204542","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205077","المتقارب"],[3362,"","https://poetry.dctabudhabi.ae/diwan/poem/31667","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89185","الوافر"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20541","الطويل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101217","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66369","الوافر"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66462","الطويل"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139420",""],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94537","الوافر"],[4325,"","https://poetry.dctabudhabi.ae/diwan/poem/29462","المتقارب"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123462","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72629","البسيط"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136412",""],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136421",""],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132201","الطويل"],[4658,"","https://poetry.dctabudhabi.ae/diwan/poem/111552","السريع"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52136","المتقارب"],[4761,"سلافة العصر تلك التي","https://www.poetsgate.com/ViewPoem.aspx?id=127119",""],[5786,"إن رمتَ منّي السلوَّ بالفند","https://www.poetsgate.com/ViewPoem.aspx?id=50657",""],[6032,"نجم العشاق","https://www.poetsgate.com/ViewPoem.aspx?id=181517",""]],"verses":[["سُلافَةُ غَيثٍ شَلشَلتَها هَمِيَّةٌ","نَتيجَةُ أَنواءِ السَحابِ الرَقارِقِ",0,"ق",1,0],["سُلافٍ كَأَنَّ الزَعفَرانَ وَعَندَماً","يُصَفَّقُ في ناجودِها ثُمَّ تُقطَبُ",1,"ب",1,0],["سُلافاً كَأَنَّ المِسكَ كانَ لِدَنِّها","خِتاماً وَماءَ الوَردِ رَوّى صَعيدَها",2,"ه",2,0],["سُلّاف صدق فلا زال المليك لهم","بمثل أحمد في الخُلّاف خَلّافا",3,"ف",2,0],["سُلافَةُ راحٍ تُريكَ القَذى","تُصَفَّقُ في بَطنِ زِقٍّ وَجَر",4,"ر",1,0],["سُلافَةُ راحٍ ضُمِّنَتها إِداوَةٌ","مُقيَرَّةٌ رِدفٌ لِآخِرَةِ الرَحلِ",5,"ل",1,0],["سُلافَةٍ حَصَلَت مِن شارِفٍ خَلَقٍ","كَأَنَّما فارَ مِنها أَبجَلٌ نَعِرُ",6,"ر",1,0],["سُلافَةَ جَفنٍ خالَطَتها تَريكَةٌ","عَلى شَفَتَيها وَالذَكِيُّ المُسَوَّفُ",7,"ف",1,0],["سُلافٌ تُميتُ العَقلَ في حالِ شُربِها","وَيَنعَشُ مِنها الروحَ وَالجِسمَ وَالقَلبا",8,"ب",2,0],["سُلافَةُ كَرمٍ لَيسَ يَسخو بِمِثلِها","لِغَيرِ فَتى تَحْظَى لدَيه وَتُكْرَمُ",9,"م",1,0],["سُلافَةُ كَرمٍ فُجِّرَت في عُروشِها","جَداوِلُ ماءٍ مِن خَليجِ فُراتِ",10,"ت",1,0],["سُلافَةٌ وَرِثَتها عادُ عَن إِرَمٍ","كانَت ذَخيرَةَ كِسرى عَن أَبٍ وَأَبِ",11,"ب",1,0],["سُلافَةً تَضحَكُ في كَأسِها","عَذراءَ صانوها عَنِ الطَبخِ",12,"خ",1,0],["سُلافَةً لَم تَعتَصِرها يَدٌ","وَلَم يُدَنِّسها الأَعاصيرُ",13,"ر",1,0],["سُلافُ دَنٍّ إِذا ما الماءُ خالَطَها","فاحَت كَما فاحَ تُفّاحٌ بِلُبنانِ",14,"ن",1,0],["سلاف حديد ما يزال حسامه","ذليقاً وقدّته القرون الأوائل",15,"ل",1,0],["سُلاَفٌ تَنْهَلُ الأَرْوَاحُ مِنْهُ","وَتَحْمِلُهُ السُقَاةُ بِلاَ إِنَاءِ",16,"ا",2,0],["سلاف إذا لاحت لمحلولك الدجى","تعهدت لها الطراق في سبل الطرق",17,"ق",1,0],["سلافا حواها القار لبسا فخلته","مثالا من الياقوت في الحبر مغموسا",18,"س",2,0],["سلافٍ كأن الزغفرانَ، وعندماً،","يصفَّقُ في ناجودها ثمّ تقطبُ",19,"ب",1,0],["سلاف من الذكرى أديرت كؤوسها","فما شرب الندمان لكنّهم عبّوا",20,"ب",3,0],["سلاف صانها باكوس عما","يشوب الراح من إيم وعاب",21,"ب",1,0],["سُلاَف تسلَّف منها الزمان","قذاها وأبقى على خِيرها",22,"ر",3,0],["سُلاَفٌ إذا انتسبت للنَّديم","غدا الكَرْم أوكدَ أنسابِها",23,"ب",3,0],["سُلافٌ كست ضوءَ البُدور كؤوسُها","وَبَزَّت ضياءَ الشَمسِ في حال تَشميسِ",24,"س",1,0],["سلافاً مِن مُعتّقة التَهاني","سِوى الأَفراح لَيسَ لَها دِنانُ",25,"ن",1,0],["سلافة الدَّن مرفوعاً نصائبه","مقلَّد الغفو والريحان ملثوما",26,"م",2,0],["سلافة خمرٍ مرة الطعم قرقفا","لها حببٌ فاق الليالي بكنههِ",27,"ه",1,0],["سلافةً من قديم العصر صافيةً","لم يدر مولدها هودٌ وداودُ",28,"د",1,0],["سلافاً ليس يدركها زجاجٌ","لها كاس من العقل البصيرِ",29,"ر",1,0],["سلافةُ ريقِه بَسْلٌ حرامٌ","ووردةُ خدّه مما يُبيحُ",30,"ح",1,0],["سُلافةُ إخواني وصفوةُ إخوتي","ونُخبةُ أحبابي وجُلُّ قرائبي",31,"ب",2,0],["سلافٌ وسحرٌ ريقها ولحاظها","وشمسٌ ودرٌّ وجهها وكلامها",32,"م",3,0],["سلافاً إذا أدنى من الفم كأسها","فصبغتها في الخدّ بيّنةُ النفض",33,"ض",1,0],["سلافي ريق ما لمعسوله جنى","وخوطي قدٍ ما لعاله هصر",34,"ر",1,0],["سلافاً لا تدارُ على حرامٍ","يبعضُّ لهُ البنانُ ولا جناح",35,"ح",1,0],["سلافيَّةُ الأنفاس مسكيّة الصّبا","وآخرُ تهيامي إليها أوائله",36,"ل",2,0],["سلافتنا نمت على سطح حانة","أتت برقيق الغزل إرث النبوءة",37,"ه",1,0],["سُلافاً قدْ صَفتْ قِدْماً وَرَاقَتْ","أدِرْها بالصِّغار وبالكبارْ",38,"ر",1,0],["سُلافٌ مِنَ البُنِّ تُذكِي البَليدَ","وَتُنطِقُهُ نُطقَ قسِّ الفِصَاح",39,"ح",1,0],["سُلافٌ سَلسَلٌ راحٌ رَحِيقٌ","شِفاءُ الهَمِّ حَمراءٌ كُمَيتُ",40,"ت",1,0],["سلافة اسفنط بماء غمامة","تضمنها من صاحتين وقيع",41,"ع",1,1],["سلافا رشفنا من سلالة أحمد","فقمت لها أثني عليه وأحمد",42,"د",1,0],["سلافة قال من يتلو محاسنها","لا تذكر اللهو بعد اليوم والطربا",43,"ب",2,0],["سلافة لحظ أسكرتني ولم تكن","سلافة كأس عتقت من عقاره",44,"ر",2,0],["سلاف خمر به انتشينا","من غير نهل لنا ولا عل",45,"ل",1,0],["سلافٌ قصاراها زعافٌ ومركبٌ","شهيٌّ إذا اسْتَلْذَذْتَهُ فهو جامِحُ",46,"ح",1,0],["سُلافُها خلتَها ناراً وقُربانا","فمن طِلاً أشفعَت لي في استيافَتِه",47,"ه",1,0],["سلافة قرقف قد سيغ مشربه","كأنه منهل بالراح معلول",48,"ل",1,0],["سلاف دنان نحتسيها تعللا","وليس لدينا كأسها ومريرها",49,"ر",3,0],["سلافة عصر لم تفز بدنانها","جديس ولم تدرك لها جرهم عصرا",50,"ر",2,0],["سلافة الهبت خديه شعلتها","ومن طلاها غدت تطلى أنامله",51,"ل",2,0],["سلافة وَرِثَتها عادُ عن إرَمٍ","كانت ذخيرةَ كسرى عن أبٍ فأبِ",52,"ب",1,0],["سُلافة تَبدو","كَالكَوكَبِ الأَزهر",53,"ر",1,0],["سلافة من جنى فكري وعاطفتي","تديرها حول أرواح تناجيها",54,"ي",3,0],["سلافة كالقمر الباهر","في قدح كالكوكب الزاهر",55,"ر",1,1],["سلافي من طل أزهارها","ونقلي من دانيات الثمر",56,"ر",1,0],["سُلافُ أَعْنابٍ فَعُنْقودُها","مِنْ قَبْلِ أَنْ يُعْصَرَ مَعْصورُ",57,"ر",1,0],["سلافٌ فوق سالفك المفدى","تباح كما أبوح ببعض سرك",58,"ك",1,0],["سُلافَةَ دَنٍّ أَو سُلافَةَ ذارِعٍ","إِذا صُبَّ مِنهُ في الزُجاجةِ أَزبَدا",59,"د",2,0],["سلافة مذ دعتها كف عاصرها","ظلت معتقة من سالف الحقب",60,"ب",1,0],["سلافاً ما على الحاسي","لها في الشرع من حدِّ",61,"د",1,0],["سلافة آداب تدار كؤوسها","مِلاءً كما يسقي النديم نديمه",62,"م",2,0],["سلافة كرمٍ تظل النبيط","ترفع منه عريشاً عريشا",63,"ش",2,1],["سلافٌ ذكرُ بسماع عقلٍ","فيُنسي فعل صهباءِ الخمورِ",64,"ر",1,0],["سُلافَة صَهباءَ ماذِيَّةً","بفضّ المُسابئُ عَنها الجِرارا",65,"ر",2,0],["سُلافُ بلاغةٍ شُجَّتْ بلُطفٍ","فلا غَوْلٌ لديها ولا مَخافه",66,"ف",2,0],["سلافة مثل عين الديك صافية","في دنها عتقت جريا لها الحقب",67,"ب",1,1],["سلافة العصر ايا منيتي","أما تهاوينا وانا صغار",68,"ر",1,0],["سلافة رونق الآداب منه","حلت بمسامع الادباء رشفا",69,"ف",2,0],["سلافاً حواها القار لبساً فخلتها","مثالاً من الياقوت في الحبر مغموسا",70,"س",2,0],["سلافة صهباء سلساله","قد عتقت في دنها دهرا",71,"ر",2,0],["سلافُ نفوسٍ ومجلى كدرْ","وتعزيةٌ للفؤاد الحزينْ",72,"ن",1,0],["سلافة العصر تلك التي","غدا الفخر ثوبا لها يلبس",73,"س",1,1],["سلافةَ تبعثُ المسرَّةَ من","كفّ رشيق القوام ذي غَيدِ",74,"د",1,0],["سلافات ٍ تذيبُ شغاف قلب","ُو ترحلُ بالعقول ولا تعيد",75,"د",1,0]]}