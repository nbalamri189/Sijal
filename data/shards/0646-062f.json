net/poem56229.html","الوافر"],[458,"على أي أخلاقِ الزمان أعاتبه","https://www.aldiwan.net/poem56287.html","الطويل"],[458,"سلا دار البخيلة بالجناب","https://www.aldiwan.net/poem56296.html","الوافر"],[461,"لمعت كتلويح الرداء المسبل","https://www.aldiwan.net/poem15089.html","الكامل"],[461,"حي المهابة والندى قد أربيا","https://www.aldiwan.net/poem15156.html","الكامل"],[461,"خل التغزل للمشوق المغرم","https://www.aldiwan.net/poem15296.html","الكامل"],[461,"عمت شهامته كما شملت","https://www.aldiwan.net/poem15608.html","أحذ الكامل"],[461,"نيطت حمائل سيفه","https://www.aldiwan.net/poem16105.html","مجزوء الكامل"],[461,"بهاء الدين فارس كل فضل","https://www.aldiwan.net/poem16173.html","الوافر"],[461,"هنيئا للمواسم والتهاني","https://www.aldiwan.net/poem16421.html","الوافر"],[464,"عيون المهى قلبي بنبلك مجروح","https://www.aldiwan.net/poem3149.html","عموديه"],[464,"لنا بسمر الحمى في الحي أسمار","https://www.aldiwan.net/poem3186.html","عموديه"],[464,"سلوا بالحمى أين الظباء السوانح","https://www.aldiwan.net/poem3587.html","عموديه"],[468,"بلغت الفخر من همم رفاع","https://www.aldiwan.net/poem59909.html","الوافر"],[477,"يذكرني ثناياهنلما","https://www.aldiwan.net/poem15199.html","الوافر"],[477,"أعن أرض الغميم لمحت نارا","https://www.aldiwan.net/poem15207.html","الوافر"],[477,"عهد الصبا ومعاهد الأحباب","https://www.aldiwan.net/poem15221.html","الكامل"],[479,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[479,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[493,"نداك إذا ضن الغمام غمام","https://www.aldiwan.net/poem67326.html","الطويل"],[495,"كذا من شام بارقة الثنايا","https://www.aldiwan.net/poem10288.html","الوافر"],[500,"قل للذي فينا تمسك مخلصا","https://www.aldiwan.net/poem37724.html","الكامل"],[500,"أتانا من صبا نجد نسيم","https://www.aldiwan.net/poem37783.html","الوافر"],[500,"من خلف مسدل ستر الغيب لاح لنا","https://www.aldiwan.net/poem38084.html","البسيط"],[515,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[529,"نداء لأهل الكشف في كل موطن","https://www.aldiwan.net/poem37148.html","الطويل"],[529,"نداء لكل الناس فالأمر أعظم","https://www.aldiwan.net/poem37210.html","الطويل"],[529,"عجبا أين العقول","https://www.aldiwan.net/poem37269.html","مجزوء الرمل"],[538,"ملامكما كفا فقد قضي الأمر","https://www.aldiwan.net/poem48170.html","عموديه"],[540,"ندمت فلم أطق ردا لشعري","https://www.aldiwan.net/poem56878.html","الوافر"],[551,"لغير الغواني ما تجن الأضالع","https://www.aldiwan.net/poem47726.html","الطويل"],[551,"ما لي تطيح الدهر أخياري","https://www.aldiwan.net/poem47788.html","البسيط"],[558,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[558,"طيب الحبائب نفح يا حسنه من ند","https://www.aldiwan.net/poem34588.html","المواليا"],[562,"تنبهوا يا عباد الله واعتبروا","https://www.aldiwan.net/poem52799.html","البسيط"],[586,"يا راقد الطرف ما للطرف إغفاء","https://www.aldiwan.net/poem17396.html","البسيط"]],"verses":[["نَديما جَذيمَةَ لي في البِلاد","نَديمانِ وَالظُلمَةُ الداجِيَه",0,"ي",2,0],["نُداوي بِها مِن زَفرَةِ الشَوقِ أَنفُساً","تَطَلَّعُ ما بَينَ اللُهى وَالحَيازِمِ",1,"م",1,0],["نَدامايَ عَلى الهَمِّ","سَقى عَهدَكُمُ الوَبلُ",2,"ل",1,0],["نَديمي عَلى شُربِ الهُمومِ مُهَنَّدٌ","إِذا شاءَ أَصغى الهَمَّ دونَ مَقيلي",3,"ل",2,0],["نَدعوكَ حينَ الشَملُ مُنشَعِبٌ","فَتَلافَنا وَالرَأيُ مُختَلِفُ",4,"ف",1,0],["نَدعوكَ في سَنَةٍ شابَت ذَوائِبُها","حَتّى تُفَرِّجَها مُسوَدَّةُ القُصُبِ",5,"ب",1,0],["نَديمي رَعاكَ اللَهُ قُم غَنِّ لي عَلى","كُؤوسِ المَنايا مِن دَمٍ حينَ أَشرَبُ",6,"ب",1,0],["نُديرُ عَلى القَومِ مُستَبذَلاً","لَهُم بِالشَرابِ كَفيلاً ضَمينا",7,"ن",2,0],["نَدِمَ المُحِبُّ عَلى المُقامِ فَلَم يَزَل","مُذ غِبتِ بَينَ تَنَدُّمٍ وَتَلَهُّفِ",8,"ف",1,0],["نَدِمتُ عَلى ما كانَ مِنّي فَقُدتُني","كَما يَندَمُ المَغبونُ حينَ يَبيعُ",9,"ع",1,0],["نَديميَ علّلْني بمَشْمولَةٍ واسْقِ","ولا تولِجَنْ سَمْعي حَديثاً عنِ العِشْقِ",10,"ق",1,1],["ندىً لو حَواهُ البحْرُ لذّ مذاقُهُ","ولمْ يتعقّبْ مَدَّهُ أبداً جَزْرُ",11,"ر",1,0],["نَدَبْتَ إلَى الأَمْنِ الْبِلاَدَ وَأَهْلَهَا","وَلاَ قَلْبَ إِلاَّ بِالْمَخَافَةِ وَاجِبُ",12,"ب",1,0],["نَدِمتَ عَلى أَن لا تَكونَ كَمِثلِهِ","وَأَنَّكَ لَم تُرصِد لِما كانَ أَرصَدا",13,"د",2,0],["نُدَخِّنُ بِالنَهارِ لِتُبصِرينا","وَلا نَخفى عَلى أَحَدٍ بَغانا",14,"ن",2,0],["نَدِيٍّ عَلى الأَيّامِ يَزدادُ نَضرَةً","وَيَزدادُ فيها جِدَّةً وَهوَ يَقدُمُ",15,"م",1,0],["نَدِمتُ عَلى ما فاتَني يَومَ بنتُمُ","فَيا حَسرَتا أَلّا يَرَينَ عَويلي",16,"ل",2,0],["نَدْعُو الْوَفِّي إلى الحِفَا","ظِ وَنُكْبِرُ التَّقْصِيرُ عَابَا",17,"ب",2,0],["نَدْبٌ إِذَا مَا دَعَا","دَاعِي الْحُقُوقِ انْتَدَبْ",18,"ب",1,0],["نَدىً مِنَ الرَّحْمَةِ يَهمِي عَلَى","نِيرَانِ تِلْكَ الأَرْبَعِ الصَّالِيهْ",19,"ي",2,0],["نَدًى بِمَوَاقِعِ الحَاجَاتِ يَهْمِي","أَمِنْهُ تَعَلَّمَ الجُودَ الغَمَامُ",20,"م",1,0],["نُدِبْتُ لَهَا وَجرَّأَنِي اعْتِدادِي","بِأَقْدَارِ الَدعَاةِ عَلَى الْقِيامِ",21,"م",1,0],["نَدي المَحلِ بَسّامٍ إِذا الرَكبُ قَطَّعَت","أَحاديثَهُم يَهماءُ عارٍ مَقيلُها",22,"ل",3,0],["نَدىً وَتَكَرُّماً وَلُبابَ لُبّ","إِذا الأَشياءُ حَصَّلَتِ الرِجالا",23,"ل",2,0],["ندّكر شاعر البشر","خير من قال وافتكر",24,"ر",1,0],["ندكّ متون الحزن دكاً وإنها","لتنهب سهل الأرض في سيرها نهبا",25,"ب",2,0],["ندُك هضاب الأرض حتى نثيرها","غُباراً على أعدائنا يكثح الذعرا",26,"ر",2,0],["نُدافِعُ عَنكُم كُلَّ يَومِ عَظيمَةٍ","وَأَنتَ قُراحِيٌّ بِسَيفِ الكَواظِمِ",27,"م",1,0],["نَدِمتَ وَما تُغني النَدامَةُ بَعدَما","تَطَوَّحتَ مِن صَكِّ البُزاةِ الصَوائِدِ",28,"د",1,0],["نَدَسنا أَبا مَندوسَةَ القَينِ بِالقَنا","وَمارَ دَمٌ مِن جارِ بَيبَةَ ناقِعُ",29,"ع",1,0],["نَدِمتَ عَلى يَومِ السِباقَينِ بَعدَما","وَهيتَ فَلَم يوجَد لِوَهيِكَ راقِعُ",29,"ع",1,0],["ندعهُم مثل بارقَ أَو كَجَرم","وبئسَ بقيَّة المُستَظعَنِينَا",30,"ن",2,0],["نَديمِيَ النَجمُ طولَ لَيلي","حَتّى إِذا غارَتِ النُجومُ",31,"م",1,0],["نُدني بَني عَمِّنا إِلَينا","فَضلاً كَما يَفعَلُ الكَريمُ",31,"م",1,0],["نُدِلُّ عَلى مَوالينا وَنَجفو","وَنُعتِبُهُم وَإِن لَنا الذُنوبا",32,"ب",2,1],["نَدَبتَ لِحُسنِ الصَبرِ قَلبَ نَجيبِ","وَنادَيتَ بِالتَسليمِ خَيرَ مُجيبِ",33,"ب",1,1],["ندبٌ بدا كالشمس في أفق العلا","فتفرقت أهلُ العلا كهباء",34,"ا",2,0],["ندباً وشرعاً وجوب الحزن حين مضى","فأيّ حزن وقلب فيه لم يجب",35,"ب",1,0],["نديميَ هذا الغيثُ فامْزج بقطره","لنا قهوةً قد كادَ يذكو زجاجها",36,"ج",3,0],["نداه في الخلقِ ومدحي له","غذاء أرواحٍ وأجساد",37,"د",1,0],["نداماي من خودٍ وراحٍ وقينة","ثلاث شخوصٍ كاعبات ومعصر",38,"ر",1,0],["نداه وفصلنا والشهر فيه","ربيعٌ في ربيعٍ في ربيع",39,"ع",1,0],["ندبٌ عطفت أماديحي على نسقٍ","من فضلِه حبَّذا للفضل معطوف",40,"ف",1,0],["ندبٌ يرى فرض التكرّم قاصراً","إن لم تقم جدوى يديه بنفله",41,"ل",2,0],["ندبٌ سما وحمت ملكاً براعته","فداً له الناس من سامٍ ومن حام",42,"م",1,0],["ندى ملك له في الملك خد","وجد فهو عدل الشاهدين",43,"ن",1,0],["نَديمي غَيرُ مَنسوبٍ","إِلى شَيءٍ مِنَ الحَيفِ",44,"ف",1,1],["نداك مَعينٌ كالذي قد علمتُه","ولو كان غَوْراً لالتمستُ رشاءَ",45,"ا",2,0],["نَدَيتَ ولم تورق ولستَ بمُثمر","فكن غَرَضاً مستهدَفاً للنوائبِ",46,"ب",1,0],["نديمان من شتّى وكأسٌ كريهةٌ","أباها من الشُّرَّابِ إلا المجشَّمُ",47,"م",1,0],["ندمْتَ على أن كنتَ يوماً دعوْتني","ونفسي على أني أَجبتُك أَنْدمُ",48,"م",1,1],["نداكَ ندىً يسعى إلى كل قاعدٍ","من الناس بل يسري إلى كلِّ نائمِ",49,"م",1,0],["نُدافِعُ في الكَريهَةِ عَن بَنينا","وَنَعلَمُ أَنَّ جُبنَ القَومِ عارُ",50,"ر",1,0],["ندنو فنقتل بالانياب عن كثب","وتقتلون برغم البعد بالنار",51,"ر",1,0],["ندمت على ما كنت فرطت قبلذا","بسوء اعتقاد لي إلى الكفر قد جرا",52,"ر",2,0],["نداء الخلف بينكما عقيم","وداعي الله بينكما مجاب",53,"ب",1,0],["نُدمانُ إِسماعيلَ في آثارِهِ","ذَهَبوا وَتِلكَ صُبابَةُ النُدَماءِ",54,"ا",2,0],["نَديمُ عَينيْ بعدكَ الكَوْكَبُ","ولَوْعَةٌ إِنْسَانُها يلهبُ",55,"ب",1,1],["نَدٍ أَبِيٍّ غَرٍ وافٍ أَخي ثِقَةٍ","جَعدٍ سَرِيٍّ نَهٍ نَدبٍ رَضاً نَدُسِ",56,"س",1,0],["نَدي الخُزامى ذَفِرِ القَرَنفُلِ","مُحَلَّلٍ مِلوَحشِ لَم يُحَلَّلِ",57,"ل",1,0],["نَدَبتُ لَها أَبا يَعقوبَ لَمّا","وَثِقتُ بِسَعيِهِ وَأَبى عُقوبا",58,"ب",2,0],["نَدعوكَ لِلخَطبِ الجَليلِ بِسَيِّدٍ","وَأَخٍ لِقُربِكَ تارَةً وَخَليلِ",59,"ل",1,0],["نَدِمتُ عَلى أَمرٍ مَضى لَم يُشِر بِهِ","نَصيحٌ وَلَم يَجمَع قُواهُ نِظامُ",60,"م",1,0],["نَدِمتُ وَقالَ الناسُ كَيفَ تَرَكتَهُ","فَقُل في مَلامٍ واقِعٍ بِمُليمِ",61,"م",1,0],["نَدَبتَ لَهُ اِبنَكَ العَبّاسَ لَمّا","رَضيتَ بِخُلقِهِ هَدياً وَدينا",62,"ن",2,0],["نَديمَيَّ لا زالَ السَحابُ مُوَكَّلاً","بِجودِكُما بِالسِحِّ وَالهَطَلانِ",63,"ن",1,0],["نَدِمتُ نَدامَةَ الكُسَعِيِّ لَمّا","غَدَت مِنّي مُطَلَّقَةٌ نَوارُ",64,"ر",1,1],["نَدِمتَ عَلى العِصيانِ لَمّا رَأَيتَنا","كَأَنّا ذُرى الأَطوادِ ذاتِ المَخارِمِ",65,"م",1,0],["نَدامَى تَراجَعَ عُذَّالُنا","عَنِ العَذْلِ وارتدَّ نُصَّاحُنا",66,"ن",2,0],["ندىً لو كانَ من بَحرٍ","لأمسى وهوَ مَنزوفُ",67,"ف",1,0],["نَدَبَت فَشَقَّ لَها الشَقيقُ جُيوبَهُ","وَاِزرَقَّ سَوسَنُها لِلَطمِ خُدودِهِ",68,"د",2,0],["نَديمي قُم إِلى اللَهوِ","فَقَد ساعَدنا الدَهرُ",69,"ر",1,1],["نَديمٌ ناعِمٌ حُلوٌ","وَراحٌ خَشِنٌ مُرُّ",69,"ر",1,0],["نداء بين عينيك","كهذا الليل مجهولُ",70,"ل",1,0],["ندم النجمُ على غالي سناه","ورأى كيف انطوينا فطواه",71,"ه",1,0],["نداؤك يا فؤادُ كفى نداء","أما تنفك تسقيني الشقاء",72,"ا",2,1],["نَدبٌ تُدَاوي مِنَ الأَقوامِ شيمتُهُ","بالبأس والجود داءَ الجُبنِ والبَخَلِ",73,"ل",1,0],["نداك بطبعٍ للعفاةِ ارتَجَلْتَهُ","وغيرك رَوّى في نداه تَكَلُّفَا",74,"ف",2,0],["نداهُ يُغني لا نَدَى غَيرِهِ","من للذُّنَابَى بِغَنَاءِ الجناح",75,"ح",1,0],["نَدَبتُكَ لِلجَزيلِ وَأَنتَ لَغوٌ","ظَلَمتُكَ لَستَ مِن أَهلِ الجَزيلِ",76,"ل",1,0],["نَدَّ عَنكَ العَزاءُ فيهِ وَقادَ ال","دَمعَ مِن مُقلَتَيكَ قَودَ الجَنيبِ",77,"ب",1,0],["ندى لانَتْ معاطفُهُ وبأسٌ","يذيبُ حشاشةَ الأسدِ الوقاحِ",78,"ح",1,0],["ندبتُ له قاضياً فاضلاً","وحصَّلْتُ حقِّيَ بالفاضلِ",79,"ل",1,0],["نَدّى النَسيمُ فَما أَرَقَّ وَأَعطَرا","وَهفا القَضيبُ فَما أَغَضَّ وَأَنضَرا",80,"ر",2,1],["نَدِمتُ عَلى ما كانَ مِنّي نَدامَةً","كَما نَدِمَ المُغبونَ حينَ يَبيعُ",81,"ع",1,0],["ندينُ مدى الدّهر بين الأنامْ","بدين المعالي ودنيا الهِمَمْ",82,"م",1,0],["نداعِسُ الحادثاتِ السُّود ثائرةً","والموتُ يَصرعُ منّا كلَّ دَعّاسِ",83,"س",1,0],["نَدينُ بِأَلّا تُستَباحَ بِلادُنا","وَأَلّا نَرى فيها مَدى الدَهرِ غازِيا",84,"ي",2,0],["نَدِينُ بأ