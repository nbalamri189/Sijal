{"poems":[[72,"كيف خلاصي من هوى","https://www.aldiwan.net/poem42839.html","مجزوء الرجز"],[63,"كيف خلاصي من العراق وقد","https://www.aldiwan.net/poem51448.html","المنسرح"],[83,"كيف خلاص القلب من شاعر","https://www.aldiwan.net/poem61527.html","السريع"],[50,"كيف خطا النتن إلى منخري","https://www.aldiwan.net/poem66150.html","البسيط"],[48,"أسهب الناس في المقال وما يظ","https://www.aldiwan.net/poem23567.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[139,"كنت في مصر قوة ذات بال","https://www.aldiwan.net/poem49176.html","الخفيف"],[237,"عذرا فقلبي ما عليه اعتذار","https://www.aldiwan.net/poem14839.html","السريع"],[240,"لكل ما طال به الدهر أمد","https://www.aldiwan.net/poem32095.html","الرجز"],[287,"كل مليح عبد عبد الرحيم","https://www.aldiwan.net/poem32443.html","السريع"],[466,"كيف خلاص الحر من بذلة","https://www.aldiwan.net/poem16129.html","السريع"],[580,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[591,"كيف خلاصي من الذي أجد","https://www.aldiwan.net/poem17479.html","المنسرح"],[1956,"","https://poetry.dctabudhabi.ae/diwan/poem/121875","السريع"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106974","الرجز"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26183","السريع"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203547","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128921","الخفيف"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103781","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54497","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33722","الخفيف"],[4881,"بين شاعر وشعره","https://www.poetsgate.com/ViewPoem.aspx?id=200535",""],[5370,"لا وداعية","https://www.poetsgate.com/ViewPoem.aspx?id=85932",""],[5409,"كيف خص الإنسان من سائر العا","https://www.poetsgate.com/ViewPoem.aspx?id=155384",""],[243,"دجلة الغضبى","https://www.poetsgate.com/ViewPoem.aspx?id=50472",""]],"verses":[["كَيفَ خَلاصي مِن هَوىً","مازَجَ روحي وَاِختَلَط",0,"ط",1,1],["كيفَ خَلاصي من العِراقِ وقد","آثرتُ فيها مَعادِنَ الكَرَمِ",1,"م",1,1],["كَيفَ خَلاصُ القَلبِ مِن شاعِرٍ","رَقَّت مَعانيهِ عَن النَقدِ",2,"د",1,1],["كَيفَ خَطا النَتنُ إِلى مِنخَري","وَدونَهُ راحٌ وَرَيحانُ",3,"ن",1,1],["كَيفَ خَلّى وَليدَهُ لِلأَعادي","أَم يَظُنّونَ أَنَّهُم غَلَبوهُ",4,"ب",3,0],["كيف خُضْتِ الكون لجّاً دمويّاً","وشُواظاً طاغيَ النار عتيَّا",5,"ي",2,0],["كيف خانتك يا عليَّ المنايا","واستطالت إليك أيدي الزوال",6,"ل",1,0],["كَيفَ خَلاصي مِن هَوى شادِنٍ","أَحاطَ بِالقَلبِ هَوىً وَاِستَدار",7,"ر",1,0],["كَيفَ خَبا النَجمُ فَغارَ ضَوؤُهُ","كَيفَ هَوَت هِضابُ قُدسٍ وَأُحُد",8,"د",1,0],["كَيفَ خَلاصي مِن غَرامي بِهِ","وَهوَ الَّذي لا زَمَني كَالغَريم",9,"م",1,0],["كيف خَلاصُ الحُرِّ منْ بِذْلةٍ","أم كيف تبقى نفسهُ حُرَّهْ",10,"ه",1,1],["كيفَ خُلِّدتُ في جَهنَّم ذا الصدِّ","وَذَنْبِي في عِشْقِه التَّوْحِيدُ",11,"د",1,0],["كَيْفَ خَلاصِي مِنَ الَّذي أَجِدُ","قَدْ أَعْوزَ الصَّبْرُ عَنْهُ والجَلَدُ",12,"د",1,1],["كيف خلاصي من هوى شادن","حكمة الحسن على مهجتي",13,"ت",2,1],["كيف خبا ناراً وهذي أضلعي","قد أصبحت حمالة له حطب",14,"ب",1,0],["كَيفَ خَطَوتَ الشَرَّ ثُمَّ الشَرى","وَاِبنى هِلالٍ وَالقَنا وَالشِفار",15,"ر",1,0],["كيف خلى ابنه رهين الأعادي","أتراهم أرضوه أم أغضبوه",16,"ب",3,0],["كيف خلدت لي بفعلك عارا","ليس يمحى على مدى الاعوام",17,"م",1,0],["كيف خلطت وغلبت على","سيد الانوار ياللعجب",18,"ب",1,0],["كيف خُصَّ العمادُ بالأدْوَنِ المخْ","لَقِ من دونِ عُصبةِ الدِّيوانِ",19,"ن",1,0],["كيفَ خانَت عينُ الرقيبِ الرقيبا","أخطأتني لما رأيتُ الحَبيبا",20,"ب",2,1],["كيف خلعتَ الصدق يا سيدي؟","بل كيف لي في حرمتي لم تراعْ؟",21,"ع",1,0],["كيف خان وهو حالف ما يخون","وين عهده.. وين كلمات الشرف؟",22,"ف",1,0],["كيف خص الإنسان من سائر العا","لم بالشؤم بومةً وغرابا",23,"ب",2,1],["كيف خلفتم الديار الحبيبات","ألا لفتة لتلك الديار",24,"ر",1,0]]}