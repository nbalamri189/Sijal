{"poems":[[55,"أثرها على ما بها من لغب","https://www.aldiwan.net/poem30743.html","المتقارب"],[9,"أجدك لم تغتمض ليلة","https://www.aldiwan.net/poem21928.html","المتقارب"],[73,"أهاجك شوق أم سنا بارق نجدي","https://www.aldiwan.net/poem4007.html","الطويل"],[37,"ألا طرقت بعد العشاء جنوب","https://www.aldiwan.net/poem39618.html","الطويل"],[39,"سل الهموم لقلب غير متبول","https://www.aldiwan.net/poem7655.html","البسيط"],[39,"تسدى الرياح بها سحا وتلحمه","https://www.aldiwan.net/poem7677.html","البسيط"],[74,"هنئت يا ملك السماحة والندى","https://www.aldiwan.net/poem18639.html","الكامل"],[53,"تسدي الفتى الأقدار من حيث لا يرى","https://www.aldiwan.net/poem65488.html","الطويل"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[87,"قم للمعلم وفه التبجيلا","https://www.aldiwan.net/poem15422.html","الكامل"],[63,"حسب الأمير سماح وطد الحسبا","https://www.aldiwan.net/poem51801.html","البسيط"],[107,"يقولون لي ماذا قرأت لعلهم","https://www.aldiwan.net/poem43113.html","الطويل"],[41,"أمن دمن بشاجنة الحجون","https://www.aldiwan.net/poem53733.html","الوافر"],[22,"آثرت إدلاجي على ليل حرة","https://www.aldiwan.net/poem21644.html","الطويل"],[54,"أخف من لا شيء في سجدته","https://www.aldiwan.net/poem27198.html","السريع"],[111,"أشعة الحق لا تخفى عن النظر","https://www.poetsgate.com/ViewPoem.aspx?id=512",""],[102,"التاريخ السري .. للجدار العتيق","https://www.poetsgate.com/ViewPoem.aspx?id=50343",""],[132,"يا زروة قد أورثت","https://www.aldiwan.net/poem50516.html","مخلع الكامل"],[147,"ما لي مقال عن فعالك يعرب","https://www.aldiwan.net/poem11728.html","الكامل"],[147,"تسد إذا حم الحمام المذاهب","https://www.aldiwan.net/poem11729.html","الطويل"],[240,"لو أن قلبك مثل قلبي مغرم","https://www.aldiwan.net/poem31768.html","الكامل"],[266,"أظن الصبا جابت إليك المسالكا","https://www.aldiwan.net/poem38220.html","الطويل"],[369,"أوجست من جمر بخدك ساطع","https://www.aldiwan.net/poem60852.html","الكامل"],[391,"أفاطم قبل بينك متعيني","https://www.aldiwan.net/poem1844.html","الوافر"],[422,"أنا في هواكم مطلق ومقيد","https://www.aldiwan.net/poem54136.html","الكامل"],[422,"تنقلت مثل البدر يا طلعة البدر","https://www.aldiwan.net/poem54158.html","الطويل"],[463,"لعل الركب أن خلصوا نجيا","https://www.aldiwan.net/poem55813.html","الوافر"],[463,"تموق الليالي فيكم ثم تعقِل","https://www.aldiwan.net/poem55908.html","الطويل"],[469,"وهيفاء تقتل عشاقها","https://www.aldiwan.net/poem3318.html","عموديه"],[556,"خليلي ألا عجتما بالقلائص","https://www.aldiwan.net/poem47739.html","الطويل"],[591,"هيهات أن يسخو ولو بسلامه","https://www.aldiwan.net/poem17766.html","الكامل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2472","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138247",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83311","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66645","الطويل"],[1798,"","https://poetry.dctabudhabi.ae/diwan/poem/114921","الطويل"],[1849,"","https://poetry.dctabudhabi.ae/diwan/poem/77679","الطويل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67920","البسيط"],[2256,"","https://poetry.dctabudhabi.ae/diwan/poem/216586",""],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93686","الطويل"],[2758,"","https://poetry.dctabudhabi.ae/diwan/poem/31506","المتقارب"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132707","الوافر"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145047","الكامل"],[3467,"","https://poetry.dctabudhabi.ae/diwan/poem/145097","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74056","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74042","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62921","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110085","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216614","الطويل"],[3719,"","https://poetry.dctabudhabi.ae/diwan/poem/111113","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59506","المتقارب"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119469","الطويل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119478","الطويل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136899",""],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90803","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73320","الكامل"],[4549,"","https://poetry.dctabudhabi.ae/diwan/poem/203559","البسيط"],[4717,"عجبا لأمرك يا زمان","https://www.poetsgate.com/ViewPoem.aspx?id=199559",""],[3591,"على صدور الخرد الحسانِ","https://www.poetsgate.com/ViewPoem.aspx?id=149415",""],[5145,"توسّمت رسم الدار من أمّ حارث","https://www.poetsgate.com/ViewPoem.aspx?id=108054",""],[5298,"أفاطمُ! قبلَ بينكِ متِّعيني","https://www.poetsgate.com/ViewPoem.aspx?id=183098",""],[5401,"الشيطنه والشقاوه","https://www.poetsgate.com/ViewPoem.aspx?id=85139",""],[5818,"دماء العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=177740",""],[5956,"بالتجاوب لن أعابا","https://www.poetsgate.com/ViewPoem.aspx?id=192424",""]],"verses":[["تَسُدُّ عَلى البيدِ خَرقَ الشَمالِ","بِما نَسَجَت مِن سَحيلِ التُرَب",0,"ب",1,0],["تَسَدَّيتُها عادَني ظُلمَةٌ","وَغَفلَةُ عَينٍ وَئيقادِها",1,"د",3,0],["تَسدَيتنا وَالبَحرُ دونَكَ مَعرِض","وَبيدٌ تَحاماها جَوازي المَها الرُبدِ",2,"د",1,0],["تَسَدَّت وَمَرٌّ دونَنا وَأَراكُهُ","وَدُونانُ أَمسَى دُونَها وَنَقيبُ",3,"ب",1,0],["تُسدِي الرِّيَاحُ بِهَا نَسجَاً وَتُلحِمُهُ","ذَيلَينِ من مُعصِفٍ مِنهَا وَمَشمُولِ",4,"ل",1,0],["تسدى الرياح بها سحا وتلحمه","ربلين من معصف منها ومشمول",5,"ل",1,1],["تسدي به منناً وتكتب حسداً","فتفطر الأفواه والأكبادا",6,"د",2,0],["تسدِّي الفتى الأقدار من حيث لا يرى","ويخطئه مظنونها ومخوفُها",7,"ه",2,1],["تسدُّ فُقورنا وتغضُّ منا","فنستعفي هناك ونُستدامُ",8,"م",1,0],["تُسدي الجَميلَ إِلى البِلادِ وَتَستَحي","مِن أَن تُكافَأَ بِالثَناءِ جَميلا",9,"ل",2,0],["تُسدي عليها الصَّبا بُرْداً فإن ركَدَتْ","رأيتَه دارسَ الأفوافِ مُستَلَبا",10,"ب",2,0],["تَسُدُّ فِجاجَ الأَرضِ تَبتَدِرُ الوَغى","وَتَزحَمُ في الجَوِّ النُسورَ الضَوارِيا",11,"ي",2,0],["تَسُدُّ بِمَضرَحِيِّ اللَونِ جَثلٍ","خَوايَةَ فَرجِ مِقلاتٍ دَهينِ",12,"ن",1,0],["تَسَدَّيتِنا مِن بَعدِ ما نامَ ظالِعُ ال","كِلابِ وَأَخبى نارَهُ كُلُّ مَوقِدِ",13,"د",1,0],["تَسَدَّرَ التُفّاحُ في خَدِّهِ","وَنَوَّرَ السَوسَنُ في لِحيَتِه",14,"ت",2,0],["تسدد الرأي معصوما فتنقضه","بطانة السوء مركوسا إلى الحفر",15,"ر",1,0],["تسدّ باب الريح ، كي لا ترى","إني دخان ، من رؤى (شهريار)",16,"ر",1,0],["تُسدى أكفّهُمُ بجودٍ","مثلَ منْهلِّ الغَمَامِ",17,"م",1,0],["تُسدي الكِرامُ مَكارِماً مَبتولَةً","وَلِكُلِّ نَيلٍ مِن يَدَيكَ مُعَقِّبُ",18,"ب",1,0],["تُسَدُّ إِذا حُمَّ الحِمامُ المَذاهِبُ","وَيُعيي البَرايَ فَوتُ ما اللَهُ طالِبُ",19,"ب",1,1],["تُسدي الصَنائِعَ كَفُّهُ وَتَشِبُّ ن","يرانُ الوَقائِعِ فَهوَ مُسدٍ مُلحِمُ",20,"م",1,0],["تسدت معانيها والحم نظمها","وأصبحت فيها حاكي المدح حائكا",21,"ك",2,0],["تُسدَى إليهم لا تزالُ صنائعٌ","لجَلالِ دين اللهِ بعد صنائع",22,"ع",1,0],["تَسُدُّ بِدائِمِ الخَطَرانِ جَثلٍ","خَوايَةَ فَرجِ مِقلاتٍ دَهينِ",23,"ن",1,0],["تسدى إليَّ وما نهضت بشكرها","نِعَمٌ تُعَدُّ ولم تزل تتعدد",24,"د",1,0],["تسدُّ ثغوراً لا تُسَدُّ ولم يكنْ","سواك سداد في الحقيقة للثغر",25,"ر",1,0],["تسُدُّ مطالعَ البَيضَا عُلُوّاً","وتنفُذُ تحتَ مَغربِها هُوِيَّا",26,"ي",2,0],["تُسدِّي لكم في كلّ يومٍ وشائعاً","من الفخر مصبوغاتُها ليس تنصُلُ",27,"ل",1,0],["تسدّد بالجفن سهمً الفتور","وتفتح في الخدّ وردَ الخفر",28,"ر",1,0],["تَسدّ فِجاجَ العُذرِ مِنّا ومنكُمُ","فليس إلى عُذرٍ مَحيصٌ لحائِصِ",29,"ص",1,0],["تَسْدِيدُ أَمْرِي سَدّ فِيهِ بِلَثْمَةٍ","وَقِوَامُ حَالِي ضَمَّ غُصْنَ قَوامِهِ",30,"م",2,0],["تَسَدَّت وَعَينُ السوسِ بَيني وَبَينَها","وَرُزداقُ سولافٍ حَمَتهُ الأَزارِقَه",31,"ق",2,0],["تسدى إلى الإنسان إحسانا به","حليت من شخص المروءة جيدا",32,"د",2,0],["تَسُدُّ فَجاجَ المُغرِبينَ جُيوشُهُ","وَيَبدو هُنا في ثَوبِ أَشعَثَ أَغبَرِ",33,"ر",1,0],["تسدَّتْ إلينا بعد هَدو ودونَها","طويلُ الذُّرى من بطنِ نَخلَة أَغلب",34,"ب",1,0],["تَسُدُّ بِهِ طَوراً خَوَايَةَ فَرجِها","وطوراً إذا شالَت تراه مُشَمِّرا",35,"ر",2,0],["تُسَدِّدُني سَهماً لِكُلّ ثَنِيَّةٍ","ضَوامِرُ أَشباهُ القِسِيِّ نُحولُ",36,"ل",1,0],["تُسدي الرِّياحُ لها ثوباً وتُلحِمُه","كما تَلَبَّسُ من نَسجِ الخداريقِ",37,"ق",1,0],["تسِدّك وتمزر يْهابك","هذي وعَنْك تْغَلّق الباب",38,"ب",1,0],["تسدد نبل اللَحظ عَن قَوس حاجب","وَيا حَبَّذا تِلكَ القسي وَذا النبل",39,"ل",1,0],["تَسَدّى مَعَ النَومِ تِمثالُها","دَنُوَّ الضَبابِ بِطَلٍّ زُلالِ",40,"ل",1,0],["تسد على النقيصة كل نهج","نقيبته فتسمو بالكمال",41,"ل",1,0],["تسدى العزاء إلى بقايا أهلها","بعد المصاب وتشكر استبسالها",42,"ل",3,0],["تسديتها والليل في ريطة الدجى","بهوجاء لا يثني الخطام ارتسامها",43,"م",3,0],["تسدي النَصيحة لا تَبغي بها ثَمنا","وَتمنحُ الودّ لا خوفاً وَلا طَمَعا",44,"ع",2,0],["تُسدي بِلا منٍّ وَوجهك ضاحك","جذلا وَغيرك عابِس مَكمودُ",45,"د",1,0],["تُسدُّ وتَعرورى بهم كل ثُلمة","وثغر كأَنيابِ الهزبر بلا ثَغرِ",46,"ر",1,0],["تُسدَّدُ آراءُ الوُلاةِ برأيهِ","إلى ان غدا مُعتلُّها مثلَ سالمِ",47,"م",1,0],["تسدين ارجاء السماء بحاصب","من النار موّار العجاجة مظلم",48,"م",1,0],["تسد فيه لهات الثغر إن هتكت","فروج حوزته الأحداث والغير",49,"ر",1,0],["تَسَدَّيْتُها إذ جَنحن النجومُ","وخاضَ الكرى أعينَ النُّوِّم",50,"م",1,0],["تسدد نحو الطير وهو محلق","وينفذ عنها للردى نحوه رسل",51,"ل",1,0],["تسدد منها السمر لا لمحارب","وترهف منها البيض لا لمقاتل",52,"ل",1,0],["تسدد خطوي وتلقى عليَّ","دروس الحياة ووعي العبر",53,"ر",1,0],["تسدى الملام وباب سمعي سده","إذ صده عن لومك المقدور",54,"ر",1,0],["تُسدي الملامَ وناظري مترقِّبٌ","بَرقاً يمرُّ على الحمى فَيَشِمُهُ",55,"م",2,0],["تسد ما بين حاديها بذي خصل","كالبرد نصفان هداب ومنسوج",56,"ج",1,0],["تُسدِي الجميلَ إلى الغريرِ صنائعاً","وتحيلُ ما أَسْدَيْتَ بعدُ مَسَاويا",57,"ي",2,0],["تسددُ السهم من الأجفان","ليفتك الجمال بالشبان",58,"ن",1,0],["تسدّى العلى قصداً ولا قصدأ جدلٍ","عتاق الضواري عنده كالأباغث",59,"ث",1,0],["تسدُّ بدائمِ الخطرانِ جثلٍ","يُباريها ويأخُذُ بالوَضينِ",60,"ن",1,0],["تسدل عليّه وشاحك لين تضهدني","بين السكون الرهيب وبين آهاتك",61,"ك",1,0],["تُسَدُّ المنافذُ لا باب يبدو","نبوحُ لهُ .. لا نريدُ مَساسَه ْ",62,"س",2,0],["تُسدِّدُ نحو إخلاص يؤدّى","إليك خيانة له أو حرابا",63,"ب",2,0]]}