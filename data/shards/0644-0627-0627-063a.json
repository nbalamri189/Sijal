{"poems":[[55,"ما أقل اعتبارنا بالزمان","https://www.aldiwan.net/poem29740.html","الخفيف"],[55,"راحل أنت والليالي نزول","https://www.aldiwan.net/poem29892.html","الخفيف"],[55,"تعيف الطير فأنبأنه","https://www.aldiwan.net/poem29951.html","السريع"],[55,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[55,"شيمي لحاظك عنا ظبية الخمر","https://www.aldiwan.net/poem30460.html","البسيط"],[91,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[48,"لا تطيعي هواك أيتها النف","https://www.aldiwan.net/poem22141.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142404","الخفيف"],[302,"صاح إن جزت بذي الأثل فحي","https://www.aldiwan.net/poem33082.html","الرمل"],[303,"أصبح القوم كلهم شعراء","https://www.aldiwan.net/poem36269.html","عموديه"],[371,"ليس في الأرض ما يفوق سوى الشام","https://www.aldiwan.net/poem17892.html","الخفيف"],[415,"كل يوم فتح مبين ونصر","https://www.aldiwan.net/poem32222.html","الخفيف"],[463,"ما للدسوت وللسروج تسائل","https://www.aldiwan.net/poem56069.html","الكامل"],[3388,"","https://poetry.dctabudhabi.ae/diwan/poem/130237","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[4424,"","https://poetry.dctabudhabi.ae/diwan/poem/205340","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139547",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139749",""],[382,"","https://poetry.dctabudhabi.ae/diwan/poem/112122","الخفيف"],[5136,"صافحت ريح الصبا روض الخزامى","https://www.poetsgate.com/ViewPoem.aspx?id=121655",""],[6031,"عَاطِنيها قبلَ ابتِسَامِ الصَّبَاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=46257",""],[6068,"عيناك من عين المها -13-","https://www.poetsgate.com/ViewPoem.aspx?id=175846",""],[5309,"لا اغضب الناس ليس المرء قوته","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573735",""]],"verses":[["لا أَغَبَّ الرَبيعُ تُربَكَ مِن نو","رٍ هِجانٍ وَمَنظَرٍ إِضحِيانِ",0,"ن",1,0],["لا أَغَبَّ الطُفوفَ في كُلِّ يَومٍ","مِن طِراقِ الأَنواءِ غَيثٌ هَطولُ",1,"ل",1,0],["لا أَغفَلَت قَبرَكَ حَنّانَةٌ","خَرقاءُ بِالقَطرِ صَناعِ البُروق",2,"ق",1,0],["لا أَغَبَّ الدارَ مِن بَعدِهِمُ","شُوَّلٌ يَحمِلنَ وَبلاً وَقِطارا",3,"ر",2,0],["لا أَغفَلَ المُزنُ أَرضاً يَعقِلونَ بِها","وَلا طَوى عَنهُمُ مستَعذَبَ المَطَرِ",4,"ر",1,0],["لا اغالي فربما قلت شعرا","لم اكن في قرضي له بالمجيد",5,"د",1,0],["لا أُغادي مَفارِقي بِصَبيبٍ","وَأُخَلّي وَالقَفرَ آلَ صَبيبَه",6,"ب",2,0],["لا أغالي بلومها فهي حسناء","تحبّ الدّلال والتلميقا",7,"ق",2,0],["لا أَغبَّ المزنُ مَن أَمِّ القرى","منزلاً كانَ لأَسماءَ ومَي",8,"ي",1,0],["لا أُغالي بما أَقول إِذا هُمْ","قنعوا مِن حياتهم بالخيالِ",9,"ل",1,0],["لا أَغَبَّ الغَمامُ عَنهُ تَحايا","تُلبِسُ الغُصنَ سُندُسَ الأَوراقِ",10,"ق",1,0],["لا أغبّ الزّمانُ قصدَ أعادي","كَ ولا شدَّ من تهَيَّضْتَ جَبرُ",11,"ر",1,0],["لا اغترّ بعدك بالحياة مجرّبٌ","عرفَ الحقوقَ فلم يرُقْه الباطلُ",12,"ل",1,0],["لا أغبِطُ من كانَ لي ظالماً","عذابِي أليمٌ على الظَّالميناَ",13,"ن",2,0],["لا أغرينك أن تسير لفلكهم","مهما رغبت ولب مهجتك استعر",14,"ر",1,0],["لا أغرس الزهرَ إلا في مُسَرقنة","والغرسُ أجوَد ما يأتي بسِرقِينِ",15,"ن",1,0],["لا أغبَّ الغمام مثوى همامٍ","ما أغبّ العفاةَ منه انسكاب",16,"ب",1,0],["لا أغبَّ الإله من صوب فضلٍ","فوق ترب العفاف غيثا هتونا",17,"ن",2,0],["لا أغالي فيكِ فمدحكِ حقّاً","هو فوق الغلوِّ والإغراق",18,"ق",1,0],["لا أغبتك صلاة ابداً","ما وشت بالروض أنفاس النعاما",19,"م",2,0],["لا أغبَّ الوزيرَ سعدٌ يناجي","هِ بِهِ كَرُّ غُدْوَةٍ ورَوَاحِ",20,"ح",1,0],["لا أغتذي والطير في وكناتها","بل أحتمي من وهج من تتدلل",21,"ل",1,0],["لا أُغضِبُ النّاسَ لَيسَ المَرءُ قَوَّتَهُ","بَل لُطفَهُ فَهوَ لا يُخفي سَجِيَّتَهُ",22,"ت",2,1]]}