لي","https://www.aldiwan.net/poem12482.html","الرجز"],[429,"أيها اللائم لم غي","https://www.aldiwan.net/poem12544.html","مجزوء الرمل"],[429,"ما الطويل الذراع مثل القصير","https://www.aldiwan.net/poem12627.html","الخفيف"],[429,"يا هذه لا تنطقي","https://www.aldiwan.net/poem12812.html","مجزوء الرجز"],[438,"يموت الصحيح ويحيا المصاب","https://www.aldiwan.net/poem14346.html","المتقارب"],[438,"الرزء أعظم أن تراق دموع","https://www.aldiwan.net/poem14460.html","الكامل"],[438,"آها لها من غصة النادم","https://www.aldiwan.net/poem14479.html","السريع"],[441,"أهلا بطلعة وجهك المحبوب","https://www.aldiwan.net/poem55944.html","عموديه"],[450,"قل وحث المدام في إبانه","https://www.aldiwan.net/poem13936.html","الخفيف"],[456,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[459,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[462,"بين حزني وحسنه اليوسفي","https://www.aldiwan.net/poem3166.html","عموديه"],[462,"وجدي كوجدك بالظباء الغيد","https://www.aldiwan.net/poem3208.html","عموديه"],[462,"أما الديار فتلك عين ظبائها","https://www.aldiwan.net/poem3213.html","عموديه"],[462,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[477,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[491,"ويؤيؤ أوحى من القضاء","https://www.aldiwan.net/poem67301.html","الرجز"],[493,"سفينة لم تعتمل بنجر","https://www.aldiwan.net/poem9864.html","مشطور الرجز"],[498,"حب النبي الهاشمي ديني","https://www.aldiwan.net/poem37768.html","الرجز"],[556,"الله أنزل حكم أمري","https://www.aldiwan.net/poem34521.html","مجزوء الكامل"],[560,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[565,"وملعب للخيل في قرواح","https://www.aldiwan.net/poem69751.html","الرجز"],[573,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"]],"verses":[["ذي سَوءَةٍ إِن ثَناها مَحفِلٌ كَثُرَت","لَها المَضارِبُ فَوقَ الصَدرِ بِالذَقَنِ",0,"ن",1,0],["ذِئابٌ أَرادَت أَن تُعازِزَ ضَيغَماً","فَطالَ عَلى مَرِّ الزَمانِ هَوانُها",1,"ن",3,0],["ذي غُرَّةٍ سُبِغَت عَليهِ كَأَنَّهُ","فيها يَمُدُّ لِحاظَهُ مِن بُرقِعِ",2,"ع",1,0],["ذي ضِياءٍ إِن جَلا عِرنينَهُ","ضَوَّأَ اللَيلَ وَما أَوقَدَ نارا",3,"ر",2,0],["ذي عَزمَةٍ إِن دَعاها الرَوعُ مُنتَصِراً","تَلَفَّتَت عَن غِرارِ الصارِمِ الخَشِبِ",4,"ب",1,0],["ذي نَيرَبٍ نَزِعٍ لَو قَد نَصَبتُ لَهُ","وَجهي لَقَد قالَ كُنتَ الحائِنَ الحَمِقا",5,"ق",2,0],["ذي مِرَّةٍ تُشجيهِ ذا","تُ النَقعِ لا ذاتُ الخِمار",6,"ر",1,0],["ذِيدَتْ عَنِ الرُّكْنِ لَمْ تُلْمِمْ بِهِ يَدُهَا","فَأَقْبَلَتْ بِضِيَاءِ الْعَيْنِ تَسْتَلِمُ",7,"م",1,0],["ذِي الهِمَّةِ المُثْلَى كَهَمَّ","أَبِيهِ فِي طَلَبِ المَعَالِي",8,"ي",1,0],["ذيب نرهن ذا الغفاره","ونرده في غباره",9,"ه",1,1],["ذيب تمشي لقصورك","وديارك الشريفا",10,"ف",2,0],["ذي مِنسَرٍ فَخمٍ وَعَينٍ غائِرَه","وَفَخِذٍ مِلءَ اليَمينِ وافِرَه",11,"ه",1,0],["ذَيّالَةً ذَلَّت لَها صِعابُهُ","رَكبُ هَياهُ وَالصِبا رِكابُهُ",12,"ب",2,0],["ذي المجد لا في ساعديهِ عن العلا","قصرٌ ولا في عزمهِ إعياء",13,"ا",2,0],["ذي سطورٍ مثل البساتين تجنى","وهي حولَ الإسلام مثل السياج",14,"ج",1,0],["ذي حسانٌ من القصائد تجلى","وهي محتاجة لحظ القباح",15,"ح",1,0],["ذي مقلة تلقى الضرا","غمَ بالجفون الكاسره",16,"ر",2,0],["ذي السلم لا تعبأ له ديمةٌ","والحرب لا يصلى له جمره",17,"ر",2,0],["ذي الرأي يشكي السلاح الجمّ حدّته","لذاك يسمَّى السلاح الجمّ بالشاكي",18,"ك",2,0],["ذي البيت وافته بيوت قصيدة","لاقت فنحْنِح يا بيان ونهنه",19,"ه",1,0],["ذي فَيْشَةٍ شكَّتْ فؤا","دَك بعدما هتكت حِجابهْ",20,"ب",2,0],["ذي مِعْدةٍ ثعلبُها لاحِس","وتارةً أرنبُها ضاغبُ",21,"ب",1,0],["ذِيقَ لها اللوزُ فلا مُرَّةٌ","مرتْ على الذائق إلا أبى",22,"ب",2,0],["ذي نجوم كأنهن نجوم ال","شَيْبِ ليست تزول لكن تزيدُ",23,"د",1,0],["ذي نجومٍ كأنهنَّ نجومُ ال","شيب ليست تغور لا بل تزيدُ",24,"د",1,0],["ذي عِذار يترك النْا","سك مخلوعَ العذار",25,"ر",1,0],["ذي نجوم من خُزامَى","وشموس من بَهار",25,"ر",1,0],["ذي مُردة توفيك سُنَّتُهُ","نورَ الهلالِ وصورةَ الصَّنمِ",26,"م",1,0],["ذي وقارٍ في ذكاءٍ وحجىً","في بهاءٍ وحياء في لَسَن",27,"ن",1,0],["ذي عيالٍ زبونُهنَّ من النا","كة بعدَ الهُدوّ مثلُ زبونه",28,"ن",2,0],["ذي نَغمَةٍ يَسبي القُلوبَ بِها رَشا","مِن عِندِ رضوانٍ أَتانا هارِبا",29,"ب",2,0],["ذي هِمَّةٌ دونها في شَأوِها الهِمَمُ","لَم تَتَّخِذ لا وَلَم تَكذِب لَها نعَمُ",30,"م",1,1],["ذي المَعالي فَليَعلَوَن مَن تَعالى","هَكَذا هَكَذا وَإِلّا فَلالا",31,"ل",2,1],["ذي ذَنَبٍ أَجرَدَ غَيرَ أَعزَلِ","يَخُطُّ في الأَرضِ حِسابَ الجُمَلِ",32,"ل",1,0],["ذي الأرضُ عمّا أتاها الأمسَ غانِيَةٌ","وغيرُها كان محتاجاً إلى المَطَرِ",33,"ر",1,1],["ذي مقلة سهامها","من القلوب داميه",34,"ي",2,0],["ذي سِمَةٍ مَغموسَةٍ في النُّورِ","كصفحةِ الدينارِ ذي السُّطورِ",35,"ر",1,0],["ذِئْبَيْنِ لو ظفرَا بالشِّعرِ في حَرَمٍ","لَمَزَّقاهُ بأنيابٍ وأظفارِ",36,"ر",1,0],["ذِئبَينِ إذ نَظَرا إلى سيَّارَةٍ","بَعَثا لها يوماً كيومِ ذُؤَابِ",37,"ب",1,0],["ذي المَعالي فَتى المُهَذَّبِ شَمسُ ال","دينِ رَبُّ المَناقِبِ الباهِراتِ",38,"ت",1,0],["ذي طَلعَةٍ جَلَتِ العُيونَ بِحُسنِها","وَجَلَت هُمومَ الناسِ مِن إِحسانِها",39,"ن",3,0],["ذي موازيب حديدٍ فَهَقَتْ","بِصَبيبِ الدَّم من طَعنِ الكُبود",40,"د",1,0],["ذِئبُ فَلاةٍ كَيدُهُ دارِعٌ","صادَفَ ظَبياً كَيدُهُ حاسِرُ",41,"ر",1,0],["ذي كُمتَةٍ أَو شُقرَةٍ أَو حُوَّةٍ","أَو دُهمَةٍ فَهِمُ الفُؤادِ سَديدِ",42,"د",1,0],["ذي مَيعَةٍ مَشيُهُ الدِفَقّى","وَذاتِ لَوثٍ بِها مَلوثِ",43,"ث",1,0],["ذي فؤادٍ أقسى من الصخرِ لكنْ","عطفُهُ يلتوي بفرطِ اللينِ",44,"ن",1,0],["ذي جلالٍ وهيبةٍ ووقارٍ","وحيا زائدٍ وعقلٍ ودينِ",44,"ن",1,0],["ذي مَحاريبَ أُحرِزَت أَن تَراها","كُلُّ بَيضاءَ سَهلَةِ العِرنَينِ",45,"ن",1,0],["ذي أُمُّها كانَت مِنَ الرومِ أَصلُها","وَقَصدي أَنا أَصلٌ يَكونُ كَريما",46,"م",2,0],["ذي فُروغٍ يَظَلُّ مِن زَبَدِ الجَو","فِ عَلَيهِ كَثامِرِ الحُمّاضِ",47,"ض",1,0],["ذي طُرَّةٍ عاطِرَةٍ كَالعَنبَرِ","وَمَبسِمٍ يَكشِفُهُ عَن جَوهَرِ",48,"ر",1,0],["ذي أُذُنٍ كَخَوصَةِ العَسيبِ","أَو آسَةٍ أَوفَت عَلى قَضيبِ",49,"ب",1,0],["ذي جيئَةٍ صَعبٍ وَذي ذَهابِ","أَشبَعَني مِنهُ مِنَ الكَبّابِ",50,"ب",1,0],["ذي بُرنُسٍ مُذَهَّبٍ رَصيصِ","وَهامَةٍ وَمِنسَرٍ حَصيصِ",51,"ص",1,0],["ذي لُغَةٌ تَسجُدُ اللُغاتُ لَها","أَلغَزَها عاشِقٌ وَعَمّاها",52,"ا",3,0],["ذُيولُهُم كَثيراتُ المَخازي","لِما فَقَدوهُ مِن نُصحِ الجُيوبِ",53,"ب",1,0],["ذئاب حول جنَّتِهِ تعاوَى","كأن بها إِلى دمه نهامهْ",54,"م",2,0],["ذِي نباتٍ طَيِّبٍ أَعْرَافُهُ","كَعِذَارِ الشَّعْر في الخَدِّ بَدَا",55,"د",2,0],["ذي تَليلٍ مُشنِقٍ قائِدَهُ","يَسَرٍ في الكَفِّ نَهدٍ ذي غُسَن",56,"ن",1,0],["ذِي نَظْرَةٍ كَالسِّحْرِ لَوْ صَادَفَتْ","غَمْزَتُهَا لَيْثَ وَغىً مَا فَتَكْ",57,"ك",1,0],["ذِئْبٌ تَوَهَّمَهُمْ نِيَا","ماً فِي الحَظِيرَةِ كَالنَّعَمْ",58,"م",1,0],["ذِي الأيَادِي مِنْ كُلِّ لَوْنٍ وَأَغْلاَ","هُنَّ فِي الْمَأْثُرَاتِ بِيضُ الأيَادِي",59,"د",2,0],["ذي نبات بلبلت أعرافه","كعذار الشعر في الخد بدا",60,"د",2,0],["ذي جانبْينِ ، فجانب مُتطامِنٌ","يقسو النسيمُ عليه في تقبيله",61,"ل",2,0],["ذيالة ً ذلتْ لها صعابهُ","ركبُ حيَّا كانَ الصبا ركابهُ",62,"ب",2,0],["ذي نجوم كأنهن نجوم الشْ","شَيْبِ ليست تزول لكن تزيدُ",63,"د",1,0],["ذي ضُلَّ تَفْدِية ٍ هنا","لك تستديمُ بها هِبابهْ",64,"ب",2,0],["ذِئَابٌ تُدَاجِي نَعْجَةً لافْتِرَاسِهَا","وَتَرْقُبُ مِنْهَا فُرْصَةً لاخْتِلاَسِهَا",65,"ه",2,0],["ذي السَجايا التي تَشاغل قَلبي","حينَ أَبصَرتَها عَن الأَحباب",66,"ب",1,0],["ذي نَواس كَأَنَّها ظُلمة الشر","ك وَوَجه كَأَنَّهُ الإِيمان",67,"ن",1,0],["ذي تيرس آدرارُ أجل","زمورُيت واسعات كالحما",68,"م",2,0],["ذِى الفضلِ سلطانِ بن سيفِ الندَى","الزاكِي المكرَّمِ في مَدَى الأيَّامِ",69,"م",1,0],["ذِى العدلِ سلطانِ","الهُمَامِ بن الهُمَامِ بن الهُمَامِ",70,"م",1,0],["ذيَّاكَ بَرْق لاح لِي من عارضٍ","أمْ ذاكَ يا ليلى ضيا سَنَاكِ",71,"ك",1,0],["ذي هِمَّةٍ عَدَويَّةٍ ما رُوِّعَت","بِعِداً وَلا باتَت عَلى عُدَواءِ",72,"ا",2,0],["ذِيادَ الصَّوَادِى عَن قِرى الماءِ بَعدَما","مضى والفَلا سَبعٌ لَها وثَمانِ",73,"ن",1,0],["ذي وِدادٍ كَأَنَّهُ الفَضةُ البَيْ","ضاءُ زادَت يَدُ الزَمانِ جَلاها",74,"ا",3,0],["ذي الدَولةِ العُظمى الَّذي مَن أَمَّهُ","فَجِوارُهُ حَرمٌ عَلى الأَيَّامِ",75,"م",1,0],["ذِئابٌ على الإسلامِ صالوا وَما اِكتفوا","بِأَنيابِهم حتّى بهِ أَنشَبوا الظفرا",76,"ر",2,0],["ذي همَّةٍ علياءَ لا تُرْتَقَى","وعزمةٍ صمّاءَ لا تُغْلَبُ",77,"ب",1,0],["