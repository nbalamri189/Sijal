{"poems":[[53,"دع من دموعك بعد البين للدمن","https://www.aldiwan.net/poem29648.html","البسيط"],[53,"سقاها وإن لم يرو قلبي بيانها","https://www.aldiwan.net/poem29650.html","الطويل"],[53,"لو كان يرتدع القضاء بمردع","https://www.aldiwan.net/poem30148.html","الكامل"],[53,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[53,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[24,"نفى أهل الحبلق يوم وج","https://www.aldiwan.net/poem21871.html","الوافر"],[86,"أهلا بأول مسلم","https://www.aldiwan.net/poem10681.html","مجزوء الكامل"],[93,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[93,"يا حبذا أخت الغزال","https://www.aldiwan.net/poem11463.html","مجزوء الكامل"],[83,"ذيب نرهن ذا الغفاره","https://www.aldiwan.net/poem54202.html","مجزوء الرمل"],[83,"الوجود يقول هنيا","https://www.aldiwan.net/poem54205.html","مجزوء الرمل"],[47,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[47,"وزائر حببه إغبابه","https://www.aldiwan.net/poem25361.html","الرجز"],[72,"وعدت بطيف خيالها هيفاء","https://www.aldiwan.net/poem18174.html","الكامل"],[72,"كم عذول على هواك أداجي","https://www.aldiwan.net/poem18451.html","الخفيف"],[72,"لا وأجفانك المراض الصحاح","https://www.aldiwan.net/poem18482.html","الخفيف"],[72,"هن الوجوه الناضره","https://www.aldiwan.net/poem18696.html","مجزوء الكامل"],[72,"مبلبل الأصداغ والطره","https://www.aldiwan.net/poem18697.html","السريع"],[72,"لثمت ثغر عذولي حين سماك","https://www.aldiwan.net/poem19438.html","البسيط"],[72,"محراب صدغيه يحث توجهي","https://www.aldiwan.net/poem20511.html","الكامل"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[51,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[51,"رب ليل كأنه الدهر طولا","https://www.aldiwan.net/poem61840.html","الخفيف"],[51,"رب ليل تراه كالدهر طولا","https://www.aldiwan.net/poem61970.html","الخفيف"],[51,"دار أمن وقرار","https://www.aldiwan.net/poem62849.html","مجزوء الرمل"],[51,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[51,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[51,"رب أطلق يدي في كل شيخ","https://www.aldiwan.net/poem66498.html","الخفيف"],[78,"وأغن يلعب بالهموم كما غدت","https://www.aldiwan.net/poem13988.html","الكامل"],[85,"ذي همة دونها في شأوها الهمم","https://www.aldiwan.net/poem8060.html","البسيط"],[43,"ذي المعالي فليعلون من تعالى","https://www.aldiwan.net/poem9979.html","الخفيف"],[43,"ومنزل ليس لنا بمنزل","https://www.aldiwan.net/poem10111.html","الرجز"],[43,"ذي الأرض عما أتاها الأمس غانية","https://www.aldiwan.net/poem10638.html","البسيط"],[61,"هل لك يا ابن غاليه","https://www.aldiwan.net/poem51315.html","مجزوء الرجز"],[61,"أقررت في شكرك بالتقصير","https://www.aldiwan.net/poem51655.html","الرجز"],[61,"أكف تغلب أنواء الحيا الجاري","https://www.aldiwan.net/poem51679.html","البسيط"],[61,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[66,"سلبتنا فواتك اللفتات","https://www.aldiwan.net/poem40646.html","الخفيف"],[66,"أهلا بها كالقضب في كثبانها","https://www.aldiwan.net/poem41343.html","الكامل"],[80,"أين مني عتب أحباب هجود","https://www.aldiwan.net/poem31481.html","الرمل"],[44,"ما أنت إلا المثل السائر","https://www.aldiwan.net/poem30047.html","السريع"],[44,"أجفان خوط البانة الأملود","https://www.aldiwan.net/poem30531.html","الكامل"],[44,"صرف النوى ليس بالمكيث","https://www.aldiwan.net/poem30564.html","مجزوء البسيط"],[69,"صاح إن كنت في الغرام معيني","https://www.aldiwan.net/poem28372.html","الخفيف"],[31,"سحرتني الزرقاء من مارون","https://www.aldiwan.net/poem41282.html","الخفيف"],[33,"أيا أبتي دعني وما قد لقيته","https://www.aldiwan.net/poem25796.html","الطويل"],[39,"قل في شط نهروان اغتماضي","https://www.aldiwan.net/poem53771.html","الخفيف"],[52,"قد أغتدي على الجياد الضمر","https://www.aldiwan.net/poem26975.html","الرجز"],[52,"قد أغتدي والصبح كالمشيب","https://www.aldiwan.net/poem27238.html","الرجز"],[48,"يا بؤس كلبي سيد الكلاب","https://www.aldiwan.net/poem62453.html","الرجز"],[48,"آلف ما صدت من القنيص","https://www.aldiwan.net/poem64361.html","الرجز"],[48,"يا ليلة بتها أسقاها","https://www.aldiwan.net/poem66170.html","البسيط"],[46,"يهاب الناس إيجاف المنايا","https://www.aldiwan.net/poem22341.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30451","الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21104","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42723","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[84,"اصبيح شيم أم برق بدا","https://www.poetsgate.com/ViewPoem.aspx?id=26319",""],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[47,"وزائرٍ حببهُ إغبابهُ","https://www.poetsgate.com/ViewPoem.aspx?id=14664",""],[51,"رب ليلي كأنه الدهر طولاً","https://www.poetsgate.com/ViewPoem.aspx?id=27666",""],[51,"أنَّى هجوتَ بني ثوابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=26855",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"]],"verses":[["ذي سَوءَةٍ إِن ثَناها مَحفِلٌ كَثُرَت","لَها المَضارِبُ فَوقَ الصَدرِ بِالذَقَنِ",0,"ن",1,0],["ذِئابٌ أَرادَت أَن تُعازِزَ ضَيغَماً","فَطالَ عَلى مَرِّ الزَمانِ هَوانُها",1,"ن",3,0],["ذي غُرَّةٍ سُبِغَت عَليهِ كَأَنَّهُ","فيها يَمُدُّ لِحاظَهُ مِن بُرقِعِ",2,"ع",1,0],["ذي ضِياءٍ إِن جَلا عِرنينَهُ","ضَوَّأَ اللَيلَ وَما أَوقَدَ نارا",3,"ر",2,0],["ذي عَزمَةٍ إِن دَعاها الرَوعُ مُنتَصِراً","تَلَفَّتَت عَن غِرارِ الصارِمِ الخَشِبِ",4,"ب",1,0],["ذي نَيرَبٍ نَزِعٍ لَو قَد نَصَبتُ لَهُ","وَجهي لَقَد قالَ كُنتَ الحائِنَ الحَمِقا",5,"ق",2,0],["ذي مِرَّةٍ تُشجيهِ ذا","تُ النَقعِ لا ذاتُ الخِمار",6,"ر",1,0],["ذِيدَتْ عَنِ الرُّكْنِ لَمْ تُلْمِمْ بِهِ يَدُهَا","فَأَقْبَلَتْ بِضِيَاءِ الْعَيْنِ تَسْتَلِمُ",7,"م",1,0],["ذِي الهِمَّةِ المُثْلَى كَهَمَّ","أَبِيهِ فِي طَلَبِ المَعَالِي",8,"ي",1,0],["ذيب نرهن ذا الغفاره","ونرده في غباره",9,"ه",1,1],["ذيب تمشي لقصورك","وديارك الشريفا",10,"ف",2,0],["ذي مِنسَرٍ فَخمٍ وَعَينٍ غائِرَه","وَفَخِذٍ مِلءَ اليَمينِ وافِرَه",11,"ه",1,0],["ذَيّالَةً ذَلَّت لَها صِعابُهُ","رَكبُ هَياهُ وَالصِبا رِكابُهُ",12,"ب",2,0],["ذي المجد لا في ساعديهِ عن العلا","قصرٌ ولا في عزمهِ إعياء",13,"ا",2,0],["ذي سطورٍ مثل البساتين تجنى","وهي حولَ الإسلام مثل السياج",14,"ج",1,0],["ذي حسانٌ من القصائد تجلى","وهي محتاجة لحظ القباح",15,"ح",1,0],["ذي مقلة تلقى الضرا","غمَ بالجفون الكاسره",16,"ر",2,0],["ذي السلم لا تعبأ له ديمةٌ","والحرب لا يصلى له جمره",17,"ر",2,0],["ذي الرأي يشكي السلاح الجمّ حدّته","لذاك يسمَّى السلاح الجمّ بالشاكي",18,"ك",2,0],["ذي البيت وافته بيوت قصيدة","لاقت فنحْنِح يا بيان ونهنه",19,"ه",1,0],["ذي فَيْشَةٍ شكَّتْ فؤا","دَك بعدما هتكت حِجابهْ",20,"ب",2,0],["ذي مِعْدةٍ ثعلبُها لاحِس","وتارةً أرنبُها ضاغبُ",21,"ب",1,0],["ذِيقَ لها اللوزُ فلا مُرَّةٌ","مرتْ على الذائق إلا أبى",22,"ب",2,0],["ذي نجوم كأنهن نجوم ال","شَيْبِ ليست تزول لكن تزيدُ",23,"د",1,0],["ذي نجومٍ كأنهنَّ نجومُ ال","شيب ليست تغور لا بل تزيدُ",24,"د",1,0],["ذي عِذار يترك النْا","سك مخلوعَ العذار",25,"ر",1,0],["ذي نجوم من خُزامَى","وشموس من بَهار",25,"ر",1,0],["ذي مُردة توفيك سُنَّتُهُ","نورَ الهلالِ وصورةَ الصَّنمِ",26,"م",1,0],["ذي وقارٍ في ذكاءٍ وحجىً","في بهاءٍ وحياء في لَسَن",27,"ن",1,0],["ذي عيالٍ زبونُهنَّ من النا","كة بعدَ الهُدوّ مثلُ زبونه",28,"ن",2,0],["ذي نَغمَةٍ يَسبي القُلوبَ بِها رَشا","مِن عِندِ رضوانٍ أَتانا هارِبا",29,"ب",2,0],["ذي هِمَّةٌ دونها في شَأوِها الهِمَمُ","لَم تَتَّخِذ لا وَلَم تَكذِب لَها نعَمُ",30,"م",1,1],["ذي المَعالي فَليَعلَوَن مَن تَعالى","هَكَذا هَكَذا وَإِلّا فَلالا",31,"ل",2,1],["ذي ذَنَبٍ أَجرَدَ غَيرَ أَعزَلِ","يَخُطُّ في الأَرضِ حِسابَ الجُمَلِ",32,"ل",1,0],["ذي الأرضُ عمّا أتاها الأمسَ غانِيَةٌ","وغيرُها كان محتاجاً إلى المَطَرِ",33,"ر",1,1],["ذي مقلة سهامها","من القلوب داميه",34,"ي",2,0],["ذي سِمَةٍ مَغموسَةٍ في النُّورِ","كصفحةِ الدينارِ ذي السُّطورِ",35,"ر",1,0],["ذِئْبَيْنِ لو ظفرَا بالشِّعرِ في حَرَمٍ","لَمَزَّقاهُ بأنيابٍ وأظفارِ",36,"ر",1,0],["ذِئبَينِ إذ نَظَرا إلى سيَّارَةٍ","بَعَثا لها يوماً كيومِ ذُؤَابِ",37,"ب",1,0],["ذي المَعالي فَتى المُهَذَّبِ شَمسُ ال","دينِ رَبُّ المَناقِبِ الباهِراتِ",38,"ت",1,0],["ذي طَلعَةٍ جَلَتِ العُيونَ بِحُسنِها","وَجَلَت هُمومَ الناسِ مِن إِحسانِها",39,"ن",3,0],["ذي موازيب حديدٍ فَهَقَتْ","بِصَبيبِ الدَّم من طَعنِ الكُبود",40,"د",1,0],["ذِئبُ فَلاةٍ كَيدُهُ دارِعٌ","صادَفَ ظَبياً كَيدُهُ حاسِرُ",41,"ر",1,0],["ذي كُمتَةٍ أَو شُقرَةٍ أَو حُوَّةٍ","أَو دُهمَةٍ فَهِمُ الفُؤادِ سَديدِ",42,"د",1,0],["ذي مَيعَةٍ مَشيُهُ الدِفَقّى","وَذاتِ لَوثٍ بِها مَلوثِ",43,"ث",1,0],["ذي فؤادٍ أقسى من الصخرِ لكنْ","عطفُهُ يلتوي بفرطِ اللينِ",44,"ن",1,0],["ذي جلالٍ وهيبةٍ ووقارٍ","وحيا زائدٍ وعقلٍ ودينِ",44,"ن",1,0],["ذي مَحاريبَ أُحرِزَت أَن تَراها","كُلُّ بَيضاءَ سَهلَةِ العِرنَينِ",45,"ن",1,0],["ذي أُمُّها كانَت مِنَ الرومِ أَصلُها","وَقَصدي أَنا أَصلٌ يَكونُ كَريما",46,"م",2,0],["ذي فُروغٍ يَظَلُّ مِن زَبَدِ الجَو","فِ عَلَيهِ كَثامِرِ الحُمّاضِ",47,"ض",1,0],["ذي طُرَّةٍ عاطِرَةٍ كَالعَنبَرِ","وَمَبسِمٍ يَكشِفُهُ عَن جَوهَرِ",48,"ر",1,0],["ذي أُذُنٍ كَخَوصَةِ العَسيبِ","أَو آسَةٍ أَوفَت عَلى قَضيبِ",49,"ب",1,0],["ذي جيئَةٍ صَعبٍ وَذي ذَهابِ","أَشبَعَني مِنهُ مِنَ الكَبّابِ",50,"ب",1,0],["ذي بُرنُسٍ مُذَهَّبٍ رَصيصِ","وَهامَةٍ وَمِنسَرٍ حَصيصِ",51,"ص",1,0],["ذي لُغَةٌ تَسجُدُ اللُغاتُ لَها","أَلغَزَها عاشِقٌ وَعَمّاها",52,"ا",3,0],["ذُيولُهُم كَثيراتُ المَخازي","لِما فَقَدوهُ مِن نُصحِ الجُيوبِ",53,"ب",1,0],["ذئاب حول جنَّتِهِ تعاوَى","كأن بها إِلى دمه نهامهْ",54,"م",2,0],["ذِي نباتٍ طَيِّبٍ أَعْرَافُهُ","كَعِذَارِ الشَّعْر في الخَدِّ بَدَا",55,"د",2,0],["ذي تَليلٍ مُشنِقٍ قائِدَهُ","يَسَرٍ في الكَفِّ نَهدٍ ذي غُسَن",56,"ن",1,0],["ذِي نَظْرَةٍ كَالسِّحْرِ لَوْ صَادَفَتْ","غَمْزَتُهَا لَيْثَ وَغىً مَا فَتَكْ",57,"ك",1,0],["ذِئْبٌ تَوَهَّمَهُمْ نِيَا","ماً فِي الحَظِيرَةِ كَالنَّعَمْ",58,"م",1,0],["ذِي الأيَادِي مِنْ كُلِّ لَوْنٍ وَأَغْلاَ","هُنَّ فِي الْمَأْثُرَاتِ بِيضُ الأيَادِي",59,"د",2,0],["ذي نبات بلبلت أعرافه","كعذار الشعر في الخد بدا",60,"د",2,0],["ذي جانبْينِ ، فجانب مُتطامِنٌ","يقسو النسيمُ عليه في تقبيله",61,"ل",2,0],["ذيالة ً ذلتْ لها صعابهُ","ركبُ حيَّا كانَ الصبا ركابهُ",62,"ب",2,0],["ذي نجوم كأنهن نجوم الشْ","شَيْبِ ليست تزول لكن تزيدُ",63,"د",1,0],["ذي ضُلَّ تَفْدِية ٍ هنا","لك تستديمُ بها هِبابهْ",64,"ب",2,0],["ذِئَابٌ تُدَاجِي نَعْجَةً لافْتِرَاسِهَا","وَتَرْقُبُ مِنْهَا فُرْصَةً لاخْتِلاَسِهَا",65,"ه",2,0]]}