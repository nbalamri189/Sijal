[412,"ما راق للطرف غير طرف","https://www.aldiwan.net/poem4189.html","مخلع البسيط"],[420,"جدد اللذة حتى نتجدد","https://www.aldiwan.net/poem54102.html","الرمل"],[436,"خبراني بهول يوم الفراق","https://www.aldiwan.net/poem12469.html","الخفيف"],[436,"يا عاذلي لا تطيلا عذلي","https://www.aldiwan.net/poem12482.html","الرجز"],[436,"أيها اللائم لم غي","https://www.aldiwan.net/poem12544.html","مجزوء الرمل"],[436,"ما الطويل الذراع مثل القصير","https://www.aldiwan.net/poem12627.html","الخفيف"],[436,"يا هذه لا تنطقي","https://www.aldiwan.net/poem12812.html","مجزوء الرجز"],[445,"يموت الصحيح ويحيا المصاب","https://www.aldiwan.net/poem14346.html","المتقارب"],[445,"الرزء أعظم أن تراق دموع","https://www.aldiwan.net/poem14460.html","الكامل"],[445,"آها لها من غصة النادم","https://www.aldiwan.net/poem14479.html","السريع"],[447,"أهلا بطلعة وجهك المحبوب","https://www.aldiwan.net/poem55944.html","عموديه"],[455,"قل وحث المدام في إبانه","https://www.aldiwan.net/poem13936.html","الخفيف"],[461,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[464,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[467,"بين حزني وحسنه اليوسفي","https://www.aldiwan.net/poem3166.html","عموديه"],[467,"وجدي كوجدك بالظباء الغيد","https://www.aldiwan.net/poem3208.html","عموديه"],[467,"أما الديار فتلك عين ظبائها","https://www.aldiwan.net/poem3213.html","عموديه"],[467,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[482,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[496,"ويؤيؤ أوحى من القضاء","https://www.aldiwan.net/poem67301.html","الرجز"],[498,"سفينة لم تعتمل بنجر","https://www.aldiwan.net/poem9864.html","مشطور الرجز"],[503,"حب النبي الهاشمي ديني","https://www.aldiwan.net/poem37768.html","الرجز"],[561,"الله أنزل حكم أمري","https://www.aldiwan.net/poem34521.html","مجزوء الكامل"],[565,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[570,"وملعب للخيل في قرواح","https://www.aldiwan.net/poem69751.html","الرجز"],[578,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"]],"verses":[["ذي سَوءَةٍ إِن ثَناها مَحفِلٌ كَثُرَت","لَها المَضارِبُ فَوقَ الصَدرِ بِالذَقَنِ",0,"ن",1,0],["ذِئابٌ أَرادَت أَن تُعازِزَ ضَيغَماً","فَطالَ عَلى مَرِّ الزَمانِ هَوانُها",1,"ن",3,0],["ذي غُرَّةٍ سُبِغَت عَليهِ كَأَنَّهُ","فيها يَمُدُّ لِحاظَهُ مِن بُرقِعِ",2,"ع",1,0],["ذي ضِياءٍ إِن جَلا عِرنينَهُ","ضَوَّأَ اللَيلَ وَما أَوقَدَ نارا",3,"ر",2,0],["ذي عَزمَةٍ إِن دَعاها الرَوعُ مُنتَصِراً","تَلَفَّتَت عَن غِرارِ الصارِمِ الخَشِبِ",4,"ب",1,0],["ذي نَيرَبٍ نَزِعٍ لَو قَد نَصَبتُ لَهُ","وَجهي لَقَد قالَ كُنتَ الحائِنَ الحَمِقا",5,"ق",2,0],["ذي مِرَّةٍ تُشجيهِ ذا","تُ النَقعِ لا ذاتُ الخِمار",6,"ر",1,0],["ذِيدَتْ عَنِ الرُّكْنِ لَمْ تُلْمِمْ بِهِ يَدُهَا","فَأَقْبَلَتْ بِضِيَاءِ الْعَيْنِ تَسْتَلِمُ",7,"م",1,0],["ذِي الهِمَّةِ المُثْلَى كَهَمَّ","أَبِيهِ فِي طَلَبِ المَعَالِي",8,"ل",2,0],["ذيب نرهن ذا الغفاره","ونرده في غباره",9,"ه",1,1],["ذيب تمشي لقصورك","وديارك الشريفا",10,"ف",2,0],["ذي مِنسَرٍ فَخمٍ وَعَينٍ غائِرَه","وَفَخِذٍ مِلءَ اليَمينِ وافِرَه",11,"ه",1,0],["ذَيّالَةً ذَلَّت لَها صِعابُهُ","رَكبُ هَياهُ وَالصِبا رِكابُهُ",12,"ب",2,0],["ذي المجد لا في ساعديهِ عن العلا","قصرٌ ولا في عزمهِ إعياء",13,"ا",2,0],["ذي سطورٍ مثل البساتين تجنى","وهي حولَ الإسلام مثل السياج",14,"ج",1,0],["ذي حسانٌ من القصائد تجلى","وهي محتاجة لحظ القباح",15,"ح",1,0],["ذي مقلة تلقى الضرا","غمَ بالجفون الكاسره",16,"ر",2,0],["ذي السلم لا تعبأ له ديمةٌ","والحرب لا يصلى له جمره",17,"ر",2,0],["ذي الرأي يشكي السلاح الجمّ حدّته","لذاك يسمَّى السلاح الجمّ بالشاكي",18,"ك",2,0],["ذي البيت وافته بيوت قصيدة","لاقت فنحْنِح يا بيان ونهنه",19,"ه",1,0],["ذي فَيْشَةٍ شكَّتْ فؤا","دَك بعدما هتكت حِجابهْ",20,"ب",2,0],["ذي مِعْدةٍ ثعلبُها لاحِس","وتارةً أرنبُها ضاغبُ",21,"ب",1,0],["ذِيقَ لها اللوزُ فلا مُرَّةٌ","مرتْ على الذائق إلا أبى",22,"ب",2,0],["ذي نجوم كأنهن نجوم ال","شَيْبِ ليست تزول لكن تزيدُ",23,"د",1,0],["ذي نجومٍ كأنهنَّ نجومُ ال","شيب ليست تغور لا بل تزيدُ",24,"د",1,0],["ذي عِذار يترك النْا","سك مخلوعَ العذار",25,"ر",1,0],["ذي نجوم من خُزامَى","وشموس من بَهار",25,"ر",1,0],["ذي مُردة توفيك سُنَّتُهُ","نورَ الهلالِ وصورةَ الصَّنمِ",26,"م",1,0],["ذي وقارٍ في ذكاءٍ وحجىً","في بهاءٍ وحياء في لَسَن",27,"ن",1,0],["ذي عيالٍ زبونُهنَّ من النا","كة بعدَ الهُدوّ مثلُ زبونه",28,"ن",2,0],["ذي نَغمَةٍ يَسبي القُلوبَ بِها رَشا","مِن عِندِ رضوانٍ أَتانا هارِبا",29,"ب",2,0],["ذي هِمَّةٌ دونها في شَأوِها الهِمَمُ","لَم تَتَّخِذ لا وَلَم تَكذِب لَها نعَمُ",30,"م",1,1],["ذي المَعالي فَليَعلَوَن مَن تَعالى","هَكَذا هَكَذا وَإِلّا فَلالا",31,"ل",2,1],["ذي ذَنَبٍ أَجرَدَ غَيرَ أَعزَلِ","يَخُطُّ في الأَرضِ حِسابَ الجُمَلِ",32,"ل",1,0],["ذي الأرضُ عمّا أتاها الأمسَ غانِيَةٌ","وغيرُها كان محتاجاً إلى المَطَرِ",33,"ر",1,1],["ذي مقلة سهامها","من القلوب داميه",34,"ي",2,0],["ذي سِمَةٍ مَغموسَةٍ في النُّورِ","كصفحةِ الدينارِ ذي السُّطورِ",35,"ر",1,0],["ذِئْبَيْنِ لو ظفرَا بالشِّعرِ في حَرَمٍ","لَمَزَّقاهُ بأنيابٍ وأظفارِ",36,"ر",1,0],["ذِئبَينِ إذ نَظَرا إلى سيَّارَةٍ","بَعَثا لها يوماً كيومِ ذُؤَابِ",37,"ب",1,0],["ذي المَعالي فَتى المُهَذَّبِ شَمسُ ال","دينِ رَبُّ المَناقِبِ الباهِراتِ",38,"ت",1,0],["ذي طَلعَةٍ جَلَتِ العُيونَ بِحُسنِها","وَجَلَت هُمومَ الناسِ مِن إِحسانِها",39,"ن",3,0],["ذي موازيب حديدٍ فَهَقَتْ","بِصَبيبِ الدَّم من طَعنِ الكُبود",40,"د",1,0],["ذِئبُ فَلاةٍ كَيدُهُ دارِعٌ","صادَفَ ظَبياً كَيدُهُ حاسِرُ",41,"ر",1,0],["ذي كُمتَةٍ أَو شُقرَةٍ أَو حُوَّةٍ","أَو دُهمَةٍ فَهِمُ الفُؤادِ سَديدِ",42,"د",1,0],["ذي مَيعَةٍ مَشيُهُ الدِفَقّى","وَذاتِ لَوثٍ بِها مَلوثِ",43,"ث",1,0],["ذي فؤادٍ أقسى من الصخرِ لكنْ","عطفُهُ يلتوي بفرطِ اللينِ",44,"ن",1,0],["ذي جلالٍ وهيبةٍ ووقارٍ","وحيا زائدٍ وعقلٍ ودينِ",44,"ن",1,0],["ذي مَحاريبَ أُحرِزَت أَن تَراها","كُلُّ بَيضاءَ سَهلَةِ العِرنَينِ",45,"ن",1,0],["ذي أُمُّها كانَت مِنَ الرومِ أَصلُها","وَقَصدي أَنا أَصلٌ يَكونُ كَريما",46,"م",2,0],["ذي فُروغٍ يَظَلُّ مِن زَبَدِ الجَو","فِ عَلَيهِ كَثامِرِ الحُمّاضِ",47,"ض",1,0],["ذي طُرَّةٍ عاطِرَةٍ كَالعَنبَرِ","وَمَبسِمٍ يَكشِفُهُ عَن جَوهَرِ",48,"ر",1,0],["ذي أُذُنٍ كَخَوصَةِ العَسيبِ","أَو آسَةٍ أَوفَت عَلى قَضيبِ",49,"ب",1,0],["ذي جيئَةٍ صَعبٍ وَذي ذَهابِ","أَشبَعَني مِنهُ مِنَ الكَبّابِ",50,"ب",1,0],["ذي بُرنُسٍ مُذَهَّبٍ رَصيصِ","وَهامَةٍ وَمِنسَرٍ حَصيصِ",51,"ص",1,0],["ذي لُغَةٌ تَسجُدُ اللُغاتُ لَها","أَلغَزَها عاشِقٌ وَعَمّاها",52,"ا",3,0],["ذُيولُهُم كَثيراتُ المَخازي","لِما فَقَدوهُ مِن نُصحِ الجُيوبِ",53,"ب",1,0],["ذئاب حول جنَّتِهِ تعاوَى","كأن بها إِلى دمه نهامهْ",54,"م",2,0],["ذِي نباتٍ طَيِّبٍ أَعْرَافُهُ","كَعِذَارِ الشَّعْر في الخَدِّ بَدَا",55,"د",2,0],["ذي تَليلٍ مُشنِقٍ قائِدَهُ","يَسَرٍ في الكَفِّ نَهدٍ ذي غُسَن",56,"ن",1,0],["ذِي نَظْرَةٍ كَالسِّحْرِ لَوْ صَادَفَتْ","غَمْزَتُهَا لَيْثَ وَغىً مَا فَتَكْ",57,"ك",1,0],["ذِئْبٌ تَوَهَّمَهُمْ نِيَا","ماً فِي الحَظِيرَةِ كَالنَّعَمْ",58,"م",1,0],["ذِي الأيَادِي مِنْ كُلِّ لَوْنٍ وَأَغْلاَ","هُنَّ فِي الْمَأْثُرَاتِ بِيضُ الأيَادِي",59,"د",2,0],["ذي العزة القعساء في شئونه","لا ترتضي الا النجوم خولا",60,"ل",2,0],["ذي نبات بلبلت أعرافه","كعذار الشعر في الخد بدا",61,"د",2,0],["ذي جانبْينِ ، فجانب مُتطامِنٌ","يقسو النسيمُ عليه في تقبيله",62,"ل",2,0],["ذيك الذبال اللي تقل..؟ كنها تحذوااني حذي..","مبروزة الاحرف..... مرويت الحيام المضميه.",63,"م",3,0],["ذيالة ً ذلتْ لها صعابهُ","ركبُ حيَّا كانَ الصبا ركابهُ",64,"ب",2,0],["ذي نجوم كأنهن نجوم الشْ","شَيْبِ ليست تزول لكن تزيدُ",65,"د",1,0],["ذي ضُلَّ تَفْدِية ٍ هنا","لك تستديمُ بها هِبابهْ",66,"ب",2,0],["ذِئَابٌ تُدَاجِي نَعْجَةً لافْتِرَاسِهَا","وَتَرْقُبُ مِنْهَا فُرْصَةً لاخْتِلاَسِهَا",67,"ه",2,0],["ذئاب حول جنّته تعاوى","كأنّ بكلّ معترك زحامه",68,"م",2,0],["ذي السَجايا التي تَشاغل قَلبي","حينَ أَبصَرتَها عَن الأَحباب",69,"ب",1,0],["ذي نَواس كَأَنَّها ظُلمة الشر","ك وَوَجه كَأَنَّهُ الإِيمان",70,"ن",1,0],["ذي تيرس آدرارُ أجل","زمورُيت واسعات كالحما",71,"م",2,0],["ذِى الفضلِ سلطانِ بن سيفِ الندَى","الزاكِي المكرَّمِ في مَدَى الأيَّامِ",72,"م",1,0],["ذِى العدلِ سلطانِ","الهُمَامِ بن الهُمَامِ بن الهُمَامِ",73,"م",1,0],["ذيَّاكَ بَرْق لاح لِي من عارضٍ","أمْ ذاكَ يا ليلى ضيا سَنَاكِ",74,"ك",1,0],["ذي هِمَّةٍ عَدَويَّةٍ ما رُوِّعَت","بِعِداً وَلا باتَت عَلى عُدَواءِ",75,"ا",2,0],["ذِيادَ الصَّوَادِى عَن قِرى الماءِ بَعدَما","مضى والفَلا سَبعٌ لَها وثَمانِ",76,"ن",1,0],["ذي وِدادٍ كَأَنَّهُ الفَضةُ البَيْ","ضاءُ زادَت يَدُ الزَمانِ جَلاها",77,"ا",3,0],["ذي الدَولةِ العُظمى الَّذي مَن أَمَّهُ","فَجِوارُهُ حَرمٌ عَلى الأَيَّامِ",78,"م",1,0],["ذِئابٌ على الإسلامِ صالوا وَما اِكتفوا","بِأَنيابِهم حتّى بهِ أَنشَبوا الظفرا",79,"ر",2,0],["ذي همَّةٍ علياءَ لا تُرْتَقَى","وعزمةٍ صمّاءَ لا تُغْلَبُ",80,"ب",1,0],["ذي يدي قَد مزَّقتها لُقَمٌ","تُجتَنى من فَوقِ أَطرافِ الرماح",81,"ح",1,0],["ذي الحِجى وَالوَقارِ يَص","غَرُ في حِضنِهِ حَضَن",82,"ن",1,0],["ذي شِيَةٍ أَشبَهَ شَي","ءٍ بِشِياتِ الحَدَقِ",83,"ق",1,0],["ذي النائِلِ الفَيّاضِ في ال","لَزَباتِ وَالرَأيِ الحَصيفِ",84,"ف",1,0],["ذي المَورِدِ المَشفوهِ تَحمَدُهُ إِذا","يَمَّمتَهُ وَالنائِلِ المَشفوعِ",85,"ع",1,0],["ذي الكَرَمِ العِدِّ وَالمَآثِرِ لا","تَفنى وَيَفنى مِن دونِها العُدَدُ",86,"د",1,0],["ذي كَبوَةٍ هَمٍّ إِذا هَمَّ أَن","يَركُضُهُ فارِسُهُ أَوتَدا",87,"د",2,0],["ذِيِ عِفَّةٍ تَحْمِيهِ هِمَّتُهُ","عَنْ أَنْ يَجِيءَ بِفَاحِشٍ نَكْبِ",88,"ب",1,0],["ذِي قِسْمَةٌ ضِيزَى وَحَاشَ جَلاَلُكُمْ","أَنْ تَغْبَنُوا مَمْلُوكَكُمْ بِمِثَالِهَا",89,"ل",3,0],["ذِي خَلَّةٍ وَحَمْضِ","مِنَ الْجَمِيمِ الْغَضِّ",90,"ض",1,0],["ذي جمال يمتاز بالحسن أن","يدرك عمن سواه بالتمييز",91,"ز",1,0],["ذيّالِكَ البطلُ احتميتِ بسيفهِ","والرعبُ في قلبِ العدوِّ الغادر",92,"ر",1,0],["ذيالِكَ النحرُ الذي قبَّلتُهُ","كنزُ السعادةِ لي وكنتُ الناهبا",93,"ب",2,0],["ذيّالِكَ الحسنُ الذي هو نعمةٌ","هل كان يا حسناءُ كي يُشقينا",94,"ن",2,0],["ذياك روحٌ يستطيرُ وميضُهُ","فالروحُ منكَ لروحِ ربّكَ مظهر",95,"ر",1,0],["ذيَّالِكَ الماضي يَعزُّ رجوعُهُ","وأعزّ منه الفوزُ في آتينا",96,"ن",2,0],["ذيالكَ الجبّارُ أصبحَ نسلُهُ","قزماً فضيّع مُلكَهُ الأحفاد",97,"د",1,0],["ذِئابُ الفَلا مِن دونِها وَأُسودُها","وَأَعيُنُ حُسّادٍ بِهِنَّ رُميتُ",98,"ت",1,0],["ذي مَنكِبٍ رَهلٍ وَقُصرى جَأبَةٍ","وَصَليفِ أَرعَنَ يافِعِ المُتَلَدَّدِ",99,"د",1,0],["ذي وجنةٍ عند لثمي","شفت سقامي وشفت",100,"ت