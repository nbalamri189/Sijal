iwan.net/poem711.html",""],[456,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[456,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[456,"ألا صاحب كالسيف حلو شمائله","https://www.aldiwan.net/poem55994.html","الطويل"],[456,"أمن كل حظ قل قسمي أقله","https://www.aldiwan.net/poem56071.html","الطويل"],[456,"لأية لبسة خلع الخلاعه","https://www.aldiwan.net/poem56137.html","الكامل"],[456,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[456,"إذا صاح وفد السحب بالريح أوحدا","https://www.aldiwan.net/poem56243.html","الطويل"],[456,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[456,"تزِل الليالي مرة وتصيب","https://www.aldiwan.net/poem56290.html","الطويل"],[456,"حمام اللوى رفقا به فهو لبه","https://www.aldiwan.net/poem56306.html","الطويل"],[464,"ولما لحقنا بالحمول ودونها","https://www.aldiwan.net/poem50414.html","الطويل"],[473,"عرفت بأجدث فنعاف عرق","https://www.aldiwan.net/poem1823.html","الوافر"],[477,"قل يوم حتفك عندي","https://www.aldiwan.net/poem37001.html","المجتث"],[477,"في الجد أو في اللعب","https://www.aldiwan.net/poem37612.html","مجزوء الرجز"],[477,"قضيا المعيشة في مضيق","https://www.aldiwan.net/poem37614.html","مجزوء الكامل"],[484,"ألا هل فؤادي إذ صبا اليوم نازع","https://www.aldiwan.net/poem481.html",""],[513,"قليل لك المدح الذي بك فخره","https://www.aldiwan.net/poem12151.html","الطويل"],[549,"إن على رمل العقيق خيما","https://www.aldiwan.net/poem47229.html","الرجز"],[549,"على من ثوى أرض الحجاز تحية","https://www.aldiwan.net/poem47340.html","الطويل"],[562,"لشمس مجدك في الآفاق أضواء","https://www.aldiwan.net/poem820.html",""],[565,"مذبة تهدى إلى سيد","https://www.aldiwan.net/poem69814.html","السريع"],[574,"قليتك فاقليني فلا وصل بيننا","https://www.aldiwan.net/poem1789.html","الطويل"]],"verses":[["قَليلُ مُقامٍ بَينَ أَهلٍ وَثَروَةٍ","كَثيرُ طُلوعٍ بَينَ وادٍ وَمَخرَم",0,"م",1,0],["قَليلُ حَديثٍ مارِقٍ غَيرُ مُكثِرٍ","وَبَدءُ مَقالٍ وارِدٍ مِن مُتَمِّمِ",0,"م",1,0],["قَليلٌ مِنَ الخُلّانِ مَن لا تَذُمُّهُ","وَكُثرٌ مِنَ الأَعداءِ مَن أَنتَ هَمُّهُ",1,"م",2,1],["قَليلِ حَيا الرُمحِ عِندَ الطِعانِ","وَقورِ الجَوادِ سَفيهِ الحُسامِ",2,"م",1,0],["قَليلِ اِدِّخارِ الزادِ يَعلَمُ أَنَّهُ","مَتى ما يُعايِن مَطعَماً فَهوَ أُكلُهُ",3,"ل",2,0],["قَليلَ المِثالِ وَخَيرَ البِلادِ","حِمى مَنزِلٍ لا أَرى فيهِ مِثلا",4,"ل",2,0],["قَليلُ مَدحِكَ في شِعري يُزَيِّنُهُ","حَتّى كَأَنَّ مَقالي فيكَ تَغريدُ",5,"د",1,0],["قَليلٌ أَن تُقادَ لَهُ الغَوادي","وَتُنحَرَ فيهِ أَعناقُ السَحابِ",6,"ب",1,0],["قَليلٌ إِلى الرِّيِّ الذّليلِ الْتفاتُهُ","وإنْ كَثُرَتْ لِلْوارِدينَ المَناهِلُ",7,"ل",1,0],["قَليلاً فَثَمَّ زَجَرتُ الصِبى","وَعادَ عَلَيَّ عَزائي وَصارا",8,"ر",2,0],["قَليلُ التَأَنّي مُستَتِبٌّ كَأَنَّهُ","لَها واسِقٌ يَنجو بِها اللَيلَ غانِمُ",9,"م",1,0],["قَليلَ التَعَجُّبِ جَمَّ الأَناةِ","حَكيمَ الوُرودِ حَكيمَ الصَدَر",10,"ر",1,0],["قَلِيلُ الأَلايا حَافِظٌ لِيَمِينِهِ","فَإِن سَبَقَت مِنهُ الأَليَّةُ برَّتِ",11,"ت",1,0],["قُلْ يَا بَنِي أُمِي إِلَى الرُّشْدِ ارْجِعُوا","حَتَّى مَ فُرْقَةُ شَمْلِكُمْ وَإِلَى كَمِ",12,"م",1,0],["قَليلَةُ زُوّارٍ سِوى بَعضِ زُوَّرٍ","مِنَ الضَبعِ وَالعِقبانِ وَالرَخَماتِ",13,"ت",1,0],["قَليلٌ عَلى أَكوارِهِنَّ اِتِّقاؤُنا","صَلا القَيظِ إِلّا أَنَّنا نَتَلَثَّمُ",14,"م",1,0],["قَليلِ نِصابِ المالِ إِلّا سِهامُهُ","وِإِلّا زَجوماً سَهوَةً في الأَصابِعِ",15,"ع",1,0],["قَليلاً كَتَحليلِ الأَلى ثُمَّ قَلَّصَت","بِهِ شيمَةٌ روعاءُ تَقليصَ طائِرِ",16,"ر",1,0],["قَليلٌ ما يَنالُكَ مِن سُلَيمى","عَلى طولِ التَقارُبِ وَالبِعادِ",17,"د",1,0],["قَليلٌ بِهِ ما يَحمَدَنَّكَ وارِثٌ","إِذا ساقَ مِمّا كُنتَ تَجمَعُ مَغنَما",18,"م",2,0],["قُل يا رَسولُ وَلا تُحاشِ فَإِنَّهُ","لا بُدَّ مِنهُ أَساءَ بي أَم أَحسَنا",19,"ن",2,0],["قَليلُ اِعتِذارٍ مَن يَبيتُ ذُنوبُهُ","طِلابُ المَعالي وَاِكتِسابُ المَحامِدِ",20,"د",1,0],["قل يا محمد تفصح الأكوان عن","حمدٍ كأنَّ مزاجه تسنيم",21,"م",1,0],["قل يا محمد فيه يسمع فنُّه","قولاً يطول إلى السهى كيوانه",22,"ن",2,0],["قُلي فَدَيتُكَ يا سَمعي وَيا بَصَري","لِم ذي اللُجاجَةُ في بُعدي وَإِقصائي",23,"ا",3,0],["قلىً لمشيبي في رِضاً عن خليقتي","فهُنّ دَوانٍ والقلوبُ شواحِطُ",24,"ط",1,0],["قليت الرجال أشد القلى","وعفت جداهم أشد العياف",25,"ف",1,0],["قل يا أبا حسن لا زلتَ في مِنَنٍ","يا ماليءَ القلبِ والأذنين إحسانا",26,"ن",2,1],["قَليلٍ لَحمُهُ إِلّا بَقايا","طَفاطِفِ لَحمِ مَمحوصٍ مَشيقِ",27,"ق",1,0],["قَليلاً كَي وَلا حَتّى تَرَوها","مُشَمِّرَةً عَلى قَدَمٍ وَساقِ",28,"ق",1,0],["قَليلاً غِرارُ العَينِ حَتّى يُقَلِّصوا","عَلى كَالقَطا الجونِيِّ أَفزَعَهُ القَطرُ",29,"ر",1,0],["قَليلٌ تَواليها وَطالِبُ وِترِها","إِذا صُحتُ فيها بِالفَوارِسِ وَالرَجلِ",30,"ل",1,0],["قَليلٌ ذَنبُهُ وَالذَنبُ جَمٌّ","وَلَكِن لِلغِنى رَبٌّ غَفورُ",31,"ر",1,0],["قَليلُ اِلتِماسِ الزادِ إِلّا لِنَفسِهِ","إِذا هُوَ أَمسى كَالعَريشِ المُجَوَّرِ",32,"ر",1,0],["قُل يا رَسولُ وَما عَلَيكَ مَلامَةٌ","هُوَ ما أُكابِدُ دائِماً وَأُقاسي",33,"ي",1,0],["قَليلُ الكَرى يَرمي الفَلاةَ بِأَركُبٍ","إِذا سالَمَ النَومَ الضِعافُ العَواوِرُ",34,"ر",1,0],["قَليلاً ثُمَّ طِرنا فَوقَ خوصٍ","يُلاعِبنَ الأَزِمَّةَ وَالبُرينا",35,"ن",2,0],["قَليلاً ثُمَّ قامَ إِلى المَطايا","سَمادِعَةٌ يَجُرّونَ الثَنايا",36,"ي",2,1],["قل يا بني آثور لا تتمردوا","فاللَه للمتمردين مجاز",37,"ز",1,0],["قُل يا شَبابُ نَصيحَة","مِمّا يُزَوَّدُ غالِيَه",38,"ي",2,0],["قَليلَ المَساوي في زَمانٍ يَرى العُلا","ذُنوباً وَناسٍ يَخلُقونَ المَساوِيا",39,"ي",2,0],["قَليلونَ مِن بُعدٍ كَثيرونَ إِن دَنَوا","لَهُم سَكَنٌ آناً وَآناً تَهَيُّبُ",40,"ب",1,0],["قَليلُ الكَرى لَو كانَتِ البيضُ وَالقَنا","كَآرائِهِ ما أَغنَتِ البيضُ وَالزَعفُ",41,"ف",1,0],["قَليلٌ عائِدي سَقِمٌ فُؤادي","كَثيرٌ حاسِدي صَعبٌ مَرامي",42,"م",2,0],["قَليلٌ لَها أَنّي بِها مُغرَمٌ صَبُّ","وَأَن لَم يُقارِف غَيرَ وَجدٍ بِها القَلبُ",43,"ب",1,1],["قَليلُ فُضولِ الزادِ إِلّا صَواهِلاً","ظَهارِيَّ طَعنٍ أَو حَديداً يُظاهِرُه",44,"ر",2,0],["قَليلٌ مِثلُهُ وَأَقَلُّ شَيءٍ","وَأَعوَزُهُ مِنَ الناسِ النَظيرُ",45,"ر",1,0],["قَليلُ اِحتِجابِ الوَجهِ يَغدو بِمَسمَعٍ","مِنَ الأَمرِ حَتّى يَستَثيبَ وَمَنظَرِ",46,"ر",1,0],["قَليلينَ إِلّا أَنَّ حُسنَ بَلائِه