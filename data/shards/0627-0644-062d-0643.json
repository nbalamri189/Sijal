id=128473",""],[5629,"ضامي غرام","https://www.poetsgate.com/ViewPoem.aspx?id=184599",""],[5756,"المملكة عندنا غير","https://www.poetsgate.com/ViewPoem.aspx?id=5189",""],[5756,"كلمة حق","https://www.poetsgate.com/ViewPoem.aspx?id=5380",""],[402,"ألغرس غرسك أيها البستاني","https://www.poetsgate.com/ViewPoem.aspx?id=36486",""],[5956,"‏ عصفور وعُشُّ الإلهام ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182118",""],[5956,"حالُ العراق","https://www.poetsgate.com/ViewPoem.aspx?id=192358",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""],[5724,"مآتم الظلم تتلوهن أعياد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55142&r=&rc=9",""],[6202,"استبد الهوى عشقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86702&r=&rc=3",""],[2220,"الحكمُ حكمُ الجبرِ والاضطرارِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11469&r=&rc=343",""]],"verses":[["الحُكمُ لِلأَيّامِ مَرجِعُهُ","فيما رَأَيتَ فَنَم وَلا تَسَلِ",0,"ل",1,0],["أَلحِكْمَةُ الزَّهْرَاءُ شَادَاتْ مَعْهَداً","مَا زِلْتَ فِيهِ أَثْبَتَ الأرْكَانِ",1,"ن",1,0],["الحِكْمُ بِالجَّلْدِ فِي هَذَا الزَّمَانِ أَمَا","نَهَاكُمْ الرُّشْدَ عَنْهُ يَا لأُولي الحِكَمِ",2,"م",1,1],["الحَكَمُ اِبنُ أَبي العاصي الَّذينَ هُمُ","غَيثُ البِلادِ وَنورُ الناسِ في الظُلَمِ",3,"م",1,0],["الحكمُ يَعرِفُه نَبيلاً كَابِراً","ما زَادَهُ جَاهاً ولاسُلطانا",4,"ن",2,0],["الحكمُ عند ذوي الألبابِ أَربعةٌ","عزمٌ وحزمٌ ومعروف وإحسانُ",5,"ن",1,0],["الحكمُ عند المصلحين كفايةٌ","والعُرْفُ عند ذوي النُّهَى استحقاقُ",6,"ق",1,0],["الحكمُ للهِ والأقدارُ جاريةٌ","والموتُ آتٍ ويبقى كلُّ مأثورِ",7,"ر",1,0],["الحُكمُ لِلَهِ فَرداً لا شَريكَ لَهُ","أَلا لَهُ المُلكُ وَالسُلطانُ وَالغَلَبُ",8,"ب",1,0],["الحُكمُ أَيّامٌ تَمُرُّ حَثيثَةً","وَالذِكرُ يُنشَرُ وَالمُؤَرِّخُ يَكتُبُ",9,"ب",1,0],["الحُكمُ إِنصافٌ وَحُسنُ سِياسَةٍ","فَإِذا حَكَمتَ فَلا تَكُن جَبّارا",10,"ر",2,1],["الحكيمُ الذي يَهدُّ وَيبني","فيجيدُ البناءَ والتدميرا",11,"ر",2,0],["الحُكمُ لِلَّهِ فَالبَث مُفرَداً أَبَداً","وَلا تَكُن بِصُنوفِ الناسِ مُختَلِطاً",12,"ط",2,1],["الْحُكْمُ شُورَى لاَ تَفَرُّدَ صَالِحٌ","فِي غَيْرِ حُكْمِ الْوَاحِد القَهَّارِ",13,"ر",1,0],["أَلحِكْمَةُ المُنْتَقَاةُ تَسْبِي","حِجَاكَ وَالنُّكْتَةُ الشَّرُودُ",14,"د",1,0],["الحَكَمُ الآخِذُ فِي أَحْكَامِهِ","بِالقِسْطِ فِي الخَّلِيلِ وَالدَّقِيقِ",15,"ق",1,0],["ألحكمة الغراء من أسمائه","وعدن من أوطانه وعبقر",16,"ر",1,0],["الحكم ما لم يَجِدْ سيفًا يعزِّزُه","خُرافةٌ؛ مالها رَأسٌ ولا ذَنَب",17,"ب",1,0],["الحَكَم بن أبي العاصِي الذينَ هُمُ","غَيْثُ البِلادِ وَنُورُ النّاسِ في الظُّلَمِ",18,"م",1,0],["الحكيم الحاكم العد","ل بعفو وقصاص",19,"ص",1,0],["الحكمةُ اليومَ أدّبتني","فَصرتُ من ضربها كَبيرا",20,"ر",2,0],["الحكم حكمك والرضاء رضاكا","والامر أمرك والقرا بحماكا",21,"ك",2,1],["الحكمُ لله المهيمن لا لهمْ","ذلّ الذي يلقي الغداةَ سلاحا",22,"ح",2,0],["الحكم العدل المجيب الذي","كل عسير فلديه يسير",23,"ر",1,0],["الحَكيمِ الكَريمِ ذي الهِمَّةِ العَلْ","ياءِ شيخِ المَفْهومِ والمَنْطُوق",24,"ق",1,0],["الحُكمُ فصلٌ والكلامُ مفصَّل","والوجهُ طلْقٌ والنَّوالُ طليقُ",25,"ق",1,0],["الحكم لله في كل الامور فهل","اي اعتراض لنا في حكم رحمان",26,"ن",1,0],["الحكم عدل والرعية حرة","والملك بينهما أعز فخور",27,"ر",1,0],["الحكمُ حكمُك راحلاً ومقيما","والملك ملكك حادثاً وقديما",28,"م",2,1],["الحكم آل إليك والسلطانُ","والعدل فيما آل والإحسانُ",29,"ن",1,1],["الحُكمُ للَّه العليِّ الكَبيرْ","عَليكَ بِالصّبرِ أَيا ذا الوَزير",30,"ر",1,1],["الحُكمُ للَّهِ يَبدو حُكمُه حَسَنا","الأَمرُ للَّهِ مَنْ عَمَّ الوَرى مِننا",31,"ن",2,1],["الحكم العدل من عزائمه","قامت على الدهر فاكتفى القاعد",32,"د",1,0],["الحكم للبيض من سود العيون ولل","سمر الموائس كالخيزور في الحبر",33,"ر",1,0],["الحكم حكمُ دور","ما فيه أوّل",34,"ل",1,0],["الحكم حكم صلاتي لو تحققه","بيني وبين الإله الحق مقسوم",35,"م",1,0],["الحكمُ حكمُ الجبر والاضطرار","ما ثَم حكم يقتضي الاختبارْ",36,"ر",1,1],["الحكم لله ما للعبد منقلب","إلا إليه ولا عن حكمه هرب",37,"ب",1,1],["الحكمة الغراء طوع بنانه","والمأثرات تبثهن دواته",38,"ت",2,0],["الحكيمُ الطّبيبُ ذو الهزلِ والجدِّ","الأديبُ المشهورُ في الأمصار",39,"ر",1,0],["الحكَمُ العدلُ في رعيّته ال","كاملُ فيه العفاف والف‍َهَمُ",40,"م",1,0],["الحكم الحاكم لا محاله","وهو الحكيم محكما افعاله",41,"ه",1,0],["الحكم العدل الذي قد أرسلك","للناس يا مختار رحمة فلكْ",42,"ك",1,0],["الحكم جاءَ إِلَيكَ يَس","عى وَالمَسافَةُ لا تَقلُّ",43,"ل",1,0],["الحُكمُ لِلَّهِ العَلِيِّ الكَبِير","سُبحَانَهُ وَهوَ اللَّطِيفُ الخَبِير",44,"ر",1,1],["الحُكمُ وَهوَ النَّفىُ وَالإِثبَاتُ","ِإلَى ثَلاثٍ قَسَم الاثبات",45,"ت",1,0],["الحكم منهار والاحكام منحلة","ما اخس من حالة فيها ولا حالة",46,"ل",2,0],["الحكمةُ الأجزاء فيها عشرةٌ","هذا الذي قال الرسول وتابعَه",47,"ع",2,0],["الحكي .. قوت السمع / وأسامعي جياع","ومسامعي ماتت من الجوع .. للقوت",48,"ت",1,0],["الحكمُ لي قبلَ المقال وبَعدَهُ","ولكل ربٍّ في القصائدِ ما نوى",49,"و",2,0],["الحُكْمُ لِلشِّعْرِ في مَيْدَانِ عِزَّتِهِ","بَلْ غَايَةُ الشِّعْرِ أَنْ يُنْجِيكَ في النُوَبِ",50,"ب",1,0],["الحكاية سهلة جدا","هات بسرعه قوام ودانك",51,"ك",1,0],["الحكمُ للهِ كلٌّ غيرُه فاني","وفي المنايا عظاتُ كلِّ ولهانِ",52,"ن",1,1],["‎الحكايه ماهي طعنه والسلام ...","الحكايه ماورى الطعنه رجوع ،",53,"ع",1,0],["الحكم حكم الله , ولا فيه تغير","ودوامكم يا سيدي من دوامه",54,"م",2,0],["الحكم حمله حمل وأهواله أهوال","والذود عن مصالح الشعب كايد",55,"د",1,1],["الحكمة الزهراء شادت معهدا","ما زلت فيه أثبت الأركان",56,"ن",1,0],["الحكم أجمع في يديها راجياً","منها التقرُّبَ قبل حَمْلِ نُعُوشهِ",57,"ش",2,0],["الحكم للعملاءِ أصبح والعِدى","يا تعسَ شعبي من هواة النيرِ",58,"ر",1,0],["الحكم أن يخرجوها من مباءَتها","نفيا على بيت حزن نازح خرب",59,"ب",1,0],["الحكم لله لا يطغى به أحد","والشرع أولى إذا حكامنا حادوا",60,"د",3,0],["الحكم ما عاد إلا جلَّ معصية","والناس صلّت صلاة الغائب الجاري",61,"ر",2,0],["الحكمُ حكمُ الجبرِ والاضطرارِ","ما ثَم حكم يقتضي الاختيارْ",62,"ر",1,1]]}