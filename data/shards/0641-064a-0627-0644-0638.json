{"poems":[[94,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62212","البسيط"],[146,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[463,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[463,"في الظباء الغادين أمس غزال","https://www.aldiwan.net/poem56073.html","الخفيف"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122359","السريع"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136281","البسيط"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104465","السريع"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100392","الكامل"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199152","السريع"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85263","الكامل"],[4778,"رمت بالداء وانسلت","https://www.poetsgate.com/ViewPoem.aspx?id=193675",""],[4984,"الْعَرَبَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=201917",""],[6082,"حالة ايثار","https://www.poetsgate.com/ViewPoem.aspx?id=59125",""],[5126,"أعَاذلتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87835&r=&rc=49",""]],"verses":[["في الظِّلِّ والأَضواءِ والأَنسامِ","والكَائِناتِ تحوطُهُ بحَنانها",0,"ه",2,0],["في الظَّهْرِ والرَّأْسِ حَتَّى يَسْتَمِرَّ بِهِ","قَصْرُ الهِجَارِ وفي السَّاقَيْنِ كَالفَتَرِ",1,"ر",1,0],["في الظاعنين من الحِمىَ ظبىٌ له ال","أحشاءُ مرعىً والمآقى مَكرَعُ",2,"ع",1,0],["في الظاعنين عَلاقةٌ عَقدَتْ","عندي الحِفاظَ فلم تخف حَلّي",3,"ل",2,0],["في الظباء الغادين أمسِ غزالُ","قال عنه ما لايقول الخيالُ",4,"ل",1,1],["في الظهر والعصر إلى بابكم","اسعى وفي المغرب والصبح",5,"ح",1,0],["في الظاعنين إلى الارماس معتبر","لكل ذي فكرة قد عمه الوجل",6,"ل",1,0],["فيا لظبي قد حكى وجهه","وجيده بدر الدجى والغزال",7,"ل",1,0],["في الظبي منك لواحظ شهدت بها","حدق جرحن برامتين الريّما",8,"م",2,0],["في الظالمين انحجروا مثل ما","تنحجر الحية في الحجرة",9,"ه",1,0],["في الظلم والعدوان والفعل الذي","أضحى عن الشرع الشريف بمعزل",10,"ل",1,0],["في الظاهر اهتالوا لروعتها","ومصائب في الباطن انهلَّتْ",11,"ت",1,0],["في الظن كانت لشخص ظل يملكها","يدير جولتها والشمس محتجبة",12,"ب",2,0],["في الظهر سنفحص ماشيةً","ونعود بأسمن أبقارِ",13,"ر",1,0],["فيا لَظلامٍ كم يَهولُ اقتحامُهُ","تكاثف حتى أنصبَ الذهن سرْمدا",14,"د",2,0]]}