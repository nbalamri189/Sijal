https://poetry.dctabudhabi.ae/diwan/poem/124283","الطويل"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123463","الوافر"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147306","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120433","المتقارب"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120361","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120526","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4691,"بحجم الكون لو قيسا","https://www.poetsgate.com/ViewPoem.aspx?id=207367",""],[4699,"والتقينا","https://www.poetsgate.com/ViewPoem.aspx?id=155943",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4896,"ظلمات وشعاع","https://www.poetsgate.com/ViewPoem.aspx?id=180884",""],[585,"نثلت لك الكنانة في العتاب","https://www.poetsgate.com/ViewPoem.aspx?id=161849",""],[5126,"تحياتي إليك مع السماح","https://www.poetsgate.com/ViewPoem.aspx?id=206091",""],[5191,"جسدًا واحدًا","https://www.poetsgate.com/ViewPoem.aspx?id=211978",""],[5206,"حجر الفلاسفة","https://www.poetsgate.com/ViewPoem.aspx?id=187417",""],[5277,"لكي لا يطمعُ الأسفُ","https://www.poetsgate.com/ViewPoem.aspx?id=199942",""],[5277,"رجعُ الصدى","https://www.poetsgate.com/ViewPoem.aspx?id=210288",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5363,"طوبي ليبيا ابْتسمي","https://www.poetsgate.com/ViewPoem.aspx?id=144294",""],[5387,"أمي..","https://www.poetsgate.com/ViewPoem.aspx?id=53896",""],[5480,"رحل حمدان","https://www.poetsgate.com/ViewPoem.aspx?id=9892",""],[5672,"الحياة...بعد الخمسين","https://www.poetsgate.com/ViewPoem.aspx?id=212476",""],[5809,"سعادة","https://www.poetsgate.com/ViewPoem.aspx?id=205114",""],[5829,"وإن طاوعتني في الحبِّ أبشر","https://www.poetsgate.com/ViewPoem.aspx?id=178392",""],[5956,"أرى عاشقي لم يزل نائما","https://www.poetsgate.com/ViewPoem.aspx?id=192948",""],[5970,"يقولون في الصبر الجميل تعلة","https://www.poetsgate.com/ViewPoem.aspx?id=130657",""],[6046,"فصل لربك وانحر","https://www.poetsgate.com/ViewPoem.aspx?id=36742",""],[6068,"ل بُونَةَ فِي قَلْبِي غَرَامٌ مُطَابِق -26-","https://www.poetsgate.com/ViewPoem.aspx?id=175807",""],[6070,"الأمانة","https://www.poetsgate.com/ViewPoem.aspx?id=187728",""]],"verses":[["وَلَكِن فَقَدنا كُلَّ شَيءٍ بِفَقدِهِ","وَهَيهاتَ أَن يَأتي بِهِ الدَهرُ ثانِيا",0,"ي",2,0],["وَلَكِن فِطامُ النَفسِ أَثقَلُ مَحمَل","مِنَ الصَخرَةِ الصَمّاءِ حينَ تَرومُها",1,"ه",2,0],["ولكنْ في دفاع اللَّه كافٍ","وإن شُبَّتْ لنائرةٍ حروبُ",2,"ب",1,0],["وَلكِن فَتىً لَم تُخشَ مِنهُ فَجيعَةٌ","حَديثاً وَلا فيما مَضى أَنتَ وامِقُ",3,"ق",1,0],["وَلَكِنَّ فيها جَمالاً بَديعاً","وَفيها حَنينٌ إِلى الأَبدَعِ",4,"ع",1,0],["وَلَكِن فيكِ إِخوانٌ هَوَينا","لِأَجلِهِمِ جَميعَ الساكِنينا",5,"ن",2,0],["وَلَكِن فَتىً قَد نالَ فَضلَ بَلاغَةٍ","تَلَعَّبَ فيها بِالكَلامِ تَلَعُّبا",6,"ب",2,0],["وَلَكِن فُجِعنا وَالرَزيئَةُ مِثلُهُ","بِأَبيَضَ مَيمونِ النَقيبَةِ وَالأَمرُ",7,"ر",1,0],["وَلَكِن فَدَت نَفسي تَميماً مِنَ الَّتي","يُخافُ الرَدى فيها وَيُرهَبُ ذامُها",8,"م",3,0],["وَلَكِن فاتَ صاحِبُ بَطنِ رَهوٍ","وَصاحِبُهُ فَأَنتَ بِهِ زَعيمُ",9,"م",1,0],["وَلَكِن فِطامُ النَفسِ أَثقَلُ مَحمَلاً","مِنَ الصَخرَةِ الصَمّاءِ حينَ تَرومُها",10,"ه",2,0],["ولَكِنّ فِي نَفْسِ الصَّغِيرِ المَسَاويَا","يُمَاثْلنَ بِالحُسْنِ الخِصالِ الزَّوَاهِيا",11,"ي",2,0],["ولكن في عزمي فلولا كثيرة","تغادرني في العيش طوع الجواذب",12,"ب",1,0],["ولكن في الأَقلام سراً فان تَطع","تبدل قوماً من مخافتهم أَمنا",13,"ن",2,0],["ولكن في الأسباب أخفى اقتداره","فلا حظها من غاب عنه المسبب",14,"ب",1,0],["وَلَكنّ فضلَ الدينِ يبدو إذا أتت","عليهِ عُقول الناس تسترهُ سترا",15,"ر",2,0],["وَلكِنَّ فرقاً بَينَنا وَهوَ أَنَّني","أُعَبِّرُ عَنها بَينَما أَنتِ ساكِتَه",16,"ت",2,0],["وَلَكِنْ فِي كَلاَمِكَ بَعْضُ حَشْوٍ","وَكَسْرٍ تَسْتَضِرُّ بِهِ الرُّوَاةُ",17,"ه",1,0],["ولكن فرند السيف خير محكم","به الحق يعلو والحقيقة تخطب",18,"ب",1,0],["وَلَكِنَّ فَرطَ الوِدِّ نَحوَكَ قائِدي","وَلَستُ اِمرَأً عَن وُدِّهِ يَتَغَيَّرُ",19,"ر",1,0],["ولكن فَتى الفتيان من راحَ مُعرضاً","عَن الدهر لا يَخشى قَريباً وَنائيا",20,"ي",2,0],["ولكن في ودادكَ جاءَ عفواً","كما تقضي الصَّداقةُ والحقوق",21,"ق",1,0],["ولكن فضل المصطفى في فروعه","وذلك من تفضيل آيات قرآن",22,"ن",1,0],["ولكنْ فَتىً يَحْمِي ذِمارَ أَبِيكُمُ","فأَدْرَكَه مِن رَهْبَةِ العَارِ مَحْفِلُ",23,"ل",1,0],["وَلكِن في مُوافَقَة اِسمك سَمى","لما أَمّلته سِرّ لَطيف",24,"ف",1,0],["ولكنْ فتَى الفتيانِ بَدرُ بنُ مُقْبِلٍ","له النُّورُ مِلْءَ الأرضِ أصبحَ أو أَمسى",25,"س",2,0],["وَلكِن فيهِ السُمّ إِن رَيعُ أَهلُهُ","وَإِن يَأتِهِ قَومٌ هُناكَ يُراعُ",26,"ع",1,0],["ولكِنَّ فَخري بالأصَغَرَيْنِ","بقَلبي والمُنتضى مِن لِساني",27,"ن",2,0],["ولكن في جوار بني","فرنسا اللطف والكرم",28,"م",1,0],["ولكنَّ فذَّاً منهمُ صحَّ وحدَهُ","عليَّ وسبري في الرجال معمِّقُ",29,"ق",1,0],["ولكن فتَّهم فنجوتَ منهم","نَجاءَ اللحن بالخصمِ الألدِّ",30,"د",1,0],["ولكن فؤادٌ لكم رقُّهُ","فما يستبيع ولا يَهرُبُ",31,"ب",1,0],["ولكنْ فتّشي عنّي بقبرٍ","عليهِ ليس إلّا \" قبرُ عابرْ\"",32,"ر",1,0],["ولكنَّ في النَّفس لي حاجَةٌ","غليلُ فُؤادي بها ما اشتَفى",33,"ف",2,0],["ولكن في مراتبها سواء","معابد للمهيمن طائفيه",34,"ي",2,0],["وَلَكِن فَتىً عِندَ الرَزايا صَبورُها","وَفي وَسَطِ أَجوالِ المَنايا ضُبورُها",35,"ر",3,0],["ولكن فنائي فيه حكم منونه","تفانيت عني في فناء فنونه",36,"ه",1,0],["ولكن فيك القدوة اليوم للورى","يروك إذا ما أدهم الخطب مفزعا",37,"ع",2,0],["ولَكِن في الشَبابِ خُزَعبَلاتٌ","لِمَن يَهوى العَذارى وَالعِذارا",38,"ر",2,0],["وَلَكنْ فَتَى الفِتْيانِ مَنْ رَاحَ واغْتَدَى","لضَرِّ عَدُوٍّ أَوْ لِنَفْعِ صَدِيقِ",39,"ق",1,0],["ولكن في الفحوى دليلاً على الذي","يسر ذوو النجوى من الجد والمزج",40,"ج",1,0],["ولكن فماتيح الأمور أوائل","ترام بها الغايات وهي ثواني",41,"ن",2,0],["وَلَكِنَّ فِي الجَعْفِي مِنْهُ مَحَبةً","تُخلِصٌُ مِنْ ضِيقٍ وَمَسّ هَوَانِ",42,"ن",1,0],["وَلَكِنْ فَالمَقَامُ أجَلُّ من أنْ","أضِيقَ بِهِ إلى إذْنٍ جَدِيدِ",43,"د",1,0],["ولكنَّ فردنندَ كان انضمامها","الى جانب الجرمان أمضى وأبرما",44,"م",2,0],["ولكن في الوجودِ وكلّ شيء","يكونُ كماله نقصُ الكمالِ",45,"ل",1,0],["ولكن في صلاتك ليس إلا","فحاذر ما يخونك في المثال",46,"ل",1,0],["ولكن في علومك فهو يهدى","كما تهدى إلى هجر التمور",47,"ر",1,0],["ولكن فتى الفتيان من راح أو غدا","لضر عدو أو لنفع صديق",48,"ق",1,0],["وَلَكن فيهِ الفكر أَكبَر مِن سَنا","وَفي الحُكم أَمضى مِن مَضاء يَماني",49,"ن",2,0],["ولكن فيض الفضل عن نفحة الرضا","جدير باعطاء المنى العبد والحرا",50,"ر",2,0],["ولكن في ظني وعندي بأنها","تحوط وتحمى بالقنا عن ذمارها",51,"ر",3,0],["ولكن فتى هاجته آلام قومه","فرددها نظما وارسلها نثرا",52,"ر",2,0],["ولكن في الفؤاد خيال فكرٍ","يطالعني أكذّب فيه حدسي",53,"س",2,0],["ولكن فؤادي خافقٌ جازعٌ وقد","أرقت لبرق من حمى الجزع خافق",54,"ق",1,0],["ولكن في بلاد الغرب قوم","رأوا جحد المحال هدى ودينا",55,"ن",2,0],["ولكن في الصخر ناراً وفيه","بوادر شرٍّ وهمٍّ مقيم",56,"م",1,0],["وَلَكِنّ فينا كلّ نَفس رَحيمة","تطير بها يَومَ الفخار المعازِقُ",57,"ق",1,0],["ولكنْ في القيادِ إلى الأعادي","بريقِ طَلاوةِ الخيلِ الحِسانِ",58,"ن",1,0],["ولكن فَضَّلَ الرحمنُ هذا","على ذا بالمَنَابر والسَّريرِ",59,"ر",1,0],["ولكن في الأسر راموا قتله","وأبت حكمةٌ رب العرش الا",60,"ل",2,0],["وَلكِنَّ في صَخرٍ عُيوباً كَثيرَةً","إِذا ذُكِرَت نَقَّبنَ مِن حَيثُ لا يَدري",61,"ر",2,0],["ولكنَّ في العقلِ الالهيّ جوهراً","تبرَّأَ من نقصٍ قيومٌ سَما رَفعا",62,"ع",2,0],["ولكن في همول الدمع سلوى","لنفسي حين سلواها حرامُ",63,"م",1,0],["ولكن فيه شوب قلى فإن ا","تحاد الطبع أشبه بالعهود",64,"د",1,0],["ولكن فشى فيها الزنى وبدى الخنا","فلم تنكر الفحشاء ولم يقم الحد",65,"د",1,0],["ولكن فرط البرد ألبسني الضنى","فعدت أنادي ليت لي كبدا حزّى",66,"ز",2,0],["ولكن فاض سيل البأس منها","ففيها من مجاريه انسياح",67,"ح",1,0],["وَلَكِنَّ فوسيذَ مَن قَبَضا","عَلى الأَرضِ مِن فَورِهِ اِعتَرَضا",68,"ض",2,0],["وَلَكِنَّ فيهِ بَقِيَّةَ حَزمِ","بِها يَدفَعُ الحَتفَ عَنهُ يُصمي",68,"ي",1,0],["وَلَكِنَّ فيسَندَراً طَرِبا","لِما خالَ مِن نَيلِهِ الأَرَبا",68,"ب",2,0],["وَلَكِنَّ فِريَامَ حَظراً حَظَر","على قَومهِ أَن يَهِيلوا العِبَر",69,"ر",1,0],["ولَكنَّ فالاسَ مَدَّت يَدا","وَعَنهُ أَطاشَتهُ فابتَعدَا",70,"د",2,0],["ولكن في مجاري الصو","ت والأنفاس ما صدرا",71,"ر",2,0],["ولكن فنيلا فرى الجيد والرأ","س علق يهوي بجلدته",72,"ه",1,0],["ولكن فطرق عامله","أطار وما إن أطار سدى",72,"د",2,0],["ولكن فطرقل بين الأخاء","عدا يستحثهم للقاء",72,"ا",2,0],["ولكن فطرقل سيء فقال","يؤنب مريون بالعجل",72,"ل",1,0],["ولكن فطرقل ما ارتاع بل","ترجل محتفزاً للقا",72,"ق",2,0],["ولكن فطرقل هد قواه","سنان القناة وروع الإلاه",72,"ه",1,0],["ولكن فيبوس في الحال حال","فحجبه بغيومٍ ثقال",73,"ل",1,0],["وَلَكن في السَعادةِ نالَ حَظاً","سَعيداً فيهِ غاية مُبتغاهُ",74,"ا",2,0],["وَلكن فَتى قَد جرد السيف طالِباً","به من حقوق المجد أَسنى المَطالب",75,"ب",1,0],["ولكنَّ في كوريا منكُم","دمارا إلى ربه يجْأَر",76,"ر",1,0],["ولكن في الظلام سطا عليه","خبيث الأصل وانتهز الكمونا",77,"ن",2,0],["ولكن فلا تغتر جهلا بما ترى","وللعهد من اسماء لا تأمن النقضا",78,"ض",2,0],["ولكنْ فاعذُروا حِبّاً أتاكمْ","بقولٍ نالَ بالحذْقِ ارتشافه",79,"ف",2,0],["ولكنْ فجأة أضحى","يرى الهجران والعتبا",80,"ب",2,0],["ولكن في مصر ملكا اعاد الطلول","صروحاً فطابت مقيلا",81,"ل",2,0],["ولكن في حقوق الله صعب","حريص ما لديه من سموح",82,"ح",1,0],["ولكن في اللفظ اشتراكا كما اتى","سميوه لم يهدوا الانام لما يهدى",83,"د",2,0],["وَلَكِنَّ في تَعيينِها بِمُخَصَّصٍ","تَنَزَّلَ عَن حُكمٍ بِأَن هُوَ شائِعُ",84,"ع",1,0],["ولكن فأس أقداري","أبى ليهدَّ مأنوسا",85,"س",2,0],["ولكن فقدكِ أدمى عيوني","ولون عمري بلون الحداد",86,"د",1,0],["ولكن في هذا المقام عجائبا","لاغوار أسرار غرائب أفنان",87,"ن",1,0],["ولكن في النفس معنى الرجو","لة يحتمل المر من محضه",88,"ض",2,0],["ولكن في نفوس روضوها","على العلياء والشرف اللباب",89,"ب",1,0],["ولكن فاعلمي يا أم عيني","ويا أخت الشقيقات الملاح",90,"ح",1,0],[".ولكن، فيا عالياتِ المطالبِ","كمْ فيكِ يأسٌ وألفُ ابتلاء",91,"ا",2,0],["وَلَكِنْ فِيهِ للجُهَّالِ شُحٌ","وَإنْ تَرَكَ الخَبِيرَ بِهِ غَنِيَّا",92,"ي",2,0],["ولكن فيك مأسورٌ","دهاهُ الجوعُ والشظفُ",93,"ف",1,0],["ولكن فيك تزدهرُ الأماني","وذكرى ما تزالُ تقضُّ بالي",94,"ل",2,0],["ولكن فشئنا على قدر طغى بكم","وأمراً أتى منكم فأضحى مهدما",95,"م",2,0],["ولكن في الورى سنناً","سيعلمها ذوو الرشدِ",96,"د",1,0],["ولكن في فراق الموت فاجعةٌ","على الأحباب أقسى منه أحيانا",97,"ن",2,0],["ولكن في وسط صدري رواسي","رواسي من حزن قلب ٍ رحومي",98,"م",2,0],["ولكنَّ في بعضِ القبورِ رزيئةٌ","وفي بعضهنَّ العمرَ تلقى تطببا",99,"ب",2,0],["ولكنْ في النفوسِ اذا استجابَتْ","لبارئِها وفي سعةِ الصدورِ",100,"ر",1,0],["ولكن في سريرته سخاء","وطيب من مروءته يُعطر",101,"ر",1,0],["ولكنْ فُجِئتُ بأنه ناسٍ","فهل كان بي لاعباً كالما؟",102,"م",2,0],["ولكن فتي لا يعرف اليأس قلبه","ولا يطيبه المدح والحمد والذكر",103,"ر",1,0],["ولكنْ... في قلوبِ النَّاسِ خيرٌ","وفيهمْ روحُ إبراهيمَ تَزْخَرْ",104,"ر",1,0],["ولكنَّ في نفسي كما في عيونها","مراعي غرام بيننا ومواثق",105,"ق",1,0],["ولكنْ في خفاهُ ... أَيا حفيظاً","يحاربُ كُلَّ ألوانِ الرزانةْ",106,"ن",2,0]]}