المديد"],[50,"قد لامني في خليلتي عمر","https://www.aldiwan.net/poem63825.html","المنسرح"],[50,"يا حب إن دواء الحب مفقود","https://www.aldiwan.net/poem63939.html","البسيط"],[50,"قد لعب الدهر على هامتي","https://www.aldiwan.net/poem64882.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85437","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85330","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85428","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85412","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30499","السريع"],[72,"","https://poetry.dctabudhabi.ae/diwan/poem/40625","المنسرح"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42579","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42514","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42644","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42507","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54835","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9497","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[106,"نعي الشتاء !!","https://www.poetsgate.com/ViewPoem.aspx?id=179458",""],[106,"فجيعة في ساعة","https://www.poetsgate.com/ViewPoem.aspx?id=179526",""],[106,"الوحدة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=179293",""],[78,"فيما مضى كنت بالأعياد مسرورا","https://www.poetsgate.com/ViewPoem.aspx?id=1465",""],[90,"شدة لندن!..","https://www.poetsgate.com/ViewPoem.aspx?id=179068",""],[45,"إنّ سَيْرَ الخَليطِ، حينَ اسْتَقَلاّ","https://www.poetsgate.com/ViewPoem.aspx?id=32060",""],[45,"يا عليٌّ، بلْ يا أبَا الحَسَنِ المَا","https://www.poetsgate.com/ViewPoem.aspx?id=32883",""],[45,"إنّما الغَيّ أنْ يكونَ رَشيدَا","https://www.poetsgate.com/ViewPoem.aspx?id=31696",""]],"verses":[["قَد لَبِستُ الخُطوبَ سوداً وَبيضاً","وَقَطَعتُ الزَمانَ طولاً وَعَرضا",0,"ض",2,0],["قَد لَبِسَت جِيادُها","بَراقِعاً مِنَ الغُرَر",1,"ر",1,0],["قد لاث صبحاً فوق بدر بعدما","لبس المكارمَ وارتدى بوقارِ",2,"ر",1,0],["قد لبِس الوشي على قبحه","وخضّب الشيب وقصّ الشعر",3,"ر",1,0],["قد لَوَّحت نار الطَوى وجهها","وأعمل الفقر به ميسمه",4,"م",2,0],["قَد لَهِفوا حينَ أَخزى اللَهُ شيعَتَهُم","آلُ المُهَلَّبِ مِن ذُلٍّ وَقَد لَهِفوا",5,"ف",3,0],["قد لوَّع الحبّ قلبي في تلهبهِ","وصرَّحَ الدَّمعُ في ليلي بإشقائي",6,"ا",2,0],["قد لعمري كبتَّ نَفْ","سَكَ يا دهْرُ فاكبِتِ",7,"ت",1,0],["قد لمعت من برص واضح","مؤزَّرٍ في الوجه لمّاعه",8,"ع",2,0],["قدْ لَعَمْريِ اقتصصتَ من كُلّ ضِرْسٍ","كان يجني عليك في رُغفانِكْ",9,"ك",1,1],["قد لعمري أتَيْتُ جرماً عظيماً","باعتذاري وقد أسأت المقالا",10,"ل",2,0],["قد لعمري أنْهلتَني لو أتمتْ","نعمةَ العلّ نعمةُ الإنهالِ",11,"ل",1,0],["قد لعمري طمستَ مِنِّيَ وجْهاً","كنتَ فيما مضى تُقيمُ رُسومه",12,"م",2,0],["قد لَعَمْرِي ركبتَ أمراً مهيناً","ساءنا فيك أيها الخُلْصانُ",13,"ن",1,0],["قد لعمري أَنَى لمثلِك أن ينْ","عَمَ تحت الظلال والأكنان",14,"ن",1,0],["قَد لازَماني مُذ خُلِق","تُ كَمَن يُطالِبُني بِدَينِ",15,"ن",1,0],["قَد لَدَعَت صَدغاك قَلبي فَهَل","تَنعَمُ لِلَّذعِ بِدرياقِ",16,"ق",1,0],["قد لاح وجه الحق في توحيده","عند انغماس الشرك في بطلانه",17,"ن",2,0],["قد لمت دهري على ما جاء من رهق","وقلت لم ينج من عدواك موجود",18,"د",1,0],["قَد لَفَّها لَفَّ الضِما","دِ مُحَنِّطٌ آسٍ رَزين",19,"ن",1,0],["قَد لَعَمري أَقصَرتُ عَنكَ وَلِلوَف","دِ اِزدِحامٌ وَلِلعَطايا اِزدِحامُ",20,"م",1,0],["قَد لَعَمري تَوَرَّدوا خُطَّةَ الغَد","رِ وَجاؤوا بِالسَوأَةِ السَوآءِ",21,"ا",2,0],["قَد لَعَمري سُدناهُ كَهلاً وَشَيخاً","وَشَبيباً وَناشِئاً وَوَليدا",22,"د",2,0],["قَد لَوَّحَت مِنهُ السُهوبُ وَأَثَّرَت","في يُمنَتَيهِ وَعَنسِهِ وَقُتودِهِ",23,"د",2,0],["قَد لَعَمري آذَيتَنا","يا اِبنَ عَمرِو بنِ مَسعَدَة",24,"د",2,1],["قَد لَعَمري أَعطَتكَ سارِيَةُ الذُلِّ","وَكانَت عَزيزَةَ الإِمتِناعِ",25,"ع",1,0],["قَد لَعَمري وَقَعا لَو عَلِما","مِن هِجائي في خَرا ما مَضَغا",26,"ا",1,0],["قَد لَعَمري أَضحى الزَمانُ حَميداً","بِاِبنِ طَوقٍ مُحَمَّدِ المَأمولِ",27,"ل",1,0],["قَد لَعَمري دافَعتَ عَن نِعَمِ القَو","مِ أَوانَ اِنكَفَت وَكادَت تَزولُ",28,"ل",1,0],["قَد لَعَمري أَعدَت شَمائِلُكَ الدَه","رَ فَأَضحى مِن بَعدِ لُؤمٍ كَريما",29,"م",2,0],["قَد لَبِسنا ثِيابَهُ وَتَسايَر","نا بِتَقريظِهِ عَلى حُملانِه",30,"ن",2,0],["قَد لَعَمري يا اِبنَ المُغيرَةِ أَصبَح","تَ مُغيراً عَلى القَوافي جَميعا",31,"ع",2,1],["قدْ لعمري جَرَيْتَ في حَلْبَةِ المَجْ","دِ فَحُزْتَ السَّباقَ عندَ السِّباقِ",32,"ق",1,0],["قد لَعَمري زُفَّتْ إليك من المَد","حِ عَذارى على عُلاك بَوَاقي",32,"ق",2,0],["قد لَعَمري رفعتُهُ بهجائي","وارتفاعُ المصلوبِ ليسَ بِعزِّ",33,"ز",1,0],["قَد لَعَمري حَكيتَ لي غُصَصَ المَو","تِ وَحَرَّكَتني لَها وَسَكَنتا",34,"ت",2,0],["قَد لَعَمري مَلَّ الطَبيبُ وَمَلَّ ال","أَهلُ مِنّي مِمّا أُقاسي وَأَلقى",35,"ق",2,0],["قَد لَبِسنا غلائلَ الظِلّ فيها","مُعْلَماتٍ منَ الشعاعِ بِعَسجَد",36,"د",1,0],["قَد لانَ أَكثَرُ ما تُريدُ وَبَعضُهُ","خَشِنٌ وَإِنّي بِالنَجاحِ لَواثِقُ",37,"ق",1,0],["قَدْ لَفَّقُوهَا أَسَاطِيراً مُحَبَّرَةً","بِحِكْمَةٍ ذَاتِ أَشْكَالٍ وَأَلْوَانِ",38,"ن",1,0],["قَدْ لَعَمْرِي بَلَوْتُ دَهْرِي فَمَا أَحْ","مَدْتُ مِنْهُ مَا تَحْمَدُ الأَقْوَامُ",39,"م",1,0],["قَد لُمتُ قَلبي وَأَعياني بِواحِدَةٍ","فَقالَ لي لا تَلُمني وَاِدفَعِ القَدَرا",40,"ر",2,0],["قَد لَفَّني فيها الظَلامُ وَطافَ بي","ذِئبٌ يُلِمُّ مَعَ الدُجى زُوّارُ",41,"ر",1,0],["قَد لاحَ شَيبُ القَذالِ فَاِشتَعَلا","مِنكَ وَبانَ الشَبابُ فَاِحتَمَلا",42,"ل",2,0],["قَد لُحِّفَت بِالسَنَجِ الخَفِيِّ","كَأَنَّها دينارُ صَيرَفِيِّ",43,"ي",1,0],["قد لَبِسْنَاهُ وهو من نَفَحاتِ ال","مسكِ رَدْعُ الجُيوب ردْعُ التراقي",44,"ق",2,0],["قد لَبِسْنَ العَجاجَ مُعتكِرَ اللّو","نِ ولُكْنَ الحديدَ مُرَّ المَذاقِ",44,"ق",1,0],["قَد لَوَّحَ التَقديحُ وارِياتِها","وَأَشفَقَ القانِصُ مِن خِقاتِها",45,"ت",3,0],["قَد لَفَّفَ الكُمَّ مِنهُ","كَنازِعٍ لِلقَتادِ",46,"د",1,0],["قَد لَحَفَتكَ الغُصونُ أَردِيَةً","فَيَومُكَ الغَضُّ بِالنَعيمِ نَدي",47,"د",2,0],["قَد لَبِستَ الدَهرَ لِبسَ فَتىً","أَخَذَ الآدابَ عَن عِبَرِه",48,"ر",2,0],["قَد لامَني في خَلي