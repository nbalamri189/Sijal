7,"حكم المنية في البرية جاري","https://www.aldiwan.net/poem50178.html","الكامل"],[430,"أرج الصبابة من ثنائك عارف","https://www.aldiwan.net/poem40081.html","الكامل"],[430,"هاجت رياح بالشمال تجول","https://www.aldiwan.net/poem41032.html","الكامل"],[430,"ماست بلدن والأثيث تميم","https://www.aldiwan.net/poem41395.html","الكامل"],[438,"خف القطين وبان الرائح الغادي","https://www.aldiwan.net/poem2619.html","البسيط"],[449,"لم توف أشواقي ولا لوعاتي","https://www.aldiwan.net/poem53723.html","الكامل"],[453,"قد لوى جيده حياء وحيا","https://www.aldiwan.net/poem13812.html","الخفيف"],[459,"حرم عليها نزهات الوادي","https://www.aldiwan.net/poem56222.html","البسيط"],[462,"أي الخطوب من الزمان أزل","https://www.aldiwan.net/poem15110.html","الكامل"],[469,"ما سمع الناس ولا حدثوا","https://www.aldiwan.net/poem59744.html","السريع"],[469,"قد لاح في فودك المشيب","https://www.aldiwan.net/poem60373.html","مخلع البسيط"],[469,"وروضة كالحلة الخضراء","https://www.aldiwan.net/poem60497.html","الرجز"],[471,"قد لعمري بت ليلي","https://www.aldiwan.net/poem4761.html","مجزوء الرمل"],[530,"يا رب لاطف ولدي","https://www.aldiwan.net/poem37150.html","مجزوء الرجز"],[539,"يا جلال العصر علما","https://www.aldiwan.net/poem47938.html","عموديه"],[552,"قال لجاف كلما سيم","https://www.aldiwan.net/poem47177.html","مجزوء الرمل"],[552,"ما أرادت إلا الجفاء ظلوم","https://www.aldiwan.net/poem47245.html","الخفيف"],[552,"من شاء ان يعذلني في الهوى","https://www.aldiwan.net/poem47279.html","السريع"],[568,"قد لاح تحت الصبح ليل مظلم","https://www.aldiwan.net/poem69521.html","الرجز"],[568,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"]],"verses":[["قَد لَبِستُ الخُطوبَ سوداً وَبيضاً","وَقَطَعتُ الزَمانَ طولاً وَعَرضا",0,"ض",2,0],["قَد لَبِسَت جِيادُها","بَراقِعاً مِنَ الغُرَر",1,"ر",1,0],["قد لاث صبحاً فوق بدر بعدما","لبس المكارمَ وارتدى بوقارِ",2,"ر",1,0],["قد لبِس الوشي على قبحه","وخضّب الشيب وقصّ الشعر",3,"ر",1,0],["قد لَوَّحت نار الطَوى وجهها","وأعمل الفقر به ميسمه",4,"م",2,0],["قَد لَهِفوا حينَ أَخزى اللَهُ شيعَتَهُم","آلُ المُهَلَّبِ مِن ذُلٍّ وَقَد لَهِفوا",5,"ف",3,0],["قد لوَّع الحبّ قلبي في تلهبهِ","وصرَّحَ الدَّمعُ في ليلي بإشقائي",6,"ا",2,0],["قد لعمري كبتَّ نَفْ","سَكَ يا دهْرُ فاكبِتِ",7,"ت",1,0],["قد لمعت من برص واضح","مؤزَّرٍ في الوجه لمّاعه",8,"ع",2,0],["قدْ لَعَمْريِ اقتصصتَ من كُلّ ضِرْسٍ","كان يجني عليك في رُغفانِكْ",9,"ك",1,1],["قد لعمري أتَيْتُ جرماً عظيماً","باعتذاري وقد أسأت المقالا",10,"ل",2,0],["قد لعمري أنْهلتَني لو أتمتْ","نعمةَ العلّ نعمةُ الإنهالِ",11,"ل",1,0],["قد لعمري طمستَ مِنِّيَ وجْهاً","كنتَ فيما مضى تُقيمُ رُسومه",12,"م",2,0],["قد لَعَمْرِي ركبتَ أمراً مهيناً","ساءنا فيك أيها الخُلْصانُ",13,"ن",1,0],["قد لعمري أَنَى لمثلِك أن ينْ","عَمَ تحت الظلال والأكنان",14,"ن",1,0],["قَد لازَماني مُذ خُلِق","تُ كَمَن يُطالِبُني بِدَينِ",15,"ن",1,0],["قَد لَدَعَت صَدغاك قَلبي فَهَل","تَنعَمُ لِلَّذعِ بِدرياقِ",16,"ق",1,0],["قد لاح وجه الحق في توحيده","عند انغماس الشرك في بطلانه",17,"ن",2,0],["قد لمت دهري على ما جاء من رهق","وقلت لم ينج من عدواك موجود",18,"د",1,0],["قَد لَفَّها لَفَّ الضِما","دِ مُحَنِّطٌ آسٍ رَزين",19,"ن",1,0],["قَد لَعَمري أَقصَرتُ عَنكَ وَلِلوَف","دِ اِزدِحامٌ وَلِلعَطايا اِزدِحامُ",20,"م",1,0],["قَد لَعَمري تَوَرَّدوا خُطَّةَ الغَد","رِ وَجاؤوا بِالسَوأَةِ السَوآءِ",21,"ا",2,0],["قَد لَعَمري سُدناهُ كَهلاً وَشَيخاً","وَشَبيباً وَناشِئاً وَوَليدا",22,"د",2,0],["قَد لَوَّحَت مِنهُ السُهوبُ وَأَثَّرَت","في يُمنَتَيهِ وَعَنسِهِ وَقُتودِهِ",23,"د",2,0],["قَد لَعَمري آذَيتَنا","يا اِبنَ عَمرِو بنِ مَسعَدَة",24,"د",2,1],["قَد لَعَمري أَعطَتكَ سارِيَةُ الذُلِّ","وَكانَت عَزيزَةَ الإِمتِناعِ",25,"ع",1,0],["قَد لَعَمري وَقَعا لَو عَلِما","مِن هِجائي في خَرا ما مَضَغا",26,"ا",1,0],["قَد لَعَمري أَضحى الزَمانُ حَميداً","بِاِبنِ طَوقٍ مُحَمَّدِ المَأمولِ",27,"ل",1,0],["قَد لَعَمري دافَعتَ عَن نِعَمِ القَو","مِ أَوانَ اِنكَفَت وَكادَت تَزولُ",28,"ل",1,0],["قَد لَعَمري أَعدَت شَمائِلُكَ الدَه","رَ فَأَضحى مِن بَعدِ لُؤمٍ كَريما",29,"م",2,0],["قَد لَبِسنا ثِيابَهُ وَتَسايَر","نا بِتَقريظِهِ عَلى حُملانِه",30,"ن",2,0],["قَد لَعَمري يا اِبنَ المُغيرَةِ أَصبَح","تَ مُغيراً عَلى القَوافي جَميعا",31,"ع",2,1],["قدْ لعمري جَرَيْتَ في حَلْبَةِ المَجْ","دِ فَحُزْتَ السَّباقَ عندَ السِّباقِ",32,"ق",1,0],["قد لَعَمري زُفَّتْ إليك من المَد","حِ عَذارى على عُلاك بَوَاقي",32,"ق",2,0],["قد لَعَمري رفعتُهُ بهجائي","وارتفاعُ المصلوبِ ليسَ بِعزِّ",33,"ز",1,0],["قَد لَعَمري حَكيتَ لي غُصَصَ المَو","تِ وَحَرَّكَتني لَها وَسَكَنتا",34,"ت",2,0],["قَد لَعَمري مَلَّ الطَبيبُ وَمَلَّ ال","أَهلُ مِنّي مِمّا أُقاسي وَأَلقى",35,"ق",2,0],["قَد لَبِسنا غلائلَ الظِلّ فيها","مُعْلَماتٍ منَ الشعاعِ بِعَسجَد",36,"د",1,0],["قَد لانَ أَكثَرُ ما تُريدُ وَبَعضُهُ","خَشِنٌ وَإِنّي بِالنَجاحِ لَواثِقُ",37,"ق",1,0],["قَدْ لَفَّقُوهَا أَسَاطِيراً مُحَبَّرَةً","بِحِكْمَةٍ ذَاتِ أَشْكَالٍ وَأَلْوَانِ",38,"ن",1,0],["قَدْ لَعَمْرِي بَلَوْتُ دَهْرِي فَمَا أَحْ","مَدْتُ مِنْهُ مَا تَحْمَدُ الأَقْوَامُ",39,"م",1,0],["قَد لُمتُ قَلبي وَأَعياني بِواحِدَةٍ","فَقالَ لي لا تَلُمني وَاِدفَعِ القَدَرا",40,"ر",2,0],["قَد لَفَّني فيها الظَلامُ وَطافَ بي","ذِئبٌ يُلِمُّ مَعَ الدُجى زُوّارُ",41,"ر",1,0],["قَد لاحَ شَيبُ القَذالِ فَاِشتَعَلا","مِنكَ وَبانَ الشَبابُ فَاِحتَمَلا",42,"ل",2,0],["قَد لُحِّفَت بِالسَنَجِ الخَفِيِّ","كَأَنَّها دينارُ صَيرَفِيِّ",43,"ي",1,0],["قد لَبِسْنَاهُ وهو من نَفَحاتِ ال","مسكِ رَدْعُ الجُيوب ردْعُ التراقي",44,"ق",2,0],["قد لَبِسْنَ العَجاجَ مُعتكِرَ اللّو","نِ ولُكْنَ الحديدَ مُرَّ المَذاقِ",44,"ق",1,0],["قَد لَوَّحَ التَقديحُ وارِياتِها","وَأَشفَقَ القانِصُ مِن خِقاتِها",45,"ت",3,0],["قَد لَفَّفَ الكُمَّ مِنهُ","كَنازِعٍ لِلقَتادِ",46,"د",1,0],["قَد لَحَفَتكَ الغُصونُ أَردِيَةً","فَيَومُكَ الغَضُّ بِالنَعيمِ نَدي",47,"د",2,0],["قَد لَبِستَ الدَهرَ لِبسَ فَتىً","أَخَذَ الآدابَ عَن عِبَرِه",48,"ر",2,0],["قَد لامَني في خَليلَتي عُمَرُ","وَاللَومُ في غَيرِ كُنهِهِ قَدَرُ",49,"ر",1,1],["قَد لامَني فيكِ أَقوامٌ فَقُلتُ لَهُم","ما ذَنبُ مَن قَلبُهُ حَرّانُ مَجهودُ",50,"د",1,0],["قَد لَعِبَ الدَهرُ عَلى هامَتي","وَذُقتُ مُرّاً بَعدَ حَلواءِ",51,"ا",2,1],["قد لبسنا ثوب الحداد عليه","أنا وَالعلم وَالحجى وَبلادي",52,"د",2,0],["قد لجأنا إلى الكرام بكاةً","وإذا بالكرام غير كرام",53,"م",1,0],["قَد لعمري أَمسَت عليك الليالي","وَعليَّ الحَياة عبئاً ثَقيلا",54,"ل",2,0],["قد لقينا منهم جفاء وَضيماً","أَنا وَالشعر وَالنجار الأصيل",55,"ل",1,0],["قد لَزِمَا جَنْبَيْكَ لم يَبْرَحَا","لَهْفِي على ضَيْعةِ جَنْبَينِ",56,"ن",1,0],["قد لقبوا الراح بالعجوز وما","تخرجُ ألقابهم عن العادَه",57,"ه",1,1],["قَدْ لانَ إِلَّا أَنَّهُ إِنْ قَسَا","يَوْمَ نِضَالٍ صَدَعَ الْجَلْمَدَا",58,"د",2,0],["قَدْ لامَنِي الْعَاذِلُ فيهِ ولَوْ","رَأَى الْهُدَى أَقْصَرَ عَنْ عَتْبِهِ",59,"ب",2,0],["قَدْ لا يَفُوهُ الْفَتَى بِالأَمْرِ يُضْمِرُهُ","وَبَيْنَ عَيْنَيهِ مَا تُخْفِي ضَمَائِرُهُ",60,"ر",2,0],["قَدْ لَعَمْرِي عَرَفْتُ دَهْرِي فَأَنْكَرْ","تُ أُمُوراً مَا كُنَّ لي في حِسابِ",61,"ب",1,0],["قَدْ لاَحَ مُسْتَقْبِلُهَا فَانْظُرُوا","أَشِعَّةَ الْمُسْتَقْبَلِ الْبَاهِرْ",62,"ر",1,0],["قد لمحناكَ في عيون الثعالي","ولمسناكَ في جلود الأراقم",63,"م",1,0],["قَد لَبِسنا صَباحاً","وَخَلَعنا ظَلاما",64,"م",2,0],["قَدْ لَوَّحوا بالرَّاحَتَيْن وزاحَمُوا","وتلفَّتوا بالنَّاظِرَيْن ومَارُوا",65,"ر",3,0],["قد لحتَ مثلَ البرق في","جوِّ العواصف والرُّعود",66,"د",1,0],["قد لطَّف المالُ كلَّ جو","فلا صقيعٌ، ولا أُوار",67,"ر",1,0],["قد لازمتْ معصمي سنينَ، إلى","أن أصبحتُ قطعةً من الجسد",68,"د",1,0],["قد لمستَ الشَّغافَ من كلِّ قلبي","وأثَرْت الشعورَ والوجدانا",69,"ن",2,0],["قد لوّثت بيد الأقذاء واتسخت","كأنها لم تطأ مسكاً وكافورا",70,"ر",2,0],["قد لففنا كل المساوي فينا","برداء من نهضة وطنيه",71,"ي",2,0],["قد لَبِستُ الهَوَى وإنْ كانَ ضُرّاً،","وَتَحَمّلْتُهُ، وإنْ كانَ ثِقْلا",72,"ل",2,0],["قد لَعَمرِي توَرّدوا خِطّةَ الغَدْ","رِ، وَجاؤوا بالسّوْءةِ السّوءاءِ",73,"ا",2,0],["قَد لَعَمرِي رُزْناهُ كَهلاً وَشَيخاً،","وَرَأيْنَاهُ نَاشِئاً وَوَلِيدَا",74,"د",2,0],["قد لاح بارق ذاك الثغر منك له","غدا يحاول منه العقل يخطفه",75,"ف",2,0],["قد لعمري أبصر النورَ الذي","مذ بدا أعشى عيونَ النوَبِ",76,"ب",1,0],["قد لعمري نكبت عن جدد الرش","د وأوغلت في شعاب الرياء",77,"ا",2,0],["قد لعمري لاخترت هذا نصيبي","من خلودٍ لو لم أخفْ عُقْباهَا",78,"ا",3,0],["قد لَعمرى إن يكتبت لكم هذا","بياناً لكم أخافُ المَلاَمَا",79,"م",2,0],["قد لعمري أمسَى الكفورُ مقرّاً","لكَ بالفضلِ مَادحاً قوّالا",80,"ل",2,0],["قد لَعمري حُلتم عن الوعد والعه","د وما حُلْتُ قط عن مِيعادي",81,"د",2,0],["قد لَعمرِي لولا أبو العرب السا","مِي لصرنا بعد الإمام رمادَا",82,"د",2,0],["قد لامني عُذَّلِي فيها فقلت لهم","يا عاذلون أقلوا اللوم والعذلا",83,"ل",2,0],["قد لاذ بالرضوان عريانْ","جاور مولاه بدر الأمانْ",84,"ن",1,1],["قد لامني والوَرد فرد وإذ","ثُنِّيَ بالريحانِ كفَّ الملام",85,"م",1,0],["قد لاح نجمك بين العِزّ والظَّفَر","وحاز وجهُك نورَ الشمس والقمِر",86,"ر",1,1],["قد لجج في بحر الهوى واقتحما","واختار على الصحة فيه السقما",87,"م",2,1],["قَد لَطَّفَتهُ يَدُ الهَوى فَكَأَنَّهُ","كَالماءِ يُؤلِمُهُ النَسيمُ بِمَرِّه",88,"ر",2,0],["قَدْ لَبِسْتُمْ مِنَ السِّيَادَةِ بُرْداً","طَرَّزَاهُ الْجَلاَلُ وَالتَّعْظِيمُ",89,"م",1,0],["قد لعمري فارت طبيعة حجري","منذ أحفى المقراض شارب عمر",90,"ر",1,1],["قد لثمنا الأعتاب لمّا وجدنا","في ثراها مسك القبول ختاما",91,"م",2,0],["قد لَقِينا شِدّةً مِنْ هَجْرِكُم","فَابْعَثوا الوَصْل إلَيْنا فَرَجا",92,"ج",2,0],["قَد لَوَّحتَهُم في القِفارِ هَواجِرٌ","مِنها الوُجوهُ البيضُ تَبدو سودا",93,"د",2,0],["قد لوَّحَ الهمُّ ضاحي وَجههِ فإِذا","رأَيته خلته بالهمِّ منتقبا",94,"ب",2,0],["قَد لَبِستُ الدَّهرَ مِن أَفنانِهِ","كُلَّ فَنٍّ حَسَنٍ مِنهُ حَبِرْ",95,"ر",1,0],["قد لام فيك معاشر أفأنتهي","باللوم عن حبِّ الحياة وأنت هي",96,"ه",2,0],["قد لذ ذكرُك منطقي","مذ عزَّ ذكرُك بالِيَه",97,"ي",2,0],["قَد لَجَّ في صَدودِهِ","فَدَمع عَيني لَجج",98,"ج",1,0],["قد لبس االصوف لترك الصفا","مشايخ العصر لشرب العصير",99,"ر",1,1],["قَد لاحَ في لَيلِ الشَبابِ كَواكِبٌ","إِن أَمهلت آلَت إِلى الإِسفارِ",100,"ر",1,0],["قد لقبوه حكمةً بل عارفاً","لما سمت حكمٌ له ومعارفُ",101,"ف",1,0],["قد لازم الناس البيوت مخافة","يوم وكل بالدعا مشغول",102,"ل",1,0],["قد لاح كابن ذكا لنا بذكائه","وبراعه ورد البيان سجيم",103,"م",1,0],["قد لوحت بي سهوبُ الأرض مرديةً","كأنما قصدت كدّي وإجهادي",104,"د",2,0],["قد لابس الدنيا بقلب عارف","متجنب بالعلم للشبهات",105,"ت",1,0],["قد لَوى جي