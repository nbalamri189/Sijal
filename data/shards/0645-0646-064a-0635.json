ae/diwan/poem/47516","البسيط"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79591","الكامل"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124451",""],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199634","المسحوب"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100495","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205028","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133940","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62948","الرجز"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86290","البسيط"],[3666,"","https://poetry.dctabudhabi.ae/diwan/poem/29382","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91961","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205589","السريع"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117848","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66217","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66138","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66122","البسيط"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136390",""],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113822","البسيط"],[4717,"ميمون","https://www.poetsgate.com/ViewPoem.aspx?id=204118",""],[4885,"هون عليك","https://www.poetsgate.com/ViewPoem.aspx?id=214947",""],[4902,"قال حاقد","https://www.poetsgate.com/ViewPoem.aspx?id=6529",""],[4119,"يا سعد ما أحسنها شمائلا","https://www.poetsgate.com/ViewPoem.aspx?id=16208",""],[5376,"مَنْ يصنعِ المعروفَ يجْزَ به","https://www.poetsgate.com/ViewPoem.aspx?id=189755",""],[5409,"لم ضيعت منك سحر الغدائر","https://www.poetsgate.com/ViewPoem.aspx?id=155279",""],[5628,"تراتيل في العشق","https://www.poetsgate.com/ViewPoem.aspx?id=179815",""],[5638,"رثاء وأمل في اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=198247",""],[5725,"ياعراق","https://www.poetsgate.com/ViewPoem.aspx?id=179277",""],[5894,"إن الفضيلة في الزمان تراد","https://www.poetsgate.com/ViewPoem.aspx?id=131439",""],[5309,"لا تذرفا دمعا على فقدانه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573555",""],[5080,"من يصطفي جسد الرّحيل مواظبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88142&r=&rc=12",""],[6247,"جمال القرآن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80287&r=&rc=26",""]],"verses":[["مَن يَصحَبِ الدَهر لَم يَعدَم تَقَلّبَهُ","وَالشَوكُ يَنبُتُ فيهِ الوَردُ والآسُ",0,"س",1,1],["من يصف الإِبل يصف ناقة","طارت بهم وارتفعت ألف ميل",1,"ل",1,0],["مَن يَصُنهُ يَصُن بَقِيَّةَ عِزٍّ","غَيَّضَ التُركُ صَفوَهُ وَالثَواءُ",2,"ا",2,0],["مَن يُصبِهِ سَكَنٌ مِمَّن يُحِبُّ وَمَن","يَهوى فَما لَكَ غَيرُ المَجدِ مِن سَكَنِ",3,"ن",1,0],["مَن يَصنَعِ المَعروفَ لِلَّهِ لا","يَمنَعهُ كُفرانُ مَن يَكفُرُه",4,"ر",2,0],["مَن يَصْطَلي حَرَّ نارٍ أنتَ موقِدُها","وهي الحَرُورُ على الشِّعبِ الحَرُوريّ",5,"ي",1,0],["مُنى صِلِّ حَربٍ نالَها بِالمَناصِلِ","فَواصِل وَقاطِع بِالرِقاقِ الفَواصِلِ",6,"ل",1,1],["من يصن عرضه وَما في يديه","من طماع العدى فذاكَ القَدير",7,"ر",1,0],["من يصطبر للصدمة الأولى يسدْ","لا يصلح الفَل ّ ولو كانوا الأسدْ",8,"د",1,0],["مَنْ يَصْطَدِ النمِرَ الْوَثُو","بَ يَعِفُّ عَنْ صَيْدِ الْفُهُودِ",9,"د",1,0],["من يُصْلِح الأُسْرةَ يصْلِحْ بها","ما دَمَّرَ الإِفسادُ في قُطْرِهِ",10,"ر",2,0],["من يصرع الخصم العنيد مدججاً","من بأسه بأسنة ٍ ونصال",11,"ل",1,0],["من يصحب الدهر يبصر من تقلّبه","اشياء أصغرها يأتي على العجب",12,"ب",1,1],["من يصحب البغي يصرعه مصاحبه","لصاحب البغي يوم شر منقلب",12,"ب",1,0],["من يصطنعها بالعلمِ والخلقِ الطا","هرِ يعلم إِحسانَ ما اصطنعا",13,"ع",2,0],["مَن يصيدُ الصَيدَ فيها","بِالظُبى حينَ اِنتَضاها",14,"ا",3,0],["من يصحب الأَحمق الثرثار غودر في","بحر من الجهل يغرقه ولو سبحا",15,"ح",2,0],["من يصفها يصف بدائع حسن ال","زهر في مجلس فريد النظام",16,"م",1,0],["مَن يُصادي سُخطي وَيَحلُمُ عَنّي","وَإِذا قُلتُ مَن لِأَمري كَفاني",17,"ن",2,0],["من يصحبِ الدهر ينكر لون لمَّتهُ","وهكذا تفعل الأيَّام باللّممِ",18,"م",1,0],["من يَصْحَبِ الدَّهر يعرِفْ حالتَيهِ ومن","يعاجلِ الأمرَ لا يخلو منَ النَدَمِ",19,"م",1,0],["مَن يَصدُقُ الوَعدَ وَالقِتالَ وَيَخ","شى اللَهَ في حِلمِهِ وَفي غَضَبِه",20,"ب",2,0],["مَن يَصطَبِر فَلَهُ الأجرُ الجَزيلُ كَما","لَهُ عَليهِ جنانُ الخلدِ قَد وجبت",21,"ت",1,0],["منى صلاة وتسليمٌ يقارنها","عليه ما اهتز نورٌ غبّ هطلاء",22,"ا",2,0],["من يصدق الحديث عند نقله","متعه اللهب فضل عقله",23,"ه",1,0],["من يصن ذل سائل ضان عرضا","كان يوماً رأيتها من بعيد",24,"د",1,0],["مَنْ يَصْحَبِ النَّاسَ مَطْوِيّاً على دَخَلٍ","لا يَصْحَبوهُ فَخَلَّوا كُلَّ تَدْخِيلِ",25,"ل",1,1],["من يصف ما قد دهاه يقل","لا تعجبوا قد يكسف البدر",26,"ر",1,0],["من يصنع الشاي في رسل من الشاءِ","قَد حادَ عَن مَهيَع المفتول والماء",27,"ا",2,1],["مني صلاةً مع سلامي على الدوب","على النبي خير الهدى والصلاحي",28,"ح",2,0],["من يصلي على المصلين من يد","فن تحت التراب تلك البدورا",29,"ر",2,0],["من يصح من نومه لم يلق غير أسى","وفاز بالسعد من في حلمه سكرا",30,"ر",2,0],["من يصلح الأعمال بعد فسادها","ويتوب فالرحمن غافر ذنبه",31,"ب",2,0],["من يصحبِ الدنيا يكن طامعاً","في الماءِ ان يقنصَ تمثالَهْ",32,"ل",2,0],["مَن يَصرِفُ العُمر في سَرد المَديحِ لَهُ","ما ذاكَ وَاللَهُ تَبذيرُ وَلا سَرف",33,"ف",1,0],["من يصل نارى بلا ذنبٍ ولا ترةٍ","يصل بنار كريم غير غدار",34,"ر",1,1],["من يصحب الناس لم يأمن غوائلهم","كخائض البحر لا ينجو من البللِ",35,"ل",1,1],["من يصرع الجبار دون الذي","يصرع جبار الشقاء المكينْ",36,"ن",1,0],["من يصلّي ولم يصلِّ عليكم","فهو مبدٍ لذي الجلال عناده",37,"د",2,0],["مَنْ يَصْطَبِرْ لِلْخُطُوبِ الدُّهْمِ تَقْرَعُهُ","يَمْجُدْ وَمَنْ هابَ اسْبابَ العُلا يَهُنِ",38,"ن",1,0],["مَنْ يَصْطَبِرْ في الحادِثاتِ عَلَى الأَذَى","يَقْطِفْ ثِمارَ الفَخْرِ اجْرَ عَنائهِ",39,"ا",3,0],["مَنْ يَصْطَبِرْ لخُطُوبِ الدَّهْرِ مُدَّرِعاً","بِلامةِ الحَزْمِ يَبْلُغْ هامةَ الظَّفَرِ",40,"ر",1,0],["من يصغَ لشعر يصوغه يتعجب","من لطف معانيه ان تأمل امعان",41,"ن",1,0],["من يصنع العرف يجزى من عواقبه","ثواب فضل مدى الأوقات لم يزل",42,"ل",1,0],["من يصرف الجوعَ المقيمَ بكسرةٍ","إن الفُتاتَ لمثل هذا مُشبعه",43,"ع",2,0],["من يصدق الود لا يعدم جوازيه","ليت القلوب على أشكالها تقع",44,"ع",1,0],["من يصدقبي وأنا الشمس اعملي","مايذريها عجاجٍ جاب ريح",45,"ح",1,0],["من يصدر السامع عن كلامه","مصادرا من النهى حوافلا",46,"ل",2,0],["مَنْ يصنعِ المعروفَ يجْزَ به","خيراً وملءُ النفسِ إيمانُ",47,"ن",1,1],["من يصد التيار عنك وإلا","فليكن ما يريد والله ساتر",48,"ر",1,0],["مَنْ يُصْغ ِ لِي يوما ً يَقُلْ","قَدْ أُنزِلَتْ للعِشْق ِ آيْ (2)",49,"ا",2,0],["مَنْ يَصْدُقِ الرَّحْمَنَ يَصْدُقْهُ وَذَا","خَبَرُ الدِّمَاءِ وَلِلدِّمَاءِ كَلامُ",50,"م",1,0],["من يصح ادري ترة حنّت غريب","خاف يبخل بالجفن نزّالها",51,"ل",3,0],["من يصنع المعروف يسمو قدره","وبجله أهل للتقى الأمجاد",52,"د",1,0],["مَن يَصطَبِغ بِدَمٍِ الضَّعيفِ رِداؤُهُ","لا يَأمَنِ الوَيلاتِ مِن هَيجَانِهِ",53,"ن",2,0],["من يصطفي جسدَ الرّحيلِ مواظبا","سيعودُ طيفاً بالليالي خائبا",54,"ب",2,1],["مَن يصحبُ الأنوارَ يحيا طيباً","من يقرَبُ الأزهارَ في عطرٍ يذوبْ",55,"ب",1,0]]}