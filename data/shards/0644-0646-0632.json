{"poems":[[53,"وجهك يا شنطفُ هَولُ المُطَّلعْ","https://www.poetsgate.com/ViewPoem.aspx?id=29538",""],[96,"إيه حكيم الدّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66311&r=&rc=29",""],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93634","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100288","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72910","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72586","الوافر"],[4927,"رسالة حب","https://www.poetsgate.com/ViewPoem.aspx?id=29840",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[6251,"أتيتك بالبشر لا بالعزاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76474&r=&rc=14",""],[6285,"هذه الشام لا تقولي كفانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86807&r=&rc=0",""]],"verses":[["لنُزعتْ عن برص وعن لمُع","والرأسُ فيه قَزعٌ من القرع",0,"ع",1,0],["لنزعت فتنتها وسحر جفونها","ومحوت نور جبينها الوضّاح",1,"ح",1,0],["لِنَزور العَباس في رَوضة الأُن","س وَنَقضي فَرض التَهاني جُلوسا",2,"س",2,0],["لنزلت من أفلاذ قلبي منزلا","فاستوسقت بنزولاك الأفلاذ",3,"ذ",1,0],["لنزهةِ الدنيا كتابي الذي","من شرفٍ فاز بأعلى سهام",4,"م",1,1],["لنزرعها بروضتنا فتزهو","كما بخضابها زهت البنان",5,"ن",1,0],["لِنَزْرَعَ فِيْ جِنَاْنِ الْحُبِّ حُباًّ","وَمِنْ صَفْوِ الْمَحَبَّةِ نَسْتَزِيْدُ",6,"د",1,0],["لنزود الأجفان منها نظرة","تبقى بها آثارهم تخييلا",7,"ل",2,0],["لِنَزْرَعَ فَوْقَ القُبُورِ الأقَاحَا","ويَرْتَاحَ مَنْ فِي القُبِورِ إسْتِرَاحَا",8,"ا",1,0],["لنزيح الكابوس عن مقلتينا","ونغني أمجادنا ألحانا",9,"ن",2,0]]}