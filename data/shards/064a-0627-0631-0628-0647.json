[6202,"دنيا عجائب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86721&r=&rc=22",""],[6225,"خاطرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81120&r=&rc=314",""],[6228,"ابتهال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85970&r=&rc=7",""],[6300,"الأعْيُنُ النُجُل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81627&r=&rc=4",""],[5190,"الحسناء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78290&r=&rc=4",""],[5190,"لا تسألي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85040&r=&rc=115",""],[5190,"عدتَ يا يوم مولدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85047&r=&rc=122",""],[5190,"ما كنت محض قصيدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78368&r=&rc=76",""],[6355,"موسم البشرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66687&r=&rc=147",""]],"verses":[["يا رَبَّةَ البُرْقُعِ كَمْ غُلَّةٍ","حَامَتْ عَلى ما ضَمَّهُ البُرْقُعُ",0,"ع",1,1],["يا رَبّةَ البيْتِ المُمَنَّعِ جارُهُ","ورَبيّةَ الشّرَفِ العَليِّ مَنارُهُ",1,"ر",2,1],["يَا رَبَّةَ المِنَنِ الَّتِي شَادَتْ بِهَا","لِلدِّينِ وَالدُّنْيَا ضُرُوبَ مَبَانِي",2,"ن",2,0],["يَا رَبَّةَ الحُسْنِ تَرْعَاهُ طَهَارَتُهَا","فَلاَ تُطِيلُ مَدَى اسْتِجْلاَئِهِ المُقلُ",3,"ل",1,1],["يا ربة الحسن هلاّ تعطفين على","من بات سهران مشغولاً بذكراك",4,"ك",1,0],["يا ربّ هبه عمر نوحٍ فقد","جاء من الجود بطوفان",5,"ن",1,0],["يا ربة المنزل هل عندكم","من مطعم للزب أو مطمع",6,"ع",1,0],["يا ربَّةَ الشِّعرِ والأَحلام غنِّيني","فقد سَئِمْتُ وُجومَ الكونِ مِنْ حينِ",7,"ن",1,1],["يا رَبَّةَ الشِّعْرِ غنِّيني فقد ضَجِرَتْ","نفسي منَ النَّاسِ أبناءِ الشَّياطينِ",7,"ن",1,0],["يا ربَّةَ الشِّعرِ إنِّي بائسٌ تَعِسٌ","عَدِمْتُ مَا أَرتجي في العالمِ الدُّونِ",7,"ن",1,0],["يا رَبةَ اللحظِ الَّذي","شَدَّ وثاقاً إِذ فَتَرْ",8,"ر",1,0],["يا ربة التاجين عن آبائها","عن ماجدٍ عال عن ابنٍ أمجدا",9,"د",2,0],["يا رب هل تلك القيامة كلها","أم للقيامة بعد ذلك موقع",10,"ع",1,0],["يا رَبِّ هَبَّت شُعوبٌ مِن مَنِيَّتِها","وَاِستَيقَظَت أُمَمٌ مِن رَقدَةِ العَدَمِ",11,"م",1,0],["يا ربَّةَ البانةِ الغنَّاءِ تحضنُها","خضراءُ تلتفُّ أغصاناً بأغصانِ",12,"ن",1,0],["يا رَبَّةَ الخِدرِ قَري راضيَةً","فَإِن أَبَيتِ فَاِتلَفي مِنَ الغَضَب",13,"ب",1,0],["يا رَبَّةِ الخِدرِ إِنّي قَد عَزَمتُ عَلى ال","سُلُوِّ عَنكِ وَلَم أَعزِم عَلى رَشَدِ",14,"د",1,0],["يَا رَبَّةَ الْخِدْرِ قُومِي فَانْظُرِي عَجَباً","إِلَى غَرَائِبَ لَمْ تُقْدَرْ وَلَمْ تَكُنِ",15,"ن",1,0],["يا رَبَّةَ البَغلَةِ الشَهباءِ هَل لَكُمُ","أَن تَرحَمي عُمَراً لا تَرهَقي حَرَجا",16,"ج",2,1],["يا ربَّةَ المنديل مِنْ تحتِه","نَبْعَةُ حسنٍ ثَرَّةٌ صافيهْ",17,"ي",2,0],["يا رَبِّ هَبنا للنبيِّ وَهَب لنا","ما سَوَّلَتهُ نُفُوسُنا تَسوِيلا",18,"ل",2,0],["يا رَبَّةَ الوَجهِ الجَميلِ","وَالخالِ في الخَدِّ الأَسيلِ",19,"ل",1,1],["يا ربّ هذا سلامه","يخاف يوم القيامه",20,"م",2,1],["يا رَبُّ هَل أَنا بِالغَفَرانِ في ظَعَني","مُزَوَّدٌ إِنَّ قَلبي مِنكَ مُزؤودُ",21,"د",1,0],["يا رَبَّةَ الخِدرِ عُدّي ميتَةً وَسَناً","فَإِنَّما أَنتِ إِحدى الغيدِ مِن مُضَرِ",22,"ر",1,1],["يا رَبَّةَ الصَمتِ أَنتِ آمِنَةٌ","إِذا هَفا ناطِقٌ مِنَ السَقطِ",23,"ط",1,1],["يا ربَّةَ الأبطالِ لا هانَ الحِمى","وسلمْتِ أنتِ وقومُكِ الأحرارُ",24,"ر",1,0],["يا ربَّة الأشعارْ","غنِّي بها غنِّي",25,"ي",1,0],["يا ربَّةَ الحسنِ لا تُراعي","فلترْعَكِ الكائناتُ بعدي",26,"ي",1,0],["يا ربَّةَ الألحان غنِّي وابعثي","من كلِّ ماضٍ عاثرِ الأيامِ",27,"م",1,0],["يا ربَّة الألحان هل من رجعةٍ","لقديم لحنكِ أو قديم هيامي",27,"م",2,0],["يَا رَبَّةَ الْقُرْطَقِ هَلْ نَظْرَةٌ","أَحْيَا بِهَا يَا رَبَّةَ الْقُرْطَقِ",28,"ق",1,0],["يَا رَبِّ هَبْ لِي مِنَ الْكَرَامَةِ مَا","يَسُرُّ نَفْسِي فَإِنَّهَا وَجِرَهْ",29,"ر",2,0],["يَا رَبَّةَ النُّبلِ أُذْنُ الحقِّ سَامِعَةٌ","فِيكِ الدُّعَاءَ وَعَيْنُ اللهِ تَرْعَاكِ",30,"ك",1,0],["يَا رَبَّةَ الفَنِّ البَدِيعِ بِصِدْقِهِ","لا تَصْدُقِيهِ تَلَطَّفاً بِالشَّاعِرِ",31,"ر",1,0],["يَا رَبَّةَ الصُرْحِ الْمُنِيفِ وَمَنْ","زِينَاتُهُ الآدابُ وَالشِّعْرُ",32,"ر",1,0],["يَا رَبَّةَ الْقَصْرِ الَّذِي نَهَضَتْ بِهِ","عَلْيَاءُ تَنْمِيَها أَعَزُّ مَنَاسِبِ",33,"ب",1,0],["يَا رَبَّةَ الصُّرْحِ الْمُمَرَّدِ تَلْتَقِي","فِيهِ ذُؤابَاتُ