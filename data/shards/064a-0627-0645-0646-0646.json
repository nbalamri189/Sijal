abi.ae/diwan/poem/124072","البسيط"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86506","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135737","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103025","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69913","البسيط"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107516","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73382","الدوبيت"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146759","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33357","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33628","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33287","الكامل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67462","البسيط"],[4858,"عريس مسلم وعرس إسلامي","https://www.poetsgate.com/ViewPoem.aspx?id=32792",""],[4869,"نظم الاحاسيس","https://www.poetsgate.com/ViewPoem.aspx?id=151614",""],[4978,"يا من نظرتِ من الشباك للمطر","https://www.poetsgate.com/ViewPoem.aspx?id=177203",""],[4978,"إليكمُ سال من وجدانيَ القلم","https://www.poetsgate.com/ViewPoem.aspx?id=177291",""],[4984,"يا من نمت في الحب","https://www.poetsgate.com/ViewPoem.aspx?id=215826",""],[3591,"هي الحسان أراقت مهجة البطل","https://www.poetsgate.com/ViewPoem.aspx?id=149410",""],[5246,"زرت المنازل بعد بين أنيسها","https://www.poetsgate.com/ViewPoem.aspx?id=187060",""],[5277,"زاجلةٌ بغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=198942",""],[5278,"جمل يعاني من شللْ...","https://www.poetsgate.com/ViewPoem.aspx?id=210549",""],[5391,"يا الله يا علاّم باحوال ناسه","https://www.poetsgate.com/ViewPoem.aspx?id=25791",""],[5525,"ما عاد لي صاحب","https://www.poetsgate.com/ViewPoem.aspx?id=7264",""],[5525,"ظامي هوى","https://www.poetsgate.com/ViewPoem.aspx?id=989",""],[5573,"سلام مني ياصل القرم سلطان","https://www.poetsgate.com/ViewPoem.aspx?id=200351",""],[5644,"رحل الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=198640",""],[402,"ماذا أصاب أباك الشيخ واحربا","https://www.poetsgate.com/ViewPoem.aspx?id=35348",""],[402,"ألشرق طال سباته الروحاني","https://www.poetsgate.com/ViewPoem.aspx?id=36487",""],[5845,"ياصاحبَ القبرِ المنيرِ بيثربِ","https://www.poetsgate.com/ViewPoem.aspx?id=16605",""],[5853,"دموعٌ وتوجع","https://www.poetsgate.com/ViewPoem.aspx?id=175615",""],[5929,"باد هواك","https://www.poetsgate.com/ViewPoem.aspx?id=202445",""],[6031,"يا مَنْ نَأَى فجَعَلتُ بعدَ فِرَاقِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=46326",""],[6115,"وتحت الرماد أمور واشياء خطيره","https://www.poetsgate.com/ViewPoem.aspx?id=181535",""],[5355,"يا من نأيتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87227&r=&rc=52",""],[5396,"السيول","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65512&r=&rc=11",""]],"verses":[["يَا مَنْ نُوَدِّعُهُ وَكُلُّ مُوَدِّعٍ","دَامِي الفُؤَادِ مُقَرَّحُ الأَجْفَانِ",0,"ن",1,0],["يَا مَنْ نُوَدِّعُهُ قَسْراً وَنُودِعُهُ","قَبْراً وَلَيْسَ الفِدَى مِنَّا بِإِمْكَانِ",1,"ن",1,0],["يَا مَنْ نَأَتْ وَالرُّوحُ فِي إِثْرِهَا","هَائِمَةٌ مِنْ نَزَوَاتِ الأَلَمْ",2,"م",1,1],["يا مَن نُريدُ صَلاحَهُ وَصَلاحَنا","إِنَّ العُدولَ عَنِ الهَوى بِكَ أَجمَلُ",3,"ل",1,0],["يا مَن نَغارُ عَلَيهِم مِن ضَمائِرِنا","وَمِن مَصونِ هَواهُم في تَناجينا",4,"ن",2,0],["يا مَن نَلوذُ مِنَ الزَمانِ بِظِلِّهِ","أَبَداً وَنَطرُدُ بِاِسمِهِ إِبليسا",5,"س",2,0],["يا مَن نُعيتُ عَلى بُعدٍ بِمَجلِسِهِ","كُلٌّ بِما زَعَمَ الناعونَ مُرتَهَنُ",6,"ن",1,0],["يا مَن نَمُتُّ إِلى عُلاهُ بِأَنَّنا","في طَيِّ نِعمَةِ مُلكِهِ نَتَقَلَّبُ",7,"ب",1,0],["يا مَن نزلت بنبعه أرد الهوى","فأذاقنيه محطماً ووبيلا",8,"ل",2,0],["يا من نسخ الوَعْدَ بهجرٍ ونأى","فَرِّح أملي بوعد زورٍ ثانِ",9,"ن",1,0],["يَا مَنْ نُهَنِّيءُ بِالسِّيَامَةِ أُسْقُفاً","شَرَفاً فَأَنْتَ بِمَا بَلَغْتَ حَقِيقُ",10,"ق",1,1],["يَا مَنْ نُهَنِّئُهُ وَنَعْلَمُ أَنَّهُ","أَدَّى الأَمَانَةَ وَالحِسَابُ دَقِيقُ",10,"ق",1,0],["يَا مَنْ نَعَى تِلْكَ الفَضائِلَ وَالعُلَى","أَغَدَتْ مَعَالِمُهُنَّ قَاعاً صَفْصَفَا",11,"ف",2,0],["يَا مَنْ نُعَزِّيهِ عَنْ فَقْدِ الْحَبِيبِ وَمَا","نَأى الحَبيبُ الذي مِنْ رَبِّهِ قَرُبا",12,"ب",2,0],["يَا مَنْ نَأَى عَنِّي وَكَانَ مُرَادِي","أَتَرَكْتَنِي أَحْيا جَرِيحَ فؤادِي",13,"د",2,1],["يَا مَنْ نَأَوْا عَنْ عُيُونِي","وَرَسْمُهُمْ فِي السَّوَادِ",14,"د",1,0],["يَا مَنْ نَأَى عَنْ مِصْرَ فَاجْتَمَعَتْ عَلَى","ثُكْلٍ وَمَا فِي الثُّكْلِ مِنْ أَحْزَابِ",15,"ب",1,0],["يَا مَنْ نَمَتْهُ إِمَارَةُ النَّسَبِ","فَأَعَزَّهَا بِإِمَارَةِ الحَسَبِ",16,"ب",1,1],["يَا مَن نُعِيدُ الْيَوْمَ سِيرَتَهُ","فَتَزِيدُنَا بِزمَانِنَا خُبْرَا",17,"ر",2,0],["يَا مَنْ نُوَدِّعُهُ أَنْجْزَعُ لِلنَّوَى","وَالأَمْرُ أَمْرُ اللهِ حِيْنَ يُريدُ",18,"د",1,0],["يَا مَنْ نَأَى عَنِّي","وَكَانَ أَجَلَّ أَخْوَانِي وَصَحْبِي",19,"ب",2,1],["يَا مَنْ نُعَزِّيهِ وَيَدْرِي","فَوْقَ مَا نَدْرِي الصَّوَابْ",20,"ب",1,0],["يا مَن نُفوسُ الخَلقِ بَعضُ هِباتِهِ","وَسَحائِبُ النَكَباتِ مِمّا كَشَّفا",21,"ف",2,0],["يَا مَنْ نَفَتْ عَنِّي لَذِيذَ رُقَادِي","مَالِي وَمَالَكِ قَدْ أَطَلْتِ سُهادِي",22,"د",2,1],["يا مَن نَأى عَنِّي وَباتَ خَيالُهُ","في طَيِّ قَلبٍ عَنهُ لَم يَتَرَحّلِ",23,"ل",1,0],["يا من نَصيِبي منه قر","بٌ مثلُ سرعةِ عِيسِهِ",24,"س",2,1],["يا من نكى في الهوى فؤادي","يا غاية القصد والمراد",25,"د",1,0],["يا من نلوذُ بماله وبجاهه","فنفوز بالإسعافِ والإسعادِ",26,"د",1,1],["يا من نرجيه لكشف عظيمة","ولحل عقد ملتوِ متصعب",27,"ب",1,0],["يا من نؤمل من كل كَرامة","وَنَلوذ في حرم الجِناب الاغلب",27,"ب",1,0],["يا من نُناديه فَبِسَمعنا عَلى","بعد المَسافة سمع أَقرب أَقرَب",27,"ب",1,0],["يا مَن نَأى عَن ناظِري لَكِن ثَوى","في القَلبِ فَهوَ كَحبِّهِ لا يَرحَلُ",28,"ل",1,0],["يا من نسيت هوى الصبا","وطويته لا تذكرينه",29,"ن",2,0],["يا مَن نُعِدُّ بِهِ المَجازَ حَقيقَةً","أَنتَ المُفَدّى خِفَّةً وَلِطافَةِ",30,"ه",1,1],["يا من نأت بهمُ الديار فأصبحوا","مستوطنينُ على النوى الألبابا",31,"ب",2,1],["يا مَن نَراهُ في المَنامِ صورَةً","في يَقظَتي مَعي أَراهُ مَعنى",32,"ن",2,1],["يا مَنْ نَداهُ إلى الإفْضالِ أسْبَقُ من","سُؤالِ عافيهِ أو تَأميلِ راجيه",33,"ي",2,0],["يا مَن نَداهُ لزائرِي","هِ الدَّهْرَ تَرحيبٌ وبِشْرُ",34,"ر",1,1],["يا من نفديه بكل ممجد","ونراه روحاً للعلى والسؤدد",35,"د",1,1],["يا مَنْ نَضا باللَّحظِ سَيْفَ الأشتَرِ","إذا وجدْتَ الحُرَّ عبداً فاشْتَرِ",36,"ر",1,0],["يا من نَسيمُ فِعالِهِ","كَنَسيم مِسكِ أَو عَبير",37,"ر",1,0],["يا مَن نَعِمْتُ به وأَيَّة نعمة","وسَعِدْتُ بين النَّاس في إسعاده",38,"د",2,0],["يا من نأوا والشوق يدنيهم إلى","قلبي وإن بعدوا وإن لم يبعدوا",39,"د",3,0],["يا من نزلتُ وآمالي بساحتهِ","عسى برأيك أن يقضى لنا وطرُ",40,"ر",1,0],["يا من نظر الأعمى وقد فصحت","نوق اليماني له لما لها رمقا",41,"ق",2,0],["يا مَن نَداهُ سَلِسُ القِيادِ","وَما لُهُ لِرائِحٍ وَغادِ",42,"د",1,1],["يا من نهى النفس عن هواها","دنيا وأخرى لك النعيم",43,"م",1,0],["يا من نراكَ بفهمِ كونِكَ عاجِزاً","وبشأنِ ذاتِكَ ما لَكَ اسْتيفاءُ",44,"ا",2,0],["يا مَن نسمِّيهِ الحبيبَ وإنَّهُ","رَجُلٌ إلى كلِّ القلوبِ حبيبُ",45,"ب",1,0],["يا مَن نَراهُ اليومَ يَغلبُهُ البُكا","سَنَراكَ يَعصِيك التَباكي في غَدِ",46,"د",1,0],["يا من نسيتُ فسُكْرُه من لحظه","أَلم الجراحِ به فقلبي ذاهلُ",47,"ل",1,1],["يا مَنْ نأتْ وبأحنْاءِ الضُّلوع ثوَتْ","تُراكِ تَنْسَيْنَ صَبّاً لَيْسَ يَنْساك",48,"ك",1,0],["يا من نَراه لتيسير الأمور ويا","للَّه أمرٌ أتانا منه قد قيسا",49,"س",2,0],["يا من نودِعُهُ بلاهبِ أدمعٍ","قد مكّنت منا الأسى فتمكّنا",50,"ن",2,0],["يا من نرى أخلاقه حلوة","كأنها مخلوقة من ضرب",51,"ب",1,0],["يا من نرجيه لدفع الأذى","عنا وندعوه لكشف الكُرَب",52,"ب",1,0],["يا من نظمت المدح في مجده","حسنا ولا زهرة بسنانِ",53,"ن",1,0],["يا من نصيب عفاته","من وفره أَبدا موفر",54,"ر",1,0],["يا من نداه لا يغب","ب ومن عطاياه جسامُ",55,"م",1,0],["يا من ندانا له يا رب ينعشنا","وهو الدواءُ الذي يبري من السقمِ",56,"م",1,0],["يا من نوى ظعنا عتاب مبرح","سكن الوداد ضلوعه فطواها",57,"ا",3,0],["يا من نأيت ولي حنين نحوه","أملي به للناشدات فتنشدُ",58,"د",1,0],["يا مَن نفا عنّى رُقادى","وأطال من شغفٍ سُهادِى",59,"د",2,1],["يا مَن نرى الناسَ أنَّى غابَ غائبةً","جميعها وحضوراً أينما حضرا",60,"ر",2,0],["يا من نأوا وعليلهم بدموعه","مثل القتيل مضرجٌ بدمائه",61,"ه",1,1],["يا مَن نفى عني لذيذَ مَنامي","منى إليك تحيتي وسلامي",62,"ي",1,1],["يا مَن نَسَجتُ لَهُ مِن مَنطِقي حُلَلاً","جَديدَةَ الحَمدِ لا تَبلى عَلى الأَبَدِ",63,"د",1,0],["يا من نُسَميه تعريفاً نُقَرّرُهُ","بِشَخْصه في نفوس القوم تقريرا",64,"ر",2,1],["يا من نحاني دهري فلم يك لي","إلا إلى ظل ملكه هرب",65,"ب",1,0],["يا من نطقت بمدحك الايامُ","صدقاً وتحسنت بك الاحكامُ",66,"م",1,1],["يا من نعوت جلاله وجماله","جلت عن الأسباب والإكثار",67,"ر",1,0],["يا من نهني الدين بابن كهفه","وكهفه كان الاعز الامنعا",68,"ع",2,0],["يا من نحاذره ونرجو عفوه","كرما عليك بقائل فعال",69,"ل",1,0],["يا من نقض عهد الهوى المؤكد","من غير لا حجه ولا عنيه",70,"ي",2,1],["يا من نأى عنا إلى جانب","صدا كميل الشمس عند الغروب",71,"ب",1,1],["يا من نواله عم كل الأنام","يا منزل السجده وغافر",72,"ر",1,0],["يا مَن نَأى عَنّي كَما","تَنأى العُيونَ الفرقدان",73,"ن",1,0],["يا من نأى وكانما هو حاضِرٌ","وهماً عليك تحيَّةٌ وَسَلامُ",74,"م",1,0],["يا مَن نَعَتهُ إِلى الإِخوانِ لِحيَتُهُ","أَدبَرتَ وَالناسُ إِقبالٌ وَإِدبارُ",75,"ر",1,1],["يا مَن نعيت لنا ودد","نا قبل يَومك لَو نعينا",76,"ن",2,0],["يا من نُصغِرُهُ إذا قلنا لهُ","ملِكَ الملوكِ وماجِدَ الأمجادِ",77,"د",1,0],["يا مَن نَرى البَرق من يُمناه في سُحب","تَهَلَلَت وَغُبار النَقع كَالظَلل",78,"ل",1,0],["يا من نداه جلالي","بأنه ذو جلال",79,"ل",1,0],["يا من نمته عروق الفخر من مضر","كما تسنم فرع المجد من أدد",80,"د",1,0],["يا من نفضت عن الجوانح علتي","وصدمت دوني طارق الأهوال",81,"ل",1,0],["يا من نهى عن ردِّ ذي السؤالِ","على لسان أفضل الرجالِ",82,"ل",1,0],["يا من نجاة بني الدنيا بحبهم","كأنها البحر لم يركب بلا سفن",83,"ن",1,0],["يا مَن نَقَشتم على المصباح دائِرَةً","سَوداءَ مِن لَمحها قَد اظلمَ البصرُ",84,"ر",1,0],["يا من نشيدُ بذكرهِ وحديثُهُ","سارت به الركبانُ في البيداءِ",85,"ا",2,0],["يا مَن نَزَحوا عَني فَأَمست عَيني","تُجري دَمعاً كَأَنَّهُ من عَينِ",86,"ن",1,1],["يا من نعوذ من المكارم باسمه","ونعزه وهو الأعز الأشرف",87,"ف",1,0],["يا مَن نأى فنأى العزاءُ لفقدهِ","إن غِبتَ عَن عَيني فذكركَ حاضِرُ",88,"ر",1,0],["يا مَن نأى عنِّي وَصد مغاضباً","إن المحبَّ لما بهِ محزونُ",89,"ن",1,0],["يا مَن نَعى جِسمي إليهِ بطرفهِ","نظرٌ يشوبُ سقامهُ بفتورِ",90,"ر",1,0],["يا من نعته إلى الاخوان لحيته","أدبرت والدهر إقبال وإدبارُ",91,"ر",1,1],["يا مَن نشأتَ وفي يَمينِكَ رايةٌ","للهِ، أبْشِرْ، إنّك المقبولُ",92,"ل",1,0],["يامن نظمتي ماتكن الاحاسيس","ماتدري ان الكسر بالبيت آفه",93,"ف",2,1],["يا من نظرتِ من الشباك للمطر","والبرق يعرض أشكالا من الصور",94,"ر",1,1],["يا من نضيتم ثياب الوصل من زمنٍ","أكان منكم على هجراننا قسمُ ؟",95,"م",1,0],["يا من نمت في الحب أغصانه","وجاد بالخيرات من كسبِهِ",96,"ب",2,1],["يا من نؤمل فيه عند كربتنا","ولا يؤمل إلا كل ذي أمل",97,"ل",1,0],["يا من نظمت لي الخطاب مذكرا","بعميق ود لم يكن مجهولا",98,"ل",2,0],["يا من نواها دربُه لا ينتهي","مهما ابتعدنا... فالهوى سيعودُ",99,"د",1,0],["يا مَن نظمتَ قصيدة لا تُحتمَلْ","ألفاظُكُم تلهُو بها ريحُ الملَلْ",100,"ل",1,1],["يا من نصلّي له ونخشى لباسه","الحكم حكمه في الدراهم والآجال",101,"ل",1,0],["يا من نشدني علامك ناحلٍ شاحب","اخترت مثلك صديقٍ وأخلف اظنوني",102,"ن",2,1],["يا من نثر برماح الأهداب دمي","لو للجروح ضماد وصلٍ تصبّرت",103,"ت",1,0],["يامن نوى الترحال ومفارق اوطان","في رحلتك تزداد فهم ونجابه",104,"ب",2,0],["‏يامن نسيتم عهدكم ووعودكم","‏هانَ الهوى أم صابكم نسيانُ",105,"ن",1,0],["يا من نعزيه عن فقد الحبيب وما","نأى الحببب الذي من ربه قربا",106,"ب",2,0],["يا من نودعه وكل مودع","دامي الفؤاد مقرح الجفان",107,"ن",1,0],["يا منْ نؤملُ منهُ كلَّ كرامة","ٍ ونلوذُ في حرمِ الجنابِ الأغلبِ",108,"ب",1,0],["يا منْ نناديهِ فيسمعنا على","بعدِ المسافة ِ سمعَ أقربِ أقربِ",108,"ب",1,0],["يامَنْ نَظَرْتُ إليكِ كلّ سعادةٍ","ثكلى بغيركِ والشقاءُ يطولُ",109,"ل",1,0],["يَا مَنْ نَذَرْتُ لَهَا الفُؤَادَ وَفَا","وَبَذَلْتُ عُمْراً بَعْدَهُ عُمْرُ",110,"ر",1,0],["يا مَنْ نَأَى فجَعَلتُ بعدَ فِرَاقِهِ","أسِمُ الوُجُوهَ بِنَظرةِ المُتَبدِّلِ",111,"ل",1,1],["يامن نصر موسى على جيش هامان","واهلكت فرعون الخبيث ووزيره",112,"ر",2,0],["يا من نأيتِ ولا شيءٌ يُعوِّضُني","قد ضلَّ سَعييْ وقلبي باتَ خفَّاقا",113,"ق",2,0],["يا من نصبت لهم سود الخيام على","صفر الرماد لقد غاصت إلى الأبد",114,"د",1,0]]}