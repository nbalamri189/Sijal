{"poems":[[65,"لك المجد لا ما تدعيه الأوائل","https://www.aldiwan.net/poem46184.html","الطويل"],[88,"صونوا يراع علي في متاحفكم","https://www.aldiwan.net/poem10487.html","البسيط"],[75,"لبيض الطلى ولسود اللمم","https://www.aldiwan.net/poem11934.html","المتقارب"],[75,"هي الشمس مغربها في الكلل","https://www.aldiwan.net/poem11950.html","المتقارب"],[23,"لعمري لقد شانت هذيل بن مدرك","https://www.aldiwan.net/poem21617.html","الطويل"],[53,"أبا بكر لك المثل المعلى","https://www.aldiwan.net/poem65904.html","الوافر"],[47,"وعالمة وقد جهلت دوائي","https://www.aldiwan.net/poem10211.html","الوافر"],[47,"ملامك في صدودي واجتنابي","https://www.aldiwan.net/poem11052.html","الوافر"],[30,"بكت عين محزون فطال انسجامها","https://www.aldiwan.net/poem5557.html","الطويل"],[63,"أبا بكر أسأت الظن فيمن","https://www.aldiwan.net/poem51537.html","الوافر"],[107,"لمن تجمع الروم أبطالها","https://www.aldiwan.net/poem44030.html","المتقارب"],[83,"أسيف الوزارة بوركت من","https://www.aldiwan.net/poem61329.html","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/1238","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42645","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54258","الوافر"],[92,"ذكرى دمشق الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179048",""],[164,"أعندك علم أم أقول فأطرب","https://www.aldiwan.net/poem58761.html","الطويل"],[197,"أبا بشر ذهبت بكل أنس","https://www.aldiwan.net/poem13014.html","الوافر"],[197,"أبا بشر فقدت لذيذ عيشي","https://www.aldiwan.net/poem13161.html","الوافر"],[240,"أرى الأيام صيغتها تحول","https://www.aldiwan.net/poem31790.html","الوافر"],[362,"أبا بحر سلام الله يترى","https://www.aldiwan.net/poem4180.html","الوافر"],[411,"أهبت بأشعاري إلى السيد الندب","https://www.aldiwan.net/poem50081.html","الطويل"],[415,"أعاتب فيك الدهر لو أعتب الدهر","https://www.aldiwan.net/poem31861.html","الطويل"],[438,"أبا بكر العبدي عاداك ذو الفتك","https://www.aldiwan.net/poem12452.html","الطويل"],[500,"حنانيك من نفس خافت","https://www.aldiwan.net/poem9786.html","المتقارب"],[520,"أنهي إليك من خفي حالي","https://www.aldiwan.net/poem12216.html","السريع"],[556,"أبا بكر تعرضت المنايا","https://www.aldiwan.net/poem47723.html","الوافر"],[572,"تعطف علينا أيها الغصن الغض","https://www.aldiwan.net/poem69619.html","الطويل"],[572,"أخ لي كنت أغبط باعتقاده","https://www.aldiwan.net/poem69712.html","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126717","الوافر"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126795","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126743","الوافر"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126691","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63921","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37992","الوافر"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82258","الوافر"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136197","الطويل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6749","الوافر"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49584","المتقارب"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101919","الطويل"],[1849,"","https://poetry.dctabudhabi.ae/diwan/poem/77681","الوافر"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46469","الكامل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87674","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87783","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87781","الطويل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/198647",""],[2637,"","https://poetry.dctabudhabi.ae/diwan/poem/22609","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65969","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100320","الرجز"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11349","الوافر"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107067","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62936","المتقارب"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117962","الطويل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34588","الرمل"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103561","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141656","المتدارك"],[4645,"","https://poetry.dctabudhabi.ae/diwan/poem/105481","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204312","الطويل"],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5526,"درب الدراويش","https://www.poetsgate.com/ViewPoem.aspx?id=198713",""],[5977,"رثاء أبي بكر الجزائري","https://www.poetsgate.com/ViewPoem.aspx?id=213248",""],[572,"أخٌ لي كُنتُ أُغبَطُ باعتقادِه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9249&r=&rc=106",""]],"verses":[["أبابِلُ لا وادِيكِ بالرِّفْدِ مُفْعَمٌ","لدَيْنا ولا نادِيكِ بالوَفْدِ آهِلُ",0,"ل",1,0],["أَبا بُثَينَةَ نَم يَكفيكَ ما تَرَكَت","فينا يَداكَ وَما عانَيتَ مِن تَعَبِ",1,"ب",1,0],["أَبا بَكرٍ اِسلَم عَلى الحادِثاتِ","وَلا زِلتَ مِن رَيبِها في حَرَم",2,"م",1,0],["أَبا بَكرٍ اِسمَع أَحاديثَ لَو","تُبَثُّ بِسَمعِ عَليلٍ أَبَلّ",3,"ل",1,0],["أَبابيلُ دَبرٍ شَمَّسٍ دونَ لَحمِهِ","حَمَت لَحمَ شَهّادٍ عِظامَ المَلاحِمِ",4,"م",1,0],["أبا بكر لك المثْلُ المعلَّى","وخدُّ عدوّكَ التَّرِبُ الذليلُ",5,"ل",1,1],["أَبا بَكرٍ بَنَيتَ بِناءَ طَولٍ","مِنَ الإِحسانِ لَيسَ مِنَ البِناءِ",6,"ا",2,0],["أَبا بِشرٍ وَأَنتَ أَخي وَوُدّي","وَمَن رَضِيَ اِختِباري وَاِنتِخابي",7,"ب",2,0],["أَبِاِبنِ يَزيدٍ وَاِبنِ زَحرٍ تَحَلَّلَت","دِماءُ تَميمٍ وَاِستُبيحَ سَوامُها",8,"م",3,0],["أبا بكرٍ أَسَأْتَ الظَّنَّ فيمَن","سَجِيَّتُه التَّمَنُّعُ والخِلافُ",9,"ف",1,1],["أبا بكرٍ اخْترتَ أبقى الثراء","وجَنَّبتَ نَفْسَكَ بَلبالَها",10,"ل",3,0],["أبَا بَكرِ افخَر وَحَسبُ الحَسُودِ","مًغَالَطَةُ الزّجّ لِلعَامِلِ",11,"ل",1,0],["أَبا بِشرٍ قَدِ اِستَفتَحتَ باباً","وَقَد أَتمَمتَهُ إِلّا قَليلا",12,"ل",2,1],["أَبَابِلُ رَأْيَ الْعَيْنِ أَمْ هَذِهِ مِصْرُ","فَإِنِّي أَرَى فيها عُيُوناً هِيَ السِّحْرُ",13,"ر",1,1],["أبابيلاً نشأنَ مُلَعَّناتٍ","تسوقُ أمامها الموتَ الزُؤاما",14,"م",2,0],["أبابُ الله يُفتح للبرايا","وعن هذي البلاد به انغلاق",15,"ق",1,0],["أبا بكر فَاسمع ما يسرك وانتظر","لما أَنت ترجو من صنيعي وتطلبُ",16,"ب",1,0],["أبا بكر إِني بالوزير لغالبٌ","وإِنك لي يا صاحبي ليس تغلبُ",16,"ب",1,0],["أَبا بِشرٍ ذَهَبتَ بِكُلِّ أُنسٍ","فَما شَيءٌ لَدَينا مِنه يُعهَد",17,"د",1,1],["أَبا بِشر فَقَدتُ لَذيذَ عَيشي","بِفَقدي طِيبَ عِشرَتِكَ الرَضِيّه",18,"ض",3,1],["أَبا بَكرٍ هَناكَ جَديدُ مُلكٍ","مُحالِفُهُ لَكَ العُمرُ الطَويلُ",19,"ل",1,0],["أبَا بَحرٍ سلامُ اللهِ يَترَى","عَلَيكَ وَإِن تَكَنَّفَكَ الحِجَابُ",20,"ب",1,1],["أبا بكرٍ الممدوحَ أُصفيكَ مِدحَتي","وأُصفي الّذي لم يُصفِكَ الوُدَّ بالَجدْبِ",21,"ب",1,0],["أبا بَكر ما وجدي عليك بمنْقَضٍ","طَوالَ اللّيالي ما انقَضى اليومُ والشَّهرُ",22,"ر",1,0],["أبا بكْرٌ العبدِيّ عاداكَ ذو الفَتْكِ","فحِفظاً لأستارِ القريضِ من الهَتْكِ",23,"ك",1,1],["أبا بكرٍ اسمع وقل كيف ذا","ولست بسمعة الصائت",24,"ت",1,0],["أبا بنات وقليل المال","لا أرقد الليل من السعال",25,"ل",1,0],["أبا بكرٍ تعرَّضَتِ المنايا","لحتفكَ حين لا أحدٌ مَنوعُ",26,"ع",1,1],["أَبَا بَكرٍ اسْلَمْ لِلْمَوَدَّةِ والصَّفَا","فَوُدُّكَ بَاقٍ لا يَحُولُ وَلاَ يَنْضُو",27,"ض",2,0],["أبا بكرٍ بمجدِكَ حين تسمو","بطارفِهِ وتضحَكُ عن تِلادِهْ",28,"د",2,0],["أبا بدري يا مَن قد تسامى","علا وسَما بمفخره الوحيدِ",29,"د",1,0],["أَبا باسمٍ يا من بفخارهِ","ومدّ إلى المجدِ المؤثّل إصبعا",30,"ع",2,1],["أَبا بدري نلتَ مقامَ عزٍّ","لحقّاً أنتَ فيه اليوم أحرى",31,"ر",2,0],["أبا بدري أنت لنا عمادٌ","وغوثٌ إن تفاقَمَتِ الخطوبُ",32,"ب",1,0],["أبا بكرٍ وأنت فتى سميعٌ","إذا ما عُدّ لُّ فتى أُناسِ",33,"س",1,1],["أَبا بَكرٍ عَلاكَ الغيظُ مِنّي","وَفيكَ مَوَدَّتي حَقٌّ وَصِدقُ",34,"ق",1,1],["أبا بكْرٍ ثَوَيْتَ رَهِينَ رَمْسٍ","يَخْبُّ بَنْعيِك المُتَعجِّلُوناَ",35,"ن",2,0],["ابا بكر العطاس فرد زمانه","وبحراً من العرفان يالك من بحر",36,"ر",1,0],["أَبا بَكرٍ دَعَوتُكَ لَو أَجَبتا","إِلى ما فيهِ حَظُّكَ إِن عَقَلتا",37,"ت",2,0],["أَبا بَكرٍ كَشَفتَ أَقَلَّ عَيبي","وَأَكثَرَهُ وَمُعظَمَهُ سَتَرتا",37,"ت",2,0],["أبا بكرٍ اقتضِ تلك الديونَ","فقد أبأَسَ الدهرُ مما مَطَل",38,"ل",1,0],["أبا باقر أصبحت كهفا لذي الورى","فدم للورى يا كهفه وابق وأسلم",39,"م",1,0],["أَبا بَكر ثَناءك طُولَ دَهري","أُردّد بِاللسان وَبِالجنانِ",40,"ن",1,0],["أَبابرة مِثل الهَباةِ كَسيرة","تَستَطيع قَلعَ الهَضَبة الصَماء",41,"ا",2,0],["أَبابل في أَرض الشآم وَهَل بَدا","بسهل أَريحا لِليَهود يَشوع",42,"ع",1,0],["أَبا باقرٍ أَوليتَني نِعماً كُثرا","وفَضل أَيادٍ لا أُطيف لَها شُكرا",43,"ر",2,1],["أَبا باقر تَفديك نَفسيَ إِنَّني","أَرى فيكَ مَدحي قاصِراً وَنَسيبي",44,"ب",2,0],["أبا بكرٍ كتمت عُلاك حِلْماً","فنَمّ على الرُّبا طيب الفواح",45,"ح",1,0],["أَبابيلَ رَهواً بَينَ قَوداءَ شَطبَةٍ","وَقَبّاءَ مِثلِ الأَخدَرِيِّ نَسولِ",46,"ل",1,0],["أبا بكر من للنائبات إذا دهت","ومن للقافي ساعة الروع والزحف",47,"ف",1,0],["أبا بكر من يلبس ردا الليل كالذي","تسربله لما خشى فرقة الألف",47,"ف",1,0],["أبا بكر لم تنقض عهوداً فإنما","أولئك قوم يعبدون على حرف",47,"ف",1,0],["أبا بكر لم تهتك لدينك حرمة","كغيرك للعاصين من خيفة العنف",47,"ف",1,0],["أبا بكر قد ساقوك طاشت حلومهم","من العز والتقوى إلى الكفر والتلف",47,"ف",1,0],["أبا بكر لو صافحت دغار لم أكن","وذي العرش أخشى يخدعونك بالخلف",47,"ف",1,0],["أبا بكر إن قيست ألوف بواحد","فأنت كمثل الألف والألف والألف",47,"ف",1,0],["ابٌ ابي الا العقوق لابنه","ثم اخ باع الاخاء مرخصا",48,"ص",2,0],["أَبا بِشرٍ تَطاوَلَ بي العِتابُ","وَطالَ بِيَ التَرَدُّدُ وَالطِلابُ",49,"ب",1,1],["أبا باقر أنت السواد لناظري","وقد بنت فانهلت عليك هوامله",50,"ل",2,0],["أَبابيلَ كالطيرِ مَزؤدة","تُصَبُّ عليها السّباطُ القِدَدْ",51,"د",1,0],["أبابن كدام أم بكعب ابن مامة","أم الوائلي المعمل الخيل والابلا",52,"ل",2,0],["ابأبي زورٌ تلفت له","فتنفست عليه الصعدا",53,"د",2,0],["أبا بكر استوفيت زهر محاسن","تنافسها زهرُ النجوم الطوالعُ",54,"ع",1,0],["أب أب أب ظاو آرت وانتد","شي إز ويري أنْد طرمانتِد",55,"د",1,1],["أبا باقرٍ قد عز واللَه ما جرى","وعز علينا صادق القول ما ترى",56,"ر",2,1],["أبابيل جابت دون إدراك غايتي","على أنّها لم تأل في الطيران",57,"ن",1,0],["أبا بكر الصديق أفضل أمة","لأحمد والفاروق من كان ضيغما",58,"م",2,0],["اب َ ابتسم من دون وش لون أو ليش","وروس الحبال يحلّها من عقدها",59,"د",3,0],["أبا بكر أيا عَلَماً فقدنا","بك افتخرت -بعالِمها- الجزائرْ",60,"ر",1,1],["أَبا بكرٍ لمجدِكَ حينَ تسمُو","بِطَارِفِهِ وتضحكُ من تِلادهْ",61,"د",2,0]]}