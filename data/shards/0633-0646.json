ww.aldiwan.net/poem47935.html","عموديه"],[552,"هل مجير من غصة ما تقضى","https://www.aldiwan.net/poem47736.html","الخفيف"],[554,"هاجت وساوسه برومة دور","https://www.aldiwan.net/poem68402.html","الكامل"],[559,"سنة نبي مختار","https://www.aldiwan.net/poem34235.html","منهوك المنسرح"],[559,"عالم النطق عالم الأنفاس","https://www.aldiwan.net/poem34442.html","الخفيف"],[576,"تنزه طرفي بين زاه وزاهر","https://www.aldiwan.net/poem3073.html","الطويل"],[576,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"],[588,"أرى كل ما قد قدر الله يكتب","https://www.aldiwan.net/poem11510.html","عموديه"]],"verses":[["سَنَحَت لَنا في المُشرِقاتِ عَشِيَّةً","وَمِنَ السِهامِ مَحاجِرٌ وَعُيونُ",0,"ن",1,0],["سَنَنتُ لِهَذا الرُمحِ غَرباً مُذَلَّقا","وَأَجرَيتُ في ذا الهِندُوانيِّ رَونَقا",1,"ق",2,1],["سَنَحَت لَنا بِلَوى العَقيقِ وَرُبَّما","عَرَضَ الزُلالُ وَزيدَ عَنهُ الفارِطُ",2,"ط",1,1],["سِنانٌ تَحَدَّتهُ الدُروعُ بِزُغفِها","فَبَدَّدَ أَعيانَ المُضاعَفِ وَالسَردِ",3,"د",1,0],["سِنانُ عُلاً عُزّي قَناتي وَمَضرَبٌ","مِنَ المَجدِ مُستَثنىً بِهِ مِن مَضارِبي",4,"ب",2,0],["سَناءٌ تَبَلَّدُ عَنهُ السَماءُ","وَمَجدٌ سَها عَن مَداهُ السُها",5,"ا",1,0],["سُنّةُ الفَضْلِ بهِ قامَتْ وقَدْ","أُحدِثَتْ منْ فضْلِهِ فِيها بِدَعْ",6,"ع",1,0],["سنَسْألُ عنْ سُكّانِها نَفسَ الصَّبا","لعلّ نسيمَ الرّيحِ يُخْبِرُ عنْ هِنْدِ",7,"د",1,0],["سَنابِكُهُ كَمَداري الظِبا","ءِ أَطرافُهُنَّ عَلى الأَرضِ شُم",8,"م",1,0],["سَنُجمِعُ أَمرَنا وَتَرَونَ مِنّا","لَدى الجُلّى كِراماً صابِرينا",9,"ن",2,0],["سَنُطري أَياديكَ الَّتي قَد أَفَضتَها","عَلَينا فَلَسنا أُمَّةً تَجحَدُ اليَدا",10,"د",2,0],["سَنّوا السَماحَ فَأَسرَفَت سُؤّالَهُم","فَإِساءَةٌ إِحسانُهُم بِالعيسِ",11,"س",1,0],["سَنامٌ مِنَ المَجدِ عالي الذُرا","يَظَلُّ العِدا مِنهُ تَحتَ الأَظَلّ",12,"ل",1,0],["سَنوليك عُرفاً إِن أَرَدتِ وِصالَنا","وَنَحنُ لِتِلكَ الحاجِبِيَّةِ أَوصَلُ",13,"ل",1,0],["سَنَاهُ مَرْشِدُ السَارِينَ كَافٍ","مَغَبَّاتِ الضَّلاَلِ وَالارْتِيَابِ",14,"ب",1,0],["سَنَحَتْ وِبِالأَيَّامِ عَنْهَا غَفْلَةٌ","هَلْ كَانَ حُسْنُ الرَّأْيِ فِي إِغْفَالِهَا",15,"ل",3,0],["سِنَةٌ عَلَى عَيْنَيْكَ رَانَتْ دُونَهُ","وَإِلَيْهِ لَفْتَةُ قَلْبِكَ اليَقْظَانِ",16,"ن",1,0],["سِنانُ مُحَمَّدٍ في كُلِّ حَربٍ","إِذا نَهِلَت صُدورُ السَمهَرِيِّ",17,"ي",1,1],["سِنادٌ سَبَنتاةٌ كَأَنَّ مَحالَها","ضَريسٌ بِطَيٍّ مِن صَفيحٍ وَجَندَلِ",18,"ل",1,0],["سِنادٌ كَأَنَ المِسحَ في أُخَرياتِها","عَلى مِثل خَلقاءِ الصَفا حِينَ تَخطِرُ",19,"ر",1,0],["سَنأبَى عليه أشدّ الأِبا","فإما الفناء وإما البقا",20,"ق",2,0],["سنثأر حتى تسأم الحرب ثأرنا","ونقتل عن كل امرئ أنفساً عشرا",21,"ر",2,0],["سنُلبسكم ثوب المهالك ضافياً","ونحملكم منها على مَركب صعب",22,"ب",1,0],["سندرك فيك الثأثر من أنفس العدى","ونُوقِد نار الحرب وهي زَبون",23,"ن",1,0],["سَنفديه حتى لا حياة عزيزة","ونبذل حتى لا نفيسٌ ولا عِلق",24,"ق",1,0],["سنطلب هذا الحق بالسيف والقنا","وشَِيب وشبان على ضُمَّر بُلق",25,"ق",1,0],["سنَستَصرخ الآساد من كل مَربض","فتمشي إلى الهَيْجاءِ شيب وشُبان",26,"ن",1,0],["سننهض للمجد المخلَّد نهضة","يقرّ بها حَوران عيناً ولُبنان",26,"ن",1,0],["سنسعى إلى ما قد سعيت من العلا","بصادق عزم ينكر الضعف والوهنا",27,"ن",2,0],["سَنَذكُرُكُم وَلَيسَ إِذا ذُكِرتُم","بِنا صَبرٌ فَهَل لَكُمُ لِقاءُ",28,"ا",2,0],["سِنينَ مَعَ الجَرادِ تَعَرَّقَتنا","فَما تُبقي السُنونُ مَعَ الجَرادِ",29,"د",1,0],["سَنَشكُرُ مَن لَهُ أَثَرٌ عَلَينا","كَآثارِ الوَلِيِّ عَلى العِهادِ",29,"د",1,0],["سَنُثيرُ قَينَكُمُ وَلا يوفى بِها","قَينٌ بِقارِعَةِ المِقَرِّ مُثارُ",30,"ر",1,0],["سَنَحَ الهَوى فَكَتَمتُ صَحبي حاجَةً","بَلَغَت تَجَلُّدَ ذي العَزاءِ الصابِرِ",31,"ر",1,0],["سَنُخبِرُ أَهلَنا بِقِرى حِماسٍ","وَنُخبِرُ ما فَعَلتَ أَبا خُفافِ",32,"ف",1,1],["سَنَضرِبُهُم مادامَ لِلسَيفِ قائِمٌ","وَنَطعَنُهُم مادامَ لِلرُمحِ لَهذَمُ",33,"م",1,0],["سنٌّ علا كبراً وسنّ قد هوى","تلفاً ولسنٌ إن يؤخر يفزع",34,"ع",1,0],["سنة إن غفلت عنيَ فيها","كسرتني وكيف لا وهيَ سبع",35,"ع",1,0],["سنانُ المنيّةِ في جانبٍ","وسيفُ المَنِيَّةِ في جانبِ",36,"ب",1,0],["سِنٌّ بَنَتْني وعادتْ بعد تهدِمني","حتى رزَحتُ رزوح العَوْدِ ذي الجَلَبِ",37,"ب",1,0],["سنترك ما ساء العدا من فعالنا","إذا تركت شمس النهار شروقها",38,"ق",3,0],["سَنَرمُقُهُم إِذا طَلَعوا عَلَينا","كَأَنّا نَرمُقُ الداءَ العُقاما",39,"م",2,0],["سَنوقِدُها تُعيرُ الشَمسَ ناراً","وَيُعيِ أَمرُها الجَيشَ اللَهاما",39,"م",2,0],["سنوا بمعترك الحيا","ة لساعة الذود الشفارا",40,"ر",2,0],["سنشيدن مجدنا","بعدما انهار وانهدم",41,"م",1,0],["سنأخذ منك يوما بالخناق","ولما تبلغ الروح التراقي",42,"ي",1,0],["سَنَةٌ أَفرَحَت وَأُخرى أَساءَت","لَم يَدُم في النَعيمِ وَالكَربِ حالِم",43,"م",1,0],["سَناؤُهُ وَسَناهُ الشَمسُ طالِعَةً","فَالجِرمُ في فَلَكٍ وَالضَوءُ في عَلَمِ",44,"م",1,0],["سِنَةٌ مِن كَرىً وَطَيفُ أَمانٍ","وَصَحا القَلبُ مِن ضَلالٍ وَهَجسِ",45,"س",1,0],["سُنونٌ تُعادُ وَدَهرٌ يُعيد","لَعَمرُكَ ما في اللَيالي جَديد",46,"د",1,1],["سُنَنٌ كانَت وَنَظمٌ لَم يَزَل","وَفَسادٌ فَوقَ باعِ المُصلِحين",47,"ن",1,0],["سَنَنتَ اِعتِدالَ الدَهرِ في أَمرِ أَهلِهِ","فَباتَ رَضِيّاً في دَراكَ وَباتوا",48,"ت",3,0],["سُنَّةُ اللَهِ في المَمالِكِ مِن قَب","لُ وَمِن بَعدِ ما لِنُعمى بَقاءُ",49,"ا",2,0],["سِنانٌ في قَناةِ بَني مَعَدٍّ","بَني أَسَدٍ إِذا دَعوا النِزالا",50,"ل",2,0],["سَنِيُّ العَطايا لَو رَأى نَومَ عَينِهِ","مِنَ اللُؤمِ آلى أَنَّهُ لا يُهَوِّمُ",51,"م",1,0],["سنحتْ فأوثقتِ القلوبَ عيونُها","إن العيونَ حبائِلُ العُشَّاقِ",52,"ق",1,0],["سِنانُ أَميرِ المُؤمِنينَ وَسَيفُهُ","وَسَيبُ أَميرِ المُؤمِنينَ وَنائِلُه",53,"ل",2,0],["سَنامُ أَبانٍ في الحَمالَةِ تامِكٌ","وَظَهرُ مَنافٍ في الحَمالَةِ أَجزَلُ",54,"ل",1,0],["سَنَحنَحُ اللَيلُ كَأَنّي جَنّي","أَستَقبِلُ الحَربَ بِكُلِّ فَنِّ",55,"ن",1,0],["سَنَصيرُ أَيضاً مِثلَهُم","عَمّا قَليلٍ هَكَذا",56,"ذ",2,0],["سَنَبينُ عَمّا نَحنُ فيهِ لِمَن","سَيَبينُ بَعدُ عَنِ الَّذي بِنّا",57,"ن",2,0],["سَنَرقيكَ بِالأَشعارِ حَتّى تَمَلَّها","فَإِنلَم تُفِق مِنها رَقَيناكَ بِالسُوَر",58,"ر",1,0],["سَنَّ المَواهِبَ وَالجِهادَ فَدَهرُهُ","يَومانِ يَومُ قِرىً وَيَومُ قِراسِ",59,"س",1,0],["سَناهُ كَالنارِ يَجلو كُلَّ مُظلِمَةٍ","وَالبَأسُ كَالنارِ يُفني كُلَّ مُجتَرِمِ",60,"م",1,0],["سَناً وَسَناءً إِذ تَشابَهتُما سِنّا","سَجَنتِ فُؤادي حينَ حَرَّمتِ زَورَتي",61,"ي",1,0],["سنة مضت وختا