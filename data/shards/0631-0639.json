للَهُ عَهداً لِلصِبا لَيسَ يُرتَجى","وَأَخبارُهُ مَتلُوَّةٌ تُتَشَوَّقُ",174,"ق",1,0],["رُع بِجَيشِ اللَذاتِ سِربَ الشُجونِ","وَخُذِ الكَأسَ رايَةً بِاليَمينِ",175,"ن",1,1],["رَعَيتُ لِحاظي في جَمالِكَ آمِناً","فَأَذهَلَني عَن مَصدَرٍ حُسنُ مَورِدِ",176,"د",1,0],["رَعَت مَدفَعَ السوبانِ سِتّينَ لَيلَةً","حَراماً بِها حَتّى أَحَلَّت شُهورُها",177,"ر",3,0],["رَعى شَهرَينِ بِالدَيرِ","قِباباً كَالطَواميرِ",178,"ر",1,1],["رَعَينَ كَما شِئنَ الرَبيعَ سَوارِحاً","يَخُضنَ كَلُجِّ البَحرِ بَقلاً وَأَعشابا",179,"ب",2,1],["رُعْتَ الأوابِدَ في الفَدافِدِ فجأةً","بعَجارِفِ الرَّدَيانِ والوَخَدانِ",180,"ن",1,0],["رعى اللّهُ إبراهيمَ مِنْ مِلكٍ حَنا","على المُلكِ حانِيهِ وأشفَقَ مُشفِقُه",181,"ق",2,0],["رُعتُهُ يَوماً وَقَد نا","مَ بِقَرعِ الجُلجُلَينِ",182,"ن",1,1],["رَعَت غيبَةً عَنهُ وَأَضحى بِغَيبِهِ","لَقىً لِلمَنايا بَينَ دِعصَينِ مُفرَدا",183,"د",2,0],["رَعى وَرَعَينَ الرَطبَ تِسعينَ لَيلَةً","عَلى أَبَقٍ وَالرَوضُ تَجري مَذانِبُه",184,"ب",2,0],["رَعى الرَوضَ حَتّى نَشَّتِ الغُدرُ وَاِلتَوَت","بِرِجلاتِها قيعانُ شَرجٍ وَأَيهَبُ",185,"ب",1,0],["رَعَت قَبلُ نِبتاً جَدَّ عَدنانَ وَاِعتَرَت","إِياداً فَأَبلَت مِن قَبائِلِها بُردا",186,"د",2,0],["رَعى اللَهُ قَوماً مَضى دَهرُهُم","وَما فيهُمُ أَحَدٌ يَهزِلُ",187,"ل",1,0],["رُعتَ العدوَّ فَما مثُلتَ لهُ","إلا تفزَّعَ منكَ في الحُلمِ",188,"م",1,0],["رعى اللَه شعباً أَهملته رعاتُه","وملكاً كبيراً ركنه متزعزع",189,"ع",1,0],["رَعى اللَه بيروتاً ومن كان نازِلاً","ببيروت أَو كانَت له تلك مولدا",190,"د",2,0],["رعى اللَه ربعاً كان بالأمس عامراً","بأهليه وهو اليوم قفر معطَّل",191,"ل",1,0],["رَعى اللَهُ مَن فارَقتُ يَومَ فِراقِهِم","حُشاشَةَ نَفسٍ وَدَّعَت يَومَ وَدَّعوا",192,"ع",3,1],["رعاة شاءٍ وتجار مال","كالرّسْل في هذا وفي كمال",193,"ل",1,0],["رعوا على اليقظة ثم ناموا","فأصبحت للأسد الأغنام",194,"م",1,0],["رَعْياً لمُؤْتَمَنٍ رَعَى","فينَا الحَدايِثَ والقَدايِمْ",195,"م",1,0],["رُعناهُمُ بِالخَيلِ تَردي بِالقَنا","وَبِكُلِّ أَبيَضَ صارِمٍ فَصّالِ",196,"ل",1,0],["رَعَى اللَّهُ يَوْماً قَرَّبَتْنِي سُعُودُهُ","إِلَى سُدَّةٍ تَأْوِي إِلَيْهَا الأَمَاثِلُ",197,"ل",1,0],["رَعَيْتُ بِهَا حَقَّ الْوِدَادِ عَلَى النَّوَى","وَلِلْحَقِّ فِي حُكْمِ الْبَصِيرَةِ مَقْطَعُ",198,"ع",1,0],["رَعَتْكَ عُيونُ اللّهِ يَا ابْنَ محَمدٍ","كَمَا أَنْتَ ترْعَانَا ورَائِدُكَ الْبرُّ",199,"ر",1,0],["رَعَى اللهُ مِنْ بِيضِ الغَوَانِي عَشِيرَةً","تمَرَّسْنَ بِالأَعْمَالِ خَيْرَ تَمَرُّسِ",200,"س",1,0],["رَعَيْتُمُ لِبَنِي مِصْرَ قَرَابَتَهُمْ","كَمَا عَطَفْتُمْ عَلَى الجَرْحَى وَإِنْ بَعدُوا",201,"د",3,0],["رَعَى اللهُ ذَاكَ العَهدَ فَالعَيشُ بَعدَهُ","وُجُومٌ عَلَى أَيَّامِهِ وَوَجِيبُ",202,"ب",1,0],["رَعْياً لِمَجْهُودِي وَفِي شَرْعِ الْهَوَى","يُرْعَى القُصُورُ وَيُكْرَهُ الإِقْصَارُ",203,"ر",1,0],["رَعَاكَ اللهُ من نَجْمٍ بَهِيجٍ","بطلعِتَه وصانَكَ أَنْ تَغِيبَا",204,"ب",2,0],["رَعَاكِ اللهُ يَا فَخْرَ الغَوانِي","بِطَارِفِهَا وَتالِدِهَا اللُّبَابِ",205,"ب",1,0],["رَعَاهَا اللهُ جَامِعَةً أَدَالتْ","لَنَا عِزّاً مِنَ العَهْدِ المُذِيلِ",206,"ل",1,0],["رَعَاكَ اللّهُ مِنْ فَارُوقَ يُمْنٍ","أَدَالَ بِهَا السُّعُودَ مِنَ النُّحُوسِ",207,"س",1,0],["رَعَى الله أُمّاً أَنْجَبْتْهمْ وَثَقَّفَتْ","خَلاَئِقَهمْ لَمْ تَأْلُ يَوْماً عَنِ الْجُهْدِ",208,"د",1,0],["رَعى اللَهُ طَيفاً مِنكُمُ باتَ مُؤنِسي","فَما ضَرَّهُ إِذ باتَ لَو كانَ يُصبِحُ",209,"ح",1,0],["رَعى اللَهُ مَن يَهوى هَوايَ وَإِنَّني","عَلى العَهدِ باقٍ لا سُلُوّ وَلا غَدرُ",210,"ر",1,0],["رَعى الحُقوقَ الَّتي أَوصَتهُ فِهرُ بِها","فَسوّدوهُ وَقالوا مِثلَها نوصي",211,"ي",1,0],["رعيَّةُ الشعر قد أصبَحْتَ راعِيهَا","والشعرُ دولته من أكرم الدول",212,"ل",1,0],["رعى الله من يرعى العهود على السنوى","فلست تراه عن هواه بمقلع",213,"ع",1,0],["رعى الله قطرا أطعلعتك سماؤه","وبورك في مولى كريم وفي عبد",214,"د",1,0],["رعى الله ركبا أطلع الصبح مصفرا","بمرآك من فوق الربا والأباطح",215,"ح",1,0],["رعايهُ جدّك نثور النَّبي","وبيتُ الالهِ وأركانه",216,"ن",2,0],["رعى الله أُم الحُسن \" دَرْبندَ \" إنَّنا","وجدنا بها روضاً من الصفو مُمرِعا",217,"ع",2,0],["رعيت به الآمال والنسر طائر","إلى أن تبدى الفجر والنسر واقع",218,"ع",1,0],["رُعاة اللَّيْل كُونُوا كَيْفَ شِئْتُمْ","فقد أودي بي الحب المناح",219,"ح",1,0],["رَعَى الله مَنْ تُلْقي الرّعِيّةُ أنسَهَا","إلى ذيّهِ مِنْ دُونِهَا، وَدِفَاعِهِ",220,"ع",2,0],["رَعَتِ الرّعيّةُ مَرْتَعاً بكَ حَابساً،","وَثَنَتْ بظلٍّ، في ذُرَاكَ، ظَلِيلِ",221,"ل",1,0],["رَعَيْنَا بهِ السّعدانَ إذْ رَطِبَ الثْرَى","لَنَا، وَوَرَدْنا مِنْ نَدى كفّه صَدّا",222,"د",2,0],["رَعَيْتَ أمَانَةً مِنْهُ وَنُصْحاً،","وَأنْتَ مُوَفَّقٌ في الإخْتِبارِ",223,"ر",1,0],["رَعَتْهُ صُدُورَ التَّلْعِ فَنَّاءُ كَمْشَة","ٌ بِحَزْمِ رِضَامٍ بَيْنَهُنَّ شُرُوجُ",224,"ج",1,0],["رعى هذا الأنام فكان ذئباً","أحصَّوما وما الذئاب وما الدعاء",225,"ا",2,0],["رعاة الشعب طاع لههم فأمسى","بواد من سياستهم جديب",226,"ب",1,0]]}