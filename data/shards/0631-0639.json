],[45,"عَلِقنا بأسبابِ الوَزِيرِ، وَلمْ نَجِدْ","https://www.poetsgate.com/ViewPoem.aspx?id=32926",""],[45,"حَذَرْتُ الحُبّ، لَوْ أغْنى حِذاري","https://www.poetsgate.com/ViewPoem.aspx?id=31337",""],[38,"على الدّارِ بالرمانتينِ تعوجُ","https://www.poetsgate.com/ViewPoem.aspx?id=21138",""],[51,"ألم ترَ لابنِ بلبلَ إذ حماني","https://www.poetsgate.com/ViewPoem.aspx?id=26050",""],[105,"أمنك الذكر يعصف بالقلوب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55038&r=&rc=208",""]],"verses":[["رَعى اللَهُ مَن وَدَّعَتهُ يَومَ دابِقٍ","وَوَلَّيتُ أَنهى الدَمعَ ماكانَ جارِيا",0,"ي",2,0],["رَعَت ذُروَةً فيكُم ضُحىً جاشِرِيَّةٌ","فَأَجشَرتُ في أَوطانِكُم وَأَعاها",1,"ا",3,0],["رَعانا بِالقَنا وَلَقَد تَرانا","وَأَضبَعُ ما نَكونُ إِذا رُعينا",2,"ن",2,0],["رَعَينَ بِها شولَ الرِماحِ كَأَنَّها","غَداةَ الوَغى في بارِضٍ وَجَليلِ",3,"ل",1,0],["رَعى اللَهُ مَن فارَقتُ مِن غَيرِ رَغبَةٍ","عَلى الوَجدِ مِنّي وَالسِقامِ المُطابِقِ",4,"ق",1,0],["رَعَت حُلِيَّ رامَةٍ وَشاطَرَت","جَوازِيَ الرَملِ بِها لَعاعَها",5,"ع",3,0],["رَعاكَ بِلَحظِ طَرفٍ غَيرِ رانٍ","وَعاجَ عَليكَ سَمعاً غَيرَ واعِ",6,"ع",1,0],["رَعوا تَلَعاتِ هَذا المَجدِ لَسّاً","بِأَنيابِ العَوامِلِ وَاِنتِشاطا",7,"ط",2,0],["رَعاها بِهَمٍّ لا يَمَلُّ وَهِمَّةٍ","إِذا نامَ عَنها حارِسٌ قامَ حارِسُ",8,"س",1,0],["رَعابيبُ مِن نُمَيرٍ","جَلابيبُها تَضوعُ",9,"ع",1,0],["رَعى اللهُ نَفْساً بَيْنَ بُرْدَيَّ مُرَّةً","على أَيِّ خَطْبٍ لَيْسَ يُلْقَى جِرانُها",10,"ن",3,0],["رَعى اللهُ نَفْسي ما أَشَدَّ اصْطبارَها","وَلو طَلَبَتْ غَيْرَ العُلا ما تَعَنَّتِ",11,"ت",1,1],["رَعاهُ ضَمانُ اللهِ هَلْ في بِلادِكمْ","أَخْو كَرَمِ يَرْعَى لِذي حَسَبٍ عَهْدا",12,"د",2,0],["رَعى حُرُماتِ المَجْدِ فيَّ تكرُّماً","وقد شدّ عَزمي للمَسيرِ قِبالي",13,"ي",1,0],["رَعَيْتَ ذِمامَ الدّينِ بالعَدْلِ بَعدَما","أُضيعَ ولَمْ يَحْمِ الرّعيّةَ سائِسُ",14,"س",1,0],["رَعابيبُ يُحمى سِرْبُهُنَّ بغِلْمَةٍ","يَشُمُّ بِهِمْ أنْفُ المُكاشِحِ مَرْغَما",15,"م",2,0],["رُعناهُمُ بِالخَيلِ تَردي بِالقَن","وَبِكُلِّ أَبيَضَ صارِمٍ فَصّالِ",16,"ل",1,0],["رَعَى اللهُ مَنْ يرْعَى العُهودَ على النّوى","فلَسْتَ تَراهُ عنْ هَواهُ بمُقْلِعِ",17,"ع",1,0],["رَعَى اللهُ عَهْداً فِي رِضَاكَ وَمَأْلَفاً","مُلُوكُ الْعُلَى تُعْنَى بِهِ وَتُقِيمُهُ",18,"م",2,0],["رَعْيُ الرَّسَائِلِ شَأْنُهُ","فِي الْبُعْدِ أَوْ رَعْيُ الوَسَائِلْ",19,"ل",1,0],["رَعَى اللَّهُ قَلْبِي مَا أَتَمَّ وَفَاءَهُ","إِذَا نَزَحَتْ دَارٌ وَبَانَ خَلِيلُ",20,"ل",1,0],["رَعى اللهُ راعي الشّاءِ ما شاءَ إنّهُ","تَعاطى فلمّا اجْتازَ فرصَتَهُ عقَرْ",21,"ر",1,1],["رعى اللهُ مَسْراها الكريمَ فجلَّ ما","جلَتْهُ منَ البُشْرى وأبْدَتْ منَ البِشْرِ",22,"ر",1,0],["رعَى اللهُ منْها ليْلَة أطْلَعَ الهُدى","على الأرضِ منْ آفاقِها القَمَر السّعْدا",23,"د",2,0],["رَعى اللهُ قُطْراً أطْلَعَتْكَ سَماؤُهُ","وبورِكَ في مَوْلىً كريمٍ وفِي عبْدِ",24,"د",1,0],["رَعَشَتْ كَواكِبُ جوِّها فكأنّها","وَرِقٌ تُقَلِّبُها بَنانُ شَحيحِ",25,"ح",1,0],["رَعى اللهُ رَكْباً أطْلعَ الصُّبْحَ مُسْفِراً","بمَرْآكَ منْ فَوْقِ الرُّبى والأباطِحِ",26,"ح",1,0],["رَعَوْا لرَسولِ اللهِ حَقَّ وَصاتِهِ","فذاعَتْ بهِمْ في المُسْلِمينَ النّصائِحُ",27,"ح",1,0],["رَعى اللهُ أجْراعَ الحِمَى دارَ صَبْوَتي","ومرْبَعَ أُلاّفي ومعْهَدَ إيناسي",28,"س",2,0],["رُعبوبَةٌ فُنُقٌ خُمصانَةٌ رَدَحٌ","قَد أُشرِبَت مِثلَ ماءِ الدُرِّ إِشرابا",29,"ب",2,0],["رِعالاً كَأَمثالِ الجَرادِ لِخَيلِهِم","عُكوبٌ إِذا ثابَت سَريعٌ نُزولُها",30,"ل",3,0],["رَعى الرَوضَ وَالوَسمِيَّ حَتّى كَأَنَّما","يَرى بِيَبيسِ الدَوِّ إِمرارَ عَلقَمِ",31,"م",1,0],["رَعَيتَ جَمالَ الدينِ ثُمَّ اِصطَفَيتَهُ","فَأَصبَحَ في أَفياءِ جاهِكَ يَرتَعُ",32,"ع",1,0],["رَعى اللَهُ شَعباً جَمَّعَ العَدلُ شَملَهُ","وَتَمَّت عَلى عَهدِ الرَشادِ رَغائِبُه",33,"ب",2,0],["رَعياً لِشاعِرِكُم رَعياً لِكاتِبِكُم","جَزاهُما اللَهُ عَنّي ما يَقولانِ",34,"ن",1,0],["رَعى اللَهُ أَيّاماً تَقَضَّت بِقُربِكُم","وَعَصرَ الصِبى يا حَبَّذا ذاكَ مِن عَصرِ",35,"ر",1,0],["رَعى اللَهُ قَوماً في دِمَشقَ أَعزَّةً","عَلَيَّ وَإِن لَم يَحفَظوا عَهدَ مَن ظَعَن",36,"ن",1,1],["رَعى اللَهُ يَوماً فيهِ أَشكو صَبابَتي","وَأَجفانُ عَيني بِالدُموعِ شَواهِدُ",37,"د",1,0],["رَعَى اللهُ الَّتِي كَتَبَتْ لَتُرْضِي","بِنَفْسٍ حُرَّةٍ وَيَدٍ طَلِيقَهْ",38,"ق",2,0],["رَعَى اللهُ يَوْماً فِي دِمَشْقَ جَلالَنَا","بَشَائِرَ فَجْرٍ مِنْ صَلاحٍ وَعُمْرَانِ",39,"ن",1,0],["رِعَايَةٌ سَنَّهَا حَقُّ الْبِلادِ عَلَى","كِرَامِهَا فَرَأَوْهَا أَوْجَبَ السُّنَنِ",40,"ن",1,0],["رَعَيْتُمونِي وَدَارِي شُقَّةٌ قُذَفٌ","فَلَمْ أَزَلْ وَاجِداً أَهْلِي وَخُلاَّنِي",41,"ي",1,0],["رَعَتْ بَنِيهَا وَلَمْ تُغْفِلْ كَرَائِمَهَا","فَنَشَّأَتْهُمْ عَلَى تَقْوَى وَإِيْمَانِ",42,"ن",1,0],["رَعَى أَمْرَ اتِّحَادِهِمُ اسْتِشْراقاً","وَلَكِنْ فَضْلُهُ الفَضْلُ الصَّمِيمُ",43,"م",1,0],["رَعَى الإِلهُ مَلِيكاً جُلُّ بُغْيَتِهِ","أَنْ يُعْلِي الحَقَّ أَوْ أَنْ يَكْشِفَ الغُمَمَا",44,"م",2,0],["رَعَاكَ اللهُ مِنْ رَاعِي نُفُوسٍ","بِإِحْسَانٍ وَمَنْ هَادِي حُلُومِ",45,"م",1,0],["رَعَاهُ الله لَيْلاً مِنْهُ ذُقْنَا","نَعِيمَ السُّهُدِ وَالرُّقْبَاءُ نَامُوا",46,"م",3,0],["رَعَتْهُ بِإِسْعَادٍ عِنَايَةُ رَبِّهِ","وَجَادَتْ ثَرَى ذَاكَ الفَقِيدِ المَرَاحِمُ",47,"م",1,0],["رَعَت واحِفاً فَالجَزعَ حَتّى تَكَمَّلَت","جُمادى وَحَتّى طارَ عَنها نَسيلُها",48,"ل",3,0],["رَعَت بِأَرضِ البُهمى جَميماً وَبُسرَةً","وَصَمعآءَ حَتّى آنَفَتها نِصالُها",49,"ل",3,0],["رَعَت مُشرِفاً فَالأَحبُلَ العُفرَ حَولَهُ","إِلى رِمثِ حُزوى في عَوازِبَ أُبَّلِ",50,"ل",1,0],["رَعى مُهرَاقَ المُزنِ مِن حَيثُ أَدجَنَت","مَرابيعُ دَلوِيَّاتِهِنَّ النَواضِحُ",51,"ح",1,0],["رَعَت في فَلاةِ الأَرضِ حَتّى كَأَنَّها","مِنَ الضُمرِ خَطِّيُّ مِنَ السُمرِ مُصلَحُ",52,"ح",1,0],["رَعى مَوقِعَ الوَسمِيِّ حَيثُ تَبَعَّقَت","عَزالي السَواحي وَاِرثَعَنَّت هَواضِبُه",53,"ب",2,0],["رعى الله مني عاشقاً متقنعاً","بزهر حكى في الحسن خدَّ مؤنِّسِهْ",54,"س",2,0],["رعى الله زهراً ينتمي لقرنفل","حكى عَرْفَ من أهوى وإشراقَ خَدِّهِ",55,"د",2,1],["رعى الله لَيْلَى لو علمت طريقها","فرَشتُ لأخفاف المطيِّ بها خَدِّي",56,"د",2,0],["رعى الله بين الوادَيين مَواطناً","إذا ذُكرت يهتزّ بي نحوها عِشق",57,"ق",1,0],["رعى الله من أهل الفصاحة معشراً","لهم كان فوق الفَرقَدَيْن مَقيل",58,"ل",1,0],["رعى ورعت فلم تر قطّ منه","ولم ير قط منها ما يَريب",59,"ب",1,0],["رعى اللّه قوماً بالرُصافة كلما","تذكَّرتهم زاد الفؤاد نزاعا",60,"ع",2,0],["رعى الله حيّاً مستباحاً كأنه","من الذُعر أسراب النَعام المطرَّد",61,"د",1,0],["رِعانٌ أَجاً مِثلُ الفَوالِجِ دونَهُم","وَرَملٌ حَبَت أَنقاؤُهُ وَخَمائِلُه",62,"ل",2,0],["رَعَت مَنبِتَ الضَمرانِ مِن سَبَلِ المِعي","إِلى صُلبِ أَعيارٍ تُرِنُّ مَساحِلُه",62,"ل",2,0],["رَعَوهُ مَربَعاً وَتَصَيَّفوهُ","بِلا وَبَإٍ سُمَيَّ وَلا وَبالِ",63,"ل",1,0],["رَعاها مَصابَ المُزنِ حَتّى تَصَيَّفا","نِعافَ القَنانِ ساكِناً فَالأَجاوِلا",64,"ل",2,0],["رَعى خَرَزاتِ المُلكِ عِشرينَ حِجَّةً","وَعِشرينَ حَتّى فادَ وَالشَيبُ شامِلُ",65,"ل",1,0],["رَعَينَ فيهِ غَيرَ مَذعوراتِ","لُعاعَ وادٍ وافِرِ النَباتِ",66,"ت",1,0],["رَعاهُمُ اللَهُ ماناحَت مُطَوَّقَةٌ","وَحاطَهُم أَبَداً ما أَروَقَ السَلَمُ",67,"م",1,0],["رُعتُ القُلوبَ مَهابَةً","وَمَلَأتُها فَضلاً وَنُبلا",68,"ل",2,0],["رَعى اللَهُ أَوفانا إِذا قالَ ذِمَّةً","وَأَنفَذَنا طَعناً وَأَثبَتَنا قَلبا",69,"ب",2,0],["رعاكَ الله كمْ ترعى أمورِي","وتجمع فكرتِي بعدَ الشتات",70,"ت",1,1],["رعى الله أيامَ المؤيد إنها","أحقّ وأولى بالثناءِ المؤيد",71,"د",1,0],["رعى الله دهراً كنت فارسَ لهوه","أروح إلى وصلِ الأحبةِ أو أغدو",72,"د",2,0],["رعى خلقه ربُّ العبادِ وخُلقه","فحسَّنَ ما يخفى لديه وما يبدو",72,"د",2,0],["رعى ليَ في الملكِ المؤيد ذمةً","ولم ينس لي فيه قصيداً ومقصدا",73,"د",2,0],["رعى الله من جاورت في مصر بابه","فقابلني بالمالِ والجاهِ والودّ",74,"د",1,1],["رعى الله بحراً فوق أرجا بحيرةٍ","تكاد تحاكي بسط يمناه بالندى",75,"د",2,1],["رعى الله للعلياءِ قطبَ سيادةٍ","يدورُ عليه كلّ علمٍ وسؤدد",76,"د",1,1],["رعاك الله دارِكْ شكوَ عبدٍ","تمسّك منك بالعدل السفير",77,"ر",1,0],["رعى الله أيام المؤيد إنَّها","ولا برحتْ فينا مواسم للدهر",78,"ر",1,0],["رعاكَ الله من بحرٍ أجادت","بديهةُ فكرِهِ نظمَ البحور",79,"ر",1,0],["رعى الله أوقاتاً تقضَّت بصاحبٍ","موازين لفظي في الوَلاء بحفظه",80,"ه",1,1],["رعى الله أيامَ المؤيد إننا","وجدنا بها أهل المقاصد قد رُعوا",81,"ع",3,0],["رعا الله أيام الإمام محمدٍ","فكم نعمٍ رُدَّت إليَّ شراف",82,"ف",1,0],["رعاك الله راجع فيَّ رأياً","ولا تدحض حقوق فتىً موالي",83,"ي",1,0],["رعي