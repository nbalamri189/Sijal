{"poems":[[74,"فتانة الصب تجلى في حماه فيا","https://www.aldiwan.net/poem19558.html","البسيط"],[53,"يا سائلي عن مجمع اللذات","https://www.aldiwan.net/poem66780.html","الرجز"],[87,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[68,"نم بسر الروض خفق الرياح","https://www.aldiwan.net/poem41356.html","الرجز"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[78,"يا مليحة الدعج","https://www.aldiwan.net/poem39467.html","المقتضب"],[159,"والهوى لا خفت عاذلتي","https://www.aldiwan.net/poem55745.html","المديد"],[201,"يا نديمي في صبايا","https://www.aldiwan.net/poem39869.html","مجزوء الرمل"],[302,"من لحزين كلف موجع","https://www.aldiwan.net/poem32973.html","السريع"],[519,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[580,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38950","الرمل"],[1264,"","https://poetry.dctabudhabi.ae/diwan/poem/105522","الرجز"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112766","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77744","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49585","السريع"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95386","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2027,"","https://poetry.dctabudhabi.ae/diwan/poem/101858","الرجز"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71065","الكامل"],[2212,"","https://poetry.dctabudhabi.ae/diwan/poem/202381","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88651","المنسرح"],[2365,"","https://poetry.dctabudhabi.ae/diwan/poem/34714","الرمل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60870","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91437","السريع"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91724","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123494","السلسلة"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81709","الكامل"],[4378,"","https://poetry.dctabudhabi.ae/diwan/poem/99844","الخفيف"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123852","السريع"],[5045,"النفس وأهوائها","https://www.poetsgate.com/ViewPoem.aspx?id=184900",""],[5064,"ليلٌ حاتِميٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=199087",""],[5092,"سحائبُ عشق","https://www.poetsgate.com/ViewPoem.aspx?id=139681",""],[5273,"العود","https://www.poetsgate.com/ViewPoem.aspx?id=28768",""],[5431,"عشقٌ بكليَّ قد ظفر !","https://www.poetsgate.com/ViewPoem.aspx?id=184890",""],[5431,"كأن قبلته للثغر إمضاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=185586",""],[5652,"فقر وصندقه","https://www.poetsgate.com/ViewPoem.aspx?id=178103",""],[5691,"يوم يُبعثون","https://www.poetsgate.com/ViewPoem.aspx?id=206744",""],[5739,"مضيق الموق ..!","https://www.poetsgate.com/ViewPoem.aspx?id=135077",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"]],"verses":[["من لحظها وتثني غصن قامتها","لا تسألوا من فؤادي عن بلابله",0,"ل",2,0],["من لحم فروجٍ ولحم فَرخِ","يدورُ جوذابهما بالنَفْخِ",1,"خ",1,0],["مَن لِحَمراءَ جُلِّلَت بِغُبارِ ال","دَهرِ كَالجُرحِ بَينَ بُرءٍ وَنُكسِ",2,"س",1,0],["مِن لَحظِهِ يَسقي وَمِن لَفظِهِ","وَريقِهِ خَمراً حَلالاً مُباح",3,"ح",1,0],["مَنْ لِحَوَّاءَ أنها حملَتْ أحْ","مدَ أو أنها به نُفَسَاءُ",4,"ا",2,0],["مَنْ لِحُسْنِ وَجْهكِ مِنْ","سُوءِ فِعْلِكِ السَّمِجِ",5,"ج",1,0],["مَنْ لَحَاني عَنْ هَوَاهُ فَفي","وَجْهِهِ الفتَّانِ مَعْذِرَتي",6,"ت",2,0],["من لحون هتف الصي","فُ بها في أُمسياته",7,"ه",1,0],["من لحزينٍ كلِفٍ موجَعِ","قد شفَّه الشَوقُ إلى الأَربُعِ",8,"ع",1,1],["مِن لحظِها لا يصونُ القِرْنُ مهجتَهُ","ولا تُضَمُّ عليهِ البيضُ والسُّلُبُ",9,"ب",1,0],["من لحظِها السِّحرُ الحلالُ قد اسْتَحى","وبخدِّها الوردُ الجنيُّ قد انْفَتَح",10,"ح",1,0],["مَنْ لِحُسنِ الشّمسِ وَالبدرِ مَحا","بِجَمالٍ بارعٍ مُستَحسَنِ",11,"ن",1,0],["من لحنه سرت لذاذات الصبا","مسرى سلاف الراح بالمفاصل",12,"ل",1,0],["من لحزين قد جنا","يا خير عبد قد عفا",13,"ف",2,0],["من لحظها خمري ومن أَلفاظها","سكري وَمن نوناتها ترميني",14,"ن",2,0],["من لَحَظاتٍ لم يَزَلْ غُنْجُها","يَحْكُمُ بالجوْرِ على العَدْل",15,"ل",1,0],["من لحم ضأن نوعت أكلات","فالهبر منه طابت الكبّات",16,"ت",1,1],["من لحرب إذا نحته بحرب","يملك الحتف دونها أن نحاها",17,"ا",3,0],["من لحظه عضب ومن قامته","لدن ومن مسترسل الشعر",18,"ر",1,0],["من لحْمُهم لحْمُي ومن دمُهم دمي","ونِجارُهم في الانتسابِ نجاري",19,"ر",2,0],["مَنْ لحمُهم لحمي ومن دمُهم دمي","واليهمُ من بين يعرب إنتمى",20,"م",2,0],["من لحقوق عنيت انت بها","وهَل كَفيل سواك يكفلها",21,"ل",3,0],["مِن لُحومٍ في دِماءٍ","وارِداتٍ شارِعات",22,"ت",1,0],["مِنْ لحمكم لحمي ومِنْ دَمِكم دمي","وعلى محبتكم أموتُ وأُحْشرُ",23,"ر",1,0],["من لحظك الفتانِ هل لي أَمانْ","يا من سبى منا ثباتَ الجَنانْ",24,"ن",1,1],["من لحظه الساجي تعلمت الظُّبى","جرحَ القُلوب ففقن كلَّ رقاق",25,"ق",1,0],["من لحظ عينيه أوار الشرار","ولبه للبطش بالقوم ثار",26,"ر",1,0],["من لحظك فوّقت للمحب سهاما","لم تخط فكانت لمن أحب بمرصاد",27,"د",1,0],["مِنْ لَحْظِهِ لَحْظُ الشَّقيق ولفظهُ","إنْ خاطب العشَّاق لفظُ المُغْلِظِ",28,"ظ",1,0],["من لحمل العظيم والدفع والنف","ع ومن للقريب وللبعيد",29,"د",1,1],["من لحاظها والخد والثغر وال","راحات دارت بيننا كأس راح",30,"ح",1,0],["من لحنها صغت فني وابتني انسي","ويهيم قلبي مع دقات مغناها",31,"ا",3,0],["مَنْ لِحُزْنٍ إِنْ لَمْ تُطِقْهُ عيُونِي","مَنْ لِدَمْعٍ إِنْ لَمْ أَكُنْ مِنْدِيلَهْ",32,"ل",2,0],["مِنْ لحظةِ الصمتِ التي أخشاها","أطلقتُ بوحي سارحاً برؤاها",33,"ا",3,1],["مِنْ لحنِكَ صُغْتَ لنا صُوَراً","للعشقِ وليستْ كالصُّوَرِ",34,"ر",1,0],["من لحظكم رعد الفؤا","دُ تعشقاً ثم انهمرْ",35,"ر",1,0],["من لحْظِه انفتحتْ أبوابُ جنّتنا","فالنورُ منسكبٌ والوُدُّ لألاءُ",36,"ا",2,0],["من لحمنا ياموطني والقسى شاش","منهو يحس بضيقنا وإنكماشه ..!!",37,"ش",2,0],["مَنْ لحتّى ركْبَتيْهِ مَنْ إلى","تحتِ إبْطيْهِ ومَنْ للمِفْرَق ِ",38,"ق",1,0],["من لحون الحزن يشفع لك لحن.","غنّته ذكراك ....! ببيوت ٍ ثمينه.",39,"ن",2,0],["من لحواء أَنَّها جملت أَح","مَد أَو أَنَّها به نفساء",40,"ا",2,0]]}