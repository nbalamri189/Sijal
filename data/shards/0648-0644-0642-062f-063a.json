{"poems":[[3,"طال الثواء على رسوم المنزل","https://www.aldiwan.net/poem107.html",""],[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[9,"أوصلت صرم الحبل من","https://www.aldiwan.net/poem21910.html","مجزوء الكامل"],[9,"أجبير هل لأسيركم من فادي","https://www.aldiwan.net/poem21925.html","الكامل"],[95,"بقي الذكر والرغام فني","https://www.aldiwan.net/poem11249.html","الخفيف"],[53,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[31,"الكاملبان الشباب وربما عللته","https://www.aldiwan.net/poem6029.html","الكامل"],[64,"هذا الزمان يزف أبكار العلى","https://www.aldiwan.net/poem52319.html","الطويل"],[47,"إني لفعلك يا محمد حامد","https://www.aldiwan.net/poem63455.html","الكامل"],[2,"أخبرت أن أبا الحويرث قد","https://www.aldiwan.net/poem25006.html","الكامل"],[51,"نادت بوشك رحيلك الأيام","https://www.aldiwan.net/poem63112.html","الكامل"],[51,"أين القرون بنو القرون","https://www.aldiwan.net/poem63124.html","مجزوء الكامل"],[107,"إن جل غنم المسلمين بخيبر","https://www.aldiwan.net/poem44059.html","الكامل"],[54,"ولقد غدوت على طمر قارح","https://www.aldiwan.net/poem26716.html","الكامل"],[54,"ولقد غدوت على طمر","https://www.aldiwan.net/poem27191.html","مجزوء الكامل"],[54,"جار هذا الدهر أو آبا","https://www.aldiwan.net/poem27301.html","المديد"],[50,"خلق الشباب وشرتي لم تخلق","https://www.aldiwan.net/poem64445.html","الكامل"],[48,"جهل مرامي أن تكون موافقي","https://www.aldiwan.net/poem22489.html","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62235","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16641","الكامل"],[92,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[31,"بان الشّبابُ، ورُبّما عَلّلْتُهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17433&r=&rc=6",""],[147,"شرف المعالي من يساجلك العلى","https://www.aldiwan.net/poem11790.html","الكامل"],[147,"خير الأنام لشرهم إحكاما","https://www.aldiwan.net/poem11817.html","الكامل"],[235,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[288,"عاد الشمقمق في الخسارة","https://www.aldiwan.net/poem44310.html","مجزوء الكامل"],[304,"عوجوا فحيوا أيها السفر","https://www.aldiwan.net/poem45485.html","أحذ الكامل"],[304,"أفد الرحيل وليته لم يأفد","https://www.aldiwan.net/poem45492.html","الكامل"],[357,"أترع الأكواب من صافي الشراب","https://www.aldiwan.net/poem40771.html","الرمل"],[372,"لا يمنعنك من بغاء الخير","https://www.aldiwan.net/poem1881.html","مجزوء الكامل"],[375,"نظر الغرام إليه من نظراته","https://www.aldiwan.net/poem56923.html","الكامل"],[381,"عج بالحمى يا راكب الوجناء","https://www.aldiwan.net/poem66977.html","الكامل"],[410,"لو جادهن غداة رمن رواحا","https://www.aldiwan.net/poem50194.html","الكامل"],[433,"حيا الحيا لحدا ثواه جرجس","https://www.aldiwan.net/poem40513.html","الكامل"],[436,"بين اللوى فالجزع فالمتثلم","https://www.aldiwan.net/poem12473.html","الكامل"],[441,"لك ذروة المجد الذي لا يرتقى","https://www.aldiwan.net/poem2535.html","الكامل"],[464,"أي الخطوب من الزمان أزل","https://www.aldiwan.net/poem15110.html","الكامل"],[464,"خل التغزل للمشوق المغرم","https://www.aldiwan.net/poem15296.html","الكامل"],[467,"لندى يديك ويمن رأيك","https://www.aldiwan.net/poem3314.html","عموديه"],[486,"ولقد غضبت لخندف ولقيسها","https://www.aldiwan.net/poem2072.html","الكامل"],[565,"قف بالعقيق وسل نسيم رياحه","https://www.aldiwan.net/poem52903.html","الكامل"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/216934",""],[795,"","https://poetry.dctabudhabi.ae/diwan/poem/122172","الكامل"],[870,"","https://poetry.dctabudhabi.ae/diwan/poem/31478","الكامل"],[1163,"","https://poetry.dctabudhabi.ae/diwan/poem/28927","الكامل"],[1168,"","https://poetry.dctabudhabi.ae/diwan/poem/75858","الكامل"]],"verses":[["وَلَقَد غَدَوتُ أَمامَ رايَةِ غالِبٍ","يَومَ الهَياجِ وَما غَدَوتُ بِأَعزَلِ",0,"ل",1,0],["وَلَقَدْ غَفَرْتَ ذُنُوبَ دَهْرِي كُلَّهَا","حَتَّى الْمَشِيبَ وَذَنْبُهُ لاَ يُهْمَلُ",1,"ل",1,0],["وَلَقَد غَبَنتُ الكاعِبا","تِ أَحَظُّ مِن تَخبابِها",2,"ب",3,0],["وَلَقَد غَدَوتُ لِعازِبٍ مُستَحلِسِ ال","قَربانِ مُقتاداً عِنانَ جَوادِ",3,"د",1,0],["وَلَقَدْ غَامَرَ الخُطُوبَ فَلَمْ","بيهِ مِنْ بَأُسِهَا وَلَمْ يَهِنِ",4,"ن",1,0],["ولقد غدا مَدْحي لقومٍ زائناً","ولقد غدَوْتُ له بنيلِك زائنا",5,"ن",2,0],["وَلَقَد غَدَوتُ عَلى التِجارِ بِمِسمَحٍ","هَرَّت عَواظِلُهُ هَريرَ الأَكلُبِ",6,"ب",1,0],["ولقد غدوتُ وللضِجاجِ إقامةٌ","عندي كظلِّ الطير حين تَنَقَّلا",7,"ل",2,0],["وَلَقَد غَدَوتَ أَخاً وَرُحتَ بِرَأفَةٍ","وَحِياطَةٍ حَتّى كَأَنَّكَ والِدُ",8,"د",1,0],["وَلَقَد غَدَوتُ عَلى القَنيصِ بِسابِحٍ","مِثلِ الوَذيلَةِ جُرشُعٍ لَأمِ",9,"م",1,0],["وَلَقَد غَنيتَ مِنَ الشَبابِ بِغِبطَةٍ","وَلَقَد كَساكَ وَقارَهُ الإِسلامُ",10,"م",1,0],["وَلَقَد غَنوا في عيشَةٍ","لَيسَت لِأَنفَسِهِم بِدونِ",11,"ن",1,0],["ولقد غَنيتِ وَدُونَ ما تَجدِينَهُ","دُنيا مُذمَّمةٌ وَدِينٌ مُنْكَرُ",12,"ر",1,0],["وَلَقَد غَدَوتُ عَلى طِمِرٍ قارِحٍ","عَقَدَت حَوافُرُهُ غَمامَةَ قَسطَلِ",13,"ل",1,1],["وَلَقَد غَدَوتُ عَلى طِمِر","رٍ مُشرِقِ الحَجَباتِ",14,"ت",1,1],["وَلَقَد غادَيتُ مُترَعَةً","لَم تَشِم في خُلُقي عابا",15,"ب",2,0],["وَلَقَد غَدَوتُ بِدُستُبانٍ مُعلَمٍ","صَخِبِ الجَلاجِلِ في الوَظيفِ مُسَبَّقِ",16,"ق",1,0],["وَلَقَد غَدَوتُ بِأُمَّةٍ وَبِإِمَّةٍ","قَزميَّتَينِ وَهِمَّةٍ مِن عادِ",17,"د",1,0],["ولَقَدْ غَدَوْتُ عَلَى الجَزُورِ بِفِتْيَةٍ","كُرَمَاءَ حَضْرَةَ لَحْمِهَا أَزْوَالِ",18,"ل",1,0],["ولقد غَصَبْتُ اللّيْلَ أحسَنَ شُهْبِه","ونظَمْتُها عِقْداً لأحْسَنِ لابِس",19,"س",1,0],["ولقد غَلوتُ فكمْ يقلبي خاطرٌ","عَجزتْ مَعاني الشعر عن تمثيله",20,"ل",2,0],["ولقدْ غدوتُ على التجارِ بمسمحٍ","هرَتْ عواذلُهُ هَرِيرَ الأكْلُبِ",21,"ب",1,0],["وَلَقَد غَنيتَ عَنِ اللِواءِ بِقامَةٍ","طالَت فَطُلتَ بِها الوَشيجَ الذُبَّلا",22,"ل",2,0],["وَلَقَد غَمَرتَ المُذنِبينَ صَنائِعاً","عَلَتِ الثَناءَ وَجازَرِ الإِنعاما",23,"م",2,0],["وَلَقَد غَدا الدّوسي مِنهُ مُزَوَّداً","خَمسينَ وِسقاً في رِضى الرَّحمَنِ",24,"ن",1,0],["وَلَقد غَدَوتُ وَلَيسَ لي","إِلّا مَديحُكَ مِن تِجاره",25,"ر",2,0],["وَلَقَد غَدَوتُ وَما يُفَزِّعُني","خَوفٌ أُحاذِرُهُ وَلا ذُعرُ",26,"ر",1,0],["وَلَقَد غَدَوتُ رَأَيَّ أَفتُنِ دَهرِهِ","يَرجو الفَتى في العَيشِ ما لَم يَفتَدِ",27,"د",1,0],["وَلَقَد غَنّى فَأَغنانا عَن الن","ناي وَالعود وَهند وَالرَباب",28,"ب",1,0],["ولقد غدوت وكنت لا","أغدو على واقٍ وحاتِمْ",29,"م",1,0],["ولَقد غَدا يلتذُّ أيامَ الهَوى","جَهلاً بأنَّ المَوتَ مِن لذَّاتِهِ",30,"ت",2,0],["وَلَقَد غَرَستُ بها مُنايَ لأَجتني","ثَمَرَ النَجاة فلا تَني بِوَفائي",31,"ي",1,0],["وَلَقَد غَدَوتَ أَبا الحُسَين لِجَيشِهِ","لِلقَلبِ قَلباً وَالجَناح جَناحا",32,"ح",2,0],["ولقد غدا لما قضى إذ أرخوا","ابدءاً بروضات النعيم منعما",33,"م",2,0],["ولقد غدوتُ بما أتَتْهُ مُديةٌ","من فعلِ جاني أنعُمٍ لا مجرمِ",34,"م",1,0],["ولقد غفرت إساءة الزمن الذي","أصبحت من حسناته متحققا",35,"ق",2,0],["ولقد غدا ورد الفضائل منكم","حصبا بفضلكم وكان مرنّقا",35,"ق",2,0],["ولقد غَنيتِ عن اللَّوائم بالقِلى","وكفاكِ منعَ حِماكِ أنكِ باخلُ",36,"ل",1,0],["ولقد غَرِضْتُ من الزمانِ كأنما","صَدَأٌ أقامَ على فِرِنْدِ المِخْذمِ",37,"م",1,0],["ولقد غنيت وكيف لا","يغنى مليٌّ من ولايك",38,"ك",1,0],["وَلَقَد غَضِبتُ لِخندِفٍ وَلِقَيسِها","لَمّا وَنى عَن نَصرِها خُذّالُها",39,"ل",3,1],["ولَقَدْ غَزَتْ قلبي الهُمومُ بجَيْشها","دهراً فكانَ الصبرُ خيرَ سِلاحهِ",40,"ح",2,0],["ولقدْ غَدَوْتُ بِمُشْرَحفْ","فِ الشَّدِّ في فِيْهِ اللِّجَامُ",41,"م",1,1],["ولقد غَدَوتُ وكُنتُ لا","أغدو على واقٍ وحائِم",42,"م",1,0],["وَلَقَد غَدَوتُ وَصاحِبي وَحشِيَّةٌ","تَحتَ الرِداءِ بَصيرَةٌ بِالمُشرِفِ",43,"ف",1,0],["ولقد غدوتُ على القنيصِ وصاحبي","نَهدٌ مراكِلُهُ مِسحٌ جُرشُعُ",44,"ع",1,0],["ولقد غُبطتُ بما ألاقي حقبةً","ولقد يمرُّ عليَّ يوم أشنع",44,"ع",1,0],["وَلَقَد غَدَوتُ عَلى القَنيصِ بِشَيظَمٍ","كالجِذعِ وَسطَ الجَنَّةِ المَغروسِ",45,"س",1,0]]}