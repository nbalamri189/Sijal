try.dctabudhabi.ae/diwan/poem/92007","الكامل"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/90050","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59456","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103039","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44669","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127120","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58012","الكامل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28927","الكامل"],[4502,"","https://poetry.dctabudhabi.ae/diwan/poem/75858","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72852","الكامل"],[4767,"سهم الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=180942",""],[1012,"فتح جعلان","https://www.poetsgate.com/ViewPoem.aspx?id=124501",""],[5431,"العين (ع)","https://www.poetsgate.com/ViewPoem.aspx?id=205592",""],[5672,"عم الوباء","https://www.poetsgate.com/ViewPoem.aspx?id=213759",""],[402,"بقي الذكر والرغام فني","https://www.poetsgate.com/ViewPoem.aspx?id=36474",""],[5790,"أهواه أسمر في اعتدال الأسمر","https://www.poetsgate.com/ViewPoem.aspx?id=112056",""],[5790,"قد رأيناك والغزالة تسنح","https://www.poetsgate.com/ViewPoem.aspx?id=111949",""],[5809,"الآسر والأسير","https://www.poetsgate.com/ViewPoem.aspx?id=205653",""],[6134,"بزغت شموس السعد بالشهباء","https://www.poetsgate.com/ViewPoem.aspx?id=169525",""],[2588,"يا بعلبك عروسة البلدان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83217&r=&rc=165",""]],"verses":[["وَلَقَد غَدَوتُ أَمامَ رايَةِ غالِبٍ","يَومَ الهَياجِ وَما غَدَوتُ بِأَعزَلِ",0,"ل",1,0],["وَلَقَدْ غَفَرْتَ ذُنُوبَ دَهْرِي كُلَّهَا","حَتَّى الْمَشِيبَ وَذَنْبُهُ لاَ يُهْمَلُ",1,"ل",1,0],["وَلَقَد غَبَنتُ الكاعِبا","تِ أَحَظُّ مِن تَخبابِها",2,"ب",3,0],["وَلَقَد غَدَوتُ لِعازِبٍ مُستَحلِسِ ال","قَربانِ مُقتاداً عِنانَ جَوادِ",3,"د",1,0],["وَلَقَدْ غَامَرَ الخُطُوبَ فَلَمْ","بيهِ مِنْ بَأُسِهَا وَلَمْ يَهِنِ",4,"ن",1,0],["ولقد غدا مَدْحي لقومٍ زائناً","ولقد غدَوْتُ له بنيلِك زائنا",5,"ن",2,0],["وَلَقَد غَدَوتُ عَلى التِجارِ بِمِسمَحٍ","هَرَّت عَواظِلُهُ هَريرَ الأَكلُبِ",6,"ب",1,0],["ولقد غدوتُ وللضِجاجِ إقامةٌ","عندي كظلِّ الطير حين تَنَقَّلا",7,"ل",2,0],["وَلَقَد غَدَوتَ أَخاً وَرُحتَ بِرَأفَةٍ","وَحِياطَةٍ حَتّى كَأَنَّكَ والِدُ",8,"د",1,0],["وَلَقَد غَدَوتُ عَلى القَنيصِ بِسابِحٍ","مِثلِ الوَذيلَةِ جُرشُعٍ لَأمِ",9,"م",1,0],["وَلَقَد غَنيتَ مِنَ الشَبابِ بِغِبطَةٍ","وَلَقَد كَساكَ وَقارَهُ الإِسلامُ",10,"م",1,0],["وَلَقَد غَنوا في عيشَةٍ","لَيسَت لِأَنفَسِهِم بِدونِ",11,"ن",1,0],["ولقد غَنيتِ وَدُونَ ما تَجدِينَهُ","دُنيا مُذمَّمةٌ وَدِينٌ مُنْكَرُ",12,"ر",1,0],["وَلَقَد غَدَوتُ عَلى طِمِرٍ قارِحٍ","عَقَدَت حَوافُرُهُ غَمامَةَ قَسطَلِ",13,"ل",1,1],["وَلَقَد غَدَوتُ عَلى طِمِر","رٍ مُشرِقِ الحَجَباتِ",14,"ت",1,1],["وَلَقَد غادَيتُ مُترَعَةً","لَم تَشِم في خُلُقي عابا",15,"ب",2,0],["وَلَقَد غَدَوتُ بِدُستُبانٍ مُعلَمٍ","صَخِبِ الجَلاجِلِ في الوَظيفِ مُسَبَّقِ",16,"ق",1,0],["وَلَقَد غَدَوتُ بِأُمَّةٍ وَبِإِمَّةٍ","قَزميَّتَينِ وَهِمَّةٍ مِن عادِ",17,"د",1,0],["ولَقَدْ غَدَوْتُ عَلَى الجَزُورِ بِفِتْيَةٍ","كُرَمَاءَ حَضْرَةَ لَحْمِهَا أَزْوَالِ",18,"ل",1,0],["ولقد غَصَبْتُ اللّيْلَ أحسَنَ شُهْبِه","ونظَمْتُها عِقْداً لأحْسَنِ لابِس",19,"س",1,0],["ولقد غَلوتُ فكمْ يقلبي خاطرٌ","عَجزتْ مَعاني الشعر عن تمثيله",20,"ل",2,0],["ولقدْ غدوتُ على التجارِ بمسمحٍ","هرَتْ عواذلُهُ هَرِيرَ الأكْلُبِ",21,"ب",1,0],["وَلَقَد غَنيتَ عَنِ اللِواءِ بِقامَةٍ","طالَت فَطُلتَ بِها الوَشيجَ الذُبَّلا",22,"ل",2,0],["وَلَقَد غَمَرتَ المُذنِبينَ صَنائِعاً","عَلَتِ الثَناءَ وَجازَرِ الإِنعاما",23,"م",2,0],["وَلَقَد غَدا الدّوسي مِنهُ مُزَوَّداً","خَمسينَ وِسقاً في رِضى الرَّحمَنِ",24,"ن",1,0],["وَلَقد غَدَوتُ وَلَيسَ لي","إِلّا مَديحُكَ مِن تِجاره",25,"ر",2,0],["وَلَقَد غَدَوتُ وَما يُفَزِّعُني","خَوفٌ أُحاذِرُهُ وَلا ذُعرُ",26,"ر",1,0],["وَلَقَد غَدَوتُ رَأَيَّ أَفتُنِ دَهرِهِ","يَرجو الفَتى في العَيشِ ما لَم يَفتَدِ",27,"د",1,0],["وَلَقَد غَنّى فَأَغنانا عَن الن","ناي وَالعود وَهند وَالرَباب",28,"ب",1,0],["ولقد غدوت وكنت لا","أغدو على واقٍ وحاتِمْ",29,"م",1,0],["ولَقد غَدا يلتذُّ أيامَ الهَوى","جَهلاً بأنَّ المَوتَ مِن لذَّاتِهِ",30,"ت",2,0],["وَلَقَد غَرَستُ بها مُنايَ لأَجتني","ثَمَرَ النَجاة فلا تَني بِوَفائي",31,"ي",1,0],["وَلَقَد غَدَوتَ أَبا الحُسَين لِجَيشِهِ","لِلقَلبِ قَلباً وَالجَناح جَناحا",32,"ح",2,0],["ولقد غدا لما قضى إذ أرخوا","ابدءاً بروضات النعيم منعما",33,"م",2,0],["ولقد غدوتُ بما أتَتْهُ مُديةٌ","من فعلِ جاني أنعُمٍ لا مجرمِ",34,"م",1,0],["ولقد غفرت إساءة الزمن الذي","أصبحت من حسناته متحققا",35,"ق",2,0],["ولقد غدا ورد الفضائل منكم","حصبا بفضلكم وكان مرنّقا",35,"ق",2,0],["ولقد غَنيتِ عن اللَّوائم بالقِلى","وكفاكِ منعَ حِماكِ أنكِ باخلُ",36,"ل",1,0],["ولقد غَرِضْتُ من الزمانِ كأنما","صَدَأٌ أقامَ على فِرِنْدِ المِخْذمِ",37,"م",1,0],["ولقد غنيت وكيف لا","يغنى مليٌّ من ولايك",38,"ك",1,0],["وَلَقَد غَضِبتُ لِخندِفٍ وَلِقَيسِها","لَمّا وَنى عَن نَصرِها خُذّالُها",39,"ل",3,1],["ولَقَدْ غَزَتْ قلبي الهُمومُ بجَيْشها","دهراً فكانَ الصبرُ خيرَ سِلاحهِ",40,"ح",2,0],["وَلَقَد غالَني يَزيدُ وَكانَت","في يَزيدٍ خِيانَةٌ وَمَغالَه",41,"ل",2,0],["ولقد غدا من بعد ذلك حرفةً","لهمُ بها يسترزقُ المعسورُ",42,"ر",1,0],["وَلَقَد غَنيتُ بِطيب تُربةِ طَيبةٍ","عَن كُل مَغنىً فيهِ جم غَواني",43,"ي",1,1],["ولقد غدا منه بجوهرة العلى","صدفاً ليوم الحشر لم يستبق",44,"ق",1,0],["ولقدْ غَدَوْتُ بِمُشْرَحفْ","فِ الشَّدِّ في فِيْهِ اللِّجَامُ",45,"م",1,1],["ولقد غذيت ولائكم","مذ كنت مستتراً جنينا",46,"ن",2,0],["ولقد غدا بين البرية والملا","كلٌّ اماماً منهم حسن الولا",47,"ل",2,0],["ولقد غرسْتُ المدحَ عندَهُمُ","طمعاً فحنظلَ ذلك الغرسُ",48,"س",1,0],["وَلَقَد غَدَونَ عَلى طُهيَّةِ غَدوَةٍ","حَتّى طَرَقنَ نِساءَنا بِنِساءِ",49,"ا",2,0],["وَلَقَد غَدَوتُ مِنَ البَيَانِ مُخوَّلاً","فِي حَيثُ أضحَى مِنهُ أَعوَزَ مُعوزِ",50,"ز",1,0],["ولقد غشى البيت الحرام كما","زار الشفيعَ فحجّ واعتمرَا",51,"ر",2,0],["وَلَقَد غَشيتِ لَنا رُسومَ مَنازِلٍ","بُدِّلنَ بَعدَ تَأَنُّسٍ إيحاشا",52,"ش",2,0],["ولقد غدا طاهي الفساد وانهُ","من طبخهِ لا شكّ يوماً يطعمُ",53,"م",1,0],["ولقد غدوت على الورى متأمِّراً","والجود غلاَّب عليك أمير",54,"ر",1,0],["ولقد غدوت إلى الوفود محجة","لحمى 