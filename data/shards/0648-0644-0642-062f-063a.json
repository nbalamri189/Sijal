{"poems":[[3,"طال الثواء على رسوم المنزل","https://www.aldiwan.net/poem107.html",""],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[9,"أوصلت صرم الحبل من","https://www.aldiwan.net/poem21910.html","مجزوء الكامل"],[9,"أجبير هل لأسيركم من فادي","https://www.aldiwan.net/poem21925.html","الكامل"],[93,"بقي الذكر والرغام فني","https://www.aldiwan.net/poem11249.html","الخفيف"],[51,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[29,"الكاملبان الشباب وربما عللته","https://www.aldiwan.net/poem6029.html","الكامل"],[62,"هذا الزمان يزف أبكار العلى","https://www.aldiwan.net/poem52319.html","الطويل"],[45,"إني لفعلك يا محمد حامد","https://www.aldiwan.net/poem63455.html","الكامل"],[2,"أخبرت أن أبا الحويرث قد","https://www.aldiwan.net/poem25006.html","الكامل"],[49,"نادت بوشك رحيلك الأيام","https://www.aldiwan.net/poem63112.html","الكامل"],[49,"أين القرون بنو القرون","https://www.aldiwan.net/poem63124.html","مجزوء الكامل"],[105,"إن جل غنم المسلمين بخيبر","https://www.aldiwan.net/poem44059.html","الكامل"],[52,"ولقد غدوت على طمر قارح","https://www.aldiwan.net/poem26716.html","الكامل"],[52,"ولقد غدوت على طمر","https://www.aldiwan.net/poem27191.html","مجزوء الكامل"],[52,"جار هذا الدهر أو آبا","https://www.aldiwan.net/poem27301.html","المديد"],[48,"خلق الشباب وشرتي لم تخلق","https://www.aldiwan.net/poem64445.html","الكامل"],[46,"جهل مرامي أن تكون موافقي","https://www.aldiwan.net/poem22489.html","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16641","الكامل"],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[29,"بان الشّبابُ، ورُبّما عَلّلْتُهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17433&r=&rc=6",""],[143,"شرف المعالي من يساجلك العلى","https://www.aldiwan.net/poem11790.html","الكامل"],[143,"خير الأنام لشرهم إحكاما","https://www.aldiwan.net/poem11817.html","الكامل"],[231,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[284,"عاد الشمقمق في الخسارة","https://www.aldiwan.net/poem44310.html","مجزوء الكامل"],[300,"عوجوا فحيوا أيها السفر","https://www.aldiwan.net/poem45485.html","أحذ الكامل"],[300,"أفد الرحيل وليته لم يأفد","https://www.aldiwan.net/poem45492.html","الكامل"],[353,"أترع الأكواب من صافي الشراب","https://www.aldiwan.net/poem40771.html","الرمل"],[368,"لا يمنعنك من بغاء الخير","https://www.aldiwan.net/poem1881.html","مجزوء الكامل"],[371,"نظر الغرام إليه من نظراته","https://www.aldiwan.net/poem56923.html","الكامل"],[377,"عج بالحمى يا راكب الوجناء","https://www.aldiwan.net/poem66977.html","الكامل"],[406,"لو جادهن غداة رمن رواحا","https://www.aldiwan.net/poem50194.html","الكامل"],[429,"حيا الحيا لحدا ثواه جرجس","https://www.aldiwan.net/poem40513.html","الكامل"],[432,"بين اللوى فالجزع فالمتثلم","https://www.aldiwan.net/poem12473.html","الكامل"],[437,"لك ذروة المجد الذي لا يرتقى","https://www.aldiwan.net/poem2535.html","الكامل"],[461,"أي الخطوب من الزمان أزل","https://www.aldiwan.net/poem15110.html","الكامل"],[461,"خل التغزل للمشوق المغرم","https://www.aldiwan.net/poem15296.html","الكامل"],[464,"لندى يديك ويمن رأيك","https://www.aldiwan.net/poem3314.html","عموديه"],[483,"ولقد غضبت لخندف ولقيسها","https://www.aldiwan.net/poem2072.html","الكامل"],[562,"قف بالعقيق وسل نسيم رياحه","https://www.aldiwan.net/poem52903.html","الكامل"]],"verses":[["وَلَقَد غَدَوتُ أَمامَ رايَةِ غالِبٍ","يَومَ الهَياجِ وَما غَدَوتُ بِأَعزَلِ",0,"ل",1,0],["وَلَقَدْ غَفَرْتَ ذُنُوبَ دَهْرِي كُلَّهَا","حَتَّى الْمَشِيبَ وَذَنْبُهُ لاَ يُهْمَلُ",1,"ل",1,0],["وَلَقَد غَبَنتُ الكاعِبا","تِ أَحَظُّ مِن تَخبابِها",2,"ب",3,0],["وَلَقَد غَدَوتُ لِعازِبٍ مُستَحلِسِ ال","قَربانِ مُقتاداً عِنانَ جَوادِ",3,"د",1,0],["وَلَقَدْ غَامَرَ الخُطُوبَ فَلَمْ","بيهِ مِنْ بَأُسِهَا وَلَمْ يَهِنِ",4,"ن",1,0],["ولقد غدا مَدْحي لقومٍ زائناً","ولقد غدَوْتُ له بنيلِك زائنا",5,"ن",2,0],["وَلَقَد غَدَوتُ عَلى التِجارِ بِمِسمَحٍ","هَرَّت عَواظِلُهُ هَريرَ الأَكلُبِ",6,"ب",1,0],["ولقد غدوتُ وللضِجاجِ إقامةٌ","عندي كظلِّ الطير حين تَنَقَّلا",7,"ل",2,0],["وَلَقَد غَدَوتَ أَخاً وَرُحتَ بِرَأفَةٍ","وَحِياطَةٍ حَتّى كَأَنَّكَ والِدُ",8,"د",1,0],["وَلَقَد غَدَوتُ عَلى القَنيصِ بِسابِحٍ","مِثلِ الوَذيلَةِ جُرشُعٍ لَأمِ",9,"م",1,0],["وَلَقَد غَنيتَ مِنَ الشَبابِ بِغِبطَةٍ","وَلَقَد كَساكَ وَقارَهُ الإِسلامُ",10,"م",1,0],["وَلَقَد غَنوا في عيشَةٍ","لَيسَت لِأَنفَسِهِم بِدونِ",11,"ن",1,0],["ولقد غَنيتِ وَدُونَ ما تَجدِينَهُ","دُنيا مُذمَّمةٌ وَدِينٌ مُنْكَرُ",12,"ر",1,0],["وَلَقَد غَدَوتُ عَلى طِمِرٍ قارِحٍ","عَقَدَت حَوافُرُهُ غَمامَةَ قَسطَلِ",13,"ل",1,1],["وَلَقَد غَدَوتُ عَلى طِمِر","رٍ مُشرِقِ الحَجَباتِ",14,"ت",1,1],["وَلَقَد غادَيتُ مُترَعَةً","لَم تَشِم في خُلُقي عابا",15,"ب",2,0],["وَلَقَد غَدَوتُ بِدُستُبانٍ مُعلَمٍ","صَخِبِ الجَلاجِلِ في الوَظيفِ مُسَبَّقِ",16,"ق",1,0],["وَلَقَد غَدَوتُ بِأُمَّةٍ وَبِإِمَّةٍ","قَزميَّتَينِ وَهِمَّةٍ مِن عادِ",17,"د",1,0],["ولقد غَصَبْتُ اللّيْلَ أحسَنَ شُهْبِه","ونظَمْتُها عِقْداً لأحْسَنِ لابِس",18,"س",1,0],["ولقد غَلوتُ فكمْ يقلبي خاطرٌ","عَجزتْ مَعاني الشعر عن تمثيله",19,"ل",2,0],["ولقدْ غدوتُ على التجارِ بمسمحٍ","هرَتْ عواذلُهُ هَرِيرَ الأكْلُبِ",20,"ب",1,0],["وَلَقَد غَنيتَ عَنِ اللِواءِ بِقامَةٍ","طالَت فَطُلتَ بِها الوَشيجَ الذُبَّلا",21,"ل",2,0],["وَلَقَد غَمَرتَ المُذنِبينَ صَنائِعاً","عَلَتِ الثَناءَ وَجازَرِ الإِنعاما",22,"م",2,0],["وَلَقَد غَدا الدّوسي مِنهُ مُزَوَّداً","خَمسينَ وِسقاً في رِضى الرَّحمَنِ",23,"ن",1,0],["وَلَقد غَدَوتُ وَلَيسَ لي","إِلّا مَديحُكَ مِن تِجاره",24,"ر",2,0],["وَلَقَد غَدَوتُ وَما يُفَزِّعُني","خَوفٌ أُحاذِرُهُ وَلا ذُعرُ",25,"ر",1,0],["وَلَقَد غَدَوتُ رَأَيَّ أَفتُنِ دَهرِهِ","يَرجو الفَتى في العَيشِ ما لَم يَفتَدِ",26,"د",1,0],["وَلَقَد غَنّى فَأَغنانا عَن الن","ناي وَالعود وَهند وَالرَباب",27,"ب",1,0],["ولقد غدوت وكنت لا","أغدو على واقٍ وحاتِمْ",28,"م",1,0],["ولَقد غَدا يلتذُّ أيامَ الهَوى","جَهلاً بأنَّ المَوتَ مِن لذَّاتِهِ",29,"ت",2,0],["وَلَقَد غَرَستُ بها مُنايَ لأَجتني","ثَمَرَ النَجاة فلا تَني بِوَفائي",30,"ي",1,0],["وَلَقَد غَدَوتَ أَبا الحُسَين لِجَيشِهِ","لِلقَلبِ قَلباً وَالجَناح جَناحا",31,"ح",2,0],["ولقد غدا لما قضى إذ أرخوا","ابدءاً بروضات النعيم منعما",32,"م",2,0],["ولقد غدوتُ بما أتَتْهُ مُديةٌ","من فعلِ جاني أنعُمٍ لا مجرمِ",33,"م",1,0],["ولقد غفرت إساءة الزمن الذي","أصبحت من حسناته متحققا",34,"ق",2,0],["ولقد غدا ورد الفضائل منكم","حصبا بفضلكم وكان مرنّقا",34,"ق",2,0],["ولقد غَنيتِ عن اللَّوائم بالقِلى","وكفاكِ منعَ حِماكِ أنكِ باخلُ",35,"ل",1,0],["ولقد غَرِضْتُ من الزمانِ كأنما","صَدَأٌ أقامَ على فِرِنْدِ المِخْذمِ",36,"م",1,0],["ولقد غنيت وكيف لا","يغنى مليٌّ من ولايك",37,"ك",1,0],["وَلَقَد غَضِبتُ لِخندِفٍ وَلِقَيسِها","لَمّا وَنى عَن نَصرِها خُذّالُها",38,"ل",3,1],["ولَقَدْ غَزَتْ قلبي الهُمومُ بجَيْشها","دهراً فكانَ الصبرُ خيرَ سِلاحهِ",39,"ح",2,0]]}