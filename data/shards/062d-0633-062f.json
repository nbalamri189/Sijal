""],[4929,"حسِدتُ على حالي","https://www.poetsgate.com/ViewPoem.aspx?id=202438",""],[4954,"دعْني أنوحُ","https://www.poetsgate.com/ViewPoem.aspx?id=208896",""],[5038,"كم قريب","https://www.poetsgate.com/ViewPoem.aspx?id=189379",""],[3271,"وطن الفأس","https://www.poetsgate.com/ViewPoem.aspx?id=104126",""],[585,"أيها القصر أنت والبيت يشهد","https://www.poetsgate.com/ViewPoem.aspx?id=161899",""],[5183,"بطل المقامات","https://www.poetsgate.com/ViewPoem.aspx?id=186603",""],[5431,"((أني معك!))","https://www.poetsgate.com/ViewPoem.aspx?id=198345",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[5729,"أيا قلبي الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=203972",""],[5790,"يا بعيد الليل من سحره","https://www.poetsgate.com/ViewPoem.aspx?id=112061",""],[5848,"الطفل الصغير","https://www.poetsgate.com/ViewPoem.aspx?id=53455",""],[5956,"سقوط عداي","https://www.poetsgate.com/ViewPoem.aspx?id=185611",""],[5956,"ليتهم عانوا كما نلنا عناءا","https://www.poetsgate.com/ViewPoem.aspx?id=194196",""],[6052,"قبة الهادي","https://www.poetsgate.com/ViewPoem.aspx?id=34642",""],[6119,"ليس بيني وبين قومي إلا","https://www.poetsgate.com/ViewPoem.aspx?id=181288",""],[6235,"معزوفة الصدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77692&r=&rc=7",""]],"verses":[["حَسَدتُ عَليكَ الأَجنَبينَ مَحَبَّةً","وَنافَستُ فيكَ الأَبعَدينَ عَلى الوُدِّ",0,"د",1,0],["حَسَدوكَ لَمّا فاتَ سَعيُكَ سَعيَهُم","صُعُداً فَما نَقعَ الغَليلَ حَسودُ",1,"د",1,0],["حُسِدتُ عَلى أَنّي قَنِعتُ فَكَيفَ بي","إِذا ما رَمى عَزمي مَجالَ الكَواكِبِ",2,"ب",1,0],["حَسَدَتني نَظرَةً في وَجهِها","إِذ جَلَسنا فَاِستَحَثَّت لِلقِيام",3,"م",1,0],["حَسَدوا الفَتى إِذ لَم يَنالوا سَعيهُ","فَالقَومُ أَعداءٌ لَهُ وَخُصومُ",4,"م",1,1],["حَسَدَتكَ حينَ رَأَتكَ وَح","دَكَ ثُمَّ كَالفَلَكِ المُنيرِ",5,"ر",1,0],["حَسَدَتكَ في الأُفُقِ البُرو","قُ وَغارَ في الأَرضِ البُخار",6,"ر",1,0],["حسدت خطك الحلي من العس","جد حتى بدا عليها اصفرار",7,"ر",1,1],["حَسَداً أو سَقَتهُ أيدي المنايا","من حِمامِ الردى كؤوساً حِثاثا",8,"ث",2,0],["حَسَدَتْ قياناً كالظِّباءِ ونرجساً","غَضّاً على صُوَرٍ هناك صِبَاحِ",9,"ح",1,0],["حسداً لمن يمسي ويصبح حاملاً","كَتداهُ ما لا تحمل الأكتادُ",10,"د",1,0],["حسدوا أذكى وأزكى","أنفساً منهم وأتقى",11,"ق",2,0],["حسدي أنَّني أريدُ لنفسي","بعض أخلاقه بغير اكتتام",12,"م",1,0],["حسداً هاجَهُ على ثلب شعري","ولقائي معبِّساً غضبانا",13,"ن",2,0],["حُسِدَت عَلَيَّ مِنَ الإِنا","ثِ كَما حُسِدتُ مِنَ الذُكورِ",14,"ر",1,0],["حَسَدتُ كِتابي عَلى فَوزِهِ","بإِبصارهِ الغُرّةَ الزاهِرَهْ",15,"ه",1,1],["حسدَ القصرُ فيكمُ الزَهراءَ","ولعمري وَعمرُكُم ما أَساءَ",16,"ا",2,1],["حَسَدَ الإِنسانُ سِربَيهِ بِما","أوتِيا في ذُروَةِ العِزِّ اِعتِصاما",17,"م",2,0],["حسَدَ الفتَى لما تقاعسَ دونَهُ","وأبَى له قِصَرُ الزمانِ منالَهُ",18,"ل",2,0],["حَسَداً أَن تَكونَ إِلفاً لِغَيري","إِذ تَفَرَّدتُ بِالهَوى فيكَ وَحدي",19,"د",2,0],["حَسَداً في العُلا وَنما في جَميعِ ال","ناسِ أَبلى بِذي عُلاً مِن حَسودِه",20,"د",2,0],["حَسَدَت فِعلَكَ الكَريمَ عَلى المَج","دِ فَجارَت شَمائِلاً بِغُيومِ",21,"م",1,0],["حَسَدَت جودَ كَفِّكَ الأَمطارُ","فَغَدَت مِنكَ بَل عَلَيكَ تَغارُ",22,"ر",1,1],["حَسَدَت أُهَيلُ دِيارِ بَكرٍ مَنطِقي","فيها كَما حَسَدَ الهَزارَ اللَقلَقُ",23,"ق",1,0],["حَسَدَ الفاضِلُ المُماذِقُ فَضلي","فَهوَ لِلحالَتَينِ يُخفي وَيُبدي",24,"ي",1,1],["حَسَدٌ تَمَكَّنَ ذُلُّهُ مِن بُغضِكُم","في أَعيُنٍ وَمَعاطِسٍ وَشِفاهِ",25,"ه",1,0],["حَسَدُ القَرابَةِ لِلقَرابَةِ قَرحَةٌ","أَعيَت عَوانِدُها وَجُرحٌ أَقدَمُ",26,"م",1,0],["حَسَدٌ حُمِّلنَهُ مِن أَجلِها","وَقَديماً كانَ في الناسِ الحَسَد",27,"د",1,0],["حَسَدتُ الكَأسَ وَالإِبريقَ لَمّا","بَدا لِيَ مِن يَدَي رَخصِ البَنانِ",28,"ن",1,0],["حسداً إذ خُلقتَ من مارج النا","رِ لمن كان سيّد العالمينا",29,"ن",2,0],["حَسَدتُ عَلَيها كُلَّ شَيءٍ يَمَسُّها","وَما كُنتُ لَولا حُبُّها بِحَسودِ",30,"د",1,0],["حَسَدتَني حينَ أَصَبتُ الغِنى","ما كُنتَ إِلّا كَاِبنَ حَوّاءِ",31,"ا",2,0],["حسَدَتْهُ مَلْبَسَهُ البُزاةُ ومَن لها","لمّا نَعاهُ لها بلُبْسِ غُدافِ",32,"ف",1,0],["حسدته والقلبُ في ضيقه","أنا الذي لم أدرِ طعم الحسد",33,"د",1,0],["حَسَدوا فَقالوا شاعِرٌ أَو ساحِرٌ","وَمِنَ الحَسودِ يَكونُ الاِستِهزاءُ",34,"ا",2,0],["حَسَدُوكَ لَمْ يَعْفُوا أَخَاكَ وَإِنَّمَا","فَعَلُوا لِحِرْصٍ فِي الطَّبَِائِعِ غَالِبِ",35,"ب",1,0],["حسدتكَ الأنهارُ حين أتاها","أن آمونَ من هواك وطينك",36,"ك",1,0],["حسدت محاسنك الربى فتأوهت","غدرانها فى جفنها المغرورق",37,"ق",1,0],["حَسَدوني وَفيك أَيّ نَجيبٍ","لَم يَلِد قَطُّ مِثلهُ الأَقوامُ",38,"م",1,0],["حَسَدَت فيهِ المَنِيَّةُ حَتّى","حَصَدَت جَوهَرَهُ مِن مَنِيِّ",39,"ي",1,0],["حَسَدتها اليَومَ عَلَيها فَلَو","جادَت بِها وَفَّت لي الشَرطا",40,"ط",2,0],["حَسَدَ الزَمانُ معينهُ","حَتّى أَغارَ مَعينَهُ",41,"ن",2,1],["حُسِدتُ عَلَيهِ قاتَلَ اللَهُ حاسِدي","فَضَنَّ بِهِ الدَهرُ الَّذي كانَ يَسمَحُ",42,"ح",1,0],["حسدوك الملا وفضّلك اللَ","هُ بما فُضِّلَت به النجباء",43,"ا",2,1],["حسَداً حُمِّلنَهُ من شأنِها","وقديماً كان في الحب الحسَد",44,"د",1,0],["حسَدَ الدهرُ حسنَها فرماها","بسهامٍ من الكوارثِ عَمْدا",45,"د",2,0],["حسدٌ مُنيت به وهل","يخلو عظيم من حسود؟",46,"د",1,0],["حَسَدوكَ أنَّكَ دُسْتَ هامَهُمُ","مُتجبَّراً ولنَعْلِكَ الفَخْر",47,"ر",1,0],["حسد الزمان ليالياً","سَمَح الوصال بها فضن",48,"ن",1,0],["حَسَداًٌ في العُلا وَما في جَميعِ ال","نّاسِ أبلى بذي عُلا من حَسودِهْ",49,"د",2,0],["حسدوه على المزايا فكان ال","موت بين الأهواء والحقّ حدّا",50,"د",2,0],["حسد الدهر ساعة جمعتنا","ابغلزال الظريف بين الرياض",51,"ض",1,1],["حسدوه مذ كنتم له وتطاولوا","من لؤمهم حسداً لبغض خياله",52,"ل",2,0],["حَسَداً ما حَسَدتُ أُختي عَلَيهِ","رَبُّنا بَينَنا وَبَينَ سَعيدِ",53,"د",1,0],["حَسَدٌ كَحَرِّ النارِ مُنذُ عَراهُمُ","لازالَ غَصَّهُمُ بِبَردِ الماءِ",54,"ا",2,0],["حُسِدتُ على دَمعٍِ عليكَ أرَقتُهُ","وذَاكَ لأنَّ الحُبَّ بالسَّحِّ قد صَحَّا",55,"ح",2,0],["حَسَدَتْنا أَيَّامُنا بِالتَّلاقي","فَرَمَتْنَا تَعَسُّفاً بِالفِراقِ",56,"ق",1,1],["حسدَ المؤخرُ من تقدَّم قبلهُ","فتدافعوا حرصاً على الإِقدام",57,"م",1,0],["حسدتُ أذيالَ أثوابي وقد ظفِرَتْ","بشمِّ تُربتِها أذيالُ أثوابي",58,"ب",2,0],["حَسَدوهُ فَزَخرَفُوا فَرَمى ذُو ال","عَرشِ ما زَخرَفُوا بِسُوقِ الكَسادِ",59,"د",1,0],["حسدت على نظام الشعر بغيا","كما حسد المكاء على الصفير",60,"ر",1,1],["حَسَدتنيَ الأفلاكُ في أمداحهِ","في بَلدتيهِ أرومَتَي أفراحهِ",61,"ه",1,0],["حسَدوهُ واللؤمُ داءٌ قديمُ","فعليه الصلاة والتسليمُ",62,"م",1,0],["حَسدَ السماءُ الأرضَ منذ ولادته","أَسفاً عليه فأكرمت بوفادَتِه",63,"ه",1,0],["حَسَدتها كُدىً فلمّا اِستشاطت","هاجَ فيها الغواة والغوغاءُ",64,"ا",2,0],["حسدتْ نظيرتها فأسقمها الأسى","إن السقامَ علامةٌ في الحسَّدِ",65,"د",1,0],["حَسَدتُ سَوادَ عَيني حينَ أَضحى","لِذاكَ السالِفِ الفِضيِّ خالا",66,"ل",2,0],["حَسَدَت مَحَلَّتَها النُجومُ فَوَدَّ لَو","أَمسى يُجاوِرُها السِماكُ الأَعزَلُ",67,"ل",1,0],["حَسَدَت مَواهِبَكَ الغُيومُ لِأَنَّها","مِنها أَعَمُّ عَلى البِلادِ وَأَنفَعُ",68,"ع",1,0],["حَسَدوكَ حينَ رَأَوكَ أَمنَعَ جانِباً","وَأَعَزَّ سُلطاناً وَأَكرَمَ مَحتِدا",69,"د",2,0],["حُسدتُ على لَثم الشَّقيقِ بخدِّها","ورَشفِ رُضَابٍ لم أَزَل منه في سُكرِ",70,"ر",1,0],["حسَدتُك لما جنَتكِ ضحىً","أنامِلُ كادت تطير بِلُبّي",71,"ب",2,0],["حَسَدَتْها البيضُ تجلّيها","حُمْراً فغدتْ لك تختضِبُ",72,"ب",1,0],["حَسَدَت بَغدادُ دِمَشقَ عَلَي","كَ وَثَورَةُ حاسِدُها دِجلَه",73,"ل",2,0],["حَسَدَت دِمَشقَ عَلى مَقامِكُمُ بِها","بَغدادُ وَهيَ حِمى بَني العَبّاسِ",74,"س",1,0],["حَسَدَ الأَهِلَّةُ في السَماءِ نِعالَها","في الأَرضِ جاعِلَةَ البَعيدِ الأَقرَبا",75,"ب",2,0],["حسدت نسيم الروض في كل خالةٍ","ولا سيما قوم قطعناه بالحمى",76,"م",2,1],["حَسَدُ الصَديقِ صَديقَهُ","وَأَخاهُ مِن سُقمِ المَوَدَّه",77,"ه",1,0],["حسدت بِحار الشعر أَبحر كَفِّهِ","فَاِنشَقّ قَلب بَسيطه وَمَديدهِ",78,"د",2,0],["حَسَداً مِنْهمُ لِنَصٍّ","بهِ اللهُ أكرَمكْ",79,"ك",1,0],["حَسَدتمْ عليّاً على فَضْلِه","ومَن نالَ مَا نَالَهُ يُحْسَدِ",80,"د",1,0],["حسد السميع للفظه","من كان ذا سمع أصم",81,"م",1,0],["حسدت مناقبه الكواكبُ في العُلى","حتَّى رأيت البدر من حسَّاده",82,"د",2,0],["حسد الفاضل مثلما حسد الدريّ","منثور فارس ونظامه",83,"م",2,0],["حسدَتْهُ ذوو الرياسة طُرّاً","وكذا كل فاضلٍ محسودُ",84,"د",1,0],["حسدتني عصابة حين ألغت","موضعي منك رفعة واعتلاء",85,"ا",2,0],["حسدوك على أنوار علا","ك واين البدر من الحسد",86,"د",1,0],["حسدت حقا على فضل خصصت به","فليس لي عند ملك منكمُ سندُ",87,"د",1,0],["حسد واحقاد بها","يتفاخرون على المفاخر",88,"ر",1,0],["حَسَدَ الرجالُ عُلاك فازددْ يزددوا","واعذِر فلم يحسُدك غيرُ العاقلِ",89,"ل",1,0],["حسدوا إبايَ وعزّتي وهمُ","نهبى الهوان وأكلةُ الذلِّ",90,"ل",1,0],["حسد الكمالَ فظلَّ يقتله","يا ذلَّ مقتولٍ بلا عَقْلِ",90,"ل",1,0],["حسدوا فيه أباه خاب من","يحسُدُ الشمس على البدرِ وضلّ",91,"ل",1,0],["حسَد الحسودُ فما عدا أنيابَه","نكتاً عليك وقلبَه بلبالا",92,"ل",2,0],["حسدنَ مودةً فحملن إفكاً","وعِبنَ وعائبُ الحسناءِ يَفري",93,"ر",2,0],["حسدوا تقدُّمَ فضلكم فحقودُهم","لا تنطفِي وفسادُهم لا يَصلحُ",94,"ح",1,0],["حسد اللباسُ العبقري مقامها","من ماجدٍ في نُسكهِ مُتورِّعِ",95,"ع",1,0],["حسد الملوكُ مقامهُ فتسنَّموا","في ذروةٍ لولاهُ لم تُتوقَّلِ",96,"ل",1,0],["حَسدَ الطودُ مزايا حِلْمهِ","مثلما تحسدُ جَدْواهُ الدِّيمْ",97,"م",1,0],["حَسَداً على مَجْدِ الوزيرِ","بأنَّ كُلَّهُمُ تَميمُ",98,"م",1,0],["حسدتهُ مائسةُ القنا فوق النَّقا","فلأجلهِ رجفانُ كلُّ مثقف",99,"ف",1,0],["حسداً قاتلاً على الشَّرف العا","ديّ والسُّؤدد القديم الصراح",100,"ح",1,0],["حسدت مضاجعها الحليُّ فيها","قلق الوشاح وغصَّة الحجل",101,"ل",1,0],["حسدتْ قدَّكِ الغصون فلمَّا","بنتِ بانت رواقصاً تتثنَّى",102,"ن",2,0],["حسدت الكلب فيه وليس بدعا","فما حسدي له إلا لأمر",103,"ر",1,0],["حَسَدَ الوَلِيُّ الجاهِلُ","وهو الخَمولُ الغافِلُ",104,"ل",1,1],["حَسَدَ الصباحُ الليلَ لما ضَمَّنا","غَيظاً فَفَرَّقَ بيننا داعيه",105,"ي",2,0],["حسَدَتْ جُودَه فللبرقِ منها","نارُ حُزنٍ وأنّةٌ للرعودِ",106,"د",1,0],["حسدَ الهِلالُ به السِّوارَ فودّ أنْ","لو حالَ من بدَلِ الذِراعِ المِعصَما",107,"م",2,0],["حسدَتْ مدائِحَهُ النّجومُ فأوشكَتْ","تهوي لتَسْكُنَ ألسُنَ الشّعراءِ",108,"ا",2,0],["حسدت جوارحنا عليك عيوننا","إن العيون على جلالك تحسد",109,"د",1,0],["حسدت مظلتك النجوم لأنها","فلك على شمس الضحى ممدود",110,"د",1,0],["حسدت بساط الأرض فيك وما درت","أن السماء لها من الحساد",111,"د",1,0],["حسد السماك سميَّهُ لما بدا","في سرجه شخص الهمام الأبلج",112,"ج",1,1],["حسدت عليها ناظري إذ تحلّه","كما تحسد الأفلاك نعل فناخسرو",113,