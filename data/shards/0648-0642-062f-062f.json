ل"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105189","الوافر"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113834","البسيط"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35097","الطويل"],[4738,"طَوايا نِظامي في الزَّمانِ لها نَشرُ","https://www.poetsgate.com/ViewPoem.aspx?id=205737",""],[4478,"لئنْ أقمتُ بحيثُ الفيضُ في رجبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=15023",""],[592,"لله عيش تقضى بالمسرات","https://www.poetsgate.com/ViewPoem.aspx?id=128833",""],[5397,"تخادعك الدنيا وتبدي اغترارها","https://www.poetsgate.com/ViewPoem.aspx?id=157907",""],[5409,"وقفت فيك أحيي المجد والحسبا","https://www.poetsgate.com/ViewPoem.aspx?id=155255",""],[2215,"وعن حلب ما شئت من عجائبَ","https://www.poetsgate.com/ViewPoem.aspx?id=113139",""],[5582,"خَيالٌ سَرَى وَهْناً وَزارَ وِسادِي","https://www.poetsgate.com/ViewPoem.aspx?id=63489",""],[6102,"ظهيرة تحت رحمة الكهرباء","https://www.poetsgate.com/ViewPoem.aspx?id=184444",""],[6225,"إحياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78068&r=&rc=153",""]],"verses":[["وقد دَبَّ في كُتّابِهِمْ نَشْوَةُ الغِنى","وكُلُّهمُ جَعْدُ اليَدَيْنِ لَئيمُ",0,"م",1,0],["وقد دنَتْ منهُ حتّى أوْدَعَتْ أرَجاً","أحْناءَ سَرْجي أفاوِيهٌ منَ الطّيبِ",1,"ب",1,0],["وقد دَعاكَ أميرُ المؤمنينَ لَها","والهَمُّ مُنتَشِرٌ والعَزْمُ مَكدودُ",2,"د",1,0],["وقد درّعوها وهيَ ذات مؤصد","مَجوبٍ وَلَما يَلبَسِ الدِرعَ ريدُها",3,"د",3,0],["وَقَد دَمِيَت مَواقِعُ رُكبَتَيها","مِنَ التِبراكِ لَيسَ مِنَ الصَلاةِ",4,"ه",1,0],["وقد دَرَسُوا القُرآنَ وافتَلَجوا به","فَكُلُّهُم رَاضٍ بِهش مُتَحزِّبُ",5,"ب",1,0],["وَقَد دَرى الرومُ مُذ جاوَرتَ أَرضَهُمُ","أَن لَيسَ يَعصِمُهُم سَهلٌ وَلا جَبَلُ",6,"ل",1,0],["وَقَد دَلَّ دَليلُ الحُب","بِ أَنَّ القُربَ تَلبيسُ",7,"س",1,0],["وقد درى حين زال مطمعه","فيك بأي الدروع تدَّرع",8,"ع",1,0],["وقد دانتْ لطاعته فكانت","دجاجتَه وكان هناك ديكا",9,"ك",2,0],["وقد دَثَّرَتْهُ غيومُ المساءِ بظلٍّ","حزينٍ ضَريحٍ شفيفْ",10,"ف",1,0],["وقد دقت لك العو","د ومدّت بسط الفرس",11,"س",1,0],["وقد درعتْ ثوبَ الظلامِ نياقُهمْ","بكل فتىً يقظانَ عينِ العزائمِ",12,"م",1,0],["وقد دمِعَتْ أجفانُها وكأنها","جَنَى نرجسٍ فيه النَّدى يترقْرَقُ",13,"ق",1,0],["وَقَد دَفَعوا بُخلَ الزَمانِ بِجودِهِ","وَلا طِبَّ حَتّى يُدفَعَ الضِدُّ بِالضِدِّ",14,"د",1,0],["وَقَد دَأَبَت عِشرينَ يَوماً وَلَيلَةً","يُشَدُّ بِرِسغَيها إِلَيكَ خِدامُها",15,"م",3,0],["وَقَد دَمّى النَجيعُ هُناكَ أَرضاً","وَقَد شَمَلَ العَجاجُ بِهِ سَماءَ",16,"ا",2,0],["وَقَد دَرَسَت أَجسامُهُم وَدِيارُهُم","فَلَم أَرَ إِلّا أَقبُراً وَيَبابا",17,"ب",2,0],["وَقد دَعَتْ لكَ منِّي كُلُّ جَارِحَةٍ","وبالإِجابَةِ فَضْلُ اللَّهِ يُنْتَظَرُ",18,"ر",1,0],["وقد درى الغيث أن لو كان أشبههم","لشاب جودَهُم شيءٌ من البضخل",19,"ل",1,0],["وقد دُعيتَ إلى الهيجا فجِئتَ كما","جُؤجِئَتِ الشَّولُ بالفَحل الغُرَيريّ",20,"ي",1,0],["وَقَد دارَ ساقيها بِها ذا قُراطِقٍ","تُناطُ بِأَعلى ساعِدٍ وَبَنانِ",21,"ن",1,0],["وَقَد دُمنا عَلى سوءِ السَجايا","كَما دامَت قُرَيشُ عَلى الإِلافِ",22,"ف",1,0],["وقد دَقّتْ هَوادِيهِنّ حتى","كأنّ رقابَهُنّ الخَيْزرانُ",23,"ن",1,0],["وقَدْ دَقَّ مِنْهَا الخَصْرُ حَتَّى وِشَاحُهَا","يَجُولُ وقَدْ عُمَّ الخَلاَخِيلُ والقُلْبُ",24,"ب",1,1],["وقد دَنِسَتْ أعْطافُهُ من تَقادُمٍ","فخُذْ آسَ نارٍ لا يُسافُ فَداوه",25,"ا",3,0],["وقد دَمِيَتْ خَمْسٌ لها عَنَمِيّةٌ","بإدْمانِها في الأزْمِ شوْكَ سِيال",26,"ل",1,0],["وقد دَرَسَتْ نحوَ السُّرَى فهْي لَبّةٌ","بما كان من جَرّ البَعيرِ أوِ الرَّفْع",27,"ع",1,0],["وقَد دَخَلتُ عَلَى الحسناءِ كِلَّتَها","بَعد الهُدُوءِ تَضيءُ كالصَّنَمِ",28,"م",1,1],["وَقَد دَسَّت إِلَيَّ فَتاةَ قَومٍ","فَقالَت أَصفِني مَحضَ الوِصالِ",29,"ل",1,0],["وقد دفن القومُ التِّراتِ وأقبلوا","إلى الحقِّ يمحو ضوؤه كلَّ باطل",30,"ل",1,0],["وقد دَرَجَتْ مِنّا قُرُونٌ كَثيرَة ٌ،","ونَحنُ سنَمضِي بَعدَهنّ ونَدرُجُ",31,"ج",1,0],["وقد دانوا بأعظمهم نضالا","وعلما، لا بأجزلهم عيونا",32,"ن",2,0],["وقد دعا ناهيا فأسمعني","وخط على الرأس مخلس شعره",33,"ر",2,0],["وقد درى حين زال مَطمعُه","فيك بأيِّ الدرع تدَّرع",34,"ع",1,0],["وقد دعاك خائفاً","بلهف قلبٍ مضطرب",35,"ب",1,0],["وَقَد دَرَوا أَنَّهُم وَما وَهِموا","إِن نَكَّبوا عَن بِلادِهِم نُكِبوا",36,"ب",3,0],["وَقَد دَبَّ مِن أَقصى المَشارِقِ حَيَّةٌ","لَها لَدَغاتٌ لا تُداوى وَلا تُرقا",37,"ق",2,0],["وقد دهتني وأمرضتني","مهامهُ للهو والسراب",38,"ب",1,0],["وَقَد دَعَت بِأميلٍ طِفلَها عَجَلا","تَبغي لِقاهُ فَلَبّاها عَلى الأَثَرِ",39,"ر",1,0],["وقد دفعت إلى دهر أكافحهُ","أسقامهُ وتنال الحظوة الجيف",40,"ف",1,0],["وَقَد دوّنوا فيها مَذاهبَ غيّهم","وَفي ضِمنها دسّوا الدسائسَ وَالمَكرا",41,"ر",2,0],["وَقَد دَخلوا حزبَ المسونِ بهمّةٍ","بِها حلّ كلٌّ من محافلهِ الصدرا",41,"ر",2,0],["وَقَد درّبوا مِن شدّةِ الكفرِ وُلدَهَم","على بُغضهِ مِن حينِ شُربهمُ الدرّا",42,"ر",2,0],["وَقَد دَبِرَت ونُعمَانٌ صَبِيٌّ","وقَبلَ فِصَالِهِ تِلكَ اللَّيالي",43,"ل",2,0],["وَقَد دروع داود لبواس","تَكون من التباس البأس حصنا",44,"ن",2,0],["وَقَد دَبَّ بِخَدَّيهِ","عِذارٌ باسِطٌ عُذري",45,"ر",2,0],["وَقَد دَنا الفِطرُ وَصِبيانُنا","لَيسوا بِذي تَمرٍ وَلا أَرزِ",46,"ز",1,0],["وَقَد دَرَجَ الأَسلافُ مِن قَبلُ هَؤُلا","وَهَمتَهُم نَيلَ المَكارِمِ وَالفَضلِ",47,"ل",1,0],["وقد درَّعته الريح درعاً مزرَّداً","يجانسه ثوبُ الربيع المورَّد",48,"د",1,0],["وقد دعا الناس إلى ضدها","بمقول العسال والمشرفي",49,"ف",2,0],["وقد دَرَسَتْ آثارُهم وقبورُهم","كما دَرسوا فيها فليسَ لها أُثْرُ",50,"ر",1,0],["وقد دعوتُكَ مظلوماً ومُرتجياً","وفي يدَيكَ الغِنَى والعدلُ والخَلَفُ",51,"ف",1,0],["وقد دارت الأقداح بيني وبينه","وشمل الهوى ما بيننا يتألَّف",52,"ف",1,0],["وقد دَعَتْ للَّهو أبناءها","أوقاتَ أيَّام السُّرور القصار",53,"ر",1,0],["وقد دانت لك العياء حبا","فلم تجنح لغير علاك عمدا",54,"د",2,0],["وقد دعوتُك والأسماعُ مصغيةٌ","الى استماعِ جوابٍ منك جوّابِ",55,"ب",1,0],["وقد درى ان المراد وصله","عالى الجناب ابدا منيعه",56,"ع",2,0],["وقد دَرَى كل خابر زَكن","إِنَّ الرَّدى للأنام نهابُ",57,"ب",1,0],["وقد دلَّ حائلُ لونِ الشباب","على أنّ عمرَ الفتى حائلُ",58,"ل",1,0],["وقد دَرسَتْ إلا نشايا عواصفٌ","من الريح لم يَفطُنْ لهنّ هُبوبُها",59,"ب",3,0],["وقد دَرَسَتْ","سوى رسومٍ كَبُردِ الصَّبرِ اسمالِ",60,"ل",1,0],["وقد دَرَستْ إلا بقيةُ معهدٍ","على وَجَناتِ التربِ أخفى مِنَ الوشمِ",61,"م",1,0],["وقد دلنا القرآن في كل موطن","على مركز الأنوار إذ هو أوحد",62,"د",1,0],["وقَدْ دَعَا لِيَ خَيْرُ الْخَلْقِ أَحْمَدُ مَنْ","جاءَتْ بمدْحَتِهِ الآياتُ في السُّوَرِ",63,"ر",1,0],["وقد دام أسبوعُ السُّرور وكُحِّلَت","بطلعَتِك الغرَّاءِ أعيُنُه الرُّمدُ",64,"د",1,0],["وقد درى كلُّ ذي لُبٍّ بأنّهمُ","عزّوا وعمّا قليلٍ بالرّدى هانوا",65,"ن",3,0],["وَقَد درى الأقوامُ أَنّي اِمرؤٌ","أواصلُ الصدَّ عن السَّوْأَةِ",66,"ه",1,0],["وَقَد دَرى كلُّ مَن لَهُ بصَرٌ","أَنّك سُدتَ العجيم والعَرَبا",67,"ب",2,0],["وقد دخلوا بالملك في قلعة الأنا","فليس لهم عما يرومون دافع",68,"ع",1,0],["وقد دخلتم جنة عالية","قطوفها دانية اجتناء",69,"ا",2,0],["وقد دعاهم بغدير خم","فاجتمعوا إليه كي يسمّي",70,"ي",1,0],["وقد دعا لقولهم واحتجا","لما أتوه بعض من قد لجا",70,"ج",2,0],["وقد دخلتم كلكم في بيعته","فما الذي أوقفكم عن نصرته",70,"ه",1,0],["وقد دلفوا إليَّ بفعلِ سوءٍ","فألفوني لهم صعب القيادِ",71,"د",1,0],["وَقَدْ دَعَوْتُكَ أَرْجُو مِنْكَ مَكْرُمَةً","حَاشاك حَاشَاكَ أنْ تُدْعَى فَلَمْ تُجِبِ",72,"ب",1,0],["وقد دهانا مصاباً من أخي ثقة","وقد رثاه فاعلاً مجده السام",73,"م",1,0],["وقد درست منها المعالم بل عفت","ولم يبق إلا الاسم بين العوالم",74,"م",1,0],["وقد دَلِفَت شَعواءُ يَبرقُ حَشوُها","ضَراغِمُ تُردي في الحَديدِ المُسَمَّر",75,"ر",1,0],["وقد درست بالعلم أعلام درسه","وقدسه فيه الخمول بقدسه",76,"ه",1,0],["وَقد دلت الآيات أَنك دائِماً","لِعَين ذَوات الدَهر في مصر إِنسان",77,"ن",1,0],["وَقَد دَعاك عَلى رَغم الحَسود إِلى","مَجالس شادَها بِالحُكم في الأُمم",78,"م",1,0],["وقد دك طور الصبر مني على النوى","هواك وكم عاينته غير مندك",79,"ك",1,0],["وقد دبغتنيَ دبغَ الأديم","عِشْقاً فما ساءَني دَبْغُها",80,"غ",3,0],["وَقَد دَعا للّذي قَد رامَ عِترتَهُ","وَغَرَّهم مِنهُ تَمويهٌ وَتَدجيلُ",81,"ل",1,0],["وَقَد دَعتكَ في حَضرَتي لِلنُصح","فَاِنصح فَليلي قَد نَفاه صُبحي",82,"ي",1,0],["وقد دفعوا عن وَجْدِهمْ كلَّ سَلْوَةٍ","ولو وَجَدَتْه ما أطاقَتْ له دَفْعَا",83,"ع",2,0],["وقد دَرَسَت سوى آثارِ نؤيٍ","وآريٍّ تنصَّفَهُ الغبارُ",84,"ر",1,0],["وَقَد دَلَّتِ الدُنيا عَلى عَيبِ نَفسِها","إِذِ اِلتَفَتَت لِلُّؤمِ بَعدَ التَكَرُّمِ",85,"م",1,1],["وقد دخل الناس مثل الجراد","فمن ساجدين ومن ركع",86,"ع",1,0],["وقد دهمته واحتقرته نفس","أصرت يا حليم على التجافي",87,"ف",2,0],["وقد دخلوا الاسباب فيه بأمره","وفي الذل فيه والمودة قد داموا",88,"م",3,0],["وقد دبُغت رؤوسهمُ فأضحت","نواشفَ قد تحيّفَها الدِّباغُ",89,"غ",1,0],["وقد دعا لي مولاي دعوة","فحق لي الفخر بها في الأنام",90,"م",1,0],["وقد دلفتَ إليهم تحتَ خافقةٍ","قلبُ الضلالةِ منها خائف وجل",91,"ل",1,0],["وَقَد دَعاهُم إِلى الرُشدِ الإِمامُ فَلَم","يُصغوا وَهَل تَقبَلُ الرُشدَ الجَلاميدُ",92,"د",1,0],["وقد دعمنا له سكرا سما وطما","حتى توهمه راؤوه ثهلانا",93,"ن",2,0],["وَقَد دَعا دَعوَةً وَالرَجلُ شائِلَةٌ","فَوقَ العَراقي فَلَم يُلووا وَقَد سَمِعوا",94,"ع",3,0],["وقد دفن الهادي النبي بحجرة","محجبة تزجي إليها الرواحل",95,"ل",1,0],["وقد درست تلك المدارس وارتمتْ","مصاحفُها فوق الثرى وهي تُهْضمُ",96,"م",1,0],["وقد دعوناك على اضْطِرارِ","منكّسي الرّؤوسِ والأبصارِ",97,"ر",1,0],["وقد دل الدليل على صواب","يقول به لدى المتحققينا",98,"ن",2,0],["وَقَد دَرَسَت إِلَّا إِمارَةُ ذاكِرٍ","تَلوحُ لَهُ بَعدَ التَّمادي سُطورُها",99,"ر",3,0],["وَقد دل المجيء على ذهاب","كما دل الطلوعُ على الغُروبِ",100,"ب",1,0],["وَقَد دَفَعتُ وَلَم أَجرُر عَلى أَحَدٍ","فَتقَ العَشيرَةِ وَالأَكفاءِ شُهّادي",101,"د",2,0],["وقد دب العذار بوجنتيه","ليحوى كل ما يحلو ويحرز",102,"ز",1,0],["وقد دهى عقله اندهاش","يزعم فيه الخطا صوابا",103,"ب",2,0],["وقد دنوت من محل الظفر","وارفق رعاك اللَه يا رسولي",104,"ي",1,0],["وقد دعونا غلاماً","كالغصن أعلاه بدر",105,"ر",1,0],["وَقَد دَخَلَ الشَهرُ الحَرامُ وَخُلِّيَت","تِهامَةُ تَهوي بادِياً لِهَواتُها",106,"ا",1,0],["وقد دعا هل من مغيثٍ ناصرِ","ينصُرُنا على العدوّ الغادرِ",107,"ر",1,0],["وقد دعاهُ بلِسانِ الحالِ","وفي لسانِ الصِدقِ والمقالِ",108,"ل",1,0],["وَقَد دَعَوتُ وَما آلو لِأُسمِعَهُ","أَبا الوَليدِ وَدوني سِجنُ دَوّارِ",109,"ر",1,0],["وقد دفنت سراً حبيبةُ أحمد","بجنح الدجى يا ساعد الله حيدرا",110,"ر",2,0],["وقد دار ساقينا بكأس روية","ترحل أحزان الكئيب مع العقل",111,"ل",1,0],["وقد دبجوا وجه البسيطة بهجة","بحسن فعالٍ لاتعدد بالحصر",112,"ر",1,0],["وقد دعا ا