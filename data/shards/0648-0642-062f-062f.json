{"poems":[[63,"بكت شجوها وهنا وكدت أهيم","https://www.aldiwan.net/poem46131.html","الطويل"],[63,"يا حادي الشدنيات المطاريب","https://www.aldiwan.net/poem46151.html","الرجز"],[63,"رنت إلي وظل النقع ممدود","https://www.aldiwan.net/poem46194.html","البسيط"],[35,"لقد هجرت سعدى وطال صدودها","https://www.aldiwan.net/poem39162.html","الطويل"],[27,"تعللنا أمامة بالعدات","https://www.aldiwan.net/poem5692.html","الوافر"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[47,"قد ضج جيشك من طول القتال به","https://www.aldiwan.net/poem25202.html","البسيط"],[64,"جحودي لك تقديس","https://www.aldiwan.net/poem67635.html","الهزج"],[51,"هل أنت من مرتجيك مستمع","https://www.aldiwan.net/poem65399.html","المنسرح"],[51,"أمكوك الخسار سأنتحيكا","https://www.aldiwan.net/poem65804.html","الوافر"],[92,"كرهت القصور وقطانها","https://www.aldiwan.net/poem38931.html","المتقارب"],[85,"أعزيك أبا مكسى","https://www.aldiwan.net/poem7116.html","مجزوء الوافر"],[62,"سقى دارها بالجزع صوب غمائم","https://www.aldiwan.net/poem52283.html","الطويل"],[62,"ولم أنسها والموت يقبض كفها","https://www.aldiwan.net/poem52329.html","الطويل"],[45,"ضلالا لها ماذا أرادت إلى الصد","https://www.aldiwan.net/poem63507.html","الطويل"],[28,"فرعن وفرغن الهموم التي سمت","https://www.aldiwan.net/poem5547.html","الطويل"],[74,"ألا قل للمريض القلب مهلا","https://www.aldiwan.net/poem12826.html","الوافر"],[74,"ألا عرس الإخوان في ساحة البلى","https://www.aldiwan.net/poem12868.html","الطويل"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[75,"قد أدبر الليل عنا فا حد بالإبل","https://www.aldiwan.net/poem69022.html","البسيط"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[48,"وخمر كعين الديك صبحت سحرة","https://www.aldiwan.net/poem65292.html","الطويل"],[46,"توافقت اليهود مع النصارى","https://www.aldiwan.net/poem22998.html","الوافر"],[46,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16693","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16664","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21099","البسيط"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12825","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54294","الطويل"],[49,"خلِيليَّ إنَّ الهمَّ قَدْ يتفرَّجُ","https://www.poetsgate.com/ViewPoem.aspx?id=16977",""],[103,"ملكنا هذه الدنيا قرونا","https://www.poetsgate.com/ViewPoem.aspx?id=1234",""],[45,"تفتأ عجبا بالشيء تدكره","https://www.poetsgate.com/ViewPoem.aspx?id=31188",""],[51,"هل أنت من مرتجيك مستمِعُ","https://www.poetsgate.com/ViewPoem.aspx?id=29515",""]],"verses":[["وقد دَبَّ في كُتّابِهِمْ نَشْوَةُ الغِنى","وكُلُّهمُ جَعْدُ اليَدَيْنِ لَئيمُ",0,"م",1,0],["وقد دنَتْ منهُ حتّى أوْدَعَتْ أرَجاً","أحْناءَ سَرْجي أفاوِيهٌ منَ الطّيبِ",1,"ب",1,0],["وقد دَعاكَ أميرُ المؤمنينَ لَها","والهَمُّ مُنتَشِرٌ والعَزْمُ مَكدودُ",2,"د",1,0],["وقد درّعوها وهيَ ذات مؤصد","مَجوبٍ وَلَما يَلبَسِ الدِرعَ ريدُها",3,"د",3,0],["وَقَد دَمِيَت مَواقِعُ رُكبَتَيها","مِنَ التِبراكِ لَيسَ مِنَ الصَلاةِ",4,"ه",1,0],["وقد دَرَسُوا القُرآنَ وافتَلَجوا به","فَكُلُّهُم رَاضٍ بِهش مُتَحزِّبُ",5,"ب",1,0],["وَقَد دَرى الرومُ مُذ جاوَرتَ أَرضَهُمُ","أَن لَيسَ يَعصِمُهُم سَهلٌ وَلا جَبَلُ",6,"ل",1,0],["وَقَد دَلَّ دَليلُ الحُب","بِ أَنَّ القُربَ تَلبيسُ",7,"س",1,0],["وقد درى حين زال مطمعه","فيك بأي الدروع تدَّرع",8,"ع",1,0],["وقد دانتْ لطاعته فكانت","دجاجتَه وكان هناك ديكا",9,"ك",2,0],["وقد دَثَّرَتْهُ غيومُ المساءِ بظلٍّ","حزينٍ ضَريحٍ شفيفْ",10,"ف",1,0],["وقد دقت لك العو","د ومدّت بسط الفرس",11,"س",1,0],["وقد درعتْ ثوبَ الظلامِ نياقُهمْ","بكل فتىً يقظانَ عينِ العزائمِ",12,"م",1,0],["وقد دمِعَتْ أجفانُها وكأنها","جَنَى نرجسٍ فيه النَّدى يترقْرَقُ",13,"ق",1,0],["وَقَد دَفَعوا بُخلَ الزَمانِ بِجودِهِ","وَلا طِبَّ حَتّى يُدفَعَ الضِدُّ بِالضِدِّ",14,"د",1,0],["وَقَد دَأَبَت عِشرينَ يَوماً وَلَيلَةً","يُشَدُّ بِرِسغَيها إِلَيكَ خِدامُها",15,"م",3,0],["وَقَد دَمّى النَجيعُ هُناكَ أَرضاً","وَقَد شَمَلَ العَجاجُ بِهِ سَماءَ",16,"ا",2,0],["وَقَد دَرَسَت أَجسامُهُم وَدِيارُهُم","فَلَم أَرَ إِلّا أَقبُراً وَيَبابا",17,"ب",2,0],["وَقد دَعَتْ لكَ منِّي كُلُّ جَارِحَةٍ","وبالإِجابَةِ فَضْلُ اللَّهِ يُنْتَظَرُ",18,"ر",1,0],["وقد درى الغيث أن لو كان أشبههم","لشاب جودَهُم شيءٌ من البضخل",19,"ل",1,0],["وقد دُعيتَ إلى الهيجا فجِئتَ كما","جُؤجِئَتِ الشَّولُ بالفَحل الغُرَيريّ",20,"ي",1,0],["وَقَد دارَ ساقيها بِها ذا قُراطِقٍ","تُناطُ بِأَعلى ساعِدٍ وَبَنانِ",21,"ن",1,0],["وَقَد دُمنا عَلى سوءِ السَجايا","كَما دامَت قُرَيشُ عَلى الإِلافِ",22,"ف",1,0],["وقد دَقّتْ هَوادِيهِنّ حتى","كأنّ رقابَهُنّ الخَيْزرانُ",23,"ن",1,0],["وقد دَنِسَتْ أعْطافُهُ من تَقادُمٍ","فخُذْ آسَ نارٍ لا يُسافُ فَداوه",24,"ا",3,0],["وقد دَمِيَتْ خَمْسٌ لها عَنَمِيّةٌ","بإدْمانِها في الأزْمِ شوْكَ سِيال",25,"ل",1,0],["وقد دَرَسَتْ نحوَ السُّرَى فهْي لَبّةٌ","بما كان من جَرّ البَعيرِ أوِ الرَّفْع",26,"ع",1,0],["وقَد دَخَلتُ عَلَى الحسناءِ كِلَّتَها","بَعد الهُدُوءِ تَضيءُ كالصَّنَمِ",27,"م",1,1],["وَقَد دَسَّت إِلَيَّ فَتاةَ قَومٍ","فَقالَت أَصفِني مَحضَ الوِصالِ",28,"ل",1,0],["وقد دفن القومُ التِّراتِ وأقبلوا","إلى الحقِّ يمحو ضوؤه كلَّ باطل",29,"ل",1,0],["وقد دَرَجَتْ مِنّا قُرُونٌ كَثيرَة ٌ،","ونَحنُ سنَمضِي بَعدَهنّ ونَدرُجُ",30,"ج",1,0],["وقد دانوا بأعظمهم نضالا","وعلما، لا بأجزلهم عيونا",31,"ن",2,0],["وقد دعا ناهيا فأسمعني","وخط على الرأس مخلس شعره",32,"ر",2,0],["وقد درى حين زال مَطمعُه","فيك بأيِّ الدرع تدَّرع",33,"ع",1,0]]}