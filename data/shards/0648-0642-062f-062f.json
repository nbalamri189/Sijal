{"poems":[[63,"بكت شجوها وهنا وكدت أهيم","https://www.aldiwan.net/poem46131.html","الطويل"],[63,"يا حادي الشدنيات المطاريب","https://www.aldiwan.net/poem46151.html","الرجز"],[63,"رنت إلي وظل النقع ممدود","https://www.aldiwan.net/poem46194.html","البسيط"],[35,"لقد هجرت سعدى وطال صدودها","https://www.aldiwan.net/poem39162.html","الطويل"],[27,"تعللنا أمامة بالعدات","https://www.aldiwan.net/poem5692.html","الوافر"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[47,"قد ضج جيشك من طول القتال به","https://www.aldiwan.net/poem25202.html","البسيط"],[64,"جحودي لك تقديس","https://www.aldiwan.net/poem67635.html","الهزج"],[51,"هل أنت من مرتجيك مستمع","https://www.aldiwan.net/poem65399.html","المنسرح"],[51,"أمكوك الخسار سأنتحيكا","https://www.aldiwan.net/poem65804.html","الوافر"],[92,"كرهت القصور وقطانها","https://www.aldiwan.net/poem38931.html","المتقارب"],[85,"أعزيك أبا مكسى","https://www.aldiwan.net/poem7116.html","مجزوء الوافر"],[62,"سقى دارها بالجزع صوب غمائم","https://www.aldiwan.net/poem52283.html","الطويل"],[62,"ولم أنسها والموت يقبض كفها","https://www.aldiwan.net/poem52329.html","الطويل"],[45,"ضلالا لها ماذا أرادت إلى الصد","https://www.aldiwan.net/poem63507.html","الطويل"],[28,"فرعن وفرغن الهموم التي سمت","https://www.aldiwan.net/poem5547.html","الطويل"],[74,"ألا قل للمريض القلب مهلا","https://www.aldiwan.net/poem12826.html","الوافر"],[74,"ألا عرس الإخوان في ساحة البلى","https://www.aldiwan.net/poem12868.html","الطويل"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[75,"قد أدبر الليل عنا فا حد بالإبل","https://www.aldiwan.net/poem69022.html","البسيط"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[48,"وخمر كعين الديك صبحت سحرة","https://www.aldiwan.net/poem65292.html","الطويل"],[46,"توافقت اليهود مع النصارى","https://www.aldiwan.net/poem22998.html","الوافر"],[46,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16693","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16664","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21099","البسيط"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12825","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54294","الطويل"],[49,"خلِيليَّ إنَّ الهمَّ قَدْ يتفرَّجُ","https://www.poetsgate.com/ViewPoem.aspx?id=16977",""],[103,"ملكنا هذه الدنيا قرونا","https://www.poetsgate.com/ViewPoem.aspx?id=1234",""],[45,"تفتأ عجبا بالشيء تدكره","https://www.poetsgate.com/ViewPoem.aspx?id=31188",""],[51,"هل أنت من مرتجيك مستمِعُ","https://www.poetsgate.com/ViewPoem.aspx?id=29515",""],[116,"أنت النبي لا كذب","https://www.aldiwan.net/poem41968.html","مجزوء الرجز"],[144,"لو لم يقد نحوك العدى الرغب","https://www.aldiwan.net/poem11737.html","المنسرح"],[144,"بإحرازك الفضل الذي بهر الخلقا","https://www.aldiwan.net/poem11786.html","الطويل"],[145,"مالي باب سوى رحابك","https://www.aldiwan.net/poem4460.html","مخلع البسيط"],[183,"روزا فتاة بني عبد المسيح قضت","https://www.aldiwan.net/poem61105.html","البسيط"],[187,"قد زادني أدب يمشي على قدم","https://www.aldiwan.net/poem43620.html","البسيط"],[190,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[190,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[263,"أبعد الخيل أركبها ورادا","https://www.aldiwan.net/poem68196.html","الوافر"],[272,"سمعت سويجع الاثلاث غنى","https://www.aldiwan.net/poem52085.html","الوافر"],[283,"سقى السالف من دهري","https://www.aldiwan.net/poem32743.html","الهزج"],[285,"ما جمع الناس لدنياهم","https://www.aldiwan.net/poem44311.html","السريع"],[305,"أقوم بفرض العامرية والنفل","https://www.aldiwan.net/poem16749.html","الطويل"],[378,"ذريني فجدي حيثما كنت مرشدي","https://www.aldiwan.net/poem66877.html","الطويل"],[404,"الحمد لله الذي لا يفي","https://www.aldiwan.net/poem33643.html","السريع"],[410,"أعاتب فيك الدهر لو أعتب الدهر","https://www.aldiwan.net/poem31861.html","الطويل"],[410,"من كان لي من حماه خيس ذي لبد","https://www.aldiwan.net/poem32214.html","البسيط"],[417,"يواعدني بالوصل منه ويخلف","https://www.aldiwan.net/poem53882.html","الطويل"],[417,"باكر نداماك بكأس العقار","https://www.aldiwan.net/poem53938.html","السريع"],[430,"لك العلياء والشرف المفدى","https://www.aldiwan.net/poem41437.html","الوافر"],[433,"إن كنت يوما معيني عند نازلة","https://www.aldiwan.net/poem12553.html","البسيط"],[449,"وما جرى من دمعه الاّ الذي","https://www.aldiwan.net/poem53780.html","الرجز"],[453,"ظفر ترى ما أراه أم ناب","https://www.aldiwan.net/poem13637.html","المنسرح"],[459,"سوى رسني قاده الباطل","https://www.aldiwan.net/poem55975.html","المتقارب"],[459,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[478,"حالي غدا عاطلا من وصلك الحالي","https://www.aldiwan.net/poem15264.html","البسيط"],[478,"أرسم الهوى العذري دمعك في الرسم","https://www.aldiwan.net/poem15271.html","الطويل"],[483,"طريقتنا قطع العلائق والخطو","https://www.aldiwan.net/poem24360.html","عموديه"],[530,"علي لله إن أعطيت مقدرة","https://www.aldiwan.net/poem37388.html","البسيط"],[539,"بعودتك الحمراء تم لها القصد","https://www.aldiwan.net/poem48240.html","عموديه"],[552,"يا صاح ليس لسر منك كتمان","https://www.aldiwan.net/poem47188.html","البسيط"],[552,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[552,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[559,"كواكب جرت من السماء","https://www.aldiwan.net/poem35083.html","الرجز"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[571,"ألم يبلغك والأنماء تنمي","https://www.aldiwan.net/poem59475.html","الطويل"],[587,"أرض الأحبة من سفح ومن كثب","https://www.aldiwan.net/poem17436.html","البسيط"],[588,"يا راكباً من رياض المجد مرتحلا","https://www.aldiwan.net/poem11553.html","عموديه"],[588,"على الدين فليبكي ذوو العلم والهدى","https://www.aldiwan.net/poem11555.html","عموديه"]],"verses":[["وقد دَبَّ في كُتّابِهِمْ نَشْوَةُ الغِنى","وكُلُّهمُ جَعْدُ اليَدَيْنِ لَئيمُ",0,"م",1,0],["وقد دنَتْ منهُ حتّى أوْدَعَتْ أرَجاً","أحْناءَ سَرْجي أفاوِيهٌ منَ الطّيبِ",1,"ب",1,0],["وقد دَعاكَ أميرُ المؤمنينَ لَها","والهَمُّ مُنتَشِرٌ والعَزْمُ مَكدودُ",2,"د",1,0],["وقد درّعوها وهيَ ذات مؤصد","مَجوبٍ وَلَما يَلبَسِ الدِرعَ ريدُها",3,"د",3,0],["وَقَد دَمِيَت مَواقِعُ رُكبَتَيها","مِنَ التِبراكِ لَيسَ مِنَ الصَلاةِ",4,"ه",1,0],["وقد دَرَسُوا القُرآنَ وافتَلَجوا به","فَكُلُّهُم رَاضٍ بِهش مُتَحزِّبُ",5,"ب",1,0],["وَقَد دَرى الرومُ مُذ جاوَرتَ أَرضَهُمُ","أَن لَيسَ يَعصِمُهُم سَهلٌ وَلا جَبَلُ",6,"ل",1,0],["وَقَد دَلَّ دَليلُ الحُب","بِ أَنَّ القُربَ تَلبيسُ",7,"س",1,0],["وقد درى حين زال مطمعه","فيك بأي الدروع تدَّرع",8,"ع",1,0],["وقد دانتْ لطاعته فكانت","دجاجتَه وكان هناك ديكا",9,"ك",2,0],["وقد دَثَّرَتْهُ غيومُ المساءِ بظلٍّ","حزينٍ ضَريحٍ شفيفْ",10,"ف",1,0],["وقد دقت لك العو","د ومدّت بسط الفرس",11,"س",1,0],["وقد درعتْ ثوبَ الظلامِ نياقُهمْ","بكل فتىً يقظانَ عينِ العزائمِ",12,"م",1,0],["وقد دمِعَتْ أجفانُها وكأنها","جَنَى نرجسٍ فيه النَّدى يترقْرَقُ",13,"ق",1,0],["وَقَد دَفَعوا بُخلَ الزَمانِ بِجودِهِ","وَلا طِبَّ حَتّى يُدفَعَ الضِدُّ بِالضِدِّ",14,"د",1,0],["وَقَد دَأَبَت عِشرينَ يَوماً وَلَيلَةً","يُشَدُّ بِرِسغَيها إِلَيكَ خِدامُها",15,"م",3,0],["وَقَد دَمّى النَجيعُ هُناكَ أَرضاً","وَقَد شَمَلَ العَجاجُ بِهِ سَماءَ",16,"ا",2,0],["وَقَد دَرَسَت أَجسامُهُم وَدِيارُهُم","فَلَم أَرَ إِلّا أَقبُراً وَيَبابا",17,"ب",2,0],["وَقد دَعَتْ لكَ منِّي كُلُّ جَارِحَةٍ","وبالإِجابَةِ فَضْلُ اللَّهِ يُنْتَظَرُ",18,"ر",1,0],["وقد درى الغيث أن لو كان أشبههم","لشاب جودَهُم شيءٌ من البضخل",19,"ل",1,0],["وقد دُعيتَ إلى الهيجا فجِئتَ كما","جُؤجِئَتِ الشَّولُ بالفَحل الغُرَيريّ",20,"ي",1,0],["وَقَد دارَ ساقيها بِها ذا قُراطِقٍ","تُناطُ بِأَعلى ساعِدٍ وَبَنانِ",21,"ن",1,0],["وَقَد دُمنا عَلى سوءِ السَجايا","كَما دامَت قُرَيشُ عَلى الإِلافِ",22,"ف",1,0],["وقد دَقّتْ هَوادِيهِنّ حتى","كأنّ رقابَهُنّ الخَيْزرانُ",23,"ن",1,0],["وقد دَنِسَتْ أعْطافُهُ من تَقادُمٍ","فخُذْ آسَ نارٍ لا يُسافُ فَداوه",24,"ا",3,0],["وقد دَمِيَتْ خَمْسٌ لها عَنَمِيّةٌ","بإدْمانِها في الأزْمِ شوْكَ سِيال",25,"ل",1,0],["وقد دَرَسَتْ نحوَ السُّرَى فهْي لَبّةٌ","بما كان من جَرّ البَعيرِ أوِ الرَّفْع",26,"ع",1,0],["وقَد دَخَلتُ عَلَى الحسناءِ كِلَّتَها","بَعد الهُدُوءِ تَضيءُ كالصَّنَمِ",27,"م",1,1],["وَقَد دَسَّت إِلَيَّ فَتاةَ قَومٍ","فَقالَت أَصفِني مَحضَ الوِصالِ",28,"ل",1,0],["وقد دفن القومُ التِّراتِ وأقبلوا","إلى الحقِّ يمحو ضوؤه كلَّ باطل",29,"ل",1,0],["وقد دَرَجَتْ مِنّا قُرُونٌ كَثيرَة ٌ،","ونَحنُ سنَمضِي بَعدَهنّ ونَدرُجُ",30,"ج",1,0],["وقد دانوا بأعظمهم نضالا","وعلما، لا بأجزلهم عيونا",31,"ن",2,0],["وقد دعا ناهيا فأسمعني","وخط على الرأس مخلس شعره",32,"ر",2,0],["وقد درى حين زال مَطمعُه","فيك بأيِّ الدرع تدَّرع",33,"ع",1,0],["وقد دعاك خائفاً","بلهف قلبٍ مضطرب",34,"ب",1,0],["وَقَد دَرَوا أَنَّهُم وَما وَهِموا","إِن نَكَّبوا عَن بِلادِهِم نُكِبوا",35,"ب",3,0],["وَقَد دَبَّ مِن أَقصى المَشارِقِ حَيَّةٌ","لَها لَدَغاتٌ لا تُداوى وَلا تُرقا",36,"ق",2,0],["وقد دهتني وأمرضتني","مهامهُ للهو والسراب",37,"ب",1,0],["وَقَد دَعَت بِأميلٍ طِفلَها عَجَلا","تَبغي لِقاهُ فَلَبّاها عَلى الأَثَرِ",38,"ر",1,0],["وقد دفعت إلى دهر أكافحهُ","أسقامهُ وتنال الحظوة الجيف",39,"ف",1,0],["وَقَد دوّنوا فيها مَذاهبَ غيّهم","وَفي ضِمنها دسّوا الدسائسَ وَالمَكرا",40,"ر",2,0],["وَقَد دَخلوا حزبَ المسونِ بهمّةٍ","بِها حلّ كلٌّ من محافلهِ الصدرا",40,"ر",2,0],["وَقَد درّبوا مِن شدّةِ الكفرِ وُلدَهَم","على بُغضهِ مِن حينِ شُربهمُ الدرّا",41,"ر",2,0],["وَقَد دَبِرَت ونُعمَانٌ صَبِيٌّ","وقَبلَ فِصَالِهِ تِلكَ اللَّيالي",42,"ل",2,0],["وَقَد دروع داود لبواس","تَكون من التباس البأس حصنا",43,"ن",2,0],["وَقَد دَبَّ بِخَدَّيهِ","عِذارٌ باسِطٌ عُذري",44,"ر",2,0],["وَقَد دَنا الفِطرُ وَصِبيانُنا","لَيسوا بِذي تَمرٍ وَلا أَرزِ",45,"ز",1,0],["وَقَد دَرَجَ الأَسلافُ مِن قَبلُ هَؤُلا","وَهَمتَهُم نَيلَ المَكارِمِ وَالفَضلِ",46,"ل",1,0],["وقد درَّعته الريح درعاً مزرَّداً","يجانسه ثوبُ الربيع المورَّد",47,"د",1,0],["وقد دعا الناس إلى ضدها","بمقول العسال والمشرفي",48,"ف",2,0],["وقد دَرَسَتْ آثارُهم وقبورُهم","كما دَرسوا فيها فليسَ لها أُثْرُ",49,"ر",1,0],["وقد دعوتُكَ مظلوماً ومُرتجياً","وفي يدَيكَ الغِنَى والعدلُ والخَلَفُ",50,"ف",1,0],["وقد دارت الأقداح بيني وبينه","وشمل الهوى ما بيننا يتألَّف",51,"ف",1,0],["وقد دَعَتْ للَّهو أبناءها","أوقاتَ أيَّام السُّرور القصار",52,"ر",1,0],["وقد دانت لك العياء حبا","فلم تجنح لغير علاك عمدا",53,"د",2,0],["وقد دعوتُك والأسماعُ مصغيةٌ","الى استماعِ جوابٍ منك جوّابِ",54,"ب",1,0],["وقد درى ان المراد وصله","عالى الجناب ابدا منيعه",55,"ع",2,0],["وقد دَرَى كل خابر زَكن","إِنَّ الرَّدى للأنام نهابُ",56,"ب",1,0],["وقد دلَّ حائلُ لونِ الشباب","على أنّ عمرَ الفتى حائلُ",57,"ل",1,0],["وقد دَرسَتْ إلا نشايا عواصفٌ","من الريح لم يَفطُنْ لهنّ هُبوبُها",58,"ب",3,0],["وقد دَرَسَتْ","سوى رسومٍ كَبُردِ الصَّبرِ اسمالِ",59,"ل",1,0],["وقد دَرَستْ إلا بقيةُ معهدٍ","على وَجَناتِ التربِ أخفى مِنَ الوشمِ",60,"م",1,0],["وقد دلنا القرآن في كل موطن","على مركز الأنوار إذ هو أوحد",61,"د",1,0],["وقَدْ دَعَا لِيَ خَيْرُ الْخَلْقِ أَحْمَدُ مَنْ","جاءَتْ بمدْحَتِهِ الآياتُ في السُّوَرِ",62,"ر",1,0],["وقد دام أسبوعُ السُّرور وكُحِّلَت","بطلعَتِك الغرَّاءِ أعيُنُه الرُّمدُ",63,"د",1,0],["وقد درى كلُّ ذي لُبٍّ بأنّهمُ","عزّوا وعمّا قليلٍ بالرّدى هانوا",64,"ن",3,0],["وَقَد درى الأقوامُ أَنّي اِمرؤٌ","أواصلُ الصدَّ عن السَّوْأَةِ",65,"ه",1,0],["وَقَد دَرى كلُّ مَن لَهُ بصَرٌ","أَنّك سُدتَ العجيم والعَرَبا",66,"ب",2,0],["وقد دخلوا بالملك في قلعة الأنا","فليس لهم عما يرومون دافع",67,"ع",1,0],["وقد دخلتم جنة عالية","قطوفها دانية اجتناء",68,"ا",2,0],["وقد دعاهم بغدير خم","فاجتمعوا إليه كي يسمّي",69,"ي",1,0],["وقد دعا لقولهم واحتجا","لما أتوه بعض من قد لجا",69,"ج",2,0],["وقد دخلتم كلكم في بيعته","فما الذي أوقفكم عن نصرته",69,"ه",1,0],["وقد دلفوا إليَّ بفعلِ سوءٍ","فألفوني لهم صعب القيادِ",70,"د",1,0],["وَقَدْ دَعَوْتُكَ أَرْجُو مِنْكَ مَكْرُمَةً","حَاشاك حَاشَاكَ أنْ تُدْعَى فَلَمْ تُجِبِ",71,"ب",1,0],["وقد دهانا مصاباً من أخي ثقة","وقد رثاه فاعلاً مجده السام",72,"م",1,0],["وقد درست منها المعالم بل عفت","ولم يبق إلا الاسم بين العوالم",73,"م",1,0]]}