مدارس وارتمت","مصاحفها فوق الثرى وهي ضخم",140,"م",1,0],["[ وَقَدْ داهَمَ الأَعْدا بِبَحْرِ عَساكِرٍ","بِمَوْجِ جِيادٍ أُلْحِقَتْ بِجِيادِ ]",141,"د",1,0],["وَقَد دَفَعتُ بِنَفسِي فِي مُحاوَلَةٍ","لِكَي يُعَبِّرَ عَن حُبِّي تَضَرُّعُهُ",142,"ع",2,0],["وقد دانتْ لها الدنيا أخيرا","وصافحَها بعينيه السلامُ",143,"م",1,0]]}