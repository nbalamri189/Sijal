{"poems":[[110,"سطا حُسناً","https://www.shoaraa.com/p13815",""],[75,"ما جال بعدك لحظي في سنا القمر","https://www.aldiwan.net/poem11928.html","البسيط"],[49,"أراك عصي الدمع شيمتك الصبر","https://www.aldiwan.net/poem25258.html","الطويل"],[74,"قال العذول فزاد قلبا شيقا","https://www.aldiwan.net/poem19352.html","الكامل"],[53,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[53,"مكر الزمان علينا غير مأمون","https://www.aldiwan.net/poem66416.html","البسيط"],[31,"حي المنازل بين السفح والرحب","https://www.aldiwan.net/poem6045.html","البسيط"],[45,"تجف الأرض من هذا الرباب","https://www.aldiwan.net/poem9452.html","الوافر"],[45,"عقبى اليمين على عقبى الوغى ندم","https://www.aldiwan.net/poem10529.html","البسيط"],[49,"أراك عصي الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=11992",""],[53,"مكْرُ الزَّمانِ علينا غير مأمونِ","https://www.poetsgate.com/ViewPoem.aspx?id=30805",""],[31,"حيِّ المنازِلَ بَينَ السّفْحِ والرُّحَبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17430&r=&rc=3",""],[146,"عذب من الماء قد سدت موارده","https://www.aldiwan.net/poem58328.html","البسيط"],[164,"خطرت بقد أهيف مياس","https://www.aldiwan.net/poem58852.html","الكامل"],[189,"حكم العيون على القلوب يجوز","https://www.aldiwan.net/poem14549.html","الكامل"],[443,"إن كان أضمر قلبي عنك سلوانا","https://www.aldiwan.net/poem2597.html","البسيط"],[470,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[519,"حتام أسألها الدنو فتنزح","https://www.aldiwan.net/poem20804.html","الكامل"],[567,"بناء العلى بين القنا والبوارق","https://www.aldiwan.net/poem52969.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63985","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63990","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101032","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100984","الكامل"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82177","الكامل"],[5277,"معارضة داليّة الحصري القيرواني","https://www.poetsgate.com/ViewPoem.aspx?id=198895",""],[5464,"سبايا","https://www.poetsgate.com/ViewPoem.aspx?id=36084",""],[5480,"رحل حمدان","https://www.poetsgate.com/ViewPoem.aspx?id=9892",""],[5528,"حياضُ النّور","https://www.poetsgate.com/ViewPoem.aspx?id=207553",""],[5781,"أُنْثاكَ في العشق!","https://www.poetsgate.com/ViewPoem.aspx?id=208932",""],[845,"إلى أبي تراب","https://www.poetsgate.com/ViewPoem.aspx?id=159622",""],[6178,"مرافي محطمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85529&r=&rc=5",""]],"verses":[["تجفف مدمعاً بالمسح آناً","وآونة تجففه احتلابا",0,"ب",2,0],["تُجفى لَها الرَوضَةُ الغَنّاءُ أَضحَكَها","مَجالُ دَمعِ النَدى في أَعيُنِ الزَهَرِ",1,"ر",1,0],["تَجَفَّلُ حيناً ثُمَّ تَرنو كَأَنَّها","تُنادي طَلاً بِالوادِ أَعجَزَهُ الخُضرُ",2,"ر",1,0],["تجفو ولو أني قبرت وسلمت","سلمتُ تسليم البشاشة أوزقا",3,"ق",2,0],["تَجِف القلوبُ إذا غدتْ","أقلامُهُ ولها صريرُ",4,"ر",1,0],["تجْفُو وإنْ عانقَتْ يوماً لها ولداً","كانتْ كمطرورةٍ في نَحْرِ موتون",5,"ن",1,0],["تَجَفُّلَ الخَيلِ مِن ذي شارَةٍ تَئِقٍ","مُشَهَّرِ الوَجهِ وَالأَقرابِ ذي جَبَبِ",6,"ب",1,0],["تَجِفُّ الأَرضُ مِن هَذا الرَبابِ","وَيَخلُقُ ما كَساها مِن ثِيابِ",7,"ب",1,1],["تَجَفَّلُ المَوجُ عَن لَبّاتِ خَيلِهِمِ","كَما تَجَفَّلُ تَحتَ الغارَةِ النَعَمُ",8,"م",1,0],["تَجَفَّلُ حيناً، ثُمّ تَرْنو كأنّها","تُنادي طَلاًّ بالوادِ أعْجَزَهُ الحَُضْرُ",9,"ر",1,0],["تَجْفُوا وإنْ عانقَتْ يوماً لها والدا","كانتْ كمطرورة ٍ في نَحْرِ موتون",10,"ن",1,0],["تجفلَ الخيلَ من ذي شارة ٍ تئقٍ","مُشَهَّرِ الوَجْهِ والأقرابِ، ذي حَبَبِ",11,"ب",1,0],["تجفو تعذَّرَ حِبٍّ لست تُبصرهُ","والمُرُّ حِرمانُ محبوبٍ تُشاهدُهُ",12,"د",2,0],["تجفو المحبَّ وقد جفا في حبها","طيبُ الكرى وتجود بعد شِماسِ",13,"س",1,0],["تجفو غِلالتُه عليه لطَافًة","فبجسمِه من طَرْزِها تَطْريز",14,"ز",1,0],["تجفو وتزعم أني قد جفوتُ قلى","لا متّعت بالكرى أجفان أجفانا",15,"ن",2,0],["تَجِفُّ كلُّ بحارِالأرض ِغَيْرَ دَمٍ","وَهَبْتَ لِلنَّاس ِيَبقى دافِئاً رَطِبا",16,"ب",2,0],["تَجفو وما حُنِيَتْ عليه أضالعي","يحنو علَيْها والجوانحُ تجنَحُ",17,"ح",1,0],["تَجِفُّ بأيديها الدِماءُ من الظُبَى","فتَضرِبُ لا تحتاجُ قبضَ البراجقِ",18,"ق",1,0],["تجفو الخطوبُ على أعزَّ سَمَيْدَعٍ","وتلينُ للجعظارةِ الجوّاظ",19,"ظ",1,0],["تجفو خلائقُه عن كلِّ فاحشةٍ","وما يقاربُها في لينها الشَّمَع",20,"ع",1,0],["تجفو المبارك شوقاً لا يطيب لها","دون السرى الأخضران الطلح والضال",21,"ل",1,0],["تجفو الموارد حيث لا ينفك عن","سفن الفرنجة ماؤها وبحارها",22,"ر",3,0],["تجف القلوب له ويشخصها","عن مستقر قرارها أرض",23,"ض",1,0],["تجفوهُ وتَتْرُكُهُ دَنِفاً","واليمُ الوصلِ يُقَدِّدُهُ",24,"د",2,0],["تجْفو فأزعَمُ أنَّه ُ دَلَع ٌ","وتُذِلُّني فأقولُ من مَجَن ِ",25,"ن",1,0],["تجفف دمعة العين الحزينة","وحزن ٍ فالحشا غادر ظلومي",26,"م",2,0],["تَجفُّ في سَاحِهِ الأقلامُ عَاجِزةً","عنْ وصْفهِ كيف تُرضِي الطِّرْسَ وَ الوَرقا ؟",27,"ق",2,0],["تَجِفُّ مَحبَرَتي لا شيءَ يكتبني","إلَّا الدُّخانُ بِدَمْعٍ جائرٍ هَدِرِ",28,"ر",1,0],["تُجفى وتُعبد والضغائن تغتلي","والدهر يقسو تارةً ويلين",29,"ن",1,0],["تجفّ في فمها الويلات أين بدت","كسنبلات بنار الخوف نحصيها",30,"ي",3,0]]}