m.aspx?id=184433",""],[6102,"عرس برسم الدم!!","https://www.poetsgate.com/ViewPoem.aspx?id=186280",""],[6124,"أين","https://www.poetsgate.com/ViewPoem.aspx?id=109739",""],[6142,"أين يا مسنح الجآذر إذا","https://www.poetsgate.com/ViewPoem.aspx?id=155729",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""],[231,"النفس الضائعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79122&r=&rc=8",""],[6225,"إزاحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80933&r=&rc=202",""],[6237,"يا ربيع الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77871&r=&rc=13",""]],"verses":[["أَينَ يَومُ القَنالِ يا رَبَّةَ التا","جِ وَيا شَمسَ ذَلِكَ المِهرَجانِ",0,"ن",1,1],["أَيْنَ يا شعبُ قلبُكَ الخافقُ الحسَّاسُ","أَيْنَ الطُّموحُ والأَحْلامُ",1,"م",1,1],["أَيْنَ يا شعبُ رُوحُك الشَّاعرُ الفنَّانُ","أَيْنَ الخيالُ والإِلهامُ",1,"م",1,0],["أَيْنَ يا شعبُ فنُّكَ السَّاحرُ الخلاّقُ","أَيْنَ الرُّسومُ والأَنغامُ",1,"م",1,0],["أَيْنَ يمَّ الحَيَاةِ يَدْوي حوالَيْكَ","فأَينَ المُغامِرُ المِقْدامُ",1,"م",1,0],["أَينَ يا واحِدَ مَروانَ عَلَم","مَن دَعاكَ الصَقرُ سَمّاهُ العُقاب",2,"ب",1,0],["أين يمضي للأزهر الشامخ الرأ","س القويّ الباقي على الأدهارِ",3,"ر",1,0],["أين يا رب أين من قبل حيني","ألتقي مرةً بحملي الأوحد",4,"د",1,0],["أينَ يا قلبِيَ مَن قلبي اجتَبَى","لهواهُ واصطفاهُ لي خدينا",5,"ن",2,0],["أين يا ليلايَ عهدُ الهرم","أين يا ليلاي حُلوُ الكَلِمِ",6,"م",1,0],["أين يا صفوانُ ما أمّلتَهُ","أين ما حدَّثْتَ تَستهِوي السَّوادا",7,"د",2,0],["أين يا فاروس ولَّيْتَ بجندي","أين ولَّيْتَ بسلطاني ومجدي",8,"ي",1,0],["أين يا ليلتي إلى أين أسري ؟","والمنايا تهيّء الأظفارا",9,"ر",2,0],["أين يا رب أين منقبل حيْني","ألتقي مرةً بحلمي الموحّدْ؟",10,"د",1,0],["اين يلفى القلب الولوه سكونا","مع اطوار خصرك الهزاز",11,"ز",1,0],["أين يَمضي وكيف يَمضي ولَمَّا","يَسْكُنِ النُّورُ والهِدايَةُ جَنْبَهْ؟",12,"ب",2,0],["أين يا سائقنا أين بنا","شد ما أنهكنا طول السرى",13,"ا",1,0],["أَينِى افِى يُمنى يَدَيكِ جَعلتِنى","فَأَفرَحَ أَم صَيَّرتِنى في شِمَالِكِ",14,"ك",1,0],["أين يا روح ليالٍ سلفت","وأغاريدك يا صدّاح زادى",15,"د",2,0],["أَينَ يَجري بالنكثِ عمه جعارٍ","يعجبُ الرينَ نكث جاري العهودِ",16,"د",1,0],["أين يا جزّار ما أرهَفتَه","لبنى الإنسانِ من دامى النصال",17,"ل",1,0],["إين يا فاتنة الشط","أألقاكِ غدا",18,"د",2,0],["أَينَ يَفِرُّ المَغرورُ مِن أَجَلٍ","وَمِن بَلاءِ كِلاهُما كُتِبا",19,"ب",2,0],["أينَ يا سَعْدُ ديارٌ دَرَسَتْ","وأحبَّاءٌ بها كانوا نزولا",20,"ل",2,0],["أين يا سائقها أين بها","جعجعِ الآمال في غيرِ عزيبِ",21,"ب",1,0],["أين يا حادي النياق الخيام","سكر السائرون شوقاً وهاموا",22,"م",3,1],["إينيا ملاكي وكنزي","روحي فدى ناظريِّها",23,"ي",3,0],["أَيْنَ يَا كَوْكَبُ مِنِّي ظَبْيَةٌ","طَفْلَةُ الرُّوحِ سَبَتْنِي مِنْ سَبَا؟",24,"ب",2,0],["أين يا أخت الحسام المنتضى","لصروف الدهر في اليوم العصيب",25,"ب",1,1],["أين يا أخت الإمام المرتضى","ذو البيان الحرّ والرأي المصيب",25,"ب",1,0],["أين يا أخت هلال الداجيه","فارس الحلبة كشاف الكرب",25,"ب",1,0],["أينيا أخت إمام الناجيه","وأمين الله عن مجد العرب",25,"ب",1,0],["أين يا أخت حواري الجلال","صيقل الأذهان إكسير القوى",25,"ق",3,0],["أين يا أمُّ عهدُ زوج وفيٍ","مثل ما عاش مغرماً مات مغرم",26,"م",1,0],["أين يا ابن الفاروق منك ال","ذي أبدعَ في نظمها ولا إطراءُ",27,"ا",2,0],["أَينَ يا شاعِرَةَ الشَر","قِ وَيا شَمسَ الزَمانِ",28,"ن",1,0],["أَينَ يا زَهرَةُ كُنتِ","قَبلَ هَذا الابتِسام",29,"م",1,1],["أين يأسي ؟ لقد مضى","ومضت مثله المنى",30,"ن",2,0],["أين يلقى الخلاص من سوء حظٍ","في حياة تضيق بالآفاق",31,"ق",1,0],["اين يرعوي الليل البهيم بسدفة","فالصبح منتزع الضيا جفول",32,"ل",1,0],["أين يا شرطة المرور بقلبي","كيف مرّت ولم تفوهوا بأمر",33,"ر",1,0],["أيْنَ يا راكِبَ المَطيّةِ تبغي","دونَك الحيَّ فاتّبِعْ رُكْبانَهْ",34,"ن",2,0],["أين يمضي بك يا يومُ السرى","وعنان الحب يا يوم مطيع",35,"ع",1,0],["أين يمضي أين أفق الأرض أين","فرحاب الكون ملأى بالأكر",36,"ر",1,0],["أَيْنَ يَمْضِي حَيَاؤُهُ وَالعَوالِي","ناظِراتٌ لَهُ بِطَرْفٍ شَزْرِ",37,"ر",1,0],["أَينَ يا هَذي النِّسا قُلنَ لَنا","أَنذَرُوماخُ مَضَت أَيِّ قَبِيل",38,"ل",1,0],["أَينَ يُلفى الوِقار صَب مُعَنّى","كُل يَومَ بِهِ الغَرامُ اِستَجدا",39,"د",2,0],["أين يفر الشرق من بطشه","وكيف يُنجي النفس من ربقته",40,"ت",2,0],["اين يا كوكب الهدى تتجلَّى","بعد عشواء افقدتنا سناكا",41,"ك",2,0],["أَينَ يَممَّتَ نازِحاً يا مُنى النَّف","سِ فَمُذ غِبتَ فارَقَ الَمأمورُ",42,"ر",1,0],["أين يا أطلال جند الغالب","أين آمون وصوت الراهب",43,"ب",1,0],["أين يبقى صبرٌ بقلبٍ وصبرٌ","عنده الصبر وهو مرٌّ وداء",44,"ا",2,0],["أين يا أمي حواديتُ المَسا","وعظاتٌ شكَّلتْ وعييِ النقي",45,"ي",1,0],["أَين يا عِيدُ نَلتقي؟! بي حَنينٌ","ظامئٌ، واحتِمالُهُ لَيسَ سَهلا",46,"ل",2,0],["أيْ نيلُ ..لو تغتلي ..في حِضنِ قاهرةٍ","هوْنًا ..فمصرُ كذا ..أمٌّ ..بها غضبُ",47,"ب",1,0],["أينَ يا بحرُ مَراسيكْ؟؟","سفنُ الشعرِ تناجيكْ",48,"ك",1,1],["أيْنَ يَا \"سَعْدُ \"مَراسِيكْ","مُدُن الْحُلْمِ تُنَاجِيكْ",49,"ك",1,1],["أيني..وما أدري أيّ الدربِ يوصلني","والتيهُ يلعقُ طعمَ القحطِ من شفتي",50,"ت",2,0],["( أَينِي أَنا؟ أَينَ التِي \" .. \" ؟ وَكَأَنَّنا","ضِدَّانِ: مُرُّ حَقِيقَةٍ, وَخَيالُ",51,"ل",1,0],["أَينِي ؟ وَ كَيفِي ؟ قَدْ أَضَعتُ مَلامِحِي","مُذْ غِبتِ , حَتَّى ما أَلِفتُ المَنطِقا",52,"ق",2,0],["أَينِي أَنا ؟ ما زِلتُ أَسأَلُنِي","ضَيَّعتُ - بَعدَ الهامَةِ - القَدَما",53,"م",2,0],["أَينَ يا نَهرُ نَخلَتِي؟! وَضِفافِي؟!","وَحِكايَاتُ شِقوَتِي؟! وَالرِّفاقُ؟!",54,"ق",1,0],["أينَ يَمْضِي هاجِرِي في هفوِ غابِ","إن رآنِي ساكناً في غفوِ بابِ",55,"ب",1,1],["أيْنَ يَمضِي تَارِكًا سُهدَ اللّيالِي","يَعْزِفُ الألحانَ رمزاً للعذَابِ",55,"ب",1,0],["أين يمضي مزهَرِي بعدَ الثّوانِي","ما استقالتْ من كشوفٍ للحسابِ",55,"ب",1,0],["أين يا مسنح الجآذر إذا","عنك عصر برغدة العيش لذا",56,"ذ",2,1],["أَيْنَ يَا هِنْدُ! أَيْنَ مُعتَصِمَاهُ!","أَينَهُ يَا قُرَيْشُ حِلفُ الفُضُولِ!؟",57,"ل",1,0],["أئنّي أنا ؟ أم ذاك رمزٌ لغابرِ","لأنكرتُ من نفسي أخصّ شعائري !",58,"ر",2,1],["أين يا نيلُ عهدُنا منذ كُنا","في رياض اللقاءِ والتوديع",59,"ع",1,0],["أين يا مرتعَ الشبيبة آمالُ","شبابي وأمنياتُ يفوعي",60,"ع",2,0],["أين يا شاعرَ الطبيعة لحنٌ","صاغه القلب من هواهُ الرفيعِ",60,"ع",1,0]]}