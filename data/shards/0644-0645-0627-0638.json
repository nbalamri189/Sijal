{"poems":[[53,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[85,"السحر من سود العيون لقيته","https://www.aldiwan.net/poem62984.html","الكامل"],[52,"لما ظننت فراقهم لم أرقد","https://www.aldiwan.net/poem27130.html","الكامل"],[161,"تولت فما من مطمع في لقائها","https://www.aldiwan.net/poem58712.html","الطويل"],[378,"دنت العناصر من علائك","https://www.aldiwan.net/poem59306.html","مجزوء الكامل"],[450,"أثر النكسة 1967","https://www.aldiwan.net/poem992.html",""],[539,"اسال من الأجفان عن صدره نهرا","https://www.aldiwan.net/poem48140.html","عموديه"],[554,"أما النحيب فإني سوف أنتحب","https://www.aldiwan.net/poem68401.html","البسيط"]],"verses":[["لَمّا ظَمِئَت إِلَيها قَبلَ رُؤيَتِها","أُعطيتَ لَذَّةَ ماءِ الوَردِ بِالقَرَبِ",0,"ب",1,0],["لَمّا ظَفَرتُ بِهِ عَلى حَرَمِ الهُدى","لِاِبنِ البَتولِ وَلِلصَلاةِ وَهبتُهُ",1,"ت",2,0],["لَمّا ظَنَنتُ فِراقَهُم لَم أَرقُدِ","وَهَلَكتُ إِن صَحَّ التَظَنُّنُ أَو قَدِ",2,"د",1,1],["لما ظل مسود المحيا كظيمه","ولا دسها من غيرة في ثرائها",3,"ا",3,0],["لما ظرهت وأنت في","طي اخفتائك من سنائك",4,"ك",1,0],["لما ظلت مفككة قوان","برغم الخطب كالجسد الرميم",5,"م",1,0],["لَمَا ظَفِرُوا مِنهُم بِغَيرِ عَدالةٍ","تُخَوِّلُهُم صَفحاً إذا استَوجَبُوا زَجرا",6,"ر",2,0],["لَمّا ظَهَرتُ لَها بِالمِربَدِ اِحتَجَبَت","مِنّي وَما كادَ نورُ الشَمسِ يَحتَجِبُ",7,"ب",1,0]]}