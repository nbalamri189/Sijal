{"poems":[[55,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[87,"السحر من سود العيون لقيته","https://www.aldiwan.net/poem62984.html","الكامل"],[54,"لما ظننت فراقهم لم أرقد","https://www.aldiwan.net/poem27130.html","الكامل"],[164,"تولت فما من مطمع في لقائها","https://www.aldiwan.net/poem58712.html","الطويل"],[382,"دنت العناصر من علائك","https://www.aldiwan.net/poem59306.html","مجزوء الكامل"],[454,"أثر النكسة 1967","https://www.aldiwan.net/poem992.html",""],[543,"اسال من الأجفان عن صدره نهرا","https://www.aldiwan.net/poem48140.html","عموديه"],[558,"أما النحيب فإني سوف أنتحب","https://www.aldiwan.net/poem68401.html","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86737","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63740","الكامل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99978","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144076","الطويل"],[190,"","https://poetry.dctabudhabi.ae/diwan/poem/98921","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137070",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76046","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97996","المتدارك"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108105","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133309","الكامل"],[4935,"أضحى خطيب العلم فوق المنبر","https://www.poetsgate.com/ViewPoem.aspx?id=129451",""],[5376,"يا ويل حالي قد بليت بداء","https://www.poetsgate.com/ViewPoem.aspx?id=188560",""],[454,"أثر النكسة 1967","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82664&r=&rc=28",""]],"verses":[["لَمّا ظَمِئَت إِلَيها قَبلَ رُؤيَتِها","أُعطيتَ لَذَّةَ ماءِ الوَردِ بِالقَرَبِ",0,"ب",1,0],["لَمّا ظَفَرتُ بِهِ عَلى حَرَمِ الهُدى","لِاِبنِ البَتولِ وَلِلصَلاةِ وَهبتُهُ",1,"ت",2,0],["لَمّا ظَنَنتُ فِراقَهُم لَم أَرقُدِ","وَهَلَكتُ إِن صَحَّ التَظَنُّنُ أَو قَدِ",2,"د",1,1],["لما ظل مسود المحيا كظيمه","ولا دسها من غيرة في ثرائها",3,"ا",3,0],["لما ظرهت وأنت في","طي اخفتائك من سنائك",4,"ك",1,0],["لما ظلت مفككة قوان","برغم الخطب كالجسد الرميم",5,"م",1,0],["لَمَا ظَفِرُوا مِنهُم بِغَيرِ عَدالةٍ","تُخَوِّلُهُم صَفحاً إذا استَوجَبُوا زَجرا",6,"ر",2,0],["لَمّا ظَهَرتُ لَها بِالمِربَدِ اِحتَجَبَت","مِنّي وَما كادَ نورُ الشَمسِ يَحتَجِبُ",7,"ب",1,0],["لَما ظَهرت بَعد الخَفاء صَبابة","لَظى نارها في القَلب ذات وُقود",8,"د",1,0],["لما ظللتَ بحدِّ سيفكَ خاطباً","ما شكَّ خَلْقٌ أَنَّ سَرْجَكَ مِنْبَر",9,"ر",1,0],["لَمَّا ظَفِرْتُ بِوَصْلِهِ","وَمَلَكْتُ مِنْهُ مَا أشَا",10,"ش",2,0],["لما ظلْتُ في جَرباذَقان لحاجةٍ","سوى مدحِ علياه ولا اخترتها قطُّ",11,"ط",1,0],["لماظة من معاش فيه مسكنة","بين الوجود وبين الياس والعدم",12,"م",1,0],["لما ظفرت بعطف اعظم دولة","اضحى يدين لامرها الثقلان",13,"ن",1,0],["لَما ظَفِرتُ بِها في مَنزلٍ لي خال","قُلتُ اِرحَمي مُدنَفاً قالَت نَعَم يا خال",14,"ل",1,0],["لما ظلمنا ظلمنا في الجزاء وما","هذا بظلم وحق اللّه في النقم",15,"م",1,0],["لم أظفر منك بغير صدى","من همس الروح ترجعه",16,"ع",2,0],["لما ظفرتُ به ذكرت بأنه ال","وجه الذي قد كان قبلاً متلفي",17,"ف",2,0],["لما ظعنت وما ظعنت لهين","قلنا الهمام إلى المعالى قد ظعن",18,"ن",1,0],["لما ظفرت بخير علم نافع","من فاضل للعلم خير مقرر",19,"ر",1,0],["لما ظننت بأن قومي دوننا","ما خلِّدتْ دنيا لنا بفناء",20,"ا",2,0],["لما ظلت مفككة قوانا","برغم الخطب كالجسد الرميم",21,"م",1,0]]}