رب","https://www.poetsgate.com/ViewPoem.aspx?id=179421",""],[106,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[77,"أمحي رسوم الأنس إن شئت أن تبقي","https://www.poetsgate.com/ViewPoem.aspx?id=34185",""],[90,"إبن الشام","https://www.poetsgate.com/ViewPoem.aspx?id=178945",""],[90,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[45,"لي حَبيبٌ قَدْ لَجّ في الهَجْرِ جِدّا","https://www.poetsgate.com/ViewPoem.aspx?id=31601",""],[45,"لكَ في المَجدِ أوّلٌ وَأخيرُ،","https://www.poetsgate.com/ViewPoem.aspx?id=31259",""],[46,"أيا طفلَ الشفيقةِ! إنّ ربي،","https://www.poetsgate.com/ViewPoem.aspx?id=18087",""],[94,"أنني قدمت روحي في الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=15622",""],[88,"نزلت تجر إلى الغروب ذيولا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19531&r=&rc=34",""]],"verses":[["رَقَدَ المُلوكُ بِحَزمِ أَبلَجَ رَأيُهُ","فَلَقٌ لِعاشِيَةِ العُقولِ النُوَّمِ",0,"م",1,0],["رَقاءُ أَضغانٍ يَسُلُّ شَباتَها","حَتّى يُغَيِّرَ طَبعَ سُمِّ الأَرقَمِ",0,"م",1,0],["رِقابُ العِدى وَالعيسُ فيهِم ذَليلَةٌ","وَلِلبيضِ ما نيطَت عَليهِ القَلائِدُ",1,"د",1,0],["رَقَّت حَواشي بَيتِهِ","مِمّا يُلاطِمُها السَرابُ",2,"ب",1,0],["رقّتْ وراقَتْ سَجاياهُ فنَفْحَتُها","تَشي إليكَ بِرَيّا الرّوضَةِ الأُنُفِ",3,"ف",1,0],["رَقدَةَ الرَاقِدينَ في الكَهفِ إِذ رو","عِيَ بِالحِفظِ كَهفَهُم وَالرَقيمُ",4,"م",1,0],["رَقيقٌ بدَتْ للمُشْتَرينَ عُيوبُهُ","ولمْ تلْتَفِتْ دعْواهُ فاسْتوْجَبَ الرّدّا",5,"د",2,0],["رَقيقٌ كما راقَتْكَ نَغْمَةُ ساجعٍ","وجَزْلٌ كما راعَتْكَ صَوْلَةُ جارِحِ",6,"ح",1,0],["رَقَمَت أنامِلُ صانِعي دِيباجِي","منْ بَعْدِ ما نَظَمَتْ جَواهِرَ تاجي",7,"ج",2,1],["رَقّتْ مَعانِيهِ لدَيّ فلَوْ جَرَى","سَحَراً نَسيمُ الرّوضِ لاسْتَجْفَيْتُهُ",8,"ت",2,0],["رَقَّت كَما سالَ العِذا","رُ بِجانِبِ الخَدِّ الأَسيل",9,"ل",1,0],["رَقَّتْ لَكَ الأَضْلاعُ مِنْهُ فَمَا","وُسِّدْتَ إِلاَّ مُهْجَةً لَيِّنَهْ",10,"ن",2,0],["رَقَّ فِيهِ الشِّتَاءُ حَتَّى لَيَبْدُو","فِي ثَنَايَاهُ لِلرَّبِيعِ ابْتِسَامُ",11,"م",1,0],["رَقِيقُ حَدِيثٍ كَالمُدَامِ يُدِيرُهُ","فَيَشْجَى بِهِ فَدْمٌ وَيَطْرَبُ عَالِمُ",12,"م",1,0],["رِقاقُ الحَواشي مُنفِذاتٌ صُدورُها","وَأَعجازُها عَمّا بِهِ اللَهوُ خُذَّلُ",13,"ل",1,0],["رقيتَ إليه والسيوف مُشِيحةٌ","وقد بلغت فيه النفوس التراقيا",14,"ي",2,0],["رقَّتْ مضاربُهُ وراق فِرَنْدُهُ","فالحسن فيه مجمَلٌ ومفصَّلُ",15,"ل",1,0],["رقّت سجاياه وراقت مجتلّى","كالشمس في بعد وفي إشراقِ",16,"ق",1,0],["رقت سجاياه وراقت مجتلى","كالنهر وسط الروضةَ الغنّاءِ",17,"ا",2,0],["رقصها يرقص القلوب على أنّ","غناها عن المزامير يُغني",18,"ي",1,0],["رقّت بوصف جمالك الأقوال","ورأتك فأفتتنت بك العذال",19,"ل",1,1],["رقّت أعليه وأسفله الذي","في الأفق اشبع عصفرا محلولا",20,"ل",2,0],["رقت لكم في الرافدين مودّة","كَندى الغيوم تضاحكت ببروق",21,"ق",1,0],["رقة فاقت النسيم إلى شدّ","ة بأس تفتّت الجلمودا",22,"د",2,0],["رقى من أعاليها الفنغراف منبراً","محاطاً بأصحاب غطارفة غر",23,"ر",1,0],["رَقِّع مَتاعَكَ إِنَّ جَدّي خالِدٌ","وَالقَينُ جَدُّكَ لَم تَلِدكَ نِزارُ",24,"ر",1,0],["رَقَصَت نِساءُ بَني المُهَلَّبِ عَنوَةً","رَقصَ الرِئالِ وَما لَهُنَّ خِمارُ",25,"ر",1,0],["رَقَصَت بِعاجِنَةِ الرَحوبِ نِساؤُكُم","رَقصَ الرِئالِ وَما لَهُنَّ ذُيولُ",26,"ل",1,0],["رَقَمِيّاتٍ عَلَيها ناهِضٌ","تُكلِحُ الأَروَقَ مِنهُم وَالأَيَل",27,"ل",1,0],["رقيت إلى النجوم فجئت منها","بأحسن صورةٍ تهدي وتهدى",28,"د",2,0],["رَقبَ الوشاةُ جفونها","فإذا همُ بالساهرَه",29,"ر",2,0],["رقّ النسيم كرقتى من بعدكم","فكأننا في حبِّكم نتعاير",30,"ر",1,1],["رقمت ثياب غصونه إبر الحَيا","والرقم أحسن ما يكونُ مزهرا",31,"ر",2,0],["رقمت بنو أيوب نسخة أصلها","وأتى فكان تمامها وكمالها",32,"ل",3,0],["رقمت حلة الرياض فخلنا","أن روضاً قد استعار خلاله",33,"ل",2,0],["رقت على زاهر أفق الهدى","زهراء في أنجمها الناجمهْ",34,"م",2,0],["رقيق فما الصهبا لديه ذكية","وجزل فما الرمح المدرَّب ملسان",35,"ن",1,0],["رقوا ما رقوا من سؤدد ثم قوّضوا","فزادَ على ما أنهجوه من العلا",36,"ل",2,0],["رَقيبانِ مِنّي شاهِدانِ لِحُبِّهِ","وِاِثنانِ مِنّي شاهِدانِ تَراني",37,"ي",1,1],["رِقاقَ الثنايا عِذَابَ الغُروب","صِغارَ القلوب ضِعافَ القُوى",38,"ا",1,0],["رُقَى العقاربِ أو هذْرُ البُناةِ إذا","أضحوا على شَعَفِ الجدران في صخبِ",39,"ب",1,0],["رقَقْتُ له من قبحه المحْضِ رِقَّةً","ألاَنْت لهُ قَلْبِي فَقَادَتْ له وُدِّي",40,"ي",1,0],["رُقادَك لا تسهر إلى الليل ضلَّةً","ولا تَتجشَّمْ فيَّ حَوْك القصائدِ",41,"د",1,0],["رقابُ أَهلِ الحُلُوم مُعْتَبَدَهْ","مقصودةٌ بالهوان مُعْتَمَدَهْ",42,"د",2,1],["رقدْتُ وما ليلُ الغريب براقدِ","وما راقدٌ لم يرْعَ نجماً كساهدِ",43,"د",1,1],["رقّاصةٍ في البطن كبَّادةٍ","موقعة في الرأس صفّاعه",44,"ع",2,0],["رقعة في الملك ليست بزين","أي ثوب زينته الرقاع",45,"ع",1,0],["رقت مياه وجوههن لناظر","وقلوبهن عليه غير رقاق",46,"ق",1,0],["رق الصنائع في الرقاب وأسرها","ما منهما وأبيك إلا باقي",46,"ق",2,0],["رقَّ آبٌ وما ترقُّ لعبدِكْ","من جَوَى قلبِهِ ومن طولِ صدِّكْ",47,"ك",1,1],["رقيقُ طرازِ الظَّرفِ لكنَّ جُودَه","كثيفُ الحيا ذو عارِضٍ متراكمِ",48,"م",1,0],["رقْرقتْهُ الشَّمال والرعد والبَرْ","قُ وفيْقاتُ وابل سجّام",49,"م",1,0],["رقعةٌ من مُعاتبٍ لك ظَلَّتْ","ولها في ذَراك مثوىً مُهانُ",50,"ن",1,1],["رَقَدَ العِدى فَتَحَمَّسوا حَتّى إِذا","جَدَّ الوَغى رَكِبوا العُقاب وَطاروا",51,"ر",3,0],["رَقَصَت أَشِعَّتُها عَلى سَطحِ الدُجى","وَعَلى رَجاءٍ فِيَّ غَيرَ مُشَعشَعِ",52,"ع",1,0],["رَقَّت عَلَيَّ نُجومُها وَتَواضَعَت","حَتّى لَكِدتُ أَحُسُّها في مَفرِقي",53,"ق",2,0],["رَقَّت حَواشيها وَاِخضَرَّ جانِبُها","وَأَجمَلُ الأَرضِ ما رَقَّت حَواشيها",54,"ي",3,0],["رَقَّ في الجَوِّ النَسيمُ","فَتَفَضَّل يا نَديمُ",55,"م",1,1],["رَقيتَ هِضابَ العُلى مُسرِعاً","كَأَنَّكَ مُنحَدِرٌ مِن صَبَب",56,"ب",1,0],["رَقَّ عَلى قَلبِ العَميدِ الَّذي","يَوَدُّ أَن يَجري عَلى بالكِا",57,"ك",2,0],["رقدت ههنا فتاة لبيبه","ذات حسن في عنفوان الشبيبه",58,"ب",2,1],["رقيت مصر في نظارة سعد","درجات كما الزمانَ يودُّ",59,"د",1,0],["رقيت من الجماد فصرت حياً","تميِّره الدراية والذكاءُ",60,"ا",2,0],["رقَت بأناس جاهلين حظوظهم","إلى رتب في الجاه والحظ مرقاة",61,"ه",1,0],["رَقَدَ الثائِرُ إِلّا ثَورَةً","في سَبيلِ الحَقِّ لَم تَخمُد جُذاها",62,"ا",3,0],["رَقَّ النَسيمُ عَلى دُجاهُ لِأَنَّتي","وَرَثى لِحالي في السَماءِ أَخوكِ",63,"ك",1,0],["رَقَّت كَنُدمانِ المُلوكِ خِلالُهُم"