d=170519",""],[5277,"دمعةٌ على وجنةِ الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=189757",""],[5277,"وا جدّاه","https://www.poetsgate.com/ViewPoem.aspx?id=191633",""],[5277,"داليّةٌ وداليَه","https://www.poetsgate.com/ViewPoem.aspx?id=196863",""],[5280,"سيدنا محمد رسول الله ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=189571",""],[5338,"معارضة قصيدة بات سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=187941",""],[5431,"لسيدي محمد رسول الله (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=198211",""],[5431,"قلبٌ من الحلوى ..لحبيبي رسول الله (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=206463",""],[5447,"رمشاك","https://www.poetsgate.com/ViewPoem.aspx?id=208293",""],[5452,"منتظر الزايدي","https://www.poetsgate.com/ViewPoem.aspx?id=119180",""],[5493,"هذا الحزين","https://www.poetsgate.com/ViewPoem.aspx?id=204450",""],[5533,"ما زَلتُ أنتَظِرُ الخَبَر","https://www.poetsgate.com/ViewPoem.aspx?id=176657",""],[5562,"قارئ الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=190067",""],[5690,"اللّه أكبرُ هذا عصر تجديدِ","https://www.poetsgate.com/ViewPoem.aspx?id=172153",""],[5732,"قالوا علامك","https://www.poetsgate.com/ViewPoem.aspx?id=177885",""],[5776,"خاتمٌ بلا إصبع","https://www.poetsgate.com/ViewPoem.aspx?id=199329",""],[5781,"قلبي على شفاهه والسَّحَر !","https://www.poetsgate.com/ViewPoem.aspx?id=208946",""],[5829,"إلى روح الشهيد العلامة البوطي","https://www.poetsgate.com/ViewPoem.aspx?id=153911",""],[5831,"سجدة كربلاء","https://www.poetsgate.com/ViewPoem.aspx?id=20398",""],[5887,"كفكف الدمع أنت على الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=37214",""],[5926,"ذكريات لم تنتهِ بعد","https://www.poetsgate.com/ViewPoem.aspx?id=213775",""],[5956,"الله بوَّأ فريد الأطرش وأختَهُ رتبةً أُولى","https://www.poetsgate.com/ViewPoem.aspx?id=203554",""],[5956,"هذا الحسامُ نموذج فعَّالُ","https://www.poetsgate.com/ViewPoem.aspx?id=204690",""],[6070,"قُمْ وافتَحْ الصََندوقَ والأبوابا","https://www.poetsgate.com/ViewPoem.aspx?id=193902",""],[6093,"قلقٌ تجذَّرَ في الفؤادِ وفي الحشا","https://www.poetsgate.com/ViewPoem.aspx?id=176519",""],[6117,"تُمِّمَتْ أخْلاَقُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=182796",""],[6152,"المساء الخصيب","https://www.poetsgate.com/ViewPoem.aspx?id=203034",""],[6202,"هوى وشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86757&r=&rc=58",""]],"verses":[["هَذا الحُسَينُ وَقَد جَذَبتَ بِضَبعِهِ","جَذباً يُمِرُّ قَرائِنَ الأَرحامِ",0,"م",1,0],["هَذا الحُسَينُ إِلى عَلائِكَ يَنتَمي","شَرَفاً وَيَنسِبُ مَجدَهُ في المَحفِلِ",1,"ل",1,0],["هذا الحريق وكل يوم ناره","تغدو عليكم تارةً وتروح",2,"ح",1,0],["هذا الحبيب وذا فكري وذا جلدِي","في راحتيه فقل لي كيف أنساه",3,"ا",2,0],["هَذا الحسينُ دَمُهُ بكربلا","رَوّى الثَرى لَما جَرى عَلى ظَما",4,"ا",1,0],["هَذا الحَبيبُ فَمَرحَباً بِخَيالِهِ","أَنّى اِهتَدى وَاللَيلُ في سِربالِهِ",5,"ل",2,1],["هَذا الحِمارُ مِنَ الحَميرِ حِمارُ","ناحَت عَلَيهِ حَليَّةٌ وَعِذارُ",6,"ر",1,1],["هذا الحريرُ الغَضُّ مَلْمِسُهُ","حَيْفٌ يُخَدِّشُ جَنْبهُ الوبر",7,"ر",1,0],["هَذَا الحَدِيثُ عَلَى الأقلام مبريَّهُ","بِالرُوحِ حِبْرٌ عَلَى الألْوَاحِ أَجْرَاهُ",8,"ا",2,0],["هذا الحِمى فانزلوا طُرّاً بحومتِهِ","وكبِّروا واسجدوا في شَطْر قِبْلَتِهِ",9,"ت",2,1],["هَذا الحِمى وَرَندُهُ وَبانُهُ","وَشِيحُهُ فاوَحَهُ حَوذانُهُ",10,"ن",2,1],["هَذا الحالي بِكُلِّ حُسنٍ","ما أَعجَبَ في هَواهُ حالي",11,"ل",2,0],["هَذا الحِجازُ وَذاك ضاله","قَد قُلِّصت عنه ظِلالُه",12,"ل",2,1],["هَذا الحسينُ بنُ الحسينِ أَخو العُلى","عَلِقت يدي منه بودٍّ أقعسِ",13,"س",1,0],["هَذا الحسين قتيلاً رهنَ مصرعه","يَبكي له كُلُّ تَهليل وَتَكبيرِ",14,"ر",1,0],["هَذا الحسينُ ثَوى بالطفِّ منفرداً","تَسفي عليه سَوافي التُرب والمورِ",14,"ر",1,0],["هَذا الحَديثُ وَما يَخفى عَلى فَطَنِ","إِنّي أَرَدتُ بِهِ التَنبيهِ فَاِعتبَرِ",15,"ر",1,0],["هذا الحبيبُ الذي في القلب مسكنهُ","عليه ذُقتُ كؤوسَ الذل والمحنِ",16,"ن",1,1],["هذا الحسينُ حياةٌ خُلِّدتْ لهمُ","ليسوا بأوّل موتَى بابنهم نُشروا",17,"ر",3,0],["هذا الحسينُ فخذ عيناً ودعْ خَبراً","من الروايات عنهم والأسانيدِ",18,"د",1,0],["هذا الحِمى فدعاني في مرابعِه","أجُرُّ للهو في ساحاتِه الرَّسنَا",19,"ن",2,0],["هذا الحديث الذي قد قصّه علنا","عند النضال محاميهم وان هضموا",20,"م",3,0],["هذا الحُدوثُ به خَفِيٌّ ظاهِرٌ","وبسرِّهِ قد حارَتِ البُلَغاءُ",21,"ا",2,0],["هذا الحِمى فاِنزِلْ على جَرعائِهِ","واِحْذَرْ ظُبا لَفَتاتِ عِينِ ظِبائِهِ",22,"ا",3,1],["هذا الحِمى يا فتى فاِنزِل بحَوْمتِه","واِخضَع هنالكَ تعظيماً لحُرمتِهِ",23,"ت",2,1],["هَذا الحَبيب وَصَفوَة الجَبار","أَزَلاً وَلا أَثَر مِن الآثارِ",24,"ر",1,1],["هَذا الحَياة لِعاشق هَذا الكَفي","ل لصادق بِالجبر وَالأَبرار",24,"ر",1,0],["هذا الحبيب الذي مع بعده عنّا","ما عنَّ لي أنني أسلوه ما عنّا",25,"ن",2,0],["هذا الحبيب الذي بالقهر غيّرهم","وبالعملْ بخلاف الشرع عيَّرهم",26,"م",1,1],["هذا الحكيمُ الكاملُ الفرْدُ الذي","مُزِجَتْ بحكمتِهِ مَخافةُ ربِّهِ",27,"ب",2,0],["هَذَا الحَدِيْدُ سِلاَحُ أَبْطَالِ الوَغَى","وَبِهِ يُرِيْقُ دِمَاءَنَا الحَجَّامُ",28,"م",1,0],["هذا الحميد الخليق لم يُخلق لنا","غلا لكي يُثنى عليه ويحمدا",29,"د",2,0],["هذا الحُسينُ قضى فالدين يندبهُ","بصوتِ شجوٍ ومنه الطرفُ ما هَجَعا",30,"ع",2,0],["هذا الحُسين ومَن بسا","ق العَرشِ خطّ اللّه إِسمه",31,"م",2,0],["هذا الحُسين وهل مثل الحسين فتى","سادَ الرجالَ أَلا أفديه من رجلِ",32,"ل",1,0],["هذا الحبيب تجلى وهو محتجب","نائى المزار بعيدٌ وهو مقترب",33,"ب",1,1],["هذا الحَماحِمُ زَهرٌ","فيهِ حَياةُ النُفوسِ",34,"س",1,1],["هَذا الحمامُ فَأَطرِبنَّ وَغرِّدِ","وَاِذكُر عُهُودَكَ بِالعَقيقِ وَجَدِّدِ",35,"د",1,1],["هذا الحبيب أتى إلينا مقبلاً","يغشى النواحيَ بالعبير النافحِ",36,"ح",1,0],["هذا الحبيبُ سرى بصبح جبينه","وأتى وقد صدع الدجى بفَرنْده",37,"د",2,0],["هذا الحسين بكربلاء","ثوى وليس له نصير",38,"ر",1,0],["هذا الحسين بكر بلا متوسداً","وعر الصخور لقىً على عرصاتها",39,"ت",3,0],["هذا الحطيم وزمزم فاحطم على","شرب الشفا طوبى لمن يتضلّع",40,"ع",1,0],["هَذا الحطيمُ وَبَيت فيهِ مُلتَزم","وَزَمزَم وَالصفا وَالركن وَالميلُ",41,"ل",1,0],["هذا الحمى أين الرَّفيق المنجد","قد يمَّم الخيف الفريق المنجدُ",42,"د",1,1],["هذا الحسينُ وكانَ يس","تسقي بطلعته الغيوم",43,"م",1,0],["هَذا الحَبيبُ وَهَذِهِ الصَهباءُ","عَذلُ المُصِرِّ عَليهِما إِغراءُ",44,"ا",2,1],["هذا الحنيف يسير تحت ظلالها","فخم الجلالة سامي الأعلام",45,"م",1,0],["هذا الحسين قد انتضى","سيفا يدكّ الراسيه",46,"ي",2,0],["هذا الحبيب معفر ال","خدين في عفر المهاد",47,"د",1,0],["هذا الحديث بطوله وسياقه","وتمامه في سنة الطبراني",48,"ن",2,0],["هذا الحِيَا قالوا عِميم","أسْقى البحَر وَيَّا الفَلاه",49,"ا",2,0],["هذا الحرير يحاكي في تخطُّفه","سوانح الفكر بين النوم والأرق",50,"ق",1,0],["هذا الحسين المجتبى ناله","في موكب لطفُ خفي الاياد",51,"د",1,0],["هذا الحفيد السعيد الجد طالعه","في أمنه بالكرى عوضت عن سهرك",52,"ك",1,0],["هذا الحبيب الذي أوحى لي الشعرا","هذا هو البحر أسدي نحوه الشكرا",53,"ر",2,1],["هذا الحبيب الذي بالحب بادلني","فما شكوت له صدّاً ولاهجرا",53,"ر",2,0],["هذا الحديد لحر نارك لين","وحديد قلبك لا يلين لناري",54,"ي",1,0],["هَذَا الحِمى فانزلْ عَلَى أرجائه","فلَطالما صَدع الصَّفا ببكائِهِ",55,"ا",3,1],["هَذا الحسين وَذاكَ أَوّل من دَعا","وَالرأس أَولى بالعلا أَن ترأسا",56,"س",2,0],["هذا الحبيب المفدّى","لا سامه الدهر هجراً",57,"ر",2,0],["هذا الحسين له في مصرنا حرم","لكن جلال بفيض الفضل مشمول",58,"ل",1,0],["هذا الحسين المحتشم","صدر النوال في الندى",59,"د",2,1],["هذا الحَبيب المُرتَجى خير الوَرى","نور الهدى بِهداه أشرَقت الدنا",60,"ن",2,0],["هذا الحسين وذكره باقٍ وإن","أخفى الزمانُ لسانَه متعمدا",61,"د",2,0],["هذا الحمادي الذي حمد الورى","منهُ وأمست بالفضايل عاليه",62,"ي",2,0],["هذا الحنين لموطني لَهَبٌ طغى","حتّى ولو غصبتهُ أشرارُ القرون",63,"ن",1,0],["هذا الحبيب لنا ليوم معادنا","ذخر وشافعنا بدار بقاء",64,"ا",2,0],["هذا الحديث اللي تبي أدري بحبك نلتني","بس البدايات بقدر حتى النهايات بقدر",65,"ر",1,0],["هذا الحساب يفوت أوهام الورى","ويحوزه الهندي بتسعة أحرف",66,"ف",1,0],["هذا الْحُسَينُ زَهَتْ مَنائِرُهُ","أَيْنَ الْيَزيدُ وَنَغْلُهُ الشَّمْرُ",67,"ر",1,0],["هذا الْحُسَينُ حُشودُهُ عَجَبٌ","وَقُرى الْيَزيدِ عِدادُها الصُّفْرُ",67,"ر",1,0],["هذا الْحِجاجُ تَجرّدَتْ أنْصالُهُ","لَمّا الدُّعاةُ يُصيبُها الْإخْفاقُ",68,"ق",1,0],["هذا الْحسينُ بنورِ نهْضتِهِ","بدمائِهِ قمعَ الْهدى الْكفْرا",69,"ر",2,0],["هَذَا الْحِصَارُ اعْتَادَهُ أَطْفَالُنَا","وَصُمُودُنَا إعْتَادَهُ الْغُرَبَاءُ",70,"ا",2,0],["هذا الحنينُ سَقَى قلبي قِيَامَتَهُ","وَزَلزَلَ الثَّغْرُ مَا أَبقَتْ بِيَ المقَلُ",71,"ل",1,0],["هَٰذَا الحَبِيْبُ مِنَ العِرَاقِ ... هَلَاْ وَحَيَّا","كَالصُّبْحِ .. أَحْلىْ مِنْ ذُكًاءَ رُؤىً وَرَيَّا",72,"ي",2,1],["هَذَاْ الْحَرِيْقُ بِغَرْبِ الْعَيْنِ أَدْمُعُهُ","لمَّاْ تَشَاْكَىْ عَزِيْزُ الدَّاْرِ وَالْأَلَبِ",73,"ب",1,0],["هَذَا الْحَنِينُ إِلَيْكَ الْيَوْمَ يَحْمِلُنِي","لَا مَاءَ أَعْرِفُهُ فِي الْبَحْرِ يَضْطَرِبُ",74,"ب",1,0],["هَذَا الْحَنِينُ مُلَاءٌ تَرْتَجِي حُلُماً","يَلُفُّ طَيْفَاً إِذَا مَا ارْتَاحَ فِي الأَثَرِ",75,"ر",1,0],["هذا الحواريُّ استوى في نظرتي","نجمًا يضيئ الكونَ من أسمائه ِ",76,"ا",3,0],["هذا الحميد ابن الحبيب وقد","كنا نود لو أنه يصل",77,"ل",1,0],["هذا الحمام على دارِ الحبيبِ أتى","وفوقها إثر ركبِ القومِ قد هدلا",78,"ل",2,0],["هذا الحسينُ .. وقد سمونَ جراحُهُ","تختالُ مثلَ النجمِ وسطَ سمائِهِ",79,"ا",3,0],["هذا الحُسينُ وأيُّ سبطٍ مثلُهُ ؟","قدْ طابتِ الأطهارُ من آبائِهِ",79,"ا",3,0],["هذا الحُسينُ شهيدُنا منْ مثلُهُ ؟؟","مُتخضباً بالنصرِ وسطَ دمائِهِ",79,"ا",3,0],["هذا الحُسينُ أبو الأئمةِ سفرُهُ","سفرُ الخلودِ .. مرفرفٌ بلوائِهِ",79,"ا",3,0],["هذا الحُسينُ وإنهُ نبعُ الندى","يروي العطاشى .... والهدى بروائِهِ",79,"ا",3,0],["هذا الحُسينُ ... الظلُّ في أفيائِهِ","ظلُّ الهدايةِ في رُبى أفيائِهِ",79,"ا",3,0],["هذا الحُسينُ نحبُهُ حبَّ الهدى","صوتُ الهدايةِ تحتَ صوتِ ندائِهِ",79,"ا",3,0],["هذا الحُسينُ وهذهِ أسماؤُهُ","وأنا أهيمُ اليومَ في أسمائِهِ",79,"ا",3,0],["هذا الحُسينُ وهذه أنباؤُهُ","فليشهدْ التاريخُ عن أنبائِهِ",79,"ا",3,0],["هذا الحُسينُ الشمسُ تكسِفُ دونَهُ","خجلاً وإنَّ كسوفَها لحيائِهِ",79,"ا",3,0],["هذا الحُسينُ وما أقولُ بمدحةٍ","إنَّ الحُسينَ المدحُ بعضُ ثنائِهِ",79,"ا",3,0],["هذا الحُسينُ وفي الطفوفِ دماؤُهُ","وهنا الطفوفُ مضمخٌ بسنائِهِ",79,"ا",3,0],["هذا الحنينُ لطيبةٍ يسقي الندى","فيجيشُ في قلبٍ معَ الحبِّ اتَّعدْ",80,"د",1,0],["هذا الحبيبُ الذي في يَمِّهِ عُصِمت","كلُّ القلوبِ على ألواحِ مُعتَصِمِ",81,"م",1,0],["هَذَا الحُسَيْنُ ثَلاثًا بِالعَرَاءِ لَقَىً","مُزَمَّلًا بالدِّما يَكْسوهْ تَرْميلُ",82,"ل",1,0],["هذا الحبيبُ على الرؤيا يُبشِّرُني","لأجعلَ العمرَ عَهْداً كُلهُ شَرَفُ",83,"ف",1,0],["هذاالحبيبُ وهَلَّتْ مِنهُ تَزكِيَةٌ","أنِّي حفيدتُهُ ذا المُرسَلُ الأَنِفُ",83,"ف",1,0],["هذا الحبيبُ وهذاالقمحُ ينثرُهُ","قمحُ الجياعِ يداوي وهنَ مَن ضَعفُوا",83,"ف",3,0],["هذا الحبيب أتى للجوع مائدة","قلبٌ من التمر أخلاقٌ من الحلوى",84,"و",2,0],["هذا الحنينُ رسولُنا في بُعدنا","ولدى التقاربِ لا يقيمُ بعيدا",85,"د",2,0],["هذا الحذاء أراه اليوم معجزة","كيف الصّروح بلمس العهن تنهار",86,"ر",1,0],["هذا الحذاء يساوي ألف معركة","بنصرها النّاس في الأمصار سمّار",86,"ر",1,0],["هذا الحزينُ همومُه ضاقتَ بهِ","سفنُ الحياةِ تقودُهُ لمصبِّهِ",87,"ب",2,1],["هذا الحزينُ حكايةٌ منسيةٌ","أدْمتْ قلوبَ الراقدينَ بهُدبهِ",87,"ب",2,0],["هَذا الحَبِيْبُ إذا عَبَرْ","أَوْ جَاءنِي مِنْهُ خَبَرْ",88,"ر",1,1],["هذا الحنيفيُّ عِرفاناً خُلاصةُ ما","في الكونِ من رحمةٍ لن تنتهي أبدا",89,"د",2,0],["هذا الحكيم الذي نروي لهُ حكماً","كما رووا عن سليمان بن داودِ",90,"د",1,0],["هذا الحبيب اللي له القلب مرهون","هذا حياة لبروح بدر الكمالا",91,"ل",2,0],["هذا الحَاصِلُ لا تَتَغَابى","فالخاتمُ ينساهُ المعصمْ",92,"م",1,0],["هذا الحبيبُ رسمتُهُ","بِدمِ الخُدودِ وبِالعَقيقِ",93,"ق",1,0],["هذا الحبيب فهل يسجى دوننا","وتضمه من بعد أوصال القبر",94,"ر",1,0],["هذا الحسينُ بنورِه وجلالهِ","مشتشهَدٌ متجددٌ يُضفي سناءْ",95,"ا",2,0],["هذا الحديث كتمته في أضلعي","لما أخذت إلى القضاء مقيدا",96,"د",2,0],["هذا الحنين يهب مثل عواصفٍ","يجتث أزهار الفؤاد ونرجسه",97,"س",2,0],["هذا الحنونُ الصوتِ كاليَعفورِ","دوماً يُغرِّد في سماء شُعوري",98,"ر",2,1],["هذا الحسامُ نموذج فعَّالُ","لمكارم الأخلاق وهي النَّالُ",99,"ل",1,1],["هذا الحبيبُ المصطفى عنوانُهُ","خُلقٌ عظيمٌ ذكرُهُ قَدْ طابا",100,"ب",2,0],["هذا الحسينُ وكيفَ تبصرُ مثلَهُ","فاللهُ يعطي ما يشاءُ لمن يشا",101,"ش",2,0],["هذا الحبيبُ نبيُّ الله ينشدنا","نصرَ النبوةِ يرمي صفوها الشررُ",102,"ر",1,0],["هذا الحنين إليكِ قض مضاجعي","وله إذا حل الظلام وجيب",103,"ب",1,0],["هذا الحبيب بحبه","لغدوت أشعر من شعر",104,"ر",1,0]]}