{"poems":[[53,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[88,"قال قولا به استحق احتراما","https://www.aldiwan.net/poem44825.html","الخفيف"],[89,"يعلم من قد وزن الليل والنهار","https://www.aldiwan.net/poem44660.html","السريع"],[45,"عند العقيق فماثلات دياره","https://www.aldiwan.net/poem63562.html","الكامل"],[61,"صدودك علم النوم الصدودا","https://www.aldiwan.net/poem51720.html","الوافر"],[49,"حتى متى أنا في حل وترحال","https://www.aldiwan.net/poem64305.html","البسيط"],[80,"خيالك للأجفان مثله الفكر","https://www.aldiwan.net/poem31436.html","الطويل"],[75,"نظرت كما جلت عقاب على إرم","https://www.aldiwan.net/poem69035.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54557","الكامل"]],"verses":[["أَنا زُهَيرٌ فَمَن لي في زَمانِكَ ذا","بِبَعضِ ما اِقتَرَفَت عَنهُ يَدا هَرِمِ",0,"م",1,0],["إن إزمير صيّرت ما لولسو","ن من الخر في فيومة ذاما",1,"م",2,0],["ان ازدياد واحد منهما","معادل للنقص في الثاني",2,"ي",1,0],["إِن أَزعَجَتكَ مِنَ الزَمانِ مُلِمَّةٌ","فَاِندُب رَبيعَتَهُ لَها اِبنَ نِزارِهِ",3,"ر",2,0],["أُنازِعُه اللِّحاظَ فإن تَصدَّى","لنا واشٍ تَنازَعنا الصُّدودا",4,"د",2,0],["أُنازِعُ الدَهرَ ما أَنفُكَ مُغتَرِباً","عَنِ الأَحِبَّةِ لا يَدرونَ ما حالي",5,"ي",1,0],["أنازحةَ الدَّارِ الَّتي لا أزورها","إذا لم يُشقَّ البحرُ أو يُقْطَعِ القفرُ",6,"ر",1,0],["أُنازِعُها باللَحْظِ سِرّاً كأنّمَا","تعلّمَ منها اللحظُ ما نَسيَ القَلَم",7,"م",1,0],["إِنْ َأزْمَعُوا لَمْ يَرْجِعُوا أَوْ صَمَّمُوا","بَلَغُوا النَّجَاحَ وَمَا لَوَوْا بِمَصَاعِبِ",8,"ب",1,0]]}