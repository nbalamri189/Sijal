{"poems":[[53,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[88,"قال قولا به استحق احتراما","https://www.aldiwan.net/poem44825.html","الخفيف"],[89,"يعلم من قد وزن الليل والنهار","https://www.aldiwan.net/poem44660.html","السريع"],[45,"عند العقيق فماثلات دياره","https://www.aldiwan.net/poem63562.html","الكامل"],[61,"صدودك علم النوم الصدودا","https://www.aldiwan.net/poem51720.html","الوافر"],[49,"حتى متى أنا في حل وترحال","https://www.aldiwan.net/poem64305.html","البسيط"],[80,"خيالك للأجفان مثله الفكر","https://www.aldiwan.net/poem31436.html","الطويل"],[75,"نظرت كما جلت عقاب على إرم","https://www.aldiwan.net/poem69035.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54557","الكامل"],[115,"اعلل بالخيال جريح قلبي","https://www.aldiwan.net/poem40627.html","عموديه"],[124,"أنازح أنت لم تمنن علي بما","https://www.aldiwan.net/poem23808.html","البسيط"],[142,"شدوا على ظهر الصبا رحلى","https://www.aldiwan.net/poem58410.html","السريع"],[155,"سلكان للدمع محلول ومعقود","https://www.aldiwan.net/poem55734.html","البسيط"],[211,"أيها الحب وبالذكرى أراك","https://www.aldiwan.net/poem46313.html","الرمل"],[229,"جرحي بعينيك ليس يندمل","https://www.aldiwan.net/poem50867.html","المنسرح"],[379,"قد علمت أني مروي هامها","https://www.aldiwan.net/poem4583.html","الرجز"],[409,"رجلاي والسبعون قد أوهنت","https://www.aldiwan.net/poem32193.html","السريع"],[461,"خذ ما تشاء من الأيام أو فذر","https://www.aldiwan.net/poem15097.html","البسيط"],[553,"تحملت هجر الشادن المتدلل","https://www.aldiwan.net/poem68417.html","الطويل"],[558,"لهب النار في الفتيلة كالرو","https://www.aldiwan.net/poem34711.html","الخفيف"]],"verses":[["أَنا زُهَيرٌ فَمَن لي في زَمانِكَ ذا","بِبَعضِ ما اِقتَرَفَت عَنهُ يَدا هَرِمِ",0,"م",1,0],["إن إزمير صيّرت ما لولسو","ن من الخر في فيومة ذاما",1,"م",2,0],["ان ازدياد واحد منهما","معادل للنقص في الثاني",2,"ي",1,0],["إِن أَزعَجَتكَ مِنَ الزَمانِ مُلِمَّةٌ","فَاِندُب رَبيعَتَهُ لَها اِبنَ نِزارِهِ",3,"ر",2,0],["أُنازِعُه اللِّحاظَ فإن تَصدَّى","لنا واشٍ تَنازَعنا الصُّدودا",4,"د",2,0],["أُنازِعُ الدَهرَ ما أَنفُكَ مُغتَرِباً","عَنِ الأَحِبَّةِ لا يَدرونَ ما حالي",5,"ي",1,0],["أنازحةَ الدَّارِ الَّتي لا أزورها","إذا لم يُشقَّ البحرُ أو يُقْطَعِ القفرُ",6,"ر",1,0],["أُنازِعُها باللَحْظِ سِرّاً كأنّمَا","تعلّمَ منها اللحظُ ما نَسيَ القَلَم",7,"م",1,0],["إِنْ َأزْمَعُوا لَمْ يَرْجِعُوا أَوْ صَمَّمُوا","بَلَغُوا النَّجَاحَ وَمَا لَوَوْا بِمَصَاعِبِ",8,"ب",1,0],["انازل فيه آلامي ووجدي","ومالي في منازلتي ظلال",9,"ل",1,0],["أنازح أنت لم تمنن علي بما","أبغي وتاركني ولهان حسرانا",10,"ن",2,1],["إن ازمعوا صرما فلِمْ عَقدوا","يومَ الكثيب بحبلهم حبلى",11,"ل",2,0],["إِنْ أَزْمَعَتْ عنكِ صَبْراً أُبْدِلَتْ بِجَوىً","مَعْدومُهُ بِكِ طُولَ الدَّهْرِ مَوْجودُ",12,"د",1,0],["أنا زيّنت لكم لو تعقلون","صفحة الكون وأسفار الوجود",13,"د",1,0],["أنا زعيمٌ لكُمْ بواحِدةٍ","تَقْتَصُّ مِنكمْ بِرُزْئِها الْجُمَل",14,"ل",1,0],["أنازح الزكي من جمامها","اذا جعلت الدلو من خطامها",15,"م",3,0],["أنازِلُ الأقرانَ يُرديهِمُ","من قَبلِ ضَربي هامَهمُ رُعْبِي",16,"ي",1,0],["أنازعُ الملك الطاغي وسادته","ويحجبون عن التسليم والنَّظَر",17,"ر",1,0],["أُنازِعُها سِرَّ الحَديثِ وَتارَةً","رُضاباً لَذيذَ الطَعمِ عَذبَ المُقَبَّلِ",18,"ل",1,0],["إن أزالوه أشرق النور حساً","فأضاءت به جهات البيت",19,"ت",1,0]]}