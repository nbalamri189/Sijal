{"poems":[[55,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[90,"قال قولا به استحق احتراما","https://www.aldiwan.net/poem44825.html","الخفيف"],[91,"يعلم من قد وزن الليل والنهار","https://www.aldiwan.net/poem44660.html","السريع"],[47,"عند العقيق فماثلات دياره","https://www.aldiwan.net/poem63562.html","الكامل"],[63,"صدودك علم النوم الصدودا","https://www.aldiwan.net/poem51720.html","الوافر"],[51,"حتى متى أنا في حل وترحال","https://www.aldiwan.net/poem64305.html","البسيط"],[82,"خيالك للأجفان مثله الفكر","https://www.aldiwan.net/poem31436.html","الطويل"],[77,"نظرت كما جلت عقاب على إرم","https://www.aldiwan.net/poem69035.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54557","الكامل"],[119,"اعلل بالخيال جريح قلبي","https://www.aldiwan.net/poem40627.html","عموديه"],[128,"أنازح أنت لم تمنن علي بما","https://www.aldiwan.net/poem23808.html","البسيط"],[146,"شدوا على ظهر الصبا رحلى","https://www.aldiwan.net/poem58410.html","السريع"],[159,"سلكان للدمع محلول ومعقود","https://www.aldiwan.net/poem55734.html","البسيط"],[215,"أيها الحب وبالذكرى أراك","https://www.aldiwan.net/poem46313.html","الرمل"],[234,"جرحي بعينيك ليس يندمل","https://www.aldiwan.net/poem50867.html","المنسرح"],[384,"قد علمت أني مروي هامها","https://www.aldiwan.net/poem4583.html","الرجز"],[415,"رجلاي والسبعون قد أوهنت","https://www.aldiwan.net/poem32193.html","السريع"],[466,"خذ ما تشاء من الأيام أو فذر","https://www.aldiwan.net/poem15097.html","البسيط"],[558,"تحملت هجر الشادن المتدلل","https://www.aldiwan.net/poem68417.html","الطويل"],[563,"لهب النار في الفتيلة كالرو","https://www.aldiwan.net/poem34711.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138227",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83259","الخفيف"],[611,"","https://poetry.dctabudhabi.ae/diwan/poem/84956","الرجز"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104033","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120056","السريع"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16757","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17080","الوافر"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126149","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46516","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78172","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49582","الطويل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76610","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93657","الطويل"],[2491,"","https://poetry.dctabudhabi.ae/diwan/poem/115052","المنسرح"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100366","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100327","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132733","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87402","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48367","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109955","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59460","الكامل"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32643","الخفيف"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2564","الطويل"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111195","الطويل"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22792","الرمل"],[4802,"شاعر طبل","https://www.poetsgate.com/ViewPoem.aspx?id=32340",""],[4869,"الحشيمه","https://www.poetsgate.com/ViewPoem.aspx?id=151642",""],[5072,"أنا زيد .. // زيد خالد علي","https://www.poetsgate.com/ViewPoem.aspx?id=51800",""],[5074,"هذهِ قِصَّتي","https://www.poetsgate.com/ViewPoem.aspx?id=153510",""],[5111,"هَامَانُ يَعْرِفُنِي","https://www.poetsgate.com/ViewPoem.aspx?id=212238",""],[5408,"أنا إمرأة","https://www.poetsgate.com/ViewPoem.aspx?id=190867",""],[5411,"لا فرْقَ عِنْدي","https://www.poetsgate.com/ViewPoem.aspx?id=185633",""],[5431,"جذب الظباء السمر إذْ تردُ","https://www.poetsgate.com/ViewPoem.aspx?id=198444",""],[5499,"مريض ابعاد","https://www.poetsgate.com/ViewPoem.aspx?id=178232",""],[5533,"اِرْتفاعُ ضَغْطِ الدَّم","https://www.poetsgate.com/ViewPoem.aspx?id=176252",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5606,"مرحبا بالمراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=197469",""],[5691,"وجبة تحقيق","https://www.poetsgate.com/ViewPoem.aspx?id=206390",""],[5691,"فتنَةُ كربُلاء...!","https://www.poetsgate.com/ViewPoem.aspx?id=206635",""],[5746,"انتظرني..","https://www.poetsgate.com/ViewPoem.aspx?id=207108",""],[5851,"قلب بحجم الرؤى","https://www.poetsgate.com/ViewPoem.aspx?id=175288",""],[5875,"يانجد","https://www.poetsgate.com/ViewPoem.aspx?id=22694",""],[5956,"رحلةٌ نفسية","https://www.poetsgate.com/ViewPoem.aspx?id=183278",""],[5956,"ما عيب شهم أن يؤازر أشهما","https://www.poetsgate.com/ViewPoem.aspx?id=202505",""],[5956,"أ وَلم تضِق ذرعاً بعَون الناس؟","https://www.poetsgate.com/ViewPoem.aspx?id=215974",""],[6019,"دعيني","https://www.poetsgate.com/ViewPoem.aspx?id=53054",""],[6056,"الخنجر المذروب","https://www.poetsgate.com/ViewPoem.aspx?id=130515",""],[6209,"فطوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82548&r=&rc=17",""],[6218,"يقرّبُ حبُّ الناس حتفي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77480&r=&rc=66",""],[6323,"نفثة عاشق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82171&r=&rc=2",""],[5567,"كل البلاد أنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69063&r=&rc=3",""]],"verses":[["أَنا زُهَيرٌ فَمَن لي في زَمانِكَ ذا","بِبَعضِ ما اِقتَرَفَت عَنهُ يَدا هَرِمِ",0,"م",1,0],["إن إزمير صيّرت ما لولسو","ن من الخر في فيومة ذاما",1,"م",2,0],["ان ازدياد واحد منهما","معادل للنقص في الثاني",2,"ي",1,0],["إِن أَزعَجَتكَ مِنَ الزَمانِ مُلِمَّةٌ","فَاِندُب رَبيعَتَهُ لَها اِبنَ نِزارِهِ",3,"ر",2,0],["أُنازِعُه اللِّحاظَ فإن تَصدَّى","لنا واشٍ تَنازَعنا الصُّدودا",4,"د",2,0],["أُنازِعُ الدَهرَ ما أَنفُكَ مُغتَرِباً","عَنِ الأَحِبَّةِ لا يَدرونَ ما حالي",5,"ل",2,0],["أنازحةَ الدَّارِ الَّتي لا أزورها","إذا لم يُشقَّ البحرُ أو يُقْطَعِ القفرُ",6,"ر",1,0],["أُنازِعُها باللَحْظِ سِرّاً كأنّمَا","تعلّمَ منها اللحظُ ما نَسيَ القَلَم",7,"م",1,0],["إِنْ َأزْمَعُوا لَمْ يَرْجِعُوا أَوْ صَمَّمُوا","بَلَغُوا النَّجَاحَ وَمَا لَوَوْا بِمَصَاعِبِ",8,"ب",1,0],["انازل فيه آلامي ووجدي","ومالي في منازلتي ظلال",9,"ل",1,0],["أنازح أنت لم تمنن علي بما","أبغي وتاركني ولهان حسرانا",10,"ن",2,1],["إن ازمعوا صرما فلِمْ عَقدوا","يومَ الكثيب بحبلهم حبلى",11,"ل",2,0],["إِنْ أَزْمَعَتْ عنكِ صَبْراً أُبْدِلَتْ بِجَوىً","مَعْدومُهُ بِكِ طُولَ الدَّهْرِ مَوْجودُ",12,"د",1,0],["أنا زيّنت لكم لو تعقلون","صفحة الكون وأسفار الوجود",13,"د",1,0],["أنا زعيمٌ لكُمْ بواحِدةٍ","تَقْتَصُّ مِنكمْ بِرُزْئِها الْجُمَل",14,"ل",1,0],["أنازح الزكي من جمامها","اذا جعلت الدلو من خطامها",15,"م",3,0],["أنازِلُ الأقرانَ يُرديهِمُ","من قَبلِ ضَربي هامَهمُ رُعْبِي",16,"ب",2,0],["أنازعُ الملك الطاغي وسادته","ويحجبون عن التسليم والنَّظَر",17,"ر",1,0],["أُنازِعُها سِرَّ الحَديثِ وَتارَةً","رُضاباً لَذيذَ الطَعمِ عَذبَ المُقَبَّلِ",18,"ل",1,0],["إن أزالوه أشرق النور حساً","فأضاءت به جهات البيت",19,"ت",1,0],["أن أزرها بات مشدوداً فلا عجب","لها النفوس بما في وسعها سمحت",20,"ت",1,0],["إِن أَزالوكَ عَن رِآسَةِ حُكمٍ","لَم تَزَل صَدرَ دَولَةِ الأَفهامِ",21,"م",1,0],["أنا زياد بن أبي سفيان","جدي يرى من أشرف العربان",22,"ن",1,1],["أنا زَينٌ في الكفِّ ساعةَ أُجلى","ليس مثلي يحلُّ كفِّ الرئيسِ",23,"س",1,0],["إن أزمعت هجرا فوجدي بها","وجد خدين المجد بالحمدِ",24,"د",1,0],["أُنازِعُها بَدراً مَعَ اللَيلِ طالِعاً","وَلَيسَ بِمَردودٍ مَعَ الصُبحِ غارِبِ",25,"ب",1,0],["أُنازِعُها عَلى العِلّاتِ شُرباً","لَهُن مَضاحِكٌ مِن أُقحُوانِ",26,"ن",1,0],["إن أزمعت شراً فما","شيء يعوق ويحجب",27,"ب",1,0],["أَنا زِياد بن عنان بن رَسَن","مِن خَير بَيت فاعلمنه في اليَمن",28,"ن",1,0],["أَنا زُهَير وَالرَبيع وَقبسهم","في شَهد دُر قَد حَلا بِمَآثر",29,"ر",1,0],["أنَازِعُهَا حَبْلَ الهَوَى وَتَلُفُّهُ","وقَدْ وَرِمَتْ كفّايَ منْ أثَر الحَبْلِ",30,"ل",1,0],["أنازعه فيك الثناء فينثني","كأني نازعت الكؤوس منادمي",31,"م",2,0],["أَنازِلَة في أَجرَع الخيف إِنَّني","وَإِن لَم تَراعوا ذمَتي لَكم إلف",32,"ف",1,0],["ان أزمَعَت بالعَزاءِ لَجَّ بها ال","شَوقُ فَنِيرانُ حَرِّها تَقِدُ",33,"د",1,0],["ان ازمع الركب ترحيلاً فلي بكم","جسم مقيم وقلبٌ عنه مرتحلُ",34,"ل",1,0],["أنازع في هواه القلب حتى","نزعت هواه من قلبي جميعه",35,"ع",2,0],["أنازع قلبي سلوة فيقول لي","رضيت بسيف اللحظ فينا محكما",36,"م",2,0],["أنا زاهِدٌ فيما سواهُ راغِبٌ","فيهِ وحسبي في الهوى مَرضاتهُ",37,"ت",2,0],["أنا زهْرٌ إذ تُشْرِفُ","أنا روْضٌ مُفَوَّفُ",38,"ف",1,1],["ان أزهَرَت عَذَباتُها يَعقِدنَ أَثمارَ","الغموم بأَشنَعِ الأَشجارِ",39,"ر",1,0],["أنا زائر ومسلم فتكلمي","يا دارَ رَاية للمتّيم تحمدي",40,"د",2,0],["إِن أُزَيِّنهُ يا اِبنَ حَربٍ بِذَمّي","فَجَريرٌ قَد زانَ قَبلي بَجيلَه",41,"ل",2,0],["أَنازِلَةٌ أَسماءُ أَم غَيرُ نازِلَه","أَبيني لَنا يا أَسمَ ما أَنتِ فاعِلَه",42,"ه",1,1],["أنازع أشواقي لكم ولواعجي","وما كنت لولا حبكم بالمنازع",43,"ع",1,0],["أَنا زيرٌ لِلغَواني","وَأَخو لَهوٍ وَراحِ",44,"ح",1,0],["أنا زميلي ضمير ونبل","ما يزرع الظلم بأدراجه",45,"ج",2,1],["ان ازعجك من شمس ماقلته شعاع","انا قريت اللي على كف ديمه",46,"م",2,0],["أنا زيد ُ لو عرفوا جنون َ رجولتي","لاسْتَبْعَدوني حين مَرَّهم الرَّهَقْ",47,"ق",1,0],["أنا زيدُ فاغْتَربي لديَّ حبيبتي","أنا ها هنا قد عدت ُ يا زمن َ الألَقْ",47,"ق",1,0],["أَنَا زَفْرَةُ البُرْكَانِ في حُمَّى اللَّظَى","وبِغَيْرِ أَسْمَى مَنْزِلٍ لا أَقْنَعُ",48,"ع",1,0],["أنَا زُلِيْخَةُ هيم ُالشَّوْق ِأبْحَرَهَا","أنَا كَيُوْسُفَ بَدْرًا مَنْ لَه ُيَصِلُ ؟؟",49,"ل",1,0],["أنا زهرةٌ في مَواني العبيرِ","أنادي إلى ظلّ قلبي الكسيرِ",50,"ر",1,1],["أنا زَهْرَةٌ بَرِّيَّةٌ تَقْتَفي السَّنا","مَعِ الأّمْسِ صَعْبٌ أنْ تُعيد تَأَقْلُمي",51,"م",2,0],["إنْ أزهرت بالحب خاصرتي","وتعطر الزمكان والأمدُ",52,"د",1,0],["انا زماني مال بي حيل وانعاج","والحظ دوراته عليّ مستديره",53,"ر",2,0],["إِنْ أَزْمَنَ أَمْرُكَ يا وَلَدِي","وتَراكَمَ أَثَرُ الإِزْمَانِ",54,"ن",1,0],["انازع شديد الحزن ماسطعت انزعه","ولامستطيع اني باالاضلاع اغايبه",55,"ب",2,0],["أنا زرعت ولا جنيت المحاصيل","وأن قلت بانسى قام قلبي تدخل",56,"ل",1,0],["أنَا زهرة ُ الزيتون لا تَجْنونَني","إلا ّويَنْبُتُ في مكانِيَ بُرْعُمُ",57,"م",1,0],["إنَّ أزْكى البُيوتِ بيْتُ رسولِ","اللهِ آلاً ، لَهُ المَقامُ الأسْمى",58,"م",2,0],["أَنَاْ زَهْرِيْ - وَقَدْ عَلِمْتَ بِزَهْرِيْ-","فَرَّ مِنِّي واخْتَارَ مِنْكَ غُصُونَكْ",59,"ك",1,0],["أنا زنبق الحب العفيف بشاعر","يخفي اشتياقه عزة وحياءا",60,"ا",3,0],["أنا زعيم الشعر فارس عنانه..","وسيد جنون القاف ومن الله العون..",61,"ن",1,0],["أنا زورقٌ كم يذوب اشتياقا","لنفس حياتي ببحر المُحالْ",62,"ل",1,0],["إنْ آزرَ المغوار أبطالَ الهدى","هذا لدى العقلاء يُصبح أعظما",63,"م",2,0],["أنا زدتُ جودك يا بني خسائراً","حتى وصلتَ إلى شفير يَباسِ",64,"س",1,0],["أَنَا زَورَقٌ كَمْ يَتُوقُ البِحَارَ","وَأَنتِ هَوَاهُ وَعَزمُ السَّفَرْ",65,"ر",1,0],["أنا زابن وأعدّ إني من أدناة الربع محسوب","ولالي شف ّغير اللي عذا بي من تسابيبه",66,"ب",2,0],["أن أزرعَ الأحلامَ غيماً في الرُّبا","أن أقطعَ الدنيا بركبِ جيادي",67,"د",2,0],["أنا زهرةُ الأحزان في كلّ شارعٍ","ألا فاعبروني ..كي يكونَ وصولُ",68,"ل",1,0],["أَنَا زَفرَةُ الهمِّ الكَبيرِ تبثُّهَا","تَنهيدَةُ الأَجدَادِ للأَحفَادِ",69,"د",1,0],["أنازل الليل حتى ينجلي أبدا","ويرسم الفجر في آلائي القلم",70,"م",1,0]]}