{"poems":[[55,"توقعي أن يقال قد ظعنا","https://www.aldiwan.net/poem29653.html","المنسرح"],[90,"كل ابن آدم مقهور بعادات","https://www.aldiwan.net/poem44993.html","البسيط"],[87,"يا ابن زيدون مرحبا","https://www.aldiwan.net/poem8080.html","مجزوء الخفيف"],[89,"كل صعب سوى المذلة سهل","https://www.aldiwan.net/poem8345.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42734","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54639","الكامل"],[108,"تحية وقضية","https://www.poetsgate.com/ViewPoem.aspx?id=179292",""],[124,"كيف به والجفاء يبعد به","https://www.aldiwan.net/poem49347.html","المنسرح"],[146,"ماذا يعيب رجال الحى في النادي","https://www.aldiwan.net/poem58426.html","البسيط"],[240,"قد فنيت في هواكم عددي","https://www.aldiwan.net/poem32033.html","المنسرح"],[256,"درة العشاق","https://www.aldiwan.net/poem65127.html","عموديه"],[264,"ليل الخطوب له فجر من الفرج","https://www.aldiwan.net/poem35932.html","البسيط"],[362,"يا صاحبي وما البخيل بصاحبي","https://www.aldiwan.net/poem4164.html","الكامل"],[369,"هل في عتاب الحادثات غناء","https://www.aldiwan.net/poem61013.html","الكامل"],[385,"الله أكبر جاء النصر والظفر","https://www.aldiwan.net/poem48765.html","البسيط"],[396,"باسمك اللهم أبدى ما خطر","https://www.aldiwan.net/poem54574.html","عموديه"],[463,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[469,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[543,"يا رعى الله إخوة كرموني","https://www.aldiwan.net/poem47601.html","عموديه"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77648","الرجز"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73951","الخفيف"],[1529,"","https://poetry.dctabudhabi.ae/diwan/poem/140211",""],[1603,"","https://poetry.dctabudhabi.ae/diwan/poem/117127","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108706","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66242","الرجز"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42444","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88657","الرجز"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106979","الرجز"],[2478,"","https://poetry.dctabudhabi.ae/diwan/poem/100551","الكامل"],[2875,"","https://poetry.dctabudhabi.ae/diwan/poem/124047","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127391","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205005","السريع"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65137","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88891","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62965","السريع"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127089","السريع"],[4220,"","https://poetry.dctabudhabi.ae/diwan/poem/104424","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136606",""],[4727,"كورونا الجهل","https://www.poetsgate.com/ViewPoem.aspx?id=210833",""],[5121,"أُنْشُودَةُ السَّهَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=33583",""],[5137,"دمعة في ليلة العيد","https://www.poetsgate.com/ViewPoem.aspx?id=101525",""],[5198,"ضحكتك حفلة","https://www.poetsgate.com/ViewPoem.aspx?id=135389",""],[5219,"ليتها","https://www.poetsgate.com/ViewPoem.aspx?id=194757",""],[5373,"عِيْلَان والتَّهجِير إلى أوروبا","https://www.poetsgate.com/ViewPoem.aspx?id=186019",""],[475,"يَا بَيْتَ عَاتِكَة َ الَّذِي أَتَعزَّلُ","https://www.poetsgate.com/ViewPoem.aspx?id=20634",""],[5628,"عيناك مرفئي","https://www.poetsgate.com/ViewPoem.aspx?id=179812",""],[5644,"أهوى تبسمه","https://www.poetsgate.com/ViewPoem.aspx?id=198651",""],[5829,"الى محمد","https://www.poetsgate.com/ViewPoem.aspx?id=153239",""],[5976,"قلبي زجاجي ..","https://www.poetsgate.com/ViewPoem.aspx?id=30697",""],[6213,"مركب ووقود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76267&r=&rc=24",""],[463,"اتمنَّى والمنى جهدُ المقلُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60222&r=&rc=278",""],[6337,"آنَستُ وجهك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81399&r=&rc=11",""]],"verses":[["إِن مَرَّ بي لَم أَعُج بِهِ بَصَراً","أَو قالَ لي لَم أُمِل لَهُ أُذُنا",0,"ن",2,0],["أن مَرّ بين ِشفاه القوم أسودها","ألقي اصفراراً على بيض الثنيّات",1,"ت",1,0],["إِنَّ مَروانَ عُصبَةٌ","يَصنَعونَ العَجائِبا",2,"ب",2,0],["إِنَّ مُرَّ الْحِمَامِ أَعْذَبُ وِرْدَاً","مِنْ حَيَاةٍ فِيهَا شَقَاءٌ وَذُلُّ",3,"ل",1,0],["إِنْ مَرَّ بِالْقَوْمِ حَلُّوا عَقْدَ حَبْوَتِهِمْ","وَاسْتَشْرَفَتْ نَحْوَهُ الأَلْبَابُ وَالْمُقَلُ",4,"ل",1,0],["إِنْ مَرَّ وِرْدُ الدَّهْرِ ظَلَّ حَدِيثُهُ","عَذْبَاً وَإِنْ خَبُثَتْ أُنَاسٌ طَابَا",5,"ب",2,0],["إن مرَّ بالعربيِّ يومٌ عابِسٌ","فأمامَه: يومٌ، أغرُّ، محجَّل",6,"ل",1,0],["إن مر لم يكترث لخطرته","أو قال لم يتلفت إلى خطبه",7,"ب",2,0],["إن مرِضَتْ ليلةٌ عُمىٌ كواكُبها","قدحتَ فيها بزنَدٍ غيرِ صَلاَّدِ",8,"د",1,0],["إِنَّ مَرايا الإِحراقِ تُحرِقُ ما","قابَلَهُ نورُها مِنَ البُعُدِ",9,"د",1,0],["ان مرّ طيف محمد في خاطري","هاجت بحار الحبّ في أعماقي",10,"ق",2,0],["إن مرّ ظاهرها فاصبر فباطنها","حلوٌ فلا تنزعج واحذر من اللَّجَج",11,"ج",1,0],["أنَمُرُّ بِالعَرَصَاتِ لا نَبكِي بِهَا","وَهيَ المَنَازِلُ مِنهُمُ وَالأَربُعُ",12,"ع",1,0],["إن مَرًّ منك نَجيبُ مَجْدٍ راحلاً","فاسلَمْ لِتُخْلفَ بعدَه نُجَباء",13,"ا",2,0],["إِن مَرَّ مِنهُ خَيال في خَواطرهم","ذابَت مَرارَتَهُم وَاِنحَلَت المررُ",14,"ر",1,0],["إن مرضاة الخلائق غاية","ليس تدرك قد جرى ذا بالقدر",15,"ر",1,0],["إنَّ مرعىً أنت فيه رائدي","لعميم النبتِ مأنوسُ المحلّْ",16,"ل",1,0],["إن مرءا ولاه مولاهُ لم يخ","تشِ في دولة المكارم عزلا",17,"ل",2,0],["إنَّ مراكشا عَرينُ اُسُودٍ","أَوَ مَا ذِي شُبولُ ذاكَ العَرِين",18,"ن",1,0],["إِن مَرض المَريض مِنهُم أَقبلت","عُوّاده فَشَرِبَت وَأَكَلَت",19,"ت",1,0],["إن مرءاً لم يمضه القدر الما","ضي لتغدو عوائقاً أسبابه",20,"ب",2,0],["إن مرّ اليومُ ولم أسعدْ","بلقاهُ بَرَتْني الأشواق",21,"ق",1,0],["إن مرج الأزد مرج واسع","تستوي الأقدام فيه والرّكب",22,"ب",1,0],["إن مر يوماً لا أفاخره","بك لا تفاخر بي فتىً برُّ",23,"ر",1,0],["إن مرَّ تابوتي","بدارك اخرجي",24,"ي",1,1],["إن مرّ والمرآةُ يوماً في يدي","من خلفِها ذو اللطف أسمى من سَما",25,"م",2,0],["ان مر طعم الشعر في سواهم","فَما احيلاه بهم واعذبا",26,"ب",2,0],["إن مرضت من الفتور عينه","فما لها إلا القلوب عود",27,"د",1,0],["إن مر بي عيش حلا","بوجوده فاليوم مر",28,"ر",1,0],["ان مرآى أربع البير أقوت","بعد جمل من أمهات الدواهي",29,"ي",1,0],["إن مرت الذكرى عَلي","هِ حسبت داخله قطاة",30,"ه",1,0],["إن مر بالخاطر ينزو له","بالصدر قلبي دافعا أضلعه",31,"ع",2,0],["إن مرّ وهو يميلُ في حُلل البها","ترك التّقيّ الخلو صبّا مُغرما",32,"م",2,0],["إن مرَّ صبري فأبدى ما بتوريتي","زاوجت ذوقي فيحلو الصبر في هممي",33,"م",2,0],["انَّ مرادَ العِزِّ ترعينَه","خيرٌ من الخُلَّةِ والحَمضِ",34,"ض",1,0],["إن مربد الهم لا يغتدي","منهزما إلا بلمح الشهاب",35,"ب",1,0],["ان مر بي صفو بعض العيش عاجلني","مالا أطيق من الأرزاء والمحن",36,"ن",1,0],["إن مَررت الغداةَ في أرض نَجدٍ","حَيي عَني ذاك الغزالَ الكحيلا",37,"ل",2,0],["إن مَرّ بينهمُ مُقِيمُ كِمامَةٍ","غمزوه أو قالوا جبانٌ خَيِّسُ",38,"س",1,0],["إِنْ مَرَّ طَيْفٌ رَضِيُّ النَّفْسِ فِي بَصَرِي","مَرْحَى بِأَنْغَامِ شِعْرٍ لاَحَ كَالْقَمَرِ",39,"ر",1,0],["إنْ مَرَّ رَكبُ الْعُلا يَخْتَالُ في زَمَنِي","سَأُوْقِف الرَّكْبَ حَتى أَلْتَقِي عِيِدي",40,"د",2,0],["ان مربي عطره وورده وفلّه","يطيرله قلبي بلا ريش وجناح",41,"ح",1,0],["إن مرساتي ببحر قد هوت","هل تراها تعرف الشطآن حينا ؟",42,"ن",2,0],["إِنْ \" مِرْكِلُ \" الشَّقْرَاءُ جَاءَتْ رَحْمَةٌ !","أَنَا المُغَفَّلُ وَ أَنْتَ الأَحْمَقُ",43,"ق",1,0],["إِنَّ کمْرَأً قَدْ نَالَ مِنْكَ قَرَابَة","ً يَبْغِي مَنَافِعَ غَيْرِهَا لَمُضَلَّلُ",44,"ل",1,0],["إنْ مرَّ ذكرُكِ مرّةَ","في خاطري سكر َ الشعورُ",45,"ر",1,0],["إنْ مرَّ من ذاك الطريقِ سلكته","فلعلني في طرفه ألقاهُ",46,"ا",2,0],["إن مرت فوق تجاعيدي","آلام, واشتد أنيني",47,"ن",2,0],["إن مرّ شيطاني وبه هاجس ٍ عاف","تمتمت ادرّجها على لحْن مجرور .. !!",48,"ر",1,0],["إن مر فوق الأرض وقت ظهيرة","لا نسل جنح الليل تحت الحاجب",49,"ب",1,0],["إنَّ مرعى ً أنت فيه رائدي","لعميم البنتِ مأنوسُ المحلْ",50,"ل",1,0],["إن مرّ طيفُك حِرتُ مفتتناً بهِ","والقلبُ فيكِ مُولَّها قد جاشا",51,"ش",2,0]]}