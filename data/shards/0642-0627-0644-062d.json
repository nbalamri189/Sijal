{"poems":[[90,"قال قولا به استحق احتراما","https://www.aldiwan.net/poem44825.html","الخفيف"],[71,"قال حكت قامتها صعدة","https://www.aldiwan.net/poem29280.html","السريع"],[33,"يا خليلي هاجني الذكر","https://www.aldiwan.net/poem42511.html","المديد"],[107,"يا بني الحارث بن كعب سلام","https://www.aldiwan.net/poem44004.html","الخفيف"],[50,"إنني أبصرت شخصا","https://www.aldiwan.net/poem62580.html","مجزوء الرمل"],[102,"رسالة إلى صديق في قبره","https://www.poetsgate.com/ViewPoem.aspx?id=183584",""],[190,"عارضني محتسب بارد","https://www.aldiwan.net/poem43805.html","السريع"],[214,"مطلب دموعي إن نفد","https://www.aldiwan.net/poem13488.html","مجزوء الرجز"],[308,"قال حبي علام تهجر طرفي","https://www.aldiwan.net/poem57956.html","الخفيف"],[308,"قال حبيبي لا تحدث بما","https://www.aldiwan.net/poem58081.html","السريع"],[308,"قال حبي علام تبكي بدمع","https://www.aldiwan.net/poem58134.html","الخفيف"],[310,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[325,"لا تقل همت في ضياء الغزال","https://www.aldiwan.net/poem67214.html","الخفيف"],[333,"رتل البلبل الطروب لحونه","https://www.aldiwan.net/poem55066.html","الخفيف"],[409,"قال حبيبي لم أطلت الجفا","https://www.aldiwan.net/poem33458.html","السريع"],[463,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[463,"بلغت صبرا فقالت ما الخبر","https://www.aldiwan.net/poem56203.html","الرمل"],[505,"أزعج الليل الندامى","https://www.aldiwan.net/poem37800.html","مجزوء الرمل"],[505,"قد كشف السر عن الرمز الخبا","https://www.aldiwan.net/poem38092.html","الرجز"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202129","الخفيف"],[1488,"","https://poetry.dctabudhabi.ae/diwan/poem/145005","البسيط"],[2274,"","https://poetry.dctabudhabi.ae/diwan/poem/144756","السريع"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94312","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127393","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201285","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200043","السريع"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112680","الرجز"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112319","الرمل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35614","البسيط"],[4902,"قال حاقد","https://www.poetsgate.com/ViewPoem.aspx?id=6529",""],[5183,"قال","https://www.poetsgate.com/ViewPoem.aspx?id=186485",""],[5277,"معارضةُ يائيةِ ابن الفارض(1)","https://www.poetsgate.com/ViewPoem.aspx?id=198943",""],[5573,"فاز بالخير بادي يوم يقري سلام","https://www.poetsgate.com/ViewPoem.aspx?id=202543",""],[5587,"جاني كلام","https://www.poetsgate.com/ViewPoem.aspx?id=197890",""],[6056,"الأحلام الوردية","https://www.poetsgate.com/ViewPoem.aspx?id=130357",""],[6124,"قال حرف","https://www.poetsgate.com/ViewPoem.aspx?id=193052",""]],"verses":[["قال حرية الأنام هي الغا","ية لي في الوغى فغَرَّ الأناما",0,"م",2,0],["قالْ حكتْ قامتُها صعدةً","فقلتُ لِمْ تَجْرَحُ تعديلَها",1,"ه",2,1],["قالَ حاديهِم لَهُم أُصُلاً","أَمكَنَت لِلشارِبِ الغُدُرُ",2,"ر",1,0],["قال حقّاً لقد صدقتم وما كا","نَ ليُرجَى للظالِمينَ دَوامُ",3,"م",1,0],["قالَ حَفصٌ إِجلِدوهُ","إِنَّهُ عِندي بَليدُ",4,"د",1,0],["قال (حاوي) وهو يردي نفسهُ:","يا رفاقي هذه أخرى جيادي",5,"د",2,0],["قال حرام وقبيح إذا","خاطبت نسوانا بأخبار",6,"ر",1,0],["قال حاجبي قلت ومن","يطيق وصف الحاجبين",7,"ن",1,0],["قال حبي علام تهجرُ طرفي","وترى مبسمي فرحت أقولُ",8,"ل",1,1],["قال حبيبي لا تحدث بما","عندك من لا عنده معرفه",9,"ه",1,1],["قال حبي علام تبكي بدمع","أصفر هكذا تفيض المآقي",10,"ي",1,1],["قالَ حتّى يحينَ منه وفاءٌ","قُلت هذي باكورة الأحيانِ",11,"ن",1,0],["قالَ حاشايَ أَن أَكونَ جَماداً","إِنَّ هَذا التَشبيهَ مِنهُم جَهالَه",12,"ل",2,0],["قال حقّا لقد شغلت عن الضو","ء وعمّيت سحره وفتونه",13,"ن",2,0],["قال حبيبي لِمْ أطلت الجفا","إنك عندي لمحب ملول",14,"ل",1,1],["قال حُسنَى ونوَى سيّئةً","ليتَ من لم ينوِ خيراً لم يقُلْ",15,"ل",1,0],["قال حيّاني فقالت نائماً","طرفه قال نعم قالت غدر",16,"ر",1,0],["قالَ حينَ القَوْمُ ناحوا","فعَلى مَ وإِلى مَا",17,"م",2,0],["قالَ حبيبي والسُّرورُ طافِحٌ","أَهلاً وسهلاً يا غَريبَ الغُرَبا",18,"ب",2,0],["قال حسبي أجَبْتَني بجواب","باطني بَيَّنْتَ لي فيه عقلا",19,"ل",2,0],["قال حبيبي: زرني ولكن","يكون في آخر النهار",20,"ر",1,1],["قالَ حجايَ وهو في طفحةِ السُكْ","رِ منَ الأفراحِ نشوانُها",21,"ن",3,0],["قال حور الجنات قالت فأرخ","حبر بلتان قد أتانا حبيبا",22,"ب",2,0],["قال حقا لقد سمعت فماذا","يا ترى سرها فهل من رجاء",23,"ا",2,0],["قال حبيبي حين قبّلته","عشراً ألم تُطْفَ لك الغُلّه",24,"ه",1,1],["قال حبيبتي ليكن حبنا","متصلا بالروح لا بالدم",25,"م",1,1],["قالَ حبيبٌ لم يُجِب حَبيبه","وكيفَ يَرجو منهُ أن يثجيبه",26,"ه",1,0],["قال حقّاً قالت الأمثال لا","تأمَن الدنيَا فما فيها وَدود",27,"د",1,0],["قالَ حَسودي وَقَد رَآه","يَخِبّ خَلفي إِلى القِتالِ",28,"ل",1,0],["قال حاقد قلت ياجاهل هلي","كيف ابطرف باصبعي عيني وأصيح",29,"ح",1,1],["قال حسن بارع تيَّمني","قلت كم غرَّ وكم أغرَى الجمال",30,"ل",1,0],["قالَ حادي الركبِ لما وهنوا","ليسَ هذا الوهنُ من حبٍّ بشَيْ",31,"ي",1,0],["قال حملك ودور سكتك بالجهام","قلت مافيه داعي غير متني يشيل",32,"ل",1,0],["قَالِ حَتَّى النُّومْ طارْ عْلِيَا","سْكَنْ طِيفَك ْ مْعَايَ فِي لَفْرَاشْ",33,"ش",1,0],["قال حنا عن الفزعات ، ماننشدي","لا لفانا ،عريب ، الأصل ماننشده",34,"د",2,0],["قَالَ حَرْفٌ لِلحرُوفِ","إِنَّ حَدِّي كَالسِّيُوفِ",35,"ف",1,1]]}