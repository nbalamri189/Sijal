{"poems":[[88,"قال قولا به استحق احتراما","https://www.aldiwan.net/poem44825.html","الخفيف"],[69,"قال حكت قامتها صعدة","https://www.aldiwan.net/poem29280.html","السريع"],[31,"يا خليلي هاجني الذكر","https://www.aldiwan.net/poem42511.html","المديد"],[105,"يا بني الحارث بن كعب سلام","https://www.aldiwan.net/poem44004.html","الخفيف"],[48,"إنني أبصرت شخصا","https://www.aldiwan.net/poem62580.html","مجزوء الرمل"],[100,"رسالة إلى صديق في قبره","https://www.poetsgate.com/ViewPoem.aspx?id=183584",""],[186,"عارضني محتسب بارد","https://www.aldiwan.net/poem43805.html","السريع"],[210,"مطلب دموعي إن نفد","https://www.aldiwan.net/poem13488.html","مجزوء الرجز"],[303,"قال حبي علام تهجر طرفي","https://www.aldiwan.net/poem57956.html","الخفيف"],[303,"قال حبيبي لا تحدث بما","https://www.aldiwan.net/poem58081.html","السريع"],[303,"قال حبي علام تبكي بدمع","https://www.aldiwan.net/poem58134.html","الخفيف"],[305,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[320,"لا تقل همت في ضياء الغزال","https://www.aldiwan.net/poem67214.html","الخفيف"],[328,"رتل البلبل الطروب لحونه","https://www.aldiwan.net/poem55066.html","الخفيف"],[403,"قال حبيبي لم أطلت الجفا","https://www.aldiwan.net/poem33458.html","السريع"],[458,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[458,"بلغت صبرا فقالت ما الخبر","https://www.aldiwan.net/poem56203.html","الرمل"],[500,"أزعج الليل الندامى","https://www.aldiwan.net/poem37800.html","مجزوء الرمل"],[500,"قد كشف السر عن الرمز الخبا","https://www.aldiwan.net/poem38092.html","الرجز"]],"verses":[["قال حرية الأنام هي الغا","ية لي في الوغى فغَرَّ الأناما",0,"م",2,0],["قالْ حكتْ قامتُها صعدةً","فقلتُ لِمْ تَجْرَحُ تعديلَها",1,"ه",2,1],["قالَ حاديهِم لَهُم أُصُلاً","أَمكَنَت لِلشارِبِ الغُدُرُ",2,"ر",1,0],["قال حقّاً لقد صدقتم وما كا","نَ ليُرجَى للظالِمينَ دَوامُ",3,"م",1,0],["قالَ حَفصٌ إِجلِدوهُ","إِنَّهُ عِندي بَليدُ",4,"د",1,0],["قال (حاوي) وهو يردي نفسهُ:","يا رفاقي هذه أخرى جيادي",5,"د",2,0],["قال حرام وقبيح إذا","خاطبت نسوانا بأخبار",6,"ر",1,0],["قال حاجبي قلت ومن","يطيق وصف الحاجبين",7,"ن",1,0],["قال حبي علام تهجرُ طرفي","وترى مبسمي فرحت أقولُ",8,"ل",1,1],["قال حبيبي لا تحدث بما","عندك من لا عنده معرفه",9,"ه",1,1],["قال حبي علام تبكي بدمع","أصفر هكذا تفيض المآقي",10,"ي",1,1],["قالَ حتّى يحينَ منه وفاءٌ","قُلت هذي باكورة الأحيانِ",11,"ن",1,0],["قالَ حاشايَ أَن أَكونَ جَماداً","إِنَّ هَذا التَشبيهَ مِنهُم جَهالَه",12,"ل",2,0],["قال حقّا لقد شغلت عن الضو","ء وعمّيت سحره وفتونه",13,"ن",2,0],["قال حبيبي لِمْ أطلت الجفا","إنك عندي لمحب ملول",14,"ل",1,1],["قال حُسنَى ونوَى سيّئةً","ليتَ من لم ينوِ خيراً لم يقُلْ",15,"ل",1,0],["قال حيّاني فقالت نائماً","طرفه قال نعم قالت غدر",16,"ر",1,0],["قالَ حينَ القَوْمُ ناحوا","فعَلى مَ وإِلى مَا",17,"م",2,0],["قالَ حبيبي والسُّرورُ طافِحٌ","أَهلاً وسهلاً يا غَريبَ الغُرَبا",18,"ب",2,0]]}