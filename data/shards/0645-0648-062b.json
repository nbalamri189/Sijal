{"poems":[[88,"دمعة من دموع عهد الشباب","https://www.aldiwan.net/poem10372.html","الخفيف"],[95,"أنت تبغي السيرا","https://www.aldiwan.net/poem11269.html","مجزوء الرمل"],[47,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[7,"دعاك الهوى واستجهلتك المنازل","https://www.aldiwan.net/poem1979.html","الطويل"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29338","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141923","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43741","الطويل"],[100,"مؤتمر الجماد","https://www.poetsgate.com/ViewPoem.aspx?id=55343",""],[47,"قُلْتُ للاّئِمِ في الجُبّ أفِقْ","https://www.poetsgate.com/ViewPoem.aspx?id=32850",""],[190,"لا وحق التنزيل والتأويل","https://www.aldiwan.net/poem43463.html","الخفيف"],[310,"هاج أجفاني وقلبي المغرما","https://www.aldiwan.net/poem56499.html","الرمل"],[327,"ذرفت عيني دموعا","https://www.aldiwan.net/poem56351.html","مجزوء الرمل"],[466,"ولينة الأعطاف خوارة","https://www.aldiwan.net/poem16084.html","السريع"],[466,"وكريم الملتقى ذو لسن","https://www.aldiwan.net/poem16152.html","الرمل"],[505,"إن معنى الهيام بالأولياء","https://www.aldiwan.net/poem38101.html","الخفيف"],[556,"قربا مني القلاص العتاقا","https://www.aldiwan.net/poem47367.html","المديد"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64359","الرمل"],[954,"","https://poetry.dctabudhabi.ae/diwan/poem/203457","المنسرح"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62577","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62569","البسيط"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18462","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49932","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110280","الرمل"],[2405,"","https://poetry.dctabudhabi.ae/diwan/poem/27107","الطويل"],[3005,"","https://poetry.dctabudhabi.ae/diwan/poem/34710","الرجز"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103438","الطويل"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66349","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21523","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102750","البسيط"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123455","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139520",""],[5596,"البسكوت","https://www.poetsgate.com/ViewPoem.aspx?id=206720",""]],"verses":[["مُؤثِرَ البُؤسِ وَالشَقاءِ عَلى الشَك","وى وَإِن عَضَّكَ الزَمانُ بِنابِ",0,"ب",1,0],["مُؤْثِراً أَنْ تَعْلَمَ ال","جَارِي مِمَّا قَدْ جَرَى",1,"ر",2,0],["موثَقُ الأَسرِ ضَليعٌ أَشرَفَت","جَبهَةٌ مِنهُ وَرَأسٌ وَعُنُق",2,"ق",1,0],["مُوَثَّقَةِ الأَنساءِ مَضبورَةِ القَرا","نَعوبٍ إِذا كَلَّ العِتاقُ المَراسِلُ",3,"ل",1,0],["موثقة عقد المحال كأنها","دموك من الجاري عليها الخطاطف",4,"ف",1,0],["مَوثِقُ القلب وميعادُ النَّظرْ","مهرجانُ النُّور في عُرس الشروقْ",5,"ق",1,0],["مؤثرٌ أن يموت في كوخهِ الفاني","على الباقيات من ديوانه",6,"ن",2,0],["مُؤَثِّرَةً فيهِ الجِراحَةُ مِثلَما","يُفَلَّلُ سَيفُ الهِندِ وَهوَ صَقيلُ",7,"ل",1,0],["مؤثر لو كنت مسماراً ولا","خجل في نعل طفل محول",8,"ل",1,0],["مُوثَقُ الأسْرِ، ضَليعٌ، أشرَفَتْ","جَبْحَةٌ مِنْهُ، وَرَأسٌ وَعُنُقْ",9,"ق",1,0],["مؤثر نفسه عليك إذا ما","جئته عند فادح ونزيل",10,"ل",1,0],["مُؤثراً بِالعزمِ مدحَ الأريَحي","السريّ اللّوذعيّ الألمعي",11,"ي",1,0],["مُؤثِقاتٍ كُلَّ رَأيٍ","بِعُيونِ الغُرِّ حورِ",12,"ر",1,0],["موثَقةٌ مُطْلقَةٌ لَيْنَةٌ","شَديدةٌ ثابتةٌ تَقْلَقُ",13,"ق",1,0],["مُؤْثِرٌ يُؤْثِرُ بالزَّادِ إذا","لم يجِدْ عن ذلكَ الزَّادِ بَدَلْ",14,"ل",1,0],["مُوثقٌ بالهوَى فقيرٌ ضعيفٌ","فتَوارى بالحُبِّ للأَقوِياءِ",15,"ا",2,0],["موثِقاً كنتُ حياءً وحِلْماً","فاِتركاني قد قطعتُ الوَثاقا",16,"ق",2,0],["مؤثرٍ عمران عيشٍ","يترك الكيس خرابا",17,"ب",2,1],["موثَّقُ الخَلْق جُرشُعٌ عَتَدٌ","مُنفرجُ الحُضْرِ حين يُستحضرْ",18,"ر",1,0],["مؤثَّل في مجده","له العُلا والسؤدَد",19,"د",1,0],["مُؤثّل المجد عالي الجدّ مرتفع","رحب المحل طويل الباع منبسطِ",20,"ط",1,0],["مُوَثَّقِ الصُنعِ قَوِيٍّ سَحبَلِ","يَقصُرُ مِن خُطوِ المُئِلِّ الحُرجُلِ",21,"ل",1,0],["مُؤثَّرٌ بصنيع الخَير ذي حسبٍ","مطَرّز بصنيع الفَضل منْعُوتِ",22,"ت",1,0],["مؤثراً لو ودعته روحه","قبل ان ودع ذاك الكوكبا",23,"ب",2,0],["مُوَثَّقَةِ الأَنساءِ مَضبورَةِ القَرا","تَسومُ بِهادٍ في القِلادَةِ أَقوَدا",24,"د",2,0],["مُوثَقِ مُطلَقِ الجِثمانِ","مُعَذَّبٍ بالصَدِّ وَالهِجرانِ",25,"ن",1,0],["مُوَثِّقَةٍ لَم تَنحَضِ البيدُ لَحمَها","قَوائِمُها فَوقَ الصُخورِ صُخورُ",26,"ر",1,0],["مؤثر في حجر شريف","لاجل هذا خص بالتشريف",27,"ف",1,0],["موثق الأحشاء ذو دمع طليق","قط من سكر الهوى لا يستفيق",28,"ق",1,0],["مُؤثِراً تُرسَ أَبيهِ نَسطُرا","وَعَلى رُمحٍ طَويلٍ قَبَضا",29,"ض",2,0],["موثَّقة الأَلواح لَم يُدم متنَها","ولا صَفحتيها عَقدُ رَحلٍ وَلا قَتب",30,"ب",1,0],["مؤثل المجد قد ساد الأنام علا","وداس بالرجل ما يسمو على زحل",31,"ل",1,0],["موثرِ الزهد مخلص القصد وافي","العهد والوعد صادقِ الأنباء",32,"ا",2,0],["موثلا كل حكمةٍ بضياها","قد هدت كل من أضل الصوابا",33,"ب",2,0],["مؤثرةً ( بَسكوتها ) بحظوةٍ","لثماً وتقبيلاً بلا تفتيت",34,"ت",1,0]]}