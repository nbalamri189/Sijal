{"poems":[[93,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[46,"السيف أصدق أنباء من الكتب","https://www.aldiwan.net/poem30591.html","البسيط"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[287,"مه لا تلم يا لائمي صبا هلك","https://www.aldiwan.net/poem32684.html","الرجز"],[543,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[543,"يا حسرتي يا حسرتي","https://www.aldiwan.net/poem48262.html","عموديه"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77627","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77479","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77541","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77538","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70986","السريع"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46527","الرجز"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100830","البسيط"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199149","المجتث"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46026","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4004,"","https://poetry.dctabudhabi.ae/diwan/poem/111316","الرجز"],[6023,"طلبتُ خصماً فلاذ مني","https://www.poetsgate.com/ViewPoem.aspx?id=123852",""]],"verses":[["وَقالَ ذو الثَروَةِ ما أَشتَهي","لا أَشتَهي أَنِّيَ ذو ثَروَةِ",0,"ه",1,0],["وَقالَ ذو أَمرِهِم لا مَرتَعٌ صَدَدٌ","لِلسارِحينَ وَلَيسَ الوِردُ مِن كَثَبِ",1,"ب",1,0],["وَقالَ ذَروهُ إِنَّما نَفعُها لَهُ","وَإِلّا تَكُفّوا قاصِيَ البَركِ يَزدَدِ",2,"د",1,0],["وَقالَ ذُق طَعمَ السُهادِ وَالبُكا","أَنتَ الَّذي أَوقَعتَني في ذا الشَرَك",3,"ك",1,0],["وقالَ ذا عَجيبُ","وذاكَ إذ رَىني",4,"ي",1,0],["وقال ذَا عِطرُ المَها","دعها بِقَصدِ العِبرَة",5,"ه",1,0],["وَقالَ ذي الأَربَعَة الكُلُّ لِيَه","وَلَيسَ كُلُّ وَقعَةٍ زَلابِيَه",6,"ه",1,0],["وَقالَ ذا حَقي وَذا مَنابي","من مَسّه قَتَلته بِنابي",7,"ي",1,0],["وَقالَ ذا لُغز جَهلتم حَلَّه","وَقَد عَرَفتُم سرَّه بِالجمله",8,"ه",1,0],["وَقالَ ذي دمشق أَنتَ مِنها","قالَ نَعَم سَل ما تَشاءُ عَنها",9,"ه",2,0],["وقال ذو الجهل بلا حكمة","إن حياء المرء في العينِ",10,"ن",1,1],["وَقالَ ذاكَ العَدل ما نصرتكا","حُباً وَلا بِصالح قَصدتكا",11,"ك",2,0],["وقال ذو أمرهم لا ظلم يفجعكم","لمستبد ولا عسف لمنتقم",12,"م",1,0],["وقال ذا حسَنٌ مَنْ","إلى الحجاز انتماه",13,"ا",2,0],["وَقالَ ذو أَدَبٍ مِنهُم مُفاكهَةً","لا عَونَ مِن بَعدِهِ يُرجى وَلا غوثُ",14,"ث",1,0],["وقال ذا عمارة البلدانِ","تكون في محبة الأوطانِ",15,"ن",1,0],["وقال ذا يطبخ للقياس","على لهيب جمرة الانفاس",16,"س",1,0],["وقال ذا ليس بكسر الشد","ناديته يا جابر المكسور",16,"ر",1,0],["وقال ذو الحبر الكريم النقوي","الكربلائي المسمى بعلي",17,"ي",1,0],["وقال ذا في حمى كليب","يصدق لكن من الكلابِ",18,"ب",1,0]]}