{"poems":[[74,"يا طالب الجود لا تتعب أمانيكا","https://www.aldiwan.net/poem19443.html","البسيط"],[91,"لقد كان سعد خير قوم مجاهد","https://www.aldiwan.net/poem44614.html","الطويل"],[48,"يخبرونك عن رب العلى كذبا","https://www.aldiwan.net/poem23452.html","البسيط"],[48,"يا أُمّ دَفرٍ! إنّما أُكرِمتِ عَنْ","https://www.poetsgate.com/ViewPoem.aspx?id=20289",""],[170,"يا طيب ليلتنا بصحبة غادة","https://www.aldiwan.net/poem47124.html","الكامل"],[201,"غادة حطم الفؤاد بكاها","https://www.aldiwan.net/poem39820.html","الخفيف"],[280,"عذلوه في تشبيبه ونسيبه","https://www.aldiwan.net/poem25625.html","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101483","البسيط"]],"verses":[["حسّت دمشق وفاضت نفسها أسفاً","أما ترى محلها بالمحلِ مسفوكا",0,"ك",2,0],["حست السدى في غاية الفكر موغلا","فشاهدت في مسراي ما لم أشاهد",1,"د",1,0],["حَسَّتهُمُ حادِثاتٌ لَم تَبِن أَسَفاً","كَأَن تَأَسَّفَ إِثرَ القَومِ حَسّانُ",2,"ن",1,0],["حَسَتِ الظلامَ، فآض تعصرُه الضّحى،","من بينِ أعطافٍ، لها، وذَفار",3,"ر",1,0],["حَسّتْ بوجنتها وفاحمِ صدغِها","كالبدرِ مُلتحفاً بريشِ غراب",4,"ب",1,0],["حست الكاس وهي صاب مرير","لا تلمها فكم محبّ حساها",5,"ا",3,0],["حَسّت خلافَتُهُ الخلافَ وصيّرت","مِنْ حِزْبِه مَنْ لَجّ في تحزيبِهِ",6,"ب",2,0],["حَسَت رحيقاً فشمنا البرق منسرباً","في لجَّة الفَجر يهوي والصباحُ وضح",7,"ح",1,0]]}