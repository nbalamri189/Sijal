{"poems":[[47,"الآن أيقنت أن الرزق أقسام","https://www.aldiwan.net/poem66656.html","البسيط"],[82,"حتى متى بين اللوى فالأجرع","https://www.aldiwan.net/poem31391.html","الرجز"],[33,"سحرتني الزرقاء من مارون","https://www.aldiwan.net/poem41282.html","الخفيف"],[33,"أرسلت لما عيل صبري إلى","https://www.aldiwan.net/poem41857.html","السريع"],[50,"دع لباكيها الديارا","https://www.aldiwan.net/poem63264.html","مجزوء الرمل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44577","الوافر"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122006","الكامل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93335","الرمل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88977","الكامل"],[5758,"لعِيْنَيْ غَزَّة","https://www.poetsgate.com/ViewPoem.aspx?id=200916",""]],"verses":[["كَأَقطَعِ الكَفِّ هادٍ عِندَ رُؤيَتِها","فَإِن نَأَت هاجَهُ ضُرٌّ وَأَسقامُ",0,"م",1,0],["كَأُقحُوانِ روضَةٍ يَصْقُلهُ","مِدْوَسُ شمسٍ في النّدى المميَّعِ",1,"ع",1,0],["كَأَقاحٍ بِرَملَةٍ ضَربَتهُ","ريحُ جَوٍّ بِديمَةٍ وَدُجونِ",2,"ن",1,0],["كَأُقحُوانِ الرَملِ في جائِرٍ","أَو كَسَنا البَرقِ إِذا هَلَّلا",3,"ل",2,0],["كَاِقتِرانِ الدُرِّ بِالدُر","رِ صِغاراً وَكِبارا",4,"ر",2,0],["كَأَقداحٍ مِنَ البَلّورِ صِيغَت","بِأَغشِيَةٍ مِنَ الديباجِ خُضرِ",5,"ر",1,0],["كأقفر النظم الذي فيه خلط","وزن بوزن للذي فيه غلط",6,"ط",1,0],["كَأَقَاحَةٍ سُقِيَتْ بِمَاءِ غَمَامَةٍ","فِي رَوْضَةٍ بِالزَّهْرِ ذَاتِ تَأَرُّجِ",7,"ج",1,0],["كَاقترانِ الدُرِّ تَستخرجُهُ","فِكرٌ غوَّاصةٌ وَالذهنُ لُج",8,"ج",1,0],["كإقاحة ملئت ندىً وبديعةٍ","في حسن لفظ صاغه الأدباء",9,"ا",2,0],["كَأَقصَى ما يَكونُ مِنَ الضَّحَايَا","غَدًا تُهْدِي السَّماء لكِ التَّحَايَا",10,"ا",3,1]]}