{"poems":[[43,"ضحك الناس وقالوا","https://www.aldiwan.net/poem42351.html","مجزوء الرمل"],[53,"نكهت شنطف ففاح كنيف","https://www.aldiwan.net/poem65728.html","الطويل"],[53,"سئل الأير ما تريد إلى الكعثب","https://www.aldiwan.net/poem65932.html","الخفيف"],[93,"لو رأى آدم فتاه لزال الحقد","https://www.aldiwan.net/poem8729.html","عموديه"],[93,"زحزحت عن صدرها الغيم السماء","https://www.aldiwan.net/poem8732.html","عموديه"],[54,"أسألت طللا","https://www.aldiwan.net/poem26765.html","مجزوء الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54741","الخفيف"],[93,"الطيران","https://www.poetsgate.com/ViewPoem.aspx?id=53423",""],[563,"فر يا طائرا إلى ربك","https://www.aldiwan.net/poem34262.html","الخفيف"],[994,"","https://poetry.dctabudhabi.ae/diwan/poem/104173","المديد"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80179","الرمل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48970","الرمل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87838","الخفيف"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129996","الرمل"],[2671,"","https://poetry.dctabudhabi.ae/diwan/poem/79773","الخفيف"],[4625,"","https://poetry.dctabudhabi.ae/diwan/poem/124112","الرمل"],[5414,"صرخة من وراء الأسوار","https://www.poetsgate.com/ViewPoem.aspx?id=12936",""],[5956,"سؤال وجواب على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183228",""]],"verses":[["إِنَّما شِعريَ قَندٌ","خُلِطَت بِالجُلجُلانِ",0,"ن",1,0],["إنما شنطف أتان وديق","خاب من ينكح الأتان الوديقا",1,"ق",2,0],["إنّما شأني التردُّدُ فيه","داخلاً خارجاً أغيب وأَنْصُلْ",2,"ل",1,0],["إِنَّما شَوقُنا إِلَيكَ الَّذي أَس","رى بِنا لا الهِيامُ في الإِسراءِ",3,"ا",2,0],["إِنَّما شَوقي إِلى دُنيا رِضىً","وَإِلى عَصرِ سَلامٍ وَإِخاء",4,"ا",2,0],["إِنَّما شَيبُ الفَتى","ناصِحٌ إِن فَعَلا",5,"ل",2,0],["إِنَّمَا شَاقَنَا لقَاءُ المَعَالي","وَالمُرُوءَاتُ وَالنَّدَى وَالأَيَادي",6,"د",2,0],["أنما شوقنا أليك الذي أسرى","بنا لا الهيام في الأسرلء",7,"ا",1,0],["إنما شف عنه ثوبك في","لبسة الماء منك مع تربك",8,"ك",1,0],["إنما شبهتها إذ تراءت","وعليها من عيونٍ رَقيب",9,"ب",1,0],["إِنَّما شَمسُ غُرورٍ قاتِلٍ تَكمَنُ","الظُلمةُ في طَيِّ حَشاها",10,"ا",3,0],["إنما شاعرُنا يغزو الفؤادْ","لفظهُ الرمحُ ومعناه الحدادْ",11,"د",1,0],["إِنَّما شِئتَ أَن تَعيشَ شَقِيّاً","بِتَخَلّيكَ عَن جَميلِ اِعتِدالِك",12,"ك",1,0],["إنما شعرُ الرئيس ابن حكم","بدَعٌ من كلّ فضلٍ وحكَم",13,"م",1,1],["إنّما شَيَّب الذُّؤابةَ منِّي","وبراني تناظُرُ الإخْوانِ",14,"ن",1,0],["إنما شرط المحبين الوفا","ووفاء بسوى الوصل خساره",15,"ر",2,0],["إنما شرعةَ الإله، وإنا","نفتديها عقيدة وشعارا»",16,"ر",2,0],["إنما شرط افْتدائي من إلهي","صَونُهم طرّاً نساءً ورجالا",17,"ل",2,0]]}