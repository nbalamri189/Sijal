,"https://www.aldiwan.net/poem3491.html","عموديه"],[465,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[466,"سلام على بغداد مرة أخرى","https://www.aldiwan.net/poem61435.html","عموديه"],[469,"يا ذا الذي قيل له إنني","https://www.aldiwan.net/poem60100.html","السريع"],[471,"أمنزلتي سلمى على القدم اسلما","https://www.aldiwan.net/poem4807.html","الطويل"],[478,"زعموا أني خؤون في الهوى","https://www.aldiwan.net/poem15309.html","الرمل"],[480,"قم بالمهمة في حل ومرتحل","https://www.aldiwan.net/poem36964.html","البسيط"],[480,"سلمى بعيشك واصلي","https://www.aldiwan.net/poem36971.html","مجزوء الكامل"],[480,"سل ما لقلبي تلظى","https://www.aldiwan.net/poem37176.html","المجتث"],[480,"الله أكبر أيها ال","https://www.aldiwan.net/poem37198.html","مجزوء الكامل"],[483,"يا ربنا يا مظهر الشهود","https://www.aldiwan.net/poem24528.html","عموديه"],[501,"الغيب صف مواكبه","https://www.aldiwan.net/poem37562.html","مجزوء الكامل"],[501,"ماذا يضر البدر وهو في السما","https://www.aldiwan.net/poem37630.html","الرجز"],[501,"أي ورد قد شممناه ضحى","https://www.aldiwan.net/poem37781.html","الرمل"],[501,"لا تشوش لك سرا","https://www.aldiwan.net/poem37924.html","مجزوء الرمل"],[501,"تحت شراع الرفرف","https://www.aldiwan.net/poem37961.html","مجزوء الرجز"],[501,"أيها المستحلف الليل أفق","https://www.aldiwan.net/poem38032.html","الرمل"],[501,"ما للقلوب عن الحبيب غطاء","https://www.aldiwan.net/poem38105.html","الكامل"],[506,"غزّة","https://www.aldiwan.net/poem61086.html","المتدارك"],[539,"حسب المليحة حسنها ويغنيها","https://www.aldiwan.net/poem47512.html","عموديه"],[539,"كم ليلة وليلة","https://www.aldiwan.net/poem48257.html","عموديه"],[552,"لا تقربن عضيهة","https://www.aldiwan.net/poem48037.html","مجزوء الكامل"],[559,"تب إلى الله من علوم الكلام","https://www.aldiwan.net/poem33868.html","الخفيف"],[559,"سلم إن جئت أرض وادي سلم","https://www.aldiwan.net/poem34190.html","الدوبيت"],[559,"كل دين إن فاتك الإسلام","https://www.aldiwan.net/poem34196.html","الخفيف"],[559,"قل لنفس جهلت بين الورى","https://www.aldiwan.net/poem34526.html","الرمل"],[559,"يا نسبة أدخلت سلمان في النسب","https://www.aldiwan.net/poem34930.html","البسيط"],[559,"نسب المحبة أقرب الأنساب","https://www.aldiwan.net/poem34931.html","الكامل"],[563,"سل مطلع القمرين من كبد السما","https://www.aldiwan.net/poem52944.html","الكامل"],[563,"أفراقا حسبتها أم لقاء","https://www.aldiwan.net/poem52986.html","الخفيف"],[564,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[564,"سلم على شيخ النحاة وقل له","https://www.aldiwan.net/poem13609.html","الكامل"]],"verses":[["سَلَّموا الثِقلَ إِلى العو","دِ فَما ناءَ وَقاموا",0,"م",3,0],["سَلِمتَ لَنا وَاللَهُ أَرأَفُ بِالعُلى","مِنَ اَن يَنطَوي عَنّا وَأَرحَمُ لِلنَدى",1,"د",2,0],["سلّمتُ لمِصْرَ في الهَوى منْ بلَدٍ","يهْديهِ هواؤُهُ لدى استِنْشاقِهْ",2,"ه",1,1],["سلّم اللهُ علَى أهْلِ سَلا","ما صَباحٌ لاحَ أوْ برْقٌ لمَعْ",3,"ع",1,0],["سَلْ مَا لسلمَى بنَارِ الهجْرِ تَكْوِينِي","وَحُبُّهَا فِي الْحَشَى مِنْ قَبْلِ تَكْوِينِي",4,"ن",2,1],["سَلَّمهُ اللَهُ إِلى مالِكٍ","إِن ماتَ أَو عاشَ فَلا سَلَّمَه",5,"م",2,0],["سلمانُ بَيتِ العَميدِ يَعذُرُ في ال","سوءِ وَإِن أَحسَنوا إِلَيهِ شَكَر",6,"ر",1,0],["سلم على تلك الديار وأهلها","فالقوم قومى والديار دياري",7,"ر",2,0],["سَلْمَى وَمَا أَحْلَى اسْمَهَا وَحُرُوفَهُ","مَوْصُولَةً كَقَلائِدِ العِقْيَانِ",8,"ن",1,0],["سَلْمَى العُلُومُ جَمِيعُهَا فِي لَفْظَةٍ","كَالعِطْرِ قَطْرَتُهُ عَصِيرُ جِنَانِ",8,"ن",1,0],["سَلْمَى الحَيَاةُ وَمَا النَّعِيمُ مُخَلَّداً","يُشْرَى لَدَى إِقْبَالِهَا بِثَوَانِي",8,"ن",2,0],["سلمت بسعدك من غوائل مثلها","وكفى بسعدك حامياً لذمارِ",9,"ر",1,0],["سَلِمتَ وَجادَتكَ الغُيوثُ الرَوابِعُ","فَإِنَّكَ وادٍ لِلأَحِبَّةِ جامِعُ",10,"ع",1,0],["سلموا على عطب الوغى ودجى بهم","داجي المنون إلى محل بوار",11,"ر",1,0],["سلم المعلوم شهراً واحداً","ثمّ ما سلم حتى ودّعا",12,"ع",2,0],["سلِمْت ياابن سليمانَ لكم","زينة الدنيا وعُقبى الآخره",13,"ر",2,0],["سلِّم لإِسماعيل إني ناصحٌ","لك والْهُ عن وَسْواسِك الخناس",14,"س",1,0],["سِلمُ عيٍّ محارباً كل شيءٍ","وافرٍ حظه من التقديس",15,"س",1,0],["سلِّم من الريث والإقلاع جائزتي","فالعرف بالريث والإقلاع مأووف",16,"ف",1,0],["سلم المَوْلِدُ والدين معاً","لمُواليكم ولو خاض الفتن",17,"ن",1,0],["سَلمى بِماذا تُفَكِّرين","سَلمى بِماذا تحلُمين",18,"ن",1,0],["سَلِّم عَليَّ إِذا مَرَر","تَ فَلا أَقَلَّ مِنَ السَلامِ",19,"م",1,0],["سَلِمتَ مِن كُلِّ أَلَم","وَدُمتَ مَوفورَ النِعَم",20,"م",1,1],["سَلَّمَ اللَهُ عَلى مَن","جاءَنا مِنهُ السَلامُ",21,"م",1,1],["سلم فإن برا","هيني هذه مفحمات",22,"ت",1,0],["سلمى جثت يوماً بجانب أمها","تبكي كما يبكي الحزين المفجع",23,"ع",1,0],["سلمى تسلمت الكتاب وقلبها","فرقاً يكاد بصدرها يتفلَّع",23,"ع",1,0],["سُلّم الناس إلى المجد إذا","طلبوا سلمه والسببا",24,"ب",2,0],["سُلّم الدنيا وضرّتها","ونظام الناس والعصر",25,"ر",1,0],["سَلِمَ الثَعلَبُ بِالرَأسِ الصَغير","فَفَداهُ كُلُّ ذي رَأسٍ كَبير",26,"ر",1,0],["سَلِمَت مِن عَنَتِ الطَبعِ وَمِن","كُلفَةِ الأَقلامِ أَو حَشوِ الكُتُب",27,"ب",1,0],["سَلَّ مَن فيهِ لِساناً عَنَماً","ماضِياً في البَثِّ لَم يَحتَبِسِ",28,"س",1,0],["سَلِمْتَ فكم سَقْيتَ رياضَ مدحي","رَذاذاً من نَوالِكَ أو رِهاما",29,"م",2,0],["سَلِمْتَ ما فَعَلَتْ غِزْلانُ ذي سَلَمٍ","إذا الكِناسُ الذي حلَّتْ به سَلَمُ",30,"م",1,0],["سَلِمْتَ للمجدِ يا سلامةُ ما","غرَّدَ حادٍ لرِحْلَةٍ وَحَدا",31,"د",2,0],["سَلِمْتَ لنَشْرِ عارفةٍ رُفاتٍ","تَعُمُّ ودَفْعِ نائبةٍ نآدِ",32,"د",1,0],["سَلِمتَ سلامَةُ للمَكْرُماتِ","وما زِلْتَ تَبسُطُ باعاً رَحيبا",33,"ب",2,0],["سَلِمْتَ لبيضةِ الإسلامِ ترمي","مراميَها انصلاتاً وانتدابا",34,"ب",2,0],["سَلِّم لِأَمرِ اللَهِ وَأَر","ضَ بِهِ وَكُن مُتَرَقِّبا",35,"ب",2,0],["سَلِّم وَلا تُنكِر لِرَبِّكَ قُدرَةً","فَاللَهُ يَخفِضُ مَن يَشاءُ وَيَرفَعُ",36,"ع",1,0],["سَلِّم عَلى الدُنيا سَلامَ مُوَدِّعٍ","وَاِرحَل فَقَد نوديتَ بِالتَرحالِ",37,"ل",1,0],["سَلمُ يا سَلمُ لَيسَ دونَكَ سِترُ","حُبِسَ المَوصِلِيُّ فَالعَيشُ مُرُّ",38,"ر",1,1],["سَلّمِ الأمرَ منك للّه واعْلَم","أنّ ما قدْ قضى به سيكونُ",39,"ن",1,1],["سلّمَ الإيماءُ عنها خجلاً","أوَمَا كان لها النّطقُ مُباح",40,"ح",1,0],["سَلِّم عَلى الرَبعِ مِن سَلمى بِذي سَلَمِ","عَلَيهِ وَسمٌ مِنَ الأَيّامِ وَالقِدَمِ",41,"م",1,1],["سَل مُخبِراتِ الشِعرِ عَنّي هَل بَلَت","في قَدحِ نارِ المَجدِ مِثلِ زِنادي",42,"د",2,0],["سَلِمتَ وَإِن كانَت لَكَ الدَعوَةُ اِسمُها","وَكانَ الَّذي يَحظى بِإِنجاحِها السَعدُ",43,"د",1,0],["سَلْ مَالِكَ الْمُلْكِ فَهْوَ الآمِرُ النَّاهِي","وَلا تَخَفْ عَادِياً فَالْحُكْمُ لِلَّهِ",44,"ه",1,1],["سَلْ مِصْرَ عَنِّي إِنْ جَهِلْتَ مَكَانَتِي","تُخْبِرْكَ عَنْ شَرَفٍ وَعِزٍّ أَقْدَمِ",45,"م",1,0],["سَلِّمْ أُمُورَكَ لِلَّذِي","أَنْشَاكَ مِنْ عَدَمٍ وَعَالَكْ",46,"ك",1,0],["سلَّمَنا اللهُ وإياكُم","مِنْ شرِّه فَهْوَ ألدُّ الخصامْ",47,"م",1,0],["سلَّمْتُ أنَّكَ ترتشي","قدِّمْ بعلمٍ أو نسبْ",48,"ب",1,1],["سلِّمْ إلى اللهِ فكلُّ الذي","ساءَكَ أو سرَّكَ مِنْ عندِهِ",49,"ه",1,1],["سَلَّمتُ حينَ لَقيتُها فَتَهَلَّلَت","لِتَحيَّتي لَمّا رَأَتني مُقبِلا",50,"ل",2,0],["سَلَّمتُ فَاِلتَفَتَت بِوَجهٍ واضِحٍ","كَالبَدرِ زَيَّنَ ذاكَ جيدٌ أَتلَعُ",51,"ع",1,0],["سَلَّمَ اللَهُ أَلفَ ضِعفٍ عَلَيكُم","مِثلَ ما قُلتُمُ لَنا في الكِتابِ",52,"ب",1,0],["سَلَّمَ الغُصنُ وَالكَثيبُ عَلَينا","فَعَلى الغُصنِ وَالكَثيبِ السَلامُ",53,"م",1,0],["سَلِمتَ وَصادَفتَ خَيراً وَيُمناً","رِكابُكَ في رَواحٍ وَاِبتِكارِ",54,"ر",1,0],["سلمانُ أحسنتَ الصَّنيعَ ونِلتَهُ","نَسباً مضى فقضى لك التقديما",55,"م",2,0],["سلمانُ منّا آلَ بيتِ محمدٍ","ولقد نُسبتَ فما نسبتَ زنيما",55,"م",2,0],["سلمانُ دعها كُدْيَةً تُوهِي القُوَى","وتردُّ كلَّ مُحدَّدٍ مثلوما",55,"م",2,0],["سَلمتْ يداك أبا دُجانةَ من فتىً","وَسْمُ المنيَّةِ من حِلَى صَمْصَامِهِ",56,"م",2,0],["سَلِمتَ أَميرَ المُؤمِنينَ عَلى الدَهرِ","وَلا زِلتَ فينا باقِياً واسِعَ العُمرِ",57,"ر",1,1],["سَلْ مِنْ سَلِيلِهمُ سُلوكَ سَبيلِهِمْ","يُرْشِدْكَ أحمدُ للطَّرِيقِ الأحمدِ",58,"د",1,0],["سِلمٌ وَلَكِنَّها حَربٌ لِذائِقِها","يا حَبَّذا بَأسُها ما كانَ مِن باسِ",59,"س",1,0],["سَلِّم عَلى الجودِ قَد لاحَت مَخايِلُهُ","عَلى اِبنِ عَمِّ نَبيِّ الرَحمَةِ الهادي",60,"د",2,0],["سَلمى هِيَ النَفسُ وَهَمُّ الفَتى","رَضيتُ مِنها بِمَقالٍ رَضيتُ",61,"ت",1,0],["سَلمى ثَقالُ الرِدفِ مَهضومَةٌ","يَأبى سِواها قَلبي الخالِبُ",62,"ب",1,0],["سَلِّم عَلى الدارِ بِذي تَنضُبِ","فَشَطِّ حَوضى فَلِوى قَعنَبِ",63,"ب",1,1],["سَلمانُ تُفهَمُ عَنهُ فارِسِيَّتُهُ","فَدَع سُلَيمانَ وَالمَعنى رَدى البَطَلُ",64,"ل",1,0],["سلَّمت أنك بالثراء ممتع","لكن بقاؤك فيهِ غير مسلم",65,"م",1,0],["سل من العلم ما جنى الجهل في الما","ضي على المصلحين فهو الخَبير",66,"ر",1,0],["سل من أَلَمَّ بها يقيس خرابها","ماذا يرى فيها من العمران",67,"ن",1,0],["سُلَّم يُشبهُ الصرا","طَ تسامى على البصَرْ",68,"ر",1,0],["سَلِمْتَ مَلاذاً لأَبْنَائِهِمْ","فَأَسْنَى الأَمَانِيِّ أَنْ تَسْلَمُوا",69,"م",3,0],["سَلْمَى مِنَ الأَرْبَعِ الغَوَالِي","إِحْدَى الفَريدَاتِ فِي الَّلآلِي",70,"ل",2,1],["سَلِمَتْ مِنْ شَوَائِبِ التَّكْدِيرِ","أَعْيُنُ السَّيِّدِ الهُمَامِ الأَمِيرِ",71,"ر",1,1],["سَلْ مُوحِشاً فِي طُورِسيِنَا سَامِعاً","كَلِمَ المُهَيْمِنِ فِي اصْطِعَاقِ النَّارِ",72,"ر",1,0],["سَلِمْتِ لِلْمَلِكِ العَظِيمِ الَّذِي","يَنْتَظِمُ النَّيلَ وَمَا يَسْقِي",73,"ق",2,0],["سَلِّمْ إِلى تِلْكَ الجَلاَ","لَةِ فَهْيَ مِنْ عَالٍ تَرَاكْ",74,"ك",1,0],["سَلِمَتْ تِلْكَ مِنْ بَنَانٍ بِهَا الإِثْ","رَاءُ أَثْرَى وَأُعْدِمَ الإِعْدَامُ",75,"م",1,0],["سَلِمْتَ لَوَ أَنَّ السَّهْمَ سَهْمُ مُقَاتِلِ","وَلَكِنَّ مَا أَصْمَاكَ سَهْمُ مُخَاتِلِ",76,"ل",1,1],["سَلْ مَالِكاً مُتَمَكِّناً","فِي الأَرْضِ فَتَّاحَ الثُّغُورْ",77,"ر",1,0],["سَلِمَتْ نُهَاكَ وَدَامَ فِي تَصْرِيفِهَا","مَا فِيهِ نَفْعٌ لِلْحِمَى وَفخَارُ",78,"ر",1,0],["سَلِمَتْ مَشِيئَتُهُمْ وَمَا فِيهِمْ سِوَى","مُتَقَطِّعِي الأَوْصَالِ وَالأَعْضَاءِ",79,"ا",2,0],["سلمى، أحس النار سائة","بدمي، وتجري معه في جسدي",80,"د",2,0],["سلماي إنك أنت قاتلي","فجميل جسمك مدفني الأبدي",80,"د",2,0],["سلمى اطفئي الأنوار وافتتحي","هذي الكوى لنسائم جدد",80,"د",1,0],["سَلْمَى أَرَى الشَّمْسَ في خَدَّيْكِ ضاحِكَةً","وكُنْتِ كالغَيْمَةِ المَقْطُوبِ جَفْناها",81,"ا",3,0],["سَلَّمَكَ اللَهُ مِن سُهادي","هَب لِجُفوني مِنَ النُعاسِ",82,"س",1,0],["سَلمتُ بِاللَّهِ وَاِستَعَذتُ بِهِ","مِن هَمَزاتِ الشيطانِ إِذ نَزَعا",83,"ع",2,0],["سلِمَتْ للتاجِ أصفَى دُرّةٍ","وأقرَّ اللّهُ عيْنَ الوالدينْ",84,"ن",1,0],["سَلْ مَنْ رَأَوْهُ فَكُلُّهُمْ","لِنَوَالِ بَدْرِ 