{"poems":[[51,"طلب البيهقي قرنا فلم يحرمه","https://www.aldiwan.net/poem66478.html","البسيط"],[89,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[66,"أنكر الصبح دم الليل","https://www.aldiwan.net/poem40670.html","مجزوء الرمل"],[69,"قال عطار مليح","https://www.aldiwan.net/poem28312.html","مجزوء الرمل"],[69,"وتاجر شاهدت عشاقه","https://www.aldiwan.net/poem28314.html","السريع"],[69,"قال عذالي عليه","https://www.aldiwan.net/poem28676.html","مجزوء الرمل"],[69,"قال عذولي كف عن","https://www.aldiwan.net/poem28680.html","مجزوء الرجز"],[69,"قال عطاري وعن في","https://www.aldiwan.net/poem29082.html","مجزوء الرمل"],[69,"وتاجر شاهدت عشاقه","https://www.aldiwan.net/poem29282.html","السريع"],[189,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[199,"شفني بعد من","https://www.aldiwan.net/poem45210.html","مجزوء المتدارك"],[223,"الليل في صدري بدا يظلم","https://www.aldiwan.net/poem41631.html","السريع"],[223,"حاذر الحب إن في الحب شرا","https://www.aldiwan.net/poem41905.html","الخفيف"],[338,"قال علي بن أبي طالب","https://www.aldiwan.net/poem68683.html","السريع"],[349,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[371,"وصديق مصدق","https://www.aldiwan.net/poem57351.html","مجزوء الخفيف"],[403,"قال عبد مسه طول الضرر","https://www.aldiwan.net/poem33934.html","الرمل"],[432,"قال عبد المليك عندي كتب","https://www.aldiwan.net/poem12408.html","الخفيف"],[458,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[458,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[500,"ما انبلج الصباح في طالعه","https://www.aldiwan.net/poem37820.html","الرجز"],[538,"قلت من ذا قال إبني","https://www.aldiwan.net/poem47515.html","عموديه"],[538,"قال اسمه مفضل","https://www.aldiwan.net/poem48014.html","عموديه"],[558,"سميت ساعة فخذ نطق فيها","https://www.aldiwan.net/poem33665.html","الخفيف"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["قال عبد الأمير قلتُ هواناً","لك كلُّ الهوان بل عبدُ بطنه",0,"ن",2,0],["قال علمت الشعب ما يتقاضى","فهو عما خططت لا يتحول",1,"ل",1,0],["قالَ عُذرُ الصُبحِ في إِن","كارِهِ لا يَتَحَصَّل",2,"ل",1,0],["قالَ عطّارٌ مليحٌ","يُخجِلُ الغصنَ النَّضيرْ",3,"ر",1,1],["قال علامَ اقتتلوا هكذا","قلتُ على عينيكَ يا تاجرُ",4,"ر",1,0],["قالَ عُذَّالي عليهِ","وجوابُ الزينِ زينُ",5,"ن",1,1],["قالَ عذولي كفَّ عنْ","تركِ الخطا واخشَ السطا",6,"ط",2,1],["قالَ عطّاري وعَنْ في","هِ وعَنْ خدَّيهِ أنبا",7,"ب",2,1],["قال علامَ اقتتلوا هكذا","قلتُ على عينكَ يا تاجرْ",8,"ر",1,0],["قالَ عُذراً فلَن أُجاوزَ حدّي","لَو تقدّمت حلّ فيَّ الفناءُ",9,"ا",2,0],["قال عذري الهوى","والهوى ذنبهُ",10,"ب",2,0],["قالَ عَجيبٌ لَيسَ من راحِمٍ","وَأَينَ سَلمى قُلتُ لا ترحمُ",11,"م",1,0],["قالَ عذراً يا هِندُ إِنَّ فُؤادي","أَخطَأَ السَيرَ معكِ يا هندُ عذرا",12,"ر",2,0],["قالَ عَلِيُّ بنُ أَبي طالِبٍ","وَهوَ اللَبيبُ الفَطِنُ المُتقِنُ",13,"ن",1,1],["قالَ عَدا الرُشدُ سِوا","كَ وَمُعاديكَ عَثَر",14,"ر",1,0],["قالَ عن جَعفرِ بن مُغ","نِم قَولاً مُلَخَّصا",15,"ص",2,0],["قال عبد مسَّه طول الضرر","يأمر النفس بخير منتظر",16,"ر",1,1],["قال عبدُ المليك عندِي كُتْبٌ","قد تَبَحَّرْتُهَا بقَدْرِ اقْتِراحي",17,"ح",2,1],["قال عنها الواشون حقّاً فعِفْنا","وقنِعنا بالطيف والطيفُ زورُ",18,"ر",1,0],["قال عشقتَ أَشيباً يعدُّها","منقصةً نعم عشقتُ أشيبا",19,"ب",2,0],["قالَ عَذولي قَتَلَتْهُ لَوْعَةٌ","أفْدي بِروحي راضِياً من قَتَلا",20,"ل",2,0],["قال عَبدُ الله لمَّا","قلتُ ما إسمُ النَّبيه",21,"ب",3,0],["قال على حَميرِهِم","فاحتَجًَّتِ الحَميرُ",22,"ر",1,0],["قال عنها ترونها دون تأتي","فتأمل لأنه مبديها",23,"ي",3,0],["قال علي أنا يا خير الورى","أنصر في الله على ما قد ترى",24,"ر",2,0],["قال علي إنها مكيدة","قالوا له وأكثروا تفنيده",24,"ه",1,0]]}