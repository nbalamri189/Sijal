{"poems":[[53,"طلب البيهقي قرنا فلم يحرمه","https://www.aldiwan.net/poem66478.html","البسيط"],[91,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[68,"أنكر الصبح دم الليل","https://www.aldiwan.net/poem40670.html","مجزوء الرمل"],[71,"قال عطار مليح","https://www.aldiwan.net/poem28312.html","مجزوء الرمل"],[71,"وتاجر شاهدت عشاقه","https://www.aldiwan.net/poem28314.html","السريع"],[71,"قال عذالي عليه","https://www.aldiwan.net/poem28676.html","مجزوء الرمل"],[71,"قال عذولي كف عن","https://www.aldiwan.net/poem28680.html","مجزوء الرجز"],[71,"قال عطاري وعن في","https://www.aldiwan.net/poem29082.html","مجزوء الرمل"],[71,"وتاجر شاهدت عشاقه","https://www.aldiwan.net/poem29282.html","السريع"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[203,"شفني بعد من","https://www.aldiwan.net/poem45210.html","مجزوء المتدارك"],[228,"الليل في صدري بدا يظلم","https://www.aldiwan.net/poem41631.html","السريع"],[228,"حاذر الحب إن في الحب شرا","https://www.aldiwan.net/poem41905.html","الخفيف"],[343,"قال علي بن أبي طالب","https://www.aldiwan.net/poem68683.html","السريع"],[354,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[376,"وصديق مصدق","https://www.aldiwan.net/poem57351.html","مجزوء الخفيف"],[409,"قال عبد مسه طول الضرر","https://www.aldiwan.net/poem33934.html","الرمل"],[438,"قال عبد المليك عندي كتب","https://www.aldiwan.net/poem12408.html","الخفيف"],[463,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[463,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[505,"ما انبلج الصباح في طالعه","https://www.aldiwan.net/poem37820.html","الرجز"],[543,"قلت من ذا قال إبني","https://www.aldiwan.net/poem47515.html","عموديه"],[543,"قال اسمه مفضل","https://www.aldiwan.net/poem48014.html","عموديه"],[563,"سميت ساعة فخذ نطق فيها","https://www.aldiwan.net/poem33665.html","الخفيف"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77608","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77573","الرجز"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202129","الخفيف"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46510","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46517","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79868","السريع"],[1843,"","https://poetry.dctabudhabi.ae/diwan/poem/130231","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67256","الرمل"],[2400,"","https://poetry.dctabudhabi.ae/diwan/poem/205095","الخفيف"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121183","الخفيف"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121432","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112312","الرمل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66320","السريع"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[4142,"","https://poetry.dctabudhabi.ae/diwan/poem/101331","الرمل"],[4196,"","https://poetry.dctabudhabi.ae/diwan/poem/147616","الرجز"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90877","الرمل"],[4728,"عابر سبيل","https://www.poetsgate.com/ViewPoem.aspx?id=176954",""],[4767,"خروج الحسين","https://www.poetsgate.com/ViewPoem.aspx?id=199425",""],[4927,"عدوية","https://www.poetsgate.com/ViewPoem.aspx?id=80805",""],[5056,"<< هذيانُ شاعر..>>","https://www.poetsgate.com/ViewPoem.aspx?id=33175",""],[5183,"قال","https://www.poetsgate.com/ViewPoem.aspx?id=186485",""],[5434,"الشاور غشاني","https://www.poetsgate.com/ViewPoem.aspx?id=37612",""],[5480,"بت ساهد","https://www.poetsgate.com/ViewPoem.aspx?id=4104",""],[5776,"الحكيمُ الرابع","https://www.poetsgate.com/ViewPoem.aspx?id=199327",""],[6056,"كل عصر له رجال ودولة","https://www.poetsgate.com/ViewPoem.aspx?id=130133",""],[6093,"لَا يَرَاكَ اللهُ إلَا مُحْسِنَا","https://www.poetsgate.com/ViewPoem.aspx?id=199912",""]],"verses":[["قال عبد الأمير قلتُ هواناً","لك كلُّ الهوان بل عبدُ بطنه",0,"ن",2,0],["قال علمت الشعب ما يتقاضى","فهو عما خططت لا يتحول",1,"ل",1,0],["قالَ عُذرُ الصُبحِ في إِن","كارِهِ لا يَتَحَصَّل",2,"ل",1,0],["قالَ عطّارٌ مليحٌ","يُخجِلُ الغصنَ النَّضيرْ",3,"ر",1,1],["قال علامَ اقتتلوا هكذا","قلتُ على عينيكَ يا تاجرُ",4,"ر",1,0],["قالَ عُذَّالي عليهِ","وجوابُ الزينِ زينُ",5,"ن",1,1],["قالَ عذولي كفَّ عنْ","تركِ الخطا واخشَ السطا",6,"ط",2,1],["قالَ عطّاري وعَنْ في","هِ وعَنْ خدَّيهِ أنبا",7,"ب",2,1],["قال علامَ اقتتلوا هكذا","قلتُ على عينكَ يا تاجرْ",8,"ر",1,0],["قالَ عُذراً فلَن أُجاوزَ حدّي","لَو تقدّمت حلّ فيَّ الفناءُ",9,"ا",2,0],["قال عذري الهوى","والهوى ذنبهُ",10,"ب",2,0],["قالَ عَجيبٌ لَيسَ من راحِمٍ","وَأَينَ سَلمى قُلتُ لا ترحمُ",11,"م",1,0],["قالَ عذراً يا هِندُ إِنَّ فُؤادي","أَخطَأَ السَيرَ معكِ يا هندُ عذرا",12,"ر",2,0],["قالَ عَلِيُّ بنُ أَبي طالِبٍ","وَهوَ اللَبيبُ الفَطِنُ المُتقِنُ",13,"ن",1,1],["قالَ عَدا الرُشدُ سِوا","كَ وَمُعاديكَ عَثَر",14,"ر",1,0],["قالَ عن جَعفرِ بن مُغ","نِم قَولاً مُلَخَّصا",15,"ص",2,0],["قال عبد مسَّه طول الضرر","يأمر النفس بخير منتظر",16,"ر",1,1],["قال عبدُ المليك عندِي كُتْبٌ","قد تَبَحَّرْتُهَا بقَدْرِ اقْتِراحي",17,"ح",2,1],["قال عنها الواشون حقّاً فعِفْنا","وقنِعنا بالطيف والطيفُ زورُ",18,"ر",1,0],["قال عشقتَ أَشيباً يعدُّها","منقصةً نعم عشقتُ أشيبا",19,"ب",2,0],["قالَ عَذولي قَتَلَتْهُ لَوْعَةٌ","أفْدي بِروحي راضِياً من قَتَلا",20,"ل",2,0],["قال عَبدُ الله لمَّا","قلتُ ما إسمُ النَّبيه",21,"ب",3,0],["قال على حَميرِهِم","فاحتَجًَّتِ الحَميرُ",22,"ر",1,0],["قال عنها ترونها دون تأتي","فتأمل لأنه مبديها",23,"ي",3,0],["قال علي أنا يا خير الورى","أنصر في الله على ما قد ترى",24,"ر",2,0],["قال علي إنها مكيدة","قالوا له وأكثروا تفنيده",24,"ه",1,0],["قالَ عَجيبٌ أَنَّني أخيفُ","فَذاك غَيري قَلبه ضَعيفُ",25,"ف",1,0],["قالَ عَلَيهِ بِحسامِ البين","وَشَقَّه لوقتِهِ نِصفَين",26,"ن",1,0],["قال عيسى أحيي الموات جهارا","قلت مهلا يا ناقصي الفهم مهلا",27,"ل",2,0],["قال عيسى أبرا العمى قلت مولا","ي معد يجلو العَمَى إن تَجَلى",27,"ل",2,0],["قالَ عَسى فيهم لَنا معارف","أَو عَرَبي أَو فَتى محالف",28,"ف",1,0],["قالَ عَلى ذمك دونَ الإِنس","فَقالَ غمر الرأي غَير نكس",29,"س",1,0],["قال عليكَ الوزرُ في نعتها","قلتُ وخُذ أنتَ مُهنَّاها",30,"ا",3,0],["قال عثمان زُر حبابة بالعر","صة تحدث تحية وسلاما",31,"م",2,1],["قال عيسى اللَّهُمَّ أنزِل علينا","ما أرادوا حتى يَتِمَّ الوَفاء",32,"ا",2,0],["قال عجَّل فالصباحُ ابتسما","قلتُ برقع وجهها بالشعر",33,"ر",1,0],["قال عمرو مفاخرا","نحن قوم من العرب",34,"ب",1,1],["قال عبد الرحمن قلت كريم","اننا الموصلي والمأمون",35,"ن",1,0],["قال عليٌّ وكان عدلاً","قد طُبخت قلتُ فاسقنيها",36,"ي",3,0],["قال عيشي في سواها قد ذوَى","وزماني إن صفا فهو كذوب",37,"ب",1,0],["قالع باب الحصن في خيبر","رامي أولي الشرك بابلاسِ",38,"س",1,0],["قال عبيد الله ما العينينِ","يرجو صلاح القلب والدَّارينِ",39,"ن",1,1],["قالع الصحرة عن وجه القليب","حيدر غذ أظهر الماء المعين",40,"ن",1,0],["قال علي مذ أتى من قاله","قصيدةً واضحة المقاله",41,"ه",1,1],["قالعا من باغضيه أعينا","حشوها عين وميم ثم شين",42,"ن",1,0],["قال عابر قلت عابر عسى عمرك مديد","عن بلادٍ دورها صارت اضيق من قبر",43,"ر",1,0],["قال: عيد الله، لِمْ لا","تحتفل، قلتُ: تمهَّل",44,"ل",1,0],["قَاْلَ عَبْدُ الْكَرِيْمِ: يَاْ عَدَوِيَّةْ","أَنْتِ أَحْلَىْ ظَبْيَةٍ بَدَوِيَّةْ",45,"ي",2,1],["قال:- علمٌ كاملٌ رجَزٌ ووافر","قلتُ:- حاضر ثابتُ الخطوة مائل",46,"ل",1,0],["قال عذب القول منها شاقني","قلت كم شاق وكم أشقَى المقال",47,"ل",1,0],["قال عَمري إنها قارئة","قلت كن من قاريء الحظ ببال",47,"ل",1,0],["قال عقلي لا يريني غيرها","قلت بعض العقل للمرء عقال",47,"ل",1,0],["قال عن وقلت بأيا لحينه","قال قل ناسي خوي مانساني",48,"ن",2,0],["قال عاشج؟ قلت يا ويلي","ماخذن بالشرع والسنه",49,"ن",2,0],["قالَ :عجلى... إلى الحلولِ استبقتم","ليسَ تأتي بلا غيوثٍ غضارهْ",50,"ر",2,0],["قال عدّي قراح ٍ ، سلسبيل ٍ محلىّ","خلف حصن ٍ حصين ٍ ما يطال بسهوله",51,"ل",2,0],["قَالَ عِظْنِي فِي كَلَامٍ مُوجَزٍ","فَاخْتِصَارُ القَوْلِ كَانَ الأحسَنَا",52,"ن",2,1]]}