html","الخفيف"],[567,"نعم الهدية يهتدي الساري بها","https://www.aldiwan.net/poem52727.html","الكامل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83303","الخفيف"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137341",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87117","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86615","الخفيف"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126159","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55893","الرمل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64714","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112832","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110315","الكامل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137946",""],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93653","الرمل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137400",""],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83215","الكامل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116493","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132728","الكامل"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71364","الرمل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123916","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126976","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138578",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138466",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91074","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128918","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111472","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111424","الخفيف"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105122","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90882","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90799","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72791","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120354","الكامل"],[4645,"","https://poetry.dctabudhabi.ae/diwan/poem/105487","الخفيف"],[4680,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=185914",""],[4926,"يا دليل الرَّكب إلى نجدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=171110",""],[4968,"تغريدة الكروان","https://www.poetsgate.com/ViewPoem.aspx?id=208101",""],[5092,"نظرةٌ في عيوني","https://www.poetsgate.com/ViewPoem.aspx?id=149793",""],[5129,"خمسون عاما","https://www.poetsgate.com/ViewPoem.aspx?id=151601",""],[5211,"أحْلامُ أيَّامِ الشِّتاء","https://www.poetsgate.com/ViewPoem.aspx?id=176161",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5414,"الهابطون والصاعدون","https://www.poetsgate.com/ViewPoem.aspx?id=12938",""],[5737,"رسالة لأهلنا في اليمن","https://www.poetsgate.com/ViewPoem.aspx?id=198441",""],[5781,"جمرةٌ في زحمة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=204823",""],[5782,"جموح / د. عمر هزاع","https://www.poetsgate.com/ViewPoem.aspx?id=183618",""],[5897,"همسات لحظة","https://www.poetsgate.com/ViewPoem.aspx?id=156243",""],[5966,"الطائف","https://www.poetsgate.com/ViewPoem.aspx?id=158861",""],[5190,"اصمد وقاوم أيها اللبناني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78289&r=&rc=3",""]],"verses":[["وَعَلى رِجالِ الجَيشِ مِن ماشٍ بِهِ","أَو راكِبٍ أَو نازِحٍ أَو داني",0,"ن",2,0],["وعلى روسه تعبّيه","فالرياض بين الصنائف",1,"ف",1,0],["وعلى رؤس الأصابع قامت","تتخطّى تبختراً ووثوبا",2,"ب",2,0],["وَعَلى رُغمِ الأَعادي","فَلَقَد تَمَّت قَضايا",3,"ا",3,0],["وعلى ربوع الصين كبَّر فيلقٌ","وبأرض قسطنطين رفَّ لواءُ",4,"ا",2,0],["وَعَلَى رُؤُوسِ الخَائِفِنَ","اللهَ قدْ يَقَعُ العَقَابْ",5,"ب",1,0],["وَعَلَى رَأْسِهِمْ أبو الحسن الْجرَّا","ح مَنْ كالرَّئِيس أوْ كالْعَمِيدِ",6,"د",1,0],["وعلى رغم عفّتي º رغم أمّي","وأبي عدت مومسا سكّيره",7,"ر",2,0],["وعلى راية الشام كميّ","يقحم الدرعين أشقر نهدا",8,"د",2,0],["وعلى رجال الغيب ما حادشدا","من للفقير المشتكي من حاله",9,"ل",2,0],["وعلى رباها جاد بالدر الحيا","كندى جلال الدين يوم سخاء",10,"ا",2,0],["وعلى روحه اجل سلام","في صباح وغدوة ومساء",11,"ا",2,0],["وَعَلَى رَفِيعِ مَقَامِكُمْ مِمَّنْ أَتَى","مُتَظَلِّماً مِنْ فِعْلِ وَغْدٍ زَاهِ",12,"ا",2,0],["وعلى رُبى بيروتَ ألفُ تحيَّةً","فُهناكَ أذكُرُ وَقفَتي وبُكائي",13,"ا",2,0],["وعلى ركابِهمُ بُدورُ دُجىً","هَيَّجْنَ يومَ تَحمَّلوا حَزَني",14,"ن",2,0],["وعلى رباك تحية لا تنقضي","يا مفرداً جمع العلى بتفرد",15,"د",1,0],["وعلى ركن معاليها شدا","بلبل الأفراح دامت وعلت",16,"ت",1,0],["وعلى رياضِ بَنَانِه وبيانِه","تتغايَرُ الأَبصارُ والآذانُ",17,"ن",1,0],["وعلى ردايانا ابن داية حائم","وابن العميثل وابن حثل الأفطس",18,"س",1,0],["وعلى رضاك وفي رضاك فأحينا","وعلى رضاك متى نموت أميتنا",19,"ن",2,0],["وعلى رسولك صل فهو نبينا","أرجوه عندنا فهو لي فشفيع",20,"ع",1,0],["وعلى ركنك أرسى علمه","خبر التوكيد بعد المبتدا",21,"د",2,0],["وعلى رباط اللهو حولَك ضُمَّرٌ","ذيَّالة أذنابُها أعرافُ",22,"ف",1,0],["وعلى رَقِّ بَياني","يَمَناً سرْ بي وشَامَا",23,"م",2,0],["وعلى رأيك الجميل ارتياشي","وانتعاشي من عطلتي والبطالة",24,"ل",2,0],["وعلى رُبَى لبنانَ منهُ نِعمةٌ","يَبقَى لها ذِكرٌ على طول المَدَى",25,"د",2,0],["وَعَلى رَأسِها خَليفَةُ عَصرٍ","دَهرُهُ تابِعٌ لَهُ وَغُلامِ",26,"م",1,0],["وعلى رضاكِ دماؤُنا موقوفةٌ","والموتُ عذبٌ في سبيل رضاك",27,"ك",1,0],["وَعلى رؤوس الخائنين حسامه","مِنهُ عَلَيها في المَصالح حائم",28,"م",1,0],["وَعلى رَغمه أَعيش عَزيزاً","في أَمان مِن غائِلات النَوائب",29,"ب",1,0],["وعلى رسول الله ألف تحية","والآل والأصحاب أصحاب الصفا",30,"ف",2,0],["وعلى رغم العدى قد سعدا","وتما ذكرهما بين الأنام",31,"م",1,0],["وَعَلى رَياحينِ الْعِذا","رِ بِعارِضِ الرَّشَأِ الْمَليحِ",32,"ح",1,0],["وعلى رسولك والد الزهر اصلا","تك والسلام مع الرضا كل الزمن",33,"ن",1,0],["وعلى رضاكم قد تعا","قدنا الاصابع بالأصابع",34,"ع",1,0],["وعلى ربوعك والحدائق سلطوا ال","إزهاق والتدمير والتقليعا",35,"ع",2,0],["وعلى رسولك أفضل الصلوات والت","سليم منك وأكمل الرضوان",36,"ن",1,0],["وَعَلى رَوضة خَديك اِسقِني","مِن لماك العَذب لا صَرف السلافه",37,"ف",2,0],["وعلى رحابك يا مليك العصر قد","وافى جمال العيد روضا أخضرا",38,"ر",2,0],["وَعَلى رَجا الأَنهارِ أَسكُنُ لِلهَوى","فَيُثيرُ نارَ صَبابَتي إِسكاني",39,"ن",2,0],["وعلى ربوعك وهي سفح سجد","وكفت غمامات الحيا المتضاف",40,"ف",1,0],["وعلى رؤوس أولى الراسة والعلا","قد سار رضوى ماثلا وشمامها",41,"م",3,0],["وَعلَى رَغْمِ الحَسُودِِ","أَنْجَزُوا بِالوَصْلِ وَعْدِي",42,"د",2,0],["وعلى رؤوس السمر منكم أرؤس","شمس الضحى لوجوهها حرباء",43,"ا",2,0],["وعلى رأسه زها تاج فخر","بسوى العز في الورى ليس يعقد",44,"د",1,0],["وعلى رأسه لقد رفرف النصر","ولكن رأى المنية احرى",45,"ر",2,0],["وعلى رأس ابن صاغراً","أوقفوا إذ نكثوا عقد ولاه",46,"ا",2,0],["وَعَلى رحابك قَد أنختُ مطيةً","إِن لَم يكرّم نُزْلُها لم تركب",47,"ب",1,0],["وعلى رأسها أكاليل ورد","وضعوها لها بعيد الحمام",48,"م",1,0],["وَعلى رُكبَتِها فِيهِ ضَعِي","وَانذُرِي أَن تَرجِعي مُبتدَرَِه",49,"ه",1,0],["وَعلى رُكبَتَيَّ صُغراً تَرَامَت","فأَطَعتُ الهَوَى ولَبَّيتُ أَمرا",50,"ا",1,0],["وعلى رأسهِ تَؤُجُّ سَناءً","خُوذَةٌ وَهوَ صاحبُ التَّبجِيل",51,"ل",1,0],["وعلى رضاها لا تصر فانها","تزداد في الشحناء بالإصرار",52,"ر",1,0],["وعلى رياض الفضل أصبح ساحبا","ذيلا على غير العلا لم يسحب",53,"ب",1,0],["وعلى رحيم القلب طه جدكم","صلى وسلم ربنا الرحمن",54,"ن",1,0],["وعلى راياتهِ قد كُتِبَت","آيةُ الفتحِ من النصرِ فلاحا",55,"ح",2,0],["وعلى رئاسته بهم","اقلامهم قامت دلائل",56,"ل",1,0],["وعلى رغم أنفها استبدلت عن","قاطنيها وحش الفلا والغولا",57,"ل",2,0],["وعلى ربوع الضفتين خوافقٌ","تصحو على أنسامهنّ وتسكرُ",58,"ر",1,0],["وعلى رأسٍ ضعه إكليلاً","لتنال العزَّة والمنحا",59,"ح",2,0],["وعلى ربى الابداع زان قصيدتي","سربٌ من الابيات كالغزلان",60,"ن",1,0],["وعلى ربيعِ خدودها","تخضرُّ دوماً بسمتي",61,"ت",2,0],["وعلى رياض الرمش قصَّةُ زهرةٍ","تهدي البرايا بهجةً وتنوحُ",62,"ح",1,0],["وعلى رِحَاب الدِّفءِ قامَتْ أمَّةٌ","تِلْك الفِعَالُ البَاقِياتُ كِتَابُ",63,"ب",1,0],["وعلى رصيف العمر كم من شاعر","متميز ومهندس فنان",64,"ن",1,0],["وعلى رأسِكم من اللصِّ سيفٌ","\"نَفِّذُوا الأمْرَ أو هُو البتارُ\"",65,"ر",1,0],["وعلى رباهُ ترنّح الفجرُ الخَصِي","بُ بطِيبِ أنفاسِ الشَّذا المَوّارْ",66,"ر",1,0],["وعلى راحَتَيْكَ أيْقَظْتَ عُمْرًا","خُذْ مَسرَّاتِهِ وَلي شَجْواكَ",67,"ك",1,0],["وَعَلَى \" رَوِيِّ \" الحَاءِ حَسرَةُ أَضلُعٍ","شَهَقَتْ عَلَى شَفَةِ \" القَرِيضِ \" تَنُوحُ",68,"ح",1,0],["وعلى رفوف الذكريات قصائد","سأهزها فيغرد الصوان",69,"ن",1,0],["وعلى ربوعِ (الوهْطِ) ظلٌ وارفٌ","بالحبِ والعَطفِ الحنُونِ يُشَارُ",70,"ر",1,0],["وعلى رؤوسِ السَّاكِنِيها هُدِّمَت","دُورٌ ودُكَّت أسقُفٌ ومباني",71,"ن",2,0]]}