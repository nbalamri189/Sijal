ى أرضِ البراق","https://www.poetsgate.com/ViewPoem.aspx?id=194416",""],[5285,"لكِ الله يهدي سواء السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=204396",""],[5302,"ملحمة الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=200060",""],[5410,"آهات","https://www.poetsgate.com/ViewPoem.aspx?id=144495",""],[5431,"أتى مسرعا قلبي إليك ليسجدا","https://www.poetsgate.com/ViewPoem.aspx?id=191581",""],[5431,"أيا عيدي وياسكني وأنسي","https://www.poetsgate.com/ViewPoem.aspx?id=190959",""],[5431,"قصيدة لثورة 26_سبتمبر النبيلة","https://www.poetsgate.com/ViewPoem.aspx?id=191307",""],[5431,"يطير إلى الأقصى براقي سأتبعه","https://www.poetsgate.com/ViewPoem.aspx?id=194235",""],[5431,"كأنك حلاجٌ بعشقٍ مذّبحُ","https://www.poetsgate.com/ViewPoem.aspx?id=196835",""],[5472,"أيا قاضي قضاة الأرض طرّا","https://www.poetsgate.com/ViewPoem.aspx?id=200472",""],[5483,"تصدق بوصل إن دمعي سائل","https://www.poetsgate.com/ViewPoem.aspx?id=186113",""],[5519,"عطر الصّباح ...!!","https://www.poetsgate.com/ViewPoem.aspx?id=13095",""],[5561,"أُمُّ الحضارات","https://www.poetsgate.com/ViewPoem.aspx?id=192738",""],[5574,"لقاءٌ بعد فراق السنين!","https://www.poetsgate.com/ViewPoem.aspx?id=206025",""],[5638,"قيدي يحدثني","https://www.poetsgate.com/ViewPoem.aspx?id=198120",""],[5704,"هديل الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=191083",""],[5704,"جفاءٌ .. فصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=191336",""],[5725,"اما تستحي عيناك","https://www.poetsgate.com/ViewPoem.aspx?id=207331",""],[5729,"أيا قلبي الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=203972",""],[5790,"أيا قلب دع عشق الحبيب المبرقع","https://www.poetsgate.com/ViewPoem.aspx?id=111873",""],[5829,"البنت اللعوب","https://www.poetsgate.com/ViewPoem.aspx?id=152563",""],[5956,"أهنىء مملكتي بذكاكم","https://www.poetsgate.com/ViewPoem.aspx?id=194564",""],[5956,"لقاءُ القلوبِ الطيبة","https://www.poetsgate.com/ViewPoem.aspx?id=207912",""],[6048,"وَحَسْبي بِأني عَبَرتُ بُحورًا","https://www.poetsgate.com/ViewPoem.aspx?id=198743",""],[6152,"إلى من أشتكي!؟","https://www.poetsgate.com/ViewPoem.aspx?id=203991",""],[6152,"اسير ذكراك","https://www.poetsgate.com/ViewPoem.aspx?id=204245",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[520,"لكم من ودادي ناصر ليس يخذل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577593",""],[6256,"بنغازي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65923&r=&rc=11",""],[5519,"عطر الصّباح ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69279&r=&rc=12",""],[6346,"لك الله ياغزة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83385&r=&rc=1",""],[5567,"اعتذار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81824&r=&rc=74",""]],"verses":[["أَيا قَبراً تَقَسَّمَ كُلَّ صَبرٍ","وَقَلقَلَ عَبرَةَ المُقَلِ الدَوامي",0,"م",2,0],["أيا قاتَلَ اللهُ الغَوانِي فإنّما","طِلابُ الرّدى وقْفٌ على ربّةِ الوَقْفِ",1,"ف",1,0],["أَيا قَبرُ هَذا الضَيفُ آمالُ أُمَّةٍ","فَكَبِّر وَهَلِّل وَاِلقَ ضَيفَكَ جاثِيا",2,"ي",2,1],["أَيا قَبرُ لَو أَنّا فَقَدناهُ وَحدَهُ","لَكانَ التَأَسّي مِن جَوى الحُزنِ شافِيا",2,"ي",2,0],["أَيا قَلبي أَما تَخشَع","وَيا عِلمي أَما تَنفَع",3,"ع",1,1],["أَيا قَومَنا لاتَنشُبوا الحَربَ بَينَنا","أَيا قَومَنا لاتَقطَعوا اليَدَ بِاليَدِ",4,"د",1,1],["أيا قتيلَ رسول اللَه في رجب","يا أكرم الناس مخبوراً لمختبر",5,"ر",1,0],["أَيا قَلبِ تَعرِفُ مَن قَد أَتا","كَ وَياعَينِ تَدرينَ مَن قَد حَضَر",6,"ر",1,0],["أَيَا قَمَراً تَبَسّمَ عنْ أَقَاحِ","ويا غُصْناً يَميلُ مَعَ الرِّياحِ",7,"ح",1,1],["أَيا قَمَرَ التَمامِ أَعَنتَ ظُلماً","عَلَيَّ تَطاوُلَ اللَيلِ التَمامِ",8,"م",1,0],["أَيا قَمَرَ السَماءِ سَفُلتَ حَتّى","كَأَنَّكَ قَد ضَجِرتَ مِنَ العُلُوِّ",9,"و",1,0],["أَيا قَبرَ لَيلى لَو شَهِدناكَ أَعوَلَت","عَلَيكَ نِساءٌ مِن فَصيحٍ وَمِن عَجَم",10,"م",1,1],["أيا قَومَنا إنّهم أقبَلوا","على الجُرْدِ في المُرْهَفَاتِ البُتُرْ",11,"ر",1,0],["أيا قومنا إنّا نرى العامَ مُجدِباً","وشرُّ عَتادِ الحربِ حَدبُ وإمحال",12,"ل",1,0],["أيَا قَمَراً أمسَى عَنِ العَينِ آفِلاً","وَلَيسَ لَهُ إلاَّ فُؤَادي مَنزِلُ",13,"ل",1,0],["أَيا قَلبُ لا تَكلَف فلَيلى مَزارُها","بَعِيدٌ وَلَيلى ناكِحٌ غَيرُ أَيِّمِ",14,"م",1,0],["أَيا قادِماً مِن سَفرَةِ الهَجرِ مَرحَبا","أَنا ذاكَ ما أَنساكَ ما هَبَّتِ الصَبا",15,"ب",2,1],["أَيا قَيلُ إِنَّ النارَ صالٍ بِحَرِّها","مُقيمُ صَلاةٍ وَالمُهَنَّدُ وارِسُ",16,"س",1,0],["أَيا قاتِلي هَل أَنتَ مُكرِمُ حُفرَتي","فَزائِرُها فيما تُزارُ المَقابِرُ",17,"ر",1,0],["أَيا قَلبَينِ قَد خُلِقا","كَنابِتَتَينِ جُنّابا",18,"ب",2,0],["أيا قلب كم ذبت في حبّها","لحونا مضرّجه بالدما",19,"م",2,0],["أيا قاضِي الهوى ما الحكم فيمن","أباحَ القلبُ فيه عن تراضي",20,"ض",2,1],["أيا قِوامَ الدّين دعوى امرىء","لسانُه ليس بمذَّاقِ",21,"ق",1,0],["أَيا قَمَراً حالَ النَوى دونَ وَجهِهِ","وَأَلقى عَلى جِسمي النَحيلِ سرارَهْ",22,"ر",2,0],["أيا قمرا سما بعلا وفخر","وحاز مهابة وعلو قدر",23,"ر",1,1],["أَيا قُبلَةً مَرَّت عَلى ضَفَّتَي في","كَطَيفِ حَبيبٍ مَرَّ في الحُلمِ وَاِنطَلَق",24,"ق",1,1],["أَيا قَلَمي ما ضَرَّ لَو كُنتَ سِكَّةً","تَطوفُ شَريفاً في الحقولِ النَواضِرِ",25,"ر",1,0],["أَيا قَلَمي ما ضَرَّ لَو كُنتَ سِكَّةً","تخلِّدُ لي بَينَ الجِبالِ مَآثِري",25,"ر",2,0],["أَيا قَلَمي نم في الخُمولِ وَلا تُفِق","وَيا صُحُفي نامي فَقَد نامَ خاطِري",25,"ر",2,0],["أَيا قَمَراً أَمسى لَهُ القَلبُ مَنزِلاً","إِذا مَرَ بي مِن بُرقُعِ الحُسنِ في غِشا",26,"ش",2,0],["أَيا قَمَرَ السَعدي الَّذي دونَ وَصلِهِ","مَضارِبُ بيضٍ مِن أَكُفِّ بَني سَعدِ",27,"د",1,0],["أَيا قَمَراً ما لاحَ إِلّا أَضت لَنا ال","مَغارِبُ مِن أَنوارِهِ وَالمشارقُ",28,"ق",1,0],["أيا قومِ الدخيلُ يتيهُ كبراً","على عربيِّكُم وهو العريق",29,"ق",1,0],["أيا قلبُ الثلاثُ شَهرنَ حرباً","وما لكَ طاقةٌ فاطلب ملاذا",30,"ذ",2,0],["أيا قلبُ مَهلاً لا تُعجِّل بشكواكا","فإني على شكٍّ بصحةِ دعواكا",31,"ك",2,1],["أيا قهوةً في الصبحِ قد عطَّرت فمي","لكِ الخيرُ في إذكاءِ نارِ القريحة",32,"ه",1,0],["أيا قُبَلَ الأحبابِ أنتِ عَزاؤنا","فكلُّ فؤادٍ لم تحلّي بهِ صفر",33,"ر",1,0],["أَيا قَمَرَ الْعُلى بِمَنِ التَّسَلِّي","إِذا لَمْ تَسْتَنِرْ وَمَنِ الْبَدِيلُ",34,"ل",1,0],["أيا قلب إن إلزمتني حب غيرهم","تبرأ سرى من هواك وإعلاني",35,"ي",1,1],["أيا قاتِلي ما لِلّيالي ورَيْبِها","وما للعَوادي تَعْتَدي وتَجور",36,"ر",1,0],["أيا قمراً قد حل في سفح أرضنا","على أنه فوق السماكين نازل",37,"ل",1,0],["أيا قاطعِاً للوَصلِ بَيني وبينَهُ","بِلا عِلَّةٍ مِنَّي عَرَفْتُ ولا سَبَبْ",38,"ب",1,1],["أيا قرّة العيون تاللَه إنَّني","على عهدكُم باقي وفي الوصلِ طامعُ",39,"ع",1,0],["أيُّ اقتبالٍ وإقبالٍ لمملكةٍ","قد عقّباها على يُمنٍ بإيمانِ",40,"ن",1,0],["أَيا قدوة الاسلام هل لك عودة","إلينا ولو في آخر الهدوات",41,"ت",1,0],["أَيا قاطع الحبل الذي إن قطعته","قطعت متينا وهو أصل حبالكا",42,"ك",2,1],["أَيا قُرَّةَ العَينِ الَّتي لَيتَ أَنَّها","لَنا بِجَميعِ الصالِحاتِ بَديلُ",43,"ل",1,0],["أَيا قَلبُ خَلِّ عِنانَ الهَوى","تُفِق مِن خُمارِ عُقارِ الجَوى",44,"ا",1,1],["أَيا قَلبُ خَبِّرني وَلَستَ بِصادِقي","إِذا لَم تُنِل وَاستَأثَرَت كَيفَ تَصنَعُ",45,"ع",1,0],["أيا قلب لا تجزع من البين واصطبر","فلست لما يقضي عليك بدافع",46,"ع",1,1],["أيا قلب هل تنهاك واعظة النهى","وتزجرك الأيام لو كنت تقبل",47,"ل",1,0],["أيا قبرَ إبراهيمَ قد صرتَ مهدَهُ","وصاحبَهُ الباقي إلى آخرِ الدَّهرِ",48,"ر",1,0],["أيا قمراً أَعِدْ عِنْدِي طُلوعاً","وَإِلَّا فاتخِذْ عِنْدي مَغيبا",49,"ب",2,0],["أَيا قادِماً تَخشى النُفوس قُدومه","لَأَنت صَديق في ثِياب غَريم",50,"م",1,1],["أيا قاضية البصر","ة قومي فارقصي خَطْرهْ",51,"ر",2,1],["أَيا قلبي المكسور لِم لم تذب أَسىً","لفقدِ الذي في حَجرهِ لم تَذُق كسرا",52,"ر",2,0],["أَيا قبرَهُ هذا العزيز فلا تَدَع","هَوام البِلَى تَهويِ عليهِ كما تَهوَى",53,"و",2,0],["أيا قوم لا ننسين سدوما","وكيف جزى الله قوما غشوما",54,"م",2,1],["أيا قلبُ ان طاوعتني في سبيلهِ","رُشِدتَ وأُعطيتَ الكرائمَ في الحشرِ",55,"ر",1,0],["أيا قاتلاً قلبي بأوّلِ نظرةٍ","كُفِيتَ فمهلاً لا تُثَنِّ لأجهازِ",56,"ز",1,0],["أَيا قُبحَهُ في النّاسِ مِن رَجلٍ غَدا","يَحوزُ وَيَحوي كُلَّ قدحٍ وَكُلَّ ذمْ",57,"م",1,1],["أيَا قمرَ الإصبَاحِ وَالكوْكَبَ الَّذِي","لِطَلْعَتِهِ تصْبُوا البدور الكوَامِلُ",58,"ل",1,0],["أَيا قُبةَ العَلياء حَل بِك المَجد","وَحَل بِك التوفيق وَاليُمْن وَالسَّعد",59,"د",1,1],["أيا قرة العينين إني لعاشقٌ","جمالك يا نورَ البرايا وخادمُ",60,"م",1,0],["أَيا قَمَراً لهُ في الحَسْنِ فَضْلٌ","على بَدْرِ الدُّجا عِنْدَ البُدوِّ",61,"د",2,1],["أَيا قَدَّ القَضيبِ إِذا تثنَّى","ويا وَجْهَ الهِلالِ إِذا تَبدَّى",62,"د",2,0],["أيا قاضي القضاة جزيت شراً","فإنك لست تدري ما طحاها",63,"ا",3,1],["أيا قاري حرف التهجي وكاتبا","رقوم العلى سر البداية في الختم",64,"م",1,0],["أيا قدحاً قد صدعَ الدهرُ شملَهُ","فأصبحَ بعد الراحِ قد جاورَ التُّربا",65,"ب",2,1],["أيا قمراً صحيفةُ وجنتيهِ","بها قَلَمُ الملاحةِ خطَّ سَطرا",66,"ر",2,1],["أَيا قَطرِيُّ بنُ الفُجاةِ أَما لَنا","مِنَ النَصفِ شَيىءٌ غَيرُ فِعلِ الجَبابِرِ",67,"ر",1,1],["أيا قاصدي ارض الحجاز تحملوا","تحية صب طال بالإلفِ عهده",68,"د",2,0],["أَيا قَوسَ خَرّاطٍ يُشيرُ وَلا يَرمي","وَيا سَيفَ رِعديدٍ يَرُضُّ وَلا يُدمي",69,"ي",1,1],["أَيا قارِئَ القرآنِ أَحسِن أَداءَهُ","يُضاعِف لكَ اللَهُ الجزيلَ من الأَجرِ",70,"ر",1,0],["أيا قفص الطير أينَ الهزارُ","وياحافظ الشدو أين النغم",71,"م",1,1],["أيا قاضياً قد دنت كُتُبه","وان اصبحت داره شاحطه",72,"ه",1,1],["أيا قمر القبيلة من لصبٍ","اسير الحب اصبح في وثاق",73,"ق",1,0],["أيا قبرَ ابراهيمَ حُيِّيتَ حُفرةً","ولا زِلتَ تُسقَى الغيثَ من سُبُل القَطرِ",74,"ر",1,0],["أيا قمراً يميسُ به قضيبٌ","إذا ما ماس ماج به كثيبُ",75,"ب",1,0],["أيا قابساً خُذْ من فؤادي جَذْوةً","ويا وارداً رِدْ مِنْ دُموعيَ مَنْهَلاً",76,"ل",2,0],["أيا قاتل الأسد يوم الوغى","ويا مخجل الغيث مهما همل",77,"ل",1,0],["أيا قُرّةَ العينِ اعتباراً وَحَسْرَةً","أَجِدَّكِ قد أصبحتِ قاصمةَ الظهر",78,"ر",1,0],["أيا قلبي سلمت من انصداع","أراك من القلوب القاسيات",79,"ت",1,0],["أيا قمر الحق حتى متى","فشمل التصبر قد شتتا",80,"ت",2,1],["أَيا قَلبُ كَم لا تَستَفيقُ مِنَ الجَوى","وَكَم أَنتَ ما يَخلو غَرامُكَ ما يَخلو",81,"ل",2,0],["أَيا قُرَّةَ العَينَينِ مالِىَ غَيرُكُم","فَعَينَاىَ مشن سَلوَاكَ لَم تَطرُقِ الكَرَا",82,"ر",2,0],["أيا قمراً غدا في فيه ريّ","أيجملُ أن أعودَ بغيرِ رِيِّ",83,"ي",1,0],["أيا قبره في كل يوم وليلةٍ","عليك إله العرش صلى وسلما",84,"م",2,0],["أَيا قَلق الوِشاح ولي وَساد","لبعدك مِثلَما قَلق الوِشاح",85,"ح",1,0],["أَيا قاطعة الجَوِّ