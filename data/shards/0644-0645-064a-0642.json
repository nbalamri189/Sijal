409,"حدثينا يا فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=155283",""],[5409,"نكص الخصم عنك نكص الطريد","https://www.poetsgate.com/ViewPoem.aspx?id=155265",""],[5574,"مَنْ يُخبِرُ الحوتَ؟","https://www.poetsgate.com/ViewPoem.aspx?id=205715",""],[5616,"تعليق هامشي على هامش أحداث هامشية!","https://www.poetsgate.com/ViewPoem.aspx?id=205035",""],[5691,"ضياغم بيْتا","https://www.poetsgate.com/ViewPoem.aspx?id=206209",""],[5691,"لسان حال الرئيس","https://www.poetsgate.com/ViewPoem.aspx?id=207076",""],[5691,"قالها شافيز...!","https://www.poetsgate.com/ViewPoem.aspx?id=207080",""],[5717,"ومن شرائط النبي حمله","https://www.poetsgate.com/ViewPoem.aspx?id=170604",""],[5725,"الى الشهيد مصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=211703",""],[5952,"ولّاعتان","https://www.poetsgate.com/ViewPoem.aspx?id=210376",""],[5956,"في سجن الذين أحبهم","https://www.poetsgate.com/ViewPoem.aspx?id=183599",""],[5956,"لِمَ يقصد الدخلاء دوماً بحرنا؟","https://www.poetsgate.com/ViewPoem.aspx?id=192186",""],[6070,"مِنْ فَرحةِ المَاءِ سارَ الغَيمُ وانتَشَرا","https://www.poetsgate.com/ViewPoem.aspx?id=192068",""],[6089,"بلاء العاشقين","https://www.poetsgate.com/ViewPoem.aspx?id=212926",""],[6093,"رقص قافلة","https://www.poetsgate.com/ViewPoem.aspx?id=206748",""],[6225,"محِبٌّ . . وليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80919&r=&rc=188",""],[6308,"كفي ولونُ الجدائل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87725&r=&rc=3",""],[4222,"كن عاذري في حبهم لا عاذلي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52871&r=&rc=163",""]],"verses":[["لَم يَقضِ حَقَّ المالِ إِلّا مَعشَرٌ","وَجَدوا الزَمانَ يَعيثُ فيهِ فَعاثوا",0,"ث",3,0],["لَم يَقُلها حَتّى اِنثَنَيتُ لِما بي","أَتَلَقّى دَمعي بِفَضلِ رِدائي",1,"ي",1,0],["لَم يَقِف في البَرِّ إِلّا رَيثَما","يُسلِمُ الأَرواحَ أَو يُلقي الزِماما",2,"م",2,0],["لَم يَقولوا مَنِ الفَتاةُ وَلَكِن","سَأَلوني هُناكَ عَن آلامي",3,"م",2,0],["لَم يَقِف دونَهُم وَلَو كانَ يَلقى","رُتبَةً مِن وَرائِهِم لَتَعَدّى",4,"د",2,0],["لَمْ يُقَارِفْ فِعْلاً يَشِينُ وَلَمْ","يَأْتِ مِنَ الأَمْرِ مَا يَعَافُ الحَكِيمُ",5,"م",1,0],["لم يقض بعض حداده لنصيره","حتى أحدّ أسىً لفقد مجيره",6,"ر",2,0],["لَم يَقتَعِدها المُعَجِّلونَ ولم","يَمسَح مَطَاها الوُسُوقُ والقَتَبُ",7,"ب",1,0],["لم يقيسوا الحيا بجدواه لكن","بشروه من الحيا بغلامهْ",8,"م",2,0],["لم يُقَصِّرْ به اعتيادٌ ولم يق","عد بِه مولدٌ عن استعلاءِ",9,"ا",2,0],["لم يُقلدكَ شاعرٌ جوهرَ الفخْ","رِ ولا صاغ مادحوك فريدَكْ",10,"ك",1,0],["لم يُقدس منك شيءٌ","ولك الجَدُّ المقدس",11,"س",1,0],["لم يَقُل مثلها النوابغُ قِدماً","لا ولا كان مِثلها للأعاشي",12,"ش",2,0],["لم يقله إلا موطِّنُ نفس","أنه عند بثه مصفوع",13,"ع",1,0],["لَم يَقِس شَعبٌ إِلى أَمجادِها","مَجدَهُ الباذِخَ إِلّا اِستَصغَرَه",14,"ر",2,0],["لَم يَقصُرِ الرُمحُ عَن إِدراكِ مُهجَتِهِ","لَكِن حِمى صَدرَهُ وَقعَ الظُبى الكَفَلُ",15,"ل",1,0],["لَم يَقضِ زَيدُكُم مِن وَصلِكُم وَطَرَه","وَلا قَضى لَيلُهُ مِن قُربِكُم سَحَرَه",16,"ر",2,1],["لَم يَقُم صُفرُهُم عَشِيَّةَ زارَت","هُ جِبالٌ يُضيءُ فيها الحَديدُ",17,"د",1,0],["لم يقتسِم في العاشقين أسىً","إلاّ وقِسمي منه أوفرُه",18,"ر",2,0],["لَم يَقلَقِ المَرءُ عَن رُشدٍ فَيَترُكُهُ","إِلّا دَعاهُ إِلى ما يَكرَهُ القَلَقُ",19,"ق",1,0],["لَم يَقضِ مِن وَصلِكُم لُبانَتَهُ","وَإِن قَضى في هَواكُمُ زَمَنَه",20,"ن",2,0],["لَم يَقُم سَيفُ حارِثٍ بِقِتالٍ","أَسلَمَ الوالِداتِ في الأَثقالِ",21,"ل",1,0],["لَم يُقرَ هَذا السَيفُ هَذا الصَبرَ في","هَيجاءَ إِلّا عَزَّ هَذا الدينُ",22,"ن",1,0],["لَم يَقرِني بِشرَ البَخيلِ يُغيرُ في","أَمَلي وَلَم يَشمَخ بِأَنفِ المُفضِلِ",23,"ل",1,0],["لَم يُقارِب جَمالَها حُسنُ شَيءٍ","غَيرُ شَمسِ الضُحى عَلَيها النَهارُ",24,"ر",1,0],["لَم يَقضِ ذو الشَجوِ مِمَّن شَفَّهُ أَرَبا","وَقَد تَمادى بِهِ زَيغُ الهَوى حِقَبا",25,"ب",2,1],["لم يقضِ حاجَتَه ولم يظفرْ بها","في النّاس إلا القائل الفعّالُ",26,"ل",1,0],["لَم يَقضِ مِن حاجَةِ الصِبا أَرَبا","وَقَد شَآكَ الشَبابُ إِذ ذَهَبا",27,"ب",2,1],["لَم يَقرِنا مُذ بَعُدَت دارُنا","مِنهُ سَلامُ اللَهِ عَن مَعرِفَه",28,"ه",1,0],["لم يَقُلْ رُدَّهَا عليَّ ولا يَطْ","فَقُ مَسْحاً بالسُّوقِ والأعْنَاق",29,"ق",1,0],["لَم يُقاسِ الناسُ داءً","كَالهَوى يُبلي وَيَبقى",30,"ق",2,0],["لَم يَقُل أَفعَلُ إِلّا","أَتبَعَ القَولَ الفِعالا",31,"ل",2,0],["لَم يَقدُرِ اللَهُ تَهذيباً لِعالَمِنا","فَلا تَرومَنَّ لِلأَقوامِ تَهذيبا",32,"ب",2,1],["لَم يَقدِروا أَن يُلاقوهُ بِسَيِّئَةٍ","مِنَ الكَلامِ فَلَمّا غابَ عابوهُ",33,"ب",3,0],["لَم يُقنِعِ الحَيَّ مِنها ما تَقَنَّصَهُ","حَتّى أَجازَ أُناسٌ أَكلَ طافيها",34,"ي",3,0],["لَم يُقَايِظني عَلى كاظِمَةٍ","سَمَكُ البَحرِ وحَولِيُّ الدَقَل",35,"ل",1,0],["لم يقرض الشعر يوماً في حقيقته","إِلّا الألى نظموه مثلما شعروا",36,"ر",3,0],["لَم يُقَيِّل حَرَّ الَمقيظِ ولَم يُل","جَمِ لِطَوفٍ ولا فَسَاد نزِاقِ",37,"ق",1,0],["لَمْ يَقِفْ طِبُّهُ عَلَى المَلِكِ الأَفْ","ضَلِ وَالأَرْفَعِينَ فِي الطَّبَقَاتِ",38,"ت",1,0],["لَمْ يُقَمْ مِثْلُهُ بِمِصْرٍ وَمَا ظُنَّ","إِلَى أَنْ أَتِيْحَ عَهْدُ فُؤَاد",39,"د",1,0],["لم يقوَ أن يتكلّم","من همَ ثمّ تلَعثَم",40,"م",1,1],["لَم يَقضِ مُنيَتَهُ وَعيشي بَعدَهُ","إِلّا لِتوثِقني الذُنوب وَيَخلُصا",41,"ص",2,0],["لَم يَقضِ حَتّى بَكَت سَماءٌ","لِعَهدِها بِالبُكاءِ طولُ",42,"ل",1,0],["لم يَقِفْ نادِماً يُقَلِّبُ كَفَّيْهِ","فَعالَ الْمُجَوَّفِ الْحَيْرانِ",43,"ن",1,0],["لم يقبلوها قيصريةَ قيصر","لا نافذًا فيها، ولا منقودا",44,"د",2,0],["لم يقتنصنْ جاهاً ولاسامَ النُهى","ذُلاً ، ولا اتخذَ الحريرَ وسائدا",45,"د",2,0],["لمْ يَقُمْ صُفرُهمْ عَشيّةَ زَارَتْ","هُ بجالٌ يُضِيءُ فيها الحَديدُ",46,"د",1,0],["لم يقس شعب إلى أمجادها","مجده الباذج إلاّ استصغره",47,"ر",2,0],["لم يقبل الله إلاّ في محبّتكم","يا آل فاطم إسلاما وأيمانا",48,"ن",2,0],["لم يقصد الرحمن صادق أوبة","رغبا ورهبا في مقام فانخسر",49,"ر",1,0],["لم يقضِ حق العلم مَن","أهوى إلى ترك العملْ",50,"ل",1,0],["لَم يَقبلِ العارَ في ضَيمِ النَزيلِ وَلَم","يَقنَع بِنَقصٍ وَلا يَحتَجُّ بِالعِلَلِ",51,"ل",1,0],["لَم يقضِ قطّ قضيّةً","إلّا لَها الرحمنُ أمضى",52,"ض",2,0],["لم يقض منها لعمري زيدها وطرا","لعل منك عسى يقضى بها وطري",53,"ر",2,0],["لم يقتنوا غير كميت ولا","اكفهم تحمل الحسام",54,"م",1,0],["لم يقض يوما بغير حب","ولا صراع مع الهيام",55,"م",1,0],["لم يقبل اللوم في غرام","ولا لدار الهوى يثوب",56,"ب",1,0],["لم يقلها : لفظة ، لو قالها","لقي النعماء منهم والولاء !",57,"ا",2,0],["لمْ يُقدّرْ صَفْوَ ودّي","حيث بالبَخْس اشتراني",58,"ن",2,0],["لم يقطفِ الثَّمرَ المحرَّمَ آكلاً","منهُ ليَستَحلي بهِ العصيانا",59,"ن",2,0],["لم يقف دونه الشباب ولم يعصم","من الموت عزةُ السلطان",60,"ن",1,0],["لَم يقض حقّك مَن في أصغريه يرى","مَأوىً بِذكرك يوماً غير معمورِ",61,"ر",1,0],["لم يقف عند دارس من طولٍ","أو يشبّب بالأعظم النخرات",62,"ت",1,0],["لم يقيما في الأرض إلا قليلاً","إذ أقاما على نوىً واغتراب",63,"ب",1,0],["لَمْ يَقُمْ في السَّوادِ مِنها خَطِيبٌ","يُذْكِرُ النَّاسَ جَنَّةً أَو نارا",64,"ر",2,0],["لَم يقنع المَجد أَن سمّاه بَدرَ هُدىً","بَل قال بدران تَكريماً لَهُ وَثنا",65,"ن",2,0],["لم يَقِسْكَ اللّبيبُ بالبَدْرِ نُوراً","مَن رأَى دُرّةً تُقاسُ بوَدْعَه",66,"ع",2,0],["لم يقم لي مثل ما أعهده","لعناقي بل رآني واكفهر",67,"ر",1,0],["لَم يَقتَنِع بِالمَجدِ عَن آبائِهِ","وَهُمُ فَما اقتَنَعوا بِمَجدِ جُدودِهِ",68,"د",2,0],["لم يقنع البين في شملي بما فعل ال","ممات فيه فقد شاء الذي شاءا",69,"ا",2,1],["لم يقلها فرد ولا الجيش والشعب","ولكن كل الذي عد مصرا",70,"ر",2,0],["لم يقبلوا نصحَ أنفِ الكلبِ فانقلبوا","بيومِ شرٍّ ثناياه الأعاصيرُ",71,"ر",1,0],["لم يقم نشرها النفاد عليها","سرُّ عهد الهوى قديمٌ باقي",72,"ق",2,0],["لم يقضِ زيدُ هوانا في الرُّبا وطَراً","ولم ينلْ من أُهَيْلِ المُنْحَنى أَرَبَا",73,"ب",2,0],["لم يَقتُلوهُ على اليقينِ وإنّما","عرضَتْ لهُم شُبَهُ اليهودِ تصوُّرا",74,"ر",2,0],["لم يقبل الجانب القبلي أوجههم","فرد أولهم بدءاً على العقب",75,"ب",1,0],["لم يقنع الدهر أن الشعر لي سمة","أعدها من سمات النقص والعار",76,"ر",1,0],["لَم يَقنَعوا في مَغْرَمٍ","سيقوا إِلَيهِ باللّقاء",77,"ا",2,0],["لم يقل فاستدل أو فتعلق","بدليل لأنه تحديد",78,"د",1,0],["لم يقدروا أن يخرجوا منه وهم","عدد كثير عن ألوف زائد",79,"د",1,0],["لم يقبل الأمر ولم يبايع","والقول في ذلك عنه شائع",80,"ع",1,0],["لم يُقْبل العذَّال لمّا أَقْبلُوا","لكِنَّهم ولَّوْا على أَدْبَارِهم",81,"م",1,0],["لم يَقوَ مِنهنّ إقْواءٌ لِقَافِيَةٍ","وَلَمْ يَطأْهُنّ في التَّرْتيبِ إيْطاءُ