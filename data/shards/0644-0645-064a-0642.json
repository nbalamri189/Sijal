{"poems":[[53,"يا آمن الأقدار بادر صرفها","https://www.aldiwan.net/poem30664.html","الطويل"],[53,"حي بين النقا وبين المصلى","https://www.aldiwan.net/poem30776.html","الخفيف"],[86,"طمع ألقى عن الغرب اللثاما","https://www.aldiwan.net/poem10683.html","الرمل"],[86,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[71,"خبروها بأنه ما تصدى","https://www.aldiwan.net/poem4014.html","الخفيف"],[93,"إن بكى الشرق فالمصاب أليم","https://www.aldiwan.net/poem11409.html","الخفيف"],[88,"الشعر بعد مصابه بكبيره","https://www.aldiwan.net/poem45040.html","الطويل"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[72,"رب عيش نصبت كأس مدامه","https://www.aldiwan.net/poem19674.html","الخفيف"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[51,"يرجف القرد بأني","https://www.aldiwan.net/poem64612.html","مجزوء الرمل"],[51,"هجرتني ظلما لتحميل واش","https://www.aldiwan.net/poem64929.html","الخفيف"],[51,"يا ابن شهر الصيام أنت رقيع","https://www.aldiwan.net/poem65424.html","الخفيف"],[91,"خير ما يكتبه ذو مرقم","https://www.aldiwan.net/poem8865.html","عموديه"],[91,"أعد حديثك عندي أيها الرجل","https://www.aldiwan.net/poem9053.html","عموديه"],[70,"لم يقض زيدكم من وصلكم وطره","https://www.aldiwan.net/poem42926.html","البسيط"],[45,"نفست قربها علينا كنود","https://www.aldiwan.net/poem62739.html","الخفيف"],[61,"غضبان ينساني وأذكره","https://www.aldiwan.net/poem51669.html","أحذ الكامل"],[49,"الرفق يبلغ ما لا يبلغ الخرق","https://www.aldiwan.net/poem62187.html","الكامل"],[66,"لا راجع الطرف باللقا وسنه","https://www.aldiwan.net/poem40971.html","المنسرح"],[44,"بذ الجلاد فهو دفين","https://www.aldiwan.net/poem30335.html","الرجز"],[44,"ليس الوقوف بكفء شوقك فانزل","https://www.aldiwan.net/poem30386.html","الكامل"],[31,"أبهجر يودع الأجوار أم","https://www.aldiwan.net/poem42534.html","الخفيف"],[31,"لم يقض ذو الشجو ممن شفه أربا","https://www.aldiwan.net/poem42634.html","البسيط"],[105,"لا اليوم يومك إذ ولدت ولا الغد","https://www.aldiwan.net/poem41933.html","الكامل"],[17,"لم يقض من حاجة الصبا أربا","https://www.aldiwan.net/poem1189.html",""],[52,"خل لنا دمنا على وصله","https://www.aldiwan.net/poem26834.html","السريع"],[75,"قمن في مأتم على العشاق","https://www.aldiwan.net/poem69059.html","الخفيف"],[48,"عجبا لي كيف أبقى","https://www.aldiwan.net/poem64457.html","مجزوء الرمل"],[48,"هل عرفت الربع أجلى","https://www.aldiwan.net/poem65035.html","مجزوء الرمل"],[46,"لم يقدر الله تهذيبا لعالمنا","https://www.aldiwan.net/poem22131.html","البسيط"],[46,"قد ينصف القوم في الأشياء سيدهم","https://www.aldiwan.net/poem23559.html","البسيط"],[46,"إني لمن آل حواء الذين هم","https://www.aldiwan.net/poem23575.html","البسيط"],[8,"لمن الدار كأنضاء الخلل","https://www.aldiwan.net/poem21814.html","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85775","البسيط"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21072","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54737","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142051","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43762","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43846","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[90,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[45,"نَفّسَتْ قُرْبَها عَلَيناَ كَنُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=32955",""],[91,"الشاعر والأمة","https://www.poetsgate.com/ViewPoem.aspx?id=53088",""],[94,"يا وحشة الثأر","https://www.poetsgate.com/ViewPoem.aspx?id=12821",""],[18,"هَلْ عَرَفْتَ الْغَدَاة َ مِنْ أَطْلاَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26460&r=&rc=26",""],[136,"ما دمت حيا فاعتلق","https://www.aldiwan.net/poem48918.html","مجزوء الكامل"],[170,"يا ساهر الطرف من خوف ومن وجل","https://www.aldiwan.net/poem1652.html",""],[190,"قل لي متى العذراء ترضى","https://www.aldiwan.net/poem35159.html","مجزوء الكامل"],[211,"يا ظبية البان يا غصن النقا النضر","https://www.aldiwan.net/poem13316.html","البسيط"],[211,"قد غرد الطير فقم يا غلام","https://www.aldiwan.net/poem13388.html","السريع"],[212,"هوى جديد أشد فتكا","https://www.aldiwan.net/poem46241.html","مخلع البسيط"],[212,"يا قلب هذا هوى جديد","https://www.aldiwan.net/poem46563.html","مخلع البسيط"],[227,"البطل","https://www.aldiwan.net/poem24226.html","عموديه"],[255,"ظالم يامن قلاني","https://www.aldiwan.net/poem36221.html","مجزوء الرمل"],[271,"حواء أمك حبها أشقانا","https://www.aldiwan.net/poem35584.html","الكامل"],[291,"ما لقصر الزهور أضحى كئيبا","https://www.aldiwan.net/poem11707.html","الخفيف"],[306,"خطب له الدين أرنى لحظ مذعور","https://www.aldiwan.net/poem56539.html","البسيط"],[329,"لا أنا خالد ولا أمنياتي","https://www.aldiwan.net/poem54952.html","الخفيف"],[329,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[349,"أي عيد مضى ومملوكك الو","https://www.aldiwan.net/poem20252.html","الخفيف"],[354,"أدي الرسالة يا ريح الحجاز لنا","https://www.aldiwan.net/poem39770.html","البسيط"],[365,"زد علوا في كل يوم ورفعه","https://www.aldiwan.net/poem60844.html","الخفيف"],[404,"آه من برق إليكم قد روى","https://www.aldiwan.net/poem33915.html","الرمل"],[407,"أتروم تغطية الهوى بجحوده","https://www.aldiwan.net/poem50187.html","الكامل"],[449,"لم يقنع البين في شملي بما فعل","https://www.aldiwan.net/poem53765.html","البسيط"],[454,"الجلاء الجلاء رددت الأصداء","https://www.aldiwan.net/poem61259.html","الخفيف"],[459,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[501,"مر بالكاسر طافحا يا ساقي","https://www.aldiwan.net/poem37675.html","الخفيف"],[501,"من خلف مسدل ستر الغيب لاح لنا","https://www.aldiwan.net/poem38084.html","البسيط"],[515,"هل المحرم فاستهل مكبرا","https://www.aldiwan.net/poem20838.html","الكامل"],[516,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[516,"لو اطلعت على سري وإضماري","https://www.aldiwan.net/poem12126.html","البسيط"],[552,"ما نحن إلا للفناء","https://www.aldiwan.net/poem48110.html","مجزوء الكامل"],[559,"إنما الدين كله تقليد","https://www.aldiwan.net/poem34595.html","الخفيف"],[559,"إن النصارى واليهود كلاهما","https://www.aldiwan.net/poem34613.html","الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"رحلوا فلست مسائلاً عن دارهم","https://www.aldiwan.net/poem2861.html","الكامل"],[587,"يا راقد الطرف ما للطرف إغفاء","https://www.aldiwan.net/poem17396.html","البسيط"]],"verses":[["لَم يَقضِ حَقَّ المالِ إِلّا مَعشَرٌ","وَجَدوا الزَمانَ يَعيثُ فيهِ فَعاثوا",0,"ث",3,0],["لَم يَقُلها حَتّى اِنثَنَيتُ لِما بي","أَتَلَقّى دَمعي بِفَضلِ رِدائي",1,"ي",1,0],["لَم يَقِف في البَرِّ إِلّا رَيثَما","يُسلِمُ الأَرواحَ أَو يُلقي الزِماما",2,"م",2,0],["لَم يَقولوا مَنِ الفَتاةُ وَلَكِن","سَأَلوني هُناكَ عَن آلامي",3,"م",2,0],["لَم يَقِف دونَهُم وَلَو كانَ يَلقى","رُتبَةً مِن وَرائِهِم لَتَعَدّى",4,"د",2,0],["لَمْ يُقَارِفْ فِعْلاً يَشِينُ وَلَمْ","يَأْتِ مِنَ الأَمْرِ مَا يَعَافُ الحَكِيمُ",5,"م",1,0],["لم يقض بعض حداده لنصيره","حتى أحدّ أسىً لفقد مجيره",6,"ر",2,0],["لَم يَقتَعِدها المُعَجِّلونَ ولم","يَمسَح مَطَاها الوُسُوقُ والقَتَبُ",7,"ب",1,0],["لم يقيسوا الحيا بجدواه لكن","بشروه من الحيا بغلامهْ",8,"م",2,0],["لم يُقَصِّرْ به اعتيادٌ ولم يق","عد بِه مولدٌ عن استعلاءِ",9,"ا",2,0],["لم يُقلدكَ شاعرٌ جوهرَ الفخْ","رِ ولا صاغ مادحوك فريدَكْ",10,"ك",1,0],["لم يُقدس منك شيءٌ","ولك الجَدُّ المقدس",11,"س",1,0],["لم يَقُل مثلها النوابغُ قِدماً","لا ولا كان مِثلها للأعاشي",12,"ش",2,0],["لم يقله إلا موطِّنُ نفس","أنه عند بثه مصفوع",13,"ع",1,0],["لَم يَقِس شَعبٌ إِلى أَمجادِها","مَجدَهُ الباذِخَ إِلّا اِستَصغَرَه",14,"ر",2,0],["لَم يَقصُرِ الرُمحُ عَن إِدراكِ مُهجَتِهِ","لَكِن حِمى صَدرَهُ وَقعَ الظُبى الكَفَلُ",15,"ل",1,0],["لَم يَقضِ زَيدُكُم مِن وَصلِكُم وَطَرَه","وَلا قَضى لَيلُهُ مِن قُربِكُم سَحَرَه",16,"ر",2,1],["لَم يَقُم صُفرُهُم عَشِيَّةَ زارَت","هُ جِبالٌ يُضيءُ فيها الحَديدُ",17,"د",1,0],["لم يقتسِم في العاشقين أسىً","إلاّ وقِسمي منه أوفرُه",18,"ر",2,0],["لَم يَقلَقِ المَرءُ عَن رُشدٍ فَيَترُكُهُ","إِلّا دَعاهُ إِلى ما يَكرَهُ القَلَقُ",19,"ق",1,0],["لَم يَقضِ مِن وَصلِكُم لُبانَتَهُ","وَإِن قَضى في هَواكُمُ زَمَنَه",20,"ن",2,0],["لَم يُقرَ هَذا السَيفُ هَذا الصَبرَ في","هَيجاءَ إِلّا عَزَّ هَذا الدينُ",21,"ن",1,0],["لَم يَقرِني بِشرَ البَخيلِ يُغيرُ في","أَمَلي وَلَم يَشمَخ بِأَنفِ المُفضِلِ",22,"ل",1,0],["لَم يُقارِب جَمالَها حُسنُ شَيءٍ","غَيرُ شَمسِ الضُحى عَلَيها النَهارُ",23,"ر",1,0],["لَم يَقضِ ذو الشَجوِ مِمَّن شَفَّهُ أَرَبا","وَقَد تَمادى بِهِ زَيغُ الهَوى حِقَبا",24,"ب",2,1],["لم يقضِ حاجَتَه ولم يظفرْ بها","في النّاس إلا القائل الفعّالُ",25,"ل",1,0],["لَم يَقضِ مِن حاجَةِ الصِبا أَرَبا","وَقَد شَآكَ الشَبابُ إِذ ذَهَبا",26,"ب",2,1],["لَم يَقرِنا مُذ بَعُدَت دارُنا","مِنهُ سَلامُ اللَهِ عَن مَعرِفَه",27,"ه",1,0],["لم يَقُلْ رُدَّهَا عليَّ ولا يَطْ","فَقُ مَسْحاً بالسُّوقِ والأعْنَاق",28,"ق",1,0],["لَم يُقاسِ الناسُ داءً","كَالهَوى يُبلي وَيَبقى",29,"ق",2,0],["لَم يَقُل أَفعَلُ إِلّا","أَتبَعَ القَولَ الفِعالا",30,"ل",2,0],["لَم يَقدُرِ اللَهُ تَهذيباً لِعالَمِنا","فَلا تَرومَنَّ لِلأَقوامِ تَهذيبا",31,"ب",2,1],["لَم يَقدِروا أَن يُلاقوهُ بِسَيِّئَةٍ","مِنَ الكَلامِ فَلَمّا غابَ عابوهُ",32,"ب",3,0],["لَم يُقنِعِ الحَيَّ مِنها ما تَقَنَّصَهُ","حَتّى أَجازَ أُناسٌ أَكلَ طافيها",33,"ي",3,0],["لَم يُقَايِظني عَلى كاظِمَةٍ","سَمَكُ البَحرِ وحَولِيُّ الدَقَل",34,"ل",1,0],["لم يقرض الشعر يوماً في حقيقته","إِلّا الألى نظموه مثلما شعروا",35,"ر",3,0],["لَم يُقَيِّل حَرَّ الَمقيظِ ولَم يُل","جَمِ لِطَوفٍ ولا فَسَاد نزِاقِ",36,"ق",1,0],["لَمْ يَقِفْ طِبُّهُ عَلَى المَلِكِ الأَفْ","ضَلِ وَالأَرْفَعِينَ فِي الطَّبَقَاتِ",37,"ت",1,0],["لَمْ يُقَمْ مِثْلُهُ بِمِصْرٍ وَمَا ظُنَّ","إِلَى أَنْ أَتِيْحَ عَهْدُ فُؤَاد",38,"د",1,0],["لم يقوَ أن يتكلّم","من همَ ثمّ تلَعثَم",39,"م",1,1],["لَم يَقضِ مُنيَتَهُ وَعيشي بَعدَهُ","إِلّا لِتوثِقني الذُنوب وَيَخلُصا",40,"ص",2,0],["لَم يَقضِ حَتّى بَكَت سَماءٌ","لِعَهدِها بِالبُكاءِ طولُ",41,"ل",1,0],["لم يَقِفْ نادِماً يُقَلِّبُ كَفَّيْهِ","فَعالَ الْمُجَوَّفِ الْحَيْرانِ",42,"ن",1,0],["لم يقبلوها قيصريةَ قيصر","لا نافذًا فيها، ولا منقودا",43,"د",2,0],["لم يقتنصنْ جاهاً ولاسامَ النُهى","ذُلاً ، ولا اتخذَ الحريرَ وسائدا",44,"د",2,0],["لمْ يَقُمْ صُفرُهمْ عَشيّةَ زَارَتْ","هُ بجالٌ يُضِيءُ فيها الحَديدُ",45,"د",1,0],["لم يقس شعب إلى أمجادها","مجده الباذج إلاّ استصغره",46,"ر",2,0],["لم يقبل الله إلاّ في محبّتكم","يا آل فاطم إسلاما وأيمانا",47,"ن",2,0],["لمْ يقمْ سيفُ حارثٍ بقتالٍ","أسلمَ الوالداتِ في الأثقالِ",48,"ل",1,0],["لم يقضِ حق العلم مَن","أهوى إلى ترك العملْ",49,"ل",1,0],["لَم يَقبلِ العارَ في ضَيمِ النَزيلِ وَلَم","يَقنَع بِنَقصٍ وَلا يَحتَجُّ بِالعِلَلِ",50,"ل",1,0],["لَم يقضِ قطّ قضيّةً","إلّا لَها الرحمنُ أمضى",51,"ض",2,0],["لم يقض منها لعمري زيدها وطرا","لعل منك عسى يقضى بها وطري",52,"ر",2,0],["لم يقتنوا غير كميت ولا","اكفهم تحمل الحسام",53,"م",1,0],["لم يقض يوما بغير حب","ولا صراع مع الهيام",54,"م",1,0],["لم يقبل اللوم في غرام","ولا لدار الهوى يثوب",55,"ب",1,0],["لم يقلها : لفظة ، لو قالها","لقي النعماء منهم والولاء !",56,"ا",2,0],["لمْ يُقدّرْ صَفْوَ ودّي","حيث بالبَخْس اشتراني",57,"ن",2,0],["لم يقطفِ الثَّمرَ المحرَّمَ آكلاً","منهُ ليَستَحلي بهِ العصيانا",58,"ن",2,0],["لم يقف دونه الشباب ولم يعصم","من الموت عزةُ السلطان",59,"ن",1,0],["لَم يقض حقّك مَن في أصغريه يرى","مَأوىً بِذكرك يوماً غير معمورِ",60,"ر",1,0],["لم يقف عند دارس من طولٍ","أو يشبّب بالأعظم النخرات",61,"ت",1,0],["لم يقيما في الأرض إلا قليلاً","إذ أقاما على نوىً واغتراب",62,"ب",1,0],["لَمْ يَقُمْ في السَّوادِ مِنها خَطِيبٌ","يُذْكِرُ النَّاسَ جَنَّةً أَو نارا",63,"ر",2,0],["لَم يقنع المَجد أَن سمّاه بَدرَ هُدىً","بَل قال بدران تَكريماً لَهُ وَثنا",64,"ن",2,0],["لم يَقِسْكَ اللّبيبُ بالبَدْرِ نُوراً","مَن رأَى دُرّةً تُقاسُ بوَدْعَه",65,"ع",2,0],["لم يقم لي مثل ما أعهده","لعناقي بل رآني واكفهر",66,"ر",1,0],["لَم يَقتَنِع بِالمَجدِ عَن آبائِهِ","وَهُمُ فَما اقتَنَعوا بِمَجدِ جُدودِهِ",67,"د",2,0],["لم يقنع البين في شملي بما فعل ال","ممات فيه فقد شاء الذي شاءا",68,"ا",2,1],["لم يقلها فرد ولا الجيش والشعب","ولكن كل الذي عد مصرا",69,"ر",2,0],["لم يقبلوا نصحَ أنفِ الكلبِ فانقلبوا","بيومِ شرٍّ ثناياه الأعاصيرُ",70,"ر",1,0],["لم يقم نشرها النفاد عليها","سرُّ عهد الهوى قديمٌ باقي",71,"ق",2,0],["لم يقضِ زيدُ هوانا في الرُّبا وطَراً","ولم ينلْ من أُهَيْلِ المُنْحَنى أَرَبَا",72,"ب",2,0],["لم يَقتُلوهُ على اليقينِ وإنّما","عرضَتْ لهُم شُبَهُ اليهودِ تصوُّرا",73,"ر",2,0],["لم يقبل الجانب القبلي أوجههم","فرد أولهم بدءاً على العقب",74,"ب",1,0],["لم يقنع الدهر أن الشعر لي سمة","أعدها من سمات النقص والعار",75,"ر",1,0],["لَم يَقنَعوا في مَغْرَمٍ","سيقوا إِلَيهِ باللّقاء",76,"ا",2,0],["لم يقل فاستدل أو فتعلق","بدليل لأنه تحديد",77,"د",1,0],["لم يقدروا أن يخرجوا منه وهم","عدد كثير عن ألوف زائد",78,"د",1,0],["لم يقبل الأمر ولم يبايع","والقول في ذلك عنه شائع",79,"ع",1,0],["لم يُقْبل العذَّال لمّا أَقْبلُوا","لكِنَّهم ولَّوْا على أَدْبَارِهم",80,"م",1,0],["لم يَقوَ مِنهنّ إقْواءٌ لِقَافِيَةٍ","وَلَمْ يَطأْهُنّ في التَّرْتيبِ إيْطاءُ",81,"ا",2,0]]}