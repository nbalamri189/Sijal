"https://www.aldiwan.net/poem38101.html","الخفيف"],[512,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[513,"هذي مناجاة عبد رق حاسده","https://www.aldiwan.net/poem12097.html","البسيط"],[513,"المدح يدري أنكم أكبر","https://www.aldiwan.net/poem12115.html","السريع"],[513,"تقبل الله صوماً أنت واصله","https://www.aldiwan.net/poem12203.html","البسيط"],[513,"خذ حديثي فإنه معسول","https://www.aldiwan.net/poem12218.html","الخفيف"],[536,"قالوا تزوج فلان وهو في","https://www.aldiwan.net/poem47551.html","عموديه"],[536,"الكأس من دون المدامة أكبر","https://www.aldiwan.net/poem48124.html","عموديه"],[536,"عبد السلام ببلدة الحمراء","https://www.aldiwan.net/poem48306.html","عموديه"],[556,"عيسى بن مريم روحي","https://www.aldiwan.net/poem33861.html","المجتث"],[556,"الكل حق والكل باطل","https://www.aldiwan.net/poem34254.html","مخلع البسيط"],[556,"الكل فان إذا له نسبوا","https://www.aldiwan.net/poem34414.html","المنسرح"],[556,"الكون قد أظهر لي بسطه","https://www.aldiwan.net/poem34741.html","السريع"],[560,"لو أنصف الراثي وسار على هدى","https://www.aldiwan.net/poem52821.html","الكامل"],[560,"هذه عروس الزهر نقطها الندى","https://www.aldiwan.net/poem52865.html","الكامل"],[560,"من كان منك أميرا أيها الرمم","https://www.aldiwan.net/poem52895.html","البسيط"],[573,"الكأس لم تذنب فكيف حبستها","https://www.aldiwan.net/poem2744.html","الكامل"],[573,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"],[574,"ألك السدير وبارق","https://www.aldiwan.net/poem1782.html","مجزوء الكامل"],[574,"تفرق أهلي من مقيم وظاعن","https://www.aldiwan.net/poem1806.html","الطويل"]],"verses":[["أَلِكني فَتى فِهرٍ إِلى البيضِ وَالقَنا","فَإِنّي قَذاةٌ في عُيونِ المَآلِكِ",0,"ك",1,0],["أَلِكني إِلى هَذا الوَزيرِ وَقُل لَهُ","لَقَد صَرَعَتنا خِلفَةُ الدَّهرِ فاِنعَشِ",1,"ش",1,1],["أَلَكُم بِآلاءِ الوَشيجِ إِذ","مَرَّ الشِياهُ بِوَقعِهِ خُبرُ",2,"ر",1,0],["الكَيدُ مَمزوجٌ بِأَصفى مائِهِ","وَالخَتلُ فيهِ مُذَوَّبٌ مَصقولُ",3,"ل",1,0],["الكَأسُ مِن رَأدِ الضُحى","وَالراحُ مِن طَفلِ الأَصيل",4,"ل",1,0],["الْكَاتِبُ النِّحْرِيرُ مُنْ","فِي صَدْرِهِ الْعِلْمُ الرَّغِيبْ",5,"ب",1,1],["أَلكَاتِبِ الحُرِّ المُجِيد النَّائِبِ ال","بَرِّ الشَّديد العَزْمِ وَالإِيمَانِ",6,"ن",1,0],["الكَاسِبِ الرِّزْقِ مَشْغُولاً بِقِسْمَتِهِ","كَأَنَّهُ لِذَوِي الحَاجَاتِ قَدْ قَسَمَا",7,"م",2,0],["أَلِكني فَإِنّي مُرسِلٌ بِرِسالَةٍ","إِلى حَكَمٍ مِن غَيرِ حُبِّ وَلا قُربِ",8,"ب",1,0],["الكَلبُ وَالشاعِرُ في مَنزِلٍ","فَلَيتَ أَنّي لَم أَكُن شاعِرا",9,"ر",2,1],["أَلِكني إِلى أَفناءِ بَكرٍ رِسالَةً","عَلى نَأيِها وَهيَ القَوافي السَوائِرُ",10,"ر",1,0],["الكاتم الصدقات وهي شهيرةٌ","كالمسك يكتم وهو شيء فائح",11,"ح",1,0],["الكأسُ في كفّ غادةٍ رود","قم يا أخا النسك غير مطرود",12,"د",1,1],["الكاتبون من الأجسام ما اعْتبرت","سمرٌ وبيضٌ فمنقوطٌ ومشكول",13,"ل",1,0],["الكبير الذي تُعلم نعمى","كفه الناس سحرَ هذا البيان",14,"ن",1,0],["الكَأسُ سَهَلتِ الشَكوى فَبُحتُ بِكُم","وَما عَلى الكَأسِ مِن شُرّابِها دَرَكُ",15,"ك",1,1],["أَلَكَ الأمرُ والسياسةُ واسم الم","عْتفيكَ الصُّعلوكُ والقُرْضُوبُ",16,"ب",1,0],["ألكنِي إلى عمرو بن ليث رسالةً","لها حين يدوى الغيبُ غيبٌ مُسلَّمُ",17,"م",1,0],["أَلِكني إِلَيها وَخَيرُ الرَسو","لِ أَعلَمُهُم بِنَواحي الخَبَر",18,"ر",1,0],["أَلَكَ القَصرُ دونَهُ الحَرَسُ الشا","كي وَمِن حَولِهِ الجِدارُ المُشَيَّد",19,"د",1,0],["أَلَكَ الرَوضَةُ الجَميلَةُ فيها","الماء وَالطَير وَالأَزاهِر وَالنَد",19,"د",1,0],["أَلَكَ النَهرُ إِنَّهُ لِلنَسيمِ الرَط","بِ دَرب وَلِلعَصافيرِ مَورِد",19,"د",1,0],["أَلَكَ الحَقلُ هَذِهِ النَحلُ تَجني","الشَهدَ مِن زَهرِه وَلا تَتَرَدَّد",19,"د",1,0],["الكَذِب وَالتَمويهُ خَيرُ صِفاتِها","وَشِعارُها أَن لا يَدومَ شِعارُ",20,"ر",1,0],["الكَونُ أَجمَعُ ذاهِلٌ لِذُهولِها","حَتّى كَأَنَّ الأَرضَ لَيسَ تَدورُ",21,"ر",1,0],["الكوخُ يَبغِضُكُم وَالقَصرُ يُبغيضُكُم","وَكُلُّ ذي مُهجَةٍ مِنّا وَوُجدانِ",22,"ن",1,0],["الكَوكَبُ الوَضّاحُ يَبقى كَوكَباً","وَلَئِن تَسَتَّرَ بِالدُجى وَتَنَقَّبا",23,"ب",2,0],["الكونُ كونُ شقاءٍ","الكونُ كونُ التباسْ",24,"س",1,0],["الكونُ كونُ اختلاقٍ","وضجَّةٌ واختلاسْ",24,"س",1,0],["الكونُ مُصْغٍ يا كواكبُ خاشعُ","طال انتظاري فانطقي بِجَوابِ",25,"ب",1,0],["أَلَكُم إِلى الصبّ الشَجيّ مَعادُ","فَتَفُكَّ عَنهُ لِلأسى أَصفادُ",26,"د",1,1],["الكوكب الوقاد أمسى آفلا","فبمن اذا سرنا بليل نهتدي",27,"د",2,0],["الكون فاعلم دائر","آخره أوله",28,"ه",1,0],["الكون ماضيه يعو","د بنا الى المستقبل",29,"ل",1,0],["الكذب عاهرة شهدت طلاءها","وسمعت منها رنة الخلخال",30,"ل",1,0],["الكون قد بنيته","وانت خير من بنى",31,"ن",2,0],["الكل يذهب في الفضا","ء على اختلافٍ في المذاهب",32,"ب",1,0],["الكفر لا إكراه فيه لآخذ","والدين قد نشروه بالإكراه",33,"ه",1,0],["الكهرباء من القلوب سرت إلى","أرجائها فأضاءت الأرجاء",34,"ا",2,0],["الكَلْبُ فوقَ أُناسٍ أنتَ مالِكُهُمْ","ونعمةٌ أنتَ فيها عندهمْ نِقَمُ",35,"م",1,1],["الكاتِبَ اللَبِقَ الخَطيبَ الواهِبَ ال","نَدُسَ اللَبيبَ الهِبرِزِيَّ المِصقَعا",36,"ع",2,0],["الكائِنينَ لِمَن أَبغي عَداوَتَهُ","أَعدى العِدا وَلِمَن آخَيتُ إِخوانا",37,"ن",2,0],["أَلكَنُ مِن عُجمَةِ البِلادِ إِذا","أَرادَ مِنهُ يُقالُ قالَ مِنه",38,"ن",2,0],["أَلِكني إِلى ذُهلِ بنِ شَيبانَ إِنَّني","رَأَيتُ أَخاها رافِعاً لِبِنائِها",39,"ا",3,0],["أَلِكني إِلى قُطبِ الرَحا إِن لَقيتَهُ","وَقُطبُ الرَحا نائي العَشيرَةِ أَجنَبُ",40,"ب",1,1],["أَلِكني إِلى راعي الخَليفَةِ وَالَّذي","لَهُ الأُفقُ وَالأَرضُ العَريضَةُ نَوَّرا",41,"ر",2,1],["أَلِكني وَقَد تَأتي الرِسالَةُ مَن نَأى","إِلى اِبنِ شَريكٍ ذي الحُجولِ المُطَوَّقِ",42,"ق",1,1],["أَلِكني إِلى مَن كانَ بِالصينِ إِذ رَمَت","بِهِ الهِندَ أَلواحٌ عَلَيها جِدلالُها",43,"ل",3,0],["أَلِكني إِلى أَفناءِ مُرَّةَ كُلِّها","رِسالَةَ ذي وُدٍّ لِمُرَّةَ واصِلِ",44,"ل",1,0],["الكوكبُ الفَرْدُ الذي يُسرَى به","والليلُ مُعتكِرُ الجوانبِ أَليَلُ",45,"ل",1,0],["الكَأسُ تُهْدِي إلى شُرَّابِها فَرَحَاً","فَمَا لِهَذَا الفَتَى صِفْرَاً مِنَ الفَرَحِ",46,"ح",1,1],["الكأسُ قُطْبُ السُّرورِ والطَّرَبِ","فاحْظَ بها قبلَ حادثِ النُّوَبِ",47,"ب",1,1],["أَلَكُنَّ قَتلُ العاشِقي","نَ مُحَلَّلٌ في الشَرعِ جائِز",48,"ز",1,0],["الكونُ في إحسانها والعمرُ عِن","د حنانها والخلدٌ يومُ لقاءِ",49,"ا",2,0],["أَلِكني إِلى حَيِّ الأَراقِمِ إِنَّهُ","مِنَ الطائِرِ الأَ