poem24326.html","عموديه"],[482,"سواطع التولي في أكتاف ذروته","https://www.aldiwan.net/poem24479.html","عموديه"],[482,"أرقني سقم النوى","https://www.aldiwan.net/poem24549.html","عموديه"],[500,"رعى الزمان فرأى العجائبا","https://www.aldiwan.net/poem37663.html","الرجز"],[500,"أهل الحجاب مع الثياب عيونهم","https://www.aldiwan.net/poem38061.html","الكامل"],[500,"إن معنى الهيام بالأولياء","https://www.aldiwan.net/poem38101.html","الخفيف"],[514,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[515,"هذي مناجاة عبد رق حاسده","https://www.aldiwan.net/poem12097.html","البسيط"],[515,"المدح يدري أنكم أكبر","https://www.aldiwan.net/poem12115.html","السريع"],[515,"تقبل الله صوماً أنت واصله","https://www.aldiwan.net/poem12203.html","البسيط"],[515,"خذ حديثي فإنه معسول","https://www.aldiwan.net/poem12218.html","الخفيف"],[538,"قالوا تزوج فلان وهو في","https://www.aldiwan.net/poem47551.html","عموديه"],[538,"الكأس من دون المدامة أكبر","https://www.aldiwan.net/poem48124.html","عموديه"],[538,"عبد السلام ببلدة الحمراء","https://www.aldiwan.net/poem48306.html","عموديه"],[558,"عيسى بن مريم روحي","https://www.aldiwan.net/poem33861.html","المجتث"],[558,"الكل حق والكل باطل","https://www.aldiwan.net/poem34254.html","مخلع البسيط"],[558,"الكل فان إذا له نسبوا","https://www.aldiwan.net/poem34414.html","المنسرح"],[558,"الكون قد أظهر لي بسطه","https://www.aldiwan.net/poem34741.html","السريع"],[562,"لو أنصف الراثي وسار على هدى","https://www.aldiwan.net/poem52821.html","الكامل"],[562,"هذه عروس الزهر نقطها الندى","https://www.aldiwan.net/poem52865.html","الكامل"],[562,"من كان منك أميرا أيها الرمم","https://www.aldiwan.net/poem52895.html","البسيط"],[575,"الكأس لم تذنب فكيف حبستها","https://www.aldiwan.net/poem2744.html","الكامل"],[575,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"],[576,"ألك السدير وبارق","https://www.aldiwan.net/poem1782.html","مجزوء الكامل"],[576,"تفرق أهلي من مقيم وظاعن","https://www.aldiwan.net/poem1806.html","الطويل"]],"verses":[["أَلِكني فَتى فِهرٍ إِلى البيضِ وَالقَنا","فَإِنّي قَذاةٌ في عُيونِ المَآلِكِ",0,"ك",1,0],["أَلِكني إِلى هَذا الوَزيرِ وَقُل لَهُ","لَقَد صَرَعَتنا خِلفَةُ الدَّهرِ فاِنعَشِ",1,"ش",1,1],["أَلَكُم بِآلاءِ الوَشيجِ إِذ","مَرَّ الشِياهُ بِوَقعِهِ خُبرُ",2,"ر",1,0],["الكَيدُ مَمزوجٌ بِأَصفى مائِهِ","وَالخَتلُ فيهِ مُذَوَّبٌ مَصقولُ",3,"ل",1,0],["الكَأسُ مِن رَأدِ الضُحى","وَالراحُ مِن طَفلِ الأَصيل",4,"ل",1,0],["الْكَاتِبُ النِّحْرِيرُ مُنْ","فِي صَدْرِهِ الْعِلْمُ الرَّغِيبْ",5,"ب",1,1],["أَلكَاتِبِ الحُرِّ المُجِيد النَّائِبِ ال","بَرِّ الشَّديد العَزْمِ وَالإِيمَانِ",6,"ن",1,0],["الكَاسِبِ الرِّزْقِ مَشْغُولاً بِقِسْمَتِهِ","كَأَنَّهُ لِذَوِي الحَاجَاتِ قَدْ قَسَمَا",7,"م",2,0],["أَلِكني فَإِنّي مُرسِلٌ بِرِسالَةٍ","إِلى حَكَمٍ مِن غَيرِ حُبِّ وَلا قُربِ",8,"ب",1,0],["أَلِكْني يا ضياءُ إلى الدراري","رسالةَ مُسهِرٍ فيها الجفونا",9,"ن",2,0],["الكَلبُ وَالشاعِرُ في مَنزِلٍ","فَلَيتَ أَنّي لَم أَكُن شاعِرا",10,"ر",2,1],["أَلِكني إِلى أَفناءِ بَكرٍ رِسالَةً","عَلى نَأيِها وَهيَ القَوافي السَوائِرُ",11,"ر",1,0],["الكاتم الصدقات وهي شهيرةٌ","كالمسك يكتم وهو شيء فائح",12,"ح",1,0],["الكأسُ في كفّ غادةٍ رود","قم يا أخا النسك غير مطرود",13,"د",1,1],["الكاتبون من الأجسام ما اعْتبرت","سمرٌ وبيضٌ فمنقوطٌ ومشكول",14,"ل",1,0],["الكبير الذي تُعلم نعمى","كفه الناس سحرَ هذا البيان",15,"ن",1,0],["الكَأسُ سَهَلتِ الشَكوى فَبُحتُ بِكُم","وَما عَلى الكَأسِ مِن شُرّابِها دَرَكُ",16,"ك",1,1],["أَلَكَ الأمرُ والسياسةُ واسم الم","عْتفيكَ الصُّعلوكُ والقُرْضُوبُ",17,"ب",1,0],["ألكنِي إلى عمرو بن ليث رسالةً","لها حين يدوى الغيبُ غيبٌ مُسلَّمُ",18,"م",1,0],["أَلِكني إِلَيها وَخَيرُ الرَسو","لِ أَعلَمُهُم بِنَواحي الخَبَر",19,"ر",1,0],["أَلَكَ القَصرُ دونَهُ الحَرَسُ الشا","كي وَمِن حَولِهِ الجِدارُ المُشَيَّد",20,"د",1,0],["أَلَكَ الرَوضَةُ الجَميلَةُ فيها","الماء وَالطَير وَالأَزاهِر وَالنَد",20,"د",1,0],["أَلَكَ النَهرُ إِنَّهُ لِلنَسيمِ الرَط","بِ دَرب وَلِلعَصافيرِ مَورِد",20,"د",1,0],["أَلَكَ الحَقلُ هَذِهِ النَحلُ تَجني","الشَهدَ مِن زَهرِه وَلا تَتَرَدَّد",20,"د",1,0],["الكَذِب وَالتَمويهُ خَيرُ صِفاتِها","وَشِعارُها أَن لا يَدومَ شِعارُ",21,"ر",1,0],["الكَونُ أَجمَعُ ذاهِلٌ لِذُهولِها","حَتّى كَأَنَّ الأَرضَ لَيسَ تَدورُ",22,"ر",1,0],["الكوخُ يَبغِضُكُم وَالقَصرُ يُبغيضُكُم","وَكُلُّ ذي مُهجَةٍ مِنّا وَوُجدانِ",23,"ن",1,0],["الكَوكَبُ الوَضّاحُ يَبقى كَوكَباً","وَلَئِن تَسَتَّرَ بِالدُجى وَتَنَقَّبا",24,"ب",2,0],["الكونُ كونُ شقاءٍ","الكونُ كونُ التباسْ",25,"س",1,0],["الكونُ كونُ اختلاقٍ","وضجَّةٌ واختلاسْ",25,"س",1,0],["الكونُ مُصْغٍ يا كواكبُ خاشعُ","طال انتظاري فانطقي بِجَوابِ",26,"ب",1,0],["أَلَكُم إِلى الصبّ الشَجيّ مَعادُ","فَتَفُكَّ عَنهُ لِلأسى أَصفادُ",27,"د",1,1],["الكوكب الوقاد أمسى آفلا","فبمن اذا سرنا بليل نهتدي",28,"د",2,0],["الكون فاعلم دائر","آخره أوله",29,"ه",1,0],["الكون ماضيه يعو","د بنا الى المستقبل",30,"ل",1,0],["الكذب عاهرة شهدت طلاءها","وسمعت منها رنة الخلخال",31,"ل",1,0],["الكون قد بنيته","وانت خير من بنى",32,"ن",2,0],["الكل يذهب في الفضا","ء على اختلافٍ في المذاهب",33,"ب",1,0],["الكفر لا إكراه فيه لآخذ","والدين قد نشروه بالإكراه",34,"ه",1,0],["الكهرباء من القلوب سرت إلى","أرجائها فأضاءت الأرجاء",35,"ا",2,0],["الكَلْبُ فوقَ أُناسٍ أنتَ مالِكُهُمْ","ونعمةٌ أنتَ فيها عندهمْ نِقَمُ",36,"م",1,1],["الكاتِبَ اللَبِقَ الخَطيبَ الواهِبَ ال","نَدُسَ اللَبيبَ الهِبرِزِيَّ المِصقَعا",37,"ع",2,0],["الكائِنينَ لِمَن أَبغي عَداوَتَهُ","أَعدى العِدا وَلِمَن آخَيتُ إِخوانا",38,"ن",2,0],["أَلكَنُ مِن عُجمَةِ البِلادِ إِذا","أَرادَ مِنهُ يُقالُ قالَ مِنه",39,"ن",2,0],["أَلِكني إِلى ذُهلِ بنِ شَيبانَ إِنَّني","رَأَيتُ أَخاها رافِعاً لِبِنائِها",40,"ا",3,0],["أَلِكني إِلى قُطبِ الرَحا إِن لَقيتَهُ","وَقُطبُ الرَحا نائي العَشيرَةِ أَجنَبُ",41,"ب",1,1],["أَلِكني إِلى راعي الخَليفَةِ وَالَّذي","لَهُ الأُفقُ وَالأَرضُ العَريضَةُ نَوَّرا",42,"ر",2,1],["أَلِكني وَقَد تَأتي الرِسالَةُ مَن نَأى","إِلى اِبنِ شَريكٍ ذي الحُجولِ المُطَوَّقِ",43,"ق",1,1],["أَلِكني إِلى مَن كانَ بِالصينِ إِذ رَمَت","بِهِ الهِندَ أَلواحٌ عَلَيها جِدلالُها",44,"ل",3,0],["أَلِكني إِلى أَفناءِ مُرَّةَ كُلِّها","رِسالَةَ ذي وُدٍّ لِمُرَّةَ واصِلِ",45,"ل",1,0],["الكوكبُ الفَرْدُ الذي يُسرَى به","والليلُ مُعتكِرُ الجوانبِ أَليَلُ",46,"ل",1,0],["الكَأسُ تُهْدِي إلى شُرَّابِها فَرَحَاً","فَمَا لِهَذَا الفَتَى صِفْرَاً مِنَ الفَرَحِ",47,"ح",1,1],["الكأسُ قُطْبُ السُّرورِ والطَّرَبِ","فاحْظَ بها قبلَ حادثِ النُّوَبِ",48,"ب",1,1],["أَلَكُنَّ قَتلُ العاشِقي","نَ مُحَلَّلٌ في الشَرعِ جائِز",49,"ز",1,0],["الكونُ في إحسانها والعمرُ عِن","د حنانها والخلدٌ يومُ لقاءِ",50,"ا",2,0],["أَلِكني إِلى حَيِّ الأَراقِمِ إِنَّهُ","مِنَ الطائِرِ الأَحشاءِ تُهدى المَآلِكُ",51,"ك",1,0],["الكَوكَبُ الجُشَمِيُّ نَصبَ عُيونِكُم","فَاِستَوضِحوا إيضاءَ ذاكَ الكَوكَبِ",52,"ب",1,0],["أَلِكني إِلَيها بِالسَلامِ فَإِنَّهُ","يُشَهَّرُ إِلمامي بِها وَيُنَكَّرُ",53,"ر",1,0],["الكاتبُ الأعلى يُدمِّرُ ما بَنَوْا","فَوقَ الصَّحائفِ والخطيبُ الأكبرُ",54,"ر",1,0],["الكونُ أشرقَ نَضرةً ونعيما","هذا مكانُك فاتّخذه كريما",55,"م",2,1],["الكُفرُ والبَغيُ الذّميمُ كلاهما","جَعَلا الحياةَ على النُّفوسِ جَحيما",55,"م",2,0],["الكوكبُ السّيارُ في آفاقهِ","ملأ البلادَ أهِلَّةً ونُجوما",55,"م",2,0],["الكَسْبُ عُطِّلَ والمتاجِرُ طُلِّقَتْ","فالعيشُ ضَنْكٌ والحياةُ كسادُ",56,"د",1,0],["الكونُ مُنطَلَقٌ لِعزمِكَ واسعٌ","فأرْبَأْ بنفسِكَ أن تكون حبيسا",57,"س",2,0],["ألِكلِّ طائفةٍ زعيمٌ صالحٌ","وبكلِّ ناحيةٍ أذىً وفسادُ",58,"د",1,0],["الكُتْبُ تَتْرَى والكتائبُ تَدلِفُ","والبأسُ بينهما يَثورُ ويعصِفُ",59,"ف",1,1],["الكَوثَرِيُّ إِذا هَمى وَالكَوكَبيُّ","إِذا سَما وَالمُنصُلِيُّ إِذا فَرى",60,"ر",2,0],["أَلِكُلٍّ منهم نَصِيبٌ مِنَ المُل","كِ فَهَلَّا تَمَيَّزُ الأَنْصِبَاءُ",61,"ا",2,0],["الكاتِبُونَ وَلَيْسُوا بالكِرامِ فما","منهمْ على المالِ إنْسانٌ بِمَأْمُونِ",62,"ن",1,0],["ألِكْني إليهم والتّنائفُ دونهم","سقَتهم أهاضيبٌ من المُزن نُضَّخ",63,"خ",1,0],["الكُفاةُ الحُماةُ إِن قامَتِ الحَر","بُ حَبانا وَعَزَّ ما في الصُدورِ",64,"ر",1,0],["أَلِكني يا عُيَينَ إِلَيكَ قَولاً","سَأُهديهِ إِلَيكَ إِلَيكَ عَنّي",65,"ي",1,0],["أَلِكني إِلى النُعمانِ حَيثُ لَقيتَهُ","فَأَهدى لَهُ اللَهُ الغُيوثَ البَواكِرا",66,"ر",2,0],["الكَونُ في جُملَةِ العَوافي","لا الكَونُ في جُملَةِ العُفاةِ",67,"ه",1,1],["أَلِكني إِلى مَن لَهُ حِكمَةٌ","أَلِكني إِلَيهِ أَلِكني أَلِك",68,"ك",1,1],["الكون للمرء يستقريه مدرسة","والكون للمرء مملوء من العبر",69,"ر",1,0],["الكيل يوفيه حتى","يتم بالصاع صاع",70,"ع",1,0],["الكَون شيء ثابت","وَالحادِثات به تَطوف",71,"ف",1,0],["أَلكني يا ضياء إلى نجوم","بعيدات لها منها وقود",72,"د",1,0],["الكَون نسج الكَهرباء وإنها","هي هذه الحركات في الأكوان",73,"ن",1,0],["الكذب راقك إنه متجمل","وَالصدق ساءَك إنه عَريان",74,"ن",1,0],["الكَون بحر من لَهيب لاهِب","وَالناس فيه سابح وَغَريق",75,"ق",1,0],["الكل مرتاح","الكل جذلانُ",76,"ن",1,0],["الكثرُ قضى وإذا ما الكث","رُ قَضى شَيئاً أمضى القدر",77,"ر",1,0],["الكَون بحر تكثر الغَرقى به","من راسب في قعره أَو طافي",78,"ي",1,0],["ألكنني يا ضياء إلى الدَّراري","رسالة مسهر فيها الجفونا",79,"ن",2,0],["ألكل فيها لهم متاعٌ","وفرٌ ومن علمه نصيب",80,"ب",1,0],["الكونُ يبدو وادعاً هانئا","كأنهُ الفردوسُ في أمنِه",81,"ه",1,0],["الكأسَ والقيثارْ","يا ربَّةَ الحسنِ",82,"ن",1,0],["الكأسُ فيها وهي تضطرمُ","قلبٌ يهزُّ نداؤه الأبدا",83,"د",2,0],["الكُتبُ وَالرُسلُ وَالأَديانُ قاطِبَةً","خَزائِنُ الحِكمَةِ الكُبرى لِواعيها",84,"ي",3,0],["الكُفْرُ عنهُم قاعِدٌ","قِدْماً ودِينُ اللَّه قائِمْ",85,"م",1,0],["أَلَكُم بِآلاءِ الوَشيجِ إِذا","مَرَّ الشِياهُ بِوَقعِهِ خُبرُ",86,"ر",1,0],["الْكَاشِفُونَ الضُّرَّ وَالْ","عَافُونَ عَنْ ذَنْبِ الْعِبَادِ",87,"د",1,0],["أَلِكَسْبٍ لا وَلَكِنْ","هَمُّ قَوْمٍ لَكَ هَمُّ",88,"م",1,0],["الكَرِيمُ الْمُثيِبُ مَنْ يَتَّقِيهِ","والْحَلِيمُ الغَفُورُ لِلأَوْزارِ",89,"ر",1,0],["أَلكَاتِبُ النِّحْرِيرُ فخْرُ زَمَانهِ","ولَّى وَكَانَ مِنَ الطِّرَازِ النادِرِ",90,"ر",1,0],["أَلكَاتِبُ الفَذُّ قَدْ أَلْقَى بَرَاعَتَهُ","بَعْدَ اصْطِحَابٍ طَوِيلِ العَهْدِ مَحْمُودِ",91,"د",1,0],["أَلكَاتِبُ العَرَبِيُّ مَهْ","مَا يَدْهَهُ فَلَهُ الذُّنُوبُ",92,"ب",1,0],["أَلكَائِدِينَ عِدَاهُمْ","بِكُلِّ فِعْلٍ نَبِيلِ",93,"ل",1,0],["أَلكَاظِمِ الغَيْظَ الْغَفُورَ تَفَضُّلاً","وَتَطَوُّلاً لِجِهَالَةِ الْجُهَلاَءِ",94,"ا",2,0],["الكفاحْ والفَلاحْ","شيمةُ الحُرِّ ودأبُ العاملينْ",95,"ن",1,0],["الكَوْنُ أُذْنٌ لِمَا تُلْقِيه وَاعِية