dhabi.ae/diwan/poem/85334","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85479","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85411","المتدارك"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85452","الكامل"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/55641","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39674","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39611","المنسرح"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39601","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19074","البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9862","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42595","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55243","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54959","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54883","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54751","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55177","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54257","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54280","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[106,"صدى الجمهورية","https://www.poetsgate.com/ViewPoem.aspx?id=179586",""],[106,"غادة البسفور","https://www.poetsgate.com/ViewPoem.aspx?id=179474",""],[106,"معترك السباب!","https://www.poetsgate.com/ViewPoem.aspx?id=179427",""],[106,"أغنية الإِسراء","https://www.poetsgate.com/ViewPoem.aspx?id=179622",""],[106,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[106,"تجار العقائد","https://www.poetsgate.com/ViewPoem.aspx?id=179441",""],[106,"تكلمي يا كتائب","https://www.poetsgate.com/ViewPoem.aspx?id=179636",""],[106,"نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=179310",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[106,"الكبش والذئب","https://www.poetsgate.com/ViewPoem.aspx?id=179570",""],[90,"ثورة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=179082",""],[90,"تحرك اللحد !","https://www.poetsgate.com/ViewPoem.aspx?id=179160",""],[28,"وكيف بنفس كلما قلت أشرفت","https://www.poetsgate.com/ViewPoem.aspx?id=21752",""],[28,"ألكني إلى قطب الرحا إن لقيته","https://www.poetsgate.com/ViewPoem.aspx?id=21719",""]],"verses":[["أَلِكني فَتى فِهرٍ إِلى البيضِ وَالقَنا","فَإِنّي قَذاةٌ في عُيونِ المَآلِكِ",0,"ك",1,0],["أَلِكني إِلى هَذا الوَزيرِ وَقُل لَهُ","لَقَد صَرَعَتنا خِلفَةُ الدَّهرِ فاِنعَشِ",1,"ش",1,1],["أَلَكُم بِآلاءِ الوَشيجِ إِذ","مَرَّ الشِياهُ بِوَقعِهِ خُبرُ",2,"ر",1,0],["الكَيدُ مَمزوجٌ بِأَصفى مائِهِ","وَالخَتلُ فيهِ مُذَوَّبٌ مَصقولُ",3,"ل",1,0],["الكَأسُ مِن رَأدِ الضُحى","وَالراحُ مِن طَفلِ الأَصيل",4,"ل",1,0],["الْكَاتِبُ النِّحْرِيرُ مُنْ","فِي صَدْرِهِ الْعِلْمُ الرَّغِيبْ",5,"ب",1,1],["أَلكَاتِبِ الحُرِّ المُجِيد النَّائِبِ ال","بَرِّ الشَّديد العَزْمِ وَالإِيمَانِ",6,"ن",1,0],["الكَاسِبِ الرِّزْقِ مَشْغُولاً بِقِسْمَتِهِ","كَأَنَّهُ لِذَوِي الحَاجَاتِ قَدْ قَسَمَا",7,"م",2,0],["أَلِكني فَإِنّي مُرسِلٌ بِرِسالَةٍ","إِلى حَكَمٍ مِن غَيرِ حُبِّ وَلا قُربِ",8,"ب",1,0],["الكَلبُ وَالشاعِرُ في مَنزِلٍ","فَلَيتَ أَنّي لَم أَكُن شاعِرا",9,"ر",2,1],["أَلِكني إِلى أَفناءِ بَكرٍ رِسالَةً","عَلى نَأيِها وَهيَ القَوافي السَوائِرُ",10,"ر",1,0],["الكاتم الصدقات وهي شهيرةٌ","كالمسك يكتم وهو شيء فائح",11,"ح",1,0],["الكأسُ في كفّ غادةٍ رود","قم يا أخا النسك غير مطرود",12,"د",1,1],["الكاتبون من الأجسام ما اعْتبرت","سمرٌ وبيضٌ فمنقوطٌ ومشكول",13,"ل",1,0],["الكبير الذي تُعلم نعمى","كفه الناس سحرَ هذا البيان",14,"ن",1,0],["الكَأسُ سَهَلتِ الشَكوى فَبُحتُ بِكُم","وَما عَلى الكَأسِ مِن شُرّابِها دَرَكُ",15,"ك",1,1],["أَلَكَ الأمرُ والسياسةُ واسم الم","عْتفيكَ الصُّعلوكُ والقُرْضُوبُ",16,"ب",1,0],["ألكنِي إلى عمرو بن ليث رسالةً","لها حين يدوى الغيبُ غيبٌ مُسلَّمُ",17,"م",1,0],["أَلِكني إِلَيها وَخَيرُ الرَسو","لِ أَعلَمُهُم بِنَواحي الخَبَر",18,"ر",1,0],["أَلَكَ القَصرُ دونَهُ الحَرَسُ الشا","كي وَمِن حَولِهِ الجِدارُ المُشَيَّد",19,"د",1,0],["أَلَكَ الرَوضَةُ الجَميلَةُ فيها","الماء وَالطَير وَالأَزاهِر وَالنَد",19,"د",1,0],["أَلَكَ النَهرُ إِنَّهُ لِلنَسيمِ الرَط","بِ دَرب وَلِلعَصافيرِ مَورِد",19,"د",1,0],["أَلَكَ الحَقلُ هَذِهِ النَحلُ تَجني","الشَهدَ مِن زَهرِه وَلا تَتَرَدَّد",19,"د",1,0],["الكَذِب وَالتَمويهُ خَيرُ صِفاتِها","وَشِعارُها أَن لا يَدومَ شِعارُ",20,"ر",1,0],["الكَونُ أَجمَعُ ذاهِلٌ لِذُهولِها","حَتّى كَأَنَّ الأَرضَ لَيسَ تَدورُ",21,"ر",1,0],["الكوخُ يَبغِضُكُم وَالقَصرُ يُبغيضُكُم","وَكُلُّ ذي مُهجَةٍ مِنّا وَوُجدانِ",22,"ن",1,0],["الكَوكَبُ الوَضّاحُ يَبقى كَوكَباً","وَلَئِن تَسَتَّرَ بِالدُجى وَتَنَقَّبا",23,"ب",2,0],["الكونُ كونُ شقاءٍ","الكونُ كونُ التباسْ",24,"س",1,0],["الكونُ كونُ اختلاقٍ","وضجَّةٌ واختلاسْ",24,"س",1,0],["الكونُ مُصْغٍ يا كواكبُ خاشعُ","طال انتظاري فانطقي بِجَوابِ",25,"ب",1,0],["أَلَكُم إِلى الصبّ الشَجيّ مَعادُ","فَتَفُكَّ عَنهُ لِلأسى أَصفادُ",26,"د",1,1],["الكوكب الوقاد أمسى آفلا","فبمن اذا سرنا بليل نهتدي",27,"د",2,0],["الكون فاعلم دائر","آخره أوله",28,"ه",1,0],["الكون ماضيه يعو","د بنا الى المستقبل",29,"ل",1,0],["الكذب عاهرة شهدت طلاءها","وسمعت منها رنة الخلخال",30,"ل",1,0],["الكون قد بنيته","وانت خير من بنى",31,"ن",2,0],["الكل يذهب في الفضا","ء على اختلافٍ في المذاهب",32,"ب",1,0],["الكفر لا إكراه فيه لآخذ","والدين قد نشروه بالإكراه",33,"ه",1,0],["الكهرباء من القلوب سرت إلى","أرجائها فأضاءت الأرجاء",34,"ا",2,0],["الكَلْبُ فوقَ أُناسٍ أنتَ مالِكُهُمْ","ونعمةٌ أنتَ فيها عندهمْ نِقَمُ",35,"م",1,1],["الكاتِبَ اللَبِقَ الخَطيبَ الواهِبَ ال","نَدُسَ اللَبيبَ الهِبرِزِيَّ المِصقَعا",36,"ع",2,0],["الكائِنينَ لِمَن أَبغي عَداوَتَهُ","أَعدى العِدا وَلِمَن آخَيتُ إِخوانا",37,"ن",2,0],["أَلكَنُ مِن عُجمَةِ البِلادِ إِذا","أَرادَ مِنهُ يُقالُ قالَ مِنه",38,"ن",2,0],["أَلِكني إِلى ذُهلِ بنِ شَيبانَ إِنَّني","رَأَيتُ أَخاها رافِعاً لِبِنائِها",39,"ا",3,0],["أَلِكني إِلى قُطبِ الرَحا إِن لَقيتَهُ","وَقُطبُ الرَحا نائي العَشيرَةِ أَجنَبُ",40,"ب",1,1],["أَلِكني إِلى راعي الخَليفَةِ وَالَّذي","لَهُ الأُفقُ وَالأَرضُ العَريضَةُ نَوَّرا",41,"ر",2,1],["أَلِكني وَقَد تَأتي الرِسالَةُ مَن نَأى","إِلى اِبنِ شَريكٍ ذي الحُجولِ المُطَوَّقِ",42,"ق",1,1],["أَلِكني إِلى مَن كانَ بِالصينِ إِذ رَمَت","بِهِ الهِندَ أَلواحٌ عَلَيها جِدلالُها",43,"ل",3,0],["أَلِكني إِلى أَفناءِ مُرَّةَ كُلِّها","رِسالَةَ ذي وُدٍّ لِمُرَّةَ واصِلِ",44,"ل",1,0],["الكوكبُ الفَرْدُ الذي يُسرَى به","والليلُ مُعتكِرُ الجوانبِ أَليَلُ",45,"ل",1,0],["الكَأسُ تُهْدِي إلى شُرَّابِها فَرَحَاً","فَمَا لِهَذَا الفَتَى صِفْرَاً مِنَ الفَرَحِ",46,"ح",1,1],["الكأسُ قُطْبُ السُّرورِ والطَّرَبِ","فاحْظَ بها قبلَ حادثِ النُّوَبِ",47,"ب",1,1],["أَلَكُنَّ قَتلُ العاشِقي","نَ مُحَلَّلٌ في الشَرعِ جائِز",48,"ز",1,0],["الكونُ في إحسانها والعمرُ عِن","د حنانها والخلدٌ يومُ لقاءِ",49,"ا",2,0],["أَلِكني إِلى حَيِّ الأَراقِمِ إِنَّهُ","مِنَ الطائِرِ الأَحشاءِ تُهدى المَآلِكُ",50,"ك",1,0],["الكَوكَبُ الجُشَمِيُّ نَصبَ عُيونِكُم","فَاِستَوضِحوا إيضاءَ ذاكَ الكَوكَبِ",51,"ب",1,0],["أَلِكني إِلَيها بِالسَلامِ فَإِنَّهُ","يُشَهَّرُ إِلمامي بِها وَيُنَكَّرُ",52,"ر",1,0],["الكاتبُ الأعلى يُدمِّرُ ما بَنَوْا","فَوقَ الصَّحائفِ والخطيبُ الأكبرُ",53,"ر",1,0],["الكونُ أشرقَ نَضرةً ونعيما","هذا مكانُك فاتّخذه كريما",54,"م",2,1],["الكُفرُ والبَغيُ الذّميمُ كلاهما","جَعَلا الحياةَ على النُّفوسِ جَحيما",54,"م",2,0],["الكوكبُ السّيارُ في آفاقهِ","ملأ البلادَ أهِلَّةً ونُجوما",54,"م",2,0],["الكَسْبُ عُطِّلَ والمتاجِرُ طُلِّقَتْ","فالعيشُ ضَنْكٌ والحياةُ كسادُ",55,"د",1,0],["الكونُ مُنطَلَقٌ لِعزمِكَ واسعٌ","فأرْبَأْ بنفسِكَ أن تكون حبيسا",56,"س",2,0],["ألِكلِّ طائفةٍ زعيمٌ صالحٌ","وبكلِّ ناحيةٍ أذىً وفسادُ",57,"د",1,0],["الكُتْبُ تَتْرَى والكتائبُ تَدلِفُ","والبأسُ بينهما يَثورُ ويعصِفُ",58,"ف",1,1],["الكَوثَرِيُّ إِذا هَمى وَالكَوكَبيُّ","إِذا سَما وَالمُنصُلِيُّ إِذا فَرى",59,"ر",2,0],["أَلِكُلٍّ منهم نَصِيبٌ مِنَ المُل","كِ فَهَلَّا تَمَيَّزُ الأَنْصِبَاءُ",60,"ا",2,0],["الكاتِبُونَ وَلَيْسُوا بالكِرامِ فما","منهمْ على المالِ إنْسانٌ بِمَأْمُونِ",61,"ن",1,0],["ألِكْني إليهم والتّنائفُ دونهم","سقَتهم أهاضيبٌ من المُزن نُضَّخ",62,"خ",1,0],["الكُفاةُ الحُماةُ إِن قامَتِ الحَر","بُ حَبانا وَعَزَّ ما في الصُدورِ",63,"ر",1,0],["أَلِكني يا عُيَينَ إِلَيكَ قَولاً","سَأُهديهِ إِلَيكَ إِلَيكَ عَنّي",64,"ي",1,0],["أَلِكني إِلى النُعمانِ حَيثُ لَقيتَهُ","فَأَهدى لَهُ اللَهُ الغُيوثَ البَواكِرا",65,"ر",2,0],["الكَونُ في جُملَةِ العَوافي","لا الكَونُ في جُملَةِ العُفاةِ",66,"ه",1,1],["أَلِكني إِلى مَن لَهُ حِكمَةٌ","أَلِكني إِلَيهِ أَلِكني أَلِك",67,"ك",1,1],["الكون للمرء يستقريه مدرسة","والكون للمرء مملوء من العبر",68,"ر",1,0],["الكيل يوفيه حتى","يتم بالصاع صاع",69,"ع",1,0],["الكَون شيء ثابت","وَالحادِثات به تَطوف",70,"ف",1,0],["أَلكني يا ضياء إلى نجوم","بعيدات لها منها وقود",71,"د",1,0],["الكَون نسج الكَهرباء وإنها","هي هذه الحركات في الأكوان",72,"ن",1,0],["الكذب راقك إنه متجمل","وَالصدق ساءَك إنه عَريان",73,"ن",1,0],["الكَون بحر من لَهيب لاهِب","وَالناس فيه سابح وَغَريق",74,"ق",1,0],["الكل مرتاح","الكل جذلانُ",75,"ن",1,0],["الكثرُ قضى وإذا ما الكث","رُ قَضى شَيئاً أمضى القدر",76,"ر",1,0],["الكَون بحر تكثر الغَرقى به","من راسب في قعره أَو طافي",77,"ي",1,0],["ألكنني يا ضياء إلى الدَّراري","رسالة مسهر فيها الجفونا",78,"ن",2,0],["ألكل فيها لهم متاعٌ","وفرٌ ومن علمه نصيب",79,"ب",1,0],["الكونُ يبدو وادعاً هانئا","كأنهُ الفردوسُ في أمنِه",80,"ه",1,0],["الكأسَ والقيثارْ","يا ربَّةَ الحسنِ",81,"ن",1,0],["الكأسُ فيها وهي تضطرمُ","قلبٌ يهزُّ نداؤه الأبدا",82,"د",2,0],["الكُتبُ وَالرُسلُ وَالأَديانُ قاطِبَةً","خَزائِنُ الحِكمَةِ الكُبرى لِواعيها",83,"ي",3,0],["الكُفْرُ عنهُم قاعِدٌ","قِدْماً ودِينُ اللَّه قائِمْ",84,"م",1,0],["أَلَكُم بِآلاءِ الوَشيجِ إِذا","مَرَّ الشِياهُ بِوَقعِهِ خُبرُ",85,"ر",1,0],["الْكَاشِفُونَ الضُّرَّ وَالْ","عَافُونَ عَنْ ذَنْبِ الْعِبَادِ",86,"د",1,0],["أَلِكَسْبٍ لا وَلَكِنْ","هَمُّ قَوْمٍ لَكَ هَمُّ",87,"م",1,0],["الكَرِيمُ الْمُثيِبُ مَنْ يَتَّقِيهِ","والْحَلِيمُ الغَفُورُ لِلأَوْزارِ",88,"ر",1,0],["أَلكَاتِبُ النِّحْرِيرُ فخْرُ زَمَانهِ","ولَّى وَكَانَ مِنَ الطِّرَازِ النادِرِ",89,"ر",1,0],["أَلكَاتِبُ الفَذُّ قَدْ أَلْقَى بَرَاعَتَهُ","بَعْدَ اصْطِحَابٍ طَوِيلِ العَهْدِ مَحْمُودِ",90,"د",1,0],["أَلكَاتِبُ العَرَبِيُّ مَهْ","مَا يَدْهَهُ فَلَهُ الذُّنُوبُ",91,"ب",1,0],["أَلكَائِدِينَ عِدَاهُمْ","بِكُلِّ فِعْلٍ نَبِيلِ",92,"ل",1,0],["أَلكَاظِمِ الغَيْظَ الْغَفُورَ تَفَضُّلاً","وَتَطَوُّلاً لِجِهَالَةِ الْجُهَلاَءِ",93,"ا",2,0],["الكفاحْ والفَلاحْ","شيمةُ الحُرِّ ودأبُ العاملينْ",94,"ن",1,0],["الكَوْنُ أُذْنٌ لِمَا تُلْقِيه وَاعِيةٌ","فامْلأْ مَدَاهُ بصَوْتٍ مِنْكَ رَنَّان",95,"ن",1,0],["الكون كوَّنه الرحمنُ من قِدَمٍ","فهل تريدُ له يا طيرُ تكوينا",96,"ن",2,0],["الكلُّ يثني على آلائِهِ كذِبًا","ويُنشئُ المدحَ فيه غيرَ مُعتقِدِ",97,"د",1,0],["الكون دان لوجنتيك، وطالما","دانت لقومك صفحة المعمور",98,"ر",1,0],["الكلُّ حين يَشمُّ رِي","حَ الحكم سيسالُ اللعَاب",99,"ب",1,0],["الكائناتُ كتابٌ أنتَ من قِدَمٍ","عنوانُهُ، وهْيَ لفظٌ أنت معناهُ",100,"ا",2,0],["الكراسيُّ والمكاتب أحنَت","ظهرَه في الشباب أيَّ انحناء",101,"ا",2,0],["الكل في الفردوس يط","مع أو يخاف جهنما",102,"م",2,0],["الكلُّ -بعد الله- حُبُّكِ دينُهُ","مَنْ كان حُبُّك دينَه، لم يأثَم",103,"م",1,0],["الكون في نشوة من يوم مقْدَمه","فكل ما فيه يمشي وهْو وَسْنان",104,"ن",1,0],["الكُلُّ شَاكٍ حَظَّه، مُتَبَرِّمٌ","هَيْهَاتَ أن يَرضَى الأنامُ بحالِ!",105,"ل",1,0],["الكبشُ قام خطيبًا فوقَ رابيةٍ","ينَعي على الذئب فتك الذئب بالغنمٍ",106,"م",1,1],["الكُلُّ لاهونَ عن شكوى وموجدَةٍ","بما لَهُمْ مِن لُباناتٍ وأوطار",107,"ر",1,0],["الكابتُ النفسَ أزماناً على حنَقٍ","حتى طغى فرأينا كيفَ ينفجر",108,"ر",1,0],["ألِكْني إلى مَنْ كان بالصّينِ إذ رَمَتْ","بالهِنْدَ ألْوَاحٌ عَلَيْها جِلالُها",109,"ل",3,0],["ألِكْني إلى قُطِب الرَّحا إنْ لَقيتَهُ،","وعقُطْبُ الرَّحا نائي العَشيرَةِ أجنَبُ",110,"ب",1,1]]}