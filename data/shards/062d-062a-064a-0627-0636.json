{"poems":[[74,"سلوت لكن قلبي يا سعاد سلي","https://www.aldiwan.net/poem19470.html","البسيط"],[74,"إنسان عيني بتعجيل السهاد بلي","https://www.aldiwan.net/poem19471.html","البسيط"],[40,"ألا اسلمي اليوم ذات الطوق والعاج","https://www.aldiwan.net/poem7694.html","البسيط"],[71,"وما كفى ما أتوه","https://www.aldiwan.net/poem29264.html","السريع"],[69,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85576","البسيط"],[208,"للعيد أوعدني من لم يزل عيدا","https://www.aldiwan.net/poem53320.html","البسيط"],[244,"أسرى به في ليلة المعراج","https://www.aldiwan.net/poem23836.html","الكامل"],[355,"أعرفت رسم الدار بالحبس","https://www.aldiwan.net/poem640.html",""],[408,"وافاك يصحبه الإسعاد والظفر","https://www.aldiwan.net/poem46940.html","البسيط"],[520,"شأن الغرام أجل أن يلحاني","https://www.aldiwan.net/poem12277.html","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50030","السريع"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113958","البسيط"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29560","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77346","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88650","الكامل"],[2328,"","https://poetry.dctabudhabi.ae/diwan/poem/113030","السريع"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109991","المنسرح"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92137","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91309","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35108","البسيط"],[5121,"لِلْكَرَوَانِ فُلَّة","https://www.poetsgate.com/ViewPoem.aspx?id=179415",""],[5431,"العشاء الأخير...","https://www.poetsgate.com/ViewPoem.aspx?id=199488",""],[6268,"يبكيكم الأقصى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82924&r=&rc=10",""],[6345,"ارحل ....","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78651&r=&rc=22",""]],"verses":[["حتَّى أضا الشيب في فودِي فأرْشدني","إلى الهدى في سواد الرأس كالشعل",0,"ل",1,0],["حتَّى أضا الشيب في فودي فأرشدني","إلى الهدى في ظلام الفود بالشغل",1,"ل",1,0],["حَتّى أَضاءَ سِراجٌ دونَهُ بَقَرٌ","حُمرُ الأَنامِلِ عَينٌ طَرفُها ساجِ",2,"ج",1,0],["حتى أضافوهُ جهلاً","إلى الإمامِ علي",3,"ي",1,0],["حتّى أَضُمَّ بِطَيبَةَ الشَّملَ الَّذي","أنْضَى إليها العِرْمِسَ الشِّملِيلا",4,"ل",2,0],["حتى أَضاعَت لعمري من شراسته","حَياتها وهو في سكر من الجذل",5,"ل",1,0],["حتى أضمَّ إلى قلبي أنامله","عسى أحسُّ لهذا الوجد تبريدا",6,"د",2,0],["حتى أضاء الكون نو سنائه","متألقا في ضوئه الوهاج",7,"ج",1,0],["حَتّى أَضاءَ الصُبحُ وأنحَسَرَت","عنه غَمايَةُ مظلمِ دَمسِ",8,"س",1,0],["حتّى أضاء مُحيّا الدِّين مُبتَلِجاً","وزالَ عن مُقلَتيهِ السوءُ والضَّرَرُ",9,"ر",1,0],["حتى أضافوا بعد ذلك أنهم","أخذوا بثأر الكفر في الإيمان",10,"ن",1,0],["حتى أضاءَ الشيب في مفرقي","أبيضَ كالصّبح غدا في الظّلامْ",11,"م",1,0],["حتّى أضاءَت مَهاً صُفراً ترائِبُها","بيضاً محاجِرُها حُمَرَ الأصابيعِ",12,"ع",1,0],["حَتّى أَضافَ إِلى وادٍ ضَفادِعُهُ","غَرقى رُدافي تَراها تَشتَكي النَشَجا",13,"ج",2,0],["حَتّى أَضاءَ الدينُ ما فَوقَ الثَرى","وَجَرى مَع الأَقمارِ في مَيدانِ",14,"ن",1,0],["حتىّ اضالعه المصاب ومال من","طود العلى بالعز والتَبجيل",15,"ل",1,0],["حتَّى اضلاَّ فيه علمي به","إذ بدِّلت من هضبه الوهد",16,"د",1,0],["حتى أَضا كوكب الصَباحِ بأُفقِ","بِيعةِ اللَهِ نُورُهُ طَلَعا",17,"ع",2,0],["حتى أضم قوامه","ويبيحني أبداً خدودا",18,"د",2,0],["حَتّى أَضعن الخَمسَ في حبّاتها","وَذَهَبنَ في دين الغَرام مَذاهبي",19,"ب",2,0],["حَتَّى أَضاقَ بالرَّحُوبِ سَيفُهُ","بِمَن أَبارَ مِنهُم رَحبَ الفَلا",20,"ا",1,0],["حَتّى أَضاءَت مِنَ الإيمانِ عَن قَبَسٍ","قَد كانَ تَحتَ رَمادِ الكُفرِ مَكفورِ",21,"ر",1,0],["حَتَّى أَضَأْتَ بِرَوْضَتِي أَسْوَارَهَا","وَ بَزَغْتَ فِي أُفُقِ الَجَمَالِ سُفُورَا",22,"ر",2,0],["حتى أضاءت في المدى بنبوءة","نادت لكلّ معذّبٍ يتنغصُ",23,"ص",1,0],["حتىْ أضاعت مجدها \"يعربٌ \"","وألَّهت جَلادَها المستبيحْ",24,"ح",1,0],["حتى أضعت جهاتي أيها قدري","والفقد ينحت أشلائي ويكويني",25,"ن",2,0]]}