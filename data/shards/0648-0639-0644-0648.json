{"poems":[[55,"ألبستني نعما على نعم","https://www.aldiwan.net/poem29761.html","الكامل"],[90,"يا عدل طال الانتظار فعجل","https://www.aldiwan.net/poem44798.html","الكامل"],[23,"ذهبت بابن الزبعرى وقعة","https://www.aldiwan.net/poem21243.html","الرمل"],[74,"إن طيفا عن حال شجواي أملى","https://www.aldiwan.net/poem20543.html","الخفيف"],[53,"يا أبا الفضل ريع شامطياقي","https://www.aldiwan.net/poem66293.html","الخفيف"],[91,"في الصدر حتى كدت تردى","https://www.aldiwan.net/poem44868.html","مجزوء الكامل"],[87,"لمن المساكن كالمقابر","https://www.aldiwan.net/poem7768.html","مجزوء الكامل"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[47,"يا عارضا متلفعا ببروده","https://www.aldiwan.net/poem63492.html","الخفيف"],[47,"إن الظباء غداة سفح محجر","https://www.aldiwan.net/poem63628.html","البسيط"],[69,"أزمعوا البين وشدوا الركابا","https://www.aldiwan.net/poem18030.html","المديد"],[48,"حديث على العالمين التبك","https://www.aldiwan.net/poem23114.html","المتقارب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[30,"رأيت سماء الله والأرض ألقتا","https://www.poetsgate.com/ViewPoem.aspx?id=20015",""],[119,"يا رسول الرضى بفضلك دارك","https://www.aldiwan.net/poem42172.html","الخفيف"],[137,"وعلوي الجمال إذا تبدى","https://www.aldiwan.net/poem4232.html","الوافر"],[147,"محض الإباء وسؤدد الآباء","https://www.aldiwan.net/poem11717.html","الكامل"],[147,"النجم أقرب من مداك منالا","https://www.aldiwan.net/poem11792.html","الكامل"],[147,"ما كان قبلك في الزمان الخالي","https://www.aldiwan.net/poem11802.html","الكامل"],[147,"ما أدرك الطلبات مثل مصمم","https://www.aldiwan.net/poem11813.html","الكامل"],[159,"لمن الرسوم برامتين بلينا","https://www.aldiwan.net/poem55540.html","الكامل"],[164,"بي من فتور المقلة الكحلاء","https://www.aldiwan.net/poem58775.html","الكامل"],[185,"يا للرجال هوى أميمة قاتلى","https://www.aldiwan.net/poem58883.html","الكامل"],[216,"فلي كبد ما انفك عنها غليلها","https://www.aldiwan.net/poem37837.html","الطويل"],[240,"لمن الركائب تستقي","https://www.aldiwan.net/poem31796.html","مجزوء الكامل"],[240,"لوت الستون عودي","https://www.aldiwan.net/poem31895.html","مجزوء الرمل"],[325,"نامت وقد لعب الشراب بعطفها","https://www.aldiwan.net/poem61668.html","الكامل"],[327,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[369,"ذكر المعسكر صاحبي ذكرا","https://www.aldiwan.net/poem60913.html","أحذ الكامل"],[396,"يا مريدين السعاده والتعلم والعباده","https://www.aldiwan.net/poem54447.html","عموديه"],[438,"وكأنما مدح الأثير أثارها","https://www.aldiwan.net/poem12736.html","الكامل"],[466,"جرد سيوفك للجلاد وأشهر","https://www.aldiwan.net/poem15128.html","الكامل"],[466,"خل التغزل للمشوق المغرم","https://www.aldiwan.net/poem15296.html","الكامل"],[510,"المفر","https://www.aldiwan.net/poem27797.html","الوافر"],[563,"نور هذا الوجود بالإيمان","https://www.aldiwan.net/poem33844.html","الخفيف"],[563,"طيب محي الدين مسك في الورى","https://www.aldiwan.net/poem33886.html","الرمل"],[563,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[578,"يا من لصبح الشيب كيف تنفسا","https://www.aldiwan.net/poem3649.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138338",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138364",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122531","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122605","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87271","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87135","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87012","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34417","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37893","الخفيف"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35346","الكامل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101983","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64712","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112855","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112854","الكامل"],[1296,"","https://poetry.dctabudhabi.ae/diwan/poem/178094","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108890","الكامل"],[1791,"","https://poetry.dctabudhabi.ae/diwan/poem/113902","الخفيف"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76794","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71080","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48267","الخفيف"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96037","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27823","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2488,"","https://poetry.dctabudhabi.ae/diwan/poem/31476","الكامل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129966","البسيط"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137372",""],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121149","الكامل"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121125","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58440","الخفيف"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104672","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74217","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74178","الرمل"],[3091,"","https://poetry.dctabudhabi.ae/diwan/poem/141754","الكامل"],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70362","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112318","الرمل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129414","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92001","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91200","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91116","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36801","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85157","المتقارب"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114398","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95324","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70162","الكامل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107530","الكامل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78234","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94396","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133141","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83131","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35078","الكامل"],[4858,"أريج مدرسة الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=34591",""],[4119,"أشبا سيوف الهند أم عيناك","https://www.poetsgate.com/ViewPoem.aspx?id=16201",""],[585,"إني وقفت حيال جدةَ مدنفاً","https://www.poetsgate.com/ViewPoem.aspx?id=161973",""],[5212,"قبرُ البدور","https://www.poetsgate.com/ViewPoem.aspx?id=212057",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5542,"شعري وحبي فيكَ يلتقيانِ","https://www.poetsgate.com/ViewPoem.aspx?id=24756",""]],"verses":[["وَعَلَوتَ بي حَتّى مَشَيتُ عَلى","بُسطٍ مِنَ الأَعناقِ وَالقِمَمِ",0,"م",1,0],["وعَلَوا بحيث إذا شَخَصنا نحوهم","من تحتهم ضحكوا علينا من عل",1,"ل",1,0],["وَعَلَونا يَومَ بَدرٍ بِالتُقى","طاعَةَ اللَهِ وَتَصديقَ الرُسُل",2,"ل",1,0],["وعلوم فاضت على الأرض بحراً","هادِياً لم يعف كالبحر سبلا",3,"ل",2,0],["وعلوتُمْ على الخليقة كالها","م وكان الرجالُ كالأقدامِ",4,"م",1,0],["وعلوت نشزا عند حو","ضك قائما وهبطت وهدا",5,"د",2,0],["وعلومه درست وعفّا","ها من الأزمان داثر",6,"ر",1,0],["وَعُلومٌ تُحيِ البِلادَ وَبِنتا","هورُ فَخرُ البِلادِ وَالشُعَراءُ",7,"ا",2,0],["وَعُلُوِّهِ في المَكرُماتِ فَجودُهُ","فيها طَوالَ الدَهرِ فَوقَ وُجودِهِ",8,"د",2,0],["وَعُلُوِّ هِمَّتِكَ الَّتي دَلَّت عَلى","صِغَرِ الكَبيرِ وَقِلَّةِ المُستَكثَرِ",9,"ر",1,0],["وَعلومٍ كَشَفَتْ كلَّ لبْسٍ","وَجَلَتْ عَنْ كلِّ شمسٍ ضَبابا",10,"ب",2,0],["وَعُلوَيُّ أَقدارِهِ جامِعٌ","هِزَبرَ العَرينِ وَعِلجَ الأَبَك",11,"ك",1,0],["وعَلَوْا لِنَيْلِ المَجْدِ كُلَّ مَطِيَّةٍ","لو كانَ نَجْماً في السَّمَاءِ لَطَارُوا",12,"ر",3,0],["وعُلُومٍ تُرْجِمَتْ وَاسْتُنْبِطَتْ","وَفُصُولٍ بَهَرَ الدُّنْيا حِجاها",13,"ا",3,0],["وعلَوْ أرْسِلَ الرّوحُ الأمينُ إلى امرِىءٍ","سَوى الأنْبياءِ المُصْطَفَينَ الأكارِمِ",14,"م",1,0],["وعلوم العرفان في كل طود","ومقام من منطوي أسرارك",15,"ك",1,0],["وعلويُّ الجمالِ إذا تبدى","أراك جبينُهُ بدراً أنارا",16,"ر",2,1],["وَعَلَوتُمُ حَتّى لَقالَ عَدُوُّكُم","أَمُلوكُ أَرضٍ أَم نُجومُ سَماءِ",17,"ا",2,0],["وَعَلَوتَ قَدراً في الوَرى فَليَعتَمِد","صِدقَ الأَلِيَّةِ مَن بِقَدرِكَ آلا",18,"ل",2,0],["وَعَلَوا بِأَن جَعَلوا السُؤالَ وَسيلَةً","وَنَداكَ مُنهَمِرٌ بِغَيرِ سُؤالِ",19,"ل",1,0],["وَعَلوا عَلى شوسِ المُلوكِ بِغَيظِهِم","غَيظِ الوِهادِ عَلى هِضابِ يَلَملَمِ",20,"م",1,0],["وَعَلَوْتَ مِنْ شَرَفِ النِّزَالِ بِمَنْزِلٍ","جَعَلَ الثُّرَيَّا فِي ثَرَاهُ كَمِينا",21,"ن",2,0],["وعلوت أطواق النجومِ فقلن لي","قف حيث شئت فقلت كنَّ ورَائي",22,"ا",2,0],["وَعَلَونَهُنَّ بِكُلِّ أَحوَى قاتِرٍ","كالطِّرفِ لا جافٍ ولاَ مُتَضائِلِ",23,"ل",1,0],["وعلوة مَحْيَائي وروحي وَمَسْكَني","وعلوةُ دُنيائي ونَفْسِي رَسُولُها",24,"ل",3,0],["وَعُلُوَّ جَدٍّ ما لِطا","لِعِهِ المُشَرِّقِ مِن أُفولِ",25,"ل",1,0],["وَعُلُوُّ السِنِّ قَد كَس","سَرَ بِالشَيبِ نَشاطي",26,"ط",2,0],["وَعَلَوتُ مِنهُ أَريكَةَ لَم يُعطِها","كِسرى وَلا مُلكٌ سِواهُ لَها مُلكُ",27,"ك",1,0],["وَعَلَوا كُلَّ عَيهَمٍ دَوسَرِيٍّ","أَرحَبِيٍّ يَبُذُّ وُسعَ الجِمالِ",28,"ل",1,0],["وعلومُ ما يأْتي الزّمانُ به","مكنونةٌ في طَيِّه سِرّا",29,"ر",2,0],["وعلوم الدين حصل","لخلاصك والإفاده",30,"د",2,0],["وعلوّ شأنٍ لو تعاطَى شأوَهُ","كَيوانِ ما ثبتَتْ به القدَمانِ",31,"ن",1,0],["وعلوتُ فوق أولي الجحافل منهمُ","وأقمتُ أقوالي مقامً العسكرِ",32,"ر",1,0],["وعلوت فوق أولي الجحافل منهمُ","وأقمتُ أقوالي مقامَ عرمْرمِ",33,"م",1,0],["وعلّوا فيه ناسينَ بأنّ","بُنى الوهمِ بلا ريحٍ تخرُّ",34,"ر",1,0],["وعلوم الجميع علواً وسفلاً","واردات عن وردة كالدهان",35,"ن",1,0],["وعلوم خرجت من فمه","كل فهم بهداها لا يُلِمُّ",36,"م",1,0],["وعلوم الهوى تقول الهوى جلّْ","أين من كان يدَّعينا فهذا الْ",37,"ل",1,0],["وَعَلَوتُ قَدرَ الناطِقينَ بِشُكرِهِ","وَلَئِن تَمادى في نَداهُ لأَخرَسا",38,"س",2,0],["وعلومه مثل الغيوث هواطلا","لكنها في كل أرض تغدق",39,"ق",1,0],["وعلومه الانوار كل يستضى","بشعاعها ونداه غيث هاطل",40,"ل",1,0],["وعُلُوٌ تمسي السماءُ له أر","ضاً ويُضحي على السماءِ سماءَ",41,"ا",2,0],["وعَلوتُ حتَّى صرتُ أحسَبُ أنَّني","كزُهيرِ أو كزيادِ بن عَتُودِ",42,"د",1,0],["وَعلوّاً وَاِعتَدَلا","ما تَلا مَجدي قَصيدهْ",43,"ه",1,0],["وَعلوّ مَنزلة تَحلَّى جيدُها","بِمَدائحٍ تُتلى بِكُل الأَلسُن",44,"ن",1,0],["وَعلوّ همته وَطيب حديثه ال","مشحون بالآيات وَالأَمثال",45,"ل",1,0],["وَعلومُهُ كالشمسِ ل","كن قَد تنزَّهَ عَن زَوالِ",46,"ل",1,0],["وَعُلومٌ قَد فاقَتِ البحرَ وُسْعاً","وعطاءٌ يفوقُ قطرَ السماءِ",47,"ا",2,0],["وَعَلَوتُ في سَنَدي لِعالي مَجدِهِ","لَمّا رَوَيتُ لَهُ كِتابَ شِفاءِ",48,"ا",2,0],["وعلوماً جماً وذهناً ذكياً","ومقالا فصلا ورأياً سديدا",49,"د",2,0],["وعَلَوْتُ فَخْراً فَوْقَ كلِّ مُمَدِّحٍ","في النّاس حينَ عُدِدْتُ مِنْ مُدّاحِهِ",50,"ح",2,0],["وعلو ونالوا بالمراحم فوق ما","يرجوا وفازوا بالرضاء الامجد",51,"د",1,0],["وعلو قدر مع محبة فنية","شرفوا بخدمته بنية مسعد",52,"د",1,0],["وعلوتَ ما فوق النجوم وسُمَّرت","تحت الحضيض مناكب الأقزامِ",53,"م",1,0],["وعلومك الغر الثواقب حببت","بعظيم فضلك دولة الإعظام",54,"م",1,0],["وعلوتم مناره وبلغتم","بعلاه منازلا لا ترام",55,"م",1,0],["وعلوضٌ وهو ابن آوى عندهم","واللَضْمُ وهو العنفُ مما يُسأمُ",56,"م",1,0],["وعُلوجٌ خُزْمٌ من الحُيْشِ أَحمى","منكمُ عند دعوة المُسْتَغِيرِ",57,"ر",1,0],["وعلومٌ تزاخرتْ عن بحارٍ","تَتَلالا ضوءاً بِحُرِّ الجُمانِ",58,"ن",1,0],["وعلوا بحيث مقامه","يبكي أسى والمنبر",59,"ر",1,0],["وعلوّ قدر العبد فيه خضوعُه","حتى يكون من الخضوع سَفالا",60,"ل",2,0],["وَعُلُوُّهُ فَوقَ الخَليقَة كُلِّهَا","فُطِرَت عَلَيهِ الخَلقُ وَالثَّقَلاَنِ",61,"ن",1,0],["وَعَلَوتُ مُرتَبِئاً عَلى مَرهوبَةٍ","حَصّاءَ لَيسَ رَقيبُها في مَثمِلِ",62,"ل",1,0],["وعُلُوُّ الشهباء حيث استدارت","أنجمُ الأفقِ حولها كالنطاقِ",63,"ق",1,0],["وعلوم لها الأفاضل تعنوا","ساجدات الجباه نجدا وغو