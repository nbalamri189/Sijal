{"poems":[[63,"لك من غليل صبابتي ما أضمر","https://www.aldiwan.net/poem46190.html","الكامل"],[63,"الورد يبسم والركائب حوم","https://www.aldiwan.net/poem46212.html","الكامل"],[77,"يا نسيم الصبا على الأوراق","https://www.aldiwan.net/poem35898.html","الخفيف"],[82,"بحياة ما ضمت عرى الأزرار","https://www.aldiwan.net/poem29396.html","الكامل"],[93,"وفاء كهذا العهد فليكن العهد","https://www.aldiwan.net/poem9845.html","الطويل"],[93,"حجك أرضى ربك العليا","https://www.aldiwan.net/poem11101.html","الرجز"],[83,"ما للعوالم جمعت في قبة","https://www.aldiwan.net/poem54315.html","الكامل"],[83,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[27,"أهاج البرق ليلة أذرعات","https://www.aldiwan.net/poem5663.html","الوافر"],[27,"شعفت بعهد ذكرته المنازل","https://www.aldiwan.net/poem5966.html","الطويل"],[72,"جسمي أبو ذر الضنا فذروني","https://www.aldiwan.net/poem20182.html","الكامل"],[51,"يوم كأن سماءه تحكي جفوني حين بنتا","https://www.aldiwan.net/poem8684.html","مجزوء الكامل"],[51,"ومدامة أغنت عن المصباح","https://www.aldiwan.net/poem9412.html","الكامل"],[51,"غدا الدهر مفترا أغر المضاحك","https://www.aldiwan.net/poem65812.html","الطويل"],[85,"أيها الثغر بلغت الأملا","https://www.aldiwan.net/poem7143.html","الرمل"],[85,"قُل لِاِبنِ سينا لا طَبيب","https://www.aldiwan.net/poem7916.html","مجزوء الرجز"],[85,"قم سابق الساعة واسبق وعدها","https://www.aldiwan.net/poem62977.html","الرجز"],[43,"إنما التهنئات للأكفاء ولمن يدني من البعداء","https://www.aldiwan.net/poem9447.html","الخفيف"],[43,"بأبي الشموس الجانحات غواربا","https://www.aldiwan.net/poem9466.html","الكامل"],[62,"ياقلب ما لك والهوى من بعد ما","https://www.aldiwan.net/poem52334.html","الكامل"],[45,"ما أنت للكلف المشوق بصاحب","https://www.aldiwan.net/poem10671.html","الكامل"],[45,"كلفني فوق الذي أستطيع","https://www.aldiwan.net/poem64668.html","الرجز"],[61,"غداة الشك ندعوك","https://www.aldiwan.net/poem51402.html","الهزج"],[61,"باليمن ما رفع الأمير وشيدا","https://www.aldiwan.net/poem51710.html","الكامل"],[61,"عذر العذول فراح فيك مساعدا","https://www.aldiwan.net/poem51726.html","الكامل"],[61,"مرحبا بالصبوح في الظلماء","https://www.aldiwan.net/poem51824.html","الخفيف"],[66,"دق شوال في قفا رمضان","https://www.aldiwan.net/poem39193.html","الخفيف"],[66,"كرر اللوم عليه إن تشا","https://www.aldiwan.net/poem40645.html","الرمل"],[97,"يا فؤادي رحم الله الهوى","https://www.aldiwan.net/poem25088.html","الرمل"],[44,"وثناياك إنها إغريض","https://www.aldiwan.net/poem30475.html","الخفيف"],[74,"في كل ناد منك روض ثناء","https://www.aldiwan.net/poem12835.html","الكامل"],[67,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[48,"ألا قوموا إلى الكرخ","https://www.aldiwan.net/poem63331.html","الهزج"],[48,"عج بفتيان اصطباحِ","https://www.aldiwan.net/poem66588.html","مجزوء الرمل"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85555","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85359","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39655","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39654","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39552","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21082","البسيط"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21064","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54719","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54904","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54516","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54706","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[51,"يومٌ كأنَّ سماءَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=27192",""],[20,"وبسل ان ارى جارات بيتي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=502547",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"]],"verses":[["وبِسَيْبِهِ وبسِيْفِهِ أعمارُهُمْ","في كُلِّ مُعضِلَةٍ تَطولُ وتَقْصُرُ",0,"ر",1,0],["وبَسَطْتَ كفّاً بالمَواهِبِ ثَرَّةً","سَدِكَ الغَنيُّ بِسَيْبِها والمُعْدَمُ",1,"م",1,0],["وبسَعْدِ الإمامِ تدْنُو الأماني","ويُزَمُّ السّرورُ بعْدَ ائْتِباقِ",2,"ق",1,0],["وبسيحة العليا لنا متنزه","فيه من الأسماع والأبصار",3,"ر",1,0],["وبسطه كف منك في موضع الندى","يعاد بها غمضٌ وينفى بها سهد",4,"د",1,0],["وبسطَها يدُ المُوَاسَاةِ الَّتِي","أَسعدَتِ الحَرِيبَ وَالشَّقِيَّا",5,"ي",2,0],["وبسورة الأنعام كم من آيةٍ","فيها لقارِ بالنَوال مُجَوّدِ",6,"د",1,0],["وبسعدِ مولايَ الإمام محمدٍ","تَعِدُ الأماني أَنْ يتاحَ لقائي",7,"ا",2,0],["وَبِسطامٌ سَما لَهُمُ فَلاقى","لُيوثاً عِندَ أَشبُلِها غِضابا",8,"ب",2,0],["وَبَسطُ يَدِ الحَجّاجِ بِالسَيفِ لَم يَكُن","سَبيلُ جِهادٍ وَاِستُبيحَ الحَلائِلُ",9,"ل",1,0],["وبسين طرَّتها وواقد خدّها","طال التعلل بين قد والسين",10,"ن",1,0],["وَبسطتَ من أمل بوصْل","لِكَ ما بهجري قد قبضتا",11,"ت",2,0],["وبِسَيِّد الأُمراء أُنْجِحَ سعْيُهُمْ","فيما ابتغوا من ذاك أيَّ نجاحِ",12,"ح",1,0],["وبستان بستانٌ يُقِرُّ عيونَنا","بما فيه من نُوَّاره المتضاحك",13,"ك",1,0],["وبسطت الكف أبغى دعوة","يوم تأتي الله أصوات الملا",14,"ل",2,0],["وَبِسِحرِهِ تَعلو الأَسا","فِلُ في العُيونِ وَتَعظُمُ",15,"م",1,0],["وَبَسَطوا عَلى الحِجازِ أَيدَها","وَصَيَّروا العاتِيَ فيهِ عَبدَها",16,"د",3,0],["وَبَساتينُكَ الجِيادُ وَما تَح","مِلُ مِن سَمهَرِيَّةٍ سَمراءِ",17,"ا",2,0],["وَبَسَمنَ عَن بَرَدٍ خَشيتُ أُذيبَهُ","مِن حَرِّ أَنفاسي فَكُنتُ الذائِبا",18,"ب",2,0],["وبساكنيهِ إنِ استقَرَّ بنا النَّوى","تُشْفَى النفوسُ وتُمْسَكُ الأرمَاقُ",19,"ق",1,0],["وَبَسَطتَ لي قَبلَ النَوالِ عِنايَةً","بَسَطَت مَسافَةَ لَحظِيَ المُتَقارِبِ",20,"ب",1,0],["وَبَسطَةٌ مِن طولِهِ لَو خَلا","شِبهٌ لَها صيغَت عَلَيهِ الدُروع",21,"ع",1,0],["وبُسْطُ الرَّوضِ تُغنِيك","عن البُسْطِ نَواحِيها",22,"ي",3,0],["وبساط ريحان كماء زبرجد","عبثت بفصحته الجنوب فأرعدا",23,"د",2,0],["وبسطْتَ آمالَ العُفاةِ بها فقد","حَمدُوا نَداكَ مَصادِراً ومَوارِدا",24,"د",2,0],["وبسُكرَيْنِ من لِحاظِ غَزالٍ","ساحرٍ لحظُه ومن صَهباءِ",25,"ا",2,0],["وَبِساطُ الأَزهارِ كَالوَشيِ وَالغَي","مُ كَثوبٍ مُجَسَّمٍ مِن دُخانِ",26,"ن",1,0],["وَبَسَطتَ الأُنسَ لي في زَمَنٍ","كُنتُ مِن ظِلّي بِهِ مُستَوحِشا",27,"ش",2,0],["وبساطا من ندامى حلم","هم تواروا أبداً وهو انطوى",28,"ط",3,0],["وَبِساطٍ كَأَنَّما الآلُ فيهِ","وَعَلَيهِ سَحلُ المُلاءِ الرَحيضُ",29,"ض",1,0],["وَبَسَطتُ في الغَبراءِ خَدّي ذِلَّةً","أَستَنزِلُ الرُحمى مِنَ الخَضراءِ",30,"ا",2,0],["وبِسَتْرِكَ العَوْراتِ قد كَشفَ الوَرَى","لَكَ بالدُّعاءِ المُسْتَجابِ رُؤُوسا",31,"س",2,0],["وَبُستانٍ لَهُ نَهرٌ","لَدى نَخلٍ وَأَشجارِ",32,"ر",1,0],["وبسُمرٍ من ملاءِ","المشكِ لاسمر الرماحِ",33,"ح",1,0],["وبِسُقُمٍ هِمْتُ بالأجفانِ إنْ","زانَهَا وَصْفاً بِزَيْنٍ وبِزَي",34,"ي",1,0],["وَبَساتين فوقها الطير تشدو","بشجيّ الألحان والنَغمات",35,"ت",1,0],["وَبسطة وَمَكاناً","من الحَياة علِيا",36,"ي",2,0],["وبسحرِ هذا اللون كم غنَّيتَني","وهتفتَ بالشقراءِ والصهباءِ",37,"ا",2,0],["وبسخرياتكَ بي وبسمتِكَ التي","تلقى بها المفضوحَ من إِغوائي",37,"ا",2,0],["وبسمعي همسةٌ منها شجِيّهْ","وبروحي أنتِ يا أندلسيَّهْ",38,"ه",1,0],["وبساطاً من الرمال تراءى","ككتابٍ مموَّهِ الصفحاتِ",39,"ت",1,0],["وبسط الأرض بسطاً ثُمّ قدّرها","تحت السَماء سواءَ مِثل ما فعلا",40,"ل",2,0],["وَبسلٌ أَن أرَى جاراتِ بَيتي","يَجُعنَ وأَن أرَى أَهلي شِبَاعا",41,"ع",2,1],["وَبِسَمْعِه لَحْنُ الْعَشيرَةِ جَامِعَاً","لُغَةَ الأَنِيسِ إِلى لُغَى الأَطْيَارِ",42,"ر",1,0],["وَبِسَعْيِهَا وَثَبَاتِهَا انْ","تَظَمَتْ قُوىً كَانَتْ بَدَادْ",43,"د",1,0],["وَبِسَاحَاتِ جُوِدكَ اتَّحَدَتْ غَا","يَاتُهُمْ فِي طِلابِ أَسْمَى مَصِيرِ",44,"ر",1,0],["وَبَسَمْتُ إِذْ رَجَعَتْ فَقُلْ","تُ كَذَا التِّلَطُّفُ فِي الْعَطَاءْ",45,"ا",2,0],["وَبَسْطَةَ كَفٍّ منْكَ في مَوْضِعِ النَّدَى","يُعَادُ بهَا غَمْضٌ وَيُنْفَي بهَاء سَهْدُ",46,"د",1,0],["وبِساطٌ للشَّاربينَ يُصَلِّي","فيه إِبْريقُهم بلا مِحْراب",47,"ب",1,0],["وَبسطتَ من أمل بوصْ","لكَ ما بهجري قد قبضتا",48,"ت",2,0],["وَبسلٌ أَن أرَى جاراتِ بَيتي","يَجُمعنَ وأَن أرَى أَهلي شِبَاعا",49,"ع",2,1],["وبساط نسيجه الزهر قد ج","رت عليه من الرياح ذيول",50,"ل",1,0]]}