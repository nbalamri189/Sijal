n.net/poem12556.html","الرمل"],[437,"أين الديار فهذه الجرعاء","https://www.aldiwan.net/poem2589.html","الكامل"],[439,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[439,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[443,"أهي الجنة التي وعد الله","https://www.aldiwan.net/poem55987.html","عموديه"],[452,"وبستانا غرست به بقاعا","https://www.aldiwan.net/poem13928.html","الوافر"],[453,"ترفع عن معاداة الكريم","https://www.aldiwan.net/poem61339.html","الوافر"],[458,"لمن الحمول سلكن فلجا","https://www.aldiwan.net/poem56259.html","مجزوء الكامل"],[461,"ومعسول الشمائل من نزار","https://www.aldiwan.net/poem16140.html","الوافر"],[464,"صبر قلبي عان ودمعي طليق","https://www.aldiwan.net/poem3398.html","عموديه"],[464,"طربي إلى ماء الحمى ونزيله","https://www.aldiwan.net/poem3443.html","عموديه"],[464,"عز الجفون وذلة الصبر","https://www.aldiwan.net/poem3484.html","عموديه"],[500,"كل حال لا بد آنا يحول","https://www.aldiwan.net/poem37568.html","الخفيف"],[500,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[515,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[515,"فقت الملوك مهابة وجلالاً","https://www.aldiwan.net/poem12204.html","الكامل"],[529,"لولا ثلاث هن أقصى المنى","https://www.aldiwan.net/poem37434.html","السريع"],[538,"فضلك لا أنساه","https://www.aldiwan.net/poem47510.html","عموديه"],[538,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[551,"أسخطتني فرضيت من كلف","https://www.aldiwan.net/poem48074.html","أحذ الكامل"],[558,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[558,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[558,"أنت قيد الوجود إن غبت غابا","https://www.aldiwan.net/poem34952.html","الخفيف"],[561,"وبلدة بعيدة النياط","https://www.aldiwan.net/poem27843.html","الرجز"],[567,"بي إن عززت علي ذل","https://www.aldiwan.net/poem69530.html","الكامل"],[575,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"],[575,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"],[575,"لنصرك حتى تملك الغرب بالغلب","https://www.aldiwan.net/poem3107.html","الطويل"],[586,"أبدا بذكرك تنقضي أوقاتي","https://www.aldiwan.net/poem17455.html","الكامل"],[586,"قمر يجلو دجى الغلس","https://www.aldiwan.net/poem17971.html","المديد"]],"verses":[["وبِسَيْبِهِ وبسِيْفِهِ أعمارُهُمْ","في كُلِّ مُعضِلَةٍ تَطولُ وتَقْصُرُ",0,"ر",1,0],["وبَسَطْتَ كفّاً بالمَواهِبِ ثَرَّةً","سَدِكَ الغَنيُّ بِسَيْبِها والمُعْدَمُ",1,"م",1,0],["وبسَعْدِ الإمامِ تدْنُو الأماني","ويُزَمُّ السّرورُ بعْدَ ائْتِباقِ",2,"ق",1,0],["وبسيحة العليا لنا متنزه","فيه من الأسماع والأبصار",3,"ر",1,0],["وبسطه كف منك في موضع الندى","يعاد بها غمضٌ وينفى بها سهد",4,"د",1,0],["وبسطَها يدُ المُوَاسَاةِ الَّتِي","أَسعدَتِ الحَرِيبَ وَالشَّقِيَّا",5,"ي",2,0],["وبسورة الأنعام كم من آيةٍ","فيها لقارِ بالنَوال مُجَوّدِ",6,"د",1,0],["وبسعدِ مولايَ الإمام محمدٍ","تَعِدُ الأماني أَنْ يتاحَ لقائي",7,"ا",2,0],["وَبِسطامٌ سَما لَهُمُ فَلاقى","لُيوثاً عِندَ أَشبُلِها غِضابا",8,"ب",2,0],["وَبَسطُ يَدِ الحَجّاجِ بِالسَيفِ لَم يَكُن","سَبيلُ جِهادٍ وَاِستُبيحَ الحَلائِلُ",9,"ل",1,0],["وبسين طرَّتها وواقد خدّها","طال التعلل بين قد والسين",10,"ن",1,0],["وَبسطتَ من أمل بوصْل","لِكَ ما بهجري قد قبضتا",11,"ت",2,0],["وبِسَيِّد الأُمراء أُنْجِحَ سعْيُهُمْ","فيما ابتغوا من ذاك أيَّ نجاحِ",12,"ح",1,0],["وبستان بستانٌ يُقِرُّ عيونَنا","بما فيه من نُوَّاره المتضاحك",13,"ك",1,0],["وبسطت الكف أبغى دعوة","يوم تأتي الله أصوات الملا",14,"ل",2,0],["وَبِسِحرِهِ تَعلو الأَسا","فِلُ في العُيونِ وَتَعظُمُ",15,"م",1,0],["وَبَسَطوا عَلى الحِجازِ أَيدَها","وَصَيَّروا العاتِيَ فيهِ عَبدَها",16,"د",3,0],["وَبَساتينُكَ الجِيادُ وَما تَح","مِلُ مِن سَمهَرِيَّةٍ سَمراءِ",17,"ا",2,0],["وَبَسَمنَ عَن بَرَدٍ خَشيتُ أُذيبَهُ","مِن حَرِّ أَنفاسي فَكُنتُ الذائِبا",18,"ب",2,0],["وبساكنيهِ إنِ استقَرَّ بنا النَّوى","تُشْفَى النفوسُ وتُمْسَكُ الأرمَاقُ",19,"ق",1,0],["وَبَسَطتَ لي قَبلَ النَوالِ عِنايَةً","بَسَطَت مَسافَةَ لَحظِيَ المُتَقارِبِ",20,"ب",1,0],["وَبَسطَةٌ مِن طولِهِ لَو خَلا","شِبهٌ لَها صيغَت عَلَيهِ الدُروع",21,"ع",1,0],["وبُسْطُ الرَّوضِ تُغنِيك","عن البُسْطِ نَواحِيها",22,"ي",3,0],["وبساط ريحان كماء زبرجد","عبثت بفصحته الجنوب فأرعدا",23,"د",2,0],["وبسطْتَ آمالَ العُفاةِ بها فقد","حَمدُوا نَداكَ مَصادِراً ومَوارِدا",24,"د",2,0],["وبسُكرَيْنِ من لِحاظِ غَزالٍ","ساحرٍ لحظُه ومن صَهباءِ",25,"ا",2,0],["وَبِساطُ الأَزهارِ كَالوَشيِ وَالغَي","مُ كَثوبٍ مُجَسَّمٍ مِن دُخانِ",26,"ن",1,0],["وَبَسَطتَ الأُنسَ لي في زَمَنٍ","كُنتُ مِن ظِلّي بِهِ مُستَوحِشا",27,"ش",2,0],["وبساطا من ندامى حلم","هم تواروا أبداً وهو انطوى",28,"ط",3,0],["وَبِساطٍ كَأَنَّما الآلُ فيهِ","وَعَلَيهِ سَحلُ المُلاءِ الرَحيضُ",29,"ض",1,0],["وَبَسَطتُ في الغَبراءِ خَدّي ذِلَّةً","أَستَنزِلُ الرُحمى مِنَ الخَضراءِ",30,"ا",2,0],["وبِسَتْرِكَ العَوْراتِ قد كَشفَ الوَرَى","لَكَ بالدُّعاءِ المُسْتَجابِ رُؤُوسا",31,"س",2,0],["وَبُستانٍ لَهُ نَهرٌ","لَدى نَخلٍ وَأَشجارِ",32,"ر",1,0],["وبسُمرٍ من ملاءِ","المشكِ لاسمر الرماحِ",33,"ح",1,0],["وبِسُقُمٍ هِمْتُ بالأجفانِ إنْ","زانَهَا وَصْفاً بِزَيْنٍ وبِزَي",34,"ي",1,0],["وَبَساتين فوقها الطير تشدو","بشجيّ الألحان والنَغمات",35,"ت",1,0],["وَبسطة وَمَكاناً","من الحَياة علِيا",36,"ي",2,0],["وبسحرِ هذا اللون كم غنَّيتَني","وهتفتَ بالشقراءِ والصهباءِ",37,"ا",2,0],["وبسخرياتكَ بي وبسمتِكَ التي","تلقى بها المفضوحَ من إِغوائي",37,"ا",2,0],["وبسمعي همسةٌ منها شجِيّهْ","وبروحي أنتِ يا أندلسيَّهْ",38,"ه",1,0],["وبساطاً من الرمال تراءى","ككتابٍ مموَّهِ الصفحاتِ",39,"ت",1,0],["وبسط الأرض بسطاً ثُمّ قدّرها","تحت السَماء سواءَ مِثل ما فعلا",40,"ل",2,0],["وَبسلٌ أَن أرَى جاراتِ بَيتي","يَجُعنَ وأَن أرَى أَهلي شِبَاعا",41,"ع",2,1],["وَبِسَمْعِه لَحْنُ الْعَشيرَةِ جَامِعَاً","لُغَةَ الأَنِيسِ إِلى لُغَى الأَطْيَارِ",42,"ر",1,0],["وَبِسَعْيِهَا وَثَبَاتِهَا انْ","تَظَمَتْ قُوىً كَانَتْ بَدَادْ",43,"د",1,0],["وَبِسَاحَاتِ جُوِدكَ اتَّحَدَتْ غَا","يَاتُهُمْ فِي طِلابِ أَسْمَى مَصِيرِ",44,"ر",1,0],["وَبَسَمْتُ إِذْ رَجَعَتْ فَقُلْ","تُ كَذَا التِّلَطُّفُ فِي الْعَطَاءْ",45,"ا",2,0],["وَبَسْطَةَ كَفٍّ منْكَ في مَوْضِعِ النَّدَى","يُعَادُ بهَا غَمْضٌ وَيُنْفَي بهَاء سَهْدُ",46,"د",1,0],["وبِساطٌ للشَّاربينَ يُصَلِّي","فيه إِبْريقُهم بلا مِحْراب",47,"ب",1,0],["وَبسطتَ من أمل بوصْ","لكَ ما بهجري قد قبضتا",48,"ت",2,0],["وَبسلٌ أَن أرَى جاراتِ بَيتي","يَجُمعنَ وأَن أرَى أَهلي شِبَاعا",49,"ع",2,1],["وبساط نسيجه الزهر قد ج","رت عليه من الرياح ذيول",50,"ل",1,0],["وَبِسُلوان حُبِهِ","قط ما هَم أَو نَوى",51,"و",2,0],["وَبِسحر ناظِرِهِ الَّذي","هاروت عَنهُ بِمَرصِدِ",52,"د",1,0],["وبسر من نفحة الغيب تغنى","عن فنون الوعاظ والقصاص",53,"ص",1,0],["وبساحة هجرك تطلقه","وبقيد الوجد تقيده",54,"د",2,0],["وبسر الشفاء داركت ايو","ب وقد كان مجهد الادواء",55,"ا",2,0],["وبسر ابن الرفاعي أصبحت","مأمناً وهي تسر الناظرين",56,"ن",1,0],["وبسيدي النبيو غوث زمانه","منجي أسير الذل من أغلاله",57,"ل",2,0],["وبستان إسمعيل لما اشتريته","بقصر وقد أرهته الخط والختما",58,"م",2,0],["وبسر مولانا الحسين وآله","المنح حل بنا وبوعدت المحن",59,"ن",1,0],["وبسكنهُ في جنةِ الخلدِ خالداً","بعيشِ هنىٍّ طيبِ العُمرِ دائمِ",60,"م",1,0],["وبسط الثرَى باللؤلؤِ الرطبِ نَسْجُها","وجُدْرُك تُبْنَى من لُجَينٍ وعَسْجَدِ",61,"د",1,0],["وَبِسحرِ منطِقكَ الَّذي سُلْطانُهُ","حُكمٌ يَجورُ على القلوبِ ويَعْتَدي",62,"د",2,0],["وَبسفرِ الزبورِ أقوى دليلٍ","وَأشاعَ البُشرى به شعياءُ",63,"ا",2,0],["وَبسُمرِ الخطّ البراءةُ خطّت","كَتَبتها الكتيبةُ الخضراءُ",63,"ا",2,0],["وبسقمي حين اضحى شاعرا","رحت معنى في الهوى مبتذلا",64,"ل",2,0],["وبَسَمْن عن كالدُّرّ أَلْعَسَ أَشْنَبٍ","وَسَفَرْنَ عن كالشمس تحتَ ظلامِ",65,"م",1,0],["وبساطٍ من الحديث تبدّى","كنباتِ النِسْرين بين البَهَار",66,"ر",1,0],["وَبِساطِحِ الأَرضِ المِها","دِ وَرافِعِ السَبعِ الطَرائِق",67,"ق",1,0],["وَبِسَيفِهِ المَسلولِ صِن","وِ نَبِيَّهِ خَيرِ الخَلائِق",67,"ق",1,0],["وَبِسُطُوعِ سَناً مِنْ صُبْحِ غُرَّتِهِ","يَنْقَشِعُ الْمُظْلِمَانِ الْحِقْدُ وَالْحَسَكُ",68,"ك",1,0],["وبسائر الأحزاب أهل الارتقا","والتابعين وتابعيهم سرمدا",69,"د",2,0],["وبسرٍّ عنّا قد غمضا","وبنورٍ فيه الكون أضا",70,"ض",2,0],["وبسرّ الإسم الأعظم مَن","تاليه علا أعلى الدرج",71,"ج",1,0],["وبسيّدنا الفاروق كذا","عثمان عليٍّ ذاكي النفج",71,"ج",1,0],["وبسمتُها لو كان للصبحِ مثلُها","لحدَّثَ ليلي أن يحُولَ ويقصرا",72,"ر",2,0],["وبسيفِ هرثمةِ بن أعينَ فاخري","كلّ السيوف فإنهُ مقداد",73,"د",1,0],["وبسيف مسلمةٍ وسيف قتيبةٍ","وبصارمِ الحجّاجِ ذاك الغول",74,"ل",1,0],["وَبساطَ القبول عنهم طويتُ","زعم اللائمُ الَّذي قد تعنّى",75,"ن",2,0],["وَبُستانَ ذي ثَورَينِ لا لينِ عِندَهُ","إِذا ما طغى ناطورُهُ وَتَغَشمَرا",76,"ر",2,0],["وبسيطي أحمد والسيد ال","عابد الأواه إمداد سرت",77,"ت",1,0],["وبسيطهم وحفيدهم وسليلهم","الشيخ محي الدين عبد القادر",78,"ر",1,0],["وَبِسطِ مِهادِ العدلِ تحتَ ظِلالهِ","وَسحِّ عهادِ الفضلِ أَحواله صوبا",79,"ب",2,0],["وَبِسطامَ تَغَمَّطَ وَالمُثَنّى","بِهِ فُضَّت مِنَ الفُرسِ الجُنودُ",80,"د",1,0],["وَبِسَميِّ الجدّ نِلت المُنى","سَميّ فاروق الهُدى وَالأَمان",81,"ن",1,0],["وبسَيفٍ من مائهِ كُلُّ وادٍ","وبتُرْسٍ من عُشْبها كُلُّ تَلْعه",82,"ع",2,0],["وبَسطْتَ كفّك بالنّوالِ فطَبّقتْ","بالجودِ تَطبيقَ الغمامِ المُمْطِر",83,"ر",1,0],["وبسابقٍ لي منكَ وَعْدٌ سابقٌ","فتُرى إلامَ تَلِجُّ في إبطائه",84,"ا",3,0],["وَبَسَطتُ عُذري حينَ لَم أُدرِك لَكُم","وَصفاً وَكانَ العَجزُ لي إِدراكا",85,"ك",2,0],["وَبَسطاً لِعُذري في المَقالِ فَإِنَّها","خَواطِرُ مَفروطٍ وَأَفكارُ إِفراطِ",86,"ط",1,0],["وَبِسحر جفنك قَد تملكت الوَرى","وَحكمت فيهُم فَالقُلوب قُلوبَهُ",87,"ب",2,0],["وَبَسلٌ أَن تَرى فيهِم كَمِيّاً","كَبا لِيَدَيهِ إِلّا فيهِ فوقُ",88,"ق",1,0],["وبَسَالةٍ أغنتْهُ عَن حَمْلِ القنا","تُوهي القُوى وتفتّ في الأعضادِ",89,"د",1,0],["وبسَعْيكمُ رُمي الحُسَينُ وأهلُه","بكتائبٍ غُصّتْ بها الآفاقُ",90,"ق",1,0],["وَبَسمنَ عَن بَردٍ هَمَمتُ بِرَشفه","لَولا الحَياءُ وَخشية الرَحمَنِ",91,"ن",1,0],["وَبَسمن عَن بَرد تَآلف نظمه","فَرَأيت ضوءَ البَرقِ مِنهُ لآحا",92,"ح",2,0],["وبستانٌ زها شرفاً وحسناً","بزورة كوكب الشرف البشير",93,"ر",1,1],["وبسعده وبمجده وبصيده","عزٌّ وفوزٌ مع حجال تزدري",94,"ي",1,0],["وبسلم يروي الظميّ بوكف","وبكف يروي ظمي الصقال",95,"ل",1,0],["وبَسْطَةٌ يرتقي عثمانُ هَضْبَتَها","رُقِيَّ عثمانَ إِلا ساعة الزَّلَقِ",96,"ق",1,0],["وَبَسَطْتُ كفِّي