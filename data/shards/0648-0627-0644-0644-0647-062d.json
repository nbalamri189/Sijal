{"poems":[[79,"روع بالي وهاج بلبالي","https://www.aldiwan.net/poem36366.html","المنسرح"],[53,"كفي الدموع وإن كان الفراق غدا","https://www.aldiwan.net/poem10879.html","البسيط"],[48,"سمى ابنه أسدا وليس بآمن","https://www.aldiwan.net/poem22104.html","الكامل"],[48,"الناس مختلفون قيل المرء لا","https://www.aldiwan.net/poem22763.html","الكامل"],[48,"أعوذ بالله من قوم إذا سمعوا","https://www.aldiwan.net/poem23558.html","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142053","المجتث"],[113,"من أي مولى ارتجي","https://www.aldiwan.net/poem16183.html","مجزوء الرمل"],[266,"هنئت بالإكرام والإعزاز","https://www.aldiwan.net/poem38261.html","الكامل"],[280,"حسب الوجود على التأييد برهانا","https://www.aldiwan.net/poem25507.html","البسيط"],[325,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[478,"يا من به أنا مغرم","https://www.aldiwan.net/poem4119.html","مجزوء الكامل"],[563,"من يعرف الله فليس يسأل","https://www.aldiwan.net/poem34250.html","الرجز"],[563,"يا عابدا ربا بتصويره","https://www.aldiwan.net/poem34459.html","السريع"],[563,"أحزاننا بلقائكم أفراح","https://www.aldiwan.net/poem34674.html","الكامل"],[563,"جئنا بحكم التجلي قرية الفيجه","https://www.aldiwan.net/poem34684.html","المواليا"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34405","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62651","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136324","الكامل"],[1404,"","https://poetry.dctabudhabi.ae/diwan/poem/34866","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71060","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104692","الكامل"],[2272,"","https://poetry.dctabudhabi.ae/diwan/poem/131431","الكامل"],[2888,"","https://poetry.dctabudhabi.ae/diwan/poem/46729","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108134","البسيط"],[4858,"ومن المساجد ينبع الظفر","https://www.poetsgate.com/ViewPoem.aspx?id=37236",""],[4924,"الكرامة","https://www.poetsgate.com/ViewPoem.aspx?id=34876",""],[592,"علماً بأن النقل نقل ثابت","https://www.poetsgate.com/ViewPoem.aspx?id=128723",""],[5376,"أيْ وطني هل حُلْمُنا راموا","https://www.poetsgate.com/ViewPoem.aspx?id=191735",""],[5608,"إنتِ من جِدّك","https://www.poetsgate.com/ViewPoem.aspx?id=32979",""],[6101,"بشرى السماء / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120279",""]],"verses":[["وَاللَّهِ حُزْنِي لاَ كَانَ بَعْدُ عَلَى","ذَاكَ الشَّبَابِ الْجَدِيدِ بِالْبَالِي",0,"ل",2,0],["واللَّه حلّاه إياها ليحْمِيَهُ","عيناً تصيب وكفّاً تعقد العُقدا",1,"د",2,0],["وَاللَهُ حَقٌّ وَاِبنُ آدَمَ جاهِلٌ","مِن شَأنِهِ التَفريطُ وَالتَكذيبُ",2,"ب",1,0],["وَاللَهُ حَقٌّ مَن تَدَبَّرَ أَمرَهُ","عَرَفَ اليَقينَ وَآنَسَ الإِعجازا",3,"ز",2,0],["وَاللَهُ حَقٌّ وَإِن ماجَت ظُنونُكُمُ","وَإِنَّ أَوجَبَ شَيءٍ أَن تُراعوهُ",4,"ع",3,0],["والله حلفضةِ حرٍّ","يرى المعالي غلابا",5,"ب",2,0],["وَاللَهُ حَيٌّ رازِقٌ","يُعطي الجَزيل لمُرتَجي",6,"ج",2,0],["والله حلاك المحامد في الورى","والحمد أفخر حلة وطراز",7,"ز",1,0],["واللَّهُ حَسْبُكَ لا الأَفْرَاسُ عادِيَةً","بالرِّيحِ ضَبْحاً ولا الفُرْسَانُ شُجْعانا",8,"ن",2,0],["وَاللَهُ حَبا لَهُ كَرَرتَ مِدحَتُهُ","وَاللَهُ حَبا لَهُ تَشتاقُ مِدحَتُهُ",9,"ت",2,0],["واللَه حسبي مَن يَعو","قك إنما هي أسهُم",10,"م",1,0],["والله حيث الشر عنه يهمل","يهمل عن عارفه لا يحمل",11,"ل",1,0],["والله حق والسوى باطل","فاحذر من العقل وتزويره",12,"ر",2,0],["والله حلفة مغرم يشكو النوى","لا ذنب للعشاق إن غلب الهوى",13,"ه",3,0],["والله حافظنا في كل تعويجه","حتى شهدنا لضيق الأمر تفريجه",14,"ه",1,0],["واللَهُ حفّك مِنهُ باللطفِ الخَفي","وَالعسكر المَنصور بِالنَصر الجلي",15,"ل",2,0],["والله حدَّ لدينه","حدّاً فلا تَعدُ الحريمْ",16,"م",1,0],["والله حسبي لم يزل احسانه","متواتر وهو الكريم المنعم",17,"م",1,0],["وَاللَهِ حِلفَةَ صادِقٍ","وَبِقَبرِ أَحمَدَ وَالحَرَم",18,"م",1,0],["والله حِلْفَةَ صادِقٍ إِنْ لم تَطِبْ","وتَكُفَّ من دَنَسِ العيوب وتَطْهُرِ",19,"ر",1,0],["وَاللهُ حافِظُهُ بأَعيُنِهِ الَّتى","أَجرَى بِها فُلكاً بِنُوحٍ إِذ نَظَر",20,"ر",1,0],["واللّه حسبي والمؤيد ربنا","وهو المعين على الأمور كما ضمن",21,"ن",1,0],["وَاللَهُ حَسبُكُمُ وَحَسبي أنَّهُ","حَسبُ المُنيبِ القانِتِ المُستَغفِرِ",22,"ر",1,0],["والله حين جرت في مسمعي نعشت","روحي واشجت كعودٍ فوقه ضربوا",23,"ب",3,0],["وَاللهُ حَسْبي أَسْتَجيرُ بِهِ","وَبِهِ يَطيبُ الوِرْدُ والصَّدَرُ",24,"ر",1,0],["والله حرام تكون حلو الوصايف","حلوالوصايف غير يا منقض جروح",25,"ح",1,0],["والله حرم مكث من هو مسلم","في كل أرض حلها الكفار",26,"ر",1,0],["والله حسبُنا كفانا به","مهما علتْ بالشركِ أصنامُ",27,"م",1,0],["والله حاله ما بقى الا انتِ توريني العنا","وتيجي وحده مثلك انتِ تنقد ابياتي وتهين",28,"ن",1,0],["والله حرضنا جهادا دائما","من أجل إسلام لنا ولواء",29,"ا",2,0]]}