{"poems":[[85,"هنيئا هنيئا لا نفاد لعده","https://www.aldiwan.net/poem54317.html","الطويل"],[90,"ذهبت لحي في فروق تزاحمت","https://www.aldiwan.net/poem44452.html","الطويل"],[90,"مني إلى مصر ذات المجد والحسب","https://www.aldiwan.net/poem44801.html","البسيط"],[90,"ألا خلياني في الكلام من السجع","https://www.aldiwan.net/poem44972.html","الطويل"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[23,"ألا أبلغ أبا قيس رسولا","https://www.aldiwan.net/poem21381.html","الوافر"],[23,"ألا من مبلغ عني أبيا","https://www.aldiwan.net/poem21588.html","الوافر"],[93,"ليطرب من شاء أن يطربا","https://www.aldiwan.net/poem8759.html","عموديه"],[34,"شهدت بأني لم تغير مودتي","https://www.aldiwan.net/poem27813.html","الطويل"],[64,"فؤاد على كر الحوادث مارد","https://www.aldiwan.net/poem52454.html","الطويل"],[63,"أرى همة تختال بين الكواكب","https://www.aldiwan.net/poem51785.html","الطويل"],[46,"إن شئت أتبعت إحسانا بإحسان","https://www.aldiwan.net/poem30332.html","البسيط"],[46,"يد الشكوى أتتك على البريد","https://www.aldiwan.net/poem30533.html","الوافر"],[48,"توافقت اليهود مع النصارى","https://www.aldiwan.net/poem22998.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42672","الطويل"],[52,"تحمل الظاعنون فادلجوا","https://www.poetsgate.com/ViewPoem.aspx?id=21624",""],[92,"يدي هذه رهن","https://www.poetsgate.com/ViewPoem.aspx?id=179108",""],[159,"قومي امزجي الكأس باللجين","https://www.aldiwan.net/poem55514.html","مخلع البسيط"],[276,"ذروني أبكي بعد جيرة ثهمد","https://www.aldiwan.net/poem52052.html","الطويل"],[342,"نظرت وسهب من بوانة بيننا","https://www.aldiwan.net/poem45425.html","الطويل"],[385,"أرى السحر ما توحيه أجفانه المرضى","https://www.aldiwan.net/poem48828.html","الطويل"],[445,"أهنيكما ما يهنئ الدين منكما","https://www.aldiwan.net/poem34766.html","الطويل"],[473,"أيا من لا أمل له ارتشافا","https://www.aldiwan.net/poem59874.html","الوافر"],[473,"لأحسن من مصافحة الصفاح","https://www.aldiwan.net/poem60291.html","الوافر"],[541,"أشاقتك أطلال بوجرة درس","https://www.aldiwan.net/poem23852.html","الطويل"],[549,"سقياك يا والد النهرين","https://www.aldiwan.net/poem67249.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83311","الطويل"],[1149,"","https://poetry.dctabudhabi.ae/diwan/poem/67703","الوافر"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79524","الطويل"],[1635,"","https://poetry.dctabudhabi.ae/diwan/poem/145451","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53048","الطويل"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10466","الوافر"],[2798,"","https://poetry.dctabudhabi.ae/diwan/poem/144166","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58278","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74246","البسيط"],[3366,"","https://poetry.dctabudhabi.ae/diwan/poem/28325","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59499","الرجز"],[4984,"بشرى العيد","https://www.poetsgate.com/ViewPoem.aspx?id=189552",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5850,"نظرتُ وسهبٌ من بوانة َ بيننا","https://www.poetsgate.com/ViewPoem.aspx?id=19710",""]],"verses":[["فقد لاح بدر التم في أفق العلا","وحلَّ كما يرضى منازل سعدهِ",0,"د",2,0],["فقد لامني لما رآني بحيّهم","فتىً منه قحف الرأس ممتلئ حمقا",1,"ق",2,0],["فقد لعمري افترقنا شرّ مفتَرَق","وقد لعمري انقلبنا شرَّ منقَلَب",2,"ب",1,0],["فقد لا يُرَوّينا السحاب بمائه","وأن كان فيه البرق متصل اللمع",3,"ع",1,0],["فَقَد لَقَّحتُمُ وأَبيِ أَبِيكُم","حَوَائِلَ فَانظُرُوا مَا تُنتِجُونَا",4,"ن",2,0],["فَقَد لاقاكَ قَبلَ بُعاثَ قَتلٌ","وَبَعدَ بُعاثَ ذُلٌّ مُستَكينُ",5,"ن",1,0],["فَقَد لاقَتكَ طَعنَةُ ذي حِفاظٍ","كَريمِ البَيتِ لَيسَ بِذي فُجورِ",6,"ر",1,0],["فَقَد لَبَّسوكَ لِكَي يَخلَعوكَ","كَما تَخلَعُ القَدَمُ الجَورَبا",7,"ب",2,0],["فَقَد لانَ أَيّامَ الصِبا ثُمَّ لَم يَكَد","مِنَ الدَهرِ شَيءٌ بَعدَهُنَّ يَلينُ",8,"ن",1,0],["فقد لفحتْهُ الهُوجُ وهي سَمائِمٌ","كما نفحَتْهُ النُّكْبُ وهي صَوارِدُ",9,"د",1,0],["فقد لَبِسَت خُضْرَ الغَلائلِ وانثنَت","لها مُرجَحِنَّاتٌ بخُضْرِ الشَّواربِ",10,"ب",1,0],["فَقَد لَعَمري فَتَقتَ الماءَ مِن حَجَرٍ","في هَضبَةٍ وَهَصَرتَ الغُصنَ لِلجاني",11,"ن",2,0],["فَقَد لاذَت بِكَ الآمالُ مِنّي","كَما لاذَ الوَرى بِاِبنِ الرَشيدِ",12,"د",1,0],["فَقَد لاحَت مَخايِلُ صادِقاتٌ","تَروقُ العَينَ بِاللَمعِ الوِلافِ",13,"ف",1,0],["فَقَدْ لا يُفِيدُ الْقَوْلُ نُصْحَاً وَحِكْمَةً","إِذَا حَالَ مِنْ دُونِ الْقَرِيضِ جَرِيضُ",14,"ض",1,0],["فَقَدْ لَهَوْنَا فِي ظِلِّ ..","والدهر فيه القوام والعوج",15,"ج",1,0],["فقد لعِبَت كفُّ التذبذب دورَها","به واستباحت منه كلَّ مُحرَّم",16,"م",1,0],["فَقَدْ لَعَمْري أَقَرَّ مِنِّي","هِلالُ شَوَّال كُلَّ عَيْنِ",17,"ن",1,0],["فَقَد لاحَ لي تحت السَتائر طلعة","أَذابَت بنور الحسن قَلبي وأكبدي",18,"د",2,0],["فَقَد لَصِقَت مِنها البُطونُ وَتارَةً","لَهُ حينَ يَستَولي بِهِنَّ نَهيقُ",19,"ق",1,0],["فَقَد لَحِقَ مِنهُ البَطنُ بِالصُلبِ غَيرَةً","لَهُ حينَ يَستَولي بِهِنَّ نَهيقُ",19,"ق",1,0],["فَقَد لاحَ مِن ثَغر الصَباح اِبتِسامة","أَحَسَ بِها جِفنُ الغَمامة فَارفضّا",20,"ض",2,0],["فقد لَبِسْتَ بُرْدَ الوفاءِ وَقَلَّدَتْ","ترائبَها عِقْدَ الوفاءِ مُنَظَّما",21,"م",2,0],["فَقَد لبِسَت عَروسُ الأَرضِ فَاِعمَل","عَلى أَلّا تَفَوِّتِها زِفافا",22,"ف",2,0],["فَقَد لاحَت مِنَ الأَشجارِ غُلفٌ","مُفَتَّحَةٌ عَنِ المُلَحِ المِلاحِ",23,"ح",1,0],["فَقَد لاحَ لِلسّاري الصَباحُ فَأَبصَرَت","عُيونٌ لَكُم كادَت عَنِ الحَقِّ تُطمَسُ",24,"س",1,0],["فقد لقيتُكَ في عينِ المها غَزَلاً","وفي عيونِ المنايا أسيفاً وقَنَا",25,"ن",2,0],["فَقَد لَبِثَت مِن بَعدِ ذاكَ جُيوشُهُم","تَعَرَّضَ دَهراً لِلفِرنجِ وَتَنبَري",26,"ر",2,0],["فَقدْ لاَقَى أبا حَسَن عَلِيّا","فآبَ الوائلّي مَآبَ خازِي",27,"ز",2,0],["فقد لبَّسَ السنجابَ غيمٌ مطبَّقٌ","وألبَسَ وجهَ الأرضِ منهُ الحواصِلا",28,"ل",2,0],["فقد لغبوا ولا قوا في سراهم","ليالي دعبل في جرجرايا",29,"ا",3,0],["فقد لاح بالملك العزيز محمد","صباح هدىً كنَّا زماناً نراقبه",30,"ب",2,0],["فَقَد لَحِقَ الأَسافِلُ بِالأَعالي","وَماجَ اللُؤمُ وَاِختَلَطَ النِجارُ",31,"ر",1,0],["فقد لمّ أشتاتَ المكارمِ بعدَهم","أغرُّ كريمُ الأصلِ فتكتُه بِكرُ",32,"ر",1,0],["فقد لَهَثَتْ عندي القطايفُ غلَّةً","عليه وابدَتْ ألسُناً للظّما حَرَّى",33,"ر",2,0],["فَقَد لَبست دُروعاً مِن مَحبته","إِذا أدرعت فَلا تَسأَل عَن الأَسَل",34,"ل",1,0],["فَقَد لاقَت الغِزلانُ مِنّي بلية","وَقَد لاقَت الغيلانُ مِنّي الدَّواهِيا",35,"ي",2,0],["فقد لقيتَ العزَّ عن مَلامي","ولا تُطع البُغضِ في اخترامي",36,"م",2,0],["فقد لا تجود الليالي تباعا","فطبع الزمان عطاء وحظر",37,"ر",1,0],["فقد لقحت حرب عوان وتأمت","وقد أرهفت منا المحددة الظما",38,"م",2,0],["فقد لاح للعينين كيفية النفود في","العالم الأسنى وأرض الطبيعتي",39,"ت",2,0],["فقد لاقَ منهُ البطنُ بالصُّلبِ غَيْرة ً","لهُ حينَ يَسْتَوْلي بِهنَّ نهيقُ",40,"ق",1,0]]}