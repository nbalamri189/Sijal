,"أطعت النهى في نجدتي وبياني","https://www.aldiwan.net/poem15465.html","الطويل"],[482,"با أدمعي في رسمها الجاري","https://www.aldiwan.net/poem15193.html","الرجز"],[500,"لو كان بالدهر لحر يدان","https://www.aldiwan.net/poem10281.html","السريع"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126687","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48735","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63971","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25326","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100954","الخفيف"],[1829,"","https://poetry.dctabudhabi.ae/diwan/poem/130584","الطويل"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110314","الخفيف"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67965","الرجز"],[2483,"","https://poetry.dctabudhabi.ae/diwan/poem/144364","الطويل"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100443","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94156","الخفيف"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129343","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91193","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205904","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216790","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135737","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102929","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136927",""],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81292","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83156","الخفيف"],[4755,"رسالة من تحت النار","https://www.poetsgate.com/ViewPoem.aspx?id=196865",""],[4984,"نَشِيدُ النَّصْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=197045",""],[5041,"إنَّما العارُ أنْ يَهونَ السِّلاحُ","https://www.poetsgate.com/ViewPoem.aspx?id=24394",""],[5155,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=176566",""],[5212,"مملكة النّمل","https://www.poetsgate.com/ViewPoem.aspx?id=212581",""],[5277,"أغنية الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=185432",""],[5277,"وقفةٌ على الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=194356",""],[470,"يا سيدى المتنبى","https://www.poetsgate.com/ViewPoem.aspx?id=63453",""],[5704,"موكب الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=191696",""],[5749,"يا طاري الجفا","https://www.poetsgate.com/ViewPoem.aspx?id=29661",""],[6046,"أيها الخائفون...شكراً","https://www.poetsgate.com/ViewPoem.aspx?id=36245",""],[5126,"متى أعيش؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87816&r=&rc=31",""]],"verses":[["مَوكِبُ الدَفنِ خَلفَ نَعشِكَ يَمشي","في اِحتِسابٍ وَحَسرَةٍ وَاِنتِحابِ",0,"ب",1,0],["مَوكِبٌ ماجَ جانِباهُ بِحَفلٍ","مِن وُفودِ الأَخلاقِ وَالأَحسابِ",0,"ب",1,0],["موكرة من حيث لم يرج مخلف","مطائط صيفيَّ الأضا وسمالها",1,"ل",3,1],["موكل بنقيَّات الأمور له","إلى العلى عزمٌ لا وانٍ ولا وَكل",2,"ل",1,0],["موكِبُ الشِعرِ حَرَّكَ المُتَنَبّي","في ثَراهُ وَهَزَّ مِن حَسّانِه",3,"ن",2,0],["مُوَكَّلَةٍ بِالأَرضِ تَنسابُ في الثَرى","فَيَحيا وَتَجري في البِلادِ فَتُخضِبُ",4,"ب",1,0],["مُوَكَّلَةً بِالدُرِّ خَرساءَ قَد بَكى","إِلَيهِ مِنَ الغَواصِ مِنها نَذيرُها",5,"ر",3,0],["مُوَكِّلاً بِيَفاعِ الأَرضِ يُشرِفُهُ","مِن خِفَّةِ الخَوفِ لا مِن خِفَّةِ الطَرَبِ",6,"ب",1,0],["مُوَكَّلٌ بِحُقوقِ المُلكِ يَحفَظُها","بِالمَجدِ وَالجِدِّ حِفظَ الشُكرِ لِلنِعَمِ",7,"م",1,0],["مُوَكَّلٍ بِالصِبا يَعصي عَواذِلَهُ","لَهُ حُمَيدَةُ رَهنٌ غَيرُ مَردُودِ",8,"د",1,0],["مُوَكَّلٌ بِالمَساحي في جَداوِلِها","حَتّى يَدُلَّ عَلَيها حَيَّةُ الماءِ",9,"ا",2,0],["مَوْكِبٌ قد خفَقَت أعلامهُ","وعلت فوقَ مَناطِ الفرقديْنْ",10,"ن",1,0],["مَوْكِبٌ لم يَنَلْهُ رَمْسِيسُ ذو التَّا","جَيْن في عَصْرِهِ ولا خُلَفاؤه",11,"ا",3,0],["مَوْكِبٌ يجمعُ الشعوبَ وتمشي","تحت أعلامِهِ العُصورُ الأَوالي",12,"ل",2,0],["مَوْكِبٌ يَبْهَرُ الشُّمُوسَ وَمَجْدٌ","حَمْلَقَ الدهْرُ مُذْ رَآهُ سُمُودا",13,"د",2,0],["موكب من مشاعل إنطفى الحسّاد","من نفخه وزاد اشتعالا",14,"ل",2,0],["موكب الشعر تائه في فضاء","ليس فيه سوى حطيم سلاحك",15,"ك",1,0],["موكل بِالسَماءِ ناظِرُهُ","يَحسب البَدر مِن ضياك شبه",16,"ه",1,0],["مَوكِبَ المُقسِمينَ أن يأخذوا الحَقَّ","بحدِّ السيوفِ أو يَتَفانوا",17,"ن",3,0],["مَوكِبَ الظافرينَ ذا مَوكِبُ الحُبِّ","تُلاقيكُمُ عليه الحِسانُ",17,"ن",1,0],["مُوَكَّلةٌ بالبُخلِ مَا عَقدُ حَبلِهَا","بِبَاقٍ وَلاَ مَعرُوفُها بِجَزِيلِ",18,"ل",1,0],["مُوَكَّلٌ طرفُه بطرفي","كأنَّه كاتبُ الذنوبِ",19,"ب",1,1],["موكبُ من عرائِس الجِنِّ يَمشي","لِلِقاءِ الشَيطانِ في إِيوانِه",20,"ن",2,0],["مُوَكِّلُ الْجُوْرِ بِالأَحْرارِ يَقْصِدُهُمْ","كَأَنَّهُ عِنْدُهُمْ طَلاّبُ أَوْتارِ",21,"ر",1,0],["موكب للوزير يقصر عنه الطرف","غمر الأسى رهيبُ الجلال",22,"ل",1,0],["مُوكّلاً باللّيالي جُودُ أَنمُلِه","فكلّما كسَرتْ من فاضلٍ جَبَرا",23,"ر",2,0],["موكَّلٌ بِنَبات الخَيرِ يَحصُدُهُ","وَلا يَرى مِن صَوابِ الأي يَزرَعُهُ",24,"ع",2,0],["مُوكَّلةٌ في سعيهمْ عَز مَاتُهمْ","بتفريغِ أجْفانٍ ومِلءِ جِفانِ",25,"ن",1,0],["موكَّلٌ طرفي وقلبي وقد","بانوا بِتَذارفٍ وتَذكارِ",26,"ر",1,0],["مؤكد من حرج أو ضمان","على الليالي وصروف الزمان",27,"ن",1,0],["مَوكبُ الحزنِ سار للطفّ ينعي","لمُصابِ السبط الحسينِ الغريبِ",28,"ب",1,1],["موكولة لسجايانا علائقنا","وما مرافقنا إلا بأيدينا",29,"ن",2,0],["موكَّلاتٍِ بالفلا","يَطْوينَها طيَّ البُسُط",30,"ط",1,0],["مُؤْكِلِ آكالٍ قُدامٍ شَهْبَرِ","فِي غَيْضَةٍ شَجْراءَ لَمْ تَمعَّرِ",31,"ر",1,0],["موكب المَلك بعد ذاك الغياب","طالعتنا به سعودُ الركاب",32,"ب",1,1],["موَّكلَةَ بالفادحات كأنها","وقد جَعَلت منها الثميلة تخلقُ",33,"ق",1,0],["موِّكة أرض العذيب وقد بدا","فُسرّ به للآئبين الخوَرنَقُ",33,"ق",1,0],["مُوَكَّلٌ بِشُدوفِ الصَومِ يَنظُرُها","مِنَ المَغارِبِ مَخطوفُ الحَشا زَرمُ",34,"م",1,0],["موكبٌ يفضح الكواكب نوراً","راح ينسابُ من وراك انسيابا",35,"ب",2,0],["موكبُ دُهمٍ لائحاتٌ غُرُرُه","أو اسودُ اللّمة شابت طرُرُه",36,"ر",2,0],["موكلة بالهم تهزم جيشه","بجيش الأماني والمسرة والأنس",37,"س",1,0],["موكلاً في عداد الشهب ناظره","حتى على الغمض أعياه تلاقيه",38,"ي",2,0],["موكب الآصفي ام علاه","أينما حل حلت الفرحات",39,"ت",1,1],["موكلة في كل يوم وليلة","ملائكة تملي عليها وتكتب",40,"ب",1,0],["موكب للجلال يزهى لديه","دونه يصرف الزَمان صروفه",41,"ف",2,0],["موكبٌ لم يرتحل من موطن","وإليه وحده شدُّ الرحال",42,"ل",1,0],["موكب سائر من الحسن والحب","ب ومن كل شائق وجميل",43,"ل",1,1],["موكب للشباب والزهو فيه","ملكٌ صائلٌ بتيه خجول",43,"ل",1,0],["موكبٌ حافلٌ يموج بفرد","ليس من قلَّ مثله بقليل",43,"ل",1,0],["موكب الحسن إيه يا موكب الحس","ن تفرّد بالتاج والإكليل",43,"ل",1,0],["موكب الحسن فانحُ ما شئت يحففْ","بك أملاك سرمد مجهول",43,"ل",1,0],["موكِّلٌ مكلِّمٌ يا مبرمُ","أمري في الكون جميعاً يبرَمُ",44,"م",1,0],["موكل بحجاب الغيب يخرقه","فما عليه بحمد اللَه يحتجب",45,"ب",1,0],["موكئاً يلقيه أيان ارتحل","لمثاوي صرح آذيس الرحاب",46,"ب",1,0],["موكب لم يكن لبلقيس يوماً","أو سليمان بعضهُ أو هرونا",47,"ن",2,0],["مَوكب النُور أَين أَفضى","بِكَ الطَريق الَّذي سَلكته",48,"ه",1,1],["مَوكِبٌ لِلرَبيعِ في أَزهارِهِ","أَم بَديعُ البِشرِيِّ في مُختارِه",49,"ر",2,1],["مَوكب التحرير صادَرَهُ","سارقُ التلفازِ والصُّحُفِ",50,"ف",1,0],["مَوْكِبُ النَّصْرِ تَعَالَى","فِي الْوَرَى يُعْلِنُ نَصْرَا",51,"ر",2,0],["مَوْكِبَ الموْتِ كم طَوَيْتَ رِجالاً","وَتَهاوَتْ على يَدَيْكَ الْمِلاحُ",52,"ح",1,0],["مَوْكِب َالموتِ مَن على الحَدِّ ماضٍ","بعدما أُفْرِدَ الرِّجالُ، وطاحوا؟",52,"ح",3,0],["موكب كله سنا وسناء","ترقب الارض حسنه والسماء",53,"ا",2,1],["مو كلِّ العقل لأهل العقل زينه","نَمله ابلا عَقل بس بالعلم حيره",54,"ر",2,1],["مو كلمن غيور وللوطن يفديه","اكو ابصمته ويذبّح للوطن غَيره",54,"ر",2,0],["موكّلون بدار البعد ...دارهم","بالبعد وسط أقاصي الأرض تتصل",55,"ل",1,0],["موكّلونَ بدارِ البعدِ..دارهمُ","بالبعدِ وسطَ أقاصي القدس تتصلُ",56,"ل",1,0],["موكل بك لا سفح ولا قمم","ولا فنار فأستهدى ولا علم",57,"م",1,1],["موكل بك ليت الأرض توقف من","مدارها تسكن الأجرام والسُدُمُ",57,"م",1,0],["موكبُ الأشواقِ في قلبي رسَا","مذْ سقاني الخلُّ هجرًا أكْؤُسا",58,"س",2,1],["مو كفاك حنيني ولا كفاك شغوفي","مو كفاتك قسوة زماني وسنيني",59,"ن",2,0],["موكِبي العُنفوانُ، يُذْكِي اشتياقِي","لِزمانٍ فيهِ جنينيَ يُولَدْ",60,"د",1,0],["موكّلون بها مستلئمون لها","إذا استدارتْ رَحاها ألف سربالِ",61,"ل",1,0]]}