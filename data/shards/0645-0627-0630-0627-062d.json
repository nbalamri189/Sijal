{"poems":[[88,"أي مكمهون قدمت بالقصد","https://www.aldiwan.net/poem10680.html","مجزوء الكامل"],[91,"قد جاء يا أم وقت فوتي","https://www.aldiwan.net/poem44940.html","مخلع البسيط"],[87,"قد كنت أوثر أن تقول رثائي","https://www.aldiwan.net/poem62927.html","الكامل"],[107,"الكون أشرق نضرة ونعيما","https://www.aldiwan.net/poem42064.html","الكامل"],[107,"ركب الرفاق الظاعنين عجالا","https://www.aldiwan.net/poem42127.html","الكامل"],[107,"قل للوزير إذا خلا لك وجهه","https://www.aldiwan.net/poem43062.html","الكامل"],[107,"بلغ الدنى فألم غير مسلم","https://www.aldiwan.net/poem43112.html","الكامل"],[107,"نبئ سواي فما لي حين تخبرني","https://www.aldiwan.net/poem43418.html","الطويل"],[107,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[358,"يا للهوى من لصب لم ينل أربا","https://www.aldiwan.net/poem40790.html","البسيط"],[358,"عاني المها مستهل الدمع هاطله","https://www.aldiwan.net/poem40792.html","البسيط"],[358,"يا للهوى من لصب لم ينل وطرا","https://www.aldiwan.net/poem40793.html","البسيط"],[358,"عطفا على مستهام رق وانتحلا","https://www.aldiwan.net/poem40795.html","البسيط"],[358,"عطفا على مستهام رق وانتحبا","https://www.aldiwan.net/poem40797.html","البسيط"],[358,"عاني المها مستهل الدمع ساكبه","https://www.aldiwan.net/poem40799.html","البسيط"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128275","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79859","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100831","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28690","البسيط"],[404,"قَوْلٌ مُخْتصرٌ في العِشْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=193468",""],[6134,"ماذا حملتم على الايدي بلا حذر","https://www.poetsgate.com/ViewPoem.aspx?id=169551",""]],"verses":[["ماذا حَمَلتَ لَنا عَنِ ال","مَلِكِ الكَبيرِ وَعَن غِرايَه",0,"ا",3,0],["ماذا حياتي من بعدُ تنفع","كان الذي خفت أن يكونا",1,"ن",2,0],["ماذا حَشَدتِ مِنَ الدُموع لِحافِظٍ","وَذَخَرتِ مِن حُزنٍ لَهُ وَبُكاءِ",2,"ا",2,0],["ماذا حملتَ من المعارفِ والنُّهى","لمّا حملتَ كتابَها المرقوما",3,"م",2,0],["ماذا حملتَ إلى الرِّفاقِ عن الأُلى","ألقى الضِّعافُ عليهمُ الأحمالا",4,"ل",2,0],["ماذا حَمَلتَ مِنَ الأُمورِ لِأُمَّةٍ","حَمَلَت مُلِمّاتِ الزَمانِ ثِقالا",5,"ل",2,0],["ماذا حَمَلتَ مِنَ الكُروبِ لِأُمَّةٍ","رَزَحَت بِأَعباءِ الخُطوبِ الجُثَّمِ",6,"م",1,0],["ماذا حَملتَ مِن الأَنباءِ لا رُزِئَت","أُذني وَعَيني بِمَسموعٍ وَمَشهودِ",7,"د",1,0],["ماذا حَفِظتَ لَأَهلِها مِن حُرمَةٍ","وَقَضَيتَ مِن حَقٍّ عَلَيكَ مُحَتَّمِ",8,"م",1,0],["ماذا حَوى وَيح قَلبي ظَلَّ مُرتَهنا","يَرجو اللقا وَالظبا تيها تُغادرُه",9,"ر",2,0],["ماذا حَوى وَيح قَلبي ظَلَّ مُرتَهنا","يَرجو اللقا وَالظبا تيها تُماطِلُه",10,"ل",2,0],["ماذا حَوى وَيح قَلبي ظَلَّ مُرتَهنا","مُضنى الجَوى أتقاوى وَالهَوى قَهَرا",11,"ر",2,0],["ماذا حَوى وَيح قَلبي ظَلَّ مُرتَهنا","مُضنى الجَوى أتقاوى وَالهَوى قَتلا",12,"ل",2,0],["ماذا حَوى وَيح قَلبي ظَلَّ مُرتَهنا","مُضنى الجَوى أتقاوى وَالهَوى غَلَبا",13,"ب",2,0],["ماذا حَوى وَيح قَلبي ظَلّ مُرتهنا","يَرجو اللقا وَالظبا تيها تُعاقبُه",14,"ب",2,0],["ماذا حدا بك فاعتزمت رحيلا","وتركت مصر إلى القضا والنيلا",15,"ل",2,1],["ماذا حواسدُها تقولُ وقد رأت","في المكرمات لوفرها أَتلافَها",16,"ف",3,0],["ماذا حبوت القوم حتى انهم","أحيوك بالذكرى كانك موسم",17,"م",1,0],["ماذا حَياةُ اِمرِئٍ أَضحَت مَنيتُهُ","مَقسومَةٌ بَينَ أَحياءٍ وَأَمواتِ",18,"ت",1,0],["ماذا حملتَ لعاشقٍ يا قاتلي؟","إني رأيتكَ في اندفاعكَ مُقْبلا",19,"ل",2,0],["ماذا حملتم على الايدي بلا حذر","ومن دفنتم فما هذي من البشر",20,"ر",1,1]]}