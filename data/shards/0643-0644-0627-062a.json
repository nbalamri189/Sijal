{"poems":[[53,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[87,"يا أيها الدمع الوفي بدار","https://www.aldiwan.net/poem62872.html","الكامل"],[69,"أما المحبة لمن فهي بذل نفوس","https://www.aldiwan.net/poem18142.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85688","الرمل"],[102,"ثرثرات محموم","https://www.poetsgate.com/ViewPoem.aspx?id=50376",""],[164,"كلات ودين الله أفضل ما تكلا","https://www.aldiwan.net/poem59159.html","الطويل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[458,"في الشتاء العويل والأشجان","https://www.aldiwan.net/poem61727.html","الخفيف"],[505,"دع وهم أهل الوحدة المطلقه","https://www.aldiwan.net/poem37935.html","السريع"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138195",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138200",""],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80032","الكامل"],[1890,"","https://poetry.dctabudhabi.ae/diwan/poem/89648","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100265","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65140","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65102","البسيط"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121340","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129503","الوافر"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40129","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81727","الرمل"],[4767,"استنهاض القلم","https://www.poetsgate.com/ViewPoem.aspx?id=201142",""],[5362,"في ذمة التمدن الكاذب","https://www.poetsgate.com/ViewPoem.aspx?id=170371",""],[5830,"كل الشرائع في محرابك اجتمعت","https://www.poetsgate.com/ViewPoem.aspx?id=204642",""],[5845,"كلفتُ بكمْ ففاضَ دمي دموعاً","https://www.poetsgate.com/ViewPoem.aspx?id=16698",""],[6127,"ناي الكآبات","https://www.poetsgate.com/ViewPoem.aspx?id=207517",""]],"verses":[["كَلأَتْهُ نيَّتُهُ التي منْ سُوسها","صِدْق الكَلاءة والقلوبُ سواهي",0,"ه",2,0],["كُلِأَت بِأَنظارِ العَزيزِ وَحُصِّنَت","بِفُؤادَ فَهيَ مَنيعَةُ الأَسوارِ",1,"ر",1,0],["كُلُّ اتِّصالاتِ السَّعِيدِ سَعِيدَةٌ","بِمَثَابَةِ التَّثْلِيثِ وَالتَّسْدِيسِ",2,"س",1,0],["كل آت هو ماض","كل ماض هو آتِ",3,"ت",1,0],["كلّ آت مضى أتى كل ماض","ضاع في كلّ رايح كلّ غادي",4,"د",2,0],["كلات ودين الله أفضل ما تكلا","وأفضل ما امنت في بهجة السبلا",5,"ل",2,1],["كلُّ آتٍ في البالِ فهو سوى اللَ","هِ تَعالى وأين أين السواءُ",6,"ا",2,0],["كلُّ إتقانهم نفاقٌ وبتهانق","ومنهم ليخجل البهتان",7,"ن",1,0],["كلُّ اتِّحادٍ حُكمُهُ باطِلٌ","وشاهِدُ الظَّاهِرِ قدْ مَزَّقَهْ",8,"ق",2,0],["كلأتك عين الله فوق العرش في","عزِّ غدا لك ألزم الحلفاء",9,"ا",2,0],["كلأتك عين الله في حلّ وقد","صحبتك في رحل فنعم المصطحب",10,"ب",1,0],["كلا تنم واطلب تنل من القرى","أبو قبيس تحته أم القرى",11,"ر",2,0],["كلاً تراه جعفراً","في الجودِ وهو لهم زعيم",12,"م",1,0],["كُل آت لا شَكَّ آت وَذو الجَهل","معنى وَالغَم وَالحُزن فَضل",13,"ل",1,0],["كُلِّ اتِّحَادِيٍّ خَبِيثٍ عِندَهُ","مَعبُودُهُ مَوطُوءُهُ الحَقَّانِ",14,"ن",1,0],["كلأت حمى الشرع الشريف مشاهداً","بعينك ترعاه وغيرَ مُشاهدِ",15,"د",1,0],["كلٌّ أتى قاصدا فعل المحامد من","دفع المظالم واستئصال أهليها",16,"ي",3,0],["كلٌّ أتى باب فضل منك سائلهُ","وليس عن بابك الأسمى بمنعرج",17,"ج",1,0],["كلأتكم ممن يعادي هيبةٌ","أغنتكمُ عن رقبةٍ وجناب",18,"ب",1,0],["كلأت الرتبة العلياء لما","بها دون الورى ظفرت يداكا",19,"ك",2,0],["كَلأت هَوامِلَها ورد مطارها","ما أريشته وَثقفت آطارَها",20,"ر",3,0],["كلُّ آتٍ قرنَه يس","عى بخطوٍ غير آتن",21,"ن",1,0],["كلٌّ أتى في فيهِ قافيةٌ","ألفاظها تحلو وتنسجم",22,"م",1,0],["كلا ترى منهم أخا همة","تزيل متن الجبل الراسب",23,"ب",1,0],["كُلٌ أَتَىَ قَوْمَهُ يَوْماً بِمُعْجِزَةٍ","وَ أَنْتَ أَحْيَيْتَ فِيهَا مَيِّتَ الرِّمَمِ",24,"م",1,0],["كلأتُ بهمْ منَ المحنِ اللواتي","تشيبُ خطوبها الطفلَ الرضيعا",25,"ع",2,0],["كلٌّ أتاها بوهم الغُول يطلبها","والنابُ منه إلى ما يشتهي وثبا",26,"ب",2,0]]}