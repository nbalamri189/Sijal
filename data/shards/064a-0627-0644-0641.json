{"poems":[[63,"إن عن لهو أو سنح","https://www.aldiwan.net/poem51734.html","مجزوء الرجز"],[119,"يا بويرق الحمى","https://www.aldiwan.net/poem41233.html","عموديه"],[333,"لا أنا خالد ولا أمنياتي","https://www.aldiwan.net/poem54952.html","الخفيف"],[358,"ما ترى البدر حين حاز كماله","https://www.aldiwan.net/poem40002.html","الخفيف"],[505,"يا لفتة الظبي من غربي لعلع في","https://www.aldiwan.net/poem38060.html","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64295","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48273","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108453","الرمل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105001","الخفيف"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126228","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67986","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62817","المنسرح"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126956","الرمل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138442",""],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32894","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69980","الرمل"],[4690,"عاصمة المواجع","https://www.poetsgate.com/ViewPoem.aspx?id=128043",""],[4829,"ملحمة الليث والمهاة وبنات آوى","https://www.poetsgate.com/ViewPoem.aspx?id=34252",""],[4883,"الفلوجة دائماً","https://www.poetsgate.com/ViewPoem.aspx?id=48356",""],[5111,"كوني","https://www.poetsgate.com/ViewPoem.aspx?id=212074",""],[5183,"رزء العلم","https://www.poetsgate.com/ViewPoem.aspx?id=180254",""],[5431,"ياعراق....","https://www.poetsgate.com/ViewPoem.aspx?id=207993",""],[5596,"فنجاء","https://www.poetsgate.com/ViewPoem.aspx?id=206476",""],[5638,"ملحمة العرب","https://www.poetsgate.com/ViewPoem.aspx?id=199068",""],[5677,"عيد ميلادك","https://www.poetsgate.com/ViewPoem.aspx?id=179848",""],[5732,"يا فزعة المظيوم","https://www.poetsgate.com/ViewPoem.aspx?id=177835",""],[6115,"رثاء للشاعر سعد بن جدلان","https://www.poetsgate.com/ViewPoem.aspx?id=180459",""]],"verses":[["يألَفُني حَمامُها","مغتبِقاً ومُصطَبِح",0,"ح",1,0],["يا لفان موله","هائم القلب صبه",1,"ب",2,0],["يا لفنٍّ بناه هشّ له المج","د وحيى أبراجه الشاهقات",2,"ت",1,0],["يا لفرعٍ بِلَيله عَنبر الخا","ل أَرانا صُبح الجَبين بلاله",3,"ل",2,0],["يا لفْتَةَ الظَّبيِ من غربيّ لَعْلَعَ في","وادي العَقيقِ سلَبْتِ القلبَ فالْتَفِتي",4,"ت",2,1],["يَألَفُونَ الطَّوَى إِذا ألف النا","سُ اشتواءً مِنْ فَيْئِهِمْ واطّبَاخا",5,"خ",2,0],["يألفُ الجود من رآه وينسا","بُ لعافيهِ نهرُهُ العسجديُّ",6,"ي",1,0],["يا لفن ذاد عنه رجل","ثابت في عزمه طلق اللسان",7,"ن",1,0],["يا لفصل الخريف أي خروف","فيه أمسى مجدلاً مقتولا",8,"ل",2,0],["يألَفُ الوحشَ من أرادَ نَجَاةً","زاهداً فى الطريقةِ العِيسَوى",9,"ا",1,0],["يَألف السُّهْدَ يُكرم الوَفْد يحمى","بيضةَ الدِّين خيفةً أن تُساما",10,"م",2,0],["يألفُهم حَدُّها وتألفُهُ","جماجمٌ منهم وأسْحارُ",11,"ر",1,0],["يالفتيان على الحق قضت","وبها زاد ظهوراً واتضاحا",12,"ح",2,0],["يا لفقر هو الغنى حيث ما في ال","كون منهم وتلك إحدى الأيادي",13,"د",2,0],["يا لَفظَةَ البَغي بِمَوتِ الخَليل","يا وَقفَةَ التَوديعِ بَين الحُمول",14,"ل",1,1],["يا لَفيفاً مُتسنيرا","اسمعوا صَوتاً جَهيرا",15,"ر",2,0],["يا لفحَةً من نار وجْدي","حَرّها في مُقْلتيْ",16,"ي",1,0],["يا لفنّه كثر ولفه للهمالي","سايح(ن) وسط القفار الجرهديّه",17,"ي",2,0],["يالفالجه* ماباقي ٍ غير الاشجار","اللي عليها ماتحط العصافير!",18,"ر",1,0],["يَا لفْظَةً عَبْرَ اللِّسَانٍ تَجَمَّعِيْ","صُبِّي مَوَاوِيلَ الْهَوَى فِيْ مُوجِعِيْ",19,"ع",2,1],["يا لفقد مات فيه صبر مَن","كان بالعزم قوياً لهجا",20,"ج",2,0],["يالفحلٍ سديمه سحّ غيما","وعلى السفح دفقه المهراقُ",21,"ق",1,0],["يا ل( فنجا ) ويا لعزم بنيها","إن دها الخطب ساعة الإزدحام",22,"م",1,0],["يَا لَفَخْرِ الْعُرْبِ كَانُوا","قِبْلَةَ الْعِلْمِ سِقَاءْ",23,"ا",2,0],["يالفاتن اللي باصبعك يمي تشير","وكنك تقول ( الصمت هذا يدينك )",24,"ك",1,1],["يالفيصلي يا ستر غضات الاشناب","ان نابهن في بعض الأيام نايب",25,"ب",1,0],["يالفطين اذهن إذا كان لك لبّ","كل حيّ الموت لازم يجيله",26,"ل",2,1]]}