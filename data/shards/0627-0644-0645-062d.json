ttps://poetry.dctabudhabi.ae/diwan/poem/86449","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123515","البسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117242","الكامل"],[4568,"","https://poetry.dctabudhabi.ae/diwan/poem/143589","الكامل"],[4739,"الهنا حزن","https://www.poetsgate.com/ViewPoem.aspx?id=36918",""],[4748,"أوهام","https://www.poetsgate.com/ViewPoem.aspx?id=4344",""],[4750,"الثقيل","https://www.poetsgate.com/ViewPoem.aspx?id=180406",""],[4805,"شمر","https://www.poetsgate.com/ViewPoem.aspx?id=176496",""],[4849,"والله إنك بطل","https://www.poetsgate.com/ViewPoem.aspx?id=53496",""],[4869,"المحبه تطلب شويّة غذا","https://www.poetsgate.com/ViewPoem.aspx?id=151647",""],[5225,"أصغي لصوتك ولا جاني نداك","https://www.poetsgate.com/ViewPoem.aspx?id=36750",""],[5344,"الاهتمام ..!","https://www.poetsgate.com/ViewPoem.aspx?id=155065",""],[5370,"مشية العسكري","https://www.poetsgate.com/ViewPoem.aspx?id=87424",""],[5377,"شعب متربص","https://www.poetsgate.com/ViewPoem.aspx?id=61901",""],[5431,"بريد مستعجل لمحمد صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=208569",""],[5463,"اتركوني في هواها","https://www.poetsgate.com/ViewPoem.aspx?id=25226",""],[5525,"المحبة أرض","https://www.poetsgate.com/ViewPoem.aspx?id=6453",""],[470,"القافلة","https://www.poetsgate.com/ViewPoem.aspx?id=178094",""],[5582,"قِفا صاحِبَيْ نَبْكِ فَقَدْ وَجَبَ البُكا","https://www.poetsgate.com/ViewPoem.aspx?id=187215",""],[5732,"ياغزال الريم ياظبي الفلا","https://www.poetsgate.com/ViewPoem.aspx?id=177889",""],[5739,"جاوبيني","https://www.poetsgate.com/ViewPoem.aspx?id=126426",""],[5739,"راسبه والاّ ناجحه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=126872",""],[5739,"تسعين جني ..!","https://www.poetsgate.com/ViewPoem.aspx?id=155473",""],[5756,"تزعلين وتقعدين","https://www.poetsgate.com/ViewPoem.aspx?id=34908",""],[6068,"حيّ الخريدة حبّة الايناس -07-","https://www.poetsgate.com/ViewPoem.aspx?id=175898",""],[6260,"جيش الحبائب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68361&r=&rc=53",""]],"verses":[["أَلمَحُ لِاِستِقلالِنا لَمعَةً","في حالِكِ الشَكِّ فَأَستَروِحُ",0,"ح",1,0],["المُحتَوي بِسَماحِهِ وَحُسامِهِ","مَدحَ الفَصيحِ وَحُلَّةَ الجَحجاحِ",1,"ح",1,0],["أَلَمَحتَها في صورَةٍ أَشهِدتَها","في حالَةٍ أَرَأَيتَها في مَوضِعِ",2,"ع",1,0],["أَلَمَحتَ في الماضي البعيدِ","فتىً غريرًا أرعنا؟",3,"ن",2,0],["أَلَمَحتَ في الماضي البَعيدِ","فَتىً غرَِئً أَرعَنا",4,"ن",2,0],["أَلمَحُ الأَيّامَ فيها وَأَرى","مِن وَراءِ السِنِّ تِمثالَ صِباها",5,"ا",3,0],["المُحسِنونَ هُمُ اللُبا","بُ وَسائِرُ الناسِ النِفايَه",6,"ا",3,0],["ألمح اللؤلؤ في أغوارها","وأرى الطيبة تطفو في سناهَا",7,"ا",3,0],["ألمح الدنيا بعيني سئمٍ","وأرى حولي أشباح الملل",8,"ل",1,0],["آلَ محمودٍ عَرفنا فَضْلَكُمْ","فَجَزيناكُمْ وَلاءً وامْتِدَاحا",9,"ح",2,0],["أَلمح بَين الجُفون لُؤلؤة","فازَ بِها النَوم وَهُوَ يَأسرها",10,"ر",3,0],["المحسناتُ إلى المري","ض غدونَ أشباهاً لهنّهْ",11,"ن",2,0],["أَلَمحَةٌ مِن سَنا بَرقٍ رَأى بَصَري","أَم وَجهُ نُعمٍ بَدا لي أَم سَنا نارِ",12,"ر",1,0],["أَلْمَحَبَّاتُ وَالْكَرَامَا","تُ فِيهِمْ لِمَنْ نَجَحْ",13,"ح",1,0],["ألمحُ شخصي به كأنّي","ألمحُ شخصاً به جديدا",14,"د",2,0],["المحاسيبُ أوصَدُوا كلَّ بابٍ","في وجوه النوابغ الأكفاء",15,"ا",2,0],["المحال الآن يبدو غيره","كذّبت (عرّافه) (الجوف) العرافه",16,"ف",2,0],["المحصناتُ مباحةٌ حرماتُها","تجد السياطَ عَلى الخصورِ وِشاحا",17,"ح",2,0],["المُحرزُ المجدَ عَن جدٍّ يجرّ بهِ","نِجادَ نجدته لا ذيلَ محتفلِ",18,"ل",1,0],["ألمَحض الوجود والموت جئنا","أم لسرٍّ وحكمةٍ مكنونه",19,"ه",1,0],["المُحكِمين عقودَ أقبيةٍ","فيها يُرونَكَ أَوجُها زُهرا",20,"ر",2,0],["المحصي المبدي المعيد الذي","بنفخة يبعث من في القبور",21,"ر",1,0],["المحامون على أحسابهم","بصريحاتٍ من المال وهُجنِ",22,"ن",1,0],["المحرز السبق الأوفى ولا عجب","إذ كنت والده أن يحرز السبقا",23,"ق",2,0],["المُحْسِنينَ لِمنْ أَساء زَمَانُهُ","وتغرَّبتْ أَوْطانُهُ عَنْ أَهْلِهِ",24,"ل",2,0],["المحُسن البَطل الجسورْ","وَاصحب بحضرته الحبورْ",25,"ر",1,0],["ألمحةً من سنى برقٍ رأى بَصَري","أَم وَجهَ عاليةَ اختالَت بهِ الكِلًلُ",26,"ل",1,0],["آل محرق لقد حرقتُم","بجودكم قلب الحريص الباخلِ",27,"ل",1,0],["المحكمات البينا","ت العاليات المستند",28,"د",1,0],["المُحْيِيَاتِ بِأنْسِهِنَّ تَوَدُّدًا","المُهْلِكَاتِ بِتِيهِهِنَّ دَلاَلاَ",29,"ل",2,0],["المحدثات رأيت في","ماضي الوجود لهنَ مثلاً",30,"ل",2,0],["المَحْضَ مَجْداً وَالرَغِيبَ مِقْدَحا","ما وَجَدَ العَدَّادُ فِيهِ جَحْجَحا",31,"ح",2,0],["المحتبي بالدست من هيبته","يخشى السؤال خشية المجاوب",32,"ب",1,0],["المحنة الكَبيره","إِن كُنتَ ذا بَصيره",33,"ه",1,0],["ألمحت من نور التجلي لمحةً","فجعلت ذات الحق تلك مكشفه",34,"ف",2,0],["المحسنينَ بلا مطَلٍ إذا وَعدوا","والمنعمين بلا منٍّ إذا نفعوا",35,"ع",3,0],["المحيّا عند بذل الجودِ وجهاً","صاحياً والمُرتجى كفًّا مُغيما",36,"م",2,0],["المُحرِمَينِ وإن أحلاّ دائماً","زهداً بما تهوى النفوسُ وتعشق",37,"ق",1,0],["المحل عنها مدبرٌ","والخصب فيها مقبل",38,"ل",1,0],["المحشي في رز ولحم خالي","عن سائر الأشحام والأعصاب",39,"ب",1,0],["أَلَمحَةٌ مِن سَنا بَرقٍ عَلى عَلَمٍ","أَم نُورُ خَيرِ الوَرى مِن جانِبِ الخِيَمِ",40,"م",1,0],["المحبين لك عبيد","إلا أنا قال أي وسَن",41,"ن",1,0],["ألمحنة شغلتك عني أم قلى","حاشاك انك ما برحت ودودا",42,"د",2,0],["المحسن المُرتَقي فَوقَ السِماك على","لِلّهِ أَيَّ ثَنايا لِلعُلى طَلَعا",43,"ع",2,0],["المحكم الرأي من يرعى رعيته","بحكمة وبطرف منه يقظان",44,"ن",1,0],["المحيطون بالكواكب بيضاً","وأولو الزيج في الليالي السودِ",45,"د",1,0],["المحسين القول والفعل الجميل معا","والمرء يمدح اقوالا وافعالا",46,"ل",2,0],["المحبّه تِنْحَطْ وْتَسْبي","والحبيب الروح يَسْلِبْها",47,"ب",3,0],["أَلمَحُ النجمَ متى مَا شِمْتُه","يَا ليالي الوصل هل لي منك لَمْحُ",48,"ح",1,0],["ألمَّ حمىً لا ضيمَ فيه لوافدٍ","ولاذ بطود لا تسامى خِلالُه",49,"ل",2,0],["ألمحنةٍ شغلتك عني ام قلاً","أنت العماد فمن يكون عميدا",50,"د",2,0],["المحْهُ بالرُّوحِ لا","لمحَ العُيونِ الخواةْ",51,"ا",2,0],["المحييات الجود يوم سماحة","والقاتلات الموت يوم قتال",52,"ل",1,0],["المحتبين بدستيها وإن نهضوا","حلوا حباها وشدوها حيازيما",53,"م",2,0],["المحتبي بالدست تحسب أنه","أسد تصدر بالندي الغيلا",54,"ل",2,0],["المحتبي بالدست تحسب وجهه","قمر السماء وتاجه إلا كليلا",54,"ل",2,0],["المحتبي بالدست تحسب خلقه","روضاً يباكريه النسيم عليلا",54,"ل",2,0],["المحتبي بالدست تحسب لفظه","دار يفصل نظمه تفصيلا",54,"ل",2,0],["المحتبي بالدست تحسب شخصه","شخص النبي وقوله التنزيلا",54,"ل",2,0],["المحسن المنعم المعطى الكريم فلا","يمل من سائل في بابه وقفا",55,"ف",2,0],["المحسنون بجنة الإفضال","قد أنطقتهم الأعمال",56,"ل",1,1],["المحسِنُ الحسَنَ الذي إحسانُهُ","ونوالُهُ أقصى مُنى المُتَنوِّلِ",57,"ل",1,0],["المحبه دارك ودربها بابك","وانت حتى حاسدينك يحبونك",58,"ك",1,0],["ألمح بعينك شكوك تألمك","لا تصدقها ترا هذا وهم",59,"م",1,0],["المحبه جملها مرسلٍ وامعقول","لعنبو من يقول ان المحبه اخبال",60,"ل",1,0],["المحتمين.. المبعدين ..المراميس","الشاملين .. ومهتوين الرزايا",61,"ا",3,0],["ألمح الغيم وآجرّ المواويل","وأسأل الليل عن لحظة حلولك",62,"ك",1,0],["المحبه يالحبيبه تطلب شويّة غِذا","يا بجلسه يا بنظره يا بمرسول الموبايل",63,"ل",1,1],["المحب اللى بإحساسه رجاك","عمره الغالي بوهمك ضيّعه",64,"ع",2,0],["المحبه تطلب الشخص التسامي","ودونها يلقى المُحب أقسى حتوفه..",65,"ف",2,1],["المحبه بعينه .. مسخره بمسخره","والمحبه بعيني دبلتين وكليل",66,"ل",1,0],["ألمح الشعب قابعاً يدرس الثورة","كيما يأتي بأخرى جديده",67,"د",2,0],["المحسن السمح للأخلاق مدرسة","الزاهد المار مرّا دون توطين",68,"ن",1,0],["المحبه والمودّه والعشق لي ترتجينه","جالك الليله هديّه ياللي ما قلبي لسواها",69,"ا",3,0],["المحبة أرض والفرقا أراضي","والزمن كله ترى لاغبت ماضي",70,"ض",2,1],["المُحبّون، والخليّون، والعذّال","أهلُ التُّقى، وأهلُ الضَّلالِ",71,"ل",1,0],["( ... ) المَحْل مِنْ بُقْعَةٍ لَها","بِأَرْضِ مَحيلا مُقْفِر دائِم لَكا",72,"ك",2,0],["المحبه والملاحه والهوى","زاهيات فيك يابدر التمام",73,"م",1,0],["المحبه ليه طافي سراجها.؟","جاوبيني.! كان للخافي ظهور.",74,"ر",1,0],["المحبه ...! ترتوي بالمصلحه.","والمصالح سرها يبقى بشفاك.",75,"ك",1,0],["المحيط اللي تهوزه يالإمام.","لا تغرك هقوتك جوفه غويط.",76,"ط",1,0],["المحبة شبه زالت والصداقة لاتزال","بس أببقى في عيونك ( حامد ) اللي تعرفين",77,"ن",1,0],["المحييات جواثما بتحيّة","والقاتلات فوارسا بمياس",78,"س",1,0],["المحرقات بنارهن قلوبنا","والآخذات من اللحاظ قواضبا",79,"ب",2,0]]}