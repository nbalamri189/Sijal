{"poems":[[88,"ما لي أرى الأكمام لا تفتح","https://www.aldiwan.net/poem10674.html","الرجز"],[73,"حيا محل الحاجبية بالحمى","https://www.aldiwan.net/poem3982.html","الكامل"],[93,"أنا لست بالحسناء أول مولع","https://www.aldiwan.net/poem8980.html","عموديه"],[93,"وطن النجوم","https://www.aldiwan.net/poem49843.html","عموديه"],[93,"وطن النجوم أنا هنا","https://www.aldiwan.net/poem62783.html","عموديه"],[87,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[87,"جبريل أنت هدى السماء","https://www.aldiwan.net/poem63729.html","مجزوء الكامل"],[99,"جئتُ أشكو لكِ روحي وجواها","https://www.aldiwan.net/poem24757.html","الرمل"],[99,"يا فؤادي رحم الله الهوى","https://www.aldiwan.net/poem25088.html","الرمل"],[107,"سائلوا الأبطال هل ملوا الكفاحا","https://www.aldiwan.net/poem42054.html","الرمل"],[104,"ما لك والذكريات تذعرها","https://www.aldiwan.net/poem32915.html","المنسرح"],[104,"بيض الحمائم حسبهنه","https://www.aldiwan.net/poem33133.html","مجزوء الكامل"],[7,"عوجوا فحيوا لنعم دمنة الدار","https://www.aldiwan.net/poem1998.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54690","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54274","البسيط"],[108,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[102,"بين الرجل والطريق","https://www.poetsgate.com/ViewPoem.aspx?id=50371",""],[302,"أرأيت كيف ذرى الدموع وناحا","https://www.aldiwan.net/poem36810.html","عموديه"],[309,"لا مثل للمصطفى في سائر الدول","https://www.aldiwan.net/poem56434.html","البسيط"],[332,"في طريق يحفه الزهر النضر","https://www.aldiwan.net/poem54972.html","الخفيف"],[368,"ذكر المعسكر صاحبي ذكرا","https://www.aldiwan.net/poem60913.html","أحذ الكامل"],[407,"قف وقفة العبد الذليل الحقير","https://www.aldiwan.net/poem33747.html","السريع"],[461,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[518,"من كان لا يعشق الأجياد والحدقا","https://www.aldiwan.net/poem12182.html","البسيط"],[589,"ما شئت من عبء الغرام وحمله","https://www.aldiwan.net/poem17688.html","الكامل"]],"verses":[["أَلمَحُ لِاِستِقلالِنا لَمعَةً","في حالِكِ الشَكِّ فَأَستَروِحُ",0,"ح",1,0],["المُحتَوي بِسَماحِهِ وَحُسامِهِ","مَدحَ الفَصيحِ وَحُلَّةَ الجَحجاحِ",1,"ح",1,0],["أَلَمَحتَها في صورَةٍ أَشهِدتَها","في حالَةٍ أَرَأَيتَها في مَوضِعِ",2,"ع",1,0],["أَلَمَحتَ في الماضي البعيدِ","فتىً غريرًا أرعنا؟",3,"ن",2,0],["أَلَمَحتَ في الماضي البَعيدِ","فَتىً غرَِئً أَرعَنا",4,"ن",2,0],["أَلمَحُ الأَيّامَ فيها وَأَرى","مِن وَراءِ السِنِّ تِمثالَ صِباها",5,"ا",3,0],["المُحسِنونَ هُمُ اللُبا","بُ وَسائِرُ الناسِ النِفايَه",6,"ا",3,0],["ألمح اللؤلؤ في أغوارها","وأرى الطيبة تطفو في سناهَا",7,"ا",3,0],["ألمح الدنيا بعيني سئمٍ","وأرى حولي أشباح الملل",8,"ل",1,0],["آلَ محمودٍ عَرفنا فَضْلَكُمْ","فَجَزيناكُمْ وَلاءً وامْتِدَاحا",9,"ح",2,0],["أَلمح بَين الجُفون لُؤلؤة","فازَ بِها النَوم وَهُوَ يَأسرها",10,"ر",3,0],["المحسناتُ إلى المري","ض غدونَ أشباهاً لهنّهْ",11,"ن",2,0],["أَلَمحَةٌ مِن سَنا بَرقٍ رَأى بَصَري","أَم وَجهُ نُعمٍ بَدا لي أَم سَنا نارِ",12,"ر",1,0],["أَلْمَحَبَّاتُ وَالْكَرَامَا","تُ فِيهِمْ لِمَنْ نَجَحْ",13,"ح",1,0],["ألمحُ شخصي به كأنّي","ألمحُ شخصاً به جديدا",14,"د",2,0],["المحاسيبُ أوصَدُوا كلَّ بابٍ","في وجوه النوابغ الأكفاء",15,"ا",2,0],["المحال الآن يبدو غيره","كذّبت (عرّافه) (الجوف) العرافه",16,"ف",2,0],["المحصناتُ مباحةٌ حرماتُها","تجد السياطَ عَلى الخصورِ وِشاحا",17,"ح",2,0],["المُحرزُ المجدَ عَن جدٍّ يجرّ بهِ","نِجادَ نجدته لا ذيلَ محتفلِ",18,"ل",1,0],["ألمَحض الوجود والموت جئنا","أم لسرٍّ وحكمةٍ مكنونه",19,"ه",1,0],["المُحكِمين عقودَ أقبيةٍ","فيها يُرونَكَ أَوجُها زُهرا",20,"ر",2,0],["المحصي المبدي المعيد الذي","بنفخة يبعث من في القبور",21,"ر",1,0],["المحامون على أحسابهم","بصريحاتٍ من المال وهُجنِ",22,"ن",1,0],["المحرز السبق الأوفى ولا عجب","إذ كنت والده أن يحرز السبقا",23,"ق",2,0],["المُحْسِنينَ لِمنْ أَساء زَمَانُهُ","وتغرَّبتْ أَوْطانُهُ عَنْ أَهْلِهِ",24,"ل",2,0]]}