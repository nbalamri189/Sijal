{"poems":[[88,"حطمت اليراع فلا تعجبي","https://www.aldiwan.net/poem10923.html","المتقارب"],[74,"إنسان عيني ساهر بك سافح","https://www.aldiwan.net/poem18483.html","الكامل"],[47,"رحلت وأودعت الفؤاد لواحظا","https://www.aldiwan.net/poem66839.html","الكامل"],[92,"أرج الشباب وخمره المسكوب","https://www.aldiwan.net/poem60158.html","عموديه"],[76,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[76,"جرر ملاءة كل يوم شامس","https://www.aldiwan.net/poem12971.html","الكامل"],[107,"يا بني النيل تقضى صومكم","https://www.aldiwan.net/poem43154.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55080","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54754","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[96,"جمرة الدنيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66291&r=&rc=9",""],[164,"تولى بعد ما غسل الذنوبا","https://www.aldiwan.net/poem58907.html","الوافر"],[210,"أهدي لذي المجد الرفيع وذي الصفا","https://www.aldiwan.net/poem921.html",""],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[376,"أرأيتني فيما أراك طروقا","https://www.aldiwan.net/poem57281.html","الكامل"],[382,"مفتي الورى بزغت أدلة فضله","https://www.aldiwan.net/poem59253.html","الكامل"],[396,"ياطالبا للوصيه","https://www.aldiwan.net/poem54448.html","عموديه"],[396,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[422,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[422,"عد عن من لج في قال وقيل","https://www.aldiwan.net/poem54131.html","الرمل"],[449,"دع عنك صهباء الدساكر","https://www.aldiwan.net/poem56047.html","عموديه"],[529,"نسب تلاشى في سطوع ضيائه","https://www.aldiwan.net/poem13286.html","الكامل"],[541,"عرفت دياراً بالحمى فشرائث","https://www.aldiwan.net/poem23857.html","الطويل"],[580,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101509","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64356","المتقارب"],[1172,"","https://poetry.dctabudhabi.ae/diwan/poem/111290","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64576","الرجز"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95518","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128711","المتدارك"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128069","الطويل"],[1776,"","https://poetry.dctabudhabi.ae/diwan/poem/84575","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100471","الوافر"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77361","المجتث"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137107",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100220","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74202","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74178","الرمل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112607","الطويل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114399","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135728","الرجز"],[286,"","https://poetry.dctabudhabi.ae/diwan/poem/47076","الكامل"],[4955,"مصير الحزن أن يرحل","https://www.poetsgate.com/ViewPoem.aspx?id=203790",""],[5145,"رحلوا بقلبك عرّجوا أم ساروا","https://www.poetsgate.com/ViewPoem.aspx?id=108063",""],[5183,"هبة العليم","https://www.poetsgate.com/ViewPoem.aspx?id=180194",""],[5186,"لا تعد بي إلى ربوع الخيام","https://www.poetsgate.com/ViewPoem.aspx?id=156442",""],[5367,"سبيل الروح","https://www.poetsgate.com/ViewPoem.aspx?id=197666",""],[5596,"الهجرة النبوية","https://www.poetsgate.com/ViewPoem.aspx?id=205615",""],[1706,"في بطحاء مكة","https://www.poetsgate.com/ViewPoem.aspx?id=102862",""],[6115,"نصايح عشر","https://www.poetsgate.com/ViewPoem.aspx?id=180461",""],[321,"إذا ما علا في الصدر والنهى والأمر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=606417",""]],"verses":[["وَزَكّى أَبو خَطوَةٍ قَولَهُم","بِحُكمٍ أَحَدَّ مِنَ المَضرِبِ",0,"ب",1,0],["وزكت أحاديث الورى عن مجدِهِ","فجميع ما يحكون عنهُ مدائح",1,"ح",1,0],["وَزَكَت مَعالِمُ دَيرِزَكّى بَعدَ أَن","وَسَمَت يَدُ الوَسمِيِّ كُلَّ مَكانِ",2,"ن",1,0],["وَزَكتْ عواطِفُكُمْ فأَيةُ ثروةٍ","منها نكافيءُ مُخلِصاً ونُثيب",3,"ب",1,0],["وَزَكا فَشَدَّ عَلى العَفافِ إِزارَهُ","إِنَّ العَفافَ لَشيمَةُ الأَحرارِ",4,"ر",1,0],["وَزَكا فَلَم يُطرَف بِنَظرَةِ خائِنٍ","يَوماً وَلَم يُعرَف بِعَهدٍ خائِسِ",5,"س",1,0],["وَزَكاةُ الفِطرِ هَذا يَومُها","فَاِجعَلوها لِيَتامى الشُهَداء",6,"ا",2,0],["وَزَكَا الرَّيْعُ مَا زَكَا وَأَتَتْ مَا","لَمْ يَكُنْ فِي حِسَابِهَا الأرْقَامُ",7,"م",1,0],["وَزَكَتْ غِرَاسُ مَعَارِفٍ وَفَضَائِلٍ","بِالحَمْدِ يُذْكَرُ عَهْدُهَا المَوْمُوقُ",8,"ق",1,0],["وَزَكَا البِرَ بي تِباعاً افَما أَكْبَ","رْتُ قَبْلاٌ وَجَدْتُ ضِعْفَيْهِ بَعْدا",9,"د",2,0],["وَزَكَا إِلَى مَحبُوبِهَا تَحْنَانُهَا","بِتَبَغُّضِ الأَحْدَاثِ وَالأَرْزَاءِ",10,"ا",2,0],["وزكا فعند الغوطتين تحيّة","منه تمرّ على الصخور فتورق",11,"ق",1,0],["وزكّى بالعبادةِ كلَّ نفسٍ","وأعطى كل جارحةٍ نَصيبا",12,"ب",2,0],["وزكت على المسك الشذي تعطّراً","وحوت لدي تعززاً وتشرفا",13,"ف",2,0],["وَزَكَت مَحامِدُهُ وَطالَ قُنوتُهُ","حَتّى اِلتَوى وَتَوَرَّمَ القَدَمانِ",14,"ن",1,0],["وزكَت مَودَّتُه وأثمرَ غَرسُها","عَيشاً عَلى طولِ الزمانِ أنيقا",15,"ق",2,0],["وزكت أشعةُ عقله بعلومه","في العالمين فلم يُعَدَّ إمامُ",16,"م",1,0],["وزك ياصاح مالك تحمد وتشكر مآلك","وطهر الدوب بالك ولا تبق بقيه",17,"ه",1,0],["وزك المال يزكو","ويحفظ من ملمات",18,"ت",1,0],["وزكا عنصراً وسادَ غلاما","وكأنِّي به وقد وَلِيَ الأَمرَ",19,"ا",3,0],["وزكَتْ أعراقُهُم منذ نَمَت","بفروع زاكيات وأصول",20,"ل",1,0],["وزكنت معنى القول كم","ترك الأوائل للأواخر",21,"ر",1,0],["وَزَكا وَطابَ وَلَم يَزَل مُتَسَلسِلاً","أَبَدا مِن الأَطهار لِلأَطهار",22,"ر",1,0],["وَزَكّى لَنا حَتّى صَفَت أَطعُماتُنا","فَلَم نَلتَبِس بِالمُرجِساتِ العَثائِثِ",23,"ث",1,0],["وزكَتْ له نفسٌ فما","جَلبت إِليه أَثامها",24,"م",3,0],["وزكت منابتهُ واخصب روضهُ","وجلا المحاسنَ رَقُّهُ المنشورُ",25,"ر",1,0],["وزكى بخاتمه راكعاً","رجاء المجازاة في المنقلب",26,"ب",1,0],["وزكا جدوداً قد سموا","شرفاً على كل الخدود",27,"د",1,0],["وزكاهم بالمد والتبعية","ولفاهم التوحيد في كل ذرة",28,"ه",1,0],["وزكها بالنور والقداسه","لا تلقها في ذلة الخساسه",29,"ه",1,0],["وزكّاه مولانا المليك إجازةً","فلازمه يسرٌ وحالفَه نصرُ",30,"ر",1,0],["وزكت في الخيم عناصره","فأطاب جرائمه الحسب",31,"ب",1,0],["وزكى وماحاز النصاب حياته","وما طيشته وهو أهل مناصب",32,"ب",1,0],["وَزَكى نَفسُ حافِظٍ لِمَقامِهِ","في الدينِ وَالدُنيا باقَومِ خُطَّة",33,"ه",1,0],["وَزَكَرِيّاءُ وَيَحيى الطاهِرُ","قَد أَنذَروا لَو أَغَنتَ المَناذِرُ",34,"ر",1,0],["وزكاك الإله من الخطايا","فطهر فرعك الرحمن منا",35,"ن",2,0],["وَزَكِّ مالَكَ وَاِعلَم","أَنَّ التُقى في الزَكاةِ",36,"ه",1,0],["وزكا محتداً فطارفه في","الفضل والمجد والعلا كالتلاد",37,"د",1,1],["وزكت نفوسكم فطاب أريجها","في حيث نشر المسك فيه يطيب",38,"ب",1,0],["وَزك عَن الإِشراك أَعمالك الَّتي","عَملت لِتجني بِاللقا ثَمر الغَرس",39,"س",1,0],["وَزَكا علماً وَحلماً وَتقى","وَنَوالا وَكَمالا وَكَلاما",40,"م",2,0],["وزّكت نسور الجو قامت بغارة","رمايتها الشعواء تحصد ما بقي",41,"ق",2,0],["وزك مال فضول الغير محتسباً","يخلف عليك بعين الفضل والكرم",42,"م",1,0],["وَزَكَّهِ تَزكِيَةً وَأجمِلاَ","إجمَالَ مَن تَجمُّلاً تَجَمَّلاَ",43,"ل",2,0],["وزكها بالذي تنويه من حسنٍ","كالغيث تزكو به الأزهارُ في الأجمِ",44,"م",1,0],["وزك نفسك واحتل في رياضتها","وهذب الخلق وانأ عن حمى الوصمِ",44,"م",1,0],["وزكِّنا أيا زكي وأزرعا","لنا أيا زارع وأنبت واجمعا",45,"ع",2,0],["وزكتْ مناسبه وطابَ المحتد","وتأثلّت علياؤه والسؤددُ",46,"د",1,0],["وزَكِّ النَّفسَ قوِّمها","حرامَ المالِ لا تقبلْ",47,"ل",1,0],["وزكت عناصرهم وطاب فروعهم","فز كالغراس وطابت الأثمار",48,"ر",1,0],["وزكت بحكمتها وفصل خطابها","تثني على داؤد وهي ثناؤه",49,"ا",3,0],["وزكاة تأتي على عوز المس","كين فينا وشقوة الأيتام",50,"م",1,0],["وزَكِّ النَّفسَ تَظْفَرْ بالتَّرقِّي","زكاةُ النَّفسِ مَبدأُ الاِرتقاءِ",51,"ا",2,0],["وزكت بحور الشعر من أمواجه","حتى رمته بدُرّها الأحشاء",52,"ا",2,0],["وزكا عندها الهدى، فهي للكو","نِ جمالٌ، ورحمةٌ، وإخاء",53,"ا",2,0],["وزكاة مالك والصيام وحجك","حتى تكمّل خمسة الأركان",54,"ن",1,0],["وزكَّتكَ أوراقُ المصاحف وانتهى","إلى الله منها طولُ درسك والذكرِ",55,"ر",1,0]]}