{"poems":[[87,"أيامكم أم عهد إسماعيلا","https://www.aldiwan.net/poem63755.html","الكامل"],[54,"قد كلمت عينه عيني فهنوني","https://www.aldiwan.net/poem26652.html","البسيط"],[52,"راجعت دينك أم عنت لك الذكر","https://www.aldiwan.net/poem63829.html","البسيط"],[48,"إجعل تقاك الهاء تعرف همسها","https://www.aldiwan.net/poem22561.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54775","المنسرح"],[108,"استعطاف وتبرئة","https://www.poetsgate.com/ViewPoem.aspx?id=179393",""],[159,"قالوا جفاك الذي تهوى فقلت لهم","https://www.aldiwan.net/poem55537.html","البسيط"],[164,"قد أوعدتني بالزيارة في الكرى","https://www.aldiwan.net/poem58874.html","الكامل"],[164,"من قوم المرء بالمكروه تثقيفا","https://www.aldiwan.net/poem59015.html","البسيط"],[203,"قالوا جفتك ولا تنفك تذكرها","https://www.aldiwan.net/poem45233.html","البسيط"],[203,"قالوا جنون قلت إي والذي","https://www.aldiwan.net/poem45384.html","السريع"],[242,"حدث عرف الصبا عن نفحة الزهر","https://www.aldiwan.net/poem18797.html","البسيط"],[261,"قال وأجفان مقلتيه تكف","https://www.aldiwan.net/poem48410.html","المنسرح"],[325,"وسيع صدري انقضت في ضيقه حيلي","https://www.aldiwan.net/poem67221.html","البسيط"],[371,"سرحت دمعي لا تسريح إحسان","https://www.aldiwan.net/poem17134.html","البسيط"],[371,"قالوا جرى قلمي في غير مدحكم","https://www.aldiwan.net/poem17273.html","البسيط"],[427,"طال اشتياقي ولا خل يؤانسني","https://www.aldiwan.net/poem46391.html","البسيط"],[458,"وطني رأيتك في الربيع فعطره","https://www.aldiwan.net/poem61597.html","الكامل"],[484,"قالو أجابت سؤلك الأيام","https://www.aldiwan.net/poem36944.html","الكامل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44567","السريع"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48724","الكامل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202069","الرجز"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216670",""],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141351","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87836","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28583","البسيط"],[2467,"","https://poetry.dctabudhabi.ae/diwan/poem/111778","البسيط"],[2675,"","https://poetry.dctabudhabi.ae/diwan/poem/200264","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200218","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132555","الكامل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121679","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112629","الرجز"],[3869,"","https://poetry.dctabudhabi.ae/diwan/poem/34860","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102982","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44722","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94512","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28621","الكامل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136440",""],[4728,"يا طير يا ساجع","https://www.poetsgate.com/ViewPoem.aspx?id=176959",""],[4869,"قالوا جديدك غاب","https://www.poetsgate.com/ViewPoem.aspx?id=151649",""],[5145,"أذر الدموع فلات حين مجاز","https://www.poetsgate.com/ViewPoem.aspx?id=108241",""],[5150,"عتاب وندم ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203557",""],[5358,"أتى وحيدُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=183426",""],[5373,"عِيْلَان والتَّهجِير إلى أوروبا","https://www.poetsgate.com/ViewPoem.aspx?id=186019",""],[5490,"ماغيبوك","https://www.poetsgate.com/ViewPoem.aspx?id=176355",""],[5732,"قالو تتوب وقلت بالطرف مصيوب","https://www.poetsgate.com/ViewPoem.aspx?id=177872",""],[5792,"قالو جماله","https://www.poetsgate.com/ViewPoem.aspx?id=180356",""],[5970,"ما بين قلب كليم آرق عاني","https://www.poetsgate.com/ViewPoem.aspx?id=130614",""],[6070,"قولي بربكِ ما الذي أبكاكِ","https://www.poetsgate.com/ViewPoem.aspx?id=189501",""],[242,"حدث عرف الصبا عن نفحة الزهر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563748",""]],"verses":[["قالوا جَلَبتَ لَنا الرَفاهَةَ وَالغِنى","جَحَدوا الإِلَهَ وَصُنعَهُ وَالنيلا",0,"ل",2,0],["قالوا جُنِنتَ بِلا شَكٍّ فَقُلتُ لَهُم","ما لِذَّةُ العَيشِ إِلّا لِلمَجانينِ",1,"ن",1,0],["قالوا جَهَلتَ بِذِكراها فَقُلتُ لَهُم","لا بَل جُنِنتُ فَكُفّوا اللَومَ وَاِزدَجِروا",2,"ر",3,0],["قالوا جَهَنَّمُ قُلتُ إِنَّ شَرارَها","وَلَهيبَها يَصلاهُما المُتَشَرِّرُ",3,"ر",1,0],["قَالُوا جُنُونُ الصَّرْعَى بِشَهْوَتِهِمْ","عَقْلٌ لِمَنْ يَشْتَهِي وَيَبْتَعِدُ",4,"د",1,0],["قالوا: جَلِيلةُ. قلنا: لا تقاسُ بها","وإن جرى دمعها من عينها سُحُبا",5,"ب",2,0],["قَالوا جَفَاكَ الَّذي تَهْوى فَقُلْتُ لَهُمْ","نَوْمِي تَعَلَّمَ مِنْهُ فَهْوَ يَجْفُوني",6,"ن",2,1],["قالوا جرى ذكرى فرقّت رحمة","حتى تداعى دمعُها وتحدّرا",7,"ر",2,0],["قالوا جفاك ابن إسمعيل قلت لهم","من ظن ذلك ظن البحر منزوفا",8,"ف",2,0],["قالوا جفتك ولا تنفكُّ تذكرها","إن النصيحةَ سلوانٌ بسلوانِ",9,"ن",1,1],["قالوا جنونٌ قلتُ إي والذي","يقدرُ الهمَّ لمن يعقلونْ",10,"ن",1,1],["قَالُوا جَمِيعاً شُرُودُ الأُنْسِ مُقْتَنَصٌ","بَيْنَ الرُّبَى بِشِبَاكِ الشَّمِّ وَالنَّظَرِ",11,"ر",1,0],["قال وأجفان مقلتيه تكف","وجسمه ظاهر السقام دنف",12,"ف",1,1],["قالوا جَنَحَت وَلا وَاللَهُ ما صَدَقوا","إِلّا إِلى الحَقِّ لا لِلأَثَمِ وَالزَلَلِ",13,"ل",1,0],["قالوا جُموعٌ مِنَ العُذّالِ حاشِدَةٌ","إِلَيكَ ما بَينَ ضَرّابٍ وَطَعّانِ",14,"ن",1,0],["قالوا جَرى قَلَمي في غَيرِ مَدحِكُمُ","لا وَالَّذي عَلَّمَ الإِنسانَ بِالقَلَمِ",15,"م",1,1],["قالوا جُنِنت بمن تهوى فقُلتُ لهُم","ما لذَّةُ العيشِ إلّا للمجانينِ",16,"ن",1,0],["قالوا جننتَ نعم جُننتث وقد غدا","ذاك الدخيل مضيعيِ ومعنفِّي",17,"ف",2,0],["قالو أجابت سؤلك الأيام","يا حبذا لو صحت الأحلام",18,"م",1,1],["قالوا جَهِلنا فَاِغتَفِر جَهلَنا","فَلَيسَ عَن ذا لِاِمرىءٍ صَبرُ",19,"ر",1,0],["قالوا جزعت فقلت أي مشوقٍ","أضحى وقد غُلَّت يداه جليدا",20,"د",2,1],["قالوا جماد هي لا تُكلَّف","ومِثلَ هذا الفعْلِ يأْبَى الُمْنصف",21,"ف",1,0],["قالوا جميل وقلْت لا تظلمونه","إلّا اذا ضِفْتُوا على الحسن لاخلاقْ",22,"ق",1,1],["قالوا جهول من يفارق داره","بل كان من لزم الدّيار جهولا",23,"ل",2,0],["قالوا جُنِنتَ نَعَم جُنِن","تُ بِحُسنِكِ المُغري وَقَدِّك",24,"ك",1,0],["قالوا جَميلاً وَلَكِن قَلَّما فَعَلوا","مِنهُ وَصَدَّقتُ أَقوالي بِأَفعالي",25,"ل",2,0],["قالوا جُنِنتَ على ليلى فقلت لهم","الحب أيسَرُهُ ما بالمجانين",26,"ن",1,1],["قالوا جفاه ثلاثاً ثم غرّبه","فليس يرجو لديه حظوةً أبدا",27,"د",2,1],["قالوا جرى التنسيق قلتُ إليكم","عنّي فليس يُصيبني بِرشاش",28,"ش",1,1],["قالوا جنى ذنباً ولا","والله لست من الجناة",29,"ا",2,1],["قالوا جَهَنَّمُ دارُ الخلدِ ساكنُها","إذا تَطاوَلَ دهرٌ أَخمَدَ اللَّهَبَا",30,"ب",2,1],["قالوا جميعاً ولماذا نَفعلُ","نَظَلُّ أحياء وأنتَ تَقتَلُ",31,"ل",1,0],["قالوا جَميعاً أَنَّهُ قاسِمٌ","أَشبَهَ آباءً لَهُ صيدا",32,"د",2,0],["قالوا جنيت فقلت أي جناية","لهوى النفوس بما عليها قدرا",33,"ر",2,0],["قالوا جَميعاً كُلَنا عَبيدُ","فَامرْ بِما تَشاءُ أَو تُريدُ",34,"د",1,0],["قالوا جميلةُ ربعِنا قلت اصدقوا","آلوا جمارى إنها لجميله",35,"ل",2,0],["قالوا جَزِعتَ فَقُلتُ إِنَّ مُصيبَةً","جَلَّت رَزِيَّتُها وَضاقَ المَذهَبُ",36,"ب",1,1],["قالوا جميعاً على الاجمال كان به","كل الجميل ومن كل العيوب بري",37,"ر",2,0],["قالوا جوادك قد كبا واقول (أنّى يؤفكون؟)","كبوة نهار الحمد لله ومهي كبوة دهر",38,"ر",1,0],["قالوا جديدك غاب وقلت العتب ليه","اغلب قصيدي راح في ظلمة الليل",39,"ل",1,1],["قالوا: جمال الدين والحبر الذي","يعزو العلوم معاً إليه العازي",40,"ز",2,0],["قالوا جفاكِ.. ولكنْ ما وثقتُ بهمْ","حتى وأقنعتُ نفسي أنهمْ زعَموا",41,"م",3,0],["قالوا جِهاداً فصارتْ كلُّها رجُلاً","هدَّ الجِبالَ إلى الأنبارِ سَبّاقا",42,"ق",2,0],["قَالُوا جَنَى أَمْوَالَهُ مِنْ سَفَرٍ","كُلُّ القُلُوْبِ لِلرَّحِيْلِ تَخْفِقُ",43,"ق",1,0],["قالوا جثا الليلُ معقوداً بدُهمَتِهِ","وغيّبوكَ بقلبِ الليلِ فانفلَقا",44,"ق",2,0],["قالوا جهلت وعقلك اليوم منهوب","وكشفت سرك بين ربعك والاجناب",45,"ب",1,0],["قالوا جماله كامل الحسن وافي","شوفه عسى تكتب قصيده جديده",46,"د",2,1],["قالوا جنيت على نفسي فقلت لهم","كل علي نفسه في دهره جاني",47,"ن",2,0],["قالوا جُننتَ بحسنها ودلالها","قُلتُ الحقيقةَ إنَّني أهواكِ",48,"ك",1,0],["قالوا جَميعاً شَرودُ الأُنسِ مُقتَنَسٌ","بَينَ الرُبى بِشَباكَ الشَمِّ وَالنَظَر",49,"ر",1,0]]}