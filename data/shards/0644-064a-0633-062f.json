{"poems":[[33,"إن طيف الخيال حين ألما","https://www.aldiwan.net/poem41313.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55035","الخفيف"],[92,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[33,"إنَّ طَيْفَ الخَيَالِ حِينَ أَلَمّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19089&r=&rc=351",""],[309,"ليس دين الله بالحبل","https://www.aldiwan.net/poem16852.html","المديد"],[333,"لك يا وجهي التعيس هجائي","https://www.aldiwan.net/poem55014.html","الخفيف"],[543,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[556,"ليس دار الزوراء دار مقام","https://www.aldiwan.net/poem47209.html","الخفيف"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127963","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141295","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201721","الخفيف"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75907","الرمل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131073",""],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111196","الخفيف"],[1703,"أيّها العالم الأديب المكرّم","https://www.poetsgate.com/ViewPoem.aspx?id=49871",""],[5232,"ألحان السَّلام","https://www.poetsgate.com/ViewPoem.aspx?id=213566",""],[5320,"غفران","https://www.poetsgate.com/ViewPoem.aspx?id=41644",""],[5891,"أحلام الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=39927",""]],"verses":[["لَيسَ دونَ الحَياةِ وَالمَوتِ إِلّا","أَن يَرُدّوا جِمالَهُم فَتُزَمّا",0,"م",2,0],["لَيْسَ درّاً وَإِنْ بَدَا","لاَمِعاً بَاطِنَ الصَّدَفْ",1,"ف",1,0],["ليسُدَّ \" السوطُ \" مَجْرَى فكرةِ","وتُعيقَ \" النارُ \" قَولاً أنْ يُقالا",2,"ل",2,0],["ليس دونَ الحياة والموت إلا","أَحْسَنَ اليَوْمَ صُورَة ً، وَأَتَمَّا؟",3,"م",2,0],["ليس دين اللَه بالحبل","فانتبه يا راقد المقل",4,"ل",1,1],["ليس دأبى الاطراءُ إلّا لغيري","وحرامٌ على فمي إطرائي",5,"ا",2,0],["ليسَ دوَاءٌ يَشفي","هُبُّوا إلى الأَكفَانِ",6,"ن",1,0],["ليس دارُ الزّوراءِ دارَ مُقامٍ","وثراها حربٌ لماءِ الغَمامِ",7,"م",1,1],["ليس دأبى نظم القريض ولكن","عله في الامير منى علاله",8,"ل",2,0],["ليس داء الصّدور داء عضالا","إنمّا الداء داء من ليس يفهم",9,"م",1,0],["ليس دار الهوان للحُرِّ دارًا","إنما الحر داره الجوزاء",10,"ا",1,0],["لِيسَ داءُ الحُبِّ يشفى بِالرُقى","لا وَلا يَنفَعُ تَعليقُ العوَذ",11,"ذ",1,0],["ليس دون الأسطول يا قوم حام","ترتجيه فروق والبسفور",12,"ر",1,0],["ليس ديني سوى الكؤوس ولحن","رددته السقاة هاتي وهاكا",13,"ك",2,0],["ليس داء الصّدور داء عضالا","إنمّا الداء من ليس يفهم",14,"م",1,0],["ليسَ ديني ليسَ لوني مَانعا ً","أنْ أحب َّ الناسَ من سام ٍ وحامْ",15,"م",1,0],["ليس دين المرء فى لبس المسوح","لا ولا من حج واعتمر",16,"ر",1,0],["ليس دين الله فيكم لعبة","لا ولاكنتم به تستهزؤن",17,"ن",1,0]]}