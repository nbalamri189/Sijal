{"poems":[[95,"حكوا لنا عن حمارٍ","https://www.aldiwan.net/poem11072.html","المجتث"],[56,"سألت الندى لا عدمت الندى","https://www.aldiwan.net/poem27636.html","المتقارب"],[91,"لاقى اسامة وهو الضيغم الضاري","https://www.aldiwan.net/poem44740.html","البسيط"],[91,"البحر يغلى كان البحر بركان","https://www.aldiwan.net/poem44779.html","البسيط"],[91,"أحاطت بليل اليأس مني غياهب","https://www.aldiwan.net/poem44938.html","الطويل"],[91,"إليك تتوق أيتها السماء","https://www.aldiwan.net/poem44967.html","الوافر"],[87,"لما دعا داعي أبي الأشبال","https://www.aldiwan.net/poem8042.html","الرجز"],[82,"حتى متى بين اللوى فالأجرع","https://www.aldiwan.net/poem31391.html","الرجز"],[35,"تذكرت ليلى والسنين الخواليا","https://www.aldiwan.net/poem25753.html","الطويل"],[35,"أقول لمفت ذات يوم لقيته","https://www.aldiwan.net/poem25841.html","الطويل"],[107,"إلى الله فارغب يا عدي بن حاتم","https://www.aldiwan.net/poem44010.html","الطويل"],[107,"ديار مكة هذا خالد دلفا","https://www.aldiwan.net/poem44044.html","الكامل"],[107,"ما يكسب المرء من إثم ولا يزر","https://www.aldiwan.net/poem44197.html","الطويل"],[50,"وأبيض مثل البدر دارة وجهه","https://www.aldiwan.net/poem62527.html","الطويل"],[50,"بادر شبابك قبل الشيب والعار","https://www.aldiwan.net/poem63284.html","البسيط"],[52,"أضعت بين الألى مضوا حرقا","https://www.aldiwan.net/poem62395.html","المنسرح"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30494","المتقارب"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67306","الوافر"],[111,"غوث الوجود اغثني ضاق مصطبري","https://www.poetsgate.com/ViewPoem.aspx?id=517",""],[124,"ما أنس لا أنس أياما نعمت بها","https://www.aldiwan.net/poem49318.html","البسيط"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[292,"أبلغ ضبيعة أن البلاد","https://www.aldiwan.net/poem1919.html","المتقارب"],[360,"أقول لمفت ذات يوم لقيته","https://www.aldiwan.net/poem61025.html","الطويل"],[368,"بالعفر دار من جميلة هيجت","https://www.aldiwan.net/poem1718.html","الطويل"],[409,"الحمد لله الذي لا يفي","https://www.aldiwan.net/poem33643.html","السريع"],[422,"أقول لها يوم جدت بنا","https://www.aldiwan.net/poem53955.html","المتقارب"],[510,"التوبة","https://www.aldiwan.net/poem27892.html","الطويل"],[563,"فراشتي رأت النور الذي ظهرا","https://www.aldiwan.net/poem34480.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66763","الرجز"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86593","المجتث"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86931","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38924","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77563","الرجز"],[966,"","https://poetry.dctabudhabi.ae/diwan/poem/146425","المتقارب"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126121","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126130","الرجز"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104466","الرجز"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89554","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27983","الطويل"],[2255,"","https://poetry.dctabudhabi.ae/diwan/poem/34918","البسيط"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88698","البسيط"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21619","الوافر"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140086",""],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58431","المنسرح"],[2939,"","https://poetry.dctabudhabi.ae/diwan/poem/146981","المنسرح"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112667","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112629","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74073","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74079","المنسرح"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86340","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91567","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131125",""],[3803,"","https://poetry.dctabudhabi.ae/diwan/poem/143544","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114372","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40055","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95005","الوافر"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73416","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141683","البسيط"],[5000,"العين والقلب","https://www.poetsgate.com/ViewPoem.aspx?id=7184",""],[5010,"بِشُكْرِ النَّعِيْمِ تَدُوْمُ النِّعَم","https://www.poetsgate.com/ViewPoem.aspx?id=190322",""],[5299,"طيف","https://www.poetsgate.com/ViewPoem.aspx?id=210542",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[4623,"كتمت الهوى لكن نحولي به باحا ومن (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146769",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[6164,"أطوار..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66060&r=&rc=69",""],[2220,"سرائر سرٍّ لا تصان ولا تفشى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11504&r=&rc=378",""]],"verses":[["فقال بين التدني","بقول والتعالي",0,"ل",2,0],["فَقالَ بَلى لَم أَزَل غائِباً","وَلَكِن قَدِمتُ مَعَ المُطَّلِب",1,"ب",1,0],["فقال بالقتل يغريني السعار فسل","من كان يقتل لهواً بالدم الجاري",2,"ر",2,0],["فقال بل قد ثوى في لجه غرقا","واللج قبر له والموج اكفان",3,"ن",1,0],["فقال بصوت هزَّ أوتاره الأسى","فرَّنت رنيناً أكبرته المصائب",4,"ب",1,0],["فقال بلى فقلت له أليس ال","عناصر لا تحسُّ ولا تشاءُ",5,"ا",2,0],["فقال بلى فقلت إذن فماذا","جرى حتى استتب لها النماءُ",5,"ا",2,0],["فَقالَ بِاِسمِ خالِقِ الشَعير","وَباعِثِ العَصا إِلى الحَمير",6,"ر",1,0],["فَقالَ بَل ربعُهُمُ وَإِنَّما","تَحَمّلَتْ عَنّي شموسُ مَطلَعي",7,"ع",2,0],["فَقالَ بَصيرُ القَومِ أَلمَحتُ كَوكَباً","بَدا في سَوادِ اللَيلِ فَرداً يَمانِيا",8,"ي",2,0],["فَقالَ بَلى وَاللَهِ سَوفَ يَمَسُّها","عَذابٌ وَبَلوى في الحَياةِ تَنالُها",9,"ل",3,0],["فقال بَلَى إنّي إلى اللَّهِ تائبٌ","وإنّي رأيتُ الحقَّ ضربةَ لازِم",10,"م",1,0],["فقال بُورِكْتَ إنّ الله حَرَّفَها","وما تَغَيَّرَ لي رأيٌ ولا انْحَرَفَا",11,"ف",2,0],["فقال بُوركتَ من هادٍ لأُمّتهِ","تعيا بحكمته الألبابُ والفِكَر",12,"ر",1,0],["فَقالَ بِوَجهٍ مُشرِقٍ مُتَبَسِّمٍ","وَقَد كِدتُ أَقضي لِلهَوى أَنتَ تَمزَحُ",13,"ح",1,0],["فَقالَ بَعضُهُمُ لَمّا رَأَوا عَجَباً","في الكَأسِ تَحتَ الدُجى مِن زِندِها الواري",14,"ر",2,0],["فَقالَ بَعضُ الحَديثِ يَشغَفُني","وَالقَلبُ راءٍ ما لا يَرى البَصَرُ",15,"ر",1,0],["فقالَ بلِ العفُو ياسيّدِي","وقَبَّلَني مِن بَعِيدٍ وضَمّ",16,"م",1,0],["فَقَالَ بَلَى لَقَدْ أَدَّيْتُ حقّاً","يُصَدّقُني بهِ الفَهِمُ الخبيرُ",17,"ر",1,0],["فقال بعضهم سحر وبعضهم","سجع وبعض أساطير من الزبر",18,"ر",1,0],["فقال بعد سكوت خفت روعته","أنظر إلى الشمس في ثوب من الأصل",19,"ل",1,0],["فقال بئس لعمري أنت من دعب","في كل أمر وبئس الخلق في الرجل",19,"ل",1,0],["فقال بأن الرب والعبد واحد","فربي مربوبي بغير تغاير",20,"ر",1,0],["فَقالَ بَلى إِنَّني راكِبٌ","وَإِنّي لِقَومِيَ مُستَعتِبُ",21,"ب",1,0],["فقال بلى واللَه أن سيصيبها","من اللَه بلوى في الحياة تنالها",22,"ل",3,0],["فَقال بَصيرٌ يَستَبينُ رِعالَها","هُمُ وَالإِلَهِ مَن تَخافينَ فَاِذهَبي",23,"ب",2,0],["فقال بل حُبَّا وخوفاً على","شيبته من وقفة الموقف",24,"ف",1,0],["فقال بها والهوى جنَّة","وكم أَتْلَفَ الشَّوقُ أمثالَها",25,"ل",3,0],["فقال بجفْنيك أرى ذا المولول","الذي كلّما أطلّ شقّ بقائيهْ",26,"ي",2,0],["فقال بعض هوت للنار تعبدها","والبعض قال عليها وَهْمُها قهرا",27,"ر",2,0],["فقال بالله تهددوني","يا أيها الغلمة أقعدوني",28,"ي",1,0],["فقال بعض القوم قد يسمي","على لغات العرب ابن العم",28,"م",1,0],["فقال بايعوا له وسلِّموا الأ","مرَ إليه واسلَموا من الزَلَلْ",29,"ل",1,0],["فَقال بِالسَعد أَرّخ","الجاه باب لراغب",30,"ب",1,0],["فَقالَ بِلا سؤل تَفوز بِما تَشا","سَريعاً مِن الباشا مُدير المَدارس",31,"س",1,0],["فَقالَ بُشراكُم إِنّ الوزارَة قَد","بَدَت كَبدرِ دُجى في الأُفقِ سبّاحِ",32,"ح",1,0],["فَقالَ بَعدُ لَهُما يَكفيكما","بِالخَير عَني سادَتي جُزيتُما",33,"م",2,0],["فقال: بعيني أقيك الردى","فقلت: على عينك الواقيه",34,"ي",2,0],["فقال بالتفويض فيه السلف","وبين المراد منه الخلف",35,"ف",1,0],["فقال بل أراد لكن ثبطك","عنه أبو مرة حين خبطك",36,"ك",1,0],["فقال بعض منهم الدار الخضر","وآخرون بينوا ان ننتظر",37,"ر",1,0],["فَقالَ بِعِلمٍ إِذ تَفَوَّهَ قائِلاً","وَإِلّا رَأى الإِمساكَ خَيراً فَلَم يُبدِ",38,"د",1,0],["فقال بأنَّ الضوءَ ممتزجٌ وما","نوى بالذي قد قال سءاً ولا غشا",39,"ش",2,0],["فَقالَ بِالصينِ أَلوانٌ تَلينُ لَها","صُلبُ القُلوبِ وَأَمرٌ لَيسَ بِالدونِ",40,"ن",1,0],["فَقالَ بشراك نص دار في خلدي","واي نص اتى في الجار مأَثور",41,"ر",1,0],["فَقالَ بَكوا لِفَقدِكَ مُنذُ حينٍ","زَماناً ثُمَّ إِنَّ الحَيَّ سارا",42,"ر",2,0],["فقال بل من عصير خدي","وما تفاحة المخضب",43,"ب",1,0],["فقالَ بردُ الوضوءِ قَلّصَهُ","وليسَ يَخفى هذا على طِبِّيْ",44,"ب",2,0],["فقال: بهرجت ذا الخفيف لنا","فقلت: والضرب خارج الدار",45,"ر",1,0],["فقالَ بعضُ الحاضرينَ منهُمُ","هَلَكتُمُ وأنتُمُ لم تَعلَموا",46,"م",3,0],["فقالَ بعدَ الحمد والثناءِ","والشكرِ للمنعم ذي الآلاء",47,"ا",2,0],["فَقالَ بَشير الخَير هبّوا إِلى العلا","وَقالَ نَذير الشرّ لا تَتَعَجّلوا",48,"ل",3,0],["فُق البَرايا وَسد غطارفها","فَأَنتَ يا ذا الجَلال سيّدها",49,"د",3,0],["فَقالَ بِعَهدِ وُدّي كُن وَثوقاً","وَلا تَسمَع الى قيلٍ وَقالِ",50,"ل",1,0],["فقال بَلى وَلَكن لَونُ خدّي","وَثَغري أَثّرا فيما رَأيتا",51,"ت",2,0],["فقال بعضهم قد أبدلوا غلطا","قالت صدقت فما نفعي من الجدل",52,"ل",1,0],["فقال بلى ولكني لأمرٍ","رجعت فتبت عن قولي أتوب",53,"ب",1,0],["فقال بنومٍ يا عتيقُ إذا فرغ","تَ فاتِ تجد ربا ينجيكَ من ضرم",54,"م",1,0],["فَقالَ بَلِ الهِلالُ فَقلتُ حَقّاً","ولكنْ لِم نَزَلْتَ من السَّماءِ",55,"ا",2,0],["فقال بغصة الحتف","بروحك مصرعي يكفي",56,"ي",1,0],["فقال بزاهق الأنفاس","آه أجل بلوتك ذا",56,"ذ",2,0],["فقال بشيرنا جبريل سُرّوا","فذرَّت في سما أسمى المقامِ",57,"م",1,0],["فقالَ بيتاً سَرى كالشَّمسِ في مَثَلٍ","مُوَلَّدٍ من لُبابِ الشِّعرِ سَيّارِ",58,"ر",1,0],["فقال بعض أقينُ أنت قلت نعم","أقين شعراً وعندي معمل الكذب",59,"ب",1,0],["فقال بخفقٍ تَرْجَمَ الشِّعرُ نبضَه:","إليكَ! فإنّي بالجراحِ مُضرَّجُ!",60,"ج",1,0],["فَقَالَ بِصَوْتٍ بِهِ نَغْمَةٌ","يُحَشْرِجُهَا النَّوْمُ : لَا تَنْهَزِمْ",61,"م",1,0],["فَقَالَ بِصَوْتٍ خَافِتٍ أنَسِيتِنِي","وَحُبُّكِ يَسْري فِي عُرُوقِي كَمَا الدَّمُ؟!",62,"م",1,0],["فقال بقول الجهم جهلاً ضلالة","قد هكم فيها بالهوى فتهدما",63,"م",2,0],["فقال بلى يا ربنا أنت ربنا","فاذهب عنهم إذ بها باح أتراحا",64,"ح",2,0],["فقال بلى قبل الجواهر مطلقا","وقفت على آثاره كل ذرتي",65,"ت",2,0],["فقال .. بَلى . إنَّ التَّدَبُّرَ نِعْمَةٌ","عَلَيْكَ. وقد يَتْلُو.. فَيَهْدِي التَبصُّرُ!",66,"ر",1,0],["فقال بأنَّ الضوءَ ممتزجٌ وما","نوى بالذي قدْ قالَ سوءاً ولا غشا",67,"ش",2,0]]}