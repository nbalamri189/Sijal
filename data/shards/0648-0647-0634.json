{"poems":[[79,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[79,"لقد زالت اللأواء وارتفع الجهد","https://www.aldiwan.net/poem36547.html","الطويل"],[88,"هنيئا أيها الملك الأجل","https://www.aldiwan.net/poem68929.html","الوافر"],[87,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[76,"أيجني على مهجتي طرفه","https://www.aldiwan.net/poem13177.html","المتقارب"],[303,"عذيري من حليف ذي خصال","https://www.aldiwan.net/poem36815.html","عموديه"],[457,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48600","الخفيف"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100134","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50038","الوافر"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52028","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117992","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[4579,"","https://poetry.dctabudhabi.ae/diwan/poem/205457","الخفيف"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67456","الكامل"],[5060,"بعض أهلّة","https://www.poetsgate.com/ViewPoem.aspx?id=214499",""],[5956,"أجدد شعري","https://www.poetsgate.com/ViewPoem.aspx?id=201539",""]],"verses":[["وَهَشَّ عَلَى يَمِّ الشَّدَائِدِ بَالْعَصَا","وَوَافَقَ إِذْنَ اللهِ فَانْفَرَقَ الْيَمُّ",0,"م",1,0],["وهَشّ عليْها البرْقُ بالسّوْطِ فانْبَرَتْ","تُدافِعُ في عَرْضِ الفَلاةِ وتشْتَدُّ",1,"د",1,0],["وَهَشَّ التاجُ حينَ عَلا جَبيناً","عَلَيهِ مَهابَةٌ وَعَلَيهِ نُبلُ",2,"ل",1,0],["وَهَشَّتِ الرَوضَةُ الفَيحاءُ ضاحِكَةً","إِنَّ المُنَوَّرَةَ المِسكِيَّةَ التُرُبِ",3,"ب",1,0],["وَهَشَّ إِلى رَكضِهِ ظَهرُهُ","وَحَنَّ إِلى كَفِّهِ عُرفُهُ",4,"ف",2,0],["وهشَّ وبشَّ مبتسماً فيا مَنْ","رأى ذئباً تبسَّم للسِخال",5,"ل",1,0],["وهشامٍ إِذ استبد اختياراً","بالرساطون واستلذ اختياره",6,"ر",2,0],["وهشيماً أضحى فإن ناله الما","ء وهبَّ الهواء فهو قتيلُ",7,"ل",1,0],["وهشم مجد هاشمها وأزرى","نزار وجد للعليا حدادا",8,"د",2,0],["وهشَّ وبشَّ كالسَّيف المحلَّى","بَدا واهتزَّ كالرُّمح الرُّديني",9,"ن",2,0],["وهشيما عظامُهُ تتداعَى","وإلى التُّربِ مرجعُ الإنسانِ",10,"ن",1,0],["وَهَشَّ لِدَفْعِ الضَّيْمِ أوَّلَ وَهْلَةٍ","هَشَاشَةَ مَنْ يُدْعَى لأخْذِ الرَّغَائِبِ",11,"ب",1,0],["وهشّت قلوب جميع العباد","وخامرها الفرح المستديم",12,"م",1,0],["وهشت تعزيها وألقت بكفها","لها قدحاً يزهو بعسجده الوقد",13,"د",1,0],["وهشاماً خليفة الله فاعمد","واصرمن مرة القوي الجليد",14,"د",1,0],["وهشمت أنت أنوفها","ذا الخلق في طلب الثريد",15,"د",1,0],["وهشاشةٌ في معصميْهِ ورجفةٌ","تُعيي المسيرَ.. ومشيةٌ مختلّة !",16,"ل",2,0],["وهشَّتْ تقاطيعها في يديَّ","هشاشةَ طفل لجمعِ الزُّهورْ",17,"ر",1,0]]}