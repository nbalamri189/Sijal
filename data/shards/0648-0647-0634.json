{"poems":[[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[77,"لقد زالت اللأواء وارتفع الجهد","https://www.aldiwan.net/poem36547.html","الطويل"],[86,"هنيئا أيها الملك الأجل","https://www.aldiwan.net/poem68929.html","الوافر"],[85,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[74,"أيجني على مهجتي طرفه","https://www.aldiwan.net/poem13177.html","المتقارب"],[298,"عذيري من حليف ذي خصال","https://www.aldiwan.net/poem36815.html","عموديه"],[452,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"]],"verses":[["وَهَشَّ عَلَى يَمِّ الشَّدَائِدِ بَالْعَصَا","وَوَافَقَ إِذْنَ اللهِ فَانْفَرَقَ الْيَمُّ",0,"م",1,0],["وهَشّ عليْها البرْقُ بالسّوْطِ فانْبَرَتْ","تُدافِعُ في عَرْضِ الفَلاةِ وتشْتَدُّ",1,"د",1,0],["وَهَشَّ التاجُ حينَ عَلا جَبيناً","عَلَيهِ مَهابَةٌ وَعَلَيهِ نُبلُ",2,"ل",1,0],["وَهَشَّتِ الرَوضَةُ الفَيحاءُ ضاحِكَةً","إِنَّ المُنَوَّرَةَ المِسكِيَّةَ التُرُبِ",3,"ب",1,0],["وَهَشَّ إِلى رَكضِهِ ظَهرُهُ","وَحَنَّ إِلى كَفِّهِ عُرفُهُ",4,"ف",2,0],["وهشَّ وبشَّ مبتسماً فيا مَنْ","رأى ذئباً تبسَّم للسِخال",5,"ل",1,0],["وهشامٍ إِذ استبد اختياراً","بالرساطون واستلذ اختياره",6,"ر",2,0]]}