{"poems":[[95,"حيوا الإمام الحق في الإسلام","https://www.aldiwan.net/poem11378.html","الكامل"],[29,"حيوا أمامة واذكروا عهدا مضى","https://www.aldiwan.net/poem5655.html","الكامل"],[29,"حيوا المقام وحيوا ساكن الدار","https://www.aldiwan.net/poem5782.html","البسيط"],[29,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[29,"حيوا الديار وأهلها بسلام","https://www.aldiwan.net/poem6005.html","الكامل"],[87,"قم للمعلم وفه التبجيلا","https://www.aldiwan.net/poem15422.html","الكامل"],[63,"عش مدى الدهر يا أبا إسحاق","https://www.aldiwan.net/poem51505.html","الخفيف"],[82,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[107,"حيوا بمصر حماتها الأحرارا","https://www.aldiwan.net/poem42107.html","الكامل"],[107,"حيوا الهلال وحيوا أمة النيل","https://www.aldiwan.net/poem43087.html","البسيط"],[107,"الله أكبر جل الخطب واحتكمت","https://www.aldiwan.net/poem43158.html","البسيط"],[107,"تعلموا كيف تبني مجدها الأمم","https://www.aldiwan.net/poem44217.html","البسيط"],[77,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[48,"فقدت في أيامك العلماء","https://www.aldiwan.net/poem22013.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39593","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55080","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54584","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54978","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54714","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[109,"طمنوا ستي ام عطا","https://www.poetsgate.com/ViewPoem.aspx?id=29671",""],[135,"حيوا تماضر واربعوا صحبي","https://www.aldiwan.net/poem24172.html","الكامل"],[139,"حي ولكن الوفاة قريبة","https://www.aldiwan.net/poem48968.html","الكامل"],[139,"حيوا على الرحب دارا","https://www.aldiwan.net/poem49093.html","المجتث"],[189,"يا بنى الهالكين هل من وقاء","https://www.aldiwan.net/poem14082.html","الخفيف"],[398,"يا زائرين اجتمعوا جموعا","https://www.aldiwan.net/poem53509.html","الرجز"],[435,"حيوا محاسن قاعة","https://www.aldiwan.net/poem40529.html","مجزوء الكامل"],[438,"حي وجها من الرياض وسيما","https://www.aldiwan.net/poem12376.html","الخفيف"],[447,"متى بنا العيس ينكحن السماليقا","https://www.aldiwan.net/poem14318.html","البسيط"],[463,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[463,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[463,"مالكم لا تغضبون للهوى","https://www.aldiwan.net/poem56311.html","الرجز"],[509,"أراك ترى حالي وما تترحم","https://www.aldiwan.net/poem38409.html","الطويل"],[509,"حلت حين ما حلت على المصايب","https://www.aldiwan.net/poem38413.html","الطويل"],[563,"لا تلمني إن السماع يقيت","https://www.aldiwan.net/poem34714.html","الخفيف"],[580,"أين كؤوسي وأين أكوابي","https://www.aldiwan.net/poem2745.html","المنسرح"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2475","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138200",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48730","البسيط"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128702","الرمل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111864","الخفيف"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77739","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125487","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96025","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106839","الكامل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101676","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60910","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137071",""],[2740,"","https://poetry.dctabudhabi.ae/diwan/poem/126518","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204738","الكامل"],[3135,"","https://poetry.dctabudhabi.ae/diwan/poem/105701","الكامل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145059","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110227","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110085","الطويل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131988","البسيط"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46011","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205596","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117941","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95069","الطويل"],[4690,"عمّي الفَلاّح / أدب الطفل","https://www.poetsgate.com/ViewPoem.aspx?id=120388",""],[4831,"الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=208040",""],[4858,"وما النصر إلا من عند الله","https://www.poetsgate.com/ViewPoem.aspx?id=175067",""],[5038,"الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=190147",""],[5106,"جَاْدَتْ غِيُوثُكَ ..","https://www.poetsgate.com/ViewPoem.aspx?id=137168",""],[5185,"عساكر الأسوار","https://www.poetsgate.com/ViewPoem.aspx?id=118567",""],[5186,"حي المشيد للعمران تكريما","https://www.poetsgate.com/ViewPoem.aspx?id=156456",""],[5213,"يا نسيم الطلول طبت نسيما","https://www.poetsgate.com/ViewPoem.aspx?id=170535",""],[5281,"فاتِحُ العقولِ","https://www.poetsgate.com/ViewPoem.aspx?id=200140",""],[5292,"العلم أبقى لأهل العلم آثاراً","https://www.poetsgate.com/ViewPoem.aspx?id=122673",""],[5320,"الرياضة أخلاق","https://www.poetsgate.com/ViewPoem.aspx?id=42918",""],[5320,"قلعة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=40442",""],[5431,"قال الإله وبالإحسان إحسانا","https://www.poetsgate.com/ViewPoem.aspx?id=188009",""],[5688,"الجيش الأبيض","https://www.poetsgate.com/ViewPoem.aspx?id=213689",""],[5690,"حياة المرءِ في الدنيا منامُ","https://www.poetsgate.com/ViewPoem.aspx?id=172186",""],[5691,"ضياغم بيْتا","https://www.poetsgate.com/ViewPoem.aspx?id=206209",""],[402,"حيوا الإمام الحق في الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=36291",""],[402,"أمنوا بموتك صولة الرئبال","https://www.poetsgate.com/ViewPoem.aspx?id=36074",""],[5956,"أقصوصة أنثى سُحاقية","https://www.poetsgate.com/ViewPoem.aspx?id=182690",""],[5956,"الشعرُ وهْجُ الفكرِ والنبضاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=186207",""],[5956,"طوبَى للمحامية هالة خضر المحمد","https://www.poetsgate.com/ViewPoem.aspx?id=214190",""],[5960,"أنا حاكمٌ عربيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=31108",""],[6034,"خطب ألم فسار في الآفاق","https://www.poetsgate.com/ViewPoem.aspx?id=169608",""],[161,"بارك الله لكما","https://www.poetsgate.com/ViewPoem.aspx?id=175728",""]],"verses":[["حَيُّوا الإِمَامِ الحَقِّ فِي الإِسْلامِ","مَا كُلُّ مُؤْتَمٍّ بِهِ بِإِمَامِ",0,"م",1,1],["حَيُّوا الأَمِينَ المُصْطَفَى مِن رِبهِ","لِمُهِمَّةٍ جُلَّى وَشَأَنٍ سَامِ",0,"م",1,0],["حَيّوا أُمامَةَ وَاذكُروا عَهداً مَضى","قَبلَ التَصَدُّعِ مِن شَماليلِ النَوى",1,"ا",1,1],["حَيّوا المَقامَ وَحَيّوا ساكِنَ الدارِ","ما كِدتَ تَعرِفُ إِلّا بَعدَ إِنكارِ",2,"ر",1,1],["حَيّوا الدِيارَ وَسائِلوا أَطلالَها","هَل تَرجِعُ الخَبَرَ الدِيارُ البَلقَعُ",3,"ع",1,0],["حَيّوا الدِيارَ وَأَهلَها بِسَلامِ","رَبعاً تَقادَمَ أَو صَريعَ خِيامِ",4,"م",1,1],["حَيّوا مِنَ الشُهَداءِ كُلَّ مُغَيَّبٍ","وَضَعوا عَلى أَحجارِهِ إِكليلا",5,"ل",2,0],["حَيوانٌ بلا حَياةٍ فمنه","حائِدٌ عن مَنِيَّةٍ ومُلاقي",6,"ق",2,0],["حيٌّ ومَيْتٌ بالخطوب تباعَدا","شَتّانَ بينَ بِعادِهِ وبِعَادي",7,"د",2,0],["حَيُّوا بمصرَ حُماتَها الأحرارا","وتَذكَّروا شُهداءها الأبرارا",8,"ر",2,1],["حَيّوا الهِلالَ وَحَيّوا أُمَّةَ النيلِ","وَاِستَقبِلوا العيدَ عيدَ العَصرِ وَالجيلِ",9,"ل",1,1],["حَيّوا الأَميرَينِ حَيّا اللَهُ رَكبَهُما","أَنّى اِستَقَرَّ وَأَنّى سارَ يَنتَقِلُ",10,"ل",1,0],["حيّوا الغُزاةَ قياماً وانظروا تجدوا","وفودَهم حولكم يا قوم تزدحمُ",11,"م",1,0],["حيّوا الملائكةَ الأبرارَ يقدمُهُم","جبريلُ في غَمَراتِ الهولِ يقتحمُ",11,"م",1,0],["حَيَّوا جَلالَةَ قَدرِهِ فكأنّما","حَيَّوا أمينَ اللّهِ في الإيوانِ",12,"ن",1,0],["حَيوانٌ وَجامِدٌ غَيرُ نامٍ","وَنَباتٌ لَهُ بِسُقيا نَماءُ",13,"م",3,0],["حيَّوا بأرواحهم سعداً ولو ملكوا","نبضَ الوتينِ مشوا في المشهد الحفِلِ",14,"ل",1,0],["حَيَّوْهُ عَنْ ثِقَةٍ بِمَنْ وَلَّى وَمَا","فِي فِعْلِهِمْ مَذْقٌ وَلاَ تَزْوِيقُ",15,"ق",1,0],["حَيُّوا الرَّئِيسَةَ إنْصَافاً وَتَكْرِمَةً","يَا حَامِلِينَ لِوَاءَ العِلْمِ وَالأَدَبِ",16,"ب",1,1],["حَيُّوا فَتَاةً أَتّمَّ اللهُ زَينَتَهَا","خَلْقاً وَخُلْقاً بِمَا يَسْمُو عَنِ الرِّيَبِ",16,"ب",1,0],["حَيُّوا مُدِيلَ حَيَاتِهَا مِنْ يَأْسِها","وَمُذَلَّلَ الآلاَمِ لِلآمَالِ",17,"ل",1,0],["حَيُّوا زَعِيمَ اليقْظَ الأُولَى بِهَا","وَخَطِيبَ ثَوْرَتِهَا فِي الاسْتِهَلاَلِ",17,"ل",1,0],["حَيٌّ وَما فِي الفَضْلِ مِنْ جسْمِهِ","حَيٌّ سِوَى فضْلٍ مِنَ الحِسِّ",18,"س",1,0],["حَيُّوا سُعُوداً في أَعِزَّ","تِهَا الأُولى يَقْفُونَ سَعْدَا",19,"د",2,0],["حَيَوانٌ إِن تَقَضّى أَجَلٌ","قيلَ هذا ماتَ أَو ذاكَ نَفَق",20,"ق",1,0],["حيوا برج الحمام وحيوا حمامه","من ملوك المحبة والأخوية",21,"ي",2,0],["حَيّوا تُماضِرَ وَاِربَعوا صَحبي","وَقِفوا فَإِنَّ وُقوفَكُم حَسبي",22,"ب",2,1],["حيّ ولكنّ الوفاة قريبةٌ","والموت غاية ما أروم وأطلبُ",23,"ب",1,1],["حيوا على الرحب داراً","جمالها في لقاكمْ",24,"م",1,1],["حيوان من كلِّ جنسٍ فما يُحْ","صَر منها الأَقلُّ بالإِحْصاء",25,"ا",2,0],["حَيّوهُ عَنّي ما أَضاءَ كَوكَبُ","وَما أَقامَ يَذبلٌ وَكَبكبُ",26,"ب",1,0],["حيوا محاسن قاعةٍ","بالسعد أضحت باهيه",27,"ي",2,1],["حَيِّ وجهاً من الرياضِ وَسيما","غابَ عن ناظري فأهْدَى النَّسيما",28,"م",2,1],["حيوا نبيهم تلقاء كوكبه","وبعد حيوا أبا بكر وفاروقا",29,"ق",2,0],["حيِّ وقرِّبْ من عفيفٍ أوجهاً","أسرّةُ الأقمار منها تُجتلَى",30,"ل",2,0],["حَيِّ وقرِّبْ غُرّةً أبيّةً","كان النوى يألَمُ من بعادِها",31,"د",3,0],["حيِّ وقَرِّبْ بالكثيب طارقا","من طيف حسناءَ على الخوفِ سرى",32,"ا",1,0],["حيوتي وموتي منك بالقرب والنوى","تدبر احوالي اليك مسلم",33,"م",1,0],["حيوه قلوب العارفين هو الهوى","هو الحسن روحٌ والقلوب القوالب",34,"ب",1,0],["حيوان في الطبع لا إنسان","وهو حي وفي الحقيقة ميت",35,"ت",1,0],["حيوا بها المُدامِ متئِمَةً","فكُلُّ كأْسٍ كَكَفِّ وَهَّابِ",36,"ب",1,0],["حَيّوا حَليلَةَ بَعلِها سَلّامَه","وَعَلى الخَليلِ مِنَ الخَليلِ ذَمامَه",37,"م",2,1],["حيوا الشهامة والمروءة والندى","والبرّ في النسب الرفيع مع الحسب",38,"ب",1,0],["حيوا الأريكة والسلطان والعلما","وفاخروا بجديد السؤدد الأمما",39,"م",2,1],["حيّ وادي الخيف إن جزت الحمى","ثم سائل عنهم في كل حي",40,"ي",1,0],["حيوانٌ قد ركبتهُ الهيولى","كتلاً من مفاصلٍ وعظامِ",41,"م",1,0],["حيٌّ واعذب شيءٍ يشربون دمُ","نجوت منهم وجئت اليوم مبتغياً",42,"ي",2,0],["حَيوان ماء للحَياة مصور","ترياق صَرعى عضها الثعبان",43,"ن",1,0],["حيُّوا المؤدِّبَ واشكرُوا","كي تغنمُوا صفوَ الحياه",44,"ه",1,0],["حيوك وفد زائرون فانعمى","ما في تحية زائر من عار",45,"ر",1,0],["حيٌّ وكل حياته حذرٌ","والقبر لا أمنٌ ولا حذر",46,"ر",1,0],["حيوا فأحيوا به محبا","مضنى عليل الفؤاد صبه",47,"ب",2,0],["حيّوا بعوسجة سبحانَ منطِقها","والمنتقى غرراً منها واوضَاحا",48,"ح",2,0],["حيوا بشخصك المعيا ما نبا","عضب له في المشكلات صقيل",49,"ل",1,0],["حيَوا المعالي فبدرُ الحسن قد طلعا","وكوكب السعد في أفق الحمى لمعا",50,"ع",2,1],["حي وإما مت روحي في الصبا","تبقى وفي أفق الجمال تحلق",51,"ق",1,0],["حي وما أصغى إلى لوامه","فأعاد عيد البشر في إلمامه",52,"م",2,1],["حيوا بها الأنصار في أجداثهم","وعلى الرسول فسلموا تسليما",53,"م",2,0],["حَيَوةُ الفَتَى هِي شأنُهُ إِنَّ مَن غدا","ولا شأنَ يُحيِيهِ لهُ الموتُ أَنسَبُ",54,"ب",1,0],["حيوةُ الفتى في سُوق ذا العُمرِ متجرٌ","فتبّاً لخَسرانٍ وطُوبى لغانمِ",55,"م",1,0],["حيوا صفاقس حيوا الفضل والأدبا","حيوا شبابا بها قد طاول الشهبا",56,"ب",2,1],["حَيَوانٌ وَجامِدٌ وَنَباتٌ","عالِيَ النَّوع كانَ أَو غَير عالِ",57,"ل",1,0],["حَيَوانٌ يَنحَلُّ شَكلاً فَيحيي","حَيَواناً وَعُنصُراً غَيرَ بالِ",57,"ل",1,0],["حيوانات نماها آدم","وهي من أبنائه نسل فريدْ",58,"د",1,0],["حيوانات ولكن بينها","كل ذي لب سماوي رشيدْ",58,"د",1,0],["حيوان مبصران","عينه ترمي وتقلع",59,"ع",1,0],["حيوةٌ شبيه الظلّ حثمٌ عُبورُها","فلا يخدع المغرور فيها غرورُها",60,"ر",3,1],["حيُّوا الفَلاحَ وهمَّتَهُ","دَامَ الفَلَّاح بِوادينا",61,"ن",2,0],["حيوا الشَّهيدَ وقَبِّلوا أجفانَهُ","ودَعوا الورودَ على جِراحهِ تَهْجَعُ",62,"ع",1,0],["حيّوا الرجالَ كتائبَ القسّامِ","حيّوا بغزّةَ عزمَ كلِّ هُمامِ",63,"م",1,1],["حيّوا الّذين تعاهدوا أن