{"poems":[[55,"بالجد لا بالمساعي يبلغ الشرف","https://www.aldiwan.net/poem29972.html","البسيط"],[55,"أكافينا النصيح بقي","https://www.aldiwan.net/poem30631.html","مجزوء الوافر"],[74,"قدمت قدوم الغيث والحي مجذب","https://www.aldiwan.net/poem18238.html","الطويل"],[74,"بدت في رداء الشعر باسمة الثغر","https://www.aldiwan.net/poem18703.html","الطويل"],[74,"أما ونجوم الحسن أعيى طلوعها","https://www.aldiwan.net/poem19167.html","الطويل"],[74,"بكيت بأجفان المحب المتيم","https://www.aldiwan.net/poem19671.html","الطويل"],[53,"لئن حجبوا عني أبا الفضل ضلة","https://www.aldiwan.net/poem61910.html","الطويل"],[31,"أتنكر الدار أم عرفان منزلة","https://www.aldiwan.net/poem6042.html","البسيط"],[93,"أباعثة المطايا من حديد","https://www.aldiwan.net/poem62788.html","عموديه"],[87,"طوقتك السحب بالمنن","https://www.aldiwan.net/poem7886.html","المديد"],[47,"حرمت رضاك من عدمي وخسري","https://www.aldiwan.net/poem63561.html","الوافر"],[30,"لئن أصبحت قيس تلوي رؤوسها","https://www.aldiwan.net/poem1278.html",""],[2,"بان الخليط ولم يأووا لمن تركوا","https://www.aldiwan.net/poem25061.html","البسيط"],[68,"لئن حكمت بفرقتنا الليالي","https://www.aldiwan.net/poem40316.html","الوافر"],[99,"يا فؤادي رحم الله الهوى","https://www.aldiwan.net/poem25088.html","الرمل"],[35,"لا أيها البيت الذي لا أزوره","https://www.aldiwan.net/poem26020.html","الطويل"],[107,"أميطي الغيب وادرعي الشهودا","https://www.aldiwan.net/poem42134.html","الوافر"],[77,"أنظلم أن شمنا بوارق لمحا","https://www.aldiwan.net/poem69094.html","الطويل"],[52,"لا يأيسن فقير من غنى أبدا","https://www.aldiwan.net/poem63899.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55073","الوافر"],[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10257","الوافر"],[92,"يافا الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179202",""],[113,"أبادت بقايا الصبر طارقة الدهر","https://www.aldiwan.net/poem16306.html","الطويل"],[119,"لي نحو من ازمعوا السير التفاتات","https://www.aldiwan.net/poem41201.html","عموديه"],[147,"أما ومساع لا نحيط لها عدا","https://www.aldiwan.net/poem11755.html","الطويل"],[147,"سما بك دهرك فليفتخر","https://www.aldiwan.net/poem11765.html","المتقارب"],[154,"علاؤك مضمون وسعدك واضح","https://www.aldiwan.net/poem68461.html","الطويل"],[164,"خذوا لي من سعدى أمانا من الهجر","https://www.aldiwan.net/poem59078.html","الطويل"],[173,"لئن حال ما بيني وبينك حائل","https://www.aldiwan.net/poem1626.html",""],[240,"سقاها الحيا من أربع وطلول","https://www.aldiwan.net/poem31789.html","الطويل"],[275,"برزت لنا من القصر العلي","https://www.aldiwan.net/poem35578.html","الوافر"],[275,"أحن إلى طيب الغدائر والفم","https://www.aldiwan.net/poem35634.html","الطويل"],[295,"ألا حبذا يا ليل من فيك قبلة","https://www.aldiwan.net/poem11661.html","الطويل"],[346,"كأن العين خالطها قذاها","https://www.aldiwan.net/poem2237.html","الوافر"],[358,"هناء بالسلامة مستديم","https://www.aldiwan.net/poem39955.html","الوافر"],[376,"لئن حجبت نجل العيون وحورها","https://www.aldiwan.net/poem57450.html","الطويل"],[385,"لئن حل في دين الهوى لكم ظلمي","https://www.aldiwan.net/poem49259.html","الطويل"],[422,"خذ بالمسرة واغنم لذة الطرب","https://www.aldiwan.net/poem54116.html","البسيط"],[443,"أمن منزل بالجق أقوت معالمه","https://www.aldiwan.net/poem2537.html","الطويل"],[445,"إذا شئت كان النجم عندك شاهدي","https://www.aldiwan.net/poem34811.html","الطويل"],[445,"بقاء الخلائق رهن الفناء","https://www.aldiwan.net/poem34882.html","المتقارب"],[463,"على كل حال جانب الحق أمنع","https://www.aldiwan.net/poem56131.html","الطويل"],[463,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[482,"كفاك على وجدي دليلا مدامعي","https://www.aldiwan.net/poem15237.html","الطويل"],[484,"ألا بالتعاضد فلنبتد","https://www.aldiwan.net/poem37579.html","المتقارب"],[511,"لي نحو أرض المنى من شرق اندلس","https://www.aldiwan.net/poem2422.html","البسيط"],[520,"أيخفى صحيح الوجد والسقم لائح","https://www.aldiwan.net/poem12052.html","الطويل"],[521,"أهاج البكا ربع باسفل ذي السدر","https://www.aldiwan.net/poem48671.html","الطويل"],[543,"لئن حبسوا جسمي بجدران سجنهم","https://www.aldiwan.net/poem48298.html","عموديه"],[567,"لمن طلل بوادي الرمل باد","https://www.aldiwan.net/poem52899.html","الوافر"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53746","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48706","البسيط"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104587","الطويل"],[868,"","https://poetry.dctabudhabi.ae/diwan/poem/177867","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59718","المتقارب"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59528","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119976","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73994","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144137","الوافر"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137866",""],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35719","الطويل"],[1569,"","https://poetry.dctabudhabi.ae/diwan/poem/205156","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111831","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118368","الوافر"],[2111,"","https://poetry.dctabudhabi.ae/diwan/poem/119214","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53048","الطويل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47187","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77379","الوافر"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104963","الكامل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110620","البسيط"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110621","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106841","المتقارب"],[2395,"","https://poetry.dctabudhabi.ae/diwan/poem/101403","المتقارب"],[2491,"","https://poetry.dctabudhabi.ae/diwan/poem/115057","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137132",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93999","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201745","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200557","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115494","الطويل"],[3054,"","https://poetry.dctabudhabi.ae/diwan/poem/124082","الوافر"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65140","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65128","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65104","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65145","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65134","الطويل"],[3108,"","https://poetry.dctabudhabi.ae/diwan/poem/146676","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100848","الطويل"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203545","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89155","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89424","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109945","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109894","الوافر"],[3718,"","https://poetry.dctabudhabi.ae/diwan/poem/198806","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133266","البسيط"],[3871,"","https://poetry.dctabudhabi.ae/diwan/poem/145928","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125875","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136486",""],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117218","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72711","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120467","الوافر"],[4578,"بعيني غزال ألبان هاروت ماكث","https://www.poetsgate.com/ViewPoem.aspx?id=49366",""],[4984,"أتحسبني أنسى","https://www.poetsgate.com/ViewPoem.aspx?id=175755",""],[5136,"لقد سجعت على الأغصان ورقا","https://www.poetsgate.com/ViewPoem.aspx?id=121632",""],[4045,"لئن حبس المشيب عنان لهوي","https://www.poetsgate.com/ViewPoem.aspx?id=200298",""],[5431,"روما وعربي مغترب....","https://www.poetsgate.com/ViewPoem.aspx?id=208557",""],[5497,"أوشكت بالدمع أغرقُ","https://www.poetsgate.com/ViewPoem.aspx?id=208802",""],[5525,"أنشد البحار","https://www.poetsgate.com/ViewPoem.aspx?id=874",""],[6102,"قاتِلان !!","https://www.poetsgate.com/ViewPoem.aspx?id=184625",""],[6142,"طيفٌ لوصلك يقصيه تحلقه","https://www.poetsgate.com/ViewPoem.aspx?id=155676",""]],"verses":[["لَئِن حُرِمتُ مِنَ العَلياءِ ما رُزِقوا","لَقَد جَهِلتُ مِنَ الفَحشاءِ ما عَرَفوا",0,"ف",3,0],["لَئِن حَرَّقتَني عَذلاً","لَقَد نَوَّهتَ بي صُعُدا",1,"د",2,0],["لئن حذِرَ العافون في الدّهر مهلكا","لقد طاب من نعماك للقومِ مطلب",2,"ب",1,0],["لئن حثني باب البريد إلى مصر","لقد حثني باب الزيادة في النزر",3,"ر",1,0],["لئن حفظت مصرٌ وشامٌ برأيه","لقد حفظت بطحاؤها وبقيعها",4,"ع",3,0],["لئن حاط مصراً والشآم برأيه","لقد حاط أوطان الحطيم وزمزم",5,"م",1,0],["لئن حجبوا عنِّي أبا الفضل ضَلَّةً","لما حجبوا عني به لا عجَ الوَجْدِ",6,"د",1,1],["لَئِن حَلَفتُ لَقَد أَصبَحتُ شاكِرَها","لا أَحلِفُ اليَومَ مِن هاتا عَلى إِثِمِ",7,"م",1,0],["لَئِن حَجَبَ الغَمامُ الشَمسَ عَنّا","فَلَم يَطمِس ضِياءَ اللَهِ فينا",8,"ن",2,0],["لَيِّنٌ حال الهوى وإذا","رضته للصحو لم يلن",9,"ن",1,0],["لَئِن حَشَدَ الرِجالُ عَلَيكَ دوني","لَما حَشَدوا عَلَيكَ بِمِثلِ شِعري",10,"ر",2,0],["لَئِن حَومَتي هابَت مَعَدٌّ خِياضَها","لَقَد كانَ لُقمانُ بنُ عادٍ يَهابُها",11,"ب",3,0],["لَئِن حَلَلتَ بِجَوٍّ في بَني أَسَدٍ","في دينِ عَمروٍ وَحالَت بَينَنا فَدَكُ",12,"ك",1,0],["لَئِن حَكَمَت بِفُرقَتِنا اللَيالي","وَراعَتنا بِبُعدٍ بَعدَ قُربِ",13,"ب",1,1],["لي نحو اللهب الذاكي به","لفتة العود إذا صار وقودا",14,"د",2,0],["لَئِن حالَ يَأسي دونَ لَيلى لَرُبَّما","أَتى اليَأسُ دونَ الأَمرِ فَهوَ عَصيبُ",15,"ب",1,0],["لئن حَملَ الحِمايةَ جالِبُوها","لقد حملوا المَنايا واللُّحودا",16,"د",2,0],["لئن حَمَلَتْ أشياعُ بغْيكَ فادحاً","يغولُ لقد حُمّلتَ ما كان أفدحا",17,"ح",2,0],["لَئِن حُسِدتَ عَلى ما نِلتَ مِن شَرَفٍ","لَقَد عَنيتَ زَماناً غَيرَ مَحسودِ",18,"د",1,0],["لَئِنْ حُمِّلْتَ أَيْسَرَ مَا","حُمِّلْتَ لَشَدَّ مَا تَلْقَى",19,"ق",2,0],["لَئِن حَجّوا إِلى البَلَدِ القَصِيِّ","فَحَجّي ما حَيِيتُ إِلى عَلِيِّ",20,"ي",1,0],["لئنْ حُمَّ الوَداعُ فضِقتُ ذَرعاً","به ، واشتفَّ مُهجتيَ الذَّهاب",21,"ب",1,0],["لَئَن حارَ مَهجور سِوايَ بِأَمرِهِ","فَقَد حارَ بي مِما أُنازلهُ أَمري",22,"ر",2,0],["لي نحو من ازمعوا السير التفاتات","فيها من الوجد حنات وانات",23,"ت",1,1],["لَئِن حازَ أَقطارَ الشَجاعَةِ أَمرَداً","فَمِن مَعشِرٍ يُردونَ أُسدَ الوَغى مُردا",24,"د",2,0],["لَئِن حَمَلَ الوِزرَ فيها العِدى","فَإِنَّكَ مِمّا جَنَوهُ الوَزَر",25,"ر",1,0],["لئن حفك القصَّاد شرقاً ومغربا","وباتوا إلى جدواك قد ملؤوا السُّبلا",26,"ل",2,0],["لئن حجبوها من مسارح ناظري","فما حجبوها عن خيالي ولا فكري",27,"ر",2,0],["لَئِن حالَ ما بَيني وَبَينَكَ حائِلٌ","مِنَ البَرِّ أَو لُجٌّ مِن البَحرِ زاخِرُ",28,"ر",1,1],["لَئِن حالَ رَسمُ الدارِ عَمّا عَهِدتُهُ","فَعَهدُ الهَوى في القَلبِ غَيرُ مُحيلِ",29,"ل",1,0],["لئن حَجَّبتِ عن عَينيّ حُسناً","فروحي منكِ في ريّاً وري",30,"ي",1,0],["لئن حدّثَتكِ النفسُ يوماً عن الذي","قصائدُه فيها صليلُ المخذَّم",31,"م",1,0],["لئن حرم الإسلام خمراً سلافة","فلن يحرمني خمر ثغرك إسلامي",32,"م",2,0],["لَئِن حَزنت بنو عَبسٍ عليهِ","فَقَد فَقدت بهِ عبسٌ فتاها",33,"ا",3,0],["لَئن حَجبتك حُجبُ البُعدِ عَنّي","فَأَنتَ البَدرُ تَحجبه الغُيومُ",34,"م",1,0],["لئِن حُجِبَت نُجلُ العُيونِ وحورُها","ففي كلِّ جسمٍ سقمُها وفتورُها",35,"ر",3,1],["لَئن حَلَّ في دين الهَوى لَكُم ظُلمي","فَهَل حَسَنٌ قَتل المُحب بِلا جُرمِ",36,"م",1,1],["لئن حباك بنيشان تُسرُّ به","بطالع لقران السعد لم يغب",37,"ب",1,0],["لئن حسنت منها فواتح نظمها","لقد عذبت بالمدح فيك خواتمه",38,"م",2,0],["لئِنْ حَلَّ دارَ الملكِ من بَعْدُ قافِلاً","لقد شَدَّ أَقصاها برأْيِ مُجاهِدِ",39,"د",1,0],["لئِنْ حُجِبَتْ تحتَ رَدْمِ اللُّحُودِ","وَمِنْ قَبلُ فِي شُرُفاتِ العَلاءِ",40,"ا",2,0],["لئن حُلِّئت فاستحلبتكم صوادياً","لقد أنظرتكم بُرهةً وهي نُزَّعُ",41,"ع",1,0],["لئن حَرَصوا فيما عَمَرت تعافُه","فربَّتَ ساعٍ للدنيّة يكدحُ",42,"ح",1,0],["لئن حَجَزَتْ دونَ اللقاءِ مفاوزٌ","وصرَّحتِ الأيامُ لي بالموانعِ",43,"ع",1,0],["لئن حسب الضد قولي فسادا","فقل حلت الخمر أن تفسد",44,"د",1,0],["لي نحو أرض المنى من شرقِ اندلسِ","شَوق يؤلفُ بين الماءِ والقبسِ",45,"س",1,1],["لئن حل في دست الوزارة عادل","سما قبله فيها إلى النجم صالح",46,"ح",1,0],["لَئِن حاجَتي يَوماً قَضيتُ وَرشتني","بِنَفحَة عُرفٍ من يَدَيكَ ابا بَشر",47,"ر",1,0],["لَئن حبَسُوا جسمِي بجُدرانِ سِجنهِم","فما حبَسُوا رُوحي ولا حبَسُوا قلبِي",48,"ب",2,1],["لَئنْ حَجَّت إليكَ العينُ يوماً","فإنَّ القلبَ دامَ على الجهادِ",49,"د",1,0],["لئن حكم السّدريّ بالعدل فيكم","لما أنصف السّدريّ في ثمر السّدرِ",50,"ر",1,0],["لئن حزنت فأحزاني إلى أجلٍ","وسوف أنجو من الذكرى وأنساك",51,"ك",1,0],["لئن حملتنا نحو أرضِك أَينق","ليجعلهُنَّ الدّهرُ أجمعَ سُيّبا",52,"ب",2,1],["لئن حَلَّ فيها ثعلبُ الغدرِ لاوُنٌ","فَسُحقاً له قد جاءه الأسَدُ الوردُ",53,"د",1,0],["لئن حل جسمي بالمغربين","فقد صار قلبي بالمشرقين",54,"ن",1,0],["لئن حُجبت فإن رضايَ عنه","يُفتَّح كل يوم منه باب",55,"ب",1,0],["لئن حبرت في شعبان مدحا","يسؤ عداك من نثر ونظم",56,"م",1,0],["لئن حكمت عيناك بالفتك في الحشا","فإني لها سمعا وطوعا اسلم",57,"م",1,0],["لئن حالت الأيام دون لقائها","فما حال لي عهد ولا أنحل موثق",58,"ق",1,0],["لئن حذفتني الأيام فيهم","فما بي مع خمولي من خفاء",59,"ا",2,1],["لئن حجبت عنا المنية وجهه","فما حجبت عن ألسن الكل ذكراه",60,"ا",2,0],["لَئِن حَسُنَت فيكَ المَراثي وَذِكرُها","لَقَد حَسُنَت مِن قَبلُ فيكَ المَدائِحُ",61,"ح",1,0],["لئن حالت الأيام بيني وبين ما","أحاول أو أنحى علي زماني",62,"ن",2,1],["لئن حبستُ بلا ذنبٍ ولا حرجٍ","فما يراعي الى غير الهدى انطلقا",63,"ق",2,1],["لئن حم المقام بام بدر","وبالانجاد من حدب الكراع",64,"ع",1,1],["لئن حسنت عذراء والبحر خدرها","لقد وجدت فيه ثكولاً وأيّما",65,"م",2,0],["لئن حُبِسَ الغيث الغياثيُّ قطره","فقد سَحَبَتْ في كل قطر سحائبه",66,"ب",2,0],["لئن حَجَبَتْنِي عن نَوَالِكَ زَلَّةٌ","تَلَظَّتْ لها منّي حشىً وضلوعُ",67,"ع",1,0],["لَئِن حَطَّمَتهُم خَيلُ المَنايا","فَمَن مِن رَمسِهِ مِنهُم يَعودُ",68,"د",1,0],["ليَنُح كتابُ الله مما نابَهُ","ولينثن الإسلام يقرع نابا",69,"ب",2,0],["لئن حسدت على فضل خصصت به","فإن ذا الفضل لم يبرح بمحسود",70,"د",1,0],["لئن حسدت على فضل خصصت به","فإن ذا الفضل لم ينفعك محسود",71,"د",1,0],["لئن حَلَّل الموتُ عنصر جسمي","فأَصبح تحت الترابِ مريبا",72,"ب",2,0],["لئن حال بعد المدى بيننا","وشطت ديار وأعيت حيل",73,"ل",1,0],["لَئِن حُجَّبَت عَنَّي نواظِرُ أعينٍ","رَميسن بأحداقِ المها والمحاجِرِ",74,"ر",1,0],["لئن حمدنا اخا فضل لمأثرة","يوماً ففي كل يوم انت محمود",75,"د",1,0],["لئن حجبته عن عيني الليالي","فكم للفجر من فجر قريب",76,"ب",1,0],["لئن حاكاه بدر التم نوراً","فما حاكاه في غنج وفيه",77,"ي",2,0],["لئن حرتُ في دهري الخؤون وأمره","فإني تركت الدهر حيران في أمري",78,"ر",2,0],["لئن حالت الأيّامُ بيني وبينكم","فحالي بكم حالٌ وودي بكم ودي",79,"د",2,0],["لئن حرِمى أبحنَ فكم أباحت","رسومُ الدار قبلي من حريم",80,"م",1,0],["لئن حواها الّذي لي يستحقّ لها","من قبل فهو بالاستحقاق حاويها",81,"ي",3,0],["لئن حملتهُ وهي برقٌ فإنّهُ","غمامٌ وما برقُ الغمائم يُجهلُ",82,"ل",1,0],["لئن حصرُوا بالرّصد بُعد كواكب","فهمّتهُ أبعادُها ليس تُحصرُ",83,"ر",1,0],["لئن حلّ في عينيك ضعف فقد غدا","لفكرك في الأشياء قُوّةُ إنتاج",84,"ج",1,0],["لئن حجبتني عن عُلاك أسافل","فذاك دليلُ الخير عندي قائم",85,"م",1,0],["لئن حال ذاك الربع بعد قطينه","وأصبح من بعد الفصاحة أعجما",86,"م",2,0],["لئن حرموها في الكتاب فاننا","غنينا فلا نرجو ثواباً ولا اجرا",87,"ر",2,0],["لئن حكمتُ عواذلُنا بظِلم","لقد جاءوا بما أبدوهُ نُكرا",88,"ر",2,0],["لئن حسدت دنياه قبراً يضمُّه","فكم حسد الدنيا بصحبته القبر",89,"ر",1,0],["لئن حلاك جوهر كل مجدٍ","ففي خجل من الصدر الحلي",90,"ي",1,0],["لئن حازَ في الدُنيا شَقاءً معجَّلاً","فقد حازَ في الأُخرَى نعيماً مخلَّدا",91,"د",2,0],["لئن حَزِنَت عليهِ الأرضُ طُرّاً","لَقد فَرِحَت بنُقلتِهِ السَماءُ",92,"ا",2,0],["لئن حسنت فيكم قديماً مدائحي","فإن رثائي فيك مر ورائع",93,"ع",1,0],["لي نحو طيبة أشواق تغالبُني","والوجد كاد من الأشواق يبريني",94,"ن",2,1],["لي نحو ربعك دائماً يا جلق","شوق أكاد به جوى أتمزق",95,"ق",1,1],["لئن حَيَثْ فبروح أَنت تنفخُها","فيها وحين ارتقتْ منك السلاليم",96,"م",1,0],["لئن حمي المزاج فغيرُ بدعٍ","فنارُ ذُكاكَ تقذفُ بالشرارِ",97,"ر",1,0],["لئن حملت أيدي الخلائق نعَشه","فكم حملت أيدي نداه رِكابها",98,"ب",3,0],["لئن حالت الأيام بيني وبينها","وقصر بي عمري ولم يسعف الجهد",99,"د",1,0],["لئن حاتم منه عدي نشى فكم","نشى من عدي عندنا الف حاتم",100,"م",1,0],["لئن حرمت مغانيها ثريا","فذا بدر يضئ به السواد",101,"د",1,0],["لئن حلَّ عهداً قد عاقدناه ذو هوى","فإني على عهد الأحبة ماكثُ",102,"ث",1,0],["لئن حلت البلوى فما الله خاذلي","وبالصبر أتممت البلاء إلى النصاب",103,"ب",1,0],["لئن حمدت مدامعها فعيني","لفرط صبابة في الدمع غرقى",104,"ق",2,0],["لئن حبس المشيب عنان لهوي","وبقى لي قليلا من كثير",105,"ر",1,1],["لينحتَ في تضاريسٍ تراءت","كمرجانٍ على شطي استقرا",106,"ر",2,0],["لئن حال هٰذا النّأي بيني وبينهم","فما أنحل لي عهدٌ ولا أنحل موثقُ",107,"ق",1,0],["لين حطت بي رحالي في هواك","وانبعث نبع المحبة في الكنين",108,"ن",1,0],["لَئِن حَبا الوُدَّ غَيرِي هاجَنِي وَجَعٌ","كَأَنِّيَ الصَّبرُ , وَالتَّثآرُ آكِلُهُ",109,"ل",2,0],["لي نحو وصلك سهمٌغير متئدٍ","في غلوهِ ويدٌ للحب ترشقهُ",110,"ق",2,0]]}