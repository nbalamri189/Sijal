tml","البسيط"],[438,"ألق العصي فهذا مقتضى الأرب","https://www.aldiwan.net/poem14330.html","البسيط"],[438,"إليك رسول الله سرنا عصابة","https://www.aldiwan.net/poem14334.html","الطويل"],[438,"حتى متى أنا بين الجد واللعب","https://www.aldiwan.net/poem14347.html","البسيط"],[438,"حتام طول الأماني والتعلات","https://www.aldiwan.net/poem14355.html","البسيط"],[438,"على الذنب لي قلب شجاع مجرب","https://www.aldiwan.net/poem14379.html","الطويل"],[438,"إليك صبت أفيدتنا ولاها","https://www.aldiwan.net/poem14392.html","الوافر"],[438,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[445,"لمن الديار عرفتها وكأنها","https://www.aldiwan.net/poem2172.html","الكامل"],[446,"لم توف أشواقي ولا لوعاتي","https://www.aldiwan.net/poem53723.html","الكامل"],[451,"الشكر يجدر أن يمثل عيدا","https://www.aldiwan.net/poem61637.html","الكامل"],[456,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[456,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[456,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[456,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[456,"سلا من سلا من بنا استبدلا","https://www.aldiwan.net/poem56005.html","المتقارب"],[456,"لو حملت عتبي الليالي","https://www.aldiwan.net/poem56006.html","مخلع البسيط"],[456,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[456,"يا وحشة المجد ثقي بالأنس","https://www.aldiwan.net/poem56153.html","الرجز"],[456,"وفى لي بك الحظ الذي كان يغدر","https://www.aldiwan.net/poem56168.html","الطويل"],[456,"متى رفعت لها بالغور نار","https://www.aldiwan.net/poem56187.html","الوافر"],[456,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[456,"على أي أخلاقِ الزمان أعاتبه","https://www.aldiwan.net/poem56287.html","الطويل"],[459,"سعد الزمان وكل موسم غبطة","https://www.aldiwan.net/poem15367.html","الكامل"],[459,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[459,"هنىء العام وما يعقبه","https://www.aldiwan.net/poem16222.html","الرمل"],[463,"عَثرَة ُ العُمر","https://www.aldiwan.net/poem36439.html","عموديه"],[489,"أيا أحمد ابن مليك الزمان","https://www.aldiwan.net/poem26668.html","المتقارب"],[496,"أطاعتك الذوابل والشفار","https://www.aldiwan.net/poem3696.html","الوافر"],[498,"يا إلهي يا معين العاجزين","https://www.aldiwan.net/poem37550.html","الرمل"],[498,"ظهر بأعباء الغرام قد انحنى","https://www.aldiwan.net/poem37761.html","الكامل"],[498,"حب النبي الهاشمي ديني","https://www.aldiwan.net/poem37768.html","الرجز"],[498,"إلهي بنور الذات في القدم الأسمى","https://www.aldiwan.net/poem37803.html","الطويل"],[527,"يجب حذف متعلقات الظروف","https://www.aldiwan.net/poem37306.html","المتقارب"],[541,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[549,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[556,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[565,"قد وفينا لك بالوعد","https://www.aldiwan.net/poem69489.html","الرمل"],[565,"تريك مرور الليالي العبر","https://www.aldiwan.net/poem69673.html","المتقارب"],[565,"ما أبصرت عيني ولا عين أحد","https://www.aldiwan.net/poem69706.html","الرجز"],[573,"ببرقة ثغر لا ببرقة ثهمد","https://www.aldiwan.net/poem3084.html","الطويل"]],"verses":[["بِبَأسٍ مِثلِ غَربِ السَيفِ ماضٍ","وَجودٍ مِثلِ ماءِ المُزنِ هامِ",0,"م",1,0],["بِبَدرٍ مُعَمٍّ في الكَواكِبِ مُخوَلٍ","نَمَتهُ عُروقٌ لِلعُلى وَفُروعُ",1,"ع",1,0],["بِبُروقِ أَدراعٍ وَرَعدِ صَوارِمٍ","وَغَمامِ قَسطَلَةٍ وَوَبلِ دِماءِ",2,"ا",2,0],["بِبَابِيَ حُطَّ الرَّحْلَ لاَ تَنْوِ وِجْهةً","فَقَدْ فُزْتَ فِي حَالِ الإِقَامَةِ بِالْغُنْمِ",3,"م",1,0],["بِبَقَائِكَ الدُّنْيَا تُحَاطُ وَأَهْلُهَا","فَاللهُ جَلَّ جَلاَلُهُ يُبْقِيكَا",4,"ك",2,0],["بِبابِلَ لَم تُعصَر فَجاءَت سُلافَةً","تُخالِطُ قِنديداً وَمِسكاً مُخَتَّما",5,"م",2,0],["بِبابِكَ النَحسُ وَالسُعودُ","وَمَوقِفُ اليَأسِ وَالرَجاءِ",6,"ا",2,1],["بِبَعلٍ كُلُّهُ ذِكرٌ صَحيحٌ","وَأُنثى كُلُّها فَرجٌ مُباحُ",7,"ح",1,0],["بِبارِقَةٍ لِلمَوتِ فيها عَجاجَةٌ","مَناكِبُها مَسمومَةٌ وَنُحورُها",8,"ر",3,0],["بِبيضِ الصِفاحِ وَسُمرِ الرِماحِ","فَبِالبيضِ ضَرباً وَبِالسُمرِ وَخزا",9,"ز",2,0],["بِبَقَائِهِ وَرَدَاكَ مَوْعِظَةٌ","لِلسَّائِرِ المُفْضِي إِلَى الرجُمِ",10,"م",1,0],["بِبَنِيْكَ إسْمَاعِيلُ غُيِّبَ شَارِقٌ","وَقُوِّضَ بُنْيَانٌ وَأُغْمِدَ صَارِمُ",11,"م",1,0],["ببرَّةَ والنضرِ والمالكي","ن رهط هو الأنبل الأنبلُ",12,"ل",1,0],["بِبِيض يَنتَمُونَ إِلَى نِزَارٍ","مُهِيبِي سَاسَة وَمُؤَيِّهِينَا",13,"ن",2,0],["ببيت زهير حيث كعب مبارك","وحسان مدحي ثابتٌ ورجائي",14,"ي",1,0],["بباهر البرّ جدّد يا عليّ قوى","شعرٍ تجدْ خيرَ عمارٍ لأمداح",15,"ح",1,0],["ببدر ونور البدر واصف نفسه","وحلو وحلو لا يقاس بسكر",16,"ر",1,0],["ببديعه إن قالها متحجّب","عنَّا فلا حجبت مقالة مدره",17,"ه",1,0],["ببعض ما صفَّر أو ما سَذّجا","لا بأس إن أقرع أو إن أَتْرَجا",18,"ج",2,0],["ببعض حقك أنْ أصبحت عندهُمُ","مُشاوَرَاً في جسيم الأمر مُنْتَصَحا",19,"ح",2,0],["بِبَنانٍ كَمَدَارِي فضَّةٍ","طُرِّفَتْ بالنُّورِ في مجرى السُّبَحْ",20,"ح",1,0],["ببيتَيْك اللذين يخبِّرانا","بمحض الكفر عنك وبالجحودِ",21,"د",1,0],["ببنانٍ كأنهنّ مدارٍ","وأساريعُ في دِماث الرمالِ",22,"ل",1,0],["بِبِرِّ أميرِنا في كل عيدٍ","تواصَلَ منهما المتقاطعان",23,"ن",1,0],["ببيان بِدْعةَ إنَّها","في الحذق من بِدَعِ الزَّمانِ",24,"ن",1,0],["بِبَطنِ خَينَفَ مِن أُمِّ الوَليدِ وَقَد","تامَت فُؤادَكَ أَو كانَت لَهُ خَبَلا",25,"ل",2,0],["بِبيضِ الهِندِ وَالأَسَلِ الحِدادِ","أُرَجّى أَن يَتِمَّ ليَ مُرادي",26,"د",2,1],["ببيتك وهو أعظم كل بيت","يباهي المجد والحسب الصميم",27,"م",1,0],["ببيت الأمة أعتَقلِ المطيّا","وفي دهليزه أطرق ملِيا",28,"ي",2,1],["بِبيضٍ أَضاءَت في الخُدورِ كَأَنَّها","نُجومُ دُجاً جَلَّت سَوادَ الحَنادِسِ",29,"س",1,0],["بِبَردِ أَنفاسِهِ يَشفي الغَليلَ إِذا","دَنا فَقَرَّبَها مِن حَرِّ أَنفاسي",30,"س",2,0],["بِبيضٍ مَتى تُشهَر عَلى القَومِ يُغلَبوا","وَخَيلٍ مَتى تُركَض إِلى النَصرِ تَسبِقِ",31,"ق",1,0],["بِبُرقَةِ ثَهمَدٍ وَلَرُبَّ شَوقٍ","تَصَبّاني إِلى أَهلِ البِراقِ",32,"ق",1,0],["بِبارِعِ الفَضلِ يَأوي مِن شَهامَتِهِ","إِلى عَزائِمَ لَم تَضعُف وَلَم تَهِنِ",33,"ن",1,0],["بِبُروجٍ وُصِلنَ بالماءِ في الأر","ضِ وأُلحِقنَ بالسماءِ اتِصالا",34,"ل",2,0],["ببازٍ إذا أرسلَتهُ صادَ كلَّ ما","تَرومُ بهِ أو نالَ كلَّ مَنالِ",35,"ل",1,0],["ببيضٍ أخلَصَتْ حتى أقامَت","عَمُودَ الصُّبحِ في ظُلَمِ الدآدي",36,"ي",1,0],["بِبَطنِ العَقيقِ أَو بِخَرجِ تَبالَةٍ","مَتى ما تَجِد حَرّاً مِنَ الشَمسِ تَدمُجِ",37,"ج",1,0],["بِبَأسِهِ أَضحَتِ الأَيّامُ جازِعَةً","فَلا تُصاحِبُ عُضواً غَيرَ مُضطَرِبِ",38,"ب",1,0],["بِبارِقٍ خَذِمٍ في مَأزِقٍ أَمَمٍ","أَو سائِقٍ عَرِمٍ في شاهِقٍ عَلَمِ",39,"م",1,0],["بِبيضٍ يَغتَدي نَملُ المَنايا","لَهُ مِن فَوقِ صَفحَتِها دَبيبُ",40,"ب",1,0],["ببروجِ قتالٍ تحسبها","في شُمّ شواهقها قُنَنَا",41,"ن",2,0],["بِبَعيدِ المَدى قَريبِ المَعاني","وَثَقيلِ الحِجى خَفيفِ الروحِ",42,"ح",1,0],["ببابِ فردوسِ حلبْ","سطرٌ بأعلاهُ عجبْ",43,"ب",1,1],["بِبَيضَةٍ كَمَهاةِ الرَملِ آنِسَةٍ","مِفتانَةِ الدَلِّ رَيّا الخَلقِ كَالقَمَرِ",44,"ر",1,0],["بِبَأسٍ لا كِفاءَ لَهُ وَعِلمٍ","جَلا الغَمَراتِ وَاِكتَسَحَ الدُجونا",45,"ن",2,0],["بِبَيان كَأنَّهُ نَفَحاتٌ","حَمَلتها يَد النَسيم زَكيه",46,"ي",2,0],["بِبَلقَعَةٍ أَثبَتَت حُفرَةً","ذِراعَينِ في أَربَعٍ خَيسَقِ",47,"ق",1,0],["بِبَياضِ وَجهٍ مَع عُيونِ ظِبا","بِسَوادِها فَتَكامَلَ الحُسنُ",48,"ن",1,0],["بِبِلادٍ فيها الرَكايا عَلَيهِن","نَ كَاللَيلِ مِن بَعوضٍ تَحومُ",49,"م",1,0],["بِبِلادٍ فيها الرَكايا عَلَيهِن","نَ أَكاليلُ مِن بَعوضٍ يَحومُ",50,"م",1,0],["بِبابِ بُنَيَّةِ الوَضّاحِ ظَبيٌ","عَلى ديباجَتَي خَدَّيهِ ماءُ",51,"ا",2,1],["بِبارِدِ الماءِ مِنَ الفُراتِ","تَخالُ فيها أَلسُنَ الحَيّاتِ",52,"ت",1,0],["بِبُوَيزِلٍ تَزدادُ جُرأَتُهُ","أَضَماً إِذا ما ليتُهُ رَشَحا",53,"ح",2,0],["بِبازِلٍ حينَ فَطَر","يَهُزُّهُ جِنُّ الأَشَر",54,"ر",1,0],["بِبَناتِ الشَمسِ ما مَنَعَت","نَفسَها مِن لَمسِ مُبتَذَلِ",55,"ل",1,0],["بِبَلدَةٍ لَم تَصِل كَلبٌ بِها طُنُباً","إِلى خِباءٍ وَلا عَبسٌ وَذُبيانُ",56,"ن",1,0],["ببعضِ أسماءِ فصلٍ","مشطّبٍ هندواني",57,"ي",1,0],["بِبَطنِ مَكَّةَ آثارٌ لِأَوَّلِكُم","مِمّا بَنى لِمَعَدٍّ جَدُّهُ أُدَدُ",58,"د",1,0],["ببَياضِها غرتن