[442,"يا من تفرد بالإجلال والكرم","https://www.aldiwan.net/poem14292.html","البسيط"],[442,"ألق العصي فهذا مقتضى الأرب","https://www.aldiwan.net/poem14330.html","البسيط"],[442,"إليك رسول الله سرنا عصابة","https://www.aldiwan.net/poem14334.html","الطويل"],[442,"حتى متى أنا بين الجد واللعب","https://www.aldiwan.net/poem14347.html","البسيط"],[442,"حتام طول الأماني والتعلات","https://www.aldiwan.net/poem14355.html","البسيط"],[442,"على الذنب لي قلب شجاع مجرب","https://www.aldiwan.net/poem14379.html","الطويل"],[442,"إليك صبت أفيدتنا ولاها","https://www.aldiwan.net/poem14392.html","الوافر"],[442,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[448,"لمن الديار عرفتها وكأنها","https://www.aldiwan.net/poem2172.html","الكامل"],[449,"لم توف أشواقي ولا لوعاتي","https://www.aldiwan.net/poem53723.html","الكامل"],[454,"الشكر يجدر أن يمثل عيدا","https://www.aldiwan.net/poem61637.html","الكامل"],[459,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[459,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[459,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[459,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[459,"سلا من سلا من بنا استبدلا","https://www.aldiwan.net/poem56005.html","المتقارب"],[459,"لو حملت عتبي الليالي","https://www.aldiwan.net/poem56006.html","مخلع البسيط"],[459,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[459,"يا وحشة المجد ثقي بالأنس","https://www.aldiwan.net/poem56153.html","الرجز"],[459,"وفى لي بك الحظ الذي كان يغدر","https://www.aldiwan.net/poem56168.html","الطويل"],[459,"متى رفعت لها بالغور نار","https://www.aldiwan.net/poem56187.html","الوافر"],[459,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[459,"على أي أخلاقِ الزمان أعاتبه","https://www.aldiwan.net/poem56287.html","الطويل"],[462,"سعد الزمان وكل موسم غبطة","https://www.aldiwan.net/poem15367.html","الكامل"],[462,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[462,"هنىء العام وما يعقبه","https://www.aldiwan.net/poem16222.html","الرمل"],[466,"عَثرَة ُ العُمر","https://www.aldiwan.net/poem36439.html","عموديه"],[492,"أيا أحمد ابن مليك الزمان","https://www.aldiwan.net/poem26668.html","المتقارب"],[499,"أطاعتك الذوابل والشفار","https://www.aldiwan.net/poem3696.html","الوافر"],[501,"يا إلهي يا معين العاجزين","https://www.aldiwan.net/poem37550.html","الرمل"],[501,"ظهر بأعباء الغرام قد انحنى","https://www.aldiwan.net/poem37761.html","الكامل"],[501,"حب النبي الهاشمي ديني","https://www.aldiwan.net/poem37768.html","الرجز"],[501,"إلهي بنور الذات في القدم الأسمى","https://www.aldiwan.net/poem37803.html","الطويل"],[530,"يجب حذف متعلقات الظروف","https://www.aldiwan.net/poem37306.html","المتقارب"],[544,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[552,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[559,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[568,"قد وفينا لك بالوعد","https://www.aldiwan.net/poem69489.html","الرمل"],[568,"تريك مرور الليالي العبر","https://www.aldiwan.net/poem69673.html","المتقارب"],[568,"ما أبصرت عيني ولا عين أحد","https://www.aldiwan.net/poem69706.html","الرجز"],[576,"ببرقة ثغر لا ببرقة ثهمد","https://www.aldiwan.net/poem3084.html","الطويل"]],"verses":[["بِبَأسٍ مِثلِ غَربِ السَيفِ ماضٍ","وَجودٍ مِثلِ ماءِ المُزنِ هامِ",0,"م",1,0],["بِبَدرٍ مُعَمٍّ في الكَواكِبِ مُخوَلٍ","نَمَتهُ عُروقٌ لِلعُلى وَفُروعُ",1,"ع",1,0],["بِبُروقِ أَدراعٍ وَرَعدِ صَوارِمٍ","وَغَمامِ قَسطَلَةٍ وَوَبلِ دِماءِ",2,"ا",2,0],["بِبَابِيَ حُطَّ الرَّحْلَ لاَ تَنْوِ وِجْهةً","فَقَدْ فُزْتَ فِي حَالِ الإِقَامَةِ بِالْغُنْمِ",3,"م",1,0],["بِبَقَائِكَ الدُّنْيَا تُحَاطُ وَأَهْلُهَا","فَاللهُ جَلَّ جَلاَلُهُ يُبْقِيكَا",4,"ك",2,0],["بِبابِلَ لَم تُعصَر فَجاءَت سُلافَةً","تُخالِطُ قِنديداً وَمِسكاً مُخَتَّما",5,"م",2,0],["بِبابِكَ النَحسُ وَالسُعودُ","وَمَوقِفُ اليَأسِ وَالرَجاءِ",6,"ا",2,1],["بِبَعلٍ كُلُّهُ ذِكرٌ صَحيحٌ","وَأُنثى كُلُّها فَرجٌ مُباحُ",7,"ح",1,0],["بِبارِقَةٍ لِلمَوتِ فيها عَجاجَةٌ","مَناكِبُها مَسمومَةٌ وَنُحورُها",8,"ر",3,0],["بِبيضِ الصِفاحِ وَسُمرِ الرِماحِ","فَبِالبيضِ ضَرباً وَبِالسُمرِ وَخزا",9,"ز",2,0],["بِبَقَائِهِ وَرَدَاكَ مَوْعِظَةٌ","لِلسَّائِرِ المُفْضِي إِلَى الرجُمِ",10,"م",1,0],["بِبَنِيْكَ إسْمَاعِيلُ غُيِّبَ شَارِقٌ","وَقُوِّضَ بُنْيَانٌ وَأُغْمِدَ صَارِمُ",11,"م",1,0],["ببرَّةَ والنضرِ والمالكي","ن رهط هو الأنبل الأنبلُ",12,"ل",1,0],["بِبِيض يَنتَمُونَ إِلَى نِزَارٍ","مُهِيبِي سَاسَة وَمُؤَيِّهِينَا",13,"ن",2,0],["ببيت زهير حيث كعب مبارك","وحسان مدحي ثابتٌ ورجائي",14,"ي",1,0],["بباهر البرّ جدّد يا عليّ قوى","شعرٍ تجدْ خيرَ عمارٍ لأمداح",15,"ح",1,0],["ببدر ونور البدر واصف نفسه","وحلو وحلو لا يقاس بسكر",16,"ر",1,0],["ببديعه إن قالها متحجّب","عنَّا فلا حجبت مقالة مدره",17,"ه",1,0],["ببعض ما صفَّر أو ما سَذّجا","لا بأس إن أقرع أو إن أَتْرَجا",18,"ج",2,0],["ببعض حقك أنْ أصبحت عندهُمُ","مُشاوَرَاً في جسيم الأمر مُنْتَصَحا",19,"ح",2,0],["بِبَنانٍ كَمَدَارِي فضَّةٍ","طُرِّفَتْ بالنُّورِ في مجرى السُّبَحْ",20,"ح",1,0],["ببيتَيْك اللذين يخبِّرانا","بمحض الكفر عنك وبالجحودِ",21,"د",1,0],["ببنانٍ كأنهنّ مدارٍ","وأساريعُ في دِماث الرمالِ",22,"ل",1,0],["بِبِرِّ أميرِنا في كل عيدٍ","تواصَلَ منهما المتقاطعان",23,"ن",1,0],["ببيان بِدْعةَ إنَّها","في الحذق من بِدَعِ الزَّمانِ",24,"ن",1,0],["بِبَطنِ خَينَفَ مِن أُمِّ الوَليدِ وَقَد","تامَت فُؤادَكَ أَو كانَت لَهُ خَبَلا",25,"ل",2,0],["بِبيضِ الهِندِ وَالأَسَلِ الحِدادِ","أُرَجّى أَن يَتِمَّ ليَ مُرادي",26,"د",2,1],["ببيتك وهو أعظم كل بيت","يباهي المجد والحسب الصميم",27,"م",1,0],["ببيت الأمة أعتَقلِ المطيّا","وفي دهليزه أطرق ملِيا",28,"ي",2,1],["بِبيضٍ أَضاءَت في الخُدورِ كَأَنَّها","نُجومُ دُجاً جَلَّت سَوادَ الحَنادِسِ",29,"س",1,0],["بِبَردِ أَنفاسِهِ يَشفي الغَليلَ إِذا","دَنا فَقَرَّبَها مِن حَرِّ أَنفاسي",30,"س",2,0],["بِبيضٍ مَتى تُشهَر عَلى القَومِ يُغلَبوا","وَخَيلٍ مَتى تُركَض إِلى النَصرِ تَسبِقِ",31,"ق",1,0],["بِبُرقَةِ ثَهمَدٍ وَلَرُبَّ شَوقٍ","تَصَبّاني إِلى أَهلِ 