ك ونعماك فينا","https://www.aldiwan.net/poem34861.html","المتقارب"],[444,"يا من تفرد بالإجلال والكرم","https://www.aldiwan.net/poem14292.html","البسيط"],[444,"ألق العصي فهذا مقتضى الأرب","https://www.aldiwan.net/poem14330.html","البسيط"],[444,"إليك رسول الله سرنا عصابة","https://www.aldiwan.net/poem14334.html","الطويل"],[444,"حتى متى أنا بين الجد واللعب","https://www.aldiwan.net/poem14347.html","البسيط"],[444,"حتام طول الأماني والتعلات","https://www.aldiwan.net/poem14355.html","البسيط"],[444,"على الذنب لي قلب شجاع مجرب","https://www.aldiwan.net/poem14379.html","الطويل"],[444,"إليك صبت أفيدتنا ولاها","https://www.aldiwan.net/poem14392.html","الوافر"],[444,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[449,"لمن الديار عرفتها وكأنها","https://www.aldiwan.net/poem2172.html","الكامل"],[450,"لم توف أشواقي ولا لوعاتي","https://www.aldiwan.net/poem53723.html","الكامل"],[455,"الشكر يجدر أن يمثل عيدا","https://www.aldiwan.net/poem61637.html","الكامل"],[460,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[460,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[460,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[460,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[460,"سلا من سلا من بنا استبدلا","https://www.aldiwan.net/poem56005.html","المتقارب"],[460,"لو حملت عتبي الليالي","https://www.aldiwan.net/poem56006.html","مخلع البسيط"],[460,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[460,"يا وحشة المجد ثقي بالأنس","https://www.aldiwan.net/poem56153.html","الرجز"],[460,"وفى لي بك الحظ الذي كان يغدر","https://www.aldiwan.net/poem56168.html","الطويل"],[460,"متى رفعت لها بالغور نار","https://www.aldiwan.net/poem56187.html","الوافر"],[460,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[460,"على أي أخلاقِ الزمان أعاتبه","https://www.aldiwan.net/poem56287.html","الطويل"],[463,"سعد الزمان وكل موسم غبطة","https://www.aldiwan.net/poem15367.html","الكامل"],[463,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[463,"هنىء العام وما يعقبه","https://www.aldiwan.net/poem16222.html","الرمل"],[467,"عَثرَة ُ العُمر","https://www.aldiwan.net/poem36439.html","عموديه"],[493,"أيا أحمد ابن مليك الزمان","https://www.aldiwan.net/poem26668.html","المتقارب"],[500,"أطاعتك الذوابل والشفار","https://www.aldiwan.net/poem3696.html","الوافر"],[502,"يا إلهي يا معين العاجزين","https://www.aldiwan.net/poem37550.html","الرمل"],[502,"ظهر بأعباء الغرام قد انحنى","https://www.aldiwan.net/poem37761.html","الكامل"],[502,"حب النبي الهاشمي ديني","https://www.aldiwan.net/poem37768.html","الرجز"],[502,"إلهي بنور الذات في القدم الأسمى","https://www.aldiwan.net/poem37803.html","الطويل"],[531,"يجب حذف متعلقات الظروف","https://www.aldiwan.net/poem37306.html","المتقارب"],[545,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[553,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[560,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[569,"قد وفينا لك بالوعد","https://www.aldiwan.net/poem69489.html","الرمل"],[569,"تريك مرور الليالي العبر","https://www.aldiwan.net/poem69673.html","المتقارب"],[569,"ما أبصرت عيني ولا عين أحد","https://www.aldiwan.net/poem69706.html","الرجز"],[577,"ببرقة ثغر لا ببرقة ثهمد","https://www.aldiwan.net/poem3084.html","الطويل"],[754,"","https://poetry.dctabudhabi.ae/diwan/poem/121894","البسيط"],[824,"","https://poetry.dctabudhabi.ae/diwan/poem/103396","الطويل"],[861,"","https://poetry.dctabudhabi.ae/diwan/poem/21206","الوافر"],[900,"","https://poetry.dctabudhabi.ae/diwan/poem/10414","الطويل"],[958,"","https://poetry.dctabudhabi.ae/diwan/poem/22551","الطويل"],[958,"","https://poetry.dctabudhabi.ae/diwan/poem/22545","البسيط"],[958,"","https://poetry.dctabudhabi.ae/diwan/poem/22535","الوافر"],[1080,"","https://poetry.dctabudhabi.ae/diwan/poem/2546","الوافر"],[1163,"","https://poetry.dctabudhabi.ae/diwan/poem/18786","الوافر"],[1166,"","https://poetry.dctabudhabi.ae/diwan/poem/122173","الوافر"]],"verses":[["بِبَأسٍ مِثلِ غَربِ السَيفِ ماضٍ","وَجودٍ مِثلِ ماءِ المُزنِ هامِ",0,"م",1,0],["بِبَدرٍ مُعَمٍّ في الكَواكِبِ مُخوَلٍ","نَمَتهُ عُروقٌ لِلعُلى وَفُروعُ",1,"ع",1,0],["بِبُروقِ أَدراعٍ وَرَعدِ صَوارِمٍ","وَغَمامِ قَسطَلَةٍ وَوَبلِ دِماءِ",2,"ا",2,0],["بِبَابِيَ حُطَّ الرَّحْلَ لاَ تَنْوِ وِجْهةً","فَقَدْ فُزْتَ فِي حَالِ الإِقَامَةِ بِالْغُنْمِ",3,"م",1,0],["بِبَقَائِكَ الدُّنْيَا تُحَاطُ وَأَهْلُهَا","فَاللهُ جَلَّ جَلاَلُهُ يُبْقِيكَا",4,"ك",2,0],["بِبابِلَ لَم تُعصَر فَجاءَت سُلافَةً","تُخالِطُ قِنديداً وَمِسكاً مُخَتَّما",5,"م",2,0],["بِبابِكَ النَحسُ وَالسُعودُ","وَمَوقِفُ اليَأسِ وَالرَجاءِ",6,"ا",2,1],["بِبَعلٍ كُلُّهُ ذِكرٌ صَحيحٌ","وَأُنثى كُلُّها فَرجٌ مُباحُ",7,"ح",1,0],["بِبارِقَةٍ لِلمَوتِ فيها عَجاجَةٌ","مَناكِبُها مَسمومَةٌ وَنُحورُها",8,"ر",3,0],["بِبيضِ الصِفاحِ وَسُمرِ الرِماحِ","فَبِالبيضِ ضَرباً وَبِالسُمرِ وَخزا",9,"ز",2,0],["بِبَقَائِهِ وَرَدَاكَ مَوْعِظَةٌ","لِلسَّائِرِ المُفْضِي إِلَى الرجُمِ",10,"م",1,0],["بِبَنِيْكَ إسْمَاعِيلُ غُيِّبَ شَارِقٌ","وَقُوِّضَ بُنْيَانٌ وَأُغْمِدَ صَارِمُ",11,"م",1,0],["ببرَّةَ والنضرِ والمالكي","ن رهط هو الأنبل الأنبلُ",12,"ل",1,0],["بِبِيض يَنتَمُونَ إِلَى نِزَارٍ","مُهِيبِي سَاسَة وَمُؤَيِّهِينَا",13,"ن",2,0],["ببيت زهير حيث كعب مبارك","وحسان مدحي ثابتٌ ورجائي",14,"ي",1,0],["بباهر البرّ جدّد يا عليّ قوى","شعرٍ تجدْ خيرَ عمارٍ لأمداح",15,"ح",1,0],["ببدر ونور البدر واصف نفسه","وحلو وحلو لا يقاس بسكر",16,"ر",1,0],["ببديعه إن قالها متحجّب","عنَّا فلا حجبت مقالة مدره",17,"ه",1,0],["ببعض ما صفَّر أو ما سَذّجا","لا بأس إن أقرع أو إن أَتْرَجا",18,"ج",2,0],["ببعض حقك أنْ أصبحت عندهُمُ","مُشاوَرَاً في جسيم الأمر مُنْتَصَحا",19,"ح",2,0],["بِبَنانٍ كَمَدَارِي فضَّةٍ","طُرِّفَتْ بالنُّورِ في مجرى السُّبَحْ",20,"ح",1,0],["ببيتَيْك اللذين يخبِّرانا","بمحض الكفر عنك وبالجحودِ",21,"د",1,0],["ببنانٍ كأنهنّ مدارٍ","وأساريعُ في دِماث الرمالِ",22,"ل",1,0],["بِبِرِّ أميرِنا في كل عيدٍ","تواصَلَ منهما المتقاطعان",23,"ن",1,0],["ببيان بِدْعةَ إنَّها","في الحذق من بِدَعِ الزَّمانِ",24,"ن",1,0],["بِبَطنِ خَينَفَ مِن أُمِّ الوَليدِ وَقَد","تامَت فُؤادَكَ أَو كانَت لَهُ خَبَلا",25,"ل",2,0],["بِبيضِ الهِندِ وَالأَسَلِ الحِدادِ","أُرَجّى أَن يَتِمَّ ليَ مُرادي",26,"د",2,1],["ببيتك وهو أعظم كل بيت","يباهي المجد والحسب الصميم",27,"م",1,0],["ببيت الأمة أعتَقلِ المطيّا","وفي دهليزه أطرق ملِيا",28,"ي",2,1],["بِبيضٍ أَضاءَت في الخُدورِ كَأَنَّها","نُجومُ دُجاً جَلَّت سَوادَ الحَنادِسِ",29,"س",1,0],["بِبَردِ أَنفاسِهِ يَشفي الغَليلَ إِذا","دَنا فَقَرَّبَها مِن حَرِّ أَنفاسي",30,"س",2,0],["بِبيضٍ مَتى تُشهَر عَلى القَومِ يُغلَبوا","وَخَيلٍ مَتى تُركَض إِلى النَصرِ تَسبِقِ",31,"ق",1,0],["بِبُرقَةِ ثَهمَدٍ وَلَرُبَّ شَوقٍ","تَصَبّاني إِلى أَهلِ البِراقِ",32,"ق",1,0],["بِبارِعِ الفَضلِ يَأوي مِن شَهامَتِهِ","إِلى عَزائِمَ لَم تَضعُف وَلَم تَهِنِ",33,"ن",1,0],["بِبُروجٍ وُصِلنَ بالماءِ في الأر","ضِ وأُلحِقنَ بالسماءِ اتِصالا",34,"ل",2,0],["ببازٍ إذا أرسلَتهُ صادَ كلَّ ما","تَرومُ بهِ أو نالَ كلَّ مَنالِ",35,"ل",1,0],["ببيضٍ أخلَصَتْ حتى أقامَت","عَمُودَ الصُّبحِ في ظُلَمِ الدآدي",36,"د",2,0],["بِبَطنِ العَقيقِ أَو بِخَرجِ تَبالَةٍ","مَتى ما تَجِد حَرّاً مِنَ الشَمسِ تَدمُجِ",37,"ج",1,0],["بِبَأسِهِ أَضحَتِ الأَيّامُ جازِعَةً","فَلا تُصاحِبُ عُضواً غَيرَ مُضطَرِبِ",38,"ب",1,0],["بِبارِقٍ خَذِمٍ في مَأزِقٍ أَمَمٍ","أَو سائِقٍ عَرِمٍ في شاهِقٍ عَلَمِ",39,"م",1,0],["بِبيضٍ يَغتَدي نَملُ المَنايا","لَهُ مِن فَوقِ صَفحَتِها دَبيبُ",40,"ب",1,0],["ببروجِ قتالٍ تحسبها","في شُمّ شواهقها قُنَنَا",41,"ن",2,0],["بِبَعيدِ المَدى قَريبِ المَعاني","وَثَقيلِ الحِجى خَفيفِ الروحِ",42,"ح",1,0],["ببابِ فردوسِ حلبْ","سطرٌ بأعلاهُ عجبْ",43,"ب",1,1],["بِبَيضَةٍ كَمَهاةِ الرَملِ آنِسَةٍ","مِفتانَةِ الدَلِّ رَيّا الخَلقِ كَالقَمَرِ",44,"ر",1,0],["بِبَأسٍ لا كِفاءَ لَهُ وَعِلمٍ","جَلا الغَمَراتِ وَاِكتَسَحَ الدُجونا",45,"ن",2,0],["بِبَيان كَأنَّهُ نَفَحاتٌ","حَمَلتها يَد النَسيم زَكيه",46,"ي",2,0],["بِبَلقَعَةٍ أَثبَتَت حُفرَةً","ذِراعَينِ في أَربَعٍ خَيسَقِ",47,"ق",1,0],["بِبَياضِ وَجهٍ مَع عُيونِ ظِبا","بِسَوادِها فَتَكامَلَ الحُسنُ",48,"ن",1,0],["بِبِلادٍ فيها الرَكايا عَلَيهِن","نَ كَاللَيلِ مِن بَعوضٍ تَحومُ",49,"م",1,0],["بِبِلادٍ فيها الرَكايا عَلَيهِن","نَ أَكاليلُ مِن بَعوضٍ يَحومُ",50,"م",1,0],["بِبابِ بُنَيَّةِ الوَضّاحِ ظَبيٌ","عَلى ديباجَتَي خَدَّيهِ ماءُ",51,"ا",2,1],["بِبارِدِ الماءِ مِنَ الفُراتِ","تَخالُ فيها أَلسُنَ الحَيّاتِ",52,"ت",1,0],["بِبُوَيزِلٍ تَزدادُ جُرأَتُهُ","أَضَماً إِذا ما ليتُهُ رَشَحا",53,"ح",2,0],["بِبازِلٍ حينَ فَطَر","يَهُزُّهُ جِنُّ الأَشَر",54,"ر",1,0],["بِبَناتِ الشَمسِ ما مَنَعَت","نَفسَها مِن لَمسِ مُبتَذَلِ",55,"ل",1,0],["بِبَلدَةٍ لَم تَصِل كَلبٌ بِها طُنُباً","إِلى خِباءٍ وَلا عَبسٌ وَذُبيانُ",56,"ن",1,0],["ببعضِ أسماءِ فصلٍ","مشطّبٍ هندواني",57,"ن",2,0],["بِبَطنِ مَكَّةَ آثارٌ لِأَوَّلِكُم","مِمّا بَنى لِمَعَدٍّ جَدُّهُ أُدَدُ",58,"د",1,0],["ببَياضِها غرتنيَ الأيّامُ","وَبِطولِها خَدَعَتني الأعوامُ",59,"م",1,1],["بِبَغداد ناس راشدون بعلمهم","وَقوم من الجهال غير رَشيد",60,"د",1,0],["بِبَابِ المَقَاوِلِ مِنْ حِمْيَرٍ","تُشَدَّدُ أَعْضَادُهُ بِاللَّبِنْ",61,"ن",1,0],["بباب أليون تيودور اعتصمْ","فيمن وهىَ من الصفوف وانفصمْ",62,"م",1,0],["بِبَنَاتِ الرَّوْضِ تَسْعَى رُفْقةٌ","مِنْ بَنَاتِ الْجَاهِ وَالقَدْرِ الرَّفِيعْ",63,"ع",1,1],["بِبَهَائِهَا انْفَرَدَتْ وَيَحْفَلُ إِنْ بَدَتْ","مِنْهَاجُهَا بِمَوَاكِبِ الأَنْوَارِ",64,"ر",1,0],["بِبَالِغِ غَايَاتٍ إِلَيْهَا انْتَهَى النهَى","وَصَائِغِ آيَاتٍ لَهَا سَجَدَ النَّدي",65,"د",2,0],["بِبَهائِهَا انْفَرَدَتْ فَحَيْثُ بَدَتْ فَفِي","حَشْدٍ وَزِيناتٍ مِن الأَنْوَارِ",66,"ر",1,0],["بِبَيْنِكَ مُخْتَاراً صَدَمْتَ عَقِيدَةً","وَأوْقَعْتَ حُكْماً حَيَّرَ الحُكَمَاءَ",67,"ا",2,0],["بِبِرٍ لَمْ يُتِحْهُ الدَّهْرُ قَبْلاً","لِقَوْمٍ فِي حِمَاهُمْ مِنْ نَزِيلِ",68,"ل",1,0],["بِبَعْضِ مَا لَكَ مِنْ فضْلٍ رَفَعْتَ بِهِ","مَكَانَ قَوْمِكَ أَيُّ التَّكْرِمَاتِ يَفِي",69,"ف",2,0],["بِبَابِ الخندَقَينِ كأنَّ أُسْداً","شَوَابِكُهُنَّ يَحْمِينَ العَرِينَا",70,"ن",2,0],["ببراعةٍ لو أدركت موسى رأى","من سحرها ما غاب عن ثعبانه",71,"ن",2,0],["ببَطْن الأرض تسترهُ وهادٌ","وفوق الأرض تُظْهِرُه تلال",72,