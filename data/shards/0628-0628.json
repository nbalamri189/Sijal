{"poems":[[53,"متى أنا قائم أعلى مقام","https://www.aldiwan.net/poem29753.html","الوافر"],[53,"أظن الليالي بعدكم ستريع","https://www.aldiwan.net/poem30150.html","الطويل"],[53,"أبكيك لو نقع الغليل بكائي","https://www.aldiwan.net/poem30779.html","الكامل"],[77,"ألا هكذا تبنى المدارس للعلم","https://www.aldiwan.net/poem36089.html","الطويل"],[77,"مولاي ها أنا في جوار أبيكا","https://www.aldiwan.net/poem36382.html","الكامل"],[9,"ألم خيال من قتيلة بعدما","https://www.aldiwan.net/poem21981.html","الطويل"],[86,"ببابك النحس والسعود","https://www.aldiwan.net/poem68833.html","مخلع البسيط"],[71,"تحاجيني ولفظك مثل در","https://www.aldiwan.net/poem3854.html","الوافر"],[10,"ألا ابكي على صخر وصخر ثمالنا","https://www.aldiwan.net/poem21099.html","الطويل"],[10,"تعرقني الدهر نهسا وحزا","https://www.aldiwan.net/poem21100.html","المتقارب"],[93,"رب البيان وسيد القلم","https://www.aldiwan.net/poem11371.html","أحذ الكامل"],[93,"إلى أهلها تنعى النهى والعزائم","https://www.aldiwan.net/poem11408.html","الطويل"],[37,"إلى آل بيت أبي مالك","https://www.aldiwan.net/poem7368.html","المتقارب"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[72,"مزجت بتذكار العقيق بكائي","https://www.aldiwan.net/poem18199.html","الطويل"],[72,"سلبت عقلي بأحداق وأقداح","https://www.aldiwan.net/poem18481.html","البسيط"],[72,"عجبت لوصاف الذي قد هويته","https://www.aldiwan.net/poem18936.html","الطويل"],[72,"محراب صدغيه يحث توجهي","https://www.aldiwan.net/poem20511.html","الكامل"],[51,"من ذا رأت عيناه مثلي في الشجا","https://www.aldiwan.net/poem9239.html","الرجز"],[51,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[51,"ازجر القلب إذا القلب جمح","https://www.aldiwan.net/poem9414.html","الرمل"],[51,"أدار العامرية بالوحيد","https://www.aldiwan.net/poem61884.html","الوافر"],[51,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[51,"جرى الأضحى رسيل المهرجان","https://www.aldiwan.net/poem66393.html","الوافر"],[51,"باكر صباح المهرجان","https://www.aldiwan.net/poem66515.html","مجزوء الكامل"],[29,"هل تعرف اليوم من ماوية الطللا","https://www.aldiwan.net/poem6034.html","البسيط"],[78,"ببيض الهند والأسل الحداد","https://www.aldiwan.net/poem14259.html","الوافر"],[89,"أعظم شأن أبيات أتتني","https://www.aldiwan.net/poem45083.html","الوافر"],[85,"ببيت الأمة أعتقل المطيا","https://www.aldiwan.net/poem6825.html","الوافر"],[45,"يشوقك توخيد الجمال القناعس","https://www.aldiwan.net/poem64574.html","الطويل"],[45,"أقام كل ملث الودق رجاس","https://www.aldiwan.net/poem64599.html","البسيط"],[45,"حلفت لها بالله يوم التفرق","https://www.aldiwan.net/poem65186.html","الطويل"],[45,"تعود عوائد الدمع المراق","https://www.aldiwan.net/poem65196.html","الوافر"],[45,"كم من وقوف على الأطلال والدمن","https://www.aldiwan.net/poem66661.html","البسيط"],[61,"حرق تمتري الدموع سجالا","https://www.aldiwan.net/poem51461.html","الخفيف"],[61,"إلام يروم الحاسدون نضالي","https://www.aldiwan.net/poem51479.html","الطويل"],[61,"سهادي فيك أعذب من رقادي","https://www.aldiwan.net/poem51721.html","الوافر"],[2,"أعن كل أخدان وإلف ولذة","https://www.aldiwan.net/poem25038.html","الطويل"],[66,"بدت لنا الراح في تاج من الحبب","https://www.aldiwan.net/poem38500.html","البسيط"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[66,"كذا فليصبر الرجل النجيب","https://www.aldiwan.net/poem40117.html","الوافر"],[80,"أرأيت لنا ولهم ظعنا","https://www.aldiwan.net/poem31261.html","المتدارك"],[44,"أي رأي وأي عقل صحيح","https://www.aldiwan.net/poem30056.html","الخفيف"],[69,"بباب فردوس حلب","https://www.aldiwan.net/poem28647.html","مجزوء الرجز"],[31,"يا صاحبي أقلا اللوم واحتسبا","https://www.aldiwan.net/poem42544.html","البسيط"],[105,"رويدك أيها الجبار فينا","https://www.aldiwan.net/poem43385.html","الوافر"],[102,"مرحبا بالثقافة الغربيه","https://www.aldiwan.net/poem33122.html","الخفيف"],[17,"بالأبلق الفرد بيتي به","https://www.aldiwan.net/poem1198.html",""],[52,"أرأيت كيف بدا ليقتلنا","https://www.aldiwan.net/poem26659.html","الكامل"],[52,"كيف نومي وقد حللت ببغداد","https://www.aldiwan.net/poem26686.html","الخفيف"],[52,"طال ليلي وساورتني الهموم","https://www.aldiwan.net/poem26703.html","الخفيف"],[48,"بباب بنية الوضاح ظبي","https://www.aldiwan.net/poem10410.html","الوافر"],[48,"يا أيها العاذل دع ملحاتي","https://www.aldiwan.net/poem62460.html","الرجز"],[48,"يا صاحبي عصيت مصطبحا","https://www.aldiwan.net/poem62500.html","الكامل"],[48,"وبلدة فيها زور","https://www.aldiwan.net/poem63368.html","مجزوء الرجز"],[48,"يا مبيح الدمع في الطلل","https://www.aldiwan.net/poem64995.html","المديد"],[48,"يا ساحر الطرف أنت الدهر وسنان","https://www.aldiwan.net/poem65298.html","البسيط"],[48,"قل للعروضي عبد","https://www.aldiwan.net/poem66566.html","المجتث"],[50,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85563","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85475","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54999","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54831","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54756","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54873","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54537","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55126","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55026","البسيط"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67351","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[90,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[45,"يَشُوقُكَ تَوخِيدُ الجِمَالِ القَنَاعِسِ","https://www.poetsgate.com/ViewPoem.aspx?id=31217",""]],"verses":[["بِبَأسٍ مِثلِ غَربِ السَيفِ ماضٍ","وَجودٍ مِثلِ ماءِ المُزنِ هامِ",0,"م",1,0],["بِبَدرٍ مُعَمٍّ في الكَواكِبِ مُخوَلٍ","نَمَتهُ عُروقٌ لِلعُلى وَفُروعُ",1,"ع",1,0],["بِبُروقِ أَدراعٍ وَرَعدِ صَوارِمٍ","وَغَمامِ قَسطَلَةٍ وَوَبلِ دِماءِ",2,"ا",2,0],["بِبَابِيَ حُطَّ الرَّحْلَ لاَ تَنْوِ وِجْهةً","فَقَدْ فُزْتَ فِي حَالِ الإِقَامَةِ بِالْغُنْمِ",3,"م",1,0],["بِبَقَائِكَ الدُّنْيَا تُحَاطُ وَأَهْلُهَا","فَاللهُ جَلَّ جَلاَلُهُ يُبْقِيكَا",4,"ك",2,0],["بِبابِلَ لَم تُعصَر فَجاءَت سُلافَةً","تُخالِطُ قِنديداً وَمِسكاً مُخَتَّما",5,"م",2,0],["بِبابِكَ النَحسُ وَالسُعودُ","وَمَوقِفُ اليَأسِ وَالرَجاءِ",6,"ا",2,1],["بِبَعلٍ كُلُّهُ ذِكرٌ صَحيحٌ","وَأُنثى كُلُّها فَرجٌ مُباحُ",7,"ح",1,0],["بِبارِقَةٍ لِلمَوتِ فيها عَجاجَةٌ","مَناكِبُها مَسمومَةٌ وَنُحورُها",8,"ر",3,0],["بِبيضِ الصِفاحِ وَسُمرِ الرِماحِ","فَبِالبيضِ ضَرباً وَبِالسُمرِ وَخزا",9,"ز",2,0],["بِبَقَائِهِ وَرَدَاكَ مَوْعِظَةٌ","لِلسَّائِرِ المُفْضِي إِلَى الرجُمِ",10,"م",1,0],["بِبَنِيْكَ إسْمَاعِيلُ غُيِّبَ شَارِقٌ","وَقُوِّضَ بُنْيَانٌ وَأُغْمِدَ صَارِمُ",11,"م",1,0],["ببرَّةَ والنضرِ والمالكي","ن رهط هو الأنبل الأنبلُ",12,"ل",1,0],["بِبِيض يَنتَمُونَ إِلَى نِزَارٍ","مُهِيبِي سَاسَة وَمُؤَيِّهِينَا",13,"ن",2,0],["ببيت زهير حيث كعب مبارك","وحسان مدحي ثابتٌ ورجائي",14,"ي",1,0],["بباهر البرّ جدّد يا عليّ قوى","شعرٍ تجدْ خيرَ عمارٍ لأمداح",15,"ح",1,0],["ببدر ونور البدر واصف نفسه","وحلو وحلو لا يقاس بسكر",16,"ر",1,0],["ببديعه إن قالها متحجّب","عنَّا فلا حجبت مقالة مدره",17,"ه",1,0],["ببعض ما صفَّر أو ما سَذّجا","لا بأس إن أقرع أو إن أَتْرَجا",18,"ج",2,0],["ببعض حقك أنْ أصبحت عندهُمُ","مُشاوَرَاً في جسيم الأمر مُنْتَصَحا",19,"ح",2,0],["بِبَنانٍ كَمَدَارِي فضَّةٍ","طُرِّفَتْ بالنُّورِ في مجرى السُّبَحْ",20,"ح",1,0],["ببيتَيْك اللذين يخبِّرانا","بمحض الكفر عنك وبالجحودِ",21,"د",1,0],["ببنانٍ كأنهنّ مدارٍ","وأساريعُ في دِماث الرمالِ",22,"ل",1,0],["بِبِرِّ أميرِنا في كل عيدٍ","تواصَلَ منهما المتقاطعان",23,"ن",1,0],["ببيان بِدْعةَ إنَّها","في الحذق من بِدَعِ الزَّمانِ",24,"ن",1,0],["بِبَطنِ خَينَفَ مِن أُمِّ الوَليدِ وَقَد","تامَت فُؤادَكَ أَو كانَت لَهُ خَبَلا",25,"ل",2,0],["بِبيضِ الهِندِ وَالأَسَلِ الحِدادِ","أُرَجّى أَن يَتِمَّ ليَ مُرادي",26,"د",2,1],["ببيتك وهو أعظم كل بيت","يباهي المجد والحسب الصميم",27,"م",1,0],["ببيت الأمة أعتَقلِ المطيّا","وفي دهليزه أطرق ملِيا",28,"ي",2,1],["بِبيضٍ أَضاءَت في الخُدورِ كَأَنَّها","نُجومُ دُجاً جَلَّت سَوادَ الحَنادِسِ",29,"س",1,0],["بِبَردِ أَنفاسِهِ يَشفي الغَليلَ إِذا","دَنا فَقَرَّبَها مِن حَرِّ أَنفاسي",30,"س",2,0],["بِبيضٍ مَتى تُشهَر عَلى القَومِ يُغلَبوا","وَخَيلٍ مَتى تُركَض إِلى النَصرِ تَسبِقِ",31,"ق",1,0],["بِبُرقَةِ ثَهمَدٍ وَلَرُبَّ شَوقٍ","تَصَبّاني إِلى أَهلِ البِراقِ",32,"ق",1,0],["بِبارِعِ الفَضلِ يَأوي مِن شَهامَتِهِ","إِلى عَزائِمَ لَم تَضعُف وَلَم تَهِنِ",33,"ن",1,0],["بِبُروجٍ وُصِلنَ بالماءِ في الأر","ضِ وأُلحِقنَ بالسماءِ اتِصالا",34,"ل",2,0],["ببازٍ إذا أرسلَتهُ صادَ كلَّ ما","تَرومُ بهِ أو نالَ كلَّ مَنالِ",35,"ل",1,0],["ببيضٍ أخلَصَتْ حتى أقامَت","عَمُودَ الصُّبحِ في ظُلَمِ الدآدي",36,"ي",1,0],["بِبَطنِ العَقيقِ أَو بِخَرجِ تَبالَةٍ","مَتى ما تَجِد حَرّاً مِنَ الشَمسِ تَدمُجِ",37,"ج",1,0],["بِبَأسِهِ أَضحَتِ الأَيّامُ جازِعَةً","فَلا تُصاحِبُ عُضواً غَيرَ مُضطَرِبِ",38,"ب",1,0],["بِبارِقٍ خَذِمٍ في مَأزِقٍ أَمَمٍ","أَو سائِقٍ عَرِمٍ في شاهِقٍ عَلَمِ",39,"م",1,0],["بِبيضٍ يَغتَدي نَملُ المَنايا","لَهُ مِن فَوقِ صَفحَتِها دَبيبُ",40,"ب",1,0],["ببروجِ قتالٍ تحسبها","في شُمّ شواهقها قُنَنَا",41,"ن",2,0],["بِبَعيدِ المَدى قَريبِ المَعاني","وَثَقيلِ الحِجى خَفيفِ الروحِ",42,"ح",1,0],["ببابِ فردوسِ حلبْ","سطرٌ بأعلاهُ عجبْ",43,"ب",1,1],["بِبَيضَةٍ كَمَهاةِ الرَملِ آنِسَةٍ","مِفتانَةِ الدَلِّ رَيّا الخَلقِ كَالقَمَرِ",44,"ر",1,0],["بِبَأسٍ لا كِفاءَ لَهُ وَعِلمٍ","جَلا الغَمَراتِ وَاِكتَسَحَ الدُجونا",45,"ن",2,0],["بِبَيان كَأنَّهُ نَفَحاتٌ","حَمَلتها يَد النَسيم زَكيه",46,"ي",2,0],["بِبَلقَعَةٍ أَثبَتَت حُفرَةً","ذِراعَينِ في أَربَعٍ خَيسَقِ",47,"ق",1,0],["بِبَياضِ وَجهٍ مَع عُيونِ ظِبا","بِسَوادِها فَتَكامَلَ الحُسنُ",48,"ن",1,0],["بِبِلادٍ فيها الرَكايا عَلَيهِن","نَ كَاللَيلِ مِن بَعوضٍ تَحومُ",49,"م",1,0],["بِبِلادٍ فيها الرَكايا عَلَيهِن","نَ أَكاليلُ مِن بَعوضٍ يَحومُ",50,"م",1,0],["بِبابِ بُنَيَّةِ الوَضّاحِ ظَبيٌ","عَلى ديباجَتَي خَدَّيهِ ماءُ