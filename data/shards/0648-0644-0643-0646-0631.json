المتقارب"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70035","الوافر"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199049","الوافر"],[4123,"","https://poetry.dctabudhabi.ae/diwan/poem/114024","الطويل"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203271","الطويل"],[4220,"","https://poetry.dctabudhabi.ae/diwan/poem/104423","الطويل"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67609","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58042","الطويل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28944","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33470","المتقارب"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139729",""],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4717,"نقاط الخبز","https://www.poetsgate.com/ViewPoem.aspx?id=199677",""],[4767,"الأتست (قسم اعتماد الصرف)","https://www.poetsgate.com/ViewPoem.aspx?id=88157",""],[4826,"دعيني","https://www.poetsgate.com/ViewPoem.aspx?id=196746",""],[4955,"أضاعت نخوة العربان فينا ؟","https://www.poetsgate.com/ViewPoem.aspx?id=215778",""],[4984,"بشرى العيد","https://www.poetsgate.com/ViewPoem.aspx?id=189552",""],[5216,"موعد","https://www.poetsgate.com/ViewPoem.aspx?id=187647",""],[5302,"ملحمة الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=200060",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5582,"أَلا هَلْ رأَتْ عَيْناكَ لِلْحَيِّ أَظْعانَا","https://www.poetsgate.com/ViewPoem.aspx?id=63594",""],[5779,"نسيت بيُوت الشّعْر يَا فرسي وَقد","https://www.poetsgate.com/ViewPoem.aspx?id=189119",""],[5786,"يميناً بها إن كنت للصبّ مُسعِدا","https://www.poetsgate.com/ViewPoem.aspx?id=50660",""],[5815,"كَفَاكَ","https://www.poetsgate.com/ViewPoem.aspx?id=190008",""],[5873,"حصون العز","https://www.poetsgate.com/ViewPoem.aspx?id=215408",""],[5956,"أكذوبة","https://www.poetsgate.com/ViewPoem.aspx?id=183230",""],[5956,"نُغنّي للقياك يا أبتاه","https://www.poetsgate.com/ViewPoem.aspx?id=192780",""],[5956,"إذا التاريخُ","https://www.poetsgate.com/ViewPoem.aspx?id=194508",""],[6068,"ورثنا المجد ميراث فرض -15-","https://www.poetsgate.com/ViewPoem.aspx?id=175886",""],[6068,"ولي كلف وليس بها مثيل -03-","https://www.poetsgate.com/ViewPoem.aspx?id=175926",""],[5309,"ومن يدرع بالعنف يدرك مراده","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573790",""],[520,"فليت الرسالة لما تكن","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577555",""]],"verses":[["وَلَكِن رَأى سَبَّ النَبِيِّ غَنيمَةً","وَما حَولَهُ إِلّا مُريبٌ وَجاحِدُ",0,"د",1,0],["وَلَكِن رَجاءً أَن تَكونَ لِهِمَّتي","طَريقاً تُؤَديني إِلى كُلِّ مَطلَبي",1,"ب",2,0],["وَلَكنْ رَمَتْني بِابْنِ آخِرِ لَيْلَةٍ","خُطوبٌ أَذَلَّتْ مِدْرَهَ القَوْمِ لِلْغُمْرِ",2,"ر",1,0],["وَلَكِنَّ رَبّي كَفى غُربَتي","بِحَمدِ الإِلَهِ فَقَد بَلَّغَن",3,"ن",1,0],["وَلَكِن رَهطُ أُمِّكَ مِن شِيَيمٍ","فَأَبصِر وَسمَ قِدحِكَ في القِداحِ",4,"ح",1,0],["ولكنَّ ربِّي شاءَ غيرَ مشيئتي","وللرَّبِّ إمْضَاءُ المشيئةِ لا العَبْدِ",5,"د",1,0],["ولكن رأى سعدَ الكواكب فوقه","فسار وديعاً سيرُه كركُودِهِ",6,"د",2,0],["ولكن رأيتَ الحسم للبذل كلِّه","صواباً لأن الرعد يؤذن بالقطر",7,"ر",1,0],["ولكن رأيتَ العرفَ عرفاً لعينه","فجدت ببذل العرف جود مخَيَّرِ",8,"ر",1,0],["ولكن رأوا دونَ الكلام ونظمِهِ","حقيقيْن إذ أنتَ المنادَى المكلَّمُ",9,"م",1,0],["وَلَكِن رَآكَ اللَهُ مَوضِعَ حَقِّهِ","عَلى رَغمِ أَعداءٍ وَصَدّادَةٍ كُذبِ",10,"ب",1,0],["ولكن روحي للسماء رقيها","هنالك من نجم لنجم تجول",11,"ل",1,0],["وَلَكِن رُؤوسٌ لِأَموالِهِم","يُحَرِّكُ قَرنَيهِ شَيطانُها",12,"ن",3,0],["وَلَكِن رَبُّهُم أَسرى إِلَيهِم","فَما نَفَعَ الوُقوفُ وَلا الذَهابُ",13,"ب",1,0],["وَلَكِن رَأَيتُ القَصدَ في الفَضلِ شِركَةً","فَكانَ لَكَ الفَضلانِ بِالقَصدِ وَالفَضلِ",14,"ل",1,0],["وَلَكِنَّ رَبّي رَبُّ يونُسَ إِذ دَعا","مِنَ الحوتِ في مَوجٍ مِنَ البَحرِ سائِلِ",15,"ل",1,0],["وَلَكِن رَأى أَنَّ الحَياةَ ذَميمَةٌ","وَأَنَّ المَنايا تَرتَقي كُلَّ سُلَّمِ",16,"م",1,0],["وَلَكِن رُمتَ بِالشِعرِ اِمتِحاني","فَجاءَكَ مِثلُهُ دُبّاً بِقِردِ",17,"د",1,0],["وَلَكِن رَأَيتُ الغيل إن غابَ لَيثُهُ","تَبَخَّرَ في أَرجائِهِ الذئبُ مائِسا",18,"س",2,0],["ولكنْ رأيتُ العلى ضَرّةً","تُنَافِرُ كلّ فتاةٍ خرودِ",19,"د",1,0],["وَلَكِن رَأى شُكري قِلادَةَ سُؤدُدٍ","فَصاغَ لَها سِلكاً بَهِيّاً مِنَ الرِفدِ",20,"د",1,0],["وَلَكِن رُبَّ مَطروحٍ","مَليحِ الدَلِّ وَالزَهوِ",21,"و",1,0],["ولكن رأيتُ الشعرَ سُنّةَ مَن خَلا","له رَجَزٌ ما ينقضي وقصيد",22,"د",1,0],["ولكن رأى ذُلاًّ فهانَتْ مَنِيّةٌ","وجَرّبَ خُطباناً فلَذّ هَبيد",22,"د",1,0],["وَلَكِن رَأَيتُ السَيفَ مِن بَعدِ سَلِّهِ","إِلى الهَزِّ مُحتاجاً وَإِن كانَ ماضيا",23,"ي",2,0],["وَلَكِنَّ رَوحاً عَدا طَورَهُ","وَما كُنتُ أَحسَبُ أَن يَفعَلا",24,"ل",2,0],["ولكنْ ردَى النفسِ التي كنتَ حُبَّها","ونافثَ هذا السحرِ في كلماتِها",25,"ت",3,0],["ولكن رأيت الله يمدح أهله","ومن فضله بدء العطا والخواتم",26,"م",1,0],["ولكن رَضوا من حُبّهمْ لبلادِهمْ","بأنَّهمُ يَبكُونها حينَ تُنكَب",27,"ب",1,0],["ولكن رأيتُ الغيل إن غابَ ليثُهُ","تبختر في أرجائه الذئب مائسا",28,"س",2,0],["ولكن رفع العلم في موت أهله","وهذا لأشراط القيام شهيد",29,"د",1,0],["ولكِنْ رآهُ اللَّهُ مَوْضِعَ حَقّها","على رغمِ أعداءٍ وصدادة ٍ كذب",30,"ب",1,0],["ولكن ريب الدهر صعب مراسه","ترى كل حر تحته متزلزلا",31,"ل",2,0],["ولكن رفع العلم في موت أهله","وهذا الأشراط القيام شهيد",32,"د",1,0],["ولكن رأى وجهَه مقمرا","فأبَدى كواكبَ من ثغره",33,"ه",1,0],["ولكن رأيت القوم للشر أجمعوا","عليَّ وسدّوا كلَّ باب وأَغَلقوا",34,"ق",3,0],["وَلكنّ روحَ القدسِ إذ جاء نافخاً","بِها حَمَلت عيسى وما بَرِحت بكرا",35,"ر",2,0],["وَلكِن رَأى ديناً تهيّأ قبلهُ","رَأى أصلهُ فيه يتابع أصلهُ",36,"ه",1,0],["وَلكِن رَاَيتُ بِها جاذِباً","يُحَرِّكُ في داخِلي صبوَتي",37,"ي",1,0],["ولكن رأت في الأرض أفعى مجدلاً","على قدر غرمول الحمار المشغب",38,"ب",1,0],["ولكنّ رسمي في حقيقة وسم ذا ال","وليّ أتى ينبي عن الفيض بالوسم",39,"م",1,0],["وَلكِن رُبَّما جَرَّ","إِذا ما كانَ تَمهيلُ",40,"ل",1,0],["ولكنَّ رؤياي المنيرةَ أظلمت","فأعقبني حزناً زوالُ المسرّة",41,"ه",1,0],["ولكن رأيت المال للنفس حضرةً","فأصبحت أجني زهره من ربا الربا",42,"ب",2,0],["وَلكن رُمتَ أمراً لَم يَرمهُ","أَبيٌّ لا يبيعُ النفسَ خُسرا",43,"ر",2,0],["وَلكِنْ رَدا ما اعتَدْتُ شَيئاً ألفتُهُ","وكُلُّ امْرِئٍ جَارٍ علَى مَا تَعَوَّدا",44,"د",2,0],["ولكنْ رقَّ ماءُ الخَدِّ حتّى","أَراك خَيالَ أَهدابِ الجُفون",45,"ن",1,0],["ولكنْ رأَى ذاكَ الَّذي سَمِعوا به","بأَعينِهمْ قومٌ رُدِدْتَ عليهِم",46,"م",1,0],["ولكنْ رُبَّما عُهِدَ اتِّفاقاً","حِسانٌ في الزّمانِ بلا بُخوت",47,"ت",1,0],["ولكن رُمتَ شيئاً لم يَرُمهُ","سِواكَ فلم أُطِق يا ليثُ صبرا",48,"ر",2,0],["ولكن رأيي فيه صدقاً بأنه","سديد المعاني مستقيم العقيدة",49,"ه",1,0],["ولكن رحمة الله تسعني","وعفوالله أعظم من عيوبي",50,"ب",2,0],["ولكن رأيتُ النّظْمَ منك فريضةً","فقامتْ به خوفَ العِتابِ القرائحُ",51,"ح",1,0],["ولكنْ رُبَّ دهرٍ ساوَرَتْني","غوائِلُهُ على نَهْجِ السَّبيلِ",52,"ل",1,0],["ولكن رجائي من يديك شفاعة","فإن نلت ذاك الفضل إني أنا أنا",53,"ن",2,0],["ولكن رجاؤك يبغي المزيد","ربما سوف يضرب عنه المثل",54,"ل",1,0],["وَلَكِن رَجَونا مِنكَ مِثلَ الَّذي بِهِ","صُرِفنا قَديماً مِن ذَويكَ الأَفاضِلِ",55,"ل",1,0],["وَلَكِن رَأوا أمراً لَهُم فِيهِ مَطمَعٌ","وَكَادُوكَ مِن جَهلٍ كأَنَّكَ مَازِحُ",56,"ح",1,0],["ولكن ربُّها سَمْحٌ كريمٌ","فيعَذِرُني ويَرضَى بالقليلِ",57,"ل",1,0],["ولكنْ رَضِيتُ بحُكمِ القَضاءِ","وسلمتُ أمري لحُكمِ القَدَرْ",58,"ر",1,0],["ولكنْ رَفَقْتَ له رحمةً","فلو سارَ لانحط أَو لانْحَطَم",59,"م",1,0],["ولكن رأَيتَ الجندَ للملكِ زينةً","كما زيَّن اللهُ المحاجرَ بالهُدْب",60,"ب",1,0],["ولكن رماهم بالقريض حمية","فاكرم بدمي قامع للمؤنب",61,"ب",1,0],["ولكنْ رَوينا عن وصيِّ محمدٍ","وما كان فيما قال بالمتكذِّبِ",62,"ب",1,0],["ولكن رضانا بحكم المليك","صلاحٌ وفي مثله أصلح",63,"ح",1,0],["وَلَكِنَّ ربّ الخَلقِ بِالمَوتِ قَد قَضى","وإنّ فناءَ الخَلْقِ أمرٌ مسَطَّرُ",64,"ر",1,0],["ولكن رأينا بعلبك مليكة","عليهن في عرش العلى تتربع",65,"ع",1,0],["ولكنْ رأى أصحابَها في غَوَايةٍ","تَغُرهمُ لِعْباً وتخدعهُمْ لهوا",66,"و",2,0],["وَلَكِن رَحَلنَاهَا نُفُوساً كَرِيمَةً","تُحَمَّلُ ما لا تَستَطيعُ فَتَحمِلُ",67,"ل",1,0],["وَلكن رأيتُ الدهرَ يصرف نابهُ","ويفرق منّي العضوَ جوراً وبهتانا",68,"ن",2,0],["وَلكن رمَتني الحادثاتُ بأسهمٍ","منَ الدهرِ لا ممّا تأبّط مصدعُ",69,"ع",1,0],["وَلَكِن رَأَيت المَوت يُمسي رَسوله","وَيُصبح لِلنَفس اللجوج بمرصد",70,"د",1,0],["ولكن رفعت الكف ارجو اغاثة","من الله منها يسهل المتعسر",71,"ر",1,0],["ولكن رعايات المهيمن لم تزل","موايدها في سائر الناس تنشر",71,"ر",1,0],["وَلَكِنْ رَأَيْتُ المَدْحَ فيكَ فَريضَةً","عَلَيَّ إِذا كانَ المَديحُ تَطَوُّعا",72,"ع",2,0],["وَلكِنْ رُبَّ إِحْسانٍ وَبِرٍّ","دَعا بَعْضَ الرِّجالِ إلى الْعُقوقِ",73,"ق",1,0],["ولكن رأى والحمد لله باقياً","له حسنٌ فاختار ما اختار ذو العرش",74,"ش",1,0],["ولكن رمى من غرَّةٍ ما أصابها","بمثلك رامٍ منه يرمي فيعطب",75,"ب",1,0],["ولكنَّ رأيَ الأكثرية جاهل","يحاول أن يقضي على العلم مُبْرَما",76,"م",2,0],["ولكن رأيتكَ فذاًّ بأَرضٍ","همى كلُّ فضلٍ بها للهمل",77,"ل",1,0],["ولكن رضوان من لؤمه","بخيل على كل خير وشر",78,"ر",1,0],["ولكن رأيت السيف من بعد سله","الى الهز محتاجاً اذا كان ماضياً",79,"ي",2,0],["وَلَكِن رَغِبتُمُ في الإِمامِ وَفَضلِهِ","فَأَسعَدَكُم فيما ظَفِرتُم بِهِ الزُهدُ",80,"د",1,0],["ولكنَّ ربي قد أتى فأتيته","وقلت لسرِّي حسبُك المنتهى فقط",81,"ط",1,0],["ولكن رأيت الصبر أحجى ولم ينل","ثواب مقام الله إلا صَبُوره",82,"ر",2,0],["ولكن رأيت الدهر ينسيك ما مضى","إذا أنت لم تحدث إخاء ولا عهدا",83,"د",2,0],["ولكن رأيتُ القناعة في ال","عيش أروح للقلب بل أَهنأَ",84,"ا",1,0],["ولكن رأينا الصبر ضربة لازبٍ","ورب عجول سعيه صادف العثرا",85,"ر",2,0],["ولكن رأسه جلد جليد","صبور عند مختلف الطعان",86,"ن",1,0],["ولكن رأيت الشعر في العصر دولةً","مضعضعةً من غير نهي ولا أمر",87,"ر",1,0],["ولكن رأيتُ الفضل يُحمد ربه","فأديت فرض الحمد فيه لأحمدا",88,"د",2,0],["ولكن رأيت اسمي على الطرس خطّه","فأصبحت بين الشك والصدق والكذب",89,"ب",1,0],["ولكن رمتها بعد حين كأنها","رأتها ستغدو عن قريب من الموتى",90,"ا",1,0],["وَلَكِن رَفيقٌ بِالصِبا مُتَبَطرِقٌ","خَفيفٌ ذَفيفٌ سابِغُ الذَيلِ أَهيَفُ",91,"ف",1,0],["ولكن رأى سلطان عز وهيبة","فقبّل وجه الأرض بين يديه",92,"ه",1,0],["ولكنْ رأيتُ الصبر أَوْلَى من الشكوى","أَبيتُ بخسرانٍ وأنت تُقيدهم",93,"م",1,0],["وَلكِن رَجائي أَن أُؤَدِّيَ واجِباً","وَذلِكَ فيما تَستَحِقُّ يَسيرُ",94,"ر",1,0],["ولكن رأَى الصبرَ أَولى به","فكرَّ وهل للردى من مَرّدْ",95,"د",1,0],["وَلَكِن رَدى ثُمَّ اِرعوى حَلِساً بِهِ","يُمارِسُها حيناً وَحيناً يُطاردُ",96,"د",1,0],["وَلَكِن رَفيقٌ بِالوِصالِ وَمِزحَلٌ","عَزوفٌ إِذا كانَ التَجَنُّبُ أَحزَما",97,"م",2,0],["ولكن رأيت الليث يأبى فريسة","غدت لوحوش البر نهبا مقسما",98,"م",2,0],["ولكن رأى العلياء في زيّ غادة","لها بين سمر الخط والبيض ملعب",99,"ب",1,0],["وَلَكِنَّ رُمحَ مَنيلا اِستَقَر","بِكَفٍّ بِها لا يَزالُ الوَتَر",100,"ر",1,0],["وَلَكِن رَسُولا العًلى والبَشَر","أُسِيرا يَكُفَّانِ شَرًّا أَمَر",101,"ر",1,0],["ولكن رقى الحصن فيبوس ينوي","له الشر والحصن منه وقى",102,"ق",2,0],["وَلَكن ربهُ ناداهُ ارّخ","فَأنتَ بِمحضري السامي سَعيدُ",103,"د",1,0],["ولكن رضاء بالقضاء الذي مضى","وعلما بأن النقص عمت مواكبه",104,"ب",2,0],["ولكن رحلناها نفوساً كريمةً","تحمل ما لا يستطاع فتحمل",105,"ل",1,0],["ولكن رآها جوهراً سميت طلا","فميز ما قد حلت الكاس بالذهب",106,"ب",1,0],["ولكن رسول الموت بادر محبراً","بأني عن الدنيا قريب مسافر",107,"ر",1,0],["ولكنْ رضاه ليس يُجدي قلامةً","فما فوقه إذْ سخطُهُ ليس يُرهبُ",108,"ب",1,0],["ولكنْ رضينَا بالقضاءِ وحكمهِ","فقسمتُه فيها استوى العبدُ والحرُ",109,"ر",1,0],["ولكن رأيت الموتَ ادركَ تُبَّعا","ومن بعده من حادثٍ وقديمِ",110,"م",1,0],["ولكن رأيتكَ مستأهلاً","لودّي قوياً علَى حملهِ",111,"ل",2,0],["ولكن رضينا بالقضاء وبالرضا","سلونا ولولاه رزاياه لا تُسلى",112,"ل",2,0],["وَلَكِن رفعت النَفسَ فَاِرتَفَعَ الحِجا","وَنُبِّهتُ مِن نَومي فَما أَنا ضاجِعُ",113,"ع",1,0],["ولكنْ ربما تُفنِي بحقٍ","جرائمَكم حبالٌ مستديره",114,"ر",2,0],["ولكن رغم ما قد كان منا","فقد بتنا بشوق راغبينا",115,"ن",2,0],["ولكن روحي لها عادة","إذا طوقت بالهموم العظام",116,"م",1,0],["ولكن رغمَ ذاكَ لنا رجالٌ","تذودُ عن الحمى فيها مقيمةْ",117,"م",2,0],["ولكن رجونا الرحيم انفراجا","فلليل رغم النوائب فجر",118,"ر",1,0],["ولكنْ رَجَعْتِ وقدَّمْتِ عُذراً","وغَرَّكِ منّي فؤادٌ غَفورُ",119,"ر",1,0],["ولكن رب العرش أهداك ثلة","تزينهم في العالمين الشمائل",120,"ل",1,0],["ولكن روى هذا الحديث معللاً","عن ابن حميد باضطرابٍ فلا يجد",121,"د",1,0],["وَلَكِنْ رأَيْتُ الدَّهْرَ يَصْرِفُ نابَهُ","وَيَعْرُقُ مِنِّي العَظْمَ جَوْراً وَعُدْوانَا",122,"ن",2,0],["وَلَكِن رأيتيها بِنَجْد وَأَهْلهَا","على صفة أُخْرَى فعذرك ظَاهر",123,"ر",1,0],["ولكن رأى أنّ الإله تعاظمت","معانيه عنْ حصرٍ وعنْ أنْ يحدّدا",124,"د",2,0],["ولكنّ ربيْ هدى بالسماحِ‎","إليه الردى والهدى والظفرْ‎",125,"ر",1,0],["ولكن رغم ذلك سوف يأتي","ضياء الصبح ينفلق انفلاقا",126,"ق",2,0],["ولكنَّ رازقيَ الأريحيَّ","تكفَّل أمري ويحبو وتحْبو..",127,"ب",2,0],["ولكن ربّي سيجمع شملي","ولن يستجيبَ لأعدائنا",128,"ن",2,0],["ولكنْ ربما في ذات يومٍ","ستدْرسُني بلادٌ بي تصِحُّ",129,"ح",1,0],["ولكن رغم ذلك ليس يدري","بأنّا ننجب الأبطال وُلْدا",130,"د",2,0],["ولكن رغم ذاك أقول قولا","لقيت من الهوى ما يستطاب",131,"ب",1,0],["وَلكِنَّ رَبَّ النّاسِ يَقضي بِعَدلِهِ","وَيُنقِذُ مِن جُبِّ الأُسودِ عِبادَهُ",132,"ه",1,0],["ولكن رسائل لما تعد","علينا بخير وعادت بشر",133,"ر",1,0]]}