120513","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139650",""],[4771,"ناعى أبي جعفر القاضي دَعوتَ إلى ل","https://www.poetsgate.com/ViewPoem.aspx?id=106573",""],[4894,"ورغيف كَأَنَّهُ الترس يحْكى","https://www.poetsgate.com/ViewPoem.aspx?id=189788",""],[3271,"إني سائر للخلود","https://www.poetsgate.com/ViewPoem.aspx?id=103531",""],[5122,"(( يامضيع العشاق..1))","https://www.poetsgate.com/ViewPoem.aspx?id=27095",""],[5129,"مقام الفعل","https://www.poetsgate.com/ViewPoem.aspx?id=120509",""],[5187,"وجيه في التسعين","https://www.poetsgate.com/ViewPoem.aspx?id=29067",""],[5187,"عروس العاصي","https://www.poetsgate.com/ViewPoem.aspx?id=29699",""],[5273,"مأساة العاصي","https://www.poetsgate.com/ViewPoem.aspx?id=28757",""],[5879,"خماسيات الوجد (2)","https://www.poetsgate.com/ViewPoem.aspx?id=215452",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[444,"جمرة من صدى صوتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81748&r=&rc=4",""]],"verses":[["ناعورةٌ بمنازلِ البحر اقْتضت","في حالةِ التشبيه بثُّ عجائب",0,"ب",1,1],["ناعورةٌ نشأت على عهد الأسى","مثلي فما تنفكّ ذات توجع",1,"ع",1,1],["ناعشاً منْ حَيَّ منهُمْ ناشراً","من أجنَّتْهُ من القوم اللُّحودُ",2,"د",1,0],["ناعمَ البال ذا عدوٍّ شقيٍّ","آمنَ السِّربِ ذا عدوٍّ مروع",3,"ع",1,0],["ناع من الاسكندرية هاتف","راع الكنانة أرضها وسماءها",4,"ا",3,0],["ناعيات نفح الربى من سجايا","ك وزهر الرياض من آدابك",5,"ك",1,0],["ناعيكَ ناعي حاتَمٍ أَو جَعفَرٍ","فَالناسُ بَينَ نَوازِلٍ وَدَواهِ",6,"ا",2,0],["ناعِمَةً لَم تُرَع","لاهِيَةً لَم تَجَم",7,"م",1,0],["ناعِمَةُ الجِسمِ لا عِظامَ لَها","لَها بَناتٌ وَما لَها رَحِمُ",8,"م",1,0],["ناعِماتُ الأَطرافِ لَو أَنَّها تُل","بَسُ أَغنَت عَنِ المُلاءِ الرِقاقِ",9,"ق",1,0],["ناعورةٌ مذعورةٌ","وَهْيَ كثكلى حائرَهْ",10,"ه",1,1],["ناعِباتٌ كَما غَدَت ناعِياتٌ","وَحَمامٌ كَما تَغَنّى القِيانُ",11,"ن",1,0],["ناعماتٍ منَعَّماتٍ حسانٍ","وُضَّحِ اللونِ رُجَّح الأكفالِ",12,"ل",1,0],["نَأ عنهن سَاكَنَ كُلَّ أرضٍ","تطيبُ بِها المشارب والطعام",13,"م",1,0],["ناعمٍ لم أزل به","في حياتي مُنَعَّما",14,"م",2,0],["ناعس الأجفان قد علمني","طرفه بعد النشاط الكسلا",15,"ل",2,0],["ناعورة أنَّة أَنِينَ الهوى","لمَّا شكت حَرَّ وساويسها",16,"س",3,1],["ناعِسُ الجَفنِ قالَ لي بِدَلالٍ","أَحَقيقٌ أَن لَيسَ يوجَدُ سِحرُ",17,"ر",1,1],["ناعِس الطرف عَن صَريع هَواه","مائِس القَد عَن مَعاطِف بانَه",18,"ن",2,0],["نَاعَمَتْهَا أُمُّ صِدْقٍ بَرَّةٌ","وَأَبٌ بَرٌّ بِها غَيرُ حَكِرْ",19,"ر",1,0],["ناعساً سالَ تاركاً شفتيْه","لؤلؤاً شعّ في الدّجى ألوانا",20,"ن",2,0],["ناعِمَةٌ رَشُوفُ","نَافِرَةٌ أَنُوفُ",21,"ف",1,0],["ناعٍ نَعى ليَ إِبراهيمَ قُلتُ لَهُ","شُلَّت يَداكَ وَعشتَ الدَهرَ عُريانا",22,"ن",2,0],["ناع أصات فقال الدهر مندهشاً","اللَه أكبر ماذا أبدع القدر",23,"ر",1,0],["ناعسُ طرفٍ بات مِن هزلهِ","يُفيدُ طرفي الجِدَّ في سُهدِهِ",24,"د",2,0],["ناعشي مَن يَرى مَطيَّتَهُ النع","شَ إذا ما عداهم استنعاشا",25,"ش",2,0],["ناعِمُ العَيشِ رَغده بِاِرتِياحٍ","بِنَشاطٍ وَلا اِعتَراك عياءُ",26,"ا",2,0],["ناعم البَشْرة بالن","طرة يستوقعُ داءَ",27,"ا",2,0],["ناع نعى الباقر العلم الذي أخذت","عن علمه علماء العجم والعرب",28,"ب",1,0],["ناعس الطرف لقلبي عذبا","مذ رماني بسهام الأعين",29,"ن",1,0],["ناعورةٍ قالت لنا بأنينها","قولاً ولم تدرِ المقالَ ولم تعِ",30,"ع",1,1],["ناعورةٍ مُذ غابَ عنها قلبُها","دارت عليه بأنَّةٍ وبُكاءِ",31,"ا",2,1],["ناعماً بالوفا وطيب الأماني","طيبا بالرفاء والولدان",32,"ن",1,0],["ناعم الأطراف ما أسعد من","ضمه معتنقاً أو أقبلا",33,"ل",2,0],["ناعم الخدين مهضوم الحشى","أحور الطرف كحيل ذو دلال",34,"ل",1,0],["ناع بكى ملأ البلاد أنينا","ينعى لمصر وللشآم أمينا",35,"ن",2,1],["ناعسة الأجفان لكنها","إذا رنت ترمي الحشى بالنبال",36,"ل",1,0],["ناع نعى فلم يقل زيد قضى","بل قال ربع الفضل عاد بلقعا",37,"ع",2,0],["ناعسة الطرف ولكنها","يقظانة كم رشقت بالنبال",38,"ل",1,0],["ناعورةٌ تَحسبُ في صوبتها","متيَّماً يشكو إلى زائرِ",39,"ر",1,1],["ناعِمُ البالِ عِندَهُم أَم شَقِيٌّ","شاكِرٌ فَضلَ عَهدِنا أَم كَفورُ",40,"ر",1,0],["ناعم الخد والاديم نحيل الخصر","ضخم الصلا صقيل الجيد",41,"د",1,0],["ناعس الأجفان لما ابتسما","خجلت من حسنه شمس السما",42,"ا",1,0],["ناع نعاك نعى الدُنيا وَزهرتها","وَالعلم فيهِ غراب البين قَد نَعَقا",43,"ق",2,0],["ناعسٌ طرفُها وهو ذو انتباه","ويح نفسي من نعاسٍ يقظان",44,"ن",1,0],["ناعس الاجفان صل دنفاً","ساهر الاجفان لم ينم",45,"م",1,0],["ناعي الهدى أكفف لعل القوم قد كذبوا","ما بعد كل دخانٍ قاتم لهب",46,"ب",1,1],["ناعسة الاجفان قد بان لها","طرفي في جنح الدجى مؤرقا",47,"ق",2,0],["ناعيك إن حزّ في مصر وَساكنها","فَفي دمشق صدى منه وَبغدادِ",48,"د",1,0],["ناعس الأجفان ساجي المقل","حرج الخلخال جوال الوشاح",49,"ح",1,0],["ناع بسامراء قد فجعت","فينعيه الأمصار والمدن",50,"ن",1,1],["ناعس الأَجفان قَد طالَ السهادْ","دانياً في القَلب قَد جارَ البِعادْ",51,"د",1,1],["ناعِمَةٌ أَخْشَى إِذْا ما مَشَتْ","أَنْ يَسْقُطَ الرُّمَّانُ فِي الجُلَّنارْ",52,"ر",1,0],["ناعم البال ليس تزهو بشيء","نعمة لا يذب عنها مخاشن",53,"ن",1,0],["ناعس الأجفان لكن لحظه","يوقظ الأشواق في بال التجين",54,"ن",1,0],["ناعمات الخدود رودٌ قصيرا","تُ خيامٍ شوارعُ الأجياد",55,"د",1,0],["ناعى أبي جعفر القاضي دَعوتَ إلى ل","رَّدى فَلم يدْر ناع أنتَ أم داعِ",56,"ع",1,1],["ناعم لين كمبسم من قا","م بعذري عِنْد البرايا عذاره",57,"ر",2,0],["ناعمةٌ هاجتْ لقيد الحمى","شديدةَ البأس كصخرٍ صلودْ",58,"د",1,0],["ناعم ولا هزه نسيم الهواء طار","خطر\"على خدك يجي منه تأثير",59,"ر",1,0],["نَاعُورَةُ الْحَيِّ الْقَدِيمِ تَنَفَسَتْ","صُعُدًا وَأًنْشَدَتِ الْجُمُوعَ صَلِيلَا",60,"ل",2,0],["ناعورةٌ تبكي وأخرى تشتكي","وهناك ثالثةٌ لأجلكَ تسهرُ",61,"ر",1,0],["ناعورتي يا روحَ خاطرتي","وسطورَ تاريخي ومهدَ أبي",62,"ب",2,0],["ناعورةٌ لبستْ ثوبَ الخريفِ أسىً","واصْفرَّ مكحَلُها ما عادَ يُكتحلُ",63,"ل",1,0],["ناعسُ الطرفِ أغني للكواعبْ","يا حبيبًا شوقُه في القلبِ ضاربْ",64,"ب",1,1],["نَاعٍ نَعَى (محمَّدًا) أمَدًا","والقَومُ بينَ الشَّكِ والنَّدَمِ",65,"م",1,0],["ناعساً سالَ تاركاً شفتيْها","لؤلؤاً شعّ في الدّجى ألوانا",66,"ن",2,0]]}