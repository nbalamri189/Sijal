{"poems":[[73,"جعل العتاب إلى الصدود توصلا","https://www.aldiwan.net/poem4030.html","الكامل"],[53,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[53,"شغل المحب عن الرسوم","https://www.aldiwan.net/poem66332.html","مجزوء الكامل"],[68,"إن لم أزر ربعكم سعيا على الحدق","https://www.aldiwan.net/poem41377.html","البسيط"],[68,"كم قد أفضنا من دموع ودما","https://www.aldiwan.net/poem41378.html","الرجز"],[82,"من كان يعذب عندها تعذيبي","https://www.aldiwan.net/poem31542.html","الكامل"],[46,"الحق أبلج والسيوف عوار","https://www.aldiwan.net/poem30507.html","الكامل"],[82,"من كان يعذب عندها تعذبني","https://www.poetsgate.com/ViewPoem.aspx?id=3020",""],[147,"ما ضر طيفك والكرى لو زارا","https://www.aldiwan.net/poem11768.html","الكامل"],[369,"وجد الصبا للعاشقين رسولا","https://www.aldiwan.net/poem60791.html","الكامل"],[443,"أمّا الخليط فبان غير مودع","https://www.aldiwan.net/poem2555.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122696","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122817","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62499","الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120017","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64748","البسيط"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116538","الكامل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202169","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48207","الكامل"],[2249,"","https://poetry.dctabudhabi.ae/diwan/poem/202569","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93674","الخفيف"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140299",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66551","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103049","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90835","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90763","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81713","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81694","الكامل"],[4469,"","https://poetry.dctabudhabi.ae/diwan/poem/103142","الرمل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76682","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76715","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52133","الرمل"],[5136,"شوقي إلى دست الخلافة شيق","https://www.poetsgate.com/ViewPoem.aspx?id=121631",""],[6056,"معدن ذهب","https://www.poetsgate.com/ViewPoem.aspx?id=156704",""]],"verses":[["مَلكٌ غَدا جيدُ الزَمانِ بِجودِهِ","حالٍ وَلَولاهُ لكانَ مُعَطَّلا",0,"ل",2,0],["ملكٌ غدتْ أفعالُهُ","والعرفُ فيها والنكيرُ",1,"ر",1,0],["مَلِكٌ غدا فوقَ البريْ","يةِ والأخشَّةُ في الخطوم",2,"م",1,0],["مَلِكٌ غَدا الجودُ جُزءاً مِن أَنامِلِهِ","فَلَو تَكَلَّفَ تَركَ الجودِ لَم يُطِقِ",3,"ق",1,0],["مَلكٌ غَدا لِسائِرِ الناسِ أَباً","إِن سارَ في كَسبِ الثَناءِ أَو أَبَن",4,"ن",1,0],["ملكٌ غدا للعيد عيداً مُبْهجاً","هُمُعُ العلى حوليه ذات ضروبِ",5,"ب",1,0],["مَلِكٌ غَدا جارَ الخِلافَةِ مِنكُمُ","وَاللَهُ قَد أَوصى بِحِفظِ الجارِ",6,"ر",1,0],["ملكٌ غدا للعيد عيداً مبهجاً","يرعى الفللا بفمٍ وترعى نحضهُ",7,"ه",1,0],["مَلِكٌ غَدَت يُمناهُ يُمناً لِاِمرِئٍ","يَبغي نَوالاً وَاليَسارُ يَسارا",8,"ر",2,0],["مَلِكٌ غدا للهِ سابغَ عَدْله","ظِلاًّ يُمَدُّ على العِبادِ ظَليلا",9,"ل",2,0],["ملك غدا ورد العطايا والندى","منه لعافي الجود أعذب مشرع",10,"ع",1,0],["مَلِكٌ غَدا سِعَةً بِشَفرَةٍِ سَيفِه","ما كانَ مِن سَعَةِ الخَلائِقِ ضِيقا",11,"ق",2,0],["مَلِكٌ غَدا كِسرَى وَتُبَّعُ دُونَهُ","شَرَفاً وَقَيصَرُ وابنُ شاهٍ شاها",12,"ا",3,0],["ملك غوث البرايَا","ذلك الشهم المسوَّدْ",13,"د",1,0],["ملك غدا بالمجد متحدا","وجملة الإحسان منفردا",14,"د",2,0],["مَلْكٌ غدا في صَلاحِ المُلْكِ مُجْتهِداً","لمّا تَقَلَّدَ مِنْهُ ما تقَلَّدَهُ",15,"ه",1,0],["ملك غداء العَدل منه والنَّدى","شكر الرعية والمديح الرابع",16,"ع",1,0],["مَلِك غَرِائبُ مَدْحِه وحَديثِه","نُزَه العْقول ونُجْعَةُ الأسماعِ",17,"ع",1,0],["ملكٌ غدتْ بالوصفِ منه مسقط","تُزري بروْقَتِها على بغدَاذ",18,"ذ",1,0],["ملك غدا تاجا فأحسن خلقه","من صاغه وحباه أحسن مفرق",19,"ق",1,0],["مل كَغُصن الأَراك قَداً وَلينا","وَأَبد كَالشَمس بَهجة وَشروقا",20,"ق",2,0],["ملك غدا الحر في التصابي","وهو رقيق الجمال عبده",21,"د",2,0],["مَلِكٌ غِرارُ السَّيْفِ خَيْرُ دُروعهِ","وَالصَّافِناتُ الجُرْدُ خَيْرُ حُصُونِهِ",22,"ن",2,0],["ملِك غير أنه ملَكيّ","الطبع لم ترضه الثريئا محلا",23,"ل",2,0],["ملك غدا في صورة بشرية","ملك الملاح بسنجق منصوب",24,"ب",1,0],["ملك غدا في صورة بشرية","ملك الملاح بصنجق منصوب",25,"ب",1,0],["مَلِكٌ غدتْ أفعاله محمودةً","ممدوحةً في مغربٍ أو مَشْرق",26,"ق",1,0],["ملكٌ غدا يغني الجميعَ بفضله","وإنِ اجتلتْهُ العينُ شخصاً مُفردا",27,"د",2,0],["مَلِكٌ غَدا بالمشرِفيَّةِ ملكُهُ","في الخافِقَيْنِ مُوطّأ وموطدا",27,"د",2,0],["ملكٌ غرٌّ أيادي","ه على الأسماع تترا",28,"ر",2,0],["ملكٌ غر أياي","ه على الأسماع تترا",28,"ر",2,0],["ملك غدا معنى غريباً في العُلى","وغدت به الايام لفظاً معربا",29,"ب",2,0],["ملك غدا الرزق مبعوثاً على يده","وظل يجرى على أحكامه القدر",30,"ر",1,0],["مَلَك غادر جنات النعيمْ","وأتانارحمةً للبشرِ",31,"ر",1,0],["ملك غدت غلب الملوك","حشم تمد اكفها تسترق",32,"ق",1,0],["ملك غلاه الخفوق بطوله وعرضه","وحرم عيوني مشاهد غيره وشوفه",33,"ف",2,0]]}