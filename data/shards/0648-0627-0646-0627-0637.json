{"poems":[[55,"زمان الهوى ما أنت لي بزمان","https://www.aldiwan.net/poem29719.html","الطويل"],[24,"يقول حياي من عوف ومن جشم","https://www.aldiwan.net/poem21881.html","البسيط"],[54,"وحلو الدلال مليح الغضب","https://www.aldiwan.net/poem27264.html","المتقارب"],[48,"يغدو إلى كسب قيراط أخو عمل","https://www.aldiwan.net/poem22623.html","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43710","الهزج"],[139,"من لي إذا ما استقل الركب أو سارا","https://www.aldiwan.net/poem48842.html","البسيط"],[190,"أقول لمن أراد الحزم يوما","https://www.aldiwan.net/poem43549.html","الوافر"],[280,"لرأيك كانت الأزمان تصغي","https://www.aldiwan.net/poem25481.html","الوافر"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[333,"أأبكى هوى أم فرحة أم أمانيا","https://www.aldiwan.net/poem55003.html","الطويل"],[333,"هدم الليل ما بناه النهار","https://www.aldiwan.net/poem55005.html","الخفيف"],[347,"شارد اللب والفكر","https://www.aldiwan.net/poem55314.html","مجزوء الخفيف"],[409,"أشمس اللقا قد راقني منك مطلع","https://www.aldiwan.net/poem33675.html","الطويل"],[435,"غدوت متيما وصبا فوادي","https://www.aldiwan.net/poem40524.html","الوافر"],[556,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48571","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70748","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62474","الطويل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35403","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109162","الوافر"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128705","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108871","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123105","الرجز"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89538","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109455","الرجز"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93658","السريع"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111259","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137023",""],[2603,"","https://poetry.dctabudhabi.ae/diwan/poem/134213","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65107","المنسرح"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139975","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48347","المتقارب"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86307","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91130","الطويل"],[4728,"راوية","https://www.poetsgate.com/ViewPoem.aspx?id=176881",""],[4852,"والشهود رموش عيني","https://www.poetsgate.com/ViewPoem.aspx?id=214358",""],[4940,"نِصَابُ الحنان","https://www.poetsgate.com/ViewPoem.aspx?id=210450",""],[5055,"قلب طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=102728",""],[5282,"بسمة العين ولثمة الكأس","https://www.poetsgate.com/ViewPoem.aspx?id=214177",""],[5397,"بشرا بوجهك ثغر الدهر مبتسم","https://www.poetsgate.com/ViewPoem.aspx?id=157924",""],[5436,"عراق ما بين الأزل والأبد/إسماعيل الصياح","https://www.poetsgate.com/ViewPoem.aspx?id=128302",""],[5449,"عليل","https://www.poetsgate.com/ViewPoem.aspx?id=189265",""],[5628,"أطياف على الضفاف","https://www.poetsgate.com/ViewPoem.aspx?id=178549",""],[5964,"أجدك ما ينفك طيفك سارياً","https://www.poetsgate.com/ViewPoem.aspx?id=181301",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""]],"verses":[["وَإِن أَطلُبِ الضَخمَ اللَغاديدِ غايَتي","فَرُبَّ جَمادٍ عُدَّ في الحَيَوانِ",0,"ن",1,0],["وَإِن أَطافَ وَلَم يَظفَر بِضّائِنَةٍ","في لَيلَةٍ ساوَرَ الأَقوامَ وَالنَعَما",1,"م",2,0],["وَإِن أَطلَقَت مِن قِلادَتِها","وَطارَ الغُبارُ وَجَدَّ الطَلَب",2,"ب",1,0],["وَإِنَّ أَطيَبَ مِن مِسكٍ وَمِن قُطُرٍ","أَن لا تَطورَ لِدارِ السَوءِ أَقطارا",3,"ر",2,0],["وَإِن أَطفا الأَسى مطفٍ","مِنَ الدَمعِ أَتى موري",4,"ي",1,0],["وإن أطلوا دمي في بينهم هدراً","فلستُ أطلب منهم بعدَ ذا ثارا",5,"ر",2,0],["وإن أطعمته عسلاً وزُبدا","شكاك وقال غصّصني بريقي",6,"ق",2,0],["وَإن أَطْغَاهُمُ الإغْضَاءُ عَنْهُمْ","وَفِي الإغْضَاءِ لِلسُفَهاءِ مُطْغِي",7,"غ",2,0],["وان أَطقت أَلّا","تصحبَ منهم خِلّا",8,"ل",2,0],["وإن أطبق الليل الرهيب جفونه","على ترامت فوق صدري آهيا",9,"ي",2,0],["وأنا طائر الفنون فما ذن","بي حتى أحيا حياة الطريد",10,"د",1,0],["وانا طعمة الطوى","أتلظى على الكسر",11,"ر",1,0],["وإن أطبقت سحب البعاد فإنها","سحابةُ صيف عن قريب تقشع",12,"ع",1,0],["وإن اطلقتها لحقت ببرق","وتثبت حيث شئت بلا عنادِ",13,"د",1,0],["وأناطت الحسناءُ بِي تَبعاتِهِ","فكأَنّما تفويفُهُ تفويفي",14,"ف",2,0],["وإن أطريت رب الطب عيداً","هجوت سراة قومي وازدريت",15,"ت",1,0],["وإن أطعتُمْ نجوتُم سالمين وقد","حوى السلامةَ من للسلم قد جنحا",16,"ح",2,0],["وإن أطلعتكم عن خبايا مودّةٍ","ففي القلب أضعاف وفيكم مُقامُها",17,"م",3,0],["وَإِن أَطلَعَت غَيمَ القَتامِ جُيوشُهُ","وَأَرزَمَ في مَركومِهِ رَعدُ نيرانِ",18,"ن",1,0],["وأن أطأ التراب وأنت فيه","وحقي إن أقبله ثراكا",19,"ك",2,0],["وإن أطنب المداح فيك وأوجزوا","فكل بليغ عن علاك مقصر",20,"ر",1,0],["وأنا طبيب بالقيا","دة ما جمعت الدرهما",21,"م",2,0],["وإن أطيب أوقاتي وأنعمها","ساعات قربك يا من حبه ديني",22,"ن",2,0],["وَإِن أَطاعَت فَفي أَمنٍ وَفي دَعَةٍ","تَجري بِها في جِنانِ العَدلِ أَنهارُ",23,"ر",1,0],["وإن أطاعت مرأةٌ هواها","توقعها عقباه في شقاها",24,"ه",2,0],["وَإِن أطأطي لَكَ عُنق الأَبا","سللت مِن قَطعك لي مرهفا",25,"ف",2,0],["وان أطالوا بتذكير العصاة فلم","يصغو لمن طول الذكرى وقصرها",26,"ر",3,0],["وان اطل بك من مدحي فلا عجب","فانت ارفع ابناء الورى شانا",27,"ن",2,0],["وان أطر أهل العلم قوم بمحفل","عليه من القوم الخناصر تعقد",28,"د",1,0],["وأنّ أطماعهم وإن عظمت","ليس لهم في بُرُوقها مطرُ",29,"ر",1,0],["وإن أطلعتْ شفقاً خلته","على وجنتيها احمرار الخجلْ",30,"ل",1,0],["وأنْ أطْلَعَتْ وجْهَها مُشْرِقاً","طُلوعَ الصّباحِ من المَشْرِقَيْنِ",31,"ن",1,0],["وَاِن اطلَقت لِلوم فيكَ اعِنَّةٌ","فَها اِنتِ نَفسٌ بِالعلى مُطمَئِنَّةٌ",32,"ه",1,0],["وَإِنّ أَطبانا لتخشى صدورَنا","وَلكننا نلقى المُجَرَّحَ بالبشر",33,"ر",1,0],["وأنا طويت القلوب اللي بلا مستوى","يوم الهوى دور شاعر تتبعه غاوية",34,"و",3,0],["وأنْ أطويكَ قلبًا بالحنايا","فمِنكَ النبضُ ..والأنفاسُ مني؟!",35,"ن",2,0],["وإن أطلقته بالحب يعدو","لينثر في الورى شهدا مذابا",36,"ب",2,0],["وأنا طلبت الحق ميزان عدله","دام أمطرت بالخير روس الهمالي",37,"ل",2,0],["وإنْ أطَلتْ عَلى أرْضٍ بِها شَجَرٌ","تراقَصَ الغُصْنُ والأعْطَافُ من سَكَرِ",38,"ر",1,0],["وإن أطلت على الآفاق معضلة","سبقا به نهضت في دفعها الهمم",39,"م",1,0],["وإنْ أطالَ عَليكَ الصُبحُ طَلّتَهُ","إخالهُ  يا سَنا أنوارِهِ- خَجِلا",40,"ل",2,0],["وأنا طبيبٌ في الهوى","أمسيتُ في الحبِّ العليلْ",41,"ل",1,0],["وأنا طباعي لا يشابهها","طبعُ النساءِ لأظهرَ الخجَلا",42,"ل",2,0],["وإن أطو ما تطوي الجوانح من هوى","عن الناس تخبرهم بحالي حاليا",43,"ي",2,0],["وأنا طبيبُ العاشقينَ خَبَرتُهمْ","فعرفتُ أن الداءَ أنْ يتطَبَّبوا",44,"ب",3,0]]}