{"poems":[[3,"لا تقتضي الدين إلا بالقنا الذبل","https://www.aldiwan.net/poem191.html",""],[85,"هذي العوالم لفظ أنت معناه","https://www.aldiwan.net/poem54231.html","البسيط"],[53,"ناشدتك الله أن تستفسد المننا","https://www.aldiwan.net/poem66517.html","البسيط"],[87,"أنا المدرسة اجعلني","https://www.aldiwan.net/poem7928.html","الهزج"],[45,"هو البين حتى ما تأنى الحزائق","https://www.aldiwan.net/poem9738.html","الطويل"],[60,"حسين إذا كنت في بلدة","https://www.aldiwan.net/poem31146.html","المتقارب"],[46,"أألله إني خالد بعد خالد","https://www.aldiwan.net/poem30315.html","الطويل"],[89,"خلعت في حب غزلان الحمى رسني","https://www.aldiwan.net/poem8236.html","البسيط"],[54,"عليك بحسن الصبر في كل مورد","https://www.aldiwan.net/poem26967.html","الطويل"],[52,"وضعت قناعي وارتببت نجادي","https://www.aldiwan.net/poem63903.html","الطويل"],[48,"غدوت مريض العقل والدين فالقني","https://www.aldiwan.net/poem22294.html","الطويل"],[48,"إذا شئت أن ترقى جدارك مرة","https://www.aldiwan.net/poem23120.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85600","البسيط"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20999","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55172","الرجز"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141960","البسيط"],[52,"وَضَعْتُ قِنَاعِي وارْتَبَبْتُ نِجَادِي","https://www.poetsgate.com/ViewPoem.aspx?id=21806",""],[53,"ناشدتُك الله أن تستفسِدَ المننا","https://www.poetsgate.com/ViewPoem.aspx?id=30770",""],[124,"دعوت بنات الليل في أخرياته","https://www.aldiwan.net/poem49310.html","الطويل"],[128,"يا جيرة البان ليت البان ما كانا","https://www.aldiwan.net/poem23706.html","البسيط"],[132,"وسلم إلى رب العلا وتوكلن","https://www.aldiwan.net/poem50672.html","الطويل"],[168,"لن تستطيع لأمر الله تعقيبا","https://www.aldiwan.net/poem67835.html","البسيط"],[173,"حطوا الرحال فقد أودى بها الرحل","https://www.aldiwan.net/poem1661.html",""],[203,"قاسوك يا شمس الضحى","https://www.aldiwan.net/poem45340.html","مجزوء الكامل"],[234,"وساقية ترتمي بالحباب","https://www.aldiwan.net/poem51085.html","المتقارب"],[246,"مباسم الثغر ما أحلى حمياك","https://www.aldiwan.net/poem45769.html","البسيط"],[280,"نادى المشيب إلى الحسنى به ودعا","https://www.aldiwan.net/poem25484.html","البسيط"],[308,"هذي الذنوب اغتفرها","https://www.aldiwan.net/poem58106.html","المجتث"],[308,"إذا الدهر أعطاك المنى من ولاية","https://www.aldiwan.net/poem58307.html","الطويل"],[382,"ألا إحذر ملاقاة الرزايا","https://www.aldiwan.net/poem59170.html","الوافر"],[396,"الحمد لله مسعف كل سائل بسول","https://www.aldiwan.net/poem54537.html","عموديه"],[396,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[463,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[487,"ثوى الحب واستعلى وما قد رثى ليا","https://www.aldiwan.net/poem24500.html","عموديه"],[505,"الله يا هلا لهم","https://www.aldiwan.net/poem37702.html","مجزوء الرجز"],[519,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[556,"إذا ما حذرت الأمر فاجعل إزاءه","https://www.aldiwan.net/poem47797.html","الطويل"],[569,"سقاك الله كاسات الغرام","https://www.aldiwan.net/poem886.html",""],[591,"تداركه قبل البين فاليوم عهده","https://www.aldiwan.net/poem17487.html","الطويل"],[592,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[654,"","https://poetry.dctabudhabi.ae/diwan/poem/203925","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86768","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48509","البسيط"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119326","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1077,"","https://poetry.dctabudhabi.ae/diwan/poem/147566","الهزج"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64926","الهزج"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64777","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112935","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112888","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112876","الوافر"],[1311,"","https://poetry.dctabudhabi.ae/diwan/poem/145440","الوافر"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113977","الخفيف"],[1974,"","https://poetry.dctabudhabi.ae/diwan/poem/199437","الوافر"],[2037,"","https://poetry.dctabudhabi.ae/diwan/poem/34881","الطويل"],[2209,"","https://poetry.dctabudhabi.ae/diwan/poem/144538","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27394","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27393","البسيط"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124764","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124770","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106872","المتقارب"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130859",""],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84475","الطويل"],[3102,"","https://poetry.dctabudhabi.ae/diwan/poem/113898","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100716","الطويل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87579","البسيط"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123881","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91131","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135328","الطويل"],[4715,"وصية أمي","https://www.poetsgate.com/ViewPoem.aspx?id=204453",""],[4726,"ألا بالصبر تبلغ ما تريدُ","https://www.poetsgate.com/ViewPoem.aspx?id=146641",""],[4750,"خارطة الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=180399",""],[4929,"ارهاصات النهاية","https://www.poetsgate.com/ViewPoem.aspx?id=199351",""],[4984,"سَابِقْ حَظَّكَ","https://www.poetsgate.com/ViewPoem.aspx?id=201286",""],[5038,"على شفتيه","https://www.poetsgate.com/ViewPoem.aspx?id=190093",""],[5183,"ضالة المؤمن","https://www.poetsgate.com/ViewPoem.aspx?id=180165",""],[5200,"هبت تعاتبنى عرسى فقلت لها","https://www.poetsgate.com/ViewPoem.aspx?id=200805",""],[5409,"أهزةٌ أيقظت من روعها البلدا","https://www.poetsgate.com/ViewPoem.aspx?id=155458",""],[5493,"عساكَ تحدّث الأحلام سرًّا","https://www.poetsgate.com/ViewPoem.aspx?id=196977",""],[5550,"أرى القلبَ","https://www.poetsgate.com/ViewPoem.aspx?id=210923",""],[5561,"رحيلُ الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=192742",""],[5721,"أعظم من أسلافي الأول","https://www.poetsgate.com/ViewPoem.aspx?id=215232",""],[5790,"وما أومض البرق من تلقاء أرضكم","https://www.poetsgate.com/ViewPoem.aspx?id=112101",""],[6046,"لا ياس مع الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=35245",""],[6148,"نصائح غالية","https://www.poetsgate.com/ViewPoem.aspx?id=203066",""],[6152,"أعد فؤادي فنبضي لم يعد فيه","https://www.poetsgate.com/ViewPoem.aspx?id=215762",""]],"verses":[["وَلا تَفِرَّ إِذا ما خُضتُ مَعرَكَةً","فَما يَزيدُ فِرارُ المَرءِ في الأَجَلِ",0,"ل",1,0],["ولا تَفَجَّرَ نهرٌ للنهار على","در الدراري فغطّاه وأخفاهُ",1,"ا",2,0],["ولا تَفُتك العلى يا ابن الأُلى شَرعوا","فيها الشرائع واستنُّوا لها السُّننا",2,"ن",2,0],["وَلا تَفزَع كَمَأخوذٍ","مِنَ البَيتِ إِلى السِجنِ",3,"ن",1,0],["وَلا تَفتُقُ الأَيّامُ ما أَنتَ راتِقُ","وَلا تَرتُقُ الأَيّامُ ما أَنتَ فاتِقُ",4,"ق",1,0],["وَلا تَفخَرنَ بَينَهُنَ بِالنُّهى","فَكُلُّ قَبيلٍ بِأَلبابِها",5,"ب",3,0],["وَلا تَفتَرِق أَعناقُكُم إِنَّ حَولَها","رُدَينِيَّةً يَجمَعنَ هامَ الشَوارِدِ",6,"د",1,0],["وَلا تَفُهْ بِحَدِيثِ النَّفْسِ إِنَّ بِهِ","شَرَّ الْحَيَاةِ وَسَعْيَ الْحَاسِدِ الأَفِنِ",7,"ن",1,0],["وَلا تَفزَعَن مِن كُلِّ شَيءٍ مُفَزِّعٍ","فَما كُلُّ تَربيعِ النُجومِ بِضائِرِ",8,"ر",1,0],["وَلا تَفخَروا بِالشِعرِ لَستُم مِنَ اَهلِهِ","وَلكِنَّكُم أَهلٌ لِنَقلِ سِمادِ",9,"د",1,0],["وَلا تَفجَعَنَّ الطَيرَ وَهيَ غَوافِلٌ","بِما وَضَعَت فَالظُلمُ شَرُّ القَبائِحِ",10,"ح",1,0],["وَلا تَفجَأَنهُ بِالطُلوعِ فَرُبَّما","أَصابَ الفَتى مِن هَتكِ جارَتِهِ خَبَلُ",11,"ل",1,0],["ولا تفرق يخشى بعد وحدتهم","حتى تفرق أَرواح وأَبدان",12,"ن",1,0],["ولا تَفشِيَن سرّاً إلى غَيرِ حِرزه","ولا تُكثِرِ الشَّكَوى إلى غَيرِ عابِدِ",13,"د",1,1],["وَلاَ تَفُتْنِي هَهُنَا","تَهْنِئَةٌ فِي عَجَلِ",14,"ل",1,0],["ولا تفتقت الأفكار عن أدب","إلا وأنبت روضاً من بواكره",15,"ر",2,0],["ولا تفخروا بالشعر لستم من أهلها","ولكنكم أهل لنقل سماد",16,"د",1,0],["ولا تُفتك العلى يا بن الأُلى شَرعوا","فيها الشرائع واستنُّوا لها السُّننا",17,"ن",2,0],["ولا تفتأوا تثنون بالمين والهوى","على رحمة الأقدار وهي كذاب",18,"ب",1,0],["ولا تفيأ في عجلون وارفة","ولا حدا بهضاب السلط قطعانا",19,"ن",2,0],["ولا تفعلَنْ فِعلاً بغير مَشورةٍ","من السيد المولى كريم المناسبِ",20,"ب",1,0],["وَلا تَفَرُّقُ أُلّافٍ يَفوتُ بِهِم","بَينٌ يُغادِرُ حَبلَ الوَصلِ مَقضوبا",21,"ب",2,0],["وَلا تُفَنِّد كَريماً عَن سَجِيَّتِهِ","حُسنُ السَجِيّاتِ مِن رَبِّ العُلى نِحَلُ",22,"ل",1,0],["ولا تفزعي من حفيفِ الثياب","يناديني إذ مللنَ انتظارا",23,"ر",2,0],["ولا تفعلوا فعل آبائكم","فتَخْطُونَ خطوي بتطهيرها",24,"ر",3,0],["ولا تفرستِ إلا كنتِ صائبةً","خبيئةَ الغيبِ في تَصريفِ آراكِ",25,"ك",1,0],["وَلا تُفَارِق صَدىً فيها ومَخْمَصَةً","تَنَلْ بِدارِ الخُلودِ الرِّيَّ والشّبَعا",26,"ع",2,0],["ولا تفتس عليها","فهي الخبايا الخبائث",27,"ث",1,0],["ولا تفتحن باب الهدايا وعدها","مطار فراشٍ لا مطارفَ راشِ",28,"ش",1,0],["ولا تفرح بخيرٍ قد جنته","عليك بخبثها أيدي الجنايا",29,"ا",3,0],["ولا تفتش على من جابصوره حول","وادخله يا رب ياستار بين العدول",30,"ل",1,0],["ولا تفرح بآت","ولا تحزن لما فات",31,"ت",1,0],["ولا تفرّط جلوساً في انتظار غدٍ","فخير عزميك أمرٌ لم يكن فُرُطا",32,"ط",2,0],["ولا تفترن عن ذكر ربك والصلا","على مركز الأنوار عين حياتنا",33,"ن",2,0],["ولا تفه إذا جلوا","وأبرزوا حلالهم",34,"م",1,0],["ولا تفرّقَ قلبي بالرّسومِ كما","تفرّقتْ من عَليٍّ في الوَرى الخَوَلُ",35,"ل",1,0],["وَلا تَفخَرنْ إلّا بِثوبِ صيانةٍ","إذا كنت يوماً بالفضيلة فاخرا",36,"ر",2,0],["ولا تفتك في وهمٍ وهم","وتقريع العواذل بالملام",37,"م",1,0],["وَلَا تَفْتَحُوا لِلعَتْبِ بَاباً فَرُبَّما","يَعِزُّ عَلَيْكُمْ بَعْدَ ذَلِكَ سَدُّهُ",38,"د",2,0],["ولا تفنتن في كل وترك يا فتى","فتجعله كالواجب المتأكد",39,"د",1,0],["ولا تفرح بشيء قد تناهى","فما بعد الطلوع سوى النزول",40,"ل",1,0],["وَلا تَفجعي في مُهجَتي كُل عاشق","يقلدني في صَبوَتي وَهُجودي",41,"د",2,0],["ولا تفيأت ظلاً غير ظلهمُ","ولا ارتويت بكأس غير كأسهم",42,"م",1,0],["ولا تفضح المرضى وقد بت خازنا","لأسرارها والطب بالفضح ما ارتقى",43,"ق",2,0],["ولا تفش سر الصديق فربما","جفا ففشا السر الذي أنت تكتم",44,"م",1,0],["ولا تفكر يا مغرور ف","ي صرف الردى الداهي",45,"ه",2,0],["ولا تَفْرَحْ ولا تَحْزَنْ","مِنَ الشَّهْدَةِ والنَّحْلَهْ",46,"ل",2,0],["ولا تُفشيَنْ سِرَّ الغرام فإِنَّني","أَمينٌ عليهِ يومَ تُبلى السَّرائِرُ",47,"ر",1,0],["ولا تفضحن يا رب واحفظ من الشقا","وسلم بمحض الفضل من مسالك القالي",48,"ل",2,0],["ولا تفضحن ولا تردد السؤل سيدي","فحلمك كم غطى وسترك من جنا",49,"ن",2,0],["ولا تفضح وهب سيرا جميلا","وخص ذا العبد بالقلب السليم",50,"م",1,0],["ولا تفرغ إذا ما اعتاص أمر","لعل الله يحدث بعد ذلك",51,"ك",1,0],["ولا تفتح الأبواب إلا عناية","لمن شاءه ذاك المليك تكرما",52,"م",2,0],["ولا تفرَحَنَّ إن كنتَ يوماً","في سرورِ ونِعمَةٍ واحتِفالِ",53,"ل",1,0],["ولا تفاحة طلعت بخدّ","ولا رمانة نبتت بصدرِ",54,"ر",1,0],["وَلا تُفلِتَن عُمّالَنا مِن عُقوبَةٍ","وَإِغرامِهِم ما أَغرَموا وَتَصَرَّفوا",55,"ف",3,0],["ولا تَفْخرْ بقومٍ أنتَ منُهمُ","مكانَ المَنسِمينِ منَ السَّنامِ",56,"م",1,0],["ولا تفكرتُ فيه ما بقيتُ ولا","يزال من فكرِه عقلي على غررِ",57,"ر",1,0],["ولاتفرِّق فإن الفرقَ مجهلةٌ","فلا يفرِّق إلا الحقُ والصور",58,"ر",1,0],["ولا تفش سرا يؤثر الميت كتمه","سوى ذي فجور وابتداع معود",59,"د",1,0],["ولا تفعلنّ النذر ما النذر سنّة","لفقدانه من كل هاد ومرشد",60,"د",1,1],["ولا تفكري بي من بعد ذاك","وطيبي بغيري وارضي بهجري",61,"ر",2,0],["ولا تفرح فان النصر أضحى","خداعاً والزمان قريب غدر",62,"ر",1,0],["وَلا تَفتَري عَن ذا ولَو جُبت جوّها","فَلَن يسأم الإنسان وَالطرف زهوها",63,"ه",2,0],["ولا تفزعي مما يذاع على الورى","عن الصلح ان الصلح أمر من الغيب",64,"ب",1,0],["ولا تفعموا دلو العداء فربما","تخون حبال الدلو لآو تتقضّب",65,"ب",1,0],["ولا تفد لغريب العلم منكره","وخذ يقول على صاحب العلم",66,"م",1,0],["ولا تفاقٌ ولا كذِقٌ ولا كَلِمٌ","بذيئةٌ شأنُها تخديش آذانِ",67,"ن",1,0],["ولا تفكر في فراغ الزيت",