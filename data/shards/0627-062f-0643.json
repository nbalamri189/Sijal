{"poems":[[230,"أدك أمير الأغصان","https://www.aldiwan.net/poem55083.html","عموديه"],[534,"أدكرى حبيب أبرزت دمية القصر","https://www.aldiwan.net/poem37419.html","الطويل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56579","الخفيف"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82835","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111420","البسيط"],[4432,"ادكارا بعد ما ولى الشباب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=564221",""]],"verses":[["أدَّك أمير الأَغصان","من غير مكابر",0,"ر",1,1],["أدِكْرَى حَبيبٍ أَبْرَزَتْ دُمْيَةُ القَصْر","فَجَلَّتْ وجَلّت بل جَلَتْ رَبَّةَ الخِدْرِ",1,"ر",1,1],["أدكرني وليس مثلك ينسى","حين تتلو هناك هذا الكتابا",2,"ب",2,0],["أَدكتورُ قد طَوَّفتَ جيدِيَ مِنَّةً","وَلَيسَ لَها فيما أَراهُ نَظيرُ",3,"ر",1,0],["اَدُكُّ شائِقَ قَصرٍ شادَهُ وأَرى ال","لَّهيبَ يَلتَهِمُ الأَبوَابَ مُحتَملا",4,"ل",2,0],["ادِّكاراً بَعدَ ما وَلّى الشَباب","وَمِنَ الذِكرى نَعيمٌ وَعَذاب",5,"ب",1,1]]}