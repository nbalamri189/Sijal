{"poems":[[65,"سرت وجنح الليل غربيب","https://www.aldiwan.net/poem46147.html","السريع"],[88,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[73,"نبتان هذا أصله سامق","https://www.aldiwan.net/poem3896.html","السريع"],[87,"آل زغلول حسبكم من عزاء","https://www.aldiwan.net/poem62833.html","الخفيف"],[87,"ظلم الرجال نساءهم وتعسفوا","https://www.aldiwan.net/poem63768.html","الكامل"],[107,"أعد الرجاء وجدد الأملا","https://www.aldiwan.net/poem42045.html","أحذ الكامل"],[107,"أمنارة الساري وأمن الوادي","https://www.aldiwan.net/poem42087.html","الكامل"],[107,"غضب الحماة لدين أحمد غضبة","https://www.aldiwan.net/poem43421.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54948","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55178","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[119,"اصاحب لو سمعت كلام حبي","https://www.aldiwan.net/poem40897.html","عموديه"],[121,"مسقط","https://www.aldiwan.net/poem24041.html","الخفيف"],[124,"عباس إن ابني لي مفزع","https://www.aldiwan.net/poem49262.html","السريع"],[226,"أيهما كان الظلوم البليد","https://www.aldiwan.net/poem55291.html","المتقارب"],[412,"أرحت نفسي من عداة الملاح","https://www.aldiwan.net/poem50195.html","السريع"],[443,"ظبي الصريم حبالي في الهوى صرما","https://www.aldiwan.net/poem2586.html","البسيط"],[463,"أتعلمين يا ابنة الأعاجم","https://www.aldiwan.net/poem55879.html","الرجز"],[520,"المدح يدري أنكم أكبر","https://www.aldiwan.net/poem12115.html","السريع"],[565,"يا خفي اللطف","https://www.aldiwan.net/poem67258.html","عموديه"],[568,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[653,"","https://poetry.dctabudhabi.ae/diwan/poem/76593","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122665","الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39016","الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39223","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48743","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48675","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59571","المديد"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82253","السريع"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138092",""],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102249","البسيط"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105421","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66294","الكامل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202148","الرمل"],[2170,"","https://poetry.dctabudhabi.ae/diwan/poem/198618","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53200","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77438","الخفيف"],[2309,"","https://poetry.dctabudhabi.ae/diwan/poem/140201",""],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61256","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91954","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91963","الرمل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132144","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88571","الخفيف"],[3994,"","https://poetry.dctabudhabi.ae/diwan/poem/198288","الرمل"],[4717,"وصيتي لبلادي","https://www.poetsgate.com/ViewPoem.aspx?id=199833",""],[4728,"عابر سبيل","https://www.poetsgate.com/ViewPoem.aspx?id=176954",""],[4755,"جَوَّابُ العُصُور","https://www.poetsgate.com/ViewPoem.aspx?id=185155",""],[4980,"آيةٌ مِن خمر حُبٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=200501",""],[585,"أيها القصر أنت والبيت يشهد","https://www.poetsgate.com/ViewPoem.aspx?id=161899",""],[5183,"وقِّر العلم","https://www.poetsgate.com/ViewPoem.aspx?id=186456",""],[5183,"عسعس الليل","https://www.poetsgate.com/ViewPoem.aspx?id=186373",""],[5386,"يحمدون الموت","https://www.poetsgate.com/ViewPoem.aspx?id=35634",""],[5388,"إيه مكة","https://www.poetsgate.com/ViewPoem.aspx?id=206912",""],[5431,"إيهِ مصر فداك مالي وشعري","https://www.poetsgate.com/ViewPoem.aspx?id=211907",""],[5616,"صرخة","https://www.poetsgate.com/ViewPoem.aspx?id=204843",""],[5616,"أحوال","https://www.poetsgate.com/ViewPoem.aspx?id=205244",""],[5843,"أعطني حريتي اطلق يديه","https://www.poetsgate.com/ViewPoem.aspx?id=51302",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"]],"verses":[["أيَّ هُمامٍ منكَ قَد رَشَّحَتْ","للمَجْدِ آباءٌ مَناجيبُ",0,"ب",1,0],["إيهِ مِسّينَ آنِسي اليَومَ بُمبِي","يَ فَقَد أَوحَشَت بِذاكَ المَكانِ",1,"ن",1,0],["أَيُّهُما صَحَّفتَ مَعكوسَهُ","دَلَّ بِلا شَكٍّ عَلى الآخَرِ",2,"ر",1,0],["أَيُّهُم مَن أَتى بِرَأسِ كُلَيبٍ","أَو شَفى القُطرَ مِن عَياءِ اِحتِلالِه",3,"ل",2,0],["أَيَهُمُّكُم عَبَثٌ وَلَيسَ يَهُمُّكُم","بُنيانُ أَخلاقٍ بِغَيرِ جِدارِ",4,"ر",1,0],["إيهٍ مُحبَّ الدّينِ مِن رَجُلٍ","مَا جَازَه مَن يَنْشُدُ الرَّجُلا",5,"ل",2,0],["إيهٍ مُحبَّ الدّينِ زِدْهُ محَبّةً","في المؤمنين وَزِدْهُ صَفْوَ وِدادِ",6,"د",1,0],["أَيَهِمُّ هانوتو بِقَبرِ مُحمَّدٍ","وَيَسوعُ حَولَيهِ يَطوف وَيَعكِفُ",7,"ف",1,0],["إِيهِ مُلِييرُ أَيُّ قَارِيءِ سِفْرٍ","لَمْ يُقَوِّمْ تَأْوِيدَهُ مِنْكَ سِفْرُ",8,"ر",1,0],["أَيُّهُمَا مُفْلِحٌ","مَنْ قَالَ أَمْ مَنْ فَعَلْ",9,"ل",1,0],["آيَةٌ مُبَيَّنَةٌ","عِندَ ذي تَبَصُّرِها",10,"ر",3,0],["آيَةٌ مِنْ نَفْحَةِ اللّهِ فَلَوْ","كانَ للنِّسْيَانِ كف ما مَحَاها",11,"ا",3,0],["ايهمل شأن اهل الود الا","فتى عن سنة الاحباب زاغا",12,"غ",2,0],["آيةٌ مِنْ بَديعِ سِحْرِ البَيانِ","أُحْكِمَتْ ثمَّ فُصِّلَتْ في عُمَانِ",13,"ن",1,1],["أيهما باللَه يا صاحبي","أجمل إذ يخطو إلى عثره",14,"ر",2,0],["أيهما كان الظلوم البليد","هل والد أم أمُّ الوليد",15,"د",1,1],["أَيُهُما أَحلى تَرى مَنظَراً","فَقالَ لا أَعلَم كُلُّ أَقاح",16,"ح",1,0],["إيه مليك الورى مرىءً ومختبراً","لم يطمعا في العلى عربا ولا عجما",17,"م",2,0],["أيُّهمُ أبكَى دَما فكلُّهم","يجِلُّ عن دموعيَ السواجمِ",18,"م",1,0],["أيهما أجريت ذكراً له","فغرة الثاني به تسفر",19,"ر",1,0],["إيهِ ما للقلبِ في ْ تِيْهِ الهوى","كلما ناداهُ داعٍ لا يطيعْ",20,"ع",1,0],["أَيُّهُما عِندَكُمُ يَصحَبُهُ عَمَل","لا زالَ بَحرُكُمُ يُلقي لَنا دُرَرا",21,"ر",2,0],["إِيهٍ مُحَمَّدُ إِنَّني لَكَ حامِدٌ","وَشَهيدُ نَفسِي أَنَّني لَكَ أَخضَعُ",22,"ع",1,0],["إيهٍ مَحَمَّدُ إنَّما مُكِّنتَ مِن","عِقدِ الرِّئاسَةِ كَي تَضُرَّ وتَنفَعا",23,"ع",2,0],["إيهٍ مُطَرِّبةَ الخليِّ بَعَثْتِ لي","أسفَ الشَّجِيْ رُدّي عَليَّ وبَدِّلي",24,"ل",2,0],["إيْهٍ مُهَيِّجةَ الجوى لِجَوانحي","شَوْقاً لمنْ بِحُلى عُلاهُ تَمَيَّزا",25,"ز",2,0],["أيهم بالأسرى يفك قيودهم","بطل وفيهم من يهم بقتله",26,"ل",2,0],["أيهم بالأمر الكبير وليُّه","يوماً وليس له عليه يدان",27,"ن",1,0],["آية محكمة","لم تكن لتنسخا",28,"خ",2,0],["آيَةُ ما جِئتُ عَلى رقبَةٍ","بَعدَ الكرى وَالحَيُّ قَد نَوَّموا",29,"م",3,0],["أيُّ هم به وأيُّ عناء","فوق هذى الجزيرة الجدباء",30,"ا",2,1],["أيَّهما أثقلُ على المحبِّ","ألرقيبُ أم العاذلُ",31,"ل",1,0],["أيهٍ مصارع كربلا كم غصة","جرعت آل محمد كرباتها",32,"ت",3,0],["إيهِ مؤمل لفظه","بُلَّغت غايات المناءِ",33,"ا",2,0],["أيهم أصدق قولا وحجى","هم وعيسى أم ترومان الخئون",34,"ن",1,0],["إيه محمد إنني لك حامد","وشهيد نفسي أنني لك أخشع",35,"ع",1,0],["أيْهُم أقر المصطفى في يثرب","وأبوك فرج كُرب مكة أم همُ",36,"م",1,0],["آيَةٌ مِنهُ تُعجِزُ الإِنسَ وَالجن","نَ وَلَو أَنَّ كُلَّهُم فُصَحاءُ",37,"ا",2,0],["إيه ما أبين الحقائق للنا","س وهم كلهم يرون السدادا",38,"د",2,0],["إِيهٍ مَديحي لا خُطاكَ قَصيرَةٌ","يَومَ الرهان وَلا مَجالُك ضَيِّقُ",39,"ق",1,0],["أَيهملك الدَيانُ كَهلاً وَيافعاً","وَفي ظلمة الأَحشاء ما كان أَهملك",40,"ك",1,0],["أَي همٍّ أَتقيه","لَيسَ لي حول أَحول",41,"ل",1,0],["إيه من ألطف الربيع وأبهى","زهره وهو مشرف من خبائه",42,"ا",3,0],["آيَةٌ مِنكَ مَا تَدَاعَى البِنَاءُ","عَلَمُ اليُمنِ سَعدُ مَن يَرتضِيهِ",43,"ه",1,0],["أيّةً ما يكن فقد يرجعُ الغا","ئبُ يوماً ويوقَظ الوسنان",44,"ن",1,0],["أيهم دلاك عمرو للردى","وقديماً حين المرء الأجل",45,"ل",1,0],["أيُهملُ مثْمِرٌ ويُصانُ جدْبٌ","وهَلْ مثلُ الرعايةِ في الصحاحِ ؟",46,"ح",1,0],["ايه ما لي مع شيوخ الرضا رايٍ سديد","خلها تبكي تماضر على اخوها صخر",47,"ر",1,0],["ايه من لا غاب لاسمه خبر مجدٍ تليد","وان حضر يكفي ولو كلّ مخلوقٍ حضر",47,"ر",1,0],["أَيُّهُم خَطَّ لِلحَصَى مهرَجانًا","مِن طُيُوفٍ, وقالَ لِلمَوتِ عُذرا؟!",48,"ر",2,0],["آيةٌ من خمرِ حُبٍّ","صُبَّ في كأسِ الكمالْ",49,"ل",1,0],["إيه مولاي قد نهضتم فكنتم","خير من أنشأ العروش ووطد",50,"د",1,0],["أية من ذي الجلال أختارها","للهداة المهتدين النجبا",51,"ب",2,0],["إيه موسى ومن كموسى إذا ما","سل سيفا به اليراع خطيب",52,"ب",1,0],["إيه مني المال ومني الحال و\"انت اللي تحبني\"","وانت يا موتي ( وموتٍ حي ) أول من طعن",53,"ن",1,0],["إيه\" مكه\" كيف أغفو ..","وطلولُ \" الروح \" هلكى !",54,"ك",2,0],["إيهِ مصرَ سلمت من كل عيبٍ","منك شوقي وحجة الأسوان",55,"ن",1,0],["إيهِ مصر فداك مالي وشعري","أنت شمسي وأنت نور الزمان",55,"ن",1,0],["أيُّهم صادقٌ وأيٌّ عَقوقُ؟","فلماذا تُلغي الطريقَ الطريقُ؟",56,"ق",1,1],["أيُّ همْسٍ على الطريقِ وشجْوٍ","وشفاهٍ نديَّةٍ.. وابتهالُ",57,"ل",1,0],["أيه ماغرورقت دمع ولاغفالي","جفن من بعدك وانا مجحد بكايه",58,"ا",3,0],["أيه مقفٍ عنك وأنته لاتبالي","فيّ لو أتشوفني الفت ورايه",58,"ا",3,0],["آية منك ما تَداعى البناء","دَحض الحَق باطِل التَمويه",59,"ه",1,0]]}