{"poems":[[65,"من رام عزا بغير السيف لم ينل","https://www.aldiwan.net/poem46207.html","البسيط"],[95,"عذيري من ضنى القلب الحزين","https://www.aldiwan.net/poem11221.html","الوافر"],[32,"خليلي عوجا عوجة","https://www.aldiwan.net/poem29570.html","الطويل"],[29,"كأني بالمديبر بين زكا","https://www.aldiwan.net/poem5752.html","الوافر"],[4,"رأتني قد شحبت وسل جسمي","https://www.aldiwan.net/poem21198.html","الوافر"],[66,"أشار لحظي بعين علم","https://www.aldiwan.net/poem67612.html","مخلع البسيط"],[87,"جهد الصبابة ما أكابد فيك","https://www.aldiwan.net/poem63701.html","الكامل"],[64,"قيامتنا جمع أرواحنا","https://www.aldiwan.net/poem52160.html","المتقارب"],[30,"لعمرك ما تجزي مفداة شقتي","https://www.aldiwan.net/poem5651.html","الطويل"],[77,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9948","الوافر"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54235","الوافر"],[118,"لشماء بعد شتات النوى","https://www.aldiwan.net/poem20958.html","المتقارب"],[315,"كم موقف متسربل","https://www.aldiwan.net/poem59666.html","مجزوء الكامل"],[358,"هناء وإسعاد وعز مؤبد","https://www.aldiwan.net/poem40402.html","الطويل"],[409,"أشير وإن كنت لا تقبلا","https://www.aldiwan.net/poem34176.html","المتقارب"],[422,"سرينا لنمحو الإثم أو نغنم الأجرا","https://www.aldiwan.net/poem54107.html","الطويل"],[457,"لا بد للنفس أحيانا إذا سئمت","https://www.aldiwan.net/poem13696.html","البسيط"],[463,"صحا القلب لكن صبوة وحنين","https://www.aldiwan.net/poem55824.html","الطويل"],[466,"رعى الله نجرا زينبيا تألقت","https://www.aldiwan.net/poem15164.html","الطويل"],[534,"مسامع من ناديت يا عمرو سدت","https://www.aldiwan.net/poem37501.html","الطويل"],[543,"أى سهم راشه الدهر إلى","https://www.aldiwan.net/poem47499.html","عموديه"],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102039","الطويل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44610","الطويل"],[1345,"","https://poetry.dctabudhabi.ae/diwan/poem/145371","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52032","الوافر"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109303","الطويل"],[2537,"","https://poetry.dctabudhabi.ae/diwan/poem/132209","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87336","الطويل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93419","الطويل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93436","الطويل"],[3142,"","https://poetry.dctabudhabi.ae/diwan/poem/74137","الطويل"],[3181,"","https://poetry.dctabudhabi.ae/diwan/poem/105088","الوافر"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123932","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59457","البسيط"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107042","المتقارب"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135092","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81724","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136747",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72349","الطويل"],[4927,"قصيدة الثورة على الشبيحة","https://www.poetsgate.com/ViewPoem.aspx?id=79601",""],[5183,"مُلْغِزَهَ رق209م","https://www.poetsgate.com/ViewPoem.aspx?id=186396",""],[5302,"ما أعذب العشق","https://www.poetsgate.com/ViewPoem.aspx?id=200599",""],[5333,"أمرت فلم أسمع دعوتُ فلم تجب","https://www.poetsgate.com/ViewPoem.aspx?id=8965",""],[5444,"بلد الألف ربوة","https://www.poetsgate.com/ViewPoem.aspx?id=205450",""],[5490,"خضر عروش الروح","https://www.poetsgate.com/ViewPoem.aspx?id=176332",""],[5001,"جاءت تسيّر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83394&r=&rc=0",""]],"verses":[["فَخُضْ غِمارَ الرّدى تَسْلَمْ وثِبْ عَجِلاً","لِفُرْصَةٍ عَرَضَتْ فالحَزْمُ في العَجَلِ",0,"ل",1,0],["فَخَضَّكَ فِي مَكَانِكَ خَضَّ زْبْدٍ","وَلَسْتَ لِسُوءِ حَظِّكَ بالسَّمِينِ",1,"ن",1,0],["فَخَضخَضنَ بَردَ الماءِ حَتّى تَصَوَّبَت","عَلى الهَولِ في الجاري شُطورُ المَذارِعِ",2,"ع",1,0],["فَخَضخَضتُ النِطافَ لِيَعمَلاتٍ","نَواشِطَ حينَ يَستَغطي ابَريرُ",3,"ر",1,0],["فَخُضنَ نِياطَها حَتّى أُنيخَت","عَلى عافٍ مَدارِجُهُ سَدومِ",4,"م",1,0],["فَخُضتُ في لُجِّ بِحرِ فِكري","أَمُرُّ فيهِ كَمَرِّ سَهمِ",5,"م",1,0],["فَخِضابُ تِلكَ مِنَ العُيونِ وِقايَةٌ","وَخِضابُ ذاكَ مِنَ الدَمِ المَسفوكِ",6,"ك",1,0],["فخض في التجارب بعد اليقين","فإنّ التكاسل يحيى الندامه",7,"م",2,0],["فَخُضتُ إِلى الأَثناءِ مِنها وَقَد تَرى","ذَواتِ البَقايا المُعسِناتِ مَكانِيا",8,"ي",2,0],["فخضَبْتَهُ إذ لا تَكادُ تَهُزُّهُ","حتى تَنُوءَ بهِ يَدٌ وأنامِل",9,"ل",1,0],["فخض عباب فقهه وسرِّه","وغص على صحيحه وحرّه",10,"ه",1,0],["فَخُضتُ بِمُهجَتي بَحرَ المَنايا","وَسِرتُ إِلى العِراقِ بِلا رِفاقِ",11,"ق",1,0],["فخضتَ غِمارَها صَمداً هماماً","ورُعت بها جيوش الموت جَلْدا",12,"د",2,0],["فَخَضخَضتُ صُفنِيَ في جَمِّهِ","خِياضَ المُدابِرِ قِدحاً عَطوفا",13,"ف",2,0],["فَخَضِبتُ أَطرافَ القَنا","فيهِ بِحَنّاءَ الدَمِ",14,"م",1,0],["فَخض كُلّ لجٍّ وَاِلتقط دُرر الثَنا","وَعُد راشداً بِالفوز فالعود أحمَدُ",15,"د",1,0],["فخض في الفنون وجل في المتو","ن وكن رجلاً رِجْلُه في الثرى",16,"ا",1,0],["فخضنا إليه والبحر قد طمى","وكم غمرة خضنا إليه وإنَّما",17,"م",2,0],["فخُضْ بها من أحاديث الندام إذا","أعيت مذاهبها في كل مقترح",18,"ح",1,0],["فخضْها على التوفيق واقدح بزندها","عمانَ وإنِّي بالنجاح ضمينُ",19,"ن",1,0],["فخُضَّ طِرادٌ والحسين برحمةٍ","مذاهبها من واسع الخرق أفْسحُ",20,"ح",1,0],["فَخُضْ في بِحارِ الاِجُتهادِ وعَدِّ عَنْ","رجالٍ تَسَلَّتْ عَنْ سَناهُ بِفِرْيَةِ",21,"ه",1,0],["فخُضوعا لقضَاءِ اللهِ لا","مِن مَرَدٍّ لقضَاءٍ أزَلِي",22,"ي",1,0],["فخضب مصقول الشبا من أديمها","نجيعاً كما عصفرت شق ازار",23,"ر",1,0],["فَخُضرَتُها كَالجَوِّ في حُسنِ لَونِهِ","وَأَنوارُها تَحكي لِعَينَيكَ أَنجُما",24,"م",2,0],["فخضتُ بحرَ ظلامٍ كاد يكتمني","كأنَّني خبرٌ في سرِّ مكتتم",25,"م",1,0],["فَخُضتُ لَهَا التَّنَائِفَ تَحْتَ لَيلٍ","جَفَانِي فِيهِ أهْلِي والصّحَابُ",26,"ب",1,0],["فخضنا بأسرار التناجي كأنما","أدرنا على الأحشاء أكواب قرقف",27,"ف",1,0],["فخضنا ضرام الحرب خوضة مبصر","وكم رد طرف الموت وهو كليل",28,"ل",1,0],["فَخُض لُجَجَ البَحرِ الخِضَمِّ جَميِعِهِ","بِهذينِ مِن هُرمَوزَ للصِينِ والقُمرِ",29,"ر",1,0],["فَخضرته ثلثٌ وَثلثاه شهبة","فَأخضر قدّامٍ وَأشهب تالِ",30,"ل",1,0],["فَخضرةُ ما فيها تَفوقك خُضرَة","وَنوارها فيها ثَواقب أَنجمِ",31,"م",1,0],["فخضت بها بحر المفاخر سابِحاً","وَظلتُ بها حجب المَكارِم أَخرق",32,"ق",1,0],["فخضت عباب لجته","وقلبي خانه الجلد",33,"د",1,0],["فخضت اجاج البحر والبحر كالح","وجبت فجاج البر والبر مغبر",34,"ر",1,0],["فخضخضا بُردهُ خوضاً فراعهما","ركز تثوَّرَ من ذي أسهمٍ جَردِ",35,"د",1,0],["فخضت بها زاخرات العلوم","إلى أن وردت الخضم الغزيرا",36,"ر",2,0],["فخضت غمارا دونها وسباسبا","يضل القطا فيها وينحسم الكد",37,"د",1,0],["فخضتَ سراباً يغرق النور لجّه","وجُبتُ سجيراً يحرق الهُدْبَ جاحمه",38,"م",2,0],["فخضماً أراكَ في كل فنٍ","وظريفاً ألقاكَ في كل حال",39,"ل",1,0],["فخضنا إليه البحر والبحر قد طما","وكم غمرة خضنا إليه وإنما",40,"م",2,0],["فَخِضْتُ بُحُوْرَ الشِّعْرِ وَالْنَثْرِ دَاْعِياً","إِلَىْ مَاْ تَرَىْ مِنْ ثَوْرَتِيْ وَانْتِقَاْمِيَاْ",41,"ي",2,0],["فخض بحره حتى تفوز بدرِّه","وجوهره أو تستبين كنايته",42,"ت",2,0],["فخضت فيك غمار الوجد راضية","جوارحي في جنون العاشق الدنف",43,"ف",1,0],["فخض بفتح النون إذ عمّ نفعه","ورحمته والضم من شأنه السدّ",44,"د",1,0],["فخُضرتُه كمثلِ العينِ سحر","وحمرتُه تزيدُ الخد وَردا",45,"د",2,0],["فخضّرْ عروشَ الروح إنّ لفيئها","عبيرا ً يبث العطر َ في الخفقاتِ",46,"ت",1,0],["فخضت حبك كالإعصار مندفعا","حتى راك على عيني سماري",47,"ر",2,0]]}