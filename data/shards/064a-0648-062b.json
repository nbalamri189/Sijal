{"poems":[[73,"ومملوكة عندي عزيز نجارها","https://www.aldiwan.net/poem3861.html","الطويل"],[95,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[74,"صحا القلب لولا نسمة تتخطر","https://www.aldiwan.net/poem18693.html","الطويل"],[53,"وما الفقر عيبا ما تجمل أهله","https://www.aldiwan.net/poem8133.html","الطويل"],[87,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[47,"أيما خلة ووصل قديم","https://www.aldiwan.net/poem66652.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54763","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54876","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54917","الخفيف"],[108,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[321,"تأوب عيني طيف ألم","https://www.aldiwan.net/poem69423.html","المتقارب"],[327,"ألا طال التنظر والثواء","https://www.aldiwan.net/poem56353.html","الوافر"],[333,"من ترانيم وحيك القدسي","https://www.aldiwan.net/poem55045.html","الخفيف"],[382,"حلول حال أفرقنا مجالا","https://www.aldiwan.net/poem59176.html","الوافر"],[463,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64535","الطويل"],[1802,"","https://poetry.dctabudhabi.ae/diwan/poem/116938","السريع"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132231","الوافر"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114025","الخفيف"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114729","المنسرح"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103517","الخفيف"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103412","الرجز"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105796","الطويل"],[4767,"العيد","https://www.poetsgate.com/ViewPoem.aspx?id=129805",""],[333,"نشيد الصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=101256",""],[402,"من عذيري والدمع جارس خين","https://www.poetsgate.com/ViewPoem.aspx?id=36541",""]],"verses":[["يُؤَثِّرُ فيها الوَهمُ مِن صَلَفٍ بِها","فَمِن أَجلِ هذا لا تَريمُ عَنِ الخِدرِ",0,"ر",1,0],["يُؤْثِرُ السَّهْلَ فِي الكَلامِ وَلِلْ","جَزْلِ مَتَى تَدْعُهُ البَلاغَةُ حِينُ",1,"ن",1,0],["يؤثر في خدِّ المليحة لحظها","وإن كانَ في ميثاقِها لا يؤثر",2,"ر",1,0],["يؤثّل لا للحمدِ ما هو كاسبٌ","ولا الأجرِ في إصباحه ومسائِهِ",3,"ا",3,0],["يُؤثِرُ الصِدقَ وَيَجزي عَلَما","قَلَبَ العالَمَ لَو لَم يُطمَسِ",4,"س",1,0],["يُؤثِرُ البُؤسَ في مُباشَرَةِ الأَم","رِ وَفي جَنبِهِ مَكانُ النَعيمِ",5,"م",1,0],["يُؤَثِّلُ مَجْداً طَارِفاً بَعْدَ تَالِدٍ","وَيَرْعَى شُؤُونَ البِرِّ رَعْياً مُسَدَّدا",6,"د",2,0],["يُؤَثِّلُ بِالرُّوحِ العِصَامِيِّ جَاهُهُ","فَإِمَّا تَجَنَّى دَهرُهُ كَافَح َالدَّهْرَا",7,"ر",2,0],["يُؤْثِرُ المُولَعُونَ بِالخَمْرِ مِنْهُمْ","مَا سَقَاهُمْ عَلى عَتِيقِ الخَمْرِ",8,"ر",1,0],["يؤثرُ البغَتةَ في تصريفِهِ","ومع البغتةِ توفيقُ الإلهْ",9,"ا",3,0],["يؤثر فيها نسيم الهواء","وتخرفها خافيات الوهم",10,"م",1,0],["يُؤَثِّرُ في القُلوب لَهُ كُلومٌ","كَداءِ المَوتِ لَيسَ لَهُ دَواءُ",11,"ا",2,0],["يؤثر الناس بالبقاء ويفنى","ومن الظلم طينة الآدمي",12,"ي",1,0],["يؤثِّل فيهمُ فخراً رفيعاً","يدرِّعهم مع الأبدي الجلالا",13,"ل",2,0],["يؤثَرُ عنها خبرٌ صادقٌ","في مجدكم أو مَثَلٌ سائرُ",14,"ر",1,0],["يؤثر ما يختار فعلاً مقدساً","عن العبث الفطري والعوجية",15,"ه",1,0],["يؤثر بالطعم وتأذينهُ","منجم ليس له فكرُ",16,"ر",1,0],["يؤثر إن مشى ذر عليها","ويزلق فوقها فرخ الذباب",17,"ب",1,0],["يؤثر السِّلم جانحا فإذا ما","ماج بحرُ الهيجاء خاض عُبابَه",18,"ب",2,0],["يُؤثِرُ بِالصَّفوِ ذا مودَّتهِ","عَن طيبِ نَفسٍ ويَشرَبُ الكَدَرا",19,"ر",2,0],["يؤثرون الغريب منه على ما","كان سهلاً للسامعين مبينا",20,"ن",2,0],["يُؤثِرُهُ عَلى كَريمِ صحبهِ","يعدو بكشحٍ لاحِقٍ بجَنبِهِ",21,"ب",2,0],["يُؤَثِّرُ فيه ناظرُ الفكر بالمنى","وتجرحُهُ باللَمس منها الضمائرُ",22,"ر",1,0],["يوثق الإنسانَ مهما كان يسعى","نحو أموالٍ بأغلال القيودِ",23,"د",1,0],["يؤثر الناس بالبقاء ويفنى ومن الظلم طينة الآدميّ","هَمُّه الفكر في المجاعة والدّين وعقل الفتى وسقم الصبيّ",24,"ي",1,0],["يؤثر السهل في الكلام واللجزل","متى تدعه البلاغة حين",25,"ن",1,0]]}