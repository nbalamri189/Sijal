{"poems":[[32,"خليلي عوجا اليوم حتى تسلما","https://www.aldiwan.net/poem29528.html","الطويل"],[49,"أيا ظالما أمسى يعاتب منصفا","https://www.aldiwan.net/poem25225.html","الطويل"],[48,"أيا ظبيات الإنس لست مناديا","https://www.aldiwan.net/poem22819.html","الطويل"],[48,"وجدت ابن آدم في غرة","https://www.aldiwan.net/poem23006.html","المتقارب"],[79,"أدارهم بين الأجارع فالسدر","https://www.poetsgate.com/ViewPoem.aspx?id=34094",""],[192,"إلا أنت","https://www.aldiwan.net/poem35679.html","عموديه"],[435,"أيا ظبيتي دار الصفا هجتما الهوى","https://www.aldiwan.net/poem40531.html","الطويل"],[469,"أيا ظاعناً أنا من بعده","https://www.aldiwan.net/poem3552.html","عموديه"],[556,"أيا ظبية في ربى جاسم","https://www.aldiwan.net/poem47219.html","المتقارب"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39037","المتقارب"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126601","الهزج"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49999","الطويل"],[1531,"","https://poetry.dctabudhabi.ae/diwan/poem/99867","المتقارب"],[1660,"","https://poetry.dctabudhabi.ae/diwan/poem/72169","الطويل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123074","الرمل"],[2136,"","https://poetry.dctabudhabi.ae/diwan/poem/203567","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201095","الوافر"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132009","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101386","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94701","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94798","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94790","الطويل"],[4980,"لستَ تَهُونُ","https://www.poetsgate.com/ViewPoem.aspx?id=192763",""],[4980,"لِحَالي شكوتُ الهجرَ","https://www.poetsgate.com/ViewPoem.aspx?id=193318",""],[5690,"أيا اللّه ما أحلى وأجودْ","https://www.poetsgate.com/ViewPoem.aspx?id=172151",""],[6068,"إذا ذكر الأحباب آضت تهزّني -24-","https://www.poetsgate.com/ViewPoem.aspx?id=175862",""],[5519,"عطر الصّباح ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69279&r=&rc=12",""]],"verses":[["أَيا ظَبيَةَ الوَعساءِ بَينَ جُلاجِلٍ","وَبَينَ النَقا أَأَنتِ أَم أُمُّ سالِمِ",0,"م",1,0],["أَيا ظالِماً أَمسى يُعاتِبُ مُنصِفاً","أَتُلزِمُني ذَنبَ المُسيءِ تَعَجرُفا",1,"ف",2,1],["أَيا ظَبَياتِ الإِنسِ لَستُ مُنادِياً","وُحوشاً وَلَكِن غانِياتٍ مَعَ الإِنسِ",2,"س",1,1],["أَيا ظَبيَّةَ القاعِ خافي الرُماةَ","وَلا يَخدَعَنَّكِ رَوضٌ يَرِف",3,"ف",1,0],["أيا ظاعنا نحر الدجنة يبتغي","طلوع سنى الخيمات في مطلع الفجر",4,"ر",1,0],["أيَا ظَهري المطعون خيراً فعَلْت بي","بألّا تُريني الغدر وجهاً أُقابِلُهْ",5,"ل",2,0],["أيا ظبيتي دار الصفا هجتما الهوى","وذكرتماني عهد ذات التدللِ",6,"ل",1,1],["أيا ظاعناً أنا من بعده","نجيُّ الهموم ونضوُ السّهر",7,"ر",1,1],["أَيا ظبيةً في رُبى جاسِمِ","سُقيتِ حَيا واكفٍ ساجِمِ",8,"م",1,1],["أيا ظَبْيَةً في ظُبا لَحْظِها","وفي وَجْنَتيها ضُروبُ المِحَنْ",9,"ن",1,0],["أيا ظبية بطن الخي","ف ضيف رام إنزاله",10,"ل",2,0],["أيا ظبيةً في بطن وعساءَ نَصّبت","لنا جيدّها مذعورةً وهي ترمقُ",11,"ق",1,0],["أيا ظبي لولا الذي في الحشا","وفي القلب مني ولولا الحرق",12,"ق",1,1],["أَيَا ظَبْيَةَ الوَعْساءِ أَنْتِ شَبِيهَةٌ","بِذَلْفَاءَ إلاَّ أَنَّ ذَلْفَاءَ أجْدَلُ",13,"ل",1,1],["أيا ظبياً شروداً","به نومي تشرّد",14,"د",1,0],["أيا ظبية الوادي محلك مهجتي","ومرعاك في قلبي الذي بك هائم",15,"م",1,0],["أيا ظبياً يهيم بكل وحش","ويبعد عن أخ الفهم الذكيّ",16,"ي",1,1],["أيا ظاعنا نحو الجنوب وكلنا","أكف تحييه وترجو له العلى",17,"ل",2,0],["أيا ظالماً يا ابن فيلا فأم","ك قد أرضت مرةً وقلا",18,"ل",2,0],["أيا ظبي الصريم غضا فؤآدي","مقيلك حيث تأوي لا الصريم",19,"م",1,0],["أيا ظالمي بالهجر من دون ذلةِ","رويداً دع الهجرانَ وأنعم بوصلةِ",20,"ه",1,1],["أيا ظالماً بثُّ المظالم دأبهُ","على البغي مفطورٌ بأقبح فطرةِ",21,"ه",1,0],["أيا ظالمي عذراً ولا تكُ ظالماً","فأنّى ولا أبكي لفقدي شقيقتي",22,"ي",1,0],["أيا ظاعنًا أفديك عمري، ومهجتي","تهُونُ لأشواقي ولستَ تَهُونُ",23,"ن",1,0],["أيا ظاعنًا والرّوح باتت بِرَحلِهِ","أعد لي فداء الشّوق يومًا حياتي",24,"ي",1,0],["أيا ظبياً وحاشا من شبيهٍ","فما للظبي نهدٌ أن تنهد",25,"د",1,0],["18-أيا ظبية العفراء رُدّي تحيتي","فإما وصال أو سلام محبب",26,"ب",1,0],["أيا ظلمة في مداري تسود","متى تعشقين الفتى كالشّموع",27,"ع",1,0]]}