{"poems":[[87,"أبولو مرحباً بك يا أبولو","https://www.aldiwan.net/poem8077.html","الوافر"],[48,"أكمها ليس بينهم بصير","https://www.aldiwan.net/poem22479.html","الوافر"],[325,"كان عيد الفدا لحظك أوفر","https://www.aldiwan.net/poem67178.html","الخفيف"],[463,"جرت لها ببابلٍ يمينا","https://www.aldiwan.net/poem55838.html","الرجز"],[466,"أما اذا سلم الامام الأعظم","https://www.aldiwan.net/poem16018.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48769","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56098","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95508","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62765","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216787","الطويل"],[4799,"عناقيد طيبه","https://www.poetsgate.com/ViewPoem.aspx?id=12262",""],[4988,"لأنك غير ( أمي )","https://www.poetsgate.com/ViewPoem.aspx?id=204627",""],[5061,"يامهاجر","https://www.poetsgate.com/ViewPoem.aspx?id=147155",""],[5061,"ياوطن","https://www.poetsgate.com/ViewPoem.aspx?id=147162",""],[5061,"دمعة المغترب","https://www.poetsgate.com/ViewPoem.aspx?id=152992",""],[5370,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=87420",""],[5480,"الفداء","https://www.poetsgate.com/ViewPoem.aspx?id=9889",""],[5526,"الأم","https://www.poetsgate.com/ViewPoem.aspx?id=197185",""],[5629,"ووجة الليل","https://www.poetsgate.com/ViewPoem.aspx?id=184489",""],[5648,"كل عام والامه بخير وسلامه","https://www.poetsgate.com/ViewPoem.aspx?id=155977",""],[5652,"يمه","https://www.poetsgate.com/ViewPoem.aspx?id=177964",""],[5652,"يمه حنيني بالمعاني يناجيك","https://www.poetsgate.com/ViewPoem.aspx?id=192042",""],[5717,"فالقول بالعدل أساس يبتنى","https://www.poetsgate.com/ViewPoem.aspx?id=170603",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[406,"كاترينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66905&r=&rc=11",""],[6259,"بعثن غداة تقويض الخيامِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59399&r=&rc=47",""]],"verses":[["يُمَهِّدُ عَبقَرِيُّ الشِعرِ فيها","لِكُلِّ ذَخيرَةٍ فيها مَحَلُّ",0,"ل",1,0],["يُمَهَّدُ لِلغَنيِّ فِراشُ نَومٍ","وَقَبرٌ كانَ أَروَحَ مِن مِهادِ",1,"د",1,0],["يُمهِلُ اللَهَ في الذُنوبِ كَثيراً","وَأُولو البَغيِ قَصمَهُم قَد تَقَرَّرُ",2,"ر",1,0],["يُمهِرُها الصونَ فإن أولدها","أولدَها بمدحك البنينا",3,"ن",2,0],["يُمْهي لنا الحُزْنَ الأليمَ عزاؤهُ","فيكُفُّهُ كوْنُ الخليفةِ يَسْلَمُ",4,"م",1,0],["يمهدون بتمويهٍ لتبرئةٍ","ويدفعون إليها بالنداءات",5,"ت",1,0],["يمهد طرق القسط والعدل في الورى","ويصلح دنيانا ويمحو المظالما",6,"م",2,0],["يمهد الأمانى ويحبو كل حاضرة","ويكفل الشعب من قاصٍ ومن دانِ",7,"ن",1,0],["يُمهِلُ الظالمينَ حتى إذا ما","شاءَ ذاقوا عواقبَ الطغيانِ",8,"ن",1,0],["يُمهِلكُ الإقبَالُ والإنسَاع","وَفي الطريقِ لا تَكُن مُرتَاع",9,"ع",1,0],["يُمهد أكنافُ السوابقِ بعدَما","لعِبنَ به بين الظُّبا كلَّ ملعَبِ",10,"ب",1,0],["يمهده اللحن الشجي وينطوي","عليه حجاب الصمت من حيث ينجم",11,"م",1,0],["يمّه إسمحي لي طبع الإنسان نسّاي","إذا بدر تقصير مني وغيبه",12,"ب",2,0],["يمّه ومهما كبرت طفلك واضل صغير","ملقوف طبع وطفش حتى بعلاقاتي",13,"ت",2,0],["يمّه ويا يمّه أموت وتضلّي بخير","ي اغلى من انفاسي غلاي ومسرّاتي",13,"ت",2,0],["يمّه ولأنّك غير هاذي القصيده غير","وابطي وتبطي يا عظيمه كتاباتي",13,"ت",2,0],["ي مهاجر عن عيوني وش تريد؟","غير قلبٍ ماعشق غيرك فتاه",14,"ا",2,0],["يَ مهبط التوحيد واهل الملہ","خلفك رجال للثقهہ حمالهہ",15,"ل",2,0],["#يمه فراقكك مزق القلب -تمزيق","ويمه #غلاك يصول في القلب ويجول",16,"ل",1,0],["يمه .. يا يمه فديتك لا تخليني","بعثرني الهم وأبغي يديك تجمعني",17,"ن",2,1],["يمه افهميني تراك إن ما فهمتيني","ما فيه شخصٍ بهالدنيا بيسمعني",17,"ن",2,0],["\"يمه\" العالم بدونك ما لنا فيه استراح","من يداريني دخيلك وأنتي القلب النصوح؟",18,"ح",1,0],["يمه يا أعظم قاف ياتي من الهام","سجادةٍ .. فايح شذاها وتوله",19,"ل",2,0],["يمه.. ووجة الليل يشبة ..ل الأقراب","لآمن ..طحت.. وناظرو في عيوني",20,"ن",2,1],["يمه وحزني طير..والصدر..مرقاب","توحي..بكسرة ...جناحة...ظنوني",20,"ن",2,0],["يمه انا..ماجيت ..محتاج لا آسباب","جيتك غريم احمل.حصيلة ..طعوني",20,"ن",2,0],["يمه..اذا مات ألوفا ب كل...الأقراب","واشتد عود..الهم ...والغم ...كوني",20,"ن",2,0],["يمه اذا كان ..الغنى..لم الاصحاب","ف الفقر وراني ...كثير...هملوني",20,"ن",2,0],["يمه واذا صار..الزمن خوة..حساب","ف .......انا افضل أنهم يجهلوني",20,"ن",2,0],["يمهل ولايهمل وهذا كلامه","الله حكيم وبالمقادير علام",21,"م",1,0],["يمه وربي ماهنى ل عيني تنام بمرقدي","والنوم سل سيوف حربه في لقى حرايبه ..!!",22,"ب",2,0],["يمه حنيني ب المعاني يناجيك","لا من كتبتك ب الغلا ياغناتي",23,"ت",2,1],["يمه ورب الكون محدن يساويك","يانور دنيايه وغاية مناتي ..!!",23,"ت",2,0],["يمهد النظام في مجتمع ال","ناس ويصلح ائتلاف الامم",24,"م",1,0],["يمهلنا وما سواه الواقي","سبحانه أغنى وأقنى وصبر",25,"ر",1,0],["يُمهل الله خلقَه ويُريهم","طُرُق الخير عَلَّهم يَسلكونا",26,"ن",2,0],["يمهّد في الطّلى أشداقَ عنس","تحلّب بالدما بدل اللُّغام",27,"م",1,0]]}