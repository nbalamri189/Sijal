{"poems":[[44,"يقول الأرذلون بنو قشير","https://www.aldiwan.net/poem50350.html","الوافر"],[37,"خليلي إن أم الحكيم تحملت","https://www.aldiwan.net/poem39117.html","الطويل"],[56,"مدارس آيات خلت من تلاوة","https://www.aldiwan.net/poem28547.html","الطويل"],[39,"ألا هل عم في رأيه متأمل","https://www.aldiwan.net/poem7652.html","الطويل"],[74,"ملي الحسن حالي الوجنتين","https://www.aldiwan.net/poem20157.html","الوافر"],[66,"من سارروه فأبدى كل ما ستروا","https://www.aldiwan.net/poem67633.html","البسيط"],[53,"ألا نسيا نفسي حديث البلابلِ","https://www.aldiwan.net/poem65958.html","الطويل"],[53,"إذا ما جلته الحرب أعرض رمحه","https://www.aldiwan.net/poem66001.html","الطويل"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[87,"ما بات يثني على علياك إنسان","https://www.aldiwan.net/poem7923.html","البسيط"],[30,"عسى أسد أن يطلق الله لي به","https://www.aldiwan.net/poem5353.html","الطويل"],[107,"رددوا الذكرى لقوم غافلين","https://www.aldiwan.net/poem42065.html","الرمل"],[107,"أهذي ديار القوم غيرها الدهر","https://www.aldiwan.net/poem43415.html","الطويل"],[104,"أما سماسرة البلاد فعصبة","https://www.aldiwan.net/poem32964.html","الكامل"],[77,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202552","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[66,"الأهوال أمانات عند أهلها","https://www.poetsgate.com/ViewPoem.aspx?id=3098",""],[30,"عسى أسد أن يطلق الله لي به","https://www.poetsgate.com/ViewPoem.aspx?id=22099",""],[354,"هم المنى والأمل","https://www.aldiwan.net/poem15858.html","مجزوء الرجز"],[422,"قلب يذوب ومهجة تتقطع","https://www.aldiwan.net/poem54185.html","الكامل"],[427,"ما لذة العيش إلا صحبة الفقرا","https://www.aldiwan.net/poem46403.html","البسيط"],[447,"ألق العصي فهذا مقتضى الأرب","https://www.aldiwan.net/poem14330.html","البسيط"],[447,"أستغفر الله العظيم","https://www.aldiwan.net/poem14398.html","مجزوء الكامل"],[447,"استغفر الله من قول ومن عمل","https://www.aldiwan.net/poem14427.html","البسيط"],[447,"هذا هو الرزء الجن والبشرا","https://www.aldiwan.net/poem14454.html","البسيط"],[487,"كم كنت في غمرات الحب أستبق","https://www.aldiwan.net/poem24456.html","عموديه"],[505,"هب النسيم فسار بالأسرار","https://www.aldiwan.net/poem38018.html","الكامل"],[511,"أحب النبي المصطفى وابن عمه","https://www.aldiwan.net/poem2435.html","الطويل"],[563,"أهل المحبة في السرور الدائمِ","https://www.aldiwan.net/poem33857.html","الكامل"],[592,"يا راكباً من رياض المجد مرتحلا","https://www.aldiwan.net/poem11553.html","عموديه"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110437","الرمل"],[754,"","https://poetry.dctabudhabi.ae/diwan/poem/18849","الطويل"],[814,"","https://poetry.dctabudhabi.ae/diwan/poem/104445","المتدارك"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37999","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37936","السريع"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105463","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96739","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25329","الرجز"],[1315,"","https://poetry.dctabudhabi.ae/diwan/poem/140226",""],[1533,"","https://poetry.dctabudhabi.ae/diwan/poem/105655","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79847","الرجز"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104759","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110333","الكامل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89521","البسيط"],[2177,"","https://poetry.dctabudhabi.ae/diwan/poem/138795",""],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53203","الكامل"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121910","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77304","الطويل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110641","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93515","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93681","الكامل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111252","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93825","الكامل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118779","البسيط"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118786","البسيط"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71308","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45781","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[4092,"","https://poetry.dctabudhabi.ae/diwan/poem/141703","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54348","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54342","الدوبيت"],[4347,"","https://poetry.dctabudhabi.ae/diwan/poem/134241","الطويل"],[5277,"معارضة قصيدة عبدالرزاق عبدالواحد","https://www.poetsgate.com/ViewPoem.aspx?id=205147",""],[2110,"هلال حسن هل يا من يراه","https://www.poetsgate.com/ViewPoem.aspx?id=156288",""],[6127,"كنز اليتامى","https://www.poetsgate.com/ViewPoem.aspx?id=190114",""],[6147,"أنا ودليلتي.. والطريق..","https://www.poetsgate.com/ViewPoem.aspx?id=151496",""],[6152,"يوما سيرجع الود","https://www.poetsgate.com/ViewPoem.aspx?id=203417",""]],"verses":[["هُمُ أَهلُ النَصيحَةِ مِن لَدُنّي","وَأَهلُ مَوَدَّتي ما دُمتُ حَيّا",0,"ي",2,0],["هُمُ أَهلُ أَلواحِ السَريرِ وَيُمنَةٌ","قَرابينُ أَردافاً لَها وَشِمالَها",1,"ل",3,0],["هُمُ أَهلُ ميراثِ النَبِيِّ إِذا اِعتَزَوا","وَهُم خَيرُ قاداتٍ وَخَيرُ حُماةِ",2,"ه",1,0],["هَماهِمُ بالمُستَلئِمِينَ عَوَابِسٌ","كَحِدآنِ يومِ الدَجنِ تَعلُو وتَسفُلُ",3,"ل",1,0],["هما هجرَا على رغمي فأرخ","حديث تلهفي بالهجرتين",4,"ن",1,0],["هُم أَهلُ سِرٍّ وَلِلأَسرارِ قَد خُلِقوا","لا يَصبِرونَ عَلى مَن كانَ فَحّاشا",5,"ش",2,0],["همُ أهملونا في مُصاب غُيوثِهم","سُدىً ورعوْنا بالقنا والقنابلِ",6,"ل",1,0],["همُ أهملونا في مُصابِ عيونهم","سُدىً ورعونا بالقنا والقنابلِ",7,"ل",1,0],["هُم أَهلُ بَيتَ الحُسن الطاهر أَو","مِن شَبَّ مِن بَيت الحُسين وَنَما",8,"ا",1,0],["هُما هُما تَعرِفُ العَلياءُ قَدرَهُما","كِلاهُما كَلِفٌ بِالمَجدِ يَقظانُ",9,"ن",1,0],["هُمُ أَهلُ بَيتِ المَجدِ حَيثُ اِلتَقَت بِهِم","بَجيلَةُ فَوقَ الناسِ مِن كُلِّ مُرتَقِ",10,"ق",1,0],["هم أهانوا كلَّ حُرٍّ فاضلٍ","وأَعَزُّوا كلَّ صُعلوكٍ مَهينْ",11,"ن",1,0],["هُما هَضبَتا عَزمٍ وَحَزمٍ كِلاهُما","يَخافُهما الخَطبُ المَخُوفُ فَما يَعرو",12,"ر",2,0],["همْ أهلُ نجدتها وإن أنكرتَهم","وهمو وأنفك راغم زعماؤها",13,"ا",3,0],["همُ أهلُ جرّاها وأنتَ ابنُ حربِها","ففي القرب تبعيدٌ وفي البعد تقريب",14,"ب",1,0],["هم أهل بيت الحسن الطاهر أو","من شب من بيت النبيّ ورسا",15,"ا",1,0],["هما هما القالب فيه يفرغ","ومعدن الحسن الذي لا يفرغ",16,"غ",1,0],["هم أهل السرِّ وللأسرار قد خُلقوا","لا يصبرون على ما كان فحَّاشا",17,"ش",2,0],["همُ أهلُ بيتِ المجدِ حيثُ ارْتقتْ بهمْ","بَجِيلَةُ فوْقَ النّاسِ من كخلّ مُرْتَقِ",18,"ق",1,0],["هُم أَهلُ بَدرٍ غَيرَ مَأ","ثومينَ فيما فَعَلوا",19,"ل",3,0],["هم أهرقوا دمعي المصونَ وأوقدوا","في القلب غُلَّةَ وامقٍ لا تنقعُ",20,"ع",1,0],["هم أهل ودّي وأحبابي الذين همُ","ممّن يجرُّ ذيول العزّ مفتخرا",21,"ر",2,0],["هما هما عينا حفظ وأسرار","والناصراك فبالأرواح والنشب",22,"ب",1,0],["هم أهل مشأمةٍ ومل","أمةٍ وأخلاقٍ رديه",23,"ي",2,0],["هم أَهل مظلمة اصحاب مشأمة","أنجاب ملأمة أَرباب مختلق",24,"ق",1,0],["هما هما فهما يرجى المنى بهما","علماً وزهداً وإحساناً ومصطبرا",25,"ر",2,0],["هم أهل بدر فما في فعلهم حرج","وليهنك العلم فضلا ما بدا الأفق",26,"ق",1,0],["هم أهلُ يَثْرِبَ والمَشاعرِ واللِّوا","هم قِبْلَةُ الغُيَّابِ والحُضَّارِ",27,"ر",1,0],["هم أهل بيت أذهب الرجس عنهم","وأطلعهم افق الهدى انجماً زهرا",28,"ر",2,0],["هم أهل كشف يفرحون بربهم","في كل صورة أهيفٍ متلائم",29,"م",1,0],["هم أهل مجد ونور يستضاء به","في الدين بل هم لعمري أهل إنعام",30,"م",1,0],["هُمُ أَهل الفضل أَرباب الحجَى","واؤُلو الآداب أَصحاب المقام",31,"م",1,0],["هُم أَهلُ عِزٍّ ثابِتٍ وَأَرومَةٍ","وَهُم مِن مَعَدٍّ في الذُرى والغَلاصِمِ",32,"م",1,0],["هم أهل العلم وأهل الحل","م ولولا حكمهم الاسلام ما سلما",33,"م",2,1],["هُم أَهلُ بَيروتَ الَّذينَ تَزَيَّنت","مِنهُم بِدُرِّ عَطائِكَ الأَجيادُ",34,"د",1,0],["هُما هِلالانِ لَدى فِرقَةٍ","هُما هِلالٌ إِذ يَكونُ اِقتِرابْ",35,"ب",1,0],["هم أهل بيت يرى الناظرون","صغيرهم في الورى أكبرا",36,"ر",2,0],["هم أهل وادي الأجرعين فيا ترى","ترى الأجرعين فيهم الدهر تسجم",37,"م",1,0],["هُما هُما موكبا عزٍّ وسلطنةٍ","وَليسَ بعدهما في الفضل سلطانُ",38,"ن",1,0],["هَمَاهِماً يُسْهِرْنَ أَوْ رَسِيسا","قَرْعَ يَدِ اللَعّابَةِ الطَسِيسا",39,"س",2,0],["هم أهل بدر فلا يخشون من حرج","وكم بهم هائم نشوان مشمول",40,"ل",1,0],["هما هما ما لعبد مذنب وزر","سواهما لا وباري كل موجود",41,"د",1,0],["هما هلالا الجود مصباحا النهى","كلاّ عليه يجد الساري هُدى",42,"د",2,0],["هُم أَهلُ بَدر جَمَالُ اللهِ بَعضُهُمُ","هُم أهلُ أُحدٍ جَمالُ الحَقِّ نُظَّارُ",43,"ر",1,0],["هم أهل ودي لا عدوت ظلالهم","فظلالهم للخير ست جهات",44,"ت",1,0],["هُم أَهلُ قَريَةَ إِخوانٌ لَهُم قَدَمٌ","في الصالِحاتِ الَّتي تُرجى بِها القُربُ",45,"ب",1,0],["هم أهل بيت رسول الله جدهم","أجر الرسالة عند الله ودهم",46,"م",1,1],["هم أهل ندوتها وسقي حجيجها","وحماة أشرف معشر ومقام",47,"م",1,0],["هم أهل ودى هم سويدا مهجتى","هم غايتى القصوى اليّ وهم همو",48,"م",2,0],["هم أهل تعطيل وتشبيه معا","بالجامدات عظيمة النقصان",49,"ن",1,0],["هُم أَهلُ دينِ الحَقِّ لا العُرفُ ضائِعٌ","لَدَيهِم وَلا الدُنيا بِجَنَّةِ رَضوانِ",50,"ن",1,0],["هم أهل مجد لا يضام نزيلهم","ونزيل بيت المجد ليس يضام",51,"م",1,0],["هُمُ أَهل الوَفاء بِعصر سوء","بِهِ أَهلوه ما عَرفوا الوَفاءا",52,"ا",3,0],["هُم أَهل بَيت لَيسَ يجحَد فَضلهم","بَدأوا قَديماً بِالجَميل وَأَكمَلوا",53,"ل",3,0],["هم أهل مكتها التي أن يسألوا","عنها فهم أدرى الورى بشعابها",54,"ب",3,0],["هم أهل خير عز سامي مجدهم","ولهم بباقي الفضل أم تخصص",55,"ص",1,0],["هم أهل بدر فلا يخشون من حرجٍ","دمي مباح لهم في السهل والجبلِ",56,"ل",1,0],["هم أهّلوك لهم جوداً ومكرمةً","وبلّغوك الذي ترجو من الأربِ",57,"ب",1,0],["هُمْ أَهْلُ وُدِّي وَهَذَا وَاجِبٌ لَهُمُ","وَإِنَّمَا وُدهُمْ لي فَهْوَ لاَ يَجِبُ",58,"ب",1,0],["هُم أَهل نَجد الأُلى اِعتَزَت أَوائِلَهُم","بِالدَهر حَتّى دَهاهم حادث الغَير",59,"ر",1,0],["هم أهلهُ أهلُ الرسولِ وآلهُ","وذلك أعلى ما يكون وأعظمُ",60,"م",1,0],["هم أهل الحديث وما عرفنا","سوى القرآن والنص الجلي",61,"ي",1,0],["هما هُمامانِ في يومَيْ وغىً وقرىً","تعوَّدا ضربَ هام أَو عراقيبِ",62,"ب",1,0],["هم أهلُ مودَّتي رضوا أم غضبوا","ما أَعظمَ زلّتي إذا لم يهبوا",63,"ب",3,0],["هم أهلوني للمحامد منة","ولست لها أهلا ولكنهم أهل",64,"ل",1,1],["همُ أهلُ العراقِ وعاشقوهُ","لهمْ قممٌ العراقِ..لهمْ سفوحُ",65,"ح",1,0],["هما هما رسل المنايا لنا","فيا أخا العشق النجاة النجاه",66,"ا",2,0],["هُمْ أهْلُ فُلْكٍ أُعِيْبَتْ ما لَهُمْ أملٌ","مِنَ الطُّغاةِ، بدا في عَيْبِها نِعَمُ",67,"م",1,0],["هُمْ أهل ودّي لم يزالوا نوّما","ما استشعروا عبَقا ولا تهليلا",68,"ل",2,0],["هم أهلنا مهما تكدر صفونا","فعلام يقسو بعضنا ويلوم",69,"م",1,1]]}