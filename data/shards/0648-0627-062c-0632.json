{"poems":[[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[44,"وعوراء أهداها امرؤ من عشيرتي","https://www.aldiwan.net/poem50329.html","الطويل"],[74,"قاسي الجوانح لين الأعطاف","https://www.aldiwan.net/poem19257.html","الكامل"],[53,"زارت على غفلة من الحرس","https://www.aldiwan.net/poem64675.html","المنسرح"],[40,"تهانفت واستبكاك رسم المنازل","https://www.aldiwan.net/poem7740.html","الطويل"],[87,"العلم والبر هذا مهرجانهما","https://www.aldiwan.net/poem7124.html","البسيط"],[45,"لا خيل عندك تهديها ولا مال","https://www.aldiwan.net/poem10136.html","البسيط"],[107,"ربنا إنا اهتدينا","https://www.aldiwan.net/poem42083.html","مجزوء الرمل"],[48,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[4,"","https://poetry.dctabudhabi.ae/diwan/poem/2401","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[108,"هو ليلاي","https://www.poetsgate.com/ViewPoem.aspx?id=179378",""],[96,"الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=13789",""],[203,"مري علينا يا صبا نجد","https://www.aldiwan.net/poem45612.html","أحذ الكامل"],[242,"فموت أبي يا رب أحرق فجعها","https://www.aldiwan.net/poem18158.html","الطويل"],[242,"لقد حمل الرائس المرتضى","https://www.aldiwan.net/poem19715.html","المتقارب"],[276,"أنبي دونك عبرتي وتنهدي","https://www.aldiwan.net/poem52087.html","الكامل"],[276,"أعلمت من ركب البراق عتيما","https://www.aldiwan.net/poem52097.html","الكامل"],[276,"يا صاحب القبر المقيم بيثرب","https://www.aldiwan.net/poem52121.html","الكامل"],[280,"من الملك المحيا في الرواق","https://www.aldiwan.net/poem25475.html","الوافر"],[331,"بقاء الدين والدنيا جميعا","https://www.aldiwan.net/poem44275.html","الوافر"],[369,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60658.html","المتقارب"],[409,"مهجة طول التنائي قد براها","https://www.aldiwan.net/poem33362.html","الرمل"],[422,"أتراك تعرف علتي وشفائي","https://www.aldiwan.net/poem54187.html","الكامل"],[443,"سعاد اسعدي بالطيف بعد التفرق","https://www.aldiwan.net/poem2554.html","الطويل"],[458,"هيا إلى السماء هيا","https://www.aldiwan.net/poem61573.html","مجزوء الخفيف"],[469,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87117","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86977","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87106","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86970","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86594","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86707","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87164","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70798","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59414","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59082","الدوبيت"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59435","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59423","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59419","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59428","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59148","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96713","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56581","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112829","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84506","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64552","الخفيف"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21693","الكامل"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45380","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118440","الطويل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123153","السريع"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110347","الكامل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177822","الخفيف"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177819","الكامل"],[2172,"","https://poetry.dctabudhabi.ae/diwan/poem/18699","المتقارب"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53170","الطويل"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121923","الطويل"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121142","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94321","الرجز"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104674","الوافر"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134204","الطويل"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67587","المتقارب"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65124","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48457","الكامل"],[3549,"","https://poetry.dctabudhabi.ae/diwan/poem/200338","الطويل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66484","الخفيف"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125960","الطويل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118778","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92207","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92007","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91900","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131008",""],[3884,"","https://poetry.dctabudhabi.ae/diwan/poem/142888","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123486","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123491","الخفيف"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45144","البسيط"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123465","البسيط"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67667","المتقارب"],[4717,"مرثية الدكتور أحمد زويل","https://www.poetsgate.com/ViewPoem.aspx?id=199624",""],[4852,"رمضان أقبل","https://www.poetsgate.com/ViewPoem.aspx?id=214374",""],[5150,"ارحلْ ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203386",""],[5271,"الى/ لئيمة","https://www.poetsgate.com/ViewPoem.aspx?id=67533",""],[5596,"تحية الى العيينة واهلها","https://www.poetsgate.com/ViewPoem.aspx?id=206718",""],[5691,"يوم يُبعثون","https://www.poetsgate.com/ViewPoem.aspx?id=206744",""],[5694,"البيعة","https://www.poetsgate.com/ViewPoem.aspx?id=129888",""],[5704,"هيداء","https://www.poetsgate.com/ViewPoem.aspx?id=191600",""],[4623,"حدثوني حديث من أهواه ( المدئح )","https://www.poetsgate.com/ViewPoem.aspx?id=146685",""],[5804,"التحدّي","https://www.poetsgate.com/ViewPoem.aspx?id=190658",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5845,"ياصاحبَ القبرِ المنيرِ بيثربِ","https://www.poetsgate.com/ViewPoem.aspx?id=16605",""],[5897,"يا عيد .. ماذا عن غزة ؟","https://www.poetsgate.com/ViewPoem.aspx?id=174865",""],[5956,"مملكتي زجاج","https://www.poetsgate.com/ViewPoem.aspx?id=182186",""],[5956,"اتّق شرّ من أحسنت إليه","https://www.poetsgate.com/ViewPoem.aspx?id=192409",""]],"verses":[["وَأَجِزِ الْمُسِيءَ إِذَا أَسَاء بِفِعِلْهِ","وَالْمُحْسِنَ الْحُسْنَى جَزَاءً يَعْدِلُ",0,"ل",1,0],["وَأَجزيهِ بِالحُسنى وَأَغفِرُ ذَنبَهُ","إِليَّ وَلا أَجزي بسَيِّئَةٍ مِثلا",1,"ل",2,0],["وأجزت باب قرى عوائد نحوه","أن لا يجوز لديه حذف مضاف",2,"ف",1,0],["واجز مُحبِّيك بالوصال ولا","تَطْغَ وفيهم للأجرِ فالتمس",3,"س",1,0],["وَأَجزَأتَ أَمرَ العالَمينَ وَلَم يَكُن","لِيُجزِئَ إِلّا كامِلٌ وَاِبنَ كامِلِ",4,"ل",1,0],["واجز الجزيل من المجهود تكرمة","واجز الجزيل من الموهوب شكرانا",5,"ن",2,0],["وَاِجزِ الأَميرَ الَّذي نُعماهُ فاجِئَةٌ","بِغَيرِ قَولِ وَنُعمى الناسِ أَقوالُ",6,"ل",1,0],["واجْزِ خَيراً كُلَّ حُرِّ","صادقِ الإِيمانِ بَرِّ",7,"ر",1,0],["وَأَجزاءُ تِرياقِهِم لا تَتِمُّ","إِلّا بِجُزءٍ مِنَ الأُفعُوانِ",8,"ن",1,0],["وَأَجزي القُروضَ وَفاءً بِها","بِبُؤسى بَئيساً وَنُعمى نَعيما",9,"م",2,0],["وَأَجْزِيكَ عَنْ عُمْرٍ إِليَّ أَعَدْتَهُ","بِحُبِّي وَإِخْلاَصِي عَلَى العُمْرِ أَجْمَعِ",10,"ع",1,0],["وأَجِزْني بمنحةٍ، وتذكَّرْ","أَننا في الشتاءِ، فصلِ المعونة",11,"ن",2,0],["وأجزع إن مرّت به الرّيح زعزعا","وأسرف حتّى جاوز الغاية القطر",12,"ر",1,0],["واجزع على قربِ الديارِ فقد","صبرتْ اوانسها على بعدي",13,"د",2,0],["وَأَجْزِلْ قِرَاهُ إِنَّ عَبْدَكَ جَائِعٌ","لِفَضْلِكَ يَا مَنْ لاَ يَضِنُّ عَلَى الْعَبْدِ",14,"د",1,0],["وَأَجْزِلْ قِرَاهُ بِمَا قَدْ قَرَا","كِتَابَكَ لِلْمُعْتَفِينَ الْجُلُوسْ",15,"س",1,0],["وأجز بها عبد الرَحيم براءة","من حر نار جهنم المتوقد",16,"د",1,0],["وأجز حروف قصائدي بمقاصدي","وَتول نصرى ظالما مَظلوما",17,"م",2,0],["وأَجز بها عَبد الرَحيم كَرامة","الدارين خير جَزاء نظم معرب",18,"ب",1,0],["وَأَجْزَلْتَ المَوَاهِبَ والأيَادِي","وأتْرَعْتَ السِّجَالَ إلَى العَرَاقِي",19,"ق",2,0],["وَأَجزَلُ ما يَكونُ الدَهرُ رَأياً","إِذا عَمِيَ المُشاوَرُ وَالمُشيرُ",20,"ر",1,0],["وأجزاؤها كجُفونِ العيونِ","لهنّ عنِ النَّوْرِ فَتْحٌ وضَمّ",21,"م",1,0],["وأجز نظمي بنظم إن في","نظمك العذب لنفسي مشتهاها",22,"ا",3,0],["وأجزْ عبيدك في رضاك فإنه","وأبيك غايةُ مطلبي ورجائي",23,"ا",2,0],["وأجزلت لي النعماء حقا وإنني","غدوت بجيد من نداك مطوّق",24,"ق",1,0],["وأجز تركنا حمانا","فهو مثوى لنا حقير",25,"ر",1,0],["وأجزتم أن يؤخذ الجار بالجار","إلى أن عذَّبتم الأجساما",26,"م",2,0],["وَأجزه جائزةَ الرضا فَهِيَ الَّتي","يَسمو بِها فَوقَ السماك منادم",27,"م",1,0],["وَأَجز فتاك عَلى المَديح قبوله","فَهُوَ المرام وَعَنهُ لا أَتخلف",28,"ف",1,0],["وَأجزني إِن تَشأ منك الرضا","عَن قَصيد ليد العليا لَثَم",29,"م",1,0],["وَأَجزه بِالتَقليد مِن","مَلك رَؤف يَعطف",30,"ف",1,0],["وَأَجزني عَنها دَوام ودادٍ","لَم تغيره غابراتُ الحَقائب",31,"ب",1,0],["وَأَجز عَلى الإِخلاص منهُ قبوله","برضاك عَنهُ في التقاء قصيد",32,"د",1,0],["وَأَجز فتاك عَلى المَديح قبولَه","فَهُوَ الكِفايةُ وَالثَوابُ الراهن",33,"ن",1,0],["واجْزهم في الأخرى بجناتِ عدنٍ","واصرفنْ عنهمُ عذابَ النار",34,"ر",1,0],["وأجزل ثوابي يا جواد وجد","فضلا فإن الفضل شأن الكرام",35,"م",1,0],["وَاجْزِلْ صِلَتِي وَمُنَّ بِالرّضْوَانِ","وَارْحَمْ قَلَقِي",36,"ي",1,1],["واجزل ثوابي وأحمني","من نافثات العقد",37,"د",1,0],["واجزل ثوابي وارحم والدي ولا","تخزيهما يا ملاذي بالذي اقترفا",38,"ف",2,0],["واجزم بحر جداول قد سوغت","رفع الغصون على انتصاب أرفع",39,"ع",1,0],["واجزل ثوابي وأوف ديني واعف عن","خطئي وعن حطاي وعن إفلاس",40,"س",1,0],["وَأجِزْ مَدِيح ابن الخلوف ووفِّه","مَا يَرْتَجِيهِ وأوْلِهِ حُسْن النَّظَرْ",41,"ر",1,0],["وَأجزت فيما يَرتَضي قتلي له","فغدوت في نفسي بذلكَ آثِما",42,"م",2,0],["وأجزل من حباك الملك شكراً","فقد رحم البلاد بما حباكا",43,"ك",2,0],["واجزل احسانا جميلا بهم لنا","وقربنا منهم وبالفيض حفنا",44,"ن",2,0],["واجزم مضارعا بخمس نهي","أمرٍ وشرط وجواب نفي",45,"ي",1,0],["واجزم بإن فعلين أو بإذ ما","حرفا على خلف يخصّ الجزما",45,"م",2,0],["واجزم جواب الشرط في فعلين","موافقين أو مخالفين",45,"ن",1,0],["واجزم أو انصب إثر ذين فعلا","قد حلّ بين الجملتين فصلا",45,"ل",2,0],["وأجزم جوابا جاء لاسم الفعل","ومنه صه يحسن اليك بعلي",45,"ي",1,0],["وأجزل الله بالقرآن قسمته","فضلاً ولا سيّما في الحجر بالقسم",46,"م",1,0],["وأجزني رفداً تصون به وج","هي عن الخلق عاجلاً فوق سؤلي",47,"ل",2,0],["وأجزه خير ما جزيت رسولاً","من عظيم الرضا وحسن التولي",47,"ل",2,0],["وَاِجزِ الكَرامَةَ مَن تَرى أَن لَو لَهُ","يَوماً بَذَلتَ كَرامَةً لِجَزاكَها",48,"ك",3,0],["وَأَجزَرَت سَيفَ أَشقاها أَبا حَسَنٍ","وَأَمكَنَت مِن حُسَينٍ راحَتي شَمِرِ",49,"ر",1,0],["واجزاءه فيها الحروف تكررت","ثلاثا ثلاثا في اوئلها تبدو",50,"د",2,0],["واجزم برفع الكسر مهما بدت","مائدة قد نصبتها كرام",51,"م",1,0],["وأجزت للرواد روضك نجعة","وتركت وردك شرعة الوراد",52,"د",1,0],["وأجزني على الصراط برحمي","منك أنجو بها ويسر حسابي",53,"ب",2,0],["وأجزته ما صح عني عنده","فليروه لرواية وردية",54,"ه",1,0],["وَأَجزي القُروضَ وَفاءً بِها","بِبُؤسى بَئيس وَنُعمى نَعيما",55,"م",2,0],["وأجزلهم جوداً وأطولهم علاً","وأصلبهم عوداً وأطيبهم أصلا",56,"ل",2,0],["واجزل لمثلى فى مهم يهمه","عطاك فلا عذر لمثلك عن مثلى",57,"ل",2,0],["وأجِز عنّا راحلاً لم","يال في الاصلاح جهدا",58,"د",2,0],["واجزم بأن الذنب دون الشرك","لا يوجب الكفر بغير شك",59,"ك",1,0],["وَإِجزالُ العَطاءِ بِما حَوَتهُ","بِحُكمِكَ فاقضِ فيها ما تَشاءُ",60,"ا",2,0],["واجزل لهذا الجمع عفوك والرضا","وباقي ذوي الإيمان من راح أو غدا",61,"د",2,0],["وأجزي القُروضَ بأمثالِها","فبالخيرِ خَيراً وبالشرِّ شرْ",62,"ر",1,0],["وأجزا بتفريق النّضارُ عُفاتهُ","فأعظم بمال من تفرّقُه أجزا",63,"ز",2,0],["وأجِزْ إليْها المُنْشآت كأنّها","نُجُبٌ تُواصِلُ للنجاةِ نَجاءَها",64,"ا",3,0],["وأجزي بما أسدا من الخير مالكا","أكافي ذوي الأحساب والفضل بالفضل",65,"ل",1,0],["واجزِم بِتَسكِينٍ وَغَيرُ ما ذُكِر","يَنُوبُ نَحو جَا أخُو بَنِي",66,"ي",1,0],["وَاجزِم بِإنَّ وَمَن وَمَا وَمَهمَا","أىٌّ مَتَى أيَّانَ أينَ إذ مَا",66,"م",2,0],["وَأجزَان تَجُرَّهُ مِن مُضمَرَا","إن وَلِيَت كم حَرفَ جَرٍّ مُظهَرا",66,"ر",2,0],["واجزني عنها بدائع نظمٍ","أحكمت قالب السنا افراغه",67,"غ",2,0],["وأجزع من صرف الزمان وغدره","وما كنت تلقاء الخطوب يجازع",68,"ع",1,0],["واجزم لها بحذف حرف العِلةِ","مع بقاء حركات اللفظةِ",69,"ه",1,0],["واجزم بأنَّ الجهل يخفض ربَّه","والفضل ينصب ذا الكمال ويَرفعُ",70,"ع",1,0],["وَاجزع أو اصبر كُل ذَلِكَ باطلٌ","لا بد يذهب للثرى من جاؤا",71,"ا",2,0],["وَاجزم بِلا عَدم الوُجود وَإِنَّما","قل بانعدام الشَيء ما لم يُوجد",72,"د",1,0],["واجزلتم للذائدين عطاءكم","فكنتم ذوي عطف وكانوا ذوي شكر",73,"ر",1,0],["واجزل مثوبة إخوةٍ ما فيهمُ","من عاجزٍ وانٍ ولا متخلفِ",74,"ف",1,0],["وأجزمديحي في المعاد شفاعة","حيث القلوب تذوب بالحسرات",75,"ت",1,0],["وأجزنى شفاعة وأجرنى","حيث تنبو شفاعة الشفعاء",76,"ا",2,0],["وأجز مدحة الحميدى قبولا","وأجرنى اذا اللظى زاد لحفا",77,"ح",3,0],["وَأجزِلُ الفَضلَ وَالعَطايا","مِن كُلِّ ما يَطلُبُ الأَريبُ",78,"ب",1,0],["وأجزلَ الفضلَ للجمِّ الغفيرِ بها","فكانَ لِلحمد والشُّكران مُكتسِبا",79,"ب",2,0],["وأجزي القروضَ بأمثالها","فخيراً بخيْر وشرّاً بِشَرْ",80,"ر",1,0],["وأجزلْ فى عطائك يا جمومُ","فرَبُّ العلمِ ربَّانٌ أصيلُ",81,"ل",1,0],["واجزِلْ عطاءً .. فالرجاءُ براءةً","إنَّ القنوطَ يكادُ يفتِكَ بالصِّبا",82,"ب",2,0],["واجزمْ متى تنوي فأمْ","رُك إن جزمتَه حاصلُ",83,"ل",1,0],["وِأَجزتِ قَتلي بَعْدَما شَحبَ الهوى","فَعَلَامَ أَبقى في هَواكِ مُغَرِدَا",84,"د",2,0],["وأجزلي الختم سُقياً ب(المُدَيْرة) من","صافي رواكِ روابيها وواديها",85,"ي",3,0],["واجْزني خيْرَ جزاءٍ أمُلَتْ","فيهِ نفْ