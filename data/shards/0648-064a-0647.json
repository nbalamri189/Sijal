ما من بني حوا خليل محالم","https://www.aldiwan.net/poem14383.html","الطويل"],[451,"أمودعي من قبل أن يلقاني","https://www.aldiwan.net/poem61317.html","الكامل"],[459,"وفتيان صدق من تميم تناثلوا","https://www.aldiwan.net/poem15083.html","الطويل"],[459,"إذا ما غزوتم معلمين فراوحوا","https://www.aldiwan.net/poem15096.html","الطويل"],[459,"يرش كثيف الدجن حينا وتارة","https://www.aldiwan.net/poem15371.html","الطويل"],[459,"لقد علم الأحياء دان ونازح","https://www.aldiwan.net/poem15399.html","الطويل"],[459,"عضد الدين مشار ال","https://www.aldiwan.net/poem15407.html","مجزوء الرمل"],[459,"يمل هواه كل سرج وسابح","https://www.aldiwan.net/poem15449.html","الطويل"],[459,"تتيه به الأيام فخرا وغبطة","https://www.aldiwan.net/poem16121.html","الطويل"],[459,"سألت إله العرش رب محمد","https://www.aldiwan.net/poem16158.html","الطويل"],[459,"لتهن قصور المجد زيدت جلالة","https://www.aldiwan.net/poem16249.html","الطويل"],[462,"نسيم الصبا والليل منتظم العقد","https://www.aldiwan.net/poem3176.html","عموديه"],[462,"وجدي كوجدك بالظباء الغيد","https://www.aldiwan.net/poem3208.html","عموديه"],[462,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"],[468,"سيهلك يا سلمى شفيق عليكم","https://www.aldiwan.net/poem4791.html","الطويل"],[527,"ليهنكم دار المسرة إنها","https://www.aldiwan.net/poem37313.html","الطويل"],[549,"دعوا اليوم ما عودتم من تصبر","https://www.aldiwan.net/poem47699.html","الطويل"],[549,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[556,"أتعبتني بقر الشام","https://www.aldiwan.net/poem34182.html","المديد"],[574,"إلى كل قوم سلم يرتقى به","https://www.aldiwan.net/poem1807.html","الطويل"],[583,"لقد سمح الدهر بالمقترح","https://www.aldiwan.net/poem1571.html",""],[584,"بلا غيبة للبدر وجهك أجمل","https://www.aldiwan.net/poem18010.html","الطويل"],[585,"لك الحمد اللهم يا ذا الحامد","https://www.aldiwan.net/poem11497.html","عموديه"]],"verses":[["وَيَهماءَ بِالقَيظِ مَحجوبَةٍ","تُطالِعُنا في هُبوبِ السَهامِ",0,"م",1,0],["وَيَهجُرونَ إِذا جَدَّت عَزائِمُهُم","دُنيا تَلاعَبُ بِالغُرِّ المَجاويدِ",1,"د",1,0],["ويَهْوى مُلوكُ الأرضِ أن يُمْدَحوا بِها","وما كُلُّ سَمْعٍ يرتَضيهِ كَلامي",2,"م",2,0],["ويهُزُّهُ نَغمُ الثّناءِ كأنّهُ","مُتَسَمِّعٌ هَزَجَ الغِناءِ رَخيما",3,"م",2,0],["ويهتَدي الطّيْفُ تُغويهِ غَياهِبُهُ","بكَوكَبٍ فُرَّ عنهُ الأفْقُ وهّاجِ",4,"ج",1,0],["ويَهفو بِعِطْفَيْهِ الثّناءُ كَما هَفا","نَزيفٌ يُغَنّيهِ الغَريضُ وعَثْعَثُ",5,"ث",1,0],["ويهْتَزُّ عِطْفُ المُلْكِ عندَ سَماعِها","كهزّة كفّيْكَ الحُسامَ اليَمانِيا",6,"ي",2,0],["ويَهْديكَ هَذا العِيدُ أسْعَدُ وافِدٍ","أتاكَ معَ النّصْرِ العَزيزِ على وعْدِ",7,"د",1,0],["ويَهْنِيكَ نَيْروزٌ سَعيدٌ قدِ انْقَضى","أتَتْكَ على آثارِهِ منْهُ أعْدادُ",8,"د",1,0],["وَيُهلِكُها حَتّى تَصيرَ تَفاهَةً","وَيَلحَقُها مِن كُلِّ غَيٍّ لَحوقُها",9,"ق",3,0],["وَيَهماءَ بِاللَيلِ غَطشى الفَلا","ةِ يُؤنِسُني صَوتُ فَيّادِها",10,"د",3,0],["وَيَهماءَ قَفرٍ تَخرُجُ العَينُ وَسطَها","وَتَلقى بِها بَيضَ النَعامِ تَرائِكا",11,"ك",2,0],["وَيَهماءَ تَعزِفُ جِنّانُها","مَناهِلُها آجِناتٌ سُدُم",12,"م",1,0],["وَيُهضَمُ حَقُّ الأَديبِ الأَريبِ","وَيُطمَسُ فَضلُ النَبيهِ الأَغَرّ",13,"ر",1,0],["وَيَهتِفُ بِاِسمِكَ أَبناؤُنا","إِذا آنَ لِلزَرعِ أَن يُحصَدا",14,"د",2,0],["وَيُهضِمُ فينا الإِمامُ الحَكيم","وَيُكرِمُ فينا الجَهولُ الغَبي",15,"ي",1,0],["وَيَهتاجُ قَصرُ الفارِسِيِّ صَبابَةً","لِقَلبِيَ لاتَألو زِنادَ الأَسى قَدحا",16,"ح",2,0],["وَيَهنيكَ أَنَّكَ يا سَيِّدي","غَدَوتَ مُقارِنَ ذاكَ الرَبَض",17,"ض",1,0],["وَيَهدَأُ تاراتٍ سَناهُ وَتارَةً","يَنوءُ كَتَعتابِ الكَسيرِ المَهيضِ",18,"ض",1,0],["وَيَهتَزُّ في الحَربِ عِندَ النِزالِ","كَما اِهتَزَّ ذو الرَونَقِ المِقطَعُ",19,"ع",1,0],["وَيَهُزُّهُ هَزَّ القَنَاةِ لِنَصْرِهِ","مُسْتَصْرِخٌ مِنْ قَوْمِهِ وَمَضِيمُ",20,"م",1,0],["وَيَهلِكُ بَينَها المَرَئِيُّ لَغواً","كَما أَلغَيتَ في الدّيَةِ الحوارا",21,"ر",2,0],["ويهدّوا ويرسل","ما له في الوجود مثال",22,"ل",1,0],["ويهنيك دون العيد عيدٌ شرعتَهُ","نبتُّ به في الخافقين التهانيا",23,"ي",2,0],["ويهني البنودَ الخافقاتِ فإنها","سيعقدها في ذمة النصر غازيا",23,"ي",2,0],["ويهفو فؤادي كلما هبّت الصِّبا","أما لفؤادي في هواك نصيرُ",24,"ر",1,0],["ويهمس في أذن الطبيعة جوّه","فيضحكها فوق الربا الخضر همسه",25,"س",2,0],["ويهُزّ الدنيا رجاء وخوفاً","بيدٍ من دِراية هزّازه",26,"ز",2,0],["ويهزم الجمع مجثّاً مكايده","بكا لعواصف هبّت تقلع الشجرا",27,"ر",2,0],["وَيَهدي القَومَ مُضطَلِعاً إِذا ما","رَئيسُ القَومِ بِالمَوماةِ حارا",28,"ر",2,0],["وَيهاً فِداؤُكُمُ أُمّي وَما وَلَدَت","حاموا عَلى مَجدِكُم وَاِكفوا مَنِ اِتَّكَلا",29,"ل",2,0],["وَيهاً فِدىً لَكُمُ أُمّي وَما وَلَدَت","قَد يَنفَعُ الصَبرُ في المَكروهِ أَحيانا",30,"ن",2,0],["وَيَهنِ بَني كَعبٍ مَكانُ فَتاتِهِم","وَمَقعَدُها لِلمُسلِمينَ بِمَرصَدِ",31,"د",1,0],["ويهنِ الليالي أن فيها لواصف","جمالاً به يخفى ويعفى قبيحها",32,"ح",3,0],["ويهتزّ للجدوى وما هزّ مهده","به وتناغى بالهبات وفوده",33,"د",2,0],["ويهتز للذكر الجميل كأنه","وحاشا بقاه قد تناول مسكرا",34,"ر",2,0],["ويهزُّ حلو قوامها مرج الصبا","هزَّ الكماة عواليَ المرَّان",35,"ن",1,0],["ويهمس المولى إلى عبدِهِ","قَلْنِسْهُ بالصفْعِ ولا تَرهبِ",36,"ب",1,0],["وَيَهُزُّ كلُّ مُبَلَّدٍ أَعْطافَه","طَرَباً كفعل الشَّارب المِرِّيحِ",37,"ح",1,0],["ويهوي إليه كل قلبٍ بُودهِ","هُوِيّ القُطاميِّ الغريب إلى الوكر",38,"ر",1,0],["ويَهنيك أنْ لم يبقَ مجدٌ ترومُهُ","يداك وأن لم تبق كف تُنافسه",39,"س",2,0],["ويهتدي عامِهُ السيوف به","من هام قوم إلى مفارقها",40,"ق",3,0],["ويَهنيك أن أصبحتَ دنيا وجنةً","فأصبحتِ الدنيا بدنياك تختالُ",41,"ل",1,0],["وَيَهتِفُ بَِلقَصائِدِ وَالأَغاني","وَقَد ذَهَبَ الرَدى بِالمُنشِدينا",42,"ن",2,0],["وَيَهُزُّني الغَزَلُ الرَقي","قُ إِذا تَجَنَّبَهُ قَبيحُه",43,"ح",2,0],["وَيَهُزُّني كَأسُ المُدا","مَةِ في يَدِ الرَشإِ الرَبيبِ",44,"ب",1,0],["وَيَهدي إِلَيكَ الناسُ دونَ تَصَنُّعٍ","مَحَبَّةَ صِدقٍ لَم يَشُبها كِذابُ",45,"ب",1,0],["ويهزم الضلالة","ويحطِم القيود",46,"د",1,0],["ويهز عطفيه الزمان ويزدهى","بأغر فيه محجل الآثار",47,"ر",1,0],["وَيَهُزُّ مِنّي الماءُ في لَمَعانِهِ","فَأَميلُ أَنظُرُ فيهِ أَطمَعُ أَن أَرى",48,"ر",2,0],["وَيُهينونَ صاحِبَ الروحِ مَيتاً","وَيُعِزّونَ بَعدَهُ أَكفانَه",49,"ن",2,0],["وَيَهُدّونَ بِالتِلاوَةِ وَالصُل","بانِ ما شادَ بِالقَنا البَنّاءُ",50,"ا",2,0],["وَيَهدَأَ ذا السَحابُ فَقَد شَكَكنا","أَتَغلِبُ أَم حَياهُ لَكُم قَبيلُ",51,"ل",1,0],["وَيُهِمُّ فيكَ إِذا نَطَقتَ فَصاحَةً","مِن كُلِّ عُضوٍ مِنكَ أَن يَتَكَلَّما",52,"م",2,0],["وَيَهيجُني أَلّا يَزالَ يَزورُني","مِنها خَيالٌ ما يُغَبُّ مُطيفُهُ",53,"ف",2,0],["ويهزها سكران سكر","شرابها وشبابها",54,"ب",3,0],["وَيَهديهِ هادٍ مِن دَلالَةِ مَعْطِسٍ","إلى ما عليه من ظلامِ الفلا خالُ",55,"ل",1,0],["وَيُهدي إليكَ البحرُ درَّ مغاصِهِ","وإن لم تقفْ على طَرَفِ العبرِ",56,"ر",1,0],["وَيَهيجُ بي وَجَعٌ وَعِلَّتُهُ","سَقَمٌ بِطَرفِكَ إنَّ ذا سحرُ",57,"ر",1,0],["وَيَهيجُني نَفَسُ النَسيمِ إِذا سَرى","وَيَشوقُني فيكَ الحَمامُ الأَورَقُ",58,"ق",1,0],["وَيَهجُرُ في اللَهِ حَتّى الكَرى","وَيَألَفُ في اللَهِ حَتّى نَعَم",59,"م",1,0],["وَيَهتَزُّ لِلضَيفِ خُدّامُهُ","وَتُعدي سَجايا المَوالي الخَدَم",59,"م",1,0],["ويُهيبُ باللّاهينَ من أبنائِه","يَخْشَى عليهم حَسْرَةَ المُتَنَدِّمِ",60,"م",1,0],["وَيُهدي مِن خَدِّهِ التَوريد","عَقيقاً يُصاغُ مِن دُرَّه",61,"ه",1,0],["وَيَهفو فَيَهفو القَلبُ عِندَ اِنعِطافِهِ","فَهَلّا رَأى في العَطفِ سُنَّةَ مُقتَدِ",62,"د",1,0],["وَيَهب النَسيم في السحر الداكن","يحيي مِن الزهور تِلالا",63,"ل",2,0],["وَيَهُزُّ أَجنِحَةَ النَبا","تِ نَسيمُهُ وَيَحُنُّ زَهوا",64,"و",2,0],["وَيَهُزّونَ كُلَّ أَخضَرَ كَالبَق","لَةِ ماضٍ عَلى الفُلولِ رَسوبِ",65,"ب",1,0],["ويَهْدي الدليلُ القوْمَ والليلُ مُظلِمٌ","ولكنّه بالنّجمِ يَهْدي ويَهْتَدي",66,"د",2,0],["وَيُهِلُّ وَفْدُ البيتِ إنْ بَصُرُوا بها","والحُكْمُ إلاّ بالحصى مَتْرُوك",67,"ك",1,0],["وَيَهتَزُّ مِن تَحتِ الثِيابِ قَوامُها","كَما اِهتَزَّ غُصنُ البانِ وَالفَنَنُ النَضرُ",68,"ر",1,0],["ويهتاجُ منه كُلُّ ما كانَ ساكناً","دعاءُ حمامٍ لم يبِتْ بوُكونِ",69,"ن",1,0],["وَيَهْنِئْ رَبَّ وَادِي النِّيلِ فِيهَا","مَكَانُ تَجِلَّةٍ وَخُلُودُ ذِكْرِ",70,"ر",1,0],["وَيَهدَّ الكهْلُ هَدَّ الفَحْلِ فِي","غَرَقٍ وَالوَقْدُ لاَ يَأْلُوهُ هَدْرَا",71,"ر",2,0],["وَيَهُبُّ آناً سَائِراً","فِي الجَوِّ مُخْتَلَفَ المَسِيرْ",72,"ر",1,0],["ويهي الطير ولما تزل","وإذا ما سعروها في الدجى",73,"ج",2,0],["وَيُهدي إِليّ الدرّ مِن فيهِ حِكمَةً","وَيوري عَليّ النارَ مِن لبّهِ لَذعا",74,"ع",2,0],["ويهونُ عَلَيهِم شَحطُ نَوىً","يُطْوَى بِحَديثكَ فَدْفَدُهُ",75,"د",2,0],["ويهنِّئُّون النِّيل والْ","هَرَمَيْن بالعَهدْ الجديد",76,"د",1,0],["ويَهْمِسُ آخرون: لقد شَططْنا","متى ضاقتْ بأَهليها الدِّيار؟",77,"ر",1,0],["ويهتز عطف الملك عند سماعها","كهزة كفيك الجسام اليمانيا",78,"ي",2,0],["ويهنيك هذا العيد أسعد وافد","أتاك مع النصر العزيز على وعد",79,"د",1,0],["ويهوي كما يرتمي في الصخور","قتيل على كتفيه ... مصاب",80,"ب",1,0],["ويهْتِفُ بالنَّفَر المُهطِعين","أهينِوا لِئامكمُ تُكْرمَوا",81,"م",3,0],["ويهدأ تاراتٍ وتارة","ً ينوءُ كتعتاب الكسير المهيض",82,"ض",1,0],["وَيَهْتاجُ قصرُ الفارسيّ صبابة ً،","لقلبيَ، لا تألُوا زِنادَ الأسَى قدْحا",83,"ح",2,0],["ويهدي إليكَ البحرُ دُرَّ مغاصِهِ","وإنْ لم تَقِفْ منه على طرفِ العبر",84,"ر",1,0],["ويهتف بالقصائد والأغاني","وقد ذهب الردى بالمنشدينا",85,"ن",2,0],["وَيَهُدُّني أَلمي فأنْشُدُ راحَتي","في بِضْعِ آياتٍ مِنَ القُرآنِ",86,"ن",1,0],["وَيَهزنا شَرخ الصِبا فَتَخالنا","بيض المَواضي في أَكُف الصَيد",87,"د",1,0],["وَيَهمي بِهِ قَطر النَدا فَتَخالَهُ","مُبَدد عقد في فِراش زمرد",88,"د",1,0],["ويهدأ بالوصال قريح طرف","عليه النوم يا علوى حرام",89,"م",1,0],["ويهضم حقي من كسته عوارفي","رداء المعالي فهو غير اديب",90,"ب",1,0],["ويهواك القريبُ وكل قاصٍ","كأن هواك بالأهواءِ شيبَا",91,"ب",2,0],["ويُهَنِّي جميع الناسِ أنك سالمٌ","وتَهْنَى بما أُوتيته مِن مناقِبِ",92,"ب",1,0],["ويهجو الصالحين وهم سجود","لرب العرش أوجههم وِسَام",93,"م",1,0],["ويهوى لقاءَ الموتِ لما أضافهُ","إلى نوبٍ تنتابُهُ وهي ألوانُ",94,"ن",1,0],["ويهتزُّ عند هبوبِ السؤال اه","تزازَ الأراكةِ بالجِريباءِ",95,"ا",2,0],["ويهمى سحاب اليمن بالأمن والهنا","علينا بمحض الفضل في كل برهة",96,"ه",1,0],["ويهوى على واستهوى البرد","لأني كما علمت وحيد",97,"د",1,0],["ويهين سائله اللئيم لظنه","في مثله خيراً وذلك لا يظنْ",98,"ن",1,0],["ويهني امرء أولاك فوزاً بما يجب","ينال الفتى أقصى المراتب والعليا",99,"ي",2,0],["ويهنى الرعايا النوم في ظل عدله","لقد مده من جنة فوقهم ظلا",100,"ل",2,0],["ويهدى إليها من أضل سبيلها","ويحفظ من أشراطها ما يضيع",101,"ع",1,0],["ويهنيك أن الله راض وخلقه","وأن لك البشرى وأن لك العفوا",102,"و",2,0],["وَيهنيكَ ذا المُلكُ الَّذي عَمَّ يُمنُهُ","عُقَيلاً وَأَحيا عَبدَ قَيسٍ وَوائِلا",103,"ل",2,0],["ويهزني مرحُ الشبابِ بها","هزَّ القَضيب اللَّدْن مُنعطِفا",104,"ف",2,0],["ويَهيج شوقَك للأحبةِ شكلُها","كُثبٌ تَميس على ذُراها البان",105,"ن",1,0],["ويهينه المعشوق بين دلاله","متمنّعا وينيله استحقاقه",106,"ق",2,0],["ويهجى بعدما يذوي ذبولا","ويلقى في المزابل والكنيف",107,"ف",1,0],["ويهز غصن البان منك على النقا","ما لي الى احد سواك تشوف",108,"ف",1,0],["ويهتز من وجد إذا نفس الصبا","سحيراً بأعطاف الخزامى تحرشا",109,"ش",2,0],["ويهب القبول من جوه الرح","ب لمستوحش بروح وأنس",110,"س",1,0],["ويهزه طرب إذا ذكر الحمى","هز الشمول شمائل النشوان",111,"ن",1,0],["وَيُهَوِّنُ البوسى عَلَيَّ إِذا وَهى","جَلَدي بِما أَنّي أُلاقي الأَنعُما",112,"م",2,0],["وَيَهُزُّ قَدّاً كَالقَناةِ لِحاظُهُ","لِمُحِبِّهِ مِنها مَكانَ العامِلِ",113,"ل",1,0],["وَيَهْوَى أُنَاسٌ سَُلَِّمُوا هُمْ سَلاَمَتِي","وَأَنِّيَ دَهْرِي نَاعِمُ الْبَالِ مُخْصِبُ",114,"ب",1,0],["وَيَهَابُهُ مَنْ لمْ يَذُقْ","لِوِدَادِهِ طَعْماً فَيُرْعَدْ",115,"د",1,0],["وَيَهِجْ تَحَرُّقَ كُلِّ أوْغَدْ","فَيَحِنْ غَدَاةَ الْيَوْمِِ أَوْ غَدْ",115,"د",1,0],["ويهتزُّ للجدوى إذا ما مدحته","كما اهتزَّ حاشى وصفه شاربُ الخَمرِ",116,"ر",1,0],["وَيَهضمُ جانِبي وَاللَيثُ جاري","لَعمرِكَ أَنَّ ذا عَيبٌ عَليّه",117,"ه",1,0],["ويهتز المعافين حين سؤالهم","سروراً وما دارت عليه عقاره",118,"ر",2,0],["ويهزا لمديح عطفيه جوداً","مثلما اهتز شارب نشوان",119,"ن",1,0],["ويُهزِلُها الجَمَامُ إذا خَصِبنا","ويُدبِرُ ظَهرَهَا مَسُّ الجِلالِ",120,"ل",1,0],["وَيهب روح الانس من قبل الحمى","وارى خييمات الحمى وَتَراني",121,"ي",1,0],["وَيَهتَز ريحان القلوب لذكره","اذا ذكر اِرتاحَت قلوب وأكبد",122,"د",1,0],["ويَهُونُ ذَلِكَ لِلْفِراقِ وطَعْمِهِ","إنَّ الفِراق هُوَ الحِمامُ الثَّانِي",123,"ي",1,0],["وَيَهُزُّ مِنها خَطوُها في مَشيِها","حِقفاً بَديعَ اللينِ لَيسَ بِحاسِ",124,"س",1,0],["وَيَهُزُّ مُعتَلُّ النَسيمِ غُصونَهُ","فَيُرى المُعانِقُ فيهِ وَالمَهجورُ",125,"ر",1,0],["ويهجره بنوه الصيد","أهل المجد والكرم",126,"م",1,0],["ويهديه للحسنى ويختم له بها","وبالعمل المرضي الخالص المجدي",127,"ي",1,0],["ويهدأ وتسكن أشجانه","فإن به مثل ورى الزناد",128,"د",1,0],["وَيُهدي عَلى رَسمِ التودّدِ خلعةً","مَجيديّةً تَستَوثقُ العهدَ والشرطا",129,"ط",2,0],["وَيُهنيك أنّي لا أزالُ لوقعها","وَمن نزعها ألقى الأليم من الكربِ",130,"ب",1,0],["وَيَهماءُ يَجري آلُها فَوقَ أُكمِها","كَما فاضَ ماءٌ أَلبَسَ الأُكمَ غامِرُ",131,"ر",1,0],["ويهدي اولى التنعيم نحو نعيمهم","بأعمال صدق في رجاء وخشية",132,"ه",1,0],["ويهفو إلى الكأس إن عربدت","ويسجد للمرأة المشتهاه",133,"ه",1,0],["ويهزني شوقي إليك فانثني","متلهفاً والدمع ملء عيوني",134,"ي",1,0],["ويهزني امل جميل باسم","فاعود منه بصفقة المغبون",134,"ن",1,0],["ويهفو إليكِ وفي وده","تثير شجاهُ آهة ثانية",135,"ي",2,0],["ويهزك الشوق العظيم إلى اللقا","فتظل ترقص في حشاك طروبا",136,"ب",2,0],["وَيَهُزُّأَ عْطافَ الكِرامِ كأَنَّما","صُبِحُوا بِكاساتِ المُدامِ دِهَاقَا",137,"ق",2,1],["ويهلك الشركُ في أقصى مداخله","حتى يغيب فلا يُدرى له أثر",138,"ر",1,0],["وَيهنئني لِقاؤُكَ يا سُروراً","بِمَلقاه تُفارقني الهُمومُ",139,"م",1,0],["ويَهْدي الطّارقينَ إليه صِيتٌ","تَخالُ به على شَرَفٍ ضِراما",140,"م",2,0],["ويَهُزُّ جيداً كالقناةِ مُرنَّحاً","ويُديرُ سَمْعاً كالسّنانِ مُؤلَّلا",141,"ل",2,0],["ويَهُزُّ جِيداً كالقناةِ يَنوطُه","بحَديدِ أُذْنٍ كالسِّنانِ مُؤلَّل",142,"ل",1,0],["ويَهزُّ مَصقولَ الحديدةِ ماضياً","كوَميضِ بَرقٍ في الغمامةِ لامع",143,"ع",1,0],["وَيَهيجُني الإِلفانِ إِن طارا وَإِن","وقعا على فننٍ من الأفنانِ",144,"ن",1,0],["وَيَهُزُّني كَالغُصنِ خَمرُ غِنائِهِ","فَأَقولُ هَل غَنّاهُ أَو غَنّاني",145,"ي",1,0],["ويُهنَّى بِالعيدِ قَومٌ وإِنِّي","بِك هنَّيتُ عيدَهُم والمُصَلَّى",146,"ل",2,0],["ويهزُّ عِطفَيه كما","يهتزُّ بعد الريِّ عودُ",147,"د",1,0],["ويهزني طرباً كأن","نَ غبوقه عندي صبوحه",148,"ح",2,0],["وَيَهَتَزُّ مِن ذِكرى نَتيجة دَهرِهِ","مَتى انس التِذكار هَزَةَ نُشوان",149,"ن",1,0],["وَيَهوى الوَرد وَجنَتُهُ","فَيَهجر شَمهُ هَجري",150,"ي",1,0],["وَيَهز لِمح الطَرف عامل قَدهِ","هَزّ النَسائِمِ بانةُ الجَرعاءِ",151,"ا",2,0],["وَيَهجُر زاعِماً إِن ال","لقا ضَرب مِن الرَجس",152,"س",1,0],["ويهدينا صراطا مستقيما","به الخيرات والابريز والماس",153,"س",1,0],["ويهنيكَ ادّخاركَ خير كسْبٍ","إذا الجاني بمكسَبهِ رهينُ",154,"ن",1,0],["وَيَهرتُ في الطِلى أَشداقُ عنسٍ","تُحلَّب بِالدِماء بدل اللَغامِ",155,"م",1,0],["وَيَهماء يَهوي بَينَ أَورادها القطا","وَيوهي السُرى فيها قوى الضَيغَم الجَلدِ",156,"د",1,0],["ويَهيجُنِي بعد اندمالِ صَبَابَتِي","ورْقاءُ مادَ بِهَا قضيبٌ مُورِقُ",157,"ق",1,0],["ويهدي المضلَّ ويعطي المقلّ","ويرفع في البأس خطباً جسيما",158,"م",2,0],["ويهون الأَمر العظيمُ لديه","وحَرِيٌّ بمثلِهِ أنْ يهونا",159,"ن",2,0],["ويهوى المكرمات بكلِّ آنٍ","ولن نلقى به عنها ملالا",160,"ل",2,0],["ويهنيء رئاسة أرخوها","برشيدٍ زهت أيادي الرئاسه",161,"س",2,0],["ويَهُزُّ الرَّأْسَ حُمْقاً","هزَّ أَعطافِ الرُّدْينِي",162,"ن",2,0],["ويهزّه هزَجُ الصهيل كأنما","حكمتْ عليه القهوةُ الصّهباءُ",163,"ا",2,0],["ويهزُّ أغصانَ القدودِ كأنّهُ","كأسٌ عليها للمُدامِ تُدارُ",164,"ر",1,0],["ويَهْنِ المصلَّى تجلِّيكَ فِيهِ","بوجهٍ يُنيرُ وكفٍّ تَغِيمُ",165,"م",1,0],["ويَهِيجُهُمْ عِينٌ لَهُنَّ مرابِضٌ","ويَشُوقُهُمْ طَيرٌ لَهَا أَوْكارُ",166,"ر",1,0],["وَيهنيكِ يَا دَارَ الخِلافَةِ منهُما","هِلالانِ لاحا يَرْفَعَانِ منارَكِ",167,"ك",1,0],["وَيَهْنِيكَ شَهْرٌ عند ذي العرش شاهِدٌ","بأَنك بَرٌّ بالصيام وَصُولُ",168,"ل",1,0],["ويهزها من تحتنا","وعلى مطاها هزنا",169,"ن",2,0],["ويهملها إلا امرؤ ضل عاصياً","وأنى لها الإهمال وهي تمائم",170,"م",1,0],["ويهز آلاف المشاعر بعدما","ماتت من التغرير والبهتان",171,"ن",1,0],["ويهتزُّ للمعروف عندَ انْتدائه","تأَوُّدَ غُصنِ البانَة المُتتابعِ",172,"ع",1,0],["ويهتز من غير اغتباقِ مُدامةٍ","وخمر المعالي غير خمر النَّياطل",173,"ل",1,0],["ويهتزُّ للمعروفِ حتى كأنهُ","صفيحةُ نصلٍ أخلصتها الصَّياقل",174,"ل",1,0],["ويهتزُّ ضالُ القاعِ عند مرورهِ","وتقلقُ بالريفِ النَّخيلُ الكوارعُ",175,"ع",1,0],["ويُهَنَّى بكَ حتَّى","شَرَفُ الشَّهْرِ الحَرامِ",176,"م",1,0],["ويهمي نداهُ والسماءُ بخيلةٌ","فيكشف غمَّاء السنين البَوارقِ",177,"ق",1,0],["ويَهْتَزُّ للمعروفِ حتى كأنَّهُ","نَزيفُ مُدامٍ هَيَّجَتهُ المَعالمُ",178,"م",1,0],["ويهْدي سَناهُ الطَّارقين عَشيَّةً","إلى جودهِ من قَبْلِ نارٍ ومَوْقِدِ",179,"د",1,0],["ويهْتَزُّ للمعروفِ حتى كأنَّهُ","قَرا السَّيفِ مهزوزاً بيومِ لقاءِ",180,"ا",2,0],["ويهبُّ فيُهدي نشرَ لمياء موهناً","وأن كان منسوباً إلى البان والزند",181,"د",1,0],["ويهزّهُ شرخُ الشباب كذابلٍ","هزّتهُ راحةُ باسلٍ صنديد",182,"د",1,0],["ويهزُّ عطفيكَ الثناءُ","كأنْ سقيتَ من المدامه",183,"م",2,0],["وَيَهتَزُّ لِلمَعروفِ في طَلَبِ العُلا","لِتُحمَدَ يَوماً عِندَ سَلمى شَمائِلُه",184,"ل",2,0],["وَيَهْنِكُمُ بُسْتانُها فَهُوَ جَنَّةٌ","يُقَصِّرُ عَنْ أَوْصافِها الغُرِّ واصِفُ",185,"ف",1,0],["ويهدم ما شيّدتُهُ وبنيتُهُ","ويَحصُدُ من هذي الحياةِ زُروعي",186,"ي",1,0],["وَيَهونُ عِندي أَنْ تكون مُصَحَّحاً","وَمِنَ الضَّنى حِيكَتْ لجسمي أدرُعي",187,"ي",1,0],["ويهينوني ويحتقروا","علم تحقيقي وإلهامي",188,"ي",1,0],["وَيَهرُبُ مِنّا كُلُّ وَحشٍ وَيَنتَهي","إِلى وَحشِنا وَحشُ الفَلاةِ وَيَرتَعُ",189,"ع",1,0],["ويهتَزُّ عند اهتزاز الغصون","ويعجبه ظَبْيُ سِرْبٍ سَرَحْ",190,"ح",1,0],["وَيهْنَ امْتِداحي ابْنَ الأثيرِ فَمدْحُهُ","يُشرِّفهُ مُمْدوحُهُ ويُجمِّلُ",191,"ل",1,0],["ويهنيك يا شمس البلاد وبدرها","بلوغ المنى من كل باغ معاند",192,"د",1,0]]}