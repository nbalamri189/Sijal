{"poems":[[53,"هو الدهر فينا خليع اللجام","https://www.aldiwan.net/poem29771.html","المتقارب"],[53,"جري النسيم على ماء العناقيد","https://www.aldiwan.net/poem30625.html","البسيط"],[63,"من الركب يا بن العامري أمامي","https://www.aldiwan.net/poem46178.html","الطويل"],[63,"جهد الصبابة أن أكون ملوما","https://www.aldiwan.net/poem46195.html","الكامل"],[63,"النجم يبعد مرمى طرفه الساجي","https://www.aldiwan.net/poem46197.html","البسيط"],[63,"سرى والنسيم الرطب بالروض يعبث","https://www.aldiwan.net/poem46206.html","الطويل"],[77,"وجودك حي الملك والدين والدنيا","https://www.aldiwan.net/poem35717.html","الطويل"],[77,"دعاها تشم آثار نجد ففي نجد","https://www.aldiwan.net/poem36603.html","الطويل"],[77,"زمانك أفراح لدينا وأعياد","https://www.aldiwan.net/poem36614.html","الطويل"],[42,"إذا كنت تبغي للأمانة حاملا","https://www.aldiwan.net/poem50360.html","الطويل"],[9,"أجدك لم تغتمض ليلة","https://www.aldiwan.net/poem21928.html","المتقارب"],[9,"أتشفيك تيا أم تركت بدائكا","https://www.aldiwan.net/poem21961.html","الطويل"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[86,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[86,"سمعنا حديثاً كقطر الندى","https://www.aldiwan.net/poem10921.html","المتقارب"],[86,"حطمت اليراع فلا تعجبي","https://www.aldiwan.net/poem10923.html","المتقارب"],[73,"خليلي لا فطر يسر ولا أضحى","https://www.aldiwan.net/poem11843.html","الطويل"],[73,"أثرت هزبر الشرى إذ ربض","https://www.aldiwan.net/poem11911.html","المتقارب"],[0,"أعني على برق أراه وميضِ","https://www.aldiwan.net/poem54.html","الطويل"],[10,"أبى طول ليلي لا أهجع","https://www.aldiwan.net/poem21108.html","المتقارب"],[93,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[30,"نبت عيناك عن طلل بحزوى","https://www.aldiwan.net/poem29591.html","الوافر"],[83,"لو تروا حب ما اجمل","https://www.aldiwan.net/poem54199.html","الخفيف"],[83,"معاذ الهوى أن أصحب القلب ساليا","https://www.aldiwan.net/poem54225.html","الطويل"],[83,"ذروني فإني بالعلاء خبير","https://www.aldiwan.net/poem54303.html","الطويل"],[88,"أرى الحسن في لبنان أينع غرسه","https://www.aldiwan.net/poem44445.html","الطويل"],[88,"أن من حاز في العلوم إجازه","https://www.aldiwan.net/poem45000.html","الخفيف"],[88,"شب الأسى في قلوب الشعب مستعرا","https://www.aldiwan.net/poem45044.html","البسيط"],[4,"يذكرني بأربد كل خصم","https://www.aldiwan.net/poem21166.html","الوافر"],[11,"مهلا نوار أقلي اللوم والعذل","https://www.aldiwan.net/poem263.html",""],[23,"من سره الموت صرفا لا مزاج له","https://www.aldiwan.net/poem21252.html","البسيط"],[23,"لقد خاب قوم غاب عنهم نبيهم","https://www.aldiwan.net/poem21554.html","الطويل"],[72,"سقى عهدها داني العهاد سفوحها","https://www.aldiwan.net/poem18486.html","الطويل"],[72,"هلال بأفقالملك تزهى سعوده","https://www.aldiwan.net/poem18551.html","الطويل"],[72,"برغم العلى تاج تحلى به الثرى","https://www.aldiwan.net/poem18719.html","الطويل"],[72,"سلت صوارمها من الأجفان","https://www.aldiwan.net/poem20146.html","الكامل"],[51,"هل تعرف الدار بذي الأثأب","https://www.aldiwan.net/poem8512.html","السريع"],[51,"ما مدمعي حذر النوى بقريح","https://www.aldiwan.net/poem9403.html","الكامل"],[51,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[51,"ليهنك لبس المهرجان وإن غدا","https://www.aldiwan.net/poem64568.html","الطويل"],[51,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[51,"أبا حسن قد قلت لو كان فعال","https://www.aldiwan.net/poem65941.html","الطويل"],[91,"أباعثة المطايا من حديد","https://www.aldiwan.net/poem62788.html","عموديه"],[70,"أضنى الفؤاد فمن يريحه","https://www.aldiwan.net/poem42980.html","مجزوء الكامل"],[70,"رحل الشباب ولم أنل","https://www.aldiwan.net/poem43017.html","مجزوء الكامل"],[78,"ألا يا مليكا يرتجى ويهاب","https://www.aldiwan.net/poem14278.html","الطويل"],[85,"العز للإسلام","https://www.aldiwan.net/poem7104.html","مجزوء الرجز"],[85,"قالوا فرنسا أنذرت سلطاننا","https://www.aldiwan.net/poem7587.html","الكامل"],[85,"لا السهد يدنيني إليه ولا الكرى","https://www.aldiwan.net/poem63716.html","الطويل"],[85,"قف بروما وشاهد الأمر واشهد","https://www.aldiwan.net/poem63737.html","الخفيف"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[43,"رويدك أيها الملك الجليل","https://www.aldiwan.net/poem9757.html","الوافر"],[43,"كفي أراني ويك لومك ألوما","https://www.aldiwan.net/poem10530.html","الكامل"],[45,"شرخ الشباب أخو الصبا وأليفه","https://www.aldiwan.net/poem65161.html","الخفيف"],[61,"قامت وغصن البانة المياس","https://www.aldiwan.net/poem51386.html","مجزوء الكامل"],[80,"أجمل على بخل الغواني وإجمال","https://www.aldiwan.net/poem31339.html","الطويل"],[80,"تغنت قيان الورق في الورق الخضر","https://www.aldiwan.net/poem31443.html","الطويل"],[80,"هن الحسان وحربها الهجر","https://www.aldiwan.net/poem31452.html","أحذ الكامل"],[74,"أورى بأفقك بارق يتألق","https://www.aldiwan.net/poem13195.html","الكامل"],[74,"بذات المكارم ذاك الألم","https://www.aldiwan.net/poem13252.html","المتقارب"],[105,"أمم العروبة جاء يومك فاعلمي","https://www.aldiwan.net/poem41936.html","الكامل"],[81,"عميد أصيب عن عمد","https://www.aldiwan.net/poem61406.html","الطويل"],[81,"أما لك لا ترثي لحاله مكمد","https://www.aldiwan.net/poem61538.html","الطويل"],[102,"هو ذا البحر مزبدا يتعالى","https://www.aldiwan.net/poem33132.html","الخفيف"],[52,"يا صاحبي شيبت عفوا","https://www.aldiwan.net/poem26585.html","مجزوء الكامل"],[52,"من يذود الهموم عن مكروب","https://www.aldiwan.net/poem27241.html","الخفيف"],[46,"إليك تناهى كل فخر وسؤدد","https://www.aldiwan.net/poem23640.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16692","الكامل"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10783","الطويل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39497","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54856","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54894","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43773","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[77,"وجودك حيى الملك والدين والدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=34199",""],[77,"دعاها تشم آثار نجد ففي نجد","https://www.poetsgate.com/ViewPoem.aspx?id=33821",""],[100,"ياقارئي","https://www.poetsgate.com/ViewPoem.aspx?id=50457",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[0,"أعِنّي عَلَى بَرْقٍ أراهُ وَمِيضِ","https://www.poetsgate.com/ViewPoem.aspx?id=4734",""],[73,"خليلي لا فطر يسر ولا أضحى","https://www.poetsgate.com/ViewPoem.aspx?id=780",""],[80,"تَغَنَّتْ قيانُ الوُرْقِ في الوَرَق الخُضْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=3226",""],[91,"مستشفى تل شيحا","https://www.poetsgate.com/ViewPoem.aspx?id=53339",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""]],"verses":[["وَيَهماءَ بِالقَيظِ مَحجوبَةٍ","تُطالِعُنا في هُبوبِ السَهامِ",0,"م",1,0],["وَيَهجُرونَ إِذا جَدَّت عَزائِمُهُم","دُنيا تَلاعَبُ بِالغُرِّ المَجاويدِ",1,"د",1,0],["ويَهْوى مُلوكُ الأرضِ أن يُمْدَحوا بِها","وما كُلُّ سَمْعٍ يرتَضيهِ كَلامي",2,"م",2,0],["ويهُزُّهُ نَغمُ الثّناءِ كأنّهُ","مُتَسَمِّعٌ هَزَجَ الغِناءِ رَخيما",3,"م",2,0],["ويهتَدي الطّيْفُ تُغويهِ غَياهِبُهُ","بكَوكَبٍ فُرَّ عنهُ الأفْقُ وهّاجِ",4,"ج",1,0],["ويَهفو بِعِطْفَيْهِ الثّناءُ كَما هَفا","نَزيفٌ يُغَنّيهِ الغَريضُ وعَثْعَثُ",5,"ث",1,0],["ويهْتَزُّ عِطْفُ المُلْكِ عندَ سَماعِها","كهزّة كفّيْكَ الحُسامَ اليَمانِيا",6,"ي",2,0],["ويَهْديكَ هَذا العِيدُ أسْعَدُ وافِدٍ","أتاكَ معَ النّصْرِ العَزيزِ على وعْدِ",7,"د",1,0],["ويَهْنِيكَ نَيْروزٌ سَعيدٌ قدِ انْقَضى","أتَتْكَ على آثارِهِ منْهُ أعْدادُ",8,"د",1,0],["وَيُهلِكُها حَتّى تَصيرَ تَفاهَةً","وَيَلحَقُها مِن كُلِّ غَيٍّ لَحوقُها",9,"ق",3,0],["وَيَهماءَ بِاللَيلِ غَطشى الفَلا","ةِ يُؤنِسُني صَوتُ فَيّادِها",10,"د",3,0],["وَيَهماءَ قَفرٍ تَخرُجُ العَينُ وَسطَها","وَتَلقى بِها بَيضَ النَعامِ تَرائِكا",11,"ك",2,0],["وَيَهماءَ تَعزِفُ جِنّانُها","مَناهِلُها آجِناتٌ سُدُم",12,"م",1,0],["وَيُهضَمُ حَقُّ الأَديبِ الأَريبِ","وَيُطمَسُ فَضلُ النَبيهِ الأَغَرّ",13,"ر",1,0],["وَيَهتِفُ بِاِسمِكَ أَبناؤُنا","إِذا آنَ لِلزَرعِ أَن يُحصَدا",14,"د",2,0],["وَيُهضِمُ فينا الإِمامُ الحَكيم","وَيُكرِمُ فينا الجَهولُ الغَبي",15,"ي",1,0],["وَيَهتاجُ قَصرُ الفارِسِيِّ صَبابَةً","لِقَلبِيَ لاتَألو زِنادَ الأَسى قَدحا",16,"ح",2,0],["وَيَهنيكَ أَنَّكَ يا سَيِّدي","غَدَوتَ مُقارِنَ ذاكَ الرَبَض",17,"ض",1,0],["وَيَهدَأُ تاراتٍ سَناهُ وَتارَةً","يَنوءُ كَتَعتابِ الكَسيرِ المَهيضِ",18,"ض",1,0],["وَيَهتَزُّ في الحَربِ عِندَ النِزالِ","كَما اِهتَزَّ ذو الرَونَقِ المِقطَعُ",19,"ع",1,0],["وَيَهُزُّهُ هَزَّ القَنَاةِ لِنَصْرِهِ","مُسْتَصْرِخٌ مِنْ قَوْمِهِ وَمَضِيمُ",20,"م",1,0],["وَيَهلِكُ بَينَها المَرَئِيُّ لَغواً","كَما أَلغَيتَ في الدّيَةِ الحوارا",21,"ر",2,0],["ويهدّوا ويرسل","ما له في الوجود مثال",22,"ل",1,0],["ويهنيك دون العيد عيدٌ شرعتَهُ","نبتُّ به في الخافقين التهانيا",23,"ي",2,0],["ويهني البنودَ الخافقاتِ فإنها","سيعقدها في ذمة النصر غازيا",23,"ي",2,0],["ويهفو فؤادي كلما هبّت الصِّبا","أما لفؤادي في هواك نصيرُ",24,"ر",1,0],["ويهمس في أذن الطبيعة جوّه","فيضحكها فوق الربا الخضر همسه",25,"س",2,0],["ويهُزّ الدنيا رجاء وخوفاً","بيدٍ من دِراية هزّازه",26,"ز",2,0],["ويهزم الجمع مجثّاً مكايده","بكا لعواصف هبّت تقلع الشجرا",27,"ر",2,0],["وَيَهدي القَومَ مُضطَلِعاً إِذا ما","رَئيسُ القَومِ بِالمَوماةِ حارا",28,"ر",2,0],["وَيهاً فِداؤُكُمُ أُمّي وَما وَلَدَت","حاموا عَلى مَجدِكُم وَاِكفوا مَنِ اِتَّكَلا",29,"ل",2,0],["وَيهاً فِدىً لَكُمُ أُمّي وَما وَلَدَت","قَد يَنفَعُ الصَبرُ في المَكروهِ أَحيانا",30,"ن",2,0],["وَيَهنِ بَني كَعبٍ مَكانُ فَتاتِهِم","وَمَقعَدُها لِلمُسلِمينَ بِمَرصَدِ",31,"د",1,0],["ويهنِ الليالي أن فيها لواصف","جمالاً به يخفى ويعفى قبيحها",32,"ح",3,0],["ويهتزّ للجدوى وما هزّ مهده","به وتناغى بالهبات وفوده",33,"د",2,0],["ويهتز للذكر الجميل كأنه","وحاشا بقاه قد تناول مسكرا",34,"ر",2,0],["ويهزُّ حلو قوامها مرج الصبا","هزَّ الكماة عواليَ المرَّان",35,"ن",1,0],["ويهمس المولى إلى عبدِهِ","قَلْنِسْهُ بالصفْعِ ولا تَرهبِ",36,"ب",1,0],["وَيَهُزُّ كلُّ مُبَلَّدٍ أَعْطافَه","طَرَباً كفعل الشَّارب المِرِّيحِ",37,"ح",1,0],["ويهوي إليه كل قلبٍ بُودهِ","هُوِيّ القُطاميِّ الغريب إلى الوكر",38,"ر",1,0],["ويَهنيك أنْ لم يبقَ مجدٌ ترومُهُ","يداك وأن لم تبق كف تُنافسه",39,"س",2,0],["ويهتدي عامِهُ السيوف به","من هام قوم إلى مفارقها",40,"ق",3,0],["ويَهنيك أن أصبحتَ دنيا وجنةً","فأصبحتِ الدنيا بدنياك تختالُ",41,"ل",1,0],["وَيَهتِفُ بَِلقَصائِدِ وَالأَغاني","وَقَد ذَهَبَ الرَدى بِالمُنشِدينا",42,"ن",2,0],["وَيَهُزُّني الغَزَلُ الرَقي","قُ إِذا تَجَنَّبَهُ قَبيحُه",43,"ح",2,0],["وَيَهُزُّني كَأسُ المُدا","مَةِ في يَدِ الرَشإِ الرَبيبِ",44,"ب",1,0],["وَيَهدي إِلَيكَ الناسُ دونَ تَصَنُّعٍ","مَحَبَّةَ صِدقٍ لَم يَشُبها كِذابُ",45,"ب",1,0],["ويهزم الضلالة","ويحطِم القيود",46,"د",1,0],["ويهز عطفيه الزمان ويزدهى","بأغر فيه محجل الآثار",47,"ر",1,0],["وَيَهُزُّ مِنّي الماءُ في لَمَعانِهِ","فَأَميلُ أَنظُرُ فيهِ أَطمَعُ أَن أَرى",48,"ر",2,0],["وَيُهينونَ صاحِبَ الروحِ مَيتاً","وَيُعِزّونَ بَعدَهُ أَكفانَه",49,"ن",2,0],["وَيَهُدّونَ بِالتِلاوَةِ وَالصُل","بانِ ما شادَ بِالقَنا البَنّاءُ",50,"ا",2,0],["وَيَهدَأَ ذا السَحابُ فَقَد شَكَكنا","أَتَغلِبُ أَم حَياهُ لَكُم قَبيلُ",51,"ل",1,0],["وَيُهِمُّ فيكَ إِذا نَطَقتَ فَصاحَةً","مِن كُلِّ عُضوٍ مِنكَ أَن يَتَكَلَّما",52,"م",2,0],["وَيَهيجُني أَلّا يَزالَ يَزورُني","مِنها خَيالٌ ما يُغَبُّ مُطيفُهُ",53,"ف",2,0],["ويهزها سكران سكر","شرابها وشبابها",54,"ب",3,0],["وَيَهديهِ هادٍ مِن دَلالَةِ مَعْطِسٍ","إلى ما عليه من ظلامِ الفلا خالُ",55,"ل",1,0],["وَيُهدي إليكَ البحرُ درَّ مغاصِهِ","وإن لم تقفْ على طَرَفِ العبرِ",56,"ر",1,0],["وَيَهيجُ بي وَجَعٌ وَعِلَّتُهُ","سَقَمٌ بِطَرفِكَ إنَّ ذا سحرُ",57,"ر",1,0],["وَيَهيجُني نَفَسُ النَسيمِ إِذا سَرى","وَيَشوقُني فيكَ الحَمامُ الأَورَقُ",58,"ق",1,0],["وَيَهجُرُ في اللَهِ حَتّى الكَرى","وَيَألَفُ في اللَهِ حَتّى نَعَم",59,"م",1,0],["وَيَهتَزُّ لِلضَيفِ خُدّامُهُ","وَتُعدي سَجايا المَوالي الخَدَم",59,"م",1,0],["ويُهيبُ باللّاهينَ من أبنائِه","يَخْشَى عليهم حَسْرَةَ المُتَنَدِّمِ",60,"م",1,0],["وَيُهدي مِن خَدِّهِ التَوريد","عَقيقاً يُصاغُ مِن دُرَّه",61,"ه",1,0],["وَيَهفو فَيَهفو القَلبُ عِندَ اِنعِطافِهِ","فَهَلّا رَأى في العَطفِ سُنَّةَ مُقتَدِ",62,"د",1,0],["وَيَهب النَسيم في السحر الداكن","يحيي مِن الزهور تِلالا",63,"ل",2,0],["وَيَهُزُّ أَجنِحَةَ النَبا","تِ نَسيمُهُ وَيَحُنُّ زَهوا",64,"و",2,0],["وَيَهُزّونَ كُلَّ أَخضَرَ كَالبَق","لَةِ ماضٍ عَلى الفُلولِ رَسوبِ",65,"ب",1,0],["ويَهْدي الدليلُ القوْمَ والليلُ مُظلِمٌ","ولكنّه بالنّجمِ يَهْدي ويَهْتَدي",66,"د",2,0],["وَيُهِلُّ وَفْدُ البيتِ إنْ بَصُرُوا بها","والحُكْمُ إلاّ بالحصى مَتْرُوك",67,"ك",1,0],["وَيَهتَزُّ مِن تَحتِ الثِيابِ قَوامُها","كَما اِهتَزَّ غُصنُ البانِ وَالفَنَنُ النَضرُ",68,"ر",1,0],["ويهتاجُ منه كُلُّ ما كانَ ساكناً","دعاءُ حمامٍ لم يبِتْ بوُكونِ",69,"ن",1,0],["وَيَهْنِئْ رَبَّ وَادِي النِّيلِ فِيهَا","مَكَانُ تَجِلَّةٍ وَخُلُودُ ذِكْرِ",70,"ر",1,0],["وَيَهدَّ الكهْلُ هَدَّ الفَحْلِ فِي","غَرَقٍ وَالوَقْدُ لاَ يَأْلُوهُ هَدْرَا",71,"ر",2,0],["وَيَهُبُّ آناً سَائِراً","فِي الجَوِّ مُخْتَلَفَ المَسِيرْ",72,"ر",1,0],["ويهي الطير ولما تزل","وإذا ما سعروها في الدجى",73,"ج",2,0],["وَيُهدي إِليّ الدرّ مِن فيهِ حِكمَةً","وَيوري عَليّ النارَ مِن لبّهِ لَذعا",74,"ع",2,0],["ويهونُ عَلَيهِم شَحطُ نَوىً","يُطْوَى بِحَديثكَ فَدْفَدُهُ",75,"د",2,0],["ويهنِّئُّون النِّيل والْ","هَرَمَيْن بالعَهدْ الجديد",76,"د",1,0],["ويَهْمِسُ آخرون: لقد شَططْنا","متى ضاقتْ بأَهليها الدِّيار؟",77,"ر",1,0],["ويهتز عطف الملك عند سماعها","كهزة كفيك الجسام اليمانيا",78,"ي",2,0],["ويهنيك هذا العيد أسعد وافد","أتاك مع النصر العزيز على وعد",79,"د",1,0],["ويهوي كما يرتمي في الصخور","قتيل على كتفيه ... مصاب",80,"ب",1,0],["ويهْتِفُ بالنَّفَر المُهطِعين","أهينِوا لِئامكمُ تُكْرمَوا",81,"م",3,0],["ويهدأ تاراتٍ وتارة","ً ينوءُ كتعتاب الكسير المهيض",82,"ض",1,0],["وَيَهْتاجُ قصرُ الفارسيّ صبابة ً،","لقلبيَ، لا تألُوا زِنادَ الأسَى قدْحا",83,"ح",2,0],["ويهدي إليكَ البحرُ دُرَّ مغاصِهِ","وإنْ لم تَقِفْ منه على طرفِ العبر",84,"ر",1,0],["ويهتف بالقصائد والأغاني","وقد ذهب الردى بالمنشدينا",85,"ن",2,0],["وَيَهُدُّني أَلمي فأنْشُدُ راحَتي","في بِضْعِ آياتٍ مِنَ القُرآنِ",86,"ن",1,0]]}