et/poem34849.html","المتقارب"],[442,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[442,"أنورك أم أوقدت بالليل نارك","https://www.aldiwan.net/poem34885.html","الطويل"],[442,"لك الله بالنصر العزيز كفيل","https://www.aldiwan.net/poem34919.html","الطويل"],[444,"عرج على وادي العقيق","https://www.aldiwan.net/poem14319.html","مجزوء الكامل"],[444,"أما من بني حوا خليل محالم","https://www.aldiwan.net/poem14383.html","الطويل"],[455,"أمودعي من قبل أن يلقاني","https://www.aldiwan.net/poem61317.html","الكامل"],[463,"وفتيان صدق من تميم تناثلوا","https://www.aldiwan.net/poem15083.html","الطويل"],[463,"إذا ما غزوتم معلمين فراوحوا","https://www.aldiwan.net/poem15096.html","الطويل"],[463,"يرش كثيف الدجن حينا وتارة","https://www.aldiwan.net/poem15371.html","الطويل"],[463,"لقد علم الأحياء دان ونازح","https://www.aldiwan.net/poem15399.html","الطويل"],[463,"عضد الدين مشار ال","https://www.aldiwan.net/poem15407.html","مجزوء الرمل"],[463,"يمل هواه كل سرج وسابح","https://www.aldiwan.net/poem15449.html","الطويل"],[463,"تتيه به الأيام فخرا وغبطة","https://www.aldiwan.net/poem16121.html","الطويل"],[463,"سألت إله العرش رب محمد","https://www.aldiwan.net/poem16158.html","الطويل"],[463,"لتهن قصور المجد زيدت جلالة","https://www.aldiwan.net/poem16249.html","الطويل"],[466,"نسيم الصبا والليل منتظم العقد","https://www.aldiwan.net/poem3176.html","عموديه"],[466,"وجدي كوجدك بالظباء الغيد","https://www.aldiwan.net/poem3208.html","عموديه"],[466,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"],[472,"سيهلك يا سلمى شفيق عليكم","https://www.aldiwan.net/poem4791.html","الطويل"],[531,"ليهنكم دار المسرة إنها","https://www.aldiwan.net/poem37313.html","الطويل"],[553,"دعوا اليوم ما عودتم من تصبر","https://www.aldiwan.net/poem47699.html","الطويل"],[553,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[560,"أتعبتني بقر الشام","https://www.aldiwan.net/poem34182.html","المديد"],[578,"إلى كل قوم سلم يرتقى به","https://www.aldiwan.net/poem1807.html","الطويل"],[587,"لقد سمح الدهر بالمقترح","https://www.aldiwan.net/poem1571.html",""],[588,"بلا غيبة للبدر وجهك أجمل","https://www.aldiwan.net/poem18010.html","الطويل"],[589,"لك الحمد اللهم يا ذا الحامد","https://www.aldiwan.net/poem11497.html","عموديه"],[800,"","https://poetry.dctabudhabi.ae/diwan/poem/31547","الوافر"],[1034,"","https://poetry.dctabudhabi.ae/diwan/poem/122193","الكامل"]],"verses":[["وَيَهماءَ بِالقَيظِ مَحجوبَةٍ","تُطالِعُنا في هُبوبِ السَهامِ",0,"م",1,0],["وَيَهجُرونَ إِذا جَدَّت عَزائِمُهُم","دُنيا تَلاعَبُ بِالغُرِّ المَجاويدِ",1,"د",1,0],["ويَهْوى مُلوكُ الأرضِ أن يُمْدَحوا بِها","وما كُلُّ سَمْعٍ يرتَضيهِ كَلامي",2,"م",2,0],["ويهُزُّهُ نَغمُ الثّناءِ كأنّهُ","مُتَسَمِّعٌ هَزَجَ الغِناءِ رَخيما",3,"م",2,0],["ويهتَدي الطّيْفُ تُغويهِ غَياهِبُهُ","بكَوكَبٍ فُرَّ عنهُ الأفْقُ وهّاجِ",4,"ج",1,0],["ويَهفو بِعِطْفَيْهِ الثّناءُ كَما هَفا","نَزيفٌ يُغَنّيهِ الغَريضُ وعَثْعَثُ",5,"ث",1,0],["ويهْتَزُّ عِطْفُ المُلْكِ عندَ سَماعِها","كهزّة كفّيْكَ الحُسامَ اليَمانِيا",6,"ي",2,0],["ويَهْديكَ هَذا العِيدُ أسْعَدُ وافِدٍ","أتاكَ معَ النّصْرِ العَزيزِ على وعْدِ",7,"د",1,0],["ويَهْنِيكَ نَيْروزٌ سَعيدٌ قدِ انْقَضى","أتَتْكَ على آثارِهِ منْهُ أعْدادُ",8,"د",1,0],["وَيُهلِكُها حَتّى تَصيرَ تَفاهَةً","وَيَلحَقُها مِن كُلِّ غَيٍّ لَحوقُها",9,"ق",3,0],["وَيَهماءَ بِاللَيلِ غَطشى الفَلا","ةِ يُؤنِسُني صَوتُ فَيّادِها",10,"د",3,0],["وَيَهماءَ قَفرٍ تَخرُجُ العَينُ وَسطَها","وَتَلقى بِها بَيضَ النَعامِ تَرائِكا",11,"ك",2,0],["وَيَهماءَ تَعزِفُ جِنّانُها","مَناهِلُها آجِناتٌ سُدُم",12,"م",1,0],["وَيُهضَمُ حَقُّ الأَديبِ الأَريبِ","وَيُطمَسُ فَضلُ النَبيهِ الأَغَرّ",13,"ر",1,0],["وَيَهتِفُ بِاِسمِكَ أَبناؤُنا","إِذا آنَ لِلزَرعِ أَن يُحصَدا",14,"د",2,0],["وَيُهضِمُ فينا الإِمامُ الحَكيم","وَيُكرِمُ فينا الجَهولُ الغَبي",15,"ب",2,0],["وَيَهتاجُ قَصرُ الفارِسِيِّ صَبابَةً","لِقَلبِيَ لاتَألو زِنادَ الأَسى قَدحا",16,"ح",2,0],["وَيَهنيكَ أَنَّكَ يا سَيِّدي","غَدَوتَ مُقارِنَ ذاكَ الرَبَض",17,"ض",1,0],["وَيَهدَأُ تاراتٍ سَناهُ وَتارَةً","يَنوءُ كَتَعتابِ الكَسيرِ المَهيضِ",18,"ض",1,0],["وَيَهتَزُّ في الحَربِ عِندَ النِزالِ","كَما اِهتَزَّ ذو الرَونَقِ المِقطَعُ",19,"ع",1,0],["وَيَهُزُّهُ هَزَّ القَنَاةِ لِنَصْرِهِ","مُسْتَصْرِخٌ مِنْ قَوْمِهِ وَمَضِيمُ",20,"م",1,0],["وَيَهلِكُ بَينَها المَرَئِيُّ لَغواً","كَما أَلغَيتَ في الدّيَةِ الحوارا",21,"ر",2,0],["ويهدّوا ويرسل","ما له في الوجود مثال",22,"ل",1,0],["ويهنيك دون العيد عيدٌ شرعتَهُ","نبتُّ به في الخافقين التهانيا",23,"ي",2,0],["ويهني البنودَ الخافقاتِ فإنها","سيعقدها في ذمة النصر غازيا",23,"ي",2,0],["ويهفو فؤادي كلما هبّت الصِّبا","أما لفؤادي في هواك نصيرُ",24,"ر",1,0],["ويهمس في أذن الطبيعة جوّه","فيضحكها فوق الربا الخضر همسه",25,"س",2,0],["ويهُزّ الدنيا رجاء وخوفاً","بيدٍ من دِراية هزّازه",26,"ز",2,0],["ويهزم الجمع مجثّاً مكايده","بكا لعواصف هبّت تقلع الشجرا",27,"ر",2,0],["وَيَهدي القَومَ مُضطَلِعاً إِذا ما","رَئيسُ القَومِ بِالمَوماةِ حارا",28,"ر",2,0],["وَيهاً فِداؤُكُمُ أُمّي وَما وَلَدَت","حاموا عَلى مَجدِكُم وَاِكفوا مَنِ اِتَّكَلا",29,"ل",2,0],["وَيهاً فِدىً لَكُمُ أُمّي وَما وَلَدَت","قَد يَنفَعُ الصَبرُ في المَكروهِ أَحيانا",30,"ن",2,0],["وَيَهنِ بَني كَعبٍ مَكانُ فَتاتِهِم","وَمَقعَدُها لِلمُسلِمينَ بِمَرصَدِ",31,"د",1,0],["ويهنِ الليالي أن فيها لواصف","جمالاً به يخفى ويعفى قبيحها",32,"ح",3,0],["ويهتزّ للجدوى وما هزّ مهده","به وتناغى بالهبات وفوده",33,"د",2,0],["ويهتز للذكر الجميل كأنه","وحاشا بقاه قد تناول مسكرا",34,"ر",2,0],["ويهزُّ حلو قوامها مرج الصبا","هزَّ الكماة عواليَ المرَّان",35,"ن",1,0],["ويهمس المولى إلى عبدِهِ","قَلْنِسْهُ بالصفْعِ ولا تَرهبِ",36,"ب",1,0],["وَيَهُزُّ كلُّ مُبَلَّدٍ أَعْطافَه","طَرَباً كفعل الشَّارب المِرِّيحِ",37,"ح",1,0],["ويهوي إليه كل قلبٍ بُودهِ","هُوِيّ القُطاميِّ الغريب إلى الوكر",38,"ر",1,0],["ويَهنيك أنْ لم يبقَ مجدٌ ترومُهُ","يداك وأن لم تبق كف تُنافسه",39,"س",2,0],["ويهتدي عامِهُ السيوف به","من هام قوم إلى مفارقها",40,"ق",3,0],["ويَهنيك أن أصبحتَ دنيا وجنةً","فأصبحتِ الدنيا بدنياك تختالُ",41,"ل",1,0],["وَيَهتِفُ بَِلقَصائِدِ وَالأَغاني","وَقَد ذَهَبَ الرَدى بِالمُنشِدينا",42,"ن",2,0],["وَيَهُزُّني الغَزَلُ الرَقي","قُ إِذا تَجَنَّبَهُ قَبيحُه",43,"ح",2,0],["وَيَهُزُّني كَأسُ المُدا","مَةِ في يَدِ الرَشإِ الرَبيبِ",44,"ب",1,0],["وَيَهدي إِلَيكَ الناسُ دونَ تَصَنُّعٍ","مَحَبَّةَ صِدقٍ لَم يَشُبها كِذابُ",45,"ب",1,0],["ويهزم الضلالة","ويحطِم القيود",46,"د",1,0],["ويهز عطفيه الزمان ويزدهى","بأغر فيه محجل الآثار",47,"ر",1,0],["وَيَهُزُّ مِنّي الماءُ في لَمَعانِهِ","فَأَميلُ أَنظُرُ فيهِ أَطمَعُ أَن أَرى",48,"ر",2,0],["وَيُهينونَ صاحِبَ الروحِ مَيتاً","وَيُعِزّونَ بَعدَهُ أَكفانَه",49,"ن",2,0],["وَيَهُدّونَ بِالتِلاوَةِ وَالصُل","بانِ ما شادَ بِالقَنا البَنّاءُ",50,"ا",2,0],["وَيَهدَأَ ذا السَحابُ فَقَد شَكَكنا","أَتَغلِبُ أَم حَياهُ لَكُم قَبيلُ",51,"ل",1,0],["وَيُهِمُّ فيكَ إِذا نَطَقتَ فَصاحَةً","مِن كُلِّ عُضوٍ مِنكَ أَن يَتَكَلَّما",52,"م",2,0],["وَيَهيجُني أَلّا يَزالَ يَزورُني","مِنها خَيالٌ ما يُغَبُّ مُطيفُهُ",53,"ف",2,0],["ويهزها سكران سكر","شرابها وشبابها",54,"ب",3,0],["وَيَهديهِ هادٍ مِن دَلالَةِ مَعْطِسٍ","إلى ما عليه من ظلامِ الفلا خالُ",55,"ل",1,0],["وَيُهدي إليكَ البحرُ درَّ مغاصِهِ","وإن لم تقفْ على طَرَفِ العبرِ",56,"ر",1,0],["وَيَهيجُ بي وَجَعٌ وَعِلَّتُهُ","سَقَمٌ بِطَرفِكَ إنَّ ذا سحرُ",57,"ر",1,0],["وَيَهيجُني نَفَسُ النَسيمِ إِذا سَرى","وَيَشوقُني فيكَ الحَمامُ الأَورَقُ",58,"ق",1,0],["وَيَهجُرُ في اللَهِ حَتّى الكَرى","وَيَألَفُ في اللَهِ حَتّى نَعَم",59,"م",1,0],["وَيَهتَزُّ لِلضَيفِ خُدّامُهُ","وَتُعدي سَجايا المَوالي الخَدَم",59,"م",1,0],["ويُهيبُ باللّاهينَ من أبنائِه","يَخْشَى عليهم حَسْرَةَ المُتَنَدِّمِ",60,"م",1,0],["وَيُهدي مِن خَدِّهِ التَوريد","عَقيقاً يُصاغُ مِن دُرَّه",61,"ه",1,0],["وَيَهفو فَيَهفو القَلبُ عِندَ اِنعِطافِهِ","فَهَلّا رَأى في العَطفِ سُنَّةَ مُقتَدِ",62,"د",1,0],["وَيَهب النَسيم في السحر الداكن","يحيي مِن الزهور تِلالا",63,"ل",2,0],["وَيَهُزُّ أَجنِحَةَ النَبا","تِ نَسيمُهُ وَيَحُنُّ زَهوا",64,"و",2,0],["وَيَهُزّونَ كُلَّ أَخضَرَ كَالبَق","لَةِ ماضٍ عَلى الفُلولِ رَسوبِ",65,"ب",1,0],["ويَهْدي الدليلُ القوْمَ والليلُ مُظلِمٌ","ولكنّه بالنّجمِ يَهْدي ويَهْتَدي",66,"د",2,0],["وَيُهِلُّ وَفْدُ البيتِ إنْ بَصُرُوا بها","والحُكْمُ إلاّ بالحصى مَتْرُوك",67,"ك",1,0],["وَيَهتَزُّ مِن تَحتِ الثِيابِ قَوامُها","كَما اِهتَزَّ غُصنُ البانِ وَالفَنَنُ النَضرُ",68,"ر",1,0],["ويهتاجُ منه كُلُّ ما كانَ ساكناً","دعاءُ حمامٍ لم يبِتْ بوُكونِ",69,"ن",1,0],["وَيَهْنِئْ رَبَّ وَادِي النِّيلِ فِيهَا","مَكَانُ تَجِلَّةٍ وَخُلُودُ ذِكْرِ",70,"ر",1,0],["وَيَهدَّ الكهْلُ هَدَّ الفَحْلِ فِي","غَرَقٍ وَالوَقْدُ لاَ يَأْلُوهُ هَدْرَا",71,"ر",2,0],["وَيَهُبُّ آناً سَائِراً","فِي الجَوِّ مُخْتَلَفَ المَسِيرْ",72,"ر",1,0],["ويهي الطير ولما تزل","وإذا ما سعروها في الدجى",73,"ج",2,0],["ويهديك غيري الدر يا ويح شاعر","يقول خذي مني قصائد كالدر",74,"ر",1,0],["وَيُهدي إِليّ الدرّ مِن فيهِ حِكمَةً","وَيوري عَليّ النارَ مِن لبّهِ لَذعا",75,"ع",2,0],["ويهونُ عَلَيهِم شَحطُ نَوىً","يُطْوَى بِحَديثكَ فَدْفَدُهُ",76,"د",2,0],["ويهنِّئُّون النِّيل والْ","هَرَمَيْن بالعَهدْ الجديد",77,"د",1,0],["ويَهْمِسُ آخرون: لقد شَططْنا","متى ضاقتْ بأَهليها الدِّيار؟",78,"ر",1,0],["ويهتز عطف الملك عند سماعها","كهزة كفيك الجسام اليمانيا",79,"ي",2,0],["ويهنيك هذا العيد أسعد وافد","أتاك مع النصر العزيز على وعد",80,"د",1,0],["ويهتف : يا شعب شيّد على","جماجمنا مجدك الأمجدا",81,"د",2,0],["ويهمس في صمته موعد","إلى الشعب لا بدّ أن تسعدا",81,"د",2,0],["ويهزّ الرؤى كما هدهد السكّير","سكّيره تعاني الخمارا",82,"ر",2,0],["ويهتزّ في نهديك موج مضرّم","عميق وفي عينيك يحلم شاطيء",83,"ي",2,0],["ويهوي كما يرتمي في الصخور","قتيل على كتفيه ... مصاب",84,"ب",1,0],["ويهْتِفُ بالنَّفَر المُهطِعين","أهينِوا لِئامكمُ تُكْرمَوا",85,"م",3,0],["ويهدأ تاراتٍ وتارة","ً ينوءُ كتعتاب الكسير المهيض",86,"ض",1,0],["وَيَهْتاجُ قصرُ الفارسيّ صبابة ً،","لقلبيَ، لا تألُوا زِنادَ الأسَى قدْحا",87,"ح",2,0],["ويهدي إليكَ البحرُ دُرَّ مغاصِهِ","وإنْ لم تَقِفْ منه على طرفِ العبر",88,"ر",1,0],["ويهتف بالقصائد والأغاني","وقد ذهب الردى بالمنشدينا",89,"ن",2,0],["ويهزّني لحن النسيم مقبّلا","نور الخمائل لاثما أورادها",90,"د",3,0],["وَيَهُدُّني أَلمي فأنْشُدُ راحَتي","في بِضْعِ آياتٍ مِنَ القُرآنِ",91,"ن",1,0],["وَيَهزنا شَرخ الصِبا فَتَخالنا","بيض المَواضي في أَكُف الصَيد",92,"د",1,0],["وَيَهمي بِهِ قَطر النَدا فَتَخالَهُ","مُبَدد عقد في فِراش زمرد",93,"د",1,0],["ويهدأ بالوصال قريح طرف","عليه النوم يا علوى حرام",94,"م",1,0],["ويهضم حقي من كسته عوارفي","رداء المعالي فهو غير اديب",95,"ب",1,0],["ويهواك القريبُ وكل قاصٍ","كأن هواك بالأهواءِ شيبَا",96,"ب",2,0],["ويُهَنِّي جميع الناسِ أنك سالمٌ","وتَهْنَى بما أُوتيته مِن مناقِبِ",97,"ب",1,0],["ويهجو الصالحين وهم سجود","لرب العرش أوجههم وِسَام",98,"م",1,0],["ويهوى لقاءَ الموتِ لما أضافهُ","إلى نوبٍ تنتابُهُ وهي ألوانُ",99,"ن",1,0],["ويهتزُّ عند هبوبِ السؤال اه","تزازَ الأراكةِ بالجِريباءِ",100,"ا",2,0],["ويهمى سحاب اليمن بالأمن والهنا","علينا بمحض الفضل في كل برهة",101,"ه",1,0],["ويهوى على واستهوى البرد","لأني كما علمت وحيد",102,"د",1,0],["ويهين سائله اللئيم لظنه","في مثله خيراً وذلك لا يظنْ",103,"ن",1,0],["ويهني امرء أولاك فوزاً بما يجب","ينال الفتى أقصى المراتب والعليا",104,"ي",2,0],["ويهنى الرعايا النوم في ظل عدله","لقد مده من جنة فوقهم ظلا",105,"ل",2,0],["ويهدى إليها من أضل سبيلها","ويحفظ من أشراطها ما يضيع",106,"ع",1,0],["ويهنيك أن الله راض وخلقه","وأن لك البشرى وأن لك العفوا",107,"و",2,0],["وَيهنيكَ ذا المُلكُ الَّذي عَمَّ يُمنُهُ","عُقَيلاً وَأَحيا عَبدَ قَيسٍ وَوائِلا",108,"ل",2,0],["ويهزني مرحُ الشبابِ بها","هزَّ القَضيب اللَّدْن مُنعطِفا",109,"ف",2,0],["ويَهيج شوقَك للأحبةِ شكلُها","كُثبٌ تَميس على ذُراها البان",110,"ن",1,0],["ويهينه المعشوق بين دلاله","متمنّعا وينيله استحقاقه",111,"ق",2,0],["ويهجى بعدما يذوي ذبولا","ويلقى في المزابل والكنيف",112,"ف",1,0],["ويهز غصن البان منك على النقا","ما لي الى احد سواك تشوف",113,"ف",1,0],["ويهتز من وجد إذا نفس الصبا","سحيراً بأعطاف الخزامى تحرشا",114,"ش",2,0],["ويهب القبول من جوه الرح","ب لمستوحش بروح وأنس",115,"س",1,0],["ويهزه طرب إذا ذكر الحمى","هز الشمول شمائل النشوان",116,"ن",1,0],["وَيُهَوِّنُ البوسى عَلَيَّ إِذا وَهى","جَلَدي بِما أَنّي أُلاقي الأَنعُما",117,"م",2,0],["وَيَهُزُّ قَدّاً كَالقَناةِ لِحاظُهُ","لِمُحِبِّهِ مِنها مَكانَ العامِلِ",118,"ل",1,0],["وَيَهْوَى أُنَاسٌ سَُلَِّمُوا هُمْ سَلاَمَتِي","وَأَنِّيَ دَهْرِي نَاعِمُ الْبَالِ مُخْصِبُ",119,"ب",1,0],["وَيَهَابُهُ مَنْ لمْ يَذُقْ","لِوِدَادِهِ طَعْماً فَيُرْعَدْ",120,"د",1,0],["وَيَهِجْ تَحَرُّقَ كُلِّ أوْغَدْ","فَيَحِنْ غَدَاةَ الْيَوْمِِ أَوْ غَدْ",120,"د",1,0],["ويهتزُّ للجدوى إذا ما مدحته","كما اهتزَّ حاشى وصفه شاربُ الخَمرِ",121,"ر",1,0],["وَيَهضمُ جانِبي وَاللَيثُ جاري","لَعمرِكَ أَنَّ ذا عَيبٌ عَليّه",122,"ه",1,0],["ويهتز المعافين حين سؤالهم","سروراً وما دارت عليه عقاره",123,"ر",2,0],["ويهزا لمديح عطفيه جوداً","مثلما اهتز شارب نشوان",124,"ن",1,0],["ويُهزِلُها الجَمَامُ إذا خَصِبنا","ويُدبِرُ ظَهرَهَا مَسُّ الجِلالِ",125,"ل",1,0],["وَيهب روح الانس من قبل الحمى","وارى خييمات الحمى وَتَراني",126,"ن",2,0],["وَيَهتَز ريحان القلوب لذكره","اذا ذكر اِرتاحَت قلوب وأكبد",127,"د",1,0],["ويَهُونُ ذَلِكَ لِلْفِراقِ وطَعْمِهِ","إنَّ الفِراق هُوَ الحِمامُ الثَّانِي",128,"ن",2,0],["وَيَهُزُّ مِنها خَطوُها في مَشيِها","حِقفاً بَديعَ اللينِ لَيسَ بِحاسِ",129,"س",1,0],["وَيَهُزُّ مُعتَلُّ النَسيمِ غُصونَهُ","فَيُرى المُعانِقُ فيهِ وَالمَهجورُ",130,"ر",1,0],["ويهجره بنوه الصيد","أهل المجد والكرم",131,"م",1,0],["ويهديه للحسنى ويختم له بها","وبالعمل المرضي الخالص المجدي",132,"د",2,0],["ويهدأ وتسكن أشجانه","فإن به مثل ورى الزناد",133,"د",1,0],["وَيُهدي عَلى رَسمِ التودّدِ خلعةً","مَجيديّةً تَستَوثقُ العهدَ والشرطا",134,"ط",2,0],["وَيُهنيك أنّي لا أزالُ لوقعها","وَمن نزعها ألقى الأليم من الكربِ",135,"ب",1,0],["وَيَهماءُ يَجري آلُها فَوقَ أُكمِها","كَما فاضَ ماءٌ أَلبَسَ الأُكمَ غامِرُ",136,"ر",1,0],["ويهدي اولى التنعيم نحو نعيمهم","بأعمال صدق في رجاء وخشية",137,"ه",1,0],["ويهفو إلى الكأس إن عربدت","ويسجد للمرأة المشتهاه",138,"ه",1,0],["ويهزني شوقي إليك فانثني","متلهفاً والدمع ملء عيوني",139,"ن",2,0],["ويهزني امل جميل باسم","فاعود منه بصفقة المغبون",139,"ن",1,0],["ويهفو إليكِ وفي وده","تثير شجاهُ آهة ثانية",140,"ي",2,0],["ويهزك الشوق العظيم إلى اللقا","فتظل ترقص في حشاك طروبا",141,"ب",2,0],["وَيَهُزُّأَ عْطافَ الكِرامِ كأَنَّما","صُبِحُوا بِكاساتِ المُدامِ دِهَاقَا",142,"ق",2,1],["ويهلك الشركُ في أقصى مداخله","حتى يغيب فلا يُدرى له أثر",143,"ر",1,0],["وَيهنئني لِقاؤُكَ يا سُروراً","بِمَلقاه تُفارقني الهُمومُ",144,"م",1,0],["ويَهْدي الطّارقينَ إليه صِيتٌ","تَخالُ به على شَرَفٍ ضِراما",145,"م",2,0],["ويَهُزُّ جيداً كالقناةِ مُرنَّحاً","ويُديرُ سَمْعاً كالسّنانِ مُؤلَّلا",146,"ل",2,0],["ويَهُزُّ جِيداً كالقناةِ يَنوطُه","بحَديدِ أُذْنٍ كالسِّنانِ مُؤلَّل",147,"ل",1,0],["ويَهزُّ مَصقولَ الحديدةِ ماضياً","كوَميضِ بَرقٍ في الغمامةِ لامع",148,"ع",1,0],["وَيَهيجُني الإِلفانِ إِن طارا وَإِن","وقعا على فننٍ من الأفنانِ",149,"ن",1,0],["وَيَهُزُّني كَالغُصنِ خَمرُ غِنائِهِ","فَأَقولُ هَل غَنّاهُ أَو غَنّاني",150,"ن",2,0],["ويُهنَّى بِالعيدِ قَومٌ وإِنِّي","بِك هنَّيتُ عيدَهُم والمُصَلَّى",151,"ل",2,0],["ويهزُّ عِطفَيه كما","يهتزُّ بعد الريِّ عودُ",152,"د",1,0],["ويهزني طرباً كأن","نَ غبوقه عندي صبوحه",153,"ح",2,0],["وَيَهَتَزُّ مِن ذِكرى نَتيجة دَهرِهِ","مَتى انس التِذكار هَزَةَ نُشوان",154,"ن",1,0],["وَيَهوى الوَرد وَجنَتُهُ","فَيَهجر شَمهُ هَجري",155,"ر",2,0],["وَيَهز لِمح الطَرف عامل قَدهِ","هَزّ النَسائِمِ بانةُ الجَرعاءِ",156,"ا",2,0],["وَيَهجُر زاعِماً إِن ال","لقا ضَرب مِن الرَجس",157,"س",1,0],["ويهدينا صراطا مستقيما","به الخيرات والابريز والماس",158,"س",1,0],["ويهنيكَ ادّخاركَ خير كسْبٍ","إذا الجاني بمكسَبهِ رهينُ",159,"ن",1,0],["وَيَهرتُ في الطِلى أَشداقُ عنسٍ","تُحلَّب بِالدِماء بدل اللَغامِ",160,"م",1,0],["وَيَهماء يَهوي بَينَ أَورادها القطا","وَيوهي السُرى فيها قوى الضَيغَم الجَلدِ",161,"د",1,0],["ويَهيجُنِي بعد اندمالِ صَبَابَتِي","ورْقاءُ مادَ بِهَا قضيبٌ مُورِقُ",162,"ق",1,0],["ويهدي المضلَّ ويعطي المقلّ","ويرفع في البأس خطباً جسيما",163,"م",2,0],["ويهون الأَمر العظيمُ لديه","وحَرِيٌّ بمثلِهِ أنْ يهونا",164,"ن",2,0],["ويهوى المكرمات بكلِّ آنٍ","ولن نلقى به عنها ملالا",165,"ل",2,0],["ويهنيء رئاسة أرخوها","برشيدٍ زهت أيادي الرئاسه",166,"س",2,0],["ويَهُزُّ الرَّأْسَ حُمْقاً","هزَّ أَعطافِ الرُّدْينِي",167,"ن",2,0],["ويهزّه هزَجُ الصهيل كأنما","حكمتْ عليه القهوةُ الصّهباءُ",168,"ا",2,0],["ويهزُّ أغصانَ القدودِ كأنّهُ","كأسٌ عليها للمُدامِ تُدارُ",169,"ر",1,0],["ويَهْنِ المصلَّى تجلِّيكَ فِيهِ","بوجهٍ يُنيرُ وكفٍّ تَغِيمُ",170,"م",1,0],["ويَهِيجُهُمْ عِينٌ لَهُنَّ مرابِضٌ","ويَشُوقُهُمْ طَيرٌ لَهَا أَوْكارُ",171,"ر",1,0],["وَيهنيكِ يَا دَارَ الخِلافَةِ منهُما","هِلالانِ لاحا يَرْفَعَانِ منارَكِ",172,"ك",1,0],["وَيَهْنِيكَ شَهْرٌ عند ذي العرش شاهِدٌ","بأَنك بَرٌّ بالصيام وَصُولُ",173,"ل",1,0],["ويهزها من تحتنا","وعلى مطاها هزنا",174,"ن",2,0],["ويهملها إلا امرؤ ضل عاصياً","وأنى لها الإهمال وهي تمائم",175,"م",1,0],["ويهز آلاف المشاعر بعدما","ماتت من التغرير والبهتان",176,"ن",1,0],["ويهتزُّ للمعروف عندَ انْتدائه","تأَوُّدَ غُصنِ البانَة المُتتابعِ",177,"ع",1,0],["ويهتز من غير اغتباقِ مُدامةٍ","وخمر المعالي غير خمر النَّياطل",178,"ل",1,0],["ويهتزُّ للمعروفِ حتى كأنهُ","صفيحةُ نصلٍ أخلصتها الصَّياقل",179,"ل",1,0],["ويهتزُّ ضالُ القاعِ عند مرورهِ","وتقلقُ بالريفِ النَّخيلُ الكوارعُ",180,"ع",1,0],["ويُهَنَّى بكَ حتَّى","شَرَفُ الشَّهْرِ الحَرامِ",181,"م",1,0],["ويهمي نداهُ والسماءُ بخيلةٌ","فيكشف غمَّاء السنين البَوارقِ",182,"ق",1,0],["ويَهْتَزُّ للمعروفِ حتى كأنَّهُ","نَزيفُ مُدامٍ هَيَّجَتهُ المَعالمُ",183,"م",1,0],["ويهْدي سَناهُ الطَّارقين عَشيَّةً","إلى جودهِ من قَبْلِ نارٍ ومَوْقِدِ",184,"د",1,0],["ويهْتَزُّ للمعروفِ حتى كأنَّهُ","قَرا السَّيفِ مهزوزاً بيومِ لقاءِ",185,"ا",2,0],["ويهبُّ فيُهدي نشرَ لمياء موهناً","وأن كان منسوباً إلى البان والزند",186,"د",1,0],["ويهزّهُ شرخُ الشباب كذابلٍ","هزّتهُ راحةُ باسلٍ صنديد",187,"د",1,0],["ويهزُّ عطفيكَ الثناءُ","كأنْ سقيتَ من المدامه",188,"م",2,0],["وَيَهتَزُّ لِلمَعروفِ في طَلَبِ العُلا","لِتُحمَدَ يَوماً عِندَ سَلمى شَمائِلُه",189,"ل",2,0],["وَيَهْنِكُمُ بُسْتانُها فَهُوَ جَنَّةٌ","يُقَصِّرُ عَنْ أَوْصافِها الغُرِّ واصِفُ",190,"ف",1,0],["ويهدم ما شيّدتُهُ وبنيتُهُ","ويَحصُدُ من هذي الحياةِ زُروعي",191,"ع",2,0],["وَيَهونُ عِندي أَنْ تكون مُصَحَّحاً","وَمِنَ الضَّنى حِيكَتْ لجسمي أدرُعي",192,"ع",2,0],["ويهينوني ويحتقروا","علم تحقيقي وإلهامي",193,"م",2,0],["وَيَهرُبُ مِنّا كُلُّ وَحشٍ وَيَنتَهي","إِلى وَحشِنا وَحشُ الفَلاةِ وَيَرتَعُ",194,"ع",1,0],["ويهتَزُّ عند اهتزاز الغصون","ويعجبه ظَبْيُ سِرْبٍ سَرَحْ",195,"ح",1,0],["وَيهْنَ امْتِداحي ابْنَ الأثيرِ فَمدْحُهُ","يُشرِّفهُ مُمْدوحُهُ ويُجمِّلُ",196,"ل",1,0],["ويهنيك يا شمس البلاد وبدرها","بلوغ المنى من كل باغ معاند",197,"د",1,0],["وَيُهلِكُ نَفسَهُ إِن لَم يَنَلها","وَحُقَّ لَهُ سَحيرٌ أَو بَعيجُ",198,"ج",1,0],["ويهزُّ غُصنُ البانِ مِنكِ على النَّقا","فإليَّ من أحدٍ سواكِ تَشَوَّفُ",199,"ف",1,0]]}