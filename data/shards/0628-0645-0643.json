,"https://www.poetsgate.com/ViewPoem.aspx?id=194246",""],[4578,"حكم العيون من الظماء الغيد","https://www.poetsgate.com/ViewPoem.aspx?id=49401",""],[669,"وكان له أخا وأمين غيب","https://www.poetsgate.com/ViewPoem.aspx?id=18383",""],[4935,"شوقي إلى تلك السجايا العالية","https://www.poetsgate.com/ViewPoem.aspx?id=129478",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5189,"مكة","https://www.poetsgate.com/ViewPoem.aspx?id=195284",""],[5397,"عذبت لنظرة عينك الأرياف","https://www.poetsgate.com/ViewPoem.aspx?id=157965",""],[5561,"هو خيرةٌ من خيرةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193807",""],[5910,"بِمكةَ نورٌ قد سَرَى وضياءُ","https://www.poetsgate.com/ViewPoem.aspx?id=206977",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[5956,"نحيا معاً في بلدة ميمونة","https://www.poetsgate.com/ViewPoem.aspx?id=194002",""],[5956,"يتسلل النور الجميل لمهجتي","https://www.poetsgate.com/ViewPoem.aspx?id=194211",""],[5956,"يا من تُسَمِّي أجملَ الأسماءِ","https://www.poetsgate.com/ViewPoem.aspx?id=205262",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6337,"واهاً لسحركِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81412&r=&rc=24",""]],"verses":[["بِمَكارِمٍ غُرَّ الوُجوهِ تُنيلُها","وَمَقاوِمٍ غُلبِ الرِقابِ تَقَومُها",0,"م",3,0],["بِمَكْسِيمُسَ الرَّابِعِ المُجْتَبَى","بِرَاعِي الرُّعَاةِ الرَّشِيدِ الحَكِيمِ",1,"م",1,0],["بِمَكنونَةٍ كَالبيضِ شانَ مُتونَها","مُتونُ الحَصى مِن مُعلَمٍ وَمُعَقَّبِ",2,"ب",1,0],["بِمَكارِمَ تَذرُ السَباسِبَ أَبحُراً","وَعَزائِمٍ تَذرُ البِحارَ وَمُحارِبا",3,"ب",2,0],["بِمَكَّةَ دارِساً دَرَجَت عَلَيهِ","خِلافَ الحَيِّ دَيلُ صَباً دَؤوبِ",4,"ب",1,0],["بِمَ كُنتم في الجاهليّةِ تستع","لون بالنصرِ حين يحمَى الصِّدامُ",5,"م",1,0],["بِمكَّةَ لي مالٌ كثيرٌ مُوزَّعٌ","أخافُ عليهِ أن يضيعَ وَيُفقدا",6,"د",2,0],["بمكّة سَمّى الطليقَ الطليقَ","ففرّقَ بين القَصا والدَّنى",7,"ا",1,0],["بِمَ كان يُنْصرُ خالدٌ؟ ألأنَّهُ","من جَنْدَل، لا من تراب صُوِّرا؟",8,"ر",2,0],["بِمَكْنُونَة ٍ كکلْبَيضِ شَانَ مُتُونَهَا","مُتُونُ الْحَصَى مِنْ مُعْلَمٍ وَمُعَقَّبِ",9,"ب",1,0],["بمكة َ دارساً درجتْ عليهِ،","خلافَ الحيّ، ذيلُ صباً دؤوب",10,"ب",1,0],["بمكتهلِ الآراء لو زاحموا به","جبالَ شَروْرَى لارحَجنَّت صُخورُها",11,"ر",3,0],["بِمَكارِمٍ أَولَيتَها مُتَبَرِّعا","وَجَرائِمٍ أَلغَيتَها مُتَوَرِّعا",12,"ع",2,0],["بِمَكَّةَ إِذ جِئنا كَأَنَّ لِواءَنا","عُقابٌ أَرادَت بَعدَ تَحليقِها خَطفا",13,"ف",2,0],["بمكسب دينارين اني استدنتها","الى مدة تمضي لشهرين مع شهر",14,"ر",1,0],["بمكرم شهد الملائك فضله","هذا وطنة آدم ما صورت",15,"ت",1,0],["بِمَكارِم الاخلاق وَالشرف العلي","فَسَناه ينجد في البلاد وَيتهم",16,"م",1,0],["بِمَكارِمٍ نَصَرَتْ يَداكَ بِها الْعُلى","إِنَّ الْمَكارِمَ لِلْعُلى أَنْصارُ",17,"ر",1,0],["بمكة أو منى حيث اجتماع العهاد","نحظى بنيل المرام منها ونقضي الوطر",18,"ر",1,0],["بمكرمَةٍ إِن قلت فيها قَصيدة","نظمت بِنَظميها قَلائِد لِلمَجدِ",19,"د",1,0],["بمكارِمٍ شهدَتْ عَلَيْهِ بأَنَّهُ","أَنْدى الورى كَفَّاً وأَطيَبُ مَحْتِدا",20,"د",2,0],["بِمكتبة ابنِ زَيدانَ حَلَلتُ","وطَرفي في نَفائِسِها أجَلتُ",21,"ت",1,1],["بمكّة كان مَولدهُ وفيها","لهُ كَم مِن مبان أو وسامِ",22,"م",1,0],["بمكَارِمِ الأخلاقِ كُنْ مُتَخَلقاً","ليفوحَ نشْرُ شَذائِكَ العَطِرِ الشّذِى",23,"ذ",2,1],["بمكَّةَ والبريةُ أهلُ شركٍ","وأَوثانٍ لها البَدَناتُ تُهدى",24,"ا",1,0],["بمكّةَ إذ كانت قريشٌ وغيرُها","تظلُّ لأوثانٍ سجوداً وركعَّا",25,"ع",2,0],["بمكّةَ إن لِقيتُ أبا بُجيْرٍ","صَحيحاً واللّواءُ له يَسيرُ",26,"ر",1,0],["بِمَكة فازَ في حَج بِقَصدِ","وَنالَ مَرامَه بِجنان خُلدِ",27,"د",1,1],["بِمَكّةِ يا ربّي وَبِالحَرمِ الّذي","إِلَهي بِهِ سادَ الحِجاز عَلى نجدِ",28,"د",1,0],["بمكارم تغشى العيون نخالها","تحت الاكف وتلك لا لحدود",29,"د",1,0],["بمكارم عدد النجوم ومنزل","مأوى الكرام وموئل الأضياف",30,"ف",1,0],["بِمَكًَارِمِ الأخلاَقِ والعِلمِ الذي","بَهَرَ العُقُولَ أَنَأرَ نَهجَ المُهتَدِي",31,"د",2,0],["بِمَكارِمٍ دَرَسَت مَكارِمَ حاتَمٍ","وَمَحَت حَديثَ رَبيعَةَ بنِ مُكَدَّمِ",32,"م",1,0],["بِمَكَانِهِ بِزَمانِهِ وَبِشَانِهِ","عالٍ رَفيعٍ أرفَعٍ بَل أمجَدِ",33,"د",1,0],["بمكة إلفي والحصيب به أخي","وفي مصر لي نجل سقته الغمائم",34,"م",1,0],["بمكة ما بين الحطيم وزمزم","شكورا لما أولاه مولاه ذو المنن",35,"ن",1,0],["بمكة لي قديم هوى","علقت به من القدم",36,"م",1,0],["بمكة في حالة تقتضي","في وقتها القبض من العسر",37,"ر",1,0],["بمكارم الاخلاق ان غدروا ندا","ريهم وبالاحسان حيث أساؤوا",38,"ا",1,0],["بمكة والمنصور رهن كما اتى","اخا الوحى داعىربه فتقدما",39,"م",2,0],["بمكتوب صدق لم يغادر شبيهة","وميزان فقه خالصا من مزَيّف",40,"ف",1,0],["بمكارم يهدي السحاب بها إلى ال","روض الغِنى وتراكم الفيضان",41,"ن",1,0],["بمكارم مثل البحار بواهر","أضحت دواء الفقر والإبلاس",42,"س",1,0],["بمكارِمٍ للمَعْلُواتِ يُنيلُها","ومَعالِمٍ للمَكْرُماتِ يُشيدُها",43,"د",3,0],["بمكارم تهمي إذا استمطرتها","غيثا تحدر عن ملث هامي",44,"م",2,0],["بمكرمات بهرت لم توصف","بها انفردت عنك لم تنحرف",45,"ف",1,0],["بمكارمٍ لكَ عَرْفُها أَبداً","فينا يَنُمُّ وعُرفها يُنْمي",46,"م",2,0],["بمكنونهِ قد جاءَ يبدي مظاهراً","بظاهر فضلٍ لا بطيش الغطاريسِ",47,"س",1,0],["بمكانة الشيخ الرئي","س وعزّ رتبته العظيمة",48,"م",2,0],["بِمَكحولَةٍ بِالصابِ طَلَّت كَأَنَّها","كُلى الغَربِ أَتَآهُ طِبابُ المُرَقَّعِ",49,"ع",1,0],["بمكانتي إن الأحق عليمة","كم رحت مطلوبا لكل قسيمة",50,"ه",1,0],["بمكارم الاخلاق ساد فلن ترى","ابدا لها في الجاحدين جحودا",51,"د",2,0],["بمكارم يهدي السحا","ب بها إلى الروض الغنى",52,"ن",2,0],["بمكارم الخُلُق الرفيع تزيّنوا","كحجيج مكّة قدّسوا الأحراما",53,"م",2,0],["بمكانها من فضله السامي ثوت","والعقد أحسن ما يرى في الجيدِ",54,"د",1,0],["بمكة والبرية أهل شرك","وأوثان لها البدنان تهدى",55,"ا",1,0],["بمكارم الأخلاق عزت ذاته","وبحسن آداب ونفس عالية",56,"ي",2,0],["بمكنون مخزون اسمك الأعظم الذي","احتجبت به سبحانه وتعالى سما",57,"م",2,0],["بمكّةَ يَنجلي كربي وهمّي","فلا حزنٌ هناك ولا سقامُ",58,"م",1,0],["بمكره مهما العداة تكاثرت","فله المنايا في الوغى آلاف",59,"ف",1,0],["بمكارمِ الأخلاقِ فازَ مراتباً","لم يدْنُ منها في الخلائقِ ساعيا",60,"ي",2,0],["بِمكةَ نورٌ قد سَرَى وضياءُ","تَنَزَّلَ بالبُشرى فنِعمَ اللواءُ",61,"ا",2,1],["بمكانه الأمن المؤيد وقته","والأرض ارض والسماء سماء",62,"ا",2,0],["بمكارمِ الأخلاقِ يرفل والهدى","هو في غنىً عن أيّما تعريفِ",63,"ف",1,0],["بمكارمِ الأخلاقِ رمز يحتذى","سِيماه في الوجهِ الكريمِ الأنبَلِ",64,"ل",1,0],["بمكارم والأخلاق أنت مثيلهم","كلٌّ بوُسْعه يا أبا الأمناءِ",65,"ا",2,0],["بِمَكَّةَ الإِسلامُ في رَغَدٍ","وَاستُيقنَ الإِيمانُ بِالفَهَمِ",66,"م",1,0],["بمكابدات الجفنِ يطوي نارَهُ","ويرد تموز الحريق شباطا",67,"ط",2,0]]}