{"poems":[[231,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[271,"ضربوا الخيام على الكثيب الاخضر","https://www.aldiwan.net/poem52100.html","الكامل"],[349,"إن كان فعلي له مرادا","https://www.aldiwan.net/poem15746.html","مخلع البسيط"]],"verses":[["وَلَمَدحُهُ أَولى وَأَجدَرُ أَن يُرى","فيهِ الهُدى وَيعانُ فيه مُعاني",0,"ن",2,0],["وَلمدحك الوحي المنزل فصلت","آياته عَن معجزاتك فاشكر",1,"ر",1,0],["وَلَم دَعاني إِلى أُمورٍ","مِنّي لَها الخُلفُ لَيسَ يُحصى",2,"ص",2,0]]}