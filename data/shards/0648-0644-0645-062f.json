{"poems":[[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[276,"ضربوا الخيام على الكثيب الاخضر","https://www.aldiwan.net/poem52100.html","الكامل"],[354,"إن كان فعلي له مرادا","https://www.aldiwan.net/poem15746.html","مخلع البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54122","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122081","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53200","الكامل"],[2705,"","https://poetry.dctabudhabi.ae/diwan/poem/128684","الكامل"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71369","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127204","الكامل"]],"verses":[["وَلَمَدحُهُ أَولى وَأَجدَرُ أَن يُرى","فيهِ الهُدى وَيعانُ فيه مُعاني",0,"ن",2,0],["وَلمدحك الوحي المنزل فصلت","آياته عَن معجزاتك فاشكر",1,"ر",1,0],["وَلَم دَعاني إِلى أُمورٍ","مِنّي لَها الخُلفُ لَيسَ يُحصى",2,"ص",2,0],["ولمدة شئتم بما قد شئتم","إني جعلتُ إليكَ ذاكَ مفوضا",3,"ض",2,0],["وَلِمَدْحِهِ التَّيْسِيرُ دَامَ فَلَمْ يَكُنْ","مَعْنَاهُ لِلأَفْهَامِ بِالمُعْتَاصِ",4,"ص",1,0],["ولمدك الغازي الغياث بجحفل","يمضي بما تقضي عليه وتحكم",5,"م",1,0],["ولمدحكم بين الأجلةِ مُعلِنٌ","وبشكركُم بين الأجلةِ لافِظُ",6,"ظ",1,0],["ولَمْدَمَعِي بُعْداً وَسَحْقاً إِنَّهُ","دُرٌّ لَدَيَّ ولَمْ يَكُنْ فِي عِقْدِهِ",7,"د",2,0],["ولمدحكم أنا تالي","ولسمتكم أنا تالي",8,"ي",1,0]]}