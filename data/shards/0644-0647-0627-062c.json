{"poems":[[9,"غشيت لليلى بليل خدورا","https://www.aldiwan.net/poem21941.html","المتقارب"],[0,"أحار بن عمرو كأني خمر","https://www.aldiwan.net/poem78.html","المتقارب"],[32,"أدارا بحزوى هجت للعين عبرة","https://www.aldiwan.net/poem29554.html","الطويل"],[90,"سيوف لحاظ أم قسي حواجب","https://www.aldiwan.net/poem44401.html","الطويل"],[90,"أن بليلا من نسيم السحر","https://www.aldiwan.net/poem44414.html","الرجز"],[90,"حياكم الله أيها العرب","https://www.aldiwan.net/poem44469.html","المنسرح"],[53,"لها جبهة فيها سطوح نصيف","https://www.aldiwan.net/poem65480.html","الطويل"],[64,"خذ العلم عن قرب ونكب عن البعد","https://www.aldiwan.net/poem52138.html","الطويل"],[64,"هم الحي ما بين العذيب إلى الرمل","https://www.aldiwan.net/poem52322.html","الطويل"],[47,"أجدك إن لمات الخيال","https://www.aldiwan.net/poem65568.html","الطويل"],[30,"لقد هتك العبد الطرماح ستره","https://www.aldiwan.net/poem4964.html","الطويل"],[48,"يحاول طينا أرمنيا لعله","https://www.aldiwan.net/poem23338.html","الطويل"],[90,"سيوف لحاظ أم قسي حواجب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19571&r=&rc=74",""],[185,"ألا طرقت أميمة بعدض هدء","https://www.aldiwan.net/poem58888.html","الوافر"],[457,"سواي استمالته الظباء الأوانس","https://www.aldiwan.net/poem13805.html","الطويل"],[463,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[510,"المفر","https://www.aldiwan.net/poem27797.html","الوافر"],[548,"أيا تملك يا تمل","https://www.aldiwan.net/poem1760.html","الهزج"],[558,"تداعت خطوب الدهر عن جار جعفر","https://www.aldiwan.net/poem68416.html","الطويل"],[583,"أتهجر أم لا اليوم من أنت عاشقه","https://www.aldiwan.net/poem710.html",""],[592,"على الدين فليبكي ذوو العلم والهدى","https://www.aldiwan.net/poem11555.html","عموديه"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66833","السريع"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/103989","الطويل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44566","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37731","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62571","الوافر"],[1311,"","https://poetry.dctabudhabi.ae/diwan/poem/145432","الطويل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87837","الطويل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45572","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115482","الطويل"],[3344,"","https://poetry.dctabudhabi.ae/diwan/poem/146483","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88912","الطويل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101217","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66348","الطويل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66544","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59508","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135158","المجتث"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94727","الوافر"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81939","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52142","المتقارب"],[4941,"كأسٌ لانقراض ساعي البريد","https://www.poetsgate.com/ViewPoem.aspx?id=178743",""],[5092,"أنثايَ","https://www.poetsgate.com/ViewPoem.aspx?id=180133",""],[3591,"ضعفٌ ألم بقلبي بعدما ارتحلا","https://www.poetsgate.com/ViewPoem.aspx?id=149393",""],[3591,"من التلاقي قضيت السؤل والطلبا","https://www.poetsgate.com/ViewPoem.aspx?id=149403",""],[5376,"يا جلق المجد والعلياء من زمن","https://www.poetsgate.com/ViewPoem.aspx?id=188535",""],[5526,"مفاهيم وجدال","https://www.poetsgate.com/ViewPoem.aspx?id=201189",""],[5542,"قراءة في وجة امرأة شو هاء..!","https://www.poetsgate.com/ViewPoem.aspx?id=1655",""],[5829,"جنة الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=151690",""],[5842,"جنة الدنيا/زهير شيخ تراب","https://www.poetsgate.com/ViewPoem.aspx?id=152687",""],[5937,"الأوركيديّة","https://www.poetsgate.com/ViewPoem.aspx?id=211800",""],[5937,"قانون جذبها","https://www.poetsgate.com/ViewPoem.aspx?id=211881",""],[6068,"لهاجر -02-","https://www.poetsgate.com/ViewPoem.aspx?id=175948",""]],"verses":[["لَها جَرَسٌ كَحَفيفِ الحَصا","دِ صادَفَ بِاللَيلِ ريحاً دَبورا",0,"ر",2,0],["لَها جَبهَةٌ كَسَراةِ المِجَنِّ","حَذَّفَهُ الصانِعُ المُقتَدِر",1,"ر",1,0],["لَها جيدُ أُمِّ الخَشفِ ريعَت فَأَتلَعَت","وَوَجهٌ كَقَرنِ الشَمسِ رَيّانُ مُشرِقُ",2,"ق",1,0],["لها جيد ظبيٍ واعتدال وشيجة","وعين مهاة وائتلاق الكواكب",3,"ب",1,0],["لها جناح هي منه ارتدت","ملاءةً مَوشيّةً من حرير",4,"ر",1,0],["لها جبين كأنه قمر","تحت شعور كأنها الذهب",5,"ب",1,0],["لها جبهة فيها سطوح نصيفِ","وصدغ لها غال بنصف رغيفِ",6,"ف",1,1],["لها جريان بارك الله فيهما","إذا اجتمعا صارا على هيئة الزبدِ",7,"د",1,0],["لها جَمَّةٌ يستغزرُ النزحُ فيضَها","وليس لها إلّا اليراعةَ من حَبْلِ",8,"ل",1,0],["لَها جيدُ الغَزالِ وَمُقلَتاهُ","وَلَم تُلمِم بِشِبهِ شَوى الغَزالِ",9,"ل",1,0],["لَها جَبهَةٌ كَالفِهرِ يُندي إِطارُها","إِذا وَرِمَت أَلغادُها وَاِشمَخَرَّتِ",10,"ت",1,0],["لَهُ أَجلٌ إِن حانَ لَم تَثنِهِ الرُقى","وَإِن لَم يَحِن لَم يَخشَ مِن شُربِهِ السُمّا",11,"م",2,0],["لها جيد ظبى واعتدال وشيحة","وعين مَهاة وائتلاق الكواكب",12,"ب",1,0],["لَها جِيدُ الغَزالِ وَمُقلتاهُ","وعالِى النَّبتِ مَيّالُ العُقُوصِ",13,"ص",1,0],["لها جدول كالأديم أبيض ناصِع","وعند سقوط الشمس أصفر وارس",14,"س",1,0],["لها جانب من خوفهم متسهِّلٌ","وآخر يرجو أن تَداركه وعرُ",15,"ر",1,0],["لها جوفٌ إذا ضاقتْ بقومٍ","أَحلَّهمُ الإلهُ لها فخرُّوا",16,"ر",3,0],["لَها جِسمٌ مِنَ الحَلمِ","عَلى روحٍ مِنَ الجَهلِ",17,"ل",1,0],["لَهاجِسُ نَفسٍ تَرتَجيكَ ظُنونُها","أَرَدُّ لَها مِن عُرفِ آخَرَ بَاذِلُه",18,"ل",2,0],["لَهُ أَجَلٌ ساعٍ لَهُ لا مُؤَخَّراً","إِذا جاءَ مَحتوماً وَلا هُوَ سابِقُهْ",19,"ق",2,0],["له أجر خمسين امرئ من ذوي الهدى","من الصحب أصحاب النبي الأكارم",20,"م",1,0],["لها جَنى من كلّ ما يُشتهى","من فاقع أصفر أو قانِ",21,"ن",1,0],["لها جَسَدَ مَن خالصِ التَّبرِ جامدٌ","يُناطُ إلى رأسٍ منَ التَّبرِ ذائبِ",22,"ب",1,0],["لَها جُيوشٌ مِنَ المَلاهي","لِلهَمِّ قُدّامَها الفِرارُ",23,"ر",1,0],["لَها جَسَدٌ بِاللُّطفِ يُنعَتُ حَجمهُ","مِنَ الرّيحِ قَدْ يدمى بِمَحْضِ تَنسُّمِ",24,"م",1,0],["لها جِيد كجيد الريم لكن","تحلى جيدها بعقود دُرِّ",25,"ر",1,0],["لها جيد آرام وأعجاز مسحل","وأعطاف ثعبان وألحاظ تدرج",26,"ج",1,0],["لَهُ أَجنُحٌ مِن خالِصِ الصُلبِ رُكِّبَت","عَلى هَيكَلٍ قَد حارَ في أَمرِهِ الفَهمُ",27,"م",1,0],["لَها جيد ظَبي وَاهتِزاز يَراعة","وَعَيناً مَهاةٍ وَاعِتِدال قَضيب",28,"ب",1,1],["لها جسدٌ ميتٌ يعيش بنفخةٍ","متى دخلتهُ الريح صارت به روحا",29,"ح",2,0],["لها جسدٌ ما بين روحين يَغتدي","فلولاهما كان الترهّب دينَها",30,"ه",2,0],["لهاجيه أجر ما يشا حال أحمق","محال أحاشي أمر جاهي جاهل",31,"ل",1,0],["لها جعود كليل الهجر فاحمة","لها جبين كصبح الوصل في الرتب",32,"ب",1,0],["لها جيرة قد أرضعوا النفس وصلهم","فأودى بها بعد الرضاع فطامها",33,"م",3,0],["لَها جُفونٌ وَأعْطافٌ عَجِبْتُ لَها","بِالسُّقْمِ صَحَّتْ وَبِالسُّكْرِ الشَّديدِ صَحَتْ",34,"ت",1,0],["لها جبين كبدر السعد تمَّ له","تسع وخمس وليل الفرعِ ديمومُ",35,"م",1,0],["له أجىء بوعد","والنص منه حكيم",36,"م",1,0],["لها جفنٌ لئِن نظرت بشزرٍ","يغادر في الحشاشة ألف نبلَه",37,"ل",2,0],["لها جسدٌ بالوهم يدنو وقلبها","على لينه أقسى من الحجر الصلد",38,"د",1,0],["لها جَناحٌ مِن شِراعٍ خافِقٍ","تَطيرُ في الماءِ بِهِ لافى المَلا",39,"ا",1,0],["لهاجرته غيرَ ذي أوبةِ","فما نتلاقى على موعِدِ",40,"د",1,0],["لهُ أجرانِ حينَ يخوضُ حرباً","وإنْ نَفِدَ الجنودُ ينالُ أجْرا",41,"ر",2,0],["لها جمالٌ غدا يستأسرُ المُقلا","هذي الرموشُ إذا اهتزّتْ عَلَتْ خجلا",42,"ل",2,1],["لها جملا الغواني إنما رجلاً","عدت وافتكها ماشابهت رجلا",43,"ل",2,0],["لها جمال بذاكش الوجه أكبر من","تزوجٍ بفتىً أثماً وسما وأبا",44,"ب",2,0],["لها جمال يضاهي الكون أكمله","كالروح والجسم بالوجدان ما زالا",45,"ل",2,0],["له اجابه تبغى منطق أو قليل من الخيال","بين عارف وبين جاهل من هو غارق في نعيمه ؟",46,"م",2,0],["لها جواسيسها في كلّ ناحية ٍ","فلا تسلْ عن إشاراتٍ وتحديق",47,"ق",1,0],["لها جند من الرحمن منبعثٌ","وأوصاف تباهى فيه من باهى",48,"ا",3,0],["لها جند من الرحمن مبعوث","وأوصاف تباهى فيه من باهى",49,"ا",3,0],["لها جسدٌ في الرداء تخبأ","حتى تخبأَ فيهِ الرِّداء",50,"ا",2,0],["لها جسدٌ كالدولةِ ، الحكم حكمهُ","ومن حكمهِ أنَّ الشقاء بقربِهِ",51,"ب",2,0],["لهاجر إن نسيتِ فلستُ أنسى","غراما يستفيض ولا يغيضُ",52,"ض",1,1]]}