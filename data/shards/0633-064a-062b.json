{"poems":[[94,"تسائلني ما لي سكت ولم أهب","https://www.aldiwan.net/poem38913.html","الطويل"],[47,"بعينيك ضوء الأقحوان المفلج","https://www.aldiwan.net/poem62674.html","الطويل"],[82,"تفشي يداك سرائر الأغماد","https://www.aldiwan.net/poem31483.html","الكامل"],[54,"سلمت أمير المؤمنين على الدهر","https://www.aldiwan.net/poem27019.html","الطويل"],[520,"عنان الليالي في يديك مسلم","https://www.aldiwan.net/poem12275.html","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202077","المتقارب"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50012","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100974","الوافر"],[2354,"","https://poetry.dctabudhabi.ae/diwan/poem/145230","الطويل"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32379","الكامل"],[5031,"دموع أهلي من ياقوت","https://www.poetsgate.com/ViewPoem.aspx?id=165141",""],[5092,"اغضب","https://www.poetsgate.com/ViewPoem.aspx?id=178241",""],[5410,"انتظار","https://www.poetsgate.com/ViewPoem.aspx?id=139635",""],[5966,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=158305",""],[6125,"سَيُثمِرُ صَبرُنَا","https://www.poetsgate.com/ViewPoem.aspx?id=210721",""],[5309,"في نظام مرصع الأصفاد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573552",""]],"verses":[["سيثأرُ للعزِّ المحطّم تاجُهُ","رجالٌ إِذا جاشَ الرَّدى فهُمُ هُمُ",0,"م",1,0],["سَيُثلِجُ صَدري اليَأسُ وَاليَأسُ مَنهَلٌ","مَتى تَغتَرِف مِنهُ الجَوانِحُ تَثلَجِ",1,"ج",1,0],["سَيُثيرُ مِنكَ العَزمُ بأساً مُهلكاً","والنارُ تَنبعُ عن قِداحِ زنادِ",2,"د",1,0],["سَيُثني عَلَيهِ مِن مَحاسِنِ قَصرِهِ","مَدائِحَ لَيسَت مِن كَلامٍ وَلا شِعرِ",3,"ر",1,0],["سيثني عليكم ضيفكم وغريبكم","ثناء جميلاً والزمان له فم",4,"م",1,0],["سَيَثْنِى إليَّ عِنَانَ الَهوَى","وَلوْ بَعْدَ حِينٍ فَصَبْراً جميلا",5,"ل",2,0],["سيثني عليَّ الحاسدون إِذا خلت","قُلوبهم من بغضتي وبدا فضلي",6,"ل",2,0],["سيثمر بيننا فتحاً قريباً","وكم للخير بالخير افتتاح",7,"ح",1,0],["سيثري زماناً أو سيرمل تارةً","ولم تنقطع في حالتيه نوافله",8,"ل",2,0],["سَيُثيبُني أَخرى سِوا","كِ وَتِلكَ لي مِنهُ يَسيرَه",9,"ر",2,0],["سَيُثْمِرُ الصَّبْرُ مِنْ آلامِهِمْ وَطَنَاً","حُلْوَاً وَإنْ كانَ مَعْجُونَاً بِمَنْ كَفَرُوا",10,"ر",3,0],["سيثورُ فوق الصمت موجُ قصيدتي","ويشبُّ فيها حرقةٌ تنثالُ !",11,"ل",1,0],["سيثري عمرنا لنرى","مدى أحلامنا بحرا",12,"ر",2,0],["سيثورُ شعبٌ في عزائمِ قوةٍ","دستورهُ التوحيدُ والقرآنُ",13,"ن",1,0],["سَيُثمِرُ صَبرُنَا المَيمُونُ زَهرًا","وتُشرِقُ في مَرَابِعِنَا الأقَاحِي",14,"ي",1,1],["سَيَثورُ العَبيدُ ضِدَّ طُغاةٍ","حَرَموهُم بِالفَقرِ طيبَ الرُّقادِ",15,"د",1,0]]}