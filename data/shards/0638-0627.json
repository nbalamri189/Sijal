{"poems":[[53,"ما لذا الداني إلى القلب شحط","https://www.aldiwan.net/poem30161.html","الرمل"],[77,"هدم السد وهو ما هو فار","https://www.aldiwan.net/poem36415.html","الخفيف"],[71,"خبروها بأنه ما تصدى","https://www.aldiwan.net/poem4014.html","الخفيف"],[93,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[88,"دع مزعج اللوم وخل العتاب","https://www.aldiwan.net/poem44807.html","السريع"],[37,"ظارتهم بعصا وياعجبا","https://www.aldiwan.net/poem7190.html","مجزوء الكامل"],[72,"عجبت خلتي لوخط مشيبي","https://www.aldiwan.net/poem18228.html","الخفيف"],[51,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"يا سيدا لم يلتبس عرضه","https://www.aldiwan.net/poem62000.html","السريع"],[51,"تبارك الله خالق الكرم البارع","https://www.aldiwan.net/poem65517.html","المنسرح"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[12,"إن بالشعب الذي دون سلع","https://www.aldiwan.net/poem1231.html",""],[43,"جاء نيروزنا وأنت مراده","https://www.aldiwan.net/poem9556.html","الخفيف"],[45,"بات عهد الصبا وباقي جديده","https://www.aldiwan.net/poem63465.html","الخفيف"],[61,"عاف الوقوف على المحل العافي","https://www.aldiwan.net/poem51546.html","الكامل"],[61,"يا أبا إسحاق زاد الله","https://www.aldiwan.net/poem51668.html","مجزوء الرمل"],[66,"ظفرت سهام فواتر الألحاظ","https://www.aldiwan.net/poem38485.html","الكامل"],[66,"في الكيس لا في الكأس لي قهوة","https://www.aldiwan.net/poem38642.html","السريع"],[13,"إنا بالشعب الذي دون سلع","https://www.aldiwan.net/poem2182.html","المديد"],[76,"ظالمتي في الهوى لا تظلمي","https://www.aldiwan.net/poem38980.html","مجزوء البسيط"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141029",""],[71,"","https://poetry.dctabudhabi.ae/diwan/poem/28967","الخفيف"],[100,"حَنِين","https://www.poetsgate.com/ViewPoem.aspx?id=199745",""]],"verses":[["ظالِمٌ قُلِّدَ أَحكامَ الهَوى","طالَما جارَ عَلينا وَقَسَط",0,"ط",1,0],["ظاهرُ الشُّؤمِ في جَميعِ المَناحي","خبَرٌ لمْ يغُضَّ منْهُ اخْتبارُ",1,"ر",1,0],["ظاهِرُ الفَضلِ طاهِرُ الأَصلِ سَب","اقٌ إِلى المَجدِ لَيسَ يَضمِرُ حِقدا",2,"د",2,0],["ظَاهِرُ القَوْلِ قَدْ يُرَى نَزِقاً وَالرَّ","أْيُ فِي غَوْرِهِ البَعِيدِ رَزِينُ",3,"ن",1,0],["ظاهرها فيه لنا رحمةٌ","والويل في باطنها والعذاب",4,"ب",1,0],["ظَارْتهم بعصا ويا","عجباً لمظؤور وظائرْ",5,"ر",1,1],["ظاهرٌ دون باطنٍ مستجار","ليت حالي يكون بالمقلوب",6,"ب",1,0],["ظالماً لي مع الزمانِ الذي ابتَز","زَ حقوقَ الكرام للُّؤماءِ",7,"ا",2,0],["ظالماً أو مُقَوِّماً ثم يرعا","هُ ويَقْنَى حُرِّيّةً وحياءَ",8,"ا",2,0],["ظاهرُهُ أحسنُ من غيبه","وغيبُه أحسن من ظاهرِهْ",9,"ر",2,0],["ظاهره ظاهر يحرِّمُه","وما على شاربيه من رهق",10,"ق",1,0],["ظاهرتْ شِكَّةً عليها بأخرى","لامرئٍ غير مُؤْذنٍ بقتالِ",11,"ل",1,0],["ظاهرَ الأولياءُ منك ظهيراً","ناصحَ الجيب غيرَ ذي إدغالِ",11,"ل",1,0],["ظَاعِنٌ بالحَزمِ حَتّى إِذا ما","حَلَّ حَلَّ الحَزمُ حَيث يَحُلُّ",12,"ل",1,0],["ظالِمُ الجودِ كُلَّما حَلَّ رَكبٌ","سيمَ أَن تَحمِلَ البِحارَ مَزادُه",13,"د",2,0],["ظاهَرَت مِن عَتادِهِ تَغلِبُ الغُل","بُ لِمَجدٍ وَكَثَّرَت مِن عَديدِه",14,"د",2,0],["ظَامٍ إلى الوَجَنَاتِ يُوِردُهُ الرَّدَى","وَرْدٌ بها يُجنى بغيرِ قِطافِ",15,"ف",1,0],["ظاهراً للحمدِ تُنبي","هِ على بُعْدِ ظَهيرِكْ",16,"ك",1,0],["ظَأبُ الحُداةِ يَحُثُّها فَإِذا وَنَت","تَفنى بِزَجرِ حُداتِها الأَفظاظِ",17,"ظ",1,0],["ظامٍ إِلى نَهلِ الدِماءِ فَهَمُّهُ","يَومَ الهِياجِ تَشَتُّتُ الأَشواظِ",17,"ظ",1,0],["ظاهِرَةُ النَفعِ لَها نَشوَةٌ","تَستَنقِذُ الأَنفُسَ مِن هَمِّها",18,"م",3,0],["ظاعِنُ بِالحَزمِ حَتّى إِذا ما","حَلَّ الحَزمُ حَيثُ يَحُلُّ",19,"ل",1,0],["ظالمتي في الهوى لا تَظلمي","فتَصْرمي حَبلَ مَنَ لم يصْرِمِ",20,"م",1,1],["ظالم الجود كلّما حلّ ركبٌ","سيم أن يحمل البحار مزاده",21,"د",2,0],["ظاهِرُ الفَضلِ طاهِرُ الأَصلِ سَب","باقٌ إِلى المَجدِ لَيسَ يَضمِرُ حِقدا",22,"د",2,0],["ظَامِئٌ والكُؤوسُ عَطْشَى ومَلأَى","كَمَرَايَا تَهْفُو إلى وَجْهِ مَرْأَى",23,"ا",2,1]]}