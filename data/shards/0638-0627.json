{"poems":[[53,"ما لذا الداني إلى القلب شحط","https://www.aldiwan.net/poem30161.html","الرمل"],[77,"هدم السد وهو ما هو فار","https://www.aldiwan.net/poem36415.html","الخفيف"],[71,"خبروها بأنه ما تصدى","https://www.aldiwan.net/poem4014.html","الخفيف"],[93,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[88,"دع مزعج اللوم وخل العتاب","https://www.aldiwan.net/poem44807.html","السريع"],[37,"ظارتهم بعصا وياعجبا","https://www.aldiwan.net/poem7190.html","مجزوء الكامل"],[72,"عجبت خلتي لوخط مشيبي","https://www.aldiwan.net/poem18228.html","الخفيف"],[51,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"يا سيدا لم يلتبس عرضه","https://www.aldiwan.net/poem62000.html","السريع"],[51,"تبارك الله خالق الكرم البارع","https://www.aldiwan.net/poem65517.html","المنسرح"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[12,"إن بالشعب الذي دون سلع","https://www.aldiwan.net/poem1231.html",""],[43,"جاء نيروزنا وأنت مراده","https://www.aldiwan.net/poem9556.html","الخفيف"],[45,"بات عهد الصبا وباقي جديده","https://www.aldiwan.net/poem63465.html","الخفيف"],[61,"عاف الوقوف على المحل العافي","https://www.aldiwan.net/poem51546.html","الكامل"],[61,"يا أبا إسحاق زاد الله","https://www.aldiwan.net/poem51668.html","مجزوء الرمل"],[66,"ظفرت سهام فواتر الألحاظ","https://www.aldiwan.net/poem38485.html","الكامل"],[66,"في الكيس لا في الكأس لي قهوة","https://www.aldiwan.net/poem38642.html","السريع"],[13,"إنا بالشعب الذي دون سلع","https://www.aldiwan.net/poem2182.html","المديد"],[76,"ظالمتي في الهوى لا تظلمي","https://www.aldiwan.net/poem38980.html","مجزوء البسيط"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141029",""],[71,"","https://poetry.dctabudhabi.ae/diwan/poem/28967","الخفيف"],[100,"حَنِين","https://www.poetsgate.com/ViewPoem.aspx?id=199745",""],[118,"ظامئ","https://www.aldiwan.net/poem24063.html","الرمل"],[133,"صاحب الرحل والقلوص الرسوما","https://www.aldiwan.net/poem54652.html","الخفيف"],[144,"أما الفراق فقد عاصيته فأبى","https://www.aldiwan.net/poem11718.html","البسيط"],[151,"ظمئت وأجفاني بدمعي فيض","https://www.aldiwan.net/poem68560.html","الطويل"],[156,"ظالمي في كل حال","https://www.aldiwan.net/poem55581.html","مجزوء الرمل"],[161,"شكرك فرض من فروض العين","https://www.aldiwan.net/poem58911.html","الرجز"],[196,"لمن الدار مثل خط الكتاب","https://www.aldiwan.net/poem54424.html","الخفيف"],[199,"ألف ألا انعم بالمحبة حالا","https://www.aldiwan.net/poem51903.html","الكامل"],[212,"جاد بالوعد في زمان بخيل","https://www.aldiwan.net/poem46272.html","الخفيف"],[236,"من مجيري ومن يجير على ذي","https://www.aldiwan.net/poem31606.html","الخفيف"],[236,"حان إسفار الصباح","https://www.aldiwan.net/poem32120.html","مجزوء الرمل"],[238,"أبناء فاس من يفارقهم","https://www.aldiwan.net/poem19524.html","السريع"],[251,"أيهذا الأمير قد أشكل المعنى","https://www.aldiwan.net/poem15043.html","الخفيف"],[253,"عاتباه في فرط ظلمي وهجري","https://www.aldiwan.net/poem1426.html",""],[255,"ناكر ذاك الحبيب","https://www.aldiwan.net/poem25011.html","مجزوء الرمل"],[255,"ظالم يامن قلاني","https://www.aldiwan.net/poem36221.html","مجزوء الرمل"],[299,"صنع الجميل وفعل الخير إن أثرا","https://www.aldiwan.net/poem36309.html","عموديه"],[299,"ساجع حن إلى ذات جناح","https://www.aldiwan.net/poem36843.html","عموديه"],[305,"نعم عالم الأرواح خير من الجسم","https://www.aldiwan.net/poem16860.html","الطويل"],[306,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[339,"أيها المغرور مهلا","https://www.aldiwan.net/poem68714.html","مجزوء الرمل"],[350,"أمرتني بستر كشف غطائي","https://www.aldiwan.net/poem15499.html","الخفيف"],[350,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[354,"مستهام رق وانتحبا","https://www.aldiwan.net/poem40811.html","المديد"],[372,"كم نهتهم صبابتي وغرامي","https://www.aldiwan.net/poem57128.html","الخفيف"],[372,"ظالم مظلم العذارين في إشراق","https://www.aldiwan.net/poem57150.html","الخفيف"],[378,"دهرنا قد تزندقا","https://www.aldiwan.net/poem59319.html","مجزوء الخفيف"],[394,"ألف أمير المؤمنين علي","https://www.aldiwan.net/poem53656.html","الكامل"],[403,"مولاي صبرا للقضا","https://www.aldiwan.net/poem46509.html","مجزوء الكامل"],[407,"أوقد البين في الخميس خميسا","https://www.aldiwan.net/poem50154.html","الخفيف"],[417,"راق للأبصار حسنا وجمالا","https://www.aldiwan.net/poem53914.html","الرمل"],[417,"قام يجلوها وبرد الليل معلم","https://www.aldiwan.net/poem54025.html","الرمل"],[430,"عج إلى منزل قصف","https://www.aldiwan.net/poem40702.html","مجزوء الرمل"],[449,"شوقي إليكم مثل وجدي فيكم","https://www.aldiwan.net/poem53724.html","الكامل"],[459,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[459,"عثرت يوم العذيب فاستقل","https://www.aldiwan.net/poem55993.html","المنسرح"],[462,"هبني كتمت لواعج البرحاء","https://www.aldiwan.net/poem15279.html","الكامل"],[465,"قسماً لقد أملى أحاديث الغضا","https://www.aldiwan.net/poem3531.html","عموديه"],[476,"هل تعرف المنزل بالأهيل","https://www.aldiwan.net/poem1825.html","السريع"],[516,"قل لمن يرتجي طنين الرباب","https://www.aldiwan.net/poem12023.html","الخفيف"],[516,"قولا لنجم الدين يا خير من","https://www.aldiwan.net/poem12103.html","السريع"],[552,"ريعت لتنعاب الغراب الهاتف","https://www.aldiwan.net/poem47390.html","الكامل"],[559,"نقطة النفس فوق عين الإله","https://www.aldiwan.net/poem33618.html","الخفيف"],[559,"ظاهر لا يكون أظهر منه","https://www.aldiwan.net/poem33713.html","الخفيف"],[559,"هو ما هو وأنا ما هو أنا","https://www.aldiwan.net/poem33764.html","الرمل"],[559,"لي وجود بمن يقول أنا","https://www.aldiwan.net/poem33776.html","الخفيف"],[559,"نحن قوم نهوى الوجوه الحسانا","https://www.aldiwan.net/poem33816.html","الخفيف"],[559,"قل لعباد الخيال","https://www.aldiwan.net/poem34200.html","مجزوء الرمل"],[559,"ربنا الله ذلك المتعالي","https://www.aldiwan.net/poem34231.html","الخفيف"],[559,"أعط طرفا له وللكون طرفا","https://www.aldiwan.net/poem34343.html","الخفيف"],[559,"هذه الآيات والسور","https://www.aldiwan.net/poem34487.html","المديد"],[559,"ظاهر ومن يعشقه عن رؤيته محجوب","https://www.aldiwan.net/poem34969.html","المواليا"]],"verses":[["ظالِمٌ قُلِّدَ أَحكامَ الهَوى","طالَما جارَ عَلينا وَقَسَط",0,"ط",1,0],["ظاهرُ الشُّؤمِ في جَميعِ المَناحي","خبَرٌ لمْ يغُضَّ منْهُ اخْتبارُ",1,"ر",1,0],["ظاهِرُ الفَضلِ طاهِرُ الأَصلِ سَب","اقٌ إِلى المَجدِ لَيسَ يَضمِرُ حِقدا",2,"د",2,0],["ظَاهِرُ القَوْلِ قَدْ يُرَى نَزِقاً وَالرَّ","أْيُ فِي غَوْرِهِ البَعِيدِ رَزِينُ",3,"ن",1,0],["ظاهرها فيه لنا رحمةٌ","والويل في باطنها والعذاب",4,"ب",1,0],["ظَارْتهم بعصا ويا","عجباً لمظؤور وظائرْ",5,"ر",1,1],["ظاهرٌ دون باطنٍ مستجار","ليت حالي يكون بالمقلوب",6,"ب",1,0],["ظالماً لي مع الزمانِ الذي ابتَز","زَ حقوقَ الكرام للُّؤماءِ",7,"ا",2,0],["ظالماً أو مُقَوِّماً ثم يرعا","هُ ويَقْنَى حُرِّيّةً وحياءَ",8,"ا",2,0],["ظاهرُهُ أحسنُ من غيبه","وغيبُه أحسن من ظاهرِهْ",9,"ر",2,0],["ظاهره ظاهر يحرِّمُه","وما على شاربيه من رهق",10,"ق",1,0],["ظاهرتْ شِكَّةً عليها بأخرى","لامرئٍ غير مُؤْذنٍ بقتالِ",11,"ل",1,0],["ظاهرَ الأولياءُ منك ظهيراً","ناصحَ الجيب غيرَ ذي إدغالِ",11,"ل",1,0],["ظَاعِنٌ بالحَزمِ حَتّى إِذا ما","حَلَّ حَلَّ الحَزمُ حَيث يَحُلُّ",12,"ل",1,0],["ظالِمُ الجودِ كُلَّما حَلَّ رَكبٌ","سيمَ أَن تَحمِلَ البِحارَ مَزادُه",13,"د",2,0],["ظاهَرَت مِن عَتادِهِ تَغلِبُ الغُل","بُ لِمَجدٍ وَكَثَّرَت مِن عَديدِه",14,"د",2,0],["ظَامٍ إلى الوَجَنَاتِ يُوِردُهُ الرَّدَى","وَرْدٌ بها يُجنى بغيرِ قِطافِ",15,"ف",1,0],["ظاهراً للحمدِ تُنبي","هِ على بُعْدِ ظَهيرِكْ",16,"ك",1,0],["ظَأبُ الحُداةِ يَحُثُّها فَإِذا وَنَت","تَفنى بِزَجرِ حُداتِها الأَفظاظِ",17,"ظ",1,0],["ظامٍ إِلى نَهلِ الدِماءِ فَهَمُّهُ","يَومَ الهِياجِ تَشَتُّتُ الأَشواظِ",17,"ظ",1,0],["ظاهِرَةُ النَفعِ لَها نَشوَةٌ","تَستَنقِذُ الأَنفُسَ مِن هَمِّها",18,"م",3,0],["ظاعِنُ بِالحَزمِ حَتّى إِذا ما","حَلَّ الحَزمُ حَيثُ يَحُلُّ",19,"ل",1,0],["ظالمتي في الهوى لا تَظلمي","فتَصْرمي حَبلَ مَنَ لم يصْرِمِ",20,"م",1,1],["ظالم الجود كلّما حلّ ركبٌ","سيم أن يحمل البحار مزاده",21,"د",2,0],["ظاهِرُ الفَضلِ طاهِرُ الأَصلِ سَب","باقٌ إِلى المَجدِ لَيسَ يَضمِرُ حِقدا",22,"د",2,0],["ظَامِئٌ والكُؤوسُ عَطْشَى ومَلأَى","كَمَرَايَا تَهْفُو إلى وَجْهِ مَرْأَى",23,"ا",2,1],["ظامئٌ والعَذْبُ يَجري سَلْسَلًا","صابرٌ والصَّبرُ مِن حَوضِ جَهَنَّم",24,"م",1,0],["ظَالما خائنَ الأمانة وَغداً","فَاسِقاً جاهِلاً عُتِّلاً زَنِيمَا",25,"م",2,0],["ظافَرتَ مالِكَهُ دامَت سَعادَتُهُ","بِمَحضِ وُدٍّ أَزالَ الشَكَّ وَالرِيَبا",26,"ب",2,0],["ظَأرتُ عَلَى وَعظِ النَّصِيح مَسامِعاً","لها ألسُنٌ للحَألِ في الحُبِّ أوعَظُ",27,"ظ",1,0],["ظالِمي في كُلِّ حَالِ","عَاشِقٌ هَجْرَ وِصالِي",28,"ل",2,1],["ظاهرة للناس مثل العين","حتى غدوت عندهم بعين",29,"ن",1,0],["ظاهِرو الأُنسِ وَالعَفافِ إِذا","ما لُّزَّ بَينَ البُيوتِ بِالأَطنابِ",30,"ب",1,0],["ظاء ظللنا تحت ظلِّ مودة","في روض أنس نجتني الآمالا",31,"ل",2,0],["ظالت أنت يا مشيبي فقل لي","ما دواعي المشيب ما الأسباب",32,"ب",1,0],["ظالِمٌ إِن مَدَحتُهُ لَم أَنَل خَي","راً وَإِن لَم أَمدَحهُ خِفتُ أَذاهُ",33,"ا",2,0],["ظالِمٌ يَبلُغُ أَقصى ال","جِدِّ مِنّي بِالزاحِ",34,"ح",1,0],["ظَاهِرُهُمْ أَرْيٌ صَفَا وَحَلاَ","وَالشَّرْيُ مَا يَشْتَارُ ذَائِقُهُمْ",35,"م",1,0],["ظاهر البَستنَدود لم أدرِ ماذا","فيه حَملاً وباطنَ الخُشكنان",36,"ن",1,0],["ظالِمٌ لَجَّ في القَطيعَة حَتّى","لا مَزارٌ يَدنو وَلا الطيف يَسري",37,"ر",2,0],["ظالمٌ لا خيرَ يُرْجى","منه مجنونٌ غريبُ",38,"ب",1,0],["ظالم يامن قلاني","في الهوى وحدي رماني",39,"ن",2,1],["ظأْمنتِ لوعةَ أَيتامٍ وَأَرملة","ما شئتِ بين ضلوعي فاقدحي شررا",40,"ر",2,0],["ظامئٌ لا ترتوي غلّتُه","لابَ كالهميان من فرطِ التياح",41,"ح",1,0],["ظالمت وما إلا لنفسك يا فتى","ظلمت وظلم النفس من أقبح الظلم",42,"م",1,0],["ظامي الكعوبِ إِلى خلبِ القلوبِ يرى","أنّ الدلاصَ أضاءٌ وِردها شبمُ",43,"م",1,0],["ظاهِرٌ يَجمُلُ وَالبا","طِنُ لا يَخفى عَلى رَبِّكَ كَلّا",44,"ل",2,0],["ظاهِرٌ باطِنٌ أَنيقٌ عَميقٌ","شاهِدٌ غائِبٌ عَنِ الأَغنياءِ",45,"ا",2,0],["ظاهِرُها يَسُرُّ كُلَّ سامِحٍ","وَلَو وَعى باطِنَها كانَ أَسَر",46,"ر",1,0],["ظافِراً فيما يُراقبه","غَير مَعصيّ بِما طَلَبا",47,"ب",2,0],["ظاهِرٌ ظاهِرُ الجَمالِ كَما البَا","طِنِ خَلقاهُما مَعاً في تَمامِ",48,"م",1,0],["ظالِمٌ مُظلِمُ العِذارَينِ في إش","راقِ خَدَّيهِ نافرٌ كالظَّليمِ",49,"م",1,1],["ظالمٌ يظلم الهدى","بالرُشا قد تمنطقا",50,"ق",2,0],["ظاءٌ ظَلامُ الشكِ عَنهُ زائِلٌ","عينٌ عَرينُ أُسودِهِ محمِيُّ",51,"ي",1,0],["ظَامي الفؤادِ إلى الطِّراد","على المطهّمَةِ السَّلاهِبْ",52,"ب",1,0],["ظاهِر القَسمِ فيهِ جور وَفي","الباطِن عدل يُجانِبُ التالِيسا",53,"س",2,0],["ظامئُ الأَحشاء في الحبِّ إلى","مانعي من ثغره العذب الزّلالا",54,"ل",2,0],["ظالمي في الحبّ عدلٌ فاعجبوا","يا لقومي من ظلومٍ يتظلّم",55,"م",1,0],["ظاهرٌ مثل الثريّا","من على ظهر العلي",56,"ي",1,0],["ظامي الفؤاد لعذب ماء باللوى","ماضي حسام الوجد مغرى مغرم",57,"م",1,0],["ظاهرة الفخرِ ومن باطنِها","أخرى وخير المِنَحِ التوائمُ",58,"م",1,0],["ظاهرَ ثوباً من السلامة لي","فوقَ أديمٍ محلَّمٍ نَغِلِ",59,"ل",1,0],["ظامي الصّوارم والكماة يشوقُهُ","ورْدانِ وردُ طُلىً ووردُ نِهاءِ",60,"ا",2,0],["ظامي الوشاح إذا استقلَّ فردفه","ريّانُ ليس يطيعهُ أن ينهضا",61,"ض",2,0],["ظاهَرَ نَجدا فَتَرامى بِهِ","مِنهُ تَوالي لَيلَةٍ مُطفِلِ",62,"ل",1,0],["ظامياً ظل يرقب العذب منها","فغدا شارباً كؤوس العذاب",63,"ب",1,0],["ظاهر أثوابهم أبيض","والعرض من زفت ومن قار",64,"ر",1,0],["ظامي الموارد ليس في غدرانِهِ","لمُسَوَّفٍ بالوِرْدِ غَرفةُ غارفِ",65,"ف",1,0],["ظاهراً باطناً به لا بنفسٍ","وتحفَّظ من حب مال وجاه",66,"ه",1,0],["ظاهرٌ لا يكون أظهر منهُ","غير أن الأكوان تحجب عنهُ",67,"ه",1,1],["ظاهر بي باطن عنيَ بي","لظهوري وبطوني بدنا",68,"ن",2,0],["ظاهر بالذي يريد له","حاش لله أن أكون أنا",69,"ن",2,0],["ظاهر العلم في الصحابة باد","وهو علم التكليف إنساً وجانا",70,"ن",2,0],["ظاهر بالفعل منه","وهو أنواع الفعال",71,"ل",1,0],["ظاهر في كل شيء","ليس يخفى بانعزال",71,"ل",1,0],["ظاهر في كل شيء","ليس شيء عنه خالي",71,"ل",2,0],["ظاهر عندهم بهم وهو عنهم","باطن غائب بغير زوال",72,"ل",1,0],["ظاهر في كثيف جسم تجلّى","فيه روح وهو اللطيف الموفَّى",73,"ف",2,0],["ظاهرا ذاك لا يزال ولكن","شمسه قد كشفتها عنك كسفا",73,"ف",2,0],["ظاهر بالإستواء لنا","حيث أنا كلنا عبر",74,"ر",1,0],["ظاهرْ ومَنْ يعشقُهْ عن رُؤْيِتُهْ محجوبْ","باطِنْ ومعناهْ لفظْ الكونْ لَهُ منسوبْ",75,"ب",1,1]]}