i.ae/diwan/poem/138038","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33377","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139627",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139524",""],[4717,"يا قلبي المصطلي","https://www.poetsgate.com/ViewPoem.aspx?id=199600",""],[4755,"دَعِي البُكَا أيَّتُها الجُمُوعُ","https://www.poetsgate.com/ViewPoem.aspx?id=208905",""],[4578,"قد رعت يا ريب المنون فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=49406",""],[1901,"أنساك ما سَرَّكَ من بُعدِه","https://www.poetsgate.com/ViewPoem.aspx?id=160412",""],[5050,"أسعد الأقوام في الحرب البطل","https://www.poetsgate.com/ViewPoem.aspx?id=38205",""],[3271,"راهب الغرب","https://www.poetsgate.com/ViewPoem.aspx?id=103195",""],[5240,"لا تلمني فالنفس طال عناها","https://www.poetsgate.com/ViewPoem.aspx?id=171238",""],[5431,"سجود العارفين بقدْرِ حبي ...","https://www.poetsgate.com/ViewPoem.aspx?id=197384",""],[5431,"ولكن أداينه ....","https://www.poetsgate.com/ViewPoem.aspx?id=214829",""],[5518,"وسل القصائد/صباح الحكيم","https://www.poetsgate.com/ViewPoem.aspx?id=193963",""],[5574,"طيف","https://www.poetsgate.com/ViewPoem.aspx?id=206009",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[5628,"يقظة","https://www.poetsgate.com/ViewPoem.aspx?id=178452",""],[5829,"شهداء بدر","https://www.poetsgate.com/ViewPoem.aspx?id=163686",""],[5845,"خلِّ الغرامَ يصبٍّ دمعهُ دمهُ","https://www.poetsgate.com/ViewPoem.aspx?id=198429",""],[5956,"اصرخ فخيرُ البرِّ أن لا تسكت","https://www.poetsgate.com/ViewPoem.aspx?id=204411",""],[5992,"كأنَّ السُحبَ تكشفُ عن نجومٍ","https://www.poetsgate.com/ViewPoem.aspx?id=41832",""],[6093,"أخشاب وأحجار","https://www.poetsgate.com/ViewPoem.aspx?id=198909",""],[6142,"أهاشم هل للبيض سلة ثائر","https://www.poetsgate.com/ViewPoem.aspx?id=155748",""],[463,"دعْ بين جلدى والعظام مكانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60212&r=&rc=268",""],[6355,"جدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66632&r=&rc=92",""]],"verses":[["كَمَا سَرَقَ الْعَبْدُ الْعَبُوسُ عِمَامَةً","فَأّخْرَجَهَا مِنْ تَحْتِهِ حَاكِمُ الْفَلَكْ",0,"ك",1,0],["كَم أَسالَت لَكَ اليَراعَةُ سَيلاً","مِن نُضارٍ يَفيضُ فَيضَ الفُراتِ",1,"ت",1,0],["كم استَراكَ رَسُولُ اللهِ مُغتَبِطاً","بحِكمَةٍ لكَ عند الرَأْيِ يُلْفيها",2,"ي",3,0],["كَمِ اِستَوفَتِ الشُكرَ نَعماؤُهُ","فَأَقبَلَ يُنعِمُ مِن ذي قَبَل",3,"ل",1,0],["كما سقطت في البحر درة باخلٍ","أحاق به يمٌّ من اليأس شامله",4,"ل",2,0],["كَمَا سَقَطَتْ فِي البَحْرِ دُرَّةُ بَاخِلٍ","أَحَاقَ بِهِ لُجٌّ مِنَ اليَأْسِ شَامِلُهْ",5,"ل",2,0],["كَما سُحِرَت بِهِ إِرَمٌ وَعادٌ","فَأَضحَوا مِثلَ أَحلامِ النِيامِ",6,"م",1,0],["كم أستميح المُقْرِفِينَ وأغْتدِي","صِفرَ الدِّلاءِ كأنَّني لم أسْتَمحْ",7,"ح",1,0],["كما سرني أني من الفضل موسرٌ","على أنه فضلٌ من الرزقِ محسوبُ",8,"ب",1,0],["كَم أَسَرّا هَواهُما حَذرَ البَي","نِ وَكَم كاتَما غَليلَ اِشتِياقِ",9,"ق",1,0],["كما ساَرتْ مؤلَّفَةُ الهَوادي","بلَمْعِ البرقِ مُذهَبَةَ الرَّبابِ",10,"ب",1,0],["كَما سَمِعتَ بِصَوتِ النارِ في حَطَبٍ","وَالصَوتُ لِلريحِ لَيسَ الصَوتُ لِلنارِ",11,"ر",1,0],["كم أسيرٍ من أُسارى قَيدِهِ","في وَثَاقِ الحبّ لا يرجو سَرَاح",12,"ح",1,0],["كَم أَسيرٍ مِن سِرِّهِم وَقَتيلٍ","رادِعِ الثَوبِ مِن دَمٍ كَالخَلوقِ",13,"ق",1,0],["كم أسقطَ شاهداً وعدلٌ ضابط","فالعالمُ كلّهم عليه ساخطْ",14,"ط",1,1],["كم أسدٍ رُوِّع بالشبلِ","فيها وحافٍ فاقَ ذا نعلِ",15,"ل",1,1],["كَم أَسلَموا مِن طالِبٍ مَغرور","وَهَرَبوا في يَومِ حَربٍ مَشهور",16,"ر",1,0],["كما سار في الأنصار جَدُّكَ من مِنىً","وقادَ الحواريّينَ عيسى بنُ مريم",17,"م",1,0],["كَم أَسوَدٍ مِن أَمامِهِ حُجُبٌ","عَلَيهِ ضَيفُ الأَذاةِ هَجّامُ",18,"م",1,0],["كَم أسخطت جاهِلاً في مجلس كلمى","وَلَو توسع منه العقل ما سخطا",19,"ط",2,0],["كم أستَغيث لدرء شر","ركَ بالكلاب فلا تغيث",20,"ث",1,0],["كَم أُسرَةٍ ضاقَ الرَجا","ءُ بِها وَأَعياها الطِلاب",21,"ب",1,0],["كَمْ أُسْرَةٍ أَدْرَكْتَهَا وَكَفَلْتَهَا","وَمَبَرَّةٍ أَحْيَيْتَهَا بِجَداكَا",22,"ك",2,0],["كَما سَطَوتَ عَلى اِبني","إِذهَب بُليتُ بِساطِ",23,"ط",1,0],["كم أسلب الشعور سلسلت شعرا","لدغه فوق لدغة الثعبان",24,"ن",1,0],["كما سبقت بذنبي","قومي ففيه سبقت",25,"ت",1,0],["كَمِ اِستَقَيتُم نُفوساً عَزَّ ناصِرُها","مُنذُ اِتَّخَذتُم رِماحَ الخَطِّ أَشطانا",26,"ن",2,0],["كم أستضام وحجّتي مدحوضة","والقول لي أقصى لرقة حالي",27,"ل",2,0],["كَم أساؤوهُ كَي يكفَّ فما كف","فتهُ عَن أمرِ ربّه الأسواءُ",28,"ا",2,0],["كَم اِستَرَطَ الدَهرُ مِن أُمَّةٍ","كَأَنَّ البِلادَ بِهِم تُخسَفُ",29,"ف",1,0],["كم استغاث السقامُ من سقمي","في ليلةٍ لم أنَم ولم أُنِمِ",30,"م",1,1],["كم أستغيثُ وكم أشكو وأعتذرُ","وكم أنُوحُ وكم آتي وكم أذَرُ",31,"ر",1,1],["كما سكبتْ كفُّ الأميرِ محمد","غنىً من أياديه غنيّ وبائس",32,"س",1,0],["كما سوَّدَ القَصَّارُ بالشمس وجهه","ليجهَد في تَبييضِ أثوابِ غيرِهِ",33,"ه",1,0],["كما سَرَحَت في حقلِ لبنانَ نحلةٌ","وفي فمِها من زَهرهِ أطيَبُ الجَنى",34,"ن",2,0],["كما سارَ أعمى يَنكتُ الأرضَ بالعصا","فضلَّ وأمسى خائفاً مُتردِّدا",35,"د",2,0],["كَم أَستَنيب رفاقا في زيارَته","عني وَما كل صب القَلب مغرمه",36,"م",2,0],["كم استباحت من البرايا","ونحن عن ذاك في ذُهول",37,"ل",1,0],["كَمَا سَفَرَتْ صَفْحَةٌ لِلْحَبِيبِ","فَحَجَّبها بُرْقُعٌ أدْكَنُ",38,"ن",1,0],["كَمْ أَسْتَفِيدُ أخاً بَرًّا فَيُعْجِزُنِي","وَأَبْتَغِي ماجِداً مَحْضاً فَيُعْيِيِني",39,"ن",2,0],["كَما سَرى البَردُ في داجٍ مِنَ الظَلَمِ","وافَت مَلائِكَةُ الرَحمَنِ مُرسَلَةً",40,"ه",1,0],["كَمِ اِستَأذَنَت عُقبى عَلى المَرءِ مَيِّتاً","فَما أَذِنَت حُجبٌ عَلَيهِ مِنَ القَبرِ",41,"ر",1,0],["كَم أَسكَرَتني بِنتُ صَد","رٍ مِنكَ فيها بِنتُ دَنْ",42,"ن",1,0],["كما سَعِدَ العراقُ به ولاذَت","برأفته أفاضل كلّ جنس",43,"س",1,0],["كما سَقَتِ المُزنُ الرياض عشيَّةً","فأصبح زهر الروض مبتسم الثغر",44,"ر",1,0],["كم أسكرتنا ولم نسق كؤوس طلًى","وإنَّما الخمر معنًى من معانيها",45,"ي",3,0],["كَمْ أَستَطِيلُ تَضَلُّلِي وتَلَدُّدِي","وأرُوحُ فِي ظُلْمِ الخطوبِ وأَغْتَدي",46,"د",2,1],["كم أستغرُّ فأستجيرُ بآكلٍ","لحمي فأُعرَقُ وهو غير سمينِ",47,"ن",1,0],["كم استأذنت عيني على فجر خدرهِ","فما رفعتْْ أسترهُ وهيادبه",48,"ب",2,0],["كم استخرجت من بحري اللآلي","وقلت إلى الورى هذي عقودي",49,"د",2,0],["كم أسعَفَ الضَّعيفَ مَسُّ ذَيْلِهِ","بنعمَةِ العِرْفانِ والتَّمْكينِ",50,"ن",1,0],["كم أَسأَلُ الريحَ عن أَخبارِ دولَتِهِمْ","أَفدي بأُمِّي نُسَيْماتِ الحِمى وأَبي",51,"ب",2,0],["كم أسعدت يدك العفاة وكم لنا","لفظ المواعظ فوك وهي نضار",52,"ر",1,0],["كَم أَستَزيدُكِ في وَصلِ فَتَصرِمُني","وَكَم أُطيعُك في وَصلي وَتَعصيني",53,"ن",2,0],["كم أسأل الغادين والرائحين","عنك فهل أنت بخير عميم",54,"م",1,0],["كم استطعت زفيراً كان يدفعه","عليك صدريَ كالبركان يلتهب",55,"ب",1,0],["كم استعان عليكم خصمكم بكمُ","فبات يطعن مخضوداً بمخضود",56,"د",1,0],["كم استقى من دمٍ كان السنانُ له","سَجْلاً يُخَضْخِضُ فيه والقناة رشا",57,"ش",2,0],["كم أسهروا الجفن القريح بفعلهم","كم أرسلوا من دمعي الوكاف",58,"ف",1,0],["كم أسد أرداه في مأزق","بطعنة من رمحك الثعلبُ",59,"ب",1,0],["كم أسلفتني منة منة","عذراء بكرا يدك الثيّبُ",59,"ب",1,0],["كم أسد قد تركت ملقى","للوجه من طعنة بثعلب",60,"ب",1,0],["كَما سَمِعْتَ فَالْخِلافُ قَدْ وَقَعْ","فَلَيْسَ إجْماعٌ هُنا كَيْ يُتَّبَعْ",61,"ع",1,0],["كما سلو فوادي","لكم غدا مستحيلا",62,"ل",2,0],["كَمَا سَرَّنَا نَصْرُ ابْنُ نَصْرٍ مُعَاجِلاً","عَلَى كُلِّ طَاغٍ فِي المُلُوكِ وَبَاغِ",63,"غ",1,0],["كم أسالَت في الورى من دمعة","قَطَرت من مهجة الصبّ الطعين",64,"ن",1,0],["كما سُوْقَها ومناقيرَهَا","وأعْيُنَها عَنْدماً أو رِقَانا",65,"ن",2,0],["كما سَرَتِ الصَّبا وَهْنَاً فأَهْدَت","على الهَضَبَاتِ أنْفَاسَ الغَوالي",66,"ل",2,0],["كَم أَسمَرٍ قَلبُه كافورَةٌ وَلَهُ","مِن السَعادة نجمٌ لاحَ في الأُفُقِ",67,"ق",1,0],["كما سارقت باللحظ مقلة أرمد","يقلبها جفن عليه غضيض",68,"ض",1,0],["كم أسكب العذب الفرات على فمي","يرمي يدي باللؤلؤ المكنون",69,"ن",1,0],["كما سطا بالأَرامِ عادٌ وبالحِجْ","ر وأَرْكَى لتُبَّعِ تَبَعا",70,"ع",2,0],["كَما ساقَها يَوماً أَبها وَقَد طَغَت","وَغُرَّت بِتَسويلِ الأَماني الكَواذِبِ",71,"ب",1,0],["كم اسمٍ إلهن في التّواريخ مشكور","والعدل لازم نتبعه من طريجه",72,"ج",2,0],["كمِ اِستخَفَّت عاشقاً في الهوى","وما رأيتُ في عينها مِنهُ شي",73,"ي",1,0],["كما سبَّح الحصباءُ في كفِّ سيِّدٍ","وأصحابه الأعلام كالأنجمِ الزهر",74,"ر",1,0],["كم أسلف الدهر ذنباً ثم أعقبه","من عرس جعفر ما يمحو الذي سلفا",75,"ف",2,0],["كَم أُسَلّي النَّفسَ عَن حُبِّكُم","وَهيَ لا تَزدادُ إِلّا حَزَنا",76,"ن",2,0],["كَما سَرَقَ المَهارِقَ مِن","ذَوي الأَقلامِ حابِرُها",77,"ر",3,0],["كَما سالَ صَفوانٌ بِماءِ سَحابَةٍ","عَلَت رَصَفاً وَاِستَكرَهَت كُلَّ مَحفِلِ",78,"ل",1,0],["كَم أَسود بِسيد","مِن قَبله قَد بَطَشا",79,"ش",2,0],["كم أسرار للعلم متى","لم تكشفها لم تنكشف",80,"ف",1,1],["كم أسألكَ وكم تمنَعهُ","الملك لمن أصبحت عنه راض",81,"ض",1,0],["كم أسأل البدر لم تصفر صفحته","أللزمان وما تجني دواهيه",82,"ي",2,0],["كَما سَرى البدر في داج من الظلَم","ما جزتَ في ذلك الإسراء مرحلة",83,"ه",1,0],["كم أسير في الحب من غير فاد","وقتيل مضى عليه شهيدا",84,"د",2,0],["كم استدر هواها مدمعي غدقا","وكم أثار هواها في الحشا حرقا",85,"ق",2,0],["كم أسرة نُفِيت إلى جَوف الفلا","أطفالُها ونساؤها لا تطعمُ",86,"م",1,0],["كم أسرة في عزها وجلالها","نشأت أضاعت عزها وجلالها",87,"ل",3,0],["كَما سَمَقَت برديَّةٌ وَسطَ حائِرٍ","مِنَ الماءِ تَغذوهُ غِذاءً مسرهَدا",88,"د",2,0],["كما سمعنا معصم الثريا","لم أع فيه غير هذا شيئا",89,"ا",2,0],["كما سمعنا للثريا مرفقا","يتبعه نجم اذا ما اشرقا",89,"ق",2,0],["كما سلبت طسماً وعاداً وجرهماً","قديماً وعيسى لم يَفُتها ولا الخضر",90,"ر",1,0],["كم استنبت رفاقي في زيارته","عني وما كل صب القلب مغرمه",91,"م",2,0],["كمْ أُسْرَةٍ للكُفْرِ شدَّ وَثاقَها","ومعاقِلٍ للشِّرْكِ حلَّ عِقالَها",92,"ل",3,0],["كم استجرت بها عند اللقاءِ وكم","مناكبي حنيت للذيل والقدم",93,"م",1,0],["كم أسأل عنك باشتياق","من أهل هواك من ألاقي",94,"ي",1,0],["كم اسكرَت عقلاً حسا من حانِها","خمرَ الحِجى من أَشرفِ الاكواسِ",95,"س",1,0],["كَم أَسهرُ اللَيلاتِ جفني غارقٌ","وَحَشاشتي مِن لَوعةٍ تَتَلهّف",96,"ف",1,0],["كَم أستردّ الليالي وَهيَ تمنعني","وَكَم أُروّع عَنها وَالمُنى فيها",97,"ي",3,0],["كما سرَّ خصماً أن يراك أمامه","تنازله حرباً بغير سلاح",98,"ح",1,0],["كم أسهر الطرف في علم وفي عمل","وكم طوى الليل تسبيحا وفرقانا",99,"ن",2,0],["كم أسهر الطرف في حل العويص وفي","فهم الحديث وقلب الغمر تومان",100,"ن",1,0],["كما سطا بالأرام عاد وبال","حجر وأزكى لتُبّعٍ تبَعا",101,"ع",2,0],["كَم أَسطرِ دَمعٍ كتبت أَجفاني","في صَف