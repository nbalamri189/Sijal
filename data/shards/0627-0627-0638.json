{"poems":[[113,"تلوح لنا بالروم من كل جانب","https://www.aldiwan.net/poem16710.html","الطويل"],[208,"عن الجار يسأل باغي المحلل","https://www.aldiwan.net/poem53199.html","المتقارب"],[234,"أأظهر أم أخفي الذي بي من السقم","https://www.aldiwan.net/poem50791.html","الطويل"],[237,"يلوح لعيني وحش وجرة من بعد","https://www.aldiwan.net/poem14777.html","الطويل"],[240,"أبثكم أني مشوق بكم صب","https://www.aldiwan.net/poem32178.html","الطويل"],[469,"وأحور في عينيه هاروت بابل","https://www.aldiwan.net/poem3344.html","عموديه"],[558,"أأعلن ما بي أم أسر فأكتم","https://www.aldiwan.net/poem68411.html","الطويل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126654","الكامل"],[1956,"","https://poetry.dctabudhabi.ae/diwan/poem/121874","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53176","الكامل"],[5703,"حط العصفور بشباكي","https://www.poetsgate.com/ViewPoem.aspx?id=207400",""],[5956,"تتسلق عيناي عيونَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=193890",""],[6273,"أسئلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78503&r=&rc=1",""]],"verses":[["أَأَظمأ في دار تَفيض بُحورَها","وَتَشرَب فيها بِالجَمال المَسالك",0,"ك",1,0],["أأظمأُ في منهل من نداك","وغيري يُعَلُّ ولم أنهلِ",1,"ل",1,0],["أأُظهِر أم أخفي الّذي بي من السَقْم","وكم أدفع الأيّامَ بالصبر والحِلم",2,"م",1,1],["أَأَظمى وَفي ذاكَ الرِضابِ مَوارِدٌ","أَلَذُّ مِنَ السَلسالِ وَالخَمرِ وَالشَهدِ",3,"د",1,0],["أَأَظمى وَدوني مِن حِياضِ مُحَمَّدٍ","مَناهِلُ جودٍ ماوئها غَلَلٌ سَكبُ",4,"ب",1,0],["أاظما وأنتَ البحرُ والعام مخصبٌ","وأخشى وأنتَ السيفُ حتفُ الغوائل",5,"ل",1,0],["أَأَظلِمُ قَلبي لَيسَ قَلبي بِظالِمٍ","وَلَكِنَّ مَن أَهوى يَجورُ وَيَظلِمُ",6,"م",1,0],["أأظن أن تنمو العلوم بأرضنا","وأرى اليهند بذلة الفقهاء",7,"ا",2,0],["أأظمأ غراما في هواك ولوعة","ولي دمع عين كالسحاب بكيته",8,"ت",2,0],["أأظل أنتجع الملوك مرجياً","منهم كريماً تارة وبخيلا",9,"ل",2,0],["أأظلُّ بحُبّكَ في أملٍ","وعلى الأيّامِ أُعَلِّقُهٌ ؟؟",10,"ق",2,0],["أ أظل حبيبي مطعونكْ؟","لا يلمس كفَّاي بطونكْ؟",11,"ك",1,0],["أأظل في سنني أرقع ماانفرى","وسواي يفري في الرداءويحرد؟",12,"د",1,0],["أأظل في جدب الوسيعةظامئا","وسواي ينهل من سقاي ويضهد؟",12,"د",1,0]]}