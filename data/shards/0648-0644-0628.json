{"poems":[[53,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[53,"لا لوم للدهر ولا عتابا","https://www.aldiwan.net/poem30736.html","الرجز"],[53,"أبكيك لو نقع الغليل بكائي","https://www.aldiwan.net/poem30779.html","الكامل"],[9,"رحلت سمية غدوة أجمالها","https://www.aldiwan.net/poem21970.html","الكامل"],[73,"قد علقنا سواك علقا نفيسا","https://www.aldiwan.net/poem11987.html","الخفيف"],[93,"علام يقام تمثالي","https://www.aldiwan.net/poem9164.html","مجزوء الوافر"],[30,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[37,"هل لحال من اقتياض بحال","https://www.aldiwan.net/poem7444.html","الخفيف"],[47,"أشاقك الطيف ألم طارقه","https://www.aldiwan.net/poem25220.html","الرجز"],[72,"تجني لواحظه علي وتعتب","https://www.aldiwan.net/poem18229.html","الكامل"],[72,"قاسي الجوانح لين الأعطاف","https://www.aldiwan.net/poem19257.html","الكامل"],[51,"وهب يا واهب الهبات اللواتي","https://www.aldiwan.net/poem8310.html","الخفيف"],[51,"دار أمن وقرار","https://www.aldiwan.net/poem62849.html","مجزوء الرمل"],[51,"شغل المحب عن الرسوم","https://www.aldiwan.net/poem66332.html","مجزوء الكامل"],[91,"تلك السنون الغاربات ورائي","https://www.aldiwan.net/poem8726.html","عموديه"],[91,"خير ما يكتبه ذو مرقم","https://www.aldiwan.net/poem8865.html","عموديه"],[91,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[32,"أبثين إنك قد ملكت فأسجحي","https://www.aldiwan.net/poem27808.html","الكامل"],[89,"ويل لمملكة قضى اهمالها","https://www.aldiwan.net/poem44846.html","الكامل"],[85,"لست بناس ليلة","https://www.aldiwan.net/poem8051.html","مجزوء الرجز"],[85,"اليوم أصعد دون قبرك منبرا","https://www.aldiwan.net/poem62866.html","الكامل"],[62,"هذا الزمان يزف أبكار العلى","https://www.aldiwan.net/poem52319.html","الطويل"],[45,"أأفاق صب من هوى فأفيقا","https://www.aldiwan.net/poem65176.html","الطويل"],[45,"عهدي بربعك مثلا آرامه","https://www.aldiwan.net/poem65681.html","الكامل"],[28,"هتمت قريبة يا أخا الأنصار","https://www.aldiwan.net/poem5194.html","الكامل"],[61,"عذر العذول فراح فيك مساعدا","https://www.aldiwan.net/poem51726.html","الكامل"],[80,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[80,"أي خطب عن قوسه الموت يرمي","https://www.aldiwan.net/poem31283.html","الخفيف"],[80,"نهت الكواشح عنه والعذالا","https://www.aldiwan.net/poem31323.html","الكامل"],[80,"شوقي إليك مجدد","https://www.aldiwan.net/poem31468.html","مجزوء الكامل"],[80,"صادتك مهاة لم تصد","https://www.aldiwan.net/poem31480.html","المتدارك"],[105,"جزى الله ما أديتما من حقوقه","https://www.aldiwan.net/poem43160.html","الطويل"],[52,"أيا ويحه ما ذنبه إن تذكرا","https://www.aldiwan.net/poem27049.html","الطويل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[67,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[75,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[50,"طرقتنا بالزابيين الرباب","https://www.aldiwan.net/poem64816.html","الخفيف"],[46,"مثل الفتى عند التغرب والنوى","https://www.aldiwan.net/poem22634.html","الكامل"],[46,"خصاؤك خير من زواجك حرة","https://www.aldiwan.net/poem22821.html","الطويل"],[8,"قالت أمامة كم عمرت زمانة","https://www.aldiwan.net/poem21849.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55113","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50221","الرجز"],[90,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[45,"عَهْدِي بِرَبْعِكَ مُثَّلاً آرَامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=32042",""],[105,"جزى الله ما أديتما من حقوقه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54900&r=&rc=70",""]],"verses":[["وَلَبِستُ في الصِفَرِ العُلى مُستَبدِلاً","أَطواقَها بِتَمائِمِ المَولودِ",0,"د",1,0],["وَلَبِسوا الجَندَلَ وَالظِرابا","لِقَدَرٍ ما عَمَروا الخِرابا",1,"ب",2,0],["وَلَبِئسَ ما تَلقى بِعُقرِ دِيارِهِم","أُذنُ المُصيخِ بِها وَعَينُ الرائي",2,"ي",1,0],["وَلَبونِ مِعزابٍ حَوَيتَ فَأَصبَحَت","نُهبى وَآزِلَةٍ قَضَبتَ عِقالَها",3,"ل",3,0],["وَلَبِسنا الجَديدَ مِن خِلعِ الحُ","بِّ وَلَم نَألُ أَن خَلَعنا اللَبيسا",4,"س",2,0],["ولباه أماجيد","سخوا بالوقت والمال",5,"ل",1,0],["وَلَبسٍ بَينَ أَقوامٍ فَكُلُّ","أَعَدَّ لَهُ الشَغازِبَ وَالمَحالا",6,"ل",2,0],["ولبست الشباب غضاً وأجري","ت دداً في الغرانق الأزوالِ",7,"ل",1,0],["وَلَبِسَت مِن زَهرِهِ حَدائِقُه","سَموطَ حَليٍ فُصِّلَت عَقائِقُه",8,"ق",2,0],["ولبست أنعمهُ القشيبةَ والصبى","فسلبتُ ذاكَ وهذهِ لا تُسلب",9,"ب",1,0],["ولبُعد بابك وُقد نارٍ في الحشا","ترمي بكلّ شرارةٍ كطراف",10,"ف",1,0],["ولبعض الرجال فضلٌ على بع","ضٍ بما نفَّلَتْهُمُ الآدابُ",11,"ب",1,0],["ولُبابِ الساج لا بل","بِيَلَنْجوج القَماري",12,"ر",2,0],["ولباطني منها وسا","وسُ من هُموم كالخصوم",13,"م",1,0],["وَلَبَذَّني يَومَ التَفاخُرِ شاطِئٌ","ما فيهِ غَيرُ رِمالِهِ الخَرساءِ",14,"ا",2,0],["وَلَبِثنا بَعدَهُ في ظُلَمٍ","داجِيَتٍ فَوقَنا مُعتَكِرَه",15,"ر",2,0],["وَلِبُلبُلٍ غَرِدٍ يُساجِلُ بُلبُلاً","غَرداً وَلِلنَسَماتِ",16,"ت",1,0],["وَلَباطِلٌ مِمَّن أُحِبُّ حَديثَهُ","أَشهى إِلَيَّ مِنَ البَغيضِ الباذِلِ",17,"ل",1,0],["ولبلدة منكوسة قد انكدت","علماؤها وتنعمت جهالها",18,"ل",3,0],["وَلَبِسَت لي مِن وَرا","ءِ السِترِ جِلدَ النَمرَةِ",19,"ه",1,0],["وَلَبِثتَ عَن حَوضِ الشَبيبَةِ ذائِداً","حَتّى جَزاكَ اللَهُ عَنهُ الكَوثَرا",20,"ر",2,0],["ولبستُ سربالَ التماثُلِ بعدما","ساء الظُّنونُ وصرتُ نِضواً مُثْقَلا",21,"ل",2,0],["وَلَبَكَّرَت بَكرٌ وَراحَت تَغلِبٌ","في نَصرِ دَعوَتِهِ إِلَيهِ طُروقا",22,"ق",2,0],["وَلَبِثتُ عَنهُ لَبثَ مُؤثِرِ راحَةٍ","لَقيَتهُ مِن بَعدِ العِراقِ شَآمُهُ",23,"م",2,0],["وَلَبُلَّ هاتِمُ في قَعيدَةِ بَيتِهِ","مِنهُ بِأَروَعَ فاتِكٍ مِغيارِ",24,"ر",1,0],["ولَبِسْتَ مجدَكَ بالصَّوارمِ والقَنا","والنَّجمُ ليسَ يراهُ إلا صاعِدا",25,"د",2,0],["ولبسنَ المسوحَ بعد حريرٍ","شرّ زيٍّ أرتكَ من خيرِ زِيِّ",26,"ي",1,0],["ولبستَ العزاءَ يا خير فرْعٍ","قد بكى حسرةً على خير جِذْمِ",27,"م",1,0],["ولبستَ فيه على شِعارِكَ بالتُّقى","من ربّكَ الإعظامَ والإجْلالا",28,"ل",2,0],["وَلَبِستُ فيهِ مِنَ الضَّنى","عَرَضاً يُلازمُ جَوهَري",29,"ي",1,0],["ولَبِثتُ مُشَنَّفَةً أُذُني","بِتَرنُّم ذي النّغَم الغردِ",30,"د",1,0],["وَلَبَّيتُماهُ إِذا دَعا وَاِستَبَقتُما","سَبيلَيهِ لا يَثنيكُما لَومُ لائِمِ",31,"م",1,0],["وَلَبثي وَإِخلافي أُناساً فَقِدتُهُم","وَما كُنتُ أَرجو بَعدَهُم أَن أُعَمَّرا",32,"ر",2,0],["وَلِبَيتِهِ الحَرَمِ الحرامِ طَرِيقُهُ","يَتْلُو رَعِيلَ المخلِصِينَ رَعِيلا",33,"ل",2,0],["ولَبِسْتَ فيها سابِغاتِ عزائِمٍ","تُغْنِي الكُماةَ عَنِ ادِّراعِ الَّلامِ",34,"م",1,0],["ولبِسْتُ ما ألبَستَني من نِعمَةٍ","فبِها شكَرْتُكَ لا بطولِ لِساني",35,"ن",2,0],["وَلُبابٌ مِنَ المَهالِبَةِ الشو","سِ تَسامى العُلى كَذاكَ اللُبابُ",36,"ب",1,0],["وَلَبِئسَ نَفسُ المَرءِ نَفسٌ حَسَّنَت","فِعلَ القَبيحِ لَهُ فَنَصَّ شَنارَها",37,"ر",3,0],["وَلُبسُكَ ثَوبَ السَقمِ أَحسَنُ مَنظَراً","وَأَبهَجُ مِن ثَوبِ الغَويِّ المُنَمِّسِ",38,"س",1,0],["وَلَبِستُ مِن الإِسلامِ ثَوباً واسِعاً","مِن سَيبِ لا حَرِمٍ وَلا مَنّانِ",39,"ن",1,0],["وَلَبِسْتُ هَذَا الدَّهْرَ مِنْ أَطْرَافِهِ","وَنَزَعْتُهُ وَقَمِيصُهُ أَخْلاقُ",40,"ق",1,0],["وَلَبِثْتَ مُذْ فُقِدَاً تُطِيلُ","لِنَهْضَةِ الشعْبِ افْتِقَادَك",41,"ك",1,0],["وَلَبِثَتْ كُلُّ نَؤْومِ الضُّحَى","فِي لُجَجِ الأَحْلاَمِ تَسْتَبْحِرُ",42,"ر",1,0],["ولَبَّةً في لَبَبٍ مِنْ جَوْهَرِ","وجَلَسَتْ بينَ غُثا وأغثَرِ",43,"ر",1,0],["ولبيتٍ أناره عبقرىٌ","لم ينوَّر بمثله الأُفقُ ، خادم",44,"م",1,0],["ولبينَ بينَ منافقِ متربِّصٍ","رعيَ الظروف ! مُواكباً ومُجانبا",45,"ب",2,0],["ولَبِثْتُ عَنْهُ لَبْثَ مُؤثِرِ راحَةٍ","لَقِيَتْهُ مِنْ بعدِ العِرلقِ شَآمُهُ",46,"م",2,0],["ولبيتماه إذ دعا واستبقتما","سبيليه لا يثنيكما لوم لائم",47,"م",1,0]]}