امل"],[280,"حلفت لي هند فخانت يميني","https://www.aldiwan.net/poem32333.html","الخفيف"],[280,"صاد الفؤاد برمل رامة ريم","https://www.aldiwan.net/poem32627.html","الكامل"],[302,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[318,"يا أيها الشهم الذي","https://www.aldiwan.net/poem67207.html","الكامل"],[346,"سلام على الصدر الذي عنده قلبي","https://www.aldiwan.net/poem19861.html","الطويل"],[364,"روحات وصلتها بابتكار","https://www.aldiwan.net/poem17775.html","الخفيف"],[369,"خلت الديار من الحبيب وشخصه","https://www.aldiwan.net/poem57350.html","الكامل"],[369,"أما الحديث بما صنعت فقد بدا","https://www.aldiwan.net/poem57485.html","الكامل"],[374,"ثق إنما الأحزان سبك ضيق","https://www.aldiwan.net/poem59318.html","الكامل"],[374,"هذا سلام والصدور رحاب","https://www.aldiwan.net/poem66940.html","الكامل"],[377,"مزجت دموع جفونه بدماء","https://www.aldiwan.net/poem49210.html","الكامل"],[383,"ذاد عنى النوم هم بعد هم","https://www.aldiwan.net/poem1843.html","الرمل"],[400,"نظم يجل بأن يقال مدام","https://www.aldiwan.net/poem33419.html","الكامل"],[400,"وافى نظامك أيها الفذ الذي","https://www.aldiwan.net/poem33613.html","الكامل"],[400,"طال البعاد فهل له بعد","https://www.aldiwan.net/poem33964.html","الكامل"],[406,"يا دهر كم هذا التفرق","https://www.aldiwan.net/poem31863.html","مجزوء الكامل"],[429,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[429,"كاد الكمال يعود ربعا بلقعا","https://www.aldiwan.net/poem12664.html","الكامل"],[436,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[438,"عجبا لراج فوز ناج سابق","https://www.aldiwan.net/poem14317.html","الكامل"],[440,"منا فوارس قاتلوا عن سبيهم","https://www.aldiwan.net/poem1757.html","الكامل"],[441,"دع عنك صهباء الدساكر","https://www.aldiwan.net/poem56047.html","عموديه"],[456,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[456,"ألا صاحب كالسيف حلو شمائله","https://www.aldiwan.net/poem55994.html","الطويل"],[456,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[456,"أمنها على أن المزار بعيد","https://www.aldiwan.net/poem56220.html","الوافر"],[459,"يا فتى الخير من نوال وبأس","https://www.aldiwan.net/poem15343.html","الخفيف"],[459,"أسدي البأس عذري الوفا","https://www.aldiwan.net/poem16229.html","الرمل"],[459,"فخرت بك الأزمان والحقب","https://www.aldiwan.net/poem16420.html","أحذ الكامل"],[462,"أصمت فؤادي مقلتاه باسهم","https://www.aldiwan.net/poem3482.html","عموديه"],[475,"حييت من دمن ومن أطلال","https://www.aldiwan.net/poem15352.html","الكامل"],[477,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[513,"قدومك أفرح قلب الهدى","https://www.aldiwan.net/poem12068.html","المتقارب"],[549,"يا يوم أي شجى بمثلك ذاقه","https://www.aldiwan.net/poem47153.html","الكامل"],[549,"ما رأتني عيناك يوم الفراق","https://www.aldiwan.net/poem47357.html","الخفيف"],[549,"قل لعيني لا تملا الدموعا","https://www.aldiwan.net/poem47711.html","الخفيف"],[549,"أتتني كما بلغت منية","https://www.aldiwan.net/poem47799.html","المتقارب"],[549,"ليت أنا لا نعرف القوم فيهم","https://www.aldiwan.net/poem47808.html","الخفيف"],[549,"ليس للقلب في السلو نصيب","https://www.aldiwan.net/poem48092.html","الخفيف"],[556,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[556,"نحن من المنسوبين","https://www.aldiwan.net/poem33814.html","مجزوء الرجز"],[556,"لو تجلى عن ناظريك الغبار","https://www.aldiwan.net/poem34555.html","الخفيف"],[573,"رحلوا فلست مسائلاً عن دارهم","https://www.aldiwan.net/poem2861.html","الكامل"],[573,"رجع الغرام إلى الحبيب الأول","https://www.aldiwan.net/poem3030.html","الكامل"],[573,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"]],"verses":[["وَلَبِستُ في الصِفَرِ العُلى مُستَبدِلاً","أَطواقَها بِتَمائِمِ المَولودِ",0,"د",1,0],["وَلَبِسوا الجَندَلَ وَالظِرابا","لِقَدَرٍ ما عَمَروا الخِرابا",1,"ب",2,0],["وَلَبِئسَ ما تَلقى بِعُقرِ دِيارِهِم","أُذنُ المُصيخِ بِها وَعَينُ الرائي",2,"ي",1,0],["وَلَبونِ مِعزابٍ حَوَيتَ فَأَصبَحَت","نُهبى وَآزِلَةٍ قَضَبتَ عِقالَها",3,"ل",3,0],["وَلَبِسنا الجَديدَ مِن خِلعِ الحُ","بِّ وَلَم نَألُ أَن خَلَعنا اللَبيسا",4,"س",2,0],["ولباه أماجيد","سخوا بالوقت والمال",5,"ل",1,0],["وَلَبسٍ بَينَ أَقوامٍ فَكُلُّ","أَعَدَّ لَهُ الشَغازِبَ وَالمَحالا",6,"ل",2,0],["ولبست الشباب غضاً وأجري","ت دداً في الغرانق الأزوالِ",7,"ل",1,0],["وَلَبِسَت مِن زَهرِهِ حَدائِقُه","سَموطَ حَليٍ فُصِّلَت عَقائِقُه",8,"ق",2,0],["ولبست أنعمهُ القشيبةَ والصبى","فسلبتُ ذاكَ وهذهِ لا تُسلب",9,"ب",1,0],["ولبُعد بابك وُقد نارٍ في الحشا","ترمي بكلّ شرارةٍ كطراف",10,"ف",1,0],["ولبعض الرجال فضلٌ على بع","ضٍ بما نفَّلَتْهُمُ الآدابُ",11,"ب",1,0],["ولُبابِ الساج لا بل","بِيَلَنْجوج القَماري",12,"ر",2,0],["ولباطني منها وسا","وسُ من هُموم كالخصوم",13,"م",1,0],["وَلَبَذَّني يَومَ التَفاخُرِ شاطِئٌ","ما فيهِ غَيرُ رِمالِهِ الخَرساءِ",14,"ا",2,0],["وَلَبِثنا بَعدَهُ في ظُلَمٍ","داجِيَتٍ فَوقَنا مُعتَكِرَه",15,"ر",2,0],["وَلِبُلبُلٍ غَرِدٍ يُساجِلُ بُلبُلاً","غَرداً وَلِلنَسَماتِ",16,"ت",1,0],["وَلَباطِلٌ مِمَّن أُحِبُّ حَديثَهُ","أَشهى إِلَيَّ مِنَ البَغيضِ الباذِلِ",17,"ل",1,0],["ولبلدة منكوسة قد انكدت","علماؤها وتنعمت جهالها",18,"ل",3,0],["وَلَبِسَت لي مِن وَرا","ءِ السِترِ جِلدَ النَمرَةِ",19,"ه",1,0],["وَلَبِثتَ عَن حَوضِ الشَبيبَةِ ذائِداً","حَتّى جَزاكَ اللَهُ عَنهُ الكَوثَرا",20,"ر",2,0],["ولبستُ سربالَ التماثُلِ بعدما","ساء الظُّنونُ وصرتُ نِضواً مُثْقَلا",21,"ل",2,0],["وَلَبَكَّرَت بَكرٌ وَراحَت تَغلِبٌ","في نَصرِ دَعوَتِهِ إِلَيهِ طُروقا",22,"ق",2,0],["وَلَبِثتُ عَنهُ لَبثَ مُؤثِرِ راحَةٍ","لَقيَتهُ مِن بَعدِ العِراقِ شَآمُهُ",23,"م",2,0],["وَلَبُلَّ هاتِمُ في قَعيدَةِ بَيتِهِ","مِنهُ بِأَروَعَ فاتِكٍ مِغيارِ",24,"ر",1,0],["ولَبِسْتَ مجدَكَ بالصَّوارمِ والقَنا","والنَّجمُ ليسَ يراهُ إلا صاعِدا",25,"د",2,0],["ولبسنَ المسوحَ بعد حريرٍ","شرّ زيٍّ أرتكَ من خيرِ زِيِّ",26,"ي",1,0],["ولبستَ العزاءَ يا خير فرْعٍ","قد بكى حسرةً على خير جِذْمِ",27,"م",1,0],["ولبستَ فيه على شِعارِكَ بالتُّقى","من ربّكَ الإعظامَ والإجْلالا",28,"ل",2,0],["وَلَبِستُ فيهِ مِنَ الضَّنى","عَرَضاً يُلازمُ جَوهَري",29,"ي",1,0],["ولَبِثتُ مُشَنَّفَةً أُذُني","بِتَرنُّم ذي النّغَم الغردِ",30,"د",1,0],["وَلَبَّيتُماهُ إِذا دَعا وَاِستَبَقتُما","سَبيلَيهِ لا يَثنيكُما لَومُ لائِمِ",31,"م",1,0],["وَلَبثي وَإِخلافي أُناساً فَقِدتُهُم","وَما كُنتُ أَرجو بَعدَهُم أَن أُعَمَّرا",32,"ر",2,0],["وَلِبَيتِهِ الحَرَمِ الحرامِ طَرِيقُهُ","يَتْلُو رَعِيلَ المخلِصِينَ رَعِيلا",33,"ل",2,0],["ولَبِسْتَ فيها سابِغاتِ عزائِمٍ","تُغْنِي الكُماةَ عَنِ ادِّراعِ الَّلامِ",34,"م",1,0],["ولبِسْتُ ما ألبَستَني من نِعمَةٍ","فبِها شكَرْتُكَ لا بطولِ لِساني",35,"ن",2,0],["وَلُبابٌ مِنَ المَهالِبَةِ الشو","سِ تَسامى العُلى كَذاكَ اللُبابُ",36,"ب",1,0],["وَلَبِئسَ نَفسُ المَرءِ نَفسٌ حَسَّنَت","فِعلَ القَبيحِ لَهُ فَنَصَّ شَنارَها",37,"ر",3,0],["وَلُبسُكَ ثَوبَ السَقمِ أَحسَنُ مَنظَراً","وَأَبهَجُ مِن ثَوبِ الغَويِّ المُنَمِّسِ",38,"س",1,0],["وَلَبِستُ مِن الإِسلامِ ثَوباً واسِعاً","مِن سَيبِ لا حَرِمٍ وَلا مَنّانِ",39,"ن",1,0],["وَلَبِسْتُ هَذَا الدَّهْرَ مِنْ أَطْرَافِهِ","وَنَزَعْتُهُ وَقَمِيصُهُ أَخْلاقُ",40,"ق",1,0],["وَلَبِثْتَ مُذْ فُقِدَاً تُطِيلُ","لِنَهْضَةِ الشعْبِ افْتِقَادَك",41,"ك",1,0],["وَلَبِثَتْ كُلُّ نَؤْومِ الضُّحَى","فِي لُجَجِ الأَحْلاَمِ تَسْتَبْحِرُ",42,"ر",1,0],["ولَبَّةً في لَبَبٍ مِنْ جَوْهَرِ","وجَلَسَتْ بينَ غُثا وأغثَرِ",43,"ر",1,0],["ولبيتٍ أناره عبقرىٌ","لم ينوَّر بمثله الأُفقُ ، خادم",44,"م",1,0],["ولبينَ بينَ منافقِ متربِّصٍ","رعيَ الظروف ! مُواكباً ومُجانبا",45,"ب",2,0],["ولَبِثْتُ عَنْهُ لَبْثَ مُؤثِرِ راحَةٍ","لَقِيَتْهُ مِنْ بعدِ العِرلقِ شَآمُهُ",46,"م",2,0],["ولبيتماه إذ دعا واستبقتما","سبيليه لا يثنيكما لوم لائم",47,"م",1,0],["ولبئس من ان لم توافق قصده","يجري على زور ويذكر ما مضى",48,"ض",2,0],["ولبا لريم الطف لم يمض طائرا","وصبا الى تلك المنازل لا يصبو",49,"ب",2,0],["ولبابهم هرعت صدور الأوليا","وفيه طافوا مرشداً ومريدا",50,"د",2,0],["ولبست إذ قومي عراة","غير ما نسجت يديه",51,"ي",2,0],["وَلِبثتُ أعبُدُها عِبادةَ صامتٍ","نظر الحقيقةَ واستقلَّ بعِلمِها",52,"م",3,0],["ولِبَّاتٌ عَلَى الأَلبَابِ دَاءٌ","وقَدٌّ قَادني وهَوًى هَوَاني",53,"ي",1,0],["ولبّت مهجتي لما دعاني","هواه له فويحكما دعاني",54,"ي",1,0],["ولَبَثُّ العلوم أعظمُ فضلٍ","فاغتنمهُ فقد حويت مداه",55,"ا",2,0],["ولبسه المنثور قد لونها","وجدد الصبغ به وطرا",56,"ر",2,0],["ولبيت مالي مذهب","ما خصّني يوما بماله",57,"ل",2,0],["ولبست من شبا المشي","ب ملا صنيعا سابغا",58,"غ",2,0],["وَلَبِسنَ لَوناً بَعدَ آخَرَ وَاِنجَلَت","عَنهُنَّ هِبرِيَّةُ الشَياهِ المُنسِلِ",59,"ل",1,0],["ولبيك لبيك من وصفها","تلابيب تأخذ بالناصيه",60,"ي",2,0],["وَلُبنانُ فَجرُ اللَهِ أَصدَقُ ما بِهِ","وَأَثبَتُ ما فيهِ الجَمالُ المُبَكِّرُ",61,"ر",1,0],["وَلُبنانُ مِن عَدنٍ جَبينٌ وَمُهجَةٌ","جَرى كَوثَرٌ فيهِ وَأَزهَرَ عَبقَرُ",61,"ر",1,0],["وَلَبِثنا في نِعمَةِ الحُبِّ لا نَس","مَعُ إِلّا خَيالَهُ المُنتايا",62,"ي",2,0],["ولبثتُ أرقب قطفها","من بعد ما نضج الثمر",63,"ر",1,0],["ولبست من زهر الرياض ملأه","وعقدت فوق الجيد منه وشاحاً",64,"ح",2,0],["ولبعض معجزه لتسبيح الحصا","والماء من بين الأصابع ساحا",64,"ح",2,0],["وَلَبِستُ مِن نَعمائِهِ","حَصداءَ سابِغَةَ الذُيولِ",65,"ل",1,0],["وَلَبِّ مَنْ نَادَاكْ","بِمُمْطِرِ جَدْوَاكْ",66,"ك",1,0],["ولبسنا في الحيّ أجمل ثوبٍ","بقبول من الرضا منسوج",67,"ج",1,0],["ولبل كأن الصبح فيه مآرب","تؤمل ان نقضي وخل نصادقه",68,"ق",2,0],["ولبت اقنع بالكرى ولطالما","هلك المحب اسى إذا لم يقنع",69,"ع",1,0],["ولبسمهِ قصرُ الخلافةِ باسمٌ","ونصيبُه الإكرامُ والإسعاد",70,"د",1,0],["ولُبنى إِلى جَنبي فتاةٌ صَغيرةٌ","كَنوّارةٍ فيها نَدَى الصّبحِ طاهِر",71,"ر",1,0],["ولِبْسهُ الكواعِب النواهِد","به نفاقُ كل حَتف كاسِد",72,"د",1,0],["وَلَبَيْتِكَ الْفَخْرُ الَّذِي لَوْ أَنَّهُ","سامى السِّماكَ لَكانَ مِنْهُ أَسْمَقا",73,"ق",2,0],["وَلِبَدرِ الدينِ الهَناءُ بعيدِ ال","فطرِ في ظِلِّ العِزِّ وَالتَمكينِ",74,"ن",1,0],["وَلِبيضِهِ في الهامِ تَكسيرٌ وَلِل","سُمرِ الذَّوابِلِ فيهمُ تَحطيمُ",75,"م",1,0],["ولب المنادى وأنه مسرعاله","فقد تبطل الحاجات من بطاءاتيان",76,"ن",1,0],["وَلِبِرِّكُم وَصَفائِهِ","أَرخَتهُ صَوماً بِصَفوِ",77,"و",1,0],["وَلَبَّسَهُ عِيسى فَرَاعَتْهُ آيَةٌ","أَرَتْهُ عَصَا مُوْسَى فَخَابَ مِن الضَّرْبِ",78,"ب",1,0],["وَلَبِسنا الشَبابَ لُبؤسَ اللَيالي","وَجَعَلنا المَشيبَ كَالأَسحارِ",79,"ر",1,0],["ولبستُ أرديةَ السقامِ بمن غَدا","يَمشي بأردِيةِ الجَمالِ وقمصِهِ",80,"ص",2,0],["ولبِشره فيها ورقَّةِ وجهِه","سنةٌ وليس المقتَدي كالمقتَدى",81,"د",2,0],["ولبست في مدح البتولة مريمٍ","ثوبَ الرجا فكأنه الإستبرق",82,"ق",1,0],["ولبست فيه العار ثوباً فاضحاً","بين الأنام وما عليَّ نقاب",83,"ب",1,0],["وَلبست مِن حُلل السقام مورّساً","قَد رَقَّيتُهُ مُقلَتي بِدِماءِ",84,"ا",2,0],["وَلَبَعضُ الصَفحِ وَالإِعراضِ عَن","ذي الخَنا أَبقى وَإِن كانَ ظَلَم",85,"م",1,0],["ولبست من حلل الهداية حلة","حلت وتلك على الغواة حرام",86,"م",1,0],["ولبست في كل العلوم مطارفاً","وعدوت فيها من أجل بطارقه",87,"ق",2,0],["ولبست ثوب العنبر بعدكم","حتى تمزق ذلك البرد",88,"د",1,0],["ولَبِئْسَ عيشُ المرءِ فا","رقَهُ الأحِبّةُ واللِّدَاتُ",89,"ت",1,0],["ولبحرِه عندي ولستُ أَقوله","ما ضلَّني تذكارُه عن بَحْرَتي",90,"ي",1,0],["ولبستُ من حَلْيِ المفاخِرِ فائقاً","وسلكتُ من طُرْقِ المحامدِ مِهْيَعا",91,"ع",2,0],["ولَبِسْتُ لِلُّوَّامِ لأْمَةَ خالِعٍ","مَسْرُودَةً بِصَبابَةٍ وتَصابِ",92,"ب",1,0],["ولباس كل قشيب ثوبٍ أبيضٍ","والقلب مسودٌّ بلبس سبارق",93,"ق",1,0],["ولبئس ما نصروا العشيرة ذو لحي","وحفيف نافحة بليل مسهر",94,"ر",1,0],["ولباسهم وفراشهم","هذا وثير ذاك فاخر",95,"ر",1,0],["ولبستُ أنعمَك التي من بعضها","أن صرتُ مضطلعاً بشكر المنعمِ",96,"م",1,0],["ولبستَ للعيدين ثوبَيْ دولةٍ","أرِجَيْنِ بين مُرَقَّشٍ ومُرَقَّمِ",96,"م",1,0],["ولبَّى وقد ناداه يا ناصرَ العلا","على فترةٍ فيها أخو المرء خاذلُهْ",97,"ل",2,0],["ولبلَّغَتْنِي المجدَ سابحةٌ","بالظَّهرِ ليست من بني الظهرِ",98,"ر",1,0],["ولبَّى دعائي والصدَى لا يُجيبني","بيقظتِهِ والسامعون رُقودُ",99,"د",1,0],["ولِبغدادَ ضجَّةٌ بثناءٍ","كادَ يتلو فصيحهُ المولودُ",100,"د",1,0],["ولَبيبٌ ألْمَعِيٌّ كُلَّما","أعْضَلَ المُشْكِلُ واسْتبهم حلْ",101,"ل",1,0],["ولَبِسْتَ أخْلاقاً مُطَهَّرة","يدْنو بها القاصِي ويَقْتَرِبُ",102,"ب",1,0],["ولبسةُ ثوبَ السقم أصفر مصمتاً","فعلامَ يخلع في الجمال المعلمِ",103,"م",1,0],["ولبارقٍ ما لاحَ في غَسَقِ الدُّجى","اِلاّ أَرِقْتُ لومضهِ المتعالي",104,"ل",2,0],["ولبستها متشرفا وطنيّتي","أحبب بها ودخلت في الشرفاء",105,"ا",2,0],["ولبدت منها العجاج المثار","وثرت بها أسداً ملبدا",106,"د",2,0],["ولَبعْتُهُمْ نفسي على ضَنٍّ بها","يومَ الطُّفُوفِ بأرْخصِ الأثمانِ",107,"ن",1,0],["ولَباعي غالٍ على كلّ جِيدٍ","لَيس إلّا لقدر رمحي عِناقي",108,"ق",2,0],["ولباساً متى تشاء الليالي","كان عنّا محوَّلا منزوعا",109,"ع",2,0],["ولبّاه منّي الإخاءُ الصّري","حُ حين دعا أو إليه أشارا",110,"ر",2,0],["وَلَبِئس الصّديقُ هبّ نسيماً","بمقالٍ وبالحُشاشةِ نارُ",111,"ر",1,0],["ولَبَيتٌ حَلَلْتَ لم يُرَ فيهِ","قَطُّ إلّا نَجابةٌ ونجيبُ",112,"ب",1,0],["ولبيب يرعوي من كلمة","والغبيْ يحتاج قرعاً بالعصيّ",113,"ي",1,0],["ولبس الروض من ال","زهور ثوب التزيين",114,"ن",1,0],["ولبانت نار لديك كما با","نت لموسى من جانب الطور نار",115,"ر",1,0],["ولبُعْدهم طالت ذوائبُ ليلِهم","فيها يُغَطَّى نورُ وجه نهارهم",116,"م",1,0],["ولَبِسْتُ أَثواب الصِّبا مصقولةً","وصِقالُ ثوب هوايَ شيبُ تكَهُّل",117,"ل",1,0],["ولِبَطْشه خبَّا المهنَّ","دُ شَفْرَتَيهِ في القِرَاب",118,"ب",1,0]]}