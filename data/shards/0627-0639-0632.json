كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[458,"وكنت وأيام المزار رخية","https://www.aldiwan.net/poem56127.html","الطويل"],[458,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[458,"أتكتم يوم بانة أم تبوح","https://www.aldiwan.net/poem56247.html","الوافر"],[458,"أمرتكم أمري بنعمان ناصحا","https://www.aldiwan.net/poem56253.html","الطويل"],[461,"ألا حبذا مسعى تميم بن خندف","https://www.aldiwan.net/poem15149.html","الطويل"],[461,"سل الحي عني هل غشيت لغيره","https://www.aldiwan.net/poem15481.html","الطويل"],[464,"سري وعقود الأفق منثالة النظم","https://www.aldiwan.net/poem3173.html","عموديه"],[493,"ومرنان معبسة ضحوك","https://www.aldiwan.net/poem67311.html","الوافر"],[495,"يقولون لي لا تحب الوصي","https://www.aldiwan.net/poem9767.html","المتقارب"],[495,"أقول لإحدى المعضلات العظائم","https://www.aldiwan.net/poem10271.html","الطويل"],[500,"ولما تلافينا التلال بلعلع","https://www.aldiwan.net/poem37977.html","الطويل"],[504,"حلت حين ما حلت على المصايب","https://www.aldiwan.net/poem38413.html","الطويل"],[505,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[506,"صلاح الدين انت له نظام","https://www.aldiwan.net/poem2399.html","الوافر"],[514,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[515,"أعزز علي أبا شجاع أن أرى","https://www.aldiwan.net/poem12005.html","الكامل"],[515,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[515,"هل تعلمان طريقة لم تطرق","https://www.aldiwan.net/poem12186.html","الكامل"],[515,"ثغر الزمان بنجم الدين مبتسم","https://www.aldiwan.net/poem12263.html","البسيط"],[529,"نظام من الدر الثمين فرائده","https://www.aldiwan.net/poem37466.html","الطويل"],[551,"لو كنت أملك للأقدار واقية","https://www.aldiwan.net/poem47362.html","البسيط"],[551,"إني الشجاع وقد جزعت كما ترى","https://www.aldiwan.net/poem47701.html","الكامل"],[551,"فما ماء مزن بات جفن سحابة","https://www.aldiwan.net/poem47897.html","الطويل"],[551,"كم ذا سرى بالموت عنا مدلج","https://www.aldiwan.net/poem48018.html","الكامل"],[551,"أجر المدامع كيف شيتا","https://www.aldiwan.net/poem48033.html","مجزوء الكامل"],[558,"نحن من المنسوبين","https://www.aldiwan.net/poem33814.html","مجزوء الرجز"],[562,"إلى المغارب تسعى الشمس والقمر","https://www.aldiwan.net/poem52883.html","البسيط"],[562,"قفا بين الثنية والمصلى","https://www.aldiwan.net/poem52929.html","الوافر"],[563,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[586,"أرض الأحبة من سفح ومن كثب","https://www.aldiwan.net/poem17436.html","البسيط"],[586,"أعز الله أنصار العيون","https://www.aldiwan.net/poem17811.html","الوافر"]],"verses":[["أَعزَز عَلَيَّ بِأَن يَهُزُّكَ طالِبٌ","فَتَضَنَّ أَو تَلوي النَوالَ مَطالا",0,"ل",2,0],["أَعزِز عَلَيَّ بِأَن يَكونَ لَكُم","بِالأَمسِ ثَقَّفَها مُثَقِّفُها",1,"ف",3,0],["أَعَزُّ عَلى عَيني مِنَ العينِ مَوضِعاً","وَأَلطَفُ في قَلبي مِنَ القَلبِ مَوقِعا",2,"ع",2,0],["أَعزِز عَلَيَّ بِأَن أَراكَ وَقَد خَلَت","مِن جانِبَيكَ مَقاوِدُ العُوّادِ",3,"د",1,0],["أَعِزِز عَلَيَّ بِأَن يُفارِقَ ناظِري","لَمَعانَ ذاكَ الكَوكَبِ الوَقّادِ",3,"د",1,0],["أَعزِز عَلَيَّ بِأَن نَزَلتَ بِمَنزِلٍ","مُتَشابِهِ الأَمجادِ وَالأَوغادِ",3,"د",1,0],["أعْزِزْ بمَوْلِدِهِ الكَريمِ وخُصَّهُ","منْ ذِكْرِك التّقديسَ والتّحْميدا",4,"د",2,0],["أُعَزّي فيكَ أَهلَكَ أَم أُعَزّي","عُفاةَ الناسِ أَم هِمَمَ الكِرامِ",5,"م",1,1],["أَعزز عَلَيَّ بِأَن يَضيقَ بِكَ الثَرى","وَيَميلَ عَن عَرَصاتِكَ الزُوّارُ",6,"ر",1,0],["أَعزِز عَلَيَّ بِأَن يَزورَكَ راثِياً","مَن كانَ زارَكَ بِالمَدائِحِ مُنشِدا",7,"د",2,0],["أَعزِز بِأَن يَنعاكَ نَعيَ شَماتَةٍ","لِلأَولِياءِ المَعشَرُ الأَقتالُ",8,"ل",1,0],["أَعَزُّ أَجَدَّ الرَكبُ أَن يَتَزَحزَحوا","وَلَم يَعتَبِ الزَاري عَلَيكِ المَعاتِبُ",9,"ب",1,0],["َأعْزِزْ بِمَوْمُوقَةِ","جَاءَتْ ومنها الطَّلَبْ",10,"ب",1,0],["أعز أعزاء الحمى أبواكما","وأسطع جدٍّ في العلى لكما جد",11,"د",1,0],["أَعِزَّةُ مِصْرَ مُحْتَشِدُونَ فِيهِ","وَرَبَّاتُ الكَمَالِ مِنَ الغَوَانِي",12,"ي",1,0],["أَعْزِزْ عَلَى أَهْلِ النُّهَى أَلاَّ تُرَى","فِي الشَّوْطِ حِينَ تَسَابُقِ الأَقْرَانِ",13,"ن",1,0],["أَعْزِزْ عَلَى الإخْوَانِ أنَّ مَكَانَهُ","مُتَفَقَّدٌ فِي مُلْتَقَى الإخْوَانِ",14,"ن",1,0],["أَعْزِزْ عَلَيْنَا أَنْ نَرَى أَوْطَانَنَا","فِرَقاً وَتُقْتَسَمُ اقْتِسَامَ غَنَائِمِ",15,"م",1,0],["أَعْزِزْ بِهِ وَهْوَ مِنْ إِهْدَاءِ مِصْرَ إِلَى","أَبَرِّ جِيرَتِهَا بِالْعَهْدِ وَالذِّمَمِ",16,"م",1,0],["أَعَزَّكِ اللهُ مِنْ عَرُوسٍ","بِقُرْبِهَا يَبْرَأُ السِّقَامُ",17,"م",1,1],["أعِزَّةٌ إنْ بَدَا مِنْ فَضْلِهِمْ أَثَرٌ","فَكَمْ لَهُمْ مِنْ جَميلٍ ظَلَّ مَكْتُومَا",18,"م",2,0],["أعِزَّةُ يَوْمِ أُسْتِرْلِتْسَ كَانُوا","قَلِيلاً وَالْعِدَى كُثْرٌ ضِخَامُ",19,"م",1,0],["أُعُزُّكَ بِالحِجازِ وَإِن تَسَهَّل","بِغَورِ الأَرضِ تُنتَهَبُ اِنتِهابا",20,"ب",2,0],["أُعَزّيكِ عَمّا تَعلَمينَ وَقَد أَرى","بِعَينَيكِ مِن زَيدٍ قَذىً غَيرَ بارِحِ",21,"ح",1,0],["أَعزِز عَلى ساداتِ قَومِكَ أَن تُرى","فَوقَ الفِراشِ مُقَلَّبَ الأَوصالِ",22,"ل",1,0],["أَعَزُّ بَني الدُنيا وَأَعلى ذَوي العُلا","وَأَكرَمُ مَن فَوقَ التُرابِ وَلا فَخرُ",23,"ر",1,0],["أعزِز عليّ بأن ضيف مسامعي","لم يحظَ من ذاك اللسان بقاري",24,"ر",2,0],["أعزز عليّ بأن رحلت ولم تخض","أقدام فكرك أبحر الأشعار",24,"ر",1,0],["أعزز عليّ بأن رفقت على الردى","وعليك من دمعي كدّر نثار",24,"ر",1,0],["أعزيك في غصنٍ ذوى قبل ما ارْتوى","وقامت به وُرْق الثنا تترنَّم",25,"م",1,0],["أعزز عليَّ بأن ألقى عوارفه","ملءَ الزمان وإنِّي لا ألاقيه",26,"ي",2,0],["أعزز عليَّ بأن تبلى شمائله","تحتَ التراب وما تبلى أياديه",26,"ي",2,0],["أعزز عليَّ بأن ترعى النجوم على","سرحٍ من الملك قد خلاَّهُ راعيه",26,"ي",2,0],["أعزُّ من عزَّ يُستجارُ به","وهو مباحُ الثراء مُنْتَهَبُهْ",27,"ب",2,0],["أعزِرْ عليَّ بأن أضحتْ مناسبُهْ","بُدِّلنَ فيه وفي أيامهِ نُدَبا",28,"ب",2,0],["أعزِزْ عليَّ أبا إسحاقَ أنْ ذهبت","منكَ الليالي بعلق جدِّ منفوسِ",29,"س",1,1],["أعزِزْ عليَّ بَما رأيتَ فإنه","مرضٌ بُليتَ به من الأمراض",30,"ض",1,0],["أعزمُكَ أنك إن أنت صر","ت في ذروة الفلك السابع",31,"ع",1,0],["أعزِزْ عليَّ بأن سُرَّتْ بليلتها","وأنت صبٌّ عميدُ القلب متبولُ",32,"ل",1,0],["أعزِرْ عليَّ بمنزلاتِك أن غدتْ","ولهنَّ دونك عامرٌ وحلالُ",33,"ل",1,0],["أعزِزْ عليَّ بصافناتك أن غدتْ","تبكي السروجُ لهنّ والأجلالُ",33,"ل",1,0],["أعززْ عليَّ بعارفاتك أن غدتْ","يبكي الرجاءُ لهنَّ والتأمالُ",33,"ل",1,0],["أعززْ عليَّ بأصدقائك أن غدوا","ولشخصكَ الغالي بهم إخلالُ",33,"ل",1,0],["أعزِزْ عليَّ بأنْ أُرى","خِلْواً لديك مِنَ المعَاني",34,"ي",1,0],["أَعَزُّ مَن وَلَدَت حَوّاءُ مِن وَلَدٍ","إِنَّ الرَباءَ لَهُم وَالفَخرَ إِن فَخَروا",35,"ر",3,0],["أَعَزُّ الوَرى قَدراً وَأَمنَعُهُم حِمىً","وَأَكرَمُهُم نَفساً وَأَرفَعُهُم عُلى",36,"ل",2,0],["اعزز فتاتك واخطب عن معاشرة","بريئة ولامّ الناقد الهبل",37,"ل",1,0],["أعِزني السمع أعِر","عندي لكم شئ يسر",38,"ر",1,0],["أعزل المنِكبين إلا من الحق","ق ومن حجة كنصل الفرند",39,"د",1,0],["أعزيك أبا مكسى","وإن لم تبتئس نفسى",40,"س",2,1],["أَعِزَّةٌ أَينَما حَلَّت رَكائِبُهُم","لَهُم مَكانٌ كَما شاؤوا وَإِمكانُ",41,"ن",1,0],["أَعَزمي طالَ هَذا اللَيلُ فَاِنظُر","أَمِنكَ الصُبحُ يَفرَقُ أَن يَؤوبا",42,"ب",2,0],["أَعَزُّ مُغالِبٍ كَفّاً وَسَيفاً","وَمَقدِرَةً وَمَحمِيَةً وَآلا",43,"ل",2,0],["أعِزَّة أملاكِ البلادِ أذِلَّةٌ","لديكَ وصعبُ الحادثات ذَلولُ",44,"ل",1,0],["أعزِزْ عليَّ بأن أُسَرِّحَ ناظرِي","في مجمعٍ وسِواكَ صدرُ المجمعِ",45,"ع",1,0],["أعزِزْ عليَّ بأن يحدِّثَ نفْسَهُ","بالأمن بعدَك كلُّ نابي المضجعِ",45,"ع",1,0],["أعزز عليَّ بأن يبُزَّكَ حاسِراً","من كان يُحْجِمُ عنكَ بين الدُرَّعِ",45,"ع",1,0],["أُعَزّي الأَريَحِيَّ أَبا عَلِيٍّ","عَنِ الخِرقِ الأَغَرِّ أَبي سَعيدِ",46,"د",1,0],["أَعزَزتَ أُمَّةَ أَحمَدٍ","بِالفاضِلينِ وُلاةِ عَهدِك",47,"ك",1,0],["أَعزِز عَلَيَّ بِأَن يَبينَ مُفارِقاً","مِنّا عَلى عَجَلٍ أَخي وَأَخوكا",48,"ك",2,1],["أَعْزِزْ عليَّ بأن راحَت ديارُكُمُ","مَثوى الهُمومِ وكانَتْ مَسرَحَ الهِمَمِ",49,"م",1,0],["أعزز علي بأن يشفى عدوكم","ريا وتظمون أحشاء وأكبادا",50,"د",2,0],["أعزِزْ عليَّ بأن أرى أشلاءَه","تَدْمَى بِظفْرٍ للعدوِّ وناب",51,"ب",1,0],["أَعزِز عَلَيَّ بِأَن أَدعوكَ ذا أَمَلٍ","فَلا يُجابَ بِرِفدٍ مِنكَ يَنهَمِرُ",52,"ر",1,0],["أَعَزُّ أَظهَرَ مِن راياتِ عَزمَتِهِ","آياتِ جودٍ لِآياتِ الكِرامِ مَحَت",53,"ت",1,0],["أعزّ بهم ذو العرشِ دينَ مُحَمَّدٍ","وَضُمّ عليه من كفالَتِه حجرُ",54,"ر",1,0],["أَعزِزْ علَيَّ بِرَونقٍ يبكي دماً","بِتَواتُرِ الأَزمانِ والآبادِ",55,"د",1,0],["أَعزِز بِعَيّاشٍ عَلَيَّ مُغَيَّباً","في غَيرِ حُفرَتِهِ الحِجى وَالخيرُ",56,"ر",1,0],["أَعزِز عَلَيهِ إِذا اِبتَأَستُم بَعدَهُ","وَتُذُكِّرَت بِالأَمسِ تِلكَ الأَنعُمُ",57,"م",1,0],["أَعزِز عَلَيَّ وَقَد حَلَلتَ عَلاقَةً","بَينَ الجَوانِحِ أَن شَحَطَت جِوارا",58,"ر",2,0],["أَعزِز عَلَيَّ بِأَن أُرَوِّعَ شِبهَها","أَو أَن يَذُقنَ عَلى يَدَيَّ حِماما",59,"م",2,0],["أعزَّ اللهُ دَوْلَتَهُ وأحيا","بهِ أُممَ المشارقِ أجمعينا",60,"ن",2,0],["أعزُّ حُماتِها إن نابَ خطبٌ","وخيرُ كُفاتِها المُتخيَّرينا",60,"ن",2,0],["أَعَزَّهُ الفاتِحُ الغازي وَأَورَثَهُ","بَأساً يَرُدُّ عَلى أَعقابِها النُوَبا",61,"ب",2,0],["أعِزّةُ مَن يُحْذَى النعالَ أذِلّةٌ","له ومُلوكُ العالَمينَ قراضيب",62,"ب",1,0],["أعْزَزْتَ دينَ اللّهِ يا ابنَ نبيّه","فاليومَ فيهِ تخمُّطٌ وإباء",63,"ا",2,0],["اِعزِم عَلى سَلوَةٍ إِلّا عَنِ الكاسِ","وَدَع سِواها مِنَ اللَذّاتِ لِلناسِ",64,"س",1,1],["أُعَزّي يا مُحَمَّدُ عَنكَ نَفسي","مَعاذَ اللَهِ وَالمِنَنِ الجِسامِ",65,"م",1,1],["أَعَزُّ العَيشِ وَصلُ المُردِ دَهري","وَبُؤسُ العَيشِ وَصلي لِلغَواني",66,"ي",1,0],["أَعَزُّ بَني الدُنِّيا بِغَيرِ مَذَلَّةٍ","مُبينُ وَجاً مِنها فَقيدُ شُرودِ",67,"د",1,0],["أَعززتِهم وأهانوا","ذكرتِهم ونسوكِ",68,"ك",1,0],["أعزّ مكانٍ في الدّنى سرج سابحٍ","وخير جليسٍ في الزّمان كتاب",69,"ب",1,0],["\"أعزمي، طال هذا الليل فانظر","أمنك الصبح يفرق أن يئوبا\"",70,"ب",2,0],["أعزَّتْ أُساتَكَ أدواؤُها","هو الحقُّ ما كان داءً عُضالا",71,"ل",2,0],["أُعَزِّيكَ لا أَنِّي أَظُنُّكَ جَازِعاً","لِخَطْبٍ وَلَكِنِّي عَمَدْتُ لِوَاجِبِ",72,"ب",1,1],["أَعزِزْ عَلَيَّ بِأَنْ أَرَاكِ رَهِينَةً","فِي جَوْفِ أَغْبَرَ قَاتِمِ الأَسْدَادِ",73,"د",1,0],["إِعْزِمْ وَكَدِّ فَإِنْ مَضَيْتَ فَلاَ تَقِفْ","وَاصْبِرْ وَثَابِرْ فَالنَّجَاحُ مُحَقَّقُ",74,"ق",1,1],["أَعْزِزْ بِأَنْفسِكْم فَمَا هِيَ أَنْفسٌ","مَسْفوكَةٌ فِي التّربِ سَفْكَ جُبَارِ",75,"ر",1,0],["أَعَزُّ مِنَ الْهَوَى وُدٌّ صَحِيحٌ","وَأَبْقَى مِنْهُ فِي الزَّمَنِ الشَّدِيدِ",