{"poems":[[79,"أجاد يراع الحسن خط عذاره","https://www.aldiwan.net/poem36409.html","الطويل"],[95,"في ذمة الله وفي عهده","https://www.aldiwan.net/poem11143.html","السريع"],[49,"لمثلها يستعد البأس والكرم","https://www.aldiwan.net/poem25146.html","البسيط"],[53,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[53,"نحن ميامين على أننا","https://www.aldiwan.net/poem66089.html","السريع"],[47,"هبيه لمنهل الدموع السواكب","https://www.aldiwan.net/poem10894.html","الطويل"],[51,"ألا هل إلى طول الحياة سبيل","https://www.aldiwan.net/poem63078.html","البسيط"],[69,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[108,"أجادير","https://www.poetsgate.com/ViewPoem.aspx?id=179602",""],[108,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[92,"الحزبان المتآخيان","https://www.poetsgate.com/ViewPoem.aspx?id=179105",""],[47,"هَبيهِ لمُنْهَلّ الدّموعِ السّوَاكِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31699",""],[53,"لازلتَ تبلغُ أقصى السُؤْلِ والأملِ","https://www.poetsgate.com/ViewPoem.aspx?id=30336",""],[124,"عباس إن ابني لي مفزع","https://www.aldiwan.net/poem49262.html","السريع"],[147,"بك اقتضى الدين دينا كان قد وجبا","https://www.aldiwan.net/poem11722.html","البسيط"],[186,"لقد نال نعمان المعالي فأصبحت","https://www.aldiwan.net/poem67000.html","الطويل"],[257,"هذا هو السعي لا ما يدعي الواني","https://www.aldiwan.net/poem1430.html",""],[257,"أما كفاك تلافي في تلافيكما","https://www.aldiwan.net/poem1474.html",""],[276,"سمعت سويجع الاثلاث غنى","https://www.aldiwan.net/poem52085.html","الوافر"],[358,"من لصب صبا المعاهد أشجاه","https://www.aldiwan.net/poem40001.html","الخفيف"],[396,"يا تار كالصلاة الفرض كم ذا حرام","https://www.aldiwan.net/poem54497.html","عموديه"],[402,"في ذمة الله وفي عهده","https://www.aldiwan.net/poem11016.html","عموديه"],[411,"عليك إذا انجاب الدجى بكباب","https://www.aldiwan.net/poem50056.html","الطويل"],[435,"عجبت للبلبل المفتون حيث غدا","https://www.aldiwan.net/poem40086.html","البسيط"],[457,"سواي استمالته الظباء الأوانس","https://www.aldiwan.net/poem13805.html","الطويل"],[469,"لذاك الحبيب وهذي الدمن","https://www.aldiwan.net/poem3319.html","عموديه"],[505,"ما بال قوم ترى للغير مقدرة","https://www.aldiwan.net/poem38007.html","البسيط"],[534,"ومن جار في الحكم فهو امرؤ","https://www.aldiwan.net/poem37362.html","المتقارب"],[556,"ما زرت إلا خداعا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"],[563,"من كان بالله أنسه","https://www.aldiwan.net/poem34433.html","المجتث"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138404",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122560","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96991","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63883","المجتث"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145943","المتقارب"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96294","المتقارب"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25344","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46509","الرجز"],[1459,"","https://poetry.dctabudhabi.ae/diwan/poem/138019",""],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101049","البسيط"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95096","الرجز"],[2309,"","https://poetry.dctabudhabi.ae/diwan/poem/140204",""],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60899","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202736","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86306","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108407",""],[3605,"","https://poetry.dctabudhabi.ae/diwan/poem/130569","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109941","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117862","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114272","الطويل"],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/142943","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105120","البسيط"],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[5302,"تطاول ليلي","https://www.poetsgate.com/ViewPoem.aspx?id=201153",""],[592,"جاس بن جرجيس بغياً من شقارته","https://www.poetsgate.com/ViewPoem.aspx?id=128821",""],[5751,"الصقر مرة اخرى","https://www.poetsgate.com/ViewPoem.aspx?id=214980",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[6023,"فاق جميع الأقران","https://www.poetsgate.com/ViewPoem.aspx?id=123919",""]],"verses":[["ولمْ يفْتَقرْ فيهِ لخَتْمٍ وطابَعٍ","فمَبْسِمُهُ أغْناهُ عنْ طابَعِ السّرِّ",0,"ر",1,0],["وَلَمْ يُفَارِقْ بِمُنَاءاتِهَا","سِوَى أَذَاهَا وَسِوَى سُهْدِهِ",1,"د",2,0],["وَلَم يُفَضِّل عَقيلاً في وِلادَتِهِ","عَلى عَلِيٍّ أَخيهِ السِنُّ وَالقِدَمُ",2,"م",1,0],["ولم يفتْ فائتٌ تأسى النفوسُ له","كنائلِ الكفِّ ذاتِ العُرفِ والنفلِ",3,"ل",1,0],["ولم يُفَخِّمْكَ الذي نِلْتَهُ","بل للعطايا بك تَفخيمُ",4,"م",1,0],["وَلَم يَفتَرِض مِنكُم فَرائِصَ أَهدَفَت","لِبَطشَةِ أَظفارٍ لَهُ وَمَخالِبِ",5,"ب",1,0],["وَلَم يَفتَقِر يَوماً وَإِن كانَ مُعدَماً","جَوادٌ وَلَم يَستَغنِ قَطُّ بَخيلُ",6,"ل",1,0],["وَلَمْ يَفْتِنْهُمُ ماءٌ نَمِيرٌ","مِنَ الدنيا ولا مَرْعىً خصيبُ",7,"ب",1,0],["ولم يُفلتِ الموتُ شُبَّانَها","ولم يُعتق الموتُ كُهَّالَها",8,"ل",3,0],["ولم يَفْرِشْ لنا الطُّرقاتِ وَرْدًا","بنوك، ولا بتسليم أشاروا؟",9,"ر",3,0],["ولم يفضلِ الاراء إلا لأنه","يدبّرهُ رأسٌ حكيمٌ مُفَضَّل",10,"ل",1,0],["وَلمْ يَفتْرِصْ منكُمْ فَرَائِصَ أهدفَتْ","لِبَطْشَةِ أظْفَارٍ لَهُ، وَمَخالِبِ",11,"ب",1,0],["ولم يفتْ فائتٌ تأسى النفوسُ به","كنائلِ الكفِّ ذاِت العُرفِ والنفلِ",12,"ل",1,0],["ولم يفده طول تسبيحه","في سره طوراً وفي جهره",13,"ر",2,0],["وَلَم يَفُت مِنهُمُ إِلّا أُغَيلِمَةٌ","نَجَت بِهِم مُقرَباتٌ تَحمِلُ الأُرَبا",14,"ب",2,0],["وَلَم يَفتَخِر يَوماً بِها غَير أَنَّها","بِهِ تَتَباهى أَرِّخوها وَتَفخرُ",15,"ر",1,0],["وَلَم يُفتَهَم وَلَكِن فاتَهُم شَرَف الا","قدامِ مِن غبن وَخُسرانِ",16,"ن",1,0],["وَلَم يَفتهم سِوى مَن كانَ مَعقِلُهُ","مُطهماً حَثّهُ رَكضاً وَتَحريكا",17,"ك",2,0],["وَلَم يفت الغَني بالعجز حظ","وَلا بالحزم يدرك ما تمنى",18,"ن",2,0],["ولَمى فيهِ لَو يَذوق لَما فاه","بِملامٍ وَلا شَكَوتُ ملالا",19,"ل",2,0],["ولم يفصل ولم يسمع لقائل كلام","وجابان ليس له عهد ولا له ذمام",20,"م",1,0],["ولم يفارق بمناءاتها","سوى أذاها وسى سهده",21,"د",2,0],["ولم يفتَح الأقوامُ باباً إلى المُنى","كَبابِ شَرابٍ أو كبابِ كبابِ",22,"ب",1,0],["ولم يفارقه لو واللَه فارقه","مثلي لذاب جوىً أو مات أشواقا",23,"ق",2,0],["ولم يفَ منا غير شهمٍ غشمشم","يفوقُ على الجوزاء حينَ يقايَسُ",24,"س",1,0],["ولم يفترق فعلهُ والتقى","ولم يجتمع حكمهُ والغبن",25,"ن",1,0],["ولم يفُتْ ذا انْكِسارٍ فيضُ بارِئِهِ","ولم يفُزْ بالإِحْسانِ مَغْرُورُ",26,"ر",1,0],["ولَمْ يَفْصِلِ الأَمْرَ لكنْ غَدا","عَلَى ذَلِكَ الخَصْمِ مِنْ جِنْسِهِ",27,"ه",1,0],["وَلَم يَفتهمْ وقَد حازوا الكمال على","كلّ الخَلائق إلّا طولُ أَعمارِ",28,"ر",1,0],["ولم يَفُتْ عنه فرضٌ","محفوظة فيه خمسه",29,"س",2,0],["ولم يفد مصلح يوما مواطه","كمشئ معهد العرفان اوبان",30,"ن",1,0],["ولم يَفتَتِح موسى مدينةَ مُترفٍ","فأرتَجَها من بعدِه برِتاجها",31,"ج",3,0],["ولم يفتقر أفق السماء لكوكب","سواها وقد أغنته عن كل ثاقب",32,"ب",1,0],["ولم يَفُتْنا مَصوصٌ","ولم يَفُتْنا قَريس",33,"س",1,0],["وَلَمْ يَفْقَهُوا مِنكَ إلاَّ الذي","يُفَلْسِفُهُ القَاريءُ الحَاذِقُ",34,"ق",1,0],["ولم يفزع الحيُّ من صَوتها","أمامَ بيوتهمُ تَصخَبُ",35,"ب",1,0],["وَلَمْ يُفَجَّشْ عِنْدَ صَيْدٍ مُخْتَرَقْ","نِيءٍ وَلا يَذْخُرُ مَطْبُوخَ المَرَقْ",36,"ق",1,0],["وَلَم يَفق مِن سُكره وَلا انتفع","بِقَوله وَإِنَّما الحَرب خدع",37,"ع",1,0],["ولم يفضُل وليٌّ قطُّ دَهراً","نبياً أو رسُولاً في انتِحَالِ",38,"ل",1,0],["ولم يفت نظر الصديق ما جمعت","فيه النبوة من آي ومن علم",39,"م",1,0],["ولَم يُفِدني في الهوَى","سوَادُها سوى دَها",40,"ه",2,0],["ولم يفهموا معنى الخطاب الذي به","يحادثهم في كل يوم فيطنب",41,"ب",1,0],["ولم يُفتَنْ بنعجةٍ حَسُنَت","دَاوْودُ حتى مضت سُدى حكمُه",42,"م",2,0],["ولم يَفرُق قديمك عن جديدي","طوينا الفرقَ والزمن المديدا",43,"د",2,0],["وَلَم يَفُز صبكم يَوماً بِمَطلَبِهِ","قَد صحت وَالقَلبُ يَذكو في تلهبهِ",44,"ه",1,0],["ولم يفتخر الا بصالح فعله","وما غره جاه الغني بذي الدنا",45,"ن",2,0],["ولم يفد فيه علاج نفعا","وهو يفيض الدمع شفعا شفعا",46,"ع",2,0],["ولم يَفضُض لها ختماً","سِوَى المُتَجاوزِ الحَدِّ",47,"د",1,0],["ولم يفلح سوى عبد له في","ربا الإيمان بنيان وطيد",48,"د",1,0],["وَلَم يُفتَحِ الثَّانِي اتِّبَاعاً لِكَسرِهِ","مَعَ الأبِ مَريَمٌ تَصُونُكَ عَن خَبطِ",49,"ط",1,0],["ولم يفهموا ما تكتب البيض في الوغى","ولا السمر حتى أعجما بالحوافر",50,"ر",1,1],["وَلَم يَفُت أوذيسَ أَنَّ الجُرحا","ما كانَ قَتّالاً لِذا تَنَحّى",51,"ح",2,0],["وَلَم يَفُز مِنهَا سِوَى مِنَ ادَّخَرُ","أعمَالَ طَاعَاتٍ بِهَا قَد افتَخَر",52,"ر",1,0],["ولم يفز منها بوزن حبه","فقل لمن أهدى الينا عتبه",53,"ه",1,0],["ولم يفز بالمنى من ذل جانبه","ولم يطل في الورى من باعه قصرا",54,"ر",2,0],["ولم يفن حتى غاب عن ذكر ذكره","شهودا لمشهود هناك بلا ثاني",55,"ن",2,0],["ولم يفقد الآن آماله","بمضناه والصبر لم ينفد",56,"د",1,0],["ولم يفارقه مولود وكيف وقد","أباح خالص حق لله للوثن",57,"ن",1,0],["ولمْ يَفْتَرَّ في سُبُلِ المَعالي","وَهَلْ جَبَلٌ يَحيدُ عن العَلاءِ",58,"ا",2,0],["ولم يفضض الارسال ما ادخرت","له المقادير في أحكامها الأوليتي",59,"ت",2,0],["ولم يفته فضلٌ","بل زاد فوق الإحسان",60,"ن",1,0]]}