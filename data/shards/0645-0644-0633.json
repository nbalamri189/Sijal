{"poems":[[38,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[2,"شطت أميمة بعدما صقبت","https://www.aldiwan.net/poem25042.html","الكامل"],[52,"مل سقامي عوده","https://www.aldiwan.net/poem27131.html","مجزوء الرجز"],[48,"عفا المصلى وأقوت الكثب","https://www.aldiwan.net/poem10767.html","المنسرح"],[38,"مَا بَالُ دَفِّكَ بالْفِرَاشِ مَذِيلاَ","https://www.poetsgate.com/ViewPoem.aspx?id=21222",""],[196,"أطربت أم رفعت لعينك غدوة","https://www.aldiwan.net/poem54404.html","الكامل"],[301,"أفد الرحيل وليته لم يأفد","https://www.aldiwan.net/poem45492.html","الكامل"],[354,"من لصب صبا المعاهد أشجاه","https://www.aldiwan.net/poem40001.html","الخفيف"],[459,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[459,"هل تقبلون إنابة الدهر","https://www.aldiwan.net/poem56194.html","أحذ الكامل"],[516,"من كان لا يعشق الأجياد والحدقا","https://www.aldiwan.net/poem12182.html","البسيط"],[552,"لو كنت في مثل حالي لم ترد عذلي","https://www.aldiwan.net/poem47288.html","البسيط"]],"verses":[["مُلسَ الحَصى باتَت تَوَجَّسَ فَوقَهُ","لَغَطَ القَطا بِالجَلهَتَينِ نُزولا",0,"ل",2,0],["مَلساءُ مُحدَلَةٌ كَأَنَّ عَتادَها","نَوّاحَةٌ نَعَتِ الكِرامَ مُشَبِّبُ",1,"ب",1,0],["مَلَّ سَقامي عُوَّدُه","وَخانَ دَمعي مُسعِدُه",2,"د",2,1],["مُلسٌ وَأَمثالُها مُحَفَّرَةٌ","صُوِّرَ فيها القُسوسُ وَالصُلُبُ",3,"ب",1,0],["مُلْسَ الْحَصَى بَاتَتْ تَوَجَّسُ فَوْقَهُ","لغطَ القطا بالجهلتينِ نزولا",4,"ل",2,0],["مُلسُ المتونِ يَصورُهُنَّ عَنِ الهَوى","فَيضٌ يُرِدنَ مَكانَهُ وَضُحولُ",5,"ل",1,0],["مَلسى يَمانِيَةٌ وَشَيخٌ هَمَّةٌ","مُتَقَطِّعٌ دونَ اليَماني المُصعِدِ",6,"د",1,0],["مَلَّ سَمعي مِن الملام وَأَعياه","لُؤم لَوم الوشاة قيلاً وَقالا",7,"ل",2,0],["ملساء تجري منه في أملسٍ","يُروِي صداها نقعُهُ الثائرُ",8,"ر",1,0],["ملساءَ لا تجد الأكفُّ بها","عَلَقاً بأنملةٍ ولا ظُفْرِ",9,"ر",1,0],["ملساء لولا التغالي قلت مختصراً","إذا النسيم مشى من فوقها زلقا",10,"ق",2,0],["ملساءَ يحسبها الأقوامُ في مَلَكٍ","وإنّما هي بالتّحصيلِ في رَجُلِ",11,"ل",1,0]]}