6688",""],[5674,"نسمة الدير","https://www.poetsgate.com/ViewPoem.aspx?id=185169",""],[5691,"أسوار وحراب","https://www.poetsgate.com/ViewPoem.aspx?id=206525",""],[5704,"بالذي سوَّاكَ ...","https://www.poetsgate.com/ViewPoem.aspx?id=191808",""],[5725,"موت عراقي الشذى","https://www.poetsgate.com/ViewPoem.aspx?id=207163",""],[5776,"لحيةُ الصّبح","https://www.poetsgate.com/ViewPoem.aspx?id=199324",""],[5804,"الاقتراب الخطير","https://www.poetsgate.com/ViewPoem.aspx?id=180656",""],[5910,"لغةُ الضَّادِ","https://www.poetsgate.com/ViewPoem.aspx?id=206217",""],[5910,"بِمكةَ نورٌ قد سَرَى وضياءُ","https://www.poetsgate.com/ViewPoem.aspx?id=206977",""],[5956,"كل شيء فيكِ يغري","https://www.poetsgate.com/ViewPoem.aspx?id=182627",""],[5969,"مَدارٌ لئيم","https://www.poetsgate.com/ViewPoem.aspx?id=206928",""],[6026,"مرآة الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=214648",""],[6045,"وثبة قلب طروب","https://www.poetsgate.com/ViewPoem.aspx?id=181560",""],[4442,"فقه الشريعة أول","https://www.poetsgate.com/ViewPoem.aspx?id=171209",""],[6084,"يا سقى صوب الحيا الحي غيثاً","https://www.poetsgate.com/ViewPoem.aspx?id=170876",""],[6102,"زيفا الإسرائيلية","https://www.poetsgate.com/ViewPoem.aspx?id=184171",""],[6117,"أَوْرَاقُ مُسَافِرْ","https://www.poetsgate.com/ViewPoem.aspx?id=182787",""],[6124,"الفارس الذي لا يأتي","https://www.poetsgate.com/ViewPoem.aspx?id=201237",""],[6131,"رسولُ الثَّرَى","https://www.poetsgate.com/ViewPoem.aspx?id=189281",""],[5309,"في نظام مرصع الأصفاد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573552",""],[469,"وزرت مصرا بغاب من قنا وظبى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574817",""],[6213,"شجون عاتية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85497&r=&rc=100",""],[6213,"مناهل الرحمن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81911&r=&rc=86",""],[6233,"في خمس دقائق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82085&r=&rc=30",""],[4035,"ناعس الأجفان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1526&r=&rc=9",""]],"verses":[["يَرتَمي وُجهَةَ الرِئالِ إِذا آ","نَسَ لَونَ لإِظلامِ وَالإِدجانِ",0,"ن",1,0],["يرتدي أشلاءه ، يمشي على","مقلتيه حافيا ، يهذي ويومي",1,"م",2,0],["يرتمي فوق شظايا جلده …","يطبخ القبح ، بشدقيه ويرمي",1,"م",2,0],["يَرْتَاحُ لِلأَثْوَابِ يُزْهَى بِهَا","وَالْخَيْطُ مَعْزُولٌ لأَكْفَانِهِ",2,"ن",2,0],["يَرتَعي بِالقَنانِ يَقرو أَريضاً","فَاِنتَحى آتُناً جَدائِدَ نورا",3,"ر",2,0],["يَرتاحُ لِلمَعروفِ لا مُتَرَبِّحاً","فيهِ وَلا هُوَ في الجَميلِ مُرابي",4,"ب",2,0],["يَرْتَدُّ رَيْبُ الدَّهْرِ عَنْهَا حَاسِراً","وَتُصَانُ بِالأَرْوَاحِ وَالأَبْدَانِ",5,"ن",1,0],["يَرْتَقِبُونَ المَوْعِدَ المُرْتَجَى","لِذَلِكَ الأَمْرِ الْعُجَابِ الجُسَامْ",6,"م",1,0],["يرتجى سيبه ويخشى ذكاه","فيرجى نقداً ويحذَرُ نقدا",7,"د",2,0],["يرتاض قلبي إذا ما الحبّ خامرَه","فخلّ عاذله في الحبِّ يغتاظ",8,"ظ",1,0],["يرتدّعن إدراكه مسلم","ويصبح الفاضل مفضولا",9,"ل",2,0],["يرتديه في السِّلْم زَيْناً وطوْراً","يَنْتَضيه في الحرب عند جلادِهْ",10,"د",2,0],["يرتاح للنَّيْلوْفر القلب الذي","لا يستفيق من الغرام وَجَهْدِهِ",11,"د",2,1],["يرتجي فضلكمْ مرجٍّ ويتلو","علُّكُم بالفواضِلِ الإنهالا",12,"ل",2,0],["يرتدُّ عنه جَفنُ حاسدِهِ","وكأنهُ بالنارِ مكتحِلُ",13,"ل",1,0],["يُرتَجى مِن يَمينِهِ ما يُرَجّى","مِن يَمينِ الحَيا مَكانٌ جَديبُ",14,"ب",1,0],["يَرتَجُّ مِن خَلفِها كَثيبٌ","يَعيا بِهِ خَصرُها الضَعيفُ",15,"ف",1,0],["يُرتَجى لِلصَفحِ مَوتوراً وَلا","يَهَبُ السُؤدُدَ فيهِ لِلحَنَق",16,"ق",1,0],["يَرتَدي ظِلَّ السَّديَرْينِ فإنْ","شَبَّتِ الحربُ ارتدى ظِلَّ الأَسَلْ",17,"ل",1,0],["يرتدُّ عنه جريحاً من يُسَالِمُه","فكيفَ يَسْلَمُ منه من يُحارِبُه",18,"ب",2,0],["يرتاحُ ما غَنَّى الحديدُ إلى الوغَى","فيخوضُ مَوجاً منه أكدرَ مُجلِبا",19,"ب",2,0],["يَرتَعُ في رَوضِ","خَدِّهِ نَظَري",20,"ي",1,0],["يَرتَدُّ أَمضى الظُبى عَنها وَإِن عَبَثَت","بِها الهُمومُ فَأَمسَت كَالغَرابيلِ",21,"ل",1,0],["يَرتع بَينَ الأَكم","يَهيم في كُل واد",22,"د",1,0],["يَرْتاحُ إنْ ذُكِرَ الحِمَى وعَقِيقه","وأراكُه وثُمامُه والشِّيحُ",23,"ح",1,0],["يَرْتَاحُ إنْ سُئِلَ النَّوالَ كَأنَّما","وَرَدَتْ عليه بِشارَةٌ بِغُلامِ",24,"م",1,0],["يَرتابُ منها الموجُ وهو غطامط","ويداع منها الخطب وهو جليل",25,"ل",1,0],["يَرتَجي الناسُ أَن يَقومَ إِمامٌ","ناطِقٌ في الكَتيبَةِ الخَرساءِ",26,"س",3,0],["يَرتَدُّ طَرفُ العَيْنِ مِنْ حدّهِ","عَنْ كَوْكَبٍ للموتِ لَمَّاعِ",27,"ع",1,0],["يَرْتَمِي مَاؤُهَا مُثِيراً رَشَاشَاً","مِنْ عُصَافَاتِ لُؤْلُؤٍ مَذْرُورِ",28,"ر",1,0],["يَرْتَقِبُ الخَيْرُ عَلَى","يَديْكَ لِلمُسْتَقْبَلِ",29,"ل",1,0],["يَرْتادُهَا بِذكَائِهِ وَدَهَائِهِ","وَكَأَنهُ يَرْتَادُهَا بِفَيَالِقِ",30,"ق",1,0],["يَرْتَادُ حاجَاتِ الحِمَى لِقَضَائِهَا","وَيَسُدُّ خَلاَّت بِغَيْرِ سُؤَالِ",31,"ل",1,0],["يَرْتَقِبُ العَصْرُ أَنْ يُقَلَّدَهُمْ","حَيْثُ تُنَاطُ الحِلَى مِنَ الصَّدْرِ",32,"ر",1,0],["يَرْتَادُ كُلَّ مَكَانٍ","فِي إِثْرِهَا وَهْوَ شَادِي",33,"د",2,0],["يرتحل الصيف..فقوميبنا نسكب في وداعه دمعتينْ","كان كريماً..طيباً..طيباً أحبنا محبة الوالدين",34,"ن",1,1],["يرتدّ مدهوشا ، إلى جلده","كهارب يخشى ، سقوط الإزار",35,"ر",1,0],["يرتدي زي المرائي .. . ينكفي","عاريا كالصخر شوكي الصلابة",36,"ب",2,0],["يرتمي يرتمين يجثو فينصبن","له من صدورهن وسائد",37,"د",1,0],["يرتدي كل ساعة ألف لون","وله كل ساعتين نظام",38,"م",1,0],["يرتحل الصيف..فقوميبنا","نسكب في وداعه دمعتينْ",39,"ن",1,1],["يرتحل الصيف فوالهفتا","على زمان..كغبار اللجين",39,"ن",1,0],["يرتحل الصيف وأبقا أنا","أمشي على الثلج..بخفي حُنين",39,"ن",1,0],["يرتاب عصري بالصريح المنجلي","كالبدر من صدقي وحسن بياني",40,"ن",2,0],["يرتجي طورا ويخشى فطرة","يا لكنز عنه ما انحل الرصد",41,"د",1,0],["يرتاع من طول نومه الأمل","ويشتكيه الرجاء والسأم",42,"م",1,0],["يَرتَاحُ نَادِيهُمُ لِلمَنِّ إِن سُئِلُوا","ولَم يَكُن وهو مَنَّانٌ بِمَنَّانِ",43,"ن",1,0],["يرتاح قلبي إلى قطع السرى فإذا","أمضيت عزمي أتاه العجز يعترض",44,"ض",1,0],["يرتاح قلبي إلى البيض الحسان كما","أحب كل ذوات الدل والخنث",45,"ث",1,0],["يرتقي كالنسر ثم ترى","مرتقاه عين منحدره",46,"ر",2,0],["يرتل حجة لم يبق منها","سوى سطرين من قدم تذوب",47,"ب",1,0],["يرتله في ركعة وهو الذي","له كان في رقّ المصاحف يجمع",48,"ع",1,0],["يَرتاعُ مِن ذِكراكَ إِن خَطَرَت لَهُ","وَيَراكَ في حُلمِ المَنامِ فَيَفرَقُ",49,"ق",1,0],["يَرْتَقِي مِنْ صُنْعِهِ لِلثُّرَيَّا","بَعْدَمَا كَانَ لَقىً فِي الصَّعِيدِ",50,"د",1,0],["يَرْتَاحُ إِنْ عَنَّ بَحْثٌ","مِنْ ذِي ذَكَاءٍ وَظَرْفِ",51,"ف",1,0],["يرتاحُ للمدح علماً أنه سببٌ","للجود لا كالذي بالمدح يَفتَخرُ",52,"ر",1,0],["يرتقي فوق الأماني","حيثُ يبقى مستنيرا",53,"ر",2,0],["يَرتاح للجودان حف الوجود به","كانه بشمول الراح مَشمول",54,"ل",1,0],["يَرْتاحُ لِلريحِ أَعْطَافاً إذَا نَسَمَتْ","كأَنَّهُ مُسْتَهَامٌ قَلْبُهُ يَجِفُ",55,"ف",1,0],["يَرْتاحُ للرَّوْضِ المَشُوقِ حَمَامُه","ويحِنُّ للبَرقِ الخَفوقِ فُؤادُهُ",56,"د",2,0],["يَرْتاحُ لِلْجَرْيِ فِي إِمْساكِهِ قَلِقاً","حَتّى كَأَنَّ لَهُ فِي راحَةٍ تَعَبا",57,"ب",2,0],["يَرتَعي مِن حَبَبِ الكَأسِ إِذا","عَبَّ فيها أُقحواناً حَسَنا",58,"ن",2,0],["يَرتاحُ إِسماعيلُ لِل","آدابِ أَيَّتَما اِرتِياحَه",59,"ح",2,0],["يَرتع لهواً في نَعيم الصِبا","وَعاشقوه في العذاب الأَليم",60,"م",1,0],["يَرتاحُ من مَرَحِ الصِبا","وَيتيهُ من فَرطِ الغُرورِ",61,"ر",1,0],["يَرتاحُ في حِجرها من صَوتها طَرَباً","كأَنَّه غُصُنٌ في الرَوض مرتاحُ",62,"ح",1,0],["يرتاح ذا ويميد من مر الصبا","ويهز ذا سكرُ الصبا فيميل",63,"ل",1,0],["يَرتاثُ حيث الريثُ يحمد غبُّهُ","وَيسارعُ الأمرَ الّذي هو يسرعُ",64,"ع",1,0],["يَرتَدُّ طَرفُ النَجمِ عَنهُ خاسَئاً","وَيَعزُّ أَن تُعزى إِلَيهِ فُهورُ",65,"ر",1,0],["يَرتَمي الريحَ مِن سَماحيجَ قُبٍّ","بِنُسالٍ تَطيرُ بَعدَ نُسالِ",66,"ل",1,0],["يرتعى الشاء بالقليل من الأج","ر عفيف المنى طهور الثيار",67,"ر",1,0],["يَرتاد بِالسَعد الضَعيف تَقدّماً","وَيَردّه النَحس القَويُّ إِلى وَرا",68,"ر",2,0],["يَرتدُّ خَدُّ السّيفِ مِنه مُورَّداً","عَكْساً وطَرْفُ الشّمسِ منه مُكَحَّلا",69,"ل",2,0],["يَرتادُ سَكرتهُ وسك","رتُه على الساقي يعيدُ",70,"د",1,0],["يرتدي منه نعمةً","يرتجي بعدها اللِقا",71,"ق",2,0],["يرتجي منكم دعاء صالحا","يدفع المكروه يجلب كل سول",72,"ل",1,0],["يرتجي صفحك الجميل","فاعف يا خير من صفح",73,"ح",1,0],["يَرتَجي في ولائِكُم","حُسنَ عَفوٍ وَمَغفِرَه",74,"ر",2,0],["يَرتَدُّ فِكرُكَ بِالفَضائل حاسِراً","عنه وطرفك بِالضِياء كَليلا",75,"ل",2,0],["يرتقي في كلّ يوم رفعةً","في المعالي ليس تُرقى بالسَّلالم",76,"م",1,0],["يرتَقي في الكمال يوماً فيوماً","ويسود الرِّجال عاماً فعاما",77,"ا",1,0],["يُرتجى أو يُختشى في حدِّه","مُؤْنِسُ الوعد وإيحاش الوعيد",78,"د",1,0],["يرتاح للجدوى فيطرب أَنْ يُرى","وَهَّاب غرّ المال قبل سؤاله",79,"ل",2,0],["يُرْتجى جوداً ويُخشى سطوة","رغباً يُرجى ويخشى رهبا",80,"ب",2,0],["يرتجي غيري الثراء وأرجو","منك بعد الثراء عزًّا ومجدا",81,"د",2,0],["يرتقيها درجات في العُلى","فترى الحاسد منها في نزول",82,"ل",1,0],["يرتاح للمعروف إذ هو أهله","فيهش للإِنعام والإِفضال",83,"ل",1,0],["يرتادُ روضاً من رِضاكَ وَلَمْ يَجِدْ","إِلّا هداياهُ إِليها رائدَهْ",84,"د",2,0],["يرتاد كل حديقة غناء قد","حُفّتْ جوانُبها بنهْرٍ سارح",85,"ح",1,0],["يرتفق الأجرَ على دينه","لو كان حرّ الدِّين لم يرفقِ",86,"ق",1,0],["يرتاب منها بالثنا","ء كأنه بالمدحَ يُهجَى",87,"ج",2,0],["يَرْتَعُ في أرْجائها آكِلٌ","ويَجْتَلي بهْجَتَها ناظِرُ",88,"ر",1,0],["يرتاح نحو أخيه حين جاوره","فالشَّمل مجتمعٌ والحبل منَّصل",89,"ل",1,0],["يرتاحُ أن هبَّتْ صَباً أو غرَّدَتْ","ورقاءُ تهدي للقرينِ عجائبا",90,"ب",2,0],["يرتاحُ أن هبَّتْ صَباً أو أَرْزَمَتْ","هوجاءُ أو ناحَ الحمامُ مرجِّعا",91,"ع",2,0],["يرتاعُ مِن لِمَّةِ الظلماءِ مقبلةً","ويلتظي وهي بالاِصباحِ تَنفرِقُ",92,"ق",1,0],["يرتاحُ للآرواحِ أن نسمتْ له","سحراً وتلكَ عُلالةُ المشغوفِ",93,"ف",1,0],["يرتاحُ من وقْعِ السّيوفِ على الطُلا","حتّى كأنّ صليلَهُنّ أغاني",94,"ن",2,0],["يرتاح صدر الدست منه بمالك","لفضائل الأسياف والأقلام",95,"م",1,0],["يَرتاحُ نحوَ غدٍ من غفلةٍ أبداً","مَنْ ليس يدرِي بما تجنِي عليهِ غَدُ",96,"د",1,0],["يرتقي القلب في هواه مقاماً","فمقاماً وراثة الهاشمي",97,"ي",1,0],["يرتجي يعرفه وهو له","خالق عن دركه قد ردعه",98,"ع",2,0],["يَرتاحُ أَن تَبرُدَ ريحُ الشَمألِ","يَرمي بِأَجوازِ المَهارى النُحَّلِ",99,"ل",1,0],["يَرتَدُّ طَرفُ العَينِ عَنهُ مَهابَةً","وَيَجِلُّ لَولا الحِلمُ عَن تَكليمِ",100,"م",1,0],["يرتقِّ فتقَ العلا إِذا فُتِقَتْ","وأَنت لا فائِقٌ ولا رَاتِق",101,"ق",1,0],["يَرتادُ مَنزِلُهُم في كُلِّ قاصِيَةٍ","وَحَجبُهُ لَو دَرى أَحرى بِمُرتادِ",102,"د",1,0],["يَرتَدُّ عَن مَجدِهِ الوَضّ