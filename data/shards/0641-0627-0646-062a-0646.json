an/poem/135433","البسيط"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2569","الطويل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2564","الطويل"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88556","الوافر"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75697","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127277","البسيط"],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22057","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120463","الوافر"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204313","الطويل"],[4119,"وفت لك الدنيا بميعادها","https://www.poetsgate.com/ViewPoem.aspx?id=16127",""],[5183,"إلى رجال الإستقامة","https://www.poetsgate.com/ViewPoem.aspx?id=180170",""],[5213,"ستأتيك القوافي شاردات","https://www.poetsgate.com/ViewPoem.aspx?id=170466",""],[5237,"حسامي ومنهاجي القويم وشرعتي","https://www.poetsgate.com/ViewPoem.aspx?id=113120",""],[5284,"مُرَادُ النَّفْسِ","https://www.poetsgate.com/ViewPoem.aspx?id=190633",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5431,"لبيروت الصلاة...","https://www.poetsgate.com/ViewPoem.aspx?id=215336",""],[5582,"لَقَدْ زِدْتِ نُوراً يا ابْنَةَ الخَمْسِ وَالتِّسْعِ","https://www.poetsgate.com/ViewPoem.aspx?id=187178",""],[5660,"فَلَستُ أَرى فَيضَ الفُراتِ بِناضِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=24646",""],[5804,"نيّة","https://www.poetsgate.com/ViewPoem.aspx?id=195270",""],[5910,"في الدفاع عن السُّنَّة النبوية الشريفة","https://www.poetsgate.com/ViewPoem.aspx?id=206238",""],[6068,"خليليّ ما خافٍ عليّ هواكما","https://www.poetsgate.com/ViewPoem.aspx?id=180640",""],[6093,"أشكو إلى الله منْ هَمٍّ يُساورُني","https://www.poetsgate.com/ViewPoem.aspx?id=176150",""]],"verses":[["فَإِن تَنالوا فَقَد طالَت رِماحُكُمُ","وَإِن تُنالوا فَلِلأَقرانِ أَقرانُ",0,"ن",1,0],["فَإِن تَنأَ عَنها حِقبَةً لا تُلاقِه","فَإِنَّكَ مِمّا أَحدَثَت بِالمُجَرِّبِ",1,"ب",1,0],["فَإِن تَنجُ مِنها تَنجُ مِن ذِي عَظيمَةٍ","وَإِلاّ فَإِنّي لا إِخالُكَ ناجِيا",2,"ي",2,1],["فَإِن تَنأَ دارٌ أَو يَطُل عَهدُ خُلَّةٍ","بِعاقِبَةٍ أَو يُصبِحِ الشَيبُ شامِلا",3,"ل",2,0],["فَإِن تَنجُ مِنها يا جُوَيُّ فَإِنَّها","رُحابٌ كَجَوفِ الغارِ مُظلِمَةِ القَعرِ",4,"ر",1,0],["فَإِن تَنزِلا بِاِبنِ المُحَلَّقِ تَنزِلا","بِذي عِذرَةٍ يَبداكُما بِلُغوبِ",5,"ب",1,0],["فَإِن تَنءِ داراً يا اِبنَ مَروانَ غَربَةٌ","بِحاجَةِ ذي قُربى بِزَندِكَ يَقدَحُ",6,"ح",1,0],["فإن تُنصِفُونَا في القضيّةِ تشهدوا","بأن الذي جِئناهُ أشبَهُ بالحُسْنَى",7,"ن",2,0],["فَإِن تَنفَرِد عَنّا قُشَيرٌ بِمَجدِهِ","فَلَم تَنفَرِد عَنّا بِنائِلِهِ الجَزلِ",8,"ل",1,0],["فَإِن تَناسَيتُ نُعماهُ الَّتي قَدُمَت","فَكُنتُ مِثلَكَ في الدُنيا وَفي الدينِ",9,"ن",1,0],["فَإِن تَنتَفِق تَأخُذ بِرَأسَكَ حَيَّةٌ","وَإِن تَنحَجِر مِنّي تَنَلكَ المَحافِرُ",10,"ر",1,0],["فَإِن تَنسَ ما تُبلي قُرَيشٌ فَإِنَّنا","نُجالِدُ عَن أَحسابِها وَنُقاذِفُ",11,"ف",1,0],["فَإِن تَنهَكُم عَنّي العِظاتُ فَإِنَّني","أَنا الرَجُلُ الرامي فَريصَ المُقاتِلِ",12,"ل",1,0],["فَإِن تُنكِري ما كُنتِ قَد تَعرِفينَهُ","فَما الدَهرُ مِن حالٍ لَنا بِذَميمِ",13,"م",1,0],["فإنْ تَنْأَ ساءكَ هَجَّاؤُنا","وإنْ تَدْنُ سَرَّكَ مَدَّاحُنا",14,"ن",2,0],["فإن تَنْجُ نفسي من كلومِ سلاحِهِ","فَإِنَّ بِرَأسي ما أَثارَتْ سَنابِكُه",15,"ك",2,0],["فَإِن تَنسَ يَذكُر أَو يَقُل فيكَ حاسِدٌ","يَفِل قَولُهُ أَو تَنأَ دارٌ تُصاقِبِ",16,"ب",1,0],["فَإِنْ تَنَصَّلْتَ قَالُوا فِيكَ مَعْرِفَةً","تَنْفِي المِرَاءَ مَعَ الوُدِّ الذِي كَانَا",17,"ن",2,0],["فأنتَ نورُ الدينِ عدلاً ومَنْ","يُسْمى به غيرُكَ كالجائرِ",18,"ر",1,0],["فَإِن تَنزِل فَلا بِسِوى تَميمٍ","وَإِن تَحمِل فَلا بِسِوى قَضيبِ",19,"ب",1,0],["فَإِن تَنَسَّمتَ مِن أَرواحِها نَسَماً","يَوماً تَنَسَّمَ في الخَيشومِ رَيحانُ",20,"ن",1,0],["فَأَنتَ نَسيجُ وَحدِكَ لا شَبيهٌ","نُحاشيهِ عَلَيكَ وَلا خَدينُ",21,"ن",1,0],["فَإِن تَنصَبي يَوماً إِلى لَمَّةِ الهَوى","فَإِنّي بِما أَلقى إِلى تِلكَ أَنصَبُ",22,"ب",1,0],["فَإِن تُنجِكَ الخَيلُ المُعَدَّةُ لِلوَغى","فَعَن قَدَرٍ يَأتي مِنَ اللَهِ نَجَّتِ",23,"ت",1,0],["فَإِن تَنكِحي ماوِيَّةَ الخَيرِ حاتِماً","فَما مِثلُهُ فينا وَلا في الأَعاجِمِ",24,"م",1,1],["فإنْ تُنكريها فما حيلتي","وها هي ذي شعلةٌ في دمي",25,"م",2,0],["فإِنْ تَنْزَعْ فَأَنْتَ طَلِيقُ عَفْوِي","وإِنْ تَطْمَعْ فَسَوْفَ تَرَى عِقَابِي",26,"ب",2,0],["فَإِن تَنأَ عَنها حِقبَةً لا تُلاقِها","فَإِنَّكَ مِمّا أَحدَثَت بِالمُجَرِّبِ",27,"ب",1,0],["فإنْ تنءَ دارٌ يا ابنَ مروانَ غربة","ٌ بحاجة ِ ذي قربى بزندكَ يقدحُ",28,"ح",1,0],["فإن تنزلا، يابن المحلقِ، تنزلا","بذي عذرة ٍ، ينداكُما بلغوبِ",29,"ب",1,0],["فانت نور عيني","وسري الخفي",30,"ي",1,0],["فأنت نعم الرسول الطيب الأسد ال","قدسي من حاز برهاناً وناموسا",31,"س",2,0],["فإن تنحرف فالحسن جمٌّ وجوده","وأهون بما منه لدينا نظائر",32,"ر",1,0],["فإِنْ تنازعتُمُ في الأمر بينكم","ردُّوا إلى اللهِ كلَّ الأمرِ وامتثلُوا",33,"ل",3,0],["فَإِن تَنجُ يَدمى عارِضاكَ فَإِنَّنا","تَرَكنا بَنيكَ لِلضِباعِ وَلِلرَخمِ",34,"م",1,1],["فَأنتَ نَوَاةٌ مِنهُ إِن كَانَ تَمرَةً","وَلَم يَكُ فَضلُ التَّمرِ يَسرِى ِإلَى النَّوَى",35,"و",2,0],["فإن تنتقم تعذر وان تعف عنهم","فعفوك عن اخلاقك الشم ما انفكا",36,"ك",2,0],["فَإِن تَنَلكَ مِنَ الأَقدارِ طالِبَةٌ","لَم يُثنِها العَجزُ عَمّا عَزَّ مَطلوبا",37,"ب",2,0],["فَإِن تَنظمِ التاريخَ يوماً فَقُل بِهِ","أَيا مَن ثَوى دارَ النَعيمِ لَكَ البُشرى",38,"ر",2,0],["فإن تناول زقّا","أخذت دلوا كبيرا",39,"ر",2,0],["فأنتَ نصَرتَ العدلَ ثم نشرتَه","وجُزْت ببَذْل العُرْف حَدَّ التكّرم",40,"م",1,0],["فأنت نِعم الوليُّ المُستعانُ بِه","وخيرُ من وَلَدت حَوَّاءُ مِن رجل",41,"ل",1,0],["فأنت نبيل الأمن في الدهر والمنى","زعيم لنا والغير غير زعيم",42,"م",1,0],["فأنت نجيب بنى المكرمات","وقد شذ في الدهر من أنجبا",43,"ب",2,0],["فأنتَ نَسيبي والقرابةُ بيننا","شعورٌ وفهمٌ فاسترح وترفَّع",44,"ع",1,0],["فَإِنْ تُنْكري مِنِّي احْوِلالاً فَإِنَّني","أَديبٌ أَريبٌ لا عَيِيٌّ وَلا فَدْمٌ",45,"م",1,0],["فَإِنَ تَنْأَ بِيَ الدَّارُ منكم لَمُبْلِغٌ","إِلَيْنَا وَإِنْ كانَ التَّبَصُّرُ أَجْمَلا",46,"ل",2,0],["فَإِن تَنفِني نَحوَ الحَلاءَةِ تَنفِني","إِلى أَنَسٍ طاحي الحُلولِ عَرَمرَمِ",47,"م",1,0],["فإِن تَنُبِ النَّوائِبُ آلَ عُصمٍ","تُرَى حَكَماتُهم فيها رُفُوعُ",48,"ع",1,0],["فَإِن تَنتَهِك حِلمي وَيَبلُغَ حَدَّهُ","سَلَكتُ وَراءَ الحِلمِ أَن أَحَلَّما",49,"م",2,0],["فإن تنج منها يا حَزيم بن طارقٍ","فقد تركت ما خلف ظهري بلقعا",50,"ع",2,0],["فإن تنل منك الرضا جائزة","فهو الثراء للفقير والغنى",51,"ا",1,0],["فإنْ تَنب الجيادُ الجردُ عنهُ","فإنّ الليثَ يحتقِرُ النِمالا",52,"ل",2,0],["فإنْ تُنهِ عَنِّي فأولى مُجابِ","دَعا للمكارِمِ أهدى مُجيبِ",53,"ب",1,0],["فإن تنكري حلمي وبأسي مصاحبي","وضرب الخفاف البيض دون خصامي",54,"م",2,0],["فَإِن تَنجُ مِنها يا حَزيمَ بنَ طارِقٍ","فَقَد تَرَكَت ما خَلفَ ظَهرِكَ بَلقَعا",55,"ع",2,1],["فإنْ تنفَّسْتُ عن طِيبٍ بُعَيْدَ إذٍ","فإنَّما الطِّيبُ من آثارِ طِيبِهِمِ",56,"م",1,0],["فإِنْ تنزعْ نزعتَ لباسَ عزٍّ","وإنْ تلبسْ لبستَ هناكُ هونا",57,"ن",2,0],["فإنْ تَنْأَ فالعيّوقُ ناءٍ وإنْ تَغِبْ","فقد غابَ عنّا بُرهةً كوكبُ السّعدِ",58,"د",1,0],["فأنت نور وفي إخفائه علن","وأنت سر عليه كشفه ستر",59,"ر",1,0],["فأن تنصف فأرضك مستقرّي","وإن تظلم فمنزلي السحاب",60,"ب",1,0],["فأنتن في ضبن ابن زيد ومن يكن","به مستجيرا لم ترعه الروائع",61,"ع",1,0],["فإِن تنمْ نم بعين الذئب في سفرٍ","وقم بقلب كقلبٍ الضيغم الضارى",62,"ر",2,0],["فإن تنكحوها عامراً لاطلاعكم","إليه يدهدهكم برجليه عامر",63,"ر",1,1],["فأَنتَ نَهار نير الكون في العلا","وَبالليل نبراس يضيء بنبراس",64,"س",1,0],["فإن تناسىَ الندى قوم لبخلهم","فإنه عند عضد الدين مذكورُ",65,"ر",1,0],["فإن تنظر الى عملي","فياذلي ويا خجلي",66,"ل",2,0],["فإنْ تنصرونا تنصروا أهلَ حُرْمةٍ","وفي خُذْلنا يا قومِ جَبُّ الحواركِ",67,"ك",1,0],["فَإِن تُنصِفوا يا آلَ مَروانَ نَقتَرِب","إِلَيكُم وَإِلا فَأذَنوا بِبعادِ",68,"د",1,1],["فإِنْ تُنَفِّذْ إِلى أَخيكَ بِهِ","تُنْقِذُهُ بالنَّعيمِ مِنْ بوسِهْ",69,"ه",1,0],["فإن تنجز الأيام وعداً بقربها","فإني موفى الحظ منها موفق",70,"ق",1,0],["فَإِن تَنسَني سُبحان من ليس ناسيا","وَمن أمرهِ الإنسانُ لا يَتَحَرَّرُ",71,"ر",1,0],["فَأَنتَ نُور العَين","يا بَهجَة النَظار",72,"ر",1,0],["فأنت نور سواد العين إن نظرت","بي أنت من شاهد طوراً ومشهود",73,"د",1,0],["فإن تَنْتَصِف منهمْ فأَعْذَرُ آخذٍ","وإن تتداركْهُمْ فأَكرمُ صاحب",74,"ب",1,0],["فإن تنادى عليٌّ حسبما نزعت","به المعالي فعند اللَه نودعه",75,"ع",2,0],["فإن تنصفوا أبناء مصر فيمنة","لكم أبداً نثني عليها بما نثني",76,"ن",2,0],["فإنْ تُنْكِرَنْ مروانُ حسنَ بلائنا","نَكونَنْ أخاها حين تُخْشى وتُذعَرُ",77,"ر",1,0],["فإن تنتهوا يغفر لكم ما مضى وإن","تعودوا فما غير البنود رسائل",78,"ل",1,0],["فإِنْ تنصريني نجدةً وحميّةً","ففي مِثْلِ حالي للصنيعة مَوْضِعُ",79,"ع",1,0],["فإن تنثن الدنيا علينا بحالها","فإن لها حالا وفيها التشاجر",80,"ر",1,0],["فإن تنأ ستور الإذنِ عنّا","فما نأتِ المحبّةٌ والثناءُ",81,"ا",2,0],["فَاِن تُنسِني الآجالُ نَفسي حِمامَها","فَاِنَّ وَرائي أَن يُفَنِّدَني أَهلي",82,"ل",2,0],["فإن تنسي الأيام كنية صاحب","كريم فلم أنس الإخاء ولا الودا",83,"د",2,1],["فَإِن تُنجِزِ الأَيّامُ مَمطولَ وَعدِهِ","فَقَد بانَ ضوء الصُّبحِ قَبلَ طُلوعِهِ",84,"ع",2,0],["فان تنوقت له فلا يضر","فخيره ما طاب منه وكثر",85,"ر",1,0],["فَإن تُنكِرُوا عنَّي مقالي لغيبتي","فنظميَ يَستغني بهِ كلُّ معدَمِ",86,"م",1,0],["فَإِن تَنطِقِ الهَجراءَ أَو تَشرَفي الخَنا","فَإِنَّ البَغاثَ الأَطحَلَ اللَونِ يَنطِقُ",87,"ق",1,0],["فإن تنصروني فالرجية فيكم","وإن تعجزوا قابلت أرضاً تعزني",88,"ن",2,0],["فإن تنكر الأشرار في العدل سيرتي","وقد عاقها أمرُ الدناة المخامد",89,"د",1,0],["فان تنسَ يوماً قطرة البحر ذاتها","وما اكتسبته من صفات تعدْ بحرا",90,"ر",2,0],["فأنت نفحةُ خلدٍ","تأتي بكلّ نعيم",91,"م",1,0],["فَإِن تَنتَقِص مِنّا الحُروبُ نُقاصَةً","فَأَيَّ طِعانٍ في الحُروبِ نُطاعِنُ",92,"ن",1,0],["فإن تنجز تكن معنىً عليا","وإلا خالف الاسم المسمى",93,"م",2,0],["فإن تنبيه قلبك","تتمة التهذيب",94,"ب",1,0],["فان تنظم لَها تأريخَ حَينٍ","فقل انَّ الالهَ اختار مَريَم",95,"م",1,0],["فإن تَنُبْني بالنوى نَوائبٌ","فإنّ منها تركَ تيمورَ الحِمى",96,"ا",1,0],["فإنْ تَنزِفوا ماءَ الجفونِ فإنّما","لكَمْ كنتُ أستَسقي الدموعَ وأذْخَرُ",97,"ر",1,0],["فإن تنأ عني بالوصال فإنني","سأرضى بلحظ العين ان لم يكن وصل",98,"ل",1,1],["فإن تنج قلت الحمد لله مخلصاً","فمن أعظم النعمى بقاء المصادق",99,"ق",1,0],["فأنت نعم المرّجى","لكل قوم جياعِ",100,"ع",1,0],["فإِن تُنكِري صَوتَ الحَديدِ وَمِشيَةً","فإِني بِما يأَتي بِهِ اللَهُ عارِفُ",101,"ف",1,0],[