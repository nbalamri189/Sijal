كَلباً أَهلُهُ مِن كَدِّهِ","قَد سَعِدَت جُدودُهُم بِجَدِّهِ",116,"د",2,1],["أَنعَتُ ديكاً مِن دُيوكِ الهِندِ","كَريمَ عَمِّ وَكَريمَ جَدِّ",117,"د",1,1],["أَنعَتُ ديكاً مِن دُيوكِ الهِندِ","أَحسَنَ مِن طاوُوسِ قَصرِ المَهدي",118,"د",2,1],["أَنعَتُ كَلباً لَقِنَ النُحاسِ","مَحسورَ أَقطارِ شُؤونِ الراسِ",119,"س",1,1],["أَنعَتُ كَلباً مُرهَفاً خَميصا","ذا شِيَةٍ ما عَدِمَت وَبيصا",120,"ص",2,1],["أَنعَتُ كَلباً جالَ في رِباطِهِ","جَولَ مُصابٍ فَرَّ مِن أَسعاطِهِ",121,"ط",2,1],["إنّ عنانَ النَطافِ","قد صار حِرها للأيرِ ميدانا",122,"ن",2,1],["أنعظَ حتى قلتُ جازَ لفرقدا","أو يبتغي عند ابن نعشٍ موعدا",123,"د",2,0],["أنعظَ حتى جازع رأسي صاعدا","باعاً وجازَ فوق باع ساعدا",124,"د",2,0],["إِن عَصَيتُ الفُؤادَ حينَ عَصاني","في هَواهُ إِلى التَعَزّي سَديدا",125,"د",2,0],["إِنَّ عَمراً فَاِعرِفوهُ","عَرَبِيٌّ مِن زُجاجِ",126,"ج",1,1],["إِن عَذُبَ المَينُ بِأَفواهِكُم","فَإِنَّ صِدقي بِفَمي أَعذَبُ",127,"ب",1,1],["إِن عَذَّبَ اللَهُ قَوماً بِاِجتِرامِهِمُ","فَما يُريدُ لِأَهلِ العَدلِ تَعذيبا",128,"ب",2,0],["إِنَّ عَصاكَ وَهِيَ المُعوَجَّه","تُحدِثُ في رَأسِ أَخيكَ الشَجَّه",129,"ج",2,0],["إِن عُرِضَت مِلَّتُكُم بَينَهُم","قالَ جَميعُ القَومِ لا حَبَّذا",130,"ذ",2,0],["إِن عُوِّضوا بِذُنوبٍ أُسلِفَت سَقَراً","فَلَم تَرُمهُم عَلى عِلّاتِها سَقَرُ",131,"ر",1,0],["أَنَعشٌ في السَماءِ وَذاكَ أَمرٌ","يَدُلُّ عَلى هَلاكِ بَناتِ نَعشِ",132,"ش",1,1],["إِنَّ عَجوزاً حُبِسَت بُرهَةً","ثُمَّ غَدا مِن حُكمِها القَتلُ",133,"ل",1,1],["أَنعُمانُ ما سَرَّ اِبنَ حَنتَمَةَ الَّذي","سُرِرتَ بِهِ مِن شُربِ ما في الحَناتِمِ",134,"م",1,0],["إن عشت عاش وإن ضع","تُ حل فيه الضياع",135,"ع",1,0],["إِن عاشَ إنسان تعش أَوطاره","أَو ماتَ يَوماً ماتَت الأوطار",136,"ر",1,0],["إنْ عاند الأمواجَ فهو الذي","يحفرُ في اليم حَفِيرَ التَّبابْ",137,"ب",1,0],["إن عيني بها أحقُّ من المو","تِ وقلبي بها من القبرِ أولى",138,"ل",2,0],["أَنْعَتُ عَيْراً وهو كلّهُ","حافرُهُ ورأسُه وظِلُّهُ",139,"ل",2,1],["أنْعَظَ حتّى انْحَلَّ عنه جُلُّهُ","كأنَّ حُمّى خَيْبَرٍ تُعِلُّهُ",139,"ل",2,0],["إن عصرا مولاي فيه المرجى","أنا فيه القريض والشعراء",140,"ا",2,0],["أنعاكِ أم أسقيكِ من بيداءَ","كانت دواء أبداً وداءَ",141,"ا",2,0],["أَنعم صَبَاحاً عَلقَمَ بنَ عَديّ","أَثَوَيتَ الَيومَ أَم تَرحَل",142,"ل",1,0],["إِنَّ عَصْرَ الشَّبَابِ فِينَا مُعَارٌ","وَاللَّيَالِي تَرُدُّ كُلَّ مُعَارِ",143,"ر",1,0],["إِنَّ عَيْنِي تَرَى أَبَاكِ وَقَدْ شَا","رَفَنَا اليَوْمَ مِنْ أَعَالِي الرَّقِيمِ",144,"م",1,0],["إِنْ عَدَانِي فِي النَّقْلِ مَا رَاعَ فِي الأَصْ","لِ فَإِنَّ المَفَرِّطَ الرَّسَّامُ",145,"م",1,0],["إِنْ عَقَدَتْهُ اسْتَقَامَ تَاجاً","أَوْ أَرْسَلَتْهُ اسْتَطَالَ ذَيْلاَ",146,"ل",2,0],["إِنْ عَلا مِنْبَراً لِقوْلٍ فَمَا فِي","الحَشْد إِلاِّ التَّهْلِيلُ وَالتَّكْبِيرُ",147,"ر",1,0],["إِنْ عُزَّ قَصْرُكَ فِي الْقُصُورِ","أَلسْتَ أَنْتَ فَسِيح وَحْدِك",148,"ك",1,0],["أَنُعَزِّي فِيهِ أَهْلاً أَوْ حِمًى","وَالْمُعَزَّى فِيهِ جُمَّاعُ العَرَبْ",149,"ب",1,0],["إِنْ عَالَنُوا لِتِجَارَةٍ فَلَطَالَمَا","بَذَلُوا النَّوَالَ الْجَمَّ رَهْنَ خَفَاءِ",150,"ا",2,0],["إِنْعَزَى أَخَاهُ عَنْهُ وَمَا","نَمْلِكُ حَبْسَ الدُّمُوعِ فِي الآمَاقِ",151,"ق",1,0],["إِنْ عُطِّلَ السَّعُي الأَصِيلُ هُنَيْهَةً","أَغْنَاكَ مِنْ لُطْفِ الْقَدِيرِ معارُ",152,"ر",1,0],["إِنَّ عَبْدَ الحَمِيد حِينَ تَوَلَّى","هَدَّ رُكْناً مَا كَانَ بِالمَهْدُودِ",153,"د",1,0],["إن عشقنا فعذرنا","أن في وجهنا نظر",154,"ر",1,0],["إنْ عادَ سَهْمي بِكَ ذا قِذاذِ","بِتُّ أُناصِي النّجْمَ أو أحاذي",155,"ذ",2,0],["إِنَّ عَدِيّاً إِذا مَلَّكتَ جانِبَها","مِن أَمرِ غَوثٍ عَلى مَرأىً وَمُستَمَعِ",156,"ع",1,0],["إن عرَتني مُلمَّةٌ كان رُكْني","أودهتْني عضيهة كان حِصني",157,"ي",1,0],["إن عامَ إنسانُ عَيني في مدامِعِهِ","فقد أُمِدّ بإحْسان وإنعام",158,"م",1,0],["إن عيد الجلوس أشرق في الكَوْ","نِ شروقَ الربيع في روضاتهْ",159,"ت",2,0],["إِنْ عَقَّهَا أَهْلُ وَادِيها وَجيرَتُها","فَأَنْتَ أَحْنَى عَلَيْهَا مِنْ أَخٍ وَأَبِ",160,"ب",1,0],["إنْ عُدَّ أَبْطَالُ الرجا","لِ فَأَنْتَ أَوَّلهُمْ وآخِرْ",161,"ر",1,0],["إنّ عهدَ الفاروق عهدُ سُعودٍ","باسمُ الثغْرِ ناضرُ الأفنان",162,"ن",1,0],["إنّ عُنوانَها جهابذُ مصرٍ","وجلالُ الكتابِ في عنوانهْ",163,"ن",2,0],["إِنّ عِيدَ المعَارِفِ اليومَ عِيدٌ","للنُّهَى والْجُهُودِ والذِّكْرَياتِ",164,"ت",1,0],["إنْ عددنا ليومِه حسناتٍ","شغلتْنا مساوىءُ الشيْبِ عَدّا",165,"د",2,0],["إِنَّ عَرْشاً أَسَاسُهُ مُهَجُ الشَّعْبِ","خَليقٌ بِأنْ يَكُونَ وَطِيدا",166,"د",2,0],["إن عيسى أحيا موَات الدنيا","وابن عيسى أحيا موَات الحقوق",167,"ق",1,0],["أنعم بشعب أَنت عنوان له!","وكفى بعنوان الكتاب دليلا!",168,"ل",2,0],["إن عرض الحر مرعًى مُخْصبٌ","يجد الوالغ فيه مرتعه",169,"ع",2,0],["أنعيش عالاتٍ على","زمنٍ بعيدٍ العَهْدِ غابر؟",170,"ر",1,0],["أنعم بها ثورةً باتتْ تسير على","مِشْكَاتها أممٌ شتى، وبلدان!",171,"ن",1,0],["إن عيينا عنه، وعيَّ بنونا","فهْو دين في جيد كلِّ حفيد",172,"د",1,0],["إن عاش في ذبابٌ، عاش مغتربًا","فما يطيرُ بها إلا على وَجَلِ",173,"ل",1,0],["إن عز مثواك الممنع طاهرا","فصدورها وقلوبها مثواكا",174,"ك",2,0],["انعم بملك دائم لا ينقضي","واخلد قواما للعلا وملاكا",174,"ك",2,0],["أنعشتِهِ ونَفَيْتِ عنه هواجساً","ضايقْنَه ، وأثرتِ من تخييله",175,"ل",2,0],["إن عُمْراً مستلطَفاً باعه المرء","بغير الكؤوس قد بيعَ بَخْسا",176,"س",2,0],["ان علوتم فحقكم اولستم","قد رَفَعتم لكعبةِ الله أسُّا",176,"س",2,0],["أنعم بليلتك التي قضَيتها","والبدرُ من بين السُّتور شروقه",177,"ق",2,0],["إن عَلَتْ هَضَبَاتُ الفُرْسِ من شَرَفٍ،","رَاحَتْ شيوخُكَ قُعساً في التّبابِينِ",178,"ن",1,0],["أنعيش في المنى مثلما","يحيي الجديب الواكف الهاطل",179,"ل",1,0],["أَنْعَى إليك نفوساً طاح شاهدُها","فيما وراء الحيثِ يَلْقَى شاهد القِدَم",180,"م",1,1],["أنْعي إليك قلوباً طالما هَطَلَتْ","سحائبُ الوحي فيها أبْحُر الحكم",180,"م",1,0],["أنعي إليك لسان الحق مُذ زمن","أودى وتذكاره في الوهم كالعدم",180,"م",1,0],["أنعي إليك بيانا تستكين له","أقوال كل فصيح ٍمِقْوَل فهم",180,"م",1,0],["أنعي إليك أشارات العقول معاً","لم يبق منهنّ إلا دارس الرمم",180,"م",1,0],["أنعي وحُبِّك أخلاقاً لِطائفةٍ","كانت مطاياهم من مكمد الكظم",180,"م",1,0],["أنّ عندي محْو ذاتي","من أجّل المكرمات",181,"ت",1,0],["إنَّ عبدَ القوي عبدٌ قويٌّ","في استِهِ أخذ الكتابَ بقُوَّهْ",182,"و",2,1],["إن عليًّا لميمونٌ نقيبهُ","بالصَّالحاتِ مِن الأفعالِ مشهورُ",183,"ر",1,0],["ا نعمُ، ما لاقيتُ بعدكمُ","لمجالسِ اللذاتِ من طعمِ",184,"م",1,0],["أَنعِم صَباحاً عَلقَمَ بنِ عَدِيٍّ","إِذا نَوَيتَ اليَومَ لَم تَرحَلِ",185,"ل",1,1],["ان عدت الوحش ما كانت ولا بقرا","او عدت الطير ما كانت ولا رخما",186,"م",2,0]]}