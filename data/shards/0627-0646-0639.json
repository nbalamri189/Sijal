.aspx?id=31848",""],[91,"هملت","https://www.poetsgate.com/ViewPoem.aspx?id=53205",""],[64,"ناي (في وصف فقد حاله)","https://www.poetsgate.com/ViewPoem.aspx?id=3099",""],[64,"أقتلوني ياتقاتي","https://www.poetsgate.com/ViewPoem.aspx?id=3131",""],[51,"إنَّ عبدَ القوي عبدٌ قويٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=30724",""],[24,"هل حبلُ رملة َ قبلَ البينِ مبتورُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10895&r=&rc=36",""],[31,"أوقفتَ من طللٍ على رسمِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19081&r=&rc=344",""],[20,"أنعم صباحاً علقم بن عدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70003&r=&rc=25",""],[88,"قد يطفح اللؤم حتى ان صاحبه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19581&r=&rc=84",""]],"verses":[["إِنَّ عَلى أَعوادِهِ الضِرغاما","تُخدِجُ مِن هَيبَتِهِ السُلامى",0,"م",2,0],["أَنعاكَ لِلخَيلِ المُغيرَةِ شُزَّباً","خَبَطَ المَغارَ بِهِنَّ مَن لَم يُجرِمِ",1,"م",1,0],["إِن عادَ يَوماً عادَ وَج","هُ الدَهرِ مُقتَبِلاً جَميلا",2,"ل",2,0],["أَنعِمي يا سَرحَةَ الحَ","يِ وَإِن كُنتِ سَحيقَه",3,"ق",2,0],["إِنَّ عيداً مِنَ الغَواني إِذا رُم","تُ التَسَلّي أَشجى لِقَلبي وَأَنضى",4,"ض",2,0],["إِن عايَنَ النَقعَينِ أَنكَرَ قَلبَهُ","وَنَجا بِناصِيَةِ الطِمِرَّ الأَجرَدِ",5,"د",1,0],["إِن عايَنوا نِعمَةً ما توا بِها كَمَداً","وَإِن رَأوا غُمَّةً طاروا بِها فَرَحا",6,"ح",2,0],["أَنعاكَ لِلخَيلِ المُغيرَةِ شُزَّباً","وَاليَومَ يَضرِبُ بِالعَجاجِ خِباءَ",7,"ا",2,0],["إِن عُشتُ فَهيَ الَّتي ما عُشتُ مالِكَتي","وَإِن أَمُت فَاللَيالي شَأنُها العِبَرُ",8,"ر",1,0],["إِن عَدَدتُم هَوايَ ذَنباً فَإِنّي","أُشهِدُ اللَهَ أَنَّ ذَنبي عَظيمُ",9,"م",1,0],["إِنْ عَزَّ مَثْوَاكَ الْمُمَنَّع ظَاهِراً","فَصُدُورُهَا وَقُلُوبُهَا مَثْوَاكَا",10,"ك",2,0],["أنْعامُ أرْضِكَ تقْهَرُ الآسادا","طَبْعٌ كَسا الأرْواحَ والأجْسادا",11,"د",2,1],["إنْ عاقَ عنْكَ قَبيحُ ما كَسَبَتْ يَدي","يوْماً فوجْهُ العَفْوِ غيرُ قَبيحِ",12,"ح",1,0],["إِنَّ عِداتِكَ إِيّانا لَآتِيَةٌ","حَقّاً وَطَيِّبَةٌ ما نَفسُ مَوعودِ",13,"د",1,0],["إِنَّ عِرسي قَد آذَنَتني أَخيراً","لَم تُعَرِّج وَلَم تُؤامِر أَميرا",14,"ر",2,1],["إِنَّ عَلِيّاً لَمَيمونٌ نَقيبَتُهُ","بِالصالِحاتِ مِنَ الأَفعالِ مَشهورُ",15,"ر",1,0],["إِن عِشتَ أَو مِتَّ إِنّي","كَما نَوَيتَ نَوَيتُ",16,"ت",1,0],["أَنَّ عَبدَ الحَميدِ قَد هَدَمَ الشَر","عَ وَأَربى عَلى فِعالِ الوَليدِ",17,"د",1,0],["إِنَّ عِشرينَ حِجَّةً بَعدَ خَمسٍ","عَلَّمَتنا السُكونَ مَهما تَمادى",18,"د",2,0],["إِنَّ عَضّيكَ يا أَخي بِالمَلامِ","لا يُؤَدّي لِمِثلِ هَذا الخِصامِ",19,"م",1,1],["أَنَعيشُ تَحتَ اللَيلِ أَم","تَحتَ الشُموسِ الساطِعَه",20,"ع",2,0],["إِن عيلَ صَبري مِن فِراقِكَ","فَالعَذابُ بِهِ أَليم",21,"م",1,0],["إن عز من منحوا نصراً فأحر به","أو هان من منعوه النصر فليهن",22,"ن",1,0],["إِنْ عَاقَكُمْ عَائِقٌ فَمِصْر","تَمْضِي إِلَى قَصْدِهَا أَمامَا",23,"م",2,0],["إِنْ عَاهَدُوهُ بإِنْصَافٍ فَذَلِكَ وَإِنْ","أَبَوْا فَمَا أَمْرُهُ مِنْ أَمْرِهِمْ أَمَمُ",24,"م",1,0],["إِنْعامُهُ السَّامِي علَيْكَ","بِذَلِكَ اللَّقَبِ الجِليلِ",25,"ل",1,0],["إِن عابَني لَم يَعِب إِلّا مُؤَدِّبَهُ","وَنَفسَهُ عابَ لِما عابَ أُدّابَه",26,"ب",2,0],["أَنَعتانُ أَم نَدّانُ أَم يَنبَري لَنا","فَتىً مِثلُ نَصلِ السَيفِ شيمَتُهُ الحَمدُ",27,"د",1,0],["إنّ عدوا لس تجهل","سلّموا اللّه وفضّل",28,"ل",1,0],["أن عرا الحيّ ردّه","فاقد الحسّ كالحجر",29,"ر",1,0],["إن عقل الفتى ليصبح بالعل","م رزيناً بكفّ من قد رازه",30,"ز",2,0],["إن عبد الوهاب عاش جليل ال","قدر فرداً ومات وهو جليل",31,"ل",1,0],["أَنعى أَخاكَ وَفارِساً ذا نَجدَةٍ","حَمساً إِذا اِمتَلَأَ الفَجاجُ غُبارا",32,"ر",2,0],["اِنعَ الكَريمَ لِلكَريمِ أَربَدا","اِنعَ الرَئيسَ وَاللَطيفَ كَبِدا",33,"د",2,1],["أَنعَمتُ يَوماً مَرَّ لي بِالشامِ","أَلَذَّ ما مَرَّ مِنَ الأَيّامِ",34,"م",1,0],["إن عاب رونق ألفاظي ذوو إحَنٍ","ففي السماءِ بدور طالما نُبحت",35,"ت",1,0],["إنَّ عليا جواد سبق علىً","قبل زهير وقبل جسَّاس",36,"س",1,0],["إن علت غاية وإن جنَّ دهر","فهو في الحالتين أحسن راقي",37,"ق",2,0],["إن عشتُ فيكم بغير قوتٍ","فلستُ مستنكراً لذلك",38,"ك",1,1],["إنَّ عبد الوهاب قاضي قضاة الدي","ين أوفى الورَى ندى أو نديَّا",39,"ي",2,0],["إن عيداً حَيَّا الخليفة بالنرْ","جِس والعرْسِ والعروس لَعيدُ",40,"د",1,0],["أنعم الله على أخلاقه","وغذاه بنعيم العيش غاذي",41,"ذ",2,0],["إن عض خلخالهُ مُخلْخَلَهُ","أو شفّ عقدُ الإزار مؤتَزره",42,"ر",2,0],["إن عيناً تغيب عن","ها وعنه لفَائزه",43,"ز",2,0],["أنعمْ صباحاً نعمةً موصولةً","بعُرى نعيمٍ ليس بالمقطوعِ",44,"ع",1,0],["إنَّ عَهْدي إذا تنكَّر عهدٌ","لجديدٌ وإنّ حُبِّي لنامي",45,"م",2,0],["إن عبْدَ القَوِيِّ ذاكَ المُكَنَّى","بسُوَيْدٍ أراه يمتارُ سَمِّي",46,"م",2,1],["إن عُذراً من الذهاب إلى اللَّ","ه لعُذْرٌ يغْلو على المُستام",47,"م",1,0],["إنَّ عُقْبَى الهوى هُوِيٌّ وعُقْبَى","طُولِ تلك التهاوناتِ هوان",48,"ن",1,0],["إن عداه الربيعُ واستأثر النيْ","روزُ من دونه بذاك الأوان",49,"ن",1,0],["إن عيداً يكون حَلْياً عليه","يكُ عن كل ما سواك لَغان",49,"ن",1,0],["إنَّ عبدَ القوي عبدٌ قويٌّ","في استِهِ يأخذ الكتابَ بقُوَّهْ",50,"و",2,1],["أَنعَشَ في نَفسي المُنى مِثلَما","يُحيِ الجَديبَ الواكِفُ الهاطِلُ",51,"ل",1,0],["إِن عَنَّفوني فَإِنّي لا أُعَنِّفُها","وَإِن أُسَمِّ فَإِنّي لا أُسَمّيها",52,"ي",3,0],["إِن عَشِقَت نَفسي فَوَيلٌ لَها","وَالوَيلُ لي إِن رَجُلٌ حَبَّني",53,"ي",1,0],["أَنعِم عَلَيَّ بِقُبلَةٍ","هِبَةً وَإِلّا عارِيَه",54,"ي",2,0],["إِنَّ عَيني تَتَمَنّى لَو رَأَت","وَجهَكَ المُشرِقَ ذاكَ الحَسَنا",55,"ن",2,0],["إِن عادَ لي ذاكَ الرِضا","فَلَكَ البِشارَةُ يارَسولُ",56,"ل",1,0],["إِن عَنَّفوا أَو خَوَّفوا أَو سَوَّفوا","لا أَنثَني لا أَنتَهي لا أَفرَقُ",57,"ق",1,0],["أَنعَمَ الدَهرُ بِهِ في","خُلسَةٍ ثُمَّ اِستَرَدَّه",58,"د",2,0],["إِنَّ عَلى أَهوى لَأَلأَمَ حاضِرٍ","حَسَباً وَأَقبَحَ مَجلِسٍ أَلوانا",59,"ن",2,1],["أَنعَمتَ بالبيض الكَعا","ب عَليّ وَالخَيل العِرابْ",60,"ب",1,0],["ان عبس الليل فليس","الذنب للكواكب",61,"ب",1,0],["انعم بدنيا كلها","حتى تعيش وسائل",62,"ل",1,0],["إِن عُدتُ لِلأَرضِ بِإِذنِ اللَهِ","وَعادَ لي فيها قَديمُ الجاهِ",63,"ه",1,0],["إِن عُدَّ فيمَن أَعرِفُ","أَسمو بِهِ وَأَشرُفُ",64,"ف",1,0],["إِنَّ عِزّاً لَم يُظَلَّل في غَدٍ","بِجَناحَيكَ ذَليلٌ مُستَباح",65,"ح",1,0],["إِن عَبَسَ العَيشُ لي","عُذتُ بِها فَاِبتَسَم",66,"م",1,0],["إِنَّ عَصراً قُمتَ تَجلوهُ لَنا","لَبِسَ ال