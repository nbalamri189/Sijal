//www.poetsgate.com/ViewPoem.aspx?id=189508",""],[5638,"طريق الأحرار","https://www.poetsgate.com/ViewPoem.aspx?id=200123",""],[5644,"يطيب يومي","https://www.poetsgate.com/ViewPoem.aspx?id=198641",""],[5691,"جارة القمر","https://www.poetsgate.com/ViewPoem.aspx?id=205881",""],[5691,"ربيع عشتار","https://www.poetsgate.com/ViewPoem.aspx?id=206247",""],[5704,"إلى لليلى...","https://www.poetsgate.com/ViewPoem.aspx?id=198785",""],[5725,"عربسان","https://www.poetsgate.com/ViewPoem.aspx?id=207284",""],[5736,"ثورة الأشعار","https://www.poetsgate.com/ViewPoem.aspx?id=208399",""],[4623,"إني بحبل الحب فيك مقيد ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146853",""],[5842,"تساؤلات حائرة","https://www.poetsgate.com/ViewPoem.aspx?id=73686",""],[5848,"طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=48954",""],[5853,"فلسفة دموع العيون","https://www.poetsgate.com/ViewPoem.aspx?id=175669",""],[5879,"مواويل الحلال","https://www.poetsgate.com/ViewPoem.aspx?id=215439",""],[5881,"لحن هي العين","https://www.poetsgate.com/ViewPoem.aspx?id=183763",""],[5916,"لا أُرِيْدُ الْمُلْتَقَى ..","https://www.poetsgate.com/ViewPoem.aspx?id=190586",""],[5943,"أمير الشِّعر قد تاقتْ قلوبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=34483",""],[5952,"كفكف الدمعات","https://www.poetsgate.com/ViewPoem.aspx?id=203111",""],[6004,"عروسُ الشَّرق","https://www.poetsgate.com/ViewPoem.aspx?id=71985",""],[6056,"عيب ٍ عليك ...","https://www.poetsgate.com/ViewPoem.aspx?id=130525",""],[6068,"أَمِنَ اللُّبَانَاتِ الَّتِي أَتَحَمَّلُ -10-","https://www.poetsgate.com/ViewPoem.aspx?id=175808",""],[6068,"هل تارك روحي لنصح العاذل","https://www.poetsgate.com/ViewPoem.aspx?id=181693",""],[6093,"صُبَّ العَقِيْقَ مِنَ اللجَيْنِ بِكأسِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=204382",""],[6115,"من لاحفظ برهم يهبا وتبت يداه","https://www.poetsgate.com/ViewPoem.aspx?id=196465",""],[6124,"طوابير البغاء","https://www.poetsgate.com/ViewPoem.aspx?id=193261",""],[6148,"في رحاب الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=201654",""],[6189,"السيف والوردة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83560&r=&rc=27",""],[6229,"بين يدي الزمان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65210&r=&rc=33",""],[6302,"الكأسُ بِشْرِي .. والعُداةُ سُقَاتي ..!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86215&r=&rc=13",""],[6317,"هذي الرّبوع بوجهها الخلّاب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86084&r=&rc=0",""],[6356,"آخرُ شموعِ الخريفْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81908&r=&rc=9",""]],"verses":[["في طالِعِ النّحْسِ حُزْتَ رُتْبَتَها","وكلُّ شيءٍ في قبْضَةِ القَدَرِ",0,"ر",1,0],["في طَيِّ شِدَّته أسرارٌ مَرحَمَةٍ","للعالَمينَ ولكن ليس يُفْشيها",1,"ي",3,0],["في طِرازٍ كَأَنَّما نَسَّقَتهُ","مِن مَجاني الرُبا بَنانُ الرَبيعِ",2,"ع",1,0],["فِي طَبْعِهِ الحِلْمُ عَلَيْهِمْ وَمَنْ","يَرْفَعْهُ عَنْهُمْ قَدْرُهُ يَحْلُمِ",3,"م",1,0],["في طَحمَةٍ مِن تَميمٍ لَو يُصَكُّ بِها","رُكنَا ثَبيرٍ لَأَمسى مائِلَ السَنَدِ",4,"د",1,0],["في طول عمركَ يرجو الله آملُها","بنصر ملكك يدعو اللهَ داعيها",5,"ي",3,0],["في طرفها نظر وانٍ تُرَده","لَمْحَ المريض إذا ما جاد بالروح",6,"ح",1,0],["في طَلَقٍ مِيحَ للأَوسِ والخَزرَجِ","ما لا تَضَمَّنُ القُلُبُ",7,"ب",1,0],["فَيَطرُدُ كَعباً حَيثُ لاماءَ يُرتَجى","لِتَعلَمَ كَعبٌ أَيُّ قَرمٍ تُصابِرُ",8,"ر",1,0],["فيَّ طبعٌ ملائكيٌّ لديهِ","عازفٌ صادفٌ عن الإطرابِ",9,"ب",1,0],["فيطعنه في سَبَّة السوء طعنةً","يقوم لها من تحته يتفحَّجُ",10,"ج",1,0],["فيطعنُ في دُبرهِ","أَفانينَ من طَعْنه",11,"ن",2,0],["في طَرفِكَ الساجي هُيامٌ بِها","وَبَينَ أَحشاءَكَ شَوقٌ مُذيب",12,"ب",1,0],["في طَرفِهِ كَمَنَ الهَلاكُ فَلَو رَنا","طَرفُ الزَمانِ إِلَيهِ عادَ كَليلا",13,"ل",2,0],["في طَيِّ لامَتِهِ هِزبَرٌ باسِلٌ","تَحتَ العَريكَةِ مِنهُ بَدرٌ مُشرِقُ",14,"ق",1,0],["فَيُطرِبُني ذاكَ الحَديثُ وَطيبُهُ","وَيَفعَلُ بي ما لَيسَ في قُدرَةِ الخَمرِ",15,"ر",1,0],["في طَريقي لِعَلِيٍّ","عَنهُ لَو يَعقِلُ غُنوَه",16,"و",2,0],["في طَخيَةٍ مِن سَوادِ الحَربِ مُظلِمَةٍ","تَهمي سَماواتُها ضَرباً عَلى الهامِ",17,"م",1,0],["في طيب \"جنات العريف\" ومائه","في الفل، في الريحان، في الكباد",18,"د",1,0],["في طَبعِكُم مَلَلٌ مُنافٍ لِلوَفا","وَمِنَ المُحالِ تَجَمُّعُ الأَضدادِ",19,"د",1,1],["في طَرفِها عُمقٌ إِذا حَقَّقتَهُ","لَم يَبدُ مِنها الإِسمُ إِن لَم يُعكَسِ",20,"س",1,0],["في طَرْفِهِ مَرَضٌ ملاحتَهُ التي","ألْقَتْ عليّ أنينَهُ بكروبهِ",21,"ب",2,0],["فيطلعُ في ألفِه","وينزلُ في واحدِهْ",22,"ه",1,0],["في طِيبِ رَيّا وَرِيقٍ حِينَ تَطرُقُها","وَقَد دَنا مِن نُجُومِ اللَيلِ تَغويرُ",23,"ر",1,0],["في طاقَةِ النَفسِ أَن تُعنى بِمَنزِلِها","حَتّى يُجافَ عَلَيها لِلثَرى بابُ",24,"ب",1,0],["في طَبعِها حُبُّها الدُنيا وَقَد عَلِمَت","أَنَّ المَنِيَّةَ فينا حادِثٌ قُدُما",25,"م",2,0],["في طريق الشَّوكِ والصخر وفي","شُعَب الإرهاق والكَدِّ الوبيل",26,"ل",1,0],["في طريقٍ ضرَبَ الزَّهرُ حواليه نطاقا","وتجلَّى البدرُ فيه وصفا الجوُّ وراقا",27,"ق",2,0],["في طبعه الطيرة والشرور","وربّه يوماً به مغرور",28,"ر",1,0],["في طوله يفنى المكان وعرضه","ما في سماء الكون أو في أرضه",29,"ه",1,0],["فِي طُرُوسٍ رَاعَتْ بِكُلِّ طَرِيفٍ","مِنْ أَفَانِينِهِ وَكُلِّ مُفِيدِ",30,"د",1,0],["فَيُطَهِّرُ الوِجْدَانَ مِنْ أَدْرَانِهِ","وَيَزِينُهُ بِسَواطِعِ الأًضوَاءِ",31,"ا",2,0],["في طيب جنات العريف ومائها","في الفل في الريحان في الكباد",32,"د",1,0],["في طوعِ كفكَ بَعْثُ عاطفتي","وخَلاصُها من رِبقةِ الضّجر",33,"ر",1,0],["فيطعنه في سَبَّة السوء طعنة ً","يقوم لها من تحته وهو أفحجُ",34,"ج",1,0],["في طينة الحمى ، أعيب دقائقا","عنّي وأصحو ، يرتمي أمثالي",35,"ل",2,0],["في طرفك السّاجي هيام بها","وبين أحشائك شوق مذيب",36,"ب",1,0],["في طَي بيضا ظَلَت مِن وَلَهٍ","فيكَ بِأَيدي اللحاظ أَصقلها",37,"ل",3,0],["فَيَطرُدُهَا طردَ المُدَثَّرِ أجرَباً","تَيَمَّمَ مَثوَى بَركِهِ فَتَجَشَّمَا",38,"م",2,0],["في طالع السعد قد شِيدت دعائمه","لذاك قد راق في الأبصارِ تشييدُ",39,"د",1,0],["في طيّ مبسمها ثلاث محاسنٍ","درر وصهباءُ ونشر ملابِ",40,"ب",1,0],["فيطربهم برقٌ تألّق بالحمى","ويرقصهم رعد بسلعٍ له أزر",41,"ر",1,0],["في طُولِهِ وَعَرضِهِ بِفِتْر","حَلَّ بِهِ ما حَلَّ بي من ضُرِّ",42,"ر",1,0],["فِي طُرُوسٍ مَا بين سَطْرٍ مِنَ الرَّوْ","ضِ وَسَطْرٍ يُقْرا بِلا إِعْرابِ",43,"ب",1,0],["في طالعٍ لَما بَدا تاريخُهُ","بِالخَيرِ طابَ بِهَ قِرانُ خَليلِ",44,"ل",1,0],["في طاعَةِ اللَهِ مَمساهُ وَمصبحُهُ","وَمِنهُ لِلخَيرِ إِعلانٌ وَإِسرارُ",45,"ر",1,0],["في طبعِه عَصَبيةٌ مع نَخْوة","أبداً يفضلها على لذاته",46,"ت",2,0],["في طرفه سحرٌ يُشحِّطُنا به","فلذاك حُمرة خدِّه من قَطرِهِ",47,"ر",2,0],["في طريقي إليك يا بحر أشدو","بقصيد معطر الأنغام",48,"م",1,1],["في طريقي حين أغدو أو أروح","أوجهٌ لمّاحة الحسن وضاء",49,"ا",2,0],["في طروس العراس خلت انتهاكا","كل حرف يلوح منهن نونا",50,"ن",2,0],["في طَلَبِ المعاشِ","وهو ربيطُ الجاشِ",51,"ش",1,0],["في طَلب الصَداقَه","عند أُولي الحَماقَه",51,"ه",1,0],["في طَميَةِ الناسِ لَم يَشعُر بِنا أَحَدٌ","لَمّا اِغتَنَمنا جِبالَ اللَيلِ وَالصَخَبا",52,"ب",2,0],["في طريق يحفّه الزهرُ النض","ر وفي جوفه تفُحُّ الأفاعي",53,"ي",1,1],["في طوايا النسيان والعم والذل","وبين الحديث والإطراق",54,"ق",1,0],["في طُولِ عُمْرٍ لكمْ مُدَّتْ أواخِرُه","وظلِّ مُلْكٍ بكمْ شُدَّتْ أواخيه",55,"ي",2,0],["في طَيلساني لا تكُنْ طامعاً","طَيُّ لساني عنكَ يَكْفيكا",56,"ك",2,0],["في طَبْعِ نَوشَروانَ شَر","ولو مِنَ اسْمِهِ قَدَر",57,"ر",1,0],["في طَرْفِ اللّيلِ تَكَحُّلُه","ولخَدِّ الفَجْرِ تَوُّرده",58,"د",2,0],["في طَرزِها ممَّا بِه","أمَرَ الأميرُ أبو الفَوارِس",59,"س",1,0],["في طَرفِهِ سحر عَن العَقل","المُجَرد يَخدَع",60,"ع",1,0],["فَيَطفي بَردَها أَحشا","يَ أَو أَقضي مِن السكر",61,"ر",1,0],["في طريقتهم العليا ولو صد ما صد","خامل الذكر طول الدهر يشكر ويحمد",62,"د",1,0],["في طَرفِها يَقضي غرار من كَرىً","وَلِكُلِّ ماضي الشَفرَتَين غرارُ",63,"ر",1,0],["في طفوليَّتي وحالِ اكتهالي","لم تغيِّرْه حادثاتُ الليالي",64,"ي",1,0],["في طالع السعد وإقباله","فيه البشارات وفيه الحبور",65,"ر",1,0],["فيطربك النشيد وكلَّ حرٍّ","كريم الطبع يطربه النشيد",66,"د",1,0],["في طَرْفِها الأَحْوَى تَأَنُّقُ بابلٍ","نَفَّاثُ سِحْرٍ في الحشا نَفَّاذُ",67,"ذ",1,0],["في طيّ يُمناهُ مَرادُ الغِنى","فاستَهْدِ من ذاك المَرادِ المُرادْ",68,"د",1,0],["فيطرِبها إلى أن يعتريها","من الإطرابِ تصفيقٌ ورقصُ",69,"ص",1,0],["في طول عمرك عمّن قد مضى خلفُ","ولليالي إذا ملّيتها الشرفُ",70,"ف",1,1],["فيطهر الأرض التي دنست به","وبحزبه وبنهبه وبسلبه",71,"ب",2,0],["فيطرقُ أسماعا تصَمُّ عن الخنا","وتُصغِي إلى داعي الندى فتصمِّمُ",72,"م",1,0],["في طالِع من نعمةٍ","أفولُه لا يزِفُ",73,"ف",1,0],["في طرفها تغزُّلٌ وقلبها","حماسة تنسبها للحُمسِ",74,"س",1,0],["فيُطمِعُ فيه ثغرُهُ حين يُجتَدَى","ويؤيِسُ منه الأنفُ حين يَغارُ",75,"ر",1,0],["في طاعةِ الله أسْبابٌ مُجَنِّبَةٌ","تَظلُّ منها لُيوثُ الغابِ في وهَلِ",76,"ل",1,0],["في طاعةِ البُرَحاء قولةُ مكمَدٍ","قلبٌ أُصيبتْ بالنَّوى أَعشاره",77,"ر",2,0],["في طولِ أَيّامِ المَصي","فِ وَبَردِ أَيّامِ الشِتاءِ",78,"ا",2,0],["في طول أربعة من الامتار في","متر ونصف عرضه يا صاح",79,"ح",1,0],["في طيها سر حلال للنهى","مثل الجفون بلحظها الخفاض",80,"ض",1,0],["في طرْفِ هِنديّه من ضَربه رَمَدٌ","وفي عَواليهِ من خَمْرِ الطُّلا ثمَلُ",81,"ل",1,0],["فيطلع العقل على ما يشا","من المعاني عن ضيا أو ظلام",82,"م",1,0],["في طلعة شمسية قمرية","بجمالها صار الجميع جذاذا",83,"ذ",2,0],["فيطعمنا ويسقي","ويفعل ما يريد",84,"د",1,0],["في طالعٍ قالَ تأريخُ السُّعودِ بِهِ","في منزلِ البدرِ حَلَتْ نجمةُ السَّحَرِ",85,"ر",1,0],["في طيِّ هذا اللَّحْدِ شَهمٌ مِن بني","فَرَجٍ لهُ اللهُ الكريمُ قد اصطَفَى",86,"ف",2,1],["فيطيِبُ للجَذلانِ صَوتُ غنائِهِ","ويَطيبُ للثَكْلانِ صَوْتُ نُواحهِ",87,"ح",2,0],["في طِيبِ مَجلِسِهِ عِلمٌ لمُقتبِسٍ","وفي رَسائِلِهِ جاهٌ لمُفتَخِرِ",88,"ر",1,0],["في طَرْفِهِ الرَّاحُ وأَجفانُه ال","كَاسَاتُ والأَهْدَابُ مِنْها السُّقاه",89,"ا",2,0],["فَيُطْرِبُ حِينَ يَضْرِبُ في خُطُوبٍ","ويُعْرِبُ حِينَ يُغْرِبُ في خِطَابِ",90,"ب",1,0],["في طاعة المولى سهرت ليالياً","هجع الجميع بها وأنت هجود",91,"د",1,0],["في طَبَرِيّا مَواقِفٌ حَمَدَت","وَأَرضُها مُقَدَّسٌ وَمُغتَفَرُ",92,"ر",1,0],["فَيُطرِبُني هَمسُ القَصائِرِ في الحِمى","وَيُعجِبُني في الرَملِ هَدى المُطافِلِ",93,"ل",1,0],["في طبعه الجمع فرق لا اتحاد له","في وهمه الفرد مقسوم ومعدود",94,"د",1,0],["في طائرٍ جاء مشويّاً به بَشَرٌ","يوماً وكان رسولُ الله مُحْتَجِبا",95,"ب",2,0],["في طيّهِ بُشرَى السرور فمرحباً","ببشارة كنا لها بتشوُّفِ",96,"ف",1,0],["في طوقهِ الزُهر