{"poems":[[77,"كن من صروف الردى على حذر","https://www.aldiwan.net/poem36441.html","المنسرح"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[86,"قد قرأنا ظلالكم فاشتفينا","https://www.aldiwan.net/poem68876.html","الخفيف"],[93,"في أي جو بالأسى مفعم","https://www.aldiwan.net/poem11348.html","السريع"],[30,"يا دار مية بالخلصاء فالجرد","https://www.aldiwan.net/poem29598.html","البسيط"],[83,"يا من يحن إلى نجد وناديها","https://www.aldiwan.net/poem54234.html","البسيط"],[88,"مرت تقول ألا يا رب خذ روحي","https://www.aldiwan.net/poem44460.html","البسيط"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[51,"إذا ابن خيار بدا","https://www.aldiwan.net/poem66505.html","مجزوء المتقارب"],[91,"يا صاح كم تفاحة غضة","https://www.aldiwan.net/poem8764.html","عموديه"],[91,"يا ليتما خلق الزمان أصيلا","https://www.aldiwan.net/poem62669.html","عموديه"],[70,"وعد الزيارة طرفه المتملق","https://www.aldiwan.net/poem42802.html","الكامل"],[70,"بك اهتز عطف الدين في حلل النصر","https://www.aldiwan.net/poem42921.html","الطويل"],[85,"هذه أول خطوه","https://www.aldiwan.net/poem8064.html","مجزوء الرمل"],[45,"نصيب عينيك من سح وتسجام","https://www.aldiwan.net/poem66640.html","البسيط"],[99,"غرناطة","https://www.aldiwan.net/poem6258.html","عموديه"],[66,"في طبعكم ملل مناف للوفا","https://www.aldiwan.net/poem38764.html","الكامل"],[66,"أهلا بشهب في سماء المجلس","https://www.aldiwan.net/poem41342.html","الكامل"],[80,"صب يذوب إلى لقاء مذيبه","https://www.aldiwan.net/poem31568.html","الكامل"],[69,"مريد القضا بالقرى","https://www.aldiwan.net/poem28726.html","مجزوء المتقارب"],[40,"أعاذلي أما للوم تغيير","https://www.aldiwan.net/poem42303.html","البسيط"],[46,"قد أسرف الإنس في الدعوى بجهلهم","https://www.aldiwan.net/poem22087.html","البسيط"],[46,"أما حياتي فما لي عندها فرج","https://www.aldiwan.net/poem23350.html","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125573","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39544","الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202536","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/206203","الكامل"],[90,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[51,"أمامك فانظر أيَّ نهجيك تَنْهُج","https://www.poetsgate.com/ViewPoem.aspx?id=27417",""],[100,"ليلة فارس الغبار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67737&r=&rc=224",""],[91,"يا صاح !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67607&r=&rc=49",""],[110,"خذها سطورا إليك قد بعثت","https://www.aldiwan.net/poem16335.html","المنسرح"],[133,"ألم يأن أن تجفو الصبا وتحلما","https://www.aldiwan.net/poem54748.html","الطويل"],[136,"هذا مكان به الإقبال معهود","https://www.aldiwan.net/poem48908.html","البسيط"],[136,"ما بال أصدق وعدها كسراب","https://www.aldiwan.net/poem49142.html","الكامل"],[148,"أمسعود جاء السعد والخير واليسر","https://www.aldiwan.net/poem47624.html","الطويل"],[156,"وشادن مكتحل بسحر","https://www.aldiwan.net/poem55695.html","الرجز"],[156,"زمن مثل زورة الأحباب","https://www.aldiwan.net/poem55798.html","الخفيف"],[183,"لله يوم بالمسرة قد صفا","https://www.aldiwan.net/poem61158.html","الكامل"],[183,"أحبابنا هل لذاك العهد تذكار","https://www.aldiwan.net/poem67065.html","البسيط"],[186,"هجر العذول وراح طوع غواته","https://www.aldiwan.net/poem14131.html","الكامل"],[205,"حسن تكامل في المحاسن فاغتدى","https://www.aldiwan.net/poem53272.html","الكامل"],[212,"في طريقي إليك يا بحر أشدو","https://www.aldiwan.net/poem46227.html","الخفيف"],[212,"مرت الأيام والروح الحزين","https://www.aldiwan.net/poem46613.html","الرمل"],[262,"يا أخا العين في المحاسن عينا","https://www.aldiwan.net/poem38162.html","الخفيف"],[298,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[301,"ثكلى عوان بدوار مؤلفة","https://www.aldiwan.net/poem45499.html","البسيط"],[329,"في طريق يحفه الزهر النضر","https://www.aldiwan.net/poem54972.html","الخفيف"],[329,"بين همس الشفاه والأحداق","https://www.aldiwan.net/poem55035.html","الخفيف"],[365,"بعد الصباح الذي ودعتكم فيه","https://www.aldiwan.net/poem60602.html","البسيط"],[365,"حسبك مني يا فتى خلعة","https://www.aldiwan.net/poem60812.html","السريع"],[365,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"],[365,"هل أنت بطولك مسعده","https://www.aldiwan.net/poem60943.html","المتدارك"],[372,"خلع الثناء معي ولست","https://www.aldiwan.net/poem57361.html","مجزوء الكامل"],[381,"قلب يحبك مولع","https://www.aldiwan.net/poem48747.html","مجزوء الكامل"],[381,"أمير لج في هجري","https://www.aldiwan.net/poem48791.html","مجزوء الوافر"],[392,"احمدالله يا احمد إذا شئت","https://www.aldiwan.net/poem54584.html","عموديه"],[407,"الليل حيث حللن فيه نهار","https://www.aldiwan.net/poem50176.html","الكامل"],[417,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[417,"زرتم فحييتم كما ينبغي","https://www.aldiwan.net/poem53853.html","السريع"],[417,"متى يشفى بك الصب العميد","https://www.aldiwan.net/poem54140.html","الوافر"],[433,"هل للقلوب من العيون ملاذ","https://www.aldiwan.net/poem12348.html","الكامل"],[433,"تعود الطرد بها والطراد","https://www.aldiwan.net/poem12591.html","السريع"],[435,"لدينا بركة كالبدر حسناً","https://www.aldiwan.net/poem24790.html","الوافر"],[438,"في طول عمرك عمن قد مضى خلف","https://www.aldiwan.net/poem2602.html","البسيط"],[454,"نعم الرصاص جزاء خادم شعبه","https://www.aldiwan.net/poem61243.html","الكامل"],[459,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[459,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[459,"كالشمس من جمرة عبد شمس","https://www.aldiwan.net/poem56156.html","الرجز"],[459,"تغرب فبالدار الحبية دار","https://www.aldiwan.net/poem56195.html","الطويل"],[462,"أجل ما رمت في آت مقتبل","https://www.aldiwan.net/poem15134.html","البسيط"],[465,"هذا العقيق وهذه أقماره","https://www.aldiwan.net/poem3177.html","عموديه"],[469,"للنشو ألحان لها","https://www.aldiwan.net/poem60500.html","مجزوء الكامل"],[480,"قالوا هي الخضراء أرض فلاحة","https://www.aldiwan.net/poem37186.html","الكامل"],[483,"أحديقة رقّمت بوشي أزاهر","https://www.aldiwan.net/poem24435.html","عموديه"],[515,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[559,"عجبت من شيئين قد أجمعت","https://www.aldiwan.net/poem34079.html","السريع"],[559,"غلب الهوى واستحوذ استحواذا","https://www.aldiwan.net/poem34561.html","الكامل"],[559,"أنا الخلق الجديد","https://www.aldiwan.net/poem34582.html","مجزوء الوافر"],[563,"لا بد في الناس للأسماء من أثر","https://www.aldiwan.net/poem52599.html","البسيط"],[563,"في طي هذا اللحد شهم من بني","https://www.aldiwan.net/poem52653.html","الكامل"],[563,"قف بالعقيق وسل نسيم رياحه","https://www.aldiwan.net/poem52903.html","الكامل"],[563,"أهدت لنا نفحات الروض في السحر","https://www.aldiwan.net/poem52919.html","البسيط"],[576,"جاد وما ضن عليه ضناه","https://www.aldiwan.net/poem2996.html","السريع"],[587,"عذابي من ثناياك العذاب","https://www.aldiwan.net/poem17442.html","الوافر"]],"verses":[["في طالِعِ النّحْسِ حُزْتَ رُتْبَتَها","وكلُّ شيءٍ في قبْضَةِ القَدَرِ",0,"ر",1,0],["في طَيِّ شِدَّته أسرارٌ مَرحَمَةٍ","للعالَمينَ ولكن ليس يُفْشيها",1,"ي",3,0],["في طِرازٍ كَأَنَّما نَسَّقَتهُ","مِن مَجاني الرُبا بَنانُ الرَبيعِ",2,"ع",1,0],["فِي طَبْعِهِ الحِلْمُ عَلَيْهِمْ وَمَنْ","يَرْفَعْهُ عَنْهُمْ قَدْرُهُ يَحْلُمِ",3,"م",1,0],["في طَحمَةٍ مِن تَميمٍ لَو يُصَكُّ بِها","رُكنَا ثَبيرٍ لَأَمسى مائِلَ السَنَدِ",4,"د",1,0],["في طول عمركَ يرجو الله آملُها","بنصر ملكك يدعو اللهَ داعيها",5,"ي",3,0],["في طرفها نظر وانٍ تُرَده","لَمْحَ المريض إذا ما جاد بالروح",6,"ح",1,0],["في طَلَقٍ مِيحَ للأَوسِ والخَزرَجِ","ما لا تَضَمَّنُ القُلُبُ",7,"ب",1,0],["فَيَطرُدُ كَعباً حَيثُ لاماءَ يُرتَجى","لِتَعلَمَ كَعبٌ أَيُّ قَرمٍ تُصابِرُ",8,"ر",1,0],["فيَّ طبعٌ ملائكيٌّ لديهِ","عازفٌ صادفٌ عن الإطرابِ",9,"ب",1,0],["فيطعنه في سَبَّة السوء طعنةً","يقوم لها من تحته يتفحَّجُ",10,"ج",1,0],["فيطعنُ في دُبرهِ","أَفانينَ من طَعْنه",11,"ن",2,0],["في طَرفِكَ الساجي هُيامٌ بِها","وَبَينَ أَحشاءَكَ شَوقٌ مُذيب",12,"ب",1,0],["في طَرفِهِ كَمَنَ الهَلاكُ فَلَو رَنا","طَرفُ الزَمانِ إِلَيهِ عادَ كَليلا",13,"ل",2,0],["في طَيِّ لامَتِهِ هِزبَرٌ باسِلٌ","تَحتَ العَريكَةِ مِنهُ بَدرٌ مُشرِقُ",14,"ق",1,0],["فَيُطرِبُني ذاكَ الحَديثُ وَطيبُهُ","وَيَفعَلُ بي ما لَيسَ في قُدرَةِ الخَمرِ",15,"ر",1,0],["في طَريقي لِعَلِيٍّ","عَنهُ لَو يَعقِلُ غُنوَه",16,"و",2,0],["في طَخيَةٍ مِن سَوادِ الحَربِ مُظلِمَةٍ","تَهمي سَماواتُها ضَرباً عَلى الهامِ",17,"م",1,0],["في طيب \"جنات العريف\" ومائه","في الفل، في الريحان، في الكباد",18,"د",1,0],["في طَبعِكُم مَلَلٌ مُنافٍ لِلوَفا","وَمِنَ المُحالِ تَجَمُّعُ الأَضدادِ",19,"د",1,1],["في طَرفِها عُمقٌ إِذا حَقَّقتَهُ","لَم يَبدُ مِنها الإِسمُ إِن لَم يُعكَسِ",20,"س",1,0],["في طَرْفِهِ مَرَضٌ ملاحتَهُ التي","ألْقَتْ عليّ أنينَهُ بكروبهِ",21,"ب",2,0],["فيطلعُ في ألفِه","وينزلُ في واحدِهْ",22,"ه",1,0],["في طِيبِ رَيّا وَرِيقٍ حِينَ تَطرُقُها","وَقَد دَنا مِن نُجُومِ اللَيلِ تَغويرُ",23,"ر",1,0],["في طاقَةِ النَفسِ أَن تُعنى بِمَنزِلِها","حَتّى يُجافَ عَلَيها لِلثَرى بابُ",24,"ب",1,0],["في طَبعِها حُبُّها الدُنيا وَقَد عَلِمَت","أَنَّ المَنِيَّةَ فينا حادِثٌ قُدُما",25,"م",2,0],["في طريق الشَّوكِ والصخر وفي","شُعَب الإرهاق والكَدِّ الوبيل",26,"ل",1,0],["في طريقٍ ضرَبَ الزَّهرُ حواليه نطاقا","وتجلَّى البدرُ فيه وصفا الجوُّ وراقا",27,"ق",2,0],["في طبعه الطيرة والشرور","وربّه يوماً به مغرور",28,"ر",1,0],["في طوله يفنى المكان وعرضه","ما في سماء الكون أو في أرضه",29,"ه",1,0],["فِي طُرُوسٍ رَاعَتْ بِكُلِّ طَرِيفٍ","مِنْ أَفَانِينِهِ وَكُلِّ مُفِيدِ",30,"د",1,0],["فَيُطَهِّرُ الوِجْدَانَ مِنْ أَدْرَانِهِ","وَيَزِينُهُ بِسَواطِعِ الأًضوَاءِ",31,"ا",2,0],["في طيب جنات العريف ومائها","في الفل في الريحان في الكباد",32,"د",1,0],["في طوعِ كفكَ بَعْثُ عاطفتي","وخَلاصُها من رِبقةِ الضّجر",33,"ر",1,0],["فيطعنه في سَبَّة السوء طعنة ً","يقوم لها من تحته وهو أفحجُ",34,"ج",1,0],["في طينة الحمى ، أعيب دقائقا","عنّي وأصحو ، يرتمي أمثالي",35,"ل",2,0],["في طرفك السّاجي هيام بها","وبين أحشائك شوق مذيب",36,"ب",1,0],["في طَي بيضا ظَلَت مِن وَلَهٍ","فيكَ بِأَيدي اللحاظ أَصقلها",37,"ل",3,0],["فَيَطرُدُهَا طردَ المُدَثَّرِ أجرَباً","تَيَمَّمَ مَثوَى بَركِهِ فَتَجَشَّمَا",38,"م",2,0],["في طالع السعد قد شِيدت دعائمه","لذاك قد راق في الأبصارِ تشييدُ",39,"د",1,0],["في طيّ مبسمها ثلاث محاسنٍ","درر وصهباءُ ونشر ملابِ",40,"ب",1,0],["فيطربهم برقٌ تألّق بالحمى","ويرقصهم رعد بسلعٍ له أزر",41,"ر",1,0],["في طُولِهِ وَعَرضِهِ بِفِتْر","حَلَّ بِهِ ما حَلَّ بي من ضُرِّ",42,"ر",1,0],["فِي طُرُوسٍ مَا بين سَطْرٍ مِنَ الرَّوْ","ضِ وَسَطْرٍ يُقْرا بِلا إِعْرابِ",43,"ب",1,0],["في طالعٍ لَما بَدا تاريخُهُ","بِالخَيرِ طابَ بِهَ قِرانُ خَليلِ",44,"ل",1,0],["في طاعَةِ اللَهِ مَمساهُ وَمصبحُهُ","وَمِنهُ لِلخَيرِ إِعلانٌ وَإِسرارُ",45,"ر",1,0],["في طبعِه عَصَبيةٌ مع نَخْوة","أبداً يفضلها على لذاته",46,"ت",2,0],["في طرفه سحرٌ يُشحِّطُنا به","فلذاك حُمرة خدِّه من قَطرِهِ",47,"ر",2,0],["في طريقي إليك يا بحر أشدو","بقصيد معطر الأنغام",48,"م",1,1],["في طريقي حين أغدو أو أروح","أوجهٌ لمّاحة الحسن وضاء",49,"ا",2,0],["في طروس العراس خلت انتهاكا","كل حرف يلوح منهن نونا",50,"ن",2,0],["في طَلَبِ المعاشِ","وهو ربيطُ الجاشِ",51,"ش",1,0],["في طَلب الصَداقَه","عند أُولي الحَماقَه",51,"ه",1,0],["في طَميَةِ الناسِ لَم يَشعُر بِنا أَحَدٌ","لَمّا اِغتَنَمنا جِبالَ اللَيلِ وَالصَخَبا",52,"ب",2,0],["في طريق يحفّه الزهرُ النض","ر وفي جوفه تفُحُّ الأفاعي",53,"ي",1,1],["في طوايا النسيان والعم والذل","وبين الحديث والإطراق",54,"ق",1,0],["في طُولِ عُمْرٍ لكمْ مُدَّتْ أواخِرُه","وظلِّ مُلْكٍ بكمْ شُدَّتْ أواخيه",55,"ي",2,0],["في طَيلساني لا تكُنْ طامعاً","طَيُّ لساني عنكَ يَكْفيكا",56,"ك",2,0],["في طَبْعِ نَوشَروانَ شَر","ولو مِنَ اسْمِهِ قَدَر",57,"ر",1,0],["في طَرْفِ اللّيلِ تَكَحُّلُه","ولخَدِّ الفَجْرِ تَوُّر