{"poems":[[77,"كن من صروف الردى على حذر","https://www.aldiwan.net/poem36441.html","المنسرح"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[86,"قد قرأنا ظلالكم فاشتفينا","https://www.aldiwan.net/poem68876.html","الخفيف"],[93,"في أي جو بالأسى مفعم","https://www.aldiwan.net/poem11348.html","السريع"],[30,"يا دار مية بالخلصاء فالجرد","https://www.aldiwan.net/poem29598.html","البسيط"],[83,"يا من يحن إلى نجد وناديها","https://www.aldiwan.net/poem54234.html","البسيط"],[88,"مرت تقول ألا يا رب خذ روحي","https://www.aldiwan.net/poem44460.html","البسيط"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[51,"إذا ابن خيار بدا","https://www.aldiwan.net/poem66505.html","مجزوء المتقارب"],[91,"يا صاح كم تفاحة غضة","https://www.aldiwan.net/poem8764.html","عموديه"],[91,"يا ليتما خلق الزمان أصيلا","https://www.aldiwan.net/poem62669.html","عموديه"],[70,"وعد الزيارة طرفه المتملق","https://www.aldiwan.net/poem42802.html","الكامل"],[70,"بك اهتز عطف الدين في حلل النصر","https://www.aldiwan.net/poem42921.html","الطويل"],[85,"هذه أول خطوه","https://www.aldiwan.net/poem8064.html","مجزوء الرمل"],[45,"نصيب عينيك من سح وتسجام","https://www.aldiwan.net/poem66640.html","البسيط"],[99,"غرناطة","https://www.aldiwan.net/poem6258.html","عموديه"],[66,"في طبعكم ملل مناف للوفا","https://www.aldiwan.net/poem38764.html","الكامل"],[66,"أهلا بشهب في سماء المجلس","https://www.aldiwan.net/poem41342.html","الكامل"],[80,"صب يذوب إلى لقاء مذيبه","https://www.aldiwan.net/poem31568.html","الكامل"],[69,"مريد القضا بالقرى","https://www.aldiwan.net/poem28726.html","مجزوء المتقارب"],[40,"أعاذلي أما للوم تغيير","https://www.aldiwan.net/poem42303.html","البسيط"],[46,"قد أسرف الإنس في الدعوى بجهلهم","https://www.aldiwan.net/poem22087.html","البسيط"],[46,"أما حياتي فما لي عندها فرج","https://www.aldiwan.net/poem23350.html","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125573","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39544","الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202536","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/206203","الكامل"],[90,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[51,"أمامك فانظر أيَّ نهجيك تَنْهُج","https://www.poetsgate.com/ViewPoem.aspx?id=27417",""]],"verses":[["في طالِعِ النّحْسِ حُزْتَ رُتْبَتَها","وكلُّ شيءٍ في قبْضَةِ القَدَرِ",0,"ر",1,0],["في طَيِّ شِدَّته أسرارٌ مَرحَمَةٍ","للعالَمينَ ولكن ليس يُفْشيها",1,"ي",3,0],["في طِرازٍ كَأَنَّما نَسَّقَتهُ","مِن مَجاني الرُبا بَنانُ الرَبيعِ",2,"ع",1,0],["فِي طَبْعِهِ الحِلْمُ عَلَيْهِمْ وَمَنْ","يَرْفَعْهُ عَنْهُمْ قَدْرُهُ يَحْلُمِ",3,"م",1,0],["في طَحمَةٍ مِن تَميمٍ لَو يُصَكُّ بِها","رُكنَا ثَبيرٍ لَأَمسى مائِلَ السَنَدِ",4,"د",1,0],["في طول عمركَ يرجو الله آملُها","بنصر ملكك يدعو اللهَ داعيها",5,"ي",3,0],["في طرفها نظر وانٍ تُرَده","لَمْحَ المريض إذا ما جاد بالروح",6,"ح",1,0],["في طَلَقٍ مِيحَ للأَوسِ والخَزرَجِ","ما لا تَضَمَّنُ القُلُبُ",7,"ب",1,0],["فَيَطرُدُ كَعباً حَيثُ لاماءَ يُرتَجى","لِتَعلَمَ كَعبٌ أَيُّ قَرمٍ تُصابِرُ",8,"ر",1,0],["فيَّ طبعٌ ملائكيٌّ لديهِ","عازفٌ صادفٌ عن الإطرابِ",9,"ب",1,0],["فيطعنه في سَبَّة السوء طعنةً","يقوم لها من تحته يتفحَّجُ",10,"ج",1,0],["فيطعنُ في دُبرهِ","أَفانينَ من طَعْنه",11,"ن",2,0],["في طَرفِكَ الساجي هُيامٌ بِها","وَبَينَ أَحشاءَكَ شَوقٌ مُذيب",12,"ب",1,0],["في طَرفِهِ كَمَنَ الهَلاكُ فَلَو رَنا","طَرفُ الزَمانِ إِلَيهِ عادَ كَليلا",13,"ل",2,0],["في طَيِّ لامَتِهِ هِزبَرٌ باسِلٌ","تَحتَ العَريكَةِ مِنهُ بَدرٌ مُشرِقُ",14,"ق",1,0],["فَيُطرِبُني ذاكَ الحَديثُ وَطيبُهُ","وَيَفعَلُ بي ما لَيسَ في قُدرَةِ الخَمرِ",15,"ر",1,0],["في طَريقي لِعَلِيٍّ","عَنهُ لَو يَعقِلُ غُنوَه",16,"و",2,0],["في طَخيَةٍ مِن سَوادِ الحَربِ مُظلِمَةٍ","تَهمي سَماواتُها ضَرباً عَلى الهامِ",17,"م",1,0],["في طيب \"جنات العريف\" ومائه","في الفل، في الريحان، في الكباد",18,"د",1,0],["في طَبعِكُم مَلَلٌ مُنافٍ لِلوَفا","وَمِنَ المُحالِ تَجَمُّعُ الأَضدادِ",19,"د",1,1],["في طَرفِها عُمقٌ إِذا حَقَّقتَهُ","لَم يَبدُ مِنها الإِسمُ إِن لَم يُعكَسِ",20,"س",1,0],["في طَرْفِهِ مَرَضٌ ملاحتَهُ التي","ألْقَتْ عليّ أنينَهُ بكروبهِ",21,"ب",2,0],["فيطلعُ في ألفِه","وينزلُ في واحدِهْ",22,"ه",1,0],["في طِيبِ رَيّا وَرِيقٍ حِينَ تَطرُقُها","وَقَد دَنا مِن نُجُومِ اللَيلِ تَغويرُ",23,"ر",1,0],["في طاقَةِ النَفسِ أَن تُعنى بِمَنزِلِها","حَتّى يُجافَ عَلَيها لِلثَرى بابُ",24,"ب",1,0],["في طَبعِها حُبُّها الدُنيا وَقَد عَلِمَت","أَنَّ المَنِيَّةَ فينا حادِثٌ قُدُما",25,"م",2,0],["في طريق الشَّوكِ والصخر وفي","شُعَب الإرهاق والكَدِّ الوبيل",26,"ل",1,0],["في طريقٍ ضرَبَ الزَّهرُ حواليه نطاقا","وتجلَّى البدرُ فيه وصفا الجوُّ وراقا",27,"ق",2,0],["في طبعه الطيرة والشرور","وربّه يوماً به مغرور",28,"ر",1,0],["في طوله يفنى المكان وعرضه","ما في سماء الكون أو في أرضه",29,"ه",1,0],["فِي طُرُوسٍ رَاعَتْ بِكُلِّ طَرِيفٍ","مِنْ أَفَانِينِهِ وَكُلِّ مُفِيدِ",30,"د",1,0],["فَيُطَهِّرُ الوِجْدَانَ مِنْ أَدْرَانِهِ","وَيَزِينُهُ بِسَواطِعِ الأًضوَاءِ",31,"ا",2,0],["في طيب جنات العريف ومائها","في الفل في الريحان في الكباد",32,"د",1,0],["في طوعِ كفكَ بَعْثُ عاطفتي","وخَلاصُها من رِبقةِ الضّجر",33,"ر",1,0],["فيطعنه في سَبَّة السوء طعنة ً","يقوم لها من تحته وهو أفحجُ",34,"ج",1,0]]}