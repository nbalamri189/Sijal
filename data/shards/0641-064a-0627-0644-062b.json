مُحَمَّدُ عِلمٌ","لِعَليمٍ وَإِن تَناهى اِطِّلاعُه",2,"ع",2,0],["فَيا لِثَأرٍ بَينَنا بَعدَهُ","أَقامَ لَم يَقرُب وَلَم يَبعُدِ",3,"د",1,0],["في الثغر تحت الصخر حش","رجةٌ يردِّدها فضاؤه",4,"ا",3,0],["في الثرى ، في الروضِ ، في أفق السما،","في شأبيبِ الحيا ، في الحَجَر",5,"ر",1,0],["في الثرى من أحبّتي ولداتي","ظفر أبلج وفتح جليل",6,"ل",1,0],["في الثّغْرِ بارقةٌ يَشْتاقها نظَري","شوقَ العِطاشِ لغيثٍ سُحَّ وانْدَلقا",7,"ق",2,0],["في الثَغرِ شهدٌ حُلوُه مُرُّ","وَلكم سَقاني ذلِكَ الثغرُ",8,"ر",1,0],["فِي الثَّرى بَعضِي وتَخطُو","فَوقَها مِنِّى البَقِيَّه",9,"ه",1,0],["في الثقيلِ الثاني فَزُوري إذا شِئْ","تِ لكنما نُفيدُكِ الأبْياتَا",10,"ت",2,0],["فيا لثرى يسقى المصاعُ ترابه","مواكبَ طوعَ الملتقى وجُموعا",11,"ع",2,0],["فِي الثغرِ يَغْرُبُ حَرْفُهَا لَكِنَّهَا","بِسَمَا الخُدُود شُعَاعُهَا لاَ يَغْرُبُ",12,"ب",1,0],["في الثلث والتوقيع والاشعارِ","وفي محقق بالاختيار",13,"ر",1,0],["في الثغر واللحظ كم ناظرت عذالي","واحيرتي بين نظام وغزالي",14,"ل",2,1],["في الثنايا من عضهن فلول","ومن الطوق بعض وسم بجيدي",15,"د",2,0],["في الثمر المر دليل على","رداءة الأصل لمستطعم",16,"م",1,0],["في الثدي بالمسمار جرح مؤلم","وتورم بالسوط في الاعصاء",17,"ا",2,0],["في الثرى واريت آبائي فمن","يا ترى بعدهم ألفي نصيرا",18,"ر",2,0],["في الثلج نابضة وفي","ريح السموم لها طليعة",19,"ع",2,0],["في الثغر يبدو الأقحوان مفضضا","والجلنار على الخدود مذهّبا",20,"ب",2,0],["في الثغر عنك عن البروق غنى","ودموع عيني حسبهم مطرا",21,"ر",2,0],["فِي الثَّرَى اللِّيبِيِّ وَأرْضِ الْجِنَّتَيْنِ","مَزَّقُوا الْأخْلَاقَ هُدُوا للشيمْ",22,"م",1,0],["في الثَّقيلِ الثاني فَتَرْوى إذا شِئْ","تَ لِكيما نُفِيدَكَ الأبْيَاتا",23,"ت",2,0]]}