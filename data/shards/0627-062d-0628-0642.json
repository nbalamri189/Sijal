{"poems":[[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[275,"تصبته ريحا شمأل وجنوب","https://www.aldiwan.net/poem35639.html","الطويل"],[412,"أبا ثعلب حياك ربك كلما","https://www.aldiwan.net/poem50104.html","الطويل"],[521,"أحب قنا من حب هند ولم أكن","https://www.aldiwan.net/poem48686.html","الطويل"],[558,"أيا سرور وأنت يا حزن","https://www.aldiwan.net/poem68412.html","المنسرح"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80029","البسيط"],[2467,"","https://poetry.dctabudhabi.ae/diwan/poem/111731","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205031","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205759","الطويل"],[4902,"واخا وبالزاف","https://www.poetsgate.com/ViewPoem.aspx?id=23709",""],[5701,"تحية من شاعر شاكر","https://www.poetsgate.com/ViewPoem.aspx?id=164709",""],[5818,"ملهمة شعري","https://www.poetsgate.com/ViewPoem.aspx?id=199981",""],[6093,"أيِّيْ وأيُّكِ إنْ قامَ الهَوى نَكَلا","https://www.poetsgate.com/ViewPoem.aspx?id=177625",""]],"verses":[["أُحِبُّ قَصِيَّ الرِحمِ مِن أَجلِ حُبِّكُمُ","وَأَهجُرُ فيكُم أُسرَتي وَبَناتي",0,"ت",2,0],["أُحِبُّ قريباً إن دعاني أجبتهُ","وليسَ إذا ناديتُه بمُجيب",1,"ب",1,0],["أَحب قرى نَجدٍ لأَنَكَ قاطِن","بهنَّ فَهَل حُبُّ الدِيار حَرامُ",2,"م",1,0],["أحب قنا من حبِّ هند ولم أكن","أبالي أقربا زاده الله أم بعدا",3,"د",2,1],["أَحَبَّ قَلبي وَما دَرى جَسَدي","وَلَو دَرى لَم يُقِم بِهِ السِمَنُ",4,"ن",1,0],["أحبَّ قربك واستبقاه خالقُه","ركناً تطوف به الآمالُ مستلما",5,"م",2,0],["أحَبَّ قلبي وما درى بدني","ولو درى ما أقام في السِمَنِ",6,"ن",1,1],["أحب قضاء وقتي وهو عمري","فليس العمر عمرا في نواكا",7,"ك",2,0],["أحبَّ قنا واستعذب العيشَ في قنا","فلم يُغرِهِ عيش، وإن كان أعذبا",8,"ب",2,0],["أحب قولة ياهلا وعل وماخلاف","من بنت ثوبي بنت الأرض النضيره",9,"ر",2,0],["أحب قلبي الشعر من يومه","وهو يرى كل الورى أهله",10,"ل",2,0],["أحبّ قوامكِ السوري","وروعة قدّكِ الأنسبْ",11,"ب",1,0],["أحبُّ قوماً بناءُ المجد همَّتُهم","والقلبُ عن غيرهم في حبِّهم شُغِلا",12,"ل",2,0]]}