{"poems":[[75,"يا غزالا جمعت فيه","https://www.aldiwan.net/poem11901.html","مجزوء الرمل"],[29,"قد قرب الحي إذ هاجوا لإصعاد","https://www.aldiwan.net/poem5728.html","البسيط"],[45,"أمن ازديارك في الدجى الرقباء","https://www.aldiwan.net/poem9445.html","الكامل"],[45,"لا افتخار إلا لمن لا يضام","https://www.aldiwan.net/poem10542.html","الخفيف"],[77,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[77,"وأبيض كلسان البرق مخترط","https://www.aldiwan.net/poem69099.html","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140863",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39573","البسيط"],[111,"نكس العلام يا خير الملل","https://www.poetsgate.com/ViewPoem.aspx?id=67046",""],[96,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[139,"كنت في مصر قوة ذات بال","https://www.aldiwan.net/poem49176.html","الخفيف"],[264,"منية الأرواح وافانا","https://www.aldiwan.net/poem35490.html","المديد"],[287,"في عنفوان الصبا ما كنت بالغزل","https://www.aldiwan.net/poem32668.html","البسيط"],[382,"تبا لمتورط في إثمه ورطا","https://www.aldiwan.net/poem59353.html","البسيط"],[438,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[558,"طيف الخيال حمدنا منك إلماما","https://www.aldiwan.net/poem68427.html","البسيط"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2467","المنسرح"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53742","الرجز"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103071","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48787","الخفيف"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99981","السريع"],[977,"","https://poetry.dctabudhabi.ae/diwan/poem/124595","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141342","البسيط"],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96211","الخفيف"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52077","الرمل"],[1985,"","https://poetry.dctabudhabi.ae/diwan/poem/132437","الرمل"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95137","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27227","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100902","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201786","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132587","الخفيف"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121854","السريع"],[3277,"","https://poetry.dctabudhabi.ae/diwan/poem/125991","الخفيف"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86335","الطويل"],[3560,"","https://poetry.dctabudhabi.ae/diwan/poem/117164","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138664",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216490","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128951","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86359","الرمل"],[4291,"","https://poetry.dctabudhabi.ae/diwan/poem/142469","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120451","الكامل"],[4718,"الحمدلله على الاسلام والمله","https://www.poetsgate.com/ViewPoem.aspx?id=137217",""],[1536,"تَعَزَّ يا خَيْرَ الْوَرَى عَنْ أخٍ","https://www.poetsgate.com/ViewPoem.aspx?id=85714",""],[5186,"طاب يا نشء في نهاك الثناء","https://www.poetsgate.com/ViewPoem.aspx?id=156455",""],[5277,"معارضةُ يائيةِ ابن الفارض(1)","https://www.poetsgate.com/ViewPoem.aspx?id=198943",""],[5277,"إليك يا ولدي","https://www.poetsgate.com/ViewPoem.aspx?id=206194",""],[5414,"الهابطون والصاعدون","https://www.poetsgate.com/ViewPoem.aspx?id=12938",""],[5809,"ايجار","https://www.poetsgate.com/ViewPoem.aspx?id=205109",""]],"verses":[["مُنيَةَ الصَبِّ أَغِثني","قَد دَنَت مِنّي المَنونُ",0,"ن",1,0],["مَن يَهدِهِ اللَهُ يَهتَد لا مُضِلَّ لَهُ","وَمَن أَضَلَّ فَما يَهديهِ مِن هادي",1,"د",2,0],["مَن يَهتَدي في الفِعلِ ما لا تَهتَدي","في القَولِ حَتّى يَفعَلَ الشُعَراءُ",2,"ا",2,0],["مَن يَهُن يَسهُلِ الهَوانُ عَلَيهِ","ما لِجُرحٍ بِمَيِّتٍ إيلامُ",3,"م",1,0],["مَن يهتدي دونَ المعِزِّ خليفَةً","إنّ الهدايةَ دونَهُ تضليل",4,"ل",1,0],["منيّةٌ ليس تبغي غيرَ طالبِها","وكوكبٌ ليس يبغي غيرَ عفْريتِ",5,"ت",1,0],["من يهتدي في الفعل ما لا يهتدي","في القول حتى يفعل الشعراء",6,"ا",2,0],["مَنيَّةٌ كحياةٍ كلما ذُكِرَتْ","تجدّدَتْ لك في الأجيالِ أعمارُ",7,"ر",1,0],["من يهد الخطب من فورته","من يقيم الوزن من يشفي العلل",8,"ل",1,0],["من يهزّ النديّ بعدك بالخطبة","عصماء تحشد البأس حشدا",9,"د",2,0],["من يهز النفوس مثلك شرقاً","وجنوباً لمغرب وشمالِ",10,"ل",1,0],["منية الأرواح وافانا","وبكأس الراح صافانا",11,"ن",2,1],["مَن يَهوَ يَهوِ إِلى قَعرِ الهَوانِ عَمىً","شَتّانَ بَينَ شَجٍ عانٍ وَبَينَ خَلي",12,"ل",2,0],["مَنْ يُهْمِلُ التوبةَ الغراءَ يَعدَمُها","إن أذنبَ المرءُ في أيامه وخَطا",13,"ط",2,0],["من يهتدي في مظلماتِ بحارِه","وقت الضلالِ بفطْنَةٍ مبيَّضةِ",14,"ه",1,0],["مَنِيَّةٌ في يَدَي هارونَ يَبعَثُها","عَلى أَعاديهِ إِن سامى وَإِن حاما",15,"م",2,0],["مَن يَهَبُ البُختَ وَالوَلائِدَ كَال","غِزلانِ وَالخَيلَ تَعلُكُ اللُجُما",16,"م",2,0],["مَنْ يهدِ ريحاناً فإني مُهْدي","ريحانة الحمد لأهل الحمدِ",17,"د",1,1],["منية النفس إن نافست منيتها","والقلب ليس له عن ذاك منقلب",18,"ب",1,0],["من يهنئك بالنجاة يهنئ","بنجاة الوفيِّ مصرَ الوفيه",19,"ي",2,0],["مَنِيَّةٌ إِنْ لَمْ تُفَاجِ الْفَتَى","كَانَتْ لَهُ بِالسُّقْمِ ذَاتَ مَسِّ",20,"س",1,0],["منية النفس في هنالك قد ما","أسأل اللّه أن يتم مناها",21,"ا",3,0],["منيّة الحرّ خير من معيشته","في عهد جورٍ وبهتان وتمويه",22,"ي",2,0],["منية سابقت ورود البشير","ومواف أو في على التقدير",23,"ر",1,1],["مُنيَةٌ ما طَلَنِي الدَّهرُ بَهَا","مَطْلَ غَيلاَن بِرَجْعِ الطلَلِ",24,"ل",1,0],["منية النفس وغايات الوطر","مجلس في يوم غيم ومطر",25,"ر",1,1],["مُنيةُ قَلبي تترُ","لصَبِّها تُجَانِبُ",26,"ب",1,1],["مَنْ يهتدي أهل النهى بمنارة","ذاك الخليفة تُقتفى أثارُه",27,"ر",2,0],["منيةُ العاشق دونَ المنى","ومغنمُ العاشقِ فى المغرم",28,"م",1,0],["من يهد للبحر أصدافاً بها سخرت","امواجه وغدت ألعوبة فيها",29,"ي",3,0],["منية الصب ان تعود ليال","بزرود سقى الغمام زرودا",30,"د",2,0],["مَن يُهْدِ للناسِ ثمارَ الغنَى","أهْدَوْا إليه ثَمَرَ الشكرِ",31,"ر",1,1],["من يهود وصائبين وقبط","والنصارى وكل خصم مشاقق",32,"ق",1,0],["مَنى هاجَ منا الشَوقُ نَحوَ رُبوعِهِم","نَطيرُ لَهُم وجداً بِاجنِحَةِ النَسرِ",33,"ر",1,0],["منِيَّةُ أبناءِ المهَلَّبِ إنَّهُم","يرونَ بها حتماً كتاباً معجّلا",34,"ل",2,0],["من يهني نرجساً إذ حملت","سيداً أشرف من جاء وسارا",35,"ر",2,0],["منية لو تحققت لتساوى","ما تملكته وما أتمنى",36,"ن",2,0],["منية النفس راقبيني اذا ما","غلط النوم غلطة في جفوني",37,"ي",1,0],["منية الملتحف المفترش","بربى مخضرة في بقلها",38,"ه",2,0],["من يهن يمس حماه","لقوى الشر مباحا",39,"ح",2,0],["من يهيج مولانا الفصيح فقل له","اخطأت انك لست تدري ما الهجا",40,"ج",2,1],["من يهدي الله فلاحدٍ يقدر ايضله","ومن يضلل الله فمن هو قادرٍ ثاني",41,"ن",2,0],["مَنِيَّةٌ إِنْ لَمْ تُفَاجِ الْفَتَى","كَانَتْ لَهُ بِالسُّقْمِ ذَا مَسِّ",42,"س",1,0],["من يهن يسهل الهوان عليه","والمعالي يودي بها الجبناء",43,"ا",2,0],["منيةُ القلبِ لقاءٌ وهوىً","تلكَما في القلبِ أغلى مُنيتَيْ",44,"ي",1,0],["منْ يهدِهِ الرحمنُ نالَ منَ الذرى","فاجعلْ هدايتَهُ بصدقٍ مطمعَكْ",45,"ك",1,0],["من يهن يسهل الهوانُ عليه","ما لجرحٍ بميتٍ إضرارُ",46,"ر",1,0],["مَن يهجرِ الدارَ يُطفيءْ نارَ مَوقدِها","وأنت أوقدتَ في أرجائها النارا",47,"ر",2,0]]}