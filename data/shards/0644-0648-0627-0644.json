tsgate.com/ViewPoem.aspx?id=210842",""],[6019,"حَفَاوَةُ اللِّقاءِ الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=212920",""],[6100,"قلب المولع","https://www.poetsgate.com/ViewPoem.aspx?id=52594",""],[6102,"رَسولُ الهَوى...","https://www.poetsgate.com/ViewPoem.aspx?id=182740",""],[6104,"بعدَ الرِّيّ","https://www.poetsgate.com/ViewPoem.aspx?id=24195",""],[6115,"اذا جتني الذمّه من اللاش","https://www.poetsgate.com/ViewPoem.aspx?id=180455",""],[6115,"لاعاد وقت التعب والضيق والحاجه","https://www.poetsgate.com/ViewPoem.aspx?id=180525",""],[6115,"على شأن مايشره عليه خيار الناس","https://www.poetsgate.com/ViewPoem.aspx?id=181444",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[434,"ألا من مبلغٌ عمرو بنَ هندٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26721&r=&rc=9",""],[402,"مريم يا غرس خير كرم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54054&r=&rc=906",""]],"verses":[["لَوِ الشَمسُ مِن نَظمِهِ حُلِّيَت","أَوِ البَدرُ قامَ لَهُ مُنشِدا",0,"د",2,0],["لَوِ الغَرَامُ اصْطَفَى مِثَالاً","لَمَا اصْطَفَى غَيْرَكِ الغَرَامُ",1,"م",1,0],["لَوِ النَّاسُ أَرْقَى فِطْنَةً وَسَليقَةَ","لَمَا كَانَ مَنْ قَاضٍ وَلاَ كَانَ مِنْ خَصْمِ",2,"م",1,0],["لو ألقي الصخر بمخزاتها","لانفتّ من فرط الحيا وانفطر",3,"ر",1,0],["لوالدكَ الممدوح مرأًى مباركٌ","ولولاك في عليائِهِ لم يشارَكِ",4,"ك",1,1],["لو ألقيت كعصا موسى على حجرٍ","نفجَّر الماء من أقصى نواحيه",5,"ي",2,0],["لوالدهِ منه إذا غابَ خالفٌ","ضليعٌ إذا ما اسْتُكفِيَ الأمرَ ضابط",6,"ط",1,0],["لَوِ المُروأَةُ تَدري فاجِعَةً","بِالشامِ ناحَ عَلَيها الإِنسُ وَالجانُ",7,"ن",1,0],["لَوِ القَوافي تُؤاتيني شَكَرتُكُمُ","كَما أُريدُ وَلَكِن لا تُؤاتيني",8,"ن",2,0],["لَوِ اِلتَمَستَ فيهِ بَط","طالَ اليَدَينِ لَم تَرَه",9,"ر",2,0],["لَوِ البِغَالُ الكُمْتُ ارْتَقَتْ سَنَداً","فيهِ لَمدَّتْ قَوائِماً خَدِرَهْ",10,"ر",2,0],["لَوِ الفَلَكَ الدَوّارَ أَبغَضتَ سَعيَهُ","لَعَوَّقَهُ شَيءٌ عَنِ الدَوَرانِ",11,"ن",1,0],["لَوِ الأَمرُ يَضحى في سِوى آلِ هاشِمٍ","لَكانَ بِلا شَكٍ يَكونُ لَهُ الأَمرُ",12,"ر",1,0],["لَو أُلاقي مَن يَحمِلُ الشَوقَ عَنّي","رُحتُ بَينَ الصَبا وَبَينَ الجَنوبِ",13,"ب",1,0],["لَوِ المَوْتُ مَدَّ إِلَيْهِمْ يَداً","لَرَدوهُ عَنْهُمْ كَلِيلَ اليَدِ",14,"د",1,0],["لَوِ الكَوْكَبُ الدُّرِّيُّ وَهْوَ مُسَاهِرِي","رَأَى مَا أُقَاسِي لاَغْتَدَى وَهْوَ شَاحِبُ",15,"ب",1,0],["لو التزموا من عزة الدين شرطها","لما اتضعت منها الرعان الفوارع",16,"ع",1,0],["لوِ الأمرُ في كَفِّي لجهَّزتُ قوّةً","تُعوِّدُ هذا الشعبَ ما لم يُعوَّد",17,"د",1,0],["لو الأمرُ في كفِّي لاعلنتُ ثورةً","على كلِّ هدّام بألفَي مشيِّد",17,"د",1,0],["لو التزموا من عزة الدين شرطها","لا اتضعت منها الرعان الفوارع",18,"ع",1,0],["لوالده الخلافة ثم لما","دعا فله الخلافة بعد خلا",19,"ل",2,0],["لو أُلبِسَ الليلُ البهيمُ جَلالَهُ","لم تَشتمل أرجاؤُهُ بسَوادِ",20,"د",1,0],["لو اليه دعا الاهلة جاءت","ولودّت بأن تكون نعاله",21,"ل",2,0],["لَوْ الفَتْحُ بنُ خَاقانٍ رآهُ","لِقُلِّدَ مِن مَحَاسنهِ القَلائِدْ",22,"د",1,0],["لو الثقلان الإِنس والجن أجمعوا","يريدون إيلاماً لأصغر نملة",23,"ه",1,1],["لو إليكم وجهت لسقت","أرضكم واخضرت الكثب",24,"ب",1,0],["لِوالِدِها وَأَرأَتهُ بِلَيلٍ","قَطاً وَلَقَلَّ ما يَسري ظَلاما",25,"م",2,0],["لو الرياح أرادت وهي جاريةٌ","سباقهُ قصرت عن ذاك بل تقفُ",26,"ف",1,0],["لو الجبال وزنت بحلمه","شالت جبال الأرض في ميزانها",27,"ن",3,0],["لو ألمَّت فأباحتني لما لها","لشفت غلَّة قلبي شفتاها",28,"ا",3,1],["لو الميتُ يدعى في الثرى بمثالهِ","لكان لهُ من طيّ أكفانهِ نشر",29,"ر",1,0],["لَو التَقى عيسى بِعيسى لما","كانَ لَهُ مِن مالِهِ بَختُ",30,"ت",1,1],["لو العرفان نوّرها لكانت","نجوم سعادة في العائلات",31,"ت",1,0],["لَو أُلبِسَ الفارسيُّ الروح كانَ إِذاً","أَثنى عَلَيهِ بإِيضاحٍ وَإِلباسِ",32,"س",1,0],["لَو النّجاسات كانَت أَبحُراً وُضِعَت","في تِلكُمُ اللّحية الشّنعاء ما طفحت",33,"ت",1,0],["لوالده يلبي الدهر","كم طوعاً وكم سمعا",34,"ع",2,0],["لَو إِلى الأَمرِ ما أَق","ذَيتُ عَينا بِرَقيب",35,"ب",1,0],["لوالدي طه مقام علا","فوق علا الناس بلا ارتياب",36,"ب",1,1],["لو الدراري نزلت صفت له","فصفا فأغزاها مراكز الكرى",37,"ا",1,0],["لو الدولة الغراءُ يوماً تفاخرتْ","مع الشمس قالت أين صبحك من صبحي",38,"ح",2,0],["لو الكمالُ بدا شخصاً لما وجدوا","سواكَ في عينِ ذاك الشخصِ إنسانا",39,"ن",2,0],["لو المتنبّي شاهد الحِكَم التي","نطقتَ بها ما شكَّ أنَّك باعثُهْ",40,"ث",2,0],["لوالى سمعك الشريف محق","نقل الحق كنت نلت مرادى",41,"د",2,0],["لوالدة الفتى وأبيه فضلٌ","عليه ليس تنكره الكرام",42,"م",1,1],["لو السحاب تصدى أن يباذله","مل السحاب وذا لم يعرف المللا",43,"ل",2,0],["لو المعالي تجسمت رجلا","سواه ما كان ذلك الرجل",44,"ل",1,0],["لِوالده خَير أنس وَبَشَر","وَمَن عادة الشبل يَحكي الأُسودا",45,"د",2,0],["لِوالده البُشرى بعز وَجوده","وَنَيل التَهاني يَوم وافى وَفي غَد",46,"د",1,0],["لو الدنيا استشيرت ما احتواكم","من الدنيا مكان أو زمانُ",47,"ن",1,0],["لو التقى قلت تلك الراح قد سكرت","منها العقول ولا ساق سوى القلم",48,"م",1,0],["لوالدي طه مقام علا","في جنة الخلد ودار الثواب",49,"ب",1,1],["لو الف نيل جُمّعت ما ماثلت","من اوقيانوس واحد معشارا",50,"ر",2,0],["لو الشطوط عقود","فتلك إحدى الخرائد",51,"د",1,0],["لو المدائن در","فإنها في الفرائد",51,"د",1,0],["لو الشم فيه حاسة السمع بدلت","لألفيت تلك الغاليات غواليه",52,"ي",2,0],["لو المرءُ قدْرَ الفضلِ يُعطَى علامة","لَقَلَّ بأن يُعطَى علامتَه الفرقد",53,"د",1,0],["لو النسا بوصفها تغاثُ","على الرجال فضِّل الإناثُ",54,"ث",1,0],["لو الأفْقُ اقتدى بحُلَى عُلاهُ","هُدىً وندىً أنارَ سنىً وجادَا",55,"د",2,0],["لوْ أُلْفِيت بالشُّهْبِ عارفَةُ النّدى","لأنالَها كَرماً وقال أنا لَها",56,"ل",3,0],["لو الصبر مثل لم يستطع","تحمل ذاك البلا الأفضع",57,"ع",1,0],["لو السحب بارت بالعطا بحر كفه","لفاقت هتون المعصرات سحائبه",58,"ب",2,0],["لو الروح دبت في السماكين ساعة","لراحا على الأهواء يختصمانِ",59,"ن",1,0],["لوالدي أتشكى","فقال قتلك واجب",60,"ب",1,0],["لو الوفود أتت من كل ناحية","كأنه كعبة في باحة الحرم",61,"م",1,0],["لو ألقيت في كأس الحميا","لعادت وهي آنية الجريض",62,"ض",1,0],["لو الغيث استعار نداه مجرى","لما عرف الورى بلداً جديبا",63,"ب",2,0],["لوالده بدر المفاخر أحمد","لقد راق لون العقد بالجوهر الفرد",64,"د",1,0],["لو ألقي الجسم على راس القلم","ما غير الخط لضعف وسقم",65,"م",1,0],["لَوِ الدَّمْعُ يُجْدِي باكِياً لَسَفَحْتُهُ","إلى أَنْ يَحُقَّ الحقُّ والدَّمُ أَدْمُعُ",66,"ع",1,0],["لوالدتي والأهلِ كلاّ وأخوتي","وإخواننا في اللهِ من صادقٍ وافِي",67,"ف",2,0],["لو إلى العيوق أوما غضبه","لم يُعِقهُ والي ناديهِ طاحا",68,"ح",2,0],["لوالد جعفرٍ وأخي معالٍ","لها جدَّ العلا ففلا الفجاجا",69,"ج",2,0],["لو الأنجم الزهر التي هي دون ما","حللت وقد أعيت عليها المصاعد",70,"د",1,0],["لو الليالي وضعها للادمي مثل الهدوم","الشمس تكشف سترة الليل وتبين الخافيه",71,"ف",3,0],["لو الذيابه ما رضت بالفشيله","مير البلا فانيابها وش دخلها",72,"ل",3,0],["لو التمني ينفع الناس يا ليت","ابقى على طول الزمن والعمر شاب",73,"ب",1,0],["لو البس عقال وعليه العمامه","من لامني ما يعرف الحب والزين",74,"ن",1,0],["لو المصايب دكّت حصونها دكّ","تزداد حب ولا يجي بينها شكوك",75,"ك",1,0],["لو القدر فيك تكفيه المطاليب","يا كثرهم فالوطا ياخذهم فداك",76,"ك",1,0],["لو العيون تصوّر الخل بكتاب","بين المحاجر كل وقتٍ تمرّه",77,"ر",2,0],["لو الدواء بيدك وعندك لي اعلاج","افضل اموت ولارجيت العلاجي",78,"ج",2,0],["لو الخلدُ من ربِّ الورى كان لامرئٍ","لخصَّ به شخصَ النبيِّ \"مُحمّدِ\"",79,"د",1,0],["لو العهد من غير (منجوبت إدريس)","ما شاعن الدعوى (طيور النوارس)",80,"س",1,0],["لو المقابر ترد الميت حي ليا لفوها الورا","والله ان تجي من قطاع الارض وتخّيم على المقبرة",81,"ر",2,0],["لو التوجد يصلح الحال ياسعود","سريتها لو كان حالي متردي",82,"د",2,0],["لو الدموع ليا أمطرت تنبت ورود","نبتت بساتين الوله فوق خدي",82,"د",2,0],["لو الدموع اتفيد فادن الايتام","ولو الكلام يفيد عادت فلسطين",83,"ن",1,0],["لوالتواضع والوفا من سماتك","بعت الحبايب كلهم دين واشريك",84,"ك",1,0],["لو الدموع ترد بالحب من غاب","سكبت دمعاتي مطر ياضنيني",85,"ن",2,0],["لو الود ودي ما ابتعدتي ولا اروح","بس الليالي والدهر له صروفه",86,"ف",2,0],["لو الصبر ينباع بطلعة الروح","كانت فداك بواحد من احروفه",86,"ف",2,0],["لوالده في ثغر بيروت قد غدت","نوافح حسن الذكر طيبة النشر",87,"ر",1,0],["لوالده ندبت بشرع نظمي","ثناء بالتهاني كان حتما",88,"م",2,0],["لو التقينا لما ضجّت مشاعرنا","بأعذب البوحِ في دنيا المحبّينا",89,"ن",2,1],["لو الورود اللي بهالكون شاكت","ماعاد تفرق دام عندي بلَدها",90,"د",3,0],["لو الغلا هبكه والإحساس قدّام","ماذقت من طاري تجافيك شرّه",91,"ر",2,0],["لو ( النقا ) يمشي من الألف لليآء","مآصآر في صدري مسآحآت للكي",92,"ي",1,0],["لو النحل مثل الذبابه بالاطباع","ماكان ميّزة العسل عن خصيمه",93,"م",2,0],["لو الذي قد صار بيني وبينك","مثل الذي قد صار بينك وبيني",94,"ن",2,1],["لو السفينه عابره دون ربان","ما كان عدت في البحور الغريقه",95,"ق",2,0],["لو القهر ما خلّف بصدري اضرار","ماشفت لي قافٍ مع الناس مسموع",96,"ع",1,0],["لو القلم باح مكنونه","خيال . .وابلَغْه من قاله",97,"ل",2,0],["لو إلى الله أمرُكم رُدَّ ما مس","رى رسول الهدى الى اللص (راحَ)",98,"ح",1,0],["لوالد بر رحيم حسن","سرى على الجاه والمآئر",99,"ر",1,0],["لو العرب تقرا الخفايا . . .تخليت","عن ناس تفرح طيحتك ..والشقا بك",100,"ك",1,0],["لو ألهمت سحر البيان لما شدا","إلا بفلسفة السياط قصيدُها",101,"د",3,0],["لو المدى بعد البلد والمسافات","كان أعتقد الارواح مافرقتها",102,"ت",3,0],["لو الحريري نالته جواهرها","لشاب أمرد قبل المس للصدف",103,"ف",1,0],["لو التوحيد في نظري","لقلت الأمر مشترك",104,"ك",1,0],["لو الحسينُ هنا أرخى ركائبَهُ","ما كانَ لاقى الذي في كربلا لاقى",105,"ق",2,0],["لو الهوى منكم منعتم هبوبه","لا شك رزاق الملا رب الأرباب",106,"ب",1,0],["لو الهوى المحبوس في جوف صدري","يظهر على العالم غشى العالم هيام",107,"م",1,0],["لو الكلام ينزرع","هزرع ميتين فدان..",108,"ن",1,1],["لو الشجر له نصيب ف بارد ظلاله","ماحرق القيض جفني وأنت ف أهدابي",109,"ب",2,0],["لو المرض جيشٍ نطحناه بسنان","ولو الكدر بحرٍ شربناه لرضاه",110,"ا",2,0],["لو الصداقه ترضخ لحكم قاضي","ياكم صديقٍ حكم الإعدام مثواه",111,"ا",2,0],["لو الحنين لصافي الود مرسال","والله فلا تنقض مواثيق وعهود",112,"د",1,0],["لوالمشاكل حلها طول الفراق","من حيز الفرقى تمنيت الرحيق",113,"ق",1,0],["لو البشر قالو على نفسك اخطيت","قول الزمان اللي حييته عجوفي",114,"ف",2,0],["لو الزمان استبدله ياعنتر وحال البشر","لوعشت حاظرنا بعد عشت الزمان الاقدمي",115,"م",2,0],["لو العتب .. يثمر حيا / جيت رواي ..","مير الحياء .. ب وجيههم مات / كله",116,"ل",2,0],["لو الرضا بالمال والله لشريه","وان كان انا مخطي عليه اتراجاه",117,"ا",2,0],["لو الزمن يرجع وتذكر مبا