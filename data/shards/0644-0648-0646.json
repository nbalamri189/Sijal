m55321.html","الرجز"],[375,"كان يوم البين أو لم يكن","https://www.aldiwan.net/poem57047.html","الرمل"],[375,"أطاعك الدمع الذي كان عصى","https://www.aldiwan.net/poem57538.html","الرجز"],[404,"ابتهل","https://www.aldiwan.net/poem6733.html","عموديه"],[413,"مثوبة الفاقد عن فقده","https://www.aldiwan.net/poem31930.html","السريع"],[413,"أضحت على مفرقي تاجا وفي عنقي","https://www.aldiwan.net/poem32203.html","البسيط"],[420,"قام يجلوها وبرد الليل معلم","https://www.aldiwan.net/poem54025.html","الرمل"],[420,"قدمت بالبشر وبالبشائر","https://www.aldiwan.net/poem54089.html","الرجز"],[420,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[436,"حي وجها من الرياض وسيما","https://www.aldiwan.net/poem12376.html","الخفيف"],[436,"لو نسبناك في بني عبد شمس","https://www.aldiwan.net/poem12650.html","الخفيف"],[436,"نعم هو البرق على الأنعم","https://www.aldiwan.net/poem12720.html","السريع"],[436,"عزت ضمائره على كتمانه","https://www.aldiwan.net/poem12747.html","الكامل"],[441,"هذه الدار والخيام الخيام","https://www.aldiwan.net/poem2543.html","الخفيف"],[461,"أَصاب أو أخطأني راميا","https://www.aldiwan.net/poem55810.html","السريع"],[461,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[461,"الليل فالأرض لليث الشرى","https://www.aldiwan.net/poem56180.html","السريع"],[461,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[461,"دعها تكن كالسلف من أخواتها","https://www.aldiwan.net/poem56263.html","البسيط"],[461,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[464,"علمي بسابقة المقسوم ألزمني","https://www.aldiwan.net/poem15986.html","البسيط"],[464,"ان شارك الأدوان أهل العلى","https://www.aldiwan.net/poem16007.html","السريع"],[503,"أي ورد قد شممناه ضحى","https://www.aldiwan.net/poem37781.html","الرمل"],[503,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[518,"دم أبا فاتك حليف بقاء","https://www.aldiwan.net/poem12000.html","الخفيف"],[518,"يا ظبية الرمل التي","https://www.aldiwan.net/poem12102.html","مجزوء الرجز"],[518,"خذ يا زمان أماناً من يدي أملي","https://www.aldiwan.net/poem12211.html","البسيط"],[554,"حييت يا ربع اللوى من مربع","https://www.aldiwan.net/poem47702.html","الكامل"],[554,"هل ليالي بالمنقى رجوع","https://www.aldiwan.net/poem47718.html","الخفيف"],[556,"لو نطق الناس أو أثنوا بعلمهم","https://www.aldiwan.net/poem68354.html","الطويل"],[561,"إياك تشهد غيره ودع العنا","https://www.aldiwan.net/poem33787.html","الكامل"],[570,"اكفنا ياعذول شر لسانك","https://www.aldiwan.net/poem69496.html","الخفيف"],[578,"غلابة القول بل خلابة الخلس","https://www.aldiwan.net/poem2741.html","البسيط"],[578,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"]],"verses":[["لَونُ الشَبينَةِ أَنصَلُ الأَلوانِ","وَالشَيبُ جُلُّ عَمائِمِ الفِتيانِ",0,"ن",1,1],["لَو نِلتَها كانَت لِقَلبِكَ مَقنَعاً","مِن كُلِّ شَيءٍ كائِنٍ ما كانا",1,"ن",2,0],["لون العقيق وقد سال العقيق دماً","بعطفه من كُماةٍ كرَّ يُدميها",2,"ي",3,0],["لون العشية ذهَّبَتْ صفحاتها","رقَّتْ وراقَتْ بهجةً وجمالا",3,"ل",2,0],["لو نقتري صحف التأريخ نسألها","عمّن يساويه في الدهر الذي غبرا",4,"ر",2,0],["لون المدام كما تراه وإنَّما","خدّ الذي أهواه لونٌ آخر",5,"ر",1,0],["لو نازعته بيوت الأولين على","لصيرَ الصدرَ منها موضع العجز",6,"ز",1,0],["لو نسيت عينايَ إنسانها","ما نسيت ليلى على الأجرع",7,"ع",1,0],["لوَّنته وأمطرته جفونٌ","جُرَّ منها الوادي وسالَ العقيق",8,"ق",1,0],["لو نسيت الفضائل ما كن","ت بناسٍ صنائع الأفضال",9,"ل",1,0],["لونُ ناجودِها إذا هي قامت","لون ياقوتها المضيءِ الثقابِ",10,"ب",1,0],["لو نُخِلَت بالحريرِ لانسربت","من خَلَلِ النسج غير محتبسَهْ",11,"س",2,0],["لونُها الدهر واحدٌ كجَني الور","د وإن كان وُدُّها ألوانا",12,"ن",2,0],["لو نجا من حِمامهِ جاعلُ الما","ل مَعاذاً له نجا قارونه",13,"ن",2,0],["لَو نَظَرَ الناسُ لِأَحوالِهِم","لَاشتَغَلَ الناسُ عَنِ الناسِ",14,"س",1,0],["لَونٌ كَسَتهُ صُفرَةٌ وَمَدامِعٌ","هَطَلَت سَحائِبُها وَجِسمٌ ناحِلُ",15,"ل",1,0],["لو نبتت لخالتي لحية","سميتها عندئذ خالي",16,"ي",1,0],["لو نلتُ أسباب السماء لحطني","أجل يحل لحينه موقوته",17,"ت",2,0],["لَوْ نَبَتَ الشَّعْرُ في وِصالٍ","لعادَ ذاكَ الوِصَالُ صَدّا",18,"د",2,0],["لَو نيطَتِ الدُنيا بِأُخرى مِثلِها","لَعَمَمنَها وَخَشينَ أَن لا تَقنَعا",19,"ع",2,0],["لونين صارا واحداً فازدوجا","بالسقي والسحق معاً فامتزجا",20,"ج",2,0],["لَو نافَسوكَ لَخالَسوكَ مِنَ النَدى","ما يُصلِحونَ بِهِ الزَمانَ الفاسِدا",21,"د",2,0],["لَو نالَ قَرنَ الشَمسِ حَلّوا بَيتَهُ","شَرَفاً عَطاءَ شَوامِخٍ وَرَواسِ",22,"س",1,0],["لَو نَفَّسَتهُ الخَيلُ لَفتَةَ ناظِرٍ","مَلَأَ البِلادَ زَلازِلاً وَفُتوقا",23,"ق",2,0],["لَو نُوَفّي ما لَنا في صاعِدٍ","لَصَعَدنا مِن عُلُوٍّ في الأُفُق",24,"ق",1,0],["لَوَّنَ مِن أَخلاقِهِ وَالهَوى","فيهِ عَلى كَثرَةِ تَلوينِهِ",25,"ن",2,0],["لَو نالَ حَيٌّ مِنَ الدُنيا بِمَنزِلَةٍ","أُفقَ السَماءِ لَنالَت كَفُّهُ الأُفُقا",26,"ق",2,0],["لَو نَظَمتُ النُجومَ شِعراً لَما كا","فَيتُ عَن بَعضِ ذَلِكَ الإِحسانِ",27,"ن",1,0],["لَو نادَمَها النَديمُ يوماً","ما أَعجَزَها لَهُ الكَلامُ",28,"م",1,0],["لَو نَظَمنا النُجومَ فيكَ عُقوداً","ما قَضَينا حُقوقَكَ الواجِباتِ",29,"ت",1,0],["لَو نَظَمتُ النجومَ شِعراً كَما كا","فيتُ عَنِ بَعضِ ذَلِكَ الإِحسانِ",30,"ن",1,0],["لونُ الياقوتِ وقسوتُهُ","في الوجنةِ منها والكَبدِ",31,"د",1,0],["لوْ نلتُ مِنْ خدَّيهِ تقبيلةً","تزيَّنَ الريحانُ بالوردِ",32,"د",1,0],["لَو نالَ الصَبا لَظى وَجدي","لَعادَت أَنفاسُها زَفرَه",33,"ه",1,0],["لَونٌ حَسِبتُ إِلى النِساءِ مُبَغَّضٌ","عِندَ النُصُولِ إِذا يَحِينُ خِضابُهُ",34,"ب",2,0],["لو ناسَبَتْ قَدْرَهُ آياتُهُ عِظَماً","أحْيا اسمُهُ حِينَ يُدْعَى دَارِسَ الرِّمَمِ",35,"م",1,0],["لو نازَعَ النَّجْمَ ما أعياه مَنزِلُهُ","أو نازَلَ القَدرَ المقدورَ لم يُهَل",36,"ل",1,0],["لو نَجا أشرفُ شيءٍ قَدَراً","فازَتِ الشمسُ بتخليد الأبد",37,"د",1,0],["لو نابَ عنها فصدُ شيءٍ غيرِهَا","لوَقيْتُ مِعصَمَها بحبل وريدي",38,"د",2,0],["لَو نِلتُما ما نِلتُ ما مُزِجَت","إِلّا بِدَمعِكُما مِنَ الوَجدِ",39,"د",1,0],["لَو نَظَرَت عَينُهُ إِلى حَجَرٍ","وَلَّدَ فيهِ فُتورُها سَقَما",40,"م",2,0],["لَو نُكِحَ اللَيثُ في اِستِهِ خَضَعا","وَماتَ جوعاً وَلَم يَنَل طَمَعا",41,"ع",2,1],["لَو نالَ خُلداً مِن قَبلِهِ أَحَدٌ","مَدَّت إِلى الخُلدِ كَفُّهُ سَبَبا",42,"ب",2,0],["لَو نَطَقَ الدَهرُ في تَصَرُّفِهِ","لَعَدَّنا كُلُّنا مِنَ التَفثِ",43,"ث",1,1],["لَونانِ مِن لَيلٍ وَصُبحٍ لَوَّنا","شَعري وَأَضعَفَني الزَمانُ الأَيِّدُ",44,"د",1,0],["لَو نَطَقَ الدَهرُ هَجا أَهلَهُ","كَأَنَّهُ الرومِيُّ أَو دِعبِلُ",45,"ل",1,0],["لَو نُخِلَ العَيشُ لَما حَصَّلَت","شَيئاً سِوى المَوتِ يَدُ الناخِلِ",46,"ل",1,0],["لو نيطت الدنيا بأخرى مثلها","لعممنها وخشين ألا تقنعا",47,"ع",2,0],["لونٌ جَلَتْ فيه الصحارَى سحرَها","تحت النجوم الغُرِّ والأنداءِ",48,"ا",2,0],["لَوْنَاهُ حُسْنٌ لاَ فرْقَ فِيهِ","وَالنَّاسُ فِيهِ حِزْبَانِ مَيْلاَ",49,"ل",2,0],["لَوْ نُضِّدَتْ أَوْرَاقُهُ مِنْ كَثْرَة","طَالَتْ عَلَى مُتَطَاوِلِ الأَجْبَالِ",50,"ل",1,0],["لَوْنَها ظَاهِرُ انْتِسَابٍ إِلى","الخَمْرِ لَهُ مِثْلُ فِعْلِهَا فِي الصدُورِ",51,"ر",1,0],["لوْنَانِ أَوْ هُوَ لَوْنٌ","فِيهَا بَدِيعُ امْتِزَاجِ",52,"ج",1,0],["لَو ناصَ نصّ الفِقهَ قَبلَ بُلوغِهِ","هَيهاتَ ما أَهلُ النَجابَةِ نُوَّصا",53,"ص",2,0],["لو ناقَشَ القومُ ضوْءَ الشمس، لاختلفوا","حتى تشتَّت فيه الرأيُ وانشعبا",54,"ب",2,0],["لو نعارضك للجفا لم نطالب","ك بصدق الدعوى وصفو الوداد",55,"د",1,0],["لو نغمت ناغية في زحل","كانت الهم لكم أو تعتقر",56,"ر",1,0],["لو کنَّ يَدِي كانت شفاءَكَ أَوْ دَمي","دمَ القلبِ حتى يقضبَ القلبَ قاضبُ",57,"ب",1,0],["لو نفضنا شرورنا لرأينا","أوجه الخير في الضّياء عيانا",58,"ن",2,0],["لو نبأ الله بعد المصطفى احدا","لكنت انت وفي هذا اتى الخبر",59,"ر",1,0],["لو نحتَتْ صخرتَه آلةٌ","لاستُنبِطتْ في تُربهِ زمزمُ",60,"م",1,0],["لَو ناجَتِ الأَعصَمَ لاِنحَطَّ لَها","طَوعَ القِيادِ مِن شَماريخِ الذُرى",61,"ا",1,0],["لو ناح للشوقِ مثلي كنتُ أَعذِره","لكنّه مَوَّه الدعوى وما صَدَقا",62,"ق",2,0],["لَو ناضَلوا الناسَ عَن أَحسابِهِم نَضَلوا","وَإِن قَضَوا لَم يَجوروا في الَّذي حَكَموا",63,"م",3,0],["لو نابَ عنه سواهُ في يَقَظاتِهِ","نابَتْ منابَ الجَوْهَرِ الحصباءُ",64,"ا",2,0],["لو ناب عني الشبيبي في تحيته","لكنت أغمدت يوم الحزن أشعاري",65,"ي",1,0],["لَوِّنيها بِالاِصفِرارِ إِلى أَن","يَختامَ المَوتُ نَزعَها المُستَمِرّا",66,"ر",2,0],["لَونُهُ أَمسِ غَيره اليَومَ إِنَّ ال","داءِ يَمحو عَنهُ جَمالَ الفَتاءِ",67,"ا",2,0],["لَوْ نَفْحَةٌ مِنْ شَذَا الْيُوسِيِّ تَشْفَعُ لِي","إِلَى رِضَاهُمْ رَضُوا عَنِّي وَإِنْ سَخِطُوا",68,"ط",3,0],["لو ناظرت بنظام درثائها","قدماً لبيداً راح وهو بليد",69,"د",1,0],["لَو نِلتَ ما أُبعِدتَ مِن ريقِها","إِنَّ لَها نَفثَة سَحّارَه",70,"ر",2,0],["لَو ناوَأَهُ الأَسَدُ الأَعلى","لَثَناهُ مُندَقَّ الحَنَكِ",71,"ك",1,0],["لَو نالَ ما هُوَ أَهلُهُ ما كانَ بِال","أَيدي الجِسامِ سِواهُ بِالمَخصوصِ",72,"ص",1,0],["لو نال ما يبغي لكانتْ دولة","أَهدى إلى سبلِ الصوابِ وَأرشد",73,"د",1,0],["لوناً من السهوم والذعول","وفكرة في عالم الغيوب",74,"ب",1,0],["لو نَهَتكُم لَوعَةٌ عن لَوعَتي","لأَقَمتُم أو شَجاكُم شَجني",75,"ن",2,0],["لو نظرت مثالها في غيرها","ألبسها منظره ثوبَ الضنى",76,"ا",1,0],["لو نظرنا لحكمةِ الدَّفْنِ فين",".ما ذَمَمْنَا من الطيور الغُرابا",77,"ب",2,0],["لو نطقُوا قالُوا التُّقَى خيرُ ما","تزوَّدَ المرءُ إلى لَحْدِهِ",78,"د",2,0],["لو نَال ما يتَمنى مِن مشيئتِه","مشَى إليك خُضوعاً مِشيةَ القَلمِ",79,"م",1,0],["لو نظرنا رقَّةً في طبعه","لحسبناهُ نسيماً يتنسّم",80,"م",1,0],["لو نَظَرَ الناظرُ ما صنَعْتَه","نمَّقه بدفتر المفاخر",81,"ر",1,0],["لو نالت المزن نوال كفه","لما اشتكى الظمآن من عيم الظما",82,"ا",1,0],["لو نَهَاني الإِمامُ مثْلُكَ عنها","لَعَصَيْتُ الإِمامَ والمأَمونا",83,"ن",2,0],["لو نسبْناكَ في بني عبدِ شمسِ","ورفعناكَ في ذؤابةِ قيسِ",84,"س",1,1],["لو نحلَ الأيامَ آدابَهُ","لم يظْلمِ الدهرَ ولم يُظْلِمِ",85,"م",1,0],["لونٌ بوجهِ البدرِ منه إشارةٌ","شانَتْ سواهُ فرفّعَتْ من شانِه",86,"ن",2,0],["لونه كالنضار أو كمحبّ","قد براه الهوى وشفّ السقام",87,"م",1,0],["لو نشَد البدرَ مُضِلٌّ له","ما نشد الناعتُ إنشاديا",88,"ي",2,0],["لو نَبشتْ عن صَدَى زُهيرٍ زقا","يحلِفُ أن قد فضلتُمُ هَرِما",89,"م",2,0],["لو نزل الوحيُ على شاعر","قمتُ بشيراً فيكُمُ منذرا",90,"ر",2,0],["لوِن سواه رأيتُ الغلا","مَ ينفُضُ عن كتِفَيْه الغُبارا",91,"ر",2,0],["لو نازل الرُّهْنانَ حطَّ قِنَانَها","فصبت إليه وحلَّ من عَزَماتِها",92,"ت",3,0],["لو نُسبَ المجدُ لَمَا كان إلى","غير بني عبدِ العزيزِ يُنسَبُ",93,"ب",1,0],["لو نيل بالقول مطلوبٌ لما حُرِم ال","كليمُ موسى وكان الحظُّ للجبل",94,"ل",1,0],["لو نفعَ البُخْلُ وذُلُّ الفتى","ما افْتَقرَ الكَزُّ وماتَ الجَبانْ",95,"ن",1,0],["لونُهُ الأحمرُ يحكي دَمَهُمْ","وسَمُوهُ للتَّخافي عَنْدَما",96,"م",2,0],["لو ناصفتْ سِمَةُ الإِنصافِ أفئدةً","منهم لما غالَها جحدٌ وبغضاءُ",97,"ا",2,0],["لو نظمنا له الكواكب كانت","دون ما يستحقه من ثناء",98,"ا",2,0],["لو نتفت ذقن فتو","ح كان ذنباً يغفر",99,"ر",1,0],["لو ناضلوك على الإنصاف عرفهم","مواقع الرمي رام من بني ثعل",100,"ل",1,0],["لونٌ تراهُ ناصعاً حتّى إذا","خَلَفَ الشّبابُ فليس بالمُسْتَنْصِعِ",101,"ع",1,0],["لو نجا خائفٌ بفَرْطِ توقّي","ه لما فارق الحياةَ الهَلوعُ",102,"ع",1,0],["لَو نَطَقَ الناسُ أَو أَثنَوا بِعِلمِهِمُ","وَنَبَّهت عَن مَعالي دَهرِكَ الكُتُبُ",103,"ب",1,1],["لونان كالحرباء لون خلائق","ظهرت ولون حقائق هن المنى",104,"ن",2,0],["لَوْنُهَا الوَرْدُ رِيْحُهَا النَّدُّ تُغْنِيْ","كَ بِطِيْبِ النَّسِيْمِ عَنْ رَيْحَانِكْ",105,"ك",1,0],["لونُ الحَمانِن بل أَصْفَى وما خُلِقَت","من أَبيضِ الرِّيقِ بل مِنْ أَسْمَرِ اللَّعَسِ",106,"س",1,0],["لو نأَتْ عن فَلاتِها لأَحسَّ السِّ","رْبُ إِذ فارقَتْه نَقْصَ السِّرب",107,"ب",1,0]]}