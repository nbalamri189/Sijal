{"poems":[[53,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[55,"قد كنت أسلكت الرجاء سبيله","https://www.aldiwan.net/poem26048.html","الكامل"],[83,"يا من يحن إلى نجد وناديها","https://www.aldiwan.net/poem54234.html","البسيط"],[83,"يا من له الوجه الجميل إذا بدا","https://www.aldiwan.net/poem54263.html","الكامل"],[88,"شب الأسى في قلوب الشعب مستعرا","https://www.aldiwan.net/poem45044.html","البسيط"],[72,"يا من يعللني بكأس مدامة","https://www.aldiwan.net/poem18987.html","الكامل"],[72,"قد أمكنت فرص اللذات فانتهز","https://www.aldiwan.net/poem18999.html","البسيط"],[72,"كفوا حديث العذل عن مسمعي","https://www.aldiwan.net/poem19170.html","السريع"],[72,"لا تسل عن حديث دمعي لما","https://www.aldiwan.net/poem19391.html","الخفيف"],[72,"بلغا القاصدين أن الليالي","https://www.aldiwan.net/poem19529.html","الخفيف"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"خوان عيسى من نصف ترمسة","https://www.aldiwan.net/poem64572.html","المنسرح"],[51,"حببت درة القيان إلينا","https://www.aldiwan.net/poem66421.html","الخفيف"],[51,"غابن الحمد حقه مغبونه","https://www.aldiwan.net/poem66432.html","الخفيف"],[70,"وصاحب أصبح لي لائما","https://www.aldiwan.net/poem42857.html","السريع"],[78,"بركت تلوح وفي الفؤاد بلابل","https://www.aldiwan.net/poem14005.html","الكامل"],[89,"اني اذا حادثة غيرت","https://www.aldiwan.net/poem44724.html","السريع"],[85,"وسقيمة الأجفان لا من علة","https://www.aldiwan.net/poem7049.html","الكامل"],[56,"أصبح نحسا وكان سعدا","https://www.aldiwan.net/poem58606.html","مخلع البسيط"],[43,"أركائب الأحباب إن الأدمعا","https://www.aldiwan.net/poem9723.html","الكامل"],[62,"الحمد لله العلي القادر","https://www.aldiwan.net/poem52184.html","الرجز"],[45,"من رقبة أدع الزيارة عامدا","https://www.aldiwan.net/poem63545.html","الكامل"],[45,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[45,"أأفاق صب من هوى فأفيقا","https://www.aldiwan.net/poem65176.html","الطويل"],[45,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[45,"عند ظباء الرمل أو عينه","https://www.aldiwan.net/poem66816.html","السريع"],[2,"إن الخليط أجد البين فانفرقا","https://www.aldiwan.net/poem25062.html","البسيط"],[66,"دق شوال في قفا رمضان","https://www.aldiwan.net/poem39193.html","الخفيف"],[66,"حلت بمزجها المدام","https://www.aldiwan.net/poem39201.html","مجزوء الدوبيت"],[66,"سلبتنا فواتك اللفتات","https://www.aldiwan.net/poem40646.html","الخفيف"],[66,"إن ثنت عنكم الخطوب عناني","https://www.aldiwan.net/poem40972.html","الخفيف"],[80,"صادتك مهاة لم تصد","https://www.aldiwan.net/poem31480.html","المتدارك"],[69,"مهفهف القد إذا ما انثنى","https://www.aldiwan.net/poem28757.html","السريع"],[81,"عميد أصيب عن عمد","https://www.aldiwan.net/poem61406.html","الطويل"],[40,"قد رابه ولمثل ذلك رابه","https://www.aldiwan.net/poem42339.html","الكامل"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[75,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[75,"قل للمليك ابن الملوك الصيد","https://www.aldiwan.net/poem69088.html","الكامل"],[48,"ردا علي الكأس إنكما","https://www.aldiwan.net/poem62560.html","السريع"],[48,"جنان إن جدت يا مناي بما","https://www.aldiwan.net/poem65118.html","المنسرح"],[50,"لو نكح الليث في استه خضعا","https://www.aldiwan.net/poem62335.html","البسيط"],[50,"لا فجع إلا كما فجعت به","https://www.aldiwan.net/poem64832.html","المنسرح"],[46,"لو نطق الدهر في تصرفه","https://www.aldiwan.net/poem22235.html","المنسرح"],[46,"أنا صائم طول الحياة وإنما","https://www.aldiwan.net/poem22412.html","الكامل"],[46,"كم تنصح الدنيا ولا نقبل","https://www.aldiwan.net/poem23149.html","السريع"],[46,"دنياك والحمام في رتبة","https://www.aldiwan.net/poem23259.html","السريع"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140861",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39607","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55175","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55147","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54935","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54676","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43762","الكامل"],[106,"إلى القائد المظفر","https://www.poetsgate.com/ViewPoem.aspx?id=179595",""],[56,"على هَذِهِ كانَتْ تَدورُ النَّوائِبُ","https://www.poetsgate.com/ViewPoem.aspx?id=3536",""]],"verses":[["لَونُ الشَبينَةِ أَنصَلُ الأَلوانِ","وَالشَيبُ جُلُّ عَمائِمِ الفِتيانِ",0,"ن",1,1],["لَو نِلتَها كانَت لِقَلبِكَ مَقنَعاً","مِن كُلِّ شَيءٍ كائِنٍ ما كانا",1,"ن",2,0],["لون العقيق وقد سال العقيق دماً","بعطفه من كُماةٍ كرَّ يُدميها",2,"ي",3,0],["لون العشية ذهَّبَتْ صفحاتها","رقَّتْ وراقَتْ بهجةً وجمالا",3,"ل",2,0],["لو نقتري صحف التأريخ نسألها","عمّن يساويه في الدهر الذي غبرا",4,"ر",2,0],["لون المدام كما تراه وإنَّما","خدّ الذي أهواه لونٌ آخر",5,"ر",1,0],["لو نازعته بيوت الأولين على","لصيرَ الصدرَ منها موضع العجز",6,"ز",1,0],["لو نسيت عينايَ إنسانها","ما نسيت ليلى على الأجرع",7,"ع",1,0],["لوَّنته وأمطرته جفونٌ","جُرَّ منها الوادي وسالَ العقيق",8,"ق",1,0],["لو نسيت الفضائل ما كن","ت بناسٍ صنائع الأفضال",9,"ل",1,0],["لونُ ناجودِها إذا هي قامت","لون ياقوتها المضيءِ الثقابِ",10,"ب",1,0],["لو نُخِلَت بالحريرِ لانسربت","من خَلَلِ النسج غير محتبسَهْ",11,"س",2,0],["لونُها الدهر واحدٌ كجَني الور","د وإن كان وُدُّها ألوانا",12,"ن",2,0],["لو نجا من حِمامهِ جاعلُ الما","ل مَعاذاً له نجا قارونه",13,"ن",2,0],["لَو نَظَرَ الناسُ لِأَحوالِهِم","لَاشتَغَلَ الناسُ عَنِ الناسِ",14,"س",1,0],["لَونٌ كَسَتهُ صُفرَةٌ وَمَدامِعٌ","هَطَلَت سَحائِبُها وَجِسمٌ ناحِلُ",15,"ل",1,0],["لو نبتت لخالتي لحية","سميتها عندئذ خالي",16,"ي",1,0],["لو نلتُ أسباب السماء لحطني","أجل يحل لحينه موقوته",17,"ت",2,0],["لَوْ نَبَتَ الشَّعْرُ في وِصالٍ","لعادَ ذاكَ الوِصَالُ صَدّا",18,"د",2,0],["لَو نيطَتِ الدُنيا بِأُخرى مِثلِها","لَعَمَمنَها وَخَشينَ أَن لا تَقنَعا",19,"ع",2,0],["لونين صارا واحداً فازدوجا","بالسقي والسحق معاً فامتزجا",20,"ج",2,0],["لَو نافَسوكَ لَخالَسوكَ مِنَ النَدى","ما يُصلِحونَ بِهِ الزَمانَ الفاسِدا",21,"د",2,0],["لَو نالَ قَرنَ الشَمسِ حَلّوا بَيتَهُ","شَرَفاً عَطاءَ شَوامِخٍ وَرَواسِ",22,"س",1,0],["لَو نَفَّسَتهُ الخَيلُ لَفتَةَ ناظِرٍ","مَلَأَ البِلادَ زَلازِلاً وَفُتوقا",23,"ق",2,0],["لَو نُوَفّي ما لَنا في صاعِدٍ","لَصَعَدنا مِن عُلُوٍّ في الأُفُق",24,"ق",1,0],["لَوَّنَ مِن أَخلاقِهِ وَالهَوى","فيهِ عَلى كَثرَةِ تَلوينِهِ",25,"ن",2,0],["لَو نالَ حَيٌّ مِنَ الدُنيا بِمَنزِلَةٍ","أُفقَ السَماءِ لَنالَت كَفُّهُ الأُفُقا",26,"ق",2,0],["لَو نَظَمتُ النُجومَ شِعراً لَما كا","فَيتُ عَن بَعضِ ذَلِكَ الإِحسانِ",27,"ن",1,0],["لَو نادَمَها النَديمُ يوماً","ما أَعجَزَها لَهُ الكَلامُ",28,"م",1,0],["لَو نَظَمنا النُجومَ فيكَ عُقوداً","ما قَضَينا حُقوقَكَ الواجِباتِ",29,"ت",1,0],["لَو نَظَمتُ النجومَ شِعراً كَما كا","فيتُ عَنِ بَعضِ ذَلِكَ الإِحسانِ",30,"ن",1,0],["لونُ الياقوتِ وقسوتُهُ","في الوجنةِ منها والكَبدِ",31,"د",1,0],["لوْ نلتُ مِنْ خدَّيهِ تقبيلةً","تزيَّنَ الريحانُ بالوردِ",32,"د",1,0],["لَو نالَ الصَبا لَظى وَجدي","لَعادَت أَنفاسُها زَفرَه",33,"ه",1,0],["لَونٌ حَسِبتُ إِلى النِساءِ مُبَغَّضٌ","عِندَ النُصُولِ إِذا يَحِينُ خِضابُهُ",34,"ب",2,0],["لو ناسَبَتْ قَدْرَهُ آياتُهُ عِظَماً","أحْيا اسمُهُ حِينَ يُدْعَى دَارِسَ الرِّمَمِ",35,"م",1,0],["لو نازَعَ النَّجْمَ ما أعياه مَنزِلُهُ","أو نازَلَ القَدرَ المقدورَ لم يُهَل",36,"ل",1,0],["لو نَجا أشرفُ شيءٍ قَدَراً","فازَتِ الشمسُ بتخليد الأبد",37,"د",1,0],["لو نابَ عنها فصدُ شيءٍ غيرِهَا","لوَقيْتُ مِعصَمَها بحبل وريدي",38,"د",2,0],["لَو نِلتُما ما نِلتُ ما مُزِجَت","إِلّا بِدَمعِكُما مِنَ الوَجدِ",39,"د",1,0],["لَو نَظَرَت عَينُهُ إِلى حَجَرٍ","وَلَّدَ فيهِ فُتورُها سَقَما",40,"م",2,0],["لَو نُكِحَ اللَيثُ في اِستِهِ خَضَعا","وَماتَ جوعاً وَلَم يَنَل طَمَعا",41,"ع",2,1],["لَو نالَ خُلداً مِن قَبلِهِ أَحَدٌ","مَدَّت إِلى الخُلدِ كَفُّهُ سَبَبا",42,"ب",2,0],["لَو نَطَقَ الدَهرُ في تَصَرُّفِهِ","لَعَدَّنا كُلُّنا مِنَ التَفثِ",43,"ث",1,1],["لَونانِ مِن لَيلٍ وَصُبحٍ لَوَّنا","شَعري وَأَضعَفَني الزَمانُ الأَيِّدُ",44,"د",1,0],["لَو نَطَقَ الدَهرُ هَجا أَهلَهُ","كَأَنَّهُ الرومِيُّ أَو دِعبِلُ",45,"ل",1,0],["لَو نُخِلَ العَيشُ لَما حَصَّلَت","شَيئاً سِوى المَوتِ يَدُ الناخِلِ",46,"ل",1,0],["لو نيطت الدنيا بأخرى مثلها","لعممنها وخشين ألا تقنعا",47,"ع",2,0],["لونٌ جَلَتْ فيه الصحارَى سحرَها","تحت النجوم الغُرِّ والأنداءِ",48,"ا",2,0],["لَوْنَاهُ حُسْنٌ لاَ فرْقَ فِيهِ","وَالنَّاسُ فِيهِ حِزْبَانِ مَيْلاَ",49,"ل",2,0],["لَوْ نُضِّدَتْ أَوْرَاقُهُ مِنْ كَثْرَة","طَالَتْ عَلَى مُتَطَاوِلِ الأَجْبَالِ",50,"ل",1,0],["لَوْنَها ظَاهِرُ انْتِسَابٍ إِلى","الخَمْرِ لَهُ مِثْلُ فِعْلِهَا فِي الصدُورِ",51,"ر",1,0],["لوْنَانِ أَوْ هُوَ لَوْنٌ","فِيهَا بَدِيعُ امْتِزَاجِ",52,"ج",1,0],["لَو ناصَ نصّ الفِقهَ قَبلَ بُلوغِهِ","هَيهاتَ ما أَهلُ النَجابَةِ نُوَّصا",53,"ص",2,0],["لو ناقَشَ القومُ ضوْءَ الشمس، لاختلفوا","حتى تشتَّت فيه الرأيُ وانشعبا",54,"ب",2,0],["لو کنَّ يَدِي كانت شفاءَكَ أَوْ دَمي","دمَ القلبِ حتى يقضبَ القلبَ قاضبُ",55,"ب",1,0]]}