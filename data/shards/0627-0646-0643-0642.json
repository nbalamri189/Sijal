{"poems":[[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147504","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64066","السريع"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46510","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53244","السريع"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126193","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136038","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58179","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120320","السريع"],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""]],"verses":[["إنك قن لمليك حوى ال","ملك فلا تعصم منه القنن",0,"ن",1,0],["أَنَّك قد أصبحتَ ذا لحيةٍ","تجلسُ في صفِّ المساليف",1,"ف",1,0],["إِنكَ قَد مَلَكتَني فَأَسجح","وَامح حَديث غَدرك المستقبح",2,"ح",1,0],["أنك قد ألبستني فروة","ذات غشاء ردنها مذهب",3,"ب",1,0],["أنّك قد أردتَ أن تَعَرَّفَ","الىّ فى الأشياء كلاًّ فكفى",4,"ف",2,0],["إنك قد بنيت للسماءِ","ولا لها العَمَد في الهواءِ",5,"ا",2,1],["إنك قد أوْسَعْتَهُ جوابَا","حينَا وقد أوجعتَهُ عِتابا",6,"ب",2,0],["انك قد اجديت في خدمتي","ومنك حال شئتها تستجاد",7,"د",1,0],["إِنك قَدير وَقادر إِنكَ تَفكنا","مِن غَير بابك مالنا مَلجاه",8,"ا",2,0]]}