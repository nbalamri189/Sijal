{"poems":[[53,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[53,"ألا يا لقومي للخطوب الطوارق","https://www.aldiwan.net/poem29952.html","الطويل"],[53,"بود الرذايا أنها في السوابق","https://www.aldiwan.net/poem29954.html","الطويل"],[63,"ولادة في بني عجل تزان بها","https://www.aldiwan.net/poem45849.html","البسيط"],[3,"أطوي فيافي الفلا والليلُ مُعتَكِرُ","https://www.aldiwan.net/poem156.html",""],[88,"قل لسلمان بعدما كان حرا","https://www.aldiwan.net/poem44799.html","الخفيف"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[23,"لقد كان قيس في اللئام مرددا","https://www.aldiwan.net/poem21473.html","الطويل"],[85,"يود الناس لو يدورن","https://www.aldiwan.net/poem7358.html","مجزوء الوافر"],[28,"وقد مد حولي من المالكين","https://www.aldiwan.net/poem5044.html","المتقارب"],[80,"متى ينال لديكم ما يؤمله","https://www.aldiwan.net/poem31341.html","البسيط"],[31,"أمن آل نعم أنت غاد فمبكر","https://www.aldiwan.net/poem42551.html","الطويل"],[39,"نبيت تميما تجتدي حرب طيئ","https://www.aldiwan.net/poem53756.html","الطويل"],[40,"هاج الفؤاد وأمسى الحلم قد عزبا","https://www.aldiwan.net/poem42289.html","البسيط"],[48,"أمنك للمكتوم اظهار","https://www.aldiwan.net/poem63369.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54563","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/142341","الرجز"],[39,"نبيتُ تميماً تجتدي حربَ طيِّىء ٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=4266",""],[31,"أَمِنْ آلِ نُعْمِ أَنْتَ غَادٍ فَمُبْكِرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18852&r=&rc=115",""]],"verses":[["وَلَأَدخُلَنَّ عَلى النِساءِ خُدورَها","وَاليَومَ لَيلٌ بِالعَجاجَةِ أَليَلُ",0,"ل",1,0],["وَلا دارَ إِلّا سَوفَ يُجلى قَطينُها","عَلى نَعقِ غِربانِ الخُطوبِ النَواعِقِ",1,"ق",1,0],["وَلا دَبَّرَت سُمرَ القَنا كَفُّ فارِسٍ","وَلا مُدَّ في رِزقِ المُنى باعُ رازِقِ",2,"ق",1,0],["ولادَةٌ في بَني عجلٍ تُزان بها","كَما تُزان عتاقُ الخَيْلِ بالغُرَر",3,"ر",1,1],["وَلا دِيارُهُمُ بِالأَهلِ آنِسَةٌ","يَأوي الغُرابُ بِها وَالذِئبُ وَالنَمِرُ",4,"ر",1,0],["ولأدمون من ذويه رجال","كلهم في ظهورنا أوزار",5,"ر",1,0],["ولا دَوَادٍ أُذِلَّ منهن لل","وِلدَة ما جَرَّروا وما سَحَبوا",6,"ب",3,0],["وِلادَةُ سوءٍ مِن سُمَيَّةَ إِنَّها","أُمَيَّةُ سوءٍ مَجدُها غَيرُ تالِدِ",7,"د",1,0],["ولا دست على حوت","ولا أغرقت عصفورا",8,"ر",2,0],["وَلا دافَعوا لَيلَةَ الصارِخي","نَ لَهُم صَوتَ ذي غُرَّةٍ مَوقِدِ",9,"د",1,0],["ولا درى أن سهم الخيف يقصدُهُ","حتَّى رَأَى ساحرَ الأَلحاظِ يُرْسِلُهُ",10,"ل",2,0],["وَلا دَلوَ إِلّا القَعبُ كانَ رِشاءَهُ","إِلى الماءِ نِسعٌ وَالأَديمُ المُضَفَّرُ",11,"ر",1,0],["وَلا دَينَ لِلطائِيِّ يُلوى قَضاؤُهُ","إِذا طَيِّئٌ أَلقَت جَفونَ المناصِلِ",12,"ل",1,0],["وَلا دَعَت شَجوَها يَوماً مُطَوَّقَةٌ","إِلّا تَرَقرَقَ ماءُ العَينِ فَاِنسَكَبا",13,"ب",2,0],["وَلا دَلوحٌ أَلِفَتهُ الصَبا","لَدنٌ عَلى المَلمَسِ خَوّارُ",14,"ر",1,0],["وَلأَدُعُوَنَّ مَمَالِكِي وَشُعُوبَهَا","بِاسْمِي فَيُجْمَعُ شَمْلُهَا المُتَشَعَّبُ",15,"ب",1,0],["ولا درت وجنتها","من خجل تبدلا",16,"ل",2,0],["ولاَ دَيْنَ لِلطَّائِيِّ يُلْوَى قَضَاؤُهُ","إذا طيِّىء ٌ ألقَتْ جفونَ المناصلِ",17,"ل",1,0],["وَلاَ دَلْوَ إلاَّ القَعْبُ كَانَ رِشاءَهُ","إلَى الماءِ نِسْع والأَدِيمُ والمُضَفَّرُ",18,"ر",1,0]]}