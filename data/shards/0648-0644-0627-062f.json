{"poems":[[53,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[53,"ألا يا لقومي للخطوب الطوارق","https://www.aldiwan.net/poem29952.html","الطويل"],[53,"بود الرذايا أنها في السوابق","https://www.aldiwan.net/poem29954.html","الطويل"],[63,"ولادة في بني عجل تزان بها","https://www.aldiwan.net/poem45849.html","البسيط"],[3,"أطوي فيافي الفلا والليلُ مُعتَكِرُ","https://www.aldiwan.net/poem156.html",""],[88,"قل لسلمان بعدما كان حرا","https://www.aldiwan.net/poem44799.html","الخفيف"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[23,"لقد كان قيس في اللئام مرددا","https://www.aldiwan.net/poem21473.html","الطويل"],[85,"يود الناس لو يدورن","https://www.aldiwan.net/poem7358.html","مجزوء الوافر"],[28,"وقد مد حولي من المالكين","https://www.aldiwan.net/poem5044.html","المتقارب"],[80,"متى ينال لديكم ما يؤمله","https://www.aldiwan.net/poem31341.html","البسيط"],[31,"أمن آل نعم أنت غاد فمبكر","https://www.aldiwan.net/poem42551.html","الطويل"],[39,"نبيت تميما تجتدي حرب طيئ","https://www.aldiwan.net/poem53756.html","الطويل"],[40,"هاج الفؤاد وأمسى الحلم قد عزبا","https://www.aldiwan.net/poem42289.html","البسيط"],[48,"أمنك للمكتوم اظهار","https://www.aldiwan.net/poem63369.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54563","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/142341","الرجز"],[39,"نبيتُ تميماً تجتدي حربَ طيِّىء ٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=4266",""],[31,"أَمِنْ آلِ نُعْمِ أَنْتَ غَادٍ فَمُبْكِرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18852&r=&rc=115",""],[143,"أبى الله إلا أن تجود وتنعما","https://www.aldiwan.net/poem58433.html","الطويل"],[144,"أما الفراق فقد عاصيته فأبى","https://www.aldiwan.net/poem11718.html","البسيط"],[144,"بجيد علاك مدحي كل آن","https://www.aldiwan.net/poem11828.html","الوافر"],[161,"أبشر ببشرى بابها قد فتحا","https://www.aldiwan.net/poem58772.html","الرجز"],[161,"ما صالحت داعي الهوى مقلتي","https://www.aldiwan.net/poem58927.html","السريع"],[161,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[170,"أمارات سر الحب ما لا يكتم","https://www.aldiwan.net/poem1662.html",""],[228,"يا من هواه أعزه وأذلني","https://www.aldiwan.net/poem34055.html","عموديه"],[230,"كل سيوف الموت عضب حسام","https://www.aldiwan.net/poem50782.html","السريع"],[236,"أبثكم أني مشوق بكم صب","https://www.aldiwan.net/poem32178.html","الطويل"],[271,"أرى المرء يولد للنعمة","https://www.aldiwan.net/poem35048.html","المتقارب"],[271,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[271,"هو الملك تبنيه الجيوش الخضارم","https://www.aldiwan.net/poem35646.html","الطويل"],[271,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[276,"هو الفتح بعد الفتح يأتي مسوغا","https://www.aldiwan.net/poem25482.html","الطويل"],[276,"أوائل فتح ما لهن أواخر","https://www.aldiwan.net/poem25552.html","الطويل"],[283,"إلمام طيف شنيب الثغر ألماه","https://www.aldiwan.net/poem32309.html","البسيط"],[306,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[321,"يا بدع الزمان يا نخبة العصر","https://www.aldiwan.net/poem67186.html","الخفيف"],[350,"مذ أفقرت ممن أحب الأربع","https://www.aldiwan.net/poem15781.html","الكامل"],[365,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[367,"برذوننا اليوم ما به عجب","https://www.aldiwan.net/poem17361.html","المنسرح"],[372,"أرى في عراصي راكبا مترنما","https://www.aldiwan.net/poem57161.html","الطويل"],[378,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[381,"جوانحه جمر ومدمعه سكب","https://www.aldiwan.net/poem48813.html","الطويل"],[407,"خليلي هل من رقدة أستعيرها","https://www.aldiwan.net/poem50173.html","الطويل"],[417,"تبين حق للعباد وباطل","https://www.aldiwan.net/poem53998.html","الطويل"],[417,"ليهنك ما بلغت من الأماني","https://www.aldiwan.net/poem54133.html","الوافر"],[433,"قولوا لنجم الدين بل بدره","https://www.aldiwan.net/poem12649.html","السريع"],[440,"اقبل ثناء وشكرا","https://www.aldiwan.net/poem34832.html","المجتث"],[440,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"],[459,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[459,"أدرك ما شاء غلام فطنا","https://www.aldiwan.net/poem55840.html","الرجز"],[459,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[465,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[478,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[496,"ألم ترني فارقت قيسي وخندفي","https://www.aldiwan.net/poem9856.html","الطويل"],[506,"تائية القافلة","https://www.aldiwan.net/poem27889.html","البسيط"],[515,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[552,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[552,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[552,"أهاجك ذكر منهم ووساوس","https://www.aldiwan.net/poem47756.html","الطويل"],[552,"ألا يا قوم للقدر المتاح","https://www.aldiwan.net/poem47892.html","الوافر"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[564,"هو الأجل الموقوت لا يتخلف","https://www.aldiwan.net/poem13603.html","الطويل"]],"verses":[["وَلَأَدخُلَنَّ عَلى النِساءِ خُدورَها","وَاليَومَ لَيلٌ بِالعَجاجَةِ أَليَلُ",0,"ل",1,0],["وَلا دارَ إِلّا سَوفَ يُجلى قَطينُها","عَلى نَعقِ غِربانِ الخُطوبِ النَواعِقِ",1,"ق",1,0],["وَلا دَبَّرَت سُمرَ القَنا كَفُّ فارِسٍ","وَلا مُدَّ في رِزقِ المُنى باعُ رازِقِ",2,"ق",1,0],["ولادَةٌ في بَني عجلٍ تُزان بها","كَما تُزان عتاقُ الخَيْلِ بالغُرَر",3,"ر",1,1],["وَلا دِيارُهُمُ بِالأَهلِ آنِسَةٌ","يَأوي الغُرابُ بِها وَالذِئبُ وَالنَمِرُ",4,"ر",1,0],["ولأدمون من ذويه رجال","كلهم في ظهورنا أوزار",5,"ر",1,0],["ولا دَوَادٍ أُذِلَّ منهن لل","وِلدَة ما جَرَّروا وما سَحَبوا",6,"ب",3,0],["وِلادَةُ سوءٍ مِن سُمَيَّةَ إِنَّها","أُمَيَّةُ سوءٍ مَجدُها غَيرُ تالِدِ",7,"د",1,0],["ولا دست على حوت","ولا أغرقت عصفورا",8,"ر",2,0],["وَلا دافَعوا لَيلَةَ الصارِخي","نَ لَهُم صَوتَ ذي غُرَّةٍ مَوقِدِ",9,"د",1,0],["ولا درى أن سهم الخيف يقصدُهُ","حتَّى رَأَى ساحرَ الأَلحاظِ يُرْسِلُهُ",10,"ل",2,0],["وَلا دَلوَ إِلّا القَعبُ كانَ رِشاءَهُ","إِلى الماءِ نِسعٌ وَالأَديمُ المُضَفَّرُ",11,"ر",1,0],["وَلا دَينَ لِلطائِيِّ يُلوى قَضاؤُهُ","إِذا طَيِّئٌ أَلقَت جَفونَ المناصِلِ",12,"ل",1,0],["وَلا دَعَت شَجوَها يَوماً مُطَوَّقَةٌ","إِلّا تَرَقرَقَ ماءُ العَينِ فَاِنسَكَبا",13,"ب",2,0],["وَلا دَلوحٌ أَلِفَتهُ الصَبا","لَدنٌ عَلى المَلمَسِ خَوّارُ",14,"ر",1,0],["وَلأَدُعُوَنَّ مَمَالِكِي وَشُعُوبَهَا","بِاسْمِي فَيُجْمَعُ شَمْلُهَا المُتَشَعَّبُ",15,"ب",1,0],["ولا درت وجنتها","من خجل تبدلا",16,"ل",2,0],["ولاَ دَيْنَ لِلطَّائِيِّ يُلْوَى قَضَاؤُهُ","إذا طيِّىء ٌ ألقَتْ جفونَ المناصلِ",17,"ل",1,0],["وَلاَ دَلْوَ إلاَّ القَعْبُ كَانَ رِشاءَهُ","إلَى الماءِ نِسْع والأَدِيمُ والمُضَفَّرُ",18,"ر",1,0],["ولا دجتِ الظلماءُ إلا أعرتَها","شمائَلك الغُرَّ اللوامعَ أنجُما",19,"م",2,0],["وَلادَتانِ لَهُ مِن عامِرٍ قَضَتا","أَن يَشرُفَ الناسَ خالاً فاقَهُم وَأَبا",20,"ب",2,0],["وَلا دَجَتِ البَسيطَةُ بَل أَضاءَت","بِمَجدِكَ ما أَضاءَ النَيِّرانِ",21,"ن",1,0],["ولا دعاك معشرٌ في حاجةٍ","إلا حملت عنهم ما قدحا",22,"ح",2,0],["ولا درت أن الذي فاتها","تدركه في هذه المدة",23,"ه",1,0],["ولا دعانا إلى شيء نعاب به","ولا إلى فعله تزرى بذي حسب",24,"ب",1,0],["وَلا دينَ إِلّا ما اِرتَضاهُ وَقالَهُ","وَحَسبُ اِمرِئٍ يَأباهُ دِيناً جَهَنَّمُ",25,"م",1,0],["ولأدعين عليك في جنح الدجى","فعساك تبلى مثل ما أبليتني",26,"ن",2,0],["ولا دعاها التَّيهُ يوماً إلى","أن تُظهِر الدَّلَّ وتُبِدي المَلام",27,"م",1,0],["وَلا دونَها بيدٌ يُخاضُ غِمارُها","قِفارٌ وَلا طَعنٌ يُخافُ وَلا ضَربُ",28,"ب",1,0],["ولا دولةٌ لِذَوي فتنةٍ","ولا فطنةٌ لذوي بطنة",29,"ه",1,0],["ولا دنّسوا أرضاً ولا سفكوا دماً","ولا غصبوا إرثاً بأيدٍ أثيمة",30,"ه",1,0],["ولا دولةٌ تُرجى وتُخشى سوى التي","على الجيشِ والأسطولِ منها دَعائم",31,"م",1,0],["ولاّدةُ استنزفت أسمى عواطِفهِ","فخلّدَ الحبَّ إنشاداً وتدوينا",32,"ن",2,0],["وَلا دَلَفَتْ أُسْدُ الهِيَاج لِمِثْلِها","بِأَيْمَانِها مِثْلُ الأسَاوِدِ لُدَّغا",33,"غ",2,0],["ولا دَلَفَتْ للحرْبِ أُسدٌ خَوادرٌ","تَطيرُ بِها في النقعِ فُتخٌ كَواسِرُ",34,"ر",1,0],["وَلا دَعاهُ أَخو حاجٍ يُؤَمِّلُهُ","إِلّا بِما يَرتَجيهِ مِنهُ لَبّاهُ",35,"ا",2,0],["وَلا داني حِمى ريحٍ ونجمٍ","لِصولِ علاك حيٌّ أو ركودُ",36,"د",1,0],["وَلِإِدراكِ ما تَغيبُ عَنّا","أَسعِفونا وَحَقَّكُم بِالبَيانِ",37,"ن",1,0],["وَلِأَدمِعٍ تَربو بِوابِلِها الرُبى","وَبِها غَليلُ مُفيضِها لا يَنقَعُ",38,"ع",1,0],["ولا دُرُّ دَمْعي خِيفةَ النَّهبِ ساعةً","غَدتْ خلفَ بابٍ لي من العينِ مُرْتَج",39,"ج",1,0],["وَلا دَهاكَ التَقبيعُ زاحِرُهُ","وَلا عَناكَ التَقريبُ وَالخَبَبُ",40,"ب",1,0],["ولا دِيَّة عَن قَومهِ تَحمِلينَها","إِذا الدَّم أَمسى حَملُه يَحقِن الدِّما",41,"م",2,0],["ولا دنسٌ إلّا وفيها مطهَّرٌ","ولا طاهرٌ إلّا وفيها معفَّف",42,"ف",1,0],["وَلا دَهرُهُ يَرثي وَلا أَلفَهُ يَفي","وَلا دَمعَهُ يَرقى وَلا نارهُ تَخبو",43,"ب",2,0],["وَلا دَولَة إِلّا وَيَهتَز تاجها","وَيرتَجُّ مِن شَوق إِلَيهِ سَريرُها",44,"ر",3,0],["ولا دَنَّسَ العرضَ النقيَّ بشاهدٍ","من العار لم يغسله من بعد غاسل",45,"ل",1,0],["ولا داريتَ أو ماريتَ قوماً","برفعة منصبٍ وعلوِ شان",46,"ن",1,0],["ولا دهاناً لو يعاني به الص","خْرُ للانَ الصخرُ في مسِّهِ",47,"س",2,0],["ولا دعوتُكَ سِرّاً","إِلّا وَجَدْتُكَ سِتْرَا",48,"ر",2,0],["ولا دَلَّ الزَّمانُ عَلَيْهِ حَتَّى","حَسِبْتُ عِدَايَ قَدْ مَاتُوا بِدائِي",49,"ا",2,0],["ولادتي بينكم وقلبي","في يعرُبٍ فاعجبوا لذينِ",50,"ن",1,0],["ولا درَتْ أيَّ رجالِ عصمةٍ","جعلتُهم منها لظهري جُنَنا",51,"ن",2,0],["ولا دخيلَ الظهر في صدرها","مدلساً بالنسب الملصَقِ",52,"ق",1,0],["ولا دهاك الزمان من رجلٍ","للدهر حسنٌ بهِ وتبجيل",53,"ل",1,0],["ولا دموعي بعدَ توديعِهم","تَرْقا ولا نارُ الهوى تَبرُدُ",54,"د",1,0],["ولادته في عالم دون قدره","وفي زمن مثل اسمه لا يقادره",55,"ر",2,0],["ولادةٌ فطفولةٌ فإدراكٌ","ففُرقةٌ ليس مِنْ ورائِها مَتُّ",56,"ت",1,0],["ولا درَسَتْ نوادي الحُسنِ منهم","ولا فصمَ البِلى منها سِوارا",57,"ر",2,0],["ولا دافعٍ شرَّ ما حاذروه","ولا ناهضٍ لهم حاملِ",58,"ل",1,0],["ولا دموعٌ خَلْفَ مستوفِزٍ","تجري ولا قلبٌ له يخفقُ",59,"ق",1,0],["ولا دَرَستْ تلك الرّسومَ مُلِمّةٌ","ولا رَمَسَتْ تلكَ الطّلولَ الروّامسُ",60,"س",1,0],["وَلا دَنِسَتْ لَهُ أُزُرٌ بعارٍ","ولا عَلِقَتْ له راحٌ براحِ",61,"ح",1,0],["ولا دين إلا حبها عند أهلها","فكم نحوها من ساجد وهو راكع",62,"ع",1,0],["وَلا دارُ سُكنى وَهيَ قَصرٌ مُشَيَّدٌ","فَكَيفَ وَهَذا قاعُها وَهوَ صَفصَفُ",63,"ف",1,0]]}