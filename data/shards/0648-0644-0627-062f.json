ج","https://www.poetsgate.com/ViewPoem.aspx?id=191056",""],[5277,"سفيرةُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=191933",""],[5277,"ماتت(ثريّا)","https://www.poetsgate.com/ViewPoem.aspx?id=193286",""],[5277,"حياءُ الحرائر","https://www.poetsgate.com/ViewPoem.aspx?id=205190",""],[5397,"تخادعك الدنيا وتبدي اغترارها","https://www.poetsgate.com/ViewPoem.aspx?id=157907",""],[5431,"أخي الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=183053",""],[5431,"بكل اختلاجات القلوب لعالم ...","https://www.poetsgate.com/ViewPoem.aspx?id=191588",""],[5573,"ارموز خط وبعد شط ودلو بير وعمق طي","https://www.poetsgate.com/ViewPoem.aspx?id=200172",""],[5573,"الا هُبي بغيثكِ فامطرينا","https://www.poetsgate.com/ViewPoem.aspx?id=215491",""],[5577,"وألوذ من عجم الشعور إليها","https://www.poetsgate.com/ViewPoem.aspx?id=177006",""],[5596,"سمائل","https://www.poetsgate.com/ViewPoem.aspx?id=205672",""],[5616,"غيره","https://www.poetsgate.com/ViewPoem.aspx?id=203457",""],[5691,"فقير...!","https://www.poetsgate.com/ViewPoem.aspx?id=207554",""],[5732,"انادم اللي رفقته ترفع الراس","https://www.poetsgate.com/ViewPoem.aspx?id=177830",""],[5756,"الدعاء المستجاب","https://www.poetsgate.com/ViewPoem.aspx?id=5381",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""],[6142,"ولادة المرتضى لم يحوها أحد","https://www.poetsgate.com/ViewPoem.aspx?id=155710",""],[6152,"ولاّدة العصر","https://www.poetsgate.com/ViewPoem.aspx?id=203139",""],[6185,"بوح !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87022&r=&rc=8",""],[5464,"يا أخت هارون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66201&r=&rc=20",""],[6308,"وتسألُ الدار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87722&r=&rc=0",""],[6328,"الطريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84423&r=&rc=21",""],[6344,"غُرباء يُعاندون الخطوات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87965&r=&rc=5",""]],"verses":[["وَلَأَدخُلَنَّ عَلى النِساءِ خُدورَها","وَاليَومَ لَيلٌ بِالعَجاجَةِ أَليَلُ",0,"ل",1,0],["وَلا دارَ إِلّا سَوفَ يُجلى قَطينُها","عَلى نَعقِ غِربانِ الخُطوبِ النَواعِقِ",1,"ق",1,0],["وَلا دَبَّرَت سُمرَ القَنا كَفُّ فارِسٍ","وَلا مُدَّ في رِزقِ المُنى باعُ رازِقِ",2,"ق",1,0],["ولادَةٌ في بَني عجلٍ تُزان بها","كَما تُزان عتاقُ الخَيْلِ بالغُرَر",3,"ر",1,1],["وَلا دِيارُهُمُ بِالأَهلِ آنِسَةٌ","يَأوي الغُرابُ بِها وَالذِئبُ وَالنَمِرُ",4,"ر",1,0],["ولأدمون من ذويه رجال","كلهم في ظهورنا أوزار",5,"ر",1,0],["ولا دَوَادٍ أُذِلَّ منهن لل","وِلدَة ما جَرَّروا وما سَحَبوا",6,"ب",3,0],["وِلادَةُ سوءٍ مِن سُمَيَّةَ إِنَّها","أُمَيَّةُ سوءٍ مَجدُها غَيرُ تالِدِ",7,"د",1,0],["ولا دست على حوت","ولا أغرقت عصفورا",8,"ر",2,0],["وَلا دافَعوا لَيلَةَ الصارِخي","نَ لَهُم صَوتَ ذي غُرَّةٍ مَوقِدِ",9,"د",1,0],["ولا درى أن سهم الخيف يقصدُهُ","حتَّى رَأَى ساحرَ الأَلحاظِ يُرْسِلُهُ",10,"ل",2,0],["وَلا دَلوَ إِلّا القَعبُ كانَ رِشاءَهُ","إِلى الماءِ نِسعٌ وَالأَديمُ المُضَفَّرُ",11,"ر",1,0],["وَلا دَينَ لِلطائِيِّ يُلوى قَضاؤُهُ","إِذا طَيِّئٌ أَلقَت جَفونَ المناصِلِ",12,"ل",1,0],["وَلا دَعَت شَجوَها يَوماً مُطَوَّقَةٌ","إِلّا تَرَقرَقَ ماءُ العَينِ فَاِنسَكَبا",13,"ب",2,0],["وَلا دَلوحٌ أَلِفَتهُ الصَبا","لَدنٌ عَلى المَلمَسِ خَوّارُ",14,"ر",1,0],["وَلأَدُعُوَنَّ مَمَالِكِي وَشُعُوبَهَا","بِاسْمِي فَيُجْمَعُ شَمْلُهَا المُتَشَعَّبُ",15,"ب",1,0],["ولا درت وجنتها","من خجل تبدلا",16,"ل",2,0],["ولا داهنوا في الدين من أجل مطمع","يسيل به أنف من الكبر وارم",17,"م",1,0],["ولاَ دَيْنَ لِلطَّائِيِّ يُلْوَى قَضَاؤُهُ","إذا طيِّىء ٌ ألقَتْ جفونَ المناصلِ",18,"ل",1,0],["وَلاَ دَلْوَ إلاَّ القَعْبُ كَانَ رِشاءَهُ","إلَى الماءِ نِسْع والأَدِيمُ والمُضَفَّرُ",19,"ر",1,0],["ولا دجتِ الظلماءُ إلا أعرتَها","شمائَلك الغُرَّ اللوامعَ أنجُما",20,"م",2,0],["وَلادَتانِ لَهُ مِن عامِرٍ قَضَتا","أَن يَشرُفَ الناسَ خالاً فاقَهُم وَأَبا",21,"ب",2,0],["وَلا دَجَتِ البَسيطَةُ بَل أَضاءَت","بِمَجدِكَ ما أَضاءَ النَيِّرانِ",22,"ن",1,0],["ولا دعاك معشرٌ في حاجةٍ","إلا حملت عنهم ما قدحا",23,"ح",2,0],["ولا درت أن الذي فاتها","تدركه في هذه المدة",24,"ه",1,0],["ولا دعانا إلى شيء نعاب به","ولا إلى فعله تزرى بذي حسب",25,"ب",1,0],["وَلا دينَ إِلّا ما اِرتَضاهُ وَقالَهُ","وَحَسبُ اِمرِئٍ يَأباهُ دِيناً جَهَنَّمُ",26,"م",1,0],["ولأدعين عليك في جنح الدجى","فعساك تبلى مثل ما أبليتني",27,"ن",2,0],["ولا دعاها التَّيهُ يوماً إلى","أن تُظهِر الدَّلَّ وتُبِدي المَلام",28,"م",1,0],["وَلا دونَها بيدٌ يُخاضُ غِمارُها","قِفارٌ وَلا طَعنٌ يُخافُ وَلا ضَربُ",29,"ب",1,0],["ولا دولةٌ لِذَوي فتنةٍ","ولا فطنةٌ لذوي بطنة",30,"ه",1,0],["ولا دنّسوا أرضاً ولا سفكوا دماً","ولا غصبوا إرثاً بأيدٍ أثيمة",31,"ه",1,0],["ولا دولةٌ تُرجى وتُخشى سوى التي","على الجيشِ والأسطولِ منها دَعائم",32,"م",1,0],["ولاّدةُ استنزفت أسمى عواطِفهِ","فخلّدَ الحبَّ إنشاداً وتدوينا",33,"ن",2,0],["وَلا دَلَفَتْ أُسْدُ الهِيَاج لِمِثْلِها","بِأَيْمَانِها مِثْلُ الأسَاوِدِ لُدَّغا",34,"غ",2,0],["ولا دَلَفَتْ للحرْبِ أُسدٌ خَوادرٌ","تَطيرُ بِها في النقعِ فُتخٌ كَواسِرُ",35,"ر",1,0],["وَلا دَعاهُ أَخو حاجٍ يُؤَمِّلُهُ","إِلّا بِما يَرتَجيهِ مِنهُ لَبّاهُ",36,"ا",2,0],["وَلا داني حِمى ريحٍ ونجمٍ","لِصولِ علاك حيٌّ أو ركودُ",37,"د",1,0],["وَلِإِدراكِ ما تَغيبُ عَنّا","أَسعِفونا وَحَقَّكُم بِالبَيانِ",38,"ن",1,0],["وَلِأَدمِعٍ تَربو بِوابِلِها الرُبى","وَبِها غَليلُ مُفيضِها لا يَنقَعُ",39,"ع",1,0],["ولا دُرُّ دَمْعي خِيفةَ النَّهبِ ساعةً","غَدتْ خلفَ بابٍ لي من العينِ مُرْتَج",40,"ج",1,0],["وَلا دَهاكَ التَقبيعُ زاحِرُهُ","وَلا عَناكَ التَقريبُ وَالخَبَبُ",41,"ب",1,0],["ولا دِيَّة عَن قَومهِ تَحمِلينَها","إِذا الدَّم أَمسى حَملُه يَحقِن الدِّما",42,"م",2,0],["ولا دنسٌ إلّا وفيها مطهَّرٌ","ولا طاهرٌ إلّا وفيها معفَّف",43,"ف",1,0],["وَلا دَهرُهُ يَرثي وَلا أَلفَهُ يَفي","وَلا دَمعَهُ يَرقى وَلا نارهُ تَخبو",44,"ب",2,0],["وَلا دَولَة إِلّا وَيَهتَز تاجها","وَيرتَجُّ مِن شَوق إِلَيهِ سَريرُها",45,"ر",3,0],["ولا دَنَّسَ العرضَ النقيَّ بشاهدٍ","من العار لم يغسله من بعد غاسل",46,"ل",1,0],["ولا داريتَ أو ماريتَ قوماً","برفعة منصبٍ وعلوِ شان",47,"ن",1,0],["ولا دهاناً لو يعاني به الص","خْرُ للانَ الصخرُ في مسِّهِ",48,"س",2,0],["ولا دعوتُكَ سِرّاً","إِلّا وَجَدْتُكَ سِتْرَا",49,"ر",2,0],["ولا دَلَّ الزَّمانُ عَلَيْهِ حَتَّى","حَسِبْتُ عِدَايَ قَدْ مَاتُوا بِدائِي",50,"ا",2,0],["ولادتي بينكم وقلبي","في يعرُبٍ فاعجبوا لذينِ",51,"ن",1,0],["ولا درَتْ أيَّ رجالِ عصمةٍ","جعلتُهم منها لظهري جُنَنا",52,"ن",2,0],["ولا دخيلَ الظهر في صدرها","مدلساً بالنسب الملصَقِ",53,"ق",1,0],["ولا دهاك الزمان من رجلٍ","للدهر حسنٌ بهِ وتبجيل",54,"ل",1,0],["ولا دموعي بعدَ توديعِهم","تَرْقا ولا نارُ الهوى تَبرُدُ",55,"د",1,0],["ولادته في عالم دون قدره","وفي زمن مثل اسمه لا يقادره",56,"ر",2,0],["ولادةٌ فطفولةٌ فإدراكٌ","ففُرقةٌ ليس مِنْ ورائِها مَتُّ",57,"ت",1,0],["ولا درَسَتْ نوادي الحُسنِ منهم","ولا فصمَ البِلى منها سِوارا",58,"ر",2,0],["ولا دافعٍ شرَّ ما حاذروه","ولا ناهضٍ لهم حاملِ",59,"ل",1,0],["ولا دموعٌ خَلْفَ مستوفِزٍ","تجري ولا قلبٌ له يخفقُ",60,"ق",1,0],["ولا دَرَستْ تلك الرّسومَ مُلِمّةٌ","ولا رَمَسَتْ تلكَ الطّلولَ الروّامسُ",61,"س",1,0],["وَلا دَنِسَتْ لَهُ أُزُرٌ بعارٍ","ولا عَلِقَتْ له راحٌ براحِ",62,"ح",1,0],["ولا دين إلا حبها عند أهلها","فكم نحوها من ساجد وهو راكع",63,"ع",1,0],["وَلا دارُ سُكنى وَهيَ قَصرٌ مُشَيَّدٌ","فَكَيفَ وَهَذا قاعُها وَهوَ صَفصَفُ",64,"ف",1,0],["ولا دِنْتُ إلاّ حبَّ آل محمدٍ","ولا شيءً منه في القيامة أنفَعُ",65,"ع",1,0],["ولا دخلت تحت الذمام ولا اتقت","بغير القنا أعداءها يوم تتقي",66,"ق",2,0],["ولا دم الأجداد فينا جرى","ما لم نثرها فوق جرد عتاق",67,"ق",1,0],["وَلا دُمت إِلّا في سُرور وَنعمة","تَزيد وَتَبقى ما تَوالَت كَتائب",68,"ب",1,0],["ولا دأب إلا إليه نفاقه","ولا كرم إلا إليه انتسابه",69,"ب",2,0],["ولا دولة لسوى المصلحين","ولا ملك إلا لأهل الهمم",70,"م",1,0],["ولا دارٌ سوى دارَيْنِ فاخترْ","خُلوداً في النعيمِ أو السَّعير",71,"ر",1,0],["ولا در در الحادثات فإنها","سقتنا من الأشجان رنقاً واكدارا",72,"ر",2,0],["ولا ديار أحباء عفَتْ وخلَتْ","ولا على طللٍ بالٍ ولا خِيَمِ",73,"م",1,0],["ولا دَعِيٌّ يمتطِي","ظهورَكمْ وطامِعُ",74,"ع",1,0],["وَلا دَخِيسٌ وَاهِنٌ وَلا شَظَى","قَيدُ الظِّباءِ العُفر مِن آياتِه",75,"ه",1,0],["ولا دنا بعد إشرا","قهِ لوقت غروب",76,"ب",1,0],["ولا درَّ درُّ الوصلِ فيهِ لطالبٍ","يخالفُ منهُ باطن الامر ظاهر",77,"ر",1,0],["ولا دنوتم لناظري زمناً","إلا ونادى المشوق وأطربا",78,"ب",2,0],["ولأدركن بفضله ماشئت من","فرح الصديق وراحة المتودد",79,"د",1,0],["ولا دريت لشيء لا ولا اكتحلت","بعديها تارة بالنوم أجفان",80,"ن",1,0],["وَلا دَوامَ لِحالٍ لا تَحولُ فَمَن","يَرجُ الدَوامَ فَقَد خابَت رَغائِبُهُ",81,"ب",2,0],["وَلا دَعَوتُ إِلى التَجديدِ مُعتَصِماً","مِنهُ بِكُلِّ بغيضِ السَبكِ وَالصُوَرِ",82,"ر",1,0],["ولاَ دَثِرَت ذاتُ الإصَادِ بفَقدِهَا","لقَتلَى بَنِي بَدرٍ لَهامِيمَ فِتيَانِ",83,"ن",1,0],["وَلاَ دَنَا مِنْ طَالِبٍ رفْده","وَلاَ نَأى عن هَاربٍ كَيدْه",84,"ه",1,0],["وِلادَتُهُ أرّخْ سُرُورِي وَأمُّهُ","نَثُورٌ وَبَدْءُ الكُتْبِ فَتْحُكُمُ يَدرِي",85,"ي",1,1],["ولا دم اللحمِ إذا نقيت","مذبحة الشاةِ من النحرِ",86,"ر",1,0],["ولا دم البرغوثِ مستكرهٌ","ولا دماءُ السمكِ البحرِ",86,"ر",1,0],["ولا دَعَوْا خِزْياً إِلى ما دَعوْا","إِليه لكنْ مَدح المادِحِ",87,"ح",1,0],["ولإِدراك ثأره منك أنضى","عزمهُ حالفاً عليهِ يمينا",88,"ن",2,0],["ولأدمع مسفوحة وزعتها","للبين بين أحبة ومنازل",89,"ل",1,0],["وَلا دَجا بِيَ لَيلٌ ما بِهِ قَمَرٌ","إِلّا ذَكَرتُهُمُ فَسِرتُ في القَمَرِ",90,"ر",1,0],["وِلادَة ابنِ محمّد بنِ ما","لِك بنِ إبراهيمَ إبنِ مَن نَمَا",91,"م",2,0],["ولا دريت قط ما افعل به","والخل قد عز سلطانه",92,"ن",2,0],["ولا ديون تبهظ الحر في","اعساره للدائن الطامع",93,"ع",1,0],["ولا دهَمتكِ فى عشّ عقابٌ","ولا بلَغتك أيدى الصَّائدينا",94,"ن",2,0],["ولا دفعت عنك الحصون التي بنى","وحفّ بها أنهارهُ والدساكر",95,"ر",1,0],["ولا دار بكر لا ولا ام خالد","ولا روض ازهار ولا نضرة الزهر",96,"ر",1,0],["ولا دروا كيف يبنى المجد أو فهموا","أن الحياة بدون المجد تمحق",97,"ق",1,0],["ولا دمعاً تجود به المآقي","ولا أَسَفي عليكَ ولا انتحابي",98,"ب",2,0],["وَلاَ دعاءً ولاَ عهداً وَلاَ ذِمِمَا","وَلاَ ثباتاً وَلاَ عزماً وَلاَ هِمَمَا",99,"م",2,0],["ولا درينا للظبا من يصيد","مولى الشبك أو ذي المكيده",100,"د",2,0],["ولادتنا والموت سيّانِ عندنا","اذا كانَ في الامرين لَيسَ لنا يَدُ",101,"د",1,0],["ولا دفاع على الأسرى ولو وجدوا","من أهل حربهم الأرماح والنصلا",102,"ل",2,0],["ولا دروا أن لديكم حرمةً","يحفظُها شبابُكم والهرمُ",103,"م",1,0],["ولا دعوةً قُلتَها كاذِباً","ولا لَقَباً نِلْتَهُ مُسْتَعارا",104,"ر",2,0],["ولا دام حكم قام بالجور والهوى","ولكن حكم الله يعلو ولا يعلى",105,"ل",2,0],["وَلا دَفينُ غَياياتٍ لَهُ نَفَقٌ","تَحتَ التُرابِ وَلا حوتٌ وَلا وَعَل",106,"ل",1,0],["ولأدهى ما دهى أشياعه","ان ترى شامتة بشراً عداه",107,"ا",2,0],["وَلأُدحِضَنَّ بِحُجَّتي شُبُهاتِكُم","حَتّى يُغَطّي جَهلَكُم عِرفاني",108,"ن",2,0],["ولّادة قد صرتِ ولّادة","مِن غيرِ بعل فضح الكاتمُ",109,"م",1,1],["وَلا دامَ حالٌ خالَه المَرءُ باقياً","وَلم يَبقَ شَيءٌ ما يَدوم جَليلا",110,"ل",2,0],["ولأدفعن كتائبي وأنا","لي عنه في بهم العداة غنى",111,"ن",2,0],["وَلا دِيارٌ لأَجلِ الفُحشِ قَد فُتِحَت","وَلا خُمورٌ إِلى الأَلبابِ تُؤذيها",112,"ي",3,0],["ولا درست داراً غدا ربع محجري","على ربعها المأهول يهمي ويسكب",113,"ب",1,0],["ولا درينا العشى إلا بصوت يشعب","من عندهم قلت والله قد هنا عكله",114,"ل",2,0],["ولا دمعي ترقا ولم تطف لوعتي","سحائب دمع من دم القلب صيب",115,"ب",1,0],["ولا دعون بدعوة نوحية","يا رب منهم لا تذر ديارا",116,"ر",2,0],["ولا ديار بها الأحباب فائقة","إن العلا حدثتني وهي صادقة",117,"ه",1,0],["ولا درَّ إلاَّ درُّ مَن بات عَزمُه","تضيقُ بضيقٍ للفضاءِ حيازمه",118,"م",2,0],["ولا دنيا نسر بها","ولا دين ولا خلق",119,"ق",1,0],["ولادعون بأن يظلك جنة","يلقاك منها رحمة ونعيم",120,"م",1,0],["ولا دليل سوى هيفاء مخطفةٍ","تهدي الركاب وجنح الليل معتكرُ",121,"ر",1,0],["ولادةُ العصرِ من حسنٍ ومن أدب","مفتورةُ العين والأقوامُ عوّاد",122,"د",1,0],["ولاد المضا بالهاشمي منسبها","بنت المهنّد ليس بالمثلومي",123,"م",2,0],["ولاد المضا أُستنكحت جبريّ(ن)","شبيب جدّي وجدّكم يا قرومي",123,"م",2,0],["ولا ديارٌ ولا أهلٌ ولا سكنٌ","ولا حياةٌ ولا عيشٌ ولا عُمُرُ",124,"ر",1,0],["ولا دين بعد اليوم ينثر عقدهم","فقد نظموه واستعادوا التآخيا",125,"ي",2,0],["ولا دعوة بطنتها خالص التقى","وأظهرتها الإخلاص والصدق والبرا",126,"ر",2,0],["وِلَادَةُ مُنْقِذٍ يَجْلُو أَسَاهَا","فَيَرْقُصُ مَرْوَةٌ ثُمَّ الصَّفَاءُ",127,"ا",2,0],["وِلادَةُ مُنْقِذٍ لِلأَرْضِ يَمْحُو","سُلَالَةَ غِيِّهَا، كُشِفَ الغِطَاءُ",127,"ا",2,0],["ولا دعاء أرى روح الإجابة في","إخلاصه منك برداً لا أنائيه",128,"ي",2,0],["ولا دريتنُي أمن منبتهم","أم كان لي عن منتماهم منتمى",129,"ا",1,0],["ولا دهينا بأغيار بغوا ولنا","عرض يصان بفولاذ ومران",130,"ن",1,0],["وَلّادةٌ ها أنتِ قَلْبي إلْفُها","غّنّى لَها زِرْيابُ والْاَوْتارُ",131,"ر",1,0],["ولّادةٌ والتَّي قالتْ وقدعلمتْ","ألا تؤمّنهُ فالقولُ كم يقفُ",132,"ف",1,0],["ولّادةٌ لم تمتْ من فرطِ عشرتِها","إلا على لهفةِ القرطاسِ للقلمِ",133,"م",1,0],["ولّادةٌ..زريابُها خطبَ النوى","باللحنِ راقصَ نسمةَ النهرينِ",134,"ن",1,0],["ولادته في كعبة البيت لم ينل","مناط الثريا مجدها وفخارها",135,"ر",3,0],["ولادين يفرقنا ويحيا","بنا الإيمان منسجما نقيا",136,"ي",2,0],["ولادين إلا العقل فالعقل منهجي","ودربي إلى ربي...دليلي الملائم",137,"م",1,0],["ولادنا منه المنى ولا سرى ولا رقد","ولايموت بغيضه اللي مابرى والجرح ني",138,"ي",1,0],["ولا دانت لمخلوقٍ سوانا","ومالاحت لكل العالمينا",139,"ن",2,0],["ولّادةٌ بالعزِّ لا تفنى بنا","فالله مولاها ومن يحميها .",140,"ي",3,0],["ولادة لرجال الله ما فتئت","كأنما الله اخفى سرهم فيها",141,"ه",2,0],["ولا \"درعا\" التي رسمت حدودي","وأهدتني القميص القرمزيا",142,"ي",2,0],["ولَأدْرَكْتَ أنَّكَ العَبْدُ للّهِ","فَقيرٌ ولو لبِسْتَ الحَريرا !",143,"ر",2,0],["ولادن في جلساتنا حافة الكاس","ولا نخوض بكل هرج ذميمي",144,"م",2,0],["ولا دريت اني سريتك لين شدّدت الركاب","من الكويت ولا حللت الا على رحب وسعه",145,"ع",2,0],["ولا درى خلف ماذا جنى سلف","في رفضه أولا ساداته الأولى",146,"ل",2,0],["ولادة المرتضى لم يحوها أحد","سواه في غابر الدنيا وماضيها",147,"ي",3,1],["ولادّتي ما الهوى إلاكِ فاتنتي","وهل بغيركِ يغدو الجنف مُكتحلا",148,"ل",2,0],["ولا دُعيتُ إلى أُنسٍ فَأَسْعَدَنِي","إلا تَلاهُ من الأحْزانِ موّالُ",149,"ل",1,0],["ولادتي أشِراعٌ دون صاريةٍ","يُغري الرياحَ فنأتيكمْ مُحيينا؟",150,"ن",2,0],["ولاّدتي ليتنا لم نتخذْ قسماً","على الوفاءِ ....وليت الحُبَّ يجفونا!",150,"ن",2,0],["ولا ديارَ لمن ظلَّتْ ديارُهُمُ","بعيدةً... ودُخَانٌ نحوَهَا عَصَفَا",151,"ف",2,0],["ولادات ، وأموات ، ودنيا","إذا أفل النهار فلا يعود",152,"د",1,0],["وَلَأَدْرَكُوا أَنَّ الرَّحِيلَ أَمَامَهُمْ","طَمَسَ الجِهَاتِ لِكَيْ يَعِيشُوا خَلْفَا",153,"ف",2,0]]}