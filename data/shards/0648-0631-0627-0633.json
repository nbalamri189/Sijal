{"poems":[[9,"أتشفيك تيا أم تركت بدائكا","https://www.aldiwan.net/poem21961.html","الطويل"],[24,"وهاجرة لا تستريد ظباؤها","https://www.aldiwan.net/poem21882.html","الطويل"],[32,"ورأس كجماع الثريا ومشفر","https://www.aldiwan.net/poem29491.html","الطويل"],[32,"عفا الزرق من مي فمحت منازله","https://www.aldiwan.net/poem29545.html","الطويل"],[72,"لا تعتب الدهر في خطب رماك به","https://www.aldiwan.net/poem43037.html","البسيط"],[40,"تهانفت واستبكاك رسم المنازل","https://www.aldiwan.net/poem7740.html","الطويل"],[87,"ببيت الأمة أعتقل المطيا","https://www.aldiwan.net/poem6825.html","الوافر"],[54,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[50,"تأهب يوم فطرِك للمعاصي","https://www.aldiwan.net/poem66613.html","الوافر"],[19,"تنكر بعدي من أميمة صائف","https://www.aldiwan.net/poem351.html",""],[128,"أهكذا حتى ولا مرحبا","https://www.aldiwan.net/poem23708.html","السريع"],[170,"ما بال هذا الفلك الجاني","https://www.aldiwan.net/poem46853.html","السريع"],[170,"زكاة رؤوس الناس في عيد فطرهم","https://www.aldiwan.net/poem47061.html","الطويل"],[173,"على م وفي م ظلماً تلحياني","https://www.aldiwan.net/poem1688.html",""],[193,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[199,"عما يا ابنتي قيس صباحا ومظلما","https://www.aldiwan.net/poem54406.html","الطويل"],[276,"لاقيت يا نفس حقا ما حكى الحاكي","https://www.aldiwan.net/poem52112.html","البسيط"],[353,"نجلك القابل للمدح","https://www.aldiwan.net/poem20020.html","السريع"],[382,"أيا من قد رأى نصبي","https://www.aldiwan.net/poem66924.html","مجزوء الوافر"],[396,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[396,"الحمدلله مولانا الرحيم الغفور","https://www.aldiwan.net/poem54583.html","عموديه"],[398,"أبا العلاء ألا أبشر بمقدمنا","https://www.aldiwan.net/poem53583.html","البسيط"],[435,"وجارية لطهماز ربية","https://www.aldiwan.net/poem40857.html","الوافر"],[445,"جاءتك خاضعة أعناقها الأمم","https://www.aldiwan.net/poem34812.html","البسيط"],[463,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[466,"يجلو الهموم إذا تدجو مذاهبها","https://www.aldiwan.net/poem16362.html","البسيط"],[558,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[566,"ورأس أعداء شديد أضمه","https://www.aldiwan.net/poem27859.html","الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122785","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122573","البسيط"],[701,"","https://poetry.dctabudhabi.ae/diwan/poem/107333","الوافر"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18491","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145820","المتقارب"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46516","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48957","السريع"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11938","السريع"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96349","الطويل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141245","البسيط"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11189","الطويل"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74996","الطويل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46476","الطويل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102116","الهزج"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96039","الوافر"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33855","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93738","البسيط"],[2455,"","https://poetry.dctabudhabi.ae/diwan/poem/147735","الطويل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111270","المتقارب"],[2587,"","https://poetry.dctabudhabi.ae/diwan/poem/178145",""],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26156","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87332","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87316","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87317","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87330","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87331","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87315","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74207","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112680","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112672","الرجز"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3418,"","https://poetry.dctabudhabi.ae/diwan/poem/111130","المتقارب"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123936","الوافر"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102391","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126921","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126986","الوافر"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126923","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138556",""],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104829","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91478","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95354","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77125","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125813","السريع"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123527","الوافر"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97068","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54394","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94385","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94563","الطويل"],[4697,"يا بوش","https://www.poetsgate.com/ViewPoem.aspx?id=22667",""],[4924,"اسمحي لي يا الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=22080",""],[5057,"مرتاحُ الضّميرِ","https://www.poetsgate.com/ViewPoem.aspx?id=203665",""],[5072,"سيبكي الليل","https://www.poetsgate.com/ViewPoem.aspx?id=52560",""],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[5397,"هي الدنيا لها وصل وصد","https://www.poetsgate.com/ViewPoem.aspx?id=157913",""],[5397,"تطارحني الحمائم بالنواح","https://www.poetsgate.com/ViewPoem.aspx?id=157915",""],[5616,"لأنك مسلمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=205046",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6213,"زمان الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76263&r=&rc=20",""],[6263,"كما شئتَ يا شعر...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81062&r=&rc=13",""]],"verses":[["وَرَأساً دَقيقَ الخَطمِ صُلباً مُذَكَّراً","وَدَأياً كَأَعناقِ الضِباعِ وَحارِكا",0,"ك",2,0],["وَرَأساً كَدَنِّ التَجرِ جَأباً كَأَنَّما","رَمى حاجِبَيهِ بِالجَلاميدِ راجِمُ",1,"م",1,0],["وَرَأسٍ كَجُمّاعِ الثُرَيّا وَمِشفَرٍ","كَسِبتِ اليَماني قِدُّهُ لَم يُجَرَّدِ",2,"د",1,1],["وَرَأسٍ كَقَبرِ المَرءِ مِن قَومِ تُبَّعٍ","غِلاظٍ أَعاليهِ سُهولٍ أَسافِلُه",3,"ل",2,0],["وَرَأسُ مالِكَ وَهِيَ الروحُ قَد سَلَمَت","لا تَأسَفَنَّ لِشَيءٍ بَعدَها ذَهَبا",4,"ب",2,0],["وَرَأسٍ كَإِبريقِ اليَهودِيِّ أَشرَفَت","لَهُ حُبُكٌ أَجيادُها كَالمَراجِلِ",5,"ل",1,0],["ورأسك لا فشرت ولن تراني","مجمش لحيتي ما دمت حيا",6,"ي",2,0],["وَرَأسُهُ كَمِثلِ فَرقٍ قَد مُطِر","وَصَدغُهُ كَالصَولَجانِ المُنكَسِر",7,"ر",1,0],["ورأسُ الأمرِ في إحرازِ ظبي","تقلّبهُ وتدفعُ في المعاصي",8,"ص",2,0],["وَرَأساً كَدَنِّ التَجرِ جَأباً كَأَنَّما","رَمى حاجِبَيهِ بِالحِجارَةِ قاذِفُ",9,"ف",1,0],["وراسف بالقيد ما ينثني","يدأب حتى يبلغ المأربا",10,"ب",2,0],["ورأسُه طار فلهْفي على","مَجْثمهِ في خَيرِ جُثمانِ",11,"ن",1,0],["ورأسُكِ أغلى قيمةً فتصدَّقي","بِفيكِ عَلينا فهْوَ صاعٌ من الدُّرِّ",12,"ر",1,0],["وَرَأسٍ قَد عَقَقَنا الرَأسَ مِنهُ","بِأَبيضَ كَالعَقِيقَةِ هُندُوانِ",13,"ن",1,0],["وَرأسُ ماليَ جاهُ المصطفى فبهِ","أَدعوكَ يا ربِّ أيّدني له وبهِ",14,"ب",2,0],["وَرَأسُ خَميسٍ قَد رَمانا فَغادَرَت","سِلاحُ كَماتي لَحمُهُ مُتَقَسَّما",15,"م",2,0],["وَراسِخ العلم وَالصفح الجَميل اذا","يرجى وَلَيسَ لذي ستر بهتاك",16,"ك",1,0],["وَرَأْسُ مَالي حُسْنُ ظني وَلا","بُدَّ لِرَأْسِ المَالِ مِن رِبْحِ",17,"ح",1,0],["ورأسهمُ ينافقني","فماذا الظن بالذنب",18,"ب",1,0],["ورأس كل الخطايا حب دنيا الدناه","فاسمع على سنة المختار سيد الهداه",19,"ا",2,0],["ورأس كل الخطايا والمحن والشرور","حبك الدنيا وربك قد ضمن لك عبور",20,"ر",1,0],["وَراسَلَتني بِأَن بادِر لِتَملكَني","وَيَجريَ الماءُ الجود في العودِ",21,"د",1,0],["ورأسي مذهبٌ مملوء تبرٍ","من التنباك والنار المضيّه",22,"ي",2,0],["وراسياتُ جِبالِ الكفْرِ يُخْبِرُنا","هُوِيُّها أَنَّ ذَاكَ الطودَ مُنْهَدِمُ",23,"م",1,0],["وراسياتٌ تدلُّ المعتمين إذا","ضجّت زماجرُ منها أو قراقيرُ",24,"ر",1,0],["وراسخُ الحلم والأحْلامُ طائشةٌ","تخالُ في الدَّست منه هَضْبتَيْ حضَن",25,"ن",1,0],["وَرَأسُ مِهرانَ قَد رَكَّبتَ قُلَّتَهُ","لَدناً كَفاهُ مَكانَ اللَيثِ وَالجيدِ",26,"د",1,0],["وَرَأسِ أَعداءٍ شَديدٍ أَضَمُه","قَد طالَ مِن حَردٍ عَلَينا سَدَمُه",27,"م",2,1],["وَراسَلَتكَ ظَفارٌ مِن تَذَلِّلِها","وَذَلّ في الجِانِبِ الغَربيِّ غُربانُ",28,"ن",1,0],["وراسلتكُم تَعِزٌّ من تذلُّلها","بالرغم وانتظرتكم حيس والجند",29,"د",1,0],["ورأسُ النقصِ فوزُك بازديادٍ","من الدنيا وحبُّكَ أن تناله",30,"ل",2,0],["وَرَأسُ بَني شَمخٍ وَفارِسُ قَومِهِ","شَنوءَةَ وَالتَيمِيُّ هادي الكتائِبِ",31,"ب",1,0],["وَرَأُسُكَ وهوَ يَنزّ الدِّماء","لأثبَت مِنْ ذَابِحيهِ جِنَانَا",32,"ن",2,0],["وَراسَلَت ذاكَ الفَتى مذاكره","قالَ لَها ما أَنت إلا فاجره",33,"ه",1,0],["ورأسَ كُلٍّ ضَع بذيل ما قُرِن","به على اختلافِ وضعٍ قد زُكن",34,"ن",1,0],["وراس ميمٍ ضع كرأسِ الواو","وبسطَها في وضع كل راوي",34,"ي",1,0],["ورأسها مثل الثلاث توضعُ","فارسله أو فاسبله أو فيجمع",34,"ع",1,0],["ورأسُها كالصادِ في الرقاعِ","لكنه بخفة الاوضاع",34,"ع",1,0],["ورأسُه اعتلّ فمن مُرجِعٌ","صحّتَه هيهاتِ من مُرجِع",35,"ع",1,0],["وَرَأسِهِ لَو أَمكَنَ الدَهرُ ما","أَتَيتُهُ إِلّا عَلى راسي",36,"س",2,0],["ورأس كبرطيل الحديد يزينه","مشافر مضبوح الجران ذقون",37,"ن",1,0],["ورأس مالكم الإخلاص فاتّخذوا","منه لكم مشعلاّ يقصى به الدّاء",38,"ا",2,0],["وَرَأسٌ شَديدُ الأَخدَعَينِ وَمَخرَمٌ","وَرِجلٌ كَمِخراقِ الوَليدِ رَحولُ",39,"ل",1,0],["وَرأسا بأيدي الجند كَم بات ساجدا","وَكم ظل في الكبرى يركب برهانا",40,"ن",2,0],["وَرَأسيَ قَد شابَت ذَوائب لَيلِهِ","وَلاحَ صَباح الشَيب في جَنحِهِ وَخَطا",41,"ط",2,0],["ورأسكَ طه ارفع","فهذا القصدُ محبي",42,"ب",2,0],["ورأسك فوق رأس الرمح عال","تجاذبه الشمال إلى الجنوب",43,"ب",1,0],["وَرَأسٍ في مُؤَخَّرِهِ اِرتِفاعٌ","عَلى أَرجائِهِ طَوقٌ مُدارُ",44,"ر",1,0],["وَرَأس فرعك قل لي أَينَ مسقطه","وأي غالية باتَت تُربيه",45,"ي",2,0],["ورأسي مرفوع لنجم كأنما","قفاي إلى صلبي بخيط مخيط",46,"ط",1,1],["وراس الحسين أمام الرؤوس","سما من قنا الخط ميالها",47,"ل",3,0],["وراسل الورق عندليب","كالزيّر والبمّ والمثاني",48,"ن",2,0],["وَرَأسُ قَبّارِيَّةٍ بِرَأسِهِ","أَثوابُهُ تَحميهِ وَالمَخالِبُ",49,"ب",1,1],["وراسُ شِيوَه وَكِيُوس كبارُ","جبالُ بَهرَه فَوقَهُم كبارُ",50,"ر",1,0],["ورأسُهُ من شاطىء السهيلي","يعلَمُهُ مُنَزِّلُ الإنجيلِ",51,"ل",1,0],["وراسها الجَاهِي بِوَجهِ الماءِ","وراسُها خَمسٌ بلا مراءِ",52,"ا",2,0],["وَرَاسُ حَنبيصٍ مَعَ الجزيرَه","بَيضَا تَرَاهَا مِنهُ نَحوَ الديرَه",53,"ه",1,0],["وَرَاسُ بَرٍّ فيهِ جَاهُ أربَعَه","وَنِصفُ لا شَكَّ فَخُذ ذا وآتبَعَه",53,"ه",1,0],["وَرَاسُهُ الأعلى يَصِيرُ قِطعَه","وَاحدَةً كَقُبَّةٍ مُرتَفِعَه",54,"ه",1,0],["وَرَاسُهَا يَا خِي مِنَ الجَنَوبِ","سَمَا كَمَند يُسمَى أيَا حَبِيبِي",55,"ي",1,0],["ورأسُها الميخُ وأَمَّا ذيلُهَا","الفرقدانِ هكذا دليلُهَا",56,"ه",2,0],["وَرَأساً يَد الزَهراء كانَت وِسادة","لَهُ فَغَدا بِالترب ظُلماً موسدا",57,"د",2,0],["ورأسهُ فارقَ منهُ البَدنا","والبيضُ قد تقاسَمَتهُ والقنا",58,"ن",2,0],["ورأسُه يدارُ في البلدانِ","من فوقِ عالي الرُمحِ والسِنانِ",59,"ن",1,0],["ورأسها كواكب متصله","بالعنق من كواكب المسلسله",60,"ه",1,0],["ورأس ابي غير رفع الفخار","يؤنبه ذابل أسمر",61,"ر",1,0],["ورأسك بالقنا للشام يهدى","وجسمك رهن هاتيك البقاع",62,"ع",1,0],["ورأسٍ غزانا كيْ يصيبَ غنيمةً","أتانا فلاقى غيرَ ما كانَ راجيا",63,"ي",2,0],["وراس ابن بنت الوحي سا أمامها","وشيبته صار النجيع خضابها",64,"ب",3,0],["وراسك نصب عيني وابن هند","غدا بالعود ينكت منه ثغرا",65,"ر",2,0],["وراسه فوق مياد يطاف به","لهفي لرأس على المياد منتصب",66,"ب",1,0],["وراس ابن بنت الوحي يقرع ثغره","يزيد يريهن اقتداراً على الفتك",67,"ك",1,0],["وراس فخار سيم خفضاً فما ارتضى","سوى الرفع فوق السمهرّية منصبا",68,"ب",2,0],["وَراسلت الأَطيارُ في الرَوض إلفَها","فنص لها السير النَسيم بلى وَجد",69,"د",1,0],["ورأس دينٍ معرفهْ وأدبُ","رأس الخطايا مرضٌ وغضبُ",70,"ب",1,0],["ورأس عين بلد فاعرفه","والأَسود السالخ لا تضفه",71,"ه",1,0],["ورأسك والعقد الذي بيننا ولم","يكن قسمي إلا إذا أثقل القسم",72,"م",1,0],["وَرَأسُ ما ذَكَرناهُ الحَياءَ فَكُن","مِنَ الحَياءِ بِأَوفى باهِرَ الحِبرِ",73,"ر",1,0],["ورأَّس العاطلَ من قومه","في وافر العيش وفي بَسطته",74,"ت",2,0],["ورأسا قد حوى فيه لسانا","جرىّ الطعن فحاشا بذيا",75,"ي",2,0],["ورأسه فوق مياد أقيم ومن","ثقل الأمامة أبصرنا به عوجا",76,"ج",2,0],["ورأسَ الجشا والقريتينِ وكلُّها","مواردُ فيها السُّحبُ قد غادرتْ غدرا",77,"ر",2,0],["ورأَسهُ قد غدا بالأمن مرتفعاً","لا يَختَشي سرمداً بؤساً وأضرارا",78,"ر",2,0],["ورأسكِ قد أضحى إلى الرشد منزلاً","وطالعكِ الأسمى تجمَّلِ بالنصرِ",79,"ر",1,0],["وراس العكف هو الهدف سر واعلان","لا طيّروا راسه يطبق هدبنا",80,"ن",2,0],["وراس مالي ذكريات حلم وأمال وطموح","لا صديق ولا رفيق ولا طريق واتبعه",81,"ع",2,0],["ورأسُ مُنعَّمٍ في كلِّ خيرٍ","ورأسُ المُعدَمِ التّعِسِ الفقيرِ",82,"ر",1,0],["ورأسي في يديك ِ فلا تحوري","وهل تنسى دمائي كربلاء ُ ؟؟",83,"ا",2,0],["وَرَأْسُ الْحُكْمِ أُجْرَتُهُ عَلَيْنَاْ","وَلَيْسَ الضِّدُّ نَرْجُوْهُ مَعُوْنَاْ",84,"ن",2,0],["ورأس ابن النبي كبدر تم","له الأبصار شاخصة تمد",85,"د",1,0],["ورأس ابن النبي على العوالي","كبدر هدى لجنح الليل ماحي",86,"ح",2,0],["وَرَأْسُكَ يَا أَمِيرَ الْقَوْمِ قَاسٍ","وَمِنْ قَبْلِ الْمَشِيبِ أَرَاهُ شَابَا!",87,"ب",2,0],["وَرَأس القناق وَصلت لا جيت أَنقرة","ملفاك شيخا نافل الشَيخان",88,"ن",1,0],["ورأسي متعب يهوي","بجفني الواله الواني",89,"ن",2,0],["ورأسكَ أينعَ يومَ القطافِ فلا تَعجبّنَ إذا ما صُرمْ","أأرضيكَ ي