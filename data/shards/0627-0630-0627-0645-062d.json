{"poems":[[47,"وواعظ منه لولا أنه حجر","https://www.aldiwan.net/poem63596.html","البسيط"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87772","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132534","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62880","الوافر"],[3927,"","https://poetry.dctabudhabi.ae/diwan/poem/113705","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52124","الوافر"],[5309,"أروم لكل الناس ان يدركوا النورا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573827",""],[6185,"غيمة الصيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87027&r=&rc=13",""]],"verses":[["إِذا مَحاسِنِيَ اللاتي أُدِلُّ بِها","كانَت ذُنوبي فَقُل لي كَيفَ أَعتَذِرُ",0,"ر",1,0],["إذا محيت صارت كتابا مجردا","مهيأة في الذهن في أي هيئة",1,"ه",1,0],["إِذا محن الزَمان تعاورتنا","رَأَت نَبع الحِفاظ بِنا صَليبا",2,"ب",2,0],["إذا محكمات الرأي شاقتك فاتبع","هدى اشيب قد حنكته تجاربه",3,"ب",2,0],["اذا محيت ضَغَائِنُه بعذرٍ","نبتنَ نباتَ أَنيابِ الأفاعي",4,"ع",2,0],["إذا محاسني اللاتي أدل بها","كانت ذنوباً فوصلي منك منصرم",5,"م",1,0],["إذا مَحلتْ رُبى العَلياء حُزناً","فبستانيُّها إلْفُ اعتقالِ",6,"ل",1,0],["إِذا مَحَّص النّاسُ الأُمورَ بِعَرضِها","عَلَى النُّورِ أَضحى الحَقُّ بِالعَقلِ مَنظورا",7,"ر",2,0],["( إذا مَحَاسِنِيَ الَّلاتِي أُدِلُّ بِهَا","كَانتْ ذُنُوبَاً فَقُلْ لِيْ كَيْفَ أَعْتَذِرُ )",8,"ر",1,0]]}