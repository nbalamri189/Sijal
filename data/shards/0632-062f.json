{"poems":[[53,"تأمل أن تفرح في دار الحزن","https://www.aldiwan.net/poem29747.html","الرجز"],[53,"يا أراك الحمى تراني أراكا","https://www.aldiwan.net/poem29922.html","الخفيف"],[77,"حلف الليل بالثلاث يمينا","https://www.aldiwan.net/poem36033.html","الخفيف"],[93,"ربة الدولة والجاه المكين","https://www.aldiwan.net/poem11231.html","الرمل"],[27,"قالوا نصيبك من أجر فقلت لهم","https://www.aldiwan.net/poem5959.html","البسيط"],[47,"إبنان أم شبلان ذان فإنني","https://www.aldiwan.net/poem25154.html","الكامل"],[72,"تسلسلت في خدي الأدمع","https://www.aldiwan.net/poem19173.html","السريع"],[72,"قل لوزير الملك يا من له","https://www.aldiwan.net/poem19192.html","السريع"],[91,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[85,"هز اللواء بعزك الإسلام","https://www.aldiwan.net/poem63742.html","الكامل"],[45,"زعم الغراب منبئ الأنباء","https://www.aldiwan.net/poem10195.html","الكامل"],[45,"بعض هذا العتاب والتفنيد","https://www.aldiwan.net/poem63476.html","الخفيف"],[45,"هم ألى رائحون أم غادونا","https://www.aldiwan.net/poem66662.html","الخفيف"],[61,"زدني من العذل فيها أيها اللاحي","https://www.aldiwan.net/poem51741.html","البسيط"],[66,"زار والليل مؤذن بالبراز","https://www.aldiwan.net/poem38491.html","الخفيف"],[80,"يمضي لك السيف ما تنويه والقلم","https://www.aldiwan.net/poem31288.html","البسيط"],[105,"أقبل نعيم هداك ربك ساريا","https://www.aldiwan.net/poem44192.html","الكامل"],[68,"زدني بفرط الحب فيك تحيرا","https://www.aldiwan.net/poem1498.html","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9986","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54884","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43842","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43691","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43719","الكامل"],[90,"لبنان في العراق","https://www.poetsgate.com/ViewPoem.aspx?id=178952",""]],"verses":[["زِدنَ الرَزايا فَنَقَصنَ دَفعَةً","وَوُطِّنَ القَلبُ عَليها فَاِطمَأَنّ",0,"ن",1,0],["زِدتَ سَبقاً عَلى أَبيكَ وَكانَت","غايَةُ المَجدِ لَو لَحِقتَ أَباكا",1,"ك",2,0],["زِدْتَ للمَسْلِمِينَ فِي الدَّهْرِ عِيدا","ثَانيا يَا مُؤمَّلَ المَسْلِمِينَا",2,"ن",2,0],["زِدْتهِ بِرّاً بِأَنْ كُنْتِ لَهُ","نِعْمَةَ القُدْوَةُ فِي دُنْيَا وَدِينْ",3,"ن",1,0],["زِدنا عَلى وَجدِها وَجداً وَإِن رَجَعَت","في القَلبِ مِنها خُطوبٌ ذاتُ بُلبالِ",4,"ل",1,0],["زِدناهُما شَرَفاً رَفيعاً سَمكُهُ","ثَبتَ الدَعائِمِ إِذ تَخَوَّلناهُما",5,"م",2,0],["زِدْ كلّ يومٍ في العلى رفعةً","وليصنع الحسَّاد ما يصنعوا",6,"ع",3,0],["زدْ كل يومٍ في العلى رفعةً","وليصنع الحاسد ما يصنع",7,"ع",1,0],["زِد لِيَ الشَمرَ كُلَّما","قُلتُ يا صاحِبي زِدِ",8,"د",1,0],["زِدهُم أَميرَ المُؤمِنينَ مِنَ القُوى","إِنَّ القُوى عِزٌّ لَهُم وَقَوامُ",9,"م",1,0],["زِدني اِشتِياقاً بِالمُدامِ وَغَنِّني","أَعزِز عَلَيَّ بِفُرقَةِ القُرَناءِ",10,"ا",2,0],["زِدنَني صَبوَةً وَذَكَّرنَني عَه","داً قَديماً مِن ناقِضٍ لِلعُهودِ",11,"د",1,0],["زِدهُمُ يا أَبا سَعيدٍ فَما السُؤ","دُدُ إِلّا زِيادَةُ الشاكِرينا",12,"ن",2,0],["زِدْني منَ العَذلِ فيها أيُّها اللاحي","إنَّ الفُؤادَ إليها جِدُّ مُرتاحِ",13,"ح",1,1],["زِدتُ في حُبِّ مَدحِكِ فَاِرتَح","لِعَبيطِ المَديحِ وَالإِرجازِ",14,"ز",1,0],["زدْ زادك اللّه في صَوْن الهدى نَظَراً","إنّ الصليبَ ليشقى منك والصنمُ",15,"م",1,0],["زِدْهَا من الوصفِ البديعِ وغنِّنا","للَّهِ دَرُّكَ يا ابنَ حربٍ شاديا",16,"ي",2,0],["زِدْني بفَرْطِ الحُبّ فيك تَحَيّرا","وارْحَمْ حشىً بلَظَى هواكَ تسعّرا",17,"ر",2,1],["زِدني مِنَ النَوحِ وَاِسعِدني عَلى حَزَني","حَتّى تَرى عَجَباً مِن فَيضِ أَجفاني",18,"ي",1,0],["زِدْنِي جَمِيلاً أَزُدْك حَمْدَا","لَمْ تُبْقِ لِي غَيْرَ ذاكَ ذُخْرَا",19,"ر",2,1],["زدني أَسىً لا أَبوكَ يُجزى","عَنكَ وَلا أَنتَ عَنهُ جازِ",20,"ز",1,0],["زِد وَأَبِّنهُ يا فَمي","أَملِ ما شِئتَ يُنسَخِ",21,"خ",1,0],["زِد في الجَهالَةِ يا عَدُوّي شامِتاً","وَإِذا أَرَدتَ تَبَرِّياً فَتَنَزّهُ",22,"ه",1,0],["زِدنا بمنطقك الوجيز صبابةٍ","فهو السَّلاف وكلُّنا نشوان",23,"ن",1,0]]}