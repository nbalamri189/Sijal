{"poems":[[53,"تأمل أن تفرح في دار الحزن","https://www.aldiwan.net/poem29747.html","الرجز"],[53,"يا أراك الحمى تراني أراكا","https://www.aldiwan.net/poem29922.html","الخفيف"],[77,"حلف الليل بالثلاث يمينا","https://www.aldiwan.net/poem36033.html","الخفيف"],[93,"ربة الدولة والجاه المكين","https://www.aldiwan.net/poem11231.html","الرمل"],[27,"قالوا نصيبك من أجر فقلت لهم","https://www.aldiwan.net/poem5959.html","البسيط"],[47,"إبنان أم شبلان ذان فإنني","https://www.aldiwan.net/poem25154.html","الكامل"],[72,"تسلسلت في خدي الأدمع","https://www.aldiwan.net/poem19173.html","السريع"],[72,"قل لوزير الملك يا من له","https://www.aldiwan.net/poem19192.html","السريع"],[91,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[85,"هز اللواء بعزك الإسلام","https://www.aldiwan.net/poem63742.html","الكامل"],[45,"زعم الغراب منبئ الأنباء","https://www.aldiwan.net/poem10195.html","الكامل"],[45,"بعض هذا العتاب والتفنيد","https://www.aldiwan.net/poem63476.html","الخفيف"],[45,"هم ألى رائحون أم غادونا","https://www.aldiwan.net/poem66662.html","الخفيف"],[61,"زدني من العذل فيها أيها اللاحي","https://www.aldiwan.net/poem51741.html","البسيط"],[66,"زار والليل مؤذن بالبراز","https://www.aldiwan.net/poem38491.html","الخفيف"],[80,"يمضي لك السيف ما تنويه والقلم","https://www.aldiwan.net/poem31288.html","البسيط"],[105,"أقبل نعيم هداك ربك ساريا","https://www.aldiwan.net/poem44192.html","الكامل"],[68,"زدني بفرط الحب فيك تحيرا","https://www.aldiwan.net/poem1498.html","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9986","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54884","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43842","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43691","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43719","الكامل"],[90,"لبنان في العراق","https://www.poetsgate.com/ViewPoem.aspx?id=178952",""],[115,"لي قلب قد قلبته على الجم","https://www.aldiwan.net/poem40867.html","عموديه"],[115,"الحمد لله الذي قد أنعما","https://www.aldiwan.net/poem42187.html","الرجز"],[120,"من عذيري من الذي يبكيني","https://www.aldiwan.net/poem49349.html","الخفيف"],[132,"جعلت بيننا الرباب النمو ما","https://www.aldiwan.net/poem54747.html","الخفيف"],[185,"يا قلب ما فعلت بك العينان","https://www.aldiwan.net/poem14672.html","الكامل"],[204,"ذهبت أطلب ألفاظا أخاطبه","https://www.aldiwan.net/poem53288.html","البسيط"],[235,"أنا في كف من به تفخر الأر","https://www.aldiwan.net/poem31951.html","الخفيف"],[237,"نلنا ولولا الحب ما نلناها","https://www.aldiwan.net/poem19725.html","الكامل"],[259,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[259,"زدت يا بيروت نورا","https://www.aldiwan.net/poem35790.html","مجزوء الرمل"],[261,"زد علا ما لحده من تناه","https://www.aldiwan.net/poem38145.html","الخفيف"],[261,"جور حكم الهوى يهين النفيسا","https://www.aldiwan.net/poem38256.html","الخفيف"],[270,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[282,"زد علوا يا أيها الملك الأشرف","https://www.aldiwan.net/poem32685.html","الخفيف"],[297,"يا بريق الحيا ويا عذب البان","https://www.aldiwan.net/poem33004.html","الخفيف"],[303,"زدوا مهجتي ضرا على الضر في الهوى","https://www.aldiwan.net/poem58294.html","الطويل"],[348,"زدت فيها زادك الله علا","https://www.aldiwan.net/poem20641.html","الرمل"],[361,"أيد الله دولة أنت فيها","https://www.aldiwan.net/poem68092.html","الخفيف"],[364,"زد علوا في كل يوم ورفعه","https://www.aldiwan.net/poem60844.html","الخفيف"],[364,"أنت للعيد وهو للناس عيد","https://www.aldiwan.net/poem60931.html","الخفيف"],[402,"عيناي فيك بأسياف البكى اجترحا","https://www.aldiwan.net/poem46751.html","البسيط"],[406,"لا تملأن قدحي وارفق فقد مزجت","https://www.aldiwan.net/poem50192.html","البسيط"],[409,"زدني علا لا أرتضي باللهى","https://www.aldiwan.net/poem32207.html","السريع"],[409,"قل لمن أوحش بالهجر","https://www.aldiwan.net/poem32518.html","مجزوء الرمل"],[409,"زدني جوى يا حبهم وأضلني","https://www.aldiwan.net/poem32524.html","الكامل"],[432,"سافر إذا حاولت قدرا","https://www.aldiwan.net/poem12635.html","مجزوء الكامل"],[449,"أوحى الفؤاد","https://www.aldiwan.net/poem976.html",""],[458,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[458,"أخلق الدهر لمتى وأجدا","https://www.aldiwan.net/poem56230.html","الخفيف"],[458,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[515,"نبهتني حمامة بسحير","https://www.aldiwan.net/poem12292.html","الخفيف"],[538,"طنجة تيهي دلالا","https://www.aldiwan.net/poem47581.html","عموديه"],[544,"سقياك يا والد النهرين","https://www.aldiwan.net/poem67249.html","عموديه"],[553,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[558,"اصبر على ضر البلايا","https://www.aldiwan.net/poem33572.html","مجزوء الكامل"],[562,"خود من العرب عافت شيمة الكرم","https://www.aldiwan.net/poem52840.html","البسيط"],[575,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"]],"verses":[["زِدنَ الرَزايا فَنَقَصنَ دَفعَةً","وَوُطِّنَ القَلبُ عَليها فَاِطمَأَنّ",0,"ن",1,0],["زِدتَ سَبقاً عَلى أَبيكَ وَكانَت","غايَةُ المَجدِ لَو لَحِقتَ أَباكا",1,"ك",2,0],["زِدْتَ للمَسْلِمِينَ فِي الدَّهْرِ عِيدا","ثَانيا يَا مُؤمَّلَ المَسْلِمِينَا",2,"ن",2,0],["زِدْتهِ بِرّاً بِأَنْ كُنْتِ لَهُ","نِعْمَةَ القُدْوَةُ فِي دُنْيَا وَدِينْ",3,"ن",1,0],["زِدنا عَلى وَجدِها وَجداً وَإِن رَجَعَت","في القَلبِ مِنها خُطوبٌ ذاتُ بُلبالِ",4,"ل",1,0],["زِدناهُما شَرَفاً رَفيعاً سَمكُهُ","ثَبتَ الدَعائِمِ إِذ تَخَوَّلناهُما",5,"م",2,0],["زِدْ كلّ يومٍ في العلى رفعةً","وليصنع الحسَّاد ما يصنعوا",6,"ع",3,0],["زدْ كل يومٍ في العلى رفعةً","وليصنع الحاسد ما يصنع",7,"ع",1,0],["زِد لِيَ الشَمرَ كُلَّما","قُلتُ يا صاحِبي زِدِ",8,"د",1,0],["زِدهُم أَميرَ المُؤمِنينَ مِنَ القُوى","إِنَّ القُوى عِزٌّ لَهُم وَقَوامُ",9,"م",1,0],["زِدني اِشتِياقاً بِالمُدامِ وَغَنِّني","أَعزِز عَلَيَّ بِفُرقَةِ القُرَناءِ",10,"ا",2,0],["زِدنَني صَبوَةً وَذَكَّرنَني عَه","داً قَديماً مِن ناقِضٍ لِلعُهودِ",11,"د",1,0],["زِدهُمُ يا أَبا سَعيدٍ فَما السُؤ","دُدُ إِلّا زِيادَةُ الشاكِرينا",12,"ن",2,0],["زِدْني منَ العَذلِ فيها أيُّها اللاحي","إنَّ الفُؤادَ إليها جِدُّ مُرتاحِ",13,"ح",1,1],["زِدتُ في حُبِّ مَدحِكِ فَاِرتَح","لِعَبيطِ المَديحِ وَالإِرجازِ",14,"ز",1,0],["زدْ زادك اللّه في صَوْن الهدى نَظَراً","إنّ الصليبَ ليشقى منك والصنمُ",15,"م",1,0],["زِدْهَا من الوصفِ البديعِ وغنِّنا","للَّهِ دَرُّكَ يا ابنَ حربٍ شاديا",16,"ي",2,0],["زِدْني بفَرْطِ الحُبّ فيك تَحَيّرا","وارْحَمْ حشىً بلَظَى هواكَ تسعّرا",17,"ر",2,1],["زِدني مِنَ النَوحِ وَاِسعِدني عَلى حَزَني","حَتّى تَرى عَجَباً مِن فَيضِ أَجفاني",18,"ي",1,0],["زِدْنِي جَمِيلاً أَزُدْك حَمْدَا","لَمْ تُبْقِ لِي غَيْرَ ذاكَ ذُخْرَا",19,"ر",2,1],["زدني أَسىً لا أَبوكَ يُجزى","عَنكَ وَلا أَنتَ عَنهُ جازِ",20,"ز",1,0],["زِد وَأَبِّنهُ يا فَمي","أَملِ ما شِئتَ يُنسَخِ",21,"خ",1,0],["زِد في الجَهالَةِ يا عَدُوّي شامِتاً","وَإِذا أَرَدتَ تَبَرِّياً فَتَنَزّهُ",22,"ه",1,0],["زِدنا بمنطقك الوجيز صبابةٍ","فهو السَّلاف وكلُّنا نشوان",23,"ن",1,0],["زدتني في الهوى غراما ووجدا","وولوها ولست ابغي سواكا",24,"ك",2,0],["زدنا تقى وعافنا من البلا","واصلح لنا شؤننا بين الملا",25,"ل",2,0],["زدتني فتنةً وليس جميلاً","من هجران والهٍ مفتون",26,"ن",1,0],["زِدتَهُ في الأنامِ هُوناً فَمَا أَغ","نَيتَ عَنهُ ومَا كَفَفتَ أرِيمَا",27,"م",2,0],["زدني قِلىً واهجرْ فذلك بُغْيَتي","من بعدِ كونِى والورى سِيّان",28,"ن",1,0],["زِدنا فإنّا شكرنا حسن فِعلكم","وقد يُزَادُ على الإحسان مَن شكرا",29,"ر",2,0],["زِدتُّ تيهاً بِهِ عَلى كُلِّ مَلبو","سٍ وَفَخراً فَزادَهُ اللَهُ فَخرا",30,"ر",2,0],["زِدْ فِي تَسَعُّرِهَا أَزِدْكَ تَذَلُّلاً","فَقَسَاوَةُ الأَجْلاَفِ لاَ أَرْضَاهَا",31,"ا",3,0],["زِدْ فِي تَحَرُّقِهَا فَزَادَ اللهُ فِي","أَكْبَادِهَا غَيْظاً يَحُلُّ عُرَاهَا",31,"ا",3,0],["زدني من نور هداك ضيا","وامنح قلبي نفحاتك يا",32,"ي",2,0],["زدتِ يا بيروت نوراً","ببهاء ابن سعادهْ",33,"د",2,1],["زد علا ما لحده من تناه","آمنا آمراً على الدهر ناه",34,"ه",1,1],["زدعلا يبعد الحسود ويبدي","لك من لمح ناظريه الدسيسا",35,"س",2,0],["زدنا السيوفَ مضاءً من مضاربنا","ومن مطاعننا زدنا القنا لينا",36,"ن",2,0],["زِد عُلُوّاً يا أَيُّها المَلِكُ الأش","رَفُ حَتّى تَحوزَ كُلَّ المَمالِك",37,"ك",1,1],["زِدتُماني شَوقاً لظبيٍ غَريرٍ","حين أشبهتُماهُ ثغراً وَقَدّا",38,"د",2,0],["زدوا مهجتي ضرا على الضر في الهوى","ولا تأسفوا يوما على مدمعي الجاري",39,"ي",1,1],["زِدْتَ فِيها زادَكَ اللَّهُ عُلاً","عُمْرَ بَدْرَ التِّمِّ لمَّا كَمَلا",40,"ل",2,1],["زد علوّا وَرِفعَة يا اِبن تاج","بِاِمتِداح النَبِيّ طه الشَفيع",41,"ع",1,0],["زِدْ عُلُوّاً في كلِّ يومٍ ورِفْعَهْ","يا شهاباً من أَيمَنِ الشُّهْبِ طَلْعَهْ",42,"ع",2,1],["زِدْ بأيّامِك ابتهاجاً ومنها ال","عِيدُ باليُمْنِ واحدٌ مَعْدود",43,"د",1,0],["زِدْ خاطري شرراً أو ناظري سَهرا","وزِد عظامي نحولاً والحَشا برحا",44,"ح",2,0],["زِدني ابتِساماً وَقُل لليل دَم أَبَداً","فَأَنتَ وَالكأسُ مُصباحٌ وَمُصباحُ",45,"ح",1,0],["زدني عُلاً لا أرتَضِي باللّهى","حَسبِيَ ما نوّلْتَ مِن مَالِ",46,"ل",1,1],["زِدتَ في تِيهكَ والشيْ","ءُ إِذا زَادَ تَناهَى",47,"ا",3,0],["زِدْني جَوىً يا حُبَّهُم وَأَضِلَّني","يا مُرشِدي عَن مَنْهَجِ السُّلوانِ",48,"ن",1,1],["زِدْ رفعةً إن قيلَ أتْرَ","بَ وانخفِضْ إن قيلَ أثْرى",49,"ر",2,0],["زدنا من الفعل الجميل تطلع","نحو العلا وتقدما وتطورا",50,"ر",2,0],["زدني كما قد زدتُ يزددْ حسنُها","إن المكارم تبعث الأَقوالا",51,"ل",2,0],["زد لجاجاً إذا سألتَ وإلحا","حاً عليه يزِدْك صبراً ورِفْدا",52,"د",2,0],["زدتَ وما انحطُّوا ولكنَّها","إضاءةُ البدرِ على الكوكبِ",53,"ب",1,0],["زدت هماً بنوحها فوق همي","واعتراني حزن على أحزاني",54,"ن",2,0],["زِدتِ سُمُوًّا على مَا","كانَ قَديمَ الزَّمَان",55,"ن",1,0],["زِدْ لانتمائِكَ جذراً ف(العراقُ) هُنا","نهرانِ يحتضنانِ البدءَ والزمناَ",56,"ن",2,0],["زِدْ لانتمائِكَ موسيقَا، يُرَقْرِقُها","ماءُ (الفراتِ) على صدرِ النخيلِ جَنَى",56,"ن",2,0],["زِدتَ الأَكارِمَ في المَكارِمِ شيمَةً","تَستَلُّ في الأَزَماتِ غِلَّ الحُسَّدِ",57,"د",1,0],["زد في علومك وارتفع","عنه وكن حسن السجايا",58,"ا",3,0],["زِدْني مِنَ الشِّعرِ يا جِبريلُ فاكِهةً","ودَعْ ثنَاكَ لِمَنْ لاقَ الثَّنا بهِمِ",59,"م",1,0],["زدتُم غَرامي لا نَقَص","حين زدتم في عتابي",60,"ي",1,0]]}