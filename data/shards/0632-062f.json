poetsgate.com/ViewPoem.aspx?id=186136",""],[5411,"هُنا نَنْتَهي","https://www.poetsgate.com/ViewPoem.aspx?id=202887",""],[5431,"ياقمحة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=185535",""],[5431,"آمنت بالعشق لا مالٌ ولا ولدُ","https://www.poetsgate.com/ViewPoem.aspx?id=191764",""],[5431,"أنا ألف ملحمة وقلبٌ أخضرُ","https://www.poetsgate.com/ViewPoem.aspx?id=192158",""],[5444,"بلد الألف ربوة","https://www.poetsgate.com/ViewPoem.aspx?id=205450",""],[5510,"دار الحديث","https://www.poetsgate.com/ViewPoem.aspx?id=206112",""],[2110,"زر دار مي وقف بالباب إن جازا","https://www.poetsgate.com/ViewPoem.aspx?id=156273",""],[5660,"مَن لَم يُعَزِّز عِشقَهُنَّ ذَليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=23711",""],[5688,"زدني من الحبر","https://www.poetsgate.com/ViewPoem.aspx?id=200692",""],[5725,"وقفة على باب ابي الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=177475",""],[5730,"زدني جنونا","https://www.poetsgate.com/ViewPoem.aspx?id=210373",""],[5781,"خُدوشٌ على مَلْمَسِ الياقوت","https://www.poetsgate.com/ViewPoem.aspx?id=202832",""],[5790,"أصبحت عبدك رقا","https://www.poetsgate.com/ViewPoem.aspx?id=112089",""],[5861,"سر الداء","https://www.poetsgate.com/ViewPoem.aspx?id=188030",""],[5956,"أرثي لمنآنا","https://www.poetsgate.com/ViewPoem.aspx?id=194495",""],[5991,"ته على المستهام فيك جمالاً","https://www.poetsgate.com/ViewPoem.aspx?id=116381",""],[6088,"يا عيد","https://www.poetsgate.com/ViewPoem.aspx?id=207610",""],[6202,"هوى وشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86757&r=&rc=58",""],[454,"أوحى الفؤاد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82680&r=&rc=44",""]],"verses":[["زِدنَ الرَزايا فَنَقَصنَ دَفعَةً","وَوُطِّنَ القَلبُ عَليها فَاِطمَأَنّ",0,"ن",1,0],["زِدتَ سَبقاً عَلى أَبيكَ وَكانَت","غايَةُ المَجدِ لَو لَحِقتَ أَباكا",1,"ك",2,0],["زِدْتَ للمَسْلِمِينَ فِي الدَّهْرِ عِيدا","ثَانيا يَا مُؤمَّلَ المَسْلِمِينَا",2,"ن",2,0],["زِدْتهِ بِرّاً بِأَنْ كُنْتِ لَهُ","نِعْمَةَ القُدْوَةُ فِي دُنْيَا وَدِينْ",3,"ن",1,0],["زِدنا عَلى وَجدِها وَجداً وَإِن رَجَعَت","في القَلبِ مِنها خُطوبٌ ذاتُ بُلبالِ",4,"ل",1,0],["زِدناهُما شَرَفاً رَفيعاً سَمكُهُ","ثَبتَ الدَعائِمِ إِذ تَخَوَّلناهُما",5,"م",2,0],["زِدْ كلّ يومٍ في العلى رفعةً","وليصنع الحسَّاد ما يصنعوا",6,"ع",3,0],["زدْ كل يومٍ في العلى رفعةً","وليصنع الحاسد ما يصنع",7,"ع",1,0],["زِد لِيَ الشَمرَ كُلَّما","قُلتُ يا صاحِبي زِدِ",8,"د",1,0],["زِدهُم أَميرَ المُؤمِنينَ مِنَ القُوى","إِنَّ القُوى عِزٌّ لَهُم وَقَوامُ",9,"م",1,0],["زِدني اِشتِياقاً بِالمُدامِ وَغَنِّني","أَعزِز عَلَيَّ بِفُرقَةِ القُرَناءِ",10,"ا",2,0],["زِدنَني صَبوَةً وَذَكَّرنَني عَه","داً قَديماً مِن ناقِضٍ لِلعُهودِ",11,"د",1,0],["زِدهُمُ يا أَبا سَعيدٍ فَما السُؤ","دُدُ إِلّا زِيادَةُ الشاكِرينا",12,"ن",2,0],["زِدْني منَ العَذلِ فيها أيُّها اللاحي","إنَّ الفُؤادَ إليها جِدُّ مُرتاحِ",13,"ح",1,1],["زِدتُ في حُبِّ مَدحِكِ فَاِرتَح","لِعَبيطِ المَديحِ وَالإِرجازِ",14,"ز",1,0],["زدْ زادك اللّه في صَوْن الهدى نَظَراً","إنّ الصليبَ ليشقى منك والصنمُ",15,"م",1,0],["زِدْهَا من الوصفِ البديعِ وغنِّنا","للَّهِ دَرُّكَ يا ابنَ حربٍ شاديا",16,"ي",2,0],["زِدْني بفَرْطِ الحُبّ فيك تَحَيّرا","وارْحَمْ حشىً بلَظَى هواكَ تسعّرا",17,"ر",2,1],["زِدني مِنَ النَوحِ وَاِسعِدني عَلى حَزَني","حَتّى تَرى عَجَباً مِن فَيضِ أَجفاني",18,"ن",2,0],["زِدْنِي جَمِيلاً أَزُدْك حَمْدَا","لَمْ تُبْقِ لِي غَيْرَ ذاكَ ذُخْرَا",19,"ر",2,1],["زدني أَسىً لا أَبوكَ يُجزى","عَنكَ وَلا أَنتَ عَنهُ جازِ",20,"ز",1,0],["زِد وَأَبِّنهُ يا فَمي","أَملِ ما شِئتَ يُنسَخِ",21,"خ",1,0],["زِد في الجَهالَةِ يا عَدُوّي شامِتاً","وَإِذا أَرَدتَ تَبَرِّياً فَتَنَزّهُ",22,"ه",1,0],["زِدنا بمنطقك الوجيز صبابةٍ","فهو السَّلاف وكلُّنا نشوان",23,"ن",1,0],["زدتني في الهوى غراما ووجدا","وولوها ولست ابغي سواكا",24,"ك",2,0],["زدنا تقى وعافنا من البلا","واصلح لنا شؤننا بين الملا",25,"ل",2,0],["زدتني فتنةً وليس جميلاً","من هجران والهٍ مفتون",26,"ن",1,0],["زِدتَهُ في الأنامِ هُوناً فَمَا أَغ","نَيتَ عَنهُ ومَا كَفَفتَ أرِيمَا",27,"م",2,0],["زدني قِلىً واهجرْ فذلك بُغْيَتي","من بعدِ كونِى والورى سِيّان",28,"ن",1,0],["زِدنا فإنّا شكرنا حسن فِعلكم","وقد يُزَادُ على الإحسان مَن شكرا",29,"ر",2,0],["زِدتُّ تيهاً بِهِ عَلى كُلِّ مَلبو","سٍ وَفَخراً فَزادَهُ اللَهُ فَخرا",30,"ر",2,0],["زِدْ فِي تَسَعُّرِهَا أَزِدْكَ تَذَلُّلاً","فَقَسَاوَةُ الأَجْلاَفِ لاَ أَرْضَاهَا",31,"ا",3,0],["زِدْ فِي تَحَرُّقِهَا فَزَادَ اللهُ فِي","أَكْبَادِهَا غَيْظاً يَحُلُّ عُرَاهَا",31,"ا",3,0],["زدني من نور هداك ضيا","وامنح قلبي نفحاتك يا",32,"ي",2,0],["زدتِ يا بيروت نوراً","ببهاء ابن سعادهْ",33,"د",2,1],["زد علا ما لحده من تناه","آمنا آمراً على الدهر ناه",34,"ه",1,1],["زدعلا يبعد الحسود ويبدي","لك من لمح ناظريه الدسيسا",35,"س",2,0],["زدنا السيوفَ مضاءً من مضاربنا","ومن مطاعننا زدنا القنا لينا",36,"ن",2,0],["زِد عُلُوّاً يا أَيُّها المَلِكُ الأش","رَفُ حَتّى تَحوزَ كُلَّ المَمالِك",37,"ك",1,1],["زِدتُماني شَوقاً لظبيٍ غَريرٍ","حين أشبهتُماهُ ثغراً وَقَدّا",38,"د",2,0],["زدوا مهجتي ضرا على الضر في الهوى","ولا تأسفوا يوما على مدمعي الجاري",39,"ي",1,1],["زِدْتَ فِيها زادَكَ اللَّهُ عُلاً","عُمْرَ بَدْرَ التِّمِّ لمَّا كَمَلا",40,"ل",2,1],["زد علوّا وَرِفعَة يا اِبن تاج","بِاِمتِداح النَبِيّ طه الشَفيع",41,"ع",1,0],["زِدْ عُلُوّاً في كلِّ يومٍ ورِفْعَهْ","يا شهاباً من أَيمَنِ الشُّهْبِ طَلْعَهْ",42,"ع",2,1],["زِدْ بأيّامِك ابتهاجاً ومنها ال","عِيدُ باليُمْنِ واحدٌ مَعْدود",43,"د",1,0],["زِدْ خاطري شرراً أو ناظري سَهرا","وزِد عظامي نحولاً والحَشا برحا",44,"ح",2,0],["زِدني ابتِساماً وَقُل لليل دَم أَبَداً","فَأَنتَ وَالكأسُ مُصباحٌ وَمُصباحُ",45,"ح",1,0],["زدني عُلاً لا أرتَضِي باللّهى","حَسبِيَ ما نوّلْتَ مِن مَالِ",46,"ل",1,1],["زِدتَ في تِيهكَ والشيْ","ءُ إِذا زَادَ تَناهَى",47,"ا",3,0],["زِدْني جَوىً يا حُبَّهُم وَأَضِلَّني","يا مُرشِدي عَن مَنْهَجِ السُّلوانِ",48,"ن",1,1],["زِدْ رفعةً إن قيلَ أتْرَ","بَ وانخفِضْ إن قيلَ أثْرى",49,"ر",2,0],["زدنا من الفعل الجميل تطلع","نحو العلا وتقدما وتطورا",50,"ر",2,0],["زدني كما قد زدتُ يزددْ حسنُها","إن المكارم تبعث الأَقوالا",51,"ل",2,0],["زد لجاجاً إذا سألتَ وإلحا","حاً عليه يزِدْك صبراً ورِفْدا",52,"د",2,0],["زدتَ وما انحطُّوا ولكنَّها","إضاءةُ البدرِ على الكوكبِ",53,"ب",1,0],["زدت هماً بنوحها فوق همي","واعتراني حزن على أحزاني",54,"ن",2,0],["زِدتِ سُمُوًّا على مَا","كانَ قَديمَ الزَّمَان",55,"ن",1,0],["زِدْ لانتمائِكَ جذراً ف(العراقُ) هُنا","نهرانِ يحتضنانِ البدءَ والزمناَ",56,"ن",2,0],["زِدْ لانتمائِكَ موسيقَا، يُرَقْرِقُها","ماءُ (الفراتِ) على صدرِ النخيلِ جَنَى",56,"ن",2,0],["زِدتَ الأَكارِمَ في المَكارِمِ شيمَةً","تَستَلُّ في الأَزَماتِ غِلَّ الحُسَّدِ",57,"د",1,0],["زد في علومك وارتفع","عنه وكن حسن السجايا",58,"ا",3,0],["زِدْني مِنَ الشِّعرِ يا جِبريلُ فاكِهةً","ودَعْ ثنَاكَ لِمَنْ لاقَ الثَّنا بهِمِ",59,"م",1,0],["زدتُم غَرامي لا نَقَص","حين زدتم في عتابي",60,"ب",2,0],["زِدني مِن فضلكَ كيما به","تكسب منّي الشكرَ والاِمتنان",61,"ن",1,0],["زدتَ حتَّى لَكِدتَ أن تَعلمَ الغَي","بَ فتدري ما لم يكن وهو غَيبُ",62,"ب",1,0],["زدني وهج ما شئت من شجني","إن كنت مثلي تعرف الشجن",63,"ن",1,0],["زدته رفعة ولا زلت تولي","ساكنيه من نعمة ما استزادوا",64,"د",3,0],["زدتم على حق البريء المكتفي","باللّه حق الغالب القهار",65,"ر",1,0],["زِدْني اشتياقاً فإني زائدٌ ولَعا","يا مَن يُقطِّعُ قلبي في الهوى قِطعا",66,"ع",2,1],["زدت مديحا فزدتني كرما","ويستحق المديح من شكرا",67,"ر",2,0],["زدت فضلا يا أبا الفض","ل على حلم الحليمِ",68,"م",1,0],["زدت ابن زايدةٍ وفقت الفضل يا","طاوي سخا كف ابن طي للأَبدْ",69,"د",1,0],["زدهما الله سموًّا وعلا","وفخاراً شامخاً بين الملا",70,"ل",2,0],["زد وانف خبّر وانتهت للتقويه","مهّد وصل وافصل ولامٌ التعديه",71,"ه",1,0],["زدت الكراسي وادا ويقال ذا","عدد اتى للشؤم من ازمان",72,"ن",1,0],["زدتَ من قربٍ اليهم تحترق","فالزم الأدبار عن آثارهم",73,"م",1,0],["زِدتُ وَجداً يا مَليك الأَنفُسِ","وَصليَ إِن جازَ فيكَ حُبي قَد حَلا",74,"ل",2,0],["زدتِ بالكهرباءِ قصرَكِ نوراً","وهو زاهٍ بالجودِ والعَلياءِ",75,"ا",2,1],["زِد عُلُوّاً في المَجدِ يا اِبنَ عَلِيٍّ","هَكَذا مَن أَرادَ أَن يَتَعالى",76,"ل",2,1],["زدتك ذلاً فزدت تيها","واخطةً ذل من يليها!",77,"ي",3,1],["زِدِني غِنىً وَزِدِ الأَمِيرَ ثَناً","مالِي وَلا لَكَ عِندَهُ عُذرُ",78,"ر",1,0],["زد في هوى اخت الغزال هياما","واقصد حماها كي تنال مراما",79,"م",2,1],["زدت في الزعف ظامية","وانثنت بالريّ عن غُدُره",80,"ر",2,0],["زد يا محيا السرور بِشرا","ويا منى الآملين بُشرا",81,"ر",2,1],["زدتَ بالعيد بهجة وسروراً","يا فريد الزمان في كل مجدِ",82,"د",1,1],["زِد صُدوداً فَقَد نَسينا هَواكَ","وَأَعِضنا مِنَ الصُدودِ قِلاكَ",83,"ك",1,1],["زدت بعداً فزدت فيه اقتراباً","بودادي كذاك حكم القرابه",84,"ب",2,0],["زِدني فقد زادت شُج","وني من حديثك عن رُبوعي",85,"ع",2,0],["زدت حسناً أن السماء وشاحٌ","لك صارت غلالةً زرقاء",86,"ا",2,0],["زدني غراما وإن ذابت به كبدي","ما أنت إلا غذاء الروح والجسد",87,"د",1,1],["زدنا من النظم الذي","هو منقص بزياد زدنا",88,"ن",2,0],["زِد همة سَمَت العيوق هامَتها","وَعَن طَريق المَعالي قَط لَم تعج",89,"ج",1,0],["زِدتُ سُروراً وَاِبتِهاجاً بِهِ","كَأَنَّني راجَعتُ عَصرَ الصِبا",90,"ا",1,0],["زدتني قوَّةً على العيش حَتّى","انني صرتُ طامعاً في الخُلودِ",91,"د",1,0],["زِدني بِفَضلِكَ ايماناً وَمَعرِفَة","وَحلني بِالتُقى يا أَيُّها الصَمد",92,"د",1,0],["زدتم محبا ببعدكم تعبا","ليس يرى غير قربكم أربا",93,"ب",2,1],["زدت له شمس المكارم بعدما","أفلت كرد أبيه شمس نهار",94,"ر",1,0],["زِدْتُمْ بِحُبِّ أَمِيرِ المُؤمِنينَ عُلىً","كَذَا البُحورُ إِذْا زادَتْ بِهَا الغُدُرُ",95,"ر",1,0],["زدني فقد طابَ السماعُ بمدحِ من","بالحُسنِ في بيت الهوى سجنوني",96,"ن",2,0],["زدنا بكل الوقت في الأنعامِ","ربِّ بذي الجلالِ والإكرامِ",97,"م",1,0],["زدنا بها زيادةً لا نقصانْ","معها بسرِّ الله واسم الرحمنْ",98,"ن",1,0],["زدتني فضلاً زاد فقري إليكَ","زد بذاك الفقر اعتمادي عليكَ",99,"ك",1,1],["زدت السنا بلا عنا","إن زرتنا نلنا المنى",100,"ن",2,0],["زِدني جَوى بَل أَستَزدك جَوى","وَإِذا ظَلَمت فَعاوِدِ الظُّلما",101,"م",2,0],["زد نفاراً ما شئت أو شئت وصلا","ها أنا نلت يا أغن المراما",102,"م",2,0],["زدني بحبك تعذيباً أسرُّ به","فليس لي غير ما تهواه من وطر",103,"ر",1,0],["زد على الشب شب","واطرب عسى الكون يطرب",104,"ب",1,0],["زِدْ غَرْسَ رِيِّكَ ريّهُ فلقد","أَضحى بعيدَ العَهْدِ بالعَهْدِ",105,"د",1,0],["زدت قدرا فزدت فيك علاء","فأنا في الدعا بضمن الدياجي",106,"ج",2,0],["زدني هَوى وازداد به جفوةً","إذ كان ما تأتي إليه حسَن",107,"ن",1,0],["زدتنا نعمة فزدناك شكرا","وقليل من العباد الشكور",108,"ر",1,1],