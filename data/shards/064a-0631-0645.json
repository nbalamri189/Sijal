 علي بصري","https://www.aldiwan.net/poem3066.html","البسيط"]],"verses":[["يَرمي المَغارِمَ بِالتِلادِ وَيَنثَني","ثَلِجَ الضَميرِ كَأَنَّهُ لَم يُغرَمِ",0,"م",1,0],["يَرِمنَ في السارِحِ المَرعيِّ مَحبَسُهُ","وَهَمُّهُ اليَومَ أَن يَغدو مَعَ الهَمَلِ",1,"ل",1,0],["يَرمي بِهِ مَلِكُ الأَملاكِ يُعتِبُهُ","قَطعُ الدَليلِ بِما يُعمي مِنَ السُبُلِ",1,"ل",1,0],["يُرِمَّ الفَتّى مِنهُمُ جُهدَهُ","فَإِن قالَ قالَ بَليغاً خَطيبا",2,"ب",2,0],["يَرمي الوُحوشَ عَلى الوُحوشِ زُهاؤُهُ","وَالأَكمُ فيهِ مَعَ الجِيادِ لَواعِبُ",3,"ب",1,0],["يَرميكَ بارِقُها بِأَفلاذِ الحَيا","وَيَفُضُّ فيكَ لَطائِمَ الأَنداءِ",4,"ا",2,0],["يَرْمي بأُلْهوبِهِ والغيْثُ منسَكِبٌ","حتى الْتَقَتْ فيهِ أمْواهٌ ونيرانُ",5,"ن",1,0],["يَرمي العُدُوَّ ودِرْعُهُ مِنْ حِلْمِهِ","فيَقيهِ عاديةَ المَنون القاتِلُ",6,"ل",1,0],["يَرمي بهِمْ سَرَعانَ الخَيلِ شاحِبَةً","تَلُفُّ في الرّوْعِ أعْراجاً بأعْراجِ",7,"ج",1,0],["يَرمي وَراءَكَ وهْوَ مَرْهوبُ الشَّذا","وعَليكَ مُلتَهِبُ الضَّميرِ شَفيقُ",8,"ق",1,0],["يَرْمي بفِطْنَتِهِ الرِّجالَ ولحْظِهِ","فيَميزُ داهِيَها منَ المُتداهي",9,"ي",1,0],["يَرْمي بهِ الغَرَضَ البَعيدَ فيَنْثَني","بطِلابِهِ كثِبُ المَزارِ بَعيدُهُ",10,"د",2,0],["يَرْمِي الصِّعَابَ بِسَعْدِهِ فِيقُودُهَا","ذُلُلاً عَلاَ حَسَبِ الْهَوَى المَرْغُوبِ",11,"ب",1,0],["يَرمي وَراءَ الباقِيا","تِ بِنَفسِهِ رَميَ المُقامِر",12,"ر",1,0],["يَرمي الفِراشَ بِناظِرَيهِ وَيَنثَني","جَزِعاً وَيُقدِمُ بَعدَ ذاكَ وَيُحجِمُ",13,"م",1,0],["يَرمي الأعادي بآراءٍ مُسَدَّدَةٍ","وبالفَوارسِ قد سالَتْ مَذاكيها",14,"ي",3,0],["يَرْمِي بِفِكْرَتِهِ إِلَى أَقْصَى مَدىً","وَيَسِيرُ لا تَعْتَافُهُ الأوْهَامُ",15,"م",1,0],["يرمي به الصوت الرخي","م على الدجى لمعات نور",16,"ر",1,0],["يَرمينَ مِن خَلَلِ السُتورِ بِأَعيُنٍ","فيها السَقامُ وَبُرءُ كُلَّ سَقيمِ",17,"م",1,0],["يرمي بعينيه عدوة الأمد ال","أبعد هل في مطافه ريب",18,"ب",1,1],["يرمين بالحدق القلوب فما ترى","إلا صريع هوى بغير نبالِ",19,"ل",1,0],["يرمي بها فيصيبُ النبلُ حاجته","طوراً ويخُطىء أحياناً فيعتزمُ",20,"م",1,1],["يَرمي بِنا شَطرَ البِلادِ مُشَيَّعٌ","صَدقُ الكَريهَةِ فائِضُ الإِحسانِ",21,"ن",1,0],["يَرمونَ بِالقَولِ سِرّاً في مُهادَنَةٍ","يُهدى إِلَيَّ كَأَنّي لَستُ مِن أَحَدِ",22,"د",1,0],["يرمي الهلال بقوسه أرواحنا","ولقد يصاب القوس بالأوتار",23,"ر",1,0],["يرمي به العمر في خوالفه","وحلبة المجد في سوابقها",24,"ق",3,0],["يرمي بدهياء من فلائقه","في وجه دهياء من فلائقها",24,"ق",3,0],["يرمي العِدا بجوائح","تأتي الفروعَ من الأُروم",25,"م",1,0],["يَرمي الغُيوبَ بِعَينَيهِ وَمَطرِفُهُ","مُغضٍ كَما كَسَفَ المُستَأخِذُ الرَمِدُ",26,"د",1,0],["يَرمي بِعَينَيهِ الغُيوبَ وَطَرفُهُ","مُغضٍ يُصَدِّقُ طَرفُهُ ما يَسمَعُ",27,"ع",1,0],["يَرمينَ بِالحَدَقِ المِراضِ قُلوبَنا","فَغَوِيُّهُنَّ مُكَلَّفٌ مَضرورُ",28,"ر",1,0],["يَرمَقُنو شَذَراً كَأَنّي بِهِ","يَحسَبُني أَطمَعُ في مَجدِهِ",29,"د",2,0],["يَرمَدُّ مِن حَذَرِ الخِلاطِ كَما اِزدَهَت","ريحٌ يَمانِيَةٌ ظَليماً مُجفِلا",30,"ل",2,0],["يرْمِي لِهاوِيَةِ الوُجُودِ","بكلِّ ما يبني الطُّغاهْ",31,"ه",1,0],["يرمى بسهم طالما حاد الورى","عنه وما هو عنهم بالحائد",32,"د",1,0],["يَرمي إِلى الظَلامِ طَر","فاً حائِراً مُذَبذَبا",33,"ب",2,0],["يَرمي وَيُرمى في جِها","دِ العَيشِ غَيرَ مُغَفَّلِ",34,"ل",1,0],["يَرميكِ بِالأُمَمِ الزَمانُ وَتارَةً","بِالفَردِ وَاِستِبدادِهِ يَرميكِ",35,"ك",1,0],["يَرمي بِها الجَيشَ لا بُدٌّ لَهُ وَلَها","مِن شَقِّهِ وَلَوَ أَنَّ الجَيشَ أَجبالُ",36,"ل",1,0],["يَرمي بِها البَلَدَ البَعيدَ مُظَفَّرٌ","كُلُّ البَعيدِ لَهُ قَريبٌ دانِ",37,"ن",1,0],["يرمون داخلها بنفط أبيض","فيه لمن ناواهم إحراقُ",38,"ق",1,0],["يرمي بهنَّ نياطَ كلِّ تنوفةٍ","همٌّ وهمٌّ في الضلوعِ كمينُ",39,"ن",1,0],["يَرمي العَواذِلَ في النَدى مِن جانِبٍ","عَنهُ وَيَرميهِ النَدى عَن جانِبِ",40,"ب",1,0],["يَرمي فَما يَشوي وَيَقتُلُ مَن رَمى","بِسِهامِ لا هَدَفٍ وَلا بُرجاسِ",41,"س",1,0],["يَرمونَ خالِقَهُم بِأَقبَحِ فِعلِهِم","وَيُحَرِّفونَ كِتابَهُ المَنسوقا",42,"ق",2,0],["يرمي بها الأعداء طورا سائقا","يحمي أواخرها وطورا قائدا",43,"د",2,0],["يرمي الخُطوبَ بصائباتِ عَزائمٍ","أضحَت لها جُنَنُ الخطوبِ مَقاتِلا",44,"ل",2,0],["يَرمي بِسَهمٍ مِنَ الأَسقامِ أَسهَمَني","عَن حاجِبٍ لِلكَرى عَن ناظِري حُجَبا",45,"ب",2,0],["يُرَمِّلُ بِالدَمِ شِلوَ الكَمِيِّ","وَيَحنو عَلى البائِسِ المُرمِلِ",46,"ل",1,0],["يرمي ويبرئ في آن وأعجبه","إن الذي في يديه البرء ما علما",47,"م",2,0],["يرمي بثالثَةِ الأثافي قِرْنَهُ","فَالأَرْضُ مِنها تَشتَكي الزلزالا",48,"ل",2,0],["يرمي شدادَ المُعْضِلاتِ بنفسه","بَطَلُ الكفاحِ وَذِمْرُها المغوارُ",49,"ر",1,0],["يَرْمُونَ أغراضَ الحتوفِ بأنفسٍ","وَوُجوهُها لِعُيونِهِم تَتَنَمَّرُ",50,"ر",1,0],["يَرْمي ولكن لا يَفي","برمايةِ الغَرَضِ البعيدِ",51,"د",1,0],["يرْميكَ أوّلَ وَهْلَةٍ بِنشاطِهِ","كالماءِ فُضَّ الخَتْم عن أنبوبهِ",52,"ب",2,0],["يَرمونَني بِعُيونٍ حَشوُها شَرَرٌ","نَواطِقٌ عَن قُلوبٍ حَشوُها مَرَضُ",53,"ض",1,0],["يَرمي بِهِمَّتِهِ إِلَيكَ وَهَمُّهُ","أَمَلٌ لَهُ أَبَداً عَلَيكَ حَرونُ",54,"ن",1,0],["يَرمي بِهِ الأَمَلَ القَصِيَّ فَيَنثَني","مَخضوبَ راءِ الظُفرِ وَالمِنقارِ",55,"ر",1,0],["يَرمونَ أَعطافي بِنَظرَةِ إِحنَةٍ","وُقِدَت كَما تُذكي العُيونَ سَباعُ",56,"ع",1,0],["يَرْمُون باسْمِ الحقِّ وهو خَصيمُهم","فيما يُراقُ من الدّماءِ ويُهْدَرُ",57,"ر",1,0],["يَرْمِي ويُرْمَى لا يَضِنُّ بِنَفْسِهِ","إنّ الضَّنينَ بِنَفْسِه لجبانُ",58,"ن",1,0],["يرمِي به سُودَ الغياهبِ ساطعاً","تَنْجَابُ حول سَناهُ أو تَتشقَّقُ",59,"ق",1,0],["يَرمِي العوانَ بكلِّ أغلبَ باسلٍ","يهفو إلى غَمَراتِها يَتشوَّقُ",59,"ق",1,0],["يَرمِي بحكمتِه النُّفوسَ إذا الْتَوَتْ","ورَمَى الغبيُّ بمكرهِ ودَهائِه",60,"ا",3,0],["يرمي الشُّعوبَ إذا استعصَتْ بطاغيةٍ","جَمِّ الصّواعقِ جبّارِ القُوَى قاسِ",61,"س",1,0],["يَرمِي فريدٌ ويُرمَى بين رُفقتهِ","والحقُّ يَعبِسُ أحياناً ويَبتسمُ",62,"م",1,0],["يرمي المُغيرينَ مُجتاحاً ويَقذفُهم","بالرّائعاتِ من الغاراتِ مُكتسِحا",63,"ح",2,0],["يَرميهِ مِن فَوقِ الزَمانِ وَتَحتِهِ","وَيُريهِ كَيفَ يَدينُ لِلحِدثانِ",64,"ن",1,0],["يَرمي بِأَيّامٍ كَأَنَّ شِدادَها","في كُلِّ جانِحَةٍ نَوافِذُ أَسهُمِ",65,"م",1,0],["يَرمي مَهولاتِ الخُطوبِ بِمِثلِها","مِن عَزمِهِ حَتّى تَقولَ لَهُ قَدي",66,"د",2,0],["يَرمي بِها أَجوازَ كُلِّ مَضَلَّةٍ","غَبراءَ يُحمَدُ عِندَها الإِحجامُ",67,"م",1,0],["يَرْمِي بها كلَّ جبارٍ ويقصمه","إن ظنَّ من سفهٍ أن ليس ينقصمُ",68,"م",1,0],["يَرمي