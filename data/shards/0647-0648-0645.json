13.html","عموديه"],[464,"يا من تلون عهده وتغيرا","https://www.aldiwan.net/poem3198.html","عموديه"],[464,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[464,"ما كنت بالباكي ولا المتباكي","https://www.aldiwan.net/poem3512.html","عموديه"],[464,"زحف الصباح وهذه راياته","https://www.aldiwan.net/poem3624.html","عموديه"],[477,"عفى الزمان مرابعاوملاعبا","https://www.aldiwan.net/poem15213.html","الكامل"],[479,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[500,"أيها المستحلف الليل أفق","https://www.aldiwan.net/poem38032.html","الرمل"],[500,"أهل الحجاب مع الثياب عيونهم","https://www.aldiwan.net/poem38061.html","الكامل"],[514,"كتم الهوى فوشى النحول بسره","https://www.aldiwan.net/poem20801.html","الكامل"],[514,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[515,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[529,"الجواب الحق في هذا بلا","https://www.aldiwan.net/poem37268.html","الرمل"],[538,"حي فيها الإخلاص ولاإقداما","https://www.aldiwan.net/poem47934.html","عموديه"],[538,"إن هتلير الضحايا","https://www.aldiwan.net/poem48208.html","عموديه"],[538,"عفوا إذا أكثرت من إنشادي","https://www.aldiwan.net/poem48209.html","عموديه"],[551,"لا تسلني عن المشيب فمذ جل","https://www.aldiwan.net/poem47238.html","الخفيف"],[551,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[558,"هو ما هو وأنا ما هو أنا","https://www.aldiwan.net/poem33764.html","الرمل"],[558,"شمس لها قلب الموحد مطلع","https://www.aldiwan.net/poem34390.html","الكامل"],[558,"يا من يقول بأنه يدري الفنا","https://www.aldiwan.net/poem34465.html","الكامل"],[558,"عدم أحاط به الوجود","https://www.aldiwan.net/poem34583.html","مجزوء الكامل"],[558,"هذا الكثير الواحد","https://www.aldiwan.net/poem34631.html","مجزوء الكامل"],[558,"هذا الطريق الأقرب","https://www.aldiwan.net/poem34925.html","مجزوء الكامل"],[558,"حرك الذت آلة الأسماء","https://www.aldiwan.net/poem34973.html","الخفيف"],[562,"سل مطلع القمرين من كبد السما","https://www.aldiwan.net/poem52944.html","الكامل"],[575,"إن أكن أشجعا فأنت الرشيد","https://www.aldiwan.net/poem3083.html","الخفيف"],[586,"أكذا بلا سبب ولا ذنب","https://www.aldiwan.net/poem17438.html","أحذ الكامل"],[586,"يا رب قد علقته","https://www.aldiwan.net/poem17603.html","مجزوء الكامل"]],"verses":[["هُوَ ما تَرى فأقِلَّ منْ تَعنيفي","وحَذارِ منْ مُقَلِ الظِّباءِ الهِيفِ",0,"ف",1,1],["هوَ مَلعَبٌ شَرِقَتْ بِنا أرجاؤُهُ","إذْ نَحنُ في حُلَلِ الشّبيبَةِ نَخْطِرُ",1,"ر",1,0],["هوَ مُشْبِهٌ للنّحْلِ في أوصافِه","أفَمُنْكَرٌ أنّي أذُوقُ عُسَيْلَتَهْ",2,"ه",1,0],["هُوَ مُستَقيمٌ مُلتَوٍ هُوَ لَيِّنٌ","صُلبٌ هُوَ الواعي هُوَ المُتَغابي",3,"ب",2,0],["هُوَ ما تَراهُ مُفاوِضاً كَيفَ اِنبَرى","لِكَبيرِهِم بِذَكائِهِ الوَثّابِ",3,"ب",1,0],["هُوَ مُفرَدٌ فَإِذا حَذَفتَ أَخيرَهُ","أَلفَيتَهُ جَمعاً لِذاكَ المُفرَدِ",4,"د",1,0],["هُوَ مِنْ دِعَامِ الصَّرْحِ فِي تَشْيِيدِهِ","وَالصَّرْحُ أَرْكَانٌ رَسَتْ وَدِعَامُ",5,"م",1,0],["هُوَ مُصْحَفٌ آيَاتُهُ وَحْيُ الْفِدَى","وَالْبِرُّ فَاتِحَةٌ بِهِ وَخِتَامُ",6,"م",1,0],["هُوَ مِنْ فِتْيَةِ الفِدَاء فَمَا يُنْكَرُ","مِنْهُ فِي الحُبِّ هَذَا التَّغَالِي",7,"ي",1,0],["هو منتهى آمال كلّ موفَقٍ","هو مورد الصادي وكنز المعدِم",8,"م",1,0],["هو مظهرُ الملك العلي ومطلع ال","نور الجلي بمرقب متعالِ",9,"ل",1,0],["هو من طراز الله إلاّ إنّه","بسرائر النفس الحديثة معلم",10,"م",1,0],["هو ما شئت من جنو","ن وحُمْقٍ ومن هوَجْ",11,"ج",1,0],["هو منه وإليه","وأخوه ورضيعُهْ",12,"ه",1,0],["هو من بينهم شبيهُ أبيه","في الندى والحجى وفضل البيان",13,"ن",1,0],["هُوَ مَن تَرسُمُ الجَمالَ يَداهُ","فَنَراهُ في الطِرسِ أَشهى وَأَحلى",14,"ل",2,0],["هُوَ مَن نَراهُ سائِراً فَوقَ الثَرى","وَكَأَنَّ فَوقَ فُؤادِهِ خُطُواتِهِ",14,"ه",1,0],["هُوَ مَن يَعيشُ لِغَيرِه وَيَظُنُّهُ","مَن لَيسَ يَفهَمُهُ يَعيشُ لِذاتِهِ",14,"ه",1,0],["هُوَ مَلِكٌ كانَ فينا وَمَضى","فَمَضَت أَيّامِنا المُزدَهِرَه",15,"ر",2,0],["هُوَ مَعذورٌ رَأى النا","سَ يَقولونَ فَقالا",16,"ل",2,0],["هو من رقة كدمعي في الحز","ن على نفسه يكاد يسيل",17,"ل",1,0],["هو مقناطيس القلوب اليه","انجذبت اسرابا تريد اتصالا",18,"ل",2,0],["هو من هذه البَنيّات لكن","شرُفت بالمقاصد الأشياء",19,"ا",2,0],["هو مأتم الأخلاق فاتل رثاءها","وتول أسرتها ووال عزاءها",20,"ا",3,1],["هو ما علمت فلا تُقم للوائهم","وزنا ولو ملأوا البلاد هزيما",21,"م",2,0],["هو منشد متفنن","فإذا أجاد أجاد ساحر",22,"ر",1,0],["هُوَ مَحبوبُكَ بادٍ مُحتَجِب","يَعرِفُ الشَوقَ لَهُ مَن يَغتَرِب",23,"ب",1,0],["هُوَ مِن سُيوفِكَ أَغمَدوهُ لِريبَةٍ","ما كانَ يُغمَدُ سَيفُكَ المَسلولُ",24,"ل",1,0],["هُوَ مِن سُيوفِ اللَهِ جَلَّ جَلالُهُ","أَو مِن سُيوفِ الهِندِ عِندَ قَضائِهِ",25,"ا",3,0],["هُوَ ما بَنى الأَعزالُ بِالراحاتِ أَو","هُوَ ما بَنى الشُهَداءُ بِالأَرواحِ",26,"ح",1,0],["هُوَ مِن قُبورِ المُتلَفي","نَ وَمِن قُصورِ المُترَفين",27,"ن",1,0],["هوميرُ أَحدَثُ مِن قُرونٍ بَعدَهُ","شِعراً وَإِن لَم تَخلُ مِن آحادِ",28,"د",1,0],["هُوَ مَنزِلُ الساري وَراحَةُ رائِحٍ","كَثُرَ النَهارُ عَلَيهِ في إِنعابِهِ",29,"ب",2,0],["هُوَ مِثلُ جَدِّ اِبنِ المُهَلَّبِ وَالَّذي","لَهُ عَدَدُ الحَصباءِ مِن ذي التَمَعدُدِ",30,"د",1,0],["هو موقِفٌ برَزتْ بُدورُ خيامهِ","للبَينِ واعترضتْ شموسُ قِبابِه",31,"ب",2,0],["هو مصرع للعبقرية روّعت","في عرشها والتاج والإكليل",32,"ل",1,0],["هومير أمّرهُ الزمانُ لنفسه","وقضت له الأجيال بالسلطان",33,"ن",1,0],["هو منكم وفنُّهُ","علمَ الله فنكم",34,"م",1,0],["هو مسرح وانفض ملعبه","لم يبق لا عينٌ ولا أثر",35,"ر",1,0],["هُوَ مَنْ عَلِمنا في القضيّةِ شَأنَهُ","بُوركتَ من شيخٍ وبُوركَ شانا",36,"ن",2,0],["هو من مَواهِبها فإنْ يَبْخَلْ بما","وَهَبتْ عليها إنّه لَكَفُورُ",37,"ر",1,0],["هو ما يقولُ زعيمُه","ويريد من أَرَبٍ وَسُولْ",38,"ل",1,0],["هُوَ مِهرجانُ اللَهِ فَاِنظُر وَاِخشَعِ","وَاِقرَأ عَلى الصَحبِ الرِسالَةَ وَاِسمَعِ",39,"ع",1,1],["هُوَ مِن رُوحِ ربِّهِ مُستفادٌ","وسَبيلُ المخلوقِ أن يُستفادا",40,"د",2,0],["هُوَ مُلتقَى الجيشَيْنِ فَانْظُرْ هل تَرَى","قَوماً تَظَلُّ عُيُونُهُم تَتلهَّبُ",41,"ب",1,0],["هو مولى المستضعفينَ ينجّي","همْ إذا ما طَغَى البَلاءُ وطَمَّا",42,"م",2,0],["هو مُرتمَى الأبطالِ مالك دُونه","مُتزحزَحٌ فاصبر له يا مُصعَبُ",43,"ب",1,1],["هُوَ من فَيضِ العُبابِ المرتمى","يتقَصَّى الأرض مدّاً واطّرادا",44,"د",2,0],["هُوَ مَفرِقٌ في السِلمِ يَلبِسُ مِنكُمُ","تاجاً وَفي حَربِ الحَوادِثِ مِغفَرا",45,"ر",2,0],["هُوَ مَدَّ بَيتَ المَجدِ حَي","ثُ بَناهُ شَمّاسٌ وَعامِر",46,"ر",1,0],["هُوَ مِثلُ الهُسامِ بَينَ غِرارَي","هِ فَهَذا وَذا يُجاهِدُ عَنهُ",47,"ن",2,0],["هوَ ما قد رآهُ مِن قبلُ لكنْ","ما عَلَى مِثْلِهِ يُعَدُّ الخَطَاءُ",48,"ا",2,0],["هُوَ من سمت فيه الحَيا","ة فَلا يَخاف وَلا يخيف",49,"ف",1,0],["هُوَ من أَبى ان تشمخر","رَ عَلَيه للكبر الأنوف",49,"ف",1,0],["هُوَ من إذا اقتحم الزعو","فَ فَلا تثبطه الزعوف",49,"ف",1,0],["هُوَ من يَرى بشعاع عق","لٍ لَيسَ تحجبه السجوف",49,"ف",1,0],["هو ما أجمله","وهي ما أجملها",50,"ه",2,1],["هو مهجةٌ فنيَتْ بأرضِ مِعَادِها","ليتمَّ غرسٌ أو يَطيبَ ثِمارُ",51,"ر",1,0],["هو موجةٌ ذابت ببحر وجودها","كيما يثورَ برحُها التيارُ",51,"ر",1,0],["هومير ما غنّى بها طروادة","وكمثلها ما ألهمته حروبها",52,"ب",3,0],["هو من شبابكَ يستمدُّ رجاءَهُ","ويَسود باسمكَ في الحياةِ ويحكُمُ",53,"م",1,0],["هُوَ ما زالَ على فِطرَتِهِ","ضَاحكاً خَلفَ حديد القَفصِ",54,"ص",1,0],["هو مثلي حيرانُ يضربُ في ال","ليل ويجتاز كل واد سحيقِ",55,"ق",1,0],["هو مهد السحرِ الخفيِّ ومثوى","ما تُجِنُّ الصحراءُ من معجزاتِ",56,"ت",1,0],["هو من رواسي المجد إِلا أنه","عَصَفَ الزمانُ بجانِبَيْهِ فمادا",57,"د",2,0],["هو مثل هذا الطير في صدحاته","والزهر لطفا والعبير نفاحا",58,"ح",2,0],["هو مأتمُ الأحرار في متوثّبٍ","بصفوفهم مستقتلٍ مقدامِ",59,"م",1,0],["هوَ مِثْلُه في الفضْل إلاّ أنّه","لم يأتِه بِرسالَةٍ جِبْريلُ",60,"ل",1,0],["هُوَ مَرْمَى نَبْلِي وَمَلْعَبُ خَيْلِي","وَحِمَى أُسْرَتِي وَمَرْكَزُ بَنْدِي",61,"ي",1,0],["هُوَ مَا قُلْتُ فاحْذَرَنْهَا صَبَاحَا","غَارَةً تَمْلأُ الْفَضَاءَ رِمَاحَا",62,"ح",2,1],["هُوَ مَوْلِدٌ عَمَّ الْكِنانَةَ نُورُهُ","فَتَباشَرَتْ بِالْيُمْنِ وَالسَّرّاءِ",63,"ا",2,0],["هُوَ مُفْتَدَى شَعْبٍ وَفِيٍّ صَادِقٍ","فَلْيَحْيَا ذَاكَ الْمُفْتَدَى وَالمُفْتَدِي",64,"د",2,0],["هُوَ مَحْضُ مُوسِيقَى وَحِسَّ","اتٌ تُصَوِّرُهَا الضُّرُوبُ",65,"ب",1,0],["هُوَ مَا بَكَاهُ الْقَلْبُ لاَ","مِعْيَارُ مَا جَرَتِ الغُرُوبُ",65,"ب",1,0],