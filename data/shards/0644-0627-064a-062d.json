],[365,"بملتقى لحظنا البرق الذي ومضا","https://www.aldiwan.net/poem60862.html","البسيط"],[365,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[367,"أما الذي يخفي الفؤاد فأكبر","https://www.aldiwan.net/poem16985.html","الكامل"],[367,"أما ومنك على أعدائك الطلب","https://www.aldiwan.net/poem17155.html","البسيط"],[367,"أهذه سير في المجد أم سور","https://www.aldiwan.net/poem17202.html","البسيط"],[372,"فليت شعري عن النوائب من","https://www.aldiwan.net/poem57115.html","المنسرح"],[372,"لم تمح بالدمع بعد البين آماقي","https://www.aldiwan.net/poem57257.html","البسيط"],[372,"أخيلت للصب أشواقه","https://www.aldiwan.net/poem57270.html","الطويل"],[381,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[392,"يا أيها الإنسان","https://www.aldiwan.net/poem54429.html","عموديه"],[406,"البين بين أشجاني وأشجاني","https://www.aldiwan.net/poem49677.html","البسيط"],[417,"قلب يذوب عليك وجدا","https://www.aldiwan.net/poem54142.html","مجزوء الكامل"],[433,"أي فؤاد فيك لم يكلف","https://www.aldiwan.net/poem12670.html","السريع"],[459,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[459,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[459,"صدت بنعمان على طول الصدى","https://www.aldiwan.net/poem56213.html","الرجز"],[459,"أنشد من عهد ليلى غير موجود","https://www.aldiwan.net/poem56215.html","البسيط"],[459,"ليتك لما تكن مسعدا","https://www.aldiwan.net/poem56237.html","السريع"],[462,"خذ ما تشاء من الأيام أو فذر","https://www.aldiwan.net/poem15097.html","البسيط"],[462,"شرف الدولة بحر زاخر","https://www.aldiwan.net/poem15129.html","الرمل"],[462,"أجل ما رمت في آت مقتبل","https://www.aldiwan.net/poem15134.html","البسيط"],[462,"أما اذا سلم الامام الأعظم","https://www.aldiwan.net/poem16018.html","الكامل"],[516,"خذ يا زمان أماناً من يدي أملي","https://www.aldiwan.net/poem12211.html","البسيط"],[552,"صارمت بعدك أشجاني فلا تلم","https://www.aldiwan.net/poem47218.html","البسيط"],[552,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[559,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[563,"ثار الدخان فلم يظهر له لهب","https://www.aldiwan.net/poem52769.html","البسيط"],[563,"ماذا يؤمله الحسود بجهده","https://www.aldiwan.net/poem52870.html","الكامل"],[576,"بعثت لي على فم الطيف قبله","https://www.aldiwan.net/poem3037.html","الخفيف"]],"verses":[["لا يَحتَمي بِالرُمحِ باعُ مُؤَيَّدٍ","لَو شاءَ طاعَنَ بِالسِماكِ الأَعزَلِ",0,"ل",1,0],["لِأَيِّ حالٍ يُداري القَلبُ غُلَّتَهُ","رَجاءَ وِردٍ وَوِردي مِنكَ تَصريدُ",1,"د",1,0],["لا يَحفِلُ الحُجّابَ وَالأَبوابا","إِذا دُعوا لَم يُرجِعوا جَوابا",2,"ب",2,0],["لا يَحمِلُ الحِقدَ مَن تَعلو بِهِ الرُتَبُ","وَلا يَنالُ العُلا مَن طَبعُهُ الغَضَبُ",3,"ب",1,1],["لِأَيِّ حَبيبٍ يُحسُنُ الرَأيُ وَالوُدُّ","وَأَكثَرُ هَذا الناسِ لَيسَ لَهُم عَهدُ",4,"د",1,1],["لا يَحْسَبَنَّ الرُّومُ سِلْمَكَ رَهْبَةً","فَالزِّنْدُ لِلنِّيرَانِ فِيهِ ثَوَاءُ",5,"ا",2,0],["لا يَحبَطَن عَمَلٌ أَرضاكَ صالِحُهُ","فَفي سَبيلِكَ أَنفَقتُ الهَوى سَرَفا",6,"ف",2,0],["لاَ يَحمِلُ العَبدُ مِنَّا فَوقَ طَاقَتِهِ","وَنَحنُ نَحمِلُ ما لا تحمل القَلَعُ",7,"ع",1,0],["لا يحرز المجدَ الخطير سوى امرئ","يمطي العزائم صهوةَ الأخطار",8,"ر",1,0],["لا يحسن الإحسان إلاّ هكذا","قد صار طبعاً في النفوس وديدنا",9,"ن",2,0],["لا يَحسُن الشعر إلا وهو مبتكَر","وأيّ حسن لشعر غير مبتكر",10,"ر",1,0],["لا يَحرِمَنِّيَ سَيفُ الدينِ صُحبَتَهُ","فَهيَ الحَياةُ الَّتي تَحيا بِها النَسَمُ",11,"م",1,0],["لا يَحسَبَنَّ المُرجِفونَ بِأَنَّهُم","لَن يُطلَبوا بِدِماءِ أَهلِ الدارِ",12,"ر",1,0],["لا يحزُنُ المرء أن يُنَبَّزَ بال","ألقاب بل أن تشينَهُ خُرَبُهْ",13,"ب",2,0],["لا يَحْدُثَنَّ على ما كان لي حَدَثٌ","فإنّ جارك مضمونٌ له الحدثُ",14,"ث",1,0],["لا يَحِلُّونَ مِن خواطر نفسٍ","مَعَ إحسانهم مَحِلَّةُ مُودِي",15,"د",2,0],["لا يَحرِمُ اللَه الطلولَ الدُّرَّسا","سُقياً تُردِّيهن نوراً أملسا",16,"س",2,0],["لا يحسبنّي امرؤ تمراً ولا أقِطاً","فإنني الصَبَرُ المأدومُ بالبيش",17,"ش",1,0],["لا يَحْزُنَنَّك مَن يمو","تُ فلم يمُتْ من ماتَ قَبلكْ",18,"ك",1,1],["لا يحدثِ اللَّه فَلّاً","في حدّ ذاك الحسامِ",19,"م",1,0],["لا يحسن الظنَّ اللئيمُ بنفسه","فالغثُّ غثٌّ والسمين سمين",20,"ن",1,0],["لا يحقِرُ الفَيْشَاتِ ممن أتتَ","من رجَلٍ ذي كرم أو صَبيّ",21,"ي",1,0],["لا يَحرُمُ السائِلَ الدُنيا إِذا عَرَضَت","وَلا يُعَوَّذُ مِنهُ المالُ بِالقَسَمِ",22,"م",1,0],["لا يَحسُدُ الأَعمى بِهِ مُبصِراً","كِلاهُما قَد ضَلَّ عَن قَصدِهِ",23,"د",2,0],["لا يحفظ الثغر الا الجند محتشدا","فالملك كالعين والاجناد كالهدب",24,"ب",1,0],["لا يحسن النقد جهو","ل باساليب العرب",25,"ب",1,0],["لا يحفظ السلم ابرار ملائكة","ويوقد الحرب اما شاء شيطان",26,"ن",1,0],["لا يحسبنّ المجد وال","علياء في كذب المظاهر",27,"ر",1,0],["لا يَحجِبونَ عَلى تجَنّيهِم وَلا","يَجِدونَ إِلّا الصَفحَ وَالإِغضاءَ",28,"ا",2,0],["لا يَحزُنَنَّكِ مِن حُماتِكِ خِطَّةٌ","كانَت هِيَ المُثلى وَإِن ساؤوكِ",29,"ك",1,0],["لا يُحزِنُ اللَهُ الأَميرَ فَإِنَّني","سَآخُذُ مِن حالاتِهِ بِنَصيبِ",30,"ب",1,1],["لا يَحرِمُ البُعدُ أَهلَ البُعدِ نائِلَهُ","وَغَيرُ عاجِزَةٍ عَنهُ الأُطَيفالُ",31,"ل",1,0],["لا يُحجِمونَ عَنِ الفَلا أَن يَقطَعوا","مِنها إِلَيكَ سَباسِباً وَسُهوبا",32,"ب",2,0],["لا يَحتَذي خُلُقَ القَصِيِّ وَلا يُرى","مُتَشَبِّهاً في سُؤدُدٍ بِغَريبِ",33,"ب",1,0],["لا يَحسِبونَ قُبورَهُم في غُربَةٍ","وَلَوَ انَّها مَضروحَةٌ بِالزَأبَجِ",34,"ج",1,0],["لا يُحِبُّ الثَناءَ نَزراً وَلا يَج","تَلِبُ الشُكرَ بِالنَوالِ الزَهيدِ",35,"د",1,0],["لا يَحمَدُ الرَجَلُ المُحِبُّ صَديقَهُ","مِثلَ الزُلالِ لِذائِقٍ أَو حاسِ",36,"س",1,0],["لا يُحِبُّ الخُرق إِلّا في الوَغى","إِنَّ بَذلَ النَفسِ لِلمَوتِ خُرُق",37,"ق",1,0],["لا يُحمَدُ السَجلُ حَتّى يُحكَمَ الوَذَمُ","وَلا تُرَدُّ بِغَيرِ الواصِلِ النِعَمُ",38,"م",1,1],["لا يَحتَبي بِفِناءِ بَيتِكَ مِثلُهُم","أَبَداً إِذا عُدَّ الفَعالُ الأَفضَلُ",39,"ل",1,0],["لا يَحلِبونَ لِحَيٍّ دَرَّ لَقحَتِهِ","حَتّى يَكونَ لَهُم صَفّو الَّذي حَلَبوا",40,"ب",3,0],["لا يَحرُزُ النَفسَ إِلّا ذو مُراقَبَةٍ","يُمسي وَيُصبِحُ في الدُنيا عَلى وَجَلِ",41,"ل",1,0],["لا يَحفَظُ الصِحَّةَ أَكلُ الفَتى","طَعامَهُ بَينَ شَرابَينِ",42,"ن",1,1],["لا يَحتَوي الأَموالَ إِلّا مِثلَما","يَحوي بِأَطرافِ البَنانِ الزَيبَقُ",43,"ق",1,0],["لا يَحسُنُ الحِلمُ إِلّا في مَواطِنِهِ","وَلا يَليقُ الوَفا إِلّا لِمَن شَكَرا",44,"ر",2,0],["لا يَحفِلونَ وَقَد أَحاطَ عَديدُهُم","بِالدارِ أَيقاظٌ بِها أَو نَوَّمُ",45,"م",1,0],["لا يُحْبَسُ الماءُ إلّا في ثَمائِلها","تيهاً فتحرس نقطاً بالكبود حسي",46,"س",2,0],["لا يُحمَدُ السَجلُ حَتّى يُحكَمَ الوَذَمُ","وَلا تُرَبُّ بِغَيرِ الواصِلِ النِعَمُ",47,"م",1,1],["لا يَحسِبُ الإِقلالَ عُدَماً بَل يَرى","أَنَّ المُقِلَّ مِنَ المُروءَةِ مُعدِمُ",48,"م",1,0],["لا يُحرَمِ الحَرمَانِ خَيراً إِنَّهُم","حُرِموا بِهِ نَوءاً مِنَ الأَنواءِ",49,"ا",2,0],["لِأَيِّ حَبيبٍ يَحسُنُ الرَأيُ وَالوُدُّ","وَأَكثَرُ هَذا الناسِ لَيسَ لَهُ عَهدُ",50,"د",1,1],["لا يُحْسِنُونَ الْمَقَالَ إِنْ نَطَقُوا","جَهْلاً وَلا يَفْقَهُونَ إِنْ أَذِنُوا",51,"ن",3,0],["لا يُحْسِنُونَ التَّقَاضِي فِي الْحُقُوقِ وَلا","يُوفُونَ بِالْعَهْدِ إِلَّا خِيفَةَ النِّقَمِ",52,"م",1,0],["لا يحسبون وجودَهم . ووجودُهم","قبلَ الوجودِ ، وفوقه محسوب",53,"ب",1,0],["لا يَحمِلُ الظُلمُ يَوماً عَرشَ مَملَكَةٍ","وَإِن تَطاوَلَ إِلّا سَوفَ يَنقَلِبُ",54,"ب",1,0],["لا يَحفَظونَ إِذا جارَت حُكومَتُهُم","أَن يَجأَرَ الشَعبُ أَو يَستَصرِخَ الوَطَنُ",55,"ن",1,0],["لا يَحمَدُ المَلِكُ الكَبيرُ أَمينَهُ","حَتّى يُرَدَّ صواعُهُ المفقودُ",56,"د",1,0],["لا يَحبسُ النَّفسَ إلا حينَ يُطلقُها","وليس يَظلِم في حَبْسٍ وإطلاقِ",57,"ق",1,0],["لا يحلُّ القتالُ إلا بحقٍّ","وَهْوَ حَقٌّ مؤكّدٌ وذِمامُ",58,"م",1,0],["لا يحسبون دمَ المُجَاهدِ مَغرماً","هو عندهم إنْ لم يُرِقْهُ المغرم",59,"م",1,0],["لا يَحتَويهِم جانِبٌ","لِلمَحلِ مِنهُ وَلا مُجاوِر",60,"ر",1,0],["لا يَحسَبِ القَينُ أَنَّ العابَ يَغسِلُهُ","عَن قَومِهِ مَعجُهُ بِالزورِ وَالفَنَدِ",61,"د",1,0],["لا يَحُولُ الفُؤادُ عَنكَ بِوُدٍّ","أَبَداً أَو يَحُولَ لَونُ الغُرابِ",62,"ب",1,0],["لا يَحفَظونَ عَلى السَكرانِ زَلَّتَهُ","وَلا يُريبُكَ مِن أَخلاقِهِم رِيَبُ",63,"ب",1,0],["لا يُحسِنُ الدَهرُ إِلّا","شَتيمَةً لي وَبَخسا",64,"س",2,0],["لا يَحمَدُ الوِردَ وَلا المَصادِرا","قَد فَضَحَ البَدوَ وَأَخزى الحاضِرا",65,"ر",2,0],["لا يَحقَبُ القَطرَ إِلّا فاضَ نائِلُهُ","وَلا تَزَلزَلَ إِلّا خِلتَهُ يَقِرُ",66,"ر",1,0],["لا يُحسِنُ الفُحشَ وَيَنكي العِدى","وَيَعتَريهِ الجودُ مِن كُلِّ باب",67,"ب",1,0],["لا يَحدَبونَ عَلى مالٍ بِمَبخَلَةٍ","إِذا اللِئامُ عَلى أَموالِهِم حَدَبوا",68,"ب",3,0],["لا يَحسَبُ الجودَ مِن رَبِّ النَخيلِ جَداً","حَتّى تَجودَ عَلى السودِ الغَرابيبِ",69,"ب",1,1],["لا يَحمِلُ اللَيلُ هَمَّ الساهِرينَ بِهِ","وَلا يُجانِبُ حُزناً وَهُوَ مَرقودُ",70,"د",1,0],["لا يَحلِبونَ لِضَيفٍ طارِقٍ غُمُراً","إِلّا وَثَمَّ نُفوسٌ لِلقِرى خُثُرُ",71,"ر",1,0],["لا يَحرِمُ السائِلَ إِن جاءَهُ","وَلا يُعَقّي سَيبَهُ العاذِلُ",72,"ل",1,0],["لا يَحسِبونَ غِنىً يَبقى وَلا عَدَماً","إِذا رَأى ذاكَ مِنهُم مَعشَرٌ فُرُطُ",73,"ط",1,0],["لا يَحْتَجِبْ وَجْهُكَ المَمْقُوتُ عنْ أَحَدٍ","فَالمَقْتُ يَحْجُبُهُ مِنْ غَيْرِ حُجَّابِ",74,"ب",1,0],["لا يحسن الشعر إلا ال","لذي له فيه باع",75,"ع",1,0],["لا يحرز النصر في الحر","ب غير أَهل الثبات",76,"ت",1,0],["لا يحسب الزحف غيا","جند له عظموتُ",77,"ت",1,1],["لا يحمل اليوم إنسان بلا تعب","ما للحَياة عَلى الإنسان من ثقل",78,"ل",1,0],["لا يحدث الشيء من تلقائه عرضا","لكل حادثة لا بر من سبب",79,"ب",1,0],["لاَ يَحْمَدُ القَوْمُ نَقَّاداً يُضَامُ بِهِ","خِيَارُهُمْ فَهْوَ مِثْلُ المَوْت نَقَّادُ",80,"د",1,0],["لاَ يُحَاشَى أَبُو نُوَّاسُ وَبَشَّا","رُ بْنُ بُرْدِ وَمَسْلِمٌ وَجَرِيرُ",81,"ر",1,0],["لايحيران أخرسينْ","وعلى الخدِ دمعتينْ",82,"ن",1,0],["لا يحصد المرءُ عند فاقته","إلا الذي في حياته زرعا",83,"ع",2,0],["لا يُحْسَدُ الجاهُ على مالِه","أو يُنْهَرُ الْبُؤْسُ على فَقْرِهِ",84,"ر",2,0],["لا يحكمون الشعبَ إلا بالعَصَا","والسَّوْط مُعْتَزِّين باستِذْلالِهِ",85,"ل",2,0],["لا يُحقُّ الحقَّ إلا قوَّةٌ","تفعلُ القوةُ ما يُعيي القَضَاةْ",86,"ا",2,0],["لا يحسب العرشُ أنَّ الشعبَ خادمُهُ","العرشُ -لولا سَوادُ الشعب- لم يَسُدِ",87,"د",1,0],["لا يحط الدهرُ مَنْ يرفعُه","لا، ولا يرفع قَدْرًا وضعه",88,"ع",2,0],["لا يحسم القولُ عدوانًا على وطنٍ","وإنما يحسم العدوانَ عدوان",89,"ن",1,0],["لا يحرز النصرَ جيشٌ غيرُ متَّسِقٍ","تباينت فيه أجْنَادٌ وأبناد",90,"د",1,0],["لا 