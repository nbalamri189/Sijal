,""],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135102","البسيط"],[4359,"","https://poetry.dctabudhabi.ae/diwan/poem/141163","السريع"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104539","البسيط"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139194","السريع"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139138","السريع"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66138","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72351","الخفيف"],[4797,"ماكني أعرفه","https://www.poetsgate.com/ViewPoem.aspx?id=132236",""],[4869,"غاب اتصاله","https://www.poetsgate.com/ViewPoem.aspx?id=151621",""],[4929,"إكمال شطر بيت عنترة","https://www.poetsgate.com/ViewPoem.aspx?id=201084",""],[4984,"الفارق","https://www.poetsgate.com/ViewPoem.aspx?id=191328",""],[3271,"دمعة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=104119",""],[5136,"هل يبلغن الرسول مالكه","https://www.poetsgate.com/ViewPoem.aspx?id=121565",""],[5185,"القصيدة اليمانية","https://www.poetsgate.com/ViewPoem.aspx?id=74641",""],[5189,"إنّ الدنا قد أمطرت فِتنا","https://www.poetsgate.com/ViewPoem.aspx?id=210214",""],[5268,"ماسَت يداكِ","https://www.poetsgate.com/ViewPoem.aspx?id=207007",""],[5278,"سُلَّم الغربِ...","https://www.poetsgate.com/ViewPoem.aspx?id=202551",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[5363,"يا باعث الأشجان","https://www.poetsgate.com/ViewPoem.aspx?id=144151",""],[5409,"لا يحرم الكذب من ناسٍ تصدقه","https://www.poetsgate.com/ViewPoem.aspx?id=155438",""],[5674,"طوبى","https://www.poetsgate.com/ViewPoem.aspx?id=186160",""],[5690,"سر أريحَّ الشمال سرْ بسلام","https://www.poetsgate.com/ViewPoem.aspx?id=172187",""],[5804,"اغتنم الخير قبل أن ترحل","https://www.poetsgate.com/ViewPoem.aspx?id=214738",""],[5829,"في مخيم الكشافة","https://www.poetsgate.com/ViewPoem.aspx?id=161989",""],[5952,"آخر الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=204836",""],[5952,"في يوم مولده","https://www.poetsgate.com/ViewPoem.aspx?id=207804",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[5956,"مُقَلُ النِّسوانْ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182614",""],[5956,"الهلال الباكي","https://www.poetsgate.com/ViewPoem.aspx?id=183341",""],[5956,"الشعور بالنقص حافزٌ للكمال","https://www.poetsgate.com/ViewPoem.aspx?id=184481",""],[5956,"البلدة السعيدة","https://www.poetsgate.com/ViewPoem.aspx?id=185792",""],[5956,"لا عدل في الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=192298",""],[5956,"ما عيب شهم أن يؤازر أشهما","https://www.poetsgate.com/ViewPoem.aspx?id=202505",""],[5956,"حارس الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=206676",""],[4442,"قبلت خديه وهو نائم","https://www.poetsgate.com/ViewPoem.aspx?id=171022",""],[6127,"يا ثورة الآس","https://www.poetsgate.com/ViewPoem.aspx?id=205889",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""],[520,"يهوى الحبيبين من بأس ومن كرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577609",""],[6183,"أنت المغني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79843&r=&rc=33",""]],"verses":[["لا يَحتَمي بِالرُمحِ باعُ مُؤَيَّدٍ","لَو شاءَ طاعَنَ بِالسِماكِ الأَعزَلِ",0,"ل",1,0],["لِأَيِّ حالٍ يُداري القَلبُ غُلَّتَهُ","رَجاءَ وِردٍ وَوِردي مِنكَ تَصريدُ",1,"د",1,0],["لا يَحفِلُ الحُجّابَ وَالأَبوابا","إِذا دُعوا لَم يُرجِعوا جَوابا",2,"ب",2,0],["لا يَحمِلُ الحِقدَ مَن تَعلو بِهِ الرُتَبُ","وَلا يَنالُ العُلا مَن طَبعُهُ الغَضَبُ",3,"ب",1,1],["لِأَيِّ حَبيبٍ يُحسُنُ الرَأيُ وَالوُدُّ","وَأَكثَرُ هَذا الناسِ لَيسَ لَهُم عَهدُ",4,"د",1,1],["لا يَحْسَبَنَّ الرُّومُ سِلْمَكَ رَهْبَةً","فَالزِّنْدُ لِلنِّيرَانِ فِيهِ ثَوَاءُ",5,"ا",2,0],["لا يَحبَطَن عَمَلٌ أَرضاكَ صالِحُهُ","فَفي سَبيلِكَ أَنفَقتُ الهَوى سَرَفا",6,"ف",2,0],["لاَ يَحمِلُ العَبدُ مِنَّا فَوقَ طَاقَتِهِ","وَنَحنُ نَحمِلُ ما لا تحمل القَلَعُ",7,"ع",1,0],["لا يحرز المجدَ الخطير سوى امرئ","يمطي العزائم صهوةَ الأخطار",8,"ر",1,0],["لا يحسن الإحسان إلاّ هكذا","قد صار طبعاً في النفوس وديدنا",9,"ن",2,0],["لا يَحسُن الشعر إلا وهو مبتكَر","وأيّ حسن لشعر غير مبتكر",10,"ر",1,0],["لا يَحرِمَنِّيَ سَيفُ الدينِ صُحبَتَهُ","فَهيَ الحَياةُ الَّتي تَحيا بِها النَسَمُ",11,"م",1,0],["لا يَحسَبَنَّ المُرجِفونَ بِأَنَّهُم","لَن يُطلَبوا بِدِماءِ أَهلِ الدارِ",12,"ر",1,0],["لا يحزُنُ المرء أن يُنَبَّزَ بال","ألقاب بل أن تشينَهُ خُرَبُهْ",13,"ب",2,0],["لا يَحْدُثَنَّ على ما كان لي حَدَثٌ","فإنّ جارك مضمونٌ له الحدثُ",14,"ث",1,0],["لا يَحِلُّونَ مِن خواطر نفسٍ","مَعَ إحسانهم مَحِلَّةُ مُودِي",15,"د",2,0],["لا يَحرِمُ اللَه الطلولَ الدُّرَّسا","سُقياً تُردِّيهن نوراً أملسا",16,"س",2,0],["لا يحسبنّي امرؤ تمراً ولا أقِطاً","فإنني الصَبَرُ المأدومُ بالبيش",17,"ش",1,0],["لا يَحْزُنَنَّك مَن يمو","تُ فلم يمُتْ من ماتَ قَبلكْ",18,"ك",1,1],["لا يحدثِ اللَّه فَلّاً","في حدّ ذاك الحسامِ",19,"م",1,0],["لا يحسن الظنَّ اللئيمُ بنفسه","فالغثُّ غثٌّ والسمين سمين",20,"ن",1,0],["لا يحقِرُ الفَيْشَاتِ ممن أتتَ","من رجَلٍ ذي كرم أو صَبيّ",21,"ي",1,0],["لا يَحرُمُ السائِلَ الدُنيا إِذا عَرَضَت","وَلا يُعَوَّذُ مِنهُ المالُ بِالقَسَمِ",22,"م",1,0],["لا يَحسُدُ الأَعمى بِهِ مُبصِراً","كِلاهُما قَد ضَلَّ عَن قَصدِهِ",23,"د",2,0],["لا يحفظ الثغر الا الجند محتشدا","فالملك كالعين والاجناد كالهدب",24,"ب",1,0],["لا يحسن النقد جهو","ل باساليب العرب",25,"ب",1,0],["لا يحفظ السلم ابرار ملائكة","ويوقد الحرب اما شاء شيطان",26,"ن",1,0],["لا يحسبنّ المجد وال","علياء في كذب المظاهر",27,"ر",1,0],["لا يَحجِبونَ عَلى تجَنّيهِم وَلا","يَجِدونَ إِلّا الصَفحَ وَالإِغضاءَ",28,"ا",2,0],["لا يَحزُنَنَّكِ مِن حُماتِكِ خِطَّةٌ","كانَت هِيَ المُثلى وَإِن ساؤوكِ",29,"ك",1,0],["لا يُحزِنُ اللَهُ الأَميرَ فَإِنَّني","سَآخُذُ مِن حالاتِهِ بِنَصيبِ",30,"ب",1,1],["لا يَحرِمُ البُعدُ أَهلَ البُعدِ نائِلَهُ","وَغَيرُ عاجِزَةٍ عَنهُ الأُطَيفالُ",31,"ل",1,0],["لا يُحجِمونَ عَنِ الفَلا أَن يَقطَعوا","مِنها إِلَيكَ سَباسِباً وَسُهوبا",32,"ب",2,0],["لا يَحتَذي خُلُقَ القَصِيِّ وَلا يُرى","مُتَشَبِّهاً في سُؤدُدٍ بِغَريبِ",33,"ب",1,0],["لا يَحسِبونَ قُبورَهُم في غُربَةٍ","وَلَوَ انَّها مَضروحَةٌ بِالزَأبَجِ",34,"ج",1,0],["لا يُحِبُّ الثَناءَ نَزراً وَلا يَج","تَلِبُ الشُكرَ بِالنَوالِ الزَهيدِ",35,"د",1,0],["لا يَحمَدُ الرَجَلُ المُحِبُّ صَديقَهُ","مِثلَ الزُلالِ لِذائِقٍ أَو حاسِ",36,"س",1,0],["لا يُحِبُّ الخُرق إِلّا في الوَغى","إِنَّ بَذلَ النَفسِ لِلمَوتِ خُرُق",37,"ق",1,0],["لا يُحمَدُ السَجلُ حَتّى يُحكَمَ الوَذَمُ","وَلا تُرَدُّ بِغَيرِ الواصِلِ النِعَمُ",38,"م",1,1],["لا يَحتَبي بِفِناءِ بَيتِكَ مِثلُهُم","أَبَداً إِذا عُدَّ الفَعالُ الأَفضَلُ",39,"ل",1,0],["لا يَحلِبونَ لِحَيٍّ دَرَّ لَقحَتِهِ","حَتّى يَكونَ لَهُم صَفّو الَّذي حَلَبوا",40,"ب",3,0],["لا يَحرُزُ النَفسَ إِلّا ذو مُراقَبَةٍ","يُمسي وَيُصبِحُ في الدُنيا عَلى وَجَلِ",41,"ل",1,0],["لا يَحفَظُ الصِحَّةَ أَكلُ الفَتى","طَعامَهُ بَينَ شَرابَينِ",42,"ن",1,1],["لا يَحتَوي الأَموالَ إِلّا مِثلَما","يَحوي بِأَطرافِ البَنانِ الزَيبَقُ",43,"ق",1,0],["لا يَحسُنُ الحِلمُ إِلّا في مَواطِنِهِ","وَلا يَليقُ الوَفا إِلّا لِمَن شَكَرا",44,"ر",2,0],["لا يَحفِلونَ وَقَد أَحاطَ عَديدُهُم","بِالدارِ أَيقاظٌ بِها أَو نَوَّمُ",45,"م",1,0],["لا يُحْبَسُ الماءُ إلّا في ثَمائِلها","تيهاً فتحرس نقطاً بالكبود حسي",46,"س",2,0],["لا يُحمَدُ السَجلُ حَتّى يُحكَمَ الوَذَمُ","وَلا تُرَبُّ بِغَيرِ الواصِلِ النِعَمُ",47,"م",1,1],["لا يَحسِبُ الإِقلالَ عُدَماً بَل يَرى","أَنَّ المُقِلَّ مِنَ المُروءَةِ مُعدِمُ",48,"م",1,0],["لا يُحرَمِ الحَرمَانِ خَيراً إِنَّهُم","حُرِموا بِهِ نَوءاً مِنَ الأَنواءِ",49,"ا",2,0],["لِأَيِّ حَبيبٍ يَحسُنُ الرَأيُ وَالوُدُّ","وَأَكثَرُ هَذا الناسِ لَيسَ لَهُ عَهدُ",50,"د",1,1],["لا يُحْسِنُونَ الْمَقَالَ إِنْ نَطَقُوا","جَهْلاً وَلا يَفْقَهُونَ إِنْ أَذِنُوا",51,"ن",3,0],["لا يُحْسِنُونَ التَّقَاضِي فِي الْحُقُوقِ وَلا","يُوفُونَ بِالْعَهْدِ إِلَّا خِيفَةَ النِّقَمِ",52,"م",1,0],["لا يحسبون وجودَهم . ووجودُهم","قبلَ الوجودِ ، وفوقه محسوب",53,"ب",1,0],["لا يَحمِلُ الظُلمُ يَوماً عَرشَ مَملَكَةٍ","وَإِن تَطاوَلَ إِلّا سَوفَ يَنقَلِبُ",54,"ب",1,0],["لا يَحفَظونَ إِذا جارَت حُكومَتُهُم","أَن يَجأَرَ الشَعبُ أَو يَستَصرِخَ الوَطَنُ",55,"ن",1,0],["لا يَحمَدُ المَلِكُ الكَبيرُ أَمينَهُ","حَتّى يُرَدَّ صواعُهُ المفقودُ",56,"د",1,0],["لا يَحبسُ النَّفسَ إلا حينَ يُطلقُها","وليس يَظلِم في حَبْسٍ وإطلاقِ",57,"ق",1,0],["لا يحلُّ القتالُ إلا بحقٍّ","وَهْوَ حَقٌّ مؤكّدٌ وذِمامُ",58,"م",1,0],["لا يحسبون دمَ المُجَاهدِ مَغرماً","هو عندهم إنْ لم يُرِقْهُ المغرم",59,"م",1,0],["لا يَحتَويهِم جانِبٌ","لِلمَحلِ مِنهُ وَلا مُجاوِر",60,"ر",1,0],["لا يَحسَبِ القَينُ أَنَّ العابَ يَغسِلُهُ","عَن قَومِهِ مَعجُهُ بِالزورِ وَالفَنَدِ",61,"د",1,0],["لا يَحُولُ الفُؤادُ عَنكَ بِوُدٍّ","أَبَداً أَو يَحُولَ لَونُ الغُرابِ",62,"ب",1,0],["لا يَحفَظونَ عَلى السَكرانِ زَلَّتَهُ","وَلا يُريبُكَ مِن أَخلاقِهِم رِيَبُ",63,"ب",1,0],["لا يُحسِنُ الدَهرُ إِلّا","شَتيمَةً لي وَبَخسا",64,"س",2,0],["لا يَحمَدُ الوِردَ وَلا المَصادِرا","قَد فَضَحَ البَدوَ وَأَخزى الحاضِرا",65,"ر",2,0],["لا يَحقَبُ القَطرَ إِلّا فاضَ نائِلُهُ","وَلا تَزَلزَلَ إِلّا خِلتَهُ يَقِرُ",66,"ر",1,0],["لا يُحسِنُ الفُحشَ وَيَنكي العِدى","وَيَعتَريهِ الجودُ مِن كُلِّ باب",67,"ب",1,0],["لا يَحدَبونَ عَلى مالٍ بِمَبخَلَةٍ","إِذا اللِئامُ عَلى أَموالِهِم حَدَبوا",68,"ب",3,0],["لا يَحسَبُ الجودَ مِن رَبِّ النَخيلِ جَداً","حَتّى تَجودَ عَلى السودِ الغَرابيبِ",69,"ب",1,1],["لا يَحمِلُ اللَيلُ هَمَّ الساهِرينَ بِهِ","وَلا يُجانِبُ حُزناً وَهُوَ مَرقودُ",70,"د",1,0],["لا يَحلِبونَ لِضَيفٍ طارِقٍ غُمُراً","إِلّا وَثَمَّ نُفوسٌ لِلقِرى خُثُرُ",71,"ر",1,0],["لا يَحرِمُ السائِلَ إِن جاءَهُ","وَلا يُعَقّي سَيبَهُ العاذِلُ",72,"ل",1,0],["لا يَحسِبونَ غِنىً يَبقى وَلا عَدَماً","إِذا رَأى ذاكَ مِنهُم مَعشَرٌ فُرُطُ",73,"ط",1,0],["لا يَحْتَجِبْ وَجْهُكَ المَمْقُوتُ عنْ أَحَدٍ","فَالمَقْتُ يَحْجُبُهُ مِنْ غَيْرِ حُجَّابِ",74,"ب",1,0],["لا يحسن الشعر إلا ال","لذي له فيه باع",75,"ع",1,0],["لا يحرز النصر في الحر","ب غير أَهل الثبات",76,"ت",1,0],["لا يحسب الزحف غيا","جند له عظموتُ",77,"ت",1,1],["لا يحمل اليوم إنسان بلا تعب","ما للحَياة عَلى الإنسان من ثقل",78,"ل",1,0],["لا يحدث الشيء من تلقائه عرضا","لكل حادثة لا بر من سبب",79,"ب",1,0],["لاَ يُحْمِدُ النَّاسَ بِالشَّيْءِ القَلِيلِ ولاَ","يُهْدَى لَهُ الذَّمُ مِنْ ضَيْفِ ولاَ جَارِ",80,"ر",1,0],["لاَ يُحْرِزُ المَرْءَ أَنْصَارٌ ورَابِيَةٌ","تَأْبَى الهَوَانَ إِذَا عُدَّ الجَرَاثِيمُ",81,"م",1,0],["لاَ يَحْمَدُ القَوْمُ نَقَّاداً يُضَامُ بِهِ","خِيَارُهُمْ فَهْوَ مِثْلُ المَوْت نَقَّادُ",82,"د",1,0],["لاَ يُحَاشَى أَبُو نُوَّاسُ وَبَشَّا","رُ بْنُ بُرْدِ وَمَسْلِمٌ وَجَرِيرُ",83,"ر",1,0],["لايحيران أخرسينْ","وعلى الخدِ دمعتينْ",84,"ن",1,0],["لا يحصد المرءُ عند فاقته","إلا الذي في حياته زرعا",85,"ع",2,0],["لا يُحْسَدُ الجاهُ على مالِه","أو يُنْهَرُ الْبُؤْسُ على فَقْرِهِ",86,"ر",2,0],["لا يحكمون الشعبَ إلا بالعَصَا","والسَّوْط مُعْتَزِّين باستِذْلالِهِ",87,"ل",2,0],["لا يُحقُّ الحقَّ إلا قوَّةٌ","تفعلُ القوةُ ما يُعيي القَضَاةْ",88,"ا",2,0],["لا يحسب العرشُ أنَّ الشعبَ خادمُهُ","العرشُ -لولا سَوادُ الشعب- لم يَسُدِ",89,"د",1,0],["لا يحط الدهرُ مَنْ يرفعُه","لا، ولا يرفع قَدْرًا وضعه",90,"ع",2,0],["لا يحسم القولُ عدوانًا على وطنٍ","وإنما يحسم العدوانَ عدوان",91,"ن",1,0],["لا يحرز النصرَ جيشٌ غيرُ متَّسِقٍ","تباينت فيه أجْنَادٌ وأبناد",92,"د",1,0],["لا يحسَب القوم أن العُرْبَ قد عَقِموا","شعبُ العُروبة للأبطال ولاَّدَ",92,"د",1,0],["لا يحجب الموت جبن عند موقعه","ولا يقدم وعد الموت شجعان",93,"ن",1,0],["لا يحل بينكم وبين هواكم","عند ابرام أمركم وكلاء",94,"ا",2,0],["لا يحسّ الذي اشرّانا لماذا","والذي باع ما درّى كيف باعا .. !",95,"ع",2,0],["لا يُحزِنُ اللَهُ الأَميرَ فَإِنَّني","لآخُذُ مِن حالاتِهِ بِنَصيبِ",96,"ب",1,1],["لايحسب أنه.. نقص..من قيمتي... والا.. حداني..","الجبل.. وش ينقصه..؟ لامن تهاوت منه..؟؟ حيده...",97,"د",2,0],["لا يُحبسَنُ الماءُ إلاّ في ثمائلها","تيهاً فتحرس نقطاً بالكبود حسي",98,"س",2,0],["لا يحسبنّي امرؤ ثمراً ولا أقِطاً","فإنني الصبرُ المأدومُ بالبيش",99,"ش",1,0],["لا يحفلون إذا جارت حكومتهم","أن يجأر الشعب أو يستصرخ الوطن",100,"ن",1,0],["لا يحسن الشعر إلا وهو مبتكر","وأي حسن بشعر غير مبتكر",101,"ر",1,0],["لا يحسن التعبيس أبلج واضحٌ","ضحك الجمال بوجهه وأضاء",102,"ا",2,0],["لا يحمد الورد إلا النذل من قلب","عدا على أَهلها الإملاق والأَمج",103,"ج",1,0],["لا يحل الذَّمُّ سَاحَتَنَا","مِن حمًى دَانٍ ولاَ نَاءِ",104,"ا",2,0],["لا يحسُن المديحُ عند غيره","ولا تراه بسوا