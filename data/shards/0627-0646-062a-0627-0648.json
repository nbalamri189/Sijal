{"poems":[[88,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[74,"يا بروقا على ربى يبرين","https://www.aldiwan.net/poem20165.html","الخفيف"],[74,"جاءت العاذلات شيئا فريا","https://www.aldiwan.net/poem20564.html","الخفيف"],[53,"أنت تيس والتيس أش","https://www.aldiwan.net/poem8717.html","مجزوء الخفيف"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[94,"يا إله الوجود هذي جراح","https://www.aldiwan.net/poem38885.html","الخفيف"],[68,"أنت أوليتني الجميل ولولا","https://www.aldiwan.net/poem40950.html","الخفيف"],[107,"نظم المجد لأبطال الحمى","https://www.aldiwan.net/poem42072.html","الرمل"],[108,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[96,"يا نديمي","https://www.poetsgate.com/ViewPoem.aspx?id=15656",""],[132,"قد قضى لي بالصد والهجر والبلوي","https://www.aldiwan.net/poem50479.html","الخفيف"],[132,"إن فقد الأهلين كان عظيما","https://www.aldiwan.net/poem50499.html","الخفيف"],[164,"من فتى أعطاه موليه المنى","https://www.aldiwan.net/poem58957.html","الرمل"],[208,"ريح شوق للبين كانت سموما","https://www.aldiwan.net/poem53185.html","الخفيف"],[287,"أي ركن وهى من العلماء","https://www.aldiwan.net/poem32295.html","الخفيف"],[406,"حوار مع وردة","https://www.aldiwan.net/poem10297.html","عموديه"],[438,"ضرب الناس في العلا الأمثالا","https://www.aldiwan.net/poem12373.html","الخفيف"],[484,"تونسي وحسبي","https://www.aldiwan.net/poem37610.html","مجزوء الخفيف"],[556,"قل لعيني لا تملا الدموعا","https://www.aldiwan.net/poem47711.html","الخفيف"],[556,"يا مليك الورى ومن عقد الله","https://www.aldiwan.net/poem48114.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122745","الخفيف"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66820","الرمل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97031","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119981","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59410","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56647","الخفيف"],[1894,"","https://poetry.dctabudhabi.ae/diwan/poem/198779","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53080","الخفيف"],[2214,"","https://poetry.dctabudhabi.ae/diwan/poem/113913","الخفيف"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123649","الرمل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126200","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93861","الخفيف"],[2853,"","https://poetry.dctabudhabi.ae/diwan/poem/102465","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62868","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62909","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83347","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83620","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139644",""],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67570","الخفيف"],[4830,"أنغام الأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=200113",""],[5061,"الامير","https://www.poetsgate.com/ViewPoem.aspx?id=147171",""],[5550,"وردةٌ أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=213309",""]],"verses":[["أَنتَ أَورَدتَنا مِنَ الماءِ عَذباً","وَأَراهُم قَد أَورَدونا السَرابا",0,"ب",2,0],["أنت أولى يا بحر علمٍ وبرّ","كل وقت بمثل هذي النون",1,"ن",1,0],["أنتَ أولى مدير ومشير","قرَّبته الملوك منها نجيّا",2,"ي",2,0],["أنت أولى بقرنِهِ","وهو أولى بلحيتِكْ",3,"ك",1,0],["أنت أولى به بحكم القوافي","من نؤومٍ عن المعالي هَدان",4,"ن",1,0],["أَنْتَ أوصَلْتَني إلى سُبُلِ الدُّنيا","وهذي كثيرَةُ الاشْتِباهِ",5,"ه",1,0],["أَنْتَ أوقفتني على لُجَّةِ الحُزْنِ","وجَرَّعتني مَرارَةَ آهِ",5,"ه",1,0],["أَنتَ أَولَيتَني الجَميلَ وَلَولا","ضُعفُ حَظّي لَكُنتُ بِالسَعيِ أَولى",6,"ل",2,1],["أنتَ أوهنتَ قُواهُ كلّما","كَرَّ أقدمتَ فولَّى مُحْجِما",7,"م",2,0],["إن تأوِ بعضَ ضحاياهم بلادُكمو","فكم أوَتْ فاجِرًا منهمْ وشِرِّيرَا",8,"ر",2,0],["أنت أوفى منّي وأوثق عهدا","يا نديمي وأين أين الوفاء",9,"ا",2,0],["أنت أوفَى الأنام إلاًّ وعهداً","أنت يحيى في نُسُكه وصفائِه",10,"ا",3,0],["أنت أولَى بالحلمِ من أن تعزى","بافتقادِ لأنت صرتَ العَليمَا",11,"م",2,0],["أنت أولى الخلق أن توسعه","يا صلاح الدين حمدا وثنا",12,"ن",2,0],["أنت آويتَني وقد طرد النا","سُ رجائي طردَ الوصيِّ اليتيما",13,"م",2,0],["أَنتَ أَولى بِأَن تُرَثّيكَ حَتّى","يُبعَثَ الخَلقُ أَلسُنُ الشُعَراءِ",14,"ا",2,0],["أنت أودعت في التراب بذور","وزنها في العيون وزن ضئيل",15,"ل",1,0],["أَنْتَ أوْجَدْتَهُ وقد كانَ مَعْدُو","ماً وأَوْجَدْتَهُ المقالَ فقالا",16,"ل",2,0],["أنت أول أرض","مس جسمي ترابك",17,"ك",1,0],["أنتَ أوسعتَهمْ وقد أعْضَلَ الخَطْ","بُ مقالاً كفاهُمُ وصنيعا",18,"ع",2,0],["أَنتَ أَولى بِهم بِناصِية الفض","لِ وَأَحرى وَلَم يَكونوا بِطاءا",19,"ا",3,0],["أنتَ أولَى مِنّي بِرُوحيَ فاحكُم","لَكَ فيها فَما إليّ كَلامُ",20,"م",1,0],["أنت أولى الناسِ بالنا","س وخيرُ الناس دينا",21,"ن",2,0],["أنت أولى بانٍ تحب وأولى","بالذي قالت المحبون قبل",22,"ل",1,0],["أنت أورثتني المعين من الرغ","د ولم تَجعَل السرابَ شرابي",23,"ب",2,0],["أنت أوفى من أن ترد وأسخى","باسما الجود أن تنيل القليلا",24,"ل",2,0],["أنت أولى بالعز في الحب مني","وأنا فيه بالتضرع أولى",25,"ل",2,0],["أنت أوصلتها إلى كل مجد","وعمرت القلوب بالإيمان",26,"ن",1,0],["أنت آويتني وكنتُ طريداً","أنشدُ المكرمات في كل ناد",27,"د",1,0],["أنت أو تدرين يا أنت ماذا","كنت في أنت من زمان بعيد",28,"د",1,0],["أنت أوصيت على الجار فلا","تنس جاراً مسه الضر فهج",29,"ج",1,0],["أنتَ أولَى بأن أُبثَّ إليهِ","عِظَم هَمِّى وَلهفّتِى وإشتِكائى",30,"ا",2,0],["أنت أولى من كان بحر المزايا","منه فيضاً يدوم في جريان",31,"ن",1,0],["أنتَ أولى بها منّي","أنتَ خيرُ من زكّاها",32,"ا",3,0],["أَنتَ أولى بالكأسِ والبأس والرَّا","حةِ منهم والمعضلاتِ الشِّدَادِ",33,"د",1,0],["أَنتَ أَوفاهم اذا نقضوا العَهْ","دَ وأَحماهم اذا السربُ ريعَا",34,"ع",2,0],["أَنتَ أولَيتَني بِرُؤيا مَنام","كُلّ بشرى يا ربّ حقّق مَنامي",35,"م",2,0],["أَنتَ أوفى الخلقِ طُرّاً","شَهدَ الكلُّ وَفاكا",36,"ك",2,0],["أنت أولى بكل فضلٍ من الل","ه وأسنى بكل مجدٍ وجود",37,"د",1,0],["أنت أولى بأن تعزى من النا","س فقد مات بعدك الناس طرا",38,"ر",2,0],["أنتِ أوتارُ الهوى في عزفها","أنتِ ترنيمُ القماري والهديلْ",39,"ل",1,0],["انت أول من تربع بالضمير","وأنت آخر شخص يتعمد طعوني",40,"ن",2,0],["انت أول من هويته والأخير","وأنت أقرب واحد لقلبي يموني",40,"ن",2,0],["أنتِ أَوْلى بالوصْف في هذه الدنيا","وإنْ كان يُعْجزُ الأَقلاما",41,"م",2,0]]}