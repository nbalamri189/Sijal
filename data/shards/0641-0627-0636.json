","https://www.poetsgate.com/ViewPoem.aspx?id=179033",""],[45,"خيَالٌ مُلِمٌّ، أو حَبيبٌ مُسَلِّمُ","https://www.poetsgate.com/ViewPoem.aspx?id=32021",""],[75,"كَذبَ السلوُّ، العِشقُ أيسَرُ مركبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10785&r=&rc=5",""],[9,"كَفَى بِالّذِي تُولِينَهُ لَوْ تَجَنّبَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17253&r=&rc=0",""]],"verses":[["فَأَضعَفَنا عَن حَملِ أَسيافِنا الهَوى","وَنَقَّضَ مِنّا مُبرَماتِ العَزائِمِ",0,"م",1,0],["فاضَ عَلى صِبغَةِ الظَلامِ بِنا","شَيبٌ مِنَ الصُبحِ وَالرُبى لِمَمُ",1,"م",1,0],["فَأَضاءَ الصُّبحُ واجتازَ بنا","بارِقٌ مِن خِلَلِ المُزنِ لَموحُ",2,"ح",1,0],["فَاضْرِبْ بِجَيْشِكَ مَا وَرَاءَ ثُغُورِهِمْ","فَمِنَ الْمَلاَئِكِ دُونَهُ جَيْشَانِ",3,"ن",1,0],["فاضَ البياضُ علَى رغْمِ السّوادِ بها","ويرْشَحُ الدّمْعُ تحْتَ الكُحْلِ في العَمَشِ",4,"ش",1,0],["فَأَضحَت كَبُنيانِ التَهامِيِّ شادَهُ","بِطينٍ وَجَيّارٍ وَكِلسٍ وَقَرمَدِ",5,"د",1,0],["فَأَضحى لِآمالِنا مُنعِشاً","وَأَمسى لِآلامِنا مُرقِدا",6,"د",2,0],["فاضَ غَمرٌ لِلنَدى مِن فَوقِهِم","كانَ يُروي شُربَهُم مِنهُ الغُمَر",7,"ر",1,0],["فَأَضحى يَسُحُّ الماءَ عَن كُلِّ فَيقَةٍ","يَحوزُ الضِبابَ في صَفاصِفَ بيضِ",8,"ض",1,0],["فاضرب على أيدي الغلا ولا تبع","كسب الخيار لمطمع الأشرار",9,"ر",1,0],["فَاضَ مَجْرَى النِّيلِ مِنْ يَنْبُوعِهِ","بَاسِطاً أَذْرُعَهُ لِلْمُسْتَقِينْ",10,"ن",1,0],["فَاضَ بِالخَيْرِ نِيلُهُ فَسَقَاهُ","وَتَرَاءى لِلاِزْدِيَانِ الغَمَامُ",11,"م",1,0],["فَأَضَاءَ الطيبُ إِذْ","حَمَّلْتِهِ مِنْكِ ابْتِسَامَا",12,"م",2,0],["فَأَضحَت بِوَعساءِ النُمَيطِ كَأَنَّها","ذُرى الأَثلِ مِن وادي القُرى وَنَخيلُها",13,"ل",3,0],["فأضحكتِ البرق الطروبَ خلالها","وباتت لأكواس الدراري مُعاطيا",14,"ي",2,0],["فاضتْ علينا من نداك غمائمٌ","وتفجرت من راحتيك بحورا",15,"ر",2,0],["فأضحت وأرض كمالاتها","بنبت الحقائق تعشوشب",16,"ب",1,0],["فاض فيض العلوم بالرغم ممّن","ضربوا دونهنّ بالأسداد",17,"د",1,0],["فَأَضحَت رَواسي المُلكِ في مُستَقَرِّها","لِمُنتَجَبٍ مِن آلِ مَروانَ أَزهَرا",18,"ر",2,0],["فاضت مواهبه عليّ ولم أسل","وسقتْ مواطره الغِزارُ نباتي",19,"ي",1,0],["فاضلٌ لقطنا له مفرق الحم","د وفي بحره الخضمّ غريق",20,"ق",1,0],["فاضَ الزلال المهنى من أصابعه","نعم الأصابع ومن كفَّيه والنيل",21,"ل",1,0],["فاض فيض الغمام في الجود لا قص","د مديح الغنى ولا خوف ذامّهْ",22,"م",2,0],["فاضل سلمت في الدهر له","ليته سلم في الحين عليَّ",23,"ي",1,0],["فاضْرع إلى قارٍ لقاء نافع","واقْرع إلى حامي حماه المانع",24,"ع",1,0],["فأضلاع بني الدنيا","على بغضهمُ تُحْنَى",25,"ن",2,0],["فاضت مَنِيّاً وسلحاً يوم عزَّرها","سوطُ ابن بسطامَ حتى السوطُ مخضوبُ",26,"ب",1,0],["فأضحت بذكرك معمورةً","وقد رام غيرُك إخرابَها",27,"ب",3,0],["فاضت يداه إلى أن خلتُ سَيْبَتها","بحرين جاشا لحين المدِّ فانتطحا",28,"ح",2,0],["فأضْحَى يرى بين العَداءِ وبيْنَهُ","بِمَنْعكَ منه بَرْزَخاً أَيَّ برْزَخِ",29,"خ",1,0],["فأضحُوا وما في راحة الموت مَرْغَبٌ","لحِيٍّ ولا في لذَّةِ العيْش مَزْهَدُ",30,"د",1,0],["فأَضْحى ولو تَسْطِيعُ كلُّ قبيلةٍ","وَقَتْ نَعْله مَسَّ الثَّرَى بخدُودها",31,"د",3,0],["فأضحى عليه ثوبها وهو سابغ","فلا زال منها في لبوسٍ مجدَّدِ",32,"د",1,0],["فأضحى تراءاهُ العيون نباهةً","ألا ساء زِيّاً للفَخور ومَفْخرا",33,"ر",2,0],["فاضرط لنا أخرى بلا حِشمةٍ","كأنما خرَّقت قِرطاسا",34,"س",2,0],["فأضحى وأمسى وقد أجمعت","عليه بأهوائهن الفِرَق",35,"ق",1,0],["فأضربه في مفرق الرأس ضربة","تعودتها من مفرق بعد مفرق",36,"ق",1,0],["فَأَضحى رَأسُهُ بِبِلادِ عَكٍّ","وَسائِرُ خَلقِهِ بِجَبى بُراقِ",37,"ق",1,0],["فَأَضاءَ الجَو وَالأَرضَ مَعاً","نورُهُ الفِضِّيُّ لَمّا ظَهَرا",38,"ر",2,0],["فَاِضحَك فَإِنَّ الشُهبَ تَضحَكُ وَالدُجى","مُتَلاطِمٌ وَلِذا نُحِبُّ الأَنجُما",39,"م",2,0],["فاضَ الغَرامُ فَقالَ آهِ","وَقالَتِ الحَسناءُ آها",40,"ا",3,0],["فَاِضطَرَبَت أَجزاؤُها","جَميعُها في نَسَقِ",41,"ق",1,0],["فَأَضحى بِها مَن خالَفَ الدينَ خائِفاً","وَضاقَ عَلى الكُفّارِ مِنها كُفورُها",42,"ر",3,0],["فَأَضحَت بِمَجهولِ الفَلاةِ كَأَنَّها","قَراقيرُ في آذِيِّ دِجلَةَ تَسبَحُ",43,"ح",1,0],["فاض قبل الوداع أوان نراه","مثلما في النهار يهوى شهاب",44,"ب",1,0],["فاض حتى حسبته وهو يسطو","ملكا يستبد في سلطانه",45,"ن",2,0],["فَاِضطَجَعَت تَحتَ ظِلا","لِ الأَمنِ وَاِسبَطَرَّتِ",46,"ت",1,0],["فاضَت عَلى الأَجيالِ حِكمَةُ شِعرِهِم","وَتَفَجَّرَت كَالكَوثَرِ المَعروكِ",47,"ك",1,0],["فاضَ الزَمانُ مِنَ النُبوغِ فَهَل فَتى","غَمَرَ الزَمانَ بِعِلمِهِ وَبَيانِهِ",48,"ن",2,0],["فَأَضحَت كَأَنَّ السورَ مِن فَوقِ بَدئِهِ","إِلى الأَرضِ قَد شَقَّ الكَواكِبَ وَالتُربا",49,"ب",2,0],["فاضِحُ أَعدائِهِ كَأَنَّهُمُ","لَهُ يَقِلّونَ كُلَّما كَثُروا",50,"ر",3,0],["فاضَلَ بَينَ الأَخَوانِ عُسري وَعَن","ظَلماءِ لَيلٍ تَفاضَلَت شُهُبُه",51,"ب",2,0],["فَأَضاءَت تَحتَ الدُجُنَّةِ لِلشَر","بِ وَكادَت تُضيءُ لِلمِصباحِ",52,"ح",1,0],["فَأَضاءَ مِنها كُلَّ فَجٍّ مُظلِمٍ","داجٍ وَأَخصَبَ كُلُّ وادٍ مُمحِلِ",53,"ل",1,0],["فاضِحاً سَعيَهُم إِذا ما تعاطَوا","سَعيَهُ فُحشٌ نَقصِهِم عَن كَمالِه",54,"ل",2,0],["فَأَضرَموا إِذ أَشاعوا البَينَ في كَبِدي","وَالقَلبِ نارَ الهَوى وَالشَوقُ تَشتَعِلُ",55,"ل",1,0],["فَآضَ كَما آضَ الحُسامُ تَرادَفَت","عَلَيهِ القُيونُ فَهوَ أَبيَضُ مِخذَمُ",56,"م",1,0],["فَأَضحَت غَداةَ الغِبِّ عَنّا كَأَنَّما","يُدالي بِها الراعي غَماماً كَنَهوَرا",57,"ر",2,0],["فَأَضحَوا بِإِذنِ اللَهِ بَعدَ سَقامِهِم","كَذي النَتفِ عادَت بَعدَ ذاكَ نَواصِلُه",58,"ل",2,0],["فأضحى لامتداد العم","ر أعلى صيدها سنا",59,"ن",2,0],["فأضمرَ نَايُكَ الحنَّانُ هَمّاً","وأعلنَ صَنجُك الصَّيَّاح شَكوى",60,"و",2,0],["فاضَت عليَّ سِجالُ كفَّك بالنَّدى","حتى ظَننتُك بالغَمامِ مُساجِلا",61,"ل",2,0],["فاضت علي سجال كفك بالندى","حتى ظننتك للغمام مساجلا",62,"ل",2,0],["فاضَ على آمِليه منه حَياً","أنفَدَ آمالَهمِ وما نَفَدا",63,"د",2,0],["فَآضَ كَأَنَّهُ رَجُلٌ سَليبٌ","عَلى عَلياءَ لَيسَ لَهُ رِداءُ",64,"ا",2,0],["فَأَضحوا لَدى دارِ الجَحيمِ بِمَنزِلٍ","عَن البَغيِ وَالعُدوانِ في أَشغَلِ الشُغلِ",65,"ل",1,0],["فاضِلٌ أَلَّفَ الفَصاحَةَ وَالعِل","مَ وَضَمَّت آراؤُهُ أَشتاتَه",66,"ت",2,0],["فأضاقتْ يداك من صَدقَاتٍ","كان يُحيا بهنّ ميّتُ عُدْمِ",67,"م",1,0],["فاضَ اللِئامُ وَغاضَتِ الأَحسابُ","وَاِجتُثَّتِ العَلياءُ وَالآدابُ",68,"ب",1,1],["فَأَضحَت عَلَيهِ العُلى خُشَّعاً","وَبَيتُ السَماحَةِ مُلقى الكِفاءِ",69,"ا",2,0],["فَأَضحَوا بَعدَ عِزٍّ وَاِختِيالٍ","وَهُم عِبَرٌ لِأَهلِ المَشرِقَينِ",70,"ن",1,0],["فاضَ فَيضَ الأَتِيِّ حَتّى غَدا المَو","سِمُ مِن فَضلِ سَيبِهِ مَوسوما",71,"م",2,0],["فَأَضحوا لَوِ اِسطاعوا لِفَرطِ مَحَبَّةٍ","لَقَد عُلِّقَت خَوفاً عَلَيكَ التَمائِمُ",72,"م",1,0],["فَأَضحَت وَقَد ضُمَّت إِلَيكَ وَلَم تَزَل","تُضَمُّ إِلى الجَيشِ الكَثيفِ القَنابِلُ",73,"ل",1,0],["فَأَضحَت عَطاياهُ نَوازِعَ شُرَّداً","تُسائِلُ في الآفاقِ عَن كُلِّ سائِلِ",74,"ل",1,0],["فَأَضحَوا وَقَد فاضَت إِلَيهِ قُلوبُهُم","وَرَحمَتُهُ فيهِم تَفيضُ وَنائِلُه",75,"ل",2,0],["فاضَت سَحائِبُ مِن نَعمائِهِ فَطَمَت","نُعماهُ بِالبُؤسِ حَتّى اِجتَثَّتِ البوسا",76,"س",2,0],["فَأَضحَت بِكَ الأَحياءُ أَجمَعُ أُلفَةً","كَما أُحكِمَت في النَظمِ واسِطَةُ العِقدِ",77,"د",1,0],["فَأَضحى الفَلا قَد جَدَّ في بَريِ نَحضِهِ","وَكانَ زَماناً قَبلَ ذاكَ يُلاعِبُه",78,"ب",2,0],["فَاِضمُم أَقاصِيَهُم إِلَيكَ فَإِنَّهُ","لا يَزخَرُ الوادي بِغَيرِ شِعابِ",79,"ب",1,0],["فَأَضجَعاهُ وَشَقّا صَدرَهُ بِيَدٍ","رَفِيقَةٍ لَم يَبِت مِنها عَلى أَلَمِ",80,"م",1,0],["فَأَضَالِعِي لِلْوَجْدِ نَارُ غَضىً","وَمَحَاجِرِي بِالدَّمْعِ أَمْوَاهُ",81,"ا",2,0],["فأضمرُ سلواناً فيحضرُكِ الهوى","مَصَوَّرَةً لي يا نُويْقِضَةَ العهدِ",82,"د",1,0],["فَأَضحَكَ مِن نَجاةِ الثَغرِ ثَغراً","وَنَفَّسَ مِن حِماهُ عَن كَئيبِ",83,"ب",1,0],["فاضَت حَوالَيهِ فَضُرِّجَ عَرشُهُ","مِنها وَخُضِّبَ تاجُهُ الوَضّاحُ",84,"ح",1,0],["فاضَت لُهاهُ وَأَطرَفَت في نَوعِها","أَذَهَبنَ مَذهَبَ مُغرِبٍ أَو مُغرِقِ",85,"ق",1,0],["فاض حَتّى غَدَوت وَالناس مِنهُ","بِعُيون عَن أَن تَراك غَنيه",86,"ي",2,0],["فَأَضحى وَما يَألو بِصالِحِ سَعيِهِم","لَحاقاً وَمَن لا يُحرَمِ النُجحَ يُنجِحِ",87,"ح",1,0],["فَأَضرِبُها بِلا دَهَشٍ فَخَرَّت","صَريعاً لِليَدَينِ وَلِلجِرانِ",88,"ن",1,0],["فَأَضحَت سَواءً وُجوهُ البِلادِ","وَجُنَّ النَباتُ بِها وَاِلتَقى",89,"ا",1,0],["فاضْمَنْ لها دَرْكَ المعادِ ضمانَها","بالفَوْزِ عنكَ لِسَامِعٍ وَلِمُنْشِدِ",90,"د",1,0],["فاضَت عَلَى شَفَتَيْهِ رَحْمَةُ رَبِّهِ","فاستَشْفِ مِنْ تِلْكَ الشِّفاه عَلِيلا",91,"ل",2,0],["فأضْحَى بحيْثُ الرُّغاءُ الزّئِيرُ","وحالَتْ بحيْثُ الخيامُ الأجَم",92,"م",1,0],["فَا