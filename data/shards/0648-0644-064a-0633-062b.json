{"poems":[[83,"ردوا على طرفي النوم الذي سلبا","https://www.aldiwan.net/poem61557.html","البسيط"],[563,"أصابع الغيب فينا حركت عوده","https://www.aldiwan.net/poem34566.html","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63883","المجتث"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59255","البسيط"],[1313,"","https://poetry.dctabudhabi.ae/diwan/poem/147076","الطويل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122467","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87350","الوافر"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97946","الوافر"],[4516,"","https://poetry.dctabudhabi.ae/diwan/poem/66879","البسيط"],[4529,"","https://poetry.dctabudhabi.ae/diwan/poem/105372","السريع"],[5277,"أحجارٌ على رقعة الزمن","https://www.poetsgate.com/ViewPoem.aspx?id=190849",""],[5937,"خارِجَ النّسَق","https://www.poetsgate.com/ViewPoem.aspx?id=211805",""]],"verses":[["وَلَيسَ ثَأري عَلى موسى وَحُرمَتِهِ","بِواجِبٍ وَهُوَ في حِلٍّ إِذا تَعَبا",0,"ب",2,0],["وليس ثم سواه واحد هو في","عين الحقيقة لاحت بيضه سوده",1,"د",2,0],["وليس ثَمَّ اختصاصٌ","ما اختصَّ إِلاَّ خسيس",2,"س",1,0],["وَلَيْسَ ثَأرِي عَلَى عَيْنَيْكِ إنْ فَتَكَتْ","بَلْ يَهْنِنِي أنَّنِي مِنْ بَعْضِ قَتْلاَكِ",3,"ك",1,0],["وليس ثياب المرء تغني قلامه","إذا كان مقصورا على قصر النفس",4,"س",1,0],["وليسَ ثمَّةَ من شيءٍ يُؤلِّفُهُ","وأهلُهُ سئِمُوا فاستحسَنُوا السَّفَرا",5,"ر",2,0],["وَلَيسَ ثناؤُنا منّا ولكن","صدى افعالكَ الحُسنى ثناكا",6,"ك",2,0],["وليس ثراؤهم يجدى أباهم","سوى أن لا يرى الخلف المهينا",7,"ن",2,0],["وليس ثمة من فرق بشرعتنا","ما بين راعي سحاحير وسحار",8,"ر",1,0],["وليس ثاني اثنين في غاره","كلاهما نفس اهنيها",9,"ي",3,0],["وليس ثمّةَ من بانوا ومن رحلوا","فكلّ قومي تميمٌ نافرتْ مضرا",10,"ر",2,0],["وليس ثم كمانٌ شُدَّ من عِنَبٍ","مثل الذي شُدَّ بينَ الخصرِ والعُنُقِ",11,"ق",1,0]]}