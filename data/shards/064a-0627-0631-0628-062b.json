{"poems":[[53,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[60,"يا رب ثبت لي قدمي وقلبي","https://www.aldiwan.net/poem31161.html","الرجز"],[50,"يا رب ثور بمكان قاص","https://www.aldiwan.net/poem64358.html","الرجز"],[409,"القلب أعلم يا عذول بدائه","https://www.aldiwan.net/poem34180.html","الكامل"],[534,"الحمد لله على","https://www.aldiwan.net/poem37118.html","مجزوء الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138238",""],[1425,"","https://poetry.dctabudhabi.ae/diwan/poem/124278","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3026,"","https://poetry.dctabudhabi.ae/diwan/poem/143632","المنسرح"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20891","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133083","الرجز"],[4858,"بين جهالة حمقاء وسياسة خرقاء","https://www.poetsgate.com/ViewPoem.aspx?id=139111",""],[5030,"الموت!","https://www.poetsgate.com/ViewPoem.aspx?id=215889",""],[6202,"طول مسيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86734&r=&rc=35",""]],"verses":[["يا رُبّ ثِقلٍ حملتم عن خلائقنا","لم تعدلوه بآثام وأوزار",0,"ر",1,0],["يا رَبِّ ثَبِّتَ لِي قَدَمي وَقَلبي","سُبحانَكَ اللَهُمَّ أَنتَ حَسبي",1,"ي",1,1],["يا رُبَّ ثَورٍ بِمَكانٍ قاصِ","ذي زَمَعٍ دُلامِصٍ دِلاصِ",2,"ص",1,1],["يا رب ثبتنا بقول ثابت","عند امتحان العبد تحت ثرائه",3,"ا",3,0],["يا رَبِّ ثَبِّتْهُ عَلَى","هَدْيِ الرَّسُولِ الْمُؤْتَمَنْ",4,"ن",1,0],["يا رب ثبت مجده","وأطل سنى أجل مديد",5,"د",1,0],["يا رُبّ ثاو بذي الديار نعرِفُه","من الأحبّة إلى دار الحجارات",6,"ت",1,0],["يا رب ثبتهم على الايمان واج","علهم هداة التائه الحيران",7,"ن",1,0],["يا رب ثديٍ مصصته بكراً","وقد عراني خمار مغبوق",8,"ق",1,1],["يا رب ثبت ووفق كل عصبتنا","وكن لنا ملجأ من زلة القدم",9,"م",1,0],["يا ربّ ثوب حواشيه كأوسطه","لا عيب في الثوب من حسنٍ ومن لين",10,"ن",1,0],["يا رب ثبتنا ولا تخذل وجد","بالعفو فضلاً منك والغفران",11,"ن",1,0],["يا رَبّ ثبت في الجهاد قلوبنا","واغفر لنا يا سامعَ الدّعَوات",12,"ت",1,0],["ياربّ ثبّتْني أُجبْ.. واربط على","قلب التي فيها الحنانُ الفاضلُ",13,"ل",1,0],["يا رب ثبتني بتقوى خاشع","واصرف ذنوبا آسراتٍ تقدح",14,"ح",1,0]]}