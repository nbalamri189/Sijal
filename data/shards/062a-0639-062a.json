{"poems":[[65,"أهذه خطرات الربرب العين","https://www.aldiwan.net/poem46216.html","البسيط"],[57,"أغيب عنك بود لا يغيره","https://www.aldiwan.net/poem26046.html","البسيط"],[57,"هبوني أغض إذا ما بدت","https://www.aldiwan.net/poem26296.html","المتقارب"],[73,"ما ضئيل له الهواء مقيل","https://www.aldiwan.net/poem3857.html","الخفيف"],[95,"طفيء الصباح بعيني الإلهام","https://www.aldiwan.net/poem11359.html","الكامل"],[32,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[53,"يا ذا الذي لو هجاه مادحه","https://www.aldiwan.net/poem9387.html","المنسرح"],[53,"أنى تشاغلت عن أبي حسنك","https://www.aldiwan.net/poem65777.html","الخفيف"],[53,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[31,"حي المنازل بين السفح والرحب","https://www.aldiwan.net/poem6045.html","البسيط"],[93,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[91,"أحمد كان مثل بحر رحيب","https://www.aldiwan.net/poem44619.html","الخفيف"],[91,"بعد اني اردى فاهبط رمسي","https://www.aldiwan.net/poem44926.html","الخفيف"],[58,"نهنهت الخمسون من شدتي","https://www.aldiwan.net/poem58559.html","الطويل"],[47,"أغيب عنك بود لا يغيره","https://www.aldiwan.net/poem66832.html","البسيط"],[63,"أخلق بغائب رشده أن يقدما","https://www.aldiwan.net/poem51455.html","الكامل"],[63,"قد أمكن الطالب مطلوب","https://www.aldiwan.net/poem51778.html","السريع"],[2,"هاج الفؤاد معارف الرسم","https://www.aldiwan.net/poem25007.html","الكامل"],[89,"حي مغنى الهوى بوادي الشآم","https://www.aldiwan.net/poem8286.html","الخفيف"],[107,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[52,"أأرقت بعد رقادك الأواب","https://www.aldiwan.net/poem64844.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85593","الخفيف"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62279","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62212","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[92,"البادية في إيران","https://www.poetsgate.com/ViewPoem.aspx?id=179050",""],[92,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""],[47,"تعتبت دهراً فلما رجعت","https://www.poetsgate.com/ViewPoem.aspx?id=31532",""],[91,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[31,"حيِّ المنازِلَ بَينَ السّفْحِ والرُّحَبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17430&r=&rc=3",""],[136,"إلى ابن أما إمام البدو والحضر","https://www.aldiwan.net/poem54830.html","الطويل"],[147,"هو ذاك ربع المالكية فاربع","https://www.aldiwan.net/poem11770.html","الكامل"],[164,"لي شوق إلى الملاح شديد","https://www.aldiwan.net/poem58759.html","الخفيف"],[208,"هجر الملاح نصيب من لا يهجر","https://www.aldiwan.net/poem53308.html","الكامل"],[234,"ومريض الجفون عذب السجايا","https://www.aldiwan.net/poem51131.html","الخفيف"],[236,"ما بال أنفاس النسيم إذا سرت","https://www.aldiwan.net/poem44597.html","الكامل"],[240,"بأبي من ذبت في الح","https://www.aldiwan.net/poem31630.html","مجزوء الرمل"],[240,"قم قبل إسفار الصباح","https://www.aldiwan.net/poem32117.html","مجزوء الكامل"],[376,"عجبت من نفسي ومن أنها","https://www.aldiwan.net/poem57168.html","السريع"],[409,"يا عاتبا لي ما الذي","https://www.aldiwan.net/poem34113.html","مجزوء الرجز"],[463,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138186",""],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119951","الرجز"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145155","المنسرح"],[1529,"","https://poetry.dctabudhabi.ae/diwan/poem/140212",""],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144762","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108440","الكامل"],[2172,"","https://poetry.dctabudhabi.ae/diwan/poem/18691","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53031","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109657","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77272","الكامل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26186","الخفيف"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83241","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100340","الكامل"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216559",""],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62896","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45736","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91252","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36498","الدوبيت"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4440,"","https://poetry.dctabudhabi.ae/diwan/poem/145995","الكامل"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102020","الرمل"],[4748,"اسرار","https://www.poetsgate.com/ViewPoem.aspx?id=5599",""],[4869,"ثرثرة خوفي","https://www.poetsgate.com/ViewPoem.aspx?id=151544",""],[4958,"اشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=34899",""],[4984,"جسر الهوى خشب","https://www.poetsgate.com/ViewPoem.aspx?id=175564",""],[4119,"إن الألى جمعتهم والنوى دار","https://www.poetsgate.com/ViewPoem.aspx?id=16140",""],[5121,"الأخيل","https://www.poetsgate.com/ViewPoem.aspx?id=34713",""],[5219,"أنين قلب","https://www.poetsgate.com/ViewPoem.aspx?id=194918",""],[5232,"شموخ الأرز","https://www.poetsgate.com/ViewPoem.aspx?id=212986",""],[5271,"أخفيت حبي","https://www.poetsgate.com/ViewPoem.aspx?id=123676",""],[5277,"أوراق خريفية","https://www.poetsgate.com/ViewPoem.aspx?id=185877",""],[5277,"وسوسةٌ قهريّة","https://www.poetsgate.com/ViewPoem.aspx?id=205548",""],[5351,"القادم أولاً وثانياً","https://www.poetsgate.com/ViewPoem.aspx?id=202236",""],[5431,"على لوحٍ بنور الله يُسقى...","https://www.poetsgate.com/ViewPoem.aspx?id=200032",""],[5431,"كنزٌ من الأزلِ...","https://www.poetsgate.com/ViewPoem.aspx?id=201391",""],[5550,"أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=211701",""],[5573,"خاتم ذهب","https://www.poetsgate.com/ViewPoem.aspx?id=200179",""],[5628,"الولادة الجديدة","https://www.poetsgate.com/ViewPoem.aspx?id=178478",""],[5652,"حظ / خايب","https://www.poetsgate.com/ViewPoem.aspx?id=177975",""],[5725,"اذاكر فيك الروح","https://www.poetsgate.com/ViewPoem.aspx?id=177427",""],[5725,"بغداد ليمونتي","https://www.poetsgate.com/ViewPoem.aspx?id=210926",""],[5725,"إمام العاشقين","https://www.poetsgate.com/ViewPoem.aspx?id=215791",""],[5956,"حكمة الخالق","https://www.poetsgate.com/ViewPoem.aspx?id=184498",""],[6084,"حينى بالصبوح عند الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=170829",""]],"verses":[["تَعتادُهُ هَيبَةٌ في طَيِّها كَرَمٌ","وشِدّةٌ شابَها الأحلامُ باللّينِ",0,"ن",1,0],["تَعتَلُّ بِالشُغلِ عَنّا ما تُكاتِبُنا","والشُغلُ لِلقَلبِ لَيسَ الشُغلُ لِلبَدَنِ",1,"ن",1,0],["تَعَتَّبتَ تَطلُبُ ما أَستَحِقُّ","بِهِ الهَجرَ مِنكَ وَلا تَقدِرُ",2,"ر",1,0],["تَعتَليهِ الكُسى ثِقالاً فَيُلقِي","ها خِفافاً في أُخرَياتِ النَهارِ",3,"ر",1,0],["تَعْتَادُنَا وَالذِّكْرَيَاتُ كَأَنَّهَا","آثَارُ رَائِعَةٍ مِنَ الأَحْلامِ",4,"م",1,0],["تَعتادُني زَفَراتٌ مِن تَذَكُّرِها","تَكادُ تَنفَضُّ مِنهُنَّ الحَيازيمُ",5,"م",1,0],["تعتدُّه بَهْرجَ المديحَ ولا","تعتدُّه هاجياً كممتدحِ",6,"ح",1,0],["تعتاضُ منّي وليس لي عِوضٌ","منك متى ما خرجتُ من قرنك",7,"ك",1,0],["تعتادهُ هِزّةٌ للجودِ بيّنَةٌ","فيه إذا اعتاده للعُرفِ لهفان",8,"ن",1,0],["تَعتادُهُ كُلُّ مِئلاةٍ وَما فَقَدَت","عَرفاءَ مِن مورِها مَجنونَةِ الأَدَبِ",9,"ب",1,0],["تَعتَريني هَزَّةٌ كَالكَهرَبا","كُلَّما حَنَّ مَشوقٌ لِمَشوق",10,"ق",1,0],["تعترى السامعي قريضك منهم","هزة في الارواح والابدان",11,"ن",1,0],["تعتري جسمي هزة كلما فكر","ت اني يرما سافقد حسي",12,"س",2,0],["تَعْتَرِفُ النّفْسُ ببعضِ القوى","فَأُمْسِكُ النّفْسَ ببعضِ الخِداعْ",13,"ع",1,0],["تَعتَلُّ بِالشُغلِ عَنّا ما تُلِمُّ بِنا","الشُغلُ لِلقَلبِ لَيسَ الشُغلُ لِلبَدَنِ",14,"ن",1,0],["تَعتَدُّ نَجدتَه عَدِيٌّ عُدَّةً","وتخالُه صِيدُ الأَراقمِ أرقَما",15,"م",2,0],["تعترضُ الخيلُ على جُدره","قُبْلاً فَمجنوبٌ ومَركوبُ",16,"ب",1,0],["تَعتادُهُ عينٌ مُلَمَّعَةٌ","تُزجي جَآذِرَها مَعَ الأُدمِ",17,"م",1,0],["تَعْتَلِي تَارَةً وَتَهْبِطُ أُخْرَى","فِي فَضَاءٍ بَيْنَ السُّهَا وَالرَّغَامِ",18,"م",1,0],["تَعتزُّ من أقلامهم بمعاقلٍ","وتلوذُ من أعمالهم بجبالِ",19,"ل",1,0],["تَعتَلُّ إِن شَهِدَ الأَميرُ بِقُربِهِ","وَإِذا نَأى وَجِلَت مِنَ الحُجّابِ",20,"ب",1,0],["تَعتَري جسمي هزة حين تبدو","أو تلاقي أَحداقها أَحداقي",21,"ق",2,0],["تَعْتَادُهُ بِفُؤَادٍ غَيْرِ مُقْتَسَمٍ","ودِرَّةٍ لَمْ تَخَوَّنْهَا الأَحَالِيلُ",22,"ل",1,0],["تَعْتَادُهَا قُرَّحٌ مَلْبُونَةٌ خُنُفٌ","يَنْفُخْنَ في بُرْعُمِ الْحَوْذَانِ والخَضِرِ",23,"ر",1,0],["تَعْتَاقهُ الحُمَّى وَلاَ يَلْوِي بِهَا","هَلْ عَاقَتِ الضِّرْغَامَ دُونَ صِيَالِ",24,"ل",1,0],["تَعْتَادُنِي فِي مَسْمَعِي أَوْ نَاظِرِي","وَإِلى يَمِينِي تَارَةًٍ وَشِمَالِي",25,"ل",2,0],["تعتريهِ هزَّةُ الشوقِ لكم","ومن القسوة أن لا تَعتري",26,"ر",2,0],["تعتريني خواطرٌ فيكِ أحياناً","فأرتدُّ باديَ الإِرتباك",27,"ك",1,0],["تعتبت دهراً فلما رجع","ت إلى حاصل الطمع الكاذب",28,"ب",1,1],["تعتري الناس إن مررت عليهم","وقفة في القلوب والأنفاس",29,"س",1,0],["تعتادُها كلُّ مثلاة ٍ وما فقدت","عَرْفاءُ مِنْ مُورِها مجنونَة ُ الأدبِ",30,"ب",1,0],["تَعتَادني مِن جَواكُم زَفرَةٌ سَفَعَت","نِيرَانُ أشجَانِهَا الأحشاءَ بالذَّكَرِ",31,"ر",1,0],["تَعتادُني طولَ النَهارِ مُغِذَّةً","فَإِذا اِدلَهَمَّ اللَيلُ زارَت مَضجَعي",32,"ع",2,0],["تعتريني منها هموم إذا ما","أقبل الليل فهو فيها شديد",33,"د",1,0],["تعتلُّ أنك قد كبرتَ عن المنى","أتراك تكبر يا مناي وأصغرُ",34,"ر",1,0],["تعتريه مهابتي فهوْ كالخا","ئف وهْو المسلّط المتعدّي",35,"د",2,0],["تعتاض في طلب العلى عن ريفها","بمهامه أغبرت وبيدٍ أقفرت",36,"ت",1,0],["تَعتَلِق كَفُّكَ مِن شُك","ري لَها أَوثَقَ عُروَه",37,"و",2,0],["تَعتادُكَ الأَفراحُ ما","بَينَ الغُدُوِّ إِلى الرَواحِ",38,"ح",1,0],["تَعتَزُّ بالفَقرِ إِذا استَشعَرَت","أنَّ الغِنى يُؤخَذُ بِالذِلَّه",39,"ل",2,0],["تعتقل البعض على","رغمي كأن قد أحربك",40,"ك",1,0],["تَعترِقُ العظمَ كما تَسْتَرِطُ ال","لحم وجلّت أن تَحُصَّ الوَبَرا",41,"ر",2,0],["تعتز بالعلم والعرفان أمتنا","والشعب من غير علم طالما هانا",42,"ن",2,0],["تعتلج الأطماع في ضميري","أضرب للحنطة بالشعيرِ",43,"ر",1,0],["تعتاد في النوم","فتطرد النوما",44,"م",2,0],["تعتلي موجةٌ على ظهر أخرى","كلما ساقها الفتورُ لساحل",45,"ل",1,0],["تعتاض عن سمر الحبيب بنشره","وعن الصبا في ليلها الحلكوك",46,"ك",1,0],["تعتلي في معارج العز حتى","جاوز العرش أيسر استعلاها",47,"ا",3,0],["تعتز يا عثمانُ باسمك امةٌ","تزهو بها كالبدر عند تمامهِ",48,"م",2,0],["تَعتادُهُ بِفُواقِها وَجَرِيَّةٍ","وَتُقيلُهُ بِسَرارِ رَوضٍ مُبقِلِ",49,"ل",1,0],["تَعْتَدُّ أنفسها لعزة ملكه","خَوَلاً ولا تعتاده الخُيلاء",50,"ا",2,0],["تعتري داخليه رأفة قلبٍ","حيث انشاؤه بهمة رائف",51,"ف",1,0],["تَعتَزُّ مِصرُ عَلى الإِلَهِ فَوَجهُها","بِيَدِ الأَعادي كُلَّ يَومٍ يُلطَمُ",52,"م",1,0],["تَعتَليهِ الكُسى ثِقالا وَيُلقي","ها خِفافاً في أُخرَياتِ النَهارِ",53,"ر",1,0],["تَعتَزُّ قَليوبِيَّةٌ بِكَ نابِهاً","فَلَأَنتَ مِنها القَلبُ ثُمَّ المَبصرُ",54,"ر",1,0],["تعتاد جفنك غفوة اة كلما","نفحته ريح غضةٌ يتعافى",55,"ف",2,0],["تِعتِرِف أكمام الابكاسِ","والاثمار كلّها المختلفة",56,"ف",2,0],["تعتادها بعدَ القيادِ سَلاهبٌ","من آل أَعوجَ والصريحِ عِتَاقُ",57,"ق",1,0],["تَعتاض مِن بَذل النضار جَواهِراً","هَذا بِذاك وَفي البَقاء نَماءُ",58,"ا",2,0],["تَعتز ساعاتي متى شرّفتها","وَتجلّ أَوقاتي بطلعتك التي",59,"ي",1,0],["تَعتاد عِيادَتي مَريضاً فلذا","لَم أَشتَهِ وَاللَّهِ زَوالَ المَرَضِ",60,"ض",1,0],["تَعْتاضُ عَن رِبْحِها أَشْنَى خَسارَتِها","فَيا خَسارَةَ نَفْسٍ في تِجارَتِها",61,"ه",2,0],["تعتاد ظلم المستهام بها كما","أردافها تعتاد ظلم خصورها",62,"ر",3,0],["تعتريني في صباحي صحوة","واجن الليل من وجدي إذا جن",63,"ن",1,0],["تعتقد لو جفيتك اقدر اعيش دونك؟","وانت نبضي وحسيّ..خاطري مستهامك",64,"ك",1,0],["تعتآش سود النفوس بكثر مصروفي","ومآهي على حآلهآ سآعة اكلمهآ",65,"م",3,0],["تعتريني رجفَةُُ في الجسمِ ظَلَّت","تَتَوَلّى كُلَّ أعضائي فُرادى",66,"د",2,0],["تَعتَّق العهد ردِّدْ شجوه ثملا","يعيد مما مضى في العشق أولُه",67,"ل