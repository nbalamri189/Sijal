{"poems":[[32,"قفا نحيي العرصات الهمدا","https://www.aldiwan.net/poem29604.html","الرجز"],[63,"طلعت شموس الخدر كيما تغربا","https://www.aldiwan.net/poem51784.html","الكامل"],[391,"هل عند غان لفؤاد","https://www.aldiwan.net/poem1847.html","السريع"],[466,"حي المهابة والندى قد أربيا","https://www.aldiwan.net/poem15156.html","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28725","البسيط"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28927","الكامل"]],"verses":[["قاظَ الحَصادَ وَالنَصَيَّ الأَغيَدا","وَالجَزءَ مَسقَيَّ السَحابِ الأَربَدا",0,"د",2,0],["قاظَ الزَّمانُ فكنتَ ظِلاً سَجْسَجاً","ونأى الربيعُ فكنتَ رُوْضاً مُعْشِبا",1,"ب",2,0],["قاظَ إِلى العَليا إِلى المُنتهى","مُستَعرِضَ المَغرِبِ لَم يَعضُدِ",2,"د",1,0],["قاظتْ له أحداثهُ وخُطوبهُ","فاحتل منك إلى ربيعٍ مُخْضل",3,"ل",1,0],["قاظوا رَبيعَهُم في خِصبِ بادِيَة","حَتّى إِذا القيظُ وَلي آثَروا الحَضَرا",4,"ر",2,0],["قاظت أنالَ الى الملا وتربَّعت","بالحَزنِ عازبةً تُسَنُّ وتودعُ",5,"ع",1,0]]}