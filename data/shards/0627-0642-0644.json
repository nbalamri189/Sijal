.html","الكامل"],[459,"لعل لها مع النسرين سرا","https://www.aldiwan.net/poem56198.html","الوافر"],[459,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[459,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[462,"اعيذ قريشا أن تصيخ لكاشح","https://www.aldiwan.net/poem15463.html","الطويل"],[462,"نيطت حمائل سيفه","https://www.aldiwan.net/poem16105.html","مجزوء الكامل"],[465,"لنا بسمر الحمى في الحي أسمار","https://www.aldiwan.net/poem3186.html","عموديه"],[465,"سقيت حياً جفني يا بانة الحمى","https://www.aldiwan.net/poem3501.html","عموديه"],[465,"أقل عنائي أنني فيه هائم","https://www.aldiwan.net/poem3633.html","عموديه"],[469,"أقلني من القول الذي لا يوافق","https://www.aldiwan.net/poem59838.html","الطويل"],[469,"لا فتح الله على فتح","https://www.aldiwan.net/poem60258.html","السريع"],[480,"أقلع بقشك أيها الأسطول","https://www.aldiwan.net/poem37195.html","الكامل"],[496,"إن لم يكن هذا الصدود فصالا","https://www.aldiwan.net/poem10260.html","الكامل"],[501,"أي قلب هام فيكم وسكن","https://www.aldiwan.net/poem37760.html","الرمل"],[501,"قل لغزلان بقيعان النقا","https://www.aldiwan.net/poem37937.html","الرمل"],[501,"أقلق الحاسد مني","https://www.aldiwan.net/poem38095.html","مجزوء الرمل"],[501,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[506,"أقلّوا","https://www.aldiwan.net/poem61087.html","الطويل"],[514,"علام وقد أذبت القلب شوقا","https://www.aldiwan.net/poem67709.html","الوافر"],[515,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[516,"سرت نفحة كالمسك أزهى وأعطر","https://www.aldiwan.net/poem12119.html","الطويل"],[530,"أقلام أندلس وحمير بعدها","https://www.aldiwan.net/poem37095.html","الكامل"],[552,"يا حامل الكأس ناولني مشعشعة","https://www.aldiwan.net/poem47138.html","البسيط"],[552,"أقلا فشأنكما غير شاني","https://www.aldiwan.net/poem47155.html","المتقارب"],[552,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[552,"أقلني ربي بالذين اصطفيتهم","https://www.aldiwan.net/poem47370.html","الطويل"],[554,"خيال من النائي الهوى المتبعد","https://www.aldiwan.net/poem68426.html","الطويل"],[559,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[563,"ما بين أعطاف القدود الهيف","https://www.aldiwan.net/poem52947.html","الكامل"],[568,"يا مسدي العرف إسرارا وإعلانا","https://www.aldiwan.net/poem69491.html","البسيط"],[568,"أقل ذا الود عثرته وقفه","https://www.aldiwan.net/poem69517.html","الوافر"],[568,"أخ لي كنت أغبط باعتقاده","https://www.aldiwan.net/poem69712.html","الكامل"],[568,"عراني الزمان بأحداثه","https://www.aldiwan.net/poem69758.html","المتقارب"],[574,"رضى بقضاء الله فهو مصيب","https://www.aldiwan.net/poem3660.html","الطويل"],[576,"تذكرت أيام الصبابة والصبا","https://www.aldiwan.net/poem2767.html","الطويل"],[576,"كجسمك جسمي أصبح اليوم بالياً","https://www.aldiwan.net/poem2768.html","الطويل"],[576,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[576,"أحسنتم إن تحسنوا في الفعل","https://www.aldiwan.net/poem3038.html","الرجز"],[576,"أضاء بثغرك وادي أضا","https://www.aldiwan.net/poem3054.html","المتقارب"],[576,"ببرقة ثغر لا ببرقة ثهمد","https://www.aldiwan.net/poem3084.html","الطويل"],[587,"فرق بيني وبين مصطبري","https://www.aldiwan.net/poem17538.html","المنسرح"],[587,"أقلب قلبي شوقا إليه","https://www.aldiwan.net/poem17993.html","المتقارب"]],"verses":[["أقلهم سلاماً عرض البين دونه","وما حملت نجواه عني المراود",0,"د",1,0],["أَقِلّوا لا أَبا لَكُمُ وَخَلّوا","مُطاعَنَةَ الأَسِنَّةِ بِالأَشافي",1,"ف",2,0],["أُقَلَّبُ عَيناً في الإِخاءِ صَحيحَةً","إِذا اِرتَمَتِ الأَعداءُ بِالأَعيُنِ الرُمدِ",2,"د",1,0],["أَقِلني أَقِلني نَظرَةً ما اِحتَسَبتُها","فَقَد أَنهَلَت قَلبي غَليلاً وَعَلَّتِ",3,"ت",1,0],["أَقِلّوا عَلَينا لا أَباً لِأَبيكُمُ","وَلا تَرشُقونا بِاللُتَيّا وَبِالَّتي",3,"ت",2,0],["أُقِلُّ سَلامي إِن رَأَيتُكِ خيفَةً","وَأُعرِضُ كَيما لا يُقالَ مُريبُ",4,"ب",1,0],["أَقِلَّ مِنَ البُكاءِ فإِنَّ نِضوي","يَكادُ الشَّوقُ يُورِثُهُ الجُنونا",5,"ن",2,0],["أُقَلِّبُ طَرْفي في عُهودٍ وراءَها","خَبيئَةُ غَدرٍ في مَخيلَةِ كاذِبِ",6,"ب",1,0],["أَقَلُّ عَلَيكَ ضَرّاً مِن قَريحٍ","إِذا أَصحابُهُ ذَمَروهُ سارا",7,"ر",2,0],["أَقَلَّ الزيارَةَ لَمّا بَدا","لَهُ الصَرمُ أَو بَعضُ أَسبابِهِ",8,"ه",1,1],["أَقَلُّ الناسِ بِالدُنيا سُروراً","حَبيبٌ قَد نَأى عَنهُ حَبيبُ",9,"ب",1,0],["أقْلامُنا الواسِطيَّهْ","ذَوابِلٌ خطّيّهْ",10,"ه",1,1],["أقَلَّكَ والدّأماءُ تُظْهِرُ طاعة","إلَيْكَ وصفْحُ الماءِ أزْرَقُ رَقْراقُ",11,"ق",1,0],["أَقْلاَمُهُ القُضْبُ اللِّدَانُ بِدَوْحِهَا","وَالزَّهْرُ مَا رَقَمَتْهُ مِنْهُ بَنَانُ",12,"ن",1,0],["أقلامُكَ الصّفْرُ يا بُنَيّ إنْ كَتَبَتْ","رسْمَ الحُروفِ على صَفْحاتِ مسْطورِ",13,"ر",1,1],["أَقلامُهُ لَو شاءَ شَكَّ قَصيرُها","هامَ الثُرَيّا وَالسُها بِسِنانِهِ",14,"ن",2,0],["أَقلامُهُ جازَت أَقاليمَنا","وَكانَ في عَصرِ الصِبى مَقلَمَه",15,"م",2,1],["أَقِلني عِثاري وَاِحتَسِبها صَنيعَةً","يَكونُ بِرُحماها لَكَ اللَهُ جازِيا",16,"ي",2,1],["أَقِلّي بُكاءً لَستِ أَوَّلَ حُرَّةٍ","طَوَت بِالأَسى كَشحاً عَلى مَضَضِ الثَكلِ",17,"ل",1,0],["أَقِلّوا عَلَيهِم لا أَبا لِأَبيكُم","مِنَ اللَومِ أَو سُدّوا المَكانَ الَّذي سَدّوا",18,"د",3,0],["أَقَلَّ مُقيماً راضِياً بِمَكانِهِ","وَأَكثَرَ جاراً ظاعِناً لَم يُوَدَّعِ",19,"ع",1,0],["أُقَلِّبُ طَرْفِي حَيْثُ كَانُوا فَلا أَرَى","بِهِ غَيْرَ أَنْقَاضِ الذُّرَى وَالدَّعَائِمِ",20,"م",1,0],["أَقَلُّوكَ مَوْفُورَ الجَلالِ مُبَجَّلاً","وَكُلُّ شَهِيدٍ وَاجِبُ القَلْبِ وَاجِمُ",21,"م",1,0],["أَقِلّي اللَومَ عاذِلَ وَالعِتابا","وَقولي إِن أَصَبتُ لَقَد أَصابا",22,"ب",2,1],["أُقَلِّبُ طَرفي لا أَرى غَيرَ صاحِبٍ","يَميلُ مَعَ النَعماءِ حَيثُ تَميلُ",23,"ل",1,0],["أَقِلّي فَأَيّامُ المُحِبُّ قَلائِلُ","وَفي قَلبِهِ شُغلٌ عَنِ اللَومِ شاغِلُ",24,"ل",1,1],["أُقَلِّبُ طَرفي بَينَ خِلٍّ مُكَبَّلٍ","وَبَينَ صَفِيٍّ بِالحَديدِ مُصَفَّدِ",25,"د",1,0],["أَقِلني أَقِلني عَثرَةَ الدَهرِ إِنَّهُ","رَماني بِسَهمٍ صائِبِ النَصلِ مُقصِدِ",25,"د",1,0],["أقلامكمْ للملك حافظةٌ","ونوالكمْ في المجدِ للنهب",26,"ب",1,0],["أقلَّبُ قلباً بالأسى أيّ واجبٍ","وأندب شخصاً في الثرى أيُّ مندوب",27,"ب",1,0],["أقلامك الحمر في أوراقِك البيض","مشهّرات بتذهيبٍ وتفضيض",28,"ض",1,1],["أقلامه مثل السهام سديدةٌ","لكنَّها للوفدِ كالأهداف",29,"ف",1,0],["أقلامنا في طرسِ إمداحه","تجرُّها جارية خادمهْ",30,"م",2,0],["أقلام أثباتهم كأنصلهم","حمى لدين الهدى وإسلامه",31,"م",2,0],["أَقلِبُ قَلبي في سِواكَ ولاأَرى","سِوى وَحشَتي مِنهُ وَأَنتَ بِهِ أُنسي",32,"س",2,0],["أَقلِّبُ طَرفي في ربيعٍ مُبَكِّر","من العلمِ والآدابِ تترى وفي الكتب",33,"ب",1,0],["أقلامكم كرماح الخط مشرَعةٌ","طولاً كطولٍ وآثاراً كآثار",34,"ر",1,0],["أقلْ سيدي عثرة العاثر","فما أحسن العفو بالقادر",35,"ر",1,0],["أقلامُ ميمونِ النقيبه حازم","يجرين بالإنعام والإبئاس",36,"س",1,0],["أقلنيَ العثرة إني امرؤٌ","ما زلت في الصحو كثير الزلق",37,"ق",1,0],["أقِلني لا عَدِمتَ أخاً عَفُوّاً","يُقيلُكَ عند عَثْرِك وانتكاسك",38,"ك",1,0],["أقِلْني عِثارَ الظنِّ منكَ فلم تزل","تُقيلُ التي فيها تُحزُّ الحلاقمُ",39,"م",1,0],["أقلُّ ما يوجب الكريمُ لمن","يحرِمُ ألا يذيقه الهونا",40,"ن",2,0],["أقِلِ العثارَ كما أقلتَ نظيرَهُ","والمسْ خُشونَةَ ما ملكتَ بلين",41,"ن",1,0],["أُقَلِّبُهُ فَوقَ الطُروسِ وَإِنَّما","أُقَلِّبُ فَوقَ الطِرسِ سَعدِيَ أَو نَحسي",42,"س",2,0],["أَقِلّي عَلَيَّ اللَومَ يا بِنتَ مُنذِرٍ","وَنامي وَإِن لَم تَشتَهي النَومَ فَاِسهَري",43,"ر",2,1],["أَقَلُّ ما مَلَكَها مالِكُها","أَن لَحِقَت عَهدَ أَنو شَروانا",44,"ن",2,0],["أَقِلني تَجِد عَبداً شَكوراً وَصارِماً","يَحُزُّ مِن الأَعداءِ لَيثاً وَأَخدَعا",45,"ع",2,0],["اقلعت عن حب الحسان جميعها","الا هواك فلست عنه بمقلع",46,"ع",1,0],["أقلُّ حقِك أن تُطوى زواخره","إليك سبحا إذا لم تسعف القدم",47,"م",1,0],["أَقَلُّ ما بِيَ مِنْ حُبِّيكَ أَنَّ يَدِي","إذا سَمَتْ نَحْوَ قَلْبي كادَ يُنْضِجُها",48,"ج",3,0],["أُقَلِّبُ فيهِ أَجفاني كَأَنّي","أَعُدُّ بِهِ عَلى الدَهرِ الذُنوبا",49,"ب",2,0],["أَقَلُّ فَعالي بَلهَ أَكثَرَهُ مَجدُ","وَذا الجِدُّ فيهِ نِلتُ أَم لَم أَنَل جَدُّ",50,"د",1,1],["أَقَلُّ بِلاءً بِالرَزايا مِنَ القَنا","وَأَقدَمُ بَينَ الجَحفَلَينِ مِنَ النَبلِ",51,"ل",1,0],["أَقِل أَنِل أَقطِعِ اِحمِل عَلِّ سَلِّ أَعِد","زِد هَشَّ بَشَّ تَفَضَّل أَدنِ سُرَّ صِلِ",52,"ل",1,0],["أَقِل أَنِل أُن صُنِ اِحمِل عَلِّ سَلِّ أَعِد","زِد هَشَّ بَشَّ هَبِ اِغفِر أَدنِ سُرَّ صِلِ",53,"ل",1,1],["أَقلَقَتهُ بَنِيَّةٌ بَينَ أُذنَي","هِ وَبانٍ بَغى السَماءَ فَنالا",54,"ل",2,0],["أَقَلُّ ما في أَقَلِّها سَمَكٌ","يَلعَبُ في بِركَةٍ مِنَ العَسَلِ",55,"ل",1,0],["أُقَلِّبُ مِنكَ طَرفي في سَماءٍ","وَإِن طَلَعَت كَواكِبُها خِصالا",56,"ل",2,0],["أَقِلَّ اِشتِياقاً أَيُّها القَلبُ رُبَّما","رَأَيتُكَ تُصفي الوُدَّ مَن لَيسَ جازِيا",57,"ي",2,0],["أقِلَّا خِلافِي وهو مما يسوؤُني","وليس لمن يهوَى الخلافَ خليلُ",58,"ل",1,0],["أُقلِّبُ عيني لا أرى غيرَ صاحبٍ","ظننتُ به الظَّنَّ الجميلَ فخابَا",59,"ب",2,0],["أَقَلُّ إِخوانِكَ الحَميدُ غِنىً","وَأَكثَرُ الماءِ غَيرُ مَشروبِ",60,"ب",1,0],["أَقلامُ كُتّابِهِ مُوَجَّهَةٌ","لِلرَأيِ يَختارُهُ وَيَنتَخِبُه",61,"ب",2,0],["أَقَلُّ ما عُجِبُهُ الحَقُّ أَن","أُلحَقَ بِالدارِيِّ أَو نَصرِ",62,"ر",1,0],["أَقَلَّ وَفاءُ أَرضِكَ أَم تَجازَت","خَلائِقُ غَيرُ وافِيَةِ الخِلاقِ",63,"ق",1,0],["أَقِلَّ وَأَكثِر لَستَ تَبلُغُ غايَةً","تَبينُ بِها حَتّى تُضارِعَ هَيثَما",64,"م",2,0],["أقل ما بي ن حبيك أن يدي","إذا دنت من فؤادي كاد ينشجها",65,"ج",3,0],["أَقِلُّوا قَبلَ غِشْيانِ القَوافي","بذكرِكُمُ المحافلَ والجُموعا",66,"ع",2,0],["أُقَلِّبُ طَرفي مَرَّةً بَعدَ مَرَّةٍ","لِأَعلَمَ ما في النَفسِ وَالقَلبُ يَنقَلِب",67,"ب",1,0],["أَقلِل زِيارَتَكَ الصَديقَ وَلا تُطِل","هِجرانَهُ فَيَلِجَّ في هِجرانِهِ",68,"ن",2,0],["أُقَلِّبُ طَرفي كَي أَراها فَلا أَرى","وَأَحلُبُ عَيني دَرَّها وَأُصَوِّتُ",69,"ت",1,0],["أَقلِلِ المَزحَ في الكَلامِ اِحتِرازاً","فَبِإِفراطِهِ الدِماءُ تُراقُ",70,"ق",1,1],["أَقِلّي قَد أَضاقَ بُكاكِ ذَرعي","وَما ضاقَت بِنازِلَةٍ ذِراعي",71,"ع",2,0],["أَقلَقَ جَفنَ العَينَينِ عَن غُمُضِه","وَشَدَّ هَذا الحَشا عَلى مَضَضِه",72,"ض",2,1],["أَقِلَّا مَلامِي فِي هَوَى الشَّادِنِ الأَحْوَى","فَقَلْبِي عَلَى حَمْلِ الْمَلامَةِ لا يَقْوَى",73,"و",2,1],["أقللْ زيارةَ مَنْ تحبُّ لقاءَهُ","إنَّ الملالَ نتيجةُ الإكثارِ",74,"ر",1,0],["أقلني منَ الأحكامِ في البرِّ محسناً","إليَّ بفصلي عَنْهُ يا مَنْ هو البحْرُ",75,"ر",1,0],