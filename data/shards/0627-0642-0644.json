ُ",176,"ر",1,1],["اقل عَثَرات ان بناز من نبا","فأَنتَ ابر الناس قَلبا واجود",177,"د",1,0],["أَقَلُّ عَطاياهُ التَّوَقُّلُ فِي الْعُلى","وَأَدْنى سَجاياهُ التَّفَرُّدُ بِالْمَجْدِ",178,"د",1,0],["أَقَلُّ النّاسِ بِالْمالِ احْتِفالاً","وَأَكْثَرُهُمْ عَلى الْمَجْدِ احْتِرازا",179,"ز",2,0],["أَقَلْبُكَ أَمْ قَلْبِي يُصَدَّعُ بِالنَّوى","وَجِسْمُكَ يَضْنى بِالْقَطيعَةِ أَمْ جِسْمِي",180,"م",2,0],["أَقَلُّ شِعبٍ تَراهُ في دِمَشقَ يُوا","في شِعبَ بَوّانَ وافي الفَخر وَالتيهِ",181,"ي",2,0],["أَقَلُّ عَبيدِكَ في جودِهِ","فَتى طَييءٍ حاتِم إِن تَباهى",182,"ا",3,0],["أَقَلُّ جُزءٍ تَراهُ مِن مَحاسِنِهِ","فيهِ يُقَوَّمُ كُلُّ الحُسنِ بِالدونِ",183,"ن",1,0],["أَقلامُهُ تُولي النَدى وَبِالرَدى","تَرمي العِدا فَهُنَّ شُهبُ الرَجمِ",184,"م",1,0],["أَقلامُكُم في أَقاليمِ البِلادِ بِها","قَد قُلِّمَت مِن صُروفِ الدَّهرِ أَظفارُ",185,"ر",1,0],["أَقلامُهُ فيها المَنايا وَالمُنى","كَوامِناً وَطَعمُ صابٍ وَضَرَب",186,"ب",1,0],["أَقِلّا عليه في المَلام فإنَّه","يَرى الموتَ أَصفى من كدورة خَطبِهِ",187,"ب",2,0],["أَقلَّ البنا فالدَهرُ يومٌ وَلَيلَةٌ","عجولانِ للأَعمار ينتهبانِ",188,"ن",1,0],["أَقلَّتْ رحالي نحو (حمص) فخلتني","علوت بها وَفداً من الريحِ سافيا",189,"ي",2,0],["أَقَلُّ تَأديبَ بِهِ لِلَّذي","أَقَلَّ إِخلاصٌ لَهُ يَعرِفَنِ",190,"ن",1,0],["أَقَلُّ قَليلِها يَكفيكَ مِنها","وَلَكِن لَستَ تَقنَعُ بِالقَليلِ",191,"ل",1,0],["أُقِلُّ بِمالي وَرَوحي الفِداءَ","لِبَدرٍ لَهُ الشَمسُ أَضَحتُ ضِياءَ",192,"ا",2,1],["أَقل عَثَراتِ أَقلامي فَإِنّي","بِكنهِ علاك لي نَظر سَقيمُ",193,"م",1,0],["أَقِل عَثرة العالين تَرق ذرى العُلى","وَشَرُّ مَقيلٍ قائِلٌ غَيرُ فاعلِ",194,"ل",1,1],["أَقلني مِن ذُنوب أَنقَلَتني","فَأَنتَ لِعِلَّتي نِعمَ الدَواء",195,"ا",2,0],["أَقلامُه السُّودُ آثاراً إذا سطَرَتْ","في الطِّرْسِ والبيضُ آثاراً تُجاريه",196,"ي",2,0],["أَقِلَّ من عذَلٍ تَلْقَى المشَوقَ بهِ","فقَلبُه بسهامِ اللّوْمِ تَرْميه",197,"ي",2,0],["أقَلُّ النّاسِ عُمْراً أَكرَمُوهمْ","وأقصَرُ أكْعُبِ الرُّمحِ الأَعالي",198,"ل",2,0],["أُقلِّبُ طَرْفي يَمنةً ثُمَّ يَسْرةً","على إثْرِ أحوالِ الزّمانِ الحوائل",199,"ل",1,0],["أَقْلاّ عندَ طِيّتيَ المقالا","وحُلاّ عن مَطيَّتيَ العِقالا",200,"ل",2,1],["أَقَلُّ من الكواكبِ حينَ تَسْري","ضلالاً في الغياهبِ أَو كَلالا",200,"ل",2,0],["أُقلِّبُ ناظِرَيْ لَحْمٍ صَيودٍ","غدَتْ أَعطافُه تَنْفي الظِّلالا",200,"ل",2,0],["أقلامُه يَقْلِمْنَ أظفارَ الرَّدى","بيَدٍ عظيمةِ مَوقِعِ التَّوقيع",201,"ع",1,0],["أقلامُه دونَها","تَجمَعُ شَمْلَ الصِّعاد",202,"د",1,0],["أَقِل يَومَ الصِراطِ عِثارَ خَطوي","فَإِنّي مُثقَلٌ مِن حَملِ وِزري",203,"ي",1,0],["أَقلامُهُ مِن غِلطٍ طاغِيَه","وَهيَ بِما يُجري الأَسى جارِيَه",204,"ه",1,1],["أقُل حالي وإنَّ مقالَ حالي","لَمِن قُبح التَّحلِّي بالمُحالِ",205,"ل",1,1],["أقلِّبُ بَين البَينِ والدينِ مُهجَةً","على الجَمرِ في أحشاءِ لَهفان مُعسِرِ",206,"ر",1,0],["أقلامُه ينطُقنَ عنه كأنَّها","لولا الدِّرايةُ أضمرت ما أضمَرا",207,"ر",2,0],["أَقلِ العثارَ تُقَل وَلا تَحسد وَلا","تَحقد فَلَيسَ المَرء بِالمَعصوم",208,"م",1,0],["أَقل هِباتِهِ في كُلِ أَرض","كِرام الخَيل أَثقَلُها النضار",209,"ر",1,0],["أَقَلَّ إِذا ما بَخلت","مِن نَغمة الطائر",210,"ر",1,0],["أقِلْ عَثرتي واغتفِرْ زَلّتي","وقُلْ لي عَفَا الله عَمّا مَضى",211,"ض",2,0],["أقلني أقلني واغتفر لي ما مضى","ومُنَّ بما ترضاه منا وآمِنَّا",212,"ن",2,0],["أقلِّبُ قلباً بعد بعدك في الجمر","وأسبل دمعاً في خدودي كالقطر",213,"ر",1,1],["أقلُّوا أقلُّوا واحذروا الموقف الذي","سيبرز فيه كل عُرْفٍ ومنكر",214,"ر",1,0],["أُقلِّب أجفاني فلا الليل ينقضي","ولا النوم يأتيني ولا الدمع يَنْفَدُ",215,"د",1,0],["أقلامُهُ يَسقيِنَ كُلَّ ناصحٍ","وكاشحٍ كأسَيْ حَيَاةٍ وأجَلْ",216,"ل",1,0],["أقلِلْ زيارةَ من يُحِبُّكَ","من خَليطٍ أو تُحِبُّهْ",217,"ه",1,1],["أقَلُّ نَوالٍ مِنكَ يجبُرُ إقلالي","ويُنعِشُ آمالي ويدعَمُ أحوالي",218,"ل",2,1],["أقليهُمُ طُرّاً لأنِّي ضِدُّهُمْ","والضِّدُّ للضِّدِّ المُنافِس يبغِضُ",219,"ض",1,0],["أَقَلُّ قدرك أَن تدعى الأَميرُ كَما","أَقَلُّ قَدريَ أَن أَدعى مِن الشُعَرا",220,"ر",2,0],["أَقَلَّت ثراه همة يَمنيَّة","إِذا زارَت العيوق طالَ انحِدارها",221,"ر",3,0],["أُقَلِّبُ في عِرْفانِها النّاظِرَ القذِي","لعمْرُكِ إنَّ البيتَ بالظاهرِ الذي",222,"ي",1,0],["أقلّ ما نِلتُ من جَدْوَى يديهِ غِنَىً","ما ساءَني بَعدَه مَن ضَنَّ أو سَمحَا",223,"ح",2,0],["أُقَلِّبُ طرفي بالرِّجال وأَغتدي","لنفسي بنفسي خاطباً ومناجيا",224,"ي",2,0],["أَقلامه افْتَخَرَتْ على سُمُر القنا","فرأيت كلّ الفخر للأقلام",225,"م",1,0],["أقلِّدكم منِّي الثناء وإنَّه","قليلٌ ولو قلَّدتُكُمْ بالجواهر",226,"ر",1,0],["أُقَلِّبُ طرفي ولا أرى غيرَ منظرٍ","متى تختبرهُ كانَ أَلأَمَ مَخْبَرِ",227,"ر",1,1],["أَقلَعْتُ والبَحْرُ قد لانَتْ شكائِمُهُ","جِدًّا وأَقلَعَ عن مَوْجٍ وإِزْبادِ",228,"د",1,0],["أَقِلْ ذا ضُلوعٍ أَضْرَمَ الوجدُ نارَها","وإِنْ كانَ في بحر المُصافاةِ لَجَّجَا",229,"ج",2,0],["أقلّي أنينَكِ يا هذه","فما صعُبَ الخطْبُ إلا وهانا",230,"ن",2,0],["اقلّ فضائله إذ يعد","دبين الأنام علوم الأدب",231,"ب",1,0],["أَقَلُّ من الرِّئْبَالِ فِي الأَرْضِ آلِفاً","وإِنْ كَانَ لَحْمِي للحسودِ ولِلخِبِّ",232,"ب",1,0],["أقلب خدي فوق تربة قبره","وقد ساعداني الدمع فانهل والقلب",233,"ب",1,0],["أَقل شيء من الدنيا كفاك فكم","بتمرة زال عن ذي السغبة السغب",234,"ب",1,0],["أقل شيء فيؤذينا ويفرحنا","نزر من المال أو دون من الدون",235,"ن",1,0],["أقل صنائعي وثبوت ودي","أرد عليك في القبر التحيا",236,"ي",2,0],["أقلب طرفي في الديار فلا ارى","سوى مدع فضلا وليس له ذيل",237,"ل",1,0],["أقل بلاياه الشقاق الذي نرى","وأكثرها الذل الذي ساد جمعنا",238,"ن",2,0],["أقلْني يا زمانُ غِلاطَ ظنّي","بأهلكَ فهو أبرحُ ما دهاني",239,"ي",1,0],["أقلني عثرتي في حسن ظني","بأهلك أو برعيك لي أقلني",240,"ي",1,0],["أقلُّ خوفي أن أضلّ بينهم","والماءُ إن أزمن في الحوض أجَنْ",241,"ن",1,0],["أقلامُك ارتَجعتْ بواسطَ دولةً","طُرِدتْ بوخزِ أسنّةٍ ومَناصلِ",242,"ل",1,0],["أقِلْني العجزَ إن قَصَّرتُ وصفاً","لِما أوليتَ أو قَصَّرتُ شكرا",243,"ر",2,0],["أقلني أقلني جفوةً ما اعتمدتُها","وهجرةَ أعوامٍ خَلَت ما ابتدَأتُها",244,"ت",3,0],["أقِلْني من التغرير يا طالبَ العلا","ومن كدِّيَ الآمالَ تنهضُ أو تكبو",245,"ب",2,0],["أقِلْني عِثاري واتَّخذْها صنيعةً","يُطَرَّبُ شاديها ويلْهى سميرُها",246,"ر",3,0],["أقْلامُهُ كَجيادِهِ","في الحُضْرِ والشَّدِّ السَّريعِ",247,"ع",1,0],["أقلامه بسيوف الهند هازئة","وعفوه لعظيم الذنب غفار",248,"ر",1,0],["أقلُّ العطايا عندهُ السيف ماضياً","محّلىً وأدناها الجوادُ مطهّماً",249,"م",2,0],["أقلُّ عنائي أنّني فيه هائم","وأيسرُ ما ألقى الدموعُ السواجمُ",250,"م",1,1],["أَقِلني مِنَ القَولِ الَّذي لا يُوافِقُ","فَقَلبي إِلى مَن لُمتني فيهِ تائِقُ",251,"ق",1,1],["أَقَلُّ ما قاسَيتُ مِن مَطلِهِ","أَكثَرُ ما يَبلُغُهُ شَرحي",252,"ح",2,0],["أقلع بقشّك أيها الأسطول","إن التي هاجمت إسلامبول",253,"ل",1,1],["أقلي وريعان الشباب ذريعة","فلو اكتحلت قذى وشبت قذالا",254,"ل",2,0],["أَقلَقَ الشَّوقُ إليكُمْ خاطِري","وعليهِ غارَةَ الأَشْجانِ شَنْ",255,"ن",1,0],["أَقلقَ البُعْدُ لَعَمْرِي ساكِني","كيفَ يُلفي راحَةً من قَلِقا",256,"ق",2,0],["أقلَقَ الحاسِدَ منِّي","مَظهَري بعدَ انْطِوائي",257,"ي",1,1],["أقلامُ حِكمتِهِ في جِفْرِها نَقَشَتْ","كشفاً له من مِدادِ القُدْسِ إِجراءُ",258,"ا",2,0],["أقِلُّوا فقدْ عادَ البناةُ مُجدَّدا","بعينٍ لها الشيطانُ وابنهُ مهَّدا",259,"د",2,1],["أقِلّوا من التحليلِ والشّرحِ إذْ جلى","الغبارُ عن البيتِ الحرامِ مُصفَّدا",259,"د",2,0],["أقِلّوا الرّجاءَ في حقوقٍ يبثُّها","المَريدُ لكي تُمسوا لذي العينِ عُبَّدا",259,"د",2,0],["أقِلّوا من النومِ فأعمارُكمْ سدىً","ومنْ يعِش اليومَ يكُنْ موتُهُ غدا",259,"د",2,0],["أقلّوا من اللهوِ فإنّه إنّ فشا","غدا لمصائرِ الشّعوبِ مُحّدِّدا",259,"د",2,0],["أقلّوا خطاباً يرِدُ الدينَ مُفسِدا","وهُبّوا لسحقِ من عصا وتمرَّدا",259,"د",2,0],["أقلّوا وفرّحوا سيوفاً جراحُها","جراحُ الّذيْ باتَ لأهْليهِ فاقِدا",259,"د",2,0],["أقلّوا فإنّ أصغرَ القومِ في العِدا","علىْ عُمدةِ الدّيارِ يعْدُ متى عَدا",259,"د",2,0],["أقلّوا فإنّكم ملاقوهُ طُوَّعا","وإنّ لقاءَ ربّكمْ ليسَ أبْعَدا",259,"د",2,0],["أقلّوا لكيلا تخْسروا الدّينَ والدنى","فلنْ يبْسُطَ الناسُ لكمْ حينَها يَدا",259,"د",2,0],["أقلّوا فأكرمُ البيوتِ بيوتُكمْ","وأكرمُها ما انفكّ للحقِّ رافِدا",259,"د",2,0],["أقلّوا فأوّلُ البيوتِ بداركِمْ","وأوّلُها ما انفكّ للنّاسِ مَقصِدا",259,"د",2,0],["أقلني تدخر في الحشر أجراً","إذا احتاج المقيل إلى المقال",260,"ل",1,0],["أقلامَ مَرجانٍ كتَبْن بعنبَرٍ","بصحيفةِ البِلّورِ خمسةَ أسطُرِ",261,"ر",1,0],["أقلني عثار المدح فيك فلم تزل","تقيل عثار المذنبين وتغفر",262,"ر",1,0],["أَقْلامُ أَنْدَلُسٍ وحِمْيَرَ بَعْدَها","ولِبَرْبَرٍ والقِبْطِ واليُونانِ",263,"ن",1,1],["أَقلِل لَديَّ بِأَنباءِ الزّمانِ فما","أهابُ نفسي لأنّي لا أُرَجِّيها",264,"ي",3,0],["أقِلّا فشأنُكما غيرُ شاني","ولَستُ بطَوْعكما فاِتركاني",265,"ي",1,1],["أقلّبُ في الورى قلبي وطَرفي","فَأَعجبُ من ضَلالِ الحائرينا",266,"ن",2,0],["أقِلْنِيَ ربّي بالّذين اِصطفيتَهُمْ","وقلتَ لنا هم خيرُ مَنْ أنَا خالقُ",267,"ق",1,1],["أَقَلَّت إِلَيكَ الناجِداتُ مُعَرِّساً","عَلى أَمَلٍ جَوّابَ بَيداءَ قَردَدِ",268,"د",1,0],["أقل أوصافه ما الحسن أحقرهُ","ودون افعاله ما جلَّ عن حكمِ",269,"م",1,0],["أقلامهُ كالبيضِ في إمضائها","لكنها كالسُمر في التثقيفِ",270,"ف",1,0],["أَقْلِعْ سَحَابَكَ قَدْ غَرَّقْتَنِي مِنَنَاً","مَا أَدْمَنَ الغَيْثُ إِلاَّ كَانَ طُوفَانَا",271,"ن",2,0],["أَقِلْ ذَا الوُدِّ عَثْرَتَهُ وَقِفْهُ","عَلَى سَنَنِ الطَّرِيْقِ المُسْتَقِيْمَهْ",272,"ه",1,1],["أَقِلْني إن عَثَرْتُ وخُذْ بِكَفّي","أخيْكَ وفُكَّ طَرْفي من سهادِهْ",273,"د",2,0],["أُقَلِّبُ ما أبْقَتِ الحادِثا","تُ مِنْهُ وفي العيْنِ دَمْعٌ يَسُحْ",274,"ح",1,0],["أَقَلّا وُقوفاً بِالمَنازِلِ أَوقِفا","فَإَنَّ الَّذي تَستَبعِدانِ قَريبُ",275,"ب",1,0],["أَقِلْني أَقِلْني تُبتُ توبةَ ناصحٍ","لترضَى ولم أُذْنِبْ بجهلي لتغضبَا",276,"ب",2,0],["أَقلُّ اكتئابِي أَن أَرَى القلبَ جَازِعاً","وأَيسرُ وَجْدي أَن أَرى الطَرْفَ بَاكيا",277,"ي",2,0],["أَقلُّ ما يوليه تب","جيليَ مَعْ تَعْظيمِي",278,"م",2,0],["أَقلُّ هذا البر حازَ أَكثري","وبعضُ هذا الفضْلِ حَاز كُلِّي",279,"ي",1,0],["أَقلُّ جنودِك خطبُ الزمانِ","وأَدنى عبيدِك صرْفُ القَضا",280,"ض",2,0],["أَقَلُّ الذي يُولِيه تَسْكِينُ لوعةِ","وأَيسرُ ما يُسديه إِنجازُ مَوْعِدِ",281,"د",1,0],["أَقلُّ ما في جَمالِ طَلْعَتِهِ","أَجَلُّ ما في مَحاسِنِ القَمَرِ",282,"ر",1,0],["أُقَلّبُ قَلْبيَ شَوْقاً إليْهِ","وَأَذرْي عَلَيْه دُمُوعاً غِزَارا",283,"ر",2,1]]}