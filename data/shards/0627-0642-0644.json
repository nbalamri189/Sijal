0.html","الطويل"],[553,"خيال من النائي الهوى المتبعد","https://www.aldiwan.net/poem68426.html","الطويل"],[558,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[562,"ما بين أعطاف القدود الهيف","https://www.aldiwan.net/poem52947.html","الكامل"],[567,"يا مسدي العرف إسرارا وإعلانا","https://www.aldiwan.net/poem69491.html","البسيط"],[567,"أقل ذا الود عثرته وقفه","https://www.aldiwan.net/poem69517.html","الوافر"],[567,"أخ لي كنت أغبط باعتقاده","https://www.aldiwan.net/poem69712.html","الكامل"],[567,"عراني الزمان بأحداثه","https://www.aldiwan.net/poem69758.html","المتقارب"],[573,"رضى بقضاء الله فهو مصيب","https://www.aldiwan.net/poem3660.html","الطويل"],[575,"تذكرت أيام الصبابة والصبا","https://www.aldiwan.net/poem2767.html","الطويل"],[575,"كجسمك جسمي أصبح اليوم بالياً","https://www.aldiwan.net/poem2768.html","الطويل"],[575,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[575,"أحسنتم إن تحسنوا في الفعل","https://www.aldiwan.net/poem3038.html","الرجز"],[575,"أضاء بثغرك وادي أضا","https://www.aldiwan.net/poem3054.html","المتقارب"],[575,"ببرقة ثغر لا ببرقة ثهمد","https://www.aldiwan.net/poem3084.html","الطويل"],[586,"فرق بيني وبين مصطبري","https://www.aldiwan.net/poem17538.html","المنسرح"],[586,"أقلب قلبي شوقا إليه","https://www.aldiwan.net/poem17993.html","المتقارب"]],"verses":[["أَقِلّوا لا أَبا لَكُمُ وَخَلّوا","مُطاعَنَةَ الأَسِنَّةِ بِالأَشافي",0,"ي",1,0],["أُقَلَّبُ عَيناً في الإِخاءِ صَحيحَةً","إِذا اِرتَمَتِ الأَعداءُ بِالأَعيُنِ الرُمدِ",1,"د",1,0],["أَقِلني أَقِلني نَظرَةً ما اِحتَسَبتُها","فَقَد أَنهَلَت قَلبي غَليلاً وَعَلَّتِ",2,"ت",1,0],["أَقِلّوا عَلَينا لا أَباً لِأَبيكُمُ","وَلا تَرشُقونا بِاللُتَيّا وَبِالَّتي",2,"ي",1,0],["أُقِلُّ سَلامي إِن رَأَيتُكِ خيفَةً","وَأُعرِضُ كَيما لا يُقالَ مُريبُ",3,"ب",1,0],["أَقِلَّ مِنَ البُكاءِ فإِنَّ نِضوي","يَكادُ الشَّوقُ يُورِثُهُ الجُنونا",4,"ن",2,0],["أُقَلِّبُ طَرْفي في عُهودٍ وراءَها","خَبيئَةُ غَدرٍ في مَخيلَةِ كاذِبِ",5,"ب",1,0],["أَقَلُّ عَلَيكَ ضَرّاً مِن قَريحٍ","إِذا أَصحابُهُ ذَمَروهُ سارا",6,"ر",2,0],["أَقَلَّ الزيارَةَ لَمّا بَدا","لَهُ الصَرمُ أَو بَعضُ أَسبابِهِ",7,"ه",1,1],["أَقَلُّ الناسِ بِالدُنيا سُروراً","حَبيبٌ قَد نَأى عَنهُ حَبيبُ",8,"ب",1,0],["أقْلامُنا الواسِطيَّهْ","ذَوابِلٌ خطّيّهْ",9,"ه",1,1],["أقَلَّكَ والدّأماءُ تُظْهِرُ طاعة","إلَيْكَ وصفْحُ الماءِ أزْرَقُ رَقْراقُ",10,"ق",1,0],["أَقْلاَمُهُ القُضْبُ اللِّدَانُ بِدَوْحِهَا","وَالزَّهْرُ مَا رَقَمَتْهُ مِنْهُ بَنَانُ",11,"ن",1,0],["أقلامُكَ الصّفْرُ يا بُنَيّ إنْ كَتَبَتْ","رسْمَ الحُروفِ على صَفْحاتِ مسْطورِ",12,"ر",1,1],["أَقلامُهُ لَو شاءَ شَكَّ قَصيرُها","هامَ الثُرَيّا وَالسُها بِسِنانِهِ",13,"ن",2,0],["أَقلامُهُ جازَت أَقاليمَنا","وَكانَ في عَصرِ الصِبى مَقلَمَه",14,"م",2,1],["أَقِلني عِثاري وَاِحتَسِبها صَنيعَةً","يَكونُ بِرُحماها لَكَ اللَهُ جازِيا",15,"ي",2,1],["أَقِلّي بُكاءً لَستِ أَوَّلَ حُرَّةٍ","طَوَت بِالأَسى كَشحاً عَلى مَضَضِ الثَكلِ",16,"ل",1,0],["أَقِلّوا عَلَيهِم لا أَبا لِأَبيكُم","مِنَ اللَومِ أَو سُدّوا المَكانَ الَّذي سَدّوا",17,"د",3,0],["أَقَلَّ مُقيماً راضِياً بِمَكانِهِ","وَأَكثَرَ جاراً ظاعِناً لَم يُوَدَّعِ",18,"ع",1,0],["أُقَلِّبُ طَرْفِي حَيْثُ كَانُوا فَلا أَرَى","بِهِ غَيْرَ أَنْقَاضِ الذُّرَى وَالدَّعَائِمِ",19,"م",1,0],["أَقَلُّوكَ مَوْفُورَ الجَلالِ مُبَجَّلاً","وَكُلُّ شَهِيدٍ وَاجِبُ القَلْبِ وَاجِمُ",20,"م",1,0],["أَقِلّي اللَومَ عاذِلَ وَالعِتابا","وَقولي إِن أَصَبتُ لَقَد أَصابا",21,"ب",2,1],["أُقَلِّبُ طَرفي لا أَرى غَيرَ صاحِبٍ","يَميلُ مَعَ النَعماءِ حَيثُ تَميلُ",22,"ل",1,0],["أَقِلّي فَأَيّامُ المُحِبُّ قَلائِلُ","وَفي قَلبِهِ شُغلٌ عَنِ اللَومِ شاغِلُ",23,"ل",1,1],["أُقَلِّبُ طَرفي بَينَ خِلٍّ مُكَبَّلٍ","وَبَينَ صَفِيٍّ بِالحَديدِ مُصَفَّدِ",24,"د",1,0],["أَقِلني أَقِلني عَثرَةَ الدَهرِ إِنَّهُ","رَماني بِسَهمٍ صائِبِ النَصلِ مُقصِدِ",24,"د",1,0],["أقلامكمْ للملك حافظةٌ","ونوالكمْ في المجدِ للنهب",25,"ب",1,0],["أقلَّبُ قلباً بالأسى أيّ واجبٍ","وأندب شخصاً في الثرى أيُّ مندوب",26,"ب",1,0],["أقلامك الحمر في أوراقِك البيض","مشهّرات بتذهيبٍ وتفضيض",27,"ض",1,1],["أقلامه مثل السهام سديدةٌ","لكنَّها للوفدِ كالأهداف",28,"ف",1,0],["أقلامنا في طرسِ إمداحه","تجرُّها جارية خادمهْ",29,"م",2,0],["أقلام أثباتهم كأنصلهم","حمى لدين الهدى وإسلامه",30,"م",2,0],["أَقلِبُ قَلبي في سِواكَ ولاأَرى","سِوى وَحشَتي مِنهُ وَأَنتَ بِهِ أُنسي",31,"ي",1,0],["أَقلِّبُ طَرفي في ربيعٍ مُبَكِّر","من العلمِ والآدابِ تترى وفي الكتب",32,"ب",1,0],["أقلامكم كرماح الخط مشرَعةٌ","طولاً كطولٍ وآثاراً كآثار",33,"ر",1,0],["أقلْ سيدي عثرة العاثر","فما أحسن العفو بالقادر",34,"ر",1,0],["أقلامُ ميمونِ النقيبه حازم","يجرين بالإنعام والإبئاس",35,"س",1,0],["أقلنيَ العثرة إني امرؤٌ","ما زلت في الصحو كثير الزلق",36,"ق",1,0],["أقِلني لا عَدِمتَ أخاً عَفُوّاً","يُقيلُكَ عند عَثْرِك وانتكاسك",37,"ك",1,0],["أقِلْني عِثارَ الظنِّ منكَ فلم تزل","تُقيلُ التي فيها تُحزُّ الحلاقمُ",38,"م",1,0],["أقلُّ ما يوجب الكريمُ لمن","يحرِمُ ألا يذيقه الهونا",39,"ن",2,0],["أقِلِ العثارَ كما أقلتَ نظيرَهُ","والمسْ خُشونَةَ ما ملكتَ بلين",40,"ن",1,0],["أُقَلِّبُهُ فَوقَ الطُروسِ وَإِنَّما","أُقَلِّبُ فَوقَ الطِرسِ سَعدِيَ أَو نَحسي",41,"س",2,0],["أَقِلّي عَلَيَّ اللَومَ يا بِنتَ مُنذِرٍ","وَنامي وَإِن لَم تَشتَهي النَومَ فَاِسهَري",42,"ر",2,1],["أَقَلُّ ما مَلَكَها مالِكُها","أَن لَحِقَت عَهدَ أَنو شَروانا",43,"ن",2,0],["أَقِلني تَجِد عَبداً شَكوراً وَصارِماً","يَحُزُّ مِن الأَعداءِ لَيثاً وَأَخدَعا",44,"ع",2,0],["اقلعت عن حب الحسان جميعها","الا هواك فلست عنه بمقلع",45,"ع",1,0],["أقلُّ حقِك أن تُطوى زواخره","إليك سبحا إذا لم تسعف القدم",46,"م",1,0],["أَقَلُّ ما بِيَ مِنْ حُبِّيكَ أَنَّ يَدِي","إذا سَمَتْ نَحْوَ قَلْبي كادَ يُنْضِجُها",47,"ج",3,0],["أُقَلِّبُ فيهِ أَجفاني كَأَنّي","أَعُدُّ بِهِ عَلى الدَهرِ الذُنوبا",48,"ب",2,0],["أَقَلُّ فَعالي بَلهَ أَكثَرَهُ مَجدُ","وَذا الجِدُّ فيهِ نِلتُ أَم لَم أَنَل جَدُّ",49,"د",1,1],["أَقَلُّ بِلاءً بِالرَزايا مِنَ القَنا","وَأَقدَمُ بَينَ الجَحفَلَينِ مِنَ النَبلِ",50,"ل",1,0],["أَقِل أَنِل أَقطِعِ اِحمِل عَلِّ سَلِّ أَعِد","زِد هَشَّ بَشَّ تَفَضَّل أَدنِ سُرَّ صِلِ",51,"ل",1,0],["أَقِل أَنِل أُن صُنِ اِحمِل عَلِّ سَلِّ أَعِد","زِد هَشَّ بَشَّ هَبِ اِغفِر أَدنِ سُرَّ صِلِ",52,"ل",1,1],["أَقلَقَتهُ بَنِيَّةٌ بَينَ أُذنَي","هِ وَبانٍ بَغى السَماءَ فَنالا",53,"ل",2,0],["أَقَلُّ ما في أَقَلِّها سَمَكٌ","يَلعَبُ في بِركَةٍ مِنَ العَسَلِ",54,"ل",1,0],["أُقَلِّبُ مِنكَ طَرفي في سَماءٍ","وَإِن طَلَعَت كَواكِبُها خِصالا",55,"ل",2,0],["أَقِلَّ اِشتِياقاً أَيُّها القَلبُ رُبَّما","رَأَيتُكَ تُصفي الوُدَّ مَن لَيسَ جازِيا",56,"ي",2,0],["أقِلَّا خِلافِي وهو مما يسوؤُني","وليس لمن يهوَى الخلافَ خليلُ",57,"ل",1,0],["أُقلِّبُ عيني لا أرى غيرَ صاحبٍ","ظننتُ به الظَّنَّ الجميلَ فخابَا",58,"ب",2,0],["أَقَلُّ إِخوانِكَ الحَميدُ غِنىً","وَأَكثَرُ الماءِ غَيرُ مَشروبِ",59,"ب",1,0],["أَقلامُ كُتّابِهِ مُوَجَّهَةٌ","لِلرَأيِ يَختارُهُ وَيَنتَخِبُه",60,"ب",2,0],["أَقَلُّ ما عُجِبُهُ الحَقُّ أَن","أُلحَقَ بِالدارِيِّ أَو نَصرِ",61,"ر",1,0],["أَقَلَّ وَفاءُ أَرضِكَ أَم تَجازَت","خَلائِقُ غَيرُ وافِيَةِ الخِلاقِ",62,"ق",1,0],["أَقِلَّ وَأَكثِر لَستَ تَبلُغُ غايَةً","تَبينُ بِها حَتّى تُضارِعَ هَيثَما",63,"م",2,0],["أقل ما بي ن حبيك أن يدي","إذا دنت من فؤادي كاد ينشجها",64,"ج",3,0],["أَقِلُّوا قَبلَ غِشْيانِ القَوافي","بذكرِكُمُ المحافلَ والجُموعا",65,"ع",2,0],["أُقَلِّبُ طَرفي مَرَّةً بَعدَ مَرَّةٍ","لِأَعلَمَ ما في النَفسِ وَالقَلبُ يَنقَلِب",66,"ب",1,0],["أَقلِل زِيارَتَكَ الصَديقَ وَلا تُطِل","هِجرانَهُ فَيَلِجَّ في هِجرانِهِ",67,"ن",2,0],["أُقَلِّبُ طَرفي كَي أَراها فَلا أَرى","وَأَحلُبُ عَيني دَرَّها وَأُصَوِّتُ",68,"ت",1,0],["أَقلِلِ المَزحَ في الكَلامِ اِحتِرازاً","فَبِإِفراطِهِ الدِماءُ تُراقُ",69,"ق",1,1],["أَقِلّي قَد أَضاقَ بُكاكِ ذَرعي","وَما ضاقَت بِنازِلَةٍ ذِراعي",70,"ع",2,0],["أَقلَقَ جَفنَ العَينَينِ عَن غُمُضِه","وَشَدَّ هَذا الحَشا عَلى مَضَضِه",71,"ض",2,1],["أَقِلَّا مَلامِي فِي هَوَى الشَّادِنِ الأَحْوَى","فَقَلْبِي عَلَى حَمْلِ الْمَلامَةِ لا يَقْوَى",72,"و",2,1],["أقللْ زيارةَ مَنْ تحبُّ لقاءَهُ","إنَّ الملالَ نتيجةُ الإكثارِ",73,"ر",1,0],["أقلني منَ الأحكامِ في البرِّ محسناً","إليَّ بفصلي عَنْهُ يا مَنْ هو البحْرُ",74,"ر",1,0],["أَقِلّي البِعادَ أُمَّ بَكرٍ فَإِنَّما","قُصارى الحُروبِ أَن تَعودَ إِلى سِلمِ",75,"م",1,1],["أَقِلِّ المَلامَ يا عَتيقُ فَإِن