واصفين لحلمه","وأي حصاة تستوي بثبيبر",176,"ر",1,0],["أقلِّي فقَلبُ الصبِّ يَصدَعُهُ الذكرُ","ففي الحبِّ طالُ الحزنُ أو قصرَ العمرُ",177,"ر",1,1],["اقل عَثَرات ان بناز من نبا","فأَنتَ ابر الناس قَلبا واجود",178,"د",1,0],["أَقَلُّ عَطاياهُ التَّوَقُّلُ فِي الْعُلى","وَأَدْنى سَجاياهُ التَّفَرُّدُ بِالْمَجْدِ",179,"د",1,0],["أَقَلُّ النّاسِ بِالْمالِ احْتِفالاً","وَأَكْثَرُهُمْ عَلى الْمَجْدِ احْتِرازا",180,"ز",2,0],["أَقَلْبُكَ أَمْ قَلْبِي يُصَدَّعُ بِالنَّوى","وَجِسْمُكَ يَضْنى بِالْقَطيعَةِ أَمْ جِسْمِي",181,"م",2,0],["أَقَلُّ شِعبٍ تَراهُ في دِمَشقَ يُوا","في شِعبَ بَوّانَ وافي الفَخر وَالتيهِ",182,"ي",2,0],["أَقَلُّ عَبيدِكَ في جودِهِ","فَتى طَييءٍ حاتِم إِن تَباهى",183,"ا",3,0],["أَقَلُّ جُزءٍ تَراهُ مِن مَحاسِنِهِ","فيهِ يُقَوَّمُ كُلُّ الحُسنِ بِالدونِ",184,"ن",1,0],["أَقلامُهُ تُولي النَدى وَبِالرَدى","تَرمي العِدا فَهُنَّ شُهبُ الرَجمِ",185,"م",1,0],["أَقلامُكُم في أَقاليمِ البِلادِ بِها","قَد قُلِّمَت مِن صُروفِ الدَّهرِ أَظفارُ",186,"ر",1,0],["أَقلامُهُ فيها المَنايا وَالمُنى","كَوامِناً وَطَعمُ صابٍ وَضَرَب",187,"ب",1,0],["أَقِلّا عليه في المَلام فإنَّه","يَرى الموتَ أَصفى من كدورة خَطبِهِ",188,"ب",2,0],["أَقلَّ البنا فالدَهرُ يومٌ وَلَيلَةٌ","عجولانِ للأَعمار ينتهبانِ",189,"ن",1,0],["أَقلَّتْ رحالي نحو (حمص) فخلتني","علوت بها وَفداً من الريحِ سافيا",190,"ي",2,0],["أَقَلُّ تَأديبَ بِهِ لِلَّذي","أَقَلَّ إِخلاصٌ لَهُ يَعرِفَنِ",191,"ن",1,0],["أَقَلُّ قَليلِها يَكفيكَ مِنها","وَلَكِن لَستَ تَقنَعُ بِالقَليلِ",192,"ل",1,0],["أُقِلُّ بِمالي وَرَوحي الفِداءَ","لِبَدرٍ لَهُ الشَمسُ أَضَحتُ ضِياءَ",193,"ا",2,1],["أَقل عَثَراتِ أَقلامي فَإِنّي","بِكنهِ علاك لي نَظر سَقيمُ",194,"م",1,0],["أَقِل عَثرة العالين تَرق ذرى العُلى","وَشَرُّ مَقيلٍ قائِلٌ غَيرُ فاعلِ",195,"ل",1,1],["أَقلني مِن ذُنوب أَنقَلَتني","فَأَنتَ لِعِلَّتي نِعمَ الدَواء",196,"ا",2,0],["أَقلامُه السُّودُ آثاراً إذا سطَرَتْ","في الطِّرْسِ والبيضُ آثاراً تُجاريه",197,"ي",2,0],["أَقِلَّ من عذَلٍ تَلْقَى المشَوقَ بهِ","فقَلبُه بسهامِ اللّوْمِ تَرْميه",198,"ي",2,0],["أقَلُّ النّاسِ عُمْراً أَكرَمُوهمْ","وأقصَرُ أكْعُبِ الرُّمحِ الأَعالي",199,"ل",2,0],["أُقلِّبُ طَرْفي يَمنةً ثُمَّ يَسْرةً","على إثْرِ أحوالِ الزّمانِ الحوائل",200,"ل",1,0],["أَقْلاّ عندَ طِيّتيَ المقالا","وحُلاّ عن مَطيَّتيَ العِقالا",201,"ل",2,1],["أَقَلُّ من الكواكبِ حينَ تَسْري","ضلالاً في الغياهبِ أَو كَلالا",201,"ل",2,0],["أُقلِّبُ ناظِرَيْ لَحْمٍ صَيودٍ","غدَتْ أَعطافُه تَنْفي الظِّلالا",201,"ل",2,0],["أقلامُه يَقْلِمْنَ أظفارَ الرَّدى","بيَدٍ عظيمةِ مَوقِعِ التَّوقيع",202,"ع",1,0],["أقلامُه دونَها","تَجمَعُ شَمْلَ الصِّعاد",203,"د",1,0],["أَقِل يَومَ الصِراطِ عِثارَ خَطوي","فَإِنّي مُثقَلٌ مِن حَملِ وِزري",204,"ر",2,0],["أَقلامُهُ مِن غِلطٍ طاغِيَه","وَهيَ بِما يُجري الأَسى جارِيَه",205,"ه",1,1],["أقُل حالي وإنَّ مقالَ حالي","لَمِن قُبح التَّحلِّي بالمُحالِ",206,"ل",1,1],["أقلِّبُ بَين البَينِ والدينِ مُهجَةً","على الجَمرِ في أحشاءِ لَهفان مُعسِرِ",207,"ر",1,0],["أقلامُه ينطُقنَ عنه كأنَّها","لولا الدِّرايةُ أضمرت ما أضمَرا",208,"ر",2,0],["أَقلِ العثارَ تُقَل وَلا تَحسد وَلا","تَحقد فَلَيسَ المَرء بِالمَعصوم",209,"م",1,0],["أَقل هِباتِهِ في كُلِ أَرض","كِرام الخَيل أَثقَلُها النضار",210,"ر",1,0],["أَقَلَّ إِذا ما بَخلت","مِن نَغمة الطائر",211,"ر",1,0],["أقِلْ عَثرتي واغتفِرْ زَلّتي","وقُلْ لي عَفَا الله عَمّا مَضى",212,"ض",2,0],["أقلني أقلني واغتفر لي ما مضى","ومُنَّ بما ترضاه منا وآمِنَّا",213,"ن",2,0],["أقلِّبُ قلباً بعد بعدك في الجمر","وأسبل دمعاً في خدودي كالقطر",214,"ر",1,1],["أقلُّوا أقلُّوا واحذروا الموقف الذي","سيبرز فيه كل عُرْفٍ ومنكر",215,"ر",1,0],["أُقلِّب أجفاني فلا الليل ينقضي","ولا النوم يأتيني ولا الدمع يَنْفَدُ",216,"د",1,0],["أقلامُهُ يَسقيِنَ كُلَّ ناصحٍ","وكاشحٍ كأسَيْ حَيَاةٍ وأجَلْ",217,"ل",1,0],["أقلِلْ زيارةَ من يُحِبُّكَ","من خَليطٍ أو تُحِبُّهْ",218,"ه",1,1],["أقَلُّ نَوالٍ مِنكَ يجبُرُ إقلالي","ويُنعِشُ آمالي ويدعَمُ أحوالي",219,"ل",2,1],["أقليهُمُ طُرّاً لأنِّي ضِدُّهُمْ","والضِّدُّ للضِّدِّ المُنافِس يبغِضُ",220,"ض",1,0],["أَقَلُّ قدرك أَن تدعى الأَميرُ كَما","أَقَلُّ قَدريَ أَن أَدعى مِن الشُعَرا",221,"ر",2,0],["أَقَلَّت ثراه همة يَمنيَّة","إِذا زارَت العيوق طالَ 