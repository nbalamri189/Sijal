ِي، فإنْ لم تَشْتَهي النَّومَ فاسْهَرِي",124,"ر",2,1],["اقلّ مِن الأَقلّ إِذا اِختَبَرتُم","وُجودي بَل أَذُلّ مِن الأَذلّ",125,"ل",1,0],["اقل واصطنع واصفح ولن واغتفر وجد","اعن وتكرم واحمل الحمل وانهض",126,"ض",1,0],["أقلب بين العين والقلب شاكيا","فيا رب كن عونا على العين والقلب",127,"ب",1,0],["أُقَلِّبُ أَحشاءَ الهواجِسِ عَلَّني","أراها بَرَاءً في ثيابِ التَّضَرُّعِ",128,"ع",1,0],["أقلى الدنا وأخاف فرقتها","لشقيت بين المقت والزؤد",129,"د",1,1],["أقلب طرفي في السماء كطرفه","وأرصد ما راعاه قبل زماني",130,"ن",2,0],["أقلِّبُه طَوراً وأطْويه تارةً","وأنشره أُخْرى بتلك المَشاهِد",131,"د",1,0],["أقَلبٌ لاَ يَزَالُ ولَن يَزُولاَ","مُعَنًّى مِن تَذَكُّرِهِ البَتُولا",132,"ل",2,1],["أَقُل لَكَ سِحرٌ ما بذلك كِلهِ","فَزنهُ بِميزَانِ الشريعة إن بَدَا",133,"د",2,0],["أقلّ طائفةٍ في القُطر تفضلُها","فيما يؤدَّي وتعدادِ المؤدينا",134,"ن",2,0],["أقلنى من ظباء بنى عَدى","فما أخشى ظباءَ الإنس كلاَّ",135,"ل",2,0],["أقِلْنى من الوُخَّد الراسما","تِ أكْفكِ من حيّهم أن يَبينا",136,"ن",2,0],["أَقَلتَ عِثاري لا عَرَتكَ مُلِمَّةٌ","فَقالَ لَعاً مَن قالَ مِن قَبلُ لا لَعا",137,"ع",2,0],["أَقِل سُكّانَهُ العَثَراتِ وَاِحسِم","بِهَذا العَدلِ جَورَ الجائِرينا",138,"ن",2,0],["أقل للنفس ويك ألا فذوبي","وموتبي فالقضاه عليك جار",139,"ر",1,0],["أَقِلا عِتابي قد مللْتُ منَ العتبِ","يطيعُكُما لفظي ويعصيكُما قلبي",140,"ي",1,1],["أقلْ عثرةًزلت بها الرجل من فتى","عدو عِداكم وهو من حزبكم حزبُ",141,"ب",1,0],["اقل معشراً لا ذوا بعفوك عثرة","فما خاف ما خافوه منك مزيدُ",142,"د",1,0],["اقلهم اقلهم عثرة ما تمخضت","بها فكرة يوما ولا بعض ليلة",143,"ه",1,0],["أقل خذ كلام الله ثم كلامه","وميز تجد كلا لكل مكذب",144,"ب",1,0],["أقل إنك الآن المكفر نفسه","وأنت الذي ألقيتها في المنابر",145,"ر",1,0],["أَقليلٌ عَديدُكُم فَتَقولوا","إِنَّنا في الوَغى نَفيرٌ قَليلُ",146,"ل",1,0],["أَقَلُّها راحَةٌ في غَيرِ مَنفَعَةٍ","وَراحَةٌ لا يُرَجّي نَفعها شُغلُ",147,"ل",1,0],["أَقِلي فَقَد أَشجَيتِ بِالنَوحِ أَضلُعي","وَغادَرتِ قَلبي بِالشُجونِ مروَّعا",148,"ع",2,0],["أقلُّ أوصافِها ثلاثٌ","البردُ والنَّتْن والظلام",149,"م",1,0],["أقلّ