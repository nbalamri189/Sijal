{"poems":[[55,"طال ليلي واشتياقي","https://www.aldiwan.net/poem26208.html","مجزوء الرمل"],[9,"نام الخلي وبت الليل مرتفقا","https://www.aldiwan.net/poem21959.html","البسيط"],[86,"ما لهذا النجم في السحر","https://www.aldiwan.net/poem10504.html","المديد"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[72,"فريد حسن تجافى","https://www.aldiwan.net/poem20295.html","المجتث"],[51,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[51,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[91,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[85,"مال واحتجب","https://www.aldiwan.net/poem63725.html","مجزوء المتدارك"],[62,"اسعد بيوم قد أتاك مبكرا","https://www.aldiwan.net/poem52391.html","الكامل"],[45,"ردي على المشتاق بعض رقاده","https://www.aldiwan.net/poem63494.html","الكامل"],[45,"من رقبة أدع الزيارة عامدا","https://www.aldiwan.net/poem63545.html","الكامل"],[61,"ما ضر ليلتنا بسفح محجر","https://www.aldiwan.net/poem51682.html","الكامل"],[80,"أسهام مفوقات لرميي","https://www.aldiwan.net/poem31536.html","الخفيف"],[44,"لا سقيت أطلالك الداثره","https://www.aldiwan.net/poem30043.html","السريع"],[50,"يا صاح قل في حاجتي","https://www.aldiwan.net/poem64734.html","مجزوء الكامل"],[46,"أسهب الناس في المقال وما يظ","https://www.aldiwan.net/poem23567.html","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16625","المنسرح"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42727","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9497","الرمل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23651","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[107,"كبد تذوب وعبرة تترقرق","https://www.aldiwan.net/poem16518.html","الكامل"],[113,"هيمني آمي","https://www.aldiwan.net/poem40410.html","عموديه"],[158,"لي منكم يا كهف الملوك والدول","https://www.aldiwan.net/poem58757.html","الرجز"],[221,"كم قد رأيتك والظلام مخيم","https://www.aldiwan.net/poem41871.html","الكامل"],[227,"أبا عبد الإله ووجه ودي","https://www.aldiwan.net/poem50960.html","الوافر"],[227,"أسهم أصاب القلب أم لحظك الشزر","https://www.aldiwan.net/poem51047.html","الطويل"],[227,"أسهرني طول ليلتي رشا","https://www.aldiwan.net/poem51182.html","المنسرح"],[230,"يا من سبي العشاق حسنه","https://www.aldiwan.net/poem14715.html","مجزوء الكامل"],[230,"أسهر جفني وعفا","https://www.aldiwan.net/poem14822.html","مجزوء الرجز"],[278,"لقد غال نبلك يا نابل","https://www.aldiwan.net/poem60706.html","المتقارب"],[340,"ما حياتي تعب في ملل","https://www.aldiwan.net/poem55344.html","الرمل"],[362,"أسهر الناظر بعض الليالي","https://www.aldiwan.net/poem60640.html","المديد"],[377,"جد الضنا ويد الأشواق تلعب بي","https://www.aldiwan.net/poem48785.html","البسيط"],[397,"أنا ناطق باسم الشباب","https://www.aldiwan.net/poem6794.html","عموديه"],[402,"ياذا الذي ألها عاجل لهوه","https://www.aldiwan.net/poem49735.html","الكامل"],[429,"قام عن قوس حاجبيه","https://www.aldiwan.net/poem12800.html","مجزوء الخفيف"],[434,"صب براه بعدهم طول الأرق","https://www.aldiwan.net/poem2500.html","الرجز"],[436,"أهنيكما ما يهنئ الدين منكما","https://www.aldiwan.net/poem34766.html","الطويل"],[456,"لله ساع بلغته قدمه","https://www.aldiwan.net/poem55865.html","الرجز"],[456,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[456,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[456,"لو شاء سار ليلة النعف وقف","https://www.aldiwan.net/poem56113.html","الرجز"],[456,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[462,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[462,"كم بين أكناف العذيب وحاجر","https://www.aldiwan.net/poem3505.html","عموديه"],[475,"با أدمعي في رسمها الجاري","https://www.aldiwan.net/poem15193.html","الرجز"],[498,"كيف لا أندب الطلول غراما","https://www.aldiwan.net/poem37782.html","الخفيف"],[498,"ما هفهفتني نسمة الربيع","https://www.aldiwan.net/poem37979.html","السريع"],[498,"ليل المحب إذا تطاول بالسهر","https://www.aldiwan.net/poem38019.html","الكامل"],[512,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[549,"من ذل لي عينا على غمضها","https://www.aldiwan.net/poem47383.html","السريع"],[549,"بأبي وجهك الذي","https://www.aldiwan.net/poem47712.html","مجزوء الخفيف"],[551,"يا ليلة نلت فيها اللهو والوطرا","https://www.aldiwan.net/poem68404.html","البسيط"],[560,"تلك أيامنا عليها السلام","https://www.aldiwan.net/poem52965.html","الخفيف"]],"verses":[["أَسهَرُ اللَيلَ كَأَنّي","مِن هَواها في وَثاقِ",0,"ق",1,0],["أَسهو لِهَمّي وَدائي فَهيَ تُسهِرُني","بانَت بِقَلبي وَأَمسى عِندَها غَلِقا",1,"ق",2,0],["أَسهَرَتني الحادِثاتُ وَقَد","نامَ حَتّى هاتِفُ الشَجَرِ",2,"ر",1,0],["أَسهَلتُ وَاِنتَصَبَت كَجَذعِ مُنيفَةٍ","جَرداءَ يَحصَرُ دونَها جُرّامُها",3,"م",3,0],["أسهرتني وعذولي","على هواك معنى",4,"ن",2,0],["أسهَّلْتَ عندي والسفاهةُ كاسمها","رزيئةَ وُدّ ليس من ناجمِ البقْلِ",5,"ل",1,0],["أسهبتُ فيكَ وذاك ما كلَّفتني","بمواهبٍ لك لم يكنّ مَلاعنا",6,"ن",2,0],["أَسهَرُ اللَيلَ وَحشَةً","بِفُؤادٍ مُشَدَّدِ",7,"د",1,0],["أُسُّهُ الهُدى","وَالعُلا طُنُب",8,"ب",1,0],["أسهرتَ ليلكَ في صَلاحِ أمورِه","وكفيتَ ربَّ سريرهِ أن يَسْهَرا",9,"ر",2,0],["أَسهَرتِهِ حَتّى إِذا هَجَرَ الكَرى","خَلَّيتِ عَنهُ وَنِمتِ عَن إِسعادِهِ",10,"د",2,0],["أَسهَدتَ لَيلَ عَواذِلٍ لَولا اللُهى","تُصفي كَرائِمُها لَبِتنَ هَواجِدا",11,"د",2,0],["أسهرْتَ ليلي إذ عَتَبتَ فلَم أَذُقْ","غُمضاً ومَنْ تَعتُبْ عليه يَسْهرِ",12,"ر",1,0],["أسِهامٌ مُفَوّقاتٌ لرمْيِي","أم قِداحٌ مفوَّقات لضربي",13,"ي",1,1],["أَسهَرتَ عَينَ اللُؤمِ مُنذُ اِنطَوَت","عَلَيكَ أَثوابُكَ بِالساهِرَه",14,"ر",2,0],["أَسهِل مَطالِعَ حاجَةٍ","قَصَدَ اللِسانُ بِها وَجُرتا",15,"ت",2,0],["أَسهَبَ الناسُ في المَقالِ وَما يَظ","فَرُ إِلّا بِزَلَّةٍ مَسهِبوهُ",16,"ب",3,1],["أسْهَرَتْهُ وأهْلَهُ وهْيَ كالمَغْ","مورِ نوْماً تُحِسُّ منها شَخيرا",17,"ر",2,0],["أسْهَبَ في وَصْفِه عُلاكَ لنا","حتى خشينا النّفوسَ تعْبُدُها",18,"د",3,0],["أَسْهَرْتُ جَفْنِي لَكُمْ فِي نَظْمِ قَافِيَةٍ","مَا إِنْ لَهَا فِي قَدِيمِ الشِّعْرِ مِنْ مَثَلِ",19,"ل",1,0],["أَسهَلَ الطَرائِقِ خُذ","دَع سُلوكَ أَوعَرِها",20,"ر",3,0],["إِسهَروا كَيفَ شِئتُم","قَرَّ لَيلٌ وَناما",21,"م",2,0],["أسهبتُ فيكم لكي أُعلى فطأطأني","تقصيركم بي فقد أزمعت إقصارا",22,"ر",2,0],["أسْهُمٌ مِنْ كَلِمٍ مَسْنونةٌ","جاهَدَتْ في اللّهِ واللّهُ بَرَاها",23,"ا",3,0],["أَسهرت أَجفان الأَماني راصِداً","شَمس النَجاح فَسد مِنها المَشرقُ",24,"ق",1,0],["اسهر فيك ليلي","وهكذا الشجي",25,"ي",1,0],["أسهل شيء عندم مطالبي","لو أنها كانت على رأس زحل",26,"ل",1,0],["إِسهَر عَلى تَقويضِ أَركانِ الرَيا","وَاِترُك عُيونَ الأَغنِياءِ تَنامُ",27,"م",1,0],["أسهواً يا بنَ إبراهيم عنّي","فأسهو أم أعاتب أم أُراع",28,"ع",1,0],["أسهم أصاب القلب أم لَحظُكِ الشَزْرُ","وسُقمٌ بدا ما بين جفنِيك أم سِحْرٌ",29,"ر",1,1],["أَسْهرني طولَ ليلتي رَشَاٌ","يَمْزُج لي ريقَه بأقداحِهْ",30,"ح",2,1],["أسهرته فالنجوم في","كَ سميره والوجدُ خدنُه",31,"ن",2,0],["أَسهَرَ جَفني وَعَفا","حُلوُ دَلالٍ وَجفا",32,"ف",2,1],["أَسَهْمُكَ حِينَ يُصِيبُ الْقَضا","ءُ أَمْ يَدُكَ الْقَدَرُ النّازِلُ",33,"ل",1,0],["أسهر الليل وقلبي خافق","في حنايا قلبه المشتعل",34,"ل",1,0],["أسهرَ النّاظرَ بعضُ اللّيالي","وأنام الأمْنُ كُلَّ الأنام",35,"م",1,1],["أَسهر لَيلي في حُب راقد","حَتّى كَأَني للنجم راصد",36,"د",1,0],["أسهرتُ ليلي في الدراسةِ حامل","همّ التفوُّق هاجراً لمنامي",37,"ي",1,0],["اسِْهَدْ إذا ما كُنتَ تَبغي رِفْعَةً","يَوماً ولا تَبغِ الغَنائم نائمِا",38,"م",2,0],["أسهُماً كيف ما انحرف","نَ الى القلبِ تتبعُ",39,"ع",1,0],["أسهرني ونام ملء جفنه","موسّداً من الفؤاد ما خفق",40,"ق",1,0],["أَسَهْماً رماهُ عن قِسِيِّ جَوانِحِي","فِراقٌ فوَالى منهُ قَلْبيَ أَسْهُما",41,"م",2,0],["أسهرني في المدح لا يَلزَمُني","عُجْباً به ونام عمّا يَلزَمُهْ",42,"م",2,0],["أسهَمهنَّ اللصوقُ بالنسب ال","ضارب في يعرُبٍ وإن قدُما",43,"م",2,0],["أسهرته ورقدت عن أشغاله","بعضُ الفراغ يكثِّر الأشغالا",44,"ل",2,0],["أسهرني ونام من عاهدني","بنجوةٍ من رغبة ومنحرِفْ",45,"ف",1,0],["أسهرَهُ حبُّ العلا منفرِداً","وهو على ظنِّ العيون راقدُ",46,"د",1,0],["أسهرتني نجل العيون ونامت","عن ولوعي بها ولاعجِ وجدي",47,"د",2,0],["أسهرت يا وسنى الجفون جفونهُ","ورقدتَ عن ليل الكئيب الساهر",48,"ر",1,0],["أسهرُ أن لاحَ على لَعْلَعٍ","برقٌ بدا كالقَبَسِ الواري",49,"ر",2,0],["أَسهرُ اللَّيلَ والِهاً ذا شُجونٍ","وأَرى لَذَّةَ المَنامِ حَراما",50,"م",2,0],["أسْهَرُ فيهم جائعاً لأجْلِهمْ","ولَذَّ عندي سَهَري وَجوعي",51,"ع",2,0],["اسْهَرْ على شوقٍ فَغَلْغَلَةُ الدُّجاَ","فيها لِساهرِها من المولى نَظَرْ",52,"ر",1,0],["أسهُمٌ فوقَ سِهامٍ مثلها","لا يُصيبُ النُّجْحُ إلّا في خُطاها",53,"ا",3,0],["أسهرنِي في حُبِّهِ راقداً","وَاِستَلب الرّقدةَ من طَرْفي",54,"ي",1,0],["أَسهَروا لَيلَنا وبا","توا مدا اللّيل هُجَّعا",55,"ع",2,0],["أَسهَرتُموني أَنامَ اللَهُ أَعيُنَكُم","لَسنا نُبالي إِذا ما نِمتِ مَن سَهِرا",56,"ر",2,0],["أَسَهرُ الليلَ والعُيونُ نيامٌ","كرقيبٍ في حَيِّ قومٍ يُقَامُ",57,"م",1,0]]}