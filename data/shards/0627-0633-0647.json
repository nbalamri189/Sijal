5431,"هي لعبة الأقدار حين تُضللُ","https://www.poetsgate.com/ViewPoem.aspx?id=198636",""],[5443,"درس الحب","https://www.poetsgate.com/ViewPoem.aspx?id=185153",""],[5461,"قصيدة عمري","https://www.poetsgate.com/ViewPoem.aspx?id=5295",""],[5461,"غربة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=5068",""],[5463,"أحسن أعيش العمر من دون خلان","https://www.poetsgate.com/ViewPoem.aspx?id=26413",""],[5526,"نبراس","https://www.poetsgate.com/ViewPoem.aspx?id=192529",""],[5596,"من وحي \"بون\"","https://www.poetsgate.com/ViewPoem.aspx?id=206482",""],[5606,"مرحبا بالمراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=197469",""],[5648,"للاعياد ميعاد","https://www.poetsgate.com/ViewPoem.aspx?id=157233",""],[5672,"البعد بالأحباب أودى...","https://www.poetsgate.com/ViewPoem.aspx?id=206517",""],[5732,"اللي سباني بالهوى فارع الطول","https://www.poetsgate.com/ViewPoem.aspx?id=177944",""],[5759,"مقيمة","https://www.poetsgate.com/ViewPoem.aspx?id=212849",""],[5848,"الجادل","https://www.poetsgate.com/ViewPoem.aspx?id=50589",""],[5848,"ياللي تدور خير","https://www.poetsgate.com/ViewPoem.aspx?id=53193",""],[5848,"يااللي غيابك طال","https://www.poetsgate.com/ViewPoem.aspx?id=48887",""],[5895,"اِسْهَرْ لِوَحْدَكْ يا قَمَرْ","https://www.poetsgate.com/ViewPoem.aspx?id=202182",""],[5956,"أرسلتُ من أموالكم لمياتمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193833",""],[6056,"أزرق الدمع بعيوني","https://www.poetsgate.com/ViewPoem.aspx?id=130134",""],[6056,"القلب والنفس خضراء","https://www.poetsgate.com/ViewPoem.aspx?id=130182",""],[6056,"دلعهن عالي المستوى","https://www.poetsgate.com/ViewPoem.aspx?id=130337",""],[6056,"ساعة الصبر","https://www.poetsgate.com/ViewPoem.aspx?id=130358",""],[6056,"العنود","https://www.poetsgate.com/ViewPoem.aspx?id=130505",""]],"verses":[["أَسهَرُ اللَيلَ كَأَنّي","مِن هَواها في وَثاقِ",0,"ق",1,0],["أَسهو لِهَمّي وَدائي فَهيَ تُسهِرُني","بانَت بِقَلبي وَأَمسى عِندَها غَلِقا",1,"ق",2,0],["أَسهَرَتني الحادِثاتُ وَقَد","نامَ حَتّى هاتِفُ الشَجَرِ",2,"ر",1,0],["أَسهَلتُ وَاِنتَصَبَت كَجَذعِ مُنيفَةٍ","جَرداءَ يَحصَرُ دونَها جُرّامُها",3,"م",3,0],["أسهرتني وعذولي","على هواك معنى",4,"ن",2,0],["أسهَّلْتَ عندي والسفاهةُ كاسمها","رزيئةَ وُدّ ليس من ناجمِ البقْلِ",5,"ل",1,0],["أسهبتُ فيكَ وذاك ما كلَّفتني","بمواهبٍ لك لم يكنّ مَلاعنا",6,"ن",2,0],["أَسهَرُ اللَيلَ وَحشَةً","بِفُؤادٍ مُشَدَّدِ",7,"د",1,0],["أُسُّهُ الهُدى","وَالعُلا طُنُب",8,"ب",1,0],["أسهرتَ ليلكَ في صَلاحِ أمورِه","وكفيتَ ربَّ سريرهِ أن يَسْهَرا",9,"ر",2,0],["أَسهَرتِهِ حَتّى إِذا هَجَرَ الكَرى","خَلَّيتِ عَنهُ وَنِمتِ عَن إِسعادِهِ",10,"د",2,0],["أَسهَدتَ لَيلَ عَواذِلٍ لَولا اللُهى","تُصفي كَرائِمُها لَبِتنَ هَواجِدا",11,"د",2,0],["أسهرْتَ ليلي إذ عَتَبتَ فلَم أَذُقْ","غُمضاً ومَنْ تَعتُبْ عليه يَسْهرِ",12,"ر",1,0],["أسِهامٌ مُفَوّقاتٌ لرمْيِي","أم قِداحٌ مفوَّقات لضربي",13,"ب",2,1],["أَسهَرتَ عَينَ اللُؤمِ مُنذُ اِنطَوَت","عَلَيكَ أَثوابُكَ بِالساهِرَه",14,"ر",2,0],["أَسهِل مَطالِعَ حاجَةٍ","قَصَدَ اللِسانُ بِها وَجُرتا",15,"ت",2,0],["أَسهَبَ الناسُ في المَقالِ وَما يَظ","فَرُ إِلّا بِزَلَّةٍ مَسهِبوهُ",16,"ب",3,1],["أسْهَرَتْهُ وأهْلَهُ وهْيَ كالمَغْ","مورِ نوْماً تُحِسُّ منها شَخيرا",17,"ر",2,0],["أسْهَبَ في وَصْفِه عُلاكَ لنا","حتى خشينا النّفوسَ تعْبُدُها",18,"د",3,0],["أَسْهَرْتُ جَفْنِي لَكُمْ فِي نَظْمِ قَافِيَةٍ","مَا إِنْ لَهَا فِي قَدِيمِ الشِّعْرِ مِنْ مَثَلِ",19,"ل",1,0],["أَسهَلَ الطَرائِقِ خُذ","دَع سُلوكَ أَوعَرِها",20,"ر",3,0],["إِسهَروا كَيفَ شِئتُم","قَرَّ لَيلٌ وَناما",21,"م",2,0],["أسهبتُ فيكم لكي أُعلى فطأطأني","تقصيركم بي فقد أزمعت إقصارا",22,"ر",2,0],["أسْهُمٌ مِنْ كَلِمٍ مَسْنونةٌ","جاهَدَتْ في اللّهِ واللّهُ بَرَاها",23,"ا",3,0],["أسهبتم بوعودكم وأطلتم","ضد البلاغة ذلك التطويل",24,"ل",1,0],["أسهرتم جفن العدوّ ورحتم","ندمان كلّ فضيلة سمّارها",25,"ر",3,0],["أَسهرت أَجفان الأَماني راصِداً","شَمس النَجاح فَسد مِنها المَشرقُ",26,"ق",1,0],["اسهر فيك ليلي","وهكذا الشجي",27,"ي",1,0],["أسهل شيء عندم مطالبي","لو أنها كانت على رأس زحل",28,"ل",1,0],["إِسهَر عَلى تَقويضِ أَركانِ الرَيا","وَاِترُك عُيونَ الأَغنِياءِ تَنامُ",29,"م",1,0],["أسهواً يا بنَ إبراهيم عنّي","فأسهو أم أعاتب أم أُراع",30,"ع",1,0],["أسهم أصاب القلب أم لَحظُكِ الشَزْرُ","وسُقمٌ بدا ما بين جفنِيك أم سِحْرٌ",31,"ر",1,1],["أَسْهرني طولَ ليلتي رَشَاٌ","يَمْزُج لي ريقَه بأقداحِهْ",32,"ح",2,1],["أسهرته فالنجوم في","كَ سميره والوجدُ خدنُه",33,"ن",2,0],["أَسهَرَ جَفني وَعَفا","حُلوُ دَلالٍ وَجفا",34,"ف",2,1],["أَسَهْمُكَ حِينَ يُصِيبُ الْقَضا","ءُ أَمْ يَدُكَ الْقَدَرُ النّازِلُ",35,"ل",1,0],["أسهر الليل وقلبي خافق","في حنايا قلبه المشتعل",36,"ل",1,0],["أسهرَ النّاظرَ بعضُ اللّيالي","وأنام الأمْنُ كُلَّ الأنام",37,"م",1,1],["أَسهر لَيلي في حُب راقد","حَتّى كَأَني للنجم راصد",38,"د",1,0],["أسهرتُ ليلي في الدراسةِ حامل","همّ التفوُّق هاجراً لمنامي",39,"م",2,0],["اسِْهَدْ إذا ما كُنتَ تَبغي رِفْعَةً","يَوماً ولا تَبغِ الغَنائم نائمِا",40,"م",2,0],["أسهُماً كيف ما انحرف","نَ الى القلبِ تتبعُ",41,"ع",1,0],["أسهرني ونام ملء جفنه","موسّداً من الفؤاد ما خفق",42,"ق",1,0],["أَسَهْماً رماهُ عن قِسِيِّ جَوانِحِي","فِراقٌ فوَالى منهُ قَلْبيَ أَسْهُما",43,"م",2,0],["أسهرني في المدح لا يَلزَمُني","عُجْباً به ونام عمّا يَلزَمُهْ",44,"م",2,0],["أسهَمهنَّ اللصوقُ بالنسب ال","ضارب في يعرُبٍ وإن قدُما",45,"م",2,0],["أسهرته ورقدت عن أشغاله","بعضُ الفراغ يكثِّر الأشغالا",46,"ل",2,0],["أسهرني ونام من عاهدني","بنجوةٍ من رغبة ومنحرِفْ",47,"ف",1,0],["أسهرَهُ حبُّ العلا منفرِداً","وهو على ظنِّ العيون راقدُ",48,"د",1,0],["أسهرتني نجل العيون ونامت","عن ولوعي بها ولاعجِ وجدي",49,"د",2,0],["أسهرت يا وسنى الجفون جفونهُ","ورقدتَ عن ليل الكئيب الساهر",50,"ر",1,0],["أسهرُ أن لاحَ على لَعْلَعٍ","برقٌ بدا كالقَبَسِ الواري",51,"ر",2,0],["أَسهرُ اللَّيلَ والِهاً ذا شُجونٍ","وأَرى لَذَّةَ المَنامِ حَراما",52,"م",2,0],["أسْهَرُ فيهم جائعاً لأجْلِهمْ","ولَذَّ عندي سَهَري وَجوعي",53,"ع",2,0],["اسْهَرْ على شوقٍ فَغَلْغَلَةُ الدُّجاَ","فيها لِساهرِها من المولى نَظَرْ",54,"ر",1,0],["أسهُمٌ فوقَ سِهامٍ مثلها","لا يُصيبُ النُّجْحُ إلّا في خُطاها",55,"ا",3,0],["أسهرنِي في حُبِّهِ راقداً","وَاِستَلب الرّقدةَ من طَرْفي",56,"ف",2,0],["أَسهَروا لَيلَنا وبا","توا مدا اللّيل هُجَّعا",57,"ع",2,0],["أَسهَرتُموني أَنامَ اللَهُ أَعيُنَكُم","لَسنا نُبالي إِذا ما نِمتِ مَن سَهِرا",58,"ر",2,0],["أَسَهرُ الليلَ والعُيونُ نيامٌ","كرقيبٍ في حَيِّ قومٍ يُقَامُ",59,"م",1,0],["أسهَرَ العينَ وابتلاني بقيدٍ","مَنَعَ الرِجلَ أن تسيرَ لِشانِي",60,"ن",2,0],["أسهر ليلي غراماً به","وهو أخو سلوةٍ نائم",61,"م",1,0],["آسُها الثاني القُدُو","دَ الهِيفَ لمّا أن ثناها",62,"ا",3,0],["أسْهُمُ الدهر بن بَرْيٍ وَطيْش","تتأتَّى الإغراضَ من غير طيش",63,"ش",1,1],["اسهيت عن عصر لّي","فرضي ما يا تمام",64,"م",1,0],["أَسهرُ اللّيلَ وَأَرعى نَجمَهُ","كلَّما بي مرَّ جنح جاءَ جنحُ",65,"ح",1,0],["آسُها الأَخضَرُ لَمّا طلَعا","نَضِراً قَد دارَ سوراً بِالورود",66,"د",1,0],["أسهرتمونا بالجفا من بعدكم","ونعمتم في بعدكم بتهاني",67,"ن",2,0],["أسهم للقضاء جِدُّ خفيات","عن العين لا يراها الرائي",68,"ا",2,0],["أسهر وهو راقد لما جنى","نفاره عرّضني للتلف",69,"ف",1,0],["أَسْهَرَني شَوْقي إِليكمْ وَما","أَنامَني إلا الذي أسْهَرا",70,"ر",2,0],["إسهري الليل واذرفي مثل دمعي","واذكريني إذا ذكرت عليلا",71,"ل",2,0],["اسهرتَ في العلم عيناً لم تذق سنةً","إلا وأنت بها في العلم مشتغلُ",72,"ل",1,0],["أسهل ما تنوي بفك للأحد","بل هل وأل وأيا وها وفي وقد",73,"د",1,0],["أسهرني الوجدُ وطولُ الغرام","فما عرفت النوم إلا لمام",74,"م",1,1],["أَسهر الليلَ كئيباً","وأَرى الناسَ نياما",75,"م",2,0],["أسهرُ الليلَ حزيناً حائراً","لست أدري في غرامي ما العَمَل",76,"ل",1,0],["أسهرُ الليلَ راصداً بُرجَ نجمٍ","صوَّرَتهُ لناظري أوهامي",77,"م",2,0],["أسهر الليلَ سابحاً في خيالٍ","ايقظته من نومه أحلامي",78,"م",2,0],["أسهرته الليل الطويل ولم يكن","لك في الهوى حق عليه فيسهر",79,"ر",1,0],["أسهرتني وهي هائجة","مقل شأني بها شأن",80,"ن",1,0],["أسهرت مقلتاه في طاعة ال","وجد عيونا على الخضب وسنى",81,"ن",2,0],["أسهرتني يا \"وئام\"","فما تذمَّرت سهدا",82,"د",2,0],["أسهرني تنقيحها وحَقُّ من","حاول فيك مدحه أن يسهرا",83,"ر",2,0],["أسهر طرفي وانثنى مُهَوّماً","فشفَّني عمداً وما شفانيا",84,"ي",2,0],["أسهرت طرفك للرعية راعياً","وعيونهم مكحولة بسباتها",85,"ت",3,0],["أسهرت ليلك في تحرير أحرفه","وفي نهارك لا تصبو إلى تعب",86,"ب",1,0],["أسهرت أجفاني وكم قد بت في","أرقٍ لتملأ بالكرى أجفاني",87,"ن",2,0],["أسهرتني بأعين ناعسات","نمن عن ليلتي وبتُّ لما بي",88,"ب",2,0],["اسهرتموني بالحمى ورقدتمُ","من أين يشعر نائم بمسهّد",89,"د",1,0],["أسهرت طرفي على سبه","والقلب محرق بنيرانه",90,"ن",2,0],["أسهرُ الليل لست أغفي لصبحٍ","أَتُرى النومَ ذاهباً بالصباحِ",91,"ح",1,0],["أسهبَ التاريخُ فى أوصافِها","وتولّى لم يُمط عنها لِثاما",92,"م",2,0],["أسهرت جفنك في المصالح فارتقت","أوج الفلاح ومالها تعداد",93,"د",1,0],["أَسُهادٌ وَأَدمُعٌ وَزَفيرُ","بَعضُ هَذا عَلى المُحبِّ كَثيرُ",94,"ر",1,1],["أَسهرتَ طَرفي وَوَلهتَ الفُؤادَ هَوى","فَالطَرفُ وَالقَلبُ مِنّي الساهرُ الساهي",95,"ا",3,0],["أسهر طرفى وسبا مهجتي","ورد جسمي ناحلا كالخلال",96,"ل",1,1],["أسهر عيني ونام في جذل","مدرك حظّ سعى الى أجلي",97,"ل",2,1],["أسهم الموت والحياة قضاء","بيد الله، كيف شاء أصابا",98,"ب",2,0],["أسهرت للدين الحنيف أعيناً","من الحوى وفيك كانت هجعا",99,"ع",2,0],["أَسهِر به لَيلي وأظمِ جَوارحي","أَسبِل بِفَيضِ دَموعها أَجفاني",100,"ن",2,0],["أَسهرت منا أَعيناً بِالبُكا","وَقَد غفى تحتَ الثَرى من غفى",101,"ف",2,0],["أَسهرتَني بليال الشعر في شجنٍ","يَطول ليلي وَقَد طالَت بي الزُلَف",102,"ف",1,0],["أَسهرتَ بِالوَجد العُيونَ المُرْهَ في","هَذا الغَرام بسيف لَحظ مُرهفِ",103,"ف",1,1],["أَسهرتِ طَرفي ليال بت أَغنمها","بِالوَصل مشرقةً بَدري محيّاكِ",104,"ك",1,0],["أَسهَرَ الجَفنَ خَلِيّاً عَن كَرىً","مُقلَةً لَم تُطعَمِ النَومَ هُجُوعا",105,"ع",2,0],["أَسْهَرَةُ الذَّبُّ عَن الدِّينِ لا","عِشْقُ رَبيباتِ المَقاصيرِ",106,"ر",1,0],["أُسهِرتَ لِلبَرقِ الَّذي","باتَت لَوامِعُهُ مُنيرَه",107,"ر",2,1],["أسهرُ الليلَ وتغَفو ليلَها","أيُساوي نائماً مَن لم ينمْ",108,"م",1,0],["أسهَرتَ جَفنَكَ لِلجَفنِ النَّثُومِ وَلَم","تُسهِرهُ ذَا فِكرَةٍ فِي الكَونِ ذِي الحُجَجِ",109,"ج",1,0],["أَسهرتُ لك اللَيل جُفوني لَكِن","من رقدة جَدّيَ اِنتِباهُ الواشي",110,"ي",1,0],["إِسهَر إِذا اللَّيلُ اِشتَمَل","وَلا يَغُرَّنكَ الأَمَل",111,"ل",1,1],["أسهرتَ جِفنَ الجِّدِ مُستنصراً","بهمَّةٍ تَكفلُ حملَ المهامْ",112,"م",1,0],["أسهرتني وهي راقدةٌ","باحورار العين والدعجِ",113,"ج",1,0],["أسهرتَ أعينَ معشرٍ إذ حاولوا