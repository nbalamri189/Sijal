{"poems":[[55,"من شافعي وذنوبي عندها الكبر","https://www.aldiwan.net/poem30415.html","البسيط"],[55,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[65,"أهذه خطرات الربرب العين","https://www.aldiwan.net/poem46216.html","البسيط"],[32,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[32,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[90,"البحر رهو والسما صاحيه","https://www.aldiwan.net/poem44450.html","السريع"],[39,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[39,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[74,"أفدي مليحا أسودا فاح شذا","https://www.aldiwan.net/poem19586.html","الرجز"],[31,"هل تعرف اليوم من ماوية الطللا","https://www.aldiwan.net/poem6034.html","البسيط"],[40,"إني أتاني كلام ما غضبت له","https://www.aldiwan.net/poem7687.html","البسيط"],[91,"انظر إلى الكواكب","https://www.aldiwan.net/poem44667.html","مجزوء الرجز"],[47,"يهدي الخيال لنا ذكرى إذا طافا","https://www.aldiwan.net/poem65152.html","البسيط"],[63,"إلمامها أهدى إلى الصب لمم","https://www.aldiwan.net/poem51439.html","المنسرح"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62243","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62237","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16658","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16636","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42676","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[136,"إن لم تكن قد أحست البين من سلمه","https://www.aldiwan.net/poem54753.html","البسيط"],[190,"ما استشعر الصبر إلا وهو مجهود","https://www.aldiwan.net/poem43908.html","البسيط"],[199,"بانت حسينة وائتمت بمن بانا","https://www.aldiwan.net/poem54410.html","البسيط"],[211,"مابال عينك فيها عائر سهر","https://www.aldiwan.net/poem27960.html","البسيط"],[215,"عدنا إلى الحب عدنا","https://www.aldiwan.net/poem46249.html","المجتث"],[215,"مقطعات حسان","https://www.aldiwan.net/poem46612.html","المجتث"],[226,"نما على أرضها الشجر","https://www.aldiwan.net/poem55288.html","مخلع البسيط"],[234,"يا عم لا زلت في النعماء محبورا","https://www.aldiwan.net/poem51044.html","البسيط"],[240,"يا صاحبي لمن هذه","https://www.aldiwan.net/poem32116.html","المجتث"],[280,"طنب قبابك هذا العز والشرف","https://www.aldiwan.net/poem25479.html","البسيط"],[310,"يا لائما مل سمعي من مواعظه","https://www.aldiwan.net/poem56487.html","البسيط"],[369,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[373,"هل تعرف الدار عفا رسمها","https://www.aldiwan.net/poem1880.html","السريع"],[384,"دار لسعدي وآبنتي معاذ","https://www.aldiwan.net/poem4546.html","الرجز"],[401,"هل بالمنازل إن كلمتها خرسُ","https://www.aldiwan.net/poem587.html",""],[457,"نور الخلاف مائل","https://www.aldiwan.net/poem13782.html","مجزوء الرجز"],[457,"تنبهت في الروابي نسمة الفلق","https://www.aldiwan.net/poem13863.html","البسيط"],[463,"آنس برقا بالشريف لامعا","https://www.aldiwan.net/poem56123.html","الرجز"],[469,"ومخطف القد معسول مقبله","https://www.aldiwan.net/poem3322.html","عموديه"],[556,"ضرم قلبي فاضطرم","https://www.aldiwan.net/poem47190.html","مجزوء الرجز"],[556,"صدت وما كان الذي صدها","https://www.aldiwan.net/poem48048.html","الرجز"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146221","المجتث"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63971","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37717","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96656","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25350","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77888","المنسرح"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/109008","البسيط"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26453","البسيط"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20416","البسيط"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82160","الرجز"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82175","الرجز"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137036",""],[2598,"","https://poetry.dctabudhabi.ae/diwan/poem/17407","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129813","المجتث"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130835",""],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103529","البسيط"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103480","الرجز"],[3168,"","https://poetry.dctabudhabi.ae/diwan/poem/35042","البسيط"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103628","البسيط"],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106756","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[4126,"","https://poetry.dctabudhabi.ae/diwan/poem/126350","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73226","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52181","البسيط"],[4691,"تحييك يا مهجتي رسائلُها","https://www.poetsgate.com/ViewPoem.aspx?id=215986",""],[4859,"ذكريات الأمس","https://www.poetsgate.com/ViewPoem.aspx?id=190558",""],[4869,"مضمار قضاعه","https://www.poetsgate.com/ViewPoem.aspx?id=137915",""],[4927,"تغريدةُ الحبّ","https://www.poetsgate.com/ViewPoem.aspx?id=29842",""],[5022,"البردة المالكية","https://www.poetsgate.com/ViewPoem.aspx?id=186512",""],[5055,"كرام المنن","https://www.poetsgate.com/ViewPoem.aspx?id=101659",""],[5145,"أأقسد الشيب في فوديه أم قسطا","https://www.poetsgate.com/ViewPoem.aspx?id=108233",""],[5273,"أميرة الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=201577",""],[5283,"نسرين","https://www.poetsgate.com/ViewPoem.aspx?id=207578",""],[6251,"أنتَ الأمَان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76468&r=&rc=8",""]],"verses":[["كَأَنَّهُنَّ ذِئابُ القاعِ مُجفِلَةً","لَولا السَبيبُ عَلى الأَعناقِ وَالعُذُرُ",0,"ر",1,0],["كَأَنَّهُ نارُ عَليا","ءَ لِلضُيوفِ تُشَبُّ",1,"ب",1,0],["كأنَّهُنَّ مَهاً تَهفو بأعيُنِها","لِبارِقٍ بهَوادي الرِّيحِ مَقْرونِ",2,"ن",1,0],["كَأَنَّهُنَّ ذُرى هَديٍ مُجَوَّبَةٌ","عَنها الجِلالُ إِذا اِبيَضَّ الأَياديمُ",3,"م",1,0],["كَأَنَّهُنَّ خَوافي أَجدَلٍ قَرَمٍ","وَلّى لِيَسبِقَهُ بِالأَمعَزِ الخَرَبُ",4,"ب",1,0],["كأنه ندرة لما دنا","نحو المعالي يبتغيها النصيب",5,"ب",1,0],["كأنَّهُنَّ المُعَجِّلاتِ الى ال","أفرُخِ بالمُدلَهِمَّةش العُصَبُ",6,"ب",1,0],["كأنهن المعجلات الى الا","فرخ بالمدلهمة العصب",7,"ب",1,0],["كأنه نادى على حليته","فقال فقاعي مسك كله",8,"ه",1,0],["كَأَنَّهُنَّ وَقَد سُربِلنَ مِن عَلَقٍ","يَغشَينَ موقَدَ نارٍ تَقذِفُ الشُعَلا",9,"ل",2,0],["كَأَنَّ هِنداً ثَناياها وَبَهجَتُها","لَمّا اِلتَقَينا عَلى أَدحالِ دَبّابِ",10,"ب",1,0],["كأنهن الحور يطللن","من المراقب",11,"ب",1,0],["كَأَنَّهُنَّ وَقَد قارَبنَ مِن طَرَفَي","ضِدَّينِ في الحُسنِ تَبتيلاً وَإِخطافا",12,"ف",2,0],["كأنه نَشوانُ جَرَّ ذَيلَه","فكلَّما رِيعَ انتضَى عَضْباً خَذِمْ",13,"م",1,0],["كَأَنَّهُنَّ الظِّبَاءُ الأُدْمُ أَسْكَنَهَا","ضَالٌ بِغُرَّةَ أَوْضَالٌ بِدَارِينَا",14,"ن",2,0],["كَأَنَّهُ نَاشِدٌ نَادَى لِمَوْعِدِهِ","عَبْدَ مَنَافٍ إِذَا اشْتَدَّ الحَيَازِيمُ",15,"م",1,0],["كأنّهُنَّ غُروبٌ مِلؤها تَعَبٌ","فهُنّ يُمْتَحْنَ بالأرْسانِ تَقْويدا",16,"د",2,0],["كأنّهُنّ إذا عُرّينَ في رَهَجٍ","يُعْرَيْنَ بالوِرْدِِ إرْعاداً وتَصْويتا",17,"ت",2,0],["كَأَنَّهُنَّ جِمَالاتٌ مُوَقَّرَةٌ","تَمُورُ مَوْراً عَلَى أَثْبَاجِها الْغُبُطُ",18,"ط",1,0],["كأنهنّ العَذارَى خِفْن عاذلةً","فما تعرّضْنَ إلاَّ حيثُ يمضينا",19,"ن",2,0],["كأنهن أعاصير اذا احتدمت","نار الوغى وهي في التسنين دؤبان",20,"ن",1,0],["كَأنَّهُنَّ زَلِيخَا وهوَ يُوسُفُ إل","لا أنَّ يُوسَفَ رَبُّ العَرشِ قَد عَصَمه",21,"م",2,0],["كأنّه نخلات قد غبران على","مرّ الأعاصير يمحو آلها القيد",22,"د",1,0],["كَأَنَّهُنَّ قِياسُ الصَيفِ إِذ طَرَدَت","كَنَهوَراً فَزَحَتهُ الريحُ رَيّانا",23,"ن",2,0],["كَأَنَّهُ نَظمُ دُرٍّ عِندَ ناظِمِهِ","تَقَطَّعَ السِلكُ مِنهُ فَهوَ مُنتَثِرُ",24,"ر",1,0],["كأنهن سهام","تغزوكمو إن رقدتم",25,"م",1,0],["كأنهن الغواني","يمسن في يوم عيد",26,"د",1,0],["كان هنا بينهم إله","يفجر النيل للبشر",27,"ر",1,0],["كأنهنّ خدود قَدْ لُثمن فقد","أَبْقَى اللثام بها نقشاً وتأثيرا",28,"ر",2,0],["كَأَنَّهُنَّ دَوانٍ مِنهُ","وَهُنَّ نَوازِح",29,"ح",1,0],["كأَنَّهُنَّ العَذَارَى الغِيدُ نَاضِيَةً","شُفُوفُها عَنْ قُدُودٍ كُلُّها هَيَفُ",30,"ف",1,0],["كَأنّهنّ زَآبيرٌ بديباجِ","وَاِنظُر قِسيّاً بِها تَرمي حواجبهُ",31,"ه",1,0],["كأنّهنَّ نُجومُ الأُفْقِ نازلةً","جاءتْ تُقبِّلُ أرضاً أنت واطيها",32,"ي",3,0],["كأنَّهنَّ كؤوسٌ راحَ يُتْرِعُها","راحٌ ولكنْ بلا راحٍ تُعاطيها",32,"ي",3,0],["كأَنَّهُ نِصْعُ يَمانٍ وبِالْ","أَكْرُعِ تَخْنِيفٌ كَلَوْنِ الحُمَمْ",33,"م",1,0],["كأنهن قطع الأفلاذ","أس جراميز على وجاد",34,"د",1,0],["كأنه ناشطٌ هاج الكلابُ به","من وحش خَطمة في عرنينه خنسُ",35,"س",1,0],["كأنَّه نَوافِجٌ","مُجَمَّماتٌ بالشَعرْ",36,"ر",1,0],["كأنّهنَ يعاليلٌ منكّسةٌ","تمزقت بارتجاسِ الريح في الورق",37,"ق",1,0],["كأنّ هنداً فيه أو أترابها","ترفع ثم تُسدِلُ البراقعا",38,"ع",2,0],["كأنهُ نطفةٌ من ماء محنيةٍ","مرَّ النسيم عليها باردَ النفس",39,"س",1,0],["كأنّه نجمٌ هوى","أو عَلَمٌ على عَلَمْ",40,"م",1,0],["كأنّه نارٌ لباغي القِرَى","أضرمها القومُ إلى مَرْقَبِ",41,"ب",1,0],["كأ نهنَّ نشاوى","للراح فيها وئيد",42,"د",1,0],["كأنهنَّ سَبَجٌ","فيه من العاج خُطَط",43,"ط",1,0],["كأنّهُ نُقطَةٌ مِنْ عَنْبرٍ سُكِبَتْ","وَسْطَ الهِلالِ فزَادَتْ حُسْنَهُ شَرَفا",44,"ف",2,0],["كَأنّه ناسكٌ في الزهدِ مُنفردٌ","يَتلو الحواميمَ والأعرافَ والزمرا",45,"ر",2,0],["كَأَنَّهُنَّ وَالتَنائِي يُسْلِي","بِالرَقْمَتَيْنِ قِطَعٌ مِنْ سَحْلِ",46,"ل",1,0],["كَأَنهنَّ الشموس طالعة","بل هن أَبهى نضارة وَصبا",47,"ب",2,0],["كأنه نائمٌ أو شاربٌ ثملٌ","بين الرياض وبين الطائر الغرد",48,"د",1,0],["كَأَنَّهُنَّ يَواقيتٌ يَطيفُ بِها","زَبَرجَدٌ وَسطَها شَذرٌ مِنَ الذَهَبِ",49,"ب",1,0],["كَأَنَّهُنَّ بِأَيدي القَومِ في كَبِدٍ","طَيرٌ تَكَشَّفَ عَن جونِ مَزاحيفِ",50,"ف",1,0],["كأنهن فتيات زور","أو بقرات بينهن ثور",51,"ر",1,1],["كأنهن الفتيات اللعس","تحار في أظلالهن الشمس",52,"س",1,1],["كأنهن ازاهير نوافحها","ما استاف مثلاً لها في دهره اجد",53,"د",1,0],["كأَنَّهُنَّ وَأَيدي الشَربِ مُعمَلَةٌ","إِذا تَلَألَأنَ في أَيدي الغَرانيقِ",54,"ق",1,0],["كأنّه نجمُ رجمٍ","يشَقُّ ثوبَ السماء",55,"م",3,0],["كانه نفسٌ لما اضأت سرى","على الحقول وفي الروضات والقُمم",56,"م",1,0],["كأنهن رياضٌ بينها زهرٌ","يحف بطنانها منها ضواحيها",57,"ي",3,0],["كأَنَّهُنَّ زَهَرُ الحَدائقِ","وَخُضرٍ مُذهَبةِ المفارِقِ",58,"ق",1,0],["كَأَنَّهُنَ إِذا أُغرينَ عاصِيَةً","خَضِعُ الرِقابِ وَفي أَحداقِها زَرَقُ",59,"ق",1,0],["كأنهن بأعلى الدوح اذ سجعت","روم نواطق بالألفاظ من بدن",60,"ن",1,0],["كانَّهُنَّ مَماليكٌ وقد حَمَلَت","لِلذَّبِّ عن مَلِكٍ أقصَى المِذَبَّات",61,"ت",1,0],["كأنه نادس بديع العجب","ألف في أكنوس ذيذال الأبي",62,"ي",1,0],["كأنهنَّ بواكٍ فوقهُ قمراً","يحكي نسيباً فأنساها المواقيتا",63,"ت",2,0],["كأن هندياً يشمَّ مِنهُ","أو كان هندياً عليه يُنتضى",64,"ا",1,0],["كأَنهنَّ الغُصونُ النَّاعماتُ وقَد","لاحَت عَلَيهنَّ أَقمارٌ مُنيراتُ",65,"ت",1,0],["كأَنَّهُنَّ قصورُ الجِن صاعدةً","إِلى السماواتِ أَبراجاً وجُدرَانا",66,"ن",2,0],["كان هنا طيفُها يسامرُني","يظنُّ أني بهِ أبادلُها",67,"ل",3,0],["كأنّ هناءتي كانت سراباً","وطيفاً في فضاءِ الحلمِ سعدي !",68,"د",2,0],["كأنهن خلف العدو تطلب الثآر","والا عدوٍ هآب لحظة وفآته",69,"ت",2,0],["كَأَنَّهُ \\\"نَوْطَةٌ\\\" خُطَّتْº وَلَحَّنَهَاْ","عِيْدٌ، وَرَدَّدَهَاْ فِيْ حُبِّنَاْ عِيْدُ",70,"د",1,0],["كأنهن مرايا قد عكسن لنا","ما قد يكون من الأحداث والدهم",71,"م",1,0],["كأنه نجومه ترامت سرور","وترسم بعرفه حدود الزمنْ",72,"ن",1,0],["كأنهن استعرن الجود من ملكٍ","يعطي الذي اعتّره قربىً ومختبطا",73,"ط",2,0],["كأنّهُ ناسِكٌ والجِيدُ مَعْبَدُهُ","ينوي الصلاةَ وهذا الصّدرُ مِحرابُ",74,"ب",1,0],["كأنَّهُ نُسُكٌ أهفو لهُ طمَعا","في درءِ معصيةٍ تستوجبُ الأَسفا",75,"ف",2,0],["كَأَنَّهِنْ يِدْرَيْنْ مَاذَا بِنَا","أَوْ أَنَّهِنْ كَمِثْلَنَا يَعْشَقِيْنْ",76,"ن",1,0]]}