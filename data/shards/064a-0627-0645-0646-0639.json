ttps://www.poetsgate.com/ViewPoem.aspx?id=212999",""],[5688,"الجيش الأبيض","https://www.poetsgate.com/ViewPoem.aspx?id=213689",""],[5703,"عمري هواك","https://www.poetsgate.com/ViewPoem.aspx?id=207263",""],[5720,"قراري ..","https://www.poetsgate.com/ViewPoem.aspx?id=198925",""],[5725,"قضي بعرشك ظهر الجان ياسبأُ","https://www.poetsgate.com/ViewPoem.aspx?id=181731",""],[5736,"دامت لمن","https://www.poetsgate.com/ViewPoem.aspx?id=203848",""],[5776,"متى ألقاك؟","https://www.poetsgate.com/ViewPoem.aspx?id=199463",""],[5790,"يا من علا في ملكه فاقترب","https://www.poetsgate.com/ViewPoem.aspx?id=111954",""],[5956,"لا نستحقك يا بنيَّ الأغلى","https://www.poetsgate.com/ViewPoem.aspx?id=193441",""],[5956,"هزّ الورد..","https://www.poetsgate.com/ViewPoem.aspx?id=193482",""],[5997,"مُحَمّدٌ ( ص )","https://www.poetsgate.com/ViewPoem.aspx?id=214259",""],[6038,"سحر العيون","https://www.poetsgate.com/ViewPoem.aspx?id=32327",""],[6075,"عرفتك عشفا","https://www.poetsgate.com/ViewPoem.aspx?id=193315",""],[6221,"على ضفاف القمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64920&r=&rc=0",""],[6229,"حواء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65186&r=&rc=12",""],[6251,"عزة النفس .. إلى الرئيس إبراهيم الحمدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76482&r=&rc=22",""],[5190,"أبهَى قصائدِ شِعرِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78287&r=&rc=1",""],[6346,"ذهابٌ بلا عودة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84887&r=&rc=12",""]],"verses":[["يا مُنْعِماً بالي ولمْ يَكُ كاسِفاً","ومُؤَثِّلاً مالي ولمْ أكُ مُنْفِضا",0,"ض",2,0],["يا مَنْ عَلَيْهِ أمَلي حائِمٌ","ومَنْ إليهِ الحَمْدُ مَجْلوبُ",1,"ب",1,0],["يا مَنْ على طيْفِ الخَيالِ أحالَني","أتظُنّ جَفْني مثْلَ جفْنِكَ راقِدا",2,"د",2,0],["يا مَن عَجِبنا أَن يَجو","دَ بِمِثلِهِ الزَمَنُ البَخيل",3,"ل",1,0],["يا منعشي حيث شخصي في دمشق وفي","تفليس مالي ودمع العينِ في حلب",4,"ب",1,0],["يا منعمين بطيفٍ بعد فرقتهم","دعوا التهكم أين الأعين الهجع",5,"ع",1,0],["يا من على جدواه أن يهمى الحيا","وعلى نبات مدائحِي أن تعبقا",6,"ق",2,0],["يا من عُلاه عن الثناء غنيَّةٌ","والصبح أوضح أن يقام دليل",7,"ل",1,0],["يا من عرفت به كسب الألوف ومن","تمامها إنها جاءَت ولم أسَل",8,"ل",1,0],["يا من على نَيكها يُحرِّضُني","لستُ لأشْباهِها بهشّاش",9,"ش",1,0],["يا منْ عليه عيالُ آدمَ بعْدَهُ","أكفلْ أخاك وإن غدوتَ مُعيلا",10,"ل",2,0],["يا مَن عكفْنا عليهِ لائذينَ بهِ","فما عكفنا على بُدٍّ ولا وَثنِ",11,"ن",1,1],["يا من عَطاياه لديه رخيصة","وثناءُ مادِحه لديه ثمين",12,"ن",1,0],["يا مَن عَرَفتُ الناسَ حينَ عَرَفتُهُ","وَجَهِلتُهُم لَمّا نَأى وَتَنَكَّرا",13,"ر",2,0],["يا مَن عَلى الأَرضِ اسمَعوا","نَعيَ الحَياةِ لِأَهلِها",14,"ل",3,0],["يا مَن عَلى الأَرضِ افطَنوا","لِلحادِثاتِ وَكَلها",14,"ل",3,0],["يا مَن عَذيري مِمَّن كَلِفتُ بِهِ","يَشهَدُ قَلبي بِأَنَّهُ يَسحَر",15,"ر",1,0],["يا مَن عَطاهُ قَبلَ","السُؤالِ بَدا",16,"د",2,0],["يا مَن عَلى الناسِ مَقصورٌ تَفَضُّلُهُ","وَظِلُّ رَحمَتِهِ في الأَرضِ مَمدودُ",17,"د",1,0],["يا من عِتاقُ الخَيْلِ تُوسَمُ باسمِهِ","والدرهمُ المضروبُ والدّينارُ",18,"ر",1,0],["يا مَنْ عليه مَدُار المَكرُماتِ ومَنْ","بِعَدْلِهِ كُلُّ مُضطَرٍّ له سُنِدا",19,"د",2,0],["يا مَن عَلى المَدحِ شَينٌ في سِواهُ كَما","يُستَقبَحُ التاجُ مَعقوداً عَلى صَنَمِ",20,"م",1,0],["يا مَن عَناني حُسَّدُه","يُقيمُهُ وَيُقعِدُه",21,"د",2,0],["يا مَن عليهِ رداءُ البأسِ والجودِ","من جودِ كفكَ يجري الماءُ في العودِ",22,"د",1,1],["يَا مَنْ عَلَيْهِ حِجابٌ مِنْ جَلالَتِهِ","وَإِنْ بَدَا لَكَ يَوْماً غَيْرَ مَحْجُوبِ",23,"ب",1,0],["يا من على صوته في الأفق منسجماً","تصحو الأزاهرُ في أفنانها العين",24,"ن",1,0],["يَا مَنْ عَشَاؤُهُمُ شَفَى","مَرَارَتِي وَالكَبِدَا",25,"د",2,1],["يا من عرفنا كيف كن","ت وانت تعرف كيف كنا",26,"ن",2,1],["يا من عكفت على الاسا","ءة صرت اقبح معتكف",27,"ف",1,0],["يا من على ساق عرش اللَه قد كتبت","لرفعة المصطفى أيدته بعلى",28,"ل",2,0],["يا مَن عَرَفتُ بِجودِهِ وَجهَ الغِنى","حَقّاً وَكُنتُ جَهِلتُهُ إِنكارا",29,"ر",2,0],["يا منعماً لا أوفي شكره أبداً","لو أبذل النفس مرضاته ثمنا",30,"ن",2,0],["يا منْ عطاياهَ منها النصرُ والظفرُ","على المعادين إنْ قلّوا وان كثروا",31,"ر",3,1],["يا منعشي من ظلمة","الأحشاء مالك من شبيه",32,"ي",2,0],["يا مَن على وجناتِهِ","من كلِّ نابتةٍ طريفَهْ",33,"ف",2,1],["يامَن عَلى إِحسانِهِ","وَفَضلِهِ يُعَوَّلُ",34,"ل",1,0],["يا مَن عَليهِ مُعَوَّلٌ في عاجِلِ ال","دُنيا وَفي الأُخرى عَليهِ أُعَوِّلُ",35,"ل",1,0],["يا مَن عَطاياهُ كَما","اِشتَرَطَها اِقتِراحي",36,"ح",2,0],["يا مُنعِماً قبلَ السؤالِ عَلى الورى","يا مَن لهُ الشكوى إِذا خطبٌ عَرا",37,"ر",2,1],["يا من عبدت ضياءَها","وزهدتُها جسما شهيا",38,"ي",2,0],["يا مَن عَفا عن آدمٍ لَمّا عَصى","ثُمّ اِجتباهُ وحَباه وهَدى",39,"ا",1,0],["يا مَنْ عَذيري مِن هَوى شادِنٍ","ما كنتُ نَهْبَ الوَجْدِ لَوْلاه",40,"ا",2,0],["يا مَن عَلا مِنْ مَجْدِه باذخاً","مُهلَّبُ العَلْياءِ وَطّاه",40,"ا",2,0],["يا مَنْ عَلِقْتُ بذَيْلِ خِدْمتِه الّتي","ألقَتْ جَلالَتُها عليَّ قَبولا",41,"ل",2,0],["يا مَن عدَتْني عَوادٍ عن زيارتِه","لا أنّ ما بيننا حاشا العُلا رُفِضا",42,"ض",2,0],["يا مَن عَلَيهِ مِن الكَرا","مة حلة لا تُنزَع",43,"ع",1,0],["يا من عوائدك الجميل يا رب","نسألك تستر يا جميل",44,"ل",1,1],["يا مَنْ عقدْتُ بهِ الرَّجاءَ فلم يكُنْ","لي مِنهُ إرفادٌ ولا إيناسُ",45,"س",1,1],["يا مُنعِماً مَوْردُ إحسانِه","سَهلٌ فَما في مَنِّهِ مَنُّ",46,"ن",1,1],["يا من علا فرأى ما في القلوب وما","تحت الثرى وظلام الليل مندلُ",47,"ل",1,1],["يا من عليك اتكالي","لطفاً بعبدك وارحم",48,"م",1,1],["يا من عطاياهُ عند أجمعنا","منها طريفٌ في إثْرِه تالِد",49,"د",1,0],["يا من على حبّيه أضحت أسرتي","مع ما أعاني في الهوى لي حسّدا",50,"د",2,0],["يا مَنْ عَلا من رُتْبَةٍ فِي رُتْبَةٍ","حَتَّى غَدَا وَسْطَ النجومِ الخُنَّسِ",51,"س",1,0],["يا من عطاياه أمشاجا كعسكره","خيلا وشولا وأكياسا معاتيلا",52,"ل",2,0],["يا من عادات كل من جاء اليه","بسط اليد بالدعا والبر لديه",53,"ه",1,1],["يا من عَددتُكَ في صميم جوارحي","ولدى ومن زودتُ منه فضائلي",54,"ل",2,0],["يا من عهدتُ العزَّ فوق جبينِهِ","من راب عزك فاقتضى أن يرجعا",55,"ع",2,0],["يا مَن عَلِقتُ بِحَبلِ حُبِّه","وَأَماطَ عَنّي ظِلَّ قُربِه",56,"ب",2,1],["يا من عنا ممن عشقنا منعنا","ما في مشاكل امرنا التسهيل",57,"ل",1,0],["يا من عن النوم عين الصبّ حاجبها","روحي فدا عينك الوسنا وحاجبها",58,"ه",2,0],["يا منعماً إحسانه","في كل حال ليس يجحد",59,"د",1,0],["يا منعماً بنداه يعدم العدم","وينجلي بهداه الظلم والظلم",60,"م",1,1],["يا مَنْ عَلَى قَدَمِ التَّجَرُّدش قَدْ مَضَى","فَقَضَى ولَيْسَ لَهُ بِها ما يُثْقِلُ",61,"ل",1,0],["يا مَن علا بي ظهرَ وَرْدٍ سابقٍ","لمّا رأى ذمّي إليه حِصاني",62,"ن",2,0],["يا مَنْ علينا لهُ حَقُّ الثَّناءِ كما","لنا عليهِ حُقوقُ الغَوثِ والمَدَدِ",63,"د",1,0],["يا من عى البعد بالأفراح نادمني","قد جاء نظم إلينا منك يسلينا",64,"ن",2,0],["يا مَن عليّ له يد","تحكي السحابَ إذا اِستهلّا",65,"ل",2,0],["يا مَن على عرشِ العلوم اِرتقى","والفضل قد ألقى إليهِ الزمام",66,"م",1,0],["يا من علا قدراً على نظرائه","ببدائعٍ قد أعجزتْ نظراءهُ",67,"ا",3,1],["يا مَنْ عليه السَّراحِ أُعوِّلُ","وإليه في تَعجيلِه أتوسَّلُ",68,"ل",1,1],["يا مَنْ عَرا قَلْبَهُ انكِسارٌ","وما سِواهُ عَلَيْهِ جَانِ",69,"ن",1,1],["يا من عليه تزف المكرمات ومن","إليه وفد الندى قد حج واعتمرا",70,"ر",2,0],["يا من عقود كماله","قد زينت صدر الدفاتر",71,"ر",1,1],["يا من عدا وتعدَّى","لو كنتُ أملك صبري",72,"ي",1,0],["يا من على عفوه ما زلت متكلاً","جُدلي فإني لما تهواه مُحتمل",73,"ل",1,0],["يا منعما أضحت أيا","ديه وسائل كل سائل",74,"ل",1,0],["يا من عدمت الفقر حين وجدته","ما واجد لندى يديك بعادمِ",75,"م",1,0],["يا منعما تصبح أفعاله","مشرفة في الأزم السودِ",76,"د",1,0],["يا من علا قلل الفخ","ر صاعدا وتسنَّم",77,"م",1,0],["يا منعما ما زال يكنفني","بغزير جدواه ويكفيني",78,"ن",2,0],["يا منعش المرضى ومولى الجدا","يا ناشر الموتى ومحي العظام",79,"م",1,0],["يا من علا عن كيف أو كم أو","عن مشية أو جلسة أو قيام",79,"م",1,0],["يا من على العرش استوى","علما وحكما وافترد",80,"د",1,0],["يا من على الملك احتوى","من غير عد أو عدد",80,"د",1,0],["يا من على حال المعاصي أقام","حتى متى أنت وذاك المقام",81,"م",1,1],["يا من على العرش استوى بترفع","قد حار فيه كل ذي لب سليم",82,"م",1,0],["يا من على الملك احتوى وأحاطه","كما وكيفا يا عليم يا حكيم",82,"م",1,0],["يَا مَنْ عَلا أعْلَى شَرَفْ","إذْ حَازَ بِالنسب الشَّرَفْ",83,"ف",1,0],["يا مَن علا رُتبَ العلا ومن اِكتسى","برداً يفوقُ مح