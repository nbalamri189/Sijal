{"poems":[[9,"ألا يا قتل قد خلق الجديد","https://www.aldiwan.net/poem21929.html","الوافر"],[95,"عد لابساً ثوب الخلود وعلم","https://www.aldiwan.net/poem11356.html","الكامل"],[74,"جميعنا في عشقك البادي","https://www.aldiwan.net/poem18569.html","السريع"],[94,"ليت شعري","https://www.aldiwan.net/poem38945.html","الخفيف"],[87,"أبا الهول طال عليك العصر","https://www.aldiwan.net/poem63767.html","المتقارب"],[58,"يا بكر ما فعلت بك الأرطال","https://www.aldiwan.net/poem58518.html","الكامل"],[30,"تضاحكت أن رأت شيباً تفرعني","https://www.aldiwan.net/poem1241.html",""],[99,"لمن العيون الغائرات خشوعا","https://www.aldiwan.net/poem24987.html","الكامل"],[107,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39559","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202541","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54644","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54674","الخفيف"],[111,"سميري وهل للمستهام سمير","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545431",""],[133,"فلسطين من غربة موثقة","https://www.aldiwan.net/poem67434.html","المتقارب"],[193,"برئت من عقيدة الأشرار","https://www.aldiwan.net/poem35101.html","الرجز"],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[199,"جزعت أن شت صرف الحي فانفرقوا","https://www.aldiwan.net/poem54414.html","البسيط"],[202,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[240,"مدحك لا يستطيعه البشر","https://www.aldiwan.net/poem32019.html","المنسرح"],[275,"حييتها بقرنفل ممطور","https://www.aldiwan.net/poem35445.html","الكامل"],[280,"أتجحد قتلي ربة الشنف والخرص","https://www.aldiwan.net/poem25494.html","الطويل"],[371,"في الدهر موعظة وحس","https://www.aldiwan.net/poem17800.html","مجزوء الكامل"],[376,"معي كلمات ما يطاق احتمالها","https://www.aldiwan.net/poem57213.html","الكامل"],[396,"رأيت كتاب آفات اللسان","https://www.aldiwan.net/poem54473.html","عموديه"],[396,"ألا يا ابن العفيف يا","https://www.aldiwan.net/poem54588.html","عموديه"],[438,"صاح هذا ربع الهوى المعهود","https://www.aldiwan.net/poem12476.html","الخفيف"],[463,"ضنا بأن يعلم الناس الهوى لمن","https://www.aldiwan.net/poem55861.html","البسيط"],[463,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[466,"ينثي برأفته ونجدته","https://www.aldiwan.net/poem16422.html","أحذ الكامل"],[505,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[534,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[543,"شرط العظيم وصفه بالمهتدي","https://www.aldiwan.net/poem48235.html","عموديه"],[543,"لفي ضناك ضنى العلياء والحسب","https://www.aldiwan.net/poem48273.html","عموديه"],[545,"مستحصد كعلاة القين وقره","https://www.aldiwan.net/poem56806.html","البسيط"],[563,"في الدال بالإهمال إعمال بدا","https://www.aldiwan.net/poem34609.html","الكامل"],[580,"لو واصلتني يوما لم أمت أبداً","https://www.aldiwan.net/poem3080.html","البسيط"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103069","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48676","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48674","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133758","المتقارب"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25326","الرجز"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93105","الطويل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123305","المجتث"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108423","الرمل"],[2226,"","https://poetry.dctabudhabi.ae/diwan/poem/200346","الكامل"],[2251,"","https://poetry.dctabudhabi.ae/diwan/poem/82123","البسيط"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121144","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100415","الوافر"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127378","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65132","الرمل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65178","البسيط"],[3098,"","https://poetry.dctabudhabi.ae/diwan/poem/131899","الكامل"],[3447,"","https://poetry.dctabudhabi.ae/diwan/poem/32750","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52980","المتدارك"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46019","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92059","البسيط"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86503","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86358","الرمل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36275","الدوبيت"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72791","الرمل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104880","المنسرح"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120262","السريع"],[4767,"أصل الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=214135",""],[4955,"كن دائما رجل المواقف في الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=194249",""],[5026,"بردة أخرى","https://www.poetsgate.com/ViewPoem.aspx?id=210479",""],[5061,"يامهاجر","https://www.poetsgate.com/ViewPoem.aspx?id=147155",""],[5376,"يا ليل أني قد سمعت نحيبا","https://www.poetsgate.com/ViewPoem.aspx?id=198980",""],[5397,"لا تسألن معالم الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=157918",""],[5431,"والله أودعها في عقلنا الواعي","https://www.poetsgate.com/ViewPoem.aspx?id=188863",""],[5431,"(سأزرع الأرضَ آلافا من القُبَلِ)!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200121",""],[5431,"في الدير أوجاع الفرات جحافلٌ ...","https://www.poetsgate.com/ViewPoem.aspx?id=201024",""],[5638,"ملحمة حر","https://www.poetsgate.com/ViewPoem.aspx?id=197920",""],[5873,"السعادة المسبية","https://www.poetsgate.com/ViewPoem.aspx?id=215416",""],[5970,"متع النفس بما تهوى فما","https://www.poetsgate.com/ViewPoem.aspx?id=130585",""],[6082,"حالة ايثار","https://www.poetsgate.com/ViewPoem.aspx?id=59125",""],[6108,"تيه","https://www.poetsgate.com/ViewPoem.aspx?id=192747",""],[6134,"مالي أرى اعين الازهار قد ذبلت","https://www.poetsgate.com/ViewPoem.aspx?id=169549",""],[5309,"في الدوح صقر يستجم ويرقب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573849",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6237,"عودة إلى الطبيعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77860&r=&rc=2",""],[463,"سلكَ الخيالُ بحاجرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60161&r=&rc=217",""],[6290,"الْعَدْلُ مَفْقُودٌ فَكَيْفَ رُقِيُّنَا؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85160&r=&rc=11",""],[6348,"دلو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87172&r=&rc=8",""]],"verses":[["فَيا لَدَنِيَّةٍ سَتَعودُ شَزراً","وَعَمداً دارَ غَيرِكِ ما تُريدُ",0,"د",1,0],["فِي الدِّينِ مَا شَاؤُوا وَلَكِنْ فِي الحِجَى","مَا مِنْ مَسِيحيٍّ وَمَا مِنْ مُسْلِمِ",1,"م",1,0],["في الدِّين والدُّنيا لنا برّه","من قبلِ إنشاءٍ وإنشاد",2,"د",1,0],["في الدَّيَاجِي","كَمْ أُنَاجِي",3,"ي",1,0],["فَيالِدَةَ الدَهرِ لا الدَهرُ شَبَّ","وَلا أَنتَ جاوَزتَ حَدَّ الصِغَر",4,"ر",1,0],["في الدَّارِ بَعْدُ بَقِيّةٌ نَسْتَامُها","إِذْ ليسَ فيكَ بَقيّةٌ تُسْتَامُ",5,"م",1,0],["في الدارِ إِنَّكَ إِن تُحدِث فَقَد وَجَبَت","فيكَ العُقوبَةُ مِن قَطعٍ وَتَعذيبِ",6,"ب",1,0],["في الدير مثواه وفي جنح الدجى","يتحدر الحسن الشهيد دموعا",7,"ع",2,0],["في الدَردَنيلِ وَفي الجَزيرَةِ بَعدَهُ","رُعبُ المِياهِ وَرَوعَةُ النيرانِ",8,"ن",1,0],["في الدياجي عوابساً ونجوم","الليلِ بين الخفوقِ والتغويرِ",9,"ر",1,0],["في الدهر لم تصنع قيونُ الهند","ولم يسلّ الشرقُ كابن هند",10,"د",1,1],["في الدهر إذ هو ناهض لم يَشرُخ","وإذ القدامى في حلوم الأفرخ",11,"خ",1,0],["فِي الدَّيْرِ تُلْفَى عَاكِفاً ضارِعاً","مُهَجِّداً أَلِفَ الضَّنَى وَالشُّحُوبْ",12,"ب",1,0],["فِي الدِّينِ وَالدنْيَا لَهُ","حِكْمَةُ وِرْدٍ وَصَدَرْ",13,"ر",1,0],["فِي الدُّجَى مِنْ أَوْجِ الْعَلاَءِ المُنِيرِ","فَأَمَاجَتْ بِالضَّوْءِ بَحْرَ الأَثِيرِ",14,"ر",1,0],["فيا لدماء في حروراء غودرت","تمور وأطباق السماء تمور",15,"ر",1,0],["فيا لَدِمائِك مُهراقةً","فِداءً لأمجادنا المُهرَقَة",16,"ق",2,0],["في الدينِ وَالدُنيا ويوم الحشرِ","خيرُ البرايا نُخبة الأخيارِ",17,"ر",1,0],["في الدينِ والدنيا وجيهٌ بارعُ","قَد فاقَ أهلَ الأرضِ طرّاً والسما",18,"م",2,0],["في الدينِ لا الدنيا حريص مغرمُ","وَلَم يَزل باللَّه صبّاً مُغرما",18,"م",2,0],["في آلِ دَوِيَّةٍ تَجري السَرابُ بِها","إِذا تَرَقرَقَ ضَحلُ القاعَةِ القَرِقُ",19,"ق",1,0],["في الدَّسْتِ منه علمٌ أصيدٌ","وفي الوغى خر غامة أغلب",20,"ب",1,0],["في الدِرعِ مِنهُ لَيثُ العَرينِ وَفي ال","بَيضَةِ مِن حُسنِ وَجهِهِ قَمَرُ",21,"ر",1,0],["في الديرِ كان لقاؤنا ومجيئُنا","لسماعِ قدّاسٍ هناكَ كبير",22,"ر",1,0],["فَيَا لدَمٍ قَدْ أَهْدَرَتْهُ ثديُّهَا","وأَلحَاظُهَا بالهَبْرِ عَمْداً وبالْقَعْصِ",23,"ص",1,0],["في الدَهرِ مَوعِظَةٌ وَحَس","بُكَ إِن تَكُن وَصَلَت إِلَيكا",24,"ك",2,1],["فيا لِدماءٍ قد تَساوى حَرامُها","على كلِّ عَضبٍ باترٍ وحَلالُها",25,"ل",3,0],["في الدنيا وفي الاخرى جميعا","فهل فطن سميع ذو جنان",26,"ن",1,0],["في الدنيا وفي يوم","به الأعضاء تشهد",27,"د",1,0],["في الدجى ساهرٌ يصلي ويدعو","خائفاً والأنامُ طُرّاً رُقودُ",28,"د",1,0],["في الدّست أبلجُ ملءُ الدّست من مَرَحٍ","ومن وقارٍ ومن صمتٍ ومن لَسَنِ",29,"ن",1,0],["في الداعريّ به قِلا","صُ الداعريّ وأينقُهْ",30,"ق",2,0],["في الدَّسْتِ منه إذا حَبا وعَفا","الأيْهَمانِ البَحْرُ والجَبَلُ",31,"ل",1,0],["في الدَّهر من شأنِهِ شأنٌ يحوِّلُهُ","وعن ضِياءِ الضُّحى للعُمْشِ إِغْضاءُ",32,"ا",2,0],["في الدَّارَ قُطْني ثَبَتَتْ","والطَّبرانِيّ صَدَرَتْ",33,"ت",1,0],["في الدِّينِ والدنيا ويَومَ الموعدِ","إنَّه للأخرَى أخو تَزَّودِ",34,"د",1,0],["في الدَّنِّ رَاحٌ وفي كاسَاتها قَبَسٌ","أما تَرى في خُدُودٍ خَمرةَ اللَّهبِ",35,"ب",1,0],["في الدِرعِ لَيثٌ وَفي النَكراءِ داهيَةٌ","وَالأزمُ غَيثٌ وَفي ناديِّهِ القَمَرِ",36,"ر",1,0],["في الدال بالإهمال إعمالٌ بدا","خبرٌ له عين الحقيقة مبتدا",37,"د",2,1],["في الدَّسْتِ يَقْعدُ والأَقدارُ قَائِنةٌ","مِنْ شَاءَ يَقعد فليقعدْ كما قَعدَا",38,"د",2,0],["في الدهر منه وفي الوجود وفي الفضا","إمكان عين بالزمان زوائد",39,"د",1,0],["في الدين والإقليم حاربنا العدى","حتى أضعنا الدين والإقليما",40,"م",2,0],["في الداء طبّاً في الكريهة سلوةً","في الخوف أمناً في العثار مقيلا",41,"ل",2,0],["فيا لدجاه تفتق ثغراً","فثغراً على فجوات السماء",42,"ا",2,0],["فِي الدارِ تَحْجالُ الغُراب الأَعْوَرِ","وَمُوقَدٌ ضَابٍ وَباقِي مِشْوَرِ",43,"ر",1,0],["فيالدماء قد أريقت وياله شجىً","فتت الأكباد حيث جرت هدرا",44,"ر",2,0],["في الدهور","ما تتمناه",45,"ه",1,0],["في الدجى طيف حبيبي لاح لي","باسماً حتى قضى بالعجب",46,"ب",1,0],["في الدوح مني بلبل بفصاحة","وكذاك في الملكوت علم صافي",47,"ف",2,0],["في الدَنّ قَد عتُقت حولين فامتنعت","تَحكي إِذا صُفقت إِكليلَ مرجانِ",48,"ن",1,0],["في الدّن أحمدُ سَائح ومقطع","قِطَعَ الفيافي والفلا والبلقع",49,"ع",1,1],["في الدن اكبر منصف في كفه","قاموس جود او حُسامٍ مقلِع",49,"ع",1,0],["في الدن تامور العلا وفؤاده","انسان عين جماله المتطلع",49,"ع",1,0],["فيا لدنا نزعت له لسانا","ويا عضباً فجعت به القيونا",50,"ن",2,0],["في الدار في الحان في الأفراح في","مرحى بين الرياض وحتى في صلاواتي",51,"ت",2,0],["في الدّياجي يتبتّل","للحكيم الحاكم",52,"م",1,0],["في الدّرس ترزُ من أبحاثه نُكتٌ","كأنّها فوق صحن الخدّ خيلانُ",53,"ن",1,0],["في الدِّين فِقدُ الشَّيخ أعَظَمُ ثلمَةٍ","ما إن تُسَد وخَرقُها لم يُرقَع",54,"ع",1,0],["فَيا لَدَهرٍ مَضى ما كانَ أَحسَنَهُ","إِذ أَنتَ مُمتَنِعٌ وَالشَرطُ دينارُ",55,"ر",1,0],["في الدنيا مصر أجلُّ وطنْ","يدُها عُليا في كل زمنْ",56,"ن",1,0],["في الدَّهرِ يَومٌ مِن لَهيبِ كُراتِها","لِلكَونِ مِنهُ ما رَأَتهُ ثَمودُ",57,"د",1,0],["فيا لدهرٍ يعيرُ التُربَ جَوهرَهُ","كَأَنه جاهلٌ فيما يضيع ثمن",58,"ن",1,0],["في الدولة الغراء تب","لغ من عمارتها مناك",59,"ك",1,0],["في الدجى إلا وخلت الصبح لاح","عربٌ تختال في أمراطها",60,"ه",2,0],["في الدَمع مَتى غَرَّقَني صُدغُكَ ذا","قالوا مُطِرَ اليَوم بَنَوءِ العَقرَب",61,"ب",1,0],["في الدجى ان لمعت أسيافهُ","خشى الليلُ من الصبحِ افتضاحا",62,"ح",2,0],["في الدار بين الغميم والسند","أيام وصل مضت ولم تعد",63,"د",1,1],["في الدحر ترحيب وفي اللعن ما","يفهمها التحبيذ 