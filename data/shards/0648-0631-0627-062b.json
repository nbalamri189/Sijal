{"poems":[[23,"نشدت بني النجار أفعال والدي","https://www.aldiwan.net/poem21244.html","الطويل"],[74,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[186,"يا أربع الخيف يسقي الماء واديها","https://www.aldiwan.net/poem67024.html","البسيط"],[356,"وأعرافه الشم التي لاح دونها","https://www.aldiwan.net/poem68981.html","الطويل"],[422,"بكيت الديار وأطلالها","https://www.aldiwan.net/poem53946.html","الطويل"],[422,"تولت من الظلماء تلك الدياجر","https://www.aldiwan.net/poem54031.html","الطويل"],[445,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"],[505,"يستغرب الخب أن نعلو وقد برزت","https://www.aldiwan.net/poem37809.html","البسيط"],[558,"نبا به الوساد","https://www.aldiwan.net/poem68396.html","مجزوء الرجز"],[563,"إن كنت لم ترض عن النفس","https://www.aldiwan.net/poem34447.html","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80015","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113998","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27862","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27874","الطويل"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145537","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85195","الرجز"],[186,"يا أربع الخيف يسقي الماء واديها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55807&r=&rc=70",""],[6290,"هَلْ تَسْتَقِيمُ جُذُوعُنَا يَوْماً؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85166&r=&rc=16",""],[2220,"إذا أنت لم تعرف إلهك فاعتكف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11821&r=&rc=690",""]],"verses":[["وَراثَ عَلَيهِ الوافِدونَ فَما يَرى","عَلى النَأيِ مِنهُم ذا حِفاظٍ يُطالِعُه",0,"ع",2,0],["وراثة لك يا ابن السابقين علاً","في بثِّ مكرمةٍ أو حسم آلام",1,"م",1,0],["وراث ينصح للجرداء ساحتها","وطم ما رد صفنان وصحنان",2,"ن",1,0],["وَراثُ مَجدٍ كَبيراً نيطَ كابِرُهُ","عَن سالفيه بِعزٍّ فاقَ تَشبيها",3,"ي",3,0],["وراثة آباءٍ تولوا خلائفٍ","بهاليل أملاكٍ خضارمةٍ زهرِ",4,"ر",1,0],["وراثة آبائك الطاهرين","فما أحَدٌ غيرهم نالها",5,"ل",3,0],["وراثة آباءٍ كرامٍ تقدَّموا","أوائلهم أربابها والأواخر",6,"ر",1,0],["وِراثَةَ مُورِثِ الأَبناءِ مِمَّا","تَحَلّى مِنْ تُرَاثِ الأَنْبِياءِ",7,"ا",2,0],["وِراثَةُ المُصْطَفى أحْرَزْتُ مَوْكِبَها","عَطِيَّةُ الإجْتِبا من سَيِّدِ الرُّسُلِ",8,"ل",1,0],["وِراثَةً إِيّاها","وَرَثَّهُ زِيادُ",9,"د",1,0],["وراثة علمية حققت","عمن لحرف الكون كالطرس",10,"س",1,0],["وراثيَه إنَّ الكلام لضائقٌ","بعظم الجوى بل لا يضيق استماعه",11,"ع",2,0],["وِراثةً منهُ عَن شيخِ الشيوخِ كما","لِ الدينِ مَن لَم يحِف عن أقومِ السنَنِ",12,"ن",1,0],["وراثة علوية نالها","من أحمد خير الورى منصبا",13,"ب",2,0],["وراثة من أحيى به الله قلبَه","ولو كنت كنتُ الوارثَ الخلف الخلفا",14,"ف",2,0],["وراثة شورى لو أعيد لما وعت","لدعوته الآذان دعوى منازع",15,"ع",1,0],["وراثة حسية وباطنه","أكرم بها ظاهرة وكامنه",16,"ه",1,0],["وراث مجد كبيراص نيط كابره","عن سالفيه بعز فاق تشبيها",17,"ي",3,0],["وُرَّاثُنَا هُودٌ يَطِيرُ شَرَارُهُمْ","وَ قُضَاتُنَا الْأَقْسَاطُ أَمْرِيكَانُ",18,"ن",1,0],["وراثة علمٍ من شرائعِ رسله","لنرجعَ فيه للإله إذا أبنا",19,"ن",2,0]]}