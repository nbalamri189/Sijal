{"poems":[[55,"ألا يا لقومي للخطوب الطوارق","https://www.aldiwan.net/poem29952.html","الطويل"],[55,"وقفنا لهم من وراء الخطو","https://www.aldiwan.net/poem30668.html","المتقارب"],[88,"هنيئا أيها الملك الأجل","https://www.aldiwan.net/poem68929.html","الوافر"],[73,"حبيب نأى وهو القريب المصاقب","https://www.aldiwan.net/poem4021.html","الطويل"],[4,"طلل لخولة بالرسيس قديم","https://www.aldiwan.net/poem21193.html","الكامل"],[74,"أعيذ ريم الترك بالروم","https://www.aldiwan.net/poem19684.html","السريع"],[53,"أسالم قد سلمت من العيوب","https://www.aldiwan.net/poem8313.html","الوافر"],[30,"أقول لمنحوض أعالي عظامها","https://www.aldiwan.net/poem5461.html","الطويل"],[63,"محلك مثل الغاب ليس يرام","https://www.aldiwan.net/poem51457.html","الطويل"],[108,"ثورة على الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=179425",""],[92,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[119,"خفايا المعاني تنجلي بالدلائل","https://www.aldiwan.net/poem40849.html","عموديه"],[173,"بيني فما أنت من جدي ولا لعبي","https://www.aldiwan.net/poem1605.html",""],[236,"لمن طلل دون الربا والتنائث","https://www.aldiwan.net/poem44596.html","الطويل"],[266,"منهل دمع المحب من دمه","https://www.aldiwan.net/poem38141.html","المنسرح"],[280,"ولي العهد أم عهد الولي","https://www.aldiwan.net/poem25452.html","الوافر"],[280,"يقر بعيني أن قلبي ما قرا","https://www.aldiwan.net/poem25560.html","الطويل"],[354,"تسننت في عشقي له وهو شيعة","https://www.aldiwan.net/poem15574.html","الطويل"],[361,"ألمت بنا أهلا وسهلا","https://www.aldiwan.net/poem24532.html","الطويل"],[364,"ما أومض البرق بالجرداء مبتسماً","https://www.aldiwan.net/poem809.html",""],[409,"إلى الأشراف أعيان الأنام","https://www.aldiwan.net/poem33410.html","الوافر"],[422,"هو البرق مما راعها وشجاها","https://www.aldiwan.net/poem54106.html","الطويل"],[463,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[463,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[466,"وأبلج سمح من ذؤابة خندف","https://www.aldiwan.net/poem16113.html","الطويل"],[505,"قد أبصر الزمان علوى وغفا","https://www.aldiwan.net/poem37959.html","الرجز"],[505,"نحن شموس الحضرة المشعشعه","https://www.aldiwan.net/poem37973.html","الرجز"],[520,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126682","الطويل"],[794,"","https://poetry.dctabudhabi.ae/diwan/poem/101206","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119924","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59430","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59426","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59408","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130621","الطويل"],[1385,"","https://poetry.dctabudhabi.ae/diwan/poem/178070","المنسرح"],[1456,"","https://poetry.dctabudhabi.ae/diwan/poem/143625","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79868","السريع"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48957","السريع"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77823","المنسرح"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114031","الوافر"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100475","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69425","المتقارب"],[2274,"","https://poetry.dctabudhabi.ae/diwan/poem/144754","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93662","الطويل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/198644","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74195","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74238","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87649","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74072","المتقارب"],[3540,"","https://poetry.dctabudhabi.ae/diwan/poem/100522","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216835","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131014",""],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141845","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35108","البسيط"],[5010,"تسنّم المجد","https://www.poetsgate.com/ViewPoem.aspx?id=189894",""],[5039,"السالفه","https://www.poetsgate.com/ViewPoem.aspx?id=48116",""],[5431,"نور على نورِ","https://www.poetsgate.com/ViewPoem.aspx?id=199391",""],[5582,"حَلِيفُ جَوَىً ما ناحَ يَوْماً حَمامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=187264",""],[5582,"سَقاكِ دِيارَ الظَّاعِنِينَ غَمامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187273",""],[5781,"بِلَونِ عينيكَ القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=204074",""],[5956,"القدِّيسة النقية تقية","https://www.poetsgate.com/ViewPoem.aspx?id=215548",""],[4442,"الدر في التاج غير الدر السدف","https://www.poetsgate.com/ViewPoem.aspx?id=171197",""],[6164,"حب وعرفان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66047&r=&rc=56",""]],"verses":[["تَسَنَّمَ أَعلى طَودِها غَيرَ عاثِرٍ","وَجاوَزَ أَقصى دَحضِها غَيرَ زالِقِ",0,"ق",1,0],["تَسَنَّمتُموها طِوالَ الذُرى","فَصَبراً عَلى بُعدِ قَهواتِها",1,"ت",3,0],["تَسَنَّمَ عَرشَ إِسماعيلَ رَحباً","فَأَنتَ لِصَولَجانِ المُلكِ أَهلُ",2,"ل",1,0],["تَسَنَّمَ مِن أَعلى المَراتِبِ رُتبَةً","تَقاصَرُ عَن أَدنى مَداها الكَواكِبُ",3,"ب",1,0],["تَسنو وَيُعجِلُ كَرَّها مُتَبَذِّلٌ","شَثنٌ بِهِ دَنَسُ الهَناءِ دَميمُ",4,"م",1,0],["تسنمي سمعي ثم اجعلي","مزاج ذكراه بتسنيم",5,"م",1,0],["تسنَّم ظهرَ مَكرُمَةٍ أنيختْ","لتركبها ولا تكُ بالهَيوبِ",6,"ب",1,0],["تَسَنّى مِنَ الأَحلاقِ ما كانَ دونَهُ","وَفَكَّ مِنَ الأَرحامِ ما كانَ مُقفَلا",7,"ل",2,0],["تَسنَّمَ أعلامَ الديارِ وأنتمُ","لِمَن حلَّ فيها غاربٌ وسَنامُ",8,"م",1,0],["تسنمَ القوم غَرْبَ الجو وانطلقوا","كأن للقوم في الأفلاك آمَالا",9,"ل",2,0],["تُسنُّ ذيولٌ للقوانين يُبتَغى","بها جَلْبُ قوم \" الكراسي \" الشواغِر",10,"ر",1,0],["تسنم متن المجد فردا بعصره","ومن بعده يا فقد نوع المماثل",11,"ل",1,0],["تَسَنَّمَ المُلكَ لَم تَبقُل عَوارِضُهُ","وَحَلَّ مِن ذِروَتَيهِ أَفضَلَ الرُتَبِ",12,"ب",1,0],["تسنم من غر المناقب ذروة","أبى شاؤها أن يستكن لضابث",13,"ث",1,0],["تسنم المجد في ذراه","وما المجد بسام بلا تسنمه",14,"م",2,0],["تَسَنَّنَ ما اقْتَضَتْهُ لَهُ الْمَعَالِي","بِمَنْصِبِهِ ومَنْسِبِهِ السَّنِيِّ",15,"ي",1,0],["تَسَنّى لَه في البَرِّ والبَحْرِ ما نَوى","سَعَادَةُ جدٍّ أخْدمَ البَرَّ والبَحْرا",16,"ر",2,0],["تَسَنَّنتُ في عِشقي لَهُ وَهوَ شيعَةٌ","لَغَيرِيَ فيما يَبتَغيهِ مُريدُ",17,"د",1,1],["تسنّمنَ بالآباء ذروةَ شامخ","من المجد والآباء بالمنزل الأسمى",18,"م",2,0],["تَسنَّمَ المجد حتى داس هامَتَهُ","فصار منتدباً بالرُّشد ملتزما",19,"م",2,0],["تسنمتم سنام المجد قدماً","فيا للّه ذلك من سنام",20,"م",1,0],["تسنّمها من كانَ من دون خفّها","وكنَّا نراه تحتها فعلاها",21,"ا",3,0],["تسنَّمها قَومٌ بغير مناكبٍ","ففي كلّ ظهرٍ جُلبةٌ وكُلومُ",22,"م",1,0],["تسنَّم أعوادَ السرير محجَّبٌ","لواحظهُ شرقاً وغرباً طوارحُ",23,"ح",1,0],["تَسنَّى مراحاً للأبيِّ كأنها","رحيقُ مُدامٍ لم يَشِبْهُ قِطابُ",24,"ب",1,0],["تَسَنَّمَتْ ذُرَى العُلى أسْرارُهُمْ","ونَصَبَتْ فوقَ البُروجِ رَفْرَفا",25,"ف",2,0],["تَسَنَّمَتْ هامَ العُلى هِمَّتُنا","لم تنفَعِ الحاسِدَ فينا الفَعْفَعَهْ",26,"ع",2,0],["تسنموا إبلاً تتلو قلائصهم","يا عزة السرج ذوقي ذلة القتب",27,"ب",1,0],["تسنّم عرش الملك راقٍ إلى العُلا","عليهِ لواء الملك بالعزّ ينصبُ",28,"ب",1,0],["تسنمنا لها أعلى سنام","يسابقنا عليه الفرقدان",29,"ن",1,0],["تسنم فارعا فرأيت موجا","كأسنمة المخرَّمةِ الهجانِ",30,"ن",1,0],["تسنم أعلى ذروة العز مجده","وألبس ثوب الفخر وهو قشيب",31,"ب",1,0],["تسنم ذروة العلياء لما","دعاه لارتقا العليا المنادي",32,"د",2,0],["تسنّموها رجال بويعوا فشروا","ما أمّلوه فتعجيل وتأجيل",33,"ل",1,0],["تسنم منتهى فتيان صدق","لهم فعل الضرغمة الضواري",34,"ر",2,0],["تسنمها فتيان صدق إذ سطو","فما الصيد في أعلى المعاقل تهجم",35,"م",1,0],["تسنم ظهر المجد والمجد بارك","لديه وثارا والسها كان مقصدا",36,"د",2,0],["تسنّم المُلْكَ وهو ذو ضلعٍ","فلم تنل حُضْرَهُ السّلاهيب",37,"ب",1,0],["تسنمت من غصون البان منظرة","تحطه الريح أحياناً وترفعه",38,"ع",2,0],["تُسند ما ترويه عن عبقةٍ","من شيبة الحمدِ انتشقناها",39,"ا",3,0],["تسنّمي عرشَ الشهامة واْخلعي","بُردَ السَّنى في هذه الأْربُع",40,"ع",1,0],["تسنيم عيني إِنسان عيني","مَكنون كوني قيوم ساقي",41,"ق",2,0],["تَسنَّم عن دِرَاستِهِ مَقَاماً","تخِرّ لبُعدِه الشِّعري العَبُورُ",42,"ر",1,0],["تسنم مجداً لا ينال ومرتقىً","ترى النسر أمسى واقعاً دون مرقاه",43,"ا",2,0],["تَسَنَّمتَهُم في ذُرى شاهِقٍ","يَزِلُّ عَلى مَتنِهِ المِسحَلُ",44,"ل",1,0],["تسنى ذُرَى العلياءِ قدماً وتالياً","إلى أن تلا من ملكها السنَد العالي",45,"ل",2,0],["تَسنمت مَتن الفَخر مُنفَرِداً بِهِ","وَخَلفك أَرباب المَفاخر تَردف",46,"ف",1,0],["تسنّموا نكبات الدهر واختلطوا","مع الخطوب اختلاط البرء بالسقم",47,"م",1,0],["تسنم مِن ظَهر المَفاخر هَضبة","لَهُ شادها المُختار وَالحَيدر الطهر",48,"ر",1,0],["تَسنمت مِن ظهر الشَريعة مَركباً","لَهُ فَوق كُل الشامِخات سَنام",49,"م",1,0],["تسنَّموا من رُبى لبنان ذِروتها","لكنَّها قِمَّةٌ للمجد تُحتَسَبُ",50,"ب",1,0],["تسنمته دون حيرانة","منَ الوجد واهية ساهيَه",51,"ي",2,0],["تسنمت عزمي شاحذاً حد فكرتي","عن الأدهم الشملال والأبيض النصل",52,"ل",1,0],["تسنم من قب المعالي مطهما","به حار من دون الورى قصب الفضل",52,"ل",1,0],["تسنم به عرش القلوب فلن ترى","سوى ملكها ملكاً بغير عناء",53,"ا",2,0],["تسنم عرش الملك فيه محمد","عزيزا فنعم العرش والمتسنم",54,"م",1,0],["تسننت أفعال النبي وقوله","فما ذا الذي من بعد ذاك أقولُ",55,"ل",1,0],["تَسَنَّمُوا عُوجَ المَناقي ليتَها","ألحمَها عُوجَ المَناقيرِ المَنَى",56,"ا",1,0],["تَسَنَّمُوا صَهَواتِ الجُرْدِ مُنْتَدِباً","يَهْتاجُ مُشْتَمِلاًَ بِالحَزْمِ مُنْتَقِبا",57,"ب",2,0],["تَسَنَّمَ الفُلكَ مِن شِطِّ المَجازِ وَقَد","نُودينَ يا خَيرَ أَفلاكِ العُلا سيري",58,"ر",2,0],["تسنّمِ المجدَ لا تقبلْ بهِ عِوَضَا","وانهضْ فإنَّ العُلا حقٌّ لمنْ نَهَضَا",59,"ض",2,1],["تسند لا تحسسني بنية بعدك وممشاك","ترى لو الهوى حرك ثيابك هدني خوفي",60,"ف",2,0],["تسنّ للعشق ألواحا مقدسة","وتحفظ العهد حبا في المزامير",61,"ر",1,0],["تَسَنَّمَ أَعْلَى صَهْوَةِ المَجْدِ فاغْتَدَى","لَهُ مَرْكَباً دُونَ الأَنامِ سَنامُهُ",62,"م",2,0],["تَسَنَّمَ أَعْلَى المَجْدِ طَوْلاً وَلَمْ يَزَلْ","لَهُ مِنْ ذُراهُ ذُرْوَةٌ وَسَنامُ",63,"م",1,0],["تَسَنَّمْتُ نورًا منْ بَريقِ نُجومِهِ","فأنَّى لِلَيْلِي دونَ بدركَ يُبْصِرُ",64,"ر",1,0],["تسنيمُها ونوالُها اْبراهيمها","معهم يطيب العيش طول حياتِها",65,"ت",3,0],["تسنمت ذروة العليا زعانفة","وقد رضيتم (بسوء الكيل والحشف)",66,"ف",1,0],["تَسَنَّمه والنَّاسُ تحمد ما بَنى","أبُوهُ.. ويَلْقى حَوْلَه الحَوْلَ والطَّوْلا!",67,"ل",2,0]]}