{"poems":[[132,"من لصب دموعه ليس ترفا","https://www.aldiwan.net/poem50563.html","الخفيف"],[505,"لله من جفن هملن دموعه","https://www.aldiwan.net/poem37965.html","الكامل"],[572,"أمسك ديف بالقهوة","https://www.aldiwan.net/poem69769.html","الهزج"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87846","الخفيف"],[2272,"","https://poetry.dctabudhabi.ae/diwan/poem/131430","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204954","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199998","المتقارب"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114153","البسيط"],[4755,"سَقَطْنَا لِأَنَّ الأَرضَ أَعلَى مِن الفَضَا","https://www.poetsgate.com/ViewPoem.aspx?id=183779",""],[5442,"ألف الصبوة واستحلى الغرما","https://www.poetsgate.com/ViewPoem.aspx?id=114748",""],[5804,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=214960",""],[5956,"الرقص بالشعر","https://www.poetsgate.com/ViewPoem.aspx?id=185632",""],[5377,"رثاء شعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79547&r=&rc=1",""]],"verses":[["وَكَئيبٍ إِذا تذكر أحبَا","باً بصنعاءَ حَن وحبذاً وشَوْقَا",0,"ق",2,0],["وكَئيبِ فكرٍ ذاهِلٍ عَبَثَ النَّوى","بشؤونِهِ وطَفَتْ عليه جُموعُهُ",1,"ع",2,0],["وكي يَمْنَحْني تَأْدِي","بَهُ المَحْضُ وَتَخْرِيجَهْ",2,"ج",2,0],["وَكَئيبٍ آهاتُهُ صَدحاتٌ","حَسِبوهُ مِن أَسعَدِ الناسِ أَسعَد",3,"د",1,0],["وكي يقال عبيد قائمون بما","القى من الأمر قبل الخلق والمحن",4,"ن",1,0],["وكي يرققه ظلم الحبيب له","حتى يناصر صباً دون أنصار",5,"ر",1,0],["وكي يدرس الطيران الخيال","ويعلم كيف تعّلمتمُ",6,"م",1,0],["وكَي يُقِرَّ بِذَاكَ كُلُّ مُستَمَِعٍ","وَلاَ طَريقَ إِلَى إِنكَارِهِم وَجَدُوا",7,"د",3,0],["وكَي يُصبِحَ التَّغييرُ صَوتًا وصُورَةً","على الأَرضِ لا جَدوَى بِإِرجاعِ مَن مَضَى",8,"ض",2,0],["وكئيب في الحمى تحسبه","ظله الناحل وجدوا سقاما",9,"م",2,0],["وكيْ يقبلَ إحساني","وكيْ يكشفَ مأساتي",10,"ت",2,0],["وكي يصبح العربان أكثر حكمة","عليهم بنهلِ العلم لو مِن أعاجمِ",11,"م",1,0],["وكي يصبح الفنانُ أكثر قدرةً","على الفنِّ أن يقْرا جميعَ التراجمِ",11,"م",1,0],["وكي يسيرَ حثيثاً صوبَ مصرعهِ","وكي يخر َّوشيكاً في مهاويهِ",12,"ي",2,0]]}