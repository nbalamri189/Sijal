{"poems":[[55,"أكذا المنون تقنطر الأبطالا","https://www.aldiwan.net/poem29888.html","الكامل"],[75,"يا دمع صب ما شئت أن تصوبا","https://www.aldiwan.net/poem11837.html","الرجز"],[32,"هل تعرف المنزل بالوحيد","https://www.aldiwan.net/poem29596.html","الرجز"],[53,"إن الدمشقي عبد حاجته","https://www.aldiwan.net/poem9260.html","المنسرح"],[53,"يا عجبا من خالد في صبره وجلده","https://www.aldiwan.net/poem9997.html","مجزوء الرجز"],[53,"لخالد زوجة يلقمها","https://www.aldiwan.net/poem63991.html","المنسرح"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[31,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[87,"احفظ لنا يا ربنا","https://www.aldiwan.net/poem7264.html","مجزوء الرجز"],[58,"على هذه كانت تدور النوائب","https://www.aldiwan.net/poem58651.html","الطويل"],[63,"أكف تغلب أنواء الحيا الجاري","https://www.aldiwan.net/poem51679.html","البسيط"],[2,"تعلم أن شر الناس حي","https://www.aldiwan.net/poem25060.html","الوافر"],[68,"لمن الشوازب كالنعام الجفل","https://www.aldiwan.net/poem41583.html","الكامل"],[99,"يا معجباً تاه على صحبه","https://www.aldiwan.net/poem24396.html","السريع"],[82,"أبكاه شيب الرأس لما ابتسم","https://www.aldiwan.net/poem31286.html","السريع"],[107,"هو الحكم أمضته السيوف القواطع","https://www.aldiwan.net/poem43054.html","الطويل"],[41,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[41,"طال في رسم مهدد أبده","https://www.aldiwan.net/poem53781.html","المنسرح"],[41,"قفا فاسألا الدمنة الماصحه","https://www.aldiwan.net/poem53809.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85444","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202527","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54588","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54239","البسيط"],[111,"مدد الحق للقلوب الصواردي","https://www.poetsgate.com/ViewPoem.aspx?id=528",""],[111,"جرد النفس وانهها عن هواها","https://www.poetsgate.com/ViewPoem.aspx?id=530",""],[58,"على هَذِهِ كانَتْ تَدورُ النَّوائِبُ","https://www.poetsgate.com/ViewPoem.aspx?id=3536",""],[102,"يوم 13 حزيران 1974م","https://www.poetsgate.com/ViewPoem.aspx?id=50461",""],[53,"إن الدمشقيَّ عبدُ حاجتِه","https://www.poetsgate.com/ViewPoem.aspx?id=27400",""],[107,"هو الحكم أمضته السيوف القواطع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55004&r=&rc=174",""],[119,"وريم روض لم ادم سواه","https://www.aldiwan.net/poem40435.html","عموديه"],[119,"أه من يوسف قلبي","https://www.aldiwan.net/poem40883.html","عموديه"],[147,"أرى سفها ولو جاء العذول","https://www.aldiwan.net/poem11804.html","الوافر"],[159,"قفوا ما عليكم من وقوف الركائب","https://www.aldiwan.net/poem55796.html","الطويل"],[164,"هنيته عيدا فصل وانحر","https://www.aldiwan.net/poem58821.html","الرجز"],[254,"إن الفؤاد بآل كبشة مدنف","https://www.aldiwan.net/poem2103.html","الكامل"],[281,"هل عند عمرة من بتات مسافر","https://www.aldiwan.net/poem2239.html","الكامل"],[355,"أقفر من سلمى يناضيبُ","https://www.aldiwan.net/poem641.html",""],[370,"يبرون عظمي وهمي جبر عظمهم","https://www.aldiwan.net/poem44534.html","البسيط"],[401,"هل بالمنازل إن كلمتها خرسُ","https://www.aldiwan.net/poem587.html",""],[412,"قد كنت نبالا بلحظك صائدا","https://www.aldiwan.net/poem50183.html","الطويل"],[438,"هو النادي وأنت به أنادي","https://www.aldiwan.net/poem12423.html","الوافر"],[463,"وجد الجميم فعافه وتبقلا","https://www.aldiwan.net/poem55960.html","الكامل"],[463,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[463,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[466,"ينيخ المسيف النضو منه بممرع","https://www.aldiwan.net/poem15487.html","الطويل"],[466,"اذا كنت جارا للفرات وهاطل","https://www.aldiwan.net/poem15587.html","الطويل"],[469,"بم يجل خط عذاره وبنانه","https://www.aldiwan.net/poem3439.html","عموديه"],[482,"كفى حزنا أني أبثك ما عندي","https://www.aldiwan.net/poem15281.html","الطويل"],[505,"قد أبصر الزمان علوى وغفا","https://www.aldiwan.net/poem37959.html","الرجز"],[505,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[545,"يبرقن فوق رواق أبيض ماجد","https://www.aldiwan.net/poem56685.html","الكامل"],[556,"عرج على الدارسة القفر","https://www.aldiwan.net/poem47777.html","الرجز"],[558,"أغرى به الشوق ليل الساهر الرمد","https://www.aldiwan.net/poem68425.html","البسيط"],[566,"قد أملت أمنية من الأمل","https://www.aldiwan.net/poem27841.html","الرجز"],[591,"أوائل حب ما لهن أواخر","https://www.aldiwan.net/poem17524.html","الطويل"],[689,"","https://poetry.dctabudhabi.ae/diwan/poem/203594","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63866","المنسرح"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199593","المسحوب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/39001","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145816","البسيط"],[1006,"","https://poetry.dctabudhabi.ae/diwan/poem/145933","الكامل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35366","البسيط"],[136,"","https://poetry.dctabudhabi.ae/diwan/poem/118523","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109025","المتقارب"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102328","الكامل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35758","المتقارب"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108842","البسيط"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95377","الرمل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71059","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48273","الخفيف"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47181","الكامل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111285","الرجز"],[2517,"","https://poetry.dctabudhabi.ae/diwan/poem/99901","الطويل"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84539","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93903","المتقارب"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87386","الكامل"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45252","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108335",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59454","الرجز"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119404","الرجز"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102743","الطويل"],[4527,"","https://poetry.dctabudhabi.ae/diwan/poem/76598","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72447","البسيط"],[4691,"بيني وبين الحزن أنسابُ !!","https://www.poetsgate.com/ViewPoem.aspx?id=57871",""],[4767,"القدح المكسور","https://www.poetsgate.com/ViewPoem.aspx?id=209028",""],[4927,"جواز السفر","https://www.poetsgate.com/ViewPoem.aspx?id=80800",""],[5277,"حواء..ولدتني شمساً..وأولدتُها قمرين","https://www.poetsgate.com/ViewPoem.aspx?id=192760",""],[5409,"يبرر المرء له كل ما","https://www.poetsgate.com/ViewPoem.aspx?id=155441",""],[3294,"ليل يجيء ونهار يذهب","https://www.poetsgate.com/ViewPoem.aspx?id=173257",""],[5480,"حكم الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=11019",""],[5732,"الله من قلب","https://www.poetsgate.com/ViewPoem.aspx?id=177901",""],[402,"عاش فاروق مصر فخر الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=35107",""],[5818,"فصام","https://www.poetsgate.com/ViewPoem.aspx?id=182820",""],[6056,"الغريق","https://www.poetsgate.com/ViewPoem.aspx?id=130377",""],[6066,"مَأْسَاتِيْ فِيْ جُوَانْتَانَامُو","https://www.poetsgate.com/ViewPoem.aspx?id=12669",""],[6069,"ومن الحبائب في الركائب هاتكٌ","https://www.poetsgate.com/ViewPoem.aspx?id=105718",""]],"verses":[["يَبرينَ عودَ النَبعِ غَيرَ فَوارِقٍ","بَينَ النَباتِ كَما بَرَينَ الضالا",0,"ل",2,0],["يُبرِدُ حَرَّ الكَبِدِ المَشبوبا","يا مُتبِعاً إِسادَهُ التَأويبا",1,"ب",2,0],["يَبري لِقَبّاءِ الحَشا قَيدودِ","تَقولُ بِنتي إِذ رَأَت وَعيدي",2,"د",2,0],["يُبرِم إخوانَه بزوجتِهِ","في كلِّ يومٍ وبادِّلاجتِهِ",3,"ت",2,0],["يُبْرِكُها في بَيْتِهِ","على حشايا مُهُدِهْ",4,"د",2,0],["يُبركها الشيخ ثم يقبض بال","خمس على كل مُحصَد المِرَرِ",5,"ر",1,0],["يُبرُّ فنستكينُ وغيرُ نكرٍ","إذا شُبَّ الجلادُ خبا اللِّطامُ",6,"م",1,0],["يُبرِقنَ لِلقَومِ حَتّى يَختَبِلنَهُمُ","وَرَأيُهُنَّ ضَعيفٌ حينَ يُختَبَرُ",7,"ر",1,0],["يبرد بإذنك كالجليد","الصيف ضيعت اللبن",8,"ن",1,0],["يُبَرِّدُ نِيرانَ المَصَائِبِ أَنّني","أَرى زَمَناً لَمْ تَبْقَ فيهِ مَصَائِبُ",9,"ب",1,0],["يَبُرُّ مِنكم شبَاباً ما لَهم حزَنٌ","على الصِّبا وشيوخاً غيرَ أبرارِ",10,"ر",1,0],["يُبَربِرُ حينَ يَعدو مِن بَعيدٍ","إِلَيها وَهوَ قَبقابٌ قُطارُ",11,"ر",1,0],["يَبرُزنَ في حُلَلِ العَجاجِ عَوابِساً","يَحمِلنَ كُلَّ مُدَرَّعٍ وَمُسَربَلِ",12,"ل",1,0],["يبرطع البرغوثُ في ساحها","ويشردُ المسكينُ لا يرسي",13,"س",2,0],["يُبْرِدُ حرّ الشوْق ترشافُهُ","عنكَ بمعسولِ الثنايا شَبم",14,"م",1,0],["يُبرِّحُ بالقُوّادِ والجندِ منهمُ","أعاجيبُ شتَّى في الوغَى وبَدائعُ",15,"ع",1,0],["يَبري اللِحاءَ عَنِ العَميمِ وَشاحِذاً","يَجلو الضُبا وَيَسُنُّ كُلَّ غِرارِ",16,"ر",1,0],["يَبرُقُ في دَفِّها سَلائِقُها","مِن بَينِ فَذٍّ وَتَوءَمٍ جُدَدُه",17,"د",2,0],["يُبَربِرُ بَربَرَةَ الهِبرِقِي","بِأُخرى خَواذِلِها الآنِحَه",18,"ح",2,0],["يبرّحني أن الصروح تقوضت","وَيُحزنني أَنَّ القصور طلول",19,"ل",1,0],["يبرزها غداً من الخباء","إن غدا يأتيك بالأنباء",20,"ا",2,0],["يَبْرُزُ المُولَعُونَ بِالفَنِّ فِيهَا","طُرُفاً مِنْ مَوَاهِبِ الوَهَّابِ",21,"ب",1,0],["يبرُزْنَ في اللَّيْل مِثْلَ الشُّهْبِ ساطِعةً","ما بَيْنَ سيَّارَةٍ تَجْرِي لِسَيّار",22,"ر",1,0],["يبرق الحق من مصادره العل","يا وينهل حكمة للعباد",23,"د",1,0],["يبرق الحق من مصادره العل","يا وينهل العلم من مجلاها",24,"ا",3,0],["يُبَرِّدُ نِيرانَ المَصائبِ أَنَّني","أرى زمناً لمْ فيهِ مصائبُ",25,"ب",1,0],["يبرعم الشّوق الحصى تحته","والشمس في أجفانه هاتفه",26,"ف",2,0],["يُبرِم إخوانَه بزوجتِه","في كحل يومٍ وبإدلاجتهِ",27,"ت",2,0],["يبرح بالقواد والجند منهمو","أعاجيب شتى في الوغى وبدائع",28,"ع",1,0],["يبرأ سقمي ريقه وعنوه","كم جرحت مهيجتي عيناه",29,"ا",2,0],["يبرز الهجر دلالا","كفعال المتكلف",30,"ف",1,0],["يُبَرقِعُها القَنا في كُلِّ حَربٍ","نَجيعاً ما لَها مِنهُ شَليلُ",31,"ل",1,0],["يبرّحُ بي وَجدي إذا لاحَ كوكبٌ","كَأَنَّ به وَجداً ببعضِ الكواكبِ",32,"ب",1,0],["يبركُ كلٌ كالبعيرِ عندَه","ويلثم الأرض بخدٍ أصغرِ",33,"ر",1,0],["يَبري لَها خَرِبُ المُشاشِ مُصَلِّمٌ","صَعلٌ هِبَلٌّ ذو مَناسِفَ أَسقَفُ",34,"ف",1,0],["يَبري لِرائِحَةٍ يُساقِطُ ريشَها","مَرُّ النَجاءِ سِقاطَ ليفِ الآبِرِ",35,"ر",1,0],["يَبري لَها مُستَعمَلٌ لاحِبٌ","موطّأُ المَتنَينِ مَركوبُ",36,"ب",1,0],["يَبرونَ عَظمي وَهَمِّي جَبرُ عَظمِهِمُ","شَتَّانَ ما بَينَنا في كلِّ سَبَبِ",37,"ب",1,1],["يَبري عروقاً ويُبدي عن أسافِلها","كما تليّن للخَرانة الشرسُ",38,"س",1,0],["يُبَرِّزُ وَرد الخَدِّ ثمَّ يُعيدُهُ","وَلَم أَرَ وَرداً في الكَمائِمِ عائِدا",39,"د",2,0],["يبرز في اطِّلاع واضطلاع","وتبرز في اتِّقاد وانتقادِ",40,"د",1,0],["يَبري لهم ويَريشُ من آرائه","سهماً إذا علِق الرميّةَ أشكلا",41,"ل",2,0],["يُبرم ما يفتِل بال","حزم ويفرِي ما خَلَقْ",42,"ق",1,0],["يُبرزه النفاقُ لي في حُلَّةٍ","حبيرةٍ من تحتها جِلدُ نَمِرْ",43,"ر",1,0],["يُبِرُّ على الطَّوْد المُنيف رزانةً","وفي العزم غلاَبٌ شِفار البواترِ",44,"ر",1,0],["يُبِرُّ على الهوجاء عزماً وراجحٌ","على ركن رضْوى حلمُه ويلَمْلم",45,"م",1,0],["يبري اليراعَ بأنملٍ موموقةٍ","خصَّت فؤاد المستهام بقطّهِ",46,"ط",2,0],["يُبَرِّدُ بالائآرِ لذعَ غليلِهِ","وجاحمُ نارِ الشوقِ في ذلكَ البَرْدِ",47,"د",1,0],["يُبْرِزُ رَبُّ الجَهلِ من ضَميرِهِ","لِكلِّ ما يَراهُ ممَّا اغْتَرَفَا",48,"ف",2,0],["يُبْرِزُ في طريقِهِ","للعارِفينَ عَجَبَا",49,"ب",2,0],["يَبرُقنَ فَوقَ رَواقِ أَبيَضَ ماجِدِ","يُرعى لِيَومِ نُفورَةٍ وَمَعاقِلِ",50,"ل",1,1],["يَبْرِي لِحا صَعْدَتِهِ عامداً","بَرْيَ العَصا من كان لا يبري",51,"ر",2,0],["يَبِرُّ بِالجودِ يَحميهِ وَيَكلَؤُهُ","كَأَنَّهُ والِدٌ يَحنو عَلى وَلَدِ",52,"د",1,0],["يُبري لَهُ مِن كُلِّ صَمدٍ وَجَرَل","مَجرٌ يُباري مُسلَحِبّاً ذا زَجَل",53,"ل",1,0],["يُبرّدُ قلبي خَدُّه وهُوَ جَمْرَةٌ","ويَحْرِقُ قَلْبي طَرْفُهُ وهُوَ فَاتِرُ",54,"ر",1,0],["يبريني النجدي من ألم النوى","وتذيبني وجداً ظبا يبرين",55,"ن",1,0],["يبرزُ وجهاً يروعُ منظرُه","نواظرَ الخلقِ حينَ يُبْرِزُه",56,"ز",2,0],["يبري حشيد أرضافي","وهايوسٍ مرتضم",57,"م",1,0],["يَبري رِقابهمُ مَسحاً بعاضبهِ","كَأَنّهُ قَد بَرى في عَضبهِ قَلَما",58,"م",2,0],["يُبَرِّرونَ لهَا إيْغالهَا صَلَفاً