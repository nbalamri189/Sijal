{"poems":[[95,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[95,"أدعو القريض فيعصي بعد طاعته","https://www.aldiwan.net/poem11272.html","البسيط"],[23,"آليت حلفة بر غير ذي دخل","https://www.aldiwan.net/poem21398.html","البسيط"],[93,"ما وعظ الإنسان مثل الحمام","https://www.aldiwan.net/poem62748.html","عموديه"],[87,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[51,"ما أنا إلا لمن بغاني","https://www.aldiwan.net/poem63146.html","مجزوء البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[112,"ماني نبي","https://www.poetsgate.com/ViewPoem.aspx?id=36760",""],[93,"أفاتحة أم ختام","https://www.poetsgate.com/ViewPoem.aspx?id=53303",""],[111,"ماذا تريد من الدنيا تعنيها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66822&r=&rc=1",""],[147,"هل العدل إلا دون ما أنت مظهر","https://www.aldiwan.net/poem11762.html","الطويل"],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[215,"يا قلب هذا نعيم","https://www.aldiwan.net/poem46564.html","المجتث"],[309,"مرت لنا بالحمى المأنوس أعياد","https://www.aldiwan.net/poem16841.html","البسيط"],[371,"قالوا الأحبة ما صدوا ولا وصلوا","https://www.aldiwan.net/poem17075.html","البسيط"],[406,"بين الريح والإعصار","https://www.aldiwan.net/poem10311.html","عموديه"],[422,"نبهت الورقاء ذات الجناح","https://www.aldiwan.net/poem54157.html","الطويل"],[445,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[463,"نأت والأمانِي بها تقرب","https://www.aldiwan.net/poem56282.html","المتقارب"],[463,"سلا دار البخيلة بالجناب","https://www.aldiwan.net/poem56296.html","الوافر"],[473,"من الذكر ما لا فخر في لبس مثله","https://www.aldiwan.net/poem60020.html","الطويل"],[484,"الحقائق هبها اليوم تمثيلا","https://www.aldiwan.net/poem36953.html","البسيط"],[543,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2408","المنسرح"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122774","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122817","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66713","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34411","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38192","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59526","البسيط"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105467","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136362","الطويل"],[1281,"","https://poetry.dctabudhabi.ae/diwan/poem/77441","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64569","الطويل"],[1443,"","https://poetry.dctabudhabi.ae/diwan/poem/97631","البسيط"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115966","الرجز"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35735","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101032","البسيط"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114805","البسيط"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102103","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27507","السريع"],[2691,"","https://poetry.dctabudhabi.ae/diwan/poem/178001","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132673","السريع"],[3456,"","https://poetry.dctabudhabi.ae/diwan/poem/206007","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135928","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103037","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[4109,"","https://poetry.dctabudhabi.ae/diwan/poem/97555","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90851","البسيط"],[4692,"لغز شعري","https://www.poetsgate.com/ViewPoem.aspx?id=212347",""],[4935,"إلهي فرج الكربا","https://www.poetsgate.com/ViewPoem.aspx?id=129287",""],[5127,"وقفتْ ومدمعُها على اﻷجفانِ","https://www.poetsgate.com/ViewPoem.aspx?id=177316",""],[5145,"آه لبرقٍ ومضا","https://www.poetsgate.com/ViewPoem.aspx?id=108066",""],[592,"لك الحمد اللهم يا واسع المجد","https://www.poetsgate.com/ViewPoem.aspx?id=128838",""],[5732,"انادم اللي رفقته ترفع الراس","https://www.poetsgate.com/ViewPoem.aspx?id=177830",""],[5956,"أيها البحر العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=183229",""],[6102,"حَماقَة !!","https://www.poetsgate.com/ViewPoem.aspx?id=183657",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""]],"verses":[["من الذي أوجد هذا الوجود","ومن له دون سواه السجود",0,"د",1,0],["من الذي تحيون في ظله","وتغنمون السعد في فضله",0,"ه",1,0],["مَنِ الَّذِي إِنْ دَعَاهُ المُسْتَجِيرُ بِهِ","أَجَارَهُ غَيْرَ هَيَّابٍ وَلا وَانِي",1,"ن",2,0],["مَنِ الَّذِي يَنْصُرُ المَظْلُومَ لا صِلَةٌ","لَهُ بِهِ بَلْ يُلَبِّي مَحْضَ إِحْسَانِ",1,"ن",1,0],["مَنِ الَّذِي يَرحَمُ المُسْتَضْعَفَاتِ إِذَا","عَدَا عَلَيْهِنَّ عَادٍ أَوْ جَنَى جَانِ",1,"ن",1,0],["مَنِ الَّذِي إِنْ غَفَتْ عَنْ حَقِّهَا أُمَمٌ","لَمْ يَطْعَمِ الْغَمْضَ عَنْ حَقٍّ لأَوْطَانِ",1,"ن",1,0],["مَنِ الَّذِي تَعْرِفُ الْعَلْيَاءُ شِيمَتُهُ","إِذَا تَنَافَسَ فِيهَا غُرُّ فِتْيَانِ",1,"ن",1,0],["مَنِ الَّذِي هُوَ فِي آمَالِ أُمَّتِهِ","طَلِيعَةُ المَجْدِ لِلْمُسْتَقْبلِ الدَّانِي",1,"ن",2,0],["مِنَ الَّذي كانَ نوراً يُستَضاءُ بِهِ","مَبارَكَ الأَمرِ ذا حَزمٍ وَإِرشادِ",2,"د",1,0],["مَنِ الَّذي يُطفِئُ مِن بُعدِهِ","في المُهَجِ الحَرّى ذَكِيَّ الضِرام",3,"م",1,0],["مَنِ الَّذي يَمسَحُ دَمعَ الأَسى","وَماسِحُ الأَدمُعِ تَحتَ الرُغام",3,"م",1,0],["مَنِ الَّذينَ إِذا سارَت كَتائِبُهُم","تَصَرَّفوا بِحُدودِ الأَرضِ وَالتُخَمِ",4,"م",1,0],["مَنِ الَّذي يَرتَجي الأَقاصي","إِن لَم يَنَل خَيرَهُ الأَداني",5,"ن",2,0],["مِنَ الذِّكْرِ وَالتَّارِيخِ فِيهَا ضَوَابِطٌ","وَفِيهَا مِنَ الخُبْرِ الحَدِيثِ أَوَابِدُ",6,"د",1,0],["من الذكاء؟ أنّك تسويّ نفسك أحيانن غبي","بس الغباء؟ أنّك تذيكالك على ناس أذكيا",7,"ي",2,0],["من الذي يطفىء من بعده","في المهج الحرّى ذكي الضرام؟",8,"م",1,0],["من الذي لم ترعه من طوارقها","وأي نفس من البلوى تفاديها",9,"ي",3,0],["مِنَ الذَمِّ مَعصومٌ كَأَنَّ مَغيبَهُ","وَلَو جُمِعَت فيهِ أَعاديهِ مَحضَرُ",10,"ر",1,0],["من الذل حتى يحسبوا كل صيحة","عليهم فتلقى المرء في الأمن يرغب",11,"ب",1,0],["من الذي طاف منكم","ليلاً بتلك المناسك",12,"ك",1,0],["من الذين بعلم اللَه قد عملوا","واستغرفتهم عبادات وأوراد",13,"د",1,0],["مَنِ الَّذي مِنهُما مِن قَبلِ صاحِبِهِ","أَم لَم يَكُن بَينَ وَجدانَيهِما مَهَلُ",14,"ل",1,0],["من الذي صاغ في الميدان ملحمةً","من الشباب شَدَتْ نثراً وأشعارا؟",15,"ر",2,0],["من الذي صاغها حتى غدت لغةً","على الشّفاه وفي الأذهانِ أفكارا؟",15,"ر",2,0],["من الذي سيَّر الجيشَ الكبيرَ ومنْ","أجراهُ في ساحة التَّحريرِ أنْهارا؟",15,"ر",2,0],["من الذين افتخرت فيهم","بيض ظبا الهند وسمر الرماح",16,"ح",1,0],["مِنَ الَّذِينَ وَفتْ للهِ بَيْعَتُهُمْ","فأَخلصوا العهدَ إِيماناً وأَيمانا",17,"ن",2,0],["من الذاهباتِ بحَبّ القلو","بِ لا تُقتَضَى رَدَّ ما تَّسلُبُ",18,"ب",1,0],["من الذهب الصريح فصار ممّا","يُبَدَّلُ في يديه إلى الذَّهابِ",19,"ب",1,0],["مِنَ الذِكرِ ما لا فَخرَ في لُبسِ مِثلِهِ","وَمِنهُ الَّذي في لِبسِهِ غايَةُ الفَخرِ",20,"ر",1,1],["من الذين على منوالهم نسجوا","ما أهلتنا ظروف الحال تأهيلا",21,"ل",2,0],["مَنِ الَّذِي يُرسِلُهَا","إليه مِن إِخوَانِي",22,"ي",1,0],["من الذين عقدوا الأمر الأول","بعد الذين قتلوا فيمن قتل",23,"ل",1,0],["مَنِ الَّذي بَعدَهُ يَعِزُّ بِهِ","ضامِنُ حاجاتِنا وَمِن عَدَمِ",24,"م",1,0],["مِن آل ذَروَةَ داعِمي ُقُفَ العُلا","مِنهُم بِأركانٍ لَها وَدَعاِمِ",25,"م",1,0],["مِن آلِ ذَروَةَ فارِجي كُرَبض الوَغَى","بِالبارِقاتِ وَكاشفي غَمّاها",26,"ا",3,0],["مَن الذي قال منهم وهو أحدثهم","سنّاً وخيرُهم في الذكر إذ سَطَروا",27,"ر",3,0],["مِن آل ذي النورَينِ لا","حَ ضِياؤُهُ فهدى وتمّا",28,"م",2,0],["مِنَ الذّهَبِ الإِبريزِ وَاللّؤلؤِ الرّطبِ","عَلى حُسنِ تَأليفٍ بَديعٍ مشيّد",29,"د",1,0],["مَن الذي يَصفُ الأملاكَ قاطبةً","ولا يَرى حقنا الحقَّ الذي يجبُ",30,"ب",1,0],["من الذي كشف الغماء داهمةً","عن العراق ومن جلى لها سدفا",31,"ف",2,0],["من الذل والظن الجميل بوصفك ال","جميل الذي أوليتنا بره صفوى",32,"و",2,0],["مِن الذُروَة العَلياءِ مِن آل هاشمٍ","وَآلِ هِشام ما أَجلَّ وَأَمجَدا",33,"د",2,0],["من الذنب واستعصت على الوسائل","فإني ملح بالدعا لا أزائل",34,"ل",1,0],["مِنَ الّذينَ مَتى ما تغشَ ناديَهم","تَلقَ الخَضارمة الشمّ العرانينِ",35,"ن",1,0],["مَن الذى أفتاك أن تقتُلَ بِال","هَجرِ أسيراً فى هواك مُوثَقا",36,"ق",2,0],["مِنَ الذَهَبِ الإِبريزِ صيغَ وَإِنَّما","مِنَ الطينَةِ البَيضاءِ يُستَخلَصُ التِبرُ",37,"ر",1,0],["من الذين إذا قالوا مقالتهم","فالدهر ماضٍ بما قالوه فعال",38,"ل",1,0],["من الذين هم آوَوا وهُم نَصَرُوا","من غَيَّةِ الدِّين لا من جذوةِ الفِتَن",39,"ن",1,0],["من الذنب والزلات جدي اقيلني","وفي النفس امرا قضينه معينني",40,"ي",1,0],["من الذي أجلى إليك الذي","أصعقَ منك الروحَ قبلَ الجسد",41,"د",1,0],["من الذي بعدكم أرضى به بدلاً","أو من أحدث حاجاتي وأسراري؟",42,"ر",2,0],["من الذي اسس في ظلمهم","وقتلهم هذا البناء الوثيق",43,"ق",1,0],["مِن الذّهب الإبريز والفضة التي","تروقُ وتُصْبِي ذا القَناعة والزُّهد",44,"د",1,0],["من الذي استكفى بك اللهمَّ لمْ","يُكفَ من الذي أهمّ إذ أهمْ",45,"م",1,1],["من الذكر الخلود له عماد","تشين بحسنها ذات العماد",46,"د",1,0],["منَ الذَّهَبِ الإِبرِ يزِدا التُّرسُ كُلُّهُ","وَشُهرَتُهُ حَتَّى السَّماءِ تُجِلُّهُ",47,"ه",1,0],["مَنِ الّذي هام في جنان","لا نور فيه ولا زهر",48,"ر",1,0],["من الذين إله العرش طهرهم","ليذهب الرجس عنهم إيما ذهبوا",49,"ب",3,0],["مِن (آل ذرْحٍ) ترى عَهْدَ الشَّموخِ بِهِ","يَطاولُ الشمسَ لا ماءٌ ولا كلأُ",50,"ا",1,0],["من الذكر الحكيم إني","بفاتحة جات كربا",51,"ب",2,0],["مَن الذي سلبَ الكرى عن جفنِكِ","أوما علمتِ بمسلكِ القمرانِ؟!",52,"ن",1,0],["من الذي أشكو إذا","صار الطبيب ممرضا",53,"ض",2,0],["من الذعر والإرعاب ما قد أخافهم","وصيرهم كيما يفرون من بعد",54,"د",1,0],["من الذهب لو هو خزن طرم الاكياس","جن من كريم وحرم منها اليتيمي",55,"م",2,0],["من الذعر أشعر أنك طاغٍ","وفي دم بعض الملا غارقُ",56,"ق",1,0],["مَنِ الذِي لَم يَقَعْ فِي ما حَفَرتِ لَهُ؟","وَمَن إِذا ما اختَبَرتِ الصَّبرَ فِيهِ صَمَدْ؟",57,"د",1,0],["من الذبيحين إسماعيل قبل وعب","دُ الله كانا هما قربان مقترب",58,"ب",1,0]]}