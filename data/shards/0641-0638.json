id=4907",""],[38,"يا أهلِ ما بالُ هذا اللّيلِ في صفرِ","https://www.poetsgate.com/ViewPoem.aspx?id=21195",""],[51,"شجوُ قلبي من سائر الخلق شاجي","https://www.poetsgate.com/ViewPoem.aspx?id=27411",""],[31,"راعَ الفؤادَ تفرقُ الأحبابِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18758&r=&rc=21",""]],"verses":[["فُظَعُ البِلادِ وَراءَ قاضِيَةِ العُلى","مُتَغَرِّباً عَن مَوطِني وَمَراحي",0,"ي",1,0],["فَظَلَّ يُعِيرُنِي دَمعاً لِقاحاً","تَلَقَّى صَوبَهُ وَجهٌ حَبِيُّ",1,"ي",1,0],["فَظَلَّتْ بيَومٍ دَعْ عَدوِّي بِمِثلِهِ","طَويلٍ عَلى مَن ضُمِّنَ اللَّحدَ غائِبُهْ",2,"ب",2,0],["فَظَلَّ تَالِدَةً فينا وَطارِفَةً","عُلاً تَرِفُّ حَواشيها عَلى الحَسَدِ",3,"د",1,0],["فَظَهْرِي بِأَعْباءِ الخَصاصَةِ مُثْقَلٌ","وَبَطْنِيَ مِنْ زادِ اللِّئامِ خَميصُ",4,"ص",1,0],["فَظَلَّ مُرْتَعِدَ العِرْنينِ مِنْ غَضَبٍ","وَسَوْرَةُ التِّيهِ في عِطْفَيّ تَرْتَكِضُ",5,"ض",1,0],["فَظَلَّ يُريني الخَطْبَ كَيْفَ اعْتداؤهُ","وَبِتُّ أُرِيهِ الصَّبْرَ كَيْفَ يَكونُ",6,"ن",1,0],["فظلّ للرّكْبِ والحِرْباءُ مُنتَصِبٌ","بَيْتٌ على مَفْرِقِ العَيّوقِ رافِعُهُ",7,"ع",2,0],["فظلَّ يمرُّ السّخْلُ بالذِّئب آمِناً","ولا ترهَبُ الأُسْدَ الظِّباءُ الكَوانِسُ",8,"س",1,0],["فظَلْنا بيَوْمٍ قصّرَ اللّهْوُ طُولَهُ","نَشاوَى ولم نَحْفِلْ عِتابَ المؤَنِّبِ",9,"ب",1,0],["فَظَلنا نَكُرُّ المَشرَفِيَّةَ فيهِمُ","وَخُرصانَ لَدنِ السَمهَرِيِّ المُثَقَّفِ",10,"ف",1,0],["فَظَلَّ يُناجيني الكِتابُ كَأَنَّما","تُحَرِّكُ لي حَرفَ الكِتابِ أَصابِعُه",11,"ع",2,0],["فَظَلَّت تُناجيني بِما في ضَميرِها","أَنامِلُ قَد خَطَّت بِأَقلامِها سِحرا",12,"ر",2,0],["فظاهَرْتُ منْ سرْدِ السّقامِ بلأمَةٍ","وأوْجَفْتُ منْ شُقْرِ الدّموعِ بأفْراسِ",13,"س",1,0],["فَظَلَّت بِأَوصالِها قِدرُها","تَحُشُّ الوَليدَةَ أَو تَشتَويها",14,"ي",3,0],["فَظَلَّ يَخدَعُها عَن نَفسِ واحِدِها","في أَرضِ فَيءٍ بِفِعلٍ مِثلُهُ خَدَعا",15,"ع",2,0],["فَظَلَّ يَأكُلُ مِنها وَهيَ راتِعَةٌ","حَدَّ النَهارِ تُراعي ثيرَةً رُتُعا",15,"ع",2,0],["فَظَلِلتُ أَرعاها وَظَلَّ يَحوطُها","حَتّى دَنَوتُ إِذا الظَلامُ دَنا لَها",16,"ل",3,0],["فَظَلَّ عَلَيهِ يَرشَحُ عارِضاهُ","يَحُدُّ الشَفرَتَينِ فَما أَلانا",17,"ن",2,0],["فَظَهيرُهُ عِندَ النِضالِ وَرُكنُهُ","أَمسى حَديثَ جَنادِلٍ وَتُرابِ",18,"ب",1,0],["فَظَلَّ يَبكي عَلَيهِ حينَ أَبصَرَهُ","يَزولُ ضَعفاً وَيَقضي نَحبَهُ سَغَبا",19,"ب",2,0],["فَظَنَّ حُسّادُهُ مُعاندَةً","أَمراً وَظَنُّ الحَسودِ لا يُزري",20,"ي",1,0],["فَظَلَّ يُراعيها بِعَينٍ ضَعيفَةٍ","وَيُنشِدُها وَالدَمعُ في الخَدِّ مُنهَلُّ",21,"ل",1,0],["فَظَلَّ العَذارى يَرتَمينَ بِلَحمِه","وَشَحمٍ كَهُدّابِ الدِمَقسِ المُفَتَّلِ",22,"ل",1,0],["فَظِلتُ وَظَلَّ الجَونُ عِندي بِلَبدِهِ","كَأَنّي أُعَدّي عَن جَناحٍ مَهيضِ",23,"ض",1,0],["فَظَلِلتُ في دِمَنِ الدِيارِ كَأَنَّني","نَشوانُ باكِرَةٌ صَبوحُ مُدامِ",24,"م",1,0],["فَظَلَّ يُرَنِّحُ في غَيطَلٍ","كَما يَستَديرُ الحِمارُ النَعِر",25,"ر",1,0],["فَظَلَّ كَمِثلِ الخَشفِ يَرفَعُ رَأسَهُ","وَسائِرُهُ مِثلُ التُرابِ المُدَقَّقِ",26,"ق",1,0],["فَظَلتَ بها تُغضي عَلى حَدّ عَبرَةٍ","كَأَنَّكَ مِن تَجريبِكَ الدَهرَ جاهِلُ",27,"ل",1,0],["فَظَلَّت بِأَكنافِ الغُراباتِ تَبتَغي","مِظَنَّتها وَاِستَمَرَأت كُلَّ مُرتَدِ",28,"د",1,0],["فَظَلَّت تَكوسُ عَلى أَكرُعٍ","ثَلاثٍ وَكانَ لَها أَربَعُ",29,"ع",1,0],["فَظَلتُ لَها أَبكي بِدَمعِ حَزينَةٍ","وَقَلبِيَ مِمّا ذَكَّرَتني مُوَجَّعُ",30,"ع",1,0],["فظلت في الزهر أبغي","تلك التي لا تشابه",31,"ب",2,0],["فَظَلْتَ فِي رَوْضِهَا مُسْتَطْلِعاً لَبِقاً","حَتَّى ظَفِرْتَ بِأَذْكَاهَا وَأَبْهَاهَا",32,"ا",3,0],["فَظَنَنْتُهَا مِمَّا يَخُصُّ بِهِ","الكِبَارُ مِن الرِّجَالِ",33,"ل",1,0],["فَظَلِلتُ أَطلُبُ وَصلَها بِتَذَلُّلٍ","وَالشَيبُ يَغمِزُها بِأَلّا تَفعَلي",34,"ي",1,0],["فَظَلَّت جِيادي عَلى بابِهِ","تَروثُ وَتَأكُلُ أَرواثَها",35,"ث",3,0],["فَظَلِلتُ مَعمُوداً وبِتُّ مُسَهَّداً","وَدُموعُ عَيني في الرِّدَاءِ غَواشي",36,"ي",1,0],["فَظَلَّت تَفالى حَولَ جَأبٍ كَأَنَّهُ","رَبيئَةُ أَثآرٍ عِظامٍ ذُحولُها",37,"ل",3,0],["فَظَلّوا وَمِنهُم دَمعُهُ غالِبٌ لَهُ","وَآخَرُ يَثني عَبرَةَ العَينِ بِالهَملِ",38,"ل",1,0],["فَظَنّي بِمَيٍّ إِنَّ مَيّا بَخيلَةٌ","مَطولٌ وَإِن كانَت كَثيراً عُروضُها",39,"ض",3,0],["فَظَلَّت بِمَلقى واحِفٍ جَرَعَ المِعا","قِياماً يُفالي مُصلَخِمّاً أَميرُها",40,"ر",3,0],["فَظَلَّ بِعَيني قانِصٍ كان قَصَّهُ","مِنَ المُغتَدى حَتّى رَأى غَيرَ ذاعِرِ",41,"ر",1,0],["فَظَلَّت بِأَجمادِ الزُجاجِ سَواخِطاً","صِياماً تُغَنِّي تَحتَهُنَّ الصَفائِحُ",42,"ح",1,0],["فَظَلَّ يُصاديها فَظَلَّت كَأَنَّها","عَلى هامِها سِربٌ مِنَ الطَيرِ لُوَّحُ",43,"ح",1,0],["فظلُّك فوقي حيثما كنتُ وَارِفٌ","وموردُ آمالي لديك نميرُ",44,"ر",1,0],["فظلّ يرنو مستديم النظر","رنوّ ظمآنٍ إلى منهل",45,"ل",1,0],["فظلّ حاسدك المغبون منطوياً","على فؤاد بنار الجهل محترق",46,"ق",1,0],["فظلّ يرسُف في النيران مُرتبكاً","مستفرغاً كل جهد من متانته",47,"ت",2,0],["فظلَت بأدمعها والنحيب","تنوح على نجمها والهلال",48,"ل",1,0],["فظلّت وهي باكية تنادي","بصوت منه ترتجف القلوب",49,"ب",1,0],["فظلّ يرسف في مسعاه مرتطماً","فيما يكيدون حتى خالط التلفا",50,"ف",2,0],["فظل كئيب النفس ينظر للغنى","بعين مُقِلٍّ كان قس عيشة المثري",51,"ر",2,0],["فَظَلَّ القَينُ بَعدَ بِكاحِ لَيلى","يُطيرُ عَلى سِبالِكُمُ الشَرارا",52,"ر",2,0],["فَظَلَّ عُفاتي مُكرَمينَ وَطابِخي","فَريقانِ مِنهُم بَينَ شاوٍ وَقادِرِ",53,"ر",1,0],["فَظَلِلتُ بَعدَ وَفاتِهِ مُتَلَدِّداً","يا لَيتَني أُسقيتُ سَمَّ الأَسوَدِ",54,"د",1,0],["فَظَلَّ يَلحَظُني سِرّي لِأَلحَظَهُ","وَالحَقُّ يَلحَظُني أَن لا أُخَلّيهِ",55,"ي",2,0],["فظلَّ في المهرجان عيدٌ","يجمعُ ديناً له ودُنيا",56,"ا",1,0],["فظبيٌ له سِحرانِ طَرفٌ ونَغمةٌ","يُجدُّ بك الإغرامَ حين تعابثُهْ",57,"ث",2,0],["فظللنا في نزهتين وفي حُسْ","نَينِ بين الأرمال والأهزاجِ",58,"ج",1,0],["فظيعة فالحلقُ في سَكْتةٍ","وبطنها القَرْقار في رَجَّهْ",59,"ج",2,0],["فَظَلَّ ولمْ تَقْتُلْهُ يَلْفِظُ نَفْسَهُ","وظلَّ ولم تأْسِرْهُ وهْوَ مُقَيَّدُ",60,"د",1,0],["فظللت في خلع تفاوتَ نَجْرُها","خافٍ تلاحظه العقول وبادِ",61,"د",1,0],["فظل يناغيك الكلام بمنطقٍ","رقيق الحواشي زانه بافتراره",62,"ر",2,0],["فظلت تَلَقَّى طلَّ مُرفَضِّ دمعِها","مَلاطمُ وردٍ عن محاجرِ نرجسِ",63,"س",1,1],["فظل صحابي ناعمين ببؤسها","وظلت على حوض المنية شُرَّعا",64,"ع",2,0],["فظٌّ نُميط الأذى عنه فيُتعسنا","وليس في السيفِ عفوٌ عن صياقلِهِ",65,"ل",2,0],["فظلم الليالي أنهن أشبْنني","لعشرين يح