حتّى متى","https://www.poetsgate.com/ViewPoem.aspx?id=184532",""],[5038,"عناقيد الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=190094",""],[5136,"أعاتبه وهو المليك المكرم","https://www.poetsgate.com/ViewPoem.aspx?id=121663",""],[5277,"جوع الغوالي","https://www.poetsgate.com/ViewPoem.aspx?id=185301",""],[5277,"عهدٌ... إلى عهدٍ التميميِّ تلكَ الَّتي كشفتْ بصفعتِها عِوارَنا...","https://www.poetsgate.com/ViewPoem.aspx?id=194810",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[5332,"أسود الشام","https://www.poetsgate.com/ViewPoem.aspx?id=181590",""],[592,"أرى طالع الأدبار والنحس قد بدا","https://www.poetsgate.com/ViewPoem.aspx?id=128843",""],[5351,"هنا صنعاء هنا صعدة","https://www.poetsgate.com/ViewPoem.aspx?id=202119",""],[5390,"كَبِيرٌ بعَيْنَيَّاسْمُكَ يَا وَطنِي","https://www.poetsgate.com/ViewPoem.aspx?id=215720",""],[5409,"يا لها من فلتةٍ مبكيةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155299",""],[5409,"ظننت التجارب قد تنفع","https://www.poetsgate.com/ViewPoem.aspx?id=155289",""],[5431,"لأرض السودان الحبيبة....","https://www.poetsgate.com/ViewPoem.aspx?id=216015",""],[5582,"سَرَتْ مِنْ بَرْزَخٍ ناءٍ بَعِيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=63484",""],[5689,"حطمت لي يد القضا كل فلس","https://www.poetsgate.com/ViewPoem.aspx?id=143434",""],[5691,"طغى الجوْر","https://www.poetsgate.com/ViewPoem.aspx?id=206098",""],[5818,"طغى الشرّ","https://www.poetsgate.com/ViewPoem.aspx?id=197067",""],[5866,"نحمد الله","https://www.poetsgate.com/ViewPoem.aspx?id=182813",""],[5931,"نديم الهمس وشعوره !!","https://www.poetsgate.com/ViewPoem.aspx?id=174779",""],[5943,"للجهل قد نُسِبوا","https://www.poetsgate.com/ViewPoem.aspx?id=34726",""],[5956,"لا ينبع النُّصْحُ إلا مِن مُحِبِّين","https://www.poetsgate.com/ViewPoem.aspx?id=183684",""],[161,"قصيدتي :عن العشر","https://www.poetsgate.com/ViewPoem.aspx?id=152235",""],[4442,"بشرى الأماني فقد زالت غواشيها","https://www.poetsgate.com/ViewPoem.aspx?id=171222",""],[4442,"أهوت به علته فانتدب","https://www.poetsgate.com/ViewPoem.aspx?id=171003",""],[5309,"طغى المال فانحط الأديب المهذب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573839",""],[6223,"طارقة السحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1216&r=&rc=1",""],[6239,"من ذاكرة الصقيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75978&r=&rc=29",""],[463,"فكاكك أيها القلبُ الأسيرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60055&r=&rc=111",""],[6290,"المُعَلّقَةُ الثّامِنَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85504&r=&rc=22",""],[6359,"عمّان البلد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69088&r=&rc=2",""]],"verses":[["طغيان مرتجس الذرى خضلٍ","لحنينه زجلٌ يرجِّعه",0,"ع",2,0],["طغَى بك طغيان المحبّ ارعوى له","حبيبٌ قَراه الصدَّ حولاً مجرَّما",1,"م",2,0],["طُغَراءُ مَملَكَةٍ وَشّى حَواشيها","مَن ذَوَّبَ الشَمسَ أَلواناً وَوَشّاكِ",2,"ك",1,0],["طغى البعض يشدو بمجد اثيل","ومن اين للقرد مجد اثيل",3,"ل",1,0],["طُغرى كِتابِ الكائِناتِ لِقارِئٍ","يَزِنُ الكَلامَ وَيَقدُرُ الأَقوالا",4,"ل",2,0],["طَغى إِذ جَرَت أَنهارُها تَحتَ عَرشِهِ","وَتاهَ بِها فِرعَونُ تيهاً هُوَ الكُفرُ",5,"ر",1,0],["طَغى الناسُ مِن بَعدِ النَبِيِّ مُحَمَّدٍ","فَقَد دَرَسَت بَعدَ النَبِيِّ الشَرائِعُ",6,"ع",1,0],["طَغى الناسُ حَتّى رَأَيتَ اللَبي","بَ في غِيِّ طُغيانِهِ يَعمَهُ",7,"ه",1,0],["طَغى اليَراعُ لِبَسطي في العِنانِ لَهُ","وَهوَ الجَوادُ وَظَهرُ الطِرسِ مَيدانُ",8,"ن",1,1],["طَغَتِ النُّفوسُ فظالمٌ لا يرعوِي","عن ظُلمهِ ومُشاغِبٌ لا يُقْصِرُ",9,"ر",1,0],["طَغَتِ الخطوبُ عليكِ لا مُتوقِّدٌ","يَخْبُو ولا مُتَمَرِّدٌ ينقادُ",10,"د",1,0],["طَغَتِ الدِماءُ وَفاضَتِ الأَرواحُ","وَطَمَت سُهولٌ بِالرَدى وَبِطاحُ",11,"ح",1,1],["طُغيانُ شاعرِها وجَهْلُ خطيبها","وغروُ صاحِبها المُبيدُ المُتلِفُ",12,"ف",1,0],["طغت الحرب خمسةً ما دهتنا","كثوانٍ مَرَّتْ بغير قتال",13,"ل",1,0],["طغَت وبعد قَليل","رغت رغاء البَعير",14,"ر",1,1],["طغى ثم غاض البحر من بعد ما طغى","وَلَيسَ بما في نفسه يعلم البحر",15,"ر",1,0],["طغَى الأسى الدّاوي على صوتهِ","يا للصَدَى من قلبهِ النَّاطقِ",16,"ق",1,0],["طَغاني بِالرِيا وَالمَكرِ عَمّي","وَجارَ عَلَيَّ في طَلَبِ الصَداقِ",17,"ق",1,0],["طَغَى وَرَمَى مَوَاقِعَهُ","بِصَخْرِ القَاعِ وَالوَحَلِ",18,"ل",1,0],["طَغَتْ أُمَّةُ الجَبَلِ الأَسْوَدِ","عَلَى حُكْمِ فَاتِحِهَا الأَيِّدِ",19,"د",1,1],["طَغَى به الجوعُ ففي دَمْعِهِ","ما فعلَ الجوعُ وفي نَبْرِه",20,"ر",2,0],["طغت عليه سَمومٌ","حرَّى كأنفاسِ جِنِّ",21,"ن",1,0],["طغى العدو وبغى","وشبت نيران الوغى",22,"غ",2,1],["طغَى فضوعف منه الحسنُ والخَطَرُ","وفاض فالأرضُ والأشجارُ تنغمِرُ",23,"ر",1,1],["طغَى بك غيان المحبّ ارعوى له","حبيبٌ قَراه الصدَّ حولاً مجرَّما",24,"م",2,0],["طغى بحر الهموم على حتى","كلفت ضنى وقد ثقلت حمولي",25,"ي",1,1],["طَغَوا وَبَغَوا عَلَىَّ فَقُلتُ صَبراً","ولَم نَكُ رُتبَةً فِئِينَا",26,"ن",2,0],["طغتْ يدُه وعلَتْ في السما","حِ حتّى ذممنا السحابَ الهتونا",27,"ن",2,0],["طَغَى بيَ طَرفُ الحِبِّ في تِيهِ صَبوُةٍ","فَبَينا تَبدَّى قِيل قد درسَ الخَطُّ",28,"ط",1,0],["طَغَتْ يَهودُ دَفينُ الحِقْدِ ديْدَنُها","ودَيْدَنُ العُرْبِ أنْ تَغْفو لِتَنْساكِ",29,"ك",1,0],["طغت عيناك فاستهوت فؤاداً","أسيراً للخدود وللجفون",30,"ن",1,0],["طغى موجك الصخاب فاهتاج لوعتي","وأيقظ أشجاني وبلبل أهوائي",31,"ي",1,0],["طغت دجلةٌ فازداد شوقي لروحكم","وجدت بدمع هائم الروح سلسال",32,"ل",1,0],["طغت دجلةٌ فيما سمعت فأغرقت","بيوتا لنا فيها وإن بعدت أهل",33,"ل",1,1],["طغى فالفلك تعثر في خطاها","وتمضى لا تعود ولا تؤوب",34,"ب",1,0],["طغى النهران في عام وفاضا","جيب يستجيب له حبيب",34,"ب",1,0],["طغت أُمَمُ السودانِ طوعَ غُرورِها","فَمِن مُنجدٍ في الغي منها ومُتهِم",35,"م",1,0],["طغَت وبسيفِ العدلِ سالَت دماؤُها","وكم ضُمِّنَت تلك الدماءَ لحودُ",36,"د",1,0],["طَغَا بِتُونسَ خَلْفٌ","سَمَّوْهُ ظُلْماً خلِيفَهْ",37,"ه",1,1],["طغتِ الأمواجُ تسمو","بالهوادي والصدور",38,"ر",1,0],["طَغَت عبدُ شمسٍ فاستَقلَّ محلِّقاً","إلى الشَّمسِ من طُغيانِها مُتراكمُه",39,"م",2,0],["طغى دهرُنا بالشبه مذ ضل أهلُهُ","بذا الشبهِ إن اللَه ليس له شِبْهُ",40,"ه",1,1],["طغَتْ وبَغَتْ فِعْل الفسوقِ وأعرضَتْ","فحاقَ بها طغيانُها وفسوقُها",41,"ق",3,0],["طغى الماء من بحر ابتداع على الورى","ولم ينج منه مركب وركاب",42,"ب",1,0],["طغى والَّذي يطغى وقد مدَّ باعه","ليُفْسِدَ أمسى مَدُّه منك في جزر",43,"ر",1,0],["طغت انهار علمهم","فقاتت وسع فهمهم",44,"م",1,0],["طغى طَرَفاها واستكان وسيطُها","خُضوعاً فمنها وابلٌ وعميمُ",45,"م",1,0],["طغَى أملي وطال قصيرُ باعي","ويَنمْي الشيءُ أوّلُه حقيرُ",46,"ر",1,0],["طغَى بك أنْ وَنتْ عنك القوافي","وخلفَ فُتورِها دأبٌ ووخْدُ",47,"د",1,0],["طغى دافعاً في صدر كل كتيبةٍ","وغبَّر غيثاً في وجوه القبائل",48,"ل",1,0],["طغىفرعون حتى قال إني","وموسى مغشيا عليه",49,"ي",2,0],["طغَوْا بعِنادِهِمْ بغياً عليه","وغمَّرَهُمْ حَناناً بالأَيادِي",50,"د",2,0],["طَغَى وبَغى المغرورُ جهلاً وغَرَّهُ","منَ القومِ حلمٌ عنهُ والحُرُّ يَحلُمُ",51,"م",1,0],["طغى بيننا تيارهم حين اهملوا","فسال لجرف العلم والعلماء",52,"ا",2,0],["طغَوْا وبغَوْا في الأرض حتى أصابهم","عقابٌ أليمٌ مهلك وتبارُ",53,"ر",1,0],["طغوا وبغوا إذ صييروا الفرد ثالثا","لإثنين جل الله رب ابن مريما",54,"م",2,0],["طَغَوا فَعَقُّهمُ لمَّا دَلَفْتَ لَهُمْ","طَعْنٌ ذَكَرْنا بِهِ طاعونَ عَمْواسِ",55,"س",1,0],["طغى الشرفي بعض النفوس ولم يزل","يرب إلى أن اعلن الشر كاتم",56,"م",1,0],["طغى وتولى يا قدير فاكثر ال","فساد بمرأى القدرة الأزلية",57,"ه",1,0],["طغام طغاة تبَّروا ما علوا ولا","نصير سوى القهار فوق البرية",58,"ه",1,0],["طغت نارنا فيهم فما لمغرب","من النار منجاة ولا لمشرق",59,"ق",1,0],["طَغى عَلى القَلبِ عِربيداً فَقُلتُ لَهُ","يا حُبُّ رِفقاً بِهَذا الخافِقِ العاني",60,"ن",2,0],["طَغَت عَلَيهِ مِنَ الأَحزانِ طاغِيَةٌ","أَودَت بِهِ وَمَحَت ما كانَ يَرسُمُهُ",61,"م",2,0],["طغى الذي ناواه في ولائه","في ورطة العذاب قد تورطا",62,"ط",2,0],["طغى كجيفة على الماء ومن","بعدلهِ طير العقاب التقطا",62,"ط",2,0],["طغت الأهواء والشح طما","فإذا الأقوام في حرب طحون",63,"ن",1,1],["طَغى لَكَ اِعجاب هَوى لَكَ نجمُهُ","إِلى هوةٍ في قُعرِها أَنتَ راسب",64,"ب",1,0],["طَغَت بِيامٍ أَمانيها فَجرَّ لها","دُهمَ الكَتائِبِ فيها كلُّ لَيثِ شَرى",65,"ر",2,0],["طغوا نكلوا مثلوا غللوا","بغوا طردوا صفدوا عترتك",66,"ك",1,0],["طَغيتَ يا جَرحُ حَتّى","تَحدّر القَلب مِنكا",67,"ك",2,0],["طغى خطه ذاكَ العَزيز بمصره","فصال به موسى عَلى معشر القبط",68,"ط",1,0],["طَغى جوده وَالناس من حول نيله","كأَنهم الورّاد من شاطىء الشطّ",68,"ط",1,0],["طَغامٌ رُعاعٌ تابَعوا كُلَّ ناعِق","جُسُومٌ بِلا حِسٍّ قُلوبٌ بِلا عَقلِ",69,"ل",1,0],["طغى كبرياءُ النصر حتى تشامخوا","على رغم عز شامخ لك يفتر",70,"ر",1,0],["طغى العقل حتى كاد يقتل نفسه","بتفكيره أو كاد يفضي الى قتلي",71,"ل",2,0],["طَغامُ الناسِ لَيسَ لَهُم سَبيلٌ","شَجاني يا اِبنَ عَلقَمَةَ الطغامُ",72,"م",1,0],["طَغيت وَأَحزَنت الرَسول بِقَبره","وَأَطفَأت نوراً في الوجود يَنور",73,"ر",1,0],["طغتْ غطفانُ بعدها فطوى لها","بذي أمرٍ شهراً وعاد وما شطا",74,"ط",2,0],["طغى الأمر حتى لست أسطيع حمله","وما بي لولا الحلم أدهى وأخرق",75,"ق",1,0],["طَغى الظلم حَتّى صار في كلّ بقعةٍ","له علم يَغشى النَواظِر خافِقُ",76,"ق",1,0],["طغى الشوق في هيفاء أولى لخصرها","برغم مكان القرطان يلبس القرطا",77,"ط",2,0],["طغى النيل عن حد عاداته","وعلمنا الجهل في العالمين",78,"ن",1,1],["طغى عليه سعارٌ من لواعجه","وللغرام سعارٌ طائشُ الرسن",79,"ن",1,0],["طغى بغرب الأرض والشرق وال","قطبين طوفان الفنا والفوات",80,"ت",1,0],["طغى بهم الكبر المشوم فناطحوا ال","جبال أليس الصخر للراس فالقه",81,"ق",2,0],["طغى الماء من بحر ابتداع على الورى","فلم ينج منه مركبٌ وركاب",82,"ب",1,0],["طَغَى جُندُ إبليسٍ وفَارَت جُمُوعُهُ","وأحزابُهُ فَاستَوجَبُوا القَطعَ والقَطَّا",83,"ط",2,0],["طَغا بِذاكَ السَهلِ كَالزُعابِ","يَبتَتُّ ظَهرَ الرَكبِ وَالرُكّابِ",84,"ب",1,0],["طُغمته أَجهلُ سكانِها","يخلُبها المنصبُ في شهوته",85,"ت",2,0],["طغت فوق أصنافِ العلوم جميعها","كنسبة هملايا لصغرى الكهارب",86,"ب",1,0],["طَغا ماءَ الجُفون وَما دنت بي","سَفين الشَوق من جودى الوِصال",87,"ل",1,0],["طَغَوا بسفكِ دماءِ المسلمين أسىً","ونَهبِ أموالِهم تبّاً لمن فجرا",88,"ر",2,0],["طَغى بِشَطآن الهَوى جامه","دَهراً وَغناك وَغنى الرِمال",89,"ل",1,0],["طُغاةٍ عماةٍ مارقينَ عن الهدى","وكل لعينٍ قولُهُ غيرُ صادِقِ",90,"ق",1,0],["طَغَتِ الخَطايا في الدُنا فَتسعّرت","من كُلّ صَوبٍ نارُها بِلِقاحِ",91,"ح",1,0],["طَغوا وَبَغوا في الأَمرِ حتّى كَأَنَّهُم","بِأَفعالهم أسطورَة في العَجائِبِ",92,"ب",1,0],["طَغى العقوقُ وَغَدرُ الأَقربينَ عَلى","هَذا 