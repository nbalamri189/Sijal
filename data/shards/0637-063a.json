{"poems":[[51,"لج الفؤاد فليس يلذعه","https://www.aldiwan.net/poem65413.html","أحذ الكامل"],[51,"ليهنك أن أفطرت لا متطلعا","https://www.aldiwan.net/poem66008.html","الطويل"],[91,"لو كان لي غير قلبي عند مرآك","https://www.aldiwan.net/poem9048.html","عموديه"],[89,"لقد كان منك اليك السبيل","https://www.aldiwan.net/poem44883.html","المتقارب"],[85,"العام أقبل قم نحي هلالا","https://www.aldiwan.net/poem63751.html","الكامل"],[45,"مرضت فأمرضت القلوب وجانبت","https://www.aldiwan.net/poem64554.html","الطويل"],[49,"هو الموت فاصنع كلما أنت صانع","https://www.aldiwan.net/poem62154.html","الطويل"],[49,"ألا يا بني آدم استنبهوا","https://www.aldiwan.net/poem63189.html","البسيط"],[66,"طغى اليراع لبسطي في العنان له","https://www.aldiwan.net/poem38694.html","الطويل"],[105,"مرأى من الملأ العلي ومظهر","https://www.aldiwan.net/poem41935.html","الكامل"],[105,"تلك القضية هل لها ميعاد","https://www.aldiwan.net/poem42073.html","الكامل"],[105,"طغت الدماء وفاضت الأرواح","https://www.aldiwan.net/poem43145.html","الكامل"],[105,"الكتب تترى والكتائب تدلف","https://www.aldiwan.net/poem43999.html","الكامل"],[102,"أدموع النساء والأطفال","https://www.aldiwan.net/poem33120.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85633","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85602","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9948","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55119","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[77,"طغى العدو وبغى","https://www.poetsgate.com/ViewPoem.aspx?id=34178",""],[90,"الفرات الطاغي","https://www.poetsgate.com/ViewPoem.aspx?id=179148",""],[51,"ليهنَكَ أن أفطرتَ لا متطلعاً","https://www.poetsgate.com/ViewPoem.aspx?id=30406",""]],"verses":[["طغيان مرتجس الذرى خضلٍ","لحنينه زجلٌ يرجِّعه",0,"ع",2,0],["طغَى بك طغيان المحبّ ارعوى له","حبيبٌ قَراه الصدَّ حولاً مجرَّما",1,"م",2,0],["طُغَراءُ مَملَكَةٍ وَشّى حَواشيها","مَن ذَوَّبَ الشَمسَ أَلواناً وَوَشّاكِ",2,"ك",1,0],["طغى البعض يشدو بمجد اثيل","ومن اين للقرد مجد اثيل",3,"ل",1,0],["طُغرى كِتابِ الكائِناتِ لِقارِئٍ","يَزِنُ الكَلامَ وَيَقدُرُ الأَقوالا",4,"ل",2,0],["طَغى إِذ جَرَت أَنهارُها تَحتَ عَرشِهِ","وَتاهَ بِها فِرعَونُ تيهاً هُوَ الكُفرُ",5,"ر",1,0],["طَغى الناسُ مِن بَعدِ النَبِيِّ مُحَمَّدٍ","فَقَد دَرَسَت بَعدَ النَبِيِّ الشَرائِعُ",6,"ع",1,0],["طَغى الناسُ حَتّى رَأَيتَ اللَبي","بَ في غِيِّ طُغيانِهِ يَعمَهُ",7,"ه",1,0],["طَغى اليَراعُ لِبَسطي في العِنانِ لَهُ","وَهوَ الجَوادُ وَظَهرُ الطِرسِ مَيدانُ",8,"ن",1,1],["طَغَتِ النُّفوسُ فظالمٌ لا يرعوِي","عن ظُلمهِ ومُشاغِبٌ لا يُقْصِرُ",9,"ر",1,0],["طَغَتِ الخطوبُ عليكِ لا مُتوقِّدٌ","يَخْبُو ولا مُتَمَرِّدٌ ينقادُ",10,"د",1,0],["طَغَتِ الدِماءُ وَفاضَتِ الأَرواحُ","وَطَمَت سُهولٌ بِالرَدى وَبِطاحُ",11,"ح",1,1],["طُغيانُ شاعرِها وجَهْلُ خطيبها","وغروُ صاحِبها المُبيدُ المُتلِفُ",12,"ف",1,0],["طغت الحرب خمسةً ما دهتنا","كثوانٍ مَرَّتْ بغير قتال",13,"ل",1,0],["طغَت وبعد قَليل","رغت رغاء البَعير",14,"ر",1,1],["طغى ثم غاض البحر من بعد ما طغى","وَلَيسَ بما في نفسه يعلم البحر",15,"ر",1,0],["طغَى الأسى الدّاوي على صوتهِ","يا للصَدَى من قلبهِ النَّاطقِ",16,"ق",1,0],["طَغاني بِالرِيا وَالمَكرِ عَمّي","وَجارَ عَلَيَّ في طَلَبِ الصَداقِ",17,"ق",1,0],["طَغَى وَرَمَى مَوَاقِعَهُ","بِصَخْرِ القَاعِ وَالوَحَلِ",18,"ل",1,0],["طَغَتْ أُمَّةُ الجَبَلِ الأَسْوَدِ","عَلَى حُكْمِ فَاتِحِهَا الأَيِّدِ",19,"د",1,1],["طَغَى به الجوعُ ففي دَمْعِهِ","ما فعلَ الجوعُ وفي نَبْرِه",20,"ر",2,0],["طغت عليه سَمومٌ","حرَّى كأنفاسِ جِنِّ",21,"ن",1,0],["طغى العدو وبغى","وشبت نيران الوغى",22,"غ",2,1],["طغَى فضوعف منه الحسنُ والخَطَرُ","وفاض فالأرضُ والأشجارُ تنغمِرُ",23,"ر",1,1],["طغَى بك غيان المحبّ ارعوى له","حبيبٌ قَراه الصدَّ حولاً مجرَّما",24,"م",2,0]]}