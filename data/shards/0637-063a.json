{"poems":[[51,"لج الفؤاد فليس يلذعه","https://www.aldiwan.net/poem65413.html","أحذ الكامل"],[51,"ليهنك أن أفطرت لا متطلعا","https://www.aldiwan.net/poem66008.html","الطويل"],[91,"لو كان لي غير قلبي عند مرآك","https://www.aldiwan.net/poem9048.html","عموديه"],[89,"لقد كان منك اليك السبيل","https://www.aldiwan.net/poem44883.html","المتقارب"],[85,"العام أقبل قم نحي هلالا","https://www.aldiwan.net/poem63751.html","الكامل"],[45,"مرضت فأمرضت القلوب وجانبت","https://www.aldiwan.net/poem64554.html","الطويل"],[49,"هو الموت فاصنع كلما أنت صانع","https://www.aldiwan.net/poem62154.html","الطويل"],[49,"ألا يا بني آدم استنبهوا","https://www.aldiwan.net/poem63189.html","البسيط"],[66,"طغى اليراع لبسطي في العنان له","https://www.aldiwan.net/poem38694.html","الطويل"],[105,"مرأى من الملأ العلي ومظهر","https://www.aldiwan.net/poem41935.html","الكامل"],[105,"تلك القضية هل لها ميعاد","https://www.aldiwan.net/poem42073.html","الكامل"],[105,"طغت الدماء وفاضت الأرواح","https://www.aldiwan.net/poem43145.html","الكامل"],[105,"الكتب تترى والكتائب تدلف","https://www.aldiwan.net/poem43999.html","الكامل"],[102,"أدموع النساء والأطفال","https://www.aldiwan.net/poem33120.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85633","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85602","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9948","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55119","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[77,"طغى العدو وبغى","https://www.poetsgate.com/ViewPoem.aspx?id=34178",""],[90,"الفرات الطاغي","https://www.poetsgate.com/ViewPoem.aspx?id=179148",""],[51,"ليهنَكَ أن أفطرتَ لا متطلعاً","https://www.poetsgate.com/ViewPoem.aspx?id=30406",""],[115,"طغى بحر الهموم على حتى","https://www.aldiwan.net/poem41978.html","الوافر"],[132,"عجبت لأسرة الحسن الدينا","https://www.aldiwan.net/poem54720.html","الوافر"],[142,"تزاورن عن أذرعات يمينا","https://www.aldiwan.net/poem58450.html","المتقارب"],[150,"طويت الحشا مني على حر لوعة","https://www.aldiwan.net/poem68561.html","الطويل"],[178,"صبراً فلسطين","https://www.aldiwan.net/poem50702.html","البسيط"],[211,"إلى القاضي وعينيه سلام","https://www.aldiwan.net/poem46304.html","الوافر"],[211,"وفدت على بغداد والقلب موجع","https://www.aldiwan.net/poem46574.html","الطويل"],[211,"أتخطر في بالي خطرت فليتني","https://www.aldiwan.net/poem46622.html","الطويل"],[211,"طغت دجلة فيما سمعت فأغرقت","https://www.aldiwan.net/poem46758.html","الطويل"],[211,"رأيت ومن يعش ما عشت يشهد","https://www.aldiwan.net/poem46759.html","الوافر"],[241,"أرى المجد في حد الحسام المصمم","https://www.aldiwan.net/poem45761.html","الطويل"],[241,"قدوم ولكن لا أقول سعيد","https://www.aldiwan.net/poem45771.html","الطويل"],[275,"طغا بتونس خلف","https://www.aldiwan.net/poem25426.html","المجتث"],[298,"من وراء السحب فوق البح","https://www.aldiwan.net/poem36798.html","عموديه"],[371,"خلا طرفه بالسقم دوني يلازمه","https://www.aldiwan.net/poem57103.html","الطويل"],[377,"طغى دهرنا بالشبه مذ ضل أهله","https://www.aldiwan.net/poem59205.html","الطويل"],[402,"من القوم طالت في المعالي فروعها","https://www.aldiwan.net/poem46928.html","الطويل"],[403,"أما آن عما أنت فيه متاب","https://www.aldiwan.net/poem34163.html","الطويل"],[416,"تنقلت مثل البدر يا طلعة البدر","https://www.aldiwan.net/poem54158.html","الطويل"],[443,"وشب بأرض بوليفا","https://www.aldiwan.net/poem55925.html","عموديه"],[458,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[458,"فكاكك أيها القلب الأسير","https://www.aldiwan.net/poem56202.html","الوافر"],[458,"تمناها بجهل الظن سعد","https://www.aldiwan.net/poem56219.html","الوافر"],[464,"خليلي عوجاً بالمحلة إنها","https://www.aldiwan.net/poem3140.html","عموديه"],[500,"يربي الحكم حقا ثم بطلا","https://www.aldiwan.net/poem37553.html","الوافر"],[500,"ترفع عن محاورة الأعادي","https://www.aldiwan.net/poem38026.html","الوافر"],[538,"كما قلتم لن يرتضي السلم مجرم","https://www.aldiwan.net/poem47935.html","عموديه"]],"verses":[["طغيان مرتجس الذرى خضلٍ","لحنينه زجلٌ يرجِّعه",0,"ع",2,0],["طغَى بك طغيان المحبّ ارعوى له","حبيبٌ قَراه الصدَّ حولاً مجرَّما",1,"م",2,0],["طُغَراءُ مَملَكَةٍ وَشّى حَواشيها","مَن ذَوَّبَ الشَمسَ أَلواناً وَوَشّاكِ",2,"ك",1,0],["طغى البعض يشدو بمجد اثيل","ومن اين للقرد مجد اثيل",3,"ل",1,0],["طُغرى كِتابِ الكائِناتِ لِقارِئٍ","يَزِنُ الكَلامَ وَيَقدُرُ الأَقوالا",4,"ل",2,0],["طَغى إِذ جَرَت أَنهارُها تَحتَ عَرشِهِ","وَتاهَ بِها فِرعَونُ تيهاً هُوَ الكُفرُ",5,"ر",1,0],["طَغى الناسُ مِن بَعدِ النَبِيِّ مُحَمَّدٍ","فَقَد دَرَسَت بَعدَ النَبِيِّ الشَرائِعُ",6,"ع",1,0],["طَغى الناسُ حَتّى رَأَيتَ اللَبي","بَ في غِيِّ طُغيانِهِ يَعمَهُ",7,"ه",1,0],["طَغى اليَراعُ لِبَسطي في العِنانِ لَهُ","وَهوَ الجَوادُ وَظَهرُ الطِرسِ مَيدانُ",8,"ن",1,1],["طَغَتِ النُّفوسُ فظالمٌ لا يرعوِي","عن ظُلمهِ ومُشاغِبٌ لا يُقْصِرُ",9,"ر",1,0],["طَغَتِ الخطوبُ عليكِ لا مُتوقِّدٌ","يَخْبُو ولا مُتَمَرِّدٌ ينقادُ",10,"د",1,0],["طَغَتِ الدِماءُ وَفاضَتِ الأَرواحُ","وَطَمَت سُهولٌ بِالرَدى وَبِطاحُ",11,"ح",1,1],["طُغيانُ شاعرِها وجَهْلُ خطيبها","وغروُ صاحِبها المُبيدُ المُتلِفُ",12,"ف",1,0],["طغت الحرب خمسةً ما دهتنا","كثوانٍ مَرَّتْ بغير قتال",13,"ل",1,0],["طغَت وبعد قَليل","رغت رغاء البَعير",14,"ر",1,1],["طغى ثم غاض البحر من بعد ما طغى","وَلَيسَ بما في نفسه يعلم البحر",15,"ر",1,0],["طغَى الأسى الدّاوي على صوتهِ","يا للصَدَى من قلبهِ النَّاطقِ",16,"ق",1,0],["طَغاني بِالرِيا وَالمَكرِ عَمّي","وَجارَ عَلَيَّ في طَلَبِ الصَداقِ",17,"ق",1,0],["طَغَى وَرَمَى مَوَاقِعَهُ","بِصَخْرِ القَاعِ وَالوَحَلِ",18,"ل",1,0],["طَغَتْ أُمَّةُ الجَبَلِ الأَسْوَدِ","عَلَى حُكْمِ فَاتِحِهَا الأَيِّدِ",19,"د",1,1],["طَغَى به الجوعُ ففي دَمْعِهِ","ما فعلَ الجوعُ وفي نَبْرِه",20,"ر",2,0],["طغت عليه سَمومٌ","حرَّى كأنفاسِ جِنِّ",21,"ن",1,0],["طغى العدو وبغى","وشبت نيران الوغى",22,"غ",2,1],["طغَى فضوعف منه الحسنُ والخَطَرُ","وفاض فالأرضُ والأشجارُ تنغمِرُ",23,"ر",1,1],["طغَى بك غيان المحبّ ارعوى له","حبيبٌ قَراه الصدَّ حولاً مجرَّما",24,"م",2,0],["طغى بحر الهموم على حتى","كلفت ضنى وقد ثقلت حمولي",25,"ي",1,1],["طَغَوا وَبَغَوا عَلَىَّ فَقُلتُ صَبراً","ولَم نَكُ رُتبَةً فِئِينَا",26,"ن",2,0],["طغتْ يدُه وعلَتْ في السما","حِ حتّى ذممنا السحابَ الهتونا",27,"ن",2,0],["طَغَى بيَ طَرفُ الحِبِّ في تِيهِ صَبوُةٍ","فَبَينا تَبدَّى قِيل قد درسَ الخَطُّ",28,"ط",1,0],["طَغَتْ يَهودُ دَفينُ الحِقْدِ ديْدَنُها","ودَيْدَنُ العُرْبِ أنْ تَغْفو لِتَنْساكِ",29,"ك",1,0],["طغت عيناك فاستهوت فؤاداً","أسيراً للخدود وللجفون",30,"ن",1,0],["طغى موجك الصخاب فاهتاج لوعتي","وأيقظ أشجاني وبلبل أهوائي",31,"ي",1,0],["طغت دجلةٌ فازداد شوقي لروحكم","وجدت بدمع هائم الروح سلسال",32,"ل",1,0],["طغت دجلةٌ فيما سمعت فأغرقت","بيوتا لنا فيها وإن بعدت أهل",33,"ل",1,1],["طغى فالفلك تعثر في خطاها","وتمضى لا تعود ولا تؤوب",34,"ب",1,0],["طغى النهران في عام وفاضا","جيب يستجيب له حبيب",34,"ب",1,0],["طغت أُمَمُ السودانِ طوعَ غُرورِها","فَمِن مُنجدٍ في الغي منها ومُتهِم",35,"م",1,0],["طغَت وبسيفِ العدلِ سالَت دماؤُها","وكم ضُمِّنَت تلك الدماءَ لحودُ",36,"د",1,0],["طَغَا بِتُونسَ خَلْفٌ","سَمَّوْهُ ظُلْماً خلِيفَهْ",37,"ه",1,1],["طغتِ الأمواجُ تسمو","بالهوادي والصدور",38,"ر",1,0],["طَغَت عبدُ شمسٍ فاستَقلَّ محلِّقاً","إلى الشَّمسِ من طُغيانِها مُتراكمُه",39,"م",2,0],["طغى دهرُنا بالشبه مذ ضل أهلُهُ","بذا الشبهِ إن اللَه ليس له شِبْهُ",40,"ه",1,1],["طغَتْ وبَغَتْ فِعْل الفسوقِ وأعرضَتْ","فحاقَ بها طغيانُها وفسوقُها",41,"ق",3,0],["طغى الماء من بحر ابتداع على الورى","ولم ينج منه مركب وركاب",42,"ب",1,0],["طغى والَّذي يطغى وقد مدَّ باعه","ليُفْسِدَ أمسى مَدُّه منك في جزر",43,"ر",1,0],["طغت انهار علمهم","فقاتت وسع فهمهم",44,"م",1,0],["طغى طَرَفاها واستكان وسيطُها","خُضوعاً فمنها وابلٌ وعميمُ",45,"م",1,0],["طغَى أملي وطال قصيرُ باعي","ويَنمْي الشيءُ أوّلُه حقيرُ",46,"ر",1,0],["طغَى بك أنْ وَنتْ عنك القوافي","وخلفَ فُتورِها دأبٌ ووخْدُ",47,"د",1,0],["طغى دافعاً في صدر كل كتيبةٍ","وغبَّر غيثاً في وجوه القبائل",48,"ل",1,0],["طغىفرعون حتى قال إني","وموسى مغشيا عليه",49,"ي",2,0],["طغَوْا بعِنادِهِمْ بغياً عليه","وغمَّرَهُمْ حَناناً بالأَيادِي",50,"د",2,0],["طَغَى وبَغى المغرورُ جهلاً وغَرَّهُ","منَ القومِ حلمٌ عنهُ والحُرُّ يَحلُمُ",51,"م",1,0]]}