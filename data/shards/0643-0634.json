69.html","عموديه"],[468,"كشط الصباح بنوره","https://www.aldiwan.net/poem59657.html","مجزوء الكامل"],[470,"فلما قضاه الله لم يدع مسلما","https://www.aldiwan.net/poem4808.html","الطويل"],[477,"بعد المزار فأنة وتذكر","https://www.aldiwan.net/poem15285.html","الكامل"],[477,"أذال على بالي الرسوم المدامعا","https://www.aldiwan.net/poem15322.html","الطويل"],[477,"متى حان من شمس النهار غروب","https://www.aldiwan.net/poem15325.html","الطويل"],[477,"أشد الهوى ما يمنع العين أن تكرى","https://www.aldiwan.net/poem15349.html","الطويل"],[477,"أضر بعيني دمعها وانسكابه","https://www.aldiwan.net/poem15358.html","الطويل"],[479,"تهاطلت الرسائل منك تترى","https://www.aldiwan.net/poem36932.html","الوافر"],[479,"وقفوا هناك وحسبهم","https://www.aldiwan.net/poem36960.html","مجزوء الكامل"],[479,"فسد الزمان وأهله","https://www.aldiwan.net/poem37028.html","مجزوء الكامل"],[490,"إن ترى رأسي فيه قزعٌ","https://www.aldiwan.net/poem655.html",""],[500,"تجرأ حزب الجاحدين كما تشا","https://www.aldiwan.net/poem37564.html","الطويل"],[500,"قف بالركاب فهذه الأطلال","https://www.aldiwan.net/poem37628.html","الكامل"],[500,"علام الهموم وفيم العنا","https://www.aldiwan.net/poem37695.html","المتقارب"],[500,"قد تداعت من الأقاح خيوط","https://www.aldiwan.net/poem37784.html","الخفيف"],[500,"شروق بغربي اللوا لألأت لنا","https://www.aldiwan.net/poem37796.html","الطويل"],[500,"سقط الفحول عن الأرائك","https://www.aldiwan.net/poem38102.html","مجزوء الكامل"],[500,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[504,"سروري وذوقي من جمالك صادر","https://www.aldiwan.net/poem38406.html","الطويل"],[514,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[515,"صرف النسيب إلى اللوى وزرود","https://www.aldiwan.net/poem12082.html","الكامل"],[515,"لك الحسب الباقي على عقب الدهر","https://www.aldiwan.net/poem12142.html","الطويل"],[551,"إنا نعلل كلنا بمحال","https://www.aldiwan.net/poem47297.html","الكامل"],[551,"صد عني كارها قربي","https://www.aldiwan.net/poem48073.html","مجزوء الرمل"],[553,"أديري على الراح ساقية الخمر","https://www.aldiwan.net/poem68421.html","الطويل"],[558,"يا صدق القوم عن جمالك قد رووا","https://www.aldiwan.net/poem33584.html","الكامل"],[558,"إنما الإيمان نور","https://www.aldiwan.net/poem33785.html","مجزوء الرمل"],[558,"لقد نظرت قوم بطرف لهم قذي","https://www.aldiwan.net/poem33813.html","الطويل"],[558,"نعم لقلوب العاشقين سرائر","https://www.aldiwan.net/poem34527.html","الطويل"],[559,"كشف المحبوب عن قلبي الغطا","https://www.aldiwan.net/poem69334.html","الرمل"],[559,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[569,"أنا مسكين لمن يعرفني","https://www.aldiwan.net/poem52042.html","الرمل"],[570,"جزاك الله خيرا من خليل","https://www.aldiwan.net/poem59465.html","الطويل"]],"verses":[["كَشَفوا الغِطاءَ عَنِ العُيونِ فَأَبصَروا","ما في الكِنانَةِ مِن أَذىً وَضِرارِ",0,"ر",1,0],["كَشَفنا عَن نَواياكُم فَلَستُم","وَقَد بَرِحَ الخَفاءُ مُحايِدينا",1,"ن",2,0],["كَشَفوا عَن نِيَّةِ الغَربِ لَنا","وَجَلَوا عَن أُفُقِ الشَرقِ الظَلاما",2,"م",2,0],["كَشَفتَ أَبا بَدرٍ إِذا القَومُ أَحجَموا","وَغَضَّت مَلاقي مَرهِم بِالمُخَنَّقِ",3,"ق",1,0],["كَشَفَتْ مُفَاجَأَةُ الرَّزِيئَة سِتْرَهَا","وَانْتِيبَ مَأَلَفُ عِزِّهَا بِهَوَانِ",4,"ن",1,0],["كَشْفُ المَظَالِمِ لا يُرَامُ إِذَا","مَا رُمْتَهُ مِنْ كَفِّ مُهْتَضَمِ",5,"م",1,0],["كشفت به ما كان من حجب العمى","عنكم نظيَرة بنت زين الدين",6,"ن",1,0],["كشَبوبٍ ذي كبرياءَ من الوِحْ","دة لا يبتغي عليها ظهيرا",7,"ر",2,1],["كَشِيعَتِهِ والحَربُ قَد ثُفِّيَت","لها أمَامَهم قِدرٌ يَجِيشُ وَمِرجَلُ",8,"ل",1,0],["كَشَفنَا الجُوع ذَا الهبواتِ عنهُم","وأَطعمنَا ضَرائِكَ تَعتَرِينَا",9,"ن",2,0],["كَشَفتُ بِهِ صُدورَ الخَيلِ عَنّي","كَما جَفَّلتَ في بيدٍ نَعاما",10,"م",2,0],["كشفَتْ منك حاجتي هَنواتٍ","غُطِّيتْ برهةً بحسن اللقاءِ",11,"ا",2,0],["كَشَيْخٍ رأيناه تزوَّج آنِفاً","فأمسى وما داناه كسرى المتوَّجُ",12,"ج",1,0],["كشارب الآجن الأجاج من ال","ماء فما ازداد غيرَ إعطاش",13,"ش",1,0],["كشَّفتُ منه ثيابه عن سوءة","شوهاء شقت عن عجان أعرف",14,"ف",1,0],["كشجى الحلق لا يسوغ ولا يل","فظ بين اللُّهى وبين التراقي",15,"ق",2,0],["كشف الوعدَ من نتائج صدقٍ","مُعجلاتٍ لم تَضْوَ في الإعجالِ",16,"ل",1,0],["كشهريٍّ لديك ومعشريٍّ","طفيليَّينِ شأنُهما الوُغولُ",17,"ل",1,0],["كَشَفنا عَنهُمُ نَزَواتِ قَيسٍ","وَمِثلُ جُموعِنا مَنَعَ الذِمارا",18,"ر",2,0],["كَشَفتَ غِطاءَ الكُفرِ عَنّا وَأَقلَعَت","زَلازِلُهُ لَمّا وَضَعتَ المَراسِيا",19,"ي",2,0],["كَشّافَةُ مِصرَ وَصِبيَتُها","وَمُناةُ الدارِ وَمُنيَتُها",20,"ه",2,0],["كَشَفتُ بِهِ الحَياةَ فَلَم أَجِدها","وَلَمحَةَ مائِها إِلّا خِداعا",21,"ع",2,0],["كُشِفَ الغَطاءُ لَهُ فَكُلُّ عِبارَةٍ","في طَيِّها لِلقارِئينَ ضَميرُ",22,"ر",1,0],["كَشَفَ الغَطاءُ عَنِ الطُرولِ وَأَشرَقَت","مِنهُ الطَبيعَةُ غَيرَ ذاتِ سِتارِ",23,"ر",1,0],["كَشَهادَتي للّهِ خالِصَةً","قبلَ العِيَانِ بأنّهُ رَبُّ",24,"ب",1,0],["كَشَّفتُ جَمهَرَةَ العِبادِ فَلَم أَجِد","إِلّا مَسوداً جَنبَهُ مَرؤوسا",25,"س",2,0],["كَشَفَت ثَلاثَ ذَوائِبٍ مِن شَعرِها","في لَيلَةٍ فَأَرَت لَيالِيَ أَربَعا",26,"ع",2,0],["كَشَفَت لَنا سَيَرُ الأَميرِ مُحَمَّدٍ","عَن أَمرِ ناهٍ بِالسَدادِ وَآمِرِ",27,"ر",1,0],["كَشَفوا بِتَلِّ كُشافَ أَروِقَةَ الدُجى","عَن عارِضٍ مَلَأَ السَماءَ بُروقا",28,"ق",2,0],["كَشِفاءِ السَقامِ في عُقبِ يَأسٍ","مِن تَلافيهِ أَو شِفاءِ الغَليلِ",29,"ل",1,0],["كَشَفتَ عَنِ الأَبصارِ كُلَّ عَشاً بِها","وَكُلُّ قَضاءٍ جائِرٍ أَنتَ عادِلُه",30,"ل",2,1],["كشَمْسٍ سالَمتْ ظُلَماً","وغُصْنٍ حاملٍ عَنَما",31,"م",2,0],["كَشَفَ الصَّباحُ قِناعَهُ فتألَّقا","وسَطا على اللَّيلِ البَهيمِ فأشرَقا",32,"ق",2,1],["كشاطرٍ هَمَّ بالعدوِّ فَما","أقصرَ حتى رأى دماً جاري",33,"ر",2,0],["كَشِيمَةِ العُودِ ما زالَتْ بلا سببٍ","تُهدِي إلى العُودِ إحراقاً وإيقادا",34,"د",2,0],["كَشاةِ الإِرانِ الأَعفَرِ اِنضَرَجَت لَهُ","كِلابٌ رَآها مِن بَعيدٍ فَأَحضَرا",35,"ر",2,0],["كَشَفتُ أَخلاقَ الرِجا","لِ وَخُقتُهُم جيلاً فَجيلَ",36,"ل",1,0],["كَشَمسٍ بِأُفقٍ فَوقَ بَرقٍ بِكَفِّهِ","هِلالٌ رَمى في اللَيلِ جِنّاً بِأَنجُمِ",37,"م",1,0],["كَشَفتُ خِمارَ الصَونِ عَن حُرِّ وَجهِها","ضُحىً وَلِثامُ الصُبحِ في الشَرقِ طائِحُ",38,"ح",1,0],["كشفت لعينينا وقد ومضت","ظلين معتنقين في السور",39,"ر",1,0],["كشفتَ لها ساقاً وكنتَ لكشفها","تَحزّ الهوادي أو تجزّ النواصيا",40,"ي",2,0],["كَشّرَ الدهر عن حِدادِ نُيوبٍ","أكلَتهُمْ بكلّ قَضْمٍ وَخَضْمِ",41,"م",1,0],["كشفتَ كروباً عن قلوبٍ كأنّما","وَضَعْتَ عَلَيْها من هواك خواتما",42,"م",2,0],["كَشَفتُ قِناعَ الشِعرِ عَن حُرِّ وَجهِهِ","وَطَيَّرتُهُ عَن وَكرِهِ وَهوَ واقِعُ",43,"ع",1,0],["كَشَّفَتكَ الأَيّامُ يا إِنسانُ","لا يَكُن لِلَّذي أَهَنتَ الهَوانُ",44,"ن",1,1],["كُشِفَ الغِطاءُ فَأَوقِدي أَو أَخمِدي","لَم تَكمَدي فَظَنَنتِ أَن لَم يَكمَدِ",45,"د",1,1],["كَشَقيقَةِ البُردِ المُنَمنَمِ وَشيُهُ","في أَرضِ مَهرَةَ أَو بِلادِ تَزيدِ",46,"د",1,0],["كَشَفَ الرَوضُ رَأسَهُ وَاِستَسَرَّ ال","مَحلُ مِنها كَما اِستَسَرَّ المُريبُ",47,"ب",1,0],["كشفتُ بأمسِ وجهَ غدٍ رهيب","ماطت عنه قافيةً شرودُ",48,"د",1,0],["كَشَفَت لَهُ الأَيّامُ عَن أَسرارِها","فَرأى جَلِيَّ عَواقِبِ الأَشياءِ",49,"ا",2,0],["كُشِفَ الغِطاءُ إِلَيكَ عَن سِرِّ الرَدى","فَأَجِب بِما تَندى بِهِ الأَكبادُ",50,"د",1,0],["كشفت آياتُها الكُبرى لنا","عن أعاجيبَ تناهَت عِظَما",51,"م",2,0],["كشفَ الظّلامَ عن القُلوبِ فأبصرَتْ","وبدا المُغيَّبُ واضحاً معروفا",52,"ف",2,0],["كشفَ التّجريبُ عن سَوْآتِها","ومضَتْ عاريةً ما تَحتشِمْ",53,"م",1,0],["كشفوا الظّلامَ فهم نُجومُ هدايةٍ","وَرَستْ جوانبُهم فهم أطوادُ",54,"د",1,0],["كَشَفَ الحِدثانُ عَن مَكنونِها","فَأَزالَ الشَكَّ عَن وَجهِ اليَقينْ",55,"ن",1,0],["كَشَفوا الضُرَّ عَنِ المُستَضعَفينْ","وَأَذاقوهُم أَفاويقَ النِعَمْ",56,"م",1,0],["كَشَفوا عَنِ العِلمِ الغِطاءَ وَأَدرَكوا","سِرَّ التَفَوُّقِ فيهِ وَالرَجَحانِ",57,"ن",1,0],["كَشَفَ العُنوانُ عَمّا تَحتَهُ","مِن أُمورٍ ما أَراها تُجهَلُ",58,"ل",1,0],["كشف الكِتابُ عَن المَحجَّةِ فَانظُروا","وَأَرى المحجّة عِندَكُم أَن تَصدِفوا",59,"ف",3,0],["كَشَفَ اللهُ له عما انْطَوى","في زوايا الغيبِ عنه فَظَهَرْ",60,"ر",1,0],["كُشِفَ اللِثامُ عن اليقينِ ولن تَرى","كالجهلِ سِتراً والغرورِ لِثاما",61,"م",2,0],["كشفَ الغطاءَ عن النِّفاقِ بسورةٍ","نزلتْ وكان غطاؤُه لا يُكشَف",62,"ف",1,0],["كشفت الضرّ عنهم بعد يأسٍ","وأحييت الرميم من الرجاء",63,"ا",2,0],[