ViewPoem.aspx?id=22059",""],[51,"وقائلة ٍ بالنَّصْح لمْ لا تَزوَّجُ","https://www.poetsgate.com/ViewPoem.aspx?id=27242",""],[99,"الى صديقة جديدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=347&r=&rc=53",""]],"verses":[["كَشَفوا الغِطاءَ عَنِ العُيونِ فَأَبصَروا","ما في الكِنانَةِ مِن أَذىً وَضِرارِ",0,"ر",1,0],["كَشَفنا عَن نَواياكُم فَلَستُم","وَقَد بَرِحَ الخَفاءُ مُحايِدينا",1,"ن",2,0],["كَشَفوا عَن نِيَّةِ الغَربِ لَنا","وَجَلَوا عَن أُفُقِ الشَرقِ الظَلاما",2,"م",2,0],["كَشَفتَ أَبا بَدرٍ إِذا القَومُ أَحجَموا","وَغَضَّت مَلاقي مَرهِم بِالمُخَنَّقِ",3,"ق",1,0],["كَشَفَتْ مُفَاجَأَةُ الرَّزِيئَة سِتْرَهَا","وَانْتِيبَ مَأَلَفُ عِزِّهَا بِهَوَانِ",4,"ن",1,0],["كَشْفُ المَظَالِمِ لا يُرَامُ إِذَا","مَا رُمْتَهُ مِنْ كَفِّ مُهْتَضَمِ",5,"م",1,0],["كشفت به ما كان من حجب العمى","عنكم نظيَرة بنت زين الدين",6,"ن",1,0],["كشَبوبٍ ذي كبرياءَ من الوِحْ","دة لا يبتغي عليها ظهيرا",7,"ر",2,1],["كَشِيعَتِهِ والحَربُ قَد ثُفِّيَت","لها أمَامَهم قِدرٌ يَجِيشُ وَمِرجَلُ",8,"ل",1,0],["كَشَفنَا الجُوع ذَا الهبواتِ عنهُم","وأَطعمنَا ضَرائِكَ تَعتَرِينَا",9,"ن",2,0],["كَشَفتُ بِهِ صُدورَ الخَيلِ عَنّي","كَما جَفَّلتَ في بيدٍ نَعاما",10,"م",2,0],["كشفَتْ منك حاجتي هَنواتٍ","غُطِّيتْ برهةً بحسن اللقاءِ",11,"ا",2,0],["كَشَيْخٍ رأيناه تزوَّج آنِفاً","فأمسى وما داناه كسرى المتوَّجُ",12,"ج",1,0],["كشارب الآجن الأجاج من ال","ماء فما ازداد غيرَ إعطاش",13,"ش",1,0],["كشَّفتُ منه ثيابه عن سوءة","شوهاء شقت عن عجان أعرف",14,"ف",1,0],["كشجى الحلق لا يسوغ ولا يل","فظ بين اللُّهى وبين التراقي",15,"ق",2,0],["كشف الوعدَ من نتائج صدقٍ","مُعجلاتٍ لم تَضْوَ في الإعجالِ",16,"ل",1,0],["كشهريٍّ لديك ومعشريٍّ","طفيليَّينِ شأنُهما الوُغولُ",17,"ل",1,0],["كَشَفنا عَنهُمُ نَزَواتِ قَيسٍ","وَمِثلُ جُموعِنا مَنَعَ الذِمارا",18,"ر",2,0],["كَشَفتَ غِطاءَ الكُفرِ عَنّا وَأَقلَعَت","زَلازِلُهُ لَمّا وَضَعتَ المَراسِيا",19,"ي",2,0],["كَشّافَةُ مِصرَ وَصِبيَتُها","وَمُناةُ الدارِ وَمُنيَتُها",20,"ه",2,0],["كَشَفتُ بِهِ الحَياةَ فَلَم أَجِدها","وَلَمحَةَ مائِها إِلّا خِداعا",21,"ع",2,0],["كُشِفَ الغَطاءُ لَهُ فَكُلُّ عِبارَةٍ","في طَيِّها لِلقارِئينَ ضَميرُ",22,"ر",1,0],["كَشَفَ الغَطاءُ عَنِ الطُرولِ وَأَشرَقَت","مِنهُ الطَبيعَةُ غَيرَ ذاتِ سِتارِ",23,"ر",1,0],["كَشَهادَتي للّهِ خالِصَةً","قبلَ العِيَانِ بأنّهُ رَبُّ",24,"ب",1,0],["كَشَّفتُ جَمهَرَةَ العِبادِ فَلَم أَجِد","إِلّا مَسوداً جَنبَهُ مَرؤوسا",25,"س",2,0],["كَشَفَت ثَلاثَ ذَوائِبٍ مِن شَعرِها","في لَيلَةٍ فَأَرَت لَيالِيَ أَربَعا",26,"ع",2,0],["كَشَفَت لَنا سَيَرُ الأَميرِ مُحَمَّدٍ","عَن أَمرِ ناهٍ بِالسَدادِ وَآمِرِ",27,"ر",1,0],["كَشَفوا بِتَلِّ كُشافَ أَروِقَةَ الدُجى","عَن عارِضٍ مَلَأَ السَماءَ بُروقا",28,"ق",2,0],["كَشِفاءِ السَقامِ في عُقبِ يَأسٍ","مِن تَلافيهِ أَو شِفاءِ الغَليلِ",29,"ل",1,0],["كَشَفتَ عَنِ الأَبصارِ كُلَّ عَشاً بِها","وَكُلُّ قَضاءٍ جائِرٍ أَنتَ عادِلُه",30,"ل",2,1],["كشَمْسٍ سالَمتْ ظُلَماً","وغُصْنٍ حاملٍ عَنَما",31,"م",2,0],["كَشَفَ الصَّباحُ قِناعَهُ فتألَّقا","وسَطا على اللَّيلِ البَهيمِ فأشرَقا",32,"ق",2,1],["كشاطرٍ هَمَّ بالعدوِّ فَما","أقصرَ حتى رأى دماً جاري",33,"ر",2,0],["كَشِيمَةِ العُودِ ما زالَتْ بلا سببٍ","تُهدِي إلى العُودِ إحراقاً وإيقادا",34,"د",2,0],["كَشاةِ الإِرانِ الأَعفَرِ اِنضَرَجَت لَهُ","كِلابٌ رَآها مِن بَعيدٍ فَأَحضَرا",35,"ر",2,0],["كَشَفتُ أَخلاقَ الرِجا","لِ وَخُقتُهُم جيلاً فَجيلَ",36,"ل",1,0],["كَشَمسٍ بِأُفقٍ فَوقَ بَرقٍ بِكَفِّهِ","هِلالٌ رَمى في اللَيلِ جِنّاً بِأَنجُمِ",37,"م",1,0],["كَشَفتُ خِمارَ الصَونِ عَن حُرِّ وَجهِها","ضُحىً وَلِثامُ الصُبحِ في الشَرقِ طائِحُ",38,"ح",1,0],["كشفت لعينينا وقد ومضت","ظلين معتنقين في السور",39,"ر",1,0],["كشفتَ لها ساقاً وكنتَ لكشفها","تَحزّ الهوادي أو تجزّ النواصيا",40,"ي",2,0],["كَشّرَ الدهر عن حِدادِ نُيوبٍ","أكلَتهُمْ بكلّ قَضْمٍ وَخَضْمِ",41,"م",1,0],["كشفتَ كروباً عن قلوبٍ كأنّما","وَضَعْتَ عَلَيْها من هواك خواتما",42,"م",2,0],["كَشَفتُ قِناعَ الشِعرِ عَن حُرِّ وَجهِهِ","وَطَيَّرتُهُ عَن وَكرِهِ وَهوَ واقِعُ",43,"ع",1,0],["كَشَّفَتكَ الأَيّامُ يا إِنسانُ","لا يَكُن لِلَّذي أَهَنتَ الهَوانُ",44,"ن",1,1],["كُشِفَ الغِطاءُ فَأَوقِدي أَو أَخمِدي","لَم تَكمَدي فَظَنَنتِ أَن لَم يَكمَدِ",45,"د",1,1],["كَشَقيقَةِ البُردِ المُنَمنَمِ وَشيُهُ","في أَرضِ مَهرَةَ أَو بِلادِ تَزيدِ",46,"د",1,0],["كَشَفَ الرَوضُ رَأسَهُ وَاِستَسَرَّ ال","مَحلُ مِنها كَما اِستَسَرَّ المُريبُ",47,"ب",1,0],["كشفتُ بأمسِ وجهَ غدٍ رهيب","ماطت عنه قافيةً شرودُ",48,"د",1,0],["كَشَفَت لَهُ الأَيّامُ عَن أَسرارِها","فَرأى جَلِيَّ عَواقِبِ الأَشياءِ",49,"ا",2,0],["كُشِفَ الغِطاءُ إِلَيكَ عَن سِرِّ الرَدى","فَأَجِب بِما تَندى بِهِ الأَكبادُ",50,"د",1,0],["كشفت آياتُها الكُبرى لنا","عن أعاجيبَ تناهَت عِظَما",51,"م",2,0],["كشفَ الظّلامَ عن القُلوبِ فأبصرَتْ","وبدا المُغيَّبُ واضحاً معروفا",52,"ف",2,0],["كشفَ التّجريبُ عن سَوْآتِها","ومضَتْ عاريةً ما تَحتشِمْ",53,"م",1,0],["كشفوا الظّلامَ فهم نُجومُ هدايةٍ","وَرَستْ جوانبُهم فهم أطوادُ",54,"د",1,0],["كَشَفَ الحِدثانُ عَن مَكنونِها","فَأَزالَ الشَكَّ عَن وَجهِ اليَقينْ",55,"ن",1,0],["كَشَفوا الضُرَّ عَنِ المُستَضعَفينْ","وَأَذاقوهُم أَفاويقَ النِعَمْ",56,"م",1,0],["كَشَفوا عَنِ العِلمِ الغِطاءَ وَأَدرَكوا","سِرَّ التَفَوُّقِ فيهِ وَالرَجَحانِ",57,"ن",1,0],["كَشَفَ العُنوانُ عَمّا تَحتَهُ","مِن أُمورٍ ما أَراها تُجهَلُ",58,"ل",1,0],["كشف الكِتابُ عَن المَحجَّةِ فَانظُروا","وَأَرى المحجّة عِندَكُم أَن تَصدِفوا",59,"ف",3,0],["كَشَفَ اللهُ له عما انْطَوى","في زوايا الغيبِ عنه فَظَهَرْ",60,"ر",1,0],["كُشِفَ اللِثامُ عن اليقينِ ولن تَرى","كالجهلِ سِتراً والغرورِ لِثاما",61,"م",2,0],["كشفَ الغطاءَ عن النِّفاقِ بسورةٍ","نزلتْ وكان غطاؤُه لا يُكشَف",62,"ف",1,0],["كشفت الضرّ عنهم بعد يأسٍ","وأحييت الرميم من الرجاء",63,"ا",2,0],["كُشفَتْ منكُم المقاتلُ وامتد","دتْ إليها المثقفاتُ قناها",64,"ا",3,0],["كَشَرَرِ القَدحِ إِذا ما اِرفَضّا","يُدمِنُ إِسخاطَكَ حَتّى تَرضى",65,"ض",2,0],["كُشِفَ الغِطاءُ لهُ وقد أُسْرِي به","فعُلُومُهُ لا شيءَ عنها يَعزُبُ",66,"ب",1,0],["كَشَفَتْ لهُ الأَسْماعُ عَنْ أَسرارِها","فإذَا الوُجُودُ لِمقْلَتَيهِ بِمَرْصَدِ",67,"د",1,0],["كُشِفَ الغِطَاءُ لهُ فليسَ كحائرٍ","في دينِهِ مِنْ أَمْرِهِ مُتَرَدّدِ",68,"د",1,0],["كُشِفَت عَنهُ خُزوزٌ","وَعَنِ الخَزِّ بُرودُ",69,"د",1,0],["كَشَفتُ خَبيآتِ الأُمورِ وَأَدرَكَت","يَدي فَلَتاتِ الرَأيِ في مُبتَدا الأَمرِ",70,"ر",1,0],["كشفتُ قناعَها فإذا عجوزٌ","مسودةُ المفارقِ بالخضابِ",71,"ب",1,0],["كَشاكِيَةٍ مِن عَينِها غَربَ قُرحَةٍ","تَداوى بِما تَدوى عَلَيهِ وَتَذرَبُ",72,"ب",1,0],["كَشَفتَ عَن مَرتَعٍ دُجُنَّتَهُ","عَوداً وَكُنتَ الطَبيبَ مِن وَصَبِه",73,"ب",2,0],["كَشفِيَ رَأسي وَاِفتِقاري بِها","خَيرٌ مِنَ التَمليكِ وَالتاجِ",74,"ج",1,0],["كَشَّفتُ عَمّا تَقولُ مُجتَهِداً","لَعَلَّ حَقّاً لِطالِبٍ يَضَحُ",75,"ح",1,0],["كشارعٍ رصفوه","بأَلف مَليون درَّه",76,"ه",1,0],["كُشفت بهم غماؤها","وأُحيل بؤس العيش رغدا",77,"د",2,0],["كشفتُ بأمسِ وجهَ غدٍ رهيبٍ","أماطت عنه قافيةٌ شرود",78,"د",1,0],["كشفت جمهرة العباد فلم أجد","إلا مسوداً جنبه مرءوسا",79,"س",2,0],["كشفتْ عن جمالها كلَّ خافٍ","وأباحتْ لهنّ ما لا يُباحُ",80,"ح",1,0],["كشفت لي الصحراءُ من دوِّها الوا","سع ما لاتحدُّهُ نظراتي",81,"ي",1,0],["كشاعرٍ في سماء الفكر مختبىءٍ","دلّ الوجود عليه لحنُه العالي",82,"ي",1,0],["كشمسِ الضّحى أُولاه في النور عندكمْ","وأُخرَاهُ نارٌ في فُؤادي وأضْلُعي",83,"ع",2,0],["كَشفتُ سَماءَ المَجدِ عنكَ فَلَم أَجِد","سوى كَرمٍ عَن طيبِ خيمكَ يَنطِقُ",84,"ق",1,0],["كشَفَ الْفجْرُ عَنْ جنَادِلَ سُودٍ","ضَمَّهَا الغَمْرُ مِنْ بَنَاتِ ثَبِيرِ",85,"ر",1,0],["كَشَفْتَ ظَلاَمَ الشَّكِّ عَنْ وَجْهِ حُبِّهِ","فَلاَحَ كَبَدْرِ التَّمِّ وَاللَّيْلُ أَلْيَلُ",86,"ل",1,0],["كَشَفَ اللِّثَامَ عَنِ الحَقِيقَةِ فَانْجَلَتْ","تَعْدِي الضَّيَاءَ عَلَى الظَّلاَمِ الهَارِبِ",87,"ب",1,0],["كَشَفَ الأَسَى لَهُمُ الحِجَابَ فَأَيْقَنُوا","أَنَّ الحَيَاةَ مَطَالِبٌ وَمَعَالِي",88,"ل",2,0],["كشمائلِ النبعِ الكريمِ","متى نزلتَ به سقاك",89,"ك",1,0],["كَشَفتَ إِلَيَّ الغَيبَ يا اِبني وَلَم تَخب","وَلكِنَّ عَقلي دَلَّني فَهَداني",90,"ن",2,0],["كَشَفَت ستري بِما كَسَفَتهُ","مِن مُحيّاكَ البَهيجِ البَهِيِّ",91,"ي",1,0],["كَشَفتُ قِناعي فيكَ يا رَشَأَ الفَلا","وَما كُنتُ أَرضى قَبلَ عَينَيكَ بِالهَتكِ",92,"ك",1,0],["كشفت عيوبك مثل ما","كشف الظلامَ المَقْبس",93,"س",1,0],["كَشَفَتْ عَنِ النفْسِ الْمَلُولِ حِجابَها","فَتَوَجَّهَتْ لِلْخَالِقِ الْفَتَّاحِ",94,"ح",1,0],["كشفَتْ قضيةُ مصرَ ثوبَ ريائهم","يا للرياء وثوبِه الشَّفَّاف!",95,"ف",1,0],["كشَّرت عن أنيابها للبرايا","فرأوا ذلك القطوب ابتساما",96,"م",2,0],["كَشَفْتُمْ إن تكونوا قد كشفتم","لَقًى في الجوِّ، ليس له اعتبار",97,"ر",1,0],["كشفتم ذرَّةً سبحت بأُفق","فسيحِ السَّاحِ ليس له انحصار",97,"ر",1,0],["كشفتَ لهُ ضَعْفاً وغطَّيْتَ قُوَّةً","فكنتَ ، ولولا خُدعةٌ لم تكن ، خِبَّا",98,"ب",2,0],["كشأنِ \" زيادٍ \" حين أُحرجَ صدرُهُ","وضُويقَ حتى قال خُطبتَه البترا",99,"ر",2,0],["كَشِفَاءِ السّقامِ في عُقْبِ يأسٍ","مِنْ تَلاَقيهِ أوْ شِفَاءِ الغَلِيلِ",100,"ل",1,0],["كَشَفْتَ أبا بَدْرٍ إذا القَوْمُ أحْجَمُوا","وعَضَّتْ مَلاَقي أمْرِهِمْ بالمُخَنَّقِ",101,"ق",1,0],["كَشَيْخ رأيناه تزوَّج آنِفاً","فأَمسى وما دناه كسرى المتوَّجُ",102,"ج",1,0],["كشفتُ أوراقي فلا تُراعي","لن تجدي أطهرَ من ما عندي من شرور",103,"ر",1,0]]}