{"poems":[[87,"يموت في الغاب أو في غيره الأسد","https://www.aldiwan.net/poem62890.html","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86997","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87203","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86855","الوافر"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137602",""],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75743","الوافر"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64483","الطويل"],[1426,"","https://poetry.dctabudhabi.ae/diwan/poem/124625","الوافر"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114038","الوافر"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52047","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89539","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27491","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94561","الطويل"],[4767,"وزير الفكر","https://www.poetsgate.com/ViewPoem.aspx?id=178353",""],[6236,"مرثية حلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81709&r=&rc=17",""]],"verses":[["وَفي أَواسيهِ أَقلامٌ مُجاهِدَةٌ","عَلى أَسِنَّتِها الإِحسانُ وَالسَدَدُ",0,"د",1,0],["وَفي أَواخر شَوالٍ نَعيمك لا","يَبقى وَسَهم المَنايا نافذ فيكا",1,"ك",2,0],["وَفي أواخر شَوال يَزول وَلا","يَبقى وَسَهمُ المَنايا نافذ فيهِ",2,"ف",3,0],["وَفي أَوطانه أَنشا قِلاعاً","مَدافعُها عَلى الباغي سَعير",3,"ر",1,0],["وفي أول الشط تلقى المباني","صفوفا مطوّقة بالجنان",4,"ن",1,1],["وَفي أَوصافك الانشاء يَحلو","وَفي أَفضالك الخير المؤكد",5,"د",1,0],["وفي أوجه الأسماء ما أنت واجد","به في مقامات الشهود تجلت",6,"ت",1,0],["وفي أوساطه كاسات خمر","كنار اضرمت في ماء خد",7,"د",1,0],["وفي أوج السعادة والمعالي","ترقّى نيّران ونَيّران",8,"ن",1,0],["وفي أوجِهَا حَيثُ الكُوى مِنهَا أو مَأتْ","إلى الشَّمسِ قُدسُ الله في قَلبها يَندْوُ",9,"د",2,0],["وَفي أَوانِ اِغتِرابِ الدينِ كانَ لَكُم","مَشاهِدٌ أَصلَحَت ما كانَ مِن خَلِلِ",10,"ل",1,0],["وفي أوامره إن كنت ذا بصر","سِرٌ عجيبٌ ولكن غير منكشفْ",11,"ف",1,0],["وفي أوج بيروتٍ شدا الأوج صادحٌ","براشدها إذ جاء للرشد مُرشدا",12,"د",2,0],["وفي أوراق جعبته","بما قد شاء كم سطر",13,"ر",1,0],["وفى أورشليم نبوءةُ عيسى...","ومَرْيَم تَحبو.... تَهُزُّ النَّخيلْ",14,"ل",1,0]]}