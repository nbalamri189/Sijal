{"poems":[[55,"أبكيك لو نقع الغليل بكائي","https://www.aldiwan.net/poem30779.html","الكامل"],[88,"يرغي ويزبد بالقافات تحسبها","https://www.aldiwan.net/poem68854.html","البسيط"],[63,"صب بغرات الصبا مكلف","https://www.aldiwan.net/poem51549.html","الرجز"],[303,"عجبت للبحر يطغى ثم ينقبض","https://www.aldiwan.net/poem36837.html","البسيط"],[303,"عاطيتني السحر أم صرفا من الراح؟","https://www.aldiwan.net/poem36844.html","عموديه"],[422,"دعاه إلى الهوى داعي التصابي","https://www.aldiwan.net/poem54151.html","الوافر"],[463,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48727","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46569","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101046","الكامل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130773","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89385","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62840","السريع"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102005","الكامل"],[5615,"آهات .....!","https://www.poetsgate.com/ViewPoem.aspx?id=193282",""],[5956,"صرخة أهل فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192087",""]],"verses":[["يَرغو رُغاءَ العودِ جَعجَعَهُ السُرى","وَيَنوءُ نَوءَ المُقرِبِ العُشَراءِ",0,"ا",2,0],["يُرغي وَيُزبِدُ بِالقافاتِ تَحسَبُها","قَصفَ المَدافِعِ في أُفقِ البَساتينِ",1,"ن",1,1],["يُرغِمُ مَنْ يَلْحى ومَنْ يُعَنِّفُ","تَشوقُه حتَّى يَكادَ يَتْلفُ",2,"ف",1,0],["يرغو ويُزبد هدَّاراً ومصطخباً","ويزْبئرُ وقد ينزو وقد يغض",3,"ض",1,0],["يرغو وَيزيد منهلاً بكوكبةٍ","من نابلٍ إِثرَ سيّافٍ وَرمّاح",4,"ح",1,0],["يرغّب فضله الفضلاء فيه","ويطمعهم بأيديه الرغاب",5,"ب",1,0],["يرغبُ في الظلماءِ مستأنساً","وجانبُ الظلماءِ مرهوبُ",6,"ب",1,0],["يرغي ويزبد ناقماً متحرقاً","حنقاً ولو عرك الأمور لدارى",7,"ر",2,0],["يَرغب فيهِ الفاضل","وَيَحتويه الجاهل",8,"ل",1,0],["يرغي ويزبد في الكتيبة منذراً","بالويل أهل سكينةٍ وسلام",9,"م",1,0],["يرغبن في كل المشاهد جملةً","حتى المعيب وما لهن إباء",10,"ا",2,0],["يرَّغبني في زرع أرض رديئةٍ","يقول بهذي الأرض ينجح كتّان",11,"ن",1,0],["يرغب عن جِدَّةِ أَثوابِهِ","كالسَّيفِ لا يَرضى يَد الغَامِدِ",12,"د",1,0],["يرغوا رغاء النيب مما ناله","أمد المدى في ليله ونهاره",13,"ر",2,0],["يُرغِمُها أَنَّ تَذِلَّ رَاضِخَةً","لِحُكمِهِ ، والرُّضُوخُ يُفسِدُهَا",14,"د",3,0],["يرغب الناس انكساراً بدلاً","من عذاب النصر حفَّارِ الفنا",15,"ن",2,0]]}