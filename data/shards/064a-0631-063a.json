{"poems":[[55,"أبكيك لو نقع الغليل بكائي","https://www.aldiwan.net/poem30779.html","الكامل"],[88,"يرغي ويزبد بالقافات تحسبها","https://www.aldiwan.net/poem68854.html","البسيط"],[63,"صب بغرات الصبا مكلف","https://www.aldiwan.net/poem51549.html","الرجز"],[302,"عجبت للبحر يطغى ثم ينقبض","https://www.aldiwan.net/poem36837.html","البسيط"],[302,"عاطيتني السحر أم صرفا من الراح؟","https://www.aldiwan.net/poem36844.html","عموديه"],[420,"دعاه إلى الهوى داعي التصابي","https://www.aldiwan.net/poem54151.html","الوافر"],[461,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"]],"verses":[["يَرغو رُغاءَ العودِ جَعجَعَهُ السُرى","وَيَنوءُ نَوءَ المُقرِبِ العُشَراءِ",0,"ا",2,0],["يُرغي وَيُزبِدُ بِالقافاتِ تَحسَبُها","قَصفَ المَدافِعِ في أُفقِ البَساتينِ",1,"ن",1,1],["يُرغِمُ مَنْ يَلْحى ومَنْ يُعَنِّفُ","تَشوقُه حتَّى يَكادَ يَتْلفُ",2,"ف",1,0],["يرغو ويُزبد هدَّاراً ومصطخباً","ويزْبئرُ وقد ينزو وقد يغض",3,"ض",1,0],["يرغو وَيزيد منهلاً بكوكبةٍ","من نابلٍ إِثرَ سيّافٍ وَرمّاح",4,"ح",1,0],["يرغّب فضله الفضلاء فيه","ويطمعهم بأيديه الرغاب",5,"ب",1,0],["يرغبُ في الظلماءِ مستأنساً","وجانبُ الظلماءِ مرهوبُ",6,"ب",1,0]]}