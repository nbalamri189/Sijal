ml","مجزوء الكامل"],[270,"لما رأيت البز والشاره","https://www.aldiwan.net/poem26749.html","الرجز"],[271,"عودي الى ماضيك يا بغداد","https://www.aldiwan.net/poem35650.html","الكامل"],[276,"لمن وقعة بالغرب ضعضعت الشرقا","https://www.aldiwan.net/poem25477.html","الطويل"],[276,"أسوسنة أم عيبة لسلاح","https://www.aldiwan.net/poem25595.html","الطويل"],[281,"أسوم الجباب فلا خزها","https://www.aldiwan.net/poem60593.html","الطويل"],[306,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[343,"ما بين اخفاق حبي","https://www.aldiwan.net/poem55335.html","المجتث"],[343,"أو ما رأيت إلى شئونه","https://www.aldiwan.net/poem55342.html","مجزوء الكامل"],[360,"أتى من أريج النصر ما يشرح الصدرا","https://www.aldiwan.net/poem810.html",""],[365,"دام علاء العماد","https://www.aldiwan.net/poem60952.html","مجزوء السريع"],[367,"أسوف فيك النفس لا بل أساوف","https://www.aldiwan.net/poem17040.html","الطويل"],[403,"أتعزي في المصاب","https://www.aldiwan.net/poem46436.html","مجزوء الرمل"],[404,"أسواك إن حلت بنا اللوآء","https://www.aldiwan.net/poem34179.html","الكامل"],[404,"القلب أعلم يا عذول بدائه","https://www.aldiwan.net/poem34180.html","الكامل"],[410,"بنفسي عذول لام فيكم فرد لي","https://www.aldiwan.net/poem32387.html","الطويل"],[417,"سقاها الهوى من راحة الوجد صرخدا","https://www.aldiwan.net/poem54030.html","الطويل"],[417,"ليالينا على الجرعاء عودي","https://www.aldiwan.net/poem54070.html","الوافر"],[438,"أضر بي إذا جد في كعبه","https://www.aldiwan.net/poem2591.html","المنسرح"],[438,"أحقا صددت وخنت الودادا","https://www.aldiwan.net/poem2615.html","المتقارب"],[440,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[440,"هنيئا لهذا الدهر روح وريحان","https://www.aldiwan.net/poem34894.html","الطويل"],[442,"على الذنب لي قلب شجاع مجرب","https://www.aldiwan.net/poem14379.html","الطويل"],[453,"بكرت عنادل روضنا","https://www.aldiwan.net/poem13633.html","مجزوء الكامل"],[453,"بكرت عنادل روضنا","https://www.aldiwan.net/poem13751.html","مجزوء الكامل"],[459,"سوى رسني قاده الباطل","https://www.aldiwan.net/poem55975.html","المتقارب"],[459,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[462,"خذوا من ذمامي عدة للعواقب","https://www.aldiwan.net/poem15082.html","الطويل"],[465,"وجميل الأخلاق غير جميل","https://www.aldiwan.net/poem3156.html","عموديه"],[465,"قف أن وقفت فذاك وادي المنحى","https://www.aldiwan.net/poem3179.html","عموديه"],[465,"أشرب على ورد الخدود وغنني","https://www.aldiwan.net/poem3431.html","عموديه"],[478,"رضيت بربقة العشاق حبسا","https://www.aldiwan.net/poem15212.html","الوافر"],[478,"عشية عجنا بالمطي الرواسم","https://www.aldiwan.net/poem15247.html","الطويل"],[478,"أفي كل يوم عبرة لك تهمع","https://www.aldiwan.net/poem15272.html","الطويل"],[478,"نسيم عن الأحباب هب معطرا","https://www.aldiwan.net/poem15294.html","الطويل"],[515,"بقيت بقاء الدهر يا بهجة الدهر","https://www.aldiwan.net/poem20808.html","الطويل"],[515,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[515,"إلى الله نشكو فادحات النوائب","https://www.aldiwan.net/poem20840.html","الطويل"],[562,"لقد وجدتم مصعبا مستصعبا","https://www.aldiwan.net/poem27829.html","الرجز"],[563,"للشعر في كل عصر مركب خشن","https://www.aldiwan.net/poem52868.html","البسيط"],[568,"يا رب مهد هدية لطفت","https://www.aldiwan.net/poem69550.html","المنسرح"],[576,"أخبروني عن مرهف القد مطبو","https://www.aldiwan.net/poem2698.html","الخفيف"]],"verses":[["أَسومُ الهَوى نَفساً عَزوفاً عَنِ الهَوى","وَقَلباً لِضَيمِ الحُبِّ غَيرَ قَبولِ",0,"ل",1,0],["أَسوانُ يُفتِقُ صَبرُهُ إِفتاقَةً","أَمَماً وَبِغَمزُ بِالجَوى فَيَغيبُ",1,"ب",1,0],["أُسودُ غابٍ وَلَكِن لا نُيوبَ لَهُم","إِلّا الأَسِنَّةُ وَالهِندِيَّةُ القُضُبُ",2,"ب",1,0],["أسْوارُ مِكْناسةٍ مُرقّعَةٌ","كأنّها منْ ثِيابِ أهْليها",3,"ه",2,1],["أُسودُ سُروجٍ أو بُدورُ أسِرّةٍ","فإنْ حارَبوا راعُوا وإن سالَموا راقُوا",4,"ق",3,0],["أُسودٌ عَلى البُسفورِ تَحمي عَرينَها","وَتَرعى نِيامَ الشَرقِ وَالغَربُ يَرقُبُ",5,"ب",1,0],["أُسودُ وَغىً لَولا قِراعُ سيوفنا","لَما رَكِبوا قَيداً وَلا سَكَنوا سِجنا",6,"ن",2,0],["أُسودٌ بَوادي ذي حَماسٍ خَوادِرٌ","حَوانٍ عَلى الأَشبالِ محمىً عَرينها",7,"ن",3,0],["أسود اللون غير أن عليه","رونقاً مثلما أضاء النهار",8,"ر",1,0],["أَسوَدٌ إِذا ما كانَ يَومُ وَليمَةٍ","وَلَكِنَّهُم يَومَ اللِقاءِ ثَعالِبُ",9,"ب",1,1],["أسوَدُ هَتَّاكٌ لأَعرَاضِ مَن","مَرَّ على الأَبوَابِ أَو سَلَّمَا",10,"م",2,0],["أَسودٌ إِذا ما أَبدَتِ الحَربُ ساقَها","وَفي سائِرِ الدَهرِ الغُيوثُ المَواطِرُ",11,"ر",1,0],["أسود وغىً تأبى الحياة ذَمِيمةً","وتلبس بالعزّ الرَدىَ وهو أكْفان",12,"ن",1,0],["أُسَوَّدُ ساداتِ العَشيرَةِ عارِف","وَمِن دونِ قَومي في الشَدائِدِ مِذوَدا",13,"د",2,0],["أَسوَدُ صَيّاحٌ كَريمٌ كُرَّزُ","مُطَرَّزٌ مُكَحَّلٌ مُلَزَّزُ",14,"ز",1,0],["آسٌ ووردٌ دعا خدَّام دمعيَ إذ","لباهما لؤلؤي قدماً ومرجاني",15,"ن",2,0],["أسوده ذو غرَّة في الصدر","كأنه نور الهدى في الكفرِ",16,"ر",1,0],["أسُوءُ الرأي في ابن أبي وأمِّي","نصيبي من عطاياكَ الرغابِ",17,"ب",1,0],["أسوغُ لخلّاني مساغَ شرابِهِمْ","ويلقانيَ الأعداءُ كالحنظل الغضّ",18,"ض",1,1],["أسومُكَ ما يسومُ العبدُ مثلي","مَليكاً من بني الأملاك مثلَكْ",19,"ك",1,1],["أسومُكَ أن تدرَّ عليَّ رزقي","وتنبذَ خِدمتي لتُبينَ فضلَكْ",19,"ك",1,0],["أَسِواراً أَم دُمُلجاً مِن نُضارٍ","لا أُحِبُّ القُيودَ في مِعصَمَيكِ",20,"ك",1,0],["أسود الترك هبى ثم هبى","وهزى الأرض في شرق وغرب",21,"ب",1,0],["أَسِواكَ مِن أَهلِ المَبادِىءِ مَن دَعا","لِلجِدِّ أَو جَمَعَ القُلوبَ النُفَّرا",22,"ر",2,0],["أَسوا العَواقِبِ يَأسٌ قَبلَهُ أَمَلٌ","وَأَعضَلُ الداءِ نَكسٌ بَعدَ إِبلالِ",23,"ل",1,0],["أُسودٌ أُطعِمَت ظَفَراً فَعادَت","بِقَسرٍ لِلأَعادي وَاِهتِضامِ",24,"م",1,0],["أُسودٌ يَفِرُّ المَوتُ مِنهُم مَهابَةً","إِذا فَرَّ مِنهُ كُلُّ أَروَعَ صارِمِ",25,"م",1,0],["إِسوَةٌ لِلَصَديقِ تَدنو إِلَيهِ","عَن مَحَلٍّ في النَيلِ عالٍ رَفيعِ",26,"ع",1,0],["أُسودُ لِقاءٍ مِن تَميمٍ سَمَت لَهُم","سَريعٌ إِلى وَلغِ الدِماءِ وَرودُها",27,"د",3,0],["أَسوقُ إِلى البَحرِ الخَضَمِّ جَواهِري","وَأُهدي إِلى أَبناءِ بابِلَ مِن سِحري",28,"ر",2,0],["أُسودٌ تَغانَت بِالقَنا عَن عَرينِها","وَبِالبيضِ عَن أَنيابِها وَالمَخالِبِ",29,"ب",1,0],["أسود اللمة يح","سبُه الناسُ غلامَا",30,"م",2,0],["أَسوَدَ نَضّاحَ المَقَدِّ جَعدا","وَنَحنُ كُنّا لِلنَبِيِّ جُندا",31,"د",2,0],["اسودَّتِ الشهباءُ في","عينيَّ مِنْ رممٍ وغشِ",32,"ش",1,1],["اِسوَدَّ وَاِبيَضَّ فِعلُهُ كَرَماً","فَاِلتَفَتَ الحُسنُ فيهِ عَن حَوَرِ",33,"ر",1,0],["أُسودٌ عَلى المُستَضعَفينَ ثَعالِبٌ","تَروغُ إِذا هَبَّ القَوِيُّ المُواثِبُ",34,"ب",1,0],["أَسوءُ سَريرَةٍ وَخَبالُ قَلبٍ","وَلُؤمُ غَريزَةٍ وَفَسادُ عِرقِ",35,"ق",1,0],["أسِواهم أبتغي يومَ النَّدى","أم سواهم أرتجي يومَ المَعاد",36,"د",1,0],["أَسوَدُ القَلبِ أَسوَدٌ وَمَتى ما","تُصغِ أُذني فَأُذنُهُ صَمّاءُ",37,"م",3,0],["أُسُودُ الدَهرِ تَفرِسُ كُلَّ حَيٍّ","وَنَحنُ الآنَ أَجرٍ في اِحتِراشِ",38,"ش",1,0],["أَسوِئ بِحالِ الظَبيِ وَهوَ مُرَبَّبٌ","في الإِنسِ يَمرَحُ في حُلىً وَجَلاجِلِ",39,"ل",1,0],["أَسوانُ أَنتَ لِأَنَّ الحَيَّ نِيَّتُهُم","أَسوانُ أَيُّ عَذابٍ دونَ عيذابِ",40,"ب",1,1],["أُسُودٌ لَدَى الأَبْيَاتِ بَيْنَ نسَائِهِمْ","وَلَكِنَّهُمْ عِنْدَ الْهيَاجِ نَقَانِقُ",41,"ق",1,0],["أُسُودٌ تُرَاقِبُ أَمْثَالَهَا","وَلاَ يَلْتَقُونَ عَلَى مَوْعِدِ",42,"د",1,0],["أُسْوَةً بِالْمَسِيحِ يَحْمِلُ حُباً","لأِخِيه وَلَيْسَ يَحْمِلُ حِقْدَا",43,"د",2,0],["أُسودُ الشَرى في الحَربِ تَحمي نُفوسها","بِنَجدَتِها ما لَم تعنَّ ظباءُ",44,"ا",2,0],["أُسَوَّدُ ساداتِ العَشيرَةِ عارِفاً","وَمِن دونِ قَومي في الشَدائِدِ مِذوَدا",45,"د",2,0],["أُسَوِّدُ وَجهي لِتَبيِضِها","وَأَهدِمُ كيسي لِعُمرانِها",46,"ن",3,0],["أسْوانُ تَعْرِفُهُ إذا اخْتَلَطَ الدُّجَى","بالنَّبْرَةِ السَّوْدَاءِ في أَنَّاتِه",47,"ت",2,0],["أسِوانا بزُبدة الكأسِ يحظَى","وكلانا من فضلة الكأس يُسقى؟",48,"ق",2,0],["أُسُودٌ أُطْعِمَتْ ظَفَراً، فعادتْ","بقَسْمٍ للأعادي، وَاهتِضَامِ",49,"م",1,0],["أسوار؟ أم دملجا من نضار؟","لا أحبّ القيود في معصميك",50,"ك",1,0],["أسودَهُ وأحمرَهْ","والواردَاتِ مِشْفَرَه",51,"ه",1,0],["أَسويت بَحراً بِالنَدى مُتَدفِقاً","وَبَدوت تَحكي البَدر غب دُجونِهِ",52,"ن",2,0],["أسودُ عَلى ما تَدعيهِ نُفوسَهُم","تمال إِذا عَدوا لِيَوم رِهانِ",53,"ن",1,1],["اسوق جنائبي والركب مضني","الى متكين للرحب السني",54,"ي",1,1],["أسود بميدان الوغى باع جدهم","طويل عنان يقطع البر والبحرا",55,"ر",2,0],["أسود وسادات سراه أماجد","مناقبهم جهراً نمت وسمت سرا",56,"ر",2,0],["أسوَدَ الفَرعِ أبلَجَ الوَجهِ بَر","قييَ المُحَيَّا ثُدِيُّهُ الرُّمَانُ",57,"ن",1,0],["أسودُ لكن سَيِّدٌ","وهو فَتًى وابنُ فَتَى",58,"ت",2,0],["أُسودُ وَغىً تُردي عِداها مَخافَةً","إِذا أَصبَحَت قُبُّ العِتاقِ بِهِم تَردي",59,"د",2,0],["أُسودٌ عَلى أُسدِ الكَرائِهِ قَد ضَروا","إِذا حوسِنوا سَرّوا وَإِن خوشِنوا ضَرّوا",60,"ر",3,0],["أُسودُ وغىً لِسُمر الخَط","طِ فيها معقل أشِبُ",61,"ب",1,0],["أَسَوَّغتُمُ الشّهدَ المَشورَ لِطاعِمٍ","وَقُلتُم حَرامٌ أَن يُلِمَّ بِهِ النَّحلُ",62,"ل",1,0],["أَسْودٌ في أحمرٍ تَحسَبُه","فَحَما في جَمْرِها الملتهِب",63,"ب",1,0],["أسودٌ في أَكُفِّهمُ صِلالٌ","لها نَهْشٌ تُميت به وعَض",64,"ض",1,0],["أسودُ وَغًى ولا ترتِضى نيلَ مكسب","وإنْ جَلَّ إلا مِن قناً وحُسام",65,"م",1,0],["أسوّف نفسي اليوم واليوم بعده","تعاليل مضنى لا يموت ولا يبرا",66,"ر",2,0],["اسود ظهور الاعوجية غابها","وآجامها ذاك الوشيج المقوم",67,"م",1,0],["اسود اسود الحرب من كل ابلج","طويل نجاد السيف معتقل لدنا",68,"ن",2,0],["اسودٌ ترى في كل يوم كتيبة","لبيضهم شكلا وسمرهم نهقطا",69,"ط",2,0],["أسودُ الأعادي تَلْتَقِيه مهابةً","فيتركُها خذلاء كالكلبِ تَلْهَثُ",70,"ث",1,0],["أسوت بما بينت داء قلوبنا","كما كنت تأسو قبل أوسا وخزرجا",71,"ج",2,0],["أَسوَدٌ كَاللَيلِ عَلى وَجنَةٍ","سُبحانَ مَن أَطلَعَ مِنها بِالنَهار",72,"ر",1,0],["أَسوانُ لا حَيُّ وَلا","مَيتٌ كَهَمزَةِ بَينَ بَينِ",73,"ن",1,0],["أَسوَدُ كَالسَفّودِ يُنسى لَدى","التَنّورِ بَل مِحراكُ قَيّارَه",74,"ر",2,0],["أسوارُ قسطنطينية شهدتكَ من","كثبٍ وملءَ جفونِها الإسهاد",75,"د",1,0],["أُسُودُ ولَكِنَّ الأُسُودَ حَقيقَةً","سُقاتُهُمُ صَرْفَ المَنِيةِ والزّنْقَا",76,"ق",2,0],["أسَوْسَنَةٌ أمْ عَيْبَة لِسِلاحِ","بَدَا كبُنُودٍ وَسْطَها ورِمَاحِ",77,"ح",1,1],["أَسُومُ الْجِبابَ فَلا خَزَّها","أُطِيقُ ابْتِياعاً وَلا صُوفَها",78,"ف",3,1],["أُسودُ ضراءٍ في عرينِ مكاحلٍ","تأبّطَ كلٌّ مِنهمُ حيّةً رَقطا",79,"ط",2,0],["اسوانُ بيعت حياتي","في السوق بيعة وكسِ",80,"س",1,0],["أسوان ينشد قلبه","وكأنه يحيا بدونه",81,"ن",2,0],["أسُود مصاليتٌ لدى حَومه الوغى","لأنَّهُمُو يوم الوغى الآيةُ الكبرى",82,"ر",2,0],["أَسواقُ أَشعارِنا","قد أَسْرفَتْ في الكساد",83,"د",1,0],["أُسَوِّفُ فيكَ النَفسَ لا بَل أُساوِفُ","وَأَصرِفُ عَنكَ العَينَ لا بَل أُصارِفُ",84,"ف",1,1],["أسوةٌ تُفضي إلى","خيرِ نعيمٍ وثوابِ",85,"ب",1,0],["أسِوَاك إن حلت بنا اللوّآء","يُدْعَى لها إنا إذاً جهلاء",86,"ا",2,1],["أسواه سوَّاها ضياءً نافعاً","لا والذي رفع السما ببنائه",87,"ا",3,0],["أسُوفُ صَعِيدَ الأرضِ إذ وافق اسمُه","صعيداً به أهلُ الحبيب نُزُولُ",88,"ل",1,0],["أَسودُ إذا ما كنتَ مولايَ في الورى","ومن كنتَ مولاه فلا زالَ سيِّدا",89,"د",2,0],["أُسودُ مواطن الهيجاء قومٌ","لهُم شَرَفُ العقول على الأُسود",90,"د",1,0],["أسوف مسكا ما بين أترابنا","فيه ونشر العبير من تربه",91,"ب",2,0],["أسوم ربيعا بواديهم","فألقى به صفرا أو جمادي",92,"د",2,0],["أُسُودٌ إذَا لاقَوْا وَطَيْرٌ إذا دُعُوا","أَيَامِنُهُمْ للمُعْتَدِينَ أَشَائِمُ",93,"م",1,0],["أُسودُ هِياجٍ مَا تزالُ تَرَاهُمُ","تطيرُ بِهِمْ نحوَ الكريهَةِ عِقبانُ",94,"ن",1,0],["أسوف أيام الشباب بتوبتي","لشيبي وشيبي بالمتاب مسوف",95,"ف",1,0],["أُسوَيْجعَ الألحان قد","غادرت قلبي في وجيب",96,"ب",1,0],["أسويجعَ الألحان قد","أوريت بي للشوق زندا",97,"د",2,0],["أُسودُ الكلام وما تسمعو","ن من غيرها نَعَمٌ جافل",98,"ل",1,0],["أسوِّفُ العيشَ حسنَ الظنِّ أجبرُهُ","على فسادٍ وجَبْرُ الظنِّ منكسرُ",99,"ر",1,0],["أسوداً إذا شبَّ الخميسُ ضِرامهُ","أسالوا نفوس الأسد فوقَ الثعالبِ",100,"ب",1,0],["أسودٌ شابَ شعرهُ فتراهُ","فحمةً تستشفُّ تحت رماد",101,"د",1,0],["أَسِواك للعلياءِ غابة همّهِ","ولمعتفيهِ ومادحيهِ ما اقتنى",102,"ن",2,0],["أسوانَ دلّهِ بالنَّوى بعد الهوى","فلو أنَّه وجد المنى لم يفطنِ",103,"ن",1,0],["أسوداً غيلُها المُرَّانُ سُمراً","تُظِلهمُ إلى الهيجاءِ مُلْسا",104,"س",2,0],["أسودٌ إذا هاجتْ ضراغمُ بيشةٍ","تلقَّيتُها منهم بمثلِ الضراغمِ",105,"م",1,0],["أسوفُ ثرى الأطلالِ فيها وهكذا","أخو الشوقِ مِن فرطِ الصبابةِ يصنعُ",106,"ع",1,0],["أسودٌ تخالُ السمهريةَ في الوغى","لها أُجُماً والمشرفيَّةَ أظفُرا",107,"ر",2,0],["أُسودُ كِفاحٍ بأسُهُم في رِما