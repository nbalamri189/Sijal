px?id=135390",""],[5198,"جنة احبابه","https://www.poetsgate.com/ViewPoem.aspx?id=136099",""],[5212,"وليدُ الكعبة","https://www.poetsgate.com/ViewPoem.aspx?id=212040",""],[5219,"المتهمة البريئة","https://www.poetsgate.com/ViewPoem.aspx?id=194914",""],[5277,"جودي بسانحةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=191154",""],[5302,"ما خانك الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=200065",""],[5370,"أول الطيش","https://www.poetsgate.com/ViewPoem.aspx?id=87445",""],[5370,"أعيش حره","https://www.poetsgate.com/ViewPoem.aspx?id=87421",""],[5397,"تطارحني الحمائم بالنواح","https://www.poetsgate.com/ViewPoem.aspx?id=157915",""],[5444,"زيتونة المسرى","https://www.poetsgate.com/ViewPoem.aspx?id=205084",""],[5573,"اسَواَر","https://www.poetsgate.com/ViewPoem.aspx?id=204611",""],[5652,"متى اشوفك للقى تحتويني ..!","https://www.poetsgate.com/ViewPoem.aspx?id=150376",""],[5664,"دعوة الغفران","https://www.poetsgate.com/ViewPoem.aspx?id=46525",""],[5680,"قريب على بعد أنا منك","https://www.poetsgate.com/ViewPoem.aspx?id=204357",""],[5691,"يا قدْسُ...!","https://www.poetsgate.com/ViewPoem.aspx?id=206847",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5732,"حنا من المعروف تندا يدينا","https://www.poetsgate.com/ViewPoem.aspx?id=177858",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[5792,"شفته البارح","https://www.poetsgate.com/ViewPoem.aspx?id=180349",""],[5887,"طابا","https://www.poetsgate.com/ViewPoem.aspx?id=35263",""],[5926,"يمانية","https://www.poetsgate.com/ViewPoem.aspx?id=214312",""],[5943,"كِبْرُكَ الخدَّاعُ مانعْ","https://www.poetsgate.com/ViewPoem.aspx?id=11261",""],[5952,"أيها الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=202282",""],[5956,"نزهات في سيارة خالية","https://www.poetsgate.com/ViewPoem.aspx?id=182419",""],[5956,"أ هذا جزائي؟","https://www.poetsgate.com/ViewPoem.aspx?id=183251",""],[5956,"الديمقراطية السوداء","https://www.poetsgate.com/ViewPoem.aspx?id=192214",""],[5956,"ربَّما هجَرتْ هاجَر بُنوَّتي","https://www.poetsgate.com/ViewPoem.aspx?id=207824",""],[5976,"قمراي","https://www.poetsgate.com/ViewPoem.aspx?id=30350",""],[6125,"وليس يَهمُّني في الناسِ شيءٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212866",""],[6187,"آخر أنفاس الحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82157&r=&rc=0",""],[5355,"حديث فخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87206&r=&rc=31",""],[6243,"أكان يصعُبُ !؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84431&r=&rc=5",""],[572,"يا رُبَّ مُهْدٍ هَدِيَّة ً لَطُفَتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9443&r=&rc=300",""]],"verses":[["أَسومُ الهَوى نَفساً عَزوفاً عَنِ الهَوى","وَقَلباً لِضَيمِ الحُبِّ غَيرَ قَبولِ",0,"ل",1,0],["أَسوانُ يُفتِقُ صَبرُهُ إِفتاقَةً","أَمَماً وَبِغَمزُ بِالجَوى فَيَغيبُ",1,"ب",1,0],["أُسودُ غابٍ وَلَكِن لا نُيوبَ لَهُم","إِلّا الأَسِنَّةُ وَالهِندِيَّةُ القُضُبُ",2,"ب",1,0],["أسْوارُ مِكْناسةٍ مُرقّعَةٌ","كأنّها منْ ثِيابِ أهْليها",3,"ه",2,1],["أُسودُ سُروجٍ أو بُدورُ أسِرّةٍ","فإنْ حارَبوا راعُوا وإن سالَموا راقُوا",4,"ق",3,0],["أُسودٌ عَلى البُسفورِ تَحمي عَرينَها","وَتَرعى نِيامَ الشَرقِ وَالغَربُ يَرقُبُ",5,"ب",1,0],["أُسودُ وَغىً لَولا قِراعُ سيوفنا","لَما رَكِبوا قَيداً وَلا سَكَنوا سِجنا",6,"ن",2,0],["أُسودٌ بَوادي ذي حَماسٍ خَوادِرٌ","حَوانٍ عَلى الأَشبالِ محمىً عَرينها",7,"ن",3,0],["أسود اللون غير أن عليه","رونقاً مثلما أضاء النهار",8,"ر",1,0],["أَسوَدٌ إِذا ما كانَ يَومُ وَليمَةٍ","وَلَكِنَّهُم يَومَ اللِقاءِ ثَعالِبُ",9,"ب",1,1],["أسوَدُ هَتَّاكٌ لأَعرَاضِ مَن","مَرَّ على الأَبوَابِ أَو سَلَّمَا",10,"م",2,0],["أَسودٌ إِذا ما أَبدَتِ الحَربُ ساقَها","وَفي سائِرِ الدَهرِ الغُيوثُ المَواطِرُ",11,"ر",1,0],["أسود وغىً تأبى الحياة ذَمِيمةً","وتلبس بالعزّ الرَدىَ وهو أكْفان",12,"ن",1,0],["أُسَوَّدُ ساداتِ العَشيرَةِ عارِف","وَمِن دونِ قَومي في الشَدائِدِ مِذوَدا",13,"د",2,0],["أَسوَدُ صَيّاحٌ كَريمٌ كُرَّزُ","مُطَرَّزٌ مُكَحَّلٌ مُلَزَّزُ",14,"ز",1,0],["آسٌ ووردٌ دعا خدَّام دمعيَ إذ","لباهما لؤلؤي قدماً ومرجاني",15,"ن",2,0],["أسوده ذو غرَّة في الصدر","كأنه نور الهدى في الكفرِ",16,"ر",1,0],["أسُوءُ الرأي في ابن أبي وأمِّي","نصيبي من عطاياكَ الرغابِ",17,"ب",1,0],["أسوغُ لخلّاني مساغَ شرابِهِمْ","ويلقانيَ الأعداءُ كالحنظل الغضّ",18,"ض",1,1],["أسومُكَ ما يسومُ العبدُ مثلي","مَليكاً من بني الأملاك مثلَكْ",19,"ك",1,1],["أسومُكَ أن تدرَّ عليَّ رزقي","وتنبذَ خِدمتي لتُبينَ فضلَكْ",19,"ك",1,0],["أَسِواراً أَم دُمُلجاً مِن نُضارٍ","لا أُحِبُّ القُيودَ في مِعصَمَيكِ",20,"ك",1,0],["أسود الترك هبى ثم هبى","وهزى الأرض في شرق وغرب",21,"ب",1,0],["أَسِواكَ مِن أَهلِ المَبادِىءِ مَن دَعا","لِلجِدِّ أَو جَمَعَ القُلوبَ النُفَّرا",22,"ر",2,0],["أَسوا العَواقِبِ يَأسٌ قَبلَهُ أَمَلٌ","وَأَعضَلُ الداءِ نَكسٌ بَعدَ إِبلالِ",23,"ل",1,0],["أُسودٌ أُطعِمَت ظَفَراً فَعادَت","بِقَسرٍ لِلأَعادي وَاِهتِضامِ",24,"م",1,0],["أُسودٌ يَفِرُّ المَوتُ مِنهُم مَهابَةً","إِذا فَرَّ مِنهُ كُلُّ أَروَعَ صارِمِ",25,"م",1,0],["إِسوَةٌ لِلَصَديقِ تَدنو إِلَيهِ","عَن مَحَلٍّ في النَيلِ عالٍ رَفيعِ",26,"ع",1,0],["أُسودُ لِقاءٍ مِن تَميمٍ سَمَت لَهُم","سَريعٌ إِلى وَلغِ الدِماءِ وَرودُها",27,"د",3,0],["أَسوقُ إِلى البَحرِ الخَضَمِّ جَواهِري","وَأُهدي إِلى أَبناءِ بابِلَ مِن سِحري",28,"ر",2,0],["أُسودٌ تَغانَت بِالقَنا عَن عَرينِها","وَبِالبيضِ عَن أَنيابِها وَالمَخالِبِ",29,"ب",1,0],["أسود اللمة يح","سبُه الناسُ غلامَا",30,"م",2,0],["أَسوَدَ نَضّاحَ المَقَدِّ جَعدا","وَنَحنُ كُنّا لِلنَبِيِّ جُندا",31,"د",2,0],["اسودَّتِ الشهباءُ في","عينيَّ مِنْ رممٍ وغشِ",32,"ش",1,1],["اِسوَدَّ وَاِبيَضَّ فِعلُهُ كَرَماً","فَاِلتَفَتَ الحُسنُ فيهِ عَن حَوَرِ",33,"ر",1,0],["أُسودٌ عَلى المُستَضعَفينَ ثَعالِبٌ","تَروغُ إِذا هَبَّ القَوِيُّ المُواثِبُ",34,"ب",1,0],["أَسوءُ سَريرَةٍ وَخَبالُ قَلبٍ","وَلُؤمُ غَريزَةٍ وَفَسادُ عِرقِ",35,"ق",1,0],["أسِواهم أبتغي يومَ النَّدى","أم سواهم أرتجي يومَ المَعاد",36,"د",1,0],["أَسوَدُ القَلبِ أَسوَدٌ وَمَتى ما","تُصغِ أُذني فَأُذنُهُ صَمّاءُ",37,"م",3,0],["أُسُودُ الدَهرِ تَفرِسُ كُلَّ حَيٍّ","وَنَحنُ الآنَ أَجرٍ في اِحتِراشِ",38,"ش",1,0],["أَسوِئ بِحالِ الظَبيِ وَهوَ مُرَبَّبٌ","في الإِنسِ يَمرَحُ في حُلىً وَجَلاجِلِ",39,"ل",1,0],["أَسوانُ أَنتَ لِأَنَّ الحَيَّ نِيَّتُهُم","أَسوانُ أَيُّ عَذابٍ دونَ عيذابِ",40,"ب",1,1],["أُسُودٌ لَدَى الأَبْيَاتِ بَيْنَ نسَائِهِمْ","وَلَكِنَّهُمْ عِنْدَ الْهيَاجِ نَقَانِقُ",41,"ق",1,0],["أُسُودٌ تُرَاقِبُ أَمْثَالَهَا","وَلاَ يَلْتَقُونَ عَلَى مَوْعِدِ",42,"د",1,0],["أُسْوَةً بِالْمَسِيحِ يَحْمِلُ حُباً","لأِخِيه وَلَيْسَ يَحْمِلُ حِقْدَا",43,"د",2,0],["أُسودُ الشَرى في الحَربِ تَحمي نُفوسها","بِنَجدَتِها ما لَم تعنَّ ظباءُ",44,"ا",2,0],["أُسَوَّدُ ساداتِ العَشيرَةِ عارِفاً","وَمِن دونِ قَومي في الشَدائِدِ مِذوَدا",45,"د",2,0],["أُسَوِّدُ وَجهي لِتَبيِضِها","وَأَهدِمُ كيسي لِعُمرانِها",46,"ن",3,0],["أسْوانُ تَعْرِفُهُ إذا اخْتَلَطَ الدُّجَى","بالنَّبْرَةِ السَّوْدَاءِ في أَنَّاتِه",47,"ت",2,0],["أسِوانا بزُبدة الكأسِ يحظَى","وكلانا من فضلة الكأس يُسقى؟",48,"ق",2,0],["أسود لدى الهيجار هابين في الدجى","أناجيلهم وسط الصدور سطور",49,"ر",1,0],["أُسُودٌ أُطْعِمَتْ ظَفَراً، فعادتْ","بقَسْمٍ للأعادي، وَاهتِضَامِ",50,"م",1,0],["أسوار؟ أم دملجا من نضار؟","لا أحبّ القيود في معصميك",51,"ك",1,0],["أسودَهُ وأحمرَهْ","والواردَاتِ مِشْفَرَه",52,"ه",1,0],["أَسويت بَحراً بِالنَدى مُتَدفِقاً","وَبَدوت تَحكي البَدر غب دُجونِهِ",53,"ن",2,0],["أسودُ عَلى ما تَدعيهِ نُفوسَهُم","تمال إِذا عَدوا لِيَوم رِهانِ",54,"ن",1,1],["اسوق جنائبي والركب مضني","الى متكين للرحب السني",55,"ي",1,1],["أسود بميدان الوغى باع جدهم","طويل عنان يقطع البر والبحرا",56,"ر",2,0],["أسود وسادات سراه أماجد","مناقبهم جهراً نمت وسمت سرا",57,"ر",2,0],["أسوَدَ الفَرعِ أبلَجَ الوَجهِ بَر","قييَ المُحَيَّا ثُدِيُّهُ الرُّمَانُ",58,"ن",1,0],["أسودُ لكن سَيِّدٌ","وهو فَتًى وابنُ فَتَى",59,"ت",2,0],["أُسودُ وَغىً تُردي عِداها مَخافَةً","إِذا أَصبَحَت قُبُّ العِتاقِ بِهِم تَردي",60,"د",2,0],["أُسودٌ عَلى أُسدِ الكَرائِهِ قَد ضَروا","إِذا حوسِنوا سَرّوا وَإِن خوشِنوا ضَرّوا",61,"ر",3,0],["أُسودُ وغىً لِسُمر الخَط","طِ فيها معقل أشِبُ",62,"ب",1,0],["أَسَوَّغتُمُ الشّهدَ المَشورَ لِطاعِمٍ","وَقُلتُم حَرامٌ أَن يُلِمَّ بِهِ النَّحلُ",63,"ل",1,0],["أَسْودٌ في أحمرٍ تَحسَبُه","فَحَما في جَمْرِها الملتهِب",64,"ب",1,0],["أسودٌ في أَكُفِّهمُ صِلالٌ","لها نَهْشٌ تُميت به وعَض",65,"ض",1,0],["أسودُ وَغًى ولا ترتِضى نيلَ مكسب","وإنْ جَلَّ إلا مِن قناً وحُسام",66,"م",1,0],["أسوّف نفسي اليوم واليوم بعده","تعاليل مضنى لا يموت ولا يبرا",67,"ر",2,0],["اسود ظهور الاعوجية غابها","وآجامها ذاك الوشيج المقوم",68,"م",1,0],["اسود اسود الحرب من كل ابلج","طويل نجاد السيف معتقل لدنا",69,"ن",2,0],["اسودٌ ترى في كل يوم كتيبة","لبيضهم شكلا وسمرهم نهقطا",70,"ط",2,0],["أسودُ الأعادي تَلْتَقِيه مهابةً","فيتركُها خذلاء كالكلبِ تَلْهَثُ",71,"ث",1,0],["أسوت بما بينت داء قلوبنا","كما كنت تأسو قبل أوسا وخزرجا",72,"ج",2,0],["أَسوَدٌ كَاللَيلِ عَلى وَجنَةٍ","سُبحانَ مَن أَطلَعَ مِنها بِالنَهار",73,"ر",1,0],["أَسوانُ لا حَيُّ وَلا","مَيتٌ كَهَمزَةِ بَينَ بَينِ",74,"ن",1,0],["أَسوَدُ كَالسَفّودِ يُنسى لَدى","التَنّورِ بَل مِحراكُ قَيّارَه",75,"ر",2,0],["أسوارُ قسطنطينية شهدتكَ من","كثبٍ وملءَ جفونِها الإسهاد",76,"د",1,0],["أُسُودُ ولَكِنَّ الأُسُودَ حَقيقَةً","سُقاتُهُمُ صَرْفَ المَنِيةِ والزّنْقَا",77,"ق",2,0],["أسَوْسَنَةٌ أمْ عَيْبَة لِسِلاحِ","بَدَا كبُنُودٍ وَسْطَها ورِمَاحِ",78,"ح",1,1],["أَسُومُ الْجِبابَ فَلا خَزَّها","أُطِيقُ ابْتِياعاً وَلا صُوفَها",79,"ف",3,1],["أُسودُ ضراءٍ في عرينِ مكاحلٍ","تأبّطَ كلٌّ مِنهمُ حيّةً رَقطا",80,"ط",2,0],["اسوانُ بيعت حياتي","في السوق بيعة وكسِ",81,"س",1,0],["أسوان ينشد قلبه","وكأنه يحيا بدونه",82,"ن",2,0],["أسُود مصاليتٌ لدى حَومه الوغى","لأنَّهُمُو يوم الوغى الآيةُ الكبرى",83,"ر",2,0],["أَسواقُ أَشعارِنا","قد أَسْرفَتْ في الكساد",84,"د",1,0],["أُسَوِّفُ فيكَ النَفسَ لا بَل أُساوِفُ","وَأَصرِفُ عَنكَ العَينَ لا بَل أُصارِفُ",85,"ف",1,1],["أسوةٌ تُفضي إلى","خيرِ نعيمٍ وثوابِ",86,"ب",1,0],["أسِوَاك إن حلت بنا اللوّآء","يُدْعَى لها إنا إذاً جهلاء",87,"ا",2,1],["أسواه سوَّاها ضياءً نافعاً","لا والذي رفع السما ببنائه",88,"ا",3,0],["أسُوفُ صَعِيدَ الأرضِ إذ وافق اسمُه","صعيداً به أهلُ الحبيب نُزُولُ",89,"ل",1,0],["أَسودُ إذا ما كنتَ مولايَ في الورى","ومن كنتَ مولاه فلا زالَ سيِّدا",90,"د",2,0],["أُسودُ مواطن الهيجاء قومٌ","لهُم شَرَفُ العقول على الأُ