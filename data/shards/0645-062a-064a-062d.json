{"poems":[[55,"حططت المكارم عن عاتقي","https://www.aldiwan.net/poem30520.html","المتقارب"],[65,"لويت على الرمح الرديني معصما","https://www.aldiwan.net/poem46086.html","الطويل"],[53,"بدا الشيب إلا ما تداوي المواشط","https://www.aldiwan.net/poem65000.html","البسيط"],[53,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[119,"يا ساكن القلب لقد","https://www.aldiwan.net/poem40425.html","عموديه"],[122,"تخَطّت منك قافيةٌ عشاء","https://www.aldiwan.net/poem491.html",""],[164,"أعن ملل خيالك لا يطيف","https://www.aldiwan.net/poem58766.html","الوافر"],[190,"إذا اجتهد المنجم بعد علم","https://www.aldiwan.net/poem43919.html","الوافر"],[275,"متى حلم السعادة يضمحل","https://www.aldiwan.net/poem35206.html","الوافر"],[285,"سوى باكيك من ينهى العذول","https://www.aldiwan.net/poem60710.html","الوافر"],[287,"متى حثني الشوق يا ناقتي","https://www.aldiwan.net/poem32679.html","المتقارب"],[358,"لساحة عزة العلياء أهدي","https://www.aldiwan.net/poem39751.html","الوافر"],[376,"أرى طارقا يصبو إلي ويصبيني","https://www.aldiwan.net/poem57085.html","الطويل"],[422,"لأسماء دار حيث منقطع الرمل","https://www.aldiwan.net/poem53930.html","الطويل"],[422,"أدار الكأس مترعة شرابا","https://www.aldiwan.net/poem54184.html","الوافر"],[482,"متى حان من شمس النهار غروب","https://www.aldiwan.net/poem15325.html","الطويل"],[543,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63936","الهزج"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122089","الطويل"],[1859,"","https://poetry.dctabudhabi.ae/diwan/poem/142262","الطويل"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/138001",""],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88944","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86267","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129424","الوافر"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129437","الطويل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36778","المتقارب"],[5573,"الا هُبي بغيثكِ فامطرينا","https://www.poetsgate.com/ViewPoem.aspx?id=215491",""],[243,"همسك الهاني","https://www.poetsgate.com/ViewPoem.aspx?id=50488",""],[5956,"هدية من والدي","https://www.poetsgate.com/ViewPoem.aspx?id=192729",""],[6125,"جِرَاحِي لا تُضَمِّدها الأمَانِي","https://www.poetsgate.com/ViewPoem.aspx?id=207908",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""]],"verses":[["مَتى حُلتُ عَن وِدِّكَ المُصطَفى","وَأَخلَفَ ما رُمتُهُ مَولِدي",0,"د",2,0],["مَتى حُصِّلَت أَنْسابُ قَيْسٍ وَخِنْدِفٍ","فَلي مِنْ رَوابِيهنَّ أَشْرَفُ مُنْتَمى",1,"م",2,0],["متَى حُسِبتْ أحسابُكُم آلَ مخلدٍ","أبت ضبطَها أيدي الحساب الضوابط",2,"ط",1,0],["متى حققتُ لم أقعُدْ بحقي","وإن جادلْتُ لم يُخشَ انجدالي",3,"ل",2,0],["متى حوى مضمونه","على الكمالات احتوى",4,"و",2,0],["متى حرم المرور لقا حبيب","مخافة كاشح يبغي الرداء",5,"ا",2,0],["متى حدثتَ نفشك بانتجاه","فهمكَ في العلا همٌّ شريفُ",6,"ف",1,0],["متى حظّ الفتى قصرَت خطاه","لمطلبه ولان له الحديد",7,"د",1,0],["مَتى حلُم السعادةِ يَضمحِلُّ","فمن عمرِ الصبا بقيَ الأقلُّ",8,"ل",1,1],["مَتى حالَتْ مَحاسِنَكَ اللَّواتِي","لَها في القَلْبِ عَهْدٌ لا يَحُولُ",9,"ل",1,0],["مَتى حَثَّني الشَوقُ يا ناقَتي","حَثَثتُكِ بِالسَّوقِ هَذا بِذاكِ",10,"ك",1,1],["مَتى حصَّنته بِاللَه أَرّخ","بِحفظ اللَه دُم في كُلّ آنِ",11,"ن",1,0],["مَتى حُرِّكت غنَّت ولكن يسُوؤُني","إِذا لَم يَكُن لي غَيرُها أن تُغنِّيني",12,"ن",2,0],["متى حاولته اليعملات حَثَثْتُها","إلى السَّيِّد المحمود بالقول والفعل",13,"ل",1,0],["متى حجب الوقار اللَّهو عنهم","رأوا أنْ يرفعوا ذاك الحجابا",14,"ب",2,0],["متى حانَ مِن شمسِ النهارِ غروبُ","جرتْ مِن دموعِ المقلتينِ غروبُ",15,"ب",1,1],["مَتى حُجِزَت عَني المَراقِيُ والعُلاَ","وهل بينَ ذي مَجدٍ وبينَ العُلاَ حُجبُ",16,"ب",1,0],["متى حُدِّثْتَ عن نفسي","بصبرٍ يا أبا حفص",17,"ص",1,0],["مَتَى حَمَلَتْ حُمْرُ القِبَابِ صَوَاغِياً","فَكُلُّ قُلُوب العَاشِقِينَ صَوَاغِ",18,"غ",1,0],["متى حن وعد أو تغنت حمامة","فقلبي إلى لقياكمو يتوجع",19,"ع",1,0],["متى حصون العز ذي باتشيد","وما خرب منها نعيده",20,"د",2,0],["متى حلت محاسنه بقطرٍ","رأيت القطر منظره وسيم",21,"م",1,0],["مَتى حَركت يُمناهُ مِنهُ يَراعه","ارانا لعمري في اليَمين مهنَّدا",22,"د",2,0],["متى حجب الرشيد أبا نؤاس","متى حجب الأديب عن الدخول",23,"ل",1,0],["متى حاولت آراؤه نيل خطة","تبوأ في آرائه ما يحاوله",24,"ل",2,0],["مَتى حازَ بَدرٌ جَميعَ المَساكِن","فَحُبّي فَريدٌ بِصَدغٍ وَحاجِب",25,"ب",1,0],["متى حَمْتْ نفضتُ لها يراعاً","كوصف السمهري له طعونا",26,"ن",2,0],["متى حومت في أفق ثغرك قبلة","يصعدها ثغري فقد زال ما بيا",27,"ي",2,0],["متى حاصرتْني الهموم ألوذ","بربي... فأنتَ... وأشهدُ فكّا",28,"ك",2,0],["مَتَى حَدَّثتِ فالأسمَاعُ تُصغِي","وَصَوتُكِ بَاتَ يُطرِبُ كالمَغَانِي",29,"ن",2,0],["متى حانت الآجال ليس يعيدنا","إلى العمر نوح أو تحسر ثانيا",30,"ي",2,0]]}