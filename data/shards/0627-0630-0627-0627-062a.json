ن الدقيقُ مَوقعا","https://www.poetsgate.com/ViewPoem.aspx?id=29501",""],[113,"أردت التعالي والحسود مدا المدا","https://www.aldiwan.net/poem41693.html","الطويل"],[148,"الخوف والأنس شيء ليس يتفق","https://www.aldiwan.net/poem68515.html","الخفيف"],[197,"رأيت الهوى والخمر سيين غدرة","https://www.aldiwan.net/poem45357.html","الطويل"],[201,"إذا اتصلت تدعو أباها لحارث","https://www.aldiwan.net/poem68158.html","الطويل"],[208,"مولاي جد لي بشاش","https://www.aldiwan.net/poem13422.html","المجتث"],[227,"أطعت الصبا وشبابي نضير","https://www.aldiwan.net/poem51038.html","المتقارب"],[268,"يا صاحبي الساهر دون الورى","https://www.aldiwan.net/poem35040.html","السريع"],[268,"بكت لفتى يفني قواه تعمدا","https://www.aldiwan.net/poem35632.html","الطويل"],[273,"ولا ودعوا يوم النوى جارة الحمى","https://www.aldiwan.net/poem25412.html","الطويل"],[273,"يقر بعيني أن قلبي ما قرا","https://www.aldiwan.net/poem25560.html","الطويل"],[273,"تخيرت مختار الخليفة للعهد","https://www.aldiwan.net/poem25584.html","الطويل"],[277,"أيحسن بعد ضنك حسن ظني","https://www.aldiwan.net/poem2631.html","الوافر"],[295,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[344,"وما أبالي إذا لاقت جموعهم","https://www.aldiwan.net/poem24136.html","البسيط"],[364,"وحوشي أن يقال لها عتابي","https://www.aldiwan.net/poem17143.html","الوافر"],[377,"أأرجوا من الإلمام بالطلل البالي","https://www.aldiwan.net/poem48836.html","الطويل"],[402,"إذا اتخذت أخا فاسبر خلائقه فإن","https://www.aldiwan.net/poem49579.html","البسيط"],[406,"حمائم الأيك هيجتن أشجانا","https://www.aldiwan.net/poem31850.html","البسيط"],[413,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[420,"حن إلى كأسه الخليع","https://www.aldiwan.net/poem4107.html","مخلع البسيط"],[431,"أذا برد تحدر من غمام","https://www.aldiwan.net/poem25701.html","الوافر"],[434,"ما بعد رامة للمشتاق من إرب","https://www.aldiwan.net/poem2580.html","البسيط"],[456,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[456,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[459,"أجل ما رمت في آت مقتبل","https://www.aldiwan.net/poem15134.html","البسيط"],[459,"يا ساري الليل عواما بلجته","https://www.aldiwan.net/poem15437.html","البسيط"],[466,"أنا الذي أشعاره","https://www.aldiwan.net/poem60046.html","مجزوء الرجز"],[466,"لنا أخ خير بلا شر","https://www.aldiwan.net/poem60080.html","السريع"],[466,"قد نتج الجو جموحا أشهبا","https://www.aldiwan.net/poem60443.html","الرجز"],[493,"كم حسرات لي وكم وجد","https://www.aldiwan.net/poem9818.html","السريع"],[507,"كل شيءٍ مصيره للزوال","https://www.aldiwan.net/poem744.html","الخفيف"],[525,"مقابل بين اقوام وألوية","https://www.aldiwan.net/poem45987.html","البسيط"],[549,"ماذا على الريم لو حيا فأحيانا","https://www.aldiwan.net/poem47179.html","البسيط"],[560,"قفا بين الثنية والمصلى","https://www.aldiwan.net/poem52929.html","الوافر"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["إِذا اِتَّسَعَت في خُطَّةِ الصَدِّ فِكرَتي","تَجَلَّلَني هَمٌّ يَضيقُ بِهِ جِلدي",0,"د",2,0],["إِذا اِتَّقَيتُ بِكَ الأَعداءَ رامِيَةً","فَواجِبٌ أَن أُوَقّيكَ النَوائِبَ بي",1,"ب",2,0],["إِذا اِتَّصَلَت قالَت أَبَكرَ بنَ وائِلٍ","وَبَكرٌ سَبَتها وَالأُنوفُ رَواغِمُ",2,"م",1,0],["إِذا اِتَّخَذَت وُجوهُ القَومِ نَصباً","أَجيجَ الواهِجاتِ مَنَ السَمومِ",3,"م",1,0],["إِذَا أَتَى اللَّيْلُ سَهِرْنَا لَهَا","بِأَعْيُنٍ مَفْتُونَةٍ لا تَنَامْ",4,"م",1,0],["إذا أتاه شكيّ القوم قابله","بكا لنسيم جرى في روضةٍ عطرا",5,"ر",2,0],["إذا اتَضَعُونَا كارِهينَ لِبَيعَةٍ","أنَاخُوا لأخرَى والأزِمَّةُ تُجذَبُ",6,"ب",1,0],["إذا أتبعت ألفاظها بصريرها","طربنا لأقوال البلاغة في هنك",7,"ك",1,0],["إذا أتته وهوَ في صحبهِ","صارَ مضافاً ومضافاً إليه",8,"ي",2,0],["إذا أتى سالماً كمُنيتنا","أعادها محسناً وكرَّرها",9,"ر",3,0],["إِذا أَتَيتَ أَبا مَروانَ تَسأَلُهُ","وَجَدتَهُ حاضِراهُ الجودُ وَالحَسَبُ",10,"ب",1,0],["إِذا أَتاهُنَّ مَكلومٌ عَكَفنَ لَهُ","عَكفَ الفَوارِسِ هابوا الدارِعَ البَطَلا",11,"ل",2,0],["إِذا اِتَّزَرَ الحادي الكَميشُ وَقَوَّمَت","سَوالِفَها الرُكبانُ وَالحَلَقُ الصُفرُ",12,"ر",1,0],["إِذا أَتى جانِباً مِنها يُصَرِّفُهُ","تَصَفُّقُ الريحِ تَحتَ الديمَةِ الدِرَرِ",13,"ر",1,0],["إذا اتحدت عناصر في بناءٍ","تغيَّر وصفه ذاك البناءُ",14,"ا",2,0],["إذا أتتها الليالي من قواعدها","تنالها بالبلى قامت اثافيها",15,"ي",3,0],["إِذا أَتَتها الرِياحُ النُكبُ مِن بَلَدٍ","فَما تَهُبُّ بِها إِلّا بِتَرتيبِ",16,"ب",1,0],["إِذا أَتَتِ الإِساءَةُ مِن لَئيمٍ","وَلَم أُلُمِ المُسيءَ فَمَن أَلومُ",17,"م",1,0],["إِذا أَتبَعَ الرُمحُ المُرَكَّبُ رَأسَهُ","عَلَيهِ بِلَعنٍ قُلتَ إِنَّ وَراكِبُه",18,"ب",2,0],["إِذا أَتَيتُكَ إِجلالاً وَتَكرِمَةً","رَجَعتُ أَحمِلُ بِرّاً غَيرَ مَقبولِ",19,"ل",1,0],["إِذا أَتَيناهُ وَالأَنبارُ عُمدَتُنا","جِئناهُ رَجلاً وَأُبنا عَنهُ رُكبانا",20,"ن",2,0],["إِذا أَتَيتَ أَميرَ المُؤمِنينَ فَقُل","بِالنَصحِ وَالعِلمِ قَولاً غَيرَ مَكذوبِ",21,"ب",1,0],["إِذا أَترَفَتها عَبرَةٌ بَعدَ عَبرَةٍ","وَقامَ النَواعي رَجَّعَت بِعَويلِ",22,"ل",1,0],["إِذا أَتَيتَ بَني شَمخٍ وَجَدتَ لَهُم","لِلمَكرُماتِ عَلى المَعروفِ أَعوانا",23,"ن",2,0],["إِذا اِتَّضَحَ الصَوابُ فَلا تَدَعهُ","فَإِنَّكَ كُلَّما ذُقتَ الصَوابا",24,"ب",2,0],["إِذا اِتَّحَدَت بِجِرمِ الكَأسِ أَخفَت","بِساطِعِ نورِها جِرمَ الإِناءِ",25,"ا",2,0],["إذا اتّخَذَتْها الشمسُ مرآةَ وجْهِها","أحالت عليها من مداوسِها صَقْلا",26,"ل",2,0],["إِذا أَتى بَلَداً أَجلَت خَلائِقُهُ","عَن أَهلِهِ الأَنكَدَينِ الخَوفَ وَالعَدَما",27,"م",2,0],["إِذَا أَتَاكَ خَلِيلٌ بَعْدَ مَنْدَمَةٍ","مِنْهُ عَلَى مَا مَضَى مِنْ زَلَّةٍ فَهُنِ",28,"ن",1,1],["إذا اتَّخذَ القويُّ الظُّلمَ دِيناً","فأشقى النّاسَ مَن يُلْقِي الزّماما",29,"م",2,0],["إِذا أَتى مُوهِناً وَقَد نَامَ صَحبيَ","وَسَجا اللَيلُ بِالظَلامِ البَهِيمِ",30,"م",1,1],["إِذا أَتاهُ رَسولي","فَلا يَرُدَّ رَسولي",31,"ل",2,0],["إِذا أَتاهُ غَداً أَو بَعدَهُ ثَقَلٌ","تَغدو إِلَيهِ بِهِ الأَنباءُ وَالبُرُدُ",32,"د",1,0],["إِذا أَتَيتَ المَهدِيَّ سَأَلُهُ","لاقيتَ جوداً بِهِ وَمُحتَسَبا",33,"ب",2,0],["إِذا أَتاني حِمامي ماحِياً شَبَحي","وَما صَنَعتُ فَعَيشي كُلُّهُ عَنَتُ",34,"ت",1,1],["إِذا أَتَهمتَ في أَيّامِ قَيظٍ","فَعُدِّ الناجِياتِ إِلى قَراسِ",35,"س",1,0],["إِذا آتاكَ هَذا الدَهرُ مُلكاً","فَما لَكَ مِن أَقَذّ وَلا مَريشِ",36,"ش",1,0],["إِذا اِتَّكَوا فَأَدارَتها أَكُفُّهُمُ","صِرفاً تُدارُ بِأَكواسٍ وَأَقداحِ",37,"ح",1,0],["إِذا أَتى مَعرَكاً مِنها تُعرِّفُهُ","مُحرَنبِئاً عَلَّمَتهُ المَوتَ فانقَفَلا",38,"ل",2,0],["إِذا أَتَيا حَيّاً كِراماً بِغِبطَةٍ","أَناخا بِهِم حَتّى يُلاقُوا الدَواهِيا",39,"ي",2,0],["إذا أتت الإساءة من وضيعٍ","ولم ألم المسيء فمن ألوم",40,"م",1,0],["إذا أتعَبَتْ عيني السماءُ تطلُّعا","وخالستُ لحظاً للنجومِ مُريبا",41,"ب",2,0],["إذا أتاهم أيسر النداء","منه جروا لغاية الفداء",42,"ا",2,0],["إِذا اتَّقَدَتْ في الْكَأْسِ خِلْتَ وَمِيضَهَا","عَلَى وَتَراتِ الْكَفِّ نَضْحَ دِمَاءِ",43,"م",3,0],["إِذَا اتَّقَدَتْ في الْكَأْسِ خِلْتَ مُدِيرَها","تَخَضَّبَ مِنْهَا كَفُّهُ بِخِضَابِ",44,"ب",1,0],["إذا اتحد الفكر في معشرٍ","تجمَّعَ من شمله ما انشعب",45,"ب",1,0],["إذا اتَّخذ الناس المناصبَ متجرًا","فما اقتات منها قوتَ يومٍ ولا ارتَدَى",46,"د",2,0],["إذا اتَّضَحَ الصَّوابُ فلا تَدْعُهُ","فإنّكَ قلّما ذُقتَ الصّوابَا",47,"ب",2,0],["إذا أتْبَعَتْهُمْ طَرْفَها حَالَ دُونَهَا","رَذَاذٌ على إنْسَانِها يتريّعُ",48,"ع",1,0],["إذا أتى يسعى حثيثاً مسرعا","من بعد ما مسَّ الغلاء الأشْنعا",49,"ع",2,0],["إذا اتسج الغدار بالجهل فالبلا","عليه ولا مال يقيه ولا أهل",50,"ل",1,0],["إذا اتفقنا على سهو ومعجزة","فمطلب الرُّشد منَّا ليس يتفق",51,"ق",1,0],["إذا أتوارى يطلبانِ فضيحتي","فتظهر في وجهي ويظهرُ في عيني",52,"ي",1,0],["إِذا اِتَصَلَت تَدعو أَباها لِحارِثٍ","دَعَت بِاِسمِ سَيّالِ العَطاءِ زَعوفِ",53,"ف",1,1],["إذا أتى منك طيا","يطيب طيا ونشرا",54,"ر",2,0],["إذا اتبع الكأسَ ألفاظه","يرادِفها منه لحظ سَحُور",55,"ر",1,0],["إذا أتاني طيفُها قَلْ لهُ","وقُل له أن يَرجعَ القَهقَرى",56,"ر",2,0],["إذا أترعت كأسي تجرّعتُ نِصفها","لأبقى على الندمانِ والخمرِ سيّدا",57,"د",2,0],["إِذا اتَّسَقَت فِي الفَرْعِ وَالأَصلُ طَيِّبٌ","فُنُونُ النَّدَى وَالطبْعُ شهْدٌ مَعَ الزُّبدِ",58,"د",1,0],["إِذا أتْبعتْ ألحاظها الكسْرُ فِتْنَةً","تَضلُّ بِها الأَلبابُ فاحتَسِبِ الجَبْرا",59,"ر",2,0],["إِذا اتّجَهَت صَوباً سَحائِبُ عِلْمِه","ونائِلِهِ أنْحَتْ عَلَى الجَهْلِ والجَهْدِ",60,"د",1,0],["إذا اتبّعوا له عَزماً ورأْياً","غَنُوا في الحرب عن ضربٍ وطعن",61,"ن",1,0],["إِذا أَتَيتُ بِتَرشيحٍ لمدحتهم","حلّى لِساني وجيدي فضلُ ذكرهمِ",62,"م",1,0],["إِذا اِتَّكَأتُ عَلى الأَنماطِ مُرتَفِعاً","بَدير مُرّانَ عِندي أُمُّ كُلثومِ",63,"م",1,0],["إذا اِتَّشَحَت سُيوفُهُمُ بِأَيدٍ","رَأَيتَ الداءَ قَد سَكَنَ الدَواءَ",64,"ا",2,0],["إِذا اِتَقَدَ المازيّ مِن حَرّ عَزمِهم","وَحَرّ ذَكاءٍ يَومَ كَرّ وَأَهوال",65,"ل",1,0],["إذا اتخذْتَ أخا فاسبر خلائقَهُ فإنَّ","ذا الحزم والتَّدبيرِ مَنْ سَبَرا",66,"ر",2,1],["إذا أتيتَهُمُ ألفيتَ شطرَهمُ","مُسترفِدين وزُوَّاراً وضيفانا",67,"ن",2,0],["إذا أتاه بطشه استبلّ لا","يعرف إلاَّ عفوه من ملتجا",68,"ا",1,0],["إذا أتانا جاحدٌ مُباحثٌ","راح وفي فيه اغتذى عفر الثرى",68,"ا",1,0],["إِذا أَتى بِالصُّدودِ ذَنباً","فَالحُسنُ في وَجهِهِ شَفيعُ",69,"ع",1,0],["إِذا أَتَتِ السَّماءُ بِمِثْلِ هذا","فما بالُ الْقِيامَةِ لا تَقُومُ",70,"م",1,0],["إذا أتى القرّ لم اسطع مدافعةً","عني بسمر الموالي لا ولا اليلَبِ",71,"ب",1,0],["إذا أتى اليومُ بشرٍّ عابسٍ","لقيتُه منافقاً مبتسما",72,"م",2,0],["إذا اتسعتْ أيمانُها لعطيّةٍ","وراجعت الأخلاقَ ضاقت صدورُها",73,"ر",3,0],["إذا أتى الدينُ فالأقدام مَنْقصةٌ","وما لنا بقراع الله من قِبَلِ",74,"ل",1,0],["اذا اتْلأبَّ به نجدٌ فأظْهرهُ","أحلَّهُ الخوُف غَوْراً بعد اِنجاد",75,"د",1,0],["إِذا أَتَت أَمثالُهُ","كانَت كَنَقشٍ في حَجَر",76,"ر",1,0],["إِذا أَتى قَصدي إِلى بابِهِ","أَراهُ إِكراماً مِنَ السِرِّ",77,"ر",1,0],["إِذا أَتى مِنَ المِياهِ مَلعَبا","أَراكَ فيهِ حافِراً مُقَبَّبا",78,"ب",2,0],["إذا أتى زوجته زانياً","تُنْزِل أسماءُ على هند",79,"د",1,0],["إِذا أَتَونا بِعَسكَرٍ ذي زُهاءٍ","مُكفَهِرِّ الأَذى شَديدِ المَصالِ",80,"ل",1,0],["إذا أتى داره الأضياف أنشدَهُم","وإخوتي أسوةٌ عندي وإخواني",81,"ي",1,0],["إذا أتتْ بلداً عن غِبِّ مَتْلَفَةٍ","رَمى بِها البلدُ المأتيُّ بلدانا",82,"ن",2,0],["إذا أتْحَفتَ عَينيهِ بِكُحلٍ","يقولُ أراكَ تُهدي الكُحْلَ كُحْلا",83,"ل",2,0],["إذا أتاه حادث المنية","أن يختفظ بالعهد والصوية",84,"ه",1,0]]}