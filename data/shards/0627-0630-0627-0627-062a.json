 شكيّ القوم قابله","بكا لنسيم جرى في روضةٍ عطرا",5,"ر",2,0],["إذا اتَضَعُونَا كارِهينَ لِبَيعَةٍ","أنَاخُوا لأخرَى والأزِمَّةُ تُجذَبُ",6,"ب",1,0],["إذا أتبعت ألفاظها بصريرها","طربنا لأقوال البلاغة في هنك",7,"ك",1,0],["إذا أتته وهوَ في صحبهِ","صارَ مضافاً ومضافاً إليه",8,"ي",2,0],["إذا أتى سالماً كمُنيتنا","أعادها محسناً وكرَّرها",9,"ر",3,0],["إِذا أَتَيتَ أَبا مَروانَ تَسأَلُهُ","وَجَدتَهُ حاضِراهُ الجودُ وَالحَسَبُ",10,"ب",1,0],["إِذا أَتاهُنَّ مَكلومٌ عَكَفنَ لَهُ","عَكفَ الفَوارِسِ هابوا الدارِعَ البَطَلا",11,"ل",2,0],["إِذا اِتَّزَرَ الحادي الكَميشُ وَقَوَّمَت","سَوالِفَها الرُكبانُ وَالحَلَقُ الصُفرُ",12,"ر",1,0],["إِذا أَتى جانِباً مِنها يُصَرِّفُهُ","تَصَفُّقُ الريحِ تَحتَ الديمَةِ الدِرَرِ",13,"ر",1,0],["إذا اتحدت عناصر في بناءٍ","تغيَّر وصفه ذاك البناءُ",14,"ا",2,0],["إذا أتتها الليالي من قواعدها","تنالها بالبلى قامت اثافيها",15,"ي",3,0],["إِذا أَتَتها الرِياحُ النُكبُ مِن بَلَدٍ","فَما تَهُبُّ بِها إِلّا بِتَرتيبِ",16,"ب",1,0],["إِذا أَتَتِ الإِساءَةُ مِن لَئيمٍ","وَلَم أُلُمِ المُسيءَ فَمَن أَلومُ",17,"م",1,0],["إِذا أَتبَعَ الرُمحُ المُرَكَّبُ رَأسَهُ","عَلَيهِ بِلَعنٍ قُلتَ إِنَّ وَراكِبُه",18,"ب",2,0],["إِذا أَتَيتُكَ إِجلالاً وَتَكرِمَةً","رَجَعتُ أَحمِلُ بِرّاً غَيرَ مَقبولِ",19,"ل",1,0],["إِذا أَتَيناهُ وَالأَنبارُ عُمدَتُنا","جِئناهُ رَجلاً وَأُبنا عَنهُ رُكبانا",20,"ن",2,0],["إِذا أَتَيتَ أَميرَ المُؤمِنينَ فَقُل","بِالنَصحِ وَالعِلمِ قَولاً غَيرَ مَكذوبِ",21,"ب",1,0],["إِذا أَترَفَتها عَبرَةٌ بَعدَ عَبرَةٍ","وَقامَ النَواعي رَجَّعَت بِعَويلِ",22,"ل",1,0],["إِذا أَتَيتَ بَني شَمخٍ وَجَدتَ لَهُم","لِلمَكرُماتِ عَلى المَعروفِ أَعوانا",23,"ن",2,0],["إِذا اِتَّضَحَ الصَوابُ فَلا تَدَعهُ","فَإِنَّكَ كُلَّما ذُقتَ الصَوابا",24,"ب",2,0],["إِذا اِتَّحَدَت بِجِرمِ الكَأسِ أَخفَت","بِساطِعِ نورِها جِرمَ الإِناءِ",25,"ا",2,0],["إذا اتّخَذَتْها الشمسُ مرآةَ وجْهِها","أحالت عليها من مداوسِها صَقْلا",26,"ل",2,0],["إِذا أَتى بَلَداً أَجلَت خَلائِقُهُ","عَن أَهلِهِ الأَنكَدَينِ الخَوفَ وَالعَدَما",27,"م",2,0],["إِذَا أَتَاكَ خَلِيلٌ بَعْدَ مَنْدَمَةٍ","مِنْهُ عَلَى مَا مَضَى مِنْ زَلَّةٍ فَهُنِ",28,"ن",1,1],["إذا اتَّخذَ القويُّ الظُّلمَ دِيناً","فأشقى النّاسَ مَن يُلْقِي الزّماما",29,"م",2,0],["إِذا أَتى مُوهِناً وَقَد نَامَ صَحبيَ","وَسَجا اللَيلُ بِالظَلامِ البَهِيمِ",30,"م",1,1],["إِذا أَتاهُ رَسولي","فَلا يَرُدَّ رَسولي",31,"ل",2,0],["إِذا أَتاهُ غَداً أَو بَعدَهُ ثَقَلٌ","تَغدو إِلَيهِ بِهِ الأَنباءُ وَالبُرُدُ",32,"د",1,0],["إِذا أَتَيتَ المَهدِيَّ سَأَلُهُ","لاقيتَ جوداً بِهِ وَمُحتَسَبا",33,"ب",2,0],["إِذا أَتاني حِمامي ماحِياً شَبَحي","وَما صَنَعتُ فَعَيشي كُلُّهُ عَنَتُ",34,"ت",1,1],["إِذا أَتَهمتَ في أَيّامِ قَيظٍ","فَعُدِّ الناجِياتِ إِلى قَراسِ",35,"س",1,0],["إِذا آتاكَ هَذا الدَهرُ مُلكاً","فَما لَكَ مِن أَقَذّ وَلا مَريشِ",36,"ش",1,0],["إِذا اِتَّكَوا فَأَدارَتها أَكُفُّهُمُ","صِرفاً تُدارُ بِأَكواسٍ وَأَقداحِ",37,"ح",1,0],["إِذا أَتى مَعرَكاً مِنها تُعرِّفُهُ","مُحرَنبِئاً عَلَّمَتهُ المَوتَ فانقَفَلا",38,"ل",2,0],["إِذا أَتَيا حَيّاً كِراماً بِغِبطَةٍ","أَناخا بِهِم حَتّى يُلاقُوا الدَواهِيا",39,"ي",2,0],["إِذَا أَتَيْنَ عَلَى وَادِي النِّبَاجِ بِنَا","خُوصاً فَلَيْسَ عَلَى مَا فَاتَ مُرْتَجَعُ",40,"ع",1,0],["إذا أتت الإساءة من وضيعٍ","ولم ألم المسيء فمن ألوم",41,"م",1,0],["إذا أتعَبَتْ عيني السماءُ تطلُّعا","وخالستُ لحظاً للنجومِ مُريبا",42,"ب",2,0],["إذا أتاهم أيسر النداء","منه جروا لغاية الفداء",43,"ا",2,0],["إِذا اتَّقَدَتْ في الْكَأْسِ خِلْتَ وَمِيضَهَا","عَلَى وَتَراتِ الْكَفِّ نَضْحَ دِمَاءِ",44,"م",3,0],["إِذَا اتَّقَدَتْ في الْكَأْسِ خِلْتَ مُدِيرَها","تَخَضَّبَ مِنْهَا كَفُّهُ بِخِضَابِ",45,"ب",1,0],["إذا اتحد الفكر في معشرٍ","تجمَّعَ من شمله ما انشعب",46,"ب",1,0],["إذا اتَّخذ الناس المناصبَ متجرًا","فما اقتات منها قوتَ يومٍ ولا ارتَدَى",47,"د",2,0],["اذا اتكلنا قعددا عليهم","لم يسلم المجد اذا من الأذى",48,"ا",1,0],["إذا اتَّضَحَ الصَّوابُ فلا تَدْعُهُ","فإنّكَ قلّما ذُقتَ الصّوابَا",49,"ب",2,0],["إذا أتْبَعَتْهُمْ طَرْفَها حَالَ دُونَهَا","رَذَاذٌ على إنْسَانِها يتريّعُ",50,"ع",1,0],["إذا أتى يسعى حثيثاً مسرعا","من بعد ما مسَّ الغلاء الأشْنعا",51,"ع",2,0],["إذا اتسج الغدار بالجهل فالبلا","عليه ولا مال يقيه ولا أهل",52,"ل",1,0],["إذا اتفقنا على سهو ومعجزة","فمطلب الرُّشد منَّا ليس يتفق",53,"ق",1,0],["إذا أتوارى يطلبانِ فضيحتي","فتظهر في وجهي ويظهرُ في عيني",54,"ي",1,0],["إِذا اِتَصَلَت تَدعو أَباها لِحارِثٍ","دَعَت بِاِسمِ سَيّالِ العَطاءِ زَعوفِ",55,"ف",1,1],["إذا أتى منك طيا","يطيب طيا ونشرا",56,"ر",2,0],["إذا اتبع الكأسَ ألفاظه","يرادِفها منه لحظ سَحُور",57,"ر",1,0],["إذا أتاني طيفُها قَلْ لهُ","وقُل له أن يَرجعَ القَهقَرى",58,"ر",2,0],["إذا أترعت كأسي تجرّعتُ نِصفها","لأبقى على الندمانِ والخمرِ سيّدا",59,"د",2,0],["إِذا اتَّسَقَت فِي الفَرْعِ وَالأَصلُ طَيِّبٌ","فُنُونُ النَّدَى وَالطبْعُ شهْدٌ مَعَ الزُّبدِ",60,"د",1,0],["إِذا أتْبعتْ ألحاظها الكسْرُ فِتْنَةً","تَضلُّ بِها الأَلبابُ فاحتَسِبِ الجَبْرا",61,"ر",2,0],["إِذا اتّجَهَت صَوباً سَحائِبُ عِلْمِه","ونائِلِهِ أنْحَتْ عَلَى الجَهْلِ والجَهْدِ",62,"د",1,0],["إذا اتبّعوا له عَزماً ورأْياً","غَنُوا في الحرب عن ضربٍ وطعن",63,"ن",1,0],["إِذا أَتَيتُ بِتَرشيحٍ لمدحتهم","حلّى لِساني وجيدي فضلُ ذكرهمِ",64,"م",1,0],["إِذا اِتَّكَأتُ عَلى الأَنماطِ مُرتَفِعاً","بَدير مُرّانَ عِندي أُمُّ كُلثومِ",65,"م",1,0],["إذا اِتَّشَحَت سُيوفُهُمُ بِأَيدٍ","رَأَيتَ الداءَ قَد سَكَنَ الدَواءَ",66,"ا",2,0],["إِذا اِتَقَدَ المازيّ مِن حَرّ عَزمِهم","وَحَرّ ذَكاءٍ يَومَ كَرّ وَأَهوال",67,"ل",1,0],["إذا اتخذْتَ أخا فاسبر خلائقَهُ فإنَّ","ذا الحزم والتَّدبيرِ مَنْ سَبَرا",68,"ر",2,1],["إذا أتيتَهُمُ ألفيتَ شطرَهمُ","مُسترفِدين وزُوَّاراً وضيفانا",69,"ن",2,0],["إذا أتاه بطشه استبلّ لا","يعرف إلاَّ عفوه من ملتجا",70,"ا",1,0],["إذا أتانا جاحدٌ مُباحثٌ","راح وفي فيه اغتذى عفر الثرى",70,"ا",1,0],["إِذا أَتى بِالصُّدودِ ذَنباً","فَالحُسنُ في وَجهِهِ شَفيعُ",71,"ع",1,0],["إِذا أَتَتِ السَّماءُ بِمِثْلِ هذا","فما بالُ الْقِيامَةِ لا تَقُومُ",72,"م",1,0],["إذا أتى القرّ لم اسطع مدافعةً","عني بسمر الموالي لا ولا اليلَبِ",73,"ب",1,0],["إذا أتى اليومُ بشرٍّ عابسٍ","لقيتُه منافقاً مبتسما",74,"م",2,0],["إذا اتسعتْ أيمانُها لعطيّةٍ","وراجعت الأخلاقَ ضاقت صدورُها",75,"ر",3,0],["إذا أتى الدينُ فالأقدام مَنْقصةٌ","وما لنا بقراع الله من قِبَلِ