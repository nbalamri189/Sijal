{"poems":[[9,"أترحل من ليلى ولما تزود","https://www.aldiwan.net/poem21924.html","الطويل"],[71,"لو لم يخالط يوم بينك أدمعي","https://www.aldiwan.net/poem4029.html","الكامل"],[93,"دال السكون من الحراك الدائم","https://www.aldiwan.net/poem11373.html","الكامل"],[30,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[30,"ألا يا دار مية بالوحيد","https://www.aldiwan.net/poem29597.html","الوافر"],[88,"إن العراق بعرضه وبطوله","https://www.aldiwan.net/poem44817.html","الكامل"],[51,"ليهنك لبس المهرجان وإن غدا","https://www.aldiwan.net/poem64568.html","الطويل"],[62,"بأصفهان سقاها الله لي سكن","https://www.aldiwan.net/poem52374.html","البسيط"],[45,"طلا سألت بجو ثهمد","https://www.aldiwan.net/poem63467.html","مجزوء الكامل"],[9,"أترحلُ منْ ليلى ، ولمّا تزوّدِ،","https://www.poetsgate.com/ViewPoem.aspx?id=20029",""],[237,"أبا عمران قد جئنا إليكم","https://www.aldiwan.net/poem18155.html","الوافر"],[249,"أنية الغداة أم انتقال","https://www.aldiwan.net/poem2099.html","الوافر"],[252,"دعني ولا تلحني في دمعي الهتن","https://www.aldiwan.net/poem1423.html",""],[270,"ألا يا هند حيي الباسلينا","https://www.aldiwan.net/poem35587.html","الوافر"],[377,"قفا نبك نفسا طال منها بسورها","https://www.aldiwan.net/poem59433.html","الطويل"],[416,"وعدتن طرفي بالخيال وصالا","https://www.aldiwan.net/poem54037.html","الطويل"],[416,"قدمت قدوم الخير من بعد غيبة","https://www.aldiwan.net/poem54122.html","الطويل"],[500,"رفعت بسري كل أمري لسيدي","https://www.aldiwan.net/poem38020.html","الطويل"]],"verses":[["بِأَصدَقَ بَأساً مِنكَ يَوماً وَنَجدَةً","إِذا خامَتِ الأَبطالُ في كُلِّ مَشهَدِ",0,"د",1,0],["بِأَصَمَّ مُعتَدِلٍ وَأَبيَضَ صارِمٍ","وَجَنانِ مَضّاءِ العَزيمِ مُشَيَّعِ",1,"ع",1,0],["بِأَصَمَّ إِلاَّ أَنْ تُحَدِّثَهُ العُلَى","بِحَدِيثِ غَايَاتٍ سَمَتْ وَعَظَائِمِ",2,"م",1,0],["بِأَصفَرِ وَردٍ آلَ حَتّى كَأَنَّما","يَسوفُ بِهِ التالي عُصارَةَ خَردَلِ",3,"ل",1,0],["بِأَصفَرَ كَالسِطاعِ إِذا اِصمَعَدَّت","عَلى وَهَلٍ وَأَعصَلَ كَالعَمودِ",4,"د",1,0],["بأصح أحرار الأنام تحرُّراً","في فكره وبفعله وبقيله",5,"ل",2,0],["بأصدق جوداً منه في كل أزمة","وبأساً إذا ما الروْع ريعت فَوارسه",6,"س",2,0],["بأصفهانَ سقاها اللّهُ لي سكَنٌ","لولا الضرورةُ ما فارقْتُها نَفَسَا",7,"س",2,1],["بِأَصالَةِ الرَأيِ الزَني","قِ وَصِحَّةِ العَزمِ المُجَرَّد",8,"د",1,0],["بأصْدَقَ بأساً منكَ يَوْماً، وَنَجْدَة","ً، إذات خامتِ الأبطالُ في كلّ مشهدِ",9,"د",1,0],["بِأَصْلِ الأَصْلِ شَمْسِ الرُّسْلِ مُفْنِي","ظَلاَمَ الْمُبْطِلِينَ أَجَلِّ هَادِ",10,"د",1,0],["بِأَصدَقَ عَدوَةً مِنهُ وَبَأساً","غَداةَ الرَوعِ إِذ خَلَتِ الحِجالُ",11,"ل",1,0],["باِصطِبارٍ بعد ما عَبثَت","أَيَدي المَنايا بِذاكَ المَنظَرِ الحَسَنِ",12,"ن",1,0],["بإصلاحٍ عُرفنا أو صلاحٍ","فلم نكُ فاسِدينَ ومُفسدينا",13,"ن",2,0],["بأصدافِ أسدافِ الليالي لآلئٌ","منظَّمةٌ فيها النحورُ بُحورها",14,"ر",3,0],["بأَصدق من أَلقى المقالة لهجة","إليك وأَعلى من رأَيت فعالا",15,"ل",2,0],["بأصدق من وافى من الرّوم لهجة","ومن بعث السلطان عيناً وأرسلا",16,"ل",2,0],["بأصحابِهِ الأعيانِ والآلِ كُلِّهِمْ","أُسودِ الغُيوبِ السَّادَةِ القادَةِ الغُرِّ",17,"ر",1,0]]}