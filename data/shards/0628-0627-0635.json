{"poems":[[9,"أترحل من ليلى ولما تزود","https://www.aldiwan.net/poem21924.html","الطويل"],[73,"لو لم يخالط يوم بينك أدمعي","https://www.aldiwan.net/poem4029.html","الكامل"],[95,"دال السكون من الحراك الدائم","https://www.aldiwan.net/poem11373.html","الكامل"],[32,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[32,"ألا يا دار مية بالوحيد","https://www.aldiwan.net/poem29597.html","الوافر"],[90,"إن العراق بعرضه وبطوله","https://www.aldiwan.net/poem44817.html","الكامل"],[53,"ليهنك لبس المهرجان وإن غدا","https://www.aldiwan.net/poem64568.html","الطويل"],[64,"بأصفهان سقاها الله لي سكن","https://www.aldiwan.net/poem52374.html","البسيط"],[47,"طلا سألت بجو ثهمد","https://www.aldiwan.net/poem63467.html","مجزوء الكامل"],[9,"أترحلُ منْ ليلى ، ولمّا تزوّدِ،","https://www.poetsgate.com/ViewPoem.aspx?id=20029",""],[242,"أبا عمران قد جئنا إليكم","https://www.aldiwan.net/poem18155.html","الوافر"],[254,"أنية الغداة أم انتقال","https://www.aldiwan.net/poem2099.html","الوافر"],[257,"دعني ولا تلحني في دمعي الهتن","https://www.aldiwan.net/poem1423.html",""],[275,"ألا يا هند حيي الباسلينا","https://www.aldiwan.net/poem35587.html","الوافر"],[382,"قفا نبك نفسا طال منها بسورها","https://www.aldiwan.net/poem59433.html","الطويل"],[422,"وعدتن طرفي بالخيال وصالا","https://www.aldiwan.net/poem54037.html","الطويل"],[422,"قدمت قدوم الخير من بعد غيبة","https://www.aldiwan.net/poem54122.html","الطويل"],[505,"رفعت بسري كل أمري لسيدي","https://www.aldiwan.net/poem38020.html","الطويل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199573","المسحوب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38985","الطويل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123428","الطويل"],[965,"","https://poetry.dctabudhabi.ae/diwan/poem/73003","الوافر"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96371","الطويل"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29559","الطويل"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102726","المتدارك"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199814","المسحوب"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199634","المسحوب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27863","السريع"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109403","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109386","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77228","الكامل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121226","الوافر"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82871","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74172","الطويل"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/137981",""],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62871","الوافر"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45232","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85063","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111414","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69970","الوافر"],[4717,"كفرتُ بأمنها القومي","https://www.poetsgate.com/ViewPoem.aspx?id=199698",""],[4755,"حاصِلُ ضَربِ الغَريب ( 1 )","https://www.poetsgate.com/ViewPoem.aspx?id=184742",""],[4755,"ولِأَنَّ لِي وَطَنًا تَوَقَّدَ في","https://www.poetsgate.com/ViewPoem.aspx?id=190646",""],[4884,"أرى الظّلمَ كالدّجّالِ أعورَ","https://www.poetsgate.com/ViewPoem.aspx?id=201727",""],[4935,"شوقي إلى تلك السجايا العالية","https://www.poetsgate.com/ViewPoem.aspx?id=129478",""],[4935,"إني أقول لذي الحياء مقالاً","https://www.poetsgate.com/ViewPoem.aspx?id=129311",""],[5370,"أعيش حره","https://www.poetsgate.com/ViewPoem.aspx?id=87421",""],[5431,"صلصالها بيد الرؤى إعجازُ","https://www.poetsgate.com/ViewPoem.aspx?id=199038",""],[5586,"جلل ألم على الكرام فهالا","https://www.poetsgate.com/ViewPoem.aspx?id=173782",""],[6069,"وحق الهوى لا خنت ميثاق عهده","https://www.poetsgate.com/ViewPoem.aspx?id=105662",""],[6102,"تعدو دعد","https://www.poetsgate.com/ViewPoem.aspx?id=183318",""]],"verses":[["بِأَصدَقَ بَأساً مِنكَ يَوماً وَنَجدَةً","إِذا خامَتِ الأَبطالُ في كُلِّ مَشهَدِ",0,"د",1,0],["بِأَصَمَّ مُعتَدِلٍ وَأَبيَضَ صارِمٍ","وَجَنانِ مَضّاءِ العَزيمِ مُشَيَّعِ",1,"ع",1,0],["بِأَصَمَّ إِلاَّ أَنْ تُحَدِّثَهُ العُلَى","بِحَدِيثِ غَايَاتٍ سَمَتْ وَعَظَائِمِ",2,"م",1,0],["بِأَصفَرِ وَردٍ آلَ حَتّى كَأَنَّما","يَسوفُ بِهِ التالي عُصارَةَ خَردَلِ",3,"ل",1,0],["بِأَصفَرَ كَالسِطاعِ إِذا اِصمَعَدَّت","عَلى وَهَلٍ وَأَعصَلَ كَالعَمودِ",4,"د",1,0],["بأصح أحرار الأنام تحرُّراً","في فكره وبفعله وبقيله",5,"ل",2,0],["بأصدق جوداً منه في كل أزمة","وبأساً إذا ما الروْع ريعت فَوارسه",6,"س",2,0],["بأصفهانَ سقاها اللّهُ لي سكَنٌ","لولا الضرورةُ ما فارقْتُها نَفَسَا",7,"س",2,1],["بِأَصالَةِ الرَأيِ الزَني","قِ وَصِحَّةِ العَزمِ المُجَرَّد",8,"د",1,0],["بأصْدَقَ بأساً منكَ يَوْماً، وَنَجْدَة","ً، إذات خامتِ الأبطالُ في كلّ مشهدِ",9,"د",1,0],["بِأَصْلِ الأَصْلِ شَمْسِ الرُّسْلِ مُفْنِي","ظَلاَمَ الْمُبْطِلِينَ أَجَلِّ هَادِ",10,"د",1,0],["بِأَصدَقَ عَدوَةً مِنهُ وَبَأساً","غَداةَ الرَوعِ إِذ خَلَتِ الحِجالُ",11,"ل",1,0],["باِصطِبارٍ بعد ما عَبثَت","أَيَدي المَنايا بِذاكَ المَنظَرِ الحَسَنِ",12,"ن",1,0],["بإصلاحٍ عُرفنا أو صلاحٍ","فلم نكُ فاسِدينَ ومُفسدينا",13,"ن",2,0],["بأصدافِ أسدافِ الليالي لآلئٌ","منظَّمةٌ فيها النحورُ بُحورها",14,"ر",3,0],["بأَصدق من أَلقى المقالة لهجة","إليك وأَعلى من رأَيت فعالا",15,"ل",2,0],["بأصدق من وافى من الرّوم لهجة","ومن بعث السلطان عيناً وأرسلا",16,"ل",2,0],["بأصحابِهِ الأعيانِ والآلِ كُلِّهِمْ","أُسودِ الغُيوبِ السَّادَةِ القادَةِ الغُرِّ",17,"ر",1,0],["بآصيح وْمن يبغي ثوابي دفنّي","من قبل لا تكتب عليِّ احتشاره",18,"ر",2,0],["بِأَصحابِ كَهفٍ ربِّ قَد لَبِثوا بِهِ","ثَلاث مئينٍ ثمَّ تِسعاً لَدى العدِّ",19,"د",1,0],["بأَصبى إلى ما فارَقَتْ يوم فارقتْ","من العُشِّ والعيش الرِّضا والمُعاشِرِ",20,"ر",1,1],["بإِصْرٍ يتَّرِكْني الحيُّ يوْماً","رهينَةَ دارهمْ وهُمُ سِراعُ",21,"ع",1,1],["بأصدقَ مني يبتليني وتبتَلى","له وقعةٌ منها تُتَرُّ الجماجِمُ",22,"م",1,0],["بِأَصدَقَ بَأساً مِن خَليلِ ثَمينَةٍ","وَأَمضى إِذا ما أَفلَطَ القائِمَ اليَدُ",23,"د",1,0],["بأصولكَ لا تفخر فبِما","تأتيكَ سحاقةُ بالهمِ",24,"م",1,0],["با صاحب المعروف لك مرجعنّي","حالٍ لغيرك مستحيل الفتاوي",25,"ا",3,0],["باصبر ولو انا بالصبر كنت مغلوب","لعل صبري يوم احسن فلاحي",26,"ح",2,0],["بأصله ثم أتى شارحاً","مفرعاً بالحقِّ والصبر",27,"ر",1,0],["بأصل كريم للحسين انتسابه","سميِّ أبيهِ صاحب العز والعلا",28,"ل",2,0],["باصلهِ طاب هذا الفرع مكرمةً","وبالمنى أثمرت أغصان دوحته",29,"ت",2,0],["باصورَةً ذابَ الجَمالُ معانِيا","فيها وَسالَ إِذا أَصابَ مَسيلا",30,"ل",2,0],["باصوله قد غرني وبفرعه","ذاك الاثيث وقد امنت اصيلا",31,"ل",2,0],["بإِصغاءِ من يَهوى إِلَيكَ بِخَدِّهِ","لتلثِمهُ عِند الفراقِ على رُعبِ",32,"ب",1,1],["بِأَصحابه مَن جاهَدوا بِنُفوسِهم","وَما صَدهُم عَن ذاكَ مال وَلا أَهل",33,"ل",1,0],["باصبر وباخضع في هواها الرقاب","ولو غدا للروح ذباح",34,"ح",1,0],["بأَصدق عزمة منه وأَمضى","اذا ما عاجزُ القوم استَشَارَا",35,"ر",2,0],["بِإِصطَخَر لَم يَلبَسنَ مِن طولِ فاقَةٍ","جَديداً وَلا تُلقى لَهُنَّ الوَسائِدُ",36,"د",1,0],["بأصلي العريضي العلى ونجله","محمد الماحي رسوم المثالب",37,"ب",1,0],["بأَصرُحنا بَينَ البَنِينَ وَأَهلِنا","يَرُمنَ ولا يَبلُغنَ مِنَّا التَّدَانِيا",38,"ي",2,0],["بِأَصوات المَزاهر وَالمَثاني","وَاعلام المَسَرة وَالأَمانِ",39,"ن",1,0],["(بأصدافٍ) .. زرعْناها حياضاً","كفى (صدفاً) وأحواضاً .. كفى (زَر..)",40,"ر",1,0],["بأَصَابعٍ يَبِسَت أَشَارَ إِلى","وَطَنٍ يَكادُ عَليهِ يَتَّقِدُ",41,"د",1,0],["بأَصَابعٍ يَبِسَت أَشَارَ إِلى","وَطَنٍ يُوَاعِدُهُ ويَبتَعِدُ",42,"د",1,0],["بأَصواتِ نهشٍ للعظامِ تَكَسُّراً","وضوءٍ مُشِعٍّ من عيونِ المُعَرّدِ",43,"د",1,0],["بأصالة الرأي السديد وحزمه","جاز البسالة والصفات الغالية",44,"ي",2,0],["بأصالة الرأي السديد وفطنة","ووفاء عهد توج الأعمالا",45,"ل",2,0],["بأصنع قراري وكل شيٍ بيدي","ملّيت من صبرٍ عطاني مضره",46,"ر",2,0],["بأصابع التنين سبع خواتمٍ","درر البلاغة كنزه الممتاز",47,"ز",1,0],["باصارف الأهوال عنا من بنا","خلفت بعدك يصرف الأهوالا",48,"ل",2,0],["بأصبر من قلبي على فقد صبره","ومنى على فقد الحبيب وبعده",49,"د",2,0],["بأَصَابِعٍ دَبَّتْ عَلَى فِكَرِي","صُوَرًا ؛ وَ مَا لِي دُونَهَا بُدُّ",50,"د",1,0]]}