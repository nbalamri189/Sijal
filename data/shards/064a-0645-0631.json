لعين","https://www.poetsgate.com/ViewPoem.aspx?id=171001",""],[186,"أيا ليلة بالأنس راقت كؤوسها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55784&r=&rc=47",""],[6193,"ألا لا يعيب المجد والفضل إقلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55438&r=&rc=14",""],[6198,"ناي الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79296&r=&rc=70",""],[6225,"عَولَمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80968&r=&rc=237",""],[6225,"نسيمُ الخلود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81328&r=&rc=355",""],[422,"عادَ المتَّيم في غرامكَ داؤهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22253&r=&rc=9",""],[6308,"صوتٌ من الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87726&r=&rc=4",""],[6314,"بكائية الليل الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88067&r=&rc=2",""],[5126,"متى أعيش؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87816&r=&rc=31",""],[5567,"أنا قلق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81752&r=&rc=25",""]],"verses":[["يَمُرُّ صَوتي فَلا يُلوي بِجانِبِهِ","وَكانَ يَكفيهِ إيمائي وَإِلماعي",0,"ع",2,0],["يَمُرُّ الغِناءُ فَيَعتاقُني","وَعِشقُ الحُروبِ ثَنى مِن جِماحي",1,"ح",2,0],["يَمري عَلَيكَ مِنَ النُعامى خِلفَه","مِن عارِضٍ مُتَبَزِّلٍ أَنداؤُهُ",2,"ا",3,0],["يَمري أكُفَّهُمُ إنْ حارَدَتْ سَنَةٌ","فيَسْتَدِرُّ أفاويقَ الغِنى الرّاجي",3,"ج",2,0],["يَمُرُّ بِهِمْ وَقَدْ ثَمِلُوا افتِخَاراً","وَإعْيَاءً فَكُلُّهُمُ نِيَامُ",4,"م",1,0],["يمرّ بها الدهر مطمورة","تعاني الدمار وتدعو الحرب",5,"ب",1,0],["يمرّ كالريح لم تسمع لأرجله","سوى حفيف كنفخ في الأنابيب",6,"ب",1,0],["يمرّ بها العالي فتعلو تسلّقاً","ويعترض الوادي فتجتازه وثبا",7,"ب",2,0],["يمر زحفاً بين أشداق الأسد","لولا كرام أدركوني بالمَدَد",8,"د",1,0],["يمرّ فوق جناح الريح مخترقاً","عرض الفضاء ويَعدو وهو مُعتزِم",9,"م",1,0],["يُمرُّ عصراه كلّ مُنتكث","ونقضُهُ عائد على المِرَرِ",10,"ر",1,0],["يُمرّ العطايا والمنايا لأهلها","بأخفضِ بالَيْه مُجدّاً كهازِلِ",11,"ل",1,0],["يُمرُّ العطايا والمنايا لأهلها","على هِينة منه ولا يتندّمُ",12,"م",1,0],["يَمْرِيه خاطِرُهُ فيُمْطِرُهُ","ما شاء من نِعَمٍ ومن نِقَمِ",13,"م",1,0],["يَمري الجَلاجِلَ مَنكِباهُ كَأَنَّهُ","قُرقورُ أَعجَمَ مِن تِجارِ أُوالِ",14,"ل",1,0],["يَمُرُّ بِالقُربِ مِنّا لا يُكَلِّمُنا","وَلِلحَديثِ مَجالٌ وَهوَ مِلسانُ",15,"ن",1,0],["يَمُرُّ بي مُلتَفِتاً","فَهَل رَأَيتَ الظَبيَ قَط",16,"ط",1,0],["يَمُرّ حينا وَتَخلو لي حَوادِثُهُ","فَقَلَّما جَرحت إِلّا اِنثَنَت تاسو",17,"و",1,0],["يمر على ظهر الصلاة وقد حكى","حساماً على كبش يريد به عبرا",18,"ر",2,0],["يَمُرُّ عَلَيكَ خَليطُ الخُطوبِ","وَيَجتازُكَ الخِفُّ وَالمُثقَلُ",19,"ل",1,0],["يَمُرّونَ مَرَّ البَرقِ تَحتَ دُجُنَّةٍ","دُخاناً بِهِ أَشباحُهُم تَتَجَلبَبُ",20,"ب",1,0],["يَمُرُّ مِنَ السُمِّ الوَحِيِّ بِعاجِزٍ","وَيَعبُرُ مِن أَفواهِهِنَّ عَلى دُردِ",21,"د",1,0],["يَمُرُّ بِقَبرِكِ العافي فَيَبكي","وَيَشغَلُهُ البُكاءُ عَنِ السُؤالِ",22,"ل",1,0],["يَمرونَها ساعَةً مَرياً بِأُسؤُقِهِم","حَتّى إِذا ما بَدا لِلغارَةِ النَعَمُ",23,"م",1,0],["يمر الناسُ ما مروا وشاءوا","على هَذا الثرى متنقلينَا",24,"ن",2,0],["يَمُرُّ بِوَهمي خاطِرٌ فَيَؤُدُّها","وَيَجرَحُها دونَ العِيانِ لَها فِكري",25,"ر",2,0],["يَمُرُّ العَهدُ بَعدَ العَهدِ شَرّاً","فَأَينَ الخَيرُ وَالعَهدُ الأَنيَقُ",26,"ق",1,0],["يَمُرُّ بآخِرينَ لهم عُواءٌ","يُشيَّعُ بالتوجُّعِ والنَّحيبِ",27,"ب",1,0],["يَمُرُّ إِذا حُلَّ مَرَّ مُقَزَّعٍ","عَتيقٍ حَداهُ أَبهَرُ القَوسِ جارِنِ",28,"ن",1,0],["يَمُرنَ مَورَ المَها تُزجى جَآذِرَها","إِذا تخافُ عَلَيها مَوضِعَ الثُكَنِ",29,"ن",1,0],["يَمُرُّ بِكَ الزَمَنُ الدَغفَلِيُّ","وَكَم فيهِ مِن رَجُلٍ أَسنَتا",30,"ت",2,1],["يَمُرُّ عَلى الجِبالِ وَهُنَّ صُمٌّ","فَيُعطي الوَهنَ راسِيَةَ الجِبالِ",31,"ل",1,0],["يَمُرُّ الحَولُ بَعدَ الحَولِ عَنّي","وَتِلكَ مَصارِعُ الأَقوامِ حَولي",32,"ي",1,1],["يمُرّ بهِ رَأدُ الضّحَى مُتنكّراً","مَخافَةَ أن يَغْتَالَه بقَتامِهِ",33,"م",2,0],["يَمُرُّ كَمِرِّيخِ المُغالِي اِنتَحَت بِهِ","شِمالُ عِبَادِيِّ عَلى الرِيحِ أَعسَرا",34,"ر",2,0],["يمر بنا الدَّهر في جريه","فنهرم وَالدَّهر لا يهرمُ",35,"م",1,1],["يَمُرُّ بِالْوَحْشِ صَرْعَى فِي مَكَامِنِهَا","فَمَا تَبِينُ لَهُ شَدّاً فَتَنْخَذِلُ",36,"ل",1,0],["يَمُرُّ بِالْهَامِ مَرَّ الْبَرْقِ فِي عَجَلٍ","وَقْتَ الضِّرَابِ وَلَمْ يَعْلَقْ بِهِ بَلَلُ",36,"ل",1,0],["يَمُرُّ بِيَ الإخْوَانُ فِي خَطَرَاتِهِمْ","أُولَئِكَ عُوَّادِي وَلَيْسُوا بِجُلاَّسِي",37,"س",2,0],["يمرُّ صريرهُ بالأُذْن طورًا","كأنمُل كاعبٍ عَزَفت بعود",38,"د",1,0],["يمر بنا ركب ويتلوه غيره","ويسبقه ركب وفي الأرض أقحموا",39,"م",3,0],["يمر عليك الدهر والدهر عابس","وفضلك فيه ازهر الوجه مبسم",39,"م",1,0],["يمر القارظان ونحن ندري","بأن مسيرنا نحو الكمين",40,"ن",1,0],["يَمُرَّانِ فوقَ الرُّبى والسفوحِ","ويخترقانِ سُدوفَ الدُّجى",41,"ا",1,0],["يمرُّ عامٌ ويكرُّ عامُ","بها إلى أن تنفذ الأعوام",42,"م",1,0],["يَمُرُّ بِهَا عهْدُ الصِّبا وَالتَّدَلُّلِ","عَلَى شَظَفٍ فِي عيْشِهَا وَتَذَللِ",43,"ل",1,0],["يَمُرُّ حينا وَتَحلو لي حَوادِثُهُ","فَقَلَّما جَرحتْ إِلّا انثَنَتْ تَاسُو",44,"و",1,0],["يمري عليك من النعامى خلفه","من عارض متبرل اندؤاه",45,"ا",3,0],["يُمريهِ العُمر الطَويل مضيعاً","عَلى الكُره مِنهُ بَينَ واشٍ وَحَسَد",46,"د",1,0],["يَمرّ عَلى دار الحَبيب مُحَمحِماً","جَوادي بِذكر السالِفات المَواقِفِ",47,"ف",1,0],["يمر بنا نسيم الحب ليلا","فيلفى في جوانحنا اشتعال",48,"ل",1,0],["يمر بي الرهط من قومي يقال له","من ذا يقول لسقمي لست اعرفه",49,"ف",2,0],["يمر علي الصيف يلحقه الشتا","يبعدي ويضنيني شتائي والصيف",50,"ف",1,0],["يمر الليالي ساحرا متفكرا","يبدل بري والتقى بعيوب",51,"ب",1,0],["يمر به مر البروق وينثني","وقد جهدته حدة الطيران",52,"ن",1,0],["يمر عليّ زمانُ الرّبيع","ولا العيشُ حلوٌ ولا الكأسُ مُرّ",53,"ر",1,1],["يَمرُّ نَسيمُ الشُكرِ في عَذَباتِهِ","فَيَنشُرُ عُرفَ الطِّيبِ في كُلِّ مَوقفِ",54,"ف",1,0],["يمرّ جاري بقصّاب يُساومهُ","فما يرى لي خبزٌ غير مثرود",55,"د",1,0],["يمر به الخطاف في الحربِ عابساً","وقد صار طرفُ الشمسِ مِ النقعِ أرْمَدا",56,"د",2,0],["يمر الزمان ولا نلتقي","وقد جلب البين ما نتقي",57,"ق",2,1],["يَمُرُّ عَلى وَجهِ الثَرى فَتِخالُهُ","تَدَفَّقَ رَقراقٍ مِنَ الماءِ سَلسالِ",58,"ل",1,0],["يَمُرُّ المَوجُ تَحتَ مُشَجَّراتٍ","يَلينُ الماءَ بِالخُشُبِ الصِحاحِ",59,"ح",1,0],["يمرّون أطيافاً فأسمعُ هَمسَهُم","وأمشي على ماضٍ كثيرِ الخرائب",60,"ب",1,0],["يمر العيد بالصبيان لَهوا","وَلَيسَ لهم مَع الصبيان عيد",61,"د",1,0],["يَمُرُّ مَعَ الْغَوايَةِ كَيْفَ شاءَتْ","وَيَعْذُلُ في تَطَرُّفِها الأَناما",62,"م",2,0],["يمر الدرهم الصيَّاح فيها","جواداً ما يُعرِّج للمقيل",63,"ل",1,0],["يمرّ الشهر بعد الشهر","والعام مع العام",64,"م",1,0],["يمرّ كصورة ممسو","خة الألوان في فكري",65,"ي",1,0],["يَمرّ بِها الصبا المعتلُّ يروي","لَنا خَبَراً صَحيحاً عَن ثَناها",66,"ا",3,0],["يَمُرُّ على القرطاس مَرّاً بَنانُه","كما بَرَقَتْ للشّائمينَ السحائب",67,"ب",1,0],["يَمرونَهُنَّ إِذا ما راعَهُم فَزَعٌ","تحتَ السَّنَوَّرِ بالأَعقابِ والجِذَمِ",68,"م",1,1],["يَمُرُّ عَلى سَمعي المَلامُ بِطافِحٍ","فَيَدمَغُهُ عَنّي الغَرامُ بِراسِ",69,"س",1,0],["يَمُرُّ عَلَيهِ بِالذِكرى قَليلاً","وَيُضجِرُ فِكرَهُ فَيَقولُ مُرّي",70,"ر",2,0],["يَمُرُّ بِهِ ثَوبُ الجَديدَينِ دائِماً","فَيَبلى وَلا يَبلى وَإِن بَلى الدَهرُ",71,"ر",1,0],["يُمرُّ نَداهُ على القاصِدي","نَ ويحسَبُ للقاصِدين المِنَن",72,"ن",1,0],["يمر به ذاك النسيم معطراً","بزهر به ضياؤه متبلج",73,"ج",1,0],["يَمرَحُ مَن تُروى لَهُ","مِن غَيرِ سُكرٍ وَثَمَل",74,"ل",1,0],["يَمرَجُ جارُ استِها إذا وَلَدَت","يَهدِرُ مِن كلِّ جانِبٍ خُصُمُ",75,"م",1,0],["يمر بها من كان يهواه قائلاً","فديناك من ربع وإن زدتنا كربا",76,"ب",2,0],["يمرُّ بسَخْطك حلوُ المذاق","ويحلو بنائِلك العلقم",77,"م",1,0],["يمرُّ بنادي الأَكرمين ثناؤه","كما مرَّ نجديُّ النَّسيم بعاطر",78,"ر",1,0],["يمرُّ بنا الشّقيُّ فنبتليه","ونزهد بالتقيّ المستفيق",79,"ق",1,0],["يمري عليها الربّ كلّ عشيَّة","وتجودها من صيّب أنداؤه",80,"ا",3,0],["يمرّ العامُ فيه مرورَ يومٍ","ويمضي اليومُ منه بفضلِ عامِ",81,"م",1,0],["يمرّ فيغتال العقولَ بسَكْرةٍ","تدوم بنا حتى تمرَّ بنا أخرى",82,"ر",2,0],["يُمرِغُ الأمَّةَ في رجسه","ويسرق الأمةّ في رِفده",83,"د",2,0],["يمرُّ المِهرجانُ وكلُّ عيدٍ","بنعمتكم فيغنم من جَداها",84,"ا",3,0],["يمرح في مِقوده ذئبُ الغضا","وتوعِد الوحشَ به القشاعمُ",85,"م",1,0],["يمرُقن زُرقاً من يدي حدائداً","تُنحى أعاديكم بها وتُنتَبَلْ",86,"ل",1,0],["يمرّ عليك العامُ فالعامُ سالماً","فتختمه سعداً كما تستهلُّهُ",87,"ل",2,0],["يَمُرُّ فيُرغِب في أضلُعِي","صُدوعاً برَجعتِة تُشْعَبُ",88,"ب",1,0],["يَمُرُّ بها لا بائعاً يستحلُّها","بِملْكٍ ولا مستوهباً يستطيبُها",89,"ب",3,0],["يمرُّ اذا تُشاغبهُ الأعادي","ويعذبُ في المكارم والنِّدامِ",90,"م",1,0],["يمْرونَ أخْلافَ النَّوالِ لهُ","فكأنَّهُمْ أغْرَوا وما عَذلَوا",91,"ل",3,0],["يمرُّ بسمعي عذلهُ غير ناجحٍ","كما سمع الصمُّ السّرار من البحِّ",92,"ح",1,0],["يَمُرُّونَ بِالدَهنا خِفافاً عِيابُهُم","وَيَخرُجنَ مِن دارِينَ بُجرَ الحَقائِبِ",93,"ب",1,1],["يمر سريعاً كطيفِ المنا","مِ جميع الانام وتفنى الدنا",94,"ن",2,0],["يَمُرُّ الواحِدُ الطَّيَّارُ منها","فَيَفْتُكُ حينَ يَهْجِمُ بالأُلوفِ",95,"ف",1,0],["يمرّ على حَصى الوادي فيبكي","فينتثِرُ العقيقُ على الجُمانِ",96,"ن",1,0],["يَمُرّونَ الصَّفاةَ كما أَتَيْنا","ولا لَغَطٌ هُناكَ ولا جُحُودُ",97,"د",1,0],["يمرُّ عليَّ يومُ البُؤسِ فيهِ","كما قد مرَّ يومُ المِهرَجانِ",98,"ن",1,0],["يَمُرُّ كالريحِ في رفْقٍ وفي دَعةِ","ويسبقُ البرقَ مَشْكُولاً على مَهل",99,"ل",1,0],["يمرُّ عليَّ الحوْلُ والحَوْلُ بعدَه","فقد غيَّر الأَحوالَ منِّيَ أَحْوَالُ",100,"ل",1,0],["يَمُرُّ الرّاغِبُونَ به وأنسى","زيارَتَها على قُربِ المَزار",101,"ر",1,0],["يمرن أبناه على المجد صبيةً","كما مرن البازي كف الملاعب",102,"ب",1,0],["يمر فيشرئب كشبه ضبي","رأى حول الورود القانصينا",103,"ن",2,0],["يمرُّ على الاشجار عرفُ نسيمها","فتطفو على الانهار من زَهرها زُهرُ",104,"ر",1,0],["يمرَحنَ تيهاً كالظبا","ءِ وهنَّ أَحلى من أَمل",105,"ل",1,0],["يمرُّ على حَبائه فكأنّهُ","صفا الدمعِ في عِقدِ الفتاةش التي أعني",106,"ي",1,0],["يمر فمن لينٍ وحُسّن تعطّف","يقال به سُكّرٌ وليس به سُكْر",107,"ر",1,0],["يمرُّ علَى حصبائِهِ فكأنَّه","صَفَا الدَّمع في عقدِ الفتاةِ الَّتي أعني",108,"ي",1,0],["يمرُّ كمرِّ الريح في كل صَحْصَحٍ","بعيدِ مَرام الوِرْدِ شُهبٍ ودائقه",109,"ق",2,0],["يَمُرّونَ بِالدَهنا خِفافاً غِيابُهُم","وَيَرجِعنَ مِن دارينَ بُجرَ الحقائِبِ",110,"ب",1,1],["يمرقن من تحت الغوارب أسهما","ويعد من حر الهواجر سُهَّما",111,"م",2,0],["يَمُرُّ بي وَفدُ الصِبا","وَاللَيلُ يَقضي نَحبُهُ",112,"ب",2,