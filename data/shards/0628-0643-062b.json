{"poems":[[4,"سفها عذلت وقلت غير مليم","https://www.aldiwan.net/poem21199.html","الكامل"],[292,"بان الخليط ورفع الخرق","https://www.aldiwan.net/poem1915.html","أحذ الكامل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67821","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96677","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136215","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126929","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[5582,"أَبُدُورُ تَمٍّ كالبُدُورِ طَوالِعُ","https://www.poetsgate.com/ViewPoem.aspx?id=63530",""]],"verses":[["بِكَثيبِ رابِيَةٍ قَليلٍ وَطؤُهُ","يَعتادُ بَيتَ مُوَضَّعٍ مَركومِ",0,"م",1,0],["بِكَثيبِ حَربَةَ أَو بِحَومَلَ أَو","مِن دونِهِ مِن عالِجٍ بُرَقُ",1,"ق",1,0],["بِكَثْرَةِ أَشْوَاقي لِيعْقُوبَ وَارِثُ","غَزَالٌ لِقَلْبي بِالْمَلاَحَةِ أَدْهَشَا",2,"ش",2,0],["بكَ ثبّت اللّه الممالكَ مثلما","قَد ثبّتت في الراحتين الأصابعُ",3,"ع",1,0],["بكثرة ذكري للحبيب محمد","فان لروحي نشوة حين يذكر",4,"ر",1,0],["بكثرة المال لا فخر عليه لكم","فدونكم هو حاز المجد والحسبا",5,"ب",2,0],["بكثرة الصمت تُهاب صُحِّحا","دنياك بالأخرى فبع لتربحا",6,"ح",2,0],["بِكَ ثَبَّتَ اللهُ المَحامِدَ مِثْلَما","قَدْ ثُبِّتَتْ فِي الرَّاحَتَيْنِ أَصابِعُ",7,"ع",1,0]]}