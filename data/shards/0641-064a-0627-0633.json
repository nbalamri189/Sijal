ت قرير عين","https://www.aldiwan.net/poem34819.html","الوافر"],[441,"كفى البدر حسناً أن يقال نديدها","https://www.aldiwan.net/poem14342.html","الطويل"],[441,"أيا شارباً كأس خمر الرقاد","https://www.aldiwan.net/poem14364.html","المتقارب"],[443,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[452,"ظفر ترى ما أراه أم ناب","https://www.aldiwan.net/poem13637.html","المنسرح"],[464,"عيون المهى قلبي بنبلك مجروح","https://www.aldiwan.net/poem3149.html","عموديه"],[464,"دعاني من ذكر العذيب وعهده","https://www.aldiwan.net/poem3609.html","عموديه"],[465,"في رحاب الحسين","https://www.aldiwan.net/poem59034.html","عموديه"],[477,"ولوع بتذكار الأحبة لا يفنى","https://www.aldiwan.net/poem15292.html","الطويل"],[482,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[515,"عسى منجد الأظعان يوماً يغيرها","https://www.aldiwan.net/poem12160.html","الطويل"],[515,"قل لابن دخان إذا جئته","https://www.aldiwan.net/poem12181.html","السريع"],[529,"أيا بين كم كدرت صفو المشارب","https://www.aldiwan.net/poem37536.html","الطويل"],[538,"متى أخدرت إلا الأسود الضراغم","https://www.aldiwan.net/poem47961.html","عموديه"],[538,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[549,"يئست من الحذية أم عمرو","https://www.aldiwan.net/poem444.html",""],[551,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[551,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[551,"خل المدامع في المنازل تسفح","https://www.aldiwan.net/poem47902.html","الكامل"],[559,"دجى غيهب التفريق قد زال واشمطا","https://www.aldiwan.net/poem69352.html","الطويل"],[575,"جلست ببستان الجليس وداره","https://www.aldiwan.net/poem2724.html","الطويل"],[575,"أيدفعني الدهر عن مطلبي","https://www.aldiwan.net/poem2750.html","المتقارب"]],"verses":[["فَيا سَعْدُ ناولني السُّرَيْجِيَّ إِنَّهُ","شَكا ظَمَأً بَرْحاً وقد حان أَنْ يَرْوَى",0,"و",2,0],["فَيا سَعْدُ كُرَّ اللّحْظَ هلْ تُبْصِرُ الحِمى","فإنْسانُ عَيْني في الدّموعِ غَريقُ",1,"ق",1,0],["فيا سَقى اللهُ زَوراءَ العِراقِ حَياً","تَرْوى بشُؤبوبِهِ قُورٌ وغِيطانُ",2,"ن",1,0],["فَيَا سَرْحَ ذَاكَ الْحَيّ لَوْ أَخْلَفَ الْحَيَا","لأَغْنَاكَ مِنْ صَوْبِ الدُّمُوعِ صَبِيبُ",3,"ب",1,0],["فَيا سائِلي أَينَ المُروءَةُ وَالوَفا","وَأَينَ الحِجا وَالرَأيُ وَيحَكَ هاهِيا",4,"ي",2,0],["فَيا سَنَةً مَرَّت بِأَعوادِ نَعشِهِ","لَأَنتِ عَلَينا أَشأَمُ السَنَواتِ",5,"ت",1,0],["في اِسمٍ لِبَدرٍ ما رَنَت أَلحاظُهُ","إِلّا وَأَهدَت لِلنُفوسِ تَلافَها",6,"ف",3,0],["فَيَا سُرُوراً بِذِكْرٍ أَنْتَ بَاعِثُهُ","وَيَا أَسىً لِحِمَى بِالجَهْلِ مُنْقَسِمِ",7,"م",1,0],["في أسعد ألوقات","وطالع الإسعاد",8,"د",1,0],["فيا سيف شكري وكل الورى","غدت تضرب اليوم فيك المثل",9,"ل",1,0],["في أساق لم يغد فيها الوليدا","ن ولم يُعكم الأجير الأجيرا",10,"ر",2,0],["فيا سَاسَتَا هاتوا لنا من جوابِكم","ففيكم لعَمرِي ذو افانينَ مِقوَلُ",11,"ل",1,0],["فيا سرور عليٍّ من محمدها","بالقربِ يرقص بيتاً وهو معمور",12,"ر",1,0],["فيا سوأتا من شيب رأسك بعدها","إذا ما انتحى فيك الغلام الحزوَّر",13,"ر",1,0],["فيا سوأتا للظرفِ والفتكِ أصبحا","يُناكان في شيخ يُناك لدنُ قُمِطْ",14,"ط",1,0],["فَيا ساكِني مِصرٍ تُراكُم عَلِمتُمُ","بِأَنِّيَ ما لي عَنكُمُ الدَهرَ سُلوانُ",15,"ن",1,0],["فَيا ساعَةً ما كانَ أَقصَرَ وَقتها","لَدَيَّ تَقَضَّت غَيرَ مَندومَةِ العَهدِ",16,"د",1,0],["فيا سردار مصر لك الأيادي","فأنت لها المعين على الأعادى",17,"ا",1,0],["فَيا سَعدُ جُرحُكَ ساءَ الرِجالَ","فَلا جُرِحَت فيكَ أَوطانُها",18,"ن",3,0],["فيا سَرحتَيْ وداي العقيقِ سقاكما","وإن لم تُظِلَّانِي الغَمامُ الرواجِسُ",19,"س",1,0],["فيا سطوةَ الأيَّام ِعُودي لسِلْمِها","كما كنتِ قبلَ اليومِ مَغلولةَ اليَدِ",20,"د",1,0],["فَيا سَوءَتا لِلشَيبِ إِذ صارَ أَهلُهُ","إِذا هَيَّجَتهُم لِلصِبا صَبوَةٌ صَبَوا",21,"و",2,0],["فَيا ساعِدَ اللَهُ المُحِبَّ لِأَنَّهُ","يَرَى غَمَراتِ المَوتِ ثُمَّ يَزورُها",22,"ر",3,0],["فيا سيّداً زُرْناهُ حيّاً وميّتاً","فما زَالَ في هذا الجنابِ المعظمِ",23,"م",1,0],["فَيا سائلي عَن أَهلِ ذا العصرِ دعْهُمُ","فبالفَرْعِ منهم يُسْتَدَلّ على الأصْلِ",24,"ل",1,0],["فيا ساكِنَ القَبرِ الَّذي ضَمّ تُرْبُهُ","شَهيداً كَأَنّ المَوتَ كان له شَهدا",25,"د",2,0],["في أساطيلَ ترى أحشاءَها","لبناتِ الرّومِ فيهنّ انتحاب",26,"ب",1,0],["فَيَا سَمِيرَ فُؤَادِي","فِي يَقْظَتِي وَمَنَامِي",27,"م",2,0],["فيا سائلي عنْ مذهبي إنَّ مذهبي","ولاءٌ بهِ حبُّ الصحابةِ يُمزجُ",28,"ج",1,1],["فيا سريعَ النظمِ لا زلتَ في","خيرٍ مديدٍ كاملٍ وافرِ",29,"ر",1,0],["فَيا سَرحَتَي وادي شُرَيحَ أَلا اِسلَما","وَلا زالَ خَضراً مِنكُما الفَنَنانِ",30,"ن",1,0],["فَيا ساكِني أَكنافِ نَخلَةَ كُلُّكُم","إِلى القَلبِ مِن أَجلِ الحَبيبِ حَبيبُ",31,"ب",1,0],["في أَسالِيبَ حِسَانٍ غَضَّةٍ","وفُنُونٍ حُرّةٍ لم تُطْرَقِ",32,"ق",1,0],["فَياسَلمَ لا تَخشَي بِكَرمانَ أَن أُرى","أُقَسِّسُ أَعراجَ السَوامِ المُرَوَّحِ",33,"ح",1,0],["فَيا سَقَما فَقدُ الحَبيبِ إِذا نَأى","وَرُؤيَتُهُ في النَومِ أَودى مِنَ الفَقدِ",34,"د",1,0],["فَيا سِربي لِتُدرِكنا المَنايا","وَنَحنُ عَلى السَجِيَّةِ أَصدِقاءُ",35,"ق",3,0],["فَيا سَحابَ المَنونِ سِلتِ بِنا","هَل لَكِ أُخرى الزَمانِ إِنجامُ",36,"م",1,0],["فَيا سَعدُ كَم خَرَجَت ظَبيَةٌ","تَرودُ بِخَضراءَ سَعدِيَّه",37,"د",3,0],["في أُسرَةٍ يَومَ الحِفاظِ مَصالِتٍ","كَالأُسدِ لا يُنمى لَها بِفَريسِ",38,"س",1,0],["فَيَا سَرَوَاتِ الْحَيِّ هَلاَّ أَجَبْتُمُ","دُعاءَ فَتىً مِنْكُمْ قَرِيبِ الْمَنَاسِبِ",39,"ب",1,0],["فَيَا سَعْدُ حَدِّثْنِي بِأَخْبَارِ مَنْ مَضَى","فَأَنْتَ خَبِيرٌ بِالأَحَادِيثِ يَا سَعْدُ",40,"د",1,0],["فَيَا ساكِنِي الْفُسطَاطِ ما بالُ كُتْبِنَا","ثَوَتْ عِنْدَكُمْ شَهْراً وَلَيْسَ لها رَدُّ",40,"د",1,0],["فَيَا سَرَاةَ الْحِمَى ما بَالُ نُصْرَتِكُمْ","ضَاقَتْ عَلَيَّ وَأَنْتُمْ سادَةٌ نُجُبُ",41,"ب",1,0],["فَيَا سَامَحَ اللهُ الشَّبَابَ وَإِنْ جَنَى","عَلَيَّ وَحَيَّا عَهْدَهُ سَبَلُ الْقَطْرِ",42,"ر",1,0],["فِي أَسَارِيرِهِ لِمَنْ يَجْتَلِيهَا","يَتَرَاءَى الذَّكَاءُ وَالإِقْدَامُ",43,"م",1,0],["فَيَا سَتَةً أَذَاقَتْنَا","مَرَارَةَ خَيْبَةِ الأمَلِ",44,"ل",1,0],["فِي اسْمِ الهِلالِيِّ رَمْز","لا يُخْطِيءُ اللُّبُّ كَشْفَهْ",45,"ف",2,0],["فِي أُسْدِ غابٍ تَسْتَطِي","رُ وَفِي ذُبَابٍ وُقَّعِ",46,"ع",1,0],["فَيَا سَيِّدَ الدهْرِ المُعَزَّى بِفَقْدِهَا","أَنخشى عَليْكَ اليَوْمَ مِنْ صَوْلَة الدَّهْرِ",47,"ر",1,0],["فَيَا سُوءَ مَا يُجْدِيهِمِ فِي مَعَاشِهِمْ","تَجَرُّدُهُمْ لِلعِلْمِ كُلَّ التَّجَرُّدِ",48,"د",1,0],["فَيَا سَنَةً عَدَدْنَا مِنْ","أسَى سَعَاتِهَا عَدَّا",49,"د",2,0],["فيا سهيل هل ترى","أسئلة مدلّهه",50,"ه",1,0],["فيا ساكني فَجَواتِ البطاح","هنيئاً لكمْ أُيُّها الخالدونا",51,"ن",2,0],["فيا سامعَ الشَّكْوَى وَيَا كاشفَ البَلا","إِذَا نَزَلَتْ في العالَمِينَ الشَّدَائدُ",52,"د",1,0],["فيا سقى الله اطلال الحمى انتظمت","بالقرب منك بذاك المحضر العطر",53,"ر",1,0],["فيا سفرا منهم تمادى به المدا","وقد غيبت تلك المظاهر في الغيب",54,"ب",1,0],["فيا سميراً إذا عزّ السمير لقد","سامتني بعدك أشواق وأحزان",55,"ن",1,0],["فيا سميري عن التقصير معذرةً","فأن غايةَ مدحي مبدأُ العملِ",56,"ل",1,0],["فَيَأساً فَما عَهدُ الكَثيبِ بِعائِدٍ","إِلَيكَ وَلا أَيّامُهُ بِرَواجِعِ",57,"ع",1,0],["في اسخى الملوك علا ومجداً","ويا من كل فوق عنه دون",58,"ن",1,0],["في اسم رباعي يكون خمسه","فيما اقتضاه وزنه لا زبره",59,"ر",2,0],["فَيَأسكُم مِن رُجُوعِي بَعدَ مُنصَرَفي","نِطافُ دِجلَةَ تُغنِيني عَنِ الجُرَعِ",60,"ع",1,0],["فَيَا سائِلي عَن شَأنِ فَضلٍ وَلَم يَزَل","بَغيضاً إِليَّ العالِمُ المُتَجاهِلُ",61,"ل",1,0],["فَيا سَعدَهُ يَوماً بِلُقيايَ سَيِّداً","أَبَرَّ عَلى الساداتِ حَزماً وَنائِلا",62,"ل",2,0],["فَيا سائِلاً عَنهُ وَما مِن جَهالَةٍ","تُسائِلُ بَل تُبدي لِأَمرٍ تَجاهُلا",62,"ل",2,0],["في أسرةٍ نَقَمَت عليَّ لرأفتي","بفقيرها وصَراحتي وترَفّعي",63,"ي",1,0],["فياسورة لو أن غليوم رازها","ولكنّ شيطان الملوك جسورُ",64,"ر",1,0],["فيا سُؤلَ قلبي أوضِحي مسلك المُنى","لروحي فقد حَيَّرتِها في أُمورها",65,"ر",3,0],["فيا سيد الرسل الكرام ومن غدا","عليه لواء الحمد بالنصر يرقم",66,"م",1,0],["فيا سائق الاظعان عج بطويلع","سحيرا وحي الفازلين بها عنا",67,"ن",2,0],["فيا سيد الكونين انت وسيلتي","اذا ضاق بي ذرعا واوسعني قمطا",68,"ط",2,0],["فيا سقى الله سُكانَ النُّجَيْدِ ومَنْ","حَلَّ النُّجَيْدَ وَحَياه بِمُنْسَجمِ",69,"م",1,0],["فيا ساقِيَيَّ استعجلا لِي وصَرِّفا","عُقَارَكما إن شِئْتماه أو امْزُجا",70,"ج",2,0],["فَيا سَقَمي بِذي طَرَفٍ سَقيمٍ","وَيا قَلَقي مِن القَلِقِ الوِشاحِ",71,"ح",1,0],["فيا سيّداً غير حالي طلا","مدائحِه قطّ لا أحتسي",72,"س",2,0],["فيا سحقاً لعبدٍ بل ومحقاً","له إن لم يكن لله ذاكر",73,"ر",1,0],["فَيا سَيدي ان الزَمان معاندي","وَأَنتَنور لنا بك الناس تَهتَدي",74,"ي",1,0],["فَيا سَيِّدَ الرُّؤَساءِ الَّذِي","نَ سادُوا وَسَيِّدَ أَهْلِ الزَّمانِ",75,"ن",1,0],["فَيا سيِّداً مذ غالني الدَهرُ قربَه","وَقفتُ عليه لوعتي وهُيامي",76,"م",2,0],["فيا سعد سر بي نحوهم وأبلغنهم","بأني على حفظ المودة والعهد",77,"د",1,0],["فيا سعد إن كنت لي مسعداً","فهيا وهيا نطوف البلاد",78,"د",1,0],["فَيا سرعانَ ما وطّنتُ نَفسي","عَلى ما غيرهُ بالحرّ أَحرى",79,"ر",2,0],["فَيا سوءَ حَظّي أَن قَضَيتُم بِجَفوَتي","وَيا طولَ لَيلٍ فيهِ يَحتَكِمُ السُهدُ",80,"د",1,0],["في اساهن نفحة","في الطيور السواجع",81,"ع",1,0],["فَيا سَعادة ذي حلم أَقرَّ بِما","بِهِ سَعدنا وَيا خسران من جحدا",82,"د",2,0],["فَيا ساكِني لُبنان بِالعزِّ أَبشروا","فَطالع عَهد الذُلّ وَلَّت غَواربُه",83,"ب",2,0],["في أَسعَدِ الأَيّامِ وَالأَزمانِ","مُبَشِّراً بِالأَمنِ وَالأَمانِ",84,"ن",1,0],["فيا سَيّداً ما مثْلُ سُؤدَدِه اغتدَى","لذي شَرَفٍ يوماً من النّاسٍ سُؤدَد",85,"د",1,0],["فَيا ساكِنَ القَلبِ الَّذي هُوَ طائِرٌ","وَيا حاضِرَ القَلبِ الَّذي هُوَ غائِبُ",86,"ب",1,0],["فيا ساتراً عنا حقيقة دينه","بدعواه أن الدين بالسر يستخفي",87,"ف",2,0],["فيا سعدَ من قد جاء نحويَ طالباً","بتوبته عفواً ومغفرةَ الوِزر",88,"ر",1,0],["فَيا سافِحاً دَمعي وَيا سافِكاً دَمي","وَيا سالِباً لُبي وَيا مالِكاً رقي",89,"ق",2,0],["فياستار يا غفار استر","وأغفر كل عصياني والأوزار",90,"ر",1,0],["فيا سوأتا حَتَامَ أصبحُ حامداً","لِغير إلَه العالمين وشاكرا",91,"ر",2,0],["فيا سيد الرسل الكرام ومن أتى","بخير كتاب أعجز الإِنس والجنا",92,"ن",2,0],["فيا سَيِّدَ المفتِينَ هلْ في عُلومِكُمْ","عَلَيَّ جُناحٌ إنْ هَجوْتُكُمْ أمْ لا",93,"ل",2,0],["فيا سعدُ كَم أحسنتَ بي قبلَ هذه","فدونَك بِرّا خالِصاً لكَ شُكرُه",94,"ر",2,0],["فيا سالبي صَبري على البعد والنَّوى","ويا مُلبسي ثوباً من السُّقم والضَّنى",95,"ن",2,0],["فيا سعد قلْ لي إنْ نصحت فأرعوي","متى يلثم اللبات رمحي وترتوي",96,"ي",1,0],["في أسطُرٍ لو أنّها",