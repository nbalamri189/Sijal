{"poems":[[65,"لك من غليل صبابتي ما أضمر","https://www.aldiwan.net/poem46190.html","الكامل"],[53,"أنى تماطلني وأنت جواد","https://www.aldiwan.net/poem61868.html","الكامل"],[53,"رمين فؤادي من عيون الوصاوص","https://www.aldiwan.net/poem64935.html","الطويل"],[87,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[47,"ألا هل أتاها بالمغيب سلامي","https://www.aldiwan.net/poem65670.html","الطويل"],[63,"أهجرا كان صدك أم ملالا","https://www.aldiwan.net/poem51492.html","الوافر"],[82,"هل كان أودع سر قلب محجرا","https://www.aldiwan.net/poem31438.html","الكامل"],[82,"لم نؤت ليلتنا الغراء من قصر","https://www.aldiwan.net/poem31448.html","البسيط"],[82,"بكى فقدك العز المؤيد والمجد","https://www.aldiwan.net/poem31472.html","الطويل"],[76,"بعيشك هل تدري أهوج الجنائب","https://www.aldiwan.net/poem12863.html","الطويل"],[76,"بذات المكارم ذاك الألم","https://www.aldiwan.net/poem13252.html","المتقارب"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[107,"بني مصر ما للطامعين وما لكم","https://www.aldiwan.net/poem43152.html","الطويل"],[42,"ألم ينس ليلى عهدك المتباعد","https://www.aldiwan.net/poem42299.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202531","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[92,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[92,"إلى المناضلين","https://www.poetsgate.com/ViewPoem.aspx?id=179212",""],[132,"من كان عند الله غالب","https://www.aldiwan.net/poem50660.html","مجزوء الكامل"],[147,"بسعدك دارت في السماء الكواكب","https://www.aldiwan.net/poem11734.html","الطويل"],[164,"عليك برأي السيف فهو سديد","https://www.aldiwan.net/poem58940.html","الطويل"],[215,"يا جنة الخلد كيف يشقى","https://www.aldiwan.net/poem46558.html","مخلع البسيط"],[234,"جرحي بعينيك ليس يندمل","https://www.aldiwan.net/poem50867.html","المنسرح"],[240,"ترى الظاعن الغادي مقيما على العهد","https://www.aldiwan.net/poem32031.html","الطويل"],[254,"ألا بان الخليط ولم يزاروا","https://www.aldiwan.net/poem2119.html","الوافر"],[254,"أمن ليلى وجارتها تروح","https://www.aldiwan.net/poem2123.html","الوافر"],[287,"دع الأثلات وآرام رامه","https://www.aldiwan.net/poem32456.html","المتقارب"],[310,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[342,"أعائش ما لأهلك لا أراهم","https://www.aldiwan.net/poem45426.html","الوافر"],[362,"أنوماً وقد بان الخليط تذوق","https://www.aldiwan.net/poem4159.html","الطويل"],[371,"يا ملكا تنشئ أفعاله","https://www.aldiwan.net/poem17220.html","السريع"],[376,"أنا أعرف فيمن","https://www.aldiwan.net/poem57424.html","البسيط"],[458,"لم يحصر الفن فن ذهن وانان","https://www.aldiwan.net/poem61805.html","البسيط"],[466,"إذا ما شكت بيض السيوف ظماءة","https://www.aldiwan.net/poem15172.html","الطويل"],[469,"بقبرك فلتسحب ذيول السحائب","https://www.aldiwan.net/poem3210.html","عموديه"],[556,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[567,"أقول اليوم صار الشرق شرقا","https://www.aldiwan.net/poem52881.html","البسيط"],[580,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"],[580,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138280",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122747","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48508","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70743","الطويل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129520","الطويل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105450","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119925","الكامل"],[1149,"","https://poetry.dctabudhabi.ae/diwan/poem/67734","الوافر"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145157","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46539","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100962","الكامل"],[2057,"","https://poetry.dctabudhabi.ae/diwan/poem/130495","الوافر"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109319","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53213","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120600","الكامل"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100895","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100224","الطويل"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76551","الطويل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100196","الكامل"],[3428,"","https://poetry.dctabudhabi.ae/diwan/poem/124006","الكامل"],[3488,"","https://poetry.dctabudhabi.ae/diwan/poem/28824","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62828","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62781","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108174","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117901","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95318","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103021","الطويل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199064","الطويل"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106731","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54381","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81247","السريع"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33069","المنسرح"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81943","الوافر"],[4914,"بمن أتداوى والدوا معك وسدوا","https://www.poetsgate.com/ViewPoem.aspx?id=170940",""],[3591,"ضجّت بحسن عيونك الآنام","https://www.poetsgate.com/ViewPoem.aspx?id=149536",""],[5136,"أيامنا بين أعراس وأفراج","https://www.poetsgate.com/ViewPoem.aspx?id=121540",""],[5246,"عتاب الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=187064",""],[5956,"تنامين وحدكِ","https://www.poetsgate.com/ViewPoem.aspx?id=181948",""],[5956,"عصفور وعُشُّ الإلهام","https://www.poetsgate.com/ViewPoem.aspx?id=192104",""],[5961,"مريد الحق","https://www.poetsgate.com/ViewPoem.aspx?id=199770",""]],"verses":[["يُسْدي مَديحَكَ هاجِسي ويُنيرُهُ","فِكري وحظّي في امْتِداحِكَ أوفَرُ",0,"ر",1,0],["يُسْدِي السحابُ إلى البعيد يُغِيثُه","فَيطَلُّ منه وادعاً ويُجادُ",1,"د",1,0],["يُسدِّي وجوهَ الكرِّ في كل مأزق","إذا بعضهم سدّى وجوه المحائص",2,"ص",1,0],["يُسَدِّدُهُ عِزريلُ في زِيِّ قاذِفٍ","وَأَيدي المَنايا وَالقَضاءُ المُدَرَّبُ",3,"ب",1,0],["يُسَدُّ بِهِ الثَغرُ المَخوفُ اِنثِلامُهُ","وَإِن رامَهُ الأَعداءُ كُلَّ مَرامِ",4,"م",1,0],["يَسُدُّ الجوَّ قسطلُه غُباراً","ويُطفي الشمسَ رونقُه صِقالا",5,"ل",2,0],["يُسْدي المكارم من أناملِ مُفْضِلٍ","أغْنى الزمانُ بنَيلها مَن أَفقَرا",6,"ر",2,0],["يُسْدي بِيُمْناهُ من معروفه مِنَناً","تَكسو الصَّنائعَ صنعانِيَّةَ الحِبَرِ",7,"ر",1,0],["يَسُدُّونَ خلّاتِ الحروبِ إذا طَمَتْ","بِشَوكِ الرّدى حتَّى كأنَّهُمُ السَّدُّ",8,"د",1,0],["يَسُدُّ مَهَبَّ الريحِ عَن كُلِّ وُجهَةٍ","وَيَزحَمُ لَيلاً شُهبَهُ بِالمَناكِبِ",9,"ب",1,0],["يُسَدِّدُ حَتّى صُدورَ القَنا","وَيَضرِبُ حَتّى رُؤوسَ البُهَم",10,"م",1,0],["يَسدُّ وَقَارُ عِصْمَتَ مَسْمَعَيِهِ","إذا عَكَفوا عليه مُهوِّلينا",11,"ن",2,0],["يُسَدِّدُها رامٍ مِنَ الهَولِ لَو رَمى","بِها الفَلَكَ الدَوّارَ لَم يَتَقَدَّمِ",12,"م",1,0],["يُسِّدنَني جُمَّ المُرافِقِ زانَها","جَبائِرُها غَصَّت بِهِنَّ المَعاضِدُ",13,"د",1,0],["يسدن ساداتهم قبابه","ويحجب الصيد السراة بابه",14,"ه",1,0],["يَسُدُّونَ كُلَّ شِعَابِ الجِبَا","لِ عَلَى النَّازِلينَ أَوْ الصُّعَّدِ",15,"د",1,0],["يَسُدُّ طريقَ الخَصْمِ حتى يردَّهُ","إلى واضحٍ منْ حُكمِهِ وَهْوَ راغم",16,"م",1,0],["يسُدُّ بذاكَ فراغَ الضميرِ","ويُوقِدُ روحاً خبيثاً خَبا",17,"ا",1,0],["يَسُدُّ مداخلَه أرقمٌ","وتحمي مسالِكَهُ أذؤب",18,"ب",1,0],["يُسْدِى ويُلْحِمُ ساكناً","طرق المخاوف والمتاعِبْ",19,"ب",1,0],["يَسُدُّ مَسَدَّ الأَلفِ بَأساً وَنَجدَةً","إِذا رَدَّ ضَربَ الأَلفِ في الأَلفِ حاسِبُ",20,"ب",1,0],["يسد على الريح الطريق أما ترى","عواليه لم تخفق لهن بنود",21,"د",1,0],["يسدّد السهم ليس يدرى","أيخطىء السهم أم يصيب",22,"ب",1,0],["يَسُدُّ شرقَ الدُّنا ومَغْربَها","به الكُماةُ الضَّراغِم البُزُل",23,"ل",1,0],["يُسَدُّ الفَضاءُ الرَحبُ مِنهُ بِجَحفَلٍ","كَأَنَّكَ قَد أَشرَفتَ مِنهُ عَلى السَدِّ",24,"د",1,0],["يَسُدّونَ الشِعابَ إِذا رَأَونا","وَلَيسَ يُعيذُهُم مِنا اِنجِحارُ",25,"ر",1,0],["يَسُدُّ فُروجَهُ رَبِذٌ مُضافٌ","يُقَلِّبُهُ عِجالُ الوَقعِ روحُ",26,"ح",1,0],["يَسُدُّ الثُغورَ بِطَعناتِهِ","وَيَفتَحُ ما كانَ صَعبَ المَرامَه",27,"م",2,0],["يُسدّدُ أَو يقاربُ في سدادٍ","لِثغرٍ منه سامَ السرحَ سيدُ",28,"د",1,0],["يَسُدُّ بِهِ نَوائِبَ تَعتَريهِ","مِنَ الأَيّامِ كَالنَهَلِ الشُروعِ",29,"ع",1,0],["يُسدِّدُ مِن آرائهِ سَهمَ فِطنَةٍ","لَهُ من رَمَايا المُشكلاتِ مُرُوقُ",30,"ق",1,0],["يُسَدِّدُ الرُمحَ لِحَقدِ العِدى","فَقُل لَهُم لا يُضمِروا غِشّا",31,"ش",2,0],["يسدُّ الثغر في سُور","غُلامٍ واسعِ الثغرِ",32,"ر",1,0],["يُسدي الأيادي لا من ولا عددٌ","مثل الملَّك في جاهٍ وسلطان",33,"ن",1,0],["يسدُّ فروجَ اليوم والليلِ عندهُ","بجدب ٍ وفي حرب دخانٌ وعِثْيرُ",34,"ر",1,0],["يُسدّد عن قوس القضاء سهامهُ","فما أسهم الكُسعيِّ أو قوسُ حاجب",35,"ب",1,0],["يَسدُّ على السّاري الطريقَ مجرُّهُ","وآثاره يحمين كلّ نِقابِ",36,"ب",1,0],["يَسُدُّ على ضَوارِي القَفْرِ باباً","ويَفتَحُ للمَراعي الخُضْرِ طُرْقا",37,"ق",2,0],["يسدّدُ صدْرَ الرُّمْحِ إِن ماسَ قدُّها","ويَكْسِرُ جَفْنَ السَّيْفِ إِنْ كَسَرَتْ جَفْنا",38,"ن",2,0],["يسدُّ تقبيليَ تفليجَه","حتى يُرى متَّسِق النَّظمِ",39,"م",1,0],["يسدي الصنيع إلي الجميع سليقة","ويشدّ أزر البائسين وينصر",40,"ر",1,0],["يَسُدُّ شُعاعَ الشَّمسِ دُونَ كُماتِهِ","شِفارُ المَواضي والوَشيجُ المُقَوَّمُ",41,"م",1,0],["يسدد اللّه مرماها يؤيدها","من الملائك في غاراتها مدد",42,"د",1,0],["يسُد هُوَى الجوِّ الفسيح غبارُه","فيمنعُ ضوءَ الشمس أن يتوقدا",43,"د",2,0],["يسددها رأي مع العزم صائب","ويحرسها بأس مع العلم عاطب",44,"ب",1,0],["يسدد فيه اللَه مذهب جعفر","على أنه ما انفك حقاً مسددا",45,"د",2,0],["يسدى بغير شفاعة مننا","من بعد تشفعها يد ويدُ",46,"د",1,0],["يَسُدُّ به نوائبَ تَعْتَرِيهِ","مِنَ الأيّامِ كالنَّهْرِ الشّروعِ",47,"ع",1,0],["يسدّده عقل رسا فوق رَبْوة","من العمر روَّاها مَعين التجارب",48,"ب",1,0],["يَسُد ما قَد سَده","وَهوَ الرَّئيس بَعدَه",49,"ه",1,0],["يُسدي عليك اللَه في عرفاته","نِعَماً تدوم على مدى الأحقاب",50,"ب",1,0],["يسددنا بمشكاة المعالي لنرقى","كلما نلقى انتفاعه",51,"ع",2,0],["يسد له مصارينا وساعا","فلو أكل الحصى هضمت طعامه",52,"م",2,0],["يسدّ مهب العاصفات إذا سرى","نسيم الصبا بالمُقْرِبات الصلادم",53,"م",1,0],["يُسدِي ويُلحِمُ يَبتَغِي إخلاَصَهَا","فقيامه مكرٌ بها وقعودُهُ",54,"د",2,0],["يسدي إلى الأنام كل حسنه","فقتلوهُ ولهُ دون سنه",55,"ه",1,0],["يسدّد الغربُ خطَوَ المعجزات ولا","يقلِّدُ الشرقُ إِلاَّ اللهوَ والبِدعا",56,"ع",2,0],["يسد من الثغر المخوف انشعابه","برأي كسيب الحية الذكر أنسابا",57,"ب",2,0],["يُسَدِّدُ مِن جَفنَيهِ نَحوِيَ أَسهُماً","مَواقِعُها مِنّي المقاتِلُ لا الشَوى",58,"و",2,0],["يسدي لها الوعظ الجميل وذاك لا","يجدي ذوات لواعج وشجون",59,"ن",1,0],["يسدى ويلحم في البلاغة حائكا","حلَلاً يتيه بها القريض ويرفلُ",60,"ل",1,0],["يَسُدّونَ أَبوابَ القِبابِ بِضُمَّرٍ","إِلى عُنَنٍ مُستَوثِقاتِ الأَواصِرِ",61,"ر",1,0],["يُسَدّدُ قبلَ الطّعنِ رأياً مثقفاً","يَرُدُّ سنانَ الرّمحِ أبكَمَ نابِيا",62,"ي",2,0],["يَسدونَ أفواهَ الشِّعابِ عليهِمُ","وأيُّ صَفاةٍ منكَ تمنعُ معوَلا",63,"ل",2,0],["يسد علينا الطرق قلة مالنا","كأن يلتقينا في المذاهب حاجب",64,"ب",1,1],["يسدي ويلحم في مناسج فكره","أبرادها ويجيد قدح زنادها",65,"د",3,0],["يُسدّدهُ هديٌ مِنَ اللَّه وَاضِحٌ","ويُرشِدُه نورٌ مِنَ اللَّه مَحجوبُ",66,"ب",1,0],["يسدده رأي المقيم بأمره","ويزجيه زجرا في مجال التصادم",67,"م",1,0],["يسد فراغا لا يسد بغيره","ويطلب شأوا ليس في حده حصر",68,"ر",1,0],["يُسَدِّدُها المَنصورُ فَهيَ سَحائِبٌ","تَجودُ العِدى بِالحَتفِ مِن وَبلِها الغَمرِ",69,"ر",1,0],["يُسدي إِليَّ منيرَ انعُمه","وأنيرُ مِدْحَتَهُ كما أُسدي",70,"د",2,0],["يَسدر في نَشوتِهِ ذاهِلاً","مِن مبعد آن وَمِن دان",71,"ن",1,0],["يُسدي بِهِ وَيَبيتُ لَيلَتَهُ","خَضِلاً مِنَ التَهتانِ أَزمُعُهُ",72,"ع",2,0],["يسدُّ القوم سبل التيه لمَّا","يضيء بنوره ظلم الزمان",73,"ن",1,0],["يسدد سهم الموت نحوك هل خطا","فينشك بي يا بئ