{"poems":[[86,"نثروا عليك نوادي الأزهار","https://www.aldiwan.net/poem10492.html","الكامل"],[86,"لا تلم كفي إذا السيف نبا","https://www.aldiwan.net/poem10698.html","الرمل"],[86,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[93,"ما باله ما أصابه","https://www.aldiwan.net/poem11149.html","المجتث"],[72,"سلبت عقلي بأحداق وأقداح","https://www.aldiwan.net/poem18481.html","البسيط"],[72,"يا قريرا بالمنى يا سيدي","https://www.aldiwan.net/poem19326.html","الرمل"],[51,"جزى الله عني قبح وجهي سعادة","https://www.aldiwan.net/poem64029.html","الطويل"],[51,"إن ائتمانك آفات الزمان على","https://www.aldiwan.net/poem65773.html","البسيط"],[70,"حرمت عيني الكرى","https://www.aldiwan.net/poem42702.html","مجزوء الرمل"],[92,"لست أبكي لعسف ليل طويل","https://www.aldiwan.net/poem38894.html","الخفيف"],[89,"أنا يا شمس ذرة فوق أرض","https://www.aldiwan.net/poem44693.html","الخفيف"],[89,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[89,"فقدت مصر فهي سكرى المآقي","https://www.aldiwan.net/poem44745.html","الخفيف"],[85,"محجوب إن جئت الحجاز","https://www.aldiwan.net/poem63699.html","مجزوء الكامل"],[45,"إنما الغي أن يكون رشيدا","https://www.aldiwan.net/poem63464.html","الخفيف"],[45,"أما كان في تلك الدموع السوائل","https://www.aldiwan.net/poem65638.html","الطويل"],[49,"أحمد الله على كل حال","https://www.aldiwan.net/poem63085.html","المديد"],[97,"قالت تعال فقلت لبيك","https://www.aldiwan.net/poem25091.html","أحذ الكامل"],[80,"للأقاحي بفيك نور ونور","https://www.aldiwan.net/poem31434.html","الخفيف"],[80,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[44,"خشنت عليه أخت بني خشين","https://www.aldiwan.net/poem30339.html","الوافر"],[44,"ما عهدنا كذا نحيب المشوق","https://www.aldiwan.net/poem30395.html","الخفيف"],[87,"أي شيء يبقى على الحدثان","https://www.aldiwan.net/poem8231.html","الخفيف"],[69,"شتان يابن فلان","https://www.aldiwan.net/poem28899.html","المجتث"],[105,"عام أهاب به الزمان فأقبلا","https://www.aldiwan.net/poem42112.html","الكامل"],[105,"زلت بأفهام الثقات قضية","https://www.aldiwan.net/poem43110.html","الكامل"],[105,"أنا بنو عثمان أعلام الورى","https://www.aldiwan.net/poem43424.html","الكامل"],[21,"إن آيات ربنا باقيات","https://www.aldiwan.net/poem36199.html","الخفيف"],[52,"أنا يا قوم من فؤادي وطرفي","https://www.aldiwan.net/poem26835.html","الخفيف"],[75,"طلب المجد من طريق السيوف","https://www.aldiwan.net/poem69060.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85594","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85659","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39586","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42494","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54687","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54894","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141920","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54222","الرمل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[92,"لَسْتُ أبْكي لِعَسْفِ لَيْلٍ طَويلٍ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14563&r=&rc=9",""],[109,"عد لربع منك خال","https://www.aldiwan.net/poem16678.html","مجزوء الرمل"],[117,"الفَرَج","https://www.aldiwan.net/poem24030.html","الرمل"],[117,"سحر دمشقي","https://www.aldiwan.net/poem24034.html","الكامل المقطوع"],[132,"سالت القطرة من كأسي التي","https://www.aldiwan.net/poem54931.html","الرمل"],[143,"ما في المعالي علي منك يعتصم","https://www.aldiwan.net/poem11822.html","الطويل"],[199,"أنحلوني وأسقموا","https://www.aldiwan.net/poem45226.html","مجزوء الخفيف"],[199,"غير قلبي أراه يسطيع صبرا","https://www.aldiwan.net/poem45561.html","الخفيف"],[211,"قد رأت أن تشوف لنا البخت","https://www.aldiwan.net/poem46258.html","الخفيف"],[211,"يا مليك الحسن عزت دولتك","https://www.aldiwan.net/poem46307.html","الرمل"],[211,"شاعر البحر إلى البحر يعود","https://www.aldiwan.net/poem46604.html","الرمل"],[211,"ما على الغادرين نسكب دمعا إن","https://www.aldiwan.net/poem46763.html","الخفيف"],[223,"أحبها وأحبته","https://www.aldiwan.net/poem39717.html","الخفيف"],[223,"نام إلا الهوى فأهلك ناموا","https://www.aldiwan.net/poem39722.html","الخفيف"],[223,"حين أقبلت والهوى فيك يحبو","https://www.aldiwan.net/poem39723.html","الخفيف"],[223,"قوني يا مقسم الأعباء","https://www.aldiwan.net/poem39725.html","الخفيف"],[225,"أنا يا إلهي عند بابك واقف","https://www.aldiwan.net/poem55103.html","الطويل"],[235,"لو أن قلبك مثل قلبي مغرم","https://www.aldiwan.net/poem31768.html","الكامل"],[275,"حفت بحضرتك الفتوح جيوشا","https://www.aldiwan.net/poem25465.html","الكامل"],[282,"كم شج آلمه لوم الخلي","https://www.aldiwan.net/poem32301.html","الرمل"],[282,"أقر نجدا ومن بنجد سلامي","https://www.aldiwan.net/poem32631.html","الخفيف"],[282,"ورد الورد سافرا عن خدود","https://www.aldiwan.net/poem32808.html","الخفيف"],[328,"كذبت هند حين قالت لك القل","https://www.aldiwan.net/poem54941.html","الخفيف"],[328,"هو ناي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[328,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[328,"طار يطوى مجاهل الأفق والنار","https://www.aldiwan.net/poem55059.html","الخفيف"],[342,"قيل لي هات في الوطن","https://www.aldiwan.net/poem55326.html","مجزوء الخفيف"],[342,"مرحبا بالربيع يختال بشرا","https://www.aldiwan.net/poem55328.html","الخفيف"],[361,"لا وعينيك والجبين المفدى","https://www.aldiwan.net/poem68122.html","الخفيف"],[364,"دام علاء العماد","https://www.aldiwan.net/poem60952.html","مجزوء السريع"],[366,"ما تطيب الدنيا لفقد حبيب","https://www.aldiwan.net/poem17093.html","الخفيف"],[380,"تحجبت يا ناظري","https://www.aldiwan.net/poem48790.html","مجزوء المتقارب"],[397,"ما باله ما أصابه","https://www.aldiwan.net/poem11025.html","عموديه"],[400,"ابتهل","https://www.aldiwan.net/poem6733.html","عموديه"],[402,"إن آيات غرامي","https://www.aldiwan.net/poem46501.html","مجزوء الرمل"],[403,"منعت عن مقلة الصب كراها","https://www.aldiwan.net/poem33364.html","الرمل"],[403,"قال عبد مسه طول الضرر","https://www.aldiwan.net/poem33934.html","الرمل"],[416,"من لصب متيم مستهام","https://www.aldiwan.net/poem53989.html","الخفيف"],[416,"من لصب في هواكم مستهام","https://www.aldiwan.net/poem54021.html","الرمل"],[416,"يا ناجيا نحو كل مكرمة","https://www.aldiwan.net/poem54078.html","المنسرح"],[416,"ضحك البرق فأبكاني دما","https://www.aldiwan.net/poem54130.html","الرمل"],[432,"اجتل اللهو حمرة في بياض","https://www.aldiwan.net/poem12451.html","الخفيف"],[443,"إن أيامنا التي قدم العهد","https://www.aldiwan.net/poem55937.html","عموديه"],[458,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[495,"اذهب الكاس فعرف الفجر","https://www.aldiwan.net/poem9813.html","مجزوء الرمل"],[500,"ما على عاشق الحبيب ملامة","https://www.aldiwan.net/poem37642.html","الخفيف"],[500,"أنائبنا هذي الوجودات كلها","https://www.aldiwan.net/poem37991.html","الطويل"],[505,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[515,"أنسيم عرفك أم شميم عرار","https://www.aldiwan.net/poem12150.html","الكامل"],[540,"إن اياديك عندي غير واحدة","https://www.aldiwan.net/poem56842.html","الكامل"]],"verses":[["آناً يُوالونَ الضَجيجَ كَأَنَّهُم","رَكبُ الحَجيجِ بِكَعبَةِ الزُوّارِ",0,"ر",1,0],["أَنا يابانِيَّةٌ لا أَنثَني","عَن مُرادي أَو أَذوقَ العَطَبا",1,"ب",2,0],["إِنَّ إيطاليا بَنوها بُناةٌ","فَاِطمَئِنّي ما دامَ في الحَيِّ باني",2,"ن",2,0],["آناً يَبِينُ وَآناً","يَخْفَى وَرَاءَ غَيَابَهْ",3,"ب",2,0],["أنأى البرية عن آمال ملتمح","تلك المعالي وأدناهم لممتاح",4,"ح",1,0],["أن إيري يا لعقبى إيركمُ","كان ياءً ثمَّ أمسى ألفا",5,"ف",2,0],["أنائلُهُ يغتَرُّني عن لقائه","ومجلِسه إنّي إذاً لغرير",6,"ر",1,0],["إنَّ ائتمانَكَ آفاتِ الزمانِ على","نفسٍ تمرُّ بها لوعاتُ هجرانِكْ",7,"ك",1,1],["أَنا يَقظانُ أَراهُ","في قُعودي وَقِيامي",8,"ي",1,0],["أَنا يا تُونُسَ الجميلَةَ في لُجِّ","الهَوَى قَدْ سَبَحْتُ أَياً سِباحَهْ",9,"ح",2,0],["أنا يا شمس ذرة فوق أرض","هي في سيرها عليك تطوف",10,"ف",1,1],["انا يا صحبي واحداً كنت منكم","فاذكروني ولا تناسوا عهودي",11,"د",2,0],["انا يا جسم لا اطوف على غيرك","فيما اذا فككت وثاقي",12,"ق",2,0],["أَنا يا اِبنَ أَحمَدَ بَعدَ مَد","حي في أَبيكَ بِخَيرِ حالَه",13,"ل",2,0],["إِنَّ أَيّامَهُ مِنَ البيضِ بيضٌ","ما رَأَينَ المَفارِقَ السودَ سودا",14,"د",2,0],["أَنائِلُ جاوَرتَ الأَحَصَّ وَأَهلَهُ","وَما جُدتَ لِلصَبِّ المَشوقِ بِنائِلِ",15,"ل",1,0],["إِنَّ أَيّاماً قِصاراً حَمَتنا","خَيرُ أَيّامٍ سَتَأتي طِوالِ",16,"ل",1,0],["أنا يا حبيبة طائر الأيك","لم لا أغني في ذراعيك",17,"ك",1,0],["إنّ أيّامَكَ الحسانَ لَغُرٌّ","فَكَأَنَّ الوجوهَ منها بُدورُ",18,"ر",1,0],["أنا يا ابن أختي لا أزالُ أخا أسىً","حتى أُوَسَّدَ في الضّريح وِسادي",19,"د",2,0],["أَنَأياً وَاِجتِناباً أَيُّ صَبرٍ","عَلى البَلوى يُعَرِّسُ بَينَ ذَينِ",20,"ن",1,0],["إِنَّ أَيّامَكَ الحِسانَ مِنَ الرَو","مِ لَحُمرُ الصَبوحِ حُمرُ الغَبوقِ",21,"ق",1,0],["أَنَا يَا دَهْرُ عَالِمٌ بِمَصِيرِي","فِيكَ لَكِنَّنِي جَمُوحُ الْعِنَانِ",22,"ن",1,0],["أنا يُدَوِّدُ قَزِّي","وأنتَ قزَّزَ دودُكْ",23,"ك",1,0],["آناً يَهُدُّ بها الشُّعوبَ وتارةً","يبني لها المُلكَ الأشمَّ الأطولا",24,"ل",2,0],["آناً يَميلُ إِلى اليَمينِ وَتارَةً","يَلوي العِنانَ إِلى الشَمالِ يَسيرُ",25,"ر",1,0],["إِنّا يسوسُ أُمورَنا وَيُقيمُها","ملكٌ بِأَمرِ إِلههِ قَوّامُ",26,"م",1,0],["إِنَّ آياتِ رَبِّنا باقياتٌ","ما يُماري فيهِنَّ إِلا الكَفورُ",27,"ر",1,1],["أَنا يا قَومُ مِن فُؤادي وَطَرفي","في أُمورٍ تَجِلُّ عَن كُلِّ وَصفِ",28,"ف",1,1],["إنّ أيّامَ دهرِنَا سَخِفَاتٌ","فهي أعوانُ كلّ وَغْدٍ سخيف",29,"ف",1,0],["أنأى إلى مصر عنهم","ولا أراهم بقربي",30,"ي",1,0],["أَنا يا شعر كئيب","مثلما أَنت كئيبُ",31,"ب",1,1],["أنا يا أمُّ صانعُ الأملِ الضا","حِكِ في صورة الغد المرموقِ",32,"ق",1,0],["أَنَا يَا حَمَامَةُ مِنْكِ أَعْلَمُ بِالْهَوى","فَدَعي الْحَنِينَ فَلَسْتِ مِنْ أَكْفائِي",33,"ا",2,0],["إِنْ أَيْمَنُوا أَفْضَوْا إِلى فَيْحَائِهَا","يَرِدُونَ خيْرَ مَنَاهِلِ الوُرَّادِ",34,"د",1,0],["أَنَا يَا سَيِّدِي وَشَانُكَ شَأْنِي","أُوثِرُ الفِعْلَ لاَ الكَلاَمَ مَلِيحَا",35,"ح",2,0],["إِنْ أَيْسَرَتْ مِصْر وَفِيهِ ضَمَانهَا","إِنِّي إِذَنْ فَرِحٌ بِرقَّةِ حَالِي",36,"ل",2,0],["آناً يَقِرُّ مُنَاغِياً","فِي الأَيْكِ شَادِيَة الطُّيُورْ",37,"ر",1,0],["أنا يا ربيع لا أمن قصائدي","لولاك ما طبعت على فمها فما",38,"م",2,0],["أَنَا يا زَيْنَبُ ماءٌ فإِذا","هِجْتِنِي صِرْتُ لَظىً مُلْتَهِبا",39,"ب",2,0],["أنا يا صديقة متعب بعروبتي","فهل العروبة لعنة وعقاب",40,"ب",1,0],["أَنَا يَا تُوْنُسَ الجَمِيلَة َ فِي لُجِّ","الهَوى قَدْ سَبَحْتُ أَيَّ سِبَاحَهْ",41,"ح",2,0],["أَنا يا عَبدي قَريب","وَمُجيب لِلسُؤالِ",42,"ل",1,0],["أنا يا لَيْلُ أَحاسِيسي وَهَجْ","تَقْذِفُ النَّارَ وتَغتالُ المُهَجْ",43,"ج",1,1],["أنا يا دِمَشْقُ أَسِيرُ قَيْدِكِ والهَوى","أأموتُ كالوَضَّاحِ فِيكِ غَريبا",44,"ب",2,0],["أنا يا كأسي التي أشقيتني","كأسك الحي عيونا وشفاها",45,"ه",2,0],["أنا يا كأسي التي أذبلتني","من سقى كرمك بالخمر القديم",45,"م",1,0],["أَنأى إِذا ما اِنقَضَت مَشكورَةً خِدَمي","حيناً وَأَدنو إِذا ما عَنَّتِ الخِدَمُ",46,"م",1,0],["أنا يا حسرتي أنا","لم أكن قبلُ أعلمُ",47,"م",1,0],["أنا يا دهرُ لم أسئْ لكَ يوماً","فلماذا أساءني الهمُّ دهرا",48,"ر",2,0],["إن أيامنا العزاز علينا","هي أيمانا بأحلام شاعر",49,"ر",1,0],["أنا يا مولاي لو تعلمُ روح","يهصرُ المطلولَ من مائدِ غصنِك",50,"ك",1,0],["أنا يا بحر بأهوائي غريق","أشرب الأهواء ريقا بعد ريق",51,"ق",1,0],["أنا يا قلب لا أبالي زماناً","ضاع حظى منه وضاع نصيبي",52,"ي",1,0],["إِنَّ إيزولتَ لي وَغابَ الحَبيبا","نِ وَراءَ الصخورِ وَالأَوراقِ",53,"ق",1,0],["أَنا يا لَيلَ مُؤمِنٌ بكِ لكِن","هَل تُصافي وَتعدِلُ الأَيّامُ",54,"م",1,0],["أَنا يا لَيلَ أَسعَدَ الناسِ حُبّاً","مِلءُ عَيني نورٌ وَقَلبي وَلائِم",55,"م",1,0],["أَنا يا رَبِّ في يَدَيكَ فَصُنها","فَاِتِّكالي عَلَيكَ كُلُّ عَزائي",56,"ي",1,0],["أنا يا إِلهي عندَ بابكَ واقِفٌ","لا أَبتَغي عنهُ الزَمانَ عُدولا",57,"ل",2,1],["أَنا يا زَماني إِن تَطَأ مِن مَنكِبي","ضَرَعاً لِظُلمي مِن خُطوبِكَ أَظلَمُ",58,"م",1,0],["أَنْأَى الصوائِفَ لِلفَلاةِ تَقرُّباً","وَرأَى رَغيبَاتِ الكَلُومِ خُدُوشا",59,"ش",2,0],["أَنا يَعقوبِيُّ حُزنٍ في هَوى","رَشَأٍ يَسطو بِحُسنٍ يوسُفِيِّ",60,"ي",1,0],["إِنَّ أَيّامَكَ اللَواتي نَراها","هِيَ ساداتُ سائِرِ الأَيّامِ",61,"م",1,0],["إِنَّ أَيّامَهُ لأَعيادنا بَل","كُلَّ يَومٍ لَنا بِهِ أَلفُ عيدِ",62,"د",1,0],["أنا يا هند لا أزال ابنها الوا","قف بين السفوح والكثبان",63,"ن",1,0],["أنا يا خالِقُ خلّا","قٌ من البدءِ مفَنُّ",64,"ن",1,0],["أنا يا رب عابدٌ لك حتى","في شكوكي عبادتي في يقيني",65,"ي",1,0],["أنا يا ريح جوهر مستسر","في كنوز في عالم مرتاب",66,"ب",1,0],["أنا يا موطني شبحٍ","ما لغير الحمى احن",67,"ن",1,0],["أنا يا قوم ان اكن","مهملاً فاسألوا الاحن",67,"ن",1,0],["انا يا شاعر الحياة ال","حب فاجرأ وقبّل الخد تبرا",68,"ر",2,0],["انا يا زهرتي سئمت حياة ال","حب حب الحسان والغيد طرا",68,"ر",2,0],["أنا ياق عَلى هَواك وَمن لي","أَن تَراني يا سَيِّدي لَك عَبدا",69,"د",2,0],["إنْ أَينعَتْ أَرؤُسٌ","جَدَّلها في الحَصاد",70,"د",1,0],["إِنَّ أَيّامَ مَن نَأَوهُ لَيالٍ","وَلَيالي مَن زارَهُم أَحلامُ",71,"م",1,0],["أَنا يا رَفيق الوَجنَتين","رَقيق عارضك المُنمنم",72,"م",1,0],["آنا يبين وآن","يخفى وراء غيابه",73,"ب",2,0],["أنا يا أمتي أحبكِ حُبَّ","لو تأمَّلْتِه، رأيتِ عُجابا",74,"ب",2,0],["إن آيات غرامي","مُحكماتٌ لَيْسَ تُنسَخْ",75,"خ",1,1],["أنا يعقوب وأنتم يوسف","وهي مصر فمتى تدنو حماها",76,"ا",3,0],["إن أيوب ينادي ربه","مَسَّني الضر فلم يبق الضرر",77,"ر",1,0],["إنَّ أيَّامنا على القرب منهم","صُدِعَتْ بالفراق بعد التئام",78,"م",1,0],["إنَّ أيَّاميَ في وادي الغضا","لم تكن غير خيالٍ في منام",79,"م",1,0],["إنَّ أياديك منك سابقة","عَليَّ قدماً في سالف الحقب",80,"ب",1,0],["إنَّ أيامَك أعيادُ المنى","حيث كانت للأماني موسما",81,"م",2,0],["إن أيامَه الجموحةَ تعدو","في عنانِ المدامِ طات ارْتياضِ",82,"ض",1,0],["إن أيامنا التي قدم العه","د بها تلك بهجة الأيام",83,"م",1,1],["أنا يا دار أخو وحشِ الفلا","فيكِ من خان فعزمي لم يخنّي",84,"ي",1,0],["أنا يا دهر بأبنا","ئك شِقٌّ وًسَطيح",85,"ح",1,0],["انا يال الرجال صبُّ بحبٍ","شرب القلب من هواه مدامه",86,"م",2,0],["أنائِبَنا هَذي الوُجوداتُ كُلُّها","زَوالٌ عَلَيها من سُتورِ الخَفا غِشا",87,"ش",2,1],["أنا يا أمّ عمرٍو لستُ ممّنْ","يبيعونَ قريضاً في المتاجرْ",88,"ر",1,1],["إن أيدوك وأيدوا بك ملكهم","فلكم يمين أيدت بيسار",89,"ر",1,0],["إِنَّ اياديكَ عِندي غَيرُ واحِدَةٍ","جَلَّت عَن الوَصفِ وَالإِحصاءِ وَالعَدَدِ",90,"د",1,1]]}