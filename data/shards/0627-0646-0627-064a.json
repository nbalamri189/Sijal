{"poems":[[86,"نثروا عليك نوادي الأزهار","https://www.aldiwan.net/poem10492.html","الكامل"],[86,"لا تلم كفي إذا السيف نبا","https://www.aldiwan.net/poem10698.html","الرمل"],[86,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[93,"ما باله ما أصابه","https://www.aldiwan.net/poem11149.html","المجتث"],[72,"سلبت عقلي بأحداق وأقداح","https://www.aldiwan.net/poem18481.html","البسيط"],[72,"يا قريرا بالمنى يا سيدي","https://www.aldiwan.net/poem19326.html","الرمل"],[51,"جزى الله عني قبح وجهي سعادة","https://www.aldiwan.net/poem64029.html","الطويل"],[51,"إن ائتمانك آفات الزمان على","https://www.aldiwan.net/poem65773.html","البسيط"],[70,"حرمت عيني الكرى","https://www.aldiwan.net/poem42702.html","مجزوء الرمل"],[92,"لست أبكي لعسف ليل طويل","https://www.aldiwan.net/poem38894.html","الخفيف"],[89,"أنا يا شمس ذرة فوق أرض","https://www.aldiwan.net/poem44693.html","الخفيف"],[89,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[89,"فقدت مصر فهي سكرى المآقي","https://www.aldiwan.net/poem44745.html","الخفيف"],[85,"محجوب إن جئت الحجاز","https://www.aldiwan.net/poem63699.html","مجزوء الكامل"],[45,"إنما الغي أن يكون رشيدا","https://www.aldiwan.net/poem63464.html","الخفيف"],[45,"أما كان في تلك الدموع السوائل","https://www.aldiwan.net/poem65638.html","الطويل"],[49,"أحمد الله على كل حال","https://www.aldiwan.net/poem63085.html","المديد"],[97,"قالت تعال فقلت لبيك","https://www.aldiwan.net/poem25091.html","أحذ الكامل"],[80,"للأقاحي بفيك نور ونور","https://www.aldiwan.net/poem31434.html","الخفيف"],[80,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[44,"خشنت عليه أخت بني خشين","https://www.aldiwan.net/poem30339.html","الوافر"],[44,"ما عهدنا كذا نحيب المشوق","https://www.aldiwan.net/poem30395.html","الخفيف"],[87,"أي شيء يبقى على الحدثان","https://www.aldiwan.net/poem8231.html","الخفيف"],[69,"شتان يابن فلان","https://www.aldiwan.net/poem28899.html","المجتث"],[105,"عام أهاب به الزمان فأقبلا","https://www.aldiwan.net/poem42112.html","الكامل"],[105,"زلت بأفهام الثقات قضية","https://www.aldiwan.net/poem43110.html","الكامل"],[105,"أنا بنو عثمان أعلام الورى","https://www.aldiwan.net/poem43424.html","الكامل"],[21,"إن آيات ربنا باقيات","https://www.aldiwan.net/poem36199.html","الخفيف"],[52,"أنا يا قوم من فؤادي وطرفي","https://www.aldiwan.net/poem26835.html","الخفيف"],[75,"طلب المجد من طريق السيوف","https://www.aldiwan.net/poem69060.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85594","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85659","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39586","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42494","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54687","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54894","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141920","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54222","الرمل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[92,"لَسْتُ أبْكي لِعَسْفِ لَيْلٍ طَويلٍ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14563&r=&rc=9",""]],"verses":[["آناً يُوالونَ الضَجيجَ كَأَنَّهُم","رَكبُ الحَجيجِ بِكَعبَةِ الزُوّارِ",0,"ر",1,0],["أَنا يابانِيَّةٌ لا أَنثَني","عَن مُرادي أَو أَذوقَ العَطَبا",1,"ب",2,0],["إِنَّ إيطاليا بَنوها بُناةٌ","فَاِطمَئِنّي ما دامَ في الحَيِّ باني",2,"ن",2,0],["آناً يَبِينُ وَآناً","يَخْفَى وَرَاءَ غَيَابَهْ",3,"ب",2,0],["أنأى البرية عن آمال ملتمح","تلك المعالي وأدناهم لممتاح",4,"ح",1,0],["أن إيري يا لعقبى إيركمُ","كان ياءً ثمَّ أمسى ألفا",5,"ف",2,0],["أنائلُهُ يغتَرُّني عن لقائه","ومجلِسه إنّي إذاً لغرير",6,"ر",1,0],["إنَّ ائتمانَكَ آفاتِ الزمانِ على","نفسٍ تمرُّ بها لوعاتُ هجرانِكْ",7,"ك",1,1],["أَنا يَقظانُ أَراهُ","في قُعودي وَقِيامي",8,"ي",1,0],["أَنا يا تُونُسَ الجميلَةَ في لُجِّ","الهَوَى قَدْ سَبَحْتُ أَياً سِباحَهْ",9,"ح",2,0],["أنا يا شمس ذرة فوق أرض","هي في سيرها عليك تطوف",10,"ف",1,1],["انا يا صحبي واحداً كنت منكم","فاذكروني ولا تناسوا عهودي",11,"د",2,0],["انا يا جسم لا اطوف على غيرك","فيما اذا فككت وثاقي",12,"ق",2,0],["أَنا يا اِبنَ أَحمَدَ بَعدَ مَد","حي في أَبيكَ بِخَيرِ حالَه",13,"ل",2,0],["إِنَّ أَيّامَهُ مِنَ البيضِ بيضٌ","ما رَأَينَ المَفارِقَ السودَ سودا",14,"د",2,0],["أَنائِلُ جاوَرتَ الأَحَصَّ وَأَهلَهُ","وَما جُدتَ لِلصَبِّ المَشوقِ بِنائِلِ",15,"ل",1,0],["إِنَّ أَيّاماً قِصاراً حَمَتنا","خَيرُ أَيّامٍ سَتَأتي طِوالِ",16,"ل",1,0],["أنا يا حبيبة طائر الأيك","لم لا أغني في ذراعيك",17,"ك",1,0],["إنّ أيّامَكَ الحسانَ لَغُرٌّ","فَكَأَنَّ الوجوهَ منها بُدورُ",18,"ر",1,0],["أنا يا ابن أختي لا أزالُ أخا أسىً","حتى أُوَسَّدَ في الضّريح وِسادي",19,"د",2,0],["أَنَأياً وَاِجتِناباً أَيُّ صَبرٍ","عَلى البَلوى يُعَرِّسُ بَينَ ذَينِ",20,"ن",1,0],["إِنَّ أَيّامَكَ الحِسانَ مِنَ الرَو","مِ لَحُمرُ الصَبوحِ حُمرُ الغَبوقِ",21,"ق",1,0],["أَنَا يَا دَهْرُ عَالِمٌ بِمَصِيرِي","فِيكَ لَكِنَّنِي جَمُوحُ الْعِنَانِ",22,"ن",1,0],["أنا يُدَوِّدُ قَزِّي","وأنتَ قزَّزَ دودُكْ",23,"ك",1,0],["آناً يَهُدُّ بها الشُّعوبَ وتارةً","يبني لها المُلكَ الأشمَّ الأطولا",24,"ل",2,0],["آناً يَميلُ إِلى اليَمينِ وَتارَةً","يَلوي العِنانَ إِلى الشَمالِ يَسيرُ",25,"ر",1,0],["إِنّا يسوسُ أُمورَنا وَيُقيمُها","ملكٌ بِأَمرِ إِلههِ قَوّامُ",26,"م",1,0],["إِنَّ آياتِ رَبِّنا باقياتٌ","ما يُماري فيهِنَّ إِلا الكَفورُ",27,"ر",1,1],["أَنا يا قَومُ مِن فُؤادي وَطَرفي","في أُمورٍ تَجِلُّ عَن كُلِّ وَصفِ",28,"ف",1,1],["إنّ أيّامَ دهرِنَا سَخِفَاتٌ","فهي أعوانُ كلّ وَغْدٍ سخيف",29,"ف",1,0],["أنأى إلى مصر عنهم","ولا أراهم بقربي",30,"ي",1,0],["أَنا يا شعر كئيب","مثلما أَنت كئيبُ",31,"ب",1,1],["أنا يا أمُّ صانعُ الأملِ الضا","حِكِ في صورة الغد المرموقِ",32,"ق",1,0],["أَنَا يَا حَمَامَةُ مِنْكِ أَعْلَمُ بِالْهَوى","فَدَعي الْحَنِينَ فَلَسْتِ مِنْ أَكْفائِي",33,"ا",2,0],["إِنْ أَيْمَنُوا أَفْضَوْا إِلى فَيْحَائِهَا","يَرِدُونَ خيْرَ مَنَاهِلِ الوُرَّادِ",34,"د",1,0],["أَنَا يَا سَيِّدِي وَشَانُكَ شَأْنِي","أُوثِرُ الفِعْلَ لاَ الكَلاَمَ مَلِيحَا",35,"ح",2,0],["إِنْ أَيْسَرَتْ مِصْر وَفِيهِ ضَمَانهَا","إِنِّي إِذَنْ فَرِحٌ بِرقَّةِ حَالِي",36,"ل",2,0],["آناً يَقِرُّ مُنَاغِياً","فِي الأَيْكِ شَادِيَة الطُّيُورْ",37,"ر",1,0],["أنا يا ربيع لا أمن قصائدي","لولاك ما طبعت على فمها فما",38,"م",2,0],["أَنَا يا زَيْنَبُ ماءٌ فإِذا","هِجْتِنِي صِرْتُ لَظىً مُلْتَهِبا",39,"ب",2,0],["أنا يا صديقة متعب بعروبتي","فهل العروبة لعنة وعقاب",40,"ب",1,0],["أَنَا يَا تُوْنُسَ الجَمِيلَة َ فِي لُجِّ","الهَوى قَدْ سَبَحْتُ أَيَّ سِبَاحَهْ",41,"ح",2,0]]}