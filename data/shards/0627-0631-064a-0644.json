{"poems":[[88,"رجعت لنفسي فاتهمت حصاتي","https://www.aldiwan.net/poem10924.html","الطويل"],[90,"كفى بالعلم في الظلمات نورا","https://www.aldiwan.net/poem45002.html","الوافر"],[90,"أرى للروح بالبدن اتصالا","https://www.aldiwan.net/poem45062.html","الوافر"],[29,"ألا زارت وأهل منى هجود","https://www.aldiwan.net/poem5731.html","الوافر"],[39,"طربت وهل بك من مطرب","https://www.aldiwan.net/poem7653.html","المتقارب"],[74,"أرى لصواب يا إيري صفات","https://www.aldiwan.net/poem18263.html","الوافر"],[74,"بروحي من نص الغزال لها الولا","https://www.aldiwan.net/poem18444.html","الطويل"],[74,"سرى بشبيه البدر آل هلال","https://www.aldiwan.net/poem19482.html","الطويل"],[53,"أرى للناس كلهم معاشا","https://www.aldiwan.net/poem64920.html","الوافر"],[53,"أرى لعبة الشطرنج إن هي حصلت","https://www.aldiwan.net/poem65899.html","الطويل"],[53,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[53,"ألا خذها إليك عن الحرون","https://www.aldiwan.net/poem66529.html","الوافر"],[93,"ألا أيها الإبريق ما لك والصلف","https://www.aldiwan.net/poem8983.html","عموديه"],[64,"ألا أيها الركب اليمانون ما لكم","https://www.aldiwan.net/poem52244.html","الطويل"],[51,"طلبتك يا دنيا فأعذرت في الطلب","https://www.aldiwan.net/poem10342.html","الطويل"],[51,"ألا رب ذي أجل قد حضر","https://www.aldiwan.net/poem62094.html","المتقارب"],[51,"رجعت إلى نفسي بفكري لعلها","https://www.aldiwan.net/poem63088.html","الطويل"],[82,"خلت منك أيام الشبيبة فاعمرها","https://www.aldiwan.net/poem31426.html","الطويل"],[107,"يا أيها الناس إن الله يأمركم","https://www.aldiwan.net/poem43081.html","البسيط"],[107,"ألي في الهوى ما لي وللائم العذر","https://www.aldiwan.net/poem43125.html","الطويل"],[22,"أبت شفتاي اليوم إلا تكلما","https://www.aldiwan.net/poem22063.html","الطويل"],[50,"غزال به فتر وفيه تأنث","https://www.aldiwan.net/poem64352.html","الطويل"],[50,"أرى للكأس حقا لا أراه","https://www.aldiwan.net/poem65115.html","الوافر"],[78,"أرى للصبا وداعا","https://www.aldiwan.net/poem39273.html","المضارع"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/141011",""],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9879","الوافر"],[92,"شكوى وآمال","https://www.poetsgate.com/ViewPoem.aspx?id=178932",""],[139,"سواي بهذه الدنيا يبالي","https://www.aldiwan.net/poem48852.html","الوافر"],[146,"ترى رائح يأتى بأخبار من غدا","https://www.aldiwan.net/poem58445.html","الطويل"],[147,"أرى لك يا خزرون لبنان في الورى","https://www.aldiwan.net/poem11769.html","الطويل"],[147,"ما مرتقاك على من رامه أمم","https://www.aldiwan.net/poem11824.html","البسيط"],[170,"حوى أبو الفضل ما كنوه به","https://www.aldiwan.net/poem46890.html","المنسرح"],[203,"مشى الجهل في طين ولكن","https://www.aldiwan.net/poem45401.html","الوافر"],[203,"أرى عقلي كساقية تدار","https://www.aldiwan.net/poem45403.html","الوافر"],[208,"أرى لي في شهر الصيام إذا أتى","https://www.aldiwan.net/poem53052.html","الوافر"],[208,"أرى الحب لا يبلى ولكنه يبلي","https://www.aldiwan.net/poem53202.html","الطويل"],[208,"أقرت نجوم الحسن أنك بدرها","https://www.aldiwan.net/poem53254.html","الطويل"],[275,"أيا نجمة في قربها القلب طامع","https://www.aldiwan.net/poem35674.html","الطويل"],[369,"طلعت علينا من سماء المكارم","https://www.aldiwan.net/poem60662.html","الطويل"],[369,"عداك الحادثات إلى عداكا","https://www.aldiwan.net/poem60815.html","الوافر"],[371,"أرى لهم نارا تلوح على علم","https://www.aldiwan.net/poem17265.html","الكامل"],[371,"إلى العين قبل الكف يبدو شعاعه","https://www.aldiwan.net/poem17318.html","الطويل"],[376,"أرى لزماني يا ابن عنبسة يدا","https://www.aldiwan.net/poem57125.html","الطويل"],[406,"رويدك إن الموج في البحر صاخب","https://www.aldiwan.net/poem21955.html","عموديه"],[463,"سلا دار البخيلة بالجناب","https://www.aldiwan.net/poem56296.html","الوافر"],[532,"أرى لك أفعالا تناقض أمرها","https://www.aldiwan.net/poem45965.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83342","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122647","الطويل"],[706,"","https://poetry.dctabudhabi.ae/diwan/poem/144836","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86992","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67844","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62618","المتقارب"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17615","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80190","الوافر"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61040","البسيط"],[1133,"","https://poetry.dctabudhabi.ae/diwan/poem/76585","الوافر"],[1534,"","https://poetry.dctabudhabi.ae/diwan/poem/206187",""],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82665","المتقارب"],[1762,"","https://poetry.dctabudhabi.ae/diwan/poem/89627","الوافر"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42463","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27572","الطويل"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101815","المتقارب"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93662","الطويل"],[2472,"","https://poetry.dctabudhabi.ae/diwan/poem/198317","الوافر"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58308","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200688","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200556","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202718","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132780","المتقارب"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100719","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100808","البسيط"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139973","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68030","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89406","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88922","الوافر"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127055","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45811","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216476","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205512","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131267",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135484","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95318","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86459","الطويل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45945","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81272","المتقارب"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72490","الطويل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104873","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141683","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141624","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52186","الوافر"],[4929,"صدى الواقع","https://www.poetsgate.com/ViewPoem.aspx?id=199284",""],[4929,"وللأحرارِ من كنعانَ وعد","https://www.poetsgate.com/ViewPoem.aspx?id=202440",""],[5213,"لو ان ابا سيفي يمن بنظرة","https://www.poetsgate.com/ViewPoem.aspx?id=170506",""],[5459,"قتيل الصدود","https://www.poetsgate.com/ViewPoem.aspx?id=204160",""],[5582,"أَلا حَيِّ مِنْ دارِ سُعْدَى مُقامَا","https://www.poetsgate.com/ViewPoem.aspx?id=63572",""],[5913,"نجوى نسيم الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=177075",""],[5956,"قيمتي","https://www.poetsgate.com/ViewPoem.aspx?id=183908",""],[6102,"ذِكرى الأَمس !!","https://www.poetsgate.com/ViewPoem.aspx?id=184048",""]],"verses":[["أَرى لِرِجالِ الغَربِ عِزّاً وَمَنعَةً","وَكَم عَزَّ أَقوامٌ بِعِزِّ لُغاتِ",0,"ت",1,0],["أرى لبّ العلا أدباً وعلماً","بغيرهما العلا أمست قشورا",1,"ر",2,0],["أرى للروح بالبدن اتصالاً","خَفيّاً لا تبين له رسوم",2,"م",1,1],["أَرى لَيلاً يُخالِفُهُ نَهارٌ","وَلُؤمُ التَيمِ ما اِختَلَفا جَديدُ",3,"د",1,0],["أرَى لَهُمُ الفَضلَ والسَّابِقَاتِ","وَلَم أتَمَنَّ وَلَم أَحسَبِ",4,"ب",1,0],["أرى لصواب يا إيري صفات","تحثُّ على الخلاعة والتصابي",5,"ي",1,1],["أرى لعليٍّ رتبةً وفضائلاً","تقرّ لها هذي النجوم المواكث",6,"ث",1,0],["أرى لابنِ ريَّان اعْتلاءَ سيادةٍ","تخلص حظّ الشعر بعد مطال",7,"ل",1,0],["أرى للناس كلَّهمُ معاشاً","ومالي يا أبا حسنٍ معاشُ",8,"ش",1,1],["أرى لعبةَ الشطرنج إنْ هي حُصّلَتْ","أحقُّ أمورِ الناسِ ألّا يُحصَّلا",9,"ل",2,1],["أرى لصديقي أَمْنَ ظُلمي ولا أرى","له أمنَ إنصافي وإن كان في وعلِ",10,"ل",1,0],["أرى لأبيك إدلالاً وعِرضي","أعزُّ عليَّ مَرْزَأةً فبيني",11,"ن",2,0],["أَرى لَكَ أَنفاً شامِخاً غَيرَ أَنَّهُ","تَلَفَّعَ أَثوابَ الغُبارِ وَما أَنِف",12,"ف",1,0],["أرى لفتةً منكم إليه مريبةً","فهل بكمُ من لوعةِ الحُبِّ ما بيا",13,"ي",2,0],["أَرى لَكَ أَن لا تَستَطيبَ لِخِلَّةٍ","كَأَنَّكَ فيها قَد أَمِنتَ مِنَ العَطَب",14,"ب",1,0],["أَرى لَكَ أَلّا تَمَلَّ الجِهازَ","لِقُربِ الرَحيلِ وَبُعدِ السَفَر",15,"ر",1,0],["أَرى لَكَ نَفساً تَبتَغي أَن تُعِزَّها","وَلَستَ تُعِزُّ النَفسَ حَتّى تُذِلَّها",16,"ل",3,0],["أرى لك نفساً في هواكَ مقيمةً","وقد طالَ ذا منها لكَ الويلُ فاقْصرها",17,"ر",3,0],["أَرى لَكُم في بَريدِ الدَهرِ مَألَكَةً","يَموجُ فيها الدَمُ المَسفوحُ عُنوانا",18,"ن",2,0],["أَرى للفَتى أَمراً يُعَجَّلُ في الدُنى","فَإِن يَكُ يَومُ الدينِ كانَ لَهُ أَمرُ",19,"ر",1,0],["أَرى لِيَ وَجهاً شَوَّهَ اللَهُ خَلقَهُ","فَقُبِّحَ مِن وَجهٍ وَقُبِّحَ حامِلُه",20,"ه",1,0],["أَرى لَكَ وَجهاً فَتَّتَ القَلبَ حُسنُهُ","بِهِ يَنجَلي كَربي وَقَد يَنجَلي الغِشا",21,"ش",2,0],["أَرى لِلكَأسِ حَقّاً لا أَراهُ","لِغَيرِ الكَأسِ إِلّا لِلنَديمِ",22,"م",1,1],["أَرى لِلصّبا وداعا","وما يَذْكُرُ اجْتماعا",23,"ع",2,1],["أرى لي بقربي منك عيناً قريرةً","وإن كان قرباً بالبعاد يشاب",24,"ب",1,0],["أَرى لي كُلَّ يَومٍ مَع زَماني","عِتاباً في البِعادِ وَفي التَداني",25,"ن",2,1],["أرى لك في هذا التورع مقصداً","وإلا فما ضب الفلا والتورع",26,"ع",1,0],["أرى لي في غواربها غريباً","من الآثارِ أسال من أرالِ",27,"ل",1,0],["أرى لك بالعلياء نارا فَراشُها","ضيوفُك يُقرَوْنَ السَّدِيفَ المسَرْهَدا",28,"د",2,0],["أَرى لَكَ يا خَزرونَ لُبنانَ في الوَرى","أَحاديثَ صِدقٍ لا تُشابُ بِإِلباسِ",29,"س",1,1],["أَرى لَيالِيَ مَن أَدنَيتَهُ زُهُراً","كَما لَيالِيَ مَن أَقصَيتَهُ سُحُمُ",30,"م",1,0],["أرى لهُ منْ لزومِ طاعتِهِ","عليَّ ما لا يَراهُ عَبْدي لي",31,"ي",1,0],["أرى للعقلِ حداً في التسامي","كمرمى الباصراتِ إلى حدودِ",32,"د",1,0],["أرى لي موقفاً حرجاً كأني","ضللتُ وليسَ في بحري منارُ",33,"ر",1,0],["أرى ليَ في شهر الصيام إذا أتى","لياليَ عَيّارٍ وأيام عابِدِ",34,"د",1,1],["أرى لك في لُبس القَبَاء لَباقةً","كأنك قد أُفرِغتَ في قالب الشَّكلِ",35,"ل",1,0],["أرى لك قبل الأُنس مزح تَظرُّفٍ","كذلك قبل الشمس يطلع فجرُها",36,"ر",3,0],["أرى ليلتي في الروضِ مثلي حزينةً","تنوحُ وتبكي والعيونُ هواجع",37,"ع",1,0],["أَرى لَكَ في جَوِّ المَعالي لَوامِعاً","وَقَد نَبَذَت عَينايَ نَظرَةَ شائِمِ",38,"م",1,0],["أرى لي طِيّةً عَرُضَتْ وطالَتْ","وليسَ مَطيّتي إلاّ نَداكا",39,"ك",2,0],["أَرى لَهُمُ ناراً تَلوحُ على عَلَمْ","أَشَقَّ عَلى قَلبِ الهَوى وَعَلى الظُلَمْ",40,"م",1,1],["أَرى لَكَ في نَبذِ الحُقوقِ خَليفَةً","أَخافُ عَلَيها مِن مُنابَذَةِ الدَهرِ",41,"ر",1,0],["أرَى لِزَماني يا ابنَ عَنبَسةٍ يَداً","إذا حُمدَت أيدي الزَّمانِ أذُمُّها",42,"ه",2,1],["أرى لكَ في شأني أموراً غريبةً","أقاومُ شكي عندها وأُغالِب",43,"ب",1,0],["أرى لك في وقت اللقاء بشاشةٌ","بها تبطلُ الدعوى وتصفو المشاربُ",43,"ب",1,0],["أرى لك فيّ لو خاطرتَ مَرْعىً","يبدِّلُ صحَّةً أُهُبَ الجِرابِ",44,"ب",1,0],["أرى لك أفعالاً تناقض أمرها","على أنها في القبح والعار واحد",45,"د",1,1],["أَرى لَكَ هَزَّةً لِلفَضلِ حَتّى","طِباعَكَ مَجرى الطَلاءِ",46,"ا",2,0],["أرى لك فَضلُ النّيّرَينِ عَلَى السُّها","عَلى الفَضلِ لا فَضل المُعَلاَّ على الحِلسِ",47,"س",1,0],["أرى لكِ أحشاءً تذوبُ لطافةً","فما لحشا حبّي غدا وهو جلمد",48,"د",1,0],["أَرى لَمعَ بَرقٍ مِن ثَناياك مُشرقِ","أَضاءَ سَناه بَينَ غَربٍ وَمَشرقِ",49,"ق",1,1],["أَرى لَيْلَ مَنْ أَهْوَاهُ مِثْلَ سُحَيْرِهِ","لِشِدَّةِ مَا يَلْقَاهُ مِنْ فَرْطِ ضَيْرِهِ",50,"ه",1,0],["أرى لذة العيش في طيّب","يُعجّل أو صالح يُدّخَر",51,"ر",1,0],["أَرى لَكَ باباً مُغلَقاً مُتَمَنِّعاً","إِذا فَتَحوهُ عَنكَ فَالبُؤسُ داخِلُه",52,"ل",2,0],["أَرى لُبنان يَدعوها مُشَوِقاً","لِوادٍ في حِماهُ بِهِ حِماكا",53,"ك",2,0],["أَرى لداتك حَولي لا أسر بِهم","إِذ لا تضمك تلكَ الأَوجه الصبح",54,"ح",1,0],["أَرى لَيلي عَلَيّ إِذ