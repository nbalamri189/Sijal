://www.poetsgate.com/ViewPoem.aspx?id=199726",""],[5102,"خيرا وسلاما","https://www.poetsgate.com/ViewPoem.aspx?id=17647",""],[5136,"يا لائمي لما عشقت","https://www.poetsgate.com/ViewPoem.aspx?id=121573",""],[5136,"هذا المحرم قادما مسروراً","https://www.poetsgate.com/ViewPoem.aspx?id=121575",""],[5145,"من لبرقٍ على البراق أنارا","https://www.poetsgate.com/ViewPoem.aspx?id=108062",""],[5829,"دعوة الى الستر","https://www.poetsgate.com/ViewPoem.aspx?id=157070",""],[5943,"ماذا عسانا نرتجي","https://www.poetsgate.com/ViewPoem.aspx?id=37271",""],[5956,"الشر فينا منذ قابيلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=192436",""],[5956,"حتى الدجى حسد النجاح فقد سجى","https://www.poetsgate.com/ViewPoem.aspx?id=193508",""],[5956,"أرجوك ربي صِلْ فؤاده بي","https://www.poetsgate.com/ViewPoem.aspx?id=204462",""],[5969,"فقدُ الهُيامِ مذلةٌ وعقابُ","https://www.poetsgate.com/ViewPoem.aspx?id=198625",""],[5309,"أنا من سكر هواهم ثمل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573771",""],[6277,"أنفاس عيد الفصح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64444&r=&rc=7",""],[4222,"بفتوح عصرك يفخر الإسلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52888&r=&rc=180",""],[4222,"شمل الهدى والملك عم شتاته","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52731&r=&rc=23",""]],"verses":[["وَبِفَضلِ ما أَوعى مُحَصَّبُها","وَأَقَرَّ مِن قِدَمٍ مُعَرَّفُها",0,"ف",3,0],["وبفِتْيَةٍ ألِفوا المِصاعَ كأنّهُمْ","أُسْدٌ منَ الأسَلاتِ في آجامِ",1,"م",1,0],["وبفريد يزدهي جيله","إذا ازدهى جيلٌ بإفراد",2,"د",1,0],["وبفتح مكَّةَ كم لهم في يومه","بلواء خير الخلق من متقدّمِ",3,"م",1,0],["وَبِفَرعٍ قَد تَدَلّى فاحِمٍ","كَتَدَلّي قِنوِ نَخلِ المُجتَني",4,"ي",1,0],["وَبِفَرعٍ حُدِّثتُهُ كَالمَثاني","عُلَّ بِالمِسكِ فَهوَ مِثلَ السَديلِ",5,"ل",1,0],["وَبِفِرعَونَ إِذا تَشاقَّ لَهُ","الماءُ فَهَلّا لِلَّهِ كانَ شَكورَ",6,"ر",1,1],["وَبِفَصلِ الخِطابِ لِلخُطَّةِ البَز","لاءِ تُعيِي مَهامِزَ المُقتالِ",7,"ل",1,0],["وَبِفَكِّ العُناةِ قَد يَئِسوا في ال","قِدِّ مِن كَرِّ وَفدَةِ الرُحّالِ",7,"ل",1,0],["وَبِفاحِمٍ رَجلٍ أَثيثٍ نَبتُهُ","كَالكَرمِ مالَ عَلى الدِعامِ المُسنَدِ",8,"د",1,0],["وبِفَوْديكَ في ضَفائِرِكَ","السُّودِ تَدُبُّ الأيَّامُ أيَّ دَبيبِ",9,"ب",1,0],["وَبِفَضْلِهِمْ غُذِيَتْ غِرَاثُ عُقُولِهِمْ","مِنْ كُلِّ فَاكِهَةٍ أَلَذَّ غِذَاءِ",10,"ا",2,0],["وبفاحمٍ رجلٍ ، أثيثٍ نيتهُ","، كالكرمِ مالَ على الدعامِ المسندِ",11,"د",1,0],["وبفيض النبي يفيض على ال","غياب سر المراد والحضار",12,"ر",1,0],["وبفضل فيض نعمته","فيه تعلو للسما عمدي",13,"د",2,0],["وبفضله انجلت الهموم وبدلت","بعد المضرة والعنى بصفاء",14,"ا",2,0],["وبفتح مكة ضاءت الدنيا به","مذ جاءها بعمامة سوداء",14,"ا",2,0],["وبفقه الدن متن نصه","هامش الكأس لمتن الروح شرح",15,"ح",1,0],["وبفيضه الضافي العميم","تيسير أحكامِ البناءْ",16,"ا",2,0],["وَبِفَضلِ قَومِكَ مِن إِبائِكَ شاهِدٌ","إِنَّ الإِباءَ عَنِ الأُبُوَّةِ يُعرِبُ",17,"ب",1,0],["وَبِفتحِ خيبرَ كان عنهُ زَعيما","صلّوا عليهِ وَسلّموا تَسليما",18,"م",2,0],["وَبِفيهِ مُدامَةٌ كُلَّما حليتُ عَن شُربِ","كأسهِادام سُكري",19,"ر",2,0],["وبفيض الجود لمن قصدا","وبنيل الفوز لمن عبدا",20,"د",2,0],["وبفرد الوقت ووقت الفر","د بأفرادٍ لم تنعطف",21,"ف",1,0],["وَبِفاروقِكَ الضَجيعِ الَّذي قَد","كُنتَ تَرضى بِحُكمِهِ المَرضِيِّ",22,"ي",1,0],["وَبفضله درت حليمة حين مس","الضرع منها بالبنان وَبالفم",23,"م",1,0],["وبِفيهِ شِفَاءُ ظَمَائِيَ لَوْ","يَدْنو لِذَمَائِيَ مَوْرِدُهُ",24,"د",2,0],["وبفضلِ الرقصِ نالا ما استطاعا","إِن للرقصِ يداً لا تجحد",25,"د",1,0],["وَبِفَقري إِلَيهِ صِرتُ غَنِيّاً","وَعَلى بابِيَ المُلوكُ تَكَدّي",26,"د",2,0],["وَبِفَرقي بَينَ لَيل","ينِ بِهِ لِلغَيِّ رُشدُ",27,"د",1,0],["وَبِفَضل اللَه قُلنا أَرّخوا","فَلينعَّم نعم دار المتَّقين",28,"ن",1,0],["وبفضلِه في الدّهرِ حا","سِدُه على رَغْمٍ يُقِرّ",29,"ر",1,0],["وبفضلِ مَالِكه تَعَوْ","وَذَ أن يَظُنَّ به المَلاَلا",30,"ل",2,0],["وبفيك المورد العذب الَّذي","أرتوي منه ومن لي بالورود",31,"د",1,0],["وبفضل الله يعلو مجده","فتعالى الله ذو العرش المجيد",31,"د",1,0],["وبفضله قد ضاء مفتاح السنا","لله كم نلنا براحته المنا",32,"ن",2,0],["وبفرق لاح بذي جعد","كالصبح بليل مندرج",33,"ج",1,0],["وبفضله الإنجيل جاء مصرحاً","ودعاه موسى الطهر في توراته",34,"ت",2,0],["وبفقدهم خرج النبي محمد","من مكة واختار يثرب منزلا",35,"ل",2,0],["وبِفَضلهم نَطَقَ الكتاب وشأنهم","شأن لدى ربّ السماءِ عظيمُ",36,"م",1,0],["وَبِفَضلك السامي شرعتَ مناهجاً","وأقمتَ فيها للعلا بُنيانا",37,"ن",2,0],["وَبفطنة تومي إِلَيهِ بسبقه","عَنهُم تُماط مِن العَناء تَمائم",38,"م",1,0],["وَبفضلِه شهد العداةُ وَحسبُهُ","شَرَفاً شَهادةُ حاسدٍ وَخصيم",39,"م",1,0],["وَبفهمه المَشهور أَضحى مُفرداً","بَينَ الوَرى في سائر الأَحوال",40,"ل",1,0],["وَبفصل القضاء قد ردّ عَنهُ","ما اِعتَراه مِن رَيبة وَعثار",41,"ر",1,0],["وَبِفَتحِ مَكَّةَ قَد عَفا عمّن هَفا","فأتَوهُ بِالتَرغيبِ وَالتَرهيبِ",42,"ب",1,0],["وَبفاعم رحل أثيث بنانه","كالدَّوم مال على الرُّخام المسندِ",43,"د",1,0],["وَبِفاصِلٍ لَكَ ذي الفَقارِ مُفَرِّقٌ","ما جَمَّعوهُ وَجامِعٌ ما فَرَّقوا",44,"ق",3,0],["وبفرقة النقاش ذاك الشاب ناقش","ني مناقشة الذي لا يشفق",45,"ق",1,0],["وبفضله قد ضاء مفتاح السنا","لله كم نلنا براحته المنى",46,"ن",2,0],["وبفيض أنعام من المولى وفي","عزٍ مديدٍ دايمٍ لا يبتدلْ",47,"ل",1,0],["وبفضلهِ وببذلهِ وبعقلهِ","وبحلّهِ للمشكلات المعقدَهْ",48,"د",2,0],["وبفاطم فطم الألى بولائهم","طابوا اصولا من لظى وعذابها",49,"ب",3,0],["وبفعولن متقارب يرد","مثمنا على عروضه اعتمد",50,"د",1,0],["وبفيض مرتبة الوجود تقيد ال","امكان في إيجاد ماهياته",51,"ت",2,0],["وَبِفَضل ذياك الكَثيب وَأَهلِهِ","جاءَ الحَديث موضح الأَسنادِ",52,"د",1,0],["وَبِفاتري جِفني عُيون كحلت","كُحل البَها عَجَباً بِغَير المرود",53,"د",1,0],["وَبِفرقَدي نِهدَيك أَشراقاً عَلى","صَدر بِهامات النُجوم مقلد",53,"د",1,0],["وبفرعٍ مال على كفلٍ","كشراع سفين في بحر",54,"ر",1,0],["وبفضل من فضلك ابدل ملامى","بحديث ولا تزده اطاله",55,"ل",2,0],["وبفطنة تجلو الصواب ولو غدا","باللباس في نفق من الأنفاق",56,"ق",1,0],["وبفصحه نجت الأنام كما نجا","في فصح موسى شعبهُ المتظلم",57,"م",1,0],["وبفضلِ الإلهِ أحرز مجداً","لم تَحُز بعضَ قدرِهِ الأكفاء",58,"ا",2,0],["وبفضلِ نهضتهم غدا","سيرُ الجميع إلى ارتقاء",59,"ا",2,0],["وبفضلِكَ المشهودِ قال مؤرخٌ","نزلت فسيحاً لا يقلُّ نعيمُهُ",60,"م",2,0],["وبفاي منازل فرشان","اقفرت بعد اهلها اقفرا",61,"ر",2,0],["وبفضلِ سيدنا الحسين أبي الندا","سبطِ النبيِّ وبهجةِ الأكوانِ",62,"ن",1,0],["وَبِفَضلِهِم رَكِبُوا الجِيادَ وَثَمَّرُوا","أَموالَ ماشِيَةٍ لَهُم وَسَوامُ",63,"م",1,0],["وبفكرك الساري","عهدت عوارفاً لا تحصر",64,"ر",1,0],["وبفعل احمد وابن يوسف والفتى","جلحاب اسفل بالذليل الأدغم",65,"م",1,0],["وبفضل رسل الشاء أثمر وطبها","وطب قديم العهد بالإثمار",66,"ر",1,0],["وبفرقان وجنتيك قرأناً","أيها العاشقون موتوا غراما",67,"م",2,0],["وبفيك ترياق به تُرقى وما","بسواه من لدغ الجفون عياذُه",68,"ذ",2,0],["وَبِفَيضه رَبّ السَماء أَمَده","تَاللَه لَم يَك فيكَ حَيدَر وَحدَه",69,"ه",1,0],["وبفعلك الاسم المسمى ثابت","يا عامراً أكرم به من عامر",70,"ر",1,0],["وَبِفِتيانٍ أَبَت نَخوَتُهُم","هينَةً في كُلِّ قَصدٍ قَيِّمِ",71,"م",1,0],["وبفيه خمرة لطفهّا","عبق يخبر عن أوصافه",72,"ف",2,0],["وبفضل من الإله تعالى","قد سرى في البنين سر الجدود",73,"د",1,0],["وبفيض الجود منه","يبلغ العبد مناه",74,"ا",2,0],["وبفضل ليلة نصفه قد فسرت","في الذكر من تنزيله آيات",75,"ت",1,0],["وبفهرٍ فِي ظَفارٍ","لَمْ يزل فِيهَا مُجابا",76,"ب",2,0],["وبفتْكهِ بالضدِّ قد بلغ الوتر","حزنَ العدوُّ على خسارته وناح",77,"ح",1,0],["وَبِفَضلِكَ المَشهور يقعد باطِل","بَينَ الرَعِيَّةِ وَالحُقوقُ تُقامُ",78,"م",1,0],["وَبِفُعُولٍ فَعَلٌ نَحو كَبِد","يُخَصَّ غَالِباً كَذَاكَ يَطَّرِد",79,"د",1,0],["وَبِفَعَائِلَ اجمَعنَ فَعَالَهُ","وَشِبهِهِ ذَا تَاءٍ أو مُزَالَه",79,"ه",1,0],["وَبِفَعًالِلَ وَشِبهِهِ انِطقا","فِى جَمعِ مَا فَوقَ الثَّلاَثَةِ ارتَقَى",79,"ق",2,0],["وبفقدها فقد النبي فانها","تحكيه في نطق وفي مشي وقد",80,"د",1,0],["وَبِفَضل بسم اللَه في تاريخه","إِبدأ مُحب تِلاوَة القُرآن",81,"ن",1,0],["وبفتح أربيل بلغت من العلا","ما كاد يسمو للسموات العلى",82,"ل",2,0],["وبفيه من الرّضاب سلاف","لم يصبه الشّماس والقسّيس",83,"س",1,0],["وَبِفَترة الأَجفان ترشُقُ في الحَشا","سَهمَ المَنيّة عَن لِحاظ جَآذرِ",84,"ر",1,0],["وبفرقه ومجمعه","حاز المراتب من قدير",85,"ر",1,0],["وبفاحمٍ كالَّليلِ مُنسدلٍ على","وجهٍ كغرةٍ صبحهِ المُتبلجِ",86,"ج",1,0],["وبفصيحٍ جاء في اللسانِ","فارزق لنا فصاحةَ اللسانِ",87,"ن",1,0],["وبفضلك الغفار إني راجياً","غفرانك السَّتَّار عيباً يرسبُ",88,"ب",1,0],["وَبفحم مِن يندّد باحتدامِ","فَكَم أَجرى لَنا مجرى وَسعياً",89,"ي",2,0],["وَبِفِكرَة وَقادَة وَقَريحة","نَقادَة قَد كَمَلَت آدابي",90,"ب",2,0],["وبفاروقك المفرّق بالبأ","س جموع الاضلال والاغواء",91,"ا",2,0],["وبفخرك السامى ومجدك","يا لها عظمت قسامه",92,"م",2,0],["وبفضله شهدت له أعداؤه","وكفى بهذا الغيظ للحساد",93,"د",1,0],["وبفضل صيتك صاح صوت مطرب","غنت على ألحانه حانات",94,"ت",1,0],["وبفضل أَفضلهِ وعزِّ عزيزهِ","وظهورِ ظاهرهِ لنا سرواتُهُ",95,"ت",2,0],["وبفتحِ قعةِ بعلبك تهذَّبتْ","هذي الممالكُ واستقامَ الشّامُ",96,"م",1,0],["وَبِفَضلِ صاحِبِهِ وَفَضلِ صَحابِهِ","وَالآلِ وَالأَتباعِ وَالمُتَشَهِّدِ",97,"د",1,0],["وبفنج هتيك الجفون تملكت","مهج الرجال وكم أذلَّت قسورا",98,"ر",2,0],["وبفرقها كم ضاءَ شَمسٌ في دُجى","جعدٍ يسود سوادَ لَيلٍ أدهما",99,"م",2,0],["وبفرق راس الشرق ضاءَ شوارِقٌ","لا يعتريها بالدهور غُروبُ",100,"ب",1,0],["وَبِفتَحِ الأَقصى لَكُم شَرفٌ أَح","رَزَ أَجراً عِندَ الإِلهِ جَميلا",101,"ل",2,0],["وبفن الآداب سدت ابن اوس","وابن عباد عاد عندك كالقن",102,"ن",1,0],["وبفسحِ المنحنى من عالج","تسحُ الدمعَ على الخد انسفاجا",103,"ج",2,0],["وبفقد تفصيل الجمل","وجدوا علامات وسل",104,"ل",1,0],["وبفقري أممتُ جودَ غنىٍ","أمَّه الأغنياء والفقراء",105,"ا",2,0],["وبفيض النوال شرعة جودٍ","لك روّى نميرُها كل صادى",106,"د",2,0],["وبفضلٍ من الحسين حسينٌ","شاد منها بجوده الأركانا",107,"ن",2,0],["و(بِفِيتُو) .. وَبِأَشْياءٍ كَهَذِي","وَصناديقَ بِهَا بَعْضُ الْهَدَايا",108,"ا",3,0],["وَبِفَضْلِهِمْ تَهْتَزُّ سُلْطَةُ مُجْرِمٍ","مَوْلاْهُ مُرْتَزِقٌ وَلِصٌّ أَزْعَرُ",109,"ر",1,0],["وبفضلِ قُوْتِكَ خُصَّ صاحبَ حاجةٍ","كم من عزيزٍ باتَ أهونَ حالا",110,"ل",2,0],["وبِفَيْئِها غُطَّ بِأحلى منامةٍ","مِن بَعدِ قاتٍ مضْغُهُ مسمومُ",111,"م",1,0],["وبفالق الأصباح","من غرر زهت تحت الطرر",112,"ر",1,0],["وبفالق الإصباح عن غرر زهت","حسناً ويغطش شعرها ديجورا",113,"ر",2,0],["وبفينان واردٍ دعص رملٍ","جلّ حتى أغصّ منها الأزارا",114,"ر",2,0],["وبفضل من زرعوا لذلك بذرة","جُلبت علينا حقبة سوداء",115,"ا",2,0],["وبفتلِ راقصة ِالغنا","قد سمَّمواالنظرَ الخجولْ",116,"ل",1,0],["وبفضل تربية الطفولة والهدى","لم يُغْوِني جاه ولا شيطانُ..",117,"ن",1,0],["وبفضل نورك ظَل شعري منتجا","ويظل موجُ تشكري متموّجا",118,"ج",2,0],["وبفضل عقلٍ راجحٍ متكاملٍ","من خير حكّامٍ بهمْ ضُرِبَ المثلْ",119,"ل",1,0],["وَبِفُلْكِهِ نَمضي إلى حيثُ الهَوى","وبنا اعتقادٌ لَيسَ ثَمَّ إيابُ",120,"ب",1,0],["وَبِفَنِّي المُزدَهي بَينَ الوَرى","زَمزَمَ الحادي وسارَ المَثَلُ",121,"ل",1,0],["وبفقه الدّنّ متن نصّه:","هامش الكأس لمتن الروض شرح",122,"ح",1,0],["وبفتح قلعة بعلبك تهذبت","هذي الممالك واستقام الشام",123,"م",1,0],["وبفضل أفضله وعز عزيره","وظهور ظاهره لنا سرواته",124,"ت",2,0]]}