{"poems":[[53,"قضت المنازل يوم كاظمة","https://www.aldiwan.net/poem29962.html","الكامل"],[63,"خدع المنى وخواطر الأوهام","https://www.aldiwan.net/poem46123.html","الكامل"],[93,"إلى الأديب العبقري","https://www.aldiwan.net/poem9842.html","السريع"],[83,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[31,"قد صبا القلب صبا غير دني","https://www.aldiwan.net/poem38731.html","الرمل"],[31,"كدت يوم الرحيل أقضي حياتي","https://www.aldiwan.net/poem42017.html","الخفيف"],[21,"وبفرعون إذا تشاق له","https://www.aldiwan.net/poem36209.html","الخفيف"],[22,"شكت العنتريس نصي وإدلا","https://www.aldiwan.net/poem21677.html","الخفيف"],[7,"أمن آل مية رائح أو مغتد","https://www.aldiwan.net/poem2002.html","الكامل"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66003","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[7,"مِنَ آلِ مَيّة َ رائحٌ، أو مُغْتَدِ،","https://www.poetsgate.com/ViewPoem.aspx?id=17556",""],[113,"هجم الليل بعد فر النهار","https://www.aldiwan.net/poem41779.html","الخفيف"],[113,"لاحظ المسكين بالمدد","https://www.aldiwan.net/poem42010.html","المديد"],[113,"عج بالركائب ساحة الجرعاء","https://www.aldiwan.net/poem42181.html","الكامل"],[122,"هاتها واشرب فإن اليوم فصح","https://www.aldiwan.net/poem23717.html","الرمل"],[133,"لمهندس الكون العظيم","https://www.aldiwan.net/poem49099.html","مجزوء الكامل"],[141,"ما لي مقال عن فعالك يعرب","https://www.aldiwan.net/poem11728.html","الكامل"],[187,"عج بالمدينة تلق ثم كريما","https://www.aldiwan.net/poem35109.html","الكامل"],[250,"عاتباه في فرط ظلمي وهجري","https://www.aldiwan.net/poem1426.html",""],[257,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[257,"قم نحو حماه وانصرف","https://www.aldiwan.net/poem35942.html","المتدارك"],[257,"هزنا الشوق للمقام السني","https://www.aldiwan.net/poem35969.html","الخفيف"],[269,"كم ذا أراها نحو طيبة ترتمي","https://www.aldiwan.net/poem52047.html","الكامل"],[273,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[296,"نفخ الصور فهبوا مسرعين","https://www.aldiwan.net/poem36856.html","عموديه"],[347,"أي وجد بين الورى مثل وجدي","https://www.aldiwan.net/poem15595.html","الخفيف"],[347,"مر بي بالآب والإبن","https://www.aldiwan.net/poem15641.html","مجزوء الرمل"],[351,"طيب الله ثرى قبر حوى","https://www.aldiwan.net/poem39760.html","الرمل"],[362,"في الجيرة الغادين بدر","https://www.aldiwan.net/poem60895.html","مجزوء الكامل"],[406,"قالوا ترشفت الليالي ماءه","https://www.aldiwan.net/poem32170.html","الكامل"],[413,"ما قضى إلا على الصب العميد","https://www.aldiwan.net/poem54016.html","الرمل"],[426,"يا من بنور شهابه العليا تضي","https://www.aldiwan.net/poem40998.html","الكامل"],[426,"كحلت بالسحر وبالدعج","https://www.aldiwan.net/poem41429.html","المتدارك"],[438,"خل الكئيب بدائه في ذاته","https://www.aldiwan.net/poem14341.html","الكامل"],[513,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"]],"verses":[["وَبِفَضلِ ما أَوعى مُحَصَّبُها","وَأَقَرَّ مِن قِدَمٍ مُعَرَّفُها",0,"ف",3,0],["وبفِتْيَةٍ ألِفوا المِصاعَ كأنّهُمْ","أُسْدٌ منَ الأسَلاتِ في آجامِ",1,"م",1,0],["وبفريد يزدهي جيله","إذا ازدهى جيلٌ بإفراد",2,"د",1,0],["وبفتح مكَّةَ كم لهم في يومه","بلواء خير الخلق من متقدّمِ",3,"م",1,0],["وَبِفَرعٍ قَد تَدَلّى فاحِمٍ","كَتَدَلّي قِنوِ نَخلِ المُجتَني",4,"ي",1,0],["وَبِفَرعٍ حُدِّثتُهُ كَالمَثاني","عُلَّ بِالمِسكِ فَهوَ مِثلَ السَديلِ",5,"ل",1,0],["وَبِفِرعَونَ إِذا تَشاقَّ لَهُ","الماءُ فَهَلّا لِلَّهِ كانَ شَكورَ",6,"ر",1,1],["وَبِفَصلِ الخِطابِ لِلخُطَّةِ البَز","لاءِ تُعيِي مَهامِزَ المُقتالِ",7,"ل",1,0],["وَبِفَكِّ العُناةِ قَد يَئِسوا في ال","قِدِّ مِن كَرِّ وَفدَةِ الرُحّالِ",7,"ل",1,0],["وَبِفاحِمٍ رَجلٍ أَثيثٍ نَبتُهُ","كَالكَرمِ مالَ عَلى الدِعامِ المُسنَدِ",8,"د",1,0],["وبِفَوْديكَ في ضَفائِرِكَ","السُّودِ تَدُبُّ الأيَّامُ أيَّ دَبيبِ",9,"ب",1,0],["وَبِفَضْلِهِمْ غُذِيَتْ غِرَاثُ عُقُولِهِمْ","مِنْ كُلِّ فَاكِهَةٍ أَلَذَّ غِذَاءِ",10,"ا",2,0],["وبفاحمٍ رجلٍ ، أثيثٍ نيتهُ","، كالكرمِ مالَ على الدعامِ المسندِ",11,"د",1,0],["وبفيض النبي يفيض على ال","غياب سر المراد والحضار",12,"ر",1,0],["وبفضل فيض نعمته","فيه تعلو للسما عمدي",13,"ي",1,0],["وبفضله انجلت الهموم وبدلت","بعد المضرة والعنى بصفاء",14,"ا",2,0],["وبفتح مكة ضاءت الدنيا به","مذ جاءها بعمامة سوداء",14,"ا",2,0],["وبفقه الدن متن نصه","هامش الكأس لمتن الروح شرح",15,"ح",1,0],["وبفيضه الضافي العميم","تيسير أحكامِ البناءْ",16,"ا",2,0],["وَبِفَضلِ قَومِكَ مِن إِبائِكَ شاهِدٌ","إِنَّ الإِباءَ عَنِ الأُبُوَّةِ يُعرِبُ",17,"ب",1,0],["وَبِفتحِ خيبرَ كان عنهُ زَعيما","صلّوا عليهِ وَسلّموا تَسليما",18,"م",2,0],["وَبِفيهِ مُدامَةٌ كُلَّما حليتُ عَن شُربِ","كأسهِادام سُكري",19,"ر",2,0],["وبفيض الجود لمن قصدا","وبنيل الفوز لمن عبدا",20,"د",2,0],["وبفرد الوقت ووقت الفر","د بأفرادٍ لم تنعطف",21,"ف",1,0],["وَبِفاروقِكَ الضَجيعِ الَّذي قَد","كُنتَ تَرضى بِحُكمِهِ المَرضِيِّ",22,"ي",1,0],["وَبفضله درت حليمة حين مس","الضرع منها بالبنان وَبالفم",23,"م",1,0],["وبِفيهِ شِفَاءُ ظَمَائِيَ لَوْ","يَدْنو لِذَمَائِيَ مَوْرِدُهُ",24,"د",2,0],["وبفضلِ الرقصِ نالا ما استطاعا","إِن للرقصِ يداً لا تجحد",25,"د",1,0],["وَبِفَقري إِلَيهِ صِرتُ غَنِيّاً","وَعَلى بابِيَ المُلوكُ تَكَدّي",26,"د",2,0],["وَبِفَرقي بَينَ لَيل","ينِ بِهِ لِلغَيِّ رُشدُ",27,"د",1,0],["وَبِفَضل اللَه قُلنا أَرّخوا","فَلينعَّم نعم دار المتَّقين",28,"ن",1,0],["وبفضلِه في الدّهرِ حا","سِدُه على رَغْمٍ يُقِرّ",29,"ر",1,0],["وبفضلِ مَالِكه تَعَوْ","وَذَ أن يَظُنَّ به المَلاَلا",30,"ل",2,0],["وبفيك المورد العذب الَّذي","أرتوي منه ومن لي بالورود",31,"د",1,0],["وبفضل الله يعلو مجده","فتعالى الله ذو العرش المجيد",31,"د",1,0],["وبفضله قد ضاء مفتاح السنا","لله كم نلنا براحته المنا",32,"ن",2,0],["وبفرق لاح بذي جعد","كالصبح بليل مندرج",33,"ج",1,0],["وبفضله الإنجيل جاء مصرحاً","ودعاه موسى الطهر في توراته",34,"ت",2,0],["وبفقدهم خرج النبي محمد","من مكة واختار يثرب منزلا",35,"ل",2,0]]}