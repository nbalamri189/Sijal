{"poems":[[53,"قضت المنازل يوم كاظمة","https://www.aldiwan.net/poem29962.html","الكامل"],[63,"خدع المنى وخواطر الأوهام","https://www.aldiwan.net/poem46123.html","الكامل"],[93,"إلى الأديب العبقري","https://www.aldiwan.net/poem9842.html","السريع"],[83,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[31,"قد صبا القلب صبا غير دني","https://www.aldiwan.net/poem38731.html","الرمل"],[31,"كدت يوم الرحيل أقضي حياتي","https://www.aldiwan.net/poem42017.html","الخفيف"],[21,"وبفرعون إذا تشاق له","https://www.aldiwan.net/poem36209.html","الخفيف"],[22,"شكت العنتريس نصي وإدلا","https://www.aldiwan.net/poem21677.html","الخفيف"],[7,"أمن آل مية رائح أو مغتد","https://www.aldiwan.net/poem2002.html","الكامل"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66003","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[7,"مِنَ آلِ مَيّة َ رائحٌ، أو مُغْتَدِ،","https://www.poetsgate.com/ViewPoem.aspx?id=17556",""]],"verses":[["وَبِفَضلِ ما أَوعى مُحَصَّبُها","وَأَقَرَّ مِن قِدَمٍ مُعَرَّفُها",0,"ف",3,0],["وبفِتْيَةٍ ألِفوا المِصاعَ كأنّهُمْ","أُسْدٌ منَ الأسَلاتِ في آجامِ",1,"م",1,0],["وبفريد يزدهي جيله","إذا ازدهى جيلٌ بإفراد",2,"د",1,0],["وبفتح مكَّةَ كم لهم في يومه","بلواء خير الخلق من متقدّمِ",3,"م",1,0],["وَبِفَرعٍ قَد تَدَلّى فاحِمٍ","كَتَدَلّي قِنوِ نَخلِ المُجتَني",4,"ي",1,0],["وَبِفَرعٍ حُدِّثتُهُ كَالمَثاني","عُلَّ بِالمِسكِ فَهوَ مِثلَ السَديلِ",5,"ل",1,0],["وَبِفِرعَونَ إِذا تَشاقَّ لَهُ","الماءُ فَهَلّا لِلَّهِ كانَ شَكورَ",6,"ر",1,1],["وَبِفَصلِ الخِطابِ لِلخُطَّةِ البَز","لاءِ تُعيِي مَهامِزَ المُقتالِ",7,"ل",1,0],["وَبِفَكِّ العُناةِ قَد يَئِسوا في ال","قِدِّ مِن كَرِّ وَفدَةِ الرُحّالِ",7,"ل",1,0],["وَبِفاحِمٍ رَجلٍ أَثيثٍ نَبتُهُ","كَالكَرمِ مالَ عَلى الدِعامِ المُسنَدِ",8,"د",1,0],["وبِفَوْديكَ في ضَفائِرِكَ","السُّودِ تَدُبُّ الأيَّامُ أيَّ دَبيبِ",9,"ب",1,0],["وَبِفَضْلِهِمْ غُذِيَتْ غِرَاثُ عُقُولِهِمْ","مِنْ كُلِّ فَاكِهَةٍ أَلَذَّ غِذَاءِ",10,"ا",2,0],["وبفاحمٍ رجلٍ ، أثيثٍ نيتهُ","، كالكرمِ مالَ على الدعامِ المسندِ",11,"د",1,0]]}