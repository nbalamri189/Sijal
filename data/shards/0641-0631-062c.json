5150,"رجل برسم الحب ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203782",""],[5183,"إلى حادي العزائم","https://www.poetsgate.com/ViewPoem.aspx?id=180221",""],[5185,"شمس العماد","https://www.poetsgate.com/ViewPoem.aspx?id=118566",""],[5190,"يا صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=123994",""],[5204,"فرجها دنّ بشوط","https://www.poetsgate.com/ViewPoem.aspx?id=200369",""],[5351,"فهوت قواها حين حرك إصبعه","https://www.poetsgate.com/ViewPoem.aspx?id=202706",""],[5351,"أعجوبة الله","https://www.poetsgate.com/ViewPoem.aspx?id=203700",""],[5376,"حتَّام يا عربي","https://www.poetsgate.com/ViewPoem.aspx?id=190351",""],[5672,"نظرة الى تلك القبور","https://www.poetsgate.com/ViewPoem.aspx?id=206505",""],[1680,"يا من تحل بذكره","https://www.poetsgate.com/ViewPoem.aspx?id=108880",""],[5695,"لي في الصّبابة مذهب..","https://www.poetsgate.com/ViewPoem.aspx?id=212396",""],[5720,"فَرَجُ اللهِ قريبٌ ..","https://www.poetsgate.com/ViewPoem.aspx?id=198837",""],[5725,"شمس بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=177437",""],[5804,"حديث الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=184472",""],[5887,"قال السجين","https://www.poetsgate.com/ViewPoem.aspx?id=35277",""],[5953,"يا أيها الأول الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=93785",""],[5956,"أَمَرَ البصيرُ نبيَّه","https://www.poetsgate.com/ViewPoem.aspx?id=192631",""],[5956,"تجديد الانتماء","https://www.poetsgate.com/ViewPoem.aspx?id=193912",""],[5997,"براءة","https://www.poetsgate.com/ViewPoem.aspx?id=214220",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6023,"وبطومار الوفا ينسخ ما","https://www.poetsgate.com/ViewPoem.aspx?id=123878",""],[6102,"ماخُور !!","https://www.poetsgate.com/ViewPoem.aspx?id=185041",""],[6124,"هجعت","https://www.poetsgate.com/ViewPoem.aspx?id=174907",""],[242,"فرجت من همي ومن بوسي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563732",""],[6320,"عَوْدَةُ الجَوَاد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84341&r=&rc=38",""],[6340,"غادة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85846&r=&rc=11",""]],"verses":[["فَرَجَّعَ في حَلقِهِ غُصَّةً","كَما رَجَّعَ الجَرَّةَ البازِلُ",0,"ل",1,0],["فَرَّجَتها يَداكَ وَالنَقعُ قَد سَد","دَ عَلى العاصِفاتِ كُلَّ مَهَبِّ",1,"ب",1,0],["فَرَجَعتُ مَحموداً بِرَأسِ عَظيمِه","وَتَرَكتُها جَزَراً لِمَن ناواها",2,"ا",3,0],["فرجاؤنا دفع الجنيه معجلاً","فيزيدنا حسن الختام رباحا",3,"ح",2,0],["فَرَّجتُ عَن جَوفِهِ الظَلماءَ يَحمِلُني","غَوجٌ مِنَ العيدِ وَالأَسرابُ لَم تَرد",4,"د",1,0],["فرجَعت عن ذاك السما","ع وغِبت عن ذاك الشعور",5,"ر",1,0],["فرجالها أسمى الورى وطنية","وأشدهم صبراً بيوم نضالها",6,"ل",3,0],["فرجونا طول البقاء وإن كنّا","علمنا بأننا سنزول",7,"ل",1,0],["فَرَجتَ الهَمَّ وَالحَلَقاتِ عَنهُم","فَأَحيا الناسُ وَالبَلَدُ المُحولُ",8,"ل",1,0],["فَرَّجتُ كُربَتَهُ بِضَربَةِ فَيصَلٍ","أَو ذاتِ فَرغٍ بِالدِماءِ رَذومِ",9,"م",1,0],["فَرَجَعتِ صاغِرَةً بِلا تِرَةٍ","مِمّا طَلَبتِ بِها وَلا وَترِ",10,"ر",1,0],["فرَّجتَ بالوعظِ عن خواطرنا","فنحنُ نفديك يا أبا الفرج",11,"ج",1,0],["فرجَعَتُ مِنْ كَثَبٍ إلي","كَ مُفرِّغاً نفسي لشُكرِكْ",12,"ك",1,0],["فرجعتُ حين رأيته","باليأسِ مما أرتَجيهِ",13,"ي",2,0],["فَرَجَعتُ أَحسَبُهُم بَرابِرَةً","في مَهمَه وَأَظُنُّني وَلَدا",14,"د",2,0],["فَرَجِعتُ أَدراجي أُغالِبُهُ","بِاليَأسِ آوِيَة وَبِالصَبرِ",15,"ر",1,0],["فَرَجِعتُ أَدراجي أُغالِبُهُ","اليَأسِ آوِنَة وَبِالصَبرِ",15,"ر",1,0],["فَرَجِعتُ أَدراجي أُغالِبُهُ","بِاليَأسِ آوِنَة وَبِالصَبرِ",15,"ر",1,0],["فَرَجَعتُ أَخيَبَ ما يَكونُ مُؤَمِّلٌ","راجٍ وَأَخسَرَ ما يَكونُ الخاسي",16,"س",2,0],["فَرَجَعتُ مُرتَعِشَ الخَواطِرِ وَالمُنى","كَحَمامَةٍ مَحمولَةٍ في زَعزَعِ",17,"ع",1,0],["فَرَجِعتُ مَصدوعَ الفُؤادِ أَبُثُّكُم","شَجوي وَأَندُبُ حالَةَ العُمّالِ",18,"ل",1,0],["فَرِجلٌ تَطلِبُ المَسعى","إِلَيكُم قَد مَنَعناها",19,"ا",3,0],["فرجع منكر الفؤاد منكسا","للراس لا أرنو إلى أطرافي",20,"ف",2,0],["فرجعت عنه الى الضمير","مطلقا لتعقلي",21,"ل",2,0],["فَرَجنا عَنِ الأَسرى الأَداهِمَ بَعدَما","تَخَمَّطَ وَاِشتَدَّت عَلَيهِم شَكايِمُه",22,"م",2,0],["فَرْجي عفيفٌ عن الحَرامِ ول","كنَّ لساني لسانُ عيَّارِ",23,"ر",1,0],["فرَّجْتَها بصائحٍ إن تَعتَلِلْ","فلهنَّ من ضَرْبِ الرِّقابِ شِفاءُ",24,"ا",2,0],["فرجعتَ من حمى الحياة لمثلها","حمّى تهد الصرح وهو مقام",25,"م",1,0],["فَرَّجتَ ظُلمَتَها بِخُطبَةِ فَيصَلٍ","مَثَلٌ لَها في الرَوعِ طَعنَةُ فَيصَلِ",26,"ل",1,0],["فَرَجَعتُ الرَسولَ بِالعُذرِ مِنّي","نَحوَ هِندٍ وَلَم أَخَف أَن تَريعا",27,"ع",2,0],["فَرِّجوها وَاِكشِفوا ظُلمَتَها","بِقُوىً كَشّافَةٍ لِلظُلَمِ",28,"م",1,0],["فَرَجِّ الفَتى ما دامَ يَحيا فَإِنَّهُ","إِلى خَير حالاتِ المُنيبِ يَصِيرُ",29,"ر",1,0],["فَرَجَعَت كَغادَةٍ كَعابٍ","تَقَرُّ فيها أَعيُنُ الأَحبابِ",30,"ب",1,0],["فَرَجاً يُضيءُ لَكَ اِنفِتاقُ صَباحِهِ","مُتَبَلِّجاً مِن ظُلمَةِ الإِحسانِ",31,"ن",1,0],["فَرَجُ الأَعداءِ بِالسِلمِ مِنهُ","وَهوَ في السِلمِ يُعِدُّ السِلاحا",32,"ح",2,0],["فَرَجَمناها بِغُرَّتِها","فَقَضَت لِلحِرصِ آرابا",33,"ب",2,0],["فَرَجنا ساطِعَ الغَمَراتِ عَنّا","وَعَن مَروانَ فَاِنفَرَجَ الغُبارُ",34,"ر",1,0],["فَرَّجَ عَنّي المَهدِيُّ مِن كَرَبِ الض","ضيقِ خِناقاً قاسَيتُهُ حُقَبا",35,"ب",2,0],["فَرَجِّبِ اللَهَ صِفراً مِن مَحارِمِهِ","فَكَم مَضَت بِكَ أَصفارٌ وَأَرجابُ",36,"ب",1,0],["فَرُجِّلَ في غَبراءَ وَالخَطبُ فارِسٌ","وَما زالَ في الأَهلينِ أَشرَفَ راكِبِ",37,"ب",1,0],["فَرَّجتَ غَمَّهُمُ وَكُنتَ غَيثَهُمُ","حَتّى اِستَقَرَّت نَواهُم بَعدَ تَزوالِ",38,"ل",1,0],["فرجحن في الحي النساء صباحة","وَالحي يعبدهن كالأوثان",39,"ن",1,0],["فَرَّجْتُ عَنْهُ بِلاَ جَافٍ ولاَ وَكَلٍ","يَوْمَ الحِفَاظِ كَرِيمٍ زَنْدُهُ وَارِي",40,"ر",2,0],["فرجعتُ للوَكْرِ القديمِ وبي أسىً","يطغى عليّ وذلةٌ تعروني",41,"ن",2,0],["فَرَجَعتُ مَحموداً بِرَأسِ عَظيمِها","وَتَرَكتُها جَزَراً لِمَن ناواها",42,"ا",3,0],["فَرَّجْتَهَا عَنْهُ برحمِكَ بَعْدَمَا","كَادَتْ وأيقَنَ بَعْدَهَا بحُتُوفِ",43,"ف",1,0],["فُرِّجَت عَنها نَواصيها","غُرَرٌ خيطَت بِأَلوانِ",44,"ن",1,0],["فرَّجْتَها بصحائحٍ إن تَعْتَلِلْ","فلهنَّ من ضَرْبِ الرِّقابِ شِفاءُ",45,"ا",2,0],["فرج بجاهك كربي وانتهض كرما","لكشف همي فقد اضنى القوى ثقلي",46,"ل",2,0],["فرج الكرب بالاغاثة يا من","مد الطافه على الاشياء",47,"ا",2,0],["فرجالها يبنون كل خليفة","حسنت وحسن نسائها بُني مأتما",48,"م",2,0],["فَرَجاؤُهُم إِلّا لِفَضلِكَ كاذِبٌ","وَمُناخُهُم إِلّا بِظِلِّكَ جَعجَعُ",49,"ع",1,0],["فرجاء يحثني من ورائي","وجلال يقوم من قدامى",50,"م",2,0],["فرجونا بك القياسَ ولكن","فسد النسجُ من فساد القياسِ",51,"س",1,0],["فَرجيل قَبَّل عَينَيه وَجَبهَتَه","وَقامَ يَلثَمه موسى بن عمرانا",52,"ن",2,0],["فَرَجيَّةٌ وَشيٌ يَكادُ شُعاعُها ال","ذَهَبِيُّ بِالأَبصارِ حُسناً يَذهَبُ",53,"ب",1,0],["فَرَّجْتُ مِنْ هَمِّي وَمِنْ بُوسِي","بِمَدِيحِ صِفْوَة ِصَفْوَةِ الرُّوسِي",54,"س",2,1],["فَرَجّي الخَيرَ وَاِنتَظِري إِيابي","إِذا ما القارِظُ العَنَزِيُّ آبا",55,"ب",2,0],["فرجي أن أشم رائحة اللح","م ولو كان من فسا مراقِ",56,"ق",1,0],["فرّج عن المكروب واكشف غمّه","وأنله جمعاً بين أهل الاهتدا",57,"د",2,0],["فرّج لي غيهبَ أنكادي","بنبيٍّ قال به الشادي",58,"ي",1,0],["فرّج كُرَباً زادت وصباً","أنت المأمول لدى الهَرَج",59,"ج",1,0],["فرجعت وأَقبلا","فأرٌ يهدُّ الجَبَلا",60,"ل",2,0],["فرج جاء به الرحمن من","فضله عنه المساعي قصرت",61,"ت",1,0],["فرجائي فيكم رجاء ذليل","في عزيز بحوله ومتين",62,"ن",1,0],["فرجعت أندبُ واحتى","وزهور أحلامي وحبّي",63,"ي",1,0],["فَرَّجتَ ضِيقتَه والخَيلُ عابِسةٌ","تَرْدي بكلِّ رَبيطِ الجَأشِ قنْعاس",64,"س",1,0],["فرجَعْتُ لمّا شِبْتُ أسبَقَ دَمعةً","من شَمعةٍ عندَ اشتِعالِ الرّاس",65,"س",1,0],["فرجَعْتَ بالمُلْكِ المُطلّقِ أهلَهُ","وأقمتَ من خَدِّ العَدّوّ الأصعَر",66,"ر",1,0],["فرَجَعنا نَحسَبُ السَّا","لمَ مَن باتَ سَلِيما",67,"م",2,0],["فرَجَعتُ أطلُبُ ما أمتُّ به","فوَجَدتُه قَد حيزَ من قَبلي",68,"ل",2,0],["فرجعنَ قبل وصولهنَّ جوافلاً","يستاقهنَّ أبو الوحيد وجودُهُ",69,"د",2,0],["فَرجي لِوَرق لي قَلب","رَقيق الوَجنَتين",70,"ن",1,0],["فرجعتُ صِفْرَ الرَّاحتَيْن محوقلاً","حتى رأيتُ فتىً يجرُّ إزارا",71,"ر",2,0],["فرجعنا إلى الوجادة لما","لم نجد عارفاً بها في البقاع",72,"ع",1,0],["فرَجَعتُ أحملُ بعد سبعينَ العصَا","فاعْجبْ لما تأتِي بهِ الأيَّامُ",73,"م",1,0],["فرجٌ يا بني أبي الفرجِ اقتدْ","نَ إليّ السرورَ والأفراحا",74,"ح",2,0],["فرجايَ فيه يكون عين الصالح","وبهم رجايَ أَنال غ