{"poems":[[37,"أهاجتك سلمى أم أجد بكورها","https://www.aldiwan.net/poem39144.html","الطويل"],[39,"ألا لا أرى الأيام يقضى عجيبها","https://www.aldiwan.net/poem6494.html","الطويل"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[14,"أقلي علي اللوم يا بنت منذر","https://www.aldiwan.net/poem38304.html","الطويل"],[94,"لقد نام أهل العلم نوما مغنطسا","https://www.aldiwan.net/poem38911.html","الكامل"],[91,"ألا إنما هذا الذي لك أنقل","https://www.aldiwan.net/poem44963.html","الطويل"],[87,"خفضت لعزة الموت اليراعا","https://www.aldiwan.net/poem62859.html","الوافر"],[33,"أرقت فلم أنم طربا","https://www.aldiwan.net/poem42646.html","مجزوء الوافر"],[50,"أما والطورِ والنورِ","https://www.aldiwan.net/poem66557.html","الهزج"],[216,"ألا فاستمع يا نجل يحيى مقالتي","https://www.aldiwan.net/poem37865.html","الطويل"],[216,"تغيرت الأوقات وانقبض الدهر","https://www.aldiwan.net/poem37880.html","الطويل"],[308,"وحقك ما درى الواشي بأني","https://www.aldiwan.net/poem57845.html","الوافر"],[518,"أمنت عليك الدهر والدهر غادر","https://www.aldiwan.net/poem67753.html","الطويل"],[563,"على رغم أنف الحاسدين مقامي","https://www.aldiwan.net/poem34184.html","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70686","الطويل"],[1275,"","https://poetry.dctabudhabi.ae/diwan/poem/73509","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64505","الطويل"],[1491,"","https://poetry.dctabudhabi.ae/diwan/poem/107308","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26523","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205068","الوافر"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138565",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66446","الطويل"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199175","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127085","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91042","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94408","الوافر"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103270","المتقارب"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133098","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33412","الوافر"],[5050,"أبت إلا المروات الأبية","https://www.poetsgate.com/ViewPoem.aspx?id=38199",""],[5145,"تأبط شراً إذا أتانا ولم يكن","https://www.poetsgate.com/ViewPoem.aspx?id=108082",""],[5525,"شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=941",""],[5573,"امل في خاطري شوفك تبسم","https://www.poetsgate.com/ViewPoem.aspx?id=204536",""],[5616,"صقر","https://www.poetsgate.com/ViewPoem.aspx?id=203326",""],[5848,"على كيفك","https://www.poetsgate.com/ViewPoem.aspx?id=53158",""],[6239,"من ذاكرة الصقيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75978&r=&rc=29",""]],"verses":[["وَلَكِن صَفاءُ الوِدِّ ما هَبَّتِ الصَبا","وَما لَم تَزَل حِسمى رُباها وَقورُها",0,"ر",3,0],["ولكن صبراً عن أخ لك ضائر","عزاء إذا ما النفس حنَّ طروبها",1,"ب",3,0],["ولكن صميمُ الحمدِ لا شيء غيرُهُ","أَو الأجرُ إن الأجرَ ذُخرٌ مقدَّمُ",2,"م",1,0],["وَلَكِنَّ صُعلوكاً صَفيحَةُ وَجهِهِ","كَضَوءِ شِهابِ القابِسِ المُتَنَوِّرِ",3,"ر",1,0],["ولكنَّ صوتاً صارخاً متصاعداً","من الرُّوحِ يَدري كُنْهَهُ المُتَصامِمُ",4,"م",1,0],["ولكن صبِّي من يقوم بأمره","إذا زارني حتفي الذي أتعجل",5,"ل",1,0],["وَلَكِن صُيَّدٌ وَلَها بُزاةٌ","تَرى السَرَطانَ مِنها وَالصُداعا",6,"ع",2,0],["وَلَكِن صَرَّمَت حَبلي","فَأَمسى الحَبلُ مُنقَضِبا",7,"ب",2,0],["ولكن صيغَ من مسكٍ","وأنواعِ الرياحينِ",8,"ن",1,0],["ولكنَّ صبراً فالليالي خوؤونة","فمنها غدا يلويك سُمّ مُنَقّعُ",9,"ع",1,0],["ولكنَّ صبراً فالقضاءُ مَقَدَّرٌ","وأن الليالي شأنُها الخَدْعُ والمَكْر",10,"ر",1,0],["ولكن صافحته يدي وفيها","بقايا الطيب من ضم المعاطف",11,"ف",1,0],["ولكن صرف الدهر قد عجل الردى","وأيأسني من أن تدور الدوائر",12,"ر",1,0],["ولكن صدور الكون ضاقت فلم تجد","مساغاً لقولي فانثنت بملام",13,"م",1,0],["ولكنَّ صبراً فالسنونُ حواملٌ","وفيها الليالي وُلَّدٌ وعِشارُ",14,"ر",1,0],["وَلَكن صَرَفتُ الطَرفَ مِن نُور وَجهِهِ","كَما تُصرَفُ الأَبصارُ عَن قُرصَةِ الشَمسِ",15,"س",1,0],["ولكن صبر العبد دون بلائه","وفي قسطك اللهم فصل القضية",16,"ه",1,0],["ولكن صِلِيني والزمانُ مُساعِدٌ","وما دامت الأيامُ طَوعِي وَفِي أَمري",17,"ر",2,0],["وَلكِن صَبَرتَ لِما أَلزَموكَ","وَجُدتَ بِما لَم تَكُن تُلزَمُ",18,"م",1,0],["ولكن صرت اخشى إن جمعتم","بمأوى أن تموتوا أجمعينا",19,"ن",2,0],["ولكن صدري ضاق مما أصابني","فناديت من كاس المنون يجرع",20,"ع",1,0],["ولكن صحبي لا تزال قلوبهم","إلى عذب ما أمليه عطشى صواديا",21,"ي",2,0],["ولكن صبر المرء يكتم ضره","ومع ذا فهما زاد لا يمكن الكتم",22,"م",1,0],["ولكن صار زادي الهم لما","ذكرت بأنه زاد الجوى بك",23,"ك",1,0],["ولكن صدني من لست أدري","وظيفته مريدا أم مريدا",24,"د",2,0],["ولكن صرح مصر الشمس زاهٍ","ببنيانٍ وألطاف الخدورِ",25,"ر",1,0],["ولكن صغاراً بذاك الحمى","خشيت أيتمهم في الصغر",26,"ر",1,0],["ولكن صروف الدهر تلجي لعظمها","إلى كثرة الخلطاء من غير مرية",27,"ه",1,0],["ولكن صرتَ تملِكني","وحقَّ لمثلِكَ الصلَفُ",28,"ف",1,0],["ولكن صادفت مني محيا","تلوح به البشاشات البهية",29,"ي",2,0],["ولكن صنان يا كفى الله شره","فقدو حياتي سكّ سمعي وأعماني",30,"ي",1,0],["ولكن صدقيني الصدق في هذا الزمان شعور","يحبك من صدقلك مرةِ ما همه عتابك",31,"ك",1,0],["ولكن صعب تحقيق الاماني","إلى من جيت في حضي توسم",32,"م",1,0],["ولكنّ صبري قد يجدّد صبره","فيكتبُ رب العرش لي عندها الأجرا",33,"ر",2,0],["ولكن .... صدقيني .... لو ب اقول .... الدمع مني .... هل","ولو تقولين .... مو بالكيف ..... ابصرخ ( إمبلا ) .... كيفك",34,"ك",1,0],["ولكنَّ صَوْتَ البرد يعلو طفولتي","فتقطرُ دمعاً من شحوبِ خدودها",35,"د",3,0]]}