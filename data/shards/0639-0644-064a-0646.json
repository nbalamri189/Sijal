{"poems":[[63,"يا حادي الشدنيات المطاريب","https://www.aldiwan.net/poem46151.html","الرجز"],[55,"ركبنا وفتيان صدق ثبينا","https://www.aldiwan.net/poem26089.html","المتقارب"],[77,"ودونك فاستغرب على الماء موقفي","https://www.aldiwan.net/poem36467.html","الطويل"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[0,"أمن ذكر سلمى إذ نأتك تنوص","https://www.aldiwan.net/poem80.html","الطويل"],[10,"بكت عيني وحق لها العويل","https://www.aldiwan.net/poem21122.html","الوافر"],[93,"سلام على القدس ومن به","https://www.aldiwan.net/poem11150.html","الطويل"],[30,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[37,"علينا كالنِهاء مضاعفات","https://www.aldiwan.net/poem7629.html","الوافر"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[47,"ضلال مارأيت من الضلال","https://www.aldiwan.net/poem25209.html","الوافر"],[72,"خليلي والأشواق تروي حديثها","https://www.aldiwan.net/poem19557.html","الطويل"],[72,"ليهن بنو الآمال أنك قادم","https://www.aldiwan.net/poem19670.html","الطويل"],[51,"أبا جعفر لا زلت معطى وواهبا","https://www.aldiwan.net/poem8161.html","الطويل"],[51,"أبو عثمان والرومي","https://www.aldiwan.net/poem64019.html","الهزج"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[32,"وما صائب من نابل قذفت به","https://www.aldiwan.net/poem27777.html","الطويل"],[43,"لا يحزن الله الأمير فإنني","https://www.aldiwan.net/poem9454.html","الطويل"],[43,"ما أنصف القوم ضبه وأمه الطرطبه","https://www.aldiwan.net/poem9511.html","المجتث"],[45,"وواعظ منه لولا أنه حجر","https://www.aldiwan.net/poem63596.html","البسيط"],[45,"لعمري لئن أخلقت ثوب التغزل","https://www.aldiwan.net/poem65650.html","الطويل"],[28,"وبيض كأرآم الصريم ادريتها","https://www.aldiwan.net/poem5158.html","الطويل"],[28,"ألكني وقد تأتي الرسالة من نأى","https://www.aldiwan.net/poem5355.html","الطويل"],[28,"ولما رأت ما كان يأوي ورائها","https://www.aldiwan.net/poem5399.html","الطويل"],[28,"ألم تر جنبي عن فراشي جفا به","https://www.aldiwan.net/poem5434.html","الوافر"],[28,"ينام الطريد بعدها نومة الضحى","https://www.aldiwan.net/poem5509.html","الطويل"],[49,"أرى الموت لي حيث اعتمدت كمينا","https://www.aldiwan.net/poem63144.html","الطويل"],[66,"علينا إذا ما طال مطلكم صبر","https://www.aldiwan.net/poem38734.html","الطويل"],[107,"قفي ساعة يفديك قولي وقائلة","https://www.aldiwan.net/poem69426.html","عموديه"],[33,"أحن إذا رأيت جمال قومي","https://www.aldiwan.net/poem25762.html","الوافر"],[33,"ألا حبذا يوم يقر به الصبا","https://www.aldiwan.net/poem25810.html","الطويل"],[105,"مصيبة أمة وأنا المصاب","https://www.aldiwan.net/poem41138.html","الوافر"],[105,"على ذكرها فليعرف الحق جاهله","https://www.aldiwan.net/poem41937.html","الطويل"],[105,"علينا لك الحق الذي أنت تعلم","https://www.aldiwan.net/poem42049.html","الطويل"],[105,"تجدد من ذكراك للشرق مأتما","https://www.aldiwan.net/poem42110.html","الطويل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"هل الحرب إلا أن تطير الجماجم","https://www.aldiwan.net/poem43156.html","الطويل"],[75,"على نفر ضرب المئين ولم أزل","https://www.aldiwan.net/poem68992.html","الطويل"],[7,"أهاجك من أسماء رسم المنازل","https://www.aldiwan.net/poem1978.html","الطويل"],[8,"جزى الله عنا رهط قرة نصرة","https://www.aldiwan.net/poem21777.html","الطويل"],[68,"شربنا على ذكر الحبيب مدامة","https://www.aldiwan.net/poem1525.html",""],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49521","الوافر"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72207","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16623","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54565","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[28,"ألكني وقد تأتي الرسالة من نأى","https://www.poetsgate.com/ViewPoem.aspx?id=22100",""],[105,"هل الحرب إلا أن تطير الجماجم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54904&r=&rc=74",""],[85,"خفضتُ لعزة ِ الموتِ اليراعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9610&r=&rc=100",""],[110,"دمشق بها أضحى رياض نوادر","https://www.aldiwan.net/poem16592.html","الطويل"],[116,"من هجرك الامان","https://www.aldiwan.net/poem40439.html","عموديه"],[116,"علينا طال يا سعد المطال","https://www.aldiwan.net/poem40626.html","عموديه"],[116,"هو الدهر لا خل يدوم ولا اخ","https://www.aldiwan.net/poem41174.html","عموديه"],[129,"كتابكم وافى إلينا فسرنا","https://www.aldiwan.net/poem50528.html","الطويل"],[143,"يروح ويغدو علينا الحمام","https://www.aldiwan.net/poem58402.html","المتقارب"],[156,"أمغنى الهوى غالتك أيدي النوائب","https://www.aldiwan.net/poem55797.html","الطويل"],[167,"يا جاهلا عاب شعري","https://www.aldiwan.net/poem46872.html","المجتث"],[190,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[211,"قتيل هواك ليس يروم ثاره","https://www.aldiwan.net/poem13365.html","الوافر"],[211,"تضاهيك بالجيد الغزالة والصلف","https://www.aldiwan.net/poem13496.html","الطويل"],[230,"وصامت الجو بعيد الفرقد","https://www.aldiwan.net/poem51126.html","الكامل"],[230,"خليلي قد ولى الظلام وهملجا","https://www.aldiwan.net/poem51194.html","الطويل"],[236,"أرقت للمع برق حاجري","https://www.aldiwan.net/poem31628.html","الوافر"],[236,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[236,"عسى مر أنفاس النسيم المردد","https://www.aldiwan.net/poem32103.html","الطويل"],[238,"سلام عليكم والحوادث ألوان","https://www.aldiwan.net/poem19283.html","الطويل"],[251,"على المصطفى المختار من آل هاشم","https://www.aldiwan.net/poem15071.html","الطويل"],[257,"قد قلت لما غدا مدحي فما شكروا","https://www.aldiwan.net/poem48378.html","البسيط"],[271,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[276,"ولي العهد أم عهد الولي","https://www.aldiwan.net/poem25452.html","الوافر"],[299,"إذا أصبح الجزار للسرب راعيا","https://www.aldiwan.net/poem36836.html","الطويل"],[321,"في شهر مولد طه","https://www.aldiwan.net/poem67129.html","المجتث"],[323,"بان الخليط فشطوا بالرعابيب","https://www.aldiwan.net/poem56349.html","البسيط"],[329,"على نبعك يا حب","https://www.aldiwan.net/poem55032.html","الهزج"],[354,"هناء بالسلامة مستديم","https://www.aldiwan.net/poem39955.html","الوافر"],[362,"أعد ذكر مصران قلبي مولع","https://www.aldiwan.net/poem68106.html","الطويل"],[367,"على نفسه بخل الباخل","https://www.aldiwan.net/poem17386.html","المتقارب"],[372,"أبا الحسين الليالي","https://www.aldiwan.net/poem57122.html","الكامل"],[372,"اسمع حديث الدواوين التي اشتهرت","https://www.aldiwan.net/poem57195.html","البسيط"],[381,"ودادي غير منتقل","https://www.aldiwan.net/poem48753.html","مجزوء الوافر"],[392,"عسى نفحة الرحمن تأتي بسرعة","https://www.aldiwan.net/poem54599.html","عموديه"],[406,"علينا له فاعلم حقوق قضى بها","https://www.aldiwan.net/poem49794.html","الطويل"],[410,"شبيهة حبات القلوب لك الهوى","https://www.aldiwan.net/poem32236.html","الطويل"],[417,"ذكرت على النوى عهد التصابي","https://www.aldiwan.net/poem54047.html","الوافر"],[442,"أنا الغريب فلولا المجد والحسب","https://www.aldiwan.net/poem14420.html","البسيط"],[442,"لهذا خلقنا والجديد سيخلق","https://www.aldiwan.net/poem14465.html","الطويل"],[442,"دع الزفرات صاعدة طوامي","https://www.aldiwan.net/poem14481.html","الوافر"],[459,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[459,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[462,"وإني لمثن ما تبوج بارق","https://www.aldiwan.net/poem16092.html","الطويل"],[478,"حن فأجرى للنوى دموعا","https://www.aldiwan.net/poem15204.html","السريع"],[480,"على الناهضين نهوض الكرام","https://www.aldiwan.net/poem37616.html","المتقارب"],[483,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[501,"آمنت بالله الوجود كله","https://www.aldiwan.net/poem37823.html","الرجز"],[530,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[554,"أدهرا تولى هل نعيمك مقبل","https://www.aldiwan.net/poem68391.html","الطويل"],[554,"وساحرة العينين ما تحسن السحرا","https://www.aldiwan.net/poem68429.html","الطويل"],[563,"على نادي أحبتنا الكرام","https://www.aldiwan.net/poem52798.html","الوافر"],[563,"بكى حتى بكيت على بكاه","https://www.aldiwan.net/poem52917.html","الوافر"],[564,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["على نُحورِ المُلوكِ الصِّيدِ مَنْشَؤُهُ","وفي الحُجورِ من البِيضِ المَناحيبِ",0,"ب",1,0],["عَلَينا مِنَ الصينِ قَسِّيَّةٌ","عَلَونا بِها وَاللُبودَ المُتونا",1,"ن",2,0],["على نِصْبَةِ الأفْراحِ أحْكَمَ بِنْيَتي","حَكيمٌ بِما يأتيهِ جِدُّ بَصيرِ",2,"ر",1,0],["عَلَينا البَيضُ واليَلَبُ اليَماني","وَأَسيافٌ يَقُمنَ وَيَنحَنينا",3,"ن",2,0],["عَلَينا كُلُّ سابِغَةٍ دِلاصٍ","تَرى فَوقَ النِطاقِ لَها غُضونا",3,"ن",2,0],["عَلى نَقنَقٍ هَيقٍ لَهُ وَلِعُرسِهِ","بِمُنعَرَجِ الوَعساءِ بيضٌ رَصيصُ",4,"ص",1,0],["عَلى نَفَرٍ هُمُ كانوا جَناحي","عَلَيهِم حينَ تَلقاهُم قَبولُ",5,"ل",1,0],["عَلَى نَاهِبٍ لِلأَرْضِ يُهْدِي رَوَائِعاً","إِلَى كُلِّ عَيْنٍ مِنْ غَنَائِمِ نَهْبِهِ",6,"ب",2,0],["عَلى نِضوَةٍ تَهدي بِرَكبٍا تَطَوَّحوا","عضلى قُلُصٍ أَبصارُهنَّ الغَوائِرُ",7,"ر",1,0],["علينا كالنِهاء مضاعفات","من الماذي لم تؤذ المتونا",8,"ن",2,1],["عَلَينَا كالنِّهاءِ مُضَاعَفَاتٍ","مِنَ الماذِيِّ لم تُؤِدِ المُتُونَا",9,"ن",2,0],["عَلَينا أَن نُعاوِدَ كُلَّ يَومٍ","رَخيصٍ عِندَهُ المُهَجُ الغَوالي",10,"ل",2,0],["على نازلٍ بالقلب مرتحلٍ به","قفا نبك من ذكرى حبيبٍ ومنزل",11,"ل",1,0],["علينا اجتهاد القول فيك وما على","أخي الجهد أن تقضى الحقوق اللوازم",12,"م",1,0],["علينا بنُعماكُمْ منَ اللَّه أنعُمٌ","فلا تجعلوها بالجفاءِ مصائبا",13,"ب",2,0],["على نفس مُفداةٍ","ووجهٍ حسن نضر",14,"ر",1,0],["على نعمةٍ ألبستناها جديدةً","هي الوشي حُسْناً والحبير المنمنمُ",15,"م",1,0],["عَلى نَبعَةٍ زَوراءَ أَمّا خِطامُها","فَمَتنٌ وَأَمّا عودُها فَعَتيقُ",16,"ق",1,0],["عَلَينا لَكَ الإِسعادُ إِن كانَ نافِعاً","بِشَقِّ قُلوبٍ لا بِشَقِّ جُيوبِ",17,"ب",1,0],["عَلى نِسائِكَ تَجلو","فَعولَها مُنذُ سَنبَه",18,"ب",2,0],["عَلَيَّ نَحتُ القَوافي مِن مَقاطِعِها","وَما عَلَيَّ لَهُم أَن تَفهَمَ البَقَرُ",19,"ر",1,0],["عَلَينا بِحَمدِ الِلَّهِ لِلَّهِ نِعمَةٌ","تَروحُ وَتَغدو مِن يَدِ المُتَوَكِّلِ",20,"ل",1,0],["عَلَينا وَنَخشى الناسَ أَن يَشعُروا بِنا","فَيُصبِحَ ما نَخشى عَلَينا مُشَنَّرا",21,"ر",2,0],["عَلى نَفسِهِ حَتّى يُزايِلَ جارَهُ","كَريماً وَلَم يَظعَن بِعِرضٍ مُخَرَّقِ",22,"ق",1,0],["عَلَينا وَلا يَلوي كَما قَد أَصابَنا","لِدَهرٍ عَلَينا قَد أَلَحَّت كَلاكِلُه",23,"ل",2,0],["عَلى نَبَطٍ مِن أَهلِ حَورانَ أَصبَحَت","مُوَشَّمَةَ الأَيدي لَئيماً فُلولُها",24,"ل",3,0],["عَلى نَفَرٍ هُم مِن نِزارٍ ذُؤابَةٌ","وَأَهلُ الجَراثيمِ الَّتي لَم تُهَدَّمِ",25,"م",1,0],["عَلَينا عُيونٌ لِلمُنونِ خَفِيَّةٌ","تَدِبُّ دَبيباً بِالمَنِيَّةِ فينا",26,"ن",2,0],["عَلَينا إِذا ما طالَ مَطلُكُمُ صَبرُ","وَمَقصودُنا أَلّا يَضيقَ لَكُم صَدرُ",27,"ر",1,1],["عَلَى نَشْرَةِ الأخْبارِ في كلِّ لَيْلَةٍ","نَرَى مَوْتَنَا تَعْلُو وَتَهْوِي مَعَاوِلُهْ..",28,"ل",2,0],["عَلى نَجدٍ وَساكِنِ أَرضِ نَجدٍ","تَحِيّاتٌ يَرُحنَ وَيَغتَدينا",29,"ن",2,0],["عَلَيَّ نُذورٌ يَومَ زُرتُكِ خالِياً","لَيالٍ وَأَيامٌ كَثيرٌ أَصومُها",30,"م",3,0],["علينا الشكر مطردا يؤدى","اداء الدين ضاق به الحساب",31,"ب",1,0],["علينا الهُدى إمّا بآياتِ ربِّنا","وإمّا بِحَدِّ السّيفِ لا خَابَ حاملُهْ",32,"ل",2,0],["علينا لك الحقُّ الذي أنتَ تعلمُ","وهَذا لِسانُ الشّعرِ بالحقِّ يحَكمُ",33,"م",1,1],["علينا الحفاظُ المُرُّ نحمي بلادنا","وندفعُ عنها الغاصبَ المتهجِّما",34,"م",2,0],["علينا أن نُجيبَ إذا دُعينا","ونَصدُقَ في الوغى مَن يبتلينا",35,"ن",2,0],["عَلَينا لِكُلٍّ ذِمَّةٌ لا نُضيعُها","وَعَهدٌ عَلى ما يُحدِثُ الدَهرُ دائِمُ",36,"م",1,0],["على نفرٍ ضربُ المئينَ ولم أزَل","بِحَمدِكَ مثلَ الكسرِ يُضرَبُ في الكسرِ",37,"ر",1,1],["عُلينَ بِكِديَونٍ وَأُبطِنَّ كَرَّةً","فَهُنَّ وِضاءٌ صافِياتُ القَلائِلِ",38,"ل",1,0],["عَلى نارِ حيًّ يَصطَلُونَ كأَنَّهُم","جِمالٌ طَلاها بِالعَنِيَّةِ مُهرِجُ",39,"ج",1,0],["على نفسه فليَبْكِ مَن ضاع عُمْرُهُ","وليسَ لهُ فيها نَصيبٌ ولا سهمُ",40,"م",1,0],["علينا أن نَرُدّ الشَّرَّ عنها","ونَنْهضُ للعدّوِّ إذا أغارا",41,"ر",2,0],["علينا أن نُناضِلَ عن حِماها","نصون ذمارها داراً فدارا",41,"ر",2,0],["عَلى ناشِىءٍ نالَ المَكارِمَ كُلَّها","فَما انفَكَّ حتَّى أَحْرَزَ المَجْدَ أَجْمَعا",42,"ع",2,0],["على نجاةٍ مِن الفِرْصَادِ أيّدَهَا","رَبُّ القَدُومِ بأوْصالٍ وأضلاعِ",43,"ع",1,0],["عَلَى نَفْسِي قَطَعْتُ لُكُمْ عُهُوداً","مَنُوطَاتٍ بِأَخْلاَقِ صِلاَبِ",44,"ب",1,0],["عَلَينا المَنايا قُدِّرَت وَعَلى العِدى","فَيا لِضرابٍ بَينَنا وَطِعانِ",45,"ن",1,0],["عَلى نَفْسِهِ حَتى يُزايِلَ جَارَهُ","كَريماً وعلمْ يَظعَنْ بعرْضٍ مُخَرَّقِ",46,"ق",1,0],["علينا لكل ذمة ٌ لا تضيعها","وعهدٌ على ما يحدث الدهر دائم",47,"م",1,0],["على نفسٍ تعِّودت الصِّراعا","ولم يكُ غيرَ حادثة ٍ أصابت",48,"ا",3,0],["عَلى نَفسِهِ فَليَبكِ مَن ضاعَ عُمرَهُ","وَلَيسَ لَهُ مِنها نَصيب وَلا سَهمُ",49,"م",1,0],["عليّ نم دمعي","والآه ترجمان",50,"ن",1,0],["علينا طال يا سعد المطال","وازعجنا التباعد والمطال",51,"ل",1,1],["علينا رقيب وافر العزم ناسخ","يحرر منا كل فعل وينسخ",52,"خ",1,0],["علينا التماسُ الرزقٍ من كل وجهةٍ","ونَرْضَى بما يقضِى به اللهُ مِنْ حُكْمِ",53,"م",1,0],["علينا يحرَّمُ قتلُ النفوس","فكيف أُحِلَّ عليه الحرامُ",54,"م",1,0],["عَلَى ناحِلاتٍ كَالأَهِلَّةِ إِنْ بَدتْ","أَتَمَّ انقواساً مِن قِسىِّ الحَواجبِ",55,"ب",1,0],["عليَّ نحتُ القَوافي","وما عليَّ إذا لَمْ",56,"م",1,0],["عَلَينا منَ الخلّاقِ أكبر نعمةٍ","بملّة خيرِ الرسل والفضل أعظمُ",57,"م",1,0],["علينا الحسن امرها وها قد","لها صرنا عبيدا بالاماره",58,"ر",2,0],["على نفسه الامساك يخشى من الغنى","على انه لم يخش فقرا ولم يخف",59,"ف",1,0],["على نفسه قد اقسم الدهر حالفا","بمثلك لم يسمح وقام بما حلف",59,"ف",1,0],["على نقاءِ خَدِّها المورِّد","فهْيَ عليه كالعِذَار المبتدي",60,"د",2,0],["على نرجس غَض يُلاحظ سَوْسناً","آسٍ ربِيعيّ يُناجي بَنَفْسَجا",61,"ج",2,0],["عَلى نَجمِ الهُدى الساري وَنَجمِ ال","عُلومِ وَذُروَةِ الشَرَفِ العَلِيِّ",62,"ي",1,0],["عَلى نِظامٍ وَتَوا","لٍ كَاللَآلي النَسَقِ",63,"ق",1,0],["عَلى نَسَقٍ مِثلِ الأَنابيبِ في القَنا","تَوالوا نِظاماً سَيِّداً بَعدَ سَيِّدِ",64,"د",1,0],["عَلَيْنَا إِذَا شِمْنَا مُحَيَّاكَ يَا أَبَا","عَلِيٍّ لِمَا تَقْضِي الْمَسَرَّةُ إِذْعَانُ",65,"ن",1,0],["علينا به حصنٌ حصين فحسبُنا","بأنَّا رعايا وهي أضحى لنا يرعى",66,"ع",2,0],["علي نحت القوافي من معادنها","وما علي إذا لم تفهم البقر",67,"ر",1,0],["علينا يمينٌ أن نحُجَّ ضريحهُ","لنأخُذَ منهُ قُوَّةً وتصبُّرا",68,"ر",2,0],["عَلَى نَفَحاتِهِ تُبْنَى الأَمانِي","كَمَا يُبْنَى القَريضُ عَلَى الرَوِيِّ",69,"ي",1,0],["عَلى نحرِها لونٌ من الموتِ أحمر","وفي شفرةِ الجزّارِ آخرُ أزرق",70,"ق",1,0],["عَلى نورٍ أَتاهُ","بِنتُ لِتَسمو وَتُنجِبُ",71,"ب",1,0],["عَلى نُحورٍ كَغِرقي البَيضِ ناعِمَةٍ","يَعلُلنَها بِمَجاميرٍ وَتَطييبِ",72,"ب",1,0],["على نبعكَ يا حب","تساقى العبد والرب",73,"ب",1,1],["عَلَينا أَن نَصوغ لَكَ التَهاني","وَإِن كُنّا بِحقّكَ لا نَقومُ",74,"م",1,0],["عَلى نيلها شَوقا أَصَبّ مَدامعي","وَأَصبو اِلى غدران رَوضَتِها الغُرّا",75,"ر",2,0],["عَلى نَفسِهِ بَخِلَ الباخِلُ","فَيُظلَمُ إِن ذَمِّهُ السائِلُ",76,"ل",1,1],["علَيَّ نِصفُ رِداءٍ","وما أراهُ يَتِمُّ",77,"م",1,0],["علَيَّ نَذرٌ وأَيمانٌ مُؤكَّدةٌ","أن لا عَلوتُ عَلى ظَهرٍ ولا كَفَلِ",78,"ل",1,0],["عَلى نَهج مِن الآبا","ءِ وَالأَجداد مُتَصل",79,"ل",1,0],["علينا وكل المسلمين جميعهم","تعم الورى من كل حي وميت",80,"ت",1,0],["علَينا له فاعلَمْ حُقوقٌ قضى بِها","تَناسُبُنا في الجِنس والنُّوعِ والفَضلِ",81,"ل",1,1],["على نَحْرِكِ الدّاجِي زهَا الدُّرُّ مثلما","زَهَتْ في دياجي اللّيل أنجمُهُ الزُّهْرُ",82,"ر",1,0],["على نِعمٍ بجودك قد أُفيضَتْ","ولا ترجو بها غير الثواب",83,"ب",1,0],["عليّ نصحك يا برد الفؤاد ويا","ضياء عيني وإني راحل كرب",84,"ب",1,0],["علينا اجتهاد في رضى اللَه مثلما","فطرنا عليه والسعيد الموفق",85,"ق",1,0],["على نهد المراكل أعوجي","طويل الأربع الحرك السوام",86,"م",1,0],["على نداك شرفَ الدين ربَتْ","فِصالُها وبَزَلَتْ بِكارُها",87,"ر",3,0],["على نداه باعث","من نفسه لا يُقتسَرْ",88,"ر",1,0],["على ناشىءٍ منْ صفوةِ المجد يافعٍ","تقاصَر عنه الماجدونَ الأكابِرُ",89,"ر",1,0],["على نياقٍ عُقِرَتْ كم مِن حشاً","راعتْهُ لمّا ثُوِّرَتْ سريعا",90,"ع",2,0],["علينا القيام بواجبنا","إذا ما تحتم ذاك القيام",91,"م",1,0],["على نحوهم تنحى الحرائر بالمكا","بدات وقد يثنيها إن هي عرشيه",92,"ي",2,0],["على نِماطِ الوِسْعِ قامَ سِرُّهُ","مَنَزَّهٌ عن حَرَجٍ وعن ثِقَلْ",93,"ل",1,0],["على نَمَطِ الأَعارِب في لُغاتٍ","وفي حُسْنِ الرَّوِيَّ وفي الرُّواءِ",94,"ا",2,0],["عَلَينا رَياحينُ الحَياةِ وَفَوقَنا","سَحائِبُ بِالعَيشِ المُقارِفِ تَهطِلُ",95,"ل",1,0],["عَلَينا مِنَ التَوقيرِ وَالحِلمِ عارِضٌ","إِذا نَحنُ شِئنا أَمطَرَ العَزفَ وَالزَمرا",96,"ر",2,0],["عَلى نادي أحبَّتِنا الكِرامِ","سلامٌ في سلامٍ في سلامِ",97,"م",1,1],["علَينا قام ظِلُّهما مديداً","ونورُ الشمسِ يَسطَعُ من وَراهُ",98,"ا",2,0],["عَلى نَحوِها تَأبى الخَليل تَأَنُّقاً","وَشُحّاً بِرَشفٍ مِن لَماها المُبَرِّدِ",99,"د",1,0],["على نبيهم من الإشارة","نحو عتيق منه بالإمارة",100,"ه",1,0]]}