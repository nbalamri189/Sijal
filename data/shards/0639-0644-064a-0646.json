57",""],[5956,"صانعة الدساتير المجيدة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182608",""],[5956,"الرسالة المحمدية","https://www.poetsgate.com/ViewPoem.aspx?id=184653",""],[5956,"عاكفون على البحث العلمي والتعلم والتعليم","https://www.poetsgate.com/ViewPoem.aspx?id=192189",""],[5956,"صورة من رضاء الأبوين","https://www.poetsgate.com/ViewPoem.aspx?id=192575",""],[5956,"من أركان الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=192592",""],[5990,"إِذا عرض الْحَادِي بِطيبَة أَو غَنِي","https://www.poetsgate.com/ViewPoem.aspx?id=190304",""],[6038,"يا رب الارباب","https://www.poetsgate.com/ViewPoem.aspx?id=25684",""],[161,"لفي كبدٍ خُلِقْتَ فَمَنْ تَلومُ ؟ !","https://www.poetsgate.com/ViewPoem.aspx?id=155650",""],[6056,"نار اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=130380",""],[6070,"على نسماتِها غنى البَهاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=188125",""],[6093,"عَلى نَفْسيْ سَأُلقي سُوْءَ ظَنِّي","https://www.poetsgate.com/ViewPoem.aspx?id=177818",""],[6093,"عتب على (نيوتن)","https://www.poetsgate.com/ViewPoem.aspx?id=198973",""],[6102,"السِّفر اليماني","https://www.poetsgate.com/ViewPoem.aspx?id=186268",""],[6115,"حييت ياشاعر يثمن كلامه","https://www.poetsgate.com/ViewPoem.aspx?id=196487",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6184,"أأضحكُ عِنْدَما يَبْكي الجليلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78613&r=&rc=5",""],[2220,"علمت بما في الغيب من كل كائن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11530&r=&rc=404",""],[6336,"عشاق في الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73561&r=&rc=22",""]],"verses":[["على نُحورِ المُلوكِ الصِّيدِ مَنْشَؤُهُ","وفي الحُجورِ من البِيضِ المَناحيبِ",0,"ب",1,0],["عَلَينا مِنَ الصينِ قَسِّيَّةٌ","عَلَونا بِها وَاللُبودَ المُتونا",1,"ن",2,0],["على نِصْبَةِ الأفْراحِ أحْكَمَ بِنْيَتي","حَكيمٌ بِما يأتيهِ جِدُّ بَصيرِ",2,"ر",1,0],["عَلَينا البَيضُ واليَلَبُ اليَماني","وَأَسيافٌ يَقُمنَ وَيَنحَنينا",3,"ن",2,0],["عَلَينا كُلُّ سابِغَةٍ دِلاصٍ","تَرى فَوقَ النِطاقِ لَها غُضونا",3,"ن",2,0],["عَلى نَقنَقٍ هَيقٍ لَهُ وَلِعُرسِهِ","بِمُنعَرَجِ الوَعساءِ بيضٌ رَصيصُ",4,"ص",1,0],["عَلى نَفَرٍ هُمُ كانوا جَناحي","عَلَيهِم حينَ تَلقاهُم قَبولُ",5,"ل",1,0],["عَلَى نَاهِبٍ لِلأَرْضِ يُهْدِي رَوَائِعاً","إِلَى كُلِّ عَيْنٍ مِنْ غَنَائِمِ نَهْبِهِ",6,"ب",2,0],["عَلى نِضوَةٍ تَهدي بِرَكبٍا تَطَوَّحوا","عضلى قُلُصٍ أَبصارُهنَّ الغَوائِرُ",7,"ر",1,0],["علينا كالنِهاء مضاعفات","من الماذي لم تؤذ المتونا",8,"ن",2,1],["عَلَينَا كالنِّهاءِ مُضَاعَفَاتٍ","مِنَ الماذِيِّ لم تُؤِدِ المُتُونَا",9,"ن",2,0],["عَلَينا أَن نُعاوِدَ كُلَّ يَومٍ","رَخيصٍ عِندَهُ المُهَجُ الغَوالي",10,"ل",2,0],["على نازلٍ بالقلب مرتحلٍ به","قفا نبك من ذكرى حبيبٍ ومنزل",11,"ل",1,0],["علينا اجتهاد القول فيك وما على","أخي الجهد أن تقضى الحقوق اللوازم",12,"م",1,0],["علينا بنُعماكُمْ منَ اللَّه أنعُمٌ","فلا تجعلوها بالجفاءِ مصائبا",13,"ب",2,0],["على نفس مُفداةٍ","ووجهٍ حسن نضر",14,"ر",1,0],["على نعمةٍ ألبستناها جديدةً","هي الوشي حُسْناً والحبير المنمنمُ",15,"م",1,0],["عَلى نَبعَةٍ زَوراءَ أَمّا خِطامُها","فَمَتنٌ وَأَمّا عودُها فَعَتيقُ",16,"ق",1,0],["عَلَينا لَكَ الإِسعادُ إِن كانَ نافِعاً","بِشَقِّ قُلوبٍ لا بِشَقِّ جُيوبِ",17,"ب",1,0],["عَلى نِسائِكَ تَجلو","فَعولَها مُنذُ سَنبَه",18,"ب",2,0],["عَلَيَّ نَحتُ القَوافي مِن مَقاطِعِها","وَما عَلَيَّ لَهُم أَن تَفهَمَ البَقَرُ",19,"ر",1,0],["عَلَينا بِحَمدِ الِلَّهِ لِلَّهِ نِعمَةٌ","تَروحُ وَتَغدو مِن يَدِ المُتَوَكِّلِ",20,"ل",1,0],["عَلَينا وَنَخشى الناسَ أَن يَشعُروا بِنا","فَيُصبِحَ ما نَخشى عَلَينا مُشَنَّرا",21,"ر",2,0],["عَلى نَفسِهِ حَتّى يُزايِلَ جارَهُ","كَريماً وَلَم يَظعَن بِعِرضٍ مُخَرَّقِ",22,"ق",1,0],["عَلَينا وَلا يَلوي كَما قَد أَصابَنا","لِدَهرٍ عَلَينا قَد أَلَحَّت كَلاكِلُه",23,"ل",2,0],["عَلى نَبَطٍ مِن أَهلِ حَورانَ أَصبَحَت","مُوَشَّمَةَ الأَيدي لَئيماً فُلولُها",24,"ل",3,0],["عَلى نَفَرٍ هُم مِن نِزارٍ ذُؤابَةٌ","وَأَهلُ الجَراثيمِ الَّتي لَم تُهَدَّمِ",25,"م",1,0],["عَلَينا عُيونٌ لِلمُنونِ خَفِيَّةٌ","تَدِبُّ دَبيباً بِالمَنِيَّةِ فينا",26,"ن",2,0],["عَلَينا إِذا ما طالَ مَطلُكُمُ صَبرُ","وَمَقصودُنا أَلّا يَضيقَ لَكُم صَدرُ",27,"ر",1,1],["عَلَى نَشْرَةِ الأخْبارِ في كلِّ لَيْلَةٍ","نَرَى مَوْتَنَا تَعْلُو وَتَهْوِي مَعَاوِلُهْ..",28,"ل",2,0],["عَلى نَجدٍ وَساكِنِ أَرضِ نَجدٍ","تَحِيّاتٌ يَرُحنَ وَيَغتَدينا",29,"ن",2,0],["عَلَيَّ نُذورٌ يَومَ زُرتُكِ خالِياً","لَيالٍ وَأَيامٌ كَثيرٌ أَصومُها",30,"م",3,0],["علينا الشكر مطردا يؤدى","اداء الدين ضاق به الحساب",31,"ب",1,0],["علينا الهُدى إمّا بآياتِ ربِّنا","وإمّا بِحَدِّ السّيفِ لا خَابَ حاملُهْ",32,"ل",2,0],["علينا لك الحقُّ الذي أنتَ تعلمُ","وهَذا لِسانُ الشّعرِ بالحقِّ يحَكمُ",33,"م",1,1],["علينا الحفاظُ المُرُّ نحمي بلادنا","وندفعُ عنها الغاصبَ المتهجِّما",34,"م",2,0],["علينا أن نُجيبَ إذا دُعينا","ونَصدُقَ في الوغى مَن يبتلينا",35,"ن",2,0],["عَلَينا لِكُلٍّ ذِمَّةٌ لا نُضيعُها","وَعَهدٌ عَلى ما يُحدِثُ الدَهرُ دائِمُ",36,"م",1,0],["على نفرٍ ضربُ المئينَ ولم أزَل","بِحَمدِكَ مثلَ الكسرِ يُضرَبُ في الكسرِ",37,"ر",1,1],["عُلينَ بِكِديَونٍ وَأُبطِنَّ كَرَّةً","فَهُنَّ وِضاءٌ صافِياتُ القَلائِلِ",38,"ل",1,0],["عَلى نارِ حيًّ يَصطَلُونَ كأَنَّهُم","جِمالٌ طَلاها بِالعَنِيَّةِ مُهرِجُ",39,"ج",1,0],["على نفسه فليَبْكِ مَن ضاع عُمْرُهُ","وليسَ لهُ فيها نَصيبٌ ولا سهمُ",40,"م",1,0],["علينا أن نَرُدّ الشَّرَّ عنها","ونَنْهضُ للعدّوِّ إذا أغارا",41,"ر",2,0],["علينا أن نُناضِلَ عن حِماها","نصون ذمارها داراً فدارا",41,"ر",2,0],["عَلى ناشِىءٍ نالَ المَكارِمَ كُلَّها","فَما انفَكَّ حتَّى أَحْرَزَ المَجْدَ أَجْمَعا",42,"ع",2,0],["على نجاةٍ مِن الفِرْصَادِ أيّدَهَا","رَبُّ القَدُومِ بأوْصالٍ وأضلاعِ",43,"ع",1,0],["عَلَى نَفْسِي قَطَعْتُ لُكُمْ عُهُوداً","مَنُوطَاتٍ بِأَخْلاَقِ صِلاَبِ",44,"ب",1,0],["عَلَينا المَنايا قُدِّرَت وَعَلى العِدى","فَيا لِضرابٍ بَينَنا وَطِعانِ",45,"ن",1,0],["على نشاط وعزم لا يعارضه","معارض فكأن البحر مندفعا",46,"ع",2,0],["عَلى نَفْسِهِ حَتى يُزايِلَ جَارَهُ","كَريماً وعلمْ يَظعَنْ بعرْضٍ مُخَرَّقِ",47,"ق",1,0],["علينا لكل ذمة ٌ لا تضيعها","وعهدٌ على ما يحدث الدهر دائم",48,"م",1,0],["على نفسٍ تعِّودت الصِّراعا","ولم يكُ غيرَ حادثة ٍ أصابت",49,"ا",3,0],["عَلى نَفسِهِ فَليَبكِ مَن ضاعَ عُمرَهُ","وَلَيسَ لَهُ مِنها نَصيب وَلا سَهمُ",50,"م",1,0],["عليّ نم دمعي","والآه ترجمان",51,"ن",1,0],["علينا طال يا سعد المطال","وازعجنا التباعد والمطال",52,"ل",1,1],["علينا رقيب وافر العزم ناسخ","يحرر منا كل فعل وينسخ",53,"خ",1,0],["علينا التماسُ الرزقٍ من كل وجهةٍ","ونَرْضَى بما يقضِى به اللهُ مِنْ حُكْمِ",54,"م",1,0],["علينا يحرَّمُ قتلُ النفوس","فكيف أُحِلَّ عليه الحرامُ",55,"م",1,0],["عَلَى ناحِلاتٍ كَالأَهِلَّةِ إِنْ بَدتْ","أَتَمَّ انقواساً مِن قِسىِّ الحَواجبِ",56,"ب",1,0],["عليَّ نحتُ القَوافي","وما عليَّ إذا لَمْ",57,"م",1,0],["عَلَينا منَ الخلّاقِ أكبر نعمةٍ","بملّة خيرِ الرسل والفضل أعظمُ",58,"م",1,0],["علينا الحسن امرها وها قد","لها صرنا عبيدا بالاماره",59,"ر",2,0],["على نفسه الامساك يخشى من الغنى","على انه لم يخش فقرا ولم يخف",60,"ف",1,0],["على نفسه قد اقسم الدهر حالفا","بمثلك لم يسمح وقام بما حلف",60,"ف",1,0],["على نقاءِ خَدِّها المورِّد","فهْيَ عليه كالعِذَار المبتدي",61,"د",2,0],["على نرجس غَض يُلاحظ سَوْسناً","آسٍ ربِيعيّ يُناجي بَنَفْسَجا",62,"ج",2,0],["عَلى نَجمِ الهُدى الساري وَنَجمِ ال","عُلومِ وَذُروَةِ الشَرَفِ العَلِيِّ",63,"ي",1,0],["عَلى نِظامٍ وَتَوا","لٍ كَاللَآلي النَسَقِ",64,"ق",1,0],["عَلى نَسَقٍ مِثلِ الأَنابيبِ في القَنا","تَوالوا نِظاماً سَيِّداً بَعدَ سَيِّدِ",65,"د",1,0],["عَلَيْنَا إِذَا شِمْنَا مُحَيَّاكَ يَا أَبَا","عَلِيٍّ لِمَا تَقْضِي الْمَسَرَّةُ إِذْعَانُ",66,"ن",1,0],["علينا به حصنٌ حصين فحسبُنا","بأنَّا رعايا وهي أضحى لنا يرعى",67,"ع",2,0],["علي نحت القوافي من معادنها","وما علي إذا لم تفهم البقر",68,"ر",1,0],["علينا يمينٌ أن نحُجَّ ضريحهُ","لنأخُذَ منهُ قُوَّةً وتصبُّرا",69,"ر",2,0],["عَلَى نَفَحاتِهِ تُبْنَى الأَمانِي","كَمَا يُبْنَى القَريضُ عَلَى الرَوِيِّ",70,"ي",1,0],["عَلى نحرِها لونٌ من الموتِ أحمر","وفي شفرةِ الجزّارِ آخرُ أزرق",71,"ق",1,0],["عَلى نورٍ أَتاهُ","بِنتُ لِتَسمو وَتُنجِبُ",72,"ب",1,0],["عَلى نُحورٍ كَغِرقي البَيضِ ناعِمَةٍ","يَعلُلنَها بِمَجاميرٍ وَتَطييبِ",73,"ب",1,0],["على نبعكَ يا حب","تساقى العبد والرب",74,"ب",1,1],["عَلَينا أَن نَصوغ لَكَ التَهاني","وَإِن كُنّا بِحقّكَ لا نَقومُ",75,"م",1,0],["عَلى نيلها شَوقا أَصَبّ مَدامعي","وَأَصبو اِلى غدران رَوضَتِها الغُرّا",76,"ر",2,0],["عَلى نَفسِهِ بَخِلَ الباخِلُ","فَيُظلَمُ إِن ذَمِّهُ السائِلُ",77,"ل",1,1],["علَيَّ نِصفُ رِداءٍ","وما أراهُ يَتِمُّ",78,"م",1,0],["علَيَّ نَذرٌ وأَيمانٌ مُؤكَّدةٌ","أن لا عَلوتُ عَلى ظَهرٍ ولا كَفَلِ",79,"ل",1,0],["عَلى نَهج مِن الآبا","ءِ وَالأَجداد مُتَصل",80,"ل",1,0],["علينا وكل المسلمين جميعهم","تعم الورى من كل حي وميت",81,"ت",1,0],["علَينا له فاعلَمْ حُقوقٌ قضى بِها","تَناسُبُنا في الجِنس والنُّوعِ والفَضلِ",82,"ل",1,1],["على نَحْرِكِ الدّاجِي زهَا الدُّرُّ مثلما","زَهَتْ في دياجي اللّيل أنجمُهُ الزُّهْرُ",83,"ر",1,0],["على نِعمٍ بجودك قد أُفيضَتْ","ولا ترجو بها غير الثواب",84,"ب",1,0],["عليّ نصحك يا برد الفؤاد ويا","ضياء عيني وإني راحل كرب",85,"ب",1,0],["علينا اجتهاد في رضى اللَه مثلما","فطرنا عليه والسعيد الموفق",86,"ق",1,0],["على نهد المراكل أعوجي","طويل الأربع الحرك السوام",87,"م",1,0],["على نداك شرفَ الدين ربَتْ","فِصالُها وبَزَلَتْ بِكارُها",88,"ر",3,0],["على نداه باعث","من نفسه لا يُقتسَرْ",89,"ر",1,0],["على ناشىءٍ منْ صفوةِ المجد يافعٍ","تقاصَر عنه الماجدونَ الأكابِرُ",90,"ر",1,0],["على نياقٍ عُقِرَتْ كم مِن حشاً","راعتْهُ لمّا ثُوِّرَتْ سريعا",91,"ع",2,0],["علينا القيام بواجبنا","إذا ما تحتم ذاك القيام",92,"م",1,0],["على نحوهم تنحى الحرائر بالمكا","بدات وقد يثنيها إن هي عرشيه",93,"ي",2,0],["على نِماطِ الوِسْعِ قامَ سِرُّهُ","مَنَزَّهٌ عن حَرَجٍ وعن ثِقَلْ",94,"ل",1,0],["على نَمَطِ الأَعارِب في لُغاتٍ","وفي حُسْنِ الرَّوِيَّ وفي الرُّواءِ",95,"ا",2,0],["عَلَينا رَياحينُ الحَياةِ وَفَوقَنا","سَحائِبُ بِالعَيشِ المُقارِفِ تَهطِلُ",96,"ل",1,0],["عَلَينا مِنَ التَوقيرِ وَالحِلمِ عارِضٌ","إِذا نَحنُ شِئنا أَمطَرَ العَزفَ وَالزَمرا",97,"ر",2,0],["عَلى نادي أحبَّتِنا الكِرامِ","سلامٌ في سلامٍ في سلامِ",98,"م",1,1],["علَينا قام ظِلُّهما مديداً","ونورُ الشمسِ يَسطَعُ من وَراهُ",99,"ا",2,0],["عَلى نَحوِها تَأبى الخَليل تَأَنُّقاً","وَشُحّاً بِرَشفٍ مِن لَماها المُبَرِّدِ",100,"د",1,0],["على نبيهم من الإشارة","نحو عتيق منه بالإمارة",101