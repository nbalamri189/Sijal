{"poems":[[29,"أربت بعينيك الدموع السوافح","https://www.aldiwan.net/poem5699.html","الطويل"],[11,"وما من شيمتي شتم ابن عمي","https://www.aldiwan.net/poem276.html",""],[74,"ليهن حما الشهباء قاض حوت به","https://www.aldiwan.net/poem19115.html","الطويل"],[74,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[53,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[53,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[72,"وأحمق ذي لحية","https://www.aldiwan.net/poem42875.html","مجزوء الرجز"],[89,"لعزة هذي اللاهيات النواعم","https://www.aldiwan.net/poem8339.html","الطويل"],[76,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[77,"ألا أيها الوادي المقدس بالندى","https://www.aldiwan.net/poem69025.html","البسيط"],[50,"دع عنك لومي فإن اللوم إغراء","https://www.aldiwan.net/poem10397.html","البسيط"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10405","الوافر"],[147,"لقد أدنت لك البلد السحيقا","https://www.aldiwan.net/poem11785.html","الوافر"],[164,"إليك فقد حملت قلبي من الهوي","https://www.aldiwan.net/poem59013.html","الطويل"],[203,"دموع الفجر هذي أم دموعي","https://www.aldiwan.net/poem45646.html","الوافر"],[208,"يقولون صف حرب الرعية والجند","https://www.aldiwan.net/poem53322.html","الطويل"],[208,"أما تبصر دمع العي","https://www.aldiwan.net/poem53340.html","الهزج"],[309,"فيم الركون إلى حقيقتها","https://www.aldiwan.net/poem16750.html","البسيط"],[401,"وقالت لا أراك تُليق شيئاً","https://www.aldiwan.net/poem564.html",""],[409,"إليكم يا صفي الدين مني","https://www.aldiwan.net/poem33431.html","الوافر"],[409,"سلا إن مررتم عن فؤادي على سلع","https://www.aldiwan.net/poem33647.html","الطويل"],[409,"وأكفر أهل الأرض من قال إنه","https://www.aldiwan.net/poem33952.html","الطويل"],[412,"أخذن زمام الدمع خوف انسجامه","https://www.aldiwan.net/poem50120.html","الطويل"],[416,"أرى القلب أمسى بالأوانس مولعا","https://www.aldiwan.net/poem67492.html","الطويل"],[473,"أغوص على الدر الذي لو طلبته","https://www.aldiwan.net/poem59944.html","الطويل"],[473,"أصوغ الحلى في كل يوم وليلة","https://www.aldiwan.net/poem59955.html","الطويل"],[475,"فلو مات إنسان من الحب مقدما","https://www.aldiwan.net/poem4815.html","الوافر"],[505,"خذوا بيد العبد الضعيف تكرما","https://www.aldiwan.net/poem38071.html","الرمل"],[519,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[520,"ثغر الزمان بنجم الدين مبتسم","https://www.aldiwan.net/poem12263.html","البسيط"],[543,"سل الفضل أهل الفضل قدما ولا تسل","https://www.aldiwan.net/poem47969.html","عموديه"],[556,"لو كنت في مثل حالي لم ترد عذلي","https://www.aldiwan.net/poem47288.html","البسيط"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2448","الوافر"],[747,"","https://poetry.dctabudhabi.ae/diwan/poem/143279","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38936","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38670","الوافر"],[1177,"","https://poetry.dctabudhabi.ae/diwan/poem/28388","الطويل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21668","المتقارب"],[1768,"","https://poetry.dctabudhabi.ae/diwan/poem/101830","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118389","الوافر"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76855","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89536","الطويل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26161","المتقارب"],[2632,"","https://poetry.dctabudhabi.ae/diwan/poem/216957","الهزج"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100270","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100853","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48329","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4250,"","https://poetry.dctabudhabi.ae/diwan/poem/31540","الوافر"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135100","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81718","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136631",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72653","الوافر"],[4119,"أبرق في الثغور من الثغور","https://www.poetsgate.com/ViewPoem.aspx?id=16161",""],[5121,"رَيْحَانَةُ الحُبَّ","https://www.poetsgate.com/ViewPoem.aspx?id=174814",""],[5213,"أشاقك أن ترى الربع المحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=170514",""],[5302,"والظبي راتع","https://www.poetsgate.com/ViewPoem.aspx?id=201661",""],[5397,"هلال دجى وشمس ضحى وفرقد","https://www.poetsgate.com/ViewPoem.aspx?id=157966",""],[5431,"يضمك تحناني طويلا لتصبرا","https://www.poetsgate.com/ViewPoem.aspx?id=187842",""],[5438,"زَبَدُ الأَسَى","https://www.poetsgate.com/ViewPoem.aspx?id=202062",""],[5804,"تمنّيت","https://www.poetsgate.com/ViewPoem.aspx?id=181662",""],[5956,"طيف الحبيبة الميّتة","https://www.poetsgate.com/ViewPoem.aspx?id=182160",""],[5956,"تشبيه بلا تشويه","https://www.poetsgate.com/ViewPoem.aspx?id=192411",""],[5956,"حكيماً كان سيدنا","https://www.poetsgate.com/ViewPoem.aspx?id=192635",""],[5956,"مضى عبدُ هادي لخلدِ النعيم","https://www.poetsgate.com/ViewPoem.aspx?id=192987",""],[5956,"ما منعوا الجروح تصيب غزةْ","https://www.poetsgate.com/ViewPoem.aspx?id=202514",""],[6136,"عبرة إلى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=36239",""]],"verses":[["فَلَو مالَ مَيلٌ مِن تَميمٍ عَلَيكُمُ","لِأُمِّكَ صِلدامٌ مِنَ العِزِّ قارِحُ",0,"ح",1,0],["فَلوميني إِذا لَم أَقرِ ضَيف","وَأُكرِم مُكرِمي وَأُهِن مُهيني",1,"ن",2,0],["فلو مثلت كتب النحاة بنعته","لما جازَ أن يجرِي على نعتِه القصص",2,"ص",1,0],["فلو مزجتَ أباريق المدام به","ما رجّعت صوت فأفاءٍ وتمتام",3,"م",1,0],["فلُومي سامعاً لكِ أو أَفيقي","فقد حان اتِّئابُكَ واتِّئابي",4,"ب",2,0],["فلو متما إذ ذاك ما متّ غيرةً","ولا هي إلا أنها منك أغير",5,"ر",1,0],["فَلَو مَضى السَوقَ بِها","وَزَفَّها بِالمِزمَرَه",6,"ر",2,0],["فَلَوْ مِصْرُ تَدْرِي أَرْسَلَتْ لَكَ نِيلَهَا","لِيَلْقَاكَ فِي جُنْحٍ مِنَ اللَّيْلِ قَاتِمِ",7,"م",1,0],["فَلَو مَسَحَت يُمناهُ عَن وَجهِ لَيلَةٍ","لَحَطَّت قِناعَ اللَيلِ عَن قَمَرٍ يَسري",8,"ر",2,0],["فلو ميز منه كلُّ لون بذاته","جرى سَبَجٌ منه وذاب عقيق",9,"ق",1,0],["فَلَو مَزَجتَ بِها نوراً لَمازَجَها","حَتّى تَوَلَّدُ أَنوارٌ وَأَضواءُ",10,"ا",2,0],["فَلوميني إِذا لَم أَقرِ ضَيفاً","وَأُكرِم مُكرِمي وَأُهِن مُهيني",11,"ن",2,0],["فَلَو مُنِيَ الزَمانُ بِما تُعاني","لَما كانَ الزَمانُ لَهُ مُطيقا",12,"ق",2,0],["فلو مازجت أخلاقه البحر طعمه","أجاج لاضحى من عذوبتها حلوا",13,"و",2,0],["فلو مزجوا ببعض الهمِّ ماءً","لصارَ الماءُ كالسمِّ النقيعِ",14,"ع",1,0],["فلو مات قبلي كنتُ أُحسن مثله","صنايع فسق ليس يُحسِنُها بعدي",15,"د",2,0],["فلو مُتُّ من الوجدِ","لما حلتُ عن العهدِ",16,"د",1,0],["فَلَو مَرَرتُ بِها وَالبومُ يَندَبُها","في ظُلمَةِ اللَيلِ لَم تَلتَذُّ بِالوَسَنِ",17,"ن",1,0],["فلُومي إن بدا لكِ أو أفيقي","فَقبلك فاتني وهو الحميدُ",18,"د",1,0],["فلو مشت الديار لشوق صبٍّ","لوافتكم شهارة أو شبام",19,"م",1,0],["فلوم جفون الصب أولى وإنما","يرقُّ لها لما ترقرق بالدمع",20,"ع",1,0],["فلو مات قبلي كنت أدركت بعده","دقائق كفر ليس يدركها بعدي",21,"د",2,0],["فَلَو مَلَكَ الآفاق دَع عَنكَ آمداً","غُلامٌ لَهُ ما اِستُكثِرَت لِغُلامِهِ",22,"م",2,0],["فَلَومُدَّتِ الأَيدي إِلى الحَربِ كُلِّها","لَكَفّوا وَما مَدّوا إِلى الحَربِ إِصبَعا",23,"ع",2,0],["فَلَو مُتُّ ضُرّاً ما بُعِثتُ بِدُرَّةٍ","إِلى جيدِ مَن لا يَستَحِقُّ لَهُ لُبسا",24,"س",2,0],["فَلَو مُتُّ ضُرّاً ما عَقَدتُ قِلادَةً","عَلى جيدِ مِن لا يَستَحِقُّ لَها لُبسا",25,"س",2,0],["فَلَو ماتَ إِنسانٌ مِنَ الحُبِّ مُقدِماً","لَمُتُّ وَلَكِنّي سَأَمضِي مُقَدِّما",26,"م",2,1],["فلو ماتَ حيًّاكُمْ بمطوِيِّ قبرِهِ","وهامَ بكُمْ بين القُبورِ تُرابُهُ",27,"ب",2,0],["فلوْ مسّ الصّخورَ الصُّمَّ يوماً","لفجَّرَهُنَّ بالعَذْبِ الزُلالِ",28,"ل",1,0],["فلو مدحت زماني وهو عبدكم","بمدحكم لم يزرني الشيب والهرم",29,"م",1,0],["فلو مَلَك الدُّنيا جميعا بأسرِها","تُذكِّرُه الأيامُ ما كانَ أوَّلا",30,"ل",2,0],["فلو مررنا على وادي العُذَيْب درى","مَن عالج الشّوقَ أنّي عنك في شُغُلِ",31,"ل",1,0],["فَلَو ما كُنتُ أَروَعَ أَبطَحِيّاً","أَبِيَّ الضَيمِ مُطَّرِحَ الدَناءِ",32,"ا",2,0],["فلَومهُمُ وهِجائي لهمْ","لَدى الناسِ أحدوثَةٌ فاشِيَهْ",33,"ش",3,0],["فَلَو مِثل سَحبان رَآهُ لَما اِغتَدى","خَطيباً قَدِ اِنفَضَّت إِلَيهِ المَجالسُ",34,"س",1,0],["فَلَو مَرّ النّسيمُ عَلى حَبيبي","لَمن لُطفِ الحَبيبِ غَدا رَقيقا",35,"ق",2,0],["فَلَو مِتُّ في قَومي وَلَم آتِ عَجزة","يُضَعِّفُني فيها اِمرؤٌ غَيرُ عادِلِ",36,"ل",1,0],["فَلَو مُعسِراتٌ فَيَدفَعنَنا","بِعُسرٍ عَذَرنا بِأَعسارِها",37,"ر",3,0],["فلو مر بالحانوت ينظر كأسها","يطوف عليها راهب القوم عربدا",38,"د",2,0],["فلو مكه عسيل وهو صخر","من اصفاء تضمنها مسيل",39,"ل",1,0],["فلومك لا يؤثر فيه الا","كما في الصخر اثره العسيل",39,"ل",1,0],["فلَو محا فيضُ دمعٍ من تَكاثُره","إنسانَ عَينٍ إذا إنسانَه لمحا",40,"ح",2,0],["فَلَو مُكِّنوا أَثنَوا عَلَيكَ وَأَعلَنت","بِشُكرِكَ مِنهُم بالِياتُ الرَمائِمِ",41,"م",1,0],["فَلومِن أَبانٍ وَرَضوى خُلِقتَ","لَما كُنتَ إِلّا مِنَ القُنَّةِ",42,"ه",1,0],["فلو مُتُّم، بني عَمْرٍو","فما قومٌ يُوازيكُمْ",43,"م",1,1],["فلو مدّ باعاً للريّاسة لانثنت","وسادتُه الجوزاء والبدر مسندا",44,"د",2,0],["فلو مسختم قطاعا يوم خلقتكم","لما صلحتم ضحايا او قرابينا",45,"ن",2,0],["فلومُ وُشاتي في الصّبابةِ لم يُفِدْ","فيا عاذِلي مَنْ جدَّ في العَتْبِ لم يُجِدْ",46,"د",1,0],["فلو من سفينته واثباً","إلى اليم غاص للجة بحر",47,"ر",1,0],["فَلوموا ما بَدا لَكُم فَإِنّي","سَأَعتِبكُم إِذا اِنفَسَحَ المُراحُ",48,"ح",1,0],["فلو مزجت بها نورا لمازجها","ولم تر في جوار الحسان صهباء",49,"ا",2,0],["فلو مُطْفِلاً أنشدتها لفظَها ارعوتْ","فأَلهيتها عن ذي تمائمَ مُحْول",50,"ل",1,0],["فلو مرَّ النسيمُ بها لفاحَت","روايحها فعَّطرت النسيما",51,"م",2,0],["فلو مدَّوا إلى العيوق باعا","لجاوزه وليس هناك عائق",52,"ق",1,0],["فلو منطقتها بحلى يديها","جرت تلك الخصور على الخصور",53,"ر",1,0],["فَلُومِينِي أيَا مَرْضِيَّتِي لَا","تَغِيبِي عَنْ عُيُونِ الْحُبِّ دَهْرَا",54,"ر",2,0],["فلو ملأت بلاد الله فيها","لوائم ما توهمت العقولا",55,"ل",2,0],["فلومي وقود ظل يذكي مشاعري","إليها وسري في مدى القوم ذائع",56,"ع",1,0],["فلو ملكت يداك الدهر يوما","لكان ندى بكف سخاك يرفد",57,"د",1,0],["فلو متُ تلقاني أطوفُ مُحِبةً","يضمك تحناني طويلا لتصبرا",58,"ر",2,0],["فَلَوْ مِتُّ أَحْيَا فِي مَدَارَاتِ هَمْسِهَا","وَ يَغْتَالُنِي مِنْهَا التَأَمُّلُ وَ الصَدُّ",59,"د",1,0],["فلو ماتَ إحساسي ستبقى بقيةٌ","لأبدعَ يا ليلايَ فيكِ القوافيا",60,"ي",2,0],["فلو ماعرَفْتُ سواك بعمري","ففيك كفاية أحلاميهْ",61,"ي",2,0],["فلو مَثَلاً تعذّبني بضربٍ","سأكسب منه تشبيهاً قديرا",62,"ر",2,0],["فلو ما زال من عَدَمٍ تَبَقَّى","خواءً من جِنان ذات طولِ",63,"ل",1,0],["فلو مات في أرضهِ أو سواها","يُعّدُّ شهيداً بكل التخومِ",64,"م",1,0],["فلو منعوا لكان الأجرُ أعلى","وكانوا جنّبوا الشعبَ المَجَزّة",65,"ز",2,0],["فَلَوْ ما أنتِ يا فيحاءُ رُكنٌ","لدينِ اللهِ والأنوارُ تبدو",66,"د",2,0]]}