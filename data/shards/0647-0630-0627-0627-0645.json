{"poems":[[55,"هذا أمير المؤمنين محمد","https://www.aldiwan.net/poem30503.html","الكامل"],[55,"أي العيون تجانب الأقذاء","https://www.aldiwan.net/poem30780.html","الكامل"],[79,"العمر نوم والمنى أحلام","https://www.aldiwan.net/poem36107.html","الكامل"],[79,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[88,"ورد الكنانة عبقري زمانه","https://www.aldiwan.net/poem68904.html","الكامل"],[46,"كشف الغطاء فأوقدي أو أخمدي","https://www.aldiwan.net/poem30545.html","الكامل"],[107,"هذا الدفاع وهذه الأجناد","https://www.aldiwan.net/poem42120.html","الكامل"],[107,"هذا إمام الدين في أعلامه","https://www.aldiwan.net/poem44206.html","الكامل"],[77,"هذا أمير المؤمنين بمجلس","https://www.aldiwan.net/poem68998.html","الكامل"],[77,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[77,"الحب حيث المعشر الأعداء","https://www.aldiwan.net/poem69109.html","الكامل"],[50,"خلق الشباب وشرتي لم تخلق","https://www.aldiwan.net/poem64445.html","الكامل"],[48,"لا تأسفن لفائت ما واحد","https://www.aldiwan.net/poem22574.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54646","الكامل"],[146,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[208,"أهديت ما لو أن أضعافه","https://www.aldiwan.net/poem53002.html","السريع"],[302,"يا صاح هذا المشهد الأقدس","https://www.aldiwan.net/poem33243.html","السريع"],[315,"هل غير بابك للغريب مؤمل","https://www.aldiwan.net/poem59512.html","الكامل"],[369,"صوت حمام الأيك عند الصباح","https://www.aldiwan.net/poem60968.html","السريع"],[422,"هنيت بالفرمان والنيشان","https://www.aldiwan.net/poem54081.html","الكامل"],[422,"لمن السوابق والجياد الضمر","https://www.aldiwan.net/poem54183.html","الكامل"],[449,"أهلا بطلعة وجهك المحبوب","https://www.aldiwan.net/poem55944.html","عموديه"],[529,"هذا الحبيب وصفوة الجبار","https://www.aldiwan.net/poem13289.html","الكامل"],[567,"هذا أمير المجد ذو اللمع الذي","https://www.aldiwan.net/poem52576.html","الكامل"],[567,"قد مد خط عذاره فأجاده","https://www.aldiwan.net/poem52837.html","الكامل"],[567,"يا أيها القلب الخفوق بجانبي","https://www.aldiwan.net/poem52943.html","الكامل"],[580,"ما هزة الغصن إلا ملك هزته","https://www.aldiwan.net/poem3094.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83298","الكامل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83274","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126711","الكامل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110379","الكامل"],[806,"","https://poetry.dctabudhabi.ae/diwan/poem/110734","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72313","الكامل"],[1362,"","https://poetry.dctabudhabi.ae/diwan/poem/113646","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80014","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79802","الرجز"],[1829,"","https://poetry.dctabudhabi.ae/diwan/poem/130578","السريع"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89528","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27335","البسيط"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121143","السريع"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94300","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74226","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132789","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100873","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108272","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92041","السريع"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81927","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120505","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120555","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120516","السريع"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120200","الكامل"],[4679,"ذو الحزم يسمو والمهيمن ينصر","https://www.poetsgate.com/ViewPoem.aspx?id=142728",""],[4717,"الطبيب وأمين الشرطة","https://www.poetsgate.com/ViewPoem.aspx?id=199595",""],[4755,"وَطَنًا أرِيدُ الآنَ يا خَوَنَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=191998",""],[4935,"هذا أمير المؤمنين وعزهم","https://www.poetsgate.com/ViewPoem.aspx?id=129301",""],[5225,"طال الغياب","https://www.poetsgate.com/ViewPoem.aspx?id=36892",""],[5397,"ما للزمان قديما طرده انعكسا","https://www.poetsgate.com/ViewPoem.aspx?id=157929",""],[5690,"خلَعَ الزمان الآن ثوب حداحدهِ","https://www.poetsgate.com/ViewPoem.aspx?id=172149",""],[5751,"امتحانُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=214724",""],[5829,"إلى روح الشهيد العلامة البوطي","https://www.poetsgate.com/ViewPoem.aspx?id=153911",""],[5960,"بغدادُ أغلى انتماءاتي","https://www.poetsgate.com/ViewPoem.aspx?id=30808",""],[6102,"بين كلابها وحجاجها ..","https://www.poetsgate.com/ViewPoem.aspx?id=182808",""],[6352,"قم ناشد الأسلام عن مصابه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22753&r=&rc=14",""]],"verses":[["هَذا أَميرُ المُؤمِنينَ مُحَمَّدٌ","كَرُمَت مَغارِسُهُ وَطابَ المَولِدُ",0,"د",1,1],["هَذا أَميرُ المُؤمِنينَ وَظِلُّهُ","يَسَعُ الوَرى وَيُجَلِّلُ الأَحياءَ",1,"ا",2,0],["هَذَا أَمِيرُ الْمُسْلِمِينَ وَمَنْ بِهِ","وُجِدَ السَّمَاحُ وَأُعْدِمَ الإِعْدَامُ",2,"م",1,0],["هذا أميرُ المسلِمينَ ومَنْ جَرى","مَثَلاً شَروداً مَجْدُهُ وفَخارُهُ",3,"ر",2,0],["هَذا اِمرُؤٌ قَد جاءَ قَبلَ أَوانِهِ","اِن لَم يَكُن قَد جاءَ بَعدَ أَوانِهِ",4,"ن",2,0],["هَذا أَمينَ اللَهِ آخِرُ مَصدَرٍ","شَجِيَ الظَماءُ بِهِ وَأَوَّلُ مَورِدِ",5,"د",1,0],["هذا إمامُكِ فاسلكي سُبلَ الهُدى","نِعمَ الإمامُ الكوكبُ الوقّادُ",6,"د",1,0],["هذا إمامُ الدينِ في أعلامهِ","والدّينُ مُعتصِمٌ ببأسِ إمامهِ",7,"م",2,1],["هذا أميرُ المؤمنينَ بمجلسٍ","أبصرتُ فيه الوحي والتنزيلا",8,"ل",2,1],["هذا إمامُ المتَّقينَ ومَنْ بهِ","قد دُوِّخَ الطُّغيانُ والكُفّار",9,"ر",1,0],["هذا أمينُ اللّهِ بَينَ عِبادِهِ","وبلادهِ إنْ عُدَّتِ الأمناء",10,"ا",2,0],["هَذا أَميرُ المُؤمِنينَ اِنتاشَني","وَالنَفسُ بَينَ مُحَنجَرٍ وَمُخَنَّقِ",11,"ق",1,0],["هَذا اِمرُؤُ القيسِ بنُ حُجرٍ في الثَرى","دَثَرَت مَعالِمُهُ فَأَينَ دِثارُ",12,"ر",1,0],["هَذَا أَمِيرُ الشِّعْرِ وَالشُّعَرَاءِ","مِنْ عَجَمٍ وَعُرْبِ",13,"ب",1,0],["هذا أميرُ المؤمنين وظنّه","بالغيبِ مِرآةٌ تضىء وتلمعُ",14,"ع",1,0],["هذا امتحان لك إن تَرضَهُ","بانَ لنا أنك ترضانا",15,"ن",2,0],["هَذا أَميرُ المؤمنين الَّذي","شَرائعُ اللَه به تُحرَسُ",16,"س",1,0],["هذا أمير المؤمنين إمامنا","في الدين والدنيا إليه الموئل",17,"ل",1,0],["هذا أميرُ المؤمنين الذي","أولَيتَه منك الوَلاءَ الصُراح",18,"ح",1,0],["هذا أمير المؤمنين وهذه","آثاره من حازمٍ يقظان",19,"ن",1,0],["هذا إمامُ المسلمين ومذهب ال","حقَّ المبين وسرّه والمظهر",20,"ر",1,0],["هذا أمير الفضل افصح معرب","ان قال قولا بز كل خطيب",21,"ب",1,0],["هذا إمام الناظمين وسيد ال","مترسلين وقطب كل أديب",21,"ب",1,0],["هَذا إِمام المُرسَلين وَذُخرهم","هَذا مَلاذ أَعزة وَكِبار",22,"ر",1,0],["هذا أميرُ المجدِ ذو اللَّمعِ الذي","مِن قبلهِ في وجهِ موسى يُعهَدُ",23,"د",1,1],["هذا أمينُ الدَولةِ الرَّاعي الذي","جَعَلَ الصِّيانةَ حَجَّهُ وجِهادَهُ",24,"د",2,0],["هذا إمامٌ في الأئمَّةِ ذِكرُهُ","قد شاعَ بينَ مَشارقٍ ومَغاربِ",25,"ب",1,0],["هذا أَميرُ مِلاح الخلق قاطبةٌ","قولُوا لهم فليُطيعوا أَمْر إِمْرته",26,"ت",2,0],["هَذا أَميرُ الشِعرِ غَيرَ مُدافِعٌ","في الشَرقِ أَجمَعُ مُنذُ فَتقِ لَهاتِهِ",27,"ت",2,0],["هَذا أَميرُ الشِعرِ عِندَ قَبيلِهِ","مِنهُ لِجيدِ الدَهرِ عِقدُ فَرائِد",28,"د",1,0],["هذا إمام الرفض ما","تَ بِحتفهِ في الناس نودي",29,"د",2,0],["هذا أميرُ المجدِ باتَ موسَّدا","بضريحه المبرورِ محلولَ العُرَى",30,"ر",2,0],["هذا إمام المسلمين","ومن بمفخره انفرد",31,"د",1,0],["هذا أمير المؤمنين ولم يكن","في عصره من حاز مثل خصاله",32,"ل",2,0],["هذا أما وهواك وهو أليَّتي","بأعزَّ من قسمٍ وأكرم موثقِ",33,"ق",1,0],["هذا إمام العصر مفزع","كلِّ ذي كبدٍ مروعه",34,"ع",2,0],["هذا أَميرُ المؤمنين بعدما","ألجأهم للدين في ضِرابه",35,"ب",2,0],["هذا امتداحيك عقيد الندى","أشهد بالمجد لك الأشقر",36,"ر",1,0],["هذا أَميرُكُم يا المُؤمِنونَ سَعى","لِرُشدِكُم فَأَجيبوا داعيَ الرَشَدِ",37,"د",1,0],["هذا إمام نبيلٌ بين أظهرنا","هذا قتيلُ الهوى واللثمِ والنظرِ",38,"ر",1,0],["هذا امرؤ قد صار رهن البلا","لا يورد الامر ولا يَصدر",39,"ر",1,0],["هذا إمام الوقت قطب عصره","أخو الهدى مهذب الطباع",40,"ع",1,0],["هَذا أَمير بَني أُمية فَاِحذَروا","ثَأر الحُسين فَإِنَّهُ في كفه",41,"ف",2,0],["هذا إمام الهدى والحجه","زورته مثل الفي حجة",42,"ه",1,0],["هذا أمين الرافعي ومن له","خير السجايا الغرّ والآثار",43,"ر",1,0],["هذا إمام الشرق ليس نظيره","في الشرق والدنيا تقرُّ بفضلهِ",44,"ل",2,1],["هذا أَمان الدار دار الرضى","فاستبشري وَالشافع المصطفى",45,"ف",2,0],["هذا أمير النحل فاعتبروا","قولي وشيعته هم النحل",46,"ل",1,0],["هذا امير المؤمنين امانه","من كل خوف جنة ومغافر",47,"ر",1,0],["هذا امير المؤمنين مطيعه","ناج وعاصيه وخيم المصرع",48,"ع",1,0],["هذا امير الناس في فضله","وفصله في بهمة الامر",49,"ر",1,0],["هذا امير المؤمنين مطيعه","ناج وعاصيه يذوق سعيرا",50,"ر",2,0],["هذا إمام الحق رافع شأنه","مولى الكمال ملانيوس الأطهرُ",51,"ر",1,0],["هذا (أمينٌ) باعترافِ بطاقةٍ","أمَّا الطبيبُ فناجحٌ بالزُّورِ",52,"ر",1,0],["هذا إمامِيٌّ يُطَبِّلُ فِي","عَصْرِ الفَضَاءِ الحُرِّ لِلسَّدَنَةْ",53,"ن",2,0],["هذا أمير المؤمنين وعزهم","وملاذهم عبد الحميد الثاني",54,"ي",1,1],["هذا امتحانٍ للغلا فيه شِدّه","إن كان ما زلنا مثل قبل عشاق",55,"ق",1,0],["هذا إمام أناس للهدى رفضت","بقولها إنه من أشرف الرؤسا",56,"س",2,0],["هذا إمامٌ للتمدن قد غدا","يهدي الأنام برأيهِ وسدادهِ",57,"د",2,0],["هذا امتحانُ اشتعالِ القلبِ غُربتُهُ","تَنمو وسيرتُهُ المرآةُ في كِسَرِ",58,"ر",1,0],["هذا إمام الشام والدنيا معاً","يقضى ويفتي حيثما الله أمر",59,"ر",1,0],["هذا امتِحانٌ لَنا واللهُ ينصرُنا","رغمَ المَجازِرِ ما اهتَزَّتْ قََناعاتي",60,"ت",2,0],["هَذا أَميرُكُمُ , وَ تاجُ رُؤُوسِكُمْ","فَهَبُوا لَهُ الحَمْراءَ في دِيباجِها",61,"ج",3,0],["هذا أمسر المؤمنين بعدما","ألجأهم للدين في ضِرابه",62,"ب",2,0]]}