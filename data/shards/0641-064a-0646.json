dhabi.ae/diwan/poem/85440","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20248","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42815","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55267","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55147","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54571","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55069","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54941","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54854","المجتث"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67291","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43824","المديد"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142327","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54229","الكامل"],[106,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[106,"تمثال فينوس","https://www.poetsgate.com/ViewPoem.aspx?id=179776",""],[103,"وحى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=64546",""],[45,"نعتد انحسنا بعزك أسعدا","https://www.poetsgate.com/ViewPoem.aspx?id=32929",""],[45,"بَعْضَ هَذا العِتَابِ وَالتّفْنيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=31628",""],[28,"يختلف الناس ما لم نجتمع لهم","https://www.poetsgate.com/ViewPoem.aspx?id=186559",""],[51,"يا بائع البيت بِزقٍّ واحِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=27653",""],[51,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[48,"لا تَبْكِ بَعْدَ تَفَرّقِ الخلطاءِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24841&r=&rc=11",""],[0,"خليلّي مرّ بي على أم جندب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14326&r=&rc=2",""],[92,"أَتَفنى ابتساماتُ تَلك الجفونِ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14571&r=&rc=16",""]],"verses":[["في نَدامى عَلى الهُمومِ قُعودٌ","يَدعَمونَ الأَذقانَ بِالراحاتِ",0,"ت",1,0],["في نِسْوَةٍ رَقَّتْ خُدوداً أُشْرِبَتْ","ماءَ الشبيبَةِ وَالقُلوبُ غِلاظُ",1,"ظ",1,0],["في نِصْفِ الاسْتِذْكارِ أعطَيْتُهُ","مُخْتَصَرَ العيْنِ فأرْضاهُ",2,"ه",1,0],["فَيَنشَقُّ الذِهنُ مِن أَسطارِهِ أَرَجاً","وَتُبصِرُ العَينُ فَوقَ الطِرسِ بُستانا",3,"ن",2,0],["فَيَنْبَرِي وَإِذَا الرَّهْلُ المُسِنُّ فَتًى","يُطِيقُ مَا لا يُطِيقُ الفِتْيَةُ الْهُضُمُ",4,"م",1,0],["فينا لَكُنَّ وَإِن شَيبٌ بَدا أَرَبٌ","وَلَيسَ فيكُنَّ بَعدَ الشَيبِ مِن أَرَبِ",5,"ب",1,0],["في نَواحي هَيكَلٍ أَرِجٍ","عاكِفاً فيهِ عَلى صَنَمِ",6,"م",1,0],["في نفوس الذين لم يُرزَقوه","حسرات وفي القلوب حزازه",7,"ز",2,0],["فينا المَساجِدُ وَالإِمامُ وَلا تَرى","في دارِ تَغلِبَ مَسجِداً مَعمورا",8,"ر",2,0],["فينا الخِلافَةُ وَالنُبُوَّةُ وَالهُدى","وَذَوُو المَشورَةِ كُلَّ يَومِ تَشاوُرِ",9,"ر",1,0],["فينا وَفي الخَيلِ تَردي في مَساحِلِها","يَومَ الوَغى لِمَنايا القَومِ تَعجيلُ",10,"ل",1,0],["في نابِهِ عِوَجٌ يُجاوِزُ شِدقَهُ","وَيُخالِفُ الأَعلى وَراءَ الأَسفَلِ",11,"ل",1,0],["فينا الرَسولُ وَفينا الحَقُّ نَتبَعُهُ","حَتّى المَماتِ وَنَصرٌ غَيرُ مَحدودِ",12,"د",1,0],["في نظمه عنكم وخطّ يراعهِ","صغر فلا ألفاً أجادَ ولا با",13,"ب",2,0],["في نعمة وسيادة","تسع الوَليَّ وضده",14,"د",2,0],["في نباتٍ قلنا جماداً فلما","صحفوا ماسَ كالقضيب انْتعاشا",15,"ش",2,0],["في نعمةٍ جزمت بأنك خافضٌ","قدرَ الحسود وقدرُك المرفوع",16,"ع",1,0],["في نظرةٍ منك تأميلي ومفترجي","ولفظة منك تنويلي وتنويهي",17,"ي",1,0],["فينضب جعفر ويعوز فضل","ويبلى خالد ويموت يحيى",18,"ي",2,0],["فَيُنادي على استه","رحم الله من عَفَجْ",19,"ج",1,0],["في نَسِيم من السَّعَادة مَطْلُو","لٍ كأنفاس ذات عِطْرَيْنِ رُودِ",20,"د",1,0],["فينا وفيك طبيعةٌ أرضيةٌ","تهوي بنا أبداً لِشرِّ قرارِ",21,"ر",1,0],["في نكهة تورد المنايا","ليست على النفس باليسيرَه",22,"ر",2,0],["في نفس من شمْألٍ مسالسه","ليِّنة الهَزهاز لا معافسه",23,"س",2,0],["في نقابٍ من لثامٍ","وإزار من عناق",24,"ق",1,0],["في نعمةٍ كرياضِ الحَزْنِ ضاحكةٍ","في ظل بالٍ من الأيَّام مَدْجون",25,"ن",1,0],["في نكاح مثل السِّفاح خلا أَنْ","نَ ذاك شُبهةٌ وذاك مُبين",26,"ن",1,0],["فَيَنظُرُ في صُحُفٍ كَالرِيا","طِ فيهِنَّ إِرثُ كِتابٍ مَحِيُّ",27,"ي",1,0],["في نَبعَةٍ مِن قُرَيشٍ يَعصِبونَ بِها","ما إِن يُوازى بِأَعلى نَبتِها الشَجَرُ",28,"ر",1,0],["في نَشْوَةِ الأَحلامِ والإِلهامِ","شِعري وأَفكاري وكُلُّ مشاعري",29,"ي",1,0],["في نُغْيَةِ الحَمَلِ الوَديعِ","وفي أَناشيدِ الرُّعاةْ",30,"ه",1,0],["في نشوةٍ صوفيَّةٍ قُدُسيَّةٍ","هي خيرُ مَا في العالِمِ المنظورِ",31,"ر",1,0],["فينطفئُ السِّحْرُ سحرُ الغُصونِ","وسحرُ الزُّهورِ وسحرُ الثَّمَرْ",32,"ر",1,0],["فينضُبُ يمُّ الحياةِ الخضمُّ","ويخمدُ روحُ الرَّبيعِ الوَلودْ",33,"د",1,0],["فين المحامي","ما فيش كلام",34,"م",1,0],["في نسوة يورِدن من شِئن الردى","نظَرا ولا ينظرن في الإِصدار",35,"ر",1,0],["فَيَنظُرَ الخَيرَ الَّذي نَظَرتُ","وَيَشكُرَ الفَضلَ كَما شَكَرتُ",36,"ت",1,0],["فينا مِنَ الصَبرِ الجَميلِ بَقِيَّةٌ","لِحَوادِثٍ خَلفَ العُيوبِ جِسامِ",37,"م",1,0],["في نَعيمِ اللَهِ نَفسٌ أوتِيَت","أَنعُمَ الدُنيا فَلَم تَنسَ تُقاها",38,"ا",3,0],["في نِسوَةٍ يورِدنَ مَن شِئنَ الهَوى","نَظَراً وَلا يَنظُرنَ في الإِصدارِ",39,"ر",1,0],["في نَصيبينَ لَبِسنا حُسنَها","وَعَلى التَلِّ لَبِسناها مَعابا",40,"ب",2,0],["في نَواحي بُرجانَ إِذ أَنكَروا التَك","بيرَ حَتّى تَوَهَّموهُ غِناءَ",41,"ا",2,0],["في نِظامٍ مِنَ المَحاسِنِ مازا","لَت تُضاهي أَخلاقَهُ آدابُه",42,"ب",2,0],["في نِعمَةٍ أَوطَنتُها وَأَقَمتُ في","أَفيائِها فَكَأَنَّني في مَنبِجِ",43,"ج",1,0],["في نِعمَةٍ هِيَ لِلمَكارِمِ وَالعُلا","وَسَلامَةٍ هِيَ لِلسَماحَةِ وَالنَدى",44,"د",2,0],["في نِظامٍ مِنَ البَلاغَةِ ما","شَكَّ إِمرُؤٌ أَنَّهُ نِظامُ مَريدِ",45,"د",1,0],["في نَهارٍ مِنَ السُيوفِ مُضيءٍ","تَحتَ لَيلٍ مِن مُستَثارِ الصَعيدِ",46,"د",1,0],["فيُنشِدُه الذي حبَّرْتَ فيه","ويَحلِقُ رأسَه بعدَ النَّشيدِ",47,"د",1,0],["في نِعمَةٍ وَغَضارَةٍ","وَسَلامَةٍ وَرَفاهِيَه",48,"ي",2,0],["في نَشوَةِ الحَمراءِ وَالخَضراءِ","أَمنٌ مِنَ السَوداءِ وَالصَفراءِ",49,"ا",2,1],["فَيَنثَني مَن أَوَدُّ صُحبَتَهُ","وَقَلبُهُ عَن هَوايَ يَنقَلِبُ",50,"ب",1,0],["فَيُنشِدُ مِن شِعري رَقيقاً مُخَمَّساً","وَيَرشُفُ مِن خَمري رَحيقاً مُثَلَّثا",51,"ث",2,0],["فَيَنظِمُ فيها الرُمحُ ما السَيفِ ناثِرٌ","وَيَنثُرُ فيها العَضبُ ما اللَدنُ يَنضِدُ",52,"د",1,0],["في نارِها كُنتَ الخَليلَ وَإِنَّما","عِندَ اِلتِماسِ حَديدِها داوودا",53,"د",2,0],["في نسيجٍ خالدٍ رَغمَ البِلى","عَبَثَ الدهرُ وما يَعبثُ به",54,"ه",1,0],["في نصابٍ لم يزل من حِمْيَر","مُعْرِقاً في كلّ قومٍ مُنْتَخَب",55,"ب",1,0],["فِي نَشْوَةِ الْخَمْرِ سِرٌّ مِنْ مَرَاشِفِهَا","وَفِي الأَرَاكَةِ شَكْلٌ مِنْ تَهَادِيهَا",56,"ي",3,0],["فينا غزالٌ إنْ أبيت ما اعتدى","فأسقطِ الحرفَ الأخيرَ أبدا",57,"د",2,0],["في نُصرةِ الآجامِ يُحتَملُ الأَذَى","ولها تَجُوعُ وتَشْبَعُ الآسادُ",58,"د",1,0],["فَيَنشُرُ الحَمدُ ما أَخفاهُ مِن مِنَنٍ","وَيَكتُمُ الضَربُ بيضَ الهِندِ في القَلَلِ",59,"ل",1,0],["في نَرجِسٍ غَضٍّ نَواظِرُهُ","بَينَ الجُفونِ عُيونُها صُفرُ",60,"ر",1,0],["فَيَنبَري بِفَصيحِ اللَحنِ عَن نَغَمٍ","مُثَقَّفاتٍ فَصيحاتٍ بِتَثبيتِ",61,"ت",1,0],["في نَدامى سادَةٍ نُجُبٍ","أَخَذوا اللَذّاتِ مِن أُمَمِ",62,"م",1,0],["في نُشرَةٍ بَعدَ حَظّي طيبَ جادِيَةٍ","جاءَت تَهادى بِهِم مِن بَعدِ ما هَجَدوا",63,"د",3,0],["في نِساءٍ إِذا أَرَدنَ ضِياءً","لِظَلامٍ جَعَلنَها مِصباحا",64,"ح",2,0],["في نَأيِها وَصَبٌ عَلَيَّ مُبَرِّحٌ","وَدُنُوُّها شافٍ مِنَ الأَوصابِ",65,"ب",1,0],["في ناضِرٍ جَعدِ الثَرى كُبابِ","يَلقى اِلتِهابَ الشَمسِ بِاِلتِهابِ",66,"ب",1,0],["في نَفسِهِ شُغلٌ وَفي بَيتِهِ","فُضوحُ إِخوانٍ وَآباءِ",67,"ا",2,0],["فينا التَحاسُدُ مَعروفٌ فَهَل حَسِدَت","مُجتَرَّةُ الإِبلِ أُخرى ما لَها جِرَرُ",68,"ر",1,0],["في نِصْفِ شَهْرٍ تَرَكْتَ الأَرْضَ ساكِنَةً","مِنْ بَعْدِ ما كانَ فِيْهَا الجوْرُ قَدْ ماجا",69,"ج",2,0],["في نغْمَةِ العودِ والنّايِ الرّخيم إذا","تَألّقا بينَ ألحانٍ من الهَزَجِ",70,"ج",1,0],["فينفذ النور فيه ثم ينكسرُ","الشعر سيف وأَنتَ اليوم تصقله",71,"ه",1,0],["في نحرها ماسة كالنجم ساطعة","وفوق مفرقها تاج من الذهب",72,"ب",1,0],["في نوعه الإنسان يشبه دوحةً","للريح بين غصونها إخفاق",73,"ق",1,0],["في نتوءِ الصخور مشرفة الأعنا","قِ بيضاً تطلُّ فوق عبابكْ",74,"ك",1,0],["فينا عَلى كَرَمِ الطِبا","عِ وَنُبلِها طَبعٌ يُعاب",75,"ب",1,0],["فِي نَشْوَةِ الرَّاحِ مِنْ أَلْحَاظِهَا أَثَرٌ","وَفِي الْجَآذِرِ مِنْ أَلْفَاظِهَا غُنَنُ",76,"ن",1,0],["فَيَنْفَعُهَا رَأْيُهُ المُجْتَنَى","وَيَنْفَعُهَا غَرْسُهُ المُطْعِمُ",77,"م",1,0],["فَيَنُمُّ وَجْهُ اللُّجِّ عَمَّا فِي الْحَشَى","وَتُصَادُ مِنْ أَصْدَافِهِنَّ لآلِي",78,"ل",2,0],["فِي نُخبَةٍ مَهْمَا يُسَامُوا يَبْذُلُوا","لِذيَادَ مُجْتَاحٍ وَصَوْنِ ذِمَارِ",79,"ر",1,0],["فِي نَجْلِهِ لاَحَتْ مَخَايِلُ نُبْلِهِ","مَوْسُومَةً بِوِسَامِهِ الخَلاَّبِ",80,"ب",1,0],["فِي نُطْقِهِ الدُّرُّ النَفِيسُ وَإِنَّمَا","تَصْطَادُهُ الأَسْمَاعُ بِالإِصْغَاءِ",81,"ا",2,0],["فِي نُصْحِهِ بِالعِلْمِ وَهْوَ لأَهْلِهِ","حِرْزٌ مِنَ الإِيهَانِ وَالإِيهَاءِ",81,"ا",2,0],["فِي نَثْرِكَ الفَنِّيِّ وهْوَ الَّذِي","لاَ يُلْحَقُ اليَوْمَ وَلَمْ يُسْبَقِ",82,"ق",1,0],["فِي نَهْضَةِ الْجِنْسِ اللَّطِيفِ لَقَدْ","دَرَتِ الكِنَانَةُ أَنَّهَا الْبِكْرُ",83,"ر",1,0],["فِي نَادِيَاتٍ ذَوَاكٍ","لاَ تُعْقِبُ الشَّرْبَ سُكْرَا",84,"ر",2,0],["فِينا الرسُولُ شِهابٌ ثُمَّ يَتْبَعُهُ","نُورٌ مُضيءٌ لَهُ فَضْلٌ على الشُّهُبِ",85,"ب",1,0],["في نَشاطٍ لِلحِضارِ نَشا","إِن كَسا الطِفلَ الصِبا كَسَلا",86,"ل",2,0],["فينتفي تحت الضّحى","وجوهه المنزدهه",87,"ه",1,0],["في نَهْضَةِ الْفارُوقِ","والْغَازي غِنىً لِلْمُسْتَزِيدِ",88,"د",1,0],["-في نَغَم خَال من الإطْراب-","صفحةٌ انطَوَتْ من الكتاب!",89,"ب",1,0],["فِينوسُ يا رمزَ الجما","لِ العبقريِّ وسرِّه",90,"ر",2,0],["فينثنى عن ضلال الشرك يدفعه","رأى سديد وعقل زانه الأدب",91,"ب",1,0],["في نعمة هي المكارم والعلا","وسلامة هي للسماحة والندى",92,"د",2,0],["في نِظَام مِن البَلاغَةِ مَا شَكّ","امرُؤٌ أنّهُ نِظَامُ فَرِيدِ",93,"د",1,0],["فينا الكواهل والأعناق تقدمها","فيها الرؤوس وفيها السمع والبصر",94,"ر",1,0],["فينتحي عرضَك بالقصائدِ","فالناس في جَهْدٍ لذاك جاهدِ",95,"د",1,0],["في نِعمٍ يوليكَها المِنعام","ُ لها تمامٌ ولها دوامُ",96,"م",1,0],["....؟.... فينا كالبِجادي حُمرَة ً ،","وَالكأسُ مِنْ ياقُوتَة ٍ بَيضَاءِ",97,"ا",2,0],["فينا نعاجٌ يرتعينَ خميلة ً","كمَشْيِ العَذارَى في المُلاءِ المُهَدَّبِ",98,"ب",1,0],["فينضبُ يمُّ الحياة ِ، الخضيمُّ","ويَخمدُ روحُ الربيع، الولود",99,"د",1,0]]}