w.aldiwan.net/poem47429.html","عموديه"],[541,"يا من تدين وهو في","https://www.aldiwan.net/poem47484.html","عموديه"],[541,"خضوعا ومثلي بالخضوع أخو فخر","https://www.aldiwan.net/poem48153.html","عموديه"],[561,"قالوا غدا نأتي ديار الحمى","https://www.aldiwan.net/poem33856.html","السريع"],[561,"من يعرف الله فليس يسأل","https://www.aldiwan.net/poem34250.html","الرجز"],[561,"قمر من فوق غصن نقا","https://www.aldiwan.net/poem34336.html","المديد"],[561,"هو الكون ثوب والسداء هو الأمر","https://www.aldiwan.net/poem34508.html","الطويل"],[561,"هذا الوجود الحقيقي الواحد الأحد","https://www.aldiwan.net/poem34570.html","البسيط"],[561,"طلعت شمس الوجود","https://www.aldiwan.net/poem34655.html","مجزوء الرمل"],[565,"كريم قد تولاه الكريم","https://www.aldiwan.net/poem52763.html","الوافر"],[566,"فالأولياء رحمة للخلق","https://www.aldiwan.net/poem13620.html","الرجز"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"يا ثالث العمرين علماً","https://www.aldiwan.net/poem3011.html","مجزوء الكامل"],[578,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"],[623,"","https://poetry.dctabudhabi.ae/diwan/poem/130359","الكامل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/28465","الكامل"]],"verses":[["في نَدامى عَلى الهُمومِ قُعودٌ","يَدعَمونَ الأَذقانَ بِالراحاتِ",0,"ت",1,0],["في نِسْوَةٍ رَقَّتْ خُدوداً أُشْرِبَتْ","ماءَ الشبيبَةِ وَالقُلوبُ غِلاظُ",1,"ظ",1,0],["في نِصْفِ الاسْتِذْكارِ أعطَيْتُهُ","مُخْتَصَرَ العيْنِ فأرْضاهُ",2,"ه",1,0],["فَيَنشَقُّ الذِهنُ مِن أَسطارِهِ أَرَجاً","وَتُبصِرُ العَينُ فَوقَ الطِرسِ بُستانا",3,"ن",2,0],["فَيَنْبَرِي وَإِذَا الرَّهْلُ المُسِنُّ فَتًى","يُطِيقُ مَا لا يُطِيقُ الفِتْيَةُ الْهُضُمُ",4,"م",1,0],["فينا لَكُنَّ وَإِن شَيبٌ بَدا أَرَبٌ","وَلَيسَ فيكُنَّ بَعدَ الشَيبِ مِن أَرَبِ",5,"ب",1,0],["في نَواحي هَيكَلٍ أَرِجٍ","عاكِفاً فيهِ عَلى صَنَمِ",6,"م",1,0],["في نفوس الذين لم يُرزَقوه","حسرات وفي القلوب حزازه",7,"ز",2,0],["فينا المَساجِدُ وَالإِمامُ وَلا تَرى","في دارِ تَغلِبَ مَسجِداً مَعمورا",8,"ر",2,0],["فينا الخِلافَةُ وَالنُبُوَّةُ وَالهُدى","وَذَوُو المَشورَةِ كُلَّ يَومِ تَشاوُرِ",9,"ر",1,0],["فينا وَفي الخَيلِ تَردي في مَساحِلِها","يَومَ الوَغى لِمَنايا القَومِ تَعجيلُ",10,"ل",1,0],["في نابِهِ عِوَجٌ يُجاوِزُ شِدقَهُ","وَيُخالِفُ الأَعلى وَراءَ الأَسفَلِ",11,"ل",1,0],["فينا الرَسولُ وَفينا الحَقُّ نَتبَعُهُ","حَتّى المَماتِ وَنَصرٌ غَيرُ مَحدودِ",12,"د",1,0],["في نظمه عنكم وخطّ يراعهِ","صغر فلا ألفاً أجادَ ولا با",13,"ب",2,0],["في نعمة وسيادة","تسع الوَليَّ وضده",14,"د",2,0],["في نباتٍ قلنا جماداً فلما","صحفوا ماسَ كالقضيب انْتعاشا",15,"ش",2,0],["في نعمةٍ جزمت بأنك خافضٌ","قدرَ الحسود وقدرُك المرفوع",16,"ع",1,0],["في نظرةٍ منك تأميلي ومفترجي","ولفظة منك تنويلي وتنويهي",17,"ي",1,0],["فينضب جعفر ويعوز فضل","ويبلى خالد ويموت يحيى",18,"ي",2,0],["فَيُنادي على استه","رحم الله من عَفَجْ",19,"ج",1,0],["في نَسِيم من السَّعَادة مَطْلُو","لٍ كأنفاس ذات عِطْرَيْنِ رُودِ",20,"د",1,0],["فينا وفيك طبيعةٌ أرضيةٌ","تهوي بنا أبداً لِشرِّ قرارِ",21,"ر",1,0],["في نكهة تورد المنايا","ليست على النفس باليسيرَه",22,"ر",2,0],["في نفس من شمْألٍ مسالسه","ليِّنة الهَزهاز لا معافسه",23,"س",2,0],["في نقابٍ من لثامٍ","وإزار من عناق",24,"ق",1,0],["في نعمةٍ كرياضِ الحَزْنِ ضاحكةٍ","في ظل بالٍ من الأيَّام مَدْجون",25,"ن",1,0],["في نكاح مثل السِّفاح خلا أَنْ","نَ ذاك شُبهةٌ وذاك مُبين",26,"ن",1,0],["فَيَنظُرُ في صُحُفٍ كَالرِيا","طِ فيهِنَّ إِرثُ كِتابٍ مَحِيُّ",27,"ي",1,0],["في نَبعَةٍ مِن قُرَيشٍ يَعصِبونَ بِها","ما إِن يُوازى بِأَعلى نَبتِها الشَجَرُ",28,"ر",1,0],["في نَشْوَةِ الأَحلامِ والإِلهامِ","شِعري وأَفكاري وكُلُّ مشاعري",29,"ي",1,0],["في نُغْيَةِ الحَمَلِ الوَديعِ","وفي أَناشيدِ الرُّعاةْ",30,"ه",1,0],["في نشوةٍ صوفيَّةٍ قُدُسيَّةٍ","هي خيرُ مَا في العالِمِ المنظورِ",31,"ر",1,0],["فينطفئُ السِّحْرُ سحرُ الغُصونِ","وسحرُ الزُّهورِ وسحرُ الثَّمَرْ",32,"ر",1,0],["فينضُبُ يمُّ الحياةِ الخضمُّ","ويخمدُ روحُ الرَّبيعِ الوَلودْ",33,"د",1,0],["فين المحامي","ما فيش كلام",34,"م",1,0],["في نسوة يورِدن من شِئن الردى","نظَرا ولا ينظرن في الإِصدار",35,"ر",1,0],["فَيَنظُرَ الخَيرَ الَّذي نَظَرتُ","وَيَشكُرَ الفَضلَ كَما شَكَرتُ",36,"ت",1,0],["فينا مِنَ الصَبرِ الجَميلِ بَقِيَّةٌ","لِحَوادِثٍ خَلفَ العُيوبِ جِسامِ",37,"م",1,0],["في نَعيمِ اللَهِ نَفسٌ أوتِيَت","أَنعُمَ الدُنيا فَلَم تَنسَ تُقاها",38,"ا",3,0],["في نِسوَةٍ يورِدنَ مَن شِئنَ الهَوى","نَظَراً وَلا يَنظُرنَ في الإِصدارِ",39,"ر",1,0],["في نَصيبينَ لَبِسنا حُسنَها","وَعَلى التَلِّ لَبِسناها مَعابا",40,"ب",2,0],["في نَواحي بُرجانَ إِذ أَنكَروا التَك","بيرَ حَتّى تَوَهَّموهُ غِناءَ",41,"ا",2,0],["في نِظامٍ مِنَ المَحاسِنِ مازا","لَت تُضاهي أَخلاقَهُ آدابُه",42,"ب",2,0],["في نِعمَةٍ أَوطَنتُها وَأَقَمتُ في","أَفيائِها فَكَأَنَّني في مَنبِجِ",43,"ج",1,0],["في نِعمَةٍ هِيَ لِلمَكارِمِ وَالعُلا","وَسَلامَةٍ هِيَ لِلسَماحَةِ وَالنَدى",44,"د",2,0],["في نِظامٍ مِنَ البَلاغَةِ ما","شَكَّ إِمرُؤٌ أَنَّهُ نِظامُ مَريدِ",45,"د",1,0],["في نَهارٍ مِنَ السُيوفِ مُضيءٍ","تَحتَ لَيلٍ مِن مُستَثارِ الصَعيدِ",46,"د",1,0],["فيُنشِدُه الذي حبَّرْتَ فيه","ويَحلِقُ رأسَه بعدَ النَّشيدِ",47,"د",1,0],["في نِعمَةٍ وَغَضارَةٍ","وَسَلامَةٍ وَرَفاهِيَه",48,"ي",2,0],["في نَشوَةِ الحَمراءِ وَالخَضراءِ","أَمنٌ مِنَ السَوداءِ وَالصَفراءِ",49,"ا",2,1],["فَيَنثَني مَن أَوَدُّ صُحبَتَهُ","وَقَلبُهُ عَن هَوايَ يَنقَلِبُ",50,"ب",1,0],["فَيُنشِدُ مِن شِعري رَقيقاً مُخَمَّساً","وَيَرشُفُ مِن خَمري رَحيقاً مُثَلَّثا",51,"ث",2,0],["فَيَنظِمُ فيها الرُمحُ ما السَيفِ ناثِرٌ","وَيَنثُرُ فيها العَضبُ ما اللَدنُ يَنضِدُ",52,"د",1,0],["في نارِها كُنتَ الخَليلَ وَإِنَّما","عِندَ اِلتِماسِ حَديدِها داوودا",53,"د",2,0],["في نسيجٍ خالدٍ رَغمَ البِلى","عَبَثَ الدهرُ وما يَعبثُ به",54,"ه",1,0],["في نصابٍ لم يزل من حِمْيَر","مُعْرِقاً في كلّ قومٍ مُنْتَخَب",55,"ب",1,0],["فِي نَشْوَةِ الْخَمْرِ سِرٌّ مِنْ مَرَاشِفِهَا","وَفِي الأَرَاكَةِ شَكْلٌ مِنْ تَهَادِيهَا",56,"ي",3,0],["فينا غزالٌ إنْ أبيت ما اعتدى","فأسقطِ الحرفَ الأخيرَ أبدا",57,"د",2,0],["في نُصرةِ الآجامِ يُحتَملُ الأَذَى","ولها تَجُوعُ وتَشْبَعُ الآسادُ",58,"د",1,0],["فَيَنشُرُ الحَمدُ ما أَخفاهُ مِن مِنَنٍ","وَيَكتُمُ الضَربُ بيضَ الهِندِ في القَلَلِ",59,"ل",1,0],["في نَرجِسٍ غَضٍّ نَواظِرُهُ","بَينَ الجُفونِ عُيونُها صُفرُ",60,"ر",1,0],["فَيَنبَري بِفَصيحِ اللَحنِ عَن نَغَمٍ","مُثَقَّفاتٍ فَصيحاتٍ بِتَثبيتِ",61,"ت",1,0],["في نَدامى سادَةٍ نُجُبٍ","أَخَذوا اللَذّاتِ مِن أُمَمِ",62,"م",1,0],["في نُشرَةٍ بَعدَ حَظّي طيبَ جادِيَةٍ","جاءَت تَهادى بِهِم مِن بَعدِ ما هَجَدوا",63,"د",3,0],["في نِساءٍ إِذا أَرَدنَ ضِياءً","لِظَلامٍ جَعَلنَها مِصباحا",64,"ح",2,0],["في نَأيِها وَصَبٌ عَلَيَّ مُبَرِّحٌ","وَدُنُوُّها شافٍ مِنَ الأَوصابِ",65,"ب",1,0],["في ناضِرٍ جَعدِ الثَرى كُبابِ","يَلقى اِلتِهابَ الشَمسِ بِاِلتِهابِ",66,"ب",1,0],["في نَفسِهِ شُغلٌ وَفي بَيتِهِ","فُضوحُ إِخوانٍ وَآباءِ",67,"ا",2,0],["فينا التَحاسُدُ مَعروفٌ فَهَل حَسِدَت","مُجتَرَّةُ الإِبلِ أُخرى ما لَها جِرَرُ",68,"ر",1,0],["في نِصْفِ شَهْرٍ تَرَكْتَ الأَرْضَ ساكِنَةً","مِنْ بَعْدِ ما كانَ فِيْهَا الجوْرُ قَدْ ماجا",69,"ج",2,0],["في نغْمَةِ العودِ والنّايِ الرّخيم إذا","تَألّقا بينَ ألحانٍ من الهَزَجِ",70,"ج",1,0],["فينفذ النور فيه ثم ينكسرُ","الشعر سيف وأَنتَ اليوم تصقله",71,"ه",1,0],["في نحرها ماسة كالنجم ساطعة","وفوق مفرقها تاج من الذهب",72,"ب",1,0],["في نوعه الإنسان يشبه دوحةً","للريح بين غصونها إخفاق",73,"ق",1,0],["فِينَا كَرِاكِرُ أَجْوَازٌ مُضَبَّرَةٌ","فِيها دُروءٌ إِذَا خِفْنَا مِنَ الزَّوَرِ",74,"ر",1,0],["فِينَا خَنَاذِيذُ فُرْسَانٍ وأَلْوِيَةٌ","كُلُّ سَائِمَةٍ مِنْ سَارِحٍ عَكَرٍ",74,"ر",1,0],["في نِسْوَةٍ مِنْ بَنِي دَهْيٍ مُصَعِّدَةٍ","ومِنْ قَنَانٍ تَؤُمُّ السَّيْرَ لِلضَّجَنِ",75,"ن",1,0],["في نِسْوةٍ شُمُسٍ لاَ مَكْرَهٍ عُنُفٍ","ولاَ فَوَاحِشَ في سِرٍّ ولاَ عَلَنِ",75,"ن",1,0],["في نتوءِ الصخور مشرفة الأعنا","قِ بيضاً تطلُّ فوق عبابكْ",76,"ك",1,0],["فينا عَلى كَرَمِ الطِبا","عِ وَنُبلِها طَبعٌ يُعاب",77,"ب",1,0],["فِي نَشْوَةِ الرَّاحِ مِنْ أَلْحَاظِهَا أَثَرٌ","وَفِي الْجَآذِرِ مِنْ أَلْفَاظِهَا غُنَنُ",78,"ن",1,0],["فَيَنْفَعُهَا رَأْيُهُ المُجْتَنَى","وَيَنْفَعُهَا غَرْسُهُ المُطْعِمُ",79,"م",1,0],["فَيَنُمُّ وَجْهُ اللُّجِّ عَمَّا فِي الْحَشَى","وَتُصَادُ مِنْ أَصْدَافِهِنَّ لآلِي",80,"ل",2,0],["فِي نُخبَةٍ مَهْمَا يُسَامُوا يَبْذُلُوا","لِذيَادَ مُجْتَاحٍ وَصَوْن