{"poems":[[53,"أأنكر والمجد عنوانيه","https://www.aldiwan.net/poem29619.html","المتقارب"],[73,"هواي وإن تناءت عنك داري","https://www.aldiwan.net/poem11962.html","الوافر"],[51,"ومن العجائب يا أبا الفياض","https://www.aldiwan.net/poem64948.html","الكامل"],[51,"أسومك ما يسوم العبد مثلي","https://www.aldiwan.net/poem65810.html","الوافر"],[143,"بسعدك دارت في السماء الكواكب","https://www.aldiwan.net/poem11734.html","الطويل"],[229,"ولما هززت السيف ثم اشتملته","https://www.aldiwan.net/poem51149.html","الطويل"],[271,"أراني ما ذكرت لك الفراقا","https://www.aldiwan.net/poem52101.html","الوافر"],[282,"ذكرتك إذ شمت بالشام برقا","https://www.aldiwan.net/poem32694.html","المتقارب"],[364,"هم منعوا منا الخيال الذي يسري","https://www.aldiwan.net/poem60909.html","البسيط"],[441,"تسر النوى ما الحب أبداه معلنا","https://www.aldiwan.net/poem14322.html","الطويل"],[458,"ألم أتحدث والحديث شجون","https://www.aldiwan.net/poem55857.html","الطويل"],[458,"لنا من ليلنا بلِوى الصريمِ","https://www.aldiwan.net/poem55891.html","الوافر"],[515,"أمالي من عذولكم عذير","https://www.aldiwan.net/poem12131.html","الوافر"]],"verses":[["وَلَم أَهجُهُ بِهِجائي لَهُ","وَلَكِن هَجَوتُ بِهِ القافِيَه",0,"ي",2,0],["وَلَم أَهجُر لِعَتبٍ غَيرَ أَنّي","أَضَرَّت بي مُعاقَرَةُ العُقارِ",1,"ر",1,0],["وَلَما هجوْتُك بل وعظتُك إنني","لا أجعل الأعراض كالأغراض",2,"ض",1,0],["ولم أهربْ على ثقةٍ وعلمٍ","بأني إن رميتَ أفوتُ نَبلك",3,"ك",1,0],["وَلَمّا هَجَرتَ الشامَ حاشاكَ أَن تُرى","لَهُ هاجِراً أَو عَنهُ رَأيُكَ راغِبُ",4,"ب",1,0],["ولمَّا هززتُ السيف ثم اشتملتُه","على ذابلٍ أضنى من الصبّ في الصدّ",5,"د",1,1],["وَلَم أَهو الكَثيب وَساكنيه","وَلا مصر الخَصيب وَلا العراقا",6,"ق",2,0],["وَلما هُريقَ الصِبى وَاِستَشَنَّ","أَديمي وَأَوهَنَ عَظمي فَدَقّا",7,"ق",2,0],["ولم أُهدِ للدّنيا ثنائي ولا أرَى","ولائي لكم إلاّ لآخِرتي ذُخري",8,"ر",2,0],["ولما هرقنا الماء فوق ثيابنا","لباب الصفا عجنا نجدد سعينا",9,"ن",2,0],["ولما هفتْ أمسِ الحلومُ بربِّها","وشووِرَ مدخولُ الحفاظِ صَنينُ",10,"ن",1,0],["ولم أهتِك دُجُنّةَ كلِّ خطبٍ","بفجرٍ من بني عبد الرحيمِ",11,"م",1,0],["ولما هزنا طرب وأنس","وبان على أسرتنا السرور",12,"ر",1,0]]}