{"poems":[[55,"أأنكر والمجد عنوانيه","https://www.aldiwan.net/poem29619.html","المتقارب"],[75,"هواي وإن تناءت عنك داري","https://www.aldiwan.net/poem11962.html","الوافر"],[53,"ومن العجائب يا أبا الفياض","https://www.aldiwan.net/poem64948.html","الكامل"],[53,"أسومك ما يسوم العبد مثلي","https://www.aldiwan.net/poem65810.html","الوافر"],[147,"بسعدك دارت في السماء الكواكب","https://www.aldiwan.net/poem11734.html","الطويل"],[234,"ولما هززت السيف ثم اشتملته","https://www.aldiwan.net/poem51149.html","الطويل"],[276,"أراني ما ذكرت لك الفراقا","https://www.aldiwan.net/poem52101.html","الوافر"],[287,"ذكرتك إذ شمت بالشام برقا","https://www.aldiwan.net/poem32694.html","المتقارب"],[369,"هم منعوا منا الخيال الذي يسري","https://www.aldiwan.net/poem60909.html","البسيط"],[447,"تسر النوى ما الحب أبداه معلنا","https://www.aldiwan.net/poem14322.html","الطويل"],[463,"ألم أتحدث والحديث شجون","https://www.aldiwan.net/poem55857.html","الطويل"],[463,"لنا من ليلنا بلِوى الصريمِ","https://www.aldiwan.net/poem55891.html","الوافر"],[520,"أمالي من عذولكم عذير","https://www.aldiwan.net/poem12131.html","الوافر"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64899","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113986","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77345","الكامل"],[2607,"","https://poetry.dctabudhabi.ae/diwan/poem/34902","الهزج"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10410","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65963","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100260","الطويل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104673","الوافر"],[2934,"","https://poetry.dctabudhabi.ae/diwan/poem/205197","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201930","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202917","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74233","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100792","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62891","الوافر"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123946","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127010","الطويل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46036","الوافر"],[3737,"","https://poetry.dctabudhabi.ae/diwan/poem/138909",""],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40137","المتقارب"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94781","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94670","الكامل"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22804","الوافر"],[5845,"أراني ما ذكرتُ لكَ الفراقا","https://www.poetsgate.com/ViewPoem.aspx?id=198486",""]],"verses":[["وَلَم أَهجُهُ بِهِجائي لَهُ","وَلَكِن هَجَوتُ بِهِ القافِيَه",0,"ي",2,0],["وَلَم أَهجُر لِعَتبٍ غَيرَ أَنّي","أَضَرَّت بي مُعاقَرَةُ العُقارِ",1,"ر",1,0],["وَلَما هجوْتُك بل وعظتُك إنني","لا أجعل الأعراض كالأغراض",2,"ض",1,0],["ولم أهربْ على ثقةٍ وعلمٍ","بأني إن رميتَ أفوتُ نَبلك",3,"ك",1,0],["وَلَمّا هَجَرتَ الشامَ حاشاكَ أَن تُرى","لَهُ هاجِراً أَو عَنهُ رَأيُكَ راغِبُ",4,"ب",1,0],["ولمَّا هززتُ السيف ثم اشتملتُه","على ذابلٍ أضنى من الصبّ في الصدّ",5,"د",1,1],["وَلَم أَهو الكَثيب وَساكنيه","وَلا مصر الخَصيب وَلا العراقا",6,"ق",2,0],["وَلما هُريقَ الصِبى وَاِستَشَنَّ","أَديمي وَأَوهَنَ عَظمي فَدَقّا",7,"ق",2,0],["ولم أُهدِ للدّنيا ثنائي ولا أرَى","ولائي لكم إلاّ لآخِرتي ذُخري",8,"ر",2,0],["ولما هرقنا الماء فوق ثيابنا","لباب الصفا عجنا نجدد سعينا",9,"ن",2,0],["ولما هفتْ أمسِ الحلومُ بربِّها","وشووِرَ مدخولُ الحفاظِ صَنينُ",10,"ن",1,0],["ولم أهتِك دُجُنّةَ كلِّ خطبٍ","بفجرٍ من بني عبد الرحيمِ",11,"م",1,0],["ولما هزنا طرب وأنس","وبان على أسرتنا السرور",12,"ر",1,0],["ولمّا هَمَى مِنْكَ النَّدى مُتَحَلِّباً","ضِمِنْتَ لأَهلِ الشَّامِ أَن تَدَمَشَّقا",13,"ق",2,0],["ولم أهدِ بالموماةِ رَكباً ولَم أرِد","بهِم أُخريَاتِ الليلِ ماءً مُسَدَّما",14,"م",2,0],["وَلَما هُزِمنا لَو تَجَمَّعَت العِدا","لِقِتالِنا وَاِستَظهَروا بِالجانِ",15,"ن",1,0],["وَلَمّا هَجَعَ السُم","مارُ نِمنا وَتَعانَقنا",16,"ن",2,0],["وَلَمّا هَبَطنا الحَرثَ قالَ أَميرُنا","حَرامٌ عَلَينا الخَمرُ ما لَم نُضارِبِ",17,"ب",1,0],["ولم أهج ذا التقوى على الأرض كلها","إِلى منتهى الاسلام في الطول والعرض",18,"ض",1,0],["ولما هبطنا الجزعِ من مسقط النقا","وطحنا على شيح الأباطح والرندِ",19,"د",1,0],["وَلَم أَهوَ الكَثيبَ وَساكِنيهِ","وَكأساً قَد أُديرَ بِهِ دِهاقا",20,"ق",2,0],["ولم أهدها إلا ونفسي تحبها","ولكن نفسي آثرتك على نفسي",21,"س",2,0],["ولما هداني الله ثنيَّتُ نظرتي","اذا الحسن في جزّينَ باقٍ كما كانا",22,"ن",2,0],["ولم أهوَ يوماً ملك أرضٍ لأنني","إذا ما ملكت الأرض تملكني الأرضُ",23,"ض",1,0],["وَلما هَمت خلنا السَماء عَلى الثَرى","استهلت فخذ ما شئت مِن درها رفدا",24,"د",2,0],["ولما هفت عين الصديق الى الكرى","وقد هدأت بالنوم منه جنوب",25,"ب",1,0],["ولما هُزَّتِ الأَقدامُ فيها","وأُطلقتِ الأَعِنَّةُ والغِوَارُ",26,"ر",1,0],["ولم اهتد للصبر بعد فراقها","وهل يهتدي من غاب عن وجه هاديه",27,"ي",2,0],["ولما هوى فوق الصعيد هوى به","أشم من المجد الأثيل منيف",28,"ف",1,0],["ولما هوى أهوت لتوزيع جسمه","سهام وسمر ذبل وسيوف",28,"ف",1,0],["وَلَمّا هَمَّ صاحِبُهُ بِقَلبٍ","عَلى وَجهٍ غَدا عَكسَ الصَّوابِ",29,"ب",1,0],["ولما هفا كبدي للضنى","واجهده الشجن المكمد",30,"د",1,0],["وَلَمّا هَبَبتَ ببُصْرَى سَمَكت","بِأهباءِ خَيلِك أَبصارَها",31,"ر",3,0],["ولمّا هاجم الاثنان قتلي","بأدواءٍ تلاشي كل داءِ",32,"ا",2,0],["ولماه جريالٌ حلا","والحسن فيهِ تجملا",33,"ل",2,0],["وَلَم أَهجُركِ مَقلِيَّةً وَلَكِن","حَلَلتُ عِراقَكُم وَحَلَلتِ شاما",34,"م",2,0],["ولمْ أهوَ الكثييبَ وساكنيهِ","ولا مصرَ الخصيبِ ولا العراقا",35,"ق",2,0]]}