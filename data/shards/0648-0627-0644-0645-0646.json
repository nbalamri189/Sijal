هِ","إذا تَقرّاهُ منْ عافٍ مَطامِعُهُ",1,"ع",2,0],["والمُنْتَمَى العلَويُّ عيصُكَ لم تكُنْ","لتُرَى دَخيلاً في بَنيهِ دَسيسا",2,"س",2,0],["وَالْمَنْحُ وَالْمَنْعُ اعْتَبِرْ قِسْطَاسَهُ","فَالْبُخْلُ وَالتَّبْذِير مِمَّا يُرْذَلُ",3,"ل",1,0],["والمُنْتَقى منْ سرِّ هاشِمٍ في الذُّرى","حيْثُ استقرّ مدى الفَخارِ صُعودا",4,"د",2,0],["وَالمُنعِمون المُفضِلونَ إِذا شَتَوا","وَالضارِبون عِلاوَةَ الجَبّارِ",5,"ر",1,0],["وَالمَنَايَا فِي كُلِّ مَا دَبَّ لا تُبْ","دِي حَرَاكاً وَلا تُرِي أجْرَامَا",6,"م",2,0],["والمنتقى من جوهر الفخر الذي","فاق الخلائف عزةً وجمالا",7,"ل",2,0],["والمنشئ اللفظ تبراً طيّ أنعمه","وكلّ جيدٍ بها أو مسمع حالي",8,"ل",2,0],["وَالمُنى تَنبُتُ في دَربي وَتَمشي رِكابي","أَنا لَم أَضجَر مِنَ العَيش وَلَم أَملُل صِحابي",9,"ب",2,0],["وَالمَنايا تَحومُ حَولَ الَرايا","حَومَةَ العاشِقينَ حَولَ الغيدِ",10,"د",1,0],["وَالمَنهَلُ الرائِقُ العَذبُ الوُرودِ فَمَن","لا يَستَقي مِنهُ دامَ الدَهرَ عَطشانا",11,"ن",2,0],["وَالمُنتَمي لِلمَجدِ في ال","قَومِ الَّذينَ لَهُم صَريحُه",12,"ح",2,0],["وَالمَنايا مُحيطَةٌ وَحُصونُ الرو","سِ تَحمي الطَريقَ وَالأَلغامُ",13,"م",1,0],["وَالمَنايا مَواثِلٌ وَأَنوشَر","وانَ يُزجى الصُفوفَ تَحتَ الدِرَفسِ",14,"س",1,0],["والمَنايا الحُمْرُ في ساحَتِه","ماثلاتٌ بين وَمْضٍ وزَجَلْ",15,"ل",1,0],["وَالمَنايا تَأتي عَلى كُلِّ شَيءٍ","وَالبَلى مُرصَدٌ لِكُلِّ جَديدِ",16,"د",1,0],["وَالمَنايا رَوائِحٌ وَغَوادٍ","كُلَّ يَومٍ لَها سَحابٌ مَطيرُ",17,"ر",1,0],["والمنايا كالمُشْفِقاتِ تُنادي","بِبَنيها حَذارِ منه حذارِ",18,"ر",1,0],["والمنذرُ اتَّخذَ السّبيلَ مُسدَّداً","قَبْلَ الكتابِ يُخِبُّ فيه ويُوجِفُ",19,"ف",1,0],["وَالمُنتَضى أَسَدٌ وَكُرزُ قَبيلَةٍ","فَنِجارُ ضِئضِئِكُم كَخَيرِ نِجارِ",20,"ر",1,0],["والمُنْحَمنَّا لا تَشْكُّوا إنْ أتَى","لَكُمُ فليسَ مَجِيئُهُ مَجْهُولا",21,"ل",2,0],["والمُنى أنتَ إذا دُمْتَ لنا","دامتِ النَّعماءُ والعيشُ الرَّغَد",22,"د",1,0],["وَالمَنايا آكِلاتٌ","شارِباتٌ لِلأَنامِ",23,"م",1,0],["وَالمَنايا كَالأُسدِ تَفتَرِسُ الأَح","ياءَ جَمعاً وَلا تَعافُ الكليبا",24,"ب",2,0],["وَالمَنايا لَقَينَ بِالجَندَلِ الفَ","ظِّ ثَنايا لُقينَ بِالتَقبيلِ",25,"ل",1,0],["وَالمُنذرَ بنَ مُحرّقٍ في مُلكِهِ","وشهدتُ يَومَ هَجائِنِ النُعمانِ",26,"ن",1,0],["وَالمَنايا مَعَ الغُدُوِّ رَواحٌ","كُلَّ يَومٍ نَرَى لَهُنَّ عَقيرا",27,"ر",2,0],["والمنايا منهلٌ من مائه","دفعةً نَشربُ، أو جامًا فجاما",28,"م",2,0],["وآلمني وآلم كل حر","سؤال الدهر : أين المسلمون ؟",29,"ن",1,0],["والمُنْحَمِنَّا لا تَشُكُّوا إنْ أتَى","وَإلى المَسيحِ وَأُمِّهِ وَكَفَى بها",30,"ه",2,0],["وآلمني أني أخيذُ تفكُّرٍ","بكلَّ رخيص النفسِ خِبٍّ مُماكِر",31,"ر",1,0],["والمنايا تحوم السرايا","حومة العاشقين حول الغيد",32,"د",1,0],["والمنهل الرائق العذب الورود فمن","لا يسقي منه دام الدّهر عطشانا",33,"ن",2,0],["والمنى العاريات ألهبها","الشوق فجنّت ولوّحت بالبرود",34,"د",1,0],["والمُنْجِزُ الوعد الوفى","وأخا الممالك والحَسَبْ",35,"ب",1,0],["وَالمَندَلُ الرَطبُ في أَوطانِهِ حَطَبٌ","وَقَد يُقوَّمُ في الأَسفارِ بِالجُملِ",36,"ل",1,0],["والمُنتَضِى لِنَكالِ مَن شَقَّ العَصَا","يومَ التَّزَايُلِ بالوَشِيجِ الذَّابل",37,"ل",1,0],["وَالمُنى تمّت لدَينا في مِنى","حينَ نَرمي مِن هَوانا الجمَرات",38,"ت",1,0],["وَالمُنى مِلؤُنا","سَوفَ نَغدو في الوَرى أُسطورَةً",39,"ه",1,0],["وَالمَنهَلُ العَذبُ النَميرُ تَزاحَمَت","عُصَباً عَلى أَرجائِهِ وُرّادُهُ",40,"د",2,0],["وَالْمُنَى مَا الْمُنَى يُسَاعِدُ فِيهَا","فَلْتُسَاعِدْ دَأْباً ذَوِي التَّأْمِيلِ",41,"ل",1,0],["والمنايا مجنونةٌ لا تبالي","ذهبت بالجريء أو بالجبان",42,"ن",1,0],["وَالمُنتضي كلّ عضبٍ مِن حفيظتهِ","بِسابق الهمّ للإِعراض لا العذلِ",43,"ل",1,0],["والمنى إن بسمت","فالشعر لي طوع بناني",44,"ن",2,0],["والمنى تبسم لي السا","عة في كل مكان",44,"ن",1,0],["والمَنحلُ الآنَ قد غنَّى فَأَرْقصني","أَو قالَ مَن قالَ إنَّ الشَّيْخَ قد خَرِفَا",45,"ف",2,0],["وَالمنهل العَذب مَهما كانَ مُزدَحِماً","يَحلو وَيحمد مِنه الورد وَالصَدَرُ",46,"ر",1,0],["وَالمُنقِشُ بنُ الدَهرِ مِن فُرسانِنا","وَاِبنُ العَريفِ وَمالِكٌ وَالأَجدَعُ",47,"ع",1,1],["والمنظرُ البهرُ قد قلت إذ","نازعَ فيه البدرُ بُرْهانا",48,"ن",2,0],["والمُنتَضُونَ سيوفَهُمْ لوقائِعٍ","عَزَّتْ قناها فارِساً والرُّوما",49,"م",2,0],["والمنبِتُ الطيّب الأرومةِ في","دَوْحٍ لها المكرماتُ أفنانُ",50,"ن",1,0],["والمنعمون والثرى مقطِّبٌ","من جدبه والعامُ غضبانُ أزِلْ",51,"ل",1,0],["والمنَى والظنُّ بابٌ أبداً","تُغلَق الأيدي إذا ما فُتِحا",52,"ح",2,0],["والمنزلِ المهجورِ من أمِّ مالكٍ","أخو لوعةٍ من هجره يتذَّمم",53,"م",1,0],["والمنصل السيف واستفيد له ال","نعت من النصل أو من النصل",54,"ل",1,0],["والمنحنى ظهراً يماثلها","ومع الزيارة ينثني أصلا",55,"ل",2,0],["والمنقذ الإسلام حين تمزقت","أشلاؤه بشباة ناب أعصل",56,"ل",1,0],["والْمُنْتَقَى عِنْدِي هُوَ الْمُنْتَقَى","فَحُطْ بما أَلَّفَهُ مَخْبَرا",57,"ر",2,0],["والمنهلُ العِدُّ النميرُ وحيثما","يُدنى المَذود ويُمنحُ المحدودُ",58,"د",1,0],["وَالمُنشئ الغُرِّ الغرائبِ في النّدى","حتّى تُعلّم منه كيف الجودُ",58,"د",1,0],["والمنتهى منه إلي","ه فلا شباب ولا هرم",59,"م",1,0],["والمنى كل المنى أبداً","فوق فوق الفوق مرتفع",60,"ع",1,0],["والمُنشئُ الحَسَبَ الذي يُغنيهِ عن","شَرَفٍ تَوارَثَهُ منَ الآباءِ",61,"ا",2,0],["والمنصفون لهم أجرٌ فقد عدلوا","وحكمهم كان محض الصدق لا الكذبا",62,"ب",2,0],["وَالمَنطِقُ الفَيّاضُ أَن يَهدِرَ غَداً","يَتَدَفَّقُ الإِبداعُ مِنهُ سُيولا",63,"ل",2,0],["والمنع يولعُ ذا الهوى ويزيدهُ","كلفاً فمن بعد الارادة ما العمل",64,"ل",1,0],["والمنكر الفاشي بكم تغييره","أضحى حقيقة أيما مقرونِ",65,"ن",1,0],["والمنى نقل ومن ند","ماننا كأس وكوب",66,"ب",1,0],["والمنطوينَ بُطوناً","والمنحنينَ ظُهورا",67,"ر",2,0],["والمنايا تَبتُّ أعمارهم لمْ","ما تذرْ جيِّدا ولا مرْ ذولا",68,"ل",2,0],["والمنايا خواطف وصدى الرع","د مدو والبيض ذات امتشاق",69,"ق",1,0],["والمنجح الآمال وهي كثيرة","والمصلح الأحول وهي عظائمُ",70,"م",1,0],["والمنعم الكامل الفذ الأريب ومن","يقابل الليل ذكرا والوغى ذكرا",71,"ر",2,0],["والمنعم الغمر الذي","ما زال مشكور المساعيِ",72,"ع",2,0],["والمنايا تطل خلف كواها","في اتقاد ونزوة وازورار",73,"ر",1,0],["والمنادون حفنة في مهب الريح","تلهو بهم أكف الشقاء",74,"ا",2,0],["والمنجزين الوعد إن وعدوا","عجلى فلا مذق ولا مطل",75,"ل",1,0],["والمنقبات الباهرات محاسناً","والمحمدات المشرقات سناءَ",76,"ا",2,0],["والمنصب السامي الرفيع قد استضى","بسنا أبي المصباح سحبان الكرمْ",77,