{"poems":[[55,"يا أراك الحمى تراني أراكا","https://www.aldiwan.net/poem29922.html","الخفيف"],[95,"إن بكى الشرق فالمصاب أليم","https://www.aldiwan.net/poem11409.html","الخفيف"],[74,"بلغا القاصدين أن الليالي","https://www.aldiwan.net/poem19529.html","الخفيف"],[53,"هب على رأسك العنا","https://www.aldiwan.net/poem9249.html","مجزوء الخفيف"],[53,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[87,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[47,"أما لعيني طليح الشوق تغميض","https://www.aldiwan.net/poem64638.html","البسيط"],[101,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54274","البسيط"],[124,"قد ذهب الحول بالربيع وبالصحو","https://www.aldiwan.net/poem49287.html","المنسرح"],[146,"كل يوم خل يرحل عنا","https://www.aldiwan.net/poem58418.html","الخفيف"],[154,"أي نور كشف الله به","https://www.aldiwan.net/poem68437.html","الرمل"],[215,"أترك الشط آه بالرغم مني","https://www.aldiwan.net/poem46273.html","الخفيف"],[215,"أيها الحب وبالذكرى أراك","https://www.aldiwan.net/poem46313.html","الرمل"],[259,"دع ملامي","https://www.aldiwan.net/poem24953.html","مجزوء الرمل"],[333,"هذه دارها وتلك رباها","https://www.aldiwan.net/poem55027.html","الطويل"],[333,"رق وجه النسمات","https://www.aldiwan.net/poem55044.html","مجزوء الرمل"],[333,"رتل البلبل الطروب لحونه","https://www.aldiwan.net/poem55066.html","الخفيف"],[353,"من صفة الجوهر أن يرسبا","https://www.aldiwan.net/poem19852.html","السريع"],[409,"هل جرى مني لذا الهجر ذنوب","https://www.aldiwan.net/poem34159.html","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48696","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48660","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48846","المتقارب"],[998,"","https://poetry.dctabudhabi.ae/diwan/poem/205359",""],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138093",""],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125371","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130843",""],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205434","الخفيف"],[2889,"","https://poetry.dctabudhabi.ae/diwan/poem/122957","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74031","المنسرح"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123928","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108276","الخفيف"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66529","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216761","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205904","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29275","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40103","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83607","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83479","الخفيف"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76771","المنسرح"],[1043,"الليل والحب","https://www.poetsgate.com/ViewPoem.aspx?id=89659",""],[5431,"وحده الموتُ مخْلصٌ بالحفاظِ!!","https://www.poetsgate.com/ViewPoem.aspx?id=200775",""],[5616,"أحوال","https://www.poetsgate.com/ViewPoem.aspx?id=205244",""],[5691,"أشهد اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=206120",""],[402,"غلب الموت فالحياة ثكول","https://www.poetsgate.com/ViewPoem.aspx?id=36544",""],[5943,"كِبْرُكَ الخدَّاعُ مانعْ","https://www.poetsgate.com/ViewPoem.aspx?id=11261",""],[5396,"المسافر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65510&r=&rc=9",""]],"verses":[["أَيُّ نورٍ لِناظِرَيَّ إِذا ما","مَرَّ يَومٌ وَناظِري لا يَراكا",0,"ك",2,0],["أَيْنَ وَاعِي اللُّغَاتِ مُخْتَلِفَاتٍ","لَمْ يَفُتْهُ مِنْهَا اللُّبَابُ الصَّمِيمُ",1,"م",1,0],["أين ولَّى بحر العلوم وأبقى","بين أجفاننا الدُّموع لآلي",2,"ل",2,0],["أين وجْهٌ كأنه","عَدِمَ الرّوحَ والفرَجْ",3,"ج",1,0],["أيُّ نومِ من بعد ما حل بالبصْ","رَةِ من تلكمُ الهناتِ العظام",4,"م",1,0],["أيُّ نومٍ من بعد ما انتهك الزّنْ","جُ جهاراً محارمَ الإسلام",4,"م",1,0],["أَينَ وادي الطَلحِ وَاللائي بِهِ","مِن دُمىً يَسحَبنَ في المِسكِ الحِبَر",5,"ر",1,0],["أَيُّ نَوالَيكَ لَم تُزهِر كَواكِبُهُ","بِغالُكَ الشُهبُ أَم أَوراقُكَ البيضُ",6,"ض",1,0],["أين وجهٌ في الأعظمية حلوٌ","لو رأته تغار منه السماء؟",7,"ا",2,0],["أين وَلّى لقد رمانا بِسحرٍ","فَسَكِرْنا وما شَرِبنا الخمورا",8,"ر",2,0],["أيَّ نُورٍ وَأيَّ نَوْرٍ شَهِدْنا","يَوْمَ أَبْدَت لَنا القِبَابَ قُباءُ",9,"ا",2,0],["أين وادي النخيلِ أم","قاهريَّاتُه الغُرَرْ",10,"ر",1,0],["أَي نَوْحٍ يَفِي بِحَقِّ امْرِيءٍ كَا","نَ عَلَيْهِ لأُمَّةٍ تَعْوِيلُ",11,"ل",1,0],["أين ورودي وأين كأسي","ماذا دَهى الكأس والورودا",12,"د",2,0],["أين وهل ينفع اللهيف أسىً","يزيد وجه الحياة تقطيبا",13,"ب",2,0],["أيّ نور أَطفأتَ يا مُهَريقَ ال","ماء فوق الجسم الكلَّل حُسنا",14,"ن",2,0],["أيّ نور كشف الله به","سدف الباطل عنا أجمعين",15,"ن",1,1],["أين ولين أين أين أجبني","يا نديمي بالروح والآمال",16,"ل",1,0],["أين وجه الإثم فيما تقرأون","من غنائي وهو شدوٌ بالخلود",17,"د",1,0],["أين ودّي، أين عطفي","كل شيء عنك غابا!",18,"ب",2,0],["اينَ ولّى عنك الصبا وهو سوقٌ","للغواني كسبنَهُ وخسِرتِ",19,"ت",1,0],["أين واحات من الصفو","نمتها الصبوات",20,"ت",1,0],["أي نور جلا الغزالة في رأ","د ضحاها بمثل نور المدينه",21,"ن",2,0],["أَينَ وَفَاءُ النِيلِ أَمْ لَيْسَ ذا","زَمانَهُ شَاء الفَتَى أَو أَبى",22,"ب",2,0],["أين وجه باسم غيبته","لا لوجه ماله وجه قطوب",23,"ب",1,0],["أينوّلُ الدستورَ قيصرُ قومَه","وتقوم فينا تستبد وترهب",24,"ب",1,0],["أئِنُّ وأشكو أنني غير مالك","لدى معشرٍ في مصر بسطاً ولا قبضا",25,"ض",2,0],["أينوي الفتى عملاً صالحاً","ويرجوه بالسبب الفاسد",26,"د",1,0],["أين وزاراتك الهوادي","أين إماراتك الصعود",27,"د",1,0],["أين وجه الحبيب ينفي شجىَّ النف","س ويحيى بين الضلوع الغراما",28,"م",2,0],["أينَ وَلَّى ذاك الهَتُونُ وَخَلَّى","مِصرَ تَخشى طوارئ الحدثانِ",29,"ن",1,0],["أين وادي النيل والنيلُ معاً","أعلى يقطينة مستوطن",30,"ن",1,0],["أين وحي الخيال والوجدان","يستقي منه خاطري وبياني",31,"ن",2,1],["أئن ومن أهواه يسمع أنتي","ويدعو غرامي وجده فيجيب",32,"ب",1,0],["أَي نواح يَبكي له أَسَفاً","أَنوحُ حِبّ أَم نوح وَرقاءِ",33,"ا",2,0],["أين وجدانك الشريف","وما ذا الذي وجد",34,"د",1,0],["أي نور من حسن باريس لاحَا","أي عرف من الكواعب فاحا",35,"ح",2,1],["أين وجه من الغمام عبوس","من محيّا للبشر يحكي الصباحا",36,"ح",2,0],["أيُّ نور أزاغ لحظ العيون","حين شق الدجى بصبح مبين",37,"ن",1,1],["أين وجه يملأ العين سَنَى","من وجوه كانطباق الغَيْهَبِ",38,"ب",1,0],["أيُّ نُورٍ بِذَاكَ ضَاءَ لَدَينَا","وَرَأينَا آياتهِ فَاهتدَينَا",39,"ن",2,0],["أينَ ودِّيَ يَومَ يُكشَفُ عَن سا","قٍ يَزولُ عَمَّا جَنَينَا الغِطاءُ",40,"ا",2,0],["أَيُّ نورٍ هذا الَّذي يَبهَرُ الأُف","قَ وَيَزهو مُغَشِّيا جَنَباتِهِ",41,"ه",1,1],["أَينَ وَجهُ الكَسْبِ الَّذي أَنا فيهِ","مِن وُجوهُ التُّجَّار والأعيانِ",42,"ن",1,0],["أَيُّ نورٍ قَد ضاءَ مِنهُ الوُجودُ","كُلُّ نورٍ من نورِهِ مَمدودُ",43,"د",1,1],["أَين وادي العقيق وَالركبُ فيه","أَينَ عُربٌ حطّوا لدَيه وَشالوا",44,"ل",3,0],["أَينَ وَميضُ البُروقِ مِن لَهَفي","وَأَينَ عَصف الرِياحِ مِن قَلَقِي",45,"ق",2,0],["أين وجه الحبيب ينفي شجيَّ النف","س ويحي بين الضلوع الغراما",46,"م",2,0],["أين وقتي؟ كأنه ضاع مني!","في منامٍ معاندٍ إيقاظي!",47,"ظ",2,0],["أينَ وردٌ قطفْتُهُ يا حبيبي","ونجومٌ في كفِّنا ما تزالُ؟",48,"ل",1,0],["أيْنَ واشِنْطُنُ منْ أمْجادِها","حِقَباً لمْ تحْيَها واشِنْطُنُ ؟!",49,"ن",1,0],["أي نوح يفي بحق امرئ كان","عليه لأمة تعويل",50,"ل",1,0],["أيُّ نورٍ ترتجيهِ","في ظلامِ الكفرِ قابِعْ",51,"ع",1,0],["أين ولىّ أين يا شمس وهل","من لظى عينيك تحميه الظلال",52,"ل",1,0],["أين ولىّ أين يا ريح وهل","حين تشتدّين تأويه الجبال",52,"ل",1,0],["أين ولىّ أين يا سحب قفي","واسمعي منه أغانيه الطوال",52,"ل",1,0]]}