","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27944","الطويل"],[2224,"","https://poetry.dctabudhabi.ae/diwan/poem/126363","الخفيف"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132384","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205045","الخفيف"],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142907","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205717","الرمل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44908","الخفيف"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101371","الوافر"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76718","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52133","الرمل"],[4699,"عيونها الحسناء","https://www.poetsgate.com/ViewPoem.aspx?id=193396",""],[4712,"يداويني حبيبي لا طبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=202611",""],[4869,"جليس الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=151559",""],[4877,"يخون الود","https://www.poetsgate.com/ViewPoem.aspx?id=29453",""],[4877,"باين عليك","https://www.poetsgate.com/ViewPoem.aspx?id=30102",""],[4916,"اصول القياده","https://www.poetsgate.com/ViewPoem.aspx?id=136694",""],[5186,"من مغيثي، من منصفي، من مجيري؟","https://www.poetsgate.com/ViewPoem.aspx?id=156554",""],[5353,"صدى صمتي","https://www.poetsgate.com/ViewPoem.aspx?id=212457",""],[5370,"طفولة","https://www.poetsgate.com/ViewPoem.aspx?id=81393",""],[5464,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=772",""],[5536,"وش سوى الغياب؟!!","https://www.poetsgate.com/ViewPoem.aspx?id=22593",""],[5536,"أبناء السبيل!!","https://www.poetsgate.com/ViewPoem.aspx?id=22609",""],[5573,"اتعبني التقسيم والطرح والضرب","https://www.poetsgate.com/ViewPoem.aspx?id=200090",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5616,"صرخة","https://www.poetsgate.com/ViewPoem.aspx?id=204843",""],[5628,"لست شاكيا","https://www.poetsgate.com/ViewPoem.aspx?id=178488",""],[5664,"هدير الماء","https://www.poetsgate.com/ViewPoem.aspx?id=176679",""],[5694,"أنا عبدك المحتاج","https://www.poetsgate.com/ViewPoem.aspx?id=129868",""],[402,"سنحت فرصة لقالة حق","https://www.poetsgate.com/ViewPoem.aspx?id=35703",""],[5848,"الحاضرين يعلمون الغايبين","https://www.poetsgate.com/ViewPoem.aspx?id=48989",""],[5848,"الحب الكبير","https://www.poetsgate.com/ViewPoem.aspx?id=53461",""],[5956,"افتحي المذياع","https://www.poetsgate.com/ViewPoem.aspx?id=182318",""],[5956,"في اعتقادي","https://www.poetsgate.com/ViewPoem.aspx?id=184323",""],[5956,"أقصوصة بغلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=204061",""],[4701,"بلاغة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87361&r=&rc=1",""]],"verses":[["أنا ادري بأنهم بعد هجري","لم يذوقوا غمضا ولم يرتاحوا",0,"ح",3,0],["أنا أدري بأنَّ لي من سناها","في الجبينِ طالعاً قمريّا",1,"ي",2,0],["أَنا آدَمِيٌّ كانَ يَحسَبُ أَنَّهُ","هُوَ الكائِنُ الأَسمى وَشُرعَتُهُ الفُضلى",2,"ل",2,0],["أَنا أَدري بِأَنَّني","قَلَّ قِسمي لَدَيكُمُ",3,"م",1,1],["أَنا أَدرانِيَ الرَشادُ بِأَنَّ الإِن","سَ مَخلوقَةٌ مِنَ الأَدرانِ",4,"ن",1,0],["أَنَا أَدْرِي إِنْ كَانَ غيْرِيَ لَم يَدْ","رِ وَهَلْ مِنْ مُنَبِّيءٍ كَخَبِيرِ",5,"ر",1,0],["أَنَا أَدْرِي مَنِ الْفَتَى حِينَ يَدْعُو","صَارِخُ الْحَقِّ فِي المَقَامِ الْخَطِيرِ",5,"ر",1,0],["أَنا أَدْرِي مَا مُصْطَفَى مَا مَزَايا","ذلِك العَالِمِ الْحَصِيفِ الْقَدِيرِ",5,"ر",1,0],["أنا أدري بالطيرِ حين تغنّي","كم جراح سالت على الأعواد",6,"د",1,0],["أَنا أَدري بأنّي لستُ أهلاً","غيرَ أنّي على نداكم طريحُ",7,"ح",1,0],["أَنا أدريكَ سابق المدحِ مهما","بالَغت في مديحكَ البلغاءُ",8,"ا",2,0],["أنا أدري أنا أدرى ما تريد","وضمير الصب شيطانٌ مريد",9,"د",1,0],["أنا أدرى بما عنيت من القو","ل وقلبي لوحيك النزل",10,"ل",1,0],["أنا أدعو من دعاني","هكذا حكم القضيه",11,"ه",1,0],["أَنا أَدري بِسَناهُ","وَمَزاياهُ الغَزيرُهُ",12,"ر",2,0],["أنا أدخرناكَ للجَّلى فهل خُدعت","عقولنا أم بدأت اليوم تخدعُها",13,"ع",3,0],["أنا أدري بأنَّ ألْويَتي","نِصفُها في الرّياح ِيَرتَعِد ُ",14,"د",1,0],["أنا أدري بأنَّ لي سُفُناً","فُقِد َتْ في عِدادِ مَن فُقِدوا",14,"د",3,0],["أنا أدري بأنَّ بي وَرَماً","مُنذ ُخَمسين وهوَ يَطَّرِد ُ",14,"د",1,0],["أنا أدري ، أدري بأنَّ دَمي","في الشَّرايين باتَ يَتَّقِد ُ",14,"د",1,0],["أنا أُدعى بالتَّطيرا","كِدتُ مِن نَزقٍ أطيرا",15,"ر",2,1],["أنا أدرى كنه ذاته","مع أني من صفاته",16,"ت",2,1],["أنا أدرى يا عذولي بالذي","يؤلم النفس ويصليها ضراما",17,"م",2,0],["أَنا أَدري بِأَنَّني لَستُ أَهلاً","غَيرَ أَنّي عَلى نَداكُم طَريحُ",18,"ح",1,0],["أنا أدري أنت الوجود ولا ب","د لهذا الوجود من ثور حامل",19,"ل",1,0],["أَنا أَدري أَنّي المُسيءُ وَأنّي","كنت فيه مجاوِزاً للحُدودِ",20,"د",1,0],["أنا أدرت برأيي","ناعورة الخذلان",21,"ن",1,0],["أنا أدنى إليك منك ولولا","وصلتي لم تكن إليّ وصولا",22,"ل",2,0],["أنا آدمي في الرُّواءِ حَقيقتي","مَلَكٌ تَعيَّن ذاك للمُسَتبصِر",23,"ر",1,0],["أنا أدعو لسفور وهي إن","سَفَرَتْ بانت كأن لم تُوجَدَ",24,"د",1,0],["أَنا أَدْري أَنِّي وإِنْ كُنْتُ أَدْري","ليس يعلو إلى صِفاتك قَدْري",25,"ر",2,1],["أنا أدرى بما ألاقي في ي","وم معاد من اللطيف الخبير",26,"ر",1,0],["أنا آدمُ الأسماءِ لا آدمُ النشء","فلي في السما والأرض ما كان من خبءِ",27,"ا",1,1],["أنا أدرى به ولكن صونا","أتعامى عنه وأبدي جهاله",28,"ل",2,0],["أنا أدري بذاك منك ولكن","عند عذولي كتمتُها والشاني",29,"ن",2,0],["أنا أدرى بلؤم أبناء جنسي","فأرى لؤمهم بلا استغراب",30,"ب",1,0],["أنا أدري بكل ذاك وقلبي","موقن، وهو لا يحسُّ ارتيابا",31,"ب",2,0],["أنا أدرى بك من نفسك يا","طاهر النية في كلِّ الأمور",32,"ر",1,0],["أَنا أَدري بِكُلِّ هَذي الأَحاجي","لَستُ في حاجةٍ إِلى الاسهابِ",33,"ب",1,0],["أنا أدري بدائي فهو ضعف ال","سواعد عن صراع الأقوياء",34,"ا",2,0],["أنا أدرى بفضلك منك أني","لبست الظلّ منه في الحرور",35,"ر",1,0],["أنا أدرى بالفؤاد المولَعِ","وبأهل الحبّ لي قلبٌ خبير",36,"ر",1,0],["أنا آدمٌ في وحشتي وتفردي","وأنا كيونسَ والدجى عتماء",37,"ا",2,0],["أنا أدرى بنفسي، صدّقوني..","سأشرح عِلَّتي حَرفًا فحَرفا",38,"ف",2,0],["انا ادري انّه يارب مْن القدر والقضى","بس الدعا يتبعه حالٍ على مايُرآم",39,"م",1,0],["أنا أدري وين هالأيام والطيبة توديني","على الله تضحك الدنيا وتصدق بعض هقواتي",40,"ت",2,0],["انا ادري انك نسفتيني.. وتلفتيني","مهما خسرتي معايه دوم ربحانه",41,"ن",2,0],["أنا ادري .. انّك من عراويك .. ممزوع",".وادري بأنك حيّ .. مابك بلاده",42,"د",2,0],["\"أنا أدعى \"\"محمد بن شعيب\"\"\"","\"وأكنى با \"\"العاملي\"\" الكبير\"",43,"ر",1,0],["أنا أدري أنَّ باباً موصَدا","سيؤولُ الدَّربُ منه المبتدى",44,"د",2,0],["أنا ادري عن الترحال عادة مع البدوان","ولكن غريبة كيف تهجر أراضيها؟",45,"ي",3,0],["أنا أدري أنَّ بيْ من شَغَفٍ","لبساتينكَ بعضاً من خَبَلْ",46,"ل",1,0],["انا ادري ان الحظ جابك والسفر ودى وجاب","الله يبيض وجه حظي حيثما راح وظعن",47,"ن",1,0],["انا ادري انك تبكي احبابٍ تناسوك ونسوك","وانا بكاي العاديات الصبح والسيف الصقيل",48,"ل",1,0],["انا ادعي الله خالق العُجم والعُرب","والكون واللي ماادركته المدارك",49,"ك",1,0],["انا ادعي لوجه الخيربه به دوم نلتقي","انا والذي عاقد ليا جيت حاجبه",50,"ب",2,0],["أنا أدري بأنَّ شعريَ لَغوٌ","وبه هذهِ الصدورُ تضيقُ",51,"ق",1,0],["أنا أَدري بأنهُ غيرُ مُجدٍ","بقوافيهِ لا تُشَقُّ طَريقُ",51,"ق",1,0],["أنا أدري أنّ الطريقَ طويلٌ","مظلمُ الأفْق دونهُ عقَبَاتُ",52,"ت",1,0],["انا ادري وجه كل هذي الصور ياصاحبي ذبلان","ولكن تلقى من باقي ملامحهم ورى اشجاني",53,"ن",2,0],["أنا أدعوك ياعالم بغيب الليال السود","تغفر الذنوب اللي لها فالكتاب شهود",54,"د",1,1],["أنا أدري إن كان غيري مل يدر","وهل من منبيء كخبير",55,"ر",1,0],["انا ادري انك كاملٍ بالزين يوم الله عطاك","زينك لحال ولا معك فالزين يا زين خشرا",56,"ر",2,0],["انا ادري ان الحب ما بين المحاني ما خفاك","وادري بأنه ما يجي له حاجةٍ مما لديك",57,"ك",1,0],["أنا أدري كيف أشري","قلبَ شقرائي وأظفرْ",58,"ر",1,0],["أَنَا أدري كم فؤادي في انجذابٍ","لإخاءِ الناسِ.. أدرِي حَدَّهُ",59,"د",2,0],["أنا أدريه تماماً","لم أكنْ عنه بغفلةْ",60,"ل",2,0],["أنا أدخل المأساةَ من أبوابها","كي أنتهي أو تنتهي مأساتي",61,"ت",2,0]]}