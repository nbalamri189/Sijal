{"poems":[[95,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[89,"يا ناعس الطرف إلى كم تنام","https://www.aldiwan.net/poem8287.html","السريع"],[42,"حور بعثن رسولا في ملاطفة","https://www.aldiwan.net/poem42344.html","البسيط"],[447,"يا من له وسط الفؤاد","https://www.aldiwan.net/poem14306.html","مجزوء الكامل"],[447,"دع الخمول وخل المقت والكبلا","https://www.aldiwan.net/poem14430.html","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77619","الرجز"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[2188,"","https://poetry.dctabudhabi.ae/diwan/poem/20919","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27640","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68025","الرجز"],[5956,"لو كنتَ تعرف ما الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=182193",""],[5956,"أدوية","https://www.poetsgate.com/ViewPoem.aspx?id=183877",""],[2220,"حمداً الإلهِ يقدسُ الأرواحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11263&r=&rc=137",""]],"verses":[["حتَّى أوَانُ اللَّهْوِ يَشْغَلُهُ بِمَا","فِيهِ لأَشْرَفِ خُطَّةٍ تَتْمِيمُ",0,"م",1,0],["حَتَّى أُوَافِي مِصْرَ فِي لَحْظَةٍ","أَقْضِي بِهَا فِي الْحُبِّ حَقَّ الذِّمَامْ",1,"م",1,0],["حَتّى أَوَيتُ إلى بِيضٍ تَرائِبُها","مِن زَيِّها الحَليُ وَالحنّاءُ وَالكَتَمُ",2,"م",1,0],["حَتّى أَوَيتُ إِلى طِرفٍ بِرابِيَةٍ","كَأَنَّهُ مُعرَضاً مِن ساعَةٍ عَلَمُ",2,"م",1,0],["حتى أوافيه لدي","كم والعدو متعس",3,"س",1,0],["حتى أَوافي بها داراً أَكون بها","عزيز قوم وعرضي المحض ما نُعلا",4,"ل",2,0],["حَتّى أَوى بِنا إِلى مَحَلِّهِ","ما بَينَ قَومه وَبَينَ أَهلِهِ",5,"ه",1,0],["حتَّى أُوَارَى بَينَ أثنَاءِ الجثَى","أنَا الَّذِي يَفيضُ سَيحُ هَتنِهِ",6,"ه",1,0],["حَتّى أُوَدِّيَها إِلى ال","مَلِكِ الهُمامِ بِذي الثَوِيَّه",7,"ي",2,0],["حتى أوافي الضدّ صحبةَ عاشقٍ","وأُجانب العذالَ والمنصاحا",8,"ح",2,0],["حَتَّى أُوافِي جنة","محفوفة بالنِّعم",9,"م",1,0],["حتى أوشّي الأفق والأبعاد من","أطياف حُسْنك والبراءةِ مُخْملا",10,"ل",2,0],["حتى أواصلَ خدمتي لبسيطتي","لا سيّما لمن ارتضَوا بالتوعيةْ",11,"ي",2,0],["حتى أوافي الضدَّ صحبة َ عاشقٍ","وأجانبَ العدَّالَ والمنصاحا",12,"ح",2,0]]}