{"poems":[[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79538","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44632","البسيط"],[5277,"مقهى البيروتي.. ذاكرة المكان..","https://www.poetsgate.com/ViewPoem.aspx?id=185251",""],[5387,"غرناطة","https://www.poetsgate.com/ViewPoem.aspx?id=83393",""]],"verses":[["هذي زرنجُ استغلقت وتمنَّعَتْ","فكأنَّها إلاّ عليكَ حرامُ",0,"م",1,0],["هذِي زَنَادِقَةَ العِبَادِ جَمِيعَهُم","وَمُصَنَّفَاتُهُم بِكُلِّ مَكَانِ",1,"ن",1,0],["هَذِي زِيَارَةٌ مَن غَدا مُتَمَسِّكاً","بِشَرِيعَةِ الإِسلاَمِ والإِيمَانِ",1,"ن",1,0],["هَذِي زِيَارَتُنا وَلَم نُنكِر سِوَى ال","بِدَعِ المُضِلَّةِ يَا أولِي العُدوانِ",1,"ن",1,0],["هَذي زِيارَتكُم مِن خَيرِ رابطةٍ","في الحُبِ بَينَ بَني الخَضراءِ وَالنيلِ",2,"ل",1,0],["هذي زبيدةُ مَنْ يحمي محارمَها","قُدّتْ مفاتنُها ممَّا جرى فيهِ",3,"ي",2,0],["هذي زخارفهم ورسم خطوطهم","ملئَ المكانِ تمائمٌ وكُتوبُ",4,"ب",1,0]]}