{"poems":[[55,"اسقني فاليوم نشوان","https://www.aldiwan.net/poem29667.html","المديد"],[55,"وقف على العبرات هذا الناظر","https://www.aldiwan.net/poem30472.html","الكامل"],[55,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[79,"النصر نصك والحسام دليله","https://www.aldiwan.net/poem36377.html","الكامل"],[79,"كفلت عنايتك الجميلة","https://www.aldiwan.net/poem36466.html","مجزوء الكامل"],[75,"إعجب لحال السرو كيف تحال","https://www.aldiwan.net/poem11939.html","الكامل"],[85,"طلع الهلال وأفقه متهلل","https://www.aldiwan.net/poem54255.html","الكامل"],[53,"ما أستزيد لقاسم من ربه غير البقاء","https://www.aldiwan.net/poem7960.html","مجزوء الكامل"],[53,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[53,"أنهضه في أوان إنهاضه","https://www.aldiwan.net/poem64941.html","المنسرح"],[53,"غدا الدهر مفترا أغر المضاحك","https://www.aldiwan.net/poem65812.html","الطويل"],[45,"إني لأعلم واللبيب خبير","https://www.aldiwan.net/poem9573.html","الكامل"],[47,"يا أبا جعفر غدونا حديثا","https://www.aldiwan.net/poem64636.html","الخفيف"],[47,"عزمت على المنازل أن تبينا","https://www.aldiwan.net/poem66674.html","الوافر"],[60,"أحسين إني واعظ ومؤدب","https://www.aldiwan.net/poem31150.html","الكامل"],[68,"لا عبد يغني عنه ولا ولد","https://www.aldiwan.net/poem40130.html","المنسرح"],[68,"كرر اللوم عليه إن تشا","https://www.aldiwan.net/poem40645.html","الرمل"],[68,"كيف الضلال وصبح وجهك مشرق","https://www.aldiwan.net/poem41374.html","الكامل"],[89,"لا تركنن إلى الزمان فربما","https://www.aldiwan.net/poem8361.html","الكامل"],[71,"رب فلاح مليح","https://www.aldiwan.net/poem28409.html","مجزوء الرمل"],[83,"يوم تضاحك نوره الوضاء","https://www.aldiwan.net/poem61561.html","الكامل"],[77,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16690","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54945","الكامل"],[108,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[53,"غدا الدهرُ مفترّاً أغرَّ المضاحِكِ","https://www.poetsgate.com/ViewPoem.aspx?id=30096",""],[147,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[147,"هل غير ظلك للعفاة مقيل","https://www.aldiwan.net/poem11791.html","الكامل"],[147,"ما نرى للثناء عنك عدولا","https://www.aldiwan.net/poem11801.html","الخفيف"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[240,"عد نصحا ملامي العذال","https://www.aldiwan.net/poem31788.html","الخفيف"],[240,"خجلت من عطائك الأنواء","https://www.aldiwan.net/poem32200.html","الخفيف"],[266,"كف العتاب فما يمل العاتب","https://www.aldiwan.net/poem38371.html","الكامل"],[280,"مهج تساق إلى الردى فتشاق","https://www.aldiwan.net/poem25476.html","الكامل"],[285,"يا حسنه قمرا وأنت سماؤه","https://www.aldiwan.net/poem60576.html","الكامل"],[287,"عسى الدهر أن ينتاشني ولعله","https://www.aldiwan.net/poem32650.html","الطويل"],[308,"كفلت حمل غرامي","https://www.aldiwan.net/poem57544.html","المجتث"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[343,"كفلت لطالب الدنيا بهم","https://www.aldiwan.net/poem68734.html","السريع"],[371,"سأل اللوى وسؤاله تعليل","https://www.aldiwan.net/poem17329.html","الكامل"],[409,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[443,"أرأيت ما صنعت لحاظ الغيد","https://www.aldiwan.net/poem2612.html","الكامل"],[458,"هذا الوجود كما تراه فلم يكن","https://www.aldiwan.net/poem61321.html","الكامل"],[463,"من راكب تنجو به ممسوسة","https://www.aldiwan.net/poem55832.html","الكامل"],[463,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[463,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[463,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[469,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[469,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[469,"فؤاد أطاع الوجد بين المعالم","https://www.aldiwan.net/poem3488.html","عموديه"],[469,"ذاك سلع فاندب معي أطلاله","https://www.aldiwan.net/poem3614.html","عموديه"],[505,"وحي السماء منزل ببيوتنا","https://www.aldiwan.net/poem37804.html","الكامل"],[520,"تهن بأعياد غدا بك فخرها","https://www.aldiwan.net/poem12125.html","الطويل"],[520,"هل تعلمان طريقة لم تطرق","https://www.aldiwan.net/poem12186.html","الكامل"],[520,"عنان الليالي في يديك مسلم","https://www.aldiwan.net/poem12275.html","الطويل"],[543,"نلت عطفي وحناني","https://www.aldiwan.net/poem47925.html","عموديه"],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198606","البسيط"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53756","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119977","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126148","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64830","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95561","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95599","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79843","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79805","الخفيف"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127963","الخفيف"],[1742,"","https://poetry.dctabudhabi.ae/diwan/poem/127878","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71040","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53237","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53205","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53174","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53030","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53103","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53044","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93555","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137256",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137092",""],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109809","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201219","المنسرح"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97909","الرمل"],[3723,"","https://poetry.dctabudhabi.ae/diwan/poem/146011","الرجز"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128897","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131258",""],[4048,"","https://poetry.dctabudhabi.ae/diwan/poem/110653","الكامل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93257","الكامل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93292","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54478","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54462","الكامل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136420",""],[4601,"","https://poetry.dctabudhabi.ae/diwan/poem/147767","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139521",""],[5087,"أيها اللائمي لحبي عليا","https://www.poetsgate.com/ViewPoem.aspx?id=96364",""],[5145,"رحلوا بقلبك عرّجوا أم ساروا","https://www.poetsgate.com/ViewPoem.aspx?id=108063",""],[5437,"وقت الحصيله","https://www.poetsgate.com/ViewPoem.aspx?id=144441",""],[6031,"عَاطِنيها قبلَ ابتِسَامِ الصَّبَاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=46257",""],[463,"أمنها على أنّ المزارَ بعيدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60037&r=&rc=93",""]],"verses":[["كَفَلَت بِاللَهوِ وافِيَةً","لَكَ ناياتٌ وَعيدانُ",0,"ن",1,0],["كَفَلَ البَقاءَ بِنَفسِهِ فَلَوِ اِنقَضى","ذا الدَهرُ عاوَدَهُ الزَمانُ الغابِرُ",1,"ر",1,0],["كَفَلَت بِأَنفُسِنا وَهَل","طِفلٌ يَعيشُ بِغَيرِ ظيرِ",2,"ر",1,0],["كَفَلَتْ رِيَاضُ الْمُلْكِ مِنْك بِدَوْحِهَا","فَرْعاً نَضِيراً لاَ يُخَافُ ذُبُولُهُ",3,"ل",2,0],["كَفَلَتْ عِنايَتُكَ الجَميْ","لَةُ لي بإحْرازِ الوَطَرْ",4,"ر",1,1],["كَفَلَ الوَزيرُ أَبو الوَليدَ بِجَبرِهِم","إِنَّ الوَزيرَ لِمِثلِها فَعّالُ",5,"ل",1,0],["كفل الخلافة منك يا ملك العلا","واللهُ جلاَّ جلالهُ لكَ أكفلُ",6,"ل",1,0],["كفِلتْ بكبتٍ للعِدا","ومسرةٍ للأصدقاءِ",7,"ق",3,0],["كَفُلانٍ في دحْسهِ وفُلانٍ","ولتلْكَ التِّراتِ يوماً طَلُوبُ",8,"ب",1,0],["كفُلتَ هذا الأنام تُقرضُهُم","عُرفاً إلى الله شكرَ إقراضه",9,"ض",2,0],["كفلْنَ لنا لمَّا اصطفَفْنَ حيالنا","بترحيل أضيافِ الهُمومِ السّوادك",10,"ك",1,0],["كَفَلَ الثَناءُ لَهُ بِرَدِّ حَياتِهِ","لَمّا اِنطَوى فَكَأَنَّهُ مَنشورُ",11,"ر",1,0],["كَفَلاً ناعِماً وَكَشحاً لَطيفاً","وَقَواماً لَدناً وَطَرفاً غَضيضا",12,"ض",2,0],["كَفَلتُ بِنُجحِ سارِيَةِ المَطايا","إِذا أَسرَت إِلى أَذكوتِكينا",13,"ن",2,0],["كَفِلَ الإِلَهُ بِرِزقِ كُلِ بَرِيَّةٍ","وَالمالُ عارِيَةٌ تَجيءُ وَتَذهَبُ",14,"ب",1,0],["كَفَلتُهُ يافِعاً فَكُنتُ لَهُ","كَالوالِدِ البِرِّ وَهوَ لي وَلَدُ",15,"د",1,0],["كَفَلَ الأَيّامَ إِلّا أَنَّهُ","أَيتَمَ الأَطفالَ لَمّا بَطَشا",16,"ش",2,0],["كَفٌّ لِما حَفِظَ اليَراعُ مُضيعَةٌ","وَلِما تُجَمَّعُهُ الصِفاحُ تُفَرِّقُ",17,"ق",1,0],["كَفَلَ الشَّقَاءَ لِمَنْ أَنَاخَ بِرَبْعِهِ","وَكَفَى ابْنَ آدَمَ بِالْمَصَائِبِ كَافِلا",18,"ل",2,0],["كفليَ أضعفَ خصري","فأعينوني بقوَّهْ",19,"ه",1,0],["كَفلَ الوَرى فَلَهُ إِلى خَلّاتِهِم","نَظَرٌ وَعَن زَلّاتِهِم إِغضاءُ",20,"ا",2,0],["كفَلنَ لنا بظِلالِ الخِيام","وأكفَلنَنَا بظِلالِ القَنا",21,"ا",1,0],["كفِلْذٍ من سَماءِ الِله مُلْقىً","يُهِلّ بمِثْلِهِ رَكْبُ السّماوَه",22,"ا",3,0],["كَفِلتْ لَهُ عُقْبَى النَّجَاحِ المُرْتَجَى","أُولى التَّجَارِبِ فِي الشَّبَابِ النَّاضِرِ",23,"ر",1,0],["كفلَتْ لهم عَزَماتُهم","لا مجلسُ الأمنِ النجاح",24,"ح",1,0],["كفلْنَ لنا لمَّا اصطفَفْنَ حيالنا","بترحيل أضيافِ الهُمزمِ السّوادك",25,"ك",1,0],["كَفَلَت لِكُلِّ تَنوفَةٍ مَرّوا بِها","أَلّا تَجوعَ ذِئابُها وَالأَضبُعُ",26,"ع",1,0],["كَفَلَت لَها أَعناقُها وَعُروقُها","بِالسَبقِ وَالطِرفُ الطَموحُ رَسيلُ",27,"ل",1,0],["كَفَّ لَمّا اِستُثيبَ كَفَّ الغَوادي","وَكَفى المُمحِلاتِ لَمّا اِستُنيلا",28,"ل",2,0],["كَفلتهُ البيضُ اليمانونَ من قب","لُ فأدّى الكفالة الكفلاءُ",29,"ا",2,0],["كَفِلَت أَنَّني أَذوبُ نُحولاً","في هَواها الخُصورُ وَالأَكفالُ",30,"ل",1,0],["كَفَلوا لِلنَزيلِ وَالجارِ بِالخِص","بِ وَقَد طَبَّقَ الثَرى الإِمحالُ",30,"ل",1,0],["كَفِلَت بيضُهُ لِأَرضٍ أَغاضوا","ماءَها أَن تَسيلَ فيها الدِماءُ",31,"ا",2,0],["كفل العواصم حين لم ير عاصم","عن خطبها ولها سواه خاطب",32,"ب",1,0],["كَفَلَتْ فَيَالِقُهُ بأنْ تَدَعَ العِدَى","يَوْمَ الهيَاجِ وهَامُها أفْلاقُ",33,"ق",1,0],["كَفَلَتْ عُلاكَ لَهُ بِكُلِّ فَضِيلَةٍ","إِنَّ النَّبِيهَ نَبِيهَةٌ أَبْناؤُهُ",34,"ا",3,0],["كَفِلتَ بِكَسبِ الحَمدِ تَركَبُ وَعرَهُ","وَتَحمِلُ في كُلِّ المَواطِنِ كَلَّهُ",35,"ل",2,0],["كفلت حمل غرامي","له بفرط نحولي",36,"ي",1,1],["كَفلت الوَرى بالعدلِ كفلَ مؤيّدٍ","بِنصرٍ وتَوفيقٍ أذلّا لهُ الصعبا",37,"ب",2,0],["كَفَلت لِطالِبِ الدُنيا بِهَمٍّ","طَويلٍ لا يَؤولُ إِلى اِنقِطاعِ",38,"ع",1,1],["كَفِّل زَمانَكَ أَن يُغَيِّرَ كُلَّ ما","أَنكَرتَهُ فَكَفاكَ مِنهُ كَفيلُ",39,"ل",1,0],["كفلت الأمهات فأرضعتني","ولكن لا سبيل إلى الفطام",40,"م",1,0],["كفل الإله له بطول بقائها","لرضى محبّ أو لكبتِ حسودِ",41,"د",1,0],["كفل الزمان أبوه إعلانا له","والعلم وهو مناصر ومواتي",42,"ت",2,0],["كفَلَتْ لراكبها بآخرِ سَوقِهِ","في السير أو ضمنت صلاح شئونهِ",43,"ن",2,0],["كفَّلَهنَّ السُّقْمُ بقلوبنا","فكلُّ قلبٍ في ضَمانِ ناظرِ",44,"ر",1,0],["كفٌّ له تَحمِي وسيفٌ يُنتضَى","ولحاظُ راعٍ للرعيّةِ راصدِ",45,"د",1,0],["كَفِّلْ علاك بحاجتي واكفف يدي","عن كلّ جَعد الكف جَعد الساعدِ",45,"د",1,0],["كُفِلَتْ بأُولَى مجدهِ أيامُهُ ال","أخرَى فأحَيا كلَّ فضلٍ ميِّتِ",46,"ت",1,0],["كفلتها يداك تعمر ما أنهج","منها كما كفتها المحلا",47,"ل",2,0],["كفل الخلق بالنوال فقد أص","بح كلٌّ على أياديه كلاَّ",48,"ل",2,0],["كفلتَ به ردّ الشباب وعصره","وجئتَ مجيءَ العارضِ المتراكمِ",49,"م",1,0],["كفلَ الدمعُ ريَّ سفيحكَ والدم","عُ مليٌّ بعد النوى بالكفالة",50,"ل",2,0],["كَفَلَتْ حُجورُ الأَوصِياءِ صِغارَنا","وكِبارُنا مِنها النَّوائِبُ تَذهَلُ",51,"ل",1,0],["كفلت لها يا بن الكفيل بصولة","يدين لها سهل الخطوب ووعرها",52,"ر",3,0],["كفل الجواد المستقل بسرجه","محراب عسكره وحصن المتقي",53,"ق",2,0],["كفلت لهم أن يكشف الغم عنهم","ولو أنه قطع من الليل مظلم",54,"م",1,0],["كَفَلانِي بِحَنانٍ","وصَغيراً رَبيَّاني",55,"ن",2,0],["كَفَلْتَهُمْ وضَمِنتَ بَ