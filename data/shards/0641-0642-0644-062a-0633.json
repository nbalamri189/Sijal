try.dctabudhabi.ae/diwan/poem/59168","الوافر"],[173,"","https://poetry.dctabudhabi.ae/diwan/poem/29577","الطويل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117766","البسيط"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109025","المتقارب"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79823","المتقارب"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48912","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69339","المنسرح"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109312","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53244","السريع"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109419","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106834","الطويل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140077",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200043","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205077","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204487","الطويل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121652","الوافر"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87632","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62758","الطويل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131983","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91412","المجتث"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117954","الطويل"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/141537","الطويل"],[3866,"","https://poetry.dctabudhabi.ae/diwan/poem/147220","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54501","الكامل"],[4830,"مجرى دمي","https://www.poetsgate.com/ViewPoem.aspx?id=202615",""],[5660,"تَذَكَّرتُ أَطلالاً فَلَمّا أَتَيتُها","https://www.poetsgate.com/ViewPoem.aspx?id=23716",""],[5672,"سيان!!!","https://www.poetsgate.com/ViewPoem.aspx?id=206402",""]],"verses":[["فَقُلتُ سَلي أَحشاءَهُم كَيفَ رُوِّعَت","وَأَسيافَهُم هَل صافَحَت مِنهُم يَدا",0,"د",2,0],["فَقُلتُ سَرِيُّ كَلامُ السَرِيِّ","إِذا وَقَعَ الناسُ في مُشكِلَه",1,"ه",1,0],["فَقُلتُ سَلامُ اللَهِ قالَت وَبِرُّهُ","فَقُلتُ أَهَزلٌ ذَلِكَ القَولُ أَم جَدُّ",2,"د",1,0],["فقلتُ سترٌ رفيعٌ","قالتْ وحسنٌ بديعُ",3,"ع",1,0],["فقلتُ سلْ أو لا تسلْ","ماليَ في الأحولِ شيْ",4,"ي",1,0],["فَقُلتُ سَوفَ فَقالوا","تَركُ الصَلاةِ كَبيرُ",5,"ر",1,0],["فَقُلتُ سُبحانَ رَبّي","فَقالَ سُبحانَ ماني",6,"ن",2,0],["فَقُلتُ سَيَصرَعُهُ بَغيُهُ","كَذاكَ بَغى صالِحٌ فَاِختُرِم",7,"م",1,0],["فقلت سيّدني رفقا بأحنفكم","إني عليك لمحسود ومكمود",8,"د",1,0],["فقلتُ سُؤلي أما ترقُّ لمن","أمسى من الحبِّ هائماً دَنِفا",9,"ف",2,0],["فقلت سبحانك يا ذا العلا","أشرقت الشمس من المغرب",10,"ب",1,0],["فقلتُ سلوني عن جميعِ صفاتِه","فقالوا جميعاً أنتَ لا شكَ أعْرَفُ",11,"ف",1,0],["فَقُلتُ سَتَلقَين منّي الوِصال","إذا شِبتُ أَو عاد عصر الشَبابِ",12,"ب",1,0],["فَقُلتُ سَأمضيهِ لِنَفسي ذَخيرَةً","وَأَجعَلُ رَبّي الذُخرَ لِلأَهلِ وَالولدِ",13,"د",1,0],["فَقُلت سَبيل الوَصل لي مِنكَ طامس","فَقال وَمِثلي لا يُدانيهِ طامثُ",14,"ث",1,0],["فقلتُ سيروا إلى بَيْتِ النّدى زُمَراً","فلِلهُدَى والنَّدى في الأرضِ بَيْتان",15,"ن",1,0],["فَقُلتُ سِوى البَحرِ الَّذي قَد عَنَيتِهِ","أَرَدتُ فَلَم أَنشَط إِلى اللُجَجِ الخُضرِ",16,"ر",1,0],["فقلتُ سِر آمِناً مِن نَقضِ عَهدك ذا","فليسَ هَذا الَّذي تَخشاهُ من عَملي",17,"ل",2,0],["فَقُلتُ سَبيلُ الخَمرِ أَن تُنقِصَ الحجى","فَاِن لَم تَجد عَقلاً فَماذا تَحيَّف",18,"ف",1,0],["فقلتُ: سبحانَ من صاغَ الجمالَ لن","حتى ظننَّا بأنَّا لا نرى بَشَرا",19,"ر",2,0],["فقلتُ سهوةُ خرقٍ عن عوائدهِ","لا بُخلُ كزٍّ عن المعروف ممتنع",20,"ع",1,0],["فقلت سدِّدْ نَحْرَها","لا كنتَ من نِكْسٍ ورع",21,"ع",1,0],["فقلت سيفي ورمحي","والدرعُ عدلُ ابن سيفِ",22,"ف",1,0],["فقلتُ سيري ففي الأسفارِ مَغْنمةٌ","فسوف نحظَى بما نهواه عن كثب",23,"ب",1,0],["فَقُلتُ سَقى اللَهُ الحِمى دِيَمَ الحَيا","فَقُلنَ سَقاكَ اللَهُ بِالسُمّ مُنقَعا",24,"ع",2,0],["فقلتُ سَلِي الحَشَا قالَتْ صَرِيعٌ","فقلتُ الدمعَ قالَتْ ذَاكَ صَبُّ",25,"ب",1,0],["فَقُلتُ سَلي حيَّي نِزارٍ وَيَعرُبٍ","بِأَعظَمِها خَطباً إِذا اِستَبهَمَ الخَطبُ",26,"ب",1,0],["فقلت سدُّ طريقِ الشعرِ يعجزهُ","ومن يسدُّ طريقَ العارضِ الهطلِ",27,"ل",1,0],["فقلت سأغدو ضباباً كثيفاً","فليست تراك سوى مقلتي",28,"ي",1,0],["فقلت سأغدو بهِ كاهناً","يعرّف راهبة التوبة",28,"ه",1,0],["فقلت سلوتُ إذاً مُهجتي","إذا أنا حاولتُ سلوانَها",29,"ن",3,0],["فقلت سُنّةُ هذا الكون واحدةٌ","وما الرقيُّ بملغٍ فِطرةَ النَهَم",30,"م",1,0],["فَقُلتُ سِيروا فَإِنَّه مَلِكٌ","يَضيقُ وُسعُ الزَمانِ عَن هممِه",31,"م",2,0],["فقلت سأجفو الشعر ان كان فاضحاً","لسري فخلوني بحالي وارفقوا",32,"ق",3,0],["فقلت سبحان الذي خصه","بمكرمات أصلها منجب",33,"ب",1,0],["فقلت سلي من كان مختبر الهوى","فتدري بان الوصل أمرٌ محتم",34,"م",1,0],["فقلتُ سلي الأطيارَ في وكناتها","إذا لعبت ماذا أثار بها اللعب",35,"ب",1,0],["فقلت سلوها فسايلنها","فقالت اساتن فيه الادب",36,"ب",1,0],["فقلت سمعا لك مهما يكن","نصحك مر الطعم كالعلقم",37,"م",1,0],["فقلت سأبقى بها ما حييت","فليس بها للورى من أثر",38,"ر",1,0],["فقلت سألقى في الجنان سعادة","متى بركوع اشتغل وسجود",39,"د",1,0],["فقلتُ سَلُوا الْقَوَادِمَ والخَوافِي","فلَوْلا رِيشُها ما طال نَبْلُ",40,"ل",1,0],["فَقُلتُ سطراً من التأريخ راقَ لَهُ","انَّ الامينَ على الأَلماس يؤتَمَنُ",41,"ن",1,0],["فقلتُ سحابٌ أسْتَظِلُّ بظِلّه","ولا امترى غيرَ المودةِ والهَوى",42,"ا",1,0],["فقلت سلاما عليك لقد","دفنت أخاك بوادي الشجون",43,"ن",1,0],["فَقُلت سنةُ طَيف","تكون في الاعتزال",44,"ل",1,0],["فقلت سترت العيب لا الشيب إنه","من العار شيب ليس يصحبه نسك",45,"ك",1,0],["فقلت: سأُبْقي ما شفى الجلدَ حكُّه","وأقضي بقصِّي منه ما حكُّهُ يُدمي",46,"ي",1,0],["فقلتُ سقامًا حلّ في باطن الحشا","ولوعة قلب بلبلته البلابلُ",47,"ل",1,0],["فقلتُ سُراي للعليا وإنّي","تخذتُ لها أَميناً من أَمونِ",48,"ن",1,0],["فقلتُ سَلْ عنّي غواني الهوى","وذي قوافي الوجدِ كم أخبرَتْ",49,"ت",1,0],["فَقُلتُ سَفيهٌ إِن قَنَعتُ بِجُرحِكِ","وَ في النَفسِ رُوحٌ لِلجِراحِ مَراسِيا",50,"ي",2,0],["فقلت: سيان الهوى والنوى","عطفت او بالوصل لم تعطفِ",51,"ف",1,0]]}