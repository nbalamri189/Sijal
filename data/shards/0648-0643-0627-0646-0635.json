{"poems":[[83,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[88,"يرزت تميس كخطرة النشوان","https://www.aldiwan.net/poem44446.html","الكامل"],[29,"صرمت أمامة حبلها ورعوم","https://www.aldiwan.net/poem6063.html","الكامل"],[89,"حملته بين احشائي بلا برم","https://www.aldiwan.net/poem44857.html","البسيط"],[45,"مع الدهر ظلم ليس يقلع راتبه","https://www.aldiwan.net/poem10905.html","الطويل"],[45,"خرس الثرى وتكلم الزهر","https://www.aldiwan.net/poem63621.html","الكامل"],[45,"طفقت تلوم ولات حين ملامه","https://www.aldiwan.net/poem65666.html","الطويل"],[80,"أعليت بين النجم والدبران","https://www.aldiwan.net/poem31266.html","الكامل"],[80,"جاءتك أولاد الوجيه ولاحق","https://www.aldiwan.net/poem31363.html","الكامل"],[75,"عاطيته كأسا كأن شعاعها","https://www.aldiwan.net/poem68996.html","الكامل"],[75,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54518","المجتث"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23852","الكامل"],[161,"ارضيت ربك بالعدل الذي انتشرا","https://www.aldiwan.net/poem58894.html","البسيط"],[190,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[200,"ثوب السماء مطرز بالعسجد","https://www.aldiwan.net/poem45645.html","الكامل"],[232,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[262,"لمن المهارى اليعملات القود","https://www.aldiwan.net/poem38338.html","الكامل"],[271,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[282,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[283,"الآن لان لي الزمان فأعتبا","https://www.aldiwan.net/poem32875.html","الكامل"],[365,"خفض عليك وإن أطلت تأملا","https://www.aldiwan.net/poem60805.html","الكامل"],[365,"هو ما علمت فأقصري أو فاعذلي","https://www.aldiwan.net/poem60809.html","الكامل"],[401,"الأمل المورق","https://www.aldiwan.net/poem6715.html","عموديه"],[403,"ما لي وللافتقار في بلدي","https://www.aldiwan.net/poem46416.html","المنسرح"],[404,"أجابت دموع العين وامتنع الصبر","https://www.aldiwan.net/poem33930.html","الطويل"],[407,"عصرت مدامعك الأناة المعصر","https://www.aldiwan.net/poem50167.html","الكامل"],[430,"ورد الكتاب مصرحا ومسطرا","https://www.aldiwan.net/poem41038.html","الكامل"],[433,"قامت حروب الهوى على ساق","https://www.aldiwan.net/poem12314.html","المنسرح"],[465,"نشوات طرفك والقوام الأهيف","https://www.aldiwan.net/poem3147.html","عموديه"],[465,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[487,"أرسم ديار بالستارين تعرفُ","https://www.aldiwan.net/poem482.html",""],[516,"ليست صفات علاك مما يمترى","https://www.aldiwan.net/poem12109.html","الكامل"],[568,"أطلق عقال الروح بالراح","https://www.aldiwan.net/poem69760.html","السريع"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["وكأنّ صفحَ البرق سيفُكَ ظلَّ من","غِمدِ الغمامة مرهفاً مسلولا",0,"ل",2,0],["وكأنّ صنّيناً أطلّ مراقباً","يرنو لهنّ بمقلة الغيران",1,"ن",1,0],["وَكَأَنَّ صَوتَ حَمامِهِ في قَعرِهِ","عِندَ الأَصيلِ إِذا اِرتَجَسنَ خُصومُ",2,"م",1,0],["وكان صورته من خير ما نظرت","عيني وشيمته من اكرم الشيم",3,"م",1,0],["وَكانَ صَريعَ الحَينِ جِبسٌ مُلَعَّنٌ","مَتى شاءَ يَوماً قالَ ما شاءَ عائِبُه",4,"ب",2,0],["وَكَأَنَّ صُفرَ بَهارِها ذَهَبٌ","وَكَأَنَّ حُمرَ شَقيقِها جَمرُ",5,"ر",1,0],["وَكَأَنَّ صَهلَتَهُ إِذا اِستَعلى بِها","رَعدٌ يُقَعقِعُ في اِزدِحامِ غَمامِهِ",6,"م",2,0],["وكأنّ صانِعَها استبدّ بصنعةٍ","فخرَ الجمادُ بها على الحيوانِ",7,"ن",1,0],["وَكَأَنَّ صبحاً خصَّ فاه بِقُبلَةٍ","فابيضّ موضعها لِعَيْن الرامقِ",8,"ق",1,0],["وكأنَّ صفحةَ خدّهِ وعِذارَهُ","تُفَّاحَةً حُفَّت بِهَا أوراقُهَا",9,"ق",3,0],["وكأنّ صفحةَ خَدّهِ وعذارَه","تُفّاحةٌ رُمِيَتْ لتَقْتُلَ عَقربا",10,"ب",2,0],["وَكَانَ صَاعِقَةَ اللَّ","هِ إِنْ رَمَى الأَعْدَاءَ",11,"ا",2,0],["وكأن صوتك حين تص","دح صوت رعدٍ يَرْجِس",12,"س",1,0],["وكان صلى عليه الله يقتلهم","حتى يحبوه المبصر البصرا",13,"ر",2,0],["وَكان صحيحَ الجسمِ لا عذر عندهُ","بَلى إنّ ضعفَ الدينِ كانَ لهُ عُذرا",14,"ر",2,0],["وكأن صفحةَ بدرهِ إذ أشرفتْ","مصقولةَ الخدينِ صفحةَ أمردِ",15,"د",1,0],["وكان صفي الله آدم طينة","وفيه لأقمار النبوة مطلع",16,"ع",1,0],["وكأن صد الغانيات وودها","عرض يقوم وجوهر مفقود",17,"د",1,0],["وكأنَّ صفحةُ ذي الفقارِ جبينَها","ولحاظَها من حدِّهِالمتسعّر",18,"ر",1,0],["وكان صافية للدين خالصةً","فشارك الشرك فيه ملة الحُنفا",19,"ف",2,0],["وَكَأَنَّ صَوتَ الرَّعدِ رَكضُ خُيولِهِ","وَالنَصرُ في جَبهاتِهنَّ مُرَكَّبا",20,"ب",2,0],["وكأنّ صُبْحاً سال من جَبهاتِها","صَبَباً فكان له القَرارُ الأرجُلا",21,"ل",2,0],["وكأنّ صُبحاً سائلاً من أوجُهٍ","منها أصابَ قَرارةً في أرْجُل",22,"ل",1,0],["وكان صمتُ الليل أُسطورةً","موغلةً في صمتها المُطبقِ",23,"ق",1,0],["وكان صَدْري من قبل ذَا سِعةٍ","فَضَاقَ صَدري لِضيقِ ذَاتِ يدي",24,"د",2,0],["وكان صلاح الدين للدين كاسمه","ولا غرو إن مس الهدى بعده الضر",25,"ر",1,0],["وَكأنَّ صدرَ قَناتِهِ يَوم الوَغى","سِلكٌ وَأَبطال الفَوارِسِ جَوهَرُ",26,"ر",1,0],["وكأن صفحته صفيحة وجه من","ملك الجمال بها العذار تعذّرا",27,"ر",2,0],["وكانَ صَبْرِي بَيْضاً مُلَحَّمَةً","نَزَعْتُها مِنْ لِقَاءِ أَشْوَاقِ",28,"ق",1,0],["وكأنَّ صفحةَ خدهِ كافورةٌ","نقشتْ من المسك السحيق بأحرف",29,"ف",1,0],["وكان صهيل الخيل شدواً فلم يزل","بها الضرب حتى عاد وهو عويل",30,"ل",1,0],["وَكانَ صُدودٌ بَعدَ ناءَبطَنَ الهَوى","قُلوباً فَكادَت لِلَّذي كانَ تُجنَفُ",31,"ف",1,0],["وكأن صولتك المخوفة أمنت","أسرابها أن لا تراع وتذعرا",32,"ر",2,0],["وكأنّ صوتَ صَريرِها","جرحى تجاوَبُ بالأُحاحِ",33,"ح",1,0],["وكان صهرا للزبير زوجته","بنت الزبير فانتهت حميته",34,"ه",1,0]]}