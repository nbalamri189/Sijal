{"poems":[[85,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[90,"يرزت تميس كخطرة النشوان","https://www.aldiwan.net/poem44446.html","الكامل"],[31,"صرمت أمامة حبلها ورعوم","https://www.aldiwan.net/poem6063.html","الكامل"],[91,"حملته بين احشائي بلا برم","https://www.aldiwan.net/poem44857.html","البسيط"],[47,"مع الدهر ظلم ليس يقلع راتبه","https://www.aldiwan.net/poem10905.html","الطويل"],[47,"خرس الثرى وتكلم الزهر","https://www.aldiwan.net/poem63621.html","الكامل"],[47,"طفقت تلوم ولات حين ملامه","https://www.aldiwan.net/poem65666.html","الطويل"],[82,"أعليت بين النجم والدبران","https://www.aldiwan.net/poem31266.html","الكامل"],[82,"جاءتك أولاد الوجيه ولاحق","https://www.aldiwan.net/poem31363.html","الكامل"],[77,"عاطيته كأسا كأن شعاعها","https://www.aldiwan.net/poem68996.html","الكامل"],[77,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54518","المجتث"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/23852","الكامل"],[164,"ارضيت ربك بالعدل الذي انتشرا","https://www.aldiwan.net/poem58894.html","البسيط"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[203,"ثوب السماء مطرز بالعسجد","https://www.aldiwan.net/poem45645.html","الكامل"],[236,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[266,"لمن المهارى اليعملات القود","https://www.aldiwan.net/poem38338.html","الكامل"],[275,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[286,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[287,"الآن لان لي الزمان فأعتبا","https://www.aldiwan.net/poem32875.html","الكامل"],[369,"خفض عليك وإن أطلت تأملا","https://www.aldiwan.net/poem60805.html","الكامل"],[369,"هو ما علمت فأقصري أو فاعذلي","https://www.aldiwan.net/poem60809.html","الكامل"],[406,"الأمل المورق","https://www.aldiwan.net/poem6715.html","عموديه"],[408,"ما لي وللافتقار في بلدي","https://www.aldiwan.net/poem46416.html","المنسرح"],[409,"أجابت دموع العين وامتنع الصبر","https://www.aldiwan.net/poem33930.html","الطويل"],[412,"عصرت مدامعك الأناة المعصر","https://www.aldiwan.net/poem50167.html","الكامل"],[435,"ورد الكتاب مصرحا ومسطرا","https://www.aldiwan.net/poem41038.html","الكامل"],[438,"قامت حروب الهوى على ساق","https://www.aldiwan.net/poem12314.html","المنسرح"],[469,"نشوات طرفك والقوام الأهيف","https://www.aldiwan.net/poem3147.html","عموديه"],[469,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[491,"أرسم ديار بالستارين تعرفُ","https://www.aldiwan.net/poem482.html",""],[520,"ليست صفات علاك مما يمترى","https://www.aldiwan.net/poem12109.html","الكامل"],[572,"أطلق عقال الروح بالراح","https://www.aldiwan.net/poem69760.html","السريع"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104049","الكامل"],[757,"","https://poetry.dctabudhabi.ae/diwan/poem/132446","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48835","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48630","البسيط"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122383","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77551","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77492","الرجز"],[969,"","https://poetry.dctabudhabi.ae/diwan/poem/145613","السريع"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62671","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62567","الطويل"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122869","الوافر"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35711","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108709","الكامل"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101569","الكامل"],[2280,"","https://poetry.dctabudhabi.ae/diwan/poem/75842","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137202",""],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65951","الطويل"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124670","السريع"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110048","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131123",""],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32949","الكامل"],[3977,"","https://poetry.dctabudhabi.ae/diwan/poem/99174","الكامل"],[4013,"","https://poetry.dctabudhabi.ae/diwan/poem/113664","الكامل"],[4178,"","https://poetry.dctabudhabi.ae/diwan/poem/146397","الكامل"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111200","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94541","الوافر"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81928","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72891","المجتث"],[4755,"هَا قَدْ أَسَالَ دَمِي.. وخَطَّا","https://www.poetsgate.com/ViewPoem.aspx?id=187695",""],[5136,"القلب يخشع والأماني تدمع","https://www.poetsgate.com/ViewPoem.aspx?id=121614",""],[778,"قم يا غلام أدر علي بسحرة","https://www.poetsgate.com/ViewPoem.aspx?id=89138",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5353,"مشنقة","https://www.poetsgate.com/ViewPoem.aspx?id=214896",""],[5382,"أعيش كأنّى","https://www.poetsgate.com/ViewPoem.aspx?id=211405",""],[5409,"غنت وتابعت الغناء بجسها","https://www.poetsgate.com/ViewPoem.aspx?id=155517",""],[5431,"خيطا من الشمس ثوبا ليس يهترئُ","https://www.poetsgate.com/ViewPoem.aspx?id=197697",""],[5561,"ماضٍ مَنسيّ","https://www.poetsgate.com/ViewPoem.aspx?id=196537",""],[470,"سلاماً يا أعزَّ النّاس","https://www.poetsgate.com/ViewPoem.aspx?id=178033",""],[5725,"الى رحمة","https://www.poetsgate.com/ViewPoem.aspx?id=177499",""],[6070,"طائر الاحزان","https://www.poetsgate.com/ViewPoem.aspx?id=188135",""],[549,"الفارس والصهيل المكسر","https://www.poetsgate.com/ViewPoem.aspx?id=203001",""],[520,"ليست صفات علاك مما يمترى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577514",""],[6314,"المهدية المنتظِرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88075&r=&rc=10",""],[5190,"أُحقِّركُم وأكرَهُكُم جميعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85050&r=&rc=125",""],[5190,"إشارة حمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85037&r=&rc=112",""]],"verses":[["وكأنّ صفحَ البرق سيفُكَ ظلَّ من","غِمدِ الغمامة مرهفاً مسلولا",0,"ل",2,0],["وكأنّ صنّيناً أطلّ مراقباً","يرنو لهنّ بمقلة الغيران",1,"ن",1,0],["وَكَأَنَّ صَوتَ حَمامِهِ في قَعرِهِ","عِندَ الأَصيلِ إِذا اِرتَجَسنَ خُصومُ",2,"م",1,0],["وكان صورته من خير ما نظرت","عيني وشيمته من اكرم الشيم",3,"م",1,0],["وَكانَ صَريعَ الحَينِ جِبسٌ مُلَعَّنٌ","مَتى شاءَ يَوماً قالَ ما شاءَ عائِبُه",4,"ب",2,0],["وَكَأَنَّ صُفرَ بَهارِها ذَهَبٌ","وَكَأَنَّ حُمرَ شَقيقِها جَمرُ",5,"ر",1,0],["وَكَأَنَّ صَهلَتَهُ إِذا اِستَعلى بِها","رَعدٌ يُقَعقِعُ في اِزدِحامِ غَمامِهِ",6,"م",2,0],["وكأنّ صانِعَها استبدّ بصنعةٍ","فخرَ الجمادُ بها على الحيوانِ",7,"ن",1,0],["وَكَأَنَّ صبحاً خصَّ فاه بِقُبلَةٍ","فابيضّ موضعها لِعَيْن الرامقِ",8,"ق",1,0],["وكأنَّ صفحةَ خدّهِ وعِذارَهُ","تُفَّاحَةً حُفَّت بِهَا أوراقُهَا",9,"ق",3,0],["وكأنّ صفحةَ خَدّهِ وعذارَه","تُفّاحةٌ رُمِيَتْ لتَقْتُلَ عَقربا",10,"ب",2,0],["وَكَانَ صَاعِقَةَ اللَّ","هِ إِنْ رَمَى الأَعْدَاءَ",11,"ا",2,0],["وكأن صوتك حين تص","دح صوت رعدٍ يَرْجِس",12,"س",1,0],["وكان صلى عليه الله يقتلهم","حتى يحبوه المبصر البصرا",13,"ر",2,0],["وَكان صحيحَ الجسمِ لا عذر عندهُ","بَلى إنّ ضعفَ الدينِ كانَ لهُ عُذرا",14,"ر",2,0],["وكأن صفحةَ بدرهِ إذ أشرفتْ","مصقولةَ الخدينِ صفحةَ أمردِ",15,"د",1,0],["وكان صفي الله آدم طينة","وفيه لأقمار النبوة مطلع",16,"ع",1,0],["وكأن صد الغانيات وودها","عرض يقوم وجوهر مفقود",17,"د",1,0],["وكأنَّ صفحةُ ذي الفقارِ جبينَها","ولحاظَها من حدِّهِالمتسعّر",18,"ر",1,0],["وكان صافية للدين خالصةً","فشارك الشرك فيه ملة الحُنفا",19,"ف",2,0],["وَكَأَنَّ صَوتَ الرَّعدِ رَكضُ خُيولِهِ","وَالنَصرُ في جَبهاتِهنَّ مُرَكَّبا",20,"ب",2,0],["وكأنّ صُبْحاً سال من جَبهاتِها","صَبَباً فكان له القَرارُ الأرجُلا",21,"ل",2,0],["وكأنّ صُبحاً سائلاً من أوجُهٍ","منها أصابَ قَرارةً في أرْجُل",22,"ل",1,0],["وكان صمتُ الليل أُسطورةً","موغلةً في صمتها المُطبقِ",23,"ق",1,0],["وكان صَدْري من قبل ذَا سِعةٍ","فَضَاقَ صَدري لِضيقِ ذَاتِ يدي",24,"د",2,0],["وكان صلاح الدين للدين كاسمه","ولا غرو إن مس الهدى بعده الضر",25,"ر",1,0],["وَكأنَّ صدرَ قَناتِهِ يَوم الوَغى","سِلكٌ وَأَبطال الفَوارِسِ جَوهَرُ",26,"ر",1,0],["وكأن صفحته صفيحة وجه من","ملك الجمال بها العذار تعذّرا",27,"ر",2,0],["وكانَ صَبْرِي بَيْضاً مُلَحَّمَةً","نَزَعْتُها مِنْ لِقَاءِ أَشْوَاقِ",28,"ق",1,0],["وكأنَّ صفحةَ خدهِ كافورةٌ","نقشتْ من المسك السحيق بأحرف",29,"ف",1,0],["وكان صهيل الخيل شدواً فلم يزل","بها الضرب حتى عاد وهو عويل",30,"ل",1,0],["وَكانَ صُدودٌ بَعدَ ناءَبطَنَ الهَوى","قُلوباً فَكادَت لِلَّذي كانَ تُجنَفُ",31,"ف",1,0],["وكأن صولتك المخوفة أمنت","أسرابها أن لا تراع وتذعرا",32,"ر",2,0],["وكأنّ صوتَ صَريرِها","جرحى تجاوَبُ بالأُحاحِ",33,"ح",1,0],["وكان صهرا للزبير زوجته","بنت الزبير فانتهت حميته",34,"ه",1,0],["وكأنّ صفَّ وصائفٍ برزت إلى ال","منصورِ عن كَللٍ من الصّفصافِ",35,"ف",1,0],["وكأنَّ صوتَ الرَّعدِ خلف سحابها","حادٍ إذا ونتِ السحائبُ صاحا",36,"ح",2,0],["وكان صنيعهم عندي قضاء","لحق الملك أن عرفوا الصوابا",37,"ب",2,0],["وكان صاحبها في البيت منفرداً","جم الغرام يقاسي الشوق والفِكَرا",38,"ر",2,0],["وكان صلاحى والتعفف غايب","وبت على حال ابي اللّه ان تخفى",39,"ف",2,0],["وَكانَ صَح اليَوم ضَربُ المَثَلِ","فَعَلتُ ما فَعَلتهُ وَالذنب لي",40,"ي",1,0],["وَكانَ صوف الكَبش في التَأسيس","مُلبداً كَلحية القِسِّيس",41,"س",1,0],["وكان صوتي قبلُ ذا فتنةٍ","تستنزل الطير بحسن الرنين",42,"ن",1,0],["وكان صغير السِّن كالبدر مَنشَأَ","وكان كبير القدر كالبدر مُصْعِدا",43,"د",2,0],["وكان صديقاً لي يلاحظ جانبي","ويبسط صدراً منه لي وهو واسعُ",44,"ع",1,0],["وكان صلاحه لو شئتموه","قريبا لا يحاوله البصيرُ",45,"ر",1,0],["وَكَأَنَّ صَوتَ الماءِ في حافاتِهِ","زَجلُ القيانِ تُطارِحُ الأَصواتا",46,"ت",2,1],["وكأن صفحة خده وعذاره","بيد النقيب كتابه المسطور",47,"ر",1,0],["وكأنَّ صوت خفوق قلبي مزعج","صمت الظلام فيدلهم وبدهم",48,"م",1,0],["وَكانَ صُدودٌ بَعدَ ما أَبطنَ الهَوى","قُلوباً فَكادَت لِلَّذي كانَ تُجنَفُ",49,"ف",1,0],["وكان صوتك في شكواك يزعجنا","كاننا في سحاب رعده قصفا",50,"ف",2,0],["وكان صليب العود مراً إذا أبى","عطوفاً كمثل الشهد عند التودد",51,"د",1,0],["وكانَ صبّاً يوم هامت به","فنالَ منهُ حُبّها المُحرِقُ",52,"ق",1,0],["وكأَنَّ صوت الصاعقين زلازلُ","يُرهِبنَ إِرعاداً وهُنَّ نوازلُ",53,"ل",1,0],["وكأنّ صوت الرعد صوت مدافع","والبرق كالأسياف حين تألقا",54,"ق",2,0],["وَكَأَنَّ صَدّيقَ الوَرى","بِالحَقِّ يَنطِقُ عَن لِسانِهِ",55,"ه",1,1],["وكأن صحفته على أضيافه","في البعد والابطاء فترة مرسل",56,"ل",1,0],["وكأنَّ صفحة خدِّه ياقوتةٌ","وكأنَّ عارضه خميلة سندسِ",57,"س",1,0],["وكأن صوب القطر كل عشيةٍ","أثار سيبك في ذوي الأقتار",58,"ر",1,0],["وكان صنيع الدهر فيك صنيعه","لدي فما ينفك عندي ذا ظلم",59,"م",1,0],["وكان صدوحهُ حزناً أتوفاً","فغرَّد مفرحاً جاءَ المرادُ",60,"د",1,0],["وكأنَّ صورة ذاته ألق بها","قلم وقلبي اللوح وهو الكاتب",61,"ب",1,0],["وكان صاد إليه","وفيه بلَّ صَداهُ",62,"ه",1,0],["وكَأَنَّ صَوتِي لَمْ يَكُنْ","إِلَّا كَمَنْ بالنَّوْمِ غَطَّا",63,"ط",2,0],["وكان صبري لمع برق خلب","خدع العيون أو السراب اليلمع",64,"ع",1,0],["وكان صفح الماء درج ابيض","فيه لضوء البدر سطر مذهب",65,"ب",1,0],["وكان صحيحاً أن ذلك موجباً","لفضلهم لا غير يا من توهما",66,"م",2,0],["وكان صمتي بكلِّ الصّمت يفضحني","فأينَ منّي بما أخفيه يا جلدي",67,"د",2,0],["وكان صراخى بدايات حزني","وطفل جرى وادعى لم يَكُنِّى",68,"ن",2,0],["وكان صمت الواجمين عبادةٌ","محجوبةٌ إلا على عينيها",69,"ي",3,0],["وكان صوتك طعم اللوز منسكبا","على الأرائك حيث الروح تتكئُ",70,"ا",1,0],["وكانَ صمتُكَ بحرا لا ضفافَ لهُ","حيرانَ ترجو رفيقا يُؤنسُ العمرا",71,"ر",2,0],["وكان صِحابُنا يا عَين","طولَ الليلِ غافينا",72,"ن",2,0],["وكأنّ صبري للزمان أغاضه","يرميني سهماً مارقاً لم ينزعِ",73,"ع",1,0],["وكأنَّ صوتَكَ في مداهُ مخاطبٌ","يالوعةَ الأيامِ والأحزانِ",74,"ن",1,0],["وكأنَّ صوتَكَ قائلٌ منْ حزنهِ","كمْ كانَ حباً صادقَ الوجدانِ",74,"ن",1,0],["وكانَ صدى كعبيكَ في كلِّ خطوةٍ","يُطَيِّر ( للأقصَى ) حماماً مُبَشِّرَا",75,"ر",2,0],["وكأن صولتك الخوفة أمنت","أسرابها أن لا تراع وتدعرا",76,"ر",2,0],["وكأن صدركِ صرح بلقيس المُمَرَّد","تحته وادي المنايا يُشْرِفُ",77,"ف",1,0],["وكان صنيعُكُم فينا رصاصاً","عتيّاً قاتِلاً سَكَنَ الضُّلوعا",78,"ع",2,0],["وكأنَّ صُورَتَهَا التِِّي لَمَّا تَغِب","عَنِّي ، شَرِيطٌ مَرَّ بي ، ومَنَارُ",79,"ر",1,0]]}