{"poems":[[53,"ما كل أمر أضاع المرء فرصته","https://www.aldiwan.net/poem9995.html","البسيط"],[46,"أتدري أي بارقة تشيم","https://www.aldiwan.net/poem30002.html","الوافر"],[46,"لنمنا وصرف الدهر ليس بنائم","https://www.aldiwan.net/poem30302.html","الطويل"],[107,"صفوا المواكب وامشوا حولها مرحا","https://www.aldiwan.net/poem43049.html","البسيط"],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[331,"بقاء الدين والدنيا جميعا","https://www.aldiwan.net/poem44275.html","الوافر"],[382,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[399,"أجراس سوداء","https://www.aldiwan.net/poem17746.html","عموديه"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112391","المتقارب"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133241","البسيط"],[4816,"خون المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=8452",""],[4856,"رحيلٌ مؤقت","https://www.poetsgate.com/ViewPoem.aspx?id=36269",""],[4955,"ثلاثونَ عاماً أُرفقت بثمانيةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189648",""],[5377,"تحية الخروج من العزلة","https://www.poetsgate.com/ViewPoem.aspx?id=61892",""],[5410,"انتظار","https://www.poetsgate.com/ViewPoem.aspx?id=139635",""],[5410,"إلامَ الصَبر...؟!","https://www.poetsgate.com/ViewPoem.aspx?id=141849",""],[5842,"تَقَبَّلْ دُعائي / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=137917",""],[5842,"أيها الساسة \\ محمد حسام الدين دو","https://www.poetsgate.com/ViewPoem.aspx?id=152165",""],[5843,"دوله مستقله","https://www.poetsgate.com/ViewPoem.aspx?id=51294",""]],"verses":[["لَنْمْتَ عنِّي وبات الدهر في رصَدٍ","وليس يُقْرَنُ ذو نوم بذي رَصَدِ",0,"د",1,0],["لَنِمتَ وَنامَ عِرضُكَ وَالقَوافي","سَواخِطُ لا تَنامُ وَلا تُنيمُ",1,"م",1,0],["لَنِمنا وَصَرفُ الدَهرِ لَيسَ بِنائِمٍ","خُزِمنا لَهُ قَسراً بِغَيرِ خَزائِمِ",2,"م",1,1],["لَنَمْنَعنَّ بأيدينا مَفاتِحَهُ","إن طافَ مُستَفْتِحٌ أو همَّ أو طمحا",3,"ح",2,0],["لنَمَّ الجُحوظُ على شاعرٍ","بعيدِ الخيالِ عنيفِ الرؤى",4,"ا",1,0],["لَن مَلِكٌ نِعمَ وَوَزيرُ مَلكٍ","عَلَيهِ مِن لِباسِ الشَيبِ نورُ",5,"ر",1,0],["لَنُمجدنَّ تقاك يا نهجَ الهدى","ونَمُوذجَ الأبرارِ والصلحاء",6,"ا",2,0],["لِنَمُتْ فالحياة جفَّت وهذي الأ","كؤسُ الفارغاتُ تَسخَرُ منا",7,"ن",2,1],["لِنَمُتْ فالرياحُ تجرح وجهَي","نا ولونُ الدُجى عميقٌ رهيبُ",7,"ب",1,0],["لِنمشي معاً فالنّعيم","بِلُبنَاننا أينَمَا",8,"م",2,0],["لن معجزة القرآن أبلغ ما","جاءت به الرسل إحكاما وإرشادا",9,"د",2,0],["لن مر زولك لحظة صرت مشروح","ياريت لو كانت حقيقة واشوفه",10,"ف",2,0],["لِنَمضي معاً رغمَ أنفِ الرحيلِ","لِنَسبحَ في بحرنا ثُمَّ نَغرَقْ",11,"ق",1,0],["لِنمسحْ بطهرِ التوبِ رجسَ ذنوبنا","لننجوَ قبلَ الموتِ فالموتُ قافيةْ",12,"ي",2,0],["لنمت أو نعش على الأرض أحراراً","..ولا عاش من يستسيغ الإهانة",13,"ن",2,0],["لنمضي في سفينتنا","فلا نذوي ولا نعرى",14,"ر",2,0],["لنمتشق الحقيقة في طريقٍ","يرى في صدقنا عزماً هُماما",15,"م",2,0],["لِنَملأَ تارِيخَنَا بِالشَظَايا","وَنُوثِقَ حاضِرَنا بالحِبالْ",16,"ل",1,0],["لنملؤها بألفتنا","عطاءً طاح خلاّسه",17,"س",2,0],["لن ماحد ٍ من بني آدم خلق من غير خله","ولن ليه صاحب ٍ غالي وهو قاس ٍ عليه",18,"ي",2,0]]}