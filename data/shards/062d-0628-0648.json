{"poems":[[95,"يا صاحباً جميله","https://www.aldiwan.net/poem11133.html","مجزوء الرجز"],[95,"مثالي هذا منبئ عن سريرتي","https://www.aldiwan.net/poem11194.html","الطويل"],[47,"حذرت الحب لو أغنى حذاري","https://www.aldiwan.net/poem63588.html","الوافر"],[47,"أخي متى خاصمت نفسك فاحتشد","https://www.aldiwan.net/poem65209.html","الطويل"],[30,"حملت من جرم مثاقيل حاجتي","https://www.aldiwan.net/poem5364.html","الطويل"],[46,"أعبدون قد صرت أحدوثة","https://www.aldiwan.net/poem30039.html","المتقارب"],[77,"قفا فلأمر ما سرينا وما نسري","https://www.aldiwan.net/poem69081.html","الطويل"],[7,"كليني لهم يا أميمة ناصب","https://www.aldiwan.net/poem2017.html","الطويل"],[48,"إذا عشت مفتكرا في الأنام","https://www.aldiwan.net/poem23266.html","المتقارب"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30486","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55153","المنسرح"],[47,"حَذَرْتُ الحُبّ، لَوْ أغْنى حِذاري","https://www.poetsgate.com/ViewPoem.aspx?id=31337",""],[30,"حملت من جرم مثاقيل حاجتي","https://www.poetsgate.com/ViewPoem.aspx?id=22108",""],[147,"بقيت ولا عزت عليك المطالب","https://www.aldiwan.net/poem11719.html","الطويل"],[216,"حوادث الدهر فيها البجر والعبر","https://www.aldiwan.net/poem37884.html","البسيط"],[310,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[310,"حبوتك بالتليد وبالطريف","https://www.aldiwan.net/poem56473.html","الوافر"],[370,"خليل لم أهبه من قلاه","https://www.aldiwan.net/poem44480.html","الوافر"],[382,"قفا نبك نفسا طال منها بسورها","https://www.aldiwan.net/poem59433.html","الطويل"],[425,"طربت وعناك الهوى والتطربُ","https://www.aldiwan.net/poem404.html",""],[438,"ألم به طيف الخيال مسلما","https://www.aldiwan.net/poem12475.html","الطويل"],[469,"أقام الوجد بعدهم وساروا","https://www.aldiwan.net/poem3209.html","عموديه"],[509,"صفا شهد ذوقي من ممازجة الهوى","https://www.aldiwan.net/poem38414.html","الطويل"],[558,"أأعلن ما بي أم أسر فأكتم","https://www.aldiwan.net/poem68411.html","الطويل"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53790","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122624","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62466","الطويل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138097",""],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64967","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64735","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112805","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64630","البسيط"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44855","الطويل"],[1673,"","https://poetry.dctabudhabi.ae/diwan/poem/119059","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26532","الوافر"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46742","الوافر"],[2552,"","https://poetry.dctabudhabi.ae/diwan/poem/144425","السريع"],[2841,"","https://poetry.dctabudhabi.ae/diwan/poem/133887","الطويل"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140302",""],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216556",""],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139987","الطويل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3977,"","https://poetry.dctabudhabi.ae/diwan/poem/99153","المتقارب"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78304","البسيط"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136856",""],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21575","المتقارب"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90866","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90876","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94464","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83391","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28723","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83151","المتقارب"],[4699,"من الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=155961",""],[4802,"صوتك بعيد","https://www.poetsgate.com/ViewPoem.aspx?id=34384",""],[4845,"وللشعر ميزان تسمى عَروضَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=134973",""],[5038,"زهرة البلدان","https://www.poetsgate.com/ViewPoem.aspx?id=196716",""],[5160,"مهندسون قد مضينا","https://www.poetsgate.com/ViewPoem.aspx?id=175194",""],[5373,"عِيْلَان والتَّهجِير إلى أوروبا","https://www.poetsgate.com/ViewPoem.aspx?id=186019",""],[5409,"بلغت يا أيها النحات منزلة","https://www.poetsgate.com/ViewPoem.aspx?id=155284",""],[5419,"معزوفة في عينيّ مصر","https://www.poetsgate.com/ViewPoem.aspx?id=32224",""],[5536,"أعطني الناي َ وغنيّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=23194",""],[5631,"النَّزلَةُ الأُولىٰ","https://www.poetsgate.com/ViewPoem.aspx?id=210470",""],[5691,"أحفاد فرعوْن","https://www.poetsgate.com/ViewPoem.aspx?id=206119",""],[402,"مثالي هذا منبىء عن سريرتي","https://www.poetsgate.com/ViewPoem.aspx?id=36508",""],[5865,"لي ما لها","https://www.poetsgate.com/ViewPoem.aspx?id=179859",""],[5953,"يا أيها الأول الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=93785",""],[5956,"زرتُ العقيدَ الأريحيّ المهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=194224",""],[6097,"شَقائقُ ال\"نَيْسَانِ\"","https://www.poetsgate.com/ViewPoem.aspx?id=190671",""]],"verses":[["حَبوْتَنِي بِسَاعَةٍ","وَالخَيْرُ مَا تُؤْثِرُهْ",0,"ر",2,0],["حَبَوْتَ بِهِ خِلاًّ يُوَفِّي بِصَوْتِهِ","كَرَامَةَ وُدِّي وَالوَفِيُّ أَمِينُ",1,"ن",1,0],["حَبَوتَ بِحُسنِ سُمعَتِها وَصيفاً","فَنالَ بِنُبلِها شَرَفَ الفَخارِ",2,"ر",1,0],["حَبَوناهُما الرَفدَينِ حَتّى تَبَيَّنوا","لَنا الفَضلُ مِن مالِ اِبنِ عَمّي وَمَنطِقي",3,"ق",2,0],["حَبَوتُ بِها الجَرمِيَّ إِنّي وَجَدتُهُ","مِنَ الأُسرَةِ الحامينَ عِندَ الحَقائِقِ",4,"ق",1,0],["حَبَوتَ النَصارى بِها مُعلِناً","لَها غَيرَ كاتِمِ أَسرارِها",5,"ر",3,0],["حبوْتَ بها من ليس في الأرض مثلُه","لجيشٍ إذا اصْطكَّ العِرابُ ولا ثَغر",6,"ر",1,0],["حَبَوتُ بِها غَسّانَ إِذ كُنتُ لاحِقاً","بِقَومي وَإِذ أَعيَت عَلَيَّ مَذاهِبي",7,"ب",2,0],["حَبَوتَ بِنُصحِكَ مُستَكبِراً","وَما هُوَ لِلنُصحِ بِالقابِلِ",8,"ل",1,0],["حُبوا بالمُنَى دُونِي وغُودِرْتُ دُونَهُمْ","أَرُودُ الأَمانِي في رِياضِ الأَباطِلِ",9,"ل",1,0],["حُبٌّ وَما كَانَ فِي الصِّبَا جَهْلاَ","بَكَّرَ يَدْعُو فلَمْ تَقُلْ مَهْلاَ",10,"ل",2,1],["حَبَوْتَ بحُسْنِ سُمْعَتِها وَصِيفاً،","فَنَالَ، بِنَيْلِها، شَرَفَ الفَخَارِ",11,"ر",1,0],["حَبَوْتُ بِعا الجَرْميِّ إني وَجَدْتُهُ","مِنَ الأسْرَةِ الحَامِينَ عِندَ الحَقائقِ",12,"ق",1,0],["حَبَوتَ بِها مَن أَمَّ مُلكَكَ عائِلاً","وَعاوَدَ يُرجى جودُهُ وَهوَ آيِبُ",13,"ب",1,0],["حَبَوْكرٌ نَشَبَتْ فيها مَخَالبَها","حتى تكاثرَ فينا الهَمُّ والضَرَرُ",14,"ر",1,0],["حبّ وإعظامُ النبيّ قضى","بحبّهم وبحبّ من يحبّهمُ",15,"م",1,0],["حَبوتكَ بِالتليدِ وبالطريفِ","مِن الآدابِ في ظرف ظريفِ",16,"ف",1,1],["حَبَوتُ به كريماً من قريشٍ","فَسُرَّ به وَصِينَ عن اللئامِ",17,"م",1,0],["حبوتُك مدحاً رقَّ حتى كأنه","لآلئ هلَّت في الليالي بدورها",18,"ر",3,0],["حَبَوتُ أَبا الرَحالِ مِنّي بطَعنَةٍ","يَمُدُّ بِها آتٍ مِن الجَوفِ يَزعَبُ",19,"ب",1,0],["حبوْتَ بها فخرَ الأئمّة فاغتدى","بجمعِهما شملُ المعالي مُلأما",20,"م",2,0],["حبوتكَ دونَ أهل الأرض طرّاً","أوانس عنهمُ فيها نفار",21,"ر",1,0],["حبودك أرباب الجمال وحسنهم","مناظر أصحاب النظافة والتقا",22,"ا",1,0],["حَبَوتُ بِها زَيداً فَزَيَّنتُ ذِكرَهُ","كَما زَيَّنَ السِلكَ الجُمانُ المُنَظَّمُ",23,"م",1,0],["حبوت صرفاً بهوى صرفِ","لأنها في غاية الظرفِ",24,"ف",1,1],["حُبٌ وشُكرٌ وافَياكَ مَعاً وما","وافاكَ حقَّكَ كالمُحِبِّ الشّاكر",25,"ر",1,0],["حبوتهم العقل الذي هو أش","رف الجواهر واستعفيتهم عن مطامع",26,"ع",1,0],["حبوتك ودى صادقا غير ماذق","وكنت بكم في العِّز والهون أفخر",27,"ر",1,0],["حَبَوْتَ بِالحُسْنِ والإِحْسانُ مُبْتَدِئاً","فَفُزْتُ مِنْكَ بِجَنّاتِ ورِضْوانِ",28,"ن",1,0],["حَبَوْتَ الكرى حوباءَ حَنَّتُ لغَيْرِها","فهانَ عليها أَنْ أَبِيْتَ مُسَهَّدا",29,"د",2,0],["حبوا قربوا حبوا وحبوا وشرفوا","وفوا ودنوا فضلا أزيحوا عن الجفا",30,"ف",2,0],["حبوت ملكك حظاً من مشاهدة","فشاهد العين واستغنى عن الخبر",31,"ر",1,0],["حَبَوتُ بِهَا مَولايَ إِذ كُنتُ لاحقَا","بِقَومِي وَمَا أَعيَت عَلَيّ مَذَاهِبِي",32,"ي",1,0],["حبوت به الصهر الذي كان بيننا","وذو الصهر حابٍ صهره ومواصله",33,"ل",2,0],["حَبَوتُكَ حُبَّهُ ما دُمتُ حَيّاً","وَإِنّي بِالوَفاءِ بِهِ قَمينُ",34,"ن",1,0],["حَبَوتُكَ بِالثَّناءِ فَلَم تَثُبني","وَلَم أَترُك لِمُمتَدِحٍ مَقالا",35,"ل",2,0],["حُبُّ وصدٌّ واشتياق إلى","من رشق القلب فما أشوى",36,"و",2,0],["حبوت بها في الدهر أعراض منقر","وأيأست منها كل أطلس طامعِ",37,"ع",1,0],["حبوه أفضل منا يحبى كما زعموا","من غادر فيهم يشكوه مغدور",38,"ر",1,0],["حب وغَرام وعِشْق وهيام","الهِن عَلَى قَلْبي مساطيع",39,"ع",1,0],["حبوري في تحبيرها بقريحة","إذا سوجلت كانتْ أجمَّ القرائح",40,"ح",1,0],["حَبّوا قَرابَتَهُ وَسَبّوا صَحبَهُ","جدلان عند اللَه منتقضان",41,"ن",1,0],["حبوبا كمثل لثاتِ الحبيب","رضاباً أذا شئت أو منظرا",42,"ر",2,0],["حب وَصبر وَحِرمان وَحر جوى","وَمَدمَع وَسهاد دائِم الوَصب",43,"ب",1,0],["حبوا التي من قصدها طالب العز نال","وبات يسقى رحيقاً يورثه الانذهال",44,"ل",1,0],["حَبوتُ بِها صَحن قارورَةٍ","فأَضحَكتُها عَن لِسانِ الضَرامِ",45,"م",1,0],["حبور جلا صرف النعيم بنعمة","يحق عليها الحمد للَه والشكر",46,"ر",1,0],["حبور أفاد اليمن بالمولد الذي","حوى البشر بالإكرام والحلم والرفد",47,"د",1,0],["حبوراً فإن اللَيلَ ناءَت سُدولهُ","وذرَّت شموس الأنس من مفرق الجعد",48,"د",1,0],["حبوتِ الثريا منك قرطاً فَزانَها","كما اِزدنتِ بِالمُختارِ أَحسنَ زينَةِ",49,"ه",1,0],["حُبٌّ وَهَجرٌ عَلى جِسمٍ بِهِ سَقَمٌ","العَيشُ عَن ذا سريعاً سَوفَ يَنصَرِمُ",50,"م",1,1],["حَبَوهُ بِها أَم حَبَوها بِهِ","لَقَد حِرتُ أَيُّهما يَزدَهي",51,"ه",2,1],["حبٌ وحيدٌ في حياتكَ يُغنِها","ويزينها بالحسن والإحسانِ",52,"ن",1,0],["حب وطفوله صمتها يخجل البوح","قداسة الحب الحقيقي عفافه",53,"ف",2,0],["حبونك سحقا مألك الخنسا فأربعا","ففي مقفرات سالما فعلت دوا",54,"ا",1,0],["حَبَوْكِ فُتاتاً مِنْ خَسيسِ عَطائِهِمْ","وَأَنْتِ الَّتي بَحْرٌ يَداكِ وَرافِدُ",55,"د",1,0],["حُبٌ وصِدْقٌ نهْجُنا وتعاونٌ","نمْضِي ودوماً للعلا مِعْراجُنا",56,"ن",2,0],["حُبٌّ وَ فِسْقٌ لَا زَوَاجَ بَيْنَهُمْ","الدَّفْعُ مُكْلِفٌ لِمَنْ يُطَلِّقُ",57,"ق",1,0],["حبوتها بصفاتٍ ما لها أثر","في واقع الأمر إلا في القراطيس",58,"س",1,0],["حبوتُ على ثراكِ الغضِ طفلاً","فبان الحبُّ في القسماتِ غضا",59,"ض",2,0],["حب واعشق واغرق وغامر ولا تطلب حمايه","السنين اللي مضت لك روعتك وروعني",60,"ن",2,0],["حبوتُ على الياقوتِ.. أولَ موطئٍ","طعِمتُ من الجنَّاتِ قِطفا مُخلِّدا",61,"د",2,0],["حُبوا المَناصِبَ أنْواطاً ملَفَّقَةً","على المَناكِبِ والأسْيافُ منْ خَشَبِ",62,"ب",1,0],["حبوت به خلا يوفي بصونه","كرامة ودي والوفي أمين",63,"ن",1,0],["حبٌّ وشوقٌ والبعادُ يؤزّهُم","هيّا تعالي فالسهادُ برانِيا",64,"ي",2,0],["حبوته منك بالعطايا","فهو لها حامد شكور",65,"ر",1,0],["حبٌّ وعطفٌ حكمةٌ وشهامةٌ","وتواصلٌ في الله غيرُ مُبَدّدِ",66,"د",1,0],["حُبٌّ وَوَعْدٌ واهْتِمامٌ بَالِغٌ","وَشًقائقُ ال \"نَيْسَانِ\" تلك القَانِيةْ",67,"ن",3,0]]}