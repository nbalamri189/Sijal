{"poems":[[57,"أيا زهر الملاحة والجمال","https://www.aldiwan.net/poem26184.html","الوافر"],[90,"ألا انهض وشمر أيها الشرق للحرب","https://www.aldiwan.net/poem44471.html","الطويل"],[93,"لعمرك ما حزني لمال فقدته","https://www.aldiwan.net/poem8738.html","عموديه"],[46,"أيا زينة الدنيا وجامع شملها","https://www.aldiwan.net/poem29990.html","الطويل"],[35,"ألا حبذا يوم يقر به الصبا","https://www.aldiwan.net/poem25810.html","الطويل"],[54,"أيا زاعما أن الفضائل حازها","https://www.aldiwan.net/poem26781.html","الطويل"],[77,"أمنك اجتياز البرق يلتاح في الدجى","https://www.aldiwan.net/poem69096.html","الطويل"],[185,"عقيلية أما ملاث إزارها","https://www.aldiwan.net/poem58786.html","الطويل"],[275,"أيا زهرة من حبيبة قلبي","https://www.aldiwan.net/poem35665.html","المتقارب"],[285,"تحراني الزمان بكل خطب","https://www.aldiwan.net/poem60740.html","الوافر"],[408,"سرى طيفها وهنا إلي فحياني","https://www.aldiwan.net/poem46755.html","البسيط"],[487,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[518,"أيا زاعما أني له غاير خالص","https://www.aldiwan.net/poem67737.html","الطويل"],[543,"اسال من الأجفان عن صدره نهرا","https://www.aldiwan.net/poem48140.html","عموديه"],[556,"أيا زائرا بالليل من غير أن يسري","https://www.aldiwan.net/poem47771.html","الطويل"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75740","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119902","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59118","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136252","الطويل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44823","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118337","الوافر"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104811","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109334","المتقارب"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120729","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94247","الطويل"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113884","الطويل"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84475","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85052","الطويل"],[3914,"","https://poetry.dctabudhabi.ae/diwan/poem/116864","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111434","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198234","الطويل"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198187","الطويل"],[4429,"","https://poetry.dctabudhabi.ae/diwan/poem/138861",""],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66098","المتقارب"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4826,"دعيني","https://www.poetsgate.com/ViewPoem.aspx?id=196746",""],[4929,"حسِدتُ على حالي","https://www.poetsgate.com/ViewPoem.aspx?id=202438",""],[4961,"النصفُ الثاني للإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=33329",""],[5038,"زهرة البلدان","https://www.poetsgate.com/ViewPoem.aspx?id=196716",""],[5121,"الأخيل","https://www.poetsgate.com/ViewPoem.aspx?id=34713",""],[5431,"زوجي الحبيب...","https://www.poetsgate.com/ViewPoem.aspx?id=202488",""],[5519,"عطر الصّباح ...!!","https://www.poetsgate.com/ViewPoem.aspx?id=13095",""],[5550,"كفِّي الصُدود","https://www.poetsgate.com/ViewPoem.aspx?id=213892",""],[5626,"أنّاتُ عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=189718",""],[5704,"جفاءٌ .. فصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=191336",""],[5956,"الرَّصيفُ ذو الحصى العسليّ","https://www.poetsgate.com/ViewPoem.aspx?id=184884",""],[6198,"ناي الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79296&r=&rc=70",""],[5519,"عطر الصّباح ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69279&r=&rc=12",""]],"verses":[["أَيا زَهرَ المَلاحَةِ وَالجَمالِ","فُؤادُكِ مِن سَقامِ الحُبِّ خالِ",0,"ل",1,1],["أيا زعماء الغرب هل من دلالة","لديكم على غير الخديعة والكذب",1,"ب",1,0],["أَيا زَهرَةَ الوادي الكَئيبَةَ إِنَّني","حَزينٌ لِما صِرتِ إِلَيهِ كَئيبُ",2,"ب",1,0],["أَيا زينَةَ الدُنيا وَجامِعَ شَملِها","وَمَن عَدلُهُ فيها تَمامُ بَهائِها",3,"ا",3,1],["أَيا زينَةَ الدُنيا الَّتي لا يَنالُها","مُنايَ وَلا يَبدو لِقَلبي صَريمُها",4,"م",3,0],["أَيا زاعِماً أَنَّ الفَضائِلَ حازَها","أَبوهُ اِستَمِع قَولاً يُزيلُ هَراكا",5,"ك",2,1],["أيا زكريّاءَ الأغَرّ أهِبْ بَها","وقائعَ ألهَجْنَ القريضَ فألهِجا",6,"ج",2,0],["أَيَا زَينَةَ الدُّنيا وما مُنتَهَى المُنَى","وَيا أَمَلِى هَل لِى إِلَيكِ سَبِيلُ",7,"ل",1,0],["أيا زهرةً من حبيبةِ قلبي","أريجُكِ فاحَ فنفّس كربي",8,"ب",2,1],["أَيا زَمَنَ اللِّئامِ إِلى مَ حَمْلاً","عَلَيَّ وَبَعْضُ ما حُمِّلْتُ حَسْبِي",9,"ب",2,0],["أيا زائراً من بعد نأي وفرقةٍ","وعاود النومُ أجفاني",10,"ن",2,0],["أيا زمنا قد خنت عهدا وما لنا","يدان بما أبدت عوافص خفان",11,"ن",1,0],["أيا زاعماً أني له غاير خالص","وأني موقفٌ على كل قانص",12,"ص",1,1],["أيَا زَائِرَي فآسٍ إذا ما مَررتُما","بِسِجنٍ حوَى أبنَاءَهُ خُضَّعاً مُرَّا",13,"ر",2,0],["أَيا زائِراً بِالليلِ مِن غيرِ أَنْ يَسري","وهل زائرٌ باللّيل من غير أن يسري",14,"ر",2,1],["أَيا زَمَناً بالجور وَالظلم ملآن","يذكرنا بؤسي سمنجا وَمليان",15,"ن",1,1],["أيا زمنا مرّ لي بالحمى","مضيت حميدا فهل من رجوعِ",16,"ع",1,0],["أيَا زَائِراً وَاللَّيْلُ يَخْضبُ فودَهُ","وَوَلَّى وَفَرْعُ اللَّيْلِ بِالصبْحِ أشْيَبُ",17,"ب",1,0],["اياز من الاقبال كم فيك بهجة","لنا قد مضت لم يأت من بعدها خلف",18,"ف",1,0],["أَيَا زَنَقَاتِ الحُسنِ هَل فِيكِ نَظرةٌ","مِنَ الجُرُفِ الأَعلَى إِلى السِّكَّةِ الغَرَّا",19,"ر",2,0],["أيا زين العباد مع البلاد","ويا زين الحضارة والبوادي",20,"د",2,1],["أَيا زِينَةَ الدُّنيا وَبَهجَةَ أَهلِها","وَعُنوَانَ تاجِ العِزِّ فِى الأُخرَ وَالقَصدَا",21,"د",2,0],["أيا زمن الحبس في جُلق","أطلت عذابي ولم ترفق",22,"ق",1,1],["أيا زَفرَتِي زِيدي ويا عَبرتِي جُودِي","على فاضِلِ الدُّنيا عليِّ بن مسعودِ",23,"د",1,1],["أيا زائراً هذا الضريح لك الهنا","بإمداد من حيى الإله محياه",24,"ا",2,1],["أيا زارع المعروف يا بهجة العيد","ويا من غدت تهنو به أوجه الغيد",25,"د",1,1],["أَيا زُمرة الزُوّار بُلّغتمُ المَدي","وَفزتم ببيت لن يبارحه الندا",26,"د",2,0],["أيا زمن الماضي نسيتك عندما","بدا الحال في استقبال جد على جد",27,"د",1,0],["أيا زهرة المجد والمكرمات","ويا علم الفخر والمأثراتُ",28,"ت",1,1],["أَيا زَفسُ يا مَن بِسامي النُهى","عَلى الإِنسِ وَالجِنِّ طُرّاً سَما",29,"م",2,0],["أَيا زَفسُ يا آثِنا يا أَفُلُّو","أَلاَ ما أَعَدُتم شَبابي فأَبلُو",30,"و",1,0],["أَيا زَفسُ إِمَّا أَيَاسُ وَإِما","ذِيُومِيذُ أَولا فَأَترِيذُ حَتما",30,"م",2,0],["أَيا زَفسُ هَل مِثلِي مَلِيكٌ تَذَلَّلا","وَمِن سُدَّةِ المَجدِ الأَثِيلِ تَنَزَّلا",31,"ل",2,0],["أَيا زَفسُ العَظِيمَ وكُلَّ رَبٍ","أَبِيدُوا كُلَّ حَنَّاثٍ غَرُورٍ",32,"ر",1,0],["أيا زفس رب العلى يا أثينا","وفيبوساً السادة الأعظمينا",33,"ن",2,0],["أيا زفس رب الددون ومولى ال","فلاسج من بان مربعه",33,"ه",1,0],["أيا زفس هل لا إلاهٌ قدير","يرق لحالي به أستجير",34,"ر",1,0],["أيا ( زائد) يهنيك بالتاج والسعد","وإقبالك الميمون في غاية المجد",35,"د",1,1],["أيا ((زائِداً)) مِّني إليكَ قصيدةً","كَعِقْدِ جُمانٍ بالمعَاني تَنَضَّدَا",36,"د",2,0],["أيا زينت لمي عيالك واعلمي","بأنّ بقائي فيكم لقليل",37,"ل",1,0],["أيا زهْرَةً في رياضِ الأَمَلْ","سَقاها النَّدَى",38,"د",2,0],["أَيا زَمَنَ الرَندِ الَّذي بَينَ لَعلَعٍ","تَقَضّى لَنا هَل أَنتَ يا عَصرُ راجِعُ",39,"ع",1,0],["أيا زهرة بين أصحابها","من الحسن تسبي جميع الأنام",40,"م",1,0],["أيا زمن الأوغاد لا ظلت سائدًا","ولا ظل حكم العبد فيك لماجدِ",41,"د",1,0],["أيا زوجَ الجَمَال ِ صداكِ يجري","بتأريخ ِ النبوةِ وهو يُبنى",42,"ن",2,0],["أَيا زَهْرَةَ الْبُلْدانِ جِئْتُ مُعاتِباً","إِلَيْكِ وَمِثْلي في الْعِتابِ يُكابِدُ",43,"د",1,0],["أيَا (زَيْدُ) حُسْنَى لِلْحُرُوفِ خُمُورُهَا","أَطَاحَتْ (بِسِتِّ الحُسْنِ) سُكْراً مُعَلَّقَا",44,"ق",2,0],["أيا زوجي الحبيب وهبت قلبي","ولا أرجو على شغفٍ سواكا",45,"ك",2,1],["أيا زرقة في سمائي تطوف متى تمطرين زلال الدّموع","أيا ظلمة في مداري تسود متى تعشقين الفتى كالشّموع",46,"ع",1,0],["أيَا زَهْرةَ البَان كفِّي الصُدود","فإنِّي صَريعُ الهوى في الوُجودِ",47,"د",1,1],["أيا زهرةَ التفّاحِ إنَّ قصائدي","من الحُزنِ من رَحْمِ المُصيباتِ تولَدُ",48,"د",1,0],["أيا زهري وَيَا نوَّار روضي","نعيم أنت حاشاك العيوبا",49,"ب",2,0],["أيا زهرُ هيّأكَ الربُّ حتى","تقومَ بغسلِ عذابي العريقْ",50,"ق",1,0],["أيا زمناً كان فيه الهوى","يزين أيامه بالدرر",51,"ر",1,0],["أيا زرقة في سمائي تطوف","متى تمطرين زلال الدّموع",52,"ع",1,0]]}