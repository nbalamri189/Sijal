=&rc=15",""],[6191,"مواوِيل الخلاص","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88102&r=&rc=0",""],[6198,"غمز الشموس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79228&r=&rc=1",""]],"verses":[["تَنزِلُ الأَضيافُ مِنهُ وَالمُنى","وَالخِلالُ الغُرُّ في مَرعىً خَصيبِ",0,"ب",1,0],["تَنَزَّلَتْ صُوَراً وَاسْتُكْمِلَتْ سُوَراً","فِي مُصْحَفٍ مِنْ دِعَامَاتٍ وَجُدْرَانِ",1,"ن",1,0],["تَنزو القُلوبُ بِها مِنها إِذا اِشتَمَلَت","في الآلِ أَعلامُها خَوفاً مَعَ القورِ",2,"ر",1,0],["تَنَزَّلَ عَن زيزاءَةِ القُفِ وَاِرتَقى","مِنَ الرَملِ وَاِنقادَت إِلَيهِ المَوارِدُ",3,"د",1,0],["تنزًّل فيه الذكْرُ من عنْدِ ربّنا","فَيُبْدَأُ بالذكر الجميل ويُخْتَمُ",4,"م",1,0],["تنزه في الثغر مبني في","محل العذيب وفي بارق",5,"ق",1,0],["تنزّه في روضة المجتلى","على المرخ من همة اللاصق",5,"ق",1,0],["تُنزِّه الطرف في ذُراها","فلا ترى ثَم غير ثورِ",6,"ر",1,0],["تنزلُ فيها فَتَرى","صَحَارِياً مُشتبههْ",7,"ه",2,0],["تَنزو إِذا صَبَّ فيها الماءَ مارِجُها","نَزوَ الجَنادِبِ مِن رَمضاءَ تَلتَهِبُ",8,"ب",1,0],["تَنَزّى قَلوبُ السامِعينَ تَطَلُّعاً","إِلى خَبَرٍ مُستَوقَفاتٍ رَكائِبُه",9,"ب",2,0],["تَنَزَّه عَنِ الدُنيا وَإِلّا فَإِنَّها","سَتَأتيكَ يَوماً في خَطاطيفِها الحُجنِ",10,"ن",1,0],["تَنَزُّهُ عَتبي عَن خَطاكَ صَوابُ","وَصَمتِيَ عَن رَدِّ الجَوابِ جَوابُ",11,"ب",1,1],["تَنَزَّلَ الدهرُ يوماً عن مشيئته","وحكمِه فَلَهُم في الدهرِ ما شاءوا",12,"ا",1,0],["تُنْزَلُ الطيرُ من الجوِّ به","وتُحَطّ العُصْمُ من شُمّ الرُّيُود",13,"د",1,0],["تُنز جراح أهليهم ويؤذي","منعَّمةَ الخياشيمِ الصديد",14,"د",1,0],["تَنَزَّلَ يُزجِي النَّصرَ تنسابُ من عَلٍ","شآبيبُه نُوراً وينهلُّ وابلُهْ",15,"ل",2,0],["تُنزَعُ الأرزاقُ من أبنائهِ","وتُسَلُّ الأرضُ من فرط النَّهَمْ",16,"م",1,0],["تنزَّهَ في الحياةِ عنِ الدَّنايا","وصينَ عن القوادحِ والعُيوبِ",17,"ب",1,0],["تنزَّلَ من بقايا الوَحْيِ نُوراً","يُضيءُ النَّهجَ للمُترسِّمينا",18,"ن",2,0],["تَنزَّلَ مِن لَدُنْ رَبٍّ رَحيمٍ","عَميمِ الجودِ فَيّاضِ النَّوالِ",19,"ل",1,0],["تَنزو فَواقِعُها مِنها إِذا مُزِجَت","نَزوَ الجَنادِبِ مِن مَرجٍ وَأَفياءِ",20,"ا",2,0],["تَنزو إِذا مَسَّها قَرعُ المِزاجِ كَما","تَنزو الجَنادِبُ أَوقاتَ الظَهيراتِ",21,"ت",1,0],["تَنزو إِذا الماءُ تَراءى لَها","كَما رَمى بِالشَرَرِ الكيرُ",22,"ر",1,0],["تَنزو جَنادِبُها في وَجهِ شارِبِها","مِثلَ الدَبى هاجَهُ طَشٌّ بِقيعانِ",23,"ن",1,0],["تَنَزَّلَ كَاِحتِلابِ الدَرِّ ضاقَت","مَسالِكُهُ فَأَتعَبَ في المِراسِ",24,"س",1,0],["تنزَّهْتَ عن شُبْهةٍ عالمي","ولا رابني فيكَ ما أسمعُ",25,"ع",1,0],["تنزلها أوانس المعاني","بين معين اللفظ والمعان",26,"ن",1,0],["تَنَّزَه عَن مُجالَسَةِ اللِّئامِ","وَأَلمِم بِالكِرامِ بَني الكِرامِ",27,"م",1,1],["تَنَزَّهَتْ عَنْ صِفَةٍ ذَاتُهُ","وَقَامَ فِي لاهُوتِهِ أَوْحَدَا",28,"د",2,0],["تَنَزَّلَ مِنْ أَوْجِ الْعُلى مُتَأَنِّساً","لِيفْتَكَّ أَسْرَى المُوبِقَاتِ مِنَ الأَسْرِ",29,"ر",1,0],["تنزَّه عنْ تَبِعَاتِ المُلُوك","فَخَفَّ على المَلكِ الكاتِبِ",30,"ب",1,0],["تنزهت كفّهُ وكلمته","وعفّ والجوّ لاغطٌ هذره",31,"ر",2,0],["تنزلت في غواشي الروح لائحة ال","اذن الالهي بين الفجر والسحر",32,"ر",1,0],["تنزع المثرى السعيد من الأص","حاب والمال والفراش والوثير",33,"ر",1,0],["تنزهني عن وصمة النقص شيمتي","وحاشاي مثلي لا يخون عهودا",34,"د",2,0],["تنَزَّه الله عن شبه الأنامِ وعن","دَرْكِ العُقُولِ وما في القلب قد خطرا",35,"ر",2,0],["تنَزَّه الله عن إدراكِ مُعتَبِرٍ","اللهُ أعظمُ من دَرْكٍ لما اعتبرا",35,"ر",2,0],["تنَزَّه الله في الأسرار والعَلَنِ","عن أن يضاهَى بما يُرى ويُنتَظرا",35,"ر",2,0],["تَنَزَّهُ عن حَمل الأوانسِ كالدُّمى","وتحمِل في كِيرانها الشُّعثَ والغُبْرا",36,"ر",2,0],["تَنَزَّهَ عَن عُجبٍ مَعَ العِزِّ وَالغِنى","وَزِدتَ مَعَ الإِذلالِ وَالفَقرِ إِعجابا",37,"ب",2,0],["تُنَزِّقُهُ الحَمِيَّةُ حينَ يُعصى","فَيَعروهُ التَطَوُّلُ وَهوَ صائِل",38,"ل",1,0],["تنزل والأملاك والروح حوله","تردده في مهده وتنيمه",39,"م",2,0],["تَنزَّه سَمْعي منهُ في صوتِ طائرٍ","شَدا مُشرئبَّ الجيدِ ثانيّ عطْفِهِ",40,"ف",2,0],["تَنْزوي في الصّرْدِ روحي كُلّما","عَصَف البَيْنُ وَزَلّت قَدَمي",41,"م",2,0],["تَنزل في الْحَلْق بلا حِجاب","فهْي طعامٌ وهْي كالشَّراب",42,"ب",1,0],["تنزّه وجهي في محاسن وجهه","تَنزُّه مشتاقٍ إليه كئيبِ",43,"ب",1,1],["تنزه عن ريب وعيناه عن خنا","وأحشاه عن غدر ويمناه عن ضن",44,"ن",1,0],["تنزَّهتُ في روضٍ خضيلٍ مطلَّلِ","كوجهٍ جميلٍ تحتَ شعرٍ مُسَدَّلِ",45,"ل",1,1],["تنَزّه عن التطواف تلتمسِ الغنى","حسبك بالنزرِ اليسيرِ من الوفر",46,"ر",1,0],["تَنَزَّهَ عَنْ نَيْلِ الْغِنى بِضَراعَةٍ","وَلَيْسَ طَعامُ اللَّيْثِ إِلاّ بِغَصْبِهِ",47,"ب",2,0],["تنزّلَ المَنثورُ مِن رِياضِها","تَنَزُّلَ الأَعلامِ مِن شقاقِها",48,"ق",3,0],["تنزلها من عالم الأمر والهدى","فكن مهتد كما تسود وتعتلي",49,"ل",2,0],["تَنزل القاصِدون في باب فَضلٍ","فَتح الفَوز دونَهُم أقفاله",50,"ل",2,0],["تَنزَّه عَن مثل فَلَيسَ أَخو التُقى","كَمَن يَعبُد اللَه القَدير عَلى حَرفِ",51,"ف",1,0],["تَنَزَّه عَن بَني الدُنيا وَعادِ","أُناساً مِن بَقيّة قَوم عادِ",52,"د",1,1],["تَنَزَّه شِعري عَن أَسافل كُلَّما","يَمُرُّ بِفكري ذِكرها أتَنَهّدُ",53,"د",1,0],["تَنَزَّلْنَ عن دَوْمٍ تَهِفُّ مُتُونُهُ","مُزَيَّنَةٍ أَكْنافُها بالزَّخارِفِ",54,"ف",1,0],["تَنَزَّهُ عن موتٍ وأكلٍ سريعةُ ال","تنقُّل لم تُحجَر بأرضٍ أو السقف",55,"ف",1,0],["تَنَزههُ في وَرد وَجنَتِكَ الغَض","هَجَرت مُحبّاً لَم يَحد عَن وَفائِهِ",56,"ه",1,0],["تنزيه رب العرش لي","بالحق في كل المنابر",57,"ر",1,0],["تنزّهتَ عن أموالِ مَن أنتَ قاتلٌ","فقد جُهلَتْ بين الجيوشِ المَقاسِمٌ",58,"م",1,0],["تنزه القلب عن همٍّ وعن غصصٍ","وكم لها عند أهل المجد من قصصٍ",59,"ص",1,0],["تنزهتُ في دينه عن دنيّةٍ","وشمّرتُ في دُرّاعهِ عن مدرّعِ",60,"ع",1,0],["تنزه عن نزوةٍ للغرور","تَنُّزهَ باسمةِ الأنجم",61,"م",1,0],["تنزّهٌ يُعابُ أو مَحاسنٌ","محسودةٌ محسوبةٌ ذُنوبا",62,"ب",2,0],["تنزو بحُمْسٍ هفت أضغانهم بهم","فحطموا في التراقي كل أمْلودِ",63,"د",1,0],["تنزّه عمّا يوجبُ الذمّ فعلهُ","وراحَ عفيف العينِ واليدِ والأذن",64,"ن",1,0],["تنزه عن الشرك الخفي فإنه","تبدى على كل بأحسن صورة",65,"ه",1,0],["تنزلها من أوج بحر معارف","إلى حضيض الأوهام تستغلق الفكرا",66,"ر",2,0],["تَنزّه عن العوراء مهما سمعتها","صيانةَ نفس فهو بالحرّ أشبه",67,"ه",1,1],["تنزه ناظري في كل يوم","وفكري في مراد أو مراد",68,"د",1,0],["تنزهت عن فخر بمصر وملكها","وقد عده فرعون قاصية الفخر",69,"ر",1,0],["تنزه الخلق المجدي عن عجل","يقضي به 