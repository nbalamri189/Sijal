p?name=Sh3er&doWhat=shqas&qid=10783&r=&rc=3",""],[43,"فديناك من ربع وإن زدتنا كربا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=5442&r=&rc=13",""]],"verses":[["لا مُعدِمٌ يَحميهِ إِعدامُهُ","وَلا يَقي نَفسَ الغَنِيِّ الغِنى",0,"ن",2,0],["لِأَمرٍ يا بَني جُشَمِ","حَبَستُ الماءَ في الأَدَمِ",1,"م",1,1],["لا مُسمِعُ الإِنباضِ مِنهُ فَيُتَّقى","يَوماً وَلا مالي الجَفيرِ نِبالا",2,"ل",2,0],["لا مِنَّةٌ مِنّي عَلى طَلَلٍ","دِيَمٌ طِلاعُ العَينِ أَذرِفُها",3,"ف",3,0],["لا مِثلَ مَن مَلَكَ العُلى مُستَقبَلٌ","فينا وَمَن طَوَتِ المَنونُ مُوَدَّعُ",4,"ع",1,0],["لِأَمثالِها يَسخَرُ الساخِرُ","لَقَد ذَلَّ جارُكَ يا عامِرُ",5,"ر",1,1],["لَأُمطِرَنَّ بَني الدَيّانِ دامِيَةً","هَطلى تُذَمَّ بِها الأَنواءُ وَالمَطَرُ",6,"ر",1,0],["لاموا وَلَو وَجَدوا وَجدي لَقَد عَذروا","وَذَنبُ مَن لامَ ظُلماً غَيرُ مُغتَفَرِ",7,"ر",1,1],["لا مُبغِضُ القَومِ يَبقى","وَلا المُجِلُّ المُحِبُّ",8,"ب",1,0],["لِأَمنَعَ جانِباً وَأُفيدَ عِزّاً","وَعِزُّ المَرءِ ما عَزَّ الجَنابُ",9,"ب",1,0],["لَأَمجَدِ فَرعٍ في عِرانينِ هاشِمٍ","وَأَنجَبِ عودٍ مِن لُؤَيَّ بنِ غالِبِ",10,"ب",1,0],["لا مُمسِكٌ لِلمالِ يُهلِكُهُ","طَلقُ النُجومِ لَدَيهِ كَالنَحسِ",11,"س",1,0],["لاَ مَسكنٌ بِنْتَ عَنْهُ أَنْتَ تَنْدُبُهُ","وَلاَ حَبِيبٌ وَلاَ خِلٌّ وَلاَ سكَنُ",12,"ن",1,0],["لا منّةٌ تُقْتَنى لمُعْتَرَكٍ","ولا لِسانٌ يُبينُ عنْ خَبَرِ",13,"ر",1,0],["لَأُمُّكَ بِالهِجاءِ أَحَقُّ مِنّا","لِما أَبَلَتكَ مِن شَوطِ الفِضاحِ",14,"ح",1,0],["لِاِمرِئٍ يَجعَلُ الأَداةَ لِرَيبِ ال","دَهرِ لا مُسنَدٍ وَلا زُمّالِ",15,"ل",1,0],["لا مَرحَباً بِكَ أَيُّهَذا العامُ","لَم يُرعَ عِندَكَ لِلأُساةِ ذِمامُ",16,"م",1,1],["لا مِصرُ تُنصِفُني وَلا","أَنا عَن مَوَدَّتِها أَريمُ",17,"م",1,0],["لَأَمَّنتَني الخَطبَ الَّذي أَنا خائِفٌ","وَبَلَّغتَني الحَظَّ الَّذي أَنا آمِلُ",18,"ل",1,0],["لَأَميلَ في سُكرِ اللَمى فَيَبيتَ لي","مِمّا حَوى ذاكَ السِوارُ وِسادُ",19,"د",1,0],["لا مُرعِياً مَرعىً لَهُم","ما فاتَني أَمسَيتُ حُرّا",20,"ر",2,0],["لا مِثلَ كَهلِيَ في الكُهولِ","وَلا فَتىً كَفَتاهُما",21,"م",2,0],["لا مُطْفِيءٌ بَرَدَى حَرّاً بِأَنْفُسِهِمْ","وَلا مُعِينٌ عَلَى الطَّاغِي مِنَ الضَّرَمِ",22,"م",1,0],["لا مُبْقِياً لَكَ إِلاَّ","أَدْنَى نَصِيبِ المُسَاهِمْ",23,"م",1,0],["لا مِنَةً أَعلَمُ كَانَت لَها","عِندِي ولاَ تَطلُبُ فِينَا دَمَا",24,"م",2,0],["لاَ مَاؤُهُ مَاءُ أَحسَاءٍ تُقَرِّظُهُ","أَيدي السُقَاةِ وَلا صَادٍ ولا كَرِعُ",25,"ع",1,0],["لآمنتَ موسى من عوادي سميّه","ولولاكّ لم يبرح بخيفة موجِسِ",26,"س",1,0],["لا مصيف ولا شتا","لا نعيم ولا سقر",27,"ر",1,0],["لا مسائي بعد البعاد مساء","يوم بانوا ولا الصباح صباح",28,"ح",1,0],["لا مهر للحسناء إلا حبُّها","فبحبّها كان القران ُمحَبَّبا",29,"ب",2,0],["لا مَهَاذِيرَ في النَّدِيّ مَكَاثِي","رَ ولا مُصمَتِينَ بالإِفحَامِ",30,"م",1,0],["لا مَعَازِيلَ فِي الحُرُوبِ تَنَابِي","لَ ولا رَائِمِينَ بَوَّ اهتِضَامِ",30,"م",1,0],["لا مِن طِلابِ المُحَجَّبَاتِ إذا","ألقى دُونَ المَعَاصِر الحُجبُ",31,"ب",1,0],["لا من تِلادٍ ولا تُراثِ أبٍ","إلا عطاءَ الذي له غَضِبُوا",31,"ب",3,0],["لا مت يا لاحي الشجي على الأسى","وحييت بعد الظاعنين حياته",32,"ت",2,0],["لامُ العذارِ أطالت فيك تسهيدي","كأنَّها لغرامي لامُ توكيد",33,"د",1,1],["لا ما نظر","على المدر",34,"ر",1,0],["لا مثل أقلام بيمنى سعدها","لفظاً وفضلاً كلهنَّ بليغ",35,"غ",1,0],["لامني الفتح إذا عزمت على النأ","ي فقالت ضروراتيَ إيه",36,"ه",1,1],["لامست أسماعهم ….. لكنها","لم تلامس نخوة المعتصم",37,"م",1,0],["لا مادَ رأياً بعدها","لك إن صَدَمْتَ بها عُبَابهْ",38,"ب",2,0],["لا مستهِلٌّ فيه يُكْنى به","غير سُلاحٍ كالمَيازِيبِ",39,"ب",1,0],["لا مَسَّه بعقوبة من رَبِّه","إقْلاقُهُ قلبي ولا إقراحُه",40,"ح",2,0],["لا من قِراف دَنيَّةٍ لكنه","كرم بلا مَذْق ولا تضييحِ",41,"ح",1,0],["لا من خدودٍ سوَّدتْها اللِّحَى","بل من خدودٍ ذاتِ توريدِ",42,"د",1,0],["لا ماءَ إلا رضابُ صاحبِهِ","يطفىء عن قلب ناظِرٍ سُعرَه",43,"ر",2,0],["لا مقبِلٌ منهمُ يشكو تجهُّمَهُ","ولا مولٍّ إذا ولى بملموز",44,"ز",1,0],["لا مُمتَطى الظهرِ ولا مُخَيَّسا","أصْيدَ يأبى رأسُه أن يُعكَسا",45,"س",2,0],["لا مُخطئاً سرقاتٍ","ولا مُصيب فُصوص",46,"ص",1,0],["لا مُقبلينَ إليه لكن هُرَّباً","منه حِذار معاطبٍ ومَوارِط",47,"ط",1,0],["لا مُغِبّاً ندىً ولا مدَدُ اليُسْ","ر من اللَهِ عنكِ بالمقطوع",48,"ع",1,0],["لا ماء فيه ولا نبات وهل","خصب بوادي البوار أو مرع",49,"ع",1,0],["لا مظهراً في عقب نائبة","أسفاً وليس يقوده شعفه",50,"ف",2,0],["لا مظهراً في عقب نائبة","أسفاً وليس يقوده شغفه",51,"ف",2,0],["لأمِّ عليٍّ رَبْرَبٌ فيه آنِسٌ","من العِين مثلِ العين حُفَّتْ بعانِك",52,"ك",1,0],["لا مَطْل فيك لطالبٍ منك الغنى","وإذا طلبتَ فإن شأوَك يمطلُ",53,"ل",1,0],["لا مسَّهُ الدهرُ إلا","بنعمة وسلامِ",54,"م",1,0],["لأموركَ التكميلُ والتتميمُ","ولقدرك التعظيمُ والتفخيمُ",55,"م",1,1],["لامَ في الحُبِّ أُناسٌ","وَهُوَ أَخلاقُ الكِرامِ",56,"م",1,0],["لِأَمرٍ ما صَحِبتُهُمُ","فَلا تَسأَل عَنِ السَبَبِ",57,"ب",1,0],["لامَني فيكِ يا بُثَينَةُ صَحبي","لا تَلوموا قَد أَقرَحَ الحُبُّ قَلبي",58,"ب",2,0],["لا مثلما استخلصته","من عقلي المتطفل",59,"ل",1,0],["لا مِياهُ النيلِ تُروي","ها وَلا أَمواهُ دِجلَه",60,"ل",2,0],["لامَ فيكُم عَذولُهُ وَأَطالا","كَم إِلى كَم يُعالِجُ العُذّالا",61,"ل",2,1],["لاموكَ في جَعلِكَ الإِنسانَ ذِئبَ دَمٍ","وَاليَومَ تَبدو لَهُم مِن ذاكَ أَشياءُ",62,"ا",2,0],["لامَهُ الناسُ وَما أَظلَمَهُم","وَقَليلٌ مَن تَغاضى أَو عَذَر",63,"ر",1,0],["لا متُّ قبلكِ بلْ أَحْيَا وأنتِ معاً","ولا بقيتُ إلى يوم تموتينا",64,"ن",2,1],["لِأَمرٍ أَعَدَّتهُ الخِلافَةُ لِلعِدا","وَسَمَّتهُ دونَ العالَمِ الصارِمَ العَضبا",65,"ب",2,0],["لَأمَةٌ فاضَةٌ أَضاةٌ دِلاصٌ","أَحكَمَت نَسجَها يَدا داوُّدِ",66,"د",1,0],["لامَ أُناسٌ أَبا العَشائِرِ في","جودِ يَدَيهِ بِالعَينِ وَالوَرَقِ",67,"ق",1,1],["لا منه صبغ أمّلوه ولا","فيه على نار السبوك جلد",68,"د",1,0],["لَأَمنَعُ من نفسي عشيّةَ تنتهي","إِلى الحيّ بالبطحاء قعبُ لِبانِ",69,"ن",1,0],["لا مرَّ في خاطرِي تقبيلُ وجنَتِهِ","إنْ كانَ سُلوانُه في خاطِري هَجَسَا",70,"س",2,0],["لَأَمتَسِكَن بِالوُدِّ ما ذَرَّ شارِقٌ","وَما ناحَ قُمرِيٌّ وَما لاحَ كَوكَبُ",71,"ب",1,0],["لامَت مَلامَةَ مُشفِقٍ مُتَعَتِّبِ","وَسَطَت سَطِيَّةَ ناصِحٍ لَم يَكذِبِ",72,"ب",1,1],["لا مُطلِقٌ هَجرُ الحَديثِ إِذا اِحتَبى","فيهِم وَلا شَرِسُ السَجِيَّةِ جاسِ",73,"س",1,0],["لا مِن طَريفٍ جَمَّعَتهُ خِيانَةٌ","ما مِنهُ يَبذُلُ جاهِداً وَيُواسي",73,"س",2,0],["لاموا عَلى لَيلي الطَويلِ وَكُلَّما","عادوا بِلَومٍ كانَ لَيلي أَطوَلا",74,"ل",2,0],["لَأَموتَنَّ بِغَمّى","في هَوى مَن لا أُسَمّي",75,"م",2,1],["لامَت عَلَيَّ أَنَّها في الدَمعِ لَم تَلُمِ","لَكِن عَلى أَنَّ فَيضَ الدَمعِ لَم يَدُمِ",76,"م",1,1],["لَأُمٌّ أَتَتنا بِالوَليدِ خَليفَةً","مِنَ الشَمسِ لَو كانَ اِبنُها البَدرُ أَنجَبُ",77,"ب",1,0],["لَأَمدَحَنَّ بَني المُهَلَّبِ مِدحَةً","غَرّاءَ ظاهِرَةً عَلى الأَشعارِ",78,"ر",1,1],["لا مُكبِرٌ فَرَحاً فيما يُسَرُّ بِهِ","فَإِن أَلَمَّت عَلَيهِ أَزمَةٌ صَبَرا",79,"ر",2,0],["لا مِثلَ يَومِكَ يَومَ حَومَلَ إِذ أَتى","يَومٌ يُفَرِّجُ غَيمُهُ لَم يُمطِرُ",80,"ر",1,0],["لَأَمدَحَنَّكَ مَدحاً لا يُوازِنُهُ","مَدحٌ إِذا أَنشَدَ الراوي بِهِ هَدَرا",81,"ر",2,0],["لَأَمدَحَنَّكَ مَدحاً لا يُوازِنُهُ","مَدحٌ عَلى كُلِّ مَدحٍ كانَ عِليانا",82,"ن",2,0],["لامت قبلك يا أخي لا باخلا","بالنفس عنك ولا تمت قبلي",83,"ي",1,1],["لا مظهر الشكوى ولا متملق","إخوانه المثرين في الإملاق",84,"ق",1,0],["لامعاتٌ كأنَّها الشمسُ أجرَت","ذَهباً ذائباً عليها فَسَالا",85,"ل",2,0],["لِأَمرٍ ما تَصَرَّفَتِ اللَيالي","لِأَمرٍ ما تَحَرَّكَتِ النُجومُ",86,"م",1,0],["لِأَمرٍ ما خُلِقتَ فَما الغُرورُ","لِأَمرٍ ما تُحَثُّ بِكَ الشُهورُ",87,"ر",1,1],["لِأَمرٍ ما بَني حَوّا","ءَ ما نُصِبَت لَكُم صَقَرُ",88,"ر",1,0],["لِأَمرٍ ما تَصَرَّفَتِ اللَيالي","وَأَمرٍ ما تُوُلِّيَتِ النُجومُ",89,"م",1,0],["لامَ عَذولي عَليكُمُ سَفَهاً","وَصارِمُ الحُبِّ يَسبُقُ العَذَلا",90,"ل",2,0],["لامِعُ بَرقِ الغَرامِ يُذكِرُني","رَبعاً لِقَومٍ مِنَ الأَنيسِ خَلا",90,"ل",2,0],["لاموهُ في بَذلِهِ الأَموالَ قُلتُ لَهُم","هَل تَقدِرُ السُحبُ أَلّا تُرسِلَ المَطَرا",91,"ر",2,0],["لأمرٍ طويلِ الهمّ نُزْجي العَرَامِسَا","وتطوي بنا أخفافُهُنَّ البَسابِسا",92,"س",2,1],["لأمرٍ أدَمتَ الحَصرَ في حرْبِ جَرْبةٍ","وما حَرْبُها إلا مُداوَمَةُ الحصرِ",93,"ر",1,0],["لا مُتُّ إِن كانَ الَّذي بُلِّغتَهُ","حَتّى أُرى في صورَةِ اِبنِ الأَعمَشِ",94,"ش",1,0],["لامَتهُ لامَ عَشيرُها وَحَميمُها","مِنها خَلائِقُ قَد أَبَنَّ ذَميمُها",95,"م",3,1],["لا مُلبِسٌ مالَهُ مِن دونِ سائِلِهِ","سِتراً وَلا نا