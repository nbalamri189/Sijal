 حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120280",""],[6113,"الحمد لله بس عدت على خير","https://www.poetsgate.com/ViewPoem.aspx?id=27074",""],[456,"حنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84503&r=&rc=2",""],[6229,"القبّرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65189&r=&rc=15",""],[6229,"شواظ جحيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65205&r=&rc=29",""],[406,"استنكار ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1118&r=&rc=62",""],[463,"إذا فاتها روضُ الحمى وجنوبهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59984&r=&rc=40",""],[6247,"أتدرين أنك أمّ الجمال؟!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80293&r=&rc=32",""],[6259,"تعاتب سعدى إن تنقل دارها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59383&r=&rc=31",""],[6300,"الحرف وإمبراطورية العزف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81630&r=&rc=7",""]],"verses":[["تَحومُ على اللَّبّاتِ حتى كأنّها","إذا أُشْرِعَتْ للطَّعْنِ فيهنَّ أشْطانُ",0,"ن",1,0],["تَحوطُ أمورَ المُلْكِ منْكَ سياسَةٌ","حَباها منَ اللّطْفِ الإلاهيِّ تدْبيرُ",1,"ر",1,0],["تَحولُ رِماحُ الخَطِّ دونَ اِعتِيادِها","وَخَيلٌ تَمَطّى نَحوَ غاياتِها جُردُ",2,"د",1,0],["تحوم علينا بالجراثيم فالردى","إذا هي حامت تلوها وتبيعها",3,"ع",3,0],["تَحوطُ تَميمٌ مَن يَحوطُ حِماهُمُ","وَيَحمي تَميماً مَن لَهُ ذاكَ يُعرَفُ",4,"ف",1,0],["تَحوزُهُمُ وَتَدفُعُهُم عَلَيَّ","فَقَد عاشوا وَلَيسَ لَهُم قُلوبُ",5,"ب",1,0],["تحوم على أيري ولستَ تذوقه","ولو مت فاصبر للحكاك أو اجزع",6,"ع",1,0],["تَحومُ عَلَيهِ المَركَباتُ كَأَنَّهُ","مَليك وَتِلكَ المَركَباتُ لَهُ جُندُ",7,"د",1,0],["تَحولُ عَلى بَدرِهِ المُشرِقِ","كَما اِجتَمَعَت حَولَ نَفسي الغُموم",8,"م",1,0],["تحويكما مائدة في غد","نجِلها مثل التي في الكتاب",9,"ب",1,0],["تَحَوَّلَ عَنها الأَذى وَاِنثَنى","عُبابُ الخُطوبِ وَطوفانُها",10,"ن",3,0],["تَحولُ رِماحُ الخَطِّ دونَ سِبائِهِ","وَتُسبى لَهُ مِن كُلِّ حَيٍّ كَرائِمُه",11,"م",2,0],["تَحوي منَ السُّكْرِ به صُنوفا","وكَبِّرِ الظَّرْفَ تَكُنْ ظَريفا",12,"ف",2,0],["تَحَوَّفَ غَربيَّ القصورِ كأنَّما","رُمينَ على الأيَّامِ منه بمِبرَدِ",13,"د",1,0],["تَحومُ عَلى إِدراكِ ما قَد كُفيتَهُ","وَتُقبِلُ بِالآمالِ فيهِ وَتُدبِرُ",14,"ر",1,0],["تَحولُ السَكينَةُ دونَ الأَذى","بِهِ وَالمُرُوَّةُ دونَ المِراءِ",15,"ا",2,0],["تَحولُ أَموالُهُ عَن عَهدِها أَبَداً","وَلَم يَزُل قَطُّ عَن عَهدٍ وَلَم يَحُلِ",16,"ل",1,0],["تَحوزُ المَعالي وَالعَبيدُ لِعاجِزٍ","وَيَخدُمُ فيها نَفسَهُ البَطَلُ الفَردُ",17,"د",1,0],["تَحَوَّلتُ عَنهُ لَا اِختِياراً وَرُبَّما","وَجَعتُ عَلى طولِ التَلَدُّدِ أَخدَعا",18,"ع",2,0],["تَحُوذُ بِالبُردِ لَها عَبرَةً","جادَت بِها العَينُ وَلم تَفشجِ",19,"ج",1,0],["تَحورُ عَلى الدَهرِ أَحكامُهُ","وَيَأخُذُ ما شاءَ مِنهُ اِقتِراحا",20,"ح",2,0],["تَحوطُ اِبنَ نِهيا يا سَعيدُ كَأَنَّما","تَحوطُ اِمرَأً قَد ناكَ أُمَّ سَعيدِ",21,"د",1,0],["تحومُ حَوْلَها عُقبانُ مَوْتٍ","تَخَطَّفَتِ القُلوبَ منَ الصُّدُورِ",22,"ر",1,0],["تَحوم في الجو طيّا","راتٌ وَتمطر نارا",23,"ر",2,0],["تحوي السَماء نجوماً ذات أَنظمة","من الشموس كثاراً لَيسَ تنحصر",24,"ر",1,1],["تحوم والظلمة فيها تحوم","تبسط مهداً ليّناً للنجوم",25,"م",1,0],["تَحُوطُ العَشِيرَةَ أَفْعالُهُ","وتَحْمِلُ عَنْهُ الذي آدَها",26,"ه",2,1],["تَحَوَّلَ ظِلُّهُ عَنِّي وَأَذْكَى","بِقَلْبِي لَوْعَةً مِثلَ الشِّهَابِ",27,"ب",1,0],["تَحَوَّلَ رَاعِي الصَّبْرِ عَنْ مُسْتَقَرِّهِ","وَبَاحَتْ بِأَسْرَارِ الْقُلُوبِ النَّوَاظِرُ",28,"ر",1,0],["تَحُوكُ بِخَيْطِ الْمُزْنِ مِنْهُ يَدُ الصَّبَا","لَها حُلَّةً تَخْتَالُ فِيهَا الأَبَاطِحُ",29,"ح",1,0],["تَحُومُ الْمَلاَئِكُ مِنْ فَوْقِهِ","كما حَامَ طَيْرٌ عَلَى مَنْهَلِ",30,"ل",1,0],["تحوط أمور الملك منك سياسة","حباها من اللطف الإلهي تدبير",31,"ر",1,0],["تحوم عليها العنكبوت بنسجها","وليس على أمثال تلك تحوم",32,"م",1,0],["تحوَّرَتِ السياسةُ عن مَداها","إلى أنأى مدىً وأقلَّ زادا",33,"د",2,0],["تحولتم عن ركب الحب واستوى","مشوب وداد عندكم وصراح",34,"ح",1,0],["تحولتُ من طبعٍٍ لآخرَ ضدِّه","من الشيمةِ الحسناءِ للشيمةِ النَكرا",35,"ر",2,0],["تحوي عباراته ما شاء من نكتٍ","بديعة تبعث الإعجاب والطربا",36,"ب",2,0],["تَحوى القراطيسُ منها روضةً أُنُفا","فيها مُفاخَرة الظلماءِ للنُّورِ",37,"ر",1,0],["تَحوي العَلاءَ بِهِ فَتَمنَعُ نَيلَهُ","وَالمالُ ساعَةَ يُستَفادُ يُفادُ",38,"د",1,0],["تَحوي الصَحائِفَ مِنها كُلَّما كُتِبَت","عَرفاً هُوَ المِسكُ لا ما تَضمَنُ العِتَرُ",39,"ر",1,0],["تَحوزُ الغِنى جَدواهُ أَوَّلَ وَهلَةٍ","وَيَحسَبُها لَم تُغنِ فَهوَ يُكَرِّرُ",40,"ر",1,0],["تَحوزُ يَداكَ أَبكارَ المَعالي","وَيَأباها رِباؤُكَ وَهيَ عونُ",41,"ن",1,0],["تَحوطُ نِزاراً حَيثُ كانَت وَلا خَلا","جَنابُكَ مِن شُكرٍ وَبابُكَ مِن ذِكرِ",42,"ر",1,0],["تَحوي مِنَ التُركِ وَالأَعرابِ كُلَّ فَتىً","كَأَنَّهُ أَجدَلٌ مُستَلحِمٌ قَطِمُ",43,"م",1,0],["تحومُ روحُ أخي والفَجْعُ يشربُنا","نُخْفي توجُّعَنا في حَشْرجاتِ الآهْ",44,"ا",2,0],["تَحومُ ظِماءً وَالنُحورُ كَأَنَّها","مَناهِلِ وِردٍ وَالرِماحُ قَطاً كُدرُ",45,"ر",1,0],["تحوّل عن مجالسهم بخوضٍ","إذا خاضوا حديثاً لا تباشر",46,"ر",1,0],["تحومُ عليكِ روحي كالفراشِ","فأشعرُ بارتياحٍ وانتِعاشِ",47,"ش",1,1],["تحومُ عليك أنّي سرْت","في شرقِك أو غربك",48,"ك",1,0],["تَحوط حَومتهُ رعياً وتحرسهُ","مِن كلِّ باغٍ بسيفِ الحولِ والحيلِ",49,"ل",1,0],["تَحولُ دُموعُ العَينِ بَيني وَبَينَكُم","وَلا سِيَّما إِن شُبتُها بِنَجيعِ",50,"ع",1,0],["تَحَوَّلَ ذاكَ الحالُ وَاِنصَرَفَ الأَسى","فَمِن زَمَنٍ وَغدٍ إِلى زَمَنٍ رَغدِ",51,"د",1,0],["تحوَّل الليلُ إلى واحةٍ","مشحونةٍ بالوردِ والزَّنبقِ",52,"ق",1,0],["تحوز الريح إن قصدت إليه","قوادمه فليس له مدان",53,"ن",1,0],["تَحوِي مُسلّطَةً عليها يَختَشي","من حدّها الماضِي الحُسامُ المخْذَمُ",54,"م",1,0],["تحوَّل يا زمان إلى الأَعالي","وخذْ بكمالها فالنَّقص تمّا",55,"م",2,0],["تحومُ على مناهله العطاشى","وثمَّةَ مَنْهلٌ عَذْبٌ لِهيمِ",56,"م",1,0],["تحومُ عليه أهل الفضل طرًّا","كما حامَ الظماءُ على غدير",57,"ر",1,0],["تحوي معان من غريّب لفظها","جلّت عن الأثمار بالأكمام",58,"م",1,0],["تحوطُهُ نثرةٌ يُنفَى بلبستِها","عنَّا إذا جدَّ لاعن جسمه الألمُ",59,"م",1,0],["تحومُ الملائكُ من حولِهِ","ويُصبحُ للوَحْيِ دارَ النَّدِي",60,"د",2,0],["تحوم وقد تقلّصتِ الأداوَي","على أجفانِيَ الأبلُ الصوادي",61,"د",2,0],["تحولُ الرماحُ العامريَّةُ دونه","فيقنِطُ راجيه ويعيا طَليبُهُ",62,"ب",2,0],["تحوزُ مفاخرها شيْبُها","وتسمو إلى المجد شُبَّانُها",63,"ن",3,0],["تحوي لك الحمدَ الشَّهير بمادحٍ","أْلقتْ عليه الحادثاتُ بكلْكلِ",64,"ل",1,0],["تحوي القلوبَ له مكاسرُ لُطْفهِ","ويَهابُ سطوته الخميسُ الجحفلُ",65,"ل",1,1],["تحْوي المَزابرُ من مطالب نفسه","ما ليس تحْويهِ الرِّماحُ الذُّبَّلُ",65,"ل",1,0],["تحولت غيري في تغمض أينه","وصرت خليلا عاد ظلي شعاعه",66,"ع",2,0],["تَحولُ من دونِها لجُّ النِصال فلو","رامَ الوصولَ إليها الطّرْفُ لم يصِلِ",67,"ل",1,0],["تحوي بطون دفاتر من ذكره","مافي بطون أسرة ومنابر",68,"ر",1,0],["تحوى البحار اللآلى وهو بحر ندى","نهدي له منه ما قد عزّ في القيم",69,"م",1,0],["تَحوي جيادُنكَ نَهباً كُلَّما وَرَدَت","غُزاً يُرى مِن يَدَيكَ الحَبرُ والوَرِقُ",70,"ق",1,0],["تَحُوطُ ثُغُورَ المُلكِ بِالسّيفِ عُنوَةً","وَيُحقَنُ في إعزازِها بِالدَّمِ الدَّمُ",71,"م",1,0],["تحوي البنون المجدَ عن آبائِهم","أرثاً على مرِّ الزَّمانِ الأطرَدِ",72,"د",1,0],["تَحوي العِتاب وَإِنّها لَمُصيبة","عِندي إِذا عتبت وَلَو بملامِ",73,"م",1,0],["تَحوزُ عَلى حُسنٍ عُقوداً ثَلاثَةً","فَفي نَحرِها عِقد وَعِقدان في الثّغرِ",74,"ر",1,0],["تَحوي الطَّريق القادِريّ مسلسلاً","بِشموسِ فَضلٍ مِثلها لَم يسفِرِ",75,"ر",1,0],["تحولّت الأنفاس منه إلى استه","فما أحدٌ يدري تنفس أم فسا",76,"س",2,0],["تحول الليالي دائما عن عهودنا","وما حال عن عهد قديم ولا ودِّ",77,"د",1,0],["تحوي القلوب بخفة وصناعة","أجفانه فاللحظ منه مشعبذ",78,"ذ",1,0],["تحوي سجايا دون نظم اقلها","نظم اللئالي في بحور قصيدي",79,"د",2,0],["تحولي من فرط الصبابة ظاهر","علي وضعفي مثل ذلك والوهن",80,"ن",1,0],["تحوّل الأَحوالا","تكذب الآمالا",81,"ل",2,0],["تحوب العبد ومشتكاه","بحقّ لا إله إلا اللّه",82,"ه",1,0],["تحوم ذبان الخلا حوله","مثل حمام طار من كف",83,"ف",1,0],["تحوم حواليه طلاَّب علم","وفضل وخلق ومحض الوفاء",84,"ا",2,0],["تحوم الملائكُ حول السرير","تهزّ السرير ولا يَشعُر",85,"ر",1,0],["تحول الملك إِليك يا أَخي","كن بالعلوم للفهوم ساخي",86,"ي",1,0],["تحوِّل كل أفكاري لخيرٍ","وتنقذني من الداء الدرير",87,"ر",1,0],["تحوم على القتلى كحوم حمامة","لدى الدوح جلاها عن الوكر صائد",88,"د",1,0],["تَحَوَّلَ لَون