px?id=196591",""],[5830,"لَوْلاكِ","https://www.poetsgate.com/ViewPoem.aspx?id=201125",""],[5861,"بلسان زوجة مغدورة","https://www.poetsgate.com/ViewPoem.aspx?id=190742",""],[5943,"كِبْرُكَ الخدَّاعُ مانعْ","https://www.poetsgate.com/ViewPoem.aspx?id=11261",""],[5956,"الخيال وأفراح الإفراج","https://www.poetsgate.com/ViewPoem.aspx?id=194699",""],[5991,"يا ألمي منك إليك الفرار","https://www.poetsgate.com/ViewPoem.aspx?id=116385",""],[6120,"يَحِنُّ قَلبِي لِأيَّامٍ مِنَ الغَزَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=213518",""],[6129,"وسقط صدام ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74362&r=&rc=0",""],[6300,"بقايا الزمن المرّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82864&r=&rc=35",""]],"verses":[["ذُقتَ في غُربَةِ الحَياةِ عَناءً","فَذُقِ اليَومَ راحَةً في الإِيابِ",0,"ب",1,0],["ذُقتُ طَعمَ الأَسى وَكابَدتُ عَيشاً","دونَ شُربي قَذاهُ شُربُ الحِمامِ",1,"م",1,0],["ذُقتُ الأَمَرَّينِ مِنهُ","فَسَل سَليماً وَسَلني",2,"ن",2,0],["ذَقنُ عَبدِ الرَحيمِ مَع شارِبَيهِ","وَعَذارَيهِ في اِستِ عَبدِ الرَحيمِ",3,"م",1,1],["ذقنا قليلاً من نعيم الثواء","ثم نهضنا كخفاف الظباء",4,"ا",2,0],["ذُقْتَ أَحْدَاثَهَا تُمِرُّ وَتَحْلُو","فِي ظُرُوفٍ حَدِيثُهُنَّ شجُونُ",5,"ن",1,0],["ذَقنٌ ناقِصٌ وَأَنفٌ طَويلٌ","وَجَبينٌ كَساجَةِ القُسطارِ",6,"ر",1,0],["ذقتُ الطعوم فما التذذت كراحةٍ","من صحبة الأشرار والأخيارِ",7,"ر",1,1],["ذقِ الهون والذل الطويل عقوبة","كذا كل وجه لا يعف ويقنع",8,"ع",1,0],["ذق عقاب العذر واعلم","أنه غير مطاق",9,"ق",1,0],["ذُقْ أبا جعفر مغبَّةَ جُرْمِكْ","واجْنِ ما أثْمرتْ سفاهةُ حِلْمِكْ",10,"ك",1,1],["ذُقتُ الهَوى وَعَرَفتُهُ في شَطِّهِ","إِنَّ الهَوى لِلمَرءِ كَالميلادِ",11,"د",1,0],["ذُقتُ في بُعدِكَ ما هوَّ","نَ في القُربِ جَفاكا",12,"ك",2,0],["ذقت منها حلوا ومرا وكانت","لذة العشق في اختلاف المذاق",13,"ق",1,0],["ذُقتُ صَدَّهُ","غَيرَ مُحتَسِب",14,"ب",1,0],["ذُقنا الصُدودَ فَلَمّا اِقتادَ أَرسُنَنا","حَنَّت حَنينَ عَجولٍ بَينَنا الرَحِمُ",15,"م",1,0],["ذُقت بِها مِنكِ أَلَذ الهَوى","فَكَيفَ أَنساك وَأَنساها",16,"ا",3,0],["ذقتُها كالحُلمِ في ريِّق عُمري","قُبْلةً عذراءَ من ثغْرٍ حييِّ",17,"ي",1,0],["ذُقتِ في الغربة وجداً وسَقاما","أتُراها لم تَطِبْ مصرُ مُقاما",18,"م",2,0],["ذُقتُها ثَلاثَ دَوا","هٍ عَلى تَمَرُّرِها",19,"ر",3,0],["ذُقتُ حماماً وَذُقتُ ثكلاً","حرَّم مِن بَعدِكَ اللّذاذا",20,"ذ",2,0],["ذق خمرة الحانيات لا الحان","دنانها بسمة وعينان",21,"ن",1,1],["ذُقتُ طَعمَ الهَوى مَعَ الهَجرِ مُرّاً","وَهوَ إِن مازَجَ الوِصالَ لَذيذُ",22,"ذ",1,0],["ذُقتُ الهوى وكأنّني ما ذُقتُه","حتى دخَلتُ ولامست يدها يدي",23,"د",2,0],["ذقتُ طعمَي تفرُّقٍ ولقاءٍ","كدتُ من فرط ذا وذا أن أهيما",24,"م",2,0],["ذُقتُمُ الحُبَّ في مَجالي جَمالِه","بَينَ رَقصِ الأَجسادِ وَالأَوتارِ",25,"ر",1,0],["ذُقتُمُ الراحَ في اِختِلافِ كُؤوسِه","وَتَفَلتُم عَلى يَدِ العَصّارِ",25,"ر",1,0],["ذُقتُ المَرارَةَ صرفاً","وَما تَحَمَّلتُ بُعدك",26,"ك",1,0],["ذقت ندى راحته مرةً","فطعمه في جوف أضراسي",27,"ي",1,0],["ذُقِ الْمَلامَةَ مَحْقُوقاً فَما ظَلَمَتْ","كَأْسُ النَّدامَةِ إِنْ جُرِّعْتَها غُصَصا",28,"ص",2,0],["ذقت في موتك ما ذقت","وما زلت صبورا",29,"ر",2,0],["ذقت في أمنك يا ليل رحيق الأمنيات","وعلى صدرك يا ليل ترامت زفراتي",30,"ي",1,0],["ذق يا عذول الذي ذاقوه تَدْرِ بما","جهلته وترى مدح السُّلُوِّ هِجَا",31,"ج",2,0],["ذقت طعم الحياة حلواً ومراً","وبلوت الزمان حرباً وسلما",32,"م",2,0],["ذقِ النميرَ الذي استعذبتَ مشربَه","جهلاً فأصبحتَ لّما غاضَ مُلتاحا",33,"ح",2,0],["ذُقْتُ منهُ خمرَ المحبَّةِ طِفْلاً","يا لذوقٍ من أَشرَفِ الأَذْوَاقِ",34,"ق",1,0],["ذقت الحمام كما أذقت ولستما","سيين لولا العدل في الأحكام",35,"م",1,0],["ذُقْتُ مِنْها منَّ لَفْظٍ","كان بالسَلْوى كفيلا",36,"ل",2,0],["ذُقتَ الهَوَى صِرْفاً وما كُلُّ الهَوَى","يَجِدُ الفتى فيهِ السبيلَ لعائبِ",37,"ب",1,0],["ذُقتُ الصَّبابةَ في الشَبيبةِ أمرَداً","واليومَ شِبتُ فهل تليقُ بأشَيبِ",38,"ب",1,0],["ذقتُ منها عسلاً من لَعَسٍ","آه واشوقي لذاكَ اللَّعَسْ",39,"س",1,0],["ذُقِ العِشقَ واعذُل إن قَدَرتَ فإنَّما","يُعنِّفُ أهلَ العِشقِ مَن لَيسَ يَعشَقُ",40,"ق",1,0],["ذُقتَ المَنيَّةَ حاسِراً ولَطالَما","خُضتَ المَنيَّةَ حاسِرا ومُدَرَّعا",41,"ع",2,0],["ذقها وعبرها إلي","تشمني نشر العبير",42,"ر",1,0],["ذقنا بدوق السيوف من دمه","مرارة فاقت المرارات",43,"ت",1,0],["ذقتُ طعم النُّعمى التي سَلَفَت من","ك فألفيتُهُ كريهَ المذاق",44,"ق",1,0],["ذُق غصة المَوت وَاِمضِ عَنّي","فَالمَوت أَولى بِهِ الجَبان",45,"ن",1,0],["ذقت منها ما ذاقه كل صب","حين لاقى بعد الفراق خليله",46,"ل",2,0],["ذقت ذا الثكل قبله ثم أمسى","لي شريكاً فنحن فيه سواء",47,"ا",2,0],["ذقتها في مطلع العمر وهل","أرتوي حبا وهل أروي السنين",48,"ن",1,0],["ذُقتَ جَناهُ انساغَ عَذباً فِي اللُّهَى","يُعلَمُ خِصبُ العامِ مِن نَيسَانِهِ",49,"ه",1,0],["ذق الهوى مرةً وبعدئذٍ","إن تستطع لومةً به فلم",50,"م",1,0],["ذق يا حَبيبي","حب الحَبيب",51,"ب",1,0],["ذقت ما أحيا شبابي","منه لكن مت سكرا",52,"ر",2,0],["ذق علقم الأرزاء مصطبراً","حتّى يجيبك بعدها العسل",53,"ل",1,0],["ذُقتُ فيكَ الصَبرَ مِن صَبري وقد","كُنتُ خُلواً حالِيَ العيشِ مُهَنَّا",54,"ن",2,0],["ذق مرّ ما استحسنته وجنيته","لا ينكر المغرور صرعة عجبه",55,"ب",2,0],["ذُق أشدَّ العذابِ يا شرَّ غاوٍ","أبعدَ النورَ عن بني الإنسانِ",56,"ن",1,0],["ذقت لظاها ويك فانقذ فتى","معذبا فيك بعذب الورود",57,"د",1,0],["ذقتُ يوم النوى صنوف عذابٍ","جعلتني اهيم في الفلوات",58,"ت",1,0],["ذقت منه لذة العيش وما","راق في عيني الهنا حتى انتفي",59,"ف",2,0],["ذُقت مِن فيك نَهلة وَمحال","مدة العُمر مثلَها أن أَذوقا",60,"ق",2,0],["ذق يا عَذول سلاف مأخذ حبهم","فلكل شيء في البَريَّة مأَخذ",61,"ذ",1,0],["ذق عذب طن الهوى قبل الملام ولم","فدون فائده لم يحل تفنيد",62,"د",1,0],["ذقنُ المعينِ الجزري","جَميعُها في قَذَري",63,"ر",2,1],["ذقت الذي قد ذاقه","وأمر لكني صلب",64,"ب",1,0],["ذقت الحياة بحلوها وبمرها","وعرفت كل مخبّأ من أمرها",65,"ه",2,1],["ذق لذة الحب والتصابي","لتعذر المغرم المفند",66,"د",1,0],["ذقت مرّ الصدود منك مراراً","فاسقني مرّة من الرّيق شهدا",67,"د",2,0],["ذقِ القربَ تشدّد ناجذيك على التقى","فمن كانَ ذا ذوق يُبادر إلى النجذ",68,"ذ",1,0],["ذقت النوائب يافعا وخبرتها","طفلا وجرعني الزمان شديدها",69,"د",3,0],["ذُقنَا الثَّنَاءَ فلم نَألُ الجزَاءَ بِهِ","وَقَد جَهِدنَا وَمَافي نُصحنَا وَخَمُ",70,"م",1,0],["ذُقِ الموتَ إن شِئتَ العُلى وَاطعَمِ الردى","فَنيلُ الأَمَاني بالمنيَّةِ مَكسوبُ",71,"ب",1,0],["ذُقتُ طَعمَ الاثنينِ حُلواً وَمُرّاً","وَتَبيَّنتُ مَوقفي في الجَميعِ",72,"ع",1,0],["ذُقتُ فيها الحَياةَ طَعماً جَديداً","طَيِّباً فَوقَ طيب كلّ طَعامِ",73,"م",1,0],["ذقتُ وَاللَّهِ طعمَهُ في مَنامي","حينَما لامَست شِفاهي الشِفاهُ",74,"ا",2,0],["ذقتُ من صابِ هجركم كل لاظ","كدت منه أسقى بكأس الفواظِ",75,"ظ",1,0],["ذقتُها محنظَلَةً","حين ماؤها شَبِمُ",76,"م",1,0],["ذقتُ وما ذاقت ولم نفترق","أشم أنفاسا لها تعطر ُ",77,"ر",1,0],["ذقت من كاس الزمان المر والهقوة جموح","مير يعثرها على منهاضها الوقت الشحيح",78,"ح",1,0],["ذقت المراره عنك واعطيك حالي","وخذ من تجاريبي من العمر بقياس",79,"س",1,0],["ذق علقم الأرزاء مصطبراً","حتّى يجبيّك بعدها العسل",80,"ل",1,0],["\"ذقْ مثلما جرّعتني ألمَ النوى\"","وتركتني بعدَ امتلاككَ معدماً",81,"م",2,1],["ذُقْ ما رشفتَ من الأسى بعد الرضا","أينَ اختباؤُكَ والدياجي تلحَقُ؟",82,"ق",1,0],["ذقنا من الظلمِ ما شاختْ مفارقنا","منهُ احتراقاً وضاقَ الدمعُ في الحَدَقِ",83,"ق",1,0],["ذُقْ طعمَ قولِكَ قبلَ أن تُفضِي بِهِ","فإذا اسْتَسَاغَكَ طعْمُهُ فانطقْ بهِ",84,"ب",2,0],["«ذُق مِثلما جرّعتَني ألمَ الجَوَى»","حَاشَاه مِنْ ألمِ الجوَى حَاشَاهُ",85,"ا",2,0],["ذُق شُواظاً لو مسّه صاهرُ الأغْ","لال أضحى بناره يتعبّدْ",86,"د",1,0],["ذُقْ طَعْمَ عِشْقِى وَاسْتَجِبْ لِحَنَانِي","فَالْهَجْرُ مُذْ غَرَّبْتَنِي أَدْمَانِي",87,"ن",2,1],["ذُقْتُ العَذَابَ فَطعْمُهُ بيَ لمْ يزلْ","... رُوحِي بهِ كَالجُثَّةِ المُتنَاسِيَهْ",88,"ي",2,1],["ذُقْتُ دَمْعِي صَارَ شَهْدِي","يَوْمَ غَابَ الْهَمُّ جَزْرَا",89,"ر",2,0],["ذقت ذاك الشراب لا اسلو","بسراب بقيعة الخطرات",90,"ت",1,0],["ذُقنَا مَصيرَ الغَافلِينَ عِشيةً","ثُمَ انْتبهنَا بَعدَ أَنْ سَقَط اللثَام",91,"م",1,0],["ذُقْنا مِنَ الدُّنْيا الجَّفاءَ بقَدْرِ ما","كُنّا نُجافيها وكانتْ تَبْرُقُ",92,"ق",1,0],["ذُقْتُ الحلاوةَ كلَّما زادَ ارتشافي","لذةً ،أرخيتُ لثْمَ هُيَامي",93,"م",2,0],["ذقنا وضقنا بمرِّ الصبر في وطن ٍ","حتى انْتفضنا وفاض الكأس من غضبِ",94,"ب",1,0],["ذقنا العصور فكانت في مطاعمها","صبراً وكان لنا في طعمه عسلا",95,"ل",2,0],["ذقتُ الحروف جميعها","تلك الحروف الأعذب",96,"ب",1,0],["ذق حروفا من قبل أن تجتبيها","كلّ حرف من دون نزفٍ حرامُ",97,"م",1,0],["ذق سعير الغرام واصبر فما تج","ديك شكوى تحرق الأفلاذ",98,"ذ",1,0],["ذُقْنا المَصائِبَ تتْرى","ودَبَّ فينا الشِّقاقُ",99,"ق",1,0],["ذق لَمَاها وضُمّ موجة ثديي","ها فإن الحياء دِين رقيق",100,"ق",1,0],["ذقناه بأساً لاعقا بدمائنا","نحن الثكالى والضحايا ترمعُ",101,"ع",1,0],["ذُقتُ الهوى ياليتَني ماذُقتُهُ","إنّ الهوى مُرُّ المذاقَةِ ألذَعُ",102,"ع",1,0],["ذُقتُ الهوى فأنبرَت عَجلى مذاقتُهُ","على لساني كطعمِ الصابِ والَزَهَرِ٨",103,"ر",1,0],["ذق كروم الله ذق عنّابها","وابتهل يا قلب في محرابها",104,"ه",2,1],["ذُقْنَا خُمُوراً قَدْ تَعَتَّقَ سِحْرُهَا","أَخْرَجْتُ كَنْزَكِ كَانَ ثَمَّ بَعِيدَا",105,"د",2,0],["ذُقْتُ الحَلاوَةَ كُلَّهَا فِي ضَمَّةٍ","فَالكَوْنُ شَدْوٌ يَعْشِقُ التَرْدِيدَا",105,"د",2,0],["ذق طعم حنظلك الذي قد لكته","فغدا ستلقى ما راى رب الفضا",106,"ض",2,0],["ذقتَ مُرَّاً في جدالٍ","جَاهِلاً فيهِ تُرافعْ",107,"ع",1,0],["ذقتُ فيها خير شهدٍ","بسواها ذقتُ حمضا",108,"ض",2,0],["ذقتك من كل طعامٍ لذيذ","مختفياً ملتفعاً في سرار",109,"ر",1,0],["ذُقْتُ الْغَرَامَ لِأيَّامٍ مُعَدِّدَةٍ","لَٰكِنَّهَا احتَوَتْ قَلْبِي وَلَمْ تَزلِ",110,"ل",1,0],["ذق أيها النذل!.. فالتاريخ مؤتمن","ولن ترى مقلة تبكي لكم أبدا!",111,"د",2,0],["ذقْ جُنوني أو فَمُتْ في سَاحَتي","إنّما الحُبُّ نزيفٌ وألَم ْ",112,"م",1,1]]}