{"poems":[[86,"دمعة من دموع عهد الشباب","https://www.aldiwan.net/poem10372.html","الخفيف"],[86,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[86,"يا يوم تكريم حفني","https://www.aldiwan.net/poem68862.html","المجتث"],[71,"ذقن عبد الرحيم مع شاربيه","https://www.aldiwan.net/poem3819.html","الخفيف"],[93,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[93,"لحق اليوم بالرفاق أمين","https://www.aldiwan.net/poem11209.html","الخفيف"],[54,"اصرميني يا خلقة المجدار","https://www.aldiwan.net/poem27561.html","الخفيف"],[51,"ذقت الطعوم فما التذذت كراحة","https://www.aldiwan.net/poem62995.html","الكامل"],[51,"لما تؤذن الدنيا به من شرورها","https://www.aldiwan.net/poem65430.html","الطويل"],[51,"كان أناس يرون أني في","https://www.aldiwan.net/poem65695.html","المنسرح"],[51,"ذق أبا جعفر مغبة جرمك","https://www.aldiwan.net/poem65807.html","الخفيف"],[91,"قل للحمائم في ضفاف الوادي","https://www.aldiwan.net/poem8798.html","عموديه"],[70,"أيها الغائب قد آن","https://www.aldiwan.net/poem42778.html","مجزوء الرمل"],[85,"جئننا بالشعور والحداق","https://www.aldiwan.net/poem7534.html","الخفيف"],[85,"مال واحتجب","https://www.aldiwan.net/poem63725.html","مجزوء المتدارك"],[44,"شعبي وشعب عبيد الله ملتئم","https://www.aldiwan.net/poem29705.html","البسيط"],[102,"رسالة واها لها واها","https://www.aldiwan.net/poem33108.html","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39634","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43840","البسيط"]],"verses":[["ذُقتَ في غُربَةِ الحَياةِ عَناءً","فَذُقِ اليَومَ راحَةً في الإِيابِ",0,"ب",1,0],["ذُقتُ طَعمَ الأَسى وَكابَدتُ عَيشاً","دونَ شُربي قَذاهُ شُربُ الحِمامِ",1,"م",1,0],["ذُقتُ الأَمَرَّينِ مِنهُ","فَسَل سَليماً وَسَلني",2,"ي",1,0],["ذَقنُ عَبدِ الرَحيمِ مَع شارِبَيهِ","وَعَذارَيهِ في اِستِ عَبدِ الرَحيمِ",3,"م",1,1],["ذقنا قليلاً من نعيم الثواء","ثم نهضنا كخفاف الظباء",4,"ا",2,0],["ذُقْتَ أَحْدَاثَهَا تُمِرُّ وَتَحْلُو","فِي ظُرُوفٍ حَدِيثُهُنَّ شجُونُ",5,"ن",1,0],["ذَقنٌ ناقِصٌ وَأَنفٌ طَويلٌ","وَجَبينٌ كَساجَةِ القُسطارِ",6,"ر",1,0],["ذقتُ الطعوم فما التذذت كراحةٍ","من صحبة الأشرار والأخيارِ",7,"ر",1,1],["ذقِ الهون والذل الطويل عقوبة","كذا كل وجه لا يعف ويقنع",8,"ع",1,0],["ذق عقاب العذر واعلم","أنه غير مطاق",9,"ق",1,0],["ذُقْ أبا جعفر مغبَّةَ جُرْمِكْ","واجْنِ ما أثْمرتْ سفاهةُ حِلْمِكْ",10,"ك",1,1],["ذُقتُ الهَوى وَعَرَفتُهُ في شَطِّهِ","إِنَّ الهَوى لِلمَرءِ كَالميلادِ",11,"د",1,0],["ذُقتُ في بُعدِكَ ما هوَّ","نَ في القُربِ جَفاكا",12,"ك",2,0],["ذقت منها حلوا ومرا وكانت","لذة العشق في اختلاف المذاق",13,"ق",1,0],["ذُقتُ صَدَّهُ","غَيرَ مُحتَسِب",14,"ب",1,0],["ذُقنا الصُدودَ فَلَمّا اِقتادَ أَرسُنَنا","حَنَّت حَنينَ عَجولٍ بَينَنا الرَحِمُ",15,"م",1,0],["ذُقت بِها مِنكِ أَلَذ الهَوى","فَكَيفَ أَنساك وَأَنساها",16,"ا",3,0],["ذقتُها كالحُلمِ في ريِّق عُمري","قُبْلةً عذراءَ من ثغْرٍ حييِّ",17,"ي",1,0],["ذُقتِ في الغربة وجداً وسَقاما","أتُراها لم تَطِبْ مصرُ مُقاما",18,"م",2,0],["ذُقتُها ثَلاثَ دَوا","هٍ عَلى تَمَرُّرِها",19,"ر",3,0],["ذُقتُ حماماً وَذُقتُ ثكلاً","حرَّم مِن بَعدِكَ اللّذاذا",20,"ذ",2,0]]}