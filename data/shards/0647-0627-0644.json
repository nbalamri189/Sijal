{"poems":[[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[88,"أعجمي كاد يعلو نجمه","https://www.aldiwan.net/poem68943.html","الرمل"],[93,"لو رأى آدم فتاه لزال الحقد","https://www.aldiwan.net/poem8729.html","عموديه"],[93,"الأربعون لو انها تتكلم","https://www.aldiwan.net/poem62688.html","عموديه"],[94,"كم من عهود عذبة","https://www.aldiwan.net/poem38946.html","مجزوء الكامل"],[87,"يا ابن زيدون مرحبا","https://www.aldiwan.net/poem8080.html","مجزوء الخفيف"],[87,"هالة للهلال فيها اعتصام","https://www.aldiwan.net/poem62829.html","الخفيف"],[107,"يا بني سعد بن بكر مرحبا","https://www.aldiwan.net/poem43987.html","الرمل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16699","السريع"],[108,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[347,"في كريم المرابع","https://www.aldiwan.net/poem55315.html","مجزوء الخفيف"],[376,"يا علي بن حميد","https://www.aldiwan.net/poem56998.html","مجزوء الرمل"],[463,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[556,"بنقا الرمث من شراف غزال","https://www.aldiwan.net/poem47338.html","الخفيف"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137348",""],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101486","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70907","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56639","المتقارب"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48986","الكامل"],[1759,"","https://poetry.dctabudhabi.ae/diwan/poem/107342","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126226","الخفيف"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84537","البسيط"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131966","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91618","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91504","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205758","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44893","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86475","الخفيف"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93252","المنسرح"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97085","الرمل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83663","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83664","الخفيف"],[4728,"الأمل قبلة أمل","https://www.poetsgate.com/ViewPoem.aspx?id=176950",""],[4728,"الطفل ودموع الأمتين","https://www.poetsgate.com/ViewPoem.aspx?id=176955",""],[4119,"واحربا في الثغور من بلد","https://www.poetsgate.com/ViewPoem.aspx?id=16144",""],[5038,"جمرة الخدين","https://www.poetsgate.com/ViewPoem.aspx?id=197669",""],[3271,"ثورة الإسلام في بدر","https://www.poetsgate.com/ViewPoem.aspx?id=103535",""],[5145,"حكم اعتساف قضية الأزمان","https://www.poetsgate.com/ViewPoem.aspx?id=108117",""],[5194,"عيون الحبيبه","https://www.poetsgate.com/ViewPoem.aspx?id=34326",""],[5320,"ولدى","https://www.poetsgate.com/ViewPoem.aspx?id=43105",""],[5324,"حالة حب.","https://www.poetsgate.com/ViewPoem.aspx?id=212667",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[5377,"إلى الغاضبين علينا","https://www.poetsgate.com/ViewPoem.aspx?id=61899",""],[5455,"سحابه","https://www.poetsgate.com/ViewPoem.aspx?id=34425",""],[5848,"أيات الصبر","https://www.poetsgate.com/ViewPoem.aspx?id=48976",""],[5848,"حزني معيّد","https://www.poetsgate.com/ViewPoem.aspx?id=49000",""],[5848,"أحد ينام وحط راسه","https://www.poetsgate.com/ViewPoem.aspx?id=48835",""],[5922,"محاورة النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=185133",""],[6056,"كفيّ ، طوّ قت معصمه","https://www.poetsgate.com/ViewPoem.aspx?id=130137",""],[6142,"مل بنا يا هديت ننتجع الحق","https://www.poetsgate.com/ViewPoem.aspx?id=155693",""],[6199,"نزيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79700&r=&rc=21",""],[6290,"لَكَ فِي الْأَفْئِدَةِ الْغَرَّاءِ حُبٌّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85517&r=&rc=35",""],[6359,"عمّان البلد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69088&r=&rc=2",""]],"verses":[["هَأُلى ثُمَّ هَأُلى كُلّاً اِعطَي","تَ نِعالاً مَحذُوَّةً بِمِثالِ",0,"ل",1,0],["هالَهُ أَلّا يَراها حُرَّةً","تَمتَطي في البَحثِ مَتنَ الكَوكَبِ",1,"ب",1,0],["هالَها أَن تَرى مِنَ الأُنسِ قَوماً","يَتَهادَونَ مِثلَها في الفَضاءِ",2,"ا",2,0],["هَأُلاءُ دودُ القَزِّ أَحسَنُ مِنهُمُ","وَأَجَلُّ في نَظَرِ الحَياةِ وَأَفهَمُ",3,"م",1,0],["هالتْهُ أَشْباحُ الظَّلامِ","وراعَهُ صوتُ القُبورْ",4,"ر",1,0],["هالَةٌ أَطلَعَتكَ في","ذِروَةِ المَجدِ كَوكَبا",5,"ب",2,0],["هالَةٌ لِلهِلالِ فيها اِعتِصامُ","كَيفَ حامَت حِيالَها الأَيّامُ",6,"م",1,1],["هالكٌ من ظنّ ممّن يَعتدِي","ويُعادِي اللّهَ أن لن يُغلبَا",7,"ب",2,0],["هالَتْ وما هِيلَتْ وفاضَتْ على الصْ","صَاعِ ولم يُمْلأ بها صاعُ كَيْل",8,"ل",1,0],["هالهُ فتحٌ ترامي أفْقُه","وأَذانٌ ردَّدَ الكونُ صداه",9,"ا",2,0],["هالَهم أمرهُ فَخافوا وما هم","بعدَ حينٍ من فتكه أمناءُ",10,"ا",2,0],["هالني ما اراه من","بدع أو بدائع",11,"ع",1,0],["هالِكاً لا سالِكاً مَس","لَكَ حُزنٍ لا حُزُونِ",12,"ن",1,0],["هالوا الترابَ على دقيقٍ شخصُهُ","معنى التراب وقد حواه جليلُ",13,"ل",1,0],["هالنِي فيك بالفراقِ وقد كُنْ","تُ بما في صُروفهِ لا أُهالُ",14,"ل",1,0],["هالهُ ما رآهُ في كل قُطرٍ","من زحامٍ على النقودِ شديد",15,"د",1,0],["هالها الأمرُ أعولت ثم وَلَّت","دون جدوى من فاسدِ الحوباءِ",16,"ا",2,0],["هالكٌ من ألهاه عن دينه أو","لادُه معْ تكاثر الأموالِ",17,"ل",1,0],["هالك تشكو كما كنت تشكي","ويجري بما لا تشاء القدر",18,"ر",1,0],["هالُوا على التبرِ التُّرابَ وقلَّدوا","جيدَ الثَّرَى يقلائدِ المَرجانِ",19,"ن",1,0],["هالَنا هيلُكُم تلكَ المَعا","ني علينا فاقنَعُوا بالوزنِ مِنَّا",20,"ن",2,0],["هالها الروعُ فاستحالت هَبَاءً","غيَّرَ الصَّدعُ حالها والفَنَاء",21,"ا",2,0],["هالِكُ الكونِ ساحت سِرتُ فيه","أتَّكِى فى مَزالِقَ بعصَاهُ",22,"ا",2,0],["هالعُ قَلبُكَ المُقَرَّبُ نورى","فى صفاءِ الأعمالِ أم فى ضَفَاهُ",22,"ا",2,0],["هال الملا مذ ملا للخصم كأس ردى","يوم الهياج وَللأعداء افناها",23,"ا",3,0],["هالني دائي وأعياني الدوا","وكفى أني قد عشت أسيرا",24,"ر",2,0],["ها لسانُ البَرقِ عن شفة الشفقْ","ضاحكٌ بالرعد عجباً قَد نطقْ",25,"ق",1,1],["هالني بُعدُ المَدى ما بَيننا","وَأَقاصي مَهمَهٍ أَو بلقع",26,"ع",1,0],["هالكٌ كلُّ ما يكون","تستوي النفس والصفاة",27,"ه",1,0],["هالِكاً هالِكاً رُوَيداً رُوَيداً","في حَياءٍ وَذلَّةٍ وَخُشوعِ",28,"ع",1,0],["هالة الحسن من سناه استنارت","فاستدارت بغيهب من جعود",29,"د",1,0],["هالات طاقاتِهن آهلةٌ","يَبْسِم في كلّ هالةٍ قمرُ",30,"ر",1,0],["ها لها الرعب ففرت","من هزبر قسوره",31,"ه",1,0],["هال العُيونَ غاربٌ مثلُ النقا","منه ولكن هالهُ سَيرٌ نَقى",32,"ا",1,0],["هالَها الأَمرُ وَهو خطبٌ مَهولٌ","أَيُّ خَطبٍ من بعد موتٍ زُؤامِ",33,"م",1,0],["هالَهُ حالُ أُمَّةٍ ذاتِ شَرعٍ","نَيِّرٍ وَالكِتابُ شَرعٌ مُنيرُ",34,"ر",1,0],["هالَهُ سوءُ حالِهِم فَبَكاهُم","رَحمَةً منهُ وَالبُكاءُ كَثيرُ",34,"ر",1,0],["هالةٍ قلت: احكمي بالمحبّة واظلمي","يوم كلّن جاء يريد (الجمل فيما حمل)",35,"ل",1,0],["هالة أحساسي زهت باللجين وبالجمان","ولا سواها زاهية بالجمان وباللجين",36,"ن",1,0],["هالات طاقاتهن آهلة","يبسم عن كل هالة قمر",37,"ر",1,0],["هالَ مَنْ يَبْحَثُ عَنِّي","لَمْ يَجِدْ إلّا حَسِيرَكْ",38,"ك",1,0],["هالةٌ تسكبُ الجلال وتندى","بوميض الهدى يفيق ويسحرْ",39,"ر",1,0],["هال الدنانير الجياد ولم يهل","صرفاً إلى البناء والطيان",40,"ن",1,0],["هالحين صارالعيد ياصاحبي عيد","يوم النظر شاهد عيون الحبيبه",41,"ب",2,1],["هالحين شفتها شوف بنت الاجاويد","في داخلي هاجت مشاعر عجيبه",41,"ب",2,0],["هالوا التراب عليك دون ريبة","وتركت ظهرى يا حبيبى منحنى",42,"ن",2,0],["هالة النور وانسام الروابي","كبرياء الروح.. ذياك الشمم",43,"م",1,0],["ه الملك الشهم الهمام أخو الندى","مذيق العدا كأسات سم الأساود",44,"د",1,0],["هالكم صبرنا على كل خطب","فوقفتم من ذعركم...! ومضينا",45,"ن",2,0],["هالآدمي من وين له قلب وعروق؟!","والصبر هالمسكين من وين جابه؟",46,"ب",2,0],["هالفقد .. ما يعني سوى عمر مبرور","لا طاحت اوراقه ترى لله الملك",47,"ك",1,0],["هالعيد ( مر ) وما للافراح طاري","تكتبني همومي وتقرا جروحي",48,"ح",2,1],["هالعيد ( مر ) وما لضحكتك طاري","وانا ابتساماتي تداري جروحي !!",48,"ح",2,0],["هالليل بعض احيان يا ثقل دمه","لا بعثر المشتاق جمر التياعه",49,"ع",2,0],["ها لسْعة الدهرِ تدْنو ثُمّ يجْرحُني","ضحوًا على الغارِ مُسْندٌ سندا",50,"د",2,0],["هالني ، وآعساني بالعمر مااعدمه","مرهي ٍ بالجمال ، وقمة ٍ في الأدب",51,"ب",1,0],["هالهم منه ما دعاهم إليه","من ركوع لربهم وسجود",52,"د",1,0],["هال الجميع تفرّق الشّمل الّذي","كنّا، وكيف قضى هلالك وانطفا",53,"ف",2,0],["هالةٌ تعلوكَ من آياتِ ربِّي","أبدَ الدَّهرِ تَراءَى لِلجُموعِ",54,"ع",1,0],["هالليل مأتم وعمّان البلد فرحات واعياد","والناس تحضن بعضها دونما أية قرابة",55,"ب",2,0],["هالليل مأتم وانا ليلي كذا معكوس الابعاد","يصلح فقط : لاتحادي ، والسكارى ، والذيابة",55,"ب",2,0]]}