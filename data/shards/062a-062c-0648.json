ل","https://www.poetsgate.com/ViewPoem.aspx?id=192617",""],[5582,"سَبانِي بِتَكْسِيرِ أَجْفانِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63597",""],[5582,"أَلا حَيِّ مِنْ دارِ سُعْدَى مُقامَا","https://www.poetsgate.com/ViewPoem.aspx?id=63572",""],[5582,"ثَنَتْ لِوَداعِهِ الأَعْطافَ يُسْرا","https://www.poetsgate.com/ViewPoem.aspx?id=63519",""],[5616,"كتبت على جدار الصمت شعري","https://www.poetsgate.com/ViewPoem.aspx?id=204840",""],[5672,"جمر الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=206400",""],[5690,"اللّه أكبرُ هذا عصر تجديدِ","https://www.poetsgate.com/ViewPoem.aspx?id=172153",""],[5691,"صهيل وصليل","https://www.poetsgate.com/ViewPoem.aspx?id=206153",""],[5720,"بأرضِ الأحمريِّ","https://www.poetsgate.com/ViewPoem.aspx?id=200096",""],[5722,"آذار","https://www.poetsgate.com/ViewPoem.aspx?id=12684",""],[5829,"ذكاء","https://www.poetsgate.com/ViewPoem.aspx?id=192054",""],[5956,"أُدبِّج شعري بأطهر أنثى","https://www.poetsgate.com/ViewPoem.aspx?id=204647",""],[5973,"الماس يصبح أغلي حين نفقده","https://www.poetsgate.com/ViewPoem.aspx?id=29237",""],[5977,"أحاديث الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=213128",""],[5977,"من يداويها ؟","https://www.poetsgate.com/ViewPoem.aspx?id=213280",""],[5997,"بحرٌ وأطْلس","https://www.poetsgate.com/ViewPoem.aspx?id=214227",""],[5997,"وحي المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=214233",""],[5997,"أَعزِّيُّكِ يَا صَنْعَاء","https://www.poetsgate.com/ViewPoem.aspx?id=214288",""],[5997,"حوار شعري","https://www.poetsgate.com/ViewPoem.aspx?id=214369",""],[6018,"أياذا الفضائل واللام حاء","https://www.poetsgate.com/ViewPoem.aspx?id=181192",""],[6031,"بِرغمِ العَوَالِي والمُهَنَّدَةِ البُتْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=46342",""],[4442,"مواهب كفك لا تحتقر","https://www.poetsgate.com/ViewPoem.aspx?id=171213",""],[6127,"مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=204476",""],[6136,"عبرة إلى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=36239",""],[5616,"أحوال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1927&r=&rc=2",""],[6288,"ان الذكرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79624&r=&rc=41",""],[2220,"تجملُ لمنْ قالَ الرسولُ بأنهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11658&r=&rc=532",""]],"verses":[["تَجولُ القُرونُ بِأَعطافِهِ","مَجالَ الفَواقِعِ في كاسِ راحِ",0,"ح",1,0],["تَجولُ عَلى ذَوابِلِكَ المَنايا","وَيَخطِرُ في مَنازِلِكَ العَلاءُ",1,"ا",2,0],["تَجولُ بناتُ الفِكْرِ حوْلَ ذُبالِهِ","كما حفّ جوّالُ الفَراشِ بنِبْراسِ",2,"س",1,0],["تَجَوَّعَ لي الشَيخُ الزَكِيُّ وَجاءَني","مَعَ الشَمسِ قَبلَ الشَمسِ يَتلوهُما النَجمُ",3,"م",1,1],["تَجورُ بِذي اللُبانَةِ عَن هَواهُ","إِذا ما ذاقَها حَتّى يَلينا",4,"ن",2,0],["تَجوزُ رُبى ألأصرامِ أَصرامِ غالِبٍ","أَقولُ إِذا ما قيلَ أَينَ تريدُ",5,"د",1,0],["تَجُوزُ الحُقُولَ الخُضْرَ أَبْهَجُ مَا بِهَا","نُجُومٌ مِنَ القُطْنِ الجَنِيِّ نَوَاجِمُ",6,"م",1,0],["تَجَوَّزَ مِنها زائِرٌ بَعدَ ما دَنَت","مِنَ الغَورِ أَردافُ النُجومِ العَوائِمِ",7,"م",1,0],["تَجَوَّفَ كُلَّ أَرطَاةٍ رَبوضٍ","مِن الدَهنا تَفَرَّعَتِ الحِبالا",8,"ل",2,0],["تَجَوَّبنَ مِنها عَن خُدودٍ وَشُمِّرَت","أَسافِلُها مِن حَيثُ كانَ المَذارِعُ",9,"ع",1,0],["تجول بمستطيل الشكل عال","لطيف صنعه حسن الأثاث",10,"ث",1,0],["تجوز سيادة الهنديّ فينا","وأما ابن البلاد فلا يسود",11,"د",1,0],["تجوّلت من حسن الكواكب في الدجى","وقبح ظلام الليل في العرف والنكر",12,"ر",1,0],["تَجُودُ لَهُم نَفسِي بِمَا دَونَ وَثبَةٍ","تَظَلُّ لَهَا الغِربَانُ حَولِيَ تَحجُلُ",13,"ل",1,0],["تَجودُ الثُرَيّا فَوقَها وَتَضَمَّنَت","لَها بَرَداً يُذري أُصولَ الأَسافِلِ",14,"ل",1,0],["تَجودُ بِأَنفُسِ الأَبطالِ سُجحاً","وَأَنتَ بِنَفسِكَ الخَبُّ الضَنينُ",15,"ن",1,0],["تجوبُ أماديحِي بذكركَ في العلا","وأدعيةٌ تحتَ الظلامِ تجاب",16,"ب",1,0],["تجولُ حولَ أوانيها أشعَّتها","كأنَّما هي للكاسات كاسات",17,"ت",1,0],["تجولُ ثغورُ اللثمِ حولَ بنانه","كما جالَ عقدٌ في ترائب أجيد",18,"د",1,0],["تجود بسقياها على جدث العلى","وإن كانَ في أرجائهِ البحر والبرّ",19,"ر",1,0],["تجودُ بنانُهُ والغيثُ مُكْدٍ","ويمضي عزمُهُ والسيف نابِ",20,"ب",1,0],["تَجُودُ يداك بالذهبِ المُصفَّى","إذا ما الغيثُ عَلَّل بالذِّهابِ",20,"ب",1,0],["تجودان الأنام بلا امتنانٍ","بما تُستمطَران ولا احتسابِ",20,"ب",1,0],["تجوز بنا البحار إذا استقلَّتْ","وتُسلمُها الشَّمالُ إلى الجنوبِ",21,"ب",1,0],["تَجولُ بَناتُ حَلّابٍ عَلَيهِم","وَنَزجُرُهُنَّ بَينَ هَلٍ وَهابِ",22,"ب",1,0],["تَجودُ بِنَفسٍ لا يُجادُ بِمِثلِها","وَأَنتَ بِها يَومَ اللِقاءِ تَطيبُ",23,"ب",1,0],["تَجولُ بِهِ عَيرانَةٌ عِندَ غَرزِها","جَنيبٌ أَقادَتهُ جَريرَةُ جارِمِ",24,"م",1,0],["تَجوعُ بِبُلدانٍ وَتَعرى بِغَيرِها","وَتَرزَحُ تَحتَ الداءِ وَهوَ عَتيدُ",25,"د",1,0],["تَجوسُ بِعَينٍ خِلالَ الدِيارِ","وَتَرمي بِأُخرى فَضاءَ النَهَر",26,"ر",1,0],["تَجوبُ الدَهرَ نَحوَكَ وَالفَيافي","وَتَقتَحِمُ اللَيالِيَ لا العُبابا",27,"ب",2,0],["تجودُ بهم كورُ المطايا وتهتدي","نشاوى بكأسِ الهمِّ ميلُ العمائمِ",28,"م",1,0],["تجودُ سماءُ النقعِ فوقَ رُؤوسِهمْ","بديمةِ تِبْرٍ غيرِ مقلعةِ الهَطْلِ",29,"ل",1,0],["تَجودُ بِأَدمُعٍ بَخُلَت رِجالٌ","بِهِنَّ وَما تُعارُ سَماعَ جودِ",30,"د",1,0],["تَجودُ عَلى الطُلّابِ سَحّاً وَديمَةً","وَهَطلاً وَإِرهاماً وَوَبلاً وَرَيِّقا",31,"ق",2,0],["تَجودُ بِنَفسٍ لا يُجادَ بِمِثلِها","حِفاظاً وَإِن خيفَت عَلَيكَ المَتالِفُ",32,"ف",1,0],["تَجودُ بِها لِلَّهِ تَرجو ثَوابَهُ","وَلَيسَ بِمُعطٍ مِثلَها أَحَدٌ بَذلا",33,"ل",2,0],["تجولُ العينُ فيه وهو فيها","كشُهْبِ الخَيلِ رُحنَ بلا جِلالِ",34,"ل",1,0],["تَجودُ سَحابُ الخافقاتِ قَذالَهُ","فتُوسِعُهُ هَطْلاً ومن دَمِه تَنْدَى",35,"د",2,0],["تَجوَّع فَإِنَّ الجُوعَ مِن عَملِ التُقى","وَإِنَّ طَويلَ الجَوعِ يَوماً سَيَشبَعُ",36,"ع",1,1],["تَجولُ خَلاخيلُ النِساءِ وَلا أَرى","لِرَملَةَ خَلخالاً يَجولُ وَلا قُلبا",37,"ب",2,0],["تجودُ بدفع الأسى والرّدى","على خدّه عينُهُ الباكيه",38,"ي",2,0],["تجوزُ له الأمواهُ بركةَ جدولٍ","تخالُ الصَّبا منه مُشطِّبةً نصلا",39,"ل",2,0],["تَجولُ في رَونَقَي جَمالٍ","مِن خَدِّهِ مُقلَةُ البَصيرِ",40,"ر",1,0],["تَجُوسُ خِلالَ الْبَاسِقَاتِ وَتَنْتَهِي","إِلَى سَاعِدٍ فِي غَمْرَةِ النِّيلِ سَاجِمِ",41,"م",1,0],["تَجولُ المنايا حَولها كُلَّما ارْتَمتْ","قَذائفُ مِنه جُوَّلُ الهَوْلِ جُوَّبُ",42,"ب",1,0],["تَجولُ حَوائِمُ الآمالِ فيهِ","وَتَسبَحُ مِنهُ في رِيٍّ وَطُهرِ",43,"ر",1,0],["تَجولُ حقائقُ الأشياءِ فيها","فَمنِ غَلَقٍ يُفَضُّ ومن خِتامِ",44,"م",1,0],["تَجورُ بِالأَيدي إِذا اِستُعمِلَت","مِنها عَلى خِفَّةِ أَجسامِها",45,"م",3,0],["تَجوبُ بِهِنَّ التهَ صَغواءُ شَفَّها","تَباعُدُ أَظماءَ الفُؤادِ المُلَوَّحِ",46,"ح",1,0],["تَجولُ بِبِزِّ المَوتِ فيهِم كَأَنَّهُم","بِشَوكَتِكَ الحُدّى ضَئينٌ نَوافِرُ",47,"ر",1,0],["تَجودُكَ مِن يُمنْاهُ خمسةُ أبحُرٍ","تفيضُ دِهاقاً وهي خمسُ أنامل",48,"ل",1,0],["تَجودُ عَلَينا بِالحَديثِ وَتارَةً","تَجودُ عَلَينا بِالرُضابِ مِنَ الثَغرِ",49,"ر",1,0],["تَجُوبُ الأرضَ نَحْوَكَ ما تَأَنَّى","إذا ما الأُكْمُ قَنَّعَها السَّرابُ",50,"ب",1,0],["تَجولُ نُسوعُها وَتَبيتُ تَسري","إِلى غَرّاءَ جائِلَةِ الوِشاحِ",51,"ح",1,0],["تجود به في النّوم غير معرّدٍ","ويحزن أيقاظاً عليها عطاؤها",52,"ا",3,0],["تَجُوبُ بِهِنَّ التِّيهَ صَغْوَاءُ شفَّها","تباعدُ أظماءِ الفؤادِ الملوَّحِ",53,"ح",1,0],["تجولُ بناتُ حلابٍ عليهمْ","وتزحرهنَّ بين هل وهابِ",54,"ب",1,0],["تَجول كَتائب الأَزهار فيهِ","وَقَد كَسيت حلى الغَيث المُريع",55,"ع",1,0],["تَجودُ لَهُم نَفسي بِما مَلَكَت يَدي","وَنَصري فَلا فُحشي عَلَيهُم وَلا بُخلي",56,"ل",2,0],["تجور على الصب في حكمها","عليه فيرضى بما تحكم",57,"م",1,0],["تجود به يد تجبى إليها","خراج الأرض من كل النواح",58,"ح",1,0],["تجوب قراديد البلاد وهدها","بأشعث ذي أماكاها مضيمها",59,"م",3,0],["تجول يد البصير بكل فج","ويصطلم القليل مع الكثير",60,"ر",1,0],["تجود بما لا جاد من قبل غيرها","وتعطي عطا من لا يخاف من الفقر",61,"ر",1,0],["تجوب عرض الفلا طولا عساكره","وينتهي السير فيهم حيثما سارا",62,"ر",2,0],["تجور علينا بالجمال وتنثنى","فنوسعها لثما على ذلل الجور",63,"ر",1,0],["تجوبُ بها شِملالةٌ كُلَّ مَهْمةٍ","بتقليبِ يُمْنَاها ومَحْوِ بُراها",64,"ا",3,0],["تجوب القيافي نحوَ عُلْوَةَ قَصدُها","يُغَالِطُ مَسْراها لعمري مَقِيْلُها",65,"ل",3,0],["تجول به الجُرْدُ المذاكي عوابساً","وتسحبُ أذيالَ الدروع ولا تكبوا",66,"ب",3,0],["تجوب القوافي فدفداً بعد فدفد","وتفني الليالي في طراد النفائس",67,"س",1,0],["تَجولُ مِن بُؤسٍ إِلى نِعمَةٍ","طَوراً وَمِن عُسرٍ إِلى يُسرِ",68,"ر",1,0],["تجودُ عليها بالأشِعَّةِ شمسُنا","فتبرزُ في بُردِ الرَّبيعِ المُنَمنَم",69,"م",1,0],["تَجُودُ بِوَضْعِ الدِّينِ مِنْ سعَةِ النَّدى","وَتَضْرِبُ صَفْحاً عَن تَقاضِي المَضَائِقِ",70,"ق",1,0],["تَجُولُ بهِ جَدَاوِلُهُ","وَتَغْشَى النَّهْرَ أزْمانا",71,"ن",2,0],["تَجُود بِمحْياك الليالي على الرَّدى","وأنْتَ على دُنْياك بالدّينِ أجْوَدُ",72,"د",1,0],["تَجُودُ بِطِيبِ رَيّاها الْخُزامى","وَيَغْدُو الشُّكْرُ لِلرِّيحِ الْقَبُولِ",73,"ل",1,0],["تجوز إذا صلى إماما ومفردا","وإن كان مأموما فليس تجوز",74,"ز",1,0],["تجوب مجاهل الدنيا","لتسكن تيه أحلامي",75,"ي",1,0],["تَجودُ ولَيسَ الجودُ مَدحاً لِمثلِكُم","إذا كانَ من أخلاقِكم يَتكوَّنُ",76,"ن",1,0],["تجوز مَهامِها وتمر بيداً","وتياراً إلى البلد الحرام",77,"م",1,0],["تجويزه هذا يدل بأنه","في عدل من أهدى لنا التنزيلا",78,"ل",2,0],["تجودُ قريحَتُهُ بالبديعِ","عَفْواً كجُودِ القَراحِ المُغِلُّ",79,"ل",1,0],["تجود على محبّك كلّ عام","بلبس عباءة وتقرّ عيني",80,"ن",2,0],["تجول المنايا بينهم بجنودها","بحيث مجال الحرب أضيق من شبر",81,"ر",1,0],["تجولُ ضراغمُ الفُرسانِ فيه","على عُقبانِ سابقةِ الخُيولِ",82,"ل",1,0],["تجوبُ التَّنائِفَ خَرْقاً فَخَرْقاً","وحاجاتُها فِي عُنُوِّ العَنَاءِ",83,"ا",2,0],["تجوز على عذلي وتعذل جائزي","ويعصب آمالي ووعدي يخادع",84,"ع",1,0],["تجول رعياً حول أعراضكُمُ","تحمي من العار حماها وترفّْ",85,"ف",1,0],["تجود فتعطي في الغنى قُدرةَ الغنى","وتجبُرُ أَكسارَ الفقير على الفَقرِ",86,"ر",1,0],["تجودك نَعماءَ تزكو النفو","سُ فيها وتَغْنَى عليها الديارُ",87,"ر",1,0],["تجوبُ الأرض وتقطعُ كلَّ يوم","مدَى عامين للساري المُجِدِّ",88,"د",1,0],["تجود وتحمي حين لا جون مُزنةٍ","بمُعْطٍ ولا بأسُ المُطاعِ بمانعِ",89,"ع",1,0],["تجول بها حُمْس أعاروا همومهم","ظُهور المذاكي والوشيج المُقَوَّما",90,"م",2,0],["تَجودُ على عِتاقِ ال","طَّيْرِ والعافي أنامِلُهُ",91,"ل",2,0],["تَجورُ بطعن الدارعينَ رماحُهُ","وفي السلْم ما بين الرَّعِيَّةِ يعْدِل",92,"ل",1,0],["تجود فيبيضُّ منك النَّدى","ويسودُّ من نقعك المعرك",93,"ك",1,0],["تجور به هيف القدود على القنا","وتحكم ألحاظُ الظباء على الأسد",94