Poem.aspx?id=186277",""],[4829,"ملحمة الطلاسم للألفية الدمويّة","https://www.poetsgate.com/ViewPoem.aspx?id=34257",""],[4831,"العين تحكي","https://www.poetsgate.com/ViewPoem.aspx?id=208033",""],[4578,"زناد نوى الأحباب في القلب يقدحُ","https://www.poetsgate.com/ViewPoem.aspx?id=49376",""],[4935,"لست أدري أي ذنب","https://www.poetsgate.com/ViewPoem.aspx?id=129355",""],[4978,"تشطير وأشعر أني","https://www.poetsgate.com/ViewPoem.aspx?id=177282",""],[5009,"إبتهال","https://www.poetsgate.com/ViewPoem.aspx?id=68090",""],[5187,"ذكريات وعتاب","https://www.poetsgate.com/ViewPoem.aspx?id=29255",""],[4045,"أأحزنك الأولى ردّوا","https://www.poetsgate.com/ViewPoem.aspx?id=200274",""],[308,"أروضة تَبَسم عَن زهر","https://www.poetsgate.com/ViewPoem.aspx?id=189193",""],[5338,"أرى أدمعي منها السحائب تستجدي","https://www.poetsgate.com/ViewPoem.aspx?id=187912",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"رسائل أخوان الصفا والتودد","https://www.poetsgate.com/ViewPoem.aspx?id=128837",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"فليس بنظم مستقم ولم يكن","https://www.poetsgate.com/ViewPoem.aspx?id=128801",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5436,"نصيحة صادقة ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35264",""],[5582,"قَدْكَ يا عاذِلُ تُبْدِي اللَّوْمَ قَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=186907",""],[5628,"دليل الحب","https://www.poetsgate.com/ViewPoem.aspx?id=178671",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5701,"ضيوف الحمى رفقا بأهل الحمى رفقا","https://www.poetsgate.com/ViewPoem.aspx?id=164581",""],[6327,"حكاية الأيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86568&r=&rc=3",""]],"verses":[["كَما قَرَّ قَلبُكَ يا اِبنَ الحُسَي","نِ مِن شَوقِهِ وَعُيونِ الفَخارِ",0,"ر",1,0],["كَما قادَ عُلوِيُّ السَحابِ غَمامَةً","وَجَلجَلَها مِلءٌ مِنَ البَرقِ وَالرَعدِ",1,"د",1,0],["كَما قادَ مِثلي بِالمُحالِ إِلى الرَدى","وَعَلَّقَ آمالي بِذَيلِ المَطامِعِ",2,"ع",1,0],["كَما قَد عَمَمتَ المُؤمِنينَ بِنائِلٍ","أَبا خالِدٍ صَلَّت عَلَيكَ المَلائِكُ",3,"ك",1,0],["كم أقاسي من الغرام وأخفي","عن وشاتي صبابة وغليلا",4,"ل",2,1],["كَما قُلتُمُ يَهنيكَ نَومُكَ بَعدَنا","وَمِن أَينَ نَومٌ لِلكَئيبِ المُرَوَّعِ",5,"ع",1,0],["كَما قَلَّبَ الأَقدَحُ المُخطِرُ","نَفى بِالعِراكِ حَوالِيَّها",6,"ه",2,0],["كَما قَد تمشت غادة فلكية","فأبقت بِعالي الجو من خلفها إِثرا",7,"ر",2,0],["كما قيل العوالم لاجتماع","حوت أشياء لا تحصى كثيرة",8,"ر",2,0],["كما قَرَنْتَ بينَ كَمْأَتَيْنِ","أو كُرَتَيْ مِسْكٍ لَطيفَتَيْنِ",9,"ن",1,0],["كَما قَد كانَ عَوَّدَهُم أَبوهُ","إِذا أَزَمَتهُمُ يَوماً أَزومُ",10,"م",1,0],["كَما قيلَ يَقولُ تَدبيرُ قَيسِ ال","رَأيِ دوني وَبَأسُ عُمرِو بنِ مَعدي",11,"د",2,0],["كَما قيلَ لِلخَرمِ المَخوفِ مَفازَةً","وَلُقِّبَ أَصنافُ العَبيدِ مَوالِيا",12,"ي",2,0],["كَما قالَهُ الصَقرُ في عِزَّةٍ","بِهِ حينَ فاخَرَهُ البُلبُلُ",13,"ل",1,0],["كَما قابَلَ العيدُ وَجهَ الوَزيرِ","وَسَجعَ ثَناءٍ لَهُ رُتِّلا",14,"ل",2,0],["كَما قَد غَدَوتَ عَلى سابِحٍ","جَوادِ المَحَثَّةِ وَثّابِها",15,"ب",3,0],["كَما قَد أَرى قالا كَذاكَ وَرُبَّما","يَكونُ سُرورٌ في الهَوى وَشَقاءُ",16,"ا",2,0],["كما قابَلَتْ عينٌ من اليَمِّ لُجّةً","وقد نَحَرَتْها من مَطالعها الشمسُ",17,"س",1,0],["كَما قَيَّدَ السُلطانُ حِلفَ جِنايَةٍ","لِيَقتَصَّ مِنهُ أَو لِيُغرِمَ مَغرَما",18,"م",2,0],["كَمْ أقامَا على زَوالِ نَهارٍ","وَأنارا لِمُدْلِجٍ في سَوَادِ",19,"د",1,0],["كما قالوا عَليمٌ إذ أرادوا","تَناهي العِلْمِ في الِله الجَليل",20,"ل",1,0],["كما قَدْ رَدَّكُمْ فَلاًّ شَرِيداً","بغيظِكُمُ خَزَايَا خَائِبِينا",21,"ن",2,0],["كما قذفَ المسلولُ من لُبَّة الحشا","دماً ، أستثيرُ الشعرَ جمر وأقذف",22,"ف",1,0],["كمَا قد سقته بكرةً وعشيةً","غداةً النوَى منى الدموعُ الذوارفُ",23,"ف",1,0],["كَما قالَ لِلرهطِ الَّذينِ تَهَوَّدوا","وَجاهَدَهُم في اللَهِ كُلَّ جِهادِ",24,"د",1,0],["كَما قَد لَقينا مِن سُبَيعٍ وَنَوفَلٍ","وَكُلٌّ تَوَلّى مُعرِضاً لَم يُجامِلِ",25,"ل",1,0],["كما قد حمت نفسُ ابنِ مَروانَ مجدَه","بأبيضِ عزمٍ أو بأحمرِ مالِ",26,"ل",1,0],["كما قلُتما بُرءُ الصبابةِ في الياسِ","وليس لها غيرَ التجلُّدِ من آسِ",27,"س",1,1],["كما قال فازت عاد بالقرب واللقا","من الله في الدنيا وفي اليوم الآخر",28,"ر",1,0],["كما قال هذا إن كل أوامر","من الله جاءت فهي وفق المقادر",28,"ر",1,0],["كما قد رأينا ناهيا عن خزاية","ويركبها وهو الألدّ المحارب",29,"ب",1,0],["كم أقاسي لديك قالاً وقيلا","وعداتٍ تترى ومطلاً طويلا",30,"ل",2,1],["كما قد جاء أبقاك الإله الس","نين كما تشاءُ عن الرسول",31,"ل",1,0],["كما قد مررت الأمس والأمس حاضري","ومرجوّ ما يأتى به المجهل الفرد",32,"د",1,0],["كَم أَقاسي يا لين الخصر قَلبا","مِنكَ لِلعاشِقينَ ما أَقساه",33,"ا",2,0],["كما قال زَيْدُ الخيلِ يومَ حفيظةٍ","غدا وهْو فيه للحُطَيئةِ آسر",34,"ر",1,0],["كما قد غَدوْتَ النّاسَ طُرّاً منَ العُلا","كذا غدتِ الأعمارُ طرّاً لك العُمرا",35,"ر",2,0],["كَم أقاسِي آيِساً يُطمعُني","فيكُم أو خائِفاً يؤمِنُني",36,"ن",2,0],["كَم أَقولُ اخسَأوا فَلا يَنفَعُ القَو","لُ أَضاقَت عليهمُ الأَسواقُ",37,"ق",1,0],["كَم أَقود الصَبر وَالصَبر حرون","كُل تَدبير مَع الحُب جُنون",38,"ن",1,0],["كما قد روى الشيخان ذاك وصححا","فتابع في هذي البخاري ومسلما",39,"م",2,0],["كم أقاسي في الهوى من شغل","هي في القلب كنار الشعل",40,"ل",1,1],["كما قلت قد تناها تبدى","مثل ليل الصدود للعشاق",41,"ق",1,0],["كَما قاسَ نَعلاً حَضرَمِيّاً فَقَدَّها","عَلى أُختها لَم يَألُ أَن يَتَجَوَّدا",42,"د",2,0],["كما قد عَفَتْ في منزل الذلِّ آثاري","إذا نظَرَتْ سلَّت بألحاظها الظبا",43,"ب",2,0],["كَما قالَت فَتاةُ الحَيَّ لَمّا","أَحَسَّ جَنانُها جَيشاً لُهاما",44,"م",2,0],["كما قد جاء في عجب","يصيغ الدر من حبر",45,"ر",1,0],["كما قَدْ وَفَيْتُ لَهَا حِينَ عُجْتُ","بِغُلَّتِها فِي عُبابِ الوفاءِ",46,"ا",2,0],["كما قَدْ وَصَلْتَ حِبالَ الغَرِيبِ","وَقَرَّبْتَ مَأْوى القَصِيِّ البَعِيدِ",47,"د",1,0],["كم أقام اللهو فيها عُرُسَا","وتجلّى في رباها قَمَرُ",48,"ر",1,0],["كم أقامَ العَجاجَ ليلاً وحَيَّى","راكِباً في الطَّريقِ بيضَ الأَنُوق",49,"ق",1,0],["كم أَقرعُ البابَ والرُّكْبانُ هاجِعَةٌ","واللُّبُّ ما بين مَوْجودٍ ومُنْسَلِبِ",50,"ب",1,0],["كما قمرية ناحت","ببغداد على غصن",51,"ن",1,0],["كما قد يَقي النَّفسَ إجهادُها","لِفَهمِ عَويصٍ اذا ماعَرا",52,"ر",2,0],["كما قلتمُ لن يرتَضي السِّلمَ مُجرِمُ","ولا حُكمَ إذ إنَّ الحُسامَ المُحَكَّمُ",53,"م",1,1],["كما قُلتمُ والله ليس لَه نِدُّ","فإنَّ التهامي في الورَى علَمٌ فردُ",54,"د",1,1],["كما قُلتُم روضُ المعَالي به خِصبُ","وهل بينَ ذي مجدٍ وبين العُلا حُجبُ",55,"ب",1,1],["كما قلّبَتْ خَرْقاءُ في غَبَشِ الدُّجى","ذراعاً شعاعِيَّ المعاصِمِ حاليا",56,"ي",2,0],["كما قد قال وهو الأوَّلُ اقْرأْ","كذا والآخرُ اعرفْ ذا المقالا",57,"ل",2,0],["كما قال في القرآن وهو كلامه","لدينا وإنا معْ لدينا هو الله",58,"ل",2,0],["كما قال لن تحصوه في كلماته","فتاب عليكم فاقرأوا ما يحقق",59,"ق",1,0],["كما قال محيي الدين وهو المقرر","لنا دولة في آخر الدهر تظهر",60,"ر",1,0],["كما قلت سموهم لقوم تعلقوا","بما قيَّد الإمكان من مطلقيتي",61,"ي",1,0],["كَما قَضاها اللَهُ إِلّا أَنَّما","مَكارِمُ السَعي لِمَن تَكَرَّما",62,"م",2,0],["كم اقْتَضَى وارْتَضَى شُكْري ومَحْمَدتي","لمَّا تَلَطَّف في بِرِّي وإِيْنَاس",63,"س",1,0],["كَمْ أَقَامَتَ عَلى العُفَاةِ لَهاه","وأُقِيمَتْ عَلَى اللَّيالِي حُدُودُه",64,"د",2,0],["كما قد سقاه ليلة الدفن ربه","من الغيث وكاف السحاب وأسخاه",65,"ا",2,0],["كَما قَد قَضى في نَصرِ رايَتِك الّتي","بِها النَّصرُ مَعقودٌ لَهُ الفتحُ عاقِبُ",66,"ب",1,0],["كم اقتطعوا نهج السبيل وفعلهم","بناديهم من النكر أفظع",67,"ع",1,0],["كما قِيلَ كوني فكانتْ سَلاما","وبرْداً به النَّارُ بعْد التهِاب",68,"ب",1,0],["كما قرأتم في حقه أفمن","يهدي إلى الحق في دلالته",69,"ت",2,0],["كم أقالوا عن بني العلم عثار","وجلوا عن مقلة الدين للعما",70,"م",2,0],["كم أَقْعَدَهُ الدَّلال عَمَّنْ","كم أَقْعَدَهُ وكم أَقامهْ",71,"م",2,0],["كما قضتِ الآداب والشيم الرِّضي","لذهلٍ بأن في النّاس ليس له مثلُ",72,"ل",1,0],["كما قبضَ الدينارَ في النومِ حالمٌ","واصبحَ لم يلقَ الذي كان قابضا",73,"ض",2,0],["كما قد قال أحمد لابن زيد","لقتل فتى من المستشهدينا",74,"ن",2,0],["كمآقي باطنِ العي","ن من الأنوارِ محجوبهْ",75,"ب",2,0],["كَما قَد يُسلّى بِالعِقالِ وَبِالعَصا","وَبِالقَيدِ ضِغنُ الفَحلِ إِذ هُوَ نازِعُ",76,"ع",1,0],["كم أقلسي بانتظار لوعة","قلبت قلبي على جمر الغضا",77,"ض",2,0],["كَما قالَ قَيسٌ حينَ ضاقَ مِنَ الهَوى","فَلَم يَستَطِع في الحُبِّ بَسطاً وَلا قَبضا",78,"ض",2,0],["كَمَا قَد أتت تهتَزُّ شَمَّاءُ أيكَةٌ","إلَيهِ ولم يُحجِل أفانينَها عُترُ",79,"ر",1,0],["كَمَا قِيلَ فَضْلُ الدُّرّ في الأرضِ ضائِعٌ","فقال مُجِيباً لاَ وَلِلأرْض مِنْ كَأسِ",80,"س",1,0],["كما قال: إن الأقحوان كمبسمي","وإن قضيب البان يشبهه قدي",81,"د",2,0],["كَما قائِلٍ قالَ حازَ المَجدَ وارِثُهُ","فَقُلتُ هُم وارِثوهُ عَن جُدودِهِمِ",82,"م",1,0],["كَما قَد جَرى يَوماً عَلى أَهلِ حائِلٍ","وَقَد صُرِفوا عَن مَنهَجِ الرُشدِ أَو عَموا",83,"م",3,0],["كَما قَد مالَ مِن سُكرٍ صَريعٍ","تَمَشَّت في مَفاصِلِهِ العُقارُ",84,"ر",1,0],["كَما قَد أَعَرنا لِلغُصونِ مَلابِساً","وَلِلرَّوضِ أَخلاقاً وَلِلبَرقِ مَبسِما",85,"م",2,0],["كما قسّم الله الصلاةَ بحكمة","لنا ما بين ساداتٍ وبين عبيد",86,"د",1,0],["كما قيلَ حَدّادٌ لحاجبِ بابهم","وقد قيلَ هذا اللفظ في العرفِ للقَين",87,"ن",1,0],["كما قال من أغواكمُ غير عالم","بما قاله إذ قال قولاً مسددا",88,"د",2,0],["كما قد أنالَ الجسم فَترَة جَفنها","نحولاً فكافاها عَلَى وفقه المعطَى",89,"ط",2,0],["كما قيل في الابدال والقطب انهم","بهم تدفع الجلى ويستنزل القطر",90,"ر",1,0],["كَما قالَ سَعدٌ إِذ يَقودُ بِهِ اِبنَهُ","كَبِرتَ فَجَنِّبني الأَرانِبَ صَعصَعا",91,"ع",2,0],["كما قابلت زهر الرياض وقبلت","ثغور أقاحيه بلا لوم لايم",92,"م",1,0],["كم أقضي النهار تضحك سني","راضيا بالحياة طلقا جليدا",93,"د",2,0],["كما قد حافظ القرآن فصحى","سيحفظ شعري الشعر القديما",94,"م",2,0],["كَما قَد نَبا عَن مالِكٍ جُلُّ جَمعِكُم","بِسَهلِ الحِمى وَالهضبِ طَعنٌ مُدارِكُ",95,"ك",1,0],["كما قَدْ سعتْ بالجهلِ والبغيِ حِمْير","وطال لها فِي القتل كَفٌّ ومِعْصَم",96,"م",1,0],["كم أُقاسي من هموم الدهرِ كم","لَيْسَ بَيْنَ الدهرِ والأحرار صلح",97,"ح",1,0],["كما قد نفى إدخال زوج وزوجه","فغير أخى عصب