ewPoem.aspx?id=176882",""],[4728,"غادة","https://www.poetsgate.com/ViewPoem.aspx?id=176988",""],[4764,"موقعة قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=33892",""],[4791,"عقد ثمين","https://www.poetsgate.com/ViewPoem.aspx?id=37114",""],[4791,"سلطان حبك","https://www.poetsgate.com/ViewPoem.aspx?id=36952",""],[4791,"غريب الحب","https://www.poetsgate.com/ViewPoem.aspx?id=37024",""],[4797,"عقب اربعين سهيل","https://www.poetsgate.com/ViewPoem.aspx?id=180552",""],[4849,"إهداء لشاعر بندر المحيا","https://www.poetsgate.com/ViewPoem.aspx?id=53499",""],[4858,"حتّامَ هذا القتلُ ؟ّ","https://www.poetsgate.com/ViewPoem.aspx?id=138194",""],[4883,"قصيدة حب","https://www.poetsgate.com/ViewPoem.aspx?id=48366",""],[4908,"صفحة جديدة","https://www.poetsgate.com/ViewPoem.aspx?id=211567",""],[4918,"عديل الروح","https://www.poetsgate.com/ViewPoem.aspx?id=31098",""],[5102,"فتح الأندلس","https://www.poetsgate.com/ViewPoem.aspx?id=12868",""],[5121,"رَشْفَة","https://www.poetsgate.com/ViewPoem.aspx?id=211404",""],[5121,"هَدِيَّةُ مَوْلِدِي","https://www.poetsgate.com/ViewPoem.aspx?id=214758",""],[5198,"الصعاليك","https://www.poetsgate.com/ViewPoem.aspx?id=143702",""],[5220,"بنت الاصول","https://www.poetsgate.com/ViewPoem.aspx?id=34407",""],[5307,"يا عويد البان","https://www.poetsgate.com/ViewPoem.aspx?id=10540",""],[592,"يا من يريد طريقة تدنيه من","https://www.poetsgate.com/ViewPoem.aspx?id=128862",""],[5358,"النهار الممطر","https://www.poetsgate.com/ViewPoem.aspx?id=32852",""],[5358,"معكم فؤادٌ","https://www.poetsgate.com/ViewPoem.aspx?id=202325",""],[5431,"الريم ..لوحة ذاتية","https://www.poetsgate.com/ViewPoem.aspx?id=206889",""],[5455,"صدفة","https://www.poetsgate.com/ViewPoem.aspx?id=213951",""],[5455,"في خاطري كلمتين","https://www.poetsgate.com/ViewPoem.aspx?id=34366",""],[5542,"يا فارس الكرسي","https://www.poetsgate.com/ViewPoem.aspx?id=9679",""],[5573,"ياخشف اشوف ان الهوى ماله حدود","https://www.poetsgate.com/ViewPoem.aspx?id=203090",""],[5602,"في موعد آخر لم نلتق","https://www.poetsgate.com/ViewPoem.aspx?id=204903",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5736,"معك اقتسمت النبض","https://www.poetsgate.com/ViewPoem.aspx?id=208285",""],[5786,"إن كنتَ لي صاحباً قِف لي بهبود","https://www.poetsgate.com/ViewPoem.aspx?id=50651",""],[5848,"1000قلب","https://www.poetsgate.com/ViewPoem.aspx?id=50616",""],[5848,"بشكل حصري","https://www.poetsgate.com/ViewPoem.aspx?id=48830",""],[5875,"كبرياء الغلا","https://www.poetsgate.com/ViewPoem.aspx?id=211781",""],[5893,"لو أكتبك","https://www.poetsgate.com/ViewPoem.aspx?id=141384",""],[5956,"معكِ الحياة جميلة القسمات","https://www.poetsgate.com/ViewPoem.aspx?id=185359",""],[6341,"ذات غائبة..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87276&r=&rc=5",""]],"verses":[["مَعكَسُ السَهمِ ذا يُراشُ لِيُمضي","في المَرامي وَذا يُراشُ لِيُبرى",0,"ر",2,0],["معكوسةٌ كقعود الشَّوْل أنطفَها","عكسُ الرِّعاء بايضاعٍ وتكرارِ",1,"ر",1,1],["مع كل ذلك ارتأى","ان الردى للمرء خسر",2,"ر",1,0],["مَع كُلِّ بَدرٍ فاقَ بَدرَ السَما","مِن كُلِّ حُلوِ اللَفظِ عَذبِ اللَمى",3,"م",2,0],["مَعَ كُلِّ ساقٍ كَالقَضيبِ الغَضِّ","يُديرُ راحاً بِالسُرورِ تَقضي",4,"ض",2,0],["مَعكوسَةً بِعُرى الحَزا","ئِمِ وَالأَزِمَّةِ بِالحَدائِل",5,"ل",1,0],["مَعَكَ الناسُ إِذا أَطعَمتَهُم","وَمَعَ النَجمِ إِذا اليَأسُ بَدا",6,"د",2,0],["معكومةً بسياط القوم نضربها","عن منبت العشب نبغي منبت الكرم",7,"م",1,0],["معك الناس إذا أطعتهم","ومع النجم إذا اليأس بدا",8,"د",2,0],["مَع كونهم من فحولِ العلم قد زلقوا","ببعضِ ما دقَّ في الأذهان من شبهِ",9,"ب",2,0],["معَ كلِّ الأصحاب والأتباعِ","أَكملَ اللَّه دينهُ وهو داعي",10,"ي",1,0],["مع كلّ معشوق الطباع محبّبٍ","يبدو فيختلس النفوسَ إذا فجا",11,"ج",2,0],["مَع كُلِّ واضِحَةِ اللِّثامِ لَها فَمي","بِاللَثمِ في ضَمِّ العِناقِ لِثامُ",12,"م",1,0],["مع كيميا كذب كذاك وسيميا","زورٍ تضل العقل في وادي الخبل",13,"ل",1,0],["مع كل صالح وعامل لك عليم","فضلا ومنا وغن كنا همج",14,"ج",1,0],["مع كلّ نَدمانٍ كبدر الدجى","ما افتض بكر الدن إلاَّ سفاح",15,"ح",1,0],["مع كلِّ رمشة رامشٍ","يبدي الغيور عجائبه",16,"ب",2,0],["مع كلِّ ذي نِعمةٍ هذاكَ دابُهُمُ","فإنهم ما نَسَوا أيامَ إعسار",17,"ر",1,0],["مع كاعبٍ من نساءِ العُرْبِ مُقلَتُها","سوداءُ تَسبي جِماراً من بني جُشَمِ",18,"م",1,0],["مع كونهِ جار نحرٍ","لكافر الليل ينحر",19,"ر",1,0],["مع كل ريح تغتدي بهبوبها","في الجو بين شواهن وصقور",20,"ر",1,0],["مع كل خود إِن تثنت ثنت","عزيمة المصطبر الجلدِ",21,"د",1,0],["مع كل بكر يزينها صِغَر","تسعى ببكر تزان بالهرمِ",22,"م",1,0],["مع كل أحوى أحور","ومهفهف الكشحين أغيد",23,"د",1,0],["مع كل معسول اللمى","خرس البرى شخت الوشاحِ",24,"ح",1,0],["مع كونه يضر بالمحموم","وحرمة المؤذي من المعلوم",25,"م",1,0],["مع كلَ بستانيّ أرضٍ جَمعوا","اقذاركم طرًّا على الصهيوني",26,"ن",2,0],["مع كل خل ظريف","ندب من الأخوان",27,"ن",1,0],["مع كشفي لك الحديث الذي","عنك لم يصن",28,"ن",1,0],["مع كي ولو أو أي وإي ومن وعن","وما ومذ أم لم ولا إن أن ولن",29,"ن",1,0],["مَع كُل مِن وافى رِحابك يَبتَغي","سُبل الهُدى مِن وارد أَو صادر",30,"ر",1,0],["مع كل فاتنة القوام إذا انثنت","أزرت بغصن البانة المتأرج",31,"ج",1,0],["مع كل بدر تحت فرع دجنة","من فوق قضبان على كثبان",32,"ن",1,0],["مَعَ كُلُّ غانِيَةٍ كَأَنَّ رُضابَها","عَسَلٌ مِنَ الأَشَرِ العِذابِ مُشارُ",33,"ر",1,0],["مع كل معتدل بلا عَدْل له","بين التجني والرضا خُلُقان",34,"ن",1,0],["مع كل رنة مأتم","لي مأتم، وعلى ماتم",35,"م",1,0],["مع كلّ وجنٍ تطوي البيد شمليل","يوم الرّهن ركّابها ياخذ الزّود",36,"د",1,0],["مَعَ كَونِهِ أيضاً خِلاَفَ الفِطرَةش ال","أولَى وَسُنَّةِ رَبِّنَا الرَّحمَنِ",37,"ن",1,0],["مع كتب جمعن في كل فن","حين يروين ألف باك وراث",38,"ث",1,0],["مع كل مبذول الوصال ممنّع","من غيرنا تسمو به الخيلاء",39,"ا",2,0],["مع كل ساحرةِاللحاظ كأنما","ترنو بناظرتي مَهاةٍ مرضعِ",40,"ع",1,0],["معكوسة فسوي وهذا عندنا","أهل المجون أجل منه وأشرف",41,"ف",1,0],["مَع كُلِّ ذا وَالمُسلِمون","في غَيِّهِم يَتَخَبَّطون",42,"ن",1,0],["مَع كسرِ مَتلُوِّ الأخِيرِ مُطلَقاً","وَضَمِّ مِيمٍ زَائِدٍ قَد سَبَقَا",43,"ق",2,0],["مَعَ كُلِّ بَرٍّ صَلِّها أَو فاجِرٍ","ما لَم يَكُن في دينِهِ بِمُشانِ",44,"ن",1,0],["مَعَ كُلِّ قومٍ غارةً متغيراً","أبداً كما تتغيَّرُ الأَقمارُ"