{"poems":[[88,"ثلاثة من سراة النيل قد حبسوا","https://www.aldiwan.net/poem10357.html","البسيط"],[88,"لقد نصل الدجى فمتى تنام","https://www.aldiwan.net/poem10686.html","الوافر"],[90,"شب الأسى في قلوب الشعب مستعرا","https://www.aldiwan.net/poem45044.html","البسيط"],[53,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[68,"إن لم أزر ربعكم سعيا على الحدق","https://www.aldiwan.net/poem41377.html","البسيط"],[76,"أرأيك أمضى أم حسامك يقطع","https://www.aldiwan.net/poem13174.html","الطويل"],[173,"رويدك يا هذا المليك الحلاحل","https://www.aldiwan.net/poem1646.html",""],[190,"أف لهذا الزمان من نكده","https://www.aldiwan.net/poem43886.html","المنسرح"],[237,"تبدت لنا حزوى فهاج جواها","https://www.aldiwan.net/poem14831.html","الطويل"],[302,"ألا هل درت من أقصدت أسهم الهلك","https://www.aldiwan.net/poem33202.html","الطويل"],[308,"حسدت نسيم الروض في كل خالة","https://www.aldiwan.net/poem57826.html","الطويل"],[309,"هدى الله معشوق الجمال إلى الهدى","https://www.aldiwan.net/poem16883.html","الطويل"],[382,"حلول حال أفرقنا مجالا","https://www.aldiwan.net/poem59176.html","الوافر"],[409,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[445,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[463,"تعالين نعالج نفرة","https://www.aldiwan.net/poem55850.html","الهزج"],[469,"تأملت تصنيف هذا السعيد","https://www.aldiwan.net/poem3565.html","عموديه"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120031","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119918","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59066","الوافر"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93135","الطويل"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116553","الطويل"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107183","الرجز"],[2844,"","https://poetry.dctabudhabi.ae/diwan/poem/144462","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100289","المتقارب"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84475","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74048","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66437","الطويل"],[3811,"","https://poetry.dctabudhabi.ae/diwan/poem/146443","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69902","الوافر"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44681","الوافر"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146751","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133114","الوافر"],[4767,"الأتست (قسم اعتماد الصرف)","https://www.poetsgate.com/ViewPoem.aspx?id=88157",""],[4927,"إلى زوجتي","https://www.poetsgate.com/ViewPoem.aspx?id=29637",""],[5092,"... هُم ....","https://www.poetsgate.com/ViewPoem.aspx?id=213363",""],[5284,"مُرَادُ النَّفْسِ","https://www.poetsgate.com/ViewPoem.aspx?id=190633",""],[5459,"عين العطاء","https://www.poetsgate.com/ViewPoem.aspx?id=198380",""],[5595,"نعلّمُ جيلنا الكتبا","https://www.poetsgate.com/ViewPoem.aspx?id=158559",""],[5667,"الطبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=214892",""],[5829,"جنة الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=151690",""],[5956,"شَغُوفٌ باندفاعك لانتشالي ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182451",""]],"verses":[["فَكَم ضَريحٍ خَلاءٌ لا رُفاتَ بِهِ","تَرى لَهُ مَناحي النيلِ أَطيانا",0,"ن",2,0],["فَكَم ضَحِكَ العَميدُ عَلى لِحانا","وَغَرَّ سَراتَنا مِنهُ اِبتِسامُ",1,"م",1,0],["فكم ضغائن بين القوم أوجدها","وكم بذور من التفريق قد بذرا",2,"ر",2,0],["فكم ضيوفِ ضيوفٍ في رحالهمُ","وكم هنالِكَ من زوار زوار",3,"ر",1,0],["فَكَم ضَمَمتَ وِشاحاً في الظَلامِ بِها","ما زادَ قَلبَكَ إِلّا كَثرَةَ القَلَقِ",4,"ق",1,0],["فَكَم ضَربَةٍ فَوهاءَ ثَمَّ وَمُقلَةٍ","جَرَت هَذِهِ تَدمى وَهاتيكَ تَدمَعُ",5,"ع",1,0],["فَكَم ضاقَ أَمرٌ ثُمَّ وَافى اِتِّساعُهُ","وَما عاجِلٌ إِلّا وَيَتلوهُ آجِلُ",6,"ل",1,0],["فكم ضعيف رأيت مطرحا","أقام هذا الزمان من أوده",7,"د",2,0],["فَكَم ضِحكَةٍ في القَلبِ مِنها حَرارَةٌ","يَسُبُّ لَظاها لَو كَشَفتَ غِطاها",8,"ا",3,0],["فَكَم ضَمَّ من مَجدٍ وكم حازَ من عُلاً","وَكَم حاز من رُشدٍ وكم نال من نُسكِ",9,"ك",1,0],["فكم ضم عطفاً للغصون مرنحاً","وعانق قدا للقضيب مقوما",10,"م",2,0],["فكم ضمن هاتيك كل عيد أنيسة","مع الجيرة الغادين من معشر الهدى",11,"د",2,0],["فكم ضاءت حنادسُ من ضياهم","وقد كانت ظلاماً بل ضلالا",12,"ل",2,0],["فكم ضربت لنا فيه خيام","خيام هدى ساقاها من خيام",13,"م",1,0],["فَكم ضَربْتَ عليها من قِداحِ وغىً","بالبيضِ والسُّمرِ ضَرَّاباً وطَعَّانا",14,"ن",2,0],["فكم ضمَّتْ يدُ الليل ال","مُنَى تحت إزاريْنا",15,"ن",2,0],["فكم ضمَّ بيت نهى سائراً","وصيد به مثلٌ شارد",16,"د",1,0],["فكم ضبع جعلت الليث طمعا","لديه بثعلب الرمح المبيدِ",17,"د",1,0],["فكم ضبع جعلت الليث طعما","لديه بثعلب الرمح المبيدِ",18,"د",1,0],["فَكَمْ ضَالٍ هَدَى ونهى وَأهْدَى","وَأْتَبَعَهُ وَظَفَّرَهُ وَشَرَّفْ",19,"ف",1,0],["فكم ضم من خير البرايا سلالةً","ضريحٌ له يعنوا الضراح جلالةً",20,"ه",1,0],["فكم ضيعةٍ ضاعت وكم خلّةٍ خَلَت","وكم فضّة فضّت وكم ذهبٍ ذَهَب",21,"ب",1,0],["فَكَم ضَعيفٍ سَوَّدَتهُ الدُّنيا","وَكَم قَوِيٍّ سَعيُهُ مَا أَغنَى",22,"ن",2,0],["فكم ضمنت أحداجهم من جآذرٍ","أوانس ينضوها جآذر عين",23,"ن",1,0],["فكم ضربة منه أخدودة","تقدُّ المجنَّ ومن دارَها",24,"ر",3,0],["فَكَم ضاقَت الأحوال يوما وفرّجت","وَفتحت الأبواب طوراً وأرتِجَت",25,"ت",1,0],["فَكَم ضاقَ بالأَحرار قبلك منزلٌ","قعدن وَساعا فيك تلك المَضايقُ",26,"ق",1,0],["فكم ضاحك بالوجه والصدر منطوٍ","على وجه قلبٍ بالعداوة كالح",27,"ح",1,0],["فكَمْ ضَجّةٍ للناّسِ من خَلفِ سِترِه","تَضِجّ إلى قَلْبٍ عنِ اللهِ مُغْفَلِ",28,"ل",1,0],["فَكَم ضنَّ الزَمانُ وَكَم ضَنينا","وَكم بتنا وَغمٌّ في الصُدورِ",29,"ر",1,0],["فَكَم ضَل الَّذي قَد تاهَ عِشقاً","وَمَن يَهوى الرَسولَ فَلا يَضِلُّ",30,"ل",1,0],["فكم ضيعة مالت لأبواب مالها","قناتي وغيري منه نشوان مائل",31,"ل",1,0],["فكم ضاعت لنا أنفاس عمرٍ","وبيع الدر منها بالدواوي",32,"ا",3,0],["فكم ضحى بهم يوما لأمر","وكانوا عنده مستضعفينا",33,"ن",2,0],["فَكَمْ ضَحِكَتْ عَلَى الْقَلْبِ الْعَذَاْرَىْ","وَكَسَّرَتِ الْقُلُوْبَ عَلَى السِّهَاْمِ",34,"م",1,0],["فكم ضاقت فراغاتُ التمني","وما كان الفضاء ليَّ اتساعا",35,"ع",2,0],["فكَمْ ضَجَّتْ بِصَدْرِكَ سَانِحَاتٌ","كَمِثْلِ النَّحْلِ طَافَ بِمَا زَرَعْتَا",36,"ت",2,0],["فكمْ ضِيقٍ يُبَشِّرُ بِانْفِرَاجٍ","وكمْ لَيلٍ تَمَخَّضَ عَنْ ضِيَاءِ ..",37,"ا",2,0],["فكمْ ضاقتْ بكم دنيا","وقد وسعتْ بنا لعبا",38,"ب",2,0],["فكمْ ضاعتْ بخطوِكِ يومَ سِرنا","على دَربِ الغَريِّ رُبىً قَشيبَهْ",39,"ب",2,0],["فكم ضمت من الاعلام من نفر","رجال الله تؤويهم حناياها",40,"ا",3,0],["فكم ضاعت حياتي في المهاوي","وقد أصبحتُ في أعلى الأعالي",41,"ل",2,0]]}