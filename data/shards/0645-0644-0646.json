{"poems":[[55,"ما أراني إلا سأهجر من ليس","https://www.aldiwan.net/poem26071.html","الخفيف"],[92,"أين يا شعب قلبك الخافق الحساس","https://www.aldiwan.net/poem38915.html","الخفيف"],[62,"ملنا إلى النشر الذي تلتقي","https://www.aldiwan.net/poem52394.html","السريع"],[45,"ملنا أم نبا بنا أم جفانا","https://www.aldiwan.net/poem66784.html","الخفيف"],[61,"إذا المجرة مالت بعد تعديل","https://www.aldiwan.net/poem51485.html","البسيط"],[61,"أسعيد هل لك في زيارة منزل","https://www.aldiwan.net/poem51625.html","الكامل"],[61,"عفر الظباء لدى الكثيب الأعفر","https://www.aldiwan.net/poem51686.html","الكامل"],[61,"قد أمكن الطالب مطلوب","https://www.aldiwan.net/poem51778.html","السريع"],[80,"ملني من لا أمله","https://www.aldiwan.net/poem31333.html","مجزوء الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54313","السريع"],[248,"يا لقومي أنا من فق","https://www.aldiwan.net/poem15012.html","مجزوء الرمل"],[406,"ملني واستحل ظلمي","https://www.aldiwan.net/poem31839.html","مجزوء الخفيف"],[434,"يا هلالا في فلك","https://www.aldiwan.net/poem2494.html","مجزوء الرمل"],[556,"يا قلب أحبابنا جسمي بهم بالي","https://www.aldiwan.net/poem34245.html","البسيط"]],"verses":[["مَلَّني واثِقاً بِحُسنِ وَفائي","ما أَضَرَّ الوَفاءَ بِالإِنسانِ",0,"ن",1,0],["ملَّ نهرُ الزَّمانِ أَيَّامكَ الموتى","وأَنقاضَ عُمرِكَ المتهدِّمْ",1,"م",1,0],["مِلْنا إِلى النَّشْر الذي تلتقِي","إليه أنفاسُ الصَّبَا عاطِرَه",2,"ر",2,1],["مَلَّنا أَم نَبا بِنا أَم جَفانا","أَم قَلانا فَإِعتاضَ مِنّا سِوانا",3,"ن",2,1],["مِلنا إلى غُرفةِ المِلْحِيِّ إنَّ بها","ظبياً من الأُنس مبذولَ الخَلاخيلِ",4,"ل",1,0],["مِلْنا إلى حُسْنِ الصَّبوحِ وطيبِه","إنَّ الصَّبوحَ مَطيَّةُ الأحرارِ",5,"ر",1,0],["مِلْنا فعفَّرْنا الوجوهَ ديانةً","في التُّربِ بينَ مُحلِّقٍ ومُقَصِّرِ",6,"ر",1,0],["مِلْنا إلى شُربٍ حلالٍ لنا","إن الحلالَ الطِّلْقَ مَشروبُ",7,"ب",1,0],["مَلَّني مَن لا أمَلّهْ","وأذاب القلبَ دَلّهْ",8,"ل",2,1],["ملَّ نَهَارُ الْقَيْظِ مِنْ كَدِّهِ","وَضَجَّ نَجْمُ الصبْحِ مِنْ سُهْدِهِ",9,"د",2,0],["مَلَّني فقراً وإن كا","ن شفيقاً لا محالَه",10,"ل",2,0],["مَلَّني واستحلَّ ظُلمي","وما لي فيه يَدُ",11,"د",1,1],["ملّني العائد إذ","زدت منّي ملكك",12,"ك",1,0],["ملنا سكارى فشاهدنا بريقَكمو","أحبابنا ليت أنقذتم غريقَكمو",13,"و",1,0]]}