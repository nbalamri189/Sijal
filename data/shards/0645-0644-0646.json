{"poems":[[57,"ما أراني إلا سأهجر من ليس","https://www.aldiwan.net/poem26071.html","الخفيف"],[94,"أين يا شعب قلبك الخافق الحساس","https://www.aldiwan.net/poem38915.html","الخفيف"],[64,"ملنا إلى النشر الذي تلتقي","https://www.aldiwan.net/poem52394.html","السريع"],[47,"ملنا أم نبا بنا أم جفانا","https://www.aldiwan.net/poem66784.html","الخفيف"],[63,"إذا المجرة مالت بعد تعديل","https://www.aldiwan.net/poem51485.html","البسيط"],[63,"أسعيد هل لك في زيارة منزل","https://www.aldiwan.net/poem51625.html","الكامل"],[63,"عفر الظباء لدى الكثيب الأعفر","https://www.aldiwan.net/poem51686.html","الكامل"],[63,"قد أمكن الطالب مطلوب","https://www.aldiwan.net/poem51778.html","السريع"],[82,"ملني من لا أمله","https://www.aldiwan.net/poem31333.html","مجزوء الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54313","السريع"],[255,"يا لقومي أنا من فق","https://www.aldiwan.net/poem15012.html","مجزوء الرمل"],[415,"ملني واستحل ظلمي","https://www.aldiwan.net/poem31839.html","مجزوء الخفيف"],[443,"يا هلالا في فلك","https://www.aldiwan.net/poem2494.html","مجزوء الرمل"],[563,"يا قلب أحبابنا جسمي بهم بالي","https://www.aldiwan.net/poem34245.html","البسيط"],[1025,"","https://poetry.dctabudhabi.ae/diwan/poem/143444","الخفيف"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72340","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111796","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108894","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104820","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48215","الخفيف"],[2188,"","https://poetry.dctabudhabi.ae/diwan/poem/20917","البسيط"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126930","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91323","الكامل"],[3756,"","https://poetry.dctabudhabi.ae/diwan/poem/121968","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131072",""],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143842","الخفيف"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102729","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4728,"عابر سبيل","https://www.poetsgate.com/ViewPoem.aspx?id=176954",""],[5055,"شيل السفوح","https://www.poetsgate.com/ViewPoem.aspx?id=108499",""],[3271,"على مذبح الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=103196",""],[5092,"لهُ الحبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=179342",""],[5190,"فاقرأني على مهل","https://www.poetsgate.com/ViewPoem.aspx?id=129791",""],[5213,"أشبه البدر طلعة وجمالا","https://www.poetsgate.com/ViewPoem.aspx?id=170532",""],[5859,"منذ البداية","https://www.poetsgate.com/ViewPoem.aspx?id=29409",""],[5970,"يوقد النقمة في قلب الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=130620",""],[6102,"نَدَم ..","https://www.poetsgate.com/ViewPoem.aspx?id=185209",""]],"verses":[["مَلَّني واثِقاً بِحُسنِ وَفائي","ما أَضَرَّ الوَفاءَ بِالإِنسانِ",0,"ن",1,0],["ملَّ نهرُ الزَّمانِ أَيَّامكَ الموتى","وأَنقاضَ عُمرِكَ المتهدِّمْ",1,"م",1,0],["مِلْنا إِلى النَّشْر الذي تلتقِي","إليه أنفاسُ الصَّبَا عاطِرَه",2,"ر",2,1],["مَلَّنا أَم نَبا بِنا أَم جَفانا","أَم قَلانا فَإِعتاضَ مِنّا سِوانا",3,"ن",2,1],["مِلنا إلى غُرفةِ المِلْحِيِّ إنَّ بها","ظبياً من الأُنس مبذولَ الخَلاخيلِ",4,"ل",1,0],["مِلْنا إلى حُسْنِ الصَّبوحِ وطيبِه","إنَّ الصَّبوحَ مَطيَّةُ الأحرارِ",5,"ر",1,0],["مِلْنا فعفَّرْنا الوجوهَ ديانةً","في التُّربِ بينَ مُحلِّقٍ ومُقَصِّرِ",6,"ر",1,0],["مِلْنا إلى شُربٍ حلالٍ لنا","إن الحلالَ الطِّلْقَ مَشروبُ",7,"ب",1,0],["مَلَّني مَن لا أمَلّهْ","وأذاب القلبَ دَلّهْ",8,"ل",2,1],["ملَّ نَهَارُ الْقَيْظِ مِنْ كَدِّهِ","وَضَجَّ نَجْمُ الصبْحِ مِنْ سُهْدِهِ",9,"د",2,0],["مَلَّني فقراً وإن كا","ن شفيقاً لا محالَه",10,"ل",2,0],["مَلَّني واستحلَّ ظُلمي","وما لي فيه يَدُ",11,"د",1,1],["ملّني العائد إذ","زدت منّي ملكك",12,"ك",1,0],["ملنا سكارى فشاهدنا بريقَكمو","أحبابنا ليت أنقذتم غريقَكمو",13,"و",1,0],["مَلَّنا الشيخُ أم أبى أنْ نراهُ","في ظلال الوِصالِ يَبغي هَوانا",14,"ن",2,1],["ملنا لنعلمه بذاك لأنه","في ودنا ما زال غير ظنين",15,"ن",1,0],["ملّني مذ بتُّ فيهِ","مُستهاناً مستهاما",16,"م",2,0],["مل نحو صبك حين تكره أن ترى","بين الورى وثناً من الأوثان",17,"ن",1,0],["ملن بطاح مكة بي حديثا","مسخن به مناقبي القداما",18,"م",2,0],["مِل نَحوَ فاطِمَةَ البَتُولِ وَسَلَمَن","غاضًّا لِطَرفِكَ مِن ذُنُوبٍ خائِفَا",19,"ف",2,0],["مَلَّني عائِدي وقالَ الآسي","تَيَّمَتْهُ معاطفٌ كالآسِ",20,"س",1,1],["مِلنا عَلَيهِم بِوِردٍ لا كِفاءَ لَهُ","يَفلِقنَ بِالبيضِ تَحتَ النَقعِ أَبدانا",21,"ن",2,0],["ملني مضجعي وراحت لوجد","تتجافى في الليل عنه جنوبي",22,"ب",2,0],["ملنا بِهِ خدّاً على","خدٍّ وَجيداً فَوق جيد",23,"د",1,0],["مِلْ نحو صَبٍَّ كَانَ نَحْ","وَكَ فِي الرضا والسخط مائلْ",24,"ل",1,0],["ملني أهله فبت ومالي","من نصير به يناط الرجال",25,"ا",2,0],["ملّني مضجعي وعاف نديمي","مجلسي واجتوى جفوني الرقاد",26,"د",1,0],["ملنا إلى العيس فارتاعت لما عرفت","مما نكلفها من شدة النصب",27,"ب",1,0],["مِلنا إلى مَوليَّةٍ مَوشِيَّةٍ","قَد حَدِبَ الغَيثُ عَلَيها وَحَنا",28,"ا",1,0],["ملّني صبري متى يقرب الفجر البعيد","يا بحر مدري سراب اوّ انا شوفي شجر!؟",29,"ر",1,0],["ملني يا صاحبي حتى الطموح","ليتني بعت الحكي قبل الجواب",30,"ب",1,0],["ملْ نحو مضجعهِ وأصغِ لجرحهِ","واسمع نشيدَ الدّمِّ في القطرات",31,"ت",1,0],["مِلْنا فمالتْ دربنا عن دربهِ","فنما على سَنَنِ الدنى تقتيلُ",32,"ل",1,0],["مِلْنَا ، وكَانَ الهَوَى طَيْراً يُسَابِقُنَا","إِلَى رُبَاهَا ، وفِي أَغصَانِهَا يَشدُو",33,"د",2,0],["ملني عودي وزاد نحولي","ووهت أضلعي وسقمي طالا",34,"ل",2,0],["ملنا كما مالتِ القمحات ذابلةً","من قبل أن تبلغ الريح الطواحينا",35,"ن",2,0],["ملني الصبر لما حملته","من عذاب قاصم الحد اليم",36,"م",1,0],["مَلَّنِي الوَقتُ ؟ أَمْ مَلَلتُ وُجُودِي ؟","فالمَنايا تَكِيدُ وَ الأَحياءُ",37,"ا",2,0]]}