[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77475","الرجز"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216903","الطويل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216885","المتقارب"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56292","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79840","المتقارب"],[1803,"","https://poetry.dctabudhabi.ae/diwan/poem/31499","الطويل"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101437","الطويل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137920",""],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106820","المتقارب"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93695","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58388","المتقارب"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11346","الطويل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107069","الوافر"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86570","الوافر"],[3886,"","https://poetry.dctabudhabi.ae/diwan/poem/130556","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4679,"من الشهبُ المحاطة بالضبابِ","https://www.poetsgate.com/ViewPoem.aspx?id=142741",""],[4809,"وفوق الرمل من يبني سيشقى","https://www.poetsgate.com/ViewPoem.aspx?id=201475",""],[5232,"غزالةُ الآداب","https://www.poetsgate.com/ViewPoem.aspx?id=212931",""],[5273,"مأساة العاصي","https://www.poetsgate.com/ViewPoem.aspx?id=28757",""],[5409,"ذكرت الجنان وأنهارها","https://www.poetsgate.com/ViewPoem.aspx?id=155274",""],[5431,"(سأزرع الأرضَ آلافا من القُبَلِ)!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200121",""],[5447,"هطول","https://www.poetsgate.com/ViewPoem.aspx?id=208328",""],[5526,"تغيب الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=194548",""],[5638,"رثاء الشيخ أحمد ياسين","https://www.poetsgate.com/ViewPoem.aspx?id=198130",""],[5813,"كان الغرام احيان يطري وتنسين","https://www.poetsgate.com/ViewPoem.aspx?id=176825",""],[469,"محيّكِ أحيا الوجدَ بل اتلفَ الصبّا","https://www.poetsgate.com/ViewPoem.aspx?id=76783",""],[6147,"شهوة سريالية.. ليلة سقوط بغداد..","https://www.poetsgate.com/ViewPoem.aspx?id=151487",""],[6189,"عيبان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83602&r=&rc=69",""],[6213,"مركب ووقود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76267&r=&rc=24",""]],"verses":[["كَأَنَّ الغُلامَ الضَربَ في الرَحلِ ريشَةٌ","خَفَت فَوقَ زَورٍ مِن ظَليمٍ مُصَلَّمِ",0,"م",1,0],["كانَ الغَريبَةَ في الأَنامِ فَأَصبَحوا","مِن بَعدِ غارِبِ نَجمِهِ أَمثالا",1,"ل",2,0],["كَأَنَّ الغُلامَ نَحا لِلصُوَا","رِ أَزرَقَ ذا مَخلَبٍ قَد دَجَن",2,"ن",1,0],["كأن الغيث غدران تهاوى","كأن الزمن يشتعل اشتعالا",3,"ل",2,0],["كَأنَّ الغدرَ عِندَ القومِ دِينٌ","فَما يَدَعُ الرجالَ ولا النساءَ",4,"ا",2,0],["كَأَنَّ الغَواني بُتنَ بَينَ رِياضِهِ","فَغادَرنَ فيهِ نَشرَ وَردٍ وَعَبهَرا",5,"ر",2,0],["كَأَنَّ الغِنى آلى يَميناً يَؤودُهُ","إِذا ما أَتاها مُخفِقاً أَو تُصاخِبُه",6,"ب",2,0],["كأَنَّ الغُبارَ الَّذي غادَرَت","ضُحَيّاً دَواخِنُ مِن تَنضُبِ",7,"ب",1,0],["كأنّ الغَمَامَ لها عاشِقٌ","يُسايِرُ هَوْدَجَها أيْنِ سارا",8,"ر",2,0],["كأَنَّ الغابَ والبَرْدِيَّ فيها","أجشُّ إذا تَبْقَّعَ للحَصَادِ",9,"د",1,0],["كان الغروب يخنق المدينهْ","يغتال روح لندن.. الباردة.. الحزينهْ",10,"ه",1,1],["كأن الغنى آلى يميناً غليظة","ً عليه خلا ما قربت لا يقاربه",11,"ب",2,0],["كأنَّ الغُضونَ على وَجْنَتيهِ","يكنُّ بها نغمٌّ مُفرِح",12,"ح",1,0],["كأنّ الغصونَ المائساتِ رَواقصٌ","تَثنَّت على إيقاعِ دُفٍّ ومِزْهَر",13,"ر",1,0],["كان الغمامَ المستهلَّ فما لنا","نشكو أوان همى السحاب محولا",14,"ل",2,0],["كان الغرام بأرض كدت أذكرها","لعلها عشنا في روض حلوان",15,"ن",1,1],["كأنّ الغيم بان له حبيبٌ","فأقبل باكياً بجفون صبّ",16,"ب",1,0],["كانَ الغَواني يَقُلنَ يا أَخي فَقَد","صارَ الغَواني يَقُلنَ اليَومَ يا أَبَتا",17,"ت",2,0],["كَأَنَّ الْغُيُومُ جُيُوشٌ تَسُومُ","مِنَ الْعَدْلِ فِي كُلِّ أَرْضٍ صَلاحا",18,"ح",2,0],["كأنَّ الغُصونَ وقد أُثقِلَتْ","بما حَمَلتْ من جَنِيِّ الثِّمارِ",19,"ر",1,1],["كان الغرامُ المشترِي","وكان قلبي الثمنا",20,"ن",2,0],["كأنّ الغريبَ الدارِ يسكن فيهُمُ","تخيّر بين النَّسر والنَّسر مسكنا",21,"ن",2,0],["كأنَّ الغمام الجَون جُنَّ بأفقها","وقد صِيغ منِ تبر البروق سلاسل",22,"ل",1,0],["كأنَّ الغصونَ المائداتِ حبائبٌ","ومر النسيم المندلي رسائل",23,"ل",1,0],["كأنّ الغيمَ مما بثَّ منه","على أرجائها أندافُ برس",24,"س",1,0],["كانَ الغرابُ حَطَّ فَوقَ شَجَرَه","وَجُبنَةٌ في فَمِهِ مُدوَّره",25,"ه",1,1],["كأنّ الغنى لم يَغْنِ في النّاسِ ساعةً","إذا اختلفَ اللّحيانِ عند الجَريضِ",26,"ض",1,0],["كأنَّ الغضون من الفهدتين","إلى بلدة الزّورِ حُبكُ العقد",27,"د",1,0],["كان الغبي لم يدرِ إنك لم تزل","إلى كل أوجاع بها أنت مبصرا",28,"ر",2,0],["كأَنَّ الغصون إذا الوِرق غنَّت","على الأيك نشوانُ لن يستفيقا",29,"ق",2,0],["كَأَنَّ الغُلامَ الحَنظَلِيَّ أَجارَهُ","عُمانِيَّةٌ قَد عَمَّ مَفرِقَها القَملُ",30,"ل",1,1],["كأَنَّ الغواني إذْ تَرشَفْن رِيقَهُ","وقَبَّلنَهُ قَلَّدنَهُ بالمباسمِ",31,"م",1,0],["كأن الغيب صورها لديهِ","فأحكم وصفها فرواه شعرا",32,"ر",2,0],["كأن الغواني نشرن الشعورَ","وستَّرنَ أوجُهَهُنَّ حياءَ",33,"ا",2,0],["كان الغَري وَأَهله في حالة","تَشكو عن الماء القراح صيامها",34,"م",3,0],["كأنَّ الغصونَ وَقَد أينعَتْ","بِحَمْلِ قراصِيّها الأَغبرِ",35,"ر",1,1],["كَأَنَّ الغِنى عَن أَهلِهِ بورِكَ الغِنى","بِغَيرِ لِسانٍ ناطِقٌ بِلِسانِ",36,"ن",1,0],["كأن الغرب مد يدى عناق","فمد الشرق كفاً لن تضاما",37,"م",2,0],["كأن الغم لا يدنو إليه","وليس يعيش يوماً في حماه",38,"ا",2,0],["كان الغرام مدامة لي في الصبا","واليوم من فيض النجيع مدامي",39,"م",2,0],["كأن الغيوم بيوم خريفٍ","بنوءٍ على الأرض منطبقه",40,"ه",1,0],["كأنَّ الغيدَ وهي مقنعاتٌ","شموسٌ قد توارت بالحجابِ",41,"ب",1,0],["كأن الغيد ما خطرت ثراهُ","ولا زرعت بهِ فلٌّا وحبقا",42,"ق",2,0],["كأنَّ الغربَ أمسى الشرقَ عندي","ورحتُ أسيرُ في شرقٍ ٍوغرب ِ",43,"ب",1,0],["كان الغَرامُ بِنا مثلَ الزُّهورِ بها","ذاكَ الرحيقُ إليهِ النَّحلُ يَرتحِلُ",44,"ل",1,0],["كأن الغواين منها اقتبس","ن رفيف الثياب وإقصارها",45,"ر",3,0],["كان الغروب بهدبِ الشمس منبسطا","وهدأة الكون قد مالت إلى الكسلِ",46,"ل",1,0],["كأنَّ الغربةَ الأولى سيوفٌ","وأنَّ اللحنَ قد أضحى مِجنَّا",47,"ن",2,0],["كأن الغيم في ثغرك مع المبسم سناه ابراق","يمطر توت من ريقك أو انه توتك اللي ريق",48,"ق",1,0],["كَانَ الغِنَاءُ عَلَى الجِرَاحِ وَهَا هُمُ","يَتَرَاقَصُونَ عَلَى أَسَى الأَشْلاءِ",49,"ا",2,0],["كان الغرام احيان يطري وتنسين","في كل ساعه تمرني طاريه لي",50,"ي",1,1],["كأنَّ الغوادي خلنَ دمعي عاصياً","فقد جرّدتْ منهُ على مقلتي عضبا",51,"ب",2,0],["كأنّ الغيومَ على النجم هاجت","فولّى النّجوم الثبورَ الثبورا",52,"ر",2,0],["كان الغمام على جفنيك مزرعةٌ","من الهوى أين ذاك العاشق الدنف؟",53,"ف",1,0],["كان الغرام بصحوتي لي سلوة","وخياله عند الهجود مصاحبي",54,"ب",2,0]]}