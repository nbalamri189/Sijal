{"poems":[[93,"تركت النجم مثلك مستهاما","https://www.aldiwan.net/poem62741.html","عموديه"],[91,"ولما سعى الساعون أن نهجر الوغى","https://www.aldiwan.net/poem45088.html","الطويل"],[51,"لمن طلل أسائله","https://www.aldiwan.net/poem63087.html","مجزوء الوافر"],[68,"فتك اللواحظ والقدود الهيف","https://www.aldiwan.net/poem38482.html","الكامل"],[68,"سلبتنا فواتك اللفتات","https://www.aldiwan.net/poem40646.html","الخفيف"],[104,"هاجر أمنا ولود رؤوم","https://www.aldiwan.net/poem33099.html","الخفيف"],[48,"لا تمسين على من مات ملتهفا","https://www.aldiwan.net/poem22756.html","البسيط"],[93,"بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=53276",""],[214,"يا حاتم الجود وبحر الندى","https://www.aldiwan.net/poem13527.html","السريع"],[244,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[276,"قف بذات السفح من اضم","https://www.aldiwan.net/poem52088.html","المديد"],[382,"قلب يوسوس في الصدور ويخنس","https://www.aldiwan.net/poem59385.html","الكامل"],[382,"عقلي يحدثه لسان نائح","https://www.aldiwan.net/poem66885.html","الكامل"],[382,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[382,"طوبى لمن قد تاب بعد خطائهِ","https://www.aldiwan.net/poem66970.html","الكامل"],[422,"لله در أبي داود من رجل","https://www.aldiwan.net/poem54143.html","البسيط"],[445,"غرام ولا شكوى وعتب ولا عتبى","https://www.aldiwan.net/poem34828.html","الطويل"],[473,"صاح إن الحياة مد وجزر","https://www.aldiwan.net/poem60140.html","الخفيف"],[556,"لا تستعن أبدا بمن","https://www.aldiwan.net/poem47173.html","مجزوء الكامل"],[556,"رأيتك لا ترعى حقوقي ولم تصخ","https://www.aldiwan.net/poem47898.html","الطويل"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77452","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119976","الوافر"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46682",""],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106704","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88645","المتقارب"],[2353,"","https://poetry.dctabudhabi.ae/diwan/poem/32975","الطويل"],[2395,"","https://poetry.dctabudhabi.ae/diwan/poem/101401","الرمل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83243","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204445","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62778","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138705",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91812","الوافر"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128899","الطويل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78358","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90865","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94597","الطويل"],[5206,"مَرثاة الصديق الغِشْرِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=187432",""],[5464,"القتلى لن يُحييهم الإعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=125401",""],[5464,"القتلى لا يحييهم الاعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=24377",""],[5688,"تنصحني لأنسى ولكن...","https://www.poetsgate.com/ViewPoem.aspx?id=201026",""],[5691,"حمار الحطاب","https://www.poetsgate.com/ViewPoem.aspx?id=205825",""],[5691,"ربيع عشتار","https://www.poetsgate.com/ViewPoem.aspx?id=206247",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""]],"verses":[["فَجَهلاً تَبعَثونَ الرُسلَ فينا","تَديفُ لَنا مَعَ الأَريِ السِماما",0,"م",2,0],["فجّهزت جيشاً للجهاد عرمرما","قهرت به ذاك العدو الذي ولّى",1,"ل",2,0],["فَجَهَّزَهُ إِلى جَدَثٍ","سَيَكثُرُ فيهِ خاذِلُهُ",2,"ل",2,0],["فَجَهِلتُ تَضعيفَ الجُفونِ وَإِنَّما","ضُعفُ القُلوبِ بِذَلِكَ التَضعيفِ",3,"ف",1,0],["فَجَهِلنا الهَوى وَلَم نَدرِ أَنَّ ال","أُسدَ تَغدو فَرائِسَ الغاداتِ",4,"ت",1,0],["فَجَهلتم حَق الجوار وَصحتم","أَيُّها الناس حقنا مَهضوم",5,"م",1,0],["فَجَهِّزيني لَحاكِ اللَهُ والِدَةً","عَلَيَّ أَتبَعُ أَصحابي فَأَنتَجِز",6,"ز",1,0],["فجهلا تبعثون الرّسل فينا","نديف لنا مع الأري السّماما",7,"م",2,0],["فجهز البر لها عاجلا","واغنم ثنايَ واغتنم اجري",8,"ر",2,0],["فجهز إبراهيم باشا وجيشه","كسلسلة موصولة حين تسحب",9,"ب",1,0],["فجهات الصبر مظلمة","وَمَرامي الهجر مؤلمة",10,"ه",1,0],["فجهادُها وسلوكها متوقِّفٌ","منها على عقلٍ رصينٍ يَحرُس",11,"س",1,0],["فجهنمٌ للنوح أسنى عِلَّةٍ","كالنار يسجرها زنادٌ قادح",12,"ح",1,0],["فجهنمٌ لو حل فيها قطرةٌ","من طيبك ارتدت نعيمَ سماء",13,"ا",2,0],["فجهنمٌ وادٍ عميقٌ حالكٌ","قَطعُ الرجا والنارُ في أرجائه",14,"ا",3,0],["فجهَّز الجيشَ والظلماءُ عاكفةٌ","والرعد والبرق ذو ومض وذو زجل",15,"ل",1,0],["فَجَهَّزَ فِيَّ العلمَ والحلمَ والنُّهى","وجَهَّزَ فيكِ الخيلَ والطعنَ والحربا",16,"ب",2,0],["فَجِهازُ السَماءِ شَربٌ وَلاذٌ","وَأَثاثُ الرِياضِ دُرٌّ وَتِبرُ",17,"ر",1,0],["فجهاتُ مَن لبس التُّقى","محروسةٌ فيه مَصونَهْ",18,"ن",2,0],["فجهرُك لي مُرْضٍ وسرُّك مُسخِطٌ","ووجهك بسّامٌ وقلبك كالحُ",19,"ح",1,0],["فَجَهَّزَها وَوافَت بِاِحتِفالٍ","وَبَأسٍ مِنهُ رَأسُ الكُفر شابا",20,"ب",2,0],["فجهم عند مشتجر العوالي","وعند البذل طلق غير جهمِ",21,"م",1,0],["فجَهِدتُ أفكارِي ورَضتُ خواطري","وسَهِرتُ للتصنيفِ مِن جَرّاكِ",22,"ك",1,0],["فجهَّزَ ما تحوي ذخائِرُ مُلكِهِ","يَذوذُ بها عن نفسِهِ وَيُداعِسُ",23,"س",1,0],["فجهلا قانص المكرمات","امامك لا ترجع القهقري",24,"ر",2,0],["فَجَهَّلتَ طَوّافاً وَزَيَّنتَ فِعلَهُ","فَأَصبَحَ طَوّافٌ يُمَزَّقُ بِالنُبلِ",25,"ل",1,1],["فجهاد الكفر يدعوك له","وطراد الخيل يهواك اشتياقا",26,"ق",2,0],["فَجِهادُهُ وَنِضالُهُ لِفِخارِهِ","أَرَأَيتَ كَيفَ رَأَيتَ ناظِرَكَ اِعتَرَف",27,"ف",1,0],["فجهلٌ له بعد التعلم ينتهي","وجهلٌ له إذ كان من جهله يشكو",28,"ك",2,0],["فجهل الورى علم صحيح محقق","وعلمهم جهلٌ ودعواهمُ إفك",28,"ك",1,0],["فجُهّالُنا فيها على الخيلِ تركبُ","وألبابُنا فيها تُجَرُّ وتُسْحَبُ",29,"ب",1,0],["فجهزت حربٌ لها جحفلا","سد الفضا تطلب ثاراتها",30,"ت",3,0],["فجهّلني الجهولُ وَلا يُبالي","وَصغّرني الصَغيرُ وَلَيسَ يَدري",31,"ر",2,0],["فجهل ونقصان وزور وباطل","وأكبر عيب فيك انك فان",32,"ن",1,0],["فجهلي عبرة وَالسَقم أَخرى","وَعَيني قَد أَرَتني العِبرَتَين",33,"ن",1,0],["فجهاده الهجران لي أبداً ولم","يجنح لسلم لي ولا بسلام",34,"م",1,0],["فجهلي معذورٌ وحلمك واسعٌ","أتجحد أني ثابت الحبّ والودِّ",35,"د",1,0],["فَجُهدٌ قَليلٌ والحيَاةُ قَليلَةٌ","وعَمَّا قَليلٍ أنتَ في التُّربِ مَولوجُ",36,"ج",1,0],["فجَهِّزي للهوى غُسلا ً ومقبرة ً(6)","أمّا أنا ففؤادي جَهَّزَ الجّزَعا",37,"ع",2,0],["فجهّزي للهوى غُسْلا ً ومرثية ً","أمّا أنا ؟ فضياعي جهّزَ الجزعا",38,"ع",2,0],["فجهرت بالنّصح الكريم سجية","ورأيتني أنّي بذاك جدير",39,"ر",1,0],["فجهز الركبَ مصحوباً بأمتعةٍ","وعدّةَ القنْصِ من أقْواسِ نُشّابِ",40,"ب",1,0],["فجهَّزْتُ حاجاتي وعِدَّةَ رِحْلَتي","ويمَّمْتُ شَطْرَ اللِّحْفِ بالأهْلِ والدّارِ !",41,"ر",1,0],["فجهز المرتضى فوراً وصيتها","فغامروه بأمر مدهش عجب",42,"ب",1,0]]}