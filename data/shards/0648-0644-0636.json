{"poems":[[53,"ردوا الغليل لقلبي المشغوف","https://www.aldiwan.net/poem29970.html","الكامل"],[45,"إن تأمل محاسن الأصبهاني","https://www.aldiwan.net/poem64696.html","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[133,"وخود راق منها ما تراه","https://www.aldiwan.net/poem54691.html","الوافر"],[170,"كره الله ما أحب الأعادي","https://www.aldiwan.net/poem1621.html",""],[262,"إنا لتقتلنا العيون","https://www.aldiwan.net/poem38164.html","مجزوء الكامل"],[465,"صحة الوجد بالجفون المراض","https://www.aldiwan.net/poem3588.html","عموديه"]],"verses":[["وَلَضَيغَمٍ يَطَأُ الرِجالَ غُلُبَّةً","بِقَناً مِنَ الأَنيابِ أَو بِسُيوفِ",0,"ف",1,0],["وَلِضَنّي بِالشِعرِ أَعذَبُ مِن ضَنِّ","وَجيهٍ بِكُتبِهِ وَرِقاعِه",1,"ع",2,0],["وَلَضاع الشعرُ لذِي أدَبٍ","أو ينفقهُ من يَنْقُدهُ",2,"د",2,0],["وَلضم أرَ قَبلَهَا سِحراً مُبِيناً","تُعَقِّدُهُ العَوَارِضُ والشِّفَاهُ",3,"ا",2,0],["وَلِضَبطِ القِرطاسِ في الخَطِّ يسرا","هُ وَتَصريفِ طرفِهِ لِلطَرادِ",4,"د",1,0],["ولضيفنا تعلو القدور","وتنحر الكوم الأمون",5,"ن",1,0],["ولضربِ الحسامِ في الغمد قلبي","كسر الجفن منهُ والحدُّ ماضي",6,"ض",2,0]]}