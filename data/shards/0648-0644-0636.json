{"poems":[[53,"ردوا الغليل لقلبي المشغوف","https://www.aldiwan.net/poem29970.html","الكامل"],[45,"إن تأمل محاسن الأصبهاني","https://www.aldiwan.net/poem64696.html","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"]],"verses":[["وَلَضَيغَمٍ يَطَأُ الرِجالَ غُلُبَّةً","بِقَناً مِنَ الأَنيابِ أَو بِسُيوفِ",0,"ف",1,0],["وَلِضَنّي بِالشِعرِ أَعذَبُ مِن ضَنِّ","وَجيهٍ بِكُتبِهِ وَرِقاعِه",1,"ع",2,0],["وَلَضاع الشعرُ لذِي أدَبٍ","أو ينفقهُ من يَنْقُدهُ",2,"د",2,0]]}