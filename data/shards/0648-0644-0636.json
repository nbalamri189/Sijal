{"poems":[[55,"ردوا الغليل لقلبي المشغوف","https://www.aldiwan.net/poem29970.html","الكامل"],[47,"إن تأمل محاسن الأصبهاني","https://www.aldiwan.net/poem64696.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[136,"وخود راق منها ما تراه","https://www.aldiwan.net/poem54691.html","الوافر"],[173,"كره الله ما أحب الأعادي","https://www.aldiwan.net/poem1621.html",""],[266,"إنا لتقتلنا العيون","https://www.aldiwan.net/poem38164.html","مجزوء الكامل"],[469,"صحة الوجد بالجفون المراض","https://www.aldiwan.net/poem3588.html","عموديه"],[666,"","https://poetry.dctabudhabi.ae/diwan/poem/147420","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48608","الخفيف"],[881,"","https://poetry.dctabudhabi.ae/diwan/poem/21190","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53102","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60819","الكامل"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84858","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117877","الكامل"],[4830,"الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=195017",""],[4119,"عن خاطري نبأ الخيال الخاطر","https://www.poetsgate.com/ViewPoem.aspx?id=16155",""],[5277,"هروب العائذين","https://www.poetsgate.com/ViewPoem.aspx?id=185702",""],[5302,"في فؤادي ضرام","https://www.poetsgate.com/ViewPoem.aspx?id=201267",""],[5956,"لماذا سُمِّي الصِّهرُ صهرا؟","https://www.poetsgate.com/ViewPoem.aspx?id=204009",""],[6097,"عَكّارُنا","https://www.poetsgate.com/ViewPoem.aspx?id=190700",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"]],"verses":[["وَلَضَيغَمٍ يَطَأُ الرِجالَ غُلُبَّةً","بِقَناً مِنَ الأَنيابِ أَو بِسُيوفِ",0,"ف",1,0],["وَلِضَنّي بِالشِعرِ أَعذَبُ مِن ضَنِّ","وَجيهٍ بِكُتبِهِ وَرِقاعِه",1,"ع",2,0],["وَلَضاع الشعرُ لذِي أدَبٍ","أو ينفقهُ من يَنْقُدهُ",2,"د",2,0],["وَلضم أرَ قَبلَهَا سِحراً مُبِيناً","تُعَقِّدُهُ العَوَارِضُ والشِّفَاهُ",3,"ا",2,0],["وَلِضَبطِ القِرطاسِ في الخَطِّ يسرا","هُ وَتَصريفِ طرفِهِ لِلطَرادِ",4,"د",1,0],["ولضيفنا تعلو القدور","وتنحر الكوم الأمون",5,"ن",1,0],["ولضربِ الحسامِ في الغمد قلبي","كسر الجفن منهُ والحدُّ ماضي",6,"ض",2,0],["ولضحكة هزت مداي واعلنت","موتي لأيام - بلاها- ذابله",7,"ل",2,0],["ولضيفي عليَّ ما طاب من لط","فٍ وجدٍّ ونجدة ومزاحِ",8,"ح",1,0],["وَلضستُ بِلاقي المَرءِ أَزعُمُ أَنَّهُ","خَليلٌ وَما قَلبي لَهُ بِخَليلِ",9,"ل",1,0],["ولضرجت زرق الأسنة في الوغى","بدم الطُّلى تحت العجاج الأسود",10,"د",1,0],["وَلضم تَر عيني بعدَهم حَسَناً يُرىَ","ولَم تَلقْ نفسي عن هوى القوم مَصْرفَا",11,"ف",2,0],["وَلضما بَدا بِالبشر قُلت مُؤرِخاً","سَعيداً بِصَفو الخَير مَولد سَيد",12,"د",1,0],["ولضبط هذا العام تاريخاً ولي","العهد أعظم جاه طوبى لقبا",13,"ب",2,0],["ولضى مصابِكَ قد أصابَ حشاشتي","وطوينَ نيرانُ الفراقِ الأضلُعا",14,"ع",2,0],["ولضمر سبقت إلى غاياتها","والسبق من شيم الجواد الضامر",15,"ر",1,0],["ولضمّة القبرِ الرهيبة حقها","ولكلّ قبرٍ شاهدٌ بعذابهِ",16,"ب",2,0],["ولضعفي به غدوت كطفل","فاته الحضن والسقا والطعام",17,"م",1,0],["ولضِحْكة غِرِّيدة من ثغره","كالرعد منتشياً من الأرياحِ",18,"ح",1,0],["وَلَ\"ضَاهِرٌ\" بِدِيَارِنَا","بَدْرٌ أَنَارَ فَأَحْسَنَ",19,"ن",1,0],["وَلضوء الشموس بالكف يخفي","ما الَّذي كانَ قَلبه الوغد يُلفي",20,"ي",1,0]]}