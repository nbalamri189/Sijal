""],[585,"صوتٌ تجاوب بين الهمس والعلن","https://www.poetsgate.com/ViewPoem.aspx?id=161884",""],[585,"بلغنا من الآمال ما كان قاصيا","https://www.poetsgate.com/ViewPoem.aspx?id=161842",""],[5376,"تئن على فراق الأهل درعا","https://www.poetsgate.com/ViewPoem.aspx?id=189706",""],[5397,"متى آمن الدنيا من الغدر أخدع","https://www.poetsgate.com/ViewPoem.aspx?id=157923",""],[709,"خطبتَ المجدَ بالأسلِ العوالي","https://www.poetsgate.com/ViewPoem.aspx?id=2924",""],[5582,"ثَنَتْ لِوَداعِي جِيدَها غُدْوَةً يُسْرَا","https://www.poetsgate.com/ViewPoem.aspx?id=187150",""],[5582,"نَعِيمٌ تَقَضَّى مُسْرِعاً فِي انْفِلاتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=186755",""],[5720,"يا رب","https://www.poetsgate.com/ViewPoem.aspx?id=214737",""],[5829,"جنة الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=151690",""],[5842,"جنة الدنيا/زهير شيخ تراب","https://www.poetsgate.com/ViewPoem.aspx?id=152687",""],[5975,"أريدك","https://www.poetsgate.com/ViewPoem.aspx?id=52978",""],[6115,"الزمان القليباني","https://www.poetsgate.com/ViewPoem.aspx?id=180514",""],[6127,"إلى موسى(ع)","https://www.poetsgate.com/ViewPoem.aspx?id=203675",""],[469,"فلا خاب ظني في العقيق وأهله","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574818",""],[6251,"أتيتك بالبشر لا بالعزاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76474&r=&rc=14",""],[5190,"اعذريني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78335&r=&rc=48",""]],"verses":[["وَكَم صاحِبٍ كَمَناطِ الفُؤادِ","عَنانِيَ مِن يَومِهِ ما عَناني",0,"ن",2,0],["وَكَم صاحِبٍ كَالرُمحِ زاغَت كُعوبُهُ","أَبى بَعدَ طولِ الغَمزِ أَن يَتَقَوَّما",1,"م",2,1],["وَكَم صَريخٍ نَهَضتَ تَنصُرُهُ","وَالطَعنُ يَستَرعِفُ القَنا عَلَقا",2,"ق",2,0],["وَكَم صافَ مِن دارِهِم سَيِّدٌ","وَقاظَ يُعالِجُ في الجيدِ قِدّا",3,"د",2,0],["وَكَم صاحَتِ الأَيّامُ خَلفي بِرَوعَةٍ","فَصِرتُ بِعَينِ الجازِعِ المُتَلَفِّتِ",4,"ت",1,0],["وَكَم صارِخٍ ناداكَ لَمّا تَلَبَّبَت","بِهِ السُمرُ في يَومٍ بِغَيرِ ذُكاءِ",5,"ا",2,0],["وَكَم صَدرِ مَوتورٍ تَطَلَّعَ غَيظُهُ","وَقَلَّبَ قَولاً عَن لِسانِ مِراءِ",5,"ا",2,0],["وكمْ صَرَفَ التّأميلَ نحوَكَ آمِلٌ","فصيّرْتَهُ بالعدْلِ ممْتَنِعَ الصَّرْفِ",6,"ف",1,0],["وكم صارم قد سُلَّ من لحظِ أَحوَرٍ","وكَمْ ذابلٍ قد هُزَّ من ناعمِ القَدِّ",7,"د",1,0],["وكم صنائع معروفٍ تقول ألا","ما كانَ أربحَ في الصنفين تاجره",8,"ر",2,0],["وكم صدَّتْ وإن لم أجنِ ذنباً","وأعقبَ صدَّها قَطْبٌ وعبْس",9,"س",1,0],["وكم صالَ بالأملاكِ وسْطَ جنودِها","وأخنى على أهلِ النُّبوّاتِ والحِكمْ",10,"م",1,0],["وكم صاحبٍ غرَّني حبله","فأعصمتُ منه بغيرِ الأَمُون",11,"ن",1,0],["وكم صرفتَ حميدَ الفعل عن ظُلَمي","صرفَ الزمان ذميم الفعلِ مُدَّهنا",12,"ن",2,0],["وَكَمْ صَيَدٍ بَدا لَكَ مِن ذَليلٍ","كَما مالَتْ مِنَ المَصلوبِ عُنقُ",13,"ق",1,0],["وَكَم صَحَّ الوِدادُ فَكانَ صِهراً","وَكانَ كَأَقرَبِ القُربى صَفاءَ",14,"ا",2,0],["وَكَم صَحِبتَ أَخاها في مُنازَلَةٍ","وَكَم سَأَلتَ فَلَم يَبخَل وَلَم تَخِبِ",15,"ب",1,0],["وَكَم صَعَّدَت كَفّاكَ مِن فَرعِ سورَةٍ","عَلَت فَوقَ أَيدٍ لا تُنالُ طِوالُها",16,"ل",3,0],["وكم صاحَبْتُ من أملٍ مُحالٍ","فأوقَفَني على طَلَلٍ مُحيلِ",17,"ل",1,0],["وَكَم صارَ تَحتَ الأَرضِ مِن خامِدٍ بِها","وَقَد كانَ يَبني فَوقَها وَيَشيدُ",18,"د",1,0],["وَكَم صَبٍّ تَفاءَلَ في حَبيبٍ","وَفى لي إِنَّ حِبّي ما وَفى لي",19,"ل",2,0],["وكم صخرٍ أحسَّ بما عنانا","وما عَرَفَ الحديثَ ولا الكلاما",20,"م",2,0],["وَكَم صالَت عَلى بَرٍّ تَقِيٍّ","أَكُفٌّ بِالمَواهِبِ أَرفَقَتهُ",21,"ت",2,0],["وَكَم صحبت خَليلاً","فَكانَ غير خَليل",22,"ل",1,0],["وكَمْ صانَ مصراً من بنيه مملكٌ","بعيد منال العزمِ جَمّ المطَالبِ",23,"ب",1,0],["وكم صادمته من لياليه نكبة","ففكك اغلال وكشف معضلا",24,"ل",2,0],["وَكَم صادَفت مِن ظَبي كَحيل","وَكَم شاهَدتُ مِن بَدرٍ تَمام",25,"م",1,0],["وَكَم صابَ مِنهُ في الشَدائِد مُنُجِداً","سَحابٌ يُفيدُ الخَلقَ رَيّا بِلا صَدىً",26,"د",2,0],["وَكَم صاحِبٍ وارَيتُ في الكَشحِ وُدَّهُ","تَبَيَّنَ لي مِنهُ عَدُوٌّ مُكاشِحُ",27,"ح",1,0],["وَكَم صالحٍ فيكُم ولكنَّ فِتنةً","بِها كَثُرَ الأخباثُ عمّمتِ الشرّا",28,"ر",2,0],["وكم صبّ فيهِ للمدامع جدول","وكم هبّ فيهِ للقلوب زفيرُ",29,"ر",1,0],["وَكَمْ صاحبٍ جاورتُهُ وصَحبتُهُ","ولما افْتَرقْنا ظَلَّ يَطْلُبُ صُحْبَتي",30,"ي",1,0],["وكم صبوتُ إلى وَرْدِ الخدود ولم","أَرْضِ العذولَ الذِي قد لجّ في العَذَل",31,"ل",1,0],["وكم صارَ شملٌ للعبادِ مُشَتَّتا","فنظَّمهُ فخرُ الملوكِ سَعِيدُ",32,"د",1,0],["وكم صارَ شملٌ للبلادِ مشتتا","وخربَ قصرٌ في البلادِ مشيدُ",33,"د",1,0],["وكم صحتُ مثلَ الدّيكِ أُوقِظُ أُمتي","وأُطلعُ نورَ الشمسِ فوقَ رُباك",34,"ك",1,0],["وكم صروحٍ وأَبراجٍ ممرّدةٍ","زدنا بها الملكَ توطيداً وتأمينا",35,"ن",2,0],["وَكَم صَباحٍ مُسفِرٍ","مِن ثَغرِهِ إِذ سَفَرا",36,"ر",2,0],["وكم صابر كم صادق متبتل","إلى اللَه عن قصد صحيح وعزمة",37,"ه",1,0],["وكم صرع القربان قبلك فتنة","وأمضى معاصى اللّه كبرة سلطان",38,"ن",1,0],["وَكَمْ صَاحَ في الأَبطالِ هَلْ مِن مُبارِزٍ","فَأخرسَ كُلٌّ عن إجبابتهِ أَنَا",39,"ن",2,1],["وَكَم صُمت عَن لَذّات دَهري عِفّة","عَلى أَنَّه كَم لي عَلى ريقه فطر",40,"ر",1,0],["وكم صاحبٍ لمّا عدا الدّهُر طَوْرَهُ","تَناوَم عن نَصْري وقد جْئتُ أستَعْدي",41,"د",2,0],["وكم صاحبٍ داريْتُ أمزجُ جَهْله","بحِلْمِي أزماناً فلم يتَمَزَّج",42,"ج",1,0],["وكم صانَتْ أَكِلَّتها وُجواً","عَليها مهجتي أبداً تذال",43,"ل",1,0],["وكم صاغ من تبر القريض جمانة","وأفرغ معناها بأحسن قالب",44,"ب",1,0],["وكم صَبَرْتُ وقلتُ الحُرُّ يُرْجِعُهُ","لِينُ الكلامِ وإِنْ وَلَّى بِهِ الأَنَفُ",45,"ف",1,0],["وكم صد عني موثَق الخدّ مونق","فما سدّ عني باتر الحد باتك",46,"ك",1,0],["وكمْ صَحِبُوا نُجُومَ اللَّيْلِ حَتَّى","جَلاها فِي عُيُونِهِمُ الضَّحَاءُ",47,"ا",2,0],["وكم صَدَعْتُ فؤادَ اللَّيلِ عن قَمرٍ","لَهُ هَوىً فِي صميمِ القلبِ صادِعُهُ",48,"ع",2,0],["وكم صيروا الإيمان والكفر لعبة","وكم حللوا ما كان قبلا محرما",49,"م",2,0],["وكم صديق عزَّ داريتُه","لو رُزِقَ الإنصافَ دارانيا",50,"ي",2,0],["وكم صاحبٍ كنتُ بالقُرب منه","أجلَّ محلِّ النبيهِ العظيمِ",51,"م",1,0],["وكم صاحبٍ منهم غروراً عقدتُه","بنفسي وكفُّ الغدر عني تحُلُّهُ",52,"ل",2,0],["وكم صَوْن جسم بعد موت أذلَّه","كما ذلَّ بالتَّصْبير جسمُ هِشام",53,"م",1,0],["وكم صامت عن واجبٍ وهو ناطقٌ","وآخر ذو صمتٍ واِنْ راحَ ينطقُ",54,"ق",1,0],["وكم صَعبةٍ من لزْبةٍ وحوادثٍ","تجلَّتْ بأيامِ الوزيرِ النَّواضِرِ",55,"ر",1,0],["وكم صبحت لدن الوالي يمينه","فللتيه والإعجاب هن عواسل",56,"ل",1,0],["وكم صاحب أوليته الشكر مقبلاً","فأدبر يثني عطفه وهو شاتم",57,"م",1,0],["وكم صنتُها خوفَ الرقيبِ وسعيهِ","وكفكفتُها مِن قبلُ تَتْرَى مدودُها",58,"د",3,0],["وكم صار ملذوذا عذاب عذابها","وكم فاوضتنا القارعات بسطوتي",59,"ت",2,0],["وَكَم صَباحٍ لِلرّاحِ أَسلَمَني","مِن فَلَقٍ ساطِعٍ إِلى فَلَقِ",60,"ق",1,0],["وكم صَاحِبٍ عَاشَرتُه وألفتُه","فما دَام لي يوماً على حُسنِ عهده",61,"د",2,0],["وكم صبّحْتَ بالغاراتِ حيّاً","فأصبح ميّتَ الأطلالِ بالي",62,"ل",2,0],["وَكم صاحِبٍ لِي كنتُ أكره فقدَهُ","تسلّمه منّي الفَناءُ المعجّلُ",63,"ل",1,0],["وكم صاحبٍ عُلِّقْتُهُ فتقطّعَتْ","بأيدي المنايا من يديَّ علائقُهْ",64,"ق",2,0],["وكم صَدّ مِقْداماً وثَبّط ماضياً","على عزمِهِ جهلٌ بما في العواقِبِ",65,"ب",1,0],["وكمْ صُدِعَتْ للفاتكينَ مَفارِقٌ","وكم أُرغِمتْ للمالكينَ أُنوفُ",66,"ف",1,0],["وكم صديقٍ ليَ في دَمْعِه","لمَّا رأَى الحاسِد في ضحْكه",67,"ك",2,0],["وكم صعدت إلى الأوج ارتقاءً","فتاتك يا أبا المتعلمات",68,"ت",1,0],["وكَم صاحِبٍ رُضتَ أخلاقَه","وداوَيتَ عِلَّتَه فانتَقَش",69,"ش",1,0],["وكم صلةٍ لي من يديك ومثلها","بطي كتاب جاءني كنت أرقب",70,"ب",1,0],["وكم صورت أمهات حزانى","حرجن صدورا كسفن عيانا",71,"ن",2,1],["وكم صد مات قام مجدك دونها","يحامى وجبار السموات يدفع",72,"ع",1,0],["وَكَم صَفَّ في الهَيجاءِ وَالحَربِ وَحدهُ","وَقَد صالَ في الهَيجاءِ كَالأَسدِ الوردِ",73,"د",1,0],["وَكَم صَبا مِن أَصبَهانَ أَخو نَوى","رَصيد الفُؤادِ عَلى الغَرامِ المضمرِ",74,"ر",1,0],["وكم صُنتُ نفسي عن حِوار مُجالِسٍ","مَلاغِمُهُ الوَجْعاء والكَلِمُ الضَّرْطُ",75,"ط",1,0],["وكم صدماتٍ للزمان رددْتها","بحلم به صدرُ الزمان يضيق",76,"ق",1,0],["وكم صلاة قمتها","لنصبي المتمم",77,"م",1,0],["وكم صبيح صاني","وكم مليح عادني",77,"ي",1,0],["وَكَم صَنَعَ اللَهُ مِن مَرَّةٍ","عَلَيهِم وَقَد أُمِروا بِالحَذَر",78,"ر",1,0],["وكم صحبت أخا عهد أجدده","ولم أقل أسفا يا صاحبي قفا",79,"ف",2,0],["وَكَم صامتٍ بينَ المعاشرِ مطرقٍ","وَأَفكارهُ في حلبةٍ وطرادِ",80,"د",1,0],["وكم صادفت فيه من عقابٍ","شديد البأس قنّاصٍ معاقبْ",81,"ب",1,0],["وكم صُمَّ عن مَفْهومٍ أَمْرِكَ ماردٌ","فأَفْهَمَهُ المَقْصودَ قصدُ القَنَا الصُّمِّ",82,"م",1,0],["وكم صِيْدِ أَبْطالٍ أَزَلْتَ امْتِناعَها","فلم يُغْنِ عنْها حِرْزُها واحترازُها",83,"ز",3,0],["وكَم صاحِبٍ ب حَماةَ تَرَكْتُ","بِتَذْكارِ عَهْدي كثيرَ التَّغَنْ",84,"ن",1,0],["وكم صبغت بياضاً بالسواد بها","وكم مزجت هناك الغيَّ بالرشَد",85,"د",1,0],["وكم صعبت ضراء عضت بها اللها","فحل عليها لطفه فتجلت",86,"ت",1,0],["وكم صادمته من لياليهِ نكبة","ففكك أغلالاً وكشف معضلا",87,"ل",2,0],["وكم صانوا كرامةَ ذي إباء","وكم صاغوا لبائسة حجابا",88,"ب",2,0],["وكم صغيرٍ وكم ذَوِي هَرَمٍ","وكم عجوزٍ أودى بها الكِبَر",89,"ر",1,0],["وكم صانع للوجود الخلود","وأيديه للنجم كم رافعه",90,"ع",2,0],["وكم صُنوفٍ أَقْبَلتْ مُنْجَرَّهْ","وكم رأَينا عَجباً من حرّهْ",91,"ه",1,0],["وكم صالح يمليه لي منه قرة","وكم حسن تحوى مناولة النصر",92,"ر",1,0],["وَكَم صَريعٍ لَكَ صادَفتَهُ","مُنكَشِفَ العَوالي حَلَقاتِ الزَرَد",93,"د",1,0],["وكم صحَّ من أمثاله فهو واحد","من النوع إن شئتم وإلا من الجنس",94,"س",1,0],["وكم صارخ لم يلف بعدك مصرخاً","ومستنجد لم يلف بعدك منجدا",95,"د",2,0],["وكم صنعت يمينك من جميل","ولست ارى لما صنعته حصرا",96,"ر",2,0],["وكم صاحب أملته أن يعينني","فكان كبرق لاح لي وهو خالب",97,"ب",1,0],["وكم صحابيّ بها استشهدا","وفي خبايا أرضها قد لُحدا",98,"د",2,0],["وكم صحت من صوت بقرم فلم يجب","سوى أرني ذا المال فوق الحلاحل",99,"ل",1,0],["وكم صدقات واصلتها صلاته","مسبلها يجري بوقف فؤبد",100,"د",1,0],["وَكَم صَعَدَ السَّرِيرَ عَلَى اعتِزَازٍ","وَطَأطَأَ تَحتَ أخمَصِهِ العَنِيدُ",101,"د",1,0],["وكم صغار نفوس","لا يعرفون نجاري",102,"ر",2,0],["وكم صنم عليه طلاء قبر","تراه يخاف بالنقد انحطاما",103,"م",2,0],["وكم صبر يدوم الظلم منه","وكم ساد الجزوع على الصبور",104,"ر",1,0],["وكم صامت ناطق في الثرى","بآي فصاح كآي السور",105,"ر",1,0],["وكم صال والهيجاء قانٍ نجيعها","بكل صقيل لا تفل مضاربه",106,"ب",2,0],["وكم صبحٍ أنا بَيْنَ الكلابِ","وليلٍ بِتُّه رَهْنَ اكتئابِ",107,"ب",1,0],["وكم صاحبٍ أكرمته غير طائعٍ","ولا مكره إلا لأمر تعمدا",108,"د",2,0],["وكم صادِرٍ قادَتْهُ نغْمَةُ صادِحٍ","فَما عادَ إلا والخلِيُّ مُتيَّمُ",109,"م",1,0],["وكم صارعت شخص الموت حتى","بدت لي ناجذيه مع الثنايا",110,"ا",3,0],["وكم صلت جيادك حين صَلت","ظباك ونكّبت عمن تزكّى",111,"ك",2,0],["وَكَم صَباح نَرى حرّ الهجير بِهِ","وَما لَنا من ضياه بَعضُ تَأليق",112,"ق",1,0],["وَكَم صَدمة أَلقى وَأَثبت واثقاً","تَزلزَلُ عَنها الراسيات الرَواسخ",113,"خ",1,0],["وكم صاحبتُ من أصحا","ب آداب وأديانِ",114,"ن",1,0],["وَكَم صَرَعَت مِن عاشِقيها فَما أَرعَووا","وَكَم خَدَعَتهُم بِالوُعودِ الكَواذِبِ",115,"ب",1,0],["وَكَم صادَ ذا مُلكٍ يُباهي بِجَيشِهِ","فَأَسحَرَ حَتّى اِرفَضَّ عَنهُ اِعتِكارُهُ",116,"ر",2,0],["وكم صحائف في الأخرى يبيضها","عطف على من دهتهم سود أيام",117,"م",1,0],["وكم صر اليراع فسر حراً","وأورث ذا مصانعةٍ صداعا",118,"ع",2,0],["وكم صحبتُ بها غُراً غطارِفةً","حازوا المكارمَ في الدنيا وفي الدينِ",119,"ن",1,0],["وكم صديقٍ رَغِبْتُ عنه","قد عِشْتُ حتى رَغِبْتُ فيه",120,"ي",2,0],["وكم صاحبٍ نبهته من جفائه","فضاع وما أجدى وقد زاد في كربي",121,"ب",2,0],["وَكَم صدمت بِشَعب في مَسالِكِه","حَتّى اِستَوى فيهِ عِندي الزبد وَالخام",122,"م",1,0],["وكم صدوحٍ تردَّت وهي آتفةٌ","لم تُجدها الصَدحَ أفنانٌ واسحارُ",123,"ر",1,0],["وكم صعيدٍ بها نارُ اللظى اِشتعلت","قَد قيلَ ذي فَلكٌ فيها سِنِمّارُ",124,"ر",1,0],["وكم صباحٍ بهِ شمس الضحى بَزَغَت","آلوا مُصرين أن النور أعكارُ",124,"ر",1,0],["وَكَم صبيحٍ مَليحٍ صبحُ جبهتهِ","تَرنو لَهُ من سما الأفلاك أقمارُ",124,"ر",1,0],["وكم صحبتُ من الإخوان في زمني","ففارقوني على رغم ومقتسر",125,"ر",1,0],["وكم صدور أقعدوها على","عجز فلن تقدر أن تنهضا",126,"ض",2,0],["وكم صبرنا على مُرّ الشّتات فما","تغيّر القلب إذ ثارت به اللُجَجُ",127,"ج",1,0],["وكم صدورٍ ماتضيق وضاقت بلجة بعوض","جلّ من حكمه يغيّر مايضفّن المحاني",128,"ن",2,0],["وكم صال فيها الخائنون لعهدها","وكل هزيل ما يذوب حياء",129,"ا",2,0],["وكم صبرت على الأيام عاتيةً","عسى الصبور من الأيام ينتصف",130,"ف",1,0],["وكم صبرت على لؤمٍ وذبذبةٍ","وكل نذل على الأحرار مضطغن",131,"ن",1,0],["وكم صحت فيهم باغتيالي تريثوا","فلستم بقتلي تغلبون الأمانيا",132,"ي",2,0],["وكم صبر الأحبة من بعاد","تقيد النار بالأحشاء ولعا",133,"ع",2,0],["وكم صعدة سمراء يشهق في الوغى","بطعنتها صدر الكمي المدرع",134,"ع",1,0],["وكمْ صبّحتَ بالغارِ حيّاً","فأصبحَ ميتَ الأطلالِ بالي",135,"ل",2,0],["وَكَمْ صارِمٍ فِيهِمْ أَطالَ سُجُودَهُ","فأَدَّى فُرُوضاً لا يُؤَدَّى لَها طُهْرا",136,"ر",2,0],["[ وَكَمْ صَعْقَةٍ مِنْ أَجْلِها قالَ صاحِبِي","فَمُوسَى كَمُوسَى الآنَ فِي صَعَقاتِهِ ]",137,"ت",2,0],["وَكمْ صُبحٍ أتىٰ بالحُبِ يزهوْ","تنفَّسَ .. بعدَ ليلٍ ظل وقتَا",138,"ت",2,0],["وكم صدت من الاجناد اعداء","وكم بادت شعوب في زواياها",139,"ا",3,0],["وكم صدت من الاجناد اعداء","وكم بات شعوب في زواياها",140,"ا",3,0],["وكم صبٍّ .. أتاهُ بصدقِ عشقٍ","وردَّدَ حبَّهُ .. وعصى اللواحي",141,"ح",2,0],["وكم صديق من بعيد الارض جاني","لو بغيت اوفيه حقه ماوفيته",142,"ت",2,0],["وَكَمْ صَبَرْتُ على هَوْجَاءَ مُقْبِلَةٍ","رجوايَ تُدْبِرُ، ما خَيَّبْتَ مَنْ نَفَرَا",143,"ر",2,0],["وكم صحبت لدن العوالي يمينه","فللتِّيه والإعجاب هنَّ عواسل",144,"ل",1,0],["وكَمْ صَدَّ سَيْلاً ثَبَاتُ الصُخُورِ","وما جرف السَّيْلُ غَيْرَ الغُثَاءِ",145,"ا",1,0],["وَ كَمْ صَوّبَتْ سَهْماً إلى القَلْبِ نافذاً","فطالتْ عنيداً خاليَ الذِّهْنِِ قاسيا",146,"ي",2,0]]}