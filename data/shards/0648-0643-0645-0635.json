{"poems":[[55,"نعوه على ضن قلبي به","https://www.aldiwan.net/poem29746.html","المتقارب"],[55,"وكم صاحب كالرمح زاغت كعوبه","https://www.aldiwan.net/poem29801.html","الطويل"],[55,"برقت بالوعد في دجى أملي","https://www.aldiwan.net/poem29937.html","المنسرح"],[55,"أراك ستحدث للقلب وجدا","https://www.aldiwan.net/poem30614.html","المتقارب"],[55,"عذيري من العشرين يغمزن صعدتي","https://www.aldiwan.net/poem30678.html","الطويل"],[55,"جزاء أمير المؤمنين ثنائي","https://www.aldiwan.net/poem30783.html","الطويل"],[79,"أشارت غداة البين من خلل السجف","https://www.aldiwan.net/poem35976.html","الطويل"],[85,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[74,"ديار شعري سقاك السعد ماطره","https://www.aldiwan.net/poem18709.html","البسيط"],[53,"جفتني أن صددت ولي لديها","https://www.aldiwan.net/poem64587.html","الوافر"],[53,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[53,"ظهور الأمور خلاف البطون","https://www.aldiwan.net/poem66401.html","المتقارب"],[53,"ما الشكر مني لما أوليتني ثمنا","https://www.aldiwan.net/poem66514.html","البسيط"],[87,"سلام من صبا بردى أرق","https://www.aldiwan.net/poem24321.html","عموديه"],[87,"لقد لبى زعيمكم النداء","https://www.aldiwan.net/poem62929.html","الوافر"],[45,"يا أخت خير أخ يا بنت خير أب","https://www.aldiwan.net/poem9460.html","البسيط"],[30,"وكائن أبى من خطة الديم واشترى","https://www.aldiwan.net/poem5423.html","الطويل"],[63,"ملامك في الهوى أذكى غليلي","https://www.aldiwan.net/poem51484.html","الوافر"],[51,"نريد بقاء والخطوب تكيد","https://www.aldiwan.net/poem61203.html","الكامل"],[68,"إذا علم العدا عنك انتقالي","https://www.aldiwan.net/poem40101.html","الوافر"],[99,"تعال نزف للثغرِ السلاما","https://www.aldiwan.net/poem24357.html","الوافر"],[48,"أخوك معذب يا أم دفر","https://www.aldiwan.net/poem23560.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85365","المجتث"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54197","الطويل"],[111,"قد اهتزت الأكوان وارتعد الملا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66832&r=&rc=11",""],[113,"إذا ما زرت أكناف المرام","https://www.aldiwan.net/poem16459.html","الوافر"],[154,"ألا ليت شعري هل أسيرن منجدا","https://www.aldiwan.net/poem68594.html","الطويل"],[173,"أرتها المآقي ما تكن الجوانح","https://www.aldiwan.net/poem1611.html",""],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[203,"تغيرت الدنيا فهل هي زور","https://www.aldiwan.net/poem45156.html","الطويل"],[216,"أبا خالد ظني لتحفظ غيبتي","https://www.aldiwan.net/poem37912.html","الطويل"],[233,"غيري رمين ذوات الأعين النجل","https://www.aldiwan.net/poem50856.html","البسيط"],[245,"قدوم ولكن لا أقول سعيد","https://www.aldiwan.net/poem45771.html","الطويل"],[245,"وملك وإن طال المدى سيبيد","https://www.aldiwan.net/poem45773.html","الطويل"],[274,"بكيت لباك واشتكيت لشاك","https://www.aldiwan.net/poem35624.html","الطويل"],[274,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[286,"فيك عذولي عذرا","https://www.aldiwan.net/poem32763.html","مجزوء الرجز"],[308,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[308,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[352,"وكم صاح في الأبطال هل من مبارز","https://www.aldiwan.net/poem20754.html","الطويل"],[365,"اذا لاح ذاك الوجه وابتسم الثغر","https://www.aldiwan.net/poem68110.html","الطويل"],[368,"أضم على قلبي يدي من الوجد","https://www.aldiwan.net/poem60941.html","الطويل"],[368,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[420,"رآها قد أضر بها الكلال","https://www.aldiwan.net/poem54006.html","الوافر"],[420,"رمينا بأدهى المعضلات النوائب","https://www.aldiwan.net/poem54172.html","الطويل"],[436,"أقبل بوجهك إني عنك منصرف","https://www.aldiwan.net/poem12318.html","البسيط"],[436,"تلين لعزمي بالعراء العوائك","https://www.aldiwan.net/poem12691.html","الطويل"],[443,"أخو ظمأ يمص حشاه سبع","https://www.aldiwan.net/poem34835.html","الوافر"],[443,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[456,"دعوني من الدنيا من الأرض والسما","https://www.aldiwan.net/poem61581.html","الطويل"],[461,"أَصاب أو أخطأني راميا","https://www.aldiwan.net/poem55810.html","السريع"],[461,"أعلل فيكِ ببرد النسيمِ","https://www.aldiwan.net/poem55876.html","المتقارب"],[461,"أمن كل حظ قل قسمي أقله","https://www.aldiwan.net/poem56071.html","الطويل"],[464,"أظلما ورمحي ناصري وحسامي","https://www.aldiwan.net/poem15100.html","الطويل"],[464,"لئن ذاد مدحي بأس عذر فانني","https://www.aldiwan.net/poem15485.html","الطويل"],[464,"تناط أيادي الله منه وعنده","https://www.aldiwan.net/poem15663.html","الطويل"],[467,"نعم هذه آثارهم والمنازل","https://www.aldiwan.net/poem3164.html","عموديه"],[467,"أقل عنائي أنني فيه هائم","https://www.aldiwan.net/poem3633.html","عموديه"],[480,"هي الدار قد أقوت ورث جديدها","https://www.aldiwan.net/poem15191.html","الطويل"],[485,"بكعبة أنوار أنخت مطيتي","https://www.aldiwan.net/poem24323.html","عموديه"],[496,"كم منة للظلام في عنقي","https://www.aldiwan.net/poem67351.html","المنسرح"],[509,"صبرت على غدر الزمان وحقده","https://www.aldiwan.net/poem2440.html","الطويل"],[517,"خطبت المجد بالأسل العوالي","https://www.aldiwan.net/poem20820.html","الوافر"],[554,"يجد بنا صرف الزمان ونهزل","https://www.aldiwan.net/poem47337.html","الطويل"],[554,"أفي كل يوم لي حميم أفارقه","https://www.aldiwan.net/poem47369.html","الطويل"],[554,"نظرت إليها والرقائب حولها","https://www.aldiwan.net/poem48049.html","الطويل"],[565,"تقلص ظل للشباب وريف","https://www.aldiwan.net/poem52757.html","الطويل"],[578,"فارقت من كنت له مالكاً","https://www.aldiwan.net/poem2700.html","السريع"]],"verses":[["وَكَم صاحِبٍ كَمَناطِ الفُؤادِ","عَنانِيَ مِن يَومِهِ ما عَناني",0,"ن",2,0],["وَكَم صاحِبٍ كَالرُمحِ زاغَت كُعوبُهُ","أَبى بَعدَ طولِ الغَمزِ أَن يَتَقَوَّما",1,"م",2,1],["وَكَم صَريخٍ نَهَضتَ تَنصُرُهُ","وَالطَعنُ يَستَرعِفُ القَنا عَلَقا",2,"ق",2,0],["وَكَم صافَ مِن دارِهِم سَيِّدٌ","وَقاظَ يُعالِجُ في الجيدِ قِدّا",3,"د",2,0],["وَكَم صاحَتِ الأَيّامُ خَلفي بِرَوعَةٍ","فَصِرتُ بِعَينِ الجازِعِ المُتَلَفِّتِ",4,"ت",1,0],["وَكَم صارِخٍ ناداكَ لَمّا تَلَبَّبَت","بِهِ السُمرُ في يَومٍ بِغَيرِ ذُكاءِ",5,"ا",2,0],["وَكَم صَدرِ مَوتورٍ تَطَلَّعَ غَيظُهُ","وَقَلَّبَ قَولاً عَن لِسانِ مِراءِ",5,"ا",2,0],["وكمْ صَرَفَ التّأميلَ نحوَكَ آمِلٌ","فصيّرْتَهُ بالعدْلِ ممْتَنِعَ الصَّرْفِ",6,"ف",1,0],["وكم صارم قد سُلَّ من لحظِ أَحوَرٍ","وكَمْ ذابلٍ قد هُزَّ من ناعمِ القَدِّ",7,"د",1,0],["وكم صنائع معروفٍ تقول ألا","ما كانَ أربحَ في الصنفين تاجره",8,"ر",2,0],["وكم صدَّتْ وإن لم أجنِ ذنباً","وأعقبَ صدَّها قَطْبٌ وعبْس",9,"س",1,0],["وكم صالَ بالأملاكِ وسْطَ جنودِها","وأخنى على أهلِ النُّبوّاتِ والحِكمْ",10,"م",1,0],["وكم صاحبٍ غرَّني حبله","فأعصمتُ منه بغيرِ الأَمُون",11,"ن",1,0],["وكم صرفتَ حميدَ الفعل عن ظُلَمي","صرفَ الزمان ذميم الفعلِ مُدَّهنا",12,"ن",2,0],["وَكَمْ صَيَدٍ بَدا لَكَ مِن ذَليلٍ","كَما مالَتْ مِنَ المَصلوبِ عُنقُ",13,"ق",1,0],["وَكَم صَحَّ الوِدادُ فَكانَ صِهراً","وَكانَ كَأَقرَبِ القُربى صَفاءَ",14,"ا",2,0],["وَكَم صَحِبتَ أَخاها في مُنازَلَةٍ","وَكَم سَأَلتَ فَلَم يَبخَل وَلَم تَخِبِ",15,"ب",1,0],["وَكَم صَعَّدَت كَفّاكَ مِن فَرعِ سورَةٍ","عَلَت فَوقَ أَيدٍ لا تُنالُ طِوالُها",16,"ل",3,0],["وكم صاحَبْتُ من أملٍ مُحالٍ","فأوقَفَني على طَلَلٍ مُحيلِ",17,"ل",1,0],["وَكَم صارَ تَحتَ الأَرضِ مِن خامِدٍ بِها","وَقَد كانَ يَبني فَوقَها وَيَشيدُ",18,"د",1,0],["وَكَم صَبٍّ تَفاءَلَ في حَبيبٍ","وَفى لي إِنَّ حِبّي ما وَفى لي",19,"ل",2,0],["وكم صخرٍ أحسَّ بما عنانا","وما عَرَفَ الحديثَ ولا الكلاما",20,"م",2,0],["وَكَم صالَت عَلى بَرٍّ تَقِيٍّ","أَكُفٌّ بِالمَواهِبِ أَرفَقَتهُ",21,"ت",2,0],["وَكَم صحبت خَليلاً","فَكانَ غير خَليل",22,"ل",1,0],["وكَمْ صانَ مصراً من بنيه مملكٌ","بعيد منال العزمِ جَمّ المطَالبِ",23,"ب",1,0],["وكم صادمته من لياليه نكبة","ففكك اغلال وكشف معضلا",24,"ل",2,0],["وَكَم صادَفت مِن ظَبي كَحيل","وَكَم شاهَدتُ مِن بَدرٍ تَمام",25,"م",1,0],["وَكَم صابَ مِنهُ في الشَدائِد مُنُجِداً","سَحابٌ يُفيدُ الخَلقَ رَيّا بِلا صَدىً",26,"د",2,0],["وَكَم صاحِبٍ وارَيتُ في الكَشحِ وُدَّهُ","تَبَيَّنَ لي مِنهُ عَدُوٌّ مُكاشِحُ",27,"ح",1,0],["وَكَم صالحٍ فيكُم ولكنَّ فِتنةً","بِها كَثُرَ الأخباثُ عمّمتِ الشرّا",28,"ر",2,0],["وكم صبّ فيهِ للمدامع جدول","وكم هبّ فيهِ للقلوب زفيرُ",29,"ر",1,0],["وَكَمْ صاحبٍ جاورتُهُ وصَحبتُهُ","ولما افْتَرقْنا ظَلَّ يَطْلُبُ صُحْبَتي",30,"ي",1,0],["وكم صبوتُ إلى وَرْدِ الخدود ولم","أَرْضِ العذولَ الذِي قد لجّ في العَذَل",31,"ل",1,0],["وكم صارَ شملٌ للعبادِ مُشَتَّتا","فنظَّمهُ فخرُ الملوكِ سَعِيدُ",32,"د",1,0],["وكم صارَ شملٌ للبلادِ مشتتا","وخربَ قصرٌ في البلادِ مشيدُ",33,"د",1,0],["وكم صحتُ مثلَ الدّيكِ أُوقِظُ أُمتي","وأُطلعُ نورَ الشمسِ فوقَ رُباك",34,"ك",1,0],["وكم صروحٍ وأَبراجٍ ممرّدةٍ","زدنا بها الملكَ توطيداً وتأمينا",35,"ن",2,0],["وَكَم صَباحٍ مُسفِرٍ","مِن ثَغرِهِ إِذ سَفَرا",36,"ر",2,0],["وكم صابر كم صادق متبتل","إلى اللَه عن قصد صحيح وعزمة",37,"ه",1,0],["وكم صرع القربان قبلك فتنة","وأمضى معاصى اللّه كبرة سلطان",38,"ن",1,0],["وَكَمْ صَاحَ في الأَبطالِ هَلْ مِن مُبارِزٍ","فَأخرسَ كُلٌّ عن إجبابتهِ أَنَا",39,"ن",2,1],["وَكَم صُمت عَن لَذّات دَهري عِفّة","عَلى أَنَّه كَم لي عَلى ريقه فطر",40,"ر",1,0],["وكم صاحبٍ لمّا عدا الدّهُر طَوْرَهُ","تَناوَم عن نَصْري وقد جْئتُ أستَعْدي",41,"د",2,0],["وكم صاحبٍ داريْتُ أمزجُ جَهْله","بحِلْمِي أزماناً فلم يتَمَزَّج",42,"ج",1,0],["وكم صانَتْ أَكِلَّتها وُجواً","عَليها مهجتي أبداً تذال",43,"ل",1,0],["وكم صاغ من تبر القريض جمانة","وأفرغ معناها بأحسن قالب",44,"ب",1,0],["وكم صَبَرْتُ وقلتُ الحُرُّ يُرْجِعُهُ","لِينُ الكلامِ وإِنْ وَلَّى بِهِ الأَنَفُ",45,"ف",1,0],["وكم صد عني موثَق الخدّ مونق","فما سدّ عني باتر الحد باتك",46,"ك",1,0],["وكمْ صَحِبُوا نُجُومَ اللَّيْلِ حَتَّى","جَلاها فِي عُيُونِهِمُ الضَّحَاءُ",47,"ا",2,0],["وكم صَدَعْتُ فؤادَ اللَّيلِ عن قَمرٍ","لَهُ هَوىً فِي صميمِ القلبِ صادِعُهُ",48,"ع",2,0],["وكم صيروا الإيمان والكفر لعبة","وكم حللوا ما كان قبلا محرما",49,"م",2,0],["وكم صديق عزَّ داريتُه","لو رُزِقَ الإنصافَ دارانيا",50,"ي",2,0],["وكم صاحبٍ كنتُ بالقُرب منه","أجلَّ محلِّ النبيهِ العظيمِ",51,"م",1,0],["وكم صاحبٍ منهم غروراً عقدتُه","بنفسي وكفُّ الغدر عني تحُلُّهُ",52,"ل",2,0],["وكم صَوْن جسم بعد موت أذلَّه","كما ذلَّ بالتَّصْبير جسمُ هِشام",53,"م",1,0],["وكم صامت عن واجبٍ وهو ناطقٌ","وآخر ذو صمتٍ واِنْ راحَ ينطقُ",54,"ق",1,0],["وكم صَعبةٍ من لزْبةٍ وحوادثٍ","تجلَّتْ بأيامِ الوزيرِ النَّواضِرِ",55,"ر",1,0],["وكم صبحت لدن الوالي يمينه","فللتيه والإعجاب هن عواسل",56,"ل",1,0],["وكم صاحب أوليته الشكر مقبلاً","فأدبر يثني عطفه وهو شاتم",57,"م",1,0],["وكم صنتُها خوفَ الرقيبِ وسعيهِ","وكفكفتُها مِن قبلُ تَتْرَى مدودُها",58,"د",3,0],["وكم صار ملذوذا عذاب عذابها","وكم فاوضتنا القارعات بسطوتي",59,"ت",2,0],["وَكَم صَباحٍ لِلرّاحِ أَسلَمَني","مِن فَلَقٍ ساطِعٍ إِلى فَلَقِ",60,"ق",1,0],["وكم صَاحِبٍ عَاشَرتُه وألفتُه","فما دَام لي يوماً على حُسنِ عهده",61,"د",2,0],["وكم صبّحْتَ بالغاراتِ حيّاً","فأصبح ميّتَ الأطلالِ بالي",62,"ل",2,0],["وَكم صاحِبٍ لِي كنتُ أكره فقدَهُ","تسلّمه منّي الفَناءُ المعجّلُ",63,"ل",1,0],["وكم صاحبٍ عُلِّقْتُهُ فتقطّعَتْ","بأيدي المنايا من يديَّ علائقُهْ",64,"ق",2,0],["وكم صَدّ مِقْداماً وثَبّط ماضياً","على عزمِهِ جهلٌ بما في العواقِبِ",65,"ب",1,0],["وكمْ صُدِعَتْ للفاتكينَ مَفارِقٌ","وكم أُرغِمتْ للمالكينَ أُنوفُ",66,"ف",1,0],["وكم صديقٍ ليَ في دَمْعِه","لمَّا رأَى الحاسِد في ضحْكه",67,"ك",2,0]]}