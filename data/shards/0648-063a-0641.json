{"poems":[[39,"قف بالديار وقوف زائر","https://www.aldiwan.net/poem7174.html","مجزوء الكامل"],[74,"كفوا حديث العذل عن مسمعي","https://www.aldiwan.net/poem19170.html","السريع"],[72,"أعلمتم أن النسيم إذا سرى","https://www.aldiwan.net/poem42922.html","السريع"],[68,"كيف الضلال وصبح وجهك مشرق","https://www.aldiwan.net/poem41374.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39562","الخفيف"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/142340","الكامل"],[173,"انزل لتلثم ذا الصعيد مقبلاً","https://www.aldiwan.net/poem1658.html",""],[240,"ولقد مدحتك يا ابن نصر مدحة","https://www.aldiwan.net/poem31771.html","الكامل"],[255,"أغنيتني من بعد فقري","https://www.aldiwan.net/poem14976.html","مجزوء الكامل"],[385,"يا مكثرا من ذم كل ذميم","https://www.aldiwan.net/poem48760.html","الخفيف"],[463,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[463,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[556,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[556,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[556,"أترى يؤوب زماننا","https://www.aldiwan.net/poem47734.html","مجزوء الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53904","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48540","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145963","الكامل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203792","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133791","المجتث"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64898","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79852","الخفيف"],[1560,"","https://poetry.dctabudhabi.ae/diwan/poem/130734","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77912","المتدارك"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102050","الوافر"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104796","الرمل"],[2606,"","https://poetry.dctabudhabi.ae/diwan/poem/198979","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216795",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136085","الرجز"],[3884,"","https://poetry.dctabudhabi.ae/diwan/poem/142877","الطويل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29326","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133197",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139470",""],[4859,"ملام العذل","https://www.poetsgate.com/ViewPoem.aspx?id=186848",""],[585,"يا صاحب التاج ما للقوم في وصب","https://www.poetsgate.com/ViewPoem.aspx?id=161843",""],[5111,"قمَرانِ","https://www.poetsgate.com/ViewPoem.aspx?id=212125",""],[5111,"القَلمُ المُرَابِطُ","https://www.poetsgate.com/ViewPoem.aspx?id=212648",""],[5121,"سَكْرَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=213505",""],[5121,"مسح الظّلام","https://www.poetsgate.com/ViewPoem.aspx?id=213686",""],[5397,"ما لهذا الدهر في الغي تمادى","https://www.poetsgate.com/ViewPoem.aspx?id=157914",""],[5561,"طيفًا يزورُكَ ...","https://www.poetsgate.com/ViewPoem.aspx?id=203216",""],[5897,"غداً القصاص","https://www.poetsgate.com/ViewPoem.aspx?id=160569",""],[6152,"لاتسأليني","https://www.poetsgate.com/ViewPoem.aspx?id=203096",""],[6152,"وفقنا يا رب","https://www.poetsgate.com/ViewPoem.aspx?id=213155",""],[6225,"اعياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78099&r=&rc=156",""],[5567,"عناق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82100&r=&rc=141",""],[5396,"المسافر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65510&r=&rc=9",""]],"verses":[["وغفرتم لذوي الذنو","ب من الأكابر والأصاغر",0,"ر",1,0],["وغفلة الواشين عن وصلنا","ونحنُ كالواجد في مضجع",1,"ع",1,0],["وَغَفَرتُ ذَنبَ الدَهرِ يَومَ لِقائِهِ","وَشَكَرتُهُ وَيَحِقُّ لي أَن أَشكُرا",2,"ر",2,0],["وَغَفَرتُ ذَنبَ الدَهرِ حينَ بَدَت بِهِ","مِن طَلعَةِ السُلطانِ شَمسٌ تُشرِقُ",3,"ق",1,0],["وغَفَتْ أعينٌ بكتكم بدمعٍ","لم تدَعْ منه ما يُراق ويُسكبْ",4,"ب",1,0],["وغفت بأحضان السكون وفوقها","جثث الدجا منثورة الأشلاء",5,"ا",2,0],["وَغَفَرتُ زَلَّةَ ظالِمَيَّ لِكَونِها","سَبَبَ اللِقاءِ وقلتُ أَيسَرُ مَحمَلا",6,"ل",2,0],["وَغَفَلتَ عَنها مُعرِضاً وَوَراءَها","مِنّي حَمِيَّةُ والِدٍ لا يَغفُلُ",7,"ل",1,0],["وغفرتُ لما أن وصل","تُ إلى جَنابك ذَنبَ دهري",8,"ر",2,0],["وَغَفِلتِ عَن شُكر المَفيض العَقل مِن","بَعد الحَياة المُنعم القَيوم",9,"م",1,0],["وغفلتَ لم تسأل ولستَ بغافلٍ","أنَّى تنكَّب بابَك الزُّوَّارُ",10,"ر",1,0],["وغفلةٌ تُحرِق في","وجهِ الجمالِ القُبحا",11,"ح",2,0],["وغفرانٌ عن الإجرا","مِ إِنْ كانتْ ورضوانُ",12,"ن",1,0],["وغفلتُ عنها والرّزايا زُوَّرٌ","ساحاتِ أيقاظٍ ورَبْعَ نيامِ",13,"م",1,0],["وغفرتُ من جُرمِ الزّما","نِ لأجله ما قد مضى",14,"ض",2,0],["وغَفَلْتَ عن عهد التأنُّسِ دائماً","حتّى لدى الإِصباح والإِمساءِ",15,"ا",2,0],["وغفلوا عن أسد","مستيقظ مقترب",16,"ب",1,0],["وغفا الصَحَابةُ فوقَ رملِ بهائِهِ","أنعمْ بهِ شرَفاً يَعِزّ مَنالهُ",17,"ل",2,0],["وغفونا عن الزمان، فأغرى","كل باغٍ وطامع في قياد",18,"د",1,0],["وغفوة تحت ظل","من وشوشات وهمس",19,"س",1,0],["وغَفَتْ عُيونُ وشاتِنا سِلْماً وكمْ","قامَتْ لحَرْبِ عَناقِنا مِنْ ساقِ",20,"ق",1,0],["وغفرنا ذنبَ الزمان وقلنا","قد أقلناكَ يا زمان العثارا",21,"ر",2,0],["وغفّر للرحمان في الأرض وجهه","فئاب بفتح للطواغيت مرغم",22,"م",1,0],["وَغفلت وربك مطلع","حجبتك مضلات الفتن",23,"ن",1,0],["وغفران الخطا فضلاً فاني","بوزري حالتي في ذي امتهان",24,"ن",1,0],["وَغفِرن لِى عَثرَتِى يا سَيِّدى","لَم تَزَل مُستَعطِفاً بالفُقَرَا",25,"ر",2,0],["وغفلت في زمن الشباب المنقضي","أقبح بنسخ بروره بعقوقه",26,"ق",2,0],["وغفت أطيارها فه","ي نشاوى حالمات",27,"ت",1,0],["وغفلَتي من فوق ذكرها المرامْ","وناقصي من فوق ما لها تمامْ",28,"م",1,0],["وغَفراً لنا بعد المماتِ إذا فجا","وأودت بآمال الحياةِ منونُ",29,"ن",1,0],["وَغَفا الهُدهُدُ المُصَلّي وَآوى","جُندُبُ الرَوضِ في ذُرا الأَحجارِ",30,"ر",1,0],["وغفراناً لما قد كان منا","من إلمام الصغائر والكبائر",31,"ر",1,0],["وغفوراً مدَّت لمغفرةٍ من","ه يديها عبيدهُ والإماء",32,"ا",2,0],["وغفت عيونُ الشوقِ في حضنِ الأسى","وصحا الحنينُ على ملامِ العذّلِ",33,"ل",1,0],["وغفلة الدهر إن طالت فإن لها","في غرة وثبة بالويل والحرب",34,"ب",1,0],["وَغَفَتْ تُنَاجِي البَدْرَ فِيْ تَرْتِيلِهِ","كَنَدَىً يَشِعُّ بِوَرْدِهِ فَتَََرصَّعَا",35,"ع",2,0],["وَغَفَوْتُ أنْشِدُ بَهْجَةً مِنْ نُورِهِمْ","بَيْنَ المَقَاعِدِ يُمْنَةً وَشِمَالاَ",36,"ل",2,0],["وَغَفَى عِنْدِي حَبِيسَاً","بَيْنَ لَيْلَاتِي وَصَبْرِي",37,"ر",2,0],["وَغَفَى عَلَى تِلْكَ الثُّرَيَّا نَاعِساً","فَتَلَحَّفَتْ بِجُفُونِهِ النَّجْمَاتُ",38,"ت",1,0],["وغفت هاجعة أجفانهم","ولهم ظهر الثرى لان مهادا",39,"د",2,0],["وغفَتْ حضارةُ أمَّةٍ وتمزَّقَتْ","أوصالَها وطغى المُروءَةَ ماءُ",40,"ا",2,0],["وغفلت عن سنن مضت فيمن مضى","لما تناسى خلقه الصلصالُ",41,"ل",1,0],["وغفرت ذنبكِ واستبقتكُ تائبا","وسألتُ ربي أن يكون معينا",42,"ن",2,0],["وغفرانا لمن سبقوا؛ وفوزا","لمن صاموا وقاموا طائعينا",43,"ن",2,0],["وغفوتُ , انتهى الصفاءُ إلى العر","شِ , وفاض التشوُّقُ المكبوتُ !!",44,"ت",1,0],["وغفا على أحلامنا من سحره","ورد تمايل حولنا أعناقا",45,"ق",2,0],["وغفا الإنسان إلاّ شمعة","زادها الفجر اشتعالا في اشتعال",46,"ل",1,0]]}