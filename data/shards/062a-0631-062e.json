{"poems":[[53,"نخطو وما خطونا إلا إلى الأجل","https://www.aldiwan.net/poem29884.html","البسيط"],[85,"انظر إلى الأقمار كيف تزول","https://www.aldiwan.net/poem62837.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[185,"يا باسط العدل في بدو وفي حضر","https://www.aldiwan.net/poem14537.html","البسيط"],[282,"ذكر الصبا منه لي هاجت صبابات","https://www.aldiwan.net/poem32859.html","البسيط"],[477,"خل المطي تخدي","https://www.aldiwan.net/poem15190.html","مجزوء الرجز"]],"verses":[["تُرخي النَوائِبُ مِن أَعمارِنا طَرَفاً","فَنَستَعِزُّ وَقَد أَمسَكنَ بِالطِوَلِ",0,"ل",1,0],["تَرخونَ لِلريحِ العِنانَ وَإِنَّها","لَكُم عَلى طُغيانِها لَذَلولُ",1,"ل",1,0],["ترْخِيمُهَا في لَحْنَهِ مُتَسَامَحٌ","وَنَعِيمُهَا في وَشْيِهِ مُتَرَاءِ",2,"ا",2,0],["تُرْخِي أومرُاك العليا عزائمه","فلا تمرّ بمَلْكٍ غيرِ منعِفرِ",3,"ر",1,0],["تَرخيمُهُ ضِدّ تَرخيم النِداءِ فَفي","هاذاكَ نَقصٌ وَفي هَذا زِيازاتُ",4,"ت",1,0],["تُرخي عزاليها على","هُضْبِ الحِمى والوهدِ",5,"د",1,0]]}