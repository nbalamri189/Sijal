{"poems":[[55,"نخطو وما خطونا إلا إلى الأجل","https://www.aldiwan.net/poem29884.html","البسيط"],[87,"انظر إلى الأقمار كيف تزول","https://www.aldiwan.net/poem62837.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[189,"يا باسط العدل في بدو وفي حضر","https://www.aldiwan.net/poem14537.html","البسيط"],[287,"ذكر الصبا منه لي هاجت صبابات","https://www.aldiwan.net/poem32859.html","البسيط"],[482,"خل المطي تخدي","https://www.aldiwan.net/poem15190.html","مجزوء الرجز"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122340","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100962","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53142","الطويل"],[2284,"","https://poetry.dctabudhabi.ae/diwan/poem/143060","الكامل"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131725",""],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65960","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65940","الرجز"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114457","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73129","الكامل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146765","المنسرح"],[4750,"لمزاين","https://www.poetsgate.com/ViewPoem.aspx?id=180416",""],[1012,"سعد الزمان وأسعد المقدارُ","https://www.poetsgate.com/ViewPoem.aspx?id=124958",""],[5038,"دعي قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=189377",""],[5106,"يَا مِسْكَةَ العَرَبِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=154846",""],[5213,"أرح قلوصك من كد ومن تعب","https://www.poetsgate.com/ViewPoem.aspx?id=170412",""],[5246,"يا من يؤمل أن ينال ويرتجي","https://www.poetsgate.com/ViewPoem.aspx?id=187068",""],[5573,"وين اصبحت ياهارب","https://www.poetsgate.com/ViewPoem.aspx?id=200310",""],[402,"عجبا أتوحشني وأنت إزائي","https://www.poetsgate.com/ViewPoem.aspx?id=35059",""],[6093,"بان لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=176082",""]],"verses":[["تُرخي النَوائِبُ مِن أَعمارِنا طَرَفاً","فَنَستَعِزُّ وَقَد أَمسَكنَ بِالطِوَلِ",0,"ل",1,0],["تَرخونَ لِلريحِ العِنانَ وَإِنَّها","لَكُم عَلى طُغيانِها لَذَلولُ",1,"ل",1,0],["ترْخِيمُهَا في لَحْنَهِ مُتَسَامَحٌ","وَنَعِيمُهَا في وَشْيِهِ مُتَرَاءِ",2,"ا",2,0],["تُرْخِي أومرُاك العليا عزائمه","فلا تمرّ بمَلْكٍ غيرِ منعِفرِ",3,"ر",1,0],["تَرخيمُهُ ضِدّ تَرخيم النِداءِ فَفي","هاذاكَ نَقصٌ وَفي هَذا زِيازاتُ",4,"ت",1,0],["تُرخي عزاليها على","هُضْبِ الحِمى والوهدِ",5,"د",1,0],["ترخدّاً مثل اللجين تجلى","بعذار من انعكاس النبات",6,"ت",1,0],["تُرخي شعار المحرمين على سَنى","بدر تلألأ في رقيق سحاب",7,"ب",1,0],["ترخم صوتاً أعجميّاً ومقلتي","تترجم عنها حين تدمى وتدمع",8,"ع",1,0],["تُرخينَ فرعاً فوق صدريْ دافئاً","شعراته في لمْسهنّ رِقاقُ",9,"ق",1,0],["ترخام بجحر قاعف","من أكبر المصايب",10,"ب",1,1],["ترخي إِذا كشف المحبور مقنعها","عند العتاق قناع الغنج والخفر",11,"ر",1,0],["ترخي على الخدين لاستحيائها","ستراً من الخالات والعمات",12,"ت",1,0],["تَرخِيماً احذِف آخِرَ المُنَادَى","كَيَاسُعَا فِيمَن دَعَا سُعَاداً",13,"د",2,0],["تُرخي مشافِرَها دأبا مذللةً","كأنها مثمرٌ من العراجين",14,"ن",1,0],["تُرخي ذوائبَها إِذا خطرت ضحىً","فترَى الصبَّاح يجرُّ ذيلَ الَموهنِ",15,"ن",1,0],["ترخي عليه العنان في عنقٍ","حتى إذا ما التوى تجاذبه",16,"ب",2,0],["ترخي سيوف لحيها والجرانيين","اللي بعدها تحسب الحوض مسدود",17,"د",1,0],["ترخي أعنتها الكماة ووطئها","فرح بنقع فوقهن مثارُ",18,"ر",1,0],["ترخّمَ في النّفوسِ وناغَ سَكْرا","وذوالْألْبابِ قدْ فقدوا الصّوابا",19,"ب",2,0],["تُرْخِيْ الْجَمِيْلَ عَلَىْ الدُّنْيَاْ ودَاْعَتُهُ","فَالنَّحْلُ تَتْبَعُهُ وَالنَّجْمُ ذُوْ الذَّنَبِ",20,"ب",1,0],["ترخي افاعي سوداً من جدائلها","ما قاومتها صلال الرمل باللسب",21,"ب",1,0],["ترخي الهموم به تعذب نفسه","فتقض مضجعها وتربك درسها",22,"ه",2,0],["ترخي قناعتك لآخر حد وتنيب","صبرك ليا صار مالك شف ومجارب",23,"ب",1,0],["ترخيمها في لحنه متسامع","ونعيمها في وشيه متراء",24,"ا",2,0],["ترخي لثاماً على بدر تُحَجِّبُه","وهل لبدرٍ بليلِ التمِّ نُكْرَانُ",25,"ن",1,0]]}