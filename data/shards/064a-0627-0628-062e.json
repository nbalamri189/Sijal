{"poems":[[74,"إن طيفا عن حال شجواي أملى","https://www.aldiwan.net/poem20543.html","الخفيف"],[54,"يا بخيلا ليس يدري ما الكرم","https://www.aldiwan.net/poem26687.html","الرمل"],[333,"يا بخيلا وكل نظرة عين","https://www.aldiwan.net/poem55026.html","الخفيف"],[385,"يا بخيل المقلتين","https://www.aldiwan.net/poem48795.html","مجزوء الرمل"],[396,"ذه عرشه مامثلها عرشه","https://www.aldiwan.net/poem54470.html","عموديه"],[396,"لأنها اوزار فيها الضرر والأضرار","https://www.aldiwan.net/poem54523.html","عموديه"],[396,"وصيتي يا علي","https://www.aldiwan.net/poem54589.html","عموديه"],[438,"قل لفخر الأئمة العلم العا","https://www.aldiwan.net/poem12363.html","الخفيف"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101541","الكامل"],[794,"","https://poetry.dctabudhabi.ae/diwan/poem/101211","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38242","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123293","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123187","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123280","المواليا"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123272","المواليا"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53056","الخفيف"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129990","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75993","الخفيف"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126257","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101352","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73136","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136606",""],[4963,"المهره اللي يتل القلب طاريها!!!","https://www.poetsgate.com/ViewPoem.aspx?id=34635",""],[5690,"رأى نظري ربوعهم فما لا","https://www.poetsgate.com/ViewPoem.aspx?id=172171",""],[5848,"اسولف لغيرها دايم","https://www.poetsgate.com/ViewPoem.aspx?id=48972",""],[5848,"كأنها الفرقى طلبتك حاجتين","https://www.poetsgate.com/ViewPoem.aspx?id=48893",""],[5956,"لله أكتب أشعاري","https://www.poetsgate.com/ViewPoem.aspx?id=192029",""],[5956,"سابقاني نحو السما","https://www.poetsgate.com/ViewPoem.aspx?id=192101",""],[5956,"يا بختَ من قد مات","https://www.poetsgate.com/ViewPoem.aspx?id=192137",""],[5956,"شكراً على الاستدفاء بنيرانكم","https://www.poetsgate.com/ViewPoem.aspx?id=192365",""],[5956,"سابقونا نحو السما","https://www.poetsgate.com/ViewPoem.aspx?id=193893",""],[5956,"من أين تأتي الطيبة العصماءُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=206925",""]],"verses":[["يا بخيلاً بلفظه ولقاه","شذَّ ما قد بخلت قولاً وفعلا",0,"ل",2,0],["يا بَخيلاً لَيسَ يَدري ما الكَرَم","حَرَّمَ اللُؤمُ عَلى فيهِ نَعَم",1,"م",1,1],["يا بخيلاً وكلّ نظرة عين","منه كنزٌ للشاعر المُفتَنّ",2,"ن",1,1],["يا بَخيل المُقلَتَينِ","هاكَ ما تسفح عَيني",3,"ن",2,1],["يابخته من آنسه ربه","يافوزه من ذكره الرحمن",4,"ن",1,0],["يا بخت من مال","عنهم فاز بالآمال",5,"ل",1,0],["يابخت من حبهم","عليه أثرهم يعود",6,"د",1,0],["يا بخيلاً بعِرْضِهِ وجوادًا","بِنداهُ أَنت الجوادُ البخيلُ",7,"ل",1,0],["يا بخلُ مذ فارقتني احرمتني","غَرداً بهِ عيشي يدومُ رغيدا",8,"د",2,0],["يا بخيلاً لو رام مني روحي","لتفديه كنت فيها سخيا",9,"ي",2,0],["يا بُخلَ أَعيُننا إِنْ لَو بَكَتهُ دَماً","وَما أَسالَت عَلَيه جَوهرَ المقلِ",10,"ل",1,0],["يا بختها صبرت في ذاك واحتسبت","تظل ساكنة لا تشتكي أسفا",11,"ف",2,0],["يا بخت أمي بي الا يا سعدها","فازت بابن قد نما عقلولا",12,"ل",2,0],["يا بخته أكلوه","من عظم ما حبّوه",13,"ب",3,0],["يا بخت من لقيك","إن لم يكن صايم",14,"م",1,1],["يا بخيلاً يعد بعض أيادي","ه تهادي خياله الكذابِ",15,"ب",1,0],["يا بخيلاً بوصلهِ كيف بالغت","فما جدت لي بوصل الخيال",16,"ل",1,0],["يا بَخيلاً حَتّى بِرَجعِ سَلامٍ","زارَني مِن خَيالِكَ الصبح طَيفُ",17,"ف",1,1],["يابختنا بالنبى المحتار خير البشر","صلوا عليه اذا ماهب نسيم السحر",18,"ر",1,0],["يا بخيلاً بالوصل وهو كريم","لم يكن يمنح الأحبة صدا",19,"د",2,0],["يا بخيلاً عليَّ حتَّى بنومِ","مُطمِعِ منهُ في خيالِ طَروقِ",20,"ق",1,0],["يا بَخيلاً ولو بَطيفٍ يُزور","الحيَّ ليلاً وفيه يحيى قَتيلا",21,"ل",2,0],["يابخت منهو خذاها واهتنا فيها","ياكبر حظه ولابه في الحكي فودي",22,"د",2,0],["يا بخس قيمة قد بعتموه","ولا مالاً أخذتم أو نوالا",23,"ل",2,0],["يا بخلها هالسنين وقبل ! يا جودها","أيام هي سيّدة قلبي وانا سيدها",24,"د",3,0],["يا بخيلٍ فالوصال بنظرتين","ويا كريمٍ في طعونك والجروح",25,"ح",1,1],["يا بختَ كل الألى ماتوا وما شهدوا","هذا التدهورَ في شامٍ وفي يمَنِ",26,"ن",1,0],["يا بختَ مَن أودى قديماً قبلما","جعل الجنونُ الشام مثلَ جهنّما",27,"م",2,0],["يا بختَ من قد مات دون يشاهدُ","ما انتاب أوطاني وما يتصاعدُ",28,"د",1,1],["يا بخت من منكم بمنزلهِ انقبرْ","يا بخت من في نارِ بغيكمُ انتحرْ",29,"ر",1,0],["يا بختَ مَن أودى قديماً قبلما","جعل الجنونُ حِمى الشآم جهنّما",30,"م",2,0],["يا بختَ قلبي كم لديه ثروةٌ","في كل يوم صاحبٌ مِعطاءُ",31,"ا",2,0]]}