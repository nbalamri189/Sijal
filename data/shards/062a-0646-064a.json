{"poems":[[9,"ألا يا قتل قد خلق الجديد","https://www.aldiwan.net/poem21929.html","الوافر"],[75,"مرادهم حيث السلاح خمائل","https://www.aldiwan.net/poem11930.html","الطويل"],[37,"ألمم بعزة إن الركب منطلق","https://www.aldiwan.net/poem39127.html","البسيط"],[37,"تنيل قليلا في تناء وهجرة","https://www.aldiwan.net/poem39130.html","الطويل"],[95,"لذكراك يا حفني في النفس أشجان","https://www.aldiwan.net/poem11210.html","الطويل"],[32,"أخرقاء للبين استقلت حمولها","https://www.aldiwan.net/poem29537.html","الطويل"],[32,"يا أيها ذيا الصدى النبوح","https://www.aldiwan.net/poem29606.html","الرجز"],[90,"أ تونس أن في بغداد قوما","https://www.aldiwan.net/poem44988.html","الوافر"],[49,"إبنان أم شبلان ذان فإنني","https://www.aldiwan.net/poem25154.html","الكامل"],[53,"أبا الصقر حسب المادحيك إذا غلوا","https://www.aldiwan.net/poem64021.html","الطويل"],[53,"مواهب وهاب وقى بعضها بعضا","https://www.aldiwan.net/poem64942.html","الطويل"],[93,"راودني النوم وما برحا حتى طأطأت له راسي","https://www.aldiwan.net/poem8971.html","عموديه"],[64,"تنينا جائع له ذنب","https://www.aldiwan.net/poem52170.html","المنسرح"],[30,"ما نحن إن جارت صدور ركابنا","https://www.aldiwan.net/poem5609.html","الطويل"],[46,"يا ربع لو ربعوا على ابن هموم","https://www.aldiwan.net/poem30351.html","الكامل"],[83,"قبولك ريعان الشباب فلا ولى","https://www.aldiwan.net/poem61420.html","الطويل"],[52,"أفرخ الزنج طال بك البلاء","https://www.aldiwan.net/poem64886.html","الوافر"],[37,"ألممْ بعزَّة إنَّ الرَّكبَ منطلقُ","https://www.poetsgate.com/ViewPoem.aspx?id=22056",""],[164,"خذا بي نحو الصوت لا تتبعا الصدى","https://www.aldiwan.net/poem58787.html","الطويل"],[203,"دجا الظلام فيا ليلى أما فينا","https://www.aldiwan.net/poem45159.html","البسيط"],[234,"ولما تلاقينا ولم نخش كاشحا","https://www.aldiwan.net/poem51231.html","الطويل"],[255,"تنيت عناني عن مطاردة الهوى","https://www.aldiwan.net/poem15057.html","الطويل"],[275,"تعشقت ماء الروضة المترجرجا","https://www.aldiwan.net/poem35599.html","الطويل"],[368,"بالعفر دار من جميلة هيجت","https://www.aldiwan.net/poem1718.html","الطويل"],[371,"ولم أر قرنا تعجز الدهر حربه","https://www.aldiwan.net/poem17779.html","الطويل"],[398,"لقد رحلت سعدى فهل لك مسعد","https://www.aldiwan.net/poem53688.html","الطويل"],[422,"ألما على لومي وجدا مجددا","https://www.aldiwan.net/poem54134.html","الطويل"],[445,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[445,"أرحلي محمول على العتق النجب","https://www.aldiwan.net/poem34886.html","الطويل"],[466,"يا ساري الليل عواما بلجته","https://www.aldiwan.net/poem15437.html","البسيط"],[466,"تنيخ منه معمل المطي","https://www.aldiwan.net/poem16161.html","الرجز"],[520,"لئن قل صبر فالمصاب عظيم","https://www.aldiwan.net/poem12255.html","الطويل"],[556,"ألا يا قوم للقدر المتاح","https://www.aldiwan.net/poem47892.html","الوافر"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104004","الطويل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96579","الطويل"],[1341,"","https://poetry.dctabudhabi.ae/diwan/poem/124703","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50010","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128700","البسيط"],[1713,"","https://poetry.dctabudhabi.ae/diwan/poem/123322","البسيط"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132240","الوافر"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125403","المتقارب"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118344","الوافر"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60945","الطويل"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17732","الطويل"],[2554,"","https://poetry.dctabudhabi.ae/diwan/poem/198814","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103503","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100840","الطويل"],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142850","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48437","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126929","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216634","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35500","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125802","المتقارب"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101370","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101359","الوافر"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136899",""],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22077","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54370","المجتث"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/18983","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81695","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76728","البسيط"],[4689,"دوح المدائح","https://www.poetsgate.com/ViewPoem.aspx?id=152847",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4852,"طاووس خزف","https://www.poetsgate.com/ViewPoem.aspx?id=214455",""],[4927,"آسية الأسية","https://www.poetsgate.com/ViewPoem.aspx?id=29613",""],[4932,"سررتم فَإِنِّي بعدكم غير مسرور","https://www.poetsgate.com/ViewPoem.aspx?id=189366",""],[307,"لباس العفاف","https://www.poetsgate.com/ViewPoem.aspx?id=214108",""],[5956,"طيف الحبيبة الميّتة","https://www.poetsgate.com/ViewPoem.aspx?id=182160",""],[6031,"وحَالقٍ أَصْبَحَ في","https://www.poetsgate.com/ViewPoem.aspx?id=46360",""]],"verses":[["تَنيهِ وَقَد أَحالَ القِدُّ فيهِ","وَشَفَّ فُؤادَهُ وَجَعٌ شَديدُ",0,"د",1,0],["تُنيرُ بِها الآمالُ وَاللَيلُ واقِبٌ","وَتُخضِبُ مِنها الأَرضُ وَالأُفقُ ماحِلُ",1,"ل",1,0],["تُنيلُ نَزراً قَليلاً وَهيَ مُشفِقَةٌ","كَما يَهابُ نَشيسَ الحَيَّةِ الفَرِقُ",2,"ق",1,0],["تُنيلُ قَليلاً في تَناءٍ وَهِجرَةٍ","كَما مَسَّ ظَهرَ الحَيَّةِ المُتَخَوِّفُ",3,"ف",1,1],["تُنِيرُ وَتُشْجِي قَارِئِيهَا كَأَنَّمَا","تُصِيبُ المُنَى فِيهَا عُقُولٌ وَأَذْهَانُ",4,"ن",1,0],["تُنَيِّهِ مِن بَينِ الصَبِيَّينِ أُبنَةٌ","نَهومٌ إِذا ما اِرتَدَّ فيها سَحيلُها",5,"ل",3,0],["تَني فَيعروها فَتَستَريحُ","مِنَ المَهاري نَسَبٌ صَريحُ",6,"ح",1,0],["تُنير بكهربائيّ المعاني","أموراً كنّ كالظُلَم الدَآدي",7,"د",2,0],["تُني الفَراسَةُ أَنَّ في ثَوبَيهِما","لَيثَينِ تَجتَنِبُ اللُيوثُ حِماهُما",8,"م",2,0],["تُنيل الذي لولاك أعيا منالُهُ","وتُعطي التي تُعطي الأمان من الفقر",9,"ر",1,0],["تُنيل فتعتدُّ الثناء نوافلاً","تنفّلُها والفضل تبذُله فرْضا",10,"ض",2,0],["تَنّيناً في بَحرٍ عائِم","أَو لَيثاً يَخطُرُ في غابِ",11,"ب",1,0],["تنينا جائع له ذنب","يمتصّ منه الغذا إذا سغبا",12,"ب",2,1],["تُنيخُ المَوالي حينَ تَغشى عُيونُهُم","كَأَشباهِ أَولادِ الغَطاطِ التَوائِمِ",13,"م",1,0],["تُنئي مِلاطَيها إِذا ما اِستُكرِهَت","سَعدانَةً كَإِدارَةِ الفُرزومِ",14,"م",1,0],["تُنيرُ لِمُستَهدٍ وَتَعصِمُ خائِفاً","فَحيناً تُرى شَمساً وَحيناً تُرى ظِلّا",15,"ل",2,0],["تَنيكُ وَتَستَنيكُ وَما لِهَذا","وَهَذا إِذ جَمَعتَهُما دَواءُ",16,"ا",2,0],["تنيلُ نزراً قليلاً وهي مشفقة","ٌ كما يَهَابُ نَشِيشَ الحيّة ِ الفَرِقُ",17,"ق",1,0],["تنيت عناني قارعا سن نادم","لا قرع ما فرطت إذ فاتني الأذى",18,"ذ",2,0],["تنير عالمَ سوءٍ كلهُ ظُلمٌ","كالظلّ ضُمن منهُ النور تضمينا",19,"ن",2,0],["تنير بمثل البدر من صحن خدِّها","وتفتّر عن نور الضحى باردٍ عَذْب",20,"ب",1,0],["تنيتُ عناني عن مطاردة الهوى","وهل للهوى بعد الشبيبة باعثُ",21,"ث",1,1],["تُنيرُ ظلامَ الجَهلِ حولي ويهتدي","بها كلُّ أصحابِ الفضيلةِ والحجى",22,"ج",2,0],["تُنيفُ إِذا اِقوَرَّت مِنَ القَودِ وَاِنطَوَت","بِهادٍ رَفيعٍ يَقهَرُ الخَيلَ صَلهَبِ",23,"ب",1,0],["تُنيرُ جَميعَ الزُهرِ لَيلاً وَتَنطَفي","مَعَ الفَجرِ إِلّا أَنجُمَ الشِعرِ في الفَخرِ",24,"ر",1,0],["تُنيرُ الثَريّا وَهيَ قَرطٌ مسلسلٌ","وَإِن كرَّ فيها الطرفُ درٍّ مُبَدَّد",25,"د",1,0],["تنيل نوال اليمن يمناه بسطها","وما مَدَّ إلاَّ نحو خالقه يدا",26,"د",2,0],["تُنيرُ بِهِنَّ القبورُ الدُّثورُ","وتَعْبَقُ منها العِظامُ الرَّميمُ",27,"م",1,0],["تُنيخُ فتُلقي فِي الصُّخورِ كلاكِلاً","تنوء لأَرضِ المِسكِ زَهْواً عن التُّرْبِ",28,"ب",1,0],["تُنيخُ منه ببسَّامٍ لطارقهِ","جمِّ الرماد وشيك النصرِ والزَّاد",29,"د",1,0],["تُنيخُ منه مُعْمَلُ المَطِيِّ","منْ أرْحبيَّاتٍ وأرْحَبيِّ",30,"ي",1,1],["تنير وجوه القوم في كل موقف","يلوح به فوق الوجوه وجوم",31,"م",1,0],["تُنيلُ عَطيّةً وتردُّ أخرى","وتَطوِي الجِدَّ في عينِ المزاحِ",32,"ح",1,0],["تنيفُ عليهِ قدَّها فكأنّها","قضيبٌ تعالى عن قضيبِ على بُعدِ",33,"د",1,0],["تنيف به طوراً وطوراً تخاله","مخاريَق بالأَقراب اَو نفَح مشملِ",34,"ل",1,0],["تنير دجى نفسي وتصرع شهوتي","وتغسل أوجاعي ببلسمها السحري",35,"ر",2,0],["تُنيل العطايا والمنايا أكفُّهم","فليس لها في بذل هاتين من بخلِ",36,"ل",1,0],["تنير تحت ظلام النقع أوجههم","حسنا وتشرق عن أبهى من القمر",37,"ر",1,0],["تنيرُ فوق أغرّ الوجه منتجبٍ","متوّج بعزيز النصر مقتَبَل",38,"ل",1,0],["تنيت قبيل ذاك وبعد كري","إلى مولاته لأنل مرادي",39,"د",2,0],["تُنير العقولَ وتحيي القُلوبَ","وتعطيك نشوةَ بِنتِ العِنَب",40,"ب",1,0],["تني ربد النعام بحافتيه","وتعيا دون معظمه الحبارا",41,"ر",2,0],["تُنْيخُ وفودُ الحمد حول رحابه","لا كرم مُغنٍ في أعز مغَان",42,"ن",1,0],["تُنيفُ بِرَأَسٍ في الزِمامِ كَأَنَّهُ","قَدومُ فُؤوسٍ ماجَ فيها نِصابُها",43,"ب",3,0],["تنير لنا درب البناء بنظرة","لمستقبل الأجيال حين تغيب",44,"ب",1,0],["تُنير وُجوه الحقِّ عند جَوابِنا","إذا أظلمت يوماً وُجوهُ المسائلِ",45,"ل",1,0],["تنيل الثريا لو ملكت عنانها","ولو لم تهب أشباهها كف واهب",46,"ب",1,0],["تنيرين في هذا الخمار كما البدر","ومن دون \"مكياج\" ولا رشة العطر",47,"ر",1,1],["تنيرين؟ .. لا.. لا.. بل تشعين مثلما","تطل علينا الشمس في مطلع الفجر",47,"ر",1,0],["تُنيرُ فيعْلو الخافقينَ منارُها","ويجْلو سَناها الخَطْبَ والخطْبُ مُظْلِمُ",48,"م",1,0],["تنيخ في عقوتيه الوفد أرحلها","ترى به لقراها مربما خصبا",49,"ب",2,0],["تنير فلولا أن يسيل رحيقها","لقلت لظى أذكى النسيمُ شظاياه",50,"ا",2,0],["تنيرُ فَيَستَغشي الزُجاجَة نُورها","كَما ذَرّ قَرنُ الشَمسِ دونَ سَرابِ",51,"ب",1,0],["تنير البلادَ وتحيي العبادَ","بأحكامِ سنةِ خير البشر",52,"ر",1,0],["تنير مصابيح الأسنة حيهم","وتنبت في الأكناف منها القنا الملد",53,"د",1,0],["تنيف على الجبال بها رزايا","تحض بها الغطارف من مناف",54,"ف",1,0],["تنيب إلى الله في طلبة","تكاد السماء لها ان تخر",55,"ر",1,0],["تُنيلُ نَزراً قَليلا وَهيَ مُشفِقَةٌ","كَما يَخافُ مَسيسَ الحَيَّةِ الفَرِقُ",56,"ق",1,0],["تنيرُ شمسُ مساعي","هِ من سماءِ الصَّباحِ",57,"ح",1,0],["تُنيرُ وَتُسدي الريحُ في عَرَصاتِها","كَما نَمنَمَ القِرطاسَ بِالقَلَمِ الحِبرُ",58,"ر",1,0],["تنير الدجى منه إذا الزهر لم تنر","بأزهر طلقِ الكف في الزمن الجعد",59,"د",1,0],["تنيلهم نعما في طيها نقم","سيستضربها من كان ينتفع",60,"ع",1,0],["تنير منه الطريق لمن أراد هدى","ومنه تقضي بعدل الله والحِكَم",61,"م",1,0],["تنيل هدايا نورها كل واصل","كما أنها ( المعراج للسالك ) الواني",62,"ن",2,0],["تنينُ ..قد لَفَّ الهواءَ","بِزِيِّ طاووسٍ خَزَفْ",63,"ف",1,0],["تُنِيْرِيْنَ فِي الْقَلْبِ لَيْلَ الْغَرَاْمِ","فَيَنْبِضُ بِالسُّرْعَةِ الْعَاْلِيَهْ",64,"ي",2,0],["تنيل المنى من سالمته خديعة","وَتعقب من نيل المنى كل مَحْذُور",65,"ر",1,0],["تنيري كبدرٍ وكلُّ النجومِ","بضوئكِ غابتْ ولم تسطعِ",66,"ع",1,0],["تنير دروبي تعطّر صدري","تغرّدُ.. تمسح أشجانيهْ",67,"ي",2,0],["تُنيمُ من تَمُسُّهُ","ولا يَهبُّ رَاقِدَا",68,"د",2,0]]}