مه","https://www.poetsgate.com/ViewPoem.aspx?id=20788",""],[6142,"أهاشم هل للبيض سلة ثائر","https://www.poetsgate.com/ViewPoem.aspx?id=155748",""]],"verses":[["فلا هو يقوى أن يصرح إن شكى","ولا هي تدرى حين كنى مطالبه",0,"ب",2,0],["فلا هو من يبكي على ذكر كربلا","ولا هو أخفى بالمصاب تبسُما",1,"م",2,0],["فلا هم قد رعوا في الدين ذمته","ولا بهم صلحت عن فطرة ذمم",2,"م",1,0],["فَلا هِيَ يَوماً فِيَّ يَنفُذُ كَيدُها","وَلا يَنجَلي مِن غَيِّها شَنَآنُها",3,"ن",3,0],["فلا ها هنا الراعي المغني، ولا هن","تناجي الشذى والطير، لابحة الثغا",4,"غ",2,0],["فَلا هِيَ تَفتُرُ مِن مَرِّها","وَلا نَحنُ مِن شُربِها فاتِرونا",5,"ن",2,0],["فَلا هيَ فازَتْ بالّذي علِقَتْ بهِ","ولا رأسُ مالٍ كانَ ينْفَعُها باقِي",6,"ق",2,0],["فَلا هانَتِ الأَشعارُ بِعدي وَبَعدَكُم","مُحِبّاً وَماتَ الشِعرُ بَعدي وَقائِلُه",7,"ل",2,0],["فَلا هاجِراتُ القَولِ يُؤثِرنَ عندَهُ","وَلا كَلِماتُ النُصحِ مُقصىً مُشيرُها",8,"ر",3,0],["فَلاةٍ مَرَوراةٍ تَرامى إِذا مَرَت","بِها الآلَ أَيدي المُصغِياتِ الرَّواسِمِ",9,"م",1,0],["فَلاةٌ تَقُدُّ الآلَ عَنها وَتَرتَمي","بِنا بَينَ عَبرَيها رَجاها وَجولُها",10,"ل",3,0],["فَلاةٌ يَنِزُّ الرِئمُ في حَجَراتِها","نَزيزَ خِطامِ القَوسِ يُحدى بِها النَبلُ",11,"ل",1,0],["فَلاةٌ رُجوعُ الكُدرِ أَطلاؤُها بِها","مِنَ الماءِ تَأَويبٌ وَهُنَّ رَوابِعُ",12,"ع",1,0],["فَلاةٍ لِصوتِ الجِنِّ في مُنكَراتِها","هَزيزٌ وَلِلأَبوامِ فيها نَوائِحُ",13,"ح",1,0],["فَلا هُو مِنَ الدُنيا مُضيعٌ نَصيبَهُ","وَلا عَرَضُ الدُنيا عَنِ الدَينِ شاغِلُه",14,"ل",2,0],["فَلا هِيَ ما تَرعى جَميعاً عِشارُه","وَيُصبِحُ ضَيفي ساهِمَ الوَجهِ أَغبَرا",15,"ر",2,0],["فَلاَهُم عِندَ مَعتَبَة رَأونَا","كَأَهل أُخُوَّة مُستَعتِبِينَا",16,"ن",2,0],["فَلا هُنَّئتَها نُعمى بِأَسري","وَلا وُصِلَت سُعودُكَ بِالتَمامِ",17,"م",1,0],["فَلا هُوَ فيما سَرَّهُ مُتَطاوِلٌ","وَلا هُوَ فيما سائَهُ مُتَقاصِرُ",18,"ر",1,0],["فلأهدينَّ فريدةً لممدّح","أضحى بنيل نداه شعري مفردا",19,"د",2,0],["فلأَهجونَّك شاكراً","نعمى المعونة حامدا",20,"د",2,0],["فَلا هَدى اللَهُ قَيساً مِن ضَلالَتِهِم","وَلا لَعاً لِبَني ذَكوانَ إِذ عَثَروا",21,"ر",3,0],["فلا هاروت رق له","ولا ماروت يرحمه",22,"م",2,0],["فَلا هُوَ خافٍ وَلا ظاهِرٌ","وَلا سافِرٌ لا وَلا مُنتَقِب",23,"ب",1,0],["فَلا هَجَمتَ بِها إِلّا عَلى ظَفَرٍ","وَلا وَصَلتَ بِها إِلّا عَلى أَمَلِ",24,"ل",1,0],["فلا هُنَّ بالعُتْبَى عليَّ عواطِفٌ","ولا هنَّ بالحُسْنَى إليَّ رواجعُ",25,"ع",1,0],["فَلَأَهتِفَنَّ غَداً بِحُكمِكَ في الوَرى","أَو تَستَجيرَ بِكُلِّ خِلٍّ شاسِعِ",26,"ع",1,0],["فَلا هُوَ مُرضٍ عاتِباً في سَماحَةٍ","وَلا مُنصِفٌ وَفراً إِذا ما تَظَلَّما",27,"م",2,0],["فَلا هُوَ مُسطيعٌ أَبوكَ اِرتِقائَهُ","وَلا أَنتَ عَمّا قَد بَنى اللَهُ عادِلُه",28,"ل",2,0],["فَلا هُوَ مَسبوقاً إلى غايَةِ النَّدى","ولا أنا في شَأوِ المَحامِدِ أُسبَقُ",29,"ق",1,0],["فلا همّةٌ إلا رأيتُ لها عُلاً","ولا أمّة إلا لقيت لها ركبا",30,"ب",2,0],["فَلا هُوَ إِنْ رُعْنَاهُ بِالْجِدِّ يَرْعَوِي","وَلا إِنْ سَأَلْنَاهُ الْهَوَادَةَ يَحْفِلُ",31,"ل",1,0],["فَلا هِيَ لانَت بَعضَ لينٍ يُصيرُها","إِلَينا وَلا أَبدَت لَنا جانِبَ البُخلِ",32,"ل",1,0],["فَلا هُوَ يُرتَجى يَوماً لِنَفعٍ","يَعَزُّ بِهِ الرَعِيَّةَ وَالبِلادا",33,"د",2,0],["فَلا هوَ يَدفَعُ عَن حَوضِهِ","وَلا هوَ يَمنعُ مِن حَوزتِه",34,"ت",2,0],["فَلا هِيَ هَّمَت بالنِكاحِ وَلا دَنَت","إِلى بَشرٍ مِنها بِفَرجٍ وَلا فَمِ",35,"م",1,0],["فَلا هِندَ إِلّا أَن تَذَكَّرَ ما خَلا","تَقادُمَ عَهدٍ وَالتَذَكُّرُ يَشعَفُ",36,"ف",1,0],["فلا هو عن مرآك فيه مغيَّبٌ","ولا هو عن ذكراك فيه مُفيق",37,"ق",1,0],["فَلا هِيَ مِن شَوقٍ إِلَيها تُريحُني","وَلا أَنا مِن طولِ الرَجاءِ أُريحُها",38,"ح",3,0],["فَلا هِيَ تَرضى دُونَ أَمرَدَ ناشِئٍ","وَلا أَستَطِيع أَن أَرُدَّ شَبابِيا",39,"ي",2,0],["فلا هجمت بها إلاّ على ظفرٍ","ولا وصلت بها إلاّ إلى أمل",40,"ل",1,0],["فلا هَطَلَتْ عَلَيّ ولا بأرْضي","سَحائبُ ليسَ تنْتَظِمُ البِلادا",41,"د",2,0],["فَلاَ هُوَ تَيَّاهٌ عَلَى نُظَرَائِهِ","وَلاَ هُوَ نَاسٍ حَقَّ عَافٍ وَسَائِلِ",42,"ل",1,0],["فَلا هَذا يَمَلُّ عِتابَ هَذا","وَلا هَذا يَكَلُّ عَنِ الجَوابِ",43,"ب",1,0],["فَلا هِيَ ما تَرعى جَميعاً عِشارُها","وَيُصبِحُ ضَيفي ساهِمَ الوَجهِ أَغبَرا",44,"ر",2,0],["فلا هِنْدَ إلاَّ أنْ تَذكَّرَ ما خَلا","تَقَادُمَ عَصْرٍ والتَّذَكُّرُ يَشْعَفُ",45,"ف",1,0],["فلا هو بالجَلْدِ المُطيقِ احتمالها","ولا بالشُّجاعِ المستميتِ صراعا",46,"ع",2,0],["فلا هُوَ مُسْطِيعٌ أبُوكَ ارْتِقَاءَهُº","ولا أنتَ عمّا قَدْ بَنى الله عادِلُهْ",47,"ل",2,0],["فلا هي تصمي القلب مني إذا رمت","ولا ترعوي يوماً عن الشنآن",48,"ن",1,0],["فلا هو موجوداً ولا هو فانياً","فمن شاء فليؤمن ومن شاء فليكفرْ",49,"ر",1,0],["فلا هي بالقول الذي صح صدقه","ولا هي بالمين الذي نتكذب",50,"ب",1,0],["فلا هو مؤيس منها","ولا الأقواتُ تحدرها",51,"ر",3,0],["فَلِأَهلِ العُلومِ مِنهُ اِرتِشافا","تٌ وَلِلأَنبِياءِ مِنهُ اِرتِواءُ",52,"ا",2,0],["فَلا هُنَّ بِالبُهمى وَإِيّاهُ إِذ شَتا","جَنوبَ أَراشٍ فَاللَهالَهُ فَالعَجبُ",53,"ب",1,0],["فَلا هُوَ إِن سُمتَهُ الإِرتِفاقَ","كانَ لِما سُمتَهُ فاعِلا",54,"ل",2,0],["فَلاةٍ قَد سَرَيتُ بِها هُدوءاً","إِذا ما العَينُ طافَ بِها كَراها",55,"ا",3,0],["فلا هيّجت وجدي من الشعرِ نغمةٌ","إذا لم أُلقّب فيهِ بالشاعر الفَحل",56,"ل",1,0],["فلا هَيبةٌ للحق إِلا بقوَّةٍ","تردُّ التعدّي والسلاحُ سواء",57,"ا",2,0],["فَلَأُهدِيَنَّ مَعَ الرِياحِ قَصيدَةً","مِنّي مُغَلغَلَةً إِلى القَعقاعِ",58,"ع",1,0],["فَلا هاهُناكَ وَلا هاهُنا","لَكُم مَوئِلٌ غَيرُهُم فَاِنصِبوا",59,"ب",3,0],["فلا هي تدري بالذي أنا واجد","وهيهات مني أَن أَبلَّ أُواما",60,"م",2,0],["فَلا هُدِيَتْ رِجُلٌ تروم بوَطْئِها","مدائِنَ لُوْطٍ وَهْيَ في الجَانبِ الغَرْبي",61,"ب",2,0],["فَلا هُوَ مَقتول وَفي القَتل راحَة","وَلا هُوَ مَمنون عَلَيهِ فَيُطلَقُ",62,"ق",1,0],["فَلا هُوَ يُؤبِسُ مِنهُ بِلا","وَلا هُوَ يُؤنِسُ مِنهُ نَعَم",63,"م",1,0],["فَلا هُوَ عَن دينٍ بِدُنيا مُوَلَّهٌ","وَلا هُوَ في دُنيا بِدينٍ مُعَجَّزُ",64,"ز",1,1],["فلاهوتُهُ المحجوبُ أظهرَ مجدَه","وناسوتُه المحدودُ بالنور يَسطع",65,"ع",1,0],["فلأهدين إلى علاه مدائحا","تبقى على الأحقاب والأزمان",66,"ن",1,0],["فَلاةٌ تَرتَعيها العي","نُ فَالظُلمانُ فَالعُفُر",67,"ر",1,0],["فلا هُوَ أَبْقَى ما أَصابَ لِنَفْسِهِ","وَلا هِيَ أَعْطَتْهُ الَّذي في ناظِرَيْهِ",68,"ه",1,0],["فَلأَهْتِفَنَّ بحمدِها وثنائها","وجزائها فِي مُعْرِقٍ وشَآمِي",69,"م",2,0],["فَلأَهْدِيَنْ مِن طِيبِ ذِكْرِكَ فِي الوَ