{"poems":[[108,"فؤادك أولى بالعتاب","https://www.shoaraa.com/p13816",""],[108,"تأبط شرا","https://www.shoaraa.com/p12775",""],[108,"حتام يا قلب","https://www.shoaraa.com/p11133",""],[53,"سقاها وإن لم يرو قلبي بيانها","https://www.aldiwan.net/poem29650.html","الطويل"],[100,"منزغ الشياطين","https://www.aldiwan.net/poem6546.html","عموديه"],[55,"ركبنا وفتيان صدق ثبينا","https://www.aldiwan.net/poem26089.html","المتقارب"],[77,"أعشاق غير الواحد الأحد الباقي","https://www.aldiwan.net/poem35913.html","الطويل"],[35,"أمن طلل أقوى من الحي ماثله","https://www.aldiwan.net/poem39102.html","الطويل"],[35,"أهاجتك سلمى أم أجد بكورها","https://www.aldiwan.net/poem39144.html","الطويل"],[30,"خليلي عوجا اليوم حتى تسلما","https://www.aldiwan.net/poem29528.html","الطويل"],[30,"أخرقاء للبين استقلت حمولها","https://www.aldiwan.net/poem29537.html","الطويل"],[30,"عفا الزرق من أطلال مية فالدحل","https://www.aldiwan.net/poem29547.html","الطويل"],[30,"أمنزلتي مي سلام عليكما","https://www.aldiwan.net/poem29573.html","الطويل"],[30,"أمن دمنة جرت بها ذيلها الصبا","https://www.aldiwan.net/poem29607.html","الطويل"],[27,"إليك كلفنا كل يوم هجيرة","https://www.aldiwan.net/poem5963.html","الطويل"],[11,"حننت إلى الأجبال أجبال طيئ","https://www.aldiwan.net/poem243.html",""],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[47,"يعز على الأحبة بالشآم","https://www.aldiwan.net/poem25139.html","الوافر"],[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[72,"أهواه فتان اللواحظ أغيدا","https://www.aldiwan.net/poem18548.html","الكامل"],[51,"لو كنت تخلد خلد لؤمك","https://www.aldiwan.net/poem11452.html","مجزوء الكامل"],[29,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[85,"به هجر يتيمه","https://www.aldiwan.net/poem7140.html","مجزوء الوافر"],[85,"فديناه من زائر مرتقب","https://www.aldiwan.net/poem8090.html","المتقارب"],[43,"أعلى الممالك ما يبنى على الأسل","https://www.aldiwan.net/poem9925.html","البسيط"],[62,"هو الشوق حتى ما تقر المضاجع","https://www.aldiwan.net/poem52357.html","الطويل"],[45,"إن الحكيم له مقال سائر","https://www.aldiwan.net/poem65137.html","الكامل"],[45,"هويناك من لوم على حب تكتما","https://www.aldiwan.net/poem65682.html","الطويل"],[28,"وأهل حبونا من مراد تداركت","https://www.aldiwan.net/poem5486.html","الطويل"],[61,"طوى الشوق لولا بارق يتألق","https://www.aldiwan.net/poem51510.html","الطويل"],[80,"لها العتب هذا دأبها ولي العتبى","https://www.aldiwan.net/poem31544.html","الطويل"],[87,"وذي حدب يلتج بالسفن كلما","https://www.aldiwan.net/poem8366.html","الطويل"],[31,"ألم يسلني نأي المزار صبابتي","https://www.aldiwan.net/poem42018.html","الطويل"],[105,"أكل متوج يحمي البلادا","https://www.aldiwan.net/poem43373.html","الوافر"],[105,"متى ينهض الشرق من كبوته","https://www.aldiwan.net/poem43416.html","المتقارب"],[21,"وفي دينكم من رب مريم آية","https://www.aldiwan.net/poem36159.html","الطويل"],[22,"أرسم ديار من حنيدة تعرف","https://www.aldiwan.net/poem22022.html","الطويل"],[75,"ألا أيها الوادي المقدس بالندى","https://www.aldiwan.net/poem69025.html","البسيط"],[50,"يقول أبو عمرو غداة تهللت","https://www.aldiwan.net/poem63968.html","الطويل"],[8,"ألم تسأل الدار الغداة متى هيا","https://www.aldiwan.net/poem21854.html","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140954",""],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16643","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55171","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/4625","الوافر"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10372","الطويل"],[22,"أَرَسْمَ دِيارٍ مِنْ هُنَيْدَة َ تَعْرِفُ","https://www.poetsgate.com/ViewPoem.aspx?id=19785",""],[90,"شباب ضائع","https://www.poetsgate.com/ViewPoem.aspx?id=179161",""],[28,"سمونا لنجران اليماني وأهله","https://www.poetsgate.com/ViewPoem.aspx?id=22082",""],[121,"أخا ثقتي كما ثارت النفس ثورة","https://www.aldiwan.net/poem49365.html","الطويل"],[122,"ألا إنما قلبي به الحب قد يبصر","https://www.aldiwan.net/poem23829.html","الطويل"],[125,"أتذكر والخمار بورك سعيه","https://www.aldiwan.net/poem23798.html","الطويل"],[187,"معز الدولة الوهناء","https://www.aldiwan.net/poem43751.html","مجزوء الوافر"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[196,"فسل هوى من لا يؤاتيك وده","https://www.aldiwan.net/poem54396.html","الطويل"],[236,"أيا عضد الدين يا من غدا","https://www.aldiwan.net/poem31612.html","المتقارب"],[250,"أتعرف من هنيدة رسم دار","https://www.aldiwan.net/poem2088.html","الوافر"],[271,"إذا غاب جسمي في الثرى رافقي ظلي","https://www.aldiwan.net/poem35631.html","الطويل"],[271,"أفي دار قومي يسكن الغرباء","https://www.aldiwan.net/poem35648.html","الطويل"],[288,"أرحلت من سلمى بغير متاع","https://www.aldiwan.net/poem1916.html","الكامل"],[288,"أبلغ ضبيعة أن البلاد","https://www.aldiwan.net/poem1919.html","المتقارب"],[299,"وأعظم ما لاقيت في الحب أنني","https://www.aldiwan.net/poem36317.html","عموديه"],[349,"سلام على الصدر الذي عنده قلبي","https://www.aldiwan.net/poem19861.html","الطويل"],[354,"أحبة قلبي والمنى طوع أمركم","https://www.aldiwan.net/poem40016.html","الطويل"],[367,"يقول خليلي قول الخليل","https://www.aldiwan.net/poem17395.html","المتقارب"],[367,"فلا هو عن دين بدنيا موله","https://www.aldiwan.net/poem17925.html","الطويل"],[378,"جلا مذ تجلى أعينا فيك تدمع","https://www.aldiwan.net/poem59341.html","الطويل"],[410,"لهفي لشرخ شبيبتي وزماني","https://www.aldiwan.net/poem31625.html","عموديه"],[429,"عفا من آل ليلى السهب","https://www.aldiwan.net/poem776.html",""],[435,"إذا أقبلت أقعت وإن أدبرت كبت","https://www.aldiwan.net/poem25679.html","الطويل"],[440,"أقدمت دون معالم الإسلام","https://www.aldiwan.net/poem34781.html","الكامل"],[440,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[454,"لم ينهض الظلم في يوم بإنسان","https://www.aldiwan.net/poem61262.html","البسيط"],[459,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[459,"على أي أخلاقِ الزمان أعاتبه","https://www.aldiwan.net/poem56287.html","الطويل"],[465,"لقد سل سيفا والغدار الحمائل","https://www.aldiwan.net/poem3189.html","عموديه"],[471,"ولكنني وكلت من كل باخل","https://www.aldiwan.net/poem4736.html","الطويل"],[506,"الجرّافة","https://www.aldiwan.net/poem56764.html","الوافر"],[539,"رعى الله أيام الصبا واللياليا","https://www.aldiwan.net/poem47491.html","عموديه"],[541,"فلا هو في الدنيا مضيع نصيبه","https://www.aldiwan.net/poem56710.html","الطويل"],[552,"ومن سفه لما مررت على الحمى","https://www.aldiwan.net/poem47243.html","الطويل"],[559,"خليلي ما بال القوافل هكذا","https://www.aldiwan.net/poem34232.html","الطويل"],[562,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[571,"مالي أرى إبلي تحل كأنها","https://www.aldiwan.net/poem59472.html","الكامل"],[587,"يا حبذا نهر القصير ومغربا","https://www.aldiwan.net/poem17431.html","الكامل"],[587,"نعم هي الدار من يناديها","https://www.aldiwan.net/poem17965.html","المنسرح"]],"verses":[["فلا هو يقوى أن يصرح إن شكى","ولا هي تدرى حين كنى مطالبه",0,"ب",2,0],["فلا هو من يبكي على ذكر كربلا","ولا هو أخفى بالمصاب تبسُما",1,"م",2,0],["فلا هم قد رعوا في الدين ذمته","ولا بهم صلحت عن فطرة ذمم",2,"م",1,0],["فَلا هِيَ يَوماً فِيَّ يَنفُذُ كَيدُها","وَلا يَنجَلي مِن غَيِّها شَنَآنُها",3,"ن",3,0],["فلا ها هنا الراعي المغني، ولا هن","تناجي الشذى والطير، لابحة الثغا",4,"غ",2,0],["فَلا هِيَ تَفتُرُ مِن مَرِّها","وَلا نَحنُ مِن شُربِها فاتِرونا",5,"ن",2,0],["فَلا هيَ فازَتْ بالّذي علِقَتْ بهِ","ولا رأسُ مالٍ كانَ ينْفَعُها باقِي",6,"ق",2,0],["فَلا هانَتِ الأَشعارُ بِعدي وَبَعدَكُم","مُحِبّاً وَماتَ الشِعرُ بَعدي وَقائِلُه",7,"ل",2,0],["فَلا هاجِراتُ القَولِ يُؤثِرنَ عندَهُ","وَلا كَلِماتُ النُصحِ مُقصىً مُشيرُها",8,"ر",3,0],["فَلاةٍ مَرَوراةٍ تَرامى إِذا مَرَت","بِها الآلَ أَيدي المُصغِياتِ الرَّواسِمِ",9,"م",1,0],["فَلاةٌ تَقُدُّ الآلَ عَنها وَتَرتَمي","بِنا بَينَ عَبرَيها رَجاها وَجولُها",10,"ل",3,0],["فَلاةٌ يَنِزُّ الرِئمُ في حَجَراتِها","نَزيزَ خِطامِ القَوسِ يُحدى بِها النَبلُ",11,"ل",1,0],["فَلاةٌ رُجوعُ الكُدرِ أَطلاؤُها بِها","مِنَ الماءِ تَأَويبٌ وَهُنَّ رَوابِعُ",12,"ع",1,0],["فَلاةٍ لِصوتِ الجِنِّ في مُنكَراتِها","هَزيزٌ وَلِلأَبوامِ فيها نَوائِحُ",13,"ح",1,0],["فَلا هُو مِنَ الدُنيا مُضيعٌ نَصيبَهُ","وَلا عَرَضُ الدُنيا عَنِ الدَينِ شاغِلُه",14,"ل",2,0],["فَلا هِيَ ما تَرعى جَميعاً عِشارُه","وَيُصبِحُ ضَيفي ساهِمَ الوَجهِ أَغبَرا",15,"ر",2,0],["فَلاَهُم عِندَ مَعتَبَة رَأونَا","كَأَهل أُخُوَّة مُستَعتِبِينَا",16,"ن",2,0],["فَلا هُنَّئتَها نُعمى بِأَسري","وَلا وُصِلَت سُعودُكَ بِالتَمامِ",17,"م",1,0],["فَلا هُوَ فيما سَرَّهُ مُتَطاوِلٌ","وَلا هُوَ فيما سائَهُ مُتَقاصِرُ",18,"ر",1,0],["فلأهدينَّ فريدةً لممدّح","أضحى بنيل نداه شعري مفردا",19,"د",2,0],["فلأَهجونَّك شاكراً","نعمى المعونة حامدا",20,"د",2,0],["فَلا هَدى اللَهُ قَيساً مِن ضَلالَتِهِم","وَلا لَعاً لِبَني ذَكوانَ إِذ عَثَروا",21,"ر",3,0],["فلا هاروت رق له","ولا ماروت يرحمه",22,"م",2,0],["فَلا هُوَ خافٍ وَلا ظاهِرٌ","وَلا سافِرٌ لا وَلا مُنتَقِب",23,"ب",1,0],["فَلا هَجَمتَ بِها إِلّا عَلى ظَفَرٍ","وَلا وَصَلتَ بِها إِلّا عَلى أَمَلِ",24,"ل",1,0],["فلا هُنَّ بالعُتْبَى عليَّ عواطِفٌ","ولا هنَّ بالحُسْنَى إليَّ رواجعُ",25,"ع",1,0],["فَلَأَهتِفَنَّ غَداً بِحُكمِكَ في الوَرى","أَو تَستَجيرَ بِكُلِّ خِلٍّ شاسِعِ",26,"ع",1,0],["فَلا هُوَ مُرضٍ عاتِباً في سَماحَةٍ","وَلا مُنصِفٌ وَفراً إِذا ما تَظَلَّما",27,"م",2,0],["فَلا هُوَ مُسطيعٌ أَبوكَ اِرتِقائَهُ","وَلا أَنتَ عَمّا قَد بَنى اللَهُ عادِلُه",28,"ل",2,0],["فَلا هُوَ مَسبوقاً إلى غايَةِ النَّدى","ولا أنا في شَأوِ المَحامِدِ أُسبَقُ",29,"ق",1,0],["فلا همّةٌ إلا رأيتُ لها عُلاً","ولا أمّة إلا لقيت لها ركبا",30,"ب",2,0],["فَلا هُوَ إِنْ رُعْنَاهُ بِالْجِدِّ يَرْعَوِي","وَلا إِنْ سَأَلْنَاهُ الْهَوَادَةَ يَحْفِلُ",31,"ل",1,0],["فَلا هِيَ لانَت بَعضَ لينٍ يُصيرُها","إِلَينا وَلا أَبدَت لَنا جانِبَ البُخلِ",32,"ل",1,0],["فَلا هُوَ يُرتَجى يَوماً لِنَفعٍ","يَعَزُّ بِهِ الرَعِيَّةَ وَالبِلادا",33,"د",2,0],["فَلا هوَ يَدفَعُ عَن حَوضِهِ","وَلا هوَ يَمنعُ مِن حَوزتِه",34,"ت",2,0],["فَلا هِيَ هَّمَت بالنِكاحِ وَلا دَنَت","إِلى بَشرٍ مِنها بِفَرجٍ وَلا فَمِ",35,"م",1,0],["فَلا هِندَ إِلّا أَن تَذَكَّرَ ما خَلا","تَقادُمَ عَهدٍ وَالتَذَكُّرُ يَشعَفُ",36,"ف",1,0],["فلا هو عن مرآك فيه مغيَّبٌ","ولا هو عن ذكراك فيه مُفيق",37,"ق",1,0],["فَلا هِيَ مِن شَوقٍ إِلَيها تُريحُني","وَلا أَنا مِن طولِ الرَجاءِ أُريحُها",38,"ح",3,0],["فَلا هِيَ تَرضى دُونَ أَمرَدَ ناشِئٍ","وَلا أَستَطِيع أَن أَرُدَّ شَبابِيا",39,"ي",2,0],["فلا هجمت بها إلاّ على ظفرٍ","ولا وصلت بها إلاّ إلى أمل",40,"ل",1,0],["فلا هَطَلَتْ عَلَيّ ولا بأرْضي","سَحائبُ ليسَ تنْتَظِمُ البِلادا",41,"د",2,0],["فَلاَ هُوَ تَيَّاهٌ عَلَى نُظَرَائِهِ","وَلاَ هُوَ نَاسٍ حَقَّ عَافٍ وَسَائِلِ",42,"ل",1,0],["فَلا هَذا يَمَلُّ عِتابَ هَذا","وَلا هَذا يَكَلُّ عَنِ الجَوابِ",43,"ب",1,0],["فَلا هِيَ ما تَرعى جَميعاً عِشارُها","وَيُصبِحُ ضَيفي ساهِمَ الوَجهِ أَغبَرا",44,"ر",2,0],["فلا هِنْدَ إلاَّ أنْ تَذكَّرَ ما خَلا","تَقَادُمَ عَصْرٍ والتَّذَكُّرُ يَشْعَفُ",45,"ف",1,0],["فلا هو بالجَلْدِ المُطيقِ احتمالها","ولا بالشُّجاعِ المستميتِ صراعا",46,"ع",2,0],["فلا هُوَ مُسْطِيعٌ أبُوكَ ارْتِقَاءَهُº","ولا أنتَ عمّا قَدْ بَنى الله عادِلُهْ",47,"ل",2,0],["فلا هي تصمي القلب مني إذا رمت","ولا ترعوي يوماً عن الشنآن",48,"ن",1,0],["فلا هو موجوداً ولا هو فانياً","فمن شاء فليؤمن ومن شاء فليكفرْ",49,"ر",1,0],["فلا هي بالقول الذي صح صدقه","ولا هي بالمين الذي نتكذب",50,"ب",1,0],["فلا هو مؤيس منها","ولا الأقواتُ تحدرها",51,"ر",3,0],["فَلِأَهلِ العُلومِ مِنهُ اِرتِشافا","تٌ وَلِلأَنبِياءِ مِنهُ اِرتِواءُ",52,"ا",2,0],["فَلا هُنَّ بِالبُهمى وَإِيّاهُ إِذ شَتا","جَنوبَ أَراشٍ فَاللَهالَهُ فَالعَجبُ",53,"ب",1,0],["فَلا هُوَ إِن سُمتَهُ الإِرتِفاقَ","كانَ لِما سُمتَهُ فاعِلا",54,"ل",2,0],["فَلاةٍ قَد سَرَيتُ بِها هُدوءاً","إِذا ما العَينُ طافَ بِها كَراها",55,"ا",3,0],["فلا هيّجت وجدي من الشعرِ نغمةٌ","إذا لم أُلقّب فيهِ بالشاعر الفَحل",56,"ل",1,0],["فلا هَيبةٌ للحق إِلا بقوَّةٍ","تردُّ التعدّي والسلاحُ سواء",57,"ا",2,0],["فَلَأُهدِيَنَّ مَعَ الرِياحِ قَصيدَةً","مِنّي مُغَلغَلَةً إِلى القَعقاعِ",58,"ع",1,0],["فَلا هاهُناكَ وَلا هاهُنا","لَكُم مَوئِلٌ غَيرُهُم فَاِنصِبوا",59,"ب",3,0],["فلا هي تدري بالذي أنا واجد","وهيهات مني أَن أَبلَّ أُواما",60,"م",2,0],["فَلا هُدِيَتْ رِجُلٌ تروم بوَطْئِها","مدائِنَ لُوْطٍ وَهْيَ في الجَانبِ الغَرْبي",61,"ب",2,0],["فَلا هُوَ مَقتول وَفي القَتل راحَة","وَلا هُوَ مَمنون عَلَيهِ فَيُطلَقُ",62,"ق",1,0],["فَلا هُوَ يُؤبِسُ مِنهُ بِلا","وَلا هُوَ يُؤنِسُ مِنهُ نَعَم",63,"م",1,0],["فَلا هُوَ عَن دينٍ بِدُنيا مُوَلَّهٌ","وَلا هُوَ في دُنيا بِدينٍ مُعَجَّزُ",64,"ز",1,1],["فلاهوتُهُ المحجوبُ أظهرَ مجدَه","وناسوتُه المحدودُ بالنور يَسطع",65,"ع",1,0],["فلأهدين إلى علاه مدائحا","تبقى على الأحقاب والأزمان",66,"ن",1,0],["فَلاةٌ تَرتَعيها العي","نُ فَالظُلمانُ فَالعُفُر",67,"ر",1,0],["فلا هُوَ أَبْقَى ما أَصابَ لِنَفْسِهِ","وَلا هِيَ أَعْطَتْهُ الَّذي في ناظِرَيْهِ",68,"ه",1,0],["فَلأَهْتِفَنَّ بحمدِها وثنائها","وجزائها فِي مُعْرِقٍ وشَآمِي",69,"م",2,0],["فَلأَهْدِيَنْ مِن طِيبِ ذِكْرِكَ فِي الوَرى","وَقْرَ الرِّكَابِ وذُخرَةَ الرُّكَّابِ",70,"ب",1,0],["فلا هياكل أخناتون قد نهضت","على ثراها ولا توحيد أديان",71,"ن",1,0],["فلا هو في عَطَني ممسكي","ولا تاركي سارحاً أرتعي",72,"ع",2,0],["فلا هو إن أطريتُه قابضٌ يداً","ولا خائفٌ عاراً بما أنا عائبُهْ",73,"ب",2,0],["فلا هي تدري ما تقول كآبة","ولا نحن ندري ما تقول العواذل",74,"ل",1,0],["فَلا هِيَ بِالمَعروفِ مِنكَ سَخيَّةٌ","فَتُبرِمُ حَبلَ الوَصلِ أَو تَتَبَرَّعُ",75,"ع",1,0],["فلا همْ وُلدُ عدنانَ ولا همْ","لقحطانَ وليْسوا مُسلمينا",76,"ن",2,0],["فلاَهَمَّ يَغشانِي فَيُقِلقُ مَضجَعِي","ولَم أرَ حُلما مُزعِجا في مَنَاميا",77,"ي",2,0],["فَلا هُوَ في الدُنيا مُضيعٌ نَصيبَهُ","وَلا عَرَضُ الدُنيا عَن الدينِ شاغِلُهْ",78,"ه",1,1],["فلاهٍ تخطّاه التجلّدُ مُفحَمٌ","وساهٍ توخّاه التبلُّدُ واجمُ",79,"م",1,0],["فلا هم مع الأقوام فيما تحققوا","ولا هم على تحقيقهم فيخال",80,"ل",1,0],["فَلاهُ وَالمُتَّضِعُ المَفلِيُّ","مَناكِبٌ وَجُؤجُؤٌ مَطوِيُّ",81,"ي",1,0],["فَلاهْبِطنَّ الخَيلَ حُرَّ بِلادِكُم","لُحقَ الأَياطِلِ تَنبُذُ الأَمهارا",82,"ر",2,0],["فَلأَهْجُرنَّ أَخا الوَقارِ وَشأْنِهِ","وَلأَرْكَبنَّ مِنَ الغِوايَةِ مَرْكِبَا",83,"ب",2,0],["فَلا هَجيرَ لِلْهَجْرِ يَحْذَرُهُ","كَلَّا وَلا قَسْوةً يُقاسِيها",84,"ي",3,0]]}