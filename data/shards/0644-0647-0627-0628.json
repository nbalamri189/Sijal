=212984",""],[5277,"منْ أوراق عاشقٍ بغداديٍّ..","https://www.poetsgate.com/ViewPoem.aspx?id=202037",""],[5277,"العيون البغدادية...","https://www.poetsgate.com/ViewPoem.aspx?id=202087",""],[5376,"كم ليلةٍ بالجوى مرَّتْ على العربِ","https://www.poetsgate.com/ViewPoem.aspx?id=214067",""],[5615,"إلى أمي","https://www.poetsgate.com/ViewPoem.aspx?id=199704",""],[243,"على الرابية","https://www.poetsgate.com/ViewPoem.aspx?id=50495",""],[5732,"انا من نجد يكفيني هواها","https://www.poetsgate.com/ViewPoem.aspx?id=177852",""],[5742,"الحمراء تأريخ ونهضة","https://www.poetsgate.com/ViewPoem.aspx?id=206897",""],[5937,"حتى يليقَ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=211823",""],[5956,"نوعٌ جديد","https://www.poetsgate.com/ViewPoem.aspx?id=192427",""],[6093,"بِشَامِ الغيد روحي والمرامُ ( الوافر )","https://www.poetsgate.com/ViewPoem.aspx?id=176151",""],[6102,"صراع","https://www.poetsgate.com/ViewPoem.aspx?id=184432",""],[6152,"عرشها بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=203312",""],[6225,"قوسُ الحنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80920&r=&rc=189",""],[6259,"لقد كنت نبّالاً بلحظك صائداً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59415&r=&rc=63",""]],"verses":[["لَها بَغَماتٌ خَلفَهُ تُزعِجُ الحَشى","كَجَسِّ العَذارى يَختَبِرنَ المَلاهِيا",0,"ي",2,0],["لَها بَينَ جَنبَي ضَرغَدٍ فَضَرِيَّةٍ","غُرَيريَّةٌ يَهدي الضُيوفَ زَفيرُها",1,"ه",2,0],["لَها بَينَ أَعراضِ الرِجالِ قَعاقِعٌ","مَدارِجُها أَسعى مِنَ الغُرِّ أَو أَعدى",2,"د",2,0],["لَها بَيتٌ رَفيعُ السَّمكِ ضَخمٌ","بِهِ تُزهى إِذا اِنتَسَبَتْ أَباها",3,"ا",3,0],["لَها بَينَ أَحناءِ الضُّلوعِ مَوَدَّةٌ","سَتَبقى لَها ما أُلفيَ الدَّهرُ باقِيا",4,"ي",2,0],["لَها بِالصَيفِ أَصبِرَةٌ وَجِلٌّ","وَنيبٌ مِن كَرائِمِها غِزارُ",5,"ر",1,0],["لَها بَشَرٌ مِثلُ الحَريرِ وَمَنطِقُ","دَقيقُ الحَواشِي لا هُرآءٌ وَلا نَزرُ",6,"ر",1,0],["لها بنانٌ فلا غيثٌ يساجلُها","جوداً ولا سحبُه يوماً تدانيها",7,"ي",3,0],["له أبداً مني التذكر والأسى","وللأفضل الملكِ القصائدُ والقصدُ",8,"د",1,0],["لَها بَدَنٌ عاسٍ وَنارٌ كَريمَةٌ","بِمُكتَفَلِ الآرِيِّ بَينَ الصَرائِمِ",9,"م",1,0],["لَها بِحَقيلٍ فَالنُمَيرَةِ مَنزِلٌ","تَرى الوَحشَ عوذاتٍ بِهِ وَمَتالِيا",10,"ي",2,0],["لَها بَشَرُ الدُرِّ الَّذي قُلِّدَت بِهِ","وَلَم أَرَ بَدراً قَبلَها قُلِّدَ الشُهبا",11,"ب",2,0],["لَها بَشَرٌ شَثنٌ كَأَنَّ مَضَمَّهُ","إِذا عانَقَت بَعلاً مَضَمُّ قَتادِ",12,"د",1,0],["لَها بِدُخولِ حَومَلَ بَحزَجِيٌّ","تَرى في لَونِ جُدَّتِهِ اِحمِرارا",13,"ر",2,0],["لَهُ أَبطَحاها الأَعظَمانِ إِذا اِلتَقَت","قُرَيشٌ وَكانَ المَجدُ أَعلاهُ كاهِلُه",14,"ل",2,0],["لَهُ اِبنانِ لا يَنفَكُّ يَجري إِلَيهِما","بِأَوصالِ مَعفورٍ بِهِ يَتَقَرَّمُ",15,"م",1,0],["لَها بَلَهٌ بِالحبِّ تَحسَبُ جِدّهُ","إِذا هَزَّ أَعطافي بِنَشوَتِهِ هَزلا",16,"ل",2,0],["لَها بِقَضيبِ البانِ نَهْضٌ يَزِينُها","مُعينٌ ونهضٌ خاذلٌ بِنَقا الرَّملِ",17,"ل",1,0],["لَها بَينَ أَبوابِ المُلوكِ مَزامِرٌ","مِنَ الذِكرِ لَم تُنفَخ وَلا تُتَزَمَّرُ",18,"ر",1,0],["لهُ ابتسامٌ لكونِ القلبِ عندكمُ","لكنْ تسيلُ لبُعْدِ الجسمِ أدمعُهُ",19,"ع",2,0],["لَها بَعدَ إِسنادِ الكَلِيمِ وهَدئِهِ","وَرَنّةِ مَن يَبكي إِذَا كانَ باكيا",20,"ي",2,0],["له ابتكرت وغيري جاء منتحلاً","وَلَيس مبتكرٌ شيئاً كمنتحل",21,"ل",1,0],["لَها بشط الفرات دارُ","لا سمح اللَه أن تباحا",22,"ح",2,0],["لَهُ ابْتِسَامُ حَبِيبٍ","أَنْسَى الْمُحِبَّ الْعِتابا",23,"ب",2,0],["لَهُ ابْنَانِ لا يَنْفَكُّ يَمْشِي إلَيْهِما","بِأوْصَالِ مَعْفُورٍ بِهِ يَتَقَرّمُ",24,"م",1,0],["لَهَا بِمَزِيدٍ مِنْ شَرَابٍ وَمِنْ نَقْلِ","وَقَالَتْ بِتُولٌ فَارْقُبُوا اللهَ وَاتَّقُوا",25,"ق",3,0],["لها بالصَّيف أصبرَة ٌ وجُلٌّ","وستٌ منْ كرائمها غزارُ",26,"ر",1,0],["لَهُ أَبَداً عِرضٌ مَصونٌ عَنِ الخَنا","وَمالٌ لِمُمتاحِ النَوالِ مُذالُ",27,"ل",1,0],["له ابادٍ تفيض جودا","وتمنح الطالبين رفدا",28,"د",2,0],["لها بَشْرة كالماءِ وهي رهيدةٌ","ثُؤَثِّر فيها رَفْرَفٌ وَمَجاسد",29,"د",1,0],["لَهَا بَأَبِي الْجَعْدِ الرَّفِِيعِ مَطَالِعٌ","تُبَارِي بِهَا الشَّمْسَ الْمُنِيرَةَ بِالأُفْقِ",30,"ق",1,0],["لها بسماتُ البرقِ في ليلِ مِحنتي","فليتَ لحظِّي في الجهادِ كما لها",31,"ل",3,0],["لها بشطوط البحر كل غضنفر","له بسلاح العصر علم تحكما",32,"م",2,0],["لَهَا بِوَجهِكَ نُورٌ تَستَضيء بِهِ","وَفِي نَوالِكَ مِن أعقَابِهَا حَادِي",33,"د",2,0],["لَها بِبَدرٍ لَقَد صاروا كَمُنبَهَةِ","إِذا قَد تَوَلّوا بِأَرواحِ مُدلَهَةٍ",34,"ه",1,0],["له أبداً من رياضِ العَلا","ء زُرْقُ الجمامِ وخُضْرُ الجَميم",35,"م",1,0],["لها بعد خِمْسٍ فَيْضُ خمسةِ أبحُرٍ","إذا وردَتْ أو فَيض خَمْسِ سَحائب",36,"ب",1,0],["لَهابَكَ الكُفرُ حَتّى حَلَّ ما رَبَطا","وَخافَكَ الدَهرُ حَتّى رَدَّ ما فَرَطا",37,"ط",2,1],["لها بذكر الطيب نشر","يعبق من فوحه النسيم",38,"م",1,0],["لها بين جفنَي كلِّ جفن معاونٌ","على كلِّ من همت به ومساعدُ",39,"د",1,0],["لَها بَين أوداجِ الكماة مَوارِدُ","وَبَينَ صُدور المارِقينَ مَصادِرُ",40,"ر",1,0],["لَها بَردٌ مِن دونِها الريق دونَه","فَطابَ وَلَولا ذاكَ لَم يَكُ بارِدا",41,"د",2,0],["لها بينهم ذلّ الغريب وأنتُمُ","قَبيلٌ لها دون الأنام وآلُ",42,"ل",1,0],["لها بنعمانَ مدى اقتراحها","من واسع الأرزاق أو حلالها",43,"ل",3,0],["لها بيتا يهود أو نصارى","وقد كرمت وإن لَؤُماً وخسَّا",44,"س",2,0],["لها بأحسابها طُولٌ وما قطَعتْ","سَيْراً وفيها عن استحقاقكم قِصَرُ",45,"ر",1,0],["لها بطونُ الأرض بل ظهورُها","تصوَّبَتْ أو هي في إصعادِها",46,"د",3,0],["لها بعد ما يفنَى الزمانُ وأهلُه","بقاءٌ على أحسابكم وخلودُ",47,"د",1,0],["لها بنعمانَ طَلاً","تَلوِي عليه الكَشْحا",48,"ح",2,0],["لها بين يوم المهرجان مواقفٌ","لديك وبين الصوم عندك والفِصْحِ",49,"ح",1,0],["لها بعد خطوٍ لات حين مَراحِ","قضاءٌ بوصلٍ غدوةً برواحِ",50,"ح",1,1],["لها بردٌ على الأحشاء شبَّت","له في مجهلِ الإنشاء نار",51,"ر",1,0],["لَهُ أَبرَدَاها بالعَشيِّ وبالضُّحَى","يَدُورُ إلى أَييهِما كانَ أجوَدا",52,"د",2,0],["لها بها وحقها مآربٌ","عسى بعزم الدق أن تنالها",53,"ل",3,0],["لها بالجسم منها ثوب درٍّ","يشف على معانيها الدقاق",54,"ق",1,0],["لها بينَ أيدِيهِ الكِرامِ مَواقِفٌ","صِحاحٌ دَعاويها عُدولٌ شُهوُدُها",55,"د",3,0],["له أبو بكر بهم يصلي","حتى إذا أمكن أن يولي",56,"ي",1,0],["لها بَشَرٌ مثلُ الحريرِ وخدُّها","يُخِّبرُنا أَنَّ الحريرَ مُذَهَّبُ",57,"ب",1,0],["لَها بَعلٌ غَيورٌ قا","عِدٌ بِالبابِ يَحجُبُها",58,"ب",3,0],["لَها بَينَ هاماتِ الرِّجالِ مَغارِبٌ","وَمِن بينِ الواحِ العَمُودِ مَشارِقُ",59,"ق",1,0],["لها بالذي أودعتُها من مديحكم","على الشعر فخرٌ وهي لي في الورى فخر",60,"ر",1,0],["لَها بابُ ياقوتٍ وَبابُ زبرجَدِ","وَباب عَقيقٍ لِلزّيارَةِ للرّبِّ",61,"ب",1,0],["لها باطنٌ كالزَّعْفَرانِ تَعَلَّقَتْ","به من شَرارٍ أَوْ نُضارٍ كواكب",62,"ب",1,0],["لها بشر صافي الأديم كأنه","لجين تراه دون حمر المجاسد",63,"د",1,0],["لُهاً بالغِنَى يَفْضي إليَّ ولا غِنَىً","وَجودٌ يَحُلُّ الفقرَ عندي ولا فَقْرُ",64,"ر",1,0],["لَها بِعَيني إِذا ماسَت عَواطِفُها","جَمالُ مَيّاسَةٍ في عَينِ مِقدادِ",65,"د",1,0],["له أبلى الثرى قدّاً وسيماً","وشتّت بالبلى شَملَ السرور",66,"ر",1,0],["لهَا بلاَ الحُضُورِ وَالخُشُوعِ","تَقُولُ قَد رُمِيتُ بالتَّضييعِ",67,"ع",1,0],["لها بَشَر كالماءِ إذ قَلبها صفا","وناظرُها كالسيفِ لكنه أسطَى",68,"ط",2,0],["لها بمناط ... صدغ مقصف","كما انعطفت في مهرق نون كاتب",69,"ب",1,0],["لها بحر يعجّ بجانبيه","جعافر لا يزال لها زواخر",70,"ر",1,0],["لها بهاتيكم الطاعات قد شهدت","بطاح مسجد طه خاتم الرسل",71,"ل",1,0],["لَها بَشَرٌ نَقيُّ اللَّونِ صافٍ","وَأَخلاقٌ تَشينُ بِها اللِّئاما",72,"م",2,0],["لَها بَشَرٌ نَقيُّ اللَّونِ صافٍ","ومتنٌ خُطَّ فاِعتَدَلَ اِعتِدالا",73,"ل",2,0],["لها بعل له شأن عظيم","غدا يعنو له الخطب الجليل",74,"ل",1,0],["لها بشر لو يدرج الذر فوقه","لبان مكان الذر منه فأثرا",75,"ر",2,0],["لها بالمنى عيدان عيد مؤخر","وأنت لها أصبحت عيدا مقدّما",76,"م",2,0],["لَهُ ابتسمت تيهاً بِهِ وَتَبَخترت","وَمالَت كَما مالَ القَضيب مِن الرند",77,"د",1,0],["لها براهين منه دلت","على البلاغات كالشموس",78,"س",1,0],["لها بروج ولها عقرب","لا يألف البرج سوى ساعه",79,"ع",2,0],["لَهُ أَبَداً بالناس غدرٌ وهم لهم","بانفسهم ما فوق ذاك من الغَدرِ",80,"ر",1,0],["لَهَا بِالظِّلِّ أَزْرَارٌ حِسَانٌ","وَأَطْوَاقٌ وَمِنْ وَرِقٍ ثِيَابُ",81,"ب",1,0],["لها بارق مؤذن بالمنون","ورعد يقهقر شعرى العبورا",82,"ر",2,0],["لَها بَشَر الدُرِّ الَّذي قُلِّدَت بِهِ","كَأَنَّ الدَراري قَلَّدت جيدَها سِمطا",83,"ط",2,0],["لها بعزم نسير","لها بعزم نسير",84,"ر",1,0],["لَها بِالصَيفِ آصِرَةٌ وَجُلِّ","وَسِتُّ مِن كَرائِمِها غِزارُ",85,"ر",1,0],["لها بشرٌ لو باشرَ الوردُ بعضَه","بناعمةٍ بلْهَ الرياضَ لأثَّرا",86,"ر",2,0],["لها بَشرٌ ناعمٌ كالحرير","وَخدْ كجلُنارِها الأحمرِ",87,"ر",1,0],["لَه اِبر قَد جاءَ صاف شرابه","وَأَحنت أَبينا جاء في بدء نَجره",88,"ر",2,0],["لها بين أفلاذ القلوب ملاعب","وإن ضمها في سفح نجد خباؤها",89,"ه",2,0],["له إبليس أمر بنيه أنهى","فعاد عن امتثال اللَه ينهى",90,"ه",2,0],["لها بذكرك أنفاس معطرة","كما تنفست الأزهار في السحر",91,"ر",1,0],["لها بياني غدا أشباحا","ومذ أدارت لنا أقداحا",92,"ح",2,0],["لها بسْمةٌ كالأماني العِذابِ","وَتصفُو إذا الودّ أصْفيتُها",93,"ت",3,0],["لها بحر ينبع لارْسل الهم لي فوجه","يسلي لي الخاطر واسليه بابياتي",94,"ت",2,0],["لها بينَ الضلوعِ هوىً قديمٌ","وعهدٌ خالدٌ يَرويهِ عِشقُ",95,"ق",1,0],["لها بدْءُ حبِّي وانْتهاءُ محبَّتي","وميلادُ عشْقي حينَ غرَّدَ وابْتَدَرْ",96,"ر",1,0],["لَهَا بَسْمَةٌ كَالتُّوتِ تَلْمَعُ حُلْوَةٌ","فَإِنْ ضَحِكَتْ فَالتُّوتُ شَهْدٌ بِثَغْرِهَا",97,"ر",3,0],["لها بّن ، تحرق في خفوقي محاميسه","بغيت أتصبر وأحرقتني محامسها",98,"س",3,0],["لها بشرٌ مثل مس الحرير","وإن كان ألحاظها كالسنان",99,"ن",1,0],["لها بالعلم ِسبقٌ وانتصارٌ","ونالتْ كلَّ مجدٍ عنْ جداره",100,"ر",2,0],["لها بقبابِها هالاتُ قومٍ","همُ صدقوا معَ اللهِ العهودا",101,"د",2,0],["لها بغدادُ والنهرُ المُغلَّى","وما تحوي الجسورُ منَ السنينِ",102,"ن",1,0],["لها بواكٍ تمورُ الأرضَ غاضبةً","وما بقادتنا بعضٌ من الغضبِ",103,"ب",1,0],["لَها بَسمةٌ حارَ فيها اللَّبي","بُ ، وفي حُجرَةِ القَلبِ إيواؤُها",104,"ا",3,0],["لها بين عيني وبين الثرى","مسيل على زجنة ذاوية",105,"ي",2,0],["لها بالروح وفؤادي مودة","ولاشىء من احوالي خفاها",106,"ا",3,0],["لها بعمان منزلة وفضلٌ","قديم بين ألويةٍ وقربى",107,"ب",2,0],["لها بقلبيَ أقصىً لا غزاةَ بهِ","وكعبةٌ بين باكيها ولاثمها",108,"م",3,0],["له أبشعُ الأسماء مشتهر بها","أغنى قواميسَ الخساسة والقِلى",109,"ل",2,0],["لها بالغوطة الخضراء ملهىً","وتأوي قاسيونَ لها خيامُ",110,"م",1,0],["لَهَا بِاجْتِثَاثِ الضِّلْعِ أَحْلَامُ مِخْلَبٍ","تَصَارَعَ مَعْ وَجْدِي , فَعِشْقًا تَحَطَّما",111,"م",2,0],["لها بقلبي عرش ليس ينكره","من كان بالحُسن ..مفتونا وولهانا",112,"ن",2,0],["لها بكل الجهاتِ مُرتحَلٌ","إلى حياةٍ رحيقها ذِكَرُ",113,"ر",1,0],["لها بَرَدٌ من ثغرها الريق ذوبهُ","فطاب ولولا ذاك لم يكُ باردا",114,"د",2,0]]}