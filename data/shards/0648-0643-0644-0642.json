داء الأيوبي )","https://www.poetsgate.com/ViewPoem.aspx?id=214662",""],[4717,"أنوء بقلبٍ أثقلته المواجع","https://www.poetsgate.com/ViewPoem.aspx?id=199866",""],[4927,"فدوى","https://www.poetsgate.com/ViewPoem.aspx?id=30183",""],[4961,"وصلَّى خلفكَ العملُ المثالي","https://www.poetsgate.com/ViewPoem.aspx?id=37240",""],[4984,"الفاصلة .. ، ..","https://www.poetsgate.com/ViewPoem.aspx?id=197617",""],[5206,"حجر الفلاسفة","https://www.poetsgate.com/ViewPoem.aspx?id=187417",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[5392,"..للخيوط ذهولُ","https://www.poetsgate.com/ViewPoem.aspx?id=11293",""],[5459,"ذبح السماح","https://www.poetsgate.com/ViewPoem.aspx?id=200624",""],[5461,"ساعات العصر","https://www.poetsgate.com/ViewPoem.aspx?id=5230",""],[5667,"البحر","https://www.poetsgate.com/ViewPoem.aspx?id=214837",""],[5690,"أما ينقضي هذا التدلل والصدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=172154",""],[5776,"الشّاعِرُ الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=206108",""],[5786,"إن رمتَ منّي السلوَّ بالفند","https://www.poetsgate.com/ViewPoem.aspx?id=50657",""],[5919,"عواصف اللهِ غارات بلا مَهَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=128684",""],[5953,"تشخص للأنام فتشبهوه","https://www.poetsgate.com/ViewPoem.aspx?id=93843",""],[5956,"عودة طيوف الميت القديم","https://www.poetsgate.com/ViewPoem.aspx?id=192224",""],[6102,"مَرسُوم ..","https://www.poetsgate.com/ViewPoem.aspx?id=185051",""],[572,"دُمُوعي فيك أنواءٌ غِزَارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9327&r=&rc=184",""]],"verses":[["وَكُلُّ قَريبٍ لي بَعيدُ مَوَدَّةٍ","وَكُلُّ صَديقٍ بَينَ أَضلُعِهِ حِقدُ",0,"د",1,0],["وَكُلُّ قَريبِ الدارِ لا بُدَ مَرَّةً","سَيُصبِحُ يَوماً وَهوَ غَيرُ قَريبِ",1,"ب",1,0],["وَكُلّ قَتيلِ مَكرُمَةٍ قَتَلنا","وَأَكثَرنا الطَلاقَةَ وَالإِسارا",2,"ر",2,0],["وكلّ قود سألت منه","يقول لي رحْ بلا قياده",3,"ه",1,0],["وَكُلُّ قَلبٍ مِثلُ قَلبي لَهُ","حَسناءَ تَرجوهُ وَيَرجوها",4,"ه",2,0],["وكلُّ قَرارٍ بالجَماجمِ تلعةٌ","وكلُّ مَغيضٍ بالدِّماءِ مَسِيلُ",5,"ل",1,0],["وَكُلُّ قِرى الأَضيافِ نَقري مِنَ القَنا","وَمُعتَبَطٍ فيهِ السَنامُ المُسَدَّفُ",6,"ف",1,0],["وَكُلُّ قَضائِهِ عَدلٌ عَلَينا","وَكُلُّ بَلائِهِ حَسَنٌ جَميلُ",7,"ل",1,0],["وَكُلُّ قَلبٍ يَحِنُّ","إِلَيهِ شَوقَ لِقائِهِ",8,"ه",1,0],["وَكُلُّ قِسمٍ فَلِلعُقبانِ أَكثَرُهُ","وَالحَظُّ شَيءٌ عَلَيهِ الدَهرُ مَقصورُ",9,"ر",1,0],["وكُلُّ قَرينَيْ إِلفَةٍ لِتَفَرُّقٍ","شَتاتاً وإنْ ضَنَّا وطالَ التَّعاشُرُ",10,"ر",1,0],["وَكُلُّ قَلْبٍ يُحِبُّ شَيْئاً","مِنْ صُنْعِ رَبِّي أُحِب حَقا",11,"ق",2,0],["وَكُل قَدْمٍ فيكِ أَوْ عَالِمٍ","مَا شَاءَ أَنْ يَكْبُرَ فَلْيكْبُرِ",12,"ر",1,0],["وكل قرنان اويس القرني","يا ليت لو اني به لم اكن",13,"ن",1,0],["وكل قضية فلها انقضاء","وكل نهاية فلها تمام",14,"م",1,0],["وكل قطب آمر في الوقت","ومنقذ من واقعات المقت",15,"ت",1,0],["وَكُلُّ قَرنٍ ناجِمٍ في زَمَنٍ","فَهوَ شَبيهُ زَمَنٍ فيهِ بَدا",16,"ا",1,0],["وكلِّ قارئٍ لها وقابلِ","ممّن غَدا لهُ محبّاً مُسلما",17,"م",2,0],["وكلُّ قصيرٍ من شهورِ اجتماعِنا","فلمَّا افترقْنَا عادَ وهو طَويلُ",18,"ل",1,0],["وكل قطر يلاقي","من الخراب نصيبه",19,"ب",2,0],["وَكُلُّ قاذورَة تَرقى بِعورتها","إِلى لسانٍ ذَريف الخُبثِ سَيّار",20,"ر",1,0],["وَكُلُّ قَلبٍ وَقَد سِر","تَ في الرِحالِ أَسيرُ",21,"ر",1,0],["وَكُلُّ قَريضٍ دونَ نَظمِ قَريضِهِ","وَهَل تَتَساوى رَغوَةٌ وَصَريحُ",22,"ح",1,0],["وكل قلب مراح","وكل طرف قرير",23,"ر",1,0],["وَكُلٌّ قَد لَقي ما قَد لَقينا","وَكُلٌّ لَيسَ مِنهُ لَهُ اِصطِبارُ",24,"ر",1,0],["وَكُلّ قَلب بِها لا يَزدَهي طَرَباً","مِن المَسَرَّة فَاِعلَم أنَّهُ حَجَرُ",25,"ر",1,0],["وكل قلب فيه ميل للسوى","فإنه يا صاح عبد للهوىء",26,"ا",2,0],["وَكلّ قومٍ لَهم قُربى ومنزلةٌ","عِندَ الإله وَللأدنين مقتربُ",27,"ب",1,0],["وكل قلب حي بحبّكم","منعم بالوصال أو طامع",28,"ع",1,0],["وكلّ قلب بعدي أحبَّكُمُ","قلبُ دخيلِ الودادِ منتقِلِ",29,"ل",1,0],["وكلّ قلبٍ قُرحة","يشِفُّ عنه الجسدُ",30,"د",1,0],["وَكُلُّ قَرينٍ ذي قَرينٍ يَوَدَّهُ","سَيُفجِعَهُ يَوماً مِنَ البَينِ فاجِعُ",31,"ع",1,0],["وكلِّ قلبٍ ذاكِرٍ","مُكَبِّرٍ مُهَلَّلِ",32,"ل",1,0],["وكل قوم عندهم ذو هدى","وذو ضلال حكم إجرائه",33,"ا",3,0],["وكل قلوب الناس لو لم تَهِم بها","لما طاب نثر في الكلام ولا نظم",34,"م",1,0],["وكل قد أجاز لمن سواه","على الترتيب في أخذ العهود",35,"د",1,0],["وكل قول فله جواب","وقل من يقنعه الصواب",36,"ب",1,0],["وكل قول دونه معلول","وإنما ينصفك القليل",36,"ل",1,0],["وكُلُّ قلبٍ واجِدٌ بَعْدَه","كأَنَّه في عِقْدِ تِسْعِينه",37,"ن",2,0],["وكلُّ قصيدٍ قلتُها فيكَ إِنَّها","بلا مِرْيَةٍ في الحسنِ والسِّيرِ كَوْكَبُ",38,"ب",1,0],["وكل قريحةٍ لم تلقَ هَدياً","بمشكاة المعارف لا تُريمُ",39,"م",1,0],["وَكُلُّ قَلبٍ إِلَيهِ مُنصَرِفٌ","كَأَنَّهُ مِن جَميعِها خُلِقا",40,"ق",2,0],["وكلِّ قَسٍّ مُظْهِرٍ للتُّقَى","بآي إنْصَاتٍ وإخباتِ",41,"ت",1,0],["وكل قؤول للقريض مبرز","على كل نظام جميلٍ مجمل",42,"ل",1,0],["وَكُلُّ قَتيلٍ مِن رَبيعَةَ يَنتَمي","إِلى حَسَبٍ صَعبِ المَناكِبِ عاتِ",43,"ت",1,0],["وَكُلِّ قَبْقَابِ الهَدِيرِ قَهْمِ","أَرْأَسَ ذي بَرَاثِنٍ دِلَّخمِ",44,"م",1,0],["وكل قصدي خلوة","تجمعني وللصبي",45,"ب",2,0],["وكل قرب إلى بعاد","وكل وصل إلى انقطاع",46,"ع",1,0],["وَكُلَّ قَبيحٍ وَإِن لَم تَكُن","أَرَدتَهُمُ مِنكَ باتوا وِجالا",47,"ل",2,0],["وَكُلُّ قَومٍ مَعدِيِّ الأَرومِ لنا","مِنهُ المُقَدَّمُ مِن عِزِّ وَأَخطارِ",48,"ر",1,0],["وَكُلُّ قَسٍّ كَقُسٍّ إِن تَحَدَّثَ عَن","عيسى بنِ مَريَمَ أَو موسى بنِ عِمرانِ",49,"ن",1,0],["وَكُلُّ قَومٍ لَهُمُ تكثيرُ","وَقَلَّما تُحَصَّلُ الأُمورُ",50,"ر",1,0],["وكل قتيل في بلاد قسامةٍ","إذا لم يسم قاتلوه فيعقل",51,"ل",1,0],["وكل قرضٍ يجر النفع منتقضٌ","فاعلم ولا يدخلنك الكبر والأنف",52,"ف",1,0],["وكل قوم أصلهم واحدٌ","عليهم العشرُ إذا استجمعوا",53,"ع",3,0],["وكل قاص جيله ودان","من فرق البيضان والسودان",54,"ن",1,0],["وكل قد تركب من ثلاث","ثلاث منه فرد في الأساس",55,"س",1,0],["وكُلّ قِنديلٍ يزيدُ في السَّنا","وضوؤهُ فيه الأمانُ والمُنى",56,"ن",2,0],["وكل قيام لا لوال وعالم","ووالده أو سيد كرهه امهد",57,"د",1,0],["وكل قرينين يقتديان","رحيلا فأما اقترانا وأما",58,"م",2,0],["وكلُّ قديم كان ذا أوَّليةٍ","تفضله فهو العزيز المكرم",59,"م",1,0],["وكلّ قلب يميل سكرا","كأنما القلب غصن بان",60,"ن",1,0],["وكل قرمٍ بآذيٍّ يخوض دماً","والبيض والبيض مسراها العجاجات",61,"ت",1,0],["وكلٌّ قد دعاني نحو نهج","فحرت كأنما أنا في مضيق",62,"ق",1,0],["وكل قطب ثم آل النوبه","وصاحب الوقت عظيم الهيبه",63,"ه",1,0],["وكل قتل قصاصا جائز حسن","لو للنساء لو الجاني الولا جهلا",64,"ل",2,0],["وكلُّ قولٍ يروقُ رائقهُ","يصغُر في جبنها وانْ عظمَا",65,"م",2,0],["وَكُل قَولك جَزل ما بِهِ غَزَل","وَلا اِرتياح لِمثل الوَرد وَالعنم",66,"م",1,0],["وَكُل قويّ العَزم رَبّ تخونه","قِواه وَمِن بَعد الشماس يَدربج",67,"ج",1,0],["وكُلُّ قُريشٍ يَعلَمُونَ أمُورَنَا","وَحَيثُ يَظُنُّونَ الدَوَاغِلَ والدَغلا",68,"ل",2,0],["وكل قطوف المشي رود شبابها","إذا ما مشت مرتجة المتأزر",69,"ر",1,0],["وكل قافية في المجد قد بهرت","له الموازين منها والتراكيب",70,"ب",1,0],["وَكُلٌّ قامَ يَهديهِ التَهاني","فَجئتُ مهنئاً بَينَ الرِفاقِ",71,"ق",1,0],["وكل قلب يصدّ عنه","فهو خراب البناء قفر",72,"ر",1,0],["وكل قصدِكَ رُشْدٌ","وكل فعْلكَ برُ",73,"ر",1,0],["وكل قاض بدعوى لا يحققها","يقضي بحقٍ عليهِ الحقُ عقباهُ",74,"ه",1,0],["وكلّ قولٍ إذا قَسَّمتَه انقسما","اسمٌ وفعلٌ وحرفٌ ثالثٌ لهما",75,"م",2,0],["وَكُلُّ قَرمٍ إِذا الحادي أَرَنَّ بِهِ","سارَ العِرَضنَةَ بَعدَ الأَينِ أَو خَطَرا",76,"ر",2,0],["وكل قرطاسه المعمى","بياضُ دمعٍ على سوادِ",77,"د",1,0],["وكلُّ قرم منهمو بصبره","يساور الهول إذا الهول علا",78,"ا",1,0],["وكل قاضٍ ما حوى القاضيخان","للدين حقّاً ذلك القاضيخان",79,"ن",1,0],["وَكُلُّ قَبيحٍ إِن نَسَبتَ لِحُسنِهِ","أَتَتكَ مَعاني الحُسنِ فيهِ تُسارِعُ",80,"ع",1,0],["وكل قصيدٍ فقههُ من بيانها","فمن شذّ لم يفلحْ وإن هو يبرعِ",81,"ع",1,0],["وكلُّ قبيحٍ قَدْ حوتْه صفاتُها","فليسَ يُرى ثانٍ لها فينازع",82,"ع",1,0],["وَكُلُّ قَنَاْطِرِ الآثَاْرِ قَاْلَتْ:","لَهَاْ فَنٌّ، وَلِلْبَاْقِي السَّرَاْبُ",83,"ب",1,0],["وكلُّ قلوبِنا صارتْ إليهِ","هلالاً في مُعانقةِ الهلال ِ",84,"ل",1,0],["وكل قوي في عديد وعدة","ضعيف إذا الطغيان كان له صوبا",85,"ب",2,0],["وَكُلٌ قَالَ ذَاكَ دَوَاءُ دَائِي","وَلَسْتُ بِغَيرِهِ جَزمًا بَرِيَّا",86,"ي",2,0],["وكل قرى نجد بهن معابد","كثير بلا حد يحد ولا عد",87,"د",1,0],["وكلٌّ قريبٌ منْ مغارته التي","تولولُ مشتىً، والبراري فصولُ",88,"ل",1,0],["وكل قرية بها محنة","وكل دار أسمَعَتنا النُّواح..",89,"ح",1,0],["وكل قصر له أساس وسقف وباب","يحكمون اركانها بانينها",90,"ن",3,0],["وكلُّ قِمَّةِ طَودٍ تَنتَمي شَرَفاً","لقِمَّةٍ مثلِها تَسمو وتَزدَهِرُ",91,"ر",1,0],["وكل قريض قد تحالى نسيبهُ","ورقَّ فقل ما ذاك إلا لها يغدو",92,"د",2,0],["وكل قصيدةٍ قيلتْ جهادًا","وشاعرها بها أورى زنادهْ",93,"د",2,0],["وكلّ قولٍ أتى بلا حكمٍ","فإنَّ معناهُ غير مُطّرد",94,"د",1,0],["وكلِّ قطبٍ حنى طوعًا لآمره","بقولهِ قَدَحي يعلو لكلِّ ولي",95,"ل",2,0],["وكلٌ قائلٌ الله ربي","وإن تسألهم لم يعرفوه",96,"و",2,0],["وكلُّ قديمٍ وكل جديدٍ","يحوز له موطناً في الكبودْ",97,"د",1,0],["وَ كُلِّ قَائِمِ عَضبٍ ؛ قَدْ دَقَقتُ بِهِ","نَصلًا تَصَدَّعَ فِي الأَضلاعِ مَكلُوما",98,"م",2,0],["وكلُّ قتى ً علاه ثوبُ سُقْمٍ","فذاكَ الثوبُ منِّي مُسْتَعَارُ",99,"ر",1,0]]}