قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=215295",""],[5582,"بَدَتْ عَنْ وَجْهِها سَحَراً فَلاحَا","https://www.poetsgate.com/ViewPoem.aspx?id=186791",""],[5582,"قَلْبٌ بِنارِ الهَوَى قَدْ ذابَ وَاحْتَرَقَا","https://www.poetsgate.com/ViewPoem.aspx?id=187203",""],[5582,"سَفَرَتْ فَكادَ تَأَلُّقُ الأَنْوارِ","https://www.poetsgate.com/ViewPoem.aspx?id=63514",""],[5582,"لِمَن الهَوادِجُ وَالقبب","https://www.poetsgate.com/ViewPoem.aspx?id=63458",""],[5691,"نِعلين تقاوم الجدار","https://www.poetsgate.com/ViewPoem.aspx?id=206393",""],[5781,"حبُّكَ...في الأول من نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=212813",""],[5837,"عشق العلا","https://www.poetsgate.com/ViewPoem.aspx?id=77449",""],[5861,"مرثية لصبية","https://www.poetsgate.com/ViewPoem.aspx?id=188053",""],[1920,"ياسمين بابلي","https://www.poetsgate.com/ViewPoem.aspx?id=191433",""],[5956,"بعدالةٍ من أحمد الطعمينا","https://www.poetsgate.com/ViewPoem.aspx?id=194285",""],[5977,"أمة الاسلام","https://www.poetsgate.com/ViewPoem.aspx?id=213289",""],[6004,"أيُّ ربيعٍ أنتَ","https://www.poetsgate.com/ViewPoem.aspx?id=109515",""],[6124,"سينية العشق","https://www.poetsgate.com/ViewPoem.aspx?id=128751",""],[6127,"الطوطميون","https://www.poetsgate.com/ViewPoem.aspx?id=188251",""],[6130,"شرفةُ حلمٍ ...","https://www.poetsgate.com/ViewPoem.aspx?id=199248",""],[6147,"لو سجّلوني ..ميّتا..","https://www.poetsgate.com/ViewPoem.aspx?id=151486",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[6202,"هوى وشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86757&r=&rc=58",""],[6225,"النصف الأقوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81093&r=&rc=287",""],[6341,"مداي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87282&r=&rc=11",""],[572,"قُمْ قَدْ أَتَى ضوءُ الصَّبَاحِ المُسْفِرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9302&r=&rc=159",""],[572,"تَراهُ في الصّدرِ من خَساسَتِهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9348&r=&rc=205",""]],"verses":[["يُحْكي عِناقَ مُحِبٍّ مَنْ يَهيمُ بهِ","إذا تَعانَقْنَ في أرْجائِهِ الجُدُرُ",0,"ر",1,0],["يَحْكي أبا المِغْوارِ في بِشْرِهِ","يا لَيْتَهُ أشْبَهَهُ في السَّماحْ",1,"ح",1,0],["يَحكي السَرابَ بِوَعدِهِ","ما يَنقَضي أَبَداً غُرورُه",2,"ر",2,0],["يَحْكِي الحُكَاةُ لَنَا عَنْهُ تَوَغُّلَهُ","فِي الفَتْكِ بِالنَّاسِ فَتْكَ الآكِلِ النَّهِمِ",3,"م",1,0],["يُحَكِّمُ فِيهِ رُشْدَهُ فَهْوَ غَانِمٌ","وَمَنْ لَمْ يُحَكِّمْ رُشْدَهُ فَهْوَ غَارِمُ",4,"م",1,0],["يحكي الخليفةَ كفّاً كلّما وَكَفَتْ","بالجود فوق موات الأرض يُحييها",5,"ي",3,0],["يحكي حدائق نرجس في شاهق","تنساب فيه أراقم الأنهارِ",6,"ر",1,0],["يحكي الزلال لدى العطا","ش أو الثراء لدى الفقير",7,"ر",1,0],["يحكي عمود الماء فيها آخذاً","صعداً عمود الصبح حين ينير",8,"ر",1,0],["يحكي الأثير إذا أجرى تلاطمه","أبدي سواطع نور منه منبثق",9,"ق",1,0],["يحكي دم المظلوم مازج أدمعاً","هملت بها عين اليتيم همولا",10,"ل",2,0],["يحكي مصابيحَ السماء وتارةً","يحكي مصابيح الوجوه تَراصَدُ",11,"د",1,0],["يحكي الطَواويس غدت مطاوِسه","كأنما تلك الفروع المائسه",12,"س",2,0],["يَحكي بَياضُ التِرسِ لي","مِنها بَياضَ الوَجنَتَينِ",13,"ن",1,0],["يَحكي الغَزالَةَ بَهجَةً وَتَباعُداً","وَيَقولُ قَومٌ مُقلَةً وَمُقَلَّدا",14,"د",2,0],["يحكى اللسان اذا صدعت","به من السيف الغرارا",15,"ر",2,0],["يَحكونَ أَنَّ أُمَّةَ الأَرانِبِ","قَد أَخَذَت مِنَ الثَرى بِجانِبِ",16,"ب",1,1],["يَحكونَ أَنَّ رَجُلاً كُردِيّا","كانَ عَظيمَ الجِسمِ هَمشَرِيّا",17,"ي",2,1],["يَحكي سَبَائِكَ فِضَّةٍ","فيها شُذُورٌ مِنْ ذَهَبْ",18,"ب",1,0],["يَحُكُّ أَنّى شاءَ حَكَّ الباشِقِ","قوبِلَ مِن آفِقَةٍ وَآفِقِ",19,"ق",1,0],["يحكِي نهودَ الغانياتِ وتحتَها","سُرَرٌ لهنَّ حُشِينَ مِسْكاً أذْفَرَا",20,"ر",2,0],["يحكي كُراتِ سُفُنٍ","مصبوغةٍ بالعُصْفُرِ",21,"ر",1,0],["يحكي القضيبَ قوامُه ونحولُه","حسناً وضوءُ البدرِ من أسمائِهِ",22,"ا",3,0],["يُحَكنَ لَهُ حَوكَ البُرودِ لِزينَةٍ","وَيُنظَمنَ عَن جَدواهُ نَظمَ القَلائِدِ",23,"د",1,0],["يَحكيكَ في كَرَمِ الفَعالِ خَلائِقاً","بِخَلائِقٍ وَشَمائِلاً بِشَمائِلِ",24,"ل",1,0],["يَحكيكَ في الشَرَفِ الَّذي حَلَّيتَهُ","بِالمَجدِ عِلماً أَنَّهُ سَيَشيعُ",25,"ع",1,0],["يحكي لك الذهب المصفى لونه","وتزيد بهجته على إشراقه",26,"ق",2,0],["يَحكي نَضيجَ البَيضِ قُدَّ بِمِديَةٍ","كانَت فَبَثَّ عَلى البَياضِ صَفارَه",27,"ه",1,0],["يَحكي عُيونَ العينِ في تَلويزِهِ","وَفُتورِهِ وَبَياضِهِ وَسَوادِهِ",28,"د",2,0],["يَحُكّ من دَمِها القاني يداً بِيَدٍ","حَكّ الظَريفِ بِحنّاءٍ بَنانَ يَدِ",29,"د",1,0],["يَحُكُّ صَلاهُ عَقرَباهُ وَيَقتَري","مَسايِلَ خُضراً بَينَهُنَّ وَقيعُ",30,"ع",1,0],["يَحكي إِذا ما صُبَّ في أَطباقِهِ","خَيماً ضُرِبنَ مِنَ الحَريرِ الأَحمَرِ",31,"ر",1,0],["يَحُكُّ الغُصونَ المورِقاتِ بِرَوقِهِ","كَخَصفَكَ بِالإِشفى نِعالاً فَخَصَّرا",32,"ر",2,0],["يَحكي صَداهُ مَجيدَ الصَوتِ إِذ نَطَقَت","مِنهُ اللُغاتُ عَلى طَبلٍ وَزَمّارِ",33,"ر",1,0],["يَحْكي بغُرَّتِهِ هِلا","لَ الفِطْرِ لاحَ لِعَيْنِ صائِمْ",34,"م",1,0],["يَحْكُمُ بِالذَّوْقِ عَلَى ما يَرَى","وَيَعْرِفُ الأَصْلَحَ والأَفْسَدَا",35,"د",2,0],["يُحْكِمُ الصَّوْغَ فِي القِلاَدِ فَمَا يَأْ","تِي صَنَاعٌ بِمِثْلِهَا فِي القِلاَدِ",36,"د",1,0],["يُحْكِمُ الرَّأْيَ في تَصَرُّفِهِ غَيْرِ","مُبَالٍ لُوْ سِيمَ فِيهِ العَذَابَا",37,"ب",2,0],["يُحكِمُ التدبيرَ إحكام الذي","يقرَأُ الغيبَ ويدري ما طواهْ",38,"ا",2,0],["يحكي عصا موسى، إذا ألقيْتَهُ","ألْفيتَهُ فوق الصحيفة أرقما",39,"م",2,0],["يحكي لنا عن فلق الصباح","رقصتُه تدعو إلى المراح",40,"ح",1,0],["يحكمون الجموع والعدل يبكي","والمآسي تدمي سقوف المحاكم",41,"م",1,0],["يُحكِّمُ في الجُلَّى أغرُّ مُشَّهَرٌ","ويحْتاجُ في البلوى عذيقٌ مرَجَّب",42,"ب",1,0],["يحكين غزلان اللّوى العَواقدا","حاذرْ هَداك اللَّه أن تعاندا",43,"د",2,0],["يحكى الأثيرَ إذا أجرى تلاطمه","ابدى سواظع نور منه منبثق",44,"ق",1,0],["يحكى دم المظلوم ما زَجَ أدمعاً","هملت به عين اليتيم همولا",45,"ل",2,0],["يَحكُونَ حَسَّانَ إِن حَاكُوا قَوَافِيَهم","وفي السَّمَاحَةِ يَحكُونَ إبنَ مَحكَانِ",46,"ن",1,0],["يُحكَى له في المعالى كلُّ مأثُرةٍ","تُصبى القلوبَ وتُروَى عنه أخبارُ",47,"ر",1,0],["يَحكي القَضيبَ إِدا الصَبا مَرَّت بِهِ","حَرَكاتُهُ وَيَطولُهُ بِبُسوقِهِ",48,"ق",2,0],["يُحَكِّمُ في الذَخائِرِ سائِليهِ","وَيَمنَعُهُم مِنَ الأَسَلِ الطِوالِ",49,"ل",1,0],["يَحكي تَعَرُّضُهُ لَنا وَنِفارُهُ","وَالجيدُ وَالطَرفُ الكَحيلُ الريما",50,"م",2,0],["يحكي زفيري رعدُه ورياحُه","ووبله حاكى دموعي الوكفا",51,"ف",2,0],["يُحكِّمُ في أَعدائِهِ حدَّ سَيفِهِ","إِذا حُطِّمَت في الدّارِعينَ العَوامِلُ",52,"ل",1,0],["يحكُكنَ بالصَّخر أستاهاً بها نُقَبٌ","كما يَحُكُّ نِقابَ الجُربِ طالِيهَا",53,"ي",3,0],["يُحكِّم في الأُسْدِ أَلحاظَه","وتَلْقاهُ من راهبٍ يَرْهَب",54,"ب",1,0],["يحكى قَواريرَ ماءِ الوردِ خالطَه","فيها من الزعفرانِ المسك بالعسل",55,"ل",1,0],["يحكي خدودا ضرّجت","عن خجَل تحت الحدق",56,"ق",1,0],["يحكمُ الملاحُ على","الصدقِ أنهُ كذبُ",57,"ب",1,0],["يحكي خدودَ الملاح ثامِرُها","وأعينَ الغانيات نرجسُها",58,"س",3,0],["يحكي جنى النحل بالريق الرحيق وبال","خصر المهفهف او ساط الزنابير",59,"ر",1,0],["يحكي الغزالة حين يبدو طلعة","ويفوقها بالمقلة السوداء",60,"ا",2,0],["يحكي ويبكي وما علمي بِمَنْطقِه","من البكى وغرابُ البينِ نَعَّاقُ",61,"ق",1,0],["يحكي نوالَ ابنِ سلطان الذي افخترتْ","به العِباد وقد سادَ الذي سادا",62,"د",2,0],["يَحكي مِجَنّا مُطرِقاً وَجهَ الفَتى","مِنهُم وَقَد ظَهَروا بِهَذا الآنِ",63,"ن",1,0],["يَحكي وِصالَ الغائِباتِ وَفاؤُهُ","وَيُريكَ أَحلامَ الكَرى ميعادُهُ",64,"د",2,0],["يَحْكِي وَقَدْ رُصِعَتْ شَمْسُ اللُّجَيْنِ بِهِ","شَمْسَ الضُّحَى انْطَبَعَتْ في صَفْحَةِ الْقَمَرِ",65,"ر",1,0],["يَحْكِي مُحَيَّاهُ وَفَاحِمَ فَرْعِهِ","بَدْرُ الدُّجَى لَوْ كَانَ لَيْسَ بِآفِلِ",66,"ل",1,0],["يحكى ليُوثَ الغابِ في وَثَباتِها","وثباتِها لكن بغيرِ قِياسِ",67,"س",1,0],["يحكى أبوك ابن هندٍ في مكانته","وأنت بلقيس ثم الفضلُ للحاكي",68,"ك",2,0],["يحكي نداك بغيثه فإذا انجلى","فكأن وجهك ما انجلى من شمسهِ",69,"س",2,0],["يَحْكِي ثُرَيا أُسْرِجَتْ كَاسَاتُها","في جَمْعِهِ وَرِقاً إِلَى عِقْيانِ",70,"ن",1,0],["يحكي الظَّلامَ بشَعره","والصُّبحَ بالوجه المُنيرِ",71,"ر",1,0],["يَحكي القَضيبَ في الكَثي","بِ كُلَّما تَرَنَّحا",72,"ح",2,0],["يحكي السماء إذا أنوارُه لَمَعَتْ","برجاً ببرجٍ ونبراساً بنبراس",73,"س",1,0],["يَحكي لواءَ بني العبّاس يومَ وغىً","إذا بدا وجيوشُ التُّركِ في الأثَر",74,"ر",1,0],["يُحكِمُ أسبابَ النَّجاحِ جاهِدٌ","والنَّبعُ ما لم يُسعِدِ الجَدُّ غَرَب",75,"ب",1,0],["يَحكي كَما زَعموهُ ثَغر مُعَذِبي","هَيهات أَينَ رِضابِهِ وَالمَنطقُ",76,"ق",1,0],["يَحكيهِ بَدر التَمّ لا","في الحُسن بَل بُعد المَنال",77,"ل",1,0],["يَحكي أَبا الفَضلِ في تَفضُّلهِ","هَيهات أَن يَعتَزي إِلى شِيَمِه",78,"م",2,0],["يَحكي السَحابَ طُلوعُهُ فَصَهيلُهُ","مِن رَعدِهِ وَمَسيرُهُ من بَرقِهِ",79,"ق",2,0],["يَحكي الشَريف أَبا عليِّ جودِهِ","يَتَوَسَّم الوَسميُّ في سيماهُ",80,"ا",2,0],["يحكيك في الخُلقِ لا في الخُلُقِ أَكثرهم","وَرُبَّما شُبِّهَ الإِنسانُ بِالصَنَمِ",81,"م",1,0],["يَحكي النَبيَّ شَمائِلاً وَفَضائِلاً","مَن لَم يَكُن كأَبيه كانَ دَخيلا",82,"ل",2,0],["يَحكي جنا الأُقحوان الغضّ مَبسِمُها","في اللَون وَالريح وَالتَفليج وَالأَشَرِ",83,"ر",1,0],["يحكِّمُ مُشتَطَّ المُنى في نَواله","فتعجبُ من جَدوَى يديه المطامِعُ",84,"ع",1,0],["يُحكِّمٌ في مكارِمهِ الأمانِي","ولو كلّفْتَهُ ردّ الشّبابِ",85,"ب",1,0],["يحكِي الغزالَةَ والقضيبَ قَوامُه","ولِحاظُه وبَهاؤه ونِفَارُهُ",86,"ر",2,0],["يحكُمُ في أرواحِنا طَرْفُهُ","حكمَ أَبي الغَاراتِ في المَالِ",87,"ل",1,0],["يَحكي سَقيطُ الطلِّ في أرجائها","دُرَراً على أغصانها تَتَنَضَّد",88,"د",1,0],["يحكي لكم عن طعنه مخبرا","أعداءه ورمحه السمر",89,"ر",1,0],["يحكي العصا إن راح يب","تلعُ العصا لا بل أشدّا",90,"د",2,0],["يحكي المباردَ بالمتونِ وتارةً","كبطونِ حياتٍ على رمضاء",91,"ا",2,0],["يحكي نداه ولي مدائح فيكم","طبع كجودكم الذي منه الشفا",92,"ف",2,0],["يحكي أهازيجَ ما أبقى الغريض وما","صاغ ابن جامع في الألحان من طُرقِ",93,"ق",1,0],["يحكمُ في حظِّيَ ما شاءَ فإن","مرَّ بِعرضِي لم أكن مُحكَّما",94,"م",2,0],["يحكمُ في الناسِ على جهلهِ","في النَّفْس بالمُبْقي وبالقاتلِ",95,"ل",1,0],["يحكي بياض الطرس تحت سواده","أسرار صبح في صدور ليال",96,"ل",1,0],["يحكيه بدر التمّ والفضلُ","للمحكّي بعداً وسناً وانتقال",97,"ل",1,0],["يحكم في قلبي الهوى فيطيعهُ","وتدعو على شحط النوى فيجيبها",98,"ب",3,0],["يُحكى عَلَيها حينَ يَعلوها الحَبَب","نُجومَ دُرٍّ في سَماءٍ مِن ذَهَب",99,"ب",1,0],["يُحكى العِذارُ بِخَدِّهِ","لَيلاً تَحَيَّرَ في صَباحِ",100,"ح",1,0],["