Poem.aspx?id=50386",""],[100,"صدى","https://www.poetsgate.com/ViewPoem.aspx?id=50403",""],[100,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[90,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""],[99,"قطرة الندى","https://www.poetsgate.com/ViewPoem.aspx?id=570",""],[51,"ولقد مُنعتُ من المرافق كُلِّها","https://www.poetsgate.com/ViewPoem.aspx?id=30443",""],[51,"لم أتخذ منك غير متخَذِ","https://www.poetsgate.com/ViewPoem.aspx?id=28614",""],[51,"دَعِ الوقوفَ على الأطلال والدمَنِ","https://www.poetsgate.com/ViewPoem.aspx?id=30681",""],[105,"نبئت ما صنع الذين تألفوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54970&r=&rc=140",""],[105,"مدوا السواعد وارفعوا الأبصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54983&r=&rc=153",""],[75,"كَذبَ السلوُّ، العِشقُ أيسَرُ مركبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10785&r=&rc=5",""],[31,"نَعَقَ الغُرَابُ بِبَيْنِ ذاتِ الدُّمْلُجِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18811&r=&rc=74",""]],"verses":[["مَن ذا يَكونُ مُعَوِّضاً ما مَزَّقوا","وَمُعَوَّلا لِمُؤَمَّلٍ وَثِمالا",0,"ل",2,0],["من ذا يلبي؟ أما إصرار معتصم؟","كلا وأخزى من (الأفشين) ما صلبوا",1,"ب",3,0],["مَن ذا فَدَيتُكِ يَستَطيعُ لِحُبِّهِ","كَتماً إِذا اِشتَمَلَت عَلَيه ضُلوعُ",2,"ع",1,0],["مَن ذا يُعيرُكَ عَينَهُ تَبكي بِها","أَرَأَيتَ عَيناً لِلبُكاءِ تُعارُ",3,"ر",1,0],["مَنْ ذَا يَعُدُّ فَضَائِلَ الْفَشْتَالِي","وَالدَّهْرُ كَاتِبُ آيِهَا وَالتَّالِي",4,"ي",1,1],["مِنْ ذَا يُجِيدُ الْوَصْفَ مِنْكَ خَيَالُهُ","وَصِفَاتُ مَجْدِكَ فَوْقَ مَا يُتَخَيَّلُ",5,"ل",1,0],["مَنْ ذا يُعانِدُ منْكَ وارِثَهُ الذي","بسُعودِهِ فلَكُ المَشيئَةِ دائرُ",6,"ر",1,0],["مَنْ ذا يُواسي في أسىً حالَفْتُهُ","أمْ مَنْ يُعاني منْ جَوَى عانَيْتُه",7,"ت",2,0],["مَن ذا الَّذي هَذَّبَت خَلائِقُه","في رَثيَةٍ إِن أَتى وَفي عجلِه",8,"ل",2,0],["مَن ذا الَّذي بِإِخائِهِ وَبِوُدِّهِ","مِن بَعدِ وُدِّكَ أَو إِخائِكَ أَفرَحُ",9,"ح",1,1],["مَن ذا يُبَلِّغُني رَبي","عَةَ ثُمَّ لا يُنسى ثَوابُه",10,"ب",2,0],["مَن ذا يُواسيني وَيَكلَأُني","في هَذِهِ الدُنيا وَمَن يَرعى",11,"ع",2,0],["مَن ذا يُغيرُ عَلى الأُسودِ بِغابِها","أَو مَن يَعومُ بِمَسبَحِ التِمساحِ",12,"ح",1,0],["مَن ذا يُطيقُ لِبَعضِ ما","أَصلَحتَ أَو أَسدَيتَ عَدّا",13,"د",2,0],["مَن ذا يُناويكِ وَالأَقدارُ جارِيَةٌ","بِما تَشائينَ وَالدُنيا لِمَن قَهَرا",14,"ر",2,0],["مَن ذا يَقومُ مَقامَهُ","بَعدَ اِبنِ أُمّي إِذ رُمِس",15,"س",1,0],["مُنْذ أَقْبَلْتَ فؤادي","شَامَ سَعداً وَتَهَيَّا",16,"ي",2,0],["مَنْ ذَلَّ فَلْيُولِكَ مِنْ عُذْرِهِ","أَوْ عَزَّ فَلْيُولِكَ مِنْ حَمْدِهِ",17,"د",2,0],["مِنْ ذَلِكَ التِّمْثَالِ لاحَتْ لِلوَرَى","آيَاتُ أَيِّ حِجىً وَأَيُّ جَنَانِ",18,"ن",1,0],["مَنْ ذَا يَرُدُّ عَلَى البِلاَدِ وَأَهْلِهَا","عَهْدَ الوِئَامِ وَقُوَّةَ الإيمَانِ",19,"ن",1,0],["مِنْ ذَواتِ الخِصَالِ لا عَيْبَ فِيهَا","وَذَوَاتِ الكَمَالِ بَيْنَ الحَسَانِ",20,"ن",1,0],["مُنْذُ التقَينا لَمْ يُكَدِّرْ صَفْوَنَا","خُلْفٌ وَزَادَتْ وُدَّنَا الأعْوَامُ",21,"م",1,0],["مَن ذا يُناويهِ في مَناسِبِهِ","فَما اِستُ كَلبٍ يَرضى بِذا نَسَبا",22,"ب",2,0],["من ذي يفزع الكويتب","عد يفرح في ثياب",23,"ب",1,0],["منذ حزن من خلوا","السعود تجين باجمع",24,"ع",1,0],["من ذاق في الشعر طعم معجزه","فأحمد الشاعر الذي أكله",25,"ل",2,0],["من ذا يبدّله فإن قَوارعي","يئست لعمر الله من تبديله",26,"ل",2,0],["مَن ذا الَّذي ظَلَّ يَغلي أَن أَزورَكُمُ","أَمسى عَلَيهِ مَليكُ الناسِ غَضبانا",27,"ن",2,0],["مَن ذا نُحَمِّلُ حاجَةً نَزَلَت بِنا","بَعدَ الأَغَرِّ سَوادَةَ بنِ كِلابِ",28,"ب",1,1],["مَن ذا يُعِدُّ بَني غُدانَةَ لِلعُلى","وَالخَيرِ بَعدَ عَطِيَّةَ بنِ جِعالِ",29,"ل",1,1],["مَن ذا يَعُدُّ كَما أَعُدُّ","مِنَ الجُدودِ العالِيَه",30,"ي",2,0],["مَن ذا يَقومُ لِقَومِهِ","بَينَ الصُفوفِ مَقامِيَه",30,"ي",2,0],["مَن ذا يَرُدُّ صُدورَهُن","نَ إِذا أَغَرنَ عَلانِيَه",30,"ي",2,0],["مَن ذا يَعابُ بِما لَقي","تُ مِنَ الوَرى إِلّاكُما",31,"م",2,0],["مَن ذا الَّذي عِندَهُ رَحلي وَراحِلَتي","وَرِزقُ أَهلي إِذا لَم يُؤنِسوا المَطَرا",32,"ر",2,0],["من ذا يضاهي الشمس حسن فضيلة","وبها قوام العالم المتنوع",33,"ع",1,0],["من ذا لذا إرثاً وملكاً عن رضاً","لكمُ بهِ النعمى وللأعدا الشقا",34,"ق",2,0],["من ذا يجمِّع ما جمَّعت من شرفٍ","في الخافقين ومن يسعى كمسعاك",35,"ك",1,0],["منذ اشْتغلنا بتكرار الغرام بكم","لم ينس خوف دروس العهد ماضينا",36,"ن",2,0],["من ذا يراكَ وقد سلِمتَ فلا يرى","فيك الغِنى لا في اللُّجين ولا الذهبْ",37,"ب",1,0],["مِنْ ذَنَبانيٍّ تعدَّى طورَهُ","فاجتمع الذَّنْبُ عليه والذَّنَبْ",38,"ب",1,0],["من ذاقَهُ لم يختلج رأيُهُ","في أنه دمعٌ ولم يَرْتَبِ",39,"ب",1,0],["من ذا نُقيمُ مواقيتَ الصلاة به","حتى يقومَ على رغم الطواغيتِ",40,"ت",1,0],["من ذا رأتْ عيناه مثلي في الشَّجا","أهدى إليَّ النرجسُ البنفسَجا",41,"ج",2,1],["مَنْ ذَاكَ ذَاكَ الوائلي الذي","للشِّعْر في أوصافه سَبْحُ",42,"ح",1,0],["منْ ذا يُضَاهِي خالداً","في حلْمه وجلدِهْ",43,"د",2,0],["من ذا يعادي البدر أمسى منعِماً","نُعمَى عَفُوٍّ للذِّنوب جوادِ",44,"د",1,0],["من ذا تراه وإن تَوَقَّلَ في العلا","يسمو بهمَّتِه مَحَلَّ الفرقدِ",45,"د",1,0],["من ذا يعادي الغيث أم من ذا يُرَى","إلا من الحساد حين يُسادُ",46,"د",1,0],["من ذا يُضاهي خالداً","في صبره أو جلدِهْ",47,"د",2,0],["من ذا أحلّ لكم أن تهتكوا خَلَقي","وأن تمدُّوا على المعروف أستارا",48,"ر",2,0],["من ذَرةٍ ذرة جَرادقه","تخفى على العين فهْي مُلتمسَهْ",49,"س",2,0],["من ذاتها بالمنفساتِ نافسَهْ","نفسُ كريمٍ للعلا مُلامسه",50,"س",2,0],["من ذا تخيِّبُهُ فتطمع نفسُهُ","في رفد غيرِك آخرَ الأحراس",51,"س",1,0],["من ذَا يقومُ لخرطوم حُبيتَ به","إذا ضربتَ به قِرناً على الراس",52,"س",1,0],["من ذي رُعينٍ في الجماجم والذرى","أو ذي نواس الخير أو ذي فائِش",53,"ش",1,0],["من ذا تراه غدا يتّرِسُه","إِنْ وَتَرِي بالنَوافذِ انتفضا",54,"ض",2,0],["من ذا يساويكم أمن يقاربكم","في رحب أفنية أو لين أكناف",55,"ف",1,0],["من ذي تلاوين وشيُهُ حسن","ومن بهم الدجى ومن لهق",56,"ق",1,0],["من ذا يعد الحمد غيرك مغنماً","ويرى المواهب أفضل الإنفاق",57,"ق",1,0],["من ذا يعد النفل فرضاً واجباً","أو يجعل الميعاد كالميثاق",57,"ق",1,0],["من ذا تنصَّحتَ من ثقاتِك في","صرمي وماذا أطعتَ من ظننِك",58,"ك",1,0],["من ذا الذي لم يُبكه فقدُهُ","من حدثٍ غرّ ومن مُحتنِكْ",59