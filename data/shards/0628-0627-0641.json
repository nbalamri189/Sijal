{"poems":[[65,"لمن فتية منشورة وفراتها","https://www.aldiwan.net/poem46199.html","الطويل"],[37,"أفي رسم أطلال بشطب فمرجم","https://www.aldiwan.net/poem38832.html","الطويل"],[37,"فلولا الله ثم ندى ابن ليلى","https://www.aldiwan.net/poem39178.html","الوافر"],[32,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[47,"أدمع قد غرين بالهملان","https://www.aldiwan.net/poem66672.html","الخفيف"],[104,"قم حبيبي وأطفئ المصباحا","https://www.aldiwan.net/poem33110.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39585","المتقارب"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21121","الخفيف"],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[228,"إجرح القلب واسق شعرك منه","https://www.aldiwan.net/poem39702.html","الخفيف"],[234,"دليل على أن سوف يرديه ما لقي","https://www.aldiwan.net/poem50925.html","الطويل"],[236,"لمن طلل دون الربا والتنائث","https://www.aldiwan.net/poem44596.html","الطويل"],[275,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[287,"ذكرتك إذ شمت بالشام برقا","https://www.aldiwan.net/poem32694.html","المتقارب"],[287,"لقد كنت من وشك الفراق أليح","https://www.aldiwan.net/poem32832.html","الطويل"],[445,"هربنا إليكم فآويتمونا","https://www.aldiwan.net/poem34765.html","المتقارب"],[466,"له بالمجد أنس مطمئن","https://www.aldiwan.net/poem16135.html","الوافر"],[469,"ليهن الورى برء العلى والفضائل","https://www.aldiwan.net/poem3265.html","عموديه"],[505,"إلهي بنور الذات في القدم الأسمى","https://www.aldiwan.net/poem37803.html","الطويل"],[556,"رضينا من عدانك بالمطال","https://www.aldiwan.net/poem47296.html","الوافر"],[566,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[592,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126853","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122685","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86976","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54129","الوافر"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137722",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38985","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59722","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59557","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49064","الطويل"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128749","الوافر"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123306","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28047","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47095","الخفيف"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84866","المتقارب"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75946","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134119","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48286","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48344","الطويل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85261","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111504","الطويل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62142","الطويل"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198187","الطويل"],[4680,"على نَغَمات الريح","https://www.poetsgate.com/ViewPoem.aspx?id=190640",""],[4578,"خبا نور مصباح العلى والمكارم","https://www.poetsgate.com/ViewPoem.aspx?id=49523",""],[4578,"بأفق العز أشرق بدرُ سعدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49395",""],[4988,"جابتني الصدفة","https://www.poetsgate.com/ViewPoem.aspx?id=196637",""],[5183,"هو العيد","https://www.poetsgate.com/ViewPoem.aspx?id=180231",""],[5199,"رابطة عبس العالميه","https://www.poetsgate.com/ViewPoem.aspx?id=150974",""],[5206,"حجر الفلاسفة","https://www.poetsgate.com/ViewPoem.aspx?id=187417",""],[5252,"تذكار","https://www.poetsgate.com/ViewPoem.aspx?id=36107",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5397,"بآل محمدٍ عرف الصواب","https://www.poetsgate.com/ViewPoem.aspx?id=157900",""],[5596,"فقيد العلماء والأولياء","https://www.poetsgate.com/ViewPoem.aspx?id=206687",""],[243,"خيالك","https://www.poetsgate.com/ViewPoem.aspx?id=50484",""],[5720,"بأرضِ الأحمريِّ","https://www.poetsgate.com/ViewPoem.aspx?id=200096",""],[5732,"حنا من المعروف تندا يدينا","https://www.poetsgate.com/ViewPoem.aspx?id=177858",""],[5794,"غرور الشعر ..","https://www.poetsgate.com/ViewPoem.aspx?id=122796",""]],"verses":[["بأفيائِهِمْ قُبٌّ عناجيجُ تَرعَوي","إلَيهمْ لَدى أطنابِهِمْ مُهَراتُها",0,"ت",3,0],["بِأَفضَلَ سَيباً مِنكَ بَل لَيسَ كُلَّهُ","كَبَعضِ أَيادي سَيبِكَ المُتَقَسَّمِ",1,"م",1,0],["بِأَفضَلَ نائِلًا مِنهُ إِذا ما","تَسامى الماءُ فانغَمَسَ الرَوابي",2,"ب",2,0],["بِأَفضَلَ في البَرِيَّةِ مِن بِلالٍ","إِذا مَيَّلتَ بَينَهُما مَيالا",3,"ل",2,0],["بِاِفتِراقٍ أَلَمَّ بَعدَ إِجتِماعٍ","وَتَناءٍ أَقامَ بَعدَ تَدانِ",4,"ن",1,0],["با فَلا تَقل كَيفَ لاحا","قُم حَبيبي وَأَطفئ المِصباحا",5,"ح",2,0],["بأفئدةٍ مثلما عَرْبَدَتْ","يَدُ الريح في ورقاتِ الشجَرْ",6,"ر",1,0],["بِإِفَالٍ عشرينَ قَحَّمَهَا الصَّع","ب بِحُسنِ الإِخاء والخلاَّنِ",7,"ن",1,0],["بأفواهكم أفتيتم لا خطوطكم","تخافون ان تقرا الخطوط فتثلبوا",8,"ب",3,0],["بِأَفواهِهِم فَفيها شُرورُ","وَحُلوقُ الوَرى قُبورٌ وَلَمّا",9,"م",2,0],["بإفضالِ كَفٍّ دونها كُلّ مُفْضِلٍ","وإِشراقِ وجهٍ دونَه كُلُّ مُشْرِق",10,"ق",1,0],["بأفضل مبعوث إلى خير أمةٍ","بخير كتاب جاء من خير باعث",11,"ث",1,0],["بأفتكِ جُندٍ راعَ أضعفَ أُمّةٍ","فما كان إِلا أزرَقَ العينِ أبترا",12,"ر",2,0],["بِأَفتَكَ مِن بِأسِهِ وَالكماةُ","تُماصِعُ طَعناً وَضَرباً وَرَشقا",13,"ق",2,0],["بِأَفتَكَ مِنهُ وَالكُماةُ مخالِطٌ","دِماءَهُم فَوقَ الجُسومِ مُسيحُ",14,"ح",1,0],["بأَفْرَحِ بُشْرَى تَسُرُّ النُّفوسَ","وأَعْظَمِ فَضْلٍ يُقِرُّ العُيونا",15,"ن",2,0],["بأفْواهِ المُلوكِ لِراحَتَيْهِ","من التَّقْبيلِ في النَّادي عِطارُ",16,"ر",1,0],["بأفقك نجمي في العلى غير آفل","ورأي حصيف في النهى غير فائل",17,"ل",1,0],["بأَفئدَةٍ طارتْ إليكَ بصِدقِها","وما عَلِقَتْ سَلْمَى ولا عَشِقَتْ أَسْمَا",18,"م",2,0],["بأفئدةٍ إذا اِحتَربوا رِزانٍ","وأيمانٍ وأقدامٍ عجالِ",19,"ل",1,0],["بِافكِهِ حَتّى رَأَى الصُبحَ جَشَر","عَن ذي قَداميسَ لُهامٍ لَو دَسَر",20,"ر",1,0],["بإفتائه أن الطلاق إذا أتى","ثلاثاً بلفظ واحد غير كامل",21,"ل",1,0],["بأفق سما العلياء شهباً تطالَعوا","وآية العُظمى غدى بدرها التمُّ",22,"م",1,0],["بأفَضَّ مِن قَلبِ المُشَقَّرِ قَسوةً","وأرَقَّ مِن نَفَسِ النَّسيمِ والطفِ",23,"ف",1,0],["بِأَفراح عُثمان الَّذي في خِتانه","صَفا الوَقت وَالمَهجور بِالوَصل أَسعَفا",24,"ف",2,0],["بأفئدةٍ لما نخشى مراضٍ","ونياتٍ لما نرجو صحاحِ",25,"ح",1,0],["بأفعالنا لا بأقوالنا","سيذكرنا الناس في ما عنى",26,"ن",2,0],["بِأَفضَلِهم طرّاً حبيبك أَحمدٍ","أَجلِّ رَسولٍ جاءَ بِالحقِّ وَالرّشدِ",27,"د",1,0],["بأفئدة عزُّ الثبات أفادَها","مجيباً إلى داعي الجهاد سميعا",28,"ع",2,0],["بأفئدة لا يستقرُّ قرارُها","وهل بمثال النقع تهدأ ريح",29,"ح",1,0],["بأُفقِ التُّقى والِّين أَشرقَ كوكبٌ","له من سناءِ النِّيراتِ مطارفُ",30,"ف",1,1],["بافيد ابهر النسمات لطفاً","وراع شقايق النعمان خدا",31,"د",2,0],["بافتقاري بانكساري","بخضوعي لك دلاً",32,"ل",2,0],["بأفعل وبأفعال وأفعلة","وفعلة تجمع الأدنى من العدد",33,"د",1,1],["بافْتقارٍ منّا وذُلٍّ أَتَيْنَا","ما لنا عِزَّةٌ ولا استغناء",34,"ا",2,0],["بِأُفق الأَماني تَجلى التَهاني","بِمَولد نجل تبدى سَعيدا",35,"د",2,1],["بِأَفتكَ مِنهُ حينَ يَرنُو بِمُقلَةٍ","تُريكَ الرِضى وَالمَوتُ فيهِ مُلابِسُه",36,"س",2,0],["بأفراح تأهيل التهاني سرورنا","وصفو كمال الأنس قد أذهب الحزن",37,"ن",1,1],["بأفْعالِكَ الغُرِّ الكريمةِ يُقْتَدَى","فجمْعُ المَعالِي منكَ في العالَمِ الفَرْدِ",38,"د",1,0],["بأفْئِدةٍ لا يستَقِرُّ قَرارُها","وهل بمُثيرِ النّقْعِ تهْدأُ ريحُ",39,"ح",1,0],["بِأفعَلَ انطِق بَعدَ مَا تَعَجُّبَا","أو جِىء بِأفعِل قَبلَ مَجرُورٍ بِبَا",40,"ب",2,0],["بأفضل دينٍ للشرائع ناسخ","ولا يعتريه النسخ ما دام يذبل",41,"ل",1,0],["بإفريجيا بيعت وأرض ميونةٍ","على حين عنا زفس منتقما صدا",42,"د",2,0],["بأفواههم منا جنى النحل كلما","رووها وفي أستاهكم إبر النحل",43,"ل",1,0],["بأُفقِ التَهاني كَوْكَبُ السَّعْدِ قَدْ بَدا","وَطَيْرُ الهَنا في عيدِ ((زائِدَ)) غَرَّدَا",44,"د",2,1],["بآفاقه لاحت تباشير ثورةٍ","سيأتي بها من مطلع الفجر قادمُه",45,"م",2,0],["بأفق بنى البربير قد لاح نوره","ينير دجاليل من الخطب فاحم",46,"م",1,0],["بأفق العز أشرق بدرُ سعدٍ","ينير معالم العليا برشدِ",47,"د",1,1],["بافكاري اللي ما تخيّب ظنوني","أقدر أسوّي لا بغيت العجايب",48,"ب",1,0],["بأفلاكها سعد السعود مفيئة","بشأو عليّ أرضه وسماؤه",49,"ا",3,0],["بافريقياء والارض ماحلوبه غير الزحول","اهل الشيم واهل الزعامة سلم والا فى نكد",50,"د",1,0],["بِأُفقِ الشَّرقِ أنتَ بِهِ وَإنِّي","بِأُفقِ الغَربِ تَهجُرنِي مَلِيَّا",51,"ي",2,0],["بافراق تالي أنتهت الأخبار","عشرة حياتي اليوم ماضيها",52,"ي",3,0],["بأفعال له وحده فيها","وبالأفعال منك بلا اختلال",53,"ل",1,0],["بآفاق العلى عرجوا صعوداً","وفي أبياتهم نزل الكتاب",54,"ب",1,0],["بأفولٍ لشمس علم وفضل","لوليٍّ خِلالُه أضواء",55,"ا",2,0],["بأفيائه تحلم الذكريات","ويشدو الخيال ويسترسل",56,"ل",1,0],["بأفعالٍ يجودُ بها كرامٌ","تتوقُ لها عيونُ الناظرِينا",57,"ن",2,0],["بافعالنا نرسم دروب ٍ للاجيال","إلي نساها غيرنا ما نسينا",58,"ن",2,0],["بافرش ضلوعي سعاده / لك وأحساسي .. نضيد","والغلا دله هوانا / من فناجيل .. الغرام",59,"م",1,0]]}