{"poems":[[63,"لمن فتية منشورة وفراتها","https://www.aldiwan.net/poem46199.html","الطويل"],[35,"أفي رسم أطلال بشطب فمرجم","https://www.aldiwan.net/poem38832.html","الطويل"],[35,"فلولا الله ثم ندى ابن ليلى","https://www.aldiwan.net/poem39178.html","الوافر"],[30,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[45,"أدمع قد غرين بالهملان","https://www.aldiwan.net/poem66672.html","الخفيف"],[102,"قم حبيبي وأطفئ المصباحا","https://www.aldiwan.net/poem33110.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39585","المتقارب"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21121","الخفيف"],[160,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[223,"إجرح القلب واسق شعرك منه","https://www.aldiwan.net/poem39702.html","الخفيف"],[229,"دليل على أن سوف يرديه ما لقي","https://www.aldiwan.net/poem50925.html","الطويل"],[231,"لمن طلل دون الربا والتنائث","https://www.aldiwan.net/poem44596.html","الطويل"],[270,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[282,"ذكرتك إذ شمت بالشام برقا","https://www.aldiwan.net/poem32694.html","المتقارب"],[282,"لقد كنت من وشك الفراق أليح","https://www.aldiwan.net/poem32832.html","الطويل"],[439,"هربنا إليكم فآويتمونا","https://www.aldiwan.net/poem34765.html","المتقارب"],[461,"له بالمجد أنس مطمئن","https://www.aldiwan.net/poem16135.html","الوافر"],[464,"ليهن الورى برء العلى والفضائل","https://www.aldiwan.net/poem3265.html","عموديه"],[500,"إلهي بنور الذات في القدم الأسمى","https://www.aldiwan.net/poem37803.html","الطويل"],[551,"رضينا من عدانك بالمطال","https://www.aldiwan.net/poem47296.html","الوافر"],[561,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[587,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"]],"verses":[["بأفيائِهِمْ قُبٌّ عناجيجُ تَرعَوي","إلَيهمْ لَدى أطنابِهِمْ مُهَراتُها",0,"ت",3,0],["بِأَفضَلَ سَيباً مِنكَ بَل لَيسَ كُلَّهُ","كَبَعضِ أَيادي سَيبِكَ المُتَقَسَّمِ",1,"م",1,0],["بِأَفضَلَ نائِلًا مِنهُ إِذا ما","تَسامى الماءُ فانغَمَسَ الرَوابي",2,"ب",2,0],["بِأَفضَلَ في البَرِيَّةِ مِن بِلالٍ","إِذا مَيَّلتَ بَينَهُما مَيالا",3,"ل",2,0],["بِاِفتِراقٍ أَلَمَّ بَعدَ إِجتِماعٍ","وَتَناءٍ أَقامَ بَعدَ تَدانِ",4,"ن",1,0],["با فَلا تَقل كَيفَ لاحا","قُم حَبيبي وَأَطفئ المِصباحا",5,"ح",2,0],["بأفئدةٍ مثلما عَرْبَدَتْ","يَدُ الريح في ورقاتِ الشجَرْ",6,"ر",1,0],["بِإِفَالٍ عشرينَ قَحَّمَهَا الصَّع","ب بِحُسنِ الإِخاء والخلاَّنِ",7,"ن",1,0],["بأفواهكم أفتيتم لا خطوطكم","تخافون ان تقرا الخطوط فتثلبوا",8,"ب",3,0],["بِأَفواهِهِم فَفيها شُرورُ","وَحُلوقُ الوَرى قُبورٌ وَلَمّا",9,"م",2,0],["بإفضالِ كَفٍّ دونها كُلّ مُفْضِلٍ","وإِشراقِ وجهٍ دونَه كُلُّ مُشْرِق",10,"ق",1,0],["بأفضل مبعوث إلى خير أمةٍ","بخير كتاب جاء من خير باعث",11,"ث",1,0],["بأفتكِ جُندٍ راعَ أضعفَ أُمّةٍ","فما كان إِلا أزرَقَ العينِ أبترا",12,"ر",2,0],["بِأَفتَكَ مِن بِأسِهِ وَالكماةُ","تُماصِعُ طَعناً وَضَرباً وَرَشقا",13,"ق",2,0],["بِأَفتَكَ مِنهُ وَالكُماةُ مخالِطٌ","دِماءَهُم فَوقَ الجُسومِ مُسيحُ",14,"ح",1,0],["بأَفْرَحِ بُشْرَى تَسُرُّ النُّفوسَ","وأَعْظَمِ فَضْلٍ يُقِرُّ العُيونا",15,"ن",2,0],["بأفْواهِ المُلوكِ لِراحَتَيْهِ","من التَّقْبيلِ في النَّادي عِطارُ",16,"ر",1,0],["بأفقك نجمي في العلى غير آفل","ورأي حصيف في النهى غير فائل",17,"ل",1,0],["بأَفئدَةٍ طارتْ إليكَ بصِدقِها","وما عَلِقَتْ سَلْمَى ولا عَشِقَتْ أَسْمَا",18,"م",2,0],["بأفئدةٍ إذا اِحتَربوا رِزانٍ","وأيمانٍ وأقدامٍ عجالِ",19,"ل",1,0],["بِافكِهِ حَتّى رَأَى الصُبحَ جَشَر","عَن ذي قَداميسَ لُهامٍ لَو دَسَر",20,"ر",1,0],["بإفتائه أن الطلاق إذا أتى","ثلاثاً بلفظ واحد غير كامل",21,"ل",1,0]]}