70162","الكامل"],[4428,"","https://poetry.dctabudhabi.ae/diwan/poem/124622","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72469","المجتث"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120496","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139595",""],[4691,"بهجة العيد هويفا عندكم","https://www.poetsgate.com/ViewPoem.aspx?id=59590",""],[4750,"بهجة الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=180425",""],[4791,"الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=35555",""],[5111,"أَرِيج","https://www.poetsgate.com/ViewPoem.aspx?id=212319",""],[5194,"عفة الزين","https://www.poetsgate.com/ViewPoem.aspx?id=32718",""],[592,"بهجر أضاء الفجر واستعلن الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128846",""],[5376,"لستُ عنه من أنسِه ببعيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=191853",""],[5431,"ونمحو حزنه محوا","https://www.poetsgate.com/ViewPoem.aspx?id=195111",""],[5618,"عشق مقيد..","https://www.poetsgate.com/ViewPoem.aspx?id=208974",""],[5659,"بهجر الحبيب تكون الكروب","https://www.poetsgate.com/ViewPoem.aspx?id=200458",""],[5722,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12685",""],[469,"محيّكِ أحيا الوجدَ بل اتلفَ الصبّا","https://www.poetsgate.com/ViewPoem.aspx?id=76783",""],[5956,"فانوسُ أبي و(جلّ)* الصَّبي","https://www.poetsgate.com/ViewPoem.aspx?id=184561",""],[6004,"جَنَّةٌ للنِّسَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=59595",""],[6102,"قولي: ( ظلمته )","https://www.poetsgate.com/ViewPoem.aspx?id=182747",""],[5309,"غردي كالبلبل استحلى الصباح","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573857",""],[6225,"محِبٌّ . . وليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80919&r=&rc=188",""]],"verses":[["بهِ جمَعَ اللهُ القُلوبَ على الهُدَى","وأذْهَبَ ما تُخْفي الصّدورُ منَ الحِقْدِ",0,"د",1,0],["بَهِجَ الرَبيعُ لَها فَجادَ نَباتُها","وَنَمَت بِأَسحَمَ وابِلٍ هَطّالِ",1,"ل",1,0],["بِهَجرِ سُيوفِكَ أَغمادَها","تَمَنّى الطُلى أَن تَكونَ الغُمودا",2,"د",2,0],["بِهِ جُمِعَ الشَملُ الشَتيتُ وَفُرِّقَت","عَباديدَ في القَومِ اللُهى وَالنَوافِلُ",3,"ل",1,0],["بِهِ جَمَعَ اللَهُ التَشَتُّتَ مِنكُمُ","كَما جَمَعَت ريحٌ جَهاماً مُبَدَّدا",4,"د",2,0],["بِهِ جَلا الفِتنَةَ العَمياءَ فَاِنكَشَفَت","كَما جَلا الصُبحُ عَنهُ اللَيلَ فَاِنسَفَرا",5,"ر",2,0],["بَهَجَ الجَميعُ بِكَ اِبتِهاجَ الأَرضِ في","مَحلٍ بِإِطلاقِ الحَيا المُتَوَقِّفِ",6,"ف",1,0],["بَهِجٌ بتأييدِ الإلهِ ونَصرِهِ","صَبٌّ إليكَ مُوَلَّعٌ بشجونه",7,"ن",2,0],["بِهِ جُرحٌ مِنَ الرُمحِ المُذَكّى","وَلَيسَ بِهِ مِنَ المَأثورِ جُرحُ",8,"ح",1,0],["بَهِجتَ بِفَرعٍ لا ثَباتَ لِأَصلِهِ","فَفيمَ تُلاحي أَو عَلامَ تُشاجِرُ",9,"ر",1,0],["بَهَجٌ في كنوزها","للمحبِّينَ مُدّخَرْ",10,"ر",1,0],["بِهِ جِيَفُ الحَسْري يَلُوحُ صَلِيبُهَا","كما لاَحَ كتّانُ التِّجَارِ الموَضَّعُ",11,"ع",1,0],["به جمع الحجا للعلمِ شَمْلاً","فبُدِّد بعده للعلم شمل",12,"ل",1,0],["بهِ جنَّة ٌ منْ صبوة ٍ لعبتْ بهِ","وَقَدْ كَانَ لاَ يَصْبُو غُلاَماً مُشَبَّبَا",13,"ب",2,0],["بهجة القلب جلاء البصرِ","هذه الأرياف غِب المَطَرِ",14,"ر",1,1],["به جميعي مغرم","من عهد ما قالوا بلى",15,"ل",2,0],["به جثة العرفان صح نظامها","وروح معانيه انطوت في ضلوعها",16,"ع",3,0],["بهجوا على الأبصار بهجةَ يُوسفٍ","ويضيء داودُ بهِ المحرابا",17,"ب",2,0],["بهجةٌ في نضارةٍ في رواءِ","أعربت عن جمالِ هذا البناءِ",18,"ا",2,1],["بَهجَةُ أَعيادِنا بَقاؤُكَ مَح","روساً فَبُقّيتَ ما بَقيَ الأَبَدُ",19,"د",1,0],["به جمع الله القلوبَ على الهدى","ولولاه لم يُعلم توثبُ ناعق",20,"ق",1,0],["بهجرها ارخصت قتلي ووجنتها","تسعرت نارها في مهجتي وغلت",21,"ت",1,0],["به جلق الفيحاء بالأمن اينعت","واضحت بها الغيد الاوانس ترتع",22,"ع",1,0],["به جاد دهر لا يجود فكنتم","أضنّ من الدهر المبخّل بالرفد",23,"د",1,0],["بهجة العزّ في محيّاه لاحت","بوقارٍ وهيبةٍ واحتشام",24,"م",1,0],["بهجة الحسن كَم من","عاكِف في قباها",25,"ا",3,0],["بهجرهم كم وَكَم فلَّ الهوى أمماً","وردَّ صَدراً على عَجزٍ بهجرِهمِ",26,"م",1,0],["بِهَجلٍ مِن قَساً ذَفرِ الخُزامى","تَداعى الجِربِياءُ بِهِ الحَنينا",27,"ن",2,0],["بَهجة النادي بِمَن زين بِهِ","وَلقاهُ فَهُما أَبهى الجنانِ",28,"ن",1,0],["بهج الجود فهو يعلي ويغلي","بعطاياه قاصداً وقصيدا",29,"د",2,0],["به جِنَّةٌ فيه وبي فضلُ جِنَّةٍ","كلانا على عِلاتِه كالمُوَخَّذِ",30,"ذ",1,0],["بهِجٌ يكلّفُكَ السّجودَ صَعيدُه","شوقاً للَثْمِ مباسِمِ الحصباءِ",31,"ا",2,0],["بهِ جاءَتِ الأخبارُ نَصًّا وَظَاهِراً","وَجَاءَ بِهِ نَصُّ الْكِتاِ مُرَدِّدا",32,"د",2,0],["بهجةُ المَلكِ المُفَدَى","فَضلُه جاوزَ عَدَّا",33,"د",2,0],["بِهجوِكَ يَا بيَازُ أُرضِي أحِبَّتي","ولكنَّ شِعري عندَ ذكرِكَ يَسخَطُ",34,"ط",1,1],["بهجة النور بعد وقت الكسوفِ","فتعجب لواصف موصوفِ",35,"ف",1,1],["بهِ جُمِعَت كلّ المواعظ فاِهتدت","بهِ الناس إذ حازت لخير ثوابِ",36,"ب",1,0],["بِهجَة العارفين خَير بَنيه","أَنجُم السَعد وَالمَقال القَويم",37,"م",1,0],["بهج القلب ذكرك العذب لكن","هاج فيه من غلتي ما هاجا",38,"ج",2,0],["بَهجةُ الوقتِ تحفةُ الدّهرِ فَرداً","مَنهَجُ القصدِ رَوضةُ الأدباءِ",39,"ا",2,0],["به جاء جبريل من ذي الجلالِ","ولا زال جبريلُ روحاً أمينا",40,"ن",2,0],["بِهِ جَاهُنَا بَاقٍ إلَى آخِرِ الْمَدى","يَدَاهُ سَحَابٌ جُودُهَا طَيِّبُ النَّدى",41,"د",2,0],["بِهِ جِنَّةٌ أوْ مِنْهُ وَهْمٌ يُشَعْبِذُ","أَحِنُّ إلَى ذَاكَ الْجَنَابِ وَتُرْبِهِ",42,"ه",1,0],["بِهَجْرِي عَلَ وَصْلي يُرى مُتَمَنِّعَا","وَلَمَّا رَأَيْتُ الْقَلْبَ بَاتَ مُوَجَّعَا",43,"ع",2,0],["بِهَجْرٍ وَلاَ وَصْلٍ يُبَرِّدُ غُلَّتي","فَوَاحَسْرَتي حَتى أَمُوتَ بِحَسْرَتي",44,"ي",1,0],["بهَج المحيَّا طيب الملقى","رفيعُ المرتقى متيمَّن الحركات",45,"ت",1,0],["بهجة للأذنِ والعينِ فما","طرش يحدث فيه أو غمشْ",46,"ش",1,0],["بهِجٌ طلق المحيَّا","وافر الفضل مديد",47,"د",1,0],["بهجر سليمةَ مَرَّ السنيحُ","فلم تدرِ ما قال إذ يَنعَبُ",48,"ب",1,0],["به جذب العنان جوادُ فهمٍ","زجاه الفيض والنظر السديد",49,"د",1,0],["به جوائز عندي قد حكمت لها","مع الفصاحة أني لا أجازيها",50,"ي",3,0],["بِهِجْرانِها يَسْطو على جِسْميَ الضَّنى","وبابْنِ مُعزِّ الدِّينِ أَسْطو على المَحْلِ",51,"ل",1,0],["بهج يميس غضاضةً وبضاضةً","غَنِجٌ يتيهُ تَدلُّلاً وتَطَرُّفا",52,"ف",2,0],["بهجة المحفل زين الشعراء","أعذب المقول منطيقٌ خطيب",53,"ب",1,0],["بهِ جهاتي الستُّ مشغولةٌ","وهو الى غيري بها مائلُ",54,"ل",1,0],["بهجٌ الرداءِ إذا تبسَّمَ ضاحكاً"