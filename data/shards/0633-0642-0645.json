{"poems":[[75,"الهوى في طلوع تلك النجوم","https://www.aldiwan.net/poem11917.html","الخفيف"],[74,"كم عذول على هواك أداجي","https://www.aldiwan.net/poem18451.html","الخفيف"],[74,"حاشاك من وحشة تحت الثرى وجلا","https://www.aldiwan.net/poem20546.html","البسيط"],[87,"كل حي على المنية غادي","https://www.aldiwan.net/poem62901.html","الخفيف"],[87,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[87,"إلام الخلف بينكم إلاما","https://www.aldiwan.net/poem63744.html","الخفيف"],[47,"ما على الركب من وقوف الركاب","https://www.aldiwan.net/poem10646.html","الخفيف"],[47,"ولقد قال طبيبي","https://www.aldiwan.net/poem65558.html","مجزوء الرمل"],[68,"سفح المزاج على حميا الكاس","https://www.aldiwan.net/poem38490.html","الكامل"],[46,"لا نالك العثر من دهر ولا زلل","https://www.aldiwan.net/poem30383.html","البسيط"],[83,"قمر السما يبليي الثياب وأنت يا","https://www.aldiwan.net/poem61315.html","الكامل"],[83,"وافى وفي جيده عقد من الدرر","https://www.aldiwan.net/poem61359.html","البسيط"],[52,"من أبي هشام يا رجال قصيدة","https://www.aldiwan.net/poem64740.html","الكامل"],[70,"صد حمى ظمئي لماك لماذا","https://www.aldiwan.net/poem1495.html",""],[70,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43855","البسيط"],[141,"ولقد قال طبيبي وطبيبي","https://www.aldiwan.net/poem67957.html","مجزوء الرمل"],[189,"هجر العذول وراح طوع غواته","https://www.aldiwan.net/poem14131.html","الكامل"],[203,"علم الله أنني بك صب","https://www.aldiwan.net/poem45556.html","الخفيف"],[276,"قف بذات السفح من اضم","https://www.aldiwan.net/poem52088.html","المديد"],[287,"بأبي الريم الذي مر بنا","https://www.aldiwan.net/poem32406.html","الرمل"],[287,"سقم جسم أعداه طرف سقيم","https://www.aldiwan.net/poem32441.html","الخفيف"],[308,"يا لقومي سألتكم خبروني","https://www.aldiwan.net/poem58118.html","الخفيف"],[412,"نفسي الفِداء لِلحظِها من رامِ","https://www.aldiwan.net/poem50116.html","الكامل"],[415,"لا تفسدن نصيحتي بشقاق","https://www.aldiwan.net/poem32258.html","الكامل"],[443,"حتام تقطع بالقطيعة والجفا","https://www.aldiwan.net/poem2551.html","الكامل"],[463,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[469,"ثنت الشمول من الشمائل","https://www.aldiwan.net/poem3447.html","عموديه"],[469,"قسماً لقد أملى أحاديث الغضا","https://www.aldiwan.net/poem3531.html","عموديه"],[469,"لا تلمني فليس يجدي الملام","https://www.aldiwan.net/poem3627.html","عموديه"],[505,"ما بال قوم ترى للغير مقدرة","https://www.aldiwan.net/poem38007.html","البسيط"],[518,"أشكو عليل فؤاد أنت متلفه","https://www.aldiwan.net/poem67680.html","البسيط"],[519,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[520,"سقم الحاظ الحسان الخرد","https://www.aldiwan.net/poem12081.html","الرمل"],[563,"سق مطاياك بالحدا يا حادي","https://www.aldiwan.net/poem34596.html","الخفيف"],[567,"نهنه دموعك أيها الباكي فما","https://www.aldiwan.net/poem52751.html","الكامل"],[580,"خانت جفوني لما لم تفض بدمي","https://www.aldiwan.net/poem2780.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138435",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122709","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122705","الكامل"],[686,"","https://poetry.dctabudhabi.ae/diwan/poem/144929","الخفيف"],[686,"","https://poetry.dctabudhabi.ae/diwan/poem/144928","الرجز"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34419","الطويل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34432","البسيط"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122379","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59594","الكامل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/74006","البسيط"],[1491,"","https://poetry.dctabudhabi.ae/diwan/poem/107309","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79866","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108892","البسيط"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95306","الخفيف"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121191","البسيط"],[2449,"","https://poetry.dctabudhabi.ae/diwan/poem/115403","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76008","الطويل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122503","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201429","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201325","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202880","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203483","السريع"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118830","المديد"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65325","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86241","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66473","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91759","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132167","الوافر"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132105","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40065","الرمل"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143842","الخفيف"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101390","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54381","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33735","السريع"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141685","الكامل"],[4717,"سحر العيون","https://www.poetsgate.com/ViewPoem.aspx?id=199597",""],[4955,"رحلت وكنت لي وطنا","https://www.poetsgate.com/ViewPoem.aspx?id=195079",""],[5277,"حديث الأزرار","https://www.poetsgate.com/ViewPoem.aspx?id=185311",""],[5277,"مزاميرُ الإلتياع","https://www.poetsgate.com/ViewPoem.aspx?id=195140",""],[307,"العيون الملاح","https://www.poetsgate.com/ViewPoem.aspx?id=214158",""],[5376,"الدهرُ أمتعنا بالرود والغيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=188404",""],[5377,"إلى الغاضبين علينا","https://www.poetsgate.com/ViewPoem.aspx?id=61899",""],[5704,"أضداد الدنيا ...","https://www.poetsgate.com/ViewPoem.aspx?id=198740",""],[5759,"مُسَهِّدَتي","https://www.poetsgate.com/ViewPoem.aspx?id=213782",""],[5956,"أنا وشقيقي والحمامة","https://www.poetsgate.com/ViewPoem.aspx?id=184560",""],[6069,"من لصبٍ مسه فرط الكمد","https://www.poetsgate.com/ViewPoem.aspx?id=105660",""],[6070,"ذئب الابواب","https://www.poetsgate.com/ViewPoem.aspx?id=187880",""],[6213,"القَدَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76315&r=&rc=63",""],[6259,"نفسي الفداءُ للحظها من رام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59400&r=&rc=48",""]],"verses":[["سَقَمٌ لا أُعادُ في وَفي العائِدِ","أُنسٌ يَفي بِبُرءِ السَقيمِ",0,"م",1,0],["سقمٌ ثابتٌ وعقلٌ شريدٌ","طالما احْتجت فيهما للعلاج",1,"ج",1,0],["سقم ملكت به معنى النحول فإن","جاءَ الخلال بسقمٍ جاءَ منتحلا",2,"ل",2,0],["سَقَمٌ مِن سَلامَةٍ وَعَزاءٌ","مِن هَناءٍ وَفُرقَةٌ مِن وِدادِ",3,"د",1,0],["سَقِمَت شَمسُهُم فَرَدَّ عَلَيها","نورَها كُلُّ ثاقِبِ الرَأيِ نَطسِ",4,"س",1,0],["سَقِمتَ فَلَم تَبِت نَفسٌ بِخَيرٍ","كَأَنَّ بِمُهجَةِ الوَطَنِ السَقاما",5,"م",2,0],["سَقَمٌ دونَ أَعيُنٍ ذاتِ سُقمٍ","وَعَذابٌ دونَ الثَنايا العِذابِ",6,"ب",1,0],["سَقَمُ الحُبِّ رَخيصٌ","وَدَواءُ الحُبِّ غالِ",7,"ل",1,0],["سَقِمَت بِهِ مُهَجُ العُداةِ وَطالَما","سَقِمَ الزَمانُ وَكانَ نِعمَ الآسي",8,"س",2,0],["سُقمٌ أُتيحَ لَهُ بُرءٌ فَذَعذَعَهُ","وَالرُمحُ يَنآدُ حيناً ثُمَّ يَعتَدِلُ",9,"ل",1,0],["سَقِم الفُؤادُ لِسُقمِهِنَّ ورُبَّمَا","أعدى الصَّحِيح مِن السِّقَامِ سِقَامُ",10,"م",1,0],["سُقمي بُكائِي عَنَائي لَوعَتِي حَرقِي","وَجدِي غَرَامي هُيَامِي فِكرَتِي سَهَرِي",11,"ر",2,0],["سُقمي عُبَيدَةُ إِن سَقُمتُ وَصِحَّتي","وَلَها تَطيبُ لِنَفسي الخَلَواتُ",12,"ت",1,0],["سَقَمٌ أَلمّ به فآلم إذ رأى","بالجِسْمِ مِنْ اغدادهِ اغذاذا",13,"ذ",2,0],["سَقَمِي مِنْ سُقْم أجفانِكُمُ","وبِمَعْسُول الثّنايا لي دُوَيْ",14,"ي",1,0],["سقْم تشف به الضلوع كانها","قطع الزجاج بمائل الجدران",15,"ن",1,0],["سُقمٌ وَنَزفٌ أَبانَ عِندي","في ذا وَذا عَجزُ كُلِّ آسِ",16,"س",1,0],["سَقَمُ الحُبِّ رَخيصٌ","وَدَواءُ الحُبِّ غالي",17,"ل",2,0],["سقَمى يُثبِّت ما ادّعَتْه جفونهُ","سَلْني فإني من ثِقاتِ رُواته",18,"ت",2,0],["سقمي قاتلي وأنتَ طبيبي","ما لسقمي سوى رضائكَ طِبُّ",19,"ب",1,0],["سقمي في الحب عافيتي","وَوجودي في الهَوى عدمي",20,"ي",1,0],["سُقمُ جَفنَيهِ بِهِ أَسقَمَني","وَضَنى الخَصرِ بِهِ ذُبتُ ضَنى",21,"ن",2,0],["سُقمُ جِسمٍ أَعداهُ طَرفٌ سَقيمُ","وَالهَوى داؤُهُ عَذابٌ أَليمُ",22,"م",1,1],["سقم زائدٌ ودمعٌ وسهدٌ","وأتى عاذلي تمام المصيبه",23,"ه",1,0],["سقم الجُفونِ وَإِن تَزايَد صِحَّة","أَبَداً وَسُقمي كل يَوم نامي",24,"م",2,0],["سُقْمُ الجفُون سَقَامُه وشفاؤُه","فيها فمَنها الدّاءُ وهي الرّاقي",25,"ق",2,0],["سقم الجفون أعاد جسمي سقما","ولمى الشفاه اللعس أعدمني الشفا",26,"ف",2,0],["سَقَمٌ ماطلٌ أما آن أن يف","رق شيئاً على الرُّقَى المسحورُ",27,"ر",1,0],["سقماً يشاب بصحَّةٍ","فلذاك يحيي وهو قاتلْ",28,"ل",1,0],["سقمي وبرئي في يديه وإنما","يشفيك من داء الهوى من أمرضا",29,"ض",2,0],["سقمٌ فيه مذهبٌ سقم جسمي","كيف يشفي من السقام السقام",30,"م",1,0],["سُقماً لقد عَبَدوا الأَغْيارَ فانْقَطَعوا","وسعْيُ من أَخلَصَ التَّوحيدَ مَشْكُورُ",31,"ر",1,0],["سقمي تزيد مع الأيام كثرته","وأنت في عظم ما ألقى تقلله",32,"ل",2,0],["سُقْمُ جِسمي وصحّتي وفنائي","ووجودي في سُخطِها ورِضاها",33,"ا",3,0],["سقم الحاظ الحسان الخرد","صحة أهدت سقام الجسد",34,"د",1,1],["سق مطاياك بالحدا يا حادي","فهو سوق القلوب والأكبادِ",35,"د",1,1],["سَقَمٌ قديمُ العهدِ في الدُّنيا ولا","يُرجى شفاءُ الدَّاءِ حينَ استحكَما",36,"م",2,0],["سَقَمِي وموتُكَ يا همَّين في قَرَنِ","بل قُلْ إِذا شئْتَ يا سهمين في أَمَم",37,"م",1,0],["سقمت وكاد السقم يطوي صحيفتي","فوبحاً لعمر هكذا في الاسى يطوى",38,"و",2,0],["سُقمٌ بِطَرفِك لَو يُعالِجُ داءَه","خَدّاكِ أو شَفَتاكِ ما شَفَتاكِ",39,"ك",1,0],["سُقمٌ بِطَرفِكَ لَو يُعالِجُ داءَهَ","خَداكَ أو شَفَتاكَ ما شَفَتاكا",40,"ك",2,0],["سُقمها لي شفاءُ دائِي إذا جا","دت وداءٌ إذا تصدَّتْ لصدِّ",41,"د",1,0],["سُقم أوى أحسن عين تطرفُ","تقوي به وبالقلوب تُضْعِفُ",42,"ف",1,1],["سَقِمتُ وَزادَت صبوَتي ثمّ ما اِشتَفى","سقامي بِشَهدٍ من عذول وَلا صابِ",43,"ب",1,0],["سقِمتُ لقرب العاذلين وَجهلهم","فَلا طرفُ إِبلال وَلا قلبُ إِلبابِ",43,"ب",1,0],["سَقِمتُ مِن بُعدِكُم فَعودوا","فَما عَلى مُحسنٍ جُناح",44,"ح",1,1],["سقم بطرفك قد اقضى الى بدني","حتى تبدل من عيني بالوسن",45,"ن",1,1],["سقم الجفون لديك أكبر شاهد","يا آمراً قلبي مُطاعاً أمرُه",46,"ه",1,0],["سقمي شفاءٌ إذا عدتم فديتكم","وصحتي في بعادي عنكم سقم",47,"م",1,0],["سقَمِي من سقِيمةِ الأحداقِ","فاسقِنِي راحَ ذِكرِها يا ساقِي",48,"ق",2,1],["سقمٌ وما مسَّكَ الشيطانُ فيه لقد","حكيتَ أيوبَ صبراً عندما سَقُما",49,"م",2,0],["سقمان لم أدر تعذيبي بأيهما","سقم اصطباريَ أم أجفانك السُقَما",50,"م",2,0],["سَقَمي مِن سَقامِ جَفنِ طَبيبٍ","جَسَّ نَبضي نَاديتُهُ عِندَ ذَاكَ",51,"ك",1,1],["سقمي عقيقا بدر حين ارشفني","اللما العقيق ودرا جل عن صدف",52,"ف",1,0],["سقم الصحيح المستغل","وصحة الرجل السقيم",53,"م",1,0],["سَقُمتُ مِن سُقمٍ بِأَجفانِهِ","مازالَ يَعدي مدنفٌ مدنفا",54,"ف",2,0],["سَقَمٌ عظِيمٌ أَمرُهُ وأُجُورُهُ","ما اللهُ جلَّ جلالُهُ بمُطيعِها",55,"ع",3,0],["سقمي ثناني عن نصيحة أسرتي","أن لا تقارف في الحياة مآثما",56,"م",2,1],["سُقمي الى درك الحضيض يشدّني","والنفس تسمو بي الى أسمى سما",57,"م",2,1],["سقمٌ وشيخوخةٌ والدار نازحةٌ","بلا مكانٍ له آوي وإمكان",58,"ن",1,0],["سقمي هو الإرث الوحيد الذي","لي من أبي جاء ومن أمي",59,"م",2,0],["سقمي من سَقمِ مقلتهِ","والشفا في ذلك الشنبِ",60,"ب",1,0],["سقم الفؤاد بسقمهنّ وربّما","أعدي الصّحيح من السّقيم سقام",61,"م",1,0],["سَقمي وَشَوقي وَمَوتي طَيَّ ما نَشَروا","في جَفنِهِم في حماهُم في فراقِهِم",62,"م",1,0],["سقم يلوح سقام جفن معذّبي","يعتاده وهوىً تلبّس بالحشا",63,"ش",2,0],["سَقِموا وسُقمُهُمُ عُضالاً قد غَدا","يأبِي الشِفاءَ كعِلَّةِ الإِزمانِ",64,"ن",1,0],["سقم تردّد بين الرُوح وَالبَدَنِ","مِن فُرقة الآل أَو من غربة الوَطَنِ",65,"ن",1,1],["سقمتُ وكنت أهزأ بالسقام","وأحسب أنني فوق النظام",66,"م",1,1],["سقم الحبيب وحين شاع حديثه","شعر الأحبة بالسقام الموجع",67,"ع",1,0],["سَقمي مِن سَقمِ جَفْ","نَيْكَ وفي فَيْئِك طِيبي",68,"ب",2,0],["سقمٌ مجحفٌ وعرٌّ كريه","واختصاصٌ بكر