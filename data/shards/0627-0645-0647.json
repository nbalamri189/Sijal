 يا أسماء مردود","https://www.aldiwan.net/poem56859.html","البسيط"],[549,"لك ما تراماه لحاظ الناظر","https://www.aldiwan.net/poem47795.html","الكامل"],[556,"هذه الكائنات أم هي حانه","https://www.aldiwan.net/poem33691.html","الخفيف"],[556,"عين حق إنسانها الإنسان","https://www.aldiwan.net/poem33815.html","الخفيف"],[556,"اجتمعوا يا إخوتي واحشدوا","https://www.aldiwan.net/poem34637.html","السريع"],[560,"بغداد أيتها الركاب فبادري","https://www.aldiwan.net/poem52940.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[567,"سلب الشباب رداءه","https://www.aldiwan.net/poem52022.html","مجزوء الكامل"],[573,"يا من نسيت فسكره من لحظه","https://www.aldiwan.net/poem2893.html","الكامل"]],"verses":[["أَم هَل دَرَت أَنَّ الحُسامَ جَنينُها","طَلقاً وَإِنَّ أَبا العَلاءِ فَطيمُها",0,"م",3,0],["أَمهَلَ الناقِصونَ وَاِستَعجَلَ الدَه","رُ بِسَوقٍ لِلفاضِلينَ عَنيفِ",1,"ف",1,0],["أَم هَل يُباحُ الوِردُ ثانِيَةً","وَيَلَذُّ بَردَ الماءِ مُرتَشِفُ",2,"ف",1,0],["أَم هَل يَرُدُّ زَمانٌ في ثَنِيَّتِهِ","لَنا أَوائِلَ سُلّافٍ وَطُلّاعِ",3,"ع",1,0],["أَم هَل أَبيتُ وَدارٌ عِندَ كاظِمَةٍ","داري وَسُمّارُ ذاكَ الحَيِّ سُمّاري",4,"ي",1,0],["أَم هَل تُنَهنَهُ عَبرَةٌ عَن جارِكُم","جادَ الشُؤونَ بِها تَبُلُّ نِجادي",5,"د",2,0],["أُمَّةُ الطِليانِ خَفَّفتِ الأَسى","بِصَنيعٍ مِن أَياديكِ الغُرَر",6,"ر",1,0],["أَمهِروها بِالروحِ فَهيَ عَروسٌ","تَسنَأُ المَهرَ مِن عُروضٍ وَنَقدِ",7,"د",1,0],["أُمَّةُ النيلِ أَكبَرَت أَن تُعادي","مَن رَماها وَأَشفَقَت أَن تُعادى",8,"د",2,0],["أُمَّةً قَد فَتَّ في ساعِدِها","بُغضُها الأَهلَ وَحُبُّ الغُرَبا",9,"ب",2,0],["أَمُهَندِسَ النيلِ السَعيدِ تَحِيَّةً","مِن مِصرَ تَحدوها تَحِيَّةُ شاعِرِ",10,"ر",1,0],["أمة الشرق تزدهي بالبنين الصي","د منكم وبالبنات الغوالي",11,"ل",2,0],["أَمْ هَلْ تُتِمُّ عَظِيمَةٌ فِي أُمَّةٍ","وَالقَائِمُونَ بِأَمْرِهَا شَطْرَانِ",12,"ن",1,0],["أُمَّةٌ أَزْجَتِ الجِنَازَ فِي أَسْ","نَى مَجَالِي الإِكْبَارِ والإِعْظَامِ",13,"م",1,0],["أَمٌّ هِيَ الشَّمْسُ فِي بَنشيهَا","يَجْمَعُهُمْ حَوْلَهَا النِّظَامُ",14,"م",1,0],["أُمَّةٌ لا يَعِيشُ مِثْلُكَ فِيهَا","كَيْفَ حَالٌ كَحَالِهَا تَسْتَقِيمُ",15,"م",1,0],["أَم هَيَجَتكَ البازِلُ الطَليحُ","مَهرِيَّةٌ في بَطنِها مَلقوحُ",16,"ح",1,0],["أمها جري لبنان طال غيابكم","أين الحنين إلى ربا لبنان",17,"ن",1,0],["أم هل يكون خليفةً لرسوله","من حاد عن هّدْي النبي المُرسَل",18,"ل",1,0],["أَمَةٌ يُقالُ مِنَ البَراجِمِ أَصلُها","نَسَبٌ مِنَ الأَنسابِ غَيرُ قَريبِ",19,"ب",1,0],["أَمَةٌ من إماءِ طَوْلك أجمع","تُ على نقلها إلىَّ قريبا",20,"ب",2,0],["أم هل أسأتُ إليك في","أمرٍ وقد أحييتَ أمرا",21,"ر",2,0],["أم هلْ حماهُ غيبتي سيدٌ","يحْمي إذا ما قلَّ من يَحْمي",22,"م",2,0],["أمُّهُ دهرَها تُتَرجمُ عنه","وهو بادي الغنى عن الترجمانِ",23,"ن",1,0],["أم هل يطيبُ لمقلةٍ وَسنٌ","فيقرُّ فيها ذلك الوسنُ",24,"ن",1,0],["أم هل يُبَتُّ لذاهبٍ قَرَنٌ","يوماً فيُوصَل ذلك القَرَنُ",24,"ن",1,0],["أَم هَل كَبيرٌ بَكى لَم يَقضِ عَبرَتَهُ","إِثرَ الأَحِبَّةِ يَومَ البَينِ مَشكومُ",25,"م",1,0],["أمة من سلالة القرد جاءت","تهتدي بالحجا من الآجام",26,"م",1,0],["ام هدمت عشه الغربان قادرة","عليه وهو ضعيف ليس يقتدر",27,"ر",1,0],["امهلتني الصروف حيناً من الد","دَهر فلما أتين جئن سراعا",28,"ع",2,0],["امهات لهن تدعو صغار","وصغار تدعوهم الامهات",29,"ت",1,0],["أم هل هناك حياتكم","صفوٌ فليس بها شوائب",30,"ب",1,0],["أمّه من أبيه آمت فأمست","ينهك البؤس جسمها والشقاء",31,"ا",2,0],["أم هل هي الدنيا التي قد أمَّها","شغلت كما شغل الأحبة والعدى",32,"د",2,0],["أمة من غرائب النصر نشوَى","تسلب الملك من تشاء وتسدي",33,"ي",1,0],["أمهما قام عزمك أو تصدى","دنا الأقصى ودان المستحيل",34,"ل",1,0],["أُمَّةٌ تُنشِئُ الحَياةَ وَتَبني","كَبِناءِ الأُبُوَّةِ الأَمجادِ",35,"د",1,0],["أُمَّةٌ هُيِّأَت وَقَومٌ لِخَيرِ ال","دَهرِ أَو شَرِّهِ عَلى اِستِعدادِ",36,"د",1,0],["أُمَّهاتٌ لا تَحمِلُ الثُكلَ إِلّا","لِلنَجيبِ الجَريءِ في الأَولادِ",36,"د",1,0],["أُمَّةٌ لِلخُلدِ ما تَبني إِذا","ما بَنى الناسُ جَميعاً لِلعَفاء",37,"ا",2,0],["أُمَّةُ التُركِ وَالعِراقُ وَأَهلو","هُ وَلُبنانُ وَالرُبى وَالخِيامُ",38,"م",1,0],["أَم هَل يَعُدُّ لَكَ الإِضاعَةَ مِنَّةً","جَيشٌ كَجَيشِ الهِندِ باتَ ذَليلا",39,"ل",2,0],["أُمَّةٌ هَمُّها الخَرائِبُ تُبلي","ها وَحَقُّ الخَرائِبِ الإِعلاءُ",40,"ا",2,0],["أُمَّةٌ يَنتَهي البَيانُ إِلَيها","وَتَؤولُ العُلومُ وَالعُلَماءُ",40,"ا",2,0],["أَمُهَجِّنَ الكُرَماءِ وَالمُزري بِهِم","وَتَروكَ كُلِّ كَريمِ قَومٍ عاتِبا",41,"ب",2,0],["أَم هَل مَعَ الحُبِّ حِلمٌ لا تُسَفِّهُهُ","صَبابَةٌ أَو عَزاءٌ غَيرُ مَغلوبِ",42,"ب",1,0],["أَم هَل أَقولُ تَخَلَّفَت بِيَ عِندَهُ","حالٌ فَمَن ذا بَعدَهُ مُستَصحِبي",43,"ي",1,0],["أَم هُوَ الدَمعُ عَن جَوى الحُبِّ بادٍ","وَالجَوى في جَوانِحِ الصَدرِ خافِ",44,"ف",1,0],["أَمَةُ اليَدَينِ لَئيمَةٌ آباؤُها","سَوداءُ حَيثُ يُعَلَّقُ التِقصارُ",45,"ر",1,0],["أم هل أرى القصرَ المُنيفَ مُعَمَّماً","بِرداءِ غَيْمٍ كالرِّداءِ رَقيقِ",46,"ق",1,0],["أم هل لمُمتْلئ اليَدَيْنِ منَ العُلا","ذَنْبٌ إذا ما كنتَ منها مُملِقا",47,"ق",2,0],["أَم هَل يُلامَنَّ باكٍ هاجَ عَبرَتَهُ","بِالحِجرِ إِذ شَفَّهُ الوَجدُ الَّذي يَجِدُ",48,"د",1,0],["اِمهَد لِنَفسِكَ وَاِذكُر ساعَةَ الأَجَلِ","وَلا تُغَرَّنَّ في دُنياكَ بِالأَمَلِ",49,"ل",1,1],["أمهل فؤادي ساعةً ريثما","أخلعُ عن عيني قِناعَ الخيال",50,"ل",1,0],["أمهل فؤادي ساعةً ريثما","أخلعُ عن قلبي سرابَ الضلال",50,"ل",1,0],["أَمَهدِيّاً لَحَيتَ عَلى نَوالٍ","لَقَد حُكتِ المَلامَ لِغَيرِ واعِ",51,"ع",1,0],["أمْ هلْ قصدْتَ بما أهديْتَ مِنْ كلمٍ","أَنْ تطربَ الحيَّ أو أنْ تحيي الطربا",52,"ب",2,0],["أمْ هلْ أشكُّ وقدْ جربتهم زمناً","وعفْتُ أكرمَهم رمياً فلا وأبي",53,"ب",2,0],["أَم هَل سَرى يُنعِشُ غُصنَ الرُبى","فَمَجَّ ريقَ الطَلِّ ثَغرُ الأَقاح",54,"ح",1,0],["أَمْ هُو الموكبُ ما مِنْ مأربٍ","غَيرُه إن قيلَ ماذا المأربُ",55,"ب",1,0],["أُمَّةَ الفُرقانِ زِيدِي عِظَما","وارْفَعِيهِ للمعالي عَلَما",56,"م",2,0],["أُمّةٌ للخلدِ تستعصي على","عِزَّةِ الموتِ وتأبى أن تُضاما",57,"م",2,0],["أَمُهجَةَ مِصرَ يَضرِبُ كُلُّ رامِ","لَقَد بَغَتِ الرُماةُ عَلى السِهامِ",58,"م",1,1],["أم هو اللهُ ذو الجلالِ رماه","يُمسك الشرَّ راكضاً مستطيرا",59,"ر",2,0],["أُمُّها البَدرُ أُمُّ أَروى فَنالَت","كُلَّ ما يُعجِزُ الأَكُفَّ يَداها",60,"ا",3,0],["أم هُمُ حَلّلوُا بها شِرْكَةَ الأب","دَانِ أمْ هُمْ لبعضِهم كُفَلا