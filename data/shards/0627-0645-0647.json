بسيط"],[49,"امهد لنفسك واذكر ساعة الأجل","https://www.aldiwan.net/poem63060.html","البسيط"],[97,"يا من بواديه حططت الرحال","https://www.aldiwan.net/poem24920.html","السريع"],[44,"خذي عبرات عينك عن زماعي","https://www.aldiwan.net/poem30464.html","الوافر"],[69,"سناك يا بن الكرام الكاتبين سبا","https://www.aldiwan.net/poem28710.html","البسيط"],[69,"طول المقام بدار الحرث برح بي","https://www.aldiwan.net/poem29268.html","البسيط"],[74,"بشرى كما أسفر وجه الصباح","https://www.aldiwan.net/poem12886.html","السريع"],[105,"ها هنا الأعلام كانت تنصب","https://www.aldiwan.net/poem42062.html","الرمل"],[105,"اذكرونا في الملمات الكبر","https://www.aldiwan.net/poem42099.html","الرمل"],[105,"يا بريد النيل إن جئت الشآما","https://www.aldiwan.net/poem42115.html","الرمل"],[105,"أمهجة مصر يضرب كل رام","https://www.aldiwan.net/poem43149.html","الوافر"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[40,"من لنفس عن الهوى لا تناهى","https://www.aldiwan.net/poem42329.html","الخفيف"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[46,"استحي من شمس النهار ومن","https://www.aldiwan.net/poem22726.html","الكامل"],[46,"ربيت شبلا فلما إن غدا أسدا","https://www.aldiwan.net/poem23106.html","البسيط"],[46,"أحسن بالواجد من وجده","https://www.aldiwan.net/poem23628.html","السريع"],[19,"هل عاجل من متاع الحي منظور","https://www.aldiwan.net/poem342.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85543","المقتضب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85500","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85388","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39617","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39592","الهزج"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39554","الخفيف"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66042","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55059","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54828","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54560","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54534","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142036","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142021","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54314","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[106,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[106,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[106,"الوحدة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=179293",""],[100,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[90,"يراع المجد","https://www.poetsgate.com/ViewPoem.aspx?id=179189",""],[90,"الريف الضاحك","https://www.poetsgate.com/ViewPoem.aspx?id=179018",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[85,"كلُّ حيٍّ على المنية غادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9597&r=&rc=87",""]],"verses":[["أَم هَل دَرَت أَنَّ الحُسامَ جَنينُها","طَلقاً وَإِنَّ أَبا العَلاءِ فَطيمُها",0,"م",3,0],["أَمهَلَ الناقِصونَ وَاِستَعجَلَ الدَه","رُ بِسَوقٍ لِلفاضِلينَ عَنيفِ",1,"ف",1,0],["أَم هَل يُباحُ الوِردُ ثانِيَةً","وَيَلَذُّ بَردَ الماءِ مُرتَشِفُ",2,"ف",1,0],["أَم هَل يَرُدُّ زَمانٌ في ثَنِيَّتِهِ","لَنا أَوائِلَ سُلّافٍ وَطُلّاعِ",3,"ع",1,0],["أَم هَل أَبيتُ وَدارٌ عِندَ كاظِمَةٍ","داري وَسُمّارُ ذاكَ الحَيِّ سُمّاري",4,"ي",1,0],["أَم هَل تُنَهنَهُ عَبرَةٌ عَن جارِكُم","جادَ الشُؤونَ بِها تَبُلُّ نِجادي",5,"د",2,0],["أُمَّةُ الطِليانِ خَفَّفتِ الأَسى","بِصَنيعٍ مِن أَياديكِ الغُرَر",6,"ر",1,0],["أَمهِروها بِالروحِ فَهيَ عَروسٌ","تَسنَأُ المَهرَ مِن عُروضٍ وَنَقدِ",7,"د",1,0],["أُمَّةُ النيلِ أَكبَرَت أَن تُعادي","مَن رَماها وَأَشفَقَت أَن تُعادى",8,"د",2,0],["أُمَّةً قَد فَتَّ في ساعِدِها","بُغضُها الأَهلَ وَحُبُّ الغُرَبا",9,"ب",2,0],["أَمُهَندِسَ النيلِ السَعيدِ تَحِيَّةً","مِن مِصرَ تَحدوها تَحِيَّةُ شاعِرِ",10,"ر",1,0],["أمة الشرق تزدهي بالبنين الصي","د منكم وبالبنات الغوالي",11,"ل",2,0],["أَمْ هَلْ تُتِمُّ عَظِيمَةٌ فِي أُمَّةٍ","وَالقَائِمُونَ بِأَمْرِهَا شَطْرَانِ",12,"ن",1,0],["أُمَّةٌ أَزْجَتِ الجِنَازَ فِي أَسْ","نَى مَجَالِي الإِكْبَارِ والإِعْظَامِ",13,"م",1,0],["أَمٌّ هِيَ الشَّمْسُ فِي بَنشيهَا","يَجْمَعُهُمْ حَوْلَهَا النِّظَامُ",14,"م",1,0],["أُمَّةٌ لا يَعِيشُ مِثْلُكَ فِيهَا","كَيْفَ حَالٌ كَحَالِهَا تَسْتَقِيمُ",15,"م",1,0],["أَم هَيَجَتكَ البازِلُ الطَليحُ","مَهرِيَّةٌ في بَطنِها مَلقوحُ",16,"ح",1,0],["أمها جري لبنان طال غيابكم","أين الحنين إلى ربا لبنان",17,"ن",1,0],["أم هل يكون خليفةً لرسوله","من حاد عن هّدْي النبي المُرسَل",18,"ل",1,0],["أَمَةٌ يُقالُ مِنَ البَراجِمِ أَصلُها","نَسَبٌ مِنَ الأَنسابِ غَيرُ قَريبِ",19,"ب",1,0],["أَمَةٌ من إماءِ طَوْلك أجمع","تُ على نقلها إلىَّ قريبا",20,"ب",2,0],["أم هل أسأتُ إليك في","أمرٍ وقد أحييتَ أمرا",21,"ر",2,0],["أم هلْ حماهُ غيبتي سيدٌ","يحْمي إذا ما قلَّ من يَحْمي",22,"م",2,0],["أمُّهُ دهرَها تُتَرجمُ عنه","وهو بادي الغنى عن الترجمانِ",23,"ن",1,0],["أم هل يطيبُ لمقلةٍ وَسنٌ","فيقرُّ فيها ذلك الوسنُ",24,"ن",1,0],["أم هل يُبَتُّ لذاهبٍ قَرَنٌ","يوماً فيُوصَل ذلك القَرَنُ",24,"ن",1,0],["أَم هَل كَبيرٌ بَكى لَم يَقضِ عَبرَتَهُ","إِثرَ الأَحِبَّةِ يَومَ البَينِ مَشكومُ",25,"م",1,0],["أمة من سلالة القرد جاءت","تهتدي بالحجا من الآجام",26,"م",1,0],["ام هدمت عشه الغربان قادرة","عليه وهو ضعيف ليس يقتدر",27,"ر",1,0],["امهلتني الصروف حيناً من الد","دَهر فلما أتين جئن سراعا",28,"ع",2,0],["امهات لهن تدعو صغار","وصغار تدعوهم الامهات",29,"ت",1,0],["أم هل هناك حياتكم","صفوٌ فليس بها شوائب",30,"ب",1,0],["أمّه من أبيه آمت فأمست","ينهك البؤس جسمها والشقاء",31,"ا",2,0],["أم هل هي الدنيا التي قد أمَّها","شغلت كما شغل الأحبة والعدى",32,"د",2,0],["أمة من غرائب النصر نشوَى","تسلب الملك من تشاء وتسدي",33,"ي",1,0],["أمهما قام عزمك أو تصدى","دنا الأقصى ودان المستحيل",34,"ل",1,0],["أُمَّةٌ تُنشِئُ الحَياةَ وَتَبني","كَبِناءِ الأُبُوَّةِ الأَمجادِ",35,"د",1,0],["أُمَّةٌ هُيِّأَت وَقَومٌ لِخَيرِ ال","دَهرِ أَو شَرِّهِ عَلى اِستِعدادِ",36,"د",1,0],["أُمَّهاتٌ لا تَحمِلُ الثُكلَ إِلّا","لِلنَجيبِ الجَريءِ في الأَولادِ",36,"د",1,0],["أُمَّةٌ لِلخُلدِ ما تَبني إِذا","ما بَنى الناسُ جَميعاً لِلعَفاء",37,"ا",2,0],["أُمَّةُ التُركِ وَالعِراقُ وَأَهلو","هُ وَلُبنانُ وَالرُبى وَالخِيامُ",38,"م",1,0],["أَم هَل يَعُدُّ لَكَ الإِضاعَةَ مِنَّةً","جَيشٌ كَجَيشِ الهِندِ باتَ ذَليلا",39,"ل",2,0],["أُمَّةٌ هَمُّها الخَرائِبُ تُبلي","ها وَحَقُّ الخَرائِبِ الإِعلاءُ",40,"ا",2,0],["أُمَّةٌ يَنتَهي البَيانُ إِلَيها","وَتَؤولُ العُلومُ وَالعُلَماءُ",40,"ا",2,0],["أَمُهَجِّنَ الكُرَماءِ وَالمُزري بِهِم","وَتَروكَ كُلِّ كَريمِ قَومٍ عاتِبا",41,"ب",2,0],["أَم هَل مَعَ الحُبِّ حِلمٌ لا تُسَفِّهُهُ","صَبابَةٌ أَو عَزاءٌ غَيرُ مَغلوبِ",42,"ب",1,0],["أَم هَل أَقولُ تَخَلَّفَت بِيَ عِندَهُ","حالٌ فَمَن ذا بَعدَهُ مُستَصحِبي",43,"ي",1,0],["أَم هُوَ الدَمعُ عَن جَوى الحُبِّ بادٍ","وَالجَوى في جَوانِحِ الصَدرِ خافِ",44,"ف",1,0],["أَمَةُ اليَدَينِ لَئيمَةٌ آباؤُها","سَوداءُ حَيثُ يُعَلَّقُ التِقصارُ",45,"ر",1,0],["أم هل أرى القصرَ المُنيفَ مُعَمَّماً","بِرداءِ غَيْمٍ كالرِّداءِ رَقيقِ",46,"ق",1,0],["أم هل لمُمتْلئ اليَدَيْنِ منَ العُلا","ذَنْبٌ إذا ما كنتَ منها مُملِقا",47,"ق",2,0],["أَم هَل يُلامَنَّ باكٍ هاجَ عَبرَتَهُ","بِالحِجرِ إِذ شَفَّهُ الوَجدُ الَّذي يَجِدُ",48,"د",1,0],["اِمهَد لِنَفسِكَ وَاِذكُر ساعَةَ الأَجَلِ","وَلا تُغَرَّنَّ في دُنياكَ بِالأَمَلِ",49,"ل",1,1],["أمهل فؤادي ساعةً ريثما","أخلعُ عن عيني قِناعَ الخيال",50,"ل",1,0],["أمهل فؤادي ساعةً ريثما","أخلعُ عن قلبي سرابَ الضلال",50,"ل",1,0],["أَمَهدِيّاً لَحَيتَ عَلى نَوالٍ","لَقَد حُكتِ المَلامَ لِغَيرِ واعِ",51,"ع",1,0],["أمْ هلْ قصدْتَ بما أهديْتَ مِنْ كلمٍ","أَنْ تطربَ الحيَّ أو أنْ تحيي الطرب