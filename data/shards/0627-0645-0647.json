ttps://www.aldiwan.net/poem2073.html","أحذ الكامل"],[501,"رفع البدر علينا سجفا","https://www.aldiwan.net/poem37954.html","الرمل"],[506,"من تنادي","https://www.aldiwan.net/poem27891.html","المديد"],[541,"هل مامضى منك يا أسماء مردود","https://www.aldiwan.net/poem56859.html","البسيط"],[552,"لك ما تراماه لحاظ الناظر","https://www.aldiwan.net/poem47795.html","الكامل"],[559,"هذه الكائنات أم هي حانه","https://www.aldiwan.net/poem33691.html","الخفيف"],[559,"عين حق إنسانها الإنسان","https://www.aldiwan.net/poem33815.html","الخفيف"],[559,"اجتمعوا يا إخوتي واحشدوا","https://www.aldiwan.net/poem34637.html","السريع"],[563,"بغداد أيتها الركاب فبادري","https://www.aldiwan.net/poem52940.html","الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[570,"سلب الشباب رداءه","https://www.aldiwan.net/poem52022.html","مجزوء الكامل"],[576,"يا من نسيت فسكره من لحظه","https://www.aldiwan.net/poem2893.html","الكامل"]],"verses":[["أم هل يبيت ثلاثاً في العراء بلا","غسل ولا كفن لم تحوه الرجم",0,"م",1,0],["أَم هَل دَرَت أَنَّ الحُسامَ جَنينُها","طَلقاً وَإِنَّ أَبا العَلاءِ فَطيمُها",1,"م",3,0],["أَمهَلَ الناقِصونَ وَاِستَعجَلَ الدَه","رُ بِسَوقٍ لِلفاضِلينَ عَنيفِ",2,"ف",1,0],["أَم هَل يُباحُ الوِردُ ثانِيَةً","وَيَلَذُّ بَردَ الماءِ مُرتَشِفُ",3,"ف",1,0],["أَم هَل يَرُدُّ زَمانٌ في ثَنِيَّتِهِ","لَنا أَوائِلَ سُلّافٍ وَطُلّاعِ",4,"ع",1,0],["أَم هَل أَبيتُ وَدارٌ عِندَ كاظِمَةٍ","داري وَسُمّارُ ذاكَ الحَيِّ سُمّاري",5,"ر",2,0],["أَم هَل تُنَهنَهُ عَبرَةٌ عَن جارِكُم","جادَ الشُؤونَ بِها تَبُلُّ نِجادي",6,"د",2,0],["أُمَّةُ الطِليانِ خَفَّفتِ الأَسى","بِصَنيعٍ مِن أَياديكِ الغُرَر",7,"ر",1,0],["أَمهِروها بِالروحِ فَهيَ عَروسٌ","تَسنَأُ المَهرَ مِن عُروضٍ وَنَقدِ",8,"د",1,0],["أُمَّةُ النيلِ أَكبَرَت أَن تُعادي","مَن رَماها وَأَشفَقَت أَن تُعادى",9,"د",2,0],["أُمَّةً قَد فَتَّ في ساعِدِها","بُغضُها الأَهلَ وَحُبُّ الغُرَبا",10,"ب",2,0],["أَمُهَندِسَ النيلِ السَعيدِ تَحِيَّةً","مِن مِصرَ تَحدوها تَحِيَّةُ شاعِرِ",11,"ر",1,0],["أمة الشرق تزدهي بالبنين الصي","د منكم وبالبنات الغوالي",12,"ل",2,0],["أَمْ هَلْ تُتِمُّ عَظِيمَةٌ فِي أُمَّةٍ","وَالقَائِمُونَ بِأَمْرِهَا شَطْرَانِ",13,"ن",1,0],["أُمَّةٌ أَزْجَتِ الجِنَازَ فِي أَسْ","نَى مَجَالِي الإِكْبَارِ والإِعْظَامِ",14,"م",1,0],["أَمٌّ هِيَ الشَّمْسُ فِي بَنشيهَا","يَجْمَعُهُمْ حَوْلَهَا النِّظَامُ",15,"م",1,0],["أُمَّةٌ لا يَعِيشُ مِثْلُكَ فِيهَا","كَيْفَ حَالٌ كَحَالِهَا تَسْتَقِيمُ",16,"م",1,0],["أَم هَيَجَتكَ البازِلُ الطَليحُ","مَهرِيَّةٌ في بَطنِها مَلقوحُ",17,"ح",1,0],["أمها جري لبنان طال غيابكم","أين الحنين إلى ربا لبنان",18,"ن",1,0],["أم هل يكون خليفةً لرسوله","من حاد عن هّدْي النبي المُرسَل",19,"ل",1,0],["أَمَةٌ يُقالُ مِنَ البَراجِمِ أَصلُها","نَسَبٌ مِنَ الأَنسابِ غَيرُ قَريبِ",20,"ب",1,0],["أَمَةٌ من إماءِ طَوْلك أجمع","تُ على نقلها إلىَّ قريبا",21,"ب",2,0],["أم هل أسأتُ إليك في","أمرٍ وقد أحييتَ أمرا",22,"ر",2,0],["أم هلْ حماهُ غيبتي سيدٌ","يحْمي إذا ما قلَّ من يَحْمي",23,"م",2,0],["أمُّهُ دهرَها تُتَرجمُ عنه","وهو بادي الغنى عن الترجمانِ",24,"ن",1,0],["أم هل يطيبُ لمقلةٍ وَسنٌ","فيقرُّ فيها ذلك الوسنُ",25,"ن",1,0],["أم هل يُبَتُّ لذاهبٍ قَرَنٌ","يوماً فيُوصَل ذلك القَرَنُ",25,"ن",1,0],["أَم هَل كَبيرٌ بَكى لَم يَقضِ عَبرَتَهُ","إِثرَ الأَحِبَّةِ يَومَ البَينِ مَشكومُ",26,"م",1,0],["أمة من سلالة القرد جاءت","تهتدي بالحجا من الآجام",27,"م",1,0],["ام هدمت عشه الغربان قادرة","عليه وهو ضعيف ليس يقتدر",28,"ر",1,0],["امهلتني الصروف حيناً من الد","دَهر فلما أتين جئن سراعا",29,"ع",2,0],["امهات لهن تدعو صغار","وصغار تدعوهم الامهات",30,"ت",1,0],["أم هل هناك حياتكم","صفوٌ فليس بها شوائب",31,"ب",1,0],["أمّه من أبيه آمت فأمست","ينهك البؤس جسمها والشقاء",32,"ا",2,0],["أم هل هي الدنيا التي قد أمَّها","شغلت كما شغل الأحبة والعدى",33,"د",2,0],["أمة من غرائب النصر نشوَى","تسلب الملك من تشاء وتسدي",34,"د",2,0],["أمهما قام عزمك أو تصدى","دنا الأقصى ودان المستحيل",35,"ل",1,0],["أُمَّةٌ تُنشِئُ الحَياةَ وَتَبني","كَبِناءِ الأُبُوَّةِ الأَمجادِ",36,"د",1,0],["أُمَّةٌ هُيِّأَت وَقَومٌ لِخَيرِ ال","دَهرِ أَو شَرِّهِ عَلى اِستِعدادِ",37,"د",1,0],["أُمَّهاتٌ لا تَحمِلُ الثُكلَ إِلّا","لِلنَجيبِ الجَريءِ في الأَولادِ",37,"د",1,0],["أُمَّةٌ لِلخُلدِ ما تَبني إِذا","ما بَنى الناسُ جَميعاً لِلعَفاء",38,"ا",2,0],["أُمَّةُ التُركِ وَالعِراقُ وَأَهلو","هُ وَلُبنانُ وَالرُبى وَالخِيامُ",39,"م",1,0],["أَم هَل يَعُدُّ لَكَ الإِضاعَةَ مِنَّةً","جَيشٌ كَجَيشِ الهِندِ باتَ ذَليلا",40,"ل",2,0],["أُمَّةٌ هَمُّها الخَرائِبُ تُبلي","ها وَحَقُّ الخَرائِبِ الإِعلاءُ",41,"ا",2,0],["أُمَّةٌ يَنتَهي البَيانُ إِلَيها","وَتَؤولُ العُلومُ وَالعُلَماءُ",41,"ا",2,0],["أَمُهَجِّنَ الكُرَماءِ وَالمُزري بِهِم","وَتَروكَ كُلِّ كَريمِ قَومٍ عاتِبا",42,"ب",2,0],["أَم هَل مَعَ الحُبِّ حِلمٌ لا تُسَفِّهُهُ","صَبابَةٌ أَو عَزاءٌ غَيرُ مَغلوبِ",43,"ب",1,0],["أَم هَل أَقولُ تَخَلَّفَت بِيَ عِندَهُ","حالٌ فَمَن ذا بَعدَهُ مُستَصحِبي",44,"ب",2,0],["أَم هُوَ الدَمعُ عَن جَوى الحُبِّ بادٍ","وَالجَوى في جَوانِحِ الصَدرِ خافِ",45,"ف",1,0],["أَمَةُ اليَدَينِ لَئيمَةٌ آباؤُها","سَوداءُ حَيثُ يُعَلَّقُ التِقصارُ",46,"ر",1,0],["أم هل أرى القصرَ المُنيفَ مُعَمَّماً","بِرداءِ غَيْمٍ كالرِّداءِ رَقيقِ",47,"ق",1,0],["أم هل لمُمتْلئ اليَدَيْنِ منَ العُلا","ذَنْبٌ إذا ما كنتَ منها مُملِقا",48,"ق",2,0],["أَم هَل يُلامَنَّ باكٍ هاجَ عَبرَتَهُ","بِالحِجرِ إِذ شَفَّهُ الوَجدُ الَّذي يَجِدُ",49,"د",1,0],["اِمهَد لِنَفسِكَ وَاِذكُر ساعَةَ الأَجَلِ","وَلا تُغَرَّنَّ في دُنياكَ بِالأَمَلِ",50,"ل",1,1],["أمهل فؤادي ساعةً ريثما","أخلعُ عن عيني قِناعَ الخيال",51,"ل",1,0],["أمهل فؤادي ساعةً ريثما","أخلعُ عن قلبي سرابَ الضلال",51,"ل",1,0],["أَمَهدِيّاً لَحَيتَ عَلى نَوالٍ","لَقَد حُكتِ المَلامَ لِغَيرِ واعِ",52,"ع",1,0],["أمْ هلْ قصدْتَ بما أهديْتَ مِنْ كلمٍ","أَنْ تطربَ الحيَّ أو أنْ تحيي الطربا",53,"ب",2,0],["أمْ هلْ أشكُّ وقدْ جربتهم زمناً","وعفْتُ أكرمَهم رمياً فلا وأبي",54,"ب",2,0],["أَم هَل سَرى يُنعِشُ غُصنَ الرُبى","فَمَجَّ ريقَ الطَلِّ ثَغرُ الأَقاح",55,"ح",1,0],["أَمْ هُو الموكبُ ما مِنْ مأربٍ","غَيرُه إن قيلَ ماذا المأربُ",56,"ب",1,0],["أُمَّةَ الفُرقانِ زِيدِي عِظَما","وارْفَعِيهِ للمعالي عَلَما",57,"م",2,0],["أُمّةٌ للخلدِ تستعصي على","عِزَّةِ الموتِ وتأبى أن تُضاما",58,"م",2,0],["أَمُهجَةَ مِصرَ يَضرِبُ 