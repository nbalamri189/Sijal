gate.com/ViewPoem.aspx?id=151475",""],[5829,"من شرفتي","https://www.poetsgate.com/ViewPoem.aspx?id=202676",""],[5829,"وتوقف التاريخ والازمان","https://www.poetsgate.com/ViewPoem.aspx?id=210215",""],[5897,"بشائر على أبواب المدينة","https://www.poetsgate.com/ViewPoem.aspx?id=157555",""],[5908,"بنا من بنات الماء للكوفة الغرا","https://www.poetsgate.com/ViewPoem.aspx?id=170972",""],[5950,"هذي هي أخباري","https://www.poetsgate.com/ViewPoem.aspx?id=128134",""],[5956,"وتتابعت آيات ربك","https://www.poetsgate.com/ViewPoem.aspx?id=192633",""],[5956,"تخاصمني الحبيبة نايُ أيضاً","https://www.poetsgate.com/ViewPoem.aspx?id=194077",""],[5956,"يا حُبَّنا الأعلى","https://www.poetsgate.com/ViewPoem.aspx?id=194669",""],[5957,"حقائب غربتها","https://www.poetsgate.com/ViewPoem.aspx?id=198263",""],[5957,"عراقي أنت","https://www.poetsgate.com/ViewPoem.aspx?id=207854",""],[5977,"يا راحلين","https://www.poetsgate.com/ViewPoem.aspx?id=212731",""],[6032,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=181511",""],[6102,"نِهايَةُ المُسَلسَل","https://www.poetsgate.com/ViewPoem.aspx?id=182768",""],[6147,"حنين إلى الفار المخلوع","https://www.poetsgate.com/ViewPoem.aspx?id=151693",""],[5355,"غدر الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87118&r=&rc=13",""],[6213,"وهدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80548&r=&rc=80",""],[6225,"تظلُّم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80898&r=&rc=167",""],[463,"لعلّكَ ,,بالشّعبِ تعلو اليفاعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60129&r=&rc=185",""],[6261,"الهجرة الخامسة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82138&r=&rc=10",""],[6318,"حب ووفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66154&r=&rc=4",""]],"verses":[["وتَترُكُ صُبحَ الجَهلِ يَغبَرُّ ضَوؤُهُ","وَنَقعُكَ أَخّاذٌ عَلَيهِ الضَواحِيا",0,"ي",2,0],["وتتوّجَتْ زَهْراً مَفارِقُ دوْحِهِ","وتدرّجَتْ في حُجْرِهِ أبْكارُهُ",1,"ر",2,0],["وتتمّه بالعنيّا","من إلاه أعطاك وولاك",2,"ك",1,0],["وتترك أوصالَ الوشيج مقصَّداً","وبيضَ الظُبي حمرَ المتون دواميا",3,"ي",2,0],["وتتسع السياسة للتصافي","فيستصفي الخدين بها الخدينا",4,"ن",2,0],["وتتبعوا سبل الحياة ولا يكُن","منكم إلى غير المكارم قاصد",5,"د",1,0],["وَتُترَكُ مِثلَ الكَلبِ يَملُجُ أَيرَهُ","وَتَنزِعُ مَحسوراً وَتَقعُدُ آثِما",6,"م",2,0],["وتتابع المنن التي ما عيبها","إلا رجوع الوصفِ عنها قاصرا",7,"ر",2,0],["وتتفقان في خلقٍ كريمٍ","فَتَشْتَرِكَانِهِ شِرْكَ الطِّيابِ",8,"ب",1,0],["وَتَتَبَّعَ الإِخوانَ يَنْعَشُ عَثْرَةً","منهم ويسْتُر عَوْرَةً أن تُفْضحا",9,"ح",2,0],["وتتبَّعته وقد عاد فَلا","قى أَقاصي البلاد بعد الأداني",10,"ن",2,0],["وتَتَبُّعِ النَّحْلِ الأَنيقِ","وقَطْفِ تِيجانِ الزُّهورْ",11,"ر",1,0],["وتتبَّعْتهُ ظِباؤُها بقَواضبٍ","من لَحْظِهَا وحُماتُها بقواضب",12,"ب",1,0],["وَتَتَبَّعواجَمعَ الحُطا","مِ وَفارَقوا أَثَرَ الرَسولِ",13,"ل",1,0],["وَتَتَوَّجوا بِقَلانِسٍ مُحمَرَّةٍ","جَعدٌ عَلى سَبطِ الأَثيثِ الصافي",14,"ف",2,0],["وَتَتَوَّجَت هامُ الغُصونِ وَضَرَّجَت","خَدَّ الرِياضِ شَقائِقُ النُعمانِ",15,"ن",1,0],["وتتابع الأنواء في أفق الصّبا","لم يُبق لي صحواً أراه جميلا",16,"ل",2,0],["وَتَتابَعَت أَيّامُهُ وَشُهورُهُ","عُصَباً يُغِرنَ كَأَنَّهُنَّ مَقانِبُ",17,"ب",1,0],["وتتركُنا بلا رجلٍ كبيرٍ","نراجعُهُ إذا رُمْنا مراما",18,"م",2,0],["وَتَتَوَّجَت بِمَنارِ عِلمٍ ساطِعٍ","قَد قامَ فَوقَ قَرارِ دينٍ آنِسِ",19,"س",1,0],["وتتّخذُ الدّمَ المسفوكَ وِرداً","تظنُّ ذُعافَه الماءَ المعينا",20,"ن",2,0],["وتتابعتْ رُسُلٌ فمنهم غادِرٌ","يَبغي الفسادَ وحَاذِرٌ يتأثّم",21,"م",1,0],["وَتَتَّشِحُ الشِمالَ لِلابِسيها","وَتَرعى الضَأنَ بِالبَلَدِ القَفارِ",22,"ر",1,1],["وَتَترُكُ جَمرَ الزَوجِ يَخبو لِرِحلَةٍ","إِلى الرُكنِ وَالبَطحاءِ تَرمي جَمارَها",23,"ر",3,0],["وتَتْرُكُ قَتْلَى قد عَلِمْنَا مَكَانَهَا","وتَعْفُو جِرَاحٌ عَنْ دَمٍ فَتَقَرَّفُ",24,"ف",1,0],["وَتَتْرُكُ الْبِرَّ غَيْرَ مُحْتَسِبٍ","أَجْرَاً وَبِالْبِرِّ تُفْتَحُ الأُرَبُ",25,"ب",1,0],["وَتَتِمُّ آيَةُ حُسْنِهَا","بِالأَمنِ بَعْدَ تَفَزُّعِ",26,"ع",1,0],["وَتَتَبَّعْ صُنُوفَ مَا اَثَرُوا عَنْ","هُ وَمَا دَوَّنُوا بِشَتَّى اللُّغَاتِ",27,"ت",1,0],["وتُتَّخَذُ المصايفُ في ذُرَاها","وتُفْجَعُ في شواطئها البحار",28,"ر",1,0],["وتتَّفقُ المجاعةُ والمزايا","وتلتئِم المحاسنُ والعراء",29,"ا",2,0],["وتتَّبعته وقد عاد فَلا","فى أَقاصي البلاد بعد الأداني",30,"ن",2,0],["وتتخد الدم المسفوك وردا","تظن ذعافه الماء المعينا",31,"ن",2,0],["وتتابُعُ القَطَراتِ يَنْزِلُ بَعْدَهُ","سَيْلٌ يَليهِ تَدَفُّقُ الطُّوفانِ",32,"ن",1,0],["وَتتُركُ كُلَّ النَّادِى حَيرَانَ نَائِماً","فَيُوقِظُهُ ضَربُ المَزَامِرِ بِاليَدِ",33,"د",1,0],["وتُتعبُ ألسنَ دُرَّاسِها","وتُفنِى قراطيسَ كُتَّابها",34,"ب",3,0],["وتتقيه العِتاق القُبُّ سائمةً","تطويحَها بين أتهامٍ وأنجادِ",35,"د",1,0],["وتتابعت حِججٌ يؤرِّخ عصرَها","عُمرٌ به خُلدُ الزمان كفيلُ",36,"ل",1,0],["وَتَتيهُ إِدلالاً وَلَيسَ بِمُنكَرٍ","أَن توصَفَ الحَسناءُ بِالإِدلالِ",37,"ل",1,0],["وتتعب فيما يستريح به الورى","وتسرى فما يمسى كغيرك رادعا",38,"ع",2,0],["وَتَتابَعَت زَفَراتُ وَجدٍ لَم تَزَل","مِنها القُلوبُ كَثيرَةَ الخَفَقانِ",39,"ن",1,0],["وتتابعت محن الزمان","فما لداهية إياب",40,"ب",1,0],["وتتلوه الشكوك بكل وجه","ويتبعه القطيعة والسباب",41,"ب",1,0],["وتتركهُ في الحسّ كالروح نفسها","وكالفكر في ذوق المعاني الدقائقِ",42,"ق",1,0],["وتتيهُ بأعيادِ الملوكِ وكيفَ لا","وعيدُ أميرِ المُؤمنينَ أميرُها",43,"ر",3,0],["وتتلى أحاديث المكارم والندى","وتنشر آيات الثنا والمناقب",44,"ب",1,0],["وتتبّع أخلاقه الغرّ واطرح","غيرها ما حييت بالأنباذ",45,"ذ",1,0],["وَتَتابَعَت نعم به وَتَطاوَلَت","رتب تَناهى في عراض المشتري",46,"ر",2,0],["وَتَتَابَعَتْ قَطَراتُ غَيْثُكَ أَنْعُماً","إِنَّ الْكَرِيمَ سَماؤُهُ مِدْرارُ",47,"ر",1,0],["وتتْبعَ بعضَهُم بعضاً","كما من كان قبلهُمُ",48,"م",1,0],["وَتَترس بِرَغيفٍ","وَصَفَقَ نازَويه صَفقَه",49,"ق",2,0],["وتَتَّقي بهواديها أَعاليَها","إذا العِنانُ لتصريفِ القنا خُفِضا",50,"ض",2,0],["وَتَتَّخِذُ الإيمانَ وَيَحَكَ جُنَّةَ","وَما هِيَ إِلّا بِالحَقيقَةِ أَسهُمُ",51,"م",1,0],["وتَتابَعت غاراتُه","من أنتَ من عَوفِ بن عامِر",52,"ر",1,0],["وتتَّخذ الرِّياحَ لها بساط","تطير به إلى رُتَب المعالي",53,"ل",2,0],["وتتبعها ملايين الضحاي","تذوق من المآسي ما تذوق",54,"ق",1,0],["وتَتَوَّجَتْ بالزَّهْرِ هامَ هِضابِه","ذَهَباً فَلقدَها نَدَاهُ جَوْهَرَا",55,"ر",2,0],["وتتابَعَتْ منك الجنودُ كَأَنَّما","يَطَؤُونَ منها لُؤْلُؤاً منثورا",56,"ر",2,0],["وتتابعت منه اللُّها حتى لقد","شرقت بها لَهَواتُ كلِّ أماني",57,"ن",2,0],["وتتّسع البلوى فيمضِي مصمِّماً","جبانٌ عن الظلِّ الخَفوقِ يحيدُ",58,"د",1,0],["وتتابعوا في المجد ينتظمونه","والرمحُ أُنبوبٌ على أنبوبِ",59,"ب",1,0],["وتتلو سِباعُ الطَّيْرِ طيرَ لوائِهِ","ويسترْفدُ العسَّالُ جود العواسل",60,"ل",1,0],["وتُتَّقى مثلما تُرْجى فَواضِلُهُ","وجُودهُ فهو مَرْهوبٌ ومَأمولُ",61,"ل",1,0],["وتتايهَ أكثرُهمْ حُمْقاً","بالشِّعرِ على أهلِ الوبَرِ",62,"ر",1,0],["وتتابعت رسل الوفود وخاطبت","أحرارهم في القسط والقسطاس",63,"س",1,0],["وتَتَّضِعُ الدَّراري لافْتِخاري","ويَخْشَعُ عِنديَ الأَسَدُ الأبِيُّ",64,"ي",1,0],["وتتبّعوا الآثارَ منهُ فحاولوا","فوقَ النّجومِ مداركَ الآمالِ",65,"ل",1,0],["وتتهم الأقوال فرط مهابة","وإن نحن لم ننطق بغير صواب",66,"ب",1,0],["وَتَتابع اللّطف الخَفي وَاسعفت","بِصَنائع المَعروف أَرباب الوَلا",67,"ل",2,0],["وَتَتابَعَت منن وَحل بِيمنه","أنس مَلا الأَكوان مِن سرّائِهِ",68,"ا",3,0],["وَتتركُ القولَ لم تُحْمَد مواضعُهُ","وكم صَموتٍ وما يُدعى من اللَّكَنَ",69,"ن",1,0],["وتتبّع المعروفَ حتّى طُنِّبتْ","جوداً على سَنَنِ الطّريقِ خِيامُهُ",70,"م",2,0],["وتتابعت بشرى السرور لجمعنا","والقرب جاء وقد مضى يوم النوى",71,"و",2,0],["وتتابعت أوصافه وترادفت","أسماؤه في أنفس وجسوم",72,"م",1,0],["وتتبعه الأسماء مطلقة به","على حسب الأشياء وهي قيود",73,"د",1,0],["وتتابعت بشرى الهواتف بالذي","يعنو له الإلهام والإيحاء",74,"ا",2,0],["وَتَترُكُ الأُسدَ صَرعى","ظِباؤُهُ بِالنِبالِ",75,"ل",1,0],["وتُتْلى بِشَرقِ الأَرضِ والغربِ كُتْبُه","وتَنْفُذُ فيها رُسْلُه ورسائِلُه",76,"ل",2,0],["وتَتَابَعتَ فَتَحاتُها فَتَنَزَّهت","عن قول عبدِ الله حتَّى نَصْطَلح",77,"ح",1,0],["وَتَتابَعَت أرزاؤُهُ فَكَأنَّها","في الكَونِ تَهدِمُهُ بِما تَبنيهِ",78,"ي",2,0],["وتتبعت أشقى ثمود وتبع","وبنت على تأسيس كل لعين",79,"ن",1,0],["وَتَتلو عَلَيهِ آيةَ الشُكر دائِماً","بِأَكمل تَرتيل وَحُسن تردّد",80,"د",1,0],["وتَتابَعَتْ كُلُّ الفُصول بِنسْبَةٍ","حَتَّى تَكَم