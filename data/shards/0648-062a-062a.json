{"poems":[[53,"أراعي بلوغ الشيب والشيب دائيا","https://www.aldiwan.net/poem29567.html","الطويل"],[77,"يا ربة البيت الممنع جاره","https://www.aldiwan.net/poem36516.html","الكامل"],[83,"الوجود يقول هنيا","https://www.aldiwan.net/poem54205.html","مجزوء الرمل"],[83,"معاذ الهوى أن أصحب القلب ساليا","https://www.aldiwan.net/poem54225.html","الطويل"],[88,"أطالوا الحرب طاحنة زبونا","https://www.aldiwan.net/poem44459.html","الوافر"],[88,"عقل وتجربة وجد زائد","https://www.aldiwan.net/poem44983.html","الكامل"],[23,"يا راكبا إما عرضت فبلغن","https://www.aldiwan.net/poem21490.html","الطويل"],[72,"صيرت نومي مثل عطفك نافرا","https://www.aldiwan.net/poem18698.html","الكامل"],[51,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[51,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[92,"كم من عهود عذبة","https://www.aldiwan.net/poem38946.html","مجزوء الكامل"],[61,"شعف الحبائل من ربى وملاعب","https://www.aldiwan.net/poem51812.html","الكامل"],[49,"عجبا لأرباب العقول","https://www.aldiwan.net/poem63064.html","مجزوء الكامل"],[66,"حذرا عليك من الفعال الجافي","https://www.aldiwan.net/poem38689.html","الكامل"],[66,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[97,"لمن العيون الفاترات ذبولا","https://www.aldiwan.net/poem24801.html","الكامل"],[44,"إني أتتني من لدنك صحيفة","https://www.aldiwan.net/poem30581.html","الكامل"],[69,"علام أردت تهجرني علاما","https://www.aldiwan.net/poem28897.html","الوافر"],[74,"جرر ملاءة كل يوم شامس","https://www.aldiwan.net/poem12971.html","الكامل"],[105,"أعن خطب الخلافة تسألينا","https://www.aldiwan.net/poem42132.html","الوافر"],[105,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[50,"وتتشح الشمال للابسيها","https://www.aldiwan.net/poem62400.html","الوافر"],[46,"إذا ردنت فيما يعود لطفلها","https://www.aldiwan.net/poem22611.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42540","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[51,"يمَّنَ اللهُ طلعة المهرجان","https://www.poetsgate.com/ViewPoem.aspx?id=30807",""],[105,"أعن خطب الخلافة تسألينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55027&r=&rc=197",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""]],"verses":[["وتَترُكُ صُبحَ الجَهلِ يَغبَرُّ ضَوؤُهُ","وَنَقعُكَ أَخّاذٌ عَلَيهِ الضَواحِيا",0,"ي",2,0],["وتتوّجَتْ زَهْراً مَفارِقُ دوْحِهِ","وتدرّجَتْ في حُجْرِهِ أبْكارُهُ",1,"ر",2,0],["وتتمّه بالعنيّا","من إلاه أعطاك وولاك",2,"ك",1,0],["وتترك أوصالَ الوشيج مقصَّداً","وبيضَ الظُبي حمرَ المتون دواميا",3,"ي",2,0],["وتتسع السياسة للتصافي","فيستصفي الخدين بها الخدينا",4,"ن",2,0],["وتتبعوا سبل الحياة ولا يكُن","منكم إلى غير المكارم قاصد",5,"د",1,0],["وَتُترَكُ مِثلَ الكَلبِ يَملُجُ أَيرَهُ","وَتَنزِعُ مَحسوراً وَتَقعُدُ آثِما",6,"م",2,0],["وتتابع المنن التي ما عيبها","إلا رجوع الوصفِ عنها قاصرا",7,"ر",2,0],["وتتفقان في خلقٍ كريمٍ","فَتَشْتَرِكَانِهِ شِرْكَ الطِّيابِ",8,"ب",1,0],["وَتَتَبَّعَ الإِخوانَ يَنْعَشُ عَثْرَةً","منهم ويسْتُر عَوْرَةً أن تُفْضحا",9,"ح",2,0],["وتتبَّعته وقد عاد فَلا","قى أَقاصي البلاد بعد الأداني",10,"ن",2,0],["وتَتَبُّعِ النَّحْلِ الأَنيقِ","وقَطْفِ تِيجانِ الزُّهورْ",11,"ر",1,0],["وتتبَّعْتهُ ظِباؤُها بقَواضبٍ","من لَحْظِهَا وحُماتُها بقواضب",12,"ب",1,0],["وَتَتَبَّعواجَمعَ الحُطا","مِ وَفارَقوا أَثَرَ الرَسولِ",13,"ل",1,0],["وَتَتَوَّجوا بِقَلانِسٍ مُحمَرَّةٍ","جَعدٌ عَلى سَبطِ الأَثيثِ الصافي",14,"ف",2,0],["وَتَتَوَّجَت هامُ الغُصونِ وَضَرَّجَت","خَدَّ الرِياضِ شَقائِقُ النُعمانِ",15,"ن",1,0],["وتتابع الأنواء في أفق الصّبا","لم يُبق لي صحواً أراه جميلا",16,"ل",2,0],["وَتَتابَعَت أَيّامُهُ وَشُهورُهُ","عُصَباً يُغِرنَ كَأَنَّهُنَّ مَقانِبُ",17,"ب",1,0],["وتتركُنا بلا رجلٍ كبيرٍ","نراجعُهُ إذا رُمْنا مراما",18,"م",2,0],["وَتَتَوَّجَت بِمَنارِ عِلمٍ ساطِعٍ","قَد قامَ فَوقَ قَرارِ دينٍ آنِسِ",19,"س",1,0],["وتتّخذُ الدّمَ المسفوكَ وِرداً","تظنُّ ذُعافَه الماءَ المعينا",20,"ن",2,0],["وتتابعتْ رُسُلٌ فمنهم غادِرٌ","يَبغي الفسادَ وحَاذِرٌ يتأثّم",21,"م",1,0],["وَتَتَّشِحُ الشِمالَ لِلابِسيها","وَتَرعى الضَأنَ بِالبَلَدِ القَفارِ",22,"ر",1,1],["وَتَترُكُ جَمرَ الزَوجِ يَخبو لِرِحلَةٍ","إِلى الرُكنِ وَالبَطحاءِ تَرمي جَمارَها",23,"ر",3,0],["وَتَتْرُكُ الْبِرَّ غَيْرَ مُحْتَسِبٍ","أَجْرَاً وَبِالْبِرِّ تُفْتَحُ الأُرَبُ",24,"ب",1,0],["وَتَتِمُّ آيَةُ حُسْنِهَا","بِالأَمنِ بَعْدَ تَفَزُّعِ",25,"ع",1,0],["وَتَتَبَّعْ صُنُوفَ مَا اَثَرُوا عَنْ","هُ وَمَا دَوَّنُوا بِشَتَّى اللُّغَاتِ",26,"ت",1,0],["وتُتَّخَذُ المصايفُ في ذُرَاها","وتُفْجَعُ في شواطئها البحار",27,"ر",1,0],["وتتَّفقُ المجاعةُ والمزايا","وتلتئِم المحاسنُ والعراء",28,"ا",2,0],["وتتَّبعته وقد عاد فَلا","فى أَقاصي البلاد بعد الأداني",29,"ن",2,0],["وتتخد الدم المسفوك وردا","تظن ذعافه الماء المعينا",30,"ن",2,0],["وتتابُعُ القَطَراتِ يَنْزِلُ بَعْدَهُ","سَيْلٌ يَليهِ تَدَفُّقُ الطُّوفانِ",31,"ن",1,0]]}