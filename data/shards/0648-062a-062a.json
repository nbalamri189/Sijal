{"poems":[[53,"أراعي بلوغ الشيب والشيب دائيا","https://www.aldiwan.net/poem29567.html","الطويل"],[77,"يا ربة البيت الممنع جاره","https://www.aldiwan.net/poem36516.html","الكامل"],[83,"الوجود يقول هنيا","https://www.aldiwan.net/poem54205.html","مجزوء الرمل"],[83,"معاذ الهوى أن أصحب القلب ساليا","https://www.aldiwan.net/poem54225.html","الطويل"],[88,"أطالوا الحرب طاحنة زبونا","https://www.aldiwan.net/poem44459.html","الوافر"],[88,"عقل وتجربة وجد زائد","https://www.aldiwan.net/poem44983.html","الكامل"],[23,"يا راكبا إما عرضت فبلغن","https://www.aldiwan.net/poem21490.html","الطويل"],[72,"صيرت نومي مثل عطفك نافرا","https://www.aldiwan.net/poem18698.html","الكامل"],[51,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[51,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[92,"كم من عهود عذبة","https://www.aldiwan.net/poem38946.html","مجزوء الكامل"],[61,"شعف الحبائل من ربى وملاعب","https://www.aldiwan.net/poem51812.html","الكامل"],[49,"عجبا لأرباب العقول","https://www.aldiwan.net/poem63064.html","مجزوء الكامل"],[66,"حذرا عليك من الفعال الجافي","https://www.aldiwan.net/poem38689.html","الكامل"],[66,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[97,"لمن العيون الفاترات ذبولا","https://www.aldiwan.net/poem24801.html","الكامل"],[44,"إني أتتني من لدنك صحيفة","https://www.aldiwan.net/poem30581.html","الكامل"],[69,"علام أردت تهجرني علاما","https://www.aldiwan.net/poem28897.html","الوافر"],[74,"جرر ملاءة كل يوم شامس","https://www.aldiwan.net/poem12971.html","الكامل"],[105,"أعن خطب الخلافة تسألينا","https://www.aldiwan.net/poem42132.html","الوافر"],[105,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[50,"وتتشح الشمال للابسيها","https://www.aldiwan.net/poem62400.html","الوافر"],[46,"إذا ردنت فيما يعود لطفلها","https://www.aldiwan.net/poem22611.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42540","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[51,"يمَّنَ اللهُ طلعة المهرجان","https://www.poetsgate.com/ViewPoem.aspx?id=30807",""],[105,"أعن خطب الخلافة تسألينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55027&r=&rc=197",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[130,"فما صوت جليت مع القوم في الند","https://www.aldiwan.net/poem54847.html","الطويل"],[140,"تفيض نفوس بأوصابها","https://www.aldiwan.net/poem58421.html","المتقارب"],[140,"ماذا يعيب رجال الحى في النادي","https://www.aldiwan.net/poem58426.html","البسيط"],[140,"ألكم إلى رد الشباب سبيل","https://www.aldiwan.net/poem58447.html","الكامل"],[141,"ما كان قبلك في الزمان الخالي","https://www.aldiwan.net/poem11802.html","الكامل"],[158,"قليل لها هجر الجنوب المضاجعا","https://www.aldiwan.net/poem58996.html","الطويل"],[167,"سائل ديار الحي من ماوان","https://www.aldiwan.net/poem1687.html",""],[184,"سقط العتاب عن السفيه","https://www.aldiwan.net/poem44135.html","مجزوء الكامل"],[184,"إذا فتح امرؤ للوصل بابا","https://www.aldiwan.net/poem44144.html","الوافر"],[197,"إِليك غصوني يا طيور الحقائق","https://www.aldiwan.net/poem45162.html","الطويل"],[197,"أراك الحمى هل قبلتك ثغورها","https://www.aldiwan.net/poem45651.html","الطويل"],[208,"أبشراي عادت للديار الحبائب","https://www.aldiwan.net/poem13467.html","الطويل"],[257,"ثق بمولى يرعاك يا ابن المعاذ","https://www.aldiwan.net/poem35573.html","الخفيف"],[269,"ضربوا الخيام على الكثيب الاخضر","https://www.aldiwan.net/poem52100.html","الكامل"],[278,"ببهاء وجهك تشرق الأنوار","https://www.aldiwan.net/poem60769.html","الكامل"],[279,"وصدق قبل قولهم","https://www.aldiwan.net/poem1388.html",""],[282,"نزل الفأر ببيتي","https://www.aldiwan.net/poem44309.html","مجزوء الرمل"],[362,"بملتقى لحظنا البرق الذي ومضا","https://www.aldiwan.net/poem60862.html","البسيط"],[364,"أما فوقها إلا نجود وأنهم","https://www.aldiwan.net/poem17330.html","الطويل"],[369,"دارت عيون في محاجر","https://www.aldiwan.net/poem57443.html","مجزوء الكامل"],[397,"موازين الرجال","https://www.aldiwan.net/poem6777.html","عموديه"],[397,"تنوعت الجراح","https://www.aldiwan.net/poem6787.html","عموديه"],[429,"هو ملتقى أرج النواسم فانظرا","https://www.aldiwan.net/poem12311.html","الكامل"],[436,"كسيت بدولتك اليالي نورا","https://www.aldiwan.net/poem34851.html","الكامل"],[450,"غيري يلذ له الهوى بهوان","https://www.aldiwan.net/poem13931.html","الكامل"],[456,"أمنها على أن المزار بعيد","https://www.aldiwan.net/poem56220.html","الوافر"],[456,"طرقت على خطر السرى المركوب","https://www.aldiwan.net/poem56281.html","الكامل"],[459,"ولما التقينا والمعالي مضيئة","https://www.aldiwan.net/poem16106.html","الطويل"],[459,"يفل غرب الرزايا وهي باسلة","https://www.aldiwan.net/poem16442.html","البسيط"],[475,"هل بعد وصالك من وطر","https://www.aldiwan.net/poem15256.html","الوافر"],[477,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[498,"إذا ما صغت في المحبوب نظما","https://www.aldiwan.net/poem37728.html","الوافر"],[512,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[513,"مقامك من فضل وفصل خطاب","https://www.aldiwan.net/poem12011.html","الطويل"],[522,"ما زال نور محمد متنقلا","https://www.aldiwan.net/poem13285.html","الكامل"],[522,"وولد الحبيب فمرحبا بوفائه","https://www.aldiwan.net/poem13288.html","الكامل"],[549,"يا طائر الأيك غرد لي على الفنن","https://www.aldiwan.net/poem47158.html","البسيط"],[549,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[556,"عطشى العتيق من الجديد قد ارتوى","https://www.aldiwan.net/poem33582.html","الكامل"],[556,"حق بدا في صورة الموهوم","https://www.aldiwan.net/poem34185.html","الكامل"],[556,"وجود وأشيا ما لهن وجود","https://www.aldiwan.net/poem34627.html","الطويل"],[556,"لي في الإله عقيدة غراء","https://www.aldiwan.net/poem35090.html","الكامل"],[561,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[573,"هلال ولكن السعود منازله","https://www.aldiwan.net/poem3023.html","الطويل"],[573,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"]],"verses":[["وتَترُكُ صُبحَ الجَهلِ يَغبَرُّ ضَوؤُهُ","وَنَقعُكَ أَخّاذٌ عَلَيهِ الضَواحِيا",0,"ي",2,0],["وتتوّجَتْ زَهْراً مَفارِقُ دوْحِهِ","وتدرّجَتْ في حُجْرِهِ أبْكارُهُ",1,"ر",2,0],["وتتمّه بالعنيّا","من إلاه أعطاك وولاك",2,"ك",1,0],["وتترك أوصالَ الوشيج مقصَّداً","وبيضَ الظُبي حمرَ المتون دواميا",3,"ي",2,0],["وتتسع السياسة للتصافي","فيستصفي الخدين بها الخدينا",4,"ن",2,0],["وتتبعوا سبل الحياة ولا يكُن","منكم إلى غير المكارم قاصد",5,"د",1,0],["وَتُترَكُ مِثلَ الكَلبِ يَملُجُ أَيرَهُ","وَتَنزِعُ مَحسوراً وَتَقعُدُ آثِما",6,"م",2,0],["وتتابع المنن التي ما عيبها","إلا رجوع الوصفِ عنها قاصرا",7,"ر",2,0],["وتتفقان في خلقٍ كريمٍ","فَتَشْتَرِكَانِهِ شِرْكَ الطِّيابِ",8,"ب",1,0],["وَتَتَبَّعَ الإِخوانَ يَنْعَشُ عَثْرَةً","منهم ويسْتُر عَوْرَةً أن تُفْضحا",9,"ح",2,0],["وتتبَّعته وقد عاد فَلا","قى أَقاصي البلاد بعد الأداني",10,"ن",2,0],["وتَتَبُّعِ النَّحْلِ الأَنيقِ","وقَطْفِ تِيجانِ الزُّهورْ",11,"ر",1,0],["وتتبَّعْتهُ ظِباؤُها بقَواضبٍ","من لَحْظِهَا وحُماتُها بقواضب",12,"ب",1,0],["وَتَتَبَّعواجَمعَ الحُطا","مِ وَفارَقوا أَثَرَ الرَسولِ",13,"ل",1,0],["وَتَتَوَّجوا بِقَلانِسٍ مُحمَرَّةٍ","جَعدٌ عَلى سَبطِ الأَثيثِ الصافي",14,"ف",2,0],["وَتَتَوَّجَت هامُ الغُصونِ وَضَرَّجَت","خَدَّ الرِياضِ شَقائِقُ النُعمانِ",15,"ن",1,0],["وتتابع الأنواء في أفق الصّبا","لم يُبق لي صحواً أراه جميلا",16,"ل",2,0],["وَتَتابَعَت أَيّامُهُ وَشُهورُهُ","عُصَباً يُغِرنَ كَأَنَّهُنَّ مَقانِبُ",17,"ب",1,0],["وتتركُنا بلا رجلٍ كبيرٍ","نراجعُهُ إذا رُمْنا مراما",18,"م",2,0],["وَتَتَوَّجَت بِمَنارِ عِلمٍ ساطِعٍ","قَد قامَ فَوقَ قَرارِ دينٍ آنِسِ",19,"س",1,0],["وتتّخذُ الدّمَ المسفوكَ وِرداً","تظنُّ ذُعافَه الماءَ المعينا",20,"ن",2,0],["وتتابعتْ رُسُلٌ فمنهم غادِرٌ","يَبغي الفسادَ وحَاذِرٌ يتأثّم",21,"م",1,0],["وَتَتَّشِحُ الشِمالَ لِلابِسيها","وَتَرعى الضَأنَ بِالبَلَدِ القَفارِ",22,"ر",1,1],["وَتَترُكُ جَمرَ الزَوجِ يَخبو لِرِحلَةٍ","إِلى الرُكنِ وَالبَطحاءِ تَرمي جَمارَها",23,"ر",3,0],["وَتَتْرُكُ الْبِرَّ غَيْرَ مُحْتَسِبٍ","أَجْرَاً وَبِالْبِرِّ تُفْتَحُ الأُرَبُ",24,"ب",1,0],["وَتَتِمُّ آيَةُ حُسْنِهَا","بِالأَمنِ بَعْدَ تَفَزُّعِ",25,"ع",1,0],["وَتَتَبَّعْ صُنُوفَ مَا اَثَرُوا عَنْ","هُ وَمَا دَوَّنُوا بِشَتَّى اللُّغَاتِ",26,"ت",1,0],["وتُتَّخَذُ المصايفُ في ذُرَاها","وتُفْجَعُ في شواطئها البحار",27,"ر",1,0],["وتتَّفقُ المجاعةُ والمزايا","وتلتئِم المحاسنُ والعراء",28,"ا",2,0],["وتتَّبعته وقد عاد فَلا","فى أَقاصي البلاد بعد الأداني",29,"ن",2,0],["وتتخد الدم المسفوك وردا","تظن ذعافه الماء المعينا",30,"ن",2,0],["وتتابُعُ القَطَراتِ يَنْزِلُ بَعْدَهُ","سَيْلٌ يَليهِ تَدَفُّقُ الطُّوفانِ",31,"ن",1,0],["وَتتُركُ كُلَّ النَّادِى حَيرَانَ نَائِماً","فَيُوقِظُهُ ضَربُ المَزَامِرِ بِاليَدِ",32,"د",1,0],["وتُتعبُ ألسنَ دُرَّاسِها","وتُفنِى قراطيسَ كُتَّابها",33,"ب",3,0],["وتتقيه العِتاق القُبُّ سائمةً","تطويحَها بين أتهامٍ وأنجادِ",34,"د",1,0],["وتتابعت حِججٌ يؤرِّخ عصرَها","عُمرٌ به خُلدُ الزمان كفيلُ",35,"ل",1,0],["وَتَتيهُ إِدلالاً وَلَيسَ بِمُنكَرٍ","أَن توصَفَ الحَسناءُ بِالإِدلالِ",36,"ل",1,0],["وتتعب فيما يستريح به الورى","وتسرى فما يمسى كغيرك رادعا",37,"ع",2,0],["وَتَتابَعَت زَفَراتُ وَجدٍ لَم تَزَل","مِنها القُلوبُ كَثيرَةَ الخَفَقانِ",38,"ن",1,0],["وتتابعت محن الزمان","فما لداهية إياب",39,"ب",1,0],["وتتلوه الشكوك بكل وجه","ويتبعه القطيعة والسباب",40,"ب",1,0],["وتتركهُ في الحسّ كالروح نفسها","وكالفكر في ذوق المعاني الدقائقِ",41,"ق",1,0],["وتتيهُ بأعيادِ الملوكِ وكيفَ لا","وعيدُ أميرِ المُؤمنينَ أميرُها",42,"ر",3,0],["وتتلى أحاديث المكارم والندى","وتنشر آيات الثنا والمناقب",43,"ب",1,0],["وتتبّع أخلاقه الغرّ واطرح","غيرها ما حييت بالأنباذ",44,"ذ",1,0],["وَتَتابَعَت نعم به وَتَطاوَلَت","رتب تَناهى في عراض المشتري",45,"ر",2,0],["وَتَتَابَعَتْ قَطَراتُ غَيْثُكَ أَنْعُماً","إِنَّ الْكَرِيمَ سَماؤُهُ مِدْرارُ",46,"ر",1,0],["وتتْبعَ بعضَهُم بعضاً","كما من كان قبلهُمُ",47,"م",1,0],["وَتَترس بِرَغيفٍ","وَصَفَقَ نازَويه صَفقَه",48,"ق",2,0],["وتَتَّقي بهواديها أَعاليَها","إذا العِنانُ لتصريفِ القنا خُفِضا",49,"ض",2,0],["وَتَتَّخِذُ الإيمانَ وَيَحَكَ جُنَّةَ","وَما هِيَ إِلّا بِالحَقيقَةِ أَسهُمُ",50,"م",1,0],["وتَتابَعت غاراتُه","من أنتَ من عَوفِ بن عامِر",51,"ر",1,0],["وتتَّخذ الرِّياحَ لها بساط","تطير به إلى رُتَب المعالي",52,"ي",1,0],["وتتبعها ملايين الضحاي","تذوق من المآسي ما تذوق",53,"ق",1,0],["وتَتَوَّجَتْ بالزَّهْرِ هامَ هِضابِه","ذَهَباً فَلقدَها نَدَاهُ جَوْهَرَا",54,"ر",2,0],["وتتابَعَتْ منك الجنودُ كَأَنَّما","يَطَؤُونَ منها لُؤْلُؤاً منثورا",55,"ر",2,0],["وتتابعت منه اللُّها حتى لقد","شرقت بها لَهَواتُ كلِّ أماني",56,"ن",2,0],["وتتّسع البلوى فيمضِي مصمِّماً","جبانٌ عن الظلِّ الخَفوقِ يحيدُ",57,"د",1,0],["وتتابعوا في المجد ينتظمونه","والرمحُ أُنبوبٌ على أنبوبِ",58,"ب",1,0],["وتتلو سِباعُ الطَّيْرِ طيرَ لوائِهِ","ويسترْفدُ العسَّالُ جود العواسل",59,"ل",1,0],["وتُتَّقى مثلما تُرْجى فَواضِلُهُ","وجُودهُ فهو مَرْهوبٌ ومَأمولُ",60,"ل",1,0],["وتتايهَ أكثرُهمْ حُمْقاً","بالشِّعرِ على أهلِ الوبَرِ",61,"ر",1,0],["وتتابعت رسل الوفود وخاطبت","أحرارهم في القسط والقسطاس",62,"س",1,0],["وتَتَّضِعُ الدَّراري لافْتِخاري","ويَخْشَعُ عِنديَ الأَسَدُ الأبِيُّ",63,"ي",1,0],["وتتبّعوا الآثارَ منهُ فحاولوا","فوقَ النّجومِ مداركَ الآمالِ",64,"ل",1,0],["وتتهم الأقوال فرط مهابة","وإن نحن لم ننطق بغير صواب",65,"ب",1,0],["وَتَتابع اللّطف الخَفي وَاسعفت","بِصَنائع المَعروف أَرباب الوَلا",66,"ل",2,0],["وَتَتابَعَت منن وَحل بِيمنه","أنس مَلا الأَكوان مِن سرّائِهِ",67,"ا",3,0],["وَتتركُ القولَ لم تُحْمَد مواضعُهُ","وكم صَموتٍ وما يُدعى من اللَّكَنَ",68,"ن",1,0],["وتتبّع المعروفَ حتّى طُنِّبتْ","جوداً على سَنَنِ الطّريقِ خِيامُهُ",69,"م",2,0],["وتتابعت بشرى السرور لجمعنا","والقرب جاء وقد مضى يوم النوى",70,"و",2,0],["وتتابعت أوصافه وترادفت","أسماؤه في أنفس وجسوم",71,"م",1,0],["وتتبعه الأسماء مطلقة به","على حسب الأشياء وهي قيود",72,"د",1,0],["وتتابعت بشرى الهواتف بالذي","يعنو له الإلهام والإيحاء",73,"ا",2,0],["وَتَترُكُ الأُسدَ صَرعى","ظِباؤُهُ بِالنِبالِ",74,"ل",1,0],["وتُتْلى بِشَرقِ الأَرضِ والغربِ كُتْبُه","وتَنْفُذُ فيها رُسْلُه ورسائِلُه",75,"ل",2,0],["وتَتَابَعتَ فَتَحاتُها فَتَنَزَّهت","عن قول عبدِ الله حتَّى نَصْطَلح",76,"ح",1,0]]}