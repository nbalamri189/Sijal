{"poems":[[55,"يعبن موتاهم بأحيائهم","https://www.aldiwan.net/poem30666.html","الرجز"],[90,"طرب الشعر أن يكون نسيبا","https://www.aldiwan.net/poem44453.html","الخفيف"],[74,"أمنزل ذات الخال حييت منزلا","https://www.aldiwan.net/poem20541.html","الطويل"],[53,"وجدت أبا عبد الإله خليفة لصاحبه","https://www.aldiwan.net/poem8694.html","الطويل"],[91,"إن فعل الرجال غير الكلام","https://www.aldiwan.net/poem44616.html","الخفيف"],[91,"انظر إلى الكواكب","https://www.aldiwan.net/poem44667.html","مجزوء الرجز"],[45,"بكتب الأنام كتاب ورد","https://www.aldiwan.net/poem9557.html","المتقارب"],[47,"حذرت الحب لو أغنى حذاري","https://www.aldiwan.net/poem63588.html","الوافر"],[47,"هجاني النغيل وما خلتني","https://www.aldiwan.net/poem65634.html","المتقارب"],[68,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[76,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[107,"صبوح دم يساجله غبوق","https://www.aldiwan.net/poem43115.html","الوافر"],[48,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[70,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54767","السريع"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54229","الكامل"],[96,"وانجلت نفسي في النور","https://www.poetsgate.com/ViewPoem.aspx?id=15612",""],[53,"مطايبُ عيشٍ زايلتْهُ مخابِثُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=27263",""],[103,"بَغْدَادُ يَابَلَد الرَشِيدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62444&r=&rc=36",""],[90,"طرب الشعر أن يكون نسيبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19532&r=&rc=35",""],[280,"من ذا على الدهر مكث","https://www.aldiwan.net/poem25408.html","مجزوء الرجز"],[285,"ألم أك للقوافي الغر خدنا","https://www.aldiwan.net/poem60692.html","البسيط"],[285,"أرى العلياء واضحة السبيل","https://www.aldiwan.net/poem60777.html","الطويل"],[310,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[369,"دام علاء العماد","https://www.aldiwan.net/poem60952.html","مجزوء السريع"],[396,"باسمك الله ابتدى","https://www.aldiwan.net/poem54499.html","عموديه"],[438,"لأية حال فيض دمعك هتان","https://www.aldiwan.net/poem12754.html","الطويل"],[563,"ليت لو كنت إذا قلت أنا","https://www.aldiwan.net/poem33848.html","الرمل"],[563,"قل لعباد الخيال","https://www.aldiwan.net/poem34200.html","مجزوء الرمل"],[563,"حركات سكنات","https://www.aldiwan.net/poem34707.html","مجزوء الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86922","الطويل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34449","السريع"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77573","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59111","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16729","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48911","الخفيف"],[1611,"","https://poetry.dctabudhabi.ae/diwan/poem/106725","الخفيف"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132227","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202146","الرمل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123040","الرجز"],[2632,"","https://poetry.dctabudhabi.ae/diwan/poem/216960","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204884","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74330","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132586","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74076","السريع"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62794","الطويل"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105816","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108071","الخفيف"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118766","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205484","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85222","الخفيف"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35603","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136927",""],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81270","الخفيف"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35047","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33470","المتقارب"],[4755,"إِنَّهَا فِتنَةُ الفِتَنْ","https://www.poetsgate.com/ViewPoem.aspx?id=195210",""],[4886,"لله كم من هضبةٍ وجبلِ","https://www.poetsgate.com/ViewPoem.aspx?id=170308",""],[4929,"دين الله الاسلام","https://www.poetsgate.com/ViewPoem.aspx?id=208716",""],[4984,"فيا رمضان الجد","https://www.poetsgate.com/ViewPoem.aspx?id=175575",""],[5074,"الغائب الحاضر","https://www.poetsgate.com/ViewPoem.aspx?id=153717",""],[3591,"يعبس الدهر ثم يبسم حيناً","https://www.poetsgate.com/ViewPoem.aspx?id=149406",""],[5183,"عُلْيَا المَناَصِب","https://www.poetsgate.com/ViewPoem.aspx?id=186458",""],[5186,"قلب الدهر اختيارا","https://www.poetsgate.com/ViewPoem.aspx?id=156521",""],[5419,"الموت","https://www.poetsgate.com/ViewPoem.aspx?id=32220",""],[5431,"لن تضيع الأصول عند الحصاد","https://www.poetsgate.com/ViewPoem.aspx?id=196628",""],[5431,"لغة الشم ...","https://www.poetsgate.com/ViewPoem.aspx?id=198586",""],[5431,"قال يوما أحبها للرياح....","https://www.poetsgate.com/ViewPoem.aspx?id=199598",""],[5431,"وحده الموتُ مخْلصٌ بالحفاظِ!!","https://www.poetsgate.com/ViewPoem.aspx?id=200775",""],[5574,"شعبُ حروفي","https://www.poetsgate.com/ViewPoem.aspx?id=206005",""],[5691,"يوم يُبعثون","https://www.poetsgate.com/ViewPoem.aspx?id=206744",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5694,"نرهب عدو الدين","https://www.poetsgate.com/ViewPoem.aspx?id=129915",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""],[6198,"ناي الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79296&r=&rc=70",""],[6198,"المهاجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79235&r=&rc=9",""]],"verses":[["يَعِبنَ مَوتاهُمُ بِأَحيائِهِم","كَما يُعابُ الحَيُّ بِالمَيّتِ",0,"ت",1,1],["يعبس الأنس أن تروح ذهاباً","ويعيد ابتسامه أن تؤوبا",1,"ب",2,0],["يعبر عن سر الهوى وأضيعه","فيا لك دمعاً معرباً راح مهملا",2,"ل",2,0],["يُعبِّس والإنصافُ تحت عبوسه","ويضحك والإيناس في ضحكاتِهِ",3,"ت",2,0],["يعبس الجاهلون في الوجه منى","فأداري عبوسهم بابتسامي",4,"م",2,0],["يعبرن عرض بحره","من جانب لجانب",5,"ب",1,0],["يُعَبِّرُ عَمّا لَهُ عِندَنا","وَيَذكُرُ مِن شَوقِهِ ما نَجِد",6,"د",1,0],["يَعُبُّ فَيُنفِدُ الصَهباءَ جِلفٌ","قَريبُ العَهدِ بِالدِبسِ المُدارِ",7,"ر",1,0],["يُعَبّي الذُبابَ كَراديسَهُ","فَتَغشاهُ قَنبَلَةً قَنبَلَه",8,"ل",2,0],["يُعَبِّرُ عَن فَرطِ الحَنينِ أَنينُها","وَيُعرِبُ عَمّا في الضَميرِ ضُمورُها",9,"ر",3,0],["يَعُبُّ عُبابَ البَحرِ في السِلمِ وَالوَغى","بِبَذلِ اليَدِ الغَرّاءِ وَالفَتكَةِ البِكرِ",10,"ر",1,0],["يُعَبِّئُها وَيُنفِذُها سِراعاً","تُراعُ لَها العَواصِفُ وَالبُروقُ",11,"ق",1,0],["يُعَبِّرُ سَيْفُه لفْظَ المَنايا","كما شَرَحَ الكلامَ التّرْجُمانُ",12,"ن",1,0],["يعبَقُ المسْكُ حيثُما ذُكر اسمي","مُنْذُ نادَيْتَني أُقَبّلُ فاكا",13,"ك",2,0],["يَعْبُدُهُ النَّاسُ قَدِيماً وَفِي","ذَاكَ مِنَ الدِّينِ تسَاوَى الْعِبَادْ",14,"د",1,0],["يَعْبَئْنَ بِالأًيَّامِ وَالْ","أَيَّامُ أَعْبَثُ مِنْ وَلِيدِ",15,"د",1,0],["يعبد الله ففي محرابه","كعبة زهراء من نور وقدس",16,"س",1,0],["يُعبِّدُها فرعٌ من المجد طيِّبٌ","جَناهُ إذا ما الفرعُ جَمَّت خبائثهْ",17,"ث",2,0],["يَعْبَثْنَ بِالأَيَّامِ والْ","أَيَّامُ أَعْبَثُ مِنْ وَلِيدِ",18,"د",1,0],["يعبس الانس أن تروح ذهابا","ويعيد ابتسامه أن تئوبا",19,"ب",2,0],["يعبثُ في سفاهة","والمرء لم يخلق عبث",20,"ث",1,0],["يَعُبُّ عُبابُهُ بَحْراً خِضَمَّاً","وَيَبِتُكُ حَدُّهُ عَضْباً جُرازا",21,"ز",2,0],["يَعُبُّ إِذا أَصابَ الضَّيْمُ شَرْباً","وَبَعْضُ الذُّلِّ أَوْلى بِالذَّلِيلِ",22,"ل",1,0],["يعبقُ الطيبُ مِن نَداها ويطفي","بَردُها لفحةَ الحشى الحرّانِ",23,"ن",1,0],["يَعبِقُ من نَشْرِها","رُواتُها كُلُّ ناد",24,"د",1,0],["يعبدالله وحده","ماله بالسوى اهتمام",25,"م",1,0],["يعبّرُ عن نشرِ الأثيرِ كأنّما","تجرُّ على تلك الرُبى منه أردانُ",26,"ن",1,0],["يعبدون الله خوفاً من لظىً","فلظىً قد عبدوا لا ربَّنا",27,"ن",2,0],["يعبد الله الذي في","عقله ولا يبالي",28,"ل",2,0],["يعبدون الله سراً","وجهاراً ثم ماتوا",29,"ت",3,0],["يعبر عَن إِخلاص بيض السَرائرِ","بِأَفصَح إِعراب لِسانُ الضَمائرِ",30,"ر",1,1],["يَعبثُ بالهجران لي أَهيفٌ","وَطَرفُهُ بالسحر نفّاثُ",31,"ث",1,1],["يَعبده عبادة الأَوثان","بِالقَلب وَاليَدين وَاللِسان",32,"ن",1,0],["يُعَبِّرُ عَنْ سِرّ الهَوَى وَأضِيعُهُ","فَلِلَّهِ دَمعٌ مُعْرِبٌ وَهْوَ هَامِل",33,"ل",1,0],["يُعَبِّرُ عَنهُ الرَوضَ وَهوَ مُنَمنَمٌ","وَيُخبِرُ عَنهُ الوَشيَ وَهُوَ قَشيبُ",34,"ب",1,0],["يعبث الدهر بالرواسي ويبقى","أَثرُ الفكر خالداً جبَّارا",35,"ر",2,0],["يَعبَثُ الطَيرُ فيهِم وَالسيدُ وَال","أُسدُ بِأَشلائِهِم وَبِالأَوصالِ",36,"ل",1,0],["يعبق المسك كلما ذكر اسمي","منذ ناديتني ضحى بسماء",37,"ا",2,0],["يعبد الناس الهوى ثم القوى","سفها ثم إله العالمين",38,"ن",1,0],["يعبث بي كما يشا","في هواه حكمه",39,"م",2,0],["يُعبِّسُ إنْ لاقى المُدجَّجَ ثائراً","وإن زاره وفدُ العُفاة تهَلّلا",40,"ل",2,0],["يعبد العقل واهب العقل رباً","ولذا الله أوجد الانسانا",41,"ن",2,0],["يَعبق العطر مِن مَديحي لسعد","وَلِمَولاي عامر القرشي",42,"ي",1,0],["يعبق مسك خاله عن ارج","ما المسك ما الندّ الذكي ندّه",43,"د",2,0],["يعبُّ ذو المجد عبابا وَلا","يَرضى عَلى الظماة سَقيا رشاش",44,"ش",1,0],["يعبسُ أحياناً ويضحكُ تارةً","وفي كل وقتٍ وجهُ مالِكَ رُوقُ",45,"ق",1,0],["يُعَبِّسُ عن بَرقٍ به مُتَبَسِّمٍ","عُبُوسَ بخيلٍ في تبسُّم مُعتَفِ",46,"ف",1,0],["يعبس الظبي من تكلم نشوا","ن فيخشى من وجنتيه مراما",47,"م",2,0],["يُعبّر عن عليا حسين وآله","وفوق المباني تنجلي همة الباني",48,"ن",2,0],["يعبد الأقوامُ ما يخشونَهُ","وأنا أعبد ما لستُ أخافْ",49,"ف",1,0],["يعبد السحر لحظه ما تراه","يا ابن ودي في جفنه ذا انكسار",50,"ر",1,0],["يَعبّ فيهِ غَيرَ مُستَفيقِ","لا يَترُك الصّبوح لِلغَبوقِ",51,"ق",1,0],["يعبره الكرام أيام النما","وللرد تبدي والعذاري الهمما",52,"م",2,0],["يعبق الطيب من مجسِ خطاهن","نَ ويعشى جمالهن العيونا",53,"ن",2,0],["يَعبَد الأَثرة الَّتي لَم تُغادر","مِن مَعين الوَفاء إِلّا بَريقا",54,"ق",2,0],["يَعبُدُ المَعنى لذاتٍ","لا صِفاتٍ في مشبّب",55,"ب",1,0],["يعبرُ عني ولا مسهبٌ","ولا عازبُ الحلمِ عن جهلهِ",56,"ل",2,0],["يَعبُرُ العِطرُ بي كَمَا","يَعبُرُ الحِبرُ باللَّبَنْ",57,"ن",1,0],["يعبق من أنفاسها وثغرها","رِيّ الخُزامَى الغض، والقرنفل!",58,"ل",1,0],["يعبد الله به من خلقه","وحده لا رب معبود سواهْ",59,"ا",2,0],["يعبونها عبا على نهم وهم","على حال من ظلت مشاربهم تصفو",60,"ف",2,0],["يعبقُ الرَّوضُ بالأريجِ وينسابُ","نسيمٌ عذبُ الهبوبِ لَعُوْبُ",61,"ب",1,0],["يعبس الدهر ثم يبسم حيناً","هكذا هكذا نقضي السنينا",62,"ن",2,1],["يعبون مسفوح النجيع بلهفة","من الخصم لا يخشون سود المصائب",63,"ب",1,0],["يعبد التبر ولا يذ","كر ربا وتبارا",64,"ر",2,0],["يعبئ نظرتَه جبروتا","يطلُّ بها ويطيلُ السكوتا",65,"ت",2,1],["يعبر الجرحَ ومضنا لايبالي","ماأضرّ الضياءَ ليلُ الحداد",66,"د",1,0],["يعبق الحرف في سطورٍ ويعطي","لذة الشم في أنوف المعاني!",67,"ن",2,0],["يعبق الزهر حبه إثر شكرٍ","يتباهى بقده الفتّان",67,"ن",1,0],["يعبق الزهر وجده في خشوع","ترسل الشمس حبّه بانشراح",68,"ح",1,0],["يعبر الجسرَ ظلّنا دون وجهٍ","شارد الذهن ناقما باغتياظِ",69,"ظ",1,0],["٣- يُعبِّدُ حُبَّهُ طولاً","ويرصفُ صِدقَهُ عرْضا",70,"ض",2,0],["يَعبُرُ الناسُ صِراطاً فوقَها","شَعْرة ًحدَّتْ كسيْفٍ ذلِق ِ!",71,"ق",1,0],["يَعْبِقُ الزَّعْفُرانُ والزَّعْترُ البَريُّ","فيها والآسُ والآنِسونُ",72,"ن",1,0],["يعبر بي آفاق الخيال الواسع","ويكتب حضوري في مكان غيابي",73,"ب",2,0],["يَعْبُرُونَ البِلادَ بَرًّا وَبَحْرًا","مِنْ ظَفَارٍ إِلى ذُرَى إِرْبِيلِ",74,"ل",1,0],["يعبئ قلبي سلالَ الأماني","ويخلع خوفي.. رداءَ الحذر",75,"ر",1,0],["يعبرون الحياة فوق جسورٍ","لا ترى بعدهنَّ إلا الخلودا",76,"د",2,0]]}