{"poems":[[65,"يا بن الخلائف لا تذل لنكبة","https://www.aldiwan.net/poem45922.html","الكامل"],[37,"عرفت الدار كالخلل البوالي","https://www.aldiwan.net/poem39097.html","الوافر"],[53,"متهلل زجل تحن رواعد","https://www.aldiwan.net/poem65503.html","الكامل"],[76,"يا لين عطفي واخضرار جنابي","https://www.aldiwan.net/poem12874.html","الكامل"],[76,"الليل إلا حيث كنت طويل","https://www.aldiwan.net/poem13223.html","الكامل"],[164,"يا طيب ما يهدى قبيل الفجر","https://www.aldiwan.net/poem58782.html","الرجز"],[276,"بمحمد خطر المحامد يعظم","https://www.aldiwan.net/poem52125.html","الكامل"],[580,"هيهات ما حالي كحالك","https://www.aldiwan.net/poem3043.html","مجزوء الرمل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46523","الرجز"],[1413,"","https://poetry.dctabudhabi.ae/diwan/poem/204398","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104963","الكامل"],[3557,"","https://poetry.dctabudhabi.ae/diwan/poem/140210",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[5219,"منة الرحمن في بردة النبي العدنان","https://www.poetsgate.com/ViewPoem.aspx?id=195106",""],[5685,"في مدح الحبيب المصطفى صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=34734",""],[5691,"سفارة فوق الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=206030",""],[5725,"افلت شموس","https://www.poetsgate.com/ViewPoem.aspx?id=181255",""],[5956,"هجاء","https://www.poetsgate.com/ViewPoem.aspx?id=192939",""]],"verses":[["فَسَجِيَّةُ الأُمَويِّ كِبْرٌ زانَهُ","كَرَمٌ وَجُودٌ دَبَّ فيهِ باسُ",0,"س",1,0],["فَسَجّفنَ الخُدورَ بِكُلِّ وَجهٍ","نَقِيٍّ لَونُهُ كَسَنا الهِلالِ",1,"ل",1,0],["فسجا وأسعد حالبيه بدرة","منه سواعدُ ثرَّةٌ وعروق",2,"ق",1,0],["فَسَجَعتُ ثُِمَّ حَمامَةً وَمِنَ المُنى","أَنّي اِستَعَرتُ لَها جَناحَ غُرابِ",3,"ب",1,0],["فَسَجَعتُ في قَيدِ الشَكاةِ مُغَرِّداً","طَرَباً وَلِلطَرفِ الرَبيطِ صَهيلُ",4,"ل",1,0],["فسجعها ونثرها ونفثها","كالماء أو كالدر أو كالسحر",5,"ر",1,0],["فسجدت مفتخرا وَقلت أَنالها","جاهى وَحبل وَسيلَتي لا يصرم",6,"م",1,0],["فسجدتُ لمَّا جاءَني","شكراً لبرِّك واحْتِفَالِكَ",7,"ك",1,0],["فَسَجَدَ الزوج وَقالَ شُكراً","لَيسَ يَجُر النكر إِلا النكرا",8,"ر",2,0],["فسجدت للرحمن عند عيانه","وعقدت عقد اللثم في عنوانه",9,"ه",1,1],["فسجمت فيها من دموعي ديمة","وسجرت من حرّ الزفير شهابا",10,"ب",2,0],["فسجّلتُه فيها بغير رويّةٍ","فكان لدى الإنشادِ نوعاً من الهُجْر",11,"ر",1,0],["فَسَجَدا مِن فَوقِ ذاكَ المَجلِسِ","وَصَرَخا بِذِلَّةِ المُلتَمِسِ",12,"س",1,0],["فَسَجَّلَ الحَقُّ لِلصِّدِيقِ مَا نَطَقَتْ","شِفَاهُهُ لَمْ يُجِبْهَا بَاطِلَ التُّهَمِ",13,"م",1,0],["فسجدتَ لله العظيم مسبحا ً","ولواءُ حَمْدِ الله في يُمْناكا",14,"ك",2,0],["فسِجِلُّ جَرائِمِهِ قانٍ","كمُحيطاتٍ بدَمٍ تضْفو",15,"ف",2,0],["فسجى على نور الخدود كحالكٍ","اسرى بادبار النجوم حبائكا",16,"ك",2,0],["فَسِجِلُّكَ المملوءُ بالشَّرِّ اْشتكى","وأنا الذي لا أستريحُ لمُدَّعي",17,"ع",2,0]]}