{"poems":[[53,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[53,"عجبا يا قوم للصنع","https://www.aldiwan.net/poem66737.html","مجزوء الرمل"],[47,"غال صبري إما سألت بصبري","https://www.aldiwan.net/poem63641.html","الخفيف"],[240,"لو بات من يلحي عليك مسهدا","https://www.aldiwan.net/poem32100.html","الكامل"],[376,"يا من سحائب جوده","https://www.aldiwan.net/poem57106.html","مجزوء الكامل"],[382,"ذلت لعزة دينك الأديان","https://www.aldiwan.net/poem59237.html","الكامل"],[563,"أفعال رب الخلق روضة عطرِهِ","https://www.aldiwan.net/poem34466.html","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38326","الخفيف"],[5376,"يا نبيُّ اللهِ يا نورُ السما","https://www.poetsgate.com/ViewPoem.aspx?id=188536",""],[5431,"دون نعلك أقسى!!...","https://www.poetsgate.com/ViewPoem.aspx?id=202123",""]],"verses":[["بك صار السَّنيّ حَظِّي وقدْماً","كان حَظِّي كأُكْلَة المعْمُودِ",0,"د",1,0],["بك صار المزُور رَحْلي وقَدْ كَا","نَ بحال المريض غيرِ المَعُودِ",0,"د",1,0],["بك صارتْ نِعمُ اللَّ","هِ على الخلقِ رزايا",1,"ا",3,0],["بِكَ صافاني الزَمانُ وَقَد كُن","تُ قَديماً أُنحي عَلَيهِ وَأُزري",2,"ر",2,0],["بِكَ صُنتُ وَجهي أَن يُذالَ وَمائَهُ","مِن أَن يُراقَ حَياؤُهُ فَيُبَدَّدا",3,"د",2,0],["بكَ صارتِ الفُرسانُ تُد","عَى من سُلَيمٍ بالسَّلامَه",4,"م",2,0],["بك صَدَّقَ الإنجيلَ كلُّ موفَّقٍ","وتداولَت مدحاً له الأزمان",5,"ن",1,0],["بك صائم الأغيار فرحة فطره","يا من إذا بخل الغمام بقطره",6,"ه",1,0],["بِكَ صيتٌ كَالمِسكِ ضمّخَ طيباً","كُلَّ مَن في الأَكوانِ وَالأكوانِ",7,"ن",1,0],["بكَ صافحْتُ جمالاً في العلا","فسموْتُ الأوجَ أرقى الأنجما",8,"م",2,0],["بك صار الفؤادُ دنّ خمورٍ","لك طابت حدائق الشعر غرسا",9,"س",2,0],["بك صلى مدثرا كنبيٍ","بك أعطى مفاتحَ الحسّ قدْسا",9,"س",2,0]]}