{"poems":[[47,"أمحلتي سلمى بكاظمة اسلما","https://www.aldiwan.net/poem65659.html","الكامل"],[68,"رأى فرسي إسطبل موسى فقال لي","https://www.aldiwan.net/poem38782.html","الطويل"],[50,"خلق الشباب وشرتي لم تخلق","https://www.aldiwan.net/poem64445.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54563","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55048","الكامل"],[159,"مريض كر الطرف من غير مرض","https://www.aldiwan.net/poem55644.html","الطويل"],[216,"أشاقك رسم أم أشاقك مربع","https://www.aldiwan.net/poem37864.html","الطويل"],[216,"محل بمسيال النجيد دريس","https://www.aldiwan.net/poem37873.html","الطويل"],[280,"نادتك أندلس فلب نداءها","https://www.aldiwan.net/poem25647.html","الكامل"],[463,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[463,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[556,"وللغصن يرمى كل يوم بشاذب","https://www.aldiwan.net/poem48066.html","الطويل"],[578,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"],[1217,"","https://poetry.dctabudhabi.ae/diwan/poem/143767","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56630","الكامل"],[1633,"","https://poetry.dctabudhabi.ae/diwan/poem/145467","الطويل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46457","الطويل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21433","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129940","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62923","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62825","الكامل"],[4797,"كيك وعسل","https://www.poetsgate.com/ViewPoem.aspx?id=51279",""],[4984,"الأنباء","https://www.poetsgate.com/ViewPoem.aspx?id=180975",""],[5455,"الوصية","https://www.poetsgate.com/ViewPoem.aspx?id=213961",""],[192,"سيّد العرضة","https://www.poetsgate.com/ViewPoem.aspx?id=16357",""]],"verses":[["تَقَعُ الأُمورُ بِجانِبَيهِ كَأَنَّما","يَبغينَ رَضوى أَو يَرُمنَ يَرَمرَما",0,"م",2,0],["تُقَعقِعُ مِن بَردِ الشِتاءِ أَضالِعي","لِما نَسَجَتها مِن جَنوبٍ وَشَمأَلِ",1,"ل",1,0],["تَقَعُ السِهامُ وَرائَهُ وَكَأَنَّهُ","أَثَرَ الخَوالِفِ طالِبٌ لَم يَلحَقِ",2,"ق",1,0],["تَقَعُ الدُّهُورُ وَكُلُّ جَيْشٍ ظَافِرٍ","مِنْ دُونِهِ وَثَبَاتُهُ مُتَغَلِّبُ",3,"ب",1,0],["تَقَعُ القَشَاعِمُ دُونَهَا وَتَمُرّ فِي","هُوجِ العَوَاصِفِ كَالشِّهَابِ المَارِقِ",4,"ق",1,0],["تُقْعِدُهُ أَرْدافُهُ إِذا نَهَضْ","كأَنَّهُ لَيْسَ لَهُ مِنْها عِوَضْ",5,"ض",1,0],["تَقَعْوَسَ حتى طَحْطَحْتُه يد البِلى","وتحشي عليه التربَ صِرّ وزعزع",6,"ع",1,0],["تَقَعْوَسَ لما دَمَّرتْهُ يدُ البِلى","صحائفُ منه مُزِّقَتْ وطُروسُ",7,"س",1,0],["تَقَعُ الجَلائلُ وهْو راسٍ راسخٌ","فيها يُوقّعُ للسعودِ جلاءَها",8,"ا",3,0],["تقع الدائرات دونك حَسرَى","ورحاها على عداك تدورُ",9,"ر",1,0],["تقع الأماني دون ما","تَثنِي بهِ أسحارُها",10,"ر",3,0],["تَقَعقَعُ في جوّ السّماءِ رعودُه","ويوقِد فيه البرقُ نارَ الحُباحبِ",11,"ب",1,0],["تَقَعُ السَنابِكُ بِالصَفا فَتَرى بِهِ","آثارَها كَالطابَعِ المَختومِ",12,"م",1,0],["تقعد فوقي لأي معنىً","للفضل للهمة الرئيسه",13,"س",2,1],["تقع العيون على أنامله","فكأنها من أهلها قبل",14,"ل",1,0],["تقعقعت الأسنان في الفم وانزوت","مفاصلنا من برده والرواجب",15,"ب",1,0],["تَقعقع مثل الشَق فَوقَ جُسومهم","فَلَيسَ بِها في البَرد يَنتَفع الجسم",16,"م",1,0],["تَقَعّدته عَصراً طَويلاً أَروضُه","يَلين وَيَنبو تارةً حينَ أَركَبُ",17,"ب",1,0],["تقَعقَعتِ الآفاقُ رعداً وأشعلَت","بروقاً ونادى بالقيامةِ داعي",18,"ي",1,1],["تقع الطير على الوحشِ بها","ويَلُفُّ الوحشَ بالطَّيرِ الغُبَارُ",19,"ر",1,0],["تقعُ النسورُ من الزّماجرِ وسطَه","وتطيحُ فيه كواسرُ العِقْبانِ",20,"ن",1,0],["تقعد تحبه وانت ساكت ومغبون","يمكن بيوم يقال له موفاكله",21,"ل",2,0],["تقع الحوادث لا تفسر سرها","حتى استوى منها الجديد وسابق",22,"ق",1,0],["تقعد الدنيا وتقوم ولا يضاما","واحدٍ منهم وشمس الكون حيه",23,"ي",2,0],["تقعّدهم وتسمعهم من أولهم إلى التالي","ولا تغضب ولا تضجر ولا يخفاك خافيها",24,"ي",3,0]]}