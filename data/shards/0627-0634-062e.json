{"poems":[[108,"ناصر الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179359",""],[146,"يا ماء لينة لو نقعت أوامى","https://www.aldiwan.net/poem58373.html","الكامل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83303","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63938","الخفيف"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104811","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89559","البسيط"],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124715","الخفيف"],[3187,"","https://poetry.dctabudhabi.ae/diwan/poem/138774",""],[5953,"آل أحمد حسبي","https://www.poetsgate.com/ViewPoem.aspx?id=93838",""],[5953,"الله أكبر قددنا الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=93791",""],[6031,"يا نَسيمَ الشَمالِ أدِّ رِسَالا","https://www.poetsgate.com/ViewPoem.aspx?id=46264",""]],"verses":[["أشخاص مسرحك الأمواتُ تحسبهم","فوق الصحائِفِ من عَظْم ومن عَضَل",0,"ل",1,0],["أشخاصُهم لا حِسَّ في عَرَصاتها","وقلوبُهم ثكَلى من الأفهامِ",1,"م",1,0],["أَشخَصَت نَحوَكَ العُونُ حَيارى","أُمَمُ الخافِقينَ وَالأَقوامِ",2,"م",1,0],["أَشْخَصْتُها هِيفَ المعاني غِيدَها","فأرى الورى جذلاً بها الإِشخاص",3,"ص",1,0],["أُشَخِّصُ نُورَ الهَاشِمِّى مُحَمَّدٍ","حَبِيبِى وَحِبِّ القَومِ إِذ كانَ سَيِّدَا",4,"د",2,0],["أَشخاصهُم تَحتَ أَطباقِ الثَرى وَهُمُ","كَأَنَّهُم بَينَ أَهلِ العِلمِ قَد نُشِروا",5,"ر",3,0],["أشخصتني عنه النوى بعد ما طا","ل ثواني بجوّه ومقامي",6,"م",2,0],["أشخصوا فوَّارَةَ العلم على","حالةٍ طبَّقت الدنيا صِياحا",7,"ح",2,0],["أشخاص نور أراها","من دون عيني بقلبي",8,"ي",1,0],["أشخاص كل معظم ومقدس","ومرفع أعيانهم فصح",9,"ح",1,0],["أشْخَصَتْنِي عنهُ النوى بعد ما طا","لَ ثَوَائي بِجَوِّهِ ومَقَامِ",10,"م",1,0]]}