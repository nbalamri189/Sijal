{"poems":[[55,"إياك عنه عذل العاذل","https://www.aldiwan.net/poem29842.html","السريع"],[55,"إطمح بطرفك هل ترى","https://www.aldiwan.net/poem30202.html","مجزوء الكامل"],[53,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[91,"اطمئني يا نفس بعد اضطراب","https://www.aldiwan.net/poem44698.html","الخفيف"],[64,"أما الزمان ففي تنبيهه عظة","https://www.aldiwan.net/poem52472.html","البسيط"],[68,"كم ساهر حرم لمس الوساد","https://www.aldiwan.net/poem38652.html","السريع"],[107,"من هيبة يغضي القريض ويطرق","https://www.aldiwan.net/poem42076.html","الكامل"],[107,"لمن دم في مغاني الحي مطلول","https://www.aldiwan.net/poem42135.html","البسيط"],[52,"اسقني يابن أسعدا","https://www.aldiwan.net/poem63949.html","مجزوء الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85359","المجتث"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16703","الكامل"],[102,"ذكريات شيخين","https://www.poetsgate.com/ViewPoem.aspx?id=50390",""],[102,"عتيادان","https://www.poetsgate.com/ViewPoem.aspx?id=50338",""],[101,"مهرجة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=362&r=&rc=67",""],[102,"اعتيادان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67682&r=&rc=169",""],[124,"كل يوم لي شكاة","https://www.aldiwan.net/poem49324.html","مجزوء الرمل"],[164,"أطمع في الوصل وما أناله","https://www.aldiwan.net/poem58915.html","الرجز"],[236,"ما بين بعدك والتداني","https://www.aldiwan.net/poem44556.html","مجزوء الكامل"],[240,"يا من يهز قوامه","https://www.aldiwan.net/poem31732.html","مجزوء الكامل"],[242,"يا أخا اللب يا بديع القيل","https://www.aldiwan.net/poem18869.html","الخفيف"],[255,"وصل الجسم منذ بنتم سقامه","https://www.aldiwan.net/poem15032.html","الخفيف"],[325,"أطمعتني بالجود حين بدأتني","https://www.aldiwan.net/poem61770.html","الكامل"],[369,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"],[463,"أخوي والعشاق إخوه","https://www.aldiwan.net/poem55820.html","مجزوء الكامل"],[463,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[505,"إطمس مشاهدك التي","https://www.aldiwan.net/poem37971.html","مجزوء الكامل"],[567,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48758","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63720","السريع"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96604","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64913","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64897","السريع"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136137","الخفيف"],[1385,"","https://poetry.dctabudhabi.ae/diwan/poem/178072","الرمل"],[2162,"","https://poetry.dctabudhabi.ae/diwan/poem/96050","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53155","السريع"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60940","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100245","السريع"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115740","الطويل"],[2983,"","https://poetry.dctabudhabi.ae/diwan/poem/133933","الرمل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108102","البسيط"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46035","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111416","الكامل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107483","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125853","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123502","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73150","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28760","المنسرح"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28744","البسيط"],[4691,"قد نما الحب بقلبي فنما","https://www.poetsgate.com/ViewPoem.aspx?id=60870",""],[4955,"تمضي بنا الأيام دون رجوع","https://www.poetsgate.com/ViewPoem.aspx?id=211498",""],[3271,"راهب الغرب","https://www.poetsgate.com/ViewPoem.aspx?id=103195",""],[5118,"فيّة الليمون","https://www.poetsgate.com/ViewPoem.aspx?id=129792",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[5376,"للقدس آهٍ ولبغدادَ آهات","https://www.poetsgate.com/ViewPoem.aspx?id=188467",""],[5461,"حبيتك بلا عقل","https://www.poetsgate.com/ViewPoem.aspx?id=33604",""],[5544,"موطني","https://www.poetsgate.com/ViewPoem.aspx?id=213413",""],[470,"القافلة","https://www.poetsgate.com/ViewPoem.aspx?id=178094",""],[5582,"قِف بِالرسومِ الخاليات مخاطباً","https://www.poetsgate.com/ViewPoem.aspx?id=63456",""],[6019,"رحيقُ الوفاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=120903",""]],"verses":[["أَطمَعَني حَتّى إِذا جِئتُهُ","كانَ سَرابَ البَلَدِ الماحِلِ",0,"ل",1,0],["إِطمَح بِطَرفِكَ هَل تَرى","إِلّا مُصاباً أَو مُعَزّى",1,"ز",2,1],["أطمح كالنسر في السُّكاك ولا","أخلد إخلاده إلى الجيف",2,"ف",1,0],["اطمئني يا نفس بعد اضطراب","قد أقض الفراش منك اطمئني",3,"ي",1,1],["اطمَحْ بطرفكَ وانظرْ هل ترى وزراً","في مطمعِ النَّسْرِ أو في مسبح الحُوتِ",4,"ت",1,0],["أَطمَعَهُ حُلوُ مِراحِ الطَلا","وَهامَ لَمّا ماسَ دَلّاً وَماد",5,"د",1,0],["أطمعتَهم فتنازعوا فيك المدى","وأبَيْتَ فانقلبوا وكلٌّ مُخفِقُ",6,"ق",1,0],["أطمَعْنَ ذا الشَّوقِ حتّى لم يَدَعْ أملاً","ثُمَّ انصرَفنَ وما فيهنَّ تَأميلُ",7,"ل",1,0],["أَطمِعينا كَيما نَعي","شُ وَقولي لَنا غَدا",8,"د",2,0],["أَطماعه لَيسَ تَمضي","حَتّى تَجيء المَنايا",9,"ي",2,0],["أطْمارَ صِلٍّ وَقَّرَتْهُ رَكَانَةٌ","أنْ يُزْدَهى بصَباً ولا زَعْزَاعِها",10,"ع",3,0],["أطمتنا .. وألحّت في النوى","عن يدينا ، وتشهّينا ألح",11,"ح",1,0],["أطمئني.. لدي غير التسلي","ما أعادي من أجله وأعادى",12,"د",2,0],["إطمئني .. فلن ازور نفسي","قدر النسر أن يظل طليقا",13,"ق",2,0],["اطمئي … لديّ غير التسلّي","ما أعادي من أجله وأعادى",14,"د",2,0],["أطمع القلب وما زود","غير الحسرات",15,"ت",1,0],["أَطمع في الوصل وما أَناله","وغرّني بقوله أَنا لهُ",16,"ل",2,1],["أطمعتني حتى إذا","ملك الهوى طوعا عناني",17,"ن",2,0],["أَطمَعتَني حَتّى إِذا","عَلِقَ الفُؤادُ هَجَرتَني",18,"ن",2,0],["أَطْمَعَتْنِي إِذْ أَطْعَمَتْنِي جَنَاهَا","فِي مَقَامٍ فَلَمْ أُطِقْ مِنْ قِيلِ",19,"ل",1,0],["أطمَعَتني الآمالُ إذ كل ما اشتَقتُ","زماناً يثعِيدُ لي أيَّامَه",20,"م",2,0],["أَطمَعتَني بِالجودِ حينَ بَدَأتَني","بِجَلائِلِ النُعماءِ وَالإِكرامِ",21,"م",1,1],["أطمعْتَ في الدَّهْرِ الظَّفَر","فلا تَعلّلْ بالعِذَر",22,"ر",1,0],["أطمِعتُما من بعد يو","مِ عُنيزَةٍ في يوم سَلْوَهْ",23,"و",2,0],["أطمعتَه وفارسٌ سريرهُ","أرضَ العراق عَنْوَةً والجبلا",24,"ل",2,0],["إطمِسْ مَشاهِدَكَ التي","تبدو وأنتَ المَنْبَعُ",25,"ع",1,1],["أطمعتُ عيني برَصدِ الطَّيفِ مُنتظِراً","زيارةَ الزُورِ في ضغْثٍ من الحُلُمِ",26,"م",1,0],["أطمعتموه فاستطال عليكمُ","متنمراً وانساب فيكم مثخنا",27,"ن",2,0],["أطمعني في مِثْلِهِ مُطْمِعٌ","من خاطري لا كان من خاطر",28,"ر",1,0],["أَطمَعنَنا منهنّ وصلَ إِياسنا","فَتخالهنّ فَواركاً وَحَبائبا",29,"ب",2,0],["أَطْمَعْتَني بِلَطيفِ وَعْ","دِكَ في وصالِكَ فإقْتَضَيتُكْ",30,"ك",1,0],["أَطْمَعَنا في الخُلْدِ ما نِلْتَنا","مِنْ سُنْدُسٍ فيهِ وإِسْتَبْرقِ",31,"ق",1,0],["اطمأنت على التقى فاجتباها","وله اخلصت وصلت وصامت",32,"ت",1,0],["أطمعَ الدَّهرَ بنوه إِذْ رأوا","أكْبَرَ النِّعْمة ظِّلاً وحُطاما",33,"م",2,0],["أطمعتم فيكم عدوكم","فسما بهم في ذاكم الطمع",34,"ع",1,0],["أطمعني في صيده لاعباً","بين ظباء الحيّ في قُرْطُق",35,"ق",1,0],["أطْمَعْتُموني ثم أخْلقتم فَما","أغلاكم بيعاً وما أحْلاَكم",36,"م",1,0],["أطمح بالعين إلى عينه","مآفة الإنسان إلا الطماح",37,"ح",1,0],["أطمعتني في الوصل حتى ما تحكّمت","أيادي الهوى أعرضت عني تبرّما",38,"م",2,1],["أطمع الغاصب في استعباده","أمته في كيدها الغاصب جدا",39,"د",2,0],["أطمعته حينما عاودتَ مرتجياً","منه كذاك الترجي يورث الطمعا",40,"ع",2,1],["أطمعتَهُم مُستَطرداً حَتّى إِذا","طمعوا طَلعتَ فَكانَ عودُكَ أحمدا",41,"د",2,0],["أَطَمِعتَ في ذَهَبٍ بهِ يَأتِيكَ مِن","إِليُونَ مُلتَمِسٌ قَبُولَ الفِديةِ",42,"ه",1,0],["أطمَعُ ان أجري معك","لكن أَردتُ أَتبعَك",43,"ك",1,0],["أطْمَمعَ فيكم ضدَّكُمْ","ما بينكم تناحر",44,"ر",1,0],["أطمعتمو فىّ العذول فغرّه","جسمى النحيل وعقلى المخلوس",45,"س",1,0],["أَطمعتُموني في الوصالِ وليسَ لي","إلاَّ صُدودٌ منكمُ ونُزوحُ",46,"ح",1,0],["أَطمَعَني فيكَ حُسنُ ظَنِّكَ بي","لا خَيَّبَ اللَّهُ ذلِكَ الطَّمَعا",47,"ع",2,0],["أَطمَعتَنِي في الهَوى حَتَّى إِذا سَمحَت","نَفسي مُنيتُ بِحَبلٍ مِنكَ مُنصَرِمِ",48,"م",1,0],["أطمع القلب فلما جئته","أسأل الوصل َ أبى أن يُنعما",49,"م",2,0],["أطماعنا زادت وماتَ ضميرنا","والعطفُ كُفِّنَ من وراءِ ضلوعِ",50,"ع",1,0],["أطمعتْهُ غضاضةُ القوم حتّى","ظنّهم ضلّةً لديهِ أُسارى",51,"ر",2,0],["اطمّن .. جرحي الأوحد .. ويتكدس سمار الكون","__________ أعّلق .. وجهي الأكْئَب .. على مراياتي .. مكسوره",52,"ر",2,0],["اطماعه حلم بحياه في صلف","فلا (فرات) كما ينوي ولا (نيل) !",53,"ل",1,0],["أُطمْئنُ النفسَ بما كَرَبَتْ","للبدرِ نورٌ شعَّ بالغيبِ",54,"ب",1,0],["اطمئن آني بلا عقل","والكلب عندك مشغول",55,"ل",1,0],["إطمئني فمذ خلقنا خلقنا","أوفياء لا يقرب الذم منا",56,"ن",2,0],["أطموحٌ أنَّ ابن آدمَ يبني","وهو يدري بأنه للزَّوالِ؟",57,"ل",1,0],["أَطْمَعْنَنا وَصْلاً كَما أَيْأَسْنَنا","فَنَخالُهُنَّ فَوارِكاً وَحَبائِبَا",58,"ب",2,0],["أُطمئِنُ \\\"ليلى\\\" : لا تخافي فلمْ يزلْ","هواكِ الذي أضناهُ في قلبه حِكرا ..",59,"ر",2,0]]}