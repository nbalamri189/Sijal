60,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[460,"ليل السرى مثل نهار المقام","https://www.aldiwan.net/poem55886.html","السريع"],[460,"مالك لا تطرب يا حادي النعم","https://www.aldiwan.net/poem55901.html","الرجز"],[460,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[460,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[460,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[460,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[460,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[460,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[463,"هبني كتمت لواعج البرحاء","https://www.aldiwan.net/poem15279.html","الكامل"],[466,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[470,"وليلة أيقظني معانقي","https://www.aldiwan.net/poem59521.html","الرجز"],[516,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[516,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[517,"سفر الزمان بواشح من بشره","https://www.aldiwan.net/poem12098.html","الكامل"],[531,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[553,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[553,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[564,"ماذا لقيت من الحبيب وحبه","https://www.aldiwan.net/poem52950.html","الكامل"],[577,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"],[577,"وافى سليل العلا وقد شهدت","https://www.aldiwan.net/poem3093.html","المنسرح"],[588,"فرق بيني وبين مصطبري","https://www.aldiwan.net/poem17538.html","المنسرح"],[712,"","https://poetry.dctabudhabi.ae/diwan/poem/20573","الرمل"],[814,"","https://poetry.dctabudhabi.ae/diwan/poem/123316","الكامل"]],"verses":[["مَن طَلَبَ العِزَّ بِغَيرِ السَيفِ ذَل","وَاِمشِ إِلى المَجدِ وَلَو عَلى الأَسَل",0,"ل",1,0],["مِن طَموحٍ خَطَمتَهُ وَجَموحٍ","بِكَ أَعضَضتَهُ الشَكيمَ فَلاكا",1,"ك",2,0],["مَن طاحَ في سُبُلِ الرَدى آباؤُهُ","فَليَسلُكَنَّ طَريقَهُ أَبناؤُهُ",2,"ا",3,0],["مَنْ طَلَبَ الودَّ مِنْ سَلاوِي","أنْشأهُ اللهُ منْ مَساوِي",3,"ا",3,1],["مُنطِقاتٍ لِسانَ كُلِّ جَمادٍ","مُفحِماتٍ سَواجِعَ الأَفنانِ",4,"ن",1,0],["مِن طولِ ما عَلى الكَلالِ","في كُلِّ لَمّاعٍ بَعيدِ الجالِ",5,"ل",1,0],["مُنطوياتٍ عني كما انقبضتُ وقد يُقبِض","بعد انبساطه السَّبَبُ أي الحَبل",6,"ب",2,0],["منطويات كما انطويت وقد","يقبض بعد انبساطه السبب",7,"ب",1,0],["منطبخ الأحشاء بالهمِّ لا","يزال في حلّة مغموم",8,"م",1,0],["منطلق الكف واللسان إذا","سوئل وامتيح أيَّ منطلق",9,"ق",1,0],["منطقيّاً تصرِّفُ الجنسَ والفص","ل وما ولَّدا جموعاً فروقا",10,"ق",2,0],["منطقٌ يطرحُ الكُنى ويسَمّي","منْ يُكنَّى ولا يُبالي مُبالا",11,"ل",2,0],["من طرازِ الملوكِ فيها الفكاها","تُ وفيها سوائر الأمثالِ",12,"ل",1,0],["من طرّقتْ ديمُ السماءِ له","نُبذتْ إليه مقالدُ السَّلَمِ",13,"م",1,0],["مِنْ طموحٍ إلى الجمالِ إلى الفنِّ","إلى ذلك الفضاءِ البعيدِ",14,"د",1,0],["مِنْ طيورٍ وزُهورٍ وشذًى","وينابيعَ وأَغصانٍ تميدْ",15,"د",1,0],["مِن طولِ ما أَبصَرَهُ الناسُ نُسي","وَصارَ كُلُّ الذِكرِ لِلمُهَندِسِ",16,"س",1,0],["مِن طاعِني ثُغَرِ الرِجالِ جَآذِرٌ","وَمِنَ الرِماحِ دَمالِجٌ وَخَلاخِلُ",17,"ل",1,0],["مَن طَلَبَ المَجدَ فَليَكُن كَعَلِي","يٍ يَهَبُ الأَلفَ وَهوَ يَبتَسِمُ",18,"م",1,0],["مَنطِقٌ صائِبٌ وَرَأيٌ أَصيلٌ","وَحِجىً راجِحٌ وَنَيلٌ رَخيمُ",19,"م",1,0],["مَنْطِقٌ يُخْجِلُ الرَّبيعَ إذا حَلْ","لَ عليه السَّحابُ عِقْدَ النِّطاقِ",20,"ق",1,0],["مَن طَلَبَ الفَضلَ إِلى","غَيرِ ذَوي الفَضلِ حُرِم",21,"م",1,0],["مَن طَلَبَ العِزَّ لَيَبقى بِهِ","فَإِنَّ عِزَّ المَرءِ تَقواهُ",22,"ا",2,0],["مَن طُفَيلٌ مَن عامِرٌ وَمَنِ الحا","رِثُ أَم مَن عُتَيبَةُ اِبنُ شِهابِ",23,"ب",1,0],["مِن طَرفِ مُمتَنِعِ الرُقادِ مُتَيَّمٍ","أَرِقٍ سَواءٌ لَيلُهُ وَنَهارُهُ",24,"ر",2,0],["مَنْ طَلَبَ الأَمْرَ بِأَسْبَابِهِ","سَاعَدَهُ الْمَقْدُورُ إِمَّا عَقَلْ",25,"ل",1,0],["مَنْطِقٌ عَذْبٌ وَمَعْنَىً","يَبْسِمُ السِّحْرُ خِلالَهْ",26,"ل",2,0],["مِنْ طرفه سيفاً نضا","مِنْ ثغرِهِ داراً نضَدْ",27,"د",1,0],["مِن طيبِ نَشرِ الَّتي تامَتكَ إِذ طَرَقَت","وَنَفحَةِ المِسكِ وَالكافورِ إِذ ثارا",28,"ر",2,0],["منطقُ القدرةِ التي تُرهقُ القا","درَ والعبقريَّ قُصورا",29,"ر",2,0],["مُنطَوٍ في مُستوى رُجبَةٍ","كَاِنطِواءِ الحُرِّ بَينَ السِلام",30,"م",1,0],["مِن طَيِّ مُنجَذِبِ الفِرا","رِ ضُروعُها مِثلُ المَكاحِل",31,"ل",1,0],["مِن طَرفِها إِني رَأَيتُ مُكَثِّراً","نَما عَلَيها لا يَريمُ إِهابُهُ",32,"ب",2,0],["مِن طائِرٍ زَمَّرَ في الآذانِ","مِنَ الدِماءِ مُترَعٍ مَلآنِ",33,"ن",1,0],["مِنْ طائِراتٍ ما لهُنّ قَوادِمٌ","أو مُقْرَباتٍ ما لهنّ أياطل",34,"ل",1,0],["مِن طينَةٍ لَم تَدنُ مِن غَضرائِها","وَلَم يُخالِطها نَقا مَيثائِها",35,"ا",3,0],["مُنَطَّقاتٍ بِتَصاويرَ لا","تَسمَعُ لِلداعي وَلا تَنطِقُ",36,"ق",1,0],["مِن طَللٍ عَفَت عَليهِ المورُ","وَجادَهُ الطُحرورُ وَالطُخرورُ",37,"ر",1,0],["مِن طَعَمِ اللَهِ المُحَيّا بِهِ","بَلجُ المُحَيّا أَريَحِيٌّ زَميتُ",38,"ت",1,0],["مَنطِقٌ مِنها وَمِنّي","غَيرُ تَحقيقِ سِبابِ",39,"ب",1,0],["مَنطِقاً لَيسَ بِالنَثيرِ وَلا الشِع","ري وَلا في طَرائِقِ الرُجّازِ",40,"ز",1,0],["من طول فحصي للحياة وأهلها","في الأرض أعلم منشئ ومصيري",41,"ر",2,0],["مِنْ طَيِّ أَرْضِيَن أَوْ مِنْ سُلَّمٍ نَزِلٍ","مِنْ ظَهْرِ رَيْمَانَ أَوْ مِنْ عَرْضِ ذِي جَدَنِ",42,"ن",1,0],["من طبع السيف ومن جلاّه","هل يصنع الآيات إلا الله",43,"ه",1,1],["مَنْ طَلَبَ الْعِزَّ بِلا آلَةٍ","أَدْرَكَهُ الذُّلُّ مَكانَ الظَّفَرْ",44,"ر",1,1],["مِنْ طِيبِ رَيَّاها وَمِنْ حُسْنِهَا","لَمْ يَبْقَ إلاَّ ذِكْرَيَاتٌ تَضُوعْ",45,"ع",1,0],["مُنْطَادِ جَوٍّ فَارِسٍ رَاجِلٍ","خَوَّاضِ بَحْرٍ فِي الدُّجَى مُبْصِرِ",46,"ر",1,0],["مِن طِرازِ اللَهِ كانَ فَلَو","ذَبَّ عَنهُ العَينَ ما ذَبلا",47,"ل",2,0],["منطقُ الهزل به جِدٌّ وكمْ","نَطق الْجِدُّ به القول الهُراء",48,"ا",2,0],["من طولِ إلفِ الأسى أنِستُ به","فإن أطالَ الجفاءَ، أوحشني",49,"ن",2,0],["من طعم الله المحيا به","بلج المحيا أيريحي زميتُ",50,"ت",1,0],["منطقٌ للعقولِ أقربُ ممَّا","يدَّعيه أخو عَفافٍ مُريب",51,"ب",1,0],["من طهرها...؟ تستحي حتااااا..؟ تصححلي.. لساني..","كني.؟؟ أذبحها... ليامن جيت اسمعها...؟؟ قصيده",52,"د",2,0],["من طياره.؟ ما تجوده العراوي","كن له.؟ والكايده. عشره حميمه",53,"م",2,0],["مِنْ طِيبِ نَشْر الَّتي نامَتْكَ إذْ طَرَقَتْ","ونفحة ِ المسكِ والكافور إذ ثارا",54,"ر",2,0],["منطبع جماله","برسمه وبالطلل",55,"ل",1,0],["مَن طَلَبَ المَعَالِى أتعَبتُه","وكَانَ لِمَا لِهِ فِيهَا مُهِينَا",56,"ن",2,0],["منطقتها بيدي وقد وسّدتها","عضدي ونلتَ من الزمانِ منائي",57,"ا",2,0],["مَن طالَ فَوقَ مُنتَهى بَسطَتِهِ","أَعجَزَهُ نَيلُ الدُنى بَله القُصا",58,"ا",1,0],["منطقُها في الوسط كالزنار","خوف الزنانير وخوف الفار",59,"ر",1,0],["من طالب الناس بالإنصاف أحقدهُم","ومن نحاهم إلى الآداب عابوه",60,"ه",1,1],["مِن طيّها سننُ الشريعةِ فرضها","نُشِرَت وطيُّ الباطلاتِ وَدَحضها",61,"ه",2,0],["مِن طينةٍ من بعدِ خلقِ العالمِ","وخصَّه بِالنورِ نورِ الهاشمي",62,"ي",1,0],["من طاب في ظله مقبلي","وعمّ بالجود كل قائل",63,"ل",1,0],["من طريف الآثار والأخبار","أن كلباً متيم بحمار",64,"ر",1,1],["مِن طَيّبينَ مَصونَةُ أَعراضُهُم","أَبَداً وَوافِرُ وَفرهُم مَبذولُ",65,"ل",1,0],["مِن طَرفِكَ الأَكحَلِ أَم ثغ","ركَ الباسِم أَمِ مِن شعرك الفاحمِ",66,"م",1,0],["من طيبين وطيباتٍ نسلُها","فالناسُ طينٌ وهي مسكٌ أذفر",67,"ر",1,0],["من طولِ ما لزمتني قد سكنتُ لها","حتى ليدركني من نأْيها جزع",68,"ع",1,0],["من طيِّبِ الأَنفاسِ والأَردانِ ذي","جفْنٍ عَلَى حلمِ التعانقِ مطبق",69,"ق",1,0],["مِن طارِقٍ يَأتي عَلى خِمرَةٍ","أَو حِسبَةٍ تَنفَعُ مَن يَعتَبِر",70,"ر",1,0],["مَن طرِّزت حللُ العلومِ بدرسهِ","فَزهت بكونِ رقومها تدبيجه",71,"ج",2,0],["مِن طَوِيِّ الثَرى نُشِرتُ بِنَشرٍ","مِنهُ عَنّي في الخافِقَينِ يَفوحُ",72,"ح",1,0],["من طَرْفِها جارحٌ ضارٍ قوادِمُه ال","أهدابُ منه وجَفْناهُ الجناحان",73,"ن",1,0],["من طُولِ ما اجتَبْنَ الحديدَ وخُضْنَه","في الرَّوعِ بَرْقَعَها سَناهُ وخَلْخلا",74,"ل",2,0],["مَن طالَ فيكَ لِسانُهُ","فأَطالَ شُغلَ الألسُنِ",75,"ن",1,0],["مِن طالِبِيها أنا المَطلُوبُ مِن زَمَني","قَصداً ومِن أهلِها مُوسىَ بن هارونِ",76,"ن",1,0],["من طاعها طاعَ العلِي","يوماً وعاصيها يُدان",77,"ن",1,0],["مَنطق يَقتل الهُموم وَيُحيي","داعيات السُرور لِلعُشاق",78,"ق",1,0],["من طلب يعطيه ربي","فوق سوله ومراده",79,"د",2,0],["من طلّق الدنيا ثلاثاً واغْتدى","للضرّةِ الأُخرى عليها مُؤْثرا",80,"ر",2,0],["من طيب أيام تقضت ليتها","دامت ونفديها بما يستطرف",81,"ف",1,0],["مَنْطِقَ الطير لقد علَّمَهُ","وله الريح مطيع إن أمر",82,"ر",1,0],["من طاب أصلاً وسما","فرعاً وإبناً وأبا",83,"ب",2,0],["من طيبِه أرجاؤكم","لا برحت تختضب",84,"ب",1,0],["من طوَّل الأيامَ عند مصيفها","وأتت قصاراً عند فصل شتائه",85,"ا",3,0],["مِن طولِها وَرواق اللَيل مُنسَدِل","وَسحبها بركام الوَبلِ كالقُرَبِ",86,"ب",1,0],["مَن طَابَ لِلجَانِي جَناهُ وَمَنْ","كَفَّر بِالعَفْوِ ذُنُوبَ الجُنَاهْ",87,"ا",2,0],["منطق مصقع ولفظ وجيز","وكلام كأنَّه الصهباء",88,"ا",2,0],["من طيِّبٍ طابَ في الأَنجاب محتده","كما يطيبُ عبيرُ الند والعود",89,"د",1,0],["من طرفها وفؤادي يستعين على","تعذيب طرفي فتانٌ ومفتونُ",90,"ن",1,0],["منطقه الجسر إذ رآه","من بهجة البدرِ في قَباءِ",91,"ا",2,0],["مُنطوي الأحشاءِ طيّاً","مثلُه طيُّ الكِتاب",92,"ب",1,0],["مَنْ طالَ أبناءَ الزمان بهمّةٍ","شرُفَتْ عن النَظراءِ والأمثالِ",93,"ل",1,0],["من طعام ومقعد وكتاب","وكؤوس تجلى بها الخندريس",94,"س",1,0],["من طيب أوصاف وَلجْنَ مسامعي","حتى سكرتُ وما عرفت المُسْكرا",95,"ر",2,0],["من طالما غنيتُ في افيائه","بروءاى حين سجنتُ في أفيائه",96,"ا",3,0],["من طاعني ثُغَرِ الخطو","بِ بكلِّ سِكِّيتٍ مفوّهْ",97,"و",2,0],["مَنْ طالبٌ بي في الظباءِ العين","والثأرُ بين سوالفٍ وعيونِ",98,"ن",1,1],["مُنطلِقٌ بأربع قوائمٍ","كأنهنّ خفةً قوادمُ",99,"م",1,0],["من طلبَ الغايةَ خطواً على","ظهر الهوينا رامَ صعبَ المرامْ",100,"م",1,0],["من طينةٍ بيضاءَ صفَّى مجدَها","تنخُّلُ الدهر وتصفيق القِدَمْ",101,"م",1,0],["من طينةٍ في المجد مجبولةٍ","تبعثُ طيباً كرمَ الجابلِ",102,"ل",1,0],["من طينة ريّا التراب جُبِلتْ","جواهرُ السؤدُد في صَلصالها",103,"ل",3,0],["من طينةٍ على الندى","مطبوعةِ الجِبِلَّهْ",104,"ل",2,0],["من طينةٍ مصمَتةٍ طائيّةٍ","يطبعها المجدُ على ما طبعا",105,"ع",2,0],["من طينةِ المُلك ملموماً على كرمٍ","لم تُنتحَتْ صخرةٌ منه بمنقارِ",106,"ر",1,0],["من طينة المجد التي فروعُها","تُنيبك عن طهارة العناصرِ",107,