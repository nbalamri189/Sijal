{"poems":[[53,"أغر أيامي مني ذا الطلل","https://www.aldiwan.net/poem29853.html","الرجز"],[53,"يا أراك الحمى تراني أراكا","https://www.aldiwan.net/poem29922.html","الخفيف"],[53,"أترى السحاب إذا سرت عشراؤه","https://www.aldiwan.net/poem30778.html","الكامل"],[77,"من طلب الود من سلاوي","https://www.aldiwan.net/poem35838.html","مخلع البسيط"],[86,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[30,"ما هاج عينيك من الأطلال","https://www.aldiwan.net/poem29544.html","الرجز"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[37,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[72,"أعيذ ريم الترك بالروم","https://www.aldiwan.net/poem19684.html","السريع"],[51,"تبارك الله خالق الكرم البارع","https://www.aldiwan.net/poem65517.html","المنسرح"],[51,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[51,"قل لمن ألبس الجمال جمالا","https://www.aldiwan.net/poem65878.html","الخفيف"],[51,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[51,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[92,"عذبة أنت كالطفولة كالأح","https://www.aldiwan.net/poem38954.html","الخفيف"],[92,"كل ما هب وما دب وما","https://www.aldiwan.net/poem38957.html","الرمل"],[85,"ألم عصفور بمجرى صاف","https://www.aldiwan.net/poem8048.html","الرجز"],[43,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[43,"أحق عاف بدمعك الهمم","https://www.aldiwan.net/poem10537.html","المنسرح"],[45,"كلفي ما أراه عنى يريم","https://www.aldiwan.net/poem66645.html","الخفيف"],[61,"قد أظلتك يا أبا إسحاق","https://www.aldiwan.net/poem51509.html","الخفيف"],[49,"من سالم الناس سلم","https://www.aldiwan.net/poem63111.html","مجزوء الرجز"],[49,"حتى متى ذو التيه في تيهه","https://www.aldiwan.net/poem63183.html","السريع"],[44,"من بنو عامر من ابن الحباب","https://www.aldiwan.net/poem30069.html","الخفيف"],[44,"هذا هواك وهذه آثاره","https://www.aldiwan.net/poem30242.html","الكامل"],[87,"ما الدهر إلا ضوء شمس","https://www.aldiwan.net/poem8362.html","السريع"],[87,"أهلال بين هاله","https://www.aldiwan.net/poem8365.html","مجزوء الرمل"],[69,"يا جامع الحسن أما","https://www.aldiwan.net/poem28853.html","مجزوء الرجز"],[31,"يا صاحبي قفا نستخبر الدارا","https://www.aldiwan.net/poem42542.html","البسيط"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[39,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[40,"قد رابه ولمثل ذلك رابه","https://www.aldiwan.net/poem42339.html","الكامل"],[52,"بت بجهد ساهر الأجفان","https://www.aldiwan.net/poem26601.html","الرجز"],[75,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[48,"وارفة للطير في أرجائها","https://www.aldiwan.net/poem10418.html","الرجز"],[48,"نزوج الخمر من الماء في","https://www.aldiwan.net/poem64425.html","البسيط"],[50,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[50,"مهلا أخي لم تلق ما قد لقيت","https://www.aldiwan.net/poem64744.html","السريع"],[50,"طال في هند عتابي","https://www.aldiwan.net/poem64825.html","مجزوء الرمل"],[46,"أوجز الدهر في المقال إلى أن","https://www.aldiwan.net/poem22772.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85819","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42627","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55019","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43824","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54320","الرمل"],[106,"فلسفة الألم","https://www.poetsgate.com/ViewPoem.aspx?id=179662",""],[50,"مَهْلاً أخِي لَمْ تَلْقَ مَا قَدْ لَقِيتُ","https://www.poetsgate.com/ViewPoem.aspx?id=19976",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[31,"يا صاحبيّ، قفا نستخبرِ الدارا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18860&r=&rc=123",""]],"verses":[["مَن طَلَبَ العِزَّ بِغَيرِ السَيفِ ذَل","وَاِمشِ إِلى المَجدِ وَلَو عَلى الأَسَل",0,"ل",1,0],["مِن طَموحٍ خَطَمتَهُ وَجَموحٍ","بِكَ أَعضَضتَهُ الشَكيمَ فَلاكا",1,"ك",2,0],["مَن طاحَ في سُبُلِ الرَدى آباؤُهُ","فَليَسلُكَنَّ طَريقَهُ أَبناؤُهُ",2,"ا",3,0],["مَنْ طَلَبَ الودَّ مِنْ سَلاوِي","أنْشأهُ اللهُ منْ مَساوِي",3,"ا",3,1],["مُنطِقاتٍ لِسانَ كُلِّ جَمادٍ","مُفحِماتٍ سَواجِعَ الأَفنانِ",4,"ن",1,0],["مِن طولِ ما عَلى الكَلالِ","في كُلِّ لَمّاعٍ بَعيدِ الجالِ",5,"ل",1,0],["مُنطوياتٍ عني كما انقبضتُ وقد يُقبِض","بعد انبساطه السَّبَبُ أي الحَبل",6,"ب",2,0],["منطويات كما انطويت وقد","يقبض بعد انبساطه السبب",7,"ب",1,0],["منطبخ الأحشاء بالهمِّ لا","يزال في حلّة مغموم",8,"م",1,0],["منطلق الكف واللسان إذا","سوئل وامتيح أيَّ منطلق",9,"ق",1,0],["منطقيّاً تصرِّفُ الجنسَ والفص","ل وما ولَّدا جموعاً فروقا",10,"ق",2,0],["منطقٌ يطرحُ الكُنى ويسَمّي","منْ يُكنَّى ولا يُبالي مُبالا",11,"ل",2,0],["من طرازِ الملوكِ فيها الفكاها","تُ وفيها سوائر الأمثالِ",12,"ل",1,0],["من طرّقتْ ديمُ السماءِ له","نُبذتْ إليه مقالدُ السَّلَمِ",13,"م",1,0],["مِنْ طموحٍ إلى الجمالِ إلى الفنِّ","إلى ذلك الفضاءِ البعيدِ",14,"د",1,0],["مِنْ طيورٍ وزُهورٍ وشذًى","وينابيعَ وأَغصانٍ تميدْ",15,"د",1,0],["مِن طولِ ما أَبصَرَهُ الناسُ نُسي","وَصارَ كُلُّ الذِكرِ لِلمُهَندِسِ",16,"س",1,0],["مِن طاعِني ثُغَرِ الرِجالِ جَآذِرٌ","وَمِنَ الرِماحِ دَمالِجٌ وَخَلاخِلُ",17,"ل",1,0],["مَن طَلَبَ المَجدَ فَليَكُن كَعَلِي","يٍ يَهَبُ الأَلفَ وَهوَ يَبتَسِمُ",18,"م",1,0],["مَنطِقٌ صائِبٌ وَرَأيٌ أَصيلٌ","وَحِجىً راجِحٌ وَنَيلٌ رَخيمُ",19,"م",1,0],["مَنْطِقٌ يُخْجِلُ الرَّبيعَ إذا حَلْ","لَ عليه السَّحابُ عِقْدَ النِّطاقِ",20,"ق",1,0],["مَن طَلَبَ الفَضلَ إِلى","غَيرِ ذَوي الفَضلِ حُرِم",21,"م",1,0],["مَن طَلَبَ العِزَّ لَيَبقى بِهِ","فَإِنَّ عِزَّ المَرءِ تَقواهُ",22,"ا",2,0],["مَن طُفَيلٌ مَن عامِرٌ وَمَنِ الحا","رِثُ أَم مَن عُتَيبَةُ اِبنُ شِهابِ",23,"ب",1,0],["مِن طَرفِ مُمتَنِعِ الرُقادِ مُتَيَّمٍ","أَرِقٍ سَواءٌ لَيلُهُ وَنَهارُهُ",24,"ر",2,0],["مَنْ طَلَبَ الأَمْرَ بِأَسْبَابِهِ","سَاعَدَهُ الْمَقْدُورُ إِمَّا عَقَلْ",25,"ل",1,0],["مَنْطِقٌ عَذْبٌ وَمَعْنَىً","يَبْسِمُ السِّحْرُ خِلالَهْ",26,"ل",2,0],["مِنْ طرفه سيفاً نضا","مِنْ ثغرِهِ داراً نضَدْ",27,"د",1,0],["مِن طيبِ نَشرِ الَّتي تامَتكَ إِذ طَرَقَت","وَنَفحَةِ المِسكِ وَالكافورِ إِذ ثارا",28,"ر",2,0],["منطقُ القدرةِ التي تُرهقُ القا","درَ والعبقريَّ قُصورا",29,"ر",2,0],["مُنطَوٍ في مُستوى رُجبَةٍ","كَاِنطِواءِ الحُرِّ بَينَ السِلام",30,"م",1,0],["مِن طَيِّ مُنجَذِبِ الفِرا","رِ ضُروعُها مِثلُ المَكاحِل",31,"ل",1,0],["مِن طَرفِها إِني رَأَيتُ مُكَثِّراً","نَما عَلَيها لا يَريمُ إِهابُهُ",32,"ب",2,0],["مِن طائِرٍ زَمَّرَ في الآذانِ","مِنَ الدِماءِ مُترَعٍ مَلآنِ",33,"ن",1,0],["مِنْ طائِراتٍ ما لهُنّ قَوادِمٌ","أو مُقْرَباتٍ ما لهنّ أياطل",34,"ل",1,0],["مِن طينَةٍ لَم تَدنُ مِن غَضرائِها","وَلَم يُخالِطها نَقا مَيثائِها",35,"ا",3,0],["مُنَطَّقاتٍ بِتَصاويرَ لا","تَسمَعُ لِلداعي وَلا تَنطِقُ",36,"ق",1,0],["مِن طَللٍ عَفَت عَليهِ المورُ","وَجادَهُ الطُحرورُ وَالطُخرورُ",37,"ر",1,0],["مِن طَعَمِ اللَهِ المُحَيّا بِهِ","بَلجُ المُحَيّا أَريَحِيٌّ زَميتُ",38,"ت",1,0],["مَنطِقٌ مِنها وَمِنّي","غَيرُ تَحقيقِ سِبابِ",39,"ب",1,0],["مَنطِقاً لَيسَ بِالنَثيرِ وَلا الشِع","ري وَلا في طَرائِقِ الرُجّازِ",40,"ز",1,0],["من طول فحصي للحياة وأهلها","في الأرض أعلم منشئ ومصيري",41,"ي",1,0],["من طبع السيف ومن جلاّه","هل يصنع الآيات إلا الله",42,"ه",1,1],["مَنْ طَلَبَ الْعِزَّ بِلا آلَةٍ","أَدْرَكَهُ الذُّلُّ مَكانَ الظَّفَرْ",43,"ر",1,1],["مِنْ طِيبِ رَيَّاها وَمِنْ حُسْنِهَا","لَمْ يَبْقَ إلاَّ ذِكْرَيَاتٌ تَضُوعْ",44,"ع",1,0],["مُنْطَادِ جَوٍّ فَارِسٍ رَاجِلٍ","خَوَّاضِ بَحْرٍ فِي الدُّجَى مُبْصِرِ",45,"ر",1,0],["مِن طِرازِ اللَهِ كانَ فَلَو","ذَبَّ عَنهُ العَينَ ما ذَبلا",46,"ل",2,0],["منطقُ الهزل به جِدٌّ وكمْ","نَطق الْجِدُّ به القول الهُراء",47,"ا",2,0],["من طولِ إلفِ الأسى أنِستُ به","فإن أطالَ الجفاءَ، أوحشني",48,"ن",2,0],["من طعم الله المحيا به","بلج المحيا أيريحي زميتُ",49,"ت",1,0],["منطقٌ للعقولِ أقربُ ممَّا","يدَّعيه أخو عَفافٍ مُريب",50,"ب",1,0],["مِنْ طِيبِ نَشْر الَّتي نامَتْكَ إذْ طَرَقَتْ","ونفحة ِ المسكِ والكافور إذ ثارا",51,"ر",2,0]]}