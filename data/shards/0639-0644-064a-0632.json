{"poems":[[82,"أخذت برأي في الصبا أنا تاركه","https://www.aldiwan.net/poem31356.html","الطويل"],[52,"ذكرت شبابي اللذ غير قريب","https://www.aldiwan.net/poem64805.html","الكامل"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72221","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43686","الوافر"],[38,"تَخَلّى عَنْ أَبي حَرْبٍ فَوَلّى","https://www.poetsgate.com/ViewPoem.aspx?id=15881",""],[309,"تفيض عيون بالدموع السواكب","https://www.aldiwan.net/poem16819.html","الطويل"],[463,"سلا دار البخيلة بالجناب","https://www.aldiwan.net/poem56296.html","الوافر"],[580,"تركت حبيب القلب تهمي جفونه","https://www.aldiwan.net/poem2847.html","الطويل"],[580,"تنسك شيطاني فيا ليته غدا","https://www.aldiwan.net/poem3081.html","الطويل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90570","الوافر"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113957","الطويل"],[1893,"","https://poetry.dctabudhabi.ae/diwan/poem/146593","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69395","الطويل"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216446",""],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121197","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100913","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83234","الوافر"],[2922,"","https://poetry.dctabudhabi.ae/diwan/poem/105339","الوافر"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87662","البسيط"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46978","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62813","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132163","الوافر"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117287","الوافر"],[5277,"ناموسُ الشهادةِ..","https://www.poetsgate.com/ViewPoem.aspx?id=207983",""],[592,"تلألأ نور الحق في الخلق واستما","https://www.poetsgate.com/ViewPoem.aspx?id=128815",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[5781,"آخر نفسٍ أنت وأوَّله....","https://www.poetsgate.com/ViewPoem.aspx?id=208825",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[6056,"وطفاء الحجاجين","https://www.poetsgate.com/ViewPoem.aspx?id=130183",""],[6056,"نار اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=130380",""]],"verses":[["عَلى زَهْرِ رَوْضٍ ناضِرٍ تَحسبُ الرّبى","مُلوكاً عَلَى الأَجسامِ مِنهُم دَرانِكُه",0,"ك",2,0],["عَلى زَينَبٍ مِنّي السَلامُ وَمِثلُهُ","عَلى شَجَنٍ بَينَ الصَبا وَجَنوبِ",1,"ب",1,0],["عَلى زَبَدِ القوائمِ أعْوجيٍّ","حَثِيثِ الركْضِ مُنْكَفِتِ التوالي",2,"ل",2,0],["عَلَى زَعْمِ أَنَّ المَال وَهْوَ شَفِيعُهُ","يَكُونُ لَدَى الحَسْنَاءِ خَيْرَ مُشَفَّعِ",3,"ع",1,0],["عَلى زَهرٍ أَنارَت مِنهُ أَرضٌ","تَهُبُّ لَهُ مِنَ الفِردَوسِ ريحُ",4,"ح",1,0],["على زَبَدِ القَوَائِمِ أعوجيٍّ","حثيث الركض منكفت القوالي",5,"ل",2,0],["على زهرات العيش لما تساقطت","بريح الأماني والظنون الكواذب",6,"ب",1,0],["على زَمَنِ الحَداثةِ لم يُفتهُ","تقدُّمُ شِيبهم قَدَمَ الشَّبابِ",7,"ب",1,0],["على زلَّةِ كانَتْ له أَو خِيانةٍ","وهل أَحدٌ في الناس غيرُ خئون",8,"ن",1,0],["عليَّ زَمَانِي قَدْ تَعدَّى جَهَالَةً","وقد كُنتُ أَعْدَى مِنْ زَمَانِي إِذَاعَدَا",9,"د",2,0],["على زهرٍ ونهرٍ قد تَثنَّى","يُفاخرُ في السَّنا بدراً وشمسا",10,"س",2,0],["عَلَى زَمَانِ السَّوءِ إِذ أقلَقَنِي","وَكُلُّ قَرنٍ ناجِمٍ فِي زَمنِ",11,"ن",1,0],["على زَورَةٍ مِثلِ الفنيقِ مُدِلَّةٍ","بهادٍ مُنيفٍ كالسقيفَةِ جرشُعِ",12,"ع",1,0],["علي زمان ليس لي ليتني أرى","طلوع زمان لا علي ولا ليا",13,"ل",3,0],["عَلى زَمَنٍ قَد عَلَّمَ الغَدرَ أَهلَهُ","فَلا تَعتَمِد مِنهُم عَلى مَن تُعاقِدُه",14,"د",2,0],["على زمانٍ ليت ما ليت","واليوم قَفَّى عنّيَ وْراح",15,"ح",1,0],["على زعمهم هب زحزفوا ما يسؤني","فما القول في عفو الوزير المؤيد",16,"د",1,0],["على زحفاتٍ بالبطونِ من الحَفا","فهنَّ أفاعٍ فوقهنَّ قلوب",17,"ب",1,0],["عَلى زَمَنِ الحَداثَةِ لَم يَفُتهُم","تَقَدُّمُهُم ضَريباً في الوِثابِ",18,"ب",1,0],["على زياقة ملسى زفوف","بأودية من الهيفات ملس",19,"س",1,0],["على زفافك تأريخاً لمطلعهِ","يا نعمة اللَه حلَّت نعمة اللَهِ",20,"ه",1,0],["عَلى زَكَرِيَّاءَ بْنِ يَحْيَى التقى الرِّضَى","كَما التَقَتِ الأَنْداءُ صُبْحاً عَلَى الوَرْدِ",21,"د",1,0],["على زمنِ الضحّاكِ كانت عصابةٌ","ولوعاً بهاماتِ الملوكِ حديدُها",22,"د",3,0],["على زين الشبيبة وهو عرسٌ","وزين الغيد أنفاسُ الملابِ",23,"ب",1,0],["على زفراته يطوى ضلوعا","عليها بالضنا حكم الغرام",24,"م",1,0],["على زينبٍ حيثَ نادتْ على","\"أبي الفضلِ\" إذْ جفنُها خُضِّلا",25,"ل",2,0],["على زعمه فيما يراه بعقله","وقد كان معلوماً من الشرع محكما",26,"م",2,0],["على زعم أنف الكارهين لما دعوا","إليه من التوحيد والعروة الوثقى",27,"ق",2,0],["عَلَى زَنْدِ إصْباحي تَباعَدَ وَصْلُهُ","‏وكنتُ بِلَيْلاهْ إلَيْهِ مُلاقِيَهْ",28,"ي",2,0],["على زمن كنَّا نَسُود به الورى","وأيام عز بالأمجاد وَلتِ",29,"ت",1,0],["على زمان ٍ ، مابقي ، به موالين","أقرب قريب ٍ لك ، كثير ٍ هذاره",30,"ر",2,0],["على زايد غرامك صار لك وسط الحشا مقعاد","وبيت ٍ من وحي فكري بنيته وسط وجداني",31,"ن",2,0]]}