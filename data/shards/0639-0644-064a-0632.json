{"poems":[[80,"أخذت برأي في الصبا أنا تاركه","https://www.aldiwan.net/poem31356.html","الطويل"],[50,"ذكرت شبابي اللذ غير قريب","https://www.aldiwan.net/poem64805.html","الكامل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72221","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43686","الوافر"],[36,"تَخَلّى عَنْ أَبي حَرْبٍ فَوَلّى","https://www.poetsgate.com/ViewPoem.aspx?id=15881",""],[302,"تفيض عيون بالدموع السواكب","https://www.aldiwan.net/poem16819.html","الطويل"],[456,"سلا دار البخيلة بالجناب","https://www.aldiwan.net/poem56296.html","الوافر"],[573,"تركت حبيب القلب تهمي جفونه","https://www.aldiwan.net/poem2847.html","الطويل"],[573,"تنسك شيطاني فيا ليته غدا","https://www.aldiwan.net/poem3081.html","الطويل"]],"verses":[["عَلى زَهْرِ رَوْضٍ ناضِرٍ تَحسبُ الرّبى","مُلوكاً عَلَى الأَجسامِ مِنهُم دَرانِكُه",0,"ك",2,0],["عَلى زَينَبٍ مِنّي السَلامُ وَمِثلُهُ","عَلى شَجَنٍ بَينَ الصَبا وَجَنوبِ",1,"ب",1,0],["عَلى زَبَدِ القوائمِ أعْوجيٍّ","حَثِيثِ الركْضِ مُنْكَفِتِ التوالي",2,"ل",2,0],["عَلَى زَعْمِ أَنَّ المَال وَهْوَ شَفِيعُهُ","يَكُونُ لَدَى الحَسْنَاءِ خَيْرَ مُشَفَّعِ",3,"ع",1,0],["عَلى زَهرٍ أَنارَت مِنهُ أَرضٌ","تَهُبُّ لَهُ مِنَ الفِردَوسِ ريحُ",4,"ح",1,0],["على زَبَدِ القَوَائِمِ أعوجيٍّ","حثيث الركض منكفت القوالي",5,"ل",2,0],["على زهرات العيش لما تساقطت","بريح الأماني والظنون الكواذب",6,"ب",1,0],["على زَمَنِ الحَداثةِ لم يُفتهُ","تقدُّمُ شِيبهم قَدَمَ الشَّبابِ",7,"ب",1,0],["على زلَّةِ كانَتْ له أَو خِيانةٍ","وهل أَحدٌ في الناس غيرُ خئون",8,"ن",1,0],["عليَّ زَمَانِي قَدْ تَعدَّى جَهَالَةً","وقد كُنتُ أَعْدَى مِنْ زَمَانِي إِذَاعَدَا",9,"د",2,0]]}