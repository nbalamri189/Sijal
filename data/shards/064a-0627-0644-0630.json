{"poems":[[53,"أشد بأيامنا لتشهرها","https://www.aldiwan.net/poem64036.html","المنسرح"],[93,"إثنان أعيا الدهر أن يبليهما","https://www.aldiwan.net/poem62807.html","عموديه"],[21,"الحمد لله ممسانا ومصبحنا","https://www.aldiwan.net/poem36147.html","البسيط"],[96,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[97,"عروس المجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=745&r=&rc=23",""],[154,"يا نسيم الريح يهفو سحرا","https://www.aldiwan.net/poem68474.html","الرمل"],[347,"صرفند معقل الاحرار ما","https://www.aldiwan.net/poem55320.html","الرمل"],[347,"يا لذكرى طبريا","https://www.aldiwan.net/poem55337.html","مجزوء الرمل"],[358,"ته دلالا أيها القمر","https://www.aldiwan.net/poem40228.html","المديد"],[543,"يا لذة الحلم في إغفاءة الوسن","https://www.aldiwan.net/poem47600.html","عموديه"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59187","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96754","المتدارك"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96717","الرمل"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31627","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109224","السريع"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49586","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49652","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49568","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45692","الكامل"],[3187,"","https://poetry.dctabudhabi.ae/diwan/poem/138787",""],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62814","البسيط"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199155",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91521","الخفيف"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136830",""],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136843",""],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136815",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52140","الرمل"],[4702,"يامحمد بن الذيب والله مظلوم","https://www.poetsgate.com/ViewPoem.aspx?id=155184",""],[4888,"لذة","https://www.poetsgate.com/ViewPoem.aspx?id=207678",""],[4888,"ما الحب؟","https://www.poetsgate.com/ViewPoem.aspx?id=207682",""],[4918,"وزن طاروق","https://www.poetsgate.com/ViewPoem.aspx?id=32379",""],[4988,"دامك أخو","https://www.poetsgate.com/ViewPoem.aspx?id=180735",""],[5007,"وشم التيه","https://www.poetsgate.com/ViewPoem.aspx?id=174254",""],[5121,"مداعبة للهزاع","https://www.poetsgate.com/ViewPoem.aspx?id=37457",""],[5121,"رِيَاضُ","https://www.poetsgate.com/ViewPoem.aspx?id=215126",""],[5277,"عتائقُ البثِّ القديمِ","https://www.poetsgate.com/ViewPoem.aspx?id=211158",""],[5443,"درس الحب","https://www.poetsgate.com/ViewPoem.aspx?id=185153",""],[5595,"وأعودُ معتذراً","https://www.poetsgate.com/ViewPoem.aspx?id=175133",""],[5725,"يا انيق العتاب","https://www.poetsgate.com/ViewPoem.aspx?id=203178",""],[5781,"ألْتذُّ منه بالرحيق!","https://www.poetsgate.com/ViewPoem.aspx?id=208761",""],[5969,"بشفاعة الأزهار","https://www.poetsgate.com/ViewPoem.aspx?id=214939",""],[6229,"إنسان أي إنسان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65211&r=&rc=34",""],[6318,"مواكب بدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66158&r=&rc=8",""]],"verses":[["يا لذةً للعيون قد عَلِمتْ","بأنها جُمِّعَت لتبهرها",0,"ر",3,0],["يا لَذَّةً مَكذوبَةً يَلهو بِها","قَلبي وَيَعرِفُ أَنَّها تُؤذيهِ",1,"ي",2,0],["يا لَذَةَ العَيشِ إِذ دامَ النَعيمُ لَنا","وَمَن يَعيشُ يَلقَ رَوعاتٍ وأَحزانا",2,"ن",2,0],["يا لذلّ العلى فهل هجع الثأر","وطاح الدم الزكيّ الطليل",3,"ل",1,0],["يا لذلِّ العهدِ إن أغضى أسىً","فوقَ صدرِ الشرفِ المنتحبِ!",4,"ب",1,0],["يا لذاك العيش لولا أنه","كان في مدته مختصرا",5,"ر",2,0],["يا لذكراك فتى معتقلاً","في الحفير تفعم الجو سنى",6,"ن",2,0],["يا لذكرى طبريا","ان فيها غانيات",7,"ت",1,1],["يا لذاك الظَبي مِن صلفٍ","نافرٍ أَغراه بي نَفرُ",8,"ر",1,0],["يَا لذَّةَ الحُلمِ في إِغفاءَةِ الوَسَنِ","تَحكِي جُفونَ بَناتِ الرُّومِ في وَهَن",9,"ن",1,1],["يَا لَذَوِي الحُسْنِ هامَ قلبِي","بِشَادِنٍ لَحْظُهُ تَأسَّدْ",10,"د",1,0],["يا لذاك الزمان وزهرته","ولعصرٍ تصرَّم واِنتقلا",11,"ل",2,0],["يا لذاكَ العيشِ ما أعذبهُ","مطعماً كان لمَن منه طعم",12,"م",1,0],["يا لِذا مِنْ أَبي الهُذَيْ","لِ وتَوْصيلِ وَاصِلِ",13,"ل",1,0],["يا لذةً ما كان يحتاجها","قد اشتراها بضيا مقلتيه",14,"ي",2,0],["يا لذّةَ العيشِ إني عنكِ في شُغُلِ","لا ناقتي منكِ في شيءٍ ولا جَمَلي",15,"ل",2,1],["يا لذّ ما لك في قتلي بلا سبب","وأنت سؤلي في قرب وفي بعد",16,"د",1,0],["يا لذ ما أدْرِي وقد وَدَّعْتِني","منْ أيِّ شيءٍ أتَّقِي أوْ أجْزَع",17,"ع",1,0],["يا لذة الأسماع لا تتعوضي","بلذاذة الأوتار والعيدان",18,"ن",1,0],["يا لذة الفساق لست كلذة ال","أبرار في عقل ولا قرآن",18,"ن",1,0],["يا لذّتي بِعِناق مَن","رَوى فَمي رَشفاً وَلَثما",19,"م",2,1],["يَا لِذَاكَ النَّحيلِ عُلِّقَ فِيه","حَقفُ رِدفٍ يَضيقُ فِيهِ رِداهَا",20,"ا",3,0],["يا لذةً بيمينِ الدّهرِ أدفعُها","في صدرِهِ وهو من أحشائي يُدْنيها",21,"ي",3,0],["يا لذئابٍ ذوي ثياب","بين دواب لها تبيدُ",22,"د",1,0],["يا لَذاكَ الجَمالِ كَم بتُّ لَيلاً","أَستميل المُنى لنيلِ المَنال",23,"ل",1,0],["يالذي من صدا صوته صم الصخر يمتاس","والجلاميد تمحى به إذا دندن أو ناس",24,"س",1,0],["يالذي ثقل الحمله علي سلك خفف","لا تقع يا حبيبي في ولايتك مسرف",25,"ف",1,0],["يا لذي سكر الصاحي بخمر بلا أقداح","خمر ما عتقوها في قناني ولا أدواح",26,"ح",1,0],["يا لَذلّ المجد لم يُثأَرْ له","يا لثأَرٍ أيَّ حبٍ خيّبا",27,"ب",2,0],["يالذيب تبقى ذيب لو صرت محكوم","وابالحصين يدوج في خضر بيده",28,"د",2,0],["يا لذَّةً لم أذقْ سُلافَتَها","حتّى اكتوَتْ من لَهيبِها كَبِدي",29,"د",2,1],["يا لذَّةً كِدْتُ أن أُفارقَها","الآنَ قدْ بتُّ في الهوى الغَرِدِ",29,"د",1,0],["يا لذَّةً قد عُتّقَتْ بِدمي","يا بحرَ شوقٍ طابَ سُكَّرُهُ",30,"ر",2,0],["يا لذ الحب والأشواق ولكن فرقته بلشه","على الاوتار ازف الحال وعزف آخر انغامي",31,"م",2,0],["يالذيب يارضوان موت الفتى جوع","أخير ما يطلب كفوف / الرداوي",32,"ا",3,0],["يا لذّة العيش بُعْدا فالرّحى طحنت","صبري وما صبرت من هولها الإبل",33,"ل",1,0],["يَا لَذَةِ الْشِّعْرِ يَا ( بَقْلاوَةَ الْصَّمَدِي )","هَاتِ انْثُرِ الْحَرْفَ لَوْزاً نَشْوَةَ الْغَمْسِ",34,"س",1,0],["يا لذَّة الأَشْعَارِ حِينَ تَسِيلُ","وَالشَّهْدُ يَحْبُو وَالْحُرُوفُ تَمِيلُ",35,"ل",1,1],["يا لذةَ القبلاتِ في أحلامِهمْ","يرمينهمْ بالجارياتِ الكُنَّسِ",36,"س",1,0],["يا لَذوي التوحيد! لماذا","نفذ الكفرُ بهم وتغلغلْ؟",37,"ل",1,0],["يا لذّة الدّنيا وسِحرَ صبابةٍ","ونشيدَ كونٍ صارَ فينا يُرفع ُ",38,"ع",1,0],["يا لذيذ الحضور مرّ الغيابِ","مثل وخز الظما بجرح السرابِ",39,"ب",1,1],["يا لذَّةَ الشَّهْدِ المُراقِ على الشَّفا","لو مَرَّ نَشْوانًا بِقَومٍ نُعَّسِ",40,"س",1,0],["يا لذّعةَ الأشواقِ مِنْ أَثَرِ الهوى","فاحَ الهُيامُ ولاحَ يَبلغُ مُشتهاهْ",41,"ا",2,0],["يا لَذكراكَ إذ أصمَّ بكَ النا","عي ، وموتُ الحبيبِ جلَّ مُصابا",42,"ب",2,0],["يَالِذُلّ الإِنْسَانِ يَطْرَحُه الكُفْ","رُ شَتِيتَ الأهْوَاءِ والأشجانِ",43,"ن",1,0],["يَا لِذُلِّ العَبيدِ تَرْكَعُ في دُن","يا \" أَبُولُّو \" في زحمَةِ الأوِثانِ",43,"ن",1,0]]}