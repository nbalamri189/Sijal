[357,"أأنت أم أنا أم ما نلت من رتب","https://www.aldiwan.net/poem40818.html","البسيط"],[368,"يا مودع السر درا عند أجفاني","https://www.aldiwan.net/poem60635.html","البسيط"],[368,"حلفت بالساعين يوم الموقف","https://www.aldiwan.net/poem60837.html","الرجز"],[368,"في الجيرة الغادين بدر","https://www.aldiwan.net/poem60895.html","مجزوء الكامل"],[368,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"],[381,"ورد الله الرحيم","https://www.aldiwan.net/poem59269.html","مجزوء الرمل"],[381,"تذكر الموت موت فاستعد له","https://www.aldiwan.net/poem59285.html","البسيط"],[395,"أيها العبد إن شئت الأمان","https://www.aldiwan.net/poem54475.html","عموديه"],[395,"يا طبيب القلوب قلبي عليل","https://www.aldiwan.net/poem54534.html","عموديه"],[407,"يا من إليه صبوتي تنسب","https://www.aldiwan.net/poem34144.html","السريع"],[413,"يا منزلا كان فيه العز مقترنا","https://www.aldiwan.net/poem31635.html","عموديه"],[413,"يا رب إن إساءتي قد سودت","https://www.aldiwan.net/poem31675.html","عموديه"],[420,"إن هذا قبر لعمرك فيه","https://www.aldiwan.net/poem53937.html","الخفيف"],[433,"ماست فازرت غصون البان بالميل","https://www.aldiwan.net/poem41419.html","البسيط"],[436,"أندى وجه وسيم","https://www.aldiwan.net/poem12425.html","مجزوء الرمل"],[461,"لعل الركب أن خلصوا نجيا","https://www.aldiwan.net/poem55813.html","الوافر"],[461,"من ناصري والزمان لي خصم","https://www.aldiwan.net/poem55862.html","المنسرح"],[461,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[467,"قف أن وقفت فذاك وادي المنحى","https://www.aldiwan.net/poem3179.html","عموديه"],[467,"سقى دمع العين لا دموع الغمائم","https://www.aldiwan.net/poem3271.html","عموديه"],[503,"من خلف مسدل ستر الغيب لاح لنا","https://www.aldiwan.net/poem38084.html","البسيط"],[516,"يا منية القلب لو آماله انفسحت","https://www.aldiwan.net/poem67795.html","البسيط"],[517,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[518,"هل تعلمان طريقة لم تطرق","https://www.aldiwan.net/poem12186.html","الكامل"],[532,"من خالفت أقواله أفعاله","https://www.aldiwan.net/poem37215.html","الرجز"],[541,"واسلك سبيل المفلسين ودار","https://www.aldiwan.net/poem48172.html","عموديه"],[541,"شبل القساور من أبناء مزوار","https://www.aldiwan.net/poem48190.html","عموديه"],[547,"بايعت ذكراك","https://www.aldiwan.net/poem67252.html","عموديه"],[561,"سنة نبي مختار","https://www.aldiwan.net/poem34235.html","منهوك المنسرح"],[565,"أسألت بان الجزع وهو يصفق","https://www.aldiwan.net/poem52880.html","الكامل"],[589,"من خد أهيف كالقضيب المايس","https://www.aldiwan.net/poem17562.html","الكامل"],[745,"","https://poetry.dctabudhabi.ae/diwan/poem/67387","الرجز"],[1051,"","https://poetry.dctabudhabi.ae/diwan/poem/200312","الكامل"]],"verses":[["مِن خائِضٍ غَمرَ الدِماءِ يَبُلُّهُ","بَلَّ النَدى مَطَرَ القَنا المُتَحَطِّمِ",0,"م",1,0],["مِن خَوفِهِ كُنتُ أَهابُ السُرى","شُحّاً عَلى وَجهِيَ أَن يُبذَلا",1,"ل",2,0],["مِن خَصاصاتِ الغَبيطِ وَقَد","غَرَّدَ الحادي عَلى أُقُرِ",2,"ر",1,0],["مِن خاطِرٍ خَطَرَت بِهِ هِمَمُ العُلى","وَالشِعرُ بَعدُ بِقَلبِهِ لَم يَخطُرِ",3,"ر",1,0],["مَن خيفَ خَوفَ اللَيثِ خُطَّ لَهُ الرُبى","وَعَوَت لِتُشهِرَهُ الكِلابُ النُبَّحُ",4,"ح",1,0],["من خيالات الشياطين ومن","حكمة الرسل ودجل الساحر",5,"ر",1,0],["من خاطر «اليمن» الخضرا ومهجتها","هذي الأغاريد والأصداء والفكر",6,"ر",1,0],["مَنْ خَصَّهُ اللهُ بِالْقُرْآنِ مُعْجِزَةً","مَا نَالَهَا مُرْسَلٌ قَدْ جَاءَ بِالدِّينِ",7,"ن",1,0],["مِنْ خَمرَةِ السِّرّ المُقدّسَةِ التي","كَلِفَتْ بِطاسَتِها يَدُ الحلاّجِ",8,"ج",1,0],["مِن خَفِيِّ الطِمرَينِ يَسعى بِغُضفٍ","لَم يُؤَيِّهِ بِهِنَّ إِلّا صَفيرا",9,"ر",2,0],["مِن خَلفِها قُلُصٌ تَجري أَزِمَّتُها","قَد مَسَّهُنَّ مَعَ الإِدلاج تَهجيرُ",10,"ر",1,0],["مِنْ خِيرَةِ اللهِ الَّذِي فَوَّضْتَهُ","وَبِهِ الكِفَايَةُ عَامِلاً وَعَلِيمَا",11,"م",2,0],["مِن خَمرِ بَيسانَ تَخَيَّرتُها","دِرياقَةً توشِكُ فَترَ العِظام",12,"م",1,0],["مِن خَيرِ خِندِفَ كُلِّها بَعدَ الَّذي","نَصَرَ الإِلَهُ بِهِ عَلى الكُفّارِ",13,"ر",1,0],["من خدِّه وجفونه","للحسن دينار وكسر",14,"ر",1,0],["من خطرة العسَّال فيها نسبةٌ","لا غَرْوَ أنَّ كلامها معسول",15,"ل",1,0],["من خُنْثِ جفْنيهما وغُنْجهما","تعلَّم السحرَ ماهرُ السَّحره",16,"ر",2,0],["من خان أو نكث العهود فعهدُكم","عهدٌ أُمِرَّ على الوفاء وثيق",17,"ق",1,0],["من خطوبٍ تغشى به كلَّ حدٍّ","وصروفٍ ترمي به كل جالِ",18,"ل",1,0],["منخفضِ النظرة طمَّاحِ الهممْ","حلاَّه من جوهره الغالي القيمْ",19,"م",1,0],["من خائفٍ وهْنَ سُلطانٍ وذي عَوَزٍ","قد أعصما بالمرجَّى أيَّ إعصامِ",20,"م",1,0],["من خِوان كأنه قِطع الرَوْ","ض وإن كان في مثال خوانِ",21,"ن",1,0],["من خلافٍ على أخيه ولكن","رائضٌ راض مَنْ يلي ويليه",22,"ي",2,0],["مِن خَضبِ نورِ خُزامى قَد أَطاعَ لَهُ","أَصابَ بِالقَفرِ مِن وَسمِيِّهِ خَضَلا",23,"ل",2,0],["مِن خَمرِ عانَةَ يَنصاعُ الفُراتُ لَها","بِجَدوَلٍ صَخِبِ الآذِيِّ مَرّارِ",24,"ر",1,0],["مِن خَمرِ بيسانَ صِرفاً فَوقَها حَبَبٌ","شيبَت بِهِ نُطفَةٌ مِن ماءِ يَبرودِ",25,"د",1,0],["من خير ما جَمَعت لك ال","بُهَمُ الغزاة من الفئه",26,"ا",2,0],["من خلق الحزن كان أحرى","أن يخلق الدمع والبكاء",27,"ا",2,0],["مَن خَصَّ بِالذَمِّ الفِراقَ فَإِنَّني","مَن لا يَرى في الدَهرِ شَيئاً يُحمَدُ",28,"د",1,0],["مِن خِصالٍ إِذا نَظَرتُ إِلَيها","نَظَمَت لي غَرائِبَ المَنثورِ",29,"ر",1,0],["من خصَّ بالشكر الصديقَ فإِنني","أحبو بخالص شكريَ الأعداءَ",30,"ا",2,1],["مِن خَيرِهِم خُلُقاً سَمحاً وَأَقعَدِهِم","فَضلاً وَأَكثَرِهِم في السَروِ إِسنادا",31,"د",2,0],["مُنخَرِقُ الكَفِّ بِالعَطاءِ مَكي","ثُ السَطوِ دونَ الجانينَ مُتَّئِدُه",32,"د",2,0],["مُنخَرِقُ اليَدِ بِالمَعروفِ يَخبِطُ في","عُرضٍ مِنَ المالِ لا يَألوهُ إِتلافا",33,"ف",2,0],["مِن خَيرِ ما أَسعَفَ الزَمانُ بِهِ","وَنَحنُ مِن مَنعِهِ على وَجَلِ",34,"ل",1,0],["من خالِصِ البَلُّورِ غُبِّرَ لَونُه","فكأنَّه سَبَجٌ يَلوحُ ويَلمَعُ",35,"ع",1,0],["مَن خافَ مِن سَكرَةِ المَنايا","لَم يَدرِ ما لَذَّةُ الرُقادِ",36,"د",1,0],["مَن خالَفَ الرُشدَ غَوى","مَن تَبِعَ الغَيَّ نَدِم",37,"م",1,0],["مِن خَمرِهِ سُقيتُ وَمِن بَردِ ريقِهِ","خَمرَينِ ذي تُزيلُ خَبالي وَذي تَزيد",38,"د",1,0],["مَن خالَطَ الناسَ كانَ الحُزنُ غايَتَهُ","مَن أَكثَرَ النَومَ لا يَستَذنِبُ الحُلُما",39,"م",2,0],["مَن خَطِفَ الخَطفَةَ في مَقامِهِ","أَتبَعَهُ مِنهُ شِهاباً ثاقِبا",40,"ب",2,0],["مِن خَيلِ تَغلِبَ ما تُلقى أَسِنَّتُها","إِلّا وَقَد خَصَّبَتها مِن أَعاديها",41,"ي",3,0],["مِن خَيلِ تَغلِبَ عِزَّةً وَتَكَرُّماً","مِثلَ اللُيوثِ بِساحَةِ الآنامِ",42,"م",1,0],["مِن خَلوَتي فيهِ مَبدا كُلِّ جائِحَةٍ","وَفِكرَتي مِنهُ مَبدا كُلِّ وَسواسِ",43,"س",1,0],["مِنْ خَمْرَةٍ تَذَرُ الْكَبِيرَ إِذَا انْتَشَى","بَعْدَ اشْتِعَالِ الشَّيْبِ وَهْوَ غُلامُ",44,"م",1,0],["من خزرجيِّ المجدِ أو أَوْسِيِّهِ","طابوا فروعاً في العُلاَ وأُروما",45,"م",2,0],["مِن خَلفِها حِمَةٌ لَولا الَّذي سَمِعتَ","قَد كانَ نِيَّتُها في جُحرِها الحِمَمُ",46,"م",1,0],["مِن خالِدٍ أَهلِ السَماحَةِ وَالنَدى","مَلِكِ العِراقِ إِلى رِمالِ وَبارِ",47,"ر",1,0],["مِن خِلالِ الأَلاءِ عايَنَ فَاِنقضْ","ضَ مَلِيّاً ما يَرعَوي زُؤُدُه",48,"د",2,0],["مِن خَلفِهِ لَدنُ المَهَّزةِ قاطِعٌ","ضافٍ تَضَمَّنَهُ لِذاكَ قِرابُهُ",49,"ب",2,0],["مِن خَيرِ آلِ أَحمَدَ المُطَهَّرِ","وارِثِ كُلَّ عِزَّةٍ وَمَفخَرِ",50,"ر",1,0],["مَنْ خُلْقُهُ كالنَّسِيمِ يَنْشُرُ إنْ","هَبَّ عليه مِنْ نشرهِ هَبَّهْ",51,"ب",2,0],["مَن خُلقُهُ القرآنُ جَلَّ ثَناؤُهُ","عَن أَن يَكُونَ حَدِيثُهُ مَملولا",52,"ل",2,0],["مِن خَشيَةِ الطَلِّ وَمِن أَندائِهِ","يَضُنُّ بِالأَرذَلِ مِن أَطلائِهِ",53,"ا",3,0],["مِن خَندَريسٍ لِجامُها خَزَفٌ","وَثَوبُها المُستَكِنِّ مِن قيرِ",54,"ر",1,0],["مِن خيطَةِ النَحرِ وَمِن قُدّامِهِ","حَتّى هَوى يَفحَصُ في رُغامِهِ",55,"م",2,0],["مِن خُراسانَ وَبَيتي في الذُرى","وَلَدى المَسعاةِ فَرعي قَد سَبَق",56,"ق",1,1],["مِن خَفقَةٍ لَو دامَ عارِضُها","قَدرَ الفَواقِ وَفى لَها عُمري",57,"ر",2,0],["مِن خَوفِ بارِئِكَ اِمتَطَيتَ نَجيبَةً","عادَت بِسَيرِكَ مِثلَ قَوسِ الباري",58,"ر",2,0],["مِن خَيرِها مَغرِساً فيها وَأَوسَعِها","شِعباً تُحَطُّ إِلَيهِ عيرُ مادِحِها",59,"ح",3,0],["مِن خُطُوبٍ تَسعَى إليكَ ولا تَأ","لُوكَ شَرّاً والهَديُ عندَ الآلِ",60,"ل",1,0],["مِنْ خَمْرَةٍ أَفْنَى الزَّمَانُ شَبَابَهَا","فِي مُخْدَعٍ بِقَرَارَةِ الدِّيمَاسِ",61,"س",1,0],["مَنْ خَالَفَ الْحَزْمَ خَانَتْهُ مَعَاذِرُهُ","وَمَنْ أَطَاعَ هَواهُ قَلَّ نَاصِرُهُ",62,"ر",2,1],["مِنْ خَطِيبٍ يُشْفَى أُوَامٌ بِمَا يُلْقِي","وَيَذْكُو إِلَى السَّمَاعِ أُوَامُ",63,"م",1,0],["مِنْ خَيْرِ عُنْصُرٍ","بِأَسْبَابِ العُلَى مُتَّصِلِ",64,"ل",1,0],["مَنْ خَصَّ مِثْلُكَ بِالْمُرُوءَةِ عُمْرَهُ","فَلِذِكْرِهِ الإِكْرَامُ وَالتَّخْلِيدُ",65,"د",1,0],["من خَمْسَ عشْرةَ قد خلت","وكأنها بنت الصباح",66,"ح",1,0],["من خلَّدته هُدى فأخ","لقْ باسم أن يَخْلدا!",67,"د",2,0],["من خصام بين الأقارب في الوادي،","وحرب في التلّ بين الأباعد",68,"د",1,0],["من خاصَ أمواجَ السياسةِ رافعاً","رأساً ورُبَّ مخاضةٍ لا تُرفَع",69,"ع",1,0],["مِنْ خِلاَلِ الألاَءِ عَايَنَ، فانْقَ","ضَّ مليَّاً، ما يرعوي زؤدُهْ",70,"د",2,0],["من خالد أو من عهود أميّة","ما انفكّ يزكو بالشام ويعبق",71,"ق",1,0],["منْ خيلِ تغلبَ ما تلقى أسنتها","إِلاَّ وَقَدْ خَضَّبَتْهَا مِنْ أَعَادِيهَا",72,"ي",3,0],["من خلفها تبدو النّخيل كأنّها","خيالات جنّ أو ظلال مساحر",73,"ر",1,0],["مَن خَلقه الزاكي السَني وَوَصفُهُ","يَزري بَريّا المسك في دارينهِ",74,"ن",2,0],["مِن خادمٍ صافِي المودةِ مخلصٍ","لكَ وده وهو المحبُّ المعْولِى",75,"ل",2,0],["مَن خُصَّ بِالشَرَفِ الَّذي ظَنَّت بِهِ","زُهرُ الكَواكِبِ أَنَّها جيرانُهُ",76,"ن",2,0],["من خدم المولى بإخلاصه","عزَّّ ولم يحتج لذلّ العبيد",77,"د",1,1],["من خالق الخلق والدنيا ونائبه","فيها على خلقه ملكا وسلطانا",78,"ن",2,0],["مَن خافَ مِن أَلَمِ الحَفا","فَليَجتَنِب مَشيَ الحَفاءِ",79,"ا",2,0],["منخِفض الرتبِة بين الوَرَى","يفتخِر الناسُ ولا يفتخِر",80,"ر",1,0],["من خَدِّه وَرْدِى ورَشْفِ رُضابه","خَمْرى ونُقْلى مَصُّ طرْفِ لسانه",81,"ن",2,0],["مَن خَصَّهُ اللَّه بأعلى جاهِ","فَاِمتازَ بِالفضلِ على الأشباهِ",82,"ه",1,0],["مِن خَلقِهِ فَهوَ يَكسوهُم وَيَرزُقُهُم","يَوماً وَيَوماً وَلَن يَسأَلنَ أَثمانا",83,"ن",2,0],["من خمر عاصمة الرشي","د وكم صرعتُ بها نديمي",84,"م",2,0],["من خده نقلي ومن ثغره","كأسي ومن ريقته لي خمار",85,"ر",1,0],["مَنْ خَصَّنِي بِهَوَاكَ يَعْلَمُ أَنَّنِي اسْ","تَحْلَيْتُ فِيكَ مَرَارَةََ اللُّوَّامِ",86,"م",1,0],["مَنْ خَصَّهُ الرَّحْمَانُ دُونَ عِبَادِهِ","بِعِنَايَةٍ مَا حَازَهَا ذُو جَاهِ",87,"ا",2,0],["من خوفك تجري كاللجج","كم يشفي ذكرك كلّ وجعْ",88