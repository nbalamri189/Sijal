.html","مجزوء الكامل"],[362,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"],[374,"ورد الله الرحيم","https://www.aldiwan.net/poem59269.html","مجزوء الرمل"],[374,"تذكر الموت موت فاستعد له","https://www.aldiwan.net/poem59285.html","البسيط"],[388,"أيها العبد إن شئت الأمان","https://www.aldiwan.net/poem54475.html","عموديه"],[388,"يا طبيب القلوب قلبي عليل","https://www.aldiwan.net/poem54534.html","عموديه"],[400,"يا من إليه صبوتي تنسب","https://www.aldiwan.net/poem34144.html","السريع"],[406,"يا منزلا كان فيه العز مقترنا","https://www.aldiwan.net/poem31635.html","عموديه"],[406,"يا رب إن إساءتي قد سودت","https://www.aldiwan.net/poem31675.html","عموديه"],[413,"إن هذا قبر لعمرك فيه","https://www.aldiwan.net/poem53937.html","الخفيف"],[426,"ماست فازرت غصون البان بالميل","https://www.aldiwan.net/poem41419.html","البسيط"],[429,"أندى وجه وسيم","https://www.aldiwan.net/poem12425.html","مجزوء الرمل"],[444,"كليب لا خير في الدنيا ومن فيها","https://www.aldiwan.net/poem23920.html","البسيط"],[456,"لعل الركب أن خلصوا نجيا","https://www.aldiwan.net/poem55813.html","الوافر"],[456,"من ناصري والزمان لي خصم","https://www.aldiwan.net/poem55862.html","المنسرح"],[456,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[462,"قف أن وقفت فذاك وادي المنحى","https://www.aldiwan.net/poem3179.html","عموديه"],[462,"سقى دمع العين لا دموع الغمائم","https://www.aldiwan.net/poem3271.html","عموديه"],[498,"من خلف مسدل ستر الغيب لاح لنا","https://www.aldiwan.net/poem38084.html","البسيط"],[511,"يا منية القلب لو آماله انفسحت","https://www.aldiwan.net/poem67795.html","البسيط"],[512,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[513,"هل تعلمان طريقة لم تطرق","https://www.aldiwan.net/poem12186.html","الكامل"],[527,"من خالفت أقواله أفعاله","https://www.aldiwan.net/poem37215.html","الرجز"],[536,"واسلك سبيل المفلسين ودار","https://www.aldiwan.net/poem48172.html","عموديه"],[536,"شبل القساور من أبناء مزوار","https://www.aldiwan.net/poem48190.html","عموديه"],[542,"بايعت ذكراك","https://www.aldiwan.net/poem67252.html","عموديه"],[556,"سنة نبي مختار","https://www.aldiwan.net/poem34235.html","منهوك المنسرح"],[560,"أسألت بان الجزع وهو يصفق","https://www.aldiwan.net/poem52880.html","الكامل"],[584,"من خد أهيف كالقضيب المايس","https://www.aldiwan.net/poem17562.html","الكامل"]],"verses":[["مِن خائِضٍ غَمرَ الدِماءِ يَبُلُّهُ","بَلَّ النَدى مَطَرَ القَنا المُتَحَطِّمِ",0,"م",1,0],["مِن خَوفِهِ كُنتُ أَهابُ السُرى","شُحّاً عَلى وَجهِيَ أَن يُبذَلا",1,"ل",2,0],["مِن خَصاصاتِ الغَبيطِ وَقَد","غَرَّدَ الحادي عَلى أُقُرِ",2,"ر",1,0],["مِن خاطِرٍ خَطَرَت بِهِ هِمَمُ العُلى","وَالشِعرُ بَعدُ بِقَلبِهِ لَم يَخطُرِ",3,"ر",1,0],["مَن خيفَ خَوفَ اللَيثِ خُطَّ لَهُ الرُبى","وَعَوَت لِتُشهِرَهُ الكِلابُ النُبَّحُ",4,"ح",1,0],["من خاطر «اليمن» الخضرا ومهجتها","هذي الأغاريد والأصداء والفكر",5,"ر",1,0],["مَنْ خَصَّهُ اللهُ بِالْقُرْآنِ مُعْجِزَةً","مَا نَالَهَا مُرْسَلٌ قَدْ جَاءَ بِالدِّينِ",6,"ن",1,0],["مِنْ خَمرَةِ السِّرّ المُقدّسَةِ التي","كَلِفَتْ بِطاسَتِها يَدُ الحلاّجِ",7,"ج",1,0],["مِن خَفِيِّ الطِمرَينِ يَسعى بِغُضفٍ","لَم يُؤَيِّهِ بِهِنَّ إِلّا صَفيرا",8,"ر",2,0],["مِن خَلفِها قُلُصٌ تَجري أَزِمَّتُها","قَد مَسَّهُنَّ مَعَ الإِدلاج تَهجيرُ",9,"ر",1,0],["مِنْ خِيرَةِ اللهِ الَّذِي فَوَّضْتَهُ","وَبِهِ الكِفَايَةُ عَامِلاً وَعَلِيمَا",10,"م",2,0],["مِن خَمرِ بَيسانَ تَخَيَّرتُها","دِرياقَةً توشِكُ فَترَ العِظام",11,"م",1,0],["مِن خَيرِ خِندِفَ كُلِّها بَعدَ الَّذي","نَصَرَ الإِلَهُ بِهِ عَلى الكُفّارِ",12,"ر",1,0],["من خدِّه وجفونه","للحسن دينار وكسر",13,"ر",1,0],["من خطرة العسَّال فيها نسبةٌ","لا غَرْوَ أنَّ كلامها معسول",14,"ل",1,0],["من خُنْثِ جفْنيهما وغُنْجهما","تعلَّم السحرَ ماهرُ السَّحره",15,"ر",2,0],["من خان أو نكث العهود فعهدُكم","عهدٌ أُمِرَّ على الوفاء وثيق",16,"ق",1,0],["من خطوبٍ تغشى به كلَّ حدٍّ","وصروفٍ ترمي به كل جالِ",17,"ل",1,0],["منخفضِ النظرة طمَّاحِ الهممْ","حلاَّه من جوهره الغالي القيمْ",18,"م",1,0],["من خائفٍ وهْنَ سُلطانٍ وذي عَوَزٍ","قد أعصما بالمرجَّى أيَّ إعصامِ",19,"م",1,0],["من خِوان كأنه قِطع الرَوْ","ض وإن كان في مثال خوانِ",20,"ن",1,0],["من خلافٍ على أخيه ولكن","رائضٌ راض مَنْ يلي ويليه",21,"ي",2,0],["مِن خَضبِ نورِ خُزامى قَد أَطاعَ لَهُ","أَصابَ بِالقَفرِ مِن وَسمِيِّهِ خَضَلا",22,"ل",2,0],["مِن خَمرِ عانَةَ يَنصاعُ الفُراتُ لَها","بِجَدوَلٍ صَخِبِ الآذِيِّ مَرّارِ",23,"ر",1,0],["مِن خَمرِ بيسانَ صِرفاً فَوقَها حَبَبٌ","شيبَت بِهِ نُطفَةٌ مِن ماءِ يَبرودِ",24,"د",1,0],["من خير ما جَمَعت لك ال","بُهَمُ الغزاة من الفئه",25,"ا",2,0],["من خلق الحزن كان أحرى","أن يخلق الدمع والبكاء",26,"ا",2,0],["مَن خَصَّ بِالذَمِّ الفِراقَ فَإِنَّني","مَن لا يَرى في الدَهرِ شَيئاً يُحمَدُ",27,"د",1,0],["مِن خِصالٍ إِذا نَظَرتُ إِلَيها","نَظَمَت لي غَرائِبَ المَنثورِ",28,"ر",1,0],["من خصَّ بالشكر الصديقَ فإِنني","أحبو بخالص شكريَ الأعداءَ",29,"ا",2,1],["مِن خَيرِهِم خُلُقاً سَمحاً وَأَقعَدِهِم","فَضلاً وَأَكثَرِهِم في السَروِ إِسنادا",30,"د",2,0],["مُنخَرِقُ الكَفِّ بِالعَطاءِ مَكي","ثُ السَطوِ دونَ الجانينَ مُتَّئِدُه",31,"د",2,0],["مُنخَرِقُ اليَدِ بِالمَعروفِ يَخبِطُ في","عُرضٍ مِنَ المالِ لا يَألوهُ إِتلافا",32,"ف",2,0],["مِن خَيرِ ما أَسعَفَ الزَمانُ بِهِ","وَنَحنُ مِن مَنعِهِ على وَجَلِ",33,"ل",1,0],["من خالِصِ البَلُّورِ غُبِّرَ لَونُه","فكأنَّه سَبَجٌ يَلوحُ ويَلمَعُ",34,"ع",1,0],["مَن خافَ مِن سَكرَةِ المَنايا","لَم يَدرِ ما لَذَّةُ الرُقادِ",35,"د",1,0],["مَن خالَفَ الرُشدَ غَوى","مَن تَبِعَ الغَيَّ نَدِم",36,"م",1,0],["مِن خَمرِهِ سُقيتُ وَمِن بَردِ ريقِهِ","خَمرَينِ ذي تُزيلُ خَبالي وَذي تَزيد",37,"د",1,0],["مَن خالَطَ الناسَ كانَ الحُزنُ غايَتَهُ","مَن أَكثَرَ النَومَ لا يَستَذنِبُ الحُلُما",38,"م",2,0],["مَن خَطِفَ الخَطفَةَ في مَقامِهِ","أَتبَعَهُ مِنهُ شِهاباً ثاقِبا",39,"ب",2,0],["مِن خَلوَتي فيهِ مَبدا كُلِّ جائِحَةٍ","وَفِكرَتي مِنهُ مَبدا كُلِّ وَسواسِ",40,"س",1,0],["مِنْ خَمْرَةٍ تَذَرُ الْكَبِيرَ إِذَا انْتَشَى","بَعْدَ اشْتِعَالِ الشَّيْبِ وَهْوَ غُلامُ",41,"م",1,0],["من خزرجيِّ المجدِ أو أَوْسِيِّهِ","طابوا فروعاً في العُلاَ وأُروما",42,"م",2,0],["مِن خَلفِها حِمَةٌ لَولا الَّذي سَمِعتَ","قَد كانَ نِيَّتُها في جُحرِها الحِمَمُ",43,"م",1,0],["مِن خالِدٍ أَهلِ السَماحَةِ وَالنَدى","مَلِكِ العِراقِ إِلى رِمالِ وَبارِ",44,"ر",1,0],["مِن خِلالِ الأَلاءِ عايَنَ فَاِنقضْ","ضَ مَلِيّاً ما يَرعَوي زُؤُدُه",45,"د",2,0],["مِن خَلفِهِ لَدنُ المَهَّزةِ قاطِعٌ","ضافٍ تَضَمَّنَهُ لِذاكَ قِرابُهُ",46,"ب",2,0],["مِن خَيرِ آلِ أَحمَدَ المُطَهَّرِ","وارِثِ كُلَّ عِزَّةٍ وَمَفخَرِ",47,"ر",1,0],["مَنْ خُلْقُهُ كالنَّسِيمِ يَنْشُرُ إنْ","هَبَّ عليه مِنْ نشرهِ هَبَّهْ",48,"ب",2,0],["مَن خُلقُهُ القرآنُ جَلَّ ثَناؤُهُ","عَن أَن يَكُونَ حَدِيثُهُ مَملولا",49,"ل",2,0],["مِن خَشيَةِ الطَلِّ وَمِن أَندائِهِ","يَضُنُّ بِالأَرذَلِ مِن أَطلائِهِ",50,"ا",3,0],["مِن خَندَريسٍ لِجامُها خَزَفٌ","وَثَوبُها المُستَكِنِّ مِن قيرِ",51,"ر",1,0],["مِن خيطَةِ النَحرِ وَمِن قُدّامِهِ","حَتّى هَوى يَفحَصُ في رُغامِهِ",52,"م",2,0],["مِن خُراسانَ وَبَيتي في الذُرى","وَلَدى المَسعاةِ فَرعي قَد سَبَق",53,"ق",1,1],["مِن خَفقَةٍ لَو دامَ عارِضُها","قَدرَ الفَواقِ وَفى لَها عُمري",54,"ي",1,0],["مِن خَوفِ بارِئِكَ اِمتَطَيتَ نَجيبَةً","عادَت بِسَيرِكَ مِثلَ قَوسِ الباري",55,"ر",2,0],["مِن خَيرِها مَغرِساً فيها وَأَوسَعِها","شِعباً تُحَطُّ إِلَيهِ عيرُ مادِحِها",56,"ح",3,0],["مِن خُطُوبٍ تَسعَى إليكَ ولا تَأ","لُوكَ شَرّاً والهَديُ عندَ الآلِ",57,"ل",1,0],["مِنْ خَمْرَةٍ أَفْنَى الزَّمَانُ شَبَابَهَا","فِي مُخْدَعٍ بِقَرَارَةِ الدِّيمَاسِ",58,"س",1,0],["مَنْ خَالَفَ الْحَزْمَ خَانَتْهُ مَعَاذِرُهُ","وَمَنْ أَطَاعَ هَواهُ قَلَّ نَاصِرُهُ",59,"ر",2,1],["مِنْ خَطِيبٍ يُشْفَى أُوَامٌ بِمَا يُلْقِي","وَيَذْكُو إِلَى السَّمَاعِ أُوَامُ",60,"م",1,0],["مِنْ خَيْرِ عُنْصُرٍ","بِأَسْبَابِ العُلَى مُتَّصِلِ",61,"ل",1,0],["مَنْ خَصَّ مِثْلُكَ بِالْمُرُوءَةِ عُمْرَهُ","فَلِذِكْرِهِ الإِكْرَامُ وَالتَّخْلِيدُ",62,"د",1,0],["من خَمْسَ عشْرةَ قد خلت","وكأنها بنت الصباح",63,"ح",1,0],["من خلَّدته هُدى فأخ","لقْ باسم أن يَخْلدا!",64,"د",2,0],["من خيل تغلب عزة وتكرما","مثل الليوث بساحة الآنام",65,"م",1,0],["من خاصَ أمواجَ السياسةِ رافعاً","رأساً ورُبَّ مخاضةٍ لا تُرفَع",66,"ع",1,0],["مِنْ خِلاَلِ الألاَءِ عَايَنَ، فانْقَ","ضَّ مليَّاً، ما يرعوي زؤدُهْ",67,"د",2,0],["منْ خيلِ تغلبَ ما تلقى أسنتها","إِلاَّ وَقَدْ خَضَّبَتْهَا مِنْ أَعَادِيهَا",68,"ي",3,0],["من خلفها تبدو النّخيل كأنّها","خيالات جنّ أو ظلال مساحر",69,"ر",1,0],["مَن خَلقه الزاكي السَني وَوَصفُهُ","يَزري بَريّا المسك في دارينهِ",70,"ن",2,0],["مِن خادمٍ صافِي المودةِ مخلصٍ","لكَ وده وهو المحبُّ المعْولِى",71,"ل",2,0],["مَن خُصَّ بِالشَرَفِ الَّذي ظَنَّت بِهِ","زُهرُ الكَواكِبِ أَنَّها جيرانُهُ",72,"ن",2,0],["من خدم المولى بإخلاصه","عزَّّ ولم يحتج لذلّ العبيد",73,"د",1,1],["من خالق الخلق والدنيا ونائبه","فيها على خلقه ملكا وسلطانا",74,"ن",2,0],["مَن خافَ مِن أَلَمِ الحَفا","فَليَجتَنِب مَشيَ الحَفاءِ",75,"ا",2,0],["منخِفض الرتبِة بين الوَرَى","يفتخِر الناسُ ولا يفتخِر",76,"ر",1,0],["من خَدِّه وَرْدِى ورَشْفِ رُضابه","خَمْرى ونُقْلى مَصُّ طرْفِ لسانه",77,"ن",2,0],["مَن خَصَّهُ اللَّه بأعلى جاهِ","فَاِمتازَ بِالفضلِ على الأشباهِ",78,"ه",1,0],["مِن خَلقِهِ فَهوَ يَكسوهُم وَيَرزُقُهُم","يَوماً وَيَوماً وَلَن يَسأَلنَ أَثمانا",79,"ن",2,0],["من خمر عاصمة الرشي","د وكم صرعتُ بها نديمي",80,"م",2,0],["من خده نقلي ومن ثغره","كأسي ومن ريقته لي خمار",81,"ر",1,0],["مَنْ خَصَّنِي بِهَوَاكَ يَعْلَمُ أَنَّنِي اسْ","تَحْلَيْتُ فِيكَ مَرَارَةََ اللُّوَّامِ",82,"م",1,0],["مَنْ خَصَّهُ الرَّحْمَانُ دُونَ عِبَادِهِ","بِعِنَايَةٍ مَا حَازَهَا ذُو جَاهِ",83,"ا",2,0],["من خوفك تجري كاللجج","كم يشفي ذكرك كلّ وجعْ",84,"ع",1,0],["من خمرة البكريّ قطب الأوانِ","رد وارتشف في الحان صافي الأواني",85,"ن",2,1],["من خطوةٍ أو لفظةٍ أحكامها","وكذاك يخطرُ ضيغمٌ ويزمجر",86,"ر",1,0],["من خاف حيفاً من الأيّام أو عنتا","وأمّه فَهْو مَنْجاهُ ومَلْجَؤُهُ",87,"ا",2,0],["مِن خَوفِهِ اللَيلُ ما تَسري عَقارِبُهُ","عَلى الصَعيدِ وَلا تُؤذي أَفاعيهِ",88,"ي",2,0],["مَن خالُهُ بَينَ المُلوكِ الملكُ ال","عادلُ لَم يَفُقهُ خَلقٌ نَسَبا",89,"ب",2,0],["من خدعةِ الأَعداء","ومن عُضال الداءِ",90,"ا",2,0],["من خير ذرته غرا وخيرتهم","ببلدة الخير من علم وقرآن",91,"ن",1,0],["من خافه ورجاه يحظى","يوم المعاد بجنتين",92,"ن",1,0],["مَن خَصّه اللَهُ بِالحُبّ القَديم كَما","عَلَيهِ أَجمَع حُبّ البَدوِ وَالحَضَرِ",93,"ر",1,0],["مِن خ