abudhabi.ae/diwan/poem/83185","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72504","الرمل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116076","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35139","الكامل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204162","الكامل"],[4767,"علم الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=178417",""],[4578,"بالصفا نحو كؤوس الأنس ساق","https://www.poetsgate.com/ViewPoem.aspx?id=49492",""],[4578,"قلَ الريحان في الورد أجاد","https://www.poetsgate.com/ViewPoem.aspx?id=49392",""],[4888,"زف الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=207759",""],[3591,"تحكي الإمام اليازجيّ بطلعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=149438",""],[5183,"حلبة الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180224",""],[5277,"نديانةُ العبق","https://www.poetsgate.com/ViewPoem.aspx?id=197752",""],[5325,"من شل من غلب العلى أيمانها","https://www.poetsgate.com/ViewPoem.aspx?id=171981",""],[5409,"هيئوا العدة وامشوا قدما","https://www.poetsgate.com/ViewPoem.aspx?id=155314",""],[2110,"قل لي بحقك أيهذا الساقي","https://www.poetsgate.com/ViewPoem.aspx?id=156283",""],[5781,"جمرةٌ في زحمة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=204823",""],[6102,"سِباقُ الواوِيات ..","https://www.poetsgate.com/ViewPoem.aspx?id=184411",""],[520,"لو اطلعت على سري وإضماري","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577530",""],[186,"دع عنك ذكر المنحنى وزرود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55750&r=&rc=13",""]],"verses":[["قَلِّد جَناجِنَها الأَنساعَ وَاِرمِ بِها","مَناكِبَ اللَيلِ نَدباً غَيرَ مِجزاعِ",0,"ع",1,0],["قُلِّدْتَ مِنْ نَصْرِ الإلاَهِ حُسَاماً","حَاطَ العِبَادَ وَمَهَّدَ الأَيَّامَا",1,"م",2,1],["قَلَّدتُكَ الشِعرَ يا سَلامَةَ ذا ال","تِفضالِ وَالشَيءُ حَيثُما جُعِلا",2,"ل",2,0],["قَلِّدنِيَ الرَأيَ الجَميلَ فَإِنَّهُ","حَسبي لِيَومَي زينَةٍ وَعِراكِ",3,"ك",1,0],["قَلَّدَ الغُمرُ ذا التَجارِبِ فيهِ","وَاكتَفى جاهِلٌ بِعِلمِ العَليمِ",4,"م",1,0],["قُلِّدَتْ مَا قُلِّدَتْ مِنْ شَرَفٍ","وَلَهَا أَعْلَى لِوَاءٍ فِي السَّفِينْ",5,"ن",1,0],["قَلَدْتُمُونَا بِالزِّيَارَةِ مِنَّةً","تَزْهَى بِهَا الأسْحَارُ وَالآصَالُ",6,"ل",1,0],["قلَّدتَ عطف الملك منه صارماً","بغَنائِهِ ومضائه يُتَمثَّلُ",7,"ل",1,0],["قَلَّدُه كالوِشاحِ جَالَ على ال","كَاعِبِ من مُنهِجَاتِه الطُنُبُ",8,"ب",1,0],["قلّده كالوشاح حال على الكا","عب من منهجياته الطنب",9,"ب",1,0],["قلدك الله منه لؤلؤة","كم صانها عن سواك بالصدف",10,"ف",1,0],["قلَّدته أمرنا فقام به","غير أخي لوثة ولا لفَف",10,"ف",1,0],["قلَّدَتْني يداك سِمْطاً من العا","ر خلافَ اللآلئ المنظومه",11,"م",2,0],["قلدت أهل الغرب في الشعر ناس","وإذا الشعر أنفه مجدوع",12,"ع",1,0],["قلدتمو المعهد المشكور عارفة","لم يألها لكم التعليم عرفانا",13,"ن",2,0],["قُلِّدتِ مِن مالِ البِلادِ أَمانَةً","يا طالَما اِفتَقَرَت إِلى المُتَقَلِّدِ",14,"د",1,0],["قَلَّدوا الشَرقَ مِن جَمالٍ وَخَيرٍ","ما يَؤودُ المُفَنِّدينَ اِنتِزاعُه",15,"ع",2,0],["قَلَّدَ الأَوطانَ نَشءً صالِحاً","وَشَباباً أَهلَ دينٍ وَحَسَب",16,"ب",1,0],["قَلَّدتَهُ السَيفَ الحُسامَ وَزُدتَهُ","قَلَماً كَصَدرِ الصَعدَةِ السَمراءِ",17,"ا",2,0],["قَلَّدَتني المُلوكُ مِن لُؤلُؤِ البَح","رَينِ آلاءَها وَمِن مَرجانِه",18,"ن",2,0],["قَلَّدوهُ الأَثَرَ المُع","جِزَ وَالفَنَّ العُجابا",19,"ب",2,0],["قَلَّدَتني يَمينُهُ بِحُسامٍ","أَعقَبَت مِنهُ واحِداً أَجدادُه",20,"د",2,0],["قَلَّدَ اللَهُ دَولَةً سَيفُها أَن","تَ حُساماً بِالمَكرُماتِ مُحَلّى",21,"ل",2,0],["قَلَّدوها مِنَ القَرَنفُلِ وَالدُر","رِ سِخاباً واهاً لَهُ مِن سِخابِ",22,"ب",1,0],["قلّدتِ أمرَكِ خالداً فمضَى بهِ","شرفاً على شَرَفٍ أشمَّ مُخَلَّدِ",23,"د",1,0],["قَلَّدَتني الفُتيا فَتَوِّجني غَداً","تاجاً بِإِعفائي مِنَ التَقليدِ",24,"د",1,1],["قَلّدْتِ كلّ مَهاةٍ عِقْدَ غانيَةٍ","وفُزْتِ بالشّكْرِ في الآرامِ والعُفُرِ",25,"ر",1,0],["قلّده من ربّه محمدُ","يسلّه بإذنه ويُغمدُ",26,"د",1,0],["قلّده في نزعه الصلاة","إن الولاة تزن الولاة",27,"ه",1,0],["قَلَّدَتْهَا يَدُ الْغَمَامِ عُقُوداً","هِيَ أَبْهَى مِنْ كُلِّ عِقْدٍ وَبَنْدِ",28,"د",1,0],["قَلَّدْتُ جِيدَ الْمَعَالِي حِلْيَةَ الْغَزَلِ","وَقُلْتُ فِي الْجِدِّ مَا أَغْنَى عَنِ الْهَزَلِ",29,"ل",1,1],["قَلَّدْتُمُونِي بَيْنَكُمْ رُتْبُةً","في نَظَرِي تَسْمُو جَمِيعَ الرُّتَبْ",30,"ب",1,0],["قُلِّدْتِ بِالْحَقِّ وَشَاحَ الكَمَالْ","ذَاكَ هُوَ الرَّمْزُ وَأَنْتِ المِثَالْ",31,"ل",1,1],["قُلِّدتَهَا وَبَنُو أَبِي وَعَشِيرَتِي","قِدَماً فَقَلِّدْنَا الْفِخَارَ الأَكْبَرَا",32,"ر",2,0],["قَلَّدَتْهُ بَلاَغَةُ الْفِكْرِ حُسْناً","وَكَسَتْهُ فَصَاحَةُ اللَّفْظِ بُرْدَا",33,"د",2,0],["قَلَّد الفُصْحَى حُلىً قُدْسِيّةً","فَزَهَاها من حُلاَها ما زَهَاها",34,"ا",3,0],["قلَّدت إبراهيم في تكريمه","أَأُلامُ إن قلَّدت فيه إماما؟",35,"م",2,0],["قلدوا كل ناعقٍ أجْنَبِيّ","ورمونا بوصمة التقليد",36,"د",1,0],["قلد فديتك هذا الحق صارمه","لا يغمد السيف والبطلان قد نجما",37,"م",2,0],["قلدت من نصر الإله حساما","حاط العباد ومهد الأياما",38,"م",2,1],["قلَّدَتْني يداك سِمْطاً من العا","ر خلافَ اللآليء المنظومة",39,"م",2,0],["قلَّد الأوطانَ نشأً صالحاً","وشباباً أهلَ دين وحسب",40,"ب",1,0],["قَلدت أَعناق العِداة مَكارِماً","بِحُسامك الحَق الجَلي الباتك",41,"ك",1,0],["قَلَدتَني نعماً تَعاظم قَدرُها","وَأَزاحَ أَدباري بِها الاقبالُ",42,"ل",1,0],["قَلَدَتني يَداهُ نعماً فَدَهري","مَع بَنيهِ بشكرها لا يَقومُ",43,"م",1,0],["قلدت طرفها حسام قضاء","وطوت في قوامها سمهريا",44,"ي",2,0],["قَلَّدَ جَمعَهُم في كُلِّ رَاىٍ","كَبِيرَهُم مَحمداً الأمِينَا",45,"ن",2,0],["قَلَدتُمُ في دِينِكُم خَارِفاً","قد خَرَفَ البِدعَةَ عَن خَارِفِ",46,"ف",1,0],["قَلَّدَ الزَّيغَ والهَوَى وتَجَافي","عَن سَبِيلِ الشَّرِيعَةِ المَشرُوعِ",47,"ع",1,0],["قَلَّدُوا الأهوَاءَ واتبعُوا","نَهج أهوَاءٍ وآرَاءِ",48,"ا",2,0],["قَلَّدَ النفسَ والهَوَى مِنه جهلا","فَهُو مُغرًى بِفَاسِدِ الآرَاءِ",49,"ا",2,0],["قُلّدت الدرَّ فما شككتْ أن","قد نُظِمتْ ثغورُها مَخانِقا",50,"ق",2,0],["قَلَّد أيدي المكرُماتِ إذَنهُ","فرفَعتْ من طَرَفَىْ حِجابهِ",51,"ب",2,0],["قُلِّدتُموها عَلى عِلمٍ بِأَنَّكُمُ","ذَوُو القُلوبِ الَّتي ما حَلَّها رُعُبُ",52,"ب",1,0],["قَلَّدتَها مِنَناً شَفَعنَ صَنائِعاً","يَجعَلنَ أَحرارَ الرِجالِ عَبيدا",53,"د",2,0],["قَلَّدتَهُ المِنَنُ الجِسامَ فَجاهِلٌ","مَن ظَنَّهُ يُثني عَلَيكَ