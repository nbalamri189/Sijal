لناعيان","https://www.aldiwan.net/poem44240.html","الخفيف"],[357,"ما راح بدر المعالي يمتطي الفلكا","https://www.aldiwan.net/poem40008.html","البسيط"],[357,"ما تراءى هلال عام جديد","https://www.aldiwan.net/poem40399.html","الخفيف"],[357,"ليهن ورق الحمى في الأيك تغريد","https://www.aldiwan.net/poem40400.html","البسيط"],[368,"هو ما علمت فأقصري أو فاعذلي","https://www.aldiwan.net/poem60809.html","الكامل"],[368,"أنت للعيد وهو للناس عيد","https://www.aldiwan.net/poem60931.html","الخفيف"],[395,"صلة الأرحام بالعلم الذي","https://www.aldiwan.net/poem54498.html","عموديه"],[406,"لا نال منك فؤادي ما يرجيه","https://www.aldiwan.net/poem46474.html","البسيط"],[407,"ولأهل هذي الهجرتين من الأذى","https://www.aldiwan.net/poem33397.html","الكامل"],[407,"قسما لقد أثقلتني تبجيلا","https://www.aldiwan.net/poem33491.html","الكامل"],[407,"لله بحر منك زاخر","https://www.aldiwan.net/poem33894.html","مجزوء الكامل"],[407,"حرمت أكل اللحم يا جاهلاً","https://www.aldiwan.net/poem33985.html","السريع"],[413,"من كان لي من حماه خيس ذي لبد","https://www.aldiwan.net/poem32214.html","البسيط"],[420,"كم قد ألين لمن قسا بصدوده","https://www.aldiwan.net/poem53923.html","الكامل"],[420,"نزلوا بحيث السفح من نعمان","https://www.aldiwan.net/poem54001.html","الكامل"],[420,"متى أرى هذه الأيام مسعفة","https://www.aldiwan.net/poem54090.html","البسيط"],[420,"أي جمع هذا وأي اتفاق","https://www.aldiwan.net/poem54103.html","الطويل"],[420,"شرب القوم من لماك عقارا","https://www.aldiwan.net/poem54115.html","الخفيف"],[433,"حكم المنية سهم والورى عرض","https://www.aldiwan.net/poem40708.html","البسيط"],[433,"صدحت على غصن السرور قماري","https://www.aldiwan.net/poem40772.html","الكامل"],[436,"عاد له الدهر كما قد بدا","https://www.aldiwan.net/poem12389.html","السريع"],[436,"أظنه حاذر سلوانا","https://www.aldiwan.net/poem12739.html","السريع"],[436,"الله أعطاك من أعدائك الظفرا","https://www.aldiwan.net/poem12794.html","البسيط"],[455,"ما أصبح الروض مطوياً على العبق","https://www.aldiwan.net/poem13866.html","البسيط"],[518,"أسفي على زمن الإمام العاضد","https://www.aldiwan.net/poem12083.html","الكامل"],[518,"لو اطلعت على سري وإضماري","https://www.aldiwan.net/poem12126.html","البسيط"],[532,"قلد الجيد وهو رب اجتهاد","https://www.aldiwan.net/poem37128.html","الخفيف"],[554,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[561,"تب إلى الله من علوم الكلام","https://www.aldiwan.net/poem33868.html","الخفيف"],[565,"دعني فلست على الزمان بعاتب","https://www.aldiwan.net/poem52746.html","الكامل"],[589,"ظبي له في كل قلب هوى","https://www.aldiwan.net/poem17985.html","السريع"]],"verses":[["قَلِّد جَناجِنَها الأَنساعَ وَاِرمِ بِها","مَناكِبَ اللَيلِ نَدباً غَيرَ مِجزاعِ",0,"ع",1,0],["قُلِّدْتَ مِنْ نَصْرِ الإلاَهِ حُسَاماً","حَاطَ العِبَادَ وَمَهَّدَ الأَيَّامَا",1,"م",2,1],["قَلَّدتُكَ الشِعرَ يا سَلامَةَ ذا ال","تِفضالِ وَالشَيءُ حَيثُما جُعِلا",2,"ل",2,0],["قَلِّدنِيَ الرَأيَ الجَميلَ فَإِنَّهُ","حَسبي لِيَومَي زينَةٍ وَعِراكِ",3,"ك",1,0],["قَلَّدَ الغُمرُ ذا التَجارِبِ فيهِ","وَاكتَفى جاهِلٌ بِعِلمِ العَليمِ",4,"م",1,0],["قُلِّدَتْ مَا قُلِّدَتْ مِنْ شَرَفٍ","وَلَهَا أَعْلَى لِوَاءٍ فِي السَّفِينْ",5,"ن",1,0],["قَلَدْتُمُونَا بِالزِّيَارَةِ مِنَّةً","تَزْهَى بِهَا الأسْحَارُ وَالآصَالُ",6,"ل",1,0],["قلَّدتَ عطف الملك منه صارماً","بغَنائِهِ ومضائه يُتَمثَّلُ",7,"ل",1,0],["قَلَّدُه كالوِشاحِ جَالَ على ال","كَاعِبِ من مُنهِجَاتِه الطُنُبُ",8,"ب",1,0],["قلّده كالوشاح حال على الكا","عب من منهجياته الطنب",9,"ب",1,0],["قلدك الله منه لؤلؤة","كم صانها عن سواك بالصدف",10,"ف",1,0],["قلَّدته أمرنا فقام به","غير أخي لوثة ولا لفَف",10,"ف",1,0],["قلَّدَتْني يداك سِمْطاً من العا","ر خلافَ اللآلئ المنظومه",11,"م",2,0],["قلدت أهل الغرب في الشعر ناس","وإذا الشعر أنفه مجدوع",12,"ع",1,0],["قلدتمو المعهد المشكور عارفة","لم يألها لكم التعليم عرفانا",13,"ن",2,0],["قُلِّدتِ مِن مالِ البِلادِ أَمانَةً","يا طالَما اِفتَقَرَت إِلى المُتَقَلِّدِ",14,"د",1,0],["قَلَّدوا الشَرقَ مِن جَمالٍ وَخَيرٍ","ما يَؤودُ المُفَنِّدينَ اِنتِزاعُه",15,"ع",2,0],["قَلَّدَ الأَوطانَ نَشءً صالِحاً","وَشَباباً أَهلَ دينٍ وَحَسَب",16,"ب",1,0],["قَلَّدتَهُ السَيفَ الحُسامَ وَزُدتَهُ","قَلَماً كَصَدرِ الصَعدَةِ السَمراءِ",17,"ا",2,0],["قَلَّدَتني المُلوكُ مِن لُؤلُؤِ البَح","رَينِ آلاءَها وَمِن مَرجانِه",18,"ن",2,0],["قَلَّدوهُ الأَثَرَ المُع","جِزَ وَالفَنَّ العُجابا",19,"ب",2,0],["قَلَّدَتني يَمينُهُ بِحُسامٍ","أَعقَبَت مِنهُ واحِداً أَجدادُه",20,"د",2,0],["قَلَّدَ اللَهُ دَولَةً سَيفُها أَن","تَ حُساماً بِالمَكرُماتِ مُحَلّى",21,"ل",2,0],["قَلَّدوها مِنَ القَرَنفُلِ وَالدُر","رِ سِخاباً واهاً لَهُ مِن سِخابِ",22,"ب",1,0],["قلّدتِ أمرَكِ خالداً فمضَى بهِ","شرفاً على شَرَفٍ أشمَّ مُخَلَّدِ",23,"د",1,0],["قَلَّدَتني الفُتيا فَتَوِّجني غَداً","تاجاً بِإِعفائي مِنَ التَقليدِ",24,"د",1,1],["قَلّدْتِ كلّ مَهاةٍ عِقْدَ غانيَةٍ","وفُزْتِ بالشّكْرِ في الآرامِ والعُفُرِ",25,"ر",1,0],["قلّده من ربّه محمدُ","يسلّه بإذنه ويُغمدُ",26,"د",1,0],["قلّده في نزعه الصلاة","إن الولاة تزن الولاة",27,"ه",1,0],["قَلَّدَتْهَا يَدُ الْغَمَامِ عُقُوداً","هِيَ أَبْهَى مِنْ كُلِّ عِقْدٍ وَبَنْدِ",28,"د",1,0],["قَلَّدْتُ جِيدَ الْمَعَالِي حِلْيَةَ الْغَزَلِ","وَقُلْتُ فِي الْجِدِّ مَا أَغْنَى عَنِ الْهَزَلِ",29,"ل",1,1],["قَلَّدْتُمُونِي بَيْنَكُمْ رُتْبُةً","في نَظَرِي تَسْمُو جَمِيعَ الرُّتَبْ",30,"ب",1,0],["قُلِّدْتِ بِالْحَقِّ وَشَاحَ الكَمَالْ","ذَاكَ هُوَ الرَّمْزُ وَأَنْتِ المِثَالْ",31,"ل",1,1],["قُلِّدتَهَا وَبَنُو أَبِي وَعَشِيرَتِي","قِدَماً فَقَلِّدْنَا الْفِخَارَ الأَكْبَرَا",32,"ر",2,0],["قَلَّدَتْهُ بَلاَغَةُ الْفِكْرِ حُسْناً","وَكَسَتْهُ فَصَاحَةُ اللَّفْظِ بُرْدَا",33,"د",2,0],["قَلَّد الفُصْحَى حُلىً قُدْسِيّةً","فَزَهَاها من حُلاَها ما زَهَاها",34,"ا",3,0],["قلَّدت إبراهيم في تكريمه","أَأُلامُ إن قلَّدت فيه إماما؟",35,"م",2,0],["قلدوا كل ناعقٍ أجْنَبِيّ","ورمونا بوصمة التقليد",36,"د",1,0],["قلد فديتك هذا الحق صارمه","لا يغمد السيف والبطلان قد نجما",37,"م",2,0],["قلدت من نصر الإله حساما","حاط العباد ومهد الأياما",38,"م",2,1],["قلَّدَتْني يداك سِمْطاً من العا","ر خلافَ اللآليء المنظومة",39,"م",2,0],["قلَّد الأوطانَ نشأً صالحاً","وشباباً أهلَ دين وحسب",40,"ب",1,0],["قَلدت أَعناق العِداة مَكارِماً","بِحُسامك الحَق الجَلي الباتك",41,"ك",1,0],["قَلَدتَني نعماً تَعاظم قَدرُها","وَأَزاحَ أَدباري بِها الاقبالُ",42,"ل",1,0],["قَلَدَتني يَداهُ نعماً فَدَهري","مَع بَنيهِ بشكرها لا يَقومُ",43,"م",1,0],["قلدت طرفها حسام قضاء","وطوت في قوامها سمهريا",44,"ي",2,0],["قَلَّدَ جَمعَهُم في كُلِّ رَاىٍ","كَبِيرَهُم مَحمداً الأمِينَا",45,"ن",2,0],["قَلَدتُمُ في دِينِكُم خَارِفاً","قد خَرَفَ البِدعَةَ عَن خَارِفِ",46,"ف",1,0],["قَلَّدَ الزَّيغَ والهَوَى وتَجَافي","عَن سَبِيلِ الشَّرِيعَةِ المَشرُوعِ",47,"ع",1,0],["قَلَّدُوا الأهوَاءَ واتبعُوا","نَهج أهوَاءٍ وآرَاءِ",48,"ا",2,0],["قَلَّدَ النفسَ والهَوَى مِنه جهلا","فَهُو مُغرًى بِفَاسِدِ الآرَاءِ",49,"ا",2,0],["قُلّدت الدرَّ فما شككتْ أن","قد نُظِمتْ ثغورُها مَخانِقا",50,"ق",2,0],["قَلَّد أيدي المكرُماتِ إذَنهُ","فرفَعتْ من طَرَفَىْ حِجابهِ",51,"ب",2,0],["قُلِّدتُموها عَلى عِلمٍ بِأَنَّكُمُ","ذَوُو القُلوبِ الَّتي ما حَلَّها رُعُبُ",52,"ب",1,0],["قَلَّدتَها مِنَناً شَفَعنَ صَنائِعاً","يَجعَلنَ أَحرارَ الرِجالِ عَبيدا",53,"د",2,0],["قَلَّدتَهُ المِنَنُ الجِسامَ فَجاهِلٌ","مَن ظَنَّهُ يُثني عَلَيكَ تَطَوُّعا",54,"ع",2,0],["قَلَّدتَهُم مِنَناً لا يَنهَضونَ بِها","أَوانَ أَوضَحتَ بِالإِعجازِ عُذرَهُمُ",55,"م",1,0],["قلدتهم مننا وعدت بمثلها","أكرم به من مبتدى ومعيد",56,"د",1,0],["قلدتهم مننا فاستقبلوك بها","وبالتلقى أجر الشكر قد حصلا",57,"ل",2,0],["قلدتهم مننا تضاعف شكرها","أمهلتهم وتخفف التثمين",58,"ن",1,0],["قلدت من ثوب الخطوب قلائدا","نشرت عليّ ثياب عطل خامل",59,"ل",1,0],["قلدتها من نداك درّاً","وبالندى درها تحلى",60,"ل",2,0],["قلدته أيدي الولاية سيفاً","لم تباشره كف قينٍ بمس",61,"س",1,0],["قَلَّدتَهُ عَضباً إِذا","مَسَّ الخُطوبَ بِهِ بَراها",62,"ا",3,0],["قُلِّدتَ مِنها يَومَ قُلِّدتَها","نِيابَةً غِمداً بِلا نَصلِ",63,"ل",1,0],["قلّدهم عقدَ الرشاد والهدى","أجلسهم على موائد الندى",64,"د",2,0],["قلدته عفواً بلا طلب","ولم تك مستخيره",65,"ر",2,0],["قلدتنا أوصافها فكان","المكتسى من ثيابها عريان",66,"ن",1,0],["قلّدَها عن اجْتهادٍ أهْلها","يا من رأى مُجتَهِداً مُقَلِّدا",67,"د",2,0],["قُلد مِنه أعْظَمَ القَلائِد","مُبارَكُ المَبادي والمَقاصِد",68,"د",1,0],["قُلِّدْتَ مِنْهُ مُهَنَّداً ما سُلَّ إِ","لا راق رَوْنَقُهُ وَراعَ مَضاؤُهُ",69,"ا",3,0],["قلدت جيد العلم عقداً فاخراً","فعلا بك الدين الرضي الأصوب",70,"ب",1,0],["قلدتها فطفقت تنظم عقدها","بسياسة مسبارها الفكر السديد",71,"د",1,0],["قل داعيا آمين يا هذا فما","عز الخلافة في سوى عبد الحميد",72,"د",1,0],["قلَّدتَني مِنَناً لا أَستَطيع لها","شُكراً ولو ساعدتني البَدوُ والحضرُ",73,"ر",1,0],["قَلَّدَتهُ أَعِنَّةَ المُلكِ حَتّى","قادَ أَعداءَهُ بِغَيرِ عِنانِ",74,"ن",1,0],["قُلِّدتَ صارم عَزم لَو ضَرَبت بِهِ","طوداً مِن الراسيات الشُمّ لاِنفتكا",75,"ك",2,0],["قُلّدَ المَجد مِنكَ عقدَ كَمال","وَاِحتَواه سِواك بِالتَقليدِ",76,"د",1,0],["قلّدتُ جيد مَعاليه جَواهره","دُرّاً يَتيماً لَهُ في العنق تَقليدُ",77,"د",1,0],["قَلّدْتُه ثِنْيَ العِنانِ فطارَ بي","مَرَّ الشّهابِ يقُدُّ ليلَ القَسطَل",78,"ل",1,0],["قَلّدَتْه يدُ الخليفةِ تَخْصي","صاً وفخْرٌ في مِثْلِه التَّقْليد",79,"د",1,0],["قلد العلم ولا تعدل به","وله ألق قيادك والزمام",80,"م",1,0],["قَلّدتْهُ لِشقائي في سعادتهِ","عقْداً مِنَ المدحِ قد راقَت لآليهِ",81,"ي",2,0],["قلد فلاناً في الديانة واتبع","فيما تدين مقالة لفلان",82,"ن",1,0],["قلدتني من در نظمك أنجماً","تهوى الماء لأجلهن نزولا",83,"ل",2,0],["قلَّدتَ عنقي بالمد","ائح والمنائح والمفاخر",84,"ر",1,0],["قلدت أهل الكفر لكننا","نتبع آيات الكتاب الصحاح",85,"ح",1,0],["قلَّدْتَنِي أنجُمَ الجوزاءِ قد نُظِمَتْ","عِقداً فحَقَّ لِمثلِي الفخرُ والشَّرَفُ",86,"ف",1,0],["قَلَّدْتَني نِعماً أنوءُ بحملِها","فنَظَمْتُ فيك قلائداً وعقودا",87,"د",2,0],["قَلَّدْتُه غُرُر الثناء قلائداً","ما لم تكنْ لقلائد العقيان",88,"ن",1,0],["قَلَّدْتُ جيدَ القوافي في مدايحه","ما لا يُقَلَّدُ جيد الخرَّدِ الغيد",89,"د",1,0],["قلَّد النَّاس أيدياً من نداه","فهي مثل الأَطواق في الأَعناق",90,"ق",1,0],["قَلَّدَتْك الجفون سيفاً صقيلاً","ومن القدّ ذابلاً خطارا",91,"ر",2,0],["قلّد الله ديننا بشهاب ال","دين سيفاً مهنداً بتارا",91,"ر",2,0],["قلدتني منناً ليس النظام يفي","بشكرها هل يفي بالجوهر الخفضُ",92,"ض",1,0],["قلَّدتهُ نعماً وقد طوَّقتهُ","كرماً بعقد محاسن الآثارِ",93,"ر",1,0],["قُلِّدَ كالعِقْدِ بأَولادِهِ","فَقَلَّدَ الدَّوْحَ بما قُلِّدا",94,"د",2,0],["قلّدَهُ فكرُك في نحرِه","دُرّاً من المدْحِ ومَرْجانا",95,"ن",2,0],["قلّدْتَهُم منَناً حتى إذا عجِزَتْ","عنها رقابُهُمُ قلدْتَهُم بَتْرا",96,"ر",2,0],["قلدت منها العلا عقدا يزين كما","زانت حلى عقدها الحسناء بالعنق",97,"ق",1,0],["قلدت مؤتمن الخلافة أمرهم","فكنى وكنى عن صلاح الفاسد",98,"د",1,0],["قلدتهم طوق إحسان فحين بغوا","قلدتهم حد ماضي الغرب بتار",99,"ر",1,0],["قَلَّدَ الْجِيدَ وَهْوَ رَبُّ اجْتِهَادٍ","واْنتِقادٍ قَلائِدَ الْعِقْيانِ",100,"ن",1,1],["قلّدوني إصلاحَها ورَمَوْا بي","طلبَ السِّلمِ في صعابِ المرامي",101,"م",2,0],["قلِّدِ الله يا ابن قومي وقلدْ","رسلَ الله أصدق الأقوام",102,"م",1,0],["قُلِّدتَ سيفَ نِيابةٍ شرَّفتَهُ","حتى أريتَ النَّاسَ فضلَ النائِبِ",103,"ب",1,0],["قَلَّدهُ الحُسْنَ الَّذي يَشْتَهِي","وَهذِه نُسْخَةُ تَقْلِيدِهِ",104,"ه",1,0]]}