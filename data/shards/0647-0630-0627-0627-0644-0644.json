{"poems":[[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116992","البسيط"],[146,"فر من الحب قلبه فنجا","https://www.aldiwan.net/poem58352.html","المنسرح"],[438,"هذا اللوى لا حط منه لواء","https://www.aldiwan.net/poem12549.html","الكامل"],[438,"أرح المطية برهة يا حادي","https://www.aldiwan.net/poem12596.html","الكامل"],[1789,"","https://poetry.dctabudhabi.ae/diwan/poem/122397","البسيط"],[1877,"","https://poetry.dctabudhabi.ae/diwan/poem/115271","المجتث"],[2360,"","https://poetry.dctabudhabi.ae/diwan/poem/119151","المجتث"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58482","السريع"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66584","الرجز"],[3591,"من التلاقي قضيت السؤل والطلبا","https://www.poetsgate.com/ViewPoem.aspx?id=149403",""],[5122,"يجض الخفوق","https://www.poetsgate.com/ViewPoem.aspx?id=18065",""],[5122,"(( عبّر ودروس ))","https://www.poetsgate.com/ViewPoem.aspx?id=28151",""],[5389,"هارون الأمة","https://www.poetsgate.com/ViewPoem.aspx?id=206085",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5542,"الباحة اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=10055",""],[5595,"منّا اليك ومن ميسانَ نهديها","https://www.poetsgate.com/ViewPoem.aspx?id=144640",""],[5956,"يا ربِّ كيف خلقت هذا الهاديا؟","https://www.poetsgate.com/ViewPoem.aspx?id=207357",""],[5956,"الشعر يعجز أن يعلو إلى القممِ","https://www.poetsgate.com/ViewPoem.aspx?id=210476",""],[6189,"أعراس الحداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83599&r=&rc=66",""]],"verses":[["هذا اللباس مع الرهبان في شعثٍ","فهل تراهُ نجاةً للرهابين",0,"ن",1,0],["هذا اللَّمّى ذلك الذي شغف ال","قلبَ وخمرُ الثغور ما مُزِجا",1,"ج",2,0],["هذا اللّوى لا حُطّ منه لواءُ","يرتاد عنه هوىً وهواءُ",2,"ا",2,1],["هذا اللوى وبه شفاءُ صبابَتي","لو أنه أجرى على المُعتادِ",3,"د",1,0],["هذا اللواء الذي كنا نحف به","مع النبي وجبريلٌ لنا مدد",4,"د",1,0],["هذا اللقاء منام","وأنت طيف خيال",5,"ل",1,0],["هذا اللبابي يحوي","جوائز الخلفاء",6,"ا",2,1],["هذا اللمى من تحت هذا الوشام","مثل الأقاحي أو كنوزِ البشامْ",7,"م",1,0],["هذا اللِّوَى وَالحَيُّ مِنْ أَمامِهِ","قَدْ خَفَقَ البَرْقُ عَلى أَعْلامِهِ",8,"م",2,1],["هذا اللقاء غريبٌ في خلائقهِ","فأنه بنبت التكدير والطربا",9,"ب",2,0],["هذا اللي جرحني وتعب الحال،،يا أبو أعوض","الا فرصتن خليتها ما يعوضها",10,"ض",3,0],["هذا اللي يخلي خافقي بالحشى محموس","ورمشي من أعماله خطيراً يشيبها",11,"ب",3,0],["هذا اللي خليفة يصير عالناس","گبل ما بيهه يتحكم نذلهه",12,"ل",3,0],["هذا اللي الى الحق يهدي الگلوب","وغيره عن طريق الحق يزلهه",12,"ل",3,0],["هذا اللي اذا بيه حسّت الخيل","اعلى وجه الگاع ما تثبت رجلهه",12,"ل",3,0],["هذا اللقاء وما شفيت غليلا","كيف احتيالي أن عزمت رحيلا",13,"ل",2,1],["هذا اللقاء الذي نحياه، ينقلني","إلى زمان، أضاء المشرقين هدى",14,"د",2,0],["هذا اللقاءُ فريدٌ في تدبّره","هذا اللقاءُ صحيحٌ في تقصيها",15,"ي",3,0],["هذا اللِّوا أيقونةٌ وطنية","يحيا المُخَصِّصَ وقته لبلاديا",16,"ي",2,0],["هذا اللواءُ خلوقٌ طاهرٌ لبقٌ","هذا الخدومُ حكيمٌ كاملُ الشيمِ",17,"م",1,0],["هذا اللظى من قَدْحِ ضبَّاحةٍ","هذا الشجى الواري بقايا اتقاد",18,"د",1,0]]}