{"poems":[[65,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[73,"ما عند مودود من قلت مثالبه","https://www.aldiwan.net/poem3785.html","البسيط"],[93,"عاد للأرض مع الصيف صباها","https://www.aldiwan.net/poem62805.html","عموديه"],[91,"تحت الغصون جداول","https://www.aldiwan.net/poem44757.html","مجزوء الكامل"],[91,"جاء الربيع وورد الرمان","https://www.aldiwan.net/poem44908.html","الكامل"],[68,"من نفخة الصور أم من نفحة الصور","https://www.aldiwan.net/poem41361.html","البسيط"],[41,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[54,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/142337","الخفيف"],[102,"شاعر الكأس والرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=50185",""],[130,"هذا الربيع بنور الحسن وافانا","https://www.aldiwan.net/poem805.html",""],[170,"صبرا جميلا فلعل أو عسى","https://www.aldiwan.net/poem47050.html","الرجز"],[189,"هل لي إلى الثغر من عود ومنقلب","https://www.aldiwan.net/poem14106.html","البسيط"],[189,"يا خليلي الهوى برح بي","https://www.aldiwan.net/poem14115.html","الرمل"],[189,"بعثت إليك بطيفها تعليلا","https://www.aldiwan.net/poem14646.html","الكامل"],[214,"ثبوت حسنك لي فيه شهادات","https://www.aldiwan.net/poem13336.html","البسيط"],[228,"لا لقوم ولا لدين","https://www.aldiwan.net/poem39694.html","مجزوء الخفيف"],[234,"ليس من ساد عن وراثته جد","https://www.aldiwan.net/poem51189.html","الخفيف"],[266,"فرشت للربيع فينا مهاده","https://www.aldiwan.net/poem38137.html","الخفيف"],[275,"أمن عربية تشتاق دارا","https://www.aldiwan.net/poem35647.html","الوافر"],[287,"بأبي الريم الذي مر بنا","https://www.aldiwan.net/poem32406.html","الرمل"],[309,"يا ظبي عيد ما في الحسن لك ثاني","https://www.aldiwan.net/poem16834.html","البسيط"],[309,"يا صاحبي إن دمعي اليوم ينهمل","https://www.aldiwan.net/poem16875.html","البسيط"],[327,"بانت سليمى وأقوى بعدها تبل","https://www.aldiwan.net/poem56346.html","البسيط"],[369,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[376,"كأن الليالي بالليالي طلبنني","https://www.aldiwan.net/poem57169.html","الطويل"],[408,"يا حبذا يومي بحده","https://www.aldiwan.net/poem46642.html","مجزوء الكامل"],[482,"أما هواك وان تقادم عهده","https://www.aldiwan.net/poem15208.html","الكامل"],[487,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[500,"غضي جفونك يا رياض","https://www.aldiwan.net/poem9883.html","مجزوء الكامل"],[520,"ردا أحاديث المنى وأعيدا","https://www.aldiwan.net/poem12092.html","الكامل"],[556,"لك الليل بعد الذاهبين طويلا","https://www.aldiwan.net/poem47299.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122531","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86972","الخفيف"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122374","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38369","الكامل"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145629","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120022","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119958","الكامل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121116","الطويل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130620","الرمل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78176","الخفيف"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122049","الكامل"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128756","الكامل"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101427","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48208","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53030","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2840,"","https://poetry.dctabudhabi.ae/diwan/poem/101879","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202725",""],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79705","الرمل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68007","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110063","الخفيف"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85244","البسيط"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103798","المجتث"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122292","الرجز"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86541","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86479","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86363","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123525","الطويل"],[412,"","https://poetry.dctabudhabi.ae/diwan/poem/31264","الكامل"],[4722,"وإن للمصطفى حوضا مسافته","https://www.poetsgate.com/ViewPoem.aspx?id=26475",""],[4767,"رجب الأصب","https://www.poetsgate.com/ViewPoem.aspx?id=199714",""],[4778,"ليت هذا العام قد سنحا","https://www.poetsgate.com/ViewPoem.aspx?id=208690",""],[4845,"وللشعر ميزان تسمى عَروضَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=134973",""],[5145,"هذا الربيع وهذه أزهاره","https://www.poetsgate.com/ViewPoem.aspx?id=108102",""],[5219,"أين عهدي .... ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=195011",""],[5431,"مازال يأسرني الإعجاز من شفة","https://www.poetsgate.com/ViewPoem.aspx?id=195158",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5616,"حماس","https://www.poetsgate.com/ViewPoem.aspx?id=205248",""],[5616,"يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=205249",""],[5725,"سلاماً لا تزور ولا تزارُ","https://www.poetsgate.com/ViewPoem.aspx?id=208671",""],[5829,"يا ثغرها","https://www.poetsgate.com/ViewPoem.aspx?id=147423",""],[5956,"ضياع طفل *","https://www.poetsgate.com/ViewPoem.aspx?id=184565",""],[5957,"لا تيأس يا ابن العرب..","https://www.poetsgate.com/ViewPoem.aspx?id=11423",""],[161,"قَلْنَا لِغَزَّةَ : ...","https://www.poetsgate.com/ViewPoem.aspx?id=175084",""],[520,"ردا احاديث المنى وأعيدا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577496",""]],"verses":[["والأُقْحُوانُ ابتَسَمَتْ ثُغورُهُ","غِبَّ مُناجاةِ النّسيمِ إذ وَنى",0,"ا",1,0],["وَالأَقلفُ الكَلبُ رَأس الأَمرِ صاحِبُ دي","وانِ الأَميرِ وَجابيهِ وَحاسِبُهُ",1,"ب",2,0],["وَالأَقاحي صُوَرٌ خَلّابَةٌ","وَأَغاني الطَيرِ شِعرٌ لا يُضاهى",2,"ا",3,0],["والاقحوان كأنه","للثم ثغر راتل",3,"ل",1,0],["والاقحوانة ثغرها متبسم","ابداً كما يتبسم الجذلان",4,"ن",1,0],["وَالأُقحُوانُ زَها بَينَ البَهارِ بِها","شِبهَ الدَراهِمِ ما بَينَ الدَنانيرِ",5,"ر",1,0],["وَالأَقدَمينَ الأَوَّلي","نَ غِنىً وَذِكراً غَيرَ خامِل",6,"ل",1,0],["وَالأُقحُوانُ كَالثَنايا الغُرِّ","قَد صَقَلَت نُوارَها بِالقَطرِ",7,"ر",1,0],["والأقاويل عندَهمْ كالتماثي","لِ فلا يُوهِمَنَّكَ الخطباءُ",8,"ا",2,0],["والأقحوانة سكرى","والياسمين خليعا",9,"ع",2,0],["وألاقيك في ضميري كما لاقى ال","فم المستهام أشهى مقبّل",10,"ل",1,0],["وألاقيك في ترنّمك الخمري","ربيعا مرنّما ... جذلانا",11,"ن",2,0],["والأقحوان كثغر زانه شنب","يفترّ مبتسماً بالأنس جذلانا",12,"ن",2,0],["والأقحوانُ ضاحكٌ مِن عَقلِ مَن","حازَ الشّراب دونَهُ وما احْتَسى",13,"س",2,0],["والأُقْحوانُة تحِكى ثغرَ غانيةٍ","تَبسَّمت فيه من عُجْب ومن عَجَبِ",14,"ب",1,0],["والأَقاحِي كَلآلٍ نُظِمت","في حَواشِي كوكبٍ من ذَهَب",15,"ب",1,0],["والأُقحوانةَ ثَمَّ تْلقَى أختَها","كفمٍ يُحاول من فمٍ تقبيلا",16,"ل",2,0],["والاقحوان ثغور زانها شنب","يحلو لعاشقها منه ارتشافات",17,"ت",1,0],["وَالأَقاحُ البَريءُ يَن","فُثُ أَحلامَ بُرعُمِه",18,"ه",1,0],["وأُلاقِ العُداةَ عنه بعزمٍ","عَلَويٍّ يَفُلّ حدّ الصِّفاحِ",19,"ح",1,0],["والأقاح النضير يفتر عن در","نضيد يشتاقه نقاده",20,"د",2,0],["وإِلا قالَ مفتونٌ لِهذا","على الفِردَوسِ فَضّلتُ القِفارا",21,"ر",2,0],["وَالأَقاليمَ بِلا مَنٍّ وَلَو","وَهَبَت يُمنى يَدَيهِ اليَمَنا",22,"ن",2,0],["والأقربين وأهل الدين قاطبة","يا رب واختم بتوحيد وإيمان",23,"ن",1,0],["والأقربين وأهل القطر أجمعهم","إذ فقد أمثاله خطب له زعل",24,"ل",1,0],["وَالأَقوَرِينَ يَراها في تَقَلُّبِهِ","كَما تَقَلَّبَ خَلفَ الباقِرِ العَجَلُ",25,"ل",1,0],["والأقحوانُ فاغِرُ بِرادُه","عن مُجتلى مِثْلِ صغارِ البَرَد",26,"د",1,0],["وإِلا قَصرنَ عن طَريقي فَفي يَدي","على ضَعفِها ما في يدِ ابنِ مُقاتِلِ",27,"ل",1,0],["والأقحوانُ غُصونُه","نحو الحدائق مُستمدّه",28,"د",2,0],["والأقحُوانُ إذا تبسَّمَ ثغرُه","والوردُ مطلولُ الجوانبِ خَدُّه",29,"د",2,0],["وإلا قد استعنت بأمداح ربها","لها في الفصوص المحكمات الكتابيه",30,"ي",2,0],["وإلا قومي يا هزا","ر فقد فتقتَ الأُذن رمزا",31,"ز",2,0],["والأقحوان مباسماً معسولة ال","نغمات والورد الجني",32,"ي",1,0],["وإلّا قَعوداً عن لِمامٍ بنَصْرِهِ","وإلّا جَبوهاً بالرّدى وخذولا",33,"ل",2,0],["وألاقي ليلَى فَأقطعُ ليلي","ضحِكاً إن قَطعتُ ليلي بُكاءَ",34,"ا",2,0],["وَالأَقاليم أَخصبت بَعدَ مَحل","مِنهُ كادَ المَحصول لَولاه يتلف",35,"ف",1,0],["والاقحوان ضاحك","بمبسم لم يضحك",36,"ك",1,0],["وَالأقحُوان فَكالثّغورِ بَواسِماً","فيها الرّياضُ وجوهُها لَم تعبسِ",37,"س",1,0],["وإلَّا قُلتَ مَنْ هي؟ واعترفْ لِي","فإنَّ القلبَ للمَحْبُوبِ غَافِرْ",38,"ر",1,0],["والأقحوان الطلق في أرجائها","ريان يضحك من بكاء الأنواءِ",39,"ا",2,0],["والأقحوان ند يضاحك نرجسا","ساهي الجفون محدق الأحداقِ",40,"ق",1,0],["وإلا قد مررت بربعِ حيٍ","فهذا النفح من تلك النواحي",41,"ح",2,0],["والاقاحي باسم الثغر يرى","زخرفا ما",42,"م",2,0],["وَالأَقاليم مِنهُ تَهتَز أَن ما","هَزَ أَقلامُهُ عَلى القُرطاس",43,"س",1,0],["والأُقْحُوَانُ ثُغُورُهُ مَسْقُولَةٌ","لَكِنَّهَا لَمْ تَعْرِفِ المِسْوَاكَا",44,"ك",2,0],["والاقحوان شيق خد","يه وريقته المدام",45,"م",1,0],["وأُلاقي الأشجانَ مُكثَرةً فِي","كَ بِنفسٍ من العَزاءِ مُقِلَّه",46,"ل",2,0],["والأقاحُ افترَّ عُجْباً ضاحكاً","يَدَّعي فضلاً على بعضِ الشجَرْ",47,"ر",1,0],["والأقاليم من ترقبها الوصل","مِراضٌ وفي يديك الشفاء",48,"ا",2,0],["والأقربون الى الامام فهم أولو الز","لفى هناك فههنا قربان",49,"ن",1,0],["والأقاح افتر عن ثغر لموع","حاكيا مبسمه في الرتل",50,"ل",1,0],["وإلا قفْ ولا تهطل","بحيث نروح نستتر",51,"ر",1,0],["وألاقي كل بسل","في حياتي بازدراء",52,"ا",2,0],["والأُقحوانُ عَلَى الغديرِ تألَّقتْ","أنوارُه والكأسُ رُصِّع بالدرر",53,"ر",1,0],["والأَقاحي والنَرجَسُ الغَضُّ يزهو","مائلاً والورود في الأَكمامِ",54,"م",1,0],["والاقتداء بهم في الدين مفترض","فاقتد بهم واتبع الآثار والسوار",55,"ر",1,0],["والاقحوان نجوم","ليست ترى منقضه",56,"ض",2,0],["والاقربا جميعهم بالرحمه","وكل عبد صالح في الامه",57,"ه",1,0],["والأقحوان كأنما","أوراقه بردٌ مدحرج",58,"ج",1,0],["والأقحوانة ثغر بات يرمقه","للنرجس الغض طرف كلما انفتحا",59,"ح",2,0],["وَالأُقحُوانُ الطَلُّ فَلَجَّهُ","أَم لِلثَنايا الغَرُّ ذا الفَلَجُ",60,"ج",1,0],["والأقلام نبت الأرض مع ضعف ضعفه","لما نشروا معشار فضل به يطوى",61,"و",2,0],["وَالأَقحوان عَلى الشَقائق ناثِرٌ","أَوراقه نثر القُطار سحابها",62,"ب",3,0],["والإقتداء بهم في الدين مفترض","فاقتد بهم واتبع الآثار والسورا",63,"ر",2,0],["والأقربين صلوا وإن منهم بدا","شيء من التقصير والإهمال",64,"ل",1,0],["والأقاحي السمر غُرّتها","مِنْ أرقِّ الحُسن ما ذَبَحا",65,"ح",2,0],["والاقعاد تنويع العروض بكامل","وقل مثله التحريد في الضرب حيث جا",66,"ا",1,0],["والأقحوان كأنه متبسّم","راقت طراوته ورقّ حواره",67,"ر",2,0],["والأقاحي في رباها .","من سباتي أيقظتني",68,"ن",2,0],["والأقحوان نما في كل مفردة","فاحت جزالتها في كل ماأفضى",69,"ض",2,0],["والاقي مرادي واترك الضيق للسعه","ولاالضيق نفسي في ثناياه تاعبه",70,"ب",2,0],["والأقربونَ قصورهم مشهودةٌ","ولباسُ أبناء القصورِ حريرُ",71,"ر",1,0],["والأقربونَ، وما أدراك حالَهُمُ","لم ينفضوا بعدُ عن أجفانِهم وَسنا!",72,"ن",2,0],["وإلا قد سأمت العيش شوقاً","فقل لي لا مساسَ وانت نارُ",73,"ر",1,0],["والأقحوان وقد تخفى خلفها","بتناغمٍ ما أروع التعشيقا",74,"ق",2,0],["والأقربا حسبوه عاد لبيته","معَ أهله يحيا قريرا مُحْبَرا",75,"ر",2,0],["والأقصى والمهد شموخاً","كالمخرز في عين الغضبِ",76,"ب",1,0],["15- والأقْرَبِونَ وَلاؤهُمْ بالخَيْرِ لاَ","بالشَّرِّ ، قُلْ: مَنْ ذَا الذِي سَيُبِيحُ",77,"ح",1,0],["والاقحوان مباسماً معسولة الن","نغمات والورد الجني خدودا",78,"د",2,0]]}