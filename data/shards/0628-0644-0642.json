/ViewPoem.aspx?id=215004",""],[5758,"العاتِرِيّة","https://www.poetsgate.com/ViewPoem.aspx?id=200505",""],[5823,"بكائية لياسمين دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=59163",""],[5851,"مملكة سبأ المزيفة","https://www.poetsgate.com/ViewPoem.aspx?id=152879",""],[5952,"نساء الشِعر","https://www.poetsgate.com/ViewPoem.aspx?id=196742",""],[5956,"يا رب رتِّبْ أمره","https://www.poetsgate.com/ViewPoem.aspx?id=193873",""],[5956,"ولدي تراث كأخيه","https://www.poetsgate.com/ViewPoem.aspx?id=199929",""],[6068,"قال العواذل هل نسيت غرامها -20-","https://www.poetsgate.com/ViewPoem.aspx?id=175899",""],[6078,"بلقيس شعري","https://www.poetsgate.com/ViewPoem.aspx?id=203024",""],[6093,"السيرك","https://www.poetsgate.com/ViewPoem.aspx?id=199883",""],[6127,"لَمُّ الجراحِ","https://www.poetsgate.com/ViewPoem.aspx?id=202685",""],[6142,"الفضل ما بين النبي وصنوه","https://www.poetsgate.com/ViewPoem.aspx?id=155733",""],[242,"يا حسنه والحسن قيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563695",""],[6270,"كأنما شمْعة الرقرَاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69083&r=&rc=7",""],[402,"رؤية أربت على الرؤيا بما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=53566&r=&rc=418",""]],"verses":[["بَلْ قَلَّ فِيهَا لَوْ كَانَ كُلُّ","مِنْ رَهْطِكُمْ جَحْفَلاً لُهَامَا",0,"م",2,0],["بل قد عفتها فلم تترك بها أثراً","ريح لها من لهيب النار أذيال",1,"ل",1,0],["بل قلتَ في شِبْداز ما قُلتَهُ","واضِعَ قدري رافِعَ المركَبِ",2,"ب",1,0],["بل قد حكى التجريبُ أني صارم","ذَكَرٌ فلِمْ أُلْقَى ولا أُتقلَّدُ",3,"د",1,0],["بل قَبُح الصبر إنه غُدَرٌ","بصاحب الصدق أيما غُدرِ",4,"ر",1,0],["بل قال أجلى الليل عن صُبحه","للعين فاصدقْ عنه أو لبِّس",5,"س",1,0],["بل قد أقمت بذكري","ك يا شنيف سُويقا",6,"ق",2,0],["بل قد أقمتَ لعيد اللهو سُنَّتهُ","وما عدوتَ من الإحسان مجراكا",7,"ك",2,0],["بل قيل لي لا فال رأيك مادحاً","أمَّلْتَ مأمولاً وشِمتَ مُخيلا",8,"ل",2,0],["بل قد ارتحْتَ واهتَزَزت لشعري","فأرتك الإمساك نفسٌ لئيمَهْ",9,"م",2,0],["بل قد نظرتَ فلا تغبن أشَفَّهما","فليس ذو الرأي في حظٍّ بمغبون",10,"ن",1,0],["بل قد يَمُتْ دون الألى فوق الثرى","نطقَ البيانُ مُكاتباً ومُلاسِنا",11,"ن",2,0],["بَلْ قَدْ يَعُجُّ لَظَاهَا","سيلاً ويطغى الضِّرامْ",12,"م",1,0],["بلقائهم فرجت ما","في غور نفسي من هموم",13,"م",1,0],["بَل قالَ لِلغالِبِ قَولاً لَيِّنا","الآنَ صِرنا اِثنَين أَنتَ وَأَنا",14,"ن",2,0],["بِلُقاكُمُ بِسَماءِ البَحرِ ضاحِيَةً","وَتارَةً بِفَضاءِ البَرِّ مُزدانا",15,"ن",2,0],["بل قد ركِبتُ من الذُّنوبِ عظيمَها","ورجوتُ عفوَكَ فاعْفُ عني واغفِرِ",16,"ر",1,0],["بَل قابِضٌ بِنَواصي الأَمرِ مُشتَمِلٌ","عَلى قَواصيهِ في بَدءٍ وَفي عَقِبِ",17,"ب",1,0],["بل قد مَشَتْ لكَ كالأصباحِ عابقةً","وأنت تحذرها حذرَ الطواعين",18,"ن",1,0],["بَل قَد هُديتُ لِبارِقٍ","هاجَ الفُؤادَ المُدنَفا",19,"ف",2,0],["بَل قلما تجد امرأً","في الناس محمود الصفات",20,"ت",1,0],["بل قرنتْ بينهما أيدي الغيرْ","وافترقا على التلاقي في السير",21,"ر",1,0],["بَلْ قَضوْا أَنْ يَمْنَحُوهُ حَمْدَهُمْ","حَيْثُ لا يَجْدُرُ أَنْ يُبْلغَ عُذْرَا",22,"ر",2,0],["بِلِقَائِهَا حُسْناً يُضَاعِفُ مَا بِهَا","مِنْ رَوْنَقٍ وَنَفَاسَةٍ وَبَهَاءِ",23,"ا",2,0],["بلقيسُ ! ... يقتتل الأقيالُ فانتدبي","إليهم الهدهد الوفَّى بما أئتُمِنا",24,"ن",2,0],["بل قَامِرُوا بمصيركم","فلَرُبَّمَا فاز المُقَامر",25,"ر",1,0],["بل قذفنا العدوَّ في مَوَجِ البح","ر، وقُتْنَا من لحمه العِقْبانا",26,"ن",2,0],["بل قبلة تغمض العيون لها","تحسب إلفيها يستجمان",27,"ن",1,0],["بلقيس يا أمّ الحضارة أشرقي","من شرفة الأمس البعيد وكبّري",28,"ر",2,0],["بل قد تَفَيَّأ ظِلَّها من حِطّةٍ","نسَبٌ يَسومُ رخيصَه المستام",29,"م",1,0],["بل قد يُمثلها الخيالُ كأنها","قمر احيط بهالة بيضاء",30,"ا",2,0],["بل قسمي أعداه بين قتيله","وأسيره كي يشتفى وحريبه",31,"ب",2,0],["بل قال خير الورى دعهن فهولنا","عيد فقلنا وما في ذا من العجب",32,"ب",1,0],["بَل قَسَماً بِالشُمِّ مِن يَعرُبَ هَل","لِمُقسمٍ مِن بَعدِ هَذا مُنتَهى",33,"ا",1,0],["بِلُقيايَ مَلكاً زَيَّنَ المُلكَ مُذ رَقَى","ذُراهُ وَحَلّى مِنهُ ما كانَ عاطِلا",34,"ل",2,0],["بلقيسُ أنت وعرش المجد تحت يدي","ورثته أنا عن جدي سليمان",35,"ن",1,0],["بَلْ قَطْرَةً مِنْ آسِنٍ","لِلنِّيلِ حِينَ طَمَى وَأَزْبَدْ",36,"د",1,0],["بِلِقاءٍ فيه قُرْبٌ","ثُمَّ وَصْلٌ، واشتريني",37,"ن",2,0],["بَلقيسُ هذي ولكن عَرشُها قَدَحٌ","كأنَّهُ لعقولِ الناسِ مِقياس",38,"س",1,0],["بل قالَ وهو مفكّرٌ في خَوفهِ","حوّاءُ عن هذا الإلهُ نهانا",39,"ن",2,0],["بلقا سعدي فياللَه من","نفس صب ظفرت إذ صبرت",40,"ت",1,0],["بل قلتُ للنَّفسِ تَقلِيداً لِفعلكَ بي","لَو لم يَكُن حَسَناً لم يَرضَه حَسَنُ",41,"ن",1,0],["بل قال قوم إنها قد كلفت","ولكن بها من حبسها من مرسل",42,"ل",1,0],["بلقاك ألقى كل علم نافع","وأوافق الآداب عندك عن يد",43,"د",1,0],["بل قلته متحدثاً","بنعيم من أعطى وأجدى",44,"د",2,0],["بلقيسُ في صَرْحِ قواريرِها","واقِفةً في الحُللِ الخُضْرِ",45,"ر",1,0],["بل قريضٌ من سِّيدٍ سَدَّ عَنِّي","لَهَواتِ العِدَا وشَدَّ وشَادا",46,"د",2,0],["بل قد ذخرتك جنة","عند النوازل بالتوى",47,"ا",1,0],["بِلِقا الإمامِ الماجِدِ الْفَرْدِ الْفَتَى ال","سَّامِي المعانِي السَّيِّدِ الْمَحْمودِ",48,"د",1,0],["بَل قَد شَدَوتَ به شُحرُورَ رَابِيَةٍ","كُنَّا لَدى شَدِوِهِ نَهتَزُّ أغصَانا",49,"ن",2,0],["بل قد خلقت جميع الخلق يا صافي","مع أنني عبد فاني عند وصَّافي",50,"ي",1,0],["بل قال خير أهلها ومن سكن","فيها من الناس الحسين والحسن",51,"ن",1,0],["بل قد سرى في بلاد الله قاطبة","عبيره مثل عرف الند والعود",52,"د",1,0],["بل قد اقام لنا بناء باذخا","منه يدر الخير للسكان",53,"ن",1,0],["بل قلت ذلك واجبي نحو الورى","وعلىَّ حتّمه الإله الأكبر",54,"ر",1,0],["بلقاك اورشليم تفرح مثلما","فرحت قديما اذ أتى المتأنس",55,"س",1,0],["بَل قَد عكفت عَلى الأَوزار فيهِ فَلا","أَحجمت عَنها إِلى حين اِنقِضاهُ وَلا",56,"ل",2,0],["بلُقيا رجالٍ في مواطنَ طالما","بَنَتْ وبَنَوْا فخر الرجال أَثِيلا",57,"ل",2,0],["بلقيس نظم وعرش الدر مسكنها","فهل ارى كفؤها الا سليمانا",58,"ن",2,0],["بَل قَد أَرومُ طروقَ الحَيِّ زائِرها","أَزورها أَيَّما وَقتٍ عَلى مهَلِ",59,"ل",1,0],["بَل قالَ لي مَن أَنتَ مغمضَ عَينِهِ","قُلتُ المُولَّعَ فيك فَاِفتَح عَينَكا",60,"ك",2,0],["بَل قُل لِشَمسِ الشرقِ وَالأفقِ اِختَفي","فَلَقَد بَدَت في الشَّرقِ شَمسُ المغربِ",61,"ب",1,0],["بَل قالَ للجَدي بِلا تَأنّي","أَنتَ طَويلٌ في القوام عَنّي",62,"ي",1,0],["بَل قَد شجاك هَوى لدارة رادس","وَالريح تَصفر وَالغصون تصفق",63,"ق",1,0],["بل قطعنا الليل وصلا","بين ضم والتزام",64,"م",1,0],["بِلْقَيْسُ وَرْقَائِهَا تَهَادَتْ","لَمَّا رَأتْ صَرْحَهَا الْمُمَرَّدْ",65,"د",1,0],["بل قال لست بخير إذ وليتكم","فقوموني فإني غير معتدل",66,"ل",1,0],["بِلِقاء من سمح الزَّمان بِقُربه","وَشَفى بِتَعجيل الإِياب صُدورا",67,"ر",2,0],["بَلْ قَدْ رَكِبْتُ المَرْكَبَ المُغَامِرا","أَنْظُرُ مَوْلَى حُرْمَةٍ وَزائِرا",68,"ر",2,0],["بَلْ قَدْ حَلَفْتُ حَلَفاً وَناذِرا","وَكُنْتُ وَالإِخْبارُ تُحْفِي الخابِرا",68,"ر",2,0],["بَلْ قُلْ لِعَبْدِ اللَّهِ بَلِّغْ وَابْلُغِ","مُسَبِّحاً يَعْلَمْ بِأَنْ لَمْ أَفْرُغِ",69,"غ",1,0],["بَلْ قَدْ حَلَفْتُ حَلِفاً لا إِيثَمُهْ","ثُمَّت أَحْذُوهُ بِنَذْرٍ يَقْسِمُهْ",70,"م",2,0],["بلقاك طابت كل نفسٍ واحتست","كأساً من الفرح المتمّم منعما",71,"م",2,0],["بل قذاها نديمُ سوءٍ عَلَيها","مولعٌ بالمراءِ أو بالسِّباب",72,"ب",1,0],["بلقيسُ حُسنِ كَالبَدرِ","تَجَلى عَلى عَرشِ السَدرِ",73,"ر",1,0],["بل قضى نفسُ النبيّ المرتضى","وأُدرج الليلة في أثوابه",74,"ب",2,0],["بلقاء الأمير لا عدمت نف","سي وعيني لقاءه من أمير",75,"ر",1,0],["بل قلت عبد تمنّى عقد بيعته","والعبد يبطر أحياناً إذا شبعا",76,"ع",2,0],["بل قاومت بإباء كل داهية","كانت على أرضها سيلا من النقم",77,"م",1,0],["بل قليل لنفسه لو جميع الخل","ق كانوا مما دهاها فداها",78,"ا",3,0],["بل قامت الدينا به","وعنت لعزته الرقاب",79,"ب",1,0],["بَل قِيلَ قَد خَتَنَ المُطَهَّرَ جَدُّهُ","أَيضاً وَأَولَم ثُمَّ أَطعَمَ مَن حَضَر",80,"ر",1,0],["بَل قالَ هذَا ابنى لَهُ شأنٌ سَما","فَبَخٍ لِمَن وَالاهُ ثُمَّ وَمَن نَصَر",81,"ر",1,0],["بل قل إذا جاء من يبغي نزالكمُ","ما لي من المالِ إلا حظ آمالي",82,"ل",2,0],["بلقاه عاد السرور بشيراً","والزمان العبوس ابدى ابتساما",83,"م",2,0],["بل قَالَ لَيسَ ببائِنٍ عَنهَا وَلاَ","فِيهَا ولا هُوَ عَينُهَا بِبَيَانِ",84,"ن",1,0],["بَل قَالَ مُوسَى كَاذِبٌ فِي زَعمِهِ","فَوقَ السَّمَاءِ الرَّبُّ ذُو السُّلطَانِ",84,"ن",1,0],["بَل قَالَهُ المُتقدِّمُونَ فَوارِصُ ال","إسلامِ هُم أمَراءُ هَذَا الشَّانِ",84,"ن",1,0],["بَل قَولُهُم إنَّ السَّمَوَاتِ العُلَى","فِي كَفِّ خَالِقِ هَذِهِ ا