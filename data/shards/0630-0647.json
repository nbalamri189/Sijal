e/diwan/poem/43638","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54285","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54246","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54283","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[106,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[106,"سفينة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179666",""],[50,"عفَا بَعْدَ «سَلْمَى » حَاجرٌ فَذُنَابُ","https://www.poetsgate.com/ViewPoem.aspx?id=17123",""],[18,"إن تحت الأحجار حزما وعزما","https://www.poetsgate.com/ViewPoem.aspx?id=27785",""],[58,"ذهبَ الوفاء ذهابَ أمس الذاهب","https://www.poetsgate.com/ViewPoem.aspx?id=22548",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[45,"أحَرَامٌ أنْ يُنْجَزَ المَوْعُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=31604",""],[45,"إنّما الغَيّ أنْ يكونَ رَشيدَا","https://www.poetsgate.com/ViewPoem.aspx?id=31696",""],[45,"إنّ الزّمَانَ زَمَانُ سَوْ،","https://www.poetsgate.com/ViewPoem.aspx?id=31660",""],[91,"أم القرى","https://www.poetsgate.com/ViewPoem.aspx?id=53352",""],[91,"دمعة على جبران جبران","https://www.poetsgate.com/ViewPoem.aspx?id=52997",""],[51,"يا راغباً نزعت به الآمالُ","https://www.poetsgate.com/ViewPoem.aspx?id=30263",""],[51,"لي صديقٌ إذا تُنوول عِرضي","https://www.poetsgate.com/ViewPoem.aspx?id=30671",""],[51,"قدم الفطرُ صاحباً مودُوداً","https://www.poetsgate.com/ViewPoem.aspx?id=27637",""],[51,"ما القلبُ في إثْرِهم بمختطَفِ","https://www.poetsgate.com/ViewPoem.aspx?id=29597",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[105,"طاف بالقوم يحيى المؤمنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54959&r=&rc=129",""],[31,"ذهبَتْ ولَمْ تُلْمِمْ بديباجَة ِ الحَرَمْ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19054&r=&rc=317",""],[85,"أخذتْ نعشكِ مصرُ باليمينْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9630&r=&rc=120",""],[18,"أن في الصدر من كُلَيْب شجونا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26436&r=&rc=2",""],[18,"إنَّ تَحْتَ الأَحْجَارِ حَزْماً وَعَزْمَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26455&r=&rc=21",""]],"verses":[["ذَهَبوا بِشَأوِ المَجدِ ثُمَّ تَلَفَّتوا","هُزُواً إِلى الطُلّاعِ وَالطُلّاحِ",0,"ح",1,0],["ذَهَبوا فَصِرتُ خِلافَهُم مُتَلَدِّداً","مُتَحَيِّراً ذا حَسرَةٍ وَتَملمُلِ",1,"ل",1,0],["ذَهَبَ الفُؤادُ فَما أُحِسُّ حَسيسَهُ","وَأَظُنُّهُ بِوِصالِكُم سَيَعودُ",2,"د",1,0],["ذَهَبَ الكِتابُ وَكانَ في عُنوانِهِ","هَذا مِن اِبنِ الأَحنَفِ بنِ الأَسوَدِ",3,"د",1,0],["ذَهَبَ الحَبيبُّ فَيا بَلا","ئِي كَيفَ طالَ بِيَ اِغتِرابي",4,"ي",1,0],["ذَهَبَ الرِجالُ المُقتَدى بِفِعالِهِم","وَالمُنكِرونَ لَكُلِّ أَمرٍ مُنكَرِ",5,"ر",1,1],["ذَهَبتُ وَكانَ المَرءُ يَبلو وَيُبتَلى","أُطالِعُ ما قالَ المِجَرُّ بِنَ مالِكِ",6,"ك",1,1],["ذَهِلْتَ يوماً فكانت فِتنَةٌ عَمَمٌ","وَثابَ رُشدُكَ فانجابَتْ دَياجِيها",7,"ي",3,0],["ذهب النجيب فلا نجيب إذا دعا","داعي الوفاء وكان يوم وفاء",8,"ا",2,0],["ذهب النديم فلا نديم إذا دعا","داعي الصفاء ولات عهد صفاء",8,"ا",2,0],["ذهب الفتى الحر الصريح وكان من","يرقى الذرى لو عاش عيش مراء",8,"ا",2,0],["ذهب الأديب الألمعي وأنه","للألمعي الفرد في الأدباء",8,"ا",2,0],["ذهب الذي لو شاء نظم جمانه","لغدا المشار إليه في الشعراء",8,"ا",2,0],["ذَهَبَ القَضَاءُ بِفَاضِلٍ","أمْثَالُهُ يَأتُونَ فِي مُتَبَاعِدِ الأَزْمانِ",9,"ن",1,0],["ذَهَبَ الأعِزَّةُ مُصْطَفَى وَرِفَاقُهُ","مَا كَادَ يَخْلُو مِنْ شَهِيدٍ عَامُ",10,"م",1,0],["ذِهْنُهُ ثَاقِبٌ له بَصَرُ النَّجْ","مِ مِنَ الأَوْجِ وَالشُّعَاعُ القَويِمُ",11,"م",1,0],["ذَهَبتُ وَما أَدري إِلى أَينَ أَذهَبُ","وَأَيُّ الأُمورِ في العَزيمَةِ أَركَبُ",12,"ب",1,1],["ذهبت لحيٍّ في فروق تزاحمت","به الخلق حتى قلت ما أكثر الخلقا",13,"ق",2,1],["ذهب الحياء فكم رأينا صاغراً","قد جاء وهو لمِذْرَوَيه نَفُوض",14,"ض",1,0],["ذَهَبَ الصِبا وَنَسينَ إِذ أَيّامُنا","بِالجَلهَتَينِ وَبِالرَغامِ قِصارُ",15,"ر",1,0],["ذَهَبَ الَّذينَ يُعاشُ في أَكنافِهِم","وَبَقيتُ في خَلفٍ كَجِلدِ الأَجرَبِ",16,"ب",1,0],["ذهبت تَحير إليه وه","ي بغير منزلة المحاورْ",17,"ر",1,0],["ذَهَبَت بِاِبنِ الزَبَعرى وَقعَةٌ","كانَ مِنّا الفَضلُ فيها لَو عَدَل",18,"ل",1,1],["ذَهَبَت قُرَيشٌ بِالعَلاءِ وَأَنتُمُ","تَمشونَ مَشيَ المومِساتِ الخُرَّعِ",19,"ع",1,0],["ذهبا فلا ذهبٌ أناديه سوى","ما صاغ خدِّي باحمرارِ بكائي",20,"ي",1,0],["ذهبت بنو شادِي الملوك وأقبلتْ","أيَّامهُ فكأنَّهم لم يذهبُوا",21,"ب",3,0],["ذهبت بالذي ملكت من الما","ل كأنيَ سبكة في القناني",22,"ن",2,0],["ذَهبَ العيونِ إذا مَثلت لنا","دُرَّ الجفون زَبَرْجد القُضُبِ",23,"ب",1,0],["ذهب الصوم وهو يحكيك نُسْكاً","وأتى الفطرُ هو يحكيك جودا",24,"د",2,0],["ذهبت بالدَّهْيِ والسماح معاً","والناس من ذا وذاك في طرف",25,"ف",1,0],["ذهب الشباب فبان ما لا يرتجى","وأتى المشيب فجاء ما لا يصرف",26,"ف",1,0],["ذهبت نضرة خدَّي","ك وما شيء بباقي",27,"ق",2,0],["ذهب النوالُ فما يُحسُّ نوالُ","وعفا الفعالُ فَما يحسُّ فعالُ",28,"ل",1,0],["ذهَب الذي ذهبتْ يداهُ وفيهما","للراغبين مناله ومصالُ",28,"ل",1,0],["ذهب الذي نالتْ يداه من العلا","ما لا ينالُ من المديحِ مقالُ",28,"ل",1,0],["ذهب الذي كان الصيامُ شعارَه","ولضيفهِ الإنزالِ والآكالُ",28,"ل",1,0],["ذهب الذي أوصاه آدمُ إذ مضَى","بعياله فهمُ عليه عيالُ",28,"ل",1,0],["ذهب الذي ما كان يمطل وعدَه","وله إذا جارى السماحَ مِطالُ",28,"ل",1,0],["ذهبتَ وإسماعيلُ في غير مذهبٍ","وأكثرُ تُبّاعِ المطامِع ضُلّالُ",29,"ل",1,0],["ذهبَ الذين تَهزُّهُمْ مُدَّاحُهُمْ","هَزَّ الكُماةِ عواليَ المُرّان",30,"ن",1,1],["ذهب الذين يهزُّهُم مُدَّاحُهُم","هَزَّ الكُماة عواليَ المُرَّان",31,"ن",1,0],["ذهب الواضعون ثِقل التجنّي","عنك والحاملون ثِقْل التجني",32,"ن",2,0],["ذَهَبَت قُرَيشٌ بِالمَكارِمِ وَالعُلى","وَاللُؤمُ تَحتَ عَمائِمِ الأَنصارِ",33,"ر",1,0],["ذَهَبتَ مِنَ الهِجرانِ في غَيرِ مَذهَبٍ","وَلَم يَكُ حَقّاً كُلُّ هَذا التَجَنُّبُ",34,"ب",1,1],["ذَهَب الساحِرون وَالسِحرُ باقٍ","في عُيونِ المَهى وَفي كَلِماتِه",35,"ت",2,0],["ذَهَبَ الصِبا وَبَقَيتِ في حَسَراتِهِ","لَيتَ الأَسى مِثلَ الصِبا لِنَفادِ",36,"د",1,0],["ذَهَبَ الصِبى وَمَضى الهَوى مَعَهُ","أَصَبابَة وَالشَيبُ قَد وَفَدا",37,"د",2,0],["ذَهَبَ الرَبيع وَجِئتَنا فَكَأَنَّما","جاءَ الرَبيعُ زُهورُه وَطُيورُهُ",38,"ر",2,0],["ذَهَبَ الرَبيعُ ذَهابَهُ","وَأَتى الشِتاءُ بِلا نَذيرِ",39,"ر",1,0],["ذَهَبَ الشَبابُ عَلى الشُجون تَبُثُّها","لِأَخٍ مُؤاسٍ أَو لِغَيرِ مُؤاسِ",40,"س",1,0],["ذَهَبَ الرَبيعُ فَلَم تَكُن في الجَدوَلِ ال","شادي وَلا الرَوضِ الأَغَنِّ المُمرَعِ",41,"ع",1,0],["ذَهَبَ الصِبا وَأَنا أُعالِجُ سِرَّها","مُتَحَيِّراً في كَنَهِها وَمَآلَها",42,"ل",3,0],["ذَهَبتَ فَلا باكٍ وَأَنّى بَكى العَمى","كَفيفٌ رَأى الأَضواءَ مِلءَ العَوالِمِ",43,"م",1,0],["ذَهَبَت كُلُّ ظُنوني في الهَواء","وَتَوَلَّت مِثلِ أَضغاثِ المَنام",44,"م",1,0],["ذَهَبتَ بِزينَةِ الدُنيا جَميعاً","فَما في الدَهرِ بَعدَكَ ما يَزينُ",45,"ن",1,0],["ذَهَبَ الرَبيعُ فَفي الخَمائِلِ وَحشَةٌ","مِثلُ الكَآبَةِ مِن فِراقِكَ فينا",46,"ن",2,1],["ذَهَبَت بِمَن صَلُحوا وَمَن فَسَدوا","وَمَضَت بِمَن تَعيسوا وَمَن سَعِدوا",47,"د",3,0],["ذَهَبَت عُشرونَ في فُرقَتِها","لَيتَا فيها اِنقَضَت لا في سِواها",48,"ا",3,0],["ذَهَبُ الشَمسِ عَلى آفاقِها","وَسَوادُ اللَيلِ مِسكٌ في ثَراها",49,"ا",3,0],["ذَهَبتُ مُسائِلاً عَن خَيرِ شَيءٍ","لِأَعرِفَ كُنهَ أَخلاقِ البَرِيَّه",50,"ي",2,1],["ذَهَبَ الشَبابُ وَإِنَّما","حَسَراتُهُ هِيَ باقِيَه",51,"ي",2,0],["ذَهَلَ الأَنامُ لِكُلِّ مَجدٍ حُزتَهُ","لَم يَحوِهِ التَشبيهُ وَالتَمثيلُ",52,"ل",1,0],["ذَهَبَ الجَديدُ مِنَ الشَبا","بِ فَكَيفَ ظَنُّكَ بِالخَليعِ",53,"ع",1,0],["ذَهَبَت مَحاسِنُكَ الَّتي","كانَت يُقامُ لَها وَيُقعَد",54,"د",1,0],["ذَهَبَ الأُلى كانوا الغِياثَ لِأُمَّةٍ","حاقَ البَلاءُ بِها وَضاقَ المَذهَبُ",55,"ب",1,0],["ذَهَبَت مُلِمّاتُ الزَمانِ بِنورِها","مِمّا تَكُرُّ عَلى الهُداةِ وَتَجلِبُ",55,"ب",1,0],["ذهبت كلها الزعامة في الشر","ق فلا منقذ ولا تعويل",56,"ل",1,0],["ذهب الشباب وانت بعد ذهابه","متمسك بالعيش من اذنابه",57,"ه",1,1],["ذهبوا مكرهين من غير عود","وقريب بالذاهبين لحاقي",58,"ق",2,0],["ذهبت كزوبعة لها","صخب فاحمدت الذهابا",59,"ب",2,0],["ذهبت عنك قوة العلم حتى","انعكس الأمر مؤذناً بالهزال",60,"ل",1,0],["ذهب الشباب وكل شيء طيب","وأتى المشيب وكل شيء متعب",61,"ب",1,1],["ذهب الشباب وما تريث غاربا","في ليلي الداجي غروب الكوكب",61,"ب",1,0],["ذهب الشباب ولم يودعني اجل","ذهب الشباب وليته لم يذهب",61,"ب",1,0],["ذهبوا مثل ما اتوا","زمرا بعدها زمر",62,"ر",1,0],["ذهبت ولم ترجع فهل كان واقفا","لك الموت في جنب الطريق بمرصاد",63,"د",1,0],["ذهب الشباب فما الشباب براجع","واتى المشيب وانه لا يقلع",64,"ع",1,0],["ذهب الماء وفي القل","بِ الى الماء لهاب",65,"ب",1,0],["ذهبوا بالهمام تواً الى القبر","الى منزل الهمام الاخير",66,"ر",1,0],["ذهبت ايام الشباب سراعا","فوداعاً لهن ثم وداعا",67,"ع",2,1],["ذهب العيش فيه عني حلواً","آه لو كان رده مستطاعا",67,"ع",2,0],["ذهب الربيع فلا ربيع قبالتي","ومضى الهزار فلا هزار حيالي",68,"ي",1,0],["ذهب الزرع عند ادراكه","والبيت ثم الشياه والبقرات",69,"ت",1,0],["ذهب النقد والعَقَار جميعا","ياسَراة البلاد أين العقول",70,"ل",1,0],["ذهب على أثر الفقيد شهيدة","إن كنت في ريب فسل شهداءها",71,"ا",3,0],["ذهب الرجل فلا حيا","ء ولا احتشام ولا انقباش",72,"ش",1,0],["ذهبت من عاذل قاس بداهية","فلست تعلم ما تأتي وما تذر",73,"ر",1,0],["ذهبت في حساب يوسف سبع","لينات في إثر سبع شداد",74,"د",1,0],["ذهب الدهر كله","بين يوم وليلة",75,"ه",1,0],["ذَهَبتَ أَبا عَبدِ الحَميدِ مُبَرَّءاً","مِنَ الذامِ مَحمودَ الجَوانِبِ زاكِيا",76,"ي",2,0],["ذَهَبَت أَوّابَةً مُؤمِنَةً","خالِصاً مِن حَيرَةِ الشَكِّ هُداها",77,"ا",3,0],["ذَهَبَت عَن عِليَةٍ صَيدٍ وَعَن","خُرَّدٍ مِن خَفِراتِ البَيتِ عين",78,"ن",1,0],["ذَهَبَ الَّذينَ حَمَوا حَقيقَةَ عِلمِهِم","وَاِستَعذَبوا فيها العَذابَ وَبيلا",79,"ل",2,0],["ذَهَبَت كَحُلمٍ بَيدَ أَن","نَ الحُلمَ لَم يَتَأَوَّلِ",80,"ل",1,0],["ذَهَبَ الشَبابُ فَلَم يَكُن رُزئي بِهِ","دونَ المُصابِ بِصَفوَةِ الأُلّافِ",81,"ف",1,0],["ذَهَبَ الذَبيحُ السَمحُ مِثلَ سَمِيِّهِ","طُهرَ المُكَفَّنِ طَيِّبَ الأَلفافِ",81,"ف",1,0],["ذَهَب الأَوَّلونَ قَ