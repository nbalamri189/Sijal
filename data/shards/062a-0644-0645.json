فَيْصَلٍ مَلِكَ العِرَاقِ",19,"ق",1,0],["تلمس النجمة في مبسمها","ويرى ذوب الدجى في المقل",20,"ل",1,0],["تَلُمُّ شتاتَنا أَنَّى نزلنا","حِجازاً أو عِراقاً أو شَآما",21,"م",2,0],["تلمسين المجندلين فيعدون","تعيدين للبغايا البكاره",22,"ر",2,0],["تلمسِ الجذفَ الزاكي تجدْ لَهثاً","من الشَّكاةِ وتسمعْ للصدى نَفَسا",23,"س",2,0],["تلمَّسَ الحُسنَ لم يمدُدْ بمُبصرةٍ","ولا امتَرى دَرَّةً منها ولا حلبا",24,"ب",2,0],["تلمس العين أينما لمسته","جمرات التياحنا والتياحك",25,"ك",1,0],["تلمّ به الذكرى فيحيا كبارق","طواه الدّجى عنّي ليطلعه الفجر",26,"ر",1,0],["تَلمسُ منِهنَّ يدُ المُباعل","رُمانَ لا قطفٍ ولا مُكاتِل",27,"ل",1,0],["تلمُّ به المسرات ازدياراً","فتعرفه وتجهله الكروب",28,"ب",1,0],["تلملم أسرار البحيرة شرّدا","ويفتنها سكب الشذا فتريم",29,"م",1,0],["تَلْمَعُ كَاسَاتُهُ كَبَارِقَةٍ","فِي كَفِّهِ أَوْ كَذَائِبِ التِّبْرِ",30,"ر",1,0],["تلُمُّني الأشتاتْ","وفي المدى أُذْرى",31,"ر",2,0],["تلمِس بالبطن فَقارَ الظهر","وافِرة الزَوْر رحيب الصدر",32,"ر",1,0],["تلمكين منهن غيداء لو بدت","بجنح الدياجي لاهتدت بجبينها",33,"ن",3,0],["تَلميحُه كَم شَفى في الخلق من عِلَلٍ","وَما لعيسى يَدٌ فيها فَلا تَهِمِ",34,"م",1,0],["تِلميذُ شَيخك ذي المقامِ الشامخِ ال","أَسمى الإِمامِ الشاذليِّ المُقتفى",35,"ف",2,0],["تلمس النفس بؤسه","حين يأسى وينفطر",36,"ر",1,0],["تلمسُ في كلِّ ساعةٍ عَبَثاً","حتَّى كأَنَّ استَها قَفا طاهِر",37,"ر",1,0],["تلميذ مدرسة النبوة ، أنه","لأعزَّ مدرسةٍ تعلمنا الهدى",38,"د",2,0],["تلميذ مدرسة النبوة والهدى","خير الأنام على التقى رباهُ",39,"ا",2,0],["تَلَمَّظَ فِي الأَيْسَارِ مِنْهُمْ أَساوِدٌ","وتَهْتَزُّ فِي الأَيْمانِ منهم أَراقِمُ",40,"م",1,0],["تلمَّحتُ بَرْق الحافلاتِ وسَرَّني","تبَوُّجُه والبرقُ للوَدْقِ حادِر",41,"ر",1,0],["تلمُّ به الأطماع من كلِّ وجهةٍ","سراعاً وتدعو منهُ غير سميع",42,"ع",1,0],["تلمع في سمائها ما أبصرت","عين امرءٍ وحقها مثالها",43,"ل",3,0],["تَلَمَّظَ السَيفُ مِن شَوقٍ إِلى أَنَسِ","فَالمَوتُ يَلحَظُ وَالأَقدارُ تَنتَظِرُ",44,"ر",1,1],["تلُم بالروح في لي الملام بها","فراحة الروح بين اللوم واللمم",45,"م",1,0],["تلميذ قُطب الوَقت حبر زَمانه","السيد ال