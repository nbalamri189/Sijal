ذا الأحد الديموم","https://www.aldiwan.net/poem33854.html","الرمل"],[556,"أتعبتني بقر الشام","https://www.aldiwan.net/poem34182.html","المديد"],[556,"قل لعباد الخيال","https://www.aldiwan.net/poem34200.html","مجزوء الرمل"],[556,"أنت إنسان خيالي","https://www.aldiwan.net/poem34208.html","مجزوء الرمل"],[556,"إن ترم أن تعرف الأحوال","https://www.aldiwan.net/poem34230.html","المديد"],[556,"بدر تم لاح في الغسق","https://www.aldiwan.net/poem34335.html","المديد"],[556,"لبسنتني مليحة الغيب مرطا","https://www.aldiwan.net/poem34406.html","الخفيف"],[556,"نحن علم الله في الله وما","https://www.aldiwan.net/poem34569.html","الرمل"],[556,"من لعبد بجسمه السقم بادي","https://www.aldiwan.net/poem34600.html","الخفيف"],[556,"هيكلي سام سليم الشبح","https://www.aldiwan.net/poem34676.html","الرمل"],[556,"بين أهل الجحود والتكذيب","https://www.aldiwan.net/poem34966.html","الخفيف"],[556,"إن من بعض ما هي الأطوار","https://www.aldiwan.net/poem35092.html","الخفيف"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"عمموها طينو آدم طين","https://www.aldiwan.net/poem2730.html","الخفيف"],[584,"بين بان الحمى وبان المصلى","https://www.aldiwan.net/poem17554.html","الخفيف"]],"verses":[["كُلُّ هَمّي أَن أَراكُم في غَدٍ","مِثلَ ما كُنتُم أُسوداً في أَجَم",0,"م",1,0],["كُلُّهُم يَسأَلُ عَن حالي","وَلِلذِئبِ اِعتِساسُ",1,"س",1,0],["كلهم لم يصل إلى ما توخى","فثوى في الطريق وهو حسير",2,"ر",1,0],["كُلُّهُمْ مُشْبَهٌ أَبَاهُ وَكُلٌّ","هُوَ لَوْلا تَعَدُّدِ الأَجْسَامِ",3,"م",1,0],["كل هذا في صوتها يتجلّى","من خلال الأنغام والألحام",4,"م",1,0],["كل هذا وأنت مستقلّو","ن بزعم من عندهم وامتنان",5,"ن",1,0],["كلهم في العلاء مثل أبيه","حسن الخلق فاضل بهلول",6,"ل",1,0],["كلُّ هذا لقيتُه فأبتْ نف","سيَ إلّا تَعزُّزاً لا اخْتِتاءَ",7,"ا",2,0],["كلهم حين يُسألُ العَرَضَ الأد","نى جَمودُ البنانِ لا يُستذابُ",8,"ب",1,0],["كلُّهَا مُطْرِبٌ وإن لم تحرك","طربَ الميِّتِ الطباع الجمادِهْ",9,"د",2,0],["كلها سجدة وإن كفر الجهْ","ل فجلَّ الإحسانُ عن إسجادِهْ",9,"د",2,0],["كلهم مُشلي كلابٍ","مُسْلَهمّاتٍ ضَواري",10,"ر",2,0],["كلهم بين خائفٍ","مستجير وطامعِ",11,"ع",1,0],["كلهم مُطرقٌ إلى الأرض مُغضٍ","وعلى سيفه هنالك حاني",12,"ن",2,0],["كلُّهم بالمديح إياك يَعْني","كانياً عنك كان أو غير كاني",12,"ن",2,0],["كُلُّها مِثلِيَ تَحيا كُلُّها مِثلي تَموتُ","وَلَها مِثلي شَراب وَلَها مِثلِيَ قوتُ",13,"ت",1,0],["كُلُّهُم نُستَفسِرٌ صاحِبَهُ","كُلُّهُم يُؤذيهِ مَن يَستَفسِرُ",14,"ر",1,0],["كُلُّها كُلُّها لَهُ","وَعَلى غَيرِهِ حَرام",15,"م",1,0],["كُلُّهُم يَشرَبُ سِرَّ الَّتي","يَهوى مِنَ الغيدِ وَيُطرِبُها",16,"ه",2,0],["كُلُّهُم ذَلِكَ الجَريحُ المُلقى","فَلنَكُن كُلُّنا الفَتى السامِرِيّا",17,"ي",2,0],["كلُّ هذا يَشيدُهُ سِحْرُ عينيكِ","وإِلهامُ حُسْنِكِ المعبودِ",18,"د",1,0],["كلُّها تحيا بقلبي حرَّةً","غَضَّةَ السّحْرِ كأَطفالِ الخُلُودْ",19,"د",1,0],["كلهم ينهجون منهج سعد","كلهم فوق ما لهم خط يعدو",20,"و",1,0],["كل هذا في ليلة هطلت فيها","السواحي واشتدت الظلمات",21,"ت",1,0],["كلهم حافظ الصديق كريم ال","عهد راعى الزمام وافي الوداد",22,"د",1,0],["كُلُّهُم كافورُ أَو عَبدُ الخَنا","غَيرَ أَنَّ المُتَنَبّي عَنهُ خابا",23,"ب",2,0],["كُلُّهُمُ أَغيَرُ مِن وائِلٍ","عَلى حِماهُ وَعَلى شَعبِهِ",24,"ب",2,0],["كُلُّ هَوجاءَ لِلدَياميمِ فيها","أَثَرُ النارِ في سَليطِ الذَبالِ",25,"ل",1,0],["كُلُّهُم عالِمٌ بِأَنَّكَ فيهِم","نِعمَةٌ ساعَدَت بِها الأَقدارُ",26,"ر",1,0],["كلُّ هذا بدِرْهَمَيْنِ فإنْ زِدْ","تَ فأَنتَ المبجَّلُ الموفورُ",27,"ر",1,0],["كلُّهم نُصرةٌ لمصرَ ومجدٌ","لِبَنِيها فَاسْعَدْ بجيشكَ وَانْعَمْ",28,"م",1,0],["كُلْ هنيئاً من قليبٍ قَرِمٍ","يَبلعُ الكُفّارَ مَثْنَى وَفُرادى",29,"د",2,0],["كُل هَذا اِستَفاده بَينَ فَوضى","وَشقاق وَذُلة وَهجودِ",30,"د",1,0],["كُلُّهُم أَعمى إِذا ما كانَ خَيرٌ","وَلَدى الشَرِّ بَصيرٌ وَسَميعُ",31,"ع",1,0],["كلُّهُمْ في أحكامه ذو اجتهادٍ","وَصَوابٍ وَكُلُّهمْ أَكفاءُ",32,"ا",2,0],["كُلُّهُم يَصدُقُ اللِقاءَ وَلا يُل","فى كَسَلمٍ في المَأزِقِ المُستَجيرِ",33,"ر",1,0],["كُلَّهُم أَخفَت جَوانِحُهُ","مارِداً في الصِدرِ خَنّاسا",34,"س",2,0],["كُلُّهُمُ أَروَغُ مِن ثَعلَبٍ","ما أَشبَهَ اللَيلَةَ بِالبارِحَه",35,"ح",2,0],["كل هذا وكل ما فوق هذا","فبه طرفُ القوم فيها قرير",36,"ر",1,0],["كل هذا من فضل أمي ولولا","فضلها كنت عرضة للحمام",37,"م",1,0],["كلهم ضارعٌ إليك يرجِّيك","فأسرع أسرعْ إلى الضارعينا",38,"ن",2,0],["كُلُّهُم كادِحٌ بَكورٌ إِلى الرِز","قِ وَلاهٍ إِذا دَعاهُ السُرورُ",39,"ر",1,0],["كلّهموا ابن أمسه ويومه","عماد داره عميد قومه",40,"ه",1,0],["كلهموا فيه المجيب الأول","عطوه غايات الرضى ونوّلوا",40,"ل",3,0],["كُلُّ هَذِي الآيَاتِ مُبْعَثُ وَحْيٍ","لِلنَّظِيمِ المُجَادِ أَوِ لِلنَّثِيرِ",41,"ر",1,0],["كُلُّ هَذِي الآيَاتِ تُؤْخَذُ عَنْهَا","رَائِعَاتُ التمْثِيلِ وَالتَّصْويرِ",41,"ر",1,0],["كُلُّ هَذِي الآيَاتِ يُجْمَعُ مِنْهَا","نَغَمُ الحُزْنِ أَوْ نَشِيدُ السرُورِ",41,"ر",1,0],["كُلُّ هَذِي الدُّمَى الَّتِي عَبَدُوهَا","لَكِ يَا رَبَّةَ الجَمَالِ جَوَارِي",42,"ر",2,0],["كُلُّهُمْ عِندَ مَا تُحِبٌّ المَعَالِي","خُلُقاً نَابِهاً وَفِكْراً مُنِيرَا",43,"ر",2,0],["كل هذي الزهور؟ ما أفجع الزهر","صريعا على نيوب المناجل!",44,"ل",1,0],["كل هذا العبير من طيب مريول","ومن خفقه الصبا في الجدائل؟",44,"ل",1,0],["كل هذا الجمال؟ ما رأت الأحلام","أبهى من الصبايا الغوافل",44,"ل",1,0],["كُلُّهُمْ يَسْأَلُ عَنْ سَعْدٍ وَمنْ","عَيْنهِ ماءُ الشُئُونِ انْهَمَرَا",45,"ر",2,0],["كلُّهم حرُّ أبيُّ ينتمي","في ذُرا المجدِ إلى حرٍ أبي",46,"ب",2,0],["كُلُّهمْ كانَ لِلْمَحامِدِ بَنّا","ءً أبيّاً عَلَى الزَّمَانِ بِناؤه",47,"ا",3,0],["كُلُّهُمْ يَجْأَرُونَ بِالْعِزِّ لِلْفَا","رُوقِ وَالعْيْشِ نَاضِراً وَرَغِيدا",48,"د",2,0],["كلُّ هذا وسوف أنتحرُ اليوم","لأنيّ أرى المعيشةَ غَبنا!",49,"ن",2,0],["كلها تُصبحُ إرثاً ضائعاً","ليَنُح\" هارونُ \" وليبكِ \" الأمين \"",50,"ن",1,0],["كلُّ هذا وهو يومٌ واحدٌ","كيف لو مرَّتْ مئاتٌ وألوف",51,"ف",1,0],["كلُّ هذا ولم تصونوا رُبوعاً","سِلتُ فيها ولم تُجيدوا الدفاعا",52,"ع",2,0],["كلّهم الجريح الملّقى","فلنكن كلّنا الفتى \" السّامريّا \"",53,"ي",2,0],["كُلهم مُستَفسِرٌ صَاحبه","كلُّهم يُؤذيه من يَستَفسِر",54,"ر",1,0],["كلهم في حائرٌ ليس يدري","أمن الأنس أم من الجنان",55,"ن",1,0],["كلُّهم يشكرون فضلَك إذْ تُسْدِى","عليهم مِن جُودِكَ الأفْضَالاَ",56,"ل",2,0],["كلُّ هذا مُطرِبٌ تَسمَعُهُ","نفسُ مَحزونٍ فيُنسِيها الكَدَر",57,"ر",1,0],["كلُّهُم يَلعَبُ دَوراً","غيرَ ما يَخفِي الضَمير",58,"ر",1,0],["كلُّها حالاتُ وقتٍ","كَغبوقٍ وبُكور",58,"ر",1,0],["كلُّها تَمثيلُ أدوارِ","على مَلهى العُصور",58,"ر",1,0],["كلُّها فينا ولكن لم تحرِّك","ساكناً إلا اللِسان",59,"ن",1,0],["كلُّ هذا جَهدُ المقلِّ وما قصَّ","ر من يبتنى لمجدك ذِكرا",60,"ر",2,0],["كلهم دونك في الجود ومن","فاخر المال غدا تخجله",61,"ل",2,0],["كل هذا جرى بتأييد ربّ","حاكم عند قسمة الأرزاق",62,"ق",1,0],["كل هجو قيل في رجل","فهو في عرضي وفي حسبي",63,"ب",2,0],["كلُّه آيات حقٍّ بيّنات","دلّتِ الناسَ على صدقِ البشير",64,"ر",1,0],["كُلُّهُ عَنهُ فاضَ مِن غَيرِ نَقصٍ","مِثلَما فاضَ عَن ذكاءَ الضِياءُ",65,"ا",2,0],["كُلُّهم سادةٌ عدولٌ ثقاتٌ","صلحاءٌ أئمّةٌ أتقياءُ",65,"ا",2,0],["كلُّ هديٍ منَ النبيّ فَعَنهم","ما لَنا غيرهُم طريقٌ سواءُ",65,"ا",2,0],["كلَّها وهيَ ألف بيتٍ قصورٌ","عنكَ ضاقت وإنّها فيحاءُ",65,"ا",2,0],["كلُّهمُ كانَ لهُ مُطيعا","فَلَم يَكُن لعبدهِ مُضيعا",66,"ع",2,0],["كُلُّهُم فاضِلٌ عَلَيَّ بِمالٍ","وَلِساني يَزينُهُ التَحبيرُ",67,"ر",1,0],["كلها آياتُ حسنٍ","بعضها ينسخُ بعضا",68,"ض",2,0],["كل هذا الورى وحقكمُ","رهن جزر الزمان والمد",69,"د",1,0],["كلّ هذا وإنها في شعار ال","حجب من نور عزّها المحميّ",70,"ي",1,0],["كلهم خير ولكن أين من","أحد الخلق سليل الأنبياء",71,"ا",2,0],["كُلُّ هذا جَمَعتُ وَالحَمدُ لِلَّ","هِ عَلى أَنَّني ظَريفُ المُزاحِ",72,"ح",1,0],["كلُّهم كانوا غُصوناً","فغدوا ثمَّ هَشيما",73,"م",2,0],["كلهم خائِفونَ منك فآمن","خوفهم ان أَلم هول مهول",74,"ل",1,0],["كُلُّ هَيفاءَ رداحٍ طفلَةٍ","حُسنُها لِلحُسنِ في الخَلقِ هَيولا",75,"ل",2,0],["كُلُّ هَيفاءَ كَالمُثَقَّفِ قَدّاً","لَحظُها كِالسِنانِ باساً وَبُوسا",76,"س",2,0],["كُلُّهُم في الصَلاةِ داعٍ لَكَ اللَ","هَ دُعاءَ المُجيبِ بِالمُستَجابِ",77,"ب",1,0],["كلهم بادوا ولم يبق لهم","غير ذكر بلسان ذي التوا",78,"و",2,0],["كلها روّعت لفقدك يا غازي","وجادت بدمعها الهتان",79,"ن",1,0],["كلّه مقدّر","واد قلبي معاك",80,"ك",1,0],["كلّهم ذابحٌ ذبيح فيما أش","به قلب المريع بالمرتاع",81,"ع",1,0],["كل هذا الجمال للقبر يا رب","ألاما أشقى ضحايا 