{"poems":[[49,"ندبت لحسن الصبر قلب نجيب","https://www.aldiwan.net/poem25369.html","الطويل"],[53,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[53,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[101,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[68,"لعل ليالي الربوتين تعود","https://www.aldiwan.net/poem41357.html","الطويل"],[99,"ها أنا عدت إلى حيث التقينا","https://www.aldiwan.net/poem24925.html","الرمل"],[99,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[46,"مهاة النقا لولا الشوى والمآبض","https://www.aldiwan.net/poem30473.html","الطويل"],[46,"إن بكاء في الدار من أربه","https://www.aldiwan.net/poem30574.html","المنسرح"],[48,"المرء يأبر خسة في طبعه","https://www.aldiwan.net/poem22716.html","الكامل"],[48,"هي طرق فمن ظهور وأرحا","https://www.aldiwan.net/poem22729.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55027","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55182","الكامل"],[108,"حي البيان","https://www.poetsgate.com/ViewPoem.aspx?id=179367",""],[101,"إفادة في محكمة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=581",""],[119,"يعاودني من خيف ريم النقاطيف","https://www.aldiwan.net/poem40886.html","عموديه"],[139,"كما عاذل في عادل القد لام","https://www.aldiwan.net/poem49130.html","السريع"],[228,"الصيف يا ليل طار","https://www.aldiwan.net/poem39732.html","مخلع البسيط"],[255,"عادت لنا الأعياد والمواسم","https://www.aldiwan.net/poem15025.html","الرجز"],[275,"أحبتنا هل في النوى ينعم البال","https://www.aldiwan.net/poem35615.html","الطويل"],[275,"أنهارنا في غاب كسكاتينا","https://www.aldiwan.net/poem35629.html","الكامل"],[295,"يا قلب كم تشكو القيود","https://www.aldiwan.net/poem11677.html","مجزوء الكامل"],[333,"ألا إن سكرى سكر عبد له كأس","https://www.aldiwan.net/poem54940.html","الطويل"],[333,"اسبقي الشمس كالشعاع وثوبا","https://www.aldiwan.net/poem54975.html","الخفيف"],[398,"حمدا لرب جل عن نديد","https://www.aldiwan.net/poem53683.html","الرجز"],[409,"الحمامة إن أثارت بالهديل","https://www.aldiwan.net/poem32903.html","الرمل"],[422,"عيدي بيوم شفائكم لسقامي","https://www.aldiwan.net/poem54014.html","الكامل"],[445,"سلام على الأيام تسليم إقبال","https://www.aldiwan.net/poem34847.html","الطويل"],[445,"قد الخيل والخير بأسا وجودا","https://www.aldiwan.net/poem34850.html","المتقارب"],[463,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[469,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[469,"راح يستمطر الدموع الغزارا","https://www.aldiwan.net/poem3621.html","عموديه"],[505,"إن معنى الهيام بالأولياء","https://www.aldiwan.net/poem38101.html","الخفيف"],[529,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[563,"يا صاحبي في الرخا وفي الضيق","https://www.aldiwan.net/poem34307.html","المنسرح"],[563,"عبادة للغافلين تكليف","https://www.aldiwan.net/poem34356.html","المنسرح"],[567,"تقلص ظل للشباب وريف","https://www.aldiwan.net/poem52757.html","الطويل"],[580,"كم أعدمتني مشبها أو نظير","https://www.aldiwan.net/poem2723.html","السريع"],[580,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83316","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48735","البسيط"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104562","الطويل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100143","المديد"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56360","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56192","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64946","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46558","الرجز"],[1361,"","https://poetry.dctabudhabi.ae/diwan/poem/104404","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79843","الخفيف"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113963","البسيط"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109331","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27474","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27432","السريع"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106823","المتقارب"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93732","الطويل"],[2451,"","https://poetry.dctabudhabi.ae/diwan/poem/103361","المجتث"],[2478,"","https://poetry.dctabudhabi.ae/diwan/poem/100551","الكامل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132308","الطويل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/128259","الدوبيت"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65951","الطويل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136975",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200755","الخفيف"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/132082","السريع"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134199","الطويل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104360","الخفيف"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61256","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91069","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91314","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117908","الوافر"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86551","المتقارب"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86370","المتقارب"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107040","السريع"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119633","الرجز"],[4087,"","https://poetry.dctabudhabi.ae/diwan/poem/131653",""],[4291,"","https://poetry.dctabudhabi.ae/diwan/poem/198754","الكامل"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139230","المجتث"],[4767,"نبئت","https://www.poetsgate.com/ViewPoem.aspx?id=93823",""],[4767,"ساعات الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=129785",""],[4832,"لطائف الحب أو مستطرف الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=166711",""],[4935,"ملأت قلوبنا موسى سروراً","https://www.poetsgate.com/ViewPoem.aspx?id=129445",""],[4935,"إلهي فرج الكربا","https://www.poetsgate.com/ViewPoem.aspx?id=129287",""],[5038,"روضة الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=189431",""],[5183,"جلوة الحق","https://www.poetsgate.com/ViewPoem.aspx?id=186442",""],[5187,"الضمير الضائع","https://www.poetsgate.com/ViewPoem.aspx?id=29240",""],[5302,"جعلت فداكا","https://www.poetsgate.com/ViewPoem.aspx?id=205728",""],[5431,"يالقلبي واأساه ...","https://www.poetsgate.com/ViewPoem.aspx?id=191671",""],[5691,"سراب المصالحة","https://www.poetsgate.com/ViewPoem.aspx?id=206735",""],[6056,"طري العود","https://www.poetsgate.com/ViewPoem.aspx?id=130346",""],[6106,"إلى ربيع المولد النبوي","https://www.poetsgate.com/ViewPoem.aspx?id=6310",""]],"verses":[["كَما عَلِمَت مِن قَبلِ أَن يَغرَقَ اِبنُها","بِمَهلَكِهِ في الماءِ أُمُّ شَبيبِ",0,"ب",1,0],["كم أُعَنَّى فلا أُسيء عتاباً","كم أُمَنَّى فلا أسيء اقْتِضاءَ",1,"ا",2,0],["كم أعدنا وكم أعاد وهيها","ت بعيدٌ مُعَادُنا من مُعادِهْ",2,"د",2,0],["كم أعاني مما كتبت عذاب","ويعاني في شرقنا الشرفاء",3,"ا",2,0],["كَما عَلِّمَت صَوبَ الحَيا وَهوَ عالِمٌ","يَدُ الصالِحِ السُلطانِ كَيفَ يَجودُ",4,"د",1,0],["كم أعَدَّت نفسَها وانتظرت","واستَوت موُحشةً تحت السماء",5,"ا",2,0],["كم أعدت لك ستراً في الخفاء","وتوارت عن عيون الرقباء",6,"ا",2,0],["كَما عَلِمَ المُستَشعِرونَ بِأَنَّهُم","بَطاءٌ عَنِ الشِعرِ الَّذي أَنا قارِضُ",7,"ض",1,0],["كَم أَعطَبَت راحَتاهُ مِن نَشَبٍ","سَلامَةُ المُعتَفينَ في عَطَبِه",8,"ب",2,0],["كَم أَعظَمَ الأَقوامُ خِبّاً وَاِنبَروا","يَتَمَسَّحونَ لِأَرضِهِ بِجُبارِ",9,"ر",1,0],["كَم أُعاني لِلدَهرِ بيضاً وَسوداً","بَينَ خُضرٍ مِنَ السِنينَ وَحُمرِ",10,"ر",1,0],["كَمَا عِشْتَ حَتى انْتَبَذْت الحَيَاةَ","كَرِيمَ الإِقَامَةِ وَالمُنْصَرَفْ",11,"ف",1,0],["كَمْ أَعْتَقَتْ نُعْماكِ مِنْ","رَقِّ الهَوَانِ رَقِيقَ حَالِ",12,"ل",1,0],["كما عفَّت الدنيا أديبًا قَارِحًا","فأصاب في نَاديك حُسْنَ ثوابه",13,"ب",2,0],["كم أُعاني مما كتبتُ عذاباً","ويعاني في شرقنا الشرفاءُ",14,"ا",2,0],["كما عالج المجروح بالفكر جرحه","وهل نبرء الافكار ما جرح السيف",15,"ف",1,0],["كما عاذلٍ في عادلِ القدّ لامْ","وبانَ لمّا بان في الخدّ لام",16,"م",1,1],["كَما عَشِقنا","فَالعُمرُ كَأسٌ وَعاشِقان",17,"ن",1,0],["كم أعجَبَتهُ نفسه فيها إلى","أن نَفدَت من كُمّه الدراهم",18,"م",1,0],["كما عرَّضَ الجنديُّ في الحربِ صَدرَهُ","وباهى بجرحِ السَّيفِ والرمحِ أبطال",19,"ل",1,0],["كم أعبدُ البدرَ المطلَّ على ذُرى","تلكَ الجبالِ وأحسدُ الشاهينا",20,"ن",2,0],["كم اعقموا الفكر السليم","وكبلوا الطبع الأكيد",21,"د",1,0],["كما عرفوه دون ذلك تاجرا","على ظلمه يبتاع منه ويشترى",22,"ر",2,0],["كم أعانوه خفيةً وجهاراً","ليردّوا به المصير الرهيبا",23,"ب",2,0],["كَم أَعجَزت من فَيلَسوفٍ عالِمِ","فَعادَ لِلحَقِّ بِأَنفٍ راغِمِ",24,"م",1,0],["كم أعاني في هواهم من ملام","ما أحد في الناس يرحم",25,"م",1,0],["كم أعرَبَتْ أَلفاظُه عن حاله","يوماً فأَعْجَمَ منطقَ الأَعْجام",26,"م",1,0],["كما عَمَّها جَدْوى يَدَيْكَ فوصَّلَتْ","مساءً بإِصباحٍ وسَهْلاً بأَجْبالِ",27,"ل",1,0],["كما عُمِّرَتْ بك سُبْلُ الجِهادِ","جنوداً تَفُلُّ بِهِنَّ الجنودا",28,"د",2,0],["كما عطَّ المشبرِقُ شطرَ بُردٍ","يُطرَّح واستوى شِقٌّ وشِقُّ",29,"ق",1,0],["كم أعادت كفاه ذاك حطاماً","وبهذا ثلماً به سد ثلما",30,"م",2,0],["كم اعرنا منابرَ الدَّوحِ سمعاً","فحمدنا خطيبهنّ الهزارا",31,"ر",2,0],["كم أعادَ السُّمومَ ماءً زُلالاً","باسمِهِ والنِّيرانُ ماجَتْ بماءِ",32,"ا",2,0],["كَم أَعقَبَت راحَةً بِاللّمسِ راحَتُهُ","وَكَم مَحا مِحنَةً ريقٌ لَهُ بِفَمِ",33,"م",1,0],["كم أعرض السامريُّ عنه وكم","أباه في الدين كل بطريق",34,"ق",1,0],["كما عبودية الذين على","صراطه سالكون تعريف",35,"ف",1,0],["كمِ اُعتَلَّ في الدُّنيا صحيحٌ وكمْ وكمْ","تفرَّقَ في عُرْضِ البلادِ لَفيفُ",36,"ف",1,0],["كم أَعْدَمَتْني مُشْبِهاً أَو نَظِيرْ","وأَتعبتْ لي ضَامراً مَع ضَمِير",37,"ر",1,1],["كما عَنَتْ أَوْجُهُهَا","لوجْهِه الْكَرِيمِ",38,"م",1,0],["كَما عَزَّ بِالعِلمِ الأَعارِبُ قَبلَنا","فَذُلَّت وَهابَتهُم لِذاكَ الأَعاجِمُ",39,"م",1,0],["كم أعجبتكم من الأحرار عزتهم","كانوا موالين أو كانوا معادينا",40,"ن",2,0],["كما عادَ بالمستنصرِ بنِ محمدٍ","نظامُ المعالي حينَ قلّت كتائبُه",41,"ب",2,0],["كم أعاني في معاشهم","باختلاص القرض والحرفا",42,"ف",2,0],["كما عوايد مولانا وجهبذنا","شيخ الشيوخ وفخر العجم والعربِ",43,"ب",1,0],["كم أعربت عنك الأعارب مدحةً","والترك طاب له بها الأنشادُ",44,"د",1,0],["كم أَعجَم الحبَّ والأَجفانُ تُعْرِبُهُ","والسِّرُّ لولا وُشاةُ الدَّمعِ مكتومُ",45,"م",1,0],["كَم أعجز الناس الحل","كَم كذب أردى دول",46,"ل",1,0],["كم أعين لك صعدتها زفرة","عن حر قلب ذاب بالتصعيد",47,"د",1,0],["كم أعارت محاسنُ الدهرِ قوماً","ملأُوا عيبةَ الزمان عُيوبا",48,"ب",2,0],["كَم أعجزَ الشُعراءَ اللُسنَ مُنتَدَحٌ","منهُ يضيقُ على مَن خرقَهُ خَرَقا",49,"ق",2,0],["كم أعدموا من سيدٍ","فقد العلاء به هلاله",50,"ل",2,0],["كما علمت غناه عن خليقته","من اسمها عالماً أعطاه تنزيل",51,"ل",1,0],["كما علمنا بالجسوم التي","عينها الليلُ إذا أدبر",52,"ر",1,0],["كما عَبٌقَ الزهرُ غِبَّ حياءٍ","وقام بثغرٍ نقيٍّ ندي",53,"د",2,0],["كَما عَمَّ حُباً نَفعه عَمَّ رزؤه","جَميع الوَرى مِن غثِّها وَسَمينها",54,"ن",3,0],["كما علا الحاجبُ","المُنتقى على الشّعريينِ",55,"ن",1,0],["كم أعين سهرت به","ولكن قذفن به الدرر",56,"ر",1,0],["كما عمَّهُم بالفيضِ في الليلِ والضحى","على شرحِ صَدرٍ لَذَّ تِينُ المَوَاهِبِ",57,"ب",1,0],["كم أعرك عيني لا ستيقن هل","في اليقظة ما أراه أم هذا طيف",58,"ف",1,0],["كما عشت في دنياك بالبر والتقى","رحلت من الدنيا بزاد إِلى غد",59,"د",1,0],["كما عابنى العرب الأكرم","ين أباة التواني حماة النسم",60,"م",1,0],["كم أعاني من الحياة جهودا","كلّ حينٍ أحلُّ همّاً جديدا",61,"د",2,1],["كم أعقبوا لي يوم ترحالهم","وجدا بألوان الحشا موقدا",62,"د",2,0],["كما عفر المولي لوالدكم وفي","مقام علا الفردوس دام يوقر",63,"ر",1,0],["كم أعارت محاسن الدهر قوما","ملؤا عيبة الزمان عيوبا",64,"ب",2,0],["كَم أَعملوا الآراءَ فيه فَأَمعنوا","وَتَأمّلوا نَظراً إِلَيهِ فَحَدَّقوا",65,"ق",3,0],["كَم أَعجَمَ العربيْ الفَصيحُ بَلاغةً","وَأَتَت إِلَيهِ فَأَفصَحَت عَجماء",66,"ا",2,0],["كَم أَعيُنٍ أَبكيتَها بِتمنُّعٍ","كَم مُهجةٍ نارَ الجَوى أَصليتها",67,"ت",3,0],["كما علمت أوائلها بما لل","أوائل من جدودك من جدود",68,"د",1,0],["كما عيد القس في فصحه","وفي يده طاقة الياسمين",69,"ن",1,0],["كم اعتسفت بي ديمومة","إذا اصطبحت لم تجد مغتبق",70,"ق",1,0],