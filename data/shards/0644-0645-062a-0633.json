=201013",""],[5281,"واااوطناه","https://www.poetsgate.com/ViewPoem.aspx?id=199750",""],[5376,"مناجاةُ أسير","https://www.poetsgate.com/ViewPoem.aspx?id=188264",""],[5376,"يا زائرَ البيتِ لو حُمِّلت من مُقلِ","https://www.poetsgate.com/ViewPoem.aspx?id=188424",""],[5376,"يا شام بسمك في السماء شحوب","https://www.poetsgate.com/ViewPoem.aspx?id=197716",""],[5397,"عذبت لنظرة عينك الأرياف","https://www.poetsgate.com/ViewPoem.aspx?id=157965",""],[5397,"أترع لي في سفحه الأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=157902",""],[5414,"الهابطون والصاعدون","https://www.poetsgate.com/ViewPoem.aspx?id=12938",""],[5431,"من ذا يُجففُ أنهره","https://www.poetsgate.com/ViewPoem.aspx?id=199762",""],[5493,"إلى أخ الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=197467",""],[5510,"لا تلمني","https://www.poetsgate.com/ViewPoem.aspx?id=206114",""],[5518,"في مدح الرسول","https://www.poetsgate.com/ViewPoem.aspx?id=201599",""],[5542,"مالي أراك تقلبُ النظرا","https://www.poetsgate.com/ViewPoem.aspx?id=9683",""],[4444,"من تاه واحدةً فته عشرا","https://www.poetsgate.com/ViewPoem.aspx?id=85446",""],[5667,"قلها","https://www.poetsgate.com/ViewPoem.aspx?id=214941",""],[5674,"الحزن حبر دواتي","https://www.poetsgate.com/ViewPoem.aspx?id=189930",""],[5781,"جمرةٌ في زحمة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=204823",""],[5809,"المطلع","https://www.poetsgate.com/ViewPoem.aspx?id=205135",""],[5859,"عودي","https://www.poetsgate.com/ViewPoem.aspx?id=29413",""],[5956,"لله درُّك يا بنيَّ كمالُ","https://www.poetsgate.com/ViewPoem.aspx?id=194392",""],[5956,"الجنة العظمَى","https://www.poetsgate.com/ViewPoem.aspx?id=194703",""],[6089,"صاحبُها الوحيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=213749",""],[6240,"مُثْقَلَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87019&r=&rc=3",""],[402,"راع العيون جمال هذا المنظر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=53567&r=&rc=419",""],[6355,"السلم في عرفهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66678&r=&rc=138",""],[6355,"خطواتنا المنهوكة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66625&r=&rc=85",""]],"verses":[["لمْ تستَفِزّ رُسوخَها النّعْمى ولا","هلَعَتْ إذا كشَرَتْ إليْها البُوسا",0,"س",2,0],["لَم تَسُق مِثلَهُ فَراعينُ مِصرٍ","يَومَ كانوا لِأَهلِها أَربابا",1,"ب",2,0],["لَم تَسِل مِنّا عَلَيهِ دَمعَةٌ","وَهُوَ أَولى الناسِ بِالدَمعِ الصَبيبِ",2,"ب",1,0],["لم تسرِ ساريةُ الرياحِ بطيبةٍ","إلا لتحملَ ذكرَهُ المعسولا",3,"ل",2,0],["لم تسدد لها الخوالق بالأمس","ولم تقدد الفواري السيورا",4,"ر",2,0],["لم تَسْمَعا بعْدَ الصِّياح شَكِيَّتي","وسمعتُما شكْوى سِوَايَ ولم يَصِحْ",5,"ح",1,0],["لم تستمع قط ذكراه ولم تره","إلا تواضعت واستوضعت إشرافا",6,"ف",2,0],["لم تَسرَّب في خَرْقِ أُذْني وطارت","كمطير الفُساء في خيشوم",7,"م",1,0],["لَم تَسمَعِ الدُنيا بِقَومٍ قَبلَهُم","ماتوا وَما بَرِحوا الدِيارَ الفانِيَه",8,"ي",2,0],["لم تستقم للقوم خلف عمادهم","هل تستقيم وهم بغير عماد",9,"د",1,0],["لم تسل ما ليله ما ويله","وسألتُ الريح ماذا ضعضعك",10,"ك",1,0],["لَم تُسمَ يا هارونُ إِلّا بَعدَما اِق","تَرَعَت وَنازَعَتِ اِسمَكَ الأَسماءُ",11,"ا",2,0],["لَم تُسِغهُم بَرودُ جَيحانَ حَتّى","قَلَسوا في الرِماحِ ذاكَ الماءَ",12,"ا",2,0],["لَم تُسَلَّم لَهُ المَقادَةُ حَتّى","عَرَفَت فَضلَهُ عَلَيها الرِجالُ",13,"ل",1,0],["لم تَسْرِ خيلُكَ في أحشاء داجيةٍ","إلا سرى في دُجى أحشائه الرُّعُبُ",14,"ب",1,0],["لِم تسقينيَ من شهد الرضا","وتلاقيني عطوفاً وكريما",15,"م",2,0],["لَم تُسقَ بَعدَ الهَوى ماءً عَلى ظَمَإٍ","كَماءِ قافِيَةٍ يَسقيكَها فَهِمُ",16,"م",1,0],["لم تسكنِ الأعداءُ مِنْ خوفٍ بهم","حتى سكنْتَ فليتهم لا مُتِّعوا",17,"ع",3,0],["لَم تَستَبِق وَكَأَنَّها مُصطَفَّةً","دُهمٌ تُنازِعُكَ السِباقَ عِرابُ",18,"ب",1,0],["لم تستطع عِرسُهُ صَبْراً فَجاوبَها","صَوْتٌ يُجلجِلُ أودَى السَّيِّدُ اللَّقِفُ",19,"ف",1,0],["لم تَسكُنِ الدّنيا فُواقَ بَكِيّةٍ","إلاّ وأنْتَ لخوفِها تأمين",20,"ن",1,0],["لَم تُسعِداني بِهِجائِكُما","أَكُلُّ ذا بُخلاً وَإِشفاقا",21,"ق",2,0],["لَم تَسِق عَذباً وَلا أَرِجاً","بَل أَذيّاتٍ وَأَدناسا",22,"س",2,0],["لَم تَستَطيعوا أَن تَقوا مُهجاتِكُم","فَتَخَيَّروا قَبلَ النَدامَةِ وَاِنتَقوا",23,"ق",3,0],["لَمْ تَسْرِ لَيْلَى ولمْ تَطْرُقْ بِحَاجَتِهَا","مِنْ أَهْلِ رَيْمَانَ إِلاَّ حَاجَةً فِينَا",24,"ن",2,0],["لم تسيّر فوقها دبّابة","أو تباغتها بطيرٍ من حديد",25,"د",1,0],["لم تسعد الفصحى بمثل يراعه","يوما ولا لقي الخيال جناحا",26,"ح",2,0],["لَمْ تسْتِعنْ إِلاَّ بِنَفْسِكَ وَهْيَ مَا","هِيَ فِي الكِفَايَةِ لِلمَرَامِ الأَكْبَرِ",27,"ر",1,0],["لم تسالم جاهلاً في غيه","لا ولا عالمها الحر الأجل",28,"ل",1,0],["لم تسلبِ الطينَ السكونَ","ولم ترعْ نومَ الحجارة",29,"ر",2,0],["لمْ تُسِغْهُمْ بُرُدَ جيحانَ، حتى","قَلَسُوا في الرّماح ذاكَ المَاءَ",30,"ا",2,0],["لمْ تُسْمَ يا هَرُونُ إلاّ بَعدَمَا اقْ","تَرَعَتْ ونازَعتِ اسمَكَ الأسماءُ",31,"ا",2,0],["لم تستتم بملتقاكَ مسرةٌ","حتى اتخذت إلى الفراقِ سبيلا",32,"ل",2,0],["لَم تَسودي ذا الخَلقَ إِلّا بِفَضلٍ","فُقتِ فيهِ الأَشكالَ وَالأَضرابا",33,"ب",2,0],["لم تَسْتبحْ إبلاً للائذينَ بهِ","بَنو اللّقيطةِ من ذُهلِ بن شَيبانا",34,"ن",2,0],["لَم تَسمحِ القَومُ لَهُ بِشَربَةٍ","حَتّى قَضى بِغُلَّةٍ لَم تُنقَعِ",35,"ع",1,0],["لم تَسْمُ نفسٌ ثناها الذلُّ عن طَلبٍ","وهمةٌ ليس ترقَي في غدٍ فغَدِ",36,"د",1,0],["لم تسْر إلا بشذا عَرْفِها","أو لا فماذا النَّفَسُ الطيبُ",37,"ب",1,0],["لم تَستَطِعْه مَلافِظي","فشكَتْ إِلى عينيهِ عيني",38,"ن",2,0],["لَم تَستَهِلَّ عَلى الخُدودِ دُموعُهُ","إِلّا لِسَقم دبَّ تَحتَ ثِيابِهِ",39,"ب",2,0],["لَم تَسمُ معطسُ عرنين لهبّتها","هيباً وما كلُّ مَرغوبٍ بموجودِ",40,"د",1,0],["لم تستطع دفع عوادي الفناء","المارد العاتي لديها ضعيف",41,"ف",1,0],["لم تستطيع شيئاً فَدَعهُ","وجاوِزهُ إلى ما تستطيعُ",42,"ع",1,0],["لم تستَمع سِرَّهُ من كلِّ مُلتَمِسِ","حتى أصابَ لِسانَ الدمعِ بالخرَسِ",43,"س",1,1],["لم تسلخِ الأفراحُ ثوبَ حدادها","حتى رأى المسلوخُ فضلَ السالخ",44,"خ",1,0],["لم تسُدِ الناسَ بحظٍّ غالطٍ","متّفقٍ ولا بحكمٍ جائرِ",45,"ر",1,0],["لَم تَسَلْنا مَواقِفُ العِزِّ يَوما ً","أنُبالي بالمَوتِ ، أم لا نُبالي",46,"ل",2,0],["لم تسط راحتها عليك ولم تحط","من قدرك الأسمى ولو قطميرا",47,"ر",2,0],["لمْ تسْمَعَا ضرْبَ مدفعٍ وا","حدٍ بهِ تُسحقُ الجُيوبُ",48,"ب",1,0],["لم تسو فرحة مهجتي بولادة","عادت بموتك ترحة بمنابه",49,"ب",2,0],["لَم تَسلُبيني عَقلي وَجَدِّكِ عَن","ضَعفٍ وَلَكِن بِالنَفثِ في العُقَدِ",50,"د",1,0],["لم تَسْمُ همتهُ يوماً إلى شَرَفٍ","إلاّ حباه بما يَسْمو له الظفَرُ",51,"ر",1,0],["لم تسترح حتى اكتسبت سوادهم","بعد اكتسابك شيعة العقلاء",52,"ا",2,0],["لم تستبدَّ جميلةٌ بمتيَّمٍ","إلا ليحلو عيشه ويطيبا",53,"ب",2,0],["لم تسترين طلعة","فيها حلى مهتكي",54,"ك",2,0],["لم تُسلِّمْ فسلَّمتْ لحظاتٌ","مخبراتٌ عن شدة الاشتياق",55,"ق",1,0],["لم تُسَق للنوى مطاياهمُ إِلاّ","ونفسي من بينهم في السِّياق",56,"ق",1,0],["لم تسم همة من تقدمه إلى","ترميم شيء بل أبيد وبادوا",57,"د",3,0],["لَم تسعَ سعياً قطّ طول حياتها","إلّا لكدش طعامِها وَشرابِها",58,"ب",3,0],["لَم تَستَحِل دَمي وَتَعلَم أَنَّهُ","مَن يُستَحَلُّ دَمُ اِمرىءٍ في النار",59,"ر",1,0],["لم تستمل طرفي رعابيب الحمى","كلا ولا أبصر سواك فأعشقِ",60,"ق",1,0],["لم تسكن غليلها عبرات","يحفز الثقل دمعها فيك حفزا",61,"ز",2,0],["لَم تَستَمِح أَيدي الرِجا","لِ بِمَدحِها وَهِجائِها",62,"ا",3,0],["لم تسُمْني إلاّ جفاها كأنّي","لم أصانع إلاّ أسام جفاها",63,"ا",3,0],["لم تستطع مع ما أحكَمتَهُ حَركا","لَمّا نصَبتَ على أَقطارِها الشَّرَكا",64,"ك",2,0],["لَم تَسمَع الآذان قَبل هِدائها","بِحَمامة زُفت إِلى فَتخاء",65,"ا",2,0],["لم تسل عبد القادر البطل الذي","لاقى النوائب باسلاً وحكيما",66,"م",2,0],["لم تُسْبِكَ الحَدقُ المراضُ ولا رأت","عيناكَ أجيادَ الظِباء الغيد",67,"د",1,0],["لَم تسيء فعلاً بِهم لَكنهم","مُذ تَرجحت عَلَيهم كَرهوكا",68,"ك",2,0],["لَم تَسر لِلرَكب في البَيداء راحِلَة","إِلا وَأَنتَ بِذاكَ السَير مَقصود",69,"د",1,0],["لَم تَسرِ لَيلَتها حَبيبَةُ إِذ سَرَت","إِلا لتَشغَفَنا بطَيفِ خَيالِ",70,"ل",1,0],["لَم تَستَبح صَبري قَوارعه","يَوماً وَلم يُنقِصنَ مِن زَهوي",71,"و",2,0],["لم تستشر سفراءُ العلم فيّ ولم","تدعَ الفنونُ إلى أعمالِ مؤتمرِ",72,"ر",1,0],["لم تستعن بالمخلصين وإنما","عاديت يا يحيى بني التهذيب",73,"ب",1,0],["لم تستقل بحسنها حتى غدت","مثلا لدى العشاق من أمثالها",74,"ل",3,0],["لم تسع في اذهاب ذى الأدوا ولم","تعبأ بها فبقيت في أدواكا",75,"ك",2,0],["لَم تَستَبِق سُلوَةٌ وَشَوقٌ","إِلا وَطِرفُ السُّلُوِّ كابِ",76,"ب",1,0],["لم تسلبيه ولكن","سلبت منه الشعيره",77,"ر",2,0],["لم تستطع ان تواريها وقد منعت","من الوداع غداة الظعن قد درجا",78,"ج",2,0],["لم تستهل هلال شهر صيامها","إلا وأورثها الشجي استهلالها",79,"ل",3,0],["لم تسفر الايام في وجه الفتى","إن لم تغير وجهه الأسفار",80,"ر",1,0],["لم تسمعي إلا فنى يروي به","عن بعض أقوام غزوا أو غاروا",80,"ر",3,0],["لم تسمح الأَزمانُ قِدماً قبلَهُ","بظهورِ حُسنِ الحُور في الولدان",81,"ن",1,0],["لم تستقر على دعامك آخراً","إلا لأنك بانتصارك جازم",82,"م",1,0],["لم تسمحين لهم بهجرك والغنى","فوق السهول وتحتهن ركام",83,"م",1,0],["لم تسؤنا قط سيئة","منه إلا انه قصرا",84,"ر",2,0],["لم تسم يا علم الفضائل برهة","حتى تبطنت الحضيض الأوهدا",85,"د",2,0],["لم تسمع الأيام بابن تجيبه","بعد الخليل ولا يفي بالموعد",86,"د",1,0],["لم تسمك الخطوب خسفاً ولكن","غمزت من قناك عوداً صليبا",87,"ب",2,0],["لم تسع في ضرر امرئٍ لكنما","سعواك في إصلاح ذات البين",88,"ن",1,0],["لم تَسْرِ فيه نجومُه لكنها","وقفَت لتسمع ما أحدِّث عنكم",89,"م",1,0],["لم تستطع أنثى بتقصيرها","بأن تجارى ذكرا ماهرا",90,"ر",2,0],["لم تسندَ كفاكَ من بذلِ النَوالِ كما","لم يندَ سيفُك مُذ قلدته بدَمِ",91,"م",1,0],["لم تستطع عد الأساري دهشة","من كثرة الجرحاء والقتلاء",92,"ا",2,0],["لم تسط كف البغي بين جماعةٍ","غلا بسيف الحق عادت تبتر",93,"ر",1,0],["لم تسألي عن حالتي وكآبتي","وتركتني رهن الشقاء مصابا",94,"ب",2,0],["لم تستجب للنور مقلته","إلا إذا في قبره نزلا",95,"ل",2,0],["لم تستطع رغم الذي ملكت","من قدرةٍ أن تبلغَ القِمَما",96,"م",2,0],["لَم تستغثْ مِما استغاثتْ منه مَن","وصى الإله بِها بذكر محكم",97,"م",1,0],["لم تسترِ السحبُ نورَ الشمس ما طلعتْ","كل الضيا تحتها في الأرضِ مُحتَقر",98,"ر",1,0],["لم تستنر يوماً بنور هداية","عنها لها للداجيات ميول",99,"ل",1,0],["لم تسلمِ الأوطانُ من فتنةٍ","قد أشعلتها كفُّ قومٍ لئام",100,"م",1,0],["لم تستطتع يوما تواجهُ ظلَّهُ","فعملتَ أن تغتالَهُ بتخدّعِ",101,"ع",1,0],["لم تسفر الشمس حتى عجلت فطوت","عجلان فهو صريعٌ منك ملحود",102,"د",1,0],["لمْ تسقط النزواتُ فينا","فوق الغواياتِ اعتلينا",103,"ن",2,0],["لمْ تَسْجَعِ الورقاءُ من ألم النوى","لوكانَ يُنقَعُ بال