diwan/poem/118344","الوافر"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110272","الخفيف"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47165","الطويل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122495","البسيط"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125952","الرمل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76441","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119597","الوافر"],[4399,"","https://poetry.dctabudhabi.ae/diwan/poem/130867","الطويل"],[4444,"","https://poetry.dctabudhabi.ae/diwan/poem/34746","المتقارب"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35414","الطويل"],[4802,"أبعاد","https://www.poetsgate.com/ViewPoem.aspx?id=32337",""],[5525,"لا من غديتي شمس","https://www.poetsgate.com/ViewPoem.aspx?id=7187",""],[5756,"قصة حياة","https://www.poetsgate.com/ViewPoem.aspx?id=5435",""],[487,"كتبت إلى قلبي بسطر من الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=129620",""],[5956,"يا أيها البحر الذي بي استمسكا","https://www.poetsgate.com/ViewPoem.aspx?id=183258",""],[6097,"ألا يا خاطب الحسنا","https://www.poetsgate.com/ViewPoem.aspx?id=186339",""]],"verses":[["تُلَطِّمُها الأَيدي القِصارُ عَنِ الرُقى","وَخَيرٌ مِنَ الرَيِّ الذَليلِ صَداها",0,"ا",3,0],["تُلطِّفُ أجْساماً كثافاً بلذعها","فتصعدُ أرواحاً لطافاً مُعَطَّرَه",1,"ر",2,0],["تَلَطَّفتُما لِلدَهرِ حَتّى أَجابَني","وَقَد أَزمَنتَ رِجلي هَناتُ زَمانِهِ",2,"ن",2,0],["تَلطم الصَخر كَبرياءً وَعنفاً","ثُم تَرتَد للخضم خذالى",3,"ل",2,0],["تلطّفُ أجساماً كثافاً بلدغها","فتصعدُ أرواحاً لطافاً مُعَطَّرَة ْ",4,"ر",2,0],["تلطف بحالي ان قلبي موله","به النار من كل الجوانب تسعر",5,"ر",1,0],["تلطَّف الحسَّادُ في سِحرهم","حتى رأوا بالنأى إقلاقي",6,"ق",2,0],["تلطم الصدر تارة وتشق","الجيب أخرى حتى إذا أعياها",7,"ا",3,0],["تلطفتَ في أمري فإن أك ساعياً","إلى غايةٍ فاللطف يُدرَك باللطفِ",8,"ف",1,0],["تلطف بي إلى أن حاز قلبي","ولما صار طوع يديه خانه",9,"ه",1,1],["تلطف بخفض الصوت في القول دائما","وترتيله خوفا به سبق خزان",10,"ن",1,0],["تَلُطُّ بِهِ الحاذَينَ طَوراً وَتارَةً","لَهُ خَلفَ أَثوابِ الرَديفِ بُروقُ",11,"ق",1,0],["تلطَّفتُه حتى وجدتُ مَفارجاً","لصدرِيَ من غُمّاته ومَسارحا",12,"ح",2,0],["تلطق الحجب من حيث الركون إلى ال","أسباب يجتثه هول ورجات",13,"ت",1,0],["تلطف على من أتلفته صبابة","وصار رقيقا دون آلاف حجتي",14,"ت",2,0],["تلطف في استعطافهم دون هديهم","بناهٍ من الوعظ البليغ وآمر",15,"ر",1,0],["تلطفت يوماً بهم فاعتدوا","على الجار والأهل والنازل",16,"ل",1,0],["تلطف وما بك من فاقة","لأن تشتري اللطف أو تسعيرا",17,"ر",2,0],["تلطف حتى حكم النوم اذ","سرى بين جفني وإنسان عيني",18,"ي",1,0],["تَلَطَّفْتَ في جَذْبِ قلبي إِليكَ","إِلى أَنْ ضَمَمْتَ عليهِ اليَدَيْنِ",19,"ن",1,1],["تلطف علم الذايقن بسرها","قفوا ان هذا موطن الانس والامن",20,"ن",1,0],["تلطفت المشارب فاتخذنا","فكان حسابه معنى حسابي",21,"ب",2,0],["تلطف في رفع الغطاء عن القدر","غلام يجيد الطبخ يزهو على البدر",22,"ر",1,1],["تلطم الجِيدَ تارةً وتدق ال","صدرَ طوراً كأنها الخَنساء",23,"ا",2,0],["تَلَطّفْتَ فِي تَشرِيفِ قَدري بِوَضعِهِ","مُغَالَطَةً مِنْ حَيثُ لَمْ يَشعُرِ الغُمر",24,"ر",1,0],["تلطمها العلوج على خدود","كسا الوانها الفزع اصفرارا",25,"ر",2,0],["تلطم الخد تلدم الصدر والمح","بوبُ عنها محجبٌ يتلاها",26,"ا",3,0],["تَلَطَّفَ في إخفائها مُتَسَتِّراً","ومن كَمُلَتْ فيه الولايةُ يَكتُمُ",27,"م",1,0],["تلطَّفِي وانظُرِي المحزونَ مِن كَثَبٍ","حِيناً وخلِّ الأَمانِي تسكُبُ الدِّيَما",28,"م",2,0],["تلطم الوجه بكف أسود","وتناجى جثة المحترم",29,"م",1,0],["تلطخ منها الوجه وَالقطر تحتها","وَفيه الثَرى من تحتها يتحلل",30,"ل",1,0],["تلطم ذياك المحيا الجميل","وصدرها البض وجيداً أميل",31,"ل",1,0],["تلطف لا تطأ فيه قلوباً","فبين نويه كم من فؤادِ",32,"د",1,0],["تلطف بنا واتبع لقول نبينا","لعلك تنجو من عناد ومن وزر",33,"ر",1,0],["تَلَطَّف لِما قَد تَكَلَّمتَ فيهِ","فَما زِلتَ في الحاجِ شَهماً نَجيبا",34,"ب",2,0],["تَلَطَّف مِنها إِذ سَرى مِنهُ نورُها","فَتَحسَبُها شَمساً عَلى البَدرِ دَرَّتِ",35,"ت",1,0],["تلطخت في دم شعره يدينه","وصار الزمن شاهد وقاضي وجلاّد",36,"د",1,0],["تلطفي وان كحل التيه نجلك","وتواضعي لوبك غدى الحسن مغرور",37,"ر",1,0],["تلطمه مو جات القدر فوق خده","وتخطي به الخطوة من بلاد لبلاد",38,"د",1,0],["تلطف كماء الماء من شدة الهوى","وطف بمنار الفكر كيما ترى رشدي",39,"د",2,0],["تلطيخُ رسامٍ على لوحاتهِ‎","‏في رأي فني - منك أجملَ مَسْلكا‎",40,"ك",2,0],["تلطّفْ قبْلَ أن تشقى","وَسَائلْ عن عقيدتِها",41,"ت",3,0]]}