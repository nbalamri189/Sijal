",4,"ك",2,0],["وامدح فتى حظُّه من وفر ثَروته","كحظ ناظِرِه من وجهِهِ الحسنِ",5,"ن",1,0],["وأمُدُّ كفي نحو كلِّ رغيبة","فتنيلها حتى حسبتُك خازنا",6,"ن",2,0],["وَأَمَّ دَومَةَ في جَمعٍ وَعادَ إِلى","مَكانِهِ وَسَماءُ النَّقعِ لَم تَغِمِ",7,"م",1,0],["وَاِمدُد إِلَيهِ بِكَفِّ جَدٍّ قائِمٍ","تَجذِب بِهِ مِن ضَبعٍ جَدٍّ جالِسِ",8,"س",1,0],["وأمدًّ بالنفحات رو","حك حين طوَّف بالجنان",9,"ن",1,0],["وأمِدّني بتَعلّةٍ مِنْ رِيقِهِ","حتى أُقَبّلَ منه ثَغْراً أشْنَبا",10,"ب",2,0],["وَأُمُّ دَفرٍ لَعَمري شَرُّ والِدَةٍ","وَبِنتُها أُمَّ لَيلى شَرُّ مَولودَه",11,"د",2,0],["وَأُمُّ دَفرٍ إِذا طَلَّقتَها بَذَلَت","رِفداً وَكانَت كَعِرسٍ حينَ تَختَلِعُ",12,"ع",1,0],["وَأُمُّ دَفرٍ فَروكٌ وافَقَت صَلَفاً","مِنّي وَكانَ جَزاءَ الفارِكِ الصَلَفُ",13,"ف",1,0],["وَأُمُّ دَفرٍ فَتاةُ سوءٍ","تَخبُؤُني في ثَرىً مُهالِ",14,"ل",1,0],["وأمد ناموس الشرائع بالتي","يرضي الاله من الجهاد قيامها",15,"م",3,0],["وأمدّ أسئلة ، يمنّي بعضها","بعضا ، ويضحك بعضها استهزاء",16,"ا",2,0],["وأُمِدَّ للمستهترين عنانُهم","في المُخزِيات فأرْتَعوا وأساموا",17,"م",3,0],["وأمدّني بتعلّة ٍ منْ ريقهِ","وما رَاعَني إلاّ ابنُ وَرقاءَ هاتِفٌ",18,"ف",1,0],["وأمد للدنيا يداً مبتورةً","وأزل حيث ثبت عثر مصفد",19,"د",1,0],["وامدحهُ لا مدّعٍ وصفاً يناسبُهُ","من ادّعى فوقَ ما في وسعه افتُضِحا",20,"ح",2,0],["وَأَمَدَّهُ مِن عِندِهِ بِمَعونَةٍ","حَتّى أَنافَ بِها عَنِ الأَعيانِ",21,"ن",1,0],["وَأَمَدَّهُ بِخَزائِنٍ لَو صَبَّحَت","ذاتَ العِمادِ لَآذَنَت بِتَدَعثُرِ",22,"ر",1,0],["وَإِمدادُ كلِّ الخلقِ مِن سيّد الوَرى","فَلَولاهُ لَم نحسِن بهِ النظمَ وَالنثرا",23,"ر",2,0],["وَامدُد فُؤادِي بِجُنودِ الهُوى","أَيَّدَكَ اللَهُ وَأَعلى يَدَك",24,"ك",1,0],["وامدد جفونيَ قرطاساً فإن ألِمَت","ممّا تخطُّ فزد في ذلك الألَمِ",25,"م",1,0],["وامدح رئيسَ بلاغةٍ وكتابةٍ","زانَ الولاةَ وشرَّف الكُتّابا",26,"ب",2,0],["وامدد يمينا طالما","لي قابلت باليسر",27,"ر",1,0],["وامدد يدا نحو الوفا طالما","تعودت بالبسط والبذل",28,"ل",1,0],["وأَمدّها بمعارف وعوارِفٍ","وَلطائِفٍ جَلَّت عن التَعديد",29,"د",1,0],["وأمد كفا بالندى وأتمهم","حلما وأصدق في المقل وأسرع",30,"ع",1,0],["وَاِمدُد إِلَيَّ عَلى تَطاوُلِ غُلَّتي","كَفَّ العَطاءِ بِشُربِهِ يُروى الظَما",31,"م",2,0],["وَاِمدَح إِماماً دَأبُهُ","مُذ كانَ إِسداءُ العَوارِف",32,"ف",1,0],["وَامْدُدْ مَدَى شَيْخِنَا هَذَا الْهُمَامِ الذِي","أَمْسَى شَمَائِلَ خَيْرِ الرُّسْلِ يُقْرِينَا",33,"ن",2,0],["وأمدها صوناً فلاح سناؤها","والحسن لايخفى عليك سناؤه",34,"ا",3,0],["وامدُدنَ أيديكنَّ للبحرِ الذي","ذبنا عليه تَنَدُّماً وحَنينا",35,"ن",2,0],["وامدني بنداك وامسح بالغنى","فَقري وارغم انف من يشناني",36,"ن",2,0],["وأمَدُّ الناسِ في البَأسِ مَدىً","وَالرّدى عَن نابِهِ قدْ كَشَرا",37,"ر",2,0],["وأَمدَّ اللهُ قواماً بذلوا","دونَها الأَرواحَ بالروحِ الأمين",38,"ن",1,0],["وَاِمدُده بِالنصرِ العزيزِ وحفّه","بِرعايةٍ وعنايةٍ وعوانِ",39,"ن",1,0],["وَاِمدَح يَزيدَ وَلا تَظهَر بِمَدحَتِهِ","وَقُد أُوائِلَها قَوداً بِتَشبيبِ",40,"ب",1,0],["وَاِمدد الإِسلام بِالنَصر وَبِال","عزّ وَالتَوفيق يا رَبَّ البَريّه",41,"ي",2,0],["وإِمداد مِن المنّان جودا","مَواهبه بِهِ القَدر اِستماحا",42,"ح",2,0],["وأَمِدَّني إمدادَك المَعهودَ لي","تَجعلْ على استنجازِها تَشْجيعي",43,"ع",2,0],["وامدح عروساً زانها","حسنُ البكارة في العرائس",44,"س",1,0],["وأمدد إلينا به جسر اليقين على","أرض العقيدة وأجعل منه تذكارا",45,"ر",2,0],["وامدَحْهُ لا متحرِّجاً في مدحه","إذ لا مبالغةٌ ولا إغراقُ",46,"ق",1,0],["وأمِدُّوا بدعوة تذهب الْبَيْنَ","سريعاً وتأتنا بالتلاق",47,"ق",1,0],["وَأَمدَح قَوماً لَيسَ يَدرونَ أَنَّني","مُقاوِد قَد قَلَّدتَهُم أَو قَلائَدا",48,"د",2,0],["وأمَدَّها من سيرةٍ نبويَّةٍ","في حكمةٍ بالأَمنِ والإِيمانِ",49,"ن",1,0],["وأمدَّتْني يداه بالنَّدى","وكذاك البحر يوم الجزر والمدّ",50,"د",1,0],["وامدحِ الحافظَ المُمَدَّحَ تلْبَسْ","حُلَلَ النُسْكِ عندَهُ والعَفافِ",51,"ف",1,0],["وامدُدْ عَلَى الآفاقِ كَفَّاً لَمْ تَزَلْ","تُفْني بوادِرُها العِدى والُّلوما",52,"م",2,0],["وأمدحها التهجير حتى رأيتها","كأنساعها صارت ظهوراً وأبطنا",53,"ن",2,0],["وأمدك الله المعونة في","عزميك من سيرٍ ومن حِلِّ",54,"ل",1,0],["وامدد يمينك لي أقبِّلْ ظهرَها","فلعلّها تُعدينيَ الإقبالا",55,"ل",2,0],["وامدد إليّ يداً لو انك في السها","وعلى الثرى أهلي لنالت موضعي",56,"ع",2,0],["وأمدحُ قوماً ولكنني","إليك بما قلتُ فيهم أُشيرُ",57,"ر",1,0],["وأمدحُ مَن أعطاكُمُ مِن لسانِهِ","وأرضاكُمُ مَن قلبُه بِكُمُ صبُّ",58,"ب",1,0],["وامدُدْ على الدنيا وجَهْلاتِها","ظِلالَ حلمٍ لك لم يَعزُبِ",59,"ب",1,0],["وامدد له كف الرجا عطفا على","إخلاصه واسعفه باستنهاض",60,"ض",1,0],["وامدد إلى الضعفا سواعد رحمة","ما دعها الفظ الغليظ القاسي",61,"س",2,0],["وامدح من قريضي الشعر عوداً","جنيت له الحوافر بالخفاف",62,"ف",1,0],["وامْدُدْ يديك بإحسانٍ لِمنْ نُكبوا","وادْعُ بخيرٍ لمنْ نجَوا ومن فُقِدوا",63,"د",3,0],["وامدد يديك أبا الشجاع مثوبة","وعقوبة بالسيف والدينار",64,"ر",1,0],["وأمدها حسن اقتراحك بالذي","لم تقترحه خواطر الأفكار",64,"ر",1,0],["وأَمَدَّهُ بِلُيونَةٍ في طَبعهِ","وصرامَةٍ في النقضِ والإبرامِ",65,"م",1,0],["وَأَمَدُّها عِندَ العُلى","كَفّاً بِحَبلِ رِشائِها",66,"ا",3,0],["وامدد يديك إليه فالرحمن كم","كافا الذي لأخيه كان مغيثا",67,"ث",2,0],["وأمدح أخا لب وفهم لا الذي","في المال بذّ أعاجما وأعاربا",68,"ب",2,0],["وأمدّ فيه العمرَ حي","ث له جميل الذِكر يُتلى",69,"ل",2,0],["وأمد كف الاكتفاء بأنني","عبد بغير الفقر لا أتعبد",70,"د",1,0],["وَأَمدّك الملك السَعيد محمدٌ","بِجَزيل إِحسان عَلى إِحسان",71,"ن",1,0],["وَأَمدّها بعساكر موصوفة","بَثباتها في حومة الميدان",72,"ن",1,0],["وَأَمدّني مِن حَزمه بِحَماسة","أَصمَت بِها خَلَدَ العدا فرسانيه",73,"ن",3,0],["وامدد يمينك كي نفوز بلثمها","فلطالما امتدت الى علياها",74,"ه",2,0],["وأمددتمانا بالرجاء وشدتما","معاقل للأوطان طاولت السما",75,"م",2,0],["وأمد ركبك في الرحيل مباركاً","قدرٌ لأمرك مثل شعبك طيِّع",76,"ع",1,0],["وأمدّ الوجود من شاطئيه","بِجَنَى غرسه وفائض مائه",77,"ا",3,0],["وَاِمدَحْ فَصاحتَه وَاِحمَد بَراعتَهُ","وَاِشكُر بَلاغتَه في الدَّهرِ وَاِحتفِلِ",78,"ل",1,0],["وَاِمدُد يَمينَك لِلوجود فَكُلّهُم","اليَوم عادَ مُؤمّلاً مُتَشَوّفا",79,"ف",2,0],["وامدحْ فتىً خضَعَتْ له أسدُ الشرى","رَهَباً ودَان له الزمان العاتي",80,"ت",2,0],["وامدَحْ إماماً كريماً عادلاً حكماً","مدْحاً بأبياتِ شعْرٍ غيرِ مَسْروقِ",81,"ق",1,0],["وامدُدْ لَنَا كفّاً تُصَافِحنَا ، ونَأ","سَفُ كفُنَا لا تلمَسُ الأ