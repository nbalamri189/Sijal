{"poems":[[65,"قفا بنجد نسلم","https://www.aldiwan.net/poem45684.html","المجتث"],[74,"صيرت إيري واقفا شرطه","https://www.aldiwan.net/poem19335.html","الكامل"],[99,"قلت للبحرِ إذ وقفت مساء","https://www.aldiwan.net/poem24399.html","الخفيف"],[48,"للرزق أسباب تسبب","https://www.aldiwan.net/poem22368.html","مجزوء الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[147,"هو ذاك ربع المالكية فاربع","https://www.aldiwan.net/poem11770.html","الكامل"],[147,"النجم أقرب من مداك منالا","https://www.aldiwan.net/poem11792.html","الكامل"],[147,"لا تخش عدوى من أبحت ذماره","https://www.aldiwan.net/poem11831.html","الطويل"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[422,"بلغ الشوق لعمري ما أراد","https://www.aldiwan.net/poem53890.html","الرمل"],[520,"خفة الروح واجتناب الثقاله","https://www.aldiwan.net/poem12198.html","الخفيف"],[556,"هل أنت لصب القلب معمود","https://www.aldiwan.net/poem47841.html","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48678","الكامل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35828","الكامل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108450","الرمل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108455","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53228","البسيط"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141214","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200390","الرمل"],[4767,"معين الحب","https://www.poetsgate.com/ViewPoem.aspx?id=183703",""],[5246,"إذا لم يساعدني لإسعاف صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=187057",""],[6296,"مد جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75694&r=&rc=25",""],[147,"لاَ زِلْتَ تَعْلُو وَإِنْ حُسَّادُكَ اكْتَأَبُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27443&r=&rc=10",""]],"verses":[["فَلي دموعٌ تروَّي","بها الطُّلولُ الصَّوادي",0,"د",2,0],["فليدر حسنك أن قلبي فيه قد","ثبتت صبابته بشرط الواقف",1,"ف",1,0],["فليدعني القضاءُ أبكي لأشفى","لم تَدَع ذلةُ الهوى كبرياءَ",2,"ا",2,0],["فَليُدرِكَنَّكَ مَرَّةً","ما أَدرَكَ الخَرِقُ المُرَبَّب",3,"ب",1,0],["فَلْيَدرْ فِي مَدَارِهِ الفِكْرُ حَيْرَا","نَ وَيجْمدْ بِالنَّاظِرينَ الذُّهولُ",4,"ل",1,0],["فَليَدرِ قَومي أَنَّني في ذا الحِمى","أَلقى الخُطوبَ بِمارِنٍ لَم يُجدَعِ",5,"ع",1,0],["فَليَدنُوا يَجِدا المَقيلَ مُوَسَّعاً","بِجَميلِ رَأيِكَ وَالعِثارَ مُقالا",6,"ل",2,0],["فَليَدرِ أَملاكُ الطَوائِفِ أَنَّهُ","فَلَكٌ تَضَمَّنَ سَلبَها دَوَرانُهُ",7,"ن",2,0],["فَليدّكر إِذ كانَ طفلاً ناشئاً","وَالعقلُ في مهدِ المزاجِ مضجّعُ",8,"ع",1,0],["فَليدعُ ناديهُ فتىً في بَطنها","دُعيت زبانيةٌ إليه ومقمعُ",8,"ع",1,0],["فليَدَعْهُ في الهوى عاذِلُه","يَحْسَبُ الغيَّ وإنْ ضَلَّ رشادا",9,"د",2,0],["فليدعني من التمعقل تيس","ليس يدري من أين تأتي الغزالة",10,"ل",2,0],["فلِي دموعٌ تُبارِي القَطر واكِفةٌ","جادتْ وإن لم أقلْ يا أَدمعِي جودِي",11,"د",2,0],["فليدفعوا ثمن الدماء ويبعثوا","شهداء ذاك الفتح والغزوات",12,"ت",1,0],["فَليُدرِكَنَّكَ أَو تَحلّ بِبَلدَةٍ","لا يَهتَدي فيها إِلَيكَ نَهارُ",13,"ر",1,0],["فليدم للناس غوثاً ما بدا","نور شس البر في جنح الظلام",14,"م",1,0],["فليدم سلطاننا منتصراً","ما تجلت نجمة وسط الهلال",15,"ل",1,0],["فليدع مثلك للجلى إذا عظمت","كيما تسهل من مستصعب المدن",16,"ن",1,0],["فليدع العلم واصحابه","وليجعل الجهل له غاشية",17,"ي",2,0],["فليدم جيبي فقيرا إنما","فقر جيبي ثروة للأدب",18,"ب",1,0],["فلْيدُم لي معينك العذب ما لي","عنك يا من سكنت قلبي بديل",19,"ل",1,0],["فلي دونه من تستجيب لإمرتي","مجندة ما انفك عن وصفها الصبر",20,"ر",1,0],["فليدعيه ذوو اللاشئ من طلبوا","فيه الوجهات والتصفيق والنظرا",21,"ر",2,0],["فليدرِ منْ ظلَّ مشغوفاً بها علقاً","أنَّ النباهة َ علقٌ ليسَ يغتصبُ",22,"ب",1,0]]}