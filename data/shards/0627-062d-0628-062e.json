{"poems":[[55,"لغام المطايا من رضابك أعذب","https://www.aldiwan.net/poem30757.html","الطويل"],[87,"سلام الله لا أرضى سلامي","https://www.aldiwan.net/poem7793.html","الوافر"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56683","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60971","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201084","المنسرح"]],"verses":[["أَحَبُّ خَليلَيَّ الصَفيَّينِ صارِمٌ","وَأَطيَبُ دارَيَّ الخِباءُ المُطَنَّبُ",0,"ب",1,0],["أحب خليفة الرحمن جهدي","وحب الله في حب الإمام",1,"م",1,0],["أحب خلقه إليه في دعة","بسرعة ليأكل الطير معه",2,"ه",1,0],["أحب خفيف الدل إن لم يكن جفا","فكل دلال لا يذيب خفيف",3,"ف",1,0],["أُحبُّ خيامَ النازلين على الغضا","وإنْ أهْلُها حلوا فؤاداً ومنزِلاَ",4,"ل",2,0],["أحب خرق الوقار آونةً","كيلا أراني أعيشُ كالصنم",5,"م",1,0]]}