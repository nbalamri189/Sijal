{"poems":[[53,"أكذا المنون تقنطر الأبطالا","https://www.aldiwan.net/poem29888.html","الكامل"],[53,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[53,"لك السوابق والأوضاح والغرر","https://www.aldiwan.net/poem30458.html","البسيط"],[53,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[53,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[86,"حبس اللسان وأطلق الدمعا","https://www.aldiwan.net/poem10350.html","الكامل"],[86,"كم حددوا يوم الجلاء الذي","https://www.aldiwan.net/poem10514.html","السريع"],[71,"لا غرو أن أصبح المؤيد","https://www.aldiwan.net/poem3768.html","المنسرح"],[71,"ماذا على طيف الأحبة لو سرى","https://www.aldiwan.net/poem4031.html","الكامل"],[93,"أشفت غليل فؤادك الظمآن","https://www.aldiwan.net/poem11277.html","الكامل"],[93,"يا ترب عصرك بيتي","https://www.aldiwan.net/poem11464.html","المجتث"],[83,"يا من يحن إلى نجد وناديها","https://www.aldiwan.net/poem54234.html","البسيط"],[83,"مولاي يوم الجمعه","https://www.aldiwan.net/poem54276.html","مجزوء الرجز"],[83,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[47,"لولا العجوز بمنبج ما خفت","https://www.aldiwan.net/poem24810.html","مجزوء الكامل"],[72,"لحظك في الفتك هو البادي","https://www.aldiwan.net/poem18557.html","السريع"],[51,"أقول إذ قابلني وجهه","https://www.aldiwan.net/poem63994.html","السريع"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[51,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[51,"نادمت بدر السماء في فلكه","https://www.aldiwan.net/poem65770.html","المنسرح"],[51,"يا أبا أيوب هذي كنية","https://www.aldiwan.net/poem65867.html","الرمل"],[51,"لو يعلم ابن أبي سميه","https://www.aldiwan.net/poem66739.html","مجزوء الكامل"],[91,"هيهات بعدك ما يفيد تصبر","https://www.aldiwan.net/poem8822.html","عموديه"],[91,"لا تسل أين الهوى والكوثر","https://www.aldiwan.net/poem8828.html","عموديه"],[91,"يا نفس قد ذهب الرفيق الألمعي","https://www.aldiwan.net/poem8979.html","عموديه"],[91,"أعد حديثك عندي أيها الرجل","https://www.aldiwan.net/poem9053.html","عموديه"],[91,"يا جنة قبلما حلت بها قدمي","https://www.aldiwan.net/poem62814.html","عموديه"],[92,"شعري نفاثة صدري","https://www.aldiwan.net/poem38939.html","المجتث"],[92,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[89,"ما انت يا احمد في دولة الادب","https://www.aldiwan.net/poem44620.html","البسيط"],[89,"البحر يغلى كان البحر بركان","https://www.aldiwan.net/poem44779.html","البسيط"],[85,"اليوم ينتحر المقطم","https://www.aldiwan.net/poem7276.html","مجزوء الكامل"],[43,"لا افتخار إلا لمن لا يضام","https://www.aldiwan.net/poem10542.html","الخفيف"],[45,"كم بالكثيب من اعتراض كثيب","https://www.aldiwan.net/poem11038.html","الكامل"],[45,"مرنت مسامعه على التفنيد","https://www.aldiwan.net/poem63544.html","الكامل"],[45,"أناشد الغيث كي تهمي غواديه","https://www.aldiwan.net/poem66852.html","البسيط"],[28,"ستعلم يا عمرو بن عفرا من الذي","https://www.aldiwan.net/poem1263.html",""],[28,"ما أصبحت أرض العراق بها","https://www.aldiwan.net/poem5128.html","الكامل"],[61,"إني بحق البصاق معترف","https://www.aldiwan.net/poem51351.html","المنسرح"],[61,"أعن الأهلة في الدياجر","https://www.aldiwan.net/poem51676.html","مجزوء الكامل"],[61,"عوجا على ذاك الكثيب من كثب","https://www.aldiwan.net/poem51787.html","الرجز"],[61,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[97,"ها أنا عدت إلى حيث التقينا","https://www.aldiwan.net/poem24925.html","الرمل"],[44,"أعلي يقدم عتبة المستحلق","https://www.aldiwan.net/poem30019.html","الكامل"],[44,"عبدك يدعو باسطا خمسه","https://www.aldiwan.net/poem30231.html","السريع"],[44,"أي ندى بين الثرى والجبوب","https://www.aldiwan.net/poem30321.html","الرجز"],[44,"أراك أكبرت إدماني على الدمن","https://www.aldiwan.net/poem30331.html","البسيط"],[44,"أرض مصردة وأخرى تثجم منها","https://www.aldiwan.net/poem30363.html","الكامل"],[87,"أيها المغرور مهلا","https://www.aldiwan.net/poem8341.html","مجزوء الرمل"],[69,"يا رب بالهادي النبي المجتبى","https://www.aldiwan.net/poem28577.html","الرجز"],[69,"ما صحبة السجان محمودة","https://www.aldiwan.net/poem28755.html","السريع"],[69,"ما للزمان عن المروءة عار","https://www.aldiwan.net/poem28776.html","الكامل"],[69,"أشكو إلى الله زماني الذي","https://www.aldiwan.net/poem28836.html","السريع"],[69,"كم حاسد لم يستبح حرمة","https://www.aldiwan.net/poem28910.html","السريع"],[69,"اسأل الفوعة الشديدة حزنا","https://www.aldiwan.net/poem28977.html","الخفيف"],[69,"كم حائط فوق الكواعب طائح","https://www.aldiwan.net/poem29205.html","الكامل"],[69,"يا عدتي يا عمدتي","https://www.aldiwan.net/poem29259.html","مجزوء الرجز"],[102,"سل جنة الشعر ما ألوى بدوحتها","https://www.aldiwan.net/poem32925.html","البسيط"],[52,"كم حاسد حنق علي بلا","https://www.aldiwan.net/poem26800.html","الكامل"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[50,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[46,"يلقاك بالماء النمير الفتى","https://www.aldiwan.net/poem22497.html","السريع"],[46,"لو صح ماقال رسطاليس من قدم","https://www.aldiwan.net/poem23069.html","البسيط"],[46,"ما وقع التقصير في لفظنا","https://www.aldiwan.net/poem23491.html","السريع"],[46,"طال الزمان علي وهو معللي","https://www.aldiwan.net/poem23532.html","الكامل"],[46,"كم حاول الرجل الدنيا بقوته","https://www.aldiwan.net/poem23576.html","البسيط"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140892",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39683","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20251","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202536","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30438","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55063","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54620","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55049","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54781","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54854","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43891","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54299","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54223","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[106,"عودة إلى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=179678",""],[106,"تحية مولود","https://www.poetsgate.com/ViewPoem.aspx?id=179510",""],[90,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[91,"فتح اورشليم","https://www.poetsgate.com/ViewPoem.aspx?id=53229",""]],"verses":[["كَم حَجَّةٍ في الدينِ خُضتَ غِمارَها","هَدرَ الفَنيقِ تَخَمَّطاً وَصِيالا",0,"ل",2,0],["كَم حَشَوتُ الثَرى حُساماً طَريراً","وَطَويلاً لَدناً وَطِرفاً أَغَرّا",1,"ر",2,0],["كَم حاجَةٍ بِمَكانِ النَجمِ قَرَّبَها","طولُ التَعَرُّضِ وَالرَوحاتِ وَالبُكَرُ",2,"ر",1,0],["كَم حاطِبٍ خانَهُ حَبلٌ فَأَقعَصَهُ","ذُلّاً وَشَرُّ الحِبالِ الحَيَّةُ الذِكَرُ",2,"ر",1,0],["كَم حَجَّةٍ لَكَ في النَوافِلِ نَوَّهَت","بِدُعاءِ دينِ العَدلِ وَالتَوحيدِ",3,"د",1,0],["كَم حَصانِ الذَيلِ يَروي دَمعُها","خَدَّها عِندَ قَتيلٍ بِالظَما",4,"ا",1,0],["كم حِكْمَةٍ أبْدَى وكمْ قَصْدٍ هَدَى","للسّالِكينَ أبانَ منْهُ دَريسا",5,"س",2,0],["كَم حاوَلَت هَدمي مَعاوِلُهُم","وَأَبى الإِلَهُ فَزادَني رَفعا",6,"ع",2,0],["كَم حَدَّدوا يَومَ الجَلاءِ الَّذي","أَصبَحَ في الإِبهامِ كَالمَحشَرِ",7,"ر",1,1],["كَم حَمَّلوهُ مِن ثِقَلِ عِبئِهِمُ","رَزِيَّةً مُشمخرَّةً فَصَبَر",8,"ر",1,0],["كَم حادِثٍ خَفَّت حلومُ ذَوي النُهى","خَوفاً وَجَأشُكَ فيهِ أَربطُ مِن حِرا",9,"ر",2,0],["كَمْ حِكْمَةٍ رَدَّدْتَهَا فَأَعَدْتَهَا","وَلَهَا رَنِينُ مَثَالِثٍ وَمَثَانِي",10,"ن",2,0],["كَمْ حُكْتِ سِتْراً وَدِفْئاً","لِنِسْوَةٍ وَعِيَالِ",11,"ل",1,0],["كم حولها من بدور تجتني زَهَراً","فتحسب الزهر قد قبَّلْن أيديها",12,"ي",3,0],["كم حكمٍ لطيفةٍ","في طيِّها مستودَعَهْ",13,"ع",2,0],["كم حكمةٍ لك في النفوس خفيةٍ","خفيت مداركها عن الأفكارِ",14,"ر",1,0],["كَم حادِثٍ عَنّا جَلا","هُ وَكَم كَفانا مِن بَلِيَّه",15,"ي",2,0],["كم حفظت من فقهِ آرائهِ","بحوث إكمالٍ وإرشاد",16,"د",1,0],["كم حُرّةٍ قد رام إصباءَها","فما ارعوتْ منه إلى فكر",17,"ر",1,0],["كم حالبين ضروعَ العيش درتَه","يمرون منهن ضَرَّاتٍ وأخلافا",18,"ف",2,0],["كم حُلوقٍ بللتَها قد أفاءت","لك ذكراً في الناس يشجي الحلوقا",19,"ق",2,0],["كم حسناتٍ له مُشهَّرة","أسَرَّها ما استطاع من مَلَكِهْ",20,"ك",2,0],["كم حذوناكَ لترقى في العلا","وأبى اللَّهُ فلا تعلُ هُبل",21,"ل",1,0],["كم حاجةٍ باكرتُها","بالسعدِ والوجهِ الوجيهِ",22,"ي",2,0],["كَم حاوَلوا كَتمَ الأَسى لَكِنَّهُ","قَد كانَ يَختَرِقُ الجُسومَ فَيَظهَرُ",23,"ر",1,0],["كَم حَوَته وَحَواها مَلِكاً","دَولَةُ الروحِ الَّتي لا تُقهَرُ",24,"ر",1,0],["كَمحَرَّضَتهُ النَفسُ في نَزَواتِها","لِيَكونَ صاحِبَ حيلَةٍ أَو مَطمَعِ",25,"ع",1,0],["كَم حَوَّطوها وَكَم شادوا الحُصونَ بِها","حَتّى طَلَعتَ فَلا حِصنٌ وَلا رُجلُ",26,"ل",1,0],["كَم حاوَلَ اللَيلُ أَن يَطوي كَواكِبَهُ","فَكانَ يَنشُرُها مِن حَيثُ يَطويها",27,"ي",3,0],["كمْ حَطَّمَ الدَّهْرُ","ذا هِمَّةٍ كثيرَ الرَّمادِ",28,"د",1,0],["كمْ حَرَّكَتْ كفُّ الأَسى","أَوْتارَ ذَيَّاكَ الحَنينْ",29,"ن",1,0],["كم حكمة لك سارت في الورى مثلا","قد قلتها بلسان الشاعر الذرب",30,"ب",1,0],["كم حكمة بعد ان فاه الحكيم بها","سارت بها في فجاج الارض ركبان",31,"ن",1,0],["كم حارب الوطن الغزي","ز وباع صالحه بدرهم",32,"م",1,0],["كَم حَبيبٍ لا عُذرَ في اللَومِ فيهِ","لَكَ فيهِ مِنَ التُقى لُوّامُ",33,"م",1,0],["كَم حُزنَ مِن ذِكرٍ لِغُفلٍ خامِلٍ","وَبَنَينَ مِن حَسَبٍ لِغَيرِ حَسيبِ",34,"ب",1,0],["كَم حُمِّلَت أَمثالَهُ مُتَوَجِّهاً","مَن يَعمَلاتٍ حامِلاتِ وُفودِ",35,"د",1,0],["كَم حاسِدٍ لِأَبي العَبّاسِ مُشتَغِلٌ","بِنِعمَةٍ في أَبي العَبّاسِ تُشجيهِ",36,"ي",2,0],["كَمُحتَطِبٍ يَوماً أَساوِدَ هَضبَةٍ","أَتاهُ بِها في ظُلمَةِ اللَيلِ حاطِبُه",37,"ب",2,0],["كَم حَلَّ عَنّا عَدلُ سُنَّتِهِ","مِن مَغرَمٍ ثِقلٍ وَمِن إِصرِ",38,"ر",1,0],["كم حومة للوصال مرهجة","بلغ سهمي فيها إلى الهدف",39,"ف",1,0],["كم حاولوا قسْرَ العدو","وِ بصولةِ الأُسْدِ القَساوِر",40,"ر",1,0],["كم حاسدٍ رَحْبِ الفِناءِ ضَيّقَتْ","عليه أسيافُ الأميرِ ما رَحُبْ",41,"ب",1,0],["كم حاولا أمدِي فطالَ عليهما","أن يُدرِكا إلاّ مثار تُرابي",42,"ب",2,0],["كم حبيبٍ بَعُدَت صَهباؤُه","وتَبقَّت نفحةٌ من حَبَبِه",43,"ه",1,0],["كَم حَلقِ أَيرٍ لَم يَكُن لَكَ ظالِماً","قَد باتَ وَهوَ بِحَلقِ جُحرِكَ يَخفِقُ",44,"ق",1,0],["كَم حَسرَةٍ لي في الفُؤادِ الَّذي","أَطَلتَ في سِجنِ الهَوى حَبسَهُ",45,"س",2,0],["كَم حاجَةٍ صارَت رَكوباً بِهِ","وَلَم تَكُن مِن قَبلِهِ بِالرَكوبِ",46,"ب",1,0],["كَم حالَ فَيضُ نَداهُ يَومَ مُعضِلَةٍ","وَبَأسُهُ بَينَ مَن يَرجوهُ وَالمِحَنِ",47,"ن",1,0],["كَم حَلَّ في أَكنافِها مِن مُعدِمٍ","أَمسى بِهِ يَأوي إِلَيهِ المُعدِمُ",48,"م",1,0],["كَمْ حَكِيمٍ ضَلَّ فِيهَا","فَاكْتَسَى بِالْعِلْمِ جَهْلا",49,"ل",2,0],["كمْ حلَّ في بلدٍ فشتَّتَ شملَ منْ","فيها فلا يجدونَ منهُ مَهْرَبا",50,"ب",2,0],["كم حبسوا منْ مجرمٍ عندَهُ","فحازَ مِنْ كلِّ امرئٍ خصلَهْ",51,"ه",1,0],["كم حاسدٍ كم كائدٍ كم ماردٍ","كم واجدٍ كم جاحدٍ كم زارِ",52,"ر",1,0],["كم حاسدٍ كم ماردٍ كم عِدى","كم عائبٍ كم مبغضٍ كم سفيهْ",53,"ي",2,0],["كمْ حاسدٍ لمْ يستبحْ حرمةً","منكَ ولو مازحْتَهُ لاستباحْ",54,"ح",1,1],["كم حسبنا مِنَ الأمورِ ولكنْ","ما حسبنا سريعَ بُعْدِكَ عنَّا",55,"ن",2,0],["كمْ حائطٍ فوقَ الكواعبِ طائحٍ","ماذا أقولُ لهُ ولكنْ حائطُ",56,"ط",1,1],["كمْ حاضرٍ كغائبٍ","وغائبٍ كحاضرِ",57,"ر",1,0],["كَم حَققَ العَزم والاعجال مِن أَمَلٍ","وَخابَ قَصد بِإمهالٍ وَتَقليبِ",58,"ب",1,0],["كَم حاسِدٍ حَنِقٍ عَلَيَّ بِلا","جُرمٍ فَلَم يَضِرُّني الحَنَقُ",59,"ق",1,1],["كَمْ حَسَّنَتْ لَذَّةًً لِلْمَرْءِ قاتِلَةً","مِنْ حَيْثُ لَمْ يّدْرِ أنَّ السُّمَّ في الدَّسَمِ",60,"م",1,0],["كَم حاسِدٍ لَكُمُ يَرجو خِلافَتَكُم","قَد كانَ يَفقَأُ مِنهُ المُقلَةَ الحَسَدُ",61,"د",1,0],["كَم حَلَّتِ الأَيّامُ مِن حيلَةٍ","ثُمَّتَ حَلَّت كُلَّ عِقدٍ عُقِد",62,"د",1,0],["كَم حَلَّ حَيثُ تَبَنّى الحَيُّ مِن أُمَ