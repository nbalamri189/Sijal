يط"],[552,"من ذا الطبيب لأدوائي وأوجاعي","https://www.aldiwan.net/poem47698.html","البسيط"],[552,"برباعكم يا أهل يثرب حاجي","https://www.aldiwan.net/poem47907.html","الكامل"],[563,"من عاش في الأرض لا يخلو من الكمد","https://www.aldiwan.net/poem52790.html","البسيط"],[568,"كم حاسد ظاهره لي وامق","https://www.aldiwan.net/poem69567.html","الرجز"],[576,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"],[587,"إياك يا طائر قلبي ففي","https://www.aldiwan.net/poem17478.html","السريع"],[587,"أتراه لما جار في أخلاقه","https://www.aldiwan.net/poem18007.html","الكامل"]],"verses":[["كَم حَجَّةٍ في الدينِ خُضتَ غِمارَها","هَدرَ الفَنيقِ تَخَمَّطاً وَصِيالا",0,"ل",2,0],["كَم حَشَوتُ الثَرى حُساماً طَريراً","وَطَويلاً لَدناً وَطِرفاً أَغَرّا",1,"ر",2,0],["كَم حاجَةٍ بِمَكانِ النَجمِ قَرَّبَها","طولُ التَعَرُّضِ وَالرَوحاتِ وَالبُكَرُ",2,"ر",1,0],["كَم حاطِبٍ خانَهُ حَبلٌ فَأَقعَصَهُ","ذُلّاً وَشَرُّ الحِبالِ الحَيَّةُ الذِكَرُ",2,"ر",1,0],["كَم حَجَّةٍ لَكَ في النَوافِلِ نَوَّهَت","بِدُعاءِ دينِ العَدلِ وَالتَوحيدِ",3,"د",1,0],["كَم حَصانِ الذَيلِ يَروي دَمعُها","خَدَّها عِندَ قَتيلٍ بِالظَما",4,"ا",1,0],["كم حِكْمَةٍ أبْدَى وكمْ قَصْدٍ هَدَى","للسّالِكينَ أبانَ منْهُ دَريسا",5,"س",2,0],["كَم حاوَلَت هَدمي مَعاوِلُهُم","وَأَبى الإِلَهُ فَزادَني رَفعا",6,"ع",2,0],["كَم حَدَّدوا يَومَ الجَلاءِ الَّذي","أَصبَحَ في الإِبهامِ كَالمَحشَرِ",7,"ر",1,1],["كَم حَمَّلوهُ مِن ثِقَلِ عِبئِهِمُ","رَزِيَّةً مُشمخرَّةً فَصَبَر",8,"ر",1,0],["كَم حادِثٍ خَفَّت حلومُ ذَوي النُهى","خَوفاً وَجَأشُكَ فيهِ أَربطُ مِن حِرا",9,"ر",2,0],["كَمْ حِكْمَةٍ رَدَّدْتَهَا فَأَعَدْتَهَا","وَلَهَا رَنِينُ مَثَالِثٍ وَمَثَانِي",10,"ن",2,0],["كَمْ حُكْتِ سِتْراً وَدِفْئاً","لِنِسْوَةٍ وَعِيَالِ",11,"ل",1,0],["كم حولها من بدور تجتني زَهَراً","فتحسب الزهر قد قبَّلْن أيديها",12,"ي",3,0],["كم حكمٍ لطيفةٍ","في طيِّها مستودَعَهْ",13,"ع",2,0],["كم حكمةٍ لك في النفوس خفيةٍ","خفيت مداركها عن الأفكارِ",14,"ر",1,0],["كَم حادِثٍ عَنّا جَلا","هُ وَكَم كَفانا مِن بَلِيَّه",15,"ي",2,0],["كم حفظت من فقهِ آرائهِ","بحوث إكمالٍ وإرشاد",16,"د",1,0],["كم حُرّةٍ قد رام إصباءَها","فما ارعوتْ منه إلى فكر",17,"ر",1,0],["كم حالبين ضروعَ العيش درتَه","يمرون منهن ضَرَّاتٍ وأخلافا",18,"ف",2,0],["كم حُلوقٍ بللتَها قد أفاءت","لك ذكراً في الناس يشجي الحلوقا",19,"ق",2,0],["كم حسناتٍ له مُشهَّرة","أسَرَّها ما استطاع من مَلَكِهْ",20,"ك",2,0],["كم حذوناكَ لترقى في العلا","وأبى اللَّهُ فلا تعلُ هُبل",21,"ل",1,0],["كم حاجةٍ باكرتُها","بالسعدِ والوجهِ الوجيهِ",22,"ي",2,0],["كَم حاوَلوا كَتمَ الأَسى لَكِنَّهُ","قَد كانَ يَختَرِقُ الجُسومَ فَيَظهَرُ",23,"ر",1,0],["كَم حَوَته وَحَواها مَلِكاً","دَولَةُ الروحِ الَّتي لا تُقهَرُ",24,"ر",1,0],["كَمحَرَّضَتهُ النَفسُ في نَزَواتِها","لِيَكونَ صاحِبَ حيلَةٍ أَو مَطمَعِ",25,"ع",1,0],["كَم حَوَّطوها وَكَم شادوا الحُصونَ بِها","حَتّى طَلَعتَ فَلا حِصنٌ وَلا رُجلُ",26,"ل",1,0],["كَم حاوَلَ اللَيلُ أَن يَطوي كَواكِبَهُ","فَكانَ يَنشُرُها مِن حَيثُ يَطويها",27,"ي",3,0],["كمْ حَطَّمَ الدَّهْرُ","ذا هِمَّةٍ كثيرَ الرَّمادِ",28,"د",1,0],["كمْ حَرَّكَتْ كفُّ الأَسى","أَوْتارَ ذَيَّاكَ الحَنينْ",29,"ن",1,0],["كم حكمة لك سارت في الورى مثلا","قد قلتها بلسان الشاعر الذرب",30,"ب",1,0],["كم حكمة بعد ان فاه الحكيم بها","سارت بها في فجاج الارض ركبان",31,"ن",1,0],["كم حارب الوطن الغزي","ز وباع صالحه بدرهم",32,"م",1,0],["كَم حَبيبٍ لا عُذرَ في اللَومِ فيهِ","لَكَ فيهِ مِنَ التُقى لُوّامُ",33,"م",1,0],["كَم حُزنَ مِن ذِكرٍ لِغُفلٍ خامِلٍ","وَبَنَينَ مِن حَسَبٍ لِغَيرِ حَسيبِ",34,"ب",1,0],["كَم حُمِّلَت أَمثالَهُ مُتَوَجِّهاً","مَن يَعمَلاتٍ حامِلاتِ وُفودِ",35,"د",1,0],["كَم حاسِدٍ لِأَبي العَبّاسِ مُشتَغِلٌ","بِنِعمَةٍ في أَبي العَبّاسِ تُشجيهِ",36,"ي",2,0],["كَمُحتَطِبٍ يَوماً أَساوِدَ هَضبَةٍ","أَتاهُ بِها في ظُلمَةِ اللَيلِ حاطِبُه",37,"ب",2,0],["كَم حَلَّ عَنّا عَدلُ سُنَّتِهِ","مِن مَغرَمٍ ثِقلٍ وَمِن إِصرِ",38,"ر",1,0],["كم حومة للوصال مرهجة","بلغ سهمي فيها إلى الهدف",39,"ف",1,0],["كم حاولوا قسْرَ العدو","وِ بصولةِ الأُسْدِ القَساوِر",40,"ر",1,0],["كم حاسدٍ رَحْبِ الفِناءِ ضَيّقَتْ","عليه أسيافُ الأميرِ ما رَحُبْ",41,"ب",1,0],["كم حاولا أمدِي فطالَ عليهما","أن يُدرِكا إلاّ مثار تُرابي",42,"ب",2,0],["كم حبيبٍ بَعُدَت صَهباؤُه","وتَبقَّت نفحةٌ من حَبَبِه",43,"ه",1,0],["كَم حَلقِ أَيرٍ لَم يَكُن لَكَ ظالِماً","قَد باتَ وَهوَ بِحَلقِ جُحرِكَ يَخفِقُ",44,"ق",1,0],["كَم حَسرَةٍ لي في الفُؤادِ الَّذي","أَطَلتَ في سِجنِ الهَوى حَبسَهُ",45,"س",2,0],["كَم حاجَةٍ صارَت رَكوباً بِهِ","وَلَم تَكُن مِن قَبلِهِ بِالرَكوبِ",46,"ب",1,0],["كَم حالَ فَيضُ نَداهُ يَومَ مُعضِلَةٍ","وَبَأسُهُ بَينَ مَن يَرجوهُ وَالمِحَنِ",47,"ن",1,0],["كَم حَلَّ في أَكنافِها مِن مُعدِمٍ","أَمسى بِهِ يَأوي إِلَيهِ المُعدِمُ",48,"م",1,0],["كَمْ حَكِيمٍ ضَلَّ فِيهَا","فَاكْتَسَى بِالْعِلْمِ جَهْلا",49,"ل",2,0],["كمْ حلَّ في بلدٍ فشتَّتَ شملَ منْ","فيها فلا يجدونَ منهُ مَهْرَبا",50,"ب",2,0],["كم حبسوا منْ مجرمٍ عندَهُ","فحازَ مِنْ كلِّ امرئٍ خصلَهْ",51,"ه",1,0],["كم حاسدٍ كم كائدٍ كم ماردٍ","كم واجدٍ كم جاحدٍ كم زارِ",52,"ر",1,0],["كم حاسدٍ كم ماردٍ كم عِدى","كم عائبٍ كم مبغضٍ كم سفيهْ",53,"ي",2,0],["كمْ حاسدٍ لمْ يستبحْ حرمةً","منكَ ولو مازحْتَهُ لاستباحْ",54,"ح",1,1],["كم حسبنا مِنَ الأمورِ ولكنْ","ما حسبنا سريعَ بُعْدِكَ عنَّا",55,"ن",2,0],["كمْ حائطٍ فوقَ الكواعبِ طائحٍ","ماذا أقولُ لهُ ولكنْ حائطُ",56,"ط",1,1],["كمْ حاضرٍ كغائبٍ","وغائبٍ كحاضرِ",57,"ر",1,0],["كَم حَققَ العَزم والاعجال مِن أَمَلٍ","وَخابَ قَصد بِإمهالٍ وَتَقليبِ",58,"ب",1,0],["كَم حاسِدٍ حَنِقٍ عَلَيَّ بِلا","جُرمٍ فَلَم يَضِرُّني الحَنَقُ",59,"ق",1,1],["كَمْ حَسَّنَتْ لَذَّةًً لِلْمَرْءِ قاتِلَةً","مِنْ حَيْثُ لَمْ يّدْرِ أنَّ السُّمَّ في الدَّسَمِ",60,"م",1,0],["كَم حاسِدٍ لَكُمُ يَرجو خِلافَتَكُم","قَد كانَ يَفقَأُ مِنهُ المُقلَةَ الحَسَدُ",61,"د",1,0],["كَم حَلَّتِ الأَيّامُ مِن حيلَةٍ","ثُمَّتَ حَلَّت كُلَّ عِقدٍ عُقِد",62,"د",1,0],["كَم حَلَّ حَيثُ تَبَنّى الحَيُّ مِن أُمَمٍ","ثُمَّ اِنقَضوا وَسَبيلاً واحِداً سَلَكوا",63,"ك",3,0],["كَم حَسُنَت في الأَرضِ مِن صورَةٍ","وَلَم تَكُن في عَمَلٍ مُحسِنَه",64,"ن",2,0],["كَم حَلَّتِ الأَحياءُ جِدَّةَ رَوضَةٍ","وَرَعَت لَها نَبتاً لِعامٍ ثانِ",65,"ن",1,0],["كَم حاوَلَ الرَجُلُ الدُنِّيا بِقُوَّتِهِ","وَمالِهِ فَخَطَتهُ أَو تَخَطّاها",66,"ا",3,1],["ك