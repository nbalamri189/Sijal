","https://www.poetsgate.com/ViewPoem.aspx?id=195073",""],[1901,"خليليَّ جهل الدهر أفقدني حِلمي","https://www.poetsgate.com/ViewPoem.aspx?id=160394",""],[4860,"حدث العاقل بما لا يعقله","https://www.poetsgate.com/ViewPoem.aspx?id=32518",""],[5061,"انت عيدي","https://www.poetsgate.com/ViewPoem.aspx?id=154887",""],[5397,"رميت بقوس الحزم عن قوس حاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157922",""],[5452,"الشّعر","https://www.poetsgate.com/ViewPoem.aspx?id=148452",""],[5455,"الوصية","https://www.poetsgate.com/ViewPoem.aspx?id=213961",""],[5455,"صالات المطار","https://www.poetsgate.com/ViewPoem.aspx?id=34424",""],[5573,"ياعناد","https://www.poetsgate.com/ViewPoem.aspx?id=200344",""],[5629,"الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=184509",""],[5649,"بيات صيفى","https://www.poetsgate.com/ViewPoem.aspx?id=151474",""],[5688,"تركتِ العين تغمرها الدّموع","https://www.poetsgate.com/ViewPoem.aspx?id=204213",""],[5794,"غرور الشعر ..","https://www.poetsgate.com/ViewPoem.aspx?id=122796",""],[5980,"لئن شطَّت عن الأحباب داري","https://www.poetsgate.com/ViewPoem.aspx?id=146274",""],[5309,"وغانية اخفى الجمال خصالها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573546",""]],"verses":[["لَئِن شاقَني شَرقُ العُقابِ فَلَم أَزَل","أَخُصُّ بِمَمحوضِ الهَوى ذَلِكَ السَفحا",0,"ح",2,0],["لئن شاقَها بين العُذَيْب وبارقٍ","مياه بفَيء الظلُ للبان والرَّندِ",1,"د",1,0],["لئن شنع الناس في أمره","لذاك بتشنيعه في الخبرْ",2,"ر",1,0],["لَئِن شَكَرَ الأَنامُ لَقَد أُغيثوا","هُناكَ بِفَضلِ سَيِّدَةِ الأَنامِ",3,"م",1,0],["لَئِن شَهَرَ السُلطانُ أَمضى سُيوفِهِ","وَرَشَّحَ عودُ المُلكِ أَزكى فُروعِهِ",4,"ع",2,0],["لَئِن شَكَرتُم لَأَزيدَنَّكُم","لَكِّنَما كُفرَهُم غالَها",5,"ل",3,0],["لئنْ شَبَهَ العشاقُ خدَّيْهِ جنَّةً","فموجُ المنايا حولَهُ متلاطِمُ",6,"م",1,0],["لَئِن شَطَّت بِها دارٌ","عَنوجٌ بِالهَوى حينا",7,"ن",2,0],["لئن شفى الطب ضنى عارضاً","فمهجتي أنت لها شافيه",8,"ي",2,0],["لي نَشوَتانِ وَلِلنُدمانِ واحِدَةٌ","شَيءٌ خُصِصتُ بِهِ مِن بَينِهِم وَحدي",9,"د",2,0],["لئن شكر الصبح المحبون إنني","شكرت الدجى إذ كان ما بيننا سترا",10,"ر",2,1],["لين شيطاني تلفّظ كلمتيني","ورحت منّي ماتبي سمع أعتذاري",11,"ر",2,0],["لَئِنْ شاقَني شَرْقُ العُقابِ فَلَمْ أزَل","أخُصّ بمحوضِ الهَوى ذلك السفحَا",12,"ح",2,0],["لَئِنْ شَطَّتْ بِها دارٌ","عَنوجٌ بِکلهَوَى حينا",13,"ن",2,0],["لَئن شَطت بِهن العَيس يَوماً","فَمِنكَ عَلى حَشاشَتك السَلام",14,"م",1,0],["لينشرح صدرك المملوء من حكمٍ","وطيب النفس شهيّها ومنيّها",15,"ي",3,0],["لئن شمت العدوَّ بنا فمهلاً","سَينقل للصفائح كانتقالي",16,"ل",2,0],["لَئِنْ شَطَّ مَا بَيْنِي وَبَيْنَ أَحِبَّتِي","فَإِنِّي عَلَى عَهْدِ الْوِدَادِ لَخَائِلُ",17,"ل",1,0],["لَئِن شُبَّتِ الحَربُ العَوانُ الَّتي أَرى","وَقَد طالَ إيعادٌ بِها وَتَرَهُّبُ",18,"ب",1,0],["لِئِن شَغَلَ المُغَيِّبَ عَنكَ وَهمٌ","فَلي بِكَ عَن ذَوي الأَوهامِ شُغلُ",19,"ل",1,0],["لئن شتَّتَتْ أيدي الحوادِثِ شَملَنا","فجُودُ أبي الغاراتِ للشملِ جَامعُ",20,"ع",1,1],["لئن شردتني عن معاليك حيرتي","ورزقي فقلبي عالق بك أو أضحى",21,"ح",2,0],["لئن شغفت غر القوافي بحبه","فكل امرئ يولي الجميل محبب",22,"ب",1,0],["لئن شاركوه في اسمه دون فعله","فما يستوي البحران عذب ومالح",23,"ح",1,0],["لئِنْ شَرَّ نَفْسي قُرْبُه ودُنُوُّه","لَقد سَاءَها تَشْتِيتُه واغْتِرابُه",24,"ب",2,0],["لِيَنشُرَ مِن أَكفانِهِ كُلَّ مَيتِ","وَيوقِظُ مَن تَهويمِهِ كُلَّ غافِلِ",25,"ل",1,0],["لئن شكوت فما أشكوكِ عن ضجر","وإن هجرت فلم أهجركِ من حرد",26,"د",1,0],["لَئِن شَبَّهوكِ البَدر لَيلَة تمِّه","لَقَد قارَفوا الشَّنعاءَ وَاِحتَقَبوا الوِزرا",27,"ر",2,0],["لَئِن شَغَفَ الآرامَ حُبّاً فَقَد سَبى","فُؤادَ المَعالي وَهوَ في الغَيبِ مُكتَمُ",28,"م",1,0],["لئن شرفت مناسبُها وجلَّت","لقد زُفَّت الى كفءٍ شريفِ",29,"ف",1,1],["لئن شاق مشتاقا إلى اليض منزل","فشوقي على الخضر المطيّبة انحصر",30,"ر",1,0],["لئن شربتم كؤوس الوصل مترعة","يوما فلا بد من يوم تغبونا",31,"ن",2,0],["لئن شردوها واستبيح حريمها","ومن وعد بلفور تمادى كفورها",32,"ر",3,0],["لَئن شَقَقت مِنهَ الحِساب جيوبَها","لَقَد شُقِّقَت مِنا عَلَيهِ قُلوب",33,"ب",1,0],["لَئِن شَبَّهوا كاساتِها بِكَواكِب","فَكَم طالَعَتنا بِالنُحوسِ الكَواكِبُ",34,"ب",1,0],["لَئن شقت عَلى المَوتى جُيوب","فَحَق بِأَن تَشق لَكُ القُلوب",35,"ب",1,0],["لئن شطنتْ أبياتُ جُملٍ وأصبحتْ","قُوى وَصْلِها من وَصلنِا قُضبِت قَضْبَا",36,"ب",2,0],["لئن شتَّت الدهر المفرق جمعنا","فلن يجمعنَّ الدهر الا وفرّقا",37,"ق",2,0],["لئن شوّس الانشاد للشعر ناعق","فلي من سماع الجاهلين مشوّش",38,"ش",1,0],["لي نشوة بك والساعات تقطعها","عني فأصحو فلا خمري ولا جامي",39,"م",2,0],["لي نشوة من هوى وسكر","ولوعة من جوى وذكر",40,"ر",1,1],["لَئن شكوتِ من الرمضاءِ محرقةً","فَفي القفول غداً تشكين من بَلَلِ",41,"ل",1,0],["لئن شقيت لفرقته ديارٌ","فقد سعدت بصحبته القبور",42,"ر",1,0],["لَئِن شأت مصر بالإِحسان واِندَفَعَت","فَكَم شَهِدنا لَها يَوم النَدا دَفعا",43,"ع",2,0],["لئن شكت الحساد منه فربما","أضر شعاع الشمس بالأعين الرمد",44,"د",1,0],["لئن شئت صيرت الجبال بزجرة","كما يتثنى في ذرى غصن نظر",45,"ر",1,0],["لئن شرب ابنة البن المفدى","فلا عجب ولا عيب عليه",46,"ه",1,1],["لئن شبه الساقي المدام بعسجد","فقد مال بالتشبيه عن صيغة الأدب",47,"ب",1,1],["لئن شامهُ يوما أخو الزهد راهبٌ","لهامَ وآلى لم يكُ الدهر راهبا",48,"ب",2,0],["لئن شئتم وفا وعدٍ لخلٍّ","فأرجو بثَّهُ قبل الحمامِ",49,"م",1,0],["لئن شام ذا حلمٍ على الخير شأنهُ","فيصرعهُ زجراً بكل المصاعِبِ",50,"ب",1,0],["لئن شق يوماً علينا النوى","فان العتابَ علينا أشق",51,"ق",1,0],["لئن شابا به حزناً ففيه","فؤادُ ذوي العلا لهما يشيب",52,"ب",1,0],["لينشرَ من شذاهُ زكيَّ ريحٍ","يطيبُ بما توزعه الوجود",53,"د",1,0],["لئن شابَ قلبي قبلما شابَ مَفْرِقي","يَحقُ له فالقلبُ مستَودَعُ الهمِ",54,"م",1,0],["لين شفت النفس وأهيه غافله","سارحه بمهجة خيالي وكوكبي",55,"ب",2,0],["لين شعري ..اظمحل","وضاق صدري يالفتون",56,"ن",1,0],["لئن شهدت عين الهدى حز رأسه","فإنسانها عن حمله غير غائب",57,"ب",1,0],["لي نشوة الصّوفيّ في خلواته","ساعات كشفه أو زمان دعائهِ",58,"ا",3,0],["لين شفت العمر قدامه ترامى","وصد عني مانشدني ويش فيه؟",59,"ي",2,0],["لين شفتك من ورا بيبان صالات المطار","مقبله من كثر شوقك .. كنت اشوفك تركضين",60,"ن",1,0],["لين شفت الي تركتني شايب بعز الشباب","ماغدت عندي شجاعه طحت من حيلي صويب",61,"ب",1,0],["لين شفتك والحزن ودع شموخة واعتدالة","والفرح صوتة تغنى خضر الدرب لمصيرة",62,"ر",2,0],["لى نشوة الصحو والاشواق قافية","والبحر يردف شريانى .. ومحبرتى",63,"ت",2,0],["لئن شئت الفراق فإنّ قلبي","بذكرك هائم ثمِل صريع",64,"ع",1,0],["لين شب الكون ضوء / وشعشعت للشمس .. بيد","وانتعش فيني أمل / لقياك من بين الزحام",65,"م",1,0],["لئن شطَّت عن الأحباب داري","وأبعدني النوى عنهم بجسمي",66,"ي",1,1],["لَئِن شَغَلَت بالي بِكَثرَةِ جَريِها","فَلا هَدَّأَ المَولى مِنَ الجَريِ بالَها",67,"ل",3,0]]}