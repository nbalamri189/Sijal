{"poems":[[63,"إن أخلف الوعد حي يظعنون غدا","https://www.aldiwan.net/poem45680.html","البسيط"],[55,"غضب الحبيب فهاج لي استعبار","https://www.aldiwan.net/poem26367.html","الكامل"],[57,"أمت مطامعي فأرحت نفسي","https://www.aldiwan.net/poem24621.html","الوافر"],[77,"خدع الشوق فؤادي فانخدع","https://www.aldiwan.net/poem35986.html","الرمل"],[86,"دك ما بين ضحوة وعشي","https://www.aldiwan.net/poem10480.html","الخفيف"],[93,"صدقت في عتبكم أو يصدق الشمم","https://www.aldiwan.net/poem11361.html","البسيط"],[93,"رب البيان وسيد القلم","https://www.aldiwan.net/poem11371.html","أحذ الكامل"],[83,"حياك يا دار الهوى من دار","https://www.aldiwan.net/poem54294.html","الكامل"],[83,"ما للحمول تحن للأطلال","https://www.aldiwan.net/poem54250.html","الكامل"],[88,"أطربتهم بلحنها الأنغام","https://www.aldiwan.net/poem44463.html","الخفيف"],[27,"سقيا لنهي حمامة وحفير","https://www.aldiwan.net/poem5737.html","الكامل"],[95,"أمتي هل لك بين الأمم","https://www.aldiwan.net/poem60148.html","عموديه"],[51,"ما لمن حسنه الله وأعلى درجاته","https://www.aldiwan.net/poem8696.html","مجزوء الرمل"],[51,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[51,"أمت بجود من وداد ومن شكر","https://www.aldiwan.net/poem64066.html","الطويل"],[51,"قد قرن المشتري إلى البدر","https://www.aldiwan.net/poem64091.html","المنسرح"],[51,"قل لأبي سهل الذي ورث","https://www.aldiwan.net/poem64575.html","المنسرح"],[51,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[51,"أهنئ الفطر بوجه الإمام","https://www.aldiwan.net/poem66050.html","المنسرح"],[51,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[70,"سيدي قلبي عندك","https://www.aldiwan.net/poem42936.html","مجزوء الرمل"],[89,"حال بيني وبين شكري التراب","https://www.aldiwan.net/poem44618.html","الخفيف"],[85,"قم سليمان بساط الريح قاما","https://www.aldiwan.net/poem63696.html","الرمل"],[45,"رددت بعيسى الروم من حيث أقبلت","https://www.aldiwan.net/poem62750.html","الطويل"],[45,"من عذيري من الظباء الغيد","https://www.aldiwan.net/poem63503.html","الخفيف"],[45,"يهون عليها أن أبيت متيما","https://www.aldiwan.net/poem65665.html","الطويل"],[45,"أترى هيثما يطيق ترضى","https://www.aldiwan.net/poem66859.html","الخفيف"],[28,"يا ظمي ويحك إني ذو محافظة","https://www.aldiwan.net/poem5495.html","البسيط"],[97,"موقفٌ حانَ فاغتنم","https://www.aldiwan.net/poem24754.html","مجزوء الخفيف"],[80,"أي خطب عن قوسه الموت يرمي","https://www.aldiwan.net/poem31283.html","الخفيف"],[80,"الصبح شر بغيض","https://www.aldiwan.net/poem31540.html","المجتث"],[44,"دنف بكى آيات ربع مدنف","https://www.aldiwan.net/poem30401.html","الكامل"],[44,"لطمحت في الإبراق والإرعاد","https://www.aldiwan.net/poem30535.html","الكامل"],[44,"قد نابت الجزع من أروية النوب","https://www.aldiwan.net/poem30576.html","البسيط"],[31,"يا برق أبرق من قري","https://www.aldiwan.net/poem42473.html","مجزوء الكامل"],[31,"يقول عتيق إذ شكوت صبابتي","https://www.aldiwan.net/poem42548.html","الطويل"],[105,"في حمى الحق ومن حول الحرم","https://www.aldiwan.net/poem42091.html","الرمل"],[105,"أم تدافع يأسها برجائها","https://www.aldiwan.net/poem43414.html","الكامل"],[105,"عقرب السوء تمادى في الأذى","https://www.aldiwan.net/poem44060.html","الرمل"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[81,"لام العذار لتوكيد الهوى خلقت","https://www.aldiwan.net/poem61370.html","البسيط"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[75,"أرياك أم ردع من المسك صائك","https://www.aldiwan.net/poem69053.html","الطويل"],[75,"هل كان ضمخ بالعبير الريحا","https://www.aldiwan.net/poem69095.html","الكامل"],[50,"عجبت فطمة من نعتي لها","https://www.aldiwan.net/poem62386.html","الرمل"],[46,"أمتار من هذا الأنام وكيف لي","https://www.aldiwan.net/poem22572.html","الكامل"],[76,"يا مليحة الدعج","https://www.aldiwan.net/poem39467.html","المقتضب"],[68,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem1489.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85418","الخفيف"],[69,"","https://poetry.dctabudhabi.ae/diwan/poem/56828","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39670","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39607","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147470","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202639","المجتث"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12682","الوافر"],[106,"سفينة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179666",""],[106,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[106,"الفلاح","https://www.poetsgate.com/ViewPoem.aspx?id=179559",""],[50,"عجبت فطمة ُ من نعتي لها","https://www.poetsgate.com/ViewPoem.aspx?id=30858",""],[90,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[90,"صورة للخواطر!","https://www.poetsgate.com/ViewPoem.aspx?id=179131",""],[45,"رددت بعيسى الروم من حيث أقبلت","https://www.poetsgate.com/ViewPoem.aspx?id=32921",""],[28,"يا ظمي ويحك إني ذو محافظة","https://www.poetsgate.com/ViewPoem.aspx?id=22024",""],[31,"يَقُولُ عَتيقٌ إذْ شَكَوْتُ صَبَابَتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18855&r=&rc=118",""]],"verses":[["أَم تَنُقُضانِ عُهوداً كُنتُ أُبرِمُها","إِن تَنقُضاها فَلا لُقِّيتُما رَشَدا",0,"د",2,0],["أَم تَذكُرينَ لِدُلجَتي مُتَنَكِّراً","وَعَلَيَّ فَروا عاتِقٍ وَخِمارُ",1,"ر",1,0],["أَمَتُّ مَطامِعي فَأَرَحتُ نَفسي","فَإِنَّ النَفسَ ما طَمِعَت تَهونُ",2,"ن",1,1],["أمْتَعَ الدّهْرُ بِها لمّا سَها","ثمّ لمّا اسْتَشْعَرَ السّهْوَ رفَعْ",3,"ع",1,0],["أَم تَرى يُسعِدُ الكِنانَةَ باري","ها وَيَقضي لَها بِلُطفٍ خَفِيِّ",4,"ي",1,0],["أَمْ تَدَّعِي إِنَّ مِصْراً إِنْ تَبَرَّ بِهِمْ","تُشْبِبْ بِهَا فِتَنٌ جَوفَاءُ تَلْتَهِمُ",5,"م",1,0],["أَمْ تِلْكَ أَمْ غَيْرُ عَاقِلَةٍ","أُمٌّ بِلا قَلْبٍ وَلا رَحِمِ",6,"م",1,0],["أُمٌّ تُغَذِّي مِنْ وَلائِدِهَا","رُمَماً تُمَشِّيهَا عَلَى رُمَمِ",6,"م",1,0],["أمتعت ميسورَ الكلام أخا الهوى","وبخلت حتى بالخيال الساري",7,"ر",2,0],["أَمَّتْ وفود الناس منك مملّكاً","قد خُصَّ بالتعظيم والإجلالِ",8,"ل",1,0],["أم تريدون أن تكونوا كقوم","أسكرتهم بين القبور مدام",9,"م",1,0],["أَمَّت هُنَيدَةُ خِزيَةً لِمُجاشِعٍ","إِذ أَولَمَت لَهُمُ بِشَرِّ جَزورِ",10,"ر",1,0],["أمتي هل لك بين الأمم","منبر للسيف أو للقلم",11,"م",1,1],["أمتي كم غصة دامية","خنقت نجوى علاك في فمي",11,"م",2,0],["أمتي كم صنم مجدته","لم يكن يحمل طهر الصنم",11,"م",1,0],["أمتع اللَهُ بك الده","رُ إلى حين وفاتِهْ",12,"ت",2,0],["أَمْتَعَ اللَّه ذو المواهب بالموْ","هُوبِ غَيْرِ الْمُخَسَّسِ المنْكُودِ",13,"د",1,0],["أمتعني دهرُها بغبطتِهِ","على الذي كان فيه من قصَرِ",14,"ر",1,0],["أمُتُّ بجودٍ من ودادٍ ومن شُكرِ","وأعلم أني قد مَتتُّ إلى حرِّ",15,"ر",1,1],["أمتعَه أفضلَ المتاع به","مُعطِيه إياه آخرَ الدهر",16,"ر",1,0],["أمَتَّ ما حيَّ من مَودَّتِنا","ظلماً فأعقِبْ من مأتم عُرُسا",17,"س",2,0],["أمتَّ وُديك عَبطةً فمَهٍ","دَعْهُ على رسله يمت هرما",18,"م",2,0],["أمتعهُ اللَّهُ بأعياده","في غِبطةٍ دائمةٍ ألفَ عامِ",19,"م",1,0],["أُمَّتي أينَ كُنْتُمُ إذْ دَعتْني","حُرَّةٌ من كرائمِ الأقوامِ",20,"م",1,0],["أَم تُرى ما زَعَموا زورا وَبُهتانا وَإِفكا","ضَحِكَت أَمواجُهُ مِنّي وَقالَت لَستُ أَدري",21,"ي",1,0],["أَم تُراهُ مَرَّ في نَفسي كَما أَعبُرُّ جِسراً","هَل رَأَتهُ قَبلَ نَفسي غَيرُ نَفسي لَستُ أَدري",21,"ي",1,0],["أَم تُراهُ بارِقاً أَومَضَ حينا وَتَوارى","أَم تُراهُ كانَ مِثلَ الطَيرِ في سِجنٍ فَطارا",21,"ر",2,0],["أَم تُراهُ اِنحَلَّ كَالمَوجَةِ في نَفسي وَغارا","فَأَنا أَبحَثُ عَنه وَهوَ فيها لَسُت أَدري",21,"ي",1,0],["أَم تُراني كُنتُ في إِحدى النُجومِ الزُهرِ","أَم أَريجاً أَم حَفيفاً لَستُ أَدري",21,"ي",1,0],["أَم تُرى تَحفَظُ وُدّي","مِثلَ ما أَحفَظُ وُدَّك",22,"ك",1,0],["أم تراها تطير في الموت عنا","مثل أسراب خلفها أسراب",23,"ب",1,0],["أَم تَراها في الخَوافي خَفِيَت","أَم مَقَرُّ الحَولِ في بَعضِ القُدامى",24,"م",2,0],["أَمُتُّ إِلَيكَ بِالذَمامِ الَّذي خَلا","وَمَنزِلَةٍ مِن جَعفَرٍ لَيسَ تُجحَدُ",25,"د",1,0],["أَم تُراني مُلاقِياً مِن قَريبٍ","سَكَناً لي أَشتاقُهُ مِن بَعيدِ",26,"د",1,0],["أَمُتَّخِذٌ عِندي الإِساءَةَ مُحسِنٌ","وَمُنتَقِمٌ مِنّي اِمرُؤٌ كانَ مُنعِما",27,"م",2,0],["أَم تَرى المَطلَ مُبقِياً لِيَ فَضلاً","مِن نَوالٍ أَنفَقتُ مِنهُ عَلَيهِ",28,"ي",2,0],["أَم تَنشَحَنَّ عَلى الحَربِ الَّتي جَرَمَت","مِنّي فُؤادَ اِمرِئٍ حَرّانَ مَهيُومِ",29,"م",1,0],["أُمتي ليس يُهزَمُ ال","فنُّ في أُمة الشّمَم",30,"م",1,0],["أُمَّتي ليس يخذلُ ال","جُودُ في أمة الكرَم",30,"م",1,0],["أُمَّتي أمة العلا","وأبي الهول والهرَم",30,"م",1,0],["أُمّتا هل سمعتني من قريبٍ","حيثُ لي في النياح صَرْخةُ قرمِ",31,"م",1,0],["أمتَّ عينَ صباحي","يوماً وعينَ رقيبي",32,"ي",1,0],["أَمَّتكَ وَالشَيطانُ يَرهَبُ ظِلَّها","فَأَتَتكَ وَهيَ تَفوقُ حِلمَ الأَحنَفِ",33,"ف",1,0],["أَمتَعتَ سَيفَكَ مِن يَدَيكَ بِضَربَةٍ","لا تُمَتِعُ الأَرواحَ بِالأَجسادِ",34,"د",1,0],["أَمَّت نَداهُ بِيَ العيسُ الَّتي شَهِدَت","لَها السُرى وَالفَيافي أَنَّها نُجُبُ",35,"ب",1,0],["أَمَّت غَداةَ رَحيلِها","وَالبَينُ ذو شُرُكٍ شِصاصُه",36,"ص",2,0],["أَمِت حُبَّها وَاِجعَل قَديمَ وِصالِها","وَعِشرَتِها أَمثالَ مَن لا تُعاشِرُ",37,"ر",1,0],["أم تلقَّى الوحيَ أم كان امرأً","جَهِلَ النّاسُ جميعاً وعَلِمْ",38,"م",1,0],["أُمٌّ تُدافعُ يَأسَها بَرجائِها","ما تَنقضِي الآمالُ في أَبنائِها",39,"ا",3,1],["امتلِئْ يا ابنَ أُبَيٍّ غَضَباً","ليس يَرضَى الحقُّ إن لم تَغضبِ",40,"ب",1,0],["أم تظنُّ الجواد تُمسكه الأر","ضُ وتلوي عنانه مسحورا",41,"ر",2,0],["أم تِلكَ لِلقَسَمِ المَبرُورِ من دَنِفٍ","أم ذِي لِعَاقِبَةٍ في الغيبِ قَد سَبَقَت",42,"ت",1,0],["أمُتَوَّجَ الخُلَفاءِ حاكِمْهُم وإنْ","كان القَضاءُ بما تشاءُ كَفيلا",43,"ل",2,0],["أمَتَّ بل استحيَيتَ والموتُ راغمٌ","كأنّكَ للآجَالِ خَصْمٌ مُماحِك",44,"ك",1,0],["أمّتْكَ بالأسْرى وفُودُ قبائلٍ","لا يَجتدينَكَ سَيْبَكَ الممنوحا",45,"ح",2,0],["أُمَّتا بَدَّدَ هَذا لُعَبي","وَوِشاحي حَلَّهُ حَتّى اِنتَثَر",46,"ر",1,0],["أَمتارُ مِن هَذا الأَنامِ وَكَيفَ لي","وَمِنَ الزَمانِ وَشَرِّهِ أَمتارُ",47,"ر",1,1],["أَمْ تُراكِ قَاتلَتي","بِالدَّلالِ والغَنَجِ",48,"ج",1,0],["أم تلكَ ليلى العامريّةُ أَسْفَرَتْ","ليْلاً فصيّرَتِ المساءَ صباحا",49,"ح",2,0],["أَم ترى في يد الطَبيعة لوحاً","نظر الروح نحوه مجلوب",50,"ب",1,0],["امتلأتْ من ذهبٍ أكياسُهُ","وقلبُهُ ممتلئٌ مِنْ دَغَلْ",51,"ل",1,1],["أُمُّ تحنُّ إلى لقاءِ نجيبها","وأبٌ هو الوطن المشوق الظامي",52,"م",2,0],["أم تلكَ عُقْبانُ السماءِ وثَبْنَ من","قُننِ الجبالِ على الخضمِّ النائي",53,"ا",2,0],["آمت سجاح ووالاها مسيلمة","كذابة في بني الدنيا وكذاب",54,"ب",1,1],["إمتى تعود لي وأقول","للكاس للندمان",55,"ن",1,0],["أَمَتّيني فَهَل لَكِ أَن تَرُدّي","حَياتي مِن مَقالِكِ بِالغُرورِ",56,"ر",1,1],["أم تُراك ادَكَرتَ مالك من ما","ضٍ قديمٍ مع الغواني الحِسَان؟",57,"ن",1,0],["أم تراني حسِبتُ زمزم يجري","ماؤها، حيثُ يلتقي الرَّفدان؟",58,"ن",1,0],["امتصَّهُ الناس حتى ما به رمَقُ","كأنَّهُ صب للإيثار تمثالاً",59,"ل",2,0],["أُمَّتَا بدد هذا لُعبي","ووشاحي حله حتى انتشر",60,"ر",1,0],["أم تظُن السماء في مهرجانٍ","لقريب من الملائك قادم",61,"م",1,0],["أم تُرى جاءت الشياطينُ تختصُّ","بروح مشكك متشائم",61,"م",1,0],["أم تُراني لبست فيها على حين","اندفاع مني لباسَ ذئاب ؟",62,"ب",1,0],["أمت إليك بالدمام الذي خلا","ومنزلة من جعفر ليس تجحد",63,"د",1,0],["أمْ تَنشَحَنّ على الحَرْبِ التي جَرَمتْ","مِني فُؤادَ امرِىءٍ حَرّانَ مَهْيُومِ",64,"م",1,0],["أَمِتْ حُبَّها وکجْعَلْ قَدِيمَ وِصَالِها","وعشرتها أمثالَ من لا تعاشر",65,"ر",1,0]]}