et/poem15265.html","الخفيف"],[479,"كل يترجم عن إحساسه لكمو","https://www.aldiwan.net/poem37057.html","البسيط"],[479,"تونسي وحسبي","https://www.aldiwan.net/poem37610.html","مجزوء الخفيف"],[495,"مولاي إن عدت ولم ترضى لي","https://www.aldiwan.net/poem9774.html","السريع"],[505,"فلسفة","https://www.aldiwan.net/poem27794.html","الخفيف"],[505,"التوبة","https://www.aldiwan.net/poem27892.html","الطويل"],[505,"البدر","https://www.aldiwan.net/poem56761.html","الخفيف"],[505,"غزّة","https://www.aldiwan.net/poem61086.html","المتدارك"],[514,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[538,"أمري إلى المولى العلي الشان","https://www.aldiwan.net/poem47924.html","عموديه"],[538,"ذا اليوم تحسد مجده الأيام","https://www.aldiwan.net/poem47942.html","عموديه"],[551,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[558,"إن قوما لم يروا","https://www.aldiwan.net/poem34263.html","مجزوء الرمل"],[558,"اجتمعوا يا إخوتي واحشدوا","https://www.aldiwan.net/poem34637.html","السريع"],[558,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[567,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"أنا أمير العشاق","https://www.aldiwan.net/poem2905.html","مجزوء الرجز"],[575,"ألا فانتبه من أفقها طلع الفجر","https://www.aldiwan.net/poem3064.html","الطويل"]],"verses":[["أَم تَنُقُضانِ عُهوداً كُنتُ أُبرِمُها","إِن تَنقُضاها فَلا لُقِّيتُما رَشَدا",0,"د",2,0],["أَم تَذكُرينَ لِدُلجَتي مُتَنَكِّراً","وَعَلَيَّ فَروا عاتِقٍ وَخِمارُ",1,"ر",1,0],["أَمَتُّ مَطامِعي فَأَرَحتُ نَفسي","فَإِنَّ النَفسَ ما طَمِعَت تَهونُ",2,"ن",1,1],["أمْتَعَ الدّهْرُ بِها لمّا سَها","ثمّ لمّا اسْتَشْعَرَ السّهْوَ رفَعْ",3,"ع",1,0],["أَم تَرى يُسعِدُ الكِنانَةَ باري","ها وَيَقضي لَها بِلُطفٍ خَفِيِّ",4,"ي",1,0],["أَمْ تَدَّعِي إِنَّ مِصْراً إِنْ تَبَرَّ بِهِمْ","تُشْبِبْ بِهَا فِتَنٌ جَوفَاءُ تَلْتَهِمُ",5,"م",1,0],["أَمْ تِلْكَ أَمْ غَيْرُ عَاقِلَةٍ","أُمٌّ بِلا قَلْبٍ وَلا رَحِمِ",6,"م",1,0],["أُمٌّ تُغَذِّي مِنْ وَلائِدِهَا","رُمَماً تُمَشِّيهَا عَلَى رُمَمِ",6,"م",1,0],["أمتعت ميسورَ الكلام أخا الهوى","وبخلت حتى بالخيال الساري",7,"ر",2,0],["أَمَّتْ وفود الناس منك مملّكاً","قد خُصَّ بالتعظيم والإجلالِ",8,"ل",1,0],["أم تريدون أن تكونوا كقوم","أسكرتهم بين القبور مدام",9,"م",1,0],["أَمَّت هُنَيدَةُ خِزيَةً لِمُجاشِعٍ","إِذ أَولَمَت لَهُمُ بِشَرِّ جَزورِ",10,"ر",1,0],["أمتي هل لك بين الأمم","منبر للسيف أو للقلم",11,"م",1,1],["أمتي كم غصة دامية","خنقت نجوى علاك في فمي",11,"م",2,0],["أمتي كم صنم مجدته","لم يكن يحمل طهر الصنم",11,"م",1,0],["أمتع اللَهُ بك الده","رُ إلى حين وفاتِهْ",12,"ت",2,0],["أَمْتَعَ اللَّه ذو المواهب بالموْ","هُوبِ غَيْرِ الْمُخَسَّسِ المنْكُودِ",13,"د",1,0],["أمتعني دهرُها بغبطتِهِ","على الذي كان فيه من قصَرِ",14,"ر",1,0],["أمُتُّ بجودٍ من ودادٍ ومن شُكرِ","وأعلم أني قد مَتتُّ إلى حرِّ",15,"ر",1,1],["أمتعَه أفضلَ المتاع به","مُعطِيه إياه آخرَ الدهر",16,"ر",1,0],["أمَتَّ ما حيَّ من مَودَّتِنا","ظلماً فأعقِبْ من مأتم عُرُسا",17,"س",2,0],["أمتَّ وُديك عَبطةً فمَهٍ","دَعْهُ على رسله يمت هرما",18,"م",2,0],["أمتعهُ اللَّهُ بأعياده","في غِبطةٍ دائمةٍ ألفَ عامِ",19,"م",1,0],["أُمَّتي أينَ كُنْتُمُ إذْ دَعتْني","حُرَّةٌ من كرائمِ الأقوامِ",20,"م",1,0],["أَم تُرى ما زَعَموا زورا وَبُهتانا وَإِفكا","ضَحِكَت أَمواجُهُ مِنّي وَقالَت لَستُ أَدري",21,"ي",1,0],["أَم تُراهُ مَرَّ في نَفسي كَما أَعبُرُّ جِسراً","هَل رَأَتهُ قَبلَ نَفسي غَيرُ نَفسي لَستُ أَدري",21,"ي",1,0],["أَم تُراهُ بارِقاً أَومَضَ حينا وَتَوارى","أَم تُراهُ كانَ مِثلَ الطَيرِ في سِجنٍ فَطارا",21,"ر",2,0],["أَم تُراهُ اِنحَلَّ كَالمَوجَةِ في نَفسي وَغارا","فَأَنا أَبحَثُ عَنه وَهوَ فيها لَسُت أَدري",21,"ي",1,0],["أَم تُراني كُنتُ في إِحدى النُجومِ الزُهرِ","أَم أَريجاً أَم حَفيفاً لَستُ أَدري",21,"ي",1,0],["أَم تُرى تَحفَظُ وُدّي","مِثلَ ما أَحفَظُ وُدَّك",22,"ك",1,0],["أم تراها تطير في الموت عنا","مثل أسراب خلفها أسراب",23,"ب",1,0],["أَم تَراها في الخَوافي خَفِيَت","أَم مَقَرُّ الحَولِ في بَعضِ القُدامى",24,"م",2,0],["أَمُتُّ إِلَيكَ بِالذَمامِ الَّذي خَلا","وَمَنزِلَةٍ مِن جَعفَرٍ لَيسَ تُجحَدُ",25,"د",1,0],["أَم تُراني مُلاقِياً مِن قَريبٍ","سَكَناً لي أَشتاقُهُ مِن بَعيدِ",26,"د",1,0],["أَمُتَّخِذٌ عِندي الإِساءَةَ مُحسِنٌ","وَمُنتَقِمٌ مِنّي اِمرُؤٌ كانَ مُنعِما",27,"م",2,0],["أَم تَرى المَطلَ مُبقِياً لِيَ فَضلاً","مِن نَوالٍ أَنفَقتُ مِنهُ عَلَيهِ",28,"ي",2,0],["أَم تَنشَحَنَّ عَلى الحَربِ الَّتي جَرَمَت","مِنّي فُؤادَ اِمرِئٍ حَرّانَ مَهيُومِ",29,"م",1,0],["أُمتي ليس يُهزَمُ ال","فنُّ في أُمة الشّمَم",30,"م",1,0],["أُمَّتي ليس يخذلُ ال","جُودُ في أمة الكرَم",30,"م",1,0],["أُمَّتي أمة العلا","وأبي الهول والهرَم",30,"م",1,0],["أُمّتا هل سمعتني من قريبٍ","حيثُ لي في النياح صَرْخةُ قرمِ",31,"م",1,0],["أمتَّ عينَ صباحي","يوماً وعينَ رقيبي",32,"ي",1,0],["أَمَّتكَ وَالشَيطانُ يَرهَبُ ظِلَّها","فَأَتَتكَ وَهيَ تَفوقُ حِلمَ الأَحنَفِ",33,"ف",1,0],["أَمتَعتَ سَيفَكَ مِن يَدَيكَ بِضَربَةٍ","لا تُمَتِعُ الأَرواحَ بِالأَجسادِ",34,"د",1,0],["أَمَّت نَداهُ بِيَ العيسُ الَّتي شَهِدَت","لَها السُرى وَالفَيافي أَنَّها نُجُبُ",35,"ب",1,0],["أَمَّت غَداةَ رَحيلِها","وَالبَينُ ذو شُرُكٍ شِصاصُه",36,"ص",2,0],["أَمِت حُبَّها وَاِجعَل قَديمَ وِصالِها","وَعِشرَتِها أَمثالَ مَن لا تُعاشِرُ",37,"ر",1,0],["أم تلقَّى الوحيَ أم كان امرأً","جَهِلَ النّاسُ جميعاً وعَلِمْ",38,"م",1,0],["أُمٌّ تُدافعُ يَأسَها بَرجائِها","ما تَنقضِي الآمالُ في أَبنائِها",39,"ا",3,1],["امتلِئْ يا ابنَ أُبَيٍّ غَضَباً","ليس يَرضَى الحقُّ إن لم تَغضبِ",40,"ب",1,0],["أم تظنُّ الجواد تُمسكه الأر","ضُ وتلوي عنانه مسحورا",41,"ر",2,0],["أم تِلكَ لِلقَسَمِ المَبرُورِ من دَنِفٍ","أم ذِي لِعَاقِبَةٍ في الغيبِ قَد سَبَقَت",42,"ت",1,0],["أمُتَوَّجَ الخُلَفاءِ حاكِمْهُم وإنْ","كان القَضاءُ بما تشاءُ كَفيلا",43,"ل",2,0],["أمَتَّ بل استحيَيتَ والموتُ راغمٌ","كأنّكَ للآجَالِ خَصْمٌ مُماحِك",44,"ك",1,0],["أمّتْكَ بالأسْرى وفُودُ قبائلٍ","لا يَجتدينَكَ سَيْبَكَ الممنوحا",45,"ح",2,0],["أُمَّتا بَدَّدَ هَذا لُعَبي","وَوِشاحي حَلَّهُ حَتّى اِنتَثَر",46,"ر",1,0],["أَمتارُ مِن هَذا الأَنامِ وَكَيفَ لي","وَمِنَ الزَمانِ وَشَرِّهِ أَمتارُ",47,"ر",1,1],["أَمْ تُراكِ قَاتلَتي","بِالدَّلالِ والغَنَجِ",48,"ج",1,0],["أم تلكَ ليلى العامريّةُ أَسْفَرَتْ","ليْلاً فصيّرَتِ المساءَ صباحا",49,"ح",2,0],["أَم ترى في يد الطَبيعة لوحاً","نظر الروح نحوه مجلوب",50,"ب",1,0],["امتلأتْ من ذهبٍ أكياسُهُ","وقلبُهُ ممتلئٌ مِنْ دَغَلْ",51,"ل",1,1],["أُمُّ تحنُّ إلى لقاءِ نجيبها","وأبٌ هو الوطن المشوق الظامي",52,"م",2,0],["أم تلكَ عُقْبانُ السماءِ وثَبْنَ من","قُننِ الجبالِ على الخضمِّ النائي",53,"ا",2,0],["آمت سجاح ووالاها مسيلمة","كذابة في بني الدنيا وكذاب",54,"ب",1,1],["إمتى تعود لي وأقول","للكاس للندمان",55,"ن",1,0],["أَمَتّيني فَهَل لَكِ أَن تَرُدّي","حَياتي مِن مَقالِكِ بِالغُرورِ",56,"ر",1,1],["أم تُراك ادَكَرتَ مالك من ما","ضٍ قديمٍ مع الغواني الحِسَان؟",57,"ن",1,0],["أم تراني حسِبتُ زمزم يجري","ماؤها، حيثُ يلتقي الرَّفدان؟",58,"ن",1,0],["امتصَّهُ الناس حتى ما به رمَقُ","كأنَّهُ صب للإيثار تمثالاً",59,"ل",2,0],["أُمَّتَا بدد هذا لُعبي","ووشاحي حله حتى انتشر",60,"ر",1,0],["أم تظُن السماء في مهرجانٍ","لقريب من الملائك قادم",61,"م",1,0],["أم تُرى جاءت الشياطينُ تختصُّ","بروح مشكك متشائم",61,"م",1,0],["أم تُراني لبست فيها على حين","اندفاع مني لباسَ ذئاب ؟",62,"ب",1,0],["أمت إليك بالدمام الذي خلا","ومنزلة من جعفر ليس تجحد",63,"د",1,0],["أمْ تَنشَحَنّ على الحَرْبِ التي جَرَمتْ","مِني فُؤادَ امرِىءٍ حَرّانَ مَهْيُومِ",64,"م",1,0],["أَمِتْ حُبَّها وکجْعَلْ قَدِيمَ وِصَالِها","وعشرتها أمثالَ من لا تعاشر",65,"ر",1,0],["أمّ تحنّ إلى لقاء نجيبها","وأب ، هو الوطن الشوق الظّامي",66,"م",2,0],["أَمتع طَرفي في سُطور كَأَنَّها","مبادي عذار فَوقَ خَد مورد",67,"د",1,0],["أَمتع الطَرف مِني في مَحاسنه","وَلَيسَ عِندي مِن العُذال أَشعار",68,"ر",1,0],["أمتعُها فيه فإن تَكُ لوعةٌ","صَبرتُ وما ذمّ العواقبَ مَن صَبَر",69,"ر",1,0],["أم تبتغي أن يضيق ذرعي","فيشتكي قلبي الحمول",70,"ل",1,0],["أمتار لهواً بريئاً من مقاصفها","مع النواسي في ديوان بشار",71,"ر",1,0],["أم تضمَحِلُّ فما لها","عَودٌ ولا أملٌ وخُلدُ",72,"د",1,0],["أم تلك حورية بين الأنامِ وهل","في غير جناتِ عدنٍ تظهر العينُ",73,"ن",1,0],["أم تلك أقمار حسن قد أحاط بها","من حول نقطتها دارات هالات",74,"ت",1,0],["أَمَ