{"poems":[[55,"لأظما معلينا وأروى المصائبا","https://www.aldiwan.net/poem30735.html","الطويل"],[53,"ما رشأ الأنس بمستأنس","https://www.aldiwan.net/poem64702.html","الطويل"],[46,"نسائلها أي المواطن حلت","https://www.aldiwan.net/poem30567.html","الطويل"],[342,"ألا ناديا أظعان ليلى تعرج","https://www.aldiwan.net/poem45434.html","الطويل"],[382,"سر عجيب فيه معنى أعجب","https://www.aldiwan.net/poem66932.html","الكامل"],[445,"نور الوفاء بأرضنا لك ساطع","https://www.aldiwan.net/poem34838.html","الكامل"],[447,"أعد نظراً في السرب بالرمل من حزوي","https://www.aldiwan.net/poem14343.html","الطويل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110613","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201402","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204927","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108378",""],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85200","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119652","المتقارب"],[4978,"تشطير من الكفيل","https://www.poetsgate.com/ViewPoem.aspx?id=178201",""],[5397,"توارى محيا الشمس منك بحاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157938",""],[5435,"إليك انتهى مجد الخلافة والفخر","https://www.poetsgate.com/ViewPoem.aspx?id=188709",""],[6056,"مفهوم التميّز","https://www.poetsgate.com/ViewPoem.aspx?id=130345",""]],"verses":[["بِمَفقودَةٍ يَنهَلُّ ماءُ مُصابِها","دُموعاً عَلى خَدِّ الزَمانِ سَواكِبا",0,"ب",2,0],["بمُفضلٍ ما شئتَ من مُفضلٍ","ومُقبسٍ ما شِئتَ من مُقبِس",1,"س",1,0],["بِمُفعَمَةِ الأَنساعِ موجِدَةِ القَرا","أَمونِ السُرى تَنجو إِذا العيسُ كَلَّتِ",2,"ت",1,0],["بِمَفطوحَةِ الأَطرافِ جَدبٍ كَأَنَّما","تَوَقُّدُها في الصَخرِ نيرانُ عَرفَجِ",3,"ج",1,0],["بمفسر الأحلام يوسف عصره","في مصره قد جاء فيما يغرب",4,"ب",1,0],["بِمَفاخِرٍ من مُنْذِرٍ ومآثِرٍ","نُظِمَتْ بِمَنْطِقِهِ فَهُنَّ شوائِعُ",5,"ع",1,0],["بمفزة قتل المرافق جلعد","كأن بين شدقيها قد التهمت جروا",6,"و",2,0],["بمفيد العصر انس المستفيد","إذ غدا علامة في العلما",7,"م",2,0],["بمفترق السنين وقفت وحدي","برجِل في الشباب لها رسوخُ",8,"خ",1,1],["بمفترقٍ للطرق كانت ثلاثة","وقفت وفيما بينها حار بي الفكر",9,"ر",1,1],["بمفرقهِ لاح المشيب ودونه","بياض فعال بات في النفس باديا",10,"ي",2,0],["بمفرق شعره والحسن يبدي","صباحي والدجا من فوق هامه",11,"م",2,0],["بمفرد إيمانهم أرّخوا","سقاهم ربّهم شراباً طهورا",12,"ر",2,0],["بِمُفاوضاتٍ فَوقَ مَسرَحِ قَهْرِنا","(وشعارها ما ثمّ عن ذلٍّ بديل)",13,"ل",1,0],["بمفخر ذي الحوضين هاشم هاشم","من العرب العرباء صيد العصائب",14,"ب",1,0],["بمفرقك التاج استطال ترفعا","وليس عليه في ترفعه خطر",15,"ر",1,0],["بمفهوم التميّز سطّرت معنى الشعر يمناي","متى ما أبدعت بالمنظوم يقرأ قافي العميان",16,"ن",1,0]]}