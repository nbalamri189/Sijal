{"poems":[[79,"يا أديبا أزرى بكل أديب","https://www.aldiwan.net/poem36753.html","الخفيف"],[73,"يا أدباء الزمان إني","https://www.aldiwan.net/poem3892.html","مخلع البسيط"],[95,"يا أديباً إليه كل أديب","https://www.aldiwan.net/poem11075.html","الخفيف"],[95,"يا ابن لبنان عد إلى لبنان","https://www.aldiwan.net/poem11175.html","الخفيف"],[74,"يا أديبا في نظمه لا يجارى","https://www.aldiwan.net/poem19057.html","الخفيف"],[74,"لثمت ثغر عذولي حين سماك","https://www.aldiwan.net/poem19438.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54948","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43915","الرمل"],[215,"مات رشدي مات آها ثم آه","https://www.aldiwan.net/poem46636.html","الرمل"],[408,"يا أديبا لا يداني شأوه","https://www.aldiwan.net/poem46445.html","الرمل"],[435,"جاءت الأفراح بالبشرى على","https://www.aldiwan.net/poem41021.html","الرمل"],[457,"يا أديباً يبدي من الأدب الغض","https://www.aldiwan.net/poem13684.html","الخفيف"],[482,"أعيا العواذل ما عندي من الكلف","https://www.aldiwan.net/poem15214.html","البسيط"],[482,"ربع وقفت عليه بعد أهليه","https://www.aldiwan.net/poem15251.html","البسيط"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101506","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48862","الخفيف"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90566","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55953","الرمل"],[2038,"","https://poetry.dctabudhabi.ae/diwan/poem/123686","الخفيف"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137446",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137464",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93907","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93916","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93896","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65490","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108311","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81252","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136604",""],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104949","السريع"],[4578,"ما عقودٌ في طلى الغيد الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=49380",""],[4859,"ومحوت أمسك!","https://www.poetsgate.com/ViewPoem.aspx?id=196583",""],[5129,"وجع النوى","https://www.poetsgate.com/ViewPoem.aspx?id=151605",""],[5183,"لغة العز","https://www.poetsgate.com/ViewPoem.aspx?id=180218",""],[5268,"في فؤادكِ موطنٌ","https://www.poetsgate.com/ViewPoem.aspx?id=207011",""],[5364,"إدلب الخضراء","https://www.poetsgate.com/ViewPoem.aspx?id=177167",""],[5452,"صدام","https://www.poetsgate.com/ViewPoem.aspx?id=119185",""],[6318,"مهرجان القصيد (1)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66156&r=&rc=6",""]],"verses":[["يَا أَديِباً أَزْرَى بِكُلِّ أَدِيبِ","ضَرَبُ الشُّهْدِ أَنْتَ دُونَ ضَرِيبِ",0,"ب",1,1],["يا أُدَباءَ الزَمانِ إِنّي","أَعجَزَني لِلعَويصِ كَشفُ",1,"ف",1,1],["يا أديباً إليه كل أديب","راجع يوم حجة وبيان",2,"ن",1,1],["يَا أَدِيباً إِلَى النُّفُوسِ يُؤَدِّي","بِأَرَقِّ الأَلفَاظِ أَخْفَى المَعَانِي",3,"ن",2,0],["يا أديباً في نظمِه لا يُجارى","وعلى طرقِ لغزه لا يُماشى",4,"ش",2,1],["يا أدمعاً ليَ قد أنفقتها سرَفاً","ما كانَ عن ذا الوفا والبرّ أغناك",5,"ك",1,0],["يَا أَدِيبَ الدنَّيَا تُحَيِّيْكَ مِصْرُ","صِلَةُ الفَضْلِ فِي أُولِي الفَضْلِ إِصْرُ",6,"ر",1,1],["يا أديباً ملكتني","في يديه المكْرُماتُ",7,"ت",1,1],["يا أديباً روحه روح الملوك","وهو للشعر وللدمع سفوك",8,"ك",1,0],["يا أديباً لا يُداني شأوَهُ","في المعالي مَنْ دَنا أو مَن شَحطْ",9,"ط",1,1],["يا أديبا دم بما قد نلته","بغلام من كريم حزنه",10,"ه",1,0],["يا أديباً يبدي من الأدب الغض","ضِ رياضاً موشيّة الديباج",11,"ج",1,1],["يا أدمعي ن حدَّثي بعدَ الفراقِ بما","عندي ونُمَّي بأسرارِ الهوى وصِفي",12,"ف",2,0],["يا أدمعي هذه اِلأطلالُ ماثلةٌ","فأين دمعٌ يُروِّي السُّحبَ هاميهِ",13,"ي",2,0],["يا أديباً يعلو سنًى وسناءَ","واريبا يسمو ذُكاءَ ذكاءَ",14,"ا",2,1],["يا أديب الزمان تهنئة بال","سود تلقاه من عظيم الزمانِ",15,"ن",1,1],["يا أديباً منه المقالُ يَسُرُّ","وهو مِن كلِّ يَسرُّ أسَرُّ",16,"ر",1,1],["يا اديباً فُزْ بما قد نلتهُ","بغلامٍ من كريم حزتهُ",17,"ه",1,0],["يا أديب الزمان لطفاً ويا من","لفظه جوهر يفوق الصحاحا",18,"ح",2,0],["يا أدمعي هذا زمانك فاسكبي","ودعى مقالة لائم ومؤنب",19,"ب",1,1],["يا أديبا حاز فضلا في الورى","وكساه الله جلباب السعود",20,"د",1,1],["يا أديباً حررت شعراً رقيقاً","علل الروح روحه المستطاب",21,"ب",1,0],["يا أديباً قد فاق كل أديب","رب نوع علا على الأنواع",22,"ع",1,0],["يا أديباً أهدى قوافي نظم","منه فيها له عليه دليل",23,"ل",1,0],["يا أديبا حويت نظما بليغا","ولسانا يفوقُ مسك اللطّائم",24,"م",1,0],["يا أديباً يستوحش الطرس والاق","لام منه إلى البنان الرطيب",25,"ب",1,0],["يا أديباً ساد في دُرّ اللفاظ","يا أريباً فاق قِسّاً في عكاظ",26,"ظ",1,0],["يا أَديباً مُضيعاً مِن بَني الدُنيا","بِحَسب الأَديب مَحض اِنتِجاعه",27,"ع",2,0],["يا أدمعي لو بلغ السيلُ الزُبى","هيهات أن تُطفئ فيك الغلل",28,"ل",1,0],["يا أدباء العصر ما موضع","أوله نصف لثانيه",29,"ي",2,1],["يا أديباً انتجت أفكاره","كل بكر ما حماها مستباح",30,"ح",1,0],["يا أدمعاً لمشاعريْ انسكبتْ","ياجرحَ خلٍّ لم يزل حيّا",31,"ي",2,0],["يا ادلبُ اخضرَّت الأحلامُ وازدهرتْ","على تلالكِ قامَ الحلمُ ينتَجِعُ",32,"ع",1,0],["يا أديب الزمان يا واحد الشع","ر هنيئاً لك الفخار المخلد",33,"د",1,0],["يا أدمُعي الثَّكلى إذا بُحنا لها","بالشَّوقِ يأخُذُها الغرورُ فَتَهجُرُ",34,"ر",1,0],["يا ( إدلب الخضراء ) يا درررة الكون","دونك رجال (مخضبين) الأيادي",35,"د",2,0],["يا أدمعا ذرفت في رونق السّحر","وللشّروق نواح حينما احتضرا",36,"ر",2,0],["يا أَديبَ الإِسْلامِ أَيْنَ السَّرَايا","نَزَعَتْ عن مَضَاجِعٍ وَ مُهُودِ",37,"د",1,0]]}