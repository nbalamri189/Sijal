{"poems":[[77,"يا أديبا أزرى بكل أديب","https://www.aldiwan.net/poem36753.html","الخفيف"],[71,"يا أدباء الزمان إني","https://www.aldiwan.net/poem3892.html","مخلع البسيط"],[93,"يا أديباً إليه كل أديب","https://www.aldiwan.net/poem11075.html","الخفيف"],[93,"يا ابن لبنان عد إلى لبنان","https://www.aldiwan.net/poem11175.html","الخفيف"],[72,"يا أديبا في نظمه لا يجارى","https://www.aldiwan.net/poem19057.html","الخفيف"],[72,"لثمت ثغر عذولي حين سماك","https://www.aldiwan.net/poem19438.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54948","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43915","الرمل"],[211,"مات رشدي مات آها ثم آه","https://www.aldiwan.net/poem46636.html","الرمل"],[402,"يا أديبا لا يداني شأوه","https://www.aldiwan.net/poem46445.html","الرمل"],[429,"جاءت الأفراح بالبشرى على","https://www.aldiwan.net/poem41021.html","الرمل"],[452,"يا أديباً يبدي من الأدب الغض","https://www.aldiwan.net/poem13684.html","الخفيف"],[477,"أعيا العواذل ما عندي من الكلف","https://www.aldiwan.net/poem15214.html","البسيط"],[477,"ربع وقفت عليه بعد أهليه","https://www.aldiwan.net/poem15251.html","البسيط"]],"verses":[["يَا أَديِباً أَزْرَى بِكُلِّ أَدِيبِ","ضَرَبُ الشُّهْدِ أَنْتَ دُونَ ضَرِيبِ",0,"ب",1,1],["يا أُدَباءَ الزَمانِ إِنّي","أَعجَزَني لِلعَويصِ كَشفُ",1,"ف",1,1],["يا أديباً إليه كل أديب","راجع يوم حجة وبيان",2,"ن",1,1],["يَا أَدِيباً إِلَى النُّفُوسِ يُؤَدِّي","بِأَرَقِّ الأَلفَاظِ أَخْفَى المَعَانِي",3,"ن",2,0],["يا أديباً في نظمِه لا يُجارى","وعلى طرقِ لغزه لا يُماشى",4,"ش",2,1],["يا أدمعاً ليَ قد أنفقتها سرَفاً","ما كانَ عن ذا الوفا والبرّ أغناك",5,"ك",1,0],["يَا أَدِيبَ الدنَّيَا تُحَيِّيْكَ مِصْرُ","صِلَةُ الفَضْلِ فِي أُولِي الفَضْلِ إِصْرُ",6,"ر",1,1],["يا أديباً ملكتني","في يديه المكْرُماتُ",7,"ت",1,1],["يا أديباً روحه روح الملوك","وهو للشعر وللدمع سفوك",8,"ك",1,0],["يا أديباً لا يُداني شأوَهُ","في المعالي مَنْ دَنا أو مَن شَحطْ",9,"ط",1,1],["يا أديبا دم بما قد نلته","بغلام من كريم حزنه",10,"ه",1,0],["يا أديباً يبدي من الأدب الغض","ضِ رياضاً موشيّة الديباج",11,"ج",1,1],["يا أدمعي ن حدَّثي بعدَ الفراقِ بما","عندي ونُمَّي بأسرارِ الهوى وصِفي",12,"ف",2,0],["يا أدمعي هذه اِلأطلالُ ماثلةٌ","فأين دمعٌ يُروِّي السُّحبَ هاميهِ",13,"ي",2,0]]}