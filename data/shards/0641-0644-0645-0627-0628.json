88887",""],[5290,"لعل نسيمات الضحى والأصائل","https://www.poetsgate.com/ViewPoem.aspx?id=113131",""],[5398,"أبنيتي","https://www.poetsgate.com/ViewPoem.aspx?id=37123",""],[5431,"بصبر الصالحين شفاء جرحي","https://www.poetsgate.com/ViewPoem.aspx?id=187206",""],[5582,"أَلا حَدِّثا عَنْ عَهْدِ ناقِضَةِ العَهْدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186936",""],[5582,"ألا غَنِّنا بالعامِرِيَّةِ وَاطْرَبِ","https://www.poetsgate.com/ViewPoem.aspx?id=186673",""],[5616,"وداعاً أبا أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=203501",""],[5691,"رسالة التعليم","https://www.poetsgate.com/ViewPoem.aspx?id=206587",""],[5845,"أفقْ هديتَ منَ التبرجِ والكمدِ","https://www.poetsgate.com/ViewPoem.aspx?id=198482",""],[5884,"أغالب فيه الشوق والشوق غالبي","https://www.poetsgate.com/ViewPoem.aspx?id=124749",""],[6069,"بعثت الكتاب فأهلاً به","https://www.poetsgate.com/ViewPoem.aspx?id=105695",""],[463,"نعم هذه يا دهرُ أمُّ المصائبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59966&r=&rc=22",""],[2220,"نهضتُ إلى نفسي لأعرفَ خالقي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11678&r=&rc=552",""]],"verses":[["فلمّا بدَتْ للرّاحِ فيهِ ارْتياحَةٌ","ومالَتْ شَمالٌ للشَّمولِ بقَدِّهِ",0,"د",2,0],["فَلَمّا بَدَت في الكَونِ آياتُ ظُلمِهِم","إِذا بِسَدومٍ في حُكومَتِهِ عُمَر",1,"ر",1,0],["فَلَمّا بَدا ضَوءُ الصَباحِ لِناظِري","خَرَجتُ وَقَد أَوسَعتُ صاحِبَها شَكرا",2,"ر",2,0],["فَلَمّا بَدا حَورانُ وَالآلُ دونَهُ","نَظَرتَ فَلَم تَنظُر بِعَينَيكَ مَنظَرا",3,"ر",2,0],["فَلَمّا بَكَتهُ الصالِحاتُ بِعَدلِهِ","وَما فاتَها مِنهُ بَكَتهُ بُطونُها",4,"ن",3,0],["فَلَمّا بَلَغنَ المُنتَضى بَينَ غَيقَةٍ","وَيَليَلَ مالَت فَاِحزَأَلَّت صُدورُها",5,"ر",3,0],["فَلَمّا بَدا في اللَيلِ ضَوءٌ كَأَنَّهُ","وَإِيّاهُ قَوسُ المُزنِ وَلّى ظِلالُها",6,"ل",3,0],["فَلَمّا بَدَت كَفَّنتُها وَهيَ طِفَلةٌ","بِطَلسآءَ لَم تَكمُل ذِراعاً وَلا شِبرا",7,"ر",2,0],["فلمّا بكى أمسكت فَضلِ ردائه","وكفكفت دمعاً فوق خَدَّيْه جاريا",8,"ي",2,0],["فَلَم أبلُغ بِهِم لَعنَاً وَلَكِن","أسَاءَ بِذَاكَ أوَّلهُم صَنِيعَا",9,"ع",2,0],["فَلَمّا بَعُدتُ بَدَت جَفوَةٌ","وَلاحَ مِنَ الأَمرِ ما لا أُحِب",10,"ب",1,0],["فَلَمّا بَدَت لَكَ دونَ البُيوتِ","بَدا لَكَ مِنهُنَّ جَيشٌ لَجِب",11,"ب",1,0],["فلما بدا مع أسود الشعر أبيضٌ","أتى العشق يغزوني على ألف أبلق",12,"ق",1,0],["فلم أبرحْ صريع هوىً كأنِّي","شربتُ به معتَّقة مُداما",13,"م",2,0],["فَلَما بَدا لِلناسِ صُبحٌ مِنَ المُنى","وَأَبصَرَ فيهِ ذو البَصيرَةِ وَالأَعمى",14,"م",2,0],["فلمّا بَدا الصُّبْحُ قامَ الوَصِيُّ","فَأَقْبَلَ كُلٌّ لهُ يَعْذُلُ",15,"ل",1,0],["فَلَمّا بَدَوتَ لِأَصحابِهِ","رَأَت أُسدُها آكِلَ الآكِلِ",16,"ل",1,0],["فَلَم أُبعِدكَ مِن أَدَبٍ وَلَكِن","شِهابٌ في التَخَلُّفِ ما شِهابُ",17,"ب",1,0],["فَلَمّا بَلَغنا أَرجَعَ اللَهُ رِحلَتي","وَشُقَّت لَنا كَفٌّ تَفيضُ بُحورُها",18,"ر",3,0],["فَلَمّا بَدَت ساقُ الجِواءِ وَصارَةٌ","وَفَرشٌ وَحَمّاواتُهُنَّ القَوابِلُ",19,"ل",1,0],["فَلَمّا بَدا لي أَنَّني لَستُ واصِلاً","إِلى لَذَّةٍ إِلّا بِأَضعافِها تَعَب",20,"ب",1,0],["فَلَمّا بَدا لي مِنكَ لُؤمٌ يَحُفُّهُ","حِرُمِّيَّةٌ يَستَنُّ فيها التَبَظُّمُ",21,"م",1,0],["فلما بلغت القبر خرت لوجهها","تضج وتشكو من تباريحها الجهدا",22,"د",2,0],["فَلَمّا بَدَت شُمُّ الحُصونِ وَأَشرَقَت","لَياجُ وَماجَ الجَيشُ يَدنو وَيَبعُدُ",23,"د",1,0],["فَلَمّا بَلَغَت السِّنَ وَالغايَةَ الَّتي","إِليها مَدى ما كُنتُ فيكَ أُؤَمِلُ",24,"ل",1,0],["فَلَمّا بَراني الهَمُّ وَالحُزنُ حِقبَةً","وَأَشفَقتُ مِن خَوفِ الَّذي كُنتُ آمَلُ",25,"ل",1,0],["فَلَما بَدا لي أَنَّها مُستَفِزَّةٌ","قَد اضرَمَها الواشي عَلَيَّ وَأَوقَدا",26,"د",2,0],["فَلَمّا بَلَغنا جانِبَ المَوعِدِ الَّذي","وُعِدتُ بِهِ أَقَللتُ أَن أَتَلَدَّدا",26,"د",2,0],["فَلَمّا بَدا جَرسٌ مِنَ ليلِ وَاِحتَوَت","كِلابَ الرِعاءِ المُوسَداتِ المَواقِدُ",27,"د",1,0],["فَلَمّا بَدا لي اليَأسُ عَدَّيتُ ناقَتي","عَنِ الدارِ وَاستَولى عَلَيَّ عَزائي",28,"ي",1,0],["فَلَمّا بَيَّنَتني النارُ حَيّا","تَحِيَّةَ وامِقٍ لَطِفِ السُؤالِ",29,"ل",1,0],["فَلَمّا بايَعوا وَتَنَصَّفونا","وَعادَ الأَمرُ فينا وَالإِمارُ",30,"ر",1,0],["فَلَم أُبقِ عَلى النَفسِ","وَلَو أَسطيعُ أَبقَيتُ",31,"ت",1,0],["فَلَمّا بَدا وَجهُ الزِماعِ وَراعَهُ","مِنَ اللَيلِ وَجهٌ يَمَّمَ الماءَ قارِبُه",32,"ب",2,0],["فَلَمّا بدا صبح وَشاعَت فجيعة","وَصاحَ بها الناعون وَالناس أَسرَعوا",33,"ع",3,0],["فَلَمَّا بَدَتْ أَرْضُ العَدُوِّ سَقَيْتَها","مُجاجَ بَقِيّاتِ المَزادِ المُقَيَّرِ",34,"ر",1,0],["فلمَّا بَدا فيهِمْ سُلَيْمانُ عِنْدَها","وصاحَ ابْنُ ذَكْوانٍ فثارَ رِجالُ",35,"ل",1,1],["فَلَمَّا بَرَانِيَ حَرُّ الضُّحَى","وَأَدْرَكَنِي فِي الطَّوَافِ العَيَاءْ",36,"ا",2,0],["فَلَمَّا بَانَ جَدَّتْ فِي أَناتِي","مَآتِمُهُمْ وَأَقْلَقتِ الضُّلُوعَا",37,"ع",2,0],["فَلَمّا بَكَيتُ وَأَبكَيتُهُنَّ","تَمَنَّيتُكُم أَن تَكونوا قَريبا",38,"ب",2,0],["فَلَمّا بَدا لي أَنَّهُ قَدر الرَدى","تَداوَيتُ بِالذِكرى مِنَ الهَذَيانِ",39,"ن",1,0],["فلما بدا فيه سليمان عندها","وصاح ابن ذكوان فثار رجال",40,"ل",1,1],["فلمَّا بدتْ لكَ فوقَ البيوتِ","بدا لكَ منهنَّ جيشَ لجبْ",41,"ب",1,0],["فلما بدت شم الحصون وأشرفت","لياج وماج الجيش يدنو ويبعد",42,"د",1,0],["فَلَمّا بَدَتْ حَوْرَانُ في الآلِ دونها","نظرتَ فلم تنظر بعينيك منظرا",43,"ر",2,0],["فلما بدت لي نفرة الغدر منكم","رضيت بما تقضي به وهو جائر",44,"ر",1,0],["فلما بدا صرمى وغودِرتُ مولعا","بأظعانها حيرانَ نَفسٍ حَزِينَها",45,"ه",2,0],["فَلَمّا بَكى وَالعيسُ قَد قَلُصَت بِنا","وَقَد ناشَ بِالكَفّينِ ثِنيَ زِمامِ",46,"م",1,0],["فلما بدا لي حسنها وجمالها","ولهت فلم الق من عشقها بدا",47,"د",2,0],["فلما بدا خروا سجودا لربهم","يرون سجود الشكر حينئذ نسكا",48,"ك",2,0],["فلما بنيت الفص طالت به التي","جمعت لها حبا إلى حسنها الحصنا",49,"ن",2,0],["فلمّا بَدا من بعدهم ضعفُ دينِنا","ضَعُفنا فلَم يشدُد بِنا دينُنا أزرا",50,"ر",2,0],["فلّما بدا وجُه الصَّباحِ وأَقبلَتْ","تَكُرُّ على وَفْدِ الظّلامِ قنابِله",51,"ل",2,0],["فلمَّا بلغت المِنبر الطاهر الّذي","له بك فضلٌ لا يُنال كبير",52,"ر",1,0],["فَلَمّا بَلَغنا الأُمَّهاتِ وَجَدتُمُ","بَني عَمِّكُم كانوا كِرامَ المَضاجِعِ",53,"ع",1,0],["فَلِم أُبعَدُ مَع فَضلي","وَغَيري عِندَكُم قُرِّب",54,"ب",1,0],["فلما بلغنا طيبة وربوعها","شممنا شذى يزري بعرف العنابر",55,"ر",1,0],["فَلَمّا بَغَاهَا نَفسَهَا غَضِبَتْ لهَا","عرُوقٌ نمَتْ وَسطَ الثرَى فاستَقرّتِ",56,"ت",1,0],["فَلَمْ أَبْلُغْ بِمَدْحِى رَأْسَ مَالي","فَلَسْتُ مُصَدِّعاً رَأْسِي بِمَدْحِ",57,"ح",1,0],["فَلَمّا بَدا حَزمُ القَنانِ وَصارَةٌ","وَوازَنَّ مِن شَرقِيِّ سَلمى بِمَنكِبِ",58,"ب",1,0],["فَلَمّا بَدَا دَمخٌ وَأَعرَضَ دونَهُ","عَوازِبُ مِن رَملٍ تَلوحُ شَواكِلُه",59,"ل",2,0],["فلمّا بدَتْ تلك المواكبُ طُلّعاً","وفيها النّدى والبَأْسُ مُكتَنِفاكا",60,"ك",2,0],["فلمّا بدا من سوادِ العراقِ","لأعيُنهنَّ بَياضُ الصَّوى",61,"ا",1,0],["فَلَمّا بَدا طَفِقتُ هَيبَة","تُستِّرُ أَحداقَها بِالهَدَب",62,"ب",1,0],["فلم أبلْ ما دمت خلاًّ له","ما كانَ من أمري ولا كيف صار",63,"ر",1,0],["فلمّا بلغنا ظِلَّ وارفِ دَوْحِها","ومنسابِ صافي مائِها المترقرقِ",64,"ق",1,0],["فلمّا بدا لِي الشرُّ في كَرِّ قوله","ربطتُ نَوازِي أضلعي بالرواجِبِ",65,"ب",1,0],["فَلَمّا بَدا لي أَنَّهُ لاعِجُ الأَسى","وَأَن لَيسَ إِلّا الدَمعُ لِلحُزنِ شافِيا",66,"ي",2,0],["فَلمَّا بَدَا وَاشِي الصَّبَاحِ بِوَشْيِهِ","وَنِيطَ عَلَيْنَا مِنْ يَدِ الجَوِّ بُرْدُهُ",67,"د",2,0],["فلمّا باتَ بِتُّ له فِراشا","وباتا ساعِديَّ لَه وِسادا",68,"د",2,0],["فلمّا بدا صبحٌ يَلوحُ تَكشَّفت","له قِطَعٌ من حالكِ اللونِ أسوَدا",69,"د",2,0],["فَلما بَدا في أُفقهم وَهوَ مُظلم","تَوارى ذَكاهُم في خِلال السَحائب",70,"ب",1,0],["فلما بلغْتُمْ نيلَ ما قد أردْتُمُ","وطابَ لكم منا المشاربُ والأكلُ",71,"ل",1,0],["فَلَمّا بَدا لِيَ مِنها البَذا","ءَ صَبَّحتُها بِثَلاثٍ عِجالِ",72,"ل",1,0],["فَلَما بَرّز الأُسطول فَرّت","جُيوش الكُفر في البَحر اِنسِرابا",73,"ب",2,0],["فلما بدا حِرمانُها الضيفَ لم يكُن","عليّ مُناخُ السوءِ ضَربَةَ لازِبِ",74,"ب",1,0],["فلمّا بدا ضَوءٌ من الصبحِ ساطعٌ","عصى خُلَّةً لم ينجُ إِلاَّ قرينُها",75,"ن",3,0],["فَلَم أُبصر به بعد ال","ملا إلّا أثافيهِ",76,"ي",2,0],["فَلمّا بَدا وَخط المشيبِ وقاضَني","منَ الوحلِ بالهجرانِ منها وبالصدِّ",77,"د",1,0],["فلما بنت نكرت الليالي","قريب الدار والأقصى الغريبا",78,"ب",2,0],["فلما بززناها الثياب تبيّنت","طماحَ غلامِ قد أجدّ به النفرُ",79,"ر",1,0],["فلما بَدَت أطرافُ ريشٍ كأنه","مبادِي نباتٍ غبَّ قَطرٍ تَشَرَّفا",80,"ف",2,0],["فلمّا بَدا شَيبُ العِذار تطلّبت","علي