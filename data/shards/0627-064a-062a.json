em.aspx?id=212227",""],[402,"أيتم أنس أم يطيب ترنم","https://www.poetsgate.com/ViewPoem.aspx?id=36198",""],[5794,".. وطن","https://www.poetsgate.com/ViewPoem.aspx?id=122798",""],[5855,"أَيتُ العِزَّ في أَدَبٍ وعِلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=189797",""],[5897,"يوم عالمي للمرأة ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=176830",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[5956,"حُبُّ جَدَّينِ لحفيدهما الأصغر","https://www.poetsgate.com/ViewPoem.aspx?id=213232",""],[6052,"هزة الضمير","https://www.poetsgate.com/ViewPoem.aspx?id=34893",""],[6056,"اقول معصي","https://www.poetsgate.com/ViewPoem.aspx?id=130136",""],[6056,"خصلتين ٍ فوق خدّه","https://www.poetsgate.com/ViewPoem.aspx?id=130327",""],[6056,"موت اإحساس","https://www.poetsgate.com/ViewPoem.aspx?id=130361",""],[6084,"عز الهدى والندى والعلم والعلما","https://www.poetsgate.com/ViewPoem.aspx?id=170871",""],[6102,"ساق !!","https://www.poetsgate.com/ViewPoem.aspx?id=184410",""],[6102,"عودة اضطرارية","https://www.poetsgate.com/ViewPoem.aspx?id=184458",""],[6305,"وَشَيْطانٍ يُقاسِمُني نَصِيبي !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87329&r=&rc=2",""],[6358,"دخان الخرائط","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77584&r=&rc=43",""]],"verses":[["إِئتِ مِن بَغدادَ بابَ ال","شامِ أو نَهرَ المُعَلّى",0,"ل",2,0],["أَيَّتُها النَفسُ إِلَيهِ اِذهَبي","فَما لِقَلبي عَنهُ مِن مَذهَبِ",1,"ب",1,1],["أَيْتَمْتَ وُلْداً نَاعِماً أَظْفَارُهُمْ","حُرِمُوا حُنُوَّ أَبٍ عَلَيْهِمْ حَانِي",2,"ن",2,0],["أيتها الأرض قفي واسلمي","من أجل هذا المشهد الزاهر",3,"ر",1,0],["أيتركون الذي قد كنت تطلبه","أم هم سيقضون من مطلوبك الوطرا",4,"ر",2,0],["أي تاجٍ وللأهلة في الأف","ق قسيّ ترمي الورَى بنبال",5,"ل",1,0],["أيتمهم بعدي وإني على","بابك لاهٍ في جنان النعيم",6,"م",1,0],["إيتاءُ عاف وإتيانُ ابن مكرمةٍ","منه نوالٌ ومن عافيه غِشيان",7,"ن",1,0],["أيتها النفس اقترب","فراق أبطال الأدب",8,"ب",1,1],["اِئتِلافُهُ رَشَدٌ","وَاِختِلافُهُ سَدَدُ",9,"د",1,0],["إِئتِ بِالعُمرانِ رَوضاً يانِعاً","وَاِدعُها تَجرِ يَنابيعَ عِذابا",10,"ب",2,0],["أَيَترُكُ الأَرضَ جانوها وَلَيسَ بِها","صَحيفَةٌ مِنكَ في الجانِبَينِ سَوداءُ",11,"ا",2,0],["أَيُتلِفُ يَعقوبُ مالي لَدَي","هِ وَيَعقوبُ مُتَّئِدٌ لَم يُهَج",12,"ج",1,0],["أَيَترُكُ ما كانَ مُستَخفِياً","فَكَيفَ بِتَركِ الَّذي قَد ظَهَر",13,"ر",1,0],["إيتِ الأُمورَ وَأَنتَ تُبصِرُها","لا تَأتِ ما لَم تَدرِ ما سَبَبُه",14,"ب",2,0],["إيتِ القُبورَ فَنادِها أَصواتاً","فَإِذا أَجَبنَ فَسائِلِ الأَمواتا",15,"ت",2,1],["أَيتُهُ كَالهِلالِ يَبدو","وَوَجهُهُ مُشرِقٌ بِلالا",16,"ل",2,1],["أَيتَموا الأَطفالَ في الحَر","بِ وَهُم كَهفُ اليَتاما",17,"م",2,0],["إِئتِ هِنداً فَقُل لَها","لَيلَةَ الخَيفِ ذي سَلَم",18,"م",1,0],["إِئتيهِ بِاللَهِ وَقولي لَهُ","وَاللَهِ لا يَفعَلُهُ ثُمَّ لا",19,"ل",2,0],["أَيَترُكُ لَونَهُ لا ضَوءَ فيهِ","وَيَكسو الشَمسَ وَالقَمَرَ البَريقا",20,"ق",2,0],["أَيَّتُها النَفسُ لا تُهالي","شَرخي قَد مَرَّ وَاِكتِهالي",21,"ل",2,1],["أَيَّتُها النَفسُ أَجمِلي جَزَعا","إِنَّ الَّذي تَحذَرينَ قَد وَقَعا",22,"ع",2,1],["أيُّ تعذيبٍ سوى البُعْدِ لنَا","منكِ عذبٌ حبّذا ما بَعْدَ أي",23,"ي",1,0],["ائتِ ما شئته ولا تخشَ بأساً","لا حرامٌ فيها ولا محظور",24,"ر",1,0],["أيتها النفس لا تخافي","فإنما الموت قد يفيد",25,"د",1,0],["ائتمناه على السر","رِ فأفشى بعد حين",26,"ن",1,1],["أيَّتُها المحزونةُ الباكيهْ","لا تيأسي من رحمةِ المنْقِذِ",27,"ذ",1,0],["أيَّتُها الأيام ما تصنعينْ","بذلك العبءِ الذي تحملينْ",28,"ن",1,1],["أيّتُها الملكةُ الكسيرهْ","أيّتُها الربّةُ الخجولهْ",29,"ه",1,0],["أيّتُها الطفلةُ الكبيرهْ","لن تبرحي عالمَ الطفولهْ",29,"ه",1,0],["أيّتُها الغُورُ والبِطاحُ","أيّتُها الشهبُ والجبالُ",29,"ل",1,0],["ائتمرت في الندوة الأعيان","وانتدبت للفتكة الفتيان",30,"ن",1,0],["أَيُّ تُفَّاحٍ ورمَّانِ","يُجتنَى من خُوطِ رَيْحانِ",31,"ن",1,1],["أَيَتِم أُنْسٌ أمْ يَطِيبُ تَرَنمٌ","إلاَّ إذَا كَانَ المُرَجِّعُ سَامِي",32,"م",2,1],["أَيَتِنَا أَنْجُماً فِي الرَّوْضِ طَالِعَةً","أَبْهَى بِأَعْيُنِنَا مِنْ أَنْجُمِ الأُفقِ",33,"ق",1,0],["أَيَتِيمَةٌ تَهْوي وَرَاءَ يَتيمَةٍ","منْ ذلكَ العقْدِ الكَريم الفاخِرِ",34,"ر",1,0],["أَيْتَمْتِهَا كَرْهاً وَلَمْ","تَشْفِي الحَشَى مِنْهَا وِصَالَا",35,"ل",2,0],["أَيُّ تَاجَيْهِمَا هُوَ العَدْلُ وَالرَّحْ","مَةُ لِلْمُسْتَضَامِ وَالمَنْكُودِ",36,"د",1,0],["اَيُّ تَاجَيْهِمَا عَلَى الدَّهْرِ عُنْ","وَانُ الْهُدَى وَالْفِدَى وَعَتْقُ الْعَبِيدِ",36,"د",1,0],["أَيُّ تَعْسٍ كَتَعْسِ دَارٍ عَلَيْهَا","يَتَوَالَى الفَسَادُ بَعْدَ الفَسَادِ",37,"د",1,0],["أَيُّ تَقْوَى وَأَيُّ دِينٍ وَدُنْيَا","حَمَلَتْ نَعْشَهُ عَلَى الأَعْنَاقِ",38,"ق",1,0],["أيتها الفتانةُ الصغيره","أنتِ بتاج ملكٍ جديره",39,"ه",1,1],["أيتها الأميره!","نريد منك رقصة...",40,"ه",1,0],["أيتها الأميرهْ!","أرقصُ... كالفراشة الصغيره",40,"ه",1,0],["َأيتُ حُسَاماً فِي ذَرَى عَامِر وَقَد","كَسَاهُ بَيَاضاً خَوفَ أن يَتَغَيَّرَا",41,"ر",2,1],["آيتا العرب في ندىً وزِحام","طيِّبوا ذكركم ، وموتوا كراما",42,"م",2,0],["إيتني...وادخل القلبي ياقلبي...باب باب","واخطر عروقي برجليك يا اسمر دوب دوب",43,"ب",1,0],["إيتني واذهب بي بعيد...يامال الذهاب","ضمني بايديك أبجمد على صدرك واروب",43,"ب",1,0],["أيتك ما كان مستخفياً","فكيف بترك الذي قد ظهر",44,"ر",1,0],["أيتلفُ هذا البريقُ العجيب","كما سوف تتلف أعضاؤنا",45,"ن",2,0],["إيتيهِ بِکللَّهِ وَقولي لَهُ:","واللهِ، لا يفعلهُ، ثمّ لا",46,"ل",2,0],["إيتنا قَدْ كَسَدَتْ","سُوقُ اللَّذاذاتِ لِتَنْفَقْ",47,"ق",1,0],["أيتها المرأة لا تقلقي","من قبل أن تستعملي الصوره",48,"ر",2,0],["أيَّتها الثَّكلَى الَّتي من دُمُوعِها","إذا هيَ ناحَت للقَتيل مآتِمُه",49,"م",2,0],["أيُترَكُ سرٌّ بعدَ سرِّي لكاتِم","لقد جُرتَ يا فَيضَ الدُّمُوع السَّواجمِ",50,"م",1,1],["إيتوا إليها وأنتم في شدائكم","يُضيكُم نورُها في جنح ظلماء",51,"ا",2,0],["أَيَتِمُّ أَمْرُكَ يا أَشَلُّ وهذِه ال","أَمثالُ لم تنطِقْ بشيءٍ كاذبِ",52,"ب",1,0],["إيتِ يا صادياً حياضَ نداهُ","وارْو منها وخلِّ كلَّ الحياضِ",53,"ض",1,0],["إئتَلَفنَا بكم فَرُمتُم رَحيلاً","أَو بَعدَ ائتِلافِنا تَهجُرُونَا",54,"ن",2,0],["إيتاءَ حَقِّ الشُكرِ حَقُّ خَليفَةٍ","تَزَيُّنُ الدُنيا بِهِ وَالدينُ",55,"ن",1,0],["أَيتكَ يا خَيرَ البريَّة كُلِّها","نَشَرت كتاباً جاء بالحقِّ مُعلِما",56,"م",2,1],["أيترك حقي أم تضاع مقاصدي","ولي من لسان الحال نطق لها يشدو",57,"د",2,0],["أيتها العذراء إن","ني فيك صب أكبر",58,"ر",1,0],["أيّ تيس أضعتُ منه قليلاً","ما ترى مثلَهُ لدى التيَّاس",59,"س",1,0],["أي ترس قال لي هي تلك لك","ما الذي أوجب هذا السفرا",60,"ر",2,0],["أي تسعها فثلثها مقيد","مؤسّس ومردف مجرد",61,"د",1,0],["ائتِ الحَجونَ مِن كدَاءٍ لا كُدى","مُعتَبِراً ثم بأَحجارِ الكُدى",62,"د",2,0],["آي تَدُلُّك أنَّها اختيرت لهُ","واللَهُ جلَّ جلالُه يختارُ",63,"ر",1,0],["ايتادلوا فيهن زِكِيّين لجدود","ساعه ولا حَلّن ولا حيلهن باد",64,"د",1,0],["أَيتيماً آويتِ حسبُك أجرا","وغبياً هديتِ حسبُك ذِكرا",65,"ر",2,1],["أيتها الشهب أَلا فاْغربي","أيتها الشمس أَلا فاْطلعُي",66,"ع",2,0],["أيتها الآمالُ لا تتركي","ربوعَ لبنانٍ ولا تجزعي",66,"ع",2,0],["أيُتْرَكُ قَيْسٌ آمِنينَ بِدَارِهِمْ","وَنُرْكَبُ ظَهْرَ الْبَحْرِ والْبَحْرُ زَاخِرُ",67,"ر",1,0],["أيتمت طفل النبت في حجر الثرى","يا أرأف الآباء بالاولاد",68,"د",1,0],["ايتها الدار التي اشكرها","شكر زهور الروض للقطار",69,"ر",1,0],["أيتها العيناء إِياي ارحمي","وأقلعي عن البكا قدك أسلمي",70,"م",2,0],["أيتبع هذا البرق غيث وديمة","لعمرك أم ذا الغيث عنقا مغرب",71,"ب",1,0],["آيٌ تُقَر ِّعُ مَن أضحَى يُعارِضُهَا","فيجعَلُ الرَّاحَ فِي آذانِهِ حَذَرَا",72,"ر",2,0],["أي تاج مهما تعالى يوازي","تاج شعر لغادة معقود",73,"د",1,0],["آيتُه مبصرةٌ لم تزَل","وليلُهُ قد محيَت آيتُه",74,"ه",1,0],["ايته بالقطر كم نجحت لها","مقاصد اصلاح عميم يريده",75,"د",2,0],["أي تمر طيبة طابت روح مساكنها","في مسلم جا صريحا غير مكتتم",76,"م",1,0],["أيتها الأرواحُ ما أزكاكمُ","فيما دخلتم فيه شاركناكم",77,"م",1,0],["أَيُتركُ وَلْهاناً يئنّ من الجوى","أخا شَغَفٍ عاري الأَشاجع باليا",78,"ي",2,0],["إِيتوا اشتَرُوا خُبزاً وخمراً من سِوَى","ثَمَنٍ ولا وَرِقٍ ولا تشكوا الخَوَى",79,"ا",1,0],["إِيتوا امامَ اللَه واحتضنوا الجَزا","بإِزاءِ نهرِ النارِ ذي الإِيقادِ",80,"د",1,0],["أَيّ تاج لَم تجعلوه نعالاً","لكرام الخَيل العتاق المحيفه",81,"ف",2,0],["آيتا فتنة تُصاد وتُصطا","د فآناً صيداً وآناً صيودا",82,"د",2,0],["أيترُكُ بَطْنَ والدةٍ","لو انَّ لمثله رأيَا",83,"ي",2,0],["أيتها الأخطار علمتنا","بأننا الأحرار لو تعلمين",84,"ن",1,0],["أيتاح للدنف المتيّم زورة","يقضي بها لبن الهوى والحاجا",85,"ج",2,0],["أيتركُ الجوهرُ جوهر الدررْ","ويؤخذ الزبل ولو زبل البقرْ",86,"ر",1,0],["أَيُترَكُ قَوّالُ الخَنا وَيَنالُني","عَوايِرُ قَولٍ لَستُ مِمَّن يَقولُها",87,"ه",2,0],["أيتها النفس قفي عندما","ألزمت، فعلاً كان أو قولا",88,"ل",2,1],["إِئتِ المِياهَ الَّتي تَسقي إِذا طُرِقَت","عَذباً وَتَستُر من ذي الفاقَة العَوَرا",89,"ر",2,0],["أيتلِفُني نبلٌ ولَم أدرِ من رمى","أيقتُلُني سيفٌ ولم أر ضاربي",90,"ب",2,0],["أيترك دين الحق حيث حماته","ألا تعس الحامي وبئس الذي احتمى",91,"م",2,0],["أيتوالت له بعين استقامت","أو توالت عنه بعين اضمحلت",92,"ت",1,0],["أيتَمتَنا فارحم يتامَى أمَّةٍ","ترنو إلى التَّحنان والرحَمات",93,"ت",1,0],["إيتعجب فالزمان وفي نظامه","فالركود من العرب والثايريني",94,"ن",2,0],["ايتيامن ويتياسر كنه ييم","وان قطع توك قطع كنه قطار",95,"ر",1,0],["ائتِيَاني بغطاءٍ شَتَوٍ","ومن الملبوس صُوفيّ الكساءْ",96,"ا",2,0],["أيتُها النائيات أعينُها","عن الكرى والأنذال قد رقدوا",97,"د",3,0],["أيُتْرَكُ مفتوحا ولم يتَّضحْ له","من النحو باب أو محل من الإعراب",98,"ب",1,0],["ايترجم اقواله فعل موب غدار","يوم(ن) ولد اللاش حده حكاويه",99,"ي",2,0],["أيتقن سرّ لفظك جاهليٌّ ؟","ولم تبلغ سليقته الرضاعا !!؟",100,"ع",2,0],["أيتقد الخيال بلا وقودٍ","ومن دهرٍ نبدده ضياعا !!",100,"ع",2,0],["أيتركها وقد سئمت رباضا","كما سئم اليماني القرايا",101,"ي",2,0],["أيترح الهاجس المكدور غن فطنٍ","أم أفلح النيل من عزمي وتهديدي",102,"د",2,0],["أيتها الغادة من ذا الذي","تسحره عيناك لم يسقم",103,"م",1,0],["أيترك بابه من دون غلْقٍ؟!!!","وليس سواك إذْ عصفتْ ..أُريحُ",104,"ح",1,0],["أيّتها النار ذوّبي البدعا","وأحرقي الصرح بالذي ابتدعا",105,"ع",2,1],["أيتها الريح إنّه جبلٌ","من ألف عصفٍ هزاع ماصُدعا",106,"ع",2,0],["أيتها الريم أتقني السفكا","بمدية الشعر شرّحي الإفكا",107,"ك",2,1],["أيتم أنس أم يطيب ترنم","غلا إذا كان المرجع سامي",108,"م",2,1],["ائتمنت سنين عمري ... وغدرن","طعنتين بظهر ساهي .. ما يهاب",109,"ب",1,0],["أَيتُ العِزَّ في أَدَبٍ وعِلمٍ","وفي الجَهلِ المَذَلَّةُ والهَوانُ",110,"ن",1,1],["أي تدليلٍ أحاطونا به ؟!","ما 