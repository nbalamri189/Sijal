{"poems":[[55,"أيها الطالب شمسا","https://www.aldiwan.net/poem26140.html","مجزوء الرمل"],[73,"أيتها النفس إليه اذهبي","https://www.aldiwan.net/poem11985.html","السريع"],[93,"فديت يا من كان صادق رفعة","https://www.aldiwan.net/poem11216.html","البسيط"],[88,"البحر رهو والسما صاحيه","https://www.aldiwan.net/poem44450.html","السريع"],[88,"شب الأسى في قلوب الشعب مستعرا","https://www.aldiwan.net/poem45044.html","البسيط"],[72,"بلغا القاصدين أن الليالي","https://www.aldiwan.net/poem19529.html","الخفيف"],[72,"تهن بالأعياد يا عيدها","https://www.aldiwan.net/poem19979.html","السريع"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[89,"أيتها النفس اقترب","https://www.aldiwan.net/poem44672.html","مجزوء الرجز"],[85,"الضلوع تتقد","https://www.aldiwan.net/poem62893.html","المقتضب"],[85,"أنا من بدل بالكتب الصحابا","https://www.aldiwan.net/poem63724.html","الكامل"],[85,"أعلى الممالك ما كرسيه الماء","https://www.aldiwan.net/poem63727.html","الكامل"],[45,"تظن شجوني لم تعتلج","https://www.aldiwan.net/poem62675.html","المتقارب"],[45,"نفقت نفوق الحمار الذكر","https://www.aldiwan.net/poem63583.html","الخفيف"],[49,"كل إلى الرحمن منقلبه","https://www.aldiwan.net/poem10384.html","السريع"],[49,"إيت القبور فنادها أصواتا","https://www.aldiwan.net/poem10831.html","الكامل"],[66,"أيته كالهلال يبدو","https://www.aldiwan.net/poem39522.html","مجزوء البسيط"],[66,"بلغي الأحباب يا ريح","https://www.aldiwan.net/poem41564.html","مجزوء الرمل"],[31,"نام صحبي ولم أنم","https://www.aldiwan.net/poem41308.html","مجزوء الخفيف"],[31,"أرسلت لما عيل صبري إلى","https://www.aldiwan.net/poem41857.html","السريع"],[52,"أبى آبي الهوى أن لا تفيقا","https://www.aldiwan.net/poem26799.html","الوافر"],[46,"أيتها النفس لا تهالي","https://www.aldiwan.net/poem23229.html","مجزوء البسيط"],[19,"أيتها النفس أجملي جزعا","https://www.aldiwan.net/poem347.html",""],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85823","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85615","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39631","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39498","المديد"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55227","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55075","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54883","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55125","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55074","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142040","الرجز"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199490","الرجز"],[81,"َأيتُ حُسَاماً فِي ذَرَى عَامِر وَقَد","https://www.poetsgate.com/ViewPoem.aspx?id=59037",""],[90,"كذب الخائفون","https://www.poetsgate.com/ViewPoem.aspx?id=179012",""],[109,"ذهاب بلا اياب","https://www.poetsgate.com/ViewPoem.aspx?id=35293",""],[45,"نفقت نفوق الحمار الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=31266",""],[99,"سؤال","https://www.poetsgate.com/ViewPoem.aspx?id=7380",""],[31,"أرسلتُ لما عيلَ صبري إلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19013&r=&rc=276",""],[175,"سيدي أنت ومن لم","https://www.aldiwan.net/poem46032.html","مجزوء الرمل"],[257,"خفي فما أنت بمعذوره","https://www.aldiwan.net/poem48487.html","السريع"],[372,"خلا طرفه بالسقم دوني يلازمه","https://www.aldiwan.net/poem57103.html","الطويل"],[372,"أيترك سر بعد سري لكاتم","https://www.aldiwan.net/poem57133.html","الطويل"],[378,"إليك أضرع في مدحٍ خصصتِ به","https://www.aldiwan.net/poem59155.html","البسيط"],[433,"أما الكواكب فاحتموا بمواكب","https://www.aldiwan.net/poem12405.html","الكامل"],[433,"إنها أعرضت عن الإعراض","https://www.aldiwan.net/poem12485.html","مجزوء الخفيف"],[539,"قد أثرتم لواعجا وشجونا","https://www.aldiwan.net/poem47587.html","عموديه"]],"verses":[["إِئتِ مِن بَغدادَ بابَ ال","شامِ أو نَهرَ المُعَلّى",0,"ل",2,0],["أَيَّتُها النَفسُ إِلَيهِ اِذهَبي","فَما لِقَلبي عَنهُ مِن مَذهَبِ",1,"ب",1,1],["أَيْتَمْتَ وُلْداً نَاعِماً أَظْفَارُهُمْ","حُرِمُوا حُنُوَّ أَبٍ عَلَيْهِمْ حَانِي",2,"ن",2,0],["أيتها الأرض قفي واسلمي","من أجل هذا المشهد الزاهر",3,"ر",1,0],["أيتركون الذي قد كنت تطلبه","أم هم سيقضون من مطلوبك الوطرا",4,"ر",2,0],["أي تاجٍ وللأهلة في الأف","ق قسيّ ترمي الورَى بنبال",5,"ل",1,0],["أيتمهم بعدي وإني على","بابك لاهٍ في جنان النعيم",6,"م",1,0],["إيتاءُ عاف وإتيانُ ابن مكرمةٍ","منه نوالٌ ومن عافيه غِشيان",7,"ن",1,0],["أيتها النفس اقترب","فراق أبطال الأدب",8,"ب",1,1],["اِئتِلافُهُ رَشَدٌ","وَاِختِلافُهُ سَدَدُ",9,"د",1,0],["إِئتِ بِالعُمرانِ رَوضاً يانِعاً","وَاِدعُها تَجرِ يَنابيعَ عِذابا",10,"ب",2,0],["أَيَترُكُ الأَرضَ جانوها وَلَيسَ بِها","صَحيفَةٌ مِنكَ في الجانِبَينِ سَوداءُ",11,"ا",2,0],["أَيُتلِفُ يَعقوبُ مالي لَدَي","هِ وَيَعقوبُ مُتَّئِدٌ لَم يُهَج",12,"ج",1,0],["أَيَترُكُ ما كانَ مُستَخفِياً","فَكَيفَ بِتَركِ الَّذي قَد ظَهَر",13,"ر",1,0],["إيتِ الأُمورَ وَأَنتَ تُبصِرُها","لا تَأتِ ما لَم تَدرِ ما سَبَبُه",14,"ب",2,0],["إيتِ القُبورَ فَنادِها أَصواتاً","فَإِذا أَجَبنَ فَسائِلِ الأَمواتا",15,"ت",2,1],["أَيتُهُ كَالهِلالِ يَبدو","وَوَجهُهُ مُشرِقٌ بِلالا",16,"ل",2,1],["أَيتَموا الأَطفالَ في الحَر","بِ وَهُم كَهفُ اليَتاما",17,"م",2,0],["إِئتِ هِنداً فَقُل لَها","لَيلَةَ الخَيفِ ذي سَلَم",18,"م",1,0],["إِئتيهِ بِاللَهِ وَقولي لَهُ","وَاللَهِ لا يَفعَلُهُ ثُمَّ لا",19,"ل",2,0],["أَيَترُكُ لَونَهُ لا ضَوءَ فيهِ","وَيَكسو الشَمسَ وَالقَمَرَ البَريقا",20,"ق",2,0],["أَيَّتُها النَفسُ لا تُهالي","شَرخي قَد مَرَّ وَاِكتِهالي",21,"ل",2,1],["أَيَّتُها النَفسُ أَجمِلي جَزَعا","إِنَّ الَّذي تَحذَرينَ قَد وَقَعا",22,"ع",2,1],["أيُّ تعذيبٍ سوى البُعْدِ لنَا","منكِ عذبٌ حبّذا ما بَعْدَ أي",23,"ي",1,0],["ائتِ ما شئته ولا تخشَ بأساً","لا حرامٌ فيها ولا محظور",24,"ر",1,0],["أيتها النفس لا تخافي","فإنما الموت قد يفيد",25,"د",1,0],["ائتمناه على السر","رِ فأفشى بعد حين",26,"ن",1,1],["أيَّتُها المحزونةُ الباكيهْ","لا تيأسي من رحمةِ المنْقِذِ",27,"ذ",1,0],["أيَّتُها الأيام ما تصنعينْ","بذلك العبءِ الذي تحملينْ",28,"ن",1,1],["أيّتُها الملكةُ الكسيرهْ","أيّتُها الربّةُ الخجولهْ",29,"ه",1,0],["أيّتُها الطفلةُ الكبيرهْ","لن تبرحي عالمَ الطفولهْ",29,"ه",1,0],["أيّتُها الغُورُ والبِطاحُ","أيّتُها الشهبُ والجبالُ",29,"ل",1,0],["ائتمرت في الندوة الأعيان","وانتدبت للفتكة الفتيان",30,"ن",1,0],["أَيُّ تُفَّاحٍ ورمَّانِ","يُجتنَى من خُوطِ رَيْحانِ",31,"ن",1,1],["أَيَتِم أُنْسٌ أمْ يَطِيبُ تَرَنمٌ","إلاَّ إذَا كَانَ المُرَجِّعُ سَامِي",32,"م",2,1],["أَيَتِنَا أَنْجُماً فِي الرَّوْضِ طَالِعَةً","أَبْهَى بِأَعْيُنِنَا مِنْ أَنْجُمِ الأُفقِ",33,"ق",1,0],["أَيَتِيمَةٌ تَهْوي وَرَاءَ يَتيمَةٍ","منْ ذلكَ العقْدِ الكَريم الفاخِرِ",34,"ر",1,0],["أَيْتَمْتِهَا كَرْهاً وَلَمْ","تَشْفِي الحَشَى مِنْهَا وِصَالَا",35,"ل",2,0],["أَيُّ تَاجَيْهِمَا هُوَ العَدْلُ وَالرَّحْ","مَةُ لِلْمُسْتَضَامِ وَالمَنْكُودِ",36,"د",1,0],["اَيُّ تَاجَيْهِمَا عَلَى الدَّهْرِ عُنْ","وَانُ الْهُدَى وَالْفِدَى وَعَتْقُ الْعَبِيدِ",36,"د",1,0],["أَيُّ تَعْسٍ كَتَعْسِ دَارٍ عَلَيْهَا","يَتَوَالَى الفَسَادُ بَعْدَ الفَسَادِ",37,"د",1,0],["أَيُّ تَقْوَى وَأَيُّ دِينٍ وَدُنْيَا","حَمَلَتْ نَعْشَهُ عَلَى الأَعْنَاقِ",38,"ق",1,0],["أيتها الفتانةُ الصغيره","أنتِ بتاج ملكٍ جديره",39,"ه",1,1],["أيتها الأميره!","نريد منك رقصة...",40,"ه",1,0],["أيتها الأميرهْ!","أرقصُ... كالفراشة الصغيره",40,"ه",1,0],["َأيتُ حُسَاماً فِي ذَرَى عَامِر وَقَد","كَسَاهُ بَيَاضاً خَوفَ أن يَتَغَيَّرَا",41,"ر",2,1],["آيتا العرب في ندىً وزِحام","طيِّبوا ذكركم ، وموتوا كراما",42,"م",2,0],["إيتني...وادخل القلبي ياقلبي...باب باب","واخطر عروقي برجليك يا اسمر دوب دوب",43,"ب",1,0],["إيتني واذهب بي بعيد...يامال الذهاب","ضمني بايديك أبجمد على صدرك واروب",43,"ب",1,0],["أيتك ما كان مستخفياً","فكيف بترك الذي قد ظهر",44,"ر",1,0],["أيتلفُ هذا البريقُ العجيب","كما سوف تتلف أعضاؤنا",45,"ن",2,0],["إيتيهِ بِکللَّهِ وَقولي لَهُ:","واللهِ، لا يفعلهُ، ثمّ لا",46,"ل",2,0],["إيتنا قَدْ كَسَدَتْ","سُوقُ اللَّذاذاتِ لِتَنْفَقْ",47,"ق",1,0],["أيتها المرأة لا تقلقي","من قبل أن تستعملي الصوره",48,"ر",2,0],["أيَّتها الثَّكلَى الَّتي من دُمُوعِها","إذا هيَ ناحَت للقَتيل مآتِمُه",49,"م",2,0],["أيُترَكُ سرٌّ بعدَ سرِّي لكاتِم","لقد جُرتَ يا فَيضَ الدُّمُوع السَّواجمِ",50,"م",1,1],["إيتوا إليها وأنتم في شدائكم","يُضيكُم نورُها في جنح ظلماء",51,"ا",2,0],["أَيَتِمُّ أَمْرُكَ يا أَشَلُّ وهذِه ال","أَمثالُ لم تنطِقْ بشيءٍ كاذبِ",52,"ب",1,0],["إيتِ يا صادياً حياضَ نداهُ","وارْو منها وخلِّ كلَّ الحياضِ",53,"ض",1,0],["إئتَلَفنَا بكم فَرُمتُم رَحيلاً","أَو بَعدَ ائتِلافِنا تَهجُرُونَا",54,"ن",2,0]]}