{"poems":[[86,"طمع ألقى عن الغرب اللثاما","https://www.aldiwan.net/poem10683.html","الرمل"],[93,"هل آية في السلم والحرب","https://www.aldiwan.net/poem9789.html","عموديه"],[93,"شيدها إلياس داراً وما","https://www.aldiwan.net/poem11105.html","السريع"],[93,"حبذا الشعر خاطر يبعث النور","https://www.aldiwan.net/poem11377.html","الخفيف"],[88,"سر في حياتك سير نابه","https://www.aldiwan.net/poem44813.html","مجزوء الكامل"],[72,"أهواه فتان اللواحظ أغيدا","https://www.aldiwan.net/poem18548.html","الكامل"],[51,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[85,"ملَك بأفق الرمل هلّ كريما","https://www.aldiwan.net/poem7888.html","الكامل"],[85,"السحر من سود العيون لقيته","https://www.aldiwan.net/poem62984.html","الكامل"],[45,"يا أبا غانم غنمت ولازا","https://www.aldiwan.net/poem63489.html","الخفيف"],[45,"لازال محتفل الغمام الباكر","https://www.aldiwan.net/poem63617.html","الكامل"],[28,"ولا اتبعتكم يوم ظعن فلائها","https://www.aldiwan.net/poem5492.html","الطويل"],[31,"شاق قلبي منزل دثرا","https://www.aldiwan.net/poem42510.html","المديد"],[31,"أبهجر يودع الأجوار أم","https://www.aldiwan.net/poem42534.html","الخفيف"],[67,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[48,"قال الوشاة بدت في الخد لحيته","https://www.aldiwan.net/poem10812.html","البسيط"],[50,"ما بال عينك دمعها مسكوب","https://www.aldiwan.net/poem64802.html","الكامل"],[50,"آب ليلي بعد السلو بعتب","https://www.aldiwan.net/poem64827.html","الخفيف"],[72,"","https://poetry.dctabudhabi.ae/diwan/poem/40678","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54635","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54833","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54838","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54582","الرمل"],[28,"أتنسى بنو سعد جدود التي بها","https://www.poetsgate.com/ViewPoem.aspx?id=22083",""],[31,"شاقَ قلبي منزلٌ دثروا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18890&r=&rc=153",""],[31,"أبهَجْرٍ يُوَدَّعُ الأَجْوَارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18868&r=&rc=131",""],[20,"ويح عمرِو بن عدي من رجل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70016&r=&rc=38",""],[124,"هذا الربيع بنور الحسن وافانا","https://www.aldiwan.net/poem805.html",""],[180,"أبهى قران للسليم قد انجلى","https://www.aldiwan.net/poem61136.html","الكامل"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[227,"أيها الماجد الذي لم يقصر","https://www.aldiwan.net/poem51050.html","الخفيف"],[233,"خليفة الله الذي وعوده لا تخلف","https://www.aldiwan.net/poem31820.html","مجزوء الرجز"],[235,"عن نور هديك ثغر الدهر مبتسم","https://www.aldiwan.net/poem19069.html","البسيط"],[235,"فرجت من همي ومن بوسي","https://www.aldiwan.net/poem19716.html","الكامل"],[280,"فيك عذولي عذرا","https://www.aldiwan.net/poem32763.html","مجزوء الرجز"],[295,"مهلا سقتك الغوادي هاطل الديم","https://www.aldiwan.net/poem33174.html","البسيط"],[296,"صنع الجميل وفعل الخير إن أثرا","https://www.aldiwan.net/poem36309.html","عموديه"],[303,"تونس الأنس بلدة ميمونه","https://www.aldiwan.net/poem56392.html","الخفيف"],[344,"آب هذا الهم فاكتنعا","https://www.aldiwan.net/poem24142.html","المديد"],[351,"حمدا لك اللهم يا من قد قضى","https://www.aldiwan.net/poem40828.html","الرجز"],[364,"أي يوم علا على الأيام","https://www.aldiwan.net/poem17333.html","الخفيف"],[399,"من ترى غير علي","https://www.aldiwan.net/poem46974.html","مجزوء الرمل"],[413,"إن جئت آل سلمى أو مغانيها","https://www.aldiwan.net/poem54145.html","البسيط"],[426,"ربع التهاني بالمسرة زاهي","https://www.aldiwan.net/poem40058.html","الكامل"],[426,"عوفي الندى والمجد والأدب","https://www.aldiwan.net/poem40710.html","أحذ الكامل"],[429,"هذا اللوى لا حط منه لواء","https://www.aldiwan.net/poem12549.html","الكامل"],[450,"غيري يلذ له الهوى بهوان","https://www.aldiwan.net/poem13931.html","الكامل"],[456,"سأَلت ظبية ما هذا النحول","https://www.aldiwan.net/poem55929.html","المتقارب"],[536,"زارت ضيوف النيل منا المغربا","https://www.aldiwan.net/poem48267.html","عموديه"],[556,"حولوا عني من الكون لثاما","https://www.aldiwan.net/poem33885.html","الرمل"],[560,"أبهى عذار لعبد القادر انتشرت","https://www.aldiwan.net/poem52563.html","البسيط"],[565,"لا تظنين في بكاء النؤى والطنب","https://www.aldiwan.net/poem69810.html","البسيط"],[585,"ما عقد در على جيد بغيداء","https://www.aldiwan.net/poem11504.html","عموديه"]],"verses":[["أَبِهَذا جاءَهُم إِنجيلُهُم","آمِراً يُلقي عَلى الأَرضِ سَلاما",0,"م",2,0],["أَبْهَجْ بِهَا لَيْلَةَ أُنْسٍ زَهَتْ","مُضَاءَةً بِالسَّادَةِ الشُّهْبِ",1,"ب",1,0],["أَبهَجُ مِنْ ظَاهِرِ زينَاتِهَا","لِلْمُجْتَلِي زِينَاتِ منْ فِيهَا",2,"ي",3,0],["أَبْهَجَتْنَا آَيَاتُهُ فِي كِتَابٍ","لِنَدَى الصِّبَا سَنِيَّ المَرَامِ",3,"م",1,0],["أبهت حكومتنا لهِ","والشعب ليس له بآبه",4,"ب",2,0],["أبهى الورى خلقاً وأبهر منظراً","وأجل آلاءً وأكرم موْلدا",5,"د",2,0],["أُبْهمَ القومُ غير شك وأُنِّس","تَ فعادوا فضيلة التأنيس",6,"س",1,0],["أبهى من الدنيا وأزين طلعة","وألذ من عَرف الحياة شميما",7,"م",2,0],["أَبهى مِنَ الوَشِيِ الكَريمِ مِروجُهُ","وَأَلَذُّ مِن عَطَلِ النُحورِ مُروتُهُ",8,"ت",2,0],["أَبهَجَت زَورَةُ الوَزيرِ أَخِلّا","ءَكَ جَمعاً وَأَرغَمَت حُسّادَك",9,"ك",1,0],["أَبهَت لِساكِنِها النَوى وَتَكَشَّفَت","عَن أَهلِها سِنَةُ الزَمانِ الناضِرِ",10,"ر",1,0],["أَبَهدَلَةَ الأَخيارَ تَهجو وَلَم يَزَل","لَهُم أَوَّلٌ يَعلو عَلى كُلِّ أَوَّلِ",11,"ل",1,0],["أَبِهِ عُتبى فَأَعتِبُهُ","أَم بِهِ صَبراً فَقَد صَبَرا",12,"ر",2,0],["أَبِهَجرٍ يُوَدَّعُ الأَجوارُ","أَم مَساءٍ أَم قَصرُ ذاكَ اِبتِكارُ",13,"ر",1,1],["أبِهَذِهِ العَوراتِ جَاءَتْ كُتبُهُم","أمْ حَرَّفوا منها الصَّوابَ وَوَرَّبُوا",14,"ب",3,0],["أَبهى وَأَكثَرُ ما كانَت مَحاسِنُهُ","أَن زالَ عارِضُهُ وَاِخضَرَّ شارِبُهُ",15,"ب",2,0],["أَبهى عَلى خَشَبِ المَنابِرِ قائِماً","يَوماً وَأَحرَبَ إِذ تُشَبُّ حُروبُ",16,"ب",1,0],["أَبهَمَت دونَكَ الفِجاجُ فَلا أَل","قى سَبيلاً إِلَيكِ في غَيرِ تُربِ",17,"ب",1,0],["أبهى وأبهر ما يلقاك منظره","إذا نظرت على وجه الوغى قتره",18,"ر",2,0],["أَبْهَى البَنَاتِ صُورَةً أَنْقَى","اللَّدَاتِ سِيرَةً أَعَفَّهُنَّ مَشْرَبا",19,"ب",2,0],["أَبْهَجْ بِحُسْنِكِ يَا سَمَاءُ وَحَبَّذَا","هَذِي النُّجُومُ وَهَذِهِ الأَقْمَارُ",20,"ر",1,1],["أَبِهَذَا الشَّتَاتِ فِي كُلُّ شَيْءٍ","يَجْمَعُونَ القُوَى لِصَدِّ أَعَادِي",21,"د",2,0],["أَبْهِجْ بِإِكْلِيلِ الزَّفَافِ وَقَدْ جَلاَ","لِلْعَيْنِ كُلَّ أَثِيرَةٍ غَرَّاءِ",22,"ا",2,0],["أَبْهِجْ بِأَوْبَتِكَ السَّنِيَّةِ طَالِعاً","فِي أُفْقِهِ كَالكَوْكَبِ المُتَلاَلِي",23,"ل",2,0],["أَبْهِج بِهِ يَوْماً يُجَدِّدُ عَزْمَهُ","وَيُوَحِّدُ الآدَابَ وَالأَوْطَارَا",24,"ر",2,0],["أَبِهَا غَيْرُكَ يَغْدُو رَافِلاً","وَهْيَ لاَ تَنْكُرُ تَغْييِرَ الإِهَابْ",25,"ب",1,0],["أَبَهدَلَةَ الأخيارَ تَهْجُوا وَلمْ يَزَلْ","لَهُمْ أوّلٌ، يَعْلُو على كلّ أوّلِ",26,"ل",1,0],["أَبِهِ عُتْبَى فَأُعْتِبُهُ","أمْ به صبرٌ، فقد صبرا",27,"ر",2,0],["أبهَجْرٍ يُوَدَّعُ الأَجْوَارُ","أَمْ مَساءٍ أَمْ قَصرُ ذاكَ کبْتِكَارُ؟",28,"ر",1,1],["أَبِهِم دَلاكَ عَمرٌو لِلرَدى","وَقَديماً حينَ لِلمَرءِ الأَجَل",29,"ل",1,0],["أبهجت قلبي ولم يظفر بمنيته","هيهات بعدك يلقى القلب سلوانا",30,"ن",2,0],["أَبهى قِرانٍ للسليمِ قَد اِنجَلى","عَن فَرقَدٍ في السَعدِ لاقى فَرقَدا",31,"د",2,1],["أَبهجٌ أَبلجٌ أزجُّ أسيل ال","خدِّ أَقنى وَجبهةٌ جلواءُ",32,"ا",2,0],["أبهج النِيلَ ما بنيتَ عليه","كابتهاج السماء بالأقمار",33,"ر",1,0],["أَبهى مِنَ الدُرِّ إِذا","ما شُقَّ عَنهُ الصَدَفُ",34,"ف",1,0],["أَبْهَجْتَ عَبْدَكَ إِذْ وَافَاكَ مُكْتَئِباً","إِنَّ الْجَوَى بِدُنُوٍّ مِنْكَ يَنْحَسِمُ",35,"م",1,0],["أَبْهَاهُمُ وَجْهاً وَأَوْ جَهُهُمْ","فِي أَعْيُنِ الأَعْيَانِ وَالرُّوسِ",36,"س",1,0],["أَبهَجَ مِن نَبتِ رِيا","ضِ الحَزنِ حينَ نَوَّرا",37,"ر",2,0],["أَبهى نظاماً وأَسنى منك مطَّلعا","أَدهى اِنتقاماً وأَجدى منك في نعمِ",38,"م",1,0],["أبهى لدى النفس منها وَهي خاطرةٌ","تجري مدامعُ من هاموا بها نهرا",39,"ر",2,0],["أُبهِجَت تونس بِما أرّخوه","طَودُ زغوان قَد حَباها معينَه",40,"ن",2,0],["آبَ هَذا الهَمُّ فَاِكتَنَعا","وَأَتَرَّ النَومَ فَاِمتَنَعا",41,"ع",2,1],["أَبهى سلامٍ ما لَهُ حَدٌّ تَلا","أَزكى صَلاةٍ ما لَها مِن مُنتَهى",42,"ا",1,0],["أَبُّها البَحرُ إِنَّ جودَكَ طامٍ","لِلبَرايا وَإِنَّ عَبدَكَ ظامِ",43,"م",1,0],["أَبهِ الملّة حيطَتْ","أم بتَيْمٍ وعديِّ",44,"ي",1,0],["أبهى وأبهجَ من نظم نظمت به","زُهْرَ الكواكب نظماً في قوافيها",45,"ي",3,0],["أبهى وزير وزرته يد العلى","والمجد في عليائه متباهِ",46,"ا",2,0],["أبهى أمير قد سما شيماً","يروي شذاها المندل الرطبُ",47,"ب",1,0],["أبهى من القمر المنير وإنما","أقوالُ عبد الله فيه عُواءُ",48,"ا",2,0],["أبهى وأزهى من سطورٍ حاكها","فَغَدتْ نسيجةُ وحْدِها ببيانِ",49,"ن",1,0],["أبهمَ الناسُ ولاحت أنجماً","غُرَرُ السؤدد فيها والحجُولُ",50,"ل",1,0],["أبهَجتُم منا نُفوسا طالما","كَرَبَت وحُقَّ لِنفسِنا أن تَكرُبَا",51,"ب",2,0],["أبهموا الأمر على من أبهموا","ليتني أقدر أنفي الإنبهاما",52,"م",2,0],["أبهى عِذارٍ لعبدِ القادرِ انتَشَرَتْ","فيهِ نوافجُ مِسكٍ صُنعُ رَحْمانِ",53,"ن",1,1],["أبهى وأجملُ من ذكر الجمال ومن","إدمان ذكرِ هوىً يَهْوى على قَتَبِ",54,"ب",1,0],["أبها وأنهى لدى اليوم حين زهى","من در لفظ أتى من سبق نائي",55,"ا",2,0]]}