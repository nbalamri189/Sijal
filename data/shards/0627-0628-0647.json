://poetry.dctabudhabi.ae/diwan/poem/120515","السريع"],[4698,"أنفاسُ أبها ..","https://www.poetsgate.com/ViewPoem.aspx?id=28639",""],[4816,"المارد الموهوب","https://www.poetsgate.com/ViewPoem.aspx?id=23719",""],[4578,"بدر الدجى وافي بشمس الضحى","https://www.poetsgate.com/ViewPoem.aspx?id=49379",""],[4578,"ريم النقا بالله غني سلاه","https://www.poetsgate.com/ViewPoem.aspx?id=49603",""],[4940,"لغة العيون","https://www.poetsgate.com/ViewPoem.aspx?id=210412",""],[5064,"لخَمرَةِ الرُّوحِ تارِيخٌ مِنَ الألَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=199169",""],[585,"هنا المحفل المشهود بالشعب يزخر","https://www.poetsgate.com/ViewPoem.aspx?id=161897",""],[5105,"أبهى المناظرِ في عيني وأَحْسَنُها","https://www.poetsgate.com/ViewPoem.aspx?id=135330",""],[5145,"قف بالمطيّ فلات حين مناص","https://www.poetsgate.com/ViewPoem.aspx?id=108223",""],[5145,"مقل الظباء إذا رمين قواصد","https://www.poetsgate.com/ViewPoem.aspx?id=108154",""],[5145,"أعلمت أنا سيد الأنس","https://www.poetsgate.com/ViewPoem.aspx?id=108220",""],[5281,"مهرجانُ الغيم.. أبها","https://www.poetsgate.com/ViewPoem.aspx?id=199736",""],[5302,"وسبت فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=201220",""],[470,"بيضُ وجوهُ بني عمي كما الغُررُ","https://www.poetsgate.com/ViewPoem.aspx?id=18590",""],[5616,"أبها","https://www.poetsgate.com/ViewPoem.aspx?id=205245",""],[5756,"التمثال","https://www.poetsgate.com/ViewPoem.aspx?id=1366",""],[402,"أمنوا بموتك صولة الرئبال","https://www.poetsgate.com/ViewPoem.aspx?id=36074",""],[5956,"لهفة على مدينة أبها","https://www.poetsgate.com/ViewPoem.aspx?id=184959",""],[6019,"أبها حكايةٌ لا ينضب جمالها","https://www.poetsgate.com/ViewPoem.aspx?id=193223",""],[6019,"ثلاثة وعشرون عاما سنابلٌ ملأى","https://www.poetsgate.com/ViewPoem.aspx?id=206334",""],[2096,"ذكر الأحباب والوطنا","https://www.poetsgate.com/ViewPoem.aspx?id=106662",""],[6152,"سقى الله الحجاز","https://www.poetsgate.com/ViewPoem.aspx?id=203295",""],[186,"يا أربع الخيف يسقي الماء واديها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55807&r=&rc=70",""],[6189,"رسالة إلى أميرة الغرابة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83587&r=&rc=54",""],[6316,"العشق أبها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65166&r=&rc=1",""],[5190,"أبهَى قصائدِ شِعرِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78287&r=&rc=1",""]],"verses":[["أَبِهَذا جاءَهُم إِنجيلُهُم","آمِراً يُلقي عَلى الأَرضِ سَلاما",0,"م",2,0],["أَبْهَجْ بِهَا لَيْلَةَ أُنْسٍ زَهَتْ","مُضَاءَةً بِالسَّادَةِ الشُّهْبِ",1,"ب",1,0],["أَبهَجُ مِنْ ظَاهِرِ زينَاتِهَا","لِلْمُجْتَلِي زِينَاتِ منْ فِيهَا",2,"ي",3,0],["أَبْهَجَتْنَا آَيَاتُهُ فِي كِتَابٍ","لِنَدَى الصِّبَا سَنِيَّ المَرَامِ",3,"م",1,0],["أبهت حكومتنا لهِ","والشعب ليس له بآبه",4,"ب",2,0],["أبهى الورى خلقاً وأبهر منظراً","وأجل آلاءً وأكرم موْلدا",5,"د",2,0],["أُبْهمَ القومُ غير شك وأُنِّس","تَ فعادوا فضيلة التأنيس",6,"س",1,0],["أبهى من الدنيا وأزين طلعة","وألذ من عَرف الحياة شميما",7,"م",2,0],["أَبهى مِنَ الوَشِيِ الكَريمِ مِروجُهُ","وَأَلَذُّ مِن عَطَلِ النُحورِ مُروتُهُ",8,"ت",2,0],["أَبهَجَت زَورَةُ الوَزيرِ أَخِلّا","ءَكَ جَمعاً وَأَرغَمَت حُسّادَك",9,"ك",1,0],["أَبهَت لِساكِنِها النَوى وَتَكَشَّفَت","عَن أَهلِها سِنَةُ الزَمانِ الناضِرِ",10,"ر",1,0],["أَبَهدَلَةَ الأَخيارَ تَهجو وَلَم يَزَل","لَهُم أَوَّلٌ يَعلو عَلى كُلِّ أَوَّلِ",11,"ل",1,0],["أَبِهِ عُتبى فَأَعتِبُهُ","أَم بِهِ صَبراً فَقَد صَبَرا",12,"ر",2,0],["أَبِهَجرٍ يُوَدَّعُ الأَجوارُ","أَم مَساءٍ أَم قَصرُ ذاكَ اِبتِكارُ",13,"ر",1,1],["أبِهَذِهِ العَوراتِ جَاءَتْ كُتبُهُم","أمْ حَرَّفوا منها الصَّوابَ وَوَرَّبُوا",14,"ب",3,0],["أَبهى وَأَكثَرُ ما كانَت مَحاسِنُهُ","أَن زالَ عارِضُهُ وَاِخضَرَّ شارِبُهُ",15,"ب",2,0],["أَبهى عَلى خَشَبِ المَنابِرِ قائِماً","يَوماً وَأَحرَبَ إِذ تُشَبُّ حُروبُ",16,"ب",1,0],["أَبهَمَت دونَكَ الفِجاجُ فَلا أَل","قى سَبيلاً إِلَيكِ في غَيرِ تُربِ",17,"ب",1,0],["أبهى وأبهر ما يلقاك منظره","إذا نظرت على وجه الوغى قتره",18,"ر",2,0],["أَبْهَى البَنَاتِ صُورَةً أَنْقَى","اللَّدَاتِ سِيرَةً أَعَفَّهُنَّ مَشْرَبا",19,"ب",2,0],["أَبْهَجْ بِحُسْنِكِ يَا سَمَاءُ وَحَبَّذَا","هَذِي النُّجُومُ وَهَذِهِ الأَقْمَارُ",20,"ر",1,1],["أَبِهَذَا الشَّتَاتِ فِي كُلُّ شَيْءٍ","يَجْمَعُونَ القُوَى لِصَدِّ أَعَادِي",21,"د",2,0],["أَبْهِجْ بِإِكْلِيلِ الزَّفَافِ وَقَدْ جَلاَ","لِلْعَيْنِ كُلَّ أَثِيرَةٍ غَرَّاءِ",22,"ا",2,0],["أَبْهِجْ بِأَوْبَتِكَ السَّنِيَّةِ طَالِعاً","فِي أُفْقِهِ كَالكَوْكَبِ المُتَلاَلِي",23,"ل",2,0],["أَبْهِج بِهِ يَوْماً يُجَدِّدُ عَزْمَهُ","وَيُوَحِّدُ الآدَابَ وَالأَوْطَارَا",24,"ر",2,0],["أَبِهَا غَيْرُكَ يَغْدُو رَافِلاً","وَهْيَ لاَ تَنْكُرُ تَغْييِرَ الإِهَابْ",25,"ب",1,0],["أَبَهدَلَةَ الأخيارَ تَهْجُوا وَلمْ يَزَلْ","لَهُمْ أوّلٌ، يَعْلُو على كلّ أوّلِ",26,"ل",1,0],["أَبِهِ عُتْبَى فَأُعْتِبُهُ","أمْ به صبرٌ، فقد صبرا",27,"ر",2,0],["أبهَجْرٍ يُوَدَّعُ الأَجْوَارُ","أَمْ مَساءٍ أَمْ قَصرُ ذاكَ کبْتِكَارُ؟",28,"ر",1,1],["أَبِهِم دَلاكَ عَمرٌو لِلرَدى","وَقَديماً حينَ لِلمَرءِ الأَجَل",29,"ل",1,0],["أبهجت قلبي ولم يظفر بمنيته","هيهات بعدك يلقى القلب سلوانا",30,"ن",2,0],["أَبهى قِرانٍ للسليمِ قَد اِنجَلى","عَن فَرقَدٍ في السَعدِ لاقى فَرقَدا",31,"د",2,1],["أَبهجٌ أَبلجٌ أزجُّ أسيل ال","خدِّ أَقنى وَجبهةٌ جلواءُ",32,"ا",2,0],["أبهج النِيلَ ما بنيتَ عليه","كابتهاج السماء بالأقمار",33,"ر",1,0],["أَبهى مِنَ الدُرِّ إِذا","ما شُقَّ عَنهُ الصَدَفُ",34,"ف",1,0],["أَبْهَجْتَ عَبْدَكَ إِذْ وَافَاكَ مُكْتَئِباً","إِنَّ الْجَوَى بِدُنُوٍّ مِنْكَ يَنْحَسِمُ",35,"م",1,0],["أَبْهَاهُمُ وَجْهاً وَأَوْ جَهُهُمْ","فِي أَعْيُنِ الأَعْيَانِ وَالرُّوسِ",36,"س",1,0],["أَبهَجَ مِن نَبتِ رِيا","ضِ الحَزنِ حينَ نَوَّرا",37,"ر",2,0],["أَبهى نظاماً وأَسنى منك مطَّلعا","أَدهى اِنتقاماً وأَجدى منك في نعمِ",38,"م",1,0],["أبهى لدى النفس منها وَهي خاطرةٌ","تجري مدامعُ من هاموا بها نهرا",39,"ر",2,0],["أُبهِجَت تونس بِما أرّخوه","طَودُ زغوان قَد حَباها معينَه",40,"ن",2,0],["آبَ هَذا الهَمُّ فَاِكتَنَعا","وَأَتَرَّ النَومَ فَاِمتَنَعا",41,"ع",2,1],["أَبهى سلامٍ ما لَهُ حَدٌّ تَلا","أَزكى صَلاةٍ ما لَها مِن مُنتَهى",42,"ا",1,0],["أَبُّها البَحرُ إِنَّ جودَكَ طامٍ","لِلبَرايا وَإِنَّ عَبدَكَ ظامِ",43,"م",1,0],["أَبهِ الملّة حيطَتْ","أم بتَيْمٍ وعديِّ",44,"ي",1,0],["أبهى وأبهجَ من نظم نظمت به","زُهْرَ الكواكب نظماً في قوافيها",45,"ي",3,0],["أبهى وزير وزرته يد العلى","والمجد في عليائه متباهِ",46,"ا",2,0],["أبهى أمير قد سما شيماً","يروي شذاها المندل الرطبُ",47,"ب",1,0],["أبهى من القمر المنير وإنما","أقوالُ عبد الله فيه عُواءُ",48,"ا",2,0],["أبهى وأزهى من سطورٍ حاكها","فَغَدتْ نسيجةُ وحْدِها ببيانِ",49,"ن",1,0],["أبهمَ الناسُ ولاحت أنجماً","غُرَرُ السؤدد فيها والحجُولُ",50,"ل",1,0],["أبهَى أ ُوَيلادِنا كانوا بِها شُهُبا ً","تَهوي وأركانُها تَهتَزُّ أركانا",51,"ن",2,0],["أبهَجتُم منا نُفوسا طالما","كَرَبَت وحُقَّ لِنفسِنا أن تَكرُبَا",52,"ب",2,0],["أبهموا الأمر على من أبهموا","ليتني أقدر أنفي الإنبهاما",53,"م",2,0],["أبهى عِذارٍ لعبدِ القادرِ انتَشَرَتْ","فيهِ نوافجُ مِسكٍ صُنعُ رَحْمانِ",54,"ن",1,1],["أبهى وأجملُ من ذكر الجمال ومن","إدمان ذكرِ هوىً يَهْوى على قَتَبِ",55,"ب",1,0],["أبها وأنهى لدى اليوم حين زهى","من در لفظ أتى من سبق نائي",56,"ا",2,0],["أبهى قرانٍ للأمير مباركٍ","بجمال كاسٍ في المسرَّة قد صفا",57,"ف",2,1],["أبهى الشمائلِ في الطافهِ جُمِعَت","مثل الثريا انجلت في الأُفقِ تشتهرُ",58,"ر",1,0],["أبهذا ومثل هذا صلاحٌ","لا وربّ الأنباء والانبياء",59,"ا",2,0],["أبّها الحالي رُضاباً ولَمَى","ضِمنَ دُرٍّ وَعَقيقٍ ألعَسِ",60,"س",1,1],["أبهجتَنا بنَدىً وطيبِ شمائلٍ","كالمِّزْن صبحاً طيّبِ البشراتِ",61,"ت",1,0],["أَبهى منَ القمرِ الوضّاح صورتها","وَطعم ريقها أَحلى من العسلِ",62,"ل",1,0],["أَبهجَ مما أَوْدَعَتْ طِرْسَهُ","يَدٌ لَها منه علينا أَياد",63,"د",1,0],["أبِهذا الوجهِ ترجو","من مليحِ الوجهِ قُبلَه",64,"ه",1,0],["ابهج الحي وابهى الطلا","ونفى الباس واشفى العللا",65,"ل",2,0],["أَبهرامُ شاهٍ قَرَّ عيناً بِريِّهِ","وإِروائِهِ صادٍ بِمدحِكَ صادِحُ",66,"ح",1,0],["أَبْهَى وأَجْمَلُ منْ وَصْفِ الجِمالِ ومنْ","إِدْمانِ ذِكْرِ هَوىً يَهْوي على قَتَبِ",67,"ب",1,0],["ابهذي العهود حالفت غيري","رحم الله واتقاً بوفاك",68,"ك",1,0],["أبهم وصف قدره واعدد أو أضف","فمبهم من الجهات قد عرف",69,"ف",1,0],["أبه نعى الناعي لها عمرو العُلى","أم شيبة الحمد انطوى بصعيد",70,"د",1,0],["أَبهر هرات طربربات غَرائب","من غامض التَشويق وَالتَبريح",71,"ح",1,0],["أَبهر هرات طربربات القدس","زارَت جنابك من رياض القدس",72,"س",1,0],["أَبِها ذَهابُ العَقلِ أَم عَتَبَت","فَأَزيدَها عَتباً عَلى عَتبِ",73,"ب",1,0],["أبهى وأبهج من مهاة نورها","في الليل يفتك بالظلام الدامس",74,"س",1,0],["أبهى وأبهج من شمس ومن قمرِ","بياض وجهٍ حباه اللَه بالخفرِ",75,"ر",1,1],["ابهرنا في آية ضمنت","سحر النهى لاسحر طرف الغرير",76,"ر",1,0],["أبهذا مثلى يجازى وأنتم","منكم المقلتان ناظرتان",77,"ن",1,0],["إبه فعندي من فراقك لوعة","يعزى إليها ثابت ويزيد",78,"د",1,0],["أبه حادي الرفاق حدا","أم له داعي الفراق عنا",79,"ن",2,0],["أبهذا السحب من آرامه","ما بقلبي فهي الدمع انسجاما",80,"م",2,0],["أَبهى المَصايِفِ ناعِماتُ شُطوطِنا","لَو كانَ يُبصِرُ مُنجِدٌ أَو مُتهِمُ",81,"م",1,0],["أَبها هاء محمد","بِكَريمة وَلدت بَهيه",82,"ي",2,0],["أَبهَتنَ لَما لُحنَ كُلَّ مُفَوَّهٍ","فَالطَرفُ مُعيٍ وَاللِسانُ عَيِيُّ",83,"ي",1,0],["أبهج بعيد أنت أحسن رونقا","منه وأعظم بهجة في المنظر",84,"ر",1,0],["ابهى وأحسن في سمع وفي بصر","من حسن تشطير هذا الفاضل العلم",85,"م",1,0],["أبهَت غَرابينا والاكواس","عودٍ عَلَى الموده تِثَنَّى",86,"ن",2,0],["أَبهى زَمان طيب الهَواء","ما لَيسَ بِالصَيف وَلا الشِتاءِ",87,"ا",2,1],["أبهاء ملك الدولة الغلرء","وأمينها السامي على الأمناء",88,"ا",2,1],["أبهجة قلب المجد قرة عينه","ومن بات فيه العدل سامي الدعائم",89,"م",1,1],["أبهارُ قَد هَيَّجتِ لي أَوجَاعا","وَتركتِني عَبداً لكم مِطوَاعا",90,"ع",2,1],["آبَ هذا اللَيلُ فَاِكتَنَعا","وَأَمَرَّ النَومُ وَاِمتَنَعا",91,"ع",2,1],["أَبهى مِن القَمرين أَصبَحَ لِلهُدى","نَجماً بِهِ فلكُ السعادة مُشرِقُ",92,"ق",1,0],["أبهى الحسان لدى عيون متيم","حسنّ أمام عيونهِ منصوب",93,"ب",1,0],["أبهذا الزمان وهو ما يي","أس منه هذي العطايا الجسام",94,"م",1,0],["أَبهَمت قَولك للمضنى لترشده","قَد كدت لَكنه في حَيّز العَدَم",95,"م",1,0],["أبهى نجوم سما العفاف وأرخوا","زهراً وقد زفت لبدر زاهر",96,"ر",1,0],["أبهى وَأطيَبُ نَشراً مِنكِ ناضِيَةً","بِكلَّةِ الخِدرِ ذا وَشيٍ وَأعلامِ",97,"م",1,0],["أبهر حسناً أحسنٌ باهر","أعظم قدراً صادرٌ واردُ",98,"د",1,0],["أبهرت الشمس لما بزغت","وعدت خافقة من وج