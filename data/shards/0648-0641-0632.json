{"poems":[[95,"كنا نود لك التكريم تلبسه","https://www.aldiwan.net/poem11344.html","البسيط"],[85,"الحمد لله بلغنا المنى","https://www.aldiwan.net/poem54239.html","السريع"],[53,"إذا كنت مضطري إلى القول بالذي","https://www.aldiwan.net/poem65845.html","الطويل"],[87,"ضج الحجاز وضج البيت والحرم","https://www.aldiwan.net/poem63747.html","البسيط"],[64,"أقول وقد غال الردى من أحبه","https://www.aldiwan.net/poem52429.html","الطويل"],[89,"إلى الله أشكو طول ليلي وجارة","https://www.aldiwan.net/poem8343.html","الطويل"],[107,"قدوم من أبي موسى الهمام","https://www.aldiwan.net/poem44016.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39548","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54316","الطويل"],[111,"عش ما نشاء وراقب فجعة الأجل","https://www.poetsgate.com/ViewPoem.aspx?id=520",""],[96,"الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=13793",""],[119,"شممنا لطيف المسك من رحب خرقة","https://www.aldiwan.net/poem42004.html","الطويل"],[208,"أخي لا تؤاخذني وإن كان لي","https://www.aldiwan.net/poem53356.html","الطويل"],[214,"أدر يا طلعة البدر","https://www.aldiwan.net/poem13362.html","مجزوء الوافر"],[301,"يا بالغا من بلاغة العرب","https://www.aldiwan.net/poem33333.html","المنسرح"],[332,"أفي القمة السكرى بخمر الأداهر","https://www.aldiwan.net/poem55056.html","الطويل"],[357,"أصاحي ما لطير العز صاحا","https://www.aldiwan.net/poem40543.html","الوافر"],[395,"عباد الله جيناكم قصدنا طلبناكم","https://www.aldiwan.net/poem54504.html","عموديه"],[406,"نعم هذه حزوى وتلك زرود","https://www.aldiwan.net/poem46908.html","الطويل"],[428,"عذلت امرءا في عشقه ليس يعذرك","https://www.aldiwan.net/poem26460.html","الطويل"],[433,"غدوت متيما وصبا فوادي","https://www.aldiwan.net/poem40524.html","الوافر"],[518,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[541,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[554,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"],[567,"لإبراهيم إقبال وسعد","https://www.aldiwan.net/poem898.html",""],[1164,"","https://poetry.dctabudhabi.ae/diwan/poem/18783","الطويل"]],"verses":[["وَفُزْ بِمَا شِئْتَ فِي دُنْيَاكَ مِنْ عَرَضٍ","يُرْضِيكَ فَالمَجْدُ رَاضٍ عَنْكَ وَالكَرَمُ",0,"م",1,0],["وفزت بالأجر وكَبْتِ العدى","وفزتَ بالعز وطيب الثنا",1,"ن",2,0],["وفز ببقاءِ البَعْدِ إن بقاءه","مدى الدهرِ واستأثِر بسابقةِ القَبْلِ",2,"ل",1,0],["وَفُزِّعَت في الخُدورِ الساعِياتُ لَهُ","الداعِياتُ وَقُربُ اللَهِ مُغتَنَمُ",3,"م",1,0],["وفُزْتُ بها من بعدِ يأسٍ وخَيْبَةٍ","كما استخرجَ الغَوَّاصُ لُؤلؤةَ البحرِ",4,"ر",1,0],["وَفُزِّعَتِ الأَنْعَامُ وَالْخَيْلُ فَانْبَرَتْ","تُجَاوِبُ بَعْضَاً فِي رُغَاءٍ وَتَصْهَالِ",5,"ل",1,0],["وَفُزْتَ بها حياةً ما لنفسٍ","تُجانِبُها سِوى الموتِ الزُّؤامِ",6,"م",1,0],["وفزِعتَ للأحلام والذِّكرِ","تبكي وتنشدُ رجعةَ الأمسِ",7,"س",1,0],["وفزتُ بوجهٍ من سنَا اللّهِ ضوؤه","كريمُ المحيّا لا قطوبٍ ولا جهْمِ",8,"م",1,0],["وفزت بالسنة الزهراء محتويا","على الاشارات والتفصيل والجمل",9,"ل",1,0],["وفزنا من النور المصون بلمحة","تقرّ بها عين ويندى بها قلب",10,"ب",1,0],["وفزنا وطبنا والإشارة أثبتت","حصول الأماني واتصال المكارم",11,"م",1,0],["وفزتُ بشيءٍ بين جدٍ ولعبةٍ","ويا رُبَّ جدٍ كان أوَّلَه اللّعْبُ",12,"ب",1,0],["وفز بالكأس والساقي","ولذ بالشمس والبدر",13,"ر",1,0],["وَفزتُ منها بوصلِ غانيَةٍ","ترفلُ في حُلَّة من الذَهبِ",14,"ب",1,0],["وفزعت أحلامي وأنسيتني غدى","وزدت فغلفت الظلام بحاضري",15,"ر",2,0],["وَفُز أَنّى ضَرَبت سِهام فَوزٍ","فَقَد أَعلى الزَمان لَكَ القِداحا",16,"ح",2,0],["وفزنا حين زرناكم فقوموا واشفعوا فينا","إلى الرحمن مولاكم",17,"م",1,0],["وفزتُ وقد نامتْ عيونُ عواذلي","من المرشف المعْسولِ بالعَلِّ والنَّهلِ",18,"ل",1,0],["وَفُزْتَ بِما تَهْوى وَصالَتْ عَلَى الْعِدَا","سُنُوكَ بِتَمْلِيكٍ عَلَيْهِمْ وَأَشْهُرُكْ",19,"ك",1,0],["وفزنا بالمسرة والتهاني","ننعم بين هاتيك النجادي",20,"د",2,0],["وفزت بألف من عطية فائز","مواهبه للصنع لا للتصنع",21,"ع",1,0],["وفُزتَ بِنَصرٍ حين لم يَنجُ منهمُ","سوى مَن على الساقَين من عُمرٍ فَرَّا",22,"ر",2,0],["وفُزتُم به من غير أنْ تتدنّسوا","بعارٍ وأنْ تُقْذَوْا عليه بذامِ",23,"م",1,0],["وفز بالخير في تاريخ عامٍ","بديع الفضل مولود مهنا",24,"ن",2,0],["وَفُزنا عَلى الأَيّامِ وَالحَربُ لاقِحٌ","بِجُردٍ حِسانٍ أَو برودٍ غَرائِرِ",25,"ر",1,0]]}