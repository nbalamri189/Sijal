{"poems":[[93,"كنا نود لك التكريم تلبسه","https://www.aldiwan.net/poem11344.html","البسيط"],[83,"الحمد لله بلغنا المنى","https://www.aldiwan.net/poem54239.html","السريع"],[51,"إذا كنت مضطري إلى القول بالذي","https://www.aldiwan.net/poem65845.html","الطويل"],[85,"ضج الحجاز وضج البيت والحرم","https://www.aldiwan.net/poem63747.html","البسيط"],[62,"أقول وقد غال الردى من أحبه","https://www.aldiwan.net/poem52429.html","الطويل"],[87,"إلى الله أشكو طول ليلي وجارة","https://www.aldiwan.net/poem8343.html","الطويل"],[105,"قدوم من أبي موسى الهمام","https://www.aldiwan.net/poem44016.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39548","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54316","الطويل"],[113,"شممنا لطيف المسك من رحب خرقة","https://www.aldiwan.net/poem42004.html","الطويل"],[202,"أخي لا تؤاخذني وإن كان لي","https://www.aldiwan.net/poem53356.html","الطويل"],[208,"أدر يا طلعة البدر","https://www.aldiwan.net/poem13362.html","مجزوء الوافر"],[295,"يا بالغا من بلاغة العرب","https://www.aldiwan.net/poem33333.html","المنسرح"],[326,"أفي القمة السكرى بخمر الأداهر","https://www.aldiwan.net/poem55056.html","الطويل"],[351,"أصاحي ما لطير العز صاحا","https://www.aldiwan.net/poem40543.html","الوافر"],[388,"عباد الله جيناكم قصدنا طلبناكم","https://www.aldiwan.net/poem54504.html","عموديه"],[399,"نعم هذه حزوى وتلك زرود","https://www.aldiwan.net/poem46908.html","الطويل"],[421,"عذلت امرءا في عشقه ليس يعذرك","https://www.aldiwan.net/poem26460.html","الطويل"],[426,"غدوت متيما وصبا فوادي","https://www.aldiwan.net/poem40524.html","الوافر"],[513,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[536,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[549,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"],[562,"لإبراهيم إقبال وسعد","https://www.aldiwan.net/poem898.html",""]],"verses":[["وَفُزْ بِمَا شِئْتَ فِي دُنْيَاكَ مِنْ عَرَضٍ","يُرْضِيكَ فَالمَجْدُ رَاضٍ عَنْكَ وَالكَرَمُ",0,"م",1,0],["وفزت بالأجر وكَبْتِ العدى","وفزتَ بالعز وطيب الثنا",1,"ن",2,0],["وفز ببقاءِ البَعْدِ إن بقاءه","مدى الدهرِ واستأثِر بسابقةِ القَبْلِ",2,"ل",1,0],["وَفُزِّعَت في الخُدورِ الساعِياتُ لَهُ","الداعِياتُ وَقُربُ اللَهِ مُغتَنَمُ",3,"م",1,0],["وفُزْتُ بها من بعدِ يأسٍ وخَيْبَةٍ","كما استخرجَ الغَوَّاصُ لُؤلؤةَ البحرِ",4,"ر",1,0],["وَفُزِّعَتِ الأَنْعَامُ وَالْخَيْلُ فَانْبَرَتْ","تُجَاوِبُ بَعْضَاً فِي رُغَاءٍ وَتَصْهَالِ",5,"ل",1,0],["وَفُزْتَ بها حياةً ما لنفسٍ","تُجانِبُها سِوى الموتِ الزُّؤامِ",6,"م",1,0],["وفزِعتَ للأحلام والذِّكرِ","تبكي وتنشدُ رجعةَ الأمسِ",7,"س",1,0],["وفزتُ بوجهٍ من سنَا اللّهِ ضوؤه","كريمُ المحيّا لا قطوبٍ ولا جهْمِ",8,"م",1,0],["وفزنا وطبنا والإشارة أثبتت","حصول الأماني واتصال المكارم",9,"م",1,0],["وفزتُ بشيءٍ بين جدٍ ولعبةٍ","ويا رُبَّ جدٍ كان أوَّلَه اللّعْبُ",10,"ب",1,0],["وفز بالكأس والساقي","ولذ بالشمس والبدر",11,"ر",1,0],["وَفزتُ منها بوصلِ غانيَةٍ","ترفلُ في حُلَّة من الذَهبِ",12,"ب",1,0],["وفزعت أحلامي وأنسيتني غدى","وزدت فغلفت الظلام بحاضري",13,"ي",1,0],["وَفُز أَنّى ضَرَبت سِهام فَوزٍ","فَقَد أَعلى الزَمان لَكَ القِداحا",14,"ح",2,0],["وفزنا حين زرناكم فقوموا واشفعوا فينا","إلى الرحمن مولاكم",15,"م",1,0],["وفزتُ وقد نامتْ عيونُ عواذلي","من المرشف المعْسولِ بالعَلِّ والنَّهلِ",16,"ل",1,0],["وَفُزْتَ بِما تَهْوى وَصالَتْ عَلَى الْعِدَا","سُنُوكَ بِتَمْلِيكٍ عَلَيْهِمْ وَأَشْهُرُكْ",17,"ك",1,0],["وفزنا بالمسرة والتهاني","ننعم بين هاتيك النجادي",18,"ي",1,0],["وفزت بألف من عطية فائز","مواهبه للصنع لا للتصنع",19,"ع",1,0],["وفُزتَ بِنَصرٍ حين لم يَنجُ منهمُ","سوى مَن على الساقَين من عُمرٍ فَرَّا",20,"ر",2,0],["وفُزتُم به من غير أنْ تتدنّسوا","بعارٍ وأنْ تُقْذَوْا عليه بذامِ",21,"م",1,0],["وفز بالخير في تاريخ عامٍ","بديع الفضل مولود مهنا",22,"ن",2,0]]}