{"poems":[[93,"كنا نود لك التكريم تلبسه","https://www.aldiwan.net/poem11344.html","البسيط"],[83,"الحمد لله بلغنا المنى","https://www.aldiwan.net/poem54239.html","السريع"],[51,"إذا كنت مضطري إلى القول بالذي","https://www.aldiwan.net/poem65845.html","الطويل"],[85,"ضج الحجاز وضج البيت والحرم","https://www.aldiwan.net/poem63747.html","البسيط"],[62,"أقول وقد غال الردى من أحبه","https://www.aldiwan.net/poem52429.html","الطويل"],[87,"إلى الله أشكو طول ليلي وجارة","https://www.aldiwan.net/poem8343.html","الطويل"],[105,"قدوم من أبي موسى الهمام","https://www.aldiwan.net/poem44016.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39548","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54316","الطويل"],[94,"الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=13793",""],[115,"شممنا لطيف المسك من رحب خرقة","https://www.aldiwan.net/poem42004.html","الطويل"],[204,"أخي لا تؤاخذني وإن كان لي","https://www.aldiwan.net/poem53356.html","الطويل"],[210,"أدر يا طلعة البدر","https://www.aldiwan.net/poem13362.html","مجزوء الوافر"],[297,"يا بالغا من بلاغة العرب","https://www.aldiwan.net/poem33333.html","المنسرح"],[328,"أفي القمة السكرى بخمر الأداهر","https://www.aldiwan.net/poem55056.html","الطويل"],[353,"أصاحي ما لطير العز صاحا","https://www.aldiwan.net/poem40543.html","الوافر"],[391,"عباد الله جيناكم قصدنا طلبناكم","https://www.aldiwan.net/poem54504.html","عموديه"],[402,"نعم هذه حزوى وتلك زرود","https://www.aldiwan.net/poem46908.html","الطويل"],[424,"عذلت امرءا في عشقه ليس يعذرك","https://www.aldiwan.net/poem26460.html","الطويل"],[429,"غدوت متيما وصبا فوادي","https://www.aldiwan.net/poem40524.html","الوافر"],[515,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[538,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[551,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"],[564,"لإبراهيم إقبال وسعد","https://www.aldiwan.net/poem898.html",""]],"verses":[["وَفُزْ بِمَا شِئْتَ فِي دُنْيَاكَ مِنْ عَرَضٍ","يُرْضِيكَ فَالمَجْدُ رَاضٍ عَنْكَ وَالكَرَمُ",0,"م",1,0],["وفزت بالأجر وكَبْتِ العدى","وفزتَ بالعز وطيب الثنا",1,"ن",2,0],["وفز ببقاءِ البَعْدِ إن بقاءه","مدى الدهرِ واستأثِر بسابقةِ القَبْلِ",2,"ل",1,0],["وَفُزِّعَت في الخُدورِ الساعِياتُ لَهُ","الداعِياتُ وَقُربُ اللَهِ مُغتَنَمُ",3,"م",1,0],["وفُزْتُ بها من بعدِ يأسٍ وخَيْبَةٍ","كما استخرجَ الغَوَّاصُ لُؤلؤةَ البحرِ",4,"ر",1,0],["وَفُزِّعَتِ الأَنْعَامُ وَالْخَيْلُ فَانْبَرَتْ","تُجَاوِبُ بَعْضَاً فِي رُغَاءٍ وَتَصْهَالِ",5,"ل",1,0],["وَفُزْتَ بها حياةً ما لنفسٍ","تُجانِبُها سِوى الموتِ الزُّؤامِ",6,"م",1,0],["وفزِعتَ للأحلام والذِّكرِ","تبكي وتنشدُ رجعةَ الأمسِ",7,"س",1,0],["وفزتُ بوجهٍ من سنَا اللّهِ ضوؤه","كريمُ المحيّا لا قطوبٍ ولا جهْمِ",8,"م",1,0],["وفزنا من النور المصون بلمحة","تقرّ بها عين ويندى بها قلب",9,"ب",1,0],["وفزنا وطبنا والإشارة أثبتت","حصول الأماني واتصال المكارم",10,"م",1,0],["وفزتُ بشيءٍ بين جدٍ ولعبةٍ","ويا رُبَّ جدٍ كان أوَّلَه اللّعْبُ",11,"ب",1,0],["وفز بالكأس والساقي","ولذ بالشمس والبدر",12,"ر",1,0],["وَفزتُ منها بوصلِ غانيَةٍ","ترفلُ في حُلَّة من الذَهبِ",13,"ب",1,0],["وفزعت أحلامي وأنسيتني غدى","وزدت فغلفت الظلام بحاضري",14,"ي",1,0],["وَفُز أَنّى ضَرَبت سِهام فَوزٍ","فَقَد أَعلى الزَمان لَكَ القِداحا",15,"ح",2,0],["وفزنا حين زرناكم فقوموا واشفعوا فينا","إلى الرحمن مولاكم",16,"م",1,0],["وفزتُ وقد نامتْ عيونُ عواذلي","من المرشف المعْسولِ بالعَلِّ والنَّهلِ",17,"ل",1,0],["وَفُزْتَ بِما تَهْوى وَصالَتْ عَلَى الْعِدَا","سُنُوكَ بِتَمْلِيكٍ عَلَيْهِمْ وَأَشْهُرُكْ",18,"ك",1,0],["وفزنا بالمسرة والتهاني","ننعم بين هاتيك النجادي",19,"ي",1,0],["وفزت بألف من عطية فائز","مواهبه للصنع لا للتصنع",20,"ع",1,0],["وفُزتَ بِنَصرٍ حين لم يَنجُ منهمُ","سوى مَن على الساقَين من عُمرٍ فَرَّا",21,"ر",2,0],["وفُزتُم به من غير أنْ تتدنّسوا","بعارٍ وأنْ تُقْذَوْا عليه بذامِ",22,"م",1,0],["وفز بالخير في تاريخ عامٍ","بديع الفضل مولود مهنا",23,"ن",2,0]]}