w.poetsgate.com/ViewPoem.aspx?id=201626",""],[5102,"دعاء الصباح في هجاء \"نور الفلالح\"","https://www.poetsgate.com/ViewPoem.aspx?id=59818",""],[5122,"نصيحة في عجالة","https://www.poetsgate.com/ViewPoem.aspx?id=31515",""],[5139,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=68955",""],[5183,"الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=186473",""],[5183,"معنى الوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=186497",""],[5219,"حبيبي يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=193706",""],[5260,"الْعلم قَالَ الله قَالَ رَسُوله","https://www.poetsgate.com/ViewPoem.aspx?id=190430",""],[592,"لعمرك ما يدري الغبي بأنه","https://www.poetsgate.com/ViewPoem.aspx?id=128805",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5463,"قلبك أسود","https://www.poetsgate.com/ViewPoem.aspx?id=33699",""],[5650,"امْلأْ فُؤادَكَ بِالْحَبيب","https://www.poetsgate.com/ViewPoem.aspx?id=131222",""],[2599,"يا حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=14019",""],[4623,"كتمت الهوى لكن نحولي به باحا ومن (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146769",""],[5790,"يا أيها الناس اعملوا لمعادكم","https://www.poetsgate.com/ViewPoem.aspx?id=111963",""],[5818,"بثامن آيةٍ في العادياتِ","https://www.poetsgate.com/ViewPoem.aspx?id=199689",""],[5836,"كسر القلوب وجرح المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=194776",""],[5936,"اللي تخلى عنك لازم تخليه","https://www.poetsgate.com/ViewPoem.aspx?id=184775",""],[5939,"أسيرتي","https://www.poetsgate.com/ViewPoem.aspx?id=129125",""],[5939,"اخضعي","https://www.poetsgate.com/ViewPoem.aspx?id=195299",""],[6031,"أَلجَفْنٍ أَرَّقتُموهُ هُجُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=46277",""],[242,"يا حسنه والحسن قيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563695",""]],"verses":[["وَحَذَّرَهُم مِنّي فُؤادٌ مُشَيَّعٌ","وَعَزمٌ لِأَقانِ الرِجالِ قَطوعُ",0,"ع",1,0],["وَحَذارِ مِن وَبِلِ العِقابِ وَقَد بَدَت","مِلءَ العُيونِ بَوارِقٌ وَرُعودُ",1,"د",1,0],["وَحَذَّرتُكُم مُغلَولِباً ذا غُطامِطٍ","إِذا كَبَّ بوصِيَّ السَفينِ وَأَزبَدا",2,"د",2,0],["وَحَذَّرْتُهَا عُقْبَى الْخَلِيلِ فَإِنَّمَا","يَعُودُ بِإِخْلاَلِ عَلَيْهَا خَلِيلُهَا",3,"ل",3,0],["وحَذارِ منْ شَرَرِ الحَشا أنْ تَسْألي","فإذا قدَحْتِ الزّنْدَ طارَ شَرارُهُ",4,"ر",2,0],["وَحَذَرْتَ لِي عُقْبَي الْقَطِيعَةِ جَاهِداً","وَهِيَ الطَّرِيقَةُ وَالسَّبِيلُ الأَصْوَبُ",5,"ب",1,0],["وَحَذِرتُ بَعدَ المَوتِ يَو","مَ تَشينُ أَسماءُ الجَبينا",6,"ن",2,0],["وَحَذارِ أَشراكَ السِياسَةِ إِنَّها","بِنتٌ أَبوها الزِئبَقُ الفَرّارُ",7,"ر",1,0],["وَحِذاءٍ أَوشَكَت تَفلَتُ مِنهُ قَدَماهُ","قالَ صِف جاهي فَفي وَصفِكَ لي لِلشِعرِ جاهُ",8,"ه",1,0],["وَحَذارِ مِن دَمِها الزَكِيِّ تُريقُهُ","يَكفيكَ يا قاسي دَمُ العُشّاقِ",9,"ق",1,0],["وَحَذَّرتُكُم أَن تَركَبوا الغَيَّ سادِراً","فَيَطرَحَكُم في موبِقاتِ المَطارِحِ",10,"ح",1,0],["وحذَّرني أن يُستباحَ حريمُه","تذكُّرُ بَيتٍ يَقطعُ الأرضَ جَوَّالِ",11,"ل",1,0],["وَحَذارِ أنْ يَثِقَ المُرِيدُ بِنَفْسِهِ","وَاحْزِمْ فما الإِصْلاحُ شَأْنُ المُفْسِدِ",12,"د",1,0],["وَحَذِّرها المُنَجِّمَ فَهوَ ذِئبٌ","تُشَوِّقُهُ الضَوائِنُ أَن يَراها",13,"ا",3,0],["وحَذْرُ الفَوْتِ وحُبُّ الإسْرَاعْ","فانْصَرَفُوا وناقَتي بالجَعْجَاع",14,"ع",1,0],["وَحَذَّرَ الحُزْنُ أَخَادِيدَهِ","سَفْعاً بِذَاكَ الوَضحِ النَّاصِعِ",15,"ع",1,0],["وَحَذَوْتَ حَذْوَهُمَا عَلى قَدَرٍ وَمِنْ","لُبِّ الصِّوَابِ الجُودُ بِالمُتَيَسرِ",16,"ر",1,0],["وحذرتها عقبى الخليل فإنها","يعود بإخلال عليها خليلها",17,"ل",3,0],["وکحْذَري أَنْ تَراكِ عَيْنٌ وَإنْ لا","تِ بعضَ المكثرينَ الأعادي",18,"د",2,0],["وَحذَّرني بَغضَاءَ بَعدَ مَوَدَّةٍ","مَخَافَةَ مَا يُفضِى إِلَى الشَّنَآنِ",19,"ن",1,0],["وحذَّرنى من الأحبابِ أنّى","رأيتُ دَماً لعُروةَ كيف طُلاَّ",20,"ل",2,0],["وحِذرتُ سُلوانا فسُمتُهُمُ","أن يَحرِمونى لذّةَ الوصلِ",21,"ل",1,0],["وحذرتهم من ربهم فتضاحكوا","وويلٌ لمن ربُّ السماءِ له خصمُ",22,"م",1,0],["وحذرك العذال ما يعرفونه","وسمعك مسدود فما نفع العذل",23,"ل",1,0],["وحذفك الذي به يصدر","وما تلا الأخير حتماً يكسر",24,"ر",1,0],["وحذفه من أصل أو نظير أو","فرع لغير علة كما حكوا",24,"ك",3,0],["وحذَّرَتْني من أَذَى قَومِها","حتى إذا لم يَبْدُ منّي الحِذَار",25,"ر",1,0],["وَحَذَارِ صُحْبَةَ نَاقِصٍ","وَتَرَاكِ مَن يَأْبَى وَيَأْبَدْ",26,"د",1,0],["وحذّر الرومَ من أهوالِ قارعةٍ","فيها نكبّ على الخدّينِ منكابا",27,"ب",2,0],["وَحذر على أنسٍ وطيب طويّةٍ","وَنجدة حرٍّ حلفها الرأيُ والصبرُ",28,"ر",1,0],["وَحَذّرتها مِن بَأس قَومي وَأَنَّهُم","عَلى كُلِّ نَجديٍّ بَغوا نَجدتي طرفِ",29,"ف",1,0],["وَحَذَّرَهُم مَن كانَ يُعنى بِأَمرِهِم","وَما يَنفَعُ التَحذيرُ عِندَ اِنقِضا الأَمرِ",30,"ر",1,0],["وحذيفه يقول كان الرجل","في زمان النبي خير الرسل",31,"ل",1,0],["وَحَذَفتُ أُختَ الشينِ مِن","ها عَن طلابِ أَخٍ معانِد",32,"د",1,0],["وحذارَ مِنْ وادي النَّقا والسَّفحِ مِنْ","أضم فَثمَّ مصَارعُ الآسادِ",33,"د",1,0],["وحذارِ مِنْ تِلكَ الظباءِ فما لَها","في الحُبِّ لا عَهْدٌ ولا مِيثاقُ",34,"ق",1,0],["وحذار ثم حذار من قول امرىء","يأتي بضد النص أو تأويله",35,"ل",2,0],["وحَذارِ مِن سَفَهٍ يَشِينُكُ وَصمُهُ","إنَّ التَّسَفُّهَ بالمُروءةِ زارِ",36,"ر",1,0],["وحذَّرهم من قبل ذلك بطشه","وأَمْهَلَهُمْ شهراً وزادَ على الشهر",37,"ر",1,0],["وحذرتك الدهياء قبل وقوعها","وأَوضحتها والحازم الرأي الَّذي يوضح",38,"ح",1,0],["وحذرتُ حتى كان يوم سويقة","فوقعتُ من جفنيكِ في إشراك",39,"ك",1,0],["وحذار من نهشات صل أرقط","ظام ومن بطشات ليث عاد",40,"د",1,0],["وحذوت في الإحسان حذو مثاله","وهو الذي نصب المثال لخاطري",41,"ر",2,0],["وحَذَفْتَني والْقَلْبُ ظَرفُ مَوَدَّةٍ","يا مَنْ تُسَبِّبُ للعَذُولِ وفِيله",42,"ل",2,0],["وحَذَفْتَ عائِدَكَ الّذي","عَوَّدْتَني مِنْ قَبْلُ حَذْفا",43,"ف",2,0],["وحذرتُ دهرِي من أمورٍ جمّةٍ","فأناخَ فيه الأمنُ وسْطَ فؤادِي",44,"د",2,0],["وَحَذَري ما لَيسَ بِالمَحذورِ","وَقَذَري ما لَيسَ بِالمَقذورِ",45,"ر",1,0],["وحَذِرْتُ هَتْكَ السِّتْرِ منك وقَدْ","أَوقَعْتِني في كل مَحْذُورِ",46,"ر",1,0],["وَحَذِرْتُ سَهْمَ فِرَاقِكُمْ حَتَّى إِذَا","أَرْسَلْتُموه أَصَابَنِي في المَقْتَلِ",47,"ل",1,0],["وحذا يؤانس حذوهم برحيله","في البر أو بركوبوه لبحار",48,"ر",1,0],["وَحَذارِ مِن تَعنيفِهِ فَعَدُؤُّهُ","مَن لامَ في صَبَواتِهِ أو عَنَّفا",49,"ف",2,0],["وَحَذا حَذوه النَجيب أَبو النَص","ر سَميّ الخَليل في قَمع ضد",50,"د",1,0],["وحذرتها من دولة الترك فارعوت","فكنت بها منها أبر وأرحما",51,"م",2,0],["وحذار مخضوب البنا","ن اذا تمكن من فؤادي",52,"د",2,0],["وحذْرك من هذا وهذا وذا وكنْ","كأنك في قفرٍ به تحذرُ السبْعا",53,"ع",2,0],["وحذروا الأنفسَ من ظلمها","فإنه لا يُفلح الظالمون",54,"ن",1,0],["وحذار ثم حذار من جزع اللوا","فظباؤه ترعى بواد مسبع",55,"ع",1,0],["وحذار من دنياك إن عذبيها","ملح وحلو طعامها كالحنظل",56,"ل",1,0],["وحذاريا جهلاء بعد النصح أن","تلجو بأبحرها الزواخر تغرقوا",57,"ق",3,0],["وحذفها يجوز إلا أن تلي","لكن أو عن وأنّ فاجتلي",58,"ي",1,0],["وحذف معلوم يجوز منهما","مبتدإ أو خبر أو فهما",58,"م",2,0],["وحذفها فاش وابقاء الخبر","مع لو وإن ومع سواهما ندر",58,"ر",1,0],["وحذفها عند النحاة أولى","وأعمل الفعل كنعم المولى",58,"ل",2,0],["وحذفها إسقاط تن من فاعلا","تن ولفاعلن به كن ناقلا",59,"ل",2,0],["وحذوها حركة الحرف الذي","مقامه من قبل ردفه احتذي",59,"ي",1,0],["وحذوها والرس لن يجتمعا","كألف التأسيس والردف معا",59,"ع",2,0],["وحذف تنوين ويا مضاف","والثان والنسبة غير خاف",59,"ف",1,0],["وحذف نون لم يكن ولكن","من الذين جاز في أماكن",59,"ن",1,0],["وحذف ياء كالذي والنون في","رفع مضارع بمضمر يفي",59,"ي",1,0],["وحذف واو الحال يستطاب","ويقعد الأير له لعاب",59,"ب",1,0],["وحذف مقصور لدى وقف بأل","ضرورة مشهورة كأبن المعل",59,"ل",1,0],["وحذار من خلع العذار على الديا","ر ووقفة الزوّار بين الأربع",60,"ع",1,0],["وحذّر الّلي في الوطن يلعب كثير","وكم واحد قبل عرسه زوّره",61,"ر",2,0],["وحذرني من وشاة الحمى","وقال السلام على من صبر",62,"ر",1,0],["وحذار من سعي الوشاة فإنّهم","يقفون للأحرار بالمرصاد",63,"د",1,0],["وحذوتَ حَذْوَ أبيكَ تَرْمِي بالندى","صَرْفَ الزمان وَتَتَّقي بالباس",64,"س",1,0],["وَحَذارِ البُكا بِتِلكَ الأَماكِن","غَيرَ شَدوٍ عَلى الأَسى وَالعَناءِ",65,"ا",2,0],["وحذرك المأخوذ من ذا اليوم","تأويله الذي إليه تومي",66,"ي",1,0],["وحذّرتهم طعناً يفك إلى العلا","من الحلق الماذيّ نظم عيونه",67,"ن",2,0],["وحذا الركن فاسأل الله حسناً","في جميع الدارين وادع ابتهالا",68,"ل",2,0],["وحذره من جور القراءة عامدا","وبين له الإدغام والجزم في الأمر",69,"ر",1,0],["وحذارِ إن جاشت غوارب يَمِّه","لا تغرقنك ماطرات سحابه",70,"ب",2,0],["وَحَذارِ مِن كَلأ الجَزيرَةِ إِنَّهُ","مَرعى بِأَطرافِ الرِّماحِ وَبيلُ",71,"ل",1,0],["وحذارِ أن تنسوا قديمَ مَوَدَتي","إني لأذكرُ كلّ مَنْ ينساني",72,"ن",2,0],["وحذرني أموراً سوف تأتي","أهز لها الصوارم والرماحا",73,"ح",2,0],["وحذره منا ما أطاق وقل له","إذا ما أغظت الليث فالليث واثب",74,"ب",1,0],["وَحَذرَكَ مِن قَبلِهَا الما سَبعَه","قَبلَ قَفَاصي فَىعرِفَنَّ وَقعَه",75,"ه",1,0],["وَحذفه للحولِ وَالإبهامِ","وَالوَزن وَالتَحقير وَالإعظام",76,"م",1,1],["وحذار ألحاظ العيون فغمزها","بالنبل عن قوس الحواجب قاذف",77,"ف",1,0],["وحذار من ليث العرين ومن غدا","في كل في قرنه يتخلف",78,"ف",1,0],["وحِذاركم نظرَ الوُشاة بوقفةٍ","كادَ الفراقُ بها يكونُ شفيعي",79,"ع",2,0],["وحَذِرتُ في الاخلاقِ من بَطَرِ الغنى","ومذلةٍ الاملاقِ ما لا تَحذرِ",80,"ر",1,0],["وَحَذفُهَا لِلجَزم وَالنَّصبِ سِمَه","كَلَم تَكُونِى لِتَرومِى مَظلمَه",81,"ه",1,0],["وَحَذفَ أل ذِى إن تُنَادِ أو تُضِف","أوجِب وَفى غَيرِهِمَا قَد تَنحَذِف",81,"ف",1,0],["وَحَذفُ مَا يُعلَمُ جَائِزٌ كَما","تَقُولُ زَيدٌ بَعدَ مَن عِندَ كُمَا",81,"م",2,0],["وَحَذفَ فَضلَةِ أجِز إن لَم يَضِر","كَحذفِ مَا سِيقَ جوَاباً أو حُصِر",81,"ر",1,0],["وَحَذفُ عِأمِلِ المُؤكِّدِ امتَنَع","وَفِى سِوَاهُ لِدَلِيلٍ مُتَّسَع",81,"ع",1,0],["وَحُذِفَت رُبَّ فَجرَّت بَعدَ بَل","وَالفَاوَ وَبَعدَ الوَاوِ شَاعَ ذَا العَمل",81,"ل",1,0],["وَحَذفَ مَا مِنهُ تَعَجَّبتَ استَبِح","إن كانَ عِندَ الحَذفِ مَعنَاهُ يَضِح",81,"ح",1,0],["وَحَذفَ مَتبُوعٍ بَدَا هُنا استَبِح","وَعَطفُكَ الفِعلَ علَى الفِعلِ يَصِحّ",81,"ح",1,0],["وَحَذفُ ذِى الفَاقَلَّ فِى نَثرٍ إذَا","لَم يَكُ قَولٌ مَعَها قَد نُبِذَا",81,"ذ",2,0],["وَحذفُ يَا المَنقُوصِ ذِى التَّنوِينِ مَا","لم يُنصَبَ أولَى مشن ثُبُوتٍ فَاعلَمَا",81,"م",2,0],["وَحَذفُ هِمزِ أفعَلَ استَمَرَّ فِى","مُضَارِعِ وَبِنيَتَى مُتَّصِفِ",81,"ف",1,0],["وَحَذارِ وَقع صَواعقه","فالسمّ كَمين في العَسَل",82,"ل",1,0],["وحَذاهُ ديديُمس وانَّ كِلَيهما","حُرما معاً بالإِسم والعُنوانِ",83,"ن",1,0],["وحذار دعوى معشر","لم يؤمنوا بالحق ربا",84,"ب