{"poems":[[53,"خصيم من الأيام لي وشفيع","https://www.aldiwan.net/poem30151.html","الطويل"],[53,"أنظر إلى الأيام كيف تعود","https://www.aldiwan.net/poem30626.html","الكامل"],[53,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[77,"أخي فترة السلوان جاء رسولها","https://www.aldiwan.net/poem36371.html","الطويل"],[77,"يا ربة البيت الممنع جاره","https://www.aldiwan.net/poem36516.html","الكامل"],[77,"زارت وقد صرف العنان الغيهب","https://www.aldiwan.net/poem36776.html","الكامل"],[4,"أنبئت أن أبا حنيف","https://www.aldiwan.net/poem21209.html","مجزوء الكامل"],[91,"قالوا قضى موسى فقلت قد انطوى","https://www.aldiwan.net/poem8827.html","عموديه"],[91,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[85,"رمضان ولى هاتها يا ساقي","https://www.aldiwan.net/poem63705.html","الكامل"],[45,"نهيتكم عن صالح فأبى بكم","https://www.aldiwan.net/poem62707.html","الطويل"],[61,"رمى الله رئبال القريض برئبال","https://www.aldiwan.net/poem51468.html","الطويل"],[67,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[46,"إذا ابتكرت إلى العراف فاعرف","https://www.aldiwan.net/poem23580.html","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16697","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55011","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54882","الكامل"],[77,"أفي فترة السلوان جاء رسلوها","https://www.poetsgate.com/ViewPoem.aspx?id=34154",""],[31,"طَالَ لَيْلي فَمَا أُحِسُّ رُقَادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18821&r=&rc=84",""],[133,"أبان اصطباري بين أم أبان","https://www.aldiwan.net/poem54702.html","الطويل"],[143,"أؤمل بعد هذا الأسر حلا","https://www.aldiwan.net/poem58406.html","الطويل"],[143,"شدوا على ظهر الصبا رحلى","https://www.aldiwan.net/poem58410.html","السريع"],[161,"تألق نور العدل وانطفأ الظلم","https://www.aldiwan.net/poem58882.html","الطويل"],[161,"اقرت رؤسا في الطلا هذه الرسل","https://www.aldiwan.net/poem58966.html","الطويل"],[223,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[230,"يا لائمي في أن خلعت العذار","https://www.aldiwan.net/poem51030.html","السريع"],[238,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[271,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[306,"على مثلها من أنعم يجب الشكر","https://www.aldiwan.net/poem56549.html","الطويل"],[354,"بدت لك شمس الخدر من فلق السجف","https://www.aldiwan.net/poem40039.html","الطويل"],[367,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[392,"أيها العبد إن شئت الأمان","https://www.aldiwan.net/poem54475.html","عموديه"],[394,"يا وصل مالك لا تعاود","https://www.aldiwan.net/poem53658.html","مجزوء الكامل"],[403,"كم ذا يذوب أسى وكم يتجلد","https://www.aldiwan.net/poem46938.html","الكامل"],[403,"لو كان يعلم أنها الأحداق","https://www.aldiwan.net/poem46984.html","الكامل"],[404,"هذي مناسك أحمد وصفاته","https://www.aldiwan.net/poem33477.html","الكامل"],[406,"إن كنت تطلب رتبة الأحرار","https://www.aldiwan.net/poem49941.html","الكامل"],[417,"لقد خفقت في النحر ألوية النصر","https://www.aldiwan.net/poem54141.html","الطويل"],[442,"نضحتك لو طاوعت من لك ينصح","https://www.aldiwan.net/poem14424.html","الطويل"],[465,"ما كنت بالباكي ولا المتباكي","https://www.aldiwan.net/poem3512.html","عموديه"],[516,"عادت عليك أهلة الأعياد","https://www.aldiwan.net/poem12061.html","الكامل"],[516,"هنئت مفتتح الصيام السافر","https://www.aldiwan.net/poem12120.html","الكامل"],[530,"أطلقت دمعي بعد تقييد الهوى","https://www.aldiwan.net/poem37213.html","الكامل"],[530,"مكحولة الحدقات وطفا","https://www.aldiwan.net/poem37321.html","مجزوء الكامل"],[552,"قم فاثن لي فوق الوهاد وسادي","https://www.aldiwan.net/poem47843.html","الكامل"],[562,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[576,"فرطت فيك بسوء تدبيري","https://www.aldiwan.net/poem2951.html","الهزج"],[587,"قابلت عز هواكم بتذلل","https://www.aldiwan.net/poem17666.html","الكامل"]],"verses":[["وَحَذَّرَهُم مِنّي فُؤادٌ مُشَيَّعٌ","وَعَزمٌ لِأَقانِ الرِجالِ قَطوعُ",0,"ع",1,0],["وَحَذارِ مِن وَبِلِ العِقابِ وَقَد بَدَت","مِلءَ العُيونِ بَوارِقٌ وَرُعودُ",1,"د",1,0],["وَحَذَّرتُكُم مُغلَولِباً ذا غُطامِطٍ","إِذا كَبَّ بوصِيَّ السَفينِ وَأَزبَدا",2,"د",2,0],["وَحَذَّرْتُهَا عُقْبَى الْخَلِيلِ فَإِنَّمَا","يَعُودُ بِإِخْلاَلِ عَلَيْهَا خَلِيلُهَا",3,"ل",3,0],["وحَذارِ منْ شَرَرِ الحَشا أنْ تَسْألي","فإذا قدَحْتِ الزّنْدَ طارَ شَرارُهُ",4,"ر",2,0],["وَحَذَرْتَ لِي عُقْبَي الْقَطِيعَةِ جَاهِداً","وَهِيَ الطَّرِيقَةُ وَالسَّبِيلُ الأَصْوَبُ",5,"ب",1,0],["وَحَذِرتُ بَعدَ المَوتِ يَو","مَ تَشينُ أَسماءُ الجَبينا",6,"ن",2,0],["وَحَذارِ أَشراكَ السِياسَةِ إِنَّها","بِنتٌ أَبوها الزِئبَقُ الفَرّارُ",7,"ر",1,0],["وَحِذاءٍ أَوشَكَت تَفلَتُ مِنهُ قَدَماهُ","قالَ صِف جاهي فَفي وَصفِكَ لي لِلشِعرِ جاهُ",8,"ه",1,0],["وَحَذارِ مِن دَمِها الزَكِيِّ تُريقُهُ","يَكفيكَ يا قاسي دَمُ العُشّاقِ",9,"ق",1,0],["وَحَذَّرتُكُم أَن تَركَبوا الغَيَّ سادِراً","فَيَطرَحَكُم في موبِقاتِ المَطارِحِ",10,"ح",1,0],["وحذَّرني أن يُستباحَ حريمُه","تذكُّرُ بَيتٍ يَقطعُ الأرضَ جَوَّالِ",11,"ل",1,0],["وَحَذارِ أنْ يَثِقَ المُرِيدُ بِنَفْسِهِ","وَاحْزِمْ فما الإِصْلاحُ شَأْنُ المُفْسِدِ",12,"د",1,0],["وَحَذِّرها المُنَجِّمَ فَهوَ ذِئبٌ","تُشَوِّقُهُ الضَوائِنُ أَن يَراها",13,"ا",3,0],["وحَذْرُ الفَوْتِ وحُبُّ الإسْرَاعْ","فانْصَرَفُوا وناقَتي بالجَعْجَاع",14,"ع",1,0],["وَحَذَّرَ الحُزْنُ أَخَادِيدَهِ","سَفْعاً بِذَاكَ الوَضحِ النَّاصِعِ",15,"ع",1,0],["وَحَذَوْتَ حَذْوَهُمَا عَلى قَدَرٍ وَمِنْ","لُبِّ الصِّوَابِ الجُودُ بِالمُتَيَسرِ",16,"ر",1,0],["وحذرتها عقبى الخليل فإنها","يعود بإخلال عليها خليلها",17,"ل",3,0],["وکحْذَري أَنْ تَراكِ عَيْنٌ وَإنْ لا","تِ بعضَ المكثرينَ الأعادي",18,"د",2,0],["وَحذَّرني بَغضَاءَ بَعدَ مَوَدَّةٍ","مَخَافَةَ مَا يُفضِى إِلَى الشَّنَآنِ",19,"ن",1,0],["وحذَّرنى من الأحبابِ أنّى","رأيتُ دَماً لعُروةَ كيف طُلاَّ",20,"ل",2,0],["وحِذرتُ سُلوانا فسُمتُهُمُ","أن يَحرِمونى لذّةَ الوصلِ",21,"ل",1,0],["وحذرتهم من ربهم فتضاحكوا","وويلٌ لمن ربُّ السماءِ له خصمُ",22,"م",1,0],["وحذرك العذال ما يعرفونه","وسمعك مسدود فما نفع العذل",23,"ل",1,0],["وحذفك الذي به يصدر","وما تلا الأخير حتماً يكسر",24,"ر",1,0],["وحذفه من أصل أو نظير أو","فرع لغير علة كما حكوا",24,"ك",3,0],["وحذَّرَتْني من أَذَى قَومِها","حتى إذا لم يَبْدُ منّي الحِذَار",25,"ر",1,0],["وَحَذَارِ صُحْبَةَ نَاقِصٍ","وَتَرَاكِ مَن يَأْبَى وَيَأْبَدْ",26,"د",1,0],["وحذّر الرومَ من أهوالِ قارعةٍ","فيها نكبّ على الخدّينِ منكابا",27,"ب",2,0],["وَحذر على أنسٍ وطيب طويّةٍ","وَنجدة حرٍّ حلفها الرأيُ والصبرُ",28,"ر",1,0],["وَحَذّرتها مِن بَأس قَومي وَأَنَّهُم","عَلى كُلِّ نَجديٍّ بَغوا نَجدتي طرفِ",29,"ف",1,0],["وَحَذَّرَهُم مَن كانَ يُعنى بِأَمرِهِم","وَما يَنفَعُ التَحذيرُ عِندَ اِنقِضا الأَمرِ",30,"ر",1,0],["وحذيفه يقول كان الرجل","في زمان النبي خير الرسل",31,"ل",1,0],["وَحَذَفتُ أُختَ الشينِ مِن","ها عَن طلابِ أَخٍ معانِد",32,"د",1,0],["وحذارَ مِنْ وادي النَّقا والسَّفحِ مِنْ","أضم فَثمَّ مصَارعُ الآسادِ",33,"د",1,0],["وحذارِ مِنْ تِلكَ الظباءِ فما لَها","في الحُبِّ لا عَهْدٌ ولا مِيثاقُ",34,"ق",1,0],["وحذار ثم حذار من قول امرىء","يأتي بضد النص أو تأويله",35,"ل",2,0],["وحَذارِ مِن سَفَهٍ يَشِينُكُ وَصمُهُ","إنَّ التَّسَفُّهَ بالمُروءةِ زارِ",36,"ر",1,0],["وحذَّرهم من قبل ذلك بطشه","وأَمْهَلَهُمْ شهراً وزادَ على الشهر",37,"ر",1,0],["وحذرتك الدهياء قبل وقوعها","وأَوضحتها والحازم الرأي الَّذي يوضح",38,"ح",1,0],["وحذرتُ حتى كان يوم سويقة","فوقعتُ من جفنيكِ في إشراك",39,"ك",1,0],["وحذار من نهشات صل أرقط","ظام ومن بطشات ليث عاد",40,"د",1,0],["وحذوت في الإحسان حذو مثاله","وهو الذي نصب المثال لخاطري",41,"ر",2,0],["وحَذَفْتَني والْقَلْبُ ظَرفُ مَوَدَّةٍ","يا مَنْ تُسَبِّبُ للعَذُولِ وفِيله",42,"ل",2,0],["وحَذَفْتَ عائِدَكَ الّذي","عَوَّدْتَني مِنْ قَبْلُ حَذْفا",43,"ف",2,0],["وحذرتُ دهرِي من أمورٍ جمّةٍ","فأناخَ فيه الأمنُ وسْطَ فؤادِي",44,"د",2,0],["وَحَذَري ما لَيسَ بِالمَحذورِ","وَقَذَري ما لَيسَ بِالمَقذورِ",45,"ر",1,0],["وحَذِرْتُ هَتْكَ السِّتْرِ منك وقَدْ","أَوقَعْتِني في كل مَحْذُورِ",46,"ر",1,0],["وَحَذِرْتُ سَهْمَ فِرَاقِكُمْ حَتَّى إِذَا","أَرْسَلْتُموه أَصَابَنِي في المَقْتَلِ",47,"ل",1,0]]}