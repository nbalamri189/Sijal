إنسانيَّةٌ للرِّمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87656&r=&rc=8",""],[6344,"شعلة من وقود الغياب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87982&r=&rc=22",""]],"verses":[["رَغا بَينَ دَوحِ الوادِيَينِ بِرَعدِهِ","رُغاءَ مَطايا مَسَّهُنَّ لُغوبُ",0,"ب",1,0],["رَغائِبُ قَد قَطَعنَ حَنينَ عيسٍ","فَلا نَأياً أُريغُ وَلا اِغتِرابا",1,"ب",2,0],["رَغِمَ الأَراذِلُ إِذْ وَرِثْنا سُؤْدَداً","عَوْداً له أَثَرٌ عَلَيْنا بَيِّنُ",2,"ن",1,1],["رَغِبتُ إِلى ذي العَرشِ مَولى مُحَمَّدٍ","لِيَجمَعَ شَعباً أَو يُقَرِّبَ نائِيا",3,"ي",2,0],["رغيفه في قدر ديناره","بتلكم السكة مطبوعُ",4,"ع",1,0],["رغيفُه منه حين يُسأَلُهُ","مكان روح الجبان من جسدِهْ",5,"ه",1,0],["رُغاءُ مطايا الراغبين خِلاله","أناشيدُ مدحٍ لم يقعْ في مشاتمِ",6,"م",1,0],["رَغا فَوقَهُم سَقبُ السَماءِ فَداحِصٌ","بِشَكَّتِهِ لَم يُستَلَب وَسَليبُ",7,"ب",1,0],["رَغِبَت في الصَدِّ عَنّي بَعدَما","بِتُّ لا يُحزِنُني مِثلُ الصُدو",8,"د",2,0],["رَغِبنا عَن هِجاءِ بَني كُلَيبٍ","وَكَيفَ يُشاتِمُ الناسُ الكِلابا",9,"ب",2,0],["رُغمَ مَا فيه من جمالٍ وفنٍّ","عبقريٍّ مَا إن لهُ من مَزيدِ",10,"د",1,0],["رَغِبَت بِنَفسِكَ عَن خَساسَةِ نَفسِهِ","شِيَمٌ رَغِبنَ بِمَخلَدٍ عَن خالِدِ",11,"د",1,0],["رَغبَةٌ لِلعُيونِ إِمّا تَبدّى","طافَ عَرفٌ مِنهُ وَأَجزَلَ عُرفُ",12,"ف",1,0],["رَغَّبتَ قَوماً في السَماحِ وَأَينَ هُم","إِن ساجَلوكَ مِنَ السِماكِ الأَعزَلِ",13,"ل",1,0],["رَغا رَغوَةً بِمَناياهُمُ","فَصاروا رَماداً مَعَ الرِمدَدِ",14,"د",1,0],["رغا وأزبدَ والنكباءُ تُغْضِبُهُ","كما تَعَبَّثَ شيطانٌ بِمصرُوعِ",15,"ع",1,0],["رَغمَ أَنفي مِن أَن تُرى مَهتوكا","أَو أَرى لي ما عِشتُ فيكَ شَريكا",16,"ك",2,1],["رَغِبْتُ بِشِيمَتِي وَعَرَفْتُ نَفْسِي","وَلَمْ أَدْخُلْ لَعَمْرُكَ فِي قِرَانِ",17,"ن",1,0],["رغيفُ خبازِكُمُ قدْ حوى","مِنْ وجهِهِ التدويرَ والحمدَ لا",18,"ل",2,1],["رغيفُ خبازكمْ قدْ حكى","منْ وجهِهِ التدويرَ والحمرَهْ",19,"ه",1,1],["رغماً لِمَنْ قالْ قبلي","الشمعُ في الشمسِ ضائعْ",20,"ع",1,0],["رَغيفُ سَعيدٍ عِندَهُ عِدلُ نَفسِهِ","يُقَلِّبُهُ طَوراً وَطَوراً يُلاعِبُه",21,"ب",2,1],["رَغِبنا في الحَياةِ لِفِرطِ جَهلٍ","وَفَقدُ حَياتِنا حَظٌّ رَغيبُ",22,"ب",1,1],["رَغِبوا فَأَزهَدُ مَن تَرى فَوقَ الثَرى","يَبغونَ عِندَ اللَهِ رِبحَ تِجارِ",23,"ر",1,0],["رغتِ الرُّعودُ وتلك هَدّة واجبٍ","جبلٍ هَوَى في آلِ عَبد مَنافِ",24,"ف",1,0],["رَغمٌ لِأَنفِ أَبيكَ عِندي ضائِعٌ","إِنّي يَهونُ عَلَيَّ أَن لا يُعتَبوا",25,"ب",3,0],["رغبت عَن الدنيا كأَني ميت","قَريباً وَفي الدنيا كأَنّي لا أَفنى",26,"ن",2,0],["رَغِبْتِ إِلَيَّ فِي إِهْدَاءِ رَسْمِي","إِلَيكِ وَقَبْلَهُ أَهْدَيْتُ قَلْبِي",27,"ي",1,1],["رَغِبتُ حَتّى تَوَلّى","فَأَيُّ زُهدٍ زَهَدتُه",28,"ت",2,0],["رغم أنف الذي رماهم حِيالي","ماثنوني، ولن يسدّوا طريقي",29,"ق",2,0],["رغم الغثيان تحن إلى","أوجاع الطلق ولا تضجر",30,"ر",1,0],["رَغْبَةٌ للعُيُونِ إمّا تَبَدّى،","طابَ عَرْفٌ منه وأُجزِلَ عُرْفُ",31,"ف",1,0],["رغبت في الصدى عنّي بعدما","بتّ لا يحزنني مثل الصدود",32,"د",1,0],["رغم امتناع القرط.. أجتاحُهُ","أشرسَِ من عصفورة البيدَرِ..",33,"ر",1,0],["رَغَّمتُ أنفَ الحاسِدينَ بسَطْوتي","فغدوا لها منْ راكعين وسجَّدِ",34,"د",1,0],["رغا فوقهم سقب السماءِ فأصبحوا","كأنهمُ في عالم الأرضِ ما كانوا",35,"ن",3,0],["رَغِبتُ بِنَفسي أَن أَكونَ مُصاحِباً","أُناساً إِذا قيدوا إِلى الضَيمِ أَصحَبوا",36,"ب",3,0],["رَغبه الناسُ فكلٌّ طلبا","لمّا رَأوه الكاملَ المهذّبا",37,"ب",2,0],["رَغِبتُ إِلى الأَقوامِ أَن يَحتفوا بِها","فَلَم تَنزلِ الأَقوامَ عِندَ رَغائِبي",38,"ب",2,0],["رَغباً إِلى نورٍ عَلى نورٍ سِوى","صَلَواتِ يَومِ الفَتحِ وَالإِمكانِ",39,"ن",1,0],["رغم بعدي، لستُ وحدي","أنتَ دوماً صِنْوُ طيفي",40,"ف",2,0],["رغم أني في الهوى غِرْ","رٌ ، فعندي منه قدرا.",41,"ر",2,0],["رغم حرصي، صرتُ طَوْعاً","لك ما خالفتُ أمرا",41,"ر",2,0],["رغم خوفي، إنَّ ذنبي","عند نفسي، ليس إثما",42,"م",2,0],["رغم ماتخفيه عني","راضِياً اخترتُ دربي",43,"ب",2,0],["رغم حُمْقي، إن حبي","ماثلٌ، بل ليس قولا",44,"ل",2,0],["رغم أني منك أرجو","ملجأً من كل صَعْب",45,"ب",1,0],["رغم أني منك أشكو","لم أخالف قَطُّ عهدي",46,"د",2,0],["رغبتُ بالحسنِ حتى قلتُ من شَغَفي","لولاهُ ما فازَ إنسانٌ ولا عاشا",47,"ش",2,0],["رَغبتِ عن الدُّنيا وأنتِ نعيمُها","وغيرُكِ تلهُو بالمكائدِ والإفكِ"