{"poems":[[53,"سما كبطون الأتن ريعان عارض","https://www.aldiwan.net/poem30703.html","الطويل"],[53,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[63,"رغم الأراذل إذ ورثنا سؤددا","https://www.aldiwan.net/poem46082.html","الكامل"],[27,"ألا حي رهبى ثم حي المطاليا","https://www.aldiwan.net/poem4427.html","الطويل"],[51,"أصبح يعقوب وتبجيله","https://www.aldiwan.net/poem65394.html","السريع"],[51,"فتى على خبزه ونائله","https://www.aldiwan.net/poem61967.html","المنسرح"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[16,"طحا بك قلب في الحسان طروب","https://www.aldiwan.net/poem27695.html","الطويل"],[91,"نسيت عهدي فلما جئتها","https://www.aldiwan.net/poem8818.html","عموديه"],[38,"رأيت الجحش جحش بني كليب","https://www.aldiwan.net/poem7689.html","الوافر"],[92,"بل يا بهاء هذا الوجود","https://www.aldiwan.net/poem38952.html","الخفيف"],[45,"قل للخيال إذا أردت فعاود","https://www.aldiwan.net/poem63447.html","الكامل"],[45,"لأخي الحب عبرة ما تجف","https://www.aldiwan.net/poem65151.html","الخفيف"],[45,"أكثرت في لوم المحب فأقلل","https://www.aldiwan.net/poem65591.html","الكامل"],[28,"إذا أثفروا كل خفاقة","https://www.aldiwan.net/poem5045.html","المتقارب"],[80,"وأخضر حصلت نفسي به ونجت","https://www.aldiwan.net/poem31385.html","البسيط"],[44,"رغم أنفي من أن ترى مهتوكا","https://www.aldiwan.net/poem30012.html","الخفيف"],[87,"صبوت إلى المدامة والغواني","https://www.aldiwan.net/poem8238.html","الوافر"],[69,"رغيف خبازكم قد حوى","https://www.aldiwan.net/poem28298.html","السريع"],[69,"رغيف خبازكم قد حكى","https://www.aldiwan.net/poem28413.html","السريع"],[69,"يا شمس أشعلت شمعا","https://www.aldiwan.net/poem29089.html","المجتث"],[48,"رغيف سعيد عنده عدل نفسه","https://www.aldiwan.net/poem62435.html","السريع"],[46,"رغبنا في الحياة لفرط جهل","https://www.aldiwan.net/poem22100.html","الوافر"],[46,"لا تأنفن من احترافك طالبا","https://www.aldiwan.net/poem22704.html","الكامل"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[15,"أنبئت أن بني جديلة أوعبوا","https://www.aldiwan.net/poem45285.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85331","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54597","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43667","المجتث"],[100,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[45,"لأخي الحُبّ عَبرَةٌ ما تَجِفُّ","https://www.poetsgate.com/ViewPoem.aspx?id=32543",""],[91,"شكوى","https://www.poetsgate.com/ViewPoem.aspx?id=53033",""],[99,"القرط الطويل","https://www.poetsgate.com/ViewPoem.aspx?id=36382",""],[3,"بين العقيق وبينَ برْقَة ِ ثَهْمَد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10684&r=&rc=38",""],[131,"لك النصر حزب والمقادير أعوان","https://www.aldiwan.net/poem4207.html","الطويل"],[141,"لكم أن تجوروا معرِضين وتغضبوا","https://www.aldiwan.net/poem11720.html","الطويل"],[187,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[221,"كعاب أتت في الحسن فخر الكواعب","https://www.aldiwan.net/poem41907.html","الطويل"],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[252,"أعلنت ضعفي","https://www.aldiwan.net/poem24946.html","مجزوء الرمل"],[252,"ليت شعري","https://www.aldiwan.net/poem24963.html","مجزوء الرمل"],[252,"ياعظيم الشأن","https://www.aldiwan.net/poem25013.html","مجزوء الرمل"],[252,"أقبلي","https://www.aldiwan.net/poem25015.html","مجزوء الرمل"],[252,"في الهوى لست وحدي","https://www.aldiwan.net/poem25017.html","مجزوء الرمل"],[252,"أبعد العشق أحيا","https://www.aldiwan.net/poem36217.html","مجزوء الرمل"],[252,"حبيب العمر","https://www.aldiwan.net/poem36222.html","مجزوء الرمل"],[268,"عوضت منك من الإيناس إيحاشا","https://www.aldiwan.net/poem35052.html","البسيط"],[268,"هربت إلى حجر اليقين من الشك","https://www.aldiwan.net/poem35234.html","الطويل"],[268,"لقد ذهبت تلك الأماني الخوادع","https://www.aldiwan.net/poem35239.html","الطويل"],[268,"إذا غاب جسمي في الثرى رافقي ظلي","https://www.aldiwan.net/poem35631.html","الطويل"],[273,"أبقت لصحوي من علاقتها نشوى","https://www.aldiwan.net/poem25453.html","الطويل"],[283,"قاضي الإسلام داوود البطل","https://www.aldiwan.net/poem39351.html","الرمل"],[295,"هد الحمام لآل عبد مناف","https://www.aldiwan.net/poem33214.html","الكامل"],[300,"عودي للهوكِ","https://www.aldiwan.net/poem65692.html","الكامل"],[347,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[351,"رغبت عن الدنيا وزخرف أهلها","https://www.aldiwan.net/poem40177.html","الطويل"],[367,"روض الهوى مرتع وخيم","https://www.aldiwan.net/poem4324.html","مخلع البسيط"],[374,"يا نسيما نراه يروي الغليلا","https://www.aldiwan.net/poem59174.html","الخفيف"],[402,"رغيفك في الأمن يا سيدي","https://www.aldiwan.net/poem49466.html","المتقارب"],[406,"ركبتي تخدم المهذب في العلم","https://www.aldiwan.net/poem31622.html","عموديه"],[413,"دنف ذو مهجة في الحب تصدا","https://www.aldiwan.net/poem54128.html","الرمل"],[413,"ألا هل للمتيم من مجير","https://www.aldiwan.net/poem54160.html","الوافر"],[413,"أدار الكأس مترعة شرابا","https://www.aldiwan.net/poem54184.html","الوافر"],[438,"أقنع بما أنا فيه منه أقاسي","https://www.aldiwan.net/poem14374.html","الكامل"],[456,"على كل حال جانب الحق أمنع","https://www.aldiwan.net/poem56131.html","الطويل"],[456,"سلا دار البخيلة بالجناب","https://www.aldiwan.net/poem56296.html","الوافر"],[459,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[459,"خل التغزل للمشوق المغرم","https://www.aldiwan.net/poem15296.html","الكامل"],[462,"في لأذني عن كل لاح صمم","https://www.aldiwan.net/poem3159.html","عموديه"],[466,"رغيفي لا سواه عند نفسي","https://www.aldiwan.net/poem60071.html","الوافر"],[477,"قالوا حبست فقلت ليس بضائري","https://www.aldiwan.net/poem37597.html","الكامل"],[477,"في موقف العدل والأبصار شاخصة","https://www.aldiwan.net/poem37613.html","البسيط"],[498,"رغبنا بأسرار الشهود لوجهكم","https://www.aldiwan.net/poem38082.html","الطويل"],[536,"عبد ببابك خده قد عفرا","https://www.aldiwan.net/poem48191.html","عموديه"],[536,"هم المعذبون في الأرض","https://www.aldiwan.net/poem48310.html","عموديه"],[542,"سقياك يا والد النهرين","https://www.aldiwan.net/poem67249.html","عموديه"],[556,"رؤية الحق رؤية الأغيار","https://www.aldiwan.net/poem33550.html","الخفيف"],[573,"رغبت في الجنة لما بدا","https://www.aldiwan.net/poem2875.html","السريع"]],"verses":[["رَغا بَينَ دَوحِ الوادِيَينِ بِرَعدِهِ","رُغاءَ مَطايا مَسَّهُنَّ لُغوبُ",0,"ب",1,0],["رَغائِبُ قَد قَطَعنَ حَنينَ عيسٍ","فَلا نَأياً أُريغُ وَلا اِغتِرابا",1,"ب",2,0],["رَغِمَ الأَراذِلُ إِذْ وَرِثْنا سُؤْدَداً","عَوْداً له أَثَرٌ عَلَيْنا بَيِّنُ",2,"ن",1,1],["رَغِبتُ إِلى ذي العَرشِ مَولى مُحَمَّدٍ","لِيَجمَعَ شَعباً أَو يُقَرِّبَ نائِيا",3,"ي",2,0],["رغيفه في قدر ديناره","بتلكم السكة مطبوعُ",4,"ع",1,0],["رغيفُه منه حين يُسأَلُهُ","مكان روح الجبان من جسدِهْ",5,"ه",1,0],["رُغاءُ مطايا الراغبين خِلاله","أناشيدُ مدحٍ لم يقعْ في مشاتمِ",6,"م",1,0],["رَغا فَوقَهُم سَقبُ السَماءِ فَداحِصٌ","بِشَكَّتِهِ لَم يُستَلَب وَسَليبُ",7,"ب",1,0],["رَغِبَت في الصَدِّ عَنّي بَعدَما","بِتُّ لا يُحزِنُني مِثلُ الصُدو",8,"د",2,0],["رَغِبنا عَن هِجاءِ بَني كُلَيبٍ","وَكَيفَ يُشاتِمُ الناسُ الكِلابا",9,"ب",2,0],["رُغمَ مَا فيه من جمالٍ وفنٍّ","عبقريٍّ مَا إن لهُ من مَزيدِ",10,"د",1,0],["رَغِبَت بِنَفسِكَ عَن خَساسَةِ نَفسِهِ","شِيَمٌ رَغِبنَ بِمَخلَدٍ عَن خالِدِ",11,"د",1,0],["رَغبَةٌ لِلعُيونِ إِمّا تَبدّى","طافَ عَرفٌ مِنهُ وَأَجزَلَ عُرفُ",12,"ف",1,0],["رَغَّبتَ قَوماً في السَماحِ وَأَينَ هُم","إِن ساجَلوكَ مِنَ السِماكِ الأَعزَلِ",13,"ل",1,0],["رَغا رَغوَةً بِمَناياهُمُ","فَصاروا رَماداً مَعَ الرِمدَدِ",14,"د",1,0],["رغا وأزبدَ والنكباءُ تُغْضِبُهُ","كما تَعَبَّثَ شيطانٌ بِمصرُوعِ",15,"ع",1,0],["رَغمَ أَنفي مِن أَن تُرى مَهتوكا","أَو أَرى لي ما عِشتُ فيكَ شَريكا",16,"ك",2,1],["رَغِبْتُ بِشِيمَتِي وَعَرَفْتُ نَفْسِي","وَلَمْ أَدْخُلْ لَعَمْرُكَ فِي قِرَانِ",17,"ن",1,0],["رغيفُ خبازِكُمُ قدْ حوى","مِنْ وجهِهِ التدويرَ والحمدَ لا",18,"ل",2,1],["رغيفُ خبازكمْ قدْ حكى","منْ وجهِهِ التدويرَ والحمرَهْ",19,"ه",1,1],["رغماً لِمَنْ قالْ قبلي","الشمعُ في الشمسِ ضائعْ",20,"ع",1,0],["رَغيفُ سَعيدٍ عِندَهُ عِدلُ نَفسِهِ","يُقَلِّبُهُ طَوراً وَطَوراً يُلاعِبُه",21,"ب",2,1],["رَغِبنا في الحَياةِ لِفِرطِ جَهلٍ","وَفَقدُ حَياتِنا حَظٌّ رَغيبُ",22,"ب",1,1],["رَغِبوا فَأَزهَدُ مَن تَرى فَوقَ الثَرى","يَبغونَ عِندَ اللَهِ رِبحَ تِجارِ",23,"ر",1,0],["رغتِ الرُّعودُ وتلك هَدّة واجبٍ","جبلٍ هَوَى في آلِ عَبد مَنافِ",24,"ف",1,0],["رَغمٌ لِأَنفِ أَبيكَ عِندي ضائِعٌ","إِنّي يَهونُ عَلَيَّ أَن لا يُعتَبوا",25,"ب",3,0],["رغبت عَن الدنيا كأَني ميت","قَريباً وَفي الدنيا كأَنّي لا أَفنى",26,"ن",2,0],["رَغِبْتِ إِلَيَّ فِي إِهْدَاءِ رَسْمِي","إِلَيكِ وَقَبْلَهُ أَهْدَيْتُ قَلْبِي",27,"ي",1,1],["رَغِبتُ حَتّى تَوَلّى","فَأَيُّ زُهدٍ زَهَدتُه",28,"ت",2,0],["رغم أنف الذي رماهم حِيالي","ماثنوني، ولن يسدّوا طريقي",29,"ق",2,0],["رَغْبَةٌ للعُيُونِ إمّا تَبَدّى،","طابَ عَرْفٌ منه وأُجزِلَ عُرْفُ",30,"ف",1,0],["رغبت في الصدى عنّي بعدما","بتّ لا يحزنني مثل الصدود",31,"د",1,0],["رغم امتناع القرط.. أجتاحُهُ","أشرسَِ من عصفورة البيدَرِ..",32,"ر",1,0],["رَغَّمتُ أنفَ الحاسِدينَ بسَطْوتي","فغدوا لها منْ راكعين وسجَّدِ",33,"د",1,0],["رغا فوقهم سقب السماءِ فأصبحوا","كأنهمُ في عالم الأرضِ ما كانوا",34,"ن",3,0],["رَغِبتُ بِنَفسي أَن أَكونَ مُصاحِباً","أُناساً إِذا قيدوا إِلى الضَيمِ أَصحَبوا",35,"ب",3,0],["رَغبه الناسُ فكلٌّ طلبا","لمّا رَأوه الكاملَ المهذّبا",36,"ب",2,0],["رَغِبتُ إِلى الأَقوامِ أَن يَحتفوا بِها","فَلَم تَنزلِ الأَقوامَ عِندَ رَغائِبي",37,"ب",2,0],["رَغباً إِلى نورٍ عَلى نورٍ سِوى","صَلَواتِ يَومِ الفَتحِ وَالإِمكانِ",38,"ن",1,0],["رغم بعدي، لستُ وحدي","أنتَ دوماً صِنْوُ طيفي",39,"ف",2,0],["رغم أني في الهوى غِرْ","رٌ ، فعندي منه قدرا.",40,"ر",2,0],["رغم حرصي، صرتُ طَوْعاً","لك ما خالفتُ أمرا",40,"ر",2,0],["رغم خوفي، إنَّ ذنبي","عند نفسي، ليس إثما",41,"م",2,0],["رغم ماتخفيه عني","راضِياً اخترتُ دربي",42,"ي",1,0],["رغم حُمْقي، إن حبي","ماثلٌ، بل ليس قولا",43,"ل",2,0],["رغم أني منك أرجو","ملجأً من كل صَعْب",44,"ب",1,0],["رغم أني منك أشكو","لم أخالف قَطُّ عهدي",45,"د",2,0],["رغبتُ بالحسنِ حتى قلتُ من شَغَفي","لولاهُ ما فازَ إنسانٌ ولا عاشا",46,"ش",2,0],["رَغبتِ عن الدُّنيا وأنتِ نعيمُها","وغيرُكِ تلهُو بالمكائدِ والإفكِ",47,"ك",1,0],["رَغبتُ عَنِ العلمِ الذي هو شقوتي","وماذا يُفيدُ العلمُ والعلمُ ضائع",48,"ع",1,0],["رغبتَ عن الدّنيا فبتَّ مفتشاً","عن الغايةِ القصوى فما فزتَ بالسؤل",49,"ل",1,0],["رَغَائِبُ يُسْدِيهَا السَّماحُ غَوَائِبٌ","أَكَلَّتْ جِيادَ الشِّعْرِ إِذْ رَحُبَتْ شَأْوَا",50,"و",2,0],["رغب القوم وإن لم يدركوا","في ابتداء الأمر ما حكم الدول",51,"ل",1,0],["رغمت أنوفُ السَمهريَّةِ والظُبى","لمّا أصِبنَ بمُرغمِ الآنافِ",52,"ف",1,0],["رغم الجمالِ فما رواني حُسنه","والعمرُ يجري والمفاتنُ تأفلُ",53,"ل",1,0],["رَغِبتُ في النارِ فَرُحتُ زاهِداً","في جَنَّةٍ بِوَعدِها غَيري يُغَر",54,"ر",1,0],["رَغبت عَن الدُنيا وَزخرف أَهلها","وَقُلت لِنَفسي إِنَّما العَيش في الأُخرى",55,"ر",2,1],["رغبتُ عنه إِلى ودادٍ","على زوال الرضا يقيم",56,"م",1,0],["رغبةً في صلاح رهبنةٍ قد","بعت فيها هواي بيعاً أصيلا",57,"ل",2,0],["رغيفُكَ في الأمْنِ يا سيِّدي","يحلُّ محلَّ حَمامِ الحَرَمْ",58,"م",1,1],["رغبة في الحياة من بعد طول ال","عمر والموت غاية الإنسان",59,"ن",1,0],["رغد العيش لمن في ظلِّه","عاش طول الدهر بالأفراح رغدا",60,"د",2,0],["رَغِمْتُ بودّه آناف قوم","رَمَوْني بالعتوّ وبالنفور",61,"ر",1,0],["رغبت عن الأنام به فأضحى","يطوِّقني أياديه الرغابا",62,"ب",2,0],["رغباً لأيام الشباب وطيبها","واللَهو قبل تساقط الأضراس",63,"س",1,0],["رغبتُ بها عن ناصلِ الود قلبُهُ","خبيث وإن طاب اللسان المصنِّعُ",64,"ع",1,0],["رغائبُ من يديه فاجأتني","وَفَيْنَ رِضاً بآمالي الرِّغابِ",65,"ب",1,0],["رغبت به ألْطاف محسن خلْقه","عن أن يبيت لهم مُقضَّ المضجعِ",66,"ع",1,0],["رغبت بك العلياءُ عن خدع الهوى","فارغَبْ بنفسكَ عن مقام مُتَيَّمِ",67,"م",1,0],["رغبتُ وحسبي غيبتي عنك أسلى","ينجدُ في جوانحي ويتهم",68,"م",1,0],["رَغيفي لا سِواهُ عِندَ نَفسي","يَقومُ لَها مَقامَ سِماطِ غَيري",69,"ي",1,1],["رغم الحضور لقد رجعت لحيّكم","وأنا أمانتكم رجوع مسافر",70,"ر",1,0],["رغم الدفاع ورغم الحق والحجج ال","لاتي أتت عند ملقيها بها الكلم",71,"م",1,0],["رغِبْنا بأَسرارِ الشُّهودِ لوجهِكمْ","وتلك المعاني عن صلاةِ الرَّغائبِ",72,"ب",1,1],["رغماً عنِ الأعداءِ مَن راموا سوى","أن يَستَغلُّوا نكبتىَّ لأُقهَرا",73,"ر",2,0],["رَغما عن الواحِد بل","رغماً عن الخَمسِمائه",74,"ا",2,0],["رغمَ الجنائزِ فاضَتْ عن مقابرِها","من فرط ما غصَّ جوفُ الأرضِ واحتقنَا",75,"ن",2,0],["رغبة النفس في السوى حجبتهم","وعن الجنة اكتفوا بالنار",76,"ر",1,0],["رغبت في الجنَّةِ لما بَدَا","أَنْموذَجُ الجنَّة في شَكْلِهِ",77,"ل",2,1]]}