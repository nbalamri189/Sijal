{"poems":[[53,"سما كبطون الأتن ريعان عارض","https://www.aldiwan.net/poem30703.html","الطويل"],[53,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[63,"رغم الأراذل إذ ورثنا سؤددا","https://www.aldiwan.net/poem46082.html","الكامل"],[27,"ألا حي رهبى ثم حي المطاليا","https://www.aldiwan.net/poem4427.html","الطويل"],[51,"أصبح يعقوب وتبجيله","https://www.aldiwan.net/poem65394.html","السريع"],[51,"فتى على خبزه ونائله","https://www.aldiwan.net/poem61967.html","المنسرح"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[16,"طحا بك قلب في الحسان طروب","https://www.aldiwan.net/poem27695.html","الطويل"],[91,"نسيت عهدي فلما جئتها","https://www.aldiwan.net/poem8818.html","عموديه"],[38,"رأيت الجحش جحش بني كليب","https://www.aldiwan.net/poem7689.html","الوافر"],[92,"بل يا بهاء هذا الوجود","https://www.aldiwan.net/poem38952.html","الخفيف"],[45,"قل للخيال إذا أردت فعاود","https://www.aldiwan.net/poem63447.html","الكامل"],[45,"لأخي الحب عبرة ما تجف","https://www.aldiwan.net/poem65151.html","الخفيف"],[45,"أكثرت في لوم المحب فأقلل","https://www.aldiwan.net/poem65591.html","الكامل"],[28,"إذا أثفروا كل خفاقة","https://www.aldiwan.net/poem5045.html","المتقارب"],[80,"وأخضر حصلت نفسي به ونجت","https://www.aldiwan.net/poem31385.html","البسيط"],[44,"رغم أنفي من أن ترى مهتوكا","https://www.aldiwan.net/poem30012.html","الخفيف"],[87,"صبوت إلى المدامة والغواني","https://www.aldiwan.net/poem8238.html","الوافر"],[69,"رغيف خبازكم قد حوى","https://www.aldiwan.net/poem28298.html","السريع"],[69,"رغيف خبازكم قد حكى","https://www.aldiwan.net/poem28413.html","السريع"],[69,"يا شمس أشعلت شمعا","https://www.aldiwan.net/poem29089.html","المجتث"],[48,"رغيف سعيد عنده عدل نفسه","https://www.aldiwan.net/poem62435.html","السريع"],[46,"رغبنا في الحياة لفرط جهل","https://www.aldiwan.net/poem22100.html","الوافر"],[46,"لا تأنفن من احترافك طالبا","https://www.aldiwan.net/poem22704.html","الكامل"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[15,"أنبئت أن بني جديلة أوعبوا","https://www.aldiwan.net/poem45285.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85331","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54597","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43667","المجتث"],[100,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[45,"لأخي الحُبّ عَبرَةٌ ما تَجِفُّ","https://www.poetsgate.com/ViewPoem.aspx?id=32543",""],[91,"شكوى","https://www.poetsgate.com/ViewPoem.aspx?id=53033",""],[99,"القرط الطويل","https://www.poetsgate.com/ViewPoem.aspx?id=36382",""],[3,"بين العقيق وبينَ برْقَة ِ ثَهْمَد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10684&r=&rc=38",""]],"verses":[["رَغا بَينَ دَوحِ الوادِيَينِ بِرَعدِهِ","رُغاءَ مَطايا مَسَّهُنَّ لُغوبُ",0,"ب",1,0],["رَغائِبُ قَد قَطَعنَ حَنينَ عيسٍ","فَلا نَأياً أُريغُ وَلا اِغتِرابا",1,"ب",2,0],["رَغِمَ الأَراذِلُ إِذْ وَرِثْنا سُؤْدَداً","عَوْداً له أَثَرٌ عَلَيْنا بَيِّنُ",2,"ن",1,1],["رَغِبتُ إِلى ذي العَرشِ مَولى مُحَمَّدٍ","لِيَجمَعَ شَعباً أَو يُقَرِّبَ نائِيا",3,"ي",2,0],["رغيفه في قدر ديناره","بتلكم السكة مطبوعُ",4,"ع",1,0],["رغيفُه منه حين يُسأَلُهُ","مكان روح الجبان من جسدِهْ",5,"ه",1,0],["رُغاءُ مطايا الراغبين خِلاله","أناشيدُ مدحٍ لم يقعْ في مشاتمِ",6,"م",1,0],["رَغا فَوقَهُم سَقبُ السَماءِ فَداحِصٌ","بِشَكَّتِهِ لَم يُستَلَب وَسَليبُ",7,"ب",1,0],["رَغِبَت في الصَدِّ عَنّي بَعدَما","بِتُّ لا يُحزِنُني مِثلُ الصُدو",8,"د",2,0],["رَغِبنا عَن هِجاءِ بَني كُلَيبٍ","وَكَيفَ يُشاتِمُ الناسُ الكِلابا",9,"ب",2,0],["رُغمَ مَا فيه من جمالٍ وفنٍّ","عبقريٍّ مَا إن لهُ من مَزيدِ",10,"د",1,0],["رَغِبَت بِنَفسِكَ عَن خَساسَةِ نَفسِهِ","شِيَمٌ رَغِبنَ بِمَخلَدٍ عَن خالِدِ",11,"د",1,0],["رَغبَةٌ لِلعُيونِ إِمّا تَبدّى","طافَ عَرفٌ مِنهُ وَأَجزَلَ عُرفُ",12,"ف",1,0],["رَغَّبتَ قَوماً في السَماحِ وَأَينَ هُم","إِن ساجَلوكَ مِنَ السِماكِ الأَعزَلِ",13,"ل",1,0],["رَغا رَغوَةً بِمَناياهُمُ","فَصاروا رَماداً مَعَ الرِمدَدِ",14,"د",1,0],["رغا وأزبدَ والنكباءُ تُغْضِبُهُ","كما تَعَبَّثَ شيطانٌ بِمصرُوعِ",15,"ع",1,0],["رَغمَ أَنفي مِن أَن تُرى مَهتوكا","أَو أَرى لي ما عِشتُ فيكَ شَريكا",16,"ك",2,1],["رَغِبْتُ بِشِيمَتِي وَعَرَفْتُ نَفْسِي","وَلَمْ أَدْخُلْ لَعَمْرُكَ فِي قِرَانِ",17,"ن",1,0],["رغيفُ خبازِكُمُ قدْ حوى","مِنْ وجهِهِ التدويرَ والحمدَ لا",18,"ل",2,1],["رغيفُ خبازكمْ قدْ حكى","منْ وجهِهِ التدويرَ والحمرَهْ",19,"ه",1,1],["رغماً لِمَنْ قالْ قبلي","الشمعُ في الشمسِ ضائعْ",20,"ع",1,0],["رَغيفُ سَعيدٍ عِندَهُ عِدلُ نَفسِهِ","يُقَلِّبُهُ طَوراً وَطَوراً يُلاعِبُه",21,"ب",2,1],["رَغِبنا في الحَياةِ لِفِرطِ جَهلٍ","وَفَقدُ حَياتِنا حَظٌّ رَغيبُ",22,"ب",1,1],["رَغِبوا فَأَزهَدُ مَن تَرى فَوقَ الثَرى","يَبغونَ عِندَ اللَهِ رِبحَ تِجارِ",23,"ر",1,0],["رغتِ الرُّعودُ وتلك هَدّة واجبٍ","جبلٍ هَوَى في آلِ عَبد مَنافِ",24,"ف",1,0],["رَغمٌ لِأَنفِ أَبيكَ عِندي ضائِعٌ","إِنّي يَهونُ عَلَيَّ أَن لا يُعتَبوا",25,"ب",3,0],["رغبت عَن الدنيا كأَني ميت","قَريباً وَفي الدنيا كأَنّي لا أَفنى",26,"ن",2,0],["رَغِبْتِ إِلَيَّ فِي إِهْدَاءِ رَسْمِي","إِلَيكِ وَقَبْلَهُ أَهْدَيْتُ قَلْبِي",27,"ي",1,1],["رَغِبتُ حَتّى تَوَلّى","فَأَيُّ زُهدٍ زَهَدتُه",28,"ت",2,0],["رغم أنف الذي رماهم حِيالي","ماثنوني، ولن يسدّوا طريقي",29,"ق",2,0],["رَغْبَةٌ للعُيُونِ إمّا تَبَدّى،","طابَ عَرْفٌ منه وأُجزِلَ عُرْفُ",30,"ف",1,0],["رغبت في الصدى عنّي بعدما","بتّ لا يحزنني مثل الصدود",31,"د",1,0],["رغم امتناع القرط.. أجتاحُهُ","أشرسَِ من عصفورة البيدَرِ..",32,"ر",1,0],["رَغَّمتُ أنفَ الحاسِدينَ بسَطْوتي","فغدوا لها منْ راكعين وسجَّدِ",33,"د",1,0]]}