{"poems":[[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85593","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/205801","الخفيف"],[469,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145808","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56573","السريع"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32820","الخفيف"]],"verses":[["لَيسَ صوت من الأعالي سيأتي","مثل صوت يأتي من الأعماق",0,"ق",1,0],["ليس صعبا لقاؤنا بإله","بل لقاء الانسان بالإنسان",1,"ن",1,0],["ليس صدق الفعلين سرّاً وجهرا","لك حلو القولين جداّ وهزلا",2,"ل",2,0],["ليسَ (صنعا) إلا مسافةَ عينِ ال","صقرِ للمِخلَبِ الذي ما يشاءُ",3,"ا",2,0],["ليس صباح بصباح لهم","ولا مساء لهم بالمساء",4,"ا",2,0],["لَيسَ صَدّي عَنكُم صُدودَ تَجافٍ","هُوَ ذَمٌّ يُشيبُ رَأسَ الوَليدِ",5,"د",1,0]]}