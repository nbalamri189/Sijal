{"poems":[[55,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[4,"أقوى وعري واسط فبرام","https://www.aldiwan.net/poem21194.html","الكامل"],[53,"يا خالد ابن الخالدات","https://www.aldiwan.net/poem65801.html","مجزوء الكامل"],[16,"دافعت عنه بشعري","https://www.aldiwan.net/poem27692.html","الرجز"],[91,"في الصدر حتى كدت تردى","https://www.aldiwan.net/poem44868.html","مجزوء الكامل"],[87,"هذه أول خطوه","https://www.aldiwan.net/poem8064.html","مجزوء الرمل"],[99,"موقفٌ حانَ فاغتنم","https://www.aldiwan.net/poem24754.html","مجزوء الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85473","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85440","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[230,"في عابدين سلطان","https://www.aldiwan.net/poem55078.html","عموديه"],[234,"يا من صفا ود صدري","https://www.aldiwan.net/poem51097.html","المجتث"],[240,"يا مشرق البحر الخضم بمائه","https://www.aldiwan.net/poem31607.html","الكامل"],[240,"يا خير منتصر لخير إمام","https://www.aldiwan.net/poem31765.html","الكامل"],[303,"برح الخفاء فلست أكتم لوعة","https://www.aldiwan.net/poem36808.html","عموديه"],[333,"لا أنا خالد ولا أمنياتي","https://www.aldiwan.net/poem54952.html","الخفيف"],[409,"جاء يهدي نحوي بديع النظام","https://www.aldiwan.net/poem33414.html","الخفيف"],[409,"الحمد لله الذي لا يفي","https://www.aldiwan.net/poem33643.html","السريع"],[435,"عج لميزاب سرور قد غدا","https://www.aldiwan.net/poem40734.html","الرمل"],[438,"ماست فقيل هي القضيب الأملد","https://www.aldiwan.net/poem12594.html","الكامل"],[458,"يا ابن الخصاصة حين تحسب عزة","https://www.aldiwan.net/poem61389.html","الكامل"],[463,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[463,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[469,"طال السهاد مع القلق","https://www.aldiwan.net/poem3469.html","عموديه"],[488,"ولقد غضبت لخندف ولقيسها","https://www.aldiwan.net/poem2072.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122660","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96980","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86771","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87128","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64070","الكامل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216887","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56574","المجتث"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64543","الخفيف"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115998","الرمل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49570","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69374","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48244","الكامل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108492","الكامل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67912","الكامل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127384","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204633","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138466",""],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104835","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101350","البسيط"],[4122,"","https://poetry.dctabudhabi.ae/diwan/poem/111115","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81284","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83133","الخفيف"],[5092,"على ضفاف الحب","https://www.poetsgate.com/ViewPoem.aspx?id=139678",""],[2365,"كان الذي خفت أن يكونا","https://www.poetsgate.com/ViewPoem.aspx?id=200665",""],[5512,"ربيعٌ أم خريف","https://www.poetsgate.com/ViewPoem.aspx?id=204667",""],[5596,"من وحي \"بون\"","https://www.poetsgate.com/ViewPoem.aspx?id=206482",""],[5690,"أن تعظم الأهوال حزمك أعظمُ","https://www.poetsgate.com/ViewPoem.aspx?id=172183",""],[6093,"آوَتْكَ دَارُ الكُفْرِ إذْ أرْضَيتَها","https://www.poetsgate.com/ViewPoem.aspx?id=176424",""]],"verses":[["دافِعاً بِالرِماحِ في كُلِّ ثَغرٍ","لُجَجاً تَركَبُ العَدُوَّ غِمارا",0,"ر",2,0],["دافَعتُ خُطَّتَها وَكُنتُ وَلِيَّها","إِذ عَيَّ فَصلَ جَوابِها الحُكّامُ",1,"م",1,0],["دافعْتَه عن بِنْته","والغصْبُ ما يحويه قبضُك",2,"ك",1,0],["دافَعتُ عَنهُ بِشِعرِيَ إذ","كانَ لِقَومي في الفِداءِ جَحَد",3,"د",1,1],["دافَعَ قَومي في الكَتيبَةِ إذ","طارَ لِأَطرافِ الظُباتِ وَقَد",3,"د",1,0],["دافعت عن وطني ولم","ار من دفاع عنه بدا",4,"د",2,0],["دافِعِ الناسَ وَزاحِم","وَخُذِ العَيشَ بِقُوَّه",5,"و",2,0],["دافقاً ليس ينتهي","أبداً سيله العرِم",6,"م",1,0],["دافعت عن نَفسي وَلَم","أَرَ من دفاع النفس بدا",7,"د",2,0],["دافعت مِثلي عَن حقيقة أُمَّة","ما إِن لها لدفاعك اِستحقاق",8,"ق",1,0],["دافعتُ بالغَزَلِ الْحَنونِ لحاظَها","شتَّانَ بيْن سِلاحِها وسلاحي",9,"ح",2,0],["دا فرع إسماعيل","حاسب دا مولي الموالي",10,"ي",1,0],["دافعت عنه المنايا","وكلِّ فادحِ أمر",11,"ر",1,0],["دافَعتَ دونَ حَريمِهِ وَبِلادِهِ","وَعِبادِهِ وَحَمَلتَ مِن أَعبائِهِ",12,"ا",3,0],["دافَعتَ عَنهُ فَكُنتَ أَملَكَ ذائِدٍ","يَحمي حَقيقَتَهُ وَخَيرَ مُحامي",13,"م",2,0],["دافتْ ليَ الأيامُ كأْسَ قطيمةٍ","تأبى المودةُ أنْ أسيغ أُجاجها",14,"ج",3,0],["دافعته جهدي فلما آدني","أسلمته نفسي فقاد لجاجها",14,"ج",3,0],["دافقاً لا يصدّه دون مجرا","ه نقيق الضفادع العاجزات",15,"ت",1,0],["دافعاً للإِشكال يرفع للذه","ن إذا أضل راية الاعتصام",16,"م",1,0],["دافعته في كلما قاله","وهو بما أبديه لا يشتفي",17,"ف",2,0],["دافقاً مثل حسامٍ مصلتٍ","أو كقوس صيغ من ذوب اللجين",18,"ن",1,0],["دافعتُ في صدرِ الظنونِ ولم يكنْ","بسوى الثُريّا يُسترابُ الفرقدُ",19,"د",1,0],["دافعت فيها عن كرامة من هووا","في الرق واعتنقوا الأذى والعارا",20,"ر",2,0],["دافعتُ دهري خائفاً منهمُ","بناصرٍ في الزمن الخاذلِ",21,"ل",1,0],["دافعَ عن صفحته شوكَ القنا","وجرحته أعينُ السِّربِ النُّجُلْ",22,"ل",1,0],["دافعتُ عنه فما كذبت","وقال فيه فما صدقْ",23,"ق",1,0],["دافَعتُ عَن أَعراضِها فَمَنَعتُها","وَلَدَيَّ في أَمثالِها أَمثالُها",24,"ل",3,0],["دافعتَ عن دينِ النَّبي وآله","إذ ليسَ غَيرُكَ مِنَ بَنيهِ يُدافع",25,"ع",1,0],["دافعت ملا يسطاع دفاعه","وحملت من بلواه ما لا يحمل",26,"ل",1,0],["دافع الجدب عَن بحيرة مَصر","وَسِواها بِهمة وَاجتِهاد",27,"د",1,0],["دافع الوَهم عَن عُلوم بِفهم","ما لَهُ في اِمتِلاكه مِن قَسيم",28,"م",1,0],["دافعتُ عن طُرُقِ الفخار فلم أَدَعْ","أحداً يُصيبُ إلى الفخار طريقا",29,"ق",2,0],["دافعَ المحلَّ والشّتاء ويبْسَ ال","عُودِ عنه قنَاعسٌ أظآرُ",30,"ر",1,0],["دافعت دون فروق","قوماً رحلت وقروا",31,"ر",3,0],["دافع الشر كاشف الضر يا اللّه","يا اللّه قد علمت فكن لي",32,"ل",2,0],["دافع الأعداءَ من حوزته","خيرُ مَن دافع عن دِينٍ وحاما",33,"م",2,0],["دافعْ بعزمِكَ أو بجهدك إنها","عَزَمَاتُ حُكْمٍ ليس بالمدفوع",34,"ع",1,0],["دافِعٌ مانِعٌ عَن الثَغرِ لا يَأ","لُو اجتِهاداً في حِفظِهِ وَاهتِمامِه",35,"م",2,0],["دَافعْتُهُنَّ عن التبرُّج بالتُّقَى","في قاب قربٍ لا يُذالُ ببُرْجُدِ",36,"د",1,0],["دافعت عنك بحد سيفي عندما","جرت الدما يوم القتال سيولا",37,"ل",2,0],["دافعتُها عن دَجنِها","بالقُلَّبِ البيضِ الغضارفْ",38,"ف",1,0],["دافعت مستنكرا عن راحة سرقت","ما بالها قطعت في ربع دينار",39,"ر",1,0],["دافع الشعب بالحكومة يظلم","ك ودافع بالشعب ظلم الحكومة",40,"م",2,1],["دافعت عنه إلى أن سقطت","بأبي مغمى عليها في فداه",41,"ا",2,0],["دافعت بالصبر الغرام وما عسى","يجدي التصبر مغرماً بدفاعه",42,"ع",2,0],["دافعتم عن سنا القرآن فالتجأت","نوراتهم لسناه والأناجيل",43,"ل",1,0],["دافعت عنكم ما استطعت فلم يفد","والصحب ذا شلو وذاك عفير",44,"ر",1,0],["دافِقاً في الزَمان يَغمُر ما في ال","قَدَم الطَلق مِن فَضاء وَبَلقَع",45,"ع",1,0],["دافِعاتٌ إِلى الغِوايةِ أَحيا","ناً وَحيناً إِلى الطريق السَويِّ",46,"ي",1,0],["دافعتُ عن حبٍ عفيفٍ طاهرٍ","يروي القلوبَ وتلك كلُّ قضيّتي",47,"ت",2,0],["دافعت إلا المنون عنه","والمرء لا يدفع المنونا",48,"ن",2,0],["دافعوا عن كرامةَ الشَّامِ هيّا","ولتكونوا للجيشِ خيرَ رديفِ",49,"ف",1,0],["دافقاً حينا وحيناً رائقاً","يتبادى رغبا في رهب",50,"ب",1,0],["دافعت عن شرف البلاد بهمةٍ","عليا وحاشاها تلامُ وتندمُ",51,"م",1,0],["دَافَعْتُ جَهْديَ والقَريضُ وسِيْلَتِي","عَنْ عِرْضِ مَنْ أُمِرَ الأَنَامُ ببرِّها",52,"ر",3,0]]}