{"poems":[[37,"أقر الله عيني إذ دعاني","https://www.aldiwan.net/poem39098.html","الوافر"],[53,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89538","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94321","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89118","الرجز"],[4043,"","https://poetry.dctabudhabi.ae/diwan/poem/205126","المنسرح"],[6180,"عشرون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81083&r=&rc=17",""]],"verses":[["وَكَيفَ ذَكَرتُ حالَ أَبي خُبَيبٍ","وَزِلَّةَ فِعلِهِ عِندَ السُؤالِ",0,"ل",1,0],["وكيف ذاك ومنكم كلُّ مقتبسٍ","من السناءِ وعنكم كلُّ ممتثلِ",1,"ل",1,0],["وَكَيفَ ذا وَأَبو بَكرٍ خَليفَتُهُ","وَهوَ الرَفيقُ لهُ إِذ ضَمَّهُ الغارُ",2,"ر",1,0],["وكيف ذا وهو القديم الأزلى","وقد مضى برهانه وهو جلى",3,"ل",2,0],["وكيف ذلك وذو الكتمان","قد باء باللعنة في القرآن",3,"ن",1,0],["وكيف ذو أسر شبيه الحر","عطاردٌ بصيتِها صريخُ",4,"خ",1,0],["وكيف ذاك الحس الذّكي وقد","باشر تلك المذاقة البشعة",5,"ع",2,0],["وكيفَ ذاكَ الشوقُ أخفَيتُهُ","تحتَ غِطاءِ الشّاعِرِ الفيلسوفْ",6,"ف",1,0]]}