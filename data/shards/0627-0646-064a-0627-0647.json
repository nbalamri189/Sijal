{"poems":[[55,"لمن الحدوج تهزهن الأنيق","https://www.aldiwan.net/poem29959.html","الكامل"],[6,"طرق الخيال ولا كليلة مدلج","https://www.aldiwan.net/poem384.html",""],[95,"يا آل برنوطي تحية صاحب","https://www.aldiwan.net/poem11425.html","الكامل"],[43,"طرب الفؤاد لطيف روضة غاشي","https://www.aldiwan.net/poem42372.html","الكامل"],[29,"أبلغ رياحا مردها وكهولها","https://www.aldiwan.net/poem5793.html","الكامل"],[91,"طلعت من الافق الجديد عطارد","https://www.aldiwan.net/poem44628.html","الكامل"],[47,"أحبب إلي بطيف سعدى الآتي","https://www.aldiwan.net/poem62643.html","الكامل"],[99,"قد هنأوك بمجدك الإسباني","https://www.aldiwan.net/poem24585.html","الكامل"],[83,"يلحى الزمان وما عليه ملام","https://www.aldiwan.net/poem61489.html","الكامل"],[15,"طاف الخيال علينا ليلة الوادي","https://www.aldiwan.net/poem45273.html","البسيط"],[185,"طرقتك زينب والركاب مناخة","https://www.aldiwan.net/poem58848.html","الكامل"],[185,"أسألت مغنى دمنة وطلولا","https://www.aldiwan.net/poem59055.html","الكامل"],[266,"أنا مضنى نوى الأحبة نضو","https://www.aldiwan.net/poem38109.html","الخفيف"],[287,"أنى اهتدى طيف الحبيب لمرقدي","https://www.aldiwan.net/poem32794.html","الكامل"],[287,"أهلا بطيف زائر مرقدي","https://www.aldiwan.net/poem32805.html","السريع"],[302,"وافى خيالك بعد طول نفار","https://www.aldiwan.net/poem33268.html","الكامل"],[351,"طرقتك زينب والركاب مناخة","https://www.aldiwan.net/poem24116.html","الكامل"],[371,"حلوم التعتب والدلال","https://www.aldiwan.net/poem17059.html","مجزوء الكامل"],[412,"لمن الرسوم بعرصة البردان","https://www.aldiwan.net/poem50100.html","الكامل"],[412,"طرقت خيالا بعد طول صدودها","https://www.aldiwan.net/poem50186.html","الكامل"],[422,"ما زلت أول مغرم مفتون","https://www.aldiwan.net/poem54126.html","الكامل"],[447,"طيف لليلى على شحط النوى طرقا","https://www.aldiwan.net/poem14316.html","البسيط"],[543,"عفوا إذا أكثرت من إنشادي","https://www.aldiwan.net/poem48209.html","عموديه"],[556,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[558,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[580,"إني اهتديت بذلك القمر","https://www.aldiwan.net/poem2943.html","أحذ الكامل"],[580,"حتى خيالك لا وفى ولا وافى","https://www.aldiwan.net/poem3051.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138402",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138267",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138225",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126724","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126879","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66674","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64089","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38340","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38120","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38121","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38765","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38959","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38982","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38155","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38261","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38957","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38774","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38208","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70731","السريع"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96352","البسيط"],[1224,"","https://poetry.dctabudhabi.ae/diwan/poem/130644","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109157","البسيط"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114802","البسيط"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96038","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109392","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109390","السريع"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46743","الكامل"],[2964,"","https://poetry.dctabudhabi.ae/diwan/poem/121986","الطويل"],[2988,"","https://poetry.dctabudhabi.ae/diwan/poem/29434","الكامل"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22553","البسيط"],[3328,"","https://poetry.dctabudhabi.ae/diwan/poem/101867","الكامل"],[3493,"","https://poetry.dctabudhabi.ae/diwan/poem/100576","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129354","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92041","السريع"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91211","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102927","الكامل"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143835","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86466","السريع"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107280","البسيط"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69299","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94582","الكامل"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/19001","البسيط"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136405",""],[3591,"أهلاً وسهلاً بالذي هو قابلُ","https://www.poetsgate.com/ViewPoem.aspx?id=149389",""],[3591,"إني أهنّئ بالأريكة يوسفا","https://www.poetsgate.com/ViewPoem.aspx?id=149434",""],[5145,"أنّى اهتديت لنا يا طيفها الساري","https://www.poetsgate.com/ViewPoem.aspx?id=108208",""],[5295,"جَبَّارَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=177365",""],[5408,"أقسمت إني لا أخونك","https://www.poetsgate.com/ViewPoem.aspx?id=190872",""],[351,"طرقْتكَ زينَبُ والرِّكَابُ مُناخَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=4473",""],[5703,"ليلى والذئب","https://www.poetsgate.com/ViewPoem.aspx?id=206325",""],[5894,"كل الأنام من العدالة شاكر","https://www.poetsgate.com/ViewPoem.aspx?id=131408",""],[5899,"عطر النار","https://www.poetsgate.com/ViewPoem.aspx?id=31488",""],[5956,"عن حب تصادقني","https://www.poetsgate.com/ViewPoem.aspx?id=183307",""],[5956,"الله بوَّأ فريد الأطرش وأختَهُ رتبةً أُولى","https://www.poetsgate.com/ViewPoem.aspx?id=203554",""],[5956,"هدَّ انعطافي للرَّفاه قوايا","https://www.poetsgate.com/ViewPoem.aspx?id=210311",""],[5956,"الشعر يعجز أن يعلو إلى القممِ","https://www.poetsgate.com/ViewPoem.aspx?id=210476",""],[4442,"بشرى الأماني فقد زالت غواشيها","https://www.poetsgate.com/ViewPoem.aspx?id=171222",""],[6093,"زخرفة عربية","https://www.poetsgate.com/ViewPoem.aspx?id=193651",""]],"verses":[["أَنّى اِهتَديتِ وَما اِهتَدَيتُ وَبَينَنا","سورٌ عَلَيَّ مِنَ الطِعانِ وَخَندَقُ",0,"ق",1,0],["أَنّى اِهتَدَيتِ وَكُنتِ غَيرَ رَجيلَةٍ","وَالقَومُ قَد قَطَعوا مِتانَ السَجسَجِ",1,"ج",1,0],["إِنِّي أُهَنِيءُ بِالقِرَانِ حَبِيبَكُمْ","زَيْنَ الشَّبَابِ النَّادِرِ الأْمثَالِ",2,"ل",1,0],["أَنَّى اهتَدَيتِ ودُونَ أَرضكِ سَبسَبٌ","قَفرٌ وَحَزنٌ في دُجىً ورِشَاشِ",3,"ش",1,0],["إِنّي أُهابُ وَما أُراني فاعِلاً","رَهطَ اِبنِ وَقّاصٍ وَرَهطَ الأَخوَصِ",4,"ص",1,0],["اني اهنئ من فؤادي عصبة","جدت لها بعد النهوض عقائد",5,"د",1,0],["أَنّي اهتَدَيتُ لِمُحرِمينَ تَصَوَّبوا","لِسُفوحِ مَكَّةَ مِن رُبى عَرَفاتِ",6,"ت",1,0],["إني أهنيك الغداة لأنني","أهواك من قلبي ومن وجداني",7,"ن",2,0],["أَنّى اِهتَدَيتِ حَظِيَّةِ سُؤدَدِ","قَد ضَلَّ عَنها الصُبحُ وَالإِظلامُ",8,"م",1,0],["أَنّى اِهتَدَيتَ لِرَكبٍ طالَ سَيرُهُمُ","في سَبسَبٍ بَينَ دَكداكٍ وَأَعقادِ",9,"د",1,0],["أنِّى اهتَدَيتِ وَمَن هَداكِ ودُونَنا","حَمَلٌ فَقُلَّةُ عالِجٍ فالمَرقَبُ",10,"ب",1,0],["أَنّى اهتَدَيتِ وَلَم يَدَع نَأىُ الهَوَى","والكاشحونَ إِلى اللِّقَاءِ سَبِيلا",11,"ل",2,0],["اني أهل لكل ذنب","وأنت أهل لكل عفو",12,"و",1,0],["أَنّى اِهتَدى طَيفُ الحَبيبِ لِمَرقَدي","وَاللَيلُ مَكحولُ الجُفونِ بِإِثمِدِ",13,"د",1,1],["أَنّى اِهتَدى لَيلاً إِلى عاشِقٍ","يخفَى مِنَ السُقمِ عَلى العُوَّدِ",14,"د",1,0],["أَنّى اِهتَدى منك الخَيالُ لبلدةٍ","أَقصى وأَجهل من بلاد وَبارِ",15,"ر",1,0],["أَنّى اِهتَدَيتِ وَمَن هَداكِ وَبَينَنا","فَلَجٌ فَقُنَّةُ مَنعِجٍ فَالمَرقَبُ",16,"ب",1,0],["أَنّى اِهتَدَيتَ وَدونَنا","خُرسُ القَواضِبِ في جِدالِ",17,"ل",1,0],["أَنّي اِهتَدَت لك بَينَ شَعث قَد رَمَت","بِهِم البلاد نَوائِب الحَدَثانِ",18,"ن",1,0],["أَنّى اهتَدَت لا التيه منشؤها وَلا","سفح المُقَطَّمِ مِن مَجرِّ بُرودِها",19,"د",3,0],["إنِّي أهشُّ إذا ذُكِرتُ فأجتلي","راحاً تَسُرُّ فؤاد كل حزين",20,"ن",1,0],["أنى اهتدى والدجى وحف غياهبه","يشقه ويجوب المهمه العرقا",21,"ق",2,0],["إنِّي أهنِّئكُم بنَيل عزِيمَةٍ","بثَباتِها تَربُو علَى الأوطان",22,"ن",1,0],["أَنّى اِهتَديتَ وَكيفَ زُرتَ وَبَينَنا","دون الزّيارةِ مُرْبخٌ وزَرودُ",23,"د",1,0],["أَنّى اِهتَدى حَتّى أَتاني زائِراً","مُتَنَكِّراً يَتَعَسَّفُ الأَهوالا",24,"ل",2,0],["إِنِّي اهتديتُ بذلِك القمَرِ","لابل ضَلَلْتُ بحالِك الشَّعَر",25,"ر",1,1],["إِني أُهَنِّي بما لم يأت موعُده","كما أَهنيك بالعيد الَّذي وَافى",26,"ف",2,0],["اني اهنيك يا عبد العزيز بما","احرزت من فيض ذى فضل واحسان",27,"ن",1,0],["إني أهنيك يا مولاي محمود","فإنه بالأماني أشرق العيد",28,"د",1,1],["إني أهنيكما والناس قاطبة","لسانهم بالتهاني اليوم قد صدحا",29,"ح",2,0],["إنّي أُهنّي خير شهم فاضل","بأخيه إذ يلقاهُ أصبَح مسعدا",30,"د",2,0],["إنّي أهنّيهِ وأهتفُ بالثنا","لفتىً على العلياء خير أمينِ",31,"ن",1,0],["إنّي أُهنّئهم بصهرهمُ الّذي","بِفخارهِ بُشرى بكلّ ثمينِ",31,"ن",1,0],["أَنَّى اهتديتِ لركبٍ بين أوديةٍ","لم تَسْتَدِلّي ولم تَسْتَحقي زادا",32,"د",2,0],["أَنَّى اهتدى للرقَّتين كأنما","بالرقَّتين زَرُودُه وعقيقه",33,"ق",2,0],["إِنّي أُهَنّئُ جذلاناً سَعادتهُ","بِهذِهِ الرّتبَةِ العلياءِ في الحقبِ",34,"ب",1,0],["إِنّي أُهنّيهِ فيما نالَ مِن شَرفٍ","لَهُ أُقيمَت عَلى العَلياءِ أَركانُ",35,"ن",1,0],["إِنّي أُهنّيهِ إِذ عَنهُ نَأت نِقَمٌ","بِما أُنيلَ مِنَ الآلاءِ والنعَمِ",36,"م",1,0],["إِنّي أُهنّيك في هَذا القُدومِ كَما","هَنّأت نَفسي الّتي بِالبعدِ قَد قمعَت",37,"ت",1,0],["إِنّي أُهَنِّئهُ بِذا الفَتحِ المُبي","نِ فَإِنَّهُ مِن أَحسَنِ الحسناتِ",38,"ت",1,0],["إِنّي أُهنّيكَ جَذلاناً بعافيةٍ","وَأَنتَ مُستَوجب أَنّي أُهنِّيكا",39,"ك",2,0],["إِنّي أُهنِّيكَ فيهِ خَيرَ تَهنِئَةٍ","ما كانَ فيها لِغَيري الدّهر تَقليدُ",40,"د",1,0],["إِنّي أُهنّئه وَثَغري باسمٌ","بِقُدومِهِ الدّاعي إِلى الأفراحِ",41,"ح",1,0],["إِنّي أُهنِّيكَ في هَذا القُدومِ إِلى","عكّاءَ دار العُلى وَالرّوضَةِ الأُنُفِ",42,"ف",1,0],["إِنّي أُهَنّيكَ يا اِبن المَجدِ مِن شَرَفٍ","بِنِعمَةِ الفَوزِ بِالأَعدا ذَوي الهوجِ",43,"ج",1,0],["إِنّي أُهَنّيهِ في عَودٍ إِلى وَطنٍ","وَبِالَّذي نالَهُ مِن قَهرِ شانِيهِ",44,"ي",2,0],["إني أهنِّي صِنْوك المرتضَى","الضرغام والبدر المنير التمام",45,"م",1,0],["إني اهتديتُ لتسليمٍ على دمَنٍ","بالغمرِ غيَّرهُنَّ الأعصُرُ الأوَلُ",46,"ل",1,0],["اني أهنيكم بعر","س بدّل الضراء سرا",47,"ر",2,0],["إني أهنيك لا للثوب تلبسه","وقد توشى واضحى وشيه الذهب",48,"ب",1,0],["إنّي أَهُزُّك هَزّ الصَّارمِ الخَذِمِ","وبيننا كُلُّ ما تَدرِيهِ من ذِمَمِ",49,"م",1,1],["أني اهتدي مضجعي والليل منسدل","والجسم يخفى ضنى عن ملة القلم",50,"م",1,0],["اني أهنئ قبراً صار مسكنه","به فقد حاز كلَّ الخير وانتفعا",51,"ع",2,0],["اني أهنيه بنجل له","عين العلا فيم هده ترقب",52,"ب",1,0],["أَنّى اِهتَديتِ لفتيَةٍ غِبَّ السُّرى","قَد خَفَّ حِلمُهُم مَعَ الإِرمالِ",53,"ل",1,0],["أني أهله يهوى وبشر أنه","بربقة من ظبيانها ومهاتها",54,"ت",3,0],["أَنّى اِهتَدَيتِ وَكُنتِ غَيرَ رِجيلَةٍ","وَالقَومُ مِنهُم نُبَّهٌ وَرُقودُ",55,"د",1,0],["إِنّي اِهتَدَيتُ بِمَوماةٍ لِأَرحُلِنا","وَدونَ أَهلِكِ بادي الهَولِ مَجهولُ",56,"ل",1,0],["إني أهنئكم بكل بشارة","وبشارة تترى على التكرار",57,"ر",1,0],["أني أهني زماني فيك حيث زها","بنور علمك آناءاً وأياما",58,"م",2,0],["إني أهني بعيد ماجداً عاما","وفي الحقيقة للعافي هو العيد",59,"د",1,0],["إِني أُهني إن أُؤرخ وَإِن","وَفيت للفردوس عين الصَفا",60,"ف",2,0],["إِني أَهنيك بِالمَولود في شَرف","السَعد إقباله وَالعز شيعته",61,"ت",2,0],["أني اهنئكم بعيد أكبر","ووجوهكم شرف له وهناء",62,"ا",2,0],["إنّي أهين جمان الدمع منتثرا","إذا رأيت جمان العزِّ منتظما",63,"م",2,0],["أني أهواك على ما أرى","من قلة الود وبعد المزار",64,"ر",1,0],["إِنِّي أُهنِّي بكَ الشَّمسَ التي بلغت","مِنكَ المُنى وهيَ بالمأوَى فيا فَرَحا",65,"ح",2,0],["أَنّى اِهتَدَيتِ وَأَنتِ غَيرُ رَجيلَةٍ","لمبيتِ شُعثٍ كالأَسِنَّةِ سُهَّمِ",66,"م",1,0],["إني أهنئهُ بمن فاق الملا","وعلى العُلى فهو العليذُ الواحدُ",67,"د",1,0],["إِنّي إِهتَدَيتُ إِبنَةَ البَكرِيِّ مِن أُمَمٍ","مِن أَهلِ عَدوَةِ أَو مِن بَرقَةِ الخالِ",68,"ل",1,0],["اني اهنئ عن حبٍ سعادته","بمنحة دام في مسراه بعليها",69,"ي",3,0],["إني أُهني الدار فيك لأنها","فازت بامنع ما ينالُ النائل",70,"ل",1,0],["إني أهنّئ بالأريكة يوسفا","أهلاً به ملكاً كريماً منصفا",71,"ف",2,1],["أنّى اهتديت لنا يا طيفها الساري","تطوي الفلا بين أنجاد وأغوار",72,"ر",1,1],["إنِّي أهيمُ بِكَوْنِ حُسْنكِ عاشِقا","ما عاد لي غيرُ الدِّما أُهْديكِ",73,"ك",1,0],["إني أهنيءُ مَن هوى","ونعتْهُ للأجيالِ عِينُكْ",74,"ك",1,0],["أَنَّى اهتَدَيْتِ ، وَمَنْ هَدَاكِ وَبَيْنَنا","فَلْجٌ فَقُلَّةُ مَنْعِجٍ فالمَرْقَبُ",75,"ب",1,0],["إنِّي أَهواكِ وَلِي قَلبٌ","يَتَنَفَّسُ حُبَّكِ ياقَمَري",76,"ر",2,0],["إني أهنئ معهد الإسلام إذ","صرت الرئيس له فمثلك ناصر",77,"ر",1,0],["إني أهواك ولا أدري","إن كان هواك يعاديني",78,"ن",2,0],["إني أهيم بنَبْت لا يفارقني","طول الطريق وبالأشذاء يشفيني",79,"ن",2,0],["إني أهيم بلحنه التعبيري","فبِكلِّ لحنٍ ألفُ حقْلِ عبيرِ",80,"ر",1,0],["إني أهيم بزوجة جبّارة","صبَّارة هي قدوة لصبايا",81,"ا",3,0],["إني أهيم بهذا الطاهر القدمِ","لأنه من كبار الخلق كلهمِ",82,"م",1,0],["أني أهنيك في عرس ومن قدم","إليك علياك قد زفت تهانيها",83,"ي",3,0],["إنِّي اهتديتُ لأصلها من وجْهِهَا","فالوجهُ فيهِ زخارفٌ عربيَّهْ",84,"ي",2,0]]}