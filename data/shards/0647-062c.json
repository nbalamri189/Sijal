ً","https://www.poetsgate.com/ViewPoem.aspx?id=29268",""],[31,"هجرتِ الحبيبَ اليومَ من غير ما اجترمْ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19055&r=&rc=318",""]],"verses":[["هَجَرونا وَلَم يُلاموا وَواصَل","نا عَلى مُؤلِمٍ مِنَ التَعنيفِ",0,"ف",1,0],["هَجَرَت رِكابُ الرَكبِ بَعدَكَ قَطعَها","هَولَ الدُجى وَمَهاوِلَ الأَوعارِ",1,"ر",1,0],["هَجَمتَ عَلى جَوِّها بِالرِماحِ","تَبني مِنَ الطَلِّ فيها مَنارا",2,"ر",2,0],["هَجَمنا عَلى غَولِ الطَريقِ وَبُعدِهِ","وَما رَكَضَت فيهِ الرِياحُ الصَوارِدُ",3,"د",1,0],["هجَرَ الكَرى قَلِقَ الجُفونِ بهِ فلَو","عثَرَ الخَيالُ بطَرْفِهِ ما غمّضا",4,"ض",2,0],["هَجَرتُكِ فَاِمضي حَيثُ شِئتِ وَجَرِّبي","مِنَ الناسِ غَيري فَاللَبيبُ يُجَرِّبُ",5,"ب",1,0],["هَجَرتُكَ لَمّا رَأَيتُ الجَفا","وَإِن كانَ هَجرُكَ عِندي عَظيما",6,"م",2,0],["هَجَرتِنا يا مَلولُ","وَالهَجرُ مُرٌّ ثَقيلُ",7,"ل",1,1],["هَجَرتُم وَلَم نَقِدر عَلى ما قَدَرتُمُ","عَلَيهِ وَأَنتُم تَرقُدونَ وَنَسهَرُ",8,"ر",1,1],["هَجَرتُ النَدامى خَشيَةَ السُكرِ إِنَّما","يُضيعُ الفَتى أَسرارَهُ حينَ يَسكَرُ",9,"ر",1,1],["هَجَرتُكِ عادياً طَوري","فَلَم أَرشُد وَلَم أُصِبِ",10,"ب",1,0],["هجَمْتُ على هوْلِ الغَرامِ بمُهْجَةٍ","تَعامَتْ فلمْ تدْرِ النّعيمَ منَ الباسِ",11,"س",1,0],["هِجنَ بِهِ فَاِنصاعَ مُنصَلِتاً","كَالنَجمِ يَختارُ الكَثيبَ أَبَل",12,"ل",1,0],["هَجَرَ السِياسَةَ لِلسِيا","سَةَ لا لِنَومٍ أَو قَرارِ",13,"ر",1,0],["هَجَعتَ يا طَيرُ وَلَم أَهجَعِ","ما أَنتَ إِلّا عاشِقٌ مُدَّعي",14,"ي",1,1],["هَجَوتُ الأَكابِرَ في جِلَّقٍ","وَرُعتُ الوَضيعَ بِهَجوِ الرَفيعِ",15,"ع",1,1],["هَجَرَت بَلوذانا مُهاجِرَةً","وَتَنَصَّلَت مِن غلظَةِ الجَبَلِ",16,"ل",1,0],["هَجَرتَ لَهُ الدارَ الَّتي أَنتَ آلِفٌ","لِيَعتادَهُ مَحضُ الهَوى مِنكَ واصِلُ",17,"ل",1,0],["هِجانُ اللَونِ وَاضِحَةُ المُحَيّا","قَطيعُ الصَوتِ آنِسَةٌ كَسولُ",18,"ل",1,0],["هِجْرَةٌ بَعْدَ أُخْرَى بعد أُخْرى","وَهُمُومٌ فِي إِثْرِهِنَّ هُمُومُ",19,"م",1,0],["هَجَرتُكَ لَم أَهجُركَ مِن كُفرِ نِعمَةٍ","وَهَل يُرتَجى نَيلُ الزِيادَةِ بِالكُفرِ",20,"ر",1,1],["هَجانٌ جَعَلنَ السورَ وَالعاجَ وَالبُرى","عَلى مِثلِ بَردِيِّ البِطاحِ النَواعِمِ",21,"م",1,0],["هَجائِنَ مِن ضَربِ العَصافيرِ ضَربُها","أَخَذنا أَباها يَومَ دارَةِ مَأسَلِ",22,"ل",1,0],["هَجومٍ عَلَيها نَفسَهُ غَيرَ أَنَّهُ","مَتى يُرمَ في عَينَيهِ بِالشَبحِ يَنهَضُ",23,"ض",1,0],["هِجانٍ مِنَ الدَهنا كَأَنَّ مُتونَها","إِذا أَبرَقَت أَثباجُ أَحصِنَةٍ شُقرِ",24,"ر",1,0],["هِجانٍ تَفُتَّ المِسكَ في مُتَناعِمٍ","سُخامِ القُرونِ غَيرِ صُهبٍ وَلا زُعرِ",24,"ر",1,0],["هِجانَ الثَنايا مُغرِباً لَو تَبَسَّمَت","لأَِخرَسَ عَنهُ كادَ بِالقَولِ يُفصِحُ",25,"ح",1,0],["هَجَنَّعٌ راحَ في سَوداءَ مُخمَلَة","مِنَ القَطائِفِ أَعلى ثَوبِهِ الهُدَبُ",26,"ب",1,0],["هِجنَ الهَوى وَمَضى لِعَهدِكَ حِقبَةٌ","وَبَلينَ غَيرَ دَعائِمِ التَخيِيمِ",27,"م",1,0],["هِجرَةٌ حُوِّلت من الأوسِ والخَز","رَجِ أهلِ الفَسِيلِ والآطَامِ",28,"م",1,0],["هَجَوتَ مُحَمَّداً فَأَجَبتُ عَنهُ","وَعِندَ اللَهِ في ذاكَ الجَزاءُ",29,"ا",2,0],["هَجَوتَ مُبارَكاً بَرّاً حَنيفاً","أَمينَ اللَهِ شيمَتُهُ الوَفاءُ",29,"ا",2,0],["هجر الشباب ومن أحب","وكنت ذا نعمى وطيش",30,"ش",1,1],["هجرتِ وما فاز المحبّ بزورةٍ","فديتك زُوري واهجري بعد ذلك",31,"ك",1,0],["هجرت بديع القول هجر المباين","فلا بالمعالي لا ولا بالمعاين",32,"ن",1,1],["هَجرٌ يَسوءُ وَوَصَلٌ لا أُسَرُّ بِهِ","مالي يَدورُ بِما لا أَشتَهي الفَلَكُ",33,"ك",1,0],["هَجهجْ بكلبٍ كَلِبٍ نابحٍ","مثلك لا بالأَسَد الأَغلبِ",34,"ب",1,0],["هجرتكُمُ وهجركُمُ ورائي","صوابٌ في صوابٍ في صوابِ",35,"ب",1,0],["هجاكَ فلم يترك رجاء لمَنْ رجا","جداكَ ولا بقَّى هجاءً لمن هجا",36,"ج",2,0],["هجاني حُفَيصٌ ولم أهجه","ولكنه رجلٌ عَرْبدا",37,"د",2,1],["هجرٌ متى شئتُ قلتُ كان من ال","خسران أو قلتُ ربح متَّجَرِ",38,"ر",1,0],["هجوتُ مُهجّىً في اللئام مُحسَّداً","له شانئٌ منهم يدَ الدهر أبتر",39,"ر",1,0],["هجوتك إنذاراً لغيرك حِسبةً","وخطبك لولا ذاك مما يُحقّر",39,"ر",1,0],["هجوتَ المُسيغي الماءَ قحطانَ بعدما","لقوا من أبي يَكْسوم إحدى الدهارس",40,"س",1,0],["هَجَرَتني ظُلماً لتحميل واشِ","وأطالتْ بهجرِها إيحاشي",41,"ي",1,1],["هجوتُكَ وغدا يرفعُ الشَتمُ قدرَهُ","فشعريَ مرحومٌ وأنت الذي غُبطْ",42,"ط",1,0],["هجاء إن سكنتَ له تمادى","وإن شامَسْتَ ذلَّل من شِماسك",43,"ك",1,0],["هجاكم بمنْزُورِ الهجاءِ ووغدِه","وما حلية الحسناءِ بالعاجِ والذَّبلِ",44,"ل",1,0],["هجاءٌ إذا ما استافه قبلَ ذَوْقِهِ","رأى فيه شوباً من ذعافِ المُثمَّلِ",45,"ل",1,0],["هجوتُ الظالميَّ ولستُ أهجو","رئيساً أتقيهِ وأَرْتَجيه",46,"ي",2,0],["هجائيكَ يَشفيني وإن لم تُبالِه","وحَسبُك داءً أن أنال شِفائيا",47,"ي",2,0],["هَجَتهُ يَرابيعُ العِراقِ وَلَم يَجِد","لَها في قَديمِ الدَهرِ إِلّا التَوالِيا",48,"ي",2,0],["هَجاني بَنو الصَمعاءِ وَالبيدُ دونَها","وَما كانَ يَلقى غِبطَةً مَن هَجانِيا",48,"ي",2,0],["هَجَوتُ اِبنَ الفُرَيعَةِ إِذ هَجاني","فَما بالي وَبالُ بَني بَشيرِ",49,"ر",1,1],["هَجا الناسُ لَيلى أُمَّ كَعبٍ فَلَم يَدَع","لَها الناسُ إِلّا نَفنَفاً أَنا راقِعُه",50,"ه",1,1],["هَجَوتُ كُلَيباً أَن هَجوا آلَ دارِمٍ","وَأَمسَكتُ مِن يَربوعِهِم بِالمُخَنَّقِ",51,"ق",1,0],["هَجاني الأَلأَمانِ اِبنا دُخانٍ","وَأَيُّ الناسِ يَقتُلُهُ الهِجاءُ",52,"ا",2,1],["هَجَموا هَجمَةَ الضَراغِمِ لَمّا","هَسَبوها فَريسَةً لِلأُسودِ",53,"د",1,0],["هَجَروا الكَلامَ إِلى الدُموعِ لِأَنَّهُمُ","وَجَدوا البَلاغَةَ كُلَّها في الأَدمُعِ",54,"ع",1,0],["هَجَرتُ القَوافي ما بِنَفسي مَلالَةٌ","سِوايَ إِذا اِشَتَّدَ الزَمانُ مَلولُ",55,"ل",1,1],["هَجَرَت فَكُلُّ دَقيقَةٍ مِن هَجرِها","عِندي تُعَدُّ بِأَشهُرٍ وَسِنينِ",56,"ن",1,0],["هَجَرتَهُ فَاِمَّحَت مِنهُ بَشاشَتُهُ","ماتَ الهَوى فيهِ لمّا ماتَ شاديهِ",57,"ي",2,0],["هَجَرنا ذِكرَها حَتّى","كَأَنّا ما عَرَفناها",58,"ا",3,0],["هَجَوتُ زُهَيراً ثُمَّ إِنّي مَدَحتُهُ","وَما زالَتِ الأَشرافُ تُهجى وَتُمدَحُ",59,"ح",1,0],["هجرَ الجماعَةَ للجبالِ تَوَرُّعاً","عنها وعَنْ بَطْشِ الحَيَاةِ الدَّامي",60,"ي",1,0],["هَجَمَتْ بيَ الدُّنيا على أَهوالها","وخِضمِّها الرَّحْبِ العميقِ الطَّامي",60,"ي",1,0],["هَجَرَتْهُ أسْرابُ الحمائمِ وانْبَرَتْ","لِعَذابِهِ جنِّيةُ الدَّيْجورِ",61,"ر",1,0],["هجرت عنادلها العشاش فاقبلت","بعد العنادل تنعب الغربان",62,"ن",1,0],["هجموا على الأمراض لما أعضلت","فسعوا عسى أن يكسروا آلامها",63,"م",3,0],["هجمت عليك منية","هوجاء فاتكة جسور",64,"ر",1,0],["هجرتم فاحتملت لكم فعدتم","وشحناء المحبة لا تطول",65,"ل",1,0