ِوَعدٍ","وَتَجَنّى لِهِجرَتي وَاِجتِنابي",113,"ب",2,0],["هُجودٌ وَلا غَيرَ التُرابِ حَشِيَّةٌ","لِجَنبٍ وَلا غَيرَ القُبورِ قِبابُ",114,"ب",1,0],["هَجَرتُكِ أَيّاماً بِذي الغَمرِ إِنَّني","عَلى هَجرِ أَيّامٍ بِذي الغَمرِ نادِمُ",115,"م",1,0],["هِجانٌ فَأَمّا الضَعصُ مِن أُخرَياتِها","فَوَعثٌ وَأَمّا خَصرُها فَدَقيقُ",116,"ق",1,0],["هَجَرتُكِ مُشتاقاً وَزُرتُكِ خائِفاً","وَمِنّي عَلَيَّ الدَهرَ فيكِ رَقيبُ",117,"ب",1,0],["هَجَرتُكِ مُشتاقاً وَزُرتُكِ خائِفاً","وَفيكِ عَليَّ الدَهرَ مِنكِ رَقيبُ",118,"ب",1,0],["هَجْرٌ وإعراضٌ وَطُولُ قَطيعةٍ","فالعيشُ سُمٌّ نَاقِعٌ أو عَلْقَمُ",119,"م",1,0],["هَجرتْ مَنازِلَها بِيثربِ وَانْتَحتْ","أُخرى بِمكةَ دُورُها ما تُؤهَلُ",120,"ل",1,0],["هِجْتَ ابنَ مَظعونٍ فأقبلَ غاضباً","حَنِقاً يجيش كما يَجيشُ المِرْجَلُ",120,"ل",1,0],["هجرتُ الدَّارَ أضربُ في","فضاءِ اللهِ لولاكِ",121,"ك",1,0],["هَجَتني تَميمٌ أَن تَمَنَّيتُ أَنَّها","إِذا حُشِرَت وَالأَزدَ في جَنَّةِ الخُلدِ",122,"د",1,0],["هَجَرتَ فَمُتُّ أَيا سَيّدي","أَتَأذَنُ بِالوَصلِ لي أَن أَعيشا",123,"ش",2,0],["هَجَرتَ سِواها كُلَّ دارٍ عَرَفتَها","وَحَقَّ لِدارٍ غَيرِ دارِكَ بِالهَجرِ",124,"ر",1,0],["هَجَرتُ قَبرَهُ فَقامَت مَواثي","قُ العُلى وَالنُهى عَلَيهِ تَنوحُ",125,"ح",1,0],["هَجَمَ الشِتاءُ وَنَحنُ بِالبَيداءِ","وَالقَطرُ بَلَّ الأَرضَ بِالأَنواءِ",126,"ا",2,1],["هَجَماتُ عَزْمٍ ما لهُنّ مُقابلٌ","وجِهاتُ عَزْمٍ ما لهُنّ مُخاتِل",127,"ل",1,0],["هجَرَتْ يدايَ النصْلَ إن لم أنبعِثْ","بمُبَحِّثٍ عن شأنه ومُفحِّص",128,"ص",1,0],["هِجنا بِكَلبٍ طالَما هِجنا بِهِ","يَنتَسِفُ المِقوَدَ مِن كَلّابِهِ",129,"ب",2,0],["هَجاكَ مَن قُلتَ لا يُساوي","عودَ خِلالٍ مِنَ الخِلافِ",130,"ف",1,0],["هَجَرتُ لَهُ الَّتي عَنها نَهاني","وَكانَت لي كَمُمسِكَةِ الرِماقِ",131,"ق",1,0],["هَجَوتُ الفَضلَ دَهراً وَهوَ عِندي","رَقاشِيٌّ كَما زَعَمَ المَسولُ",132,"ل",1,1],["هَجَرتُ مَعاشِراً لَكِ في","هِمُ اِبنُ العَمِّ وَالرَحِمِ",133,"م",1,0],["هِجانٌ عَلَيها حُمرَةٌ في بَياضِها","تَروقُ بِها العَينَينِ وَالحُسنُ أَحمَرُ",134,"ر",1,0],["هَجَرتِ مَن لَم يُرِد هِجرانَ وُدِّكُمُ","وَمَن يَبيتُ لِما ضَيَّعتِ 