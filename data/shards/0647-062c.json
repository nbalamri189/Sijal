ن شاكيتان",157,"ن",1,0],["هجر الديار ديار عفراء التي","طبعت حشاشته على الأحزان",157,"ن",1,0],["هجر الفراخ أبوهمُ لمفازضةِ","مجهولة ولعلّها لمعاد",158,"د",1,0],["هَجَرَ المَجالِسَ مُذ هَجَرتِ لِعِلمِهِ","أَن لا يَطيبَ لَهُ بِغَيرِكِ مَجلِسُ",159,"س",1,1],["هَجَرتِ وَما أَقوى عَلى الهَجرِ ساعَةً","أَلا لَيتَ قَلبي مِثلَ قَلبِكِ صابِرُ",160,"ر",1,0],["هِجتَها كَبَثنَةَ إِذ","هاجَها اِبنُ مَعمَرِها",161,"ر",3,0],["هَجَعتُ في بَرزَخِ المَنايا","فَهَل سَبيلٌ إِلى اِنتِباهِ",162,"ه",1,0],["هَجَرتَني أَم شُغِلتَ عَنّي","حاشا رَشيداً مِنَ السفاهِ",162,"ه",1,0],["هَجَرتُم وَخُنتُم عَهدَ مَن لَم يَخُنكُمُ","وَقُلتُم مَلولٌ وَالمَلولُ سِواهُ",163,"ا",2,0],["هَجَرَتنا وهَجَرْنا زَيْنَبا","وصَحا القَلْبُ الذي كان صَبَا",164,"ب",2,1],["هجر الوكر ذاهلا وعلى عينيه","شيء من الوداع الأخير",165,"ر",1,0],["هجر المقامة أن تكون مناخه","بأغر تزدحم الوفود ببابه",166,"ب",2,0],["هجرتَ الديارَ فقلتُ العفا","لربع السُّرور وزُزارِهِ",167,"ر",2,1],["هجعةٌ في ظِلال \" أرزِكِ\" تَنفي","مِن هُمومي ووَحشتي واكتئابي",168,"ب",2,0],["هجَرْتَ، كأنّ الوَصْلَ أعقَبَ وحشة ،","ولم أر وصلاً قبله يعقب الهجرَا",169,"ر",2,1],["هجر الحبيب فمت من شغف","لما حرمت عزيمة الصبر",170,"ر",1,0],["هَجُومٌ عَلى الأعداءِ من كلّ وِجهَةٍ","إذا هَجهَجُوا في وَجهِ لمْ يُرَوَّعِ",171,"ع",1,0],["هَجَرْتَ المَلاهي حِسْبَةً وَتَفَرُّداً،","بآياتِ ذِكرِ الله يُتْلَى حَكيمُها",172,"م",3,0],["هجموا هجمة الضراغم لمّا","حسبوها فريسة للأسود",173,"د",1,0],["هِجاؤكُمُ قَوْماً أبُوهُمْ مُجاشِعٌ","لَهُ المأثُرَاتُ البِيضُ ذاتُ المكارِمِ",174,"م",1,0],["هجرتَ المُسيغي الماءَ قحطانَ بعدما","لقوا من أبي يَكْسوم إحدى الدهارس",175,"س",1,0],["هجرتِ الحبيبَ اليومَ من غير ما اجترمْ،","وَقَطَّعْتِ، مِنْ وُدِّي لَكِ، الحَبْلَ فَکنْصَرَمْ",176,"م",1,1]]}