{"poems":[[65,"أردد الظن بين اليأس والأمل","https://www.aldiwan.net/poem46141.html","الطويل"],[29,"أتنسى يوم حومل والدخول","https://www.aldiwan.net/poem5965.html","الوافر"],[29,"لمن الديار كأنها لم تحلل","https://www.aldiwan.net/poem5967.html","الكامل"],[74,"سد يا علي فلا نكرا ولا عجبا","https://www.aldiwan.net/poem18233.html","البسيط"],[53,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[30,"طرقت أمية في المنام تزورنا","https://www.aldiwan.net/poem5168.html","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[147,"هل فوق مجدك غاية لطلاب","https://www.aldiwan.net/poem11731.html","الكامل"],[147,"شرف المعالي من يساجلك العلى","https://www.aldiwan.net/poem11790.html","الكامل"],[147,"أما ومناقب عزت مراما","https://www.aldiwan.net/poem11818.html","الوافر"],[164,"عجل فقد نوديت يا عجلان","https://www.aldiwan.net/poem59017.html","الكامل"],[203,"إِليك غصوني يا طيور الحقائق","https://www.aldiwan.net/poem45162.html","الطويل"],[266,"أظن الصبا جابت إليك المسالكا","https://www.aldiwan.net/poem38220.html","الطويل"],[302,"تبدي السلو وأنت مرتهن","https://www.aldiwan.net/poem33145.html","أحذ الكامل"],[366,"اسلك بعزك هذا أحسن السبل","https://www.aldiwan.net/poem68071.html","البسيط"],[369,"إن أقمر الليل للسارين في حضن","https://www.aldiwan.net/poem60631.html","البسيط"],[369,"أما تحية الطرف الكحيل","https://www.aldiwan.net/poem60801.html","الوافر"],[371,"أبى الغمض والتمهيد جفناي والجنب","https://www.aldiwan.net/poem17158.html","الطويل"],[445,"أقدمت دون معالم الإسلام","https://www.aldiwan.net/poem34781.html","الكامل"],[520,"جاوز بمجدك أنجم الجوزاء","https://www.aldiwan.net/poem11996.html","الكامل"],[520,"لله من يوم أغر مجمل","https://www.aldiwan.net/poem12208.html","الكامل"],[580,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88601","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86584","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96746","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96724","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96605","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49936","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50027","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108984","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108912","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108816","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108508","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108793","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108890","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108814","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69402","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47128","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77271","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77267","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137202",""],[2684,"","https://poetry.dctabudhabi.ae/diwan/poem/131474",""],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65968","البسيط"],[2897,"","https://poetry.dctabudhabi.ae/diwan/poem/122225","الرجز"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35875","الكامل"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103596","الكامل"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103589","البسيط"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2579","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111502","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127275","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123516","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90850","البسيط"],[4888,"في ظلِّ مكتبتي","https://www.poetsgate.com/ViewPoem.aspx?id=207731",""],[4955,"حروفُ العز","https://www.poetsgate.com/ViewPoem.aspx?id=188036",""],[5216,"تحية للدكتور محمد البدري","https://www.poetsgate.com/ViewPoem.aspx?id=187620",""],[5277,"المقصورة النبوية","https://www.poetsgate.com/ViewPoem.aspx?id=187883",""],[5497,"وطنٌ يعز المرء في الأرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=206937",""],[5544,"موطني","https://www.poetsgate.com/ViewPoem.aspx?id=213413",""],[5582,"عُجْ بِالمَطِيِّ فَهذا السَّفْحُ وَالعَلَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=63577",""],[5582,"نَبا عضبُ السلوّ نبا","https://www.poetsgate.com/ViewPoem.aspx?id=63457",""],[5694,"نرهب عدو الدين","https://www.poetsgate.com/ViewPoem.aspx?id=129915",""],[5864,"عادتكَ ياوطنَ الكِرامِ لئامُ","https://www.poetsgate.com/ViewPoem.aspx?id=190486",""],[5393,"لماذا أتيتَ بهذا الزمانْ ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85467&r=&rc=34",""]],"verses":[["وافْخَرْ بِما شِدْتَ مِنْ مَجْدٍ يُؤثِّلُهُ","ندىً يَروحُ ويَغْدو غايَةَ المَثَلِ",0,"ل",1,0],["وَأَفخَرُ بِالقَماقِمِ مِن تَميمٍ","وَتَفخَرُ بِالخَبيثِ وَبِالقَليلِ",1,"ل",1,0],["وَاِفخَر بِضَبَّةَ إِنَّ أُمَّكَ مِنهُمُ","لَيسَ اِبنُ ضَبَّةَ بِالمُعَمِّ المُخوَلِ",2,"ل",1,0],["وافخر على الناسِ نفساً بالعلى شرُفت","كما فخرت عليهم قبلَ ذاكَ أبا",3,"ب",2,0],["وافخرْ بأنّك لا تُنازِعُ مَفْخراً","يا أيها الرجلُ الكريمُ شَناشِنا",4,"ن",2,0],["وَاِفخَر فَإِنَّ لَكَ المَكارِمَ وَالأُلى","رَفَعوا مَآثِرَ مَجدُها مَذكورُ",5,"ر",1,0],["وافخرْ بقَوْمِكَ أَنْ أعادُوا لِلْورَى","عهدَ البَيانِ ومُجْتلى آياتِهِ",6,"ت",2,0],["وَاِفخَر بِعَمٍّ عَمَّ جودُ يَمينِهِ","وَأَبٍ لِأَفعالِ الدَنِيَّةِ آبِ",7,"ب",1,0],["وَاِفخَر بِذا اليَومِ الَّذي أُعطي الهُدى","فيمَن أَقامَ عِمادَهُ ما أَمَّلا",8,"ل",2,0],["وَأَفخَرُ ما تَسَربَلَهُ كَريمٌ","ثَناءٌ سارَ عَن مَجدٍ أَقاما",9,"م",2,0],["وافخر بقربك منه واشكر أنعماً","أسدى إليك صنيعها السلطان",10,"ن",1,0],["وافخم اصوات الطبيعة راعدٌ","يجلجلُ في الآفاق من حسن بارقِ",11,"ق",1,0],["وافخر بالشعر ابن بابك والذي","يؤكد فخزى انني ابن بابكا",12,"ك",2,0],["واِفخر بسَبقكَ لا بِسَبق أَبٍ","فخراً فأَنتَ السابق الأرِنُ",13,"ن",1,0],["وَاِفخَر فَما الفَخر الا لِلنَبِيَّ وَمن","وَاِلى النَبِيِّ من الاِتباعِ وَالخول",14,"ل",1,0],["وافْخَرْ بمَغْناكَ في الدُّنيا وكنْ رَجلاً","إنْ شئْتَ من مُضَرٍ أو شئتَ من يَمَن",15,"ن",1,0],["وأفخَرُ إن فَخَرْتُ بمَجْد نَفْسي","إذا لم يَكْفِني شَرفُ القَبيل",16,"ل",1,0],["وَأَفخَرُ ما في البَحرِ لُؤلُؤُ قَطرهِ","فَدونَكَ نَظمي وَهوَ لُؤلُؤُكَ الرَطبُ",17,"ب",1,0],["وافْخَرْ فأنتَ لكلِّ مجدٍ مَفْخَرٌ","واسْلَمْ فأنتَ ذخيرةُ الإِسْلامِ",18,"م",1,0],["وافخر بنفس لم تزل أفعالها","جنات أرض بل نجوم سماء",19,"ا",2,0],["وافخر بأن أباك خلد ملكه","غوث الورى وغياث كل مؤمل",20,"ل",1,0],["وافخَرْ فَفَتْحُك ذا فخرٌ لمفتخرٍ","ذُخْرٌ لمدَّخِرٍ كسبٌ لمكتَسبِ",21,"ب",1,0],["وافخر بمجدٍ فوق ها","م النجم منشور الذوابه",22,"ب",2,0],["وَاِفخر بِخدمته وَطب نَفساً بِما","أَسدى عَلى الإِخلاص مِن نَعمائه",23,"ا",3,0],["واِفخر بقومِك خير قومٍ إنَّهم","أولى الورَى بالتّختِ والتيجانِ",24,"ن",1,0],["وَاِفخر بأجدادكَ الماضين إنّهمُ","قومٌ سَموا في سماء المجد مجدهمُ",25,"م",1,0],["وَأَفخَر مَن رَقى العليا","وَمَن أَعطى وَمَن وَهبا",26,"ب",2,0],["وأَفْخَرْ بأنصار النّبي محمّدٍ","من يثربٍ بالأوس أَو بالخَزْرَجِ",27,"ج",1,0],["وافخرْ بسيّد قحطانٍ وباهِ به","في فضل ماسنّ واستحسان مارَسَما",28,"م",2,0],["وافخر بما أعطاك ربك من ذكاً","باهت به الدنيا ذكاء إياس",29,"س",1,0],["وافخر فلو لم تزر مولاك زارك يا","عماد دولته الناجي من الوهن",30,"ن",1,0],["وافخر فإنك عن سميك وارث","فصل الخطاب وسطوة الأبطال",31,"ل",1,0],["وافخر فقد حلاك ربك بالتقى","والصبر في السراء والضراء",32,"ا",2,0],["وافخر بها بين القضا","ة وته إذا الجمع احتبك",33,"ك",1,0],["وافخر بأجمل منحة قد أرخت","فاخر وزه بجمال خير وسام",34,"م",1,0],["وافخر فأنت العالم العلَم الذي","يوماه يوم ندىً ويوم نضال",35,"ل",1,0],["وافخَر فَإِنَّكَ في أَوانٍ أَهلُهُ","قَد فاخَرُوا بِكَ أَهلَ كُلِّ زَمانِ",36,"ن",1,0],["وافْخَرْ على كلّ الملوك بِلَثْمِهَا","ما بعده للمستعزّ فخار",37,"ر",1,0],["وَاِفخَر بِموسى وَالمَسيح وَأَحمَد","فَالخَيرُ ما نَصَحوا الشُعوبَ وَعَلَّموا",38,"م",3,1],["وَافخَر فَإِن لَكَ الفخارَ جَميعُهُ","لا تَدَّعي شَرَفاً وَلا تَتَهَجَّمُ",39,"م",1,0],["وإف خوري سرى منها النسيم الى","مغناك يهدي لادواء الهموم شفا",40,"ف",2,0],["وافخاذ تحكيها غصون السلام","والفرق مثل الصبح ظاهر",41,"ر",1,0],["وافخر وحسبك يا ابن الشيخ مفتخراً","الأريحي وزد في وصفه وصف",42,"ف",1,0],["وافخر كفخر خالد بالعير والن","فير لا بحلّة من سرق",43,"ق",1,0],["وَاِفخَر فَلُطفِكَ بِالبَرِيَّةِ ظاهِرٌ","وَاِفخَر فَجودُكَ واضِحُ العُنوانِ",44,"ن",1,0],["وأفخر بنفسك لست دونهم","ولئن سكت فخيفة الكبر",45,"ر",1,0],["وأفخر على الناس ملء الأرض من شمم","العزّ أقعس والآباء أمجاد",46,"د",1,1],["وَاِفخَر بِرَهطِ بَني الحِماسِ وَمالِكٍ","وَبَني الضِبابِ وَرَعبَلٍ وَقِيانِ",47,"ن",1,0],["وافخر من عن سراياه وأسرته","أزاح بالبأس خطباً جل هالهم",48,"م",1,0],["وافخر على كل الأنام بخدمة","للمشهدين علاك فيها زينا",49,"ن",2,0],["وأفخرهم مجدا وأكرمهم أبا","وأسعدهم جدّا وأرفع مرتقى",50,"ق",2,0],["وافخر بجدك ينبوع الفخار ودم","لنا عزيزاً أميراً غير مأمور",51,"ر",1,0],["وأفخَرُ أنّني يومًا","إلى الكُتّابِ أَنتَسِبُ",52,"ب",1,0],["وأفخرُ أنَّني عبدٌ ذليلٌ","لمَنْ لعلاهُ قد وجّهتُ قلبي",53,"ب",2,0],["وافخرْ بِعالمِ مصرَ صارَ سفيرَها","في أرضِ أمريكا ينالُ السؤدَدا",54,"د",2,0],["وأفخرُ أني مدحتُ الرّسولَ","تناهيْتْ في مَفخَرٍ سُؤْدُدا",55,"د",2,0],["وافخر بموطنك العظيم فإنه","وطنٌ تعلى في سما العلياء",56,"ا",2,0],["وافخري بالخليل وابن دريد","والجلندى وحزبه والمهنا",57,"ن",2,0],["وَافْخَرْ بِأَجْدادِكَ الماضِينَ إِنَّهُمُ","قَوْمٌ سَما فِي سَماءِ المَجْدِ مَجْدُهُمُ",58,"م",1,0],["وَأَفْخَرُ مَنْ رَقا العَلْيا","وَمَنْ أَعْطَى وَمَنْ وَهَبَا",59,"ب",2,0],["وأفخر بحكام الوطن وأماري","وأشيل حب الدار بين أهدابي",60,"ب",2,0],["وافَخَرْ إذا افتَخَرَ الرِّجَالُ بمَاجِدٍ","في أَصْغَريهِ يُعظَّمُ الإسلامُ",61,"م",1,0],["وأفخر أني أرصّع شعري","بمدحك يا مجد هذا الزمانْ!",62,"ن",1,0]]}