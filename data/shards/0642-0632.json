{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[572,"كلي إلى اللوم غيري ربة الكله","https://www.aldiwan.net/poem69555.html","البسيط"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99986","الكامل"],[1283,"","https://poetry.dctabudhabi.ae/diwan/poem/144222","الكامل"],[1927,"","https://poetry.dctabudhabi.ae/diwan/poem/144390","الكامل"],[2256,"","https://poetry.dctabudhabi.ae/diwan/poem/216584",""],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88698","البسيط"],[5431,"حول الحرام ترى اللسان مطقطقا","https://www.poetsgate.com/ViewPoem.aspx?id=197841",""],[5751,"يا أجمل الألوان","https://www.poetsgate.com/ViewPoem.aspx?id=215022",""],[6102,"دِيوانُ العَربِ...","https://www.poetsgate.com/ViewPoem.aspx?id=182739",""]],"verses":[["قَزْمَةٌ هُمْ نَصَبوهُ عَالِياً","وَجَثوْا بَينَ يَدَيْهِ فَاشْمَخَرَّا",0,"ر",2,0],["قَزْمٌ إِذَا مَا أَجَالَتْ كَفُّهُ قَلَمَاً","فِي الطِّرْسِ قُلْتُ كَمِيُّ يَنْتَضِي نَصْلَهْ",1,"ل",2,0],["قَزَعٌ أَرَذّ فَما غَذَتْ أَخْلافُهُ","غَرْساً وَلا هُوَ بالْجَمائلِ رُوِّضَا",2,"ض",2,0],["قزوين طابت كالمدينة إذ أتى","منها الامام الأفضل ابن معافى",3,"ف",2,1],["قزوين واحدة الثغور وفضلها","في محكم الآثار فضل محكم",4,"م",1,0],["قَزَّرْت عشر سنين مَا اوِنْ","وِفْوادِيَه رَيِّض ومَبْسوط",5,"ط",1,1],["قزمجر الشيخ اذ قامَت قيامته","بصيحة اوهمتنا نفخة الصور",6,"ر",1,0],["قزمٌ ويمشي عاريا لايستحي","هل يستحي وغدٌ تقمص بيدقا؟؟",7,"ق",2,0],["قُزَحًا جميلا وارتديتُكَ واحةً","وسقيتُني وهمى عليَّ ضياكا",8,"ك",2,0],["قَزُمُوا, فَما اسطَاعُوا, فَكُنتُ عَزِيزَهُم","وَالمَوتُ مِن حَولَيَّ بَحرٌ قُلزُمُ",9,"م",1,0]]}