www.poetsgate.com/ViewPoem.aspx?id=192184",""],[5956,"شكراً لتلفاز الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=193473",""],[5956,"حُبُّ جَدَّينِ لحفيدهما الأصغر","https://www.poetsgate.com/ViewPoem.aspx?id=213232",""],[6075,"عرفتك عشفا","https://www.poetsgate.com/ViewPoem.aspx?id=193315",""],[6102,"منفى \"المتنبي\" الأخير...","https://www.poetsgate.com/ViewPoem.aspx?id=182749",""],[6102,"قاومي","https://www.poetsgate.com/ViewPoem.aspx?id=184633",""],[6102,"مَنفَى المُتَنَبِّي الأَخير...","https://www.poetsgate.com/ViewPoem.aspx?id=186300",""],[6108,"خطيئة","https://www.poetsgate.com/ViewPoem.aspx?id=192749",""],[6125,"كان الهجير وبعض الوصل ما كانا","https://www.poetsgate.com/ViewPoem.aspx?id=210895",""],[6147,"شهوة سريالية.. ليلة سقوط بغداد..","https://www.poetsgate.com/ViewPoem.aspx?id=151487",""],[6152,"العناق","https://www.poetsgate.com/ViewPoem.aspx?id=201768",""],[6152,"أهواكِ غائبة","https://www.poetsgate.com/ViewPoem.aspx?id=213226",""],[6210,"نافذة لعينيك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7248&r=&rc=17",""],[6213,"نغم المذاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85455&r=&rc=90",""],[6222,"أطلق يدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1933&r=&rc=4",""],[6239,"بَرْزَخٌ من حَجَرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76053&r=&rc=104",""],[6251,"وَثائِق ُالشَّمْس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76466&r=&rc=6",""],[6257,"الأسامي ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87194&r=&rc=19",""],[6344,"تَجاعيدُ المَرايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87963&r=&rc=3",""],[6345,"أنشودة للناي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78652&r=&rc=23",""]],"verses":[["أَدْمَاءُ كَالشَّمْسِ تَبْدُو","وَالوَقْتُ بَعْدَ الْغُرُوبِ",0,"ب",1,0],["أدماء القَتلى لديكم خضاب","أم أنين الجَرحى لكم أنغام",1,"م",1,0],["أُدمٌ مُوَشَّمَةٌ وَجَونٌ خِلفَةً","وَمَتى تَشَأ تَسمَع عِرارَ ظَليمِ",2,"م",1,0],["أدْمانةٌ تَنْزِبُ في روضةٍ","جاوبَها خِشْفٌ لها نازبُ",3,"ب",1,0],["أدِمْ عزمك في أمري","على ما كان في القِدمِ",4,"م",1,0],["آدميٌّ غير أن الْ","خَلقَ في صورةِ جِنِّي",5,"ن",2,0],["أُدمٌ مُخَدَّمَةُ السَوادِ كَأَنَّها","خَيلٌ هَوامِلُ بِتنَ في الأَجلالِ",6,"ل",1,0],["أَدُموعي خِل وَدَمعُكَ شَهدٌ","وَبُكائي زُل وَنَوحُكَ سُؤدُد",7,"د",1,0],["أَدَمنا طَعنَهُم وَالقَتلَ حَتّى","خَلَطنا في عِظامِهِمِ الكُعوبا",8,"ب",2,0],["أُدمٌ أَوانِسُ كَالأُدمِ الكَوانِسِ أَو","دُمى الكَنائِسِ لَكِن لَسنَ بِالعُطُلِ",9,"ل",1,0],["أَدمُعٌ قَد غَرينَ بِالهَمَلانِ","وَفُؤادٌ قَد لَجَّ في الخَفَقانِ",10,"ن",1,1],["أَدمى فِجاجَ الرومِ حَتّى ما لَها","سَيلٌ سِوى دُفَعِ الدِماءِ الهُمَّعِ",11,"ع",1,0],["أَدماءُ يَنفُضُ رَوقاها إِذا اِدَّمَجَت","عَنها الأَراكَ وَأَغصاناً مِنَ الدالِ",12,"ل",1,0],["أدمت سياط حزيران ظهورهم","فأدمنوها.. وباسوا كف من ضربا",13,"ب",2,0],["أَدَمْعُ ذاكَ الغزالِ فاضَ على ال","خدَّيْنِ أَم عِقْدُهُ وَهَتْ عُقَدُه",14,"د",2,0],["أَدَمتَ لِعَمري شَريَكَ المَحضَ صابِحاً","وَأَكَلَكَ بَالزُبدِ المُقَشَرَةِ البُحرا",15,"ر",2,1],["أدمعي سترٌ مسبلٌ فوق ماضٍ","قد تولى ما يستطيع رجوعا",16,"ع",2,0],["أدميت قلبك في تقرّبه","والقلب إن يخلص يَهُن دمُه",17,"ه",1,0],["أدِمِ المروءةَ والوفاءَ ولا يكنْ","حبل الديانة منك غيرَ متينِ",18,"ن",1,1],["أَدِمْ لَذّةً ما مَتّعَتكَ بساعةٍ","وما دمتَ عن عرق بِغَيرِ تَرَحُّلِ",19,"ل",1,0],["أُدمُ الظِباءِ بِهِ تُراعي خِلفَةً","وَسِخالُها في رَسمِهِ تَتَبَغَّمُ",20,"م",1,0],["أَدمى اللِقاءُ مِنَ القَنا ظَفراً لَهُ","ذَرِباً وَمَدَّ مِنَ اللِواءِ جَناحا",21,"ح",2,0],["أدموعُ النساء والأَطفالِ","تجرح القلب أم دموع الرجالِ",22,"ل",1,1],["أدموع عيونه أَصباه","زفرات الأَرمال والأَثكال",22,"ل",1,0],["أدْمى لها المَرجانُ صَفحةَ خدّهِ","وبكَى عليها اللؤلؤ المَكنون",23,"ن",1,0],["أدْمَتْ نواجِذَها الظُّبَى فكأنّما","صُبِغَتْ شكائِمُها بمثْلِ العَنْدَمِ",24,"م",1,0],["أُدمانَةٌ تَرِدُ البَريرَ بِغيلِها","تَقرو مَسارِبَ أَيكَةٍ وَتَرَدَّدُ",25,"د",1,0],["آدمُ أم حوّاءْ","أغراك بالغرسِ",26,"س",1,0],["آدميُّون قَزَامى انتحلوا","منطقَ الآلهةِ الشُّمِّ العظامِ",27,"م",1,0],["أدموعا تريدها أم رحيقا","لا ونعماك ما عرفت العقوقا",28,"ق",2,1],["أَدْمَاءُ فَتَّانَةٌ لَعُوبٌ","خَفِيفَةٌ مَا لَها قَرَارْ",29,"ر",1,1],["أَدْمَى حَشَاهَا أَنْ يَجُودَ بِنَفْسِهِ","حُباً وَلَمْ تَمْلُك فِدىً لِلْمُفْتَدِي",30,"د",2,0],["أَدْمَاءُ إِلاَّ أَنَّ كُدْرَةَ عَيْشِهَا","شَابَتْ وَضَاءَةُ لَوْنِهَا بِشَوَائِبِ",31,"ب",1,0],["أَدُمْيَةٌ فِي يَدَيْكُمْ","بِالصِّبْغِ تُعْطَى رُوَاءَ",32,"ا",2,0],["آدم سائغة كالعسل","فإذا بي تارة مركبة",33,"ه",1,0],["آدَمُ في المَوتِ وَهوَ بكرٌ","وَكُلُّ أَبنائِهِ سَواءُ",34,"ا",2,0],["أدْمَى فِجاجَ الرّومِ، حتى ما لَهَا","سُبُلٌ سِوَى دَفْعِ الدّماءِ الهُمَّعِ",35,"ع",1,0],["أدموعي خلّ ودمعك شهد ؟","وبكائي ذلّ ونوحك سؤدد ؟",36,"د",1,0],["أدمعي في السّماء أنجمها","الزّهر وفي البحر درّه والجمان",37,"ن",1,0],["أدْماءُ يَنْفُضُ رَوْقاها، إذا ادّمجَتْ،","عَنها الأرَاكَ وأغْصَاناً من الضّالِ",38,"ل",1,0],["آدَمِيَّ الطَّبْعِ نَسَّاكًا فما","آثِمَ القَلبِ مِنَ الحُسْنِ مُتَيَّمْ",39,"م",1,0],["أدمية أنت لا حياة بها","لضل باغي الحياة في الصور",40,"ر",1,0],["أَدْمُعي قَدْ تَزَاوَجَتْ","وَالأَماني أَرَامِلُ",41,"ل",1,0],["أَدمَيْتُ بِاللحَظاتِ وَجْنَتَهُ","فَاقتصَّ ناظرُهُ مِنَ القَلْبِ",42,"ب",1,0],["آدَمٌ نوحُ المسيحُ والكليم","قائلٌ كلٌّ أَنا نَفسي أنا",43,"ن",2,0],["آدمٍ ثمّ في كرام بنيهِ","كلُّ مولىً أَوصى به من يليهِ",44,"ه",1,0],["أدمعي إن سكبتها في غرام","فهي في شرعة الهوى صلوات",45,"ت",1,0],["أَدمُعٌ جاوَزَت مدى كل حُزنٍ","وَتخطَّت حُدودَ كلِّ عزاءِ",46,"ا",2,0],["أَدماءُ غَرّاءُ هَضيمُ الحَشا","واضِحَةُ اللَبّاتِ وَالنَحرِ",47,"ر",1,0],["أَدِمْ قَطْفَهُ تَظْهَرْ عَلَى كُلِّ حَاسِدٍ","وَتَظْفَرْ بِأَسْنَى مَا تُرِيدُ وَمَا تَبْغِي",48,"غ",2,0],["أدَمعُكَ لا يُكفكَفُ أو يغيضُ","وقلبُكَ في الهوى أبداً مَهيضُ",49,"ض",1,1],["أدِمَشقُ ما أمضى سيوفَ بنيكِ","تِلكَ التي ثلّت عُروشَ ملوكِ",50,"ك",1,1],["أدِمشقُ يا فَيحاءَ كُنتِ مَليكةً","وحُظوظُ أهلِ الأرضِ في أيديك",50,"ك",1,0],["أدِمشق إنّ الحقَّ يوماً غالِبٌ","والله يُعثرُ جدَّ مَن رَاموك",50,"ك",1,0],["أدمشقُ عاصمةُ البلادِ استَعصمي","باللهِ بَينَ دَسائسٍ ومكائد",51,"د",1,0],["أدِمَشقُ أينَ بنو أميّةَ قولي","لِيَقوا نضارةَ حسنكِ المبذولِ",52,"ل",1,1],["أدمشقُ أنتِ أميرةٌ أمويةٌ","بالقصرِ والكرسيّ والإكليل",52,"ل",1,0],["أدمشقُ كنتِ مليكةً حرّاسُها","عربٌ مضاجِعهُم متونُ خيول",52,"ل",1,0],["أدمشقُ لا سكنى لشاميٍّ إذا","لم يرحلِ الروميُّ بعدَ نزول",52,"ل",1,0],["أدمشقُ شرّفَكِ الخلائفُ مدةً","وزمانُهم حسَنٌ كظلِّ خضيل",52,"ل",1,0],["أَدمجتُ مدحك والأيّام عابسةٌ","وأَنتَ أَكرمُ من يُرجى لدى الأزمِ",53,"م",1,0],["أَدِم اِصطِباحاً واغتِباقاً شربَها","فالأُنسُ مَوقوفٌ على شَرِّيبها",54,"ب",3,0],["(أَدمشق) ما للحسن لا يعدوك","حتى خصصتِ به بغير شريكِ",55,"ك",1,1],["أَدمِيَةَ بيعَةٍ كُسِيَت جَمالاً","لَوَيتِ نعم ذَري اللَيّانَ عَنكِ",56,"ك",1,0],["أدمعاً البأس رائدها","لا دموع اليأس والجبن",57,"ن",1,0],["أَدم شُرب الأَتاي فَإِنَّ فيها","مَنافع لَيسَ توجد في سِواها",58,"ا",3,1],["أَدمه لَنا يا رَبّ جاهاً وَمَلجأً","وَأَسبل عَلَينا الستر بِالأَمن وَالهَنا",59,"ن",2,0],["أَدم يا رَبّنا الأَفراح فينا","وَأَسبل يا جَميل الستر سترَك",60,"ك",1,0],["أَدم خلع العذار بِدون عُذر","وَقُل يا لِلغَرام هَوايَ عُذري",61,"ر",2,1],["أَدم عَلى جَمعِنا الأَفراح لا كدر","يَشوبُ منهلها الصافي وَلا أَشبُ",62,"ب",1,0],["أَدمُعي وَالحُبُّ إِن حَكَموا","فَهوَ دَعوى وَهيَ بُرهانُ",63,"ن",1,0],["أدْمَيْتِ أفْئِدة ًقَدْ كُنْتُ أحْسَبُهَ","تَقوَى على فَهْم ِأفكاري وفلسفتي",64,"ت",2,0],["أدمى جراحاتٍ بقلبي للنّوى","وما علمتُ ناحَ حُزناً أم شَدَا",65,"د",2,0],["أَدمَت دَوابِرَ خَيلِهِ وَشَكيمها","غاراتُهُنَّ وَأَلحَقَت آطالَها",66,"ل",3,0],["أدِمِ الغرامَ فإن بكيت فإنما","هذي الدموع حَبابُ تلك الأكؤسِ",67,"س",1,0],["آدم سن لكم عصيانه","فنأيتم مثله عن ذي الجنان",68,"ن",1,0],["أُدْمِي بسنِّي أخرياتِ أناملي","نظرا إلى زمنٍ طرحتُ ورائيا",69,"ي",2,0],["أدمعُك أم عارضٌ ممطرُ","أم النفسُ ذائبة تَقطُرُ",70,"ر",1,1],["أَدُميَةٌ صيغتْ أم البدرُ هَوَى","وبَشَرٌ أم مَلَكٌ مُقَرَّبُ",71,"ب",1,0],["أدمى مناسمَها الدؤوبُ كأنَّما","أمسى عليها الوخدُ ضرباً لا زِبا",72,"ب",2,0],["آدميُّونَ حالَةَ النَّشإِ قاموا","وبهذا حقيقَةٌ سَمْحاءُ",73,"ا",2,0],["أَدماءَ مُفكِهَةً وَفَحلاً بازِلاً","أَو قارِحاً مِثلَ الهِراوَةِ سَرحَبا",74,"ب",2,0],["أَدِمْ عَلَيْنا النِّعَما","واصْرِفْ عَنّا النِّقَما",75,"م",2,1],["أدمنت في عشق السماء كرامةً","للأرض... بورك ذلك الإدمان",76,"ن",1,0],["آدم نبي واحتجب فيه عن الشيطانْ","حتى كفرْ والتبسْ أمرُهْ له ما بانْ",77,"ن",1,1],["أدمجتُ شكوايَ منهُ في العِتابِ وما","يُجدي العتابُ ولا الشَكوَى مَعَ الصممِ",78,"م",1,0],["أدماءُ تَجْني على الأكباد مُصليةً","تَبارَكَ اللهُ ما أحلَى تَجَنّيها",79,"ي",3,0],["أدمى فؤادك لحظهن كأنه","سيف ولكن في الحشا مغمود",80,"د",1,0],["أَدمى فُؤادِي حِينَ وَلّى كَما","أَدمى كُلَيباً رُمحُ جَسّاسِ",81,"س",1,0],["أَدَمي بِزَعمِكَ يا طَلَل","يُجريهِ سافِكُهُ طَلَل",82,"ل",1,1],["أُدْمٌ حَللن بها وهنَّ أوانسٌ","كالعِينَ تَرعى في مسالكِ أُهضُبِ",83,"ب",1,0],["أدمى حشاي وفي الفؤاد مرارة","أبكى العيون دماً وشلّ لساني",84,"ن",2,0],["أدْماءَ عباسِيَّة مِنْ دونِها","سَطوُ الرَّشيد ونَخْوَةُ المأْمونِ",85,"ن",1,0],["أَدَمتُ بِها سُكري أُواصِلُ رَشفَها","فَما زالَ مِنها الرِّشفُ يَستَعقبُ الرّشفا",86,"ف",2,0],["أَدِمْ لَهُ السّعودا","وَاِحفَظهُ ربَّ العالمين",87,"ن",1,0],["أَدِمهُ ظِلَّكَ الظّليلْ","وَاِنصُرهُ يا ربِّ الجَليلْ",88,"ل",1,0],["أَدِمْ إِلَهي نصرَهُ","وَدُم إِلَهي ناصِرا",88,"ر",2,0],["أُدمِجَت مِن كُلِّ وَجهٍ غَيرَ ما","أَلَّلَ الأَقيانُ مِن حَدِّ الطرَف",89,"ف",1,0],["أدِمْ يا رب سلطانَ بن سيفٍ","هو الملكُ المعظَّمُ والإمامُ",90,"م",1,1],["أدمنَ الحِرفة َالتي","غَيرَهَا ليسَ يُحسِنُ",91,"ن",1,0],["أدمنتُ غفلة َشِعْري عن تفطّنهِ","إدمانَ جَفن ِعُيوني غير مُنْطبقِ",92,"ق",1,0],["أدْمُع نافَ سَكبها","عن غُيوثٍ وأبحر",93,"ر",1,0],["أُدمٌ تُصانُ وكانَ اصلُ نجارِها","من شدقميةِ منذرٍ ومحرّقِ",94,"ق",1,0],["أدمى الجوى قُرحَ الجفون فهاتِ لي","مما تدوفَ عصارةَ السلوان",95,"ن",1,0],["ادميتني، إما رميتِ فؤادي","بعتاب مشتاق إلى إنشادي",96,"د",2,1],["أدمى بكبوته القلوب، وإنما","يبقى الجواد هو الجواد، وإن كبا",97,"ب",2,0],["أَدموع جفونك تَنسَكِب","وَغَرام ضُلوعك يَلتَهب",98,"ب",1,1],["أَدِمْ إدامَةَ حِصْنٍ أو خُذَنْ بيدي","حَرْباً ضَروساً تَشُبُّ الجَزْلَ والضّرَمَا",99,"م",2,1],["أدمى المدامع رزؤه","ورمى الأضالع بالبراح",100,"ح",1,0],["أدم الدهر وابن