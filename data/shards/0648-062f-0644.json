"حتى يقال وقد قيل","https://www.poetsgate.com/ViewPoem.aspx?id=113377",""],[5542,"حوار في ساحة المطاف","https://www.poetsgate.com/ViewPoem.aspx?id=10068",""],[482,"بسوى قربِكَ لا يُشْفَى الغليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=111425",""],[5691,"بحر عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=207064",""],[5759,"قلادة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=213395",""],[5790,"آيات سحرٍ من لحاظك تنزل","https://www.poetsgate.com/ViewPoem.aspx?id=112104",""],[6008,"الصدر ضاق","https://www.poetsgate.com/ViewPoem.aspx?id=59160",""],[520,"لله من يوم اغر محجل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577606",""],[5075,"موتوا لأجل القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82754&r=&rc=0",""],[5567,"اعتذار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81824&r=&rc=74",""]],"verses":[["وَدَّ لَو يَملِكُ البُكاءَ فَتَفدي","عَينُهُ عَينَها مِنَ العَبَراتِ",0,"ت",1,0],["ودلَّ علَيْهِمْ مَنْ تخلّفَ منْهُمُ","بمَا أودِعُوا طيبُ النّسيمِ منَ العَرْفِ",1,"ف",1,0],["وَدَليلاً لِاِبنِ مِصرٍ كُلَّما","قامَ في الغَربِ بِمِصرٍ فَاِفتَخَر",2,"ر",1,0],["ودلّ على تقلّبها انقلاب","لجِرم الأرض حين غدا كُرِيّا",3,"ر",3,0],["ودلَّ على أن الوداد مكلف","ولا عجبٌ للبدرِ أن يتكلَّفا",4,"ف",2,0],["ودَليلُ شُكْرِي طولُ صَبْري إنَّه","في طُولِ شعري فيه عِلْمي لو مُسِحْ",5,"ح",1,0],["ودليلُ العناية الحَثُّ والتَّحْ","ريكُ في الحاجة المُشارِ إليها",6,"ي",3,0],["وَدَّلو كانَ شاعِراً مِسكينا","عاشَ مِلتِن فَلَ يَكُن مَذكورا",7,"ر",2,0],["وَدَليلُ عامِ الخَصبِ عِندَ مُجَرِّبٍ","تَبكيرُ أَوَّلِ زَهرِهِ وَتُؤامُهُ",8,"م",2,0],["ودلَّ على عَدْلِه أننا","نَرى القُرَّ مُعتَدِلاً والهَجيرا",9,"ر",2,0],["وَدَليلُ قَلبي قَلبُهُ فَوِدادُهُ","كَوِدادِهِ وَصَفاؤُهُ كَصَفائِهِ",10,"ا",3,0],["وَدَليلي مِنَ التَوَسُّمِ في البي","دِ لِبادي الأَعلامِ وَالأَطوادِ",11,"د",1,0],["وَدَلالٍ مُخَيِّمٍ في ذُرى الخِي","مِ وَحِجلُ مُغَّيَبٍ في الحِجالِ",12,"ل",1,0],["وَدَليلي عَلى الَّذي","قُلتُهُ ذو الوَزارَتَين",13,"ن",1,0],["وَدَلِّيانِيَ في غَبراءَ مُظلِمَةٍ","كَما تُدَلّى دَلاةٌ بَينَ أَشطانِ",14,"ن",1,0],["ودَلَّ على تَقْوَى الإلهِ أَساسُهُ","كما دَلَّ بالوادي المُقَدَّسِ طُورُ",15,"ر",1,0],["وِدٌّ لِعُصبَةِ ريبَةٍ مُجُنٍ","أَعدى لِمَن عادَوا مِنَ الجَرَبِ",16,"ب",1,0],["وَدَلَّتهُم إِلى حُفَرٍ أَيادٍ","لَنا بِوُرودِها وَضُحَ الدَليلُ",17,"ل",1,0],["وَدَلاَثِعٍ حُمرٍ لِثَاتُهُمُ","أَبِلينَ شَرَّابِينَ لِلجُزُرِ",18,"ر",1,1],["ود لو يأتي ولكن","ليس ما فات بآتي",19,"ي",1,0],["ودَّ لوْ حولوا إلى السِّين مجرا","هُ وبَثُّوا على الطريق عيونه",20,"ن",2,0],["وَدِلاَلُ العَزيزِ بالَجمعِ ذي الأَر","كانِ كُلاٍّ مَعاذُهُ غَيرُ واقي",21,"ق",2,0],["ودّ لو يفتديكَ صقرُ قريشٍ","بالخوافي، من الردى، والقوادم",22,"م",1,0],["ودَلِّلُوهم إذا لم يُذْعنُوا لكمُو","إن المودَّة بالتدليل تُكتَسب",23,"ب",1,0],["ودليل ذاك بان مكة مِ القرى","ومدينة بقراك عنها مبرما",24,"م",2,0],["وَدَلَّ الغَواني وَعَزفَ القِيانِ","بِصَنجٍ يَمانٍ قُبَيلَ السَحَر",25,"ر",1,0],["وَدلالَةٍ تَجلو مَطالِعَ سَيرِها","غُرُّ القَرائِحِ مِن ذَوي الأَذهانِ",26,"ن",1,0],["ودليل من ينأى عليه غباوةٌ","وكذا الكتاب دليله عنوانه",27,"ن",2,0],["ودلال الشباب أحلى من الشه","د مشوباً ببارد ممطور",28,"ر",1,0],["ودلالٍ ألذَّ من حلمِ العذراء","في فجر حُبِّها المعسول",29,"ل",1,0],["ودَلَّجَ لُجٌ يسقي دارَه فَغَدَتُ","خضراءَ زاهيةً بالنَّورِ والزَهَرِ",30,"ر",1,0],["وَدَلاَلِهَا بِجَمَالِها وَكَمالِهَا","غَيْظاً لِجَارَتِهَا وَتَرْحَةَ نِدِّهَا",31,"د",3,0],["وَدَلائل الخيرات فيه فانه","كالشمس لا تخفى بكل مكان",32,"ن",1,0],["وَدَلَّ المَشيبُ عَلى رَأسِهِ","وَأَعقَبَ مِن بَعدِ شَيبِ صَلَع",33,"ع",1,0],["وَدَلَّ على آبائهِ بإِبائهِ","وبالفَرْع تَسْتَفْرِى الأُصُولُ الأَطَايِبُ",34,"ب",1,0],["وَدَليله أنّ الخَنافس أَقسَمَت","أَن لا تُفارق في فَناه الجِرجِسا",35,"س",2,0],["ودليلُ فَرسِكِ أن أشَرتِ بأنمُلٍ","مَخْضوبةٍ أظفارُها من أكْبُد",36,"د",1,0],["ودَلَّ علَيهِ القاصِدينَ يَدلُّهُم","عَلى رَأيِهِ ألا يَرى فيهِ دِرهَما",37,"م",2,0],["ودُلاني عَلى بَذلِ الن","نَدى في زَمنِ البُخلِ",38,"ل",1,0],["ودلَّت ولايَتُه الطاهِري","نَ أنَّ له مَولِداً طاهِرا",39,"ر",2,0],["ودليلٌ عَلى الذي","لا تراهُ الذي تَرى",40,"ر",2,0],["ودليل وخفير حارس","يحفظ العهد ويرعى للذمام",41,"م",1,0],["ودلائلاً قامت لدينكم","نادى بهن العقل والنقل",42,"ل",1,0],["وَدَليلُ الصِّدْقِ فيما قلْتُهُ","شرَفُ المِرِّيخِ في بَيتِ زُحَلْ",43,"ل",1,0],["ودليل شيمته صفاء جنانه","والشيء باطنه يرى من ظاهر",44,"ر",1,0],["ودلّ وجدي بكمُ أنني","أتلف ما بين الجفا والدلال",45,"ل",1,0],["ودَّ لو ما تُقلَبُ الأرضُ به","قبلَ أن يقلِبَ لي ظهرَ المِجَنِّ",46,"ن",1,0],["ودلَّ ما حطَّ عليك من سِنيِ","عمرك أنَّ الحظَّ فيما قد رحلْ",47,"ل",1,0],["ودُلّوني على رزقٍ بعيدٍ","وإن هو قلّ عن بذل السؤالِ",48,"ل",1,0],["ودلَّك المجدُ على فضيلتي","دلالةً كنتَ لها موفَّقا",49,"ق",2,0],["ودلّ بمعجزِ آياتِهِ","على قدرة الخالق المبدعِ",50,"ع",1,0],["ودلاصاً سرداً وأسمرَ خطيَّاً","وسيفاً عضباً وخيلاً وإبلا",51,"ل",2,0],["ودلَّ على مقلتيَّ السهادَ","أشفُّ البريَّةِ تيها ودلّ",52,"ل",1,0],["ودل على انخذالهم انزعاج","لأيّ ما فدلّ على انهزام",53,"م",1,0],["ودُلَّهُ أينَ حَيَّى","من الظَّلامِ المُعتِّمْ",54,"م",1,0],["وَدِلاَصٌ مِثلُ الأَضَاةِ وَطِرفٌ","أَعوَجِيٌّ كأنَّهُ مَجنُونُ",55,"ن",1,0],["ودليل ذلك أنها لم تشتعل","في الليل حتى رنقت سنة الكرى",56,"ر",2,0],["ودليل فخرك أنما شيدته","أعلى وأن بناءه من أسفل",57,"ل",1,0],["ودَليلي على ادِّعائي الذي ما","مِن سبيلٍ مَعه إلى إنكارِ",58,"ر",1,0],["وَدلَّ على أَحسابهِ بِفعاله","ونمّ عل أعراقه بالشّمائلِ",59,"ل",1,0],["ودلنا عليه بالصفات","في وحيه إذ قال يوم يأتي",60,"ي",1,0],["ودَلٌّ لا بتصنيعٍ","وحسنٌ لا بتزويرْ",61,"ر",1,0],["وَدليلُ ذَلكَ أَنَّ طَرْفِي غَاسِلٌ","قَبْلَ القِراءةِ نَقْشَهُ بِبُكائِي",62,"ي",1,0],["ودلال غيد كالغصون تمايدت","خلب العقول قوامهن إذا خطر",63,"ر",1,0],["ودَلِفتُم إلى المَعينِ إلى بَي","شَ فَلاقَى وقُوعَكم بِمطاره",64,"ر",2,0],["ودليل الرضى وتزكية الده","ر لما تملكون من أسبابِ",65,"ب",1,0],["وَدَلفتَ للعلماءِ فاسْتَنْقَصْتَهُمْ","علماً وليس بعلمك استِنْقاص",66,"ص",1,0],["ودليلي غربة البحري الشعور","الذي تحلو بذكراهُ الثغور",67,"ر",1,0],["ودليلها الوحي المبين وسنة","بهما اكتست من روعة وجمال",68,"ل",1,0],["ودَلاّكَ عمرٌو والحوادِثُ جَمّةٌ","غُروراً وما جَرّتْ عليكَ المقادِرُ",69,"ر",1,0],["ودليل ذلك ان بعضهم","كما ظننت الأمر قد بهره",70,"ر",2,0],["ودلونا على ليلي بليل","فان به الحواسد نايمونا",71,"ن",2,0],["ودل كل من تهوى عليها فانها","كمال واجلال وقل جيد النظم",72,"م",1,0],["ودل على حسن المكارم إذ هو الذي","جاء من مولاه بالحق مرشدا",73,"د",2,0],["وَدَلَستُ بِظاهر اللذات","كَم راحة تَكمن في أَذاة",74,"ه",1,0],["ودليلي قول الكلاميِّ انَّ الدينَ ما","كان فائق الافهامِ",75,"م",1,0],["وَدَلَّهَني فِراقُ بَني سَعيدٍ","فَما أَدري قَبيلاً مِن دبيرِ",76,"ر",1,0],["وَدَّ لو عاد له عهدُ الصِبا","فجرى فيه بعيدَ الأمد",77,"د",1,0],["ودليل الحب في الطرف الكلال","أو تمشي في مآقيه الحور",78,"ر",1,0],["وَدَلَّيتُ دَلوي في دِلاءٍ كثيرةٍ","إليكَ فَكانَ الماءُ ريّانَ مُعلَما",79,"م",2,1],["ودليل القول فيه","انّ اوراقك سِتُّ",80,"ت",1,0],["وَدَلَفتُ مِن كِبرٍ كَأَنّي خاتِلٌ","قَنَصاً وَمَن يَدبُب لِصَيدٍ يَختِلِ",81,"ل",1,0],["ودليلي إظهارُه","ما به من وساوس",82,"س",1,0],["ودليلي قوله ثقلت","ثم خفت وهو برهان",83,"ن",1,0],["ودليل ما قد قلته من جهلنا","من ذاتكم أني جهلت وجودي",84,"د",2,0],["ودليلي واضحٌ","مثلُ لمعِ اليرمع",85,"ع",1,0],["ودلت على هذا مقالةُ حازمٍ","إذ أعظم المطلوبُ قل المساعد",86,"د",1,0],["وَدَلِيلُهُم في ذَاكَ بَيتٌ قَالَهُ","فِيمَا يُقَالُ الأخطَلُ النَّصرَانِيُّ",87,"ن",2,0],["وَدَلاَلَةُ الأسمَاءِ أنوَاعٌ ثَلاَ","ثٌ كُلُّهَا مَعلُومَةٌ بِبَيَانِ",87,"ن",1,0],["ودلَّ على حبٍ عظيم مثوله","لديها حييّاً واهياً متجلدا",88,"د",2,0],["ودللت انك باجتهادك فارغ","لا تعرف المعقول والمنقولا",89,"ل",2,0],["وَدَلَّ بِأَنَّ النيلَ مُنقَسِم","ثَلاثَ أقسَام بِلاَ تَوَهُّم",90,"م",1,0],["ودلى اليكم سلم المجد فاصعدوا","إلى حيث آتى آل عثمان مربعاً",91,"ع",2,0],["ودليله أن لا يفارق قلبه","معنى الكلام بنغمةٍ حسناء",92,"ا",2,0],["ودّ لو ينطق اللسان بما يح","مله من محبّة وولاء",93,"ا",2,0],["ودليلٌ على شفوف المعالي","في مراقي الكمال نفعُ الأنام",94,"م",1,0],["وَدَليلُ حَقٍّ أنَّهُ الفَردُ الَّذي","فَطَرَ الجَميعَ لذي النُهى المُتَفَكِّرِ",95,"ر",1,0],["ودَلقةٌ رَهنٌ على غَلبهِ","وَلَمْ يزلْ بالنّردِ غَلاّبا",96,"ب",2,0],["ودليلي لما أقول قري