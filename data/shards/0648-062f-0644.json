{"poems":[[55,"امزجا لي بماء دجلة كأسا","https://www.aldiwan.net/poem26444.html","الخفيف"],[77,"أشارت غداة البين من خلل السجف","https://www.aldiwan.net/poem35976.html","الطويل"],[86,"علمونا الصبر يطفي ما استعر","https://www.aldiwan.net/poem10353.html","الرمل"],[88,"أرى الأيام ظامئة وليست","https://www.aldiwan.net/poem45005.html","الوافر"],[72,"تغير بدر الدين بعد مودة","https://www.aldiwan.net/poem19316.html","الطويل"],[51,"حتى متى يوري سواي وأقتدح","https://www.aldiwan.net/poem9423.html","الكامل"],[51,"ليس يستيقن العناية مشفوع","https://www.aldiwan.net/poem66728.html","الطويل"],[91,"كم خفضنا الجناح للجاهلينا","https://www.aldiwan.net/poem62791.html","عموديه"],[45,"عهدي بربعك مثلا آرامه","https://www.aldiwan.net/poem65681.html","الكامل"],[61,"ثنت لك أعطافها والخصورا","https://www.aldiwan.net/poem51673.html","المتقارب"],[66,"لا والذي جعل المودة مانعي","https://www.aldiwan.net/poem38789.html","الكامل"],[66,"شفها السير واقتحام البوادي","https://www.aldiwan.net/poem41577.html","الخفيف"],[44,"شد ما استنزلتك عن ربعك الأظ","https://www.aldiwan.net/poem30128.html","الخفيف"],[81,"كيف أصغي للعاذلين","https://www.aldiwan.net/poem61482.html","مجزوء الخفيف"],[22,"قد وزوزاني مشتدا رقابهما","https://www.aldiwan.net/poem21672.html","البسيط"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[48,"من غائب في الحب لم يؤب","https://www.aldiwan.net/poem62414.html","البسيط"],[46,"تولى سيبويه وجاش سيب","https://www.aldiwan.net/poem23142.html","الوافر"],[8,"ودلاثع حمر لثاتهم","https://www.aldiwan.net/poem21794.html","أحذ الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85657","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39567","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21073","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[106,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[119,"جف الكرى عكس الدموع معاً دما","https://www.aldiwan.net/poem23824.html","الكامل"],[135,"أحب الغناء وشرب الطلاء","https://www.aldiwan.net/poem68000.html","المتقارب"],[162,"وإذا قرأت كلامه قدرته","https://www.aldiwan.net/poem67831.html","الكامل"],[184,"الأحنف بن محمد يشكو الضوى","https://www.aldiwan.net/poem43248.html","الكامل"],[184,"نكهات الشباب تغني عن المس","https://www.aldiwan.net/poem43789.html","الخفيف"],[195,"هات يا ساق هات بنت النخيل","https://www.aldiwan.net/poem39944.html","الخفيف"],[210,"أهدي سلاما بعد النخل والشجر","https://www.aldiwan.net/poem37881.html","البسيط"],[235,"بانت فبانت راحتي من ساحتي","https://www.aldiwan.net/poem18163.html","الكامل"],[269,"أعد الوداع فما أراك تراني","https://www.aldiwan.net/poem52062.html","الكامل"],[336,"ألا رب ذي أمل كاذب","https://www.aldiwan.net/poem68736.html","المتقارب"],[346,"أرى الثغر بساما بذكرك عاطرا","https://www.aldiwan.net/poem19901.html","الطويل"],[351,"لا تعتب الوغد اللئيم إذا أسا","https://www.aldiwan.net/poem40167.html","الكامل"],[362,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[369,"أرى في عراصي راكبا مترنما","https://www.aldiwan.net/poem57161.html","الطويل"],[369,"فلما خبراني أي","https://www.aldiwan.net/poem57191.html","الهزج"],[369,"سأذكر ما أنا فيه وما","https://www.aldiwan.net/poem57387.html","المتقارب"],[369,"منعتني جفونه","https://www.aldiwan.net/poem57426.html","مجزوء الخفيف"],[388,"صلة الأرحام بالعلم الذي","https://www.aldiwan.net/poem54498.html","عموديه"],[400,"هذا كتاب كله جهل","https://www.aldiwan.net/poem33466.html","الكامل"],[402,"شرف الوغد بوغد مثله","https://www.aldiwan.net/poem49494.html","الرمل"],[413,"مذ سل في العشاق سيف الناظر","https://www.aldiwan.net/poem54147.html","الكامل"],[434,"يا مانعي النوم بقطع الوصال","https://www.aldiwan.net/poem2583.html","السريع"],[456,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[456,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[456,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[456,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[456,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[462,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[462,"حميت الأسيل بجد الأسل","https://www.aldiwan.net/poem3630.html","عموديه"],[477,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[498,"إذا رأيت هلالا","https://www.aldiwan.net/poem37772.html","المجتث"],[501,"أيها الجاهل المسيء الظن","https://www.aldiwan.net/poem21753.html","الخفيف"],[513,"ليست صفات علاك مما يمترى","https://www.aldiwan.net/poem12109.html","الكامل"],[513,"لله من يوم أغر مجمل","https://www.aldiwan.net/poem12208.html","الكامل"],[536,"أأماري في علمه أماري","https://www.aldiwan.net/poem48148.html","عموديه"],[549,"متى أنا ناج من سهام الغوائل","https://www.aldiwan.net/poem47258.html","الطويل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"أقاموا بالمواخير","https://www.aldiwan.net/poem2950.html","الهزج"],[584,"منعت جفوني لذة الإغفاء","https://www.aldiwan.net/poem17400.html","الكامل"]],"verses":[["وَدَّ لَو يَملِكُ البُكاءَ فَتَفدي","عَينُهُ عَينَها مِنَ العَبَراتِ",0,"ت",1,0],["ودلَّ علَيْهِمْ مَنْ تخلّفَ منْهُمُ","بمَا أودِعُوا طيبُ النّسيمِ منَ العَرْفِ",1,"ف",1,0],["وَدَليلاً لِاِبنِ مِصرٍ كُلَّما","قامَ في الغَربِ بِمِصرٍ فَاِفتَخَر",2,"ر",1,0],["ودلّ على تقلّبها انقلاب","لجِرم الأرض حين غدا كُرِيّا",3,"ر",3,0],["ودلَّ على أن الوداد مكلف","ولا عجبٌ للبدرِ أن يتكلَّفا",4,"ف",2,0],["ودَليلُ شُكْرِي طولُ صَبْري إنَّه","في طُولِ شعري فيه عِلْمي لو مُسِحْ",5,"ح",1,0],["ودليلُ العناية الحَثُّ والتَّحْ","ريكُ في الحاجة المُشارِ إليها",6,"ي",3,0],["وَدَّلو كانَ شاعِراً مِسكينا","عاشَ مِلتِن فَلَ يَكُن مَذكورا",7,"ر",2,0],["وَدَليلُ عامِ الخَصبِ عِندَ مُجَرِّبٍ","تَبكيرُ أَوَّلِ زَهرِهِ وَتُؤامُهُ",8,"م",2,0],["ودلَّ على عَدْلِه أننا","نَرى القُرَّ مُعتَدِلاً والهَجيرا",9,"ر",2,0],["وَدَليلُ قَلبي قَلبُهُ فَوِدادُهُ","كَوِدادِهِ وَصَفاؤُهُ كَصَفائِهِ",10,"ا",3,0],["وَدَليلي مِنَ التَوَسُّمِ في البي","دِ لِبادي الأَعلامِ وَالأَطوادِ",11,"د",1,0],["وَدَلالٍ مُخَيِّمٍ في ذُرى الخِي","مِ وَحِجلُ مُغَّيَبٍ في الحِجالِ",12,"ل",1,0],["وَدَليلي عَلى الَّذي","قُلتُهُ ذو الوَزارَتَين",13,"ن",1,0],["وَدَلِّيانِيَ في غَبراءَ مُظلِمَةٍ","كَما تُدَلّى دَلاةٌ بَينَ أَشطانِ",14,"ن",1,0],["ودَلَّ على تَقْوَى الإلهِ أَساسُهُ","كما دَلَّ بالوادي المُقَدَّسِ طُورُ",15,"ر",1,0],["وِدٌّ لِعُصبَةِ ريبَةٍ مُجُنٍ","أَعدى لِمَن عادَوا مِنَ الجَرَبِ",16,"ب",1,0],["وَدَلَّتهُم إِلى حُفَرٍ أَيادٍ","لَنا بِوُرودِها وَضُحَ الدَليلُ",17,"ل",1,0],["وَدَلاَثِعٍ حُمرٍ لِثَاتُهُمُ","أَبِلينَ شَرَّابِينَ لِلجُزُرِ",18,"ر",1,1],["ود لو يأتي ولكن","ليس ما فات بآتي",19,"ي",1,0],["ودَّ لوْ حولوا إلى السِّين مجرا","هُ وبَثُّوا على الطريق عيونه",20,"ن",2,0],["وَدِلاَلُ العَزيزِ بالَجمعِ ذي الأَر","كانِ كُلاٍّ مَعاذُهُ غَيرُ واقي",21,"ي",1,0],["ودّ لو يفتديكَ صقرُ قريشٍ","بالخوافي، من الردى، والقوادم",22,"م",1,0],["ودَلِّلُوهم إذا لم يُذْعنُوا لكمُو","إن المودَّة بالتدليل تُكتَسب",23,"ب",1,0],["ودليل ذاك بان مكة مِ القرى","ومدينة بقراك عنها مبرما",24,"م",2,0],["وَدَلَّ الغَواني وَعَزفَ القِيانِ","بِصَنجٍ يَمانٍ قُبَيلَ السَحَر",25,"ر",1,0],["وَدلالَةٍ تَجلو مَطالِعَ سَيرِها","غُرُّ القَرائِحِ مِن ذَوي الأَذهانِ",26,"ن",1,0],["ودليل من ينأى عليه غباوةٌ","وكذا الكتاب دليله عنوانه",27,"ن",2,0],["ودلال الشباب أحلى من الشه","د مشوباً ببارد ممطور",28,"ر",1,0],["ودلالٍ ألذَّ من حلمِ العذراء","في فجر حُبِّها المعسول",29,"ل",1,0],["ودَلَّجَ لُجٌ يسقي دارَه فَغَدَتُ","خضراءَ زاهيةً بالنَّورِ والزَهَرِ",30,"ر",1,0],["وَدَلاَلِهَا بِجَمَالِها وَكَمالِهَا","غَيْظاً لِجَارَتِهَا وَتَرْحَةَ نِدِّهَا",31,"د",3,0],["وَدَلائل الخيرات فيه فانه","كالشمس لا تخفى بكل مكان",32,"ن",1,0],["وَدَلَّ المَشيبُ عَلى رَأسِهِ","وَأَعقَبَ مِن بَعدِ شَيبِ صَلَع",33,"ع",1,0],["وَدَلَّ على آبائهِ بإِبائهِ","وبالفَرْع تَسْتَفْرِى الأُصُولُ الأَطَايِبُ",34,"ب",1,0],["وَدَليله أنّ الخَنافس أَقسَمَت","أَن لا تُفارق في فَناه الجِرجِسا",35,"س",2,0],["ودليلُ فَرسِكِ أن أشَرتِ بأنمُلٍ","مَخْضوبةٍ أظفارُها من أكْبُد",36,"د",1,0],["ودَلَّ علَيهِ القاصِدينَ يَدلُّهُم","عَلى رَأيِهِ ألا يَرى فيهِ دِرهَما",37,"م",2,0],["ودُلاني عَلى بَذلِ الن","نَدى في زَمنِ البُخلِ",38,"ل",1,0],["ودلَّت ولايَتُه الطاهِري","نَ أنَّ له مَولِداً طاهِرا",39,"ر",2,0],["ودليلٌ عَلى الذي","لا تراهُ الذي تَرى",40,"ر",2,0],["ودليل وخفير حارس","يحفظ العهد ويرعى للذمام",41,"م",1,0],["ودلائلاً قامت لدينكم","نادى بهن العقل والنقل",42,"ل",1,0],["وَدَليلُ الصِّدْقِ فيما قلْتُهُ","شرَفُ المِرِّيخِ في بَيتِ زُحَلْ",43,"ل",1,0],["ودليل شيمته صفاء جنانه","والشيء باطنه يرى من ظاهر",44,"ر",1,0],["ودلّ وجدي بكمُ أنني","أتلف ما بين الجفا والدلال",45,"ل",1,0],["ودَّ لو ما تُقلَبُ الأرضُ به","قبلَ أن يقلِبَ لي ظهرَ المِجَنِّ",46,"ن",1,0],["ودلَّ ما حطَّ عليك من سِنيِ","عمرك أنَّ الحظَّ فيما قد رحلْ",47,"ل",1,0],["ودُلّوني على رزقٍ بعيدٍ","وإن هو قلّ عن بذل السؤالِ",48,"ل",1,0],["ودلَّك المجدُ على فضيلتي","دلالةً كنتَ لها موفَّقا",49,"ق",2,0],["ودلّ بمعجزِ آياتِهِ","على قدرة الخالق المبدعِ",50,"ع",1,0],["ودلاصاً سرداً وأسمرَ خطيَّاً","وسيفاً عضباً وخيلاً وإبلا",51,"ل",2,0],["ودلَّ على مقلتيَّ السهادَ","أشفُّ البريَّةِ تيها ودلّ",52,"ل",1,0],["ودل على انخذالهم انزعاج","لأيّ ما فدلّ على انهزام",53,"م",1,0],["ودُلَّهُ أينَ حَيَّى","من الظَّلامِ المُعتِّمْ",54,"م",1,0],["وَدِلاَصٌ مِثلُ الأَضَاةِ وَطِرفٌ","أَعوَجِيٌّ كأنَّهُ مَجنُونُ",55,"ن",1,0],["ودليل ذلك أنها لم تشتعل","في الليل حتى رنقت سنة الكرى",56,"ر",2,0],["ودليل فخرك أنما شيدته","أعلى وأن بناءه من أسفل",57,"ل",1,0],["ودَليلي على ادِّعائي الذي ما","مِن سبيلٍ مَعه إلى إنكارِ",58,"ر",1,0],["وَدلَّ على أَحسابهِ بِفعاله","ونمّ عل أعراقه بالشّمائلِ",59,"ل",1,0],["ودلنا عليه بالصفات","في وحيه إذ قال يوم يأتي",60,"ي",1,0],["ودَلٌّ لا بتصنيعٍ","وحسنٌ لا بتزويرْ",61,"ر",1,0],["وَدليلُ ذَلكَ أَنَّ طَرْفِي غَاسِلٌ","قَبْلَ القِراءةِ نَقْشَهُ بِبُكائِي",62,"ي",1,0]]}