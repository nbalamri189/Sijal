{"poems":[[47,"يا خليلي بل لست لي بخليل","https://www.aldiwan.net/poem65615.html","الخفيف"],[240,"يا علي يومنا أو","https://www.aldiwan.net/poem31893.html","مجزوء الرمل"],[454,"اللغة العربية","https://www.aldiwan.net/poem969.html","عموديه"],[505,"بين طي الحبيب والنشر معنى","https://www.aldiwan.net/poem37750.html","الخفيف"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112464","الرمل"],[228,"","https://poetry.dctabudhabi.ae/diwan/poem/88077","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59565","المديد"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2420,"","https://poetry.dctabudhabi.ae/diwan/poem/95949","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[5341,"صرخة الميلاد.. صرخة للحَد","https://www.poetsgate.com/ViewPoem.aspx?id=185355",""]],"verses":[["بَينَ طَرفٍ إِلى المَكارِمِ نَظّا","رٍ وَخَدٍّ تحتَ السُؤالِ أَسيلِ",0,"ل",1,0],["بَينَ طاساتٍ كِبارِ","مُترَعاتٍ وَبَواطي",1,"ط",2,0],["بين طياتك أغلى جوهر","غرد الشادي بها وانتضدا",2,"د",2,0],["بينَ طيِّ الحَبيبِ والنَّشْرِ معْنَى","قابَ قوسَيْنِ للوُصولِ وأَدْنَى",3,"ن",2,1],["بين طرفي والكرى حرب سجال","مذ تواريت عن الكوخ القديم",4,"م",1,0],["بَينَ طَيّاتِهِ وَعن جانِبَيهِ","يَهرُبُ الماءُ بِاِرتِعاشٍ خَفيفِ",5,"ف",1,0],["بين طرف فاتر","وجبين وضحا",6,"ح",2,0],["بين طيبِ الزهورِ تجرى الهُوَينى","أنهرُ الشُّهدِ في فَسيحِ الجنانِ",7,"ن",1,0],["بين طريِّ سمكٍ ومالح","ولُقّح وصامدٍ مجالح",8,"ح",1,1],["بين طروادٍ وهذا في الأخاء","زحف الجيشان والبحر اصطفق",9,"ق",1,0],["بين طرْفة عين غافلني عناي","طحت ويديني تدوّر لي سَند",10,"د",1,0]]}