3,"وددْتُ موتاً","https://www.poetsgate.com/ViewPoem.aspx?id=144293",""],[5508,"جدَّ الصبَّا في أباطيل الهوى لعب","https://www.poetsgate.com/ViewPoem.aspx?id=110820",""],[5605,"من وحي رمضان 1436 ه","https://www.poetsgate.com/ViewPoem.aspx?id=177651",""],[2430,"سل الركب عن ليل الثوية من سرى","https://www.poetsgate.com/ViewPoem.aspx?id=90266",""],[6031,"يا أكْرَمَ النَّاسِ أعْمَاماً وأَخْوَالاَ","https://www.poetsgate.com/ViewPoem.aspx?id=46368",""],[6069,"يا أيها المولى الذي وجهه","https://www.poetsgate.com/ViewPoem.aspx?id=105654",""],[186,"أحبابنا هل لذاك العهد تذكار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55768&r=&rc=31",""],[5190,"ثمن الغربة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78316&r=&rc=29",""],[5567,"في صمتها الطرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69065&r=&rc=5",""]],"verses":[["ومن إذا ندبوا كانت جماجمهم","لله فيما أرتضى منهم قرابينا",0,"ن",2,0],["ومن إذا خَذَل الناس الحقيقة عن","جهل أقام لها في الناس رايات",1,"ت",1,0],["ومن إذا أبصرت عيناه عبدكُم","في البابِ أبصرَ ما يرجوه من فرج",2,"ج",1,0],["ومن إذا الرأي خبا نُورُهُ","فإنما يقدحُ من خاطرِهْ",3,"ر",2,0],["ومن إذا غرَّبت مكائده","كادت قلوب العتاة تنخلع",4,"ع",1,0],["ومن إذا أمطرت فواضله","عاد الصفا وهو معشب مرع",4,"ع",1,0],["ومَنْ إذا حُجَّةٌ مُجَلِّيَةٌ","لاحت لعينيه لم يكن محِكا",5,"ك",2,0],["ومنْ إذا ما فعلْتُ الفعلَ أيَّدني","إقبالُهُ فُوقيت العَثْرَ والزللا",6,"ل",2,0],["ومَنْ إذا ما أقامت لي مَواهبُه","فما أُبالي أقامَ الغيث أم ظعنا",7,"ن",2,0],["وَمَن إِذا ما لَيلُ خطبٍ دجا","لاحَ بِهِ مِن رأيِهِ نورُ",8,"ر",1,0],["ومَنْ أذنب الأيامَ حتّى إِذا انتهتْ","إِلى يومهِ الميمونِ كان لها عُذْرَا",9,"ر",2,0],["وَمَن إِذا عَدَّتِ الأَنباطُ كانَ إِذا","ما نَصَّ عَن أَصلِهِ مِن أَرذَلِ الطَبَقَه",10,"ق",2,0],["وَمَن إِذا خِفتُ في حَشري وَكانَ لَهُ","مَدحي نَجَوتُ وَكانَ المَدحُ مُعتَصَمي",11,"م",2,0],["وَمَن إِذا ما اِحتَمى النَزيلُ بِهِ","كانَ لَديهِ كَالصارِمِ النَصلِ",12,"ل",1,0],["وَمَن إِذا جارَ صَرفُ دَهرٍ","فَقَد نَجا مَن بِهِ اِستَغاثا",13,"ث",2,0],["وَمَن إِذا جَرَّحَني لَحظُهُ","غَدا بِلَحظِ خَدِّهِ يَجرَحُ",14,"ح",1,0],["وَمَن إِذا اِختَلَفوا لَم يَجتَمِع أَحَدٌ","وَلا لبِجَمعِهِمُ يَستَجمِعُ البَشَرُ",15,"ر",1,0],["وَمَنْ إذا ذَكَرْتَ سُؤْدُدَهُ","يَهُزُّني عندَ ذِكْرِهِ طَرْبَهْ",16,"ب",2,0],["ومَن آذاكَ في الدار","فنكهُ ثمّ كُل مالَه",17,"ه",1,0],["ومن أذهلته طاعة الله أثرت","عليه فلم يحفل بحال تصادم",18,"م",1,0],["ومَنْ إِذا اخْتَلَفُوا لَمْ يَجْتَمِعْ أَحَدٌ","ولاَ لِجَمْعِهِمُ يَسْتَجْمِعُ البَشَرُ",19,"ر",1,0],["ومَن إذا اشتدتِ الآراءُ خُلّصُها","رأْىٌ له كَشَبَا الهندىِّ إمضاءُ",20,"ا",2,0],["ومَن إذا عَصَفَتْ أيدي الزَّمان بنا","بجوره فله جودٌ وإعطاءُ",20,"ا",2,0],["ومَنْ إذا اشتدَّتْ الهيجاءُ في رَهَج","تجرى به في بحار الموتِ جرداءُ",20,"ا",2,0],["ومَنْ إِذا قِيلَ إِنَّ البَدْرَ يُشْبِهُهُ","حُسْناً أَتى البَدْرُ مِمَّا قِيلَ يَعْتَذِرُ",21,"ر",1,0],["وَمَنْ إِذا أَبْصَرْتُهُ مُقْبِلاً","طارَ إِلَيْهِ القَلْبُ مِنْ صَدْري",22,"ر",2,0],["ومن إِذا ورد الراجي مناهله","عادت عليه بما يهوى مصادره",23,"ر",2,0],["وَمَن إِذا حَصَلَتْ في كَفِّهِ جِدَةٌ","فَإِنَّها ثَمَنٌ يُشرى بِهِ العارُ",24,"ر",1,0],["ومَن أَذَلُّوا المُلوكِ الصِّيدَ فَاِرتَعَدَت","وَزلزلَ الأَرضَ مِما تَحتَها الرّهَبُ",25,"ب",1,0],["ومن اذا ما احاديث الندى طويت","يضوع نشر عطاياه وينتشر",26,"ر",1,0],["ومن اذا الدهر ولى عنك منحرفا","وجئت يوما حماه طاب واعتدلا",27,"ل",2,0],["ومن إذا شبّهته لم أَجِد","لوجهه شِبْهاً سوى البدر",28,"ر",1,0],["وَمَن إِذا عاتَبتُهُ","تَساقَطَ الوَردُ الجَنى",29,"ن",2,0],["وَمَن إِذا اِستَصرَخَ العافونَ راحَتَهُ","لَبّاهُمُ جودُها المَأمولُ عَن أَمَمِ",30,"م",1,0],["وَمَن إِذا قَلَّتِ العَطايا","فَجودُهُ وافِرٌ جَزيلُ",31,"ل",1,0],["وَمَن إِذا آنَسَ في ال","إِسلامِ فَتقاً رَتَقَه",32,"ق",2,0],["وَمَن إِذا ضاقَ بِنا","أَمرٌ ذَكَرنا فَاِنفَسَح",33,"ح",1,0],["وَمَن إِذا اِمتَدَحتُهُ","يُطرِبُهُ اِمتِداحي",34,"ح",2,0],["وَمَنْ إِذَا انْبَسَطَتْ كَفُّ مَعَارِفِهِ","أَمْسَى بِهَا سُنْبُلُ التَّحْقِيقِ يَنْفَرِكُ",35,"ك",1,0],["وَمَن إِذا ما تَوسَّلنا بِحُرمته","وَجاهِهِ زالَ بُؤس الكرب وَالوَجلِ",36,"ل",1,0],["ومَنْ إذا الحربُ أضرَمَتْ لهباً","لم يتأخر عنها ولم يخِمِ",37,"م",1,0],["ومن إذا جرد البيض الصوارم في ال","هيجاء أغمدها في البيض والقمم",38,"م",1,0],["ومَن إذا جادَ بالدّنيا لآمِلِهِ","قالَت معارفُهُ حاشاكَ من بَخَلِ",39,"ل",1,0],["ومَن إذا جرَّدَ البيضَ الصَّوارِمَ في ال","هَيجاءِ أسكَنَها في الهامِ والقُلَلِ",39,"ل",1,0],["ومن إذا ناظرَ ير","ضاهُ الإمامُ اليَثْربي",40,"ب",2,0],["ومن إذا مدحتَه","قال لي العُلا زدِ",41,"د",1,0],["ومَن أُذكِيتْ نارُه باليفا","عِ في القُرِّ زاحمَه المصطلونا",42,"ن",2,0],["ومَن إذا عُرِّيَ من ظلِّهِمُ","ظهري فقد ألقيتُ شِلْواً بالعَرَا",43,"ر",2,0],["ومن اذا مُضَرُ الحمراء أوضحها","سنا الفخارِ الذي دانتْ له الأممُ",44,"م",1,0],["ومَنْ إذا يَمَّمَهُ لاجيءٌ","قامَ مقامَ السيفِ والماطِرِ",45,"ر",1,0],["ومَنْ إذا نازَلَ الجَحافِلَ والإِمْلاقَ","وَلَّى جَيْشٌ وإِعْدامُ",46,"م",1,0],["وَمَن إِذا يَمَّتَهُ لَم أَزَل","ما بَينَ إِكرامٍ وَإِنعامِ",47,"م",1,0],["وَمَن إِذا ما اِستَوَينا في مَراتِبِنا","وافى إِلَينا بِراحٍ مِثلَ وَجنَتِهِ",48,"ت",2,0],["ومن إذا ذَكَرْتهُ","قلتُ الحَكيمُ الحاذقُ",49,"ق",1,0],["ومن إذا جد في يومي ندى وردى","فالليث والغيث نزر في غزارته",50,"ت",2,0],["ومن إذا شاء أطفا","بالعفو نار احتراقي",51,"ق",2,0],["ومَنْ إذَا عَنَّ خَطْبٌ أَو دَجَتْ عضلٌ","أَزالَها غَيْرَ طَيّاشٍ ولا أَقِدِ",52,"د",1,0],["وَمن إِذا اِعتَنَّ هِياجٌ لم يَخِمْ","أوْ جاد بالنَّيْلِ الجزيلِ لم يَمُنْ",53,"ن",1,0],["ومن إذا غابن حُسْ","ناً بَدْرَ تَمٍّ غَبَنَهْ",54,"ن",2,0],["ومَنْ إذا دخل الجبّارُ حضرتَهُ","يزداد عزّاً إذا ذَلّتْ له العُنُقُ",55,"ق",1,0],["ومن إذا عَرَضَتْ في الناسِ تَجرِبَةٌ","أَغنَتهُ عن شَقِّ نَفسٍ في التَجارِيبِ",56,"ب",1,0],["ومَنْ إِذا ما حَلَّ في مَوطنٍ","حَلَّ به العِزُّ وإِن سَار سَار",57,"ر",1,0],["وَمَن إِذا أَمّك الموتور أَنصفه","مِن خَصمه مشرفيٌّ مُرهف ظامي",58,"م",2,0],["وَمن إِذا لحظت عبداً عنايتُه","أَغنتهُ عَن فضة بَيضا وَعَن ذَهَب",59,"ب",1,0],["وَمَن إِذا لاحَ في خَدَّيه لي خضِرٌ","قابلتُ رَجواي من لقياه بالياسِ",60,"س",1,0],["ومن إذا ما يعد هاد","لمشكل عد في الهداةِ",61,"ه",1,0],["ومن إذا ما يعد واع","لحكمةٍ عد في الوعاةِ",61,"ه",1,0],["ومن إذا ما قضى تقضى","لحكمه الوسع في الثباتِ",61,"ت",1,0],["ومن أذى العرق وفي العرق أذى","مري فهيهاتك من أخذ العصا",62,"ا",1,0],["ومَن إذا صوَّرَ الأشياءَ أبدعها","فكلُّ خَلقٍ تراهُ فهو خالِقُهُ",63,"ه",1,1],["ومن اذا تليت اوصافه تركت","عطف اللبيب بغير الخير نشوانا",64,"ن",2,0],["وَمَنْ إِذا ما الهوى أطافَ به","تَقَسَّمَتْهُ أَيدي الهوى حِصَصَا",65,"ص",2,0],["وَمَنْ إِذا صالَ بِسُمْرِ القَنا","أَماتَ رَبَّ السّيفِ وَالطيلِسان",66,"ن",1,0],["وَمَن إِذا جالَ في الهَيجاءِ مُبتَدِراً","حَصَّنته بَطلاً بِاللّه مِن بَطَلِ",67,"ل",1,0],["وَمَنْ إِذا بارَزَ الآسادَ شِمتَهُمُ","ما بَينَ مُرتَعِشٍ مِنهُ وَمختبلِ",68,"ل",1,0],["وَمَن إِذا قَد رَأى رَأياً بِواقِعَةٍ","فَإِنّ في رَأيِهِ التّصويب مَعقودُ",69,"د",1,0],["ومنْ أذى كلِّ جمع","وكلِّ زيرٍ مُحادث",70,"ث",1,0],["ومنْ إذا قال قولا قال أحسنَه","أو قاسَ أمراً قضاه حين ما نجحا",71,"ح",2,0],["ومَنْ إذا سارَ في جَيْش يضيقُ به","وُسْعُ البلادِ ووُسْعُ السَّهل والقُنُنِ",72,"ن",1,0],["ومَنْ إذا قال قولاً قال أحسنَه","أو جادَ أَخْجلَ جودَ العارضِ الهتِنِ",72,"ن",1,0],["ومَن إذا ثار في الهيجاءِ يفعلُ في","أعدائه فَعْلة الجزار في البُدُنِ",72,"ن",1,0],["ومَنْ إذا فاخرَ الأشرافَ في مَلإٍَ","شاعَتْ مفاخِرُه في الشام واليمنِ",72,"ن",1,0],["ومن إذا ريبُ الزمانِ صدَّعَك","شتَّتَ فيكَ شملَهُ لِيَجمَعَك",73,"ك",1,0],["ومن اذا حل حروب العدى","طال على الصف بصافي الصهيل",74,"ل",1,0],["ومن إذا صنع الجو","د والمكارم تمم",75,"م",1,0],["ومن إذا بُشِّر بالمجتدي","رأيت وجها مشرقا باشرا",76,"ر",2,0],["وَمَن إِذا خاض بحرَ الحربِ منغمساً","إِليهِ دانَ وذلّ الفارسُ البطلُ",77,"ل",1,0],["ومن إذا هم أن تمضي عزائمه","رأيت ما تفعل الأقدار في الأمم",78,"م",1,0],["ومن إذا رِيع سربُ الدين خفّ له","ولم يكن لعهود الله بالناسي",79,"س",2,0],["ومن إذا سقيته المحض المري","سقاكَ شوْبًا من قذىً وكدَر",80,"ر",1,0],["وَمن إِذا عاقبته","ظَنكَ قَد راقَبته",81,"ه",1,0],["ومن إذا استلأم في لهامه","زلزلت الأرض وغصت بالشجا",82,"ا",1,0],["ومن إذا الخطب شجا القمه","قارعة تبثه بس السفا",82,"ا",1,0],["ومن إذا البغي شبا آونة","تبت يد البغي صماه بالشبا",82,"ا",1,0],["ومن