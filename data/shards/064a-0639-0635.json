{"poems":[[53,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[72,"ويح الشقي إلى متى","https://www.aldiwan.net/poem42845.html","مجزوء الكامل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16626","السريع"],[94,"","https://poetry.dctabudhabi.ae/diwan/poem/66003","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43778","المنسرح"],[108,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""],[369,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[382,"قلب يوسوس في الصدور ويخنس","https://www.aldiwan.net/poem59385.html","الكامل"],[384,"يعصب فاه الريف أي عصب","https://www.aldiwan.net/poem4529.html","الرجز"],[457,"حاءتك تعنو للجناب الرفيع","https://www.aldiwan.net/poem13830.html","السريع"],[466,"الخطب أكبر في النفوس وأعظم","https://www.aldiwan.net/poem16060.html","الكامل"],[466,"راسي الحبى في سلمه ونديه","https://www.aldiwan.net/poem16423.html","الكامل"],[469,"هذا العقيق وهذه أقماره","https://www.aldiwan.net/poem3177.html","عموديه"],[469,"يا من تلون عهده وتغيرا","https://www.aldiwan.net/poem3198.html","عموديه"],[552,"أبكي لعبد الله إذ","https://www.aldiwan.net/poem1746.html","مجزوء الرجز"],[556,"ما زال يخدعني باللطف والحيل","https://www.aldiwan.net/poem47293.html","البسيط"],[591,"يشكو إليك متيم","https://www.aldiwan.net/poem17587.html","مجزوء الكامل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6752","الكامل"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87867","البسيط"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45455","البسيط"],[552,"","https://poetry.dctabudhabi.ae/diwan/poem/26716","الرجز"],[4423,"","https://poetry.dctabudhabi.ae/diwan/poem/124248","البسيط"],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5183,"رباه","https://www.poetsgate.com/ViewPoem.aspx?id=186597",""],[5284,"هاتي ياحمص جفوني","https://www.poetsgate.com/ViewPoem.aspx?id=191790",""],[5723,"ينابيع للشهادة والزيتون","https://www.poetsgate.com/ViewPoem.aspx?id=190280",""],[5781,"يَبابهُ وربيعي","https://www.poetsgate.com/ViewPoem.aspx?id=202855",""],[6067,"بائع العسلية","https://www.poetsgate.com/ViewPoem.aspx?id=177158",""],[6102,"تحذير ..","https://www.poetsgate.com/ViewPoem.aspx?id=183311",""],[6124,"سأجرجر ذيل الخيبة","https://www.poetsgate.com/ViewPoem.aspx?id=174944",""],[6177,"بيت القصيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81087&r=&rc=34",""],[6205,"تميمة لنوم حبيبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88155&r=&rc=7",""]],"verses":[["يعصفُ جهلي بمن يُجاهلني","وإن حِلمي لغيرُ طيّاش",0,"ش",1,0],["يَعصي بِقوتِ نَهارِهِ","وَيَروحُ كَالطَيرِ الخِماصِ",1,"ص",1,0],["يَعصُونَ خالِقَهُم جَهلاً بِقُدرَتِهِ","وَيَعكُفُونَ عَلى الطاغُوتِ وَالصَّنَمِ",2,"م",1,0],["يَعْصي عمِيدُ الأمّةِ المُرْتَضَى","مَنْ بينَ عَينيه له مِيسَمُ",3,"م",1,0],["يَعْصُفُ الهولُ في جوانبه السو","دِ فَيَقْضي على صَدى العَنْدَليبِ",4,"ب",1,0],["يَعصي الَّذي أَمسَكَ السَماءَ قُوىً","وَأَنطقَ الخَلقَ بِاِختِلافِ لُغى",5,"غ",2,0],["يعصى الإله، فإن أشارت عِرسُهُ","بإشارة، فالقولُ قولُ «حذام»",6,"م",1,0],["يَعصي العذول في النّدى وما عصَى","لُوّامَه إلاَّ فتىً بالجُوِد صَب",7,"ب",1,0],["يعصي الإله ونذرَه ورئيسه","ويطيعها فهيَ الرئيس الأرأس",8,"س",1,0],["يعصب فاه الريف أي عصب","عصب الجباب بشفاه الوطب",9,"ب",1,1],["يعصو بجيد صعَّرتُه الصبَا","وخده يرشح منه السفيع",10,"ع",1,0],["يعصيه ملْثومُ الصَّعيدِ فينْثني","لصعيدِ مأزقِهِ يشَمُّ ويلْثَمُ",11,"م",1,0],["يعْصي العواذلَ في النَّوالِ وقلْبُه","للّهِ والعافي مُجيبٌ طَيِّعُ",12,"ع",1,0],["يعصي إباءً مَن نهاه عن النَّدى","ويدين طوعاً والندى أَماره",13,"ر",2,0],["يعصى الملامة في السّماحة والنّدى","من ذا يصدّ الغيث عن أن يُمطرا",14,"ر",2,0],["يَعصي البَخيلَ إِذا أَر","دَ المَجدَ مَخلوعاً عِذارُه",15,"ر",2,0],["يعصيكُمُ قلبُهُ الغاوي ومن خَجَلٍ","يُطيعكمْ لفظُهُ قولاً بلا عَمَلِ",16,"ل",1,0],["يَعْصِي العَذُولَ على هَوىً","بِكَ لا يَزالُ يُطيعُهُ",17,"ع",2,0],["يُعصى الإِلَهُ إِذا أُطِعتِ وَطاعَتي","لِلَهِ رَبّي أَن أَشُقَّ عَصاكِ",18,"ك",1,0],["يَعصِمُ مِنهُ وَزَرٌ أو مُدَّرَى","مَن عَطَّهُ زَمَانُهُ أو غَطَّهُ",19,"ه",1,0],["يعصى النهصى لا يرى عاراً يلوِّثهُ","همُّ خمول جوى تغشاه تدهشُهُ",20,"ه",1,0],["يَعصِبنَ أَلمى قَضيفاً مِن تَناصُبِها","في يَومِ نَجمٍ مِنَ الجَوزاءِ وَهّاجِ",21,"ج",1,0],["يَعصي البَخيلَ إِذا أَرا","دَ المَجدَ مَخلوعاً عِذارُه",22,"ر",2,0],["يعصي إلهاً له جلال","وهو به راحم رؤوف",23,"ف",1,0],["يعصى ويرجو أن ينال شفاعة","المختار وهي له إذا لم يلحد",24,"د",1,0],["يعصيك منتهكا فيرجع نادما","فيتوب ثم يعود دون حياء",25,"ا",2,0],["يعصِرُ البُعدُ دموعِي ودَمِي","يملأُ القلبَ سُيوفًا وقَنَا",26,"ن",2,0],["يعصون ربهم بكل فجاجة","ويكفرون عباده تكفيرا",27,"ر",2,0],["يَعْصو عَلى التَّحْنانِ حينَ يَضُمُّني","فَأَنْزَعُ عَنْ سَيْلِ الذُّنوبِ شَفاعَتي",28,"ت",2,0],["يعصِر الخمر للخدود ويُمسي","هدهدتْهُ أعطافُكِ اللولبيةْ\"",29,"ي",2,0],["يَعصِفُ الحِقدُ فِي وَرِيدِ هَياجِي","فَأُمَنِّيهِ بِالشَّهادَةِ , فاغِرْ",30,"ر",1,0],["يَعصمُني صبري ويُزكيني","صمتُ الرغبةِ وصلابةُ عودي.",31,"ي",1,0],["يعصر الروحَ للقصيدة نبضا","عاليَ الشوق مستميتا هياما",32,"م",2,0],["يعصي نواميس المكان بسيله","ويميس في وادي حماةَ طواعيةْ",33,"ي",2,0]]}