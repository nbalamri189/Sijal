{"poems":[[95,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[47,"نفسي تقيك ووالداي كلاهما","https://www.aldiwan.net/poem10210.html","الكامل"],[99,"هي صفحة طويت وحان ختام","https://www.aldiwan.net/poem24984.html","الكامل"],[52,"يا خاتم الملك يا سمعي ويا بصري","https://www.aldiwan.net/poem63811.html","البسيط"],[92,"من لندن الى بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179081",""],[124,"لا اليأس مجد ولا الآمال نافعة","https://www.aldiwan.net/poem49308.html","البسيط"],[182,"موت يشتهيه الرثاء","https://www.aldiwan.net/poem50697.html","الكامل"],[208,"هل حان أن تتعطفا","https://www.aldiwan.net/poem53245.html","مجزوء الكامل"],[236,"يا قسوة القلب مالي حيلة فيك","https://www.aldiwan.net/poem44559.html","البسيط"],[371,"ولقد خلوت بعبرة متفردا","https://www.aldiwan.net/poem17358.html","الكامل"],[376,"يا من تنزه عيني في محاسنه","https://www.aldiwan.net/poem56989.html","البسيط"],[408,"يا من بطول التجافي","https://www.aldiwan.net/poem46671.html","المجتث"],[556,"بالله يا أيام يثرب عودي","https://www.aldiwan.net/poem47844.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138294",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138208",""],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59435","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59089","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80204","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60826","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100255","الكامل"],[2921,"","https://poetry.dctabudhabi.ae/diwan/poem/34740","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87400","البسيط"],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106768","الكامل"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122229","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103057","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69904","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44644","الكامل"],[4869,"الذيب","https://www.poetsgate.com/ViewPoem.aspx?id=139687",""],[5064,"ما زِلتُ آدمَ يا تُفّاح حوَائِي","https://www.poetsgate.com/ViewPoem.aspx?id=199159",""],[5277,"ولّادةُ المنافي","https://www.poetsgate.com/ViewPoem.aspx?id=187743",""],[5277,"حارَ الطبيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=188891",""],[5544,"إلى المتفانين من أجلنا","https://www.poetsgate.com/ViewPoem.aspx?id=213440",""],[5574,"ريحُ الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=206007",""],[5595,"لا لنْ أبيعَ ضمائِري لوشاة","https://www.poetsgate.com/ViewPoem.aspx?id=150627",""],[5853,"دموعٌ وتوجع","https://www.poetsgate.com/ViewPoem.aspx?id=175615",""],[5853,"شهقة","https://www.poetsgate.com/ViewPoem.aspx?id=175695",""],[5956,"رُحماك يا نسلي العزيز","https://www.poetsgate.com/ViewPoem.aspx?id=214192",""],[4983,"أَنْتَ الطُّفُولَةُ وَالأُغْنِيَةُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82960&r=&rc=0",""],[5164,"أنت الطريق..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75657&r=&rc=11",""]],"verses":[["أنتَ الطَّبيبُ الفَرْدُ غَيْرُ مَنَازَعٍ","فِيمَا اخْتَصَصْتَ بِهِ وَأَنْتَ حَكِيمُ",0,"م",1,0],["أَنتَ الطَبيبُ لِداءِ جُرحي وَالَّذي","بِدَوائِهِ لا شَكَّ أَدفَعُ دائي",1,"ي",1,0],["أنت الطبيب وقد بلوت حياته","ومجالها الأوجاع والأسقام",2,"م",1,0],["أَنتِ الطَبيبُ فَما تَقضِينَ في رَجُلٍ","يَدعو الأَطِبّاءَ بَينَ المَوتِ وَالسَهَرِ",3,"ر",1,0],["أنت الطبيبُ لشعبي والدواءُ له","وأنت شَخَّصت منه موضعَ الداء",4,"ا",2,0],["أنت الطيب لداء قد بليت به","فداوه باقتراب غير مقصوم",5,"م",1,0],["أنت الطّريدُ عليْكَ قد جَثَمَ العنا","واسْتَفْحَلَتْ في دَرْبِكَ البأساءُ",6,"ا",2,0],["أنت الطبيب فما يضر","رُكَ لو شَفيتَ المدنَفا",7,"ف",2,0],["أنت الطليعة للشيطان في جسدي","فليس يدخل غلا من نواحيك",8,"ك",1,0],["أَنتَ الطَليقُ مِنَ الحَياةِ وَها أَنا","في سِجنِها أَمسَيتُ عَينَ العاني",9,"ن",2,0],["أنتَ الطَّبِيبُ لِداءٍ طالَما اجتَمَعت","له الأطبَّاءُ في وَقتٍ فأَعياها",10,"ا",3,0],["أنتَ الطبيبُ فمَنْ لي","من ريقِ فيكَ بشرْبَهْ",11,"ه",1,0],["أنتِ الطليقةُ في هواهُ فَاِعلمِي","وَتَحكّمي في الموثقِ المصفودِ",12,"د",1,0],["أنت الطبيب أو الحكيم لانني","شاهدت حكمتك العظيمة تبهر",13,"ر",1,0],["أنت الطبيب لكل أدواء الورى","إن حار في وصف العلاج طبيب",14,"ب",1,0],["أنت الطبيب لعلّتي","أنت الدواء المستمد",15,"د",1,0],["أنْتُ الطَّبِيبُ وَأنْتَ دَائِي فَاشْف مَا","عملَتْ بِقَلْبِي المُقْلَةُ الوَطْفَاءُ",16,"ا",2,0],["أَنتَ الطَبيبُ الَّذي مِن فَيض حكمَتِهِ","قَد طابَ لُبنان مَنقوذاً مِن التَلَفِ",17,"ف",1,0],["أنت الطبيبُ وأنت الداء واعجبٌ","مَنْ عَلّم الظبي يسطو سطوة الأسدِ",18,"د",1,0],["أنت الطبيب نعلتي","فلعلتي برء بعودك",19,"ك",1,0],["أنتِ الطبيبُ لداءٍ قد تلبَّسَ بي","من الجَوَى فانفثي في فيّ وارقيني",20,"ن",2,0],["انتَ الطَبيبُ لأَجساد العباد ولل","عقول والأَنفُس اللاتي اشتكت سَقَما",21,"م",2,0],["أنتَ الطبيبُ لِعلَّتِي وَعِلاَجُهَا","بالوَردِ أو ماءِ اللِّسَان إذا قَطَر",22,"ر",1,0],["انت الطبيب لكل داء معضل","انت الشفاء لعلتي ودوائي",23,"ي",1,0],["أنت الطبيب المستجار به","مما تلمّ طوارق الألم",24,"م",1,0],["اَنتَ الطَبيب انتَ المجيب","انتَ الحَبيب انتَ الغيور",25,"ر",1,0],["أَنتَ الطَليقُ وَها أَنا","قَيدي ثقيلْ",26,"ل",1,0],["انت الطبيب اللي يفوق التطآبيب","امرآض بعض الخلق فعلك كوآهآ",27,"ا",3,0],["أَنتِ الطَّرِيقُ إِلى قَلبِي ومَوْطِنهُ","وأَنْتِ فَجْرِي وإِشْراقِي وظَلْمَائِي",28,"ا",3,0],["أنتِ الطباقُ يفيض شهدُ مدادهِ","عشقا يفيضُ تغنجاً لجناسِي",29,"س",2,0],["أنتَ الطبيبُ فمَن يأتي بِأدويَتي","هل مُسعِفٌ غيرُكم أمِ الردى قهرا؟",30,"ر",2,0],["أنت الطبيب أو الطبيبة أنتما","أمل النجاة وبلسم الآهات",31,"ت",1,0],["٨- أنتَ الطبيبُ إذا الوصالُ تمزّقا","أنتَ الحبيبُ إذا الفراقُ تعمّقا",32,"ق",2,0],["أنتَ الطبيبُ وفي يديكَ شفائيا","مِن كلّ جرحٍ غاصَ في نزواتِ",33,"ت",1,0],["أنتِ الطبيبةُ والفؤادُ ملوّعٌ","لو تسألين عَنِ الضّنى سيقول",34,"ل",1,0],[".أنتِ الطيوف أريج نسناس الصبا","أسطورةفي موسم الاحداقِ",35,"ق",1,0],["أنت الطهور كوالديك وحاصدٌ","نصراً لكون جميع حقك مُحْكَما",36,"م",2,0],["أَنْتِ الطُّفُولَةُ لِلأَحْلامِ أُغْنِيَةٌ","زَرَعْتِ فِي الْقَلْبِ أَزْهَارَ الرَّيَاحِينِ",37,"ن",1,0],["أنت الطَّريقُ سَتبقى في دمي أَملاً","وفي الفُؤادِ رَحيلاً هَدَّه السَّفَرُ",38,"ر",1,0],["أنتَ الطريق إلى الأقصى سنقطَعُها","إن طالت الأرض والأزمان والعُمُرُ",38,"ر",1,0]]}