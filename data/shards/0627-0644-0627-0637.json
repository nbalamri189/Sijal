{"poems":[[37,"ألا طرقت بعد العشاء جنوب","https://www.aldiwan.net/poem39618.html","الطويل"],[32,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[32,"أمن دمنة جرت بها ذيلها الصبا","https://www.aldiwan.net/poem29607.html","الطويل"],[32,"خليلي عوجا بارك الله","https://www.aldiwan.net/poem29611.html","الطويل"],[29,"ألا حي رهبى ثم حي المطاليا","https://www.aldiwan.net/poem4427.html","الطويل"],[23,"حار بن كعب ألا الأحلام تزجركم","https://www.aldiwan.net/poem21367.html","البسيط"],[53,"أأحمد لا والله لا ذقت فيشتي","https://www.aldiwan.net/poem65382.html","الطويل"],[53,"عرفت مقادير الرجال بنكبة","https://www.aldiwan.net/poem66020.html","الطويل"],[31,"ألا طرقتنا ليلة أم هيثم","https://www.aldiwan.net/poem6110.html","الطويل"],[31,"ألا طرقت أروى الرحال وصحبتي","https://www.aldiwan.net/poem6158.html","الطويل"],[12,"ألا طرقت رحلي وقد نام صحبتي","https://www.aldiwan.net/poem1206.html",""],[87,"يمينا بالطلاق وبالعتاق","https://www.aldiwan.net/poem6824.html","الوافر"],[30,"ألا طرقت ظمياء والركب هجد","https://www.aldiwan.net/poem5350.html","الطويل"],[30,"ألا طالما رسفت في قيد مالك","https://www.aldiwan.net/poem5470.html","الطويل"],[30,"ولما دنا رأس التي كنت خائفا","https://www.aldiwan.net/poem5525.html","الطويل"],[60,"ألا طرق الناعي بليل فراعني","https://www.aldiwan.net/poem30795.html","الطويل"],[51,"ألا طالما خان الزمان وبدلا","https://www.aldiwan.net/poem63069.html","الطويل"],[71,"أتهزأ بي لما أجد وتلعب","https://www.aldiwan.net/poem28601.html","الطويل"],[71,"فقلت وقد أنكرت منه مقالة","https://www.aldiwan.net/poem29297.html","الطويل"],[76,"ألا طم بحر أتي طما","https://www.aldiwan.net/poem12904.html","المتقارب"],[35,"ألا طالما لاعيت ليلى وقادني","https://www.aldiwan.net/poem25878.html","الطويل"],[107,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[22,"ألا طرقتنا بعدما هجدوا هند","https://www.aldiwan.net/poem21643.html","الطويل"],[22,"ألا طرقت هند الهنود وصحبتي","https://www.aldiwan.net/poem22008.html","الطويل"],[77,"هنالك عهدي بالخليط المزايل","https://www.aldiwan.net/poem69044.html","الطويل"],[77,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[52,"ألا طرد الهوىعني رقادي","https://www.aldiwan.net/poem63855.html","الوافر"],[52,"ألا طرقت موهنا مهدد","https://www.aldiwan.net/poem63884.html","الوافر"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62239","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55506","الطويل"],[131,"ألا طرقت أسماء في غير مطرق","https://www.aldiwan.net/poem24276.html","الطويل"],[141,"تذكر شجوه القلب القريح","https://www.aldiwan.net/poem68022.html","الوافر"],[185,"ألا طرقت أميمة بعدض هدء","https://www.aldiwan.net/poem58888.html","الوافر"],[239,"ألا أيها البيت الذي أنا هاجره","https://www.aldiwan.net/poem4604.html","الطويل"],[239,"ألا طرقت ليلى وساقي رهينة","https://www.aldiwan.net/poem4606.html","الطويل"],[275,"أفيقي فردي بسمة وسلاما","https://www.aldiwan.net/poem35622.html","الطويل"],[297,"ألا من لنفس لا تؤدي حقوقها","https://www.aldiwan.net/poem441.html",""],[327,"ألا طرقتنا بالقرينين موهنا","https://www.aldiwan.net/poem56343.html","الطويل"],[327,"ألا طال التنظر والثواء","https://www.aldiwan.net/poem56353.html","الوافر"],[369,"ألا طرقتنا والثريا كقرطها","https://www.aldiwan.net/poem60853.html","الطويل"],[411,"ألا طرد الكرى عني حبيبا","https://www.aldiwan.net/poem49772.html","الوافر"],[416,"أعادك من ذكر الأحبة عائد","https://www.aldiwan.net/poem67515.html","الطويل"],[463,"تروح من وجرة الظاعنونا","https://www.aldiwan.net/poem55843.html","المتقارب"],[463,"نقيل مع الدنيا وقد أورقت لنا","https://www.aldiwan.net/poem55852.html","الطويل"],[463,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[471,"ألا طرقت ليلى فأحزن ذكرها","https://www.aldiwan.net/poem50373.html","الطويل"],[473,"ألا طوبى لمن أمسى وأضحى","https://www.aldiwan.net/poem60372.html","الوافر"],[475,"ألا طرقتنا بالموقر شعفر","https://www.aldiwan.net/poem4705.html","الطويل"],[543,"مثل التهامي ما في الأرض من بطل","https://www.aldiwan.net/poem47989.html","عموديه"],[556,"إلى كم أقود قوما","https://www.aldiwan.net/poem47833.html","المضارع"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2472","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66746","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96996","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63894","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63794","الطويل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96371","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62514","الوافر"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107208","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119995","الكامل"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111166","البسيط"],[1232,"","https://poetry.dctabudhabi.ae/diwan/poem/124060","الوافر"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136254","الطويل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56581","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49943","الطويل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44839","الطويل"],[1673,"","https://poetry.dctabudhabi.ae/diwan/poem/119047","الطويل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141304","البسيط"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26403","الوافر"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11125","الطويل"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45494","الطويل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10478","البسيط"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21465","الطويل"],[2397,"","https://poetry.dctabudhabi.ae/diwan/poem/96138","الطويل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99079","الوافر"],[2500,"","https://poetry.dctabudhabi.ae/diwan/poem/116828","الطويل"],[2517,"","https://poetry.dctabudhabi.ae/diwan/poem/99901","الطويل"],[2573,"","https://poetry.dctabudhabi.ae/diwan/poem/84977","الطويل"],[2721,"","https://poetry.dctabudhabi.ae/diwan/poem/20692","الطويل"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21594","الطويل"],[3018,"","https://poetry.dctabudhabi.ae/diwan/poem/60635","الطويل"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22537","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102382","الطويل"],[3544,"","https://poetry.dctabudhabi.ae/diwan/poem/116846","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91283","الوافر"],[3727,"","https://poetry.dctabudhabi.ae/diwan/poem/124072","البسيط"],[3869,"","https://poetry.dctabudhabi.ae/diwan/poem/34846","المجتث"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2534","الوافر"],[3975,"","https://poetry.dctabudhabi.ae/diwan/poem/75827","الوافر"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69256","الوافر"],[4172,"","https://poetry.dctabudhabi.ae/diwan/poem/147785","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204249","الطويل"],[4691,"أهيف مريضة نبأ صحيحُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=59635",""],[416,"أعَادَكَ مِنْ ذِكْر الأحبَّة ِ عَائِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=22338",""],[4797,"نعم للوصل","https://www.poetsgate.com/ViewPoem.aspx?id=50258",""],[4859,"محيط مرامي","https://www.poetsgate.com/ViewPoem.aspx?id=197032",""],[5136,"القلب يخشع والأماني تدمع","https://www.poetsgate.com/ViewPoem.aspx?id=121614",""],[5183,"سباق الأعنة","https://www.poetsgate.com/ViewPoem.aspx?id=180222",""],[5561,"مُسامِرُ الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=194728",""],[5948,"ألا طَرَقتْ أسماءُ أم أنتَ حالِمُ","https://www.poetsgate.com/ViewPoem.aspx?id=100613",""],[6056,"نور السوارة","https://www.poetsgate.com/ViewPoem.aspx?id=130342",""],[6124,"سقتني الوصل","https://www.poetsgate.com/ViewPoem.aspx?id=201224",""]],"verses":[["ألا طَرَقَت بَعدَ العِشاءِ جَنوبُ","وَذَلكَ مِنها إِن عَجِبتَ عَجِيبُ",0,"ب",1,1],["أَلا طَرَقَت مَيٌّ وَبَيني وَبَينَها","مَهاوٍ لأَصحابِ السُرى وَتَرامي",1,"م",2,0],["أَلا طالَ ما سُؤتَ الغَيورَ وَبَرَّحَت","بي الأَعيُنُ النُجلُ المِراضُ الصَحائِحُ",2,"ح",1,0],["أَلا طَرَقَت مَيُّ هَيوماً بِذِكرِها","وَأَيدي الثُرَيّا جُنَّحٌ في المَغارِبِ",3,"ب",1,0],["أَلا طَرَقَت شَعثاءُ وَاللَيلُ مُظلِمٌ","أَحَمَّ عُمانِيّاً وَأَشعَثَ ماضِيا",4,"ي",2,0],["أَلا طِعانٌ أَلا فُرسانُ عادِيَةٍ","إِلّا تُجَشُّؤُكُم حَولَ التَنانيرِ",5,"ر",1,0],["ألا طالما حرضتني غير مُؤتلٍ","على استِكَ تحريضَ امرئ بيَ مولع",6,"ع",1,0],["ألا طال ما حمَّلتُ قلبيَ ظالماً","تكاليفَ مِنْ إعظام من ليس مُعْظما",7,"م",2,0],["أَلا طَرَقَتنا لَيلَةً أُمُّ هَيثَمٍ","بِمَنزِلَةٍ تَعتادُ أَرحُلُنا فُضلا",8,"ل",2,1],["أَلا طَرَقَت أَروى الرِحالَ وَصُحبَتي","بِأَرضٍ تُناصي الحَزنَ مِنها سُهولُها",9,"ل",3,1],["أَلا طرقَت رَحلي وَقَد نامَ صُحبتي","بِإِيوان سيرينَ المُزَخرَفِ طَلَّتي",10,"ي",1,1],["ألا طز على العيهور طز","وإن أبدى مجاملة الرفاق",11,"ق",1,0],["أَلا طَرَقَت ظَمياءُ وَالرَكبُ هُجَّدُ","دُوَينَ الشَجِيِّ عَن يَمينِ الخَرانِقِ",12,"ق",1,1],["أَلا طالَما رَسَّفتُ في قَيدِ مالِكٍ","فَأَصبَحَ في رِجلَيهِ قَيدي مُحَوَّلا",13,"ل",2,1],["أَلا طالَ ما قَد بِتُّ يوضِعُ ناقَتي","أَبو الجِنِّ إِبليسٌ بِغَيرِ خِطامِ",14,"م",1,0],["أَلا طَرَقَ الناعي بِلَيلٍ فَراعَني","وَأَرَّقني لَمّا اِستَهَلَّ مُناديا",15,"ي",2,1],["أَلا طالَما خانَ الزَمانُ وَبَدَّلا","وَقَسَّرَ آمالَ الأَنامِ وَطَوَّلا",16,"ل",2,1],["ألا طالما قَدْ كنتُ مثلكَ ساعياً","لجاهٍ ومالٍ جاهداً أَتَطَلَّبُ",17,"ب",1,0],["ألا طالَ ما كانت أسرةُ ملكِها","مكللةً بالدرِّ قبلَ زَوالِها",18,"ل",3,0],["أَلا طَمَّ بَحرُ أَتِيٍّ طَما","وَأَجرى كَفَّي سَماءٍ تَجود",19,"د",1,1],["أَلا طالَما لاعَيتُ لَيلى وَقادَني","إِلى اللَهوِ قَلبٌ لِلحِسانِ تَبوعُ",20,"ع",1,1],["ألا طُوبى لعبّادِ بن بشرِ","وعَمّارٍ كفايةِ كلِّ أمرِ",21,"ر",1,0],["أَلا طَرَقَتنا بَعدَما هَجَدوا هِندُ","وَقَد سِرنَ خَمساً وَاِتلَأَبَّ بِنا نَجدُ",22,"د",1,1],["أَلا طَرَقَت هِندُ الهُنودِ وَصُحبَتي","بِحَورانَ حَورانِ الجُنودِ هُجودُ",23,"د",1,1],["ألا طرَقتْ تَسري بأنفاسِ رَوْضَةٍ","وأعْطافِ مَيّاسٍ من البانِ ذائل",24,"ل",1,0],["ألا طَرَقَتْنا والنّجُومُ رُكودُ","وفي الحَيّ أيْقاظٌ ونحنُ هُجُودُ",25,"د",1,1],["أَلا طَرَدَ الهَوىعَنّي رُقادي","فَحَسبي ما لَقيتُ مِنُ السُهادِ",26,"د",1,1],["أَلا طَرَقَت مَوهِناً مَهدَدُ","وَقَد غَوَّرَ الكَوكَبُ المُنجِدُ",27,"د",1,1],["أَلاَ طَرَقَتْنَا بِالْمَدِينَةِ بَعْدَمَا","طَلَى الَّليْلُ أَذْنَابَ النِّجَادِ فَأَظْلَمَا",28,"م",2,1],["ألا طَرَبٌ يَا قُوْمُ فِي جَأْرِ مُغْضَبٍ","لأُمَّتِهِ أَوْ عِرْضِهِ أَوْ وِدَادِهِ",29,"د",2,0],["ألا طَرَبٌ وَالجَيْشُ يَحْدُوهُ مِعْزَفٌ","شَدِيدُ الوَغَى يُورِي اللَّظَى فِي جَمَادِهِ",29,"د",2,0],["ألا طَرَبٌ وَالبَحْرُ فِي ثَوَرَانِهِ","يُصَوِّرُ إِيقَاعٌ جَلالَ امْتِدَادِهِ",29,"د",2,0],["ألا طَرَبٌ وَالنَّهْرُ تَهْوِي سُيُولُهُ","إِلَى قَاعِهِ مُصْطَكَّةً بِصِلادِهِ",29,"د",2,0],["ألا طَرَبٌ فِي مَا يُرَدِّدُ حَانِقٌ","مِنَ الأُسْدِ فِي أَطْوَادِهِ أَوْ مِهَادِهِ",29,"د",2,0],["ألا طَرَبٌ وَالقَفْرُ كَالقَبْرُ سَاكِنٌ","لِنَاءٍ شَجَتْهُ حَمْحَمَاتُ جَوَادِهِ",29,"د",2,0],["أَلا طَرَقَت أَسماءُ في غَيرِ مَطرَقِ","وَأَنّى إِذا حَلَّت بِنَجرانَ نَلتَقي",30,"ق",2,1],["أَلا طَرَقتكَ بِالبَلقاءِ سَلمى","هُدُواً وَالمَطِيُّ بِنا جُنوحُ",31,"ح",1,0],["أَلاَ طَرَقَت أُمَيمَةُ بَعدض هَدءٍ","أخا سَفرٍ شَباريقَ القَميصِ",32,"ص",1,1],["أَلا طَرَقَت لَيلى وَرِجلي رَهينَةٌ","بِأَشهَبَ مَشدودٍ عَلَيَّ مَسامِرُه",33,"ر",2,0],["أَلا طَرَقَت لَيلى وَساقي رَهينَةٌ","بِأَسمَرَ مَشدودٍ عَلَيَّ ثَقيلُ",34,"ل",1,1],["ألا طالما بكّرتِ للشّغلِ والتُّقى","صلاةٌ وتدبيرٌ كذلكَ داما",35,"م",2,0],["أَلا طَرَفَتنا أُمُّ سَلمٍ فَأَرَّقَت","فَيا حَبَّذا لَمّاتُها وَطُروقُها",36,"ق",3,0],["أَلا طَرَقَتنا بِالقَرينَينِ مَوهِناً","وَقَد حَلَّ في عَينَيَّ مِن سِنَتي غَمضي",37,"ض",2,1],["أَلا طالَ التَنَظُّرُ وَالثَواءُ","وَجاءَ الصَيفُ وَاِنكَشَفَ الغِطاءُ",38,"ا",2,1],["ألا طرقَتْنا والثُّريّا كقُرْطِها","وقد بَرَدَتْ في نَحْرِها دُرُّ سِمْطِها",39,"ط",3,1],["ألا طرَدَ الكَرى عنَّي حبيباً","خَباهُ الدَّهرُ لي فيما خبا لي",40,"ي",1,1],["أَلا طالَما أَنهَبتَ دَمعَكَ طائِعاً","وَجارَت عَلَيكَ الآنِساتُ النَواهِدُ",41,"د",1,0],["ألا طرَباً يا مغنِّي القِلاصِ","بهم وهيْ تصعُبُ حتى تلينا",42,"ن",2,0],["ألا طرَقتْ صَمَّاءُ لا تفهم الرُّقَى","ولا ترهبُ الحاوين مسرىً ومَكمَنا",43,"ن",2,0],["ألا طرقتْ لا يملأ الليلُ صدرَها","ولا تتحاشى صارخاً حين تَصْبحُ",44,"ح",1,0],["أَلا طَرَقَت لَيلى فَأَحزَنَ ذِكرُها","وَكَم قَد طَرانا طَيفُ لَيلى فَأَحزَنا",45,"ن",2,1],["أَلا طوبى لِمَن أَمسى وَأَضحى","خَفيفَ الظَهرِ مِن ثِقلِ الذُنوبِ",46,"ب",1,1],["أَلا طَرَقَتنا بِالمُوَقَّرِ شَعفَرُ","وَمِن دونِ مَسراها قُديدٌ وَعَزوَرُ",47,"ر",1,1],["الأطلسُ المُشمَخِرُّ قد حَنا قُنَناً","طالبت قُروناً ولمَّا جئتَ لَم تَطُلِ",48,"ل",1,0],["ألا طالما رأيتمْ","جثومِي على الوِسادِ",49,"د",1,0],["أَلا طَرَقَت مِن آلِ نَذرَةَ طارِقَه","عَلى أَنَّها مَعشوقَةُ الدَلِّ عاشِقَه",50,"ق",2,1],["ألا طرقتنا هندُ والرَّكبُ هُجَّعُ","وطافَ لها منّي خيالٌ مروِّعُ",51,"ع",1,1],["ألا طرق الأسماع ما قد أصمها","وكلم أحشاء تكابد كلمها",52,"م",3,1],["ألاَّ طربتَ إلى زيتونِ بطياس","فصالحيّةَ ذاتِ السروِ والآس",53,"س",1,1],["ألا طال ما سِرنا إلى وطنيكما","فسارتْ إلى أوطانِ ألبابنا الخمر",54,"ر",1,0],["ألا طالما احلولى نيامي وجرّني","الى الفضلات الأغيدُ المتناعِمُ",55,"م",1,0],["أُلاطِفُه فأوسعني دلالاً","وحيرني مشاهدةً ودَلاّ",56,"ل",2,0],["أَلا طالَما كَتَّمتُ في الصَّدرِ حُبَّكُم","فقَد ضاقَ عَنهُ اليَومَ وَهوَ رَحِيبُ",57,"ب",1,0],["إلا طربت كما يلو","ح وقلت مسعود القضاعي",58,"ع",2,0],["الأطهر المرسل الموطى","طه عماد العلى الموطد",59,"د",1,0],["ألا طرقتك زائرةً جبارى","فبات القلب يدكر ادكارا",60,"ر",2,1],["الاطفه بالقول مني فيانف","وابسط اخلاقي له فيعنف",61,"ف",1,1],["ألا طال الحنين إليك شوقاً","كفانا من فراقك ما كفاكا",62,"ك",2,0],["إلَا طالَما اجرَيتُ في طَلَقِ الصَّبا","مَطايا بطالاتٍ جِذاعاً وقُرّحا",63,"ح",2,0],["أَلا طَرَبٌ يُقلَى أَلا حُزن يُصطَفَى","أَلا أَدمُعٌ تُجرَى أَلا قَلبٌ يُضرَمُ",64,"م",1,0],["إلا طرقت ليلى على نأي دارها","وليلى على شحط المزار طروق",65,"ق",1,0],["إلا طرابلس المعتزّ جانبها","وذكرها في ربوع العرب وضّاء",66,"ا",2,0],["أَلا طَرَقَت تَلومُكَ أُمُّ عَمرٍو","وَما لِلغانِياتِ وَلِلمَلامِ",67,"م",1,0],["أَلا طَرَقَتنا أُمُّ أَوسٍ وَدونَها","حِراجٌ مِنَ الظُلَماءِ يَعشى غُرابُها",68,"ب",3,1],["أَلا طَرَقَت سُعدى فَكَيفَ تَأَفَّقَت","بِنا وَهيَ ميسانُ اللَيالي كَسولُها",69,"ه",2,1],["إلاَّ طَوائِفُ بِالحَدِيثِ تَمَسَّكَت","تُعزَى مَذاهِبُهَا إِلَى القُرآنِ",70,"ن",1,0],["أَلا طِعانَ وَلا فُرسانِ عادِيَةً","إِلّا تَجَشُّؤُكُم عِندَ التَنانيرِ",71,"ر",1,0],["أَلا طَرَقَت صَحبي عَميرةُ إِنَّها","لَنا بِالمروراةِ المُطِلِّ طَروق",72,"ق",1,0],["ألا طرقتنا آخر الليل زينب","عليك سلام هل لما فات مطلب",73,"ب",1,1],["ألا طربت إلى النشوات نفسي","وتقت إلى معتقة الدنان",74,"ن",1,0],["ألا طرقَتنا والرفاقُ هجودُ","فباتَت بعِلّاتِ النوالِ تجودُ",75,"د",1,1],["ألا طرَقَت ليلى لقى بينَ أرحُلٍ","شجاهُ الهوى والنأيُ فهوَ عميدُ",75,"د",1,0],["ألاَ طالما هيجتما برح الهوى","بقلبٍ سقيم لم يُطق للهَوى شَغْبَا",76,"ب",2,0],["ألا طرقت رحلي وقد نام صحبتي","بإيوان سيرين المزخرف خلتي",77,"ت",2,1],["أَلا طَرَقَت أَسماءُ وَهِيَ طَروقُ","وَبانَت عَلى أَنَّ الخَيالَ يَشوقُ",78,"ق",1,1],["أَلا طَرَقَتنا آَخِرَ اللَيلِ زَينَبُ","سَلامٌ عَلَيكُم هَل لِما فاتَ مَطلَبُ",79,"ب",1,1],["أَلا طيِّبوا باللهِ بالقُربِ بالَنا","على عَجَلٍ يا طيَّبَ اللهُ بالَكُمْ",80,"م",1,0],["أَلا طَرَقَت دِهقانَةُ الرَكبَ بَعدَما","تَقَوَّضَ نِصفُ اللَيلِ وَاِعتَرَضَ النَسرُ",81,"ر",1,0],["ألا طرقَتْنا أمُّ عثمانَ ليلةً","مِدرى وقدْ كادَ السِّماكُ يَغورُ",82,"ر",1,0],["ألا طالما رَجَّيتُكثم وامتدحتُكم","فهذا أوان الشَّتمِ أشأمَ طائره",83,"ر",2,0],["أَلا طالَ التباعدُ فاستطالا","وَغَيَّرنا النَوى حالاً وَقالا",84,"ل",2,1],["الا طربت وما شوقي إلى طلل","عاف تغير غير النؤى والوتد",85,"د",1,0],["إِلّا طَعاماً يَسيراً","خَلَّفتُهُ في الكَنيفِ",86,"ف",1,0],["أَلا طَرَقَتكَ مِن خَبتٍ كَنودُ","فَقَد فَعلَت وَآلَت لا تَعودُ",87,"د",1,1],["أَلا طَرَقَتْ خَيَاَلَةُ أُمِّ كِّرْزٍ","وأَصْحَابِي بِعْيْهَمَ مِنْ تَباَلهْ",88,"ه",1,1],["أَلا طَرَقَت رُويمَةُ بَعدَ هَدءٍ","تَخَطّى هَولَ أَنمارٍ وَأُسدِ",89,"د",1,1],["ألا طرقت عصماء وهنا وللصدى","غناءٌ لهت عنسي ......",90,"ي",1,0],["ألاطف مولانا وكالماء طبعه","تسلسل من عذب النطاق برود",91,"د",1,0],["ألا طر ْ يا قصيدُ إلى هويفي","وكن عوّادها تُشفَ الجروحُ",92,"ح",1,0],["ألاَ طالما أنهبتَ دمعكَ طائعاً","وجارتْ عليكَ اللآنساتُ النواهدُ",93,"د",1,0],["إلا طَلَبتك وصل .. صعّبت الأوضاع","مدري .. من اللي درّسك جعله يموت",94,"ت",1,0],["إلاّ طيوفاً للسعادة بثها","حلو التخيلِ في جميل منامي",95,"م",2,0],["الأطول المتطول الفراج مل","تجم الهياح الأروع المنزوع",96,"ع",1,0],["ألاطفه حتى إذا ما علوته","علوت حديداً لا يهون لكاسل",97,"ل",1,0],["ألاطفُ الصبرَ, علَّ الصبرَ يأخذُني","إليكَ مِنْ ظلمةِ الدَّربِ الذي احترقا",98,"ق",2,0],["ألا طَرَقتْ أسماءُ أم أنتَ حالِمُ","فأهلاً بطيفٍ زارَ والليلُ عَاتمُ",99,"م",1,1],["إلا طرت لي هاج فكري ووشّا","وقامت عفاريتٍ بوجهي تنطّط",100,"ط",1,0],["أَلا طَابَ الَّذِيْ سَرَّا","وَأَهْدَى البَرْدَ والجَمْرَا",101,"ر",2,1]]}