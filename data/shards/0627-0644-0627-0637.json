{"poems":[[35,"ألا طرقت بعد العشاء جنوب","https://www.aldiwan.net/poem39618.html","الطويل"],[30,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[30,"أمن دمنة جرت بها ذيلها الصبا","https://www.aldiwan.net/poem29607.html","الطويل"],[30,"خليلي عوجا بارك الله","https://www.aldiwan.net/poem29611.html","الطويل"],[27,"ألا حي رهبى ثم حي المطاليا","https://www.aldiwan.net/poem4427.html","الطويل"],[23,"حار بن كعب ألا الأحلام تزجركم","https://www.aldiwan.net/poem21367.html","البسيط"],[51,"أأحمد لا والله لا ذقت فيشتي","https://www.aldiwan.net/poem65382.html","الطويل"],[51,"عرفت مقادير الرجال بنكبة","https://www.aldiwan.net/poem66020.html","الطويل"],[29,"ألا طرقتنا ليلة أم هيثم","https://www.aldiwan.net/poem6110.html","الطويل"],[29,"ألا طرقت أروى الرحال وصحبتي","https://www.aldiwan.net/poem6158.html","الطويل"],[12,"ألا طرقت رحلي وقد نام صحبتي","https://www.aldiwan.net/poem1206.html",""],[85,"يمينا بالطلاق وبالعتاق","https://www.aldiwan.net/poem6824.html","الوافر"],[28,"ألا طرقت ظمياء والركب هجد","https://www.aldiwan.net/poem5350.html","الطويل"],[28,"ألا طالما رسفت في قيد مالك","https://www.aldiwan.net/poem5470.html","الطويل"],[28,"ولما دنا رأس التي كنت خائفا","https://www.aldiwan.net/poem5525.html","الطويل"],[58,"ألا طرق الناعي بليل فراعني","https://www.aldiwan.net/poem30795.html","الطويل"],[49,"ألا طالما خان الزمان وبدلا","https://www.aldiwan.net/poem63069.html","الطويل"],[69,"أتهزأ بي لما أجد وتلعب","https://www.aldiwan.net/poem28601.html","الطويل"],[69,"فقلت وقد أنكرت منه مقالة","https://www.aldiwan.net/poem29297.html","الطويل"],[74,"ألا طم بحر أتي طما","https://www.aldiwan.net/poem12904.html","المتقارب"],[33,"ألا طالما لاعيت ليلى وقادني","https://www.aldiwan.net/poem25878.html","الطويل"],[105,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[22,"ألا طرقتنا بعدما هجدوا هند","https://www.aldiwan.net/poem21643.html","الطويل"],[22,"ألا طرقت هند الهنود وصحبتي","https://www.aldiwan.net/poem22008.html","الطويل"],[75,"هنالك عهدي بالخليط المزايل","https://www.aldiwan.net/poem69044.html","الطويل"],[75,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[50,"ألا طرد الهوىعني رقادي","https://www.aldiwan.net/poem63855.html","الوافر"],[50,"ألا طرقت موهنا مهدد","https://www.aldiwan.net/poem63884.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55506","الطويل"],[125,"ألا طرقت أسماء في غير مطرق","https://www.aldiwan.net/poem24276.html","الطويل"],[135,"تذكر شجوه القلب القريح","https://www.aldiwan.net/poem68022.html","الوافر"],[179,"ألا طرقت أميمة بعدض هدء","https://www.aldiwan.net/poem58888.html","الوافر"],[232,"ألا أيها البيت الذي أنا هاجره","https://www.aldiwan.net/poem4604.html","الطويل"],[232,"ألا طرقت ليلى وساقي رهينة","https://www.aldiwan.net/poem4606.html","الطويل"],[268,"أفيقي فردي بسمة وسلاما","https://www.aldiwan.net/poem35622.html","الطويل"],[290,"ألا من لنفس لا تؤدي حقوقها","https://www.aldiwan.net/poem441.html",""],[320,"ألا طرقتنا بالقرينين موهنا","https://www.aldiwan.net/poem56343.html","الطويل"],[320,"ألا طال التنظر والثواء","https://www.aldiwan.net/poem56353.html","الوافر"],[362,"ألا طرقتنا والثريا كقرطها","https://www.aldiwan.net/poem60853.html","الطويل"],[402,"ألا طرد الكرى عني حبيبا","https://www.aldiwan.net/poem49772.html","الوافر"],[407,"أعادك من ذكر الأحبة عائد","https://www.aldiwan.net/poem67515.html","الطويل"],[456,"تروح من وجرة الظاعنونا","https://www.aldiwan.net/poem55843.html","المتقارب"],[456,"نقيل مع الدنيا وقد أورقت لنا","https://www.aldiwan.net/poem55852.html","الطويل"],[456,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[464,"ألا طرقت ليلى فأحزن ذكرها","https://www.aldiwan.net/poem50373.html","الطويل"],[466,"ألا طوبى لمن أمسى وأضحى","https://www.aldiwan.net/poem60372.html","الوافر"],[468,"ألا طرقتنا بالموقر شعفر","https://www.aldiwan.net/poem4705.html","الطويل"],[536,"مثل التهامي ما في الأرض من بطل","https://www.aldiwan.net/poem47989.html","عموديه"],[549,"إلى كم أقود قوما","https://www.aldiwan.net/poem47833.html","المضارع"]],"verses":[["ألا طَرَقَت بَعدَ العِشاءِ جَنوبُ","وَذَلكَ مِنها إِن عَجِبتَ عَجِيبُ",0,"ب",1,1],["أَلا طَرَقَت مَيٌّ وَبَيني وَبَينَها","مَهاوٍ لأَصحابِ السُرى وَتَرامي",1,"م",2,0],["أَلا طالَ ما سُؤتَ الغَيورَ وَبَرَّحَت","بي الأَعيُنُ النُجلُ المِراضُ الصَحائِحُ",2,"ح",1,0],["أَلا طَرَقَت مَيُّ هَيوماً بِذِكرِها","وَأَيدي الثُرَيّا جُنَّحٌ في المَغارِبِ",3,"ب",1,0],["أَلا طَرَقَت شَعثاءُ وَاللَيلُ مُظلِمٌ","أَحَمَّ عُمانِيّاً وَأَشعَثَ ماضِيا",4,"ي",2,0],["أَلا طِعانٌ أَلا فُرسانُ عادِيَةٍ","إِلّا تُجَشُّؤُكُم حَولَ التَنانيرِ",5,"ر",1,0],["ألا طالما حرضتني غير مُؤتلٍ","على استِكَ تحريضَ امرئ بيَ مولع",6,"ع",1,0],["ألا طال ما حمَّلتُ قلبيَ ظالماً","تكاليفَ مِنْ إعظام من ليس مُعْظما",7,"م",2,0],["أَلا طَرَقَتنا لَيلَةً أُمُّ هَيثَمٍ","بِمَنزِلَةٍ تَعتادُ أَرحُلُنا فُضلا",8,"ل",2,1],["أَلا طَرَقَت أَروى الرِحالَ وَصُحبَتي","بِأَرضٍ تُناصي الحَزنَ مِنها سُهولُها",9,"ل",3,1],["أَلا طرقَت رَحلي وَقَد نامَ صُحبتي","بِإِيوان سيرينَ المُزَخرَفِ طَلَّتي",10,"ي",1,1],["ألا طز على العيهور طز","وإن أبدى مجاملة الرفاق",11,"ق",1,0],["أَلا طَرَقَت ظَمياءُ وَالرَكبُ هُجَّدُ","دُوَينَ الشَجِيِّ عَن يَمينِ الخَرانِقِ",12,"ق",1,1],["أَلا طالَما رَسَّفتُ في قَيدِ مالِكٍ","فَأَصبَحَ في رِجلَيهِ قَيدي مُحَوَّلا",13,"ل",2,1],["أَلا طالَ ما قَد بِتُّ يوضِعُ ناقَتي","أَبو الجِنِّ إِبليسٌ بِغَيرِ خِطامِ",14,"م",1,0],["أَلا طَرَقَ الناعي بِلَيلٍ فَراعَني","وَأَرَّقني لَمّا اِستَهَلَّ مُناديا",15,"ي",2,1],["أَلا طالَما خانَ الزَمانُ وَبَدَّلا","وَقَسَّرَ آمالَ الأَنامِ وَطَوَّلا",16,"ل",2,1],["ألا طالما قَدْ كنتُ مثلكَ ساعياً","لجاهٍ ومالٍ جاهداً أَتَطَلَّبُ",17,"ب",1,0],["ألا طالَ ما كانت أسرةُ ملكِها","مكللةً بالدرِّ قبلَ زَوالِها",18,"ل",3,0],["أَلا طَمَّ بَحرُ أَتِيٍّ طَما","وَأَجرى كَفَّي سَماءٍ تَجود",19,"د",1,1],["أَلا طالَما لاعَيتُ لَيلى وَقادَني","إِلى اللَهوِ قَلبٌ لِلحِسانِ تَبوعُ",20,"ع",1,1],["ألا طُوبى لعبّادِ بن بشرِ","وعَمّارٍ كفايةِ كلِّ أمرِ",21,"ر",1,0],["أَلا طَرَقَتنا بَعدَما هَجَدوا هِندُ","وَقَد سِرنَ خَمساً وَاِتلَأَبَّ بِنا نَجدُ",22,"د",1,1],["أَلا طَرَقَت هِندُ الهُنودِ وَصُحبَتي","بِحَورانَ حَورانِ الجُنودِ هُجودُ",23,"د",1,1],["ألا طرَقتْ تَسري بأنفاسِ رَوْضَةٍ","وأعْطافِ مَيّاسٍ من البانِ ذائل",24,"ل",1,0],["ألا طَرَقَتْنا والنّجُومُ رُكودُ","وفي الحَيّ أيْقاظٌ ونحنُ هُجُودُ",25,"د",1,1],["أَلا طَرَدَ الهَوىعَنّي رُقادي","فَحَسبي ما لَقيتُ مِنُ السُهادِ",26,"د",1,1],["أَلا طَرَقَت مَوهِناً مَهدَدُ","وَقَد غَوَّرَ الكَوكَبُ المُنجِدُ",27,"د",1,1],["ألا طَرَبٌ يَا قُوْمُ فِي جَأْرِ مُغْضَبٍ","لأُمَّتِهِ أَوْ عِرْضِهِ أَوْ وِدَادِهِ",28,"د",2,0],["ألا طَرَبٌ وَالجَيْشُ يَحْدُوهُ مِعْزَفٌ","شَدِيدُ الوَغَى يُورِي اللَّظَى فِي جَمَادِهِ",28,"د",2,0],["ألا طَرَبٌ وَالبَحْرُ فِي ثَوَرَانِهِ","يُصَوِّرُ إِيقَاعٌ جَلالَ امْتِدَادِهِ",28,"د",2,0],["ألا طَرَبٌ وَالنَّهْرُ تَهْوِي سُيُولُهُ","إِلَى قَاعِهِ مُصْطَكَّةً بِصِلادِهِ",28,"د",2,0],["ألا طَرَبٌ فِي مَا يُرَدِّدُ حَانِقٌ","مِنَ الأُسْدِ فِي أَطْوَادِهِ أَوْ مِهَادِهِ",28,"د",2,0],["ألا طَرَبٌ وَالقَفْرُ كَالقَبْرُ سَاكِنٌ","لِنَاءٍ شَجَتْهُ حَمْحَمَاتُ جَوَادِهِ",28,"د",2,0],["أَلا طَرَقَت أَسماءُ في غَيرِ مَطرَقِ","وَأَنّى إِذا حَلَّت بِنَجرانَ نَلتَقي",29,"ق",2,1],["أَلا طَرَقتكَ بِالبَلقاءِ سَلمى","هُدُواً وَالمَطِيُّ بِنا جُنوحُ",30,"ح",1,0],["أَلاَ طَرَقَت أُمَيمَةُ بَعدض هَدءٍ","أخا سَفرٍ شَباريقَ القَميصِ",31,"ص",1,1],["أَلا طَرَقَت لَيلى وَرِجلي رَهينَةٌ","بِأَشهَبَ مَشدودٍ عَلَيَّ مَسامِرُه",32,"ر",2,0],["أَلا طَرَقَت لَيلى وَساقي رَهينَةٌ","بِأَسمَرَ مَشدودٍ عَلَيَّ ثَقيلُ",33,"ل",1,1],["ألا طالما بكّرتِ للشّغلِ والتُّقى","صلاةٌ وتدبيرٌ كذلكَ داما",34,"م",2,0],["أَلا طَرَفَتنا أُمُّ سَلمٍ فَأَرَّقَت","فَيا حَبَّذا لَمّاتُها وَطُروقُها",35,"ق",3,0],["أَلا طَرَقَتنا بِالقَرينَينِ مَوهِناً","وَقَد حَلَّ في عَينَيَّ مِن سِنَتي غَمضي",36,"ي",1,1],["أَلا طالَ التَنَظُّرُ وَالثَواءُ","وَجاءَ الصَيفُ وَاِنكَشَفَ الغِطاءُ",37,"ا",2,1],["ألا طرقَتْنا والثُّريّا كقُرْطِها","وقد بَرَدَتْ في نَحْرِها دُرُّ سِمْطِها",38,"ط",3,1],["ألا طرَدَ الكَرى عنَّي حبيباً","خَباهُ الدَّهرُ لي فيما خبا لي",39,"ي",1,1],["أَلا طالَما أَنهَبتَ دَمعَكَ طائِعاً","وَجارَت عَلَيكَ الآنِساتُ النَواهِدُ",40,"د",1,0],["ألا طرَباً يا مغنِّي القِلاصِ","بهم وهيْ تصعُبُ حتى تلينا",41,"ن",2,0],["ألا طرَقتْ صَمَّاءُ لا تفهم الرُّقَى","ولا ترهبُ الحاوين مسرىً ومَكمَنا",42,"ن",2,0],["ألا طرقتْ لا يملأ الليلُ صدرَها","ولا تتحاشى صارخاً حين تَصْبحُ",43,"ح",1,0],["أَلا طَرَقَت لَيلى فَأَحزَنَ ذِكرُها","وَكَم قَد طَرانا طَيفُ لَيلى فَأَحزَنا",44,"ن",2,1],["أَلا طوبى لِمَن أَمسى وَأَضحى","خَفيفَ الظَهرِ مِن ثِقلِ الذُنوبِ",45,"ب",1,1],["أَلا طَرَقَتنا بِالمُوَقَّرِ شَعفَرُ","وَمِن دونِ مَسراها قُديدٌ وَعَزوَرُ",46,"ر",1,1],["الأطلسُ المُشمَخِرُّ قد حَنا قُنَناً","طالبت قُروناً ولمَّا جئتَ لَم تَطُلِ",47,"ل",1,0],["ألا طالما رأيتمْ","جثومِي على الوِسادِ",48,"د",1,0]]}