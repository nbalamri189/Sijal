s://www.poetsgate.com/ViewPoem.aspx?id=213542",""],[5997,"ليل جموح","https://www.poetsgate.com/ViewPoem.aspx?id=214234",""],[6052,"الشذا","https://www.poetsgate.com/ViewPoem.aspx?id=52572",""],[6066,"مَأْسَاتِيْ فِيْ جُوَانْتَانَامُو","https://www.poetsgate.com/ViewPoem.aspx?id=12669",""],[6068,"فذا فرض وذا قصدًهْ -03-","https://www.poetsgate.com/ViewPoem.aspx?id=175911",""],[6068,"هل تارك روحي لنصح العاذل","https://www.poetsgate.com/ViewPoem.aspx?id=181693",""],[6070,"حياةُ المرءِ تحكمُها الثواني","https://www.poetsgate.com/ViewPoem.aspx?id=188425",""],[6102,"جيهان ..","https://www.poetsgate.com/ViewPoem.aspx?id=183612",""],[6102,"هيت لك","https://www.poetsgate.com/ViewPoem.aspx?id=185305",""],[6152,"عشر ذو الحجة","https://www.poetsgate.com/ViewPoem.aspx?id=203345",""],[242,"يا لجة علما وديمة نائل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563734",""],[6164,"بطرت .. فزلت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66039&r=&rc=49",""],[6199,"نزيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79700&r=&rc=21",""],[6225,"إزالة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78009&r=&rc=95",""],[6225,"ملجأ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81041&r=&rc=278",""],[454,"يئس الصغار من الكبار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82661&r=&rc=25",""],[6344,"حجاب المرايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87979&r=&rc=19",""],[6345,"صب وفاتنة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78654&r=&rc=25",""],[6345,"جور الزمان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78653&r=&rc=24",""],[6364,"قبر في المرج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82466&r=&rc=5",""]],"verses":[["فَتَسَلَّ فيهِ وَرُدَّ عا","رِيَةَ الغَرامِ إِلى المُعيرِ",0,"ر",1,0],["فتستفرغ الحيَّ الفتى من أديمه","وتكسو عجوزين الأديمَ المفرّغا",1,"غ",2,0],["فَتَستَيقِنا أَنّا أَخوكُم وَأَنَّنا","إِذا نُتِجَت شَهباءُ يَخشَونَ فالَها",2,"ل",3,0],["فَتُسَرّي بِالذِكرِ عَنها وَتَنفي","ما عَراها مِن غُضَّةٍ وَاِكتِئابِ",3,"ب",1,0],["فَتَسابَقوا الخَيراتِ فَهيَ أَمامَكُم","مَيدانُ سَبقٍ لِلجَوادِ النالِ",4,"ل",1,0],["فَتَسْمَعُ قَعْقَعَاتٍ مِنْ عِظَامٍ","تَرَضَّضُ فِيكَ مِنْ شَدٍّ وَلِينِ",5,"ن",1,0],["فتسيرُ أَصداءُ النِّيَاحَةِ","نحو أَطباقِ الضَّبابْ",6,"ب",1,0],["فَتَسيرُ في التَّيَّارِ راقصةً","على نَغَمِ الخريرْ",7,"ر",1,0],["فتسمع في مآتمهم غناء","وتسمع في ولائمهم نواحا",8,"ح",2,0],["فَتُسفِرُ عَنهُ وَالسُيوفُ كَأَنَّما","مَضارِبُها مِمّا اِنفَلَلنَ ضَرائِبُ",9,"ب",1,0],["فَتَسَمَّح بِها فَمِقدارُها يَص","غُرُ في قَدرِ طولِكَ المَشكورِ",10,"ر",1,0],["فَتَسأَلَهُ عَنّي فَيَعيا بِنِسبَتي","وَلا اِسمي وَمَن يَعيا سِماكَ الأَعازِلِ",11,"ل",1,0],["فتُسعِدُ في خَفْضٍ منَ العيشِ سعدَها","ويعتادُ في يُمْنٍ من الدَّهرِ عيدُها",12,"د",3,0],["فتُسفِرُ عن مثلِ وَردِ الربيعِ","وتَبسِمُ عن مثل نَوْرِ الأَقاحي",13,"ح",2,0],["فَتَستَحِقَّ مِنَ الدُنيا سَلامَتَها","وَتَستَقِلَّ بِعِرضٍ وافِرٍ وافِ",14,"ف",1,0],["فَتَساقَوا كَأساً أُمِرَّت عَلَيهِم","بَينَهُم يَقتُلُ العَزيزُ الذَليلا",15,"ل",2,0],["فتستهدِفُ الأغراضَ آراؤهُ كما","تُقَرْطِسُ أغراضاً صوائبُ أسهمِ",16,"م",1,0],["فَتَسَامَحِي لِي مَرَّةً","حَتَّى أَفُوزَ بِلَثْمِ كُمِّكْ",17,"ك",1,0],["فَتَستَنُّ مِن سُبلِ المَفاخِرِ ما عَفا","وَتُدرِكُ ديناً ضاقَ مِنهُ المُخَنَّقُ",18,"ق",1,0],["فَتَسَمو ما يُعنيها ضَراءٌ","وَلا تَخبو فَيَبرَدُها السَمومُ",19,"م",1,0],["فَتُسرِعُ أَحياناً إِذا هِيَ لَم تَخَف","وَتَخشى عُيُوناً حَولَها فَتَمَيَّلُ",20,"ل",1,0],["فَتَسَلَّيتُ بِالمَعازِفِ عَنها","وَتَعَزّى قَلبي وَما مِن عَزاءِ",21,"ا",2,0],["فَتَسَلّبْنَ وَاسْتَعِرْنَ جَميعاً","منْ قَميصِ الدّجَى ثيابَ حِدادِ",22,"د",1,0],["فتسخط إذ لا شيء يوجب سخطها","وَتشتمها في وجهها وَتحقِّر",23,"ر",1,0],["فَتَساءَلنا للسَلامة عنه","وأَجابَ الخَبير منا يَقول",24,"ل",1,0],["فتسمّعوا أصداءها في موكب","للموت مُحتشدِ الفواجع زاخرِ",25,"ر",1,0],["فتسمعوه فلم يزل من شعره","شاد يهزّ بسحره الأرواحا",26,"ح",2,0],["فَتُسَاقُ البُحُوثُ فِيهِ ضَرُوياً","وَيُدَارُ الحَدِيثُ فِيهِ شَجُونَا",27,"ن",2,0],["فتسوغ في أذنيْ جميل رنتي","وتطيب نفس كثيّر ببياني",28,"ن",2,0],["فتساوينا جهاداً","وتآخينا سلاحا",29,"ح",2,0],["فتسامت إلى السماء كأن الْ","أَرض ضاقت عن جسمها النوراني",30,"ن",2,0],["فتسمح باليمنى دموع جفونها","وتجعل يسرى فوق قلب مروع",31,"ع",1,0],["فتساقطت شرفاتك النعسا","كأعشاش الطيور",32,"ر",1,0],["فتساندوا بعد اختلاف مطامع","أن لا يقيمَ الشرقَ أيَّ سناد",33,"د",1,0],["فتستيقني أن لم يكن من خلائقي","وذلك أمر يا بثين عظيم",34,"م",1,0],["فتسابقوا عن جهلهم","وعقوقهم يستغفرون",35,"ن",1,0],["فتستَّرت لمّا رأتني حائراً","في وصفِها أو رسمِها أو ضَمِّها",36,"م",3,0],["فتسليت نادما عن هواها","بعد أن كنتُ للرباب نديما",37,"م",2,0],["فَتَسقِيهَا القَرِيحَةُ لِى بَدِيعاً","وتَسقِيهَا المَعَاني والبَيَانَا",38,"ن",2,0],["فَتَسخنُ عَينُهُ عِندَ التَنائي","وَتَسخنُ عَينُهُ عِندَ التَلاقي",39,"ق",2,0],["فَتَساوَتا بعدَ السرى بسعادته","سُبحانَ مَن أَسرى بهِ تَعظيما",40,"م",2,0],["فَتَسمَّعوا لَمقالَتي وَتَأَهّبوا","بِذَميمِ بَغيِكُمُ لِسوءِ المَصرَعِ",41,"ع",1,0],["فتسعة أعشار الملاحة قُسِّمَت","عليك وفي كلِّ الخلائق عُشرُها",42,"ر",3,0],["فتستجيب بروح باسم مرحٍ","كأنه الزهر في أيام نيسان",43,"ن",1,0],["فتسير فوق الأرض ث","م تظن أنك في السماء",44,"ا",2,0],["فَتسكرُ الآلامُ في مُهجَتي","وَصَوتُ أُختي خَمرَةٌ تُسكِرُ",45,"ر",1,0],["فَتَسَلَّت خزائِنُ المالِ مَظلو","مٌ تَوَلّى وجاءَها مَظلومُ",46,"م",1,0],["فَتَسَاوَتَا فِي قِسْمِهَا إِذْ لَمْ تَجِدْ","كُلٌّ جَمِيعَ حُظُوظِهِ أَوْ جُلَّهَا",47,"ل",3,0],["فتستروا زمنا وقد أخفاهم","في داره وقت الصلاة الأرقم",48,"م",1,0],["فتسلخت مع ما يلي","ها في الجفون من البثور",49,"ر",1,0],["فتسقطُ أفلاذٌ وتنضُبُ أدمعٌ","وكلُّ الورى ما بين ناهٍ وناهب",50,"ب",1,0],["فتساقطَ العشَّاقُ صَرعى في الوَغى","أو ما اشتَفَيتِ وقد قتَلتِ ألوفا",51,"ف",2,0],["فتستيقظُ الأحياءُ بعدَ رقادِها","وما كان يُطوى من محاسِنها يُنشَر",52,"ر",1,0],["فتَسوّغْها عَلى حُكمِ المُنى","آثِراً مِنْ حَقها أن تُؤْثِرا",53,"ر",2,0],["فتسابق الاخوان ك","ل راكب متن السرير",54,"ر",1,0],["فَتَسَلَّ حاجَتَها إِذا هِيَ أَعرَضَت","بِخَميصَةٍ سُرُحِ اليَدَينِ وِساعِ",55,"ع",1,0],["فتسرع في رياض من جنان","وتأوي للقناديل المضيه",56,"ي",2,0],["فتسأل اللَه توفيقاً لطاعته","وشكره فهو أهل الفضل والكرم",57,"م",1,0],["فَتُسقى منهُ كأس بعد كأسٍ","وَتضربُ لِلمعاد وللمعيدِ",58,"د",1,0],["فتساءلت كيف أنماز منهم","ورائي خيارهم وأمامي",59,"م",2,0],["فتَسمَعُ شُكْري ثَمّ عندَ مُلوكِها","وما شُكْرُ دانٍ مُشْبِهاً شُكْرُ نازح",60,"ح",1,0],["فَتَسَمَّعوها بِالقُلوبِ فَإِنَّها","تَبكي وَما كُلُّ البُكاءِ بِدَمعَةِ",61,"ه",1,0],["فَتَسَل عَن إِحسان دَهر","لا يَميل إِلى الكِرام",62,"م",1,0],["فَتسُحُّ الماءَ ما سكنَت","فَإِذا هاجَت له اضطَرَبا",63,"ب",2,0],["فتسل عنه وخذ حبيباً غيره","فأجبتهم لازلت عبد وصاله",64,"ل",2,0],["فتسعوا لجارٍ حَلّ وَسط بيوتكم","غريب وجارات تُركنَ جياعِ",65,"ع",1,0],["فتسربلت غفلة واختيالاً","واجتماعاً للهو في أخدانك",66,"ك",1,0],["فَتَسَلَّ عن أهل البسي","طة مادح منهم وهاج",67,"ج",1,0],["فتستلب الأرواحَ قدرةُ قادرٍ","ومن بعده الأشباحُ تودعها التربا",68,"ب",2,0],["فتسفّ بي كالطَير حَنَّ لِوَكرِهِ","وَتَزيف في رقل لَها وبُغامِ",69,"م",1,0],["فتسجد في محراب جامعه شكرا","فأثنى عليه من علا مثل من دنا",70,"ن",2,0],["فتسخر من وبل السحاب أكُفُّه","بأبرعَ من وبل السحاب المسخّر",71,"ر",1,0],["فَتَسْليمُ أَمْري بهِ لِلْقَضا","ذَخَرْتَ بِهِ أَجْرَ ما أَجْرَما",72,"م",2,0],["فتسلحوا بشواظها وتعقبو","جند الدخيل الغاصب الغدار",73,"ر",1,0],["فَتسمَّعيِ صيحاتِ كُلِّ مُكَّرمٍ","لا زَجرَ ساداتٍ وَخوفَ عبيدِ",74,"د",1,0],["فتسابقوا نحو السموِّ وسدّدوا","هِممَ الهدَاةِ القاهرينَ سُدودا",75,"د",2,0],["فتسمَّعْ فِقَراً أقراطَ أُذْنٍ","هي في أعدائها وَقرةُ أُذْنِ",76,"ن",1,0],["فتساقيتم الفراقَ بكأسٍ","هي فيكم على السماء تدورُ",77,"ر",1,0],["فتساندوا أسفاً إلى صَدَفٍ","هاوٍ على ممطولةِ القعرِ",78,"ر",1,0],["فتساوتِ الأقطارُ من أمْواهِهِ","فالقارةُ العلْياءُ مثلُ المَدفعِ",79,"ع",1,0],["فَتُسْئدُ كالنَقانِقِ في مَوامٍ","ترى فيها ضليعَ النُّجبِ ظالعْ",80,"ع",1,0],["فتسجعُ شوقاً إلى قربهِ","اِذا الليلُ أرخى عليها السُّدولا",81,"ل",2,0],["فتَسَكَّنَ الجَأشُ الطَّموحُ عُبابُهُ","بِطلاقَةٍ مِن وَجههِ البَسَّامِ",82,"م",1,0],["فتَسامت على نَواصي ذُراهُ","واستوَت فوقَه استِواءَ الرَّشَادِ",83,"د",1,0],["فتسمى بقادر ومريد","ع