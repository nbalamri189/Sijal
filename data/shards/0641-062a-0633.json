1,"جردت من تلك الجفون سيوفا","https://www.aldiwan.net/poem35430.html","الكامل"],[271,"تذكرت ما أبلى الزمان وما غير","https://www.aldiwan.net/poem35628.html","الطويل"],[276,"عبر البحر يؤم الأبحرا","https://www.aldiwan.net/poem25568.html","الرمل"],[286,"طربت بنا ريح النسيم","https://www.aldiwan.net/poem39376.html","مجزوء الكامل"],[288,"أرحلت من سلمى بغير متاع","https://www.aldiwan.net/poem1916.html","الكامل"],[305,"لجيران لنا بالأبطيحه","https://www.aldiwan.net/poem16836.html","الوافر"],[305,"لله أحبابنا بالأبرق العلم","https://www.aldiwan.net/poem16893.html","البسيط"],[306,"إلهي إن قصدي من قصيدي","https://www.aldiwan.net/poem56561.html","الوافر"],[329,"خلت نفسي يوما إلها عظيما","https://www.aldiwan.net/poem54977.html","الخفيف"],[365,"ألا من عذيري من جوى في الجوانح","https://www.aldiwan.net/poem60966.html","الطويل"],[367,"شوقا إلى ذاك الجلال ومجتنى","https://www.aldiwan.net/poem17166.html","الكامل"],[381,"من للمحب المستهام","https://www.aldiwan.net/poem48802.html","مجزوء الكامل"],[382,"هاج رسم دارس طرباً","https://www.aldiwan.net/poem400.html",""],[396,"قالوا نراه يسل شعر عذاره","https://www.aldiwan.net/poem3673.html","الكامل"],[397,"يآل عُبادٍ دعوة بعد هجمةٍ","https://www.aldiwan.net/poem594.html",""],[404,"قد عجزنا عن شكرنا لامتنانك","https://www.aldiwan.net/poem33402.html","الخفيف"],[404,"وافت على وفق احتياجي","https://www.aldiwan.net/poem34096.html","مجزوء الكامل"],[404,"خليلي هبا فالنسيم بكم هبا","https://www.aldiwan.net/poem34164.html","الطويل"],[407,"طيف ألم فزاد في آلامي","https://www.aldiwan.net/poem50127.html","الكامل"],[417,"سرينا لنمحو الإثم أو نغنم الأجرا","https://www.aldiwan.net/poem54107.html","الطويل"],[417,"بكت بدم من بعد عيسى وبندر","https://www.aldiwan.net/poem54120.html","الطويل"],[435,"رمى حر قلبي بأجفانه","https://www.aldiwan.net/poem25700.html","المتقارب"],[447,"غنيت دارنا تهامة في الدهر","https://www.aldiwan.net/poem23936.html","الخفيف"],[450,"يئس الصغار من الكبار","https://www.aldiwan.net/poem995.html",""],[454,"مهلا وريقات الخريف تمتعى","https://www.aldiwan.net/poem61662.html","الكامل"],[454,"عيد الضحية مرحبا بك عيدا","https://www.aldiwan.net/poem61686.html","الكامل"],[459,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[459,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[459,"هل تقبلون إنابة الدهر","https://www.aldiwan.net/poem56194.html","أحذ الكامل"],[462,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[478,"أمن مرمى بعيد القفر شاسع","https://www.aldiwan.net/poem15197.html","الوافر"],[478,"أراها عن الجزع تبغي عدولا","https://www.aldiwan.net/poem15225.html","المتقارب"],[507,"بشراي أبصرتك خير إمام","https://www.aldiwan.net/poem2462.html","الكامل"],[539,"كيف يمتاز من جلالك يوم","https://www.aldiwan.net/poem48237.html","عموديه"],[559,"إنما نحن للإله شئون","https://www.aldiwan.net/poem33829.html","المديد"],[559,"أيها الطالب النجاة أتاكا","https://www.aldiwan.net/poem34266.html","الخفيف"],[559,"إنني جمع وفرق","https://www.aldiwan.net/poem34329.html","مجزوء الرمل"],[559,"فديتك يا من قد خفيت فلاحا","https://www.aldiwan.net/poem34672.html","الطويل"],[576,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"],[576,"رأت منك رائيتي ما تحب","https://www.aldiwan.net/poem3095.html","المتقارب"]],"verses":[["فَتَسَلَّ فيهِ وَرُدَّ عا","رِيَةَ الغَرامِ إِلى المُعيرِ",0,"ر",1,0],["فتستفرغ الحيَّ الفتى من أديمه","وتكسو عجوزين الأديمَ المفرّغا",1,"غ",2,0],["فَتَستَيقِنا أَنّا أَخوكُم وَأَنَّنا","إِذا نُتِجَت شَهباءُ يَخشَونَ فالَها",2,"ل",3,0],["فَتُسَرّي بِالذِكرِ عَنها وَتَنفي","ما عَراها مِن غُضَّةٍ وَاِكتِئابِ",3,"ب",1,0],["فَتَسابَقوا الخَيراتِ فَهيَ أَمامَكُم","مَيدانُ سَبقٍ لِلجَوادِ النالِ",4,"ل",1,0],["فَتَسْمَعُ قَعْقَعَاتٍ مِنْ عِظَامٍ","تَرَضَّضُ فِيكَ مِنْ شَدٍّ وَلِينِ",5,"ن",1,0],["فتسيرُ أَصداءُ النِّيَاحَةِ","نحو أَطباقِ الضَّبابْ",6,"ب",1,0],["فَتَسيرُ في التَّيَّارِ راقصةً","على نَغَمِ الخريرْ",7,"ر",1,0],["فتسمع في مآتمهم غناء","وتسمع في ولائمهم نواحا",8,"ح",2,0],["فَتُسفِرُ عَنهُ وَالسُيوفُ كَأَنَّما","مَضارِبُها مِمّا اِنفَلَلنَ ضَرائِبُ",9,"ب",1,0],["فَتَسَمَّح بِها فَمِقدارُها يَص","غُرُ في قَدرِ طولِكَ المَشكورِ",10,"ر",1,0],["فَتَسأَلَهُ عَنّي فَيَعيا بِنِسبَتي","وَلا اِسمي وَمَن يَعيا سِماكَ الأَعازِلِ",11,"ل",1,0],["فتُسعِدُ في خَفْضٍ منَ العيشِ سعدَها","ويعتادُ في يُمْنٍ من الدَّهرِ عيدُها",12,"د",3,0],["فتُسفِرُ عن مثلِ وَردِ الربيعِ","وتَبسِمُ عن مثل نَوْرِ الأَقاحي",13,"ح",2,0],["فَتَستَحِقَّ مِنَ الدُنيا سَلامَتَها","وَتَستَقِلَّ بِعِرضٍ وافِرٍ وافِ",14,"ف",1,0],["فتستهدِفُ الأغراضَ آراؤهُ كما","تُقَرْطِسُ أغراضاً صوائبُ أسهمِ",15,"م",1,0],["فَتَسَامَحِي لِي مَرَّةً","حَتَّى أَفُوزَ بِلَثْمِ كُمِّكْ",16,"ك",1,0],["فَتَستَنُّ مِن سُبلِ المَفاخِرِ ما عَفا","وَتُدرِكُ ديناً ضاقَ مِنهُ المُخَنَّقُ",17,"ق",1,0],["فَتَسَمو ما يُعنيها ضَراءٌ","وَلا تَخبو فَيَبرَدُها السَمومُ",18,"م",1,0],["فَتُسرِعُ أَحياناً إِذا هِيَ لَم تَخَف","وَتَخشى عُيُوناً حَولَها فَتَمَيَّلُ",19,"ل",1,0],["فَتَسَلَّيتُ بِالمَعازِفِ عَنها","وَتَعَزّى قَلبي وَما مِن عَزاءِ",20,"ا",2,0],["فَتَسَلّبْنَ وَاسْتَعِرْنَ جَميعاً","منْ قَميصِ الدّجَى ثيابَ حِدادِ",21,"د",1,0],["فتسخط إذ لا شيء يوجب سخطها","وَتشتمها في وجهها وَتحقِّر",22,"ر",1,0],["فَتَساءَلنا للسَلامة عنه","وأَجابَ الخَبير منا يَقول",23,"ل",1,0],["فتسمّعوا أصداءها في موكب","للموت مُحتشدِ الفواجع زاخرِ",24,"ر",1,0],["فتسمعوه فلم يزل من شعره","شاد يهزّ بسحره الأرواحا",25,"ح",2,0],["فَتُسَاقُ البُحُوثُ فِيهِ ضَرُوياً","وَيُدَارُ الحَدِيثُ فِيهِ شَجُونَا",26,"ن",2,0],["فتسوغ في أذنيْ جميل رنتي","وتطيب نفس كثيّر ببياني",27,"ن",2,0],["فتساوينا جهاداً","وتآخينا سلاحا",28,"ح",2,0],["فتسامت إلى السماء كأن الْ","أَرض ضاقت عن جسمها النوراني",29,"ن",2,0],["فتسمح باليمنى دموع جفونها","وتجعل يسرى فوق قلب مروع",30,"ع",1,0],["فتساقطت شرفاتك النعسا","كأعشاش الطيور",31,"ر",1,0],["فتساندوا بعد اختلاف مطامع","أن لا يقيمَ الشرقَ أيَّ سناد",32,"د",1,0],["فتستيقني أن لم يكن من خلائقي","وذلك أمر يا بثين عظيم",33,"م",1,0],["فتسابقوا عن جهلهم","وعقوقهم يستغفرون",34,"ن",1,0],["فتستَّرت لمّا رأتني حائراً","في وصفِها أو رسمِها أو ضَمِّها",35,"م",3,0],["فتسليت نادما عن هواها","بعد أن كنتُ للرباب نديما",36,"م",2,0],["فَتَسقِيهَا القَرِيحَةُ لِى بَدِيعاً","وتَسقِيهَا المَعَاني والبَيَانَا",37,"ن",2,0],["فَتَسخنُ عَينُهُ عِندَ التَنائي","وَتَسخنُ عَينُهُ عِندَ التَلاقي",38,"ق",2,0],["فَتَساوَتا بعدَ السرى بسعادته","سُبحانَ مَن أَسرى بهِ تَعظيما",39,"م",2,0],["فَتَسمَّعوا لَمقالَتي وَتَأَهّبوا","بِذَميمِ بَغيِكُمُ لِسوءِ المَصرَعِ",40,"ع",1,0],["فتسعة أعشار الملاحة قُسِّمَت","عليك وفي كلِّ الخلائق عُشرُها",41,"ر",3,0],["فتستجيب بروح باسم مرحٍ","كأنه الزهر في أيام نيسان",42,"ن",1,0],["فتسير فوق الأرض ث","م تظن أنك في السماء",43,"ا",2,0],["فَتسكرُ الآلامُ في مُهجَتي","وَصَوتُ أُختي خَمرَةٌ تُسكِرُ",44,"ر",1,0],["فَتَسَلَّت خزائِنُ المالِ مَظلو","مٌ تَوَلّى وجاءَها مَظلومُ",45,"م",1,0],["فَتَسَاوَتَا فِي قِسْمِهَا إِذْ لَمْ تَجِدْ","كُلٌّ جَمِيعَ حُظُوظِهِ أَوْ جُلَّهَا",46,"ل",3,0],["فتستروا زمنا وقد أخفاهم","في داره وقت الصلاة الأرقم",47,"م",1,0],["فتسلخت مع ما يلي","ها في الجفون من البثور",48,"ر",1,0],["فتسقطُ أفلاذٌ وتنضُبُ أدمعٌ","وكلُّ الورى ما بين ناهٍ وناهب",49,"ب",1,0],["فتساقطَ العشَّاقُ صَرعى في الوَغى","أو ما اشتَفَيتِ وقد قتَلتِ ألوفا",50,"ف",2,0],["فتستيقظُ الأحياءُ بعدَ رقادِها","وما كان يُطوى من محاسِنها يُنشَر",51,"ر",1,0],["فتَسوّغْها عَلى حُكمِ المُنى","آثِراً مِنْ حَقها أن تُؤْثِرا",52,"ر",2,0],["فتسابق الاخوان ك","ل راكب متن السرير",53,"ر",1,0],["فَتَسَلَّ حاجَتَها إِذا هِيَ أَعرَضَت","بِخَميصَةٍ سُرُحِ اليَدَينِ وِساعِ",54,"ع",1,0],["فتسرع في رياض من جنان","وتأوي للقناديل المضيه",55,"ي",2,0],["فتسأل اللَه توفيقاً لطاعته","وشكره فهو أهل الفضل والكرم",56,"م",1,0],["فَتُسقى منهُ كأس بعد كأسٍ","وَتضربُ لِلمعاد وللمعيدِ",57,"د",1,0],["فتساءلت كيف أنماز منهم","ورائي خيارهم وأمامي",58,"م",2,0],["فتَسمَعُ شُكْري ثَمّ عندَ مُلوكِها","وما شُكْرُ دانٍ مُشْبِهاً شُكْرُ نازح",59,"ح",1,0],["فَتَسَمَّعوها بِالقُلوبِ فَإِنَّها","تَبكي وَما كُلُّ البُكاءِ بِدَمعَةِ",60,"ه",1,0],["فَتَسَل عَن إِحسان دَهر","لا يَميل إِلى الكِرام",61,"م",1,0],["فَتسُحُّ الماءَ ما سكنَت","فَإِذا هاجَت له اضطَرَبا",62,"ب",2,0