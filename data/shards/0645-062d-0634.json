{"poems":[[447,"هذا الفراق وهكذا التوديع","https://www.aldiwan.net/poem14378.html","الكامل"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18422","الرجز"],[1534,"","https://poetry.dctabudhabi.ae/diwan/poem/206189",""],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49614","الطويل"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32394","الرجز"],[5480,"حكم الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=11019",""],[5701,"إفريقيا لبني الفرنج فطيرة","https://www.poetsgate.com/ViewPoem.aspx?id=164611",""]],"verses":[["محشوةٌ منك المساجد بالثنا","للَه حيث بك الثنا مرفوع",0,"ع",1,0],["مُحَشرِجاً وَمَرَّةً صَدوحا","أَعجَمَ في آذانِها فَصيحا",1,"ح",2,0],["مَحْشومةٍ ما هيب من جِمْلَة رْغود","مرصوغةٍ تِطْعَم على إيدّ حَفّاد",2,"د",1,0],["مِحَشُّ حروبٍ حِلْف كلِّ تَنُوفةٍ","قَنَاهُ بها مَنْصُوبةٌ وَقَنابِلُهْ",3,"ل",2,0],["مَحشورَةٌ أُحكِمَ مِنهُنَّ القُطَب","لِيَومِ هَيجاءٍ أُعِدَّت لِلرَّهَب",4,"ب",1,0],["محشوم قدر الضيف ولا فالنا خاب","وكلنا هل الثيبات دايم نجيره",5,"ر",2,0],["محشوة أمما يرون جموعها","جوزا ولوزا في ثنايا رقها",6,"ق",3,0]]}