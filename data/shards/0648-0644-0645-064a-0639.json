,[5338,"غفا في عينك الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=187946",""],[592,"ألا قل لذي الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""],[5409,"ما للفراتين لا تطغى مياههما","https://www.poetsgate.com/ViewPoem.aspx?id=155433",""],[5431,"الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=182971",""],[5443,"تمنى بنفس الأبي","https://www.poetsgate.com/ViewPoem.aspx?id=185150",""],[5493,"عساكَ تحدّث الأحلام سرًّا","https://www.poetsgate.com/ViewPoem.aspx?id=196977",""],[5605,"رحلة عابر","https://www.poetsgate.com/ViewPoem.aspx?id=159458",""],[5701,"مقادير تمحو ما تشاء وتكتب","https://www.poetsgate.com/ViewPoem.aspx?id=164592",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[4615,"محلُّ ابنِ رزقٍ جرَّ فيه ذيولَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=17879",""],[5956,"ذكرياتُ مشاهدَ من حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=184838",""],[5956,"الرَّصيفُ ذو الحصى العسليّ","https://www.poetsgate.com/ViewPoem.aspx?id=184884",""],[6071,"وكم سهم بغيٍ لم أخف أن يصيبني","https://www.poetsgate.com/ViewPoem.aspx?id=187188",""],[6125,"هَتَفْنَا بأنَّ الشَّعبَ لا بُدَّ أنْ يَرضَىٰ","https://www.poetsgate.com/ViewPoem.aspx?id=210807",""],[6142,"من مبلغ أكثر الأصحاب معذلتي","https://www.poetsgate.com/ViewPoem.aspx?id=155745",""],[6308,"صوتٌ من الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87726&r=&rc=4",""]],"verses":[["وَلَمْ يَعْتَرِضْ مُبتَزَّهَا قَطْعُ قَاطِعٍ","وَلاَ نَازَعَتْ نَوْبَهْرَهَا كَفُّ عُدْوَانِ",0,"ن",1,0],["وَلَم يَعشَقِ العَلياءَ حُرٌّ وَلَم يَسُد","كَريمٌ وَلَم يَرجُ الثَراءَ فَقيرُ",1,"ر",1,0],["وَلَم يَعُد إِلّا كَما يَتَّقي","مُستَرِقُ السَمعِ مِنَ الكَوكَبِ",2,"ب",1,0],["وَلَم يَعتَلِج في حاضِرٍ مُتَجاورٍ","قَفا الغَضيِ مِن وادي العُشيرَةِ سامِرُ",3,"ر",1,0],["ولم يعطه إلاّ اليسير وإنما","على كدّه قامت صروح يَساره",4,"ر",2,0],["وَلَم يَعشُر نَداكَ أَبو عَدِيٍّ","وَلا كَعبُ بنُ مامَةَ مِن إِيادِ",5,"د",1,0],["ولمْ يعجزْك في الأيام شيءٌ","تحاوله سوى مرأًى نضير",6,"ر",1,0],["ولم يُعلِهم جودهم بل علوا","فجاءوا بكل نوال منع",7,"ع",1,0],["ولم يعن سعدا ما عدا مصر مقصد","ومقصد سعد من أجل المقاصد",8,"د",1,0],["وَلَم يَعرِف لَهُ الفَضلَ","وَلا قَدَّرَ آثارَه",9,"ر",2,0],["وَلَم يَعرِض لِذي حَقٍّ","بِنُقصانٍ وَلا بَخسِ",10,"س",1,0],["وَلَم يَعظُم لِنَقصٍ كانَ فيهِ","وَلَم يَزَلِ الأَميرَ وَلَن يَزالا",11,"ل",2,0],["وَلَم يَعُدني لَها طَيفٌ فَيَفجَأُني","إِلّا عَلى أَبرَحِ الوَجدِ الَّذي عُهِدا",12,"د",2,0],["وَلم يُعلِكَ إِلّا كَرَمُ النَفسِ","بَلى فَإِزدَدتَ بِالمُعتَزِّ تَعزيزا",13,"ز",2,0],["وَلَم يَعبُد يَغوثَ وَلَم يُشاهِد","لِحِميَرَ ما تَدينُ وَلا نِزارِ",14,"ر",1,0],["وَلَم يُعتِمِ الإِدراكُ مِنهُم بِذَحلِهِم","فَيَطمَعُ فيهِم بَعدَ ذَلِكَ غادِرُ",15,"ر",1,0],["وَلَم يَعدَموا مِن آلِ مَروانَ حَيَّةً","تَمامَ بُدورٍ وَجهَهُ غَيرُ كاسِفِ",16,"ف",1,0],["ولم يَعْدِلْ صفاءَ العيشِ فيهم","وبعضُهُمُ قَذاةٌ في شَرابِ",17,"ب",1,0],["وَلَم يَعتَرِف أَنَّ ماءَ الحَياءِ","عِندَ الكِرامِ كَماءِ النَجاةِ",18,"ا",2,0],["وَلَم يَعلَموا أَنَّ الزَمانَ يُريدُهُ","بِفَجعٍ وَلا أَنَّ المَنايا تُراسِلُه",19,"ل",2,0],["وَلَم يُعَدَّ مِنَ الأَبطالِ لَيثُ وَغىً","زُرَّت عَلَيهِ غَداةَ الرَوعِ دِرعانِ",20,"ن",1,0],["ولم يُعطِ الجدود القدس يوماً","ولا أحتلت فلسطيناً يهود",21,"د",1,0],["وَلَم يَعتَذِر عُذرَ البَريءِ وَلَم يَزَل","بِهِ سَكنَةٌ حَتّى يُقالَ مُريبُ",22,"ب",1,0],["وَلَم يَعوا ما يَقولُ واعِظُهُم","لَكِنَّ قَولَ المُخَرِّصينَ وَعَوا",23,"ع",3,0],["ولَمْ يَعْلُ بالجُرْدِ الجِيادِ يَقُودُها","بسُرَّةَ بَيْنَ الأَشْمَساتِ فأَيْصُرِ",24,"ر",1,0],["ولم يَعدُ في قصدي ولا سدَّ مذهبي","ولم يُنهِكْ الصبرَ المملِّ اعتزاميا",25,"ي",2,0],["وَلَمْ يَعُدْني لهَا طَيْفٌ، فيَفجَؤني،","إلاّ على أبْرَحِ الوَجْدِ الذي عُهِدَا",26,"د",2,0],["ولم يُعَظّمْ حقَّه أقوامُ","فيهمْ عليهِ بالخنا إقدَامُ",27,"م",1,0],["ولم يعط عن طيش من العيش بؤسنا","ولا يسرنا احسابنا ما يضيمها",28,"م",3,0],["ولم يعلم بان السمع مني","عقود كلام من اهواه صاغا",29,"غ",2,0],["ولَم يُعدَد مِنَ الفُقَهَاءِ حَتَّى","يَصِحَّ لَهُ تَطَلَّبُهُ الوُصُولا",30,"ل",2,0],["وَلَم يَعدِل بِهِ الإِرجافُ عَمّا","رَآهُ لَهُ إِمامُ العَصرِ أَهلا",31,"ل",2,0],["ولم يعش غير أبي","العارفها ذا كفنى",32,"ن",2,0],["ولم يعطه ما ظنه متفرقا","وكل على الثاني بما جاء مغضب",33,"ب",1,0],["ولم يَعتَذِر عُذرَ البَرىءِ وَلَم يَزَل","بِهِ صَعقَةٌ حتّى يُقالَ مُريبُ",34,"ب",1,0],["وَلَم يَعترف في دهره بنبوّةٍ","لهُ فَله دارُ الخلود جهنّمُ",35,"م",1,0],["ولم يعلُ في وجهه كالدُّخا","نِ إلا وأسفلُه كالحممْ",36,"م",1,0],["ولم يعدِلْ بك التمي","يُز لا يُمْنَى ولا يُسْرَى",37,"ر",2,0],["ولم يعوجوا على أهل ولا ولد","كأنهم لم يكونوا بينهم نزلوا",38,"ل",3,0],["ولَم يعر عن ثوبِ المروءةِ باذلٌ","مُحيّا اِبتهالٍ للكريم إذا أكبى",39,"ب",2,0],["ولم يعلموا أن الولادَةَ غربة","أُبِيحَت لهُ عن خيرِ دارِ وأَسرتِ",40,"ت",1,0],["ولم يعلموا أن الولادة غربة","أبيحت له عن خير دار وأسرة",41,"ه",1,0],["ولم يعد غير ما","تحكيه عنه الليال",42,"ل",1,0],["ولم يعرِ الزعامة أي هم","ولم يحفل اصولا أو فروعا",43,"ع",2,0],["ولم يَعتمدْ بأبيهِ اليَمي","نَ إلاّ ليُومِنَنا أنْ يَمينا",44,"ن",2,0],["ولم يعُدِ الصُّبْحُ لكنّني","غَسلْتُ بدَمْعيَ ثوبَ الدُّجى",45,"ا",1,0],["وَلَم يُعطِنا لا عَن رَجاءٍ وَخيفَةٍ","وَلَكِن يَراهُ حُرمَةً وَتَحَرُّما",46,"م",2,0],["ولَم يعلَموا ما جادَهُ الدَّمعُ فيهمُ","بل اتَّهَموا جَدوى عليِّ بنِ مُلهَمِ",47,"م",1,0],["ولم يعرفوا أفكارَه وهمومَه","ولو عَرفوا دقَّت عليهم وجلَّتِ",48,"ت",1,0],["ولم يُعرني الشيب أثوابه","أصبى عُيون البيضِ كالرَبربِ",49,"ب",1,0],["ولم يعش غير أيام منغصة","لم يخرج الحول إلا وهو بالكفن",50,"ن",1,0],["ولم يعطف على دَنِفٍ كئيب","وقد حاكى غصون البان قدا",51,"د",2,0],["ولم يعْدَمِ الشادِي بذكرِكَ زَهْرَةً","يطولُ بِهَا إعجابُهُ وازْدِهارُهُ",52,"ر",2,0],["ولم يعطِفْه أن عَجَّتْ حنينا","ألائفُها وفُجِّعَ راعياها",53,"ا",3,0],["ولم يعلموا مقدارَ عَطفةِ جودكم","عليَّ فلي نقصٌ بهم وضِرارُ",54,"ر",1,0],["ولم يعدِلْ أبا لك يَعرُبيّاً","زميلٌ مثلُ خالك في مَعَدِّ",55,"د",1,0],["ولم يعدُ في طوع الاِمام نصيحةً","ولو أوطأتهُ فوق شوْكِ العقاربِ",56,"ب",1,0],["وَلَم يَعتَذِر عُذرَ البَريءِ وَلَم يَزَل","بِهِ رَعدَةٌ حَتّى يُقالَ مُريبُ",57,"ب",1,0],["وَلَم يُعِرهُ حيطَةً جيرانُهُ","وَباتَ في مَنزِلِهِ إِخوانُهُ",58,"ه",1,0],["ولم يعظم أمناءَ الأُمَّهْ","فلا تلوموه ولومُوا أمَّهْ",59,"ه",1,0],["ولم يُعْدَوا طِوال الدّه","ر من أنيابِهِ الجُربِ",60,"ب",1,0],["وَلم يَعْرَ جلدِي كلّما ذَرَّ شارِقٌ","لِرامِي المَنايا مِن سِهامٍ صوائِبِ",61,"ب",1,0],["وَلَم يُعيِني إلّا الَّذي يطرقُ الفتى","وَإِلّا فإنّي غالبٌ كلَّ غالبِ",61,"ب",1,0],["وَلَم يَعرِفوا شُكراً لها ولربّها","فلم يعْلمونا كيف نشكر في الكُتْبِ",62,"ب",1,0],["ولم يعرف المسكين ما قال عارف","وقد ظن سوءاً وهو للحق جاحد",63,"د",1,0],["ولم يعتبْ على الأيَّامِ شخصٌ","يَرَى عدلَ القضاءِ ولا يلومُ",64,"م",1,0],["ولم يعمه كما قد عما","بها الذين في حنين سما",65,"م",2,0],["وَلَم يَعلَموا أَنَّ المَهارَ وَإِن زَكَت","لَتَعجَزَ عَمّا طالَ في الجَريِ قارِحُهُ",66,"ح",2,0],["ولم يُعْطَ منها النهشلي أداوةً","تكون له في القيظ ذخرا مدى الدهرِ",67,"ر",1,0],["وَلَم يَعظُم مُعاويَةٌ بِصَخرٍ","وَعَبّاسٌ بِجَمعِ بَني سَلَيمِ",68,"م",1,0],["ولم يعده نيلوفرٌ متشرف","بأرؤس تبرٍ والزبرجدُ أعناق",69,"ق",1,0],["وَلَم يَعلُها إِلّا شَبيهُك ضَيغَماً","ضَواري أُسودِ الغابِ مِنهُ هَوارِبُ",70,"ب",1,0],["وَلَم يُعلَم جِهادٌ لِلأَعادي","بِها ذي الأَرض يُحتسبُ اِحتِسابا",71,"ب",2,0],["ولمْ يَعُدْ للأمَاني أيّ مُبتدَأٍ","ولمْ يَعُدْ للمَنايا أيّ مُخْتَتَمِ",72,"م",1,0],["ولمْ يُعلِنْ دمي وهو المزكَّى","برَاءَتهُ مِنَ الأمسِ المُلامِ",73,"م",1,0],["وَلَم يَعدُ جُنحَ اللَّيلِ وارِدُ فَرعِهِ","وَلا الوَردَ ما قَد أَطلَعَت وَجَناتُهُ",74,"ت",2,0],["وَلَم يَعِزَّ حُمرُهُ وَصُفرُهُ","وَلا عَلا بَينَ الأَنامِ ذِكرُهُ",75,"ر",2,0],["ولم يعد لي النظرُ الشريفُ","كما بدا والكرم المألوف",76,"ف",1,0],["ولم يعلم بأن النظم فنٌّ","أهاليه نواخيذٌ نوادرْ",77,"ر",1,0],["ولم يعقتي عنها ما لقيت من الأولاد","والمال أو ليلي وان فتنت",78,"ت",1,0],["ولم يعد شيء يباع","عندكم ويرتهن",79,"ن",1,0],["ولم يعتدد مولاي وإلى بزلفة","إليك ولكن جود مولاي زلفتي",80,"ت",2,0],["ولم يعرفا للهم معنى ولا الاسى","ولم يدركا من قولنا الموت معناه",81,"ا",2,0],["ولم يعتمد إلاّ عقيلَةَ قومِها","ربيبةَ بيتِ العزّ في باذخ الذّرَى",82,"ر",2,0],["وَلَمْ يُعرفْ لها خُلقٌ ذميمٌ","ولم يوجَد لها سعيٌ مَعيبُ",83,"ب",1,0],["وَلَمْ يُعْدِ مِنِّي اللَّوْنَ لَوْنُ سَوادِهِ","خَلاَ أَنَّنِي أَشْقَى وَقِيلَ لَهُ انْعَمِ",84,"م",1,0],["وَلَم يَعنِهِ سَردُ الدُّرُوعِ وَإِنَّمَا","لِغَيرِ سِهَامِ الفِكرِ نَسجُ سَلُوقِ",85,"ق",1,0],["ولم يعط إلا الجيد والطرف للمها","ولم تتخذ غير التلفت والذعر",86,"ر",1,0],["وَلَم يَعِش إِلّا شُهوراً عَشرَه","وَلَيسَ شَيءٌ يَتَعَدّى قَدرَه",87,"ه",1,0],["وَلَم يَعتَذِر عُذرَ البَريءِ وَلَم يَزَل","لَهُ سَكتَةٌ حَتّى يُقالَ مُريبُ",88,"ب",1,0],["ولم يعلق فؤادي طول عمري","سواكم لا وعلام الخفايا",89,"ا",3,0],["وَلَم يَعرِفِ الناعي الحَميمُ حَميمَهُ","غَداةَ رَآهُ بِالغُبارِ مُلثَّما",90,"م",2,0],["ولم يَعرف الباري ولا أحمدَ سوى","عليٍ ولم يَعرفه إلاّ هما معاً",91,"ع",2,0],["وَلم يَعهد لَنا ذنب إِلَيهِ","سِوى تأخير إرسال النقوط",92,"ط",1,0],["ولم يَعزِمِ البَحرَينِ مَن هُوَّ حَازِمٌ","سوى أهلِها والغوصُ من قَبلُ في الزَّمَن",93,"ن",1,0],["وَلَم يَعلم المسكينُ أَنَّ صَديقَهُ","عَدوٌ مُبينٌ زائِدٌ في نِكالِهِ",94,"ه",1,0],["وَلَم يَعرف المسكينُ أَنّي أَنا الَّذي","قَرَأتُ حُروفاً لَم تُجزِها قَراطِسُه",95,"س",2,0],["ولم يعذب بنيه","بنشأة وفناء",96,"ا",2,0],["وَلَم يعرف النزر القَليل نِزارهم","وَلَكنهُ كَالغَيث إِن جادَ أَو أَسدى",97,"د",2,0],["ولم يعد للحب فيها أنين","ينقله العود عن العاشقين",98,"ن",1,0],["ولم يعتد بنو قحطانَ ذلاً","ولم يعلق بعرضِهِمِ انثلامُ",99,"م",1,0],["ولم يعلموا أنا غلاظ بعزمة","شداد نصد السالبين عن السلب",100,"ب",1,0],["ولَمْ يَعْدُه إِرْثُه مِنْ عَدِي","عَنِ المَجدِ يَكْسِبُهُ والمَعَالي",101,"ل",2,0],["ولم يعط شيئاً فالقديم بحاله","جديدٌ وإن طالبته قال قشلان",102,"ن",1,0],["وَلَم يَعلَم الاِنسانُ حال اِنطِلاقِه","أَتَجري لَدَيهِ الاِرضُ ام فَوقِها يَجري",103,"ر",2,0],["ولم يَعلم الواشون ما كانَ بَينَنا","وَما تفعل الأَشجانُ بينَ السَرائرِ",104,"ر",1,0],["وَلم يَعلم بقَدرِ الجَمع لاهٍ","إِذا لَم يَنفرد في دارِ غُربَه",105,"ب",2,0],["ولم يعبأ بهم لولا ولولا","فسوف يكون إن جحدوا لزاما",106,"م",2,0],["ولم يَعُق عن قُصُورٍ للوُصُولِ سِوَى","قُصُورِ عَزمٍ أو الحُصُولِ في أثَمِ",107,"م",1,0],["ولم يعرف لها من قبلُ ذكرٌ","ولا طرقت بأذن السامعينا",108,"ن",2,0],["وَلَمْ يَعْتَبِرْ مَشْهُورَ شَوْقٍ وَلَوْعَةٍ","لِمَنْ صَارَ مَقْطُوعاً لَهُ يَتَعَلَّلُ",109,"ل",1,0],["ولم يعترك بخل بميدان عدله","وجدواه إلا فاز جدواه بالنصر",110,"ر",1,0],["ولمْ يَعْدِلوا خَلقْاًَ بكم آلَ أَحْمدٍ","ولا أَنكروا إِذ أَنْكَر النَّاس حَيْدرا",111,"ر",2,0],["ولم يَعلَم نَوايا الرَّبِّ لَمَّا","عَلَيهِ قَدَّرَ الحَربِ السِّجَالا",112,"ل",2,0],["وَلَم يَعرِف لَهُ المِقدار إِلّا","لَبيبَ في التَجارُب ذو كَمال",113,"ل",1,0],["ولم يَعْلَموا أَنَّ المَدامعَ أَصلُها","من الْقَلْب لا من مُقْلَةٍ ذاتِ حاجِب",114,"ب",1,0],["ولم يعبإِ الجبّارُ في ذاك كلهِ","أَلَم يسطع القهّار عدلاً يعاقبُه",115,"ب",2,0],["ولم يعبأ بجيشٍ من لئامٍ","أثيثٍ قد تضيق بهِ النجادُ",116,"د",1,0],["وَلَم يُعدني هذا الأَميرُ بَعَدلِهِ","عَلى ظالِمٍ قَد لَجَّ في الهَجرِ وَالصَدِّ",117,"د",1,0],["ولم يعتمد داراً سوى حومة الوغا","ولا خدماً إلا القنا والقنابلا",118,"ل",2,0],["ولم يعد من الأخيار أهل التقى","نعم يعد من الأسقاط أهل الهرج",119,"ج",1,0],["ولم يعلم بان رقى يراعى","تقاوم كل ارقم ذي ريح",120,"ح",1,0],["وَلَم يَعتَلِق بي مِنكَ عِندَ اِفتِراقِنا","سِوى عَبَقٍ مِن مِسك قَينَتِكَ اللَميا",121,"ي",2,0],["ولم يعرف سوى التكفير نهجاً","فكان شعاره ثوباً قصيرا",122,"ر",2,0],["ولم يعد المُقام به اِئتلاف","وضلَّ الحكم عن قصد الرعية",123,"ي",2,0],["ولمْ يُعِدُّوا لغير الشعب عدتهم","إذْ حيَّدوهُ بحدِّ القهر والسَّغَبِ ( الجوع)",124,"ع",1,0],["ولم يعرفك إلا الله قدرا","وفضلا إنه الرب الخبير",125,"ر",1,0],["ولم يعُدْ في بلادِ العُرْب ِ من وطنٍ","للعُرْبِ إلا إذا عُدَّتْ مقابرُهُ",126,"ر",2,0],["ولم يعلم بأن له رئيساً","يقوم بردعه حتى يلينا",127,"ن",2,0],["ولم يعلم بما في دا","ره من كل مرتكب",128,"ب",1,0],["ولم يعرض السلوان لي عمر ساعةٍ","ولكنّ صرف البين جم مشاكله",129,"ل",2,0],["ولم يعلق على الرغباء همته","ولم تكد لحظة في العمر تغريه",130,"ي",2,0],["وَلَمْ يَعْلَمْ كَفَاهُ أَسَىً","بِأَنِّي وَالْحَشَىٰ مِزَقُ",131,"ق",1,0],["ولم يعلم الفدم الغبي بأنه","أتى مورداً من مورد الغي مظلما",132,"م",2,0],["ولم يعد فوق هذي الأرض من بشرٍ","ما حاد عن ظلمه الطاغي ولا عدلا",133,"ل",2,0],["ولم يعط النباهة في ارتقاء","سوى اللماح منطلق اللسان",134,"ن",1,0],["ولم يعرفوا أشرف الحسنيين","ولم يعرفوا الجنة السرمدية",135,"ي",2,0],["وَلمْ يَعلمْ بأَنَّ الحُلْمَ نَهْجٌ","إِلَى صَرْحٍ ليَغْدُوَ مُسْتَقَرَّا",136,"ر",2,0],["ولم يعد بيننا من سيفه يَقِظٌ","قد ابتلينا وغابَ السَّبْعُ والنَّمِرُ",137,"ر",1,0],["ولم يعرف الإسلام ملكا وراثة","ويأباه طبع الحر والطبع أغلب",138,"ب",1,0],["ولم يعرجن بالذات غير نبيا","إليه ونال منه كل فضيلة",139,"ه",1,0],["ولم يَعْتَلِقْ بي منكَ عند کفتِراقِنا","سوى عَبَقٍ منْ مِسْكِ قيْنَتِكَ اللمَّيْا",140,"ي",2,0],["ولم يعلموا أنّ شاعرهم ذا","سَيُفْرِحُ بالشعر حتى الثُّكالَى",141,"ل",2,0],["ولم يعلموا سرَّ حبي الدفيق","ولم أك أعلم سرَّ الخفوقْ",142,"ق",1,0],["ولم يعد [ني] حفظ الاله ولطفه","وليداً وكهلاً لو وفى بهما الشكر",143,"ر",1,0],["ولمْ يَعرف الإخوانُ حُكْمًا ودَولَةً","ولمْ يَعرف السِّيسِيُّ عَدلًا إذا أمضَىٰ",144,"ض",2,0],["ولم يعين سوى المعصوم من خطأ","فإن رمى هدفا في سهمه يصب",145,"ب",1,0],["ولمْ يعُد في ثيابِ الليل من لغةٍ","هُمْ غادَرُوا فإِذا الأَلوانُ كالظُّللِ",146,"ل",1,0]]}