{"poems":[[32,"نبت عيناك عن طلل بحزوى","https://www.aldiwan.net/poem29591.html","الوافر"],[29,"ألا تصحو وتقصر عن صباكا","https://www.aldiwan.net/poem5946.html","الوافر"],[49,"الدين مخترم والحق مهتضم","https://www.aldiwan.net/poem25156.html","البسيط"],[23,"لست إلى عمر ولا المرء منذر","https://www.aldiwan.net/poem21369.html","الطويل"],[66,"إلى كم أنت في بحر الخطايا","https://www.aldiwan.net/poem67674.html","الوافر"],[93,"شهور العام أجملها ربيع","https://www.aldiwan.net/poem8810.html","عموديه"],[94,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[47,"لعمرك ما أبو فهم لفهم","https://www.aldiwan.net/poem66641.html","الوافر"],[30,"منا الذي اختير الرجال سماحة","https://www.aldiwan.net/poem5306.html","الطويل"],[99,"أحب أجل أحب كأن نبعا","https://www.aldiwan.net/poem24913.html","الوافر"],[46,"نأت به الدار عن أقاربه","https://www.aldiwan.net/poem30292.html","المنسرح"],[71,"أراني الله وجهك كل حين","https://www.aldiwan.net/poem28575.html","الوافر"],[71,"برغمي أن بيتكم يضام","https://www.aldiwan.net/poem29243.html","الوافر"],[107,"إلى الغاية القصوى وإن شئت فازدد","https://www.aldiwan.net/poem42066.html","الطويل"],[107,"يريد الغاصبون ونحن نأبى","https://www.aldiwan.net/poem43138.html","الوافر"],[107,"أخالد إنك ذو نجدة","https://www.aldiwan.net/poem44022.html","المتقارب"],[41,"أهاجك بالملا دمن عوافي","https://www.aldiwan.net/poem53768.html","الوافر"],[52,"أتفخر بعد بني قشير","https://www.aldiwan.net/poem63984.html","البسيط"],[48,"أتفرح بالسرير عميد ملك","https://www.aldiwan.net/poem22630.html","الوافر"],[78,"أتلهو بين باطية وزير","https://www.aldiwan.net/poem39296.html","الوافر"],[29,"","https://poetry.dctabudhabi.ae/diwan/poem/1691","الطويل"],[102,"في وجه الغزوة الثالثة","https://www.poetsgate.com/ViewPoem.aspx?id=50422",""],[66,"فيا من بات يخلو بالمعاصي","https://www.poetsgate.com/ViewPoem.aspx?id=8504",""],[136,"أرى العذال في الهيمان لاموا","https://www.aldiwan.net/poem54654.html","الوافر"],[228,"ويل الضعيف من القدير","https://www.aldiwan.net/poem41921.html","مجزوء الكامل"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[343,"أتفرح أن ترى حسن الخضاب","https://www.aldiwan.net/poem68816.html","الوافر"],[409,"هذي الطريقة ليت شعري ما هي","https://www.aldiwan.net/poem33361.html","الكامل"],[445,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[466,"أقوال له والزهو ينغض عطفه","https://www.aldiwan.net/poem15933.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122588","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48799","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77498","الرجز"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117675","الطويل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117495","الطويل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117439","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46532","الرجز"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67379","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49611","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100972","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110282","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100801","البسيط"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26113","الوافر"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26116","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26114","الوافر"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74095","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91751","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132115","المتقارب"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132090","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85098","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73151","الوافر"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52124","الوافر"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52147","الخفيف"],[4778,"قالت وقد ودَّعتها","https://www.poetsgate.com/ViewPoem.aspx?id=193637",""],[4782,"قالت وقد ودعتُها/ بدية","https://www.poetsgate.com/ViewPoem.aspx?id=201018",""],[4883,"كأس من بُرتقال","https://www.poetsgate.com/ViewPoem.aspx?id=48401",""],[5183,"من مُلح الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180281",""],[5186,"تجادل فلاح وشيخ معلم","https://www.poetsgate.com/ViewPoem.aspx?id=156556",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5358,"يمن أنت يا يمن","https://www.poetsgate.com/ViewPoem.aspx?id=206165",""],[5376,"اتفنى بلادٌ وتحيا بلادُ","https://www.poetsgate.com/ViewPoem.aspx?id=200209",""],[5505,"قُلتُ لِرِجلي وَهيَ عَرجاءُ الخُطى","https://www.poetsgate.com/ViewPoem.aspx?id=86275",""],[5564,"يا لله يارب الخلايق يامعبود","https://www.poetsgate.com/ViewPoem.aspx?id=186844",""],[5956,"نجاحُ عملية حفيدي أرتين الجراحية","https://www.poetsgate.com/ViewPoem.aspx?id=202749",""],[5956,"أنهكتَ أمك لست تأكل جيدا","https://www.poetsgate.com/ViewPoem.aspx?id=205428",""],[6212,"مهرة الشمس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1619&r=&rc=0",""]],"verses":[["أَتَفخَرُ يا هِشامُ وَأَنتَ عًبدٌ","وَغارُكَ أَلأَمُ الغيرانِ غارا",0,"ر",2,0],["أَتَفخَرُ بِالحُبى وَخَزيتَ فيها","وَقَبلَ اليَومِ ما فُضِحَت حُباكا",1,"ك",2,0],["أَتَفخَرونَ عَلَيهِم لا أَبا لَكُمُ","حَتّى كَأَنَّ رَسولَ اللَهِ جَدُّكُمُ",2,"م",1,0],["أَتَفخَرُ بِالكَتّانِ لَمّا لَبِستَهُ","وَقَد يَلبَسُ الأَنباطُ رَيطاً مُقَصَّرا",3,"ر",2,0],["أَتَفرَحُ بِالذُنوبِ وبالخطايا","وَتَنساهُ وَلا أَحَدٌ سِواهُ",4,"ا",2,0],["أَتَفتَرِشُ الحَرير وَتَرتَديهِ","وَيَفتَرِشُ الجَنادِل وَالقَتادا",5,"د",2,0],["أتفنى ابتِساماتُ تِلْكََ الجفونِ","ويَخبو توهُّجُ تِلْكََ الخدودْ",6,"د",1,1],["أَتَفخَرُ وَهيَ أُمُّكَ وَالرُغاثا","أَبوكَ لَكِدتَ تَستَرِقُ النُجوما",7,"م",2,0],["أَتَفخَرُ أَن دَقَّت كُلَيبٌ بِنَهشَلٍ","وَما مِن كُلَيبٍ نَهشَلٌ وَالرَبائِعُ",8,"ع",1,0],["أتفكيري هناك أم انتظاري","لأروعِ هالةٍ حول البهاء",9,"ا",2,0],["اِتَّفَقَ الحُسنُ فيهِ وَاِختَلَفَت","مَذاهِبُ العَقلِ في مَذاهِبِهِ",10,"ب",2,0],["أتفرحني بطيبِ الوصلِ كلاّ","فما في العاشقينَ سوى حزينِ",11,"ن",1,0],["أتفجعُنا بكتانيَّ مصرٍ","وكان بها لساكنها اعتصامُ",12,"م",1,0],["أَتَفْهَقُ بالرِيِّ الحياضُ لأهلها","ونحن نُعاني غُلَّةَ الحائمِ الصَّدِ",13,"د",1,0],["أَتُفجِعُنا المَآتِمُ كُلَّ يَومٍ","وَتُفزِعُنا النُعاةُ بِكُلِّ نادِ",14,"د",1,0],["أتفعلُ وَيْحَكَ ما لو عقلتَ","لأعرضتَ عنه ولم تفعلِ",15,"ل",1,0],["أَتفخَرُ يَشكُرٌ بِبَني لُجَيمٍ","خِلافاً ما يَكونُ مِنَ الخِلافِ",16,"ف",1,0],["أَتَفخَرُ بَعدَ بَني قُشَيرٍ","وَأَنتَ مُخَنَّثٌ فيكِ اِعوِجاجُ",17,"ج",1,1],["أَتَفرَحُ بِالسَريرِ عَميدَ مُلكٍ","بِجَهلِكَ وَالحُصولِ عَلى السَريرَة",18,"ر",2,1],["أَتَفْرحُ والمَنِيَّةُ كُلَّ يَوْمٍ","تُريكَ مَكانَ قَبرِكَ في القُبورِ",19,"ر",1,0],["أَتَفخَرُ تَيمٌ بِالضَلالِ وَلَم يَكُن","لَهُم حَسَبٌ ذاكٍ وَلا عَدَدٌ مُثرِ",20,"ر",1,0],["اتفقنا ماذا هناك ؟ جدار","بل جبين ، عليه شيء كقبّه",21,"ب",2,0],["أتفرح بالذنوب والخطايا","وتنساه ولا أحد سواه",22,"ا",2,0],["أتفخرُ يافويسقُ بعد وَجنَا","ذَلُولٍ حين جاذَبَها الزمام",23,"م",1,0],["أتفخر بعد ما نتفت لحن من","أبيك وكسرت منه",23,"م",3,0],["أَتفاوتٌ بَينَ الغِنى","وَالفَقرُ حَتّى في القُبور",24,"ر",1,0],["أَتفاوتٌ بَينَ الفَقي","رِ لَدى المُهَيمِنِ وَالأَمير",24,"ر",1,0],["أتُفّاحةٌ سرُّ هذا الشقاء","ومن أجلها كلُّ هذا البلاء",25,"ا",2,0],["أَتَفرَحُ أَن تَرى حُسنَ الخِضابِ","وَقَد وارَيتَ بَعضَكَ في التُرابِ",26,"ب",1,1],["أتفوه أحياناً بذكر تراجم","لجماعة ليسوا من الأنباه",27,"ه",1,0],["أَتَفَرُّقٌ حَتَّى بمنزلِ غُرْبَةٍ","كم نحنُ للأَيَّامِ نُهْبَةُ ناهِبِ",28,"ب",1,0],["أتفخرُ أن سُمِّيتَ عيداً وللعُلى","ببعدادَ عيدٌ ما تَغِبُّ نَوافِلُهْ",29,"ل",2,0],["أتَفنَى ولبّاتُ الجياد سَوالِمٌ","صِحاحٌ وخُرصانُ القَنا لَم تُقَصَّدِ",30,"د",1,0],["اتفاقاً على الخضوع يريد ال","خصم منكم أو اختلافاً عليه",31,"ي",2,0],["اِتفَقَ الحالُ مَع الصَياد","في بَلدَةٍ مِن أَصغَر البِلاد",32,"د",1,1],["أتفرقُ ما بينَ القُدودِ وهذه ال","غُصون فقال الكل عندي أغصانُ",33,"ن",1,0],["أتفخرُ إذ طاعنتَ خيلاً مُغيرةً","فوارسُها يوم الوغى ما لها ذِكرُ",34,"ر",1,1],["أتفرقُ بين الخدِّ والوردِ فارتأى","زماناً وقال الكل في ناظري وَردُ",35,"د",1,0],["إِتَّفَقت شعابه","وَاِختَلَفَت أَسبابه",36,"ه",1,0],["أتَفَصِلُ أمْراً غِبْتَ عَنْه بِشُبْهَةٍ","وَقَدْ حَارَ فِيهَا عَدْل كُلّ بَصِيرِ",37,"ر",1,0],["أتَفْرَقُونَ لإنكاريْ ملامَكُمُ","يا قومُ مَهْلاً فما ذا اللومُ فرقان",38,"ن",1,0],["أتفضحه يوم الحساب ذنوبه","وقد رفعت عن تابعيك الفضائح",39,"ح",1,0],["اتفتك في ابناك يا ملك جائراً","وتبخل عن ابناك يا ملك بالقبر",40,"ر",1,0],["أتفخرون بآثار لغيركمُ","الظلم شيدها والدهر يبليها",41,"ي",3,0],["أَتَفخَرُ يا جَريرُ وَأَنتَ عَبدٌ","مِنَ الرَمكيَةِ اِقتَضبَ اِقتِضابا",42,"ب",2,0],["أَتَفخَرُ بِالعَلهانِ بِرذَونِ عاصِمٍ","وَسَيَّبتَ جَدَّيكَ المعيدَ وَقَرهَدا",43,"د",2,0],["أَتَفخَرُ أَن عَددتَ بَني تَميمٍ","وَذَلِكَ مِنكُمُ نَسبٌ بَعيدُ",44,"د",1,0],["أَتفرّس المَرء الأَنيق وَإِنَّما","من فاته الخير اليَقين تفرّسا",45,"س",2,0],["أَتفجعنا الدُنيا وَنَحنُ نحبُّها","وَنَعدِلُ فيها ثم تَأخذنا ظُلما",46,"م",2,0],["أتفخر باريس بعد علينا","بذذت بنيها فما تفخرُ",47,"ر",1,0],["أتفوز منك بنابغٍ يسعى لهَا","بهوى المحب وجرأة المغوارِ",48,"ر",1,0],["أتفارق الوجه الذي","حاكاه أشراق القمر",49,"ر",1,0],["أتفهمُ ما تقولُ لكَ الجَنوبُ","وليسَ لسانَها إلاَّ الهبُوبُ",50,"ب",1,1],["أَتفكرُ إن لبِست الخَزَّ فيها","غَدَوت مُنعَّماً في حُسنِ حالِ",51,"ل",1,0],["أتفكُّ القيود عن أُمَمِ الغرب","وتُبقِي الشرقيّ في الأصفادِ",52,"د",1,0],["اتفارق البلد التي","........ أحببتها (بُشْرى) البشير",53,"ر",1,0],["أتفارقُ المهدَ الذي","سكنَ الضياءُ به🌴بديَّة؟",54,"ي",2,0],["\"اتفضل\"..:وقلت : هذا الشي من سلسبيل","قالوا: سؤالك خطير، وقلت: ب اضرب مثال",55,"ل",1,0],["أتفجؤني ولا استعداد عندي","لوصلك فالمفاجأة احتقار",56,"ر",1,0],["أتفهم قصدي يا أبا ابن مضيع","حمارك هذا واحد وابنك الثاني",57,"ن",2,0],["أتفخر بالدعوى وبالفشر ذلة","فوالله ما كنا عهدناك ضيغما",58,"م",2,0],["أتفخرونَ بالغنى ؟","لاغنى دونما فِطَنْ",59,"ن",1,0],["اتفنى بلادٌ وتحيا بلادُ","ويبقى يسوحُ الدنا سندبادُ",60,"د",1,1],["أَتَفضَحيني بَينَ حورٍ كَالمَها","أَوانِسٍ مِثلِ تَصاويرِ الدُمى",61,"ا",1,0],["اتفاكروا عني على سد وسدود","ولا خذوا أنفوسهم بانتساله",62,"ل",2,0],["أ تفعل مثل أبيك تماماً","كما يفعل الأسد الكاسرُ؟",63,"ر",1,0],["أ تفضّل الألعابَ أم جَدّاً؟ بلى","سأفضل الألعاب فالجَدُّ اجتدى",64,"د",2,0],["أ تُفّاحةَ الحُلْمِ، وقتي هباءٌ","وأنتِ هنالكِ، وقْتاً بهيّا‏",65,"ي",2,0]]}