{"poems":[[30,"نبت عيناك عن طلل بحزوى","https://www.aldiwan.net/poem29591.html","الوافر"],[27,"ألا تصحو وتقصر عن صباكا","https://www.aldiwan.net/poem5946.html","الوافر"],[47,"الدين مخترم والحق مهتضم","https://www.aldiwan.net/poem25156.html","البسيط"],[23,"لست إلى عمر ولا المرء منذر","https://www.aldiwan.net/poem21369.html","الطويل"],[64,"إلى كم أنت في بحر الخطايا","https://www.aldiwan.net/poem67674.html","الوافر"],[91,"شهور العام أجملها ربيع","https://www.aldiwan.net/poem8810.html","عموديه"],[92,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[45,"لعمرك ما أبو فهم لفهم","https://www.aldiwan.net/poem66641.html","الوافر"],[28,"منا الذي اختير الرجال سماحة","https://www.aldiwan.net/poem5306.html","الطويل"],[97,"أحب أجل أحب كأن نبعا","https://www.aldiwan.net/poem24913.html","الوافر"],[44,"نأت به الدار عن أقاربه","https://www.aldiwan.net/poem30292.html","المنسرح"],[69,"أراني الله وجهك كل حين","https://www.aldiwan.net/poem28575.html","الوافر"],[69,"برغمي أن بيتكم يضام","https://www.aldiwan.net/poem29243.html","الوافر"],[105,"إلى الغاية القصوى وإن شئت فازدد","https://www.aldiwan.net/poem42066.html","الطويل"],[105,"يريد الغاصبون ونحن نأبى","https://www.aldiwan.net/poem43138.html","الوافر"],[105,"أخالد إنك ذو نجدة","https://www.aldiwan.net/poem44022.html","المتقارب"],[39,"أهاجك بالملا دمن عوافي","https://www.aldiwan.net/poem53768.html","الوافر"],[50,"أتفخر بعد بني قشير","https://www.aldiwan.net/poem63984.html","البسيط"],[46,"أتفرح بالسرير عميد ملك","https://www.aldiwan.net/poem22630.html","الوافر"],[76,"أتلهو بين باطية وزير","https://www.aldiwan.net/poem39296.html","الوافر"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1691","الطويل"],[100,"في وجه الغزوة الثالثة","https://www.poetsgate.com/ViewPoem.aspx?id=50422",""],[64,"فيا من بات يخلو بالمعاصي","https://www.poetsgate.com/ViewPoem.aspx?id=8504",""],[133,"أرى العذال في الهيمان لاموا","https://www.aldiwan.net/poem54654.html","الوافر"],[224,"ويل الضعيف من القدير","https://www.aldiwan.net/poem41921.html","مجزوء الكامل"],[329,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[339,"أتفرح أن ترى حسن الخضاب","https://www.aldiwan.net/poem68816.html","الوافر"],[404,"هذي الطريقة ليت شعري ما هي","https://www.aldiwan.net/poem33361.html","الكامل"],[440,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[462,"أقوال له والزهو ينغض عطفه","https://www.aldiwan.net/poem15933.html","الطويل"]],"verses":[["أَتَفخَرُ يا هِشامُ وَأَنتَ عًبدٌ","وَغارُكَ أَلأَمُ الغيرانِ غارا",0,"ر",2,0],["أَتَفخَرُ بِالحُبى وَخَزيتَ فيها","وَقَبلَ اليَومِ ما فُضِحَت حُباكا",1,"ك",2,0],["أَتَفخَرونَ عَلَيهِم لا أَبا لَكُمُ","حَتّى كَأَنَّ رَسولَ اللَهِ جَدُّكُمُ",2,"م",1,0],["أَتَفخَرُ بِالكَتّانِ لَمّا لَبِستَهُ","وَقَد يَلبَسُ الأَنباطُ رَيطاً مُقَصَّرا",3,"ر",2,0],["أَتَفرَحُ بِالذُنوبِ وبالخطايا","وَتَنساهُ وَلا أَحَدٌ سِواهُ",4,"ا",2,0],["أَتَفتَرِشُ الحَرير وَتَرتَديهِ","وَيَفتَرِشُ الجَنادِل وَالقَتادا",5,"د",2,0],["أتفنى ابتِساماتُ تِلْكََ الجفونِ","ويَخبو توهُّجُ تِلْكََ الخدودْ",6,"د",1,1],["أَتَفخَرُ وَهيَ أُمُّكَ وَالرُغاثا","أَبوكَ لَكِدتَ تَستَرِقُ النُجوما",7,"م",2,0],["أَتَفخَرُ أَن دَقَّت كُلَيبٌ بِنَهشَلٍ","وَما مِن كُلَيبٍ نَهشَلٌ وَالرَبائِعُ",8,"ع",1,0],["أتفكيري هناك أم انتظاري","لأروعِ هالةٍ حول البهاء",9,"ا",2,0],["اِتَّفَقَ الحُسنُ فيهِ وَاِختَلَفَت","مَذاهِبُ العَقلِ في مَذاهِبِهِ",10,"ب",2,0],["أتفرحني بطيبِ الوصلِ كلاّ","فما في العاشقينَ سوى حزينِ",11,"ن",1,0],["أتفجعُنا بكتانيَّ مصرٍ","وكان بها لساكنها اعتصامُ",12,"م",1,0],["أَتَفْهَقُ بالرِيِّ الحياضُ لأهلها","ونحن نُعاني غُلَّةَ الحائمِ الصَّدِ",13,"د",1,0],["أَتُفجِعُنا المَآتِمُ كُلَّ يَومٍ","وَتُفزِعُنا النُعاةُ بِكُلِّ نادِ",14,"د",1,0],["أتفعلُ وَيْحَكَ ما لو عقلتَ","لأعرضتَ عنه ولم تفعلِ",15,"ل",1,0],["أَتفخَرُ يَشكُرٌ بِبَني لُجَيمٍ","خِلافاً ما يَكونُ مِنَ الخِلافِ",16,"ف",1,0],["أَتَفخَرُ بَعدَ بَني قُشَيرٍ","وَأَنتَ مُخَنَّثٌ فيكِ اِعوِجاجُ",17,"ج",1,1],["أَتَفرَحُ بِالسَريرِ عَميدَ مُلكٍ","بِجَهلِكَ وَالحُصولِ عَلى السَريرَة",18,"ر",2,1],["أَتَفْرحُ والمَنِيَّةُ كُلَّ يَوْمٍ","تُريكَ مَكانَ قَبرِكَ في القُبورِ",19,"ر",1,0],["أَتَفخَرُ تَيمٌ بِالضَلالِ وَلَم يَكُن","لَهُم حَسَبٌ ذاكٍ وَلا عَدَدٌ مُثرِ",20,"ر",1,0],["اتفقنا ماذا هناك ؟ جدار","بل جبين ، عليه شيء كقبّه",21,"ب",2,0],["أتفرح بالذنوب والخطايا","وتنساه ولا أحد سواه",22,"ا",2,0],["أتفخرُ يافويسقُ بعد وَجنَا","ذَلُولٍ حين جاذَبَها الزمام",23,"م",1,0],["أتفخر بعد ما نتفت لحن من","أبيك وكسرت منه",23,"م",3,0],["أَتفاوتٌ بَينَ الغِنى","وَالفَقرُ حَتّى في القُبور",24,"ر",1,0],["أَتفاوتٌ بَينَ الفَقي","رِ لَدى المُهَيمِنِ وَالأَمير",24,"ر",1,0],["أتُفّاحةٌ سرُّ هذا الشقاء","ومن أجلها كلُّ هذا البلاء",25,"ا",2,0],["أَتَفرَحُ أَن تَرى حُسنَ الخِضابِ","وَقَد وارَيتَ بَعضَكَ في التُرابِ",26,"ب",1,1],["أتفوه أحياناً بذكر تراجم","لجماعة ليسوا من الأنباه",27,"ه",1,0],["أَتَفَرُّقٌ حَتَّى بمنزلِ غُرْبَةٍ","كم نحنُ للأَيَّامِ نُهْبَةُ ناهِبِ",28,"ب",1,0],["أتفخرُ أن سُمِّيتَ عيداً وللعُلى","ببعدادَ عيدٌ ما تَغِبُّ نَوافِلُهْ",29,"ل",2,0]]}