وح","https://www.poetsgate.com/ViewPoem.aspx?id=202878",""],[6152,"عانق خيالي ما استطعت","https://www.poetsgate.com/ViewPoem.aspx?id=213211",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[6273,"قواف ٍ في ركب السراة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78507&r=&rc=5",""],[6300,"بقايا الزمن المرّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82864&r=&rc=35",""],[6335,"قراءة في قسمات وجه عربي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65401&r=&rc=3",""],[5567,"فيوضات فارابية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82101&r=&rc=142",""],[6357,"طفوليه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76501&r=&rc=10",""],[572,"لستُ على عذلِكَ صَبَّارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9316&r=&rc=173",""]],"verses":[["عانَقوا الهُضبَ وَكانوا هَضبَةً","لا يُلاقي عِندَها السيلُ قَرارا",0,"ر",2,0],["عانَقْتُها وَالشُّهْبُ ناعِسَةٌ","وَالأُفْقُ بِالظَّلْماءِ مُنْتَطِقٌ",1,"ق",1,0],["عانَقْتُها بِرِداءِ اللَّيْلِ مشْتَمِلاً","حَتّى انْتَبَهْتُ بِبَرْدِ الحَلْي في الغَلَسِ",2,"س",1,0],["عانده في أمرها نحسه","وساعدتها الأنجم السبعه",3,"ع",2,0],["عانياً دَهْرهُ بحبِّ حبيبٍ","وفؤادي ببُغْضِك الدهر عاني",4,"ن",2,0],["عانِيَّةٌ تَرفَعُ الأَرواحُ نَفحَتَها","لَو كانَ تُسقى بِها الأَمواتُ قَد نَشَروا",5,"ر",3,0],["عانِيَّةٌ قُرقُفٌ لَم تُطَّلَع سَنَةً","يُجِنُّها مُدمَجٌ بِالطينِ مَختومُ",6,"م",1,0],["عانَقَتني وَأَنا أَبكي دَماً","وَهيَ تَبكي لِبُكائِيَ دُرَرا",7,"ر",2,0],["عانَقَتِ الأَسمالُ تِلكَ الحِلى","وَاِصطَحَبَ المَقهورُ وَالقاهِرُ",8,"ر",1,0],["عانَقتُ مِنهُ الغُصنَ في","حَرَكاتِهِ قَدّاً وَشَكلا",9,"ل",2,0],["عانَقتُ غُصنَ البانِ مِنهُ مُثمِراً","وَلَثَمتُ بَدرَ التَمِّ مِنهُ مُسفِرا",10,"ر",2,0],["عانقيني قبل النوى لوداعي","وضعي الجيد ساعة فوق جيدي",11,"د",2,0],["عانى قَضاءَ الأَرضِ عِلمَ مُحَصِّلٍ","وَاَليَومَ عالَجَ لِلسَماءِ قَضاءَ",12,"ا",2,0],["عانَقتَ أَغصاناً وَعانَقتُ الجَوى","وَشَكَوتَ وَالشَكوى عَلَيَّ حَرامُ",13,"م",1,0],["عانَقَتهُم ظُبا السُيوفِ فَلا مُن","صَلٌ إِلّا مُغَيَّبٌ في جيدِ",14,"د",1,0],["عانقت فيها عندما ودعته","رجلاً يسمى \"طارق بن زياد\"",15,"د",1,0],["عانَقتُهُ عِندَ القُدو","مِ وَجَدَّ في إِسراعِه",16,"ع",2,0],["عانَقتُهُ مُتَرَفِّقاً وَضَمَمتُهُ","مُتَأَيِّداً إِذ نامَتِ الرُقَباءُ",17,"ا",2,0],["عانَدَهُ في الحُبَ أَعوانُه","وَخانَهُ في الرَدِّ إِخوانُه",18,"ن",2,1],["عانَقتُهُ وَضَمَمتُهُ فَكَأَنَّهُ","مِن ساعِدَيَّ مُطَوَّقٌ وَمُمَنطَقُ",19,"ق",1,0],["عانيتُها والليلُ لعنةُ كافرٍ","وطويتُها والصبحُ دمعة نادم",20,"م",1,0],["عانَقَهَا الموجُ ثمّ فارقَها","عن ضَمّةٍ فاضَ روحها فيها",21,"ي",3,0],["عانى خداعَ الحربِ طفلاً فما","يُقعْقعُ القِرْنَ له بالشنان",22,"ن",1,0],["عانقتُهُ حتى ارتوتْ","خدَّاهُ مِنْ عينيَّ دَمْعَا",23,"ع",2,1],["عانَقَ الغُصنَ فَاِحتَذى","لينَ عِطفَيهِ وَاِستَرَق",24,"ق",1,0],["عانَتِ الصَيفَ بِمُستَوكِفٍ","أَكَلَ الكيحَ إِذ الجَمُّ طام",25,"م",1,0],["عانَقتُمُ الأَحلامَ في مَضجَعٍ","سَيُنبِتُ الشَوكَ لَكُم بَعدَ حين",26,"ن",1,0],["عانَقَتني لَيلى لوشك الفراقِ","فَتلاقَت دموعنا في العناقِ",27,"ق",1,1],["عانقيني فلست احسب انا","نتلاقى وقد عزمت مضيا",28,"ي",2,0],["عانقتها بعد برح","من الهوى والولوع",29,"ع",1,1],["عانقتُها ظمآنَ أشربُ راحَها","واستقطرت قلبي لتملأ جامَها",30,"ه",2,0],["عَانَقْتُهَا فَانْثَنَتْ طَوْعَ العِنَاقِ كَمَا","مَالتْ بِشَارِبِهَا صَهْبَاءُ خُرْطُومُ",31,"م",1,0],["عانيت جهد محبّ في الوفاء له","والغدر بي كلّ ما عانى وما جهدا",32,"د",2,0],["عَانَتْ مِنْ الأسْقَامِ مَا لَمْ يَكُنْ","مِنْ قَبْلُ عَانَاهُ امْرُوءٌ مُبْتَلَى",33,"ل",2,0],["عَانَى مُحَمَّدُ مَا عَانَى بِهِجْرَتِهِ","لِمَأْرَبٍ فِي سَبيلِ اللهِ مَحْمُودِ",34,"د",1,0],["عانسٌ تقهَرُ الشبابَ عجوزٌ","بنت قَرنٍ من الزمانِ وقَرْن",35,"ن",1,0],["عانقت فيها عندما ودعتها","رجلا يسمى طارق بن زياد",36,"د",1,0],["عانٍ يتوق إلى الوثو","ب، فلا يتاح له الوثوب",37,"ب",1,0],["عانق الموت زؤاماً سادر","ظنَّها \" باريسَ \" بنْتَ الطرب",38,"ب",1,0],["عانَى لَظَى الحُبِّ \" بشَّارٌ \" وعُصبتُه","فهل سوى أنَّهم كانوا له حَطبا",39,"ب",2,0],["عانقتهم ظبا السيوف فلا من","صل إلا مغيث في جيد",40,"د",1,0],["عَانَتْ بِلَادِي ظُلْمَةَ الصَمْتِ الثَقِيلِ","فَكُلُّ صَوْتٍ كَانَ يَعْلُو يُقْمَعُ",41,"ع",1,0],["عانَقتُهُ وَرِداءُ الوَصلِ يَجمَعُنَا","حَتَّى الصبّاحِ عِناقَ اللاَّمِ لِلأَلِفِ",42,"ف",1,0],["عانِ انتهاراً للخلا","ص فما الهوى إلاّ انتهارْ",43,"ر",1,0],["عَانَقْتُ بَدْراً فيهِ وَعَانَقَنَي","فَصَارَ حَظِّي مِنْ ذَيْنِ حَظَّيْنِ",44,"ن",1,0],["عَانَقْتُ مَولايَ عِنْدَ رُؤْيَتِهِ","وَنِلْتُ سُؤْلي بِحُسْنِ ما صَنَعا",45,"ع",2,1],["عَانَقْتُ مَنْ أَهْوى ويا طالما","بِتُّ مِنَ الشَّوقِ عَلى نارِ",46,"ر",1,0],["عانى وما حابى العدو فاعذرا","ورأى رضا الباري أهم فآثرا",47,"ر",2,1],["عانَقتُ مِنهُ وَقَد مالَ النُعاسُ بِهِ","وَالكَأسُ تُقسَمُ سُكراً بَينَ جُلّاسي",48,"ي",1,1],["عانقتُ بدراً دونَهُ بدرُ الدُّجى","أَرأيتَ للدرِ المُنيرِ مُعانقا",49,"ق",2,0],["عانقيني صدق اللَه","فبعد العسر يسرا",50,"ر",2,0],["عانِقيني وأطفئي غُلَّةَ الروح","فجِسمي براهُ ما ف القَرارَه",51,"ر",2,0],["عانقتُ منه الصبحَ ح","تى لاح صُبْحٌ أشهب",52,"ب",1,0],["عانقتها الصَّبا كما","ضمَّ خوداً حبيبُها",53,"ب",3,0],["عانقتُها يومَ النَّوَى ولدمعِها","متحدَّرٌ ولقلِبها خفقانُ",54,"ن",1,1],["عانقتُها ودموعي في مدامعها","مُنْهَلَّةٌ وتلاثَمْنا فَماً بفم",55,"م",1,0],["عانقْت لامَ صُدْغها صادُ لثمي","فأرتها المرآةُ في الخد لِصّا",56,"ص",2,1],["عانَقتُ مِنهُ ما شَفَيتُ بِهِ الجَوى","فَكَأَنَّني عانَقتُهُ يَقظانا",57,"ن",2,0],["عانِسَةٍ تُجلى عَلى الشِماسِ","تَروي أَحاديثَ أَبي نُوّاسِ",58,"س",1,0],["عانَقتُهُ أَبكي وَيَبسِمُ ثَغرُهُ","كَالبَرقِ أَومَضَ في غَمامٍ هاطِلِ",59,"ل",1,0],["عانَقَني وَلَم يَكُن","لَولا النَوى مُعتَنِقي",60,"ق",2,0],["عانٍ عَلى الشَرَفِ المَوروثِ تالِدُهُ","بِما اِستَجَدَّ مِنَ العَلياءِ أَو طَرُفا",61,"ف",2,0],["عَانَقْتُ مِنْ قَامَتِهِ غُصُناً","كَمَا قَطَفْتُ الْوَرْدَ مِنْ وَجْنَتِهِ",62,"ت",2,0],["عانَقَ الحُمرَةَ البَياضُ بِخَدَّي","هِ بِنَفسي اِبيِضاضُه وَاِحمِرارُه",63,"ر",2,0],["عانِيَّةٌ صِرفٌ مُعَتَّقَةٌ","يَسعى بِها ذو تومَةٍ لَبِقُ",64,"ق",1,0],["عانيت منها بجهدي كل شاردة","لولا سعودك ما كادت تواتين",65,"ن",1,0],["عانى وعالجَ والمماتُ مرفرف يقظ","يُخيِّبُ آسياً أو حائلا",66,"ل",2,0],["عانيَّةٍ تُصبي الحليمَ إِذا","دارَت أَكُفّ القَومِ بالكأسِ",67,"س",1,0],["عاني المها مُستَهلّ الدَمع هامره","واهي القوى ما شَكا بُؤساً وَلا ضررا",68,"ر",2,0],["عاني المها مُستَهلّ الدَمع هاطله","واهي القوى ما شَكا بُؤساً وَلا ثقلا",69,"ل",2,0],["عاني المها مُستَهلّ الدَمع ساكبه","واهي القوى ما شَكا بُؤساً وَلا وَصَبا",70,"ب",2,0],["عانَقتُه فَاِسوَدّت المقل الَّتي","هِي بَلوَتي وَاِحمَرَّت الوَجنات",71,"ت",1,0],["عانَدتْنا فيهمْ صروفُ اللّيالي","وفنونٌ من اللّيالي الجُنون",72,"ن",1,0],["عانَقْتُه يومَ الرَّحي","لِ أَضُمُّه والحيُّ سَفْر",73,"ر",1,0],["عانقتهُ وهو مُرخٍ مِن ذوائبهِ","ستراً يمدّ حواشيه على الأفقِ",74,"ق",1,0],["عانَقتُ غُصن البانِ تَحتَ وِشاحِهِ","وَلثمتُ بدر التَمِّ تَحتَ لِثامِهِ",75,"م",2,0],["عانى الحروب مجاهراً ومخاتلاً","طفلاً إلى ان عاد همّاً أشيبا",76,"ب",2,0],["عانَنَا الدّهرُ فأضحَى شملُنا","بَعدَ ما كان جَميعاً فرقَا",77,"ق",2,0],["عانسٌ بكرٌ وقد قلَدوها","حين درَتْ من حَبابٍ وشاحا",78,"ح",2,0],["عانقتني كأنما أنا طفل","وحبتني التدليل والتكريما",79,"م",2,0],["عانت به وبأشابه","في قربه الجاني وفي بُعده",80,"د",2,0],["عانيات لك الليالي يُعفِّي","ن بحلم آثارَ ما قد جَهلنا",81,"ن",2,0],["عانقتهُ فحييتُ ثم مضى فلو","نَشدوا قتيلَ هوًى لقلتُ لهم أنا",82,"ن",2,0],["عانقته ومن العجائب ناحلٌ","يبغي الشّفاءَ من السّقيم النّاحل",83,"ل",1,0],["عانقتُ فيها الغصن أميد أهيفاً","وقنصت فيها الظبي أغيد أعينا",84,"ن",2,0],["عاندني دهري ومن ذا الذي","أنزلهُ الدهرُ على الاقتراحْ",85,"ح",1,0],["عانَقَني وَالدُجى كَطُرَّتِهِ","حَتّى بَدا الصُبحُ مِثلَ طَلعَتِهِ",86,"ت",2,1],["عانقيني بالراحتين حنوا","واسنديني فقد قصدت الهدوا",87,"و",2,1],["عانٍ خُصورُ الغواني البيضِ تُنحِلُه","وبيضُ مَرضى الجُفونِ السودِ تَبريهِ",88,"ي",2,0],["عاني الفُؤادِ يَرى الضَلالَةَ مَغنَماً","وَيَرى الهُدى كَمَذوفِ سُمٍّ جائِفِ",89,"ف",1,0],["عانقْ مَغَانيِهمْ إِذا لَمْ تَلْقهُمْ","واقْنَعْ فَقَدَ يُجْزي عن المْاء الثرَّى",90,"ر",2,0],["عانقني حتى الصباحِ الصباحْ","وقلت من بُرَحِ الهَوى لاَ بَرَاحْ",91,"ح",1,1],["عانقْتُ منهُ الغُصْن قبل ذُبُولِهِ","وجنيتُ منه الزَّهْرَ