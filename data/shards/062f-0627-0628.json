{"poems":[[55,"أعلى الغور تعرفت الخياما","https://www.aldiwan.net/poem29816.html","الرمل"],[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[29,"أراح الحي من إرم الطراد","https://www.aldiwan.net/poem5709.html","الوافر"],[53,"دابر أوطاره إلى الذكر","https://www.aldiwan.net/poem62983.html","الطويل"],[53,"وصاحب لم يكن ليصحبه","https://www.aldiwan.net/poem65438.html","المنسرح"],[53,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[40,"أفي أثر الأظعان عينك تلمح","https://www.aldiwan.net/poem7695.html","الطويل"],[46,"داب عيني البكاء والحزن دابي","https://www.aldiwan.net/poem30320.html","الخفيف"],[71,"الله الله لا تبقوه في حلب","https://www.aldiwan.net/poem29175.html","البسيط"],[107,"اذهب حيي مذمما مشؤوما","https://www.aldiwan.net/poem44195.html","الكامل"],[52,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85580","المجتث"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62216","البسيط"],[136,"لا تلوماه في الهوى أو لوما","https://www.aldiwan.net/poem54746.html","الخفيف"],[136,"طرقتني نوار عند دكار","https://www.aldiwan.net/poem54837.html","الخفيف"],[139,"أفرح يا حنفي بأسيوط","https://www.aldiwan.net/poem48849.html","الهزج"],[186,"أيها النائح المبكر مهلا","https://www.aldiwan.net/poem67040.html","الخفيف"],[199,"لمن رسم دار كالكتاب المنمنم","https://www.aldiwan.net/poem54416.html","الطويل"],[266,"هل هوى تلك العراص","https://www.aldiwan.net/poem38247.html","مجزوء الرمل"],[266,"أظهر الروض حلاه كنوزا","https://www.aldiwan.net/poem38260.html","الخفيف"],[347,"ألق الدنيا حباب","https://www.aldiwan.net/poem55384.html","مجزوء الرمل"],[347,"أنشد الشعر وحي الشهداء","https://www.aldiwan.net/poem55389.html","الرمل"],[369,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[369,"ماذا يهيج غدوة شجني","https://www.aldiwan.net/poem60626.html","أحذ الكامل"],[369,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[438,"لمن الحمول بجدة تسري","https://www.aldiwan.net/poem12486.html","أحذ الكامل"],[438,"هذا مقام أبيك فاسم بمجده","https://www.aldiwan.net/poem12593.html","الكامل"],[445,"دأبك الهجر ودابي","https://www.aldiwan.net/poem34824.html","مجزوء الرمل"],[445,"ثنائي عليك ونعماك فينا","https://www.aldiwan.net/poem34861.html","المتقارب"],[463,"أقريش لا فلم أراك ولا يد","https://www.aldiwan.net/poem56235.html","الكامل"],[484,"سل ما لقلبي تلظى","https://www.aldiwan.net/poem37176.html","المجتث"],[534,"صدرت مخبرة عن الأمر الذي","https://www.aldiwan.net/poem37465.html","الكامل"],[563,"يا نسيم الحي عني","https://www.aldiwan.net/poem33633.html","مجزوء الرمل"],[563,"أنا كلي منك إنعام وجود","https://www.aldiwan.net/poem34607.html","الخفيف"],[568,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87011","الرمل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129546","الرمل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17070","الكامل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93138","الرمل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95559","الرمل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111809","الرمل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101038","الكامل"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144779","الخفيف"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144775","الخفيف"],[2096,"","https://poetry.dctabudhabi.ae/diwan/poem/144619","المقتضب"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177817","الخفيف"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120652","الطويل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45714","المنسرح"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45649","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93954","الخفيف"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74043","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62848","المنسرح"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104854","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110076","الخفيف"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118741","الرمل"],[3708,"","https://poetry.dctabudhabi.ae/diwan/poem/123841","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132136","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117910","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86577","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114399","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102933","الكامل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44908","الخفيف"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36451","الدوبيت"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119608","الرمل"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103268","الرمل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28650","الرمل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66212","الخفيف"],[4768,"وشوم","https://www.poetsgate.com/ViewPoem.aspx?id=213042",""],[4888,"متشاعرون","https://www.poetsgate.com/ViewPoem.aspx?id=207680",""],[5057,"يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=197233",""],[5149,"يَا أَيُّهَا المُزْجِي حَنينَ غَرَامِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=211188",""],[5274,"البردوني وعروبة اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=203259",""],[5302,"جعلت فداكا","https://www.poetsgate.com/ViewPoem.aspx?id=205728",""],[5339,"نحو المجد","https://www.poetsgate.com/ViewPoem.aspx?id=61965",""],[5431,"ليلى والذئاب....","https://www.poetsgate.com/ViewPoem.aspx?id=207188",""],[5457,"إن ضاقت الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=213335",""],[5493,". تعوي الذئاب .","https://www.poetsgate.com/ViewPoem.aspx?id=197642",""],[2110,"دع هوى سلمى واقصر عن سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=156270",""],[5691,"بيت الغرابيب","https://www.poetsgate.com/ViewPoem.aspx?id=206248",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5894,"دم يا هوى واجعل حبالك ترفد","https://www.poetsgate.com/ViewPoem.aspx?id=131417",""],[5897,"قم يا عراق","https://www.poetsgate.com/ViewPoem.aspx?id=156690",""],[5909,"دأبت طيوف العاشقين تؤزني","https://www.poetsgate.com/ViewPoem.aspx?id=210281",""],[5943,"رفقًا بها","https://www.poetsgate.com/ViewPoem.aspx?id=77907",""],[5947,"ممكن؟!!","https://www.poetsgate.com/ViewPoem.aspx?id=23331",""],[5956,"الناي بِنْتي ما لها تكرارُ","https://www.poetsgate.com/ViewPoem.aspx?id=203444",""],[6142,"حاملٌ بين جمرتي شفتيه","https://www.poetsgate.com/ViewPoem.aspx?id=155685",""],[6184,"رقصة في ازمير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78622&r=&rc=14",""],[6229,"يا خادم الحرمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82504&r=&rc=39",""]],"verses":[["دَأبُها في دارِ زَينٍ تُنتَحى","شَلَّةَ الطارِدِ بِالدَوِّ النَعاما",0,"م",2,0],["دَأَبَ شَهرَينِ ثُمَّ نِصفاً دَميكاً","بِأَريكَينِ يَكدُمانَ غَميرا",1,"ر",2,0],["دَأَبنَ اللَيلَ نَحوَكُمُ فَلَمّا","تَجَلَّت مِن أَواخِرِهِ الهَوادي",2,"د",2,0],["دابر أوطاره إلى الذِّكَرِ","وفاقدُ العين تابع الأثرِ",3,"ر",1,1],["دابرني فانصرفت عنه فأح","مدت بحمد الإله منصرفي",4,"ف",2,0],["دأبنا ذاك سائر اليوم حتى","ملأ الماء بطنها المشقوقا",5,"ق",2,0],["دأْبُهُ ذاك فحمةَ الليل حتَّى","طلعَ الفجرُ ساطعاً كالضِّرام",6,"م",1,0],["دَأَبتُ إِلى أَن يَنبُتَ الظِلُّ بَعدَما","تَقاصَرَ حَتّى كادَ في الآلِ يَمصَحُ",7,"ح",1,0],["دابُ عَيني البُكاءُ وَالحُزنُ دابي","فَاِترُكيني وُقيتِ ما بي لِما بي",8,"ب",2,1],["دأباً يذمُّ فنونَ العلم محتقراً","بها ومَنْ جَهِلَ الأشياءَ عاداها",9,"ه",2,0],["دَأبَ الإمامُ فما ترى من رَائثٍ","إنّ الإمامَ يُصَرِّفُ المأموما",10,"م",2,0],["دَأَبتُ حَتّى جِئتُهُ زائِراً","ثُمَّ تَعَنَّيتُ وَلَم أَدأَبِ",11,"ب",1,0],["دأبت تنزلها من","مقامها وهو يَعلو",12,"ل",2,0],["دَأَبْنَ شَهْرَيْنِ يَجْتَبْنَ البِلاَدَ إِذَا","كَانَ الظَّلاَمُ شَبِيهَ اللّوْنِ بِالقَارِ",13,"ر",1,0],["دأبُ ذِى الحبِّ أن يُلاَمَ ومَن لَم","يَذُقِ الحُبِّ دَأبُهُ أَن يَلُومَا",14,"م",2,0],["دَابُهَا الهَجرُ لِى وَدَابي هَوَاهَا","فَهوُ في القَلبِ مثلُ جَذَوةِ نَارِ",15,"ر",1,0],["دا بِدُّه يعرف سعادتك","إن كنتْ تسمح نادي لُهْ",16,"ه",1,0],["دَأبُهُ النَفعُ للِبرايا فَإِن لَم","يَكُ يَوماً فَدفْعُ ضُرٍّ تَولَّى",17,"ل",2,0],["دَأَبنَ لِخَيشومِ البَياضِ الَّذي لَهُ","مِنَ التاجِ إِكليلٌ كَتاجِ المُسَوَّمِ",18,"م",1,0],["دأبها الحمد ولا يد","فع طرف عن قماص",19,"ص",1,0],["دأبه أن يفوز بالفضل والمج","د وراجيه بالمنى أن يفوزا",20,"ز",2,0],["دأبه في هذه الدن","يا طنين ونهاب",21,"ب",1,0],["دأبنا هذا وذا دأبكمو","بعد الفرق وما نحن سواء",22,"ا",2,0],["دَأَبُ الوَزيرِ هَكَذا وَدابي","الشُّربُ مِن سُلافَةِ الآدابِ",23,"ب",1,0],["دَأْبي ودَأْبُ الدَّهْرِ أَنّيَ مَنْ","قاربْتُه في الوُدِّ باعَدَني",24,"ن",2,0],["دَأْبيَ الشُكْرُ ما حَيِيتُ لأنّي","ما أَعُدُّ الكُفْرانَ إلاّ كُفرا",25,"ر",2,0],["دأبَتْ على هجري فخالفَها","بالوصل طيفٌ في الدُجى يسري",26,"ر",2,0],["دأبَ البديعُ بها فسلسلَ لفظُها","راحاً تؤمّنُ شارباً من حدِّه",27,"د",2,0],["دَأْبُكَ الهَجْرُ وَدَابِي","فيكَ إِدمانُ التَّصابِي",28,"ب",2,1],["دأَبْنَ كجِدِّكَ حزماً وعزماً","وعُدْنَ كَحِلمِكَ عطْفاً ولِينا",29,"ن",2,0],["دأبا به حتى تُريحَ بيثربٍ","فتنيخَه نِقْضاً بباب المسجدِ",30,"د",1,0],["دأبي العويل الى أن","يسرني نجم سعدك",31,"ك",1,0],["دَاَبَ الزَّمانُ وأَهْلُهُ أن يَثْلُموا","مَنْ ذا يُطيقُ لِكُلِّ ثُلْمٍ يَسْدُدُ",32,"د",1,0],["دأبه التقوى بها لو","رمت توصيه تراها",33,"ا",3,0],["دأبنا حفظ المواثيق التي","هي منا أخذتها والعهود",34,"د",1,0],["دَأَبَت عَلى السَيرِ المُبَرّحِ وَالسُرى","أَجوبُ الفَيافي فَدفَداً بَعدَ فَدفَدِ",35,"د",1,0],["دَأبه المَأثور عَنهُ","دائِماً صدقُ المَقال",36,"ل",1,0],["دأبنا شم ورود وخدود","وعناق من غصون وقدود",37,"د",1,0],["دابَ النَعيمُ لَهُ فَأَثمَرَ صَدرُهُ","ثَمَراً إِذا حَلَتِ الثِمارُ حُلينا",38,"ن",2,0],["دأبه يوم النزال","نهب أرواح الرجال",39,"ل",1,0],["دأبه الدرسُ وفيه همّه","وله فى الدرس رىٌّ وقرَى",40,"ر",2,0],["دأبنا جمعُ ثراءٍ وحطام","واكتسابٌ من حلالٍ وحرام",41,"م",1,0],["دأباً على الأخلاص بين حوادث","للدهر تخترم القوى وتغول",42,"ل",1,0],["دأبه في الأنام وهو صديق","صدع شمل الأحباب من دون غدر",43,"ر",1,0],["دأبه في الورى اصطناع اياد","لبعيد يوم الندى وقريب",44,"ب",1,0],["دأبنا نبعده","والهوى يقربه",45,"ب",2,0],["دأب أهل الأداء بالشرط في التصحيح","والضبط وابتغاء التحري",46,"ر",2,0],["دأبت على ترديدِ ذِكرِ محمد","فصلى عليك الله يا فجرَ الهُدَى",47,"د",2,1],["دابة الأَرض تَخرج مِن قب","لِ خُروج الَّتي طَلَبناها",48,"ا",3,0],["دَأبَها ساعة الطَهارة دَفن العَنبر","الرَطب في الحُنوط اليَبيس",49,"س",1,0],["دأبه الفتك بالمحب دلالاً","بتجافيه والتجنب والصد",50,"د",1,0],["دابا لقوم لهم علم لهم ادب","واقنع بما فتح المولى من القسم",51,"م",1,0],["دَأَبوا فَنالوا ما اِشتَهوا","وَالمَجدُ حصَّة من دأب",52,"ب",1,0],["دَأبُ المَهارى ودأبُنا أَبداً","أَو يَتَقَطَّعْنَ خلفها عُصَبَا",53,"ب",2,0],["د ابتهاجا والإقحوان إبتساما","أخذت نوحها الحمائم عني",54,"ي",1,0],["دأبُهُ رَدُّ ما حَبا","شأَنُهُ حَلُّ ما بَرَم",55,"م",1,0],["دأبه النصب لنهب الفقرا","فحرامٌ عدّه بين البشر",56,"ر",1,0],["دأب المؤيّد أن يسل على العدى","سيفاً وحسب رقابهم أن تقطفا",57,"ف",2,0],["دأبٌ يذيب شبيبتي","لو أستفيد من الدأب",58,"ب",1,0],["دأبي شهود جماله ووظيفتي","ولعي بلؤلؤ ثغره أو عقده",59,"د",2,0],["دأب الضعيف هجاء ظالمه","يبغي نكايته ويطلبها",60,"ه",2,1],["دأباً قُلِ اللَهَ ثُمَّ ذَرهُمُ هَملا","من خوضهم يلعبون واستزد وخِمِ",61,"م",1,0],["دأبي مسامرة النجوم وإنها","نعم المسامر لو وعت لخطابي",62,"ب",2,0],["دَأبُ هَذا الصَديقِ حُبُّ التَعالي","وَالتَعالي عَلامةُ الأَوشابِ",63,"ب",1,0],["دأبي لِعَوالي الرُتَب الإِحرازُ","ما أَمكَنَني الطِلابُ لا أَنحازُ",64,"ز",1,1],["دأبهم في الحرب كرٌّ دائماً","لا مفرٌّ بل مَقَرٌّ لا محال",65,"ل",1,0],["دأبهم أن يسعدوا أوطانهم","باتحاد ووئام سائرين",66,"ن",1,0],["دَأَباً تَضرِبُني أَو أَشرَبُ ال","كَأسَ أَو تسكب في حجري بُقْ",67,"ق",1,0],["دَأْبُهُمْ ما عَلِمْتَ أَنْ يَسْتَكِينُوا","لِلدَّواهِي خُضْعَ الطُّلَى لِلأَعادِي",68,"د",2,0],["دأْبي أخيْطُ حكايتي بمآبرٍ","صدئتْ لكوني قد وُلدتُ شقيّا