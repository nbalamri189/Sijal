=34200",""],[90,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=179230",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[45,"أَمَا وَهَذَا الزَّمَانُ يَمْتَحِنُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31639",""],[18,"كُنَّا نَغَارُ عَلَى الْعَوَاتِقِ أَنْ تَرَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26470&r=&rc=36",""],[134,"لهجت بذكرك السن المداح","https://www.aldiwan.net/poem4244.html","الكامل"],[161,"مقعد صدق لمليك مقتدر","https://www.aldiwan.net/poem58936.html","الرجز"],[199,"ومسددين إلى الطعان ذوابلا","https://www.aldiwan.net/poem51973.html","الكامل"],[236,"قم بين أكسار البيوت وناد","https://www.aldiwan.net/poem32097.html","الكامل"],[283,"ومهفهف الأعطاف يشكو خصره","https://www.aldiwan.net/poem32352.html","الكامل"],[298,"لمن الكتائب في العجاج الأكدر","https://www.aldiwan.net/poem33273.html","الكامل"],[327,"حي المنابر بالسلام","https://www.aldiwan.net/poem44246.html","مجزوء الكامل"],[372,"أرأيت ما صنع القريب النائي","https://www.aldiwan.net/poem57539.html","الكامل"],[378,"سعدت نفوس بالإله الأعظم","https://www.aldiwan.net/poem59265.html","الكامل"],[378,"رب الورى في عرشه","https://www.aldiwan.net/poem66957.html","مجزوء الكامل"],[378,"أدركت شأوك فاتق الأسواء","https://www.aldiwan.net/poem66973.html","الكامل"],[381,"حر قلبي من برد ريق شهي","https://www.aldiwan.net/poem48825.html","الخفيف"],[430,"يا صاحبي من الملام دعاني","https://www.aldiwan.net/poem40502.html","الكامل"],[438,"أشفيت حر جوى ودمعك يهمل","https://www.aldiwan.net/poem2502.html","الكامل"],[440,"سر سار صنع الله حيث تسير","https://www.aldiwan.net/poem34815.html","الكامل"],[459,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[459,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[459,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[478,"عفى الزمان مرابعاوملاعبا","https://www.aldiwan.net/poem15213.html","الكامل"],[478,"قلب كما شاء التفرق موجع","https://www.aldiwan.net/poem15245.html","الكامل"],[515,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[552,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[552,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[568,"الحمد لله قد وجدت أخا","https://www.aldiwan.net/poem69721.html","المنسرح"]],"verses":[["مُتَساكِتينَ مِنَ الوُجومِ وَقَد","نَطَقَت عَلَينا الأَدمُعُ الذُرُفُ",0,"ف",1,0],["مُتَسَرْبِلِينَ هَجِيرَهَا فَإِذَا دَجَا","قَطَعُوا الدُّجُنَّةَ سُجَّداً وَقِيَامَا",1,"م",2,0],["مُتَسانِدانِ إِذا الخُطوبُ تَأَلَّبَت","مُتَعانِقانِ تَعانُقَ الأَحبابِ",2,"ب",1,0],["مُتَسَربِلي حَلَقِ الحَديدِ","تَخالُهُم فيهِ جِمالا",3,"ل",2,0],["متسابقين إلى مثابة رحمةٍ","من كلّ ما حَدَبٍ إليه تنسلُ",4,"ل",1,0],["مُتَسَلُّباتٍ في مُسو","حِ الشِعرِ أَبكاراً وَعونا",5,"ن",2,0],["متسلسل الكلمات في أوصافه","متقيداً بصنائع الإحسان",6,"ن",1,0],["مُتَسمّين بالأمانة زوراً","والمَناتينُ أخربُ الخُرَّابِ",7,"ب",1,0],["مُتَسَلِّحٌ للعين لا متزَيِّنٌ","إلا بما طبع الإله وركَّبا",8,"ب",2,0],["متسربل حلماً بطانتُهُ","عزٌّ وليس بكائن فقعه",9,"ع",2,0],["مُتَسحِّباً منكم على كرمٍ","يا آل بشر لا على حسكِ",10,"ك",1,0],["متسربِلٌ ثوبَ الشبابِ ولم يزلْ","بالحزمِ فيه وبالوقارِ تكهُّلُ",11,"ل",1,0],["مُتَسَلِّقاً جَبَلَ الحَيَاةِ الوعْرِ","كالشَّيْخِ الضَّريرْ",12,"ر",1,0],["متسلسلا بين الصبابة والصبا","مترقرقا بمسارح الأوطار",13,"ر",1,0],["مُتَسابِقينَ إِلى ثَراكَ كَأَنَّهُم","ناديكَ في عِزِّ الحَياةِ زِحاما",14,"م",2,0],["مُتَسَربِلٍ شِيَةً طَلَت أَعطافَهُ","بِدَمٍ فَما تَلقاهُ غَيرَ مُضَرَّجِ",15,"ج",1,0],["مُتَّسِعِ الصَدرِ لِلمَقالِ وَإِن","رامَ فَعالاً فَدَيِّقٌ عَطَنُه",16,"ن",2,0],["مُتَسَربِلاتٍ بِالظَلا","مِ عَلى السُهولَةِ وَالوُعورِ",17,"ر",1,0],["مُتَسَهِّلٌ في دَستِ رُتبَةِ مُلكِهِ","مُتَصَعِّبٌ مِن فَوقِ صَهوَةِ جُردِهِ",18,"د",2,0],["مُتَسَربِلاً خُلُقَ المَكارِمِ إِنَّها","جُعِلَت لِأَعراضِ الكِرامِ دُروعا",19,"ع",2,0],["مُتَساقِطي وَرَقِ الثِيابِ كَأَنَّهُم","دانوا فَأُحدِثَ فيهِم الإِحرامُ",20,"م",1,0],["مُتَسَربِلٌ بُرداً يَفوقُ بِوَشيِهِ","بَينَ المَواكِبِ حُسنَ وَشيِ بُرودِ",21,"د",1,0],["متسابقين لجر مغنمها","وَالغاية القُصوى هيَ الذَهَب",22,"ب",1,0],["مُتَسْربِلاً ثَوْبَ الهُدَى مُتواضِعاً","للّه لا صَلَفٌ ولاَ اسْتِكْبار",23,"ر",1,0],["متسربلين هجيرها فإذا دجى","قطعوا الدجنة سجدا وقياما",24,"م",2,0],["متسلسلات كلما وَجَدَتْ","فيها فراغاً ، أفَرغَتْ حَلقا",25,"ق",2,0],["مُتَسائلاً بشمَ حالَ رَيِّقُهُ","عن حُرِّ لونٍ كان يَعهَده!؟",26,"د",2,0],["مُتَسِعِ الصَّدْرِ لِلْمَقَالِ ، وإِنْ","رَامَ فَعَالاً فَضَيِّقٌ عَطَنُهْ",27,"ن",2,0],["مُتَسَلِّبَاتٍ نُكْدَهُنَّ وَقَدْ وَرَى","أجوافهنَّ بحرقة ٍ وَ رواني",28,"ن",2,0],["متسربلاً بالسعدِ متشحاً به","مستفتحاً بالواحدِ الفتاحِ",29,"ح",1,0],["متسع الأرجاءِ طاو وشيها","يقيّد اللحظ بمنظرِ نضر",30,"ر",1,0],["مُتسربلي قُمُصِ الحديدِ كأنها","غُدرانُ ماءٍ قد ملأنَ بطاحا",31,"ح",2,0],["مُتَسَربِلاً كَأَبيهِ ثَوبَي نَجدَةٍ","وَسَماحَةٍ يَومَي نَدىً وَطِرادِ",32,"د",1,0],["مُتَسَربِلٌ حُلَلَ المَحاسِنِ كُلَّها","لَكِنَّهُ عارٍ مِنَ الإِحسانِ",33,"ن",1,0],["مُتسربلٍ بالقَلب فوقَ دِلاصِه","متلثِّمٍ بالنَقع لَمّا يُسفِرِ",34,"ر",1,0],["مُتَسَربِلاتٍ بِالحَمي","مِ مُعَمَّماتٍ بِاللُغامِ",35,"م",1,0],["متساقط العبراتِ كالجمراتِ من","حَولي فواعَجبي لجمرِ الماءِ",36,"ا",2,0],["متسلِّحاً بصلاة إخوته كما","يتسلَّح الجنديْ بسيفٍ مِخذَم",37,"م",1,0],["متسلطاً متخيراً","بين الضلالة والهدى",38,"ا",1,0],["مُتَسَربِلاً بإِهابِ دَيجورِ الأَسى","مُتَلفِّعاً بمَساءَةٍ دَكناءَ",39,"ا",2,0],["مُتُّ سُكراً يا وَيح نَفسي وَلَم بَر","وَ غَليلي مِن رِيقِهِ الخَمريِ",40,"ي",1,0],["متسربلين بعفةٍ وصبابةٍ","فالوجد يغري والتقي ينهاني",41,"ن",2,0],["متسربل حلل المناقب محتب","للمكرمات فحبوة ما تحلل",42,"ل",1,0],["مُتَسَرْبِلٍ صَدَأَ الحديدِ كَأَنَّهُ","قَمَرٌ تَعَرَّضَ دونَهُ ساهُورُ",43,"ر",1,0],["متسربلاً ثوبَ الخلود وشيعُهُ","حَلْيُ القريض ودرُّه المنظومُ",44,"م",1,0],["متّسقاً سعى الإما","م نسَقاً بعد نسَقْ",45,"ق",1,0],["متسلطين على جسامِ أمورهِ","وثبَ الأسودِ على البهامِ الرُقَّعِ",46,"ع",1,0],["متسنِّماً منها ومِن أشباهِها","في الخَرْقِ أسنمةً لها وغواربا",47,"ب",2,0],["متسابقاتٌ في الفجاجِ كأنمَّا","طَفِقَتْ تُسابِقُها الرياحُ الأربَعُ",48,"ع",1,0],["متسرِّعٌ نحو الصّريخِ إذا دعا","مترفِّقٌ فيه عن الجاني وَنا",49,"ن",2,0],["متسرّعٌ للطّالبين إلى الجدا","ثَبْتُ المقامةِ في المقامِ الأهولِ",50,"ل",1,0],["مُتَسرّعينَ إِلى القِراعِ كأنّهمْ","وعليهمُ زُبَرُ الحديد حَديدُ",51,"د",1,0],["مُتَّسِعُ الكلْمِ غَيْرَ غائرِهِ","يَسْعَدُ في لُطْفِ كفِّه السَّاعِدْ",52,"د",1,0]]}