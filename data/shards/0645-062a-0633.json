tps://www.poetsgate.com/ViewPoem.aspx?id=181761",""],[5285,"نجم المجرة","https://www.poetsgate.com/ViewPoem.aspx?id=203532",""],[5431,"كلي دموعٌ بالحياء مبلله","https://www.poetsgate.com/ViewPoem.aspx?id=192732",""],[5431,"ويشق قلبي بدرها المتكور","https://www.poetsgate.com/ViewPoem.aspx?id=196923",""],[5431,"المال...رأسُ الفضائل في الدُنى هجرانُه","https://www.poetsgate.com/ViewPoem.aspx?id=199562",""],[5596,"غيث الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205673",""],[5691,"غراب صهيون","https://www.poetsgate.com/ViewPoem.aspx?id=206340",""],[5956,"السيرة الذاتية للدكتور قيسٍ الرِّضواني بالشعر الروحاني","https://www.poetsgate.com/ViewPoem.aspx?id=215553",""],[161,"إحْصَاءُ عَامِ قَدْ قَضَى بِتَمَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=176226",""],[6068,"يا ظبية عن بعدها لا أقدر -21-","https://www.poetsgate.com/ViewPoem.aspx?id=177395",""],[6213,"ما أحيلاه العناق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76271&r=&rc=28",""],[6306,"الرائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81538&r=&rc=0",""],[572,"الحمدُ للهِ قَدْ وَجَدْتُ أَخاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9238&r=&rc=95",""]],"verses":[["مُتَساكِتينَ مِنَ الوُجومِ وَقَد","نَطَقَت عَلَينا الأَدمُعُ الذُرُفُ",0,"ف",1,0],["مُتَسَرْبِلِينَ هَجِيرَهَا فَإِذَا دَجَا","قَطَعُوا الدُّجُنَّةَ سُجَّداً وَقِيَامَا",1,"م",2,0],["مُتَسانِدانِ إِذا الخُطوبُ تَأَلَّبَت","مُتَعانِقانِ تَعانُقَ الأَحبابِ",2,"ب",1,0],["مُتَسَربِلي حَلَقِ الحَديدِ","تَخالُهُم فيهِ جِمالا",3,"ل",2,0],["متسابقين إلى مثابة رحمةٍ","من كلّ ما حَدَبٍ إليه تنسلُ",4,"ل",1,0],["مُتَسَلُّباتٍ في مُسو","حِ الشِعرِ أَبكاراً وَعونا",5,"ن",2,0],["متسلسل الكلمات في أوصافه","متقيداً بصنائع الإحسان",6,"ن",1,0],["مُتَسمّين بالأمانة زوراً","والمَناتينُ أخربُ الخُرَّابِ",7,"ب",1,0],["مُتَسَلِّحٌ للعين لا متزَيِّنٌ","إلا بما طبع الإله وركَّبا",8,"ب",2,0],["متسربل حلماً بطانتُهُ","عزٌّ وليس بكائن فقعه",9,"ع",2,0],["مُتَسحِّباً منكم على كرمٍ","يا آل بشر لا على حسكِ",10,"ك",1,0],["متسربِلٌ ثوبَ الشبابِ ولم يزلْ","بالحزمِ فيه وبالوقارِ تكهُّلُ",11,"ل",1,0],["مُتَسَلِّقاً جَبَلَ الحَيَاةِ الوعْرِ","كالشَّيْخِ الضَّريرْ",12,"ر",1,0],["متسلسلا بين الصبابة والصبا","مترقرقا بمسارح الأوطار",13,"ر",1,0],["مُتَسابِقينَ إِلى ثَراكَ كَأَنَّهُم","ناديكَ في عِزِّ الحَياةِ زِحاما",14,"م",2,0],["مُتَسَربِلٍ شِيَةً طَلَت أَعطافَهُ","بِدَمٍ فَما تَلقاهُ غَيرَ مُضَرَّجِ",15,"ج",1,0],["مُتَّسِعِ الصَدرِ لِلمَقالِ وَإِن","رامَ فَعالاً فَدَيِّقٌ عَطَنُه",16,"ن",2,0],["مُتَسَربِلاتٍ بِالظَلا","مِ عَلى السُهولَةِ وَالوُعورِ",17,"ر",1,0],["مُتَسَهِّلٌ في دَستِ رُتبَةِ مُلكِهِ","مُتَصَعِّبٌ مِن فَوقِ صَهوَةِ جُردِهِ",18,"د",2,0],["مُتَسَلِّباتٍ نُكدَهُنَّ وَقَد وَرى","أَجوافَهُنَّ بِحُرقَةٍ وَرَواني",19,"ن",2,0],["مُتَسَربِلاً خُلُقَ المَكارِمِ إِنَّها","جُعِلَت لِأَعراضِ الكِرامِ دُروعا",20,"ع",2,0],["مُتَساقِطي وَرَقِ الثِيابِ كَأَنَّهُم","دانوا فَأُحدِثَ فيهِم الإِحرامُ",21,"م",1,0],["مُتَسَربِلٌ بُرداً يَفوقُ بِوَشيِهِ","بَينَ المَواكِبِ حُسنَ وَشيِ بُرودِ",22,"د",1,0],["متسابقين لجر مغنمها","وَالغاية القُصوى هيَ الذَهَب",23,"ب",1,0],["مُتَسَرْبِلاَتٍ في الحَدِيدِ تَكُفُّهَا","شَقِّيَّةٌ يُقْرَعْنَ بِالأَنْيَابِ",24,"ب",1,0],["مُتَسْربِلاً ثَوْبَ الهُدَى مُتواضِعاً","للّه لا صَلَفٌ ولاَ اسْتِكْبار",25,"ر",1,0],["متسربلين هجيرها فإذا دجى","قطعوا الدجنة سجدا وقياما",26,"م",2,0],["متسلسلات كلما وَجَدَتْ","فيها فراغاً ، أفَرغَتْ حَلقا",27,"ق",2,0],["مُتَسائلاً بشمَ حالَ رَيِّقُهُ","عن حُرِّ لونٍ كان يَعهَده!؟",28,"د",2,0],["مُتَسِعِ الصَّدْرِ لِلْمَقَالِ ، وإِنْ","رَامَ فَعَالاً فَضَيِّقٌ عَطَنُهْ",29,"ن",2,0],["متسربلاً بالسعدِ متشحاً به","مستفتحاً بالواحدِ الفتاحِ",30,"ح",1,0],["متسع الأرجاءِ طاو وشيها","يقيّد اللحظ بمنظرِ نضر",31,"ر",1,0],["مُتسربلي قُمُصِ الحديدِ كأنها","غُدرانُ ماءٍ قد ملأنَ بطاحا",32,"ح",2,0],["مُتَسَربِلاً كَأَبيهِ ثَوبَي نَجدَةٍ","وَسَماحَةٍ يَومَي نَدىً وَطِرادِ",33,"د",1,0],["مُتَسَربِلٌ حُلَلَ المَحاسِنِ كُلَّها","لَكِنَّهُ عارٍ مِنَ الإِحسانِ",34,"ن",1,0],["مُتسربلٍ بالقَلب فوقَ دِلاصِه","متلثِّمٍ بالنَقع لَمّا يُسفِرِ",35,"ر",1,0],["مُتَسَربِلاتٍ بِالحَمي","مِ مُعَمَّماتٍ بِاللُغامِ",36,"م",1,0],["متساقط العبراتِ كالجمراتِ من","حَولي فواعَجبي لجمرِ الماءِ",37,"ا",2,0],["متسلِّحاً بصلاة إخوته كما","يتسلَّح الجنديْ بسيفٍ مِخذَم",38,"م",1,0],["متسلطاً متخيراً","بين الضلالة والهدى",39,"ا",1,0],["مُتَسَربِلاً بإِهابِ دَيجورِ الأَسى","مُتَلفِّعاً بمَساءَةٍ دَكناءَ",40,"ا",2,0],["مُتُّ سُكراً يا وَيح نَفسي وَلَم بَر","وَ غَليلي مِن رِيقِهِ الخَمريِ",41,"ي",1,0],["متسربلين بعفةٍ وصبابةٍ","فالوجد يغري والتقي ينهاني",42,"ن",2,0],["متسربل حلل المناقب محتب","للمكرمات فحبوة ما تحلل",43,"ل",1,0],["مُتَسَرْبِلٍ صَدَأَ الحديدِ كَأَنَّهُ","قَمَرٌ تَعَرَّضَ دونَهُ ساهُورُ",44,"ر",1,0],["متسربلاً ثوبَ الخلود وشيعُهُ","حَلْيُ القريض ودرُّه المنظومُ",45,"م",1,0],["متّسقاً سعى الإما","م نسَقاً بعد نسَقْ",46,"ق",1,0],["متسلطين على جسامِ أمورهِ","وثبَ الأسودِ على البهامِ الرُقَّعِ",47,"ع",1,0],["متسنِّماً منها ومِن أشباهِها","في الخَرْقِ أسنمةً لها وغواربا",48,"ب",2,0],["متسابقاتٌ في الفجاجِ كأنمَّا","طَفِقَتْ تُسابِقُها الرياحُ الأربَعُ",49,"ع",1,0],["متسرِّعٌ نحو الصّريخِ إذا دعا","مترفِّقٌ فيه عن الجاني وَنا",50,"ن",2,0],["متسرّعٌ للطّالبين إلى الجدا","ثَبْتُ المقامةِ في المقامِ الأهولِ",51,"ل",1,0],["مُتَسرّعينَ إِلى القِراعِ كأنّهمْ","وعليهمُ زُبَرُ الحديد حَديدُ",52,"د",1,0],["مُتَّسِعُ الكلْمِ غَيْرَ غائرِهِ","يَسْعَدُ في لُطْفِ كفِّه السَّاعِدْ",53,"د",1,0],["مُتَسَربِلٌ مَجدَينِ مِن أبَوينِ مِن","جَدَّينِ مِن وَلَدَي عَلَّي وَفاطِمِ",54,"م",1,0],["مُتَسَربِلٌ بُردَ الخَلافَةِ حامِلٌ","ما لَيسَ يَحمِلُ ثِقلَهُ الثَّقلانِ",55,"ن",1,0],["مُتَّسِقٌ هذا وذا مُنْقَضُّ","فكلُّ ما تلحظهُ مُبيض",56,"ض",1,0],["مُتستراً والطرفُ يرنو خُلسةً","حذرَ الرقيب فلم يَفه بجواب",57,"ب",1,0],["متسع المجلس ذو حضرة","تبدي شذا الأفضل والهنجب",58,"ب",1,0],["متسنم يوم الفخا","ر سنام كل على وكاهل",59,"ل",1,0],["مُتَسربلٌ ثوبَ المفا","خرِ وَالمَحامدِ وَالحَسَب",60,"ب",1,0],["مُتسربل ثوبَ المفاخِر لابس","حُللَ الثَّنا والحلمِ والتأديبِ",61,"ب",1,0],["مُتَسَنِّمُ الأَفلاكِ بِالقَدرِ الَّذي","تَرَكَ المِثالَ عَلى صَفا الأَصلادِ",62,"د",1,0],["متسربلٍ حلل الظلام مشمرٍ","في جمعه الرزق الشتيت مطوفِ",63,"ف",1,0],["متسربلا وهو الحري","من الحرير بها ثيابا",64,"ب",2,0],["متساوين في المكارم قد فا","قوا بفضل النهى على الفتيان",65,"ن",1,0],["مُتَسَتّرٌ طولَ النَهارِ بعَرفِهِ","كي لا يُرى لنَسِيمِهِ مَسؤولا",66,"ل",2,0],["مُتَسربيلين السّابِريّ كأَنّما","جَمَدَت عليهم منه أَمْواهُ النَّهي",67,"ه",2,0],["مُتسابقون إلى العُلا فكأنهمذ","في حلبةٍ رفعت قَتاما أدهما",68,"م",2,0],["مُتسَربلٌ بجرائرٍ وجَرائمٍ","هدّت قُواهُ وكلَّ طودٍ أطوَدِ",69,"د",1,0],["متسربلين سوابغا عادية","ادفوا الملوك بكل عضب مقصل",70,"ل",1,0],["مُتَسَربِلي حَلَقِ الحَديدِ كَأَنَّهُم","جُرب مُقارِفَةُ عَنِيَّةَ مُهمَلِ",71,"ل",1,0],["متسع النادي رحيب الندى","في غمرات الزمن الضيِّق",72,"ق",1,0],["متسرعين إلى الهياج كأنهم","أسد الغريف على سواهم ضمر",73,"ر",1,0],["متسربلين على الحديد بانفس","اوحى لها الرحمن ما اوحى لها",74,"ل",3,0],["متسربل بالليل مدرع","بالآل والرمضاء ترمض",75,"ض",1,0],["مُتَسَنمٍ سَنِماتِها مُتَفجِّسٍ","بِالهَدرِ يَملأُ أَنفساً وَعيوناً",76,"ن",2,0],["متساقيين غرامنا بلحاظنا","متخاصرين كأننا غصنان",77,"ن",1,0],["متسابقين إلى الحصون كأنها","أوكارهم شيدت على الأفنان",78,"ن",1,0],["متسربلينَ بمصرَ عزَّ محمدٍ","ومجمَّلين بجاهِ ابراهيما",79,"م",2,0],["متسابقا هو والكلاب بحلبة","كل يروم بصيده أن يظفرا",80,"ر",2,0],["مُتَّسِعُ الصَدرِ مُطيقٌ لِما","يُحارُ فيهِ الحُوَّلُ القَلبُ",81,"ب",1,1],["مُتَسايرَين وَتارة مُتَخاصرَينِ","أَضُمُّهُ وَيَضُمُّني زنداهُ",82,"ا",2,0],["مُتَسانِدٍ نَفجٍ يَرُدُّ زِمامَهُ","غَربا يَرُدُّ شِراعَهُ المَعمودا",83,"د",2,0],["مُتسربل بالمُحرِقاتِ مُدجَّج","بالبُندقات فنصرُه متحقِّقُ",84,"ق",1,0],["مُتسلسلينَ إِلَى العُلى يَرِثونها","إِن المعالي بالإراثة أعْرَقُ",84,"ق",1,0],["متسوراً بأهلة متطوقاً","بالشمس أو بالبدر او بإطاره",85,"ر",2,0],["مُتسربلاً من لؤم فع","لكَ حلتى خِزىٍ وَعَارِ",86,"ر",1,0],["مُتَسَربِلٌ بِالحِلمِ في اخلاقِهِ","يَعفو لِمَن يَهفو إِلَيهِ وَيَغفِرُ",87,"ر",1,0],["متسلسل وكأنه لصفائه","دمعٌ بخدَّي كاعبٍ يتسلسل",88,"ل",1,0],["متسلطاً برئَاسةٍ","يَبغي بها ما وافَقَه",89,"ق",2,0],["مُتَسَربِلي حَلقِ الحَديدِ كَأَنَّهُم","أُسدٌ عَلى لَحقِ البُطونِ سَلاهِبِ",90,"ب",1,0],["متسابقات كالسوا","بق في مجال مستدير",91,"ر",1,0],["متسنمي قمم الرجال تسابقت","بهم سباق القب يوم طراد",92,"د",1,0],["متسردق بالخيل تحسب أنه","تحت العجاجة جنح ليل اليل",93,"ل",1,0],["متسنم من كل مجد صهوة","إن تركب الشهب السواري يركب",94,"ب",1,0],["مُتَسربِلي غدر المِياهِ مَلابِسا","مُستَنبِطي زُبرَ الحَديد قُلوبا",95,"ب",2,0],["مِتُّ سُكْراً أَفَمِنْ كأسَيْ طِلا","رَاقَ لي رِيقُكَ أَمْ مِن شَفَتَينْ",96,"ن",1,0],["مُتَسانِدين على الرّحالِ كَما اِنتَشى","شرْب أمالت هامَه قهواتُهُ",97,"ت",2,0],["متسربلاً من لؤم فع","لِك خُطّتَيْ خِزْيٍ وعارِ",98,"ر",1,0],["مُتَسَرْبِلٌ بالحزم ساعةَ تَلْتقي","حَلَقُ البِّطان على جواد الحازم",99,"م",1,0],["مُتَستّرات بِالحياء لَوابِسٌ","حُلَل العَفاف عَن الفواحِش شوسُ",100,"س",1,0],["متسنم شرفا رفيعا واطئا","هام الثريا والسهى بمناسم",101,"م",1,0],["متسقا لاح على لبة ال","أفكار من فحواه تنسيق",102,"ق",1,0],["متسلقٌ أشجارها طيشاً فإنْ","يقعِ المتيّمُ تلتقطْهُ غصونُ",103,"ن",1,0],["مُتَسَائلاً عَنّي ، وَ لستُ أدلّني","وَ أعودُ مَجهولَ الخُطى أتَعَثَّرُ",104,"ر",1,0],["متسلسل التبذير وصفه ليا نس","من مفرق الوادي تشاعق بروقه",105,"ق",2,0],["مُتَسَوِّلٌ شِعري الغَرَامَ فَهَلْ","بالصّدِّ ألقى رَدَّ أسئلتي؟",106,"ت",2,0],["متسربلٌ ثوبَ الرجاءِ ولم أزلْ","أسعى ليومٍ يُرتجى فيه الأملْ",107,"ل",1,1],["متسكع بين الخلاخل يرتمي","وغشيمة في دمعها متبللةْ",108,"ل",2,0],["متسائلا : أولا يرى ماقد أرى؟","والعشق نهرُ رائقٌ لا يكدرُ",109,"ر",1,0],["متسلقٌ ظهر الحياة بسوطه","يُلغي الوجود وينتفي إنسانُه",110,"ن",2,0],["متسنما صهواتها وكأنه","نجم سرى في حالك الظلمات",111,"ت",1,0],["مُتَسلِّطٌ والسّوءُ شيمَتُهُ","ودِماغُهُ بالجِنِّ مسْكونُ !",112,"ن",1,0],["متسقطاً أخبارَه متطَمْئناً","عنه وعن مجهوده المتفاني",113,"ن",2,0],["05- مُتَسَائِلٌ عَنْ مِيزَةٍ أَوْ شَامَةٍ","نُحِتَتْ كَرَسْمٍ عَالِقٍ ... كَوِسَامِ",114,"م",1,0],["متسامرين إلى الصباح فراعها","منها ملامسة شعاع نير",115,"ر",1,0],["متسمرا ، متوجسا ، متربصا","كيما يزول وليس في الصخر انشقاق",116,"ق",1,0],["متسلقا جثث الضحايا يرتقي","أمجاده والقبح فيه مليحُ !",117,"ح",1,0],["مُتّسعُ الكَلِمِ غيرُ ضائِرِه","يسعَدُ في لطفِ كفّه الساعِدْ",118,"د",1,0]]}