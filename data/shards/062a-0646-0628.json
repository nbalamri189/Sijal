d=37073",""],[5002,"روح الحبِّ.....","https://www.poetsgate.com/ViewPoem.aspx?id=210695",""],[5136,"خذها هنيئاً أيها الهمام","https://www.poetsgate.com/ViewPoem.aspx?id=121692",""],[5145,"رقدت ودهرك لا يرقد","https://www.poetsgate.com/ViewPoem.aspx?id=108069",""],[5185,"نبوءة الحجاب","https://www.poetsgate.com/ViewPoem.aspx?id=72852",""],[5187,"زيارة لقصر العظم","https://www.poetsgate.com/ViewPoem.aspx?id=29065",""],[5206,"حَيَاةُ المُهَج","https://www.poetsgate.com/ViewPoem.aspx?id=187392",""],[5277,"لقد وقعت الواقعة","https://www.poetsgate.com/ViewPoem.aspx?id=207028",""],[5278,"يا نذير الشؤمِ...","https://www.poetsgate.com/ViewPoem.aspx?id=202542",""],[5338,"لا تعذل العين أن أرخت عزاليها","https://www.poetsgate.com/ViewPoem.aspx?id=187832",""],[5364,"المرجلة ماهي ب خواريف واوهام","https://www.poetsgate.com/ViewPoem.aspx?id=177124",""],[5397,"ليلة ميلاد الزكي المجتبى","https://www.poetsgate.com/ViewPoem.aspx?id=157910",""],[5459,"سلعة بائرة","https://www.poetsgate.com/ViewPoem.aspx?id=211767",""],[5550,"يكون الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=211259",""],[5573,"خاتم ذهب","https://www.poetsgate.com/ViewPoem.aspx?id=200179",""],[5586,"جلل ألم على الكرام فهالا","https://www.poetsgate.com/ViewPoem.aspx?id=173782",""],[5587,"في حب الله","https://www.poetsgate.com/ViewPoem.aspx?id=196988",""],[5596,"زنجبار والشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=206692",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5652,"معك الضياغم راسية فوق منزال","https://www.poetsgate.com/ViewPoem.aspx?id=177976",""],[5690,"أهديت سفراً لنجل المصطفى حِكما","https://www.poetsgate.com/ViewPoem.aspx?id=172218",""],[5717,"إنا من الغابر نتقم السير","https://www.poetsgate.com/ViewPoem.aspx?id=170583",""],[5739,"اوّل وهالحين ..!","https://www.poetsgate.com/ViewPoem.aspx?id=128686",""],[5843,"احزان المواني","https://www.poetsgate.com/ViewPoem.aspx?id=51283",""],[5894,"ته بالجمال وطف على أوقاتي","https://www.poetsgate.com/ViewPoem.aspx?id=131412",""],[5894,"إن الفضيلة في الزمان تراد","https://www.poetsgate.com/ViewPoem.aspx?id=131439",""],[5937,"هوَ من !","https://www.poetsgate.com/ViewPoem.aspx?id=211819",""],[5939,"ظامئٌ لارتشافِكِ شِعري","https://www.poetsgate.com/ViewPoem.aspx?id=178620",""],[391,"ألاَ إنَّ هتداً أمسِ رثَّ جديدها","https://www.poetsgate.com/ViewPoem.aspx?id=4653",""],[6093,"العُيونُ جَواهرُ الأبدان","https://www.poetsgate.com/ViewPoem.aspx?id=200236",""],[6142,"مدينة العلم طه والوصي لها","https://www.poetsgate.com/ViewPoem.aspx?id=155719",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""],[6259,"ذكر الحمى فبكى لسجع حمامهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59404&r=&rc=52",""],[6288,"بستان الأدب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78521&r=&rc=34",""]],"verses":[["تنبيك قبل القضا عينٌ لفطنتهم","ما ليس بعد القضَا عيناك تنبينا",0,"ن",2,0],["تُنبيكَ نَفحَتُهُ إِذا فَغَمَت","عَن طيبِ مَغرِسِ ذَلِكَ الأَصلِ",1,"ل",1,0],["تَنبو إِذا لَم تَكُن عَنكُم ضَرائِبُنا","وَالسَيفُ أَقطَعُ شَيءٍ في يَدِ البَطَلِ",2,"ل",1,0],["تَنَبَّهْ وَنَفِّضْ غُبَّرَ النَّوْمِ فَالعُلا","بَغيضٌ إِلَيْها النّائِمُ المُتياقِظُ",3,"ظ",1,0],["تَنبُْو المَعاوِلُ عنها وهيَ قائِمَةٌ","والهادِمُون كثيرٌ في نواحيها",4,"ي",3,0],["تُنبِطُهُ الساقُ بِشَدٍّ كَما","مالَ هَجيرُ الرَجُلِ الأَعسَرِ",5,"ر",1,0],["تنبو جُنوبك عن فراش ناعم","فكأن مَضجعك الدَميث قضيض",6,"ض",1,0],["تنبه بعد رقدته نزار","لهم بالملحفات معاندينا",7,"ن",2,0],["تَنَبَّهَ بَعدَ نومَتِهِ نِزَارٌ","لهم باِلمُلحِقَاتِ مُعَانِدينَا",8,"ن",2,0],["تنبه في الأمر المهمّ يراعه","فأغنى ونامت في الجفون القواضب",9,"ب",1,0],["تنبه لما أن رأى شبيه فجرا","فنزَّه عن عاداته الشّعر الشّعرا",10,"ر",2,1],["تنبَّهوا عن كَراهم بعد أن حَلَموا","بحِلْم سوءٍ مليءٍ بالذي يَعِدُ",11,"د",1,0],["تنبّه للأرذالِ يرفع أمرهم","فأصبح عن أهلِ المروءةِ ساهيا",12,"ي",2,0],["تَنَبَّه أَيُّها الراعي تَنَبَّه","فَمَن حَفِظَ الوَرى حَفِظَ العِبادا",13,"د",2,0],["تَنَبَّهَ فيها وَفِيَّ الهَوى","فَلَو نَعيسَ النَجمُ لَم نَنعَسِ",14,"س",1,0],["تُنبيك عن كدري وعن صفوي بما","تبديه من ظُلمَ ومن أنوار",15,"ر",1,0],["تَنبَري في زَرَقِ الأُفقِ كَما","سَبَحَ الحوتُ بِدَأماءٍ وَعاما",16,"م",2,0],["تُنبِئُ عَن عِزٍّ وَعَن صَولَةٍ","وَعَن هَوىً لِلدينِ لَم يَخمُدِ",17,"د",1,0],["تنبَّهَت بيَ طولَ الليلِ ناحِلَةٌ","صفراءُ أفنَى قُواهَا الدمعُ والأرقُ",18,"ق",1,1],["تُنبي طَلاقَةُ بِشرِهِ عَن جودِهِ","فَتَكادُ تَلقى النُجحَ قَبلَ لِقائِهِ",19,"ا",3,0],["تُنَبِّئُنا الدُنيا بِفَرطِ هَوانِها","عَلى اللَهِ في أَضعافِ تِلكَ المَواكِبِ",20,"ب",1,0],["تُنبيكُمُ أَنّي عَلى عَهدٍ لَكُم","وَاللَهُ يَشهَدُ لي بِصِدقِ مَقالِ",21,"ل",1,0],["تُنبي الطَّلاقَةُ في مَتْنَيْهِ ظاهِرَةً","عَنِ القُطوبِ الذي ما زالَ مُكتَتَما",22,"م",2,0],["تَنبِذُ أَفلائَها في كُلِّ مَنزِلَةٍ","تَنتِخُ أَعيُنَها العِقبانُ وَالرَخَمُ",23,"م",1,0],["تَنَبَّهوا فَالغُصونُ سَكرى","إِذا ثَنَتها الصَبا تَلَوَّت",24,"ت",1,0],["تَنَبَّأَ فيكَ قَلبي فَاِستَرابَت","بِهِ قَومٌ وَعَمَّهُمُ الضَلالُ",25,"ل",1,1],["تَنَبَّهَ لي وَالعِزُّ عَنِّيَ راقِدٌ","وَقامَ بِنَصري وَالأَنامُ قُعودُ",26,"د",1,0],["تُنَبّهُ مُطْرِقَةً في الحجور","تُغْري الأَكفّ بشقّ الجيوبِ",27,"ب",1,0],["تُنبِئكَ أَنِّيَ لا هَيّابَةٌ وَرِعٌ","عَنِ الخُطوبِ وَلا جَثّامَةٌ حَرَضُ",28,"ض",1,0],["تَنَبَّهَت لِبَني نَبهانَ يَومَ ثَوى","يَدُ الزَمانِ فَعاثَت فيهِمُ وَفَمُه",29,"م",2,0],["تَنبونَ عَنهُ وَتُعطَونَ القِيادَ إِذا","كَلبٌ عَوى وَسطَكُم مِن أَكلُبِ العَجَمِ",30,"م",1,0],["تنبيكَ حروفُ حمصَ صدقاً وسدادْ","إذْ منْ سورِ القرآنِ حم وص",31,"ص",1,0],["تُنَبِّهُ مِن لَوعَاتِها وَهيَ هُجَّدٌ","وَتَبعَثُ مِن رَوعَاتِها وَهيَ هُمَّدُ",32,"د",1,0],["تَنبَّهتِ القواضِبُ والعَوالي","بأيدِي الفاتِحينَ وهُمْ نِيامُ",33,"م",1,0],["تَنبو المَضاجِعُ عَنهُ فىِ الدُجى سَهَراً","لِيَطمَئِنَّ بِجَنبِ الدينِ مَضجِعُهُ",34,"ع",2,0],["تنبذون الأَوطان في طَلَب المَن","صب وَالدين وَالهُدى وَالرَشادا",35,"د",2,0],["تُنبيك أجنحةٌ تصف","فق كيف كان سرورهنَّه",36,"ن",2,0],["تَنبو يَداهُ إِذا ما قَلَّ ناصِرُهُ","وَتأنَفُ الضيمَ إِن أَثرى لَهُ عَضُدُ",37,"د",1,0],["تَنْبُو عقولُ الخَلْقِ عن إدراكِهِ","وتكِلُّ عنهُ صَحائحُ الأذهانِ",38,"ن",1,0],["تنبّأ المتنَبّي فيكُمُ عُصُرا","ولو رأى رأيكم في شعِره كفَرا",39,"ر",2,1],["تَنبو سنابكُهُنَّ عن عَفْر الثَّرى","فيطَأنَ في خدِّ العزيزِ الأصعر",40,"ر",1,0],["تَنَبَّه فَأَنتَ عَلى غِرَّةٍ","إِخالُكَ مُستَيقِظاً هاجِدا",41,"د",2,0],["تنبهت الأذهان غبّ هجوعها","وَقَد حدثت بعد الأمور أُمور",42,"ر",1,0],["تُنبي المَواقِفُ عَنهُ أَنَّهُ سَنَدٌ","وَيُخبِرُ الرَوعُ عَنهُ أَنَّهُ بَطَلُ",43,"ل",1,0],["تَنَبَأ داوُدٌ بِرَمّ دَرِيسِها","فجاء بآيٍ لم تُشَرَّفْ بإنْزال",44,"ل",1,0],["تنبآ فلقيا نجاحا","واتبعتْ طائفةٌ سجاحا",45,"ح",2,0],["تنبو العيون اليوم عنه جيفهْ","وأمسِ كان نورُها خليفه",46,"ه",1,0],["تُنْبِئْكَ أَلْسِنَةُ الصُّمُوتِ بِمَا جَرَى","في الدَّهْرِ مِنْ عَدَمٍ ومِنْ إِيْجَادِ",47,"د",1,0],["تَنَبَّهَتْ بَاكِراً وَكَانَتْ","مِنْ قَبْلُ لَمْ تَأْلَفِ ابْتكَارْ",48,"ر",1,0],["تنبري الريشة والأوتار","والحبُّ النغم",49,"م",1,0],["تنبِتُ الحسن على ألوانه","وتقيهِ من مروءات بتُرس",50,"س",1,0],["تنبتُ مِن أَدمُعي الرُبى بَل","تَحتَرِقُ الأَرضُ وَالنَباتُ",51,"ت",1,0],["تنبَّهَ بعد الرُّقَاد أُناسٌ","تقلَّدَهم دهرُهم مدْبرَا",52,"ر",2,0],["تنبه سميري نسأل البرق سقََيَهُ","لربع عفته شمأل ودبورُ",53,"ر",1,0],["تنبيك عن قدم في العرب راسخة","والطرف يعرف منه العتق إن صهلا",54,"ل",2,0],["تنبئنا الدنيا بفرط هوانها","على الله في أضعاف تلك الكواكب",55,"ب",1,0],["تنبّه فيها وفيّ الهوى","فلو نعس النجم لم ننعس",56,"س",1,0],["تنبيكُ وتستنيكُ وما لهذا","وهذا إذ جمعتهما دواء",57,"ا",2,0],["تُنْبيكَ أَجْنِحَةٌ تُصَفِّقُ","كَيْفَ كَانَ سُرُورُهُنَّهْ",58,"ن",2,0],["تنبع آثار الزمان نوازلٌ","يموت ويحيى إثرهن يقين",59,"ن",1,0],["تنبيك إني لم أشح عن خطتي","سنتاً وأن الحب ملء إهابي",60,"ب",2,0],["تَنَبَّه مِن مِنَامِكَ هِجتَ صِلاًّ","تُنُوذِرَ في المَوَاسِمِ والمَوَامِى",61,"م",2,0],["تَنَبَه مِن مَنامِك قَد أصِبنَا","وغَرَّتنا أقَاوِيل الأنَامِ",62,"م",1,0],["تنبهتُ من نوم البطالة حائراً","أمدُّ إلى من مد جانبي اليدا",63,"د",2,0],["تَنَبِّهُنا بَعضاً بِبَعضٍ فَنَنثَني","وَأَجفانُنا في غَفلةِ اللَهو نوَّمُ",64,"م",1,0],["تَنَبَهوا وَاستَفيقوا أَيُّها العَرَب","فَقَد طَمى الخَطبُ حَتّى غاصَتِ الرُّكَبُ",65,"ب",1,1],["تُنْبِيك نَكْهَتُه بأنّ رُضابَه","خمرٌ يَشوب المِسْكَ حين تَضوَّعا",66,"ع",2,0],["تنبّه أيّها","وصمّم إن طول النوم عار",67,"ر",1,1],["تَنبّأ قبلَ آدمَ وهو ختمٌ","فَيا للَّه ختمٌ جاء قبلا",68,"ل",2,0],["تُنبيكَ عن إعجابها","بجَمالِ ذوقي واختياري",69,"ر",2,0],["تنبأ بالحسن في فترة","فآمنت لما تجلَّى علي",70,"ي",1,0],["تُنبِيك عن أفعاله أعضاؤه","حُسْنا وعن أخراه عِتقُ الأوّلِ",71,"ل",1,0],["تُنَبّي بأَنّي ماجِدٌ ذو حَفيظَةٍ","أَخو القَومِ جَوّابُ الفَلاةِ شَمردَلُ",72,"ل",1,0],["تنبهوا يا رقود","إِلى مَتى ذا الجمود",73,"د",1,1],["تنبه هداك الله من نوم غفلة","ولهو ولا تعمل على الشك والوهم",74,"م",1,0],["تنبئك ثرثرة القطيع بأنّه","ضاقت عليه منافذ الصحراء",75,"ا",2,0],["تَنَبَّه لِلخَليل وَلَو جَليلاً","وَخُذ حذراً وَكُن فَطناً نَبيلا",76,"ل",2,1],["تَنبّأَ فَضلاً حينَ أَوحَت لَهُ النُهى","خُذِ العَفوَ وَأمر بِالكَرامة وَالعُرفِ",77,"ف",1,0],["تنبيكَ أَخبار فَضل عَن وَقائعه ال","لاتي بِها الدَهر صدقاً طالَما حَلَفا",78,"ف",2,0],["تنبّه ترَ الدُنيا بِمَجد مُحَمّد","سُروراً بَدَت لِلعالَمين عَجائبُه",79,"ب",2,0],["تَنبَّهَ عند رؤيتهِ زمانٌ","وقِدْماً خاط جفنَيْهِ فَناما",80,"م",2,0],["تُنبيكَ شِدَّةُ بأسِهِ ومِراسِهِ","أنَّ الفُحولَ من الرِّجالِ أعاجِمُ",81,"م",1,0],["تنبه دهري من عهود معاهدي","فأسعدني تذكار تلك المعاهدِ",82,"د",1,1],["تَنَبَّعَ مِن أَعطافِها وَجُلودِها","حَميمٌ وَآضَت كَالحَماليجِ قودُها",83,"د",3,0],["تنبّهَ حظّي بعدَ طولِ مَنامِ","بخَيْرِ مليكٍ وابن خير إمامِ",84,"م",1,1],["تنبَّهْ ويكَ مِنْ سنةِ التّجافي","ولا تغفل فقد جاء النَّذيرُ",85,"ر",1,0],["تنَبهْ إنّ عمرَكَ قد تَقَضَّى","فَعَدِّ وعُدّ نَفسَك في الهَوالِكْ",86,"ك",1,0],["تَنبو الصَفائِح عَن صَحائِف كُتبِهِ","وَتقلّم الأَقلام من أَقلامِهِ",87,"م",2,0],["تنبيك عن حب سماعيّ الهوى","متجاوز حدّ القياس لدى الورى",88,"ر",2,0],["تنبيكم عن مغرم دنف الهوى","في حبكم بالسمع قبل يسيم",89,"م",1,0],["تنبعِثُ الأَمواهُ منه إِلى","خَوَرْنِقٍ أَبيضَ قد جُعِّدا",90,"د",2,0],["تنبّهْ يا نؤومُ فلستَ تدري","عليك بما الذي سبقَ القضاءُ",91,"ا",2,0],["تَنْبُو الدِّيارُ بِهِمْ وَتِلْكَ ديارُهُمْ","غَرَضُ المصائِبِ مَا بِهَا دَيَّارُ",92,"ر",1,0],["تَنبهتْ في الروابي نَسْمةُ الفَلَقِ","تزجي تباشيره من جانب الأفقِ",93,"ق",1,1],["تنبو وأنتَ غِرارُ سيفي في يدي","ويقصِّر ابنُكَ وهو لَهذمُ ذابلي",94,"ل",2,0],["تنبِذني في حبّكم نواظرٌ","وألسنٌ مَنبَذَةَ النِّضوِ المُعَرّْ",95,"ر",1,0],["تَنَبَّه من هاجعاتِ الرياحِ","فدلَّ عليكم نَسيمٌ عطيرُ",96,"ر",1,0],["تنبَّهَ مشروفاً بغلطةِ دهرهِ","وبِنتَ بمجدٍ أنتَ فيهِ نسيبُ",97,"ب",1,0],["تنْبو الظُّبى والقَنا حيناً وآوِنَةً","والصاحب الصدر ماضي العزم قصَّال",98,"ل",1,1],["تنْبو سِهامُ الخطْبِ طائشَةً","عنها إذا ما صَرَّحَ الجَلَلُ",99,"ل",1,0],["تَنْبُو سِهامُ الرَّزايا عَنْ سَوابِغِه","إذا رُشِقْنَ وتَخْزى دونَهُ ثُعَلُ",100,"ل",1,0],["تنبه من منامك أو فهوّمْ","فليس العيش إلاّ كالمنامِ",101,"م",1,1],["تنبئك عن أحديّة التنزيه في","صبح التكاثر مستوى الرحمان",102,"ن",1,0],["تنبي حقاً لكلِّ ذي معرفة","أن الأكوان كلها أعراض",103,"ض",1,0],["تنبهت العوامُّ الغرُّ لما","رأوا قولي وأنتم في رقود",104,"د",1,0],["تنبه يا مريد الحق وافتح","عيونك ما بنو الدنيا سواء",105,"ا",2,0],["تَنَبَّهْ قد بدى شمسُ العُقَارْ","وَقدْ غلبَ الشعاعُ على النهارْ",106,"ر",1,1],["تنَّبهوا يا عِبادَ الله واعتبروا","فالموتُ بالبابِ والأرواحُ تنتظرُ",107,"ر",1,1],["تُنْبِيْكَ عَنْ طالِعِ الأبْرَاجِ هَيْئَتُهُ","بالشَّمْسِ طَوْراً وَطَوْراً بالمَصَابيْحِ",108,"ح",1,0],["تُنبي لواقيس الهنا ومدافع ال","بشرى بان على الورى ان يجذلوا",109,"ل",3,0],["تنبىء فعالك إنك الشبل الذي","قد جاء من أسد يروّع جحفلا",110,"ل",2,0],["تَنَبَّهتِ العيون النرجسيَّه","على نَغَمِ البلابلِ في العشيَّه",111,"ي",2,1],["تنبه من نعاسك لا تطله","فقد أفرطت في طول النعاس",112,"س",1,1],["تنبَّأتُ بالعقبى التي لك فضلها","وجاءتك مني بالغيوب القصائد",113,"د",1,0],["تَنبعُ الخمرُ وَهيَ تَجري بِكَأسٍ","قَد حَكاها الياقوتُ وَالعقيانُ",114,"ن",1,0],["تُنْبيكَ عن أفْعالِه أخلاقُه","كالمسكِ يُعْرَفُ طيِّبَ النفحات",115,"ت",1,0],["تنبت الأرض ألف ألف من الأعي","ن ذات البطون والأشداق",116,"ق",1,0],["تُنَبِّئهُمْ عَنْ فَرْطِ حُزْني وَعَنْ ثُكْلي","أَيَا سَائ