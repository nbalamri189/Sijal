{"poems":[[79,"هنيئا لمن حث الركائب في بدر","https://www.aldiwan.net/poem36494.html","الطويل"],[75,"خليلي لا فطر يسر ولا أضحى","https://www.aldiwan.net/poem11843.html","الطويل"],[75,"أتتك بلون المحب الخجل","https://www.aldiwan.net/poem11968.html","المتقارب"],[93,"رسم تعلم منه ناظري الولعا","https://www.aldiwan.net/poem8981.html","عموديه"],[94,"ضحكنا على الماضي البعيد وفي غد","https://www.aldiwan.net/poem38963.html","الطويل"],[60,"يمثل ذو العقل في نفسه","https://www.aldiwan.net/poem30916.html","المتقارب"],[83,"أما لك في أمري إلى العدل مصرف","https://www.aldiwan.net/poem61456.html","الطويل"],[83,"يمثل لي نهج الصراط بوعده","https://www.aldiwan.net/poem61533.html","الطويل"],[108,"شبح الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=179421",""],[92,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[93,"رسم سياسي","https://www.poetsgate.com/ViewPoem.aspx?id=53140",""],[113,"تناهى عنده الأمل","https://www.aldiwan.net/poem16299.html","مجزوء الوافر"],[147,"تخلف عنه الصبر فيمن تخلفا","https://www.aldiwan.net/poem11783.html","الطويل"],[164,"حكم مضى وقضاء لا نغالبه","https://www.aldiwan.net/poem58710.html","الطويل"],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[203,"ألا لا تلمه اليوم أن يتألما","https://www.aldiwan.net/poem45633.html","الطويل"],[208,"رحلت وما شوقي عن الإلف راحل","https://www.aldiwan.net/poem53189.html","الطويل"],[214,"ألا بالحمى إن جزت يا راكب الوجنا","https://www.aldiwan.net/poem13296.html","الطويل"],[237,"على دمع عيني من فراقك ناظر","https://www.aldiwan.net/poem14703.html","الطويل"],[257,"أبى جلد أن أحمل البين والقلى","https://www.aldiwan.net/poem1415.html",""],[309,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[343,"يمثل ذو اللب في نفسه","https://www.aldiwan.net/poem68652.html","المتقارب"],[354,"بسكري صحوي في هوى من أحبه","https://www.aldiwan.net/poem15505.html","الطويل"],[354,"يمثل هوى قلبي يليق التبهرج","https://www.aldiwan.net/poem15556.html","الطويل"],[376,"وضمرت قلبي حين أضمرت عذره","https://www.aldiwan.net/poem57278.html","الطويل"],[408,"نعم هذه حزوى وتلك زرود","https://www.aldiwan.net/poem46908.html","الطويل"],[438,"غناء حمام في معاطف بان","https://www.aldiwan.net/poem12392.html","الطويل"],[463,"من العار لولا أن طيفك يطرق","https://www.aldiwan.net/poem56098.html","الطويل"],[463,"أشاقك من حسناء وهنا طروقها","https://www.aldiwan.net/poem56101.html","الطويل"],[519,"تصاحى وهو مخمور الجنان","https://www.aldiwan.net/poem20821.html","الوافر"],[567,"آس العذار على خديه قد كتبا","https://www.aldiwan.net/poem52882.html","البسيط"],[667,"","https://poetry.dctabudhabi.ae/diwan/poem/105538","الرجز"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107219","الطويل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121082","الطويل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/74019","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109030","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79972","المتقارب"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/109007","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108536","المتقارب"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101923","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52073","الطويل"],[1924,"","https://poetry.dctabudhabi.ae/diwan/poem/102026","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53069","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104956","الطويل"],[2371,"","https://poetry.dctabudhabi.ae/diwan/poem/142604","الهزج"],[2405,"","https://poetry.dctabudhabi.ae/diwan/poem/27108","الطويل"],[2537,"","https://poetry.dctabudhabi.ae/diwan/poem/132206","الطويل"],[2705,"","https://poetry.dctabudhabi.ae/diwan/poem/128657","المتقارب"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100325","الطويل"],[2922,"","https://poetry.dctabudhabi.ae/diwan/poem/105335","الطويل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109843","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201689","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200014","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103458","الرجز"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107064","الوافر"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140010","الطويل"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105570","الوافر"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143827","الطويل"],[4859,"ما أقبح الشوق!","https://www.poetsgate.com/ViewPoem.aspx?id=196584",""],[585,"سل الدهر ما للدهر بالرزء يفجع","https://www.poetsgate.com/ViewPoem.aspx?id=161944",""],[5183,"حفظ الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=180286",""],[5183,"من قصص الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=180277",""],[5183,"هو العيد","https://www.poetsgate.com/ViewPoem.aspx?id=180231",""],[5183,"من وحي تونس","https://www.poetsgate.com/ViewPoem.aspx?id=180207",""],[5200,"يحاذر من هويت من الرقيب","https://www.poetsgate.com/ViewPoem.aspx?id=200802",""],[5409,"تهللت كالعارض الباكر","https://www.poetsgate.com/ViewPoem.aspx?id=155493",""],[5470,"خضاب القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=10979",""],[5690,"لحسن رأيك باتت تخضع الفكرُ","https://www.poetsgate.com/ViewPoem.aspx?id=172163",""],[5975,"رواحٌ من الإيمان..","https://www.poetsgate.com/ViewPoem.aspx?id=58782",""]],"verses":[["يمثِّلُ منْهُ البدْرُ والنّجْمُ والدُّجى","مِثالاً لعَيْني أو خَيالاً الى فِكْري",0,"ر",2,0],["يُمَثِّلُ قُرطَيها لِيَ الوَهمُ جَهرَةً","فَقُبَّتَها فَالكَوكَبَ الرَحبَ فَالسَطحا",1,"ح",2,0],["يُمَثِّلُ مَلمَسُها لِلأَكُفِّ","لينَ زَمانِكَ أَو يَمتَثِل",2,"ل",1,0],["يَمثِلُ البيضَ حَولَ الصين قَد وَقَفوا","وَذَلِكَ الدُبُّ في مَنشوريا رَتَعا",3,"ع",2,0],["يمثِّلها الأَحياءُ في مَسْرَحِ الأَسَى","ووسْط ضَبَابِ الهمِّ تَمْثيلَ أَمواتِ",4,"ت",1,0],["يُمَثِّلُ ذو العَقلِ في نَفسِهِ","مَصائِبهُ قَبلَ أَن تَنزِلا",5,"ل",2,1],["يُمَثَّلُ لي في كُلِّ شَيءٍ رَأَيتُهُ","وَإِن سَأَلوا جاوَبتُهُم بِاِسمِهِ عُرفا",6,"ف",2,0],["يُمَثِّلُ لي نَهجَ الصِراطِ بِوَعدِهِ","رَشاً جَنَةُ الفِردَوسِ في طَيِّ بُردِهِ",7,"د",2,1],["يُمثَّل بالإِنسان فيها وربما","أقام قريرَ العين في ظلها الكلب",8,"ب",1,0],["يمثل شعباً يستعدُّ لنهضةٍ","يُرَدُّ عليها مجدُهُ المتقادم",9,"م",1,0],["يمثل البيض حول الصّين قد وقفوا","وذاك الدّب في (منشوريا)رتعا",10,"ع",2,0],["يَمثل ما يَروّقهُ","بِصَفحة خَدِهِ الخَجَل",11,"ل",1,0],["يُمَثِّلُ لي طَيفاً تَجَنَّبَ في الكَرى","فَلَمّا جَفاني الغُمضُ أَرضى وَأَسعَفا",12,"ف",2,0],["يمثل الفكر لي من شخصها مثلاً","حتى يخيل لي أنى أخاطبهُ",13,"ب",2,0],["يمثل رب العرش بالفكر جاهل","تحكم فيه ذو نفاق مذبذب",14,"ب",1,0],["يمثلهم في قلبهِ كلُّ لاعجٍ","وترمي بهِ ذكراهم كل مرتمى",15,"م",2,0],["يُمثِّل لي قلبي على البعد شخصَه","فتمثاله لي حيثُ ما كنتُ ماثلُ",16,"ل",1,0],["يمثلهم انسان عيني صورة","وقلبي وان بانوا يشاهدهم معنى",17,"ن",2,0],["يُمَثِّلُكَ الشَوقُ الشَديدُ لِناظِري","فأطرِقُ إِجلالاً كَأَنَّك حاضِرُ",18,"ر",1,0],["يمثِّلهُ ظَبيُ الكِناسِ مُشابِهاً","وَيُشبِهُهُ بَدرُ التَمامِ مُمَثّلا",19,"ل",2,0],["يمثلها فكري فاهتز نحوها","بوجد لطيف أريحي وقاهر",20,"ر",1,0],["يُمَثِّلُ ذو اللُبِّ في نَفسِهِ","مَصائِبَهُ قَبلَ أَن تَنزِلا",21,"ل",2,1],["يُمَثِّلُهُ في المَنامِ خَيالُهُ","وَفي قِسمَتي قَد عَزَّ في المِثلِ ضَربُهُ",22,"ه",1,0],["يمِثلِ هَوى قَلبي يَليقُ التَبَهرُجُ","وَفي رَوضِ خَدَّيهِ يَروقُ التَفَرُّجُ",23,"ج",1,1],["يُمثَّل لي أن الكَنائِسَ كلَّها","كِناسٌ إِذا مُثِّلتَ فيها مُشرِّقا",24,"ق",2,0],["يمثّلهم شوقي لِعَيني وبينَنَا","جبالٌ عوالٍ أو مهامهُ بيدُ",25,"د",1,0],["يُمَثِّلُهُ فَرْطُ الغرامِ لناظِرِي","وإِنْ نَزَحَتْ دارٌ بكُلِّ مكانِ",26,"ن",1,0],["يمثِّل من خنساء غَيْرَى بأن ترى","سوى وجهها شمساً على الأرض تُشرِقُ",27,"ق",1,0],["يمثّل حسناء الخيالُ لمغرمٍ","حبيبٍ إليه زُورها وحقيقُها",28,"ق",3,0],["يمثّلها الخيالُ خيال طَرفي","فأُبصرُها وتُحجَبُ عن عِياني",29,"ن",2,0],["يمثِّلُ الوهمُ هاتيكَ الديارَ لنا","حتى كأنَّا وَرَدْنا نيلَها العَذِبا",30,"ب",2,0],["يمثلها أدرك كل مأرب","وأوقف النفس على مأمولها",31,"ل",3,0],["يُمَثِّلُكُم فِكرِي حضوراً أَراكُمُ","وَقَد رُفِعَت دُونِي وَدُونكُم الحُجبُ",32,"ب",1,0],["يمثلكم لي طولُ شوقي إليكم","ويدنيكمُ حتى أناجيكمُ سرا",33,"ر",2,0],["يمثله قلبي على البعد حاضراً","فيشتاقه طرفي وقلبي له مثوى",34,"و",2,0],["يمثلُ لي حتى يجسَّم في فكري","ويعظم بي حتى يضيقُ بهِ صدري",35,"ر",2,1],["يمثله الشوقُ في ناظري","فأنظرُ منه المحيَّا الأغرَّا",36,"ر",2,0],["يُمثِّلُ البارق العلويُّ ثغرَك لي","فيقلب المدمعَ الدريَّ مرجانا",37,"ن",2,0],["يمثلها الطوق تركيةً","وينسبها حجلها للعرب",38,"ب",1,0],["يمثلكم قلبي على القرب والنوى","غداة تجلى شخص إنسانكم فيه",39,"ه",1,1],["يُمَثَّلُ لِي مِنهَا بِكلّ ثَنِيةٍ","خَيالٌ إذا غَمَّضْتُ أبصَرتُهُ حولِي",40,"ل",2,0],["يمثلك الشوق الملح فانثني","على مثل وقد الجمر أو فجأة الحتف",41,"ف",1,0],["يمثله قلبي لطرفي صبابة","وتبصره الأشواق والربع نازح",42,"ح",1,0],["يمثِّلُكَ الشوق المُبَرِّحُ والفكرُ","فلا حُجُبٌ تخفيك عني ولا سترُ",43,"ر",1,1],["يمثل كبرياء الحب","ويخفي الشوق والغيره",44,"ر",2,1],["يُمَثِّلُها ذو حاجَةٍ عَرَضَت لَهُ","كَئيبٌ يُؤَسّى بَينَ قَرنَةَ وَالفِهرِ",45,"ر",1,0],["يمثل قوما أو يصور حالة","فيبعث حزنا أو يضيء سرورا",46,"ر",2,0],["يمثل شعبا جاهلا ضل سعيه","وشعبا عليما بالرقي بصيرا",46,"ر",2,0],["يُمثلها الفِكرُ عن أدبٍ","أزاهِرَ رَوضٍ لألطافِها",47,"ف",3,0],["يمثل لي قرطاه تمثال دميةٍ","ترّقص دون الفرع قرطاً مروعا",48,"ع",2,0],["يمثلها شوقي لعيني وان تكن","تناءت عياناً عن دياري ديارها",49,"ر",3,0],["يمثل الوهم لي لقياك دانية","حتى لاحسبها صدقاً من الطرب",50,"ب",1,0],["يمثّل شعري شرعه وكتابه","كتابي وآياتي بأبياتي الغر",51,"ر",1,0],["يمثّل منك الرسم جزءاً محبّباً","ومن يقتني جزءاً ولا يطلب الكلاّ",52,"ل",2,0],["يمثُلُ كالليثِ أَوانَ زأرِهِ","مُستَوضحاً كطالبٍ بِثارِهِ",53,"ر",2,0],["يمثل كل شعب تائبوه","كراماً قد تحلوا بالإباء",54,"ا",2,0],["يُمثّل لي في كلِّ شيءِ فلا أرى","سواه كأن الشيءَ أصبح لاشيّا",55,"ي",2,0],["يمثلك الهوى حتى كأني","أشاهد حر وجهك في حيالي",56,"ل",2,0],["يمثّل ديناً بين قلبي وناظري","فلست أرى شيئاً سواه ولا أرى",57,"ر",2,0],["يمثّلُ الشوقَ لايدري بخيبتهِ","ما اقبحَ الشوق ممّن عاثَ بالصّفوِ",58,"و",1,1],["يمثلكم في رقعةٍ من بلادكم","كما اختلف الثوب القديم المرقع",59,"ع",1,0],["يمثل دور ذي جاه خطير","ويمشي في التواضع كالغلام",60,"م",1,0],["يمثل دور رب البيت فيه","ويملأه فنوناً من زحام",60,"م",1,0],["يمثل دور حيبين في","تلاقيهما والهوى يمرح",61,"ح",1,0],["يمثله قلبي وإن غاب شخصه","وألمسه في الروح وهي خِباؤه",62,"ا",3,0],["يمثلني فيهم وإن غبت عنهم","ويغدو بأشواقي وهن كلوم",63,"م",1,0],["يمثله الهوى حتى كأنى","أناجيه بقلبي من قريب",64,"ب",1,0],["يمثل يومك لما وثب","ت به وثبة الأسد الخادر",65,"ر",1,0],["يُمَثِّلُهَا حَتَّى يَكَادُ يَضُمَّهَا","وَيَنسُجُ من لَحظَاتِهِ حُلمَ لُقيَاهَا",66,"ا",3,0],["يمثل ذاتك أضحى العصر مفتخراً","أنت الضياءُ لهُ والغوث والوطرُ",67,"ر",1,0],["يمثّلُكَ العشقُ الدفينُ بداخلي","خيالاً وأرجوْ أن يمرَّ هوىً وَهْنا",68,"ن",2,0]]}