],[5605,"هذي المدينة","https://www.poetsgate.com/ViewPoem.aspx?id=159788",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5695,"من المؤمنين رجال..","https://www.poetsgate.com/ViewPoem.aspx?id=212540",""],[5739,"الشريط ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127064",""],[5764,"تيه","https://www.poetsgate.com/ViewPoem.aspx?id=192428",""],[5781,"شفاهٌ عُرْضَةٌ للدفء","https://www.poetsgate.com/ViewPoem.aspx?id=202841",""],[5861,"لغز العيون","https://www.poetsgate.com/ViewPoem.aspx?id=190728",""],[5865,"جزعاً نذوب","https://www.poetsgate.com/ViewPoem.aspx?id=179882",""],[5933,"قال النبي مقالةً","https://www.poetsgate.com/ViewPoem.aspx?id=40707",""],[6023,"والعمر ما عمّرت في","https://www.poetsgate.com/ViewPoem.aspx?id=123857",""],[6024,"الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=186351",""],[6093,"كُنْ يا عُبيدُ على حذر(مجزوء الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=181611",""],[6093,"الكُلُّ يخطيءُ تارةً ويُصيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=205649",""],[6124,"من علم الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=193665",""],[5309,"هذا هواك فودعي عهد الهوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573549",""],[5309,"كتبت عليها في الغرام ذنوب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573865",""],[5309,"ألشعر عاطفة بروحك تلمع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573519",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""],[6167,"على شط الأربعين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85485&r=&rc=14",""],[6190,"إباء الورد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86998&r=&rc=4",""],[6202,"هوى وشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86757&r=&rc=58",""],[6225,"مهندس زراعي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80901&r=&rc=170",""],[5126,"فكرة مُختلطة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87818&r=&rc=33",""],[5190,"عدتَ يا يوم مولدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85047&r=&rc=122",""]],"verses":[["والعُمْرُ لوْ جازَ المَدى لتبرّمَ ال","أرواحُ منه بصُحْبَةِ الأجسامِ",0,"م",1,0],["والعُمْرُ يَذْهَبُ كالحياةِ فما الذي","يُجْدي عَليكَ منَ الخَيالِ السّاري",1,"ر",2,0],["والعُمر إلا تحت ظلّك ضائعٌ","والعيش إلاّ في جنابك مُمحلُ",2,"ل",1,0],["والعمر ميدان سبق والحمام له","مدىً وكلّ الورى جارٍ على طلق",3,"ق",1,0],["وَالعُمر وَالزَمانُ يَجِدُّ في","إِخفائِه وَالمَرءُ في إِثباتِهِ",4,"ت",2,0],["والعمر سارَ كأنه العدم","سقمي به عندي كعافيتي",5,"ي",1,0],["والعُمْرُ يذبُل في مَنابِتِهِ","غَرْسٌ ويلبسُ نضرةً غَرسُ",6,"س",1,0],["والعُمرُ يُحْفَزُ بينَ يوْمٍ سابقٍ","لا يستقِرّ وبين يومٍ حادِ",7,"د",1,0],["والعمرُ كالليل نحييه مغالطة","يُشكى من الطول أو يشكي من القِصَرِ",8,"ر",1,0],["وَالعُمرُ مَقسومٌ عَلى الأَكوانِ بِالجُ","زءِ الأَقَلِّ وَلَيسَ بِالأَعشارِ",9,"ر",1,0],["وَالعُمرُ أَنفَسُ ما الإِنسانُ مُنفِقُه","فَاِجعَلهُ لِلَّهِ تُحمَد في سَجاياكا",10,"ك",2,0],["وَالعُمرُ لا يَدري الحَكيمُ أَكُثرُهُ","خَيرٌ لَهُ مُتَغَبِّراً أَم قُلُّهُ",11,"ل",2,0],["وَالعُمرُ إِصعادُ إِنسانٍ وَمَهبِطُهُ","كَالأَرضِ أَودِيَةٍ مِنها وَأَجبالِ",12,"ل",1,0],["وَالعُمرُ كَالذابِلِ الخَطِّيِّ قَد بُسِطَت","لَهُ كُعوبٌ وَلَكِن بِالرَدى خُتِما",13,"م",2,0],["والعُمْرُ أَضْيَقُ أن يُمَدَّ لسالِكٍ","إِن أوْسَع الْخُطُواتِ في سَاحاتِه",14,"ت",2,0],["والعمر ظلّ والزمان يجدّ في","إخفائه، والمرء في إثباته",15,"ت",2,0],["والعمر أيام قد اختصرت وآمال رحاب","ليت الملائك يشفقون على الألى عبثوا وخابوا",16,"ب",3,0],["والعمر ناء في غلاغل غفلة","والموت مقتبل الشكيمة داني",17,"ن",2,0],["والعمى اولعيان والوهم والفه","م وتمزيق فرقة الأغيار",18,"ر",1,0],["والعمر مني قد تقضي في الهوى","والصبرُ عيل ولي الهيامُ دليلُ",19,"ل",1,0],["والعمى يستر عنك الغ","ل من شرّ وخيره",20,"ر",2,0],["والعمرُ نهرٌ ترى من","حوادثِ الدهرِ طينهْ",21,"ن",2,0],["والعمر بين دقائق","ماض وبين ثوان",22,"ن",1,0],["وَالعَمُّ أكبرُ حِكمةً وَدِرايَةً","بِالأَمرِ لو أَنَّ المُكابِرَ فكَّرا",23,"ر",2,0],["وَالعمر ينقص فيها","وَسيآت تَزيد",24,"د",1,0],["والْعُمْرُ ليس قَشيبُه كَدَريسِه","كاليوم لَيْسَ شُروقُهُ كغُروبِهِ",25,"ب",2,0],["والعمر لولا نعمة ال","أحباب والفن الصناع",26,"ع",1,0],["وَالعُمرُ كَالكَأسِ وَالأَيّامُ تَمزُجُهُ","وَالشَيبُ فيهِ قَذىً في مَوضِعِ الحَبَبِ",27,"ب",1,0],["والعمل بالذي أعلم وقول","نسأل الله فردا ذا امتنان",28,"ن",1,0],["والعمل بالعلم مشروط لمن","يبتغي القرب ويطلب للوصول",29,"ل",1,0],["والعمر ألجأني إلي","ها والقوى المتخاذلة",30,"ل",2,0],["والعمر مثل الماء في","آخره يأتي الكدر",31,"ر",1,0],["والعمر دُرٌّ في نظام وهل","نَفرح أن يُنقَصَ دُرُّ النِظام",32,"م",1,0],["والعمرُ كيف العمر حظّ مقامرٍ","والحُّق كيف الحُّق أفظع باطل",33,"ل",1,0],["والعمر مرحلةٌ فما","تسطيع من حسنٍ تزوّضد",34,"د",1,0],["والعمر يجري لاهثا","لو كان يخطو ما لهث",35,"ث",1,0],["والعُمْرُ وَهُوَ أَجَلُّ ما خُوِّلْتَهُ","أَنْفَقْتَه في الدّورِ في أَدْرابِهِ",36,"ب",2,0],["والعُمُوماتُ قَدْ أَتَتْنا بِما في","هِ جَلاءُ الشُّكُوكِ والاِرْتيابِ",37,"ب",1,0],["وَالعمرُ في الشيبِ مُمتدٌّ كَما زَعَموا","لَكنّه لَم يَدَع شَيئاً سِوى النفسِ",38,"س",1,0],["والعمى عنك وصفها كشهود","لك فالوصف داؤها ودواها",39,"ا",3,0],["وَالعَمارات وَهيَ في مَصر شَتى","شادها طبق رَسمه كُل ناجب",40,"ب",1,0],["وَالعُمر عِندي لا يُعادل ساعَة","مِن وَصله في غُرفة أَو مَقعد",41,"د",1,0],["وَالعُمر عِندي لا يُقاس بِساعة","مِن وَصله في تَنهة بِالمَقعد",42,"د",1,0],["والعمرُ ذكرٌ شيدته رواتُه","يا حسنَ ذكر للعيان مُشَيَّدِ",43,"د",1,0],["والعُمْرُ باللذاتِ مع","مورُ الدساكرِ والدِّيار",44,"ر",1,0],["والعمر ليلٌ دامسٌ لكن إذا","لاح الصباح له وشيكا ينجلى",45,"ل",2,0],["والعُمرُ ما بينَ الرَّحَى","وَيديِّك فتَّ لظاهُ فتا",46,"ت",2,0],["والعمرُ من يَدِهِ","كالرمل ِيَنسَرِبُ",47,"ب",1,0],["والعمر ميدَان سبقٍ والحِمَامُ مَدىً","وكُلُّ جَارٍ سَيَلْقَى غَايَة الأمدِ",48,"د",1,0],["وَآل عمرو مع الحدّان قاطبة","في آلِ دهمش في جند ابن جيلانِ",49,"ن",1,0],["والعم بأن حب آل المصطفى","عبادة وتلك حسبي وكفى",50,"ف",2,0],["والعمر آخره تصرم وانقضى","فاجعل إلهي خير عمري آخره",51,"ه",1,0],["والعمرُ أَضْيَقٌ عن مَجْدٍ أُؤثلُهُ","وعن هَوَىً حُكْمُهُ بِالذُلِّ مَحْتومُ",52,"م",1,0],["والعمر منا يطل","قولوا جميعا امين",53,"ن",1,0],["والعمر والرِّزق محتومان همُّهما","فما يزيد الفتى في حرصه تعبا",54,"ب",2,0],["وَالْعَمْي أولىُ بِحالٍ العُورِ لوْ عَرَفُوا","على القِياسِ وَلَكِنْ خافَ مَنْ خافا",55,"ف",2,0],["والعمر إِمّا تناهى","يغدو الخطاء صوابا",56,"ب",2,0],["والعمر يطويه الزمان فهل لنا","في هذه الدنيا أخى تعمير",57,"ر",1,0],["والعمر قد ولى كطيف معقباً","حسرات مفؤد وندب كئيب",58,"ب",1,0],["والعمر عاره والمعير مصادر","للمستعير إنه يرد ما عار",59,"ر",1,0],["وَالعُمرُ زاهٍ زاهِرٍ","وَالفِكرُ راقٍ ثُمَّ رائِقِ",60,"ق",1,0],["والعمر يقصر عن هجر وعن صلة","وعن تجن وعتب يورث السقما",61,"م",2,0],["والعمارات ناطحات سحاب","رافعات رؤوسها للعنان",62,"ن",1,0],["والعمل المجزي كان صادرا","من فضله مثل الجزاء صائرا",63,"ر",2,0],["وَالعُمرُ وَالعَيشُ في الدُنيا لهُ مَثَلٌ","كَالظِلِّ أَو مَن يَرى في نَومهِ حُلُما",64,"م",2,0],["وآل عمران توحيدٌ بلا صفةٍ","من الصفاتِ التي أتت بتشبيه",65,"ي",2,0],["والعمر زورة طآئفٍ","يأتيك ما بين الرقاد",66,"د",1,0],["والعمر غايته الفناء وإن","فسح المدى وتطاول العمر",67,"ر",1,0],["والعمر طولٌ في العذاب ولن","أرضى بأَن أَفنى على مهل",68,"ل",1,0],["والعمر بغيُ الفاهميهِ","والحياةُ لهم عقاب",69,"ب",1,0],["والعمر معتركٌ ومقتتل","إن الشبيبةَ وهي تقتبل",70,"ل",1,0],["والعمر أقصر من ليالي وصلنا","يا صاح هب كان الزمان طويلا",71,"ل",2,0],["والعُمرُ يومٌ والنمنيّةُ يَقْظةٌ","والمرءُ بينهما طُرُوقُ خيالِ",72,"ل",1,0],["والعمى منهم وإن شغلوا","عنه باللذات مقترب",73,"ب",1,0],["وَالعُمر مِرقاة العَنا وَالتَعَب","في الكَون هَذي سُنَّة الخَلّاق",74,"ق",1,0],["والعُمرُ ما يُسعِدُني أن أسعى","في تَجرِبَه هذي الفُنونِ جَمعا",75,"ع",2,0],["والعمل الصالح كالصيام","هو الذي سمي بالإسلام",76,"م",1,0],["والعمر بينهما يمر كأنه","سكر الطروب على سلافة راحه",77,"ح",2,0],["والعمر لم يبقَ منه غير آخره","ومطمحي دون نيل النجح أضناني",78,"ن",2,0],["وآل عمران سادوا الكائنات به","رجالهم والنسا فازوا بفخرهم",79,"م",1,0],["وَالعَم جَعفر حازَ الفَضل إِذ كملت","بِهِ المَراتب أَعلاها وَأَسماها",80,"ا",3,0],["والعمر قد أوشك ان ينقضي","وما قضت لبنى لباناتي",81,"ي",1,0],["والعُمْرُ بِذَاكَ يَنْقَضى فِي تَعَب","والرَّاحَةُ ماتَتْ فَعَلَيْهَا الرَّحْمه",82,"ه",1,0],["والعمر مهما تمادت بي مسافته","سينقضي في معاش ظالم نكد",83,"د",1,0],["والعم عبد الله نعم العبد","غربا ومن ذوي التقى يعد",84,"د",1,0],["والعمرُ فِي شَرْخِ الشباب ولِمَّتي","صبحٌ بِهِ ليلُ الشبابِ تَغيَّبا",85,"ب",2,0],["والعمر ومضة بارقٍ","والموت حتمٌ في الرقاب",86,"ب",1,0],["والعمرُ مقدور المدى","أجلٌ له قد حُدِّدا",87,"د",2,0],["والعمر أنفاس تناهى عدها","وما تناهى الشيء الا انقطعا",88,"ع",2,0],["والعمل الصالح ما بينهم","همتهم عن فعله فاتره",89,"ر",2,0],["وَالعُمر وَالأَمر وَالدُنيا وَما جمعت","يُمناك أَحسنه في العَين ذاهبه",90,"ب",2,0],["وَالعمر ضيفٌ عزيزٌ","فاحضر إليه بواجب",91,"ب",1,0],["والعمر نورٌ والشبيبةُ نضرةٌ","يا حسن ذا ناد وذلك زاهيا",92,"ي",2,0],["وَالعُمر صاد يرجّي من مصاحبة","مناهلاً لبقاه غير موروده",93,"د",2,0],["وَالعُمرُ يحسنُ إِن صَفا","كَالتبرِ إِذ يَصفو يُصاغ",94,"غ",1,0],["والعمى رزءٌ وإن وضحت","في ضياء المبصر المحن",95,"ن",1,0],["والعمرُ أغلى بضاعةٍ لمنفقه","فيما يقربه اللَه من خدمِ",96,"م",1,0],["وآل عمرانَ وبالنساءِ","مائدةٍ فوالِ بالعطاءِ",97,"ا",2,0],["والعمّ أيضاً بيّن العمومه","وبيننا خئولة معلومه",98,"ه",1,0],["وَالعمرُ ثوبٌ وَالصِفاتُ رقومُهُ","فاختَر بأَيّ الوصفِ ثَوبَكَ ترقُمُ",99,"م",1,0],["والعُمرُ رأسُ المالِ فاحفَظهُ فَما","قَد ضاعَ مِن عُمرِ الفَتى لا يُغرَمُ",99,"م",1,0],["وَالعُمرُ أَفنَت ثِقال الوُزر لمحته","وَبَدَّدَتهُ صُروفُ الدَهرِ بِالتُّهَم",100,"م",1,0],["والعمده القلب إذا فيه أعتنا","للخير هل تستوى كل الأمور",101,"ر",1,0],["والعمى قد أبصرت أقمار أوجههم","لأنها مظهر النور الإلهي",102,"ي",1,0],["والعمر محدود ومن","طلب امتداد العمر خابا",103,"ب",2,0],["والعمُّ ليس له يا أخي","حظ يراه ولا من نصيب",104,"ب",1,0],["والعمر كالحلم فيها","لكنه لن يعادا",105,"د",2,0],["والعمر مثل الكأس ير","سب في أواخره القذى",106,"ذ",2,0],["والعمالة شر ما أدراك ما شر العماله","البلد والشعب راحوا بين بنقالي وجاوي",107,"ا",3,0],["والعُمْرُ مرهونٌ على قادمٍ","والرَّيبُ طوفانٌ على الرَّأس",108,"س",1,0],["والعَمُّ يَأجُوجُ كَم قامَت قِيامَتُهُ