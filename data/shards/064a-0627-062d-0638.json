{"poems":[[287,"بالملك الأشرف لم","https://www.aldiwan.net/poem32630.html","منهوك الرجز"],[325,"يا حظ مصر فقد جاد الزمان لها","https://www.aldiwan.net/poem67226.html","البسيط"],[463,"قالوا عساك مرجم فتبين","https://www.aldiwan.net/poem55859.html","الكامل"],[463,"دعها تكن كالسلف من أخواتها","https://www.aldiwan.net/poem56263.html","البسيط"],[505,"من تملى بكلامي","https://www.aldiwan.net/poem37770.html","مجزوء الرمل"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216668",""],[1354,"","https://poetry.dctabudhabi.ae/diwan/poem/205982",""],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110290","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100723","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33610","البسيط"],[4852,"يا كل الرجا","https://www.poetsgate.com/ViewPoem.aspx?id=214330",""],[4869,"ياحظي الطايح","https://www.poetsgate.com/ViewPoem.aspx?id=151638",""],[4978,"تشطير إني أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=177241",""],[5055,"حظي الوافي","https://www.poetsgate.com/ViewPoem.aspx?id=108498",""],[5170,"موت الضمير (سوريا)","https://www.poetsgate.com/ViewPoem.aspx?id=175518",""],[5198,"الكحل","https://www.poetsgate.com/ViewPoem.aspx?id=135396",""],[5419,"دمعة","https://www.poetsgate.com/ViewPoem.aspx?id=32218",""],[5480,"هموم الحر","https://www.poetsgate.com/ViewPoem.aspx?id=9875",""],[5747,"شح العطا","https://www.poetsgate.com/ViewPoem.aspx?id=61681",""],[6056,"ملمس الديباج والمخملي","https://www.poetsgate.com/ViewPoem.aspx?id=130141",""],[6056,"إسمك وعنوانك بجوالي","https://www.poetsgate.com/ViewPoem.aspx?id=130335",""],[6056,"بالخير متبرّع","https://www.poetsgate.com/ViewPoem.aspx?id=156715",""]],"verses":[["يا حَظِّيَ اِنتَبِه أَلَم","يَأنِ أَلَم يَأنِ أَلَم",0,"م",1,0],["يا حَظَّ مِصرَ فَقَد جادَ الزَمانُ لَها","بِما تَمَنَّت وَكَم أَبدَت لَهُ وَلَها",1,"ه",2,1],["يا حظُّ قمْ فاهتفِ بناحيةِ الغنى","في الرَّيِّ وارحْم كدَّ من لم يفطُنِ",2,"ن",1,0],["يا حظُّ ما لك لا أقالك عثرةً","جاري الحظوظِ وغافرٌ زلاَّتِها",3,"ت",3,0],["يا حُظوظُ النَّفْسِ زُولي","يا سَحابَ الفَتْحِ دُومي",4,"م",2,0],["يا حظ من هو عن دربهن تلايا","فرّ بنصخ روحه عن يْصاب بينان",5,"ن",1,0],["يا حظّ من بالزين يطريك","لانّك على الحسنه سبقته",6,"ت",2,0],["يا حظ ليس بواهن جلدي","ولو ان فجرك غاية الأبد",7,"د",1,1],["يا حظ ما لبنان منك على","أمل يعلله بخير غد",7,"د",1,0],["يا حظ ما صافيت في وطني","إلا الحريَّ بذلة الوتد",7,"د",1,0],["يا حظ لم تضحك لباكية","غرثى ولا اضحكت ذا كمد",7,"د",1,0],["يا حظ لا سهم اصيب به","لبنان الا مرّ في كبدي",7,"د",2,0],["يا حظ عين رأته في توهجه","رأد الضحى وبصيص الدر يزدهر",8,"ر",1,0],["يا حظَّ عيني ويا مناها","ومُنتهى غايتي وديني",9,"ن",2,0],["‏ياحظَ عينٍ .. صبحُها عينٌ، هَنًا","في وجهِكَ الدُّريِّ شمسًا تُرتَجى",10,"ج",2,1],["ياحظي الطايح ألا ليتك تقوم","تعبت اسلّي هالخفوق بامانيه",11,"ن",3,1],["(يا حظ من قد نال شفعة أحمدٍ )","فحماه في الدارين بعض حماكا",12,"ك",2,0],["يا حظي الوافي يا أطهر أنسابه","نظرة وعيدي لي يا ورده نسابي",13,"ب",2,0],["ياحظ تكفى اكتب الواقع قهر","وعنون كتاب العز يا موت الضمير",14,"ر",1,0],["ياحظ اللي تمسّك بالهداية والتزم بالدين","ويابخت النفوس اللي عن الزلات معصومة",15,"م",2,0],["يا حظَّه المنديل .. جفّف دمعةً","وقفت على الجفنِ الكحيلِ تشاغلُهْ",16,"ل",2,0],["يا حظ ٍ ما لقى غيري تعمدني وأنا الألماس","خسرنا عزنا والله وراحت هيبة ألماسه",17,"س",2,0],["ياحظ انا في ذمتك وانت مديون","سدد ديوني قبل شهر الصيامي",18,"م",2,0],["ياحظ من هو فؤاده في الهوى ما أقلقه","ينام ليله وقلبه ، في المحبة خلي",19,"ل",2,0],["ياحظ من وقته صفاله يوم","مع من يحبه داله وسالي",20,"ل",2,1],["يا حظ من هو سعى بالخير متبرّع","يرجي الجزاء من إله الخلق والينا",21,"ن",2,1]]}