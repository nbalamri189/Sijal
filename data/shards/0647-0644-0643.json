185,"دع مجلس الغيد الأوانس","https://www.aldiwan.net/poem67054.html","مجزوء الكامل"],[189,"يا رب أين عطاؤك الجزل","https://www.aldiwan.net/poem43351.html","الكامل"],[200,"نوحي بعقر السجن نوحي","https://www.aldiwan.net/poem39896.html","مجزوء الكامل"],[200,"قومي اسمعي يا بنت جاري","https://www.aldiwan.net/poem39947.html","مجزوء الكامل"],[202,"مري علينا يا صبا نجد","https://www.aldiwan.net/poem45612.html","أحذ الكامل"],[202,"هذا الدجى والهم في صدري","https://www.aldiwan.net/poem45622.html","أحذ الكامل"],[207,"يا منيتي لم حجبت عن بصري","https://www.aldiwan.net/poem53140.html","المنسرح"],[214,"يا قلب هذا نعيم","https://www.aldiwan.net/poem46564.html","المجتث"],[214,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[226,"ضيعت في هضب الهوى رشدي","https://www.aldiwan.net/poem41886.html","أحذ الكامل"],[228,"عز الكرام وشاطرهم رزيتهم","https://www.aldiwan.net/poem55086.html","البسيط"],[229,"ذكرى سعد","https://www.aldiwan.net/poem24223.html","عموديه"],[265,"أمسيت بالأنبار يا ابن محمد","https://www.aldiwan.net/poem68197.html","الكامل"],[265,"عينان واحدة ترى مسرورة","https://www.aldiwan.net/poem68199.html","الكامل"],[301,"برزت بزينتها إليك الشام","https://www.aldiwan.net/poem36300.html","عموديه"],[301,"أعطى قليلا واستردا","https://www.aldiwan.net/poem36857.html","عموديه"],[306,"يا خجلتا لجرير من","https://www.aldiwan.net/poem58171.html","مجزوء الكامل"],[367,"أهواكم وخيالكم يهواني","https://www.aldiwan.net/poem60621.html","الكامل"],[374,"ما طول الليل القصيرا","https://www.aldiwan.net/poem57394.html","مجزوء الكامل"],[396,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[403,"لا تسألوا عن جدة الأمطارا","https://www.aldiwan.net/poem10304.html","عموديه"],[405,"عزمت باليمن تحمي حوزة اليمن","https://www.aldiwan.net/poem46916.html","البسيط"],[409,"حكم المنية في البرية جاري","https://www.aldiwan.net/poem50178.html","الكامل"],[419,"يا ليلة في آخر الشهر","https://www.aldiwan.net/poem54175.html","أحذ الكامل"],[435,"ما زال يخدع قلبه حتى هفا","https://www.aldiwan.net/poem12801.html","الكامل"],[438,"جرر على القمرين ذيل التيه","https://www.aldiwan.net/poem2652.html","الكامل"],[446,"ما كان ذنبي يا أعز الناس","https://www.aldiwan.net/poem56049.html","عموديه"],[455,"هل كان قانون ابن سينا","https://www.aldiwan.net/poem61763.html","مجزوء الكامل"],[460,"لو كنت دانيت المودة قاصيا","https://www.aldiwan.net/poem55811.html","الكامل"],[481,"ما كان أجرأه على تعذيبي","https://www.aldiwan.net/poem36977.html","الكامل"],[507,"ذو الأوتاد","https://www.aldiwan.net/poem27895.html","البسيط"],[517,"رميت يا دهر كف المجد بالشلل","https://www.aldiwan.net/poem12225.html","البسيط"],[563,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[564,"ما بال موسى بلا سمع ولا بصر","https://www.aldiwan.net/poem52934.html","البسيط"],[570,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[1042,"","https://poetry.dctabudhabi.ae/diwan/poem/202289","الرمل"]],"verses":[["هَل كانَ كُلُّ الناسِ إِلّا هَكَذا","ذو شَجَنٍ باكٍ لِباكٍ ذي شَجَن",0,"ن",1,0],["هَل كانَ يَومُكَ إِلّا بَعدَ أَيّامِ","سَبَقتَ فيها بِإِنعامِ وَإِرغامِ",1,"م",1,1],["هل كفى يا أرض غيثا ؟ لم تعد","تغسل الأمطار ، أوجاعي وعقمي",2,"م",2,0],["هلْ كانَ للسّفّاحِ والمَنْصور وال","مَهْديِّ منْ ذِكْرٍ على الإطْلاقِ",3,"ق",1,0],["هلْ كُنْتَ تَعْلَمُ في هُبوبِ الرّيحِ","نَفَساً يؤجِّجُ لاعِجَ التّبْريحِ",4,"ح",1,1],["هَل كُنتُمُ إِلّا دَوارِجَ حُشوَةً","دَفَعَت كَواهِلُ عَنكُمُ وَصُدورُ",5,"ر",1,0],["هَلَكوا دونَ نَيلِ ما أَمَّلوهُ","مَن يَطِر فَوقَ طَورِهِ يَتَرَدّى",6,"د",2,0],["هَلَكتَ وَأَهلَكتَ العَشيرَةَ كُلَّه","فَنَهدُكَ نَهدٌ لا أَرى لَكَ أَرقَما",7,"م",2,1],["هل كان أمره قائدٍ أو سائسٍ","في الحالتين كما أجدت مجيدا",8,"د",2,0],["هَلْ كَانَ مَا ذَهَبَتْ بِهِ ال","أَيَّامُ مِنْ أَدَبِي وَفَنِّي",9,"ن",2,0],["هَلْ كَانَ أَنْهَضَ مِنْكَ فِي الْجُلَّى فَتىً","حُرٌّ وَأَمْضَى فِي الأُمُورِ هُمَامُ",10,"م",1,0],["هَل كُنتَ إِلّا أَميناً فَاِغتَرَرتُ بِهِ","أَو حاسِداً فَأَهانَ اللَهُ حُسّادي",11,"د",2,0],["هَلَكَت عامِرٌ فَلَم يَبقَ مِنها","بِرِياضِ الأَعرافِ إِلّا الدِيارُ",12,"ر",1,0],["هل كفى من فرط هجري ما جرى","وجرى من دمع عيني ما كفى",13,"ف",2,0],["هل كنت تُطرِب إلا مَن تشاكلهُ","ولو أعانك صوت الدف والوتر",14,"ر",1,0],["هل كان راجٍ يراكَ عِصمتَهُ","لولا اتهام القضاءِ والقدر",15,"ر",1,0],["هل كُنتَ فيما حَشَشْت هَاوِيتي","من ذاك إلا كبعض حُشَّاشي",16,"ش",2,0],["هل كُنتَ غِرَّاً بالنوائب قبلها","أم خِلتَهنَّ لما تُحبُّ ضِوامنا",17,"ن",2,0],["هَل كُنتُ مِن قَومِ موسى في مَحَبَّتِهِ","حَتّى أَطالَ عَذابي مِنهُ بِالتيهِ",18,"ي",2,0],["هلكوا في شرخ الشباب فيا","للرزء لما عرا وياللمصاب",19,"ب",1,0],["هل كان قلب عقيدهم","حجراً من الاحجار صلدا",20,"د",2,0],["هل كنت إلا للذي","بالأمس صرت له تصير",21,"ر",1,0],["هل كان إلا زهرة كزهوره","عجل الفناء لها بغير جُناح",22,"ح",1,0],["هَلَكَت قَبلَكَ ناسٌ وَقُرى","وَنَعى الناعونَ خَيرَ الثِقَلَين",23,"ن",1,0],["هَل كَلامُ العِبادِ في الشَمسِ إِلّا","أَنَّها الشَمسُ لَيسَ فيها كَلامُ",24,"م",1,0],["هَل كانَ في الوَهمِ أَنَّ الطَيرَ يَخلُفُها","عَلى السَماءِ لَطيفُ الصُنعِ مُختَرَعُ",25,"ع",1,0],["هَل كانَ جَدُّكَ في رِدا","ئِكَ يَومَ زَحفِكَ وَالكُرور",26,"ر",1,0],["هَل كانَ توتَنخٌ تَقَمَّصُ روحُهُ","قُمُصَ البَعوضِ وَمُستَخَسَّ إِهابِهِ",27,"ب",2,0],["هَل كُنتَ لَولا بَينُهُم مُتَوَحِّماً","أَنَّ اِمرَأً يُشجيهِ بَينُ مُحارِبِ",28,"ب",1,0],["هَل كانَ مِنّي فَعالُ سوءٍ","يَحسُنِ في مِثلِهِ التَجَنّي",29,"ن",2,0],["هل كنت قبلاً تستشفّ سكونها","وترى مقامك في العراء النائي",30,"ا",2,0],["هل كان ذاك القرب إلا لوعة","ونداء مسغبةٍ إلى حرمان",31,"ن",1,0],["هل كانَ نَهدُكِ صِنوَ قَلبكِ تَتَّقي","عَن لَمسِهِ في صَدرِكِ الأَزرارُ",32,"ر",1,0],["هل كان أودعَ سرَّ قلب مِحجرا","صَبٌّ يُكابِدُ دَمعَهُ المُتَحَدِّرا",33,"ر",2,1],["هل كان إلا غريقاً رافعاً يَدَهُ","نهاهُ عن شُرْبِ كاسٍ مَن بِها أَمَرَك",34,"ك",1,0],["هَل كانَ جُودُكَ في الأَموالِ مُقتَفِياً","آثارَ بأسِكَ في أُسدِ الوَغى الهُصُرِ",35,"ر",1,0],["هلكوا همُ وديارُهم في لحظةٍ","فكأنهم كانوا على ميعادِ",36,"د",1,1],["هَل كانَ عِندَكَ أَنَّ عِندي لَوعَةً","يَنبو لَها طَرفُ السِنانِ الأَزرَقِ",37,"ق",1,0],["هل كان في الأرضِ من أعلامِها علمٌ","مَالَتْ جَوانِبُها فانحطَّ أو مالا",38,"ل",2,0],["هل كُنتَ تعرفُ قبل مصرعِ قومنا","لُغَةَ الجراحِ ومنطقَ الآلامِ",39,"م",1,0],["هل كان يومَ دَعَوْتِ هَل مِن نَاصرٍ","إلا دَمٌ مُتَدفِّقٌ وَضِرامُ",40,"م",1,0],["هل كان إلا للكِنانةِ نجدةً","إن صيحَ أين حماتُها الأنجادُ",41,"د",1,0],["هَل كانَ صَوتُ الحَقِّ غَيرَ سَحابَةٍ","زالَت غَواشيها عَنِ الأَذهانِ",42,"ن",1,0],["هَل كانَ صِدقُ العَهدِ غَيرَ دُعابَةً","هَل كانَ عَدلُ الحُكمِ غَيرَ دِهانِ",42,"ن",1,0],["هَل كانَ عَهدُكِ إِلّا غُمَّةً كُشِفَت","أَو غَمرَةً ذَهَبَت عَنّا غَواشيها",43,"ي",3,0],["هَلَكتُ بِما رَجَوتُ بِهِ خَلاصي","وَقَد يُردي سَفينَتَهُ الشِراعُ",44,"ع",1,0],["هل كان نسيانك لي هفوة","أم خطّة أْشراكُها خافيه",45,"ي",2,0],["هل كَفْرَ كَنَّه مُرجْعٌ لي ذكرُها","ما فاتني من عنفوانِ شبابي",46,"ب",2,1],["هَل كانَ سَعد كَما علمت مِن الوَرى","فَيَموت كلا إِن سَعدَ لأَوحَد",47,"د",1,0],["هَل كانَ في رَجُلٍ جُناحٌ زائِرٍ","عَفٍ أَحَبَّ خَرِيدَةً مِعطارا",48,"ر",2,1],["هَلَكتُ لَئِن دامَت عَلَيَّ يَمينُهُ","فَيا رَبِّ أَدرِكني وَوَفِّقهُ لِلحَنثِ",49,"ث",1,0],["هَل كانَ إِلّا بَعضَ مَيلِ كَتائِبٍ","رَعيا عَلَيَّ تَقَصُّفاً وَتَشَعُّثا",50,"ث",2,0],["هَلَكَتْ جَدِيسُ وطَسْمُ حِينَ تعادَتا","وكأَنَّ طَسْماً لَم تكن وجَدِيسا",51,"س",2,0],["هَلْ كانَ هذا الكَوْنُ دَبَّرَ نَفْسَهُ","مِنْ بَعْدِهِ أَمْ آثَرَ التَّعْطِيلا",52,"ل",2,0],["هل كنتَ تَحسَبُ قبل جُرأتِنا على","تقريظهِ أنّ الحُلومَ تُجَهَّل",53,"ل",1,0],["هل كنتَ تدري قبل جودِ بَنانِهِ","أنّ الغُيومَ الغادياتِ تُبخَّل",53,"ل",1,0],["هل كان يُعرَفُ للبطارقِ قبل ذا","بأسٌ ورأيٌ في الجِلادِ أصيل",54,"ل",1,0],["هل كانَ ضَمّخَ بالعبير الريحا","مُزْنٌ يُهّزُّ البرقُ فيه صَفيحا",55,"ح",2,1],["هَلِكَت سُعودٌ في القَبائِلِ جَمَّةٌ","وَأَقامَ في جَوِّ السَماءِ سُعودُ",56,"د",1,0],["هَل كَرِهَ القُربَ مِن عِظامي","أَعظُمُ قَومٍ مُجوِرِيّا",57,"ر",3,0],["هَل كانَ يمكن أَن لا","يحب مثلك مثلي",58,"ل",2,0],["هل كان عهدُك قبل تشتيت النَّوى","إلا مخالسةَ الخيالِ الطارقِ",59,"ق",1,0],["هَلْ كُنْتُ إِلاَّ مَجِنّاً تَتَّقُونَ بِهِ","قَدْ لاَحَ في عِرْضِ مَنْ باذَأَكُمْ عَلَبِي",60,"ي",1,1],["هل كُنْتَ بين الموت والميلادِ","إلَّا حياةَ مآثرٍ وأيادي",61,"د",2,1],["هل كنت تُبصِرُ منْ حضارة عصرها","إلا نثير حجارةٍ ورَمَادِ",61,"د",1,0],["هَلَكتَ وَأَهلَكتَ العَشيرَةَ كُلَّها","فَنَهدُكَ نَهدٌ لا أَرى لَكَ أَرقَما",62,"م",2,1],["هَل كانَ حَولَ مُحَمَّدٍ مِن قَومِهِ","إِلا صَبِيٌّ واحِدٌ وَنِساءُ",63,"ا",2,0],["هلْكى بكى البيت عليهمْ والحرَمْ","الموتُ دون العهدِ غايةُ الكرمْ",64,"م",1,0],["هَلْ كَانَتِ الدُّنْيَا مَقَاماً صَالِحاً","لِيُطِيلَ فِيهِ مَكْثَهُ الصِّدِّيقُ",65,"ق",1,0],["هَلْ كُنْتِ إِلاَّ كَوْكَباً آخِذاً","فِي أُفُقِ العَلْيَاءِ مِنْ بَدْرِ",66,"ر",1,0],["هَلْ كَالتَّعَارُفِ ضَابِطٌ وَمُؤَلَّفٌ","لِلْعُنْصُرِ المُتَنَاكِرِ المُتَدَابِرِ",67,"ر",1,0],["هَلْ كَانَ إِسْمَاعِيلُ إلاَّ صُورَةً","شَرْقِيَّةً لِلعِزَّةِ الْقَعْسَاءِ",68,"ا",2,0],["هَلْ كَانَ أَمْهَرُ قَائِدٍ أَوْ سَائِسِ","فِي الْحَالَتَيْنِ كَمَا أَجَدْتَ مُجِيدَا",69,"د",2,0],["هَلْ كَانَ حِينَ قُتِلْتَ سَلْبُ السَّالِبِ","أَقْسَى الرَّدَى أَمْ كَانَ ثَلْبُ الثَّالِبِ",70,"ب",1,1],["هَلْ كانَ هَذَا البَيْنُ فِي الفَجْرِ","فَتَلَوْتِ كَوْكَبَهُ عَلَى الإِثْرِ",71,"ر",1,1],["هَلْ كَانَ هَذا العَقْلُ بَعْدَئِذٍ","مِنْ جَهْلِنَا المَاضِي بِميعَادِ",72,"د",1,0],["هل كان قلبك إلا في جوانحه","أو كان دمعك إلا في محاجره",73,"ر",2,0],["هل كنت في أبهى ليالي الهوى","أيام كنت فتنة الناظرين",74,"ن",1,0],["هل كنت إذ ذاك سوى آلة","ألحانها مني ومنها الرنين",74,"ن",1,0],["هَل كَالَّذي لَم يَجنِ قَطّ وَلَم يَخُن","مَن كانَ يَمدَحُ أَو يَذُمُّ تَخَرُّصا",75,"ص",2,0],["هل كنت في العزّاء عوناً له","أيام يُرمَى بالمزاريق",76,"ق",1,0],["هل كنتُ إلا قطرةً","في لجِّ بحر مزبد؟",77,"د",1,0],["هل كنت تلقى في الورى ساعيًا","لو كان يسعى الرزق للقاعد؟",78,"د",1,0],["هل كان ميثاقُ المحيط روايةً","وهميَّةً محبوكةَ الأطراف؟",79,"ف",1,0],["هل كنت ، أين أنا ؟ أفتش لم أجد ... شخصي الجديد ، ولا كياني البالي","من أين يا جدران جئت ؟ خلالها ... أمشي ، وأرجلها تجوس خلالي",80,"ل",2,0],["هل كنت أحكي ؟ مطلقا من حكى","في داخلي كان ينام الحوار",81,"ر",1,0],["هل كفى يا أرض غيثا ؟ لم ت