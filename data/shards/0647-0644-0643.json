,"س",1,0],["هل كان إلا في العظائم موئلاً","في يوم تشخص عنده الأبصار",111,"ر",1,0],["هَلَكَ النَّدى إذ بِنتَ لابن مُحَمَّدٍ","فَجَعَلتُهُ لَكَ في التُّرابِ عَدِيلا",112,"ل",2,0],["هَلَكَ الخلِيفةُ يا لأُمَّةِ أحمَدٍ","فَأتَاكُمُ مِن بَعدِهِ مَن يَخلُفُ",113,"ف",1,0],["هل كان غصنٌ في خمائلِ (جلَّق)","نايٌ وَأنفاسُ النسيمِ زنام",114,"م",1,0],["هل كان في إِلمامه","غير الأَسى والسهدِ أَسدى",115,"د",2,0],["هل كان يلقى إذا أتا","ه طيف من يهوى خساره",116,"ر",2,0],["هل كان في الوزراء إلاّ قاسمٌ","ولقد يُزادُ الحَقُّ فَضْلَ بيان",117,"ن",1,0],["هل كانَ عندكَ أنَّ في ال","أَقلامِ ما يُفني البُحورا",118,"ر",2,0],["هَل كَالوَصِيِّ مَقارِع في مَجمَعٍ","هَل كَالوَصِيِّ مُنازِع في مَجفِلِ",119,"ل",1,0],["هل كان أبكم لا أظنُّ – وإنَّما","يتباكم المتكبِّر استكبارا",120,"ر",2,0],["هَلْ كان يدري الأُلى وُلِّيتَ أرضهمُ","بأنّهم قد سُقوا بالعارضِ الهتن",121,"ن",1,0],["هَل كنت إِلّا زَبرَةً فَطَبَعنَني","سَيفاً وَأطلق صرفهن غراري",122,"ر",2,0],["هل كنت قبل اليوم في سعة","وملابس من سندس خضر",123,"ر",1,0],["هل كان ذاك العيشُ إلا بارقاً","وهي الشرارةُ ما خَفا حتى اخْتفى",124,"ف",2,0],["هَل كانَ سِرُّ الحُبِّ إِلّا مُضمَراً","فَغَدَت صِفاتُك في الوَرى تُفشِيهِ",125,"ي",2,0],["هل كان الا دين حق ديننا","هل في الرضى عن عاشق من باس",126,"س",1,0],["هل كان قانون ابن سي","نا غير قانون الحياه",127,"ا",2,1],["هل كان ذاك الحِصنُ يَرهبُ هادما","أو كان ذاك البابُ يفرَقُ داحيا",128,"ي",2,0],["هل كان دمعي غاسلا لخطيئتي","كلا وليس بمطفىء للهيبي",129,"ب",2,0],["هل كان فرعونُ ذو الأوتاد مُختلفا","عمّن أطاعوهُ ومِنْ طينِهم جُبِلا؟",130,"ل",2,0],["هل كان في الأمر شيء غير قسمة ما","ملكتمو بين حكم السبي والنفل",131,"ل",1,0],["هَلكَى بِلا تَجرٍ وَلا تَمَوُّلِ","وَكَرِشٍ بِهَجرٍ لَم يَحتَلِ",132,"ل",1,0],["هل كانَ قَبلَكَ من رَمْسٍ برابيةٍ","أضحَى ضَريحاً فأمسَى مَنزِلَ القمَرِ",133,"ر",1,0],["هل كان أوصى الصادق المبعوث","وذاك فيما قلته مبثوث",134,"ث",1,0]]}