{"poems":[[80,"من للشجاعة والكرم","https://www.aldiwan.net/poem14268.html","مجزوء الكامل"],[87,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[47,"كلما شاءت الرسوم المحيله","https://www.aldiwan.net/poem65542.html","الخفيف"],[71,"قدرك يا صاحبي وقدري","https://www.aldiwan.net/poem28571.html","مخلع البسيط"],[71,"والله لا هجوته","https://www.aldiwan.net/poem28588.html","مجزوء الرجز"],[78,"قلبي رهين بين أضلاعي","https://www.aldiwan.net/poem39267.html","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[124,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[290,"قل لمن تاه دلالا وهوى","https://www.aldiwan.net/poem39393.html","الرمل"],[505,"من لجسم من لوعة الهجر بالي","https://www.aldiwan.net/poem37923.html","الخفيف"],[556,"من على هذه الديار أقاما","https://www.aldiwan.net/poem47232.html","الخفيف"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123145","الدوبيت"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28580","الرمل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75900","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138705",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110003","الكامل"],[4626,"","https://poetry.dctabudhabi.ae/diwan/poem/102850","الكامل"]],"verses":[["مَن لَستَ تَعدَمُ عِندَهُ","غَيرَ التَبذُّلِ وَالعدَمْ",0,"م",1,0],["مِن لِسانٍ عَلى ثَنائِكِ وَقفٌ","وَجَنانٍ عَلى وَلائِكِ حَبسِ",1,"س",1,0],["مِن لِسانٍ إِلى البَيانِ طَويلٍ","وَيَمينٍ إِلى العُفاةِ طَويلَه",2,"ل",2,0],["مَنْ لستُ أرضى لهُ قليلاً","فكيفَ أرضى القليلَ منهُ",3,"ه",1,0],["مَنْ لستُ أرضى مدحَهُ","فكيفَ أرضى هجوَهُ",4,"ه",1,0],["مَن لسَقيمٍ ما لهُ عائدٌ","وميِّتٍ ليس له ناعي",5,"ع",2,0],["مَنْ لسَارٍ بِلَيْلةٍ طولُها العُمْرُ","يَجُوبُ الأَوْجالَ لِلأَوْجالِ",6,"ل",1,0],["من لستر الحياء يهتكه الغر","ويفري في جوفه كالداء",7,"ا",2,0],["من لسكب الدمع خوفا للذي","جعل الارض بساطا واستوى",8,"و",2,0],["مَنْ لِسِرٍّ من غيرِ حُبِّيكَ خالٍ","يا حَبيبي وفِكرةٍ بانْذِهالِ",9,"ل",1,0],["من لسوءٍ ميّزتَ عنه جميلاً","وحلالٍ خلّصتَ منه حراما",10,"م",2,0],["مَن لست أريد دائماً أبصره","ويلاه لا أرى الذي أهواه",11,"ه",1,0],["مَن لِساري اللَّيلَةِ اللَّي","لاءِ في الصُّبحِ وَمَن لي",12,"ل",2,0],["مِن لِساني ذكرانِ ذكرُ دُعاءٍ","ثُم ذكرٌ بِهِ الثَناءُ مُخَلَّد",13,"د",1,0],["من لسناها بعد ان صُرعوا","لم يبق من يمنع غاباتها",14,"ت",3,0],["من لَستُ حقّاً مستحقاً حَلَّ شِسعِ","حِذائِهِ بل إِن فيهِ تَشَرُّفي",15,"ف",2,0],["من لست تعدم عنده","غير التبدل والعدم",16,"م",1,0]]}