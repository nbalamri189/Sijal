poem/142012","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141975","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24804","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[95,"هكذا تقتحم القدس","https://www.poetsgate.com/ViewPoem.aspx?id=710",""],[106,"تحية الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=179305",""],[106,"الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179446",""],[100,"في المساء","https://www.poetsgate.com/ViewPoem.aspx?id=50420",""],[100,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[43,"أين أزمعت أيهذا الهمام","https://www.poetsgate.com/ViewPoem.aspx?id=144",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[45,"لَجّ هذا الحَبيبُ في هِجْرَانِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32012",""],[91,"ثقيل","https://www.poetsgate.com/ViewPoem.aspx?id=53271",""],[51,"أيها السيد الذي ورث السؤ","https://www.poetsgate.com/ViewPoem.aspx?id=27683",""],[51,"يا عليّ العلا ابن قاسمِ القا","https://www.poetsgate.com/ViewPoem.aspx?id=30288",""],[51,"يا أخي يا أخا الدماثة والرقة","https://www.poetsgate.com/ViewPoem.aspx?id=25882",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[97,"زازا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63558&r=&rc=104",""]],"verses":[["وَالَّذي يُرعي بِدارِ ال","عِزِّ وَالناسُ بِهامُ",0,"م",1,0],["وَالَّذي بِالرُبعِ مِن بُع","دِهِمُ بَعضُ الَّذي بي",1,"ب",2,0],["وَالَّذي يَدعو النَدى مِن","هُ بِداعٍ مُستَجيبِ",1,"ب",1,0],["وَالذِّكرُ مَثَّلَها لِلعَينِ سافِرَةً","وَمَن رآها فَلا يَرنو إِلى القَمَرِ",2,"ر",1,0],["وَأَلَذُّ مِن نَقرِ الفَتاةِ لِدَفِّها","نَقري لِأُلقي الرَملَ عَن أَوراقي",3,"ي",1,0],["والّذي أظْمأ لوْ شاءَ سَقَى","والذي فرّقَ لوْ شاءَ جمَعْ",4,"ع",1,0],["وَالذائِدينَ الناسَ عَن أَديانِهِم","بِالمِشرَفِيِّ وَبِالقَنا الخَطّارِ",5,"ر",1,0],["وَالَّذي إِن سيمَ ما فَوقَ الرِضى","وُجِدَ الأَلوى البَعيدَ المُستَمَرّ",6,"ر",1,0],["وَالذِي دِرْعُهُ فُؤَادٌ رَقِيقٌ","فَجَريحٌ إِنْ يُقْتَحَمْ أَوْ يُقَاحِمْ",7,"م",1,0],["والَّذي أَحرَمُوا لَهُ وَأَحَلُّوا","بمنىً صُبحَ عَاشِراتِ الليالي",8,"ي",1,0],["والذكريات إذا أتت بشهودها","حسن السماع وأحمد التكرار",9,"ر",1,0],["والذئب يبصر جدي المعز مقتربا","منه فيرجع عنه غير مقترب",10,"ب",1,0],["والذي عاش مؤنساً وحشة النا","س ممدّاً بفضله إيناسه",11,"س",2,0],["وَالذابِحينَ إِذا تَقارَبَ فِصحُهُم","شُهبَ الجُلودِ خَسيسَةَ الأَثمانِ",12,"ن",1,0],["والذي لو لم أخطّ له","مِدَحاً للمسك لم أمَث",13,"ث",1,0],["والذي زاد مقليك اقتدارا","ما أظنّ الوشاةَ إلا غيارا",14,"ر",2,1],["والذي أهواه بدرٌ قاتلٌ","اعملوا ما شئتمُ يا أهل بدر",15,"ر",1,0],["والذي كفُّه من الغيث أندى","والذي لفظه من الروضِ أنضر",16,"ر",1,0],["والذاريات من دموعي خلفةً","ما نقضت أيدي النوى ميثاقها",17,"ق",3,0],["والذي راحتاه تسري ليسرٍ","يرتجى نفعها ويمنى ليمن",18,"ن",1,0],["والذّهب المذكور لي مدّة","ما وقعت عيني على عينه",19,"ه",1,0],["والذي أطلق اللسان فعاتَبْ","تُك عَدِّيكَ أوَّلَ الفُهماءِ",20,"ا",2,0],["والذي ساد غيرَ مُستنكَرِ السُّؤ","دُدِ في الناس واعتلى كيف شاءَ",21,"ا",2,0],["والذي أنت وهْو في جوهر النفْ","س جميعاً مِن تربة وهواءِ",22,"ا",2,0],["والذي إن دُعي أجاب وإن كا","ن قِراعَ الفوارِس الشجعاءِ",22,"ا",2,0],["والذي إن أردتَه لمَقامٍ","جاء سَبْقاً كاللِّقوةِ الشَّغواءِ",22,"ا",2,0],["والذي رأيُهُ لأسلحة الأب","طالِ مثلُ الصِّقال والتذريبِ",23,"ب",1,0],["والذي لا يخافُ مادِحُهُ الإث","مَ لدى مدحِهِ ولا التكذيبا",24,"ب",2,0],["والذي لم يزل يجاري ذوي الفض","لِ فيستَتبِعُ الثناءَ جنيبا",24,"ب",2,0],["والذي لم يزل لجارٍ وراجٍ","جبلاً عاصماً ومرعى خصيبا",24,"ب",2,0],["والذي لم يَكُنْ فليس بمندو","بٍ وما كانَ وانْقضَى مندوبُ",25,"ب",1,0],["والذي مَنُّهُ مَشُوبٌ بِمَنٍّ","إنَّ رَنْقاً مَنٌّ بِمَنٍّ مَشُوبُ",25,"ب",1,0],["والذي جاء يَمتري خُصْيَةَ اللَّيْ","ث فذاك الذي حَدَتْهُ شَعُوبُ",25,"ب",1,0],["وألذُّ العيش ما في","ه صَبُوحٌ وَصِبَاحُ",26,"ح",1,0],["وألذُّ الشَّراب ما كان منه","صَافيَ العيْن صافيَ النَّاجُودِ",27,"د",1,0],["والذي اسْتَدْرَكَ السياسةَ بالحزْ","م وأحيا التدبْير بعد الهُمُودِ",27,"د",1,0],["والذي راح يحمل الظَّرْف والحج","جَةَ حمل الذكيِّ غير البليدِ",28,"د",1,0],["والذي لا يصرف الآ","مِلُ عنه باعتذار",29,"ر",1,0],["والذم شُكرِيك إذ رأيتك ته","وى الذمّ فاصبر لشرّ منتظَر",30,"ر",1,0],["والذي لم يُصخ بأذْنيه إلا","نحو ذو ثوريوسَ أو واليس",31,"س",1,0],["والذي أصبحتْ أياديه تَحكي","ها لدى مُعتفيه زهرُ الرياض",32,"ض",1,0],["والذي يحكم فيه بيننا","كرم منك وجود قد بَدع",33,"ع",1,0],["والذي لم يزل له","في المعالي تصرُّف",34,"ف",1,0],["والذي لم يزل يجل","ل ومعناه يلطُف",34,"ف",1,0],["والذي أبصر السحاب عطايا","ه فأضحى يشيم منه البروقا",35,"ق",2,0],["والذي يبهَرُ البدور ببدرٍ","لا يُرى كاسفاً ولا ممحوقا",35,"ق",2,0],["والذي أرتضيه جزءٌ صغيرٌ","ولك السؤددُ العظيمُ احتمالا",36,"ل",2,0],["والذي يكتسى بك الشعرُ أسْنى","مِن سناهُ عليك لا إشكالا",36,"ل",2,0],["والذي أضحتِ المروءةُ والخي","رُ حليفيْهِ والحقوقُ عيالَهْ",37,"ل",2,0],["والذي بذلُه بغيرِ ابتذالٍ","والذي طَوْلُه بغير استطالهْ",37,"ل",2,0],["والذ لم يرثْ كريم المساعي","والعلا وابتناءها عن كَلالهْ",37,"ل",2,0],["والذي يأمن المِطَال مرجِّي","ه ولا يأمنُ المجاري مطالهْ",37,"ل",2,0],["والذي لا يزالُ كلُّ حكيمٍ","راشدِ الأمرِ يستعين مثالهْ",37,"ل",2,0],["والذي يشتري الثناء فَيُغْلي","حين لا يسأل النجار الإقالهْ",37,"ل",2,0],["والذي برّزوا سماحاً وبأساً","فأحاديثُ مجدهِم منقولهْ",38,"ل",2,0],["والذي يوجب اختلافٌ وحرصٌ","فقعودي أولى به واتكالي",39,"ل",2,0],["والذي أسرعَ الإجابةَ واستعْ","جل قبل الإسراج والإلجام",40,"م",1,0],["والذي تستميح غال ثمينٌ","وثناءُ الأحرار غالٍ ثمين",41,"ن",1,0],["والذي يُستقى من النار غَوْرٌ","والذي نستقيه منك مَعين",41,"ن",1,0],["والذي قد أوجبَ اللَّهُ لكم","فوق ما أوجبتُ ما اخضرَّ فَنَن",42,"ن",1,0],["والذي لولاكَ أضحى لا يُرى","رَأيَ حَق إن في الدين سكن",43,"ن",1,0],["وَالَّذي أَوجَدَ هَذا اللُغزَ لُغزٌ مُبهَمُ","لا تُجادِل ذا الحِجا مَن قالَ إِنّي لَستُ أَدري",44,"ي",1,0],["وَالَّذي في الضُلوعِ مِن نيرانِ","صارَ ثَوبا وَمَقعَدا وَوِسادا",45,"ا",1,0],["وَالَّذي أَطرَبَهُم عَن قُدرَةٍ","باتَ لا يَقوى وَلا يَقتَدِرُ",46,"ر",1,0],["وَالَّذي كانَ بِنا مَعرِفَةً","لِصُروفِ الدَهرِ أَمسى نَكِرَه",47,"ر",2,0],["وَالَّذي نَفسُهُ بِغَيرِ جَمالٍ","لا يَرى في الوُجودِ شَيئاً جَميلا",48,"ل",2,0],["وَالَّذي أَطمَعَ اللَئيمَ وَأَغراهُ","بِسَبِّ الكِرامِ حُلمُ الكِرامِ",49,"م",1,0],["وَالَّذي صَيَّرَ الكَريمَ حَليماً","كِرهُهُ أَن يُعَدَّ صِنوَ الطَغامِ",49,"م",1,0],["وَالَّذي يُرضيكَ مَن تَلفي","هَيِّنٌ عِندي وَمَبذولُ",50,"ل",1,0],["وأَلذَّ الحَيَاةَ حينَ تغنِّي","نَ فأُصْغي لصوتِكِ المحزونِ",51,"ن",1,0],["والذي لا يُجاوِبُ الكونَ بالإِحساسِ","عِبْءٌ على الوُجُودِ وُجُودُهْ",52,"ه",1,0],["والذُّلُّ سُبَّةُ عارٍ","لا يرتضيهِ الكرامْ",53,"م",1,0],["وأَلذَّ مِنْ سِحْرِ الصِّبا","في بَسْمَةِ الطِّفلِ الغَريرْ",54,"ر",1,0],["وَأَلَذُّ مِن طَعم الخُضو","عِ عَلى فَمي السَمُّ النَقيعُ",55,"ع",1,0],["والذي آمنت ببعثته النا","س على خلفة من الاذواق",56,"ق",1,0],["والذي انشأ البرايا من الموت","معيد الى البوار البرايا",57,"ي",2,0],["والذي لا يرى الحقيقة اعمى","والذي ينكر الرشاد غوى",58,"غ",3,0],["والذي فيها يثير","الشعر حزن او سرور",59,"ر",1,0],["والذي ظل خافيا","هو اضعاف ما ظهر",60,"ر",1,0],["والذي شاهد الامو","ر غني عن الخبر",60,"ر",1,0],["والذي يجهل الطبيعة جهلا","راسخاً يحسب الرشاد مروقا",61,"ق",2,0],["والذي فيه قد اطال عذابي","كان خصما على عذابي قديرا",62,"ر",2,0],["وألُّذ فوق الطرس إن خطرت به","من ريشة الليثيّ فوق العود",63,"د",1,0],["والذ من مترنم","في فرعه ينشى الطرب",64,"ب",1,0],["والذي ينشئ الروايات دهر","كم له من فصولها تخييل",65,"ل",1,0],["وَالَّذي تَحرِصُ النُفوسُ عَلَيهِ","عالَمٌ باطِلٌ قَليلٌ مَتاعُه",66,"ع",2,0],["وَالَّذي مَرَّ بَينَ حالٍ قَديمٍ","أَنتَ أَدرى بِهِ وَحالِ جَديدِ",67,"د",1,0],["وَالذاكِراتُكَ ما حَيِينَ تَحَدُّثاً","بِسَوالِفِ الحُرُماتِ وَاللَآلاءِ",68,"ا",2,0],["وَالذَرُّ وَالصَخَراتُ مِمّا كَوَّرَت","وَالفيلُ مِمّا صَوَّرَت وَالخِرنِقُ",69,"ق",1,0],["وَالَّذي حَصَّلَ المُجِدّونَ إِهرا","قُ دِماءٍ خَليقَةٍ بِالصِيانَه",70,"ن",2,0],["وَالَّذي عِندَنا مِنَ المالِ وَالخَي","لِ فَمِنهُ هِباتُهُ وَقِيادُه",71,"د",2,0],["وَالَّذي قَطَّعَ الرِقابَ مِنَ الضَر","بِ بِكَفَّيكَ قَطَّعَ الآمالا",72,"ل",2,0],["وَالَّذي يَشهَدُ الوَغى ساكِنَ القَل","بِ كَأَنَّ القِتالَ فيها ذِمامُ",73,"م",1,0],["وَالَّذي يَضرِبُ الكَتائِبَ حَتّى","تَتَلاقى الفِهاقُ وَالأَقدامُ",73,"م",1,0],["وَالَّذي تُنبِتُ البِلادُ سُرورٌ","وَالَّذي تَمطُرُ السَحابُ مُدامُ",73,"م",1,0],["وَالَّذي رَيبُ دَهرِهِ مِن أُسارا","هُ وَمِن حاسِدي يَدَيهِ الغَمامُ",74,"م",1,0],["وَالذُلُّ يُظهِرُ في الذَليلِ مَوَدَّةً","وَأَوَدُّ مِنهُ لِمَن يَوَدُّ الأَرقَمُ",75,"م",1,0],["والذهب الرطب العزيز الذي","يقول قوم إنه الشمسُ",76,"س",1,0],["والذي كان به المو","ت به كان الحياة",77,"ه",1,0],["وألذُّ من عَلَقٍ يَدُرُّ وشخبُه","ثرٌّ عُقارٌ ذاتُها متفاني",78,"ن",2,0],["وألذُّ من رشقِ النِبَالِ لدَى الوغَى","رَمْيِي بتفاحٍ نحورَ غَواني",78,"ن",2,0],["وَالَّذي حَطَّني إِلى أَن بَلَغتُ ال","ماءَ ما كانَ مِن تَرَفُّعِ هَمّي",79,"ي",1,0],["وَالَّذي غُمَّ عَلى الناسِ فَلَم","يَعلَموا ما هُوَ شَيءٌ لَم يَكُن",80,"ن",1,0],["وَالَّذي صَيَّرَ المَلاحَةَ في خَد","دَيهِ وَقفاً وَالسِحرَ في أَجفانِه",81,"ن",2,0],["وَالَّذي يَملِكُ الأُمورَ جَميعاً","مَلِكٌ جَلَّ نورُهُ المَكنونُ",82,"ن",1,0],["وَالَّذي قامَ بِأَرزا","قِ الوَرى طُرّاً سَلوهُ",83,"و",2,0],["وَالَّذي فيهِ ما يُسَلّي ذَوي الأَح","زانِ عَن كُلِّ هالِكٍ مَفقودِ",84,"د",1,0],["وَالذِئبُ سَلَّمَ وَالجِنِّيُّ أَسلَمَ وَال","ثُعبانُ كُلَّمَ وَالأَمواتُ في الرُجَمِ",85,"م",1,0],["وَالَذي لَقَّبوهُ بِالأَبلَجِ الوَه","هابِ طَوراً وَالعابِسِ النَهّابِ",86,"ب",1,0],["وَالذِكرَ لِلأَطلالِ وَالرُسومِ","فَإِن تَكُن عَوني عَلى الهُمومِ",87,"م",1,0],["وَالَّذي جَمَّعَ الفَضائِلَ وَالحَم","دَ وَلِلمالَ في يَدَيهِ اِفتِراقُ",88,"ق",1,0],["والذي يبعث السرور ويدعو","كلَّ نفس للزهو والإكبارِ",89,"ر",1,0],["والذي أعبدُ منه غُرَّةً","كَنَدى الأزهار في الوجهِ الصبيح",90,"ح",1,0],["والذي أشتَمُّ منه غادياً","عَبقَ الأنداءِ في الوادي الصدوح",90,"ح",1,0],["والذي من صوتهِ في مسمعي","وخيالي غادرٌ حتى صداه",91,"ه",1,0],["والذي حُكمُه كأقدارِ عَيني","ك فما منهما ولا منه عاصم",92,"م",1,0],["والذي أعجزَ الأطبّاءَ داءٌ","فَقْدُ روحٍ به وَوِجدانُ جسمِ",93,"م",1,0],["والَّذي زارَ أرضَ طِيبَةَ يَغْشى","خدُّهُ قَبْرَ أحمدَ المُختارِ",94,"ر",1,0],["وَالَّذي هَمَّ خَصرُهُ بِاِنبِتاتٍ","فَثَناهُ الحَشا فَكادَ وَلَمّا",95,"م",2,0],["وَأَلَذُّهُم نُعمٌ إِلَينا واحِداً","وَأَحَبُّ مَن نَأتي وَمَن حَيّانا",96,"ن",2,0],["وَالذَوبُ مِن عَسَلِ الشُراةِ كَأَنَّما","غَصَبَ الأَميرُ تَبيعَهُ المُشتارا",97,"ر",2,0],["وَالَّذي جَرَّبَ المَواعِدَ قَد يَع","لَمُ مِنها أَن لَن تُنيلَ بِجودِ",98,"د",1,0],["وَالذئب وَحشٌ لَم يَزَل","يَضرى بِرائحة الدِماء",99,"ا",2,0],["وَالذِئبُ يَطرُقُنا في كُلِّ مَنزِلَةٍ","عَدوَ القَرينَينِ في آثارِنا خَبَبا",100,"ب",2,0],["والذي يسألون منه كتابٌ","مُنْزَلٌ قد أتاهم وارتقاءُ",101,"ا",2,0],["والذي تَقْرُبُ الأباعِدُ في الل","هِ إليه وَتَبْعُدُ القُرَباءُ",101,"ا",2,0],["والذِّئْبُ مِنْ طولِ الطَّوَى يَبْكي عَلَى","رِمَمِ المَواشي وابنُ دايَة ينعَبُ",102,"ب",1,0],["وَالّذي حَلَقَ أنصافَ اللِّحَى","كانَ في الأَحكامِ عَدْلاً مُنْصِفا",103,"ف",2,0],["والذِّئْبُ والعَيْرُ وَالموْلودُ صَدَّقَهُ","والظّبْىُ أَفْصَحَ نُطْقاُ وَهْوَ مُحْبُولُ",104,"ل",1,0],["والذَّرُّ والنَّمْلُ معَ جَمْعِ الحُبُوبِ كَذَا","والشَّعْرُ والصُّوفُ والأَرْياشُ والوَبَرُ",105,"ر",1,0],["والذّنْبُ في مَدْحٍ رأيتُكَ فوقهُ","أيُّ الرّجال يُقالُ فيكَ أصابا",106,"ب",2,0],["وَالَّذي يَبخَلُ عَنّي","بِقَليلٍ مِن كَثيرِ",107,"ر",1,0],["وَأَلَذَّ مِن إِنعامِ خُلَّةِ عاشِقٍ","نالَتهُ بَعدَ تَصَعُّبٍ وَشِماسِ",108,"س",1,0],["وَالذَنبُ ماغُفرانُهُ بِتَصَنُّعٍ","مِنّا وَلَكِن رَبُّنا الغَفّارُ",109,"ر",1,0],["وَالذِكرُ يَترُكُهُ الفَتى","لِلقاطِنينَ إِذا تَحَمَّل",110,"ل",1,0],["والّذي حارَتِ البَرِيّةُ فِيهِ","حَيَوَانٌ مُسْتَحْدَثٌ مِن جَمادِ",111,"د",1,0],["والذي لسْتُ أُسمِّي","هِ ولكنِّي أُكنّيهِ",112,"ي",2,0],["والَّذي برَّزَ في الفض","لِ غنيٌّ عن مُزَكِّي",113,"ي",1,0],["والّذي أرويهِ عن ظاهِرِ ما","باطني يَزْويهِ عن عِلْميَ زَي",114,"ي",1,0],["والذي قد قاد الملائك منهم","هو عزرائيلُ الذي لا يخور",115,"ر",1,0],["وَالَّذي كانَ عاجِز الرأي فدماً","فَهو إِن خابَ عاتب الأقدارا",116,"ر",2,0],["\"والّذي تنبت البلاد سرورٌ","والّذي يمطر السّحاب، مدام\"",117,"م",1,0],["والذي تلمحين من لَهبِ الشم","سِ غداً يطفئ الزمان ضرامَه",118,"م",2,0],["والذي تبصرينه من نجومٍ","فَلكٌ يرصدُ القضاءُ نظامَه",118,"م",2,0],["والذّئبُ يَسْأَلُنَا الشِّرَاكَ ودُونَهُ","طَيّانُ أشْعَثُ كالفَقيرِ البائس",119,"س",1,0],["والذكر يبقى للفتى برهة","وإن توارت في التراب الرمم",120,"م",1,0],["والذهب الصبّ كل ناحية","في البيت من مُخبَّأ ومدفون",121,"ن",1,0],["وَالذَّاهِبينَ الآيِبِ","ينَ بِمَا بَدَا وَبِمَا رُسِمْ",122,"م",1,0],["وَالَّذِي عَظَّمَهُ مِنْ قَدْرِهِ","كَانَ تَعْظِيماً لِقَدْرِ الأَدَبْ",123,"ب",1,0],["والذِي كَانَ بِاقْتِناصِ ضَوَارِي ال","غَابِ يُقْرِي الكِلاَب ذات الضَّرَاءِ",124,"ا",2,0],["والَّذِي زَانَ قَصْرَهُ بِقِطَافٍ","مِنْ رُؤُوسِ الأيَائِلِ العَفْرَاءِ",124,"ا",2,0],["وَالذُّخْرُ أَبْقَى الذُّخْرِ مَا خَلَّفْتَهُ","مِنْ فَاخِرِ الآثَارِ لِلأَبْنَاءِ",124,"ا",2,0],["والذنب للأيام في حدثانها","والذنب للأخلاق غير رواقي",125,"ق",2,0],["وألذ من كأس النديم","فهل أبحت الكأس شهدك",126,"ك",1,0],["وَالَّذي أَطلَعَ نَجمي","في سَماءِ المَجدِ أَهوى",127,"و",2,0],["والذي لو جحدتُ نُعماه حاشا","ي لقامتْ آلاؤه الغُرُّ تُثْني",128,"ي",1,0],["والذُّعرُ يعصفُ بالقُلوب كَمَا جَرتْ","هُوجُ الرِّياحِ على كَثِيبِ رِمال",129,"ل",1,0],["والذليل العبد دون الباب لا","يغمض الطرف ولا يضطجع",130,"ع",1,0],["وألذُّ طعْمًا من رُضَا","ب الغِيد، ربَّاتِ الحجال",131,"ل",1,0],["والذاهبات إلى الحقول حواسرًا","يمشي العفاف ورائهن رقيبا",132,"ب",2,0],["والذكريات تكر فيه وتنثني","ويتيه فيه الحب والعشاق",133,"ق",1,0],["والذي كان، كالذي امتد منه","نزرع الورد، شوكه يجتنينا",134,"ن",2,0],["وَالَّذي ينبِتُ البِلادُ سُرورٌ","وَالَّذي تَمطُرُ السَحابُ مُدامُ",135,"م",1,0],["والَّذائِدينَ عن الحياض إذا انتحَتْ","كُرَبٌ ، ولاذَ مُكابرٌ بفِرار",136,"ر",1,0],["والذي يخلَعُ الأصيلُ على الأرض","بكفِّ الدُّجى أخِيذٌ سليب",137,"ب",1,0],["والذي يَستمدُّ من عالم القريةِ","وَحياً وعيشةً لَلبيب",137,"ب",1,0],["والذين استنزَفوا طاقاتِهم","في المشقّات هُم كانوا الرجالا",138,"ل",2,0],["والذين اختَلقُوا أنّهُمُ","وحدَهُمْ مدُّوا إلى العرشِ حبالا!",138,"ل",2,0],["والذين افتَخروا أنَّهم","يَلبَسون \" الشعب \" ما شاؤا نِعالا",138,"ل",2,0],["والذين استَنْفَروا من حولهم","زُمراً عبَّأها الشرُّ رِعالا",138,"ل",2,0],["والذراعَينَ كلُّ ريانةٍ فعماءَ","تََلْقى في فَعمةٍ رَيّانه",139,"ن",2,0],["وَالذي صَيّرَ المَلاَحَةَ في خَ","دّيهْ،وَقْقاً والسّحْرَ في أجْفَانِهْ",140,"ن",2,0],["والذي أطمع اللّئيم وأغراه","بسبّ الكرام حلم الكرا",141,"ر",2,0],["والذي راح يحمل الظَّرْف والح","جَّة َ حمل الذكيِّ غير البليدِ",142,"د",1,0],["والذي لم يرثْ كريم المساعي","والعلا وابتناءها عن كَلالهْ",143,"ل",2,0],["والذي يأمن من المِطَال مرجّي","ه ولا يأمنُ المجاري مطالهْ",143,"ل",2,0],["والذي أطلق اللسان فعاتب","هُنَّ أخفى من مُستسرِّ الهباءِ",144,"ا",2,0],["والذي يسمع العنادل تشدو","ويرى أزهار الربيع سعيد",145,"د",1,0],["والذي حكمه كأقدار عينك","فما منهما ولا منه عاصمْ",146,"م",1,0]]}