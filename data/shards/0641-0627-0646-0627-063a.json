{"poems":[[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[48,"تسمى رشيدا من لؤي بن غالب","https://www.aldiwan.net/poem22329.html","الطويل"],[136,"عراني غرام شفني وبراني","https://www.aldiwan.net/poem54710.html","الطويل"],[369,"أحن إلى تلك الضحى والأصائل","https://www.aldiwan.net/poem60806.html","الطويل"],[412,"أرى دهري تفضل واستفادا","https://www.aldiwan.net/poem50182.html","الوافر"],[471,"ألا يا صبا نجد لقد هجت من نجد","https://www.aldiwan.net/poem50438.html","الطويل"],[556,"يا دار دار الصوم القوم","https://www.aldiwan.net/poem47200.html","السريع"],[556,"بلغنا ليلة الشعب","https://www.aldiwan.net/poem48050.html","الهزج"],[558,"وإني وإسماعيل يوم وداعه","https://www.aldiwan.net/poem68272.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48534","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93515","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201776","المنسرح"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129333","الطويل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[6181,"مسافر ومسافرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87686&r=&rc=1",""],[6225,"اعياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78099&r=&rc=156",""],[6259,"أرى دهري تفضل واستفادا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59368&r=&rc=16",""]],"verses":[["فإن أغد محزوم السهام فربما","غدا بيَ مُلقى غرة الصيد مُطعَمُ",0,"م",1,0],["فإنا غدونا نحمدُ اللَّه أوَّلاً","فواتحَ من حمدٍ بحمدك تُختَمُ",0,"م",1,0],["فَإِنَّ أَغانِيَّ اللَيالي نَيّاحَةٌ","وَمِنها بَسيطٌ مُقتَضىً وَنَشيدُ",1,"د",1,0],["فَإِنَّ أَغَاني الوُرقِ في دَوحِ أيكَةٍ","غَنَيتُ بَِهَا عَن حُسنِ كُلَّ أغَانِ",2,"ن",1,0],["فإنْ أغشَ قوماً بعدكُمْ مُتعَلِّلاً","على أنّ حُبيّكمْ عنِ الخَلْقِ شاغلي",3,"ل",2,0],["فَإِن أَغزلت كُنتَ لَها وِشاحاً","وَإِن أَجزَلت كُنتَ لَها نجادا",4,"د",2,0],["فَإِن أَغوَ لا تَكتُب عَلَيكُم غِوايَتي","أَجَل لا وَإِن أَرشُد فَلَيسَ لَكُم رُشدي",5,"د",2,0],["فإنْ أَغِبْ عن نصركمْ برهةً","بِمُرهفاتٍ لم أَغبْ بالفمِ",6,"م",1,0],["فإنْ أغنى فللفقرِ","وإنْ أقعى فللوثبِ",7,"ب",1,0],["فَإِن أَغشَ قَوماً بَعدَهُم أَو أَزُرهُمُ","فَكَالوَحشِ يَستَدنيهِ لِلقَنصِ المَحلُ",8,"ل",1,0],["فإن أغفيت نبَّهني مخيفاً","صياح الثاكلات الباكيات",9,"ت",1,0],["فَإِنا غَير ريك ما اِنتَجعنا","وَلا شمنا سِواه سناً أَضاءا",10,"ا",3,0],["فإن أُغيّر زيّي ليقبلني","فكيف تغيير طبعيَ الحر",11,"ر",1,0],["فان أغش قوما بعدهم أو أزورهم","فمن عكس حظي واختلاف نصيبي",12,"ب",2,0],["فإن اغضاب الطبيب مردى","اذا طلبت فاجملى في الطلب",13,"ب",1,0],["فأنا غريب قد هربت من الأسى","ودفنت أحلامي قتلت إرادتي",14,"ت",2,0],["فأنا غارقُ الهواءِ , ضميرُ ال","غيبِ في كفِّيَ احتواهُ السُّكوتُ",15,"ت",1,0],["فإن أغزلت كنتَ لها وشاحاً","وإن أجزلت كنت لهُ نجادا",16,"د",2,0]]}