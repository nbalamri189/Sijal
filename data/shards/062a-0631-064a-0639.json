https://poetry.dctabudhabi.ae/diwan/poem/92397","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91767","الطويل"],[3741,"","https://poetry.dctabudhabi.ae/diwan/poem/121173","الوافر"],[3811,"","https://poetry.dctabudhabi.ae/diwan/poem/146442","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105558","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86395","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119610","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127072","المتقارب"],[4366,"","https://poetry.dctabudhabi.ae/diwan/poem/31513","الوافر"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104513","الهزج"],[4919,"انطرني يا قمر يوم العيد","https://www.poetsgate.com/ViewPoem.aspx?id=34725",""],[5112,"خلاصة العرب","https://www.poetsgate.com/ViewPoem.aspx?id=211997",""],[592,"ألا بلغا عن جميلاً رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=128827",""],[5461,"كلٍ يعوّد لاصل جدّه ومرباه","https://www.poetsgate.com/ViewPoem.aspx?id=5307",""],[5582,"أَيْصْدُقُ هَذا الطَّيْفُ أَمْ هوَ يَكْذِبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186668",""],[5756,"الحلم","https://www.poetsgate.com/ViewPoem.aspx?id=5179",""],[5916,"سَلُوْ بَلْقَيْسَ","https://www.poetsgate.com/ViewPoem.aspx?id=190525",""],[5956,"لا تستحقك لا أرضٌ ولا شهبُ","https://www.poetsgate.com/ViewPoem.aspx?id=208505",""]],"verses":[["تَرَي عَزمِيَ مِثلَ السَي","فِ مَشحوذَ الغِرارَينِ",0,"ن",1,0],["تَرى عَلى عاري العِظا","مِ وَسمَها وَهيَ رِمَم",1,"م",1,0],["تَريعُ إِلى دَرادِقَ عاطِلاتٍ","وَهُنَّ بُعَيدَ آوِنَةٍ حَوالي",2,"ل",2,0],["تُريعُ كَما اِلتَفَتَت ظَبيَةٌ","بِذي البانِ عَنَّ لَها المَورِدُ",3,"د",1,0],["تَرى عِندَها الشَهرَ الحَرامَ مُحَلَّلاً","إِذا خَفَرَتها لِلوَغى عَزَماتُها",4,"ت",3,0],["تَرى عَلى الكأسِ إِذا صُفِّقَتْ","وَالحَبَبُ الطَّافي بِأَرجائِها",5,"ا",3,0],["تَريعُ إليهِ كلُّ مُمْسًى ومُصْبَحٍ","حَصَانٌ تَشُقُّ الأتْحَميَّ المُعَضَّدا",6,"د",2,0],["تَريعُ هَواديها إليهِ ودُونَها","مَدًى في حَواشِيهِ المُقَصِّرُ يَدْلِثُ",7,"ث",1,0],["تَريعُ شَوارِدُ الكَلِمِ البَواقي","إليَّ فَلا اجْتِلابَ ولا انتِحالا",8,"ل",2,0],["تَرَى عُيونَ الماءِ عُمْشاً بِها","وأعْيُنُ النّيرانِ لا تَنْطِقُ",9,"ق",1,0],["تَرى عَينَها صَغواءَ في جَنبِ مُؤقَها","تُراقِبُ في كَفّي القَطيعَ المُحَرَّما",10,"م",2,0],["تَرى عُصَبَ القَطا هَمَلاً إِلَيهِ","كَأَنَّ رِعالَهُ قَزَعُ الجَهامِ",11,"م",1,0],["تَريعُ لَهُ رَيعَ الهِجانِ وَأَقبَلَت","لَها فِرَقُ الآجالِ مِن كُلِّ مَقبَلِ",12,"ل",1,0],["تَريعُ لَهُ أُمٌّ كَأَنَّ سَراتَها","إِذا اِنجابَ عَن صَحرائِها اللَيلُ يَلمَقُ",13,"ق",1,0],["ترى عمريّ المنتمى عدويه","ففيه المعالي تتبع الفرع أصله",14,"ل",2,0],["تَريعُ الغُزاةُ وَما إِن يَري","عُ مُضطَمِراً طُرَّتاهُ طَليحا",15,"ح",2,0],["تَريعُ إِلى صَوتِ المُنادي خُيولُهُم","إِذا ضُيِّعَت عوذُ النِساءِ وَحولُها",16,"ل",3,0],["تَرى عِندَها أَنّي عَلى العَهدِ ثابِتٌ","وَإِن يَكُ هَذا البَينُ أَوهى عِظامِيا",17,"ي",2,0],["تريعُ إليه بهادي الجموح","وبُهْرَته وهو صِفْرُ الوِطابْ",18,"ب",1,0],["تَرى عُرى التَدبيرِ يَحكَمنَ عَن","مُقتَصِدٍ فيما يُعاني شَفيق",19,"ق",1,0],["تَرى عافِياتِ الطَيرِ قَد وَثَّقَت لَها","بِشِبعٍ مِنَ السَخلِ العِتاقِ مَنازِلُه",20,"ل",2,0],["تَرى عِمادَ الكُفرِ مِن سَيفِهِ","مُنَكَّساً باطِلَهُ واهي",21,"ا",3,0],["ترى عدواً دعا علينا","بدعوةٍ صادفَتْ نفاذا",22,"ذ",2,1],["تَرى عَلَيهِنَّ حَليَ الدُرِّ مُتَّسِقاً","مَعَ الزَبَرجَدِ وَالياقوتِ كَالشُهُبِ",23,"ب",1,0],["ترى عُقْبَى الأذى فتفيضُ غَمّاً","وتَقذِفُ بالنُّفوسِ دَماً سخينا",24,"ن",2,0],["تريع ولم يعطفك غيرك عاطف","وتعطي ولم يسألك غيرك سائل",25,"ل",1,0],["تَرى عَلى أَفخاذِها سِماتِها","مُنَدَّياتٍ وَمَحَمِّيّاتِها",26,"ت",3,0],["تَرى عِندَنا ما يَكرَهُ اللَهُ كُلَّهُ","سِوى الشُركِ بِالرَحمَنِ رَبِّ المَشاعِرِ",27,"ر",1,0],["تَرى عِندَنا ما يُسخِطُ اللَهَ كُلَّهُ","مِنَ العَمَلِ المُردي الفَتى ما خَلا الشِركا",28,"ك",2,0],["تُريعُ بِخَطبِهِ كِسَرَ المَوالي","وَتَرقُصُ لِلعَصيرِ وَلِلسِمارِ",29,"ر",1,0],["تَرى عَلَيهِ سيما النَبِيِّ وَإِن","حارَبَ قَوماً أَذكى لَهُم لَهَبا",30,"ب",2,0],["تَرى عَلَيهِ جَلالاً مِن أُبُوَّتِهِ","وَنُصرَةً مِن يَدٍ تَندى وَتُنتَهَبُ",31,"ب",1,0],["تَرى عافِياتِ الطَيرِ قَد وَثِقَت لَها","بِشَبعٍ مِنَ السَخلِ العِتاقِ الأَكائِلِ",32,"ل",1,0],["تَريعُ لَها أَجنادُ إِبليسَ رَغبَةً","وَتَنفُرُ جَرّاها المَلائِكُ جُفَّلا",33,"ل",2,0],["تَريعُ إِلى صَوتِ المُهيبِ وَتَتَّقي","بِذي خُصَلٍ رَوعاتِ أَكلَفَ مُلبِدِ",34,"د",1,0],["ترى عيني بكفِّ الموت قوساً","بها سهم إلى جهتي سديد",35,"د",1,0],["تَرى عَلِمَت عُبَيلَةُ ما أُلاقي","مِنَ الأَهوالِ في أَرضِ العِراقِ",36,"ق",1,1],["تُرى علَّتيهِ غارَتا فَأَغارَتا","عَلى واحِدٍ لَو عاشَ لي لَكَفاني",37,"ن",2,0],["تُريع بخَطْبِهِ كِسَرَ الْمَوَالِي","وترقص للعصير وللمسار",38,"ر",1,0],["تريع إلى صوت المهيب وتتقي","بذي خصلٍ روعات أكتف ملبد",39,"د",1,0],["تريع عدوها بشديد بأس","يشب به لدى الفتك السعير",40,"ر",1,0],["تُرى على شَفَتِي مِنْ ثَغْرِها قُبَلُ","وفي عيوني لإدمانِ الهَوى ثَمَلُ",41,"ل",1,1],["تَرى عِندَهُ رُسلَ المُلوكِ مُقيمَةً","ذَهابُ رَسولٍ عِندَ آخرِ آيبِ",42,"ب",1,0],["تَرى عِندَهُ ما عِندَهُم مِن فَضِيلَةٍ","وَفيهِ خِلالٌ فَوقَها وَخِلالُ",43,"ل",1,0],["تَرى عِندَ المَديحِ لَهُ اِهتِزازاً","كَما يَهتَزُّ لِلضَربِ الحُسامُ",44,"م",1,0],["ترى عائباً إن أنت فتّشت عقله","ضلالاً وجهلاً غائبا وهو حاضر",45,"ر",1,1],["ترى عيشيَ المغبر يرجع اخضرا","وبالمقلة السودا ارى عينها الزرقا",46,"ق",2,0],["ترى على القرب فندقا","يمثل الأرض والبشر",47,"ر",1,0],["تُرى عِندَهُ خَدماً وَقصوراً","وَلَستَ تَرى شَرفاً عِندَه",48,"د",2,0],["تَرَى عِذارَيه ما قاما بَمَعْذِرتي","عند العذولِ فيغدو وهو يَعذِرُني",49,"ن",2,1],["تُرى عندهم علمٌ وإن شَطَّت النّوَى","بأنّ لهم قلبي عليّ رَقيبُ",50,"ب",1,0],["ترى عيني مرابعها","ولا تسعى لها قدمي",51,"ي",1,0],["تُرى عِندَهُم أَنَّ العَذابَ غَرامُ","كَما عِندَنا أَنَّ الفِراقَ حِمامُ",52,"م",1,1],["تَرى عِندَكُم في الحُب بَعض الَّذي عِندي","سَأَشكو لَكُم ما بي وَإِن لَم يَكُن يُجدي",53,"د",2,1],["ترى عالماً فاضلاً عاملاً","وملكاً عظيماً حوى ما حوى",54,"ا",1,0],["ترى علمت ماذا لقيت من الهوى","وما جفلت يوم الوداع جفونها",55,"ن",3,0],["ترى علمت جفونك في فؤادي","غداة البين ما فعل الوداعُ",56,"ع",1,0],["ترى علمت ماذا لقيت من الهوى","وهل عندها علمٌ بما فعل الهجر",57,"ر",1,0],["ترى عند أحباب بلبنان ختموا","كما عند حبٍ حلّ في مجدل الشمسِ",58,"س",1,1],["ترى عينُه وجهاً صديقاً من الهوى","ويلقَى عدوَّ السمعِ ما تأمرينَهُ",59,"ن",2,0],["ترى عارَه دَرَناً لا يماط","بغير الدماء فلا يُغسلُ",60,"ل",1,0],["تَريعُني نسمَةُ حِبِّي كَلَفاً","شَمِمْتُمو النَّسمَةَ تَطوي كَلَفَا",61,"ف",2,0],["ترى عند نجم الدين علم بما عندي","له من جزيل الحمد أو خالص الود",62,"د",1,1],["تَرى عَجَباً في غِبطَة ان نَزورُها","وَنَحنُ بِها مِنها اسرُّ واعجَبُ",63,"ب",1,0],["ترى عينُهُ حُفَرَ الضَّريحِ وقلبُهُ","هنالِكَ مشغولٌ بأنْ يبتني قَصْرا",64,"ر",2,0],["تُرَى عيني تَرَى مَن لا أَراهُ","كما حَكَمَ القَضاءُ ولا يَراني",65,"ن",2,0],["تُري عَينَ الفَتى جَنّاتِ عَدنٍ","وَتُصلي قَلبَهُ نارَ الجَحيمِ",66,"م",1,0],["تُرى عَنهُ الكتائبُ حائداتٍ","إذا اشتَمَلَت بما نَسَجَ الغُبار",67,"ر",1,0],["تَرى عَجائِبَ مِن أَفعالِ مجدِهُمُ","لَولا العَيانُ أَباها كُلُّ قَيّاسِ",68,"س",1,0],["ترى عجباً منها ومنهم بجوفها","بحال سكونٍ منه أو هو مزبدُ",69,"د",1,0],["ترى عرضه نحو عشرين بردا","وذلك حتم بنص الشرائع",70,"ع",1,0],["ترى عرضاً أم جوهراً فأجابه","أرى جوهراً لا شك فيه ولا نكر",71,"ر",1,0],["ترى عنده قس الفصاحة باقلاً","وشمساً كنبراس وليثاً كتنفل",72,"ل",1,0],["ترى عيانا وأحاديتها","للطيب في الأسماع أسمارُ",73,"ر",1,0],["تَرَى عُرْفَه نُكْراً وجِدَّتَه بِلى","وأقوله خبَّا وراجيه خائبا",74,"ب",2,0],["تَرى عافِياتِ الطَيرِ يَحجِلنَ حَولَهُم","يُقَلِّبنَ أَجساماً قَليلاً لُحومُها",75,"م",3,0],["ترى عِندَهُ الدُّنيَا جَمِيعاً بأَسرِها","وزُخرِفِها كأنَّهُ حبُّ فُلفُلِ",76,"ل",1,0],["تَرى عُفاة الغنى إِذا رحَلت","إلى ذراهُ الرَّحيب مَقصِدُهَا",77,"د",3,0],["ترى عليهم إمارات العلى وكفي","أن تلمح النبل فيهم أينما كانوا",78,"ن",3,0],["ترى علماء الدين حتفاً تتابعوا","وحسب الهدى عنهم بأنَّك سالمُ",79,"م",1,0],["ترى علّة المكث للضيف فيه","طيبَ القِرى فهو لا ينصرف",80,"ف",1,0],["تُرى عِندَ مَن أَحبَبتُهُ لا عَدِمتُهُ","مِنَ الشَوقِ ما عِندي وَما أَنا صانِعُ",81,"ع",1,1],["ترى علقاً تغشى النفوس رشاشه","اذا انفرجت من بعدهن الجوانح",82,"ح",1,0],["ترى على العهدِ أهلُ الودِّ أم خانوا","وحال حُبُّهمو أم هم كما كانوا",83,"ن",3,1],["ترى علماً علا علماً جواداً","تقياً ناسكاً براً ودودا",84,"د",2,0],["ترى علموا أني فقدت خيالهم","لفقدي الكرى، فالطيف نحوي لا يسري",85,"ر",2,0],["ترى عظماء الناس للفضل خشعا","إذا ما بدا والفضل لله خاشع",86,"ع",1,0],["ترى عين الهدى فيها ضلالي","ورشدي أن أبيت بها غَوِيَّا",87,"ي",2,0],["ترى عابد الرحمن في كل حالة","تميل به الأرواح كالغصن النضر",88,"ر",1,0],["ترى عليها كثرة الملاعق","تقرع بالأسنان كالصواعق",89,"ق",1,0],["تريع إلى الذرعان فيها قراهب","إلى رفض آجال النعام السوارح",90,"ح",1,0],["تَرى عَبَداتِهِنَّ يَعُدنَ حُدباً","تَناوِلُها الغَلاةُ اِلى الغَلاةِ",91,"ه",1,1],["تُرى عَلِمتْ ذاتُ الدمالِج حَالتي","فتسْمَحُ لي من طيفها بمحالِ",92,"ل",1,1],["ترى على بابه الأعلام عاكفةٌ","من كل ملتحف بالمجد متزر",93,"ر",1,0],["تَرَى عليهَا يا أخِي الفَرَاقِد","تِسعَةَ بالتحقيقِ غَيرَ زايد",94,"د",1,0],["تَرَى على بَندَرَهَا جَزِيرَه","مُنعَزِلَه عَالِيَةً كَبِيرَه",95,"ه",1,0],["تُرى عشقتكَ أَبكارُ المَعاني","فَجئنكَ يَبتدِرنَ بِلا سُؤالِ",96,"ل",1,0],["تريع كما ريع ظبي النقا","توجهه خيفة واستتارا",97,"ر",2,0],["ترى عينه عين العيون مشهدا","عياناً وبحث الحق ليس بغائب",98,"ب",1,0],["ترى عدن للحرّ كالوخز في الجفن","غريبٌ بها الأهلون حالٌ لنّا تضني",99,"ن",2,1],["تَرى عِيالا سرحاً رِجاله","كَذاكَ أَطفالاً وَكَم خَياله",100,"ه",1,0],["ترى عندكم للحب مثل الذي عندي","وهل وجدكم بي مثلما بكم وجدي",101,"د",2,1],["ترى على منكب هذى الصوره","نجما تليه انجم صغيره",102,"ه",1,0],["ترى على قرنيه كوكبين","يرى دوين انور الاثنين",102,"ن",1,0],["ترى على المظلم منه نجما","لقبه الاعراب كفا جذما",102,"م",2,0],["تريع قُلوبَ الملا سَطوَتي","وَيؤمنها بِشر أَخلاقيَه",103,"ي",2,0],["تُرى عن يقين أَنتَ عندي مواصلي","بغير رقيب بعد ذاكَ التباعد",104,"د",1,0],["تَرى عَودة من بَعد بُعدٍ مبرّحٍ","ليشفَى بِها قَلبٌ بنار النَوى اِكتَوى",105,"و",2,0],["ترى علمت أحبائي بأني","أقاسي في النوى ما لا يطاقُ",106,"ق",1,1],["ترى عليها لباس الذل مذ بنيت","بالشط ممنوعة من عزة الطلب"