ttps://www.aldiwan.net/poem60039.html","الكامل"],[478,"أرقت من بارق بالجزع لماع","https://www.aldiwan.net/poem15184.html","البسيط"],[484,"ألا ترين وقد قطعتني قطعاً","https://www.aldiwan.net/poem2069.html","البسيط"],[486,"إني أتتني لسان لا أسر بها","https://www.aldiwan.net/poem1121.html",""],[496,"قبحا لهذا الزمان ما أربه","https://www.aldiwan.net/poem9768.html","المنسرح"],[501,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[501,"للروح من روح ريح الحب ريحان","https://www.aldiwan.net/poem37759.html","البسيط"],[516,"فرض على الشعر أن يبدا بما يجب","https://www.aldiwan.net/poem12013.html","البسيط"],[516,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[530,"ما بال بري بتعليم الفنون غدا","https://www.aldiwan.net/poem37538.html","البسيط"],[552,"يا حادي العيس عرج بي على الدمن","https://www.aldiwan.net/poem47163.html","البسيط"],[552,"ما صيد قلبك إلا بابنة الكلل","https://www.aldiwan.net/poem47265.html","البسيط"],[552,"ريعت لتنعاب الغراب الهاتف","https://www.aldiwan.net/poem47390.html","الكامل"],[552,"ما زرت إلا خداعا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"],[552,"بالله يا أيام يثرب عودي","https://www.aldiwan.net/poem47844.html","الكامل"],[554,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[554,"أغرى به الشوق ليل الساهر الرمد","https://www.aldiwan.net/poem68425.html","البسيط"],[554,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[559,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[559,"تستر السر بإفشائه","https://www.aldiwan.net/poem33527.html","السريع"],[559,"أهل المحبة في السرور الدائمِ","https://www.aldiwan.net/poem33857.html","الكامل"],[563,"نهنه دموعك أيها الباكي فما","https://www.aldiwan.net/poem52751.html","الكامل"],[563,"بغداد أيتها الركاب فبادري","https://www.aldiwan.net/poem52940.html","الكامل"],[563,"المال يفرق بين الأم والولد","https://www.aldiwan.net/poem52953.html","البسيط"],[568,"بكرت تلوم ومثلها لك لائمه","https://www.aldiwan.net/poem69523.html","الرجز"],[576,"جاد وما ضن عليه ضناه","https://www.aldiwan.net/poem2996.html","السريع"],[576,"ما هزة الغصن إلا ملك هزته","https://www.aldiwan.net/poem3094.html","البسيط"],[587,"لو رمت إبقاء الوداد بحاله","https://www.aldiwan.net/poem17687.html","الكامل"]],"verses":[["لا يَعصِمُ العقلَ تقديسُ العُقولِ له","حقائقُ اليوم تَنفيها العلومُ غَدا",0,"د",2,0],["لا يَعقُدُ المِئزَرَ في حادِثٍ","وَلا يَرى النَصرَ وَلَو بِالكَلام",1,"م",1,0],["لا يَعرِفُ الرَحلَ لَهُ سَناما","وَلّى الأَعادي مَنكِباً حَطّاما",2,"م",2,0],["لا يُعابُ المُقِلُّ وَهوَ قَنوعٌ","وَيُعابُ الغَنِيُّ وَهوَ حَريصُ",3,"ص",1,0],["لا يعلَمُ اللُّؤَماءُ أينَ مُعَرَّسي","وبأيّ وادٍ مَرْبَعي ومَصيفي",4,"ف",2,0],["لا يَعْبُدُ المَرْءُ رَبّاً لا ولا وَطَناً","بِمِثْلِ إِغْلائِهِ القُربَانَ تَقدِيمَا",5,"م",2,0],["لا يَعرِفُ العَفوَ إِلّا بَعدَ مَقدِرَةٍ","وَلا يُعاقِبُ حَتّى تَنجَلي التُهَمُ",6,"م",1,0],["لا يعرف الأين منه أين موقعه","ولو يواصل ادلاجاً بتأويب",7,"ب",1,0],["لا يُعجِبَنَّكَ أَن تَرى لِمُجاشِعٍ","جَلَدَ الرِجالَ فَفي القُلوبِ الخَولَعُ",8,"ع",1,0],["لا يعرف الناس بعلاً من حليلته","وأين ذو كبرة منها ومقتبلُ",9,"ل",1,0],["لا يُعَلَّلنَ بِالمَغافِرِ وَالصَم","غِ وَلا نَقفِ حَنظَلِ الشَريانِ",10,"ن",1,0],["لا يعدم الفضل منه أيّ متجرٍ","ولا رقومَ المعاني أيّ نساج",11,"ج",1,0],["لا يعدم الشام اقْتتال وزارةٍ","يسعى بها الوسميّ من حول الولي",12,"ي",1,0],["لا يعدم الدهر الأخير بدائعاً","تنهال بين سماحةٍ وبيان",13,"ن",1,0],["لا يعدم المدح من قاضي القضاة لهىً","لا يدّعي حصرها نظم الدواوين",14,"ن",1,0],["لا يعدم العافون يُمنكْ","في كلّ مقصدهم ومنّكْ",15,"ك",1,1],["لا يَعرِفُ الحَقَّ إِلّا مَن يَعرِّفُهُ","لا يَرِفُ القِدَمِيَّ المُحدَثُ الفاني",16,"ن",2,0],["لا يُعجبنَّك ما صنعتَ فإنما","داويتَ داءَك يا شقيُّ بداءِ",17,"ا",2,0],["لا يَعُدُّ الصوابَ أن تغمر الثرْ","وةَ إلا ذوي العقولِ الخرَابِ",18,"ب",1,0],["لا يعجبنَّك حسنُ ما قدَّمتَه","فتسيءَ بعدُ إساءةً تجتاحُهُ",19,"ح",2,0],["لا يَعْدَمُونَ مقَالَةً من قائلٍ","ما أَحْسَنَ الصَّفَحَاتِ والمُتصَفَّحا",20,"ح",2,0],["لا يَعْدَمِ النَّاسُ جَدَا مَانحٍ","لِلْعُرْفِ واسْتِبْشَارَ مَمْنُوحِ",21,"ح",1,0],["لا يُعرض القوم عن ثناه ولا","يَملّ سُمَّارُ ذكره سمره",22,"ر",2,0],["لا يعرف الوهيَ والسقوط ولا","يخذُل ألواحُ ساجه دُسُره",22,"ر",2,0],["لا يعرف الناس إقلالَ العييِّ لهُ","حاشاه ذاك ولا إكثار مِهْذار",23,"ر",1,0],["لا يُعِدُّ الرشا لها نائكُوها","هي أولى بأن تُنَاكَ وتَرشو",24,"ش",2,0],["لا يُعدمون أثيثَ الريش جارَهُمُ","إذا تحيَّفتِ الريشَ المفاريض",25,"ض",1,0],["لا يعدمون صنيعة مصنوعة","تهدي إليهم منطقاً مصنوعا",26,"ع",2,0],["لا يعرف القِرنُ وجهه ويرى","قفاه من فرسخ فيعرفه",27,"ف",2,0],["لا يعتبد أحد شعري بنائله","فإنه بأبي العباس مظلوف",28,"ف",1,0],["لا يعجب الناس من وجدي ومن قلقي","إن المشوق إلى أحبابه قلق",29,"ق",1,0],["لا يَعْجَبِ الناسُ أن تسودَهُمُ","حقُّ أياديك أن تطيلَ يدكْ",30,"ك",1,0],["لا يعدموك فقد نصحْتَ إمامَهم","ووضعْتَ إصْرهُمُ وكان ثقيلا",31,"ل",2,0],["لا يعْزُبُ الرأيُ عن بديهته","يوما إذا ورْدُ حادثٍ دَهَما",32,"م",2,0],["لا يعْدَمُ الدهرَ صحواً يستبينُ به","حقّاً عليه من الإلباس أكنان",33,"ن",1,0],["لا يَعجَبَن أحَدٌ لخيْبةِ وجهِهِ","هل كان عَبْداً مُقْرناً بخُذاه",34,"ه",1,0],["لا يَعجَبَن أَحَدٌ رَآني حافِياً","أَبلَت نِعالي أَلسُنُ السُفَهاءِ",35,"ا",2,0],["لا يَعرِفونَ مِنَ الشَجاعَةِ","غَيرَ ما عَرِفَ القُرود",36,"د",1,0],["لا يُعَدُّ الوَرى عَلَينا اللَيالي","نَحنُ قَومٌ نَعيشُ في الأَزمانِ",37,"ن",1,0],["لا يَعذَبُ الشِعرُ إِلّا حينَ يَنظُمُهُ","أَو حينَ يُنشِدُهُ أَو حينَ يَرويهِ",38,"ي",2,0],["لا يَعرِفُ الهَمَّ فَتىً يَعرِفُهُ","وَلا تَرى نَديمَهُ نَدمانا",39,"ن",2,0],["لا يَعرِفُ المَدحَ مِنَ الهِجاءِ","أَفعالُهُ الكُلُّ عَلى اِستِواءِ",40,"ا",2,0],["لا يَعْرِفُ المَرْءُ مِنها","لَيْلاً رأى أمْ نَهارا",41,"ر",2,0],["لا يعرفُ الشَّكوى الذليلَة والبكا","وضراعَة الأَطفالِ والضّعفاءِ",42,"ا",2,0],["لا يَعدُكُم رَوضٌ مِنَ الحَظّ في ال","إِكرام وَالتَرفيع ممطُورُ",43,"ر",1,0],["لا يعرف المؤلمن في","الحياة الا المؤلم",44,"م",1,0],["لا يعرف الانسان كم","مرت عليه من حقب",45,"ب",1,0],["لا يعرف الشعر سوى","من راضه حتى تعب",45,"ب",1,0],["لا يعترضني أحد إنني","غضبان في يومي على أمسى",46,"س",2,0],["لا يعرف العيش حتى ينقضى فنرى","صدق الحياة بعين الموت والكذبا",47,"ب",2,0],["لا يَعرِفُ الناسُ لَهُ الفُتُوَّه","وَلَيسَ مِمَّن يَدَّعونَ القُوَّه",48,"ه",1,0],["لا يُعادى وَيُتَّقى أَن يُعادى","وَيُخَلّي سَبيلَ مَن لَم يُوالِه",49,"ل",2,0],["لا يُعجِبَنَّكَ ما تَرى مِن قُبَّةٍ","ضَرَبوا عَلى مَوتاهُمُ وَطِرافِ",50,"ف",1,0],["لا يَعدِلَنَّ المُلكَ في شَهَواتِكُم","عَرَضٌ مِنَ الدُنيا بَدا وَحُطامُ",51,"م",1,0],["لا يُعجَبَنَّكُمُ ساعٍ بِتَفرِقَةٍ","إِنَّ المِقَصَّ خَفيفٌ حينَ يَقتَطِعُ",52,"ع",1,0],["لا يُعجِبَنَّكُمُ الجاهُ الَّذي بَلَغوا","مِنَ الوِلايَةِ وَالمالُ الَّذي جَمَعوا",52,"ع",3,0],["لا يَعرِفونَ بَينَهُم","أَصلاً لَهُ مِن ثَمَرَه",53,"ر",2,0],["لا يَعتَقي بَلَدٌ مَسراهُ عَن بَلَدٍ","كَالمَوتِ لَيسَ لَهُ رِيٌّ وَلا شِبَعُ",54,"ع",1,0],["لا يَعرِفُ الرُزءَ في مالٍ وَلا وَلَدٍ","إِلّا إِذا حَفَزَ الأَضيافَ تَرحالُ",55,"ل",1,0],["لا يُعجِبَنَّ مَضيماً حُسنُ بِزَّتِهِ","وَهَل يَروقُ دَفيناً جَودَةُ الكَفَنِ",56,"ن",1,0],["لا يُعمِلُ القَولَ المُكَرَّ","رَ فيهِ وَالرَأيَ المُرَدَّد",57,"د",1,0],["لا يَعجِبَنَّكَ قَومٌ أَنتَ بَينَهُمُ","فَلَستَ مِنهُم عَلى عَينٍ وَلا أَثَرِ",58,"ر",1,1],["لا يُعَنّي نَفسَهُ مِن أَسَفٍ","إِثرَ حَظٍ فاتَ أَو وَفرٍ هَلَك",59,"ك",1,0],["لا يَعدَمُ العافونَ حَيثُ تَوَجَّهوا","يَدَكَ الهَتونَ وَوَجهَكَ الضَحّاكا",60,"ك",2,0],["لا يَعلِفُ الخَيلَ مَشدوداً رَحائِلُها","في مَنزِلٍ بِنَهارٍ غَيرَ تَأويبِ",61,"ب",1,0],["لا يعمل النظر الحديد ولا يرى","فيما عناه تكلف الإطراق",62,"ق",1,0],["لا يعدمنّك ذو الوفاق موافقا","ما ترتضيه وذو العناد معاندا",63,"د",2,0],["لا يَعرِفُ العَدْلَ وهو مُعتَدِلُ","فمِثلُهُ في فِعالِه مَثَلُ",64,"ل",1,1],["لا يُعجِبَنَّكَ دينارُ المديحِ ولم","يَضْرِبْهُ باسمِكَ دونَ الناسِ ضارِبُه",65,"ب",2,0],["لا يعرفُ الغَدرَ ما ضُمَّتْ جوانِحُه","على الوفاءِ ولا يُبْقي إذا وَثَبا",66,"ب",2,0],["لا يَعرِفُ الآلامَ فيها مَرَّةً","كَلّا وَلا جَرَتِ الهُمومُ بِفِكرِهِ",67,"ر",2,0],["لا يُعجِبَنَّكَ ما تَرى فَكَأَنَهُ","قَد زالَ عَنكَ زَوالَ أَمسِ الذاهِبِ",68,"ب",1,0],["لا يُعجِبَنَّكَ يا ذا حُسنُ مَنظَرَةِ","لَم يَجعَلِ اللَهُ فيها حُسنَ مَخبَرَةِ",69,"ر",2,1],["لا يَعرِفُ الحَمّامَ لَكِنَّهُ","في البَيتِ يَحمي الماءَ في الشَمسِ",70,"س",1,0],["لا يَعرِفُ العُذرَ عَن إِسعافِ ذي أَمَلٍ","يَوماً وَلَكِنَّهُ يُعطي وَيَعتَذِرُ",71,"ر",1,0],["لا يَعرِفُ العَفوَ إِلّا بَعدَ مَقدَرَةٍ","وَلا يَرى العُذرَ إِلّا بَعدَما يَهَبُ",72,"ب",1,0],["لا يَعْرِضُ المطلُ لانجازه","ولا يشين المنّ منه امتنان",73,"ن",1,0],["لا يعرفُ النّاظرُ أغصانَها","إذا تثنتْ من قدودِ الملاح",74,"ح",1,0],["لا يعرفونَ لهُ قدراً وعفتُهُ","يخشَونَ إعداءها للناسِ كالجربِ",75,"ب",1,0],["لايَعبُرُ الطَرفُ فيهِ","غَيرَ المَجَرَّةِ جِسرا",76,"ر",2,0],["لا يعرفون خُذوا وليس لهم سوى","أن يُؤْمَروا ذُوقوا العذاب وهاتوا",77,"ت",3,0],["لا يعرِفون سوى الإيمان منزلةً","تعلو النفوسُ بها أو تعظم القيَمُ",78,"م",1,0],["لا يُعجبنَّك عفوٌ نِلتَ عاجلَهُ","فما عفا الدّهرُ عن جانٍ ولا صفحا",79,"ح",2,0],["لا يَعبَثِ اليَومَ بِاِستِقلالِكُم أَحَدٌ","وَلا يَغُرَّكُمُ التَضليلُ وَالمَلَقُ",80,"ق",1,0],["لا يَعرِفُ الناسُ هَل جاءوا بِبَيِّنَةٍ","مِن رائِعِ القَولِ أَم جاءوا بِإِنجيلِ",81,"ل",1,0],["لا يَعجَبِ الفاتِحُ المُغتَرُّ إِن غَضِبوا","إِنَّ الضَراغِمَ مِن أَخلاقِها الغَضَبُ",82,"ب",1,0],["لا يَعصِبُ الرَأسَ لِلشَنعاءِ يَفعَلُها","وَلا يُقَنِّعُ يَوماً وَجهَ خِزيانِ",83,"ن",1,0],["لا يَعرِفُ القَومُ هَل يَرمي بِذي شُعَلٍ","مِن مارِجِ الشِعرِ أَم يَرمي بِبُركانِ",83,"ن",1,0],["لا يَعرِفونَ الرَأيَ إِلّا واحِداً","في نَقضِ ما زَعَموا وَفي إِبرامِهِ",84,"م",2,0],["لا يُعجِبَنَّكَ ما تَرى مِن أَمرِنا","إِنّا خُلِقنا فاضِلينَ كِراما",85,"م",2,0],["لا يعجبنّ جُناةُ الشرّ إن حَصَدوا","ما يزرعُ الشُّؤْمُ من بَغْيٍ وعُدوانِ",86,"ن",1,0],["لا يَعرِفُ الدّينَ إلا فتنةً وهَوىً","أعْمَى المقاصدِ والآفاقِ والسُّبُلِ",87,"ل",1,0],["لا يُعجبنَّ بَني قريظَةَ غَدرُهم","فَمُحَمَّدٌ لِلغادرِينَ عُقابُ",88,"ب",1,0],["لا يعجبِ الكفارُ من مَسفوحِهِ","فلقد جَرَى من قبلُ في إلهامِهِ",89,"م",2,0],["لا يَعلَمُ الناسُ مِن لَيلى وَذِكرَتِها","ما قَد تَجَرَّعتُ مِن شَوقٍ وَمِن طَرَبِ",90,"ب",1,0],["لا يَعْدَمُ