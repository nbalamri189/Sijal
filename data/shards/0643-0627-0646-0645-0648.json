{"poems":[[3,"إذا لاقيت جمع بني أبان","https://www.aldiwan.net/poem138.html",""],[40,"فسيري واشربي ببنات قين","https://www.aldiwan.net/poem7705.html","الوافر"],[30,"وكم من ناذرين دمي رمتهم","https://www.aldiwan.net/poem5218.html","الوافر"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62241","البسيط"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9906","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[108,"طلعة العيد","https://www.poetsgate.com/ViewPoem.aspx?id=179627",""],[159,"أمغنى الهوى غالتك أيدي النوائب","https://www.aldiwan.net/poem55797.html","الطويل"],[254,"كفى بالنأي من أسماء كافي","https://www.aldiwan.net/poem2105.html","الوافر"],[303,"أما ينفك قلبك مستطارا","https://www.aldiwan.net/poem36826.html","عموديه"],[327,"ألا طال التنظر والثواء","https://www.aldiwan.net/poem56353.html","الوافر"],[391,"أفاطم قبل بينك متعيني","https://www.aldiwan.net/poem1844.html","الوافر"],[412,"سقى دمعي الأحبة حيث ساروا","https://www.aldiwan.net/poem50161.html","الوافر"],[520,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[563,"دار ريا يا حسنها دار ريا","https://www.aldiwan.net/poem33565.html","الخفيف"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79501","الطويل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46487","الوافر"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45655","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89323","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86285","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86273","البسيط"],[3565,"","https://poetry.dctabudhabi.ae/diwan/poem/198940","البسيط"],[3959,"","https://poetry.dctabudhabi.ae/diwan/poem/73861","البسيط"],[5725,"سلوا عيون المها","https://www.poetsgate.com/ViewPoem.aspx?id=180320",""],[5956,"الوالي والحمار","https://www.poetsgate.com/ViewPoem.aspx?id=184584",""]],"verses":[["كَأَنَّ مُؤَشَّرَ العَضُدَينِ حَجل","هَدوجاً بَينَ أَقلَبَةٍ مِلاحِ",0,"ح",1,0],["كَأَنَّ مَواقِعَ الصِردانِ مِنها","مَناراتٌ بُنينَ عَلى جَمادِ",1,"د",1,0],["كَأَنَّ مَواقِعَ الآثارِ مِنها","مَواقِعُ مِن صَوارِمَ ذاتِ أُثرِ",2,"ر",1,0],["كَأنَّ مَوْضِعَ وِصْلَيْهَا إِذَا بَرَكَتْ","وقَدْ تَطابَقَ مِنْهَا الزَّوْرُ بِالثَّفِنِ",3,"ن",1,0],["كَأَنَّ مُؤَشَّرَ العَضُدَينِ حَجلاً","هَدوجاً بَينَ أَقلَبَةٍ مِلاحِ",4,"ح",1,0],["كَانَ مُوسَى وَلِيدُ قُرْطُبَةٍ يَنْ","شَأُ في صَعْبَةٍ مِنَ البِيئَاتِ",5,"ت",1,0],["كان موسى رمز السَّلام على الأَر","ض، وكان المسيحُ خَصْمَ الخِصام",6,"م",1,0],["كأنَّ مُوشّى السُّحب في جَنَباتها","صدورُ بُزاة أَو ظهورُ الجَنَادِبِ",7,"ب",1,0],["كَأَنَّ مَواضِعَ الثَفِناتِ مِنها","إِذا بَرَكَت وَهُنَّ عَلى تَجافي",8,"ف",2,0],["كأنَّ مواطئَ الأَقدامِ نارٌ","بقلبي فهي لا تُلفي قرارا",9,"ر",2,0],["كَأَنَّ مُؤَثِّرَ الأَنساعِ فيها","حِجاجُ البِئرِ خَرَّبِها الرِشاءُ",10,"ا",2,0],["كَأَنَّ مَواقِعَ الثَفِناتِ مِنها","مُعَرَّسُ باكِراتِ الوِردِ جُونِ",11,"ن",1,0],["كأَنَّ مَواقِع التَقبيل فيهِ","رَماد جامِدٌ وَالخَدِّ نارُ",12,"ر",1,0],["كأن موسى والوصي حيدرا","أحظاه منها بالنصيب الوافر",13,"ر",1,0],["كان موسى بها الكليم وعيسى","ناطق المهد حين كان صبيا",14,"ي",2,0],["كأنَّ موشى الغيمِ فيهِ مقابلاً","موشّى الرُّبى والشمسُ تنظرُ من سَجْفِ",15,"ف",1,0],["كَأَن مَواكب الظَلماء سرب","مِن الغربان يَنفرُ مِن حَمام",16,"م",1,0],["كَأَنَّ موشي الجَوِّ عِندَ اِكتِمالِها","جُلود أَفاع أَو نَسيج دُروع",17,"ع",1,0],["كأن موسى أبا إبراهيم أعطى إلى","إلهامي ألواح رشدٍ بالهدى نامي",18,"م",2,0],["كَأَن مَولاهُ لما شاءَ صَوَّرَهُ","من روح لُطف وَحَلّاهُ بِعُرفان",19,"ن",1,0],["كَأَنَّ مَولاهُ فيهِ بَثَّ عن كَرَمٍ","روحَ الهِدايَةِ مَعصوماً من الزلل",20,"ل",1,0],["كأنّ موسى نبيّ الله أقبسه","ناراً وجرّ عليها كفّه الخضر",21,"ر",1,0],["كَأَنَّ موسى كَليمَ اللَهِ أَقبَسَها","ناراً وَجَرَّ عَلَيها كَفَّهُ الخَضِرُ",22,"ر",1,0],["كأنّ موؤودتي تستجدي نسمتها","شدّت حبالا لدلو الروح مافتلت",23,"ت",1,0],["كان موتُ الدابَّةِ الأقسى على","نفسهِ أصعبَ من نَسْفِ الفَلَكْ",24,"ك",1,0]]}