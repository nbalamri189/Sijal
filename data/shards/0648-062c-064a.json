ايا","وَمَقامي يَروعُ عَنهُ الدَخيلُ",1,"ل",1,0],["وَجَيشاً جَناحاهُ يُزَمّانِ بِالرَدى","خَفوقانِ ما نالا مِنَ الأَرضِ مَخفَقا",2,"ق",2,0],["وَجيبَ عَلى الصُبحِ ثَوبُ الظَلا","مِ وَالبَدرُ يَخلَعُ عَنهُ المَحاقا",3,"ق",2,0],["وَجِئتَ مَجيءَ البَدرِ أَخلَقَ ضَوءُهُ","فَعادَ جَديدَ النَورِ بِالطالِعِ السَعدِ",4,"د",1,0],["وَجَيشٍ مُضِرٍّ بِالفَلاةِ كَأَنَّهُ","رِقابُ سُيولٍ أَو مُتونُ نِهاءِ",5,"ا",2,0],["وجِيدٌ كما يَعْطُو إِلى البَانِ شادِنٌ","تُفيءُ علَيه الظِّلَّ أفْنانُهُ الخُضْرُ",6,"ر",1,0],["وَجَيْشاً كَقِطْعِ اللَّيْلِ لِلْخَيْلِ تَحْتَهُ","إِذَا صَهَلَتْ مُفَتنَّةً بِرَجْع أَلْحَانِ",7,"ن",1,0],["وَجِيءَ بِشِبْلِ الْمُلْكِ يُنْجِدُ عَزْمَهُ","عَلَيْهِ الْحِفَاظُ الْجَعْدُ وَالْخُلُقُ السَّبْطُ",8,"ط",1,0],["وجِئتَ منْ صُلْبِكَ في مَعْشَرٍ","منْ وَلَدٍ عُورٍ ومنْ عُرْجِ",9,"ج",1,0],["وَجيدِ مُغزِلَةٍ تَقرو نَواجِذُها","مِن يانِعِ المَردِ ما اِحلَولى وَما طابا",10,"ب",2,0],["وَجيدِ أَدماءَ لَم تُذعَر فَرائِصُها","تَرعى الأَراكَ تَعاطى المَردَ وَالوَرَقا",11,"ق",2,0],["وَجِياداً كَأَنَّها قُضُبُ الشَو","حَطِ تَعدو بِشِكَّةِ الأَبطالِ",12,"ل",1,0],["وَجَيشُهُمُ يَنظُرونَ الصَبا","حَ فَاليَومَ مِن غَزوَةٍ لَم تَخِم",13,"م",1,0],["وَجُيوشٌ بِجُيوشٍ تَلتَقي","كَسُيولٍ دَفَقَت في مُنحَدَر",14,"ر",1,0],["وَجِئتَ بِأَبياتٍ مِنَ الشِعرِ فُصِّلَت","إِذا ما تَلَوها أُلقِيَ الناسُ سُجَّدا",15,"د",2,0],["وَجِئتُ أَطلُبُها مِنهُ وَقَد عرَضَت","في السوقِ مِنّي لُباناتٍ وَأَوطارُ",16,"ر",1,0],["وَجَيشاً خَلَطناهُ رِحابٌ صُدورُهُ","بِجَيشٍ مِنَ الأَعداءِ غُلبٍ رِقابُهُ",17,"ب",2,0],["وَجيدٍ كَجيدِ الرِئمِ لَيسَ بِفاحِشٍ","إِذا هِيَ نَصَّتهُ وَلا بِمُعَطَّلِ",18,"ل",1,0],["وجيلنا الدائل أفضى إلى","مستقبل أرضاً وثاوي تراب",19,"ب",1,0],["وَجِئ بِفَوارِسٍ كَبَني شِهابٍ","وَمَسعَدَةَ الَّذي وَرَدَ الجِفارا",20,"ر",2,0],["وَجيدٍ وَلَبّاتٍ نَواصِعَ واضِحٍ","إِذا لَم تَكُن مِن نَضحِ جادِيّها صُفرا",21,"ر",2,0],["وجي وأنقر فالعود","فذا النهار المسعود",22,"د",1,0],["وجئنا حاشدين بصدر يوم","حكى يومي عكاظ وذي المجاز",23,"ز",1,0],["وجيش نصير جاءنا عن جَنايةٍ","فكان علينا واجباً أن يُزوَّرا",24,"ر",2,1],["وَجيءَ بِالكَأسِ وَبِالشَرابِ","فَقُلتُ وَفِّرها عَلى أَصحابي",25,"ي",1,0],["وجئت جلال المصطفى منك قائماً","بشرعته الغرّاء خير قيام",26,"م",1,0],["وجيرة في القلب أسكنتهم","فارتحل البيت وسكانه",27,"ن",2,0],["وجئت ما عندي سوى نصف درهم","ولكنه يا سيدي نصفه الثاني",28,"ي",1,0],["وجيشٌ كأن الجوّ قد مدَّ أنجماً","عليه ووجه الأرض أنبت دبَّلا",29,"ل",2,0],["وجيدِ إبريقِ فضةٍ دأبَ ال","صوَّاغُ حتى اصطفى له نُقَره",30,"ر",2,0],["وجِئْتُم في الحياطةِ والتَّوقِّي","بتلك المُنجِياتِ من الملامِ",31,"م",1,0],["وَجيدِ غَزالٍ شادِنٍ فَرَدَت لَهُ","مِنَ الحَلي سَمطَي لُؤلُؤٍ وَزَبَرجَدِ",32,"د",1,0],["وَجَيّاشَةٍ بَرقُها رَعدُها","تَدُكُّ مِنَ الشاهِقِ المَنكَبا",33,"ب",2,0],["وَجَيشٍ كَمِثلِ اللَيلِ هَولاً وَهَيبَةً","وَإِن زانَهُ ما فيهِ مِن أَنجُمٍ زُهرِ",34,"ر",1,0],["وَجيفَ المَطايا ثُمَّ قُلتُ لِصُحبَتي","وَلَم يَنزِلوا أَبرَدتُمُ فَتَرَوَّحوا",35,"ح",3,0],["وجِئْتُ إلى الغابِ أَسْكبُ أَوجاعَ","قلبي نحيباً كلفْح اللَّهيبْ",36,"ب",1,0],["وجئت إليك أشكو من هموم","مؤرّقة فهل تُصغى إليّا",37,"ي",2,0],["وجيش إثر جيش قد فقدنا","وكان القائد النحس الغريبا",38,"ا",1,0],["وَجَيشٍ مِن غُزاةٍ عَن غُزاةٍ","هُمُ الأَبطالُ في ماضٍ وَآتي",39,"ا",3,0],["وَجُيوشٌ يَنهَضنَ بِالأَرضِ مَلكاً","وَلِواءٌ مِن تَحتِهِ الأَحياءُ",40,"ا",2,0],["وَجَيشٌ يُثَنّي كُلَّ طَودٍ كَأَنَّهُ","خَريقُ رِياحٍ واجَهَت غُصُناً رَطبا",41,"ب",2,0],["وَجَيشٍ كُلَّما حاروا بِأَرضٍ","وَأَقبَلَ أَقبَلَت فيهِ تَحارُ",42,"ر",1,0],["وَجَيشَ إِمامٍ عَلى ناقَةٍ","صَحيحِ الإِمامَةِ في الباطِلِ",43,"ل",1,0],["وَجِئتَ كَما جاءَ الرَبيعُ مُحَرِّكاً","يَدَيكَ بِأَخلاقٍ تَفي بِالسَحائِبِ",44,"ب",1,0],["وَجَيشٌ رَبَعناهُ كَأَنَّ زُهاءَهُ","شَماريخُ طَودٍ مُشمَخِرٌّ مَخارِمُه",45,"م",2,0],["وجئتهمُ قبلَ ارتدادِ جُفونِهم","بمائدة تُكسَى الشَّرائحَ والمِدَى",46,"د",2,0],["وَجِئتُكُمُ بِمَعرِفَةٍ وَعَدلٍ","أَلَم يَكُ فيهِما مَنِعٌ لِصَرفي",47,"ي",1,0],["وَجُيوشُ النُجومِ جافِلَةٌ","وَلِواءُ الشُعاعِ قَد نُشِرا",48,"ر",2,0],["وَجِئتُ وَفي يَدي كَفَني وَسَيفي","فَكَيفَ جَعَلتَها خُفّي حُنَينِ",49,"ن",1,0],["وَجِيادٍ مِثلِ العَقارِبِ نَحوَ ال","رَوعِ تَسعى شَوائِلَ الأَذنابِ",50,"ب",1,0],["وَجَيشَهُ مِن جَمعِنا قَد هُزِما","وَبُندَقَ الصُحبِ إِلَيهِ قَد سَما",51,"م",2,0],["وجيوش الظلام تزحف زحفا","وثقال الأقدام تسحق سحقا",52,"ق",2,0],["وجيوشٌ يُظِلّ غابُ قَنَاها","أُسُداً من حُماةِ عُرْبٍ وعجمِ",53,"م",1,0],["وجيشٍ يجيشُ بأبطاله","كما ماجَ موجُ العباب التطاما",54,"م",2,0],["وجيشُك هنديّ الخوافي بِهزّهِ","جناحَي عُقَابٍ سمهرِيُّ القوادمِ",55,"م",1,0],["وجيشِ خطوب زاحمٍ كلّ ساعةٍ","فما أنْفُسُ الأحياءِ إلّا هوالكُه",56,"ك",2,0],["وجَيشٍ عَريضٍ بالشِّياحِ طَريقُهُ","يَموجُ كَسيلٍ فاضَ مُنخَرِقَ السدِّ",57,"د",1,0],["وجيشٍ تخالُ الشَدْوَ في جنَبَاته","إِذا صَاهَلتْ فيه العِرابُ عرابا",58,"ب",2,0],["وَجِئتَ تَقولُ لَم أَرَه وَهَذي","مَحاسِنُهُ تَلوحُ بِوَجنَتَيكا",59,"ك",2,0],["وَجِئتُهُ زائِراً فَجاوَزَ بِيَ ال","أَخلاقَ مِن مالِهِ إِلى جُدُدِه",60,"د",2,0],["وَجِئتُكَ في قُضاعَةَ قَد أَطافَت","بِرُكنَي عامِرٍ وَبَني جَنابِ",61,"ب",1,0],["وَجِئْتَ مَجِيءَ الْبَدْرِ مَدَّ شُعَاعَهُ","عَلَى أُفُقٍ بِالْجَوْنِ وَحْفِ الْقَوَادِمِ",62,"م",1,0],["وجئتُ ببحثٍ أعجبتْكَ فنونُهُ","ولولا حيائي كنتُ أبدعتُهُ جهدي",63,"د",2,0],["وجئْتَ بمعروفٍ تضمَّنَ منكراً","كمطعمةِ الأيتامِ مِنْ كدِّ فَرْجِها",64,"ه",2,0],["وَجيدُ غَزالٍ فائِقُ الدُرِّ حَليُهُ","وَرَخصٌ لَطيفٌ واضِحُ اللَونِ ناعِمُ",65,"م",1,0],["وَجيدِ خَذولٍ بِالصَريمَةِ مُغزِلٍ","وَوَجهِ حَميٍّ أَضرَعَتهُ المَخالِفُ",66,"ف",1,0],["وَجِئتُ اِنسِيابَ الأَيمِ في الغيلِ أَتَّقى ال","عُيونَ وَأُخفي الوَطءَ لِلمُتَقَفِّرِ",67,"ر",1,0],["وَجِئتُ دِيارَ الحَيِّ وَاللَيلُ مُطرَفٌ","مُنَمنَمُ ثَوبِ الأُفقِ بِالأَنجُمِ الزُهرِ",68,"ر",1,0],["وَجِئْنَ يُغِرْنَ على عينهِ","وَينفذنَ مِن نابِهِ والظُّفُرْ",69,"ر",1,0],["وَجِئتُم بِالحِمايَةِ وَهيَ أَدهى","وَأَشأَمُ ما نَخافُ مِنَ العَوادي",70,"د",2,0],["وجِئتَ به سيِّدَ الفاتحين","فأوغَلَ في قلبهِ المقفلِ",71,"ل",1,0],["وجِئتَ رسولَ اللهِ لا الوجهُ شاحبٌ","ولا العِطفُ مُزْوَرٌّ ولا القلبُ مَحزونُ",72,"ن",1,0],["وَجِئْتَ بِهِ والجندُ باللّيلِ رَاصِدٌ","يُقَلِّبُ للحربِ الرِّقاقَ البواتِرا",73,"ر",2,0],["وَجيءَ ب