1,0],["وَجِئناهُ نَشكو وَالنُفوسُ شَجيَّةٌ","سَقَتنا مِراراً راحَةٌ هاشميَّةٌ",133,"ه",1,0],["وجئتَ نحو المصلّى سَيّداً ملكاً","بقلبِ عبدٍ لرب العرش يبتذلُ",134,"ل",1,0],["وجئث المصلى والمصلى وأهله","مشيرون بالتأهيل نحوك والرحب",135,"ب",1,0],["وجئت لتنفيس الكروب عن الورى","كأنك لطف الله عند النوائب",136,"ب",1,0],["وجيشك مثل الليل يدرك من نأى","وأين من الليل الفرار إذا جنا",137,"ن",2,0],["وجيدك جيد ريم في التفات","إلى القناص يعدو في الفلاة",138,"ه",1,0],["وجئت لإسمعيل تبغي خداعه","أيلسع سلطانان ويلك من حجر",139,"ر",1,0],["وَجئنا بِقَومٍ لا يُمَنُّ عليهم","وَجَمعٍ إِذا لاقى الأَعاديَّ يَزحفُ",140,"ف",1,0],["وَجَيشاً يُواري الشَمسَ رَيعانُ نَقعِهِ","إِلى التُركِ إِذ جاؤُوا لِهَتكِ المَحارِمِ",141,"م",1,0],["وَجِئتُ هَذا أُرَجّي عِندَهُ أَمَلاً","نَزراً فَصادَفتُ إِعراضاً وَحِرمانا",142,"ن",2,0],["وَجِئْتُ أَرْضاً تَسُوء سَاكِنَهَا","وَتُبْدلُ الْيُسْرَ مِنْهُ بِالْعُسْرِ",143,"ر",1,0],["وَجِئنا فِى مُقَدَّمَةٍ طَحُونٍ","لها زَجَلٌ يُصِمُّ السّامِعِينَأ",144,"ن",2,0],["وجئت لحي القوم أرجو شرابهم","بلا مهر أرواح ولا بذل مهجتي",145,"ت",2,0],["وجيشُ اعْتزامٍ تَظْلَعُ الريحُ خَلْفَه","وتَقْفُوا أَوالِى البرقِ أُخْرَى عِرابه",146,"ب",2,0],["وجيشُ الموت يطلبه","وقد ضاقتْ به السُّبُل",147,"ل",1,0],["وجيد خوف غائلة التوافي","لمن في وصله عتب وعار",148,"ر",1,0],["وَجيلٍ سَمِعنا بِهِم قَد فَنَوا","فَما الحَيُّ إِلّا كَمَن يُثقَفُ",149,"ف",1,0],["وَجَيحانُ جَيحانُ الجُيوشِ وَالسُنٌ","وَحَزمُ خَزازي وَالشُعوبُ القَواسِرُ",150,"ر",1,0],["وجئتنا بالحلو فيما ترى","فكانَ ملحاً عندنا سُكَّركْ",151,"ك",1,0],["وجئت ضيغمها لكن بمخلبهِ","فما استطاعكَ ذاكَ الضيغمُ الهصِرُ",152,"ر",1,0],["وَجئِنا إِلَيهِم عَلى المُضمَرات","بِأَرعَنَ ذي لَجَبٍ زاخِرِ",153,"ر",1,0],["وجئت بابك يا مولاي مفتقرا","إلى غناك وقد ضاقت بي الحيل",154,"ل",1,0],["وجئت يحيى الغيث والعود قد ذوى","فما كان احلى ما اتيت على ظما",155,"م",2,0],["وجئت إليك اليوم أشكو ظلامة","وهما على هم وضرا على ضر",156,"ر",1,0],["وجئت به يسعى أسيرا وقد غدا","على أدهم يمشي به وهو راكب",157,"ب",1,0],["وجئت كالغيث فابتلت جوانحها","وعمها الاجودان ال