ps://www.aldiwan.net/poem61339.html","الوافر"],[458,"حماها أن تشل وأن تراعا","https://www.aldiwan.net/poem56121.html","الوافر"],[458,"وفى لي بك الحظ الذي كان يغدر","https://www.aldiwan.net/poem56168.html","الطويل"],[458,"أتكتم يوم بانة أم تبوح","https://www.aldiwan.net/poem56247.html","الوافر"],[461,"وجيش كأعناق السيول غثاؤه","https://www.aldiwan.net/poem15084.html","الطويل"],[461,"أأهجع أم آوي إلى لين مرقد","https://www.aldiwan.net/poem15111.html","الطويل"],[461,"ضرب من الشعر قس الأولون إلى","https://www.aldiwan.net/poem15116.html","البسيط"],[461,"إذا ما رواق الحرب أظلم نقعه","https://www.aldiwan.net/poem15286.html","الطويل"],[461,"أقوال له والزهو ينغض عطفه","https://www.aldiwan.net/poem15933.html","الطويل"],[461,"أسيف سل أم ذرب نطوق","https://www.aldiwan.net/poem16020.html","الوافر"],[461,"بقيت مطاعا ما تغنت حمامة","https://www.aldiwan.net/poem16342.html","الطويل"],[464,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[464,"تباً لما اختلق الواشي وما نقلا","https://www.aldiwan.net/poem3504.html","عموديه"],[464,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[465,"يا شاديَ الأيك","https://www.aldiwan.net/poem43677.html","عموديه"],[479,"جنحت للغروب شمس الأصيل","https://www.aldiwan.net/poem37184.html","الخفيف"],[479,"إيطاليا قيل قالت","https://www.aldiwan.net/poem37202.html","المجتث"],[479,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[500,"علام الهموم وفيم العنا","https://www.aldiwan.net/poem37695.html","المتقارب"],[500,"قلوب الأولياء لها سيوف","https://www.aldiwan.net/poem37953.html","الوافر"],[514,"نصال من جفونك أم سهام","https://www.aldiwan.net/poem20794.html","الوافر"],[514,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[524,"عبير الثنا في الخافقين يفوح","https://www.aldiwan.net/poem13284.html","الطويل"],[524,"نبي له في كل فضل تقدم","https://www.aldiwan.net/poem13291.html","الطويل"],[529,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[551,"قد مضى شهر الصيام","https://www.aldiwan.net/poem47208.html","مجزوء الرمل"],[551,"بقاء ولكن لو أتى لا أذمه","https://www.aldiwan.net/poem47249.html","الطويل"],[551,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[551,"أراعك ما راعني من ردى","https://www.aldiwan.net/poem48121.html","المتقارب"],[558,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[558,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[558,"مالي لقد أصبحت من نيل المنى","https://www.aldiwan.net/poem33789.html","الكامل"],[558,"قل لمن قال عن ذوي العرفان","https://www.aldiwan.net/poem33820.html","الخفيف"],[558,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[558,"يا من أرومهم بكل مرام","https://www.aldiwan.net/poem35091.html","الكامل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"ظبي بحسمي حالي الجيد بالعطل","https://www.aldiwan.net/poem2890.html","البسيط"],[575,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"],[575,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"]],"verses":[["وَجَيشٍ يُسامي كُلَّ طَودٍ عَجاجُهُ","وَيَفتَرَّ عَنهُ كُلُّ وادٍ يَضُمُّهُ",0,"م",2,0],["وَجِيادي مَربوطَةٌ وَالمَطايا","وَمَقامي يَروعُ عَنهُ الدَخيلُ",1,"ل",1,0],["وَجَيشاً جَناحاهُ يُزَمّانِ بِالرَدى","خَفوقانِ ما نالا مِنَ الأَرضِ مَخفَقا",2,"ق",2,0],["وَجيبَ عَلى الصُبحِ ثَوبُ الظَلا","مِ وَالبَدرُ يَخلَعُ عَنهُ المَحاقا",3,"ق",2,0],["وَجِئتَ مَجيءَ البَدرِ أَخلَقَ ضَوءُهُ","فَعادَ جَديدَ النَورِ بِالطالِعِ السَعدِ",4,"د",1,0],["وَجَيشٍ مُضِرٍّ بِالفَلاةِ كَأَنَّهُ","رِقابُ سُيولٍ أَو مُتونُ نِهاءِ",5,"ا",2,0],["وجِيدٌ كما يَعْطُو إِلى البَانِ شادِنٌ","تُفيءُ علَيه الظِّلَّ أفْنانُهُ الخُضْرُ",6,"ر",1,0],["وَجَيْشاً كَقِطْعِ اللَّيْلِ لِلْخَيْلِ تَحْتَهُ","إِذَا صَهَلَتْ مُفَتنَّةً بِرَجْع أَلْحَانِ",7,"ن",1,0],["وَجِيءَ بِشِبْلِ الْمُلْكِ يُنْجِدُ عَزْمَهُ","عَلَيْهِ الْحِفَاظُ الْجَعْدُ وَالْخُلُقُ السَّبْطُ",8,"ط",1,0],["وجِئتَ منْ صُلْبِكَ في مَعْشَرٍ","منْ وَلَدٍ عُورٍ ومنْ عُرْجِ",9,"ج",1,0],["وَجيدِ مُغزِلَةٍ تَقرو نَواجِذُها","مِن يانِعِ المَردِ ما اِحلَولى وَما طابا",10,"ب",2,0],["وَجيدِ أَدماءَ لَم تُذعَر فَرائِصُها","تَرعى الأَراكَ تَعاطى المَردَ وَالوَرَقا",11,"ق",2,0],["وَجِياداً كَأَنَّها قُضُبُ الشَو","حَطِ تَعدو بِشِكَّةِ الأَبطالِ",12,"ل",1,0],["وَجَيشُهُمُ يَنظُرونَ الصَبا","حَ فَاليَومَ مِن غَزوَةٍ لَم تَخِم",13,"م",1,0],["وَجُيوشٌ بِجُيوشٍ تَلتَقي","كَسُيولٍ دَفَقَت في مُنحَدَر",14,"ر",1,0],["وَجِئتَ بِأَبياتٍ مِنَ الشِعرِ فُصِّلَت","إِذا ما تَلَوها أُلقِيَ الناسُ سُجَّدا",15,"د",2,0],["وَجِئتُ أَطلُبُها مِنهُ وَقَد عرَضَت","في السوقِ مِنّي لُباناتٍ وَأَوطارُ",16,"ر",1,0],["وَجَيشاً خَلَطناهُ رِحابٌ صُدورُهُ","بِجَيشٍ مِنَ الأَعداءِ غُلبٍ رِقابُهُ",17,"ب",2,0],["وَجيدٍ كَجيدِ الرِئمِ لَيسَ بِفاحِشٍ","إِذا هِيَ نَصَّتهُ وَلا بِمُعَطَّلِ",18,"ل",1,0],["وجيلنا الدائل أفضى إلى","مستقبل أرضاً وثاوي تراب",19,"ب",1,0],["وَجِئ بِفَوارِسٍ كَبَني شِهابٍ","وَمَسعَدَةَ الَّذي وَرَدَ الجِفارا",20,"ر",2,0],["وَجيدٍ وَلَبّاتٍ نَواصِعَ واضِحٍ","إِذا لَم تَكُن مِن نَضحِ جادِيّها صُفرا",21,"ر",2,0],["وجي وأنقر فالعود","فذا النهار المسعود",22,"د",1,0],["وجئنا حاشدين بصدر يوم","حكى يومي عكاظ وذي المجاز",23,"ز",1,0],["وجيش نصير جاءنا عن جَنايةٍ","فكان علينا واجباً أن يُزوَّرا",24,"ر",2,1],["وَجيءَ بِالكَأسِ وَبِالشَرابِ","فَقُلتُ وَفِّرها عَلى أَصحابي",25,"ي",1,0],["وجئت جلال المصطفى منك قائماً","بشرعته الغرّاء خير قيام",26,"م",1,0],["وجيرة في القلب أسكنتهم","فارتحل البيت وسكانه",27,"ن",2,0],["وجئت ما عندي سوى نصف درهم","ولكنه يا سيدي نصفه الثاني",28,"ي",1,0],["وجيشٌ كأن الجوّ قد مدَّ أنجماً","عليه ووجه الأرض أنبت دبَّلا",29,"ل",2,0],["وجيدِ إبريقِ فضةٍ دأبَ ال","صوَّاغُ حتى اصطفى له نُقَره",30,"ر",2,0],["وجِئْتُم في الحياطةِ والتَّوقِّي","بتلك المُنجِياتِ من الملامِ",31,"م",1,0],["وَجيدِ غَزالٍ شادِنٍ فَرَدَت لَهُ","مِنَ الحَلي سَمطَي لُؤلُؤٍ وَزَبَرجَدِ",32,"د",1,0],["وَجَيّاشَةٍ بَرقُها رَعدُها","تَدُكُّ مِنَ الشاهِقِ المَنكَبا",33,"ب",2,0],["وَجَيشٍ كَمِثلِ اللَيلِ هَولاً وَهَيبَةً","وَإِن زانَهُ ما فيهِ مِن أَنجُمٍ زُهرِ",34,"ر",1,0],["وَجيفَ المَطايا ثُمَّ قُلتُ لِصُحبَتي","وَلَم يَنزِلوا أَبرَدتُمُ فَتَرَوَّحوا",35,"ح",3,0],["وجِئْتُ إلى الغابِ أَسْكبُ أَوجاعَ","قلبي نحيباً كلفْح اللَّهيبْ",36,"ب",1,0],["وجئت إليك أشكو من هموم","مؤرّقة فهل تُصغى إليّا",37,"ي",2,0],["وجيش إثر جيش قد فقدنا","وكان القائد النحس الغريبا",38,"ا",1,0],["وَجَيشٍ مِن غُزاةٍ عَن غُزاةٍ","هُمُ الأَبطالُ في ماضٍ وَآتي",39,"ا",3,0],["وَجُيوشٌ يَنهَضنَ بِالأَرضِ مَلكاً","وَلِواءٌ مِن تَحتِهِ الأَحياءُ",40,"ا",2,0],["وَجَيشٌ يُثَنّي كُلَّ طَودٍ كَأَنَّهُ","خَريقُ رِياحٍ واجَهَت غُصُناً رَطبا",41,"ب",2,0],["وَجَيشٍ كُلَّما حاروا بِأَرضٍ","وَأَقبَلَ أَقبَلَت فيهِ تَحارُ",42,"ر",1,0],["وَجَيشَ إِمامٍ عَلى ناقَةٍ","صَحيحِ الإِمامَةِ في الباطِلِ",43,"ل",1,0],["وَجِئتَ كَما جاءَ الرَبيعُ مُحَرِّكاً","يَدَيكَ بِأَخلاقٍ تَفي بِالسَحائِبِ",44,"ب",1,0],["وَجَيشٌ رَبَعناهُ كَأَنَّ زُهاءَهُ","شَماريخُ طَودٍ مُشمَخِرٌّ مَخارِمُه",45,"م",2,0],["وجئتهمُ قبلَ ارتدادِ جُفونِهم","بمائدة تُكسَى الشَّرائحَ والمِدَى",46,"د",2,0],["وَجِئتُكُمُ بِمَعرِفَةٍ وَعَدلٍ","أَلَم يَكُ فيهِما مَنِعٌ لِصَرفي",47,"ي",1,0],["وَجُيوشُ النُجومِ جافِلَةٌ","وَلِواءُ الشُعاعِ قَد نُشِرا",48,"ر",2,0],["وَجِئتُ وَفي يَدي كَفَني وَسَيفي","فَكَيفَ جَعَلتَها خُفّي حُنَينِ",49,"ن",1,0],["وَجِيادٍ مِثلِ العَقارِبِ نَحوَ ال","رَوعِ تَسعى شَوائِلَ الأَذنابِ",50,"ب",1,0],["وَجَيشَهُ مِن جَمعِنا قَد هُزِما","وَبُندَقَ الصُحبِ إِلَيهِ قَد سَما",51,"م",2,0],["وجيوش الظلام تزحف زحفا","وثقال الأقدام تسحق سحقا",52,"ق",2,0],["وجيوشٌ يُظِلّ غابُ قَنَاها","أُسُداً من حُماةِ عُرْبٍ وعجمِ",53,"م",1,0],["وجيشٍ يجيشُ بأبطاله","كما ماجَ موجُ العباب التطاما",54,"م",2,0],["وجيشُك هنديّ الخوافي بِهزّهِ","جناحَي عُقَابٍ سمهرِيُّ القوادمِ",55,"م",1,0],["وجيشِ خطوب زاحمٍ كلّ ساعةٍ","فما أنْفُسُ الأحياءِ إلّا هوالكُه",56,"ك",2,0],["وجَيشٍ عَريضٍ بالشِّياحِ طَريقُهُ","يَموجُ كَسيلٍ فاضَ مُنخَرِقَ السدِّ",57,"د",1,0],["وجيشٍ تخالُ الشَدْوَ في جنَبَاته","إِذا صَاهَلتْ فيه العِرابُ عرابا",58,"ب",2,0],["وَجِئتَ تَقولُ لَم أَرَه وَهَذي","مَحاسِنُهُ تَلوحُ بِوَجنَتَيكا",59,"ك",2,0],["وَجِئتُهُ زائِراً فَجاوَزَ بِيَ ال","أَخلاقَ مِن مالِهِ إِلى جُدُدِه",60,"د",2,0],["وَجِئتُكَ في قُضاعَةَ قَد أَطافَت","بِرُكنَي عامِرٍ وَبَني جَنابِ",61,"ب",1,0],["وَجِئْتَ مَجِيءَ الْبَدْرِ مَدَّ شُعَاعَهُ","عَلَى أُفُقٍ بِالْجَوْنِ وَحْفِ الْقَوَادِمِ",62,"م",1,0],["وجئتُ ببحثٍ أعجبتْكَ فنونُهُ","ولولا حيائي كنتُ أبدعتُهُ جهدي",63,"ي",1,0],["وجئْتَ بمعروفٍ تضمَّنَ منكراً","كمطعمةِ الأيتامِ مِنْ كدِّ فَرْجِها",64,"ه",2,0],["وَجيدُ غَزالٍ فائِقُ الدُرِّ حَليُهُ","وَرَخصٌ لَطيفٌ واضِحُ اللَونِ ناعِمُ",65,"م",1,0],["وَجيدِ خَذولٍ بِالصَريمَةِ مُغزِلٍ","وَوَجهِ حَميٍّ أَضرَعَتهُ المَخالِفُ",66,"ف",1,0],["وَجِئتُ اِنسِيابَ الأَيمِ في الغيلِ أَتَّقى ال","عُيونَ وَأُخفي الوَطءَ لِلمُتَقَفِّرِ",67,"ر",1,0],["وَجِئتُ دِيارَ الحَيِّ وَاللَيلُ مُطرَفٌ","مُنَمنَمُ ثَوبِ الأُفقِ بِالأَنجُمِ الزُهرِ",68,"ر",1,0],["وَجِئْنَ يُغِرْنَ على عينهِ","وَينفذنَ مِن نابِهِ والظُّفُرْ",69,"ر",1,0],["وَجِئتُم بِالحِمايَةِ وَهيَ أَدهى","وَأَشأَمُ ما نَخافُ مِنَ العَوادي",70,"د",2,0],["وجِئتَ به سيِّدَ الفاتحين","فأوغَلَ في قلبهِ المقفلِ",71,"ل",1,0],["وجِئتَ رسولَ اللهِ لا الوجهُ شاحبٌ","ولا العِطفُ مُزْوَرٌّ ولا القلبُ مَحزونُ",72,"ن",1,0],["وَجِئْتَ بِهِ والجندُ باللّيلِ رَاصِدٌ","يُقَلِّبُ للحربِ الرِّقاقَ البواتِرا",73,"ر",2,0],["وَجيءَ بكنزهم إرثاً عتيداً","لِوُرَّاثِ الممالكِ والدُّهورِ",74,"ر",1,0],["وَجِيءَ بِهِ يقول له ذوُوهُ","تَرفَّقْ إنّك المولى النَّبيلُ",75,"ل",1,0],["وَجيدٌ يُغني عَنِ التَقليد","كَجيدِ الغَزالِ في وَجرَه",76,"ه",1,0],["وَجَيشٍ في دُجى الظَلماءِ مَجرٍ","يَؤُمُّ بِلادَ مَلكٍ قَد هَدَيتُ",77,"ت",1,0],["وَجَيشاً كَرُكنِ الطَودِ رَحباً تَريقُهُ","إِذا ما عَلا حَزناً مِنَ الأَرضِ أَسهَلا",78,"ل",2,0],["وَجَيّاشَةٍ بِالماءِ طَيِّبَةِ الثَرى","تَغورُ عَلى أَيدي السُقاةِ الدَوافِقِ",79,"ق",1,0],["وَجَيشٍ كَمِثلِ اللَيلِ يَسوَدُّ شَمسُهُ","وَيَهمَرُّ مِن أَعدائِهِ البَرُّ وَالبَحرُ",80,"ر",1,0],["وَجِئتَ فَحُبِّيَ ذاكَ الَّذي","عَهِدتَه كَما هُوَ لا يَنفَدُ",81,"د",1,0],["وجيْشُكَ يعْتاد الهِرَقْلَ بسيفه","ومن دونهِ اليمُّ الغُطامطُ واللُّوب",82,"ب",1,0],["وُجَيهُ مُحَمَّدٍ شَمسُ","وَمُلكُ مُحَمَّدٍ عُرسُ",83,"س",1,1],["وَجيءَ بِالدَنِّ عَلى مَرفَعٍ","وَخاتَمُ العِلجِ عَلى طينِهِ",84,"ن",2,0],["وَجَيشٍ كَجُنحِ اللَيلِ يَرجُفُ بِالحَصى","وَبِالشَولِ وَالخَطِّيِّ حُمرُ ثَعالِبُه",85,"ب",2,0],["وَجيدٌ يُشبِهُ الدُرَّ","كَجيدِ الريمِ سُلهوبُ",86,"ب",1,0],["وَجيرانُ الغَريبِ مُبغِضوهُ","إِلى جُلّاسِهِم وَمُحَبِّبوهُ",87,"ب",3,0],["وَجِئتَ بِنَمِيٍّ إِلى مُتَعَصِّبٍ","فَناداكَ دينارٌ بِكَفِّكَ هِبرِزي",88,"ز",2,0],["وَجِئنا بِها شَهباءَ ذاتَ أَشِلَّةٍ","لَها عارِضٌ فيهِ المَنِيَّةُ تَلمَعُ",89,"ع",1,0],["وَجِئنا بِأَبدالِ الرَؤُوسِ فَلَم نَدَع","لِبِنتِ كِلابيٍّ مِنَ التَبلِ مِغزَلا",90,"ل",2,0],["وجيشِ كظَهرِ اليمِّ تَنْفُخُهُ الصَّبا","يَعُبُّ عُبوباً من قَناً وقنابلِ",91,"ل",1,1],["وَجئْ منها بأَخبار إلينا","فإنك بَينَنا نعم البَريد",92,"د",1,0],["وَجئت إلى بغداد تبصر دجلة","وتشرب من سلسال منهلها العذب",93,"ب",1,0],["وَجيش كمثل اللَيل قد طالَ زحفه","إذا زالَ جنح منه أعقبه جنحُ",94,"ح",1,1],["وجئت إلى ميعادنا عند صاحبي","وقد ضمّه والصحبَ نادٍ ومَجمَع",95,"ع",1,0],["وجئنا إليكَ بمُلكِ الهوى","وعرشِ القلوبِ وحكم القدَرْ",96,"ر",1,0],["وجئتُ فيحاءُ أُزجي الشعرَ مُفتقِداً","تحت الصفائح مقداماً ومغوارا",97,"ر",2,0],["وجيشُه منقُذُ إفريقيا","وحارسُ الشرق القويُّ الأمينْ",98,"ن",1,0],["وَجِئتُم بَعدَ إِخوَتِكُم مِنِ اِستٍ","فَهَلّا جِئتُمُ مِن حَيثُ جاؤوا",99,"ا",1,0],["وجِئْتُ للأرْماحِ مَبْسوطَ الباعْ","أعجَلَني عن لُبْسِها صوْتُ الدّاع",100,"ع",1,0],["وجيء بالأمداد والسواد","من شحنة الروم وقبط الوادي",101,"ي",1,0],["وجِئنَ بِتُركٍ مِن قَرارِ بِلادهِمِ","يَسيرُ بِجَمعٍ كالدَّبَا الُمتَسانِدِ",102,"د",1,0],["وَجِيهٌ وَمَا أَحْلَى الوَجَاهَةَ فِي أَمْرِىءٍ","رَقِيقِ حَوَاشِي الطَّبْعِ عَذْبِ الشَّمَائِل",103,"ل",1,0],["وَجِئْتِ بِهِ مصْراً فِرَاراً مِنَ الأَذَى","فَمَا زَالَ أَمْنَ اللاَّجِئِيْنَ حِمَى مِصْرِ",104,"ر",1,0],["وَجئْنَا مِنْ مَعَابِدِنَا","نَرَى فِي الْمُلْتَقَى بَنْدَا",105,"د",2,0],["وجئتُ إلى الروضِ عند الصباح","لأحجبَ نفسيَ عن كل عينْ",106,"ن",1,0],["وجئت أنا