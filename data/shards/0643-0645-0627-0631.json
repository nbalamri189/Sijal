?id=34264",""],[4578,"هيهات أبلغ في هواك مرامي","https://www.poetsgate.com/ViewPoem.aspx?id=49518",""],[4882,"إن البلاغة في النهرين تزدحم","https://www.poetsgate.com/ViewPoem.aspx?id=34801",""],[4978,"لا بل على الناس يا أستاذتي تيهي","https://www.poetsgate.com/ViewPoem.aspx?id=177629",""],[5431,"هل يرضى العالم","https://www.poetsgate.com/ViewPoem.aspx?id=183050",""],[5459,"يا من صددتم..","https://www.poetsgate.com/ViewPoem.aspx?id=191516",""],[5467,"خوف ورجاء","https://www.poetsgate.com/ViewPoem.aspx?id=199796",""],[5691,"العم سام...!","https://www.poetsgate.com/ViewPoem.aspx?id=207063",""],[5829,"هذي دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=214085",""],[5854,"فصحى اللغات","https://www.poetsgate.com/ViewPoem.aspx?id=208608",""],[5937,"لا يُجيدُ الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=211809",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[5956,"العواطف أساس الصالحات وأساس الفن الشريف","https://www.poetsgate.com/ViewPoem.aspx?id=192122",""],[5956,"صراع بين التفاؤل والتشاؤم","https://www.poetsgate.com/ViewPoem.aspx?id=207548",""],[5969,"رَبيعُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=198726",""],[6056,"الظبي يفرس أسدها","https://www.poetsgate.com/ViewPoem.aspx?id=130507",""],[6070,"مُدّي يَدَيكِ وهاكِ العَينَ والهدبا","https://www.poetsgate.com/ViewPoem.aspx?id=192689",""],[6117,"متاهةُ حُلم","https://www.poetsgate.com/ViewPoem.aspx?id=182783",""],[6134,"اطلعت نور الهدى للناس في الظلم","https://www.poetsgate.com/ViewPoem.aspx?id=169520",""],[6189,"الكون الفسيح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76136&r=&rc=13",""],[6202,"سبعون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86728&r=&rc=29",""],[6300,"يوميات مكلوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82841&r=&rc=12",""],[5190,"اصمد وقاوم أيها اللبناني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78289&r=&rc=3",""],[6355,"من أجل عينيك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66570&r=&rc=30",""]],"verses":[["كَما رَضَّ في مَرِّ السُيولِ عَشِيَّةً","ذُرى جَلمَدٍ صَعبِ الذَرى قَرعُ جُلمَدِ",0,"د",1,0],["كَما رَمى الداءُ عُضواً بَعدَ صِحَّتِهِ","كَذا إِذا التاثَ عُضوٌ رُبَّما اِصطَلَحا",1,"ح",2,0],["كما راجَعَ البِرْكارُ مَفْروضَ نُقطَةٍ","منَ السّطْحِ منْها كانَ بَدْءُ مَدارِهِ",2,"ه",1,0],["كَما رُقِمَ الكافورُ بالمِسْكِ والتَقَتْ","ذَوائِبُ منْ شَعْرٍ أثِيثٍ على خدِّ",3,"د",1,0],["كَما راشِدٍ تَجِدَنَّ اِمرَأً","تَبَيَّنَ ثُمَّ اِنتَهى أَو قَدِم",4,"م",1,0],["كَم أَرجَفوا بَعدَ مَوتِ الشَيخِ وَاِرتَقَبوا","مَوتَ المُؤَيَّدِ فينا شَرَّ مُرتَقَبِ",5,"ب",1,0],["كم أردنا سخطاً عليها ولكن","غلب السخط في القلوب الرضاء",6,"ا",2,0],["كَما رامَ مِنّا القَينُ أَيّامَ صَوأَرٍ","فَلاقى جِماحاً مِن حِمامٍ مُعَجَّلِ",7,"ل",1,0],["كَما رَضِيتَ بُخلاً وسُوءَ وِلايةٍ","بِكَلبَتِها في أوَّلِ الدَّهرِ حَومَلُ",8,"ل",1,0],["كَم أَرَدتُ السُلُوَّ فَاِستَعطَفَتني","رُقيَةٌ مِن رُقاكَ يا عَيّارُ",9,"ر",1,0],["كم أربعين وأربعي","ن وأربعون تقول قدْ",10,"د",1,0],["كم أرى اللَّه بقوم عِبرة","عند إجرارهمُ فضلَ الرسن",11,"ن",1,0],["كما رأيت صنوف النبت مطلعة","بالماء والشمس أنواعاً من الزهرِ",12,"ر",1,0],["كَما رَأَيتُ الثَلاثاءاتِ واطِئَةً","مِنَ التَخَلُّفِ أَعقابَ الأَثانينا",13,"ن",2,0],["كَم أَرضَعَتهُ الرِسلَ لَو أَنَّ القَنا","تَرَكَ الرِضاعَ لَهُ بِغَيرِ فِضالِ",14,"ل",1,0],["كَما رَأَيتُ الكَوكَبَ المُنقَضّا","فَأَطعَمَ القَومَ شِواءً غَضّا",15,"ض",2,0],["كَم أَرَدتُ التَقى فَما تَرَكَتني","خَندَريسٌ يُديرُها طاوُوسُ",16,"س",1,0],["كما رأى المَلِكُ المنصُورُ شيمَتَهُ","تَبُدو عليك من المنصور قبل تَلي",17,"ل",2,0],["كَما رَأى التُربَ رَأى جُثوَةً","مائِلَةَ الشَخصِ فَما اِستَنكَرا",18,"ر",2,0],["كَما رَمى عَن جِفنِهِ الناطورُ","ساوَرتُهُ وَاللَيلُ مُستحيرُ",19,"ر",1,0],["كَم أَرادَ الخُلدَ قَومٌ فَرَأوا","مَسلَكاً إِن يُلتَمَس لا يُستَطَع",20,"ع",1,0],["كمْ أرَدْنا ذاكَ الزّمانَ بمَدْحٍ","فشُغِلْنَا بذَمّ هذا الزّمَانِ",21,"ن",1,0],["كَم اِرتَفَعَت من أمة بعد أُمة","بتعميمها للعلم والعلم يرفع",22,"ع",1,0],["كما رفَّ نسرٌ راشه السهم فارتقى","خفوقَ جناحٍ وهو بالدمِّ نازفُ",23,"ف",1,0],["كمْ أرْقَمِيٍّ مِنْ بَني وائِلٍ","مُوائِلٍ في حُلّةِ الأرْقَمِ",24,"م",1,1],["كَمْ أَرَّقَتْ عَيْنَي شَجٍ","سَنَةٌ عَلَى عَيْنَيْكِ رَانَتْ",25,"ت",1,0],["كم أرضعوني شراب الوهم. كم سخروا","مني.. وكم غصبت روحي الأكاذيب",26,"ب",1,0],["كم أرى منتظراً وعدَكمُ","ثَقُلَ الوعدُ على المنتظِر",27,"ر",1,0],["كم أرادَ الصبحُ المُتاحُ انطلاقاً","وأرادت له دَياجيه حَبْسا",28,"س",2,0],["كم أربعين وأربعي","ن وأربعين تقولقدْ",29,"د",1,0],["كم أراد بالتجري قطع حب","بلي وحبل الله لم يقطعه شد",30,"د",1,0],["كَم أَرضَعَت أَمَلاً شَكا إِجرارَهُ","دَرَّ النَوالِ وَلَم يُرَع بِفِصالِ",31,"ل",1,0],["كَم أُرجِعُ الزَفرَاتِ في أَحشائي","وإلامَ في دارِ الهَوانِ ثوائي",32,"ا",2,1],["كَما رددتُ عليه في الطلاق وفي","تَركِ الزيارةِ أقفو أثر سبسبهِ",33,"ب",2,0],["كم أريدُ السعدَ لكنْ","فوقَ آمالي إرادة",34,"د",2,1],["كَما راعَ ممسى اللَيلِ أَو مُستَوى الضُحى","عَصافيرَ حُجرانِ الجُنَينَةِ أَجدَلُ",35,"ل",1,0],["كما رقتِ الورقاءُ أو هفَّتِ الصَّبا","فأعلمُ أني قد بَلغتُ مراما",36,"م",2,0],["كَمْ أرْهَبُ المَشْرفِيَّ عَضْباً","وأحْذَرُ السَّمْهَرِيَّ لَدْنا",37,"ن",2,0],["كما رَصد العِدى في كلِّ يومٍ","صلاح الدين في سَهْلٍ وحَزْن",38,"ن",1,0],["كَما رُبَّما حاوَلتُ أَمراً بِغَيرِهِ","فَأَدرَكتُهُ وَذو الحِفاظِ وَقورُ",39,"ر",1,0],["كم ارتاعت الدنيا التي كنت ربّها","بجحفلكَ الجرار تزجيه مغبرا",40,"ر",2,0],["كَما رَوى الجود عَن ماء السَماء لَنا","وَغَيره عَن إِياس راحَ يُؤثرهُ",41,"ر",2,0],["كَما رَجاءُ اللَهِ إيمانُ","كَذا رَجاءُ الناسِ كُفرانُ",42,"ن",1,0],["كَم أَرغَمَت سَكَراتُها","دَع أَنفَها تَحتَ الرَغامِ",43,"م",1,0],["كم أرومُ اكتسابَ مجدٍ رفيعٍ","وصروفُ الزّمان تُثني عناني",44,"ن",2,0],["كم أرَتْني لا أرَتْها راحةً","غيرَ ما يخطُرُ منهنَّ ببالي",45,"ل",2,0],["كم أرْغَمَتْ أَنْفَ الحسود سطوةً","وغَمرتْ بالبرّ معتفينا",46,"ن",2,0],["كم أراشت أسهماً ألحاظُه","يا له في الحبّ من رامٍ رمى",47,"م",2,0],["كما روت عن فعال الليث صائلةً","فلو تكلفها العقبان هائلةً",48,"ه",1,0],["كم أردى الضد محل الجد","ورمح رد به خصما",49,"م",2,0],["كما رُفعت مُظْلِماتُ العيون","إِلَى قَمَرٍ طالع فِي غمامَهْ",50,"م",2,0],["كما رفع الآلُ الهوادجَ بالضُّحى","غَداةَ استَقَلَّتْ بالخليطِ حُمُولُ",51,"ل",1,0],["كما رجعت إلى المفقود من عمري","مجددا في نعيم ناضر ساني",52,"ن",2,0],["كم أربٍ كنت إليه سببي","فتلتَه بمُحصَد المرائرِ",53,"ر",1,0],["كم أرانا قداً ولحظاً وجفناً","فأرانا رمحاً وسيفاً وسهما",54,"م",2,0],["كم أراني الزّمانُ قبلك مَن كُنْ","تُ خَليّاً منه فعدتُ شَجِيّا",55,"ي",2,0],["كم أراد العُداةُ ثَلمي وقدّر","تَ سواه فلم يَرَوْني ثليما",56,"م",2,0],["كم أرادوا بِيَ الشّقاءَ فأبْدَلْ","تَ بما حاولوه منّي نعيما",56,"م",2,0],["كم أراني قصراً مشيداً فما لب","بثَ حتّى رأيتُه مهدوما",57,"م",2,0],["كم أرَعَدَ الجَوُّ فاهَتزَّتْ جَوانِبُهُ","ثُمَّ انتَهَى الرَّعدُ لم يفَعَلْ سَوَى القَلَقِ",58,"ق",1,0],["كم أَرادَتْ عِداه إِطْفاءَ نورِ","اللهِ ظُلْماً فأَظْلَموا وأَنَارَا",59,"ر",2,0],["كم أرسلت أدمعي تترى بصدقيَ في","دعوى هواكم فقابلتم بتكذيب",60,"ب",1,0],["كم اراقت باريسُ فيكِ دِماءً","من بنيها تماثل النِيلَ صبا",61,"ب",2,0],["كم أرقنا دماءنا وبذلنا","لك أرواحنا بأيد سخيه",62,"ي",2,0],["كما رُصَّتْ قدودٌ تَس","تبي الألبابَ بالرصِّ",63,"ص",1,0],["كم أرى مِن مستعجبٍ من نعالي","ورِضائي منها بلُبْسِ البَوالي",64,"ل",2,1],["كَما رَشَفَ الصادي وَقائِعَ مُزنَةَ","رَشاشٍ تَوَلّى صَوبُها حينَ أَقلَعا",65,"ع",2,0],["كم أرغمت مني العواذل عزْمةٌ","شرق الوشاة بلجها المتدارك",66,"ك",1,0],["كما رفعت أعطافها الشعر واغتدت","تجرّره يا من رأى رافعا جرا",67,"ر",2,0],["كَمْ أرَاشَتْ بِالهُدْبِ مِنْهَا سِهَاماً","وَقْعُهَا فِي القُلُوبِ قَبْلَ الجُلُودِ",68,"د",1,0],["كم أرى أكمها وأعمى بصيرا","كم طفى فتنة وأخمد نارا",69,"ر",2,0],["كم أرشدت حائرا فينا بلاغتها","فان جحدت فهذى العين والاثر",70,"ر",1,0],["كَم إِربةٍ لي في نِعا","جِك فاِقضني تلكَ الإِرَب",71,"ب",1,0],["كَمَا رَمَى فِرْعَوْنُ بِالسِهامِ","نَجْماً بَدَا مِنْ جُوَبِ الغَمامِ",72,"م",1,0],["كَما رَأَيْتَ الوَرَقَ المَطْرُوسا","رَسْماً يُعَفِّيهِ البِلَى مَدْرُوسا",73,"س",2,0],["كم ارى الطرفَ لبيباً فطنا","ماهراً في لجةٍ قد غرقا",74,"ق",2,0],["كما رووا من سيمة السجاد","على ابن السادة الامجاد",75,"د",1,0],["كم أرى كسر الأعادي إذ بسطْ","جمع قومٍ من سطاه فُرّقا",76,"ق",2,0],["كم ارتني لطايفاً قد روت عن","ذلك الفاضل المفضل قولا",77,"ل",2,0],["كما رأيت آدميا أحسنا","في عينه الكحل من الحادي السنا",78,"ن",2,0],["كما رووا نصبا ورفعا يا مطر","وأحرف الإطلاق فيها يغتفر",79,"ر",1,0],["كم أرت عينيَ وجهاً مُشرقاً","وجلت لي من فتاةٍ مبسما",80,"م",2,0],["كم أرشفتني الثغرَ قائلةً","هل في حُميَّا الريقِ من حرج",81,"ج",1,0],["كم أرقنا إلى الصباحِ ولا والله","لم أعنِ غيرَكم من صباح",82,"ح",1,0],["كم أركبوا من كميٍّ في المغار له","من العزيمة بتار وعسال",83,"ل",1,0],["كَمَا رَفَعُوا رَأساً لَهُمْ بعد وَقْعَة","أشَابَتْ بِفَجّ القِيلِ سُودَ الذَّوَائِبِ",84,"ب",1,0],["كمْ أراني في غيهبٍ مُدْلَهمٍّ","منه ضوء المشْكاة والنبراس",85,"س",1,0],["كم أرانا توريد تلك الخدود","من دم طُلَّ بين طرف وجيد",86,"د",1,1],["كم أرادت تشبهاً بك في الج","ود فظلت في خجلة الأزياد",87,"د",1,0],["كم أراك الأراك فيه سجايا","لعبت منك بالفؤاد المذابِ",88,"ب",1,0],["كَما رَأَيتُ طَيفَهُم","فَهَل تُريني عَينَهُم",89,"م",1,0],["كما رفلت به وسط العذارى","فتاة الحي برداً مستعارا",90,"ر",2,0],["كم أرادوا لكَ الفناءَ ولكنْ","لا يخيفُ الرجالَ ذاكَ الوعيدُ",91,"د",1,0],["كم أرشدت فما عَرتها خِشيةٌ","كم أنذرت حتى بدا ما قد خَفى",92,"ا",1,0],["كما رُميت دون الورود غزالةٌ","وقد أفلتت لم تُظفِر المتصيدا",93,"د",2,0],["كم أرشد الدنيا إلى طرق الهدى","فبتدت بدور الرشد بعد تحجب",94,"ب",1,0],["كم أرى سائل دمعي","في حمى فضلك ينهر",95,"ر",1,0],["كَمْ أَرْسَلَ الأَحْزَانَ في الوَطَنِ الغَرِيبِ إلى اغْتِرابِ","فأَتَاهُ مِنْ رَجْعِ الصَّدَى وَجَعُ الصَّدَى وَبِلا جَوَابِ",96,"ب",1,0],["كم أراقوا منهم دماً وكأي","من كمي قد دمروا تدميرا",97,"ر",2,0],["كم أرينا الكون يوما احمرا","بيضنا تكتب أعمار الورى",98,"ر",2,0],["كم أردت الكرى فأبدى لي البد","رُ عتاباً بألسن الأنوار",99,"ر",1,0],["كم ارتقى فيه شعب عند نهضته","أوج الحضارة ذات المجد والشمم",100,"م",1,0],["كما روى ابن اثير في نهايته","وللحوامل اطعمه لنسلهم",101,"م",1,0],["كما رواه البخاري في مسانده","سبح وكبر وحمد اللّه فالتزم",101,"م",1,0],["كم أراني زمنُ الفكرِ بِهَا","مُزعجاتٍ كلُّها للقلبِ قَرْحُ",102,"ح",1,0