oetry.dctabudhabi.ae/diwan/poem/203477","السريع"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97932","الكامل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139978","البسيط"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61284","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110064","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77088","البسيط"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105120","البسيط"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28682","المنسرح"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66165","البسيط"],[4692,"من يشتري الآن مني قلبي الدامي","https://www.poetsgate.com/ViewPoem.aspx?id=215608",""],[4728,"آه من قلبٍ على الضيق محدي","https://www.poetsgate.com/ViewPoem.aspx?id=176989",""],[4759,"ليته عدلا","https://www.poetsgate.com/ViewPoem.aspx?id=204047",""],[4860,"حدث العاقل بما لا يعقله","https://www.poetsgate.com/ViewPoem.aspx?id=32518",""],[3271,"دمعة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=104119",""],[5145,"أرأيت كيف تزعزع الأجيال؟","https://www.poetsgate.com/ViewPoem.aspx?id=108230",""],[5277,"لصُّ الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=191010",""],[5277,"أرضُ ابتسامتها","https://www.poetsgate.com/ViewPoem.aspx?id=191235",""],[5277,"بقايا الملح","https://www.poetsgate.com/ViewPoem.aspx?id=191247",""],[5277,"ظلالٌ وضفاف","https://www.poetsgate.com/ViewPoem.aspx?id=206824",""],[5425,"في كُلِّ يَومٍ لنا من كَربَلاءَ دَمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=207513",""],[5431,"كوننا من فجورهم بات يغلي","https://www.poetsgate.com/ViewPoem.aspx?id=196774",""],[5444,"راية الأمجاد","https://www.poetsgate.com/ViewPoem.aspx?id=209112",""],[5453,"يالكبار اللي ذخرتوا كل عار","https://www.poetsgate.com/ViewPoem.aspx?id=28015",""],[5608,"الهنوف","https://www.poetsgate.com/ViewPoem.aspx?id=32911",""],[5672,"البعد بالأحباب أودى...","https://www.poetsgate.com/ViewPoem.aspx?id=206517",""],[5694,"غرامي","https://www.poetsgate.com/ViewPoem.aspx?id=132097",""],[5753,"وحدي مَعِي..","https://www.poetsgate.com/ViewPoem.aspx?id=200355",""],[5776,"بثينة","https://www.poetsgate.com/ViewPoem.aspx?id=199379",""],[5848,"30","https://www.poetsgate.com/ViewPoem.aspx?id=53372",""],[5956,"أنا أرتينُ المُشاغِبْ","https://www.poetsgate.com/ViewPoem.aspx?id=205157",""],[5977,"إنني أمل","https://www.poetsgate.com/ViewPoem.aspx?id=212728",""],[5991,"أبداً بكم منكم إليكم اهرب","https://www.poetsgate.com/ViewPoem.aspx?id=116382",""],[6052,"بشرى النبوة","https://www.poetsgate.com/ViewPoem.aspx?id=34805",""],[4442,"براعم الروضة أعللها النطف","https://www.poetsgate.com/ViewPoem.aspx?id=171004",""]],"verses":[["مَن يُشرِقُ الخَصمَ الأَلَدَّ بَريقِهِ","عَيّاً وَيَقدَعُ مِنهُ ما لَم يُقدَعِ",0,"ع",1,0],["من يشتري الدنيا ولو بأحب ما","فيها أباءته بصفقة خاسر",1,"ر",1,0],["من يشتر الطربوش يكشف ستره","بيديه والطربوش بالدينار",2,"ر",1,0],["من يَشتريها شرّ ما سلعةٍ","من يشتريها بئسَتِ اللَّقطه",3,"ط",2,0],["مَن يُشِن وَعدَهُ المِطالُ يُناجِز","مُنجِحاً أَو يُزانُ بِالنُجحِ وَعدُه",4,"د",2,0],["مَن يَشكُرِ اللَهَ يَشكُر أَوَّلِيَّةَ ذا","فَالدينُ مِن بَيتِ هَذا نالَهُ الأُمَمُ",5,"م",1,0],["من يشأ أن يفيض يوماً بشك","واه فما هذا موضع الأحزان",6,"ن",1,0],["مَن يشتري السُمَّ الذُّعافَ بسائغٍ","عَذبِ النِّطافِ مُصفَّقٍ سَلْسالِ",7,"ل",1,0],["مَن يَشتَري حَسَبي بِأَمنِ خُمولِ","مَن يَشتَري أَدَبي بِحَظِّ جَهولِ",8,"ل",1,1],["مَن يَشتَري مَشيبي","بِالشَعَرِ الغِربيبِ",9,"ب",1,1],["مَن يَشتَري مَشيبي","وَلَيسَ بِالمُصيبِ",9,"ب",1,0],["مَنْ يَشْهَدُ القرآنُ فيه بفضْلِهِ","وتُصَدّقُ التّوراةُ والإنجيل",10,"ل",1,0],["مَن يشتكي البينَ لا يشكو غوائلهُ","قلبٌ يراكَ إذا ما غِبتَ عن بَصرِهْ",11,"ه",1,0],["من يشتري مني الحياة جميعَها","بالموت إني للحياة أبيع",12,"ع",1,0],["مَن يشترِيها وهْيَ قَضّاءُ الذّيْلْ","كأنّها بَقِيّةٌ مِنَ السّيْلْ",13,"ل",1,1],["مَن يَشُب مَقالَتَهُ","بِالشُكوكِ يَعتَرِها",14,"ر",3,0],["مَن يَشْتَرِي حُسْنَ الثَّناءِ فإنّما","بِفعالِهِ يَشْرِيهِ لا بِالْمَالِ",15,"ل",1,0],["من يش