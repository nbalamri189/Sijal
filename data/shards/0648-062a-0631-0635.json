{"poems":[[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54299","الخفيف"],[449,"دع عنك صهباء الدساكر","https://www.aldiwan.net/poem56047.html","عموديه"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83240","الكامل"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/132061","الوافر"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105151","الطويل"]],"verses":[["وَتَرٌ صاغه الإلهُ وألقَى","نَغَماتِ الفِرْدَوْسِ في نَغَماته",0,"ت",2,0],["وترصدوا سير النجو","م وراقبوا أعلى الدوائر",1,"ر",1,0],["وَتَرَصَّعَت تيجانُها بِفُصوصِها","كُتِبَت بِجانِبِها يَعيشُ مَليكُنا",2,"ن",2,0],["وترصيع نجومك أم حباب","تؤلف بينه اللجج الغزار",3,"ر",1,0],["وترصده من لحظه وقوامه","صقال المواضي والرماح الشوارع",4,"ع",1,0]]}