{"poems":[[55,"رضيت من الأحباب دون الذي يرضي","https://www.aldiwan.net/poem30167.html","الطويل"],[55,"نبهتهم مثل عوالي الرماح","https://www.aldiwan.net/poem30651.html","السريع"],[79,"تعلقته من دوحة الجود والباس","https://www.aldiwan.net/poem35881.html","الطويل"],[64,"ومساعد لي في البكاء مساهر","https://www.aldiwan.net/poem52510.html","الكامل"],[63,"نوب الزمان قلائد الأعناق","https://www.aldiwan.net/poem51346.html","الكامل"],[50,"لأعذلن فؤادي أبلغ العذل","https://www.aldiwan.net/poem64989.html","البسيط"],[48,"أفوق البدر يوضع لي مهاد","https://www.aldiwan.net/poem23638.html","الوافر"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30450","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[108,"الربيع الحائل","https://www.poetsgate.com/ViewPoem.aspx?id=179488",""],[108,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[92,"الدم يتكلم بعد عشرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=179112",""],[128,"وادته بعد تجاذب وتدافع","https://www.aldiwan.net/poem23745.html","الكامل"],[215,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[303,"أيصحو عاشق أم يستفيق","https://www.aldiwan.net/poem36284.html","عموديه"],[385,"واحر غلة قلبي الوقاد","https://www.aldiwan.net/poem48838.html","الكامل"],[396,"لك الخير يا عثمان وفقت للرشد","https://www.aldiwan.net/poem54586.html","عموديه"],[422,"ألا إن هذا الفؤاد اضطرم","https://www.aldiwan.net/poem54173.html","المتقارب"],[463,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[518,"أفوض أسبابي إلى الله كلها","https://www.aldiwan.net/poem67735.html","الطويل"],[520,"هل القلب إلا مضغة تتقلب","https://www.aldiwan.net/poem12016.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138195",""],[857,"","https://poetry.dctabudhabi.ae/diwan/poem/73709","الوافر"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129526","الطويل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126188","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64562","الطويل"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102285","المنسرح"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95507","الكامل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42408","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27969","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137228",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201203","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204656","المجتث"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110005","الرجز"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216815","المتقارب"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131235",""],[3865,"","https://poetry.dctabudhabi.ae/diwan/poem/203213",""],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54503","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133208",""],[4454,"","https://poetry.dctabudhabi.ae/diwan/poem/199422","السريع"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58117","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72527","البسيط"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99105","الوافر"],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124665","البسيط"],[4835,"أفوض إن أراد الله أمراً","https://www.poetsgate.com/ViewPoem.aspx?id=187163",""],[4578,"يا من سمت بمعانيه قوافينا","https://www.poetsgate.com/ViewPoem.aspx?id=49532",""],[4929,"ملكة البيان","https://www.poetsgate.com/ViewPoem.aspx?id=208522",""],[4960,"في وداع طِفلة","https://www.poetsgate.com/ViewPoem.aspx?id=210407",""],[3271,"على مذبح الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=103196",""],[5092,"لا لون يجمعنا","https://www.poetsgate.com/ViewPoem.aspx?id=177261",""],[5174,"ملكة البيان","https://www.poetsgate.com/ViewPoem.aspx?id=208670",""],[5213,"ان الفنغراف الذي ما قلت أقبله","https://www.poetsgate.com/ViewPoem.aspx?id=170565",""],[5273,"مساء الخير","https://www.poetsgate.com/ViewPoem.aspx?id=183101",""],[5649,"ركب الخير","https://www.poetsgate.com/ViewPoem.aspx?id=39018",""],[5691,"خطب مكدسة","https://www.poetsgate.com/ViewPoem.aspx?id=206132",""],[5691,"أفْوافٌ...!","https://www.poetsgate.com/ViewPoem.aspx?id=207696",""],[5695,"قبضة من أثر الأسلاف..","https://www.poetsgate.com/ViewPoem.aspx?id=212556",""],[5848,"لا تعودها","https://www.poetsgate.com/ViewPoem.aspx?id=53160",""],[5853,"أفول شعر الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=175720",""],[6134,"الشمس قد حجبت حزناً على القمر","https://www.poetsgate.com/ViewPoem.aspx?id=169564",""],[6187,"آخر أنفاس الحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82157&r=&rc=0",""]],"verses":[["أُفَوِّقُ نَبلَ القَولِ بَيني وَبَينَهُ","فَيُؤلِمُني مِن قَبلِ نَزعي بِها عِرضي",0,"ض",2,0],["أَفوزُ مِنها بِاللُبابِ الَّذي","يُغني الأَماني نَيلُهُ وَالصُراح",1,"ح",1,0],["أفوِّضُ للرّحمانِ أمْريَ في الهَوى","وأعْلِقُ كفّي منْ حِماهُ بأمْراسِ",2,"س",1,0],["أفوادِعٌ طولَ النهار مرفَّهٌ","كمعذّبٍ بصباحه ومسائهِ",3,"ا",3,0],["أفواقه مثل النصال إذا رمى","ونصالهم في الرمي كالأفواف",4,"ف",1,0],["أُفٍّ وَأُفٍّ لِقَلبي ما استَجَبتُ لَهُ","قَلباً لَقَدكانَ مِنّي غَيرَ ذي أَمَلِ",5,"ل",1,0],["أفَوْقَ البَدْرِ يُوضَعُ لي مِهَادُ","أمِ الجوْزاءُ تحْتَ يدِي وِسادُ",6,"د",1,1],["أَفُوهُ بما لم آتِهِ مُتَعَرِّضاً","لحُسْنِ المعانِي تَارةً فأَزِيدُ",7,"د",1,0],["أفؤادُ عش للنيلِ ذُخراً إِنما","بِنَدَا كما تحيا البلادُ وتنضُر",8,"ر",1,0],["أفؤادُ، هذي دارة الأهرام، قم","تسمرْ؛ فإنك زينة السُّمَّار",9,"ر",1,0],["أفَوْقَ الأرض يُضْمَنُ -ليت شعري!-","بهذا الكشف للعلم انتشار؟",10,"ر",1,0],["أفوعدُ مُرتقِبِ \" القيامةِ \" خُلَّبٌ","وبريقُ منتظِر \" النُشور \" جَهام ؟",11,"م",1,0],["أفوحدي كنتُ الشَّجاعةَ فيكمْ","أولا تملكون بعدُ شُجاعا",12,"ع",2,0],["أَفؤاد خطبك والخطوب كثيرة","سيظل خطب العمر دون منازع",13,"ع",1,0],["أفؤاد قل لي ورد وجهك ماله","قد حال من قان لأصفر فاقع",13,"ع",1,0],["أفؤاد ما الدنيا سراب بقيعة","وقح يقعقع في مفازة باقع",13,"ع",1,0],["أفؤاد جئتك للسلام فحيني","واجتح حدود الرمس إن تك سامعي",13,"ع",2,0],["أفوق ربوعه غامت سماءٌ","مؤججةٌ بأقباس اللهاب",14,"ب",1,0],["أَفول وقد بدتْ للعينِ عِينٌ","ووِلدانٌ لناظرها تروق",15,"ق",1,0],["أَفوَت مَنازلَهُم وَكانَت مُدة","مَأوى العفاة وَمَوطن الوَفّاد",16,"د",1,0],["أفوز بهادينا وأخرى بلا مرا","ويصلح بها قلبي وأبلغ بها قصدي",17,"د",2,0],["أفوز بباب عليّ الجناب","فأروي محاسن تلك الشيم",18,"م",1,0],["أفوِّقُ عزمتي شوقاً إليكم","ويَقبِضُني الحياءُ فلا أصيبُ",19,"ب",1,0],["أفوض أسبابي إلى اللَه كلها","وأقنع بالمقدور فيها وأرتضي",20,"ض",2,1],["أفوه بحق كلما رمت ذمهم","وما غير قول الحق لي قط مذهب",21,"ب",1,0],["أفؤادنا فقت الملا بمآثر","ومفاخر وحجى وفرط ذكاء",22,"ا",2,0],["أَفوتُ بِهِ السَّوابِقَ وَهيَ تَجري","بِشِدَّةِ جَهدِها وَأَنا مُريحُ",23,"ح",1,0],["أفوق سواد الليل تبغي نجومه","غشاء فلم لم تصح أعينها الرمد",24,"د",1,0],["أفَواحةٌ والبيدُ تزأر حولها","والماء منبجسٌ بقلبٌ بقلب صفاته",25,"ت",2,0],["أفوض أمري واضطراري ومهنتي","لمقتدر باق فيكشف معضلا",26,"ل",2,0],["أفوت ليلى بالطول واشتملت","أجفان عيني به على القصر",27,"ر",1,0],["أفؤادُ نعم العهد عهدك أنه","عهدٌ يحقّق سؤلنا المأمولا",28,"ل",2,0],["أفوزُ بخلٍّ في الأنام لأنَّني","مشوقٌ إلى رؤيا صديقٍ يسلّيني",29,"ي",1,0],["أفوض أحوالي إليك مسلما","لأكتب فيمن أمره للرضى يفضي",30,"ض",2,0],["أفؤاد حسبك ان صفو ودادي","لك مثل ما لا بيك ملء فؤادي",31,"د",2,1],["أفوقُ ولكن لا أروم تفوقاً","وأسبق من يعدو ولست أسابقُ",32,"ق",1,0],["أفوز منه وأحظى","في يقظتي بمرادي",33,"د",2,0],["أَفواهُهم ما بَرِحَت","بكلّ خِزيٍ ناطقه",34,"ق",2,0],["أفوق القبور غناء الغرام","وطيب المقام وصفو السمر",35,"ر",1,0],["أفواد يبكيك الصبى متلهفاً","بمدامعٍ حرى أبين جمودا",36,"د",2,0],["أفّو عليك مقداف أفو","قد وصل أذاك اليَّا",37,"ي",2,1],["أَفواهُ أَهلِ الفَضْلِ ناطقةٌ لها","بالفَضْلِ إن قيسَتْ بشِعرِ الأَفوهِ",38,"ه",1,0],["أفوز بالقرب منكم يا حياتي وروحي","واكشف الغم نجوني كمثل ابن متى",39,"ت",2,0],["أف وتف يا أخي عاجلاً","لهذه الدار وأقذارها",40,"ر",3,1],["أفواهُهُمْ رطْبَةٌ في ذكْرِ خالقِهم","لم يَفْتُروا أبَداً صُبْحاً وآصالا",41,"ل",2,0],["أفواها دلعت للنار ألسنة","فقررت درس ملك الروس تقريرا",42,"ر",2,0],["أفون مطارح الأمل انتظاراً","وأسرح بين سقمٍ واغتراب",43,"ب",1,0],["أفول والدمع من عيني منسكب","مثل السحاب إذا ما انهل وابله",44,"ل",2,0],["أفوض إن أراد الله أمراً","وأترك ما أريد لما يريد",45,"د",1,1],["أفواه أطماعنا بالحق معلنةً","ليست تاجي بما أبدت براهينا",46,"ن",2,0],["أفواههم شاقها رطْنُ التي نبتتْ","على فُتاتِك يشكو ظلُّها الرَّمْضَا",47,"ض",2,0],["أُفولُكِ البِكر نزفٌ هَبَّ في دَمِنا،","يا أيُّذاكَ الأُفولُ: الكل قد أفَلوا",48,"ل",3,0],["أفوافُ من لُمع السنا ، ومطارفٌ","يلقى غلائلها على الربواتِ",49,"ت",1,0],["أفواهنا سكرتْ , نامت مباسمنا","لمّا شربنا عصيرَ الصمتِ إذعانا",50,"ن",2,0],["أفواهم شاقها رطْنُ التي نبتتْ","على فُتاتِك يشكو ظلُّها الرَّمْضَا",51,"ض",2,0],["أفوه عينا بما تحكي فتعرفني","إنى لسان الذي قد ظنني اذنا",52,"ن",2,0],["أفوحُ مُرتِّلا حُزني كأني","أفوحُ مَِن السّجائرِ كالدّخانِ",53,"ن",1,0],["أَفْوَاجُ زُوَّارِهَا تَتْرَى وَمَا انْقَطَعَتْ","طَوْراً تُصَبِّحُهَا حِيناً تُمَسِّيهَا",54,"ي",3,0],["أفْواهُ أمَّتِنا مفْتوحةٌ سَغَباً","لكنْ تُكَمُّ لدى التَّعبيرِ باللُّجُمِ !",55,"م",1,0],["أفْوافُهُ الدّيباجُ خَضَّلَهُ النَّدى","وذُيولُهُ خَمْلٌ تأنَّقَ ناعِمُ",56,"م",1,0],["( أفولاي ) ! أسمعنا شعرا..","يحرّق في الروح ما أُحرقا..",57,"ق",2,0],["( أفولاي ) ! يا أيها الجبلي العتيق..","أضعنا إلى القلعة الطرقا..",57,"ق",2,0],["أفواج وافواج لين اروح في يدها","وتمرّني ذكرياتٍ غصنها داني",58,"ن",2,0],["أفول شعر الهوى في داخلي آنا","إلّاه ُ يبقى بها لله يقظانا",59,"ن",2,1],["أفواه كل الملا ترثيه نادبة","في زهرة العمر اضحى الغصن بالحفر",60,"ر",1,0],["أفؤادى ارتح عش على ثقة","أنى لخلع كرامتى ضد",61,"د",1,0]]}