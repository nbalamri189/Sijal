الكامل"],[4413,"","https://poetry.dctabudhabi.ae/diwan/poem/146586","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141679","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120496","الكامل"],[4620,"","https://poetry.dctabudhabi.ae/diwan/poem/199983","الكامل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67434","الكامل"],[2052,"فقن الظباء سوالفاً ونحورا","https://www.poetsgate.com/ViewPoem.aspx?id=201386",""],[4858,"الأم","https://www.poetsgate.com/ViewPoem.aspx?id=30460",""],[585,"نظر المشيب إليك قبل أوان","https://www.poetsgate.com/ViewPoem.aspx?id=161877",""],[5183,"أَلْمُهلَّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186461",""],[5205,"أنظرت أم فوقت سهما","https://www.poetsgate.com/ViewPoem.aspx?id=120999",""],[5268,"شروق","https://www.poetsgate.com/ViewPoem.aspx?id=207006",""],[592,"إلى الله نشكو إننا بمحلة","https://www.poetsgate.com/ViewPoem.aspx?id=128840",""],[5442,"خل دمعي فقد اصاب مسيلا","https://www.poetsgate.com/ViewPoem.aspx?id=114777",""],[5790,"أنظرت أم فوقت سهما","https://www.poetsgate.com/ViewPoem.aspx?id=112135",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[5881,"أيقظت جذوتها","https://www.poetsgate.com/ViewPoem.aspx?id=183803",""],[5897,"فضاءات حمد","https://www.poetsgate.com/ViewPoem.aspx?id=156362",""],[5937,"إلى شاعرٍ في الرُكن","https://www.poetsgate.com/ViewPoem.aspx?id=211897",""],[5939,"تعريف من معجم العشق","https://www.poetsgate.com/ViewPoem.aspx?id=180328",""],[5956,"إن صارت الدنيا بدون بلابل","https://www.poetsgate.com/ViewPoem.aspx?id=202500",""],[6152,"شمس صباحي","https://www.poetsgate.com/ViewPoem.aspx?id=203715",""],[243,"صحيفة الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68182&r=&rc=174",""],[6259,"حكمُ المنيَّة في البريَّة جارِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59422&r=&rc=70",""],[2220,"والليلُ ليلُ الهوى والطبع إذ يغشى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11505&r=&rc=379",""]],"verses":[["وَلَوِ اِستَطاعَ لَقَد جَرى","مَجرى الوِشاحِ عَلى حَشاها",0,"ا",3,0],["وَلوِ اِسطاعَ وَالمَطِيُّ تَسامى","شَبَّ فَوقَ الرِجالِ بِاللَيلِ نارا",1,"ر",2,0],["ولوِ اسْتَطَعْتُ كَفَفْتُ عنهُ يَدَ الرّدى","بِشَباةِ رُمْحٍ أو غِرارِ حُسامِ",2,"م",1,0],["ولَوِ اسْتُميلَتْ عَنْهُ هامَةُ مارِقٍ","لَدعا صَوارِمَهُ إلَيْها المِغْفَرُ",3,"ر",1,0],["ولَوِ اسْتُطيلَ على الحِمامِ بعِزَّةٍ","رُفِعَتْ بِها اليَزَنِيَّةُ السَّمْراءُ",4,"ا",2,0],["ولَوِ اسْتَطَعْتُ رَدَدْتُ مَن يَعْيَى بهِ","عنهُ مَخافَةَ أنْ يُلَجْلِجَهُ فَمُ",5,"م",1,0],["وَلَوِ اسْتَعَنْتَ الشُّهْبَ وَاسْتَنْجَدْ تَهَا","حَمَلَ السِّلاَحَ لَكَ السِّمَاكُ الأَعْزَلُ",6,"ل",1,0],["وَلَوِ اسْتَعَنْتَ الدَّهْرَ وَاسْتَنْجَدْتَهُ","لَبَدَتْ لأمْرِكَ طَاعَةٌ وَقَبُولُ",7,"ل",1,0],["وَلَوِ اِستَطاعا فَوقَ ذاكَ لَأَقبَلا","رَغمَ البِلى وَالقَبرِ يَستَبِقانِهِ",8,"ن",2,0],["ولو استطاع لصاغه","دُبُراً ولالْتمسَ انقلابهْ",9,"ب",2,0],["ولو استطاع لحَبْطِ أجرك حيلةً","لاحتال في ذاك احتيالَ أريبِ",10,"ب",1,0],["ولو استَرْكَبَتْكَ حاجةُ ملهو","فٍ لمَا كان ذاك عندك إدّا",11,"د",2,0],["ولو استيقَنَتْ بذلك نفسي","لم أدع ما حَييتُ أن أستعيدَكْ",12,"ك",1,0],["ولو استطعتَ إذا وفيتَ بوعدِهِ","نفَّلتَه حُسنَ الثنا تنفيلا",13,"ل",2,0],["ولو استطعت شفيت من أضغانها","شِيَعَ الرجال بمصر والأحزابا",14,"ب",2,0],["وَلَوِ اِسطَعتَ زِدتَ مِصرَ مِنَ الحَق","قِ عَلى نيلِها المُبارَكِ نيلا",15,"ل",2,0],["وَلَوِ اِستَطاعوا في المَجامِعِ أَنكَروا","مَن ماتَ مِن آبائِهِم أَو عُمِّرا",16,"ر",2,0],["وَلَوِ اِستَشهَدَ الفَرَنسيسُ روما","لَأَتَتهُم مِن رومَةَ الأَنباءُ",17,"ا",2,0],["وَلَوِ اِستَطَعتُ إِذِ اِغتَدَت رُوّادُهُم","لَمَنَعتُ كُلَّ سَحابَةٍ أَن تَقطُرا",18,"ر",2,0],["ولَوِ اسْتَطَعْتُ مَنَعْتُ لَفظَكَ غَيْرَةً","كي لاَ أَراهُ مُقَبِّلاً شَفَتَيْكا",19,"ك",2,0],["وَلَوِ اِستَطاعَ لَكانَ يَومُ وِصالِهِ","لِلمُستَهامِ مَكانَ يَومِ صُدودِهِ",20,"د",2,0],["وَلَو استَأنَفَ رُشداً لاطَّبى","عَطفَ مَنّانٍ إِذا استُعطِفَ مَنّ",21,"ن",1,0],["وَلَو أَسقَيتَهُم عَسَلاً مُصَفّى","بِماءِ النيلِ أَو ماءِ الفُراتِ",22,"ت",1,1],["وَلَو أَسقَبَت أُمُّ العَلاءِ بِدارِها","إِذاً لَتَلَقَّتني لَها غَيرَ عائِفِ",23,"ف",1,0],["وَلَوِ اِسطاعَ أَن يَقيكَ المَنايا","غَيرَ غَبنٍ بِنَفسِهِ لَوَقاكا",24,"ك",2,0],["وَلَوِ اِستَجارَت مِنهُما بِحِمى أَبي","يَحيى لَأَمَّنَها أَعَزَّ جِوارِ",25,"ر",1,0],["وَلَو أَسفَرَت عَن وَجهِها لَبَدَت لَنا","حَقيقتُها لَكنّها تتلثُّمُ",26,"م",1,0],["وَلَو أَسطيعُ ما عَذَّبتُ نَفسي","بِذِكرِكِ غَيرَ مُنصَرِفٍ بِزادِ",27,"د",1,0],["وَلَوِ اِسطَعتُ طائِعاً","في الأُمورِ النَوائِبِ",28,"ب",1,0],["ولو استطعت إذا غدت روّادهم","لمنعت كلّ سحابةٍ أن تقطرا",29,"ر",2,0],["ولو استطعتُ جعلتُ مِسبحتي","ثَمَرَ النهودِ وجلَّ في السُّبَحِ",30,"ح",1,0],["ولو استطاعت نضّدت أوراقها","كفناً له والنعشَ غضَّ أزاهرِ",31,"ر",1,0],["ولو استطاعت رَدَّ ما استودَعْتَها","ردَّتْ عليك المَهْدَ والميلادا",32,"د",2,0],["ولو استطاع لردَّ عنكِ بلاءَهم","وأطارَ كلَّ سفينةٍ أشلاءَ",33,"ا",2,0],["وَلَوِ اسْتَطاعَ لَمَا أَضَاعَ دَقِيقَةً","يَمْضِي الزَّمَانُ بِهَا مُضِيَّ خَسَارِ",34,"ر",1,0],["وَلَو اسْتَطَعْتُ لَرُحْتُ أَثِبِتُ رَسْمَهَا","بِالنَّاظِرَيْنِ وَمَا اكْتَفَيْتُ بِنَاظِرِ",35,"ر",1,0],["وَلوِ اسْتَطَعْتُ لصُغْتهَا منْقُوطَةً","بِالدُّرِّ حَوْلَ الْعَسْجَدِ المَسْبُوكِ",36,"ك",1,0],["ولو استطاع الأرز طأطأ خاشعاً","وأصابَ من تقبيل كفّك زادا",37,"د",2,0],["وَلَو اِستَطاعَ القَولُ قالَ مُشافِهاً","تُفّاحُ جَنّاتِ الخُلودِ شِفائي",38,"ا",2,0],["ولو اِستَحقَقتُ مُعاقَبَةً","لأبى كرمٌ تَتَعَوَّدهُ",39,"د",2,0],["ولو استطعتُ لابتدعتُ كُفوفاً","من هِجاءٍ تَصُكُّ وجَهكَ صَكّا",40,"ك",2,0],["ولو استطاعوا، لافتدَوْهُ من الحما","بألف سيف منهمو بتار",41,"ر",1,0],["ولو استعانَ على البقا","ءِ بألفِ «تاميزٍ، وسين»",42,"ن",1,0],["ولو استطاع لحَبْطِ أجرك حيلة ً","لاحتال في ذلك احتيالَ أريبِ",43,"ب",1,0],["ولو استطعتَ زدتَ مصرَ من","الحقِّ على نيلها المباركِ نيلا",44,"ل",2,0],["ولو استطعت حنيت أض","لاعي على ذاوي سناها",45,"ا",3,0],["وَلَو أَسمَعتَهُ لَأَتى حِثيثاً","سَريعَ السَعيِ أَو لَأَتاكَ يَجري",46,"ر",2,0],["ولو استطعتُ لما اغتبقتُ بشَربةٍ","مما يَمُدُّ فُراتُهم والنيلُ",47,"ل",1,0],["ولو أَسعدتْها من بِساطك خلوةٌ","لَقَبَّله من كل جنسٍ لها وفد",48,"د",1,0],["ولوِ استطعتُ منعتُ إذ وَردَتْ","منْ عَبَّ من شَطَّيْه أو رَشَفا",49,"ف",2,0],["ولو استطعت جرحتُ لفظك غيرةً","أني أراه مقبِّلاً شفتيكا",50,"ك",2,0],["ولوِ استطعتُ خَبَأْتُ شخصَكِ غَيْرَةً","في مُهْجتي مَعَ زَفْرتي وغلِيلي",51,"ل",2,0],["ولَوِ اسْتَطَاعَتْ مِنْ صَبَابَتِهَا","سَارَتْ إليه بِأسْرهَا الحِلَلُ",52,"ل",1,0],["وَلو اسْتَقَلَّت عَوْفُها لقتالها","لاسْتَقبلت بالمُقرَبات عَفَاءَها",53,"ا",3,0],["وَلَو اِستَطعتُ لكَ الفِداء لكُنتهُ","وَوقيتُ جسمك من ثَرى الأَجدافِ",54,"ف",1,0],["وَلَو أَسعفَت قَلبي بدِرياقِ ريقها","لما ضَرَّه أَصلٌّ مِن الشعر لاذعُ",55,"ع",1,0],["ولو استلنتُ بما أُعا","لجه به لأَلنتُ صلدا",56,"د",2,0],["وَلَوِ اِستَطَعتَ حَشَوتَ فاهُ جَواهِراً","وَلَو أَنَّ روحي في يَدي ما عَزَّت",57,"ت",1,0],["وَلَوِ اِستَقَمتَ عَلى سِواءِ سَبيلِنا","لَم تَمشِ في تيهِ الفَلا حَيرانا",58,"ن",2,0],["ولو استطاعَ الخَلْقُ يومَ قُدومِه","من فَرْطِ شَوْقٍ بالقُلوبِ مُوكَّل",59,"ل",1,0],["ولوِ استُطيعَ لكان سَرْجُ حِصانِه","عِزّاً على حَدَقِ الورَى مَحْمولا",60,"ل",2,0],["ولوِ استَطاعَتْ بِيضُهُ لتَسرْبلَتْ","بِدَمِ العِدا من قَبْلِ خَلْعِ الأغْمد",61,"د",1,0],["ولوِ استَطَعْتُ حكَيْتُه وسبَقْتُه","مَغْدىً إليك بمَفْرِقِي ومُراحا",62,"ح",2,0],["ولو أسطيع لم أُعدم خلاصاً","وكيف ومهجتي لك في إسارِ",63,"ر",1,0],["ولَو اسطَعتُ كلَّما قُلتُ بَيتاً","مادِحاً قُلتُ وليكُن مكتُوما",64,"م",2,0],["ولَو استَقامَ عَلى الجحودِ لأَعرَبَت","عَنه شهاداتُ الشهودِ بِما اقتَرَف",65,"ف",1,0],["وَلَو اِستَطَعت كَفَفت أَنفاس الصِبا","عَنهُ وَزدتُ فَم المُنى عَن رَشفِهِ",66,"ف",2,0],["وَلَو اِستَزارَت رقدة لَدَجابِها","ما بَينَ أَجفاني إِلى التَيّارِ",67,"ر",1,0],["وَلَو اسطيع كانَ بَياض عيني","لَها طَرساً وأسودها مِدادا",68,"د",2,0],["ولو أسْقَطْتُ منه زَمانِ همِّي","لقال الناسُ هذا الشَّخصُ سقْطُ",69,"ط",1,0],["ولو أسعَفتني مُقلتَايَ بِقَطْرَةٍ","شفَتْ داءَ أحشائي ولو أنَّها قطْرُ",70,"ر",1,1],["ولو استقَى منها بلالٌ بَلّةً","أعْيَتْ مدائحَهُ على غَيْلانِ",71,"ن",1,0],["ولَو اسْتَجَزْتَ لَهُ المَنامَ لَرَدَّهُ","كي لا يَرى عينَيْكَ فِي الأحلامِ",72,"م",1,0],["ولو استفادوا بُلغْةً من حلمه","ما قِيدَ يوماً بالقتيل القاتلُ",73,"ل",1,0],["ولو أسأرته عسلا مصفى","لأصبح واجبا غسل الإناء",74,"ا",2,0],["وَلوِ استَطعنا لم تَكُن تَطأ الثرى","إِلاّ على الأرواحِ وَالأجسَامِ",75,"م",1,0],["ولوِ اِستطَعْتُ بأن أُجَسِّمَ لفظَهُم","لنظَمْتُ منه قلائِدي وعُقودي",76,"د",2,0],["وَلو اِستطعتُ طرحتُ ثِقْلَ غرامكمْ","فلطالما عاد الأسيرُ طليقا",77,"ق",2,0],["ولو اِستطعتُ نفضتُ كلّ إقامةٍ","إلّا على الكَنَفِ الرّحيب الأوسعِ",78,"ع",1,0],["وَلو اِستَطعتُ كَتمتُ حُبَّكُمُ","للضَّنِّ عَن قَلبي وَعَن صَحبي",79,"ب",2,0],["ولو استُهينَ بضبطهِ لَرأَيتَهُ","نُسَخاً بهِنَّ النَّقلُ لم يَتَقوَّمِ",80,"م",1,0],["ولو استطعتُ قَرَعْتُ قل","بي لا قرعتُ عليك سِنِّي",81,"ن",2,0],["وَلَو اِستَطَعتِ الشَمسَ ذُدتُ لِعابِها","عَن وَجنَتَيكَ وَلَو سَعَت في بَرقَعِ",82,"ع",1,0],["وَلَو استَنَدتَ إلَى الخيارِ وَكَونِهِ","لَكَ ما رَجَعتَ بِصَفقَةِ المَغبُونِ",83,"ن",1,0],["ولو استعرتَ لها يداً من يوسف","فيدُ الخِلافَةِ لا تُطاوِلُها يد",84,"د",1,0],["وَلَو استَطاعَ لَسَرَّهُ ما ساءَها","مِنهُ وَأضحَكَهُ الَّذي أبكاها",85,"ا",3,0],["وَلَو استَمَحت بَنانَهُ مِن قاسِمٍ","لَسَقَى البَسيطَةَ جَودُها وَسَقاها",85,"ا",3,0],["ولو استطعت فركته وأدرته","عنه ولكن ما لقلبي لولب",86,"ب",1,0],["وَلَو اِستَقَمت لخلتني","دُون الأَنام أَبيد ضدك",87,"ك",1,0],["ولو أسقط الجسم مما علا","لما سار قط بخط استوا",88,"ا",1,1],["ولو استطعنا الأمر ما كنّا عدىً","للقوم من أهلٍ ومن جيران",89,"ن",1,0],["ولو استقاموا أسلموا لك بعدما","عرَّفتَهم منهم مكانَ الداء",90,"ا",2,0],["ولو استطعتُ تركتُ فيهم مهجتي","وخرجت من أرضٍ لهم وسماء",90,"ا",2,0],["ولو استطاعوا أن يفرق بيننا","حظروا علينا أن نفي ونغارا",91,"ر",2,0],["ولو استحال إباؤه وولاؤه","لكمُ سيوفاً أصبحا ورماحا",92,"ح",2,0],["ولو استغاثوا قبل ذاك من الردى","وجدوا شفيعاً من رضاك مشفعا",93,"ع",2,0],["ولو استحال على الجديب نصيبه","يوماً لكان على الخصيب حراما",94,"م",2,0],["ولو استطعت جزيتكم بفعالكم","لكنني لا أستطيع فأكظمُ",95,"م",1,0],["ولو استطعت بسطت خفّاقي على","كفّي، بلا وجل ، وقلت تكلم",96,"م",1,0],["وَلَو اِستَطَعتُ حَبَستُ دَمعي إِنَّني","لا أَبتَغي فَرجاً بِحال مَتاعبي",97,"ب",2,0],["ولَوِ اسْتَزَدْتُ لَزِدْتُ في إِطْرابِهِ","حَتّى كأنّي زِدْتُ في إِطْرائهِ",98,"ا",3,0],["وَلَو أَسطِيعُ مِن طَرَبٍ وَشَوقٍ","رَكِبتُ إِلَيكِ أَجنِحَةَ الرِياحِ",99,"ح",1,0],["ولو استطاع بكى بأدمع روحه","شوقاً كما يبكي الندى أزهاره",100,"ر",2,0],["ولو استطعتُ فرشتُ مسقط خطوِهِ","بجفون عينٍ لا ترى التكحيلا",101,"ل",2,0],["ولو استطعت ولو بعمري عمرة","لحججت معتمرا ولم أتحجج",102,"ج",1,0],["ولو استشاط خميسها غضباً","وأقر بين خيامها لحدي",103,"د",2,0],["ولو استطعتُ لزُرتُ أَرضَك ماشياً","بسواد قلبي أَو بأَسودِ ناظري",104,"ي",1,0],["ولو استطال به الرّقاد فإنّه","سيهب يوماً من عميق رقاده",105,"د",2,0],["ولو استدار بك الزمان لأصبحت","لك في عكاظ من البيان فصول",106,"ل",1,0],["ولو استطاع الليل حمل شكاته","هيهات ما حرم المغيب نجومه",107,"م",2,0],["وَلَوِ اسْتَبَانَ مِنَ الضَّآلَةِ مَرَّةً","لَمَنَحْتُهُ عِوَضَ الزَّئِيرِ زَفِيرَا",108,"ر",2,0],["ولو استطاع الناسُ يومَ ركوبهِ","فرشوا لِوَاط جيادِه الاحداقا",109,"ق",2,0],["ولو استعلى على السبع الدرا","ريّ بما في فمه من درر",110,"ر",1,0],["وَلَو اِستَطاعوا مِن عُلاكَ لَصَيَّروا","نُورَ الغَزالَةِ ثَوبَكَ المَعمولا",111,"ل",2,0],["ولو استطعت ضممتها ملكاً","في ظل قلب الوالد البرد",112,"د",1,0],["ولو أسرَّ لكان الحلُ يشهد لي","بأنه هكذا سبحانه قد شا",113,"ش",2,0],["وَلَو اِستَطَعتُ خَبَأتُها ضَنّا بِها","تَحتَ الضُلوعِ وَما شَفَيتُ غَليلا",114,"ل",2,0],["ولو أسطعت لقبَّلَتُ يَدَاً","للنَّدَى قد خُلِقَت والقُبلِ",115,"ل",1,0],["ولو استوعب القريض مديحي","لم أقم بالفروض شكراً وحمدا",116,"د",2,0],["ولّوا سلالاً واتقونا بالحُرَم","واستمطروها ديماً بعد دِيَم",117,"م",1,0],["وَلَو استجارَت فيهِ باكِية الحَيا","مِن ضَرب سَوط البَرق فَهوَ يُجيرها",118,"ر",3,0],["وَلو اِستَقى نَهر المَجرة لارتقى","وَطَويل ذابله إِلَيها سلَّم",119,"م",1,0],["ولو أسطيع ردّ الحتف عنه","رَددت الحتف بالسمر الصعاد",120,"د",1,0],["ولو أسام بديني","لبعته برغيف",121,"ف",1,0],["ولوِ استمدّ الأفْقُ جودَك آمِلاً","ما فارَقَتْ سُحُب الغَمام سَخاءَها",122,"ا",3,0],["وَلوَ اَسفرت بكرُ الغيوبِ لثامَها","لبكى الضحوكُ بل استعار النادبه",123,"ب",2,0],["وَلو استطاع لرد ذلك آدمٌ","بَين الجِنان وَرستمٌ في جحفل",124,"ل",1,0],["ولو اسطاعت خلافاً للقضاء","لاستحقت منه لعن الآخرة",125,"ه",1,0],["ولو استويتَ على الخلودِ وجدتَهَا","كفؤًا لعينك لا تروم سواها",126,"ا",3,0],["وَلَو اِستَعارَ المُزنَ بارَقَ ثَغرَهُ","ما مَجَّ غَيرَ الشَهدِ في سَيَلانِهِ",127,"ن",2,0],["ولوا سر عادٍ لم يلووا على أحدٍ","وأصبحوا في بقاع الأرض فلالا",128,"ل",2,0],["وَلَو آسى حَليلَتَهُ لَلاقى","هُنالِكَ مِن أَسِنَّتِنا حِماما",129,"م",2,0],["ولو أساء لقلت ما","عندي مفاتحه ويابه",130,"ب",2,0],["ولو استطاعت لكانت قمصه","أعين ما نظرت إلا إليه",131,"ه",1,0],["ولو استطعت نظمت في أبياتها","آي الكتاب مرتلاً ترتيلا",132,"ل",2,0],["ولو استطعت حملت علة جسمه","وقرنتها مني بعلة بالي",133,"ل",2,1],["ولو استطعت لكنت أنظم كل در","ريّ له مدحاً أو التنزيلا",134,"ل",2,0],["ولو استطاعت امة الثقلين ان","تنتابه مثلت لديه مثولا",135,"ل",2,0],["ولو استطعت بكل اسم في الورى","من لذة الذكرى به سميته",136,"ه",1,1],["ولو استطعت حملت عنك ترابه","فلطالما عني حملت نوائبي",137,"ب",2,0],["ولو استطعت حجبتهن بناظري","وجعلت أهداب الجفون سفورا",138,"ر",2,0],["ولو أسطيْعُ أنْ أحصي جميلاً","لأمي ما كفاني القولُ حقبا",139,"ب",2,0],["ولو استتب لك اكتناه خفيها","لعجبت كيف تسامُ كل هوان",140,"ن",1,0],["ولو استطاعت أن تجسم للهوى","في صبرها لتجسمت في ذاته",141,"ت",2,0],["ولو استطعت عناقه","لو سعته ضما ولثما",142,"م",2,0],["ولو أسبَلتِ جَفنًا تُلوَ جَفنٍ","لأعجزتِ الخليلَ معَ ابنِ سينا",143,"ن",2,0],["ولو أسعدا ما كان منا لثلبهم","سبيلاً فما كنا كنم قال واعتدا",144,"د",2,0],["ولو أسعدا كنا لمن كان مسعدا","من الغاغة النوكا ومن قال منشدا",144,"د",2,0],["ولو اسطاع كان من شدة الشو","ق إلى الحي للرياح زميلا",145,"ل",2,0],["ولو استطعت جعلت من","لثمي على شفتيه ختما",146,"م",2,0],["ولو أسفرت عن وجهها ولثامها","أضاء جنان الخلد منها سفورها",147,"ر",3,0],["ولو استطاع العود عاد لطبعه","لكنها الحمى أفاق جنونها",148,"ن",3,0],["ولو استبد بقوتي وجلي","واليأس قصر دونه الأملُ",149,"ل",1,0],["ولو استقاموا للغرام لنالهم","من نورهِ ما لم ينلهُ بَريقُ",150,"ق",1,0],["ولو أُسميكِ مِصيدةً غَرَرْتِ الغِرَّ مُغْر