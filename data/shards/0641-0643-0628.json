"https://poetry.dctabudhabi.ae/diwan/poem/64456","الطويل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137864",""],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120692","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67202","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76147","البسيط"],[2751,"","https://poetry.dctabudhabi.ae/diwan/poem/138890",""],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117043","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86312","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66481","الرمل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66463","الطويل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66546","الكامل"],[3928,"","https://poetry.dctabudhabi.ae/diwan/poem/131347","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[4097,"","https://poetry.dctabudhabi.ae/diwan/poem/147249","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72475","البسيط"],[4767,"الخطب العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=198279",""],[1012,"السجسج","https://www.poetsgate.com/ViewPoem.aspx?id=186252",""],[3591,"حسنات الفقير عند نبي الدّن","https://www.poetsgate.com/ViewPoem.aspx?id=149471",""],[5106,"ذَاْكَ عُذْرٌ تَاْفِهٌ ..","https://www.poetsgate.com/ViewPoem.aspx?id=137255",""],[5219,"مراثي العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=193704",""],[5219,"تواضع تكن ...","https://www.poetsgate.com/ViewPoem.aspx?id=194988",""],[5327,"الفَلُّ المَارِد !","https://www.poetsgate.com/ViewPoem.aspx?id=140752",""],[5442,"ما آذنته بينها أسماء","https://www.poetsgate.com/ViewPoem.aspx?id=114772",""],[5725,"واذا الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=181554",""],[402,"إن بكى الشرق فالمصاب أليم","https://www.poetsgate.com/ViewPoem.aspx?id=36206",""],[5956,"إذا ضعفُ عينيَّ لم يستبِنْكَ","https://www.poetsgate.com/ViewPoem.aspx?id=194206",""],[5309,"سلام على ذكر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""]],"verses":[["فَكَبَا لِلْيَرَاعِ طِرْفٌ عَتِيقٌ","قد أَجَدْتُ اخْتِيَارَهُ وَاعْتِيَامَهْ",0,"م",2,0],["فَكِبَارُ الأَحْلامِ تَغْرَقُ فِيهِ","وَصِغَارُ الأَحْلامِ فِيهِ تَعُومُ",1,"م",1,0],["فَكَبا كَما يَكبو فِنيقٌ تارِزٌ","بِالخُبتِ إِلّا أَنَّهُ هُوَ أَبرَعُ",2,"ع",1,0],["فَكَبا كَما يَكبو الجَوادُ عَلى الثَرى","شُدَّت عَلَيهِ فَوادِحُ الأَثقالِ",3,"ل",1,0],["فَكَبَّروا فيها وَصَلّى العِدا","وَاِختَلَطَ المَشهَدُ بِالمَشهَدِ",4,"د",1,0],["فَكَبيرٌ أَلّا يُصانَ كَبيرٌ","وَعَظيمٌ أَن يُنبَذَ العُظَماءُ",5,"ا",2,0],["فكبريت وزرنيخ وملح","وفرّار يفيد ويستفيدُ",6,"د",1,0],["فَكَبا كَما يَكبو الكَمِيُّ تَصَرَّفَت","أَيّامُهُ وَاِنبَتَّ مِن أَبطالِهِ",7,"ل",2,0],["فكبّرَتِ الفُرْسانُ للّهِ إذ بَدا","وظَلّ السّلاحُ المنتضى يتقعقع",8,"ع",1,0],["فكبّرَ ثم قدّسَ ثم صلّى","مقادسةُ الأساقفةِ الكِبار",9,"ر",1,0],["فَكَبَّرَ مِمَّا رَآهُ الأَمِي","رُ وَهَلَّلَ أَشْهَادُ ذَاكَ النَّدِي",10,"د",2,0],["فكُبَّ أَبو جَهْلٍ صَريعاً لِوَجْهِهِ","وعتبةُ قَدْ غادَرْنَهُ وَهْوَ عَائرُ",11,"ر",1,0],["فكبا كما يكبوا الجواد على الثّرى","شدّت عليه فوادح الأثقال",12,"ل",1,0],["فكبّر الرّكب مرتاحا إلى أمل","عذب المجاجة حالي الوشي ريّان",13,"ن",1,0],["فكبِّر على عقله أربعاً","وقل فوق طورك هذا الخبر",14,"ر",1,0],["فكبيرُ عفوِ الرَّبّ مَوْ","قُوفٌ على الذَّنْب الكبيرِ",15,"ر",1,0],["فكبى لهما (قاسيون) وَلِمْ","لا يندبُ تاجاً وَسريرا",16,"ر",2,0],["فكَبَت بهم خيلُ الحياةِ بشَوطها","وَجَرَت بِهم نُجُبُ المماتِ سَواءَ",17,"ا",2,0],["فَكبيرٌ يُحَدثنَ صَغيراً","وصغيرٌ يُحَِدثنكبيرا",18,"ر",2,0],["فَكبر النَهر وَثارَ المَوجُ","وَمِن يَد الكَلب تَلاشى الزَوجُ",19,"ج",1,0],["فكبرت لما أن بدت لي بلدةٌ","بها سكنت طيا وطال احتلالها",20,"ل",3,0],["فكبرت إجلالا وبادرت عزة","وهللت تعظيما وقمت مسلما",21,"م",2,0],["فكبر إجلالا فناداه ربه","صدقت أنا الأعلى بغير منازع",22,"ع",1,0],["فكبر إجلالا فناداه ربه","صدقت أنا الأعلى العلي المعظم",23,"م",1,0],["فكبر المصطفى وقال لهم","كبر جبريل من مسرته",24,"ت",2,0],["فكبروا كبرت إذا عصب ال","إسلام بشرا بنصر دولته",24,"ت",2,0],["فكبيرنا متعجرف وصغيرنا","عبدٌ وإما من بقي فمرآئي",25,"ي",1,0],["فكبر حظوظي منك في كل مطلب","وفي كل ما يرضك عزمي وهمتي",26,"ي",1,0],["فكبر دنيء الاصل ان احتماله","وان لم يفز بالقول صعب على الحر",27,"ر",1,0],["فكبيرُهُم وإمامُهُم صِدِّيقُهُم","فهو الذي واساك في الأزماتِ",28,"ت",1,0],["فكبا على وجهِ الثرى","أفديه من كابٍ صريع",29,"ع",1,0],["فَكَبَّرَ الناسُ إِعظاماً لربهم","وَكُلُّهم طرفه بِالسُهدِ مَكحولُ",30,"ل",1,0],["فكبر القوم لما أن بدا لهم","نور الإله ولا يدرون ما فعلوا",31,"ل",3,0],["فكبيرهم كأب وواسطهم أخ","ولنا الأصاغر كلهم ولدان",32,"ن",1,0],["فَكِبارها بَينَ المَلا وَصِغارَها","وَاللّهُ لَيسَ لَها سِواكَ مَرام",33,"م",1,0],["فكبار الدرّ من وابله","وصغار الدرّ من نقط الرشاش",34,"ش",1,0],["فكبت حَياءً وجهها فوق معصم","به اللازجلا عن أديم زمرّد",35,"د",1,0],["فَكَبَتْ عَلى مَيْدانِها غَضَباً وَرَبُّ","الجِدِّ يَأْنَفُ مِن صِفاتِ الَّلاعِبِ",36,"ب",1,0],["فكبَّر مَولاهُ وهلَّل إذْ رأَى","هَزِيعَ الدُّجى الزِّنْجِيِّ أدْبر راحِلاَ",37,"ل",2,0],["فكبه لوجهه معفرا","حيال نعش الميت في وجه الثرى",38,"ر",2,0],["فكبيرهم متعطشٌ لدمائنا","وبدربنا غرسَ الردى أشواكَ",39,"ك",1,0],["فكبرت ملة التوحيد","مفقودها إذ حكى المنقودا",40,"د",2,0],["فكبَّر ساجداً يهوي بطودٍ","من الأحقادِ أوَّلُه شَقِيف",41,"ف",1,0],["فكبرت من ولهي هائما",". به وبه السكر لا يخرج",42,"ج",1,0],["فكبار النفوس ما احتملت ه","ذا وثارت للثأر بعد احتمال",43,"ل",1,0],["فَكَبَتْ مِرْءَاْتُهُ مِنْ كِذْبِهِ وَالشَّمْسُ غَاْبَتْ","فِيْ نَوَاْحِيْهِ مُدَىْ شَوْكٍ يَذُرُّ الْحُزْنَ ثَاْرَاْ",44,"ر",2,0],["فكبت جيادي فوق أرض خريطة","أرض العروبة بينها أسوار",45,"ر",1,0],["فكبر النفس لا يجدي إذا ما","وقفت مطأطئا عند اللقاء",46,"ا",2,0],["فَكَبِّرْ رُباعَ عَلَى ثَوْرَةٍ","قَضَتْ نَحبَهَا فَلَا لَم تَعِشْ",47,"ش",1,0],["فكباؤهم يوم القدوم سلامهم","وسلامهم يوم الرحيل بكاء",48,"ا",2,0],["فكبا اللسان ملعثما في لومها","واخْرسّ من هول الجوى لا يفصح",49,"ح",1,0],["فكبار الأحلام تغرق فيه","وصغار الخلام فيه تعوم",50,"م",1,0],["فكِبْري على كل حاملِ كِبْرٍ","وليس على مَن يكون نزيها",51,"ي",3,0],["فَكَبِّر عَلَى شِعرِ الفُروسَةِ بَعدَهُ","أَما يَفتَدِيهِ كُلُّ بَيتٍ مِنَ الفَودِ",52,"د",1,0]]}