{"poems":[[77,"فعل الخاطر المصدق فعلا","https://www.aldiwan.net/poem36091.html","الخفيف"],[93,"إن بكى الشرق فالمصاب أليم","https://www.aldiwan.net/poem11409.html","الخفيف"],[26,"أمن المنون وريبها تتوجع","https://www.aldiwan.net/poem24106.html","الكامل"],[91,"ما للهموم الطارقات ومالي","https://www.aldiwan.net/poem62625.html","عموديه"],[85,"كنيسة صارت إلى مسجد","https://www.aldiwan.net/poem63722.html","السريع"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[62,"موازين الطبائع في يدينا","https://www.aldiwan.net/poem52159.html","الوافر"],[44,"أما أبو بشر فقد أضحى الورى","https://www.aldiwan.net/poem30382.html","الكامل"],[75,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[48,"غزال العمر في خلل الديار","https://www.aldiwan.net/poem66576.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67307","الطويل"],[91,"بالاسكندرية","https://www.poetsgate.com/ViewPoem.aspx?id=53217",""],[94,"اطلّ من حرم الرؤيا فعزاني","https://www.poetsgate.com/ViewPoem.aspx?id=15609",""],[151,"تأدب إذا ذكر المصطفى","https://www.aldiwan.net/poem68451.html","المتقارب"],[279,"هنئت في اليوم المطير","https://www.aldiwan.net/poem2482.html","مجزوء الكامل"],[299,"لله وللمثل الأعلى","https://www.aldiwan.net/poem36299.html","عموديه"],[378,"أدركت شأوك فاتق الأسواء","https://www.aldiwan.net/poem66973.html","الكامل"],[539,"ما لمراكش تفيض سرورا","https://www.aldiwan.net/poem48173.html","عموديه"]],"verses":[["فَكَبَا لِلْيَرَاعِ طِرْفٌ عَتِيقٌ","قد أَجَدْتُ اخْتِيَارَهُ وَاعْتِيَامَهْ",0,"م",2,0],["فَكِبَارُ الأَحْلامِ تَغْرَقُ فِيهِ","وَصِغَارُ الأَحْلامِ فِيهِ تَعُومُ",1,"م",1,0],["فَكَبا كَما يَكبو فِنيقٌ تارِزٌ","بِالخُبتِ إِلّا أَنَّهُ هُوَ أَبرَعُ",2,"ع",1,0],["فَكَبا كَما يَكبو الجَوادُ عَلى الثَرى","شُدَّت عَلَيهِ فَوادِحُ الأَثقالِ",3,"ل",1,0],["فَكَبَّروا فيها وَصَلّى العِدا","وَاِختَلَطَ المَشهَدُ بِالمَشهَدِ",4,"د",1,0],["فَكَبيرٌ أَلّا يُصانَ كَبيرٌ","وَعَظيمٌ أَن يُنبَذَ العُظَماءُ",5,"ا",2,0],["فكبريت وزرنيخ وملح","وفرّار يفيد ويستفيدُ",6,"د",1,0],["فَكَبا كَما يَكبو الكَمِيُّ تَصَرَّفَت","أَيّامُهُ وَاِنبَتَّ مِن أَبطالِهِ",7,"ل",2,0],["فكبّرَتِ الفُرْسانُ للّهِ إذ بَدا","وظَلّ السّلاحُ المنتضى يتقعقع",8,"ع",1,0],["فكبّرَ ثم قدّسَ ثم صلّى","مقادسةُ الأساقفةِ الكِبار",9,"ر",1,0],["فَكَبَّرَ مِمَّا رَآهُ الأَمِي","رُ وَهَلَّلَ أَشْهَادُ ذَاكَ النَّدِي",10,"د",2,0],["فكُبَّ أَبو جَهْلٍ صَريعاً لِوَجْهِهِ","وعتبةُ قَدْ غادَرْنَهُ وَهْوَ عَائرُ",11,"ر",1,0],["فكبا كما يكبوا الجواد على الثّرى","شدّت عليه فوادح الأثقال",12,"ل",1,0],["فكبّر الرّكب مرتاحا إلى أمل","عذب المجاجة حالي الوشي ريّان",13,"ن",1,0],["فكبِّر على عقله أربعاً","وقل فوق طورك هذا الخبر",14,"ر",1,0],["فكبيرُ عفوِ الرَّبّ مَوْ","قُوفٌ على الذَّنْب الكبيرِ",15,"ر",1,0],["فكبى لهما (قاسيون) وَلِمْ","لا يندبُ تاجاً وَسريرا",16,"ر",2,0],["فكَبَت بهم خيلُ الحياةِ بشَوطها","وَجَرَت بِهم نُجُبُ المماتِ سَواءَ",17,"ا",2,0],["فَكبيرٌ يُحَدثنَ صَغيراً","وصغيرٌ يُحَِدثنكبيرا",18,"ر",2,0]]}