3.html","الخفيف"],[438,"ها قد بلغت الذي قد كان ينتظر","https://www.aldiwan.net/poem2614.html","البسيط"],[440,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[442,"يا من تفرد بالإجلال والكرم","https://www.aldiwan.net/poem14292.html","البسيط"],[459,"للنقص من أعمارنا ما يكمل","https://www.aldiwan.net/poem56077.html","الكامل"],[459,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[462,"هو في ناديه طود راسخ","https://www.aldiwan.net/poem15398.html","الرمل"],[469,"يا معاذي حقا ويا أستاذي","https://www.aldiwan.net/poem60142.html","الخفيف"],[471,"يا معمر يا ابن زيد حين تنكحها","https://www.aldiwan.net/poem4671.html","البسيط"],[478,"لما استحث حداة الجيرة الابلا","https://www.aldiwan.net/poem15257.html","البسيط"],[496,"يا معجبا مرح العنا","https://www.aldiwan.net/poem10269.html","مجزوء الكامل"],[530,"يا معربا في قوله لاحنا","https://www.aldiwan.net/poem37471.html","السريع"],[530,"لله درك يا بن إسماعيل بل","https://www.aldiwan.net/poem37543.html","الكامل"],[554,"يا معن إنك لم تزل في خزية","https://www.aldiwan.net/poem68247.html","الكامل"],[563,"أعلمت ما بالقلب من نار الجوى","https://www.aldiwan.net/poem52852.html","الكامل"],[563,"ألحمد لله الذي خلق الورى","https://www.aldiwan.net/poem52937.html","الكامل"],[568,"يا معرضا عني بوجه مدبر","https://www.aldiwan.net/poem69540.html","الكامل"],[568,"يا معرضا لا يلتفت","https://www.aldiwan.net/poem69781.html","مجزوء الرجز"],[576,"يا معرضاً قد آن أن تقبلا","https://www.aldiwan.net/poem2887.html","السريع"],[576,"يا ليلة مرت لنا حلوه","https://www.aldiwan.net/poem2949.html","السريع"],[576,"أمورد يا ناظري أم وريد","https://www.aldiwan.net/poem3088.html","الرجز"],[587,"أرح يمينك مما أنت معتقل","https://www.aldiwan.net/poem17644.html","البسيط"],[587,"ته كيف شئت فللحبيب تدلل","https://www.aldiwan.net/poem17646.html","الكامل"]],"verses":[["يا مُعيدَ الماءِ في عودي وَيا","مُثبِتي بَعدَ اِضطِرابٍ وَأَوَد",0,"د",1,0],["يا مُعرِضاً ما وُدُّهُ وَصَفاؤُهُ","لِوَلِيِّهِ مِمّا يُباعُ وَيُشتَرى",1,"ر",2,0],["يا مَعشَرَ الناسِ حالي بَينَكُم عَجَبٌ","وَلَيسَ لي بَينَكُم يا قَومُ أَنصارُ",2,"ر",1,1],["يا مُعرِضاً عَنّي بِغَيرِ جِنايَةٍ","إِلّا لِما رَقشَ الحَسودُ وَزوَّرا",3,"ر",2,0],["يا مُعطِشي مِن وِصالٍ كُنتُ وارِدَهُ","هَل مِنكَ لي غُلَّةٌ إِن صِحتُ واعَطَشي",4,"ش",2,1],["يا مُعِزُّ الهُدى الَّذي ما لِمَسعا","هُ إِلى غَيرِ سَمتِهِ تَغريضُ",5,"ض",1,0],["يَا مُعَزِّينَ فِي سُلَيْمَانَ صَبْراً","وَلَنَا فِيكُمُ عَزَاءٌ كَرِيمُ",6,"م",1,0],["يا مَعشَرَ الأَجنادِ لا تَقنَطوا","خُذوا عَطاياكُم وَلا تَسخَطوا",7,"ط",3,1],["يامَعشَرَ الناسِ هَل لي","مِمّا لَقيتُ مُجيرُ",8,"ر",1,1],["يامُعجَباً بِنُجومِهِ","لا النَحسُ مِنكَ وَلا السَعادَه",9,"د",2,1],["يا معرضاً يهوى فنا روحي ولي","روح تمنى أن يطولَ بقاؤه",10,"ا",3,0],["يا معتقاً رقِّي وباعثَ كتبه","للهِ درُّكَ معتقاً ومكاتِبا",11,"ب",2,0],["يا معرضاً قلبي عليه ومدمعي","هذا مقيم هوًى وهذا نازح",12,"ح",1,0],["يا معرضاً عن لقاءِ الصحب منقطعاً","وكان أكرم مصحوبٍ ومودود",13,"د",1,0],["يا معمل الرأي مخدوماً بأربعة","يُمن ونصرٍ وإقبال ومختار",14,"ر",1,0],["يا معتق المذنبين ممّا","خافوا من النار والمهالك",15,"ك",1,1],["يا معطف الشاهد سبحان من","سوَّاك في الحسنِ ومن عدَّلك",16,"ك",1,0],["يا مُعينَ الضَنى عَلَي","يَ أَعِنّي عَلى الضَنى",17,"ن",2,0],["يا معشَرَ الإِخْوَانِ طال عقوقُكُمْ","بِأَخٍ لكم غُبِقَ الجفاءَ كما صُبِحْ",18,"ح",1,0],["يا مُعيري ثَوْبَ الحياة بَل الكَا","سِيَّ بالطَّوْل حُلَّة المحْسُودِ",19,"د",1,0],["يا معقل الجاني على نفسه","إذا جنى ما فيه إيباقه",20,"ق",2,0],["يا مَعْقِلاً غيرَ مخشيٍّ غوائلُهُ","لمنْ أتته الدواهي من معاقلِهِ",21,"ل",2,0],["يا معشرَ السفهاءِ وال","متمردين ذَوي المجاهلْ",22,"ل",1,0],["يا مُعمِلَ الجود قد أنضيت مركبه","نضاً فأعقبه منه يومَ أجمامِ",23,"م",1,0],["يا مُعرِضاً مُتَجَنِّباً","حاشاكَ مِن نَقضِ الذِمامِ",24,"م",1,1],["يامُعرِضَن مُتَغَضِّباً","حاشاكَ يا عَيني وَروحي",25,"ح",2,1],["يا مُعجِزَ الأَيّامَ قَرعُ صِفاتِهِ","وَمُجَمِّلُ الدُنيا بِحُسنِ صِفاتِهِ",26,"ت",2,0],["يا مُعرِضاً عَنّي وَلَم أَجِن ما","يوجِبُ إِعراضاً وَلا هَجرا",27,"ر",2,1],["يا مَعشَرَ الإِسلامِ في أُسطولِكُم","عِزٌّ لَكُم وَوِقايَةٌ وَسَلامُ",28,"م",1,0],["يا مَعهَداً أَفنى القُرونَ جِدارُهُ","وَطَوى اللَيالِيَ رَكنُهُ وَالأَعصُرا",29,"ر",2,0],["يا مَعشَرَ الكُتّابِ أَينَ بَلاؤُكُم","أَينَ البَيانُ وَصائِبُ الأَفكارِ",30,"ر",1,0],["يامُعرِضاً يُدعى فَلا يَسمَعُ","يَضحَكُ مِمّا بي وَأَستَرجِعُ",31,"ع",1,1],["يا مَعهَداً لِلِّوى أَبقى بِمُهجَتِهِ","مَعاهِداً لِلبِلى وَالأَدمُعِ السُجُمِ",32,"م",1,0],["يا مَعشَرَ الأَزدِ أَنتُم مَعشَرٌ أُنُفٌ","لا يَضعُفونَ إِذا ما اِشتَدَّتِ الحُقُبُ",33,"ب",1,0],["يا مَعشَرَ الأَزذِ إِنّي مِن جَميعِكُمُ","راضٍ وَأَنتُم رُؤوسُ الأَمرَ لا الذَنَبُ",33,"ب",1,0],["يا مَعشَرَ الأَمواتِ يا ضيفانَ تُر","بِ الأَرضِ كَيفَ وَجَدتُمُ طَعمَ الثَرى",34,"ا",1,0],["يا مُعَيرَ الغَزالِ جيداً وَطَرفاً","وَمُغيرَ القَضيبِ لَمّا تَثَنّى",35,"ن",2,0],["يا معجباً تاه على صحبه","برأسه بوركَ من رأسِ",36,"س",1,1],["يا معلياً بعلاهُ كلّ مُنْخَفِضٍ","ومُغنِياً بِنَداهُ كُلَّ مُفتَقِرِ",37,"ر",1,0],["يا معطياً كلما أعطى يزيدُ غنى","والغمْرُ يُغنيهِ طولُ الغرفِ بالغُمَرِ",38,"ر",1,0],["يا معشرَ الأحرارِ صَبراً إنّه","قَدَرٌ جَرَى ومُصابُ شَعْبٍ حَانا",39,"ن",2,0],["يا معشرَ النُّوابِ بُورك سَعْيُكم","من رائحٍ يقضي الذِّمامَ وغادِ",40,"د",1,0],["يا معشرَ الشُّعراءِ لَسْ","تُم بالثِّقاتِ ولا العُدولْ",41,"ل",1,0],["يا مَعشَرَ الإِنسِ جِئتُم كُلَّ رائِعَةٍ","بِمَعشَرِ الجِنِّ مِن أَهوالِها عَجَبُ",42,"ب",1,1],["يا معشرَ الأنصارِ ما مِن صالحٍ","إلا لكم فيهِ يَدٌ أو مَوقِفُ",43,"ف",1,0],["يا معشر الأنصارِ هل لي عندكم","نادٍ يَضُمُّ النابغين ومحفلُ",44,"ل",1,0],["يا مَعشَرَ العُربِ الَّذينَ تَوارَثوا","شِيَمَ الحِمِيَّةِ أَكبَراً عَن أَكبَرِ",45,"ر",1,0],["يا مَعدَن الحُسن أَنت مَعدنها","يا جَوهَر الحُبّ أَنتَ جَوهَرَها",46,"ر",3,0],["يا مَعينَ الجمال أذبلتِ قلبي","أنعشيني بنهلةٍ أنعشيني",47,"ن",2,0],["يا مَعينَ الجمال قطرةَ ماءِ","أو أفيضي ابتسامةً تُحييني",47,"ن",2,0],["يا مُعيداً لِلمُلكِ يا مَلجَأً لِل","أُسدِ حَتّى بَصبَصنَ بِالأَذنابِ",48,"ب",1,0],["يا مُعِزَّ الهُدى كفانَي أنّي","لكَ طَودٌ على أعاديكَ مُوف",49,"ف",1,0],["يا مَعشَرَ العُشّاقِ ما البُشرى","قَد ظَفِرَت كَفّي بِمَن أَهوى",50,"ا",1,1],["يا مُعرِضاً نَفسي الفِدا","ءُ وَقَلَّ ذَلِكَ مُعرِضا",51,"ض",2,1],["يا مَعشَرَ الناسِ مَن رَأى أَحَداً","قَد مَسَّهُ الشَوقُ وَالهَوى سَلِما",52,"م",2,0],["يا مَعشَرَ الناسِ فَاِسمَعوهُ وَعوا","إِنَّ جِناناً صَديقَةُ الحَسَنِ",53,"ن",1,0],["يا معشرَ اللوامِ","عذّبتموني ملاما",54,"م",2,1],["يا مَعدِنَ العَسجَدِ أَصبَحتَ ما","تُخرِجُ إِلّا التُربَ وَالجَندَلا",55,"ل",2,0],["يا معشرَ الأصحابِ إني امرؤٌ","تسرُّني رفعةُ أصحابي",56,"ي",1,1],["يَا مَعْشَرَ الْعُرْبِ الْكِرَامِ الأُولى","بِهِمْ أُباهِي كُلَّ ذِي معْشَرِ",57,"ر",1,0],["يَا مُعِيدِي مُوسى إِذَا مَا جَلَوْتُمْ","وَجْهَ مَاضْ لَمْ يَخْفَ وَجْهُ الآتِي",58,"ت",2,0],["يَا مُعِزَّ الحِمَى وَمُعْتِقَهُ بِالْ","خِطَّةِ القَصْدِ مِنْ هَوَانٍ وَرِقِّ",59,"ق",1,1],["يَا مَعْدِنَ الذَّهَبِ الَّذِي فِي لَوْنِهِ","لِلشَّمْسِ مَسْحَةُ بَهْجَةٍ وَرُوَاءِ",60,"ا",2,0],["يَا مُعِيدَ القَرِيضِ سِيرَتَهُ الأُولَى","وَلَكِنْ مُحْسِنَ التَّنْسِيقِ",61,"ق",1,0],["يا معهدًا للضاد ألقى بذرَهُ","في تُرْبَةِ الوادي الخصيب فأثمرا",62,"ر",2,0],["يا مَعَشر الفتح المبين وجندَهُ","حُيِّيتُمُو جندًا وطِبْتُمْ معشرا",63,"ر",2,0],["يا معدِنَ النَفَرِ الذينَ تقسَّموا","لسماحةٍ ورَجاحةٍ ونِزال",64,"ل",1,0],["يامعضله تمشي على رجلين . يالعشر الحواس","ياشاطبن من ذاكرة تاريخي .. الوجه الودر",65,"ر",1,0],["يا مُعير البَدر حُسناً","في دُجى اللَيل البَهيم",66,"م",1,1],["يا معرضا عني بلا ذنب اما","لفتتك نحوي جذوة الاحراق",67,"ق",1,0],["يا معرضا لفت الجمال عنانه","اظننت ان الحسن لن يتغيرا",68,"ر",2,0],["يا مَعْشَرَ الزُّعَماءِ إنّي شاعِرٌ","والشِّعْرُ حُرٌّ ما عَلَيهِ عِتابُ",69,"ب",1,1],["يا مَعْشَرَ الزُّعَماءِ كلُّ حَديثِكُمُ","والمُنْجَزاتُ تآمُرٌ وخطابُ",69,"ب",1,0],["يا معرضاً أنت نجمي غبت عن نظري","وما ضللت ولكن شيمة الملل",70,"ل",1,0],["يا معشر الصحب بي وجد أكاد جوى","أذوب ما أضرمته الأعين السود",71,"د",1,0],["يا معدنَ الإفسادِ بل يا موردَ ال","أوغادِ بل يا تَوْلَبَ البيداءِ",72,"ا",2,0],["يا مُعجِزَ الأَملاكِ فيمَ يَبتَني","وَمُعَجِّبَ الأَفلاكِ مِمّا يَصنَعُ",73,"ع",1,0],["يا معرضين وقد عرضت مشيّعاً","رد