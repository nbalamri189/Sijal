{"poems":[[107,"صاحب السيفين ماذا صنعا","https://www.aldiwan.net/poem44212.html","الرمل"],[20,"يا لرهطي أو قدوا نارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69773&r=&rc=14",""],[333,"لا أنا خالد ولا أمنياتي","https://www.aldiwan.net/poem54952.html","الخفيف"],[505,"أزعج الليل الندامى","https://www.aldiwan.net/poem37800.html","مجزوء الرمل"],[505,"بدر حسن راق العيون شهوده","https://www.aldiwan.net/poem38027.html","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68071","الرمل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126966","الرمل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138563",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110050","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83664","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139707",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139547",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139741",""],[4702,"حب الزبيب","https://www.poetsgate.com/ViewPoem.aspx?id=155198",""],[4702,"نار الغبن","https://www.poetsgate.com/ViewPoem.aspx?id=155214",""],[4978,"تحية لأستاذتي عبير التميمي","https://www.poetsgate.com/ViewPoem.aspx?id=189769",""],[5061,"قصيدة المواد","https://www.poetsgate.com/ViewPoem.aspx?id=147164",""],[5183,"رزء العلم","https://www.poetsgate.com/ViewPoem.aspx?id=180254",""],[5186,"طاب يا نشء في نهاك الثناء","https://www.poetsgate.com/ViewPoem.aspx?id=156455",""],[5431,"دثرتني بنورها صنعاءُ...","https://www.poetsgate.com/ViewPoem.aspx?id=200425",""],[5431,"ماكيافيلي والحصاد...","https://www.poetsgate.com/ViewPoem.aspx?id=205414",""],[5952,"ما ودَّعَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=203725",""]],"verses":[["يا لِرَيْبِ الدّهرِ ما أفدَحَهُ","حادثاً نُكراً ورُزءاً مُفجِعا",0,"ع",2,0],["يا لِرَهطي أَو قِدوا نارا","إِنَّ الَّذي تَهوَونَ قَد حارا",1,"ر",2,1],["يا لروحٍ مقدّس كان لا يؤ","من إلا بالنور والنيّرات",2,"ت",1,0],["يا لرَمْشٍ منهُ فينا","مُصْلِتٍ جَهْراً حُسَامَا",3,"م",2,0],["يا لرُحْبٍ نورُ العُيونِ ثَراهُ","وبروحي تاجُ الرُّؤوسِ صَعِيدُهْ",4,"د",2,0],["يَا لَرَكْب قَدْ سَرَوْا","وفؤادي قَدْ شَرَوا",5,"ا",1,1],["يالرزء جل في يوم الطفوف","قد كسا الشمس برودا من كسوف",6,"ف",1,0],["يا لرزؤ جل حتى لم تجد","حادثاً إلا له ناح ولاعا",7,"ع",2,0],["يا لِراضٍ بفعلهِ غيرِ راضٍ","عنهُ مولىً تُزَانُ منهُ الفِعالُ",8,"ل",1,0],["يا لرُؤيا رَأَيتُها وَهيَ حَقٌّ","لَيسَ فيها وَاللَه كِذبٌ وَزورُ",9,"ر",1,0],["يا لرؤيا رَأَيتُها ذات شَأنٍ","ضاقَ عن شَرحِها النَظيم النَثيرُ",9,"ر",1,0],["يا لرزءٍ عمَّ الأقاليم شجواً","ورمى الفرسَ كلها بانفجاع",10,"ع",1,0],["يا لركبٍ ساروا بروح المزايا","هل على حيِّها تعوج الركاب",11,"ب",1,0],["يا لروضٍ من الجنان أريضٍ","فيه قد أنبت الرضا أغصانا",12,"ن",2,0],["يالريم في وصفك لو اقول واعيد","تضعف حروف الشعر عند الجميله",13,"ل",2,0],["يالريم جوّك يبى يسقيك مشروبه","صافي .. وانا ابْقى سببكم ما صفا جوّي",14,"و",2,0],["يا لروض المنتدى هذا النضيرْ","فاح عطرا عبر موجات الأثير",15,"ر",1,1],["يالرياضيات موتي وارحمينا","ذنبك أعظم من ذنوب الظالمينا",16,"ن",2,1],["يا لرزء شدخ العلم على","هامه وانباع في الحلق شجى",17,"ج",2,0],["يا لروح وثابة علمتنا","كيف تمشي وتنطق الأشلاء",18,"ا",2,0],["يالروضٍ بنوره انثال قلبي","يالحسنٍ يُميته الغرباءُ!!",19,"ا",2,0],["يالربٍّ يُخصي مُريديه هوْناً","لعقوا التيه للقداسة ركنا!!",20,"ن",2,0],["يالروح الصبِّ حتماً ما دَرَتْ","أنَّ ما أفزعنيْ لن يُفزِعكْ !",21,"ك",1,0]]}