{"poems":[[87,"أيها الكاتب المصور صور","https://www.aldiwan.net/poem63704.html","الخفيف"],[76,"ألا عرس الإخوان في ساحة البلى","https://www.aldiwan.net/poem12868.html","الطويل"],[132,"دمعي جرى يوم بان الحي من إضم","https://www.aldiwan.net/poem50496.html","البسيط"],[132,"لا تلومني فمثلى لا يلام","https://www.aldiwan.net/poem50529.html","الرمل"],[147,"إني وإن كنت في الأقوال محتكما","https://www.aldiwan.net/poem11816.html","البسيط"],[164,"لا تأخذنك وحشة مما جرى","https://www.aldiwan.net/poem58918.html","الكامل"],[199,"بانت سعاد وليس الود ينصرم","https://www.aldiwan.net/poem54418.html","البسيط"],[259,"اُعف عني","https://www.aldiwan.net/poem24945.html","مجزوء الرمل"],[259,"حيرة","https://www.aldiwan.net/poem25020.html","مجزوء الرمل"],[266,"طرف بكى وفؤاد أن من وصب","https://www.aldiwan.net/poem38369.html","البسيط"],[333,"تعاليت لا مولى سواك خلقتني","https://www.aldiwan.net/poem54954.html","الطويل"],[364,"أتى من أريج النصر ما يشرح الصدرا","https://www.aldiwan.net/poem810.html",""],[409,"عسى توبة تمحى بها كل زلة","https://www.aldiwan.net/poem34112.html","الطويل"],[505,"كتب الظلام على الوجود سطورا","https://www.aldiwan.net/poem38003.html","مجزوء الكامل"],[543,"بعودتك الحمراء تم لها القصد","https://www.aldiwan.net/poem48240.html","عموديه"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38180","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38974","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59439","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96452","الطويل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133810","السريع"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109163","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108702","الخفيف"],[1859,"","https://poetry.dctabudhabi.ae/diwan/poem/142266","الطويل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42486","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109433","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94289","الخفيف"],[402,"","https://poetry.dctabudhabi.ae/diwan/poem/82780","الرمل"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46873","المتقارب"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103821","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110079","الطويل"],[3656,"","https://poetry.dctabudhabi.ae/diwan/poem/133925","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135733","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77115","الرجز"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136810",""],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45918","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4782,"رِحَال الليل","https://www.poetsgate.com/ViewPoem.aspx?id=202629",""],[4935,"إن باري الخلق غافر","https://www.poetsgate.com/ViewPoem.aspx?id=129274",""],[5183,"جلاء الجيش الإنجليزى عن مصر","https://www.poetsgate.com/ViewPoem.aspx?id=185638",""],[5324,"لعن الله جميع الزعماء .","https://www.poetsgate.com/ViewPoem.aspx?id=207664",""],[5842,"رسالة .. إلى الجيش العربي السوري","https://www.poetsgate.com/ViewPoem.aspx?id=67970",""],[5991,"ته على المستهام فيك جمالاً","https://www.poetsgate.com/ViewPoem.aspx?id=116381",""],[6125,"للهُ أكبرُ منْ جُرْمي وزلَّاتي","https://www.poetsgate.com/ViewPoem.aspx?id=210904",""]],"verses":[["وَاِمِّحاءَ الكَليمِ آنَسَ ناراً","وَاِلتِجاءَ البَتولِ في وَقتِ ضيقِ",0,"ق",1,0],["وَأَمحو جَميلَ الصَبرِ طَوراً بِعَبرَةٍ","أَخُطُّ بِها في صَفحَتَيَّ كِتابا",1,"ب",2,0],["وامحنتى إذْ رنت ليلى بنظرتها","قلبي عَدا لم أزل يا صاح في مِحَنِ",2,"ن",1,0],["وامحُ عني الذنب وارحم زَلَّتِي","عفوك الله يا رب الأنام",3,"م",1,0],["وَأَمحَلوا فَأَماتَ المَحلَ صَوبُ يَدٍ","أَنشَأتَ في الأَرضِ مِن آلائِها دِيَما",4,"م",2,0],["وامحُ اسم كسرى الأَعجميّ فإِنه","في عدله الأَمثال تضربُ في الورى",5,"ر",2,0],["وَأَمحَلَت بعدَ إِخصابٍ يَدُرُّ بِها","مُنَوِّرٌ رَشَحَت أَطفالَهُ الدِيَمُ",6,"م",1,0],["وامْحُ عني ذُلَّ ضَيْمٍ","من سخيفٍ لم يدعني",7,"ن",2,0],["وامْحُ عني ذُلَّ ضيْمٍ","إنَّ حبي صار كربا",8,"ب",2,0],["وامح الذي كتبوا عني بما كذبوا","فالسيف أصدق أنباء من الكتب",9,"ب",1,0],["وامحق اليأس بالرجاء وسلّم","وكل الأمر للعليم الخبير",10,"ر",1,0],["وأمحَلَت الأرجاء من بعد خصبها","وقد أضجرتهم قاعة المَهمَه القَفرا",11,"ر",2,0],["وامح نقوش الجاه عن لوح خاطر","يرى الجاه عند الناس خير مزية",12,"ه",1,0],["وامْحَقْ صُنوفَ الحادِثاتِ لأجلِهِ","لتقومَ عنه بسِرِّهِ مَنْصُورَا",13,"ر",2,0],["وأمَّ حمَاك الشعبُ يَطفَحُ قلبُه","سرورا وملءُ القلب حبُّك والودُّ",14,"د",1,0],["وَأُمّ حَرامٍ عَمّةٌ لِاِبن مالكٍ","خَديمِ رَسولِ اللَّه وَهوَ المُحبَّبَ",15,"ب",1,0],["وَاِمحُ بِنا آثارَهُم","دَمِّرْ عَلَيهِم أَجمَعين",16,"ن",1,0],["وامح ذنبي واختم بخير وكن لي","في حياتي وموتتي ونشوري",17,"ر",2,0],["وامحق بأسيافه أعناق حسده","وانصره نصرا به للفتح تكميل",18,"ل",1,0],["وأمحَلَ وَادِينَا وَأَوحَشَ أَهلُهُ","وَبُدّلَ مِن فُرسَانِهِ بِالنَّوَاعِقِ",19,"ق",1,0],["وامحتِ الأظلالُ من ساحة الدنيا","وغارت في سيول البهاء",20,"ا",2,0],["وامَّحت آثارهم أو أوشكت","تمَّحى لولا أريجٌ عبقا",21,"ق",2,0],["وامح سخط الإله يا صاح بالتو","بة ينقذك من عذاب السعير",22,"ر",1,0],["وأُمحضْتَ أسلوبَ المعاني فصاحةً","وأبدعتَ نظمًا باهرًا راح يُصقل",23,"ل",1,0],["وامحقْ من الجسمِ ما أبقاهُ لي رمقاً","يا باسمَ القدِّ من أعطافِك الميلُ",24,"ل",1,0],["وامحق بعزمك ما تلقاه من كدرِ","حتى تفوز بصفو العيش والأرب",25,"ب",1,0],["وامح ذنبي واثبت العفو عني","فذنوبي زادت على الصك صكا",26,"ك",2,0],["وَامّحى الماضي كَسَطرٍ مِن كِتاب","خَطَّهُ الوَهمُ عَلى الطّرس البَليل",27,"ل",1,0],["وإِمْحَاض حُبّ أُلاقِي الإِلَهَ","وَقَلْبِيَ مِن بَرْحِه غيرُ سالِ",28,"ل",1,0],["وأمحضنك النصح الصريح وفي الحشا","لودك نقش ظاهر وكتابُ",29,"ب",1,0],["وأَمحلَ زرعَ الجُودِ من بعد خِصبِهِ","وقد عَقِمَت من ذا الزَمانِ نواجمُهُ",30,"م",2,0],["وامحُ السوى من قلبه حتى يرى","عبداً تخلص واستحال حكيما",31,"م",2,0],["وامحُ الشدائد بغيثٍ ماحِ","بالقادر العليم والفتّاحِ",32,"ح",1,0],["وامحنتي بالليل والنهار","ضاع اصطبارى وعدمت رشدي",33,"ي",1,0],["وَاِمحِ إِلهي صُحُفَ الخَطايا","فَضلاً فَأَنتَ مَوجِدُ العَطايا",34,"ي",2,0],["وامح وصفي بوصفك واعطنا ما تمنيت","سمنا مثل حباك الذي ثم سميت",35,"ت",1,0],["وَأُمَّ حِمى خَيرِ النَبِيّينَ زائِراً","مُحِثّاً نِياقَ الشَوقِ يَسعى لِأَحمَدِ",36,"د",1,0],["وَأَمحو لِما قَد كانَ في اللَوحِ مُثبَتاً","وَتَثبُت إِذا وَقَّعتُ ثَمَّ وَقائِعُ",37,"ع",1,0],["وامّحى من خاطري ألف طريقٍ","غير دربٍ أزهر النبض خلاله",38,"ل",2,0],["وامحق الأسواء عني","واكسني ثوب المفاخر",39,"ر",1,0],["وامح ما قد جره العهد الذي","باد من رجز وما قد جلبا",40,"ب",2,0],["وامحقوا بالصحوة الكبرى بلادا","قد بناها لليهود الزعماء",41,"ا",2,0],["وامحق فلولَهمُ بثأرِكَ للألى","بذلوا دماءَهمُ من الأبرارِ",42,"ر",1,0],["وامح رسمي وهيئتي ومثالي","لست تبغي من الجميع مثالا",43,"ل",2,0],["وامحُ الذُّنوبَ التي صَارتْ تُكَبِّلُني","أو جُدْ بلطفكَ وارفَعْ مِنْ جِنَاياتي",44,"ت",2,0]]}