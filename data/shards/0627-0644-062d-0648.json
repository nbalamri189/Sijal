{"poems":[[58,"ما أنت مني ولا ربعاك لي وطر","https://www.aldiwan.net/poem58594.html","البسيط"],[46,"قرى دارهم مني الدموع السوافك","https://www.aldiwan.net/poem30391.html","الطويل"],[33,"عوجي علي فسلمي جبر","https://www.aldiwan.net/poem42507.html","الكامل"],[107,"بني مصر لوذوا بالسكينة واصبروا","https://www.aldiwan.net/poem43128.html","الطويل"],[107,"تجيب بعثت الوفد أما سبيله","https://www.aldiwan.net/poem44001.html","الطويل"],[77,"أحين ولت أنجم الأفق","https://www.aldiwan.net/poem69057.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[111,"ألا هل لداعي الله في الأرض سامع","https://www.poetsgate.com/ViewPoem.aspx?id=103",""],[111,"ألا هل لداعي الله في الأرض سامع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545618",""],[228,"ويل الضعيف من القدير","https://www.aldiwan.net/poem41921.html","مجزوء الكامل"],[303,"حيتك باسمة ثغور الزنبق","https://www.aldiwan.net/poem36840.html","عموديه"],[351,"لو فات شيء يرى لفات ابو","https://www.aldiwan.net/poem24141.html","المنسرح"],[447,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[458,"شعراء مصر ولا أقول جميعكم","https://www.aldiwan.net/poem61607.html","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61095","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132269","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53137","الرجز"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97962","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216628",""],[396,"","https://poetry.dctabudhabi.ae/diwan/poem/133406",""],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81234","الخفيف"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103259","الكامل"],[1012,"أباة الضيم","https://www.poetsgate.com/ViewPoem.aspx?id=186325",""],[1012,"فتح بلدة نفعا","https://www.poetsgate.com/ViewPoem.aspx?id=124499",""],[5055,"وثقت سد","https://www.poetsgate.com/ViewPoem.aspx?id=101662",""],[5282,"ففروا الى الله","https://www.poetsgate.com/ViewPoem.aspx?id=215075",""],[5389,"رواية الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=213987",""],[5776,"نصف هدنة","https://www.poetsgate.com/ViewPoem.aspx?id=199743",""]],"verses":[["الحوضُ حَوْضُهُمُ والجَدُّ جَدُّهُمُ","وعندَ رَبِّهِمُ في خَلْقِهِ غِيَرُ",0,"ر",1,0],["أَلَحَّ وَماحَكتُم وَلِلقَدَرِ اِلتَقى","غَريمانِ في الهَيجا مُلِحٌّ وَماحِكُ",1,"ك",1,0],["الحَولَ ثُمَّ الشَهرَ يَتبَعُهُ","ما الدَهرُ إِلّا الحَولُ وَالشَهرُ",2,"ر",1,0],["أَلَحّوا عَلَيهِ بِالدَلاءِ تُجيلُها","يَدا كُلِّ مَوّارِ الرِشاءَينِ موغِلِ",3,"ل",1,0],["ألحُّوا على الأخلاقِ فانقضَّ رُكْنُها","وحاقتْ بأبناءِ البلادِ الجوائحُ",4,"ح",1,0],["الحوْضُ حوضُ اللّه في كفّهِ","يَطفَحُ من مَلءٍ ومن فَهْق",5,"ق",1,0],["الحَوْلُ بَعْدَ الْحَوْلِ مَرَّ وَلِلرَدَى","حَوْلَيْكَ تَرْدِيدِ الصَّدَى المُتَجَاوِبِ",6,"ب",1,0],["ألحوا على الاخلاص حتى تفجرت","على لسنهم بالحمتين ينابع",7,"ع",1,0],["ألحوا على الاخلاص حتى تفجرت","على لسنهم بالحكمتين ينابع",8,"ع",1,0],["الحَور يَرمي ظِلَّه","في القَفر وَالحَقل النَضير",9,"ر",1,0],["الحورُ في جنات عَدْنٍ تجتلى","والبيضُ تُجلى في خمائلِ (جِلّق)",10,"ق",1,0],["الحُوَّلُ القُلَّبُ الأَريبُ وَلَن","يَدفَعَ زَوءَ المَنِيَّةِ الحِيَلُ",11,"ل",1,0],["الحور مشرفةً على أبوابها","شوقاً لها بهر الجمال جمالها",12,"ل",3,0],["الحوت حينَ تسبحونَ لعرضِهِ","قلبَ السفينةَ عابثاً من حولكم",13,"م",1,0],["أَلح وَميضاً فَاِستَطرت تشوقا","وَأيقظ ما يَسري مِن البَرق ساهره",14,"ر",2,0],["ألح وشاتي ثم قالوا عصابة","دع الحث يا هذا وحالي له نطق",15,"ق",1,1],["الحُوَّليُّ القُلَّبِيُّ المرتجى","اللَّوذَعِيُّ الأَلْمَعِيُّ النُّدُسِ",16,"س",1,0],["الحور والولدان في","مشتاي أوفى المصيف",17,"ف",1,0],["الحور هنَّ خلقن لل","فردوس لا للزمهرير",18,"ر",1,0],["الحول وهي نصاب أو بلغ مايكال","من الثمر والحبوب خمسة أوسق فحال",19,"ل",1,0],["أَلحواء مَدخل في مَجاري","صُور القَهر أَو مَجالي السَماء",20,"ا",2,0],["الحول عن دفع المنية قاصر","والله يفعل ما يشا ويريدُ",21,"د",1,0],["الحوا في الدعا واستفتحوه","على أعدائه الفجر اللئام",22,"م",1,0],["ألحوا في الدعا وأستفتحوه","على أعداءه الفجر اللئام",23,"م",1,0],["الحول حال وزكّي التمر والتين","مادام يسقيها المطر فالتوالي",24,"ل",2,0],["الحَولُ مني يا مَولايَ مُنقَطِعُ","والحَولُ عندكَ يا الله مُتَّسِعُ",25,"ع",1,1],["الحگ وياك عاش وانت عشت اوياه","اوخصمك مع الباطل مندحر زاهق",26,"ق",1,0],["الحواراتُ وجهُ حربٍ جديدٍ","وحروبُ الحوارِ أصعب مهنهْ",27,"ن",2,0]]}