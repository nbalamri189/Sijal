{"poems":[[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53938","البسيط"],[793,"","https://poetry.dctabudhabi.ae/diwan/poem/203822","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64817","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64709","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216762","الكامل"],[5075,"رحماك يا وطني","https://www.poetsgate.com/ViewPoem.aspx?id=196953",""],[5219,"إلى أرض الفرات","https://www.poetsgate.com/ViewPoem.aspx?id=194989",""],[307,"ملكة الدار","https://www.poetsgate.com/ViewPoem.aspx?id=214581",""],[5431,"والحب لا يتقسمُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=198932",""],[5753,"خاتمة المنى","https://www.poetsgate.com/ViewPoem.aspx?id=207645",""],[5956,"صبرُ إيهاب دريع","https://www.poetsgate.com/ViewPoem.aspx?id=193102",""],[6336,"الدوحة الباكية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73554&r=&rc=15",""]],"verses":[["أنتَ الدنيا والدينُ لنا","وكريمُ العَصر وأَوحَدُهُ",0,"د",2,0],["أنتَ الدّواءُ إذا ما أعْضلَ الداءُ","ورامَ هَضْمِيَ حُسّادٌ وأعداءُ",1,"د",3,1],["أنت الدعامة يا موسى إذا احتدمت","نيرانها وحماة الحرب تجتزر",2,"ر",1,0],["أَنتَ الدواءُ لكلِّ داءٍ مُعْضِلٍ","أَعيا بهِ الرَّاقي وعزَّ الآسي",3,"س",2,0],["أَنْتَ الدَّواءُ لَهُ وَإِنْ أَلْبَسْتَهُ","داءً يَشُقُّ عَلى الطَّبيبِ عِلاجُهُ",4,"ج",2,0],["أنت الدليل على أناس أنكروا","حشر الجسوم وآثروا الإشراكا",5,"ك",2,0],["أَنْتَ الدَّوَاءُ لِكُلِّ جُرْحٍ مَرَّ بِي","وَبِغَيْرِ حُبِّكَ لَا يَبُوحُ لِسَانِي",6,"ن",2,0],["أنت الدواء لعلتي عجزت بها","كل الأساة بطبها تبريه",7,"ي",2,0],["أنت الدواءُ إذا تمكّنَ مُسقمٌ","في الروحِ يبضعُ جاثماً وعنيدا",8,"د",2,0],["أنت الدموع تبسما","أنت الضنى والبلسمُ",9,"م",1,0],["أنتَ الدليلُ وأنتَ خاتمةُ المُنى","والرُّوحُ ما ضَلتْ إليكَ طريقَها",10,"ق",3,0],["أنت الدواء لنا جميعاً إنما","أصبحت محتاجاً لنا كالأدويةْ",11,"ي",2,0],["أنَّتِ الدوحةُ في أعقابها","فبكى النجمُ عليها والنهر",12,"ر",1,0]]}