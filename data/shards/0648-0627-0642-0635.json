"","https://poetry.dctabudhabi.ae/diwan/poem/133090","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33582","المتقارب"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33178","الوافر"],[4591,"","https://poetry.dctabudhabi.ae/diwan/poem/144245","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139707",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139477",""],[4744,"هذا العقيق وذي ربا أزهاره","https://www.poetsgate.com/ViewPoem.aspx?id=131549",""],[4755,"صَيرُورَة","https://www.poetsgate.com/ViewPoem.aspx?id=184574",""],[4767,"أنجم العلم","https://www.poetsgate.com/ViewPoem.aspx?id=92817",""],[4767,"مشاهد الخير","https://www.poetsgate.com/ViewPoem.aspx?id=180319",""],[4926,"وحَّد إلهك لا تشرك به أحداً","https://www.poetsgate.com/ViewPoem.aspx?id=171101",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[3591,"أحبُّ دياراً لا أزور لها مغنى","https://www.poetsgate.com/ViewPoem.aspx?id=149411",""],[5101,"مِرآتكَ الماء","https://www.poetsgate.com/ViewPoem.aspx?id=193169",""],[5149,"إسمَعْ حَديثي","https://www.poetsgate.com/ViewPoem.aspx?id=211187",""],[5149,"يَا أَيُّهَا المُزْجِي حَنينَ غَرَامِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=211188",""],[5163,"تكلمت بلسان حالي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=33947",""],[5200,"يا شاعرا يصف المهامه والسرى","https://www.poetsgate.com/ViewPoem.aspx?id=200806",""],[5277,"عهدٌ... إلى عهدٍ التميميِّ تلكَ الَّتي كشفتْ بصفعتِها عِوارَنا...","https://www.poetsgate.com/ViewPoem.aspx?id=194810",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5307,"يا هِبوب الوَرد والفِلّي","https://www.poetsgate.com/ViewPoem.aspx?id=10535",""],[592,"أرى طالع الأدبار والنحس قد بدا","https://www.poetsgate.com/ViewPoem.aspx?id=128843",""],[5376,"إياك نعبدُ ما في القلبِ الاهُ","https://www.poetsgate.com/ViewPoem.aspx?id=188352",""],[5376,"بنو قومي أنا منهم وأنِّي","https://www.poetsgate.com/ViewPoem.aspx?id=197598",""],[5376,"ألا قمْ يا أميرَ المؤمنينا","https://www.poetsgate.com/ViewPoem.aspx?id=202791",""],[5409,"طر في جناحك وحده","https://www.poetsgate.com/ViewPoem.aspx?id=155426",""],[5431,"سريتَ إلى الأقصى كأنك فرقدُ","https://www.poetsgate.com/ViewPoem.aspx?id=187915",""],[5431,"العبودية الجديدة 2 -عمليات التجميل","https://www.poetsgate.com/ViewPoem.aspx?id=210782",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5535,"يا ساعي الشوقِ الذي مُذْ جَرى","https://www.poetsgate.com/ViewPoem.aspx?id=201498",""],[5573,"لك البقا مع طول الايام ياخال","https://www.poetsgate.com/ViewPoem.aspx?id=200175",""],[5582,"ما لِي أَصَبُّ إِلَى الحَياةِ وَما لِي","https://www.poetsgate.com/ViewPoem.aspx?id=187226",""],[5582,"أَلا حَدِّثا عَنْ عَهْدِ ناقِضَةِ العَهْدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186936",""],[5582,"أَهْدَى لَكَ الشَّوْقَ وَالتِّذْكارَ وَالوَصَبا","https://www.poetsgate.com/ViewPoem.aspx?id=63462",""],[5582,"قِفْ وَسَلِّمْ فِي مَغانِي ذِي سَلَمْ","https://www.poetsgate.com/ViewPoem.aspx?id=63570",""],[5612,"يا راجِيَ الناس","https://www.poetsgate.com/ViewPoem.aspx?id=179546",""],[5612,"عَبْدَ الكَريم","https://www.poetsgate.com/ViewPoem.aspx?id=184746",""],[5690,"دع عنك تشبيباً بوصف محاجرِ","https://www.poetsgate.com/ViewPoem.aspx?id=172161",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5829,"قم لرمضان","https://www.poetsgate.com/ViewPoem.aspx?id=212930",""],[5845,"قفْ بالخضوعِ ونادِ ربكَ يا هو","https://www.poetsgate.com/ViewPoem.aspx?id=15455",""],[5906,"أجراس الحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=188073",""],[5956,"أنا والجمال حكاياتُ حُبٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=181885",""],[5956,"لبتر أسباب الحروب","https://www.poetsgate.com/ViewPoem.aspx?id=184187",""],[5961,"الدعاء في عرفات","https://www.poetsgate.com/ViewPoem.aspx?id=199815",""],[6068,"فلسفة الغيرة","https://www.poetsgate.com/ViewPoem.aspx?id=178196",""],[6320,"نَشِيجُ الخِضَمّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83635&r=&rc=16",""],[6357,"ونقعد ُ كالنساء ِ ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78226&r=&rc=20",""]],"verses":[["وَأَقصَرتَ عَن ذِكرِ البَطالَةِ وَالصِبى","وَكانَت سَفاهاً ضَلَّةً مِن ضَلالِكا",0,"ك",2,0],["وَأَقصَرَ باطِلي وَصَحَوتُ حَتّى","كَأَن لَم أَجرِ في دَدَنٍ غُلاما",1,"م",2,0],["وَأَقصِر بَعدَها أَوزِد","وَطِر في إِثرِها أَو قَع",2,"ع",1,0],["وَأَقصَرَ عَن غَربِ الشَبابِ لِداتُهُ","بِعاقِبَةٍ وَاِبيَضَّ مِنهُ المَسائِحُ",3,"ح",1,0],["وَاِقصِد بِكُلِّ مَديحٍ أَنتَ قائِلُهُ","نَحوَ الهُداةِ بَني بَيتِ الكَراماتِ",4,"ت",1,0],["وَأَقصَمَ سَيّارٍ مَعَ الحَيّ لَم يَدَع","تَراوحُ حافاتِ السَماءِ لَه صَدرا",5,"ر",2,0],["وأقصد الخير في أقتصادك حتى","لا يؤول الثراء للأعنات",6,"ت",1,0],["واقصدوا مرقده حجاً فلا","غروَ أن شدّت لمثواه الرحال",7,"ل",1,0],["وأقصدُ إِن رَمَيتُ إِلى سِوَاكُم","بنبلي حكم يحكمونَا",8,"ن",2,0],["واقصد جنابي جاهه ونواله","إن خفت حالي عسرة ونكال",9,"ل",1,0],["واقصد أبا عيسى فثمّ الندى","والحلم والعلم وثم النفاذ",10,"ذ",1,0],["وأقصر عنه الطرف خوف ملالتي","عليه وحوبائي إليه تتوقُ",11,"ق",1,1],["واقصدْ بوُدِّكَ خِلّاً ليس من ضِلَعٍ","عوجْاء فيها بِوَشْكِ الزَّيْغِ إيذان",12,"ن",1,0],["وَأُقصِدَ مِنّا كُلُّ مَن كانَ صاحِياً","صَحيحَ الفُؤادِ وَاِشتَفى كُلُّ مُقصَدِ",13,"د",1,0],["وَأَقُصُّ مِن شِعري كِتابَ مَحاسِنٍ","تَتَقَدَّمُ العُلَماءَ فيهِ مُسَطَّرا",14,"ر",2,0],["وَأَقصَرتُ عَن حَمدِ الرِجالِ وَذَمِّهِم","وَفيهِم وُصولٌ لِلإِخاءِ وَقاطِعُ",15,"ع",1,0],["وَأَقصَرتُ عَمّا تَعلَمينَ وَسُدِّدَت","عَلَيَّ سِوى قَصدِ السَبيلِ مَعادِلُه",16,"ل",2,0],["وَأَقصِدُ اللَذّاتِ وَالمَلاعِبا","فَقُم بِنا مُبتَكِراً يا صاحِبي",17,"ي",1,0],["وأقصرُ أيام الفتى يومُ لَذّةٍ","صبا ما صبا بالعيش فيه فطابا",18,"ب",2,0],["واقصدْ فعالَ المكرماتِ تبرعاً","فالمكرماتُ حميدةُ الآثارِ",19,"ر",1,0],["وَأَقصَرَ ذاكَ العَهدَ يَوماً وَلَيلَةً","وَأَطيَبَ ذاكَ العَيشَ ظِلّاً وَمَرتَعا",20,"ع",2,0],["وَاِقصِد إِلى شَطِّ الفُراتِ وَعاطِني","قَبلَ الصَباحِ وَعاصِ كُلَّ مُفَنَّدِ",21,"د",1,0],["وَأَقصاني مِنَ الرُؤَساءِ كَوني","وَكَونُهُمُ لِخالِقِنا عَبيدا",22,"د",2,0],["وَأَقصي عَن مَآرِبِكَ البَرايا","وَلا يَغرُركَ خِلٌّ بِالتَحَفّي",23,"ف",2,0],["وَأَقصَرُ الوَقتِ كَونٌ ثُمَّ يَنظِمُهُ","حُكمُ القَديمِ فَيُفنيهِ بِأَكوانِ",24,"ن",1,0],["واقْصُصْ قِصَصي عليهِمْ وابك عَلَيّ","قُلْ مات ولم يحظَ من الوَصْلِ بشَيْ",25,"ي",1,0],["واقصد فقيها بنور الله مشتعلا","يريك ما ضاق عنه الجهل متسعا",26,"ع",2,0],["وأقصرَ، عمّا تعلمينَ، وسددتْ","عليَّ، سوَى قصدِ السبيلِ، معادلُهْ",27,"ل",2,0],["وأَقصُّ مِن شِعري كتابَ محاسنٍ","تتقدم العماء فيه مسطَّرا",28,"ر",2,0],["وَأَقصِد أَن يَعيد رُوا شَبابي","زَمان غادر الولدان شِيبا",29,"ب",2,0],["واقصد ابا البركات فياض الندى","علم المعالي بضعة الاعلام",30,"م",1,0],["واقصد القوم كلهم فخر بغدا","د مقل بالخضوع يا لساد",31,"د",1,0],["واقصر ملامك إِنني رجل لقد","بالكأس بعت خوابياً من ديني",32,"ن",2,0],["واقصِدْ أبا العَرَب بن سلطان الذي","عَمَّ الوَرَى بكرامةٍ وسخاءِ",33,"ا",2,0],["وَأَقصى وُلاةَ الجَورِ عَنها حَميَّةً","لِيَسكُنَ مَرعُوبٌ وَيَنعُمَ بالُ",34,"ل",1,0],["واقْصِدا منه غزالا باسماً","عن شَتيتٍ كالأَقاحِي شَنِبِ",35,"ب",1,0],["وَأَقصَرَ عَنّي جُنونُ الشَبا","بِ بَعدَ غَرانِقِهِ المُعجِبِ",36,"ب",1,0],["واقصِد بأذرعك الذريعة إنها","تكسوكَ من حُسن الثناء ثيابا",37,"ب",2,0],["وَاِقصِد حِمى مَلِكٍ عَزيزٍ جارُهُ","سامي الذَوائِبِ شامِخِ العِرنينِ",38,"ن",1,0],["واقصر فموت الصبّ عينُ حياته","وجنونُه في حبّه عينُ الحجا",39,"ج",2,0],["واقصد بهم غدران غدرهم فما","اري بالجنا حقاً لمن لم يزرع",40,"ع",1,0],["واقصد ربا الخيفة الغراء مقتبسا","من نور أَبلج يَلقى الوفد مبتسما",41,"م",2,0],["واقصد زبيدا سقاها اللَه من بلد","فربعها بولي اللَه مأهول",42,"ل",1,0],["واقصد منقطعا اليه فكل من","يَرجوه منقطعا اليه كفاه",43,"ا",2,0],["وَاِقصد حِماهُ ترى المخاوفَ عسعست","ظُلُماتها بِصباحِ أمنٍ مسفرِ",44,"ر",1,0],["وَأَقصَتني وَقَصَتني وَمِنها","وَبِحُبِّ الحُبِّ في قَفَصي حَبَتني",45,"ن",2,0],["وَاِقصِ مالاً ما تَزَكّى دَهرَهُ","بِالغِنى بي عَنهُ كَي تَدنو زَكِي",46,"ي",1,0],["وَاِقصُد مَكارِم عَبد اللَه واِروِ بِها","مِنكَ الظَما فَلغيث الجود جوداتُ",47,"ت",1,0],["وَاِقصد أَخا الاشواق مُنعَطف اللَوى","فَوق الغَوير وَتَحتَ بانَة يَنبع",48,"ع",1,0],["واقْصِدْ كريماً له عبدُ الكريمِ أَبٌ","تَجِدْ هُماماً لأمرِ المجدِ مُؤْتَمِرا",49,"ر",2,0],["وأَقصَى مُنَى إنسانِها هو أَنّه","رجاءً التّلاقي من سَوادي مِدادها",50,"د",3,0],["واقصر الآمال لا تبسطها","إنه آتيك يوما لا محال",51,"ل",1,0],["واقصد المعمور من ربع الأصول","تلق ما تهوى",52,"ه",3,0],["وأُقصِينا وما خُنّا","ومازِغْنا عَن العَدْلِ",53,"ل",1,0],["وأقْصَدَتْني سهامُ الحاسِدِيّ عَلَى","فَوزِي بقُربِكَ حتى قَرطَسُوا الهَدَفا",54,"ف",2,0],["واقصد الملك الذي","للنواصي قد ملك",55,"ك",1,0],["واقصدنه تفر بمال وجاهٍ","وتعلّم أقوالهُ وفعالَه",56,"ل",2,0],["واقصد الصدق في المقال وإن كا","ن نظيما أو كان قولا دنيرا",57,"ر",2,0],["واقصص معي أثر الخليط فإنّما","جرح النوى منهم جميع جوارحي",58,"ح",2,0],["واقصد إلى الأنصار هم لك عصبةٌ","تغنيك عن بو طالب وحماته",59,"ت",2,0],["واقصد لمطلب علم الطب حيث به","يُقوم العقل ذو التكليف والسبحا",60,"ح",2,0],["وأقصد مغناك الذي أَنت نازل","لأسمع سكان القبور قصيدي",61,"د",2,0],["واقصد ربي الهامة الغناء مستمعاً","شدو القيان من الأطيار في السحر",62,"ر",1,0],["واقصر مدى الخطو واعبر صالحيتَها","ترَ القصور بها تسمو على الزُّهُر",62,"ر",1,0],["وأقصى منى العانين طوعَ يمينهِ","وأرقى مدى الغايات مجرى سوابقه",63,"ق",2,0],["واقصِد بها غايةَ الجمال على ال","عادة فيها لا غايةَ القِيَمِ",64,"م",1,0],["واقْصُدْ رِحابَ ابن الخِزامِ عَليِّنا","واملأْ بِمَدحِ جَنابهِ القِرْطاسا",65,"س",2,0],["واقْصِرِ الأَمرَ عليهمْ","فبِهِمْ نيلُ المَواهِبْ",66,"ب",1,0],["واقصم الكاذبين عنك فإن ال","كذب فيه نميطة شنعاء",67,"ا",2,0],["وأقصرتُ عمَّا قد عهدتَ وزاجرٌ","من النفس خيرٌ من عتاب بالعواذل",68,"ل",1,0],["واِقصِد لُباناتِ الهَوى فلعلّنا","نَقضي لُباناتِ الفؤادِ التّائِهِ",69,"ا",3,0],["واِقصِدْ لُباناتِ نُعمانٍ وجيرتَها","واِذكُر لُباناتِ قلبي عند لُبْناها",70,"ا",3,0],["وأقصرت من ندبي له كل ساعة","وفي كبدي الحرى عليه ندوب",71,"ب",1,0],["وأقصد أبا النجم الذي تمنت ال","أنجم لو أصبحن من قصاده",72,"د",2,0],["واقصر خطاك وكف عن وجه الثرى","ما طال من ذيل وفضل إزار",73,"ر",1,0],["وَاِقصِد مصلى بِهِ بابُ السَلامِ وَقف","لَدى المَقامِ وَقَبّل مَوطِئَ القَدَمِ",74,"م",1,0],["واقْصدْ إلى لُقْيا رِجالِ العِلْمِ وال","آداب فاللُّقْيا أَجَلُّ مُناكا",75,"ك",2,0],["واقْصِمْ حبالَ الجَبْرِ إن أعْضَلَتْ","ثم اعْتَصِمْ بِحَمْدِ ذَاكَ السُّرا",76,"ر",2,0],["واقصدِي مَرمَى الخُصومِ","وادخُلِيه بِسَلام",77,"م",1,0],["واقصد إلهك لا تقصد سواه تفز","ويذهب الله عنك السوء والضررا",78,"ر",2,0],["واِقصد زِيارتهم وطُف بقبورهم","لتكونَ في أمنٍ بيوم لقاءِ",79,"ا",2,0],["وأقصِر مِن خَطوي ولَستُ مُقَيَّدا","كأنّيَ في حَبسٍ وما أنا في حَبس",80,"س",1,0],["واقصُد لجِنسِك فالطّباعُ لِحكمِها","مَحضُوضَةٌ بِتَلاؤُم الأجناس",81,"س",1,0],["وَاِقصِد لَهُ وَاِسأَل بِهِ تُعطَ المنى","وَتَعيشُ مَهما عشت فيهِ سَعيدا",82,"د",2,0],["واقصد بنا سبيل من","راح خليا واسلك",83,"ك",1,0],["وَاِقصُد بِها عكّةً دار الجِهادِ كَذا","دار السُعودِ وَقِف بِالبابِ مُحترما",84,"م",2,0],["وَاِقْصدْهُ تهدِكَ نيرانُ القِرى سُبلاً","لرَبْعِهِ المُعْتَلى مِنْ غَير أنْ تَسَلا",85,"ل",2,0],["وَاِقصِد بِنا فِتيةً في الحيّ قَد سُقِيَت","ماءَ المَحاسِنِ مِن غنجٍ وَمِن كحَلِ",86,"ل",1,0],["وَاِقصرِ الفِكرَ عَليها تَغنَما","فَلبيبٌ مَنْ لأَهليه نَسِي",87,"ي",1,0],["وَاِقصداها فَإِنّها ذاتُ ثَغرٍ","ذي اِبتِسامٍ مُبشّرٍ بِالأَماني",88,"ن",2,0],["وَاِقصُد مَطارِحَه تَشهَدْ قرائحَه","وَاِلزَم مَدائِحَه دَوماً ولا تحلِ",89,"ل",1,0],["وَاقصد عِناقي إِنَّني بشيرُ","وَبِالأَكُفِّ لِلهَنا أُشيرَ",90,"ر",1,0],["واقصد علالي قلاليه تلاق بها","ما تشتهي النفس من حور وولدان",91,"ن",1,0],["واقصدنْه بأمان اللَّ","ه وادخلْ بسلام",92,"م",1,0],["واقصد بها سيداً يميل إلى ال","إكرامِ ميلا ويُبغض البُخَلا",93,"ل",2,0],["واقصِد فلاحَ المساعي إن مررت على","بني فلاح تصادف خيرَهم داني",94,"ن",2,0],["واقصد دياراً لنا من غشب يحمد في","عليائها وشجات الأمن والسلم",95,"م",1,0],["واقصدْ إلى إربل واربعْ بها","ولا تقلْ ربعاً قليل الكلا",96,"ل",2,0],["واقصر فإني قد حمل","ت من الهوى ما لا أطيقُ",97,"ق",1,0],["واقصِر فما واسق كسالٍ","منا ولا ساهر كنائم",98,"م",1,0],["وأقصى أبا جهل وقد جاء كافرا","وأدنى أبا ذر وق جاء مسلما",99,"م",2,0],["وَاِقصد إِلى الزاكي فلاح فإنّه","في المكرُمات إمام كلِّ إمامِ",100,"م",1,0],["وَاِقصد فلاحاً وقبّل دستَ مجلسهِ","وَاِنشد بِمفخرهِ الأشعارَ وَالأدَبا",101,"ب",2,0],["وَاِقصد أَبا العرب المتوّج خير من","ملكَ الممالكَ في البلاد وساسا",102,"س",2,0],["وَاِقصد إِلى ذلك القصر الّذي سمكت","نَحوَ السماءِ بهِ الأبراجُ والغرفُ",103,"ف",1,0],["وَأقصدُ بِالمديحِ فتى","مِنَ الأملاكِ مُنتجبا",104,"ب",2,0],["واقصدْ شَريفَ جَنَابه","فالسَّعْدُ حَيْثُ يَحُلُّ حَلا",105,"ل",2,0],["واقصد من الشام المقدس قرية","فيها القرى أنواعه متكاثرة",106,"ه",1,0],["واقصد أمين الدين أحمد من أتى","وسعى بمنهاج الكمال الأفضلِ",107,"ل",1,0],["وَاِقصُوا رِجالاً كُلُّهُم في هُلكِكُم","وَبوارِكُم تَجري بِغَيرِ عِنانِ",108,"ن",1,0],["واقصدهم مشيا على الراس رغبة","لما أودعوا من ابحر العلم والسر",109,"ر",1,0],["واقصد لنصر العزيز ان رمت تكرع من","راح التنزه بل صافي الفيوضات",110,"ت",1,0],["واقصد خيام النازلين بطيبة","فهناك اسعاف بكل مراد",111,"د",1,0],["واقصد الربع باهتمام وعزم","واطف بالوصل عن لهيب الفواد",112,"د",1,0],["وَأَقصَتِ الأَطمَاعَ مَهمَا أقرَنَت","مَن عَارَضَ الأطمَاعَ بِاليَأسِ رَنَت",113,"ت",1,0],["واقصص على الجزع ما ألقاه من سهر","لعل بالجزع أعواناً على السهر",114,"ر",1,0],["واقصروا أعينَ الرجاء قنوطاً","مَن إليه تمتدُّ في البأساء",115,"ا",2,0],["واقصر العاذل لما رأى","أن ليس يجدي في هواك الملام",116,"م",1,0],["وأقصد بها مولى الخلائف يوسفاً","قطبّ المكارم أسَّها وعمادها",117,"د",3,0],["وأقصى قُصَارى نوالِ الكرامِ","على قِصَرِ العمر مُسْتَعْجَل",118,"ل",1,0],["وأقصد أحشائي فاصمى صميمها","ففاض دماها واستهال على الترب",119,"ب",1,0],["وأقصتك عن سلطان ملكك صابراً","على الهضم مغمود الحسام عن الضرب",120,"ب",1,0],["واقصد مدائح قطب حاذق لبق","ينسيك للأهل والأحباب والوطن",121,"ن",1,0],["واقصد الصدر بطعن خارق","بأصابيع كرمح لهدام",122,"م",1,0],["واقصد الإلية إن كنت فتى","في كبير العجز والإرداف هام",122,"م",1,0],["واقصروا في الخطا وغنُّوا وتُوبوا","تأمنوا في القيام عضَّ البنانِ",123,"ن",1,0],["واقصرُوا في الخطا وسيروا الهُوَينا","فمع العَدو تعثرُ الشَّهباء",124,"ا",2,0],["واقصد عرباً في حيّهم","مَن مات يعش عيشاً رغدا",125,"د",2,0],["وأَقْصوا مُناوِيهم ولو كان والداً","أَوِ ابْناً وخُصّوه بكُلِّ جَفاءِ",126,"ا",2,0],["وَاقصِدُوهُ بِهِمةٍ","تَبلُغُوا القَصدَ وَالمُرَاد",127,"د",1,0],["وَاقصِد حَبِيبَ اللهِ وَادنُ لِبابِهِ","وَقُلِ السَّلاَمُ عَلَيكَ يامَن شُرِّفا",128,"ف",2,0],["واقصد حمى الغوثِ الذي شهدت لهُ","افعالهُ وهي العدولُ لواقفِ",129,"ف",1,0],["واقصِد على عَزمةٍ أرضَ الحجازِ تجِد","بُعداً عن الحَطِّ في نَزلِ الأوِدّاءِ",130,"د",3,0],["وَأَقصَرتُ عَن لَهوي وَجانَبتُ باطِلي","كَفى واعِظاً مَرُّ السِنينَ لِمَن وَعى",131,"ع",2,0],["واقصر شيء عنده عمر سيفه","ولكنه ما زال يسقيه أعمارا",132,"ر",2,0],["وَأَقصَرَ عَنها وَآياتُها","تُذكّرُهُ داءَهُ الأَقدَما",133,"م",2,0],["وأقصرت عن غيّ التصابي وقد غدا","يريني بياض الشيب ما في العواقب",134,"ب",1,0],["وأقصيته من بعد أنس وصحبة","وما هكذا فعل الأحبة والصحب",135,"ب",1,0],["وَاقصِد إلى الأقرَانِ لاَ أطرَافِهَا","فالعِزُّ تَحتَ مَقَاتِلِ الأقرَانِ",136,"ن",1,0],["واقصد سهامَ سقته كلّ غاديةٍ","فالناس أهلُ سهامٍ حيث ما مالوا",137,"ل",3,0],["وأقصدي قأيَد الجيوش فعيسى","جودُه طَبَّقَ البلادَ سُيولا",138,"ل",2,0],["وأقصد جنابَهم واسمع جوابَهُم","فقد جعلتُ على معناك مُعْتقَدي",139,"د",2,0],["واقصر بخيلك يمنة أو يسرة","اللَه جارك لا تَرى مَحذورا",140,"ر",2,0],["وأقصد أن أحصل لي صديقاً","أعز به على خطئي وعمدي",141,"د",2,0],["واقصُد بعزمٍ أقربَ البنادرِ","يكفيك ربِّي جملةَ المَحاذرِ",142,"ر",1,0],["وَاِقصِدي مِن مَطعَمٍ وَكِساً","هَيلُماناً هَزَّ أَمصارا",143,"ر",2,0],["واقصى الورى شرا وادناهم رضا","واولى بخلق اللّه في الخير والشر",144,"ر",1,0],["واقصدوا وجه ربكم لتنالوا","كل خير وليس منكم سؤال",145,"ل",1,0],["واقصده عند النائبات لأنها","صدأ اللئام وسيقل الأحرار",146,"ر",1,0],["واقصد الحقِّ الحقيقي","إنَّما الخلقُ عدَم",147,"م",1,0],["وأقصد بها تبك الربا أبا خليل","فهو المحب والحبيب والخليل",148,"ل",1,0],["واقصُدْ عُمَيْرَةَ للتزويجِ إنَّ لها","بيتاَ غَدَتْ في سماء الحُسْنِ شَمسَ ضُحى",149,"ح",2,0],["وَاقصِدِ الرَبعَ الذي ما حَلَّهُ","خائِفٌ إِلّا وَوافى حَرَما",150,"م",2,0],["واقصص قصصي لاهل وادي سلم","قل عبدكم صلوه قبل العدمِ",151,"م",1,0],["