{"poems":[[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[56,"يا نكبة جاءت من الشرق","https://www.aldiwan.net/poem27427.html","السريع"],[85,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[46,"إمرأة مقران ماتت بعد ما شابا","https://www.aldiwan.net/poem30063.html","البسيط"],[119,"إليك ربكان أرباب الفحول سعت","https://www.aldiwan.net/poem42179.html","البسيط"],[314,"يا نكبات الدهر دولي دولي","https://www.aldiwan.net/poem50240.html","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56093","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80017","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86532","البسيط"],[4673,"","https://poetry.dctabudhabi.ae/diwan/poem/104488","الكامل"],[5268,"في فؤادكِ موطنٌ","https://www.poetsgate.com/ViewPoem.aspx?id=207011",""],[5273,"ضمي الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=162126",""],[5431,"يانكهة الدراق...","https://www.poetsgate.com/ViewPoem.aspx?id=191720",""],[5848,"فرحة حزين","https://www.poetsgate.com/ViewPoem.aspx?id=50617",""]],"verses":[["يَانُكْتَة الْعَلْيَا وَياقَمَرَ الْهُدَى","وَالعُرْوَةُ الْوُثْقَى الَّتِي لاَ تُفْصَلُ",0,"ل",1,0],["يا نَكبَةً جاءَت مِنَ الشَرقِ","لَم تَترُكي مِنّي وَلَم تُبقي",1,"ق",2,1],["يا نكتة الأكوان يا عَلَم الهدى","آياتُ فضلكَ رُتِّلتْ ترتيلا",2,"ل",2,0],["يا نَكبَةً هَشَمَت أَنفَ السُرورِ بِهِ","وَميتَةً أَبقَتِ العُزّابَ عُزّابا",3,"ب",2,0],["يا نكتة الطلسم البهت الخفي عز ال","أبصار واللمعة الأولى التي سطعت",4,"ت",1,0],["يا نَكَباتِ الدَهرِ دولي دولي","وَاِقصِري إِن شِئتِ أَو أَطيلي",5,"ل",2,1],["يَأْنُكُ عَنْ تَفْئِيمِهِ مُفَاءَمُهْ","إِلَى جُلالِ عَيْثَمٍ عَثَمْثَمُهْ",6,"م",2,0],["يا نكدياًّ نما للعدا","يوماً به يغشى المُلمِّ العديدْ",7,"د",1,0],["يا نكبةً ما كانَ أفدحها","طرقتْ فضاقَ بهولها ذرعي",8,"ع",2,0],["يا نكبة الوطن المحزون في رجلٍ","يغنيه عن كثرة الألفاف والعصب",9,"ب",1,0],["يا نكبة عمت على كل الورى","عمت على الآفاق والارجاء",10,"ا",2,0],["يا نكهةَ الحُبِّ التي أدمَنتُها","فاغتالني الرِّمشُ الرَّقيقُ الأسمرُ",11,"ر",1,0],["يا نكهةَ الموتِ التي","تحيا بأعماقِ الضميرْ",12,"ر",1,0],["يانكهة الدراق لم تهجرْ فمي","ياأجمل العشاق ابحرْ في دمي",13,"م",2,1],["يانكهة النارنج طعمك ملهمي","حلو الهوى مرّ وفيه تنعمي",13,"م",2,0],["يا نكهة الصبح طل الصبح بانفاسه","وانا اتنفس غيابك ويتنفسني",14,"ن",2,1]]}