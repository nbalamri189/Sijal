etsgate.com/ViewPoem.aspx?id=185931",""],[5376,"لا ترحلي فلقدْ وهبْتُك مهجتي","https://www.poetsgate.com/ViewPoem.aspx?id=196576",""],[5409,"هكذا من حقه من نام ضاعا","https://www.poetsgate.com/ViewPoem.aspx?id=155288",""],[5417,"لقاء","https://www.poetsgate.com/ViewPoem.aspx?id=188602",""],[5431,"قالت جهينة ...","https://www.poetsgate.com/ViewPoem.aspx?id=214882",""],[567,"ألوى علي فضمني وضممته","https://www.poetsgate.com/ViewPoem.aspx?id=201616",""],[5559,"بيننا شغاف الروح ( محمود أسد )","https://www.poetsgate.com/ViewPoem.aspx?id=60738",""],[5582,"أَنَّى يَكُونُ مِنَ الغَرامِ جُحُودُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=186884",""],[5582,"لا تُكْثِرا فِي اللَّوْمِ مِنْ تَفْنِيدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63502",""],[5606,"الوحده أحسن من اللي رفقته بايره","https://www.poetsgate.com/ViewPoem.aspx?id=194252",""],[5652,"سلام ياهامة بعيدات الاذهان","https://www.poetsgate.com/ViewPoem.aspx?id=181104",""],[5751,"عشرون يوما","https://www.poetsgate.com/ViewPoem.aspx?id=215009",""],[5807,"عاتبتُ طيفَ الذي أهوى وقلتُ لتُ له","https://www.poetsgate.com/ViewPoem.aspx?id=187233",""],[5848,"ناقوس الخطر","https://www.poetsgate.com/ViewPoem.aspx?id=51943",""],[5895,"اِسْهَرْ لِوَحْدَكْ يا قَمَرْ","https://www.poetsgate.com/ViewPoem.aspx?id=202182",""],[5969,"أشتاقني عبقا","https://www.poetsgate.com/ViewPoem.aspx?id=198952",""],[6093,"أهْلاً وسهلاً بمن له عندي","https://www.poetsgate.com/ViewPoem.aspx?id=176488",""],[6102,"عاتبيني","https://www.poetsgate.com/ViewPoem.aspx?id=184445",""],[6117,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=182777",""],[6152,"وعد ممطول","https://www.poetsgate.com/ViewPoem.aspx?id=202351",""],[6152,"عاتبت طيفكِ","https://www.poetsgate.com/ViewPoem.aspx?id=213185",""],[6213,"شجون عاتية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85497&r=&rc=100",""],[6213,"شق النفس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76280&r=&rc=37",""],[6312,"البؤرُ المتحركةُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82949&r=&rc=4",""],[6321,"نحن من علَّم الغرامَ الغراما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63419&r=&rc=2",""],[6328,"تاء التأنيث","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84884&r=&rc=25",""]],"verses":[["عاتبٌ في المنَامِ أَحبِب بُعُتبَا","هُ إِلَينَا وقَولِهِ مِن مَقَالِ",0,"ل",1,0],["عاتبتُ شحّاً عليك لا عبَثاً","كيما أجِدَّ المعاهد اللُبسا",1,"س",2,0],["عاتَبتَ مَن لا يَرعَوي","وَعَذَلتَ مَن لا يَقبَلُ",2,"ل",1,0],["عاتبت فيها الحادثات بحكمة","حتى لكدت تلينهن عتابا",3,"ب",2,0],["عاتٍ إِذا المَظلومُ ذَكَّرَهُ","أَغضى عَلى عِظَمٍ مِنَ الذِكرِ",4,"ر",1,0],["عاتبتُه يوماً وفي وَجَناتِه","وَرْدٌ فصار من الحَياءِ شقَائِقا",5,"ق",2,0],["عاتبت محبوب قلبي حين زايلني","عن مضجعي وفصاد الفجر قد فجرا",6,"ر",2,1],["عاتَبتُهُ فَتَضَرَّجَت وَجَناتُهُ","وَاِزوَرَّ أَلحاظاً وَقَطَّبَ حاجِبا",7,"ب",2,0],["عاتِقٌ مُعتَقٌ مِنَ الهونِ إِلّا","مِن مُقاساةِ مَغرَمٍ أَو نِجادِ",8,"د",1,0],["عَاتَبْتُهُ لا لأَمْرٍ فِيهِ مَعْتَبَةٌ","عَلَيْهِ لَكِنْ لأَرْعَى وَرْدَةَ الْخَجَلِ",9,"ل",1,1],["عاتبتُ ظَبْيَاً مصوناً","لمْ أنتَ سيئُ خطِّ",10,"ط",1,1],["عاتَبَتني ساعَةً وَهيَ تَبكي","ثُمَّ عَزَّت خُلَّتي في الخِطابِ",11,"ب",1,0],["عاتَبَني الشِعرُ ذا إِكافِ","وَقالَ لي اللَهُ مِنكَ كافِ",12,"ف",1,1],["عاتِب أَخاكَ إِذا هَفا","وَاِعطِف بِوُدِّكَ وَاستَفِده",13,"د",2,0],["عَاتِبٌ ظَلْتُ لَهُ عَاتِباً","رُبَّ مَطْلوبٍ غَدا طَالِبا",14,"ب",2,1],["عَاتَبْتُهَا حَتَّى إِذَا رُوِّعَتْ","بِطَيْفِ شَرٍ أَشْعَثٍ أَغْبَرِ",15,"ر",1,0],["عاتبت بالوهم الزمان واهله","وغلطت ما لبني الزمان وفاء",16,"ا",2,0],["عاتبتها فأشارت للإعادة وال","حسنى بقرب ولاحت لمعة البشر",17,"ر",1,0],["عاتبتني في شيء والدوا","استعماله في غير داء متلف",18,"ف",1,0],["عاتَبتَني عَلى صُروفِ زَمانٍ","قَد رَماني بِشُؤمِهِ لا رَماها",19,"ا",3,0],["عاتبوني على انفرادي والوح","دة بعد الإخوان والأصحاب",20,"ب",1,1],["عاتبتها يومَ النوى","وحملتُ إثمَ عتابها",21,"ب",3,0],["عاتبْ حَبِيبَك مُعْلناً أو مُخْفياً","واجعل عِتابَك كُلّه استِعطافا",22,"ف",2,1],["عاتِباهُ في فَرطِ ظُلمي وَهَجري","واِسئلاهُ عَساهُ يَرحَم ضُرّي",23,"ر",2,1],["عاتبي أحوال وجْد ٍ","شاحبٍ واهٍ كسيحِ",24,"ح",1,0],["عاتَبَني الفَضلُ إِذ رَآني","أَسعى إِلَيكُم في كُلِّ يَومِ",25,"م",1,1],["عاتب أَخاكَ الجاني","بالبِرِّ والإِحسانِ",26,"ن",1,0],["عاتبت نَفسي وَقُلتُ الشيبُ أَنذرني","وأَنتِ يا نفسُ عنه اليوم في صَممِ",27,"م",1,0],["عاتَبتُها بعدما مالَ الحَديثُ بها","عَتباً يمازجُه من دَلِّها مُلَحُ",28,"ح",1,0],["عاتبت من سد سمعي صوت فقحته","ولم أجد ملجأ لي من مطاردها",29,"ه",2,1],["عاتِب أَخاكَ وَلا تُكثِر مَلامَتَه","وَزُر صَديقَكَ رِسلاً بَعدَ تَغييبِ",30,"ب",1,0],["عَاتَبْتُهُ بَدْر تِمٍّ","قَدْ أَطْلضعَتْهُ جُيُوبُهُ",31,"ب",2,1],["عاتِبي في معذّبي حَسبه اللَه","كَم يَزيد اِشتِعال لبّي اِشتعالا",32,"ل",2,0],["عاتَبتُهُ فَتَوَرَّدَت وَجَناتُهُ","وَالقَلبُ صَخرٌ لا يَلينُ لِقاصِدِ",33,"د",1,0],["عاتَبتُه في تيهِهِ","فازدادَ في إِسرافِهِ",34,"ف",2,1],["عاتَبني فيه وأجرَيتُه","والعتبُ في الجاري على المُجري",35,"ر",2,0],["عاتَبتُهُ في صَدِّه قبلَ النَّوى","فكأنَّ عتْبي زادَهُ إصرارَا",36,"ر",2,0],["عاتب الدهر على إقوائها","إنَّ للحرّ مع الدهر عتابا",37,"ب",2,0],["عاتبتُ دهري في الجناية لو وعَى","ونشدتُه الحُرَمَ الوكيدةَ لو رعَى",38,"ع",2,1],["عاتَبَ عنها واصفاً مودّةً","ما أسأرتْ إلا عُلالاتِ الكرى",39,"ا",1,0],["عاتَبَني يَوماً عَلى رِقَّتي","وَقالَ لا تُفسِد بِها الشِعرا",40,"ر",2,0],["عاتِبِ النَفسَ وَالفُؤادَ الغَويّا","في طِلابِ الصَبا فَلَستَ صَبيّا",41,"ي",2,1],["عاتَبو وبالسُّكرِ فيك طابوا","وصرَّحوا بالهوى وفاهُوا",42,"ه",3,0],["عاتَبتُها فأشاحَتْ غيرَ ناطقةٍ","كأنَّها من بَناتِ الفُرْسِ والعَجَمِ",43,"م",1,0],["عاتبهم في فعلهم فأعتبوا","وسألوا التوبة فيما ارتكبوا",44,"ب",3,0],["عاتبتها مذ أنكرت ودنا","قالت لك الويلات فاطو العتاب",45,"ب",1,0],["عَاتِبِي في الفخرِ أقْصِرْ","جُرْتَ عن نهجِ الطّريقِ",46,"ق",1,1],["عاتبتهم يوماً فقالوا جاحد","يستنكر الإصلاح والتقويما",47,"م",2,0],["عاتبتكم ولكم مني شفيعكمُ","أحق بالعتب من لا يعرف الضغنا",48,"ن",2,0],["عاتقٌ في الدّنانِ بكرٌ أدارتْ","ها علينا عواتقٌ أبكار",49,"ر",1,0],["عاتب حسودك لي من الناس مشتهر","ودوس الأمور اللي لكبده نظيرها",50,"ر",3,0],["عاتبتُه قال لا تعاتبْ","فإنّما العَتْبُ لِلنّساءِ",51,"ا",2,0],["عاتَبَتنِي عَلَى الصُّدودِ فأَبدَت","عِقدَ دُرٍّ وهوَ القَرِيضُ الفَرِيدُ",52,"د",1,0],["عاتبتْني فأوسعتْني عِتاباً","فكأني أتيتُ شيئاً فريّا",53,"ي",2,0],["عاتبت نَفسي وَلَو كانَت موفقة","لَكانَ لي وَلَها مِن نَفسِها حكم",54,"م",1,1],["عاتِقَةٌ مِنْ عاتِقِ السُلافِ","بِمَزْبَدٍ مِثْلِ دَم الأَجْوافِ",55,"ف",1,0],["عاتَبْتُ إِنْسانَ عَيْني في تَسَرُّعِهِ","فَقالَ لي خُلِقَ الإِنْسانُ مِنْ عَجَلِ",56,"ل",1,0],["عاتبته عما جناه م","ن الصدود فقال عذرا",57,"ر",2,0],["عاتبتُ ألحاظَ عيني عندما نظرت","إلى سوى الحبِّ فاحمرت من الخجل",58,"ل",1,0],["عاتبني في حبكم عاذل","يزعم نصحي وهو فيه كذوب",59,"ب",1,1],["عاتَبته فغرست في","وَجَناته بالعتب وردا",60,"د",2,1],["عاتبوني على ملازمة ال","راح وشربي سلافها بالكبير",61,"ر",1,0],["عاتبته اذا امالته الصبا هيفا","فقال لي أي غصن غير منعطف",62,"ف",1,0],["عاتبني لِمْ نمت من بعدِه","وَلَوْ دَرى عن علتي مَا عَتَب",63,"ب",1,0],["عاتبته فبكى لاطفتُه فشكى","وقال مِن قَبِل الواشين لا قبلي",64,"ل",2,0],["عاتبت نفسي به غداة اس","ترقها الحب وهي حره",65,"ر",2,0],["عاتبتها فتحدرت من جفنها","درر وددت اكون من قطراتها",66,"ت",3,0],["عاتبته فقسا، وفيتُ فخانني","قربُته فنأى، بكيت تبسما",67,"م",2,0],["عاتَبتُ نَفسي عَلى صَبرٍ وَقُلتُ لَها","لا عِشتُ من بَعد ما ساروا بِظَعنِهِم",68,"م",1,0],["عاتَبتُ نَفسي عَلى غَيِّ وَقُلتُ لَها","ألامَ تَبغينَ في هذا الوَرى طَمعاً",69,"ع",2,0],["عاتَبتُ قَلبي في الغَرامِ عَلى الهَوى","يَوماً وَقُلتُ لَهُ بِفَرط عِتابي",70,"ب",2,0],["عاتبتُه إِذ قُلتُ يا متمنِّعاً","وَافى وَقَد أَخذَ الأَسى بذمامي",71,"م",2,0],["عاتقت بهجة روحي للوداعي وبي","ما عندها من عظيم الوجد والحزن",72,"ن",1,1],["عاتَبتُ نَفسي في هَوا","كِ فَلَم أَجِدها تَقبَلُ",73,"ل",1,1],["عَاتَبَهُ اللهُ عِتَاباً مُستَطاب","قَد زَادَ فِي رِفعَتشهِ دُونَ ارتِيَاب",74,"ب",1,0],["عاتبتُ أيري إذ جاء ملتثماً","بالخزي من علقه فما اكترثا",75,"ث",2,1],["عاتَبْتُهُ فاسْتَطالا","وصَدَّ عنّي دلالا",76,"ل",2,1],["عاتبت قَلبيَ لَمَّا","بِالهَجر صُرتُ عَليلا",77,"ل",2,1],["عاتَبتُ فأحمَدَت مآلَ العَتبِ","إِذ فَسَّحَ دلُّها مَجالَ العَتبِ",78,"ب",1,1],["عاتبته في حلقه لعذاره","لما تبدى مسرعا في سيره",79,"ر",2,1],["عاتبتُه في عَبْرتي زاجراً","خوفاً على الأَسرار زاجر",80,"ر",1,0],["عاتقته فكأنني وكأنه","ألف ولام ثم معتنقان",81,"ن",1,0],["عاتبتْ سلمى سُميراً أَم ترى","غازلتْ بالرَّوضِ أَنفاس الخُزامى",82,"م",2,0],["عاتَبته يوم الرحيل فقال لي","خفِّض عليك فلستُ ممنّ يَرحم",83,"م",1,1],["عاتبتهُ إذ لجَّ في","هُجرانه كيما يَؤوبا",84,"ب",2,0],["عاتبتُه فيه فلم يكترثْ","وبالذي استبعدْتُه أوّلهْ",85,"ل",2,0],["عاتبتها والعتب طال حديثه","ما بيننا عمداً على الرقباء",86,"ا",2,0],["عاتبت دنياي على حذفها","اخى اعتباطا من اخيرين",87,"ن",1,1],["عاتبتُ دهري لو صبا لعتابي","وسألتُه لو رَّد بعضَ جوابي",88,"ب",2,1],["عاتب أخاك إذا هفا","وأعطف بودك واستعده",89,"د",2,1],["عاتبت نفسي كيف ترضى عتابك","ونفسي تعاتبني على فقد صحبتك",90,"ك",1,0],["عاتب الأيام وتحس بعتابك","واجرح الأشواق وتسيل من لونك",91,"ك",1,0],["عاتبت ذكرى الموجعات بخيبتي","فمضى على أشلائه المفتاح",92,"ح",1,0],["عاتق وحش شاف الطيار وضمنها","ويرهي على خوف الشفيق الأماني",93,"ن",2,0],["عاتبت نفسي بين واعي ومذهول","ورميت لك في بحر هالسود سفني",94,"ن",2,0],["عاتب فديتك لاتخبيك الاوجاع","مثلك عليه مْن النفوس الحليمه",95,"م",2,0],["عاتبيني بسوى الهجرِ ِولا","تذبحي قلبي بسيفِ الكبرياء",96,"ا",2,0],["عاتبت قلبي كثيراً كيف تذكرها","وعُمرُكَ الغضّ بين اليأس تُلقيه..",97,"ي",2,0],["عاتي الرياح إذا هبت مصائبه","يميل أو ينحني في فطنة الحذر",98,"ر",1,0],["عاتبته في عبرتي زاجرا","خوفا على الأسرار من زاجر",99,"ر",1,0],["عاتبته ووددن لو","لم يصغ ثم بدا له",100,"ل",2,1],["عاتبوني وما جنيت ولكن","حين ملوا يطلبون الأثاما",101,"م",2,0],["عاتبت نفسي واقتنعت بعذرها","والأمر ليس كما أشاء وأقصد",102,"د",1,1],["عاتبينا إن شئتِ أو فاغْضِبينا!","عذِّبينا يا أختُ أو رَحِّلِينا!",103,"ن",2,0],["عاتٍ متى هبَ الضلال لصرعهِ","لقي الضلال بدون شكٍ مصرعه",104,"ع",2,0],["عاتٍ يسيرُ وضوءُ موعدهُ معه","وثباتُ أعوام الصمود الأربعة",105,"ع",2,1],["عاتٍ من الأقدار أقبل ثائرًا","ما اسطاع طاغوت الغوى أن يُخضعه",105,"ع",2,0],["عَاتَبْتِنِي ، لَمْ تَقْنَعِي ! أَوْجَعْتِنِي !","بَلْ قُل