{"poems":[[55,"من الركب ما بين النقا والأناعم","https://www.aldiwan.net/poem29748.html","الطويل"],[90,"خليل هل من منصت فأبثه","https://www.aldiwan.net/poem44797.html","الطويل"],[90,"أما آن أن يغشى البلاد سعودها","https://www.aldiwan.net/poem44836.html","الطويل"],[53,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[72,"اليوم أنت بخير","https://www.aldiwan.net/poem42931.html","مجزوء الكامل"],[91,"حملته بين احشائي بلا برم","https://www.aldiwan.net/poem44857.html","البسيط"],[87,"فيم ابتسامك للدنيا وغايتها","https://www.aldiwan.net/poem7530.html","البسيط"],[64,"نصيحكما فيما يقول مريب","https://www.aldiwan.net/poem52505.html","الطويل"],[68,"وما أتاني كتاب منك يأمرني","https://www.aldiwan.net/poem38432.html","البسيط"],[107,"غوى الناس حتى لا صواب ولا رشد","https://www.aldiwan.net/poem43420.html","الطويل"],[54,"يا دار يا دار أطرابي وأشجاني","https://www.aldiwan.net/poem26663.html","البسيط"],[48,"إن يصحب الروح عقلي بعد مظعنها","https://www.aldiwan.net/poem22120.html","البسيط"],[48,"أرى حيوان الأرض غير أنيسها","https://www.aldiwan.net/poem22426.html","الطويل"],[48,"إذا كنت قد جاوزت خمسين حجة","https://www.aldiwan.net/poem22522.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72200","البسيط"],[136,"أرى العذال في الهيمان لاموا","https://www.aldiwan.net/poem54654.html","الوافر"],[141,"ليت هشاما عاش حتى يرى","https://www.aldiwan.net/poem67978.html","السريع"],[147,"أما الزمان فقد ألزمته الجددا","https://www.aldiwan.net/poem11751.html","البسيط"],[151,"الحمد لله تعظيما وإجلالا","https://www.aldiwan.net/poem47640.html","البسيط"],[173,"قم فاسقنيها قبل صوت الحمام","https://www.aldiwan.net/poem1679.html",""],[190,"كل قبل أن يأكلك الدود","https://www.aldiwan.net/poem43950.html","السريع"],[203,"بدت قمرا له حظي ليالي","https://www.aldiwan.net/poem45380.html","الوافر"],[242,"سقى أم العلاء وبنت مجد","https://www.aldiwan.net/poem18178.html","الوافر"],[287,"عسى الدهر أن ينتاشني ولعله","https://www.aldiwan.net/poem32650.html","الطويل"],[308,"لا تعجبوا منه فما حسنه","https://www.aldiwan.net/poem58085.html","السريع"],[371,"إذا ما الغزال سرى زائرا","https://www.aldiwan.net/poem17196.html","المتقارب"],[406,"يا قلب جدة","https://www.aldiwan.net/poem6704.html","عموديه"],[409,"الحمد لله الذي لا يفي","https://www.aldiwan.net/poem33643.html","السريع"],[438,"تقلب الدهر من حال إلى حال","https://www.aldiwan.net/poem12337.html","البسيط"],[447,"سعدي ونحسي بأحكام القضا سبقا","https://www.aldiwan.net/poem14290.html","البسيط"],[463,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[466,"أظن القوافي ساورتها صبابة","https://www.aldiwan.net/poem15311.html","الطويل"],[466,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[469,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[520,"أفخر فحسبك ما أوتيت من حسب","https://www.aldiwan.net/poem12019.html","البسيط"],[563,"وراء هذا الوجود عندي","https://www.aldiwan.net/poem34585.html","مخلع البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[580,"بدا له في غدانا","https://www.aldiwan.net/poem2697.html","المجتث"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38659","الطويل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96375","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62668","الرجز"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138061","الرجز"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138063","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84508","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137855",""],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49926","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122023","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48912","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124717","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27600","الهزج"],[2413,"","https://poetry.dctabudhabi.ae/diwan/poem/203138","البسيط"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107012","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100328","الوافر"],[3102,"","https://poetry.dctabudhabi.ae/diwan/poem/113895","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48323","الطويل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66320","السريع"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21382","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131008",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59499","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114401","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54494","المتقارب"],[4981,"زحفٌ نحوَ ميادين الحُبّ","https://www.poetsgate.com/ViewPoem.aspx?id=190912",""],[585,"مهلاً عليَّ فإني الموجع الدنف","https://www.poetsgate.com/ViewPoem.aspx?id=161915",""],[5452,"صدام","https://www.poetsgate.com/ViewPoem.aspx?id=119185",""],[5642,"مِسكُ الختام","https://www.poetsgate.com/ViewPoem.aspx?id=123667",""],[5703,"اللقاء الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=206134",""],[5721,"أعظم من أسلافي الأول","https://www.poetsgate.com/ViewPoem.aspx?id=215232",""],[6147,"مشروع حلال","https://www.poetsgate.com/ViewPoem.aspx?id=151492",""],[6351,"جواب يفتش عن سؤال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86046&r=&rc=6",""]],"verses":[["وَما اِتَّخَذوا إِلّا الرِماحَ سُرادِقاً","وَلا اِستَنوَروا إِلّا بِضَوءِ اللَهاذِمِ",0,"م",1,0],["وما أتعبَ المستنهضيكم فإنهم","يحثّون منكم للعلا غير محتثّ",1,"ث",1,0],["وما اتّقدت نار الحّمية منكم","لفقد اتحاد فاستطال خُمُودها",2,"د",3,0],["وما أتى بك حياً بل صَدى حُفرٍ","وهكذا تلد الأصداء والحفر",3,"ر",1,0],["وما اتخذوا مدحاً إليك وسيلةً","لأنك سيْحٌ يستقي ماءَه الفمُ",4,"م",1,0],["وَما أَتَيناكَ إِلّا","زِيارَةً لاعِيادَه",5,"د",2,0],["وما اتهامك دهرا لا اختيار له","فيما يجيء من الاحداث والازم",6,"م",1,0],["وما اتساعك منها بعد ما حسبت","عليك ضيقة الأجداث منقلبا",7,"ب",2,0],["وما أُتِيَ المغرورُ فيمن برى له","من الحزمِ لولا ما جَناهُ شَعُوبُ",8,"ب",1,0],["وما أتاني كتاب منك يأمرني","إليك يا وجه إقبالي بإقبال",9,"ل",1,1],["وَما اتُّخِذَت لِلّهوِ مِن قَبلِ داحسٍ","رِقاقُ المَواضي وَالمُسوَّمةُ الجُردُ",10,"د",1,0],["وَما أَتاني بِنُعمى ظَلتُ لابِسَها","إِلّا اِنثَنى مُسرِعاً فيها فَعَرّاني",11,"ن",2,0],["وَما اِتَّبَعتُ نَجيباً في شَمائِلِهِ","وَفي الحِمامِ تَبِعتُ السادَةَ النُجُبا",12,"ب",2,0],["وَما اِتَّخَذَ الأَبرادَ سِرحانُ قَفرَةٍ","وَلا شَبَّ ناراً أَينَ غارَ وَأَنجَدا",13,"د",2,0],["وَما أَتَوَقّى وَالخُطوبُ كَثيرَةٌ","مِنَ الدَهرِ إِلّا أَن يَحِلَّ بِيَ الهِترُ",14,"ر",1,0],["وما أتى الغَيَّ ليعصى الإلهْ","يوماً ولا كان بهِ مُغرَما",15,"م",2,0],["وما اتَّهَمْتُ بني جَزْءٍ بظِنّتِهِ","ومَا أساؤُوا وما ضاعَ الذي خَطَروا",16,"ر",3,0],["وما اتبع الشريعة في صلاةٍ","ولا صوم إذَا الأقوام صاموا",17,"م",3,0],["وَما أَتَينا ذاكَ عَن بِدعَةٍ","أَحَلَّهُ القُرآنُ لي أَجمَعا",18,"ع",2,0],["وَما أَتى مِنكَ فِعلٌ أَو أَمَرتَ بِهِ","يَستَصحِبُ اللَومَ أَو يَستَلحِقُ الفَنَدا",19,"د",2,0],["وما أتت نفحاتُ المسك ناسخة","من المكاره أنواعاً وأشكالا",20,"ل",2,0],["وَما أَتَت فاحِشَةً تَقتَضي","حَدّاً وَلا تُوجِبُ سَلبَ الخِدام",21,"م",1,0],["وما أتاك الله من فضله","فأنعم به والشخص موجود",22,"د",1,0],["وما اتهمتْ محاسنها ولكنْ","يكونُ سجيةً مرحُ الغزالِ",23,"ل",1,0],["وَمَا اتَّكَلَتْ عَلَى مَا أَسَّسُوهُ","مِنَ الْمَأْثُورِ مِنْ حَسَبٍ وَمَجْدِ",24,"د",1,0],["وَما أَتَمَنّى خالِياً لثمَ كَفِّهِ","بَلى أَتَمَنّى أَن أُقَبِّلَ رِجلَهُ",25,"ل",2,0],["وما أتى بالواو من صدغه","إلا وقد رتب في عطفه",26,"ف",2,0],["وَما أَتَّقي أَن زيفاً يَمُرُّ","بِنَقدِكَ إِلّا بَدا ظاهِرا",27,"ر",2,0],["وما أتاني غدٌ إلا بفاجعةٍ","لولا يقيني لهدّتْ كل أركاني",28,"ن",2,0],["وما أتى فيه فعندي لكم","عهد به دهري لم أخلف",29,"ف",1,0],["وما أَتَيْتَ بِبِدْعٍ يُسْتَرابُ به","هي المكارِمُ عَنْ عمٍّ وعن خال",30,"ل",1,0],["وما أتانا به من عند خالقه","حق من اللَه صدقاً ليس مختلفاً",31,"ف",2,0],["وما أتبعتُ ظُعْنَ الحيِّ طرفي","لأغنمَ نظرةً فتكونَ زادي",32,"د",2,0],["وما اتخذت غُبرَ الأداحيّ بالنَّقا","نعامُ المّلا فيها طليقٌ وراتِعُ",33,"ع",1,0],["وما أتْلع الوحش النَّوار وما جرى","بمُخترق القاعِ النِّعامُ المُصَلَّمُ",34,"م",1,0],["وما أتربت كفاهُ أفق كتابهِ","سوى أنهُ جيشٌ يسير فيرهج",35,"ج",1,0],["وما أتته من الأيام نازلة","إلا وسيفك فيها كاشف الكرب",36,"ب",1,0],["وما أتانا به كتاب","وسنة للكمال يجدي",37,"د",2,0],["وما أتى عن النبي في الأثر","عن كنت في السنة أمعنت النظر",38,"ر",1,0],["وما أتاهم عن النبي","من الإشارات إلى علي",38,"ي",1,0],["وما اتَّبعنا هَوَانا","بل اتَّبعنا هَوَاه",39,"ا",2,0],["وَما أَتْقَنَتْ نَظمَ القَريضِ قَريحة","وَمِنها بِحُسنِ السّبكِ يَحلو اِنتِظامُهُ",40,"م",2,0],["وما اتقي السَّاقَ التي تتقى بها","اذا ما تعادى الراتِكاتُ من العَقرِ",41,"ر",1,0],["وما أتى من مسلم ظاهِرهُ","كفرٌ فأوّلهُ بوجهٍ قابلِ",42,"ل",1,0],["وَما أَتى عَنْ خِيْرَةِ الرَّحْمنِ","مِنْ قَوْلِهِ أَبْنائِيَ السِّبْطانِ",43,"ن",1,0],["وَما أَتى لَمْ تَكُ رَكْعَتَيْنِ","وَقَبْلَها يُؤْتى بِخُطْبَتَيْنِ",44,"ن",1,0],["وَما أَتى مِنْ عَمَلٍ فَضائِعُ","وَإنْ بِها أَتَيْتَ فَهْوَ نافِعُ",44,"ع",1,0],["وما أتعب الماضون قبلي نفوسهم","على غير تحصيل الثواب مع الاجر",45,"ر",1,0],["وما أتى لقبضه عوضه عن","حذف له ردفا به الاصلاح عن",46,"ن",1,0],["وما أتى عن ابن أحمد أحق","في الساكنين مع محرّك سبق",46,"ق",1,0],["وما اتى الناس في ناد بذكركم","الا رأينا به العطار حيرانا",47,"ن",2,0],["وما أَتبع الأصحاب إلاّ تِعِلّةً","ولسْتُ أَرى فيهم لبيباً مهذَّبا",48,"ب",2,0],["وَمَا اتَّخَذَتْ غَيْرَ الخُيُولِ مَجَالِساً","وَمَا افْتَرَشَتْ غَيْرَ الْمَآزِقِ مِنْ مَهْدِ",49,"د",1,0],["وَمَا اتَّبَعَتْ يَوْماً قَسَنْطِينَةُ الْهَوَى","هَوَاهَا وَلاَ كَانَ التَّمَنُّعُ عَنْ عَمْدِ",49,"د",1,0],["وما أتيتُ عكاظاً أبتغى سَبَقاً","مع من أَراني ضعيفاَ عن لحاقهم",50,"م",1,0],["وما أتى الآي بتحريمه","بين ذوي الأنساب والأهل",51,"ل",1,0],["وما أتيتَ إلا من","فسادٍ كان في عقدك",52,"ك",1,0],["وما أتيت بشيءٍ لست أعرفُه","كنزُ الوفاء أعَزَّ الله مطلبَهُ",53,"ه",1,0],["وما أتى الأمران فيه جمعا","فانه ذا طرفين يدعى",54,"ع",2,0],["وما اتفقت صروف الدهر الا","على قومٍ قد اختلفت طباعا",55,"ع",2,0],["وما اتهمت يمناك إلا لتنكبي","صروحا ضخاما بالتدكدك للتحت",56,"ت",1,0],["وما اتّفقَتْ إلا على صُحْبَةِ الرّدى","كما اختَلَفَتْ آراؤُها ولُغاتُها",57,"ت",3,0],["وَمَا أتى مُخَالِفاً لِمَا مَضَى","فَبَابُهُ النَّقلُ كَسُخطٍ وَرِضَا",58,"ض",2,0],["وما أتت في الصّبح ريح الصّبا","تحمل نشر الورد والآسِ",59,"س",1,0],["وَما أَتَصَدّى لِلخَليلِ وَما أَرى","مُريداً غِنى ذي الثَروَةِ المُتَقَطِّبِ",60,"ب",1,1],["وَما أَتبَعُ الأَلوى المُدَلّي بودِّهِ","عَليَّ وَما أَنأى مِنَ المُتَقَرِّبِ",60,"ب",1,0],["وما اتل مصر بالذي هاج خاطري","لنظم القوافي بل سجايا بني مصر",61,"ر",1,0],["وما أتى في سورة الأنعام","من حكمة تُتلى ومن أحكامِ",62,"م",1,0],["وما أتى به غيرٌ إن أضيفَ لهُ","غَرفٌ من البحرِ أو رشفٌ من الديمِ",63,"م",1,0],["وما أَتمنَّى سوى قربكم","وذلك واللّهِ كلُّ المُنى",64,"ن",2,0],["وما أتيتُ بِسَيفي كي أُقارِعَهُم","بل إنَّ سيفي نَظِيرُ القلبِ يهواها",65,"ا",3,0],["وما اتخذت ورائي الذكريات خلت","كالباب يغلق خلفي ثم أنصرف",66,"ف",1,0],["وما أتينا لغزو إنّنا أمم","نرسي السّلام ونمحوا الظّلم والقهرا",67,"ر",2,0],["وما أتتْك به الأحزاب مُثنيةً","عليكَ أنك في الدُّنيا السراجُ بدا",68,"د",2,0],["وَما أتيتُ لكي أُبقيكِ في كَدَرٍ","لكنْ شَعَرتُ بأنَّ المَوتَ قد حانا",69,"ن",2,0],["وَ مَا اتَّخَذْتُ تَقَالِيدِي وَ إِنْ حَمُدَتْ","مِنْ دُونِ دِينِيَ دِيناً سَائِرَ المَثَلِ",70,"ل",1,0],["وما اتقدتْ مشاعلُنا ..وكنّا","إلى النيران يسبقنا اشتعال",71,"ل",1,0],["وما أتعس الصوت السخيّ مشرداً","يمارس -والأصداء شتّى- تسوُّلَه!",72,"ل",2,0]]}