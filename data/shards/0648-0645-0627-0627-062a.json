{"poems":[[53,"من الركب ما بين النقا والأناعم","https://www.aldiwan.net/poem29748.html","الطويل"],[88,"خليل هل من منصت فأبثه","https://www.aldiwan.net/poem44797.html","الطويل"],[88,"أما آن أن يغشى البلاد سعودها","https://www.aldiwan.net/poem44836.html","الطويل"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[70,"اليوم أنت بخير","https://www.aldiwan.net/poem42931.html","مجزوء الكامل"],[89,"حملته بين احشائي بلا برم","https://www.aldiwan.net/poem44857.html","البسيط"],[85,"فيم ابتسامك للدنيا وغايتها","https://www.aldiwan.net/poem7530.html","البسيط"],[62,"نصيحكما فيما يقول مريب","https://www.aldiwan.net/poem52505.html","الطويل"],[66,"وما أتاني كتاب منك يأمرني","https://www.aldiwan.net/poem38432.html","البسيط"],[105,"غوى الناس حتى لا صواب ولا رشد","https://www.aldiwan.net/poem43420.html","الطويل"],[52,"يا دار يا دار أطرابي وأشجاني","https://www.aldiwan.net/poem26663.html","البسيط"],[46,"إن يصحب الروح عقلي بعد مظعنها","https://www.aldiwan.net/poem22120.html","البسيط"],[46,"أرى حيوان الأرض غير أنيسها","https://www.aldiwan.net/poem22426.html","الطويل"],[46,"إذا كنت قد جاوزت خمسين حجة","https://www.aldiwan.net/poem22522.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72200","البسيط"],[130,"أرى العذال في الهيمان لاموا","https://www.aldiwan.net/poem54654.html","الوافر"],[135,"ليت هشاما عاش حتى يرى","https://www.aldiwan.net/poem67978.html","السريع"],[141,"أما الزمان فقد ألزمته الجددا","https://www.aldiwan.net/poem11751.html","البسيط"],[145,"الحمد لله تعظيما وإجلالا","https://www.aldiwan.net/poem47640.html","البسيط"],[167,"قم فاسقنيها قبل صوت الحمام","https://www.aldiwan.net/poem1679.html",""],[184,"كل قبل أن يأكلك الدود","https://www.aldiwan.net/poem43950.html","السريع"],[197,"بدت قمرا له حظي ليالي","https://www.aldiwan.net/poem45380.html","الوافر"],[235,"سقى أم العلاء وبنت مجد","https://www.aldiwan.net/poem18178.html","الوافر"],[280,"عسى الدهر أن ينتاشني ولعله","https://www.aldiwan.net/poem32650.html","الطويل"],[301,"لا تعجبوا منه فما حسنه","https://www.aldiwan.net/poem58085.html","السريع"],[364,"إذا ما الغزال سرى زائرا","https://www.aldiwan.net/poem17196.html","المتقارب"],[397,"يا قلب جدة","https://www.aldiwan.net/poem6704.html","عموديه"],[400,"الحمد لله الذي لا يفي","https://www.aldiwan.net/poem33643.html","السريع"],[429,"تقلب الدهر من حال إلى حال","https://www.aldiwan.net/poem12337.html","البسيط"],[438,"سعدي ونحسي بأحكام القضا سبقا","https://www.aldiwan.net/poem14290.html","البسيط"],[456,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[459,"أظن القوافي ساورتها صبابة","https://www.aldiwan.net/poem15311.html","الطويل"],[459,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[462,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[513,"أفخر فحسبك ما أوتيت من حسب","https://www.aldiwan.net/poem12019.html","البسيط"],[556,"وراء هذا الوجود عندي","https://www.aldiwan.net/poem34585.html","مخلع البسيط"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"بدا له في غدانا","https://www.aldiwan.net/poem2697.html","المجتث"]],"verses":[["وَما اِتَّخَذوا إِلّا الرِماحَ سُرادِقاً","وَلا اِستَنوَروا إِلّا بِضَوءِ اللَهاذِمِ",0,"م",1,0],["وما أتعبَ المستنهضيكم فإنهم","يحثّون منكم للعلا غير محتثّ",1,"ث",1,0],["وما اتّقدت نار الحّمية منكم","لفقد اتحاد فاستطال خُمُودها",2,"د",3,0],["وما أتى بك حياً بل صَدى حُفرٍ","وهكذا تلد الأصداء والحفر",3,"ر",1,0],["وما اتخذوا مدحاً إليك وسيلةً","لأنك سيْحٌ يستقي ماءَه الفمُ",4,"م",1,0],["وَما أَتَيناكَ إِلّا","زِيارَةً لاعِيادَه",5,"د",2,0],["وما اتهامك دهرا لا اختيار له","فيما يجيء من الاحداث والازم",6,"م",1,0],["وما اتساعك منها بعد ما حسبت","عليك ضيقة الأجداث منقلبا",7,"ب",2,0],["وما أُتِيَ المغرورُ فيمن برى له","من الحزمِ لولا ما جَناهُ شَعُوبُ",8,"ب",1,0],["وما أتاني كتاب منك يأمرني","إليك يا وجه إقبالي بإقبال",9,"ل",1,1],["وَما اتُّخِذَت لِلّهوِ مِن قَبلِ داحسٍ","رِقاقُ المَواضي وَالمُسوَّمةُ الجُردُ",10,"د",1,0],["وَما أَتاني بِنُعمى ظَلتُ لابِسَها","إِلّا اِنثَنى مُسرِعاً فيها فَعَرّاني",11,"ي",1,0],["وَما اِتَّبَعتُ نَجيباً في شَمائِلِهِ","وَفي الحِمامِ تَبِعتُ السادَةَ النُجُبا",12,"ب",2,0],["وَما اِتَّخَذَ الأَبرادَ سِرحانُ قَفرَةٍ","وَلا شَبَّ ناراً أَينَ غارَ وَأَنجَدا",13,"د",2,0],["وَما أَتَوَقّى وَالخُطوبُ كَثيرَةٌ","مِنَ الدَهرِ إِلّا أَن يَحِلَّ بِيَ الهِترُ",14,"ر",1,0],["وما أتى الغَيَّ ليعصى الإلهْ","يوماً ولا كان بهِ مُغرَما",15,"م",2,0],["وما اتَّهَمْتُ بني جَزْءٍ بظِنّتِهِ","ومَا أساؤُوا وما ضاعَ الذي خَطَروا",16,"ر",3,0],["وما اتبع الشريعة في صلاةٍ","ولا صوم إذَا الأقوام صاموا",17,"م",3,0],["وَما أَتَينا ذاكَ عَن بِدعَةٍ","أَحَلَّهُ القُرآنُ لي أَجمَعا",18,"ع",2,0],["وَما أَتى مِنكَ فِعلٌ أَو أَمَرتَ بِهِ","يَستَصحِبُ اللَومَ أَو يَستَلحِقُ الفَنَدا",19,"د",2,0],["وما أتت نفحاتُ المسك ناسخة","من المكاره أنواعاً وأشكالا",20,"ل",2,0],["وَما أَتَت فاحِشَةً تَقتَضي","حَدّاً وَلا تُوجِبُ سَلبَ الخِدام",21,"م",1,0],["وما أتاك الله من فضله","فأنعم به والشخص موجود",22,"د",1,0],["وما اتهمتْ محاسنها ولكنْ","يكونُ سجيةً مرحُ الغزالِ",23,"ل",1,0],["وَمَا اتَّكَلَتْ عَلَى مَا أَسَّسُوهُ","مِنَ الْمَأْثُورِ مِنْ حَسَبٍ وَمَجْدِ",24,"د",1,0],["وَما أَتَمَنّى خالِياً لثمَ كَفِّهِ","بَلى أَتَمَنّى أَن أُقَبِّلَ رِجلَهُ",25,"ل",2,0],["وما أتى بالواو من صدغه","إلا وقد رتب في عطفه",26,"ف",2,0],["وَما أَتَّقي أَن زيفاً يَمُرُّ","بِنَقدِكَ إِلّا بَدا ظاهِرا",27,"ر",2,0],["وما أتاني غدٌ إلا بفاجعةٍ","لولا يقيني لهدّتْ كل أركاني",28,"ي",1,0],["وما أتى فيه فعندي لكم","عهد به دهري لم أخلف",29,"ف",1,0],["وما أَتَيْتَ بِبِدْعٍ يُسْتَرابُ به","هي المكارِمُ عَنْ عمٍّ وعن خال",30,"ل",1,0],["وما أتانا به من عند خالقه","حق من اللَه صدقاً ليس مختلفاً",31,"ف",2,0],["وما أتبعتُ ظُعْنَ الحيِّ طرفي","لأغنمَ نظرةً فتكونَ زادي",32,"ي",1,0],["وما اتخذت غُبرَ الأداحيّ بالنَّقا","نعامُ المّلا فيها طليقٌ وراتِعُ",33,"ع",1,0],["وما أتْلع الوحش النَّوار وما جرى","بمُخترق القاعِ النِّعامُ المُصَلَّمُ",34,"م",1,0],["وما أتربت كفاهُ أفق كتابهِ","سوى أنهُ جيشٌ يسير فيرهج",35,"ج",1,0],["وما أتته من الأيام نازلة","إلا وسيفك فيها كاشف الكرب",36,"ب",1,0],["وما أتانا به كتاب","وسنة للكمال يجدي",37,"ي",1,0],["وما أتى عن النبي في الأثر","عن كنت في السنة أمعنت النظر",38,"ر",1,0],["وما أتاهم عن النبي","من الإشارات إلى علي",38,"ي",1,0],["وما اتَّبعنا هَوَانا","بل اتَّبعنا هَوَاه",39,"ا",2,0]]}