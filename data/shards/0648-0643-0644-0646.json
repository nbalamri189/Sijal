 للموت ساير طالت او قصرت سنينه","التراب يعود لأصله ثم يبعث من ترابه",164,"ب",2,0],["وكَّلَني باللغةِ المكتومةِ في الصدرِ","وحنينِ التُّفَّاحةِ للأمِّ.",165,"م",1,0],["وكلنا فوقها رهن الزوال فلا","أضل بعد الكفى من سعي مزداد",166,"د",1,0],["وكل نثر جرى في فيه كان لنا","مثل الينابيع في آذاننا شنف",167,"ف",1,0],["وكلنا في بلاد الله لاجئها","وليس من موطن يحمي بني العرب",168,"ب",1,0],["وكل نور لظلِّها صورٌ","وكل عطرٍ لوردِها نهَرُ",169,"ر",1,0],["وكلنا يا أمتي ظامىءٌ","ودون هذا المنحنى المنهل ..",170,"ل",1,0],["وكل نجوم هدى من علاك","بها قلت فالمثل السائر",171,"ر",1,0],["وكلّنّا مبتهجٌ مُمْتَطٍ","طِرفاً يفوتُ الطَّرفَ خطَّارا",172,"ر",2,0]]}