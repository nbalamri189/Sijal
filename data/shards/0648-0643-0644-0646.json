iewPoem.aspx?id=165350",""],[5786,"حتّامَ دمعك في الأطلال ينسكبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50654",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[5818,"وما متعة العيش إلّا لحلْمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=199692",""],[5845,"لكلِّ خطبٍ مهمٍّ حسبيَ اللهُ","https://www.poetsgate.com/ViewPoem.aspx?id=198425",""],[5861,"معزوفة الجحيم","https://www.poetsgate.com/ViewPoem.aspx?id=188090",""],[5874,"ذئبةُ الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=202082",""],[192,"فهد بن سلمان","https://www.poetsgate.com/ViewPoem.aspx?id=16371",""],[6124,"كوب الشاي","https://www.poetsgate.com/ViewPoem.aspx?id=159640",""],[186,"يا ليت شعري هل تدرين موضعنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55746&r=&rc=9",""],[6202,"رسالة إلى الكبيسي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86725&r=&rc=26",""],[6202,"لقاء العيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86750&r=&rc=51",""],[6225,"قوسُ الحنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80920&r=&rc=189",""],[5616,"إلى متى ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1928&r=&rc=3",""],[6352,"كذا يظهر المعجز الباهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22746&r=&rc=7",""],[572,"لستُ على عذلِكَ صَبَّارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9316&r=&rc=173",""]],"verses":[["وَكُلُّ نَحيلَةٍ كَالسَهمِ تُصمي","عَرانينَ الأَماعِزِ وَالخُرومِ",0,"م",1,0],["وَكُلُّ نَؤوجٍ يَنبَري مِن جُنوبِها","بِتَسهاكِ ذَيلٍ مِن فُرادى وَمُتئِمِ",1,"م",1,0],["وكلنا منتثرٌ لحمهُ","وهو على كانونه قد طبخ",2,"خ",1,0],["وكلن عريقاً في المناصب بيته","مكيناً إذا ما قيل كافٍ وكافل",3,"ل",1,0],["وكل نعمى غير مشكورة","رهن زوال بعد تمحيق",4,"ق",1,0],["وَكُلُّ نَهارٍ لا يَكُنَّ شُموسَهُ","فَذَلِكَ لَيلٌ حالِكٌ وَطَويلُ",5,"ل",1,0],["وكلُّنا في الحَيَاةِ أعمى","يَسُوقهُ زَعْزَعٌ عَقِيمْ",6,"م",1,0],["وَكُلُّ نَيروزٍ بِمَصرٍ رائِعٍ","أَو مِهرَجانٍ ذائِعٍ هُمُ الأَلى",7,"ا",1,0],["وَكُلُّ نَفسٍ في غَدٍ","مَيِّتَةٌ فَمُنشَرَه",8,"ر",2,0],["وَكُلُّنا إِن أَخَذنا بِالفَلاحِ يَدٌ","وَسَعَينا قَدَمٌ فيهِ إِلى قَدَمِ",9,"م",1,0],["وكُلُّ نَفْسٍ لحَيْنِها سَبَبٌ","يَسْرِي إِليها كَهَيْئَةِ اللّعِبِ",10,"ب",1,0],["وَكُلِّ نَجاةٍ بُجاوِيَّةٍ","خَنوفٍ وَما بِيَ حُسنُ المِشى",11,"ا",1,0],["وَكُلُّ نَجلاءَ لَها صائِكٌ","يَخضُبُ ما بَينَ يَدي وَالسِنان",12,"ن",1,0],["وكلُّ ناحيةٍ منه زَبَرْجَدَةٌ","أجرى اللُّجَيْنُ عليها جدولاً سَرِبا",13,"ب",2,0],["وَكُلُّ ناصِرِ دُنيا سَوفَ تَخذُلُهُ","وَكُلُّ حَبلٍ عَلَيها سَوفَ يَنقَطِعُ",14,"ع",1,0],["وَكُلِّ نَجيباتِ هِجانٍ كَأَنَّها","إِذا رَدَعَت مِنها الخِشاشَةُ طالِعُ",15,"ع",1,0],["وَكُلُّنا في مَساعيهِ أَبو لَهبٍ","وَعِرسُهُم لَم يَقَع في جَيدِها مَسَدُ",16,"د",1,0],["وَكُلُّنا قَومُ سوءٍ لا أَخِصُّ بِهِ","بَعضَ الأَنامِ وَلَكِن أَجمَعُ الفِرقا",17,"ق",2,0],["وَكِلْنِي إِلى هَمِّي فَإِنِّي غَرِيقَةٌ","بِبَحْرٍ مِنَ الآلامِ وَالذُّلِّ مُتْرَعِ",18,"ع",1,0],["وَكُلُّ نَضِيرَةٍ فَإِلَى ذُبُولٍ","وَكُلُّ مُضِيئَةٍ فَإِلى انْطِفَاءِ",19,"ا",2,0],["وكلُّ نعمى غيرُ مشكورة ٍ","عن أمِّه ذاتِ البساتيق",20,"ق",1,0],["وكلّ نهدٍ . .أنا أيدت ثورته","وما ترددت في أن أدفع الثمنا",21,"ن",2,0],["وَكَلُّ نَدىً إِلى جَدواكَ يُعزى","كَما تُعزى إِلى الغَيثِ المُدودُ",22,"د",1,0],["وَكُلُّ نَعيمٍ بِالنَبيِّ يُسَوَّغُ","بِهِ اِبتُلَيت مِنّا العُقولُ وَتُبتَلى",23,"ل",2,0],["وَكُلُّ نَفيسٍ كانَ حَشوَ قُصُورِنا","عَدَلناهُ عَنّا فَاِحتَوَتهُ خِيامُها",24,"م",3,0],["وكلّ نجيبةٍ هوجاءَ تهفو","سوابقُها بإرخاء الزمام",25,"م",1,0],["وكلُّنا صائرٌ يوماً لمصرعهِ","إن الذي هو سؤانا يُساوينا",26,"ن",2,0],["وكلُّ نساءِ الشرقِ ساوينَ في الرضا","بذاكَ رجالَ المغربِ العلماءُ",27,"ا",2,0],["وكلُّ نارٍ إذا لم","تصادفِ الريحَ تخبو",28,"ب",2,0],["وكلنا في عناءِ","فمن إذنْ يَسترِيحُ",29,"ح",1,0],["وكلُّ نارٍ فمن أنفاسِهم قدحت","وكل ماءٍ فمن دمعٍ لهم جاري",30,"ر",2,0],["وَكُلُّ نَفسِ اِمرِئٍ وَإِن سَلِمَت","يَوماً سَتَحسو لِميتَةٍ جُرَعا",31,"ع",2,0],["وكلني في الحساب إلى إله","يسامحني إذا وضع الحسابُ",32,"ب",1,0],["وكلّنا موتى كذا","عند انتهاء الأجل",33,"ل",1,0],["وَكُلُّنا نَرتَجي النَجاةَ غَداً","وَاللَهُ مِمّا أَخافُ يُنجيني",34,"ن",2,0],["وَكُلّ نَهرٍ حَصباؤُهُ دُرَرٌ","جَرَى عَلَيهِنَّ ذَوبُ كافورِ",35,"ر",1,0],["وكل نسيم هب أو بارق سري","وأشيا أرى في سترها حفظ حرمة",36,"ه",1,0],["وَكُلُّنا قالَ تَبريكاً","يُؤَرِّخُهُ عُدتُم بِيُمنٍ في العُلا رُتَبا",37,"ب",2,0],["وكلنا عبث","وحالنا عجب",38,"ب",1,0],["وَكُلُّ نَفس سَتُجزى بِالَّذي اِكتَسَبت","فَاِعجَب لِأَسواءِ أَخلاق لهم نسِيت",39,"ت",1,0],["وكلُّ نُعمَى غَدتْ","من كَفّه تُستَفاد",40,"د",1,0],["وكلَّ نَحِيضٍ فَتيقِ الغِرارِ","عَزُوفٍ على ظُفُرِ الرائشِ",41,"ش",1,0],["وكلُّنا بكِ صَبٌّ فانظُري حَسَناً","ما بَيننا واسعِفي بالوَصلِ أولانا",42,"ن",2,0],["وكل نصار للشرع أنصره يابار","منا وأفضال يا ذا الجود والأجلال",43,"ل",1,0],["وكلٌ نال في الأمجاد سهم","فما أسمى وما أغلى السِّهما",44,"م",2,0],["وكل نار للهوى أضرمت","فإنما تقدح من زنده",45,"د",2,0],["وكلُّ نارِ حريقٍ","يُخشى لظاها سَتَخْبو",46,"ب",2,0],["وكلنا بهوى دنياه مشتغلٌ","بها له ثم تأخيرٌ وتقديم",47,"م",1,0],["وكلنا يوم هذا العيد أمته","إن العروبة إيمان وأوطان",48,"ن",1,0],["وكُّلنا أينما قد عاشَ مُغتربٌ","وكلنا أينما يَبتل ظمآن",49,"ن",1,0],["وكُّلنا يستقل التضحيات له","وكم يُعاني ولكن وهو نشوان",49,"ن",1,0],["وكل نطقه ينبيك منه","كما ينبي عن الخيل الصهيل",50,"ل",1,0],["وَكُلُّ ناعورَةٍ في الرَوضِ قَد نَعَرَت","كَغادَةٍ هَزَّها مِن سُكرِها طَرَبُ",51,"ب",1,0],["وكل نصوص أوهمت غير ما افتضا","ه منصبه الأسنى تؤوّل تسعد",52,"د",1,0],["وكلني بالهم والكآبة","طَعّانَةٌ لعانةٌ سَبَّابَهْ",53,"ه",1,1],["وكلُّ نشأَةِ غيبٍ تُلْفِ صاحِبَها","والمُخلِصونَ لأهلِ الحقِّ خُلاَّنُ",54,"ن",1,0],["وكلُّ ناثِرِ دُرٍّ دونَ ناثِرِنا","وكلُّ شاعِرِ ذَوْقٍ دونَ شاعِرِنَا",55,"ن",2,0],["وَكُلُّ نَفسٍ عَلى سَلامَتِها","يُميتُها اللَهُ ثُمَّ يَبرَؤُها",56,"ه",2,1],["وكلُّ ناءٍ وإنْ شطّ الِبعادُ به","تناله من بهاءِ الدّولةِ الهِممُ",57,"م",1,0],["وكلّنا يَكرع صِرْفَ الرّدى","إمّا طويلَ اللَّبْثِ أو مُعْجَلا",58,"ل",2,0],["وكلَّ نجمٍ بالدّجَى ساطعٍ","يرميه نحو المغربِ المشرقُ",59,"ق",1,0],["وكلّ نُسكٍ تلقّاه القبولُ فما","أَمسى وأَصبحَ إلّا غيرَ مردودِ",60,"د",1,0],["وكلنا نحن عبيده وقد","أكرمنا بالملة المرضيه",61,"ي",2,0],["وكلنا لم نزل في علمه أبداً","وعلمه ذاته بل علمه الأبد",62,"د",1,0],["وكلٌّ نحارير فإِن عرضَت لهم","زَخَارِفُ هذِي الدارِ فالكُلُّ أَغْمَارُ",63,"ر",1,0],["وَكُلُّ نابِغَةٍ في الشِعرِ مُلتَمِسٌ","مِن كَأسِهِ رَشَفاتٍ كَي يُبَل ظَما",64,"م",2,0],["وكل نذلٍ به ارتفاعٌ","وكل حرٍّ به اتضاع",65,"ع",1,0],["وَكِلني إلَى وجدٍ سَرى في حَشاشَتي","أوائِلُه مَسمُومَةٌ وأواخِرُه",66,"ر",2,0],["وكلنا منتظر لذاكا","لو قلت هاتوا قلت هاك هاكا",67,"ك",2,0],["وكلُّ نَعيمٍ أرتجي في يَدَيْهمُ","ولما رأيتُ العَيْشَ غَضّاً لَديهمُ",68,"م",1,0],["وكلنا جزاء الغادرين لغدرهم","وكل امرىء منا سيجزيه فعله",69,"ل",2,0],["وكلُّنا من نَمَطٍ واحدٍ","في الزيِّ والمذهب والمنطق",70,"ق",1,0],["وَكلنا يَرتَقِب القتالا","ممتَثِلاً بِقَوله تَعالى",71,"ل",2,0],["وَكلّ نَرجِسَةٍ لا شَكَّ تَحسَبُها","شَمساً لَقَد ظَهَرَت في أَوسَطِ القمرِ",72,"ر",1,0],["وَكُلنا بالظلم فيكُم نَعتَرف","وَمِن بِحار البَغي كُنا نَغتَرف",73,"ف",1,0],["وَكُلنا مِن مَرضٍ نَفديك","حاشا فدا القَوم يَكون فيكَ",73,"ك",1,0],["وَكلّ ُنبيّ ٍله ُتابعُون","وكلّ ُنبيّ ٍله ُما يَشاءُ",74,"ا",2,0],["وكل نبع قصة عن هوى","يسكر بالجود وبالتضحيات",75,"ت",1,0],["وكلّ نجومٌ لكن الفرق أنها","تغيبُ صباحاً وهي في الصبحِ تطلعُ",76,"ع",1,0],["وكلنا شاك وباك على","تكاد لا تمسكها الأضلع",77,"ع",1,0],["وكل نوع منهما في اثني عشر","إن كان للأنثى وإلا للذكر",78,"ر",1,0],["وكل نوع التزمته لزم","في كل بيت كالضروب قد حتم",79,"م",1,0],["وكل نوع منهما أسسه أو","أردفه أو جرده مثل ما قفوا",79,"ف",3,0],["وكلُ نفسٍ رهن بها كسَبت","وكاسب السوء رهنه غَلقُ",80,"ق",1,0],["وكل نبي خصّ بالبعث قومه","وبعثه خير الخلق للناس عمّت",81,"ت",1,0],["وكلٌّ نجومُ هدًى من عُلاك","بها فلكٌ بالهنا دائر",82,"ر",1,0],["وكل \"نوال ه\"امل من بنانه","فأقصى صفات الجود \"قد جاز\" جودُه",83,"د",2,0],["وكل ناظم شعرٍ فيه مقصده","وأنت تعلم مقصود الذي نظما",84,"م",2,0],["وَكَّلْنَهُ بنُجوم الليل يَرْقُبُها","في أُفْقِهنَّ صَباباتٌ وأَحْزانُ",85,"ن",1,0],["وكلنا رامٍ مجيد فارسُ","تصعق من سوراتنا الفوارسُ",86,"س",1,0],["وكلنا أ