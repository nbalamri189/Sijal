{"poems":[[68,"دق شوال في قفا رمضان","https://www.aldiwan.net/poem39193.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54766","الكامل"],[189,"إيه على تذكار ما سلفا","https://www.aldiwan.net/poem14591.html","أحذ الكامل"],[280,"نادتك أندلس فلب نداءها","https://www.aldiwan.net/poem25647.html","الكامل"],[447,"هذي المنازل ها هيه","https://www.aldiwan.net/poem14399.html","مجزوء الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94289","الخفيف"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110746","الخفيف"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86277","الكامل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101237","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123484","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90884","الخفيف"],[4829,"ولاد المضا","https://www.poetsgate.com/ViewPoem.aspx?id=36743",""],[4858,"سيدي يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=34882",""],[5273,"القوام يأتلق","https://www.poetsgate.com/ViewPoem.aspx?id=181461",""],[5273,"القوام يأتلق","https://www.poetsgate.com/ViewPoem.aspx?id=215882",""],[5561,"أمّةُ الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=192741",""],[5732,"يا ناشد العراف","https://www.poetsgate.com/ViewPoem.aspx?id=177831",""],[5770,"سأزف للموتى بشارة","https://www.poetsgate.com/ViewPoem.aspx?id=178250",""]],"verses":[["وَاليَراعُ الَّذي يَزيدُ بِقَطعِ ال","رَأسِ نُطقاً مِن بَعدِ شَقِّ اللِسانِ",0,"ن",1,0],["وَالى رِعَايَتَهَا وَفِي أَيَّامِهِ","لِمْ يُبْطَلِ التَّأْسِيسُ وَالتَّشْييد",1,"د",1,0],["وإلى رياضٍ كان يوقِظني","فيها ندى سَحَرٍ إذا كَثُفا",2,"ف",2,0],["وإلى رُبىً وأباطِحٍ لَمْ تَعْرَ مِنْ","خلَعِ الرّبيع مصيفَها وشِتاءَها",3,"ا",3,0],["وإلى رضاك فاهدني","واجعل متابك زاديه",4,"ي",2,0],["وإلى ربك اشك لوعة صب","مثلها من لظى الصبابة يشكي",5,"ك",2,0],["وإلى ربهم تقدّسَ عزّا","فقراء وهم به أغنياءُ",6,"ا",2,0],["وَإِلى رَعاياهُ يَحن فُؤادُهُ","كَأَبٍ شَفوق قَلبَهُ يَتَأَثَّرُ",7,"ر",1,0],["وإلى ربوع العلم بات فؤاده","يشكو الغرام وأين عنه ربوعه",8,"ع",2,0],["وإلى رياض هضاب سيميسٍ","فيبوس مال وآرسٌ عرجا",9,"ج",2,0],["والى ركنك منه ألتجى","والى حصنك سمت الهربا",10,"ب",2,0],["واليراعات في أنامله تبدي ال","براعات طرسها للعيان",11,"ن",1,0],["والّي رفع سبع(ن)وهبّط سبع(ن)","لو قافي يعصاني شلقت (أ)هدومي",12,"م",2,0],["والّي رفع ذكر الخوالد حتّى","بأقدامهم داسوا على لنجومي",12,"م",2,0],["وإلى رياضك جاء يسعى جمعنا","وإلى رياضكِ رحلةُ السّعَداءِ",13,"ا",2,0],["واليراعُ سافَرَ بي","حيثُ بِتُّ أحتَرِقُ",14,"ق",1,0],["واليراعُ سافَرَ بي","حيثُ يُرتجى العبَقُ",15,"ق",1,0],["واليرتضي لَيَّ الرِّقابِ لغاصبٍ","ستدوسُهُ أقدامُه بحذاءِ",16,"ا",2,0],["وإلى رخص سعرك مع الربع تمتاز","وإلى على سعرك يبيعونك ارخيص",17,"ص",1,0],["وإلى ربوع الشآمِ تسبقها وتحفزها إثارة","لتعانق العاصي وتنثرَ وردها القاني جواره",18,"ر",2,0]]}