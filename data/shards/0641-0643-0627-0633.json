{"poems":[[32,"دنا البين من مي فردت جمالها","https://www.aldiwan.net/poem29539.html","الطويل"],[39,"فكاسمك أنت اليوم من غير جفوة","https://www.aldiwan.net/poem7422.html","الطويل"],[170,"يذكرني الحمى عهد الوصال","https://www.aldiwan.net/poem46897.html","الوافر"],[173,"إلى م أرجي ضر عيش منكدا","https://www.aldiwan.net/poem1615.html",""],[259,"ضيقت الخناق","https://www.aldiwan.net/poem25019.html","مجزوء الرمل"],[287,"فك أسري طيف لعلوة أسرى","https://www.aldiwan.net/poem32769.html","الخفيف"],[510,"الراحل","https://www.aldiwan.net/poem61092.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69931","الوافر"],[5002,"آخر جواب....","https://www.poetsgate.com/ViewPoem.aspx?id=206089",""],[5121,"كأس الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=33579",""],[5121,"كَأْسُ الْحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=183757",""],[5725,"يناوحني الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=208841",""]],"verses":[["فَكَأسُ اِمرِئِ القَيسِ الَّتي يَشرَبونَها","حَرامٌ عَلى القَومِ الكِرامِ فِضالُها",0,"ل",3,0],["فكاسمك أنت اليوم من غير جفوة","ولا عنف في الحكم بالسَّم والسَّمْلِ",1,"ل",1,1],["فكأسٌ في اليّمينِ يَميلُ مِنْها","إلى طربٍ وكيسٌ في الشمالِ",2,"ل",1,0],["فَكاسٌ إِذا أُسقي بِها اليَومَ مُكرَهاً","أَخوكَ سَتُسقى مِن فُضالَتِها غَدا",3,"د",2,0],["فُكَّ أسري،ضاع عمري","نحنُ ضيّعنا السباقَ",4,"ق",1,0],["فَكَّ أَسري طَيفٌ لعَلوَةَ أَسرى","ساءَني مُعرِضاً وَعادَ فَسَرّا",5,"ر",2,1],["فكأساً وهَبْتنا لخيرٍ فلا أدَمْ","تها إنْ ملأناها بظلمٍ عهدناهُ",6,"ن",3,0],["فكاساتها الأكياس والكيس مزجها","وفي دنها الداني تدلت فأدنت",7,"ت",1,0],["فَكاس الراح بالافراح دارَت","وَخازنها قُلوب الناس راقِ",8,"ق",1,0],["فكأسِي شهْدُهُ صافٍ زلالٌ","وكأسُكَ من مرارٍ في الشَّرابِ",9,"ب",1,0],["فكأسُ الحياةِ شرابٌ ليروي","خلودَ القلوبِ بذِكْرٍ فَصوحِ",10,"ح",1,0],["فَكَأَسُ الْحُبِّ عَامِرَةٌ وَرَشْفَتُهَا","كَطَعْمِ الْهَمْسِ إِمَّا انْصَبَّ فِي الْحُلُقِ",11,"ق",1,0],["فكأس الخمر اولها رضوخٌ","وآخر بوحها سرٌّ فضوحُ",12,"ح",1,0]]}