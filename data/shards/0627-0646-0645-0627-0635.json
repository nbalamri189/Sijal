{"poems":[[95,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[53,"زعم الناس خالدا بغاء","https://www.aldiwan.net/poem7979.html","الخفيف"],[53,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[53,"لا تشم للمزن برقا","https://www.aldiwan.net/poem65494.html","مجزوء الرمل"],[46,"وثناياك إنها إغريض","https://www.aldiwan.net/poem30475.html","الخفيف"],[48,"أعوز الشث والسلم","https://www.aldiwan.net/poem23436.html","مجزوء الخفيف"],[108,"حفظ الله صالحًا","https://www.poetsgate.com/ViewPoem.aspx?id=179358",""],[132,"من لصب تصاعدت حسراته","https://www.aldiwan.net/poem50653.html","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70769","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49088","الخفيف"],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142907","الخفيف"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32470","الخفيف"],[4988,"مدرسة دنياي","https://www.poetsgate.com/ViewPoem.aspx?id=214087",""],[5186,"\"أصلح الله يا \"\"أسيمى\"\" عقولا","https://www.poetsgate.com/ViewPoem.aspx?id=156507",""],[5458,"لن يظل الورد ذابل","https://www.poetsgate.com/ViewPoem.aspx?id=113361",""],[5908,"هل لقلب المتيم المتبول","https://www.poetsgate.com/ViewPoem.aspx?id=170976",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""]],"verses":[["إِنَّمَا صَانَكَ الثَّبَاتُ عَلَى رَأْ","يٍ تُفَدِّيهِ وَالثَّبَاتُ يَصُونُ",0,"ن",1,0],["إنما صادفوه يَلْمَس غُرمو","لاً فواراه في استِهِ استحياءَ",1,"ا",2,0],["إنما صاحبي المُشارك في القُل","ل وذو البذل والندى والحياءِ",2,"ا",2,0],["إنما صادف درّاً","في بحور فتنقّى",3,"ق",2,0],["إِنَّما صادَتِ البُحورُ بُحوراً","إِنَّها كُلَّما اِستُفيضَت تَفيضُ",4,"ض",1,0],["إِنَّما صاحِبُ التُقى","تاجِرٌ يَدفَعُ السَلَم",5,"م",1,0],["إنما صالحٌ بقيةُ قومٍ","بالمعالي نفوسُهُم مُسْتَهَامة",6,"م",2,0],["إنما صاغَةُ القريض قليلٌ","وكثيرٌ رُواتُه وشُداتُه",7,"ت",2,0],["إنما صاحبُ المروءةِ ذِمْرٌ","لا يُؤاذي وجاره لا يؤاذي",8,"ذ",2,0],["إنما صاحبُ الصفاءِ","صاحبُ المبدإ القَويمْ",9,"م",1,0],["إنما صدمة الفراق التياع","أسأل المستعان أن ينجابا",10,"ب",2,0],["إِنَّما صاحِبي الَّذي يَغفِرُ الذَن","بَ وَيَكفيهِ مِن أَخيهِ أَقَلُّهُ",11,"ل",2,0],["ان ما صرت كالزير ل اتصير جساس","واتجنب اللي في فعوله خماجه",12,"ج",2,0],["إنما صبرها الجميل كفيل","بانتصار الهدى، فصبرا جميلا",13,"ل",2,0],["إنما صهيون هذا عارض لا بد زائل","فاطمئني يا سليمى لن يظل الورد ذابل",14,"ل",1,0],["إنما صادق المودة حقا","من يوفي الخليل حق الخليل",15,"ل",1,0],["إِن ما صبرت يضيع عمرك مِن العَنا","وَمالك جزا غير الشَقا وَالعار",16,"ر",1,0]]}