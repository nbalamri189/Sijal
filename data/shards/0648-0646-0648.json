53,"بكرت عنادل روضنا","https://www.aldiwan.net/poem13751.html","مجزوء الكامل"],[454,"رمضان يا حلو الشمائل","https://www.aldiwan.net/poem61335.html","مجزوء الكامل"],[454,"الشاعر القروي في تكريمنا","https://www.aldiwan.net/poem61569.html","الكامل"],[455,"بني اهتدوا في ما اهتديت سبيله","https://www.aldiwan.net/poem712.html",""],[459,"انظر معي فهي نظرة أمم","https://www.aldiwan.net/poem55899.html","المنسرح"],[459,"على أي لائمة أربع","https://www.aldiwan.net/poem56136.html","المتقارب"],[459,"هل تقبلون إنابة الدهر","https://www.aldiwan.net/poem56194.html","أحذ الكامل"],[462,"أجل ما رمت في آت مقتبل","https://www.aldiwan.net/poem15134.html","البسيط"],[462,"أظن ظلام الحظ حان نصوله","https://www.aldiwan.net/poem15389.html","الطويل"],[462,"ضروب قذال القرن فذا لدى الوغى","https://www.aldiwan.net/poem16039.html","الطويل"],[464,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[465,"رمتني بنجل والسهام جفون","https://www.aldiwan.net/poem3591.html","عموديه"],[469,"جمالي وزيني إذا ما حضر","https://www.aldiwan.net/poem59983.html","المتقارب"],[478,"أشد الهوى ما يمنع العين أن تكرى","https://www.aldiwan.net/poem15349.html","الطويل"],[483,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[496,"حتت جوامعي يا جمع حتا","https://www.aldiwan.net/poem9797.html","الوافر"],[501,"لحزبك في أقصى المهامه رابات","https://www.aldiwan.net/poem37719.html","الطويل"],[501,"ما رفرف السعد إلا في محاضرنا","https://www.aldiwan.net/poem37998.html","البسيط"],[501,"رغبنا بأسرار الشهود لوجهكم","https://www.aldiwan.net/poem38082.html","الطويل"],[507,"صلاح الدين انت له نظام","https://www.aldiwan.net/poem2399.html","الوافر"],[515,"محاسنك للعقول الراسخة تدهشن","https://www.aldiwan.net/poem20908.html","المواليا"],[530,"إذا جاش بحر الحشر كانت سفائني","https://www.aldiwan.net/poem37279.html","الطويل"],[530,"إذا نظمت سموط الجمع قوما","https://www.aldiwan.net/poem37452.html","الوافر"],[541,"أفي طلل قفر تحمل آهله","https://www.aldiwan.net/poem56713.html","الطويل"],[552,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[552,"ألم تسأل الطلل الدارسا","https://www.aldiwan.net/poem47752.html","المتقارب"],[559,"صدقت عباد الله أسماؤه الحسنى","https://www.aldiwan.net/poem33741.html","الخفيف"],[559,"في الكون للحق أمثال بها نطقا","https://www.aldiwan.net/poem34300.html","البسيط"],[564,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[565,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"لقد شيبتني في الزمان خطوبه","https://www.aldiwan.net/poem2765.html","الطويل"],[576,"ونون صدغ زادني جنة","https://www.aldiwan.net/poem2853.html","السريع"],[587,"وافى وأرواح العذيب نواسم","https://www.aldiwan.net/poem17701.html","الكامل"]],"verses":[["وَنَوائِبُ الأَيّامِ يَط","رُقنَ الوَرى بيضاً وَشيما",0,"م",2,0],["وَنَواظِرٌ كَحَلَ التُرابُ جُفونَها","قَد كُنتُ أَحرُسُها مِنَ الأَقذاءِ",1,"ا",2,0],["وَنوحي ما بَدا لكِ أَن تَنوحي","وَحِنّي ما اِستَطَعتِ وَشَوِّقينا",2,"ن",2,0],["وَنوحي عَلى مَن ماتَ ظُلماً وَلَم يَنَل","سِوى البُعدِ عَن أَحبابِهِ وَالفَجائِعِ",3,"ع",1,0],["وَنوَالُكَ الْمَبْذُولُ قَدْ شَمَلَ الْوَرَى","طُرّاً وَفَضْلُكَ لَيْسَ فِيهِ مُشَارِكُ",4,"ك",1,0],["ونوّهَ في ربْعِ الخِلافةِ سعْدُهُ","فلازالَ في سعْدٍ وعِزٍّ مؤيّدِ",5,"د",1,0],["وَنُوحَا فَإِنَّ الْمَجْدَ أَقْوَتْ رُبُوعُهُ","وَزُلْزِلَ مِنْهُ مُشْمَخُّرِ الأَهَاضِب",6,"ب",1,0],["وَنَوَدُّ أَلّا تَسمَعوا","فينا السِعايَةَ وَالوِشايَه",7,"ا",3,0],["وَنوجَدُ نَحنُ أَمنَعُهُم ذِمار","وَأَوفاهُم إِذا عَقَدوا يَميناً",8,"ن",2,0],["وَنَوحٍ بَعَثتَ كَمِثلِ الإِراخِ","آنَسَتِ العينُ أَشبالَها",9,"ل",3,0],["وَنُورُ هُدَاكِ نَهْضَتَهُنَّ تَمَّتْ","عَلَى قَدَرٍ وَلَمْ تُوصَمْ بِغِيِّ",10,"ي",1,0],["وَنَوْفَلاً وَخِلاطاً وَالأُولَى لَحِفُوا","بِشَأْوِهِمْ مِنْ أَلبَّاءٍ وَأَعْيَانِ",11,"ن",1,0],["وَنَومٍ كَحَسوِ الطَيرِ قَد باتَ صُحبَتي","يَنالونَهُ فَوقَ القِلاصِ العَياهِلِ",12,"ل",1,0],["وَنَومٍ كَحَسوِ الطَيرِ نازَعتُ صُحبَتي","عَلى شُعَبِ الأَكوارِ فَوقَ الحَوارِكِ",13,"ك",1,0],["وَنورِدُ أَبطالَ العَدُوِّ مَناهِلاً","حِياضَ المَنايا وِردُها غَيرِ صادِرِ",14,"ر",1,0],["وَنوقِعَ فيهِم وَقعَةً ذاتَ صَولَةٍ","يُوافي بِها الرُكبانُ أَهلَ المَواسِمِ",15,"م",1,0],["وَنورُ وَجهِكَ سِرٌّ حينَ أَشهَدُهُ","هَذا هُوَ الجودُ وَالإِحسانُ وَالكَرَمُ",16,"م",1,0],["ونوالاً يُنيلُني كلَّ سؤلٍ","ويقيني الخضوعَ والتسآلا",17,"ل",2,0],["ونوَّلَ حتى لقد خِلُتهُ","يُساجلُ فيِّ أبا القاسمِ",18,"م",1,0],["ونُواحٍ يَفيضُ من قلبِ أُمٍّ","فُجِعَتْ في وحيدها البسَّامِ",19,"م",1,0],["ونَوْحِ اليتامَى على أُمَّهاتٍ","تَوَارَيْنَ خلفَ ظَلامِ الحُتوفُ",20,"ف",1,0],["ونورك وهو للداني سبيل","وبشرك وهو للقاضي بشير",21,"ر",1,0],["وَنُوافي الصارِخَ في اللُجَجِ","وَالنارِ الساطِعَةِ الوَهَجِ",22,"ج",1,0],["وَنَواظِرُ العُوّادِ عَنكَ أَمالَها","دَمعٌ تُعالِجُ كَتمَهُ وَتُعاني",23,"ن",2,0],["وَنودِيَ اِقرَأ تَعالى اللَهُ قائِلُها","لَم تَتَّصِل قَبلَ مَن قيلَت لَهُ بِفَمِ",24,"م",1,0],["وَنَواوِساً وَهّاجَةً","لَم يَتَّخِذها الهامِدون",25,"ن",1,0],["وَنونٌ دونَها في البَحرِ نونُ","مِنَ البُسفورِ نَقَّطَها السَفينُ",26,"ن",1,0],["وَنُؤِيٍّ كَأَنَّهُنَّ عَلَيهِن","نَ خِدامٌ خُرسٌ بِسوقٍ خِدالِ",27,"ل",1,0],["وَنوافِلٌ مِن أَحمَدَ بنِ مُحَمَّدٍ","أَعتامُ مِنهُنَّ الَّذي أَعتامُهُ",28,"م",2,0],["ونَوىً يَترُكُ الغَليلَ مُقيماً","بِمَهاً تَبعَثُ الدموعَ عِجالا",29,"ل",2,0],["ونواظرٍ وجدَ المحبُّ فتورَها","لمّا استقلَّ الحيُّ في أعضائِه",30,"ا",3,0],["وَنوَّرَ مِن كِفلٍ مِنَ النارِ قَبرَهُ","وَآنَسَهُ بِالرُعبِ عِندَ لِقائِهِ",31,"ا",3,0],["ونود لو خلت الحياة لنا","كطريقنا وغدت بلا أحدِ",32,"د",1,0],["ونوبيّةٍ في الخَلْقِ منها خلائِقٌ","متى ما تَرقّ العينُ فيها تَسَهّلِ",33,"ل",1,1],["وَنُورِيّةٍ للنارِ فيها ذُؤابَةٌ","تذوبُ بها ذوبُ النّضارِ المميَّعِ",34,"ع",1,1],["وَنورُ الشَمسِ ما طَلَعَت تُباهي","بِنورِ طُلوعِ طَلعَتِكَ البَهِيَّه",35,"ه",1,0],["وَنورا سُؤدُدٍ وَحِجاً إِذا ما","رَأَيتَهُما رَأَيتَ الشِعرَيَينِ",36,"ن",1,0],["ونُودُوا إلينا فمن جاءنا","مَنَنَّا عليه بِعَهْدٍ وَثيقْ",37,"ق",1,0],["وَنوحي عَلى صَبٍّ بَكَت عائِداتُهُ","صَريعِ قُدودِ البانِ وَالأَعيُنِ النُجلِ",38,"ل",1,0],["وَنونُ آذَريونِهِ","يَلوحُ في مَيمَنَتِه",39,"ت",2,0],["وَنَوحٍ عَلَيهِ لَنا بِالصَهيلِ","وَصَلصَلَةِ اللُجمِ في مِنقَبِ",40,"ب",1,0],["ونور المصطفى إطفاء ما","أوقدوه وتولوا مدبرينا",41,"ن",2,0],["ونُودِيَ بالتّرحال في فحمةِ الدجى","فجاءتهُ خيْلُ النّصرِ تَردي وتمزَع",42,"ع",1,0],["ونَومُ بني العبّاس فوقَ جُنوبهم","ولا نَصْرَ إلاّ قيْنَةٌ وأكاويب",43,"ب",1,0],["وَنورُ مُحَمَّدٍ أَبَداً تَمامٌ","عَلى وَضَحِ الطَريقَةِ لا يَحورُ",44,"ر",1,0],["وَنَومُ العَينِ مَمنوعٌ","وَماءُ العَينِ في سَكبِ",45,"ب",1,0],["وَنُؤيٌ كَخِلخالِ الفَتاةِ وَصائِمٌ","أَشَجُّ عَلى رَيبِ الزَمانِ رَقوبُ",46,"ب",1,0],["وَنَومِيَ مَوتٌ قَريبُ النُشورِ","وَمَوتِيَ نَومٌ طَويلُ الكَرى",47,"ر",2,0],["وَنَوى زَينَبٍ تُهونُ عَلى القَلبِ","وَفيهِ مِثلُ الشَرارِ النَوازي",48,"ز",2,0],["وَنَومُكَ في الصَحراءِ أَروَحُ مِن ذُرى","تُشادُ وَأَموالٍ تُصانُ وَتُحرَسُ",49,"س",1,0],["وَنودوا في إِمارَتِهِم فَجَفّوا","وَعادوا لِلثَقائِلِ حامِلينا",50,"ن",2,0],["وَنُؤيٍ كأَخلاقِ النَضيحِ تَعاوَنَت","عَلَيهِ القِيانُ بِالسَاخِينِ يُضرَبُ",51,"ب",1,0],["ونُؤيٍ كدُمْلوجِ الكعابِ ودمنةٍ","تُذكِّرُ مِن وَشْمِ الخضابِ رسومُها",52,"ه",2,1],["وَنَوِّري ظُلْمَةَ الْقُبُورِ على","مَن لَمْ يَصِلْ ظُلْمُهُ إِلى أَحَدِ",53,"د",1,0],["ونؤيٍّ كأنهن عليهن","خدامٌ خرسٌ بسوقٍ خدال",54,"ل",1,0],["وَنوجَدُ نَحنُ أَمنَعُهُم ذِماراً","وَأَوفاهُم إِذا عَقَدوا يَميناً",55,"ن",2,0],["وَنَوَاسِمٌ أَنْفَاسُهُنَّ طَوِيلَةٌ","وَهَوَاجِرٌ أَعْمَارُهُنَّ قِصَارُ",56,"ر",1,0],["وَنَوَّعَتْ فِي الصُّحفِ أَضْوَاءَهَا","فَهْيَ مَنَارٌ رُفِعَتْ لِلهدَى",57,"د",2,0],["وَنَوَابِغِ الآدَابِ وَالْ","أَخْلاَقِ وَالشَّيَمِ الْجِيَادْ",58,"د",1,0],["وَنوَى الضَّريحِ أَضَرَّهُ","كَنَوَاكِ يَوْمَ المَصْرَعِ",59,"ع",1,0],["وَنَوَدُّ أَنْ يُجْلَى لَكُمْ","مِنْ أَمْرِكُمْ وَجْهُ الصَّوَابِ",60,"ب",1,0],["وَنَوَّر حَولي قَبره الصَيف في الصَفا","وَطابَ بِرَيّاهُ ضُحىً وَأَصيلُ",61,"ل",1,0],["وَنُؤيٍ تَرامى فَوقَهُ الريحُ بِالسَفا","مَحَتهُ قِطارٌ مَرَّةً وَجَنوبُ",62,"ب",1,0],["ونَواةٌ جادتْ بنَخْلٍ ونَحْلٍ","وَارِفِ الظِّلِّ دائمِ الثَّمَرَاتِ",63,"ت",1,0],["ونُوَاحُ ذاتِ الطَّوْقِ في أعْوادِها","ما تُرْسِلُ الأقْلاَمُ مِن نَفَثَاتِهِ",64,"ت",2,0],["ونوه في بحر الخلافة سعده","فلا زال في سعد وعز مؤيد",65,"د",1,0],["و(نونية ) شبها (دعبل) ... وأصدأ (بائية) (للكميت)","ولكن متى متّ ؟ كنت (بخيتا) ... فصرت شعوبا ، تسمى (( بخيت))",66,"ت",1,0],["ونويت في تشرين أن","تلدي أعاجيب الزهور",67,"ر",1,0],["ونودى اقرأ تعالى الله قائلها","قد أشرق الهدى فانجابت به السحب",68,"ب",1,0],["ونوِّهوا باسمِ أهليها لتَسمَعَهم","- ولو على الرغم منها – صُمُّ آذان",69,"ن",1,0],["ونوراً كسا سُدُفاتِ الأثير","جمالاً يردُّ التَّصابي جنونا",70,"ن",2,0],["و(نونية ) شبها (دعبل)","وأصدأ (بائية) (للكميت)",71,"ت",1,0],["ونوح باعث طوفان نوح","ينوح لآه حنته الحمام",72,"م",1,0],["ونورٌ لتقوى والرجاء مع الرضا","وزهدٍ وخوفٍ مع يقين وأحلما",73,"م",2,0],["ونوال نايف سبحة حباتها","غاصت إلى الآذان في سبحانه",74,"ن",2,0],["ونورزنا رعاك اللّه","نورزنا على ساق",75,"ق",1,0],["ونوالك المدرارُ يقْعُ","د خلّتي أن لا يَقُومَا",76,"م",2,0],["وَنَومَةٍ لَستُ أَقضيها وَإِن مَتُعَت","وَما مَضى قَبلُ مِن شَأوي وَمِن عُمُري",77,"ر",2,0],["ونَورُ الأقاحى الثغرَ والخمرُ ريقةً","وزف الغراب الفرعَ وألبانُ لِينَها",78,"ه",2,0],["وَنَوالَهُ المَأمولَ سَيلاً دافِقاًَ","بِتَلاعِ أَربابِ الحَوائِجِ سائِلا",79,"ل",2,0],["ونواله وكماله وخصاله","كم قد أذابت من فؤاد حسود",80,"د",1,0],["ونوادرا أحكمتها وخواطرا","خقت لصيد السانحات شباكا",81,"ك",2,0],["وَنورِدُهُم حِياضَ الخَسفِ ذُلّاً","وَما نَألوهُمُ إِلّا خَبالا",82,"ل",2,0],["ونوسلن بجنابهم لمليكهم","وابشر بحسن كرامة الوهاب",83,"ب",1,0],["ونور سلوك الخير والسنن الذي","لسالكه يا سيدي الفوز والوعد",84,"د",1,0],["ونومي حرام وكل امرئ","به لوعة نومه يحرم",85,"م",1,0],["ونوهت بإسمي ف يالورى ونشرت لي","فضائل فيهم بدت العجم والعربا",86,"ب",2,0],["ونور وجهك يطفيها ببهجته","ويسلب النور منها وهي تستعر",87,"ر",1,0],["ونوديت من فوق المنابر كافرا","على أرؤس الأشهاد بالمنطق الجهر",88,"ر",1,0],["وَنُؤيٍ كَجِذمِ الحَوضِ غَيَّرَ رَسمُهُ","وَجِيفُ الحَصا بالمُوجِفاتِ الحَواشِكِ",89,"ك",1,0],["وَنُواحٌ بَينَ المَنابرِ وَالحَش",