 عاذِر",81,"ر",1,0],["وَأَشدُ مِنهُ مِن تَما","دي الحُب ما أَتَوقَع",82,"ع",1,0],["وَأَشُدُّ مِنها أَن مِن","نَهواهُ يَصحَبُهُ السوى",83,"و",2,0],["واشدد رحال الأفكار للسفر","إلى رياض الآيات والسور",84,"ر",1,0],["واشدُدْ يَدْيكَ بحَبلِ الدِّينِ مُعتَصِماً","فإنَّهُ الرُّكْنُ إنْ خانَتْكَ أركانُ",85,"ن",1,0],["وَأَشَدُّ ما أَلقاهُ بَعدَهُم","أَنّي فُجِعتُ بِهِم وَبالصَبرُ",86,"ر",1,0],["واشدُد يدَيْك بودِّ نُو","رِ الدين والقَ به الرِّجَالاَ",87,"ل",2,0],["وأشدّهنّ تشوّقاً للقائهِ","حوراءُ ذات تعزّزٍ وتجبر",88,"ر",1,0],["واشدُدْ لِثامَك دُونَ لَثْمِكَ لا تُضِعْ","حِرْمانَ جنْحٍ برْدُهُ لَك ساتِرُ",89,"ر",1,0],["واشدُد يديك بقُوى محمدٍ","في الخطب تعلَقْ مُحصَدا متينا",90,"ن",2,0],["واشددْ يديك بودِّه واقنعْ به","سكناً كما سكن العَلاءُ إلى العُلا",91,"ل",2,0],["واشدُد عليه يدَ مفتونٍ به","فليس إن أفلت منك راجعا",92,"ع",2,0],["وأشدُّ ضَنّاً بالمحاسن أن","يُقوِينَ من عَيْنٍ ومن أَثْرِ",93,"ر",1,0],["واشددْ يداً بالخافقين مملكاً","عنقيهما من أتهُمٍ ونجائدِ",94,"د",1,0],["وأشدُّ فَتْكاً في الكُماةِ بنَصلِهِ","من لحظِ مودودٍ بقلبِ وَدودِ",95,"د",1,0],["وأشد ما كلفت خاطر شاعر","صعب المعاني في الكلام الأسهل",96,"ل",1,0],["وأشدُّ الخطوب عُنفاً بنفسٍ","ما أتى بَغْتَةً بغيرِ أوانِ",97,"ن",1,0],["وأشدّ ما كان الفراقُ على الفتى","ما كان موصولاً بغير تلاقِ",98,"ق",1,0],["وأَشدُّ من جَذَعِ الجِيادِ إذا جرتْ","جَرْياً وأصبرُهُنَّ نَهْدٌ قارحُ",99,"ح",1,0],["وَاِشددْ يَديك بما ناولتَ من مِقَتِي","ومن غرامي ومن ثاوِي مودّاتي",100,"ت",2,0],["وأشّد عروة قُربِكمْ بيد الرّضى","والدَّهْرُ يفْصمُ ما أشُدُ من العرىَ",101,"ر",2,0],["وأشَدُّ من زَهرِ الحدائقِ نَضْرةً","وأجَلُّ من زُهرِ الكواكبِ مَنزِلا",102,"ل",2,0],["وأَشدُّهُمْ في كلِّ ضنكٍ ضيِّقٍ","وعظيمةٍ جَللٍ وخَطْب مُعْضِلِ",103,"ل",1,0],["وأَشدُّ عارضةً وأَثبتُ ما يرى","قلباً وجأْشاً في المقام الأَهْوَلِ",103,"ل",1,0],["وَأَشَدُّها آخِيَّةً","في عِزِّها وَثَرائِها",104,"ا",3,0],["واشدُد قُواكَ بِآلِ حَمزَةَ واعتَضِد","بِالشَّمسِ طالِعَةً عَلَى الشّاهينِ",105,"ن",1,0],["وأشد خلق الله إقداما إذا","حمي الوطيس وشمرت عن ساق",106,"ق",1,0],["و