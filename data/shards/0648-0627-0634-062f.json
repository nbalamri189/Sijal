poetsgate.com/ViewPoem.aspx?id=35308",""],[5809,"خيبة","https://www.poetsgate.com/ViewPoem.aspx?id=205371",""],[5845,"قفْ بالخضوعِ ونادِ ربكَ يا هو","https://www.poetsgate.com/ViewPoem.aspx?id=15455",""],[5847,"حينما بكت عمان .!!","https://www.poetsgate.com/ViewPoem.aspx?id=208953",""],[5873,"خدم الأعادي","https://www.poetsgate.com/ViewPoem.aspx?id=215352",""],[5910,"للهِ أشكو شجونًا","https://www.poetsgate.com/ViewPoem.aspx?id=206879",""],[5937,"إلى مُعَلمة","https://www.poetsgate.com/ViewPoem.aspx?id=211808",""],[5956,"يا بسمةَ الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=183998",""],[5956,"مهنةُ حفرِ المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=185812",""],[5956,"لا دين إلا لذي النوايا الطيبة","https://www.poetsgate.com/ViewPoem.aspx?id=192044",""],[5956,"هذي الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=193884",""],[5961,"وفد المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=199776",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[5309,"خطرت وورد الروض بين يديها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573535",""],[5724,"ربيعك للروح كالبلسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55133&r=&rc=0",""],[5724,"يا ليل ظلامك يحبسني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55136&r=&rc=3",""],[6190,"إباء الورد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86998&r=&rc=4",""]],"verses":[["وَاِشدُد حَشاكَ فَلَستَ تَطمَحُ خالِياً","إِلّا بَدا لَكَ مَوقِفي وَوُقوفي",0,"ف",2,0],["وَاِشدُد يَدَيكَ إِلى الوَغى بِمُغامِرٍ","نَدبٍ لِعاداتِ الطِعانِ مُعَوَّدِ",1,"د",1,0],["وأشدو لميلاده","ويصغي بلا مسمع",2,"ع",1,0],["وَأَشَدُّ مَا لُقِّيتُ فِيمَا نَالَنِي","أَنْ كُنْتُ يَوْمَاً عَنْ رِضَاكَ بِمَعْزِلِ",3,"ل",1,0],["وَاشْدُدْ عَلَى قَوْلِي يَداً فَهُوَ الَّذِي","بُرْهَانُهُ لاَ يَقْبَلُ التَّشْكِيكَا",4,"ك",2,0],["وَاشْدُدْ بهِ لأَخِيهِ أَزْرَاً وَارْتَقِبْ","مِنْهُمْ أُسُوداً وَالأَسِنَّةُ غَابُ",5,"ب",1,0],["وَأَشَدُّ فاجِعَةِ الدَواهي مُحسِنٌ","يَسعى لِيُعلِقَهُ الجَريمَةَ مُجرِمُ",6,"م",1,0],["وَأَشَدُّ مَا رَبَطَتْ أَوَاصِرُ رَحْمَةٍ","فِي الأَهْلِ أَنْ تُتَقَاسَمَ الأَحْزَانُ",7,"ن",1,0],["وأشد بَمن في غير مصر منّوهاً","ما أن ترى فيها لقولك آبها",8,"ب",3,0],["وأشدّ الكفر الذي هو رجز","كفر هذا الجمال بالأهدام",9,"م",1,0],["واشدُدَنْ راحتيكَ بالصاحب المُس","عِدِ يومَ البَليسة الغمّاءِ",10,"ا",2,0],["وأشدُّ من ظُلم الأذينِ وسائلي","عِلْمي بظَنِّكَ أنَّني لم أُظْلمِ",11,"م",1,0],["وَأَشَدُّ ما أَخشاهُ سَفكُ دَمي","بِيَدِ الأَثيمِ اللِصِّ ذي الغَدرِ",12,"ر",1,0],["واشد خلق الله جهلا امة","نقضت فظنت نقضها ابراما",13,"م",2,0],["وأشد من وقع المصاب على الفتى","ذكر المصاب على لسان عادى",14,"د",2,0],["وَأَشَدَّهُم صَبراً لِمُعتَقَداتِهِ","وَتَأَدُّباً لِمُجادِلٍ وَمُماري",15,"ر",2,0],["واشدُدْ يديكَ بحبلِ عمِّكَ إِنَّهُ","مولاكَ فهو بما تحبُّ ضمينُ",16,"ن",1,0],["وَأَشَدَّ أَهلِكَ مِنكَ ثُمَّ تَبَرُّماً","مَن كُنتَ تَقبَلُ نُصحَهُ وَتُطيعُهُ",17,"ع",2,0],["وأشدّ ما في الكون أجمعه","بين القلوب أواصرُ البؤس",18,"س",1,0],["وأشدّ مَنْ قَهَرَ الأعادي مِحْرَبٌ","في سِلمِهِ للحَربِ ذو استِعدادِ",19,"د",1,0],["وأشدُّ الصحابِ عوناً وأوفا","هم وقاراً وأضحكُ الناسِ سنَّا",20,"ن",2,0],["وأشدُّ مِن ظُلْمِ الحَوادثِ ظالمٌ","يَبكي لِما صَنعتْ وَما لَمْ تَصْنعِ",21,"ع",1,0],["وأشدُّ أبناءِ البِلادِ عَداوةً","مَن لا يرى المحتلَّ مِن أعدائهِ",22,"ا",3,0],["وَاِشدُد الصَفدَ لا أَحيدَ عَن","السِكّينِ حَيدَ الأَسيرِ ذي الأَغلالِ",23,"ل",1,0],["وَأَشَدَّ مَحمِيَةً وَأَبلَغَ صَولَةً","بِالحَقِ عَندَ تَكاملِ الأَعذارِ",24,"ر",1,0],["وَأَشَدَّ إِذ زَنِأَ الزَمانُ تَوَسُّعاً","في عيصِ كُلِّ شَصيبَةٍ وَيَسارِ",24,"ر",1,0],["وَاِشدُد يَدَيكَ بِحَمّادٍ أَبي عُمَرٍ","فَإِنَّهُ نَبَطِيٌّ مِن دَنانيرِ",25,"ر",1,0],["واشدُ باسمِ اللاَءِ خَيّمْنَ كذا","عن كُدا وَاعنَ بما أحويه حَي",26,"ي",1,0],["وأشدُّ العذاب ما كان في الها","وية السفلى حيث يطغى السعير",27,"ر",1,0],["وأشدو بشعري هابطاً ظل دوحها","فتبسط ذاكَ الظل أفنانها الملد",28,"د",1,0],["وأشدو بشعري كالهزار مغرداً","وَما كانَ يوما في الحياة به كسبي",29,"ب",2,0],["وَأَشَدُّ مَا يَلْقَى الْفَتَى فِي دَهْرِهِ","فَقْدُ الْكِرَامِ وصُحْبَةُ اللُّؤَمَاءِ",30,"ا",2,0],["وَاشْدُدْ قِوَى رُوحَكَ وَاحْمِلْ جَاهِداً","عِبْئَيْهِمَا أَلَسْتَ لِلْكُلِّ أَبَ",31,"ب",1,0],["وَأَشَدُّ خَطْبٍ أَنْ يُمَنَّى عَاثِرٌ","بِإِقَالَةٍ وَيَظَلُّ غَيْرَ مُقَالِ",32,"ل",1,0],["وَاشْدُ بِالإِبَاءِ وَالحِلمِ وَالعِزَّ","ةِ فِي العُسْرِ والنَّدَى فِي اليُسْرِ",33,"ر",1,0],["وَأَشَدُّ فِي التَّنْكِيلِ مِنْ كَأْسِ الأَذَى","وَضْعُ القِذَى فِي كَأْسِهِ لِلْشَّارِبِ",34,"ب",1,0],["وَأَشَدُّ بِدْعاً عِزُّ فَرْدٍ جَاهِلٍ","أَوْ مُرْتَقَى جمَع قُوَاهُ بَدَاد",35,"د",1,0],["وَأَشَدُّ الآلاَمِ أَنْ تُلْزِمَ الثَّغْرَ ابتسَاماً","والْقَلْبُ رَهْنُ اكتِئَابِهْ",36,"ب",2,0],["وأشدَّ من خضباتهن صلابة","وأهبَّ من إعصارهن السافي",37,"ف",2,0],["وأشدو بذكراك لم تسألي","لمن ذلك الشدو أو من شدا ؟",38,"د",2,0],["وأَشَدَّ مَحْمِيَة ً، وأَبْلَغَ صَوْلَة ً","لَكَ إِذْ تُحَطُّ عَوَاقِبُ الأَقْدَارِ",39,"ر",1,0],["وَأَشَد ما يَشكو الفُؤاد ممنع","في لَحظِهِ دائي وَمِنهُ دَوائي",40,"ا",2,0],["واشد من هذا واثقل وطأة","قلب به تتلاعب الآمال",41,"ل",1,0],["واشْدُد يديك بنا فإنّك جارُنا","لا تيأسنَّ فإن حظَّكَ صاعدُ",42,"د",1,0],["واشدد يمينك بالشري","عة إنها السبب المتين",43,"ن",1,0],["واشدد بأيدك أزره واعصمه من","شر العدى ومكائد الخوان",44,"ن",1,0],["وَأَشَدُّ بَأساً مِن كُلَيبٍ إِذ سَطا","بِالسَيفِ يَجتَثُّ الذُرى مِن حِميَرِ",45,"ر",1,0],["وَاِشدُد يَداً بِأَبي قِناعٍ إِنَّهُ","نِعمَ المُحامي دُونَها وَالحامي",46,"م",2,0],["وَأَشَدَّهُم دَفعاً وَأَخلَصَ وَائلٍ","نَفعاً وَأَطوَلَهُم مَناطَ حَمائلِ",47,"ل",1,0],["وأشدّ من شرب النبي","ذ بلا نديم أو غنا",48,"ن",2,0],["وأشدّ من عذل العذو","ل صدود إلف قد وصل",49,"ل",1,0],["وأشدّ من هذا وذا","طلب النوال من السفل",49,"ل",1,0],["وأشدّ الأشياء أن معاشي","واحترافي على الإله افتراض",50,"ض",1,0],["وأشدّ ذلك كله وأمرّه","سعيي لأطلب ما بأيدي الناس",51,"س",1,0],["وأشدّ ذلك كله حنف","ينفي السرور ويوهن الزندا",52,"د",2,0],["واشدّ ما أغزى الحسود يدٌ","سلفت إليه ولم تعذك يدُه",53,"د",2,0],["وَأشدُّ الأعداءِ طرّاً حميّه","قَومهُ الصيدُ حين ضلّت حلومُ",54,"م",1,0],["وَأشدُّ منهُ جَهالةً من يكفرُ","بِمحمّدٍ والح