{"poems":[[63,"سل الدهر عني أي خطب أمارس","https://www.aldiwan.net/poem46145.html","الطويل"],[86,"رياض أفق من غمرة الموت واستمع","https://www.aldiwan.net/poem10488.html","الطويل"],[51,"يا أيها الموعوظ في لشكوه","https://www.aldiwan.net/poem64028.html","الكامل"],[91,"ماذا جنيت عليهم أيها القلم","https://www.aldiwan.net/poem62702.html","عموديه"],[91,"لا لهفة النفس على غابة","https://www.aldiwan.net/poem62811.html","عموديه"],[85,"أهل القدود التي صالت عواليها","https://www.aldiwan.net/poem62992.html","البسيط"],[43,"طوال قنا تطاعنها قصار","https://www.aldiwan.net/poem9568.html","الوافر"],[43,"ملامي النوى في ظلمها غاية الظلم","https://www.aldiwan.net/poem10536.html","الطويل"],[62,"فؤاد على كر الحوادث مارد","https://www.aldiwan.net/poem52454.html","الطويل"],[66,"لئن ثلمت حدي صروف النوائب","https://www.aldiwan.net/poem41586.html","الطويل"],[46,"لو يتركون وهذا اللب ما قبلوا","https://www.aldiwan.net/poem23307.html","البسيط"],[135,"بربك يا زيدان هل كنت تعلم","https://www.aldiwan.net/poem49175.html","الطويل"],[199,"لا زينة المرء تعليله ولا المال","https://www.aldiwan.net/poem45678.html","البسيط"],[229,"أسهم أصاب القلب أم لحظك الشزر","https://www.aldiwan.net/poem51047.html","الطويل"],[237,"ألا قل لمن يبغي إلى العز منفذا","https://www.aldiwan.net/poem18189.html","الطويل"],[252,"طوى دارها طي الكتاب المنمنم","https://www.aldiwan.net/poem1431.html",""],[259,"باسمك يا الله ربي ابتدي","https://www.aldiwan.net/poem35938.html","الرجز"],[261,"أظن الصبا جابت إليك المسالكا","https://www.aldiwan.net/poem38220.html","الطويل"],[263,"إذا ذكرت أمامة فرط حولٍ","https://www.aldiwan.net/poem449.html",""],[280,"ألم أك للقوافي الغر خدنا","https://www.aldiwan.net/poem60692.html","البسيط"],[366,"تعاور قلبي نازل بعد نازل","https://www.aldiwan.net/poem17079.html","الطويل"],[458,"تروح من وجرة الظاعنونا","https://www.aldiwan.net/poem55843.html","المتقارب"],[461,"كأن رياض الحزن هبت لها الصبا","https://www.aldiwan.net/poem15139.html","الطويل"],[551,"أرقت للبرق بالعلياء يضطرم","https://www.aldiwan.net/poem47247.html","البسيط"]],"verses":[["وأرْهَفْتَ منْ غَرْبي وما كانَ نابِياً","كَما سَنّتْ البيضَ الرِّقاقَ المَداوِسُ",0,"س",1,0],["وَأَرهَبتَ حُكّامَ الأَقاليمِ فَاِرعَوَوا","وَكانوا أُناساً في الجَهالَةِ أَوضَعوا",1,"ع",3,0],["وارهبْ من الأقران قِرْناً مالَهُ","إلا العواقِبَ والعقوبة ناصر",2,"ر",1,0],["وَأَرهَقوا الصُحُفَ وَالأَقلامَ في زَمَنٍ","يَكادُ يَعبُدُ فيهِ الطِرسُ وَالقَلَمُ",3,"م",1,0],["وَارَةً نَلهو بِأَعنابِها","وَتارَةً نُحصي أَقاحيها",4,"ي",3,0],["وَأَرهَفَت أَعيُناً ضَعفى حَمائِلُها","نَشوى مَناصِلُها كَحلى مَواضيها",5,"ي",3,0],["وَأُرهِقَتِ العَذارى مُردَفاتٍ","وَأَوطِئَتِ الأُصَيبِيَةُ الصِغارُ",6,"ر",1,0],["وَأَرهَبَ حَتّى لَو تَأَمَّلَ دِرعَهُ","جَرَت جَزَعاً مِن غَيرِ نارٍ وَلا فَحمِ",7,"م",1,0],["وأرهف حدَّيهِ الخطوبُ طوارقاً","كما رقّقتْ متنَ الحُسامِ المبارِدُ",8,"د",1,0],["وَأَرهُنُ قَولي عَن فِعالي كَأَنَّهُ","عَصا الحارِثِ الدُعمِيِّ أَو قَوسَ حاجِبِ",9,"ب",1,0],["وَأَرهَبَتهُم جُفونٌ مِلؤها نُوَبٌ","وَأَرغَبَتهُم جِفانٌ لِلنَدى رُذُمُ",10,"م",1,0],["وأرهف يراعاً للكتابة ماضياً","فقد جاء عصر بالحوادث مفعمُ",11,"م",1,0],["وأرهبتْ أسدَ الآفاقِ زأرتُهُ","وملءَ أفاقها أُسْد وأشبالُ",12,"ل",1,0],["وأرهبتَ أهلَ الشامِ حتّى تركتُهَمْ","وليس لهم سرّ سواك ولا جهر",13,"ر",1,0],["وأرْهَفَ سَيْفَ اللُّبِّ رِبْذَةُ خَبِّهِمْ","وَأَعْظِمْ بِخَبٍّ كَانَ لِلُّبِّ مِشْحَذَا",14,"ذ",2,0],["وَأَرهفَ حَدّيهِ لحزّي كَأَنَّما","تَوَهَّم انعامَ ابنِ رزِّيكَ مُسلِمي",15,"م",2,0],["وأره محاسنَ الأسفارِ","إذ تنجلي عرائس الأسحارِ",16,"ر",1,0],["وارهب اعدائي وابهر حاسدي","وانهض عز ما حامل الذكر باركا",17,"ك",2,0],["وأرهَنُ في الحوادثِ كفَّ بكري","لجاري في العظيمةِ إن دُهيتُ",18,"ت",1,0],["وَأَرْهَبُ ما يَكُونُ السَّيْفُ حَدَّاً","إِذا ما فارَقَ السَّيْفُ الجَهازا",19,"ز",2,0],["وَأَرهَنتُمُ خَدَّ الهَوى وَجَلَوتُمُ","عَلَيهِ وُجوهاً في صَقيلٍ مُقاتِلِ",20,"ل",1,0],["وأَرهفنَ قبلُ نُصولَ العيون","فقَدَّتْ ولم تتخاذلْ طعينا",21,"ن",2,0],["وأرهب حتى ما تمر ظُلامةٌ","وإنْ لم تكن فِعلاً بخاطرِ ظالِمِ",22,"م",1,0],["وأرهقوا من عظيمٍ خُنْزُوانَتَه","يئِطُّ في القِدِّ أو تهفو به الرَّخَمُ",23,"م",1,0]]}