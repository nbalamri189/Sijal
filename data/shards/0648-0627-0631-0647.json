{"poems":[[65,"سل الدهر عني أي خطب أمارس","https://www.aldiwan.net/poem46145.html","الطويل"],[88,"رياض أفق من غمرة الموت واستمع","https://www.aldiwan.net/poem10488.html","الطويل"],[53,"يا أيها الموعوظ في لشكوه","https://www.aldiwan.net/poem64028.html","الكامل"],[93,"ماذا جنيت عليهم أيها القلم","https://www.aldiwan.net/poem62702.html","عموديه"],[93,"لا لهفة النفس على غابة","https://www.aldiwan.net/poem62811.html","عموديه"],[87,"أهل القدود التي صالت عواليها","https://www.aldiwan.net/poem62992.html","البسيط"],[45,"طوال قنا تطاعنها قصار","https://www.aldiwan.net/poem9568.html","الوافر"],[45,"ملامي النوى في ظلمها غاية الظلم","https://www.aldiwan.net/poem10536.html","الطويل"],[64,"فؤاد على كر الحوادث مارد","https://www.aldiwan.net/poem52454.html","الطويل"],[68,"لئن ثلمت حدي صروف النوائب","https://www.aldiwan.net/poem41586.html","الطويل"],[48,"لو يتركون وهذا اللب ما قبلوا","https://www.aldiwan.net/poem23307.html","البسيط"],[139,"بربك يا زيدان هل كنت تعلم","https://www.aldiwan.net/poem49175.html","الطويل"],[203,"لا زينة المرء تعليله ولا المال","https://www.aldiwan.net/poem45678.html","البسيط"],[234,"أسهم أصاب القلب أم لحظك الشزر","https://www.aldiwan.net/poem51047.html","الطويل"],[242,"ألا قل لمن يبغي إلى العز منفذا","https://www.aldiwan.net/poem18189.html","الطويل"],[257,"طوى دارها طي الكتاب المنمنم","https://www.aldiwan.net/poem1431.html",""],[264,"باسمك يا الله ربي ابتدي","https://www.aldiwan.net/poem35938.html","الرجز"],[266,"أظن الصبا جابت إليك المسالكا","https://www.aldiwan.net/poem38220.html","الطويل"],[268,"إذا ذكرت أمامة فرط حولٍ","https://www.aldiwan.net/poem449.html",""],[285,"ألم أك للقوافي الغر خدنا","https://www.aldiwan.net/poem60692.html","البسيط"],[371,"تعاور قلبي نازل بعد نازل","https://www.aldiwan.net/poem17079.html","الطويل"],[463,"تروح من وجرة الظاعنونا","https://www.aldiwan.net/poem55843.html","المتقارب"],[466,"كأن رياض الحزن هبت لها الصبا","https://www.aldiwan.net/poem15139.html","الطويل"],[556,"أرقت للبرق بالعلياء يضطرم","https://www.aldiwan.net/poem47247.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83319","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102218","الكامل"],[1600,"","https://poetry.dctabudhabi.ae/diwan/poem/146085","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108896","الوافر"],[1838,"","https://poetry.dctabudhabi.ae/diwan/poem/104157","الطويل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114772","الطويل"],[2870,"","https://poetry.dctabudhabi.ae/diwan/poem/142169","المجتث"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130101","المجتث"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131983","المتقارب"],[3719,"","https://poetry.dctabudhabi.ae/diwan/poem/111113","البسيط"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99240","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133301","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136072","الرجز"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76466","البسيط"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44915","المتقارب"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101354","الوافر"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45070","الوافر"],[4297,"","https://poetry.dctabudhabi.ae/diwan/poem/102203","الوافر"],[4778,"بلوت الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=188177",""],[4778,"دخان من غير نار","https://www.poetsgate.com/ViewPoem.aspx?id=193782",""],[4816,"عيد الحب","https://www.poetsgate.com/ViewPoem.aspx?id=15734",""],[1901,"ألم يأْنِ أن تَرقَا الدموعَ السواجمِ","https://www.poetsgate.com/ViewPoem.aspx?id=160392",""],[4858,"موكب النور","https://www.poetsgate.com/ViewPoem.aspx?id=29798",""],[4984,"إستباق","https://www.poetsgate.com/ViewPoem.aspx?id=180385",""],[585,"أما حان خوض المأزق المتلاحم","https://www.poetsgate.com/ViewPoem.aspx?id=161924",""],[5106,"قَافِلَة ُ العُميَان","https://www.poetsgate.com/ViewPoem.aspx?id=158969",""],[5191,"دُخَان","https://www.poetsgate.com/ViewPoem.aspx?id=211974",""],[5273,"جريمة","https://www.poetsgate.com/ViewPoem.aspx?id=176205",""],[5302,"صراع نفس","https://www.poetsgate.com/ViewPoem.aspx?id=202725",""],[5427,"وأرهبنا الخليفة واستمرت","https://www.poetsgate.com/ViewPoem.aspx?id=181470",""],[5431,"الكولا وعنترة العبسي!","https://www.poetsgate.com/ViewPoem.aspx?id=215610",""],[5770,"إلى صديق","https://www.poetsgate.com/ViewPoem.aspx?id=178681",""],[5943,"رباعية باسمة رغم الألم","https://www.poetsgate.com/ViewPoem.aspx?id=11154",""],[5969,"طفقنا من تراتيل الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=199265",""],[6102,"قافية خضراء","https://www.poetsgate.com/ViewPoem.aspx?id=184629",""],[6189,"الريحانة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83581&r=&rc=48",""]],"verses":[["وأرْهَفْتَ منْ غَرْبي وما كانَ نابِياً","كَما سَنّتْ البيضَ الرِّقاقَ المَداوِسُ",0,"س",1,0],["وَأَرهَبتَ حُكّامَ الأَقاليمِ فَاِرعَوَوا","وَكانوا أُناساً في الجَهالَةِ أَوضَعوا",1,"ع",3,0],["وارهبْ من الأقران قِرْناً مالَهُ","إلا العواقِبَ والعقوبة ناصر",2,"ر",1,0],["وَأَرهَقوا الصُحُفَ وَالأَقلامَ في زَمَنٍ","يَكادُ يَعبُدُ فيهِ الطِرسُ وَالقَلَمُ",3,"م",1,0],["وَارَةً نَلهو بِأَعنابِها","وَتارَةً نُحصي أَقاحيها",4,"ي",3,0],["وَأَرهَفَت أَعيُناً ضَعفى حَمائِلُها","نَشوى مَناصِلُها كَحلى مَواضيها",5,"ي",3,0],["وَأُرهِقَتِ العَذارى مُردَفاتٍ","وَأَوطِئَتِ الأُصَيبِيَةُ الصِغارُ",6,"ر",1,0],["وَأَرهَبَ حَتّى لَو تَأَمَّلَ دِرعَهُ","جَرَت جَزَعاً مِن غَيرِ نارٍ وَلا فَحمِ",7,"م",1,0],["وأرهف حدَّيهِ الخطوبُ طوارقاً","كما رقّقتْ متنَ الحُسامِ المبارِدُ",8,"د",1,0],["وَأَرهُنُ قَولي عَن فِعالي كَأَنَّهُ","عَصا الحارِثِ الدُعمِيِّ أَو قَوسَ حاجِبِ",9,"ب",1,0],["وَأَرهَبَتهُم جُفونٌ مِلؤها نُوَبٌ","وَأَرغَبَتهُم جِفانٌ لِلنَدى رُذُمُ",10,"م",1,0],["وأرهف يراعاً للكتابة ماضياً","فقد جاء عصر بالحوادث مفعمُ",11,"م",1,0],["وأرهبتْ أسدَ الآفاقِ زأرتُهُ","وملءَ أفاقها أُسْد وأشبالُ",12,"ل",1,0],["وأرهبتَ أهلَ الشامِ حتّى تركتُهَمْ","وليس لهم سرّ سواك ولا جهر",13,"ر",1,0],["وأرْهَفَ سَيْفَ اللُّبِّ رِبْذَةُ خَبِّهِمْ","وَأَعْظِمْ بِخَبٍّ كَانَ لِلُّبِّ مِشْحَذَا",14,"ذ",2,0],["وَأَرهفَ حَدّيهِ لحزّي كَأَنَّما","تَوَهَّم انعامَ ابنِ رزِّيكَ مُسلِمي",15,"م",2,0],["وأره محاسنَ الأسفارِ","إذ تنجلي عرائس الأسحارِ",16,"ر",1,0],["وارهب اعدائي وابهر حاسدي","وانهض عز ما حامل الذكر باركا",17,"ك",2,0],["وأرهَنُ في الحوادثِ كفَّ بكري","لجاري في العظيمةِ إن دُهيتُ",18,"ت",1,0],["وَأَرْهَبُ ما يَكُونُ السَّيْفُ حَدَّاً","إِذا ما فارَقَ السَّيْفُ الجَهازا",19,"ز",2,0],["وَأَرهَنتُمُ خَدَّ الهَوى وَجَلَوتُمُ","عَلَيهِ وُجوهاً في صَقيلٍ مُقاتِلِ",20,"ل",1,0],["وأَرهفنَ قبلُ نُصولَ العيون","فقَدَّتْ ولم تتخاذلْ طعينا",21,"ن",2,0],["وأرهب حتى ما تمر ظُلامةٌ","وإنْ لم تكن فِعلاً بخاطرِ ظالِمِ",22,"م",1,0],["وأرهقوا من عظيمٍ خُنْزُوانَتَه","يئِطُّ في القِدِّ أو تهفو به الرَّخَمُ",23,"م",1,0],["وَأَرهَنُ هَذا القَلبَ لِلغَيدِ وَالمَهى","وَأَجعَلُ العَقلَ مَهرَ العَقائِلِ",24,"ل",1,0],["وارهق جنود النفس حرباً ولا تهن","وفي ظلمات الطبع بالحق فاستبن",25,"ن",1,0],["وارهَج على ذِمَمِ الرجالِ ولا تخَف","فالحِلمُ رحب والنوالُ مُباحُ",26,"ح",1,0],["وأرهقني نكيرك لي صعوداً","من الأشجان ليس له صبوب",27,"ب",1,0],["وأرهب كوكباً منه سباني","فكيف إذا تبدى فرقدين",28,"ن",1,0],["وأرهن نفسي بالوفاء لصاحبي","فمن دون غدري أن تغيب أعظمي",29,"م",2,0],["وأرهقني هذا الزّمانُ صُعودا","ولم أعتصر للذكر بعدك عودا",30,"د",2,0],["وأرهفت كلُّ","وبان لي كل شيْ",31,"ي",1,0],["وأَرهقونا جميعاً","بِظُلمِهم والكيادِ",32,"د",1,0],["وأرهفت سمعي إلى بلبل","فخلته صوتك إذ تنطقين",33,"ن",1,0],["وارهقته وما في حده فلل","وغادرته وما في عوده خور",34,"ر",1,0],["وأرْهَفَهُ حُبُّ الطُّلاَ فَهْو ناحلٌ","ولولا وصالٌ دائمٌ دقَّ أن يُرَى",35,"ر",2,0],["وأرهفوا السيف للعدوان وادرعوا","درع العداء فكم أدمى وكم قطعا",36,"ع",2,0],["وأرِها بأنك الغفورُ","فينا وأنك لك الأمورُ",37,"ر",1,0],["وأرها بأنك الغفّارُ","فينا وأنك لك الأنوارُ",37,"ر",1,0],["وأرها بأنك الرحمنُ","فينا وأنك لك الأمانُ",37,"ن",1,0],["وأرها بأنك الرحيمُ","فينا وأنك لك النعيمُ",37,"م",1,0],["وأرها بأنك الحفيظُ","فينا فلا يمسّنا مغيظُ",37,"ظ",1,0],["وأرها بأنك المغني الغني","فينا وأنك لك الفضل السني",37,"ي",1,0],["وارهن حَياتك في دين السعادة لا","ترهن عقارك بخسا بعد تفليس",38,"س",1,0],["وَاَرهَقتُها بِالخُطوب الجِسام","وَبِالحادثِ المُستَشيطِ العَمَمْ",39,"م",1,0],["وأرهبهم جناح منك أضحت","تغير في قوادمه العباد",40,"د",1,0],["وَأَرهَفَ حُسنُهُ طَبعا بَليدا","يُجاذِبُهُ لِمَعني مُستقيمِ",41,"م",1,0],["وأرهب بأسه صرف الليالي","فأضحى والزمان لهُ غلاما",42,"م",2,0],["وأرهقت الصعاب وأرهقتني","ولم يهزمِني عَيَّارٌ عنيد",43,"د",1,0],["وإرهابٌ تمدد في البرايا","وإيمانٌ تساوره الظنون",44,"ن",1,0],["وأرهف من الاحساس وأرج م الجد","وأعسف من الجمحى على الشوق شفته",45,"ت",2,0],["وأرهقني حتى هممتُ بقتلهِ","فساعَده صَرفُ الزمانِ المهاجمُ",46,"م",1,0],["وأرهف الدّهرُ سمْعيْه لصرْختنا","الله أكبرُ !! وعدُ الله قد صدقا",47,"ق",2,0],["وأرهقنا الترحال في ألف رحلة","وما ملأ المغبون من رغبة صاعه",48,"ع",2,0],["وأرهف أقطاب السياسة كيدهم","فكان بناء الملك فوق الجماجم",49,"م",1,0],["وَأَرْهَقَ أَضْلاعَ المرَبَّعِ جَاهِلٌ","خُرُوجَاً عَلَىْ جِذْرٍ بِصِفْرٍ مُكَعَّبُهْ",50,"ب",2,0],["وأرهقني من التجوال ضعفي","وأسقاني العذابَ مع الهوانِ",51,"ن",1,0],["وأرهقَني الشّوقُ لما سَباني","على ضِفَّةِ الجيدِ هذا الوِشاحُ",52,"ح",1,0],["وأرهقني ما حطم القلب واختفى","من الدرب نور كان في الروح يسطع",53,"ع",1,0],["وأرهبنا الخليفة واستمرت","وجوه الأرض تغتصب اغتصابا",54,"ب",2,1],["وإرهابك المخصيّ غولُ توهّمٍ","يُصفّدُ في الأغلال كي لا تُحرروا",55,"ر",3,0],["وأرهفت سمعيَ دهراً لعلي","على الدرب أسمعُ وقعَ خُطاه",56,"ا",2,0],["وأرهقَ الفكرَ ماصارَ الحليمُ به","حيرانَ قد خانَهُ صبرٌ به الحُزُمُ",57,"م",1,0],["وَأرهِقَتِ المَشاعِرُ والقَوافي","وَشاخَ الشِعرُ في قَلمِ الأَديبِ",58,"ب",1,0],["وَ أَرْهَقَها أَنِّي تَعَمَّدْتُ رَصْفَها","فَضَاقَ بِهِ ذَرْعًا , وَ ضَجَّ ازْوِرارُها",59,"ر",3,0],["وَ أَرْهَبَها مِنْ شِعْرِيَ القَسْرُ عِنْدَما","بِهِ الْتَزَمَ التَّنْضِيدَ - رُغْمًا - نُثَارُها",59,"ر",3,0],["وأرهقني هوى ما تبت منه","يتوب العاشقون ولا أتوب",60,"ب",1,0]]}