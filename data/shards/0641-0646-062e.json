{"poems":[[55,"بروم السيوف وغرب الرماح","https://www.aldiwan.net/poem30653.html","المتقارب"],[91,"كتاب رثاء يحمل البث من قلبي","https://www.aldiwan.net/poem44958.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55142","البسيط"],[185,"ألا ليتنا كنا طريدين فى دم","https://www.aldiwan.net/poem58751.html","الطويل"],[487,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127955","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125359","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201696",""],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130127","الوافر"],[3553,"","https://poetry.dctabudhabi.ae/diwan/poem/17677","الطويل"],[5131,"مكانَكِ يا نفسُ لا تنطقي","https://www.poetsgate.com/ViewPoem.aspx?id=53814",""]],"verses":[["فَنَخضِبُ فيها جِباهَ الظُبى","وَنُرمِدُ فيها عُيونَ الجِراحِ",0,"ح",1,0],["فنخصب أياماً تكون قليلة","ونجدب لما تنقضي مدة الخصب",1,"ب",1,0],["فَنُخْبَةُ الكَاتِبَاتِ فِيهِ","كَالعِقْدِ مِنْ أَنْفُسِ الَّلآلِي",2,"ل",2,0],["فنَخفَى عَلَى حَدسِ العَدُوِّ وَظَنِّهِ","ويُحرِزُنا عَرضُ البِلادِ وَطُولُهَا",3,"ه",2,0],["فنختال لما أن تجلت شموسنا","بغرب فكان الغرب شرقا وكانان",4,"ن",1,0],["فنخص ذاوجد بما يهفوله","وتعم نفتحته على الجلاي",5,"ي",1,0],["فنخاعُها واللحم سرُّ حياتِها","وهما لحفظ كيانِها حِصنانِ",6,"ن",1,0],["فنخرُّ طرّاً للحضيض","وما بنا من سالم",7,"م",1,0],["فَنُخرج مِن بطون الأرضِ تِبراً","ونأكل طيّباً حَسناً حَلالا",8,"ل",2,0],["فَنَخرُجَ مِنها وَالسُيوفُ عِصِيُّنا","إِلى غايَةٍ تَسمو إِلَيها الأَكارِمُ",9,"م",1,0],["فنخرج منها عظام النفوسِ","ونظهر والمجد في المفرق",10,"ق",1,0]]}