],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138535",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108357",""],[3643,"","https://poetry.dctabudhabi.ae/diwan/poem/145190","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109995","البسيط"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140289",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92014","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91787","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114582","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133255","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125865","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91021","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90997","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90910","المجتث"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94408","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94326","الطويل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135088","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141684","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120520","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139551",""],[4657,"","https://poetry.dctabudhabi.ae/diwan/poem/140137",""],[4697,"يا بوش","https://www.poetsgate.com/ViewPoem.aspx?id=22667",""],[4728,"أنا قسم بالله ميّت من الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=176985",""],[4768,"عشق دمشقي","https://www.poetsgate.com/ViewPoem.aspx?id=213022",""],[4802,"أبعاد","https://www.poetsgate.com/ViewPoem.aspx?id=32337",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4871,"إب الخضراء","https://www.poetsgate.com/ViewPoem.aspx?id=214893",""],[4877,"يسعدلي هالضحكة","https://www.poetsgate.com/ViewPoem.aspx?id=29452",""],[4927,"لصوص المخابرات","https://www.poetsgate.com/ViewPoem.aspx?id=80802",""],[5147,"وضاح وجهك من بالحسن جلله","https://www.poetsgate.com/ViewPoem.aspx?id=166739",""],[5150,"أنا الشهيدة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203060",""],[5277,"شعارُ الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=204180",""],[5277,"معارضة قصيدة عبدالرزاق عبدالواحد","https://www.poetsgate.com/ViewPoem.aspx?id=205147",""],[5397,"سقيت ربوعا بالحمى ومعالما","https://www.poetsgate.com/ViewPoem.aspx?id=157964",""],[5397,"رميت بقوس الحزم عن قوس حاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157922",""],[5675,"يحق لي انصب على أهل المجد ما تم","https://www.poetsgate.com/ViewPoem.aspx?id=170617",""],[5690,"إذا ما المجد داريهِ الكلامُ","https://www.poetsgate.com/ViewPoem.aspx?id=172178",""],[5775,"ما يضحك الجاهل","https://www.poetsgate.com/ViewPoem.aspx?id=26098",""],[5956,"عصفور هطلَ على ماء بجانبي","https://www.poetsgate.com/ViewPoem.aspx?id=183461",""],[5956,"التحام صاحب العمل بموظفيه","https://www.poetsgate.com/ViewPoem.aspx?id=193192",""],[5956,"يُقيم مبادرات باسلات","https://www.poetsgate.com/ViewPoem.aspx?id=193203",""],[5956,"تحيتك الجليلة نهرُ نيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=193349",""],[5956,"في الحكمة: يحق لك الشك لكن لا تعتبره يقينا","https://www.poetsgate.com/ViewPoem.aspx?id=202664",""],[5975,"أمنيات الورود","https://www.poetsgate.com/ViewPoem.aspx?id=53259",""],[6090,"هدمت للمجد والعلياء أركانا","https://www.poetsgate.com/ViewPoem.aspx?id=170920",""],[6134,"وليلة انس زانها قمر البشر","https://www.poetsgate.com/ViewPoem.aspx?id=169556",""]],"verses":[["يَحِقُّ لَهَمْ أنْ يُغْبَطُوا إِذْ تنَقَلُوا","إِلَى العَالمِ البَاقِي منَ العَالمِ الفَانِي",0,"ن",2,0],["يَحقُّ لي المَجْدُ المؤثّلُ والفَخْرُ","ويعْرِفُ فَضْلاً حُزْتَهُ البَرُّ والبَحْرُ",1,"ر",1,1],["يحقُّ علَيْنا أنْ نقومَ بحقّه","ويَلْقاهُ منّا البِرُّ والشُّكْرُ والحَمْدُ",2,"د",1,0],["يُحَقِّقنَ ما حاذَرتُ مِن صَرفِ نِيَّةٍ","لِمَيَّةَ أَمسَت في عَصا البَينِ تَقدَحُ",3,"ح",1,0],["يَحُقُّ لَكُم هَذا التَصَلُّفَ كُلُّهُ","لِعِلمِكُمُ وَجدي بِكُم وَغَرامي",4,"م",2,0],["يحقُّ لِمَنْ لحاني فيكَ ذمي","وحُقَّ لكاتبِ السرِّ امتداحي",5,"ح",2,0],["يَحِقُّ لِمَن يَهوى الحَياةَ بُكاؤُهُ","إِذا لاحَ قُرنُ الشَمسِ أَو حينَ تَغرُبُ",6,"ب",1,0],["يُحَقُّ كَسادُ الشِعرِ في كُلِّ مَوطِنٍ","إِذا نَفَقَت هَذي العُروضُ الكَواسِدُ",7,"د",1,1],["يَحُقُّ لِفَضْلِكُمْ عِنْدِي","خِرَاجُ الْحَمْدِ وَالشُّكْرِ",8,"ر",1,0],["يَحقّ عِصياني اللاحي عليكَ، وما","بأضْلُعي، طاعة ً للوَجْدِ، مِن وَهَجِ",9,"ج",1,0],["يحقّ أنْ متون العلم تحمله","فهو الذي ما شكا في حمله وصبا",10,"ب",2,0],["يحَقِّ مَن قَد جَعَلَ ذا الحُسنِ مَلبوسَكَ","وَقَع عَلى قِصَّتي بِإِطلاقِ مَحبوسَك",11,"ك",1,1],["يحق لدود القز يقتل نفسه","إذا جاء بيت العنكبوت بمثله",12,"ه",1,0],["يحقُّ للعينِ أَنْ تبيضَّ من حَزَنٍ","إِذا قضتْ من لُباناتِ البكا أَربا",13,"ب",2,0],["يَحِقُّ لِإِبراهيمَ تَضمينَ مِثلِهِ","سَلامَةُ إِسماعيلَ إِذ كُفِيَ الذَبحا",14,"ح",2,0],["يحقّ لي أَنْ أهيمَ فيهِ","وحُقّ في مثله الهيامُ",15,"م",1,0],["يحقن دم الكافرين قولهم","إن وفقوا لا إله إلا اللّه",16,"ل",2,0],["يَحِقُّ لمّا أنْ رأتْ حسنَه","عينِيَ أنْ أهوى وأنْ أعشَقا",17,"ق",2,0],["يحقُّ لكلِّ تلميذٍ ثناءٌ","عليهِ يَسوقُهُ قلبٌ شكُورُ",18,"ر",1,0],["يَحِقُّ أن تُندُبَ الأحياءَ نائحةٌ","فالموتُ للكلِ بالمرصادِ قد وقفا",19,"ف",2,0],["يحق للقطر أن يسمو بنابغة","نظير هذا الجليل الباذخ الشان",20,"ن",1,0],["يحققها حق الذوات المحيطة","أتيت بروح الحق في نفحاته",21,"ه",1,0],["يحققه بالحق مالك رقه","وواها لعقل في تخلق خلقه",21,"ه",1,0],["يحققها التشريع عند الحكومة","وللوهم في حكم العقول خلافة",21,"ه",1,0],["يحقُّ لها ان تنوح عليه","بدمعٍ سخينٍ يُذيب المُقل",22,"ل",1,0],["يحق لي غير أني مسني كبر","أزور سعيا على عيني مغناك",23,"ك",1,0],["يَحقُّ عليكِ ألاَّ تقتليني","فيبقَى الناسُ لهم إمامُ",24,"م",1,0],["يحق بالعقل اعتزا","له على رؤوس الجبال",25,"ب",3,0],["يحقُّ لوجههِ إن لا","حَ تكبيرٌ وتهليلُ",26,"ل",1,0],["يُحَقِّقُ إِخلاَصَهُ في رَجاءِ","عُلاكَ وتَحْقيقِ ذاكَ الرَّجاءِ",27,"ا",2,0],["يحق لي وبي الدنيا نموت أسا","قد مات من كان حصناً أينما كانا",28,"ن",2,0],["يَحق لي أَن أَحمَدا","سراً وَإِعلان",29,"ن",1,0],["يحق لباغي الحب أن يطلب العذرا","ويرضى بما ترضى به الغادة العذرا",30,"ر",2,1],["يحق للقائلين فيه","إذا رأوا جعده المجعد",31,"د",1,0],["يحق يا قوم لمن قده ال","خطار أن لا يرهب الأخطرا",32,"ر",2,0],["يحق لمصر ان تئن لفقده","وان تبلغ الأحزان ما بلغ الفقد",33,"د",1,0],["يحق لبعض الجنس اصلاح بعضه","والا فأسبابُ الفساد تزيدُ",34,"د",1,1],["يحق له مني الخضوع لأنه","مليك جمال ليس يعصى له أمر",35,"ر",1,0],["يحقّ للعين أن تبكي لفُرقتها","أَحِبَّةً ليس في دَهْرِي لهم بَدَل",36,"ل",1,0],["يحقق ما قد دق في العلم فهمه","فحق بأن يدعى الإمام المحققا",37,"ق",2,0],["يحق لهم ان اوسعوا الذم غبطة","لقد عاقهم عما بلغنا العوايق",38,"ق",1,0],["يحقُّ لمثلي أن يُخَلِّفَ حجَةً","تُجَدِّدُ آسمي للقيامةِ والحَشرِ",39,"ر",1,0],["ي حقول نضيرة من حلالها","ألبست جيدها الكنانة عقدا",40,"د",2,0],["يحق لهذا الدهر حربي لأنني","كشفت الذي يخفيه من عالم الرجس",41,"س",1,0],["يحق لي أخذ أجرٍ","من الفقير المعرَّى",42,"ر",2,0],["يَحقِ لصاد ذاب من فَرط وَجده","ورود غَدير حُفَّ صَوناً بأسده",43,"ه",1,0],["يحق لذا العصر افتخار بقوله","لعدلي ترى كل البرية نائله",44,"ه",1,1],["يحق لي الثناء عليه حقاً","على إرث الولاية من جدود",45,"د",1,0],["يحقر من بالكبر فينا قد زهوا","فهو الذي خصَّ بوصف الكبر",46,"ر",1,0],["يحقُ لأهل الأرض أن يجعلو البكا","عليه شعاراً والسراء لهم رأيا",47,"ي",2,0],["يَحِق لِلأَزهَرِ المَعمورِ أَن يَهنا","فَما تَمَنّاه مَولانا بهِ منّا",48,"ن",2,1],["يحق للمجد أن يزهو برونقه","فأنت فيه الرئيس الأعظم الجلل",49,"ل",1,0],["يحق لناظري يبكيك حزناً","بذوب القلب دمعا غير راق",50,"ق",1,0],["يَحِق لَهُ مِنّا بُكاء مُؤَبَّد","بِدَمع دَم من حبَّة القَلبِ دافِق",51,"ق",1,0],["يَحِقُّ لَهُ منا البُكاءُ مُؤَبَّداً","بِدَمع دَم من مَحجَر العَينِ يقطرُ",52,"ر",1,0],["يحق لنا أن نسعد السبط إن بكى","على صفوةٍ من آله أمت الحربا",53,"ب",2,1],["يحق لأشياع البتولة انهم","يقيمون حزناً في عزاها مدى العمر",54,"ر",1,1],["يحق له في ان يسمى ابا الهدى","فكم قد جلا عن ذي الظلام الدياجرا",55,"ر",2,0],["يحقق آمالي ويدفع كربتي","مديحك يا مختار أكرم به ريا",56,"ي",2,0],["يَحِقُّ للعين أَن تُجري عُيون دمٍ","وقد رأَتكَ غضيضَ الجَفنِ مُضَّجِعا",57,"ع",2,0],["يحق لنا نبكي على العلم بعده","ونندبه من حين 