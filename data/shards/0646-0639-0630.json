{"poems":[[280,"وصفراء في لون المحب وحاله","https://www.aldiwan.net/poem25606.html","الطويل"],[4077,"","https://poetry.dctabudhabi.ae/diwan/poem/198904","المتقارب"],[4755,"ثَورَةٌ تَنطَحُ ثَورَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=191502",""],[5309,"إذا بت في يأس وخوف من الهلك","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573567",""]],"verses":[["نُعَذِّبها عَمْداً لِتُنعم أنْفُساً","ورُبّ نَعيمٍ من عذابٍ تَنَتّجا",0,"ج",2,0],["نعذّب منها بغير اللذيذ","ونشرق منها بغير الزلال",1,"ل",1,0],["نَعذُرُ القَاتِلَ.. نَرجُو","مِنهُ أنْ يَقتُلَ ثَورَهْ!",2,"ر",2,0],["نُعَذَّبُ بِالأَجسادِ أَمّا نُفوسُنا","فَتُفلِتُ كَالنُّورِ المُقَيَّدِ بِالسِّلكِ",3,"ك",1,0]]}