{"poems":[[90,"حياكم الله أيها العرب","https://www.aldiwan.net/poem44469.html","المنسرح"],[87,"لك في الأرض والسماء مآتم","https://www.aldiwan.net/poem11330.html","الخفيف"],[563,"اغسلوا بي نجاسة الوسواس","https://www.aldiwan.net/poem34440.html","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56293","الكامل"],[3784,"","https://poetry.dctabudhabi.ae/diwan/poem/18588","البسيط"],[5225,"اغسلي بالبرد","https://www.poetsgate.com/ViewPoem.aspx?id=16758",""],[5281,"اخلعي الحُزنَ","https://www.poetsgate.com/ViewPoem.aspx?id=199646",""],[5431,"ماخاب قلبٌ قد رآك المسكنا","https://www.poetsgate.com/ViewPoem.aspx?id=192362",""],[5431,"في حب الله ...","https://www.poetsgate.com/ViewPoem.aspx?id=202478",""],[5431,"ماكنتُ ..لم يكُ","https://www.poetsgate.com/ViewPoem.aspx?id=206365",""],[5739,"مضيق الموق ..!","https://www.poetsgate.com/ViewPoem.aspx?id=135077",""],[5396,"جنازة الجلاّد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65519&r=&rc=18",""]],"verses":[["أغسل شعري إذا هجوتكم","لأنه من هجائكم جُنُب",0,"ب",1,0],["اِغسُلوهُ بِطَيِّبٍ مِن وَضوءِ ال","رُسلِ كَالوَردِ في رُباهُ البَواسِم",1,"م",1,0],["اغسلوا بي نجاسة الوسواس","عن قلوب لكم بها الجهل راسي",2,"س",2,1],["اغسلني اللهم من إثمي باك","ثارٍ لأطهر من جميع جرايمي",3,"م",2,0],["إِغسِل يَدَيكَ بِأَشنانٍ وَأَنقِهما","غسلَ الجَنابَةِ مِن مَعروفِ عُثمانِ",4,"ن",1,0],["اغسلي بالبرد قلب صبٍّ تشهَّد","بعد عقلٍ يدلّه ضاع منه الدليل",5,"ل",1,1],["اغسلي كُلَّ عُقدةٍ في حياتي","وامْلئِيْها من سِحْركِ العَذْبِ سِحرا",6,"ر",2,0],["اغسل فؤادك بالفرات تيمنا","واشرب من الصبر الجميل تيقنا",7,"ن",2,1],["أغسّل طين آثامي بذكرٍ","فيعفو عن محبٍ إذْ عصاه",8,"ا",2,0],["أغسّلُ نفسي في مياهٍ حرورةٍ","لينسلّ منها للجحيم ويسلك..",9,"ك",1,1],["اغسلي وجه الغياب اللي فتن.","روح شاعر صفحة الخفاق عينه.",10,"ن",2,0],["إغسلوه بما جرى من دمائه فتراب العطاش أولى بمائه","وارجموا نعشه كما ترجم البومة بالباقيات من أشلائه",11,"ه",1,1]]}