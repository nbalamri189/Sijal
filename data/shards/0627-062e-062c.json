{"poems":[[77,"أخجلتني يا مخجل الشمس","https://www.aldiwan.net/poem35880.html","أحذ الكامل"],[72,"يا سيدي لك نظم في محاسنه","https://www.aldiwan.net/poem18723.html","البسيط"],[91,"بت أرعى في الظلام الأنجما","https://www.aldiwan.net/poem8872.html","عموديه"],[66,"لا تخش ياربع الحبيب همودا","https://www.aldiwan.net/poem41375.html","الكامل"],[69,"يا بن أخينا أقمتنا أبدا","https://www.aldiwan.net/poem28602.html","المنسرح"],[69,"أخجلتني بتواتر الإحسان","https://www.aldiwan.net/poem28696.html","الكامل"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[90,"أنا !","https://www.poetsgate.com/ViewPoem.aspx?id=179156",""],[45,"أمَوَاهِبٌ هَاتِيكَ أمْ أنْوَاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=32874",""],[143,"هل غير ظلك للعفاة مقيل","https://www.aldiwan.net/poem11791.html","الكامل"],[160,"ما فته حظه من أجل الطلبا","https://www.aldiwan.net/poem59115.html","البسيط"],[235,"يا مشرق البحر الخضم بمائه","https://www.aldiwan.net/poem31607.html","الكامل"],[297,"قل للمليحة في القباء الأطلس","https://www.aldiwan.net/poem33237.html","الكامل"],[366,"ولقد خلوت بعبرة متفردا","https://www.aldiwan.net/poem17358.html","الكامل"],[380,"ما كان أغناك يا قلبي عن القلق","https://www.aldiwan.net/poem48818.html","البسيط"],[429,"أقبلت تنجلى وفي الخد شامه","https://www.aldiwan.net/poem40043.html","الخفيف"],[432,"إن جوى لو يذهب الأوجالا","https://www.aldiwan.net/poem12763.html","الرجز"],[464,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[515,"يا ظبية الرمل التي","https://www.aldiwan.net/poem12102.html","مجزوء الرجز"],[515,"فقت الملوك مهابة وجلالاً","https://www.aldiwan.net/poem12204.html","الكامل"],[586,"أخجلت بالثغر ثنايا الأقاح","https://www.aldiwan.net/poem17475.html","السريع"]],"verses":[["أخْجَلْتَني يا مُخْجِلَ الشّمْسِ","بمَكارِمٍ أعْيَتْ علَى نَفْسي",0,"س",2,1],["أخجلتني بقريضٍ كان غايته","إن أخبر الناس عن فقري وعن حصري",1,"ر",2,0],["أَخجَلَت شَمسَ الضُحى طُلعَتُها","وَاِستَحى مِن لَحظِها لَحظُ الغَزال",2,"ل",1,0],["أَخجَلنَ زَهرَ الأُقحُوانِ مَباسِماً","زَهراً وَصاهَينَ الشَقيقَ خُدودا",3,"د",2,0],["أخجلتنا بالجميلِ فيكَ فمن","فَرَضْتَ منَّا فشاكرٌ حامدْ",4,"د",1,0],["أخجلْتَني بتواترِ الإحسانِ","حتى وهى فكري وكلَّ لساني",5,"ي",1,1],["أَخجَلتَ بالحِلْمِ ساداتِ الزَّمانِ فَلَمْ","يَعْفُوا كَعَفْوِكَ عَنْ ذَنْبٍ إذا قَدَرُوا",6,"ر",3,0],["أخْجَلتُه بالضِحك أحسَبهُ","كمُخوِّفٍ للنَبع بالغَرَب",7,"ب",1,0],["أخْجَلْتَني بِنَدَى يدَيْكَ، فسوّدَتْ","ما بَيْنَنَا تِلْكَ اليَدُ البيْضَاءُ",8,"ا",2,0],["أَخجَلتَ مُنهَمِرَ الحَيا بِمَكارِمٍ","يُخبِرنَ أَنَّكَ لِلكِرامِ سَليلُ",9,"ل",1,0],["أخجلت من قص أخبار الملوك ومن","يروي ويسئل عن اهل السخا الكتبا",10,"ب",2,0],["أَخجَلتَهُ بِنَوالِكِ الغَمرِ الَّذي","غَمَرَ البِلادَ فَجاشَ لِاِستِحيائِهِ",11,"ا",3,0],["أَخجلتِ ولدانَ الجنانِ وحورها","وَخطرتِ من أَثوابها في سُندُسِ",12,"س",1,0],["أَخجَلتُمُ ثِقَتي وَلَو كُنتُم عِدىً","ما أُخجِلَت لَكِنَّكُم إِخواني",13,"ي",1,0],["أَخجَلت مالك رَقي حينَ قُلت لَهُ","تَرى أَري هاجِري الغَضبان مُعتَنِقي",14,"ق",2,0],["أخجل الورد وجنتاها فأضحى","ذا احمرارٍ مشققاً أكمامه",15,"م",2,0],["أخجَلَهُ النّرجسُ لمّا أن نظَرْ","فاحمرّ من فرطِ الحياءِ والخفَرْ",16,"ر",1,0],["أخجلت نفحةً وحسناً فما يرفع","رأساً قيصومها والثّماما",17,"م",2,0],["أخجلني بأنعم","أنظمها وينثر",18,"ر",1,0],["أخجلت أفراد الزمان إنالة","وكفالة ومقالة وفعالا",19,"ل",2,0],["أَخْجَلْتَ بِالثَّغْرِ ثَنَايَا الأَقاحْ","يا طُرَّةَ اللَّيلِ وَوَجْهَ الصَّباحْ",20,"ح",1,1]]}