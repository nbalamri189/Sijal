{"poems":[[79,"أخجلتني يا مخجل الشمس","https://www.aldiwan.net/poem35880.html","أحذ الكامل"],[74,"يا سيدي لك نظم في محاسنه","https://www.aldiwan.net/poem18723.html","البسيط"],[93,"بت أرعى في الظلام الأنجما","https://www.aldiwan.net/poem8872.html","عموديه"],[68,"لا تخش ياربع الحبيب همودا","https://www.aldiwan.net/poem41375.html","الكامل"],[71,"يا بن أخينا أقمتنا أبدا","https://www.aldiwan.net/poem28602.html","المنسرح"],[71,"أخجلتني بتواتر الإحسان","https://www.aldiwan.net/poem28696.html","الكامل"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[92,"أنا !","https://www.poetsgate.com/ViewPoem.aspx?id=179156",""],[47,"أمَوَاهِبٌ هَاتِيكَ أمْ أنْوَاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=32874",""],[147,"هل غير ظلك للعفاة مقيل","https://www.aldiwan.net/poem11791.html","الكامل"],[164,"ما فته حظه من أجل الطلبا","https://www.aldiwan.net/poem59115.html","البسيط"],[240,"يا مشرق البحر الخضم بمائه","https://www.aldiwan.net/poem31607.html","الكامل"],[302,"قل للمليحة في القباء الأطلس","https://www.aldiwan.net/poem33237.html","الكامل"],[371,"ولقد خلوت بعبرة متفردا","https://www.aldiwan.net/poem17358.html","الكامل"],[385,"ما كان أغناك يا قلبي عن القلق","https://www.aldiwan.net/poem48818.html","البسيط"],[435,"أقبلت تنجلى وفي الخد شامه","https://www.aldiwan.net/poem40043.html","الخفيف"],[438,"إن جوى لو يذهب الأوجالا","https://www.aldiwan.net/poem12763.html","الرجز"],[469,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[520,"يا ظبية الرمل التي","https://www.aldiwan.net/poem12102.html","مجزوء الرجز"],[520,"فقت الملوك مهابة وجلالاً","https://www.aldiwan.net/poem12204.html","الكامل"],[591,"أخجلت بالثغر ثنايا الأقاح","https://www.aldiwan.net/poem17475.html","السريع"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44585","الرجز"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130201","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38767","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37953","المجتث"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120022","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59039","السريع"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111163","السريع"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64780","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56608","الطويل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78140","الرمل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128695","الخفيف"],[1558,"","https://poetry.dctabudhabi.ae/diwan/poem/147701","المتدارك"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111796","الرمل"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216662",""],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114025","الخفيف"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109349","السريع"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93708","السريع"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106996","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100395","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202806",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199923","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202988","السريع"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74030","الرجز"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66483","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110128","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205724",""],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85015","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85076","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102962","الكامل"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105262","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105133","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94361","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83629","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72466","السريع"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102016","الرمل"],[5136,"أفدي التي بت في محبتها","https://www.poetsgate.com/ViewPoem.aspx?id=121669",""],[5790,"بأبي وبي طيفٌ طرق","https://www.poetsgate.com/ViewPoem.aspx?id=111872",""],[520,"فقت الملوك مهابة وجلالا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577601",""],[6233,"عيناكِ تعلنان هزيمتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82633&r=&rc=32",""]],"verses":[["أخْجَلْتَني يا مُخْجِلَ الشّمْسِ","بمَكارِمٍ أعْيَتْ علَى نَفْسي",0,"س",2,1],["أخجلتني بقريضٍ كان غايته","إن أخبر الناس عن فقري وعن حصري",1,"ر",2,0],["أَخجَلَت شَمسَ الضُحى طُلعَتُها","وَاِستَحى مِن لَحظِها لَحظُ الغَزال",2,"ل",1,0],["أَخجَلنَ زَهرَ الأُقحُوانِ مَباسِماً","زَهراً وَصاهَينَ الشَقيقَ خُدودا",3,"د",2,0],["أخجلتنا بالجميلِ فيكَ فمن","فَرَضْتَ منَّا فشاكرٌ حامدْ",4,"د",1,0],["أخجلْتَني بتواترِ الإحسانِ","حتى وهى فكري وكلَّ لساني",5,"ن",2,1],["أَخجَلتَ بالحِلْمِ ساداتِ الزَّمانِ فَلَمْ","يَعْفُوا كَعَفْوِكَ عَنْ ذَنْبٍ إذا قَدَرُوا",6,"ر",3,0],["أخْجَلتُه بالضِحك أحسَبهُ","كمُخوِّفٍ للنَبع بالغَرَب",7,"ب",1,0],["أخْجَلْتَني بِنَدَى يدَيْكَ، فسوّدَتْ","ما بَيْنَنَا تِلْكَ اليَدُ البيْضَاءُ",8,"ا",2,0],["أَخجَلتَ مُنهَمِرَ الحَيا بِمَكارِمٍ","يُخبِرنَ أَنَّكَ لِلكِرامِ سَليلُ",9,"ل",1,0],["أخجلت من قص أخبار الملوك ومن","يروي ويسئل عن اهل السخا الكتبا",10,"ب",2,0],["أَخجَلتَهُ بِنَوالِكِ الغَمرِ الَّذي","غَمَرَ البِلادَ فَجاشَ لِاِستِحيائِهِ",11,"ا",3,0],["أَخجلتِ ولدانَ الجنانِ وحورها","وَخطرتِ من أَثوابها في سُندُسِ",12,"س",1,0],["أَخجَلتُمُ ثِقَتي وَلَو كُنتُم عِدىً","ما أُخجِلَت لَكِنَّكُم إِخواني",13,"ن",2,0],["أَخجَلت مالك رَقي حينَ قُلت لَهُ","تَرى أَري هاجِري الغَضبان مُعتَنِقي",14,"ق",2,0],["أخجل الورد وجنتاها فأضحى","ذا احمرارٍ مشققاً أكمامه",15,"م",2,0],["أخجَلَهُ النّرجسُ لمّا أن نظَرْ","فاحمرّ من فرطِ الحياءِ والخفَرْ",16,"ر",1,0],["أخجلت نفحةً وحسناً فما يرفع","رأساً قيصومها والثّماما",17,"م",2,0],["أخجلني بأنعم","أنظمها وينثر",18,"ر",1,0],["أخجلت أفراد الزمان إنالة","وكفالة ومقالة وفعالا",19,"ل",2,0],["أَخْجَلْتَ بِالثَّغْرِ ثَنَايَا الأَقاحْ","يا طُرَّةَ اللَّيلِ وَوَجْهَ الصَّباحْ",20,"ح",1,1],["أَخجَلَهُ النَرجِسُ إِذ جادَلَهُ","فَاِحمَرَّ مِن فَرطِ حَياءٍ وَخَفَرْ",21,"ر",1,0],["أخجلته بالعتب حتى بان لي","درر بمصقول اللجين تدحرجا",22,"ج",2,0],["أَخجَلَ الأَغصانَ مَيلاً قَدُّهُ","بِالتَّثنّي إِذ تَثنّى مِنهُ كَشحُ",23,"ح",1,0],["أَخجَلتُه بِعِتابي","عَلى بعادي وصَدّي",24,"د",2,1],["اخجل بقامتك الغصون تثنيا","واكسر بلحظك سورة الصهباءِ",25,"ا",2,0],["أخْجَلْتَ بالفرق جبينَ الصبَاحْ","يَا وجنةَ الورد وثغرَ الأقَاحْ",26,"ح",1,1],["أخجلت جيد الريم بالالتفات","وفقت سل السيف بالإنصلات",27,"ت",1,1],["أَخْجَلْتَهُ عِلْماً وعَزْماً ماضياً","فأصابَ مِنْكَ الخَضْرَ والإِسكندَرا",28,"ر",2,0],["أخ جاء يدعوني إلى نصرة أخوة","وهذا يراع سامع ومجيب",29,"ب",1,1],["أَخجل الشَمس سَناه حينَ بان","تَحتَ لَيل الفرع وَالفَرق جَلي",30,"ي",1,0],["أخجل الشمس في الضحى واستعار ال","بدر في الليل نوره وتمامه",31,"م",2,0],["أخجلتَ الشَّمسَ لدى الحَمَلِ","وَسَمَتْ قَدماك على زُحَلِ",32,"ل",1,1],["اخجلَ الدرَّ ابتداءً","وازدِرى المسكَ ختاما",33,"م",2,0],["اخجلت مِنْ شوفها وراحت تفيل","للغروب الشمس نوّت عَلَى الزوال",34,"ل",1,0],["أخجل البدر إذ أطل عليه","فارانا من السَّحابِ انتقابَه",35,"ب",2,0],["اخجلتَ في الأرض قدود القنا","وفي السما هابك رمح السماك",36,"ك",1,0],["أَخجلت ذات البَرق في راحة","تزري نَوالاً بِالحَيا الساجم",37,"م",1,0],["أخجلت منه وجنة حتى جنت","عيني من رياضها ورد الخجل",38,"ل",1,0],["اخجلت وجه السحب فاستحيا الحيا","يا مخجلا صوب السحاب الهامي",39,"م",2,0],["أخجلُ إن مرّ بي صباح","لم يأت فيه إليّ شعر",40,"ر",1,1],["أخجل من شعري وما يدعي","وأطرق الرأس متى أمدحِ",41,"ح",1,1],["أخجل من عرض فتوني له","وإن تكن بعض عطاياه",42,"ا",2,0],["أَخجَلتُه فَعادَ من خباء","يَقتَطِف الورد وَعين الرائي",43,"ا",2,0],["أخجل الورد منه ديباج خدّ","رائق النسج من دمي مصبوغ",44,"غ",1,0],["اخجلتَ دهراً قد كشفتَ خِداعَهُ","بمقالكَ البادي البيان الأوضحِ",45,"ح",1,1],["أخجِلتَ بالثوب الرشي","ق وأنت صاحبه الفريد",46,"د",1,0],["أَخجَلَ البَحرُ عِقدَهُم وَالثَنايا","حَيثُ فاقا مَرجانِهِ وَجُمانِهِ",47,"ن",2,0],["أخجل البدر واعتراه خسوف","حيث لم يستطع يحاكي خياله",48,"ل",2,0],["أخجلته بالعتب حتى خلته","في راحتي فكان أبعد مبعد",49,"د",1,0],["أخجلته عتباً وتعلم أنه","أشهى من الصادي اليك لورده",50,"د",2,0],["أخجل البدر فذا الطل السقيط","عرق من وجهه قد رشحا",51,"ح",2,0],["أخجل بانات اللوى","مهما تثنى بانه",52,"ن",2,0],["أَخجَل الخطيَّ مياس القدود","لين غصنٍ ينثني تحت الخِمار",53,"ر",1,0],["أَخجَلتِ ذاتَ البَرقِ في وَجهك ال","وَضّاءِ ما أحلاهُ من باسِمِ",54,"م",1,0],["أخجل في تبييض تسويده","من ادعى ما في السوبدا رجال",55,"ل",1,0],["أخجل البحر صلاة وندى","وقضى الدهر صلاة وصياما",56,"م",2,0],["أخجل أن سميت ويسقني","إلى اسمها عند من ينم",57,"م",1,0],["أخجلت خد الورد من","ك بوجنةٍ مثل الشفق",58,"ق",1,0],["أخجلت أفراد الزمان إيالةً","وكفالة ومقالة وفعالا",59,"ل",2,0],["أخجولةَ الدمع النديّ .. هزمتني","وهدمتِ فيَّ مدائني وحصوني",60,"ن",2,0]]}