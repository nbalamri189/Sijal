wPoem.aspx?id=179068",""],[45,"نَفْسِي الفِداءُ لِمَنْ أوَدُّهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31621",""],[45,"مُغَنّيكَ، للبُغضِ، فيهِ سِمّهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32047",""],[35,"أَهَاجَكَ منْ سُعْدى الغَداة َ طُلُولُ","https://www.poetsgate.com/ViewPoem.aspx?id=22131",""],[51,"يا مجيرَ الورى من الحَدثانِ","https://www.poetsgate.com/ViewPoem.aspx?id=30622",""]],"verses":[["كَثيرِ اِرتِياحِ القَبِ في عَقبِ جودِهِ","إِذا جائِدٌ أَلقى يَداً في التَنَدُّمِ",0,"م",1,0],["كَثُرَ الحَديدُ بِهِ فَبَعضٌ يَتَّقي","كَلمَ الطِعانِ بِها وَبَعضٌ يُكلَمُ",1,"م",1,0],["كَثُرَت أَمانيُّ الرِجالِ وَلَم تَزَل","مُتَوَسِّعاتٌ وَالزَمانُ يَضيقُ",2,"ق",1,0],["كَثيرِ اِلتِفاتِ الطَرفِ في كُلِّ مَذهَبٍ","بِأَنَّةِ مَصدورٍ عَلى البَينِ لاهِفِ",3,"ف",1,0],["كَثُرَ النَصيرُ لَهُم فَلَمّا جاءَهُم","أَمرُ الرَدى وُجِدوا بِلا أَنصارِ",4,"ر",1,0],["كَثُرَت نُعوتُ صِفاتِهِ في مَدحِهِ","فَكَأَنَّ مادِحَهُ المُفُوَّهَ سامِرُ",5,"ر",1,0],["كَثَروا الحَصى بِجُموعِهِم وَتَلاحَقوا","بِكَ مِن قِيامٍ في السُروجِ قُعودِ",6,"د",1,0],["كَثُروا مَجداً وَطابوا","مِن نَجيبٍ فَنَجيبِ",7,"ب",1,0],["كَثيرٌ بي أُمَيَّةُ في المَعالي","وَمالي مِنْ سَماحِي فيهِ قِلَّهْ",8,"ل",2,0],["كَثيرٌ إليهِ النّاظِرونَ إذا بَدا","قَليلٌ لهُ في حَوْمَةِ الحَربِ أقرانُ",9,"ن",1,0],["كَثيرونَ لو يَنْمِيهِمُ ابنُ كَريهَةٍ","حَليفُ الوَغى أو ناسِكٌ مُتحَنِّثُ",10,"ث",1,0],["كَثيرُ النَوافِلِ تَبري لَهُ","مَرازِئُ لَيسَ بِعَدّادِها",11,"د",3,0],["كَثيرُ الأَيادي حاضِرُ الصَفحِ مُنصِفٌ","كَثيرُ الأَعادي غائِبُ الحِقدِ مُسعِفُ",12,"ف",1,0],["كَثَرتَهُم في دِمَشقٍ وَهيَ خالِيَةٌ","وَقَد أَناخَ عَلَيها الجَحفَلُ اللَجِبُ",13,"ب",1,0],["كثيرُ عَطَاءِ الفاعلين مع الغِنى","بجودهمُ إن كاثروك قليل",14,"ل",1,0],["كَثيرُ النَدى يَأتي النَدى حَيثُما أَتى","وَإِن غابَ غابَ العُرفُ حَيثُ يَغِيبُ",15,"ب",1,0],["كَثرَتْ جِرَاحَاتِي وَأَحْدَثُ مَا أَتَى","مُتَلاحِقاً وَأَمَضُّهُ جُرْحَانِ",16,"ن",1,0],["كُثْرٌ مَآثِرُهُمْ وَلَوْ فَصَّلْتُهَا","طَالَتْ وَظَلَّ الْوَصْفُ غَيْرُ مُتَمِّمِ",17,"م",1,0],["كَثيرُ الحَصى عالٍ لِمَن فَوقَ ظَهرِها","بِهامَةِ مُلكٍ يَفنَخُ الناسَ مُقرَمِ",18,"م",1,0],["كَثيرٍ لِما يَترُكنَ في كُلِّ جُفرَةٍ","زَفيرُ القَواضي نَحبُها وَسُعالُها",19,"ل",3,0],["كثرت دوائرها وقلّ فَعالها","كالطبل يكبُر وهو خال أجوف",20,"ف",1,0],["كَثُروا عَلَيَّ فَما يَموتُ كَبيرُهُم","حَتّى الحِسابِ وَلا الصَغيرُ المُرضَعُ",21,"ع",1,0],["كثرَ أعدائي بإعراضهِ","وفي الرِّضا كثرَ حسَّادي",22,"ي",1,0],["كثير الأيادي البيض في كلِّ مقصدٍ","إذا ما غدت تسعى على الطرس حمره",23,"ر",2,0],["كثير السرى ما بين مشتجر القنا","فيالك ليثاً سائراً في عرينه",24,"ن",2,0],["كثير السعي في شرف ومجدٍ","قليل الشكو من ضجرٍ وأين",25,"ن",1,0],["كثر الخبيثُ من النبات فهُذِّبتْ","منه الأَطايبُ وهي بعدُ ستَخبُثُ",26,"ث",1,0],["كثُر الأُلى يهجونه","جِدّاً وَقَلَّ الممتَدِحْ",27,"ح",1,0],["كثير نوالك في جنب ما","جُبِلتَ عليه من الجود نَزْرُ",28,"ر",1,1],["كثيفةٍ في النباتِ وافرةٍ","أوْفت على طوله بأشبار",29,"ر",1,0],["كثير الضحك فالشفتا","ن منه ليس تنطبق",30,"ق",1,0],["كثرَ الثرى بجنوده","لكنْ محقْتَهمُ فقلّوا",31,"ل",3,0],["كثرتْ معاني المدحِ فيك فهيَّأتْ","للمادحِ التكثير والتطويلا",32,"ل",2,0],["كثُرتْ موبقات بوران حتَّى","ضاقَ عنها عفوُ الغفورِ الرحيم",33,"م",1,0],["كثُرَتْ فتوحُ أميرِنا وتتابعتْ","فجزاهُ ربُّ الناسِ دارَ كرامتِهْ",34,"ت",2,1],["كَثِّرْ بشخصي مَنِ اصطنَعْتَ من ال","ناس وإن لم أَزِنْكَ لم أشِن",35,"ن",1,0],["كثُرتْ في العُلا معانيك حتى","أَعْوَزَتْنا أسماءُ تلك المعاني",36,"ن",2,0],["كَثيرٌ بِكَفَّيهِ النَدى حينَ يُعتَرى","عَشِيَّةَ لا جافٍ وَلا بِغَضوبِ",37,"ب",1,0],["كَثُرَ النائِحونَ حَولَكِ حَتّى","خِلتُ أَنّي في حاجَةٍ لِلعَزاءِ",38,"ا",2,0],["كَثيرُ الهُمومِ بِلا ناصِرٍ","كَسيرُ الفُؤادِ بِلا جابِرِ",39,"ر",1,0],["كَثُلوجِ الجبال يغمرُها النُّورُ","وتَسمو على غُبارِ الصَّعيدِ",40,"د",1,0],["كثر الألى قد أبنوك دفنيا","والباكيات عليك والباكونا",41,"ن",2,1],["كثر الناقدو قريضك بالباطل","سترا لصدقه بالكذب",42,"ب",1,0],["كثر الألى قد انبوك دفينا","والباكيات عليك والباكونا",43,"ن",2,0],["كثر الناشؤون في كل فن","غير ان الكفاة غير كثار",44,"ر",1,0],["كثرت سهام الرائشين وإنما","أرسلت سهمك نافذا مسموما",45,"م",2,0],["كَثُرَت عَلَيها الطَيرُ في حَوماتِها","يا طَيرُ كُلُّ الصَيدِ في جَوفِ الفَرا",46,"ر",2,0],["كَثيرَةَ باغي السَبقِ لَم يُرَ مِثلُها","عَلى عَهدِ إِسماعيلَ ذي الطولِ وَالنالِ",47,"ل",1,0],["كَثُرَت عَلَيكَ أَكُفُّهُم في صَوبِها","فَكَأَنَّها قِطَعُ الغَمامِ المُمطِرِ",48,"ر",1,0],["كَثُرَت عَلى دارِ السَعادَةِ زُمرَةٌ","مِن مِصرَ أَهلُ مَزارِعٍ وَيَسارِ",49,"ر",1,0],["كَثيرُ حَياةِ المَرءِ مِثلُ قَليلِها","يَزولُ وَباقي عَيشِهِ مِثلُ ذاهِبِ",50,"ب",1,0],["كَثَرَ الفِكرُ كَيفَ نُهدي كَما أَه","دَت إِلى رَبِّها الرَئيسِ عِبادُه",51,"د",2,0],["كَثيرُ سُهادِ العَينِ مِن غَيرِ عِلَّةٍ","يُؤَرِّقُهُ فيما يُشَرِّفُهُ الفِكرُ",52,"ر",1,0],["كَثُرَ الَّذي نِلناهُ مِن","نُعماكَ حَتّى مانَحُدُّه",53,"د",2,0],["كَثَّرَ الناسُ في هَوانا وَقالوا","فيهِ قَولاً يُرضي الوُشاةَ إِقتِصاصُه",54,"ص",2,0],["كَثَّرتَ وَفري بَعدَ إِقلالِ","وَزِدتَ مِن حالِكَ في حالي",55,"ي",1,1],["كَثيرُ جِهاتِ الرَأيِ مُفتَنَّةٌ بِهِ","إِلى عَدَدٍ لا يَنتَهي صُوَرُ الحَزمِ",56,"م",1,0],["كَثيرُ التَلَفُّتِ وَالاِعتِرا","ضِ شَديدُ التَفَلُّتِ وَالهَمهَمَه",57,"م",2,0],["كَثيبُ رَملٍ عَلى عَليائِهِ فَنَنٌ","وَشَمسُ دَجنٍ بِأَعلى ذَلِكَ الفَنَنِ",58,"ن",1,0],["كَثيراً مِنَ الأَسرى الَّتي قَد تَكَنَّعَت","فَكَكتَ وَأَعناقاً عَلَيها غِلالُها",59,"ل",3,0],["كَثيرِ الحَصى جَمِّ الوَغى بالِغِ العِدى","يُصَمُّ السَميعَ رَزُّهُ وَهَماهِمُه",60,"م",2,0],["كَثيرِ وَغى الأَصواتِ تَسمَعُ وَسطَهُ","وَئيداً إِذا جَنَّ الظَلامُ وَحادِيا",61,"ي",2,0],["كَثُرَتْ مواهبُه وقلْ","لَتْ عند طالبِها المَعاذِر",62,"ر",1,0],["كَثُرِتْ محاسِنُها وقلَّ كلامُها","فأتتْكَ تُخْبِرُ عن مُقِلٍّ مُكْثِرِ",63,"ر",1,0],["كَثَّرَ اللَهُ مِثلَ مَجدِكَ في الأَر","ضِ لِتَفشو صَنائِعُ الإِحسانِ",64,"ن",1,1],["كَثيرِ التَجَنّي لَستُ أَلقاهُ شاكِراً","عَلى مَضَضٍ إِلّا وَأُلفيهِ شاكِيا",65,"ي",2,0],["كثرت ضحاياه وطال قيامُه","وصيامه فمتى رضاءَك تَمنحُ",66,"ح",1,0],["كثر الهجر على القلب فهل","من سلو أو بعاد يرتضيه",67,"ه",1,0],["كثرت عليّ متاعبي فمحونني","ومحون حتى السقم والأوجاعا",68,"ع",2,0],["كثرتْ في الحبّ بها عللي","فظهرتُ أسىً وخفيتُ ضنى",69,"ن",2,0],["كَثُرَ الخُلْفُ ومن دانَ به","وعلى فضلِكَ للنّاسِ اصطلاح",70,"ح",1,0],["كثيرُ وفودِ القصْدِ لم تكفِ دجلةٌ","بِسَاحَتِهِ لِلآكِلينَ شَرابا",71,"ب",2,0],["كَثرَةُ الصُفرِ يَمنَةً وَشِمالاً","أَضعَفَت في نَفاسَةِ العُقبانِ",72,"ن",1,0],["كَثيراً ما تُشَوِّقُهُ العَوالي","وَهِمَّتُهُ إِلى العَلَقِ المُتاعِ",73,"ع",1,0],["كَثُرَت بِهِ حَرَكاتُها وَلَقَد تُرى","مِن فَترَةٍ وَكَأَنَّها تَتَفَكَّرُ",74,"ر",1,0],["كَثُرَت خَطايا الدَهرِ فِيَّ وَقَد يُرى","بِنَداكَ وَهوَ إِلَيَّ مِنها تائِبُ",75,"ب",1,0],["كَثُرُوا عِدَّةً وَلَوْ أَحْصَنَ الْبَا","بَ أَبُوهُمْ عَنِ الزُّنَاةِ لَقَلُّوا",76,"ل",3,0],["كثيرُ الجنونِ مسيءُ الظنونِ","عدوُّ الفنونِ لظى محرِقُ",77,"ق",1,1],["كَثيرٌ مِنَ العُذّالِ ما يَترِكونَني","لَعَمرُكِ ما في العاذِلينَ كَئيبُ",78,"ب",1,1],["كَثُرتْ لغاتُ العالمين وهذه","أوفىَ بياناً في اللّسانِ وفي الفمِ",79,"م",1,0],["كَثُرَت ظُنونُ الجاهِلينَ وَقَلَّما","تَبقى إِذا وَضَحَ اليَقينُ ظُنونُ",80,"ن",1,0],["كثيرُ النَّوالِ رَحِيبُ المجالِ","إذا رَامَ مَنزلةً نالَها",81,"ل",3,0],["كَثَمودَ الَّتي تَفتَكَت الدينَ","عُتّياً وَأُمَّ سَقبٍ عَقيرا",82,"ر",2,1],["كَثيرَةِ الأَديانِ وَالأَإِمَّه","وَهَمُّها تَشتيتُ أَمرِ الأُمَّه",83,"ه",1,0],["كَثُرَ الشَّاهِدُونَ لِي أَنَّني مت","تُ وفي البُعدِ عنه قَلَّ عَذِيرِي",84,"ر",2,0],["كثيرُ دليلِ الخيرِ في الوجهِ واضحٌ","جميلُ المحيا واللسانُ طليق",85,"ق",1,0],["كثيرٌ رزاياهمْ قليلٌ عديدُهم","وكانوا حصى الدهناء جمعاً إذا عُدُّوا",86,"د",3,0],["كثيرُ جِهاتِ الحسنِ تَهمي جداولاً","ولكنّها بين المحاجر ثُوَّخ",87,"خ",1,0],["كثيرُ وجوه الحزْم أردى به العِدى","وأنحى به ليْثَ العَرينَةِ فانتحى",88,"ح",2,0],["كَثيبٌ عَلاهُ غُصنُ بانٍ إِذا مَشى","تَكادُ لَهُ صُمُّ الجِبالِ تُنيبُ",89,"ب",1,0],["كَثيرَةَ الضيفانِ مِن عُفاتِها","تَقذِفُ جالاها بِجَوزِ شاتِها",90,"ت",3,0],["كَثِّري السَهوَ في الكِتابِ وَمُجّي","هِ بِريقِ اللِسانِ لا بِالبَنانِ",91,"ن",1,0],["كَثُرَت حَولَكَ الوفودُ وَقَد جِئ","نا قَصيراً هَذا أَوانُ الصَيورِ",92,"ر",1,0],["كَثُرَت مَواهِبُهُ الكِبا","رُ لِصادِرٍ مِنّا وَوارِد",93,"د",