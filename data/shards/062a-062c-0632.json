{"poems":[[55,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[33,"هاج فؤادي موقف","https://www.aldiwan.net/poem42226.html","مجزوء الرجز"],[203,"مضى والتقى نجمين في أفق جدا","https://www.aldiwan.net/poem45160.html","الطويل"],[445,"لعلك يا شمس عند الأصيل","https://www.aldiwan.net/poem34889.html","المتقارب"],[463,"سل في الغضا وصبا الأصائل تنفح","https://www.aldiwan.net/poem56248.html","الكامل"],[556,"صدت وما صدها إلا على ياس","https://www.aldiwan.net/poem47749.html","البسيط"],[580,"عسى أن يسر السائرين إياب","https://www.aldiwan.net/poem3102.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138280",""],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84506","البسيط"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99061","الرجز"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126231","المتدارك"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22553","البسيط"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121328","الرجز"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35866","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129479","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216812","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103000","الوافر"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83177","البسيط"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104530","الطويل"],[4858,"أبكي المروءة","https://www.poetsgate.com/ViewPoem.aspx?id=33887",""],[5510,"قلبي يحنُّ إليك","https://www.poetsgate.com/ViewPoem.aspx?id=205642",""],[5895,"فمن يا قلب قد بدأ البعادا؟","https://www.poetsgate.com/ViewPoem.aspx?id=214126",""],[5937,"في الفُستان","https://www.poetsgate.com/ViewPoem.aspx?id=211817",""],[4442,"هي الذكوات البيض من جانب الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=171009",""]],"verses":[["تَجزيكَ في الصُبحِ وَتَس","تَغني بِها عَنِ الظُلَم",0,"م",1,0],["تَجزي بِمِثلِ وُدِّنا","قُلتُ لَها بَل أُضعِفُ",1,"ف",1,0],["تجزئنا الأيام في حركاتها","فإن تركت فرداً فقد أخذت فردا",2,"د",2,0],["تَجزَّأَ من جَنَّتَيْ مأْرَبٍ","بِخَمْطٍ وأَثْلٍ وسِدْرٍ قليلِ",3,"ل",1,0],["تَجزي الرجالَ بصدقهم فصديقُها","في غِبطةٍ وعدوُّها لا يفرحُ",4,"ح",1,0],["تجزين وَصْلي بهجرٍ منك يمزج لي","كَأسَ المُنى وَهْيَ صِرْفُ الطّعم بالياسِ",5,"س",1,0],["تجُزُّ مَعانيه الرقابَ فَقَد غدا","يُخَيَّل لي أَن الكتابَ قِرابُ",6,"ب",1,0],["تُجزى حميد الفعل خير جزا كما","شرفاً له غرُّ السطور تسطر",7,"ر",1,0],["تجزى بواحدة عشراً وتسلم إن","أكثرتَ منها من الطاعون والسَقَمِ",8,"م",1,0],["تجزع من أمثالها الأحباب","وكنت لو طالت بك الأوصاب",9,"ب",1,0],["تجزَع فى الحربِ من الرَّهَجِ","وإذا أصبحتَ فتًى أسَداً",10,"د",2,0],["تَجزُرُ بِالشِّلِسِّ يَا رُبَّانِي","مِنهَا يَدُورُ البَرُّ بالإِيقَانِ",11,"ن",1,0],["تُجزى السِواكَ عَلى عَذبٍ مُقَبَّلُهُ","كَأَنَّهُ مُنهَلٌ بِالراحِ مَعلولُ",12,"ل",1,0],["تجزعها مجرَّةٌ","من قُطُبٍ إلى قُطُب",13,"ب",1,0],["تُجزَ الجَزيلُ مِنَ الثَوابِ مُضاعَفاً","إِنَّ القَديرَ لِما يُريدُ لَفاعِلُ",14,"ل",1,0],["تجزى الأيادي بحسن الشكر عادتها","إلا أياديه لا شكر يجازيها",15,"ي",3,0],["تجزي الشعوب إذا قدرن وإنما","نشكو بمصر تعذر الإمكان",16,"ن",1,0],["تجز بهم نواصي الخيل جزّاً","ويصفع للملوك بهم قذال",17,"ل",1,0],["تَجزِي إِساءَتَهُم أَضعافَها صِلَةً","كَأَنَّما نَفَثَت في قَلبِكَ الرُّسُلُ",18,"ل",1,0],["تجزء من حصبائها كل لامع","كما يتجزى بيننا الجوهر الفرد",19,"د",1,0],["تجزي الإساءَة بالإحسانِ صابرةً","كذا المروءةُ في أعلى مراقيها",20,"ي",3,0],["ﻻ تجزعنَّ فلن أكون حليلةً","لسواك إني في الهوى ﻻ أدّعي",21,"ع",2,0],["تُجَزِّىءُ فِى الضُّلُوعِ طِوَالَ وَقْتٍ","وَتَزْرَعُ فِى ثَنَايَاهَا سُهَادَا",22,"د",2,0],["تجزأتُ في عينيكِ حتى تورّطتْ","مشاعِرُنا في لهفةٍ لا تُجَزَّأُ",23,"ا",1,0],["تجزأ من حصبائها كل لامع","كما يتجزى بيننا الجوهر الفرد",24,"د",1,0]]}