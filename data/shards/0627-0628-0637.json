{"poems":[[95,"فجع القريض وقد ثوى حسان","https://www.aldiwan.net/poem11217.html","البسيط"],[39,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[93,"أيار يا شاعر الشهور","https://www.aldiwan.net/poem8836.html","عموديه"],[58,"أبطا الرسول فظلت أنتظر","https://www.aldiwan.net/poem58593.html","أحذ الكامل"],[47,"يا خليلي بل لست لي بخليل","https://www.aldiwan.net/poem65615.html","الخفيف"],[47,"أبطل الدمع حجة الكتمان","https://www.aldiwan.net/poem66841.html","الخفيف"],[107,"من لي بملء المشرقين بيانا","https://www.aldiwan.net/poem41940.html","الكامل"],[107,"خلوا سبيل الشاعر المتدفع","https://www.aldiwan.net/poem42071.html","الكامل"],[107,"خوضوا الوغى يا أهل وادي القرى","https://www.aldiwan.net/poem44051.html","السريع"],[83,"ضللت بالبدر على نوره","https://www.aldiwan.net/poem61517.html","السريع"],[54,"منزل أقوى بسلمى وربوع","https://www.aldiwan.net/poem26865.html","الرمل"],[52,"أسعاد جودي لا شفيت سعادا","https://www.aldiwan.net/poem63955.html","الكامل"],[78,"ختمت فأرة مسك","https://www.aldiwan.net/poem39242.html","مجزوء الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39607","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142404","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54534","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[108,"إلى الغزاة الهادمين","https://www.poetsgate.com/ViewPoem.aspx?id=179650",""],[98,"طارق بن زياد في طريقه للأندلس","https://www.poetsgate.com/ViewPoem.aspx?id=17510",""],[93,"الفقير","https://www.poetsgate.com/ViewPoem.aspx?id=53421",""],[123,"أتراه يترك الغزلا","https://www.aldiwan.net/poem4341.html","المديد"],[147,"أما الزمان ففي يديك عنانه","https://www.aldiwan.net/poem11830.html","الكامل"],[203,"هل لذا الجفا سبب","https://www.aldiwan.net/poem45523.html","المقتضب"],[231,"إلى البلاد الشقيقة","https://www.aldiwan.net/poem24225.html","عموديه"],[369,"وطالع من مشرق القباء","https://www.aldiwan.net/poem61019.html","الرجز"],[458,"أبطال غزة بعد قبية هللوا","https://www.aldiwan.net/poem61237.html","البسيط"],[458,"الفتنة الكبرى تطل قرونها","https://www.aldiwan.net/poem61287.html","الكامل"],[543,"رتب العز وعز الرتب","https://www.aldiwan.net/poem47425.html","عموديه"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64367","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19990","الرمل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69371","البسيط"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202063","الخفيف"],[2467,"","https://poetry.dctabudhabi.ae/diwan/poem/111730","المتقارب"],[2556,"","https://poetry.dctabudhabi.ae/diwan/poem/198705","السريع"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75900","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205430","السريع"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136999",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201755","الخفيف"],[3207,"","https://poetry.dctabudhabi.ae/diwan/poem/144657","السريع"],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70362","الخفيف"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97968","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74036","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52990","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123501","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81265","الخفيف"],[4277,"","https://poetry.dctabudhabi.ae/diwan/poem/124303","الخفيف"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58034","البسيط"],[4680,"حتى يذهب الزبدُ","https://www.poetsgate.com/ViewPoem.aspx?id=185028",""],[4728,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=176976",""],[4788,"هب البراد","https://www.poetsgate.com/ViewPoem.aspx?id=132251",""],[4869,"تقلدني وتحكي معايه","https://www.poetsgate.com/ViewPoem.aspx?id=151519",""],[4987,"قالو حبيبك","https://www.poetsgate.com/ViewPoem.aspx?id=49556",""],[5008,"الضيقة","https://www.poetsgate.com/ViewPoem.aspx?id=27301",""],[5045,"أنا يماني وصيتي كل من يعرفه","https://www.poetsgate.com/ViewPoem.aspx?id=185721",""],[5376,"للقدس عين من الاشواق لم تنم","https://www.poetsgate.com/ViewPoem.aspx?id=188549",""],[5376,"توشَّحَ الليلُ في أغوارِ لوحاتي","https://www.poetsgate.com/ViewPoem.aspx?id=205053",""],[5455,"يبه","https://www.poetsgate.com/ViewPoem.aspx?id=34696",""],[5484,"هذي الطلول فقف بنا يا ساري","https://www.poetsgate.com/ViewPoem.aspx?id=206304",""],[5582,"دَعِينِي وَيْكِ عاذِلَتِي دَعِينِي","https://www.poetsgate.com/ViewPoem.aspx?id=187306",""],[5605,"معلقة الخليفة","https://www.poetsgate.com/ViewPoem.aspx?id=159729",""],[5648,"صالي الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=158300",""],[5652,"بجروح صدر الشمري","https://www.poetsgate.com/ViewPoem.aspx?id=164386",""],[5739,"ياغايبه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131706",""],[5739,"نظرتك فم ...!","https://www.poetsgate.com/ViewPoem.aspx?id=155470",""],[5764,"حبيت أنبّه !","https://www.poetsgate.com/ViewPoem.aspx?id=159090",""],[5848,"اشك إنه صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=53202",""],[5943,"أبطالَ غزَّة","https://www.poetsgate.com/ViewPoem.aspx?id=11284",""],[5956,"حربُ تَشرين التحريرية","https://www.poetsgate.com/ViewPoem.aspx?id=194123",""],[5966,"ياموطن الخير","https://www.poetsgate.com/ViewPoem.aspx?id=158435",""],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""]],"verses":[["أَبْطَالُ صِدْقٍ مَا بِهِمْ مِنْ لُوثَةٍ","يَوْمَ الحِفَاظِ وَمَا لَهُمْ أَقْرَانُ",0,"ن",1,0],["أَبطَحِيِّيينَ أريَحِيينَ كالأَن","جُمِ ذاتِ الرُّجُومِ والأَعلاَمِ",1,"م",1,0],["أبطَحِيٌّ بِمَكَّةَ استَثقَبَ الِلَّ","هُ ضِيَاءَ العَمَى به والظَّلاَمِ",1,"م",1,0],["أَبطَأَ في السَيرِ عَقرَباها","فَأَبطَأَ الوَقتُ في المَسيرِ",2,"ر",1,0],["أَبْطَا الرَّسُولُ فَظِلْتُ أَنْتَظِرُ","لا النّوْمُ يأْخُذُني ولا السّهَرُ",3,"ر",1,1],["أَبطَأَت حاجَتي وَمَوقِعُها مِن","كَ دَليلٌ فيها عَلى التَعجيلِ",4,"ل",1,0],["أَبطَلَ الدَمعُ حُجَّةَ الكِتمانِ","وَإِستَراحَ الكَرى مِنَ الأَجفانِ",5,"ن",1,1],["أبطالُ سعدٍ يعرفون مُحمّداً","أيَّ الرّجالِ على الشّدائدِ كانا",6,"ن",2,0],["أبطالُ مصرَ تَداركوا آمالَها","واليأسُ مِلءُ فؤادِها والأضلعِ",7,"ع",1,0],["أبطالُ حربٍ لم يَزَلْ بأسُهُم","يَلْتَهِمُ العَسْكَرَ فالعَسْكَرَا",8,"ر",2,0],["أَبطَلَ موسى السِحرَ فيما مَضى","وَجاءَ موسى اليَومَ بِالسِحرِ",9,"ر",1,0],["أَبطِ ما شِئتَ وَسِر سَيراً رُوَيدا","إِنَّ سَيرَ الدَهرِ بِالمَرءِ سَريعُ",10,"ع",1,0],["أَبِطَرفِ مُقلَتِكِ المَريضَةِ صِدتِهِ","ما إِن سَمِعتُ بِمِثلِهِ مُصطادا",11,"د",2,0],["أبطلتْ كلَّ يمانيْ","يٍ وشاميٍّ ومكِّي",12,"ك",2,0],["أبطالُ يونانٍ على أمواجه","يطوون كل مفازة وفضاءِ",13,"ا",2,0],["أبطر الحاقدين حلم أبي حسّان","والحلم أن تقيل الصديقا",14,"ق",2,0],["أَبْطَالُ تَفْدِيَةٍ لَقُوا جُهْدَ الأَذَى","في اللهِ وَامْتَنَعُوا مِنَ الإِيذاءِ",15,"ا",2,0],["أَبطَالُ تَفْدِيَةٍ لَقُوا جُهْدَ الأَذَى","فِي الحَقِّ وَامْتَنَعُوا مِنَ الإِيذَاءِ",16,"ا",2,0],["أبطالُكَ الصيدُ الكُماةُ مَناصِلٌ","طُبِعتْ ليوم كريهةٍ وتلاحي",17,"ح",2,0],["أبطال «دَنكِركَ» خاضوا الحرب طاحنةً","في «كفر أحمدَ»: لا جُبنٌ، ولا خَورُ",18,"ر",1,0],["أبطالُ يونانٍ على أمْواجِهِ","من قَبلُ لَابْنُ الواحةِ العَذْراءِ",19,"ا",2,0],["ابطر الأنام من السرور وعندهم","ان السرور مرادف العنقاء",20,"ا",2,0],["أبطل الحقَّ الذي يبدي","سحر عينيها وما بطلا",21,"ل",2,0],["أَبطالُ صَعصَعَةٍ حُماةُ رَبيعَةٍ","في حَيثُ يُزري بِالجِبانِ جَنانُهُ",22,"ن",2,0],["أبطأوا بزفتها","والزفافُ مرتقبُ",23,"ب",1,0],["أبطال الاستقلال تلك تحية","من مصر يبعثها فؤاد مفعمُ",24,"م",1,0],["أبطَؤُها يَخطِفُ عينَ الرائي","ويُتْبِعُ الأعدادَ بالإحصاء",25,"ا",2,0],["أبطال غزة بعد قبية هللوا","إن المخازي الموبقات فخاركم",26,"م",1,1],["أبطال قبية أنتمو وكفاكمو","فخرا بتدمير لكم تمدينها",27,"ن",3,0],["أبطلت ألفاظها سحر الدمى","نعس الدعج ودعج النعس",28,"س",1,0],["أبطحيٌ ما إن حوى","مثله قسط أبطح",29,"ح",1,0],["إبطا وإفوا ثم إصراف تلا","إكفا وتضمين ساد فصلا",30,"ل",2,0],["أَبطَرَتهُ دَعَةُ النِع","مَةِ وَالعِزُّ النَميرُ",31,"ر",1,0],["أَبطالُ حَربٍ وَإِن حاوَلتَ فَضلَهُمُ","في السِلمِ أَلفَيتَ مِنهُم غَيرَ اِبطالِ",32,"ل",1,0],["أبطل السر من ذويه بسحر","من سماء الإعجاز فيه كوكب",33,"ب",1,0],["أبطحاءَ مكّةَ هذا الذي","أراهُ عِياناً وهذا أنا",34,"ن",2,1],["أبطأت بالإذن على عبدكا","فعاذ بالمعروف من نجدكا",35,"ك",2,1],["أَبطَحِيٌّ فَخارُهُ عُمريٌّ","مَحيَوِيٌ لَهُ المَكارِمُ تُسنَد",36,"د",1,0],["أبٌ طريح في فراش الضنى","أقضّ في رقدته المضجع",37,"ع",1,0],["ابطال بسيوفهم عنا أزالوا الترح","من بعد ما كان فينا حاكمين قرود",38,"د",1,0],["أبطئي السيرَ يا رياح الخريف","لم نودّع للآن لَهْوَ المصيف",39,"ف",1,1],["أبطل ما كان العدا أملوا","رميك بالخيل وأبطالها",40,"ل",3,0],["أَبُطَحِيٌّ لَهُ منَ النَّسبِ الوا","فر فخرٌ تنمَى بِهِ أجْدَادُه",41,"د",2,0],["أبطال مصر بموقف","بالأمس للتاريخ باق",42,"ق",1,1],["أَبطلتَ حجّتهم بأو","ضَح حجّة تسم الجَبينا",43,"ن",2,0],["أبطحيٌّ لولاه ما فاحَ من مك","ة عرفُ التعريف في عرفات",44,"ت",1,0],["أبطل الباطل لا يؤذي الورى","وأحق الحق يودي بالصميم",45,"م",1,0],["إبطالك النقيض وهو آئل","للأقتراني وما يقابل",46,"ل",1,0],["أبطلت زخرف الاباطيل اذصا","ربها في الوجود عرضة هازى",47,"ز",2,0],["أَبطَرتهم بِلادُنا فَتَعالى أَب","ن أَثينا وَاستكبر الأَرمَني",48,"ن",2,0],["أبطحيّ بريقه يعذب المل","ح وتشفى بلمسه الأدواء",49,"ا",2,0],["أبطلْ جميعَ قعادات الضمان إذاً","وكلّ ما سنّهُ الماضُونَ من ضَرَرِ",50,"ر",1,0],["أبطالُ بغداد والتاريخ يعرفهمْ","ما ضيّعوا حقهمْ يوماً ولا قعدوا",51,"د",3,0],["أبطيت عن ديرتْك ما كنّ لك أمّ!","وطاحت دموعي قلت لبيك سمّي",52,"م",2,0],["أبطيت وأبطى الشوق وسط السراجيف","مسجون ما زاره أحد غير حبري",53,"ر",2,0],["ابطلبك في وصلنا لاتمسّين","هاتِ الصباح ان جيتلك من ورايه",54,"ا",3,0],["ابطى وهو غايب وزلت حراويه","وأنا من العام آتحرى مزونه",55,"ن",2,0],["أبطلب اللي مايخيّب رجايا","وأبرفع يديني مع الصوت مبحوح",56,"ح",1,0],["أبطش ببطشي على الجبار واوقفه","وألوي ذراع الذي يسطو عليا اقطعة",57,"ع",2,0],["أبطال معركة بالحق ما سكنوا","نادوا صلاحا يعيد الحق من خصم",58,"م",1,0],["أبطيءْ بمشيك إنَّ الأرضَ تسكنها","روح الشهيد وقد زفَّتْ بآياتِ",59,"ت",1,0],["ابطى قصيدي ماانكتب فيك وابطيت","اجر صوتي وارجع اجر صمته",60,"ت",2,0],["أبطال حرب عند مشتبك القنا","وتلين من فرق يد الجبار",61,"ر",1,0],["أَبٍ طاشَتْ سَكِينَتُهُ فأَمْسَى","مَعَ الأَصْحابِ يُنْسَبُ لِلجُنُونُ",62,"ن",1,0],["أبطالنا كانت نواياهم شريفة","فتحالفوا.. وتآلفوا ..",63,"ف",3,0],["ابطيت انا واقف واراعي خطاويه","خطاويٍ شالت معه عيني ترعاه",64,"ا",2,0],["ابطيت ماطليت في طلّتك يوم","وشلون عينك تهتني في منامك",65,"ك",1,0],["ابطيت ياللي متعب القلب فرقاك.","ابطيت يالولٍ بجوفي تلالا.",66,"ل",2,1],["ابطيت واقف.! ماشكت وقفتي كم.","والعين فيها مْن الغلا سر مفضوح.",67,"ح",1,0],["ابطلب من الله ربي وربه","يسعد حياته كثر ماحقق مناي",68,"ا",2,0],["أبطيت اكابد والعذاب الحقيقي :","ولادة الألام من رحم الآمال !",69,"ل",1,0],["أبطالَ غزَّةَ..قلبي اليوم يغزلُكم","بمغزلِ الحزنِ أوجاعًا ويبكيكمْ",70,"م",1,1],["أبطالنا معجزات الحربِ والسَّلَمِ","رمز الشجاعةِ من أيام معتصمِ",71,"م",1,1],["أبطالنا في ولاءٍ نحو قادتنا","لانتبع الظلمَ أو نسعى إلى الوهنِ",72,"ن",1,0],["أبطالها أصبحوا أبطال معركة","وهمية ليس فيها البيض واليلب",73,"ب",1,0]]}