{"poems":[[93,"فجع القريض وقد ثوى حسان","https://www.aldiwan.net/poem11217.html","البسيط"],[37,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[91,"أيار يا شاعر الشهور","https://www.aldiwan.net/poem8836.html","عموديه"],[56,"أبطا الرسول فظلت أنتظر","https://www.aldiwan.net/poem58593.html","أحذ الكامل"],[45,"يا خليلي بل لست لي بخليل","https://www.aldiwan.net/poem65615.html","الخفيف"],[45,"أبطل الدمع حجة الكتمان","https://www.aldiwan.net/poem66841.html","الخفيف"],[105,"من لي بملء المشرقين بيانا","https://www.aldiwan.net/poem41940.html","الكامل"],[105,"خلوا سبيل الشاعر المتدفع","https://www.aldiwan.net/poem42071.html","الكامل"],[105,"خوضوا الوغى يا أهل وادي القرى","https://www.aldiwan.net/poem44051.html","السريع"],[81,"ضللت بالبدر على نوره","https://www.aldiwan.net/poem61517.html","السريع"],[52,"منزل أقوى بسلمى وربوع","https://www.aldiwan.net/poem26865.html","الرمل"],[50,"أسعاد جودي لا شفيت سعادا","https://www.aldiwan.net/poem63955.html","الكامل"],[76,"ختمت فأرة مسك","https://www.aldiwan.net/poem39242.html","مجزوء الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39607","الكامل"],[94,"","https://poetry.dctabudhabi.ae/diwan/poem/142404","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54534","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[106,"إلى الغزاة الهادمين","https://www.poetsgate.com/ViewPoem.aspx?id=179650",""],[96,"طارق بن زياد في طريقه للأندلس","https://www.poetsgate.com/ViewPoem.aspx?id=17510",""],[91,"الفقير","https://www.poetsgate.com/ViewPoem.aspx?id=53421",""],[120,"أتراه يترك الغزلا","https://www.aldiwan.net/poem4341.html","المديد"],[144,"أما الزمان ففي يديك عنانه","https://www.aldiwan.net/poem11830.html","الكامل"],[200,"هل لذا الجفا سبب","https://www.aldiwan.net/poem45523.html","المقتضب"],[227,"إلى البلاد الشقيقة","https://www.aldiwan.net/poem24225.html","عموديه"],[365,"وطالع من مشرق القباء","https://www.aldiwan.net/poem61019.html","الرجز"],[454,"أبطال غزة بعد قبية هللوا","https://www.aldiwan.net/poem61237.html","البسيط"],[454,"الفتنة الكبرى تطل قرونها","https://www.aldiwan.net/poem61287.html","الكامل"],[539,"رتب العز وعز الرتب","https://www.aldiwan.net/poem47425.html","عموديه"]],"verses":[["أَبْطَالُ صِدْقٍ مَا بِهِمْ مِنْ لُوثَةٍ","يَوْمَ الحِفَاظِ وَمَا لَهُمْ أَقْرَانُ",0,"ن",1,0],["أَبطَحِيِّيينَ أريَحِيينَ كالأَن","جُمِ ذاتِ الرُّجُومِ والأَعلاَمِ",1,"م",1,0],["أبطَحِيٌّ بِمَكَّةَ استَثقَبَ الِلَّ","هُ ضِيَاءَ العَمَى به والظَّلاَمِ",1,"م",1,0],["أَبطَأَ في السَيرِ عَقرَباها","فَأَبطَأَ الوَقتُ في المَسيرِ",2,"ر",1,0],["أَبْطَا الرَّسُولُ فَظِلْتُ أَنْتَظِرُ","لا النّوْمُ يأْخُذُني ولا السّهَرُ",3,"ر",1,1],["أَبطَأَت حاجَتي وَمَوقِعُها مِن","كَ دَليلٌ فيها عَلى التَعجيلِ",4,"ل",1,0],["أَبطَلَ الدَمعُ حُجَّةَ الكِتمانِ","وَإِستَراحَ الكَرى مِنَ الأَجفانِ",5,"ن",1,1],["أبطالُ سعدٍ يعرفون مُحمّداً","أيَّ الرّجالِ على الشّدائدِ كانا",6,"ن",2,0],["أبطالُ مصرَ تَداركوا آمالَها","واليأسُ مِلءُ فؤادِها والأضلعِ",7,"ع",1,0],["أبطالُ حربٍ لم يَزَلْ بأسُهُم","يَلْتَهِمُ العَسْكَرَ فالعَسْكَرَا",8,"ر",2,0],["أَبطَلَ موسى السِحرَ فيما مَضى","وَجاءَ موسى اليَومَ بِالسِحرِ",9,"ر",1,0],["أَبطِ ما شِئتَ وَسِر سَيراً رُوَيدا","إِنَّ سَيرَ الدَهرِ بِالمَرءِ سَريعُ",10,"ع",1,0],["أَبِطَرفِ مُقلَتِكِ المَريضَةِ صِدتِهِ","ما إِن سَمِعتُ بِمِثلِهِ مُصطادا",11,"د",2,0],["أبطلتْ كلَّ يمانيْ","يٍ وشاميٍّ ومكِّي",12,"ك",2,0],["أبطالُ يونانٍ على أمواجه","يطوون كل مفازة وفضاءِ",13,"ا",2,0],["أبطر الحاقدين حلم أبي حسّان","والحلم أن تقيل الصديقا",14,"ق",2,0],["أَبْطَالُ تَفْدِيَةٍ لَقُوا جُهْدَ الأَذَى","في اللهِ وَامْتَنَعُوا مِنَ الإِيذاءِ",15,"ا",2,0],["أَبطَالُ تَفْدِيَةٍ لَقُوا جُهْدَ الأَذَى","فِي الحَقِّ وَامْتَنَعُوا مِنَ الإِيذَاءِ",16,"ا",2,0],["أبطالُكَ الصيدُ الكُماةُ مَناصِلٌ","طُبِعتْ ليوم كريهةٍ وتلاحي",17,"ح",2,0],["أبطال «دَنكِركَ» خاضوا الحرب طاحنةً","في «كفر أحمدَ»: لا جُبنٌ، ولا خَورُ",18,"ر",1,0],["أبطالُ يونانٍ على أمْواجِهِ","من قَبلُ لَابْنُ الواحةِ العَذْراءِ",19,"ا",2,0],["ابطر الأنام من السرور وعندهم","ان السرور مرادف العنقاء",20,"ا",2,0],["أبطل الحقَّ الذي يبدي","سحر عينيها وما بطلا",21,"ل",2,0],["أَبطالُ صَعصَعَةٍ حُماةُ رَبيعَةٍ","في حَيثُ يُزري بِالجِبانِ جَنانُهُ",22,"ن",2,0],["أبطأوا بزفتها","والزفافُ مرتقبُ",23,"ب",1,0],["أبطال الاستقلال تلك تحية","من مصر يبعثها فؤاد مفعمُ",24,"م",1,0],["أبطَؤُها يَخطِفُ عينَ الرائي","ويُتْبِعُ الأعدادَ بالإحصاء",25,"ا",2,0],["أبطال غزة بعد قبية هللوا","إن المخازي الموبقات فخاركم",26,"م",1,1],["أبطال قبية أنتمو وكفاكمو","فخرا بتدمير لكم تمدينها",27,"ن",3,0],["أبطلت ألفاظها سحر الدمى","نعس الدعج ودعج النعس",28,"س",1,0]]}