{"poems":[[79,"ياصاح لا تبك عهدا للوصال مضى","https://www.aldiwan.net/poem36074.html","البسيط"],[85,"هذا الصباح صباح الشيب قد وضحا","https://www.aldiwan.net/poem54333.html","الكامل"],[90,"أرى بغداد من بعد أغبرار","https://www.aldiwan.net/poem44976.html","الوافر"],[34,"صدت بثينة عني أن سعى ساع","https://www.aldiwan.net/poem27806.html","البسيط"],[87,"قم سابق الساعة واسبق وعدها","https://www.aldiwan.net/poem62977.html","الرجز"],[87,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[64,"من الناس من لم يكن عارفا","https://www.aldiwan.net/poem52147.html","المتقارب"],[64,"هلموا إذا ما خفتهم الفقر فاصعدوا","https://www.aldiwan.net/poem52185.html","الطويل"],[64,"قال الحكيم مقالا أبان","https://www.aldiwan.net/poem52187.html","المتقارب"],[46,"قل للأمير الذي قد نال ما طلبا","https://www.aldiwan.net/poem30577.html","البسيط"],[48,"إن يقرب الموت مني","https://www.aldiwan.net/poem22148.html","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54691","البسيط"],[111,"لا تكترث بالليالي إنها دول","https://www.poetsgate.com/ViewPoem.aspx?id=519",""],[139,"الله أكبر طاب القلب وانشرحا","https://www.aldiwan.net/poem49128.html","البسيط"],[154,"كم في الدياجير من ذخر وفائدة","https://www.aldiwan.net/poem68518.html","البسيط"],[240,"ترى الظاعن الغادي مقيما على العهد","https://www.aldiwan.net/poem32031.html","الطويل"],[264,"بحمد الله يبدأ كل شاكر","https://www.aldiwan.net/poem35945.html","الوافر"],[266,"حتام لا ينثني الجموح","https://www.aldiwan.net/poem38346.html","مخلع البسيط"],[358,"حبائل البر في استعطاف ذي الهيف","https://www.aldiwan.net/poem40031.html","البسيط"],[358,"أدم خلع العذار بدون عذر","https://www.aldiwan.net/poem40232.html","الوافر"],[366,"محبك يا شقيق الروح يرجو","https://www.aldiwan.net/poem68102.html","الوافر"],[369,"سرى ولثام الصبح قد كاد ينحط","https://www.aldiwan.net/poem60859.html","الطويل"],[411,"لله في خلقه قضايا","https://www.aldiwan.net/poem49992.html","مخلع البسيط"],[415,"لا تجزعن لخطب","https://www.aldiwan.net/poem32156.html","المجتث"],[422,"خذ بالمسرة واغنم لذة الطرب","https://www.aldiwan.net/poem54116.html","البسيط"],[505,"أجل نظرا في الكائنات ترى العجب","https://www.aldiwan.net/poem37679.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86717","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86990","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86935","البسيط"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199569","المسحوب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62561","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126155","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126119","الرجز"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6749","الوافر"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131594",""],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118418","البسيط"],[2031,"","https://poetry.dctabudhabi.ae/diwan/poem/140123",""],[2053,"","https://poetry.dctabudhabi.ae/diwan/poem/132441","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53111","المتقارب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27738","السريع"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109468","الرجز"],[2394,"","https://poetry.dctabudhabi.ae/diwan/poem/146277","السريع"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121177","الطويل"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107178","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65945","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100221","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204872","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133963","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100830","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91897","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91871","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131252",""],[3857,"","https://poetry.dctabudhabi.ae/diwan/poem/142322","المجتث"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135862","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[4077,"","https://poetry.dctabudhabi.ae/diwan/poem/198902","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133091","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133071","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133186","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133066","البسيط"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121262","البسيط"],[4550,"","https://poetry.dctabudhabi.ae/diwan/poem/107138","الوافر"],[4755,"صنعاء والدولار","https://www.poetsgate.com/ViewPoem.aspx?id=200384",""],[4906,"يهنيكِ يا بلدةَ المختارِ من مُضَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=173613",""],[5046,"خذوها للمصحة ..","https://www.poetsgate.com/ViewPoem.aspx?id=202572",""],[5054,"فديتك","https://www.poetsgate.com/ViewPoem.aspx?id=214799",""],[5414,"زيارة فوق العادة للخيول العربية","https://www.poetsgate.com/ViewPoem.aspx?id=12930",""],[5873,"عهد الكفاح","https://www.poetsgate.com/ViewPoem.aspx?id=215311",""]],"verses":[["وَلاَ تُضِع فُرَصَ اللَّذَّاتِ إِنَّ لَنَا","رَبّاً كَرِيماً يُقِيلُ الذَّنْبَ غُفْرَانَا",0,"ن",2,0],["ولا تضايق أمرٌ فاستجرتُ به","إلا تفرْجَ بابُ الضّيقِ وانفتحا",1,"ح",2,0],["ولا تضربهم أن شئت إلاّ","بضِغْث من نبات الشعر ذاو",2,"و",1,0],["وَلا تُضيعَنَّ سِرّي إِن ظَفِرتِ بِهِ","إِنّي لِسِرِّكِ حَقّاً غَيرُ مِضياعِ",3,"ع",1,0],["وَلا تُضِع عَلى الضَحايا جُهدَها","وَاِكبَح هَوى الأَنفُسِ وَاِكسِر حِقدَها",4,"د",3,0],["وَلا تَضرِبَن بِالرَأيِ مُنحَلَّ مُلكِهِم","فَما يَفعَلُ المَولى الكَريمُ المُهَذَّبُ",5,"ب",1,0],["ولا تضجرنَّ بطول الزمان","فالصبرُ مفتاحُ أقفاله",6,"ل",2,0],["ولا تضجروا بالسحق فهو ملاكه","به يظهر السر الذي كان مبطنا",7,"ن",2,0],["ولا تضجرتَّ بطول الرهان","إلى أن يتمّ وينشا الولد",8,"د",1,0],["وَلا تُضِعها فَما في الأَرضِ أَحسَنُ مِن","نَظمِ القَوافي إِذا ما صادَفَت حَسَبا",9,"ب",2,0],["وَلا تَضِنَّ فَإِنّي","ما لي بِذلِكَ دَربَه",10,"ب",2,0],["ولا تُضلّيهِ ولا تنْفري","من ذلك المستصرخ البائسِ",11,"س",1,0],["ولا تضع من الجديد كله","يفتك وضع الشئ في محله",12,"ه",1,0],["وَلاَ تَضَنُّوا عَلَيْهَا بِاتِّحَادِكُمُ","فَإِنَّ خَيْرَ الْهَوَى مَا كَانَ تَوْحِيدَا",13,"د",2,0],["ولا تضق بالقضايا في تقلبها","في طي كل شديد خيرة جلل",14,"ل",1,0],["ولا تضع فرصةَ الدهر التي سمحت","بها الليالي وقم للكأس مصطبحا",15,"ح",2,0],["ولا تُضِع عُمراً في غير فائدةٍ","فَعَن قريبٍ لَعَمري يَنفَذُ العُمُرُ",16,"ر",1,0],["وَلا تُضمِروا عِصيانَ أَمرِ إِمامِكُم","مُخالَفَةً عَنهُ فَعِصيانُهُ يُردي",17,"د",2,0],["ولا تُضمِرْ على ضرٍّ لجارٍ","فربّك عالمٌ ما في الضمائر",18,"ر",1,0],["ولا تضجر لأمرٍ فيه عسرٌ","فبعد العسر يسر الأمر صادر",18,"ر",1,0],["ولا تضق في الخطوب ذرعاً","فأنها في الرواح ريح",19,"ح",1,0],["وَلا تضع بِالتَواني فُرصة سَنَحَت","ما في التَواني سِوى التَفريط وَالأَسَفِ",20,"ف",1,0],["وَلا تَضجر إِذا ما كُنت حرّاً","فَإِنّ الصَبر شيمة كُلّ حُرِّ",21,"ر",1,0],["وَلا تَضجر شَقيق الروح مني","فَلَيسَ أَخو المودة بِالضُجور",22,"ر",1,0],["ولا تَضَعُ الأَيّامُ شيئاً مكانَه","ولكنّها العَشْواءُ سِيرتُها الخَبط",23,"ط",1,0],["ولا تضِقْ بالخُطوبِ ذَرعاً","فرُبَّما يسهُلُ الأشَدُّ",24,"د",1,0],["ولا تَضِق باصطبارٍ","ذَرعاً إذا اشتدَّ كربُ",25,"ب",1,0],["ولا تضع فرصةً جاد الزمان بها","ساعات أنسك بين المجد واللعب",26,"ب",1,0],["ولا تضجرن إن سامك الضيم عاجزٌ","فقد سامت المختار حمالةُ الحطب",27,"ب",1,0],["وَلا تُضِع يا أَميري فُرصةً عَرضت","لِمَن عَلى الوَعد بَعد اللَه يَعتَمد",28,"د",1,0],["وَلا تضنّي بِها بخلاً فَما حرمت","مَع الحلال عَلى إِلفٍ وَصدّيق",29,"ق",1,0],["وَلا تُضِع فُرصةً في رَشفِها عرضت","فَإِن فيها زَوال الهَمّ وَالباس",30,"س",1,0],["ولا تضربون الشك والفلك لى دار","يديره الرحمن عز الجلالي",31,"ل",2,0],["ولا تضايق بالأضياف منزله","إلاَّ ويضحك بشراً غير غضبان",32,"ن",1,0],["ولا تضع الأشياء في غير موضع","أعدّت له إن كنت بالقسم تحكم",33,"م",1,0],["ولا تضع وقتاً وعذ بالله","منكل بطال كسول لاهي",34,"ي",1,0],["ولا تضع وقتا وعذ بالله","من كل بطال كسول لاه",35,"ه",1,0],["ولا تضع وقتا وكن على هدى","فمفلس من وقته يمضي سدى",35,"د",2,0],["وَلا تَضحَك مَعَ السُفَهاءِ لَهواً","فَإِنَّكَ سَوفَ تَبكي إِن ضَحِكتا",36,"ت",2,0],["ولا تضيق بالجموع العاديه","وان اظهر واظاهره في الاجتماع",37,"ع",1,0],["ولا تضع عملا قد كان احسنه","بنية اخلصت من غير اعضاه",38,"ه",1,0],["ولا تضجرن كيما تحوز مثوبة","من الله في يوم التغابن والحشر",39,"ر",1,0],["ولا تضع تلوهما عثماناً","خير امرئ بعدهما قد كانا",40,"ن",2,0],["ولا تضع الحرب أوزارها","إلى أن يحيض الحسام الذكرْ",41,"ر",1,0],["ولا تضيع حقه إنه","في غاية البعد مع القربِ",42,"ب",1,0],["ولا تضق ذرعاً ولا تشك الغصص","فإن يكن مات فقد أبقى القفص",43,"ص",1,0],["ولا تضيّع زمناً ممكناً","تذكاره يذكي لظى حسرتك",44,"ك",1,0],["ولا تضجرن من حادث الدهر ان عدى","فسوق يعيد اللّه عسركم بسرا",45,"ر",2,0],["وَلا تُضِعِ الأَوقاتَ في غَيرِ صالحٍ","فَمن ضَيَّعَ الأوقاتَ نالَ بِها خُسرا",46,"ر",2,0],["ولا تضربن بين الأنام برجلها","فيصطخب الخلخال والعقد بالعقد",47,"د",1,0],["ولا تضعِ القوس من حاجب","ولو كان قوسك من حاجب",48,"ب",1,0],["ولا تضف لي فناءً يا منى كبدي","فانني فيك ذاك العاشق الفاني",49,"ن",2,0],["ولا تضع الأوقات في نشوة الصبا","فصحو الفتى وقت الشبيبة افضله",50,"ل",2,0],["ولا تضيعوا من الدستور فرصته","فتقرعوا السن من ذل ومن ندم",51,"م",1,0],["وَلاَ تُضِف لِمُفرَدٍ مَعَرَّفٍ","أيَّا وَإن كَرَّرتَها فَأَضِفِ",52,"ف",1,0],["وَلا تَضِق حرجاً إِن محنةٌ دَهَمت","فَآخرُ الصَبر فيها أَوّلُ الفَرج",53,"ج",1,0],["وَلا تَضع قَدماً إِلا اتخذت لَها","لرجعة ما طريقا ثمّ منبوءا",54,"و",3,0],["ولا تضع إلى وغدٍ جميلا","إذا أحببت أن يعدوك ذام",55,"م",1,0],["ولا تضوّع طيب","ولا زكا عنقود",56,"د",1,0],["ولا تضرُّني فعالٌ أو مقالْ","صلِّ وسلِّمَنْ على نبي الكمالْ",57,"ل",1,0],["ولا تضطرب خوفاً ولا ترهب الردى","فقاتل أرغوصٍ نسير فيقتفي",58,"ي",1,0],["ولا تضمرنّ الثّكل إن كنت ذا حجاً","فليس لبيباً من يبيت على ثكل",59,"ل",1,0],["ولا تَضَع مكانَ لِينٍ شِدَّةً","فَمَن سَطَا في مَوضِعِ الحِلمِ هَفا",60,"ا",1,0],["ولا تضيع خطير العمر في كسلٍ","أنفاسك الدر قد جلت معانيها",61,"ي",3,0],["ولا تضيع في الفضول عمرك","ودع أمور الناس واصلح أمرك",62,"ك",1,0],["ولا تضق بالنائبات ذرعاً","واصمت إذا لم تعتزل بخلوه",63,"و",2,0],["ولا تضيع نفيس العمر في هملٍ","على البطالة تندم عمرك الثاني",64,"ن",2,0],["ولا تضِرك عيونٌ منك طامِحَةٌ","إن الثعالِبَ ترجو فضلَ آسادِ",65,"د",1,0],["ولا تضجر لضيق الحال واقنع","ونكب عن طلابك بالمزيد",66,"د",1,0],["ولا تَضَعها الآنَ في جُملةٍ","فَيَأكُلَ الطّاعُونُ أَسنانَها",67,"ن",3,0],["ولا تضيعُ سدًى في بابه وبه","أضحى توسُّلنا عِقْدًا من الدُّرَر",68,"ر",1,0],["ولا تُضْنُوا نفوسكمُ بصلحٍ","فذيلُ الكلبِ منذُ البدْءِ أعْوَجْ",69,"ج",1,0],["ولا تُضحكِ الأنذال والدهرُ ضاحكُ","وأعجز عن إطفاءِ نار بِمُهجتي",70,"ت",2,0],["ولا تضْبحي، فالضّباحُ سيغْدو","إذا ما ضبحت .. دمًا أو عويلا",71,"ل",2,0],["ولا تضعفْ ليأس ٍ أو لخوفٍ","ولا تسمع مقالة كلّ لاحِي",72,"ح",2,0]]}