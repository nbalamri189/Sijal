poem/85430","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85543","المقتضب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39562","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39603","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39664","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39667","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202538","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19074","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202531","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202688","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54828","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54573","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55186","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54722","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/3032","البسيط"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10325","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54229","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54252","الخفيف"],[106,"سبق الفضاء!","https://www.poetsgate.com/ViewPoem.aspx?id=179491",""],[106,"معترك السباب!","https://www.poetsgate.com/ViewPoem.aspx?id=179427",""],[106,"صوت الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179642",""],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[106,"زمزم طليعة الأسطول المصري","https://www.poetsgate.com/ViewPoem.aspx?id=179646",""],[100,"بيتٌ مِن الرِّيح","https://www.poetsgate.com/ViewPoem.aspx?id=183581",""],[90,"تحت ظل النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=179087",""],[90,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""],[90,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""],[90,"لولا...","https://www.poetsgate.com/ViewPoem.aspx?id=179023",""],[94,"ذكرى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=15593",""],[31,"الرّيحُ تَسْحَبُ أَذْيالاً وَتَنْشُرُها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18817&r=&rc=80",""]],"verses":[["الراكِبينَ الخَيلَ تَعرِفُها بِهِم","تَحتَ العَجاجِ إِذا التَقى الخَيلانِ",0,"ن",1,0],["الراكِبينَ ظُهوراً قَلَّما رُكِبَت","وَالمالِكينَ عِناناً قَلَّما مُلِكا",1,"ك",2,0],["الراحُ وَالراحَةُ ذُلُّ الفَتى","وَالعِزُّ في شُربِ ضَريبِ اللَقاح",2,"ح",1,0],["الرّأيُ خَمْرٌ تُسْتَدارُ كؤوسُهُ","ومنَ الصّهيلِ مَعازِفٌ ومَلاهي",3,"ي",1,0],["الرَفيئينَ بِالجِوارِ فَما يُغ","تالُ جارٌ لَهُم بِظَهرِ المَغيبِ",4,"ب",1,0],["الرِزقُ يَأتي وَإِن لَم يَسعَ صاحِبُهُ","حَتماً وَلكِن شَقاءُ المَرءِ مَكتوبُ",5,"ب",1,1],["الرِّيفُ مُلْتَمِعُ الأَسِرَّةِ بَهْجَةً","وَالنِّيلُ مُبْتَسِمٌ كَمَا تَرَيَانِ",6,"ن",1,0],["أَلرَّأْيُ فِي كُبْرَى المَعَاضِلُ رَأْيُهُ","وَالنَّقْضُ بَيْنَ يَدَيْهِ وَالإِبْرَامُ",7,"م",1,0],["أَلرَّئِيسُ النَّزِيهُ فِي كُلِّ مَعْنًى","مِنْ مَعَانِي وِلايَةِ الأَحْكَامِ",8,"م",1,0],["أَلرَّصِينُ الرَّزِينُ لِلمُتَجَنِّي","وَالنَّصِيرُ الأَمِنُ لِلمُسْتَضَامِ",8,"م",1,0],["الريحُ ريحُ سَفَرجَلٍ","والطَّعمُ طَعمُ سُلافِ دَنّ",9,"ن",1,0],["الرياه منه يمنع","والقلوب تحن إليها",10,"ه",2,0],["الرُكنُ وَالبَيتُ وَالأَستارُ مَنزِلُهُم","وَزَمزَمٌ وَالصَفا وَالحِجرُ وَالحَرَمُ",11,"م",1,0],["الرئيسُ الذي تناجت عليهِ","كلمُ المادحين أيّ تناج",12,"ج",1,0],["الرئيس الذي به نفق الشع","ر وراجت بضائع المدّاح",13,"ح",1,0],["الرَّاح ريقهُ من أهوى ولا عجبٌ","إن راحَ وهو على العشَّاق عربيد",14,"د",1,0],["الرجل طول النهار تمشي","والحال طول النهار واقف",15,"ف",1,0],["الرئيس الذي به غنيَ النا","س عن الغيث وارتقاء غمامه",16,"م",2,0],["ألرفق موسى الزمان بنا فقد","حلقت ذقون صغارنا وكبارنا",17,"ن",2,0],["ألريحِها ولروحها تَحْتَ الحشى","أم لارْتِيَاحِ نديمها المرتاحِ",18,"ح",1,0],["الريحُ والنارُ هُما ما هُما","فَلْتُحْذَرِ الريحُ على المطْبَخِ",19,"خ",1,0],["الراجح العفّ في كتابته","إذ في سواه نقيصةٌ وشَرَهْ",20,"ر",2,0],["الرِّغابِ السّجال للمعْتَفيهم","حين يَسْقُونَ والرّحابِ الحياض",21,"ض",1,0],["الرقاقُ الثغورِ يبسمْنَ عنهنْ","نَ بروقاً لنا لدى التَّضحاك",22,"ك",1,0],["الراجح الناصحُ الظّهارة وال","غَيْبِ إذا الصّنْوُ كان مُتَّهَمَا",23,"م",2,0],["الريحُ ساكِنَة وَنَحنُ نَظُنُّنا","لِلخَوفِ مُندَفِعينَ مَع إِعصارِ",24,"ر",1,0],["الراحُ تَصرُفُ ذا العَناءِ عَنِ العَنا","وَتَطيرُ بِالصُعلوكِ في جَوِّ المُنى",25,"ا",1,0],["الرُّشدُ إن تَتمادَوْا في غَوايتكم","والحقُّ أن تجعلوا للباطلِ الغَلبا",26,"ب",2,0],["الروح لم تهبط علي","ي من المحل الأرفع",27,"ع",1,1],["الرافعين إلى السماء سريرها","والساحبين على النجوم رداءها",28,"ا",3,0],["الريح تحضن بانة من قده","والبحر يرحم درّ فيه يتيما",29,"م",2,0],["الراكِبينَ إِذا نادى النَبِيُّ بِهِم","ما هالَ مِن جَلَلٍ وَاِشتَدَّ مِن عَمَمِ",30,"م",1,0],["الروحُ وَالمَلَأُ المَلائِكُ حَولَهُ","لِلدينِ وَالدُنيا بِهِ بُشَراءُ",31,"ا",2,0],["الرَئيسِ الجَوادِ فيما عَلِمنا","وَبَلَونا وَاِبنِ الرَئيسِ الجَوادِ",32,"د",1,0],["الروحُ مِلكُ يَمينِهِ","يَفديهِ ما مَلَكَت يَمينُهُ",33,"ن",2,0],["الرُشدُ أَجمَلُ سيرَةً يا أَحمَدُ","وُدُّ الغَواني مِن شَبابِكَ أَبعَدُ",34,"د",1,1],["الرافِعونَ إِلى الضُحى آباءَهُم","فَالشَمسُ أَصلُهُمُ الوَضيءُ المُعرِقُ",35,"ق",1,0],["الرُؤوسُ مائِلَةٌ","في الصُدورِ تَحتَجِبُ",36,"ب",1,0],["الرانِياتِ بِكُلِّ أَحوَرَ فاتِرٍ","يَذُرُ الخَلِيَّ مِنَ القُلوبِ عَميدا",37,"د",2,0],["الراوِياتِ مِنَ السُلافِ مَحاجِراً","الناهِلاتِ سَوالِفاً وَخُدودا",37,"د",2,0],["الروحُ لِلرَحمَنِ جَلَّ جَلالُهُ","هِيَ مِن ضَنائِنِ عِلمِهِ وَغِيابِهِ",38,"ب",2,0],["الراحَةُ الكُبرى مِلاكُ أَديمِهِ","وَالسَلوَةُ الطولى قِوامُ تُرابِهِ",38,"ب",2,0],["الرامِياتُ لَنا وَهُنَّ نَوافِرٌ","وَالخاتِلاتُ لَنا وَهُنَّ غَوافِلُ",39,"ل",1,0],["الراجِعُ الخَيلَ مُحفاةً مُقَوَّدَةً","مِن كُلِّ مِثلِ وَباري أَهلُها إِرَمُ",40,"م",1,0],["الرَأيُ قَبلَ شَجاعَةِ الشُجعانِ","هُوَ أَوَّلٌ وَهِيَ المَحَلُّ الثاني",41,"ن",2,1],["الرِياحُ الَّتي تَهُبُّ نَسيمٌ","وَالنُجومُ الَّتي تُطِلُّ سُعودُ",42,"د",1,0],["الرَملُ فيكُم مِن عَتادِ مُفاخِرٍ","يَومَ اللِقاءِ وَمِن عَديدِ مُكاثِرِ",43,"ر",1,0],["الرِفقُ يُمنٌ وَالأَناةُ سَعادَةٌ","فَتَأَنَّ في أَمرٍ تُلاقِ نَجاحا",44,"ح",2,1],["الرِفقُ يَبلُغُ ما لا يَبلُغُ الخَرَقُ","وَقَلَّ في الناسِ مَن يَصفو لَهُ خُلُقُ",45,"ق",1,1],["الرأي رأيك ليس في ال","أوقاف شيء غير ذلك",46,"ك",1,0],["الرِزقُ لا تَكمَد عَلَيهِ فَإِنَّهُ","يَأتي وَلَم تَبعَث إِلَيهِ رَسولا",47,"ل",2,0],["الروضُ تندبُ أم سمتَهُ","أمْ عقلَهُ الوافرَ أمْ علمَهْ",48,"ه",1,1],["الرأسُ واللحيةُ شابا معاً","عاقبني الدهرُ بشيبينِ",49,"ن",1,0],["الرافعينَ الهَامَ من جُثَثٍ","فََرَشْتِ لَهُمْ وهَامِ",50,"م",1,0],["الريحُ تَسحَبُ أَذيالاً وَتَنشُرُها","يا لَيتَني كُنتُ مِمَّن تَحسَبُ الريحُ",51,"ح",1,1],["الرأيُ في جِدِّ الحوادثِ رأيُكم","والحقُّ وضّاحُ المعالمِ بادِ",52,"د",1,0],["الرافِعينَ لِواءَ الحَقِّ مُذ عُرِفوا","مِن كُلِّ راضٍ لِوَجهِ اللَهِ غَضبانِ",53,"ن",1,0],["الرَّأيُ رأيُ ذَوِي المعارِفِ والنُّهَى","ومِنَ الرجالِ بَهائِمٌ لا تَعْلَمُ",54,"م",1,0],["الرسول الذي تَدينُ له الأر","ضُ وتهفو إليه حَرْباً وسِلما",55,"م",2,0],["الرُّوحُ يهتفُ والإسلامُ مُبتهَجٌ","والكفرُ في صَعقاتِ الهولِ مخبول",56,"ل",1,0],["الرسولُ السَّمحُ والمولى الذي","يَسَعُ الأجيالَ برّاً وافتقادا",57,"د",2,0],["الريحُ تُبدي الثَوبَ مِنهُ مُعَكَّراً","وَالشَمسُ تُلقي صارِماً مَصقولا",58,"ل",2,0],["الروح وَالريحان خَير تَحية","وَالسَلسَبيل وَلَست تَظمأ مَورد",59,"د",1,0],["الروّض كالمستشفيا","تِ دواؤها إيناسهنّه",60,"ن",2,0],["الرّوضُ ما قدْ قِيلَ في أيّامِهِ","لا أنّهُ وَردٌ ولا نِسْرين",61,"ن",1,0],["الراحُ شَيءٌ عَجيبٌ أَنتَ شارِبُها","فَاِشرَب وَإِن حَمَّلَتكَ الراحُ أَوزارا",62,"ر",2,0],["الراكِبُ الأَمرِ تَعايَت بِهِ","أَقياسُ أَقوامٍ وَأَقدارُ",63,"ر",1,0],["الراعِيانِ بِإِنعامٍ وَمَرحَمَةٍ","وَالغافِرانِ ذُنوبَ الحالِفِ الصادي",64,"د",2,0],["الروحُ تَنأى فَلا يُدرى بِمَوضِعِها","وَفي التُرابِ لَعَمري يُرفَتُ الجَسَدُ",65,"د",1,1],["الرُمحُ أَبلَغُ مِن قُسٍّ تُخاطِبُهُ","خَرساءُ يوجِدُ فيها المَسمَعُ الخَطِلا",66,"ل",2,1],["الرُبعُ لِلزَوجَةِ إِن لَم يَكُن","نَسلٌ وَإِن كانَ غَدَت بِالثُمُن",67,"ن",1,0],["الراهِبُ المَسجونُ فَرطَ عِبادَةٍ","مِن حُّبِّ دُنياهُ الكَذوبِ مُوَلَّهُ",68,"ل",2,1],["الرّكْبُ إثرَكَ آجِمونَ لزادِهمْ","واللُّهْجُ صادِفَةٌ عنِ الأخْلافِ",69,"ف",1,0],["الرافِعينَ مِنَ المَمالِكِ شَأوَها","البالِغينَ بِها مَكانَ الأَنجُمِ",70,"م",1,0],["الروض يبكي والنسيم على التي","ماتت فما أنا وحدي المفجوع",71,"ع",1,0],["الروض لا يَبقى به","زهر إذا جاءَ الخَريف",72,"ف",1,0],["الرجَّة الأولى وَكانَت بغتةً","أَودَت بأكثرهم ببضع ثوان",73,"ن",1,0],["الرجال باكية","والنساء تنتحب",74,"ب",1,0],["الروض يَزهو نوره في فصله","بِبَدائع الأشكال والألوان",75,"ن",1,0],["الرُّعبُ سيَّان بها والأمان","والحسن زادٌ سائغٌ للزمان",76,"ن",1,0],["الرفيقُ الحاني على كلّ قلبٍ","أنشبَ البؤسُ فيه ناباً ومخلبْ",77,"ب",1,0],["الربيعُ المرِحُ الجذلانُ يختالُ فخورا","إنَّهُ الحسنُ الذي يملأُ بالحبِّ الصدورا",78,"ر",2,0],["الرِّيفُ هَبَّ منازلاً وقبائلاً","يدعو فتاهُ الباسلَ الذَّوَّادا",79,"د",2,0],["الرابضون على الحصونِ خرائباً","مُهَجاً تضرّم في حُطام صفائحِ",80,"ح",1,0],["الرأس في الشغب سواءٌ والذّنبْ","لا تبرأ العقرب من ذنب الذّنبْ",81,"ب",1,0],["الرَأيُ رَأيُ أَميرِ المُؤمِنينَ إِذا","حارَت رِجالٌ وَضَلَّت في مَرائيها",82,"ي",3,0],["الراضعوا زمزم في الهواجر","وهي تدرّ من بنان هاجر",83,"ر",1,0],["الرأيُ للأمةِ في الوُلاةِ","وليس للغِصّابِ والغُلاةِ",84,"ه",1,0],["الروح والملأ الملائكه حول","للدين والدنيا به بشراء",85,"ا",2,0],["أَلرَّوْضَةُ الخَضْرَاءُ تَحْتَ مِظَلَّةٍ","مِنْ نَاصِعِ النُّوَّارِ فِي الأَعْواد",86,"د",1,0],["أَلرَّأْيُ تَكْمدُ شَمْسُهُ فِي مَوْطِنٍ","مُتَنَاقِضِ الإِعْلاَنِ وَالإِسْرَارِ",87,"ر",1,0],["أَلرَّاقِيَاتِ إلى الفِدَى","بَيْنَ المَجَانَةِ وَاللَّعَابِ",88,"ب",1,0],["أَلرَّأْيُ أَمْضَى في سِدَا","دِ ثُغُورِهَا وَالسَّيْفُ نَابِ",88,"ب",1,0],["الرَّبْعُ إِنْ أَوْحَشْتَهُ مُقْفِرٌ","وَالرَّبْعُ إِنْ آنَسْتَهُ آهِلُ",89,"ل",1,0],["أَلرَّوضُ رَوْضُكَ يَا هَزَارُ فَغرِّدِ","وَصُغِ الفَرَائِدِ فِي الأَرِيبِ المُفْرَدِ",90,"د",1,1],["أَلرَّاحِمِ المِسْكِينَ وَالْمَلْهُوفَ وَالْ","مَظْلُومَ حِينَ تَعَذُّرِ الرُّحَمَاءِ",91,"ا",2,0],["الرُشدُ يُعتِقُني لَو كُنتُ أَتبَعُهُ","وَالغَيُّ يَجعَلُني عَبداً لِشَهوَتِيَه",92,"ت",3,0],["الراتِقينَ وَلاتَ حينَ مَراتِقٍ","وَالفاتِقينَ شَرائِجَ الأَستاهِ",93,"ا",2,0],["الرُسْل تَتْلُو الرسْلَ مِنْ","بِيضٍ صَقَالِبَةٍ وُسُودِ",94,"د",1,0],["الرَافِدَانِ تَمازَجَا","في الْحُبِّ بِالنِّيل السعيدِ",94,"د",1,0],["الرسولُ الكريمُ أنطق حَسَا","ناً ولولاه لم يكنْ حَسَانا",95,"ن",2,0],["الرزء يذهب بالعقول جلالهُ","فحذَار من شطط المقال، حذار!",96,"ر",1,0],["الريح تجري زعزعًا","والموج يعلو كالقباب",97,"ب",1,0],["الريفُ -ويحَ الريف- يدعوكم إلى","إنقاذِ مرضَى جاهلين جِياع",98,"ع",1,0],["«الريَّخ» يحسب أنه","آوى إلى ركن مشيد",99,"د",1,0],["الرافعون لمصرَ هامتَها","والملبسوها حُلَّةَ الفخر",100,"ر",1,0],["الرُّبى تَسقِي السَّمَا مِن بَوحِهِ","مِثلما تَسقي دَوالِيكَ وقَمحَك",101,"ك",1,0],["ألروحُ جارت علينا في محبتِكم","وطالما أشءقَتِ الأرواحُ أبدانا",102,"ن",2,0],["الرَّشْفَةُ النزرُ من فرط ارتياحِهِمِ","كأسٌ مُفايَضَةٌ والكأسُ راقود",103,"د",1,0],["الرَعاعُ ، الرَعاعُ ؛ والجََدَل الفارغُ","اني من شَرّهم في حمِاك",104,"ك",1,0],["الروح أشْقَتني وجُلُّ صَحابتي","ما أشقتِ الشعراءِ إّلا الروحُ",105,"ح",1,1],["الرُّبى في ميسلونَ استَعبرَت","أينَ دمعُ الحزنِ من دمعِ الهناء",106,"ا",2,0],["الرّيحُ تَسْحَبُ أَذْيالاً وَتَنْشُرُها","يَا لَيْتَني كُنْتُ مِمَّنْ تَسْحَبُ الرّيحُ",107,"ح",1,1]]}