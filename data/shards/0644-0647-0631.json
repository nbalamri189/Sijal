/ViewPoem.aspx?id=205923",""],[5193,"على هامش أحداث .. كرونا","https://www.poetsgate.com/ViewPoem.aspx?id=213403",""],[1021,"تبدى يملأ الناظر","https://www.poetsgate.com/ViewPoem.aspx?id=47834",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[5431,"له...له...","https://www.poetsgate.com/ViewPoem.aspx?id=191170",""],[5474,"قلادة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=181669",""],[5704,"رحْمَاكَ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=198799",""],[5704,"يا زائرا للحيِّ٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=204224",""],[5893,"شجون الغلا","https://www.poetsgate.com/ViewPoem.aspx?id=141495",""],[6070,"تُعلِّمهُ الأَيامُ معنى قوافيا","https://www.poetsgate.com/ViewPoem.aspx?id=188645",""]],"verses":[["له راحة تحيي الورى غير أنها","إذا حكمت في المال ينعب ناعبه",0,"ب",2,0],["لَهُ ريقَةٌ تَجري بِما شاءَ رَبُّهُ","كَما حالَ سُمٌّ بَينَ أَنيابِ أَرقَمِ",1,"م",1,0],["لَهُ رائِدٌ يَلقاكَ مِن قَبلِ شَخصِهِ","جَلالاً كَما دَلَّ الضِياءُ عَلى الفَجرِ",2,"ر",1,0],["لهُ ريقَةٌ ما ذُقْتُها غيرَ أنَّنِي","أظُنُّ وظنِّي صادِقٌ أنَّها خَمْرُ",3,"ر",1,0],["لَهُ رِدافٌ وَجَوزٌ مُفأَمٌ عَمِلٌ","مُنَطَّقٌ بِسِجالِ الماءِ مُتَّصِلُ",4,"ل",1,0],["لَهُ رَتَبٍ عالٍ عَلى الناسِ كُلِّهِم","تَقاصَرُ عَنهُ سَورَةَ المُتَطاوِلِ",5,"ل",1,0],["له راحةٌ فيها على البأسِ والندى","دلائلُ حتَّى في الجمادِ تؤثر",6,"ر",1,0],["له راحةٌ صلى الحيا خلف جودها","وأذعن فانظر للمصلّي المسلّم",7,"م",1,0],["له راحة ضمَّت يراعاً ومرهفا","كأنَّهما زاداه بالمكثِ أنملا",8,"ل",2,0],["له راحة لو مستِ الصخر أنبعت","جوانبُه ماءً وأورق يابسه",9,"س",2,0],["له راحةٌ روْحاءُ يسفكُ ماءَها","وليس لماء الوجهِ منه بسافك",10,"ك",1,0],["له راحةٌ روحاءُ تشهد أنها","مغيضٌ لصنعٍ أو مفيضٌ لنائلِ",11,"ل",1,0],["له رونقُ العَضبِ الصَّقيل وحَدُّه","براعةَ أخلاقٍ وصدقَ عزائمِ",12,"م",1,0],["لَهُ رَحمَةٌ تُحيّ العِظامَ وَغَضبَةٌ","بِها فَضلَةٌ لِلجُرمِ عَن صاحِبِ الجُرمِ",13,"م",1,0],["لَهُ راحَتا كَفَّينِ في راحَتَيهِما","مِنَ البَحرِ فَيضٌ لا يُنَهنَهُ زاخِرُه",14,"ر",2,1],["لَهُ راحَةٌ بَيضاءُ يَندى بَنانُها","قَليلٌ إِذا اِعتَلَّ البَخيلُ اِعتِلالُها",15,"ل",3,0],["لَهُ رَهَجٌ عالي الزُهاءَ كَأَنَّهُ","غَيابَةُ دَجنٍ ذي طَخاءٍ تَغَيَّما",16,"م",2,0],["له راحَةٌ سَيرُها راحةٌ","تَمُرُّ على الوَجْهِ مَرَّ النَّسيمِ",17,"م",1,0],["له راحةٌ ما قيسَ بالغَيْثِ صَوبُها","لَدى المِحْلِ إلاّ كانَ أندى وأوسَعا",18,"ع",2,0],["لَهُ رِقَّةُ الخَنساءِ في حالِ نَوحِها","وَلَكِنَّ مَعناهُ لِقُوَّتِهِ صَخرُ",19,"ر",1,0],["له رَجاحَةُ حِلْمٍ عند قُدْرَتِهِ","أرسَى إذا طاشتِ الأحلامُ من جَبَلِ",20,"ل",1,0],["لهُ رِعْدَةٌ تعتادُهُ في انحدارِهِ","كما تَبْسُطُ الكفُّ العنانَ وتقبضُ",21,"ض",1,0],["لَهُ ريقَةٌ طَلٌّ وَلَكِنَّ وَقعَها","بآِثارِهِ في الشَرقِ وَالغَربِ وابِلُ",22,"ل",1,0],["لَهُ رِياضُ نَدىً لَم يُكبِ زَهرَتَها","خُلفٌ وَلَم تَتَبَختَر بَينَها العِلَلُ",23,"ل",1,0],["لَهُ رايَةٌ لَو زاحَمَ الدَهرُ تَحتَها","لَعُدَّت بِهِ دُهمُ اللَيالي مِنَ الشُقرِ",24,"ر",1,0],["لَهُ راحَةٌ يا لَها راحَةً","تَرى جَدَّ نائِلِها كَاللَعِب",25,"ب",1,0],["له رسول إلى العالمين","وهو الأمين",26,"ن",1,0],["له رجفة تنتابه وهو واقف","على جانب والجوّ بالبرد يلسع",27,"ع",1,0],["لَهُ رَاحَتَا كَفّينِ في رَاحَتَتهِمَا","مِنَ البَحرِ فَيضٌ لا يُنَهَنهُ زَاخرُهْ",28,"ر",2,0],["لَهُ راحَتَا كَفَّيْنِ في راحَتَيْهِمَا","مِنَ البَصْرِ فَيْضٌ لاَ يُنَهْنَهُ زاخِرُهْ",28,"ر",2,0],["له راحة ٌ فيها الحطيمُ وزمزمُ","ولكن مَخَبٌّ للركاب ومسعم",29,"م",1,0],["له رجفة تنتابه وهو واقف","على جانب والطقسبالبرد يلسع",30,"ع",1,0],["له رقيق خصر","كالغصن الميال",31,"ل",1,0],["له رتبة علياء في الفضل دونها ال","سّمَا كان أعيا نَيلُها كلّ طالبِ",32,"ب",1,0],["له رمحٌ بأسفلِ حالبيْهِ","يجيد الطعنَ في يوم الهياجِ",33,"ج",1,0],["له روضةٌ في الجود أكثرُ روَّدا","من المنهل الطامى وأوفرُ ورّدا",34,"د",2,0],["له رتبة فوق النبي ورتبة","له دونه فاعجب لهذا التنافر",35,"ر",1,0],["لَهُ رايَةٌ تَهدي الجُموعَ كَأَنَّها","إِذا خَطَرَت في ثَعلَبِ الرُمحِ طائِرُ",36,"ر",1,0],["له راحة تروي المكارم عن عطا","كذا وجهه يروي الطلاقة عن بشر",37,"ر",1,0],["له راحة تروي المكارم عن عطا","ووجه لنا يروي الطلاقة عن بشر",38,"ر",1,0],["لَهُ رَواحٌ إِلى القَص","فِ دائِمٌ وَبُكورُ",39,"ر",1,0],["له راحة بحي بها الفضل خالداً","ونصحب منها جعفراً وربيعا",40,"ع",2,0],["لَهُ رَغبَةٌ في الحَمدِ لَم تُغشَ رَهبَةً","وَلَكِنَّهُ في الذَمِّ لَم يَألُ ذو زُهدِ",41,"د",1,0],["له روح تحن لخير عهد","بمعهدها الأنيس من السفوح",42,"ح",1,0],["لَه رَبطُ جأشٍ يحسب الحرب هُدنة","وَحزمٌ يَرى في الهدنة الحرب ينجرُّ",43,"ر",1,0],["له رَأْيٌ أبَى السُّلطانُ إلاّ","عليه أنْ يُعِدَّ له اتّكالا",44,"ل",2,0],["لَهُ راحَتا جُودٍ إِذا ما أَغارَتا","عَلى العُدم لم تَسمَع زَماناً بمُعدَمِ",45,"م",1,0],["لَهُ راحَتانِ الحَتفُ وَالغَيثُ فيهِما","أَبى اللَهُ إِلّا أَن تَضُرَّ وَتَنفَعا",46,"ع",2,0],["له راحةٌ فيها لراجيه راحةٌ","إذا ما رآها معسِرٌ صاحَبَ اليُسرا",47,"ر",2,0],["له رَجفانٌ بالرياح مُقعقعٌ","كما رجفت رايات كسرى وقيصرا",48,"ر",2,0],["لهُ ركبت خيل الأماني مغيرةً","وما ركبتْ إلاَّ لتغنى وتغنما",49,"م",2,0],["له روض يفوح بكل طيب","المسك حلو للمنال",50,"ل",1,0],["له راحةٌ لو تَرضَع المُزنُ دَرَّها","سمَتْ باللآلي مُعْصِراتُ الحَوامِلِ",51,"ل",1,0],["له راحة تنهل جوداً بنانها","ووجه إذا قابلته يتهلل",52,"ل",1,0],["لَه رِجلاَ بعيرٍ في اختِبَاطٍ","إذا أمَّ الوَلائمَ يستطِيلُ",53,"ل",1,0],["لَه رافعا كفَّ الدُّعاءِ فإنَّه","سَميعُ دعاءٍ وهُو لِلعبدِ أقرَبُ",54,"ب",1,0],["له ردت الشمس حتى قضى","الصلاة وقام بما قد وجب",55,"ب",1,0],["له رُسْلٌ من الأجفا","نِ توصيك بأن تَوْصي",56,"ص",2,0],["لَهُ راحَةٌ ما البحرُ إِلّا بِلالُها","فَلا الوَبْلُ يَحكيها إِذِ الجودُ ينهلُّ",57,"ل",1,0],["له رتبة تعلو على كل سامكِ","مسالكه رُشداً خيارُ المسالكِ",58,"ك",1,0],["له رؤيةٌ تشفى السقيمَ وهيْبةٌ","تُميتُ عدوَّ اللَّه قبل قتالهِ",59,"ل",2,0],["له راحة في لثمها كل راحة","وكف بها وقع النوائب بنكف",60,"ف",1,0],["لَهُ رُؤْيَةٌ تَسْمُو بِكُلِّ المَنَاهِجِ","تَبَارَكَ رَبٌّ خَصَّنَا بِوُصُولِهِ",61,"ه",1,0],["لَهُ رُتْبَةٌ تَسْمُو لِرِفْعَةِ قَدْرِهِ","وَأَخْلاَقُهُ تُنْبِيكَ عَنْ شَرْحِ صَدْرِهِ",62,"ه",1,0],["لَهُ رُتْبَةٌ تَسْمُوا عَلىَ كُلِّ مُرْسَلِ","دَلِيلٌ صَدْوقٌ فِي الْكِتَابِ الْمُنَزَّلِ",63,"ل",1,0],["له رحَلاتٌ للتنّزه والعُلا","يقصِّر كل عن بلوغ مداها",64,"ا",3,0],["له رحلة للهند طال قيامه","وجاء كمثل البدر غذ هو طالعُ",65,"ع",1,0],["لَهُ راحَةٌ لَو أَنَّ مِعشارَ جودِها","عَلى البرِّ صارَ البرُّ أَندى مِنَ البَحرِ",66,"ر",1,0],["له ردت الشمس غب الغروب","وقد كلمته الوحوش الأوابد",67,"د",1,0],["له رواء ما زال يروي","بالبشر آمالنا الحوائم",68,"م",1,0],["لَه رايةٌ في المجدِ سامكة الذرى","سَمت في معاريج السما واِشمخرّتِ",69,"ت",1,0],["له راية بالثغر سوداء لم تزل","تفض بها للمشركين جموع",70,"ع",1,0],["له روحي الفداء شهاب عصرٍ","جليل القدر مفضالٌ مقدَّمْ",71,"م",1,0],["له روحي الفدا حرٌّ كريم","على كل الأكارم قد ترقّى",72,"ق",2,0],["لهُ رِياضاتٌ وأَخلاقُهُ","أَعْذَبُ مِنْ رِشْفِ اللَّمى والرُّضابْ",73,"ب",1,0],["له رفعة القدر الشريف ولم يزل","كريما رحيما فاضلا ومبجلا",74,"ل",2,0],["له رتب تسامت فاعتلت فو","ق كل الأكرمين من الكرام",75,"م",1,0],["له ريح زكي فاللَه أرجو","يعطرني به بالفضل نامي",75,"م",2,0],["له راحةٌ في المحْلِ يهْمي سحابُها","ببحرِ نوالٍ ما للجّتِه شطُّ",76,"ط",1,0],["له رأيٌ كنصْلِ السّيفِ ماضٍ","غدا في مفصِل الجُلّى يحُزُّ",77,"ز",1,0],["له رِيقةٌ كالسَّلسبيل فهل إلى","شِفاى بذاك السَّلسبيلِ سبيلُ",78,"ل",1,0],["له روعةٌ تغشى النفوس هنيئةٌ","كعيد جلوس الملك في مُهَج الشعبِ",79,"ب",1,0],["له راحة بين نعمى وبؤس","بها الصاب مجتمع والعسل",80,"ل",1,0],["له ردفاً فقال له ترانا","نكون لذي التجارة مُردفينا",81,"ن",2,0],["له رأفةٌ لو موزج الصبر باسمها","لأصبح نخلا تمره رطب التمر",82,"ر",1,0],["له راحة تجري على الخلق دائما","مواهبها للمعتفين سواكب",83,"ب",1,0],["له رحيا منونٍ منجنونٍ","على الثقلين قطبهما يدورُ",84,"ر",1,0],["لَهُ راحَةٌ في أَن يَرى كُلَّ راحَةٍ","بِلا رَاحَةٍ مِن أَن تَجودَ وَتُفضِلا",85,"ل",2,0],["لَهُ رَاحَةٌ أندَى مِنَ البَحرِ فِى نَدِ","وَيُروِى بِهَا كُلَّ الأَنامِ بِعَسجَدِ",86,"د",1,0],["له روحي الفدا فعسى يُواصل","يُرحني من غموم مع ظلامه",87,"م",2,0],["له رياض وحياض كم دنت","إلى المنى بنا فَرُدْ أو فَرِدِ",88,"د",1,0],["له راحة فيها لنا أي راحة","غدا كل جيد في نداها مطوقا",89,"ق",2,0],["له ريقة بخراء تصرع من دنا","وتقطع خيشوم الضجيع الملازم",90,"م",1,0],["له