{"poems":[[108,"فؤادك أولى بالعتاب","https://www.shoaraa.com/p13816",""],[53,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[53,"تناسيت إلا باقيات من الذكر","https://www.aldiwan.net/poem30441.html","الطويل"],[63,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[9,"ودع هريرة إن الركب مرتحل","https://www.aldiwan.net/poem21969.html","البسيط"],[23,"حصان رزان ما تزن بريبة","https://www.aldiwan.net/poem21613.html","الطويل"],[72,"صحا القلب لولا نسمة تتخطر","https://www.aldiwan.net/poem18693.html","الطويل"],[72,"بكيت بأجفان المحب المتيم","https://www.aldiwan.net/poem19671.html","الطويل"],[72,"أمنزل ذات الخال حييت منزلا","https://www.aldiwan.net/poem20541.html","الطويل"],[51,"ليهنك لبس المهرجان وإن غدا","https://www.aldiwan.net/poem64568.html","الطويل"],[51,"غدا الدهر مفترا أغر المضاحك","https://www.aldiwan.net/poem65812.html","الطويل"],[51,"ومعتذر من نعمة قد أفادها","https://www.aldiwan.net/poem65998.html","الطويل"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[43,"ملامي النوى في ظلمها غاية الظلم","https://www.aldiwan.net/poem10536.html","الطويل"],[28,"له راحتا كفين في راحتيهما","https://www.aldiwan.net/poem5152.html","الطويل"],[28,"إذا مسمع أعطتك يوما يمينه","https://www.aldiwan.net/poem5452.html","الطويل"],[28,"ما ابن سليم سائرا بجياده","https://www.aldiwan.net/poem5600.html","الطويل"],[61,"هل الحذق إلا لعبد الكريم","https://www.aldiwan.net/poem51446.html","المتقارب"],[61,"أمن رقبة عاف السلام مودعا","https://www.aldiwan.net/poem51570.html","الطويل"],[66,"أتاني كتاب منك أحسب أنه","https://www.aldiwan.net/poem40301.html","الطويل"],[80,"ملاعب البيض بين البيض والأسل","https://www.aldiwan.net/poem31322.html","البسيط"],[80,"ومرو صدى الروضات يسحب دائبا","https://www.aldiwan.net/poem31399.html","الطويل"],[44,"متى أنت عن ذهلية الحي ذاهل","https://www.aldiwan.net/poem30372.html","الطويل"],[44,"فحواك عين على نجواك يا مذل","https://www.aldiwan.net/poem30389.html","البسيط"],[74,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[52,"وحلو الدلال مليح الغضب","https://www.aldiwan.net/poem27264.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85837","المجتث"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/55693","الطويل"],[28,"كيف نخاف الفقر يا طيب بعدما","https://www.poetsgate.com/ViewPoem.aspx?id=21608",""],[51,"وليلٍ غشا ليلٌ من الدجن فوقَه","https://www.poetsgate.com/ViewPoem.aspx?id=25512",""],[88,"أطلَّ صباح العيد في الشرق يسمع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19511&r=&rc=14",""],[116,"يا سائق الجمال","https://www.aldiwan.net/poem40600.html","عموديه"],[136,"تأمل رعاك الله حسن المواكب","https://www.aldiwan.net/poem49034.html","الطويل"],[143,"عيوب لابن مالك قد كفتنى","https://www.aldiwan.net/poem58334.html","الوافر"],[143,"ترى رائح يأتى بأخبار من غدا","https://www.aldiwan.net/poem58445.html","الطويل"],[161,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[196,"أهم سرى أم عاد للعين عائر","https://www.aldiwan.net/poem54405.html","الطويل"],[211,"تراءت لك الأيام باسمة الثغر","https://www.aldiwan.net/poem13519.html","الطويل"],[211,"أماني الهنا بالحمد وافت وبالشكر","https://www.aldiwan.net/poem13524.html","الطويل"],[236,"لا أوحش الله ممن","https://www.aldiwan.net/poem31995.html","المجتث"],[262,"هلما نحييها ربى وربوعا","https://www.aldiwan.net/poem38241.html","الطويل"],[283,"تقول صحابي والمطي بنا تخدي","https://www.aldiwan.net/poem32793.html","الطويل"],[305,"أحبتنا بنجد والصفيح","https://www.aldiwan.net/poem16826.html","الوافر"],[306,"على مثلها من أنعم يجب الشكر","https://www.aldiwan.net/poem56549.html","الطويل"],[365,"أقلا عند طيتي المقالا","https://www.aldiwan.net/poem60808.html","الوافر"],[372,"جزعت فجزع دمع عينك بالدم","https://www.aldiwan.net/poem57157.html","الطويل"],[411,"أرى القلب أمسى بالأوانس مولعا","https://www.aldiwan.net/poem67492.html","الطويل"],[433,"دع العذل إني أكره العذل والغدرا","https://www.aldiwan.net/poem12480.html","الطويل"],[462,"بني عمنا كفوا العضيهة أنها","https://www.aldiwan.net/poem15099.html","الطويل"],[465,"سقيت حياً جفني يا بانة الحمى","https://www.aldiwan.net/poem3501.html","عموديه"],[483,"أسحر السحر في جفن الغزال","https://www.aldiwan.net/poem24467.html","عموديه"],[515,"أما ومواضي مقلتيها الفواصل","https://www.aldiwan.net/poem20797.html","الطويل"],[516,"لكم من ودادي ناصر ليس يخذل","https://www.aldiwan.net/poem12196.html","الطويل"],[539,"عدو الحق عند الناس طرا","https://www.aldiwan.net/poem47994.html","عموديه"],[539,"بأي لسان في المحافل أخطب","https://www.aldiwan.net/poem48289.html","عموديه"]],"verses":[["له راحة تحيي الورى غير أنها","إذا حكمت في المال ينعب ناعبه",0,"ب",2,0],["لَهُ ريقَةٌ تَجري بِما شاءَ رَبُّهُ","كَما حالَ سُمٌّ بَينَ أَنيابِ أَرقَمِ",1,"م",1,0],["لَهُ رائِدٌ يَلقاكَ مِن قَبلِ شَخصِهِ","جَلالاً كَما دَلَّ الضِياءُ عَلى الفَجرِ",2,"ر",1,0],["لهُ ريقَةٌ ما ذُقْتُها غيرَ أنَّنِي","أظُنُّ وظنِّي صادِقٌ أنَّها خَمْرُ",3,"ر",1,0],["لَهُ رِدافٌ وَجَوزٌ مُفأَمٌ عَمِلٌ","مُنَطَّقٌ بِسِجالِ الماءِ مُتَّصِلُ",4,"ل",1,0],["لَهُ رَتَبٍ عالٍ عَلى الناسِ كُلِّهِم","تَقاصَرُ عَنهُ سَورَةَ المُتَطاوِلِ",5,"ل",1,0],["له راحةٌ فيها على البأسِ والندى","دلائلُ حتَّى في الجمادِ تؤثر",6,"ر",1,0],["له راحةٌ صلى الحيا خلف جودها","وأذعن فانظر للمصلّي المسلّم",7,"م",1,0],["له راحة ضمَّت يراعاً ومرهفا","كأنَّهما زاداه بالمكثِ أنملا",8,"ل",2,0],["له راحة لو مستِ الصخر أنبعت","جوانبُه ماءً وأورق يابسه",9,"س",2,0],["له راحةٌ روْحاءُ يسفكُ ماءَها","وليس لماء الوجهِ منه بسافك",10,"ك",1,0],["له راحةٌ روحاءُ تشهد أنها","مغيضٌ لصنعٍ أو مفيضٌ لنائلِ",11,"ل",1,0],["له رونقُ العَضبِ الصَّقيل وحَدُّه","براعةَ أخلاقٍ وصدقَ عزائمِ",12,"م",1,0],["لَهُ رَحمَةٌ تُحيّ العِظامَ وَغَضبَةٌ","بِها فَضلَةٌ لِلجُرمِ عَن صاحِبِ الجُرمِ",13,"م",1,0],["لَهُ راحَتا كَفَّينِ في راحَتَيهِما","مِنَ البَحرِ فَيضٌ لا يُنَهنَهُ زاخِرُه",14,"ر",2,1],["لَهُ راحَةٌ بَيضاءُ يَندى بَنانُها","قَليلٌ إِذا اِعتَلَّ البَخيلُ اِعتِلالُها",15,"ل",3,0],["لَهُ رَهَجٌ عالي الزُهاءَ كَأَنَّهُ","غَيابَةُ دَجنٍ ذي طَخاءٍ تَغَيَّما",16,"م",2,0],["له راحَةٌ سَيرُها راحةٌ","تَمُرُّ على الوَجْهِ مَرَّ النَّسيمِ",17,"م",1,0],["له راحةٌ ما قيسَ بالغَيْثِ صَوبُها","لَدى المِحْلِ إلاّ كانَ أندى وأوسَعا",18,"ع",2,0],["لَهُ رِقَّةُ الخَنساءِ في حالِ نَوحِها","وَلَكِنَّ مَعناهُ لِقُوَّتِهِ صَخرُ",19,"ر",1,0],["له رَجاحَةُ حِلْمٍ عند قُدْرَتِهِ","أرسَى إذا طاشتِ الأحلامُ من جَبَلِ",20,"ل",1,0],["لهُ رِعْدَةٌ تعتادُهُ في انحدارِهِ","كما تَبْسُطُ الكفُّ العنانَ وتقبضُ",21,"ض",1,0],["لَهُ ريقَةٌ طَلٌّ وَلَكِنَّ وَقعَها","بآِثارِهِ في الشَرقِ وَالغَربِ وابِلُ",22,"ل",1,0],["لَهُ رِياضُ نَدىً لَم يُكبِ زَهرَتَها","خُلفٌ وَلَم تَتَبَختَر بَينَها العِلَلُ",23,"ل",1,0],["لَهُ رايَةٌ لَو زاحَمَ الدَهرُ تَحتَها","لَعُدَّت بِهِ دُهمُ اللَيالي مِنَ الشُقرِ",24,"ر",1,0],["لَهُ راحَةٌ يا لَها راحَةً","تَرى جَدَّ نائِلِها كَاللَعِب",25,"ب",1,0],["له رسول إلى العالمين","وهو الأمين",26,"ن",1,0],["له رجفة تنتابه وهو واقف","على جانب والجوّ بالبرد يلسع",27,"ع",1,0],["لَهُ رَاحَتَا كَفّينِ في رَاحَتَتهِمَا","مِنَ البَحرِ فَيضٌ لا يُنَهَنهُ زَاخرُهْ",28,"ر",2,0],["لَهُ راحَتَا كَفَّيْنِ في راحَتَيْهِمَا","مِنَ البَصْرِ فَيْضٌ لاَ يُنَهْنَهُ زاخِرُهْ",28,"ر",2,0],["له راحة ٌ فيها الحطيمُ وزمزمُ","ولكن مَخَبٌّ للركاب ومسعم",29,"م",1,0],["له رجفة تنتابه وهو واقف","على جانب والطقسبالبرد يلسع",30,"ع",1,0],["له رقيق خصر","كالغصن الميال",31,"ل",1,0],["له رتبة علياء في الفضل دونها ال","سّمَا كان أعيا نَيلُها كلّ طالبِ",32,"ب",1,0],["له رمحٌ بأسفلِ حالبيْهِ","يجيد الطعنَ في يوم الهياجِ",33,"ج",1,0],["له روضةٌ في الجود أكثرُ روَّدا","من المنهل الطامى وأوفرُ ورّدا",34,"د",2,0],["له رتبة فوق النبي ورتبة","له دونه فاعجب لهذا التنافر",35,"ر",1,0],["لَهُ رايَةٌ تَهدي الجُموعَ كَأَنَّها","إِذا خَطَرَت في ثَعلَبِ الرُمحِ طائِرُ",36,"ر",1,0],["له راحة تروي المكارم عن عطا","كذا وجهه يروي الطلاقة عن بشر",37,"ر",1,0],["له راحة تروي المكارم عن عطا","ووجه لنا يروي الطلاقة عن بشر",38,"ر",1,0],["لَهُ رَواحٌ إِلى القَص","فِ دائِمٌ وَبُكورُ",39,"ر",1,0],["له راحة بحي بها الفضل خالداً","ونصحب منها جعفراً وربيعا",40,"ع",2,0],["لَهُ رَغبَةٌ في الحَمدِ لَم تُغشَ رَهبَةً","وَلَكِنَّهُ في الذَمِّ لَم يَألُ ذو زُهدِ",41,"د",1,0],["له روح تحن لخير عهد","بمعهدها الأنيس من السفوح",42,"ح",1,0],["لَه رَبطُ جأشٍ يحسب الحرب هُدنة","وَحزمٌ يَرى في الهدنة الحرب ينجرُّ",43,"ر",1,0],["له رَأْيٌ أبَى السُّلطانُ إلاّ","عليه أنْ يُعِدَّ له اتّكالا",44,"ل",2,0],["لَهُ راحَتا جُودٍ إِذا ما أَغارَتا","عَلى العُدم لم تَسمَع زَماناً بمُعدَمِ",45,"م",1,0],["لَهُ راحَتانِ الحَتفُ وَالغَيثُ فيهِما","أَبى اللَهُ إِلّا أَن تَضُرَّ وَتَنفَعا",46,"ع",2,0],["له راحةٌ فيها لراجيه راحةٌ","إذا ما رآها معسِرٌ صاحَبَ اليُسرا",47,"ر",2,0],["له رَجفانٌ بالرياح مُقعقعٌ","كما رجفت رايات كسرى وقيصرا",48,"ر",2,0],["لهُ ركبت خيل الأماني مغيرةً","وما ركبتْ إلاَّ لتغنى وتغنما",49,"م",2,0],["له روض يفوح بكل طيب","المسك حلو للمنال",50,"ل",1,0],["له راحةٌ لو تَرضَع المُزنُ دَرَّها","سمَتْ باللآلي مُعْصِراتُ الحَوامِلِ",51,"ل",1,0],["له راحة تنهل جوداً بنانها","ووجه إذا قابلته يتهلل",52,"ل",1,0],["لَه رِجلاَ بعيرٍ في اختِبَاطٍ","إذا أمَّ الوَلائمَ يستطِيلُ",53,"ل",1,0],["لَه رافعا كفَّ الدُّعاءِ فإنَّه","سَميعُ دعاءٍ وهُو لِلعبدِ أقرَبُ",54,"ب",1,0]]}