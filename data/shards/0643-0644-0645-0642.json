{"poems":[[73,"جعل العتاب إلى الصدود توصلا","https://www.aldiwan.net/poem4030.html","الكامل"],[74,"أعيذ ريم الترك بالروم","https://www.aldiwan.net/poem19684.html","السريع"],[422,"سعدت نجد إذا وافيت نجدا","https://www.aldiwan.net/poem54161.html","الرمل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122667","الخفيف"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81688","المقتضب"]],"verses":[["كُلٌّ مُقِرٌّ بِالجَمالِ لَهُ فَما","يَحتاجُ حاكِمُ حسنه أَن يُسجلا",0,"ل",2,0],["كلم قلبي وسماعي فما","ألذّ في الحالين تكليمي",1,"م",2,0],["كلّ مقام إلى الحرب يرى","شكر نعمائك فرضاً أنْ يؤدَّى",2,"د",2,0],["كُلُّ مُقوَرَّةِ تَخَوَّنَها الضُّم","رُ فآضَت بالضَّمرِ في النَّسعِ نِسعا",3,"ع",2,0],["كل مقوِّمٍ لكِّليٍّ علا","مقوِّمٌ أيضا لما قد سفلا",4,"ل",2,0],["كلّ مقدمٍ بطلٍ","كالهزبر إذ يثب",5,"ب",1,0]]}