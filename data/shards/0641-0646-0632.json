{"poems":[[87,"خليفة ما جاء حتى ذهبا","https://www.aldiwan.net/poem7913.html","الرجز"],[46,"صحبي قفوا مليتكم صحبا","https://www.aldiwan.net/poem30062.html","السريع"],[104,"اغفري لي إذا اتهمتك بالغد","https://www.aldiwan.net/poem33102.html","الخفيف"],[22,"شهد الحطيأة يوم يلقى ربه","https://www.aldiwan.net/poem21694.html","الكامل"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[48,"دع القوم سلوا بالضغائن بينهم","https://www.aldiwan.net/poem22527.html","الطويل"],[48,"أوى ربي إلي فما وقوفي","https://www.aldiwan.net/poem22692.html","الوافر"],[8,"ولقد أغدو بشرب أنف","https://www.aldiwan.net/poem21800.html","الرمل"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[108,"في زيارة الواحات","https://www.poetsgate.com/ViewPoem.aspx?id=179379",""],[164,"يا من رأى مثل ابن تاج الدين","https://www.aldiwan.net/poem58960.html","الكامل"],[168,"ومن تك نزهته قينة","https://www.aldiwan.net/poem67822.html","المتقارب"],[228,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[240,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[276,"صدوا عن الصب الكئيب واعرضوا","https://www.aldiwan.net/poem52111.html","الكامل"],[308,"لا يعرف الدهر أحياء وأمواتا","https://www.aldiwan.net/poem58280.html","البسيط"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[358,"بدت لك شمس الخدر من فلق السجف","https://www.aldiwan.net/poem40039.html","الطويل"],[371,"فنزهت طرفي في طرائف حسنه","https://www.aldiwan.net/poem17128.html","الطويل"],[385,"أبرق سرى وهنا فهيج أشجاني","https://www.aldiwan.net/poem48778.html","الطويل"],[473,"أمر النصارى عجيب","https://www.aldiwan.net/poem60499.html","المجتث"],[505,"دع وهم أهل الوحدة المطلقه","https://www.aldiwan.net/poem37935.html","السريع"],[563,"حقيقتي حضرة التجلي","https://www.aldiwan.net/poem34241.html","مخلع البسيط"],[563,"إن السيادة والريا","https://www.aldiwan.net/poem34634.html","مجزوء الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126676","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122703","المتقارب"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77643","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77595","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77616","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77496","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77477","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126145","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64641","الطويل"],[1409,"","https://poetry.dctabudhabi.ae/diwan/poem/130250","الكامل"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79998","الكامل"],[1970,"","https://poetry.dctabudhabi.ae/diwan/poem/132026","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27984","الوافر"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104956","الطويل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82978","المجتث"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100896","الكامل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93426","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93795","البسيط"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118972","الرمل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68023","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89471","المواليا"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52976","المتدارك"],[3643,"","https://poetry.dctabudhabi.ae/diwan/poem/145186","الطويل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128946","الرجز"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102995","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102733","الكامل"],[4502,"","https://poetry.dctabudhabi.ae/diwan/poem/75858","الكامل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147303","الكامل"],[4690,"قطاف","https://www.poetsgate.com/ViewPoem.aspx?id=175471",""],[4830,"نَخلُ العِراق","https://www.poetsgate.com/ViewPoem.aspx?id=207898",""],[5717,"إنا من الغابر نتقم السير","https://www.poetsgate.com/ViewPoem.aspx?id=170583",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5847,"ألم وأمل","https://www.poetsgate.com/ViewPoem.aspx?id=6444",""],[5853,"ظلمة الشك","https://www.poetsgate.com/ViewPoem.aspx?id=175613",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[5350,"لمن الديار بتولع فيبوس","http://www.aldiwanalarabi.com/poemDescription.do?poemId=510756",""],[6249,"حبٌّ مختَلَق !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85657&r=&rc=0",""]],"verses":[["فَنزع النَثرةَ عَنهُ وَاِنطَلق","في قلة يَلقى العَديدَ في الحَلَق",0,"ق",1,0],["فَنَزَلتَ بَينَ ظُهورِهِم أَشِراً","فَقَرَوكَ ثَمَّ الطَعنَ وَالضَربا",1,"ب",2,0],["فَنَزلناه آمنين زَماناً","نَجتَني مِن وَرودِهِ وَأَقاحِه",2,"ه",1,0],["فَنُزِعتَ مَكذوباً عَلَيكَ وَلَم","تَنزِع إِلى طَمَعٍ وَلا فَقرِ",3,"ر",1,0],["فَنَزَلوا مَنازِلاً عَلِيَّه","وَاِرتَفَعوا عَن مَوضِعِ الرَعِيَّه",4,"ه",1,0],["فَنَزِّه جَميلاً جِئتَهُ عَن جَزايَةٍ","تُؤَمَّلُ أَو رِبحٍ كَأَنَّكَ تاجِرُ",5,"ر",1,0],["فَنَزِّه ناظِرَيكَ عَنِ الغَواني","وَأَكرِم جارَتَيكَ عَنِ الحِوارِ",6,"ر",1,0],["فَنَزَلنا بِمَلِيعٍ مُقفِرٍ","مَسَّهُ طَلُّ مِنَ الدَجنِ وَرَش",7,"ش",1,0],["فنزَعَ الحاجبُ تاجَ مُلْكِهِ","وقادَه مُكَتَّفاً لِهُلْكِهِ",8,"ه",1,0],["فنزلوا سواد عين شمس","وسادُهم رحالُهم كأمس",9,"س",1,0],["فنزلتُ له عن طرف السَّبْ","قِ وقلتُ بكَفِّكَ مِقْوَدهُ",10,"د",2,0],["فَنَزَلْتُ منه -إذْ نزلتُ- بجنةٍ","وشربتُ في مثلَ ماء الكَوْثَر",11,"ر",1,0],["فنزعت مخدوعا يدا عن طاعة","وظللت إذ قارنت شر قرين",12,"ن",1,0],["فَنُزهَتُنا وَاِستِراحَتُنا","تَلاقي العُيون وَدَرسُ الكُتُب",13,"ب",1,0],["فَنَزا نَزوَة الوَميضِ من الغَ","لِّ وَدَوّى كَنافِخ في صورِ",14,"ر",1,0],["فَنَزيلُ الإِحسانِ مَن","باتَ في مَنزِلِ الحَسَن",15,"ن",1,0],["فنزيله خصب الرحاب وَجاره","عالي الجناب وَبسطه لا يقبض",16,"ض",1,0],["فنزه النفس عن مالٍ وعن أملٍ","قد أتعباها ولا تجزع لما فاتا",17,"ت",2,0],["فنزه إله العالمين وقد سن","عن الصورة الحسية البشرية",18,"ه",1,0],["فَنَزّه بِها طَرفَ الحجا فَهيَ جنّةٌ","قُطوفُ مَعانيها تَسامَت عَن القَطفِ",19,"ف",1,0],["فَنَزَّهتُ طَرفي في طَرائِفِ حُسنِهِ","وَأَسكَنتُ حُبّي ظِلَّ جَنَّةِ عَدنِهِ",20,"ن",2,1],["فَنزَهَت فيها الطَرف حَتّى ظَننتُها","مَعاني حَبيب في بَلاغة سحبان",21,"ن",1,0],["فَنَزِّهِ الهَجوَ عَنهُم","فَالقَومُ دونَ الهِجاءِ",22,"ا",2,0],["فنزِّهِ الخالِقَ عن قولِ من","أَشرَكَ واطْرَحْ هذه الشِّقْشِقَهْ",23,"ق",2,0],["فنزه الرب عن زمان","وعن مكان وعن محل",24,"ل",1,0],["فنزاعه المذموم لا","ما ليس عنه من محيد",25,"د",1,0],["فنزّلت قدراً في صعودك منزلاً","فكنتَ لبسم اللّه نقطة بائهِ",26,"ه",1,0],["فَنَزَّلتَ في ذُروَةٍ مَن عَوَى","وَيَنعِقُ في ضَأنِهِ مَن نَعَق",27,"ق",1,0],["فَنَزَلت عَلَيهما الرِجالُ","ضَرباً وَمن ضَحك عَلَيهم مالوا",28,"ل",3,0],["فَنَزل الغُلامُ وَالشَيخ رَكب","لِيتّقي لائِمه وَيَجتَنب",29,"ب",1,0],["فَنَزلا وَأَطلَقا الحِمارا","هُما وَرا وَهوَ أَماماً سارا",29,"ر",2,0],["فَنَزَلَت عَلَيهِ مثلَ الصَخرَه","وَكَسَرَت دِماغَهُ بِالمَرَّه",30,"ه",1,0],["فَنَزَلا فيها وَمِنها شَرِبا","وَبَعد ذا كانَ الطُلوع متعبا",31,"ب",2,0],["فَنَزلَ الكُلُّ عَلَيها ضَربا","وَأَخَذوا الأَموال مِنها غَصبا",32,"ب",2,0],["فنزلت كفارة الظهار","وحكمها بين الأنام جار",33,"ر",1,0],["فنزوي من الذكرى ولا ينفع الصدا","إلا هي أذكى في القلوب من الشُعَل",34,"ل",1,0],["فنزلتُ من أحْمائِهم بحفيظةٍ","وقعدتُ من أحسابِهم في مَقْعَدِ",35,"د",1,0],["فنزت بطنتي وهاجت على نف","سي بلاءً ما كان في حسباني",36,"ن",2,0],["فنزعن من كفَّي قائمَ أبيضٍ","أعددته للقا الخطوب السود",37,"د",1,0],["فنزّهت طرف العين فيها لذاذَةً","فقامت على ساق حياة التنعّس",38,"س",1,0],["فنزه عن معارضةِ الليالي","كلامَك إن حكمَ الدهر بانا",39,"ن",2,0],["فَنُزُولهُم أيضاً هُنَالِكَ ثَابِتٌ","كَنُزُولِهِم أيضاً هُنَا لِلشَّانِ",40,"ن",1,0],["فَنُزُولُ رَبٍّ لَيسَ فَوقَ سَمَائِهِ","فِي العَقلِ مُمتَنِعٌ وَفِي القُرآنِ",40,"ن",1,0],["فنزههم عن وصمة السهو والخطا","كما لم يدنس ثوب عصمتهم وزر",41,"ر",1,0],["فنزِّهِ الكَلبَ عن أَن","تَرى أَخا البخلِ مثله",42,"ه",1,0],["فنزعتُ شيطانَ الخنا فى رأسه","وتركتهُ متخبِّطاً يتفزَّع",43,"ع",1,0],["فَنَزَلتُ في فرش الرِّياض وَلَم يَكُن","ليَحوزها مثلي بِغَيرِ نزولِ",44,"ل",1,0],["فنزه الطرف في طرس به سطعت","أنوار شمس معاليها وقد وقدت",45,"ت",1,0],["فنزيل القوم كلا","لا يضامُ لا يضامُ",46,"م",1,0],["فنزلتَ فِيهَا والنفوسُ زَواهقٌ","يخشون من وَطْءِ الركائب زَلْقا",47,"ق",2,0],["فنزهة النفس وجهه والشعور أستار","على العقول فوق أعطافه ودمعي احتار",48,"ر",1,0],["فنزالِ نزالِ على الأعْدا","لا ترعوْا في الأعْدا عَهدا",49,"د",2,0],["فنزهت في الفردوس نفسا بهية","وفي ملكوت الله طرا أتقلب",50,"ب",1,0],["فنزلا فيها معا وارتويا","من عذب ماء سائغ الورود",51,"د",1,0],["فنزلوا تحتَ غصون المرخِ","وعقد غيث السحب فيه مرخي",52,"ي",1,0],["فنزهت إلا من نداكم مطامعي","وأكيس أهل الكيس من هو آيس",53,"س",1,0],["فنزعت كفى عن مبايعة الهوى","وتركت اسهم ميسرى وقد أحى",54,"ح",2,0],["فنزَعتُهُ وَكأَنَّ فجَّ لَبانِه","وَسواءَ جَبهتِهِ مَداكُ عَروسِ",55,"س",1,0],["فنزور فيها الشمس عند شروقها","ونبيت عند البدر حين ينير",56,"ر",1,0],["فَنزَعْتني وقَطَعْتَ دابِرَ نَشْوتي","كَمْ خافَ ذاكَ تَوَرُّدي وَ تَعَوّذا",57,"ذ",2,0],["فَنَزَفتَ حتّى الجرحُ مَلَّ نزيفَهُ","وَصَبَرتَ حتّى انقادَ رزؤكَ صاغِرا",58,"ر",2,0],["فنزعة الجديد سيل جارف","ونزعة القديم ترمي بالشرر",59,"ر",1,0],["فنزه منه العقل عن قذر ولو","ث لوث شكوك قائمات مريبتي",60,"ت",2,0],["فنزههم في ذاته ومعاني","ه وأوصافه القدسية العظيميتي",60,"ت",2,0],["فنزلنا إلى حضيض التواني","وافتقدنا بفلكنا ربانه",61,"ن",2,0],["فنزعتُ غلا من فؤادكَ ضالعاً","فشدتكَ في همس العيون جفون",62,"ن",1,0],["فنزّه ذات الإله عن مس غيرها","فليس لها حامل ولا عليها حملا",63,"ل",2,0],["فَنَزَعتُهُ وَكَأَنَّ لَبانِهِ","وَسَواءَ جَبهَتِهِ مَداكُ عَروَسِ",64,"س",1,0],["فَنَزَلْتُ اليمَّ .. لا أخْشى الردى","داخلاً في نفَقٍ بعدَ نفَقْ",65,"ق",1,0]]}