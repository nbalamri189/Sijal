{"poems":[[47,"نهيتكم عن صالح فأبى بكم","https://www.aldiwan.net/poem62707.html","الطويل"],[50,"وفتية كمصابيح الدجى غرر","https://www.aldiwan.net/poem62458.html","البسيط"],[48,"تنكر صالح فضباب قيس","https://www.aldiwan.net/poem22866.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54895","الطويل"],[136,"تخطى ركبه الظلل القواء","https://www.aldiwan.net/poem54900.html","الوافر"],[253,"سما ان يرجا مطلبا ليصابا","https://www.aldiwan.net/poem1319.html",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63981","المتقارب"],[1025,"","https://poetry.dctabudhabi.ae/diwan/poem/143446","البسيط"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83239","الوافر"],[3193,"","https://poetry.dctabudhabi.ae/diwan/poem/33000","الطويل"],[3527,"","https://poetry.dctabudhabi.ae/diwan/poem/97670","الطويل"],[3560,"","https://poetry.dctabudhabi.ae/diwan/poem/117162","الطويل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61276","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120511","الوافر"],[4984,"الفاصلة .. ، ..","https://www.poetsgate.com/ViewPoem.aspx?id=197617",""]],"verses":[["فَقَد ظَهَرَت أَموالُكُم بَعدَ سَترِها","وَبَعدَ تَخَفّيها ظُهورَ الفَضائِحِ",0,"ح",1,0],["فَقَد ظَفِرتِ بِصَفوِ العَيشِ غانِمَةً","كَغُنمِ داوُدَ مِن أَسلابِ جالوتِ",1,"ت",1,0],["فَقَد ظَعَنوا وَما زَجَروا بِصَوتٍ","فَيَذعَرَهُم وَلا طُعِنوا بِراشِ",2,"ش",1,0],["فَقَدْ ظَاهَرَتْ فِي نَهْضَةِ العَصْرِ جِنْسَهَا","لِتَرْفعهُ وَالخَفْضُ مَا الدَّهْرُ يُضْمِرُ",3,"ر",1,0],["فَقد ظلمتكَ بالإقصَاءِ لُبنَى","وأولَتكَ القَطيعَةَ والجَفَاءَ",4,"ا",2,0],["فقد ظفرت مني يداك بوالد","اذا رمزوا الآباء قال صوابا",5,"ب",2,0],["فقد ظل رأسُك بي شامخاً","ولكنه شامخٌ هابط",6,"ط",1,0],["فقد ظلمناه أنّا لا نَرى أبداً","له إذا عُدَّ أهلُ الفضل أقرانا",7,"ن",2,0],["فَقَد ظَلَّ الصَديقَ وَلا يَزالُ","يُبادِلُكَ الخَواطِرَ صافِياتِ",8,"ت",1,0],["فَقَد ظَهَرَ الجورُ المُبيرُ وَأَجمَعَت","عَلى ذاكَ أَقوامٌ كَثيرو التَكاذِبِ",9,"ب",1,0],["فَقَد ظَفِرت منّا تميمُ بعثرةٍ","وَتلكَ لَعَمري عثرةٌ لا تقالها",10,"ل",3,0],["فَقَد ظفِرَت كفّاهُ منك بطائِلٍ","وما ظفِرَت كفاك منه بطائِلِ",11,"ل",1,0],["فقد ظهر","فيهِ أَثَر",12,"ر",1,0],["فقد ظهرت مآثره عيانا","فلبست عن بصير في استتار",13,"ر",1,0],["فقد ظل ما يرجى عزيز وإنما","إرادته تلوي لقوتها الصلبا",14,"ب",2,0]]}