{"poems":[[75,"خليلي لا فطر يسر ولا أضحى","https://www.aldiwan.net/poem11843.html","الطويل"],[90,"لمن تركت فنون العلم والأدب","https://www.aldiwan.net/poem45052.html","البسيط"],[53,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[53,"إني أراك بعين لا يراك بها","https://www.aldiwan.net/poem66345.html","البسيط"],[53,"إني لأغضي عن الزلات أثبتها","https://www.aldiwan.net/poem66380.html","البسيط"],[68,"جدت بخط بغير وجه","https://www.aldiwan.net/poem38792.html","مجزوء البسيط"],[68,"قد قيل طول البعد يسلي الفتى","https://www.aldiwan.net/poem39925.html","السريع"],[71,"صبرا لصرف زمان قاطع الحجج","https://www.aldiwan.net/poem28921.html","البسيط"],[21,"والطوط نزرعه فيها فنلبسه","https://www.aldiwan.net/poem36214.html","البسيط"],[54,"يا مسكة العطار","https://www.aldiwan.net/poem26955.html","المجتث"],[50,"صبح فضل ظاهر التيه","https://www.aldiwan.net/poem66197.html","السريع"],[48,"إرجع إلى السن فانظر ما تقادمها","https://www.aldiwan.net/poem22668.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54636","البسيط"],[53,"إني لأغضي عن الزلات أثبِتُها","https://www.poetsgate.com/ViewPoem.aspx?id=30737",""],[164,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[173,"إلى م أورد عتباً غير مستمع","https://www.aldiwan.net/poem1637.html",""],[189,"حمامنا هذه حمام","https://www.aldiwan.net/poem14651.html","مخلع البسيط"],[228,"ألدمع من عيني لم يذرف","https://www.aldiwan.net/poem41626.html","السريع"],[264,"نحمد مولانا الذي قد اصطفى","https://www.aldiwan.net/poem35821.html","الرجز"],[287,"في عنفوان الصبا ما كنت بالغزل","https://www.aldiwan.net/poem32668.html","البسيط"],[327,"ألا طرقتنا بالقرينين موهنا","https://www.aldiwan.net/poem56343.html","الطويل"],[369,"تنفس الروض وهو بشراه","https://www.aldiwan.net/poem60574.html","المنسرح"],[398,"حمدا لرب جل عن نديد","https://www.aldiwan.net/poem53683.html","الرجز"],[415,"يلط بالدين من مولاه مسلمه","https://www.aldiwan.net/poem32251.html","البسيط"],[445,"شوق شديد ووصل من حبيبين","https://www.aldiwan.net/poem34830.html","البسيط"],[520,"في مثل مدحك شرح القول مختصر","https://www.aldiwan.net/poem12117.html","البسيط"],[534,"لك البشارة قد قالوا الرحيل غدا","https://www.aldiwan.net/poem37101.html","البسيط"],[738,"","https://poetry.dctabudhabi.ae/diwan/poem/147208","المجتث"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63936","الهزج"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138062","الرجز"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202130","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46519","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46523","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27414","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27939","البسيط"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102509","الكامل"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84857","البسيط"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68318","الرجز"],[3447,"","https://poetry.dctabudhabi.ae/diwan/poem/32719","السريع"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35902","المجتث"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92443","البسيط"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199022","الرجز"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36772","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114311","البسيط"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77171","البسيط"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76683","البسيط"],[5066,"طرف أبي العيناء معسول","https://www.poetsgate.com/ViewPoem.aspx?id=187593",""],[3591,"ظن الحبيب بأن الصب قد عدلا","https://www.poetsgate.com/ViewPoem.aspx?id=149380",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""]],"verses":[["وَلَيسَ ذَميماً عَهدُ مَجلِسِ ناصِحٍ","فَأَقبَلَ في فَرطِ الوَلوعِ بِهِ نُصحا",0,"ح",2,0],["وليس ذلك مِن عجزٍ بخالقنا","عن أن يزجّ بنا في قبضة الشجب",1,"ب",1,0],["وليس ذاك بصُنْعي بل بصنع فتى","ما زال يُدني بلطف الصنع ما نزحا",2,"ح",2,0],["وليس ذاك ببدعٍ لا ولا عجب","كذاك قِدما تهاب السادةَ الخدم",3,"م",1,0],["وليس ذاك لآبائي ومجدِهمُ","لكن لأنِّي اتخذتُ العدلَ مِيزانا",4,"ن",2,0],["وَلَيسَ ذا مَذهَبي وَلَكِن","أُحِبُّ وَجهاً بِغَيرِ خَطِّ",5,"ط",1,0],["وَليسَ ذا حَقٍّ وَلَكِنَّهُ","تَوَقُّفُ الشَيءِ عَلى ضِدِهِ",6,"ه",1,0],["وليسَ ذاك لجهلي بالجمالِ إذنْ","لكنني من بحارِ الهمِّ في لُججِ",7,"ج",1,0],["وَلَيسَ ذو العِلمِ بِالتَقوى كَجاهِلِها","وَلا البَصيرُ كأَعمى ما لَهُ بَصَرُ",8,"ر",1,0],["وَلَيسَ ذا بِعَجيبٍ","وَلَيسَ في ذا تَماري",9,"ر",2,0],["وَلَيسَ ذا أَعجَبَ مِن ذاكُمُ","جارِيَةُ النَطّافِ تُغريهِ",10,"ي",2,0],["وَلَيسَ ذَلِكَ إِلّا صِبغَةٌ جُعِلَت","طَبعاً وَإِن قيلَ شابَ الرَأسُ لِلذُعُرِ",11,"ر",1,0],["وَلَيْسَ ذَنْبُكَ أَنَّ المَوْتَ مِنْ قِدَمٍ","يُعَاجِلُ النُّخُبَ الأَخْيَارَ وَالنُّجُبَا",12,"ب",2,0],["وليس ذاكَ لآبائي ومجدِهِمُ","ولكن لأنّي اتخذتُ العَدْلَ ميزانا",13,"ن",2,0],["وليس ذو الرقص عدلا في شهادته","إذ لا مروة للرقاص في العصب",14,"ب",1,0],["وَلَيسَ ذاكَ عَلى مالٍ نَعِمتُ بِهِ","حِيناً وَأَفناهُ صَرفُ الأَزلَمِ الجَذِعِ",15,"ع",1,0],["وليس ذا كله عجيبا","فيها بلِ الأَعجبُ الرخام",16,"م",1,0],["وَلَيسَ ذَنبي غَير أَنّي فَتىً","أَحبَبتُ فيها حُسنها اليوسفي",17,"ف",2,0],["وليس ذا يا ذا النهى طريقنا","وليس من يفعل ذا رفيقنا",18,"ن",2,0],["وَلَيسَ ذَنبي سِوى طولِ الثَّواءِ وَمَن","طالَ الثَّواءُ عَلَيهِ رِيعَ بِالمَلَلِ",19,"ل",1,0],["وَلَيسَ ذَوو الأَضغانِ في كُلِّ كُربَةٍ","يَطيعونَ إِبرامي الأُمورَ وَلا نَقضي",20,"ض",2,0],["وليس ذاك النِّظامُ مُنقطِعاً","وأنت للمُلْكِ من بقاياه",21,"ا",2,0],["وَلَيسَ ذا مُستَحسَناً في العَقلِ","اِن لَم يَكُن يَسلُك نَهجَ الجَهلِ",22,"ل",1,0],["ولَيس ذاك لشيءٍ غيرَ أنّهُمُ","بالطبعِ لاَ تنفُقُ الآدابُ عندهُمُ",23,"م",1,0],["وَلَيْسَ ذنبِيَ عندَ العاذِلينَ سِوى","أَنِّي أُرى فِي رِضاهُ ثانيَ اثْنَيْنِ",24,"ن",1,0],["وليس ذا لغنى بي عن ندى ملك","أغنى الملوك إلى نعماه مفتقر",25,"ر",1,0],["وَلَيْسَ ذَا عَنْ هَوىً مِنّي لِجِبْلَةَ بَلْ","رَأَيْتُ جِبْلَةَ أَدْناها إلَى وَطَنِي",26,"ي",1,0],["وليس ذلك منا","جهلاً ولا كان سهوا",27,"و",2,0],["وليس ذو الحجى للوَ","شَلِ النزرِ بممتَصِّ",28,"ص",1,0],["وَلَيْسَ ذا بِالْفِعْلِ شَرْطاً فِيْهِ","بَلِ التَّهَيُّؤُ عِنْدَنا يَكْفِيْهِ",29,"ه",1,0],["وليس ذاك بالذي يضاع","فمثله في السوق لا يباع",30,"ع",1,0],["وَلَيسَ ذاكَ مِنهُم بِظلم","لأَنَّهُم يَأتونه عَن علم",31,"م",1,0],["وَلَيسَ ذا مِن عادة الكِرام","الغَدر بَعدَ الود وَالطعام",32,"م",1,0],["وليس ذا عشك فلتدرجي","وأين عش السرِّ من عشي",33,"ش",2,0],["وليس ذاك الشخيصُ منهم","وهو الذي لم يخب سؤاله",34,"ل",2,0],["وليس ذلك منقص","أمراً لهم لكمالها",35,"ل",3,0],["وَلَيسَ ذا بِعَجيب فيهما أَبَدا","فَالشبل تَبع في آدابه الأَسَدا",36,"د",2,0],["وليس ذا مرادهم لأنهم","فاتوك في منابر الصعود",37,"د",1,0],["وَلَيسَ ذا في كُلِّ أَيّامِهِ","لكِنَّهُ في الدَعوَةِ المُنكَرَه",38,"ر",2,0],["وَلَيسَ ذا قَولُ جَدٍّ","لَكِنَّهُ قَولُ هَزلِ",39,"ل",1,1],["وليس ذَلِكَ عارٌ في كُناس ظِبَى","ما دمتَ ذا عزة في غابة الأَسَد",40,"د",1,0],["وليس ذا حد ولا انتهاء","فهو فوق الفوق ذو اعتلاء",41,"ا",2,0],["وَلَيسَ ذاتُ العِمادِ إِلّا","مَغنى حِماها إِن كُنتَ خابِر",42,"ر",1,0],["وَلَيْسَ ذَاك كَذَاكَ مَنْ يَعِفَّ يَصِلْ","لَهُ فَجَرِّبْ وَلاَ تَعٌدْ إِلَى حَوَلِ",43,"ل",1,0],["وَلَيسَ ذا مُخَالِفاً مَا قَبلَه","إذ هِىَ قَصدٌ وَسِوَاهَا وَصلَه",44,"ه",1,0],["وليس ذا يوما وبعض يوم","بل زاد فوق الامد الممتد",45,"د",1,0],["وَلَيسَ ذلِكَ يَأتي مِن ذَوي ثِقَة","مِن همهم كَرم الأَخلاقِ وَالشَرَف",46,"ف",1,0],["وليس ذاك العذار شعراً","لكنما سرّه غريب",47,"ب",1,0],["وَلَيْسَ ذَا علم بِشَيْء وَلَا","لَهُ إِذا حصلت محصول",48,"ل",1,0],["وليس ذلك من حذق الصناعة بل","من حرفةٍ في فؤادي أبدعت عملا",49,"ل",2,0],["وليس ذا الأماني إن ذاك إلى","رب العباد لمن قد حاز إيمانا",50,"ن",2,0],["وليس ذلك في الأصل الذي خلقت","له الخليفة من توحيد مولانا",50,"ن",2,0]]}