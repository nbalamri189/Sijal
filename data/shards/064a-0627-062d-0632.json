{"poems":[[79,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[91,"كذب الرجاء فما نجيب يرجع","https://www.aldiwan.net/poem44935.html","الكامل"],[101,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[50,"يا قمرا في السماء مسكنه","https://www.aldiwan.net/poem66125.html","المنسرح"],[102,"الآتون .. من الأزمة","https://www.poetsgate.com/ViewPoem.aspx?id=50340",""],[101,"إفادة في محكمة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=581",""],[382,"عيني لتلك الناحيه","https://www.aldiwan.net/poem59167.html","مجزوء الكامل"],[449,"يا حزينا يقضي الحياة كئيبا","https://www.aldiwan.net/poem55976.html","عموديه"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202078",""],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112831","المديد"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99061","الرجز"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100832","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52982","البسيط"],[3531,"","https://poetry.dctabudhabi.ae/diwan/poem/145726","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108259","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33634","الخفيف"],[4755,"كُلُّ عامٍ وعِيدُكَ العَامُ كُلُّهْ","https://www.poetsgate.com/ViewPoem.aspx?id=183568",""],[4755,"رُوحِي ببَعضِ الصَّمتِ طَمَّاعَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=184078",""],[4755,"لا شَأنَ لِي","https://www.poetsgate.com/ViewPoem.aspx?id=204158",""],[4768,"الحزن ظلي","https://www.poetsgate.com/ViewPoem.aspx?id=215618",""],[4797,"الحب مثل النوم","https://www.poetsgate.com/ViewPoem.aspx?id=29437",""],[4858,"سلام الضعفاء","https://www.poetsgate.com/ViewPoem.aspx?id=34883",""],[4888,"غروب في ظلِّ الغُربةِ","https://www.poetsgate.com/ViewPoem.aspx?id=207740",""],[5101,"أخشى عليك الفقر","https://www.poetsgate.com/ViewPoem.aspx?id=206426",""],[5187,"وجيه في التسعين","https://www.poetsgate.com/ViewPoem.aspx?id=29067",""],[5351,"مكر","https://www.poetsgate.com/ViewPoem.aspx?id=202028",""],[5355,"ملح العيون","https://www.poetsgate.com/ViewPoem.aspx?id=190552",""],[5411,"وجَعُ الشِّعْر","https://www.poetsgate.com/ViewPoem.aspx?id=185383",""],[5431,"هل يرضى العالم","https://www.poetsgate.com/ViewPoem.aspx?id=183050",""],[5431,"في الروح لقياه...","https://www.poetsgate.com/ViewPoem.aspx?id=188220",""],[5431,"ولكَم يُظلم النبيل الأصيلُ...","https://www.poetsgate.com/ViewPoem.aspx?id=196635",""],[5533,"دُوْمَا في القَلْب","https://www.poetsgate.com/ViewPoem.aspx?id=176715",""],[5573,"ياهجسُ مالكَ لاتميلُ لراحتي","https://www.poetsgate.com/ViewPoem.aspx?id=213731",""],[5736,"ليل","https://www.poetsgate.com/ViewPoem.aspx?id=204467",""],[5943,"ياحزن قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=34654",""],[5957,"في ذكرى الجواهري","https://www.poetsgate.com/ViewPoem.aspx?id=177637",""],[6314,"بكائية الليل الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88067&r=&rc=2",""],[6346,"يحنو الهجير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83390&r=&rc=6",""]],"verses":[["يا حِزْبَ اللّهِ وناصِرَهُ","بالحقِّ ومُدْرِكَ ما سَحَقا",0,"ق",2,0],["يا حزن نب يا قلب ذب يا طرف صب","خاب الذي كنا له نتوقع",1,"ع",1,0],["يا حزيران.ما الذي فعل الشعر؟","وما الذي أعطى لنا الشعراء؟",2,"ا",2,0],["يا حزيران.. أنت أكبر من","وأبٌ أنت ما له أبناء",2,"ا",2,0],["يا حِزمَةَ الباذَنوسِ بِالمِسكِ وَال","عَنبَرِ في نَكهَةِ الرَساطونِ",3,"ن",1,0],["يا حزانى يا جميع الطيبين","هذه الأخبار من دار اليقين",4,"ن",1,1],["يا حزيران ما الذي فعل الشعر","وماذا أعطى لنا الشعراء",5,"ا",2,0],["يا حزيران أنت أكبر منا","وأب أنت ماله أبناء",5,"ا",2,0],["يا حزن قلبي من أبي","ك رُمي بتلك الداهيه",6,"ي",2,0],["يا حزينا يقضي الحياة كئيبا","وعليلا أعيا شفاه الطبيبا",7,"ب",2,1],["يا حُزْنَ قَلْبي إذ خَلا","وَطَناً وَعنْ أهْلٍ تَخَلَّى",8,"ل",2,0],["يا حزيت القلب للنقم","وكثير الضر والسقم",9,"م",1,1],["يا حزناً إذ ضمّك الخراب","وأغلقت من دونك الأبواب",10,"ب",1,0],["يا حزب تركيا الفتاة تحية","من شاعر يزجي الثناء قصيدا",11,"د",2,0],["يا حزْبنَا قمْ بنا نسودُ","فنحن في حرْبنا أُسودُ",12,"د",1,1],["ياحزينة الطمي الطمي","قد ولي ابن المرخم",13,"م",1,1],["يا حزن مالك قد أسلت دموعِي","أسفاً وهجت النار بين ضلوعِي",14,"ع",2,1],["يا حَزيناً بكَى لغيرِ حزين","كف بينَ الكَرى وبينَ الجفونِ",15,"ن",1,1],["يا حَزينًا مُفارِقًا لَيسَ يُجدِي","أَكثَرُ الشَّوقِ عِندَهُ أَو أَقَلُّهْ",16,"ل",2,0],["يا حُزنَ أَجدَادِي وحُزنِي على","أَرضٍ خُطَاها اليَومَ مُنصاعَةُ",17,"ع",2,0],["يا حُزنُ.. خُذ ما شِئتَ مِن وَجَعِي الذي","أَبقَيتَهُ، ورَحَلتَ بِالمَجنُونِ",18,"ن",1,0],["ياحزنُ إنّي قاتلٌ فرحي","وأنا القتيلُ وأنتَ مُشتَبهُ",19,"ب",2,0],["ياحزن كبدي حزن من ضاق ثم حام","اخذت فروخه مادرى ليه ولوين؟",20,"ن",1,0],["يا حْزيُكْم أيكونُ السلْمُ مطلبكم","والقدْسُ مسرى رسولِ اللّه تقتضب ؟",21,"ب",1,0],["يا حُزنُ مالكَ قد أَقمتَ بموطني","تَقْتاتُ من أمَلي أشرَّ قيامِ؟",22,"م",1,0],["يا حزنُ أخشى عليكَ الفَقْرَ حين أنا","(لم يبق عندي ما يَبتَزُّهُ الألمُ)",23,"م",1,0],["يا حزنَ مربدنا وسوقِ عكاظنا","لم يبقَ إلا تافهٌ ومثرثرُ",24,"ر",1,0],["يا حزن لو أني دهست ُ محبتي","ماصرتُ أخشى سيفك المسلولا",25,"ل",2,0],["يا حزنُ إنَّ جِرَاحِيْ لَاْ حُدُودَ لهَا","فَمِنْ جرَاحِيَ جَفّ الْقَلْبُ وانْكَسَرَا",26,"ر",2,1],["يا حُزْن كَمْ مِنْ مَرَّةٍ كُنَّا معا","وَالمُرُّ حَنْظَلَ مُرَّهُ بِشَبابي",27,"ب",2,0],["ياحزنا بت أعايشه","برميل الموت كما العدمِ",28,"م",1,0],["ياحزن فرحتنا يافرح دمعتنا","ياكلّ سكرتنا ماسحتُ لولاه",29,"ل",3,0],["ياحزينا فداك قلبي دموعا","ولكَم يُظلم النبيل الأصيلُ",30,"ل",1,0],["يا حُزْنَاً في القَلْبِ مَدَاهُ","يَتَردَّدُ في النَّفْسِ صَدَاهُ",31,"ا",2,1],["ياحزةِ الثلبوتِ جئتُك عابرٌ","في مقلتيَ تحطُمِ ورفاتِ",32,"ت",1,0],["يا حزنَ قافيةٍ نامتْ على وجعٍ","متى ستنبضُ اشعاري على الورقِ",33,"ق",1,0],["ياحزنَ قلبي على مجدٍ أعزِّيهِ","بعد السُّموِّ هوى للقاعِ عاليهِ",34,"ي",2,1],["يا حزن بغداد لفقدِ محمد ٍ","وهو الذي في الأفق نجمٌ حاضرُ",35,"ر",1,1],["يا حزن يعقوب والأبواب موصدةٌ","على الضرير يعبُّ الدمع والكَمَدَا",36,"د",2,0],["يَا حُزْنُ وَيْحَكَ كَمْ فَتَكْتَ بِحَالِمٍ","ظَنَّ الحَيَاةَ سَعَادةً لاتُنْزَعُ",37,"ع",1,0]]}