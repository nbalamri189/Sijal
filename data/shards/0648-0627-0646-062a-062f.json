{"poems":[[37,"فلولا الله ثم ندى ابن ليلى","https://www.aldiwan.net/poem39178.html","الوافر"],[95,"وقفت على القبر الذي أنت نازله","https://www.aldiwan.net/poem11122.html","الطويل"],[32,"ألا أيهذا المنزل الدارس اسلم","https://www.aldiwan.net/poem29526.html","الطويل"],[90,"أرى الأتراك في دار الخلافه","https://www.aldiwan.net/poem44827.html","الوافر"],[31,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[72,"السمر لا البيض هم","https://www.aldiwan.net/poem42786.html","مجزوء الرجز"],[87,"يحكون أن أمة الأرانب","https://www.aldiwan.net/poem8038.html","الرجز"],[87,"لما دعا داعي أبي الأشبال","https://www.aldiwan.net/poem8042.html","الرجز"],[75,"","https://poetry.dctabudhabi.ae/diwan/poem/7561","الطويل"],[119,"إليك ربكان أرباب الفحول سعت","https://www.aldiwan.net/poem42179.html","البسيط"],[136,"هويت فقالوا لي تسل أو ارعو","https://www.aldiwan.net/poem54685.html","الوافر"],[189,"أرى الشر طبع نفوس الأنام","https://www.aldiwan.net/poem14667.html","المتقارب"],[234,"ما قال أوه لفقده واها","https://www.aldiwan.net/poem51256.html","المنسرح"],[264,"يا ليل طل أو لا تطل","https://www.aldiwan.net/poem35515.html","مجزوء الرجز"],[303,"إذا لم تطق (لمياء) أن تنجز الوعدا","https://www.aldiwan.net/poem36321.html","عموديه"],[447,"أما من بني حوا خليل محالم","https://www.aldiwan.net/poem14383.html","الطويل"],[458,"عزيت نفسي وما عزيتها اسفا","https://www.aldiwan.net/poem61722.html","البسيط"],[463,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[466,"تود الجحاجيح من خندف","https://www.aldiwan.net/poem15115.html","المتقارب"],[500,"ليهنك عهد لا يضاع وإن نأت","https://www.aldiwan.net/poem10235.html","الطويل"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82800","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48735","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38058","البسيط"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79459","البسيط"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132231","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118320","البسيط"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103715","المجتث"],[2684,"","https://poetry.dctabudhabi.ae/diwan/poem/131463",""],[2714,"","https://poetry.dctabudhabi.ae/diwan/poem/199884","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112660","الرجز"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71312","المنسرح"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89163","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86291","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91461","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216744","السريع"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135971","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103049","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94594","الطويل"],[4978,"حوّلتها بعد حَوْزٍ عن مسمّاها","https://www.poetsgate.com/ViewPoem.aspx?id=177252",""],[5121,"صَهٍ صَهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=33838",""],[5145,"من لبرقٍ على البراق أنارا","https://www.poetsgate.com/ViewPoem.aspx?id=108062",""],[5271,"أُريدكِ سيلا !!","https://www.poetsgate.com/ViewPoem.aspx?id=59743",""],[5277,"التوباذية","https://www.poetsgate.com/ViewPoem.aspx?id=185350",""],[5850,"طالَ الثواءُ على رسمٍ بيمؤودِ","https://www.poetsgate.com/ViewPoem.aspx?id=19703",""],[5942,"بغداد. يا لغة الدنيا وجنتها","https://www.poetsgate.com/ViewPoem.aspx?id=215593",""],[5943,"رشق الخير","https://www.poetsgate.com/ViewPoem.aspx?id=61823",""],[5957,"الزمن الخرافي","https://www.poetsgate.com/ViewPoem.aspx?id=207667",""]],"verses":[["وَأَنتَ دَعامَةٌ مِن عَبدِ شَمسٍ","إِذا اِنتُجِبوا مِن السِرِّ اللُبابِ",0,"ب",1,0],["وَإِنْ تَدْنُ نَارُ الحِقْدِ مِنْهُ تَضَوَّعَتْ","مَنَاقِبُه طِيباً بِهَا وَفَوَاصِلُهْ",1,"ل",2,0],["وَإِن تَدعُ قَيسا قَيسَ عَيلانَ يأتِها","بَنو الحَربِ يُستَعلى بِهِم كُلُّ مُعظَمِ",2,"م",1,0],["وإن تدابُر الأقوام شيءٌ","يؤول إلى الندامة والأسافه",3,"ف",2,0],["وَإِن تَدَجَّت عَلى الآفاقِ مُظلِمَةٌ","كانَ لَهُم مَخرَجٌ مِنها وَمُعتَصَرُ",4,"ر",1,0],["وَإِن تَدَبَّرتَ مَقا","لي مُنصِفاً قُلتُ صَدَق",5,"ق",1,0],["وَاِنتَدَبَ الثالِثُ لِلكَلامِ","فَقالَ يا مَعاشِرَ الأَقوامِ",6,"م",1,0],["وَاِنتُدِبَ الثَعلَبُ لِلتَأبين","فَقالَ في التَعريضِ بِالمِسكين",7,"ن",1,0],["وَإِن تَدعُنا لِلأُنسِ عَن أَريَحِيَّةٍ","فَقَد يَأنَسُ المَولى إِذا اِرتاحَ بِالعَبدِ",8,"د",1,0],["وأنت دائرة العلم المقدس وال","أذن التي كل أسرار الكتاب وعت",9,"ت",1,0],["وَإن تُدعَ لِلجُلَّى انزَوَيتَ مُحَاذِراً","وَتَنقَادُ لِلعَورَاءِ وَمَدحُكَ مُنطُوِ",10,"و",1,0],["وإنْ تُدْعَ للخير فانهضْ وهُمَّ","وإنْ تدع للشرِّ قلْ لا هَمام",11,"م",1,0],["وإن تَدِب الخُطوبُ جامحةً","لَقِيتُها لا أخاف عُقْباها",12,"ا",3,0],["وإن تدم طول المدى","لا بدَّ لي أن أسهركْ",13,"ك",1,0],["وَأن تدرجاني قبل لحدي بدرعها","عساها تُبكِّي حال من قتلت عمدا",14,"د",2,0],["وإن تده بالجلى من الأمر فاستشر","فتى في جميع المستشارات حالم",15,"م",1,0],["وان تَدليَّتُ من لؤمٍ ومن جشع","فليس يرفعني بأسِى وإيماضيِ",16,"ض",2,0],["وإِن تدبَّرتِ بعد بحبُوحَة ال","عزّ محلّاً من الأذى أَمَمَا",17,"م",2,0],["وإن تَدْعُني لمقالٍ الرجالِ","فَقُسُّ البلادِ وسُحْبانُها",18,"ن",3,0],["وإن تُدِل الأيام لي من يد النوى","بثثتك أمراً دونه أتقطعُ",19,"ع",1,0],["وَأَنتَ دَواء الجسم قَد خيل داءه","تَميط الأَذى عَن موجع وَسَقيم",20,"م",1,0],["وإن تدفق في البيداء منصرفاً","وإن أقام وراء السد مخزونا",21,"ن",2,0],["وَأَنتَ دَوحَةُ إِحسانٍ إِذا عطَفت","تَهتَزُّ ناثِرَةً لِلرّفق وَاللّينِ",22,"ن",1,0],["وإن تداولتِ الأسحارُ سؤددهُ","صلَّى عليهِ لسان الشعرِ في السَّمَرِ",23,"ر",1,0],["وأن تدعو الإله أزلت خوفي","من أهوال العقاب وكل مابي",24,"ب",2,0],["وان تدم هكذا منهم مراقبة","كل تعود ها مغرى بعادته",25,"ت",2,0],["وأنت دوني سورٌ","من العلا والرجاحه",26,"ح",2,0],["وأنت داري بأني قليل الاصطبار","ليس لي صبر أيوب والياس",27,"س",1,0],["وإن تدعه الأنصار مولى أسمهم","بقافية تستكره الجلد بالدم",28,"م",1,0],["وانتدَبوا منهُم رِجالاً عَشرة","بالخيلِ داسوا صَدرَهُ وظَهرَه",29,"ه",1,1],["وَإِنْ تَدَانَيْتَ مِنْ سُرَادِقِهِمْ","فَاسْجُدْ لِعزِّ الجَمَالِ وَاقْتَرِبِ",30,"ب",1,0],["وإن تدَّعي طباً فلا طبتَ مدَّعٍ","تعالج ضرَّ الناس إذ أنت في الضر",31,"ر",1,0],["وَاِنتَدِب لِلعِلمِ مِن عَهد الصِبا","عَنهُ بَينَ الخَلقِ لا تَطلُب بَدَل",32,"ل",1,0],["وَإِن تَداخل في كُنه الضَمير هَوىً","فَاعلم بِأَن النُهى وَالرشد قَد خرجا",33,"ج",2,0],["وأنت دان نافر راحم","قاس محب كاره لا تدوم",34,"م",1,0],["وأنت دائمٌ بلا زوالِ","فالطُفْ بنا ربِّ بكلِّ حالِ",35,"ل",1,0],["وانتدبناك باللقاء لداء","طالما عاده الطبيب فملّا",36,"ل",2,0],["وانتدبوها للقرى احتفالا","فوقفت في عتبات الصخر",37,"ر",1,0],["وإن تدَّعي فخراً لغير منازلٍ","لك اللَه هل للفار فخرٌ بنسبةِ",38,"ه",1,0],["وأن تدلل من ذاتِ طفولتها","أظل دونك من بالقلب يهواها",39,"ا",3,0],["وَإِنْ تَدَّعِ السِّلْمَ مَهْلاً فَمَهْلاً","وَأَيْنَ الْوِقَارُ بِحَرْبٍ عَوَانِ",40,"ن",1,0],["وانتدب من حجاب عزّك وأشهر","سيف قهرٍ على العدى بتّارا",41,"ر",2,0],["وأنتِ دمائي وأنتِ انتمائي","وأنتِ مدادٌ لكل المحابرْ",42,"ر",1,0],["وأنت دائي وقد أدمنتُ شقوتَه","أضحى الدواء لقاء النازح العاني",43,"ن",2,0],["وإنْ تدافعكَ سماكٌ بحجتها","وقنفذٌ تعتزلها غيرَ محمودِ",44,"د",1,0],["وأنتَ دكتورُنا الهادي وقد رسمَت","كفّاك عينينِ في بحرٍ من السفنِ",45,"ن",1,0],["وأنْ تدومَ لنا بالخيرِ ترشقنا","رشقَ المضيِءِ لمن دنياهمُ عبروا",46,"ر",3,0],["وإن تدنو سينبت فوق ثغري","غناء الوجد يطرب في ضفافي",47,"ف",2,0]]}