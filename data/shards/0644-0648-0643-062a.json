{"poems":[[398,"لاح لعينيك الطلل","https://www.aldiwan.net/poem53681.html","مجزوء الرجز"],[463,"لا تلمس الشمس يد","https://www.aldiwan.net/poem56236.html","مجزوء الرجز"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49581","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104975","الرجز"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146355","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120493","الكامل"],[4691,"شاعر يكتب على الكيبورد","https://www.poetsgate.com/ViewPoem.aspx?id=215321",""],[5055,"حرف شعري","https://www.poetsgate.com/ViewPoem.aspx?id=103544",""],[5055,"بتول","https://www.poetsgate.com/ViewPoem.aspx?id=106077",""],[5608,"حرب","https://www.poetsgate.com/ViewPoem.aspx?id=33394",""],[5691,"جوهر الفكر","https://www.poetsgate.com/ViewPoem.aspx?id=206131",""],[5739,"راسبه والاّ ناجحه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=126872",""],[5794,"ليست سامرية","https://www.poetsgate.com/ViewPoem.aspx?id=122802",""]],"verses":[["لَو كُتِبَت في مُقَل ال","حورِ لَكانَ يُستَقَل",0,"ل",1,0],["لو كُتِمتْ تطلَّعتْ","من حسن حالي تَشهْدُ",1,"د",1,0],["لو كَتَبُوا أحْسَابَهُمْ أحْرُفاً","أغْنَتْكَ عن نَفْطٍ وعن شَكْل",2,"ل",1,0],["لو كتبت مديحهم ايدي الورى","أعوزت الأقلام عنه والورق",3,"ق",1,0],["لو كتبنا إِليه عُونَ المعاني","أصبحت في مديحه أَبكارا",4,"ر",2,0],["لو كتبت جدوى يديه عسكرا","يغزو لعمرك لم يطقه عسكر",5,"ر",1,0],["لو كتبنا على الهواء فإنا","شعراءٌ أرواحنا في صعود ِ",6,"د",1,0],["لو كتبنا القصايد ما نزيد الفحول","وش تزيد القصايد يوم غاب الحنين",7,"ن",1,0],["لو كتبا القصايد ما نزيد الفحول","وش تفيد القصايد يوم غاب الحنين",8,"ن",1,0],["لوّك تعرف السيل مضبوط ولّيت","ولا تفكر تعلن ابداً تحدّي",9,"د",2,0],["لوْ كتَبْتُ الغَثَّ المُهَلْهَلَ يوْماً","لأتاني المَديحُ بالأصْواعِ",10,"ع",1,0],["لو كتاب الحب قلبي يفتحه.","كل سطر ٍ فيه عبّر عن جفاك.",11,"ك",1,1],["لو كتبت الشوق مره قول من زود الحنين","لو كتبت الحب مره أسف إن كانت خطيه",12,"ي",2,0]]}