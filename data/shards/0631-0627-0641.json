{"poems":[[93,"رأفة بها الدعاة الكرام","https://www.aldiwan.net/poem11369.html","الخفيف"],[72,"ما لمن لام فيكمو من جواب","https://www.aldiwan.net/poem18239.html","الخفيف"],[72,"إلى م العشق واللائمة","https://www.aldiwan.net/poem19678.html","السريع"],[51,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[51,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[51,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[70,"هات يا صاح غنني","https://www.aldiwan.net/poem42432.html","مجزوء الخفيف"],[89,"افتحوا للفتى الهضيم الطريقا","https://www.aldiwan.net/poem44844.html","الخفيف"],[89,"قد جاء يا أم وقت فوتي","https://www.aldiwan.net/poem44940.html","مخلع البسيط"],[85,"رضي المسلمون والإسلام","https://www.aldiwan.net/poem63740.html","الخفيف"],[66,"يا بدورا تغيب تحت التراب","https://www.aldiwan.net/poem40292.html","الخفيف"],[80,"كل يوم مودع أو مودع","https://www.aldiwan.net/poem31388.html","الخفيف"],[44,"أنا في ذمة الكريم سليما","https://www.aldiwan.net/poem30361.html","الخفيف"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85378","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54285","الخفيف"],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[183,"لله يومي بالثغر في الجوسق","https://www.aldiwan.net/poem14609.html","المنسرح"],[219,"صمدت للعظات هذي الطلول","https://www.aldiwan.net/poem55287.html","الطويل"],[366,"لمن الظعن بالضحى طافيات","https://www.aldiwan.net/poem1882.html","الخفيف"],[369,"سر مع الوجد والأسى في طريق","https://www.aldiwan.net/poem57258.html","الخفيف"],[413,"ما لها مفرية بيدا فبيدا","https://www.aldiwan.net/poem53936.html","الرمل"],[456,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[456,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[477,"قل معي يا ولدي","https://www.aldiwan.net/poem36926.html","مجزوء الرمل"],[477,"صنت الفؤاد عن الهوى","https://www.aldiwan.net/poem37013.html","مجزوء الكامل"],[477,"عارف ما الشعر صاغيه","https://www.aldiwan.net/poem37208.html","مجزوء الرمل"],[498,"رقمت في معارفي الأشياء","https://www.aldiwan.net/poem38098.html","الخفيف"],[536,"مقدم القائد الأعز نظيرا","https://www.aldiwan.net/poem48180.html","عموديه"]],"verses":[["رَأْفَةً بُّهَا الدُّعَاةُ الكِرَامُ","فَلَّ حَدِّي وَقَدْ يَفَلُّ الحُسَامُ",0,"م",1,1],["رافعاً بالتواضع الحجب عنه","وهوَ من نورِ غرّة في حجاب",1,"ب",1,0],["رافعة في ظلِّهم بيتها","بكسرِ أعدائهم جازمهْ",2,"م",2,0],["رافعٌ طرْفه إلى حسناتِ ال","جُودِ عن سَيِّئاتِهِ مُتغاضي",3,"ض",2,0],["رَافِعُو طرفِهِمْ إلى حَسَنِ المجْ","دِ وعمّا يسُوءُ منه مُغاضي",3,"ض",2,0],["رافدتْها إشارةٌ ألبستْها","كلَّ نُور وكل رقراقِ آلِ",4,"ل",1,0],["رافعاتِ الأقْدام بالليل يدعو","ن على المحصِنين بالتأثيم",5,"م",1,0],["رافِعَ السَتَر بَينَنا","لا تُفَكِّر بِأَنَّني",6,"ي",1,0],["رافعا راية التمرد تهفو","حاملا من يراعه منجنيقا",7,"ق",2,0],["رافعة طرفها الكليلا","بصورة تجلب البكاء",8,"ا",2,0],["رافِعَ الضادِ لِلسُها هَل قَبولٌ","فَيُباهي النُجومَ هَذا النِظامُ",9,"م",1,0],["رافِعُ النارِ بِالبِقاعِ إِذا أَخ","مَدَ بَردُ الشِتاءِ صَوتَ الكِلابِ",10,"ب",1,0],["رافِعٍ في الهواءِ طُولى عليها","عنقٌ كاللّواءِ في الجيش يُرْفَع",11,"ع",1,0],["رافِعاً كَفَّهُ لِبِرّي فَلا أَح","سِبُهُ جاءَني لِغَيرِ اللِطامِ",12,"م",1,0],["رافعاً رأسَه وفي ذلك الرف","ع إلى كل سُؤْدُدٍ إيماءُ",13,"ا",2,0],["رافقتها اثنتان من راهبات ال","دير حفظاً لشخصها أَن يضارا",14,"ر",2,0],["رَافِعٌ رَأْسَهُ يَشُقُّ بِهِ السُّحْبَ","فَتَمْضِي في رَهْبَةٍ وَحَيَاءِ",15,"ا",2,0],["رافعاتُ الرءوسِ شُكْراً ، وأُخرى","ساجداتٌ شُكْراً على الأعتاب",16,"ب",1,0],["رافَقني وهْو لا يفارِقني","إلى الرَّدَى وهو منه لي أوفَق",17,"ق",1,0],["رافعات رؤوسها ولكم دقت","على هذه الرؤوس طبول",18,"ل",1,0],["رافعاتٍ رَقْماً تُهالُ لَهُ العَيْ","نُ على كلِّ بازِلٍ مُسْتَكِينِ",19,"ن",1,0],["رافِقِ الفِكرَ في طَريقِ الأَماني","فَإِذا صَحَّ فَهوَ خَيرُ طَريقِ",20,"ق",1,0],["رافعٌ راية أعلام الهُدى","عاقدٌ للدِّين بالعزِّ بنودا",21,"د",2,0],["رافعةً ما انحطّ من أعناقها","جامعةً ما شذَّ من فِصالها",22,"ل",3,0],["رافعةً واضعةً أعناقَها","يوماً ويوماً مغرِباً ومشرِقا",23,"ق",2,0],["رافعين راية","للهلال باليد",24,"د",1,0],["رافقته منذ الصبى","وحفظت فيه وداده",25,"د",2,0],["رافع من شأنها لغة","خصها بالذكر باريه",26,"ي",2,0],["رافِقِ الصَّالحينَ واغنَمْ هُداهُمْ","فلنعْمَ الخُلاَّنُ والرُّفَقاءُ",27,"ا",2,0],["رافعاً للِمولى أكُفَّ ابتهالٍ","أن ترَى في الأحفادِ عَداًّ وَفيرا",28,"ر",2,0]]}