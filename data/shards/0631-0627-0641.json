://www.poetsgate.com/ViewPoem.aspx?id=16048",""],[5064,"أستجدِي الرَّحِيلا","https://www.poetsgate.com/ViewPoem.aspx?id=199089",""],[5122,"نصيحة في عجالة","https://www.poetsgate.com/ViewPoem.aspx?id=31515",""],[5127,"العامل","https://www.poetsgate.com/ViewPoem.aspx?id=177317",""],[5277,"عبقٌ من الذاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=187964",""],[5324,"حكاية صوت.","https://www.poetsgate.com/ViewPoem.aspx?id=215113",""],[5370,"لا وداعية","https://www.poetsgate.com/ViewPoem.aspx?id=85932",""],[5409,"خرج الناس يضرعون إلى الله","https://www.poetsgate.com/ViewPoem.aspx?id=155246",""],[5431,"سادن الحب","https://www.poetsgate.com/ViewPoem.aspx?id=209045",""],[5431,"قلتُ كلا ...","https://www.poetsgate.com/ViewPoem.aspx?id=210687",""],[5431,"عليّ كرم الله وجهه....","https://www.poetsgate.com/ViewPoem.aspx?id=212969",""],[5596,"إلى ابن مكتوم","https://www.poetsgate.com/ViewPoem.aspx?id=206174",""],[5596,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=206694",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5688,"زدني من الحبر","https://www.poetsgate.com/ViewPoem.aspx?id=200692",""],[5689,"حطمت لي يد القضا كل فلس","https://www.poetsgate.com/ViewPoem.aspx?id=143434",""],[5704,"تطريز لكلمة \" إغتراب\"","https://www.poetsgate.com/ViewPoem.aspx?id=202960",""],[5732,"يامرجع ليعقوب غاليه","https://www.poetsgate.com/ViewPoem.aspx?id=177866",""],[5861,"اختر صديقك","https://www.poetsgate.com/ViewPoem.aspx?id=188693",""],[5956,"ارحميني","https://www.poetsgate.com/ViewPoem.aspx?id=182191",""],[5956,"إلى خادمي الله أحفادي الأكارم وأمهاتهم","https://www.poetsgate.com/ViewPoem.aspx?id=193148",""],[5956,"نمّيتَ حاسة استمتاعي بالحياة بعد اهتمامك","https://www.poetsgate.com/ViewPoem.aspx?id=194642",""],[4442,"فقه الشريعة أول","https://www.poetsgate.com/ViewPoem.aspx?id=171209",""],[6115,"الفاهم العاقل ضميره خصيمه","https://www.poetsgate.com/ViewPoem.aspx?id=181518",""],[6213,"شجون عاتية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85497&r=&rc=100",""]],"verses":[["رَأْفَةً بُّهَا الدُّعَاةُ الكِرَامُ","فَلَّ حَدِّي وَقَدْ يَفَلُّ الحُسَامُ",0,"م",1,1],["رافعاً بالتواضع الحجب عنه","وهوَ من نورِ غرّة في حجاب",1,"ب",1,0],["رافعة في ظلِّهم بيتها","بكسرِ أعدائهم جازمهْ",2,"م",2,0],["رافعٌ طرْفه إلى حسناتِ ال","جُودِ عن سَيِّئاتِهِ مُتغاضي",3,"ض",2,0],["رَافِعُو طرفِهِمْ إلى حَسَنِ المجْ","دِ وعمّا يسُوءُ منه مُغاضي",3,"ض",2,0],["رافدتْها إشارةٌ ألبستْها","كلَّ نُور وكل رقراقِ آلِ",4,"ل",1,0],["رافعاتِ الأقْدام بالليل يدعو","ن على المحصِنين بالتأثيم",5,"م",1,0],["رافِعَ السَتَر بَينَنا","لا تُفَكِّر بِأَنَّني",6,"ن",2,0],["رافعا راية التمرد تهفو","حاملا من يراعه منجنيقا",7,"ق",2,0],["رافعة طرفها الكليلا","بصورة تجلب البكاء",8,"ا",2,0],["رافِعَ الضادِ لِلسُها هَل قَبولٌ","فَيُباهي النُجومَ هَذا النِظامُ",9,"م",1,0],["رافِعُ النارِ بِالبِقاعِ إِذا أَخ","مَدَ بَردُ الشِتاءِ صَوتَ الكِلابِ",10,"ب",1,0],["رافِعٍ في الهواءِ طُولى عليها","عنقٌ كاللّواءِ في الجيش يُرْفَع",11,"ع",1,0],["رافِعاً كَفَّهُ لِبِرّي فَلا أَح","سِبُهُ جاءَني لِغَيرِ اللِطامِ",12,"م",1,0],["رافعاً رأسَه وفي ذلك الرف","ع إلى كل سُؤْدُدٍ إيماءُ",13,"ا",2,0],["رافقتها اثنتان من راهبات ال","دير حفظاً لشخصها أَن يضارا",14,"ر",2,0],["رَافِعٌ رَأْسَهُ يَشُقُّ بِهِ السُّحْبَ","فَتَمْضِي في رَهْبَةٍ وَحَيَاءِ",15,"ا",2,0],["رافعاً ألوية العلم إلى","أن دنا كيوان عنها وزحل",16,"ل",1,0],["رافضا كالشعب أن يدميني","(أخزم) ثان جديد ( الشّنشنه)",17,"ن",2,0],["رافعاتُ الرءوسِ شُكْراً ، وأُخرى","ساجداتٌ شُكْراً على الأعتاب",18,"ب",1,0],["رافقتها من أربعين تصونها","وتردّ عنها النازلات وتشفق",19,"ق",1,0],["رافَقني وهْو لا يفارِقني","إلى الرَّدَى وهو منه لي أوفَق",20,"ق",1,0],["رافعات رؤوسها ولكم دقت","على هذه الرؤوس طبول",21,"ل",1,0],["رافعاتٍ رَقْماً تُهالُ لَهُ العَيْ","نُ على كلِّ بازِلٍ مُسْتَكِينِ",22,"ن",1,0],["رافِقِ الفِكرَ في طَريقِ الأَماني","فَإِذا صَحَّ فَهوَ خَيرُ طَريقِ",23,"ق",1,0],["رافعٌ راية أعلام الهُدى","عاقدٌ للدِّين بالعزِّ بنودا",24,"د",2,0],["رافعةً ما انحطّ من أعناقها","جامعةً ما شذَّ من فِصالها",25,"ل",3,0],["رافعةً واضعةً أعناقَها","يوماً ويوماً مغرِباً ومشرِقا",26,"ق",2,0],["رافعين راية","للهلال باليد",27,"د",1,0],["رافقته منذ الصبى","وحفظت فيه وداده",28,"د",2,0],["رافع من شأنها لغة","خصها بالذكر باريه",29,"ي",2,0],["رافِقِ الصَّالحينَ واغنَمْ هُداهُمْ","فلنعْمَ الخُلاَّنُ والرُّفَقاءُ",30,"ا",2,0],["رافعاً للِمولى أكُفَّ ابتهالٍ","أن ترَى في الأحفادِ عَداًّ وَفيرا",31,"ر",2,0],["رأفا فإنّ مفاتيح العناية في","يديك إذ أنت أعلى من رأى فرأف",32,"ف",1,0],["رافِعُها أكرمْ بكفِّ الذي","يَرفع والكفِّ التي تُرفعُ",33,"ع",1,0],["رافعاً كفّه بيُمنى يديه","بايحاً باسمه بصوتٍ مديدِ",34,"د",1,0],["رَأفة اللَه أَنتَ لَستَ تُهَنّا","بِالمَعالي وَقَد أَتَت منقاده",35,"د",2,0],["رافعاً ألويةَ المج","دِ إلى الشّوِ الرَّفيع",36,"ع",1,0],["رافل راقد ربيع رواء","رزم رائع رثيث فراء",37,"ا",2,0],["رافعٌ رايةً من الذَّنَبِ المش","رفِ يَسْعَى بها كسعي الظليم",38,"م",1,0],["رافل في غلائل الحسب الوضا","ح أو في مكارم الأخلاق",39,"ق",1,0],["رافعاً تحتَ ظلمة الليل للسا","رين فيه ذوائبَ النيران",40,"ن",1,0],["رافع الطرفِ نحو مَن لعُلاه","كسرت طرفَها الملوكُ خضوعا",41,"ع",2,0],["رافل أنت في برود التصابي","بعد أن جزت عنفوان الشباب",42,"ب",1,1],["رَأَفوا بِمَن هَدَروا دِماكِ فَما لَهُم","لا يَرأَفونَ بِدَمعِكِ المُتَحَدِّرِ",43,"ر",1,0],["رافقتني طفلا وذا","زمن الصبا فتخلفى",44,"ف",2,0],["رأفة الله ليس تبقى البرايا","دون راع بأمره يرعاها",45,"ا",3,0],["رأفةٌ عمتِ البرايا ولطفٌ","قدستهُ للحمدِ سبعٌ مثانِ",46,"ن",1,0],["رافعاً سمكها بغيرِ عمادٍ","جلَّ شأناً وعزَّةً خيرُ بانِ",46,"ن",1,0],["رأفة غدرانها تروي الصدى","وسطا نيرانها ذات اتقاد",47,"د",1,0],["رافِعاتي مِن غَضِّ طَرفي زُهدا","لِمَقامِ الرِضا وَأُنسِ الشُهودِ",48,"د",1,0],["رافعاً فوقَ الثريَّا علَمَا","وإذا ما لاحَ في أُفقِ السما",49,"م",2,0],["رأفةً بعدَ رحمةٍ وإنتصَارٍ","مِحنَةً بعدَ منحَةٍ وإفتقارِ",50,"ر",1,0],["رافيل والملأ المقدس أجمَع","فيكَ الوُجود ثبوته وَزَواله",51,"ه",1,0],["رافع دون بني الآ","مال أستار الحجاب",52,"ب",1,0],["رافلاً في ثياب عز مقيم","ونعيم مخلد ببقائك",53,"ك",1,0],["رافعاً للشعب أعلا","م العلى والعلم عمدا",54,"د",2,0],["رافق فريق ذوي الت