{"poems":[[10,"أعيني هلا تبكيان على صخر","https://www.aldiwan.net/poem21080.html","الطويل"],[29,"خف القطين فقلبي اليوم متبول","https://www.aldiwan.net/poem5952.html","البسيط"],[39,"إلا ثلاثا في المقامة","https://www.aldiwan.net/poem7648.html","مجزوء الكامل"],[91,"لكل طلوع يا ذكاء أفول","https://www.aldiwan.net/poem44942.html","الطويل"],[76,"ألا ثل من عرش الشباب وثلما","https://www.aldiwan.net/poem13251.html","الطويل"],[107,"أعيدوا لنا عصر الجهاد مظفرا","https://www.aldiwan.net/poem43388.html","الطويل"],[77,"وأبيض من ماء الحديد كأنما","https://www.aldiwan.net/poem69045.html","الطويل"],[52,"ألا قل لعبدة إن جئتها","https://www.aldiwan.net/poem63871.html","المتقارب"],[48,"تحمل عن أبيك الثقل يوما","https://www.aldiwan.net/poem23564.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85649","الطويل"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72234","الطويل"],[147,"سل المقادير ما أحببته تجب","https://www.aldiwan.net/poem11725.html","البسيط"],[190,"والحلم مثل الدوا مر مذاقته","https://www.aldiwan.net/poem43802.html","البسيط"],[422,"بوخز القنا والمرهفات البواتر","https://www.aldiwan.net/poem54013.html","الطويل"],[422,"أسرك من باد لعينيك حاضر","https://www.aldiwan.net/poem54066.html","الطويل"],[434,"ألا ثكلتك أمك عبد عمرٍو","https://www.aldiwan.net/poem775.html",""],[438,"حمل الريح بالأصيل سلامه","https://www.aldiwan.net/poem12719.html","الخفيف"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118391","الطويل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137925",""],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145130","الطويل"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120532","الطويل"],[4999,"حتّى متى","https://www.poetsgate.com/ViewPoem.aspx?id=184532",""],[6093,"المدح (مجزوء الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=188471",""],[6142,"كم البيض بالأغماد حرى شفارها","https://www.poetsgate.com/ViewPoem.aspx?id=155749",""],[6148,"نصائح غالية","https://www.poetsgate.com/ViewPoem.aspx?id=203066",""]],"verses":[["أَلا ثَكَلَت أُمُّ الَّذينَ مَشَوا بِهِ","إِلى القَبرِ ماذا يَحمِلونَ إِلى القَبرِ",0,"ر",1,0],["الأَثقَلونَ حَصاةً في نَديِّهِمُ","وَالأَرزَنونَ إِذا خَفَّ المَجاهيلُ",1,"ل",1,0],["إلا ثلاثاً في المقا","مة ما يحولهن ناقلْ",2,"ل",1,1],["ألا ثكلت أمُّ الذين أكُفهم","عليك بطوعٍ للتراب تهيل",3,"ل",1,0],["أَلا ثَلِّ مِن عَرشِ الشَبابِ وَثَلِّما","لِشَيبٍ تَصَدّى هَدَّ رُكني وَهَدَّما",4,"م",2,1],["أَلا ثَقِّفوا الشَعبَ الَّذي نامَ جَدُّهُ","فَما مَلَكَ الدُنيا كَشَعبٍ مُثَقَّفِ",5,"ف",1,0],["ألا ثَكَلَتْ أُمُّ امرىءٍ هو بَزُّهُ","إذا لم يُفارِقْ عِزَّ أيّامِهِ الذُّلُّ",6,"ل",1,0],["الاِثنَينِ هَل فيهِما رَحمَةٌ","لِذي شَجَنٍ يَنظُرُ الواعِدا",7,"د",2,0],["أَلا ثَني جَمالَكَ نَحوَ مَرعىً","فَهَذا الرَملُ لَم يَنبُت لِواهُ",8,"و",3,0],["أَلا ثكلت وغد الجريمة أمُّه","فأية نار في قلوب المنى شبا",9,"ب",2,0],["ألا ثكِلَتْ أُمُّ الذينَ غَدَوا بِهِ","إلى القَبْرِ ماذا يحملون إلى القبرِ",10,"ر",1,0],["أَلّا ثَنَوها وَقَد ظَلَّت عَجاجَتُها","أَولى بِسَترِ عَذاراهُم مِنَ النُقُبِ",11,"ب",1,0],["إلا ثلاثة أشياء خضعت لها","سقم يطول وهجران وإعسار",12,"ر",1,0],["ألا ثكلت أُمُّ الجبان وليدها","وفازت بما حازته أُمُّ المخاطر",13,"ر",1,0],["ألا ثكلت أُمُّ الجبان وليدها","ولا قررت منه بعين وناظر",14,"ر",1,0],["أَلا ثَكِلَتكَ أُمُّكَ عَبدَ عَمرٍو","أَبالخِزيات آخَيتَ المُلوكا",15,"ك",2,1],["الأثيرُ المحلُّ والسيّدُ المَصْ","قَعُ منهم والأوحدُ العلاّمَهْ",16,"م",2,0],["ألا ثق بأن الله يعطى تفضلا","وإن الذي آتاك توتاه مسجلا",17,"ل",2,1],["أَلا ثكلتك أمك شهر آب","ولو نقصت شهور العام شهرا",18,"ر",2,1],["ألا ثورة للعلم تغسل عارهم","وتكتسح الفوضى وتستأصل الجهلا",19,"ل",2,0],["إِلاّ ثَنَى الكَيْدَ مِنْهُ في مُقَلَّدِهِ","وَلا الْتَمَسْتُ غِنَى الدارَيْنِ مِن يَدِهِ",20,"ه",1,0],["ألا ثق بتيسير الامور فما يرى","عسيرا فعند الله غير عسير",21,"ر",1,1],["ألا ثُرْ ونكِّلْ عروش الظلام","وأرْجِع عدوَّك حيث أتى",22,"ت",2,0],["إلَّا ثَوَابَ الوَاحِدِ ال","مَنَّانِ وَالوَهَابِ",23,"ب",1,0],["ألا ثائر يقظان للثأر عزمه","إذا ما غفاة العزم قد فات ثارها",24,"ر",3,0],["ألا ثق بالإله لعل أمرا","كأصعب ما يكون يجيء سهلا",25,"ل",2,1]]}