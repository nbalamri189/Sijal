{"poems":[[10,"أعيني هلا تبكيان على صخر","https://www.aldiwan.net/poem21080.html","الطويل"],[27,"خف القطين فقلبي اليوم متبول","https://www.aldiwan.net/poem5952.html","البسيط"],[37,"إلا ثلاثا في المقامة","https://www.aldiwan.net/poem7648.html","مجزوء الكامل"],[89,"لكل طلوع يا ذكاء أفول","https://www.aldiwan.net/poem44942.html","الطويل"],[74,"ألا ثل من عرش الشباب وثلما","https://www.aldiwan.net/poem13251.html","الطويل"],[105,"أعيدوا لنا عصر الجهاد مظفرا","https://www.aldiwan.net/poem43388.html","الطويل"],[75,"وأبيض من ماء الحديد كأنما","https://www.aldiwan.net/poem69045.html","الطويل"],[50,"ألا قل لعبدة إن جئتها","https://www.aldiwan.net/poem63871.html","المتقارب"],[46,"تحمل عن أبيك الثقل يوما","https://www.aldiwan.net/poem23564.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85649","الطويل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72234","الطويل"]],"verses":[["أَلا ثَكَلَت أُمُّ الَّذينَ مَشَوا بِهِ","إِلى القَبرِ ماذا يَحمِلونَ إِلى القَبرِ",0,"ر",1,0],["الأَثقَلونَ حَصاةً في نَديِّهِمُ","وَالأَرزَنونَ إِذا خَفَّ المَجاهيلُ",1,"ل",1,0],["إلا ثلاثاً في المقا","مة ما يحولهن ناقلْ",2,"ل",1,1],["ألا ثكلت أمُّ الذين أكُفهم","عليك بطوعٍ للتراب تهيل",3,"ل",1,0],["أَلا ثَلِّ مِن عَرشِ الشَبابِ وَثَلِّما","لِشَيبٍ تَصَدّى هَدَّ رُكني وَهَدَّما",4,"م",2,1],["أَلا ثَقِّفوا الشَعبَ الَّذي نامَ جَدُّهُ","فَما مَلَكَ الدُنيا كَشَعبٍ مُثَقَّفِ",5,"ف",1,0],["ألا ثَكَلَتْ أُمُّ امرىءٍ هو بَزُّهُ","إذا لم يُفارِقْ عِزَّ أيّامِهِ الذُّلُّ",6,"ل",1,0],["الاِثنَينِ هَل فيهِما رَحمَةٌ","لِذي شَجَنٍ يَنظُرُ الواعِدا",7,"د",2,0],["أَلا ثَني جَمالَكَ نَحوَ مَرعىً","فَهَذا الرَملُ لَم يَنبُت لِواهُ",8,"و",3,0],["أَلا ثكلت وغد الجريمة أمُّه","فأية نار في قلوب المنى شبا",9,"ب",2,0],["ألا ثكِلَتْ أُمُّ الذينَ غَدَوا بِهِ","إلى القَبْرِ ماذا يحملون إلى القبرِ",10,"ر",1,0]]}