لكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139627",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139543",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139732",""],[4691,"أمّ الروائع ( الشاعرة غيداء الأيوبي )","https://www.poetsgate.com/ViewPoem.aspx?id=214662",""],[4984,"عيد الشجرة","https://www.poetsgate.com/ViewPoem.aspx?id=180037",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5010,"هذه الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=191135",""],[580,"مديحُك كَالمِسْكِ لا يُكْتَتَمْ","https://www.poetsgate.com/ViewPoem.aspx?id=42240",""],[585,"عبست لك الدنيا وحال ودادها","https://www.poetsgate.com/ViewPoem.aspx?id=161922",""],[585,"حييت من وطنٍ كالركن مستلم","https://www.poetsgate.com/ViewPoem.aspx?id=161912",""],[5387,"غرناطة","https://www.poetsgate.com/ViewPoem.aspx?id=83393",""],[5442,"اعمل حساب النفس عن هفواتها","https://www.poetsgate.com/ViewPoem.aspx?id=114757",""],[5459,"لا تعش فيها","https://www.poetsgate.com/ViewPoem.aspx?id=200166",""],[5533,"دُوْمَا في القَلْب","https://www.poetsgate.com/ViewPoem.aspx?id=176715",""],[5605,"رسالة الى عباس","https://www.poetsgate.com/ViewPoem.aspx?id=160586",""],[5956,"ديمقراطية أمريكا وحلفائها","https://www.poetsgate.com/ViewPoem.aspx?id=192213",""],[6093,"يَا مَنْ أرَاكَ بصحَّةٍ مَفتُونَا","https://www.poetsgate.com/ViewPoem.aspx?id=198258",""],[6185,"قصة الجمال !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86941&r=&rc=1",""],[5190,"السقوط المنتظر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85052&r=&rc=127",""]],"verses":[["كَما مالَ المُعاقِرُ عاوَدَتهُ","حُمَيّا الكَأسِ حالاً بَعدَ حالِ",0,"ل",1,0],["كَم آمِلٍ يَغدو عَلى ال","أَمَلِ البَعيدِ فَلا يَروحُ",1,"ح",1,0],["كَم آمِرٍ لي بِالتَصَبُّرِ هاجَ لي","داءً وَقَدَّرَ أَنَّ ذاكَ دَوائي",2,"ي",1,0],["كَم أُمَّةٍ رَغِبَت فيها فَما رَسَخَت","لَها عَلى حَولِها في أَرضِها قَدَمُ",3,"م",1,0],["كَما مالَ أَبيَضُ ذو نَشوَةٍ","بِصَرخَدَ باكِرَ كَأساً شَمولا",4,"ل",2,0],["كَما مالَ فَضلُ الجُلِّ عَن مَتنِ عائِذٍ","أَطافَت بِمُهرٍ في رِباطٍ مُطَوَّلِ",5,"ل",1,0],["كم آمن فيه أمنَ الطيرِ في حرمٍ","وكان مثل قطاةٍ غرَّها شرَك",6,"ك",1,0],["كم آمن منِّي العُرامَ تركتُهُ","لا يستظل الدهرَ ظلَّ أمان",7,"ن",1,0],["كَما مَنَعَت أَسماءَ صَحبي وَمِزوَدي","عَشِيَّةَ قَرَّبتُ المَطِيَّةَ راحِلا",8,"ل",2,0],["كَما ملأتُنَّ قَلبي مُذ حَلَلتُ بِها","مَخافَةً أَسلَمَت عَيني إِلى السَهَرِ",9,"ر",1,0],["كَم إِمامٍ قَرُبتَ في الصَفِّ مِنهُ","وَمُغَنٍّ قَعَدَتَ مِنهُ رَسيلا",10,"ل",2,0],["كما مُدَّ من ذَهَبٍ مُدَّةٌ","على لازوردية الرُّقْعَهْ",11,"ع",2,0],["كَم آمِرٍ أَلّا تَجودَ وَعاتِبٍ","في أَن تَجودَ أَبَتَّهُ في عَتبِهِ",12,"ب",2,0],["كَما مُدَّتِ الكَفُّ المُضافُ بَنانُها","إِلى عَضُدٍ في المَكرُماتِ وَساعِدِ",13,"د",1,0],["كَم أُمورٍ لَقَد تَشَدَّدتُ فيها","ثُمَّ هَوَّنتُها عَلَيَّ فَهانَت",14,"ت",1,0],["كَم أُمورٍ قَد كُنتَ شَدَدتَ فيها","ثُمَّ حَوَّنتَها عَلَيكَ فَهانَت",15,"ت",1,0],["كَم أُمَنّي بِغَدٍ بَعدَ غَدٍ","يَنفَدُ العُمرُ وَلَم أَلقَ غَدا",16,"د",2,0],["كما مرّ بالوردِ والأقحوانِ","نسيمٌ مشوبٌ بِرَيّا العبيرِ",17,"ر",1,0],["كَما مَشَطَتْ غِيدُ القِيانِ شُعورَها","وَقامَتْ لِرَقصٍ في غَلائِلِها الحُمْرِ",18,"ر",1,0],["كَمْ أُمَّةٍ دَرَسَتْ أَشْبَاحُهَا وَسَرَتْ","أَرْوَاحُهَا بَيْنَنَا فِي عَالَمِ الْكَلِمِ",19,"م",1,0],["كم أُمّةٍ لم تُوقَ عادِيةَ الرَّدى","لولا الذي اقْتَحَمَ الرَّدى فوقاها",20,"ا",3,0],["كَما مالَ غُصنٌ مِن أَراكِ بَرِيرَةٍ","تُحَرِّكُهُ رِيحٌ مِنَ الماءِ مُخضَلُ",21,"ل",1,0],["كَما ما أَحسَنَ الوَصلَ","كَذا ما أَقبَحَ الصَرما",22,"م",2,0],["كَم أَميرٍ أُميرَ في عاصِفاتٍ","بَعدَما حابَ في الحَياةِ وَحابى",23,"ب",2,0],["كَما مُلِئَ الغَربُ مِن مائِهِ","وَخُلِّيَ في الجَفرِ لَم يُمتَحِ",24,"ح",1,0],["كَم أُمَّةٍ لَعِبَت بِها جُهّالُها","فَتَنَطَّسَت مِن قَبلُ في تَعذيبِها",25,"ب",3,1],["كَمْ أُمَّةٍ كَانَتْ عَلَى قَدْرِ الهَوَى","تَرْجُوكَ مَا شَاءَتْ لِطُولِ بَقَاءِ",26,"ا",2,0],["كَمْ أُمَّة تَتَسَامَى","فِي حِينِ تَسْقُطُ أُخْرَى",27,"ر",2,0],["كم أميرٍ دانت لهم أُممٌ، وهْ","وَ مدينٌ لشاعرٍ بالخلود",28,"د",1,0],["كم أم بابك عائذ بجلالة","خير المعاذ معاذها ومقامها",29,"م",3,0],["كم أميرٍ أميرَ في عاصفاتٍ،","بعدما حابَ، في الحياة، وحابا",30,"ب",2,0],["كَمَا مَالَ أَبْيَضُ ذُو نَشْوَة","ٍ تصرخدَ باكرَ كأساً شمولا",31,"ل",2,0],["كَم آمَنَت سَطَواتُ عَزمِكَ خائِفاً","وَجِلاً وَراعَت أَروَعاً صِنديدا",32,"د",2,0],["كَمَا مَرُّوا نَمُرُّ وَمَنْ يَلِينَا","وَهَذِي سُنّْةُ الْمَوْلَى بَيَانُ",33,"ن",1,0],["كم أمهلت سطوات سفيك باغياً","رفقا به والبغي بئس المقتنى",34,"ن",2,0],["كما مَيَّل الدنَّ المروَّقَ ساكبٌ","فدَبَّ احمرارُ الخمرِ في حَلَك القار",35,"ر",1,0],["كَم أُمورٍ قد أحزَنتنيَ لا تخ","فاكَ ما لي لِمتنهنّ شروحُ",36,"ح",1,0],["كم أمرَ الحبُّ وكم قد نهى","فبتُّ باكي العينِ لم أهجعِ",37,"ع",1,0],["كَم أَميرٍ وَكَم مَليكٍ تَوارى","وَطَوَته دُجنَّةٌ وَقبورُ",38,"ر",1,0],["كم إمام بعده خلف","منه سادات بذا عرفوا",39,"ف",3,0],["كما موجة تتقي صخرة","فتكسرها صخرة ثانية",40,"ي",2,0],["كمِ امتطَى النّجمَ لم تكْدُدْ له قَدَمٌ","إلى العُلا مُدْنِياً منها الّذي شَحَطا",41,"ط",2,0],["كم أمّلَتْ يُمناكَ أنْ سَتُمِرُّها","دون الهُدى يَزَنيّةٌ سَمْراء",42,"ا",2,0],["كما مرَ بازٌ بالفضاء محلِّقٌ","رأته بُغاتُ الطير حتفاً لها حمّا",43,"م",2,0],["كَم امورٍ ذَكَراها","وَاِمورٍ نَسِياها",44,"ا",3,0],["كمْ أمورٍ لدَهْرِنا مهلكاتِ","لاحقاتِ أبناءه مدركات",45,"ت",1,0],["كما مُحِيَتْ سطورٌ من كتابٍ","وما يدري لها عندي شروح",46,"ح",1,0],["كما مَسَّنِي الشيطانُ نحوَكَ ساعِياً","بطائِفِ سُقْمٍ مِن عذابٍ وَمن نَصبِ",47,"ب",1,0],["كم أمَّهُ من مقعدٍ حظهُ","وراش بالجود جناح النجاحْ",48,"ح",1,0],["كم أماطت غيده لتربها","عن محيا فاتن مستحسن",49,"ن",1,0],["كم أَمطرَ الحُبُّ منَّا","عيناً وأَخضَعَ هَامَهْ",50,"م",2,0],["كمْ أمَّ ساحَتَهُ شَقيٌّ خاسرٌ","وأعادهُ بِتجارةٍ هي رابحهْ",51,"ح",2,0],["كم آمنٍ أضحى المطا","حَ بها وقد أمسى الحريزا",52,"ز",2,0],["كَم آمِنٍ لَكَ نائِيَ الدارِ مُمتَنِعٍ","أَخرَجتَهُ مِن حُصونِ المُلكِ وَالخَوَلِ",53,"ل",1,0],["كم أمة قبلنا كانت تشاهده","من غير علم به عن قيدها انطلقا",54,"ق",2,0],["كم أَمُصُّ الثماد وحْدي وغيري","كادَ يُفْنِي البحرَ المحيطَ بجرْع",55,"ع",1,0],["كم أمطرت قوما على ظمئهم","وكان كل الوبل من سحبها",56,"ب",3,0],["كم أمَّلوا وِرد عَذبٍ في تواصلهم","فعاضهم عنهُ زقُّوماًَ وغسلينا",57,"ن",2,0],["كَم أَمات الحسود في يوم مجد","وأَضاف الوحوش في يوم دعس",58,"س",1,0],["كم أمة ذهب الغرو","ر برشدها شر المذاهبْ",59,"ب",1,0],["كم أمالا الصب عن أمل","يرتجيه بائساً خجلا",60,"ل",2,0],["كم أمن خوفا وكم أقال عثارا","كم ألبس عار وكم تفضل بالمال",61,"ل",1,0],["كم أمّة قصرت مدىً في فخرها","عن أمّة سلطانها سلطانُها",62,"ن",3,0],["كما من الإنجيل في أهليه","كشف عنهم عشوات التيه",63,"ه",1,0],["كَم آمِنٍ لِلمَنونِ لاهٍ","عَنِ الرَدى باتَ مُطمَئِنّا",64,"ن",2,1],["كما مضى في الميم لكن دورا","واصعد بجنبيه وسنٍّ قُرِّرا",65,"ر",2,0],["كم آملٍ صدقت فيه عافيتُه","جوداً وكم مَلكت نفساً ظَرافتُه",66,"ه",1,0],["كَم أُمَشّى كَأَنَّني ذو طِحالٍ","وَأُمَنّى كَأَنّي كَمّونُ",67,"ن",1,1],["كَم أمَحَّت وَكَم ألحّ عليها","من مُلِثِّ الدجونِ منذُ زمانِ",68,"ن",1,0],["كَم أُمّة هَلَكَت وَدارٌ عطّلت","وَمَساجد خربَت وَعمّرَ مَعهدُ",69,"د",1,0],["كم أمه وافج للنجح نال وكم","أثنى وأمضى بذي الآداب والأثر",70,"ر",1,0],["كما مثل الجناتِ جاءت زيادةً","ووصفاً لأنهارٍ من الماءِ تلتطم",71,"م",1,0],["كما ماست مخدرة رداحٌ","تهزع في القلائد والعقودِ",72,"د",1,0],["كم أمة هذبتها ووهبتها","محض الشهاد وزدتها تأهيلا",73,"ل",2,0],["كَم آملٍ أَملاً قَريباً نيله","قَطعَ الحِمام بِهِ عَن الأَوطار",74,"ر",1,0],["كَمْ أُمنّي بِوَصلِكَ القلبَ في السِّ","رِّ وفي الجَهْرِ والأَمانيُّ ضَلَّه",75,"ل",2,0],["كما ملأ الباجي وصاياه غرة","وعهدا على أبنائه منه بالهجر",76,"ر",1,0],["كما ميز الرحمن بين عبادِه","إذا دفنوا في الأرض من ضغطة القبر",77,"ر",1,0],["كم امام قد غرّ بالعيش فيها","والمنايا بساحتيه نزول",78,"ل",1,0],["كم أماتت قلب صبٍ والهٍ","حين عادت بعد وصلٍ بصدود",79,"د",1,0],["كم أمحلت شهب السنين فأخصبت","بنميرها العذب الرؤى أيامها",80,"م",3,0],["كم أماط اللثام عن مشكلات","لسواه قد عز كشف غطاها",81,"ا",3,0],["كما من حزاني حولها","هموا بها شتماً وسبا",82,"ب",2,0],["كما مَلَكَ المنصورُ بالنّصر مرقبا","غدا النّصر فيه للهُدى مُتَرَقَبا",83,"ب",2,0],["كم أمة طلبت حقاً فاعجزها","طلابه بلسان ناطق وفم",84,"م",1,0],["كم امة حكمت في مصر وارتحلت","عنها حليفة جد بعد لم يقم",85,"م",1,0],["كم أمور جليت والحمد للَه","بفكر في الغائبات دقيق",86,"ق",1,1],["كَم أَملٍ خابَ وَكَم رَجاءِ","وَما أَرى من شيمَ الإِباءِ",87,"ا",2,0],["كم أمور أمكنت أمهلها","هي عندي إذ تولت غصص",88,"ص",1,0],["كمْ أمّةٍ أمّتْكَ بعْدَ خِلافِها","لتَنالَ عفْوَكَ تحْفَةً في المَقْدَمِ",89,"م",1,0],["كَم امير جاءَها ذا سَطوَةٍ","ثُمَّ عَنها مِثل ما جاءَ اِرتَحَل",90,"ل",1,0],["كَم امِير سادَ اِسمى مَنصِب","راقِياً في عَرشِهِ ثُمَّ اِنعَزَل",90,"ل",1,0],["كما مسني فيك الهيام وحقه","وحقي بان اهواك كالختن البكرِ",91,"ر",1,0],["كَم أَمهّم بِصَناديد صَوارمهم","كَالبَرق في عارض في الأُفق مُنسَجم",92,"م",1,0],["كم آمل من نيلها","قد آب في خُفّي حنين",93,"ن",1,0],["كم آملٍ يرجو وَيخشى يائسٌ","وَبغير ذاك وهذه جفَّ القلم",94,"م",1,0],["كَم أُمّةٍ هَزُلَت بدولةِ غَيرنا","وَغَدت بِنا بيضَ الوُجوه تدلّخ",95,"خ",1,0],["كم أمال حرروها ومعا","ل محال حصرها والعدد",96,"د",1,0],["كما محا غرة الكواكب صبح","ثم حطت ضياءها الظلماء",97,"ا",2,0],["كم أممنا روضة أنفا","شكرت ازهارها المطرا",98,"ر",2,0],["كم أملوا أن يروه في حيازتهم","فكان ما أملوا أضغاث أحلام",99,"م",1,0],["كم أمةٍ لم يعطها العلم الهدى","شقيت وأوردها الضلال حمامها",100,"م",3,0],["كم أمّلوا الآمال منه فلم يروا","إلا ضرائب تقطع الآمالا",101,"ل",2,0],["كما منه زهت للسعد شمس","بأوج الحسن للقمرين ضره",102,"ر",2,0],["كم آملٍ بالنّدى يُحقِّقُهُ","ومنيَّةٍ بالنَّجاحِ يُسعفُها",103,"ف",3,0],["كم أم غار الغور بَرٌّ ذو تُقىً","ورقى جَموحَ الثائرات بَذورُ",104,"ر",1,0],["كم آمر بالصبر قال له","الرأي فيما قلت لو قدرا",105,"ر",2,0],["كما مُهِّدت للعلم فيه معاهدٌ","تسامى ذراها إذ تداعت معاهدُه",106,"د",2,0],["كما ملأت آلُ النبي محمدٍ","رحابَ الفيافي رنَّةً ونحيبا",107,"ب",2,0],["كم أمطرت بالعلم من آرائهم","ومن الأنامل بالنضار غمام",108,"م",1,0],["كما مهجة ٌ عفّتْ لغيدا مضيئةٌ","فإن هيَ تُلقي الشعرَ يلمعْ ويسطعِ",109,"ع",1,0],["كم أمة لفها الدهر الدهير فما","أبقى على ذكرها إلا صدى الخبر",110,"ر",1,0],["كما مدد الارسال والانبياء مذ","تبدوا من الروح الشريف تفعما",111,"م",2,0],["كَمْ