{"poems":[[53,"يا صائد الأسد إن صيدكها","https://www.aldiwan.net/poem61832.html","المنسرح"],[53,"أنى تشاغلت عن أبي حسنك","https://www.aldiwan.net/poem65777.html","الخفيف"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39525","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42568","الطويل"],[202,"ألا يا واقفا بي عند قبري","https://www.aldiwan.net/poem51894.html","الوافر"],[208,"يا غائبا ذكره في القلب محتضر","https://www.aldiwan.net/poem53267.html","البسيط"],[369,"ألا من عذيري من جوى في الجوانح","https://www.aldiwan.net/poem60966.html","الطويل"],[409,"يا عاتبا لي ما الذي","https://www.aldiwan.net/poem34113.html","مجزوء الرجز"],[445,"أي شراع لأي بحر","https://www.aldiwan.net/poem34854.html","مخلع البسيط"],[445,"بشير يوم بملك دهر","https://www.aldiwan.net/poem34907.html","مخلع البسيط"],[458,"ما جاء قبلك للتخليد إنسان","https://www.aldiwan.net/poem61247.html","البسيط"],[519,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34775","البسيط"],[1054,"","https://poetry.dctabudhabi.ae/diwan/poem/145939","البسيط"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122022","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118299","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123274","المواليا"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108426","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27208","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87336","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76080","الطويل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97971","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108022","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91227","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131094",""],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136839",""],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76740","الوافر"],[4689,"عبقري الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=152814",""],[4852,"كأس شاي","https://www.poetsgate.com/ViewPoem.aspx?id=214267",""],[3591,"على صدور الخرد الحسانِ","https://www.poetsgate.com/ViewPoem.aspx?id=149415",""],[5136,"ما للعواذل لا كانوا ولا خلقوا","https://www.poetsgate.com/ViewPoem.aspx?id=121637",""],[5281,"صانعُ النور","https://www.poetsgate.com/ViewPoem.aspx?id=207174",""],[5606,"زمان المصايب","https://www.poetsgate.com/ViewPoem.aspx?id=195062",""],[5606,"الأمرعاتي","https://www.poetsgate.com/ViewPoem.aspx?id=195169",""],[5606,"واي فاي","https://www.poetsgate.com/ViewPoem.aspx?id=198049",""]],"verses":[["وأي شيء أجلُّ منفعةً","من أسدٍ قاسطٍ على أسدِ",0,"د",1,0],["وأيُّ شيءٍ أدقُّ من ثمني","وأيُّ شيءٍ أجلُّ من ثمنِك",1,"ك",1,0],["وأَيُّ شيءٍ أَلذُّ من أَمَلٍ","نالتْهُ معشوقَةٌ وعاشِقُها",2,"ق",3,0],["وَأَيُّ شَبَابٍ لا يَزُولُ نَعِيمُهُ","وَسِرْبالِ عَيْشٍ لَيْسَ يَبْلَى جَدِيدُهُ",3,"د",2,0],["وأيّ شماتة في ترك دنيا","لذي أمل رأى عنها ارتحالي",4,"ل",2,0],["وأيّ شيء أقود القلب عنك به","وقائداه إليك السمع والبصرُ",5,"ر",1,0],["وأيُّ شيِاتِ الخيلِ حَلْىٌ مُزايَلٌ","إذا ما عدا بَعضُ العتاقِ الصَّحائح",6,"ح",1,0],["وأي شيء قد جرى","مني حتى ألهبك",7,"ك",1,0],["وأَيُّ شمسٍ تجلَّلَتْها","طُرَّةُ صُبْحٍ سَعَتْ بفجرِ",8,"ر",1,0],["وأيُّ شِبْلٍ لأَيِّ لَيْثٍ","وأَيُّ نهرٍ لأيِّ بَحْرِ",9,"ر",1,0],["وأيّشعر لمثلي كيفما عظمت","رموزه في الذي نجواه قرآن",10,"ن",1,0],["وأيُّ شُهْبٍ سوى ما في قلائِدها","أمْسَتْ صُفوفاً حَوالَ الشمسِ تصطحِبُ",11,"ب",1,0],["وأي شيءٍ من الدنيا سمعت به","إلا إذا صار في غاياته انقطعا",12,"ع",2,0],["وأيُّ شيءٍ تُرَى يَرْجوهُ منْ ذهبَتْ","لَذاتُه وهو للآفاتِ مُنتظِرُ",13,"ر",1,0],["وَأَيُّ شَفِيعٍ لِلْكُرُوبِ مُفرِّجٍ","إِذَا قِيلَ يَوْمَ الحَشْرِ يَا أَزْمَةُ اشْتَدِّي",14,"د",2,0],["واي شيء على الاحرار اشنع من","تسبب في معاداة الاوداء",15,"ا",2,0],["وايش ما انصرم جدده","دولاب حشيش عمّال",16,"ل",1,0],["وائشد لدى ذاك المقام قصائداً","ان كنت ممن يستطيع نظاما",17,"م",2,0],["وأيّ شخصٍ أبى إلا تحققه","فإنَّ غايته جحد وإشراك",18,"ك",1,0],["وأيُّ شَبَابِ بعدَ ستينَ حِجَّةً","سما في السما فوقَ السماكينِ والنَّسرِ",19,"ر",1,0],["وَأَيُّ شفاءٍ لا يُرى شفَّهُ الهَوى","سِنينَ لَهُ تِسعاً يُكابِر أَشجانا",20,"ن",2,0],["وأي شيء لديه رهن ذمته","وكل شيء له يمضي لتبديد",21,"د",1,0],["وأيُّ شيءٍ بمصرٍ لا يتيمنا","مصرٌ حوت كل ما شاق الورى وسبى",22,"ب",2,0],["وَأَيُّ شهمٍ مِن الدُنيا يفاخرُنا","وَنحن نصحبُ عبدَ الخالق بنَ وفا",23,"ف",2,0],["وأيّ شقي كان من غير والد","وأم فينجو الوالدان من العتب",24,"ب",1,0],["وأيش عذرك فديتك يا ضياء كل ربعي","بعد ما بان لك بؤسي وفقري ونجعي",25,"ع",2,0],["واي شذى أتيت له اشتياقا","وكان نسميه بالحمد صاكا",26,"ك",2,0],["وأي شعرٍ عن الفاروق ينصفه","وكيف تجري بحورٌ فوقها عمر",27,"ر",1,0],["وأيُّ شدوىً لأمي كنتُ أسمعُها؟","وأيُّ \"نامي غدًا أشهى\"، أكفرُها؟",28,"ر",3,0],["وأي شي كان في الأكوان","فلم يميزه عن الحسانِ",29,"ن",1,0],["وايش قال وماذا في أعجبه","ماذا صحيح ولاذا منه يتفق",30,"ق",1,0],["وأيُّ شَخصٍ كماهو يَسْتَكِنُّ بنا","عنهُ نحدِّثُ أحبابًا وأَضْيَافا",31,"ف",2,0],["وايش باقي يازمان من المصايب؟","خف عنايازمن وأشفق شويه",32,"ي",2,1],["وأيش عندك ياكثير الموعظاتي","يامطوع لاتكن ناوي بنيه",33,"ي",2,0],["وأيش أخرتها يازمان كويك نت وواي فاي؟","ماأقول غير الله على ماتفعله فينا يعين",34,"ن",1,1]]}