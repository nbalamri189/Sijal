{"poems":[[102,"وجوه دخانية في مرايا الليل","https://www.aldiwan.net/poem24840.html","عموديه"],[23,"تبلت فؤادك في المنام خريدة","https://www.aldiwan.net/poem21235.html","الكامل"],[74,"طحانكم قد زهى جمالا","https://www.aldiwan.net/poem20464.html","مخلع البسيط"],[16,"طحا بك قلب في الحسان طروب","https://www.aldiwan.net/poem27695.html","الطويل"],[46,"أسقى طلولهم أجش هزيم","https://www.aldiwan.net/poem30341.html","الكامل"],[107,"محمد يا ابن مسلمة سلام","https://www.aldiwan.net/poem43990.html","الوافر"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147464","البسيط"],[108,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[111,"خذوا بجميل الصبر وارضوا وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=524",""],[111,"خذوا بجميل الصبر وارضوا وسلموا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545637",""],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[242,"قل للذي لا ينتهي عن فحشه","https://www.aldiwan.net/poem19722.html","الكامل"],[309,"يا رسول الله يا أهل الوفا","https://www.aldiwan.net/poem16816.html","الرمل"],[310,"ألا في جوار الله تم نفاسها","https://www.aldiwan.net/poem56498.html","الطويل"],[401,"يآل عُبادٍ دعوة بعد هجمةٍ","https://www.aldiwan.net/poem594.html",""],[463,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[563,"إن قولي مؤيد بالنقول","https://www.aldiwan.net/poem34243.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122753","الكامل"],[706,"","https://poetry.dctabudhabi.ae/diwan/poem/144840","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62560","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25308","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25318","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79820","الرمل"],[2188,"","https://poetry.dctabudhabi.ae/diwan/poem/20897","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94317","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100264","الوافر"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107063","الخفيف"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140022","الطويل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104395","المتقارب"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104841","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129497","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117936","الطويل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36718","البسيط"],[4025,"","https://poetry.dctabudhabi.ae/diwan/poem/122153","الكامل"],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141838","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127081","الخفيف"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113836","الكامل"],[4755,"التَّمِيمة","https://www.poetsgate.com/ViewPoem.aspx?id=208979",""],[4782,"حكاية وجع","https://www.poetsgate.com/ViewPoem.aspx?id=198456",""],[4829,"الصمصامة (ملحمة بدر الكبرى)","https://www.poetsgate.com/ViewPoem.aspx?id=34259",""],[4829,"بن سالف","https://www.poetsgate.com/ViewPoem.aspx?id=34269",""],[4829,"الملحمة اليعربيّة","https://www.poetsgate.com/ViewPoem.aspx?id=36397",""],[5136,"أرأيت أية أزمة بالمغرب","https://www.poetsgate.com/ViewPoem.aspx?id=121521",""],[5431,"لن تضيع الأصول عند الحصاد","https://www.poetsgate.com/ViewPoem.aspx?id=196628",""],[5464,"أوصيك بي شراً اذا خنت الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=7560",""],[5516,"لا غفت عين","https://www.poetsgate.com/ViewPoem.aspx?id=213424",""],[5848,"أي دمعة حزن","https://www.poetsgate.com/ViewPoem.aspx?id=51960",""],[5848,"جريمة","https://www.poetsgate.com/ViewPoem.aspx?id=53361",""],[5848,"ألو","https://www.poetsgate.com/ViewPoem.aspx?id=53367",""],[5952,"لك يا عراق","https://www.poetsgate.com/ViewPoem.aspx?id=207803",""],[6024,"الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=186355",""],[6056,"ملاك الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=130338",""],[6142,"أنت السناء الذي في العرش قد بزغا","https://www.poetsgate.com/ViewPoem.aspx?id=155730",""],[6144,"أعوذ بالله","https://www.poetsgate.com/ViewPoem.aspx?id=21838",""]],"verses":[["طحت وجهي لأنّي جبل","خيل كسرى ، عجنته خيل نظمي",0,"م",2,0],["طَحَنَتهُمُ وَاللَهُ يُنفِذُ أَمرَهُ","حَربٌ يُشَبُّ سَعيرُها بِضِرامِ",1,"م",1,0],["طحَّانكم قد زهى جمالاً","فلا يطاق السلوّ عنه",2,"ه",1,1],["طَحا بِكَ قَلبٌ في الحِسانِ طَروبُ","بُعَيدَ الشَبابِ عَصرَ حانَ مَشيبُ",3,"ب",1,1],["طَحطَحتَ بِالخَيلِ الجِبالَ مِنَ العِدى","وَالكُفرُ يَقعُدُ بِالهُدى وَيَقومُ",4,"م",1,0],["طَحَا بِكَ مِن مُسَيْلَمةٍ خَبالٌ","فلا رَسَنٌ يُرَدُّ ولا زِمامُ",5,"م",1,0],["طَحورانِ عُوّارَ القَذى فَتَراهُما","كَمَكحولَتَي مَذعورَةٍ أُمِّ فَرقَدِ",6,"د",1,0],["طحنت طحن الرّحى من قبلنا أمما","شتّى، ولم يدر خلق أيّة سلكوا.",7,"ك",3,0],["طحنت فريقيها الحروب بضرسها","لا غالبًا رحَمتْ ولا مغلوبا",8,"ب",2,0],["طحى حدثان الدهر للفضل هضبة","وكانت بها هضب المكارم تدعم",9,"م",1,0],["طحى حدثنا الدهر للفضل هضبة","وكانت بها هضب المكارم تدعم",10,"م",1,0],["طَحَنَتهم ونارُها خَبَزَتهم","لِلعَوافي والطير منهم غذاءُ",11,"ا",2,0],["طَحَنَتْهُمُ أَضْرَاسُهُ طَحْنَ الرَّحَى","مَرَّتْ عَلَى يَبِسِ الْحَصِيدِ وَهَشِّهِ",12,"ش",2,0],["طحنتهم سنوات عجف","صار فيها الكل منهم لشفا",13,"ف",2,0],["طَحت شمسُها إِثرَ الشروقِ فَغادَرَت","أَهلّةَ مجدٍ لم يتمّ اِقتِباسها",14,"س",3,0],["طَحُون كمُلقى مِبرَدِ القين فَعمَةٌ","بجرعَاء مِلحٍ أو بجَوِّ نطاعِ",15,"ع",1,0],["طحَا بك بُعدٌ لا قرابةَ بعده","مسافةَ مقطوع المدَى غَلِقِ الرهنِ",16,"ن",1,0],["طحنتهم منه الرحى حين دارت","ثم جاءت بهم مجيء السيول",17,"ل",1,0],["طَحَنَت قُرَيشَ لاأَبطَحينَ وَلَم تَدَع","مِن جُرهُمٍ أحَداً فَأَودَت جُرهُمُ",18,"م",1,0],["طحنتْ رحى المَلوينِ عمري فانثنى","في مفرقي أثرُ الغبارِ الأبيض",19,"ض",1,0],["طحنون بدر مشرق","بل هو بحر مغرق",20,"ق",1,0],["طَحْطَحَها شَذْبُ السِنِينَ شَذْبا","وَالمُذْرِيَاتُ بالِذَوَارِي حَصْبا",21,"ب",2,0],["طَحَّانَةٍ حَزَّتْ حَلاقِيمَ اللَّحَا","قَوْماً تَغالَوْا مُلْكَهُمْ فَاسْتَجْرَحا",22,"ح",2,0],["طحا إذا ما نقصوها ثم إن","كنت إذا زادت لتصريع زكن",23,"ن",1,0],["طحنت أبناءُ حربٍ هامكم","برحى حربٍ لها كانوا الثفالا",24,"ل",2,0],["طَحَنَتهُم أَرحاؤُها بِطَحونِ","ذاتِ ظُفرِ حَديدِةِ الأَنيابِ",25,"ب",1,0],["طَحَنتُكُمُ طَحنَ الرَّحَى للحَبِّ حَتَّ","ى صِرتُم كَالبَعرِ فِي القِيعَانِ",26,"ن",1,0],["طحوته رحوته حسوته","محوته أسوته كسوته",27,"ه",1,0],["طحنت جحافلاً ونسفتُ هضباً","وَجُبتِ قساطلا ولففتِ جُندا",28,"د",2,0],["طحن الناس بالحروب ولكن","أسس لاحرب امة جرمنيه",29,"ي",2,0],["طحا بأبي سفيان همٌ سرى به","على أثر بدر نحو طيبة فانحطا",30,"ط",2,0],["طحنت ضلوعي بدمم الخطو","ب وغلت فقاري بالفاقر",31,"ر",1,0],["طحنت بقب الأعوجية صدر من","قد شرفت هام الأثير فعاله",32,"ل",2,0],["طحنا بها أرض العراق لبلدة","لنا من قريش ضم أقطارها رهطا",33,"ط",2,0],["طحين رحاء الحرب مهما أدارها","جسوم الأعادي إذ بهم في الوغى يسطو",34,"ط",2,0],["طَحا بِهِ في الحسان الغِيد حَيثُ طَحا","قَلبٌ عَلى العَهدِ مِن لَمياءَ ما بَرِحا",35,"ح",2,1],["طحنت رحى بدرٍ لمهلِكِ أهلِهِ","ولمثلِ بدرٍ تستهلُّ وتدمَعُ",36,"ع",1,1],["طحنت رحاها قرب عيجا طحنةً","ولمثل محنتها الدموع تسيل",37,"ل",1,0],["طحنتهم رحى المنون وكانت","من سطاهم تزلزل الغبراء",38,"ا",2,0],["طحا فؤادي في الهوى بي نحوَه","يا ليتَ قلبي في الهوى بي ما طَحا",39,"ا",1,0],["طحنت رحى الحرب الضروس رؤوسهم","طحن الحبوب بساحة الحلفاء",40,"ا",2,0],["طَحَنَتنا حُرُوبُهُم وطَهَتنا","فَتَنَاسَوا شَقَاءَنا المُتَقَشِّف",41,"ف",1,0],["طحنت رحى الأهوال عظم عيالها","والبؤس يجثم في الحشا متمكنا",42,"ن",2,0],["طحاطيح(ن)ورثنا سيف خالد","بني مخزوم اذللنا الغطارس",43,"س",1,0],["طحنا البرتغالي اذ ..أتانا","بلنجه خايع(ن) من جا يشارس",43,"س",1,0],["طحنت اللي علي سلَّي سيوف الحقد ثم سليت","سيوف الثار مثل النار تحت يمناي طرقاها",44,"ا",3,0],["طحنّا الوقت والايام طحناً","ولا باقي سوى ابن الارذلينا",45,"ن",2,0],["طحنا كالدأماء لكن موجها","ما ماج إلا بالعذاب الأوصب",46,"ب",1,0],["طحنتني نوائبٌ رغم دأْبي","قلَّ ربحي وأسهمي في كسادِ",47,"د",1,0],["طَحَنَتْ رُحاكِ غَدي وما أَقْرَيتْني","في صَحْنِ يومي من قِراكِ شَهِيّا",48,"ي",2,0],["طحنت لقلبك المكلوم روحي","دواء عله يوما ينام",49,"م",1,0],["طحت كلي وابتديت المس متوني","واكتشفت اني وحيد بدون ثاني",50,"ن",2,0],["طحت ف يدين الليالي والليالي وش وراها","ما وراها الا تنازعني على فرحة يتيمه !",51,"م",2,0],["طحت في جمرة اشواقي وزاد اللهيب","واستثرت العيون وطاح منها جمر",52,"ر",1,0],["طحنوه لكن في سمائك غيمةٌ","صبَّتْ عليه مياهها لتؤلِّفهْ",53,"ف",2,0],["طحنتهم أيدي المنون فاصبحوا","لا يذكرون كأنهم ما كانوا",54,"ن",3,0],["طحت أنا في موقفي من حيرتي والإضطراب","آتالّم ، وآتأمّل ، في صوابي منه وأعجب",55,"ب",1,0],["طحنتهم برحى حرب يدور بها","حتف بسيفك أرواح العدى مضغا",56,"غ",2,0],["طحن البلاطة وسكتنا ياللا اهتكنا","وحطنا ف قعر التكنة وخلطها شعير",57,"ر",1,0]]}