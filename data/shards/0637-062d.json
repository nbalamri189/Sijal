{"poems":[[23,"تبلت فؤادك في المنام خريدة","https://www.aldiwan.net/poem21235.html","الكامل"],[72,"طحانكم قد زهى جمالا","https://www.aldiwan.net/poem20464.html","مخلع البسيط"],[16,"طحا بك قلب في الحسان طروب","https://www.aldiwan.net/poem27695.html","الطويل"],[44,"أسقى طلولهم أجش هزيم","https://www.aldiwan.net/poem30341.html","الكامل"],[105,"محمد يا ابن مسلمة سلام","https://www.aldiwan.net/poem43990.html","الوافر"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147464","البسيط"],[106,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""]],"verses":[["طَحَنَتهُمُ وَاللَهُ يُنفِذُ أَمرَهُ","حَربٌ يُشَبُّ سَعيرُها بِضِرامِ",0,"م",1,0],["طحَّانكم قد زهى جمالاً","فلا يطاق السلوّ عنه",1,"ه",1,1],["طَحا بِكَ قَلبٌ في الحِسانِ طَروبُ","بُعَيدَ الشَبابِ عَصرَ حانَ مَشيبُ",2,"ب",1,1],["طَحطَحتَ بِالخَيلِ الجِبالَ مِنَ العِدى","وَالكُفرُ يَقعُدُ بِالهُدى وَيَقومُ",3,"م",1,0],["طَحَا بِكَ مِن مُسَيْلَمةٍ خَبالٌ","فلا رَسَنٌ يُرَدُّ ولا زِمامُ",4,"م",1,0],["طَحورانِ عُوّارَ القَذى فَتَراهُما","كَمَكحولَتَي مَذعورَةٍ أُمِّ فَرقَدِ",5,"د",1,0],["طحنت طحن الرّحى من قبلنا أمما","شتّى، ولم يدر خلق أيّة سلكوا.",6,"ك",3,0],["طحنت فريقيها الحروب بضرسها","لا غالبًا رحَمتْ ولا مغلوبا",7,"ب",2,0]]}