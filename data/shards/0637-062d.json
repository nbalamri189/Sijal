{"poems":[[23,"تبلت فؤادك في المنام خريدة","https://www.aldiwan.net/poem21235.html","الكامل"],[72,"طحانكم قد زهى جمالا","https://www.aldiwan.net/poem20464.html","مخلع البسيط"],[16,"طحا بك قلب في الحسان طروب","https://www.aldiwan.net/poem27695.html","الطويل"],[44,"أسقى طلولهم أجش هزيم","https://www.aldiwan.net/poem30341.html","الكامل"],[105,"محمد يا ابن مسلمة سلام","https://www.aldiwan.net/poem43990.html","الوافر"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147464","البسيط"],[106,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[235,"قل للذي لا ينتهي عن فحشه","https://www.aldiwan.net/poem19722.html","الكامل"],[302,"يا رسول الله يا أهل الوفا","https://www.aldiwan.net/poem16816.html","الرمل"],[303,"ألا في جوار الله تم نفاسها","https://www.aldiwan.net/poem56498.html","الطويل"],[393,"يآل عُبادٍ دعوة بعد هجمةٍ","https://www.aldiwan.net/poem594.html",""],[456,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[556,"إن قولي مؤيد بالنقول","https://www.aldiwan.net/poem34243.html","الخفيف"]],"verses":[["طَحَنَتهُمُ وَاللَهُ يُنفِذُ أَمرَهُ","حَربٌ يُشَبُّ سَعيرُها بِضِرامِ",0,"م",1,0],["طحَّانكم قد زهى جمالاً","فلا يطاق السلوّ عنه",1,"ه",1,1],["طَحا بِكَ قَلبٌ في الحِسانِ طَروبُ","بُعَيدَ الشَبابِ عَصرَ حانَ مَشيبُ",2,"ب",1,1],["طَحطَحتَ بِالخَيلِ الجِبالَ مِنَ العِدى","وَالكُفرُ يَقعُدُ بِالهُدى وَيَقومُ",3,"م",1,0],["طَحَا بِكَ مِن مُسَيْلَمةٍ خَبالٌ","فلا رَسَنٌ يُرَدُّ ولا زِمامُ",4,"م",1,0],["طَحورانِ عُوّارَ القَذى فَتَراهُما","كَمَكحولَتَي مَذعورَةٍ أُمِّ فَرقَدِ",5,"د",1,0],["طحنت طحن الرّحى من قبلنا أمما","شتّى، ولم يدر خلق أيّة سلكوا.",6,"ك",3,0],["طحنت فريقيها الحروب بضرسها","لا غالبًا رحَمتْ ولا مغلوبا",7,"ب",2,0],["طَحَنَتهم ونارُها خَبَزَتهم","لِلعَوافي والطير منهم غذاءُ",8,"ا",2,0],["طَحَنَتْهُمُ أَضْرَاسُهُ طَحْنَ الرَّحَى","مَرَّتْ عَلَى يَبِسِ الْحَصِيدِ وَهَشِّهِ",9,"ش",2,0],["طحنتهم سنوات عجف","صار فيها الكل منهم لشفا",10,"ف",2,0],["طَحت شمسُها إِثرَ الشروقِ فَغادَرَت","أَهلّةَ مجدٍ لم يتمّ اِقتِباسها",11,"س",3,0],["طَحُون كمُلقى مِبرَدِ القين فَعمَةٌ","بجرعَاء مِلحٍ أو بجَوِّ نطاعِ",12,"ع",1,0],["طحَا بك بُعدٌ لا قرابةَ بعده","مسافةَ مقطوع المدَى غَلِقِ الرهنِ",13,"ن",1,0],["طحنتهم منه الرحى حين دارت","ثم جاءت بهم مجيء السيول",14,"ل",1,0]]}