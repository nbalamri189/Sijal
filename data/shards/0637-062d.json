{"poems":[[102,"وجوه دخانية في مرايا الليل","https://www.aldiwan.net/poem24840.html","عموديه"],[23,"تبلت فؤادك في المنام خريدة","https://www.aldiwan.net/poem21235.html","الكامل"],[74,"طحانكم قد زهى جمالا","https://www.aldiwan.net/poem20464.html","مخلع البسيط"],[16,"طحا بك قلب في الحسان طروب","https://www.aldiwan.net/poem27695.html","الطويل"],[46,"أسقى طلولهم أجش هزيم","https://www.aldiwan.net/poem30341.html","الكامل"],[107,"محمد يا ابن مسلمة سلام","https://www.aldiwan.net/poem43990.html","الوافر"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147464","البسيط"],[108,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[111,"خذوا بجميل الصبر وارضوا وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=524",""],[111,"خذوا بجميل الصبر وارضوا وسلموا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545637",""],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[241,"قل للذي لا ينتهي عن فحشه","https://www.aldiwan.net/poem19722.html","الكامل"],[308,"يا رسول الله يا أهل الوفا","https://www.aldiwan.net/poem16816.html","الرمل"],[309,"ألا في جوار الله تم نفاسها","https://www.aldiwan.net/poem56498.html","الطويل"],[400,"يآل عُبادٍ دعوة بعد هجمةٍ","https://www.aldiwan.net/poem594.html",""],[461,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[561,"إن قولي مؤيد بالنقول","https://www.aldiwan.net/poem34243.html","الخفيف"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/20897","الخفيف"],[1103,"","https://poetry.dctabudhabi.ae/diwan/poem/122153","الكامل"]],"verses":[["طحت وجهي لأنّي جبل","خيل كسرى ، عجنته خيل نظمي",0,"م",2,0],["طَحَنَتهُمُ وَاللَهُ يُنفِذُ أَمرَهُ","حَربٌ يُشَبُّ سَعيرُها بِضِرامِ",1,"م",1,0],["طحَّانكم قد زهى جمالاً","فلا يطاق السلوّ عنه",2,"ه",1,1],["طَحا بِكَ قَلبٌ في الحِسانِ طَروبُ","بُعَيدَ الشَبابِ عَصرَ حانَ مَشيبُ",3,"ب",1,1],["طَحطَحتَ بِالخَيلِ الجِبالَ مِنَ العِدى","وَالكُفرُ يَقعُدُ بِالهُدى وَيَقومُ",4,"م",1,0],["طَحَا بِكَ مِن مُسَيْلَمةٍ خَبالٌ","فلا رَسَنٌ يُرَدُّ ولا زِمامُ",5,"م",1,0],["طَحورانِ عُوّارَ القَذى فَتَراهُما","كَمَكحولَتَي مَذعورَةٍ أُمِّ فَرقَدِ",6,"د",1,0],["طحنت طحن الرّحى من قبلنا أمما","شتّى، ولم يدر خلق أيّة سلكوا.",7,"ك",3,0],["طحنت فريقيها الحروب بضرسها","لا غالبًا رحَمتْ ولا مغلوبا",8,"ب",2,0],["طحى حدثان الدهر للفضل هضبة","وكانت بها هضب المكارم تدعم",9,"م",1,0],["طحى حدثنا الدهر للفضل هضبة","وكانت بها هضب المكارم تدعم",10,"م",1,0],["طَحَنَتهم ونارُها خَبَزَتهم","لِلعَوافي والطير منهم غذاءُ",11,"ا",2,0],["طَحَنَتْهُمُ أَضْرَاسُهُ طَحْنَ الرَّحَى","مَرَّتْ عَلَى يَبِسِ الْحَصِيدِ وَهَشِّهِ",12,"ش",2,0],["طحنتهم سنوات عجف","صار فيها الكل منهم لشفا",13,"ف",2,0],["طَحت شمسُها إِثرَ الشروقِ فَغادَرَت","أَهلّةَ مجدٍ لم يتمّ اِقتِباسها",14,"س",3,0],["طَحُون كمُلقى مِبرَدِ القين فَعمَةٌ","بجرعَاء مِلحٍ أو بجَوِّ نطاعِ",15,"ع",1,0],["طحَا بك بُعدٌ لا قرابةَ بعده","مسافةَ مقطوع المدَى غَلِقِ الرهنِ",16,"ن",1,0],["طحنتهم منه الرحى حين دارت","ثم جاءت بهم مجيء السيول",17,"ل",1,0],["طَحَنَتهُم أَرحاؤُها بِطَحونِ","ذاتِ ظُفرِ حَديدِةِ الأَنيابِ",18,"ب",1,0],["طحنت رحى بدرٍ لمهلِكِ أهلِهِ","ولمثلِ بدرٍ تستهلُّ وتدمَعُ",19,"ع",1,1]]}