{"poems":[[55,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[55,"لعمرك ما جر ذيل الفخار","https://www.aldiwan.net/poem29861.html","المتقارب"],[55,"نزوت نزاء الجندب الجون ضلة","https://www.aldiwan.net/poem30696.html","الطويل"],[65,"سرت وجنح الليل غربيب","https://www.aldiwan.net/poem46147.html","السريع"],[3,"ويمنعنا من كل ثغر نخافه","https://www.aldiwan.net/poem157.html",""],[85,"ما أملح مه فصل الربيع","https://www.aldiwan.net/poem54198.html","مجزوء الرجز"],[53,"أبا علي للناس ألسنة","https://www.aldiwan.net/poem65409.html","المنسرح"],[31,"ألا حييا دارا لأم هشام","https://www.aldiwan.net/poem6085.html","الطويل"],[93,"هجرت القوافي ما بنفسي ملالة","https://www.aldiwan.net/poem9055.html","عموديه"],[87,"أعدت الراحة الكبرى لمن تعبا","https://www.aldiwan.net/poem63781.html","البسيط"],[51,"أذل الحرص والطمع الرقابا","https://www.aldiwan.net/poem10327.html","الوافر"],[82,"متى صدرت عيناك عن أرض بابل","https://www.aldiwan.net/poem31321.html","الطويل"],[70,"ما بين معترك الأحداق والمهج","https://www.aldiwan.net/poem1488.html",""],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9925","الطويل"],[119,"عقول الورى تاهت بسلطانك الأعلى","https://www.aldiwan.net/poem42204.html","الطويل"],[131,"إذا أنا وافاني حمامي ومضجعي","https://www.aldiwan.net/poem24258.html","الطويل"],[139,"إزي حال صدقي وحال بور سعيد","https://www.aldiwan.net/poem48845.html","المواليا"],[147,"لي بامتداحك عن ذكر الهوى شغل","https://www.aldiwan.net/poem11803.html","البسيط"],[147,"محلك من محل الشمس أعلا","https://www.aldiwan.net/poem11806.html","الوافر"],[190,"الناس كانوا وكان الحسن زينتهم","https://www.aldiwan.net/poem43229.html","البسيط"],[203,"لغيري الدهر سلم","https://www.aldiwan.net/poem45393.html","المجتث"],[244,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[285,"أما والهوى يوم استقل فريقها","https://www.aldiwan.net/poem60780.html","الطويل"],[309,"هواكم بقلبي والفؤاد مقيم","https://www.aldiwan.net/poem16821.html","الطويل"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[354,"هب منطقي سمعك يا وهب","https://www.aldiwan.net/poem15536.html","السريع"],[376,"فلما دعتني صروف الزمان","https://www.aldiwan.net/poem57298.html","الطويل"],[382,"بشراك بشراك قد أدناكم النائي","https://www.aldiwan.net/poem66985.html","البسيط"],[409,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[447,"إليك صبت أفيدتنا ولاها","https://www.aldiwan.net/poem14392.html","الوافر"],[463,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[463,"يا دار لا أنهج القشيب","https://www.aldiwan.net/poem56284.html","مخلع البسيط"],[505,"سر واترك العيس على حالها","https://www.aldiwan.net/poem37551.html","السريع"],[505,"من كان عبدا لقوم فليوف بهم","https://www.aldiwan.net/poem38072.html","البسيط"],[510,"القضيّة","https://www.aldiwan.net/poem27792.html","البسيط"],[520,"كن لي على شكر ما أوليت من نعم","https://www.aldiwan.net/poem12253.html","البسيط"],[563,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[563,"كل أناس لهم لغات","https://www.aldiwan.net/poem34724.html","مخلع البسيط"],[580,"كجسمك جسمي أصبح اليوم بالياً","https://www.aldiwan.net/poem2768.html","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137711",""],[848,"","https://poetry.dctabudhabi.ae/diwan/poem/49899","الرجز"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99988","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71005","السريع"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96306","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120045","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49924","البسيط"],[288,"","https://poetry.dctabudhabi.ae/diwan/poem/200302","الطويل"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67412","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124720","السريع"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131326","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27947","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93541","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129910","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87339","الطويل"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107174","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58322","السريع"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11349","الوافر"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145061","الوافر"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26112","الطويل"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46978","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123943","الطويل"],[3605,"","https://poetry.dctabudhabi.ae/diwan/poem/130569","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91922","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92039","الطويل"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103792","المنسرح"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59483","الوافر"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95326","الرجز"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35520","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111421","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77089","الطويل"],[4077,"","https://poetry.dctabudhabi.ae/diwan/poem/198904","المتقارب"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123499","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94412","الطويل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116059","البسيط"],[4755,"نَأَت عَن ظِلِّكَ الأَرضُ المُتَاحَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=195172",""],[4782,"يقينٌ بنكهة الوهم","https://www.poetsgate.com/ViewPoem.aspx?id=198687",""],[1663,"الى امرئ نصبت قحطان رايتها","https://www.poetsgate.com/ViewPoem.aspx?id=93229",""],[4896,"في وجه العدوان","https://www.poetsgate.com/ViewPoem.aspx?id=180880",""],[585,"صوتٌ تجاوب بين الهمس والعلن","https://www.poetsgate.com/ViewPoem.aspx?id=161884",""],[5264,"جمرك البيوع","https://www.poetsgate.com/ViewPoem.aspx?id=180076",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5431,"وجودك خُلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=189747",""],[5431,"وربك رزاق العباد وكافلُ...","https://www.poetsgate.com/ViewPoem.aspx?id=199915",""],[5447,"سليمى","https://www.poetsgate.com/ViewPoem.aspx?id=208383",""],[5493,"ينادي الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=197641",""],[5544,"عمان اسعدي","https://www.poetsgate.com/ViewPoem.aspx?id=213441",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5830,"كَتبْتُ شِعْرِيَ","https://www.poetsgate.com/ViewPoem.aspx?id=201124",""],[5910,"في هجاءِ شيخٍ كذوبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=206235",""],[5956,"شَعْبِيَّةُ المَرْتَبة *","https://www.poetsgate.com/ViewPoem.aspx?id=183665",""],[5956,"النِّيلُ في قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=184947",""],[3099,"أبا بشرٍ تطاولَ بي العتابُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59188&r=&rc=12",""],[4222,"يروقني في المها مهفهفها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52844&r=&rc=136",""]],"verses":[["وَكُلُّ سائِمَةٍ باتَت تُمَسِّحُها","كَفُّ المُسيمِ غَدَت لَحماً عَلى وَضَمِ",0,"م",1,0],["وَكُلُّ سُرورٍ أَرى أَنَّهُ","خِضابٌ عَلى لِمَّتي ناصِلُ",1,"ل",1,0],["وَكُلُّ سِنانٍ طالِعٍ فَوقَ ضامِرٍ","كَما حامَ زُنبورٌ عَلى ظَهرِ عَقرَبِ",2,"ب",1,0],["وكلُّ سِرٍّ رُمْنَ كِتْمانَهُ","نَمَّ بهِ الحَلْيُ أوِ الطّيبُ",3,"ب",1,0],["وَكُلُّ سَبوحٍ في الغُبارِ كَأَنَّه","إِذا اِغتَسَلَت بِالماءِ فَتخاءُ كاسِرُ",4,"ر",1,0],["وكل سلطان قد ملك","يتمن هو تقبيل اديه",5,"ه",1,0],["وكل سهمٍ رمت يداي به","فليس إلا في مقتلٍ يقع",6,"ع",1,0],["وَكُلُّ سِماكِيٍّ كَأَنَّ نَشاصَهُ","إِذا راحَ أُصلاً جافِلاتُ نَعامِ",7,"م",1,0],["وَكُلُّ سُرورٍ غَيرَهُنَّ كَآبَةٌ","وَكُلُّ نَشاطٍ غَيرَهُنَّ خُمولُ",8,"ل",1,0],["وَكُلُّ سَعيٍ سَيَجزي اللَهُ ساعِيَهُ","هَيهاتَ يَذهَبُ سَعيَ المُحسِنينَ هَبا",9,"ب",2,0],["وَكُلُّ سَلامَةٍ تَعِدُ المَنايا","وَكُلُّ عِمارَةٍ تَعِدُ الخَرابا",10,"ب",2,0],["وَكلُّ سَفينٍ تَحرثُ الماءَ عُوّماً","إذا هي شَقّتْ لُجّةً بالكلاكِلِ",11,"ل",1,0],["وكُلِّ سَمعٍ عن اللاحي به صَمَمٌ","وكلِّ جَفنٍ إلى الإِغفاء لم يَعُجِ",12,"ج",1,0],["وَكُلُّ سَبوحٍ في الغُبارِ كَأَنَّها","إِذا اِغتَسَلَت بِالماءِ فَتخاءُ كاسِرُ",13,"ر",1,0],["وكل سرحا العجز عن درك سرك ال","خفي وعن تعريف مضمونه ضلا",14,"ل",2,0],["وَكُلُّ سِنانٍ في الأَنامِ وَلَهذَمٍ","وَمَسرودَةٍ وَجداً عَلَيَّ تَذوبُ",15,"ب",1,0],["وكل ساعه في بلاوي وقرف","وغلب أزرق والنكد والفلسْ",16,"س",1,0],["وَكُلُّ سَلهَبَةٍ أَنتَ الكَفيلُ لَها","أَلّا يُصابَ لَها في غارَةٍ كَفَلُ",17,"ل",1,0],["وَكُلُّ سِعايَةٍ أَعرَضتَ عَنها","كَأَنَّكَ سامِعٌ في الجودِ عَذلا",18,"ل",2,0],["وكل سوء ومكروه والفهم خلفا","وما منهم في الخير سلطان",19,"ن",1,0],["وكلُّ سهلٍ إذا لم","يوفقِ اللهُ صعبُ",20,"ب",1,0],["وكل سرور سوف يعقب غصة","وكل خصيب في البسيطة يجدب",21,"ب",1,0],["وَكُلُّ سُيُوفِ الْهِنْدِ لِلْقَطْعِ آلَةٌ","وَأَقْطَعُها يَوْمَ الْجِلادِ رَقيقهُا",22,"ق",3,0],["وكل سرور قد خلا عن وصلكم","فما هو إلا ترحة وغموم",23,"م",1,0],["وكل سبيل ليس يفضي سلوكه","إلي فقد أفضى إلى كل خيبة",24,"ه",1,0],["وَكُلُّ سَحّارٍ بِسِحري أَتى","مِن شيعَةِ الرُسُلِ لَهُ حِزبُ",25,"ب",1,0],["وكلٌّ سِواهُ عَلى قَولِها","يَقولُ وينظُرُ مِن طَرفِها",26,"ف",3,0],["وكل سَمعٍ يكذبْهُ بِهِ صَمَمٌ","كَأَنَّهُ جاءَ مَحشوّاً ببَلواءِ",27,"ا",2,0],["وكل سوف يلقى ما جناه","إذا ما صار في بطن الرجام",28,"م",1,0],["وكل سواك معبود ضلال","وبئس بعابد أشيا يراها",29,"ا",3,0],["وكلُّ سامٍ رامٍ بهمّتهِ","يرَى مديحي كما يَرى العُصُما",30,"م",2,0],["وكلُّ سعيٍ له كَسوبٍ","تَغرمَهُ كفُّه الوهوبُ",31,"ب",1,0],["وكلِّ سرٍّ محكم نصُّه","تلاه داعي الحبِّ والوجد ثار",32,"ر",1,0],["وكلُّ سرٍّ لطيفٍ من مُحاضَرَةٍ","ضمنَ الصُّدورِ ولم نُسْنَدْ إِلى الكُتُبِ",33,"ب",1,0],["وكلُّ سيّارةٍ مرّت بها سُئلتْ","فعلّ ركباً إلى البلادِ مُنطلِقُ",34,"ق",1,0],["وكل سابغة المضمار ما برحت","آذانها في الوغى تغني عن اللجم",35,"م",1,0],["وكل ساق وكل كاس","وكل خمر وكل حان",36,"ن",1,0],["وكل سر له ظهور","وكل ليل له سراة",37,"ه",1,0],["وكل سهم له مصاب","وكل قوس له رماة",37,"ه",1,0],["وكلُّ سُرورٍ صار بَعْدَك تَرْحَةً","وكلُّ بشيرٍ صَارَ عنديِ نَاعِيَا",38,"ي",2,0],["وكل سبا كل طرف بطرفه","وأورد أبدع وصف بوصفه",39,"ف",2,1],["وكل سُلَّم رَفيع نصبا","جُرَّ إِلى السور وَمنهم سُلِبا",40,"ب",2,0],["وكُلُّ سَناءٍ مِنْ طَرِيفٍ وتَالِدٍ","إلَيْكَ مُشِيرٌ بَلْ عَلَيْكَ دَلِيلُ",41,"ل",1,0],["وكلُّ سُبروتٍ كساه الحيا","برودَ وشْىٍ رائقاتِ العيون",42,"ن",1,0],["وكل سنا برق أضاءَ ومَغربٍ","من الشمس وافى جنحَ ليلٍ أوائله",43,"ل",2,0],["وكل سابقة الأذيال تحسبها","من النبال غديرا وهو ممطورُ",44,"ر",1,0],["وكل سنٍّ منهما لأحرفِ","كالوجه والعرض وصدر قد قفي",45,"ي",1,0],["وكلَّ ساحبةٍ ذيل الازارِ على","فعم المخلْخل غضٍ غير منهوبِ",46,"ب",1,0],["وكُلِّ سبُوحٍ في العِنَانِ مُقَلِّص","كسِرْبِ القَطَا يَحْمِلْن مَجْداً وسُؤْدَدَا",47,"د",2,0],["وَكُل سَلُولِيَّ إذا مَا لَقِيتَهُ","سَرِيعٌ إلى دَاعي الْعُلاَ وَالمَكَارِمِ",48,"م",1,0],["وكل سبعٍ سؤره مفسدٌ","ومسه محضوضلَ الشعر",49,"ر",1,0],["وكُلّ ساعٍ قد تعالى عن مِثَالْ","فيه الثُّرَيّا أَشرقتْ مثلَ الهِلاَلْ",50,"ل",1,0],["وكلُّ ستر فمجموعٌ ويشهد لي","أجزاؤه ثم لا تأتي تمزقه",51,"ق",2,0],["وَكُل سَطر عَلى جَيش العَدوّ غَدا","أَشَدَّ مِن أَلف طعّان وَضراب",52,"ب",1,0],["وكلّ سبت بها عيد تعود به","أمالهم وبه الزلّاتُ تغتفَرُ",53,"ر",1,0],["وكلُّ سريعاتِ المسير آهتَدُوا بهَا","إذا كانَ في غَربٍ وآخَرُ طَالِع",54,"ع",1,0],["وكلٌّ سَعى لِلمَجدِ مِن نَهجِ سَعيكُم","وكلٌّ بِنَهجِ الفَضلِ مِن فَضلِكُم سارِي",55,"ر",2,0],["وَكُل ساكوس قمارِ وقد","أجادَ بالعفقِ بها مهره",56,"ر",2,0],["وَكُلٌّ سَوفَ يُنشَرُ غَيرَ شَكٍّ","وَيَحمِلُهُ لِطَيَّتِهِ الكِتابُ",57,"ب",1,0],["وكل سفارة لك فهي بشرى","فأهلا بالسفارة والسفير",58,"ر",1,0],["وَكُلِ سِماكيٍّ يَجولُ رَبابُهُ","مرته الصَبا في الدَجنِ حَتّى تَحَلّبا",59,"ب",2,0],["وَكُلُّ سِلاحِ الحَرْبِ بَادٍ غَناؤُهُ","ولَكِنْ لِمَعْنىً أُوثِرَ الصارِمُ الهِنْدِي",60,"د",2,0],["وكل سعى نحو الحقيقة جاهداً","ولكنما الغايات كانت إلى الوهم",61,"م",1,0],["وكل سلطان له أيام","قدرهن الملك العلام",62,"م",1,0],["وَكُلٌّ سرابٌ تَراه كَما","وَلَست تَراه يبل العطش",63,"ش",1,0],["وَكُل سحابٍ قَلا تلاشته صرصرٌ","تداولها عنا السوافي فتقشع",64,"ع",1,0],["وكل سهم اذا انتحى غرضا","وكل شهم اذا علا منبر",65,"ر",1,0],["وكلِّ سميدعٍ شهمٍ أبيٍ","يدقُّ لعزمه الخطبُ الجليلُ",66,"ل",1,0],["وكلّ سيفي وكذاك بصرى","أيضاً كُلولا كِلَّة في المصدر",67,"ر",1,0],["وَكلّ سُرَيجيّ إِذا اِبتَزَّ غِمدَهُ","تَعوَّض مِن هام الكُماةِ لَهُ غِمدا",68,"د",2,0],["وَكُلُّ سُرورٍ وَإِن طَمَحا","لَهُ المَرءُ فَوقَ شُرورِ الوَحى",69,"ح",2,0],["وكُلُّ سَيِّدِ قَومٍ قامَ مُنفَرِداً","بِهِم كَرَاعٍ بما يَستاقُ مُنفَرِدِ",70,"د",1,0],["وَكُلُّ سَماءِ صَح فيها لَهُ مِن","الزبر جدو الياقوت قَد ضَرَبَت عَمد",71,"د",1,0],["وكلّ سرور بها نافد","وكلّ مقيم بها لارتحال",72,"ل",1,0],["وكل سر لا عنه يسرى","فنقمة كله وشر",73,"ر",1,0],["وكُلُّ سؤالٍ جاءَهُ من مؤَمِّلٍ","يجىءُ من التَبشير أشهى وألطفا",74,"ف",2,0],["وكلِّ سَلهَبَةٍ للريحِ نِسبتُها","لكنّها لو بَغَتها الرِّيحُ لم تُنَلِ",75,"ل",1,0],["وكُلُّ سَحَابَةٍ ظَمَأٌ جَديدٌ","وقَلبُكَ لَم يَعُد يَكفِي جِرَاحَهْ",76,"ح",2,0],["وكل سُهْدٍ لوى أعطافَ خارطتي","وكل صدقٍ سرى بالوجد منصدعُ",77,"ع",1,0],["وكل ساع إذا يسعى لهمته","فقد يساعده في سعيه البوس",78,"س",1,0],["وكل ساكنها أجناد معركة","وطفلها في الوغى ينقض كالشهب",79,"ب",1,0],["وكل ساحبةٍ للذيل فاجرةٍ","وكل ممعنةٍ في الدس والفتن",80,"ن",1,0],["وكل سفيه منهم غير ذات موضوع","قاعد على قلبنا وف عنينا دموع",81,"ع",1,0],["وكل سوف يؤتى يوم حشر","كتاباً باليمين أو الشمال",82,"ل",1,0],["وكلّ سراديب البقاء عقيمةٌ","وكلّ تسابيح الخلاص تُحجّبُ",83,"ب",1,0],["وكلّ سبيلٍ للرغائبِ ناقصٌ","وكل امتثالٍ للمكارم كاملُ",84,"ل",1,0],["وكلُّ سلاحِ سلمى نصلُ قولٍ","ويرمي في الفؤاد وليس يُرمى!",85,"م",2,0],["وكل سحاب يمر بفيضٍ","من الخير إلا سحابَ الأثيمِ",86,"م",1,0],["وكلٌّ سيفنا غير أن فناءنا","عزيز مدى الأيام لا يقبل النقدا",87,"د",2,0],["وكلُّ سعْي وهمٍّ في شوارعها","يُنبيك كيْف خُطى الإنسانِ تُزدردُ",88,"د",1,0],["وَ كُلُّ سَعْيٍ لِغَيْر اللهِ مَتْلَفَةٌ","وَ كُلُّ جُهْدٍ بُدُونِ اللهِ يُزْرِيهِ",89,"ي",2,0],["وكلُّ سبيلٍ للغواية منقضٍ","بآيةِ شرٍّ ينثني منه صاحبُهْ",90,"ب",2,0],["وكلُّ سجينٍ في التَّنَقُّمِ سابحاً","ولكنَّ قلبي في غرامِ أقاربي",91,"ب",2,0],["وكل سحاباتٍ تمر بأفْقِهِ","بقايا دموعٍ من جَوَايَ تنازِعُ؟",92,"ع",1,0],["وكلٌّ سوفَ ينشرُ غيرَ شكٍّ","ويحماهُ لطيَّتهِالكتابُ",93,"ب",1,0],["وكل سوق للفضل كاسدة","بان لأعدائه تحيفها",94,"ف",3,0]]}