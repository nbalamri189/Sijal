{"poems":[[88,"بلابل وادي النيل بالمشرق اسجعي","https://www.aldiwan.net/poem68896.html","الطويل"],[84,"سرى والحب أمر لا يرام","https://www.aldiwan.net/poem29415.html","الطويل"],[11,"كريم لا أبيت الليل جاد","https://www.aldiwan.net/poem229.html",""],[53,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[53,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[91,"في الصدر حتى كدت تردى","https://www.aldiwan.net/poem44868.html","مجزوء الكامل"],[47,"أأفاق صب من هوى فأفيقا","https://www.aldiwan.net/poem65176.html","الطويل"],[47,"أما الخيال فإنه لم يطرق","https://www.aldiwan.net/poem65181.html","الكامل"],[82,"أيا مولي الصنع الجميل إذا انتشى","https://www.aldiwan.net/poem31505.html","الطويل"],[107,"أأفاق ظالم نفسه فأنابا","https://www.aldiwan.net/poem43091.html","الكامل"],[53,"لعمري لقد سهَّلْتَ ما ليس بالسهل","https://www.poetsgate.com/ViewPoem.aspx?id=30292",""],[159,"سألت من شفني هواه ومن","https://www.aldiwan.net/poem55558.html","المنسرح"],[353,"أأفرح بابن أتى والمشي","https://www.aldiwan.net/poem20110.html","المتقارب"],[500,"تعالى الله ما شاء","https://www.aldiwan.net/poem10277.html","الهزج"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122568","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96687","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96716","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96655","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96705","الوافر"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69200","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204710","الطويل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97991","الوافر"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86573","الطويل"],[4168,"","https://poetry.dctabudhabi.ae/diwan/poem/123830","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73183","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83630","الكامل"],[4501,"","https://poetry.dctabudhabi.ae/diwan/poem/143300","الرجز"],[4691,"بدر يسكن في بدر","https://www.poetsgate.com/ViewPoem.aspx?id=94080",""],[5582,"أَرَسْماً تَرَى أَمْ ذاكَ رَجْعُ وِشامِ","https://www.poetsgate.com/ViewPoem.aspx?id=63569",""],[5582,"أعذّالي أعذّالي","https://www.poetsgate.com/ViewPoem.aspx?id=63558",""],[5582,"بريقٌ لاحَ مُؤْتَلِقَا","https://www.poetsgate.com/ViewPoem.aspx?id=63542",""]],"verses":[["أَأَفضى إِلى خَتمِ الزَمانِ فَفَضَّهُ","مِنَ الوَحيِ وَالإِلهامِ أَم قَولُ لَوذَعي",0,"ع",2,0],["أأفقده فلا أبكي عليه","يكون ارق من قلبي الحمام",1,"م",1,0],["أَأَفضَحُ جارَتي وَأَخونُ جاري","مَعاذَ اللَهِ أَفعَلُ ما حَيِيتُ",2,"ت",1,0],["أأُفجعُ بالشباب ولا أُعزَّى","لقد غَفَل المُعزِّي عن مُصابي",3,"ب",2,0],["أأفضتْ بيَ الأيامُ لا درَّ درُّها","إلى ما ترى عيني من الهُون والأزلِ",4,"ل",1,0],["أافلن ام قام العمى","بيني وبين النجم سدا",5,"د",2,0],["أَأَفاقَ صَبٌّ مِن هَوىً فَأُفيقا","أَم خانَ عَهداً أَم أَطاعَ شَفيقا",6,"ق",2,1],["أَأُفيقُ مِن شَجَنٍ لِعَقلِيَ خابِلٍ","وَأَصُدُّ عَن سَكَنٍ بِقَلبِيَ مُلصَقِ",7,"ق",1,0],["أأفرد بالحرمانِ من كلّ عاطلٍ","تَطَوّقَ من نعماك ثم توشّحا",8,"ح",2,0],["أَأَفاقَ ظالِمُ نَفسِهِ فَأَنابا","وَرَأى المَحَجَّةَ مُخطِئٌ فَأَصابا",9,"ب",2,1],["أأفضتْ بيَ الأيامُ درَّ درُّها","إلى ما ترى عيني من الهُون والأزلِ",10,"ل",1,0],["أَأَفْطَرَ النَّاسُ قالَ مُبْتَسِماً","زِيدَ عَلَيْهِمْ في صَوْمِهِمْ يَوْمُ",11,"م",1,0],["أَأَفرَحُ بابنِ أتى والمَشي","بُ بَيَّضُ فَوْدِىَ بَعْدَ السَّوَادِ",12,"د",1,1],["أأفريدون في التاج","أم الاسكندر الثاني",13,"ن",2,0],["أأفرَحُ بالسُّلُوِّ وقد دعتني","دواعي الحُبِ ما لك من بَراح",14,"ح",1,0],["أأَفخر من رقي العليا","وَمَن هوَ بالعهودِ وفا",15,"ف",2,0],["أأفخر مَن للضيفِ سنّ القِرى ومن","تلثّم مِن نسجِ الوغا بلثامِ",16,"م",1,0],["أَأفخرُ من علا وتحاسدتهُ","عَلى الإجلالِ سرج أو سريرُ",17,"ر",1,0],["أَأفضل مَن بهِ وجدت","وَخبّت كلّ مرقالِ",18,"ل",1,0],["أَأَفني الحَياةَ عِفَّةً وَتجلدا","بِعافيَة أَم أَستَكين فَأَهلَع",19,"ع",1,0],["أأفنى ويبقى الشعر بعدي خالدا","وأشقى ويحظى بالسعادة تذكاري",20,"ر",2,0],["أأفئدة النساء من القلوب","الخدع الغلف",21,"ف",1,0],["أأفعال عبد اللَه توجب فتنةً","يسيل بها غيث من الدم مسكوب",22,"ب",1,0],["أأفاق حين وطئت ضيق خناقه","يبغي الأمان وكان يبغي صارما",23,"م",2,1],["أَأَفوزُ من أَسرِ الهوى بخَلاصِ","كيفَ المناصُ ولاتَ حيِنَ مَناصِ",24,"ص",1,1],["أَأَفِرّ منهُ إلى سِواه جهالَةً","وَبذيل رَحمَته دوام تعلُّقي",25,"ق",2,0],["أأفنى في محبتهم","وطيب محبتي عبق",26,"ق",1,0],["أأفتتح المفاتن دون طعن","وهل يكفيك شر القتل شعرُ",27,"ر",1,0],["أَأَفْخَرَ مَنْ لِلضَّيْفِ سَنَّ القِرَى وَمَنْ","تَلَثَّمَ مِنْ نَسْجِ الوَغَى بِلِثامِ",28,"م",1,0],["أَأَفْضَلَ مَنْ بِهِ وَخَدَتْ","وَخَبَّتْ كُلُّ مِرْقالِ",29,"ل",1,0],["أَأَفْخَرَ مَنْ تَبَطَّنَ بِال","يَدِ الأَقْلامَ وَاعْتَنَقَا",30,"ق",2,0]]}