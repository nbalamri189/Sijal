12,"لقد دارت على رغم الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=124956",""],[4858,"سلام الضعفاء","https://www.poetsgate.com/ViewPoem.aspx?id=34883",""],[4927,"شيخ الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=4577",""],[4927,"هَاْتِفُ الْحُبّ","https://www.poetsgate.com/ViewPoem.aspx?id=29732",""],[4984,"يَوْمُ الْاسْتِقْلَالِ","https://www.poetsgate.com/ViewPoem.aspx?id=204988",""],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[5120,"ابْتِسَامَةُ شَمْس","https://www.poetsgate.com/ViewPoem.aspx?id=184373",""],[5216,"عَبَرْنا لِلْخُلود","https://www.poetsgate.com/ViewPoem.aspx?id=186939",""],[592,"يا طالب العلم الشريف الأقوم","https://www.poetsgate.com/ViewPoem.aspx?id=128811",""],[5348,"لا لوم علينا","https://www.poetsgate.com/ViewPoem.aspx?id=59574",""],[5397,"تخادعك الدنيا وتبدي اغترارها","https://www.poetsgate.com/ViewPoem.aspx?id=157907",""],[5425,"شَوْقٌ ، أَمْ حَسَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=198953",""],[5508,"جدَّ الصبَّا في أباطيل الهوى لعب","https://www.poetsgate.com/ViewPoem.aspx?id=110820",""],[5582,"أَمُوسِعَةً بِمُهْجَتِيَ الصُّدُوعا","https://www.poetsgate.com/ViewPoem.aspx?id=187177",""],[5582,"دَعاهُ يَعُجْ فِي حُبِّهِ لِمَعاجِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63476",""],[5720,"لأجلكَ أُستاذي","https://www.poetsgate.com/ViewPoem.aspx?id=199596",""],[5906,"رسول وآل","https://www.poetsgate.com/ViewPoem.aspx?id=188071",""],[5986,"أيا عترة المختار والسادة الطهر","https://www.poetsgate.com/ViewPoem.aspx?id=162956",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[463,"من الغادي تحطُّ به وتعلو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60007&r=&rc=63",""],[6346,"مشنقة الحروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83387&r=&rc=3",""]],"verses":[["وَقادَتني لِإِنسانٍ","يَرى قَتلي مِنَ الغُنمِ",0,"م",1,0],["وقادَ لكَ الإلاهُ خفيَّ لُطْفٍ","يُبلِّغُ مجْدَكَ الأعْلى اخْتِيارَهْ",1,"ه",1,0],["وقادوا إليْكَ المُلْكَ رِفْقاً بخَلْقِهِ","وقد عدِموا رُكْنَ الإمامةِ واضْطَرّوا",2,"ر",3,0],["وقادَني نحْوَكُمْ غَرامٌ","يُهيجُ أشْواقَهُ ادِّكارُ",3,"ر",1,0],["وقادَ الى إصْراخِهِ كُلَّ سابِحٍ","مُعوّذَةٍ أنْ لا تُحَطَّ لُبودُهُ",4,"د",2,0],["وَقادَنِيَ الهَوى فَاِنقَدتُ طَوعاً","وَما مَكَّنتُ غَيرَكَ مِن قِيادي",5,"د",2,0],["وَقَادَ في سُبُلِ الْعَلْيَاءِ أُمَّتَهُ","وَرَاضَهَا في مَرَاسِ الْدَّهْرِ بِالْغَلَبِ",6,"ب",1,0],["وَقادَ شَيخَهُما قَسراً لِبَيعَةِ مَن","قَد كانَ بايَعَهُ في ظِلِّ دَوحاتِ",7,"ت",1,0],["وَقَادت قِلاصَ الرَكبِ وَجنآءُ حُرَّةٌ","وَسوجٌ إِذا اِنضَمَّت حَشاها قُتودُها",8,"د",3,0],["وَقادوا المُؤمِنينَ وَلَم تُعَوَّد","غَداةَ الرَوعِ خَيلُهُمُ القِيادا",9,"د",2,0],["وقاد إليها الحبَّ فانقاد صعبه","بحُبّ من السِّحر الحلال التحببُ",10,"ب",1,1],["وَقادَ إِلى أَرضِ السَبَكرِيِّ جَحفَلاً","يُسافِرُ فيهِ الطَرفُ حينَ يُسافِرُ",11,"ر",1,0],["وَقادَ نَدي بنُ جَعفَرَ مِن عُقَيلٍ","شُعوباً قَد أَسالَ بِها الشِعابا",12,"ب",2,0],["وَقادَهُ لِلمَوضِعِ المَعروفِ","فَقامَ بَينَ الظَبيِ وَالخَروفِ",13,"ف",1,0],["وَقادَ لَها دِلَّيرُ كُلَّ طِمِرَّةٍ","تُنيفُ بِخَدَّيها سَحوقٌ مِنَ النَخلِ",14,"ل",1,0],["وَقاد دَعا ناهِياً فَأَسمَعَني","وَخطٌ عَلى الرَأسِ مُخلِسٌ شَعَرُه",15,"ر",2,0],["وقادَ الخيلَ قُبّاً يَقتضيها","ذخيرةَ جُهْدِها أو يستزيدُ",16,"د",1,0],["وَقادَ آلافاً مِنَ الضَلالِ","يُعِدُّهُم لِلحَربِ وَالقِتالِ",17,"ل",1,0],["وَقادَ لي حَبيبي","وَلَم يَكُن ثَقيلا",18,"ل",2,0],["وَقادَ مُكَلِّبُنا ضُمَّراً","سَلوقيَّةً طالَما قادَها",19,"د",3,0],["وَقادوا كُلَّ سَلهَبَةٍ سَبوحٍ","كَأَنَّ أَديمَها شَرِقٌ بِراحِ",20,"ح",1,0],["وَقادَني حُبُّ ريمٍ","مُهَفهَفِ الكَشحِ رودِه",21,"د",2,0],["وقادَ الجيوشَ لفتحِ البلادِ","ودقَّ لقهرِ العدى فحصهُ",22,"ص",2,0],["وَقادوني إِلى مَلِكٍ كَريمٍ","رَفيعٍ قَدرُهُ في العِزِّ راقي",23,"ق",2,0],["وقادةُ العرب سلّوا السيف..وارتجزوا","يا أمَّةَ العرب سُلي السيف..واقتتلي!",24,"ل",2,0],["وقاد إلى أصراخه كل سابح","معوده ألا تحط لبوده",25,"د",2,0],["وقادها وعماء لا يبرّهم","فعل وأقوالهم أقوال أبرار",26,"ر",1,0],["وقادة أقطاب وأقطاب قادة","وأكرم أخيار وخير كرام",27,"م",1,0],["وَقّادَةٍ حَتّى يَحينَ غُروبُها","فَتَغيبَ بَينَ تَرائِبِ الفُرسانِ",28,"ن",1,0],["وقاد إلى القواد جردا كماتها","شباب تعادى فوقها وكهول",29,"ل",1,0],["وَقادَ إِلَيهِ الناسَ بَأسٌ وَرَغبَةٌ","وَعِزٌّ يُناصي يَذبُلاً وَيَلملَما",30,"م",2,0],["وَقادَها لِتَمامِ العَشرِ تَحسِبُها","آذِيَّ بَحرٍ زَفَتهُ الرِيحُ مُلتَطِمِ",31,"م",1,0],["وَقادَ جِيادَ الخَيلِ قُبّاً عَوابِساً","عَلَيهِنَّ فِتيانٌ مَصاليت شُجعانُ",32,"ن",1,0],["وَقّاد ذهنٍ إذا جالت قريحتهُ","يَكادُ يُخشى عليه من تلهّبهِ",33,"ب",2,0],["وقاد إلى أَعدائه كُلَّ جَحْفَلٍ","تُلين مذاكِيه بأَرجلها الصخرا",34,"ر",2,0],["وقاد الخيلَ واعتقل العوالي","وخافته التهائم والنُّجُود",35,"د",1,0],["وقاد إليك الجيش من ظنه بهم","جبالاً فأمست عند لقياك كالمهن",36,"ن",1,0],["وَقادَ إلَى هَوَاها القَلْبَ قَهْراً","فَأَصْبَحَ في يَدَيْهَا القَلْبُ عَانِ",37,"ن",1,0],["وَقَادَ إِلى الأَعَادِي كُلَّ جَيْشٍ","تَقُودُ إِلَيْهِ رَهْبَتُهُ الدِّيارا",38,"ر",2,0],["وَقادَتكَ المَعاصي حَيثُ شاءَت","وَأَلفَتكَ اِمرَءاً سَلِسَ القِيادِ",39,"د",1,0],["وقادَ فيها فَسادَ واتَّسع الر","رِزقُ علَيه فبيتُه عامِر",40,"ر",1,0],["وقادوا الحائدين إلى هُداءٍ","ولما اندقَّ طودُ الكفر مالا",41,"ل",2,0],["وقاد طعام الشام من كل وجهة","يقاتل بغياث كل بَرٍّ وخَيِّر",42,"ر",1,0],["وَقادَني نَحوه التَوفيقُ ثُمَّ دَعا","هَذا الطَريق إِلى العَلياء فاِستَقِمِ",43,"م",1,0],["وقادها شوقها لاسوقها فغدت","تغلي الفلا بين إدخالٍ وتوخيد",44,"د",1,0],["وقادَ نحوَكَ والتَّوْفِيقُ يَقْدُمُهُ","جيشاً من الذُّلِّ مِلْءَ السهل والجبلِ",45,"ل",1,0],["وقادَ لحبلِ الرِّقِّ نحوكَ نَفْسَهُ","فلاقاكَ مُمْتَنّاً ووافاكَ مُنْعِما",46,"م",2,0],["وقادَهُمُ الكتابُ إِلَى مليكٍ","تقاضاهُمْ ليمناه القضاءُ",47,"ا",2,0],["وقَادِمَةُ الجوزاءِ راعَيْتُ مَوْهِناً","بحَرِّ هواكِ أَم تَرَسَّمْتُ دَارَكِ",48,"ك",1,0],["وقادة اليوم لا شيء يحركهم","حتى ولو مرغوا في الوحل واختضبوا",49,"ب",3,0],["وقاد قلبي ألا أبالي","قلّةَ إنصافِ من أبى لي",50,"ل",2,0],["وقاد عُنْقي لك خُلْقٌ سلِسُ ال","حبل على صُعوبة انقيادي",51,"د",2,0],["وقادحةٌ لها في كلّ يومٍ","ذبولٌ من نشاطك أو خمودُ",52,"د",1,0],["وقاد للأَعداء رقَّاصةً","تعزِفُ لولا يدهُ أن تُقادْ",53,"د",1,0],["وقادته لكم خِلاً صريحاً","حبائلُ مدَّها المجدُ الصُّاحُ",54,"ح",1,0],["وقاد إليهم كل جيش زهاؤه","إذا حل ظهر الأرض أعجزها الحمل",55,"ل",1,0],["وقادراً أضحت صروف دهره","لأمره مذعنة خواضعا",56,"ع",2,0],["وقادراً أمطر الدنيا ندى وردى","ففاض من راحتيه البأس والكرم",57,"م",1,0],["وَقادوا الخيلَ عارِية الهَوادِي","وما أوْكوْا منَ العَجَلِ العِيابا",58,"ب",2,0],["وقادوا أسارى كلَّ خُلْقٍ مُذمَّمٍ","وفاز شجاع بالغنائم دارع",59,"ع",1,0],["وقادَهُ السُّكْر فيا مِنَّةً","للسُّكْرِ لا تُشْبِهُها مِنَّهْ",60,"ن",2,0],["وَقادَ لِثارِهِ جَسّاسُ شَهراً","فَاَدرَكَ في بُجَيرٍ ما تَمَنَّى",61,"ن",2,0],["وقاد إلى الململم ما توانى","من الأعجاز منفجراً مقادا",62,"د",2,0],["وقادني دعوة ممن مكارمه","تحلُّ من عنق المأسور أكبُلَها",63,"ل",3,0],["وَقادَ زِمامَ الجاهِلِيَّةِ مِنهُمُ","مَناجيبُ سَباقون في الجلباتِ",64,"ت",1,0],["وَقادوا جُيوشاً أَولاً بَعدَ أَوَّل","أَقَرَّ لَها عادٍ بِكُثرِ أَداةِ",64,"ه",1,0],["وقاد بها عرف الصبا نجب غيمة","فارشفها شهدا وانشقها عطرا",65,"ر",2,0],["وقادهم لرشد بعد غي","وعز حماهم بعد افتقار",66,"ر",1,0],["وقاد جيشا عظيما لو رمى جبلا","بيده انهز بعد الأيد وانهدما",67,"م",2,0],["وَقَادَ إلَيْهَا الرّيحُ في كُلّ بُرْهَةٍ","نَجَائِبَ غَيْمٍ بَيْنَ بِكْرٍ وَأيِّمٍ",68,"م",1,0],["وَقادَ لَهم من كلّ جيشٍ عرمرمٍ","بهيمٍ به ضاقت بطونُ فجاجهِ",69,"ج",2,0],["وَقادِح لَكم غَداة الذُّعر","بِالضَّربِ أَحياناً وَطَعن شَزرِ",70,"ر",1,0],["وقادمُ العامِ عَمَّتْهُ مواهِبُهُ","فذو الإِقامَةِ فيها مثْلُ ذي الرِّحْلَهْ",71,"ل",2,0],["وقاد العباد لحضرتكم","واروى من المنهل الاعذب",72,"ب",1,0],["وقادة بين الورى جدهم","بحر العلوم العلم المقتدى",73,"د",2,0],["وقادَ من عُتاتِهم مَصاعباً","ما أسمَحت لولا شبا قِرضابه",74,"ب",2,0],["وَقادوا الزَمانَ إِلى اليومِ وَهوَ","رَقيقُ الحَواشي صَقيلُ النَواحِ",75,"ح",1,0],["وقاد الخيل للظلمات تدمى","دوابرها لكثرة ما وجينا",76,"ن",2,0],["وقادِمُ الصِّيد خيرُ سَهْمِ","أَرمي بهم كلَّ من أُرامي",77,"م",2,0],["وقَّادُنا وجهُهُ تحكيه شمسُ ضحىً","وَمنه غارت نجومٌ ثمَّ أقمارُ",78,"ر",1,1],["وَقادَت مَواهِبُهُ الطَّالِبينَ","فَأَنضى المَطِيّ وَسَدَّ الفَلا",79,"ا",1,0],["وقاد ذهن من سنا فكرته","سنا مصابيح العلوم اتقدا",80,"د",2,0],["وَقادَ بالقسر عَن أَشبالِهِ سبعا","قل كَيفَ أَعطى قيادا ذَلِكَ السَبع",81,"ع",1,0],["وقادُوا إِليهِ كلَّ يَومٍ بَلِيَّةً","قَوافِلَ تَسبيها وَقَتلَى تَقُودُها",82,"د",3,0],["وَقادَ حَصاةَ الهُداةِ بِظَرفٍ","وَخَيرُ الرِجالِ أَخو الأَلبَقِ",83,"ق",1,0],["وَقادة الملك قيدت في أَزمتها","وَجملة النَصر قَد جاءَت برمتها",84,"ه",2,0],["وَقادَةُ اليُمنِ وَالمَجسورِ أَثرُهمُ","يَومَ المُهمَّةِ وَالجُلىَّ إِذا جَسَروا",85,"ر",3,0],["وقادة راح عمر الدهر دينهم","يسمو على سائر الأديان والملل",86,"ل",1,0],["وقاده نحو المقر صيب","يجر بالعنف إليه المرسا",87,"س",2,0],["وَقادَ الخَيل عائِدَةً لِكَلبٍ","تَرى لِوَجيفِها رَهجاً سَريعا",88,"ع",2,0],["وَقادَها مُرسَلات العُذر جافلة","مِن النَجائب تَتلوها القَياديد",89,"د",1,0],["وقادهم بالذلّ في أسره","ما بين مغلول ومسجون",90,"ن",1,0],["وقادَكَ كالجَزُورِ بلا زِمامٍ","ولا بِدعَ الغُرورُ بلا زِمامِ",91,"م",1,0],["وقاد إليهم جحفلاً بعد جحفل","ووالى عليهم في ديارهم الغزوا",92,"و",2,0],["وَقادَ ثانيها فاريسُ يَصحَبُهُ","أَلقاثُ ثُم أَغينورُ الَّذي اِتَّقَدا",93,"د",2,0],["وقادته من يده تتدفق","دماه بحسٍّ تضعضع يشهق",94,"ق",1,0],["وَقادَتهُ الأَعلون في جاهِلِيَّة","وَشِرك وَهَل كَالشِركِ تَلقى مكفرا",95,"ر",2,0],["وَقادَتهُ مِن كُلِّ أَروَعِ باسِل","سَري كَريمِ الأَصلِ ماضي العَزائِم",96,"م",1,0],["وقادوا بكره من شهاب وحاجب","رؤوس معد في الأزمة والخطم",97,"م",1,0],["وقادهم للردى مذمومهم سفهاً","منه وبادر نحو الغيّ وابتدروا",98,"ر",3,0],["وقادهم عثمان ظناً بأنه","برأي سليم لا محالة يُنصَرُ",99,"ر",1,0],["وَقادَ جُيوشَ البَينِ مِن كَلِّ جانِبٍ","إِلَيكَ وَضاقَت عَنكَ أَفنِيَةُ الرَحبِ",100,"ب",1,0],["وَقادَ كُلَّ محربٍ حَتَّى ارتقَى","مِن رأسِ غُمدانَ بمِحرابِ الدُّمَى",101,"ا",1,0],["وَقَادَ جَيشاً غالباً لِتغلِبٍ","قَد سَطَعَ النَقعُ عَلَيهِ وَهَبَا",101,"ا",1,0],["وقادني والهوى زمامي","غنج بعينيه واحورار",102,"ر",1,0],["وقادٍ كخفقة النبض يغشى","مقلة راعها الخيال الطرو