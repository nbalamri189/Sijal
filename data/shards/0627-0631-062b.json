{"poems":[[53,"أعلى الغور تعرفت الخياما","https://www.aldiwan.net/poem29816.html","الرمل"],[93,"كم فاض في أثر الهلال العاثر","https://www.aldiwan.net/poem9848.html","الكامل"],[47,"إرث لصب فيك قد زدته","https://www.aldiwan.net/poem25259.html","السريع"],[89,"ارثى لمرضى ببرح الداء قد برموا","https://www.aldiwan.net/poem44691.html","البسيط"],[43,"أبعد نأي المليحة البخل","https://www.aldiwan.net/poem10113.html","المنسرح"],[45,"ملامك إنه عهد قريب","https://www.aldiwan.net/poem11042.html","الوافر"],[80,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[44,"ما للدموع تروم كل مرام","https://www.aldiwan.net/poem30362.html","الكامل"],[44,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[105,"لك يا شهيد الحق قام المأتم","https://www.aldiwan.net/poem42059.html","الكامل"],[105,"أطلقوا قيدها وحلوا العقالا","https://www.aldiwan.net/poem43051.html","الخفيف"],[48,"ما غضبي من شتم أحبابي","https://www.aldiwan.net/poem10797.html","السريع"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39641","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39670","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20997","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141981","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[106,"دمعة على الخفيف","https://www.poetsgate.com/ViewPoem.aspx?id=179355",""],[106,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[45,"مَلامُكَ، إنّهُ عَهْدٌ قَرِيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=31531",""]],"verses":[["إِرثُ آباءٍ عَلَوا فَاِقتَعَدوا","عَجُزَ المَجدِ وَأَعطَوكَ السَناما",0,"م",2,0],["أرثيك يا ولداه بالحس الذي","هو حس مصر وكل قلب شاعر",1,"ر",1,0],["إِرثِ لِصَبٍّ فيكَ قَد زِدتَهُ","عَلى بَلايا أَسرِهِ أَسرا",2,"ر",2,1],["ارثى لمرضى ببرح الداء قد برموا","يكابدون حياة كلها تعب",3,"ب",1,1],["اِرثِ لَها إِنَّها بِما مَلَكَت","وَبِالَّذي قَد أَسَلتَ تَنهَمِلُ",4,"ل",1,0],["أُرَثّيهِ وَلَو صَدَقَ اِختِياري","لَكانَ مَكانَ مَرثِيَتي النَسيبُ",5,"ب",1,0],["أَرثيكَ عَن طَبعٍ تَجَدْوَلَ بَحْرُهُ","بَعْدَ الغيَابِ وكَثرَةِ الأَولادِ",6,"د",1,0],["إِرثُ النَبِيِّ وَجَمرَةُ المُلكِ الَّتي","لَم تَخلُ مِن لَهَبٍ بِكُم وَضِرامِ",7,"م",1,0],["أُرِّثَ مِن خالِدٍ بِمُنصَلِتِ ال","إِقدامِ يَومَ الهِياجِ مُنجَرِدِه",8,"د",2,0],["إرثُ الخلائفِ لن يُدَنِّسَ أَرضَها","رِجسٌ لها بِظُبَى السُّيوفِ مُوَسَّمُ",9,"م",1,0],["إرثُ آبائِنا وذُخرُ بَنينا","نَفتديهِ ولا نرى أن يُذالا",10,"ل",2,0],["إِرثي وَجودي لِفَتى مُدنَفٍ","أَصبَحَ في هَمٍّ وَتَعذابِ",11,"ب",1,0],["أرثي لحظّ الأُفق وهو الذي","يرمقني بالنظرة الساخره",12,"ه",1,0],["إرثٌ تمشَّى في دمي منهما","ميراثهُ ينتظمُ العالما",13,"م",2,0],["أرثيكَ للأُممِ التي شاطرْتَها","كُرَبَ الخطوبِ وفرحةَ الأعيادِ",14,"د",1,0],["إِرثُ الجدود الصيد أنت وهَبتَهُ","قلماً يصاول دونه ويحامي",15,"م",2,0],["أَرَّثَت في عَرَفٍ مَوقِدَها","فأَضاءَت لَمعَ كَفٍّ بِسِوارِ",16,"ر",1,0],["إرث وهبت له الصبا","وسقيته دمع المشيب",17,"ب",1,0],["أرثيك حفظاً للجميل وإنّه","دينٌ أعيذ النفس من نُكرانه",18,"ن",2,0],["أرثى الخفيف بشعري أم أُفاكهُهُ؟","لا؛ بل أسوق له إحدى الأفاكيه",19,"ي",2,0],["أرثٌ على يدنا تبدَّد شملهُ","يا ليت هذا الإرث لم يتبدد!",20,"د",1,0],["أرثي لحالِ مزخرَفينَ حَمائلاً","في حينَ هُمْ مُتَكَهِّمونَ مَضاربا",21,"ب",2,0],["أرثيه ولو صدق اختياري","لكان مكان مرثيتي نسيب",22,"ب",1,0]]}