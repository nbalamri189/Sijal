{"poems":[[53,"أعلى الغور تعرفت الخياما","https://www.aldiwan.net/poem29816.html","الرمل"],[93,"كم فاض في أثر الهلال العاثر","https://www.aldiwan.net/poem9848.html","الكامل"],[47,"إرث لصب فيك قد زدته","https://www.aldiwan.net/poem25259.html","السريع"],[89,"ارثى لمرضى ببرح الداء قد برموا","https://www.aldiwan.net/poem44691.html","البسيط"],[43,"أبعد نأي المليحة البخل","https://www.aldiwan.net/poem10113.html","المنسرح"],[45,"ملامك إنه عهد قريب","https://www.aldiwan.net/poem11042.html","الوافر"],[80,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[44,"ما للدموع تروم كل مرام","https://www.aldiwan.net/poem30362.html","الكامل"],[44,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[105,"لك يا شهيد الحق قام المأتم","https://www.aldiwan.net/poem42059.html","الكامل"],[105,"أطلقوا قيدها وحلوا العقالا","https://www.aldiwan.net/poem43051.html","الخفيف"],[48,"ما غضبي من شتم أحبابي","https://www.aldiwan.net/poem10797.html","السريع"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39641","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39670","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20997","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141981","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[106,"دمعة على الخفيف","https://www.poetsgate.com/ViewPoem.aspx?id=179355",""],[106,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[45,"مَلامُكَ، إنّهُ عَهْدٌ قَرِيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=31531",""],[131,"أرث جديد الحبل من أم معبد","https://www.aldiwan.net/poem24162.html","الطويل"],[328,"الحمد للَه على ماق ضى","https://www.aldiwan.net/poem54955.html","الكامل"],[380,"يا رياح الفجر من نحو الحمى","https://www.aldiwan.net/poem48786.html","الرمل"],[400,"لله در بلادنا","https://www.aldiwan.net/poem6709.html","عموديه"],[453,"يا شعر من ترجو تحسب أنه","https://www.aldiwan.net/poem61226.html","الكامل"],[551,"ما في السلو لنا نصيب يطلب","https://www.aldiwan.net/poem48091.html","الكامل"],[558,"ظهر الوجود الحق في مرآتنا","https://www.aldiwan.net/poem34219.html","الكامل"],[562,"من قال إن الدهر ليس يعود","https://www.aldiwan.net/poem52806.html","الكامل"],[562,"أرثي ويا ليت شعري من سيرثيني","https://www.aldiwan.net/poem52888.html","البسيط"],[562,"لا تجزعي يا نفس من حكم الردى","https://www.aldiwan.net/poem52894.html","البسيط"]],"verses":[["إِرثُ آباءٍ عَلَوا فَاِقتَعَدوا","عَجُزَ المَجدِ وَأَعطَوكَ السَناما",0,"م",2,0],["أرثيك يا ولداه بالحس الذي","هو حس مصر وكل قلب شاعر",1,"ر",1,0],["إِرثِ لِصَبٍّ فيكَ قَد زِدتَهُ","عَلى بَلايا أَسرِهِ أَسرا",2,"ر",2,1],["ارثى لمرضى ببرح الداء قد برموا","يكابدون حياة كلها تعب",3,"ب",1,1],["اِرثِ لَها إِنَّها بِما مَلَكَت","وَبِالَّذي قَد أَسَلتَ تَنهَمِلُ",4,"ل",1,0],["أُرَثّيهِ وَلَو صَدَقَ اِختِياري","لَكانَ مَكانَ مَرثِيَتي النَسيبُ",5,"ب",1,0],["أَرثيكَ عَن طَبعٍ تَجَدْوَلَ بَحْرُهُ","بَعْدَ الغيَابِ وكَثرَةِ الأَولادِ",6,"د",1,0],["إِرثُ النَبِيِّ وَجَمرَةُ المُلكِ الَّتي","لَم تَخلُ مِن لَهَبٍ بِكُم وَضِرامِ",7,"م",1,0],["أُرِّثَ مِن خالِدٍ بِمُنصَلِتِ ال","إِقدامِ يَومَ الهِياجِ مُنجَرِدِه",8,"د",2,0],["إرثُ الخلائفِ لن يُدَنِّسَ أَرضَها","رِجسٌ لها بِظُبَى السُّيوفِ مُوَسَّمُ",9,"م",1,0],["إرثُ آبائِنا وذُخرُ بَنينا","نَفتديهِ ولا نرى أن يُذالا",10,"ل",2,0],["إِرثي وَجودي لِفَتى مُدنَفٍ","أَصبَحَ في هَمٍّ وَتَعذابِ",11,"ب",1,0],["أرثي لحظّ الأُفق وهو الذي","يرمقني بالنظرة الساخره",12,"ه",1,0],["إرثٌ تمشَّى في دمي منهما","ميراثهُ ينتظمُ العالما",13,"م",2,0],["أرثيكَ للأُممِ التي شاطرْتَها","كُرَبَ الخطوبِ وفرحةَ الأعيادِ",14,"د",1,0],["إِرثُ الجدود الصيد أنت وهَبتَهُ","قلماً يصاول دونه ويحامي",15,"م",2,0],["أَرَّثَت في عَرَفٍ مَوقِدَها","فأَضاءَت لَمعَ كَفٍّ بِسِوارِ",16,"ر",1,0],["إرث وهبت له الصبا","وسقيته دمع المشيب",17,"ب",1,0],["أرثيك حفظاً للجميل وإنّه","دينٌ أعيذ النفس من نُكرانه",18,"ن",2,0],["أرثى الخفيف بشعري أم أُفاكهُهُ؟","لا؛ بل أسوق له إحدى الأفاكيه",19,"ي",2,0],["أرثٌ على يدنا تبدَّد شملهُ","يا ليت هذا الإرث لم يتبدد!",20,"د",1,0],["أرثي لحالِ مزخرَفينَ حَمائلاً","في حينَ هُمْ مُتَكَهِّمونَ مَضاربا",21,"ب",2,0],["أرثيه ولو صدق اختياري","لكان مكان مرثيتي نسيب",22,"ب",1,0],["أَرَثَّ جَديدُ الحَبلِ مِن أُمِّ مَعبَدٍ","بِعاقِبَةٍ وَأَخلَفَت كُلَّ مَوعِدِ",23,"د",1,1],["أرثى لنفسي وله كلّما","شارفت منجاةً هوى وانحدر",24,"ر",1,0],["أَرثِ لي مِمّا أُقاسي كَرَما","لَيسَ لي فيما سِوى القُرب أَرب",25,"ب",1,0],["إرْثٌ عظيمٌ ورَّثتهُ شريعةٌ","مازال يحمل عبئَها أنصارُها",26,"ر",3,0],["أرثي له أضعاف ما يرثي لنا","ولئن تمادى في رقاعة ساخر",27,"ر",1,0],["إِرثُ النبيِّ لَكم ودار مُقامِهِ","والوحْيُ يُتلى بينكم أو يُكتبُ",28,"ب",1,0],["إرث النبيِّ محمد وهو الذي","جاءت به ساداتنا القوم الأول",29,"ل",1,0],["إرثُ العبادِ المالُ لكنْ إرثُهُ","تاجٌ وسيفٌ قاطِعٌ وبُنُودُ",30,"د",1,0],["أرِثي ويا ليتَ شِعري مَنْ سَيَرْثيني","قد حانَ ذلكَ أم يَبقَى إلى حِينِ",31,"ن",1,1],["أرثيكَ ثُمَّ أراكَ تطلُبُ فوقَ ما","أرثي فأغتَرِمُ الرِّثاءَ مُجدَّدا",32,"د",2,0]]}