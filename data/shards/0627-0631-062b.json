{"poems":[[55,"أعلى الغور تعرفت الخياما","https://www.aldiwan.net/poem29816.html","الرمل"],[95,"كم فاض في أثر الهلال العاثر","https://www.aldiwan.net/poem9848.html","الكامل"],[49,"إرث لصب فيك قد زدته","https://www.aldiwan.net/poem25259.html","السريع"],[91,"ارثى لمرضى ببرح الداء قد برموا","https://www.aldiwan.net/poem44691.html","البسيط"],[45,"أبعد نأي المليحة البخل","https://www.aldiwan.net/poem10113.html","المنسرح"],[47,"ملامك إنه عهد قريب","https://www.aldiwan.net/poem11042.html","الوافر"],[82,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[46,"ما للدموع تروم كل مرام","https://www.aldiwan.net/poem30362.html","الكامل"],[46,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[107,"لك يا شهيد الحق قام المأتم","https://www.aldiwan.net/poem42059.html","الكامل"],[107,"أطلقوا قيدها وحلوا العقالا","https://www.aldiwan.net/poem43051.html","الخفيف"],[50,"ما غضبي من شتم أحبابي","https://www.aldiwan.net/poem10797.html","السريع"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39641","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39670","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20997","الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141981","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[108,"دمعة على الخفيف","https://www.poetsgate.com/ViewPoem.aspx?id=179355",""],[108,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[92,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[47,"مَلامُكَ، إنّهُ عَهْدٌ قَرِيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=31531",""],[135,"أرث جديد الحبل من أم معبد","https://www.aldiwan.net/poem24162.html","الطويل"],[333,"الحمد للَه على ماق ضى","https://www.aldiwan.net/poem54955.html","الكامل"],[385,"يا رياح الفجر من نحو الحمى","https://www.aldiwan.net/poem48786.html","الرمل"],[406,"لله در بلادنا","https://www.aldiwan.net/poem6709.html","عموديه"],[458,"يا شعر من ترجو تحسب أنه","https://www.aldiwan.net/poem61226.html","الكامل"],[556,"ما في السلو لنا نصيب يطلب","https://www.aldiwan.net/poem48091.html","الكامل"],[563,"ظهر الوجود الحق في مرآتنا","https://www.aldiwan.net/poem34219.html","الكامل"],[567,"من قال إن الدهر ليس يعود","https://www.aldiwan.net/poem52806.html","الكامل"],[567,"أرثي ويا ليت شعري من سيرثيني","https://www.aldiwan.net/poem52888.html","البسيط"],[567,"لا تجزعي يا نفس من حكم الردى","https://www.aldiwan.net/poem52894.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138433",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48764","الكامل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129526","الطويل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100132","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96670","المتقارب"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64978","الرمل"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145113","المجتث"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109062","الكامل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115932","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95551","البسيط"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95556","الكامل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35768","السريع"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76841","السريع"],[458,"","https://poetry.dctabudhabi.ae/diwan/poem/143128","الكامل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108470","الكامل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108464","البسيط"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108473","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109353","البسيط"],[2186,"","https://poetry.dctabudhabi.ae/diwan/poem/124187","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53039","الرجز"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88650","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88646","الكامل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140092",""],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109786","الكامل"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/138015",""],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101625","الكامل"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140293",""],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67996","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62759","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62769","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92056","الكامل"],[3708,"","https://poetry.dctabudhabi.ae/diwan/poem/123836","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216369",""],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132112","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117869","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117861","البسيط"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44631","البسيط"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101372","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54490","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81286","الخفيف"],[4267,"","https://poetry.dctabudhabi.ae/diwan/poem/120184","الكامل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146755","المنسرح"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33482","المنسرح"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120510","المجتث"],[4723,"رثاء المواجع","https://www.poetsgate.com/ViewPoem.aspx?id=61753",""],[4908,"ضياع وشتاء","https://www.poetsgate.com/ViewPoem.aspx?id=207329",""],[585,"يا وامض البرق بالأنباء تبتدر","https://www.poetsgate.com/ViewPoem.aspx?id=161890",""],[5174,"رَفيفٌ إِلى مِشكاةِ الضَّادِ","https://www.poetsgate.com/ViewPoem.aspx?id=185374",""],[5219,"مراثي العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=193704",""],[5219,"بانت سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=194937",""],[5277,"المرثيّة الكاظميّة","https://www.poetsgate.com/ViewPoem.aspx?id=187574",""],[5376,"قصيدة من ملحمة سقوط بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=188511",""],[5431,"الحب معجزة الأكوان قاطبة","https://www.poetsgate.com/ViewPoem.aspx?id=191940",""],[5431,"لاأبعدَ الله من في حبهم صدقوا","https://www.poetsgate.com/ViewPoem.aspx?id=197622",""],[5436,"بغداد .. يا مجد هارون ( علي محمد السليم )","https://www.poetsgate.com/ViewPoem.aspx?id=46675",""],[5595,"أطلقْ دموعَك ، فالأحزانُ تستعرُ","https://www.poetsgate.com/ViewPoem.aspx?id=144533",""],[5628,"رثاء العملاق","https://www.poetsgate.com/ViewPoem.aspx?id=178489",""],[5736,"أرثي الطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=208891",""],[5861,"أيوب آل البيت","https://www.poetsgate.com/ViewPoem.aspx?id=190702",""],[5906,"فمعفر الليث","https://www.poetsgate.com/ViewPoem.aspx?id=188221",""],[5956,"لهفي أموت ولا أشاهد غادة","https://www.poetsgate.com/ViewPoem.aspx?id=182015",""],[5956,"العروبة تناجي فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192289",""],[5956,"ما عادل بتاتاً","https://www.poetsgate.com/ViewPoem.aspx?id=193523",""],[5956,"أرثي لمنآنا","https://www.poetsgate.com/ViewPoem.aspx?id=194495",""],[5956,"أرثيه يوميا وهو حيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=206257",""],[6031,"هَتَفَتْ بِدَمْعِ العَينِ وَهْي سَجُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=46292",""],[6102,"تعدو دعد","https://www.poetsgate.com/ViewPoem.aspx?id=183318",""],[4222,"رسم علي لذلك الرسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52896&r=&rc=188",""]],"verses":[["إِرثُ آباءٍ عَلَوا فَاِقتَعَدوا","عَجُزَ المَجدِ وَأَعطَوكَ السَناما",0,"م",2,0],["أرثيك يا ولداه بالحس الذي","هو حس مصر وكل قلب شاعر",1,"ر",1,0],["إِرثِ لِصَبٍّ فيكَ قَد زِدتَهُ","عَلى بَلايا أَسرِهِ أَسرا",2,"ر",2,1],["ارثى لمرضى ببرح الداء قد برموا","يكابدون حياة كلها تعب",3,"ب",1,1],["اِرثِ لَها إِنَّها بِما مَلَكَت","وَبِالَّذي قَد أَسَلتَ تَنهَمِلُ",4,"ل",1,0],["أُرَثّيهِ وَلَو صَدَقَ اِختِياري","لَكانَ مَكانَ مَرثِيَتي النَسيبُ",5,"ب",1,0],["أَرثيكَ عَن طَبعٍ تَجَدْوَلَ بَحْرُهُ","بَعْدَ الغيَابِ وكَثرَةِ الأَولادِ",6,"د",1,0],["إِرثُ النَبِيِّ وَجَمرَةُ المُلكِ الَّتي","لَم تَخلُ مِن لَهَبٍ بِكُم وَضِرامِ",7,"م",1,0],["أُرِّثَ مِن خالِدٍ بِمُنصَلِتِ ال","إِقدامِ يَومَ الهِياجِ مُنجَرِدِه",8,"د",2,0],["إرثُ الخلائفِ لن يُدَنِّسَ أَرضَها","رِجسٌ لها بِظُبَى السُّيوفِ مُوَسَّمُ",9,"م",1,0],["إرثُ آبائِنا وذُخرُ بَنينا","نَفتديهِ ولا نرى أن يُذالا",10,"ل",2,0],["إِرثي وَجودي لِفَتى مُدنَفٍ","أَصبَحَ في هَمٍّ وَتَعذابِ",11,"ب",1,0],["أرثي لحظّ الأُفق وهو الذي","يرمقني بالنظرة الساخره",12,"ه",1,0],["إرثٌ تمشَّى في دمي منهما","ميراثهُ ينتظمُ العالما",13,"م",2,0],["أرثيكَ للأُممِ التي شاطرْتَها","كُرَبَ الخطوبِ وفرحةَ الأعيادِ",14,"د",1,0],["إِرثُ الجدود الصيد أنت وهَبتَهُ","قلماً يصاول دونه ويحامي",15,"م",2,0],["أَرَّثَت في عَرَفٍ مَوقِدَها","فأَضاءَت لَمعَ كَفٍّ بِسِوارِ",16,"ر",1,0],["إرث وهبت له الصبا","وسقيته دمع المشيب",17,"ب",1,0],["أرثيك حفظاً للجميل وإنّه","دينٌ أعيذ النفس من نُكرانه",18,"ن",2,0],["أرثى الخفيف بشعري أم أُفاكهُهُ؟","لا؛ بل أسوق له إحدى الأفاكيه",19,"ي",2,0],["أرثٌ على يدنا تبدَّد شملهُ","يا ليت هذا الإرث لم يتبدد!",20,"د",1,0],["أرثي لحالِ مزخرَفينَ حَمائلاً","في حينَ هُمْ مُتَكَهِّمونَ مَضاربا",21,"ب",2,0],["أرثيه ولو صدق اختياري","لكان مكان مرثيتي نسيب",22,"ب",1,0],["أَرَثَّ جَديدُ الحَبلِ مِن أُمِّ مَعبَدٍ","بِعاقِبَةٍ وَأَخلَفَت كُلَّ مَوعِدِ",23,"د",1,1],["أرثى لنفسي وله كلّما","شارفت منجاةً هوى وانحدر",24,"ر",1,0],["أَرثِ لي مِمّا أُقاسي كَرَما","لَيسَ لي فيما سِوى القُرب أَرب",25,"ب",1,0],["إرْثٌ عظيمٌ ورَّثتهُ شريعةٌ","مازال يحمل عبئَها أنصارُها",26,"ر",3,0],["أرثي له أضعاف ما يرثي لنا","ولئن تمادى في رقاعة ساخر",27,"ر",1,0],["إِرثُ النبيِّ لَكم ودار مُقامِهِ","والوحْيُ يُتلى بينكم أو يُكتبُ",28,"ب",1,0],["إرث النبيِّ محمد وهو الذي","جاءت به ساداتنا القوم الأول",29,"ل",1,0],["إرثُ العبادِ المالُ لكنْ إرثُهُ","تاجٌ وسيفٌ قاطِعٌ وبُنُودُ",30,"د",1,0],["أرِثي ويا ليتَ شِعري مَنْ سَيَرْثيني","قد حانَ ذلكَ أم يَبقَى إلى حِينِ",31,"ن",1,1],["أرثيكَ ثُمَّ أراكَ تطلُبُ فوقَ ما","أرثي فأغتَرِمُ الرِّثاءَ مُجدَّدا",32,"د",2,0],["ارثيكما ابداً وان نفذ المدا","د جعلت اسود مقلتي انفاسي",33,"س",2,0],["إرث العباد المصلحين وخلدهم","وهي المجال الرحب وهي المرتع",34,"ع",1,0],["أرثت يد الأيام برد جمالها","وخيط بأيدي الحادثات لها برد",35,"د",1,0],["أرثيك يا من لم أحط بثنائه","ومن المحيط بعد مالا ينفد",36,"د",1,0],["أَرثّ المعالي ومَن قد كساهُ","إِلهُ البريّة ثوب الفخارِ",37,"ر",1,0],["إِرْثُهُ عن عُمَرَيْهِ","لِسواهُ ما تَسَنَّى",38,"ن",2,0],["إرث العروبة محضًا","مؤثلًا أزليّا",39,"ل",3,0],["أرثي لما قد فاتني منه واشرق","بالبكاء على ربيعي المدبر",40,"ر",1,0],["أرثيكَ من حُزنٍ عليك وحسرَةٍ","وبالرَّغم منّى أن أُرثّيكَ بالشّعرِ",41,"ر",1,0],["أرثيك بالمدمعين الفائضين على","قبر غدا قبلة الربكان والرسمِ",42,"م",1,0],["أرثى صديقا لم يهن","ودا ولم يقصر وفاه",43,"ا",2,0],["إِرثُ النَبِيّينَ إِلَيهِ اِنتَهى","مِن آدَمٍ أَبلَجُ مَعروفُ",44,"ف",1,0],["ارثُوا لِمَن لَيسَ له إِرثُ","وأبِّنوهُ وَله فارثوا",45,"ث",3,1],["أرثي فأرثي فيك أنفس ما ارتقى","ذهني وأحلامي له تبجيلا",46,"ل",2,0],["أرثي العصامي العظيم المبتني","مثل (الثبات) لمن يهون ملولا",46,"ل",2,0],["أرثي الخلود وما الخلود بدائم","في صورة، بل يتبع التعديلا",46,"ل",2,0],["أرثي وأبكي والأنام جميعهم","كالنبت يهضمه الزمان أكولا",46,"ل",2,0],["أرثي فترشدني إلى سبل الرثا","نادي التي كادت تضيع رشادي",47,"د",2,0],["أرثي فتىً طالما قرت برؤؤيته","عيني فما ساءها إلا تنائيه",48,"ي",2,0],["ارثي ويرثيك البديع وكم نقش","ت على الطروس فرائداً وبدائعا",49,"ع",2,0],["أرثي معاليه والاقلام راجفةٌ","بين الأنامل اشكوها وتشكوني",50,"ن",2,0],["أرثَّ صرف الزمان حالي","فما لدهري ترى وما لي",51,"ل",2,1],["إرث خليل الله غير لائق","إلا به أو بك هذا المنصب",52,"ب",1,0],["ارثيك ام ارثي لهون ابيك اذ","يغشى ضريحك في ردا محلول",53,"ل",1,0],["أَرثيه منصدعا فيا","لك فادحا للطود صادع",54,"ع",1,0],["ارثان قل جبل وآخر بعده","والبيش قل وصلآ في القرمية",55,"ه",1,0],["ارث قد احتفظوا به ولطالما","قد ضيعت ميراثها الاقوام",56,"م",1,0],["إرثك معك من سيد المرسلين","هادي