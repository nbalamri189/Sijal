{"poems":[[47,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[47,"أبا علي يا فتى الأشعر","https://www.aldiwan.net/poem63608.html","السريع"],[47,"ما تقضى لبانة عند لبنى","https://www.aldiwan.net/poem66658.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85302","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[47,"أقصرا قد أطلتما تفنيدي،","https://www.poetsgate.com/ViewPoem.aspx?id=31347",""],[164,"غدرت فيا باني الغزال الغادر","https://www.aldiwan.net/poem58938.html","الكامل"],[189,"واعجبا من جنة في ضرام","https://www.aldiwan.net/poem14657.html","السريع"],[353,"قنطرة قد بنيت","https://www.aldiwan.net/poem20034.html","مجزوء الرجز"],[398,"أما رأيت الدمع مسجوما","https://www.aldiwan.net/poem53664.html","السريع"],[520,"قدك مثل الغصن في اعتداله","https://www.aldiwan.net/poem12217.html","الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122657","الرمل"],[1124,"","https://poetry.dctabudhabi.ae/diwan/poem/202226","البسيط"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19992","المديد"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90669","الطويل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126195","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87332","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87329","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87330","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87322","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87315","الرجز"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58284","البسيط"],[3826,"","https://poetry.dctabudhabi.ae/diwan/poem/84980","السريع"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135620","الرجز"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33064","المديد"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136623",""],[5691,"عروش الطغاة","https://www.poetsgate.com/ViewPoem.aspx?id=207075",""]],"verses":[["قَدكُما مِن مَلامِ مَن وَقَفَت عَي","ناهُ بَينَ الدُموعِ وَالتَسهيدِ",0,"د",1,0],["قَد كَمَلَ المَجدُ لِقَحطانَ إِذ","كَمَلتَ لِلسَيفِ وَلِلمِنبَرِ",1,"ر",1,0],["قَدكِ مِنّي فَما جَوى السُقمِ إِلّا","في ضُلوعٍ عَلى جَوى الحُبِّ تُحنى",2,"ن",2,0],["قَدٌّ كَما شاءَت الأهواء معتدلٌ","ما شانه زارياً طولٌ وَلا قِصَرُ",3,"ر",1,0],["قَدْكَ مِنْهَا بَيَانُ مَفْخَرَةٍ وَاعْ","ذِرْ قُصُوراً بِهَا عَنِ التَّعْدَادِ",4,"د",1,0],["قدكما من ملام من وقفت عي","ناه بيد الدموع والتسهيد",5,"د",1,0],["قدٌّ كمثلِ الغصنِ يثنيه الصبا","ومقبل عذب وطرف فاتر",6,"ر",1,0],["قد كَمُلت حُسْنا فأوصافُها","يَعْجَز عنهن فصيحُ الكلام",7,"م",1,0],["قَدْ كَمَلَتْ أَوْصافُها","مِن كُلِّ حُسْنٍ مُقْتَرَحْ",8,"ح",1,0],["قَدكَ من اللَذّاتِ لا تَنهَمِك","من قبلِ لا تُحشَرُ مَذموما",9,"م",2,0],["قدك مثل الغصن في اعتداله","لولا نسيم هب من عذاله",10,"ل",2,1],["قَدكِ مِن وَعظي يا عاذِلَتي","قَد كَفتني نُوبُ الأيّام وعظا",11,"ظ",2,0],["قد كمل الله للحيين نعمته","إذ قام بالأمر حسانن بن مخدوج",12,"ج",1,1],["قدكَ مِن موفِ عَلى أَمَلٍ","تَحسِرُ الأَبصارَ عَن نَظَرِه",13,"ر",2,0],["قَدكُم من الإكثارِ في غيرِ كُنههِ","فما أنتمُ مثلي ولا شكلكُم شكلي",14,"ل",2,1],["قد كَمُلَت عليه سَبعَةَ عَشَر","مَنقُولنا هذا الأخيرُ فإشتَهَر",15,"ر",1,0],["قَد كَمُلَت مِن نَحوِكُم أُرجُوزَه","رَايقَهةٌ فايِقَةٌ وَجِيزَه",16,"ه",1,0],["قد كملَت أرجوزةُ الأزوامِ","سامرتُهَا أربَعَةَ أعوامِ",17,"م",1,0],["قَد كَمُلَت في سَادِسِ المُحَرَّمِ","حَجٌ وَحَجُّهْ يَومَ ذَاكَ فَآعلَمِ",18,"م",1,0],["قد كَمُلَت أُرجوزتي من فكري","أوَّلُها حمدي وآخرُها شكري",19,"ي",1,0],["قد كَمُلَت بدورةِ السماءِ","بلا خلافٍ وبلا خَطَاءِ",20,"ا",2,0],["قَد كَمُلَت في عَشرِ بَاشِيَّاتِ","في عَرضِها لِلمُفتكِر مآتي",21,"ي",1,0],["قد كَمّلَ اللهُ بِرذوني بَمْنقَصةِ","وشانَه بعدَ ما أعماهُ بالعَرَج",22,"ج",1,1],["قد كمنوا جيشاً لنا عامداً","يوم الوغى من كلِّ كلبٍ مُريب",23,"ب",1,0],["قد كملوا بعدد اثني عشرا","صلِّ على محمد خير الورى",24,"ر",2,0],["قَدكَ مِنّي صارِمٌ ما يُفَلُّ","وَاِبنُ حَزمٍ عَقدُكَ لا يُحَلُّ",25,"ل",1,1],["قد كَمن الموتُ في نواظِره","كُمون لَيثِ العرين في الأجم",26,"م",1,0],["قد كمموا الأفواه واعتنقوا الخنى","واستوزروا من كان غير جدير",27,"ر",1,0]]}