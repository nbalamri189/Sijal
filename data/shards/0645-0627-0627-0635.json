01",""],[5956,"في الذكرى* الأولى لوفاة شقيقي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=192406",""],[5956,"سندرا أمُّ الجميع","https://www.poetsgate.com/ViewPoem.aspx?id=193161",""],[5974,"غربة يتيم","https://www.poetsgate.com/ViewPoem.aspx?id=200259",""],[6045,"البشير عامر","https://www.poetsgate.com/ViewPoem.aspx?id=135938",""],[6082,"الحب الافتراضي","https://www.poetsgate.com/ViewPoem.aspx?id=59115",""],[6144,"أعوذ بالله","https://www.poetsgate.com/ViewPoem.aspx?id=21838",""],[6189,"ما تبقى من أحزان الرجال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83551&r=&rc=18",""],[6202,"روحي هنالك لا هنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86727&r=&rc=28",""],[6213,"القَدَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76315&r=&rc=63",""],[454,"اللغة العربية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82687&r=&rc=51",""],[5190,"أين الوفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85064&r=&rc=139",""],[5190,"أبهَى قصائدِ شِعرِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78287&r=&rc=1",""]],"verses":[["ما أصدق السيف! إن لم ينضه الكذب","وأكذب السيف إن لم يصدق الغضب",0,"ب",1,1],["ما أصابوا مِن تَغلَبِيِّ فَمَطَلو","لٌ عَلَيهِ إِذا تَوَلّى العَفاءُ",1,"ا",2,0],["ما اِصطِدامُ النَجمِ بِالنَجمِ عَلى","ساكِني الأَرضِ بِأَدهى وَأَمَر",2,"ر",1,0],["مَا أَصْلَحَ النَّشْءَ الَّذِي يَبنِينَهْ","أَحْسَنْتِ يَا سَيِّدَتِي أَمِينَهْ",3,"ن",2,0],["مَا أَصْغَرَ الدُّنْيَا وَأَحْقَرَهَا","فِي جَنْبِ مَا لِلمَيْتِ مِنْ عِظَمِ",4,"م",1,0],["ما أصحُّوا بلادكم بالمواعي","د ولكن بخُلْفهم أمرضوها",5,"و",3,0],["ما أَصلُ حَسّانَ في قَومِهِ","وَلَيسَ المُسائِلُ كَالخابِرِ",6,"ر",1,0],["ما أصفق الوجه الذي أعطيت","ساق إليه الخزيُ أنواعه",7,"ع",2,0],["ما أصبحت دنيايَ لي وطناً","بل حيث دارُك عنديَ الوطنُ",8,"ن",1,0],["ما أَصعَبَ الحاجَةَ لِلناسِ","فَالغُنمُ مِنهُم راحَةُ الياسِ",9,"س",1,1],["ما أَصعَبَ الفِعلَ لِمَن رامَهُ","وَأَسهَلَ القَولَ عَلى مَن أَراد",10,"د",1,0],["ما أَصْبَرَ الشّوْقَ بي فأَصْبَرُنا","مَنْ حَسُنَتْ فيه قِلّةُ الصَّبْرِ",11,"ر",1,0],["ما أَصبَحَت أَرضُ العِراقِ بِها","وَرَقٌ لِمُختَبِطٍ وَلا قِشرِ",12,"ر",1,1],["ما أصدقَ الرُؤيا وأقربَ حِينَها","فاصبِرْ على ثقةٍ وربُّكَ أكرم",13,"م",1,0],["ما أصدقَ المِقدادَ حين يَقولُها","حَرَّى وبعضُ القول نارٌ تَلْفَحُ",14,"ح",1,0],["ما اصطناعُ النفس في طُرقِ الهوى","كاصْطناع النفس في طُرق الرشاد",15,"د",1,0],["ما أُصَلّي إِلّا وَعِندي رَقيبٌ","قائِمٌ بِالحَصى يَعُدُّ سُجودي",16,"د",2,0],["ما أصنَعُ وَقَدْ أَبْطَأَ عليّ الخَبرُ","وَيْلاَهُ إلى مَتَى وكَمْ أَنْتَظِرُ",17,"ر",1,1],["ما أصعب الدعوة في البدايه","حتى على الرّسل أولي الهدايه",18,"ه",1,0],["مَا اصْطِخَابُ اللَّجِّ فِي حَيْرَتِهِ","بَيْنَ تيَّارٍ وَدُرْدُورٍ وَمَجْرَى",19,"ر",2,0],["ما أصدَقَ الناس لَو قالوا إِذا سُئِلوا","عَن كُلِّ عيشٍ مَضى أَضغاثُ أَحلامِ",20,"م",1,0],["ما أصدق العلم بالغدر المشوب بها","واكذب الظن في التغرير والأمل",21,"ل",1,0],["ما أصابوا من تغلبيٍ فمطلو","لٌ عليه إذا أصيب العفاء",22,"ا",2,0],["ما أصعبَ الإذنَ على منزلٍ","بوّابُه الخَطّىّ واللَّهْذَمُ",23,"م",1,0],["ما أَصاخوا إِلى وَعيدِ الأَعادي","مُذ أَناخوا بِبابِكَ التَأميلا",24,"ل",2,0],["ما أُصِبنا بِمثلهِ والبرايا","لَن يُصابوا وهَل له مثلاءُ",25,"ا",2,0],["ما أصلكم أنبئوني","لأقبلَ التوب منكم",26,"م",1,0],["ما أصنع بالحج إذا لم أركم","أنتم حجي وأنتم معتمري",27,"ي",1,0],["مَا أَصْبَحَ القَائِمُ المَهْدِيُّ نَاشِرَهُ","مِنَ الهِدَايَةِ أَمْسَى وَهْوَ طاوِيهِ",28,"ي",2,0],["ما أصبَحَتْ عُرْساً ترنُّ قِيانُها","إلا وأمْسَتْ مَأتَماً ونُواحا",29,"ح",2,0],["ما أَصعَبَ الحبَّ من خَطبٍ وأَبرَحَه","بذي العَفاف وإِن أخفى الَّذي يَضحُ",30,"ح",1,0],["ما أصعبَ الحزنَ إنْ باح الحزينُ به","وَما أحرَّ عَلَى الأَحشاء منكتما",31,"م",2,0],["ما اِصطَفاك الملوكُ إلّا اِمتثالاً","لاِصطفاءِ المهيمن الرحمنِ",32,"ن",1,0],["ما أصبحت شيراز وهي حبيبة","عندي بأبهج من أوال جنابا",33,"ب",2,0],["ما أصفت الأيام ورد مشاربي","كلا ولا نقعت غليل أوامي",34,"م",2,0],["ما اصطفاك الله فينا عبث","لا ولا اختارك للدين سدى",35,"د",2,0],["ما أصبح الروض مطوياً على العبق","طيباً ولا الفخر منشوراً على الأفق",36,"ق",1,1],["ما أَصعَبَ الفَقرَ لَكِنّي رَضيتُ بِهِ","لَمّا رَأَيتُ الغِنى في جانِبِ العارِ",37,"ر",1,0],["ما اِصطفاه فيك الخليفةُ جلَّى","عن نفوسٍ بين الشّكوكِ رِتاعِ",38,"ع",1,0],["ما اصطكاك الأجرام عند السماعِ","عبث فليعي كلامي واعي",39,"ع",2,1],["ما أَصْطفيه فمدح الصَّفى","هو المُصْطَفى وهو المرْتضى",40,"ض",2,0],["ما آصفٌ إِلّا لَدَيها قاصِرٌ","لَو لَم يَكُن مِن بَعضِ بِعض رُواتِها",41,"ت",3,0],["مَا أَصَرُّوا عَلَيه إلاَّ أَضَرُّوا","بأناس مننابهٍ أَو مُغَفَّل",42,"ل",1,0],["مَا أَصْعَبَ الفَقْدَ لِلْعَادَاتِ مِنْ مَلِكٍ","تَقْدِيمُهُ فِي الْعَطَايَا أَشْرَفُ الرُّتَبِ",43,"ب",1,0],["ما أصعبَ الصَّبرَ والأشواقِ مُقْتَرِبًا","فكيفَ بالله حَالي حِينَما بَعُدُوا؟",44,"د",3,0],["ما اصفر بالرد وجه مادحه","ولا رأى راحة له صفرا",45,"ر",2,0],["ما أصبح الصبح على أمثالهم","أطواد حلم لا ولا أمسى المسا",46,"س",2,0],["ما أصابتك بل أصابت فؤادي","يا منى النفس أعين الحساد",47,"د",1,1],["ما أصرم الحكم منه إذ يصرّ على","قيام حقٍ وما أهناه إن حلما",48,"م",2,0],["ما أصل منع رسالاتي إليك سوى","ما قد يجدُّ على عيني من الالمِ",49,"م",1,0],["ما أصابتها سوى العين التي","قلعها قد كان أولى واهم",50,"م",1,0],["ما اصفرَّ إلا حينَ غبتَ ولم يزل","يدعو بأن تأتي إليهِ كفوفُهُ",51,"ه",1,0],["ما اصفَرَّ وَجهُ الشَمسِ عِندَ غُروبِها","إِلذا لِفُرقَةِ حُسنِ ذاكَ المَنظَرِ",52,"ر",1,0],["ما أَصبَحَت في شَرِّ أَخبيةٍ","ما بَينَ شَرقِ الأَرضِ وَالغَربِ",53,"ب",1,0],["ما أصلح اللَه في الدنيا لنا عملاً","إلا وعاملك المرهوب علته",54,"ت",2,0],["ما أصبحت بالجوى تكوى جوارحنا","ولا غدا اليوم حبل الوصل مبتوتا",55,"ت",2,0],["ما أصلح الدهر سوى صالح","بالبذل والحلم وصدق المقال",56,"ل",1,0],["ما أصابَ الرسّامُ مني سوى لَفْ","ظٍ معانيهِ فاتَتِ الرسّاما",57,"م",2,0],["ما أصابت سهامهُ لك قلباً","كان قبل اللسان ينشي القصيدا",58,"د",2,0],["ما اصف ان جال فكراً وان","جاد فما يحيى وما جعفر",59,"ر",1,0],["ما اصطفى في العباد شخصا سواه","للعبودية التي يرضاها",60,"ا",3,0],["ما اصبح الصبح على امثالهم","اطواد عز لا ولا امسى المسا",61,"س",2,0],["ماأصابت نهى ولو أدركته","لنهاها عما تروم نهاها",62,"ا",3,0],["ما أصبحَتْ بشرٌ بأحسنَ في","ما بينَ شَرقِ الأرضِ والغَرْبِ",63,"ب",1,0],["ما أُصيبَت بِهِ الغَداةَ قُرَيشٌ","لا وَلا أُفرِدَت بِهِ الأَنصارُ",64,"ر",1,0],["ما اصلحتك ديانات طليت بها","يا عابد المال بل يا عابد الصنم",65,"م",1,0],["مَا أَصْعَبَ الذِّكْرَى تُؤَجِّجُ خُبْزَهَا","بَيْنَ الطُّفُولَةِ تَقْتَفِي أَعْرَافِي!",66,"ف",2,0],["ما أصعب الهجر من حبيبِ","لا سيما للشجي العميد",67,"د",1,0],["ما أصاب الخير في مصر سوى","ساقط في كل درك سمج",68,"ج",1,0],["ما أصدق القائلين حين بدا","عاشق هذا الجمال معذور",69,"ر",1,0],["ما أصابَ الرأيَ قائلُهم","هل هُنا من يَكره القمَرا",70,"ر",2,0],["ما أصعب الشجن الذي بدوامه","ترك الفؤاد مفرق الأعشار",71,"ر",1,0],["ما أَصعَبَ حالَتي وَما أَسوأَها","إِن أَمرَضَ مُهجَتي فَمَن أَبرأَها",72,"ه",2,1],["ما أَصوَبَ في التُربِ وقوعي قَلقاً","كالسَهمِ هُناك لَو أَصبت الغَرَضا",73,"ض",2,0],["ما أصبح الحرم الشريف محرقاً","إلا لسبكم الصحابة فيه",74,"ه",1,0],["ما أصدق القائلين العلم مخرقه","والجهل والحظ مقرونان في قرن",75,"ن",1,0],["ما اصفرت الشمس إلا من مخافة أن","يغني جميع الورى عنها محياه",76,"ا",2,0],["ما أصل فِعلِ المَرءِ إلا رأيُهُ","وليسَ أصلُ رأيِهِ إلا الحِجا",77,"ا",1,0],["ما أصبحت أَعطافهُ يزهو بها","تيهاً وهزَّ الجفنُ حدَّ صقيلهِ",78,"ل",2,0],["ما أصبحت منكَ الشَّمائلُ تنثني","وتميلُ إلاَّ والرُّضابُ شَمولُ",79,"ل",1,0],["ما أَصبحت حُشاشَتي في أَسرِها","إلاَّ وَقَد أَودَت بِها بأَسرِها",80,"ر",3,1],["ما أصبرَ القلب على ما به","وأغفلَ الاحبابَ عن دائه",81,"ا",3,0],["ما آصف في الراي ما أحنف","في الحلم ما يحيى ببذل النوال",82,"ل",1,0],["ما أصعب المرتقى لكنّ (لا) خضعت","من داخل النفس للإصرار وال (نعَمِ)",83,"م",1,0],["مااصْعب الحب وفراقك ليا جت سوا","ذقت كاس الشهد يالريم مخلوط سم",84,"م",1,0],["ما أَصدَقَ الرِّيحَ.. سِفرِي لَم يَزَل سَفَرًا","واليَأسُ قَبلِي وبَعدِي مُخلِصٌ ووَفِي",85,"ف",2,0],["ما أصدقَ الصَّبُ المُعنّى قلبُهُ","تاللهِ ما كَذبَ المُحبُّ وما قلى",86,"ل",2,0],["ما أصل هذا الدّفقِ هل لي حسنهُ","أم أنّه سراًّ لغيري يُنظمُ",87,"م",1,0],["مَا أصدقَ الرُّوحَ لمَّا قالَ قائِلُهَا:","مَا أعذبَ النَّاسَ لولا أنَّهُم بشَرُ",88,"ر",1,0],["مَا اصْفَرَّ وَجْهِي مِنَ الأَجْوَاءِ حَيْثُ بَدَتْ","بَلْ مُصَّ دَمِّي بِحُمَّى الشَّوْقِ تَسْفِيِهَا",89,"ي",3,0],["ما أصابت فهو القضاء ولن تخ","طئ إلا لغاية ثم تعدو",90,"د",2,0],["ما أصدق القول وجه الله غايته","وأكذب القول والدنيا على أمم",91,"م",1,0],["ما أصعبَ الحبَّ، ما أقسى طبائعَهُ","تنأى فيدنو، وينأى لو تدانيهِ",92,"ي",2,0],["ما أصعب الهجر من معشوقة وصلت","ومن مولعة في هجرها الصعب",93,"ب",1,0],["ما أصعبَ الهجرَ الذي","أضحى عليَّ مُقدَّرا !",94,"ر",2,0],["ما أصعبَ الأيامَ إذْ ضربَاتُها","وسط الرؤوسِ وفي الرقابِ تصيرُ",95,"ر",1,1],["ما أصغر الدنيا بنا والأفق ليس بضيق","أتصدقين بأننا من بعد دهرٍ نلتقي",96,"ق",2,0],["ما أصعبَ الدمعَ الذي جرف الخدو","دَ براءةً ومرامها الإبقاءُ!",97,"ا",2,0],["ماأصعب النفس إن باتت مكسّرة","والريح تنثرها للعقم ملتحدا",98,"د",2,0],["ماأصْعَبَ السّيْرَ في دَرْبٍ نُذِرْتَ لهُ","ما أصْعَبَ الحِلَّ والأحْبابُ قد رَحَلوا",99,"ل",3,0],["‏ما اصعب من وجودك الا فكرة غيابك","‏وماهوّن غيابك الا انك على ظني",100,"ن",2,0],["ما اصعب من الشوق لا من فل جنحانه","بعيون من تكبر جروحه وهو يكبر",101,"ر",1,0],["ما أصعب الحبَّ إنْ أخنى الحبيبُ على","قلب المُحِبِّ الذي يصْلى البراكينا",102,"ن",2,0],["‏ما أصعب الأمواج إن هبّت ولا","‏ ‏ تلقى مراكبَ فوقها تُنهي الخطرْ",103,"ر",1,0],["ما أصعبَ الموتَ التعيسَ وليتني","منذ الولادة قد سكنتُ التُّرْبا",104,"ب",2,0],["ما أصعب الفِقْدانَ والحِرْمانَ من","أغلى الأحبّة والحنان لديهما",105,"م",2,0],["ما أصعبَ استيفاء دَيْنٍ فاحش","جمِّ يدكُّ قرارة الآكامِ",106,"م",1,0],["ما أصبح الهم الوحيد هو الغنى","أمّا الأهمّ فإنه نبْذ الأنا",107,"ن",2,0],["ما أصعب اليتم الذي","صفع الطفولة بالغداه",108,"ا",2,0],["ما أصعبَ الطعن أقساطًا مؤجَّلةً","وأهونَ الضربَ فوق الهام يقطعُه",109,"ع",2,0],["ما اصعب ان تهوى امراة","تتباهى خلف الانظار",110,"ر",1,0],["ما أصبحوا أهل طبنجه وروم وكمنجه","واتعلموا يمزوا برنجه وخص وجرجير",111,"ر",1,0],["ما أصعب العارَ من أين أبدأُ العار","وكيف أُنشدُ يا تاريخ ما صارا",112,"ر",2,1],["ما أصعبَ الأشواقَ تز","حمني وترميني ونى",113,"ن",2,0],["ما أصعبَ العيش الوضيع وقد","عَظُمَ الذين شعارهم خَمْرُ",114,"ر",1,0],["ما اصطفاك الله فينا عبثاً","لا ولا اختارك للدين سدى",115,"د",2,0],["ما أصعبَ الغدرَ المقيتَ على امرئٍ","ظَنَّ الحياةَ الروضَ بالرُّفَقاءِ",116,"ا",2,0],["ما أصدقَ الشِّعرَ في عينيكِ مُلهِمَتي","وأكذبَ الشعرَ إِن لم يُرتَجَل فيكِ",117,"ك",1,0]]}