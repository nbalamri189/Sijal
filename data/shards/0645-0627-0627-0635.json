{"poems":[[100,"أبو تمام وعروبة اليوم","https://www.aldiwan.net/poem23694.html","عموديه"],[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[86,"علمونا الصبر يطفي ما استعر","https://www.aldiwan.net/poem10353.html","الرمل"],[93,"وحبك يا سيدتي أمينه","https://www.aldiwan.net/poem11115.html","الرجز"],[93,"رب البيان وسيد القلم","https://www.aldiwan.net/poem11371.html","أحذ الكامل"],[88,"يا بني الرافدين مالي أراكم","https://www.aldiwan.net/poem44473.html","الطويل"],[23,"سألت قريشا فلم يكذبوا","https://www.aldiwan.net/poem21386.html","المتقارب"],[51,"راع فؤادي منك ما راعه","https://www.aldiwan.net/poem65408.html","السريع"],[51,"يا هل يخلد منظر حسن","https://www.aldiwan.net/poem66456.html","أحذ الكامل"],[70,"ما أصعب الحاجة للناس","https://www.aldiwan.net/poem42855.html","السريع"],[85,"يا ناشر العلم بهذي البلاد","https://www.aldiwan.net/poem63771.html","السريع"],[56,"لا ومكان الصليب في النحر","https://www.aldiwan.net/poem58467.html","الكامل"],[28,"ما أصبحت أرض العراق بها","https://www.aldiwan.net/poem5128.html","الكامل"],[105,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[75,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[50,"اشفعي لي صريم عند الكنود","https://www.aldiwan.net/poem63937.html","الخفيف"],[68,"ما أصنع وقد أبطأ علي الخبر","https://www.aldiwan.net/poem1500.html",""],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[140,"وعيشكم لا ورد الحوم","https://www.aldiwan.net/poem58424.html","السريع"],[141,"ما نرى للثناء عنك عدولا","https://www.aldiwan.net/poem11801.html","الخفيف"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[209,"فررت منكم إليكم","https://www.aldiwan.net/poem46284.html","المجتث"],[229,"لم آت إلى الموسم كي أذكركم","https://www.aldiwan.net/poem44543.html","الدوبيت"],[273,"فواتح الفتح تنبي عن تواليه","https://www.aldiwan.net/poem25461.html","البسيط"],[273,"طلعت عليك مع المساء صباحا","https://www.aldiwan.net/poem25602.html","الكامل"],[295,"وافى وأفق الدجى بالزهد متشح","https://www.aldiwan.net/poem33301.html","البسيط"],[296,"وقف على الفيض أنفاس مصعدة","https://www.aldiwan.net/poem36301.html","عموديه"],[303,"سائل النفس قبل فوت الأوان","https://www.aldiwan.net/poem56386.html","الخفيف"],[338,"يا من نأت بهم الديار فأصبحوا","https://www.aldiwan.net/poem11560.html","الكامل"],[434,"سفها بكيت بدمع عين هام","https://www.aldiwan.net/poem2585.html","الكامل"],[447,"اللغة العربية","https://www.aldiwan.net/poem969.html","عموديه"],[450,"ما أصبح الروض مطوياً على العبق","https://www.aldiwan.net/poem13866.html","البسيط"],[526,"لله ما هاج لمع البارق الساري","https://www.aldiwan.net/poem2483.html","البسيط"],[549,"ضمنت مجدك العلا والمساعي","https://www.aldiwan.net/poem47709.html","الخفيف"],[556,"ما اصطكاك الأجرام عند السماع","https://www.aldiwan.net/poem34384.html","الخفيف"],[573,"أضاء بثغرك وادي أضا","https://www.aldiwan.net/poem3054.html","المتقارب"]],"verses":[["ما أصدق السيف! إن لم ينضه الكذب","وأكذب السيف إن لم يصدق الغضب",0,"ب",1,1],["ما أصابوا مِن تَغلَبِيِّ فَمَطَلو","لٌ عَلَيهِ إِذا تَوَلّى العَفاءُ",1,"ا",2,0],["ما اِصطِدامُ النَجمِ بِالنَجمِ عَلى","ساكِني الأَرضِ بِأَدهى وَأَمَر",2,"ر",1,0],["مَا أَصْلَحَ النَّشْءَ الَّذِي يَبنِينَهْ","أَحْسَنْتِ يَا سَيِّدَتِي أَمِينَهْ",3,"ن",2,0],["مَا أَصْغَرَ الدُّنْيَا وَأَحْقَرَهَا","فِي جَنْبِ مَا لِلمَيْتِ مِنْ عِظَمِ",4,"م",1,0],["ما أصحُّوا بلادكم بالمواعي","د ولكن بخُلْفهم أمرضوها",5,"و",3,0],["ما أَصلُ حَسّانَ في قَومِهِ","وَلَيسَ المُسائِلُ كَالخابِرِ",6,"ر",1,0],["ما أصفق الوجه الذي أعطيت","ساق إليه الخزيُ أنواعه",7,"ع",2,0],["ما أصبحت دنيايَ لي وطناً","بل حيث دارُك عنديَ الوطنُ",8,"ن",1,0],["ما أَصعَبَ الحاجَةَ لِلناسِ","فَالغُنمُ مِنهُم راحَةُ الياسِ",9,"س",1,1],["ما أَصعَبَ الفِعلَ لِمَن رامَهُ","وَأَسهَلَ القَولَ عَلى مَن أَراد",10,"د",1,0],["ما أَصْبَرَ الشّوْقَ بي فأَصْبَرُنا","مَنْ حَسُنَتْ فيه قِلّةُ الصَّبْرِ",11,"ر",1,0],["ما أَصبَحَت أَرضُ العِراقِ بِها","وَرَقٌ لِمُختَبِطٍ وَلا قِشرِ",12,"ر",1,1],["ما أصدقَ الرُؤيا وأقربَ حِينَها","فاصبِرْ على ثقةٍ وربُّكَ أكرم",13,"م",1,0],["ما أصدقَ المِقدادَ حين يَقولُها","حَرَّى وبعضُ القول نارٌ تَلْفَحُ",14,"ح",1,0],["ما اصطناعُ النفس في طُرقِ الهوى","كاصْطناع النفس في طُرق الرشاد",15,"د",1,0],["ما أُصَلّي إِلّا وَعِندي رَقيبٌ","قائِمٌ بِالحَصى يَعُدُّ سُجودي",16,"د",2,0],["ما أصنَعُ وَقَدْ أَبْطَأَ عليّ الخَبرُ","وَيْلاَهُ إلى مَتَى وكَمْ أَنْتَظِرُ",17,"ر",1,1],["ما أصعب الدعوة في البدايه","حتى على الرّسل أولي الهدايه",18,"ه",1,0],["مَا اصْطِخَابُ اللَّجِّ فِي حَيْرَتِهِ","بَيْنَ تيَّارٍ وَدُرْدُورٍ وَمَجْرَى",19,"ر",2,0],["ما أصدَقَ الناس لَو قالوا إِذا سُئِلوا","عَن كُلِّ عيشٍ مَضى أَضغاثُ أَحلامِ",20,"م",1,0],["ما أصابوا من تغلبيٍ فمطلو","لٌ عليه إذا أصيب العفاء",21,"ا",2,0],["ما أصعبَ الإذنَ على منزلٍ","بوّابُه الخَطّىّ واللَّهْذَمُ",22,"م",1,0],["ما أَصاخوا إِلى وَعيدِ الأَعادي","مُذ أَناخوا بِبابِكَ التَأميلا",23,"ل",2,0],["ما أُصِبنا بِمثلهِ والبرايا","لَن يُصابوا وهَل له مثلاءُ",24,"ا",2,0],["ما أصلكم أنبئوني","لأقبلَ التوب منكم",25,"م",1,0],["ما أصنع بالحج إذا لم أركم","أنتم حجي وأنتم معتمري",26,"ي",1,0],["مَا أَصْبَحَ القَائِمُ المَهْدِيُّ نَاشِرَهُ","مِنَ الهِدَايَةِ أَمْسَى وَهْوَ طاوِيهِ",27,"ي",2,0],["ما أصبَحَتْ عُرْساً ترنُّ قِيانُها","إلا وأمْسَتْ مَأتَماً ونُواحا",28,"ح",2,0],["ما أَصعَبَ الحبَّ من خَطبٍ وأَبرَحَه","بذي العَفاف وإِن أخفى الَّذي يَضحُ",29,"ح",1,0],["ما أصعبَ الحزنَ إنْ باح الحزينُ به","وَما أحرَّ عَلَى الأَحشاء منكتما",30,"م",2,0],["ما اِصطَفاك الملوكُ إلّا اِمتثالاً","لاِصطفاءِ المهيمن الرحمنِ",31,"ن",1,0],["ما أصبحت شيراز وهي حبيبة","عندي بأبهج من أوال جنابا",32,"ب",2,0],["ما أصفت الأيام ورد مشاربي","كلا ولا نقعت غليل أوامي",33,"م",2,0],["ما اصطفاك الله فينا عبث","لا ولا اختارك للدين سدى",34,"د",2,0],["ما أصبح الروض مطوياً على العبق","طيباً ولا الفخر منشوراً على الأفق",35,"ق",1,1],["ما أَصعَبَ الفَقرَ لَكِنّي رَضيتُ بِهِ","لَمّا رَأَيتُ الغِنى في جانِبِ العارِ",36,"ر",1,0],["ما اِصطفاه فيك الخليفةُ جلَّى","عن نفوسٍ بين الشّكوكِ رِتاعِ",37,"ع",1,0],["ما اصطكاك الأجرام عند السماعِ","عبث فليعي كلامي واعي",38,"ع",2,1],["ما أَصْطفيه فمدح الصَّفى","هو المُصْطَفى وهو المرْتضى",39,"ض",2,0]]}