{"poems":[[53,"الآن أعربت الظنون","https://www.aldiwan.net/poem29655.html","مجزوء الكامل"],[53,"متى أنا قائم أعلى مقام","https://www.aldiwan.net/poem29753.html","الوافر"],[53,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[53,"يا دار ما طربت إليك النوق","https://www.aldiwan.net/poem29956.html","الكامل"],[53,"صبرت عنك فلم ألفظك من شبع","https://www.aldiwan.net/poem30133.html","البسيط"],[53,"ألا ناشدا ذاك الجناب الممنعا","https://www.aldiwan.net/poem30145.html","الطويل"],[53,"طلاب العز من شيم الشجاع","https://www.aldiwan.net/poem30155.html","الوافر"],[53,"لك السوابق والأوضاح والغرر","https://www.aldiwan.net/poem30458.html","البسيط"],[53,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[53,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[53,"جري النسيم على ماء العناقيد","https://www.aldiwan.net/poem30625.html","البسيط"],[53,"أنظر إلى الأيام كيف تعود","https://www.aldiwan.net/poem30626.html","الكامل"],[53,"أبرا إلى المجد من حرصي على الطلب","https://www.aldiwan.net/poem30707.html","البسيط"],[53,"ألان جوانبي غمز الخطوب","https://www.aldiwan.net/poem30752.html","الوافر"],[55,"الآن لما صار مرتهنا","https://www.aldiwan.net/poem26167.html","السريع"],[77,"عسى خطرة بالركب يا حادي العيس","https://www.aldiwan.net/poem35882.html","الطويل"],[73,"إعجب لحال السرو كيف تحال","https://www.aldiwan.net/poem11939.html","الكامل"],[82,"لكل شيء إذا ما تم نقصان","https://www.aldiwan.net/poem29425.html","البسيط"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[93,"هدايا الناس من زهر الجنان","https://www.aldiwan.net/poem11187.html","الوافر"],[93,"رب البيان وسيد القلم","https://www.aldiwan.net/poem11371.html","أحذ الكامل"],[88,"هو الليل يغريه الأسى فيطول","https://www.aldiwan.net/poem44837.html","الطويل"],[27,"عفا قو وكان لنا محلاً","https://www.aldiwan.net/poem4445.html","الوافر"],[27,"متى كان المنازل بالوحيد","https://www.aldiwan.net/poem5711.html","الوافر"],[47,"لمثلها يستعد البأس والكرم","https://www.aldiwan.net/poem25146.html","البسيط"],[47,"الآن حين عرفت رشدي","https://www.aldiwan.net/poem25291.html","مجزوء الكامل"],[51,"أبا حسن وأنت فتى أديب","https://www.aldiwan.net/poem8181.html","الوافر"],[51,"لي صاحب قد كنت آمل نفعه","https://www.aldiwan.net/poem8496.html","الكامل"],[51,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[51,"عبثت به الحمى فورد جسمه","https://www.aldiwan.net/poem64093.html","الكامل"],[51,"ومن العجائب يا أبا الفياض","https://www.aldiwan.net/poem64948.html","الكامل"],[51,"أصل نما بك ربه فرعه","https://www.aldiwan.net/poem65410.html","أحذ الكامل"],[51,"يا راغبا نزعت به الآمال","https://www.aldiwan.net/poem65921.html","الكامل"],[51,"ألا نسيا نفسي حديث البلابلِ","https://www.aldiwan.net/poem65958.html","الطويل"],[51,"أرى المفند ينهاني ويأمرني","https://www.aldiwan.net/poem66384.html","البسيط"],[91,"ألا نبي لو طبعنا الشمس يوما","https://www.aldiwan.net/poem8791.html","عموديه"],[91,"من الفرنسيس قيد العين صورتها","https://www.aldiwan.net/poem8873.html","عموديه"],[38,"بان الأحبة بالعهد الذي عهدوا","https://www.aldiwan.net/poem7699.html","البسيط"],[32,"ألا ناد عيرا من بثينة ترتعي","https://www.aldiwan.net/poem27781.html","الطويل"],[89,"فيك المدائح تحلو","https://www.aldiwan.net/poem44969.html","المجتث"],[85,"فلوس الشغل ما تأخير","https://www.aldiwan.net/poem7900.html","الكامل"],[85,"تاج البلاد تحية وسلام","https://www.aldiwan.net/poem8106.html","الكامل"],[85,"كل حي على المنية غادي","https://www.aldiwan.net/poem62901.html","الخفيف"],[45,"ألان علمت أن البعث حق","https://www.aldiwan.net/poem10203.html","الوافر"],[45,"أبلغ أبا صالح إما مررت به","https://www.aldiwan.net/poem62710.html","البسيط"],[45,"وليكم الله الذي لم يزل لنا","https://www.aldiwan.net/poem64654.html","الطويل"],[45,"قل للجنوب إذا غدوت فأبلغي","https://www.aldiwan.net/poem65668.html","الخفيف"],[45,"الآن أيقنت أن الرزق أقسام","https://www.aldiwan.net/poem66656.html","البسيط"],[28,"بني نهشل أبقوا عليكم ولم تروا","https://www.aldiwan.net/poem5257.html","الطويل"],[61,"أخلق بغائب رشده أن يقدما","https://www.aldiwan.net/poem51455.html","الكامل"],[61,"من لي برد سوالف الأحقاب","https://www.aldiwan.net/poem51783.html","الكامل"],[49,"ألا نحن في دار قليل بقائها","https://www.aldiwan.net/poem10315.html","الطويل"],[49,"قطعت منك حبائل الآمال","https://www.aldiwan.net/poem63049.html","الكامل"],[49,"حيل البلى تأتي على المحتال","https://www.aldiwan.net/poem63053.html","الكامل"],[49,"ألا نادت هرقلة بالخراب","https://www.aldiwan.net/poem63235.html","الخفيف"],[97,"لا تبكها ذهبت ومات هواها","https://www.aldiwan.net/poem24354.html","الكامل"],[97,"اليوم منك عرفت سر وجودي","https://www.aldiwan.net/poem24910.html","الكامل"],[97,"لا تجزعوا للشاعر الملهم","https://www.aldiwan.net/poem24985.html","السريع"],[97,"أصبحت من يأسي لو ان الردى","https://www.aldiwan.net/poem25075.html","السريع"],[80,"الآن أفرخ روع كل مهيد","https://www.aldiwan.net/poem31473.html","الكامل"],[44,"ألآن خليت الذؤبان في الغنم","https://www.aldiwan.net/poem30001.html","البسيط"],[44,"الآن لما صار حوض الوارد","https://www.aldiwan.net/poem30052.html","الكامل"],[44,"أسقى طلولهم أجش هزيم","https://www.aldiwan.net/poem30341.html","الكامل"],[44,"أقشيب ربعهم أراك دريسا","https://www.aldiwan.net/poem30481.html","الكامل"],[44,"لطمحت في الإبراق والإرعاد","https://www.aldiwan.net/poem30535.html","الكامل"],[69,"قالوا لقد كسد القريض فقلت بل","https://www.aldiwan.net/poem28481.html","الكامل"],[69,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[74,"الآن سح غمام النصر فانهملا","https://www.aldiwan.net/poem13228.html","البسيط"],[74,"ألا نسخ الله القطار حجارة","https://www.aldiwan.net/poem13236.html","الطويل"],[105,"جمعن المشارق في المؤتمر","https://www.aldiwan.net/poem42051.html","المتقارب"],[105,"حيوا الهلال وحيوا أمة النيل","https://www.aldiwan.net/poem43087.html","البسيط"],[21,"الحمد لله ممسانا ومصبحنا","https://www.aldiwan.net/poem36147.html","البسيط"],[52,"الآن سرت فؤادي مقلة الريم","https://www.aldiwan.net/poem26682.html","البسيط"],[52,"ومما شجاني بارق لاح موهنا","https://www.aldiwan.net/poem26880.html","الطويل"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[48,"نك من لقيت من البشر","https://www.aldiwan.net/poem66623.html","مجزوء الكامل"],[50,"ألا راعه صوت الأذين وما هجد","https://www.aldiwan.net/poem63907.html","الطويل"],[50,"يا صاح دعني فإنني نصب","https://www.aldiwan.net/poem64857.html","المنسرح"],[46,"سمعت نعيها صما صمام","https://www.aldiwan.net/poem23631.html","الكامل"],[76,"يا ابن الخلائف والعلا للمعتلي","https://www.aldiwan.net/poem39020.html","الكامل"],[76,"قصد المنون له فمات فقيدا","https://www.aldiwan.net/poem39456.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85487","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16620","البسيط"],[72,"","https://poetry.dctabudhabi.ae/diwan/poem/40625","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55506","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54534","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142032","الخفيف"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12702","الطويل"],[106,"تجار العقائد","https://www.poetsgate.com/ViewPoem.aspx?id=179441",""],[106,"وحي العيد","https://www.poetsgate.com/ViewPoem.aspx?id=179512",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"الإقطاع","https://www.poetsgate.com/ViewPoem.aspx?id=179169",""],[90,"سبحان من خلق الرجال","https://www.poetsgate.com/ViewPoem.aspx?id=179013",""],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[45,"لا دِمنَةٌ بلِوَى خَبتٍ، وَلا طَلَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32200",""],[91,"إلى الفاتح ..","https://www.poetsgate.com/ViewPoem.aspx?id=52999",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[88,"اذا شئت ان تسرى بكافرة الصوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19534&r=&rc=37",""]],"verses":[["الآنَ أَعرَبَتِ الظُنونُ","وَعَلا عَلى الشَكِّ اليَقينُ",0,"ن",1,1],["أَلآنَ لَمّا اِمتَدَّ بي","طوبى وَأَصحَبَ لي القَرينُ",0,"ن",1,0],["أَلانَ جَذَبتَ مِن أَيدي اللَيالي","عِناني وَاِشتَمَلتَ عَلى زَمامي",1,"م",2,0],["الآنَ جَلَّلَني الوَقارُ رِداءَهُ","وَاِنجابَ عَن عَينَيَّ ذاكَ الغَيطَلُ",2,"ل",1,0],["الآنَ أَقبَلَ بي الوَقارُ عَنِ الصَبا","فَغَضَضتُ طَرفي وَالظِباءُ تَروقُ",3,"ق",1,0],["الآنَ يَعلَمُ أَنَّ العَيشَ مُختَلَسٌ","وَأَنَّنا نَقطَعُ الأَيّامَ بِالخِدَعِ",4,"ع",1,0],["أَلا ناشِداً ذاكَ الجَنابَ المُمَنَّعا","وَجُرداً يُناقِلنَ الوَشيجَ المُزَعزَعا",5,"ع",2,1],["أَلانَ رِدِ العَلاءَ بِلا رَقيبٍ","وَشَمِّر في الأُمورِ وَلا تُراعِ",6,"ع",1,0],["أَلانَ تَراجَعَت تِلكَ الرَعايا","وَجُهِّزَتِ الرَعِيَةُ لِلمَراعي",6,"ع",2,0],["الآنَ نِعمَ مَقيلُ التاجِ لِمَّتُهُ","وَنِعمَ مَغنى العُلى أَيّامُهُ الزُهُرُ",7,"ر",1,0],["الأَنَ أَعفَيتَ القُلو","بَ مِنَ التَقَلقُلِ وَالنُفورِ",8,"ر",1,0],["الآنَ إِذ لَفَّ النُهى","مِرَّةَ حَزمٍ بِمِرَر",9,"ر",1,0],["الآنَ جاءَت خُيولُ السِعدِ راكِضَةً","تَجري بِيَومٍ مُضيءِ الوَجهِ مَجدودِ",10,"د",1,0],["الآنَ أُطلِقَتِ النُصولُ وَرُشِّحَت","لِسَبيلِها قُبٌّ الأَياطِلِ قودُ",11,"د",1,0],["الآنَ أَطلُبُ ثاراتي بِمَقرَبَةٍ","خَدَعتُها عَن غَميرِ النَورِ وَالعُشُبِ",12,"ب",1,0],["أَلانَ جَوانِبي غَمزُ الخُطوبِ","وَأَعجَلَني الزَمانُ إِلى المَشيبِ",13,"ب",1,1],["الآنَ لَمّا صارَ مُرتَهَناً","قَلبي وَصارَ بِذِكرِكِ الشُغلُ",14,"ل",1,1],["ألا نفَسٌ يا رِيحُ منْ جانِبِ الحِمَى","ينفِّسُ منْ نارِ الجَوى بعْضَ تنْفيسِ",15,"س",1,0],["الآنَ بَيَّنَ لِلعُقولِ زَوالُهُ","أَنَّ الجِبالُ قُصارُهُنَّ زَوالُ",16,"ل",1,0],["أَلا نُفوسٌ أَبيّاتٌ لَها هِمَمٌ","أَما عَلى الخَيرِ أَنصارٌ وَأَعوانُ",17,"ن",1,0],["أَلا نَرَى فِي بَقَايَا الصَّرْحِ كَيْفَ مَضَوْا","بِأَوْجِهٍ بَادِيَاتِ البِشْرِ غُرَّانِ",18,"ن",1,0],["أَلانَ الرِّفْقُ جَانِبَهُ وَذَلَّتْ","مَدَامِعُهُ الأَبِيَّةُ مِنْ حَنَانِ",19,"ن",1,0],["أَلآنَ جُزْتَ الوَهْمَ مُرْتَقِياً","وَإِلَى الصَّوَابِ خَلَصْتَ مِنْ حُلُمِ",20,"م",1,0],["ألا نهضةٌ علميّة عربية","فتُنْعَشَ أرواح بها وعقول",21,"ل",1,0],["أَلا نادِ الظَعائِنَ لَو لَوَينا","وَلَولا مَن يُراقِبنَ اِرعَوَينا",22,"ن",2,0],["أَلا نَشكو إِلَيكَ زَمانَ مَحلٍ","وَشُربَ الماءِ في زَمَنِ الجَليدِ",23,"د",1,0],["الأَنفُسُ اِجتَمَعَت يَوماً أَوِ اِفتَرَقَت","إِذا تَأَمَّلتَ نَفسٌ وَالدِماءُ دَمُ",24,"م",1,0],["الآنَ حينَ عَرَفتُ رُش","دي وَاِغتَدَيتُ عَلى حَذَر",25,"ر",1,1],["ألا نادِ البرامكة انصروني","على الشعراء وانظر هل مُجيبُ",26,"ب",1,0],["الآنَ حين طلعتُ كلَّ ثَنيَّةٍ","ووطئتُ أبكارَ الكلامِ وَثيبَهُ",27,"ب",2,0],["الآنَ حين زَأَرْتُ واستمع العدا","زأْري وأَنذرَ كَلْبُ شَرٍّ ذِيبَهُ",27,"ب",2,0],["الآن حين سبقتُ كلَّ مسابقٍ","فتركتُ أسرعَ جريهِ تقريبَهُ",27,"ب",2,0],["الآنَ أسلمتُ إلى نعمةٍ","غنّاء نفساً كنت أقشَفْتُها",28,"ت",3,0],["الآن صرت البدر إذ حاكى لنا","كلفَ البدور مواضعُ التجدير",29,"ر",1,0],["الآن أيقنَ بعد غَدْرِكَ رائدي","أنّ البروقَ كواذبُ الإيماض",30,"ض",1,0],["الآن نام الخائفون وما","كانت تذوق عيونهم هجعه",31,"ع",2,0],["الآن أيقن من يشكُّ ويمتري","أن البقاعَ من البقاعِ تُدالُ",32,"ل",1,0],["ألا نَسّيا نفسي حديثَ البلابلِ","بمشمولةٍ صفراءَ من خَمرِ بابلِ",33,"ل",1,1],["الآن حين أجَدَّ الشيبُ يَطلبُني","أبادرُ الشَّيبَ باللذَّاتِ عجلانا",34,"ن",2,0],["أَلا نَبي لَو طَبَعنا الشَمسَ يَوماً","وَقَلَّدناكَها سَيفاً صَفيحا",35,"ح",2,1],["الآنَ أَيقَنتُ أَنّي كُنتُ واهِمَةً","وَأَنَّ ما كُلِّ بَرقٍ يَصحَبُ المَطَرا",36,"ر",2,0],["إِلّا نَجِيَّةَ آرابٍ تُقَلِّبُني","كَما تَقَلَّبَ في قُرموصِهِ الصَرِدُ",37,"د",1,0],["أَلا نادِ عيراً مِن بُثَينَةَ تَرتَعي","نُوَدِّع عَلى شَحطِ النَوى وَتُوَدِّعِ",38,"ع",1,1],["الانتقام ينادي","ويل لخصمك ويل",39,"ل",1,0],["الآن بان لي الرشاد بوجهه","وعرفت مصدر هذه الظلمات",40,"ت",1,0],["إِلّا نَهاراً في بَشاشَةِ صُبحِهِ","قَعَدَ البُناةُ وَقامَتِ الأَهرامُ",41,"م",1,0],["الأَناةَ الأَناةَ كُلُّ أَليفٍ","سابِقُ الإِلفِ أَو مُلاقي اِنفِرادِ",42,"د",1,0],["أَلِاَنَ عَلِمتُ أَنَّ البَعثَ حَقٌّ","وَأَنَّ اللَهَ يَفعَلُ ما يَشاءُ",43,"ا",2,1],["الآنَ أَقصَرتُ إِقصاراً مَلَكتُ بِهِ","مَقادَتي وَأَطَعتُ اللَهَ وَاللاحي",44,"ي",1,0],["أَلانَ اِبتَعَثتَ الرَأيَ غَيرَ مُثَبَّجٍ","بِهِ وَاِقتَبَلتَ الرُشدَ غَيرَ مُضاعِ",45,"ع",1,0],["الآنَ أَطمَعُ في هَواكَ وَدونَهُ","عَينُ الرَقيبِ وَبابُ إِبراهيمِ",46,"م",1,0],["الآنَ أَيقَنتُ أَنَّ الرِزقَ أَقسامُ","لَمّا تَقَلَّدَ أَمرَ البُردِ حَجّامُ",47,"م",1,1],["أَلانَ إِذا هَرَّت مَعَدٌ عُلالَتي","وَنابَي دُموعٍ لِلمُدِلّينَ مُصحِرِ",48,"ر",1,0],["الآنَ جنَّبني الزمانُ أذاتَه","وأعاد لي بُؤسي الحوادثَ أَنعُمَا",49,"م",2,0],["الآنَ قَصَّرَتِ النَّوائبُ فاغتدَتْ","بِنَدى الأميرِ كليلةَ الأنيابِ",50,"ب",1,0],["أَلا نَحنُ في دارٍ قَليلٍ بَقائُها","سَريعٍ تَدانيها وَشيكٍ فَنائُها",51,"ا",3,1],["الآنَ يا دُنيا عَرَفتُكِ فَاِذهَبي","يا دارَ كُلِّ تَشَتُّتٍ وَزَوالِ",52,"ل",1,0],["الآنَ أَبصَرتُ الضَلالَةَ وَالهُدى","وَالآنَ فيكِ قَبِلتُ مِن عُذّالي",53,"ل",2,0],["أَلا نادَت هِرَقلَةُ بِالخَرابِ","مِنَ المَلِكِ المُوَفَّقِ لِلصَوابِ",54,"ب",1,1],["الآنَ غَشَّاها الضبابُ وها أنا","خَلفَ المدامعِ والهمومِ أراها",55,"ا",3,0],["الآن أعرف ما الحياة وطيبُها","وأقول للأيّام طبتِ فعودي",56,"د",2,0],["الآن قد رُدَّ إلى ربه","فتى إلى الخلد مشوقٌ ظمي",57,"ي",1,0],["الآن قد أصبح في قربه","فتى لآفاق السما ينتمي",57,"ي",1,0],["الآن غشاها الضباب وها أنا","خلف المآسي والدموع أراها",58,"ا",1,0],["الآن أفْرَخَ رَوْعُ كلّ مُهَيَّدِ","وأُعِزّ دينُ مُحَمَّدٍ بِمُحَمَّدِ",59,"د",1,1],["أَلآنَ خُلِّيَتِ الذُؤبانُ في الغَنَمِ","وَصِرتَ أَضيَعَ مِن لَحمٍ عَلى وَضَمِ",60,"م",1,1],["الآنَ لَمّا صارَ حَوضَ الوارِدِ","وَغَدا وَأَصبَحَ عُرضَةً لِلرائِدِ",61,"د",1,1],["إِلّا نَدىً كَالدَينَ حَلَّ قَضاؤُهُ","إِنَّ الكَريمَ لِمُعتَفيهِ غَريمُ",62,"م",1,0],["الآنَ أَمسَت لِلنِفاقِ وَأَصبَحَت","عوراً عُيونٌ كُنَّ قَبلَكَ شوسا",63,"س",2,0],["الآنَ جُرِّدَتِ المَدائِحُ وَاِنتَهى","فَيضُ القَريضِ إِلى عُبابِ الوادي",64,"ي",1,0],["الآنَ طابَ سماعُهُ وتقطَّعَتْ","أطماعُهُ وتعزَّزتْ صنّاعُهُ",65,"ه",1,0],["الإنسُ والجنُّ يا أبهى الورى أتيا","يستجديانِكَ حسنَ الدلِّ والحورِ",66,"ر",1,0],["الآنَ سَحَّ غَمامُ النَصرِ فَاِنهَمَلا","وَقامَ صَغوُ عَمودِ الدينِ فَاِعتَدَلا",67,"ل",2,1],["أَلا نَسَخَ اللَهُ القُطارَ حِجارَةً","تَصوبُ عَلَينا وَالغَمامَ غُموما",68,"م",2,1],["ألا نجدةٌ تدرك الهالكين","ألا نفحةٌ من حنانٍ وبرّ",69,"ر",1,0],["الأَنبِياءُ وَرُسلُ اللَهِ نَعرِفُهُم","أَوفى الهُداةِ وَأَولاهُم بِتَفضيلِ",70,"ل",1,0],["أَلا نَبِيَّ لَنا مِنّا فَيُخبِرُنا","ما بُعدَ غايَتِنا مِن رأَسِ مَجرانا",71,"ن",2,0],["الآنَ سَرَّت فُؤادي مُقلَةُ الريمِ","وَاِهتَزَّ كَالغُصنِ في مَيلٍ وَتَقويمِ",72,"م",1,1],["الآنَ ناجى بِوَحيِ الحُبِّ عاشِقَهُ","وَاِستَعجَلَ اللَحظَ في وُدٍّ وَتَسليمِ",72,"م",1,0],["أَلا نَكَرَت شُرُّ شُجوني وَراعَها","نُحولٌ أَرَقَّ العَظمَ وَاِستَلَبَ الغُمضا",73,"ض",2,0],["الآنَ لّذَّتْ لنا مِصرٌ وساكِنُها","وللسَّوابِحِ والمَهْرِيّةِ الذُّمُل",74,"ل",1,0],["الآن طابَ وقد نما","حسنُ البهارِ على الشجَر",75,"ر",1,0],["أَلانَت لَنا يَومَ اِلتَقَينا حَديثَها","أَمانِيَّ وَعدٍ ثُمَّ زاغَت بِما تَعِد",76,"د",1,0],["الآنَ إِذ قامَتِ الرُواةُ بِنا","وَإِذ تَغَنَّت بِحُبِّنا العَرَبُ",77,"ب",1,0],["ألا نَبِّهْنَني قُيْنَاتِ بَثٍّ","بَشَمْنَ غَضىً فمِلْنَ إلى بَشامِ",78,"م",1,0],["الآنَ سُمِّيَتِ الخلافَةُ باسْمِها","كالبدْرِ يُقرَنُ بالسِّماك الأَعزلِ",79,"ل",1,0],["الآنَ لمَّا أَنْ حَوَيْتَ مَآثِراً","أَعْيَتْ عَدُوّاً في الوَرَى وحَسُودَا",80,"د",2,0],["الانَ استرحنا واِستراحَت من السرى","ركابٌ لنا تحت الحمولة تظلع",81,"ع",1,0],["الان انتهينا من مسافرة لنا","ببيداء قفر لِلَّذي جاب تفزع",81,"ع",1,0],["الان فرغنا من نزاع دوامه","يضر بحاجات الضَعيف وَيوقع",81,"ع",1,0],["ألا نهضة تدني الرجال من العلى","فَقَد طالَ في دار الهوان قعودُها",82,"د",3,1],["الأنوثةَ هذا الهوانْ","وفيها الدهاءُ القويُّ الجنانْ",83,"ن",1,0],["ألانَ فالْهُ عن الهَيْجاءِ مُغْتَبِطاً","طالَ امتِراؤكَ خِلْفَيْ نابِها الضَّبِسِ",84,"س",1,0],["ألانتِ الغادةَ التي امتنعت","فصح أنَّ العجوز قوَّاده",85,"ه",1,0],["أَلأَنْبِياءُ انْتَابَهُمْ زَمَنٌ بِهِ","لَزِمُوا التَّفَرُّدَ عَنْ رِضىً وَخِيَارِ",86,"ر",1,0],["أَلا نَغَمٌ إِلاَّ إذَا حَيَّتْ الصَّبَا","غَرِيبَ حِمىً طَالَتْ لَيَالِي بِعَادِهِ",87,"د",2,0],["إِلاَّ نِظَاماً فَصَّلُوهُ لِعَامِهِمْ","فَلَقَدْ أَقَامَ كَأَصْلِهِ المُتَنَائِي",88,"ا",2,0],["ألأَنّا من أفقِنا تطلُع الشمسُ","فتعطي الغداء حباً وبقلا",89,"ل",2,0],["ألأَنّا من صدرِنا ولِدَ الحُبُ","الذي شيّد الحضارةَ قبلا",89,"ل",2,0],["أَلانَ لِداودَ الحَديدَ بِقُدرَةٍ","مَليكٌ عَلى تَيسيرِ قَلبِكِ قادِرُ",90,"ر",1,0],["الآن قد برئت عيو","نُ الناس من هذا العمى",91,"م",2,0],["الآن أطلق صيحة محبوسة","فاض الإناء، وكاد صبريَ يودي!",92,"د",2,0],["الآنَ أُدْرِكُ سِرَّ زَفْرتهِ","إذ لم يَعُدْ سِرّاً تَجَلّده",93,"د",2,0],["ألا نستحي منْ أنْ يُقالَ بلادُهُمْ","عليها مِنَ الإذلالِ ضربةُ لازم",94,"م",1,0],["الآن يلتمسون فكّ وَثاقه","من بعد ما نزل البلاء وأحدقا",95,"ق",2,0],["ألآنَ يشربُ ما عتَّقتِ لا طفَحاً","يُخشى على خاطرٍ منه ولا حبَبا",96,"ب",2,0],["ألآنَ قولي إذا استوحشتِ خافقَه","هذا البصيرُ يُرينا آيةً عَجبا",96,"ب",2,0],["الآنَ أُنبيكَ اليقينَ كما جلا","وضَحُ \" الصَّباح \" عن العيون غياهبا",97,"ب",2,0],["ألآن، وَالعُذْرُ مَبسوطٌ لمُعْتَذِرٍ","وَالأمْنُ مُستَقْبَلٌ، وَالعَفُو مُقتبَلُ",98,"ل",1,0],["(ألا نبي)) ، لو طبعنا الشّمس يوما","وقلّدنا سيفا صفيحا",99,"ح",2,1],["أ لأني إذا هلكت عداتي","كل ما قد أحبت الحوباء",100,"ا",2,0],["الاننظرون الغرب كيف تسابقت","به الصحف في طُرق العلى والمحامد",101,"د",1,0]]}