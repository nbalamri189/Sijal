16.html","مخلع البسيط"],[506,"اطلت على افقك الزاهر","https://www.aldiwan.net/poem2425.html","المتقارب"],[515,"جاوز بمجدك أنجم الجوزاء","https://www.aldiwan.net/poem11996.html","الكامل"],[527,"يا دهر إنك بالرجال بصير","https://www.aldiwan.net/poem45971.html","الكامل"],[529,"نظام من الدر الثمين فرائده","https://www.aldiwan.net/poem37466.html","الطويل"],[540,"يا أيها الشاعر المكارم بالمدح","https://www.aldiwan.net/poem56716.html","المنسرح"],[551,"هي الدار موقوف عليك بكاها","https://www.aldiwan.net/poem47143.html","الطويل"],[553,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[558,"صدقت عباد الله أسماؤه الحسنى","https://www.aldiwan.net/poem33741.html","الخفيف"],[567,"الآن أشبه خده","https://www.aldiwan.net/poem69466.html","مجزوء الرجز"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["الآنَ أَعرَبَتِ الظُنونُ","وَعَلا عَلى الشَكِّ اليَقينُ",0,"ن",1,1],["أَلآنَ لَمّا اِمتَدَّ بي","طوبى وَأَصحَبَ لي القَرينُ",0,"ن",1,0],["أَلانَ جَذَبتَ مِن أَيدي اللَيالي","عِناني وَاِشتَمَلتَ عَلى زَمامي",1,"م",2,0],["الآنَ جَلَّلَني الوَقارُ رِداءَهُ","وَاِنجابَ عَن عَينَيَّ ذاكَ الغَيطَلُ",2,"ل",1,0],["الآنَ أَقبَلَ بي الوَقارُ عَنِ الصَبا","فَغَضَضتُ طَرفي وَالظِباءُ تَروقُ",3,"ق",1,0],["الآنَ يَعلَمُ أَنَّ العَيشَ مُختَلَسٌ","وَأَنَّنا نَقطَعُ الأَيّامَ بِالخِدَعِ",4,"ع",1,0],["أَلا ناشِداً ذاكَ الجَنابَ المُمَنَّعا","وَجُرداً يُناقِلنَ الوَشيجَ المُزَعزَعا",5,"ع",2,1],["أَلانَ رِدِ العَلاءَ بِلا رَقيبٍ","وَشَمِّر في الأُمورِ وَلا تُراعِ",6,"ع",1,0],["أَلانَ تَراجَعَت تِلكَ الرَعايا","وَجُهِّزَتِ الرَعِيَةُ لِلمَراعي",6,"ع",2,0],["الآنَ نِعمَ مَقيلُ التاجِ لِمَّتُهُ","وَنِعمَ مَغنى العُلى أَيّامُهُ الزُهُرُ",7,"ر",1,0],["الأَنَ أَعفَيتَ القُلو","بَ مِنَ التَقَلقُلِ وَالنُفورِ",8,"ر",1,0],["الآنَ إِذ لَفَّ النُهى","مِرَّةَ حَزمٍ بِمِرَر",9,"ر",1,0],["الآنَ جاءَت خُيولُ السِعدِ راكِضَةً","تَجري بِيَومٍ مُضيءِ الوَجهِ مَجدودِ",10,"د",1,0],["الآنَ أُطلِقَتِ النُصولُ وَرُشِّحَت","لِسَبيلِها قُبٌّ الأَياطِلِ قودُ",11,"د",1,0],["الآنَ أَطلُبُ ثاراتي بِمَقرَبَةٍ","خَدَعتُها عَن غَميرِ النَورِ وَالعُشُبِ",12,"ب",1,0],["أَلانَ جَوانِبي غَمزُ الخُطوبِ","وَأَعجَلَني الزَمانُ إِلى المَشيبِ",13,"ب",1,1],["ألأني حارس يا سيّدي ؟..","زوّجوها ثانيا ، المال يعمي",14,"م",2,0],["الآنَ لَمّا صارَ مُرتَهَناً","قَلبي وَصارَ بِذِكرِكِ الشُغلُ",15,"ل",1,1],["ألا نفَسٌ يا رِيحُ منْ جانِبِ الحِمَى","ينفِّسُ منْ نارِ الجَوى بعْضَ تنْفيسِ",16,"س",1,0],["الآنَ بَيَّنَ لِلعُقولِ زَوالُهُ","أَنَّ الجِبالُ قُصارُهُنَّ زَوالُ",17,"ل",1,0],["أَلا نُفوسٌ أَبيّاتٌ لَها هِمَمٌ","أَما عَلى الخَيرِ أَنصارٌ وَأَعوانُ",18,"ن",1,0],["أَلا نَرَى فِي بَقَايَا الصَّرْحِ كَيْفَ مَضَوْا","بِأَوْجِهٍ بَادِيَاتِ البِشْرِ غُرَّانِ",19,"ن",1,0],["أَلانَ الرِّفْقُ جَانِبَهُ وَذَلَّتْ","مَدَامِعُهُ الأَبِيَّةُ مِنْ حَنَانِ",20,"ن",1,0],["أَلآنَ جُزْتَ الوَهْمَ مُرْتَقِياً","وَإِلَى الصَّوَابِ خَلَصْتَ مِنْ حُلُمِ",21,"م",1,0],["ألا نهضةٌ علميّة عربية","فتُنْعَشَ أرواح بها وعقول",22,"ل",1,0],["أَلا نادِ الظَعائِنَ لَو لَوَينا","وَلَولا مَن يُراقِبنَ اِرعَوَينا",23,"ن",2,0],["أَلا نَشكو إِلَيكَ زَمانَ مَحلٍ","وَشُربَ الماءِ في زَمَنِ الجَليدِ",24,"د",1,0],["الأَنفُسُ اِجتَمَعَت يَوماً أَوِ اِفتَرَقَت","إِذا تَأَمَّلتَ نَفسٌ وَالدِماءُ دَمُ",25,"م",1,0],["الآنَ حينَ عَرَفتُ رُش","دي وَاِغتَدَيتُ عَلى حَذَر",26,"ر",1,1],["ألا نادِ البرامكة انصروني","على الشعراء وانظر هل مُجيبُ",27,"ب",1,0],["الآنَ حين طلعتُ كلَّ ثَنيَّةٍ","ووطئتُ أبكارَ الكلامِ وَثيبَهُ",28,"ب",2,0],["الآنَ حين زَأَرْتُ واستمع العدا","زأْري وأَنذرَ كَلْبُ شَرٍّ ذِيبَهُ",28,"ب",2,0],["الآن حين سبقتُ كلَّ مسابقٍ","فتركتُ أسرعَ جريهِ تقريبَهُ",28,"ب",2,0],["الآنَ أسلمتُ إلى نعمةٍ","غنّاء نفساً كنت أقشَفْتُها",29,"ت",3,0],["الآن صرت البدر إذ حاكى لنا","كلفَ البدور مواضعُ التجدير",30,"ر",1,0],["الآن أيقنَ بعد غَدْرِكَ رائدي","أنّ البروقَ كواذبُ الإيماض",31,"ض",1,0],["الآن نام الخائفون وما","كانت تذوق عيونهم هجعه",32,"ع",2,0],["الآن أيقن من يشكُّ ويمتري","أن البقاعَ من البقاعِ تُدالُ",33,"ل",1,0],["ألا نَسّيا نفسي حديثَ البلابلِ","بمشمولةٍ صفراءَ من خَمرِ بابلِ",34,"ل",1,1],["الآن حين أجَدَّ الشيبُ يَطلبُني","أبادرُ الشَّيبَ باللذَّاتِ عجلانا",35,"ن",2,0],["أَلا نَبي لَو طَبَعنا الشَمسَ يَوماً","وَقَلَّدناكَها سَيفاً صَفيحا",36,"ح",2,1],["الآنَ أَيقَنتُ أَنّي كُنتُ واهِمَةً","وَأَنَّ ما كُلِّ بَرقٍ يَصحَبُ المَطَرا",37,"ر",2,0],["إِلّا نَجِيَّةَ آرابٍ تُقَلِّبُني","كَما تَقَلَّبَ في قُرموصِهِ الصَرِدُ",38,"د",1,0],["أَلا نادِ عيراً مِن بُثَينَةَ تَرتَعي","نُوَدِّع عَلى شَحطِ النَوى وَتُوَدِّعِ",39,"ع",1,1],["الانتقام ينادي","ويل لخصمك ويل",40,"ل",1,0],["الآن بان لي الرشاد بوجهه","وعرفت مصدر هذه الظلمات",41,"ت",1,0],["إِلّا نَهاراً في بَشاشَةِ صُبحِهِ","قَعَدَ البُناةُ وَقامَتِ الأَهرامُ",42,"م",1,0],["الأَناةَ الأَناةَ كُلُّ أَليفٍ","سابِقُ الإِلفِ أَو مُلاقي اِنفِرادِ",43,"د",1,0],["أَلِاَنَ عَلِمتُ أَنَّ البَعثَ حَقٌّ","وَأَنَّ اللَهَ يَفعَلُ ما يَشاءُ",44,"ا",2,1],["الآنَ أَقصَرتُ إِقصاراً مَلَكتُ بِهِ","مَقادَتي وَأَطَعتُ اللَهَ وَاللاحي",45,"ي",1,0],["أَلانَ اِبتَعَثتَ الرَأيَ غَيرَ مُثَبَّجٍ","بِهِ وَاِقتَبَلتَ الرُشدَ غَيرَ مُضاعِ",46,"ع",1,0],["الآنَ أَطمَعُ في هَواكَ وَدونَهُ","عَينُ الرَقيبِ وَبابُ إِبراهيمِ",47,"م",1,0],["الآنَ أَيقَنتُ أَنَّ الرِزقَ أَقسامُ","لَمّا تَقَلَّدَ أَمرَ البُردِ حَجّامُ",48,"م",1,1],["أَلانَ إِذا هَرَّت مَعَدٌ عُلالَتي","وَنابَي دُموعٍ لِلمُدِلّينَ مُصحِرِ",49,"ر",1,0],["الآنَ جنَّبني الزمانُ أذاتَه","وأعاد لي بُؤسي الحوادثَ أَنعُمَا",50,"م",2,0],["الآنَ قَصَّرَتِ النَّوائبُ فاغتدَتْ","بِنَدى الأميرِ كليلةَ الأنيابِ",51,"ب",1,0],["أَلا نَحنُ في دارٍ قَليلٍ بَقائُها","سَريعٍ تَدانيها وَشيكٍ فَنائُها",52,"ا",3,1],["الآنَ يا دُنيا عَرَفتُكِ فَاِذهَبي","يا دارَ كُلِّ تَشَتُّتٍ وَزَوالِ",53,"ل",1,0],["الآنَ أَبصَرتُ الضَلالَةَ وَالهُدى","وَالآنَ فيكِ قَبِلتُ مِن عُذّالي",54,"ل",2,0],["أَلا نادَت هِرَقلَةُ بِالخَرابِ","مِنَ المَلِكِ المُوَفَّقِ لِلصَوابِ",55,"ب",1,1],["الآنَ غَشَّاها الضبابُ وها أنا","خَلفَ المدامعِ والهمومِ أراها",56,"ا",3,0],["الآن أعرف ما الحياة وطيبُها","وأقول للأيّام طبتِ فعودي",57,"د",2,0],["الآن قد رُدَّ إلى ربه","فتى إلى الخلد مشوقٌ ظمي",58,"ي",1,0],["الآن قد أصبح في قربه","فتى لآفاق السما ينتمي",58,"ي",1,0],["الآن غشاها الضباب وها أنا","خلف المآسي والدموع أراها",59,"ا",1,0],["الآن أفْرَخَ رَوْعُ كلّ مُهَيَّدِ","وأُعِزّ دينُ مُحَمَّدٍ بِمُحَمَّدِ",60,"د",1,1],["أَلآنَ خُلِّيَتِ الذُؤبانُ في الغَنَمِ","وَصِرتَ أَضيَعَ مِن لَحمٍ عَلى وَضَمِ",61,"م",1,1],["الآنَ لَمّا صارَ حَوضَ الوارِدِ","وَغَدا وَأَصبَحَ عُرضَةً لِلرائِدِ",62,"د",1,1],["إِلّا نَدىً كَالدَينَ حَلَّ قَضاؤُهُ","إِنَّ الكَريمَ لِمُعتَفيهِ غَريمُ",63,"م",1,0],["الآنَ أَمسَت لِلنِفاقِ وَأَصبَحَت","عوراً عُيونٌ كُنَّ قَبلَكَ شوسا",64,"س",2,0],["الآنَ جُرِّدَتِ المَدائِحُ وَاِنتَهى","فَيضُ القَريضِ إِلى عُبابِ الوادي",65,"ي",1,0],["الآنَ طابَ سماعُهُ وتقطَّعَتْ","أطماعُهُ وتعزَّزتْ صنّاعُهُ",66,"ه",1,0],["الإنسُ والجنُّ يا أبهى الورى أتيا","يستجديانِكَ حسنَ الدلِّ والحورِ",67,"ر",1,0],["الآنَ سَحَّ غَمامُ النَصرِ فَاِنهَمَلا","وَقامَ صَغوُ عَمودِ الدينِ فَاِعتَدَلا",68,"ل",2,1],["أَلا نَسَخَ اللَهُ القُطارَ حِجارَةً","تَصوبُ عَلَينا وَالغَمامَ غُموما",69,"م",2,1],["ألا نجدةٌ تدرك الهالكين","ألا نفحةٌ من حنانٍ وبرّ",70,"ر",1,0],["الأَنبِياءُ وَرُسلُ اللَهِ نَعرِفُهُم","أَوفى الهُداةِ وَأَولاهُم بِتَفضيلِ",71,"ل",1,0],["أَلا نَبِيَّ لَنا مِنّا فَيُخبِرُنا","ما بُعدَ غايَتِنا مِن رأَسِ مَجرانا",72,"ن",2,0],["الآنَ سَرَّت فُؤادي مُقلَةُ الريمِ","وَاِهتَزَّ كَالغُصنِ في مَيلٍ وَتَقويمِ",73,"م",1,1],["الآنَ ناجى بِوَحيِ الحُبِّ عاشِقَهُ","وَاِستَعجَلَ اللَحظَ في وُدٍّ وَتَسليمِ",73,"م",1,0],["أَلا نَكَرَت شُرُّ شُجوني وَراعَها","نُحولٌ أَرَقَّ العَظمَ وَاِستَلَبَ الغُمضا",74,"ض",2,0],["الآنَ لّذَّتْ لنا مِصرٌ وساكِنُها","وللسَّوابِحِ والمَهْرِيّةِ الذُّمُل",75,"ل",1,0],["الآن طابَ وقد نما","حسنُ البهارِ على الشجَر",76,"ر",1,0],["أَلانَت لَنا يَومَ اِلتَقَينا حَديثَها","أَمانِيَّ وَعدٍ ثُمَّ زاغَت بِما تَعِد",77,"د",1,0],["الآنَ إِذ قامَتِ الرُواةُ بِنا","وَإِذ تَغَنَّت بِحُبِّنا العَرَبُ",78,"ب",1,0],["ألا نَبِّهْنَني قُيْنَاتِ بَثٍّ","بَشَمْنَ غَضىً فمِلْنَ إلى بَشامِ",79,"م",1,0],["الآنَ سُمِّيَتِ الخلافَةُ باسْمِها","كالبدْرِ يُقرَنُ بالسِّماك الأَعزلِ",80,"ل",1,0],["الآنَ لمَّا أَنْ حَوَيْتَ مَآثِراً","أَعْيَتْ عَدُوّاً في الوَرَى وحَسُودَا",81,"د",2,0],["الانَ استرحنا واِستراحَت من السرى","ركابٌ لنا تحت الحمولة تظلع",82,"ع",1,0],["الان انتهينا من مسافرة لنا","ببيداء قفر لِلَّذي جاب تفزع",82,"ع",1,0],["الان فرغنا من نزاع دوامه","يضر بحاجات الضَعيف وَيوقع",82,"ع",1,0],["ألا نهضة تدني الرجال من العلى","فَقَد طالَ في دار الهوان قعودُها",83,"د",3,1],["الأنوثةَ هذا الهوانْ","وفيها الدهاءُ القويُّ الجنانْ",84,"ن",1,0],["ألانَ فالْهُ عن الهَيْجاءِ مُغْتَبِطاً","طالَ امتِراؤكَ خِلْفَيْ نابِها الضَّبِسِ",85,"س",1,0],["ألانتِ الغادةَ التي امتنعت","فصح أنَّ العجوز قوَّاده",86,"ه",1,0],["أَلأَنْبِياءُ انْتَابَهُمْ زَمَنٌ بِهِ","لَزِمُوا التَّفَرُّدَ عَنْ رِضىً وَخِيَارِ",87,"ر",1,0],["أَلا نَغَمٌ إِلاَّ إذَا حَيَّتْ الصَّبَا","غَرِيبَ حِمىً طَالَتْ لَيَالِي بِعَادِهِ",88,"د",2,0],["إِلاَّ نِظَاماً فَصَّلُوهُ لِعَامِهِمْ","فَلَقَدْ أَقَامَ كَأَصْلِهِ المُتَنَائِي",89,"ا",2,0],["ألأَنّا من أفقِنا تطلُع الشمسُ","فتعطي الغداء حباً وبقلا",90,"ل",2,0],["ألأَنّا من صدرِنا ولِدَ الحُبُ","الذي شيّد الحضارةَ قبلا",90,"ل",2,0],["أَلانَ لِداودَ الحَديدَ بِقُدرَةٍ","مَليكٌ عَلى تَيسيرِ قَلبِكِ قادِرُ",91,"ر",1,0],["الآن قد برئت عيو","نُ الناس من هذا العمى",92,"م",2,0],["الآن أطلق صيحة محبوسة","فاض الإناء، وكاد صبريَ يودي!",93,"د",2,0],["الانفجار المبتدي عادة","يعطي رمادا ، قد تسميه نار",94,"ر",1,0],["الآنَ أُدْرِكُ سِرَّ زَفْرتهِ","إذ لم يَعُدْ سِرّاً تَجَلّده",95,"د",2,0],["ألا نستحي منْ أنْ يُقالَ بلادُهُمْ","عليها مِنَ الإذلالِ ضربةُ لازم",96,"م",1,0],["الآن يلتمسون فكّ وَثاقه","من بعد ما نزل البلاء وأحدقا",97,"ق",2,0],["ألآنَ يشربُ ما عتَّقتِ لا طفَحاً","يُخشى على خاطرٍ منه ولا حبَبا",98,"ب",2,0],["ألآنَ قولي إذا استوحشتِ خافقَه","هذا البصيرُ يُرينا آيةً عَجبا",98,"ب",2,0],["الآنَ أُنبيكَ اليقينَ كما جلا","وضَحُ \" الصَّباح \" عن العيون غياهبا",99,"ب",2,0],["ألآن، وَالعُذْرُ مَبسوطٌ لمُعْتَذِرٍ","وَالأمْنُ مُستَقْبَلٌ، وَالعَفُو مُقتبَلُ",100,"ل",1,0],["(ألا نبي)) ، لو طبعنا الشّمس يوما","وقلّدنا سيفا صفيحا",101,"ح",2,1],["أ لأني إذا هلكت عداتي","كل ما ق