كبان سارية","https://www.aldiwan.net/poem37740.html","البسيط"],[508,"الآن قد أيقن ابن رشد","https://www.aldiwan.net/poem2416.html","مخلع البسيط"],[508,"اطلت على افقك الزاهر","https://www.aldiwan.net/poem2425.html","المتقارب"],[517,"جاوز بمجدك أنجم الجوزاء","https://www.aldiwan.net/poem11996.html","الكامل"],[529,"يا دهر إنك بالرجال بصير","https://www.aldiwan.net/poem45971.html","الكامل"],[531,"نظام من الدر الثمين فرائده","https://www.aldiwan.net/poem37466.html","الطويل"],[542,"يا أيها الشاعر المكارم بالمدح","https://www.aldiwan.net/poem56716.html","المنسرح"],[553,"هي الدار موقوف عليك بكاها","https://www.aldiwan.net/poem47143.html","الطويل"],[555,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[560,"صدقت عباد الله أسماؤه الحسنى","https://www.aldiwan.net/poem33741.html","الخفيف"],[569,"الآن أشبه خده","https://www.aldiwan.net/poem69466.html","مجزوء الرجز"],[570,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[657,"","https://poetry.dctabudhabi.ae/diwan/poem/29498","الكامل"],[977,"","https://poetry.dctabudhabi.ae/diwan/poem/143336","الكامل"],[1026,"","https://poetry.dctabudhabi.ae/diwan/poem/20535","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/21380","الوافر"],[1178,"","https://poetry.dctabudhabi.ae/diwan/poem/28424","الكامل"]],"verses":[["ألان له حديد الحرف عقل","أذاب الروح لا قِطرا مشابا",0,"ب",2,0],["الآنَ أَعرَبَتِ الظُنونُ","وَعَلا عَلى الشَكِّ اليَقينُ",1,"ن",1,1],["أَلآنَ لَمّا اِمتَدَّ بي","طوبى وَأَصحَبَ لي القَرينُ",1,"ن",1,0],["أَلانَ جَذَبتَ مِن أَيدي اللَيالي","عِناني وَاِشتَمَلتَ عَلى زَمامي",2,"م",2,0],["الآنَ جَلَّلَني الوَقارُ رِداءَهُ","وَاِنجابَ عَن عَينَيَّ ذاكَ الغَيطَلُ",3,"ل",1,0],["الآنَ أَقبَلَ بي الوَقارُ عَنِ الصَبا","فَغَضَضتُ طَرفي وَالظِباءُ تَروقُ",4,"ق",1,0],["الآنَ يَعلَمُ أَنَّ العَيشَ مُختَلَسٌ","وَأَنَّنا نَقطَعُ الأَيّامَ بِالخِدَعِ",5,"ع",1,0],["أَلا ناشِداً ذاكَ الجَنابَ المُمَنَّعا","وَجُرداً يُناقِلنَ الوَشيجَ المُزَعزَعا",6,"ع",2,1],["أَلانَ رِدِ العَلاءَ بِلا رَقيبٍ","وَشَمِّر في الأُمورِ وَلا تُراعِ",7,"ع",1,0],["أَلانَ تَراجَعَت تِلكَ الرَعايا","وَجُهِّزَتِ الرَعِيَةُ لِلمَراعي",7,"ع",2,0],["الآنَ نِعمَ مَقيلُ التاجِ لِمَّتُهُ","وَنِعمَ مَغنى العُلى أَيّامُهُ الزُهُرُ",8,"ر",1,0],["الأَنَ أَعفَيتَ القُلو","بَ مِنَ التَقَلقُلِ وَالنُفورِ",9,"ر",1,0],["الآنَ إِذ لَفَّ النُهى","مِرَّةَ حَزمٍ بِمِرَر",10,"ر",1,0],["الآنَ جاءَت خُيولُ السِعدِ راكِضَةً","تَجري بِيَومٍ مُضيءِ الوَجهِ مَجدودِ",11,"د",1,0],["الآنَ أُطلِقَتِ النُصولُ وَرُشِّحَت","لِسَبيلِها قُبٌّ الأَياطِلِ قودُ",12,"د",1,0],["الآنَ أَطلُبُ ثاراتي بِمَقرَبَةٍ","خَدَعتُها عَن غَميرِ النَورِ وَالعُشُبِ",13,"ب",1,0],["أَلانَ جَوانِبي غَمزُ الخُطوبِ","وَأَعجَلَني الزَمانُ إِلى المَشيبِ",14,"ب",1,1],["ألأني حارس يا سيّدي ؟..","زوّجوها ثانيا ، المال يعمي",15,"م",2,0],["الآنَ لَمّا صارَ مُرتَهَناً","قَلبي وَصارَ بِذِكرِكِ الشُغلُ",16,"ل",1,1],["ألا نفَسٌ يا رِيحُ منْ جانِبِ الحِمَى","ينفِّسُ منْ نارِ الجَوى بعْضَ تنْفيسِ",17,"س",1,0],["الآنَ بَيَّنَ لِلعُقولِ زَوالُهُ","أَنَّ الجِبالُ قُصارُهُنَّ زَوالُ",18,"ل",1,0],["أَلا نُفوسٌ أَبيّاتٌ لَها هِمَمٌ","أَما عَلى الخَيرِ أَنصارٌ وَأَعوانُ",19,"ن",1,0],["أَلا نَرَى فِي بَقَايَا الصَّرْحِ كَيْفَ مَضَوْا","بِأَوْجِهٍ بَادِيَاتِ البِشْرِ غُرَّانِ",20,"ن",1,0],["أَلانَ الرِّفْقُ جَانِبَهُ وَذَلَّتْ","مَدَامِعُهُ الأَبِيَّةُ مِنْ حَنَانِ",21,"ن",1,0],["أَلآنَ جُزْتَ الوَهْمَ مُرْتَقِياً","وَإِلَى الصَّوَابِ خَلَصْتَ مِنْ حُلُمِ",22,"م",1,0],["ألا نهضةٌ علميّة عربية","فتُنْعَشَ أرواح بها وعقول",23,"ل",1,0],["أَلا نادِ الظَعائِنَ لَو لَوَينا","وَلَولا مَن يُراقِبنَ اِرعَوَينا",24,"ن",2,0],["أَلا نَشكو إِلَيكَ زَمانَ مَحلٍ","وَشُربَ الماءِ في زَمَنِ الجَليدِ",25,"د",1,0],["الأَنفُسُ اِجتَمَعَت يَوماً أَوِ اِفتَرَقَت","إِذا تَأَمَّلتَ نَفسٌ وَالدِماءُ دَمُ",26,"م",1,0],["الآنَ حينَ عَرَفتُ رُش","دي وَاِغتَدَيتُ عَلى حَذَر",27,"ر",1,1],["ألا نادِ البرامكة انصروني","على الشعراء وانظر هل مُجيبُ",28,"ب",1,0],["الآنَ حين طلعتُ كلَّ ثَنيَّةٍ","ووطئتُ أبكارَ الكلامِ وَثيبَهُ",29,"ب",2,0],["الآنَ حين زَأَرْتُ واستمع العدا","زأْري وأَنذرَ كَلْبُ شَرٍّ ذِيبَهُ",29,"ب",2,0],["الآن حين سبقتُ كلَّ مسابقٍ","فتركتُ أسرعَ جريهِ تقريبَهُ",29,"ب",2,0],["الآنَ أسلمتُ إلى نعمةٍ","غنّاء نفساً كنت أقشَفْتُها",30,"ت",3,0],["الآن صرت البدر إذ حاكى لنا","كلفَ البدور مواضعُ التجدير",31,"ر",1,0],["الآن أيقنَ بعد غَدْرِكَ رائدي","أنّ البروقَ كواذبُ الإيماض",32,"ض",1,0],["الآن نام الخائفون وما","كانت تذوق عيونهم هجعه",33,"ع",2,0],["الآن أيقن من يشكُّ ويمتري","أن البقاعَ من البقاعِ تُدالُ",34,"ل",1,0],["ألا نَسّيا نفسي حديثَ البلابلِ","بمشمولةٍ صفراءَ من خَمرِ بابلِ",35,"ل",1,1],["الآن حين أجَدَّ الشيبُ يَطلبُني","أبادرُ الشَّيبَ باللذَّاتِ عجلانا",36,"ن",2,0],["أَلا نَبي لَو طَبَعنا الشَمسَ يَوماً","وَقَلَّدناكَها سَيفاً صَفيحا",37,"ح",2,1],["الآنَ أَيقَنتُ أَنّي كُنتُ واهِمَةً","وَأَنَّ ما كُلِّ بَرقٍ يَصحَبُ المَطَرا",38,"ر",2,0],["إِلّا نَجِيَّةَ آرابٍ تُقَلِّبُني","كَما تَقَلَّبَ في قُرموصِهِ الصَرِدُ",39,"د",1,0],["أَلا نادِ عيراً مِن بُثَينَةَ تَرتَعي","نُوَدِّع عَلى شَحطِ النَوى وَتُوَدِّعِ",40,"ع",1,1],["الانتقام ينادي","ويل لخصمك ويل",41,"ل",1,0],["الآن بان لي الرشاد بوجهه","وعرفت مصدر هذه الظلمات",42,"ت",1,0],["إِلّا نَهاراً في بَشاشَةِ صُبحِهِ","قَعَدَ البُناةُ وَقامَتِ الأَهرامُ",43,"م",1,0],["الأَناةَ الأَناةَ كُلُّ أَليفٍ","سابِقُ الإِلفِ أَو مُلاقي اِنفِرادِ",44,"د",1,0],["أَلِاَنَ عَلِمتُ أَنَّ البَعثَ حَقٌّ","وَأَنَّ اللَهَ يَفعَلُ ما يَشاءُ",45,"ا",2,1],["الآنَ أَقصَرتُ إِقصاراً مَلَكتُ بِهِ","مَقادَتي وَأَطَعتُ اللَهَ وَاللاحي",46,"ح",2,0],["أَلانَ اِبتَعَثتَ الرَأيَ غَيرَ مُثَبَّجٍ","بِهِ وَاِقتَبَلتَ الرُشدَ غَيرَ مُضاعِ",47,"ع",1,0],["الآنَ أَطمَعُ في هَواكَ وَدونَهُ","عَينُ الرَقيبِ وَبابُ إِبراهيمِ",48,"م",1,0],["الآنَ أَيقَنتُ أَنَّ الرِزقَ أَقسامُ","لَمّا تَقَلَّدَ أَمرَ البُردِ حَجّامُ",49,"م",1,1],["أَلانَ إِذا هَرَّت مَعَدٌ عُلالَتي","وَنابَي دُموعٍ لِلمُدِلّينَ مُصحِرِ",50,"ر",1,0],["الآنَ جنَّبني الزمانُ أذاتَه","وأعاد لي بُؤسي الحوادثَ أَنعُمَا",51,"م",2,0],["الآنَ قَصَّرَتِ النَّوائبُ فاغتدَتْ","بِنَدى الأميرِ كليلةَ الأنيابِ",52,"ب",1,0],["أَلا نَحنُ في دارٍ قَليلٍ بَقائُها","سَريعٍ تَدانيها وَشيكٍ فَنائُها",53,"ا",3,1],["الآنَ يا دُنيا عَرَفتُكِ فَاِذهَبي","يا دارَ كُلِّ تَشَتُّتٍ وَزَوالِ",54,"ل",1,0],["الآنَ أَبصَرتُ الضَلالَةَ وَالهُدى","وَالآنَ فيكِ قَبِلتُ مِن عُذّالي",55,"ل",2,0],["أَلا نادَت هِرَقلَةُ بِالخَرابِ","مِنَ المَلِكِ المُوَفَّقِ لِلصَوابِ",56,"ب",1,1],["الآنَ غَشَّاها الضبابُ وها أنا","خَلفَ المدامعِ والهمومِ أراها",57,"ا",3,0],["الآن أعرف ما الحياة وطيبُها","وأقول للأيّام طبتِ فعودي",58,"د",2,0],["الآن قد رُدَّ إلى ربه","فتى إلى الخلد مشوقٌ ظمي",59,"م",2,0],["الآن قد أصبح في قربه","فتى لآفاق السما ينتمي",59,"م",2,0],["الآن غشاها الضباب وها أنا","خلف المآسي والدموع أراها",60,"ا",1,0],["الآن أفْرَخَ رَوْعُ كلّ مُهَيَّدِ","وأُعِزّ دينُ مُحَمَّدٍ بِمُحَمَّدِ",61,"د",1,1],["أَلآنَ خُلِّيَتِ الذُؤبانُ في الغَنَمِ","وَصِرتَ أَضيَعَ مِن لَحمٍ عَلى وَضَمِ",62,"م",1,1],["الآنَ لَمّا صارَ حَوضَ الوارِدِ","وَغَدا وَأَصبَحَ عُرضَةً لِلرائِدِ",63,"د",1,1],["إِلّا نَدىً كَالدَينَ حَلَّ قَضاؤُهُ","إِنَّ الكَريمَ لِمُعتَفيهِ غَريمُ",64,"م",1,0],["الآنَ أَمسَت لِلنِفاقِ وَأَصبَحَت","عوراً عُيونٌ كُنَّ قَبلَكَ شوسا",65,"س",2,0],["الآنَ جُرِّدَتِ المَدائِحُ وَاِنتَهى","فَيضُ القَريضِ إِلى عُبابِ الوادي",66,"د",2,0],["الآنَ طابَ سماعُهُ وتقطَّعَتْ","أطماعُهُ وتعزَّزتْ صنّاعُهُ",67,"ه",1,0],["الإنسُ والجنُّ يا أبهى الورى أتيا","يستجديانِكَ حسنَ الدلِّ والحورِ",68,"ر",1,0],["الآنَ سَحَّ غَمامُ النَصرِ فَاِنهَمَلا","وَقامَ صَغوُ عَمودِ الدينِ فَاِعتَدَلا",69,"ل",2,1],["أَلا نَسَخَ اللَهُ القُطارَ حِجارَةً","تَصوبُ عَلَينا وَالغَمامَ غُموما",70,"م",2,1],["ألا نجدةٌ تدرك الهالكين","ألا نفحةٌ من حنانٍ وبرّ",71,"ر",1,0],["الأَنبِياءُ وَرُسلُ اللَهِ نَعرِفُهُم","أَوفى الهُداةِ وَأَولاهُم بِتَفضيلِ",72,"ل",1,0],["أَلا نَبِيَّ لَنا مِنّا فَيُخبِرُنا","ما بُعدَ غايَتِنا مِن رأَسِ مَجرانا",73,"ن",2,0],["الآنَ سَرَّت فُؤادي مُقلَةُ الريمِ","وَاِهتَزَّ كَالغُصنِ في مَيلٍ وَتَقويمِ",74,"م",1,1],["الآنَ ناجى بِوَحيِ الحُبِّ عاشِقَهُ","وَاِستَعجَلَ اللَحظَ في وُدٍّ وَتَسليمِ",74,"م",1,0],["أَلا نَكَرَت شُرُّ شُجوني وَراعَها","نُحولٌ أَرَقَّ العَظمَ وَاِستَلَبَ الغُمضا",75,"ض",2,0],["الآنَ لّذَّتْ لنا مِصرٌ وساكِنُها","وللسَّوابِحِ والمَهْرِيّةِ الذُّمُل",76,"ل",1,0],["الآن طابَ وقد نما","حسنُ البهارِ على الشجَر",77,"ر",1,0],["أَلانَت لَنا يَومَ اِلتَقَينا حَديثَها","أَمانِيَّ وَعدٍ ثُمَّ زاغَت بِما تَعِد",78,"د",1,0],["الآنَ إِذ قامَتِ الرُواةُ بِنا","وَإِذ تَغَنَّت بِحُبِّنا العَرَبُ",79,"ب",1,0],["ألا نَبِّهْنَني قُيْنَاتِ بَثٍّ","بَشَمْنَ غَضىً فمِلْنَ إلى بَشامِ",80,"م",1,0],["الآنَ سُمِّيَتِ الخلافَةُ باسْمِها","كالبدْرِ يُقرَنُ بالسِّماك الأَعزلِ",81,"ل",1,0],["الآنَ لمَّا أَنْ حَوَيْتَ مَآثِراً","أَعْيَتْ عَدُوّاً في الوَرَى وحَسُودَا",82,"د",2,0],["الانَ استرحنا واِستراحَت من السرى","ركابٌ لنا تحت الحمولة تظلع",83,"ع",1,0],["الان انتهينا من مسافرة لنا","ببيداء قفر لِلَّذي جاب تفزع",83,"ع",1,0],["الان فرغنا من نزاع دوامه","يضر بحاجات الضَعيف وَيوقع",83,"ع",1,0],["ألا نهضة تدني الرجال من العلى","فَقَد طالَ في دار الهوان قعودُها",84,"د",3,1],["أَلاَ نَادِيا رَبْعِيْ كُبَيْشَةَ باللَّوى","بِحَاجَةِ مَحْزونٍ وإِنْ لَمْ يُنادِيَا",85,"ي",2,1],["الأنوثةَ هذا الهوانْ","وفيها الدهاءُ القويُّ الجنانْ",86,"ن",1,0],["ألانَ فالْهُ عن الهَيْجاءِ مُغْتَبِطاً","طالَ امتِراؤكَ خِلْفَيْ نابِها الضَّبِسِ",87,"س",1,0],["ألانتِ الغادةَ التي امتنعت","فصح أنَّ العجوز قوَّاده",88,"ه",1,0],["أَلأَنْبِياءُ انْتَابَهُمْ زَمَنٌ بِهِ","لَزِمُوا التَّفَرُّدَ عَنْ رِضىً وَخِيَارِ",89,"ر",1,0],["أَلا نَغَمٌ إِلاَّ إذَا حَيَّتْ الصَّبَا","غَرِيبَ حِمىً طَالَتْ لَيَالِي بِعَادِهِ",90,"د",2,0],["إِلاَّ نِظَاماً فَصَّلُوهُ لِعَامِهِمْ","فَلَقَدْ أَقَامَ كَأَصْلِهِ المُتَنَائِي",91,"ا",2,0],["ألأَنّا من أفقِنا تطلُع الشمسُ","فتعطي الغداء حباً وبقلا",92,"ل",2,0],["ألأَنّا من صدرِنا ولِدَ الحُبُ","الذي شيّد الحضارةَ قبلا",92,"ل",2,0],["أَلانَ لِداودَ الحَديدَ بِقُدرَةٍ","مَليكٌ عَلى تَيسيرِ قَلبِكِ قادِرُ",93,"ر",1,0],["الآن قد برئت عيو","نُ الناس من هذا العمى",94,"م",2,0],["الآن أطلق صيحة محبوسة","فاض الإناء، وكاد صبريَ يودي!",95,"د",2,0],["الانفجار المبتدي عادة","يعطي رمادا ، قد تسميه نار",96,"ر",1,0],["الآنَ أُدْرِكُ سِرَّ زَفْرتهِ","إذ لم يَعُدْ سِرّاً تَجَلّده",97,"د",2,0],["ألا نستحي منْ أنْ يُقالَ بلادُهُمْ","عليها مِنَ الإذلالِ ضربةُ لازم",98,"م",1,0],["الآن يلتمسون فكّ وَثاقه","من بعد ما نزل البلاء وأحدقا",99,"ق",2,0],["ألآنَ يشربُ ما عتَّقتِ لا طفَحاً","يُخشى على خاطرٍ منه ولا حبَبا",100,"ب",2,0],["ألآنَ قولي إذا استوحشتِ خافقَه","هذا البصيرُ يُرينا آيةً عَجبا",100,"ب",2,0],["الآنَ أُنبيكَ اليقينَ كما جلا","وضَحُ \" الصَّباح \" عن العيون غياهبا",101,"ب",2,0],["ألآن، وَالعُذْرُ مَبسوطٌ لمُعْتَذِرٍ","وَالأمْنُ مُستَقْبَلٌ، وَالعَفُو مُقتبَلُ",102,"ل",1,0],["(ألا نبي)) ، لو طبعنا الشّمس يوما","وقلّدنا سيفا صفيحا",103,"ح",2,1],["أ لأني إذا هلكت عداتي","كل ما قد أحبت الحوباء",104,"ا",2,0],["أَلأَنِّيْ مَأْجُوْرٌ أَضْحَىْ","قَتْلِيْ بِدَمِ الْقَتْلَىْ أَجْرِيْ",105,"ر",2,0],["ألأنّي يا موطني … أتجزأ","قطعا من هواك في كلّ رقعه",106,"ع",2,0],["الاننظرون الغرب كيف تسابقت","به الصحف في طُرق العلى والمحامد",107,"د",1,0],["ألأن كسوته ممزقة","وهيئته زرية",108,"ي",2,0],["الآنَ أَبصَرتُ الهُدى","وَعَلا المَشيبُ مَفارِقي",109,"ق",2,0],["اَلانَ رأينا في مجالس عزِّها","مجالسَ تُملاَ بالعَلاء صدورُها",110,"ر",3,0],["الآن إذ كشفَتْ عن ساقها ورمت","قناعَها الحربُ والفُرسان أغمارُ",111,"ر",1,0],["إِلا نُجومٌ أَنارَتْ","كالدُّرِّ في لازَوَرْدِ",112,"د",1,0],["الآن طأطأ كل غر رأسه","متواضعا وصحى ذوو السكرات",113,"ت",1,0],["الآن حِينَ مَلأتَ قَلْبِي رَغْبَةً","أَعْقَبْتهَا ظُلْماً بِيَأْسٍ قادِحِ",114,"ح",1,0],["الإنسُ والجنّ والأملاك شاهدةٌ","بِها وتَوراةُ موسى والأناجيلُ",115,"ل",1,0],["الآن طب يا قلبُ وارقص في السما","فلقد سقتك وجنّحَتكَ وعربد",116,"د",1,0],["الآن لما بدا في وجهك الشعرُ","رأيتُ فيك الذي قد كنتُ أنتظرُ",117,"ر",1,1],["الآن طِبتَ إذ التَحيتَ وإنما","غصن الفواكه حين يورق يُثمرُ",118,"ر",1,0],["الإنجليز رمموني ها هنا سحرا","والدهر يضرب أحجاراً بأحجار",119,"ر",1,0],["أَلِأَنّي بَذَلت حُبّي وَلَم أُط","عِمكَ مِنهُ سِوى الفَتات الباقي",120,"ق",2,0],["أَلِأَنَّهُ هجرَ الحُقولَ وَبردَها","وَأَتى يغرِّدُ في زَوايا مخدَعي",121,"ع",2,0],["ألا نَم معَ الأَبرارِ في الخُلدِ ناعِماً","فكم بِتَّ فينا ساهِرَ العَزمِ عانِيا",122,"ي",2,0],["الآن قَدَّ الفؤاد نصفَينِ","فيه وأَجَرى الدموعَ نوعَين",123,"ن",1,1],["الآن لاقيت الخطوب محارباً","وعلمت أني أفضل الأعمام",124,"م",1,0],["إِلاَّ نِفَاراً هُوَ فِي طَبْعِهِ","إِنَّ نِفَارَ الظَّبْيِ منْ خِلْقَتِهِ",125,"ت",2,0],["أَلاَ نَفْحَةٌ مِنْ رٌبَى وَصْلِهِمُ","تُبَرِّدُ مَا بِالنَّوَى قَدْ كَوَوْا",126,"و",2,0],["الإنكليزُ جيوشُهم جرارةٌ","وجنودُهم تغتالُ أو تصطاد",127,"د",1,0],["الإنكيزُ استبدوا واليهودُ بَغَوا","مستضحكينَ لدمعِ المسلمِ الباكي",128,"ك",2,0],["ألانَتْ لَهُ الصَّعْبَ الأَبِيَّ كَتَائِبٌ","مِنَ العَزْمِ تَسْتَشْلِي كَتائِبَه الخُشْنا",129,"ن",2,0],["اَلآنَ قَدْ هَجَرَتْ نَفْسِي غَوايَتَها","وَحانَ بَعْدَ حُلُولِ الشِّيْبِ إِقْصارِي",130,"ر",2,0],["الآنَ لانَ لِيَ الزَمانُ فَأَعتَبا","وَاِنقادَ مِن بَعدِ الشِماسِ فَأَصحَبا",131,"ب",2,1],["الآنَ أَضحى الجودُ فينا عامِراً","مُشَيَّداً وَكانَ قِدماً قَد خَرِب",132,"ب",1,0],["الآن أحرز آمالي وأدرِكُها","بماجِدٍ غير ذي مَنٍّ ولا ضَجرِ",133,"ر",1,0],["أَلان لمعناه المقالةَ ربُّه","وَليِّنة المرّان أَنفذها كَلءما",134,"م",2,0],["أَلان لمعناه المقالة ربه","فأَبقى به (شيخ المعرةِ) عاريا",135,"ي",2,0],["الآنَ شمسكُ قد تقلّص نورها","عَن عينِ جسم قَد عراه تقشّعُ",136,"ع",1,0],["أَلا نضّ جِلباباً عَن الليمِ أَخضرا","تَجد فيه فانيداً يَسيل وَسكّرا",137,"ر",2,1],["الأُنسُ سادَ بِرُتبَةِ الجَمالِ","وَبِها البَشائِرُ قَد أَنَ جَمالي",138,"ل",2,1],["الأنيقُ الرشيق والسلسل الرق","راق صافي الخيال والمرآة",139,"ه",1,0],["ألِأنّي أعيشُ للفنّ أعرى","وأخو الطين ناعمٌ في البرود",140,"د",1,0],["أَلا نادِيا أَظعانَ لَيلى تُعَرِّجِ","فَقَد هِجنَ شَوقاً لَيتَهُ لَم يُهَيَّجِ",141,"ج",1,1],["الآنَ صَحَّ بِأَنَّ حُسنَكَ مُرهَفٌ","وَلِذاكَ ما صَقَلَ الحُسامَ المُرهَفا",142,"ف",2,0],["ألأنَّ قَلبَكِ قَد مَلكتُ عِنانَه","تَهوينَ أن أُعطِي المَلامَ عِناني",143,"ن",2,0],["الآنَ قُمتِ بِنَصرِه ولَطالَما","أضعَفتِ قوَّتَه بوَردٍ مُضعَفِ",144,"ف",1,0],["ألآن قد وضح الذي","قد خلته لا يتضح",145,"ح",1,0],["إلا نزولي بين تلك الأطناب","بين الهداة الفائزين",146,"ن",1,0],["الآنَ حين انتَهى السّلوانُ والجلدُ","فَقَصّروا أقْصروا في الهجرِ واقْتَصِدُوا",147,"د",3,1],["الآن باحَ بمُضْمَرِ الأَسْرارِ","إذ أزمَعَ السَّفرَ الفريقُ السَّاري",148,"ر",2,1],["الآنَ حين نكَثْتمُ عَهْدي","وذَاقَ أقاربي مِنْ ظُلْمكمْ ما ذاقوا",149,"ق",3,0],["الآن تَسأل دارِهِم عَن أَهلِها","أَو هَل تُجيبك غَيرَ ذاتِ لِسانِ",150,"ن",1,0],["الآن قَد صَحَّ لي حَقاً بِلا كَذِب","مِن كَثرَةِ الحُرفِ أَنّي مِن ذَوي الأَدَبِ",151,"ب",1,1],["أَلا نَغْبَةٌ من بَرْدِ أَنْيابَها العُلى","وردُّ زمانٍ كالأَهِلَّةِ يُجْتَلى",152,"ل",2,0],["الان استراح الركب من دأب السرى","إليه وأسماع المطيّ من الزجر",153,"ر",1,0],["الآنَ رُدَّ عنانُ الملكِ فِي يدِهِ","وعاد نورُ الهدى في جفنِ أَرْمَدِهِ",154,"د",2,1],["الا نعم الثلاث نساء صدق","نُقلن من الخيام إِلى الرجام",155,"م",1,0],["ألأن الحب في تقديره","سلعة للبيع في سوق الكساد",156,"د",1,0],["الان فرصتكَ الوحيدةُ قبلما","تُصغى إلى الدَّاعى الملحِّ المقبلِ",157,"ل",1,0],["إلاّ نُهاىَ فما يُبُّل ظَماؤه","وتردني الأحزانُ عن أوهامى",158,"م",2,0],["الأنَّ أهلكَ أورثوك نسيتَ ما","وهبوا وما ابتدعوا من الاحسان",159,"ن",1,0],["الأنجُمُ الزُّهرُ فمنها ثاقبٌ","مستسلَفُ النورِ ومنها ناجمُ",160,"م",1,0],["الآن إِذ بَرَدَ السلوُّ ظَمائي","وأصاب بَعدكم الأُساةُ دوائي",161,"ي",1,1],["الآنَ يا شوسَ الخطوب تقنعي","حزناً ويا نوبَ الزمان تكشفَّي",162,"ف",2,0],["الآن بات الشمل وهو مجمع","والعقد في جيد الزمان منظما",163,"م",2,0],["الآن طلّق قلبي فضل صبوته","وراجعَ الحلمَ منقاداً بلا رسن",164,"ن",1,0],["الآن بعدُ ولم تزل أيامه","خفت النّوى فعرفت قدر جديده",165,"د",2,0],["الآنَ أدرَكَت العروبَة ُُ أنَّها","رُز ِئَتْ ، وأنَّ بُكاءَها لا يَنفَعُ!",166,"ع",1,0],["الآنَ بانَ سَوادُهُنَّ جَميعُه ُ","هذي الوجوهُ ، وَما بِه ِتَتَلَفَّعُ",166,"ع",1,0],["أَلانَ استَقَرَّ المُلكُ في مُستَقَرِّهِ","وَعادَ لِعُرفٍ أَمرُهُ المُتَنَكِّرُ",167,"ر",1,1],["أَلا نولِّي قَبلَ الفِراقِ قَذور","فَقَد حانَ مِن صَحبي الغَداة بُكورُ",168,"ر",1,1],["الأنبياء شموسُ الخلقِ وعلى","أقدامهم بعد أقطابٌ وزهادُ",169,"د",1,0],["الأنْبِياءُ صُدورُ الكَونِ سادَتُهُ","والأوْلياءُ بألبابٍ تُناجيها",170,"ي",3,0],["الآن قد أيقنَ ابنُ رُشدِ","أنَّ تواليفَه تَوالف",171,"ف",1,1],["الا ناصحٌ مبلغ نصحه","إِلى الملك الناصر الظافر",172,"ر",1,0],["الآن فوضت الأمور إلى الذي","يشفي دخيلة دائها بدواء",173,"ا",2,0],["الآن نادتنا التجارب طلِّقوا","دنياكُمُ إنَّ السرور غرورُ",174,"ر",1,0],["ألا ناصِرٌ للدّينِ دِينِ مُحَمّدٍ","ألا عاضِدٌ يا لَلرِّجالِ يعاضِدُهْ",175,"د",2,0],["الآن فاِنطق بِما أَردتَ فَقد","أَبدَت بهاجاً وجوهَها السبُلُ",176,"ل",1,0],["ألا نكّب الأنواءُ دارَ مَهانةٍ","فما عندنا للنّفسِ غيرُ ضَناها",177,"ا",3,0],["أَلا نادِيَ اليَومَ الَّذي أَعجَلَ النَوى","نَلبُثَها حَتّى اِنطَوى مَعَها الوَصلُ",178,"ل",1,0],["ألا نحن أهل الله ما بيننا انتفت","إضافة أهل بالفنا هكذا أنّا",179,"ن",2,0],["الآنَ أَشْبَهَ خَدَّهُ","وَرْدَ الشَّقِيْقِ عَلاَنِيَهْ",180,"ه",1,1],["إلا نساء معها يخدمنها","في حجرة في الدار قد اسكنها",181,"ه",2,0],["الآن ساغ لي الشرابُ ولم أكن","آتي القِجارَ ولا أشدُّ تكلُّمي",182,"م",2,1],["الآن حين شرعت في حوض التقى","وخرجت من عقد الحياة سليما",183,"م",2,1],["أَلا نادِ في آثارِهنَّ الغَوانِيا","سُقِينَ سِماماً ما لَهُنَّ وَما لِيا",184,"ي",2,0],["أَلا نغَقَ الغُرابُ عَليكَ ظُهراً","أَلا في فيكَ مِن ذاكَ التُرابُ",185,"ب",1,1],["أَلانَ إِذ أَخَذَت مَآخِذَها","وَتَباعَدَ الأَنسابُ وَالقُربُ",186,"ب",1,0]]}