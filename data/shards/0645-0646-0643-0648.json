{"poems":[[105,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[128,"أهكذا حتى ولا مرحبا","https://www.aldiwan.net/poem23708.html","السريع"],[156,"القادمون الخضر","https://www.aldiwan.net/poem17107.html","عموديه"],[463,"من راكب تنجو به ممسوسة","https://www.aldiwan.net/poem55832.html","الكامل"],[469,"هذا فتى الزقزوق يرأف بالزرزور","https://www.aldiwan.net/poem3246.html","عموديه"],[469,"عجب الأنام من الأجل ولو دروا","https://www.aldiwan.net/poem3342.html","عموديه"],[473,"أبيض جامد وأحمر جار","https://www.aldiwan.net/poem59995.html","الوافر"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138288",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38962","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38170","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59418","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25308","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1611,"","https://poetry.dctabudhabi.ae/diwan/poem/106713","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27724","البسيط"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205812","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100206","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202405","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200129","المجتث"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115444","الرمل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132779","الكامل"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/105953","الخفيف"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109973","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135790","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135768","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135728","الرجز"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78245","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4791,"صمت البوح","https://www.poetsgate.com/ViewPoem.aspx?id=37116",""],[4805,"من كوثر الحُسن ارتوت بالعذوبه","https://www.poetsgate.com/ViewPoem.aspx?id=176497",""],[4908,"كومة الأوجاع","https://www.poetsgate.com/ViewPoem.aspx?id=207314",""],[5083,"قهوةُ صيدا","https://www.poetsgate.com/ViewPoem.aspx?id=53728",""],[5183,"السر الخفي","https://www.poetsgate.com/ViewPoem.aspx?id=180211",""],[5231,"لاَ عَاصِمَ الْيَوْمَ","https://www.poetsgate.com/ViewPoem.aspx?id=47901",""],[5956,"الحب الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=194155",""],[161,"بيْنَ السَّجؤينِ وخُطَّةِ السَّجَّانِ","https://www.poetsgate.com/ViewPoem.aspx?id=175319",""],[463,"لمنْ الظَّعنُ تهتدي وتجورُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60080&r=&rc=136",""]],"verses":[["مِنْ كُوَّةٍ بِالبابِ يَرْقُبُ صَيْدَهُ","وَيَعُودُ في أَمْنٍ إلى الدَّوَرَانِ",0,"ن",1,0],["من كوخ إرهاقي وهذا الحمى","حذار بعد اليوم أن تقربا",1,"ب",2,0],["من كؤوس كالسُّمِّ، تغلي بما يه","وى الفراعينُ من ضُروب العَذابِ",2,"ب",1,0],["منكوحة ومهورُها منسيَّةٌ","والمَهرُ حقٌّ واجبٌ في حينهِ",3,"ن",2,0],["من كون ذا في بحر نعمته","وأخيه في قفص من الفقر",4,"ر",1,0],["من كونها بعض الجماد وأنها","صمٌّ وقد سجدت لوحي كلامهِ",5,"ه",1,0],["مِن كُؤوسٍ لَها كَسىً مِن عُقارِ","وَغُصونٍ لَه حُلىً مِن بِهارِ",6,"ر",1,0],["منكوبهم وعليلهم وذليلهم","ألفوا عزاء صدع أفئدة جبر",7,"ر",1,0],["مِن كوبِ أَلفاظِهِ الأَذهانُ ما شَرِبَت","سُلاف مَعناه إِلّا اِستَحلَتِ الوِردا",8,"د",2,0],["مِن كَوكَبٍ هاوٍ وآخرَ طالعٍ","هَذا يَجيء وَذاكَ مِنّا يبعُدُ",9,"د",1,0],["من كونه الله قبل كل وجود","من نور جمال ومن أشعة إجلال",10,"ل",1,0],["مِنْكِ وَأَشْتَقُّ اشْتِقاقاً شَغْبا","أُنْكِر أَقْوالاً وَأُبْقِي علْبا",11,"ب",2,0],["منكورها إسم شايع في جنسه","كرب عبد والغنى في نفسه",12,"ه",1,0],["مِن كورَةٍ عَبَدَ العَبابيدُ الهَوى","فيها وَلَمّا يَعدِلوا بِهَواءِ",13,"ا",2,0],["من كونه مانعاً بخلنا","والمعطي أعطى لنا السخاء",14,"ا",2,0],["منكِ وحي وفيك شعري ومن عي","نك معنى السحر الشهى الحلال",15,"ل",1,0],["منك وجدي وزفرتي وغليلي","وغرامي وراحتي وعنائي",16,"ي",1,0],["من كوّن الجسم وأعطى له","محرّكاً يدعونه قلبا",17,"ب",2,0],["من كوة السجن ألقي","نفسي بدون توان",18,"ن",1,1],["من كؤوسٍ جليت ما بيننا","نتهادى في عقودِ الحببَ",19,"ب",1,0],["من كوثر الفردوس يسقى رمسه","ما العارض المنهل ما سقياه",20,"ا",2,0],["منك واحفظ حماي يوم قضاء","وترحم بكشفة الغطاء",21,"ا",2,0],["منك واحرسهمو من الأوغاد","ثم صنهم أن حل مدهش خطب",21,"ب",1,0],["من كوكب القلب الذي كرنا","فليس اكليل سوى ما قلنا",22,"ن",2,0],["من كونِ مالكِ نفسهِ يعلو على","من يَفتَحُ المُدُنَ الحصينةَ بالوَزَر",23,"ر",1,0],["منك وإخوتي نُرى بُكيّا","ولا نلاقي يا إلهي غيّا",24,"ي",2,0],["منك وزده وأكمِلِ الصلاةَ معْ","كلِّ السلامِ للنبي المرتفعْ",25,"ع",1,0],["منك وفضلك علينا كلما","لحظ طرف في الدهور أينما",26,"م",2,0],["من كَوكَب الاِقبال لاحَ سعود","سِحرا وَعَم ضِياؤُهُ المَشهود",27,"د",1,1],["منكوحةٌ ما لم تَضَعْ حملَها","مسدودةُ الأنفاسِ محصورَهْ",28,"ر",2,0],["منك وعليك الهم من وين ما اروح","يمشي معي يا شاغلي مثل ظلِّي",29,"ل",2,1],["من كوثر الحُسن ارتوت بالعذوبه","مجرى الجمال النبع والطهر صبه",30,"ب",2,1],["مِنْ كُوَّةِ النُّورِ حَتَّى آخر الشَّفَقِ","يَمْتَدُّ هَمِّي وَيَصْحُو فِي الدُّجَى قَلَقِي",31,"ق",2,1],["من كؤوس الراحِ أشهى","منْ عَبيرِ المِسكِ أعْطرْ",32,"ر",1,0],["منكوصة الإقدام إلا في الهوى","مصفوفة الأقدام حول حطامه",33,"م",2,0],["مِنْ كُوَّةِ الْغَيْبِ أُدْنِي خَيْطَ أَخْيِلَتِي","فَأَحْتَسِي الْوَحْي أَقْدَاحاً وَ أَغْتَرِفُ",34,"ف",1,0],["من كوكبٍ عجبٍ أتاني رافلاً","بمحبةٍ تغشاه مثل دليلهِ",35,"ل",2,0],["21- مِنْ كُوَّةِ فُتِحَتْ بِهَدْمٍ أَحْمَقٍ","بِجِدَارِ دَارٍ خَلْفَهُ قَمَرَانِ",36,"ن",1,0],["منكَ وأنْ تحسنَ الصَّنيعَ وتر","عى ومنِّي التَّنميقُ والتَّجبيرُ",37,"ر",1,0]]}