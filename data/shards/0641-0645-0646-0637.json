{"poems":[[79,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[91,"وللناس فيما قد علمت مآرب","https://www.aldiwan.net/poem45095.html","الطويل"],[45,"طوال قنا تطاعنها قصار","https://www.aldiwan.net/poem9568.html","الوافر"],[63,"ألا غادها مخطئا أو مصيبا","https://www.aldiwan.net/poem51792.html","المتقارب"],[147,"ما في المعالي علي منك يعتصم","https://www.aldiwan.net/poem11822.html","الطويل"],[287,"تظلموا وهم عقوا وهم ظلموا","https://www.aldiwan.net/poem32460.html","البسيط"],[422,"أدار الكأس صافية المدام","https://www.aldiwan.net/poem53947.html","الكامل"],[447,"رأيت الزمان وإخوانه","https://www.aldiwan.net/poem14395.html","المتقارب"],[469,"لقد سل سيفا والغدار الحمائل","https://www.aldiwan.net/poem3189.html","عموديه"],[581,"أعاذل إن المرء رهن مصيبة","https://www.aldiwan.net/poem1799.html","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77558","الرجز"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35407","الوافر"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35345","الوافر"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/177841","الطويل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137926",""],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177823","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/141734","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28615","المتقارب"],[2665,"","https://poetry.dctabudhabi.ae/diwan/poem/71107","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65972","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201764","المتقارب"],[2973,"","https://poetry.dctabudhabi.ae/diwan/poem/107027","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100748","المتقارب"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87366","الطويل"],[3944,"","https://poetry.dctabudhabi.ae/diwan/poem/131390","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70166","الوافر"],[4623,"","https://poetry.dctabudhabi.ae/diwan/poem/140153",""],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124654","الطويل"],[4943,"القطرة الغيثية والوسيلة الالهية","https://www.poetsgate.com/ViewPoem.aspx?id=125974",""],[5397,"أهل بسط كف تحجب الشمس والبدرا","https://www.poetsgate.com/ViewPoem.aspx?id=157931",""],[5472,"الى الله من عودتى توبتى","https://www.poetsgate.com/ViewPoem.aspx?id=200466",""],[5720,"دكتور موسىٰ","https://www.poetsgate.com/ViewPoem.aspx?id=201848",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""]],"verses":[["فَمِنْ طَائِحٍ فَوْقَ الْعَرَاءِ مُجَدَّلٍ","وَمِنْ رَاسِفٍ فِي الْقَيْدِ أَرْهَقَهُ الضَّغْطُ",0,"ط",1,0],["فمن طالب دنيا وذاك هو الحجى","ومن طالب دينا وذاك هو الحق",1,"ق",1,0],["فَمَن طَلَبَ الطِعانَ فَذا عَلِيٌّ","وَخَيلُ اللَهِ وَالأَسَلُ الحِرارُ",2,"ر",1,0],["فمن طَرَبٍ يستفزُّ النُّهى","ومن أدبٍ يَستَرِقُّ القُلوبا",3,"ب",2,0],["فَمِن طَيالِسَ لَم تَعلَق بِها تُهَمٌ","وَمِن صَوارِمَ كَم ريعَت بِها بُهَمُ",4,"م",1,0],["فَمِن طَريقٍ رَجَوا أَن يُنصَروا خَسِروا","وَمِن مَكانٍ رَأَوا أَن يَغنَموا غَرِموا",5,"م",3,0],["فمن طربٍ إلى طربٍ توالى","ومن جامٍ سعى في إثر جام",6,"م",1,0],["فمنطق كل امرئٍ مظهر","على ما رأيناه ألبانه",7,"ن",2,0],["فمِن طاعمٍ قلبَ الكتيبة طاعن","ومن باسمٍ يومَ الكريهة باسل",8,"ل",1,0],["فَمِن طَلَبِ الأَوتارِ ما حَزَّ أَنفَهُ","قَصيرٌ وَخاضَ المَوتَ بِالسَيفِ بَيهَسُ",9,"س",1,0],["فَمن طَغى أَو ضَلَّ أَو تَكَبرا","لِنَفسِهِ جَرَّ الأَذى وَالضرَرا",10,"ر",2,0],["فَمِن طُرَفِ العِراقِ وَكُلِّ أَرضٍ","عَجائِبُ راقَ أَعيُنَنا رُؤاها",11,"ا",3,0],["فَمِن طَيرٍ شَدَونَ بِكُلِّ غُصنٍ","وَمِن غِزلانِ رامَةَ أَو مَهاها",11,"ا",3,0],["فَمِن طينِ النَدى سَوّاك رَبّي","وَصاغَ كَريمَ وَجهِكَ مِن حَياءِ",12,"ا",2,0],["فمن طالب حظاً بدنيا فما له","خلاق بأخراه إذا الله لاقاه",13,"ه",1,0],["فمن طما ولغبٍ ارهقاه","وجوعٍ ما استطاع عليه صبرا",14,"ر",2,0],["فمن طيبها للطيب طيب بطيب","كريم ثوى فيها بأنفسنا يفدى",15,"د",2,0],["فمن طافَ يوماً بين مروةَ والصفا","ينزه يومَ الحشر في موقف السّوي",16,"ي",1,0],["فَمَنطَقَ مِنها خُصورَ الوِهادِ","وَتَوَّجَ مِنها رُؤوسَ الرُّبا",17,"ا",1,0],["فَمَن طلبَ العطية من بخيل","كمن طلبَ الشراب من السرابِ",18,"ب",1,0],["فمن طلب الحوراء زوجاً فإنه","يلاثمها بعد التثام الدكادك",19,"ك",1,0],["فمن طرَفٍ جارُ بيتي الخرابْ","ومن طَرَف جاره البلقع",20,"ع",1,0],["فمن طيبها لم تألف الورق عيرها","ألم ترها لم تتخذ غيرها وكرا",21,"ر",2,0],["فمن طالب ان ينال الثريا","ولم تك تدنو لطلابها",22,"ب",3,0],["فمن طالبٍ بالعقل رفعةَ ذي الحجى","ومن راغِبٍ بالطَبعِ في لَذَّة الغِرِّ",23,"ر",1,0],["فمن طاع لا يوقن بفوز ومن عصى","من العفو لا ييأس فعفو الخنا سهل",24,"ل",1,0],["فَمنطقهُ وَمبسمهُ اللآلي","وَبردتهُ التَواضع بِالمَعالي",25,"ي",1,0],["فمن طلب العليا بعزم ينالها","وذو الحزم فيما يبتغي غير خائب",26,"ب",1,0],["فمن طبق الآفاق علما ونائلا","وحاز مزايا كالنجوم الزواهر",27,"ر",1,0],["فمن طبعها اخفاء كل قبيحة","تقول ادعاءً ما بها خلق رذل",28,"ل",1,0],["فمن طلب الشيء المحال بجهده","أضاعت له الأيام في مكثه عمرا",29,"ر",2,0],["فمن طلب الحقّ بالمنكرا","ت عاد على حقه منكره",30,"ر",2,0],["فمَنْ طلبَ العُلا سَهِرَ اللياليْ","وحقَّقَ ما رجَاهُ لهُ ذَوُوهُ",31,"و",2,0],["فمن طال بالعرفان أو طال بالوعد","ومن ويت له الأراضي بخطوة",32,"ه",1,0]]}