px?id=155194",""],[231,"الإنسان الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=186167",""],[5232,"إلى شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=213608",""],[592,"أشاقك من سعدي بتلك المنازل","https://www.poetsgate.com/ViewPoem.aspx?id=128861",""],[5351,"نرجسية","https://www.poetsgate.com/ViewPoem.aspx?id=202600",""],[5470,"وشايةُعطر","https://www.poetsgate.com/ViewPoem.aspx?id=10889",""],[5605,"رسالة الى عباس","https://www.poetsgate.com/ViewPoem.aspx?id=160586",""],[5608,"شي خُرافي","https://www.poetsgate.com/ViewPoem.aspx?id=32853",""],[5749,"اه يا دمعتي","https://www.poetsgate.com/ViewPoem.aspx?id=157287",""],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""],[5789,"مغازلة الجِراح","https://www.poetsgate.com/ViewPoem.aspx?id=201410",""],[5848,"والله إني عليك احرص من امك وابوك","https://www.poetsgate.com/ViewPoem.aspx?id=48836",""],[5897,"قم يا عراق","https://www.poetsgate.com/ViewPoem.aspx?id=156690",""],[192,"سيّد جروحي","https://www.poetsgate.com/ViewPoem.aspx?id=16319",""],[5956,"حديث الورود","https://www.poetsgate.com/ViewPoem.aspx?id=182337",""],[5956,"الرسالة المحمدية","https://www.poetsgate.com/ViewPoem.aspx?id=184653",""],[5956,"دموعك يا بنيّ جرت","https://www.poetsgate.com/ViewPoem.aspx?id=193301",""],[6031,"عَذِيريَ من هَذَا العَذُولِ المُفَنَّدِ","https://www.poetsgate.com/ViewPoem.aspx?id=46273",""],[6052,"روضة الايمان","https://www.poetsgate.com/ViewPoem.aspx?id=35138",""],[6056,"البارعة","https://www.poetsgate.com/ViewPoem.aspx?id=156701",""],[6113,"الهايج والذلول......","https://www.poetsgate.com/ViewPoem.aspx?id=37153",""],[6113,"السالفه...............!!!","https://www.poetsgate.com/ViewPoem.aspx?id=41916",""],[231,"لماذا أحبك !؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79161&r=&rc=35",""],[2944,"حياة التشرّد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86016&r=&rc=0",""]],"verses":[["وَشَتَّتَت شَملَكَ الأَيّامُ ظالِمَةً","فَشَملُ دَمعي وَلُبّي غَيرُ مُجتَمِعِ",0,"ع",1,0],["وشتّانَ ما بَيْنَ الوَزيرَيْنِ وادِعٍ","أتَتْهُ العُلا طَوْعاً وآخرَ مُتعَبِ",1,"ب",1,0],["وَشَتيتٍ كَالأُقحُوانِ جَلاهُ ال","طَلُّ فيهِ عُذوبَةٌ وَاِتِّساقُ",2,"ق",1,0],["وَشَتيمٌ جَونٌ يُطارِدُ حولاً","أَخدَرِيٌّ مُسَحَّجٌ صَلصالُ",3,"ل",1,0],["وَشَتّانَ بَينَكُما في النَدى","وَفي البَأسِ وَالخُبرِ وَالمَنظَرِ",4,"ر",1,0],["وَشَتيتاً يَغُضُّ مِن لُؤلُؤٍ النَظ","مِ وَيُزري عَلى شَتيتِ الأَقاحي",5,"ح",2,0],["وَشَتّامَةٌ لِصِحابِ النَبِي","يِ يُزجَرُ عَنهُم فَما يَنزَجِر",6,"ر",1,0],["وشتّان بين السنا والظلام","لعابدةٍ للسنا عن كثب",7,"ب",1,0],["وشَّت بشاشتها نضا","رةُ وجهك المتهلّل",8,"ل",1,0],["وَشَتَّانَ مَا بَيْنَ امْرِئِ الْقَوْمِ الَّذِي","إِذَا رَامَ أَمْرَاً لَمْ يَجُزْ سَاحَةَ الْبَهْوِ",9,"و",1,0],["وَشَتَّانَ عَبْدٌ بِالْمَحَجَّةِ نَاطِقٌ","وَحُرٌّ إِذَا نَاقَشْتَهُ الْقَوْلَ أَغْتَمُ",10,"م",1,0],["وَشَتَّانَ مَنْ يَبْكِي عَلَى غَيْرِ عِرْفَةٍ","جِزَافاً وَمَنْ يَبْكِي لِعَهْدٍ تَجَرَّمَا",11,"م",2,0],["وَشَتيتاً بارِداً تَح","سَبُهُ دُرّاً نَظيما",12,"م",2,0],["وَشَتيتٌ أَحوى المَراكِزِ عَذبٌ","ما لَهُ في جَميعِ ما ذيقَ طَعمُ",13,"م",1,0],["وَشَتيتاً كَالأُقحُوانِ عِذاباً","لَم يُغادِر بِهِ الزَمانُ فُلولا",14,"ل",2,0],["وَشَتيتَ النَبتِ مُتَّسِقاً","طَيِّباً أَنيابُهُ خَصِرا",15,"ر",2,0],["وَشَتَمتَ رَبَّكَ في العَشيرَةِ قائِماً","لِتَكونَ مَوجوداً وَلَيتَكَ توجُدُ",16,"د",1,0],["وَشَتّانَ قَتلي في التُرابِ شِجاجُها","وَمَقتولَةٌ بَينَ المَجالِسِ شُجَّتِ",17,"ت",1,0],["وَشتان بين الجند قد هبَّ زاحفاً","وَجند تولى وَهو بالخزي يعثر",18,"ر",1,0],["وَشَتِ الْعَوَاذِلُ بِي فَحَالَتْ دُونَهَا","وَقَضَتْ حُكُومَةُ أَهْلِهَا بِثُبُورِي",19,"ر",2,0],["وَشَتَّى علومٍ وَشَتَّى فُنُونٍ","تَأَلَّفَ منْهُنَّ عَقْدٌ نَضيدُ",20,"د",1,0],["وَشَتانَ ما بَيني وَبَينِكَ إِنَّني","عَلى كُلِّ حالٍ أَستَقيمُ وَتُظلعُ",21,"ع",1,0],["وشتان ماءُ الغيومِ الفِجاءُ","..وماءٌ يُجاءُ فيه بالقِربْ",22,"ب",1,0],["وشَتّتَ رَيبُ الدّهرِ كلَّ جَماعَة","وكَدّرَ رَيبُ الدّهرِ كُلَّ صَفَاءِ",23,"ا",2,0],["وشتّانَ فنّانٌ على الفنِّ عاكفٌ","وآخرُ في دوّامِةِ العَيْشِ حائر",24,"ر",1,0],["وشتامة لصحاب النب","ي يزجر عنهم فما ينزجر",25,"ر",1,0],["وشَتيمٌ جَوْنٌ يُطارِدُ حُولاً","أخْدَريٌّ مُحَجَّجٌ صلصالُ",26,"ل",1,0],["وشتيتا كالأقحوان ابتساما","وخدودا بيضا وكشحا هضيما",27,"م",2,0],["وشَتِيتاً مُنصَباً قَرقَفِياً","إِثمُدِىَّ اللَّمَى وبَرقاً مَشِيمَا",28,"م",2,0],["وشتِيتاً مُنصَباً كَسَيَالٍ","وأقَاحٍ وَطيلَسَانٍ وقَارِ",29,"ر",1,0],["وشتّان ما بين الحجيجين عندنا","فهذا له ملك وهذا له أجر",30,"ر",1,0],["وشتت البين ما قد كان يجمعنا","حتى كأن الذي قد كأن لم يكن",31,"ن",1,0],["وشتت البين شملاً كان يجمعنا","فالعين تجمع بين الدمع والسهر",32,"ر",1,0],["وَشَتّانَ ما بَينَ النُبُوَّةِ وَالمُلكِ","لَقَد طابَ مِنهُ الأَصلُ وَالفَرعُ أَطيَبُ",33,"ب",1,0],["وشتاء أتى وبرد ثقيل","هو أردى من طلعة العذال",34,"ل",1,0],["وشتان ما بين المليكين شيمة","يعمّر هذا حين ذاك يخرِّب",35,"ب",1,0],["وَشتّان ما بَيني وَبَينك في الجَوى","لِيَ الوَجد طَبعاً وَهوَ فيك تَطبُّعا",36,"ع",2,0],["وشَت بَيني وبَينَكَ لامِعاتٌ","قَواطعُ بينَ لَذَّاتي وبَيني",37,"ن",2,0],["وشتّان بَين البَيْعَتينِ لِمنْصِفِ","إذا أُعْطيَ الإِنصافَ مَنْ هو طالبُهْ",38,"ب",2,0],["وشتان ما بين المقلد في الهدى","ومن يقتدي والضد يعرف بالضد",39,"د",1,0],["وشتت الله ممن قد طغى وبغى","جمع الخوارج بين القتل والهرب",40,"ب",1,0],["وشتان ود الحي والميت بعد ما","هما افترقا لم ينبت الود كالود",41,"د",1,0],["وشتت شمل العرب في كل بقعة","إلى ان غدت أشقى الأنام وأهونا",42,"ن",2,0],["وشَّتْ معاطفَها قريحةُ ماهرٍ","بطرائِفٍ قد أُحْكِمَتْ تأسيسا",43,"س",2,0],["وشتَّان ما بين الترنم والبكا","عليك وبين النَّوح بعدك والسَّجح",44,"ح",1,0],["وشتت الجموع منهم يا قدير","واذهب بنورهم يا حق يا بصير",45,"ر",1,0],["وشتات آمالي بكم ولعمركم","إنَّ المحبَّ مشتَّتُ الآمالِ",46,"ل",1,0],["وشَتَّ فينا بألبابٍ مُمزَّقَةٍ","أجْزاؤُها لَوعةُ الهِجرانِ تُفْنيها",47,"ي",3,0],["وَشَتَّى بَنو التَّاريخِ أما كَمِثلِهِ","فما أًَبصَرت عَيني ولا سَمِعَت أُذُني",48,"ن",2,0],["وشتيتِ الظُّنونِ يحذر كلَّ ال","حِذْرِ من خلفِهِ ومن قُدّامِهْ",49,"م",2,0],["وشتتي شملَ أقوامٍ بنا اختلطوا","إبليسُ للشرِّ داعيهم وجامعهم",50,"م",1,0],["وشتى فنون العلم تزكو ولم تزل","مرددةً منه بأشرف منزلِ",51,"ل",1,0],["وشتان ما بيتي وبين ابن خالد","أمية في الرزق الذي يتقسم",52,"م",1,1],["وَشَت خَدّها بِالياسَمين تَزيّناً","فَأَمسَكَهُ وَالخدُّ وَاللَّه عَندمُ",53,"م",1,1],["وَشَتَّت الغُزلان مِنها في الخَلا","وَما بِها مِن مَرتع إِلا خلا",54,"ل",2,0],["وشتان الذي يبني دياراً","ومن يسعى لتخريب ودرسِ",55,"س",1,0],["وَشَتَّانَ المَنازِلُ غَيرَ أَنَّا","مَرَرناها عَلَى سَفَرٍ عِجالا",56,"ل",2,0],["وَشَتِّتْ شَمْلَهُ وَاكْشِفْهُ جَهْراً","عَلَى عَيْنِ الْوَرَى وَاحْصُدْ عُرَاهُ",57,"ا",2,0],["وشتائي صِنو لصيفي أبقى","فيهما واحداً صَلِيبَ العُودِ",58,"د",1,0],["وشتاء هذا العام زعزعهُ ولم","يبقى به أمنٌ ولا تطمينُ",59,"ن",1,0],["وَشَّت يَدُ الدَهرِ رأسي بالمشيب أَسى","في غَيهَبٍ بِسَنا المصباح مَوشىِّ",60,"ا",1,1],["وشتّان ما ليلي وليلك إنّما","يَلذُّ الكرى وسَنانُ إذا أَنا ساهدُ",61,"د",1,0],["وشتمُ قومٍ قُسِمَتْ","بينهمُ الدنيا دول",62,"ل",1,0],["وشت شملي ولكن قال لي أملي","إذا تلافاه عبد القادر انتظما",63,"م",2,0],["وشتان ما بين الخمسين في الوغى","إذا الحرب جدت في مضيق ومدعق",64,"ق",1,0],["وَشَتَموا القَومَ الَّذينَ اِرتَضى","بِهِم رَسولُ اللَهِ وَاِستَكبروا",65,"ر",3,0],["وَشَت دموعي بحُبٍّ كنتُ أكتُمُهُ","وكلما رُمتُ إخفاءَ الهوى تَزِد",66,"د",1,0],["وشَتِّ شَملِ كرامٍ أَنتَ ناظِمُهُ","ورَدِّ دَعوةِ أَهَلِ المَجدِ والكَرمِ",67,"م",1,0],["وشتتت شمل الشعب حتى تسربوا","إلى الهجر يرجون السلامة في الهجر",68,"ر",1,0],["وشَتكِ يد الربيع فلحتِ روضاً","وكان لروضك الجيشانِ زهرا",69,"ر",2,0],["وشتاؤها غَرق واهون صيفها","حُرَق تحاكي الجمر في لهباته",70,"ت",2,0],["وَشَتّانَ بَينَ الماءِ وَالخَمرِ في فَمٍ","وَلَكِنَّ ذا حِلٌّ وَهَذا مُحَرَّمُ",71,"م",1,0],["وشتّان بين اخضرارٍ لهُ","وسطحٍ بِه الجُدْبُ حَاكَى العَدَمْ",72,"م",1,0],["وشتّان ما بين المدامين فاعتبر","فكم بينَ إنجاح لسعي وإنفاقِ",73,"ق",1,0],["وشتان ما بينَ المدامين فاعتبِر","فكم بين إنجاح لسعي وإخفاق",74,"ق",1,0],["وشتوا في البلاد فكلُّ أرضٍ","حَوت منهم غريباً مستكينا",75,"ن",2,0],["وشتان إن البحر ينفذ ماؤه","وهابحرك الطامي يفيض ويزخر",76,"ر",1,0],["وشتّت شملهم بعد انتظام","وكدّر وردهُم إثر الصفاء"