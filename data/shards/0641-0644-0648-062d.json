w.aldiwan.net/poem60525.html","الوافر"],[505,"هو البدر أم وجه الحبيب الذي يبدو","https://www.aldiwan.net/poem38023.html","الطويل"],[509,"هواك لا نوار الملامة ملمع","https://www.aldiwan.net/poem38404.html","الطويل"],[519,"تصاحى وهو مخمور الجنان","https://www.aldiwan.net/poem20821.html","الوافر"],[556,"إذا لم تستطع للرزء دفعا","https://www.aldiwan.net/poem48080.html","الوافر"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103086","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96982","المتقارب"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101488","المجتث"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104565","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202077","المتقارب"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117621","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101013","الطويل"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11125","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69367","الوافر"],[2149,"","https://poetry.dctabudhabi.ae/diwan/poem/115160","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53070","الطويل"],[2215,"","https://poetry.dctabudhabi.ae/diwan/poem/141784","الطويل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140097",""],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100716","الطويل"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145542","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45774","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129453","الطويل"],[3945,"","https://poetry.dctabudhabi.ae/diwan/poem/130526","البسيط"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119408","الرجز"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105133","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94573","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58155","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139718",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5397,"على الربع دمعي أرسل المد لا الجزرا","https://www.poetsgate.com/ViewPoem.aspx?id=157921",""],[2588,"شاخصة ( رؤيا)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65577&r=&rc=5",""],[6259,"هل الوجد الا أن تلوح خيامها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59401&r=&rc=49",""]],"verses":[["فَلَو حَلَّ المُؤَمَّلُ عَقدَ هَمّي","شَدَدتُ بِمُقلَتَيَّ عُرى الرُقادِ",0,"د",1,0],["فَلَوَّحَ فيها زادَهُ وَرَبَأتُهُ","عَلى مَرقَبٍ يَعلو الأَحِزَّةَ قاهِرِ",1,"ر",1,0],["فَلَو حَذِرَ القَومُ الَّذينَ غَدَرتُمُ","بِهِم جَمعَكُم لَم يَرجِعِ الجَمعُ سالِما",2,"م",2,0],["فلو حلفتَ لما كُذّبت حينئذٍ","أنِّي هناك لقيتُ العُجْمَ والعربا",3,"ب",2,0],["فلو حصبتْهم بالفضاء سحابةٌ","لَظلَّ عليهم حصبُها يتدحرجُ",4,"ج",1,0],["فلو حلَّؤوني عن شريعة جدولٍ","عذرتُ ولكن حلَّؤوني عن البحرِ",5,"ر",1,0],["فَلَو حَسَدَت مُهجَةٌ وُلدَها","حَسَدتُكِ مِن طِفلَةٍ لاهِيَه",6,"ي",2,0],["فَلَوَّحَ لي قَريضُكَ بِاِفتِخارٍ","وَعُجبٍ جاءَ عَن تَصعيرِ خَدِّ",7,"د",1,0],["فَلِوَحشِها أَجنادُهُ وَجِيادُهُ","وَلِطَيرِها بازِيُّهُ وَالزُرَّقُ",8,"ق",1,0],["فَلَو حَمَلُ الخَضراءِ أَصبَحَ بَينَهُم","لَآضَ ذَبيحاً أَو نَجا بِكُلومِ",9,"م",1,0],["فَلَوْ حَبْلاً تَنَاوَلَ من عُقيلٍ","لَمَدَّ بِحَبْلِهَا حَبْلاً مَتِينَا",10,"ن",2,0],["فلَوْ حِلْتُمُ مِنْ دُونِهِ لَمْ يَزَلْ لَكُمْ","يَدَ الدَّهْرِ عِزٌّ لا يبوخُ ولا يسري",11,"ر",2,1],["فَلو حَمل النَسيم إِلَيهِ مِني","سَلاماً راحَ يَمنَعَهُ هُبوبا",12,"ب",2,0],["فَلو حَملت مِن بَعض جودِكَ قَطرَةً","سَحائب أَضحى الدرّ يُنبتهُ الكَلا",13,"ل",2,0],["فلو حل العراق وقيل زره","لطرت اليه لا كمسير ماش",14,"ش",1,0],["فلو حملت رضوى من الشوق بعض ما","حملت لذاب الصخر من شدّة الوجد",15,"د",1,0],["فَلو حَوَت ما حوته السُحبُ مِن كَرَمٍ","لما سَمِعتَ بها للرعد تَصويتا",16,"ت",2,0],["فلو حاول المجد الأثيل مقامه","لحاول ذاك المجد بالمجد أمجدا",17,"د",2,0],["فلو حققت عين الحقيقة ذاته","لقلنا هو النور الذي قد تجسما",18,"م",2,0],["فلو حملت كتائبهم والقوا","عزائمهم على أحدٍ لزالا",19,"ل",2,0],["فلو حَسَّانُ فازَ بها لَحلَّى","بجوهَرِها قلائِدَهُ الحِسانا",20,"ن",2,0],["فلو حَواهُ زمنٌ أولٌ","مع أنّه الأولُ في الاعتمادْ",21,"د",1,0],["فلو حكاك الغمام الجود قلت له","خابت ظنونك فيه أيها المطر",22,"ر",1,0],["فلو حوت أيدي الملوك لفظها","ما رصعت منه سوى تيجانها",23,"ن",3,0],["فَلَو حضلَّ وَالبُدورُ في مَجلِسٍ","لَقَبَّلَ بَينَ يَدَيهِ الثَرى",24,"ا",1,0],["فلو حُلِّلَتْ أَجزاؤنا ثمَّ قسِّمَتْ","بغيرِ تَجَزٍّ إِسمُهُ ضمنَها يَبْدُو",25,"د",2,0],["فلو حملت ما في الغرام من الضنا","مطيّة اوضاع الدواير تضلع",26,"ع",1,0],["فلو حملَتْ من القمرِ الثُريّا","لما كادَتْ تَجيءُ له بثانِ",27,"ن",1,0],["فَلَو حابى الزّمان سِواك خَلْقاً","لَكانَ سَبيل مِثلك أَن يُحابى",28,"ب",2,0],["فلوحي محفوظ وعلمي حافظ","وعرشي محيط قائم بعمودي",29,"د",2,0],["فلو حاول الطير منها الطعام","بأم السما نال ما قد طلب",30,"ب",1,0],["فلو حبيسٌ بدَيرٍ","رآكِ يوماً تخشَّع",31,"ع",1,0],["فلوحُ سباريتِ الفلاةِ مُسطّرٌ","بأخفافِها منه فصيحٌ وأعجمُ",32,"م",1,0],["فلو حُمِّلَتْ بَعْضَ ما بي الجِبالُ","رأيتَ الجِبال كثيباً مَهيلا",33,"ل",2,0],["فلو حجينا بها في السلم ما وجدت","لها المنايا إلى أرواحنا سُبلا",34,"ل",2,0],["فلو حكَّموا في مُدّعاهم عقولهم","لكان لهم في عصمة الرسل مقنع",35,"ع",1,0],["فَلَو حارَبَتنا الجِنُّ لَم نَرفَعِ القَنا","عَنِ الجِنِّ حتى لاتَهُرَّ كِلابُها",36,"ب",3,0],["فَلَو حَمَّلتِ ما حَمَّلتِ قلبي","سَنيراً أَو ثَبيراً ما أَطاقا",37,"ق",2,0],["فلو حصفَ الذين يبيح فيهم","أثاروا منه رائحةَ الطريدِ",38,"د",1,0],["فلو حاد عن مغناك غادٍ من الحيا","غذاك سقيط من ندا الطَّلِّ رائح",39,"ح",1,0],["فلو حلب البيضاَ عاينْت تُرْبها","وقد عندمَ الفضىَّ من تُرْبها الدَّمُ",40,"م",1,0],["فلو حل من غيرها بعضه","من خوف وليد لشاب الوليد",41,"د",1,0],["فلو حلها أهل الفساد لأصبحت","بلاداً يفيّها الفساد فتخرب",42,"ب",1,0],["فلو حله غيلان نادى طلوله","هل الأزمن اللائي مضين رواجع",43,"ع",1,0],["فَلَو حارَبَتني الحادِثات لَأَحجَمَت","ذِئاب رَأَت في ذَلِكَ الغيل حَيدَرا",44,"ر",2,0],["فلو حكموا في صنعة الشعر ناقداً","بصيرا بحمد الله كنت المحكما",45,"م",2,1],["فلو حسبت وأحصى الحاسبون معي","لم أقض أفعالهم تلك الهنيّات",46,"ت",1,0],["فلو حلفت أنه","طرزه لم أحرج",47,"ج",1,0],["فلو حساها هرم","لعاد عنفوانه",48,"ن",2,0],["فلو حيَّت على ميتٍ صباحاً","فيحيى قبل إبّانِ النُشورِ",49,"ر",1,0],["فلو حَلقْةٌ من غَلِّهِ ألقيت على","بسيطتنا والعالياتِ الصلادمِ",50,"م",1,0],["فلو حمَّلتَ عبء حجاك رضوى","لناء الظهرُ منه وما أطاقا",51,"ق",2,0],["فلو حل في سفر الهزبر مديحكم","للوثة إذ كان بالشرك مزورا",52,"ر",2,0],["فلو حفظت بنت النبي صحابة","لما ضيعت بعد الممات لها قبرا",53,"ر",2,0],["فلَوَّحَ محزوناً وأجهشَ قائلاً :","( ألا عم صباحاً أيها الطللُ البالي ) .",54,"ل",2,0],["فلو حزمت من ضميرها بخزامها","لجالت على أوساطهن خزامها",55,"م",3,0]]}