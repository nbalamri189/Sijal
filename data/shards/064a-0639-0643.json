{"poems":[[252,"إن كنت عاذلتي فسيري","https://www.aldiwan.net/poem1933.html","مجزوء الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113965","الكامل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107063","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29275","الخفيف"],[4978,"من قال كالصيف لم يعرف سجاياك","https://www.poetsgate.com/ViewPoem.aspx?id=180129",""],[5431,"ولكَم يُظلم النبيل الأصيلُ...","https://www.poetsgate.com/ViewPoem.aspx?id=196635",""],[5956,"العين بالعين..‏","https://www.poetsgate.com/ViewPoem.aspx?id=183739",""],[5080,"إلى لحظتيكَ يحجّ السراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88130&r=&rc=0",""],[6300,"يوميات مكلوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82841&r=&rc=12",""],[6355,"في جوفه نارٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66561&r=&rc=21",""]],"verses":[["يَعكُفنَ مِثلَ أَساوِدِ ال","تَنّومِ لَم تَعكَف بِزورِ",0,"ر",1,0],["يعكسه قوم وقيل انهكهما","مذيّلا بعد بجزء فهما",1,"م",2,0],["يعكُفنَ ضَحواً في مكانِسِهِ","فطَريقُهُنَ لفَيئهِ دَعقُ",2,"ق",1,0],["يعكف الناس في الشآم ببابي","يشهد اللَه للندى والعطيه",3,"ي",2,0],["يُعكَسُ السِحرُ فَوقَهُ كُلَّ حينٍ","في زَهِيِّ الأَطيافِ مِن كُلِّ مَحضِ",4,"ض",1,0],["يعكر القيظ ما في الشمس من مُتَعٍ","وليس يفسد شيء من عطاياك",5,"ك",1,0],["يعكس القلب نغمة من هدوء","وصفاء على القلوب يسيلُ",6,"ل",1,0],["يُعَكِّر صفوتي الخبثاءُ مهما","منحتُ إليهمُ القلبَ التقيّا",7,"ي",2,0],["يُعكّرُ مَعناكَ صَحو الدُروبُ","فتركبُ للأينَ جَمر الصِعابْ",8,"ب",1,0],["يُعكّرُ الدهْرُ بالآلام أمزجِتِي","حتى كأنّيَ روحٌ ملَّها الجَسَدُ",9,"د",1,0],["يُعَكِّرُ صفوَ أحلامي حَقُودُ","يظلُّ لكلِّ ساقطةٍ يصيدُ",10,"د",1,1]]}