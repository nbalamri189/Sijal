{"poems":[[47,"أأراك الحبيب خاطر وهم","https://www.aldiwan.net/poem65655.html","الخفيف"],[41,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[102,"رسالة إلى صديق في قبره","https://www.poetsgate.com/ViewPoem.aspx?id=183584",""],[41,"شتَّ شعبُ الحيِّ بعدَ التئامْ","https://www.poetsgate.com/ViewPoem.aspx?id=4269",""],[463,"أين تريد يا مثير الظعن","https://www.aldiwan.net/poem55836.html","الرجز"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34688","الرمل"]],"verses":[["كُلُّ مَشهورَةٍ يُؤلَفُ مِنها","بَينَ دُرِّيَّةِ الكَواكِبِ نَظمي",0,"م",2,0],["كُلَّ مَشكوكٍ عَصافيرُهُ","قانِئِ اللَونِ حَديثِ الدَمام",1,"م",1,0],["كل مشروعِ على عادته","عنده التأجيل كالقات اعتيادي",2,"د",2,0],["كلَّ مشكوكٍ عصافيرُهُ،","قانىء ِ اللَّونِ، حديثِ الدِّمامْ",3,"م",1,0],["كلُّ مُشِيهٍ للوجوهِ فاضح","للذكر في شِراده والعطنِ",4,"ن",1,0],["كل مشتاقٍ إليه","فمن السوءِ فِداه",5,"ا",2,0]]}