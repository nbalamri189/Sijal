{"poems":[[53,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[53,"هذي المنازل بالغميم فنادها","https://www.aldiwan.net/poem30606.html","الكامل"],[53,"قل للخطوب ضعي سلاحك قد حمى","https://www.aldiwan.net/poem30688.html","الكامل"],[53,"أترى السحاب إذا سرت عشراؤه","https://www.aldiwan.net/poem30778.html","الكامل"],[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[3,"بين العقيق وبين بُرقة ثهمد","https://www.aldiwan.net/poem152.html",""],[3,"ريح الحجاز بحق من أنشاك","https://www.aldiwan.net/poem182.html",""],[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[24,"بكرت علي بسحرة تلحاني","https://www.aldiwan.net/poem21887.html","الكامل"],[86,"لاهم إن الغرب أصبح شعلة","https://www.aldiwan.net/poem10678.html","الكامل"],[35,"لمن الديار بأبرق الحنان","https://www.aldiwan.net/poem38817.html","الكامل"],[27,"إن المهاجر حين يبسط كفه","https://www.aldiwan.net/poem5716.html","الكامل"],[27,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[27,"ما هاج شوقك من عهود رسوم","https://www.aldiwan.net/poem6009.html","الكامل"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[72,"دمعي عليك مجانس قلبي","https://www.aldiwan.net/poem18235.html","أحذ الكامل"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"أسألت رسم الدارِ أم لم تسأل","https://www.aldiwan.net/poem65978.html","الكامل"],[26,"أمن المنون وريبها تتوجع","https://www.aldiwan.net/poem24106.html","الكامل"],[29,"صدع الخليط فشاقني أجواري","https://www.aldiwan.net/poem6065.html","الكامل"],[70,"صدق الواشون فيما زعموا","https://www.aldiwan.net/poem42718.html","الرمل"],[70,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[89,"ما حياة قديمها غير باد","https://www.aldiwan.net/poem44747.html","الخفيف"],[89,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[89,"أذكى تعصب ثلة جهال","https://www.aldiwan.net/poem44909.html","الكامل"],[62,"في القلب من حر الفراق شواظ","https://www.aldiwan.net/poem52359.html","الكامل"],[45,"عند العقيق فماثلات دياره","https://www.aldiwan.net/poem63562.html","الكامل"],[28,"إني حلفت بصارع لابن له","https://www.aldiwan.net/poem5441.html","الكامل"],[61,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[49,"إن الفناء من البقاء قريب","https://www.aldiwan.net/poem10333.html","الكامل"],[97,"إني لأقنع من ظلال أحبتي","https://www.aldiwan.net/poem24858.html","الكامل"],[87,"عرف الهوى في نظرتي فنهاني","https://www.aldiwan.net/poem8212.html","الكامل"],[31,"إن الحبيب ألم بالركب","https://www.aldiwan.net/poem42625.html","الكامل"],[52,"ضمن اللقاء رواح ناجية","https://www.aldiwan.net/poem26664.html","الكامل"],[52,"أخذت من شبابي الأيام","https://www.aldiwan.net/poem26679.html","الخفيف"],[52,"من يذود الهموم عن مكروب","https://www.aldiwan.net/poem27241.html","الخفيف"],[75,"صدق الفناء وكذب العمر","https://www.aldiwan.net/poem69076.html","أحذ الكامل"],[48,"يا صاحبي عصيت مصطبحا","https://www.aldiwan.net/poem62500.html","الكامل"],[50,"يا حب عبدة قد رجعت جديدا","https://www.aldiwan.net/poem63941.html","الكامل"],[50,"يا دار أقوت بالأجالد","https://www.aldiwan.net/poem63942.html","مجزوء الكامل"],[46,"يا قلب لا أدعوك في أكرومة","https://www.aldiwan.net/poem22912.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39586","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21004","الكامل"],[106,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[90,"معرض العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179147",""],[28,"ليست ترد ديات من قد قتلت","https://www.poetsgate.com/ViewPoem.aspx?id=22086",""],[121,"جف الكرى عكس الدموع معاً دما","https://www.aldiwan.net/poem23824.html","الكامل"],[142,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[143,"ما الحسان فما لهن عهود","https://www.aldiwan.net/poem11745.html","الكامل"],[169,"صدت فجذت حبل وصلك زينب","https://www.aldiwan.net/poem1606.html",""],[195,"منع النوم طارقات الهموم","https://www.aldiwan.net/poem54415.html","الخفيف"],[204,"إقبالهن بشارة الإقبال","https://www.aldiwan.net/poem53188.html","الكامل"],[207,"يا أيها الرجل الذي تهوي به","https://www.aldiwan.net/poem27944.html","الكامل"],[231,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[232,"قلت إن القضيب يحكيك عطفا","https://www.aldiwan.net/poem14754.html","الخفيف"],[235,"لو بات من يلحي عليك مسهدا","https://www.aldiwan.net/poem32100.html","الكامل"],[239,"لمقامك التعظيم والتبجيل","https://www.aldiwan.net/poem23840.html","الكامل"],[261,"هذي ربى الأثلات من يبرين","https://www.aldiwan.net/poem38165.html","الكامل"],[297,"ولقد حللت من المنازل واديا","https://www.aldiwan.net/poem33026.html","الكامل"],[303,"ولقد حللت ببلدة حاشى لظى","https://www.aldiwan.net/poem57766.html","الكامل"],[305,"هاج أجفاني وقلبي المغرما","https://www.aldiwan.net/poem56499.html","الرمل"],[353,"بالفتح لاح لنا الهناء مبشرا","https://www.aldiwan.net/poem40350.html","الكامل"],[364,"بكر العواذل أن رأين خصاصتي","https://www.aldiwan.net/poem60953.html","الكامل"],[371,"خلت الديار من الحبيب وشخصه","https://www.aldiwan.net/poem57350.html","الكامل"],[380,"يا من تناءت داره","https://www.aldiwan.net/poem48797.html","مجزوء الكامل"],[410,"طرقتك زائرة فحي خيالها","https://www.aldiwan.net/poem67473.html","الكامل"],[410,"ذهب الفرزدق بالفخار وإنما","https://www.aldiwan.net/poem67499.html","الكامل"],[416,"انظر إلى الأشراف كيف تسود","https://www.aldiwan.net/poem54146.html","البسيط"],[432,"قدر الأثير على الأثير علي","https://www.aldiwan.net/poem12765.html","الكامل"],[437,"صبح الجبين وليل شعرك قد غدا","https://www.aldiwan.net/poem2499.html","الكامل"],[437,"حتام تقطع بالقطيعة والجفا","https://www.aldiwan.net/poem2551.html","الكامل"],[437,"عم الندى وتواتر الإنعام","https://www.aldiwan.net/poem2560.html","الكامل"],[437,"يا حادياً هلا وقفت قليلا","https://www.aldiwan.net/poem2575.html","الكامل"],[437,"أفنيت صبري في الهوى وتجلدي","https://www.aldiwan.net/poem2581.html","الكامل"],[439,"الله جارك ظاعنا ومقيما","https://www.aldiwan.net/poem34799.html","الكامل"],[439,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[441,"ثم اعتمدنا رمي أول جمرة","https://www.aldiwan.net/poem14327.html","الكامل"],[458,"من راكب تنجو به ممسوسة","https://www.aldiwan.net/poem55832.html","الكامل"],[458,"سل عن فؤادك بين منعقِد اللوى","https://www.aldiwan.net/poem55837.html","الكامل"],[458,"اليوم أنجز ماطل الآمال","https://www.aldiwan.net/poem56072.html","الكامل"],[458,"طرقت على خطر السرى المركوب","https://www.aldiwan.net/poem56281.html","الكامل"],[461,"خل التغزل للمشوق المغرم","https://www.aldiwan.net/poem15296.html","الكامل"],[461,"أجأ وسلمى أم بلاد الزاب","https://www.aldiwan.net/poem15904.html","الكامل"],[461,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[464,"ولقد حللت من المحلة منزلاً","https://www.aldiwan.net/poem3546.html","عموديه"],[540,"إني دعوتك إذ جفيت وشفني","https://www.aldiwan.net/poem56908.html","الكامل"],[551,"كم للنواظر من دم مطلول","https://www.aldiwan.net/poem47277.html","الكامل"],[551,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[551,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[558,"يا من أرومهم بكل مرام","https://www.aldiwan.net/poem35091.html","الكامل"],[575,"إني اهتديت بذلك القمر","https://www.aldiwan.net/poem2943.html","أحذ الكامل"]],"verses":[["وَلَقَد حَمَلتُ شَبابَها وَمَشيبَها","فَإِذا المَشيبُ عَلى الذَوائِبِ أَثقَلُ",0,"ل",1,0],["وَلَقَد حَضَرتُ وَأَنتَ غائِبُ نَكبَةٍ","فَخَلاكَ ما قالَ العِدا وَتَقَوَّلوا",0,"ل",3,0],["وَلَقَد حَبَستُ عَلى الدِيارِ عِصابَةً","مَضمومَةَ الأَيدي إِلى أَكبادِها",1,"د",3,0],["وَلَقَد حَطَطتُ بِكَ الرَجاءَ وَلَم يَكُن","إِلّا إِلَيكَ تَسَبُّبي وَطِلابي",2,"ب",2,0],["وَلَقَد حَفِظتُ لَهُ فَأَينَ حِفاظُهُ","وَلَقَد وَفَيتُ لَهُ فَأَينَ وَفاؤُهُ",3,"ا",3,0],["وَلَقَد حَفِظتُ وَصاةَ عَمّي بِالضُحى","إِذ تَقلِصُ الشَفَتانِ عَن وَضَحِ الفَمِ",4,"م",1,0],["وَلَقَد حَبَستُ الدَمعَ لا بُخلاً بِهِ","يَومَ الوَداعِ عَلى رُسومِ المَعهَدِ",5,"د",1,0],["وَلَقَد حَمَلتُ عَلى الأَعاجِمِ حِملَةً","ضَجَّت لَها الأَملاكُ في الأَفلاكِ",6,"ك",1,0],["وَلَقَد حَلَفتُ لَتُصبِحَن","نَ بِبَعضِ ظُلمِكَ في مَحارَه",7,"ر",2,0],["وَلَقَد حَفِظتُ وَصاةَ مَن هُوَ ناصِحٌ","لي عالِمٌ بِمَآقِطِ الخُلّانِ",8,"ن",1,0],["وَلَقَد حَسِبتُ العِلمَ فينا نِعمَةً","تَأسو الضَعيفَ وَرَحمَةً تَتَدَفَّقُ",9,"ق",1,0],["وَلَقَد حَلفتُ لَها يَميناً صادِقاً","بِاللَهِ عِندَ مَحارِمِ الرَحمانِ",10,"ن",1,0],["وَلَقَد حَكَمتَ فَكانَ حُكمُكَ مَقنَعاً","وَخُلِقتَ زَينَ مَنابِرٍ وَمَساجِدِ",11,"د",1,0],["وَلَقَد حَبَستُ بِها المَطِيَّ فَلَم يَكُن","إِلّا السَلامُ وَوَكفُ عَينٍ تَدمَعُ",12,"ع",1,0],["وَلَقَد حَبَوني بِالجِيادِ وَأَخدَموا","خَدَماً إِلى مِئَةٍ بَهازِرَ كومِ",13,"م",1,0],["وَلَقَد حَمَيتُ الحَيَّ تَحمُلُ شِكَّتي","فُرُطٌ وَشاحِيَ إِذ غَدَوتُ لِجامُها",14,"م",3,0],["ولقد حكى كعبَ القناةِ لهُ","قلمٌ فكانَ مُباركَ الكعب",15,"ب",1,0],["ولقد حلفتُ بما حلف","تُ به وما أبغي خِلابهْ",16,"ب",2,0],["ولقد حبوتَهمُ بفاعلةِ التي","ذاعتْ لها مِدحُ الجوادِ المفضلِ",17,"ل",1,0],["وَلَقَد حَرِصتُ بِأَن أُدافِعَ عَنهُمُ","فَإِذا المَنِيِّةُ أَقبَلَت لا تُدفَعُ",18,"ع",1,0],["وَلَقَد حَلَفتُ بِرَبِّ موسى جاهِداً","وَالبَيتِ ذي الحُرُماتِ وَالأَستارِ",19,"ر",1,0],["وَلَقَد حَدَّثتُ مَن يَسأَلُني","وَحَديثي لَكَ يا مَن يَفهَمُ",20,"م",1,0],["وَلَقَد حَلا عَيشي لَدَيكَ وَلَم أُرِد","عَيشاً سِواهُ وَإِن أَرَدتُ فَلا حَلا",21,"ل",2,0],["ولقد حاقت بي المصائب تترى","من اناس عاشرتهم في بلادي",22,"ي",1,0],["ولقد حاول التحرر","حينا وما قدر",23,"ر",1,0],["ولقد حنى ظهري الضعيف بقسوة","ما للزمان الضخم من اثقال",24,"ل",1,0],["ولقد حفِظْتُ عهودَكمْ وغدرتُمُ","شتَّانَ غَدْرٌ في الهَوى وحِفَاظُ",25,"ظ",1,0],["وَلَقَد حَلَفتُ وَفي أَلِيَّتِيَ الصَفا","في هَضبِهِ وَالبَيتُ في أَستارِهِ",26,"ر",2,0],["وَلَقَد حَلَفتُ بِمُقبِلينَ إِلى مِنىً","جاؤوا عَصائِبَ فَوقَ كُلِّ سَبيلِ",27,"ل",1,0],["ولقد حَمَيْتُ الشِّعْرَ وهو لِمَعشَرٍ","رِمَمٍ سوى الأسماءِ والألقابِ",28,"ب",1,0],["وَلَقَد حَلَبتَ الدَهرَ أَشطُرَ دَرِّهِ","حِقَباً وَأَنتَ مُجَرِّبٌ وَأَريبُ",29,"ب",1,0],["ولقد حلفت لها ودمعي شاهدٌ","أني فنيت علمت أم لم تعلمي",30,"ي",1,0],["وَلَقَدْ حَنَنْتُ لِبَارِقٍ شَخَصَتْ لَهُ","مِنَّا الْعُيُونُ بِأَبْرَقِ الْحَنَّانِ",31,"ن",1,0],["وَلَقَد حَفِظتُ وَما نَسيتُ مَقالَها","عِندَ الرَحيلِ هَجَرَتنا حِبّي",32,"ي",1,0],["وَلَقَد حَلَبتُ الدَهرَ أَشطُرَهُ","وَعَبَرتُ حَظَّ الجَهلِ مِن سِنّي",33,"ن",2,0],["وَلَقَد حَثَّ بِالمُدامَةِكَفَّي","غُصنُ بانٍ عَلَيهِ بَدرٌ تَمامُ",34,"م",1,0],["وَلَقَد حَثَّ بِالمُدامَةِ كَفّي","شادِنٌ حاذِقٌ بِصَيدِ القُلوبِ",35,"ب",1,0],["ولقد حلبْتُ الدّهرَ أشطُرَهُ","فالأعذَبانِ الصّابُ والصَّبِر",36,"ر",1,0],["وَلَقَد حَزِنتُ فَلَم أَمُت حَزَناً","وَلَقَد فَرِحتُ فَلَم أَمُت فَرَحا",37,"ح",2,0],["وَلَقَد حَسَدتُ عَلى عُبَيدَةَ عَينَها","عَجَباً خُلِقتُ لِما أُحِبُّ حَسودا",38,"د",2,0],["وَلَقَد حَلَفتُ بِرَبِّ مَك","كَةَ وَالمُحَلِّقَةِ السَواجِد",39,"د",1,0],["وَلَقَد حَفَرتُ عَنِ اليَقينِ بِخاطرٍ","ما كادَ يَبلُغُ حَفرُهُ الإِنباطا",40,"ط",2,0],["ولقد حُلُّوا فوق ذلك فيها","فضةً في أساور تستنير",41,"ر",1,0],["ولقد حيَّرَ الطبيعةَ إسرا","ئي لها كلَّ ليلةٍ وطروقي",42,"ق",2,0],["ولَقَد حَفِظتُ مَكانَهُ ورَعَيتُهُ","وجَعلَتُهُ مِنِّي الأَحَبَّ الأَقربَا",43,"ب",2,0],["ولقد حسبتكَ بالسلام مبشرًا","فبرزتَ مثل الخِنجِر المتجرِّد",44,"د",1,0],["ولقد حَدَوت بأصغَريَّ ليُمليا","ما يطلُبان على اليراع ويَفرِضا",45,"ض",2,0],["ولقد حَسِبت مُصارحاً مُتخلِّعاً","في مؤنساتٍ قلتُهن مُعرِّضا",45,"ض",2,0],["وَلَقَدْ حَلَفْتُ بمُقْبِلِينَ إلى مِنىً،","جَاءوا عَصَائِبَ فَوْقَ كلّ سَبِيلِ",46,"ل",1,0],["ولقد حمدت بعيد قول لكونه","أُحبي بسامعه وحبَّ تَعَلُّما",47,"م",2,0],["ولقد حللتُ حُبَى الظلام بفتيةٍ","ألِفَتْ وجوهَهُم النجومُ الطُّلَّعُ",48,"ع",1,0],["وَلَقَد حَباهُ أُخُوَّةً وَمَحَبَّةً","مَلِكٌ لَهُ أَهلُ الزَمانِ عَبيدُ",49,"د",1,0],["وَلَقَد حَوَيتَ مِنَ المَعالي طارِفاً","تَغنى بِهِ عَن أَن يُعَدَّ تَليدُ",49,"د",1,0],["وَلَقد حَلَبتُ الدَهرَ أشطُرَ نابِهِ","وَعَرَفتُ ما يُبدي وَما يَتَغَيَّبُ",50,"ب",1,0],["وَلَقَد حالَ دونَ ذَلِكَ هَمٌّ","مِثلُهُ فَليَزَع فُؤادَ الحَليمِ",51,"م",1,0],["ولقد حرستَ مواهبَ اللَه التي","أُوتيتَ بالإحسانِ والإجمالِ",52,"ل",1,0],["وَلَقَد حُبِسنا بِالمَناقِبِ مَحبِساً","رَضِيَ الإِلَهُ بِهِ فَنِعمَ المَحبِسُ",53,"س",1,0],["وَلَقَد حَبَتهُ بِعُكَّةَ مِن سَمنِها","مَرضِيَّةً مِن خَيرِ ما نِسوانِ",54,"ن",1,0],["وَلَقَد حدتُ عَن جَمالِكَ لَمّا","قِستُهُ بِالبُدورِ نَعتاً وَوَصفا",55,"ف",2,0],["وَلَقَد حَلَبتُ الدَهرَ شَطرَيهِ وَقَلَّبتُ","الرِجالَ بِهِ ثُناءَ وَمَوحَدا",56,"د",2,0],["ولقد حوى مجدينِ مجدَ أصالة","بذراعهِ والمجد منه أصيل",57,"ل",1,0],["ولقد حباك اللَه افضل ما حبا","ابراره من حور عليين",58,"ن",1,0],["وَلَقَد حَلَلتُ من المَنازِل وادياً","مَحلَ الجوانب إسمُه البَيضاءُ",59,"ا",2,1],["ولقد حللت ببلدة حاشى لظى","وقبيح منظرها الشنيع الحالك",60,"ك",1,1],["وَلَقد حيّى فَأحيانا الأقاح","بِاسمَ الثغرِ بزرٍّ من ذهب",61,"ب",1,0],["وَلَقد حَمدنا السَعي في طَلب العُلى","وَلَدى الصَباح سَيحمدُ القَوم السرى",62,"ر",2,0],["ولقد حننت إلى العراق ومن به","كحنين ظمآن إليه مرود",63,"د",1,0],["ولقد حَرصتُ على التجلُّدِ بعدَه","لو كان يَنتَفعُ الحَريصُ بحرصِهِ",64,"ص",2,0],["وَلَقَد حَذرت الحُب لَكن","ما أَفادَ حذاره",65,"ر",2,0],["وَلَقَد حَذَوتَ لِمَن أَطاعَ وَمَن عَصى","نَعلاً وَرِثتَ عَنِ النَبِيِّ مِثالَها",66,"ل",3,0],["وَلَقَد حُبيتُ بِأَلفِ أَلفٍ لَم تُثَب","إِلّا بِسَيبِ خَليفَةٍ وَأَميرِ",67,"ر",1,0],["ولقد حماها بالصوارم والقنا","فعمان غيل والرجال أُسُود",68,"د",1,0],["ولقد حضرتُ بها ورُمْتُ صفاتِها","عجِلاً فساعدَ خاطرٌ ورويُّ",69,"ي",1,0],["ولقد حلبت الدهر أشطرهُ وجر","ربت الأنام به ثنا وموحّدا",70,"د",2,0],["ولقد حبست الدمع حتى لم أجد","عذرا لدمع العين أن لا يذرفا",71,"ف",2,0],["ولقد حللت من العلاء بمنزل","ما حلّه في سعده بهرام",72,"م",1,0],["ولقد حمدت قصير ليلي بعدكم","وذممت من يوم الفراق طويلا",73,"ل",2,0],["ولقد حفظتُ لك المودّة جاهداً","وودتّ لو ترعى حقوق تودّدي",74,"ي",1,0],["ولقد حَمَيْتَ ذِمارَ أُمَّةِ أحمدٍ","وأبَحْتَ من عِزِّ الضلالِ حَريما",75,"م",2,0],["ولقد حَفِظْتُ لَهُ أَمانَةَ لاعِجٍ","بالشَّوْقِ يَغْلي فِي الفؤادِ غليلُهُ",76,"ل",2,0],["ولقد حللنا بعد ذا إحرامنا","بمنى ضحايا قبل ذبح الأضحيه",77,"ي",2,0],["ولقد حلفتُ فلا أخاف تحرُّجا","بالبيت عن بطحائه وحُجونهِ",78,"ن",2,0],["ولقد حملتُ حديثَهم في أضلعٍ","للسرِّ مُشرَجَةٍ على الكتمانِ",79,"ن",1,0],["ولقد حلا فسعيتُ حتى حلّ لي","ما كان يحلو طعمُه بحلالِ",80,"ل",1,0],["ولقد حَبستُ عن اللئامِ مَطامعي","وأطلتُ في دار الهوان مَغيبي",81,"ب",2,0],["ولقد حلبتُ الدهر أشْطرهُ فما","غادرتُ عِلْماً فيه لم أتَعَلَّمِ",82,"م",1,0],["ولقد حَبَستُ قلائدي وكتمْتُها","كيْ لا تُذال َ بمِنْحَةٍ وثَوابِ",83,"ب",1,0],["ولقد حُبيتَ من الرجال بناصِحٍ","ما في نميرِ ولائهِ أقْذاءُ",84,"ا",2,0],["ولقد حللتُ من المحلَّة منزلاً","ملك العيون وجاز رقَّا الأنفس",85,"س",1,1],["وَلَقَد حُفيتَ صَبيبَ عُكّةِ بَيتِنا","ذَوباً وَمِزتُ بصّفوِهِ عَنكَ القَذى",86,"ا",1,0],["ولقد حملتُ غداة زُمّتْ للنّوى","أُدْمُ الرّكائبِ فيه كلَّ ثقيلِ",87,"ل",1,0],["ولقد حملتُ غداةَ زُمّتْ للنّوى","أحمالُكمْ في الحبِّ ما لا يُحمَلُ",88,"ل",1,0],["وَلَقد حذرتُ من التفرّق بيننا","شُحّاً عَليك فَجاءني ما أحذرُ",89,"ر",1,0],["ولقد حظيت بهم على فُرُشِ التقى","وأنا وإياهم لفيف قوام",90,"م",1,0],["ولقد حذِرْتُ عليه مجتهداً","حتى حَذِرْتُ عليْه من حَذَرِي",91,"ي",1,0]]}