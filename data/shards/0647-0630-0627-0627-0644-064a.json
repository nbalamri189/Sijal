{"poems":[[95,"أمرتني وبهذا الأمر تسعدني","https://www.aldiwan.net/poem11261.html","البسيط"],[95,"إنا نحيي حفلكم ويسرنا","https://www.aldiwan.net/poem11405.html","الكامل"],[74,"قاضي القضاة بيمنى حكمه القلم","https://www.aldiwan.net/poem19672.html","البسيط"],[94,"ضعف العزيمة لحد في سكينته","https://www.aldiwan.net/poem38923.html","البسيط"],[46,"أطلالهم سلبت دماها الهيفا","https://www.aldiwan.net/poem30403.html","الكامل"],[71,"هذا اليهودي الطبيب إذا رأى","https://www.aldiwan.net/poem28391.html","الكامل"],[71,"هذا اليهودي الطبيب الذي","https://www.aldiwan.net/poem28864.html","السريع"],[54,"وتخاله يوم الرهان غمامة","https://www.aldiwan.net/poem26841.html","عموديه"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54860","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[92,"سيصدني وأصده","https://www.poetsgate.com/ViewPoem.aspx?id=179085",""],[92,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[228,"ويل الضعيف من القدير","https://www.aldiwan.net/poem41921.html","مجزوء الكامل"],[354,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[371,"وكم أغص بماء المرهفات عدى","https://www.aldiwan.net/poem17240.html","البسيط"],[371,"برذوننا اليوم ما به عجب","https://www.aldiwan.net/poem17361.html","المنسرح"],[376,"ما طول الليل القصيرا","https://www.aldiwan.net/poem57394.html","مجزوء الكامل"],[505,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[543,"يا طاهر والله إنك طاهر","https://www.aldiwan.net/poem48188.html","عموديه"],[567,"جمعت من أفضل الأسماء في القدم","https://www.aldiwan.net/poem52833.html","البسيط"],[567,"قف بين ريحان العقيق وضاله","https://www.aldiwan.net/poem52961.html","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34425","السريع"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80240","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61059","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61042","الرجز"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118764","الرجز"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216716",""],[3726,"","https://poetry.dctabudhabi.ae/diwan/poem/31383","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85221","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76458","البسيط"],[4997,"الأحول","https://www.poetsgate.com/ViewPoem.aspx?id=108085",""],[5045,"اليمن مرفوع فوق","https://www.poetsgate.com/ViewPoem.aspx?id=185174",""],[5057,"وُلد الرسولُ","https://www.poetsgate.com/ViewPoem.aspx?id=208543",""],[5106,"مِنْ ضَوْءِ أَلْفِ صَبَاْحٍ قَدْ سَرَىْ","https://www.poetsgate.com/ViewPoem.aspx?id=150036",""],[5281,"الخطبُ هدَّ مشاعري","https://www.poetsgate.com/ViewPoem.aspx?id=199701",""],[5281,"مُقلةُ الحُسْنِ..رسولنا محمدٌ صلى الله عليه وسلَّم","https://www.poetsgate.com/ViewPoem.aspx?id=200143",""],[5389,"هارون الأمة","https://www.poetsgate.com/ViewPoem.aspx?id=206085",""],[5526,"لا تامن سهيل","https://www.poetsgate.com/ViewPoem.aspx?id=194420",""],[5559,"بيننا شغاف الروح ( محمود أسد )","https://www.poetsgate.com/ViewPoem.aspx?id=60738",""],[5765,"يقينٌ يحمل أوجاعه","https://www.poetsgate.com/ViewPoem.aspx?id=212342",""],[402,"إنا نحيي حفلكم ويسرنا","https://www.poetsgate.com/ViewPoem.aspx?id=36208",""],[5829,"جحود العرب","https://www.poetsgate.com/ViewPoem.aspx?id=187393",""]],"verses":[["هَذَا إِلَى أَدَبٍ فِي المَعْنِيينَ إِلَى","بَدَاهَةٍ فِي إِدَاءٍ جِدًّ مُتَّزِنِ",0,"ن",1,0],["هَذَا إِلَى إِنَّا حَمَدْنَا مِنْكُمُ","آياتِ وُدٍّ خَالِصٍ وَذِمَامِ",1,"م",1,0],["هذا اليراع الذي تجني الفخار به","يدُ الإمام التي معروفها أمَمُ",2,"م",1,0],["هذا إلى الموتِ والأَجداثُ ساخِرةٌ","وذا إلى المجدِ والدُّنيا لَهُ خَوَلُ",3,"ل",1,0],["هَذا إِلى قِدَمِ الذِمامِ بِكَ الَّذي","لَو أَنَّهُ وَلَدٌ لَكانَ وَصيفا",4,"ف",2,0],["هذا اليهوديُّ الطبيبُ إذا رأى","أَمَتي الضعيفةَ عنهُ طبعي نافرُ",5,"ر",1,1],["هذا اليهوديُّ الطبيبُ الذي","لا طوَّلَ اللهُ لنا عمرَهُ",6,"ر",2,1],["هَذا إِلى ضافي الذُيولِ مُضاعَفٍ","كَالسَلخِ مِن قُمُصِ الحَديدِ مُسبَغِ",7,"غ",1,0],["هذا إلى الثَّغرِ وما يليهِ","على عدوِّ الشِّركِ أو ذويهِ",8,"ه",1,0],["هَذا إلى فِطَنٍ يُقَصِّرُ دُونَهَا","مَجْهُودُ طَائِفَةٍ مِنَ الفُطَنَاءِ",9,"ا",2,0],["هَذَا إِلى عَقْلٍ رَفِيعٍ إِلى","قَلْبٍ كَبِيرٍ مَا بِهِ كِبْرُ",10,"ر",1,0],["هَذَا إِلى مَا لاَ يُحِيطُ بِوَصْفِهِ","فِكْرِي وَدُونَ أَقَلَّهِ إِطْرَائِي",11,"ا",2,0],["هذا اليتيم قد انحازت مفاصله","من جلبة الجوع والظلام تخمان",12,"ن",1,0],["هذا اليراع ذبابه","للذَّب عنه أُعده",13,"د",2,0],["هذا اليراعُ ، شواظُ الحقّ أرهفه","سيفاً . وخانعُ رأيٍ ردَّه خشبا",14,"ب",2,0],["هذا إِلى الأَمواتِ يَس","قُطُ ذاكَ ينزِلُ بِالحَرير",15,"ر",1,0],["هَذا اليَقينُ لَيسَ بِالظَ","نِّ وَحَذَرِ مَن حَذَر",16,"ر",1,0],["هَذا إِلى أَنَّ أَقوالي كَما عَلِموا","مِن المُلوكِ وَبَعضَ القَولِ كَالسُوَقِ",17,"ق",1,0],["هَذا إِلى مَجلِسٍ فُكاهَتُهُ","فاكِهَةٌ بِالقُلوبِ تُنتَهَبُ",18,"ب",1,0],["هَذا إلى أَن قامَ قا","ئِمُ آل أحمدَ مُستَثيرا",19,"ر",2,0],["هذا إلى الحقِّ يمْشي لا على مَهَلٍ","وذاكَ بالزُّورِ والبُهْتانِ مَشَّاءُ",20,"ا",2,0],["هذا إلى خُلُقٍ تَضوَّعَ نَشرُه","قد فاوَحتهُ في البُكورِ أزاهرُ",21,"ر",1,0],["هذا اليَراعُ الذي استخدَمتَ عامِلَهُ","قامَتْ لَدَيهِ سُيوفُ الهِندِ كالخَدَمِ",22,"م",1,0],["هذا اليسيرُ منَ الفِراقِ وإنما","ستَرَى فراقاً ليسَ من أشكالِهِ",23,"ل",2,0],["هَذا إِلى علم وحلم إِلى","فصل وَفضل جائِدٍ لِلطِلاب",24,"ب",1,0],["هَذا إِلى الأَجناد يَهدي كَفُّهُ","يمنا وَهَذا لِلبِلاد يُنيرُ",25,"ر",1,0],["هَذا إِلَيك كِتابهُ قَد خَطه","بِسَواد قَلب لَم يَخنك فَتيلا",26,"ل",2,0],["هَذا إِلى تحدر","وَذا إِلى تَصعد",27,"د",1,0],["هذا إِلى حسن يقينٍ باهر","مثل يقين ابن أبي قحافه",28,"ف",2,0],["هذا إلى ذاك ينتهي","إن طال أو قصّر الأمدْ",29,"د",1,0],["هَذا اليَقينُ فَكَيفَ أَنسى فَقدُهُ","إِن رابَ دَهرٌ أَو نَبا بِيَ مَضجَعُ",30,"ع",1,0],["هذا اليراع إذا يشار له","وافى لكل لطيفة بكر",31,"ر",1,0],["هَذا إِلى الشعب في أَعماله اعضد","بل خنجر للدَواهي يقطع الودجا",32,"ج",2,0],["هذا اليراعُ وماتلاه حقيقة ٌ","يبقى يخطُّ على الزمان وينقلُ",33,"ل",1,0],["هذا اليمن نبع الحضارة من بدايات الشروق","لاتحملوا مالاتطيقوا اليمن عارف طريقة",34,"ق",2,0],["هذا اليتيمُ وسوفَ يحوي قلبُهُ","مَنْ في هواهُ وجهلِهِ مسجونُ",35,"ن",1,0],["هَذَاْ اليَرَاْعُ وَقَلْبِيْ قَدْ أَتَاْكَ كَمَاْ","يَأتِيْ الوَفَاْءُ عَلَىْ صِدْقٍ يُوَاْزِيْهِ",36,"ي",2,0],["هذا اليراعُ؛ وقد تلحَّفَ بالأَسَى","يبكيهِ في أَلَمٍ وفي خُسْرانِ",37,"ن",1,0],["هَذَا اليَتِيْمُ أَبُو الأَيْتَامِ رَحْمَتُهُ","قَدْ أَكْرَمَتْ أُمَّةً وَاسْتَزْرَعَتْ أُمَمَا",38,"م",2,0],["هذا اليوم مو يوم انتخابات","عقدة وراد بارينه يحلهه",39,"ل",3,1],["هذا اليماني فوق .. شامخ عن الميل","يا الآدمي ادعَك وفتّح عيونك",40,"ك",1,0],["هذا اليراعُ يخطُّ بعضَ نحيبِهِ","فإذا المدادُ وجيفُهُ مُسْتأْجَرُ",41,"ر",1,0],["هذا اليقين المحض أنت يقينه","سيجيئ نحوك حاملاً آلامهْ",42,"م",2,0],["هذا إلى إنا حمدنا منكم","آيات ود وخالص وذمام",43,"م",1,0],["هذا اليقين فمن يكفر بوحدتنا","تلقاه مندحرا والذل مثواه",44,"ا",2,0]]}