{"poems":[[57,"ظهر الخفاء فقلت إن عاتبتها","https://www.aldiwan.net/poem26201.html","الكامل"],[79,"وطموح العباب ضافي المقيل","https://www.aldiwan.net/poem36336.html","الخفيف"],[88,"جاز بي عرفها فهاج الغراما","https://www.aldiwan.net/poem68932.html","الخفيف"],[23,"يا دوس إن أبا أزيهر أصبحت","https://www.aldiwan.net/poem21465.html","الكامل"],[15,"أنبئت أن بني جديلة أوعبوا","https://www.aldiwan.net/poem45285.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142405","الوافر"],[154,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[170,"أقوت معاهدهم وشط الوادي","https://www.aldiwan.net/poem47098.html","الكامل"],[190,"حادثات دهمن في أسبوع","https://www.aldiwan.net/poem43630.html","الخفيف"],[275,"ذهب الحب فما أشقى الفتى","https://www.aldiwan.net/poem35593.html","الرمل"],[276,"خطرت كغصن البانة المتأود","https://www.aldiwan.net/poem52072.html","الكامل"],[287,"لا والنبي محمد والأترع","https://www.aldiwan.net/poem32712.html","الكامل"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[358,"لا تعتب الوغد اللئيم إذا أسا","https://www.aldiwan.net/poem40167.html","الكامل"],[382,"أدركت شأوك فاتق الأسواء","https://www.aldiwan.net/poem66973.html","الكامل"],[438,"يا أيها الثقة الذي وثقت به","https://www.aldiwan.net/poem12351.html","الكامل"],[463,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[463,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[466,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[482,"قلب كما شاء التفرق موجع","https://www.aldiwan.net/poem15245.html","الكامل"],[556,"من لداع لا يجاب","https://www.aldiwan.net/poem48097.html","مجزوء الرمل"],[567,"دعني فلست على الزمان بعاتب","https://www.aldiwan.net/poem52746.html","الكامل"],[580,"سمعت بأمر ليتني لا سمعته","https://www.aldiwan.net/poem2732.html","الطويل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216883",""],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/74002","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128704","الكامل"],[1901,"","https://poetry.dctabudhabi.ae/diwan/poem/216574","البسيط"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124055","الكامل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110630","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60951","الكامل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/198651","الرمل"],[445,"","https://poetry.dctabudhabi.ae/diwan/poem/48099","الكامل"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21608","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204478","الخفيف"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103449","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100748","المتقارب"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139923","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62946","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3989,"","https://poetry.dctabudhabi.ae/diwan/poem/147364","الخفيف"],[4662,"","https://poetry.dctabudhabi.ae/diwan/poem/204142","المتقارب"],[4984,"طموح","https://www.poetsgate.com/ViewPoem.aspx?id=191455",""],[5149,"عَبَثَ النُّعَاسُ بِجَفنِها","https://www.poetsgate.com/ViewPoem.aspx?id=213018",""],[5956,"أجبني","https://www.poetsgate.com/ViewPoem.aspx?id=182296",""],[5956,"لماذا لستِ نائمة","https://www.poetsgate.com/ViewPoem.aspx?id=194124",""],[6045,"أملٌ ممتنع !","https://www.poetsgate.com/ViewPoem.aspx?id=125350",""],[445,"لَوْ كَانَ يَعْدِلُ حاكِمٌ فِي حُكْمِهِ","https://diwany.org/%D9%84%D9%8E%D9%88%D9%92-%D9%83%D9%8E%D8%A7%D9%86%D9%8E-%D9%8A%D9%8E%D8%B9%D9%92%D8%AF%D9%90%D9%84%D9%8F-%D8%AD%D8%A7%D9%83%D9%90%D9%85%D9%8C-%D9%81%D9%90%D9%8A-%D8%AD%D9%8F%D9%83%D9%92%D9%85%D9%90/","الكامل"],[463,"خاطرْ بها إما ردى أو مرادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60030&r=&rc=86",""],[463,"إذا رفعتْ من شرافَ الخدورُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60064&r=&rc=120",""]],"verses":[["وَطَمِعتُ أَن تَبقى المَوَدَّةٌ بَينَنا","مَوصولَةً فَتَرَكتُ ذاكَ لِذاكا",0,"ك",2,0],["وطَمُوحِ الْعُبَابِ ضَافِي الْمَقيلِ","حَسِرِ الدَّوْحِ عَنْ حُسَامٍ صَقِيلِ",1,"ل",1,1],["وَطَمِعنا في شَأوِهِ فَقَعَدنا","وَكَسَرنا مِن عَجزِنا الأَقلاما",2,"م",2,0],["وَطِمِرَّةٍ مَرَطى الجِراءِ كَأَنَّها","سيدٌ بِمُقفِرَةٍ وَسَهبٍ أَفيَحِ",3,"ح",1,0],["وَطِمِرَّةٍ كَالسيدِ يَعلو فَوقَها","ضِرغامَةٌ عَبلُ المَناكِبِ أَغلَبُ",4,"ب",1,0],["وطمأن للجواري كلّ بحر","وبلّغها السعادة والنجاحا",5,"ح",2,0],["وطمت بحار علومه فتقاذفت","من لفظه باللؤلؤ المكنون",6,"ن",1,0],["وطمعتُ منها في الوصالِ لأنّها","تَبني الأمورَ على خلافِ مُرادي",7,"د",2,0],["وطمرّيَ رجلي وكفّي وسادي","وأنيسيَ فكري وشعري ربيعي",8,"ع",2,0],["وطمِعنا بخلودٍ فَغَدا","حظُّنا البؤسى ونعمانا كفي",9,"ي",1,0],["وَطمعت منها بالحَديث وَقلت هَل","من شربة يا أَهل هَذا المورد",10,"د",1,0],["وَطَمِعتُ مِنكُم بِالوَفاءِ وَلَيسَ في","قَبضِ الثُرَيّا وَالسُها مِن مَطمَعِ",11,"ع",1,0],["وطمأنت قلبي وفزّعته","فيا ويح للمؤمن الملحد",12,"د",1,0],["وَطَمعت مِنهُ بِفَجر وَعدٍ كاذبٍ","فَرَأَيت لَيل الخلف طالَ وَعَسعَسا",13,"س",2,0],["وَطَمَت بِحارُ الحين من عَصَفاتِها","فَسَرت وكان مَقَرُّها الأَحياءَ",14,"ا",2,0],["وطمِعْتُ يَوْمَ الأَربعاءِ بقَبْضِهِ","فَصَبَرْتُ بعد الأَربعاءِ الرابع",15,"ع",1,0],["وطمعتْ في زمني فضائلي","وكنتُ من إنصافه مستيئسا",16,"س",2,0],["وطمِعتْ فيّ ذئابُ العدا","حتى حلا مضغٌ لها وازدرادْ",17,"د",1,0],["وطما أتِيُّ الحربِ حتى ماؤُهُ","مُهَج الفوارس والرُّؤوسُ غُثاءُ",18,"ا",2,0],["وطما السرابُ وغرَّها رقراقُه","فتساقطتْ فيه تَعُبُّ وتكرعُ",19,"ع",1,0],["وَطَما المَدُّ الّذي في","هِ مِنَ المَوتِ عُبابُ",20,"ب",1,0],["وطَمِعتُ منهُ على البِعادِ بضَوئهِ","إذ تلكَ عادةُ كلِّ نجمٍ ثاقبِ",21,"ب",1,0],["وطمَّنني إِبليسُ حين عَتِبْتُه","بأَنْ قال هَذا الأَمرُ لَيْسَ يَدُومُ",22,"م",1,0],["وطمرة كهراوة ال","أعزاب ليس لها عدائد",23,"د",1,0],["وطمعت في رجعِ السلامِ فهل تُرى","يحظى لديه قبوله بقبولِ",24,"ل",1,0],["وطمعت في سير وسيل زادني","عجبا وزانني الجناس المطمع",25,"ع",1,0],["وطمأَنَ النفسَ في هجر وفي صِلةٍ","علمي بأنَ كلا الحالين دَيْدانُ",26,"ن",1,0],["وطمت بأكثرهم طوامى نخوة","أعمت بصائرهم عن استبصار",27,"ر",1,0],["وطمت بحار للعلوم به","ان غاض بحر مده بحر",28,"ر",1,0],["وطَمِعْتُ بعدَك بالسَّلو فخانني","أنَّ السلو كماً علمتَ بعيد",29,"د",1,0],["وطمى الشرق عليه فانتحى","من هلال غائب في زورق",30,"ق",1,0],["وطما عَلَى العافِينَ بحرُ سماحِهِ","فحوى الثناءَ بِطِمِّهِ وبِرِمِّهِ",31,"م",2,0],["وَطَماطيمَ مِن سَبابيجَ غُتمٍ","البسوني مَعَ الصَباحِ القُيودا",32,"د",2,0],["وطموحي الى الخلود دليل","لاشتقاقي من أنفس خالدات",33,"ت",1,0],["وطمعٌ مؤيسٌ قريبٌ إلى الفه","مِ بعيدُ الأَغوار ضاحي القرارِ",34,"ر",1,0],["وطمَّ البلاءُ ولا منجد","لأَحرارها ولأَحزابها",35,"ب",3,0],["وطمعتُ أن تُجلى وأبصر وجهها","وتقرُّ عيني بالهلال الطالعِ",36,"ع",1,0],["وطمرّةِ ماطورةٍ بلجامِها","قُود أَسَالِمَةِ النساةِ الأَسعَرِ",37,"ر",1,0],["وطمعٌ في الخلق شك قد يرى","في خالقٍ فاطمع بخالق الورى",38,"ر",2,0],["وطموحا ً ودولة وشبابا ً","واخضراراً قد أكسب الفضل فضلا",39,"ل",2,0],["وطمنت نفسك ذا ميعة","مسح النضال إذا يرسل",40,"ل",1,0],["وطموحك المحموم فَلَّ إرادة","فَازْدَدْت من نصب المسير خمولا",41,"ل",2,0],["وَطَمِعْتُ فِي طِيبِ اللِّقَاءِ فَكَانَ لِي","لُقيَا عيُونِكِ مَا أَغَلَّ وَأخصَبَا",42,"ب",2,0],["وطَمْيَ النهر يلفظ ضِفّتيهِ","وينْتِنُ كلّ ما في الأرض حتى",43,"ت",2,0],["وطمأنة وتوتيرا","وتحقيراً وتقديرا",44,"ر",2,0],["وطمعت من فيء الزمانِ إتاوةً","والدهر ليس بمقنعٍ من يطمعُ",45,"ع",1,0],["وطما عَلهِ لما أَنْ مَضَتْ","عَلْيَاهُ فِي مكنونِ سابِقِ عِلْمِهِ",46,"م",2,0],["وطمعتْ فيّ ذئابُ العدا","حتى حلا مضغٌ لها وازدادْ",47,"د",1,0],["وطمعانِ إن طمعَ الحلوُ في","ه قام يدافعُ عنه المريرُ",48,"ر",1,0]]}