{"poems":[[32,"نبت عيناك عن طلل بحزوى","https://www.aldiwan.net/poem29591.html","الوافر"],[14,"أفي ناب منحناها فقيرا","https://www.aldiwan.net/poem38314.html","الوافر"],[87,"ببيت الأمة أعتقل المطيا","https://www.aldiwan.net/poem6825.html","الوافر"],[47,"تعود عوائد الدمع المراق","https://www.aldiwan.net/poem65196.html","الوافر"],[30,"ومظلمة علي من الليالي","https://www.aldiwan.net/poem5455.html","الوافر"],[68,"يا ليت شعري وقد أودى بك القدر","https://www.aldiwan.net/poem40138.html","البسيط"],[33,"ألا تجزي عثيمة ود صب","https://www.aldiwan.net/poem41326.html","الوافر"],[33,"خليلي مرا بي على رسم منزل","https://www.aldiwan.net/poem41841.html","الطويل"],[108,"أنصاف رجال","https://www.poetsgate.com/ViewPoem.aspx?id=179440",""],[123,"سل الخلصاء ما صنعوا بعهدي","https://www.aldiwan.net/poem49370.html","الوافر"],[135,"ألم يأن أن تجفو الصبا وتحلما","https://www.aldiwan.net/poem54748.html","الطويل"],[210,"وإني حاذر أنمي سلاحي","https://www.aldiwan.net/poem27931.html","الوافر"],[225,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[232,"إذا كنت مصطفيا مربعا","https://www.aldiwan.net/poem51269.html","المتقارب"],[264,"سلا عن ربي سلع فأعين عينها","https://www.aldiwan.net/poem38135.html","الطويل"],[278,"لا أعصر الخمر بل أغرس العنبا","https://www.aldiwan.net/poem25626.html","البسيط"],[325,"أتصرم أم تواصلك النجود","https://www.aldiwan.net/poem56354.html","الوافر"],[367,"أأحبابنا قد شقتمونا فأسعدوا","https://www.aldiwan.net/poem60942.html","الطويل"],[457,"نبئت أن رجالا خاف بعضهم","https://www.aldiwan.net/poem26638.html","البسيط"],[460,"تعجب من صبري على ألوانِها","https://www.aldiwan.net/poem55823.html","الرجز"],[507,"المقاوم","https://www.aldiwan.net/poem56770.html","الطويل"],[553,"سأبلغ حاجاتي وإن كن نزحا","https://www.aldiwan.net/poem47156.html","الطويل"],[553,"ما صيد قلبك إلا بابنة الكلل","https://www.aldiwan.net/poem47265.html","البسيط"],[553,"أروني امرءا من قبضة الدهر مارقا","https://www.aldiwan.net/poem47364.html","الطويل"],[553,"أبا بكر تعرضت المنايا","https://www.aldiwan.net/poem47723.html","الوافر"],[571,"فان يبل الشباب فكل شيء","https://www.aldiwan.net/poem51993.html","الوافر"],[577,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"],[818,"","https://poetry.dctabudhabi.ae/diwan/poem/18681","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/28065","الطويل"],[1042,"","https://poetry.dctabudhabi.ae/diwan/poem/202263","الطويل"]],"verses":[["وَأَنّي حينَ تَزخَرُ لي رِبابي","عَماعِمَ أَمنَعُ الثَقلَينِ جارا",0,"ر",2,0],["وَأَنّي حينَ تَشتَجِرُ العَوالي","حَوالي اللُبَّ ذو رَأيٍ زَميتُ",1,"ت",1,0],["وإن يحمل إليك الإذن فاصعد","تجد دَرَجا يبلغك الرُّقيا",2,"ي",2,0],["وَإِنّي حينَ تُؤذِنُني بِصَرمِ","رَبيطُ الجَأشِ مُتَّسِعُ الخِناقِ",3,"ق",1,0],["وَإِنّي حافِظٌ فَاِحفَظ يَميني","بِمَكَّةَ حَيثُ أُلقِيَتِ الرِحالُ",4,"ل",1,0],["وَأَن يُحَثُّ إِلى مَغناكَ وُفدُ ثَناً","وَليسَ مِنكَ بِهِ عَينٌ وَلا أَثَرُ",5,"ر",1,0],["وَإِنّي حينَ يُفشى سِرُّ هاذٍ","لِسِرّي حافِظٌ أَبَداً كَتومُ",6,"م",1,0],["وَإِن يَحضُرِ الواشي تُطِعهُ وَإِن يَقُل","بِها كاشِحٌ عِندي يُجَب ثُمَّ يُعزَلِ",7,"ل",1,0],["وإن يَحْلل فتاهم قلب أنثى","يحلَّ هناك بالركن الخراب",8,"ب",1,0],["وإني حين تغشاني أذاةٌ","ليشفع للمسيء الود عندي",9,"د",2,0],["وأنَىَّ حَامٍ لِلدِّمَارِ ودَيدَنِي","وَيعلَمُهُ أني أذُبُّ عَنِ الحِمَى",10,"م",2,0],["وَإِنّي حاذِرٌ أَنمي سِلاحي","إِلى أَوصالِ ذَيّالٍ مَنيعِ",11,"ع",1,1],["وإن يحرك بعد همز قد جلا","سكونه فادغما كسأل",12,"ل",1,0],["وإن يحركا وواحد كسر","فالثاني اقلبنه يا كما أثر",12,"ر",1,0],["وأنِّي حَنِيفٌ بريءٌ إليك","من الشكّ والشرك والإعتداءِ",13,"ا",2,0],["واني حسين والأعادي أمية","ولا عجب من غدرها بحسينها",14,"ن",3,0],["وإنّ يَحْيى بنَ عبد الواحدِ بنِ أبي","حَفْصٍ لأَنوَرُ من شَمسِ الضُحى نَسبا",15,"ب",2,0],["وَإِنّي حاكِمٌ في الشِعرِ حُكماً","إِذا ذُكِرَ القَوافي وَالنَشيدُ",16,"د",1,0],["وإنْ يَحْكِ دَمْعي دَمعَها ببياضِه","ومن تحتهِ نارُ الجوانح تُوقَد",17,"د",1,0],["وَإِن يَحينوا أَقُل قَولاً لَهُ أَثَرٌ","باقٍ يُعَنّي قَراطيساً وَأَقلاما",18,"م",2,0],["وإن يُحِلْكَ ما استفدتَ بعدَنا","من ورَق الدنيا ومن أفنانِها",19,"ن",3,0],["وأنّي حفيدُ الجوعِ والصّبرُ لي أبٌ","وأمِّي الشّقاءُ والخليقُ كِساها",20,"ا",3,0],["وإنّي حَرونٌ عن ديارٍ مَرِيعةٍ","وكم ساق لِي عِزّاً طويلُ حِراني",21,"ن",2,0],["وإنْ يحولوا ويَضحَوا غيرَ مَن عهدوا","فإنّني لم يَزُلْ ودّي ولم يَحُلِ",22,"ل",1,0],["وأنْ يحجبَ الصُّفّاحُ بيني وبينه","ويودعه وسْطَ العَراءِ الشّقائقا",23,"ق",2,0],["وإنْ يَحْرَجْ مكانُك من تُرابٍ","فإنّك ذلك الرَّحْبُ الوسيعُ",24,"ع",1,0],["واني حين أَنسب من تميم","لَفي الشم الشماريخ الطوالِ",25,"ل",1,0],["وإِنِّي حظُ الحظِّ لو كَانَ عاقِلاً","لقد أَخطأَ الحظُّ الَّذي يَتَخَطَّاني",26,"ن",2,0],["وَإِنّي حَنى ظَهري خُطوبٌ تَتابَعَت","فَمَشيِيَ ضَعيفٌ في الرِجالِ دَبيبُ",27,"ب",1,1],["وَإِنّيَ حَقا لم تُصِبني مُصيبَةٌ","مِنَ الدَهرِ إِلّا قَد أَصابَت فَتىً قَبلي",28,"ل",2,0],["وأن يحفظ الحلف الذي سن شيخه","ولا يلحدن فيه بظلم ولا غدر",29,"ر",1,0]]}