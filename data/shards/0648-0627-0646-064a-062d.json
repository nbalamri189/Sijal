{"poems":[[32,"نبت عيناك عن طلل بحزوى","https://www.aldiwan.net/poem29591.html","الوافر"],[14,"أفي ناب منحناها فقيرا","https://www.aldiwan.net/poem38314.html","الوافر"],[87,"ببيت الأمة أعتقل المطيا","https://www.aldiwan.net/poem6825.html","الوافر"],[47,"تعود عوائد الدمع المراق","https://www.aldiwan.net/poem65196.html","الوافر"],[30,"ومظلمة علي من الليالي","https://www.aldiwan.net/poem5455.html","الوافر"],[68,"يا ليت شعري وقد أودى بك القدر","https://www.aldiwan.net/poem40138.html","البسيط"],[33,"ألا تجزي عثيمة ود صب","https://www.aldiwan.net/poem41326.html","الوافر"],[33,"خليلي مرا بي على رسم منزل","https://www.aldiwan.net/poem41841.html","الطويل"],[108,"أنصاف رجال","https://www.poetsgate.com/ViewPoem.aspx?id=179440",""],[124,"سل الخلصاء ما صنعوا بعهدي","https://www.aldiwan.net/poem49370.html","الوافر"],[136,"ألم يأن أن تجفو الصبا وتحلما","https://www.aldiwan.net/poem54748.html","الطويل"],[211,"وإني حاذر أنمي سلاحي","https://www.aldiwan.net/poem27931.html","الوافر"],[227,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[234,"إذا كنت مصطفيا مربعا","https://www.aldiwan.net/poem51269.html","المتقارب"],[266,"سلا عن ربي سلع فأعين عينها","https://www.aldiwan.net/poem38135.html","الطويل"],[280,"لا أعصر الخمر بل أغرس العنبا","https://www.aldiwan.net/poem25626.html","البسيط"],[327,"أتصرم أم تواصلك النجود","https://www.aldiwan.net/poem56354.html","الوافر"],[369,"أأحبابنا قد شقتمونا فأسعدوا","https://www.aldiwan.net/poem60942.html","الطويل"],[460,"نبئت أن رجالا خاف بعضهم","https://www.aldiwan.net/poem26638.html","البسيط"],[463,"تعجب من صبري على ألوانِها","https://www.aldiwan.net/poem55823.html","الرجز"],[510,"المقاوم","https://www.aldiwan.net/poem56770.html","الطويل"],[556,"سأبلغ حاجاتي وإن كن نزحا","https://www.aldiwan.net/poem47156.html","الطويل"],[556,"ما صيد قلبك إلا بابنة الكلل","https://www.aldiwan.net/poem47265.html","البسيط"],[556,"أروني امرءا من قبضة الدهر مارقا","https://www.aldiwan.net/poem47364.html","الطويل"],[556,"أبا بكر تعرضت المنايا","https://www.aldiwan.net/poem47723.html","الوافر"],[574,"فان يبل الشباب فكل شيء","https://www.aldiwan.net/poem51993.html","الوافر"],[580,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138275",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83340","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83310","المنسرح"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53866","الوافر"],[686,"","https://poetry.dctabudhabi.ae/diwan/poem/206245","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62551","المتقارب"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96750","الطويل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203678","الهزج"],[173,"","https://poetry.dctabudhabi.ae/diwan/poem/29577","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122103","البسيط"],[2172,"","https://poetry.dctabudhabi.ae/diwan/poem/18681","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109455","الرجز"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28065","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124770","الطويل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67260","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76005","المتقارب"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203551","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68113","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48289","المتقارب"],[3641,"","https://poetry.dctabudhabi.ae/diwan/poem/202263","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216528","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59476","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133236","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135765","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103569","الطويل"],[3997,"","https://poetry.dctabudhabi.ae/diwan/poem/132184","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119682","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123524","الطويل"],[4859,"ابتسامات الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=197027",""],[5126,"تحياتي إليك مع السماح","https://www.poetsgate.com/ViewPoem.aspx?id=206091",""],[5213,"بماضي رهيف العزم أقتحم الصعبا","https://www.poetsgate.com/ViewPoem.aspx?id=170408",""],[5277,"طفلةُ القلب","https://www.poetsgate.com/ViewPoem.aspx?id=190765",""],[5302,"كن لي رفيق الروح","https://www.poetsgate.com/ViewPoem.aspx?id=200552",""],[5324,"بعد الهجران.","https://www.poetsgate.com/ViewPoem.aspx?id=211573",""],[5490,"فديتك","https://www.poetsgate.com/ViewPoem.aspx?id=176406",""],[5582,"قِفا وَاَنْظِرانِي كَيْ نَزُورَ وَنَسْأَلا","https://www.poetsgate.com/ViewPoem.aspx?id=63603",""],[5809,"اجملهم","https://www.poetsgate.com/ViewPoem.aspx?id=205327",""],[6125,"جِرَاحِي لا تُضَمِّدها الأمَانِي","https://www.poetsgate.com/ViewPoem.aspx?id=207908",""],[5126,"تحياتي إليك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87788&r=&rc=3",""]],"verses":[["وَأَنّي حينَ تَزخَرُ لي رِبابي","عَماعِمَ أَمنَعُ الثَقلَينِ جارا",0,"ر",2,0],["وَأَنّي حينَ تَشتَجِرُ العَوالي","حَوالي اللُبَّ ذو رَأيٍ زَميتُ",1,"ت",1,0],["وإن يحمل إليك الإذن فاصعد","تجد دَرَجا يبلغك الرُّقيا",2,"ي",2,0],["وَإِنّي حينَ تُؤذِنُني بِصَرمِ","رَبيطُ الجَأشِ مُتَّسِعُ الخِناقِ",3,"ق",1,0],["وَإِنّي حافِظٌ فَاِحفَظ يَميني","بِمَكَّةَ حَيثُ أُلقِيَتِ الرِحالُ",4,"ل",1,0],["وَأَن يُحَثُّ إِلى مَغناكَ وُفدُ ثَناً","وَليسَ مِنكَ بِهِ عَينٌ وَلا أَثَرُ",5,"ر",1,0],["وَإِنّي حينَ يُفشى سِرُّ هاذٍ","لِسِرّي حافِظٌ أَبَداً كَتومُ",6,"م",1,0],["وَإِن يَحضُرِ الواشي تُطِعهُ وَإِن يَقُل","بِها كاشِحٌ عِندي يُجَب ثُمَّ يُعزَلِ",7,"ل",1,0],["وإن يَحْلل فتاهم قلب أنثى","يحلَّ هناك بالركن الخراب",8,"ب",1,0],["وإني حين تغشاني أذاةٌ","ليشفع للمسيء الود عندي",9,"د",2,0],["وأنَىَّ حَامٍ لِلدِّمَارِ ودَيدَنِي","وَيعلَمُهُ أني أذُبُّ عَنِ الحِمَى",10,"م",2,0],["وَإِنّي حاذِرٌ أَنمي سِلاحي","إِلى أَوصالِ ذَيّالٍ مَنيعِ",11,"ع",1,1],["وإن يحرك بعد همز قد جلا","سكونه فادغما كسأل",12,"ل",1,0],["وإن يحركا وواحد كسر","فالثاني اقلبنه يا كما أثر",12,"ر",1,0],["وأنِّي حَنِيفٌ بريءٌ إليك","من الشكّ والشرك والإعتداءِ",13,"ا",2,0],["واني حسين والأعادي أمية","ولا عجب من غدرها بحسينها",14,"ن",3,0],["وإنّ يَحْيى بنَ عبد الواحدِ بنِ أبي","حَفْصٍ لأَنوَرُ من شَمسِ الضُحى نَسبا",15,"ب",2,0],["وَإِنّي حاكِمٌ في الشِعرِ حُكماً","إِذا ذُكِرَ القَوافي وَالنَشيدُ",16,"د",1,0],["وإنْ يَحْكِ دَمْعي دَمعَها ببياضِه","ومن تحتهِ نارُ الجوانح تُوقَد",17,"د",1,0],["وَإِن يَحينوا أَقُل قَولاً لَهُ أَثَرٌ","باقٍ يُعَنّي قَراطيساً وَأَقلاما",18,"م",2,0],["وإن يُحِلْكَ ما استفدتَ بعدَنا","من ورَق الدنيا ومن أفنانِها",19,"ن",3,0],["وأنّي حفيدُ الجوعِ والصّبرُ لي أبٌ","وأمِّي الشّقاءُ والخليقُ كِساها",20,"ا",3,0],["وإنّي حَرونٌ عن ديارٍ مَرِيعةٍ","وكم ساق لِي عِزّاً طويلُ حِراني",21,"ن",2,0],["وإنْ يحولوا ويَضحَوا غيرَ مَن عهدوا","فإنّني لم يَزُلْ ودّي ولم يَحُلِ",22,"ل",1,0],["وأنْ يحجبَ الصُّفّاحُ بيني وبينه","ويودعه وسْطَ العَراءِ الشّقائقا",23,"ق",2,0],["وإنْ يَحْرَجْ مكانُك من تُرابٍ","فإنّك ذلك الرَّحْبُ الوسيعُ",24,"ع",1,0],["واني حين أَنسب من تميم","لَفي الشم الشماريخ الطوالِ",25,"ل",1,0],["وإِنِّي حظُ الحظِّ لو كَانَ عاقِلاً","لقد أَخطأَ الحظُّ الَّذي يَتَخَطَّاني",26,"ن",2,0],["وأنى حجبت العلم بل مطلع الذكا","وقد كان في الإشراق يسطع كالبدر",27,"ر",1,0],["وَأَنّي حَلَبتُ الدَهرَ أَشطُرُهُ وَقَد","مَضَت لي كَأَعوامِ الرِجالِ شُهورُها",28,"ر",3,0],["وَإِن يَحيى عَلى شَواطِئِهِ","بَينَ يَدَيهِ الأَنامِ تَطَهَّرُ",29,"ر",1,0],["وإنّي حين تختلف العوالي","إلى الأبطال أكيس قسوريُّ",30,"ر",2,0],["وإنّي حاجبٌ قدري بهجري","معززةً تذل لها الرقاب",31,"ب",1,0],["وإني حليف الأسى بعدكم","طريح الضَنا بالجفا مُثقَلُ",32,"ل",1,0],["وإنّي حلبتُ الدَّهرَ ضرباً فتارةً","أمرَّ وطوراً في مذاقتِهِ حلا",33,"ل",2,0],["وأن يحيا لغير الصد","ق والإيثار والحب",34,"ب",1,0],["وَإِنّي حَفِيٌّ عَنهُمُ وَمُسائِلٌ","بِهِم حيثُ يَثوي السَفرُ أَو ينزلُ الرَّكبُ",35,"ب",1,0],["وَإِنْ يُحَاكِ بَنُو نَصْرٍ فِعَالَهُمُ","فَالأُسْدُ أَشْبَالُهَا فِعْلاً تُحَاكِيهَا",36,"ي",3,0],["وَإِنّي حَنى ظَهري خُطوبٌ تَتابَعَت","فَمَشيِيَ ضَعيفٌ في الرِجالِ دَبيبُ",37,"ب",1,1],["وأن يحافظنَ على غض النظر","لأجنبيٍ خيفةً من الضرر",38,"ر",1,0],["وَإِنّيَ حَقا لم تُصِبني مُصيبَةٌ","مِنَ الدَهرِ إِلّا قَد أَصابَت فَتىً قَبلي",39,"ل",2,0],["وأن يحتوي لعب على عوض من ال","جوانب أو من بعضها احظره واصدد",40,"د",1,0],["وإني حرٌ في المواطنِ كُلّها","سوى إنني للضيف ما حلَّ كالعبد",41,"د",1,0],["وَإِن يَحتَمِل أَوجُهاً نَطَقُوا","بِقَولينِ مِن نظرٍ غَيرِ شاف",42,"ف",1,0],["وأن يحقق الذي قصدتُه","بذكرهم في نيل ما أملته",43,"ه",1,0],["وأن يُحدِثَ الشيبُ المُلِمُّ ليَ العقلا","وحَتَّى متى يَا قلب أصبو إِلَى الحِمَى",44,"ا",1,0],["وإنّي حُبيتُ بتشْريفِه","فللعَبْدِ كمْ نِعمةٍ قدْ أفادْ",45,"د",1,0],["وأن يحفظ الحلف الذي سن شيخه","ولا يلحدن فيه بظلم ولا غدر",46,"ر",1,0],["وأن يحمي ابن آدم من أخيه","سباعٌ جلَّ أن يدعى اخاها",47,"ا",3,0],["وإني حُسامٌ لم يُفَلَّ غِراره","وشهمُ جَنانٍ لم ترعه الرَّوائع",48,"ع",1,0],["وأن يحسن المولى ختامي بفضله","ويمحو ذنبي من سطور صحيفتي",49,"ي",1,0],["وأن يحول بيني والشيطانِ","وشرِّ كل الجنِّ والإنسانِ",50,"ن",1,0],["وأن يُحدِّثَ لأضيافٍ بما","نفوسهم له تميل مرسما",51,"م",2,0],["وإن يحمِني حامي المقادير متقدِماً","عليك فأنني بالفؤاد لقادمُ",52,"م",1,0],["وإني حليم دون ذي الجهل عالم","باني ان أغفر له الذنب أحمد",53,"د",1,0],["وإني حين أُصبح بل وأمسي","ذكرتُ أحبّتي وديار أُنسي",54,"ي",1,0],["وأن يحرم الراجى مواهبه التي","نفائس ما في الكون طلّ نداها",55,"ا",3,0],["وإنّي حين تُقبل يا أماني","\"سأسقيكَ المحبةَ من جَناني\"",56,"ن",2,1],["وأني حيثما وجهت طرفي","أراك وإن تعددت النواحي",57,"ح",2,0],["وانى حملت النفس في كل حالة","فأما بلوغ العز أو تسكن التربا",58,"ب",2,0],["وإنّي حين أنأى عنكِ أدري","بأنّي حاضرٌ سرّاً وجهرا",59,"ر",2,0],["وإني حفي بالذي كان مؤنسي","بكل الوفا في الليل ذي النسمات",60,"ت",1,0],["وإني حين اذكرها","بنار الشوق أشتعل",61,"ل",1,0],["وإني حين يظمأ فيك عرقٌ","أصُبّ الروح علك ترتويني",62,"ن",2,0],["وَإِنِّي حَلَبْتُ الدَّهْرَ ضَرْعاً فَتارَةً","أَمَرَّ وَطَوْراً فِي مَذاقَتِهِ حَلا",63,"ل",2,0],["وإنّي حينَ أكتبُ فيك شعراً","يضوعُ بيانُهُ من كلِّ طيبِ",64,"ب",1,1],["وإنِّي حِينَ خَاصَمَنِي الأَعَادِي","شَرِيفُ الأصلِ مَرمُوقٌ مَكانِي",65,"ن",2,0],["وأني حيثما وجهت طرفي","أراك وإن تعدت النواحي",66,"ح",2,0]]}