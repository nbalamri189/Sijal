","مخلع البسيط"],[464,"خير من أهمل مالا بالندى","https://www.aldiwan.net/poem15696.html","الرمل"],[464,"شكت صهوات الخيل والسمر والظبى","https://www.aldiwan.net/poem16167.html","الطويل"],[467,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[469,"أمسى الشباب مودعا محمودا","https://www.aldiwan.net/poem50445.html","الكامل"],[480,"با أدمعي في رسمها الجاري","https://www.aldiwan.net/poem15193.html","الرجز"],[480,"هل بعد بينك من جوى لمودع","https://www.aldiwan.net/poem15216.html","الكامل"],[496,"ورجاء سيف الدولة الشرف الذي","https://www.aldiwan.net/poem67287.html","عموديه"],[496,"ما المال إلا ما أفاد ثناء","https://www.aldiwan.net/poem67427.html","الكامل"],[503,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[517,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[518,"داويت ما نفع العليل دوائي","https://www.aldiwan.net/poem12002.html","الكامل"],[527,"الله أكبر كم وافت بشارات","https://www.aldiwan.net/poem13287.html","البسيط"],[532,"فكرت في عملي وفي أعمالي","https://www.aldiwan.net/poem37224.html","الكامل"],[532,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[541,"يا رعى الله إخوة كرموني","https://www.aldiwan.net/poem47601.html","عموديه"],[546,"عجلا اليوم صاحبي رواحا","https://www.aldiwan.net/poem1764.html","الخفيف"],[547,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[554,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[554,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[554,"ليت أنا لما فقدنا الهجوعا","https://www.aldiwan.net/poem47716.html","الخفيف"],[554,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[554,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[554,"ليس للقلب في السلو نصيب","https://www.aldiwan.net/poem48092.html","الخفيف"],[561,"صورة إن نظرتها كلفتني","https://www.aldiwan.net/poem33731.html","الخفيف"],[576,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"],[578,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"],[578,"امزج بريقك أو بمدح العادل","https://www.aldiwan.net/poem3022.html","الكامل"],[578,"هيهات ما حالي كحالك","https://www.aldiwan.net/poem3043.html","مجزوء الرمل"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/216887","الخفيف"],[709,"","https://poetry.dctabudhabi.ae/diwan/poem/1900","الكامل"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/10500","الوافر"],[966,"","https://poetry.dctabudhabi.ae/diwan/poem/46010","الطويل"],[1062,"","https://poetry.dctabudhabi.ae/diwan/poem/21423","الرجز"],[1083,"","https://poetry.dctabudhabi.ae/diwan/poem/97677","الكامل"],[1094,"","https://poetry.dctabudhabi.ae/diwan/poem/75829","الوافر"]],"verses":[["وَرِجالاً قَد أَعبَقوا","بِالبُرودِ المَخازِيا",0,"ي",2,0],["وَرِجالٌ إِذا دَعوا غُدوَةَ الرَو","عِ وَقَد خَفَّ جانِبُ الأَقرانِ",1,"ن",1,0],["وَرَجراجَةٍ تَلتَفُّ أَيدي جِيادِها","وَأَيُّ ضَجاجٍ مِن وَغىً وَصَهيلِ",2,"ل",1,0],["وَرِجالٍ تَحَكَّكوا فَأَفاقوا","بِجُذَيلٍ قَد عَوَّدوهُ الحِكاكا",3,"ك",2,0],["وَرِجالٌ مِثلُ الأُسودِ مَشوا في","كِ تَداعوا قَوائِماً وَشِفارا",4,"ر",2,0],["وَرِجالٌ شُدِخَت أَوضاحُهُم","غَلَبوا الأَعناقَ مِنّاً وَإِسارا",5,"ر",2,0],["وَرَجَّبَها مِن بَعدِ ما مالَ فَرعُها","وَحينَ أَبَت إِلّا اِعوِجاجاً قَناتُها",6,"ت",3,0],["ورَجَعْتُ طَلْقَ البُرْدِ أسْحَبُ ذَيْلَهُ","ويَعَضُّ جِلْدَةَ كفِّهِ الغَيْرانُ",7,"ن",1,0],["وَرَجَعتُ عَنهُم لَم يَكُن قَصدي سِوى","ذِكرٍ يَدومُ إِلى أَوانِ المَحشَرِ",8,"ر",1,0],["وَرَجَعْتَ وَالنَّصْرُ الْعَزِيزُ مُصَاحِبٌ","لَكَ وَالْمَلاَئِكَةُ الْكِرَامُ قَبِيلُ",9,"ل",1,0],["وَرَجَاجَةٌ لَوْ كَانَ بَعْضُ وَقَارِهَا","بِالرِّيحِ كَانَتْ لاَ تُحِيرُ حَرَاكَا",10,"ك",2,0],["وَرَجَعتَ بَعدَ الشَيبِ تَب","غي وُدُّها بِطِلابِها",11,"ب",3,0],["وَرَجراجَةٌ تُعشي النَواظِرَ فَخمَةٌ","وَجُردٌ عَلى أَكنافِهِنَّ الرَواحِلُ",12,"ل",1,0],["وَرَجَونا فيكَ ما لَم يَرجُهُ","مُنجِبُ الأَشبالِ في الشِبلِ النَجيبِ",13,"ب",1,0],["وَرِجالي لَو أَنصَفوهُم لَسادوا","مِن كُهولٍ مِلءِ العُيونِ وَمُردِ",14,"د",1,0],["وَرِجالُ الشَآمِ في كُرَةِ الأَر","ضِ يُبارونَ في المَسيرِ الغَماما",15,"م",2,0],["وَرِجالٌ تَتَبارى لِلرَدى","لا تُبالي غابَ عَنها أَم حَضَر",16,"ر",1,0],["وَرَجراجَةٍ فَوقَها بيضُها","عَلَيها المُضاعَفُ أَمثالَها",17,"ل",3,0],["ورجال في كل علمٍ وفن","وابتداعٍ هم صفوة في الرجال",18,"ل",1,0],["وَُرَجِّي أنْ يُعِيدَ لَهَا","شَأْنَهَا فِي دَوْلَةِ العُرْبِ",19,"ب",1,0],["وَرَجْعِ صَوْتٍ رَقِيقٍ","حُرِمْتُهُ فِي المَغِيبِ",20,"ب",1,0],["وَرَجَعْتُ مِنْ سُوقٍ عرَضْ","تُ بِضَاعَتِي فِيهَا بِغَبْنِ",21,"ن",1,0],["وَرِجلٌ كَظِلِّ الذِئبِ أَلحَقَ سَدوَها","وَظِيفٌ أُمَرَّتهُ عَصا السَاق أَروَحُ",22,"ح",1,0],["وَرَجا العَواذِلُ أَن يُطِعنَ وَلَم أَزَل","مِن حُبِّكُم كَلِفَ الفُؤادِ عَميدا",23,"د",2,0],["وَرَجا الأُخَيطِلُ أَن يُكَدِّرَ بَحرَنا","فَأَصابَ حَومَةَ ذي لَجاجٍ غامِرِ",24,"ر",1,0],["وَرَجا الأُخَيطِلُ مِن سَفاهَةِ رَأيِهِ","ما لَم يَكُن وَأَبٌ لَهُ لِيَنالا",25,"ل",2,0],["ورَجِّ تغافلي لك وانخداعي","ولا ترجُ اختداعي واغتفالي",26,"ل",2,0],["ورجاؤنا فيك اليقينُ بعينه","ورجاؤنا في غيرك الترجيمُ",27,"م",1,0],["ورجاءُ السماح في الناس ظنٌّ","ورجاءُ السماح فيك يقين",28,"ن",1,0],["وَرِجالُ عَبدِ القَيسِ تَحتَ نُحورِها","كانوا لَها جَزَراً مِنَ الأَجزارِ",29,"ر",1,0],["وَرَجَعتُ عَنها واثِقاً مِن أَنَّ ما","قَد كانَ مِن حُبّي لَها لا يَرجَعُ",30,"ع",1,0],["وَرَجَوتَ ما يَرجوهُ كُلُّ أَبٍ لَدى","أَبنائِهِ إِنَّ العَقوقَ مُذَمَّمُ",31,"م",1,0],["وَرَجَّمَ قَومٌ أَنَّما تِلكَ خِدعَةٌ","فَعُذنا بِرَبِّ الناسِ مِن كُلِّ راجِمِ",32,"م",1,0],["وَرَجَعنا مِن قَريبٍ","نُكثِرُ اللَعنَ عَلَيكُم",33,"م",1,0],["وَرَجَوتُ حُسنَ العَفوِ مِن","هُ فَهُوَ لِلعَبدِ المُنيبِ",34,"ب",1,0],["وَرِجلٌ كَرِجلِ الأَخدَرِيِّ يَشُلُّها","وَظيفٌ عَلى خُفِّ النَعامَةِ أَروَحُ",35,"ح",1,0],["وَرَجّافاً تَحِنُّ المُزنُ فيهِ","تَرَجَّزَ مِن تِهامَةَ فَاِستَطارا",36,"ر",2,0],["وَرَجِّ بِجَبرِهِ عُقبى نَداهُ","فَكَم جَبَرَت يَداهُ مِن كَسيرِ",37,"ر",1,0],["ورجال كلهم لي كالأب","صادق في حبه واف أمين",38,"ن",1,0],["ورجال إذا سعوا للمعالي","ركبوا في سبيلها الأخطارا",39,"ر",2,0],["ورجعتُ أَدراجَ الشباب ووِرْدَه","أَمشي مكانَهما على الأَشواكِ",40,"ك",1,0],["ورجالُ هذي النّائباتِ وإِنْ رَأَوْا","شَظَفاً مِنَ الأَيّامِ فهيَ رِجَالُ",41,"ل",1,0],["وَرَجَت راحَةً بِنا لا تَراها","وَبِلادٌ تَسيرُ فيها بِلادُه",42,"د",2,0],["وَرِجالُ طَيِّءِ مُصلِتونَ أَمامَهُ","وَرَقاً هُناكَ مِنَ الحَديدِ رَقيقا",43,"ق",2,0],["وَرَجَوتُ أَن يُعطى بِقِسطِ فُتوحِهِ","فَيُخَوِّلَ الشاماتِ فيما خُوِّلا",44,"ل",2,0],["وَرِجالٍ جاروا خَلائِقِكَ الغُر","رُ وَلَيسَت يَلامِقٌ مِن دُروعِ",45,"ع",1,0],["ورِجلاك تَصعَدُ إحداهما","فَواقاً وإحداهما تَنزِلُ",46,"ل",1,0],["ورجَوْتُ أن أَحيا بِرَدِّ تَحيَّةٍ","فحَييتُ من أجفانِها بحُتوفِ",47,"ف",1,0],["وَرَجَعنا إِلى الصِناعَةِ لَمّا","كانَ سُخطَ الإِمامِ تَركُ الصِناعَه",48,"ه",1,0],["وَرِجلايَ في أَفناءِ دِجلَةَ قَد سَعَت","وَطَرفِيَ في أَفناءِ حَرزَمَ يَسرَحُ",49,"ح",1,0],["وَرَجا أُناسٌ أَن يَرِقَّ عَليهِمُ","فَأَبى وَقالَ كَذا يُجازى المُجرِمُ",50,"م",1,0],["ورجعة القلب إلى صدره","بالعطف في أحنائه يرتمي",51,"م",2,0],["وَرَجَعنا نَجتَنِئُ القَنا في ضُمَّرٍ","مِثلَ الذِئابِ سَريقَةِ الإِقدامِ",52,"م",1,0],["ورِجالُ دَولَتِكَ الَّذينَ لِقَدرِهِم","بكَ في الورى الإجلالُ والإكبارُ",53,"ر",1,0],["وَرَجَوتُ نائِلَكُم رَجاءَكُمُ العُلا","بِتَذَكُّرِ العِلجانِ وَاليَعضيدِ",54,"د",1,0],["وَرَجا بِلادَ الرومِ فَاِستَعصى بِهِ","أَجَلٌ أَصَمُّ عَنِ النَجاءِ حَرونُ",55,"ن",1,0],["ورجعنا منكمُ خِلواً ولو","أكلت منهن آمال هزال",56,"ل",1,0],["وَرَجا مُصالَحَةً فَكانَ لَكُم","سِلماً وَكُنتِ تَرَينَهُ حَربا",57,"ب",2,0],["وَرِجالٌ قادَةٌ نُجُبٌ","نَزَلوا عَن رُتبَةِ البُهُمِ",58,"م",1,0],["وَرُجومٌ تَفري الغُيوم وَتَهوي","كُلَ رَجمٍ مِن الجَحيم شَظيَّه",59,"ه",1,0],["وَرَجَّع الطَير أَغاريده","شَجواً فَأَبكاني وَأَبكاها",60,"ا",3,0],["وَرَجا مُوادَعَتي وَأَيقَنَ أَنَّني","صِنعُ اليَدَينِ بِحَيثُ يُكوى الأَصيَدُ",61,"د",1,0],["وَرَجَعتَ مُنتَحِلَ الكِتابَةِ لا تُرى","في اللَيلِ إِلّا ماضِياً مُتَعَبِّثا",62,"ث",2,0],["وَرَجَعْنا وَللقلُوبِ التفاتا","تٌ إليه وللجُسوم انْثِناءُ",63,"ا",2,0],["وَ