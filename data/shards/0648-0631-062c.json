{"poems":[[53,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[53,"ما أقل اعتبارنا بالزمان","https://www.aldiwan.net/poem29740.html","الخفيف"],[53,"ردي يا جيادي وأذني برحيل","https://www.aldiwan.net/poem29903.html","الطويل"],[53,"يا أراك الحمى تراني أراكا","https://www.aldiwan.net/poem29922.html","الخفيف"],[53,"أين بانوك أيها الحيرة البيضاء","https://www.aldiwan.net/poem30439.html","الخفيف"],[53,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[53,"أبينتها أم ناكرتك شياتها","https://www.aldiwan.net/poem30677.html","الطويل"],[63,"وله تشف وراءه الأشجان","https://www.aldiwan.net/poem46179.html","الكامل"],[3,"أرض الشربة تربها كالعنبر","https://www.aldiwan.net/poem163.html",""],[77,"السعد جندك والقضاء دليل","https://www.aldiwan.net/poem36373.html","الكامل"],[77,"باتت نجوم الأفق دون علاكا","https://www.aldiwan.net/poem36385.html","الكامل"],[9,"أوصلت صرم الحبل من","https://www.aldiwan.net/poem21910.html","مجزوء الكامل"],[9,"أقيس بن مسعود بن قيس بن خالد","https://www.aldiwan.net/poem21964.html","الطويل"],[86,"ولدي قد طال سهدي ونحيبي","https://www.aldiwan.net/poem10476.html","الرمل"],[86,"وقف الخلق ينظرون جميعاً","https://www.aldiwan.net/poem10675.html","الخفيف"],[86,"أيها المصلحون ضاق بنا العيش","https://www.aldiwan.net/poem10703.html","الخفيف"],[86,"أيها الوسمي زر نبت الربا","https://www.aldiwan.net/poem10855.html","الرمل"],[10,"ألا ما لعينك أم ما لها","https://www.aldiwan.net/poem21129.html","المتقارب"],[93,"يا لعهد الصبا تقضي وشيكا","https://www.aldiwan.net/poem9159.html","الخفيف"],[93,"في رضى المربوب والرب","https://www.aldiwan.net/poem9791.html","عموديه"],[93,"وافى الكتاب فأحيا","https://www.aldiwan.net/poem9828.html","عموديه"],[93,"ماذا يريد الشعر مني","https://www.aldiwan.net/poem11203.html","مجزوء الكامل"],[30,"أمنزلتي مي سلام عليكما علي","https://www.aldiwan.net/poem29608.html","الطويل"],[27,"أهوى أراك برامتين وقودا","https://www.aldiwan.net/poem5732.html","الكامل"],[27,"طرب الحمام بذي الأراك فهاجني","https://www.aldiwan.net/poem5781.html","الكامل"],[27,"حي الغداة برامة الأطلالا","https://www.aldiwan.net/poem5968.html","الكامل"],[51,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[51,"لأمورك التكميل والتتميم","https://www.aldiwan.net/poem66061.html","الكامل"],[51,"لم يزل للسكنجبين قرين","https://www.aldiwan.net/poem66466.html","الخفيف"],[29,"صدع الخليط فشاقني أجواري","https://www.aldiwan.net/poem6065.html","الكامل"],[91,"عاطيتها في الكأس مثل رضابها","https://www.aldiwan.net/poem8976.html","عموديه"],[91,"يا أيها الشرق التعيس انظر إلى","https://www.aldiwan.net/poem62698.html","عموديه"],[91,"إلى حيث ألقت يا زمان المظالم","https://www.aldiwan.net/poem62715.html","عموديه"],[70,"ردنا الدهر إليكم","https://www.aldiwan.net/poem42692.html","مجزوء الرمل"],[70,"رحل الشباب ولم أنل","https://www.aldiwan.net/poem43017.html","مجزوء الكامل"],[38,"أفي أثر الأظعان عينك تلمح","https://www.aldiwan.net/poem7695.html","الطويل"],[38,"ألم تسأل بعارمة الديارا","https://www.aldiwan.net/poem7721.html","الوافر"],[78,"إليك النزر من كف الأسير","https://www.aldiwan.net/poem14216.html","الوافر"],[85,"أنا بنت البر أم الفقرا","https://www.aldiwan.net/poem7749.html","الرمل"],[85,"بدأ الطيف بالجميل وزارا","https://www.aldiwan.net/poem7774.html","الخفيف"],[85,"شيعت احلامي بقلب باك","https://www.aldiwan.net/poem24531.html","الكامل"],[56,"قالوا السلام عليك يا أطلال","https://www.aldiwan.net/poem58537.html","الكامل"],[43,"جاء نيروزنا وأنت مراده","https://www.aldiwan.net/poem9556.html","الخفيف"],[45,"أأفاق صب من هوى فأفيقا","https://www.aldiwan.net/poem65176.html","الطويل"],[45,"إن الأمير أبا علي أصبحت","https://www.aldiwan.net/poem65628.html","الكامل"],[45,"أنزاعا في الحب بعد نزوع","https://www.aldiwan.net/poem64684.html","الخفيف"],[61,"خطوب تجور ولا تعدل","https://www.aldiwan.net/poem51473.html","المتقارب"],[61,"أمعنفي إن زدت في التعنيف","https://www.aldiwan.net/poem51547.html","الكامل"],[49,"يا ابن عم النبي سمعا وطاعه","https://www.aldiwan.net/poem64240.html","الخفيف"],[66,"صفاح عيون لحظها ليس يصفح","https://www.aldiwan.net/poem40986.html","الطويل"],[66,"خطب لسان الحال فيه أبكم","https://www.aldiwan.net/poem41549.html","الكامل"],[97,"لا تجزعوا للشاعر الملهم","https://www.aldiwan.net/poem24985.html","السريع"],[80,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[44,"عياش يا ذا البخل والتصريد","https://www.aldiwan.net/poem30051.html","الكامل"],[44,"بذ الجلاد فهو دفين","https://www.aldiwan.net/poem30335.html","الرجز"],[90,"‏كل ما في الكون حب وجمال","https://www.aldiwan.net/poem26553.html","الرمل"],[31,"هلا ارعويت فترحمي صبا","https://www.aldiwan.net/poem42612.html","الكامل"],[74,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[102,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[102,"رسالة واها لها واها","https://www.aldiwan.net/poem33108.html","السريع"],[39,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[52,"سار الرفيق لقصده وتلبثا","https://www.aldiwan.net/poem27183.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[75,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[75,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[46,"تيمم فجا واحدا كل راكب","https://www.aldiwan.net/poem22248.html","الطويل"],[46,"ذكرتني عقوبة من إلهي","https://www.aldiwan.net/poem22732.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85568","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39666","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20251","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54560","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[95,"سر السراب","https://www.poetsgate.com/ViewPoem.aspx?id=12258",""],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[106,"بطل الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179606",""],[77,"باتت نجوم الأفق دون علاكا","https://www.poetsgate.com/ViewPoem.aspx?id=34151",""],[18,"أثبت مرة والسيوف شواهر","https://www.poetsgate.com/ViewPoem.aspx?id=27779",""],[96,"ردّوا على الوادي ربيه نهاره","https://www.poetsgate.com/ViewPoem.aspx?id=13208",""],[43,"جاء نيروزنا وأنت مراده","https://www.poetsgate.com/ViewPoem.aspx?id=246",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[45,"أأفاق صَبٌّ مِنْ هَوىً، فأُفِيقَا","https://www.poetsgate.com/ViewPoem.aspx?id=32851",""],[45,"أنزاعا في الحب بعد نزوع","https://www.poetsgate.com/ViewPoem.aspx?id=2812",""],[91,"ذكرى وعبرة","https://www.poetsgate.com/ViewPoem.aspx?id=53125",""],[46,"تيمّمَ، فجّاً واحداً، كلُّ راكبٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=18240",""],[39,"أَسَاءَكَ تَقْوِيضُ الخَلِيطِ المُبَايِنِ","https://www.poetsgate.com/ViewPoem.aspx?id=4309",""],[91,"تحيّة الدستور العثماني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67927&r=&rc=206",""],[18,"أثبتُّ مرة َ وَ السيوفُ شواهرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26464&r=&rc=30",""]],"verses":[["وَرِجالاً قَد أَعبَقوا","بِالبُرودِ المَخازِيا",0,"ي",2,0],["وَرِجالٌ إِذا دَعوا غُدوَةَ الرَو","عِ وَقَد خَفَّ جانِبُ الأَقرانِ",1,"ن",1,0],["وَرَجراجَةٍ تَلتَفُّ أَيدي جِيادِها","وَأَيُّ ضَجاجٍ مِن وَغىً وَصَهيلِ",2,"ل",1,0],["وَرِجالٍ تَحَكَّكوا فَأَفاقوا","بِجُذَيلٍ قَد عَوَّدوهُ الحِكاكا",3,"ك",2,0],["وَرِجالٌ مِثلُ الأُسودِ مَشوا في","كِ تَداعوا قَوائِماً وَشِفارا",4,"ر",2,0],["وَرِجالٌ شُدِخَت أَوضاحُهُم","غَلَبوا الأَعناقَ مِنّاً وَإِسارا",5,"ر",2,0],["وَرَجَّبَها مِن بَعدِ ما مالَ فَرعُها","وَحينَ أَبَت إِلّا اِعوِجاجاً قَناتُها",6,"ت",3,0],["ورَجَعْتُ طَلْقَ البُرْدِ أسْحَبُ ذَيْلَهُ","ويَعَضُّ جِلْدَةَ كفِّهِ الغَيْرانُ",7,"ن",1,0],["وَرَجَعتُ عَنهُم لَم يَكُن قَصدي سِوى","ذِكرٍ يَدومُ إِلى أَوانِ المَحشَرِ",8,"ر",1,0],["وَرَجَعْتَ وَالنَّصْرُ الْعَزِيزُ مُصَاحِبٌ","لَكَ وَالْمَلاَئِكَةُ الْكِرَامُ قَبِيلُ",9,"ل",1,0],["وَرَجَاجَةٌ لَوْ كَانَ بَعْضُ وَقَارِهَا","بِالرِّيحِ كَانَتْ لاَ تُحِيرُ حَرَاكَا",10,"ك",2,0],["وَرَجَعتَ بَعدَ الشَيبِ تَب","غي وُدُّها بِطِلابِها",11,"ب",3,0],["وَرَجراجَةٌ تُعشي النَواظِرَ فَخمَةٌ","وَجُردٌ عَلى أَكنافِهِنَّ الرَواحِلُ",12,"ل",1,0],["وَرَجَونا فيكَ ما لَم يَرجُهُ","مُنجِبُ الأَشبالِ في الشِبلِ النَجيبِ",13,"ب",1,0],["وَرِجالي لَو أَنصَفوهُم لَسادوا","مِن كُهولٍ مِلءِ العُيونِ وَمُردِ",14,"د",1,0],["وَرِجالُ الشَآمِ في كُرَةِ الأَر","ضِ يُبارونَ في المَسيرِ الغَماما",15,"م",2,0],["وَرِجالٌ تَتَبارى لِلرَدى","لا تُبالي غابَ عَنها أَم حَضَر",16,"ر",1,0],["وَرَجراجَةٍ فَوقَها بيضُها","عَلَيها المُضاعَفُ أَمثالَها",17,"ل",3,0],["ورجال في كل علمٍ وفن","وابتداعٍ هم صفوة في الرجال",18,"ل",1,0],["وَُرَجِّي أنْ يُعِيدَ لَهَا","شَأْنَهَا فِي دَوْلَةِ العُرْبِ",19,"ب",1,0],["وَرَجْعِ صَوْتٍ رَقِيقٍ","حُرِمْتُهُ فِي المَغِيبِ",20,"ب",1,0],["وَرَجَعْتُ مِنْ سُوقٍ عرَضْ","تُ بِضَاعَتِي فِيهَا بِغَبْنِ",21,"ن",1,0],["وَرِجلٌ كَظِلِّ الذِئبِ أَلحَقَ سَدوَها","وَظِيفٌ أُمَرَّتهُ عَصا السَاق أَروَحُ",22,"ح",1,0],["وَرَجا العَواذِلُ أَن يُطِعنَ وَلَم أَزَل","مِن حُبِّكُم كَلِفَ الفُؤادِ عَميدا",23,"د",2,0],["وَرَجا الأُخَيطِلُ أَن يُكَدِّرَ بَحرَنا","فَأَصابَ حَومَةَ ذي لَجاجٍ غامِرِ",24,"ر",1,0],["وَرَجا الأُخَيطِلُ مِن سَفاهَةِ رَأيِهِ","ما لَم يَكُن وَأَبٌ لَهُ لِيَنالا",25,"ل",2,0],["ورَجِّ تغافلي لك وانخداعي","ولا ترجُ اختداعي واغتفالي",26,"ي",1,0],["ورجاؤنا فيك اليقينُ بعينه","ورجاؤنا في غيرك الترجيمُ",27,"م",1,0],["ورجاءُ السماح في الناس ظنٌّ","ورجاءُ السماح فيك يقين",28,"ن",1,0],["وَرِجالُ عَبدِ القَيسِ تَحتَ نُحورِها","كانوا لَها جَزَراً مِنَ الأَجزارِ",29,"ر",1,0],["وَرَجَعتُ عَنها واثِقاً مِن أَنَّ ما","قَد كانَ مِن حُبّي لَها لا يَرجَعُ",30,"ع",1,0],["وَرَجَوتَ ما يَرجوهُ كُلُّ أَبٍ لَدى","أَبنائِهِ إِنَّ العَقوقَ مُذَمَّمُ",31,"م",1,0],["وَرَجَّمَ قَومٌ أَنَّما تِلكَ خِدعَةٌ","فَعُذنا بِرَبِّ الناسِ مِن كُلِّ راجِمِ",32,"م",1,0],["وَرَجَعنا مِن قَريبٍ","نُكثِرُ اللَعنَ عَلَيكُم",33,"م",1,0],["وَرَجَوتُ حُسنَ العَفوِ مِن","هُ فَهُوَ لِلعَبدِ المُنيبِ",34,"ب",1,0],["وَرِجلٌ كَرِجلِ الأَخدَرِيِّ يَشُلُّها","وَظيفٌ عَلى خُفِّ النَعامَةِ أَروَحُ",35,"ح",1,0],["وَرَجّافاً تَحِنُّ المُزنُ فيهِ","تَرَجَّزَ مِن تِهامَةَ فَاِستَطارا",36,"ر",2,0],["وَرَجِّ بِجَبرِهِ عُقبى نَداهُ","فَكَم جَبَرَت يَداهُ مِن كَسيرِ",37,"ر",1,0],["ورجال كلهم لي كالأب","صادق في حبه واف أمين",38,"ن",1,0],["ورجال إذا سعوا للمعالي","ركبوا في سبيلها الأخطارا",39,"ر",2,0],["ورجعتُ أَدراجَ الشباب ووِرْدَه","أَمشي مكانَهما على الأَشواكِ",40,"ك",1,0],["ورجالُ هذي النّائباتِ وإِنْ رَأَوْا","شَظَفاً مِنَ الأَيّامِ فهيَ رِجَالُ",41,"ل",1,0],["وَرَجَت راحَةً بِنا لا تَراها","وَبِلادٌ تَسيرُ فيها بِلادُه",42,"د",2,0],["وَرِجالُ طَيِّءِ مُصلِتونَ أَمامَهُ","وَرَقاً هُناكَ مِنَ الحَديدِ رَقيقا",43,"ق",2,0],["وَرَجَوتُ أَن يُعطى بِقِسطِ فُتوحِهِ","فَيُخَوِّلَ الشاماتِ فيما خُوِّلا",44,"ل",2,0],["وَرِجالٍ جاروا خَلائِقِكَ الغُر","رُ وَلَيسَت يَلامِقٌ مِن دُروعِ",45,"ع",1,0],["ورِجلاك تَصعَدُ إحداهما","فَواقاً وإحداهما تَنزِلُ",46,"ل",1,0],["ورجَوْتُ أن أَحيا بِرَدِّ تَحيَّةٍ","فحَييتُ من أجفانِها بحُتوفِ",47,"ف",1,0],["وَرَجَعنا إِلى الصِناعَةِ لَمّا","كانَ سُخطَ الإِمامِ تَركُ الصِناعَه",48,"ه",1,0],["وَرِجلايَ في أَفناءِ دِجلَةَ قَد سَعَت","وَطَرفِيَ في أَفناءِ حَرزَمَ يَسرَحُ",49,"ح",1,0],["وَرَجا أُناسٌ أَن يَرِقَّ عَليهِمُ","فَأَبى وَقالَ كَذا يُجازى المُجرِمُ",50,"م",1,0],["ورجعة القلب إلى صدره","بالعطف في أحنائه يرتمي",51,"ي",1,0],["ورِجالُ دَولَتِكَ الَّذينَ لِقَدرِهِم","بكَ في الورى الإجلالُ والإكبارُ",52,"ر",1,0],["وَرَجَوتُ نائِلَكُم رَجاءَكُمُ العُلا","بِتَذَكُّرِ العِلجانِ وَاليَعضيدِ",53,"د",1,0],["وَرَجا بِلادَ الرومِ فَاِستَعصى بِهِ","أَجَلٌ أَصَمُّ عَنِ النَجاءِ حَرونُ",54,"ن",1,0],["ورجعنا منكمُ خِلواً ولو","أكلت منهن آمال هزال",55,"ل",1,0],["وَرَجا مُصالَحَةً فَكانَ لَكُم","سِلماً وَكُنتِ تَرَينَهُ حَربا",56,"ب",2,0],["وَرِجالٌ قادَةٌ نُجُبٌ","نَزَلوا عَن رُتبَةِ البُهُمِ",57,"م",1,0],["وَرُجومٌ تَفري الغُيوم وَتَهوي","كُلَ رَجمٍ مِن الجَحيم شَظيَّه",58,"ه",1,0],["وَرَجَّع الطَير أَغاريده","شَجواً فَأَبكاني وَأَبكاها",59,"ا",3,0],["وَرَجا مُوادَعَتي وَأَيقَنَ أَنَّني","صِنعُ اليَدَينِ بِحَيثُ يُكوى الأَصيَدُ",60,"د",1,0],["وَرَجَعتَ مُنتَحِلَ الكِتابَةِ لا تُرى","في اللَيلِ إِلّا ماضِياً مُتَعَبِّثا",61,"ث",2,0],["وَرَجَعْنا وَللقلُوبِ التفاتا","تٌ إليه وللجُسوم انْثِناءُ",62,"ا",2,0],["وَرَجَعتُ عنها آيساً فكأنما","رَجَعَ الرَّضِيعُ مُرَوَّعاً بِفِطامِ",63,"م",1,0],["وَرَجا البطارقُ أن تكونَ لثَغرِهم","باباً فغُودِرَ وهو عنهم مُقْفَل",64,"ل",1,0],["ورَجَوْناهُ مَلاذاً للوَرَى","وَدَعَوْنَاهُ عَتاداً للأبَد",65,"د",1,0],["وَرَجّى أُموراً لَم تَكُن بِقَريبَةٍ","إِلَيهِ فَخَطَّتهُ الحَوادِثُ ما رَجّى",66,"ج",2,0],["وَرِجالُ الأَنامِ مِثلُ الغَواني","غَيرَ فَرقِ التَأنيثِ وَالتَذكيرِ",67,"ر",1,0],["وَرجاؤُها أن الحقو","ق تصان من كل اهتضام",68,"م",1,0],["ورجالُهُ الأبطالُ ويحَ رجاله","لم يهدأوا والظلمُ في تهدارِهِ",69,"ر",2,0],["وَرِجالُ الإِسعافِ أَنبَلُ لَولا","شَهوَةُ الحَربِ مِن رِجالِ القِتالِ",70,"ل",1,0],["وَرَجَعْت تَرْقُبُ نَهْزَةً لَمْ تَتَّسِقْ","قَبْلاً وَلَمْ تَحْفِلْ بِقَوْلِ الزَّارِي",71,"ر",2,0],["وَرِجَالٍ إِذَا هُمُ","سَابَقُوا َأحْرَزُوا الْقَصَبْ",72,"ب",1,0],["وَرِجَالٍ دُكُّوا لِفَرْطِ هُزَالٍ","وَهُمُ قَبْلَ ذَاكَ كالأَطْوَادِ",73,"د",1,0],["ورجوعي للخمول الأول","فانبرى البارود في حدته",74,"ه",1,0],["ورَجاءٍ برجاءٍ يلْتقي","وكِفاحٍ للقاءِ النُّوَب",75,"ب",1,0],["ورجعتُ أدراجي أصيدُ من المنى","حلماً ، أنام بأفقه متوهما",76,"م",2,0],["ورجَعْت رجعةَ ظافر","تختال في وشى البرود",77,"د",1,0],["ورجالها الأحرارُ نع","مَ الجارُ للحر المَضيم",78,"م",1,0],["ورجاحة لو كان بعض وقارها","بالريح كانت لا تحير حراكا",79,"ك",2,0],["ورجعنا نجتنئ القنا في ضمر","مثل الذئاب سريقة الإقدام",80,"م",1,0],["ورجاله الأبطال ، ويح رجاله","لم يهدؤا والظّلم في تهداره",81,"ر",2,0],["وَرَجَت راحَةً بِنا لا نراها","وَبِلادٌ تَسيرُ فيها بِلادُه",82,"د",2,0],["ورَجَعْتُ أدراجي أجرُّ غنيمةً","من \" بنتِ بيروتٍ \" جوىً وغليلا",83,"ل",2,0],["وَرِجالُ طَيٍّ مُصْلِتونَ أمامَهُ","وَرَقاً هُناكَ، منَ الحديدِ، رَقِيقَا",84,"ق",2,0],["وَرِجالٍ جارَوْا خَلائِقَكَ الغُرّ","وَلَيْسَتْ يَلامِقٌ مِنْ دُرُوعِ",85,"ع",1,0],["ورجعت عنها واثقا من أنّ ما","قد كان حبّي لها لا يرجع",86,"ع",1,0],["ورَجّى أموراً، لم تكن بقريبة","إليه، فخطّته الحوادثُ ما رجّا",87,"ج",2,0],["ورِجْلَيْهِ سَلْمٌ بَيْنَ حَبْلَيْ مُشِاطِنِ","يُوَزِّعُ بِالأمْرَاسِ كُلَّ عَمَلَّسٍ",88,"س",1,0],["ورجّم قوم أنّما تلك خدعة","فعدنا بربّ الناس من كلّ راجم",89,"م",1,0],["وَرَجَعْنَا نجتنئ الْقَنَا فِي ضُمَّرٍ","مثلِ الذئابِ سريعة ِ الإقدامِ",90,"م",1,0]]}