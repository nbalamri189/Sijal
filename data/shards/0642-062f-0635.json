l","عموديه"],[491,"ما ضر من بعد السرور ببعده","https://www.aldiwan.net/poem67379.html","الكامل"],[498,"هل بان نعمان وهذا الأجرع","https://www.aldiwan.net/poem37974.html","الرجز"],[498,"رقرق الكأس حبيبي","https://www.aldiwan.net/poem37975.html","مجزوء الرمل"],[498,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[512,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[512,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[527,"قد صح إجماع جميع الورى","https://www.aldiwan.net/poem37258.html","السريع"],[527,"يا حبذا كلام","https://www.aldiwan.net/poem37445.html","مجزوء الرجز"],[527,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[536,"فقد الأحبة موقف كالموقف","https://www.aldiwan.net/poem47555.html","عموديه"],[536,"أمري إلى المولى العلي الشان","https://www.aldiwan.net/poem47924.html","عموديه"],[556,"سنة نبي مختار","https://www.aldiwan.net/poem34235.html","منهوك المنسرح"],[556,"كل من بالناس يختلط","https://www.aldiwan.net/poem34409.html","المديد"],[556,"قد صرت كلي قلوبا فيه تحتار","https://www.aldiwan.net/poem34523.html","البسيط"],[560,"أبكى عيون بني عطاء راحل","https://www.aldiwan.net/poem52602.html","الكامل"],[560,"للموت يولد منا كل مولود","https://www.aldiwan.net/poem52755.html","البسيط"],[560,"وردا على الخد لا وردا ببستان","https://www.aldiwan.net/poem52759.html","البسيط"],[560,"يا أيها الناس هذا مولد القمر","https://www.aldiwan.net/poem52829.html","البسيط"],[560,"قف فوق رابية تجاه المسجد","https://www.aldiwan.net/poem52889.html","الكامل"],[560,"ما بين أعطاف القدود الهيف","https://www.aldiwan.net/poem52947.html","الكامل"],[560,"لا تبك ميتا ولا تفرح بمولود","https://www.aldiwan.net/poem52979.html","البسيط"],[560,"طال النوى حتى تقطعت المنى","https://www.aldiwan.net/poem52987.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"أعدت جفونك منك الجسم بالسقم","https://www.aldiwan.net/poem2867.html","البسيط"],[573,"إن الذي يضحك من أدمعي","https://www.aldiwan.net/poem2899.html","السريع"],[573,"قد صح أنك عندي روضة أنف","https://www.aldiwan.net/poem2900.html","البسيط"],[573,"راحت وحق الله روحي","https://www.aldiwan.net/poem3090.html","مجزوء الكامل"],[584,"يا رب نحوي له مبسم","https://www.aldiwan.net/poem17446.html","السريع"]],"verses":[["قَدْ صِيغَ مِنْ حَبِّ القلوبِ كَما","نَفَضَتْ عَلَيْهِ سَوادَها المُقَلُ",0,"ل",1,0],["قَد صِرتُ في الأَرضِ كَما","في الأُفُقِ نَجمُ الذَنَبِ",1,"ب",1,0],["قَد صارَ مِثلَ الخَيطِ مِن ذِكراكُمُ","وَالسَمعُ مِنهُ لَيسَ يَسمَعُ مَن دَعا",2,"ا",1,0],["قَدْ صَارَ دَمْعِيَ بَحْراً فِي مَحَاجِرِهِ","وَأَصْبَحَتْ وَسْطَهُ الأجفان أَجْفَانَا",3,"ن",2,0],["قدْ صحّ في سُنَنِ النّبي محمّدٍ","فَضْلي على المَوْشِيِّ والدِّيباجِ",4,"ج",1,1],["قَد صادَفوا عُصبَةً مِنّا وَسَيِّدَنا","كُلٌّ يُؤَمِّلُ قُنياناً وَيَطَّرِفُ",5,"ف",1,0],["قَد صيغَ مِبضَعُهُ وَإِن أَجرى دَماً","مِن رَحمَةٍ فَجَريحُهُ بَسّامُ",6,"م",1,0],["قَد صَحَّ عِندَكَ شاهِدٌ مِن عَبرَتي","فَسَلِ الدُجى وَنُجومَهُ عَن مَضجَعي",7,"ع",2,0],["قد صَحّ عزمك والزمان مريض","حتّام تذهب في المُنى وتَئيض",8,"ض",1,1],["قَد صَدَّعَ القَلبَ بَينٌ لا اِرتِجاعَ لَهُ","إِذ قَعقَعوا لِاِنتِزاعِ النِيَّةِ العَمَدا",9,"د",2,0],["قَد صَدَرَت عَن مَنهَلٍ رَوِيِّ","مِن غُبَرِ الوَسمِيِّ وَالوَلِيِّ",10,"ي",1,0],["قد صدقناك عن بُنانك يا شي","خُ فلا يستفزَّك التشكيك",11,"ك",1,0],["قدْ صحتْ شمسُه وأقفرَ إلا","من نِعاج خَواذلٍ ونعام",12,"م",1,0],["قَد صانَ بُردَتَها الحَيا","ء وَصانَني شَرَفي وَخيري",13,"ر",2,0],["قَد صَيَّروا الأَرضَ كَالكِتابِ","وَاِنحَشَروا بَينَ دَفَّتَيهِ",14,"ه",1,0],["قَد صارَ مِن دونِ الَّذي","تُبديهِ مِن مَزحٍ مَراحِل",15,"ل",1,0],["قَد صَحَّ عُذرُكَ في","الهَوى لَكِنَّني أَتَعَلَّلُ",16,"ل",1,0],["قَد صَحَّ عِندِيَ ماجَرى","فَدَعِ اللَجاجَةَ وَالمِرا",17,"ر",2,1],["قد صوب المتعصبون سهامهم","لكنها طاشت عن الأهداف",18,"ف",1,0],["قد صانها الشاعر عن حُلوةٍ","في مفضلٍ أو مرة في بخيل",19,"ل",1,0],["قد صوّرا الحب وأحداثه","في القلب من مستصغر أو جليل",19,"ل",1,0],["قد صفعناك صفعة","ليس يمحى لها أثر",20,"ر",1,1],["قَد صَغَّرَ البُعدُ الوُجودَ لَنا فَيا","لِلَّهِ ما أَحلى الوُجودَ مُصَغَّرا",21,"ر",2,0],["قَد صارَتِ الحالُ إِلى جِدِّها","وَاِنتَبَهَ الغافِلُ مِن لُعبِهِ",22,"ب",2,0],["قَد صَبَغَت خَدَّها الدِماءُ كَما","يَصبُغُ خَدَّ الخَريدَةِ الخَجَلُ",23,"ل",1,0],["قَد صَدَقَ الوَردُ في الَّذي زَعَما","أَنَّكَ صَيَّرتَ نَثرَهُ دِيَما",24,"م",2,1],["قَد صَيَّرَت أَوَّلَ الدُنيا وَآخِرَها","آباؤُهُ مِن مُغارِ العِلمِ في قَرَنِ",25,"ن",1,0],["قد صيّر الماء والهواء له","من بعد أن صعدا هما ذنبا",26,"ب",2,0],["قد صرَفْنا الأبصارَ عنهنَّ خَوْفاً","إذ رَمَتْنا بِلَحْظِها الأبصارُ",27,"ر",1,0],["قَد صارَ مِمّا كانَ يَملِكُهُ","صِفراً وَصارَ لِغَيرِهِ سَلَبُه",28,"ب",2,0],["قَد صارَ يَحسُدُني مَن كانَ يَعذُرُني","فيهِ وَيَعذُرُني رَهطي وَأَضدادي",29,"ي",1,1],["قَد صَبَرنا بِالوَعدِ مِنكَ شُهوراً","ما رَأَينا بِهُنَّ لَيلَةَ قَدرِ",30,"ر",1,1],["قَد صُنتَ شِعري وَجُلُّ الناسِ تَخطُبُهُ","وَذاكَ لَولاكَ لَم يَعبَأ بِهِ أَحَدُ",31,"د",1,0],["قَد صَرَفَ الحِجابَ عَن حَضرَتِهِ","وَصَيَّرَ الهَيبَةَ مِن حِجابِهِ",32,"ب",2,0],["قد صار حبُّ الحياة منا","يقنع بالجيفة السباع",33,"ع",1,0],["قد صحت عيني على فجرِ جمالك","كيف يُنسى الفجرُ يا فجر الحياه",34,"ه",1,0],["قد صَوْلَجَتْ أغصانَها فكأنّما","قَنَصَتْ لهنّ من الفضاء طيورا",35,"ر",2,0],["قَد صَحا القَلبُ بَعدَما","قَد يُرى وَهوَ مُنتَشي",36,"ي",1,1],["قَد صَنَّفَ الحُسنُ في خَدَّيكَ جَوهَرُهُ","وَفيهِ قَد خَلَّفَ التُفاحُ أَحمَرَهُ",37,"ر",2,1],["قَد صَرَّحَت عَن مَحضِها الأَخبارُ","وَاِستَبشَرَت بِفُتوحِكَ الأَمصارُ",38,"ر",1,0],["قَد صَرَّفَ الرانونَ خَمرَةَ خَدِّهِ","وَأَظُنُّها بِالريقِ مِنهُ سَتُقطَبُ",39,"ب",1,0],["قدْ صيَّرتْ أدمعَ المملوكِ جاريةً","شوقاً إلى إلى صَدْرِ مصر بحرُه عَذُبا",40,"ب",2,0],["قَد صَبا القَلبُ صِباً غَيرَ دَني","وَقَضى الأَوطارَ مِن أُمِّ عَلي",41,"ي",1,1],["قَد صَدَقناكَ إِذ سَأَلتَ فَمَن أَن","تَ عَسى أَن يَجُرَّ شَأنٌ شُؤونا",42,"ن",2,0],["قَد صَفا العَيشُ وَالمُغيرِيُّ عِندي","حَبَّذا هُوَ مِن صاحِبٍ وَخَليلِ",43,"ل",1,0],["قَد صيغَ صيغَةَ حِكمَةٍ أَصبى لَها","نَفسَ الحَكيمِ وَضاجَعَ العَذراءَ",44,"ا",2,0],["قَد صَدَ قَلبي قَمَرُ","يَسحَرُ مِنهُ النَظَرُ",45,"ر",1,1],["قدْ صارَ كُتَّابي وَبَيْتِيَ مِنْ بَنِي","غَيْرِي وأبنائي كَبُرْجِ حَمامِ",46,"م",1,0],["قد صُرّ آذانُ الجيادِ توجّساً","وكتمْنَ إعلانَ الصّهيلِ تَهَيُّبا",47,"ب",2,0],["قَد صارَتِ النَفسُ مِنهُ","بَينَ الحَشا وَالوَريدِ",48,"د",1,0],["قَد صَكَّ لي بِالقُربِ مِن سَيِّدي","وَدارَ صَكّي في الدَواوينِ",49,"ن",1,1],["قد صبغت بنتُ المدينيّه","للفطرِ يا عبّاس فوهيّه",50,"ي",2,1],["قَد صَرَّحَ الحَقُّ وَماتَ الزورُ","آبَ التُقى وَاللَهوُ خَيتَعورُ",51,"ر",1,0],["قَد صُدتِ قَلبي فَأَنقَعتِ الهَوانَ لَهُ","ما كُلُّ حينٍ يُهينُ الصَيدَ مَن صادا",52,"د",2,0],["قَد صادَ بَكراً وَيَعفوراً لِنِسوَتِهِ","بَعدَ المُثَنّى أَلا بُعداً لِما صادا",53,"د",2,0],["قَد صارَ مِن بَعدِ إِشرافٍ عَلى تَلَفٍ","وَبَعدَ غُلٍّ عَلى الزَندَينِ مَشدودِ",54,"د",1,0],["قَد صَرَّدَت هامَتي حُبّى بِبَخلَتِها","ما خَيرُ عَيشِ الفَتى وَالكَأسُ تَصريدُ",55,"د",1,0],["قَد صَحِبنا الزَمانَ بِالرَغمِ مِنّا","وَهوَ يُردي كَما عَلِمتَ الصَحابا",56,"ب",2,1],["قَد صَدَقَّ الناسُ ما الأَلبابُ تُبطِلُهُ","حَتّى لَظَنّوا عَجوزاً تَحلُبُ القَمَرا",57,"ر",2,0],["قَد صَيَّرَ الإِنسانُ في أَحشائِهِ","قَبراً لِغانِيَةٍ عَنِ الإِقبارِ",58,"ر",1,0],["قد صرَّحَ الأَعداءُ بالبَينِ","وأشرقَ الصُّبحُ لذي العَينِ",59,"ن",1,1],["قد صدَّقَ اللَّهُ رجاءَ الورَى","وما رجاءٌ عندَهُ خائبُ",60,"ب",1,0],["قد صار شكي ظناً","وصار ظني يقينا",61,"ن",2,0],["قد صرت أحتقر الحياة لأنها","أَسباب آلامي وأصل شروري",62,"ر",2,0],["قَد صرعتني عينها","فَما ذممت مصرعي",63,"ي",1,0],["قد صيرت أول الدنيا أواخرها","آباؤه من مغار العلم في قرن",64,"ن",1,0],["قد صَنَعْت الحقَّ قد عاقبتني","فارحمِ المرأةَ في ذُلِّ هواها",65,"ا",3,0],["قَد صانَها الشاعِرُ عَن خُلوةٍ","في مُفضِلٍ أَو مُرةٍ في بَخيل",66,"ل",1,0],["قَدْ صَدَقَتْ فِيهِ الصِّفَاتُ الَّتِي","بِبَعْضِهَا يَفْخَرُ مَنْ يَفخرُ",67,"ر",1,0],["قد صافحاه عقابا","وعانقاه شهابا",68,"ب",2,0],["قَد صَفا جانِبُ الهَواءِ وَلَذَّت","رِقَّةُ الماءِ في مِزاجِ المُدامِ",69,"م",1,0],["قد صار جُودُكَ طبعاً فيك لا عَرَضاً","وراض طبعَك سُؤآلٌ مراويض",70,"ض",1,0],["قَدْ صَمَّمَتْ فَمَضَتْ عَجْلَى لِمقْصِدَهَا","تَحثُو التُّرابَ بِوَجْهِ الشَّكِّ وَالرِّيَبِ",71,"ب",1,0],["قد صَبَرَ النفْسَ على ما بها","وانتظَر الموعودَ من صَبْرِه",72,"ر",2,0],["قد صار دمعي بحرا في محاجره","وأصبت وسطه الأجفان أجفانا",73,"ن",2,0],["قد صيغَ صيغة َ حكمة ٍ أصتى لها","نفسَ الحكيمِ وضاجعَ العذراءَ",74,"ا",2,0],["قد صاد بالسيد الصياد منقبة ال","خلاق بل فيه يجلى ذلك السنن",75,"ن",1,0],["قد صرت في غرامه","والهفي ضرب مثل",76,"ل",1,0],["قد صده جنديك الف","ظ الغليظ بلا روية",77,"ي",2,0],["قد صار كلٌّ يدَّعي","دعوَى وليست فائِدَهْ",78,"د",2,0],["قَد صارَ رَيَّانَ مِن بَحرِ المَعَارِفِ لاَ","يُثنِيهِ عَن فَيضِهِ المرضِىِّ هَيمَانُ",79,"ن",1,0],["قَد صَانَهَا قَاطِفُوهَا في حَشَا صَدَقٍ","لَم يَخشَ صَولَةَ صَرفِ الدَّهرِ إِن هَجَمَا",80,"م",2,0],["قد صَارَ مثلَهَما عِندِي فَإني في","هذَا وفي ذَينِ كُلَّ الزَّيغِ اعتَقِدُا",81,"د",2,0],["قد صيَّر المالَ على حبِّه","طُعمةَ إتلافٍ وإنفاقِ",82,"ق",1,0],["قد صُبغتْ بالنقع ألوانُها","فاشتبه الأشهبُ والأدهمُ",83,"م",1,0],["قد صيَّرت سحبانَ في وائلٍ","كأنّه عَجماءُ صَلصالَهْ",84,"ل",2,0],["قَد صارَتِ الدُنيا بِعَدلِكَ مَعقِلاً","هَل في الوَرى عادٍ وَأَنتَ المُرهِبُ",85,"ب",1,0],["قَد صَحَّ لي كَدَرُ المُلوكِ وَغَدرُها","لَمّا وَفى لي صَفوُها وَلُبابُها",86,"ب",3,0],["قَد صَدَّ عَنهُم غِرارَ النَومِ سَيفُ هُدىً","غِرارُهُ بِدَمِ الأَعداءِ مُختَضِبُ",87,"ب",1,0],["قَد صُنتُهُنَّ عَنِ الخُطّابِ قاطِبَةً","كَما تُصانُ ذَواتُ الخِدرِ بِالكِلَلِ",88,"ل",1,0],["قد صار شكركم لديّ","سجيةًُ لا بل عقيده",89,"د",2,0],["قَدْ صِرْتُ فيهِ أَمِيرَ العاشِقِينَ وَقَدْ","أَضْحَتْ وِلايَةُ أَهْلِ العِشْقِ مِنْ قِبَلي",90,"ي",1,0],["قد صارَ يومُ الفِراقِ عندي","أَظلمَ منْ ظُلمَةِ الصُّدودِ",91,"د",1,0],["قد صنفا شيئاً وقالا إنه","مما يقال وعند ربك علمه",92,"م",2,0],["قد صان منطقه فلم ينطق بلا","مذ كان إِلا أن نوى تهليلا",93,"ل",2,0],["قد صيّر الملك عبدالله بينكم","خلافة زانهُ فيها تبتّلُهُ",94,"ل",2,0],["قد صاحت الوُرْقُ على أَغصانِها","يا معشرَ العشاقِ هل من مدكر",95,"ر",1,0],["قد صرت منا واحدا يا جعفر",