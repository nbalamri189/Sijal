s://www.aldiwan.net/poem10576.html","المنسرح"],[43,"أفاضل الناس أغراض لذا الزمن","https://www.aldiwan.net/poem10587.html","البسيط"],[62,"تنينا جائع له ذنب","https://www.aldiwan.net/poem52170.html","المنسرح"],[61,"لحظ عينيك للردى أنصار","https://www.aldiwan.net/poem51681.html","الخفيف"],[49,"كل إلى الرحمن منقلبه","https://www.aldiwan.net/poem10384.html","السريع"],[49,"قد صار يحسدني من كان يعذرني","https://www.aldiwan.net/poem64163.html","البسيط"],[66,"قد صبرنا بالوعد منك شهورا","https://www.aldiwan.net/poem38740.html","الخفيف"],[66,"في مثل حضرتكم لا يزأر الأسد","https://www.aldiwan.net/poem41370.html","البسيط"],[66,"أبد سنا وجهك من حجابه","https://www.aldiwan.net/poem41551.html","الرجز"],[97,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[97,"يا حبيب الروح يا روح الأماني","https://www.aldiwan.net/poem24800.html","الرمل"],[80,"واعمر بقصر الملك ناديك الذي","https://www.aldiwan.net/poem31233.html","الكامل"],[44,"قد صحا القلب بعدما","https://www.aldiwan.net/poem30030.html","مجزوء الخفيف"],[44,"قد صنف الحسن في خديك جوهره","https://www.aldiwan.net/poem30244.html","البسيط"],[44,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[44,"لمكاسر الحسن بن وهب أطيب","https://www.aldiwan.net/poem30585.html","الكامل"],[69,"سناك يا بن الكرام الكاتبين سبا","https://www.aldiwan.net/poem28710.html","البسيط"],[31,"قد صبا القلب صبا غير دني","https://www.aldiwan.net/poem38731.html","الرمل"],[31,"أصبح القلب في الحبال رهينا","https://www.aldiwan.net/poem41280.html","الخفيف"],[31,"مرحبا ثم مرهبا بالتي قا","https://www.aldiwan.net/poem41862.html","الخفيف"],[74,"ومرقرق الإفرند أبرق بهجة","https://www.aldiwan.net/poem12816.html","الكامل"],[52,"قد صد قلبي قمر","https://www.aldiwan.net/poem27040.html","مجزوء الرجز"],[67,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[75,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[48,"أيا ملين الحديد","https://www.aldiwan.net/poem62572.html","المجتث"],[48,"قد صك لي بالقرب من سيدي","https://www.aldiwan.net/poem66131.html","السريع"],[48,"قد صبغت بنت المدينيه","https://www.aldiwan.net/poem66559.html","السريع"],[50,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[50,"قل للتي هجرت حولين عاشقها","https://www.aldiwan.net/poem63872.html","البسيط"],[50,"يا ليلتي لم أنم شوقا وتسهادا","https://www.aldiwan.net/poem63896.html","البسيط"],[50,"لا يأيسن فقير من غنى أبدا","https://www.aldiwan.net/poem63899.html","البسيط"],[50,"يا حب إن دواء الحب مفقود","https://www.aldiwan.net/poem63939.html","البسيط"],[46,"قد صحبنا الزمان بالرغم منا","https://www.aldiwan.net/poem22140.html","الخفيف"],[46,"إن التجارب طير تألف الخمرا","https://www.aldiwan.net/poem22614.html","البسيط"],[46,"المرء يأبر خسة في طبعه","https://www.aldiwan.net/poem22716.html","الكامل"],[76,"قد صرح الأعداء بالبين","https://www.aldiwan.net/poem38872.html","الرجز"],[76,"ما قدر الله هو الغالب","https://www.aldiwan.net/poem39492.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85859","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85539","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85308","الرجز"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140895",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19390","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142053","المجتث"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5277","الخفيف"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23960","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[77,"هات الحديث عن الركب الذي بانا","https://www.poetsgate.com/ViewPoem.aspx?id=34164",""],[74,"ومُرَقْرَقِ الإفْرِنْدِ أبرَقَ بَهجَة ً،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13960&r=&rc=1",""]],"verses":[["قَدْ صِيغَ مِنْ حَبِّ القلوبِ كَما","نَفَضَتْ عَلَيْهِ سَوادَها المُقَلُ",0,"ل",1,0],["قَد صِرتُ في الأَرضِ كَما","في الأُفُقِ نَجمُ الذَنَبِ",1,"ب",1,0],["قَد صارَ مِثلَ الخَيطِ مِن ذِكراكُمُ","وَالسَمعُ مِنهُ لَيسَ يَسمَعُ مَن دَعا",2,"ا",1,0],["قَدْ صَارَ دَمْعِيَ بَحْراً فِي مَحَاجِرِهِ","وَأَصْبَحَتْ وَسْطَهُ الأجفان أَجْفَانَا",3,"ن",2,0],["قدْ صحّ في سُنَنِ النّبي محمّدٍ","فَضْلي على المَوْشِيِّ والدِّيباجِ",4,"ج",1,1],["قَد صادَفوا عُصبَةً مِنّا وَسَيِّدَنا","كُلٌّ يُؤَمِّلُ قُنياناً وَيَطَّرِفُ",5,"ف",1,0],["قَد صيغَ مِبضَعُهُ وَإِن أَجرى دَماً","مِن رَحمَةٍ فَجَريحُهُ بَسّامُ",6,"م",1,0],["قَد صَحَّ عِندَكَ شاهِدٌ مِن عَبرَتي","فَسَلِ الدُجى وَنُجومَهُ عَن مَضجَعي",7,"ع",2,0],["قد صَحّ عزمك والزمان مريض","حتّام تذهب في المُنى وتَئيض",8,"ض",1,1],["قَد صَدَّعَ القَلبَ بَينٌ لا اِرتِجاعَ لَهُ","إِذ قَعقَعوا لِاِنتِزاعِ النِيَّةِ العَمَدا",9,"د",2,0],["قَد صَدَرَت عَن مَنهَلٍ رَوِيِّ","مِن غُبَرِ الوَسمِيِّ وَالوَلِيِّ",10,"ي",1,0],["قد صدقناك عن بُنانك يا شي","خُ فلا يستفزَّك التشكيك",11,"ك",1,0],["قدْ صحتْ شمسُه وأقفرَ إلا","من نِعاج خَواذلٍ ونعام",12,"م",1,0],["قَد صانَ بُردَتَها الحَيا","ء وَصانَني شَرَفي وَخيري",13,"ر",2,0],["قَد صَيَّروا الأَرضَ كَالكِتابِ","وَاِنحَشَروا بَينَ دَفَّتَيهِ",14,"ه",1,0],["قَد صارَ مِن دونِ الَّذي","تُبديهِ مِن مَزحٍ مَراحِل",15,"ل",1,0],["قَد صَحَّ عُذرُكَ في","الهَوى لَكِنَّني أَتَعَلَّلُ",16,"ل",1,0],["قَد صَحَّ عِندِيَ ماجَرى","فَدَعِ اللَجاجَةَ وَالمِرا",17,"ر",2,1],["قد صوب المتعصبون سهامهم","لكنها طاشت عن الأهداف",18,"ف",1,0],["قد صانها الشاعر عن حُلوةٍ","في مفضلٍ أو مرة في بخيل",19,"ل",1,0],["قد صوّرا الحب وأحداثه","في القلب من مستصغر أو جليل",19,"ل",1,0],["قد صفعناك صفعة","ليس يمحى لها أثر",20,"ر",1,1],["قَد صَغَّرَ البُعدُ الوُجودَ لَنا فَيا","لِلَّهِ ما أَحلى الوُجودَ مُصَغَّرا",21,"ر",2,0],["قَد صارَتِ الحالُ إِلى جِدِّها","وَاِنتَبَهَ الغافِلُ مِن لُعبِهِ",22,"ب",2,0],["قَد صَبَغَت خَدَّها الدِماءُ كَما","يَصبُغُ خَدَّ الخَريدَةِ الخَجَلُ",23,"ل",1,0],["قَد صَدَقَ الوَردُ في الَّذي زَعَما","أَنَّكَ صَيَّرتَ نَثرَهُ دِيَما",24,"م",2,1],["قَد صَيَّرَت أَوَّلَ الدُنيا وَآخِرَها","آباؤُهُ مِن مُغارِ العِلمِ في قَرَنِ",25,"ن",1,0],["قد صيّر الماء والهواء له","من بعد أن صعدا هما ذنبا",26,"ب",2,0],["قد صرَفْنا الأبصارَ عنهنَّ خَوْفاً","إذ رَمَتْنا بِلَحْظِها الأبصارُ",27,"ر",1,0],["قَد صارَ مِمّا كانَ يَملِكُهُ","صِفراً وَصارَ لِغَيرِهِ سَلَبُه",28,"ب",2,0],["قَد صارَ يَحسُدُني مَن كانَ يَعذُرُني","فيهِ وَيَعذُرُني رَهطي وَأَضدادي",29,"ي",1,1],["قَد صَبَرنا بِالوَعدِ مِنكَ شُهوراً","ما رَأَينا بِهُنَّ لَيلَةَ قَدرِ",30,"ر",1,1],["قَد صُنتَ شِعري وَجُلُّ الناسِ تَخطُبُهُ","وَذاكَ لَولاكَ لَم يَعبَأ بِهِ أَحَدُ",31,"د",1,0],["قَد صَرَفَ الحِجابَ عَن حَضرَتِهِ","وَصَيَّرَ الهَيبَةَ مِن حِجابِهِ",32,"ب",2,0],["قد صار حبُّ الحياة منا","يقنع بالجيفة السباع",33,"ع",1,0],["قد صحت عيني على فجرِ جمالك","كيف يُنسى الفجرُ يا فجر الحياه",34,"ه",1,0],["قد صَوْلَجَتْ أغصانَها فكأنّما","قَنَصَتْ لهنّ من الفضاء طيورا",35,"ر",2,0],["قَد صَحا القَلبُ بَعدَما","قَد يُرى وَهوَ مُنتَشي",36,"ي",1,1],["قَد صَنَّفَ الحُسنُ في خَدَّيكَ جَوهَرُهُ","وَفيهِ قَد خَلَّفَ التُفاحُ أَحمَرَهُ",37,"ر",2,1],["قَد صَرَّحَت عَن مَحضِها الأَخبارُ","وَاِستَبشَرَت بِفُتوحِكَ الأَمصارُ",38,"ر",1,0],["قَد صَرَّفَ الرانونَ خَمرَةَ خَدِّهِ","وَأَظُنُّها بِالريقِ مِنهُ سَتُقطَبُ",39,"ب",1,0],["قدْ صيَّرتْ أدمعَ المملوكِ جاريةً","شوقاً إلى إلى صَدْرِ مصر بحرُه عَذُبا",40,"ب",2,0],["قَد صَبا القَلبُ صِباً غَيرَ دَني","وَقَضى الأَوطارَ مِن أُمِّ عَلي",41,"ي",1,1],["قَد صَدَقناكَ إِذ سَأَلتَ فَمَن أَن","تَ عَسى أَن يَجُرَّ شَأنٌ شُؤونا",42,"ن",2,0],["قَد صَفا العَيشُ وَالمُغيرِيُّ عِندي","حَبَّذا هُوَ مِن صاحِبٍ وَخَليلِ",43,"ل",1,0],["قَد صيغَ صيغَةَ حِكمَةٍ أَصبى لَها","نَفسَ الحَكيمِ وَضاجَعَ العَذراءَ",44,"ا",2,0],["قَد صَدَ قَلبي قَمَرُ","يَسحَرُ مِنهُ النَظَرُ",45,"ر",1,1],["قدْ صارَ كُتَّابي وَبَيْتِيَ مِنْ بَنِي","غَيْرِي وأبنائي كَبُرْجِ حَمامِ",46,"م",1,0],["قد صُرّ آذانُ الجيادِ توجّساً","وكتمْنَ إعلانَ الصّهيلِ تَهَيُّبا",47,"ب",2,0],["قَد صارَتِ النَفسُ مِنهُ","بَينَ الحَشا وَالوَريدِ",48,"د",1,0],["قَد صَكَّ لي بِال