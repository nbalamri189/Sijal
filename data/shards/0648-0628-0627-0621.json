{"poems":[[53,"وكم عائب قد عابني وهو صادق","https://www.aldiwan.net/poem8492.html","الطويل"],[92,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[314,"وقعنا في الخطايا والبلايا","https://www.aldiwan.net/poem50229.html","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53893","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112808","الوافر"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45362","الوافر"],[2442,"","https://poetry.dctabudhabi.ae/diwan/poem/198632","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74172","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133152","الطويل"],[4755,"وَبَاءٌ زاحِفٌ طُولًا وعَرضا","https://www.poetsgate.com/ViewPoem.aspx?id=188457",""],[4935,"لئام الناس أيديها","https://www.poetsgate.com/ViewPoem.aspx?id=129368",""],[5002,"عيد في زمن الوباء.....","https://www.poetsgate.com/ViewPoem.aspx?id=212903",""],[5459,"يا شهرزاد ..","https://www.poetsgate.com/ViewPoem.aspx?id=193636",""],[5809,"توبة","https://www.poetsgate.com/ViewPoem.aspx?id=205507",""]],"verses":[["وباءَ بسوءٍ فيه يُعديهِ غيرَه","ويجلبُهُ والسوءُ يُعدي ويُجلبُ",0,"ب",1,0],["وباءتْ بأقساهُنَّ كَفّي وما جَنَتْ","مِن الضُرِّ مما تَتَّقيهِ مسامعي",1,"ع",2,0],["وَباءَ الآمِرونَ بِكُلِّ عُرف","فَما عَن مُنكَرٍ في الناسِ ناهِ",2,"ا",2,0],["وباءَ بخِزْيِ لا يُرامُ ولعنةٍ","كما باءَ إِبليسُ الّذي لم يَزَلْ يَغْوِي",3,"ي",1,0],["وباء بضد ما وجدوا لآم","قلوه إذ نحو نهج النعام",4,"م",1,0],["وَباءَ فَقُلتُ في الغَبراءِ بُرج","وَثارَ فَقُلتُ في الخَضراءِ غابُ",5,"ب",1,0],["وباء بإثم جعفر والذي سعى","على مالكٍ سراً دبيب العقارب",6,"ب",1,0],["وَباء وَطاعون وَما ثم مَلجأ","سِواكَ وَأَنتَ الراحم الحكم العَدل",7,"ل",1,0],["وباء بقوس الكائنات لباريء","وسار اعتباراً في مواقع نبله",8,"ل",2,0],["وَبَاءٌ زاحِفٌ طُولًا وعَرضا","وجُوعٌ لم يَعد بالصَّبر يَرضَى!",9,"ض",2,1],["وباء على ضلالته","مع البهتان والوزر",10,"ر",1,0],["وباءٌ تمَادى شتَّتَ الجَمعَ شَمْلَهُ","فقدْ سادَ فينا مثْل ذئبٍ رأى نَعْجهْ",11,"ج",2,0],["وباءُ طاعون نزاعاتنا","منتشرٌ .. هيهات نلقى الفلاح",12,"ح",1,0],["وباءَ بالخُسرِ ممن كان يعشقهم","فراحَ يجمعُ حول الباءِ تاءَينِ",13,"ن",1,0]]}