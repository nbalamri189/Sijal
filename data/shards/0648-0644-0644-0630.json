{"poems":[[65,"نهج الثناء إلى ناديك مختصر","https://www.aldiwan.net/poem46122.html","البسيط"],[90,"يا شهر أيار ما أن أنت أيار","https://www.aldiwan.net/poem44420.html","البسيط"],[69,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54654","الوافر"],[111,"الله أكبر رزء نكس العلما","https://www.poetsgate.com/ViewPoem.aspx?id=525",""],[203,"يا ليل هيجت أشواقا أداريها","https://www.aldiwan.net/poem45151.html","البسيط"],[242,"حاولت صبرا على ما ناب من نوب","https://www.aldiwan.net/poem18065.html","البسيط"],[242,"شرذمة مأبونه","https://www.aldiwan.net/poem19102.html","مجزوء الرجز"],[287,"تمتع بأنفاس الضحى والأصائل","https://www.aldiwan.net/poem32637.html","الطويل"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[353,"منازلهم جادتك غر السحائب","https://www.aldiwan.net/poem19847.html","الطويل"],[376,"أطاعك الدمع الذي كان عصى","https://www.aldiwan.net/poem57538.html","الرجز"],[563,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[638,"","https://poetry.dctabudhabi.ae/diwan/poem/104418","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67826","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49549","البسيط"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84928","الطويل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127394","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48340","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135728","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135396","الطويل"],[4767,"فرزنو","https://www.poetsgate.com/ViewPoem.aspx?id=178386",""],[4874,"سافرت بك","https://www.poetsgate.com/ViewPoem.aspx?id=176616",""],[5392,"..للخيوط ذهولُ","https://www.poetsgate.com/ViewPoem.aspx?id=11293",""],[5616,"غار","https://www.poetsgate.com/ViewPoem.aspx?id=203336",""],[5725,"لا غالب اليوم الا الله ياوطني","https://www.poetsgate.com/ViewPoem.aspx?id=201303",""],[5776,"قصيدةُ الخُلْد","https://www.poetsgate.com/ViewPoem.aspx?id=199279",""],[4222,"تُرى يجتمعُ الشّملُ","https://www.poetsgate.com/ViewPoem.aspx?id=71346",""],[242,"مات الرضى شيخنا الفاسي مصطحبا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563800",""]],"verses":[["وللذخيرة فَضْلٌ أنتَ وارِثُهُ","وكانَ أرْوَعَ ما في عُودِهِ خَوَرُ",0,"ر",1,0],["وللذباب طنين عند سامعه","يحكيه في فنزج العربان مزمار",1,"ر",1,0],["وللذَّنبِ الذي ضاقَتْ عليه","به الدنيا وجانبُها رَحِيبُ",2,"ب",1,0],["وَلِلذِكْرَى سَخَتْ أَيْدٍ شِحَاحٌ","وَجِيءَ مِنَ المَفَاخِرِ بِالضُّرُوبِ",3,"ب",1,0],["وَلِلذِّكْرَى بنَى البَانِي فَأعْلَى","وَأَبْدَعَ كُلُّ مُخْتَرِعٍ لَبِيبِ",3,"ب",1,0],["وَلِلذِّكْرَى فَدَى الفَادِي حِمَاهُ","وَخَطّ كِتَابَهُ بِدَمٍ صَبِيبِ",3,"ب",1,0],["وللذهول انفعال بالنهي وقفت","به المدارك عن إلمام ما التأما",4,"م",2,0],["وللذي أبعدته في مطارحها","يد النوى أنا من عينيك أدنيها",5,"ي",3,0],["وللذي مضه يأس الهوى فسلا","أنظر إليّ ولا تترك تمنيها",5,"ي",3,0],["وَلِلَّذِي تَاهَ في الأَوْهامِ تُرْشِدُهُ","بِهَدْيِ مُحْتَسِبٍ لاَ بِهَدْيِ مُكْتَسِبِ",6,"ب",1,0],["وَللذِي نامَ في العُدْوانِ تُوقِظُهُ","بِعَزْمِ مُنْتَدِبٍ لِلَّهِ مُحْتَسِبِ",6,"ب",1,0],["وَلِلذِي أَقْعَدَ الْعِصْيانُ تُنْهِضُهُ","بِهَمِّ مُنْتَسِبٍ لِلْحَقِّ مُنْتَصِبِ",6,"ب",1,0],["وَللذِي اعْتَاصَ مِنْ مَعْنىً تُوَضِّحُهُ","حَتَّى يَصِيرَ سَنىً فِي عَيْنِ مُرْتَقِبِ",6,"ب",1,0],["وَلِلَّذِي مِنْ عِلْمِهِ","وَحُكْمِهِ يَدْرُونَهْ",7,"ن",2,0],["وَلِلَّذِي مِنْ ذِكْرِهِ","وَشُكْرِهِ يَتْلُونَهْ",7,"ن",2,0],["وَلِلذَّهَبِيّاتِ اِصفَرارُ ذَوي هَوىً","أَطَلَّ عَلَيهِم في الجُسومِ النَواحِلِ",8,"ل",1,0],["وللذئب من حوله شرَّةٌ","تصول إذا ما وهى جانباه",9,"ه",1,0],["ولِلذِّكْرِ مِسْكٌ مِن مُعَاقَرَةِ الكَرَى","أَقَرَّ وِسَادَ الهَامِ فَوْقَ الغَوارِبِ",10,"ب",1,0],["وللذي دلَّ من الجودِ عَلى","سبيل مَن قُبيله كان سُدى",11,"ا",1,0],["وللذنب يا غفار فاغفر تكرماً","وبالقهر يا قهار فارم الأعاديا",12,"ي",2,0],["وللذكوات البيض سرنا نجوبها","بسبح تعوم البحر سبحان من أسرى",13,"ر",2,0],["وَلِلْذْنِبِ الْجَاني مِنَ النَّارِ مُنْقِذُ","أَيَا سَعْدُ حِثَّ العِيسَ إنْ كُنْتَ مُسْعِدِي",14,"ي",1,0],["وللذبيح به فوز وتكرمة","كما لإسحاق من جدوال تحصيل",15,"ل",1,0],["وللذبيح أبانت رشده فنجا","وكم بها استحق حفته عنايات",16,"ت",1,0],["وللذين فضلوا بسبقهم","منّي ثناء وهو بعض حقهم",17,"م",1,0],["وللذي قد جاء فيه القطع","مذيّلا وفيه أيضا خلع",17,"ع",1,0],["وَللَّذي هَمُّهُ البنيانُ يَرْفَعُهُ","إنّ الردى لم يغادرْ في الشَّرَى أَسَدا",18,"د",2,0],["وَلِلذهب الأبريز في التُرب مسكن","وَيَسكُن قاع البَحر دُر يَنضد",19,"د",1,0],["وللذين اتقوا رباه قد خلقت","شقاوة العيش في دنيا الشقاوات",20,"ت",1,0],["وللذّكرِ لا أرْتاحُ إلا تشوُّفا","تأمّلتُ ربْعاً للحَبيبِ ومَعْلَما",21,"ا",1,0],["وللذي أوصى الجميع فاغفرا","ذنوبه وللعيوب فاسترا",22,"ر",2,0],["وللذي علَّم والأصهارِ","فاغفر جميع الذنب والأنصار",22,"ر",1,0],["وللذات ما للذات من ذات وصفه","وللوصف ما للذات وصف سماته",23,"ه",1,1],["وللذي عاش فيها","بوازع فهي أمن",24,"ن",1,0],["وللذاكرة لاشدنا صوتٍ من الداخل خفي","سافرت بك..سافرت بك فوق ابتهالات النسيم",25,"م",1,0],["وللذكرياتِ الذارياتِ جنونها","على واحةِ المهْوى الأسيل مُثولُ",26,"ل",1,0],["وللذئاب نيوب كنت تعرفها","فما اكترثت بأنياب وأظفارَ!!",27,"ر",1,0],["وللذباب طنين فوق رمّتها","مثل احتضارات وجد جاء يسلبها",28,"ب",3,0],["وللذي ما لهُ ليلى ولا خَطَرتْ","بِبالهِ ..صارَ ليلى كلّ من غنّى",29,"ن",2,0],["وللذَّاتِ أَبوابٌ","وما من دُونها قُفْلُ",30,"ل",1,0],["وَلِلَّذي تاهَ في الأَوهامِ تُرشِدُهُ","بِهَديِ مُحتَسِبٍ لا هَدى مُكتَسِبِ",31,"ب",1,0],["وَلِلَّذي نامَ في العِصيانِ توقِظُهُ","بِعَزمِ مُنتَسِبٍ لِلحَقِّ مُنتَصِبِ",31,"ب",1,0]]}