{"poems":[[80,"ألكم إلى الصب الشجي معاد","https://www.aldiwan.net/poem14015.html","الكامل"],[80,"أَلَكُم إِلى الصبّ الشَّجيّ مَعادُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86501&r=&rc=46",""],[119,"من هجرك الامان","https://www.aldiwan.net/poem40439.html","عموديه"],[236,"ذكر العقيق فهاجه تذكاره","https://www.aldiwan.net/poem44570.html","الكامل"],[266,"يا من ثنى عني عنان وداده","https://www.aldiwan.net/poem38161.html","الكامل"],[369,"وجدي بلومك يا عذول يزيد","https://www.aldiwan.net/poem60944.html","الكامل"],[408,"يا واهب الجرد السلاهب","https://www.aldiwan.net/poem46913.html","مجزوء الكامل"],[520,"قولا لنجم الدين يا خير من","https://www.aldiwan.net/poem12103.html","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119953","المنسرح"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53109","المنسرح"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53215","البسيط"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99504","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114404","المجتث"]],"verses":[["يا مَن ثَكِلتُ دُنوَّهُم وَوِصالَهُم","فَبَدا عَليَّ مِنَ الشُجوب حِدادُ",0,"د",1,0],["يا مَن ثَكِلتُ دُنوَّهُم وَوِصالَهُم","فَبَدا عَليَّ مِنَ الشُّحوب حِدادُ",1,"د",1,0],["يا من ثوى بقلبي","هل سرك المكان",2,"ن",1,0],["يا من ثوى بين الجوانح والحشا","مني وإن بعدت علي دياره",3,"ر",2,0],["يا من ثنى عني عنان وداده","ما كنت علك عنان ودي ثان",4,"ن",1,1],["يا مَنْ ثَنى العِطْف المَهابةُ دونه","حيرانَ أَمضي خُطْوة وأَعود",5,"د",1,0],["يا من ثناهُ وشكره","أبدَ الزّمان عليَّ واجبْ",6,"ب",1,0],["يا من ثناه وسنا وجهه","نزهة أسماع وأبصار",7,"ر",1,0],["يا من ثنائي على علاه","كالمسك بين الملا وأطيبُ",8,"ب",1,0],["يا من ثنى الدهر عن تَغَشْمُرِه","فليس تجري بالكيد أكدار",9,"ر",1,0],["يا من ثنته شَمول من شمائله","فاهتزَّ مثل اهتزاز النابل اليزني",10,"ن",2,0],["يا من ثناه وذكره","بين الورى مسكٌ وعنبر",11,"ر",1,1],["يا من ثوى بفؤادي","كم عاذِلٍ فيكَ لاما",12,"م",2,1]]}