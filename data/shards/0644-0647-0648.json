{"poems":[[53,"وذي ضغن معسولة كلماته","https://www.aldiwan.net/poem29846.html","الطويل"],[53,"وفى بمواعيد الخليط وأخلفوا","https://www.aldiwan.net/poem29968.html","الطويل"],[63,"سرت والليل يرمز بالصباح","https://www.aldiwan.net/poem46156.html","الوافر"],[63,"تلفت بالثوية نحو نجد","https://www.aldiwan.net/poem46186.html","الوافر"],[3,"أشاقك من عبل الخيال المبهج","https://www.aldiwan.net/poem135.html","الطويل"],[34,"فيا قلب صبرا واعترافا لما ترى","https://www.aldiwan.net/poem4903.html","الطويل"],[86,"من لم يذق فقد أليف الصبا","https://www.aldiwan.net/poem10469.html","السريع"],[86,"ملكت علي مذاهبي","https://www.aldiwan.net/poem68864.html","مجزوء الكامل"],[93,"علام يقام تمثالي","https://www.aldiwan.net/poem9164.html","مجزوء الوافر"],[93,"عيد حسيب عيد حبيب","https://www.aldiwan.net/poem11127.html","مخلع البسيط"],[93,"مددت طرافك للائدين","https://www.aldiwan.net/poem11200.html","المتقارب"],[30,"وقفت على ربع لمية ناقتي","https://www.aldiwan.net/poem29613.html","الطويل"],[27,"ألم تر أن الجهل أقصر باطله","https://www.aldiwan.net/poem5976.html","الطويل"],[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[51,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[51,"لهوت عن وصف الطلول الدارسه","https://www.aldiwan.net/poem64573.html","الرجز"],[51,"اسعد بعيد أخي نسك وإسلام","https://www.aldiwan.net/poem66052.html","البسيط"],[56,"يا عين لا للغضا ولا الكثب","https://www.aldiwan.net/poem58644.html","المنسرح"],[43,"ملث القطر أعطشها ربوعا","https://www.aldiwan.net/poem9722.html","الوافر"],[43,"لهوى النفوس سريرة لا تعلم","https://www.aldiwan.net/poem10567.html","الكامل"],[58,"أما والله إن الظلم شؤم","https://www.aldiwan.net/poem30857.html","الوافر"],[49,"إذا ما خلوت الدهر يوما فلا تقل","https://www.aldiwan.net/poem10328.html","الطويل"],[49,"رأيتك فيما يخطئ الناس تنظر","https://www.aldiwan.net/poem62101.html","الطويل"],[49,"كأن يقيننا بالموت شك","https://www.aldiwan.net/poem63041.html","الوافر"],[49,"من جعل الدهر على باله","https://www.aldiwan.net/poem63091.html","السريع"],[49,"أما والله إن الظلم لوم","https://www.aldiwan.net/poem63114.html","الوافر"],[66,"لم أدر أن نبال الغنج والكحل","https://www.aldiwan.net/poem38479.html","البسيط"],[44,"لها وأعارني ولها","https://www.aldiwan.net/poem30085.html","مجزوء الوافر"],[44,"شبيه الخد بالتفا","https://www.aldiwan.net/poem30253.html","الهزج"],[44,"عسى وطن يدنو بهم ولعلما","https://www.aldiwan.net/poem30356.html","الطويل"],[69,"عجبت لشيء كل شيء يهابه","https://www.aldiwan.net/poem28516.html","الطويل"],[74,"ألا رب يوم لي بباب الزخارف","https://www.aldiwan.net/poem13180.html","الطويل"],[74,"بذات المكارم ذاك الألم","https://www.aldiwan.net/poem13252.html","المتقارب"],[48,"إذا ما خلوت الدهر يوما فلا تقل","https://www.aldiwan.net/poem62451.html","الطويل"],[50,"أعادك طيفها وبما يعود","https://www.aldiwan.net/poem63923.html","الوافر"],[50,"أفنيت عمري وتقضى الشباب","https://www.aldiwan.net/poem64823.html","السريع"],[50,"تجهز طال في النصب الثواء","https://www.aldiwan.net/poem64892.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85414","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140932",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21053","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42608","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54530","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43675","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43652","الطويل"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8871","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10302","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[100,"تحت السكاكين","https://www.poetsgate.com/ViewPoem.aspx?id=50374",""],[51,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[94,"إيه حكيم الدّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66311&r=&rc=29",""],[129,"إذا ما بدا برق بنعمان لامع","https://www.aldiwan.net/poem50583.html","الطويل"],[133,"عراني غرام شفني وبراني","https://www.aldiwan.net/poem54710.html","الطويل"],[161,"فرائد زانها حسن النظام","https://www.aldiwan.net/poem59119.html","الطويل"],[175,"ألذ وأشفى لنا من طرب","https://www.aldiwan.net/poem46071.html","المتقارب"],[187,"لقد هاج لي الوجد","https://www.aldiwan.net/poem43978.html","الهزج"],[211,"مسير قد ألم به هناء","https://www.aldiwan.net/poem13311.html","الوافر"],[236,"حياك الربيع من فصاح أعاجم","https://www.aldiwan.net/poem31748.html","الطويل"],[236,"قلبي في حبك معمود","https://www.aldiwan.net/poem32104.html","السريع"],[236,"أبثك وجدي لو أصخت لمعمود","https://www.aldiwan.net/poem32105.html","الطويل"],[236,"أيطمع أن يساجلك السحاب","https://www.aldiwan.net/poem32176.html","الوافر"],[242,"سقاها وحيا تربها وابل القطر","https://www.aldiwan.net/poem45764.html","الطويل"],[251,"لحى الله أيا ما مضت في بطالة","https://www.aldiwan.net/poem15076.html","الطويل"],[276,"حسب الوجود على التأييد برهانا","https://www.aldiwan.net/poem25507.html","البسيط"],[281,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[283,"أرقت لبرق من أهاضيب لبنان","https://www.aldiwan.net/poem32343.html","الطويل"],[283,"عذولي لا تلمني في هلالي","https://www.aldiwan.net/poem32663.html","الوافر"],[299,"تلاقوا بعد ما افترقوا طويلا","https://www.aldiwan.net/poem36818.html","عموديه"],[304,"له وجنة سبحان منبت وردها","https://www.aldiwan.net/poem57931.html","الطويل"],[304,"له وجه به آيات حسن","https://www.aldiwan.net/poem57940.html","الوافر"],[321,"ولما شربناها ودب دبيبها","https://www.aldiwan.net/poem61743.html","الكامل"],[349,"وأسمر يحكي الأسمر اللدن قده","https://www.aldiwan.net/poem20276.html","الطويل"],[350,"لهوا عن الحق فألهاهم","https://www.aldiwan.net/poem15736.html","السريع"],[365,"أمل على القلب الغرام فأبلغا","https://www.aldiwan.net/poem60842.html","الطويل"],[369,"سرى ليلاً خيال من سليمى","https://www.aldiwan.net/poem1871.html","الوافر"],[381,"قريح القلب موثقه","https://www.aldiwan.net/poem48804.html","مجزوء الوافر"],[397,"لهوتُ بسربال الشباب مُلاوة","https://www.aldiwan.net/poem600.html",""],[417,"تذكر عهدا بالحمى قد تقدما","https://www.aldiwan.net/poem53977.html","الطويل"],[446,"لهوى الحجاز بأفق قلبي مبدأ","https://www.aldiwan.net/poem23812.html","الكامل"],[459,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[465,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[465,"يا من لابيض كل جفن اسود","https://www.aldiwan.net/poem3536.html","عموديه"],[476,"عرفت بأجدث فنعاف عرق","https://www.aldiwan.net/poem1823.html","الوافر"],[478,"أبرق على المنحنى لائحام","https://www.aldiwan.net/poem15220.html","المتقارب"],[478,"بي من جوى التبريح اشفاق","https://www.aldiwan.net/poem15351.html","السريع"],[515,"ظبي إذا ما رنا منه الأسود ترتهب","https://www.aldiwan.net/poem20918.html","المواليا"],[530,"إذا رضي الرحمن عني فكل من","https://www.aldiwan.net/poem37132.html","الوافر"],[552,"أمالك من غرام ما أمالا","https://www.aldiwan.net/poem47319.html","الوافر"],[559,"صلاتي إليها بل إلي صلاتها","https://www.aldiwan.net/poem33516.html","الطويل"],[559,"سلام عظيم من عظيم تفردا","https://www.aldiwan.net/poem34594.html","الطويل"],[563,"آس العذار على خديه قد كتبا","https://www.aldiwan.net/poem52882.html","البسيط"],[568,"وليلة فيها قصر","https://www.aldiwan.net/poem69645.html","مجزوء الرجز"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["لَهُ وِقفَةُ المِجزاعِ ثُمَّ تُجيزُهُ","حَفيظَةُ مَجموعٍ عَلى الرَوعِ شَملُهُ",0,"ل",2,0],["لَهُ وَقَفاتٌ بَالحَجيجِ شُهودُها","إِلى عَقِبِ الدُنيا مِنىً وَالمُخَيَّفُ",1,"ف",1,0],["لهُ والمُزْنُ لا يندىً جُفوناً","بَنانُ يَدٍ تُجَنُّ على السّماحِ",2,"ح",1,0],["لهُ والمَحْلُ غادَرَ كُلَّ عافٍ","يكُدُّ العيسَ مُنتَجِعاً فيُكْدي",3,"د",2,0],["لَهَوتُ بِها وَاللَيلُ أَرخى سُدولَهُ","إِلى أَن بَدا ضَوءُ الصَباحِ المُبَلَّجُ",4,"ج",1,0],["لَهُ وَجَباتٌ إِثرَ لُبنى كَأَنَّها","شَقائِقُ بَرقٍ في السَحابِ لَوامِعُ",5,"ع",1,0],["لَهوٌ كَريمٌ لَم يَشُب صَفوَهُ","رِجسٌ وَلَم يَشهَدهُ مُستَهتِرُ",6,"ر",1,0],["لَهوٌ كَما شاءَ الصِبا","وَحِجاً كَما شاءَ الحَكيمُ",7,"م",1,0],["له ولكم تحياتي","ومحمدتي وإجلالي",8,"ل",2,0],["لَهْ وَفَاءٌ لَمْ يَعْرِفْ النَّا","سُ فِي أَمَاجِيدِهِمْ عَدِيلَهْ",9,"ل",2,0],["لَهُ وَلأَعْوَانِهِ أَيُّ فَضْلٍ","عَظِيمٍ فَكُلٌّ بِحَمْدٍ قَمِينْ",10,"ن",1,0],["لَهُ واحِفٌ فَالصُلبُ حَتّى تَقَطَّعَت","خِلافَ الثُرَيّا مِن أَريكٍ مَآرِبُه",11,"ب",2,0],["لَهَوتُ بِجِنِّيٍّ عَلَيهِ سُموطُهُ","وَإِنسٌ مَجاليهِ وَأُنسٌ شَمائِلُه",12,"ل",2,0],["لَهُ وَعَلَيهِ وَقعَةٌ بَعدَ وَقعَةٍ","وَلودٌ بِأَطرافِ الأَسِنَّةِ عاقِرُ",13,"ر",1,0],["له وَقْدةٌ بين السماء وبَيْنَهُ","تُلِمُّ بها الطيرُ العَوافي فتُهرَجُ",14,"ج",1,0],["لهوتُ بها ليلاً قصيراً طويلُه","وماليَ إلّا كفُّها مُتَوَسَّدُ",15,"د",1,0],["لهوٌ أطفنا بِبكر لذَّتِه","وما فضضْنا خواتمَ العُذَرِ",16,"ر",1,0],["لهوتُ عن وصف الطلول الدارسَهْ","بروضِةِ عذراءَ غير عانسَهْ",17,"س",2,1],["لَهَوْتَ فيه بجد النَّفح واجتَنَبتْ","دعابةَ النضح نفسٌ همُّها سامي",18,"م",2,0],["لِهَوْلِ يَوْمٍ تَقَلّصَ العِلْمُ والدِّ","ينُ بِثَغْريهما عَنِ الشّنَبِ",19,"ب",1,0],["لِهونِ المالِ أَفرَشَهُ أَديماً","وَلِلتَفريقِ يَكرَهُ أَن يَضيعا",20,"ع",2,0],["لِهَوى النُفوسِ سَريرَةٌ لا تُعلَمُ","عَرَضاً نَظَرتُ وَخِلتُ أَنّي أَسلَمُ",21,"م",1,1],["لَهَوتَ عَنِ الفَناءِ وَأَنتَ تَفنى","فَما شَيءٌ مِنَ الدُنيا يَدومُ",22,"م",1,0],["لَهَونا لَعَمرُ اللَهِ حَتّى تَتابَعَت","ذُنوبٌ عَلى آثارِهِنَّ ذُنوبُ",23,"ب",1,0],["لَهَوتَ وَكَم مِن عِبرَةٍ قَد حَضَرتَها","كَأَنَّكَ عَنها غائِبٌ حينَ تَحضُرُ",24,"ر",1,0],["لَهَونا وَالحَوادِثُ واثِباتٌ","لَهُنَّ بِمَن قَصَدنَ إِلَيهِ فَتكُ",25,"ك",1,0],["لَهُ وَفاءٌ وَلَهُ عَزمَةٌ","تَأوي إِلى أَكنافِ أَظلالِهِ",26,"ل",2,0],["لَهَوتَ عَنِ الفَناءِ وَأَنتَ تَفنى","وَما حَيٌّ عَلى الدُنيا يَدومُ",27,"م",1,0],["لَهَوتُ عَن مَدحِ أَهلِ الأَرضِ مُرتَفِعاً","عَنهُم وَعَضبُ لِساني غَيرُ ذي فَلَلِ",28,"ل",1,0],["لَهُ وَجهٌ يَعَزُّ بِهِ","وَلي حُرَقٌ أَذَلُّ بِها",29,"ه",2,0],["لَهُ وَجهٌ إِذا أَبصَر","تَهُ ناجاكَ عَن عُذرِ",30,"ر",1,0],["لَهُ وَقعَةٌ كانَت سَدىً فَأَنَرتَها","بِأُخرى وَخَيرُ النَصرِ ما كانَ مُلحَما",31,"م",2,0],["لهُ وجنةٌ محمرَّةٌ وذوائبٌ","طوالٌ وعنقٌ لا يلابُسُهُ قصرْ",32,"ر",1,0],["لَهَوتُ بِهِ وَالدَهرُ وَسنانُ ذاهِلٌ","وَغُصنُ الصِبا رَيّانُ لَدنُ المَعاطِفِ",33,"ف",1,0],["لَهَوتُ وَدونَ اِلتِماحِ الصَباحِ","ظَلامٌ سَجا وَغَمامٌ سَجَم",34,"م",1,0],["لَهَونا بِعُمرٍ طالَ حَتّى تَرادَفَت","ذُنوبٌ عَلى آثارِهِنَّ ذُنوبُ",35,"ب",1,0],["لَهُ وَجهٌ يَخِفُّ عَلى المَوالي","وَكَفٌّ لا يُؤَمِّلُها الوُفودُ",36,"د",1,0],["لَهَوتُ حَتّى راعَني غادِياً","صَوتُ أَميرِ المُؤمِنينَ المُجاب",37,"ب",1,0],["لَهَوتُ بِهِنَّ إِذ مَلَقي أَنيقٌ","يَصِرنَ لَهُ وَإِذ نَسَمي شِفاءُ",38,"ا",2,0],["له وقفة يقوى بها ثم شهقة","تكادَ لها نفس الشَفيق تذوبُ",39,"ب",1,0],["لهوى القلوب سريرةٌ لا تعلم","عرضاً نظرت وخلت أني أسلم",40,"م",1,1],["لهُ ولَعٌ بخدورِ النجومِ","إذا ما تخلَّصَ من طيفهِ",41,"ه",1,0],["لَهَوتُ بِهِنَّ بَينَ سِرٍّ وَرَشدَةٍ","ولَم آلُ عَن عَهدِ الأَحِبَّةِ خادِعا",42,"ع",2,0],["لِهَوَى الْكَوَاعِبِ ذِمَّةٌ لا تُخْفَرُ","وَأَخُو الْوَفَاءِ بِعَهْدِهِ لا يَغْدِرُ",43,"ر",1,1],["لَهْوَ اليومُ أَوْجَبَ السعدُ فِيهِ","أَنْ تُعَمَّ المَسْرَّةُ الأَصْدِقَاءَ",44,"ا",2,0],["لِهَولِ يَومٍ عَصيبٍ لا مَرَدَّ لَهُ","تَراهُمُ كَفَراشٍ فيهِ مَبثوثِ",45,"ث",1,0],["لَهَوتُ بِهِ لَهوَ التَريف بِكَأسِهِ","يُوَلّي بِتَوقيعِ المدامِ وَيَعزِلُ",46,"ل",1,0],["لَهُ وَفضَةٌ ضَمَّت نِصالاً سَنِيَّةً","عَوارِدَ تَبدو تارَةً وَتَغيبُ",47,"ب",1,0],["لَهُ وَجهانِ ظاهِرُهُ اِبنُ عَمٍّ","وَباطِنُهُ اِبنُ زانِيَةٍ عَتيقِ",48,"ق",1,0],["لهوُ الطفولة خيرُ أيامِ الفتَى","إنّ الحياةَ وكَدَحَها أوهام",49,"م",1,0],["له وجهه الفرد لا يرتدي","وجوها تغطي الوجوه القبيحه",50,"ح",2,0],["لُهوة ٌ أو فإسوة ٌ يابن يحيى","أتأسَّى بها فتُبرد لهفي",51,"ف",2,0],["لهو العيون ولا أقول قذاتها","وكل تكلّف زهوة المجتاح",52,"ح",1,0],["لَهَوْتُ بها دهراً طويلا مساعداً","على غفلةِ الواشين والشملُ جامعُ",53,"ع",1,0],["لَهَوتُ بِها لَمَّا عَنِ اللَّهوِ قَد وَنَى","سِوَاىَ فَإني عَنهُ لَستُ بِوَانِ",54,"ن",1,0],["له وجهان وجه مكفهر","ووجه معجب لك ذو ابتسام",55,"م",1,0],["لَهَوْنَا بِهَا وَنَعِمْنا بِهِ","فَكانا جَمِيعاً عِنَانَ الطَّرَبْ",56,"ب",1,0],["له وجه هلالي","إذا ما لاح في المرد",57,"د",1,0],["له وجه يحدث عنه بشر","ويروي من سماحته عطاء",58,"ا",2,0],["لَهُ وَسَجايا الناسِ لُؤمٌ وَلَكنَةٌ","فَصاحَةُ قُسٍّ في سَماحَةِ حاتِمِ",59,"م",1,0],["لَهُ وَلاءٌ غَرَسَتهُ لَدى","آبائِهِ آباؤُكَ الصيدُ",60,"د",1,0],["لَهَوتُ بِها حَتّى تَجَلّى ظَلامُهُ","تَجولُ يَدي بَينَ القَلائِدِ وَالجيدِ",61,"د",1,0],["لَهُ وَالسُحبُ مُخلِفَةٌ جِفانٌ","مُذَعذَعَةٌ وَأَفنِيَةٌ رِحابُ",62,"ب",1,0],["لهوتُ بها حتَّى قَضَى الليلُ نَحبَهُ","وأدرجَهُ المِقدارُ في كَفَنِ الفَجرِ",63,"ر",1,0],["لهوتُ وقد كانت للهوى دولةٌ","فما دَام ذاك اللهُو غير قليلِ",64,"ل",1,0],["لهَؤُلاءِ عَلَيْهِم فَضْلُ بَأسِهِمُ","وَقَد قَرَضْتَهُمْ قَتْلاً وخِلْعانا",65,"ن",2,0],["لَهُ وَرْدَةٌ حَمْراءُ فِي فِيهِ غَضَّةٌ","يُرى عادِياً مِنْها وَإِنْ كانَ لا يَعْدُوا",66,"د",3,0],["لَهُ وَمَضانُ الهِندوانِيِّ مُصلَتاً","وَهَل يُمتَرى بِالسَيفِ غَيرُ الدَمِ القاني",67,"ن",2,0],["لَهُ وَجهُ الغَزالَةِ حينَ تَبدو","ضُحىً وَفُتورُ أَلحاظِ الغَزالِ",68,"ل",1,0],["له وَهجٌ إذا وازاه طيرٌ","رماه وَلو علا في الجوّ ميلا",69,"ل",2,0],["له وجنةٌ سبحان منبت وردها","ليبدي لطيفَ الصنع في ذلك الصبغ",70,"غ",1,1],["له وجهٌ به آياتُ حسنٍ","وليس لعقد ما في الحسن فسخُ",71,"خ",1,1],["لَهَوتُ بِحَسوِ الراحِ حَتّى إِذا اِنتَهَت","إِلى مَوضِعِ الأَسرارِ قُلتُ لَها قِفي",72,"ف",2,0],["لهُ وَجْنةٌ بَلْ جَنَّةٌ زادَ حُسْنُها","عِذاراً فَصَارَتْ جَنَّةً وَحَرِيرا",73,"ر",2,0],["لَهَوا عَنِ الحَقِّ فَأَلهاهُمُ","بِزُخرُفِ القَولِ مِنَ الرَجسِ",74,"س",1,1],["لَهْوتُ بها حتّى ثنَى اللّيلُ صَدرَه","وعاد الدُّجَى بالصُّبْحِ أَدْهَم أَصبَغا",75,"غ",2,0],["لَهوْتُ بها زَماناً مِن شَبابي","وزارَتْها النَّجائِبُ والقَصِيدُ",76,"د",1,0],["لَهُ وَجه لِنَضرَتِهِ","يَكاد يَسيل رَونَقَهُ",77,"ق",2,0],["لهوتُ بسربال الشباب مُلاوة","فأصبح سربال الشباب شبارِقا",78,"ق",2,1],["لهَوْنا بها والعيش إذ ذاك ناعم","فلله عيشٌ ما أَلَذُّ وأنعما",79,"م",2,0],["لهوى الحجاز بأفق قلبي مبدأ","فلذا يعودُ ليَ الغرام ويبدأُ",80,"ا",1,1],["لهوىَ نُسك ووجوهُ الدمى","تحت دجاها لي مَحاريبُ",81,"ب",1,0],["لهوانا به والشمس في الدّجن تجتلي","كنظم حبابٍ فوق كأسٍ من الخمر",82,"ر",1,0],["لهوَ العقابُ إذا امتطاهُ لحادثٍ","يوماً فليس يصيدُ غيرَ الأصيد",83,"د",1,0],["لَهَوتُ بِهِنَّ إِذ مَلَقي مَليحٌ","وَإِذ أَنا في المَخيلَةِ وَالشَطاطِ",84,"ط",1,0],["لهوتُ بهنَّ وطرفُ الشبابِ","اليهنَّ بي نازعٌ جامحُ",85,"ح",1,0],["له وراءَ القومِ أن غلَّلُوا","في البيدِ اِشآمٌ واِعراقُ",86,"ق",1,0],["لهُ وجنة للعقول بحسنها تنتهب","يخضر فيها العذار ونارها تلتهب",87,"ب",1,0],["لَهُ وَخْزٌ بقَلْب أَخي ابْتداعٍ","شَدِيدٌ دُونَهُ وَخْزُ السِّنانِ",88,"ن",1,0],["لَهَوْتُ بِباطل الأحلامِ حتّى","ودِدْتُ لهنّ أنّ اللّيلَ طالا",89,"ل",2,0],["له وحدة ما مثلها وحدة وقد","عجبت لذات كثَّرتها صفاتها",90,"ت",3,0],["له ولهم صلى الإله مسلماً","مع الآل والأصحاب ما طائر شدا",91,"د",2,0],["لَهَوْتُ عن غَزَلٍ فيهِ بعارضةٍ","من النَّسيبِ بخَوْدٍ تَفتِنُ الأُدَبا",92,"ب",2,0],["لهوتُ فيها مُسْتَتِرَ","بِطارقٍ على حَذَرْ",93,"ر",1,0],["له وهل كان النبي إذ أمر","بأن يقيموا رجلا كما ذكر",94,"ر",1,0],["له ولم يزل له مسالمة","معترفا بفضل نسل فاطمة",94,"ه",1,0]]}