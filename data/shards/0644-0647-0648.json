296,"","https://poetry.dctabudhabi.ae/diwan/poem/103294","المتقارب"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73092","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28645","الرمل"],[4386,"","https://poetry.dctabudhabi.ae/diwan/poem/33801","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66141","الوافر"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33755","الهزج"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72515","البسيط"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76692","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139590",""],[4680,"لا لستَ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=201143",""],[4680,"لهواكِ يا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=207849",""],[4755,"سَلامٌ على ناءٍ عَنِ العَينِ كُلَّما","https://www.poetsgate.com/ViewPoem.aspx?id=184091",""],[4859,"ما كان يعلم!","https://www.poetsgate.com/ViewPoem.aspx?id=209123",""],[4914,"بمن أتداوى والدوا معك وسدوا","https://www.poetsgate.com/ViewPoem.aspx?id=170940",""],[4940,"عطر مسافر","https://www.poetsgate.com/ViewPoem.aspx?id=210500",""],[4968,"حسبي وحسبك","https://www.poetsgate.com/ViewPoem.aspx?id=206759",""],[585,"لك الله من ربحٍ عددناه مغنما","https://www.poetsgate.com/ViewPoem.aspx?id=161857",""],[5121,"رَائِعُ الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=214917",""],[5183,"عُلْيَا المَناَصِب","https://www.poetsgate.com/ViewPoem.aspx?id=186458",""],[5184,"صبرُ الزيتون","https://www.poetsgate.com/ViewPoem.aspx?id=189879",""],[5213,"لهوّن بعد اليوم ما يفعل الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=170487",""],[2365,"ألم تسألا بجنوب السلام","https://www.poetsgate.com/ViewPoem.aspx?id=200657",""],[307,"صراخ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=213646",""],[5310,"مَعْبَدُ الْقَصِيْدَةِ","https://www.poetsgate.com/ViewPoem.aspx?id=211298",""],[5320,"حى راق","https://www.poetsgate.com/ViewPoem.aspx?id=43263",""],[5338,"أخادع نفسي بالأماني الكواذب","https://www.poetsgate.com/ViewPoem.aspx?id=187713",""],[5353,"ورد الشفاه","https://www.poetsgate.com/ViewPoem.aspx?id=214831",""],[5431,"وبعض الشعر أخلطه بجمري!!","https://www.poetsgate.com/ViewPoem.aspx?id=186750",""],[5431,"هو الحبّ...","https://www.poetsgate.com/ViewPoem.aspx?id=211520",""],[5490,"وقفت بالباب","https://www.poetsgate.com/ViewPoem.aspx?id=176378",""],[5582,"ألا غَنِّنا بالعامِرِيَّةِ وَاطْرَبِ","https://www.poetsgate.com/ViewPoem.aspx?id=186673",""],[5720,"أحوال","https://www.poetsgate.com/ViewPoem.aspx?id=199858",""],[5786,"يميناً بها إن كنت للصبّ مُسعِدا","https://www.poetsgate.com/ViewPoem.aspx?id=50660",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[6031,"بكيتُكِ لو أنّ الدموع تُديلُ","https://www.poetsgate.com/ViewPoem.aspx?id=46287",""],[6093,"نَديمٌ ليس يُرضيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=176434",""],[469,"سرت زينب والبرق مبتسم الثغر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574816",""],[6191,"ما لن يكتب عنِ المسيحِ الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88108&r=&rc=6",""],[6262,"صديقي الوطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80127&r=&rc=25",""],[572,"وليلة ٍ فيها قَصُرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9293&r=&rc=150",""],[6366,"لهواك أسرارٌ وصمتك ساحرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86673&r=&rc=0",""]],"verses":[["لَهُ وِقفَةُ المِجزاعِ ثُمَّ تُجيزُهُ","حَفيظَةُ مَجموعٍ عَلى الرَوعِ شَملُهُ",0,"ل",2,0],["لَهُ وَقَفاتٌ بَالحَجيجِ شُهودُها","إِلى عَقِبِ الدُنيا مِنىً وَالمُخَيَّفُ",1,"ف",1,0],["لهُ والمُزْنُ لا يندىً جُفوناً","بَنانُ يَدٍ تُجَنُّ على السّماحِ",2,"ح",1,0],["لهُ والمَحْلُ غادَرَ كُلَّ عافٍ","يكُدُّ العيسَ مُنتَجِعاً فيُكْدي",3,"د",2,0],["لَهَوتُ بِها وَاللَيلُ أَرخى سُدولَهُ","إِلى أَن بَدا ضَوءُ الصَباحِ المُبَلَّجُ",4,"ج",1,0],["لَهُ وَجَباتٌ إِثرَ لُبنى كَأَنَّها","شَقائِقُ بَرقٍ في السَحابِ لَوامِعُ",5,"ع",1,0],["لَهوٌ كَريمٌ لَم يَشُب صَفوَهُ","رِجسٌ وَلَم يَشهَدهُ مُستَهتِرُ",6,"ر",1,0],["لَهوٌ كَما شاءَ الصِبا","وَحِجاً كَما شاءَ الحَكيمُ",7,"م",1,0],["له ولكم تحياتي","ومحمدتي وإجلالي",8,"ل",2,0],["لَهْ وَفَاءٌ لَمْ يَعْرِفْ النَّا","سُ فِي أَمَاجِيدِهِمْ عَدِيلَهْ",9,"ل",2,0],["لَهُ وَلأَعْوَانِهِ أَيُّ فَضْلٍ","عَظِيمٍ فَكُلٌّ بِحَمْدٍ قَمِينْ",10,"ن",1,0],["لَهُ واحِفٌ فَالصُلبُ حَتّى تَقَطَّعَت","خِلافَ الثُرَيّا مِن أَريكٍ مَآرِبُه",11,"ب",2,0],["لَهَوتُ بِجِنِّيٍّ عَلَيهِ سُموطُهُ","وَإِنسٌ مَجاليهِ وَأُنسٌ شَمائِلُه",12,"ل",2,0],["لَهُ وَعَلَيهِ وَقعَةٌ بَعدَ وَقعَةٍ","وَلودٌ بِأَطرافِ الأَسِنَّةِ عاقِرُ",13,"ر",1,0],["له وَقْدةٌ بين السماء وبَيْنَهُ","تُلِمُّ بها الطيرُ العَوافي فتُهرَجُ",14,"ج",1,0],["لهوتُ بها ليلاً قصيراً طويلُه","وماليَ إلّا كفُّها مُتَوَسَّدُ",15,"د",1,0],["لهوٌ أطفنا بِبكر لذَّتِه","وما فضضْنا خواتمَ العُذَرِ",16,"ر",1,0],["لهوتُ عن وصف الطلول الدارسَهْ","بروضِةِ عذراءَ غير عانسَهْ",17,"س",2,1],["لَهَوْتَ فيه بجد النَّفح واجتَنَبتْ","دعابةَ النضح نفسٌ همُّها سامي",18,"م",2,0],["لِهَوْلِ يَوْمٍ تَقَلّصَ العِلْمُ والدِّ","ينُ بِثَغْريهما عَنِ الشّنَبِ",19,"ب",1,0],["لِهونِ المالِ أَفرَشَهُ أَديماً","وَلِلتَفريقِ يَكرَهُ أَن يَضيعا",20,"ع",2,0],["لِهَوى النُفوسِ سَريرَةٌ لا تُعلَمُ","عَرَضاً نَظَرتُ وَخِلتُ أَنّي أَسلَمُ",21,"م",1,1],["لَهَوتَ عَنِ الفَناءِ وَأَنتَ تَفنى","فَما شَيءٌ مِنَ الدُنيا يَدومُ",22,"م",1,0],["لَهَونا لَعَمرُ اللَهِ حَتّى تَتابَعَت","ذُنوبٌ عَلى آثارِهِنَّ ذُنوبُ",23,"ب",1,0],["لَهَوتَ وَكَم مِن عِبرَةٍ قَد حَضَرتَها","كَأَنَّكَ عَنها غائِبٌ حينَ تَحضُرُ",24,"ر",1,0],["لَهَونا وَالحَوادِثُ واثِباتٌ","لَهُنَّ بِمَن قَصَدنَ إِلَيهِ فَتكُ",25,"ك",1,0],["لَهُ وَفاءٌ وَلَهُ عَزمَةٌ","تَأوي إِلى أَكنافِ أَظلالِهِ",26,"ل",2,0],["لَهَوتَ عَنِ الفَناءِ وَأَنتَ تَفنى","وَما حَيٌّ عَلى الدُنيا يَدومُ",27,"م",1,0],["لَهَوتُ عَن مَدحِ أَهلِ الأَرضِ مُرتَفِعاً","عَنهُم وَعَضبُ لِساني غَيرُ ذي فَلَلِ",28,"ل",1,0],["لَهُ وَجهٌ يَعَزُّ بِهِ","وَلي حُرَقٌ أَذَلُّ بِها",29,"ه",2,0],["لَهُ وَجهٌ إِذا أَبصَر","تَهُ ناجاكَ عَن عُذرِ",30,"ر",1,0],["لَهُ وَقعَةٌ كانَت سَدىً فَأَنَرتَها","بِأُخرى وَخَيرُ النَصرِ ما كانَ مُلحَما",31,"م",2,0],["لهُ وجنةٌ محمرَّةٌ وذوائبٌ","طوالٌ وعنقٌ لا يلابُسُهُ قصرْ",32,"ر",1,0],["لَهَوتُ بِهِ وَالدَهرُ وَسنانُ ذاهِلٌ","وَغُصنُ الصِبا رَيّانُ لَدنُ المَعاطِفِ",33,"ف",1,0],["لَهَوتُ وَدونَ اِلتِماحِ الصَباحِ","ظَلامٌ سَجا وَغَمامٌ سَجَم",34,"م",1,0],["لَهَونا بِعُمرٍ طالَ حَتّى تَرادَفَت","ذُنوبٌ عَلى آثارِهِنَّ ذُنوبُ",35,"ب",1,0],["لَهُ وَجهٌ يَخِفُّ عَلى المَوالي","وَكَفٌّ لا يُؤَمِّلُها الوُفودُ",36,"د",1,0],["لَهَوتُ حَتّى راعَني غادِياً","صَوتُ أَميرِ المُؤمِنينَ المُجاب",37,"ب",1,0],["لَهَوتُ بِهِنَّ إِذ مَلَقي أَنيقٌ","يَصِرنَ لَهُ وَإِذ نَسَمي شِفاءُ",38,"ا",2,0],["له وزائد ماضي الغرار كأنه","هلال بدا في ظلمة الليل ناحل",39,"ل",1,0],["له وقفة يقوى بها ثم شهقة","تكادَ لها نفس الشَفيق تذوبُ",40,"ب",1,0],["لَهَوْتُ بِهَا والدَّهْرُ ضَافٍ قِنَاعُهُ","عَلَيْنَا ولَمْ يَقْطَعْ لَنَا كَاشِحٌ حَبْلاَ",41,"ل",2,0],["لهوى القلوب سريرةٌ لا تعلم","عرضاً نظرت وخلت أني أسلم",42,"م",1,1],["لهُ ولَعٌ بخدورِ النجومِ","إذا ما تخلَّصَ من طيفهِ",43,"ه",1,0],["لَهَوتُ بِهِنَّ بَينَ سِرٍّ وَرَشدَةٍ","ولَم آلُ عَن عَهدِ الأَحِبَّةِ خادِعا",44,"ع",2,0],["لِهَوَى الْكَوَاعِبِ ذِمَّةٌ لا تُخْفَرُ","وَأَخُو الْوَفَاءِ بِعَهْدِهِ لا يَغْدِرُ",45,"ر",1,1],["لَهْوَ اليومُ أَوْجَبَ السعدُ فِيهِ","أَنْ تُعَمَّ المَسْرَّةُ الأَصْدِقَاءَ",46,"ا",2,0],["لِهَولِ يَومٍ عَصيبٍ لا مَرَدَّ لَهُ","تَراهُمُ كَفَراشٍ فيهِ مَبثوثِ",47,"ث",1,0],["لَهَوتُ بِهِ لَهوَ التَريف بِكَأسِهِ","يُوَلّي بِتَوقيعِ المدامِ وَيَعزِلُ",48,"ل",1,0],["لَهُ وَفضَةٌ ضَمَّت نِصالاً سَنِيَّةً","عَوارِدَ تَبدو تارَةً وَتَغيبُ",49,"ب",1,0],["لَهُ وَجهانِ ظاهِرُهُ اِبنُ عَمٍّ","وَباطِنُهُ اِبنُ زانِيَةٍ عَتيقِ",50,"ق",1,0],["لهوُ الطفولة خيرُ أيامِ الفتَى","إنّ الحياةَ وكَدَحَها أوهام",51,"م",1,0],["له وجهه الفرد لا يرتدي","وجوها تغطي الوجوه القبيحه",52,"ح",2,0],["لُهوة ٌ أو فإسوة ٌ يابن يحيى","أتأسَّى بها فتُبرد لهفي",53,"ف",2,0],["لهو العيون ولا أقول قذاتها","وكل تكلّف زهوة المجتاح",54,"ح",1,0],["لَهَوْتُ بها دهراً طويلا مساعداً","على غفلةِ الواشين والشملُ جامعُ",55,"ع",1,0],["لَهَوتُ بِها لَمَّا عَنِ اللَّهوِ قَد وَ