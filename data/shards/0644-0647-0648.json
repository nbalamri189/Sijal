َريقُ",186,"ق",1,1],["له ولك البشرى بمين زفافه","قران خلود في سعود مدى الدهر",187,"ر",1,0],["لَهَوت بِقُدس الهَوى في القُلوب","وَأَنكَرت هَيمَنة المُستَبد",188,"د",1,0],["له وطري وله لذَّتي","على الكأس والكأسُ لا تحضُرُ",189,"ر",1,0],["لهُ وهو مملوكٌ تحكُّمُ مالكٍ","كما هو ظبيٌ فيه صولةُ ضَيغمِ",190,"م",1,0],["لَهَوى في مَنخر يَس","تَغرِقُ الخَلقَ بِنِصفِهْ",191,"ف",2,0],["لَهُ وَجَناتٌ في بَياضٍ وَحُمرَةٍ","فَحافاتُها بيضٌ وَأَوساطُها حُمرُ",192,"ر",1,1],["لَهَوْنا عنْ نُضُوبِ المجدِ فينا","فاسْلَمَنا الى الهُلْكِ النُّضُوبُ",193,"ب",1,0],["لهُ وردٌ على الوجن","ةِ ممنوعٌ من القَطفِ",194,"ف",1,0],["له وقار به جلال","له جلال به وقار",195,"ر",1,0],["له وان كان أخفاه السرار سنىً","مثل الصياح به تجلى الدجنات",196,"ت",1,0],["لهواها وهب الروح وذا","كان في أهل الهوى مصطلحا",197,"ح",2,0],["لهواكَ ماضٍ كالوعود عشقتهُ","واليوم أكره كلّ ذاكَ الماضيا",198,"ي",2,0],["لهواكِ يا بغداد فيض قصائدي","ولكلّ مغوارٍ أبيٍّ صامدِ",199,"د",1,1],["لَهُ واحَةٌ في القَلبِ كَم مِن نَوَافِذٍ","عليها وأبوابٍ يُسَائِلْنَ أَينَ هُوْ؟!",200,"ن",3,0],["له وما لسوى عينيه قد بزغَتْ","شمسُ الشعورِ وحرفٌ طال مغربُه",201,"ب",2,0],["له وإليه الفضل عودا وبدؤه","وفيه ومنه الفخر ينمى ويوجد",202,"د",1,0],["‏لهواكَ نكهته الفريدة في فمي،","ليست كفاكهة البساتينِ",203,"ن",1,1],["لِهَوَاكَ فِي الوِجْدَانِ خَيْرُ تَفَتُّحٍ","كَالوَرْدِ قَدْ مَسَّ الربِيعَ وَمَاذَوَى",204,"و",2,0],["لهونا به فاستدرج الناس أمرنا","إليه وظنوا المال دام وديما",205,"م",2,0],["لَهُ وَزْنٌ مِنَ الكَلَامِ وَثُقْلِي","طَارَ رِيشاً مَعَ الْبَدِيعِ اخْتَزَالَا",206,"ل",2,0],["له وثبات يشهد الله أنها","تواصل تسيار الضحى بالمغارب",207,"ب",1,0],["لهُ وجه مهمومٍ تكسر ليله","شظايا مِنْ الشكوى تعيرُ الفضا سمعا",208,"ع",2,0],["لهوّن بعد اليوم ما يفعل الدهر","اذا احمد بالموت غيبه القبر",209,"ر",1,1],["لهوت بهن بلا ريبة","وشعب الهوى بيننا ملتئم",210,"م",1,0],["لهوٌ ولعبٌ وتلفازٌ ومدرسةٌ","هي الطفولة لا همٌ ولا وجمُ",211,"م",1,0],["لهوا قد انْشغلوا كلٌّ لغايتهِ","عنّي ولمْ أنشغلْ يوماً فهل علموا ؟",211,"م",3,0],["لَهُوَ الْجَدِيرُ بِرَسْمِ حُسْنَكِ وال