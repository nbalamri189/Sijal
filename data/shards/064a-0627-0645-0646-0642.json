81",""],[307,"الرحيل الى الله تعالى","https://www.poetsgate.com/ViewPoem.aspx?id=213747",""],[5410,"الصبر من صبري اشتكى","https://www.poetsgate.com/ViewPoem.aspx?id=141974",""],[5442,"آن التأهب للرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=114779",""],[5442,"يامن إليه بعزه اتشفع","https://www.poetsgate.com/ViewPoem.aspx?id=114749",""],[5497,"لوعةً وتحسرا","https://www.poetsgate.com/ViewPoem.aspx?id=206253",""],[5523,"وقفات","https://www.poetsgate.com/ViewPoem.aspx?id=201355",""],[5690,"للعدل والإصلاح أنت كفيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=172177",""],[5736,"راتب","https://www.poetsgate.com/ViewPoem.aspx?id=208483",""],[5794,"مهد حمرين","https://www.poetsgate.com/ViewPoem.aspx?id=80289",""],[5851,"الوطن المسافر","https://www.poetsgate.com/ViewPoem.aspx?id=175286",""],[5956,"يا من رددتَ عليّ بعد شهور","https://www.poetsgate.com/ViewPoem.aspx?id=192993",""],[5956,"من بعد دعمك حاجتي يا مسلمُ","https://www.poetsgate.com/ViewPoem.aspx?id=194143",""],[5956,"في قاع نفسي حبكم مرصودُ","https://www.poetsgate.com/ViewPoem.aspx?id=194626",""],[5974,"غوصي بأعماق النياط","https://www.poetsgate.com/ViewPoem.aspx?id=214894",""],[6070,"المشيب","https://www.poetsgate.com/ViewPoem.aspx?id=188466",""],[6070,"يامنْ قَضَيْتَ سنينَ العُمْرِ في الضَّجرِ","https://www.poetsgate.com/ViewPoem.aspx?id=197522",""],[6127,"صوتك النور","https://www.poetsgate.com/ViewPoem.aspx?id=191300",""],[5724,"قف يا زمان معي بالله وانتحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55151&r=&rc=18",""],[5464,"يا منقذي من وحول العار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=490&r=&rc=4",""]],"verses":[["يَا مُنْقِذاً جَاءَ بَعْدَ الأَلْفِ مِنْ حِجَجٍ","يُعِيدُ مَا فَاتَ مِنْ مَجْدٍ وَمِنْ حَسَبِ",0,"ب",1,0],["يا مَن قضى بين المياة غريقا","أذكى فراقك في القلوب حريقا",1,"ق",2,1],["يا من قسا لمّا شكو","تُ إلى تطوّله زماني",2,"ن",2,1],["يا مَن قَرُبتَ مِنَ الفُؤادِ","وَأَنتَ عَن عَيني بَعيد",3,"د",1,1],["يا من قوافينا مخافةَ نَقْدِهِ","خَلُصَتْ منَ التَنقيحِ وَالتَهذيبِ",4,"ب",1,0],["يا مُنْقِذَ الضُّعفاءِ من آلامِهم","أُمَمُ البسيطةِ كلُّها آلامُ",5,"م",1,0],["يا من قتلتَ شبابي في يفاعته","ورحتَ تسخرُ من دمعي وأناتي",6,"ت",2,0],["يَا مَنْ قَضَى عَنْ عَظِيمِ شَأْنٍ","فُزْ بِجَزَاءٍ لَهُ وِفَاقِ",7,"ق",1,0],["يا من قطعتم ولم نقطع مودتكم","يا من نسيتم ولم ننس الذي كانا",8,"ن",2,0],["يا مَن قَواضِبُهُ تُشايِعُ عَزمَهُ","وَلِأَجلِ ذاكَ تَصِلُّ حينَ يَصولُ",9,"ل",1,0],["يا من قضيت بما نكابده","هلا أردت لشملنا جمعا",10,"ع",2,0],["يا مُنقِذي بِنَوالِهِ","وَالسَيلُ قَد بَلَغَ الزُبا",11,"ب",2,0],["يا منقذ الخلق من نار الجَحيم وَهم","عَلى شفا جرف هار بمهنار",12,"ر",1,0],["يا منقذَ العربِ والإسلامِ إنهما","تحت اضطهادِ شعوبِ الأرض قد رزحا",13,"ح",2,0],["يا مَنْ قصدتُ عليه في الإِخا أَملي","أَصبحتُ بعدك في الدنيا بلا أَمل",14,"ل",1,0],["يا مَن قَدِ اِتّفقت عَلى تصريفه ال","كلماتُ بالتجريبِ والتقسيسِ",15,"س",1,0],["يا مُنقِذاً خليلَه حينَ اِلتَجا","مُحتَسِباً إلَيهِ من كَيد العِدا",16,"ا",1,0],["يا مُنقِذاً ذا النُون مِن غَمٍّ نَما","في ظُلُمات البَحر لَمّا أَن دَعا",16,"ا",1,0],["يا مُنْقِذَ الدَّولةِ اسمعْ قولَ ذي مِقَةٍ","صفَتْ فلا رِيَبٌ فيها ولا ظِنَن",17,"ن",1,0],["يا مَن قَدِمْتُ على مأْنوسِ حَضْرتِه","بعد المَغيبِ وحُرُّ المَدْح من تُحَفي",18,"ف",2,0],["يا مُنقِذي ويدُ الزَّمانِ تَنُوشُني","ومُقيلَ جَدّي وهْو كابٍ عاثِرُ",19,"ر",1,1],["يا من قصَرتُ العمرَ في ظله","ورفِده أرتعُ أو أستنيمْ",20,"م",1,0],["يا مَن قَليبُ إِخائِهِ","صافٍ بِلا كَدَرِ اِنقِلابِ",21,"ب",1,1],["يا من قهرْتَ الأوَّلي","نَ بنسقِ شأنٍ من قَضائِكْ",22,"ك",1,0],["يا مَنْ قَضَى بِفِراقِنا أرْجكَ أَنْ","يَأَتِي لَنا بَعْدَ الْفِراقِ وِفاقُ",23,"ق",1,0],["يا مَن قضَى اللهُُ أن يَرمشي بِه سفرٌ","إياكَ إياكَ قُرب المطعَم البلَدي",24,"د",2,0],["يا منْ قُرِنتُ به على","رغمي فصرتُ له قرينا",25,"ن",2,1],["يا مَنْ قضاياهُ في الأَيَّام عادلةٌ","أَفْنَيْتَ بالعَدْلِ أَهْل الشِّركِ والأَشَرِ",26,"ر",1,0],["يا مَنْ قَضَى بعذابِي","ومِحنتي واكْتآبي",27,"ب",2,1],["يا من قضى الإسلام لما أن قضى","لا كان يومك في قضايا كوني",28,"ن",2,1],["يَا مَنْ قَصدْتُ منَار كعبة بَيْته","وسَعَيْتُ فِيمَنْ حَجَّ بَيْتَك واعْتَمَرْ",29,"ر",1,0],["يا من قضى فقضى سروري بعده","وبقيتُ موقوفاً على الأحزانِ",30,"ن",1,1],["يا منقذ المضطر يا عبد الا","له ومصطفاه فمثلكم لم يوجد",31,"د",1,0],["يا مَن قَد اِشتَرو الضَلالة بِالهُدى","وَاِستَبدَلوا الإِصلاح بِالإِفساد",32,"د",1,0],["يا من قضيت حقوقاً","لمصر ليست تُعدُّ",33,"د",1,0],["يا مَن قشع الصغير وهو في تخته","قد شخ بسيل يُرى من تحته",34,"ه",1,1],["يا منقذي من الليالي بعد ما","كادت عوادي صَرفها تؤذيني",35,"ن",2,0],["يا منقذي من زمن صروفه","ما برحت تعركني عرك الأَدم",36,"م",1,0],["يا منقذي من جور دهر غاشم","كان لعظمي بالخطوب عارقا",37,"ق",2,0],["يا منقذي من نوائبٍ بلغت","مني نيوب لها وأظفار",38,"ر",1,0],["يا منقذي من جور دهر خلته","بالظلم كان مطالبي بِحُقُود",39,"د",1,0],["يا منقذي من جور دهري بعدما","قد كنت رهن حوادث الأيام",40,"م",1,0],["يا منقذي من صَرْف دهر يرى","نصره أهل الفضل خذلانا",41,"ن",2,0],["يا من قد آثر هجراني","وعليَّ بلقياهُ استأثر",42,"ر",1,0],["يا من قد أنكر من آيا","تِ أبي حسنٍ ما لا يُنكَر",42,"ر",1,0],["يا منقذ الأحكام بعدك لم يكن","في الناس للأحكام من نقاد",43,"د",1,0],["يا من قنعت بكتبه متعللاً","كتعلل الساري بنجم ظلامه",44,"م",2,0],["يا من قضى نومي من بعدهم","وخانني صبرى وسلواني",45,"ن",2,1],["يا منقذ الشعب من نار مسعرة","من يمسس النار لا ينجو من النار",46,"ر",1,0],["يا منقذ النيل لا ينسى لك النيل","يدا لها من فمِ الاصلاح تقبيل",47,"ل",1,1],["يا مُنقِذَ المظلوم من عثراتهِ","هل كنت إلّا بدر مصر السارِيا",48,"ي",2,0],["يا مُنَقّى النِفوسِ مِن كُلِّ شَرٍّ","بعد ما أَخلَدت إِلى الطُغيان",49,"ن",1,0],["يا مَن قَطَعتُم عَن المَنى رَسائِلُكُم","لَم نَعتَقِد بَعدُكم اِلّا الوَفاء لَكُم",50,"م",1,0],["يا مَن قَد دامَ لهُ شَرَفاً","بِمَقام جَلَّ عَن الشُهُبِ",51,"ب",1,1],["يا من قد أغرق في عذلي","ماذا ترجو فاترك أجدر",52,"ر",1,0],["يا من قصير عمرها","لم يأت طيفك في المنام",53,"م",1,0],["يا مُنقَذَ القُدسِ مِن أَيدي جَبابِرَةٍ","قَد أَقسَموا بِذِراعِ الرَبِّ تَدخُلُهُ",54,"ل",2,1],["يا من قد اجتلت الرغائب سهلةً","ودم الخلائق بات غاير ممار",55,"ر",1,0],["يا من قفا أصله وخيمه","في همةِ الأنفسِ الفخيمه",56,"م",2,1],["ي