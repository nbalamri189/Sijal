https://poetry.dctabudhabi.ae/diwan/poem/146758","الطويل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146757","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133138","الوافر"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/141098","المنسرح"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72514","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120534","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139646",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139729",""],[4691,"من الفاتنات خرافية","https://www.poetsgate.com/ViewPoem.aspx?id=137560",""],[4691,"مشيتِ على قلبي أيحسدني الرمل","https://www.poetsgate.com/ViewPoem.aspx?id=185442",""],[4729,"مَنْ النافِضُ البيداءَ، والليلُ دَامسٌ","https://www.poetsgate.com/ViewPoem.aspx?id=109433",""],[4755,"لِدَارِ الأَسَى بَابَانِ.. عالٍ, وهابِطُ","https://www.poetsgate.com/ViewPoem.aspx?id=198745",""],[4767,"غريب تناجيب","https://www.poetsgate.com/ViewPoem.aspx?id=88151",""],[4935,"ملك الجمال اليوسفي السامي الاغن","https://www.poetsgate.com/ViewPoem.aspx?id=129502",""],[5002,"شفيع الأمّةِ","https://www.poetsgate.com/ViewPoem.aspx?id=202586",""],[5145,"سقى السرح من وادي الآراك هطول","https://www.poetsgate.com/ViewPoem.aspx?id=108051",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5341,"أخافُ","https://www.poetsgate.com/ViewPoem.aspx?id=185802",""],[137,"معركة الارك","https://www.poetsgate.com/ViewPoem.aspx?id=12753",""],[5587,"في القلب حزن","https://www.poetsgate.com/ViewPoem.aspx?id=200142",""],[5956,"هذه الدعابة","https://www.poetsgate.com/ViewPoem.aspx?id=193426",""],[6070,"الذهب","https://www.poetsgate.com/ViewPoem.aspx?id=187777",""],[6152,"أدب المواساة","https://www.poetsgate.com/ViewPoem.aspx?id=206617",""],[566,"بكيت والمحتزن البكي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=507632",""],[4222,"سواك لسهم العلى لن يريشا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52809&r=&rc=101",""],[6367,"أشواق حجازية الإيقاع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80598&r=&rc=1",""]],"verses":[["منَ النَّفَرِ الإِلى نَقَصَ المُسامي","غَداةَ رأى مَساعِيَهُمْ وزادوا",0,"د",3,0],["مِنَ النَّفَرِ البيضِ الإِلى تَعْتَري العُلا","إلَيْهِمْ بيَومَيْ نائِلٍ وطِعانِ",1,"ن",1,0],["منَ النَّفَرِ الوضّاحِ والسّادَةِ الأُلى","يُغيثونَ في الجُلّى ويوفونَ بالعَهْدِ",2,"د",1,0],["مِنْ آلِ نَصْرٍ مِنْ ذُؤَابَةِ خَزْرَجٍ","قَوْمٌ هُمُ الأَنْصَارُ والأَصْحَابُ",3,"ب",1,0],["مِنَ النَعَمِ الَّتي كَحِراجِ إيلٍ","تَحُشُّ الأَرضَ شيماً أَو هِجانا",4,"ن",2,0],["مِنَ النفَرِ البيضِ الَّذينَ وُجوهُهُم","دَنانيرُ شيفَت مِن هِرَقلٍ بِرَوسَمِ",5,"م",1,0],["مِنَ النُّفُوسِ اللَّوَاتِي لاَ يَجُودُ بِهَا","لِطْفُ الْعِنَايَةِ إِلاَّ فِي مَدَى حُقَبِ",6,"ب",1,0],["مِنَ النُّهَى سُمْرُهَا الَّتِي اشْتَبَكَتْ","وَالبِيضُ مَشْهُورُهَا وَمَغْمَدُهَا",7,"د",3,0],["من النظم لولا وجود معنٍ رأيته","هنالك ما لاقيتُ لفظاً ولا معنى",8,"ن",2,0],["مِنَ النَفَرِ الغُرِّ الَّذينَ حُلومُهُم","يَخِفُّ لَدَيها يَذبُلٌ وَيُلَملَمُ",9,"م",1,0],["مِنَ الناعِماتِ الراوِياتِ مِنَ الصِبا","ذَوَت بَينَ حِلٍّ في البِلادِ وَتَرحالِ",10,"ل",1,0],["مِنَ النارِ لَكِنَّ أَطرافَها","تَدورُ بِياقوتَةٍ لَن تَبيد",11,"د",1,0],["مِنَ النارِ لَكِنَّ أَنوارَها","إِلَهِيَّةٌ زُيِّنَت لِلعَبيد",11,"د",1,0],["من الناس من لم يكن عارفاً","بسر الطريق وأحواله",12,"ل",2,1],["مِنَ النيلِ إِذ عَمَّ المَنارَ غُثاؤُهُ","وَمَن يَأتِهِ مِن راغِبٍ فَهوَ أَسعَدُ",13,"د",1,0],["مِنَ الناكِثينَ العَهدَ مِن سَبَئيَّةٍ","وَإِمّا زُبَيرِيٍّ مِنَ الذِئبِ أَغدَرا",14,"ر",2,0],["مِنَ الناسِ إِلّا فاسِدَ العَقلِ شارَكَت","بِهِ العَجزَ حَولاً أُمُّهُ وَهوَ مُرضَعُ",15,"ع",1,0],["مِنَ الناسِ باغٍ أَو عَزيزٌ مَكانَهُ","إِذا عُطِفَت شُبّانُها وَكُهولُها",16,"ل",3,0],["مِنَ الناسِ إِلّا مِن قُرَيشٍ وَدارِمٍ","إِذا سَبَقَ الأَيدي القِصارَ طِوالُها",17,"ل",3,0],["مِنَ الناسِ إِلّا أَنَّ نَفسي تَعَلَّقَت","إِلى أَجَلٍ حَتّى يَجيءَ مُصابُها",18,"ب",3,0],["مِنَ الناسِ مَيتٌ وَهوَ حَيٌّ بِذِكرِهِ","وَحَيٌّ سَليمٌ وَهوَ في الناسِ مَيِّتُ",19,"ت",1,1],["مِنَ النَكباتِ الناكِباتِ عَنِ الهَوى","فَمَحبوبُها يَحبو وَمَكروهُها يَعدو",20,"د",2,0],["مَنَّ النبيُّ عليها ثم أكرمَها","في مشهدٍ كُلِّهِ مَنٌّ وإكرامُ",21,"م",1,0],["مِنَ النَّفرِ المساميحِ العُدولِ","صَدقْتُكَ ليس كالنّورِ الظّلامُ",22,"م",1,0],["مِنَ النفرِ الأُلَى صَلُّوا وصَاموا","لِواءُ أبي رُوَيْحَةَ ما أعزّا",22,"ز",2,0],["مِنَ النَفَرِ المُرعي عَدِيّاً رِماحُهُم","عَلى الهَولِ أَكنافَ اللِوى فَأَبانِ",23,"ن",1,0],["مِنَ النارِ وَالقُربانِ وَالمِحَنِ الَّتي","لَها اِستَسلَموا حُبَّ العُلى المُتَكامِلِ",24,"ل",1,0],["مِنَ الناسِ مَن لَفظُهُ لُؤلُؤٌ","يُبادِرُهُ اللَقطُ إِذ يُلفَظُ",25,"ظ",1,1],["مِنَ النِسوَةِ اللاّتِي إذَا تَلَعَ الضُحَى","تَبَوَّأنَ مَبدًى مِن ثُمَالَ وَمَحضَرا",26,"ر",2,0],["من الناس من إن غبت عنه فإنه","عدوّ وإن لاقيته فصديق",27,"ق",1,0],["من الناس مَن يدري وَلَيسَ بقائلٍ","حذاراً ومنهم من يقول ولا يدري",28,"ر",2,0],["من النوابغ أعماراً إِذا قصرتْ","مُدَّ النبوغُ لهم في الخلدِ أعمارا",29,"ر",2,0],["مِنَ النَّفَرِ الْغُرِّ الَّذِينَ سُيُوفُهُمْ","لَهَا فِي حَوَاشِي كُلِّ دَاجِيَةٍ فَجْرُ",30,"ر",1,0],["مِنَ الناسِ مَنْ لاَ يُطيقُ الخُطُوبِ","فَيَسْقُطُ مِنْ تَلَفٍ فِي تلَفْ",31,"ف",1,0],["مِن آلِ نَحَّاسٍ وَنِعْمَ","العُنْصُرِ الثَّانِي لِوَلْدِكْ",32,"ك",1,0],["مِن النِّشءِ الَّذِي عَنْ نَبْعَتِيهِ","يُجَدِّدُ لِلْحِمَى فَخْراً أَثِيلاَ",33,"ل",2,0],["مِنْ النَّفَرِ الأُوْلَى عَاشَوا كِرَاماً","وَبَرُّوا فِي الشَّهَادَةِ وَالمَغِيبِ",34,"ب",1,0],["مِنَ النَفَرِ الغُرِّ الَّذينَ وُجوهُهُم","مَصابيحُ في الظَّلماءِ بَل هِيَ أَصبَحُ",35,"ح",1,0],["مَنِ الناعبُ قبل الفجرِ","من هذا على البابِ",36,"ب",1,1],["من النفر الوضاح السادة الأولى","يغيثون في الجلى ويوفون بالعهد",37,"د",1,0],["من النوابغ أعمارا إذا قصرت","مدّ النبوع لهم في الخلد أعمارا",38,"ر",2,0],["من النّفَرِ البِيضِ الذينَ إذا انتجَوْا","أَقرَّتْ لِنَجْوَاهُمْ لؤيُّ بنُ غالِب",39,"ب",1,0],["من الناكة بعدَ الهُدوّ مثلُ زبونه","يرهُق الناسَ في اقتضاءِ ديونه",40,"ن",2,0],["مِنَ النَّبْتِ إِلاَّ فِي أَوانِ جَنَى الحَقْلِ","فلَمْ يَكُ فِي لَيْلَى سِوَى مَا يُحَبِّبُ",41,"ب",1,0],["مِنْ النَّفَرِ الأُلَى عَاشَوا كِرَاماً","وَبَرُّوا فِي الشَّهَادَةِ وَالمَغِيبِ",42,"ب",1,0],["من النفر الغر الذين ودادهم","لدى القصد عند الله خير الوسائل",43,"ل",1,0],["من النيراتِ الزهرِ ضوءاً ورفعَةً","وإن لم يسموها سماكاً ولا نسرا",44,"ر",2,0],["مِنَ النورِ ما بَينَ الأَنامِ مُصَوَّرٌ","صَفيٌّ نَجيٌّ مُصطَفىً مُتَخَيَّرٌ",45,"ر",1,0],["مَنَ الناسِ إِلّا شَفَّها الرُعبُ وَالحُبُّ","أَلا إِنَّ مَولاهُ أَرادَ اِصطِناعَهُ",46,"ه",1,0],["من النكر تصديق امرئ غير مرسل","أتى بغريب حل ما هو أغرب",47,"ب",1,0],["مِنَ النَفَرِ الغُرِّ الأُلى عُرِفَت لَهُم","خِفافُ المَذاكي وَالحُلومُ الرَواجِحُ",48,"ح",1,0],["مِنَ النَّاسِ حَتَّى تَزِيغَ عقُولُنا","وَيَخلِطنَ مَطلاً ظاهراً بِلَيانِ",49,"ن",1,0],["مِنَ النَّاسِ إنسانانِ دَينى عليهما","مَلِيّانِ لَو شاءا لَقَد قَضَيَانِى",50,"ن",2,0],["مِن آلِ نابُلُسِي الأَمجادِ مُرتَحِلٌ","وَلّى فَذابَت عَلى آثارِهِ المُهَجُ",51,"ج",1,1],["من النفرِ الَّذين هُم","ضحىً والناسُ أَدْجان",52,"ن",1,0],["من النفر الغُرِّ ممّن تَرَوْن","خيارَ البرايا وأَبدالها",53,"ل",3,0],["مَنِ الناشِدُ لي في الرَك","بِ قَلباً أَسرًا لرَكبُ",54,"ب",1,0],["من النّاعباتِ المشيّ نَعباً كأنّما","يُناطُ بِجذعٍ من أوالٍ جريرِها",55,"ر",3,0],["مِن النَفرِ الَّذين إِذا تَحلّوا","أَعادوا اللَيلَ أَحلا مِن صَباحِ",56,"ح",1,0],["من النيابَتين دعاك لما","تَولى العمر وانقطع الرَجاء",57,"ا",2,0],["من النَّفَر الغُرّ الأُلى عمَّتِ الورى","صنائعُهم في كلّ غرب ومشرقِ",58,"ق",1,0],["مِنَ النّاقِدِينَ الْعاقِدِينَ عَنِ الْخَنا","مَآزِرَهُمْ وَالسّالِمِينَ عَلَى النَّقْدِ",59,"د",1,0],["من الناس من مات موت السوام","وليس له خبر يسمَع",60,"ع",1,0],["من النَفر الغرِّ الَّذين بمجدهم","تأَيَّد أَزرُ المجد واِشتدَّ كاهلُه",61,"ل",2,0],["مِنَ النَبِيينَ إِذ جاءَت وَلَم تَدُمِ","حَلَّت فَجَلَت لَدى الأَقوالِ عَن شِبهِ",62,"ه",1,0],["مِنَ النَبِيِّ وَلا حَبلي بِمُنصَرِمِ","كَما أُؤَمِّلُ في جَدواهُ تَحلِيَتي",62,"ي",1,0],["مِنَ النَيِّ حَتّى اِستَحقَبَت كُلَّ مِرفَقٍ","رَوادِفَ أَمثَالِ الدِلاءِ تَنَعنَعُ",63,"ع",1,0],["من النّ