{"poems":[[74,"أحمد الله كم أجود في الخلق","https://www.aldiwan.net/poem19629.html","الخفيف"],[93,"كل ميت مهما علا في حياته","https://www.aldiwan.net/poem8780.html","عموديه"],[230,"إن سئمت الحياة فارجع إلى الأرض","https://www.aldiwan.net/poem55107.html","الكامل"],[310,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54065","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20387","الخفيف"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28609","الرمل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60872","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204587","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132743","الرمل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118001","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83167","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72584","الرمل"],[4844,"إن نيل الحياة غير سعود","https://www.poetsgate.com/ViewPoem.aspx?id=181453",""],[4935,"هذي صفات بر تقي إنسانها","https://www.poetsgate.com/ViewPoem.aspx?id=129534",""],[5136,"أرأيت أية أزمة بالمغرب","https://www.poetsgate.com/ViewPoem.aspx?id=121521",""],[5358,"الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=21884",""],[5463,"الموت واقع لا محاله","https://www.poetsgate.com/ViewPoem.aspx?id=34049",""],[5531,"أذكريني يامنيتي","https://www.poetsgate.com/ViewPoem.aspx?id=128418",""],[5628,"حديث العشق","https://www.poetsgate.com/ViewPoem.aspx?id=178443",""],[5818,"اعلمي","https://www.poetsgate.com/ViewPoem.aspx?id=182814",""],[6102,"كلميني","https://www.poetsgate.com/ViewPoem.aspx?id=184858",""],[6127,"يا ثورة الآس","https://www.poetsgate.com/ViewPoem.aspx?id=205889",""]],"verses":[["كلمي في الأنامِ سحر ولكن","أنا والسحر باطل بطَّال",0,"ل",1,0],["كُلُّ مَيتٍ مَهما عَلا في حَياتِهِ","كُلُّ ثاوٍ تَحتَ الثَرى مِن لِداتِه",1,"ت",2,1],["كلُّ مَيتٍ باقٍ وَإن خالَفَ العُن","وانُ ما نُصَّ في غُضونِ الكِتابِ",2,"ب",1,0],["كلمٌ يفوتُ بيانُها سَبقا إلى ال","أَذهانِ مَسراها إلى الآذانِ",3,"ن",1,0],["كل ميتٍ ببسطةٍ فهو يحوي","ما انتقاه طول الحياة وحازهْ",4,"ز",2,0],["كلم يقُم زيد وذا لا يشتبه","وفي التواقيع كثيراً جيء به",5,"ه",1,0],["كُلُّ مَيِّتٍ قَد اِغتَفَرتُ فَلا أَو","جَعُ مِن والِدٍ وِمِن مَولودِ",6,"د",1,0],["كُلُّ مَيّاسٍ جَرَت أَعطافُهُ","وَعَواليهِ عَلى حُكمِ التَّثنِّي",7,"ن",2,0],["كلِمي جوهرٌ وأنت لعَمريْ","جوهر الأصل جَوْهريّ الطباعِ",8,"ع",1,0],["كلميني ثم اصعقيني كموسى","أنا حسبي منك البيان الفصيح",9,"ح",1,0],["كل مياس يهز","التيه والدّل قوامه",10,"م",2,0],["كلَم يَفُوا إلا امرُؤٌ إِلا عَلِى","وَحُكمُهَا فِى القَصدِ حُكمُ الأوَّل",11,"ل",1,0],["كلم يقدمها المسيء الجاني","لذوي المعارف لا ذوي التيجان",12,"ن",1,1],["كَلِمٌ يُؤَلِّفُ بَينَ مُفتَرِق الهَوى","ما أَبعَدَ السكسُونَ عَن قَحطانِ",13,"ن",1,0],["كلميني يا حميرا","وأرحنا يا بلال",14,"ل",1,0],["كل ميتٍ قد اغتفرت فلا وا","جع من والدٍ ومن مولود",15,"د",1,0],["كلمى أطرزه بمدحك ناظماً","درر البيان يزينها إتقانها",16,"ن",3,0],["كلم يظل الشيخ عند سماعها","يختال في برد الشباب الأقشب",17,"ب",1,0],["كَلِّميني فأنا في وحشةٍ","وطريقي فيهِ شوكٌ وحُفَرْ",18,"ر",1,0],["كل ميّت عاش في قبره لحاله","ما معاه الا محاسن أو خطيّه",19,"ي",2,1],["كلِّميني إذا أتاكِ رَحيلي","ما أرَدْتِ، فَلسْتُ في الهُلّاكِ",20,"ك",1,0],["كلّميني في الحبّ فهو حديثي","الأحاديث كلّها أضجرتني",21,"ن",2,0],["كلّمي الماءَ وارسمي فيهِ وجهًا","واشربي الوهْمَ علّميهِ السعادهْ",22,"د",2,0],["كَلِّمِينِي , أَحْتَاجُ مِنْكِ الكَلَامَا","وَ افْسَحِي لِي بِمُقْلَتِيكِ مُقَاما",23,"م",2,1],["كلمَى حروفي إذا ما زُرْتَها غَسقا","تشكو غيابَك بدراً والأسى نطقا",24,"ق",2,1]]}