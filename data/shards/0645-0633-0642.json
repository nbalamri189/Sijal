{"poems":[[53,"ألا نسيا نفسي حديث البلابلِ","https://www.aldiwan.net/poem65958.html","الطويل"],[53,"مسقم عن سقم جفن","https://www.aldiwan.net/poem66696.html","مجزوء الرمل"],[94,"كم من عهود عذبة","https://www.aldiwan.net/poem38946.html","مجزوء الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20993","الخفيف"],[94,"مرح الطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=175492",""],[121,"مسقط","https://www.aldiwan.net/poem24041.html","الخفيف"],[287,"بدر تم ألفته","https://www.aldiwan.net/poem32855.html","مجزوء الخفيف"],[371,"ما تطيب الدنيا لفقد حبيب","https://www.aldiwan.net/poem17093.html","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100379","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206162","الخفيف"]],"verses":[["مُسقّىً بأفواهٍ كأنَّ رُضابَها","جَنى النحل شارتْ أرْيَه كفُّ عاسلِ",0,"ل",1,0],["مُسْقِمٌ عن سُقْمِ جَفْنِ","ضاحكٌ عن حَبِّ مُزْنِ",1,"ن",1,1],["مسقوفةً بالوَردِ والأَعْشابِ","والوَرَقِ النَّضيرْ",2,"ر",1,0],["مسَّ قلبي صوتُهُ إذْ مسَّ أُذني","ألِحُبٍّ أم لسلمٍ أم تمنِّي",3,"ي",1,0],["مَسقَطُ الظِّلِّ مَن تَكنَّفَهُ الحِق","فُ وَتنفي قَذاهُ ريحٌ خَريقُ",4,"ق",1,0],["مسقوفة بالورد والاعشاب والورق النضير","نبني فتهدمها الرياح فلا نضج ولا نثور",5,"ر",1,0],["(مسقطٌ) دارُ حِكمةٍ وبديعٍ","(للخليل بن أحمدَ) الفَنَّانِ",6,"ن",1,0],["(مسقطٌ)، مسقطُ الغمامِ، ومَهْدُ ال","فِكرِ، ينبوعُ مَوردِ الظَّمآنِ",6,"ن",1,0],["مُسقِمي وَالشِفاءُ في","ريقِهِ لَو رَشَفتُهُ",7,"ت",2,0],["مُسقِمٌ طَرَفَهُ بِأَوَّلِ لَحظِ","لَو تَثَنَّى لَزالَ عَنّي السَقامُ",8,"م",1,0],["مس قضيبا بالدلّ او فاعطُ خشفا","وارنو ان شئت جؤذراً أو غزالا",9,"ل",2,0],["مسقمي أنت علتي وطبيبي","ضلة من سواك أبغي نجائي",10,"ا",2,0]]}