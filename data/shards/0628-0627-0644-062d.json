ewPoem.aspx?id=200139",""],[5732,"طابت لي اذكارك","https://www.poetsgate.com/ViewPoem.aspx?id=177926",""],[5756,"من تحت لتحت","https://www.poetsgate.com/ViewPoem.aspx?id=5425",""],[5818,"دعابة","https://www.poetsgate.com/ViewPoem.aspx?id=186920",""],[5821,"رجل المواقف","https://www.poetsgate.com/ViewPoem.aspx?id=114116",""],[5953,"بالحجاب الداني","https://www.poetsgate.com/ViewPoem.aspx?id=93913",""],[5956,"بقوة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=181884",""],[5956,"شهامةُ المرء تبدو من مواقفِهِ *","https://www.poetsgate.com/ViewPoem.aspx?id=182927",""],[5956,"الحب خير وسيلة للتوعية","https://www.poetsgate.com/ViewPoem.aspx?id=192244",""],[5956,"بلالُ بلبلٌ غرّيدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=193095",""],[5956,"ألمٌ ألمَّ به","https://www.poetsgate.com/ViewPoem.aspx?id=194579",""],[5956,"تبَقَّتْ ساعة لبلادنا نصلُ","https://www.poetsgate.com/ViewPoem.aspx?id=207169",""],[5957,"أبدعتَ في دور المحب","https://www.poetsgate.com/ViewPoem.aspx?id=53702",""],[5957,"لا تبتئس","https://www.poetsgate.com/ViewPoem.aspx?id=177144",""],[5977,"الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=212701",""],[5989,"دق الفؤاد","https://www.poetsgate.com/ViewPoem.aspx?id=181670",""],[6096,"من دون وداع","https://www.poetsgate.com/ViewPoem.aspx?id=177528",""],[6124,"أحلام العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=125194",""],[6124,"يا مالكا قلبي لما","https://www.poetsgate.com/ViewPoem.aspx?id=201239",""],[6134,"يا فاضلاً للفخر جئت مكملاً","https://www.poetsgate.com/ViewPoem.aspx?id=169538",""],[6147,"لغة الضاد في شهر العسل/الجزء 2 الرحلة الجغرافية","https://www.poetsgate.com/ViewPoem.aspx?id=153630",""],[6148,"نبي الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=202058",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6318,"يا قُدسُ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66166&r=&rc=16",""]],"verses":[["بِالحِصنِ إِذ دَعَتِ القَنا خِرصانَها","وَتَحَصَّنَت في أَنفُسِ الفُرسانِ",0,"ن",1,0],["بِالحيرَةِ البَيضاءِ حَيثُ تَقابَلَت","شُمُّ العِمادِ عَريضَةُ الأَعطانِ",1,"ن",1,0],["بِالحُسْنِ مِنْ مَكْنَاسَةِ الزَّيْتُونِ","قَدْ صَحَّ عَذرُ النَّاظِرِ الْمَفْتُونِ",2,"ن",1,1],["بالحَبّةِ السّوْداء قابَلَ مَقْدَمي","للّهِ أيَّ قِرًى أعدّ خَبيثِ",3,"ث",1,0],["بالحجر بالحجر المكرم بالصفا","بالبيت بالأركان بالأستار",4,"ر",1,0],["بِالحَزْمِ وَالْعَزْمِ فِي حَلٍّ وَمُرْتَحَلٍ","وفَّوْكَ مَا يَقْتَضِيهِ الرَّعْيُ لِلذِّمَمِ",5,"م",1,0],["بِالحَقِّ أَندُبُ يَربوعاً وَتَرفَعُني","بِحَيثُ تَقصُرُ أَيدي مالِكٍ دوني",6,"ن",2,0],["بالحديد الحدِيدُ يُفلَحُ قِدْماً","فالْقها من حديده بحدادِهْ",7,"د",2,0],["بالحمق والغلمة مصروعة","بالإبط والنكهة صرّاعه",8,"ع",2,0],["بِالحِلمِ بالعِلمِ بِالنُعمى إِذِ اِتّصلَت","بِالخَصبِ إِن أَجدَبوا بالري لِلصادي",9,"د",2,0],["بِالحَزمِ وَالعَزمِ حاطَ الدينَ في مِحَنٍ","أَضَلَّتِ الحُلمَ مِن كَهلٍ وَمُحتَلِمِ",10,"م",1,0],["بِالحَقِّ يَفتَحُ كُلُّ هادٍ مُصلِحٍ","ما لَيسَ يَفتَحُ بِالقَنا المِغوارُ",11,"ر",1,0],["بِالحَقِّ يَحمِلُهُ الإِمامُ وَبِالهُدى","في حاضِرِ الدُستورِ وَاِستِقبالِهِ",12,"ل",2,0],["بِالحَقِّ وَالحَقُّ يُزيلُ الباطِلا","هَذا لَكَ العامُ وَعامٌ قابِلا",13,"ل",2,0],["بِالْحَقِّ أَهْدَاهَا وَضَاعَفَ فَضْلَهُ","إِنْ كَانَ مَشْكُوراً بِصُورَة شَاكِرِ",14,"ر",1,0],["بِالحَقَّ قدْ مَلَكَ القُلُوبَ وَإِنَّهُ","بِالحُبَّ مِنْهَا وَالوَلاَء حَقِيقُ",15,"ق",1,0],["بِالحُسْنِ وَالمَعْنَى لَهُ إِلمَامَة","تَجْلُو الحَقَائِقَ فِي أَحبِّ صِقَالِ",16,"ل",1,0],["بالحقل ترعى به القطعان هانئة","والنحل يرضع من ثديي أزاهره",17,"ر",2,0],["بِالحُزنِ بَعدي فَاِئتَسي","قالَت إِذا قَلَّ العَنا",18,"ن",2,0],["بالحكم لا يعلو محلُّ","ك أنت؛ بل يعلو محلُّه",19,"ل",2,0],["بآل حصن وبالعمرين قد فرعت","عزا ونبلا جميع الناس غطفان",20,"ن",1,0],["بالحزنِ يَفتتحُ الأقوالَ قائلُها","وبالسياسةِ والأجحافِ يَختَتم",21,"م",1,0],["بالحاشِد الملتَفِّ منك إذا دَجى","والضاحكِ العُريانِ من \" ضاحيك \"",22,"ك",1,0],["بالحََوْرِ قامَ على الجنبينِ يحْرُسُهُ","مُعَوَّذٌ من