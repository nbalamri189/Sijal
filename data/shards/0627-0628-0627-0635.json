{"poems":[[47,"معاد من الأيام تعذيبنا بها","https://www.aldiwan.net/poem10908.html","الطويل"],[47,"وجدنا خلال أبي صالح","https://www.aldiwan.net/poem63487.html","المتقارب"],[47,"يشوقك توخيد الجمال القناعس","https://www.aldiwan.net/poem64574.html","الطويل"],[30,"وما زلت مذ كنت الخماسي تتقى","https://www.aldiwan.net/poem5047.html","الطويل"],[107,"هوازن أقبلي ماذا التواني","https://www.aldiwan.net/poem44036.html","الطويل"],[78,"أبا صالح جاءت على الناس غفلة","https://www.aldiwan.net/poem38986.html","الطويل"],[78,"أبا صالح أين الكرام بأسرهم","https://www.aldiwan.net/poem39508.html","الطويل"],[47,"وَجَدْنا خِلاَلَ أبي صَالِحٍ","https://www.poetsgate.com/ViewPoem.aspx?id=31616",""],[236,"أبا صالح ما العيش بعدك صالح","https://www.aldiwan.net/poem44572.html","الطويل"],[422,"أسير وقد جازت بنا غاية السرى","https://www.aldiwan.net/poem54176.html","البسيط"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88612","الطويل"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88608","المتقارب"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105463","المتقارب"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101989","الطويل"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124405",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80015","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80020","الطويل"],[1700,"","https://poetry.dctabudhabi.ae/diwan/poem/105577","الطويل"],[1848,"","https://poetry.dctabudhabi.ae/diwan/poem/105687","المتقارب"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69430","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69414","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69394","المتقارب"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69354","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69326","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69423","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69407","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69379","المتقارب"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69335","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69331","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69319","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69368","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69344","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69336","المتقارب"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69320","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69425","المتقارب"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69369","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69329","المتقارب"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69325","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109290","الطويل"],[2408,"","https://poetry.dctabudhabi.ae/diwan/poem/128794","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100269","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100265","الطويل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118824","الطويل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107070","الخفيف"],[3663,"","https://poetry.dctabudhabi.ae/diwan/poem/111142","الطويل"],[4691,"وعودَكنَّ خيالُ !!","https://www.poetsgate.com/ViewPoem.aspx?id=75081",""],[5213,"ظفرت أمير المؤمنين لك البشر","https://www.poetsgate.com/ViewPoem.aspx?id=170489",""],[5397,"متى آمن الدنيا من الغدر أخدع","https://www.poetsgate.com/ViewPoem.aspx?id=157923",""],[6115,"يا دكتور قلي وشهو اخر خبر قلي","https://www.poetsgate.com/ViewPoem.aspx?id=180590",""]],"verses":[["أَبا صالِحٍ لا زِلتَ والِيَ صالِحٍ","مِنَ العَيشِ وَالأَعداءُ تَشجى بِما بِها",0,"ب",3,0],["أَبا صالِحٍ أَنتَ مَن لا يَدَل","لُ يَومَ الفَعالِ عَلى نِدِّهِ",1,"د",2,0],["أَبا صالِحٍ إِنَّ المَحامِدَ تَلتَقي","بِساحَةِ رَحبٍ مِن فِنائِكَ آنِسِ",2,"س",1,0],["أَبا صالِحٍ حَيثُ اِنتَقَينا دِماغَهُ","مِنَ الرَأسِ عَن ضاحٍ مَفارِقُهُ جَعدِ",3,"د",1,0],["أبا صُرَدٍ لَنِعْمَ العَمُّ يرجو","غِياثَ النّاسِ من قاصٍ وَدَانِ",4,"ن",1,0],["أَبا صالحٍ جاءَتْ على الناسِ غَفلةٌ","على غفلةٍ بانَتْ بكلِّ كريمِ",5,"م",1,1],["أَبَا صَالحٍ أَيْنَ الكِرَامُ بأَسْرِهمْ","أَفِدْنِي كَريماً فَالكَريمُ رِضَاءُ",6,"ا",2,1],["أبَا صَالِحٍ! أنتَ مَنْ لا يُدَلُّ","يَومَ الفَعَالِ على نِدّهِ",7,"د",2,0],["أبا صالح ما العيش بعدك صالح","نزحت ففيك الحزن للدمع نازح",8,"ح",1,1],["أبا صالح قد أفسد الدهر أمرنا","وضاقت علينا في الخطوب رحابُ",9,"ب",1,0],["أَبا صالح صبراً لوقع رزية","وان أَصبحت في الدين ام المصائب",10,"ب",1,0],["أَبا صالح فبمن تهتَدي","جَميع الوَرى وبمن تَقتَدي",11,"د",2,0],["أبا صالحٍ المرتجي يومه","فديتك قم بالهدى مشعرا",12,"ر",2,0],["أبا صالح صبراً وإن كان رزؤكم","إذا غشي الطود الأشم تزعزعا",13,"ع",2,0],["أبَّاصي وأبَّاص هَذي النَّاس مُتَّحِدٌ","وَمَا دَرَوا أنَّهُ أَبَّاصُ مَعلوما",14,"م",2,0],["أبا صالحٍ كم مبهماتٍ جلوتها","وملتبسٍ منها كشفتَ قناعه",15,"ع",2,0],["أبا صالحٍ ما العيشُ بعدكَ صالحاً","لنفسٍ هواها عنكَ لا يستميلها",16,"ل",3,0],["أبا صالح حتى متى أنت غائب","وليس لهذا الدين غيرك صاحب",17,"ب",1,1],["أبا صالح كلت الألسن","وقد شخصت نحوك الأعين",18,"ن",1,1],["أَبا صالِحٍ أَشكُو إِلَيكَ نوائِباً","عَرَتنِي كَما يَشكُو النَباتُ إِلى القَطرِ",19,"ر",1,0],["أَبا صالِحٍ لا يُعدَمِ اسمٌ وَكُنيَةٌ","فَقَد شَرُف اسمٌ وَاكتِناءٌ وَتَلقِيبُ",20,"ب",1,0],["أَبا صالِحٍ قَد فَضَلتَ المُلُوكَ","فَعُدتَ يَميناً وَعادُوا يَسارا",21,"ر",2,0],["أَبا صالِحٍ لا يَطلُبُ الناسُ ماجِداً","كَأَنتَ فَما فيهم كَمِثلِكَ واحِدُ",22,"د",1,0],["أَبا صالِحٍ لا خَلقَ إِلّاكَ مُحسِناً","وَلا مَلِكٌ إِلّاكَ في الناسِ مُفضِلا",23,"ل",2,0],["أَبا صالِحٍ أَنتَ الَّذي سَيبُ كَفِّهِ","يَسِحُّ كَما سَحَّ الغَمامُ المُثَجَّجُ",24,"ج",1,0],["أَبا صالِحٍ رُوحي فِداكَ مِن الرَدى","وَإِن قَلَّ ما يُفدِي وَجَلَّ الَّذي يُفدى",25,"د",2,0],["أَبا صالِحٍ لَيسَ كُلُّ الكَلامِ","يَبقى وَلا كُلُّ قَولٍ يُحَبّ",26,"ب",1,0],["أَبا صالِحٍ طُلتَ المُلوكَ وَطَأطَأَت","لِأَخمَصِكَ الحَيّانِ قيسٌ وَقحطانُ",27,"ن",1,0],["أَبا صالِحٍ ما ذَلَّ مَن أَنتَ عِزُّهُ","وَلا ضَلَّ مَن يَسري وَأَنتَ لَهُ قَصدُ",28,"د",1,0],["أَبا صالِحٍ حُزتَ المَكارِمَ وَالتَقَت","إِلى الفَخرِ أَعمامٌ عَلَيكَ وَأَخوالُ",29,"ل",1,0],["أَبا صالِحٍ لا زِلتَ لِلعيدِ بَهجَةً","وَنُوراً وِللعافِينَ رَبعاً وَمَنجَعا",30,"ع",2,0],["أَبا صالِحٍ أَصبَحتَ فَرداً وَأَصبَحَت","مَعاليكَ أَفراداً مِنَ الصَمَدِ الفردِ",31,"د",1,0],["أَبا صالِحٍ إِن أَغِب عَن عُلاكَ","فَقَلبُكَ لي شاهِدٌ بِالوَلا",32,"ا",1,0],["أَبا صالِحٍ إِن طالَ عَهدي بِخِدمَةٍ","فَما طالَ لي بِالشُكرِ في مَحفِلٍ عَهدُ",33,"د",1,0],["أَبا صالِحٍ لا عَدَتكَ السُعُودُ","وَلا خانَكَ الزَمَنُ المُقبِلُ",34,"ل",1,0],["أَبا صالِحٍ حَمَّلتَني كُلَّ مِنَّةٍ","فَرِفقاً بِما تُسدي فَقَد أُثقِلَ الحِملُ",35,"ل",1,0],["أَبا صالِحٍ أَنتَ حُسنُ الزَمانِ","وَحُسنُ الرِداءِ بِحُسنِ العَلَم",36,"م",1,0],["أَبا صالِحٍ إِن كُنتُ في القَولِ مُحسِناً","فَإِنَّكَ قَد جازَيتَني عَنهُ بِالحُسنى",37,"ن",2,0],["أبا صالح عطفاً علي فانني","اسير ذنوب بلبلت قلبي الاهوا",38,"و",2,0],["أبا صالح حتى متى وإلى متى","حسامك لا ينضى ولم ير مصلتا",39,"ت",2,1],["أبا صالحٍ أبدي لديك شكاية","من الوجد منها لا أعيد ولا أبدي",40,"د",2,1],["أبا صالحٍ والصبر ظهر أماجدٍ","يقوم برزءِ الأكرمين الأماجدِ",41,"د",1,0],["أبا صالح لله ثم رسولهِ","أغثني فإني صرت كالحوت في البرِّ",42,"ر",1,0],["أبا صادق يابن الكرام إصاخة","لشعر امرء تبكي العراق قوافيه",43,"ي",2,0],["أبا صالح المهدي أدرك موالياً","حياتهم موت ودنياهم قبر",44,"ر",1,0],["أبإصبعي سأفتّت الجبل الذي","تبنينَ حتى يستحيلَ وصالُ",45,"ل",1,0],["أبا صائب منا لك الحمد والشكر","فذي نعمة ما أن يحيط بها الحصر",46,"ر",1,0],["أبا صالح أنت الموطد للهدى","قواعده في كل ناد وموقع",47,"ع",1,0],["اباصبر واصابر وامشي الدرب وادلي","وثولث خطا رجلي وعانز بباكوره",48,"ر",2,0]]}