{"poems":[[51,"لله وراق مررنا به","https://www.aldiwan.net/poem64649.html","السريع"],[49,"المرء آفته هوى الدنيا","https://www.aldiwan.net/poem10322.html","الكامل"],[66,"أقطرات أدمعي لا تجمدي","https://www.aldiwan.net/poem40965.html","الرجز"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[48,"ألا فاسقني مسكية العرف مزة","https://www.aldiwan.net/poem63281.html","الطويل"],[48,"أصبح أيري معرضا عني","https://www.aldiwan.net/poem66284.html","السريع"],[141,"ما ذي المساعي الغر في قدر الورى","https://www.aldiwan.net/poem11761.html","الكامل"],[184,"لا وحق التنزيل والتأويل","https://www.aldiwan.net/poem43463.html","الخفيف"],[187,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[227,"ما قال أوه لفقده واها","https://www.aldiwan.net/poem51256.html","المنسرح"],[235,"سل الفؤاد ودع خنى شعرور","https://www.aldiwan.net/poem18197.html","الكامل"],[268,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[302,"مرحباً بالشادن الغزل","https://www.aldiwan.net/poem16881.html","المديد"],[362,"يا من رأى ظعن الحي الذي شحطا","https://www.aldiwan.net/poem60857.html","البسيط"],[362,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[362,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[426,"إلى الروم أصبو كلما أومض الخال","https://www.aldiwan.net/poem40048.html","الطويل"],[426,"اخا السرور فقم وادن لروضتنا","https://www.aldiwan.net/poem41403.html","البسيط"],[434,"ظبي الصريم حبالي في الهوى صرما","https://www.aldiwan.net/poem2586.html","البسيط"],[451,"جزيرة النور تحيينا","https://www.aldiwan.net/poem61396.html","السريع"],[466,"الزهر معلم ند","https://www.aldiwan.net/poem60350.html","المجتث"],[536,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[556,"إنني قد شفني السقم","https://www.aldiwan.net/poem34089.html","المديد"],[573,"تنزه طرفي بين زاه وزاهر","https://www.aldiwan.net/poem3073.html","الطويل"],[573,"لو واصلتني يوما لم أمت أبداً","https://www.aldiwan.net/poem3080.html","البسيط"],[582,"رجعت وفي نفسي بلابل جمة","https://www.aldiwan.net/poem69392.html","الطويل"]],"verses":[["من أصبرِ الناس على صفعه","كأنها وقعةُ فِطِّيسِ",0,"س",1,0],["مَن أَصبَحَت دُنياهُ غايَتَهُ","فَمَتى يَنالُ الغايَةَ القُصوى",1,"ا",1,0],["مَن أَصبَحَت أَوصافُهُ مِن بَعدِهِ","في الأَرضِ تُتلى بِلِسانِ الحُسَّدِ",2,"د",1,0],["مَناصِبُه السَّنِيَّةُ ليسَ فيها","لإِنسانٍ وَلا مَلَكٍ نَصِيبُ",3,"ب",1,0],["مَن أصْلحَ المغرِبَ الأقصَى بلا أدبٍ","غيرِ التشيُعِ والدّين الحنيفيّ",4,"ي",1,0],["مَناصِبُها بيضٌ وَأَجفانُها خُضرُ","وَأَحداقُها صُفرٌ وَأَنفاسُها عِطرُ",5,"ر",1,0],["من أصفر يرنو إلى أحمرٍ","وأبيض في اللونِ كالقطنِ",6,"ن",1,0],["مَن أَصدَرَ الراياتِ حُمراً مِثلَما","أَصدَرتَها غِبَّ الحُروبِ تَصَدَّرا",7,"ر",2,0],["من أصافي بمن ألوذ من النا","س بمن أستغيث في كل جيل",8,"ل",1,0],["مِن أصدقِ الناسِ أَتقاهُم وأعلمهم","فَلا عفا اللَّه يوماً عن مكذّبهِ",9,"ب",2,0],["من أصطفاني بودّه فله","عندي يَدٌ كالجبال صُغراها",10,"ا",3,0],["مِنْ أَصْفَرٍ فِي أَحْمَرٍ فِي أَبْيَضٍ","كَالنَّضْرِ وَالْعِقْيانِ وَالْبَلُّورِ",11,"ر",1,0],["مناصلُ حبسٍ أو مقانبُ غزوةٍ","مداعيقُ تعدو تحتَ فرسانِ جمرة",12,"ه",1,0],["من أصول طهرت وزكت","من جميع الرجس والدخل",13,"ل",1,0],["من أصبحَتْ وزراءُ العَصرِ عن يَدِه","مَن شاء أدنَى ومَن لم يَرضَه شَحَطا",14,"ط",2,0],["من أصبحَ الإسلامُ وهْو لبيتهِ","ركْنٌ عُلاه أعيَتِ المُساحا",15,"ح",2,0],["مُناصِحٌ سلطانَ عَصْرٍ تُشرق ال","أرضُ إذا ما هو بالتّاج اعتَصَب",16,"ب",1,0],["مناصبها انقادت لاعتاب بابه","كما انقاد مرتاحاً إلى العطن الخالُ",17,"ل",1,0],["من أصفر مذهب مع أخضر نضر","وأبيض كلجين أزرق سبج",18,"ج",1,0],["من أصفرٍ فاقع يحكي المحبّ إذا","ما شتّت الدهر شملاً منه ملتئما",19,"م",2,0],["من أصغروا المال الذي عندها","وأكبروا النور المناجينا",20,"ن",2,0],["مِن أَصفَرٍ صَندَلِيٍّ","وَأَحمَرٍ ياقوتي",21,"ت",2,0],["مَناصبٌ لم تُغنِ عن مكَاسِبٍ","وذَهبٌ لم يُغنِه عن وَرِقِ",22,"ق",1,0],["مَن أصيحابي وما السَلَمُ","فنيت رويحي بلا مهَلِ",23,"ل",1,0],["مَناصِلُه في الهام مُغْمدةُ الظُّبا","وأَرْمَاحُه مركوزَةٌ في الحَناجِر",24,"ر",1,0],["مِنْ أَصْلَحَ الحالَ منهم بعدمَا فَسَدتْ","وقلَّما صَلُح الشِّيءُ الَّذِي فَسَدا",25,"د",2,0],["من أصحاب بدر من قريش وغيرهم","بني هاشم منهم ومن أهل يثرب",26,"ب",1,0]]}