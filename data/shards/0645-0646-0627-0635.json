{"poems":[[53,"لله وراق مررنا به","https://www.aldiwan.net/poem64649.html","السريع"],[51,"المرء آفته هوى الدنيا","https://www.aldiwan.net/poem10322.html","الكامل"],[68,"أقطرات أدمعي لا تجمدي","https://www.aldiwan.net/poem40965.html","الرجز"],[69,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[77,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[50,"ألا فاسقني مسكية العرف مزة","https://www.aldiwan.net/poem63281.html","الطويل"],[50,"أصبح أيري معرضا عني","https://www.aldiwan.net/poem66284.html","السريع"],[147,"ما ذي المساعي الغر في قدر الورى","https://www.aldiwan.net/poem11761.html","الكامل"],[190,"لا وحق التنزيل والتأويل","https://www.aldiwan.net/poem43463.html","الخفيف"],[193,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[234,"ما قال أوه لفقده واها","https://www.aldiwan.net/poem51256.html","المنسرح"],[242,"سل الفؤاد ودع خنى شعرور","https://www.aldiwan.net/poem18197.html","الكامل"],[275,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[309,"مرحباً بالشادن الغزل","https://www.aldiwan.net/poem16881.html","المديد"],[369,"يا من رأى ظعن الحي الذي شحطا","https://www.aldiwan.net/poem60857.html","البسيط"],[369,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[369,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[435,"إلى الروم أصبو كلما أومض الخال","https://www.aldiwan.net/poem40048.html","الطويل"],[435,"اخا السرور فقم وادن لروضتنا","https://www.aldiwan.net/poem41403.html","البسيط"],[443,"ظبي الصريم حبالي في الهوى صرما","https://www.aldiwan.net/poem2586.html","البسيط"],[458,"جزيرة النور تحيينا","https://www.aldiwan.net/poem61396.html","السريع"],[473,"الزهر معلم ند","https://www.aldiwan.net/poem60350.html","المجتث"],[543,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[563,"إنني قد شفني السقم","https://www.aldiwan.net/poem34089.html","المديد"],[580,"تنزه طرفي بين زاه وزاهر","https://www.aldiwan.net/poem3073.html","الطويل"],[580,"لو واصلتني يوما لم أمت أبداً","https://www.aldiwan.net/poem3080.html","البسيط"],[589,"رجعت وفي نفسي بلابل جمة","https://www.aldiwan.net/poem69392.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48729","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48730","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64062","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59067","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25316","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46551","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64634","الخفيف"],[1496,"","https://poetry.dctabudhabi.ae/diwan/poem/131412","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118323","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137185",""],[2656,"","https://poetry.dctabudhabi.ae/diwan/poem/124600","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100930","البسيط"],[3020,"","https://poetry.dctabudhabi.ae/diwan/poem/111103","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132596","الرجز"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52980","المتدارك"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129348","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129336","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109898","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102930","البسيط"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40156","السريع"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77069","الرجز"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127058","البسيط"],[5145,"عودوا ببعض عشيات الحمى عودوا","https://www.poetsgate.com/ViewPoem.aspx?id=108065",""],[5145,"أأقسد الشيب في فوديه أم قسطا","https://www.poetsgate.com/ViewPoem.aspx?id=108233",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5186,"نصم عفا الله عن عهد لكم سلفا","https://www.poetsgate.com/ViewPoem.aspx?id=156477",""],[5242,"جنود الله هبُّوا للقتال","https://www.poetsgate.com/ViewPoem.aspx?id=125969",""],[592,"تبكي على رسم دارٍ دارس بال","https://www.poetsgate.com/ViewPoem.aspx?id=128863",""],[5436,"بغداد/ للشاعر زهير شيخ تراب","https://www.poetsgate.com/ViewPoem.aspx?id=152682",""],[5894,"ما فخر ديروط على البلدان","https://www.poetsgate.com/ViewPoem.aspx?id=131409",""],[5956,"أرجوك دعني أبدأ الإسهاما","https://www.poetsgate.com/ViewPoem.aspx?id=193429",""],[5956,"انظر لجابر صادحاً بسّاما","https://www.poetsgate.com/ViewPoem.aspx?id=210304",""],[6102,"فارسية","https://www.poetsgate.com/ViewPoem.aspx?id=184546",""]],"verses":[["من أصبرِ الناس على صفعه","كأنها وقعةُ فِطِّيسِ",0,"س",1,0],["مَن أَصبَحَت دُنياهُ غايَتَهُ","فَمَتى يَنالُ الغايَةَ القُصوى",1,"ا",1,0],["مَن أَصبَحَت أَوصافُهُ مِن بَعدِهِ","في الأَرضِ تُتلى بِلِسانِ الحُسَّدِ",2,"د",1,0],["مَناصِبُه السَّنِيَّةُ ليسَ فيها","لإِنسانٍ وَلا مَلَكٍ نَصِيبُ",3,"ب",1,0],["مَن أصْلحَ المغرِبَ الأقصَى بلا أدبٍ","غيرِ التشيُعِ والدّين الحنيفيّ",4,"ي",1,0],["مَناصِبُها بيضٌ وَأَجفانُها خُضرُ","وَأَحداقُها صُفرٌ وَأَنفاسُها عِطرُ",5,"ر",1,0],["من أصفر يرنو إلى أحمرٍ","وأبيض في اللونِ كالقطنِ",6,"ن",1,0],["مَن أَصدَرَ الراياتِ حُمراً مِثلَما","أَصدَرتَها غِبَّ الحُروبِ تَصَدَّرا",7,"ر",2,0],["من أصافي بمن ألوذ من النا","س بمن أستغيث في كل جيل",8,"ل",1,0],["مِن أصدقِ الناسِ أَتقاهُم وأعلمهم","فَلا عفا اللَّه يوماً عن مكذّبهِ",9,"ب",2,0],["من أصطفاني بودّه فله","عندي يَدٌ كالجبال صُغراها",10,"ا",3,0],["مِنْ أَصْفَرٍ فِي أَحْمَرٍ فِي أَبْيَضٍ","كَالنَّضْرِ وَالْعِقْيانِ وَالْبَلُّورِ",11,"ر",1,0],["مناصلُ حبسٍ أو مقانبُ غزوةٍ","مداعيقُ تعدو تحتَ فرسانِ جمرة",12,"ه",1,0],["من أصول طهرت وزكت","من جميع الرجس والدخل",13,"ل",1,0],["من أصبحَتْ وزراءُ العَصرِ عن يَدِه","مَن شاء أدنَى ومَن لم يَرضَه شَحَطا",14,"ط",2,0],["من أصبحَ الإسلامُ وهْو لبيتهِ","ركْنٌ عُلاه أعيَتِ المُساحا",15,"ح",2,0],["مُناصِحٌ سلطانَ عَصْرٍ تُشرق ال","أرضُ إذا ما هو بالتّاج اعتَصَب",16,"ب",1,0],["مناصبها انقادت لاعتاب بابه","كما انقاد مرتاحاً إلى العطن الخالُ",17,"ل",1,0],["من أصفر مذهب مع أخضر نضر","وأبيض كلجين أزرق سبج",18,"ج",1,0],["من أصفرٍ فاقع يحكي المحبّ إذا","ما شتّت الدهر شملاً منه ملتئما",19,"م",2,0],["من أصغروا المال الذي عندها","وأكبروا النور المناجينا",20,"ن",2,0],["مِن أَصفَرٍ صَندَلِيٍّ","وَأَحمَرٍ ياقوتي",21,"ت",2,0],["مَناصبٌ لم تُغنِ عن مكَاسِبٍ","وذَهبٌ لم يُغنِه عن وَرِقِ",22,"ق",1,0],["مَن أصيحابي وما السَلَمُ","فنيت رويحي بلا مهَلِ",23,"ل",1,0],["مَناصِلُه في الهام مُغْمدةُ الظُّبا","وأَرْمَاحُه مركوزَةٌ في الحَناجِر",24,"ر",1,0],["مِنْ أَصْلَحَ الحالَ منهم بعدمَا فَسَدتْ","وقلَّما صَلُح الشِّيءُ الَّذِي فَسَدا",25,"د",2,0],["من أصحاب بدر من قريش وغيرهم","بني هاشم منهم ومن أهل يثرب",26,"ب",1,0],["مناصب جاءتهم جزافاً فأمطلت","مفاخرها أعراقهم والمعادن",27,"ن",1,0],["مناصب الشعراء الصالحين حُلَىً","إذا الحسود تمناها لهم لجما",28,"م",2,0],["مَن أصبحتْ أيدي الخطوبِ تنالُه","لم ينجُ من أيدي الخطوب كِفافا",29,"ف",2,0],["مِنْ اصفر فَاقِع أو أخْضر عَطِرٍ","أوْ ابيض ناصع أوْ أحمر شَرِقِ",30,"ق",1,0],["مِن أَصْر أَدآثٍ لَهَا دءَائِثُ","أَصْلَحْتَ حَتَّى تَذْهَبَ النَكَايِثُ",31,"ث",1,0],["مَن أَصلَح المَعاشا","نالَ المُنى ما عاشا",32,"ش",2,0],["من أصول صديعة الفجر في أخلا","قهم والوجوه منهم ذكاء",33,"ا",2,0],["مناصحتي بالفعل إن كنت نائيا","إذا كان دان منك بالقول يخدع",34,"ع",1,0],["من اصعب البر مثوى مغرم دنف","عن وصل غانية طرفها دعج",35,"ج",1,0],["من اصبحت آلاءه","كالشمس مزهرة مضيه",36,"ي",2,0],["من أصبح تاجا فوق هام العلى ومن","غدا غُرة زينت بها دُهُمُ الدهر",37,"ر",1,0],["من أصفرٍ فاقعِ أو أبيضٍ يقَقٍ","كأنهُ عسجدٌ طافٍ على وَرِق",38,"ق",1,0],["من أصفر يحكي النضار وابيض","يحكي اللجين مجاوراً لعراره",39,"ر",2,0],["من اصطفى الله من الخلق له","سر قريش وقريشاً من مضر",40,"ر",1,0],["من أصل الفطرةِ للفطِنْ","بعد المولى حبُّ الوطنْ",41,"ن",1,1],["من آصف من حاتم وأياس من","ومن السموأل في الحيا والعفة",42,"ه",1,1],["من اصبحت امة المختار في حرم","من أمنه ما رأت خوفا ولا رعبا",43,"ب",2,0],["مَناصلُ الخَتلِ منها أُرهِفَت فَغَدَت","تغزو الرِجالَ بلا بَيضٍ ولا يَلَبِ",44,"ب",1,0],["من أصيد خفقت راياته وسمت","فاهتز منها الصاصي والأهاضيب",45,"ب",1,0],["مَن أَصبَحَ الشّامُ بِهِ شامَةً","يَقطُرُ مِن قَتلِ عِداه دَما",46,"م",2,0],["مَن أَصبح العِلم بِهِ مَشيدا","إِذ كانَ قَبلَ ركنه تَهددا",47,"د",2,0],["مَن اِصطَفى مِن آلِ فَيروزِالكِرام","هُوَ اِبنُ عَبدِ اللّهِ ذو المَجدِ الهِمام",47,"م",1,0],["من أصبحت شمس دين الله ساطعة","فيه ببدر وفي اليوم الحنيني",48,"ي",1,0],["مناصب كاياة الشمس قلبها","في قلّة العز تصويب وتصعيد",49,"د",1,0],["من أصفرٍ فاقعٍ قلّدته مسكاً","وأحمر قانئ حلينه سمطا",50,"ط",2,0],["من اصطفاه إله العرش جلّ ومن","لولاه لم تخرج الدنيا من العدم",51,"م",1,0],["مناصب ما عرفنا شبه فائدة","لها ولا خالق الدستور ما عرفا",52,"ف",2,0],["مناصحة وانذاراً لنزوى","ولم يجدوا بنزوى من يوالي",53,"ل",2,0],["من أصبح الناس في أمن وفي سعة","بالله به من بعد أهوال",54,"ل",1,0],["منا صلاح الدين منا خالد","وعلى ثرانا يولد القسام",55,"م",1,0],["من أصله العالي تسامى قدره","والأصل للإنسان كالبنيان",56,"ن",1,0],["من أصغرَيكَ نهلتُ جلَّ روائعي","وكسبتَ مني الاحترام دواما",57,"م",2,1],["من أصغريه يقدِّم الإنعاما","ويزيدُ موطنَه هدىً ووئاما",58,"م",2,0],["مِن \"أَصبَهَانِ الوَردِ\": خَدِّي, وَالَّلمَى:","مِن عِطرِ \"تَبرِيزِ الهَوَى\", عَبَقُ البَنَفشَهْ)",59,"ش",2,0]]}