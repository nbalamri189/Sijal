,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81948","الطويل"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67634","المتقارب"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133112","الوافر"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83190","الرجز"],[4461,"","https://poetry.dctabudhabi.ae/diwan/poem/116095",""],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58132","الطويل"],[4693,"ابكي من الحزن لا ابكي من الألم","https://www.poetsgate.com/ViewPoem.aspx?id=29933",""],[4767,"شمس الرشاد","https://www.poetsgate.com/ViewPoem.aspx?id=179938",""],[4797,"فرقا شهيد الدين","https://www.poetsgate.com/ViewPoem.aspx?id=180556",""],[4578,"بروح العلا بالسعد أبدت سماؤها","https://www.poetsgate.com/ViewPoem.aspx?id=49341",""],[4943,"القطرة الغيثية والوسيلة الالهية","https://www.poetsgate.com/ViewPoem.aspx?id=125974",""],[5213,"اليوم تم لنا ما حاول الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=170528",""],[592,"أرى طالع الأدبار والنحس قد بدا","https://www.poetsgate.com/ViewPoem.aspx?id=128843",""],[5367,"روضُ الهُدى","https://www.poetsgate.com/ViewPoem.aspx?id=197190",""],[5596,"شمائل سمائل","https://www.poetsgate.com/ViewPoem.aspx?id=206377",""],[5725,"سرّ منْ رأى","https://www.poetsgate.com/ViewPoem.aspx?id=177530",""],[5818,"وإنّ غداً لناظرهِ قريب","https://www.poetsgate.com/ViewPoem.aspx?id=199691",""],[5956,"الرسالة المحمدية","https://www.poetsgate.com/ViewPoem.aspx?id=184653",""],[5956,"بالي عليكم دائماً مشغولُ","https://www.poetsgate.com/ViewPoem.aspx?id=203724",""],[6152,"أنتِ كوني وكياني","https://www.poetsgate.com/ViewPoem.aspx?id=203409",""],[6171,"مدينة الرسول","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84675&r=&rc=5",""]],"verses":[["وطهّرَ منْكَ القلْبَ لمّا اسْتخصّهُ","فجَلَّلَهُ نوراً وأوْسَعَهُ رُشْدا",0,"د",2,0],["وَطَهَّرَها مِن رِجسِهِم بِحُسامِهِ","همامٌ يَرى كَسبَ الثَنا المغنم الأَسنى",1,"ن",2,0],["وطهَّر محراباً وجدَّد منبراً","وأعلن ذكر الله في كل مسجدِ",2,"د",1,0],["وطُهْرَ الثُّلوجِ وسِحْرَ المروج","مُوَشَّحَةً بشُعاعِ الطَّفَلْ",3,"ل",1,0],["وطَهَارَةُ الموتِ الجميلِ","وسِحْرُ شَاطئهِ المُنيرْ",4,"ر",1,0],["وطهَّرني وبصَّرني","ومزَّق مغلقَ الحجبِ",5,"ب",1,0],["وَطَهَّرَ السَيفُ مِنها بَلدَةً جُنُباً","لَم يَجزِها غَيرَ ماءِ السَيفِ مُغتَسَلا",6,"ل",2,0],["وطَهَّرَ الثَّغرَ وما يَليهِ","من شِيعةِ الكُفر ومن ذَويهِ",7,"ه",1,0],["وَطَهَ فِي طَلِيعَةِ مَنْ أَجَابُوا","يُهَيِّيءُ نَهْضَةً فِي المُسْتَهَلِّ",8,"ل",1,0],["وَطُهْرُ نَفْسٍ إِنْ تُرِدْ وَصْفَهُ","فَانْظُرْ إلى الطلِّ عَلَى وَرْدِهِ",9,"د",2,0],["وَطَهَّرَ مِن رِجسِ الرَذائِلِ عِطفَهُ","وَسَوَّغَ أَشتاتَ الخَليقَةِ عَطفَهُ",10,"ه",1,0],["وطهر منه أرضا حل فيها","لعلك ترتضى من تستجد",11,"د",1,0],["وطهرت قلبي من سواكم فلا أرو","م في الكون إلا أنتم في طويتي",12,"ت",2,0],["وطهَّري القدسَ من رجسٍ ومن دَنسٍ","وأصلتي سيفَ سفّاكٍ لسفّاك",13,"ك",1,0],["وَطهر قالبي وَتغش قَلبي","بانوار السَكينة والوقار",14,"ر",1,0],["وطهرت العيون وقام حزب","بمعدنك النفيس وبالاثار",15,"ر",1,0],["وَطهَّر بالمواضي رجسَ قومٍ","جفته قلوبُهم حسداً وضِغنا",16,"ن",2,0],["وطهرنا من رجز كفر وخبثه","وشرك وظلم واقتحام الكبائر",17,"ر",1,0],["وَطَهَّرنَ نَفسَهُ مِن كُلِّ واصِمَةٍ","كَيلا تَكونَ لَدى حَشري بِواجِمِهِ",18,"ه",1,0],["وطهّرتُ نفسي من تراب مرقّشٍ","يحنُّ إلى رجعاه لهفان صاديا",19,"ي",2,0],["وَطَهَّرتُ أَعضائي بِعِرفانِ مَن عَلى","مَراتِبُهُم في عالَمِ العِشقِ دَلَّتِ",20,"ت",1,0],["وطهِّر بقاع الأرض منهم طهارةً","تكون لهم ذلاً وتبقى لنا فخرا",21,"ر",2,0],["وَطَهَّرتَ أَرضاً قَد وَطِئتَ تُرابَها","فَلَسنا نَرى فيها لِصَدِّكَ مِن فِترِ",22,"ر",1,0],["وطهر القلب وتب تو بتين","وما أرى الشنين بكفين",23,"ن",1,0],["وطهر القلب من غير الإله ولا","تبق سوى الله في سرو في بالي",24,"ل",2,0],["وطهر مكة من كل عبد","قبيح الفعل من أولاد حام",25,"م",1,0],["وطهَّرْتَ الشَّريعة من دنيٍّ","يبيعُ الدِّين في فلسٍ صغيرِ",26,"ر",1,0],["وَطَهَّرَ قَلْبي مِنْ هَواكَ بِباردٍ","وسُخْنٍ فَقَرَّ الْجَفْنُ وَهْو سَخينُ",27,"ن",1,0],["وطهر مصر من أرجاس جيل","تعلق بالخساسة واستعاذا",28,"ذ",2,0],["وطهَّرَ فِتْيانا من الذمِّ طهَّروا","غيوبَهُمُ أن تُنْتَحى بعيوبِ",29,"ب",1,0],["وطهر الأرض ممن بالفساد عثوا","وجاء غازيك بالصمصام مغسولا",30,"ل",2,0],["وطهر قبيل العصر كلك مخلصا","وألق وجود الظل في ماء وحدة",31,"ه",1,0],["وطهر قلوبنا من قواطع أشرفت","على الهلاك يا قدوس يا كاشف الضر",32,"ر",1,0],["وطهر قلوبا من شكوك فلا تدع","قواطعها تنأى با بجنى الران",33,"ن",1,0],["وطهر قلوبا من شكوك قواطع","تنوء عن الإحصا ففتش دواعيا",34,"ي",2,0],["وطهر العقول من شكوك","واحفظ أوامري من التروك",35,"ك",1,0],["وَطَهارَةُ الخُلُقِ الَّذي لَو لَم يَكُن","عَرَضاً مِنَ الأَعراضِ كانَ الماءَ",36,"ا",2,0],["وطهَّرَ أَنفُساً فزكَتْ بنورٍ","إِلهِيٍّ وزادٍ خيرِ زَادِ",37,"د",1,0],["وطهَّركُمْ من مسِّ كلِّ نقيصَةٍ","وصانَ حِماكُمْ من غُبارِ المَعائِبِ",38,"ب",1,0],["وطهر الناصر أرجاءها","والغيث إن جاد الثرى يطهر",39,"ر",1,0],["وطهارة الأخباث والأحداث لا","تجزي بغير الماء ذي السيلان",40,"ن",1,0],["وطهر ميتٍ أنا وحيٍّ","لولاي لم يطهر الوعاء",41,"ا",2,0],["وَطهرت أَرض اللَه مِنهُم بقتلهم","وَأَيدت دين المُصطفى خَير هاشم",42,"م",1,0],["وَطَهَّرَهُ الْمَولى وَأَذْهَبَ حُزْنَهُ","سَلِيلُ خَلِيلِ اللهِ أَشْهَدُ أَنَّهُ",43,"ه",1,0],["وطهِّر الأرض منهم بالدماء فما","دماؤهم للدُّنا إلا الطهاراتُ",44,"ت",1,0],["وطهر القلب من رجس الهوى وأفض","عليه ثوب التقى وابك الدموع دما",45,"م",2,0],["وَطَهارَةُ الأَخلاقِ لَم تَظفَر بِها","إِلّا بِحَيثُ طَهارُهُ الأَعراقِ",46,"ق",1,0],["وطهّرت أحلامي وبخّرت مضجعي","وأحرقت ثغري بالبخور وبالجمر",47,"ر",1,0],["وطهر بها قلبي وأودعه حكمة","ونوراً وعلماً نافعاً منك هاديا",48,"ي",2,0],["وطَهارَةُ الهادي عَليٍّ أشْعَرَتْ","بطَهارَةِ الأرْحامِ والأصْلابِ",49,"ب",1,0],["وطه من لا يوازي فخر أمته","ولا يعادله شخص برتبته",50,"ه",1,0],["وَطَهِّرُوا لِلطَّاهِرِ","قَلباً كَذَاكَ الآخَرِ",51,"ر",1,0],["وَطُهرٌ خِيارٌ مشن كِرَامٍ أَجِلَّةٍ","لَهُ الاَصلُ يَزهُو والفُرُوعُ تُتَوَّجُ",52,"ج",1,0],["وطهر الملك من أعوانه فمضوا","صلبا ونفياً وتذليلا وتخسيرا",53,"ر",2,0],["وَطَهَّرَ بَيتَ اللَهِ مِن كُلَّ بِدعَةٍ","أَكَبَّ عَلَيها مُدَّعٍ وَجَهولُ",54,"ل",1,0],["وطهورَ بث الندى فيه ملك","فاغم ند وصفه كل ناد",55,"د