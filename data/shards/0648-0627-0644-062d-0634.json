{"poems":[[52,"أقبيص لست وإن جهلت ببالغ","https://www.aldiwan.net/poem63891.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54860","السريع"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126123","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46511","الرجز"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18462","الرجز"],[1802,"","https://poetry.dctabudhabi.ae/diwan/poem/116940","السريع"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135749","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135740","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119602","الرجز"],[4829,"الهنوف","https://www.poetsgate.com/ViewPoem.aspx?id=36754",""],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[5186,"قلب الدهر اختيارا","https://www.poetsgate.com/ViewPoem.aspx?id=156521",""],[308,"قل لي مَا شَيْء إِذا رمت إِن","https://www.poetsgate.com/ViewPoem.aspx?id=189406",""],[6056,"نجاحي بعيد الإحتمال .....!","https://www.poetsgate.com/ViewPoem.aspx?id=130158",""]],"verses":[["وَالحُشُّ أَنتَ لَهُ وَذاكَ لِمَسجِدٍ","كَم بَينَ مَوضِعِ مَسلَحٍ وَسُجودِ",0,"د",1,0],["وَالحَشْدُ لِلتَّشْيِيعِ فِي مَوْقِفٍ","ضَنْكٍ كأَنَّ المَوْقِفَ الحَشر",1,"ر",1,0],["والحشرات رجلها ودقها","مفتنة في خَلقها وخُلقها",2,"ه",2,0],["وَالحَشَرات جلها وَدَقها","مفتنة في خُلقِها وَخَلقِها",3,"ه",2,0],["وَالحَشوُ مِن حَفّانِها كَالحَنظَلِ","تُثيرُ صَيفِىَّ الظِباءِ الغُفَّلِ",4,"ل",1,0],["والحشرات الغبر منبثةٌ","بين الورى والبلد القفر",5,"ر",1,0],["والحشر والصحف والميزان معْ","نارٍ صراطٍ كلِّ هول قد فَظَعْ",6,"ع",1,0],["والحشرِ والممتحن الصفِّ فكُفْ","بجمعةٍ منافقون والأكفْ",7,"ف",1,0],["والحشوَ في بيانها لم تُحرز","تقرّب الأقصى بلفظٍ موجز",8,"ز",1,0],["والحشا لاحشا منهلس منملس","اولك اخرك اخرك اولك",9,"ك",1,0],["والحشر قد حشر اليهود بها فلم","يرثى عليهم إذ جلوا في آنه",10,"ن",2,0],["والحشا عانى بما عا","نى زحارا واختمارا",11,"ر",2,0],["والحشو مَنْسُوب إِلَيْهِ وَلَا","يعرف مَا أَحْمد من مَالك",12,"ك",1,0],["والحشا ماعاد يستحمل ، معاناة وعلل","من طعون الوقت وصده بادي ٍ فيه إعتلال",13,"ل",1,0]]}