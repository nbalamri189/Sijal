{"poems":[[44,"حسدوا الفتى إذ لم ينالوا سعيه","https://www.aldiwan.net/poem50221.html","الكامل"],[95,"لا تبن أيها المحيا الوسيم","https://www.aldiwan.net/poem11339.html","الخفيف"],[32,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[53,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[87,"به هجر يتيمه","https://www.aldiwan.net/poem7140.html","مجزوء الوافر"],[41,"ألا أيها الليل الطويل ألا أصبحي","https://www.aldiwan.net/poem53802.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54655","الرمل"],[189,"أقصاه جور البين عن أحبابه","https://www.aldiwan.net/poem14107.html","الكامل"],[227,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[228,"عين من هذه التي لا تنام","https://www.aldiwan.net/poem39708.html","الخفيف"],[240,"لو أنصفت ذات النصيف","https://www.aldiwan.net/poem31817.html","مجزوء الكامل"],[406,"رذاذ","https://www.aldiwan.net/poem10306.html","عموديه"],[466,"لرواة شعري من مدائحه","https://www.aldiwan.net/poem16122.html","أحذ الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38764","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27542","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93627","الكامل"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103725","البسيط"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139887","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62947","الخفيف"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[4755,"المَوتُ مِن طَرَفٍ واحد","https://www.poetsgate.com/ViewPoem.aspx?id=184730",""],[5271,"شذى","https://www.poetsgate.com/ViewPoem.aspx?id=123675",""],[5277,"مدرسةُ العظام","https://www.poetsgate.com/ViewPoem.aspx?id=194482",""],[5956,"أعيش لحبك","https://www.poetsgate.com/ViewPoem.aspx?id=182354",""],[6233,"سيمر العاشق فانتظري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78445&r=&rc=8",""],[6275,"سنوات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83611&r=&rc=3",""],[6314,"بكائية الليل الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88067&r=&rc=2",""]],"verses":[["كَضَرائِرِ الحَسناءِ قُلنَ لِوَجهِها","حَسداً وَبَغياً إِنَّهُ لَدَميمُ",0,"م",1,0],["كضمْ فُؤَادٍ كَسَرْتَهُ أَيُّهَا الْجَا","بِرُ مُنْذُ ارْتَحَلْتَ فَهْوَ كَلِيمُ",1,"م",1,0],["كَضَوءِ البَدرِ لَيسَ بِهِ خَفاءُ","وَأُعطيتَ المَهابَةَ وَالجَمالا",2,"ل",2,0],["كضمير الفؤادِ يلتهم الدن","يا وتحويه دفتَا حَيْزوم",3,"م",1,0],["كضوء الصبح بيِّنه","وكالبنيان مُكَمه",4,"م",2,0],["كضأَنَّ رؤوسَ القَومِ عَن عُقَبِ السُرى","بِها في دَوادي لَعبَةِ المُتَرَجِّحِ",5,"ح",1,0],["كضمْ بِهَا مِنْ مَلْمَحٍ يَنْدَى أَسىً","مَسْحَةُ الدَّمْعِ تَغَشَّتْهُ فَزَانَتْ",6,"ت",1,0],["كضَفيرة الْخَوّاص أَمْكَنه لها","سَعَفٌ ضَفا فأرَقَّ ضَفْرَ لُبابه",7,"ب",2,0],["كضم عين فعل وكسر ما","كابل وعين فعل اضمما",8,"م",2,0],["كَضَميرِ الأَثيمِ يَشمِلُهُ الصَفحُ","وَتَبقى من وَخزِهِ جُرثومه",9,"ه",1,0],["كَضِياءِ عَزمِ أَبي المُظَف","فَرِ في دُجى الخَطبِ المَخوفِ",10,"ف",1,0],["كضحكةِ طفلٍ ضمَّهُ صدْرُ أُمِّهِ","لها نغمٌ عذبٌ يزيلُ عذابا",11,"ب",2,0],["كضجيجِ أصواتِ الحَجيجِ إذا","ذَهَبَ النَّهار وحانَت الأُصُلُ",12,"ل",1,0],["كَضِيا أَبي المِصباحِ قَد مَلأ العُلى","وَنَودُّه أَن لا يَزول وَيعدَما",13,"م",2,0],["كضربةِ موسى بالعصا الحجر الذي","تفجر ماءً في أناسٍ له تجري",14,"ر",2,0],["كضم قائل لي لَم تركت جوارنا","وَعرفتنا خدماً مَدى الأَعمار",15,"ر",1,0],["كضحوةِ العيد في ابتهاج","وطلعة الشمس والقمر",16,"ر",1,0],["كضارب العود وشّىّ فيه توشيّة","وبعدَ ذلك غنّى فيه أشعارا",17,"ر",2,0],["كضلوع الاوعال حفِز نَبلاً","غيرَ مأمونةٍ على الأَضلاعِ",18,"ع",1,0],["كَضَربِىَ العَبدَ مُسِيئاً وَأتَم","تَبِيينىَ الحقَّ مَنُوطاً بِالحِكَم",19,"م",1,0],["كَضَيغَمٍ بَينَ شُمِّ الراسياتِ رَبّي","وَبَرَّحَت بِحَشاهُ آفَةُ السَغَبِ",20,"ب",1,0],["كَضَرِيرٍ يَبحَثُ عَن يَدِهِ","فِي القَيدِ فَيَسقُطُ شارِبُهُ",21,"ب",2,0],["كَضَوءِ الشَمسِ بَعْثَرَها الظَلامُ","أَبَعْدكِ يَا شَذَى يأتي سَلامُ",22,"م",1,1],["كضيم القلب من كوز المعاصي","إذا أجخى من السود السخام",23,"م",1,0],["كضليلٍ حالي في تيهٍ","ووجدتُ هواكِ صِراطَ هُدى",24,"د",2,0],["كضياعٍ يغرق في عدمٍ","وسكونٍ يبحر في ضجرِ",25,"ر",1,0],["كضياء يرقص من ألق","وظلال لا منتهيات",26,"ت",1,0],["كضائعٍ في بلادٍ ما لها أَثَرٌ","كموغلٍ .. روحه في روحه قِدَدَا",27,"د",2,0]]}