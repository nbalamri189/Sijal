{"poems":[[42,"حسدوا الفتى إذ لم ينالوا سعيه","https://www.aldiwan.net/poem50221.html","الكامل"],[93,"لا تبن أيها المحيا الوسيم","https://www.aldiwan.net/poem11339.html","الخفيف"],[30,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[51,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[85,"به هجر يتيمه","https://www.aldiwan.net/poem7140.html","مجزوء الوافر"],[39,"ألا أيها الليل الطويل ألا أصبحي","https://www.aldiwan.net/poem53802.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54655","الرمل"]],"verses":[["كَضَرائِرِ الحَسناءِ قُلنَ لِوَجهِها","حَسداً وَبَغياً إِنَّهُ لَدَميمُ",0,"م",1,0],["كضمْ فُؤَادٍ كَسَرْتَهُ أَيُّهَا الْجَا","بِرُ مُنْذُ ارْتَحَلْتَ فَهْوَ كَلِيمُ",1,"م",1,0],["كَضَوءِ البَدرِ لَيسَ بِهِ خَفاءُ","وَأُعطيتَ المَهابَةَ وَالجَمالا",2,"ل",2,0],["كضمير الفؤادِ يلتهم الدن","يا وتحويه دفتَا حَيْزوم",3,"م",1,0],["كضوء الصبح بيِّنه","وكالبنيان مُكَمه",4,"م",2,0],["كضأَنَّ رؤوسَ القَومِ عَن عُقَبِ السُرى","بِها في دَوادي لَعبَةِ المُتَرَجِّحِ",5,"ح",1,0],["كضمْ بِهَا مِنْ مَلْمَحٍ يَنْدَى أَسىً","مَسْحَةُ الدَّمْعِ تَغَشَّتْهُ فَزَانَتْ",6,"ت",1,0]]}