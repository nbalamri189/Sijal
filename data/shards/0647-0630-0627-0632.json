em.aspx?id=211591",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[5525,"ما عاد لي صاحب","https://www.poetsgate.com/ViewPoem.aspx?id=7264",""],[5533,"الفَجْرُ قادِم","https://www.poetsgate.com/ViewPoem.aspx?id=176644",""],[5561,"اليوم المشهود","https://www.poetsgate.com/ViewPoem.aspx?id=196817",""],[5561,"كما تشائين","https://www.poetsgate.com/ViewPoem.aspx?id=201390",""],[470,"يا سيدى المتنبى","https://www.poetsgate.com/ViewPoem.aspx?id=63453",""],[5595,"خليلة َالرّوح ِ","https://www.poetsgate.com/ViewPoem.aspx?id=144583",""],[5615,"إلى أخرق .....!","https://www.poetsgate.com/ViewPoem.aspx?id=196994",""],[5616,"معذرة يا أبا العلاء","https://www.poetsgate.com/ViewPoem.aspx?id=204842",""],[5690,"هذا زفاف لهُ الأكوان قد قصت","https://www.poetsgate.com/ViewPoem.aspx?id=172271",""],[5691,"بيت الغرابيب","https://www.poetsgate.com/ViewPoem.aspx?id=206248",""],[5694,"هذا الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=132092",""],[5776,"ذو المعصم الواحدة","https://www.poetsgate.com/ViewPoem.aspx?id=199400",""],[5784,"هذا زمان التيه","https://www.poetsgate.com/ViewPoem.aspx?id=189910",""],[5897,"إليها","https://www.poetsgate.com/ViewPoem.aspx?id=162002",""],[5929,"وتكاد تمطرنا السماء...","https://www.poetsgate.com/ViewPoem.aspx?id=202655",""],[5943,"صيدا في الشباك","https://www.poetsgate.com/ViewPoem.aspx?id=34289",""],[5975,"من ذا يكفكف!!","https://www.poetsgate.com/ViewPoem.aspx?id=58789",""],[5980,"هذا زمان غرائب","https://www.poetsgate.com/ViewPoem.aspx?id=146258",""],[6035,"لاتردّي قلبي ! .","https://www.poetsgate.com/ViewPoem.aspx?id=151971",""],[161,"بارك الله لكما","https://www.poetsgate.com/ViewPoem.aspx?id=175728",""],[6052,"سلام الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=34888",""],[6101,"زمرة الشيطان / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120281",""],[6115,"قالو عللامك مع الأيام متغير","https://www.poetsgate.com/ViewPoem.aspx?id=180495",""],[6115,"نافق وجامل وكل الناس يطرونك","https://www.poetsgate.com/ViewPoem.aspx?id=180522",""],[6139,"ميلاد آذار","https://www.poetsgate.com/ViewPoem.aspx?id=212333",""],[6202,"الشعر والسيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86705&r=&rc=6",""],[5393,"في حفل زفاف شاب مسلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84724&r=&rc=2",""],[6268,"يبكيكم الأقصى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82924&r=&rc=10",""],[6355,"بيضي واصفري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66618&r=&rc=78",""],[6355,"ضمائر تُشترى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66657&r=&rc=117",""],[6355,"يا أرض تيهي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66645&r=&rc=105",""],[6355,"الحفيُّ بمن أعادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66684&r=&rc=144",""]],"verses":[["هَذا زَعيمُ النيلِ حَلَّ عَرينَهُ","بَعدَ الغِيابِ فَيا وُفودُ تَدَفَّقي",0,"ق",2,0],["هَذا زُهَيرُكَ لا زُهَيرُ مُزَينَةٍ","وافاكَ لا هَرِماً عَلى عِلّاتِهِ",1,"ت",2,0],["هَذا زُعاقٌ طَعمُهُ","وَالجودُ حُلوٌ كالزُلالْ",2,"ل",1,0],["هَذا زَمانٌ لا تَوَسُّطَ عِندَهُ","يَبغي المُغامِرُ عالِياً وَجَليلا",3,"ل",2,0],["هَذا زَمانٌ لا الأَعِنَّةُ مَنزِلٌ","لِلبَأسِ فيهِ وَلا الأَسِنَّةُ دارُ",4,"ر",1,0],["هَذا زَمانٌ لَيسَ إِخوانُهُ","يا أَيُّها المَرءُ بِاِخوانِ",5,"ن",1,1],["هَذا زَمانٌ هَكَذا أَهلُهُ","بِالوُدِّ لا يُصدُقكَ إِثنانِ",5,"ن",1,0],["هَذا زَمانٌ أَلَحَّ الناسُ فيهِ عَلى","زَهوِ المُلوكِ وَأَخلاقِ المَساكينِ",6,"ن",1,1],["هَذا زَمانٌ قَد تَعَوَّدَ أَهلُهُ","تيهَ المُلوكِ وَفِعلَ مَن يَتَصَدَّقُ",7,"ق",1,0],["هَذا زَمانٌ أَلَحَّ الناسُ فيهِ عَلى","تيهِ المُلوكِ وَأَخلاقِ المَساكينِ",8,"ن",1,0],["هذا زمانكم وذا ميدانكم","ماذا بكم من عدة وعتادِ",9,"د",1,0],["هذا زمانٌ ليس يفهمُ أهلُه","إلا حديثَ النّارِ أو لُغةَ الدَّمِ",10,"م",1,0],["هذا زعيمُ العامِلينَ أقامَها","دُنيا لمصر عِمادُها الأعمالُ",11,"ل",1,0],["هَذا زَمانُ القُرودِ فَاِخضَع","وَكُن لَهُم سامِعاً مُطيعا",12,"ع",2,0],["هَذا زَمانٌ لَيسَ في أَهلِهِ","إِلّا لِأَن تَهجِرَهُ أَهلُ",13,"ل",1,1],["هذا زمان المعجزا","ت، وعصر تحقيق المحال",14,"ل",1,0],["هذا زمانُ الجهلِ، فيه","تَحرزُ العَرجاءٌ سبقًا",15,"ق",2,0],["هذا زمانٌ، لا مجالَ لمنطِقٍ","فيه، ولا خُطَبٍ تقال فِصاحِ",16,"ح",1,0],["هذا زمانُ العلم، تُرْفَعُ دورهُ","وتُشَاد؛ لا لَبِنًا، ولكن جوَهرا",17,"ر",2,0],["هذا زعيمُ الرِّيفِ أك","رمْ بالبلاد وبالزعيم",18,"م",1,0],["هذا زمانٌ لا وفاءَ لأهله","إني بذلتُ المهرَ قبلَك غاليا",19,"ي",2,0],["هذا زمانٌ لا ارتقاءَ لأمةٍ","فيه بغير معارفِ وعلومِ",20,"م",1,1],["هذا زمان له طريق","فاسلك له عامدا طيقه",21,"ق",2,1],["هذا زمان لقوم صرت بينهم","لم ألق بدراً فإن لاقيته كسفا",22,"ف",2,0],["هذا زَمانٌ على ما فيه مِن كَدَرٍ","يَحكي انْقِلابُ لَياليه بأهْليه",23,"ي",2,0],["هذا زَعيمُ الرُسلِ يَهتِفُ مُنذراً","بأَلوكَةٍ تَذرُ الحضيضَ سماءَ",24,"ا",2,0],["هَذا زَمان خَيف أَن","يَنسى الحَمام بِهِ هَديره",25,"ر",2,0],["هذا زمانٌ عليهِ","حقّاً يُناحُ ويوسَفْ",26,"ف",1,1],["هذا زَمانُك لو قَبل","تَ وكُنت ممن يُنعِم",27,"م",1,0],["هذا زميلك بل هذي شهادته","عاطاك إلفك فيها ما تعاطيه",28,"ي",2,0],["هذا زفاف اكارم ويحق ان","نختال في حلل السرور ونرفلا",29,"ل",2,0],["هذا زفاف اليمن من فرح به","طير السعود على الجميع يرفرف",30,"ف",1,0],["هَذا زَمانٌ سَيّئٌ","والسّوءُ فيه قد بدَا",31,"د",2,1],["هذا زَمَانٌ بهِ الأصْنَامُ مَاشِيةٌ","دَمَاً وَلَحْمَاً وتستشري أفاعيهَا",32,"ي",3,0],["هَذا زَمانٌ صارَ فيه حليمهُ","عيّاً وصارَ سفيههُ منطقيا",33,"ق",3,0],["هَذا زَمانُ عِلاجٍ يُتَّقى ضَرَرُ الْ","أَخْلاطِ فيهِ لأَنَّ الفَصْلَ قَدْ وفَدا",34,"د",2,0],["هذا زمانٌ عارمٌ منْ يُبسهِ","ترى اللئيمَ ينتقي من جنسهِ",35,"ه",1,1],["هذا زماني أبو جَهْلٍ وذا جربي","أبو مُعَيْطٍ وذا قلبي أبو لَهبِ",36,"ب",1,0],["هذا زمَانُكِ إن طالوا وإن قصروا","هذا أوانُك إنْ باحوا وإنْ كتموا",37,"م",3,0],["هذا زمان أبي جهلٍ فدعْ حكماً","وعادِ علماً وكن فيه أبا لهبِ",38,"ب",1,0],["هذا زمان الحج ولى وانقضى","وأتاك من بعد الزيارة مسعد",39,"د",1,0],["هذا زمان إذا لم تغدُ معتصماً","بالله فيه فمن تلقاه مأمولا",40,"ل",2,0],["هذا زمانك كله حرب ولا","يرجى بغير الحب منه سلام",41,"م",1,0],["هذا زمانٌ عجيبٌ صار فاسقهم","يفشى الطلاق بحنث غير مكتتم",42,"م",1,0],["هذا زمانٌ ليس في","ه سِوى النَّذالةِ والجَهالهْ",43,"ه",1,1],["هَذا زَمانك فُه فيهِ وَمُرهُ لَدى","حكمٍ أَوِ انهَ تُطَع قُدِّستَ من جبلِ",44,"ل",1,0],["هذا زمانٌ وصفوُه كَدرٌ","وهيَ الليالي وصرفُها عَجبُ",45,"ب",1,0],["هذا زمانٌ بالناس منقَلِبٌ","ظهراً لبَطن جديدهُ خلَقُ",46,"ق",1,0],["هذا زمانُكَ موضوعُ الغيارِ فإن","تُصلِحهُ يَصلُح وان أَفسدتَهُ فَسُدا",47,"د",2,0],["هذا زَمانُ إِعانتي ومَكانها","ان يَذهَبا عني فليسَ مُعينُ",48,"ن",1,0],["هذا زرود حولكم متدفق","والناس تشكو الجزع من أمحاله",49,"ل",2,0],["هذا زَمان الوَصل بَعد الجَفا","الشَمسُ فيهِ تُجتَلَى في الغلس",50,"س",1,0],["هذا زَمانُ الصَفا فاغنم غنائمَهُ","وَاحذر يَفوتك فَوزي بعدما سَمحا",51,"ح",2,0],["هذا زمان العرض فانتظروا","عرضًا يرينا الويل والحربا",52,"ب",2,0],["هذا زمانُ الشُّحِّ والإقْتارِ","مضَى زمانُ الجُودِ والإيثارِ",53,"ر",1,0],["هذا زمان كل شي","ء في بنيه قد تغير",54,"ر",1,0],["هذا زمانكَ مقبلٌ ومبتسمٌ","بكلِّ خيرٍ تلقَّهُ بمبتسمِ",55,"م",1,0],["هَذا زَمانُ الإِنتِباهِ وَمَن يَنَم","بَينَ الشُعوب نَصيبهُ الحرمانْ",56,"ن",1,0],["هذا زمان قل فيه الصادق","أبناؤه منافق ومارق",57,"ق",1,0],["هذا زمانك لا تأمن غوائله","ولا تواليه وارفضه وعاديه",58,"ي",2,0],["هذا زفاف هلال الشعر أرخه","يمنا بإدراك شمس السعد للقمر",59,"ر",1,0],["هذا زعاف طعمه","والجود حلو كالزلال",60,"ل",1,0],["هَذا زَماني قَد دَنا ميقاتهُ","هَذا الأوانُ لما زعمتَ أوانُ",61,"ن",1,0],["هذا زمان الردى ظلٌّ له ويدٌ","مخضوبة ُ الكفِّ منها يقدح الغضبُ",62,"ب",1,0],["هذا زمانك لا عزّى ولا هُبلُ","وكلّ جرحٍ أبيٍّ سوف يندملُ",63,"ل",1,0],["هذا زَمَانٌ لا يَجفُّ ظَلَامُهُ","يَمضِي الخَبيثُ بهِ, ويأتِي الأخبَثُ",64,"ث",1,0],["هَذَا زَمَانٌ لا يُجيدُ حِوَارَهُ","مُتَشَعْوِذٌ , أو رَاهِبٌ قِسِّيسُ",65,"س",1,0],["هذا زَمَانٌ لا يَجفُّ ظَلَامُهُ","يَمضِي الخَبيثُ بهِ, فيأتِي الأَخبَثُ",66,"ث",1,0],["هذا زَمَانُ الوَهمِ، يا ابنَ أَصِيلَةٍ","لا عَيشَ فيه لِمَن لَدَيهِ أُصُولُ",67,"ل",1,0],["هذا زمان اليوم سلمى اتركتله","كل ما بها من شبة العيب وهروم",68,"م",1,0],["هذا زمنّا غير عن كل الأزمان","ماعاد فيه أحباب قاصي وداني",69,"ن",2,0],["7- هَذَاْ \"زُعَيِّنُ\" فِي الْقُيُوْدِ مُكَبَّلٌ","وَابْنُ \"الأَتَاْسِيْ\" نَاْئِحٌ بَكَّاْءُ",70,"ا",2,0],["هذا زمانيَ كانَ مفقودَ الهوى","دَنِفٌ وعني السّعدُ يوماً ما درى",71,"ر",2,1],["هذا زمانٌ فادِحٌ، يُرثى لَهُ","الشَّهْد فيهِ لن يفارق نحلَهُ",72,"ل",2,0],["هذا زمان الحبّ في صدري لظى","قد تَمْتَمَتْ من حَرّه الأحجار",73,"ر",1,0],["هَذَا زَمَانٌ يَقُودُ العَجْزُ رَايَتَنَا","وَتُسْجَنُ الشَّمْسُ تَقْلاهَا نَوَاحِينَا",74,"ن",2,0],["هذا زمانُ الأسى والذلُّ هيبتُهُ !","ساقتْ ذئابًا لنا يا ليثُ أغنامُ",75,"م",1,0],["هذا زعيم والزعامة حكمة","وحياة شعب في يديه رهان",76,"ن",1,0],["هذا زمان مباهاةٍ ومفخرةٍ","بالمالِ ، كلُّ فقيرٍ ظاهر السَّمَجِ",77,"ج",1,0],["هذا زمان ليس يامن أهله","إلا جهول جهله قتال.",78,"ل",1,0],["هذا زمانُ الشعرِ ينهضُ قومهُ","ويصدُّ عن تلكَ الجفونِ تعاميا",79,"ي",2,0],["هذا زمانٍ نصيبي منه وأنا أحب","لا من حفظت العهد ازعلت مضنوني",80,"ن",2,0],["هَذا زَمَانٌ لغَيْرِ الحَقِّ وُجْهَتُهُ","والرَّكْبُ مُرْتَهِنٌ والإِفْكُ عِنْوَانُ",81,"ن",1,0],["هذا زمانٌ لهُ الأزمانُ شاهدةٌ","كلٌّ لكلٍّ مع الإنسانِ كفّارُ",82,"ر",1,0],["هذا زمانٌ بذلِّ العيشِ نسكنُهُ","الحرُّ يشربُ فيهِ الجمرَ والتعَبا",83,"ب",2,0],["هذا زمان معايير النبوغ به","عينان لا ينثني جفناهما وفم",84,"م",1,0],["هذا زمَانٌ جَرئٌ في دواخلِنا","يُقلّبُ الكفّ أحياناً-وقد ذهَبا",85,"ب",2,0],["هَذَا زَمَانٌ صَارَ فِيهِ الكَلبُ لَا","يَرضَى سِوَى بَأَطايِبِ الوَجَباتِ",86,"ت",1,0],["هذا زمانٌ.. وأخشى أن يمَسَّ يدي","جمرُ الكتابة أو أن يَسقط القلمُ",87,"م",1,0],["هذا زفاف لهُ الأكوان قد قصت","والطير غرد فوق الغصن بالحسنِ",88,"ن",1,1],["هذا زَمانٌ رأسُهُ عَقِبٌ","ويَدورُ مُنْحَدِراً بمَقْلوبِ !",89,"ب",1,0],["هذا زمان ما تعدد فجوعه","ولاندري من عليه انتشره",90,"ر",2,1],["هذا زنادي كنبضي فوق مترسهِ","محرابُهُ الحربُ هل يرضيك ِحين مضى؟",91,"ض",2,0],["هذا زمانُ التّٙيْه يُنْكرُ أهلٙهُ","منذُ ٱعْتٙلا فوق ٱلحروفِ سماسرٙهْ",92,"ر",2,0],["هذا زمانك يا ابنة الأبطال","فاستشرفي أعلى الذرى واختالي",93,"ل",2,1],["هذا زمان العهر آن أوانه","وتطاوُلِ الرّعيان في البنيان",94,"ن",1,0],["هذا زمانُ الغدرِ ليس بآمنٍ","فيه صغيرُ أو كبيرٌ من عراكْ",95,"ك",1,0],["هذا زماني قد بلاني بالأسى","فكفاك يا قلبي منىً وسذاجَهْ",96,"ج",2,0],["هذا زمان غرائب","وعجائب لا تنقضي",97,"ض",2,1],["هذا زماني شاءَ بُعْدي مُكْرهاً","حَسْبيْ فؤادي سامعٌ لِصداكِ",98,"ك",1,0],["هَذا زَوَاجُ العُمْرِ فِي مِِيثَاقِهِ","سُكْنَى الوِدَادِ بِالهُدَى رَقَّاهُ",99,"ا",2,0],["هذا زمانٌ علينا لفّ دورته","وشتَّتَ الجمعَ في لفاتِها قسما",100,"م",2,0],["هذا زمان للمهازل والخنا","للإنحناء وزمرة الشيطان",101,"ن",1,0],["هذا زمان به الكذاب يتخيّر","وصاحب الصدق خبزه ماله ايدامي",102,"م",2,0],["هذا زمان العب العب بين افنونك","وان كنت غلطان قولوا ليش غلطاني؟",103,"ن",2,0],["هذا زمانٌ تعيد الشّمْسُ قصّتَهَا","حيْنًا،ويسْطَعُ فيْه النّجْمُ والوهجُ",104,"ج",1,0],["هذا زمان الأدعياء أما ترى","أني انزويت إلى قصي يُبهم",105,"م",1,0],["هذا زمانُ السيفِ .. هل من حاسمٍ","أمضى من الحدِ الرهيفِ وأسرع !",106,"ع",1,0],["هذا زمانٌ مَالَهُ غايةٌ","ببؤسهِ بين البرايا يَسيحْ",107,"ح",1,0],["هذا زمانُك فاعْبثي بدروبه","واستبعدي أيَّامَه واستعمري",108,"ر",2,0],["هذا زمانٌ رَديءٌ في مَتاجرهِ","ضمائرٌ تُشْترى بَخْساً وتُبْتاع",109,"ع",1,0],["هذا زمانٌ ساقنا قدَرٌ لكي","نتجرَّعَ الموتَ الزُّؤامَ بحِضْنِهِ",110,"ه",1,0],["هذا زمانٌ أفلسَتْ أيامُهُ","فتَحَدَّثي ما شِئْتِ عنها وانسخي",111,"خ",2,0]]}