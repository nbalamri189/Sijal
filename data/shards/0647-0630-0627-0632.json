{"poems":[[88,"ما بال دندرة تميس تهاديا","https://www.aldiwan.net/poem68897.html","الكامل"],[72,"صفحا لصرف الدهر عن هفواته","https://www.aldiwan.net/poem42997.html","الكامل"],[80,"من كان يسلو عن نوال","https://www.aldiwan.net/poem14266.html","مجزوء الكامل"],[87,"شرفاً نصير ارفع جبينك عالياً","https://www.aldiwan.net/poem8081.html","الكامل"],[87,"جن على حرم السماء أغاروا","https://www.aldiwan.net/poem62964.html","الكامل"],[60,"هذا زمان ليس إخوانه","https://www.aldiwan.net/poem30843.html","السريع"],[51,"هذا زمان ألح الناس فيه على","https://www.aldiwan.net/poem63137.html","البسيط"],[51,"أهل التخلق لو يدوم تخلق","https://www.aldiwan.net/poem64246.html","الكامل"],[51,"حتى متى ليت شعري يا ابن يقطين","https://www.aldiwan.net/poem65337.html","البسيط"],[99,"اليوم يومك في الشباب فناد","https://www.aldiwan.net/poem24755.html","الكامل"],[107,"أمم العروبة جاء يومك فاعلمي","https://www.aldiwan.net/poem41936.html","الكامل"],[107,"وفت الظنون وبرت الآمال","https://www.aldiwan.net/poem42085.html","الكامل"],[50,"إني لولا شقاء جدي","https://www.aldiwan.net/poem64386.html","مجزوء البسيط"],[48,"هذا زمان ليس في أهله","https://www.aldiwan.net/poem23153.html","السريع"],[108,"أدب الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=179476",""],[108,"حسن ترقى","https://www.poetsgate.com/ViewPoem.aspx?id=179749",""],[108,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[108,"في مهرجان دار العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=179366",""],[108,"بطل الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179606",""],[108,"أين الصديق؟","https://www.poetsgate.com/ViewPoem.aspx?id=179523",""],[139,"هذا زمان لا ارتقاء لأمة","https://www.aldiwan.net/poem49178.html","الكامل"],[190,"هذا زمان له طريق","https://www.aldiwan.net/poem43533.html","مخلع البسيط"],[190,"من ذا يكون مجيري من بني زمن","https://www.aldiwan.net/poem43614.html","البسيط"],[368,"بعد الصباح الذي ودعتكم فيه","https://www.aldiwan.net/poem60602.html","البسيط"],[381,"أدركت شأوك فاتق الأسواء","https://www.aldiwan.net/poem66973.html","الكامل"],[384,"لا يخدعنك جمال صوره","https://www.aldiwan.net/poem48759.html","مجزوء الكامل"],[436,"هذا زمان عليه","https://www.aldiwan.net/poem12676.html","المجتث"],[476,"يا من به أنا مغرم","https://www.aldiwan.net/poem4119.html","مجزوء الكامل"],[482,"قل ما بدا لك تلق السمع صاغيه","https://www.aldiwan.net/poem37039.html","البسيط"],[1198,"","https://poetry.dctabudhabi.ae/diwan/poem/97749","الكامل"]],"verses":[["هَذا زَعيمُ النيلِ حَلَّ عَرينَهُ","بَعدَ الغِيابِ فَيا وُفودُ تَدَفَّقي",0,"ق",2,0],["هَذا زُهَيرُكَ لا زُهَيرُ مُزَينَةٍ","وافاكَ لا هَرِماً عَلى عِلّاتِهِ",1,"ت",2,0],["هَذا زُعاقٌ طَعمُهُ","وَالجودُ حُلوٌ كالزُلالْ",2,"ل",1,0],["هَذا زَمانٌ لا تَوَسُّطَ عِندَهُ","يَبغي المُغامِرُ عالِياً وَجَليلا",3,"ل",2,0],["هَذا زَمانٌ لا الأَعِنَّةُ مَنزِلٌ","لِلبَأسِ فيهِ وَلا الأَسِنَّةُ دارُ",4,"ر",1,0],["هَذا زَمانٌ لَيسَ إِخوانُهُ","يا أَيُّها المَرءُ بِاِخوانِ",5,"ن",1,1],["هَذا زَمانٌ هَكَذا أَهلُهُ","بِالوُدِّ لا يُصدُقكَ إِثنانِ",5,"ن",1,0],["هَذا زَمانٌ أَلَحَّ الناسُ فيهِ عَلى","زَهوِ المُلوكِ وَأَخلاقِ المَساكينِ",6,"ن",1,1],["هَذا زَمانٌ قَد تَعَوَّدَ أَهلُهُ","تيهَ المُلوكِ وَفِعلَ مَن يَتَصَدَّقُ",7,"ق",1,0],["هَذا زَمانٌ أَلَحَّ الناسُ فيهِ عَلى","تيهِ المُلوكِ وَأَخلاقِ المَساكينِ",8,"ن",1,0],["هذا زمانكم وذا ميدانكم","ماذا بكم من عدة وعتادِ",9,"د",1,0],["هذا زمانٌ ليس يفهمُ أهلُه","إلا حديثَ النّارِ أو لُغةَ الدَّمِ",10,"م",1,0],["هذا زعيمُ العامِلينَ أقامَها","دُنيا لمصر عِمادُها الأعمالُ",11,"ل",1,0],["هَذا زَمانُ القُرودِ فَاِخضَع","وَكُن لَهُم سامِعاً مُطيعا",12,"ع",2,0],["هَذا زَمانٌ لَيسَ في أَهلِهِ","إِلّا لِأَن تَهجِرَهُ أَهلُ",13,"ل",1,1],["هذا زمان المعجزا","ت، وعصر تحقيق المحال",14,"ل",1,0],["هذا زمانُ الجهلِ، فيه","تَحرزُ العَرجاءٌ سبقًا",15,"ق",2,0],["هذا زمانٌ، لا مجالَ لمنطِقٍ","فيه، ولا خُطَبٍ تقال فِصاحِ",16,"ح",1,0],["هذا زمانُ العلم، تُرْفَعُ دورهُ","وتُشَاد؛ لا لَبِنًا، ولكن جوَهرا",17,"ر",2,0],["هذا زعيمُ الرِّيفِ أك","رمْ بالبلاد وبالزعيم",18,"م",1,0],["هذا زمانٌ لا وفاءَ لأهله","إني بذلتُ المهرَ قبلَك غاليا",19,"ي",2,0],["هذا زمانٌ لا ارتقاءَ لأمةٍ","فيه بغير معارفِ وعلومِ",20,"م",1,1],["هذا زمان له طريق","فاسلك له عامدا طيقه",21,"ق",2,1],["هذا زمان لقوم صرت بينهم","لم ألق بدراً فإن لاقيته كسفا",22,"ف",2,0],["هذا زَمانٌ على ما فيه مِن كَدَرٍ","يَحكي انْقِلابُ لَياليه بأهْليه",23,"ي",2,0],["هذا زَعيمُ الرُسلِ يَهتِفُ مُنذراً","بأَلوكَةٍ تَذرُ الحضيضَ سماءَ",24,"ا",2,0],["هَذا زَمان خَيف أَن","يَنسى الحَمام بِهِ هَديره",25,"ر",2,0],["هذا زمانٌ عليهِ","حقّاً يُناحُ ويوسَفْ",26,"ف",1,1],["هذا زَمانُك لو قَبل","تَ وكُنت ممن يُنعِم",27,"م",1,0],["هذا زميلك بل هذي شهادته","عاطاك إلفك فيها ما تعاطيه",28,"ي",2,0],["هَذا زَماني قَد دَنا ميقاتهُ","هَذا الأوانُ لما زعمتَ أوانُ",29,"ن",1,0]]}