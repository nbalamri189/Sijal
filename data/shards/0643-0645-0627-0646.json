عيد","https://www.poetsgate.com/ViewPoem.aspx?id=133056",""],[5431,"سلامي إلى صنعا تعزّ وربعها","https://www.poetsgate.com/ViewPoem.aspx?id=188446",""],[5431,"ما كان لله أن ينسى أحبته ....","https://www.poetsgate.com/ViewPoem.aspx?id=200831",""],[5431,"نحن موتى وإنهم أحياء..","https://www.poetsgate.com/ViewPoem.aspx?id=202730",""],[5431,"موت القصيدة ...","https://www.poetsgate.com/ViewPoem.aspx?id=210322",""],[5459,"ماذا ادّخرتَ..؟","https://www.poetsgate.com/ViewPoem.aspx?id=208843",""],[5628,"استغاثات حواء","https://www.poetsgate.com/ViewPoem.aspx?id=178521",""],[5720,"كياد *","https://www.poetsgate.com/ViewPoem.aspx?id=199081",""],[5720,"المُبدِعُونَ*","https://www.poetsgate.com/ViewPoem.aspx?id=199622",""],[4623,"سائلاتي عن ادمع سائلات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146690",""],[5830,"إِنَّ الوَصْلَ يُحْيِيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=200823",""],[5830,"طَيْفٌ وَ وَعْدٌ وَ أَمَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=200906",""],[5859,"رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=29416",""],[5912,"مجاراة لقصيدة لي حبيب","https://www.poetsgate.com/ViewPoem.aspx?id=203791",""],[5956,"أدي الرسالة يا مولات واجتهدي","https://www.poetsgate.com/ViewPoem.aspx?id=182382",""],[5956,"سؤال وجواب على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183228",""],[5956,"وُعُود الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=192695",""],[6117,"متاهةُ حُلم","https://www.poetsgate.com/ViewPoem.aspx?id=182783",""],[6239,"من خلف غبار الوهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75991&r=&rc=39",""],[463,"من دلَّ ربّاتِ العيونِ النُّجلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60197&r=&rc=253",""],[463,"يا دار بين شرافَ فالنخلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60233&r=&rc=289",""]],"verses":[["كَم أَنزَلَ الدَهرُ مِن عَلياءَ شاهِقَةٍ","وَشالَ مِن قَعرِ نائي الغَورِ مِنهالِ",0,"ل",1,0],["كما نَمَّ حسّانُ بنُ سَعدِ بنِ عامِرٍ","بِغُرِّ مَساعِيهِ على كَرَمِ النَّجْرِ",1,"ر",1,0],["كَمِ اِنبَرَت فيهِ أَقلامٌ وَكَم رُفِعَت","فيهِ مَنائِرُ مِن نَظمٍ وَمِن خُطَبِ",2,"ب",1,0],["كم أنجح القصد منتجوها","وغيرهم أخلف الظنونا",3,"ن",2,0],["كَما نَفَضَ الأَشباحَ بِالطَرفِ غُدوَةً","مِنَ الطَيرِ أَقنى أَشهَلُ العَينِ واقِعُ",4,"ع",1,0],["كَم أَنجَبوا بِخَليفَةٍ وَخَليفَةٍ","وَأَميرِ صائِفَتَينِ وَاِبنِ أَميرِ",5,"ر",1,0],["كم أنشرَتْ جدواه فينا حاتماً","ولكم كفانا بأسهُ دهراً عدي",6,"د",2,0],["كم أنشدت من بعدها أيديكُم","ما كانَ أكثرها لنا وأقلّها",7,"ل",3,0],["كما نفت وافر خوف الورَى","عافية من سيِّدي وافيه",8,"ف",3,0],["كم آنِفٍ لكُمُ من أن تُرَى مِدَحي","مَنْقُودَةً وَجَداكم غيْر مَنْقُودِ",9,"د",1,0],["كما نظر الأسير إلى طليقٍ","يؤمُّ بلادَهُ لحضور عيدِ",10,"د",1,0],["كم أنشأ المزن من ندىً وردىً","لمعتفي دولة وفاسقها",11,"ق",3,0],["كَما نَوَّرَ المِصباحُ لِلعُجمِ أَمرَهُم","بُعَيدَ رُقادِ النائِمينَ عَريجُ",12,"ج",1,0],["كَم أُناسٍ أَظهَروا الزُهدَ لَنا","فَتَجافَوا عَن حَلالٍ وَحَرامِ",13,"م",1,1],["كَما نَفَخَت في ظُلمَةِ اللَيلِ قَينَةٌ","عَلى فَحَمٍ شُذّانُهُ مُتَطايِرُ",14,"ر",1,0],["كَما نعبتُنَّ لي بالفألِ يُعجِبُني","مُخبِّراتٍ بِهِ عَن أَطيَبِ الخبرِ",15,"ر",1,0],["كم انت يا دنيا يحو","م الظامؤن على سابك",16,"ك",1,0],["كَما نَقَلَ الغُرابُ فَضَلَّ مَشياً","وَما بَلَغَ الجَديدَ وَلا القَديما",17,"م",2,0],["كَما نُحِرَت يَومُ الأَضاحي بِبَلدَةٍ","مِنَ الهَديِ خَرَّت لِلجَنوبِ قِيامُها",18,"م",3,0],["كَم أُناسٍ رَأَيتَ أَكرَمَتِ الدُن","يا بِبَعضِ العُروضِ ثُمَّ أَهانَت",19,"ت",1,0],["كَم أُناسٍ كانوا فَأَفنَتهُمُ الأَي","يامُ حَتّى كَأَنَّهُم لَم يَكونوا",20,"ن",3,0],["كم أناديك في التنائي فترتد بلا مغنم لي الأصداء","وأناديك في دمائي فتنساب على حسرة لدي الدماء",21,"ا",2,0],["كما نَظَرَتْ سلمى إلى رأس دعبلٍ","وقد عَجِبَتْ والشيبُ يُبكيه ضاحِكُه",22,"ك",2,0],["كَم أَنجَموا قَمَراً حَمى بِفِعالِهِ","قَمَراً وَمَكرُمَةً تُناغي الفَرقَدا",23,"د",2,0],["كَما نَعصي إِلَيهِ عِن","دَ جِدِّ القَولِ ناهينا",24,"ن",2,0],["كَما نُكِسَت هَيماءُ أُحدِثَ رَدعُها","بِمُستَنقَعٍ أَعراضُهُ لِلهَوامِلِ",25,"ل",1,0],["كَم أَنَّةٍ تَحتَ الظَلامِ تَرَدَّدَت","فَاِستَوقَفَت أَصداؤُها الأَقدارا",26,"ر",2,0],["كَما نَظَرَت وَالريحُ ساكِنَةٌ لَها","عُقابٌ بِأَرساغِ اليَدَينِ نَدورُ",27,"ر",1,0],["كَم آنَسَتني بَعدَ إيحاشِها","وَأَوحَشَتني بَعدَ تَأنيسِها",28,"س",3,0],["كَم أَنفَدَ اللَيلَ ناسٌ غَفلَةً وَكَرىً","وَلَو أَحَسوّا خَفيَّ الأَمرِ ما هَجَعوا",29,"ع",3,0],["كَما نُبِذَت لِلوَحشِ وَالطَيرِ رازِمٌ","فَأَلفَت شُروراً بَينَ مُختَطِفيها",30,"ي",3,0],["كَمْ أَنْفُسٍ عَزَّتْ بِسُلْطَانِهَا","فِي ما مَضَى وَهْيَ إِذَنْ دَاخِرَهْ",31,"ر",2,0],["كَم أَنْجَبَتْ لِلْمَحْمَدَاتِ وَلِلنُّهَى","مِنْ شُمِّ أَعْلامٍ وَغرِّ مَنَائِرِ",32,"ر",1,0],["كم أنادي الشباب إذ بان منّي","وندايَ موَلِّياً ما يجيبُ",33,"ب",1,0],["كما نائبٍ حرٍّ سُقينا الشَّهْدَ من","أقوالِهِ والسَّمَّ من أفعالِهِ!",34,"ل",2,0],["كم أنكرتْ عهدَ الاستعمار شرذمةٌ","هُمْ -لا سِوَاهُمْ- للاستعمار أعوان",35,"ن",1,0],["كم آنسَتْ وحشتي بدقتها","فالآن أصبحتُ شبهَ منفرد",36,"د",1,0],["كم أنادِي الشبابَ إذْ بانَ منِّي","وندائي مولياً ما يُجيبُ",37,"ب",1,0],["كما نفحتْ في ظلمة ِ اللّيلِ قينة ٌ","عَلَى فَحَمٍ شُزَّانُهُ مُتَطَايِرُ",38,"ر",1,0],["كم أنا ..كم أنا احبك...حتى أن","نفسي من نفسها تتعجب",39,"ب",1,0],["كم آنفٍ لكُمْ من أن تُرى مِدحي","منقُودة ًوجَدَاك غير منقودِ",40,"د",1,0],["كَم أُناس ما أَن لَهُم مِن شُعور","يَطلَبون الأَشعار مِنا اِختِبارا",41,"ر",2,0],["كم اناجي الليل فيه قائلا","ليل طل لا بدلي ان اسهرك",42,"ك",1,0],["كما نظمت هذي الرياح غمائما","لها من غروب الشمس وشيٌ مطرف",43,"ف",1,0],["كَما نالَ مَن كانَ مِن قَبلِكُم","ثَمودٌ وَعادٌ فَمَن ذا بَقي",44,"ق",2,0],["كم أنادي حين يبدو صبحه","يا سعيدٌ هل خيالٌ لي يرُدّ",45,"د",1,0],["كم أنشبَ البَينُ في أسروعه بَرَداً","وكم أغارَ على وَردٍ بعُنّابِ",46,"ب",1,0],["كَما نُكِحَت بِنتُ المُهَلهلِ إِذ غَدا","مِنَ الضَّيمِ في سَعدِ العَشيرَةِ هارِبا",47,"ب",2,0],["كَما نَفَت قَبلَ ذا قَسراً أَوائِلُهُم","عَنها إِياداً وَحُلواناً وَجِيلانا",48,"ن",2,0],["كم أناسٍ يصدُّ عنهم أناسٌ","جمعَ الموتَ بينهم فاستراحوا",49,"ح",3,0],["كَم أَنجَبتُ من شاعِرٍ نابِغٍ","إِذا اِنبَرى في مَوقِفٍ يسحرُ",50,"ر",1,0],["كم أنزل المقدارُ عن قدره","من جهِلتْ فطنتُه قدري",51,"ر",2,0],["كَم أُنفِقُ الأَيّامَ في خِدمَةٍ","أَحرَزتُ فيها صَفقَةَ المُخسِرِ",52,"ر",1,1],["كما نرى الشَّمسَ بعد الغيمِ ساطعةً","والأرضَ خضراءَ بعد الثّلجِ والديم",53,"م",1,0],["كم أَنشدُ الرَوضَ إذا هبِّت صباً","تنبَّهي يا عذباتِ الرَندِ",54,"د",1,0],["كَم أُنادي في اللَيل أَوّاه لكِن","لَيسَ يَشقى مِن الجَوى أَوّاه",55,"ا",2,0],["كم أُناسٍ خلْتُهمْ لي جُنَناً","يومَ رَوْعٍ فغدَوا فيَّ سهاما",56,"م",2,0],["كما نظرَ المُلوكُ إلى كتابٍ","على عُنْوانهِ عَبدُ الجَليل",57,"ل",1,0],["كما نُقِضَ الشَطْرَنْجُ لليأسِ نَقْضةً","وعاد رَجاءٌ حين عادَ لِعاب",58,"ب",1,0],["كَم أَنطَقَت يَدُهُ مِن لَهجَةٍ خَرِسَت","وَصَيَّرَت مِن وُلاةِ العِلمِ مَن جَهِلا",59,"ل",2,0],["كم آنسٍ جاء يودي نفسَه أسفاً","بمُدية اليأس بعد النصح بالمنع",60,"ع",1,0],["كم أنشأتْ ذِكرَاكَ بين جَوانِحي","من زَفرةٍ قَلبِي بها مَوسُومُ",61,"م",1,0],["كما نَزَلتْ على أرضٍ سماءٌ","تسيل على الأباطح والأكام",62,"م",1,0],["كم أنادي ولم تجب وتلبي","وفؤادي مولع بداكا",63,"ك",2,0],["كم أنطَقا بمنابِر ال","هاماتِ ألسنةَ الغُمودِ",64,"د",1,0],["كم أنشرَا مستَرْهناً بضريحِه","واستَنزَلا مستَعصِماً بصِراحه",65,"ح",2,0],["كم أنادي منهم أصمّ عنِ الجو","د غبياً الباع منه قصيرُ",66,"ر",1,0],["كمْ أَنشَبَتْ فِيَّ الخطوبُ مخالِباً","حَتَّى انْثَنَتْ عنِّي بغيرِ مخالبِ",67,"ب",1,0],["كما نصحت لكم من قبل في شغفي","بخيركم فكبا صوتي وأصدائي",68,"ا",2,0],["كما نفضت يدي منهم بلا اسف","وما نفضت يدي من مصر أو نظري",69,"ر",2,0],["كم أُنفقُ العمرَ على رعيِ المُنَى","وهي خبيثاتُ الثرى هشائمُ",70,"م",1,0],["كما نجت خائفةٌ","ورهاءُ لم تُقنَّعِ",71,"ع",1,0],["كما نبا عند ابتذالِ الندى","سَمعُ يمين الدِّينِ عن لائمِ",72,"م",1,0],["كم انطلقتْ من مادحيك وأَخرستْ","من حاسديك على المعالي أَلسنا",73,"ن",2,0],["كما نمنمتَ خطّاً ذا خفاءٍ","على سطحينِ من ذهبٍ وعاج",74,"ج",1,0],["كم أناس قبلنا","في الغرام اقتتلوا",75,"ل",3,0],["كم أناس ذهلت عن لبّها","ورأت فيه مرائي الوسن",76,"ن",1,0],["كم أناس ذهبوا ليس لهم","من غواني الحسن ظل النفس",77,"س",1,0],["كما نجرت العود في ماء الأضى","ما راح عن معرسه لينهضا",78,"ض",2,0],[