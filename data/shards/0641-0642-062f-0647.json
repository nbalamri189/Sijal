{"poems":[[65,"أصاخ إلى الواشي فلباه إذ دعا","https://www.aldiwan.net/poem46191.html","الطويل"],[63,"فؤاد علي بالسماح علوق","https://www.aldiwan.net/poem51508.html","الطويل"],[46,"ألم يأن أن تروى الظماء الحوائم","https://www.aldiwan.net/poem30365.html","الطويل"],[50,"آلف ما صدت من القنيص","https://www.aldiwan.net/poem64361.html","الرجز"],[50,"أدرها علينا قبل أن نتفرقا","https://www.aldiwan.net/poem64426.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9878","الطويل"],[90,"لقد سمعوا من الوطن الأنينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19527&r=&rc=30",""],[168,"إنما فازت قداح المنايا","https://www.aldiwan.net/poem67815.html","المديد"],[276,"مقيل العاثرين أقل عثارى","https://www.aldiwan.net/poem52134.html","الوافر"],[443,"سلام على الربع من ذي سلم","https://www.aldiwan.net/poem2553.html","المتقارب"],[443,"لهم حب قلبي إن تدانوا وإن صدوا","https://www.aldiwan.net/poem2622.html","الطويل"],[445,"دعي عزمات المستضام تسير","https://www.aldiwan.net/poem34841.html","الطويل"],[447,"عذاب الهوى في قلب من رامه عذب","https://www.aldiwan.net/poem14329.html","الطويل"],[466,"إذا ما غزوتم معلمين فراوحوا","https://www.aldiwan.net/poem15096.html","الطويل"],[466,"عليك ذمام الله ما ذر شارق","https://www.aldiwan.net/poem15694.html","الطويل"],[469,"سرت موهناً لا أبعد الله مسراها","https://www.aldiwan.net/poem3493.html","عموديه"],[520,"إذا لم يسألك الزمان فحارب","https://www.aldiwan.net/poem12034.html","الطويل"],[520,"ألا قل لعز الدين لا زال جده","https://www.aldiwan.net/poem12206.html","الطويل"],[556,"أراعك ما راعني من ردى","https://www.aldiwan.net/poem48121.html","المتقارب"],[563,"بهجة النور بعد وقت الكسوف","https://www.aldiwan.net/poem34349.html","الخفيف"],[659,"","https://poetry.dctabudhabi.ae/diwan/poem/76571","المتقارب"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/139050",""],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102034","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65016","الهزج"],[1303,"","https://poetry.dctabudhabi.ae/diwan/poem/199261","السريع"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64576","الرجز"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111824","المجتث"],[2126,"","https://poetry.dctabudhabi.ae/diwan/poem/100547","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60926","البسيط"],[2758,"","https://poetry.dctabudhabi.ae/diwan/poem/31506","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199960","الهزج"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102379","الوافر"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126926","الرمل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138607",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91244","المجتث"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97072","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73099","الوافر"],[4858,"غفلة وتوبة","https://www.poetsgate.com/ViewPoem.aspx?id=30104",""],[5136,"دعه يبكي فمن بكى يستريح","https://www.poetsgate.com/ViewPoem.aspx?id=121548",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"ألا قل لذي الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""],[592,"لعمرك ما يدري الغبي بأنه","https://www.poetsgate.com/ViewPoem.aspx?id=128805",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5756,"خطاك السو","https://www.poetsgate.com/ViewPoem.aspx?id=5364",""],[5759,"سجى الليل","https://www.poetsgate.com/ViewPoem.aspx?id=213405",""],[5897,"عروس الحسن ..غادة","https://www.poetsgate.com/ViewPoem.aspx?id=156854",""],[5937,"شبيهةُ صنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=211806",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""],[6114,"ما الحسنُ إلا بطَرْفٍ أحرزَ الدَّعَجا","https://www.poetsgate.com/ViewPoem.aspx?id=120391",""],[520,"ألا قل لعز الدين لا زال جده","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577603",""]],"verses":[["فقَدْ هَدَّ رُكنَيَّ العَدُوُّ ولم يكُنْ","يُحاولُ فينا قَبْلَ ذلكَ مَطْمَعا",0,"ع",2,0],["فقد هجرَ الخُلُّ الوَصولُ خَليلَه","ولم يَحْظَ فيه بالصَّديقِ صَديقُ",1,"ق",1,0],["فَقَد هَزَّ عِطفَيهِ القَريضُ تَوَقُّعاً","لِعَدلِكَ مُذ صارَت إِلَيكَ المَظالِمُ",2,"م",1,0],["فَقَدَّهُ بِمِخلَبٍ قَبوصِ","فَكَم ذَبَحنا ثَمَّ مِن مَوقوصِ",3,"ص",1,0],["فَقَد هَمَّ وَجهُ الصُبحِ أَن يُضحِكَ الدُجى","وَهَمَّ قَميصُ اللَيلِ أَن يَتَمَزَّقا",4,"ق",2,0],["فَقَد هَدَّ رُكني فَقدُهُ وَمُصابُهُ","وَخَلّى فُؤادي دائِمَ الخَفَقانِ",5,"ن",1,0],["فقد هاجوا على الدستور شراً","بدار الملك كي يستعبدونا",6,"ا",1,0],["فَقدُهُم هَدَّ مِنَ المَجدِ رُكناً","كانَ عَمرُ اللَهِ صَعباً مَنيفا",7,"ف",2,0],["فَقدُهُم غادَرَ ما رَوَّضَتهُ","هَضَباتُ الجودِ قلّاً قَصيفا",7,"ف",2,0],["فَقدُهُم غادَرَ ما شَمِلَتهُ","نَفَحاتُ العرفِ حُزناً حَليفا",7,"ف",2,0],["فَقدُهُم غادَرَ مِن بَعدِ لينٍ","خَفضَ عَيشِ الناسِ فَظّاً عَنيفا",7,"ف",2,0],["فَقَد هَتَكوا حماى وعاندوني","على نعم تدر عَلى دِياري",8,"ر",2,0],["فقد هيّج الشوق تذكارهُ","وعلّم جفيني البكاء العلم",9,"م",1,0],["فقد هبّ من أرض العراق نسيمهُ","تضوّع في أرجائها المسلك والند",10,"د",1,0],["فَقُدْها إِلَى الأَعداءِ شُعْثاً كَأَنَّها","أَرَاقِمُ فِي شُمِّ الرُّبى وصُقُورُ",11,"ر",1,0],["فقد هجر المختار قبلي مكة","وليس لها إلا ثأى أهلها ذنب",12,"ب",1,0],["فقد هَمَّ سيفي أن يخف بجفنه","إلى الهام لولا حبسه بالحمائل",13,"ل",1,0],["فَقُدْها إِلى ما تبتغيهِ فانها","طليحةُ عَزْمٍ في يديكَ زمامُها",14,"م",3,0],["فقد هتفتْ تلك الهضابُ من الحيا","كأنَّ ندى الملكِ المعظم يغشاها",15,"ا",3,0],["فقد هد قدماً عرش بلقيس هدهد","وخرب فأر قبل ذا سد مأرب",16,"ب",1,0],["فقد هزل أشواقي إلى أن تركتني","أقول وكتمان الغليل غلول",17,"ل",1,0],["فَقَد هَزَّك القَومُ قَبلَ الضِّرابِ","فَما صادَفوكَ كَليلَ الشَّبا",18,"ا",1,0],["فقده وجده بعزة ذات","طبعه خارج عن المألوف",19,"ف",1,0],["فَقَد هاجَ لي شَجناً ساكِناً","وَذَكَّر عَهداً تَوَلّى حَمِيدا",20,"د",2,0],["فقدها خيط فجر ابيض عجل","بالرق يسطو عليها سطوة الجاني",21,"ن",2,0],["فقد همت في وادي الخيال مفكراً","لذا كنت معدوداً من الشعراء",22,"ا",2,0],["فقد هانَ علينا ما","أَضَعنْا مُذْ حفِظْناها",23,"ا",3,0],["فقَدُّه لابنِ رَشِيقِ انْتمَى","وخدُّه الزُّهْرِي رَوى عن شَقِيقْ",24,"ق",1,0],["فقد هوى في موبقات العطب","ولا أرى عن الشقا منقلبي",25,"ي",1,0],["فقدُّهُ الغصنُ فيهِ","طيرُ المحاسن تشدو",26,"د",2,0],["فقد هدم الإسلام ما شيد الردى","وقد نقض الإيمان ما أبرم الكفر",27,"ر",1,0],["فقدّها للقضيب قَدٌّ","وجيدُها للغزالِ جيدُ",28,"د",1,0],["فَقَد هاجَني ذِكرُ الصَبي","يِ مِن بَعدِ سُقمٍ طَويلِ المِطالِ",29,"ل",1,0],["فقد هيجت لي كربي","وقد أكثرت وسواسي",30,"س",2,0],["فقد هزّت قناتك في قريش","عروق المجد والحسب النضار",31,"ر",1,0],["فقدها قد هد ركن المرتضى","وجميل الصبر منه قوضا",32,"ض",2,0],["فقده يكفي شجى كيف وقد","مات تفديه الورى بالسم قتلا",33,"ل",2,0],["فَقَد هَويتُك طفلاً","وَكانَ ذاكَ ابتلائي",34,"ي",1,0],["فقد هوى كوكب ضاء الوجود به","وغاب بدر الهدي والمجد في الحفر",35,"ر",1,0],["فقَد هدمَ الرَّدى رَيعَ المَعالي","وَأَنحلَ هذهِ الدُّنيا ربيعُ",36,"ع",1,0],["فقد هتفت بي الأهواءُ يوماً","وزينت المظاهرَ بالقشورِ",37,"ر",1,0],["فقده بعد فقد إنني أدمى","جرح قلبي فالجسم مني طليح",38,"ح",1,0],["فقد هم خير المرسلين محمد","بإحراق من صلى عينا على كل مستهدي",39,"د",2,0],["فقد هزلت واخلولق الدين وانمحت","معالمه إذ كنت أنت المقدما",40,"م",2,0],["فقد هزلت واخلولق الدين وانمحت","معالمه بين الورى إذ تهدما",41,"م",2,0],["فقد هزلت واخلولق الدين وانمحت","معالمه واستامها كل من جهل",42,"ل",1,0],["فقد هضم المعصوم من حقه الذي","به خصه المولى على كل ما عبد",43,"د",1,0],["فقده من الثرى ضيق وتراحيب وسهل وهضاب","فقده من الوطن حتى عذوبة ماه واعشابه",44,"ب",2,0],["فَقد هَدَّ جَفني البُعدُ عَنكِ كَأنَّهُ","سحابٌ يُعنّيهِ ارتحالٌ فيُغدِقُ",45,"ق",1,0],["فقد هام السرور به","وفردوس المنى عادَهْ",46,"د",2,0],["فقد هزَمَتْ شعري وشعري مُسَلَّحٌ","فكيف انتصاري الآن والشِعرُ أعزَلُ !",47,"ل",1,0],["فَقَد هَوَى الحُلمُ الجَمِيلُ وَانْفضَى","عِندَ صَلِيلِ الغَبْنِ أَضحَى عَانِيَا",48,"ي",2,0],["فقدُّها قَدَّ كلّ القَدِّ إن رق","في روض أنسٍ أريضٍ زهره أرجا",49,"ج",2,0],["فقد هز أشواقي إلى أن تركتني","أقول وكتمان الغليل غلول",50,"ل",1,0]]}