om/ViewPoem.aspx?id=186338",""],[5431,"عجبتُ من العشقِ العنيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=190079",""],[5587,"هذا الدواء","https://www.poetsgate.com/ViewPoem.aspx?id=193848",""],[5725,"حملتك في قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=204867",""],[5736,"خمر الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=208882",""],[5818,"يفعل الله بقلبي ما يريدْ","https://www.poetsgate.com/ViewPoem.aspx?id=197073",""],[5969,"شِفاءْ","https://www.poetsgate.com/ViewPoem.aspx?id=204788",""],[6106,"طيفها الساحر !","https://www.poetsgate.com/ViewPoem.aspx?id=6312",""],[6152,"حُلم عمري","https://www.poetsgate.com/ViewPoem.aspx?id=203097",""],[6152,"بكِ أمان قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=203308",""],[4593,"أيا حرفة الزمنى الم بك الردى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=610660",""],[6164,"فتاتان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66064&r=&rc=73",""],[6259,"ألمتْ ودوني من تهامة بيدها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59367&r=&rc=15",""],[6267,"سَأُصْرِمُ لُبْنَى حَبْلَ وَصلِكِ مُجْمِلاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=8345&r=&rc=54",""],[6336,"أشواق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73400&r=&rc=6",""]],"verses":[["أَيا حَرَجاتِ الحَيِّ حَيثُ تَحَمَّلوا","بِذي سَلَمٍ لا جادَكُنَّ رَبيعُ",0,"ع",1,0],["أيا حسناً قد هوى شائباً","لقد بتُّما والهوى مشكل",1,"ل",1,1],["أيا حسرتا إن أفسد الصيفُ صحتي","فضاعف حاجاتي وأوْهَى قوى نَهْضي",2,"ي",1,1],["أيا حاديَ الأظعانِ غَرِّدْ فقد بَدَا","لنا حَضَنٌ واستقبلَتْنَا صبَا نَجْدِ",3,"د",1,1],["أيا حاجبَ السلطانِ زانكَ حاجبٌ","وأغناكَ في الهيجاءِ عنْ قوسِ حاجبِ",4,"ب",1,1],["أيا حاتمَ الإسلامِ ودُّوا خلاصَها","بما ملكوا فليخسؤوا قضي الأمرُ",5,"ر",1,0],["أَيا حَرَجاتِ الحَيِّ حينَ تَحَمَّلوا","بِذي سَلَمٍ لا جادَكُنَّ رَبيعُ",6,"ع",1,1],["أَيا حُبَّ لَيلى داخِلاً مُتَوَلِّجاً","شُعوبَ الحَشا هَذا عَلَيَّ شَديدُ",7,"د",1,1],["أَيا حُبَّ لَيلى عافِني قَد قَتَلتَني","فَكَيفَ تُعافيني وَأَنتَ تَزيدُ",7,"د",1,0],["أَيا حُبَّ لَيلى لا تُبارِح مُهجَتي","فَفي حُبِّها بَعدَ المَماتِ قَريبُ",8,"ب",1,0],["أَيا حَياتي طوبى لِمَن يَرِدُك","حَماكِ عَنّي العِدا فَما أَجِدُك",9,"ك",1,1],["أيا حسناً أحسِنْ فما زلتَ مُحسناً","تيقَّظ للحسنى فتشْأى الأياقظا",10,"ظ",2,0],["أيا حارثَ الأرض، ما نُؤتَ يومًا","بما لو تحمَّله الطَّودُ ناء",11,"ا",2,0],["أيا حَبَّذا إِجانَةٌ كيفما اغتَدت","زمَان ربيعٍ أو زمان عَصيرِ",12,"ر",1,1],["أَيا حَكَمَ السَوءاتِ لا تَهجُ وَاِضطَجِع","فَهَل أَنتَ إِن هاجَيتَ إِلّا مِنَ الخُضرِ",13,"ر",1,0],["أَيا حَكَمُ المَتبولُ لَو كُنتَ تَعتَزي","إِلى أُسرَةٍ لَيسوا بِسودٍ زَعانِفِ",14,"ف",1,1],["أيا حادىَ الأظعان أَعجلْ فإنها ال","منايا وبعضُ البِرِّ أن يؤجَرَ القتلُ",15,"ل",1,0],["أيا حسنا قد حاز كل فضيلة","ورتبته تعلو على كل رتبة",16,"ه",1,1],["أيا حرمَ الظباء أنرتَ روحي","بمشكاةٍ من الحسن الرفيق",17,"ق",1,0],["أيا حرم الظبإ أنرت روحي","بمشكاةٍ من الحسن الرفيق",18,"ق",1,0],["أيا حبذا سعدى وحب مقامها","ويا حبذا أين استقل خيامها",19,"م",3,1],["أيا حبذا أرضٌ على كسرِ أُمّتي","تُريني جيوشَ العربِ مُنتَصرات",20,"ت",1,0],["أيا حسن الوجه رجع وخذ","بصوتٍ عليٍّ لنا في حسينِ",21,"ن",1,0],["أيا حسن اترج يلوح لناظري","عليه من الأوراق خضرُ الغلائلِ",22,"ل",1,1],["أيا حسن أعمى لم يجد حد طرفه","محب غدا سكران فيه وما صحا",23,"ح",2,1],["أَيا حامِلَ الرُمحِ الشَبيهِ بِقَدِّهِ","وَعَهدي بِهِ غُصناً حَليفَ الهَوى رَطبا",24,"ب",2,1],["أَيا حسنَ حمّامٍ حَوى الحسن وَالبها","فَلا زال مِن عَين الحَسود سَليما",25,"م",2,1],["أيا حاسياً كأس لذاته","ولم يدر ما قدر ما قدما",26,"م",2,1],["أَيا حَبَّذا أَرض السَراةِ وَحَبَّذا","تَهائِمها مِن أَجلِها وَنجودُها",27,"د",3,0],["أيا حرّ عودتني منك جفوة","أبيت لها والقلب بالحزن موجعُ",28,"ع",1,0],["أيا حاملي أعواده إن فوقها","سماوي سر فاتقوا شهب الزبن",29,"ن",1,0],["أيا حرقتي لجلالٍ مضى","لقد خابَ ظني كما ضاعَ مدحي",30,"ي",1,1],["أيا حاميَ الذود ما للعرا","ق أُهمِلَ بعضٌ وبعضٌ رُعي",31,"ع",2,0],["أَيا حَزَناً وعاوَدَني وداعي","وكانَ فراقَ لُبنَى كالخُداعِ",32,"ع",1,1],["أَيا حَسَنَ الخَلقِ قُم نَصطَبِح","خَلوقاً يَنيهُ بِأَنوارِهِ",33,"ر",2,1],["أَيَا حَبَّذَا الدُّنْيا فَمَنْ حَلَّ سُوحَها","يُلاحِظُهُ في دَهْرِهِ الْيُمْنُ والسَّعْدُ",34,"د",1,0],["أيا حبيبةُ سِوَاكِ مالي","لو أننَّي أنفقتُ فيكِ مالي",35,"ي",1,0],["أَيا حادِيَ الأظعانِ لمْ لا تُعرِّسُ","لعلّك أنْ تحظى بقربك أنفسُ",36,"س",1,1],["أَيا حاسِدي كَسب العُلا اِكتسب العُلا","فَإنّ المَعالي لَيسَ تَأخذها غصبا",37,"ب",2,0],["أَيا حسرتا ضاعَ الزَّمانُ ولم أَفُز","بطيبِ اللِّقا منكُم أُهيلَ موَدَّتِي",38,"ي",1,0],["أَيا حَسَناً لَم يَبقَ حَسَناً لِغَيرِهِ","بِرِفعَةِ شَأنٍ لَم يَزَل يَستَزيدَها",39,"د",3,0],["أَيا حَضرة البيك الشريعيّ ذي الصَفا","وَحسن الوَفا يا خَير أَعضاء مَجلسِ",40,"س",1,1],["أَيا حَسناً لربك أَنتَ فَابشر","بِرَيحان وَرُوح وَالقصور",41,"ر",1,1],["أَيا حُسنَ رَوضٍ بِالشّقائِقِ قَد زَها","تَميلُ بِها الأَغصانُ مَيلَ التبختُرِ",42,"ر",1,1],["أَيا حَبّذا المَنثور في الرّوضِ وَالرّبى","يُسلِّي بِمَرآهُ عَنِ الهمِّ مَهموما",43,"م",2,1],["أَيا حُسنَ يَومٍ في الرَّبيعِ مغيِّمٍ","بِأَبيضِ غيمٍ مِن بَديعِ الغَمائِمِ",44,"م",1,1],["أَيا حَسَن الذّات باسم حميد","تَهَنّأ فَفيكَ السّرور تجدّد",45,"د",1,1],["أَيا حُسنَ وَجدي لَو خلَوت عَنِ النّوى","ويا حَرَّ وَجدي لو كَوَتني لَظى الجَفا",46,"ا",1,1],["أَيا حُسنَ ثَغرِ الحِبِّ يَأخُذُ بِالحِجى","وَيُسكِرُني نَفحاً وَيَشفي ويُدنِفُ",47,"ف",1,1],["أيا حاسدُ احْسدني أو اغْتظْ وإن تجِدْ","ظهيراً فنازع وانطح الصخرة الصمَّا",48,"م",2,0],["أيا حاملا مني شديد تعلق","وشوق رعاك الله ان كنت حامله",49,"ل",2,0],["أيا حسنها من روضةٍ ضاع نشرها","فنادت عليه في الرياضِ طيورُ",50,"ر",1,1],["أي احذف المفروق قل قالت وفي","ثانية خبل وكشف قد قفي",51,"ي",1,0],["أيا حجراً صلداً مُنِيتُ ببخلِهِ","فلا هو يوريني ولا هو يوري لي",52,"ي",1,0],["أيا حسن الأسماء كالفعل راقياً","إلى رُتَبٍ كالسر فيهن جهرُه",53,"ر",2,1],["أيا حاملَ الرُّمحِ الشبيهِ بقدِّهِ","وياشاهراً سيفاً حكى لحظَهُ عَضبَا",54,"ب",2,1],["أيا حاديا للعيس يحدو بسرعة","فديتك خذ نحو السكان مكة",55,"ه",1,0],["أيا حامل الذكر المنزل والذكر","فإني لأولى الكهف أقرأ والعصر",56,"ر",1,1],["أيا حُسن روض فيه ريض مُهجَتي","تطلعَ بدوٍ بِدَوٍّ بعد نازل",57,"ل",1,0],["أَيا حادِياً نَحوَ ذَاكَ المَقام","وَيا مُدلِجاً نَحوَ تِلك الخِيام",58,"م",1,0],["أيا حَبَّذَا ذاك العتابُ الذي مَضَى","وإن جَرَّهُ واشٍ بزورٍ تَمَضمَضَا",59,"ض",2,1],["أيا حجّةَ الله الذي هو قدوةٌ","لمن لا يرى الطهرَ النبي مُحَمّدا",60,"د",2,0],["أيا حسن الصنع الزمان علمته","أساء بنا ذا اليوم يا حسن الصنعا",61,"ع",2,0],["أَيا حِبُّ اللَهِ لِمَ هَجَرتَني","صَدَدتِ عِنّى فَما تُباليني",62,"ن",2,1],["ايا حلية الدنيا ويا زينة الورى","ومن أنا بالفضل الذي فيه أفخر",63,"ر",1,1],["أَيا حَبرَ عِلمٍ يا هِدَايَةَ سَالِكٍ","وَخَيرَ إِمامٍ في الخَلِيقَةِ يُقتَدى",64,"د",2,0],["أَيا حسنا أَبشر فَسَعدك قَد وَفا","بِخَير زَفاف بِالصَفا حسن الوَفا",65,"ف",2,1],["أَيا حامِداً في العُلا","بَلَغت الصَفا إِلا كَملا",66,"ل",2,1],["أيا حجة الله الذي ليس جارياً","بغير الذي يرضاه سابق أقدار",67,"ر",1,0],["أيا حبّة القلب ناديتني","فلبيت أسعى إلى آمري",68,"ر",2,0],["أيا حادي الظعن إن جزت بوما","بقرب الحجاز أهيل الجمال",69,"ل",1,0],["ايا حسنها من ليلة جمعت لنا","غرائب احسان وحسن غرائبِ",70,"ب",1,1],["أيا حلوة الروح والمنظر","ويا ثروة في يدَيْ مُعسر",71,"ر",1,1],["أيا حبّذا عيشتي في القرى","وزهرة ايامها الزاهية",72,"ي",2,1],["أيا حمى لها أبغضت ذاتي","لقد غيرت لي طعم الحياة",73,"ه",1,1],["أيا حبذا روضتا نرجس","يحيى الندامى بريحانها",74,"ن",3,1],["أيا حبذا ساحاتها ورسومها","وطيب رباها لا عرين من القطر",75,"ر",1,0],["ايا حظ طَنطا اليَوم امناً بِسَعدِها","إِلَيها بَهِيُّ الفَخرِ عاد مُديرُها",76,"ر",3,0],["ايا حماةً لو الداعي بمغربها","وفي المشارق كنتم أدرك الفرجا",77,"ج",2,0],["أيا حبذا الإهدا الذي جل قدره","كما جل مهديه بحسن المكارم",78,"م",1,1],["أيا حماة الوجود يا من","في سوحهم تكرم الوفود",79,"د",1,0],["أيا حمامَةُ ما هذا البُكاءُ فَقَد","هَيَّجتِ شَوقي ودَمعُ العينِ قد وكَفا",80,"ف",2,1],["أيا حفيظُ حكمٌ حقُّ حكيمْ","حميدُ يا حسيبُ حيُّ يا حليمْ",81,"م",1,1],["أي أحد والشُّفر للعين وقد","قدِمت عُقب الشهر بعد ما نفِد",82,"د",1,0],["أيا حاميَ العرب في دارهِم","على الله ثم إليك المفر",83,"ر",1,0],["أيا حاملاً بالرمح راساً بحمله","لوت ذلة ابنا لويٍ رقابها",84,"ب",3,0],["أيا حرَّ قلبي زد سعيراً حشاشتي","ولا تتَّإِد من هتن أمطار عبرتي",85,"ي",1,0],["أيا حافظاً للملك أنت فؤاده","ويا ساقي الظمآن من عذب مورد",86,"د",1,0],["أيا حَزَني ما دمتُ في الكونِ شأذباً","ويا أسفي ما القلب غابت مطائبُه",87,"ب",2,0],["أَيا حاكِماً رغماً علينا فجد لنا","بجمعٍ لشملٍ شتّ وانعم بعودةِ",88,"ه",1,0],["أيا حسنَ الوجهِ وال","مُجَّردِ والمحتضَن",89,"ن",1,1],["أيا حسينٌ وسليل الحسين","إنىَ عبدٌ لك من دون مَين",90,"ن",1,1],["أيا حادي حداة الموت سمّعني حداة الموت","على موّال من له عوّدت ريح الصبا سختيت",91,"ت",1,1],["أيا حسن الطباع وكل نظم","نزاوله فقرآن مجيد",92,"د",1,0],["اي احبه حب شاعر حق اديبه","الرزانه عندها سهول وصروحي",93,"ح",2,0],["أيا حقلي وسوسن أمنياتي","لقد أضرمتِ في الحقل العذابا",94,"ب",2,0],["أَيا حُسْناً تجسَّدَ في مَلاكٍ","ويا رَجلاً تعذَّر أن يُضاهى",95,"ا",3,0],["أيا حبُ إنك سرُ القلوب","وقبلةُ قلبي منذُ القِدمْ",96,"م",1,0],["أيا حبُ هذا زمانُ به","يُلامُ المحبُ وكم يتهمْ",96,"م",1,0],["أيا حمداً قد كنت فينا بقية","من النور نور الدين فانهد طوره",97,"ر",2,0],["أيا حمد أنت الذي كل نسجه","سوابغ تُلوى بالمفللة البُتر",98,"ر",1,0],["أيا حَلَبَ العِزِّ التَّليدِ أنا هُنا","هُمومي جِسَامٌ والتَّصَبُّرُ أهْزَلُ",99,"ل",1,0],["أيا حشرجاتٍ بصدرِ الجحيمِ","أجفَّ الأوارُ، وذابَ الرَّمَقْ؟",100,"ق",1,0],["أيا حجة الاسلام يا علم الهدى","ومولى الورى بل مرجع الحاضر البادي",101,"ي",1,1],["أيا حُبَّ خُذْني لِأرْض العِناق","فَمَنْفاي رُوحٌ تُطالِعُ دَرْبَهْ",102,"ب",2,0],["ايا حبا يظللني ويملي","على قلبي التعلق والتخلي",103,"ل",2,0],["أيا حراً..يطبّب ألف جرحٍ","بقبضته إذا ماالشرُ جالا",104,"ل",2,0],["أيا حنّان ساعده","فهذا الطفلُ يعنيني",105,"ن",2,0],["أيا حنانُ فارزقه","من الخيراتِ والدين",105,"ن",1,0],["أيا حباً به وضأتُ روحي","به سكنت غزالتك الشرودُ",106,"د",1,0],["أيا حاضرا في الروح كيف يُغيّبُ؟","وياغائبا في النبض أنت المقرّبُ",107,"ب",1,0],["أَيَا حَبِيبِ أَنِينُ الشَّوْقِ أَتْعَبَنِي","إِنْ أَنْتَ فَارَقْتَنَا البُعْدُ قَدْ حَرَقَا",108,"ق",2,0],["ايا حبة الخفاق مذ غيّم الهوى","وامطرها وجدا كما النار توقدُ",109,"د",1,0],["أيا حرفا تسامى في الليالي","كبدرٍ قد علا قممَ الجبالِ",110,"ل",1,0],["أيّ إحسا