","https://www.poetsgate.com/ViewPoem.aspx?id=187585",""],[5277,"حارَ الطبيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=188891",""],[5277,"معارضةُ يائيةِ ابنُ الفارض..(2)","https://www.poetsgate.com/ViewPoem.aspx?id=198961",""],[5281,"مُقلةُ الحُسْنِ..رسولنا محمدٌ صلى الله عليه وسلَّم","https://www.poetsgate.com/ViewPoem.aspx?id=200143",""],[5282,"بسمة العين ولثمة الكأس","https://www.poetsgate.com/ViewPoem.aspx?id=214177",""],[592,"تلألأ نور الحق في الخلق وانتشر","https://www.poetsgate.com/ViewPoem.aspx?id=128721",""],[5397,"زها زمنا روض الشبيبة مونقا","https://www.poetsgate.com/ViewPoem.aspx?id=157957",""],[5419,"باحس إني باضيع مني","https://www.poetsgate.com/ViewPoem.aspx?id=32491",""],[5431,"أجمل القول ماارتضته العقولُ","https://www.poetsgate.com/ViewPoem.aspx?id=198172",""],[5431,"شهاب الشعر والأدب","https://www.poetsgate.com/ViewPoem.aspx?id=198555",""],[709,"أَتُنْكِرُ بَأْسَ أَحْدَاقِ الْعَذَارَى","https://www.poetsgate.com/ViewPoem.aspx?id=2929",""],[5490,"عقد الروح","https://www.poetsgate.com/ViewPoem.aspx?id=176377",""],[5582,"أَسْيانُ فِي الحُبِّ صَبٌّ قَلْبُهُ لَهِفُ","https://www.poetsgate.com/ViewPoem.aspx?id=187182",""],[482,"أشاقكَ مِن غرامِكَ ما يشوقُ","https://www.poetsgate.com/ViewPoem.aspx?id=111409",""],[5628,"الولادة الجديدة","https://www.poetsgate.com/ViewPoem.aspx?id=178478",""],[5628,"الخروج من القمقم","https://www.poetsgate.com/ViewPoem.aspx?id=178500",""],[5648,"احساس مجنون","https://www.poetsgate.com/ViewPoem.aspx?id=154543",""],[5648,"وش فيك ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=154660",""],[5732,"ياغزال الريم ياظبي الفلا","https://www.poetsgate.com/ViewPoem.aspx?id=177889",""],[5848,"محراب صمتك","https://www.poetsgate.com/ViewPoem.aspx?id=53163",""],[5848,"بديت اختنق","https://www.poetsgate.com/ViewPoem.aspx?id=53326",""],[5885,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=194688",""],[5953,"سئمت المقام بنادي حلب","https://www.poetsgate.com/ViewPoem.aspx?id=93858",""],[391,"هلْ لهذا القلبِ سمعٌ أوْ بصرْ","https://www.poetsgate.com/ViewPoem.aspx?id=4652",""],[6056,"القلب والنفس خضراء","https://www.poetsgate.com/ViewPoem.aspx?id=130182",""],[6069,"سرى طيف الأحبة من بعيد","https://www.poetsgate.com/ViewPoem.aspx?id=105657",""],[6082,"عام جديد","https://www.poetsgate.com/ViewPoem.aspx?id=60780",""],[6202,"يا أبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86763&r=&rc=64",""],[6229,"مي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65188&r=&rc=14",""]],"verses":[["باحَ بِالمُضمَرِ الدَفي","نِ لِسانٌ مِنَ النَفَس",0,"س",1,1],["بأحْضَرَ وَثبَةً مِنْهُ إذا ما","رأى إغْضاءَهُ يَلِدُ التّعَدّي",1,"د",2,0],["بِأَحسَنِ صورَةٍ وَأَتَمَّ خَلقٍ","يُزَيِّنُ حُسنَها دَلٌ مَليحُ",2,"ح",1,0],["بِأَحكامٍ وَآثارٍ وَفِقهٍ","كَآياتِ الزَبورِ عَلى الصَحيفَه",3,"ف",2,0],["باحَتْ بِما تُخْفي وناحَتْ في الدُّجى","فرأيْتُ في الآفاقِ دعْوَةَ نُوحِ",4,"ح",1,0],["بِأَحسَنَ مِنهَ يَومَ قامَ نَواعِمٌ","فَأَنكَرنَ لَمّا واجَهَتهُنَّ حالَها",5,"ل",3,0],["باحِثاً عَن بَناتِهِ وَبَنيهِ","مُسرِعَ الخَطوِ مُستَطيرَ الجَنانِ",6,"ن",1,0],["بِأَحسَنَ وَجهاً مِن حَبيبي مُقَطَّباً","فَكَيفَ إِذا عايَنتَهُ مُتَبَسِّما",7,"م",2,0],["بِأَحلامٍ مُوَقَّرَةٍ إِذا ما","تَزَعزَعَ يَذبُلٌ وَهَفا قُساسُ",8,"س",1,0],["بِأَحسَنَ مِنها سُنَّةً وَمُقَلَّداً","إِذا ما بَدَت لَبّاتُها وَنَظيمُها",9,"م",3,0],["بِأَحسَنَ مِنها مُقلَةً وَمُقَلَّداً","وجيداً إِذا دانَت تَنوطُ شِكالَها",10,"ل",3,0],["بِأَحسَنَ مِنها وَإِن أَدبَرَت","فَإِرخٌ بِجُمَّةَ تَقرو خَميلا",11,"ل",2,0],["بِأَحسَنَ مِن أَمّ الحُوَيرثِ سُنَّةً","عَشِيَّةَ دَمعي مُسبِلٌ مُتَبادِرُ",12,"ر",1,0],["بِأَحسَنَ مِن خَرقاءَ لَمّا تَعَرَّضَت","لَنا يَومَ عيدٍ لِلخرائِدِ شائِفِ",13,"ف",1,0],["بِأَحسَنَ مِن مَيٍّ عَشيَّةَ حاولَت","لِتَجعَلَ صَدعاً في فُؤادِكَ أَو وَقرا",14,"ر",2,0],["باحت أناملك اللدان بكل ما","كان المتيم في هواه قد سَتَرْ",15,"ر",1,0],["بِأَحسَنَ مِنها يَومَ قالَت أَلا تَرى","لِمَن حَولَنا فيهِم غَيورٌ وَنافِسُ",16,"س",1,0],["بِأَحسَنَ مِنها يَومَ قالَت أَناظِرٌ","إِلى اللَيلِ بَعضَ النَيلِ أَم أَنتَ عاجِلُه",17,"ل",2,0],["بِأَحِزَّةِ الثَلَبوتِ يَربَأُ فَوقَها","قَفرَ المَراقِبِ خَوفُها آرامُها",18,"م",3,0],["بأحكامِكم تَمضِي السيوف مضاءها","وتقضي قضاياها الرماحُ المداعِس",19,"س",1,0],["باحتْ بأطرافٍ لها نُقُبٌ","فبدَتْ وسائرُها بمُكْتَتَمِ",20,"م",1,0],["بِأَحسَنَ مِنها يَومَ قالَت كُلَيمَةً","أَتَصرِمُ حَبلي أَم تَدومُ عَلى الوَصلِ",21,"ل",1,0],["بِأَحسَنَ مِنها يَومَ قامَت فَأَعرَضَت","تُواري الدُموعَ حينَ جَدّا اِنحِدارُها",22,"ر",3,0],["بِأَحناءِ مَجهولٍ تَعاوى سِباعُهُ","تَقَوَّضَ حَتّى صارَ لِلطَيرِ أَدرَما",23,"م",2,0],["بِإِحدى قَياقِ الحَزنِ في يَومِ قُتمَةٍ","وَضاحي السَرابِ بَينَنا يَتَضَحضَحُ",24,"ح",1,0],["بِأَحسَنَ مِن هِندٍ وَلا ضَوءُ مُزنَةٍ","جَلا البَرقُ عَنها في مُكَلَّلَةٍ فَردِ",25,"د",1,0],["بِأَحسَنَ مِنها يَومَ قالَت وَعِندَنا","مِنَ الناسِ أَوباشٌ يُخافُ شُغوبُها",26,"ب",3,0],["بِأَحاديثِكَ الَّتي","هِيَ لِلعَقلِ مَفسَدَة",27,"د",2,0],["بِأَحمَدَ أَحمَدنا الزَمانَ وَأَسهَلَت","لَنا هَضَباتُ المَطلَبِ المُتَوَعِّرِ",28,"ر",1,0],["بِإِحكامِ مَبانيهِ وَإِبداعِ","مَعانيهِ وَلا يوجَدُ مَغموزا",29,"ز",2,0],["بِأَحلامِهِم يُنهى الجَهولُ فَيَنتَهي","وَهُم حُكَماءُ الناسِ لِلمُتَعَمِّدِ",30,"د",1,0],["بِأَحسَنَ مِن ظَمياءَ يَومَ لَقيتُها","وَلا مُزنَةٌ راحَت غَمامَتَها قَصرا",31,"ر",2,0],["بِأَحْمَرَ مُبْيَضِّ الزُّجَاجِ كَأَنَّهُ","رِدَاءُ عَرُوسٍ مُشْرَبٌ بِخَلُوقِ",32,"ق",1,0],["بِأَحسَنَ مِنهُ كَلَّلَ السَيفُ وَجهَهُ","دَماً في سَبيلِ اللَهِ حَتّى قَضى صَبرا",33,"ر",2,0],["بِاِحمِرارٍ يَدُبُّ في يَقَقِ الما","ءِ دَبيبَ التَضريجِ في الوَجَناتِ",34,"ت",1,0],["باحَت أَسِرَّةُ وَجهِها بِسَرائِرٍ","ضاقَت صُدورُ الناسِ عَن كِتمانِها",35,"ن",3,0],["بإحدى الرزايا ابكِ الرزايا جميعها","كذلك يدعو غائبُ الحزنِ ماثلُهْ..",36,"ل",2,0],["بِأَحاظي الجُدودِ لا بَل بِوَش","كِ الجِدِّ لا بَل بِسُؤدَدِ الأَجدادِ",37,"د",1,0],["بِأَحسَنَ مُقلَةً مِنها","إِذا بَرَزَت وَلا عُنُقا",38,"ق",2,0],["بِأَحسَنَ مِنها غَداةَ الغَميمِ","إِذا أَبدَتِ الخَدَّ وَالحاجِبا",39,"ب",2,0],["بِأَحسَنَ مَرأى مِن حِلاكَ لِناظِرٍ","وَأَعطَرَ نَشراً مِن ثَناكَ لِناظِمِ",40,"م",1,0],["بِأَحسَنَ مِنها أَو تَزيدَ مَلاحَةً","عَلى ذاكَ أَو راءى المُحِبُّ فَما أَدري",41,"ر",2,0],["بِأَحسَنِ مِن لَيلى وَلا مُكفَهِرَّةٌ","مِنَ المُزنِ شَقَّ اللَيلُ عَنها اِزدِرارُها",42,"ر",3,0],["بِأُحسَنَ مِن لَيلى مِعُيدَةَ نَظرَةٍ","إِلَيَّ اِلتِفاتاً حينَ وَلَّت بِها السَفرُ",43,"ر",1,0],["بِأَحسَنَ مِن لَيلى وَلا أَمَّ فَرقَدِ","غَضيضَةُ طَرفٍ رَعيُها وَسطَ رَبرَبِ",44,"ب",1,0],["باحَت بِمَكتومِ البَلاءِ وَقائِعٌ","مَوَّهنَ عَنهُ بِظاهِرٍ لَم يُكتَمِ",45,"م",1,0],["باحَ يا قَومُ مَن أُحِبُّ بِتَركي","فَدَعوني أَبكي عَلَيهِ وَأَبكي",46,"ي",1,1],["باحَ به سري وأخفيته","وصرتُ من اجل الهوى أستكين",47,"ن",1,0],["بأحْسَنَ منها حِينَ نَصّتْ سَوالِفاً","تَرُوغُ إلى أتْرابِها وتَحِيدُ",48,"د",1,0],["بِأَحسَنَ مِنهُ مَنظَراً زانَ مُخبِراً","بَلِ الظَبيُ مِنهُ شابَهَ الجيدَ وَالنَحرا",49,"ر",2,0],["باحثاً في قصيّ تلك الحزون","ليُداري جماله الفتّانا",50,"ن",2,0],["بَاحِثاً عَنْ قَدِيمِهَا مُسْتَفِيداً","عِبَراً مِنْ تَبَدُّلِ الأَشْيَاءِ",51,"ا",2,0],["بِإِحْسَانٍ تَجُودُ بِهِ","وَتَكْفِيرٍ عَنِ الشَّرِّ",52,"ر",1,0],["بِأَحَادِيثَ لاَ يَزُدْنَكَ إِلاَّ","ظَمَأً أَوْ نزاد مِنَهَا شَرَابَا",53,"ب",2,0],["با حَبيبُ الإِلهِ لَولا المَنايا","لَشَفى مِنكَ ما أعلَّ الطَبيبا",54,"ب",2,0],["باحثٌ لا يصيدُ في مَهْمَهِ الع","لم سوى الشارداتِ من آبداته",55,"ت",2,0],["بأحبَّ من نادٍ يزيِّ","نه بطلعته «نجيب»",56,"ب",1,0],["بأحبّ من معنى كري","مٍ صِيغ في لفظٍ كريمِ",57,"م",1,0],["بإحدى الرزايا والرزايا جميعها","كذلك يدعو غائب الحزن ماثله",58,"ل",2,0],["باحث عن قتله يعدو على","مدية الذبح إلى قاتله",59,"ل",2,0],["باحسنَ مما أجاد القريض","وحلاه هذا الكلامُ الرشيق",60,"ق",1,0],["بأَحْسَنَ مِنْهَا، وإنْ أَدبرَتْ","فإرْخٌ بجُبّة َ تَقُرو خَمِيلا",61,"ل",2,0],["بأَحرفٍ يخطها في شعري","يمحو بها غضَّ الشباب النضر",62,"ر",1,0],["باحُسنَها جنَّة ً في الماء سابحة ً","تلقى النَّعيمَ بها والحورَ والعينا",63,"ن",2,0],["بإحدى الرزايا أبكي الرزايا جميعها","كذلك يدعو غائب الحزن ماثله",64,"ل",2,0],["بِأَحْسَنَ مِنْهَا غَدَاة َ الغَمِيمِ","إذْ أبدتِ الخدَّ والحاجبا",65,"ب",2,0],["باحيا علوم الدين أفنيت مدةً","من العمر حتى نلت فنا من الدين",66,"ن",1,1],["بأحبابك العارفين الكرام","وعشاقك الوافرين الغرام",67,"م",1,0],["بِأَحسَنَ مِن سُلَيمى إِذ تَراءَت","إِذا ما ريعَ مِن سَدَفٍ فَعاما",68,"م",2,0],["بِأَحسنَ مِن ظَعائِنَ آلِ سَلمى","غَداةَ نَهَلنَ ضاحِيَةً سَناما",68,"م",2,0],["بأحسنَ مِن صوتِ الخليلِ محمدٍ","إذَا حُمَّ لِلفُتيَانِ وَقتُ التَّغُرُّدِ",69,"د",1,0],["بِأَحمَدَ لَمّا أَن شَدَدتُ مَطِيَّتي","بِرَحلي وَقَد وَدَّعتُهُ بِسَلامِ",70,"م",1,0],["بِإِحرازِكَ الفَضلَ الَّذي بَهَرَ الخَلقا","فَرَعتَ ذُرى المَجدِ الَّتي لَم تَكُن تُرقا",71,"ق",2,1],["بِإِحكامِ خُرصانٍ وَأَحكامِ سورَةٍ","وَإِجمالِ أَخلاقٍ وَأَجمَلِ صورَةٍ",72,"ه",1,0],["بَاحَ بِما قَدْ كَتَما","لَمَّا جَرى الدَّمْعُ دَمَا",73,"م",2,1],["بِأَحسَنَ مِنها يَومَ قَالَت وَحَولَنا","مِنَ النَّاسِ أَو شابٌ يُخافُ شَغُوبُهَا",74,"ب",3,0],["بِأحسنً مِنهَا يَومَ جالَ وِشاحُها","واَحسنَ منها يَومَ جالت عُقودُها",75,"د",3,0],["باح بالمكنون من سر","ك تصريح يبوح",76,"ح",1,0],["بأحمدَ نالوا العزّ فذّاً وتوأما","عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما",77,"م",2,0],["بِأَحسَنَ مِنها إِذا ما عَلا","نَقائِبُ مِن حَليِها رَفرَفُ",78,"ف",1,0],["بِأُحدٍ وَأَسيافُنا فيهِمُ","تَلَهَّبُ كَاللَهَبِ الموهِجِ",79,"ج",1,0],["باحمد الاسم قد فاق الورى كرما","وفعله كأبيه فهو محمود",80,"د",1,0],["بأحنائها الحور موقوفة","على من له درهم طيب",81,"ب",1,0],["بأحمرَ قانٍ وذي زُرقةٍ","واصفَر في لونه فاقعِ",82,"ع",1,0],["بِإحْدى هذِه الخيْماتِ جارَهْ","تَرى هجْرِي وتعْذِيبي تِجَارَهْ",83,"ر",2,1],["بِأَحقيها المُلاءُ مَحَزَّماتٍ","كَأَنَّ جِذاعَها أُصُلاً جِلامُ",84,"م",1,0],["بِأَحرَزَ مَوئِلاً مِن جارِ أَوسٍ","إِذا ما ضيمَ جيرانُ الضِعافِ",85,"ف",1,0],["بِأَحسَنَ مِنها إِذ تَراءَت وَذو الهَوى","حَزينٌ وَلَكِنَّ الخَليطَ تَجَنَّبوا",86,"ب",3,0],["باحتراز عن بنيها وحكم الد","دهر يوهي ويوهن التحريزا",87,"ز",2,0],["بأحَدَّ وأبهرَ مِن نَظَرٍ","إن صادَفَت الحدقُ الحدَقا",88,"ق",2,0],["بِأَحمَد وَالسَبطين مِن خَير مُحَمَدِ","يسرك ان اوما لي لخط كاتِبا",89,"ب",2,0],["بأحسن من في الكون خلقا وَخلقة","وأطيبهم اصلا وَفرعا وَمولدا",90,"د",2,0],["بِأَحسَنَ مِنهُ وَقَد أَتلَعَت","إِلَيهِ وَلا خشفَها إِذ تَلاها"