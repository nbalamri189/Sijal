"],[388,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[388,"عسى فرج من المولى القريب","https://www.aldiwan.net/poem54637.html","عموديه"],[393,"ألا حي سلمى في الخليط المُفارق","https://www.aldiwan.net/poem602.html",""],[397,"أسد الشيشان","https://www.aldiwan.net/poem6792.html","عموديه"],[400,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[406,"باحت بسرك أدمع تكف","https://www.aldiwan.net/poem32563.html","أحذ الكامل"],[406,"باح بشكوى ما به فاستراح","https://www.aldiwan.net/poem32606.html","السريع"],[413,"ضحك البرق فأبكاني دما","https://www.aldiwan.net/poem54130.html","الرمل"],[416,"طربت وعناك الهوى والتطربُ","https://www.aldiwan.net/poem404.html",""],[426,"باح الفؤاد بسر كنت أخفيه","https://www.aldiwan.net/poem41067.html","البسيط"],[436,"هنيئا لنا ولأقصى العباد","https://www.aldiwan.net/poem34777.html","المتقارب"],[450,"أتت أسماء ساحبة رداها","https://www.aldiwan.net/poem13950.html","الوافر"],[456,"أيا سكر الزمان متى تفيق","https://www.aldiwan.net/poem56099.html","الوافر"],[456,"دل عى الخير وأنبائه","https://www.aldiwan.net/poem56160.html","السريع"],[459,"أقم يا حسامي في صوانك واهجم","https://www.aldiwan.net/poem15092.html","الطويل"],[459,"وإني وإن كف الأسى غرب مقولي","https://www.aldiwan.net/poem16393.html","الطويل"],[462,"باحت بنجد وهوى غزلانها","https://www.aldiwan.net/poem3273.html","عموديه"],[462,"قف بالمنازل أو كناس ظبائها","https://www.aldiwan.net/poem3275.html","عموديه"],[468,"فما بيضة بات الظليم يحفها","https://www.aldiwan.net/poem4775.html","الطويل"],[468,"وما زال من قلبي لسودة ناصر","https://www.aldiwan.net/poem4847.html","الطويل"],[475,"حمام بأعلى الجلهتين ينوح","https://www.aldiwan.net/poem15261.html","الطويل"],[475,"ولوع بتذكار الأحبة لا يفنى","https://www.aldiwan.net/poem15292.html","الطويل"],[475,"نسيم عن الأحباب هب معطرا","https://www.aldiwan.net/poem15294.html","الطويل"],[475,"أذال على بالي الرسوم المدامعا","https://www.aldiwan.net/poem15322.html","الطويل"],[484,"ألا إن عيني بالبكاء تهلل","https://www.aldiwan.net/poem465.html",""],[514,"تجنبت ليلى حين لج بك الهوى","https://www.aldiwan.net/poem48719.html","الطويل"],[549,"فما ماء مزن بات جفن سحابة","https://www.aldiwan.net/poem47897.html","الطويل"],[585,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"]],"verses":[["باحَ بِالمُضمَرِ الدَفي","نِ لِسانٌ مِنَ النَفَس",0,"س",1,1],["بأحْضَرَ وَثبَةً مِنْهُ إذا ما","رأى إغْضاءَهُ يَلِدُ التّعَدّي",1,"ي",1,0],["بِأَحسَنِ صورَةٍ وَأَتَمَّ خَلقٍ","يُزَيِّنُ حُسنَها دَلٌ مَليحُ",2,"ح",1,0],["بِأَحكامٍ وَآثارٍ وَفِقهٍ","كَآياتِ الزَبورِ عَلى الصَحيفَه",3,"ف",2,0],["باحَتْ بِما تُخْفي وناحَتْ في الدُّجى","فرأيْتُ في الآفاقِ دعْوَةَ نُوحِ",4,"ح",1,0],["بِأَحسَنَ مِنهَ يَومَ قامَ نَواعِمٌ","فَأَنكَرنَ لَمّا واجَهَتهُنَّ حالَها",5,"ل",3,0],["باحِثاً عَن بَناتِهِ وَبَنيهِ","مُسرِعَ الخَطوِ مُستَطيرَ الجَنانِ",6,"ن",1,0],["بِأَحسَنَ وَجهاً مِن حَبيبي مُقَطَّباً","فَكَيفَ إِذا عايَنتَهُ مُتَبَسِّما",7,"م",2,0],["بِأَحلامٍ مُوَقَّرَةٍ إِذا ما","تَزَعزَعَ يَذبُلٌ وَهَفا قُساسُ",8,"س",1,0],["بِأَحسَنَ مِنها سُنَّةً وَمُقَلَّداً","إِذا ما بَدَت لَبّاتُها وَنَظيمُها",9,"م",3,0],["بِأَحسَنَ مِنها مُقلَةً وَمُقَلَّداً","وجيداً إِذا دانَت تَنوطُ شِكالَها",10,"ل",3,0],["بِأَحسَنَ مِنها وَإِن أَدبَرَت","فَإِرخٌ بِجُمَّةَ تَقرو خَميلا",11,"ل",2,0],["بِأَحسَنَ مِن أَمّ الحُوَيرثِ سُنَّةً","عَشِيَّةَ دَمعي مُسبِلٌ مُتَبادِرُ",12,"ر",1,0],["بِأَحسَنَ مِن خَرقاءَ لَمّا تَعَرَّضَت","لَنا يَومَ عيدٍ لِلخرائِدِ شائِفِ",13,"ف",1,0],["بِأَحسَنَ مِن مَيٍّ عَشيَّةَ حاولَت","لِتَجعَلَ صَدعاً في فُؤادِكَ أَو وَقرا",14,"ر",2,0],["باحت أناملك اللدان بكل ما","كان المتيم في هواه قد سَتَرْ",15,"ر",1,0],["بِأَحسَنَ مِنها يَومَ قالَت أَلا تَرى","لِمَن حَولَنا فيهِم غَيورٌ وَنافِسُ",16,"س",1,0],["بِأَحسَنَ مِنها يَومَ قالَت أَناظِرٌ","إِلى اللَيلِ بَعضَ النَيلِ أَم أَنتَ عاجِلُه",17,"ل",2,0],["بِأَحِزَّةِ الثَلَبوتِ يَربَأُ فَوقَها","قَفرَ المَراقِبِ خَوفُها آرامُها",18,"م",3,0],["بأحكامِكم تَمضِي السيوف مضاءها","وتقضي قضاياها الرماحُ المداعِس",19,"س",1,0],["باحتْ بأطرافٍ لها نُقُبٌ","فبدَتْ وسائرُها بمُكْتَتَمِ",20,"م",1,0],["بِأَحسَنَ مِنها يَومَ قالَت كُلَيمَةً","أَتَصرِمُ حَبلي أَم تَدومُ عَلى الوَصلِ",21,"ل",1,0],["بِأَحسَنَ مِنها يَومَ قامَت فَأَعرَضَت","تُواري الدُموعَ حينَ جَدّا اِنحِدارُها",22,"ر",3,0],["بِأَحناءِ مَجهولٍ تَعاوى سِباعُهُ","تَقَوَّضَ حَتّى صارَ لِلطَيرِ أَدرَما",23,"م",2,0],["بِإِحدى قَياقِ الحَزنِ في يَومِ قُتمَةٍ","وَضاحي السَرابِ بَينَنا يَتَضَحضَحُ",24,"ح",1,0],["بِأَحسَنَ مِن هِندٍ وَلا ضَوءُ مُزنَةٍ","جَلا البَرقُ عَنها في مُكَلَّلَةٍ فَردِ",25,"د",1,0],["بِأَحسَنَ مِنها يَومَ قالَت وَعِندَنا","مِنَ الناسِ أَوباشٌ يُخافُ شُغوبُها",26,"ب",3,0],["بِأَحاديثِكَ الَّتي","هِيَ لِلعَقلِ مَفسَدَة",27,"د",2,0],["بِأَحمَدَ أَحمَدنا الزَمانَ وَأَسهَلَت","لَنا هَضَباتُ المَطلَبِ المُتَوَعِّرِ",28,"ر",1,0],["بِإِحكامِ مَبانيهِ وَإِبداعِ","مَعانيهِ وَلا يوجَدُ مَغموزا",29,"ز",2,0],["بِأَحلامِهِم يُنهى الجَهولُ فَيَنتَهي","وَهُم حُكَماءُ الناسِ لِلمُتَعَمِّدِ",30,"د",1,0],["بِأَحسَنَ مِن ظَمياءَ يَومَ لَقيتُها","وَلا مُزنَةٌ راحَت غَمامَتَها قَصرا",31,"ر",2,0],["بِأَحْمَرَ مُبْيَضِّ الزُّجَاجِ كَأَنَّهُ","رِدَاءُ عَرُوسٍ مُشْرَبٌ بِخَلُوقِ",32,"ق",1,0],["بِأَحسَنَ مِنهُ كَلَّلَ السَيفُ وَجهَهُ","دَماً في سَبيلِ اللَهِ حَتّى قَضى صَبرا",33,"ر",2,0],["بِاِحمِرارٍ يَدُبُّ في يَقَقِ الما","ءِ دَبيبَ التَضريجِ في الوَجَناتِ",34,"ت",1,0],["باحَت أَسِرَّةُ وَجهِها بِسَرائِرٍ","ضاقَت صُدورُ الناسِ عَن كِتمانِها",35,"ن",3,0],["بِأَحاظي الجُدودِ لا بَل بِوَش","كِ الجِدِّ لا بَل بِسُؤدَدِ الأَجدادِ",36,"د",1,0],["بِأَحسَنَ مُقلَةً مِنها","إِذا بَرَزَت وَلا عُنُقا",37,"ق",2,0],["بِأَحسَنَ مِنها غَداةَ الغَميمِ","إِذا أَبدَتِ الخَدَّ وَالحاجِبا",38,"ب",2,0],["بِأَحسَنَ مَرأى مِن حِلاكَ لِناظِرٍ","وَأَعطَرَ نَشراً مِن ثَناكَ لِناظِمِ",39,"م",1,0],["بِأَحسَنَ مِنها أَو تَزيدَ مَلاحَةً","عَلى ذاكَ أَو راءى المُحِبُّ فَما أَدري",40,"ي",1,0],["بِأَحسَنِ مِن لَيلى وَلا مُكفَهِرَّةٌ","مِنَ المُزنِ شَقَّ اللَيلُ عَنها اِزدِرارُها",41,"ر",3,0],["بِأُحسَنَ مِن لَيلى مِعُيدَةَ نَظرَةٍ","إِلَيَّ اِلتِفاتاً حينَ وَلَّت بِها السَفرُ",42,"ر",1,0],["بِأَحسَنَ مِن لَيلى وَلا أَمَّ فَرقَدِ","غَضيضَةُ طَرفٍ رَعيُها وَسطَ رَبرَبِ",43,"ب",1,0],["باحَت بِمَكتومِ البَلاءِ وَقائِعٌ","مَوَّهنَ عَنهُ بِظاهِرٍ لَم يُكتَمِ",44,"م",1,0],["باحَ يا قَومُ مَن أُحِبُّ بِتَركي","فَدَعوني أَبكي عَلَيهِ وَأَبكي",45,"ي",1,1],["باحَ به سري وأخفيته","وصرتُ من اجل الهوى أستكين",46,"ن",1,0],["بأحْسَنَ منها حِينَ نَصّتْ سَوالِفاً","تَرُوغُ إلى أتْرابِها وتَحِيدُ",47,"د",1,0],["بِأَحسَنَ مِنهُ مَنظَراً زانَ مُخبِراً","بَلِ الظَبيُ مِنهُ شابَهَ الجيدَ وَالنَحرا",48,"ر",2,0],["باحثاً في قصيّ تلك الحزون","ليُداري جماله الفتّانا",49,"ن",2,0],["بَاحِثاً عَنْ قَدِيمِهَا مُسْتَفِيداً","عِبَراً مِنْ تَبَدُّلِ الأَشْيَاءِ",50,"ا",2,0],["بِإِحْسَانٍ تَجُودُ بِهِ","وَتَكْفِيرٍ عَنِ الشَّرِّ",51,"ر",1,0],["بِأَحَادِيثَ لاَ يَزُدْنَكَ إِلاَّ","ظَمَأً أَوْ نزاد مِنَهَا شَرَابَا",52,"ب",2,0],["با حَبيبُ الإِلهِ لَولا المَنايا","لَشَفى مِنكَ ما أعلَّ الطَبيبا",53,"ب",2,0],["باحثٌ لا يصيدُ في مَهْمَهِ الع","لم سوى الشارداتِ من آبداته",54,"ت",2,0],["بأحبَّ من نادٍ يزيِّ","نه بطلعته «نجيب»",55,"ب",1,0],["بأحبّ من معنى كري","مٍ صِيغ في لفظٍ كريمِ",56,"م",1,0],["باحسنَ مما أجاد القريض","وحلاه هذا الكلامُ الرشيق",57,"ق",1,0],["بأَحْسَنَ مِنْهَا، وإنْ أَدبرَتْ","فإرْخٌ بجُبّة َ تَقُرو خَمِيلا",58,"ل",2,0],["بأَحرفٍ يخطها في شعري","يمحو بها غضَّ الشباب النضر",59,"ر",1,0],["باحُسنَها جنَّة ً في الماء سابحة ً","تلقى النَّعيمَ بها والحورَ والعينا",60,"ن",2,0],["بِأَحْسَنَ مِنْهَا غَدَاة َ الغَمِيمِ","إذْ أبدتِ الخدَّ والحاجبا",61,"ب",2,0],["باحيا علوم الدين أفنيت مدةً","من العمر حتى نلت فنا من الدين",62,"ن",1,1],["بأحبابك العارفين الكرام","وعشاقك الوافرين الغرام",63,"م",1,0],["بِأَحسَنَ مِن سُلَيمى إِذ تَراءَت","إِذا ما ريعَ مِن سَدَفٍ فَعاما",64,"م",2,0],["بِأَحسنَ مِن ظَعائِنَ آلِ سَلمى","غَداةَ نَهَلنَ ضاحِيَةً سَناما",64,"م",2,0],["بأحسنَ مِن صوتِ الخليلِ محمدٍ","إذَا حُمَّ لِلفُتيَانِ وَقتُ التَّغُرُّدِ",65,"د",1,0],["بِأَحمَدَ لَمّا أَن شَدَدتُ مَطِيَّتي","بِرَحلي وَقَد وَدَّعتُهُ بِسَلامِ",66,"م",1,0],["بِإِحرازِكَ الفَضلَ الَّذي بَهَرَ الخَلقا","فَرَعتَ ذُرى المَجدِ الَّتي لَم تَكُن تُرقا",67,"ق",2,1],["بِإِحكامِ خُرصانٍ وَأَحكامِ سورَةٍ","وَإِجمالِ أَخلاقٍ وَأَجمَلِ صورَةٍ",68,"ه",1,0],["بَاحَ بِما قَدْ كَتَما","لَمَّا جَرى الدَّمْعُ دَمَا",69,"م",2,1],["بِأَحسَنَ مِنها يَومَ قَالَت وَحَولَنا","مِنَ النَّاسِ أَو شابٌ يُخافُ شَغُوبُهَا",70,"ب",3,0],["بِأحسنً مِنهَا يَومَ جالَ وِشاحُها","واَحسنَ منها يَومَ جالت عُقودُها",71,"د",3,0],["باح بالمكنون من سر","ك تصريح يبوح",72,"ح",1,0],["بأحمدَ نالوا العزّ فذّاً وتوأما","عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما",73,"م",2,0],["بِأَحسَنَ مِنها إِذا ما عَلا","نَقائِبُ مِن حَليِها رَفرَفُ",74,"ف",1,0],["بِأُحدٍ وَأَسيافُنا فيهِمُ","تَلَهَّبُ كَاللَهَبِ الموهِجِ",75,"ج",1,0],["باحمد الاسم قد فاق الورى كرما","وفعله كأبيه فهو محمود",76,"د",1,0],["بأحنائها الحور موقوفة","على من له درهم طيب",77,"ب",1,0],["بأحمرَ قانٍ وذي زُرقةٍ","واصفَر في لونه فاقعِ",78,"ع",1,0],["بِإحْدى هذِه الخيْماتِ جارَهْ","تَرى هجْرِي وتعْذِيبي تِجَارَهْ",79,"ر",2,1],["بِأَحقيها المُلاءُ مَحَزَّماتٍ","كَأَنَّ جِذاعَها أُصُلاً جِلامُ",80,"م",1,0],["بِأَحرَزَ مَوئِلاً مِن جارِ أَوسٍ","إِذا ما ضيمَ جيرانُ الضِعافِ",81,"ف",1,0],["بِأَحسَنَ مِنها إِذ تَراءَت وَذو الهَوى","حَزينٌ وَلَكِنَّ الخَليطَ تَجَنَّبوا",82,"ب",3,0],["باحتراز عن بنيها وحكم الد","دهر يوهي ويوهن التحريزا",83,"ز",2,0],["بأحَدَّ وأبهرَ مِن نَظَرٍ","إن صادَفَت الحدقُ الحدَقا",84,"ق",2,0],["بِأَحمَد وَالسَبطين مِن خَير مُحَمَدِ","يسرك ان اوما لي لخط كاتِبا",85,"ب",2,0],["بأحسن من في الكون خلقا وَخلقة","وأطيبهم اصلا وَفرعا وَمولدا",86,"د",2,0],["بِأَحسَنَ مِنهُ وَقَد أَتلَعَت","إِلَيهِ وَلا خشفَها إِذ تَلاها",87,"ا",3,0],["بِأَحسَنَ مِنكِ وَلا لِجَهرَك","سَ في المَكرُماتِ مُحاكٍ يُحاكي",88,"ك",2,0],["بإِحدى يديه السَّيفُ يقطرُ من دمٍ","وأُخرى يديه ينفثُ القلمُ السحرا",89,"ر",2,0],["بِأَحسَنَ مِن غَنِيَّةَ يَومَ راحَت","وَجارَتِها وَمِن أُمِّ البَنينا",90,"ن",2,0],["بإحيا علوم الدين تحيا قلوبنا","ويكشف عن غمنا وكروبنا",91,"ن",2,1],["بأحسنَ من خُطوطٍ للغَوالي","لوائحَ في خُدودٍ للغواني",92,"ي",1,0],["بأحسنَ رَميةً منها بطَرْفٍ","عشيّةَ قَوَّضَ الحيُّ الخياما",93,"