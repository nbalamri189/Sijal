{"poems":[[354,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[409,"الحمد لله الذي لا يفي","https://www.aldiwan.net/poem33643.html","السريع"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77632","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77670","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46519","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46508","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46509","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46523","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112689","الرجز"],[5376,"ولد الحبيب فنوره وضَّاء","https://www.poetsgate.com/ViewPoem.aspx?id=188484",""]],"verses":[["قالَ وَمِن أَيِّ البِلا","دِ أَنتَ قُلتُ مِن هَجَر",0,"ر",1,0],["قال وما يأتيه عمالنا","تنكره أو لست بالمنصف",1,"ف",1,0],["قالَ وَمُذ رَأَيت هَذا الذيبا","وَأَمره وَجَدته عَجيبا",2,"ب",2,0],["قالَ وَمُذ ضاقَت بِها الصُدور","وَكتبت في ذَمِّها السُطور",3,"ر",1,0],["قالَ وَما فيهِ مِن الجحود","وَالكُفر بِالرسل وَبِالمَعبود",4,"د",1,0],["قال وَما رَأَيتهُ قالَ أَجَل","ذاكَ لِنَقص فيك لَيسَ يحتمل",5,"ل",1,0],["قالَ وَما في ذاكَ قُل وأوضح","فَلَست لِلتكليف بِالمُستَصلِح",6,"ح",1,0],["قال وَما العار الَّذي يَلحقني","إِن كانَ إثم فاحش يرهقني",7,"ي",1,0],["قالَ وَما ذَلِكَ قالَ كنز","في دارِكُم حَيث تشد العنز",7,"ز",1,0],["قالَ وَمَن ذا نالَ منكَ قُل لي","وَاصدق إِذا حَدثتَني في الكُل",8,"ل",1,0],["قال وما أكتب قال البسمله","وضع ثلاثا في الكلام معمله",9,"ه",1,0],["قال وما استحيى أمام الأمم","كل اشتراط فهو تحت قدمي",10,"ي",1,0],["قالو محمد مات خلف نسوةً","ما ردهم عربٌ ولا زعماءُ",11,"ا",2,0]]}