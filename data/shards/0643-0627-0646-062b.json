{"poems":[[9,"أترحل من ليلى ولما تزود","https://www.aldiwan.net/poem21924.html","الطويل"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[54,"كأن ثناياها وما ذقت طعمها","https://www.aldiwan.net/poem27384.html","الطويل"],[72,"تعشقته ظبي الكناس إذا عطا","https://www.aldiwan.net/poem19139.html","الطويل"],[26,"صبا صبوة بل لج وهو لجوج","https://www.aldiwan.net/poem24100.html","الطويل"],[29,"ألا يا اسلما على التقادم والبلى","https://www.aldiwan.net/poem6051.html","الطويل"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[61,"ونى في التصابي بعدما كان شمرا","https://www.aldiwan.net/poem51648.html","الطويل"],[66,"من لصب أدنى البعاد وفاته","https://www.aldiwan.net/poem40641.html","الخفيف"],[31,"قد هاج حزني وعادني ذكري","https://www.aldiwan.net/poem42523.html","المنسرح"],[105,"لهان على نعاتك أن نصابا","https://www.aldiwan.net/poem42124.html","الوافر"],[105,"مهاة اللوى حسبي وحسب الهوى ذعرا","https://www.aldiwan.net/poem43381.html","الطويل"],[48,"دع الرسم الذي دثرا","https://www.aldiwan.net/poem63390.html","مجزوء الوافر"],[50,"أنى دعاه الشوق فارتاحا","https://www.aldiwan.net/poem63965.html","السريع"],[46,"نقمت الرضى حتى على ضاحك المزن","https://www.aldiwan.net/poem23626.html","الطويل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20987","الخفيف"],[193,"أهم سرى أم عاد للعين عائر","https://www.aldiwan.net/poem54405.html","الطويل"],[197,"هم الناس حى يروي الأرض مدمع","https://www.aldiwan.net/poem45406.html","الطويل"],[197,"أرى عجبا إذا أبصرت قومي","https://www.aldiwan.net/poem45634.html","الوافر"],[227,"خليلي قد ولى الظلام وهملجا","https://www.aldiwan.net/poem51194.html","الطويل"],[231,"ألا يا اسلمي ذات الدماليج والعقدِ","https://www.aldiwan.net/poem11559.html","الطويل"],[235,"أريح الصبا هبت على زهر الربا","https://www.aldiwan.net/poem18041.html","الطويل"],[259,"كأن ثناياك التي رشفها المنى","https://www.aldiwan.net/poem38215.html","الطويل"],[303,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[318,"سكر الظبي واستحد حسامه","https://www.aldiwan.net/poem67208.html","البسيط"],[351,"مطالع سعد قد تجلت كواكبه","https://www.aldiwan.net/poem40814.html","الطويل"],[367,"وصال الغواني كان أورى وأرجا","https://www.aldiwan.net/poem4286.html","الطويل"],[393,"ألا حي سلمى في الخليط المُفارق","https://www.aldiwan.net/poem602.html",""],[416,"طربت وعناك الهوى والتطربُ","https://www.aldiwan.net/poem404.html",""],[438,"أعد نظراً في السرب بالرمل من حزوي","https://www.aldiwan.net/poem14343.html","الطويل"],[466,"بديع الجمال رخيم الدلال","https://www.aldiwan.net/poem59880.html","المتقارب"],[499,"أجدك لم تعرف أثافي دمنة","https://www.aldiwan.net/poem2247.html","الطويل"],[568,"إن يوم الهباة أورثني الذل","https://www.aldiwan.net/poem59467.html","الخفيف"]],"verses":[["كَأَنَّ ثِيابَ القَومِ حَولَ عَرينِهِ","تَبابينُ أَنباطٍ لَدى جَنبِ مُحصَدِ",0,"د",1,0],["كَأَنَّ ثيابَنا مِنّا وَمِنهُم","خُضِبنَ بِأَرجوانٍ أَو طُلينا",1,"ن",2,0],["كَأَنَّ ثَناياها وَما ذُقتُ طَعمَها","لِبا نَعجَةٍ سَوَّطتَهُ بِدَقيقِ",2,"ق",1,1],["كأنَّ ثريا الأفق كفٌّ تطاولت","لتلقي له فرش الغمام وتبسطا",3,"ط",2,0],["كَأَنَّ ثِقالَ المُزنِ بَينَ تُضارِعٍ","وَشامَةَ بَركٌ مِن جُذامَ لَبيجُ",4,"ج",1,0],["كَأَنَّ ثِيابَ البَربَرِيِّ تُطيرُهُ","أَعاصِرُ ريحٍ حَرجَفٍ زَفَيانِ",5,"ن",1,0],["كانَ ثَوبي مِن حَريرٍ مُذهَبٍ أَو كانَ قِنَّب","فَلِماذا يَتَمَنّى الثَوبَ عاري لَستُ أَدري",6,"ي",1,0],["كأنَّ ثَنَائي غِبَّ جَدواه مَرتَعٌ","تبسَّمَ غِبَّ السَّارياتِ ونَوَّرا",7,"ر",2,0],["كانَ ثَبتاً قَبلَ التَفَرُّقِ لَكِن","زَعزَعَت رَوعَةُ الفِراقِ ثَباتَه",8,"ت",2,0],["كَأَنَّ ثَوباً لَمّا اِلتَقى الرَكبُ تُد","نيهِ عَلَيها يَشِفُّ عَن قَمَرِ",9,"ر",1,0],["كأنَّ ثيابَ قيصرَ أدركتني","فتلك قُروحُها تَعِدُ التَّبابا",10,"ب",2,0],["كَأَنَّ ثَراها لِلشُعوبِ تَميمَةٌ","تَقي مِن جُنونِ الجَهلِ أَو تُبطِلُ السِحرا",11,"ر",2,0],["كَأَنَّ ثِيابَهُ أَطلَع","نَ مِن أَزرارِهِ قَمَرا",12,"ر",2,0],["كَأَن ثَلجاً بَينَ أَسنانِها","مُستَشرِكاً راحاً وَتُفّاحا",13,"ح",2,0],["كأنّ ثَناياهُ أوَانِسُ يُبْتَغَى","لها حُسنُ ذِكْرٍ بالصّيانةِ والسّجنِ",14,"ن",1,0],["كأن ثوباً في السماء احترق","فلم يزل حتى استحال الأفق",15,"ق",1,0],["كأنّ ثَقِيلاً أوّلاً تُزْدَهَى به","ضَمائِرُ قوْمٍ في الخطوبِ ثِقال",16,"ل",1,0],["كانَ ثوباً لَبستُه ما أَعانَ الدَّ","هرُ منهث وكلُّ ثَوبٍ بِبالِ",17,"ل",1,0],["كَأَنَّ ثَناياها بَناتُ سَحابَةٍ","حَداهُنَّ شُؤبوبٌ مِنَ الغَيثِ باكِرُ",18,"ر",1,0],["كأنَّ ثيابَ الموتِ كنَّ بواليا","عليهِ وبالأرواحِ أمستْ تُرَقَّعُ",19,"ع",1,0],["كأنَّ ثيابهُ شدَّتْ عليهِ","كما لبستْ من الريشِ الطيورُ",20,"ر",1,0],["كأنّ ثَراه كلّما صافَح النَّدى","وهزّ نسيمُ الرِّيح ألويةَ الدُّجى",21,"ج",2,0],["كَأَنَّ ثَناياها اِغتَبَقنَ مُدامَةً","ثَوَتَ حِجَجاً في رَأسِ ذي قُنَّةٍ فَردِ",22,"د",1,0],["كأنَّ ثَناياهُم من الخَبَثِ الذي","تَحَصْرَمَ في نِيَّاتِهِمْ وتَزَبَّبا",23,"ب",2,0],["كأن ثناياك التي رشفها المنى","ونكهتها الاري الذي مازج المسكا",24,"ك",2,1],["كَأنّ ثريّاتٍ تُناط لسقفهِ","قُروطُ عروسٍ في ذَوائبها تُنطا",25,"ط",2,0],["كانَ ثَديُ الرِضا إِلَيهِ رِضاعا","وَعَلى البِرِّ وَالكَمالِ فَطامَه",26,"م",2,0],["كَأَنّ ثُريّاها الحبابُ بدا لنا","وَقَد راحَ يَجلو الراح في الكاس ساكِبُه",27,"ب",2,0],["كأن ثنائي في مسامع حُسَّدي","وقد ضمَّ أبكار المعاني وأدرجا",28,"ج",2,0],["كأن ثناياها اصطبحن مدامة","من الخمر شنا فوقها ماء بارِق",29,"ق",1,0],["كأَنَّ ثَناياها تَعلَّلنَ موهِناً","غَبيقاً مِن الصَهباءِ بَل هيَ أَعذَبُ",30,"ب",1,0],["كأن ثرياه على الرأس حاسد","يصور بطرف ما تخال به خطوى",31,"و",2,0],["كَأَنَّ ثَناياهُ نَورُ الأَقاحِ","تَفَتّحَ في وَردَةٍ مُضعَفَه",32,"ه",1,0],["كَأَنَّ ثَناياها وَبَردَ رُضابِها","هُدُوّاً نِطافٌ بِالمَسيلَةِ حَشرَجُ",33,"ج",1,0],["كان ثأري لمالك بن زهيرٍ واحداً","كان فيهم معلوما",34,"م",2,0]]}