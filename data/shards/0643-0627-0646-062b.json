{"poems":[[9,"أترحل من ليلى ولما تزود","https://www.aldiwan.net/poem21924.html","الطويل"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[56,"كأن ثناياها وما ذقت طعمها","https://www.aldiwan.net/poem27384.html","الطويل"],[74,"تعشقته ظبي الكناس إذا عطا","https://www.aldiwan.net/poem19139.html","الطويل"],[26,"صبا صبوة بل لج وهو لجوج","https://www.aldiwan.net/poem24100.html","الطويل"],[31,"ألا يا اسلما على التقادم والبلى","https://www.aldiwan.net/poem6051.html","الطويل"],[93,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[63,"ونى في التصابي بعدما كان شمرا","https://www.aldiwan.net/poem51648.html","الطويل"],[68,"من لصب أدنى البعاد وفاته","https://www.aldiwan.net/poem40641.html","الخفيف"],[33,"قد هاج حزني وعادني ذكري","https://www.aldiwan.net/poem42523.html","المنسرح"],[107,"لهان على نعاتك أن نصابا","https://www.aldiwan.net/poem42124.html","الوافر"],[107,"مهاة اللوى حسبي وحسب الهوى ذعرا","https://www.aldiwan.net/poem43381.html","الطويل"],[50,"دع الرسم الذي دثرا","https://www.aldiwan.net/poem63390.html","مجزوء الوافر"],[52,"أنى دعاه الشوق فارتاحا","https://www.aldiwan.net/poem63965.html","السريع"],[48,"نقمت الرضى حتى على ضاحك المزن","https://www.aldiwan.net/poem23626.html","الطويل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20987","الخفيف"],[199,"أهم سرى أم عاد للعين عائر","https://www.aldiwan.net/poem54405.html","الطويل"],[203,"هم الناس حى يروي الأرض مدمع","https://www.aldiwan.net/poem45406.html","الطويل"],[203,"أرى عجبا إذا أبصرت قومي","https://www.aldiwan.net/poem45634.html","الوافر"],[234,"خليلي قد ولى الظلام وهملجا","https://www.aldiwan.net/poem51194.html","الطويل"],[238,"ألا يا اسلمي ذات الدماليج والعقدِ","https://www.aldiwan.net/poem11559.html","الطويل"],[242,"أريح الصبا هبت على زهر الربا","https://www.aldiwan.net/poem18041.html","الطويل"],[266,"كأن ثناياك التي رشفها المنى","https://www.aldiwan.net/poem38215.html","الطويل"],[310,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[325,"سكر الظبي واستحد حسامه","https://www.aldiwan.net/poem67208.html","البسيط"],[358,"مطالع سعد قد تجلت كواكبه","https://www.aldiwan.net/poem40814.html","الطويل"],[374,"وصال الغواني كان أورى وأرجا","https://www.aldiwan.net/poem4286.html","الطويل"],[401,"ألا حي سلمى في الخليط المُفارق","https://www.aldiwan.net/poem602.html",""],[425,"طربت وعناك الهوى والتطربُ","https://www.aldiwan.net/poem404.html",""],[447,"أعد نظراً في السرب بالرمل من حزوي","https://www.aldiwan.net/poem14343.html","الطويل"],[473,"بديع الجمال رخيم الدلال","https://www.aldiwan.net/poem59880.html","المتقارب"],[506,"أجدك لم تعرف أثافي دمنة","https://www.aldiwan.net/poem2247.html","الطويل"],[575,"إن يوم الهباة أورثني الذل","https://www.aldiwan.net/poem59467.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122579","الوافر"],[706,"","https://poetry.dctabudhabi.ae/diwan/poem/144827","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37731","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38124","الخفيف"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96378","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59117","الطويل"],[1051,"","https://poetry.dctabudhabi.ae/diwan/poem/111542","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96662","الطويل"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47460","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50008","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101039","الطويل"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105874","الوافر"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48257","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65970","الطويل"],[2809,"","https://poetry.dctabudhabi.ae/diwan/poem/146641","الطويل"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22534","الطويل"],[3081,"","https://poetry.dctabudhabi.ae/diwan/poem/98044","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48314","المتقارب"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21413","الطويل"],[3768,"","https://poetry.dctabudhabi.ae/diwan/poem/130429","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59451","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66145","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58077","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76758","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120486","الوافر"],[4771,"وَليْلٍ تَجلَّى الصُّبح في جَنباتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=106542",""],[3591,"أوحشت باريس هذا الصيف يا قمر","https://www.poetsgate.com/ViewPoem.aspx?id=149469",""],[5112,"خلاصة العرب","https://www.poetsgate.com/ViewPoem.aspx?id=211997",""],[5213,"سل السرب يوم الظعن ما فعل السرب","https://www.poetsgate.com/ViewPoem.aspx?id=170411",""],[5582,"تَعَمَّدَنِي الخَطْبُ غَمْزاً وَقَرْعَا","https://www.poetsgate.com/ViewPoem.aspx?id=187179",""]],"verses":[["كَأَنَّ ثِيابَ القَومِ حَولَ عَرينِهِ","تَبابينُ أَنباطٍ لَدى جَنبِ مُحصَدِ",0,"د",1,0],["كَأَنَّ ثيابَنا مِنّا وَمِنهُم","خُضِبنَ بِأَرجوانٍ أَو طُلينا",1,"ن",2,0],["كَأَنَّ ثَناياها وَما ذُقتُ طَعمَها","لِبا نَعجَةٍ سَوَّطتَهُ بِدَقيقِ",2,"ق",1,1],["كأنَّ ثريا الأفق كفٌّ تطاولت","لتلقي له فرش الغمام وتبسطا",3,"ط",2,0],["كَأَنَّ ثِقالَ المُزنِ بَينَ تُضارِعٍ","وَشامَةَ بَركٌ مِن جُذامَ لَبيجُ",4,"ج",1,0],["كَأَنَّ ثِيابَ البَربَرِيِّ تُطيرُهُ","أَعاصِرُ ريحٍ حَرجَفٍ زَفَيانِ",5,"ن",1,0],["كانَ ثَوبي مِن حَريرٍ مُذهَبٍ أَو كانَ قِنَّب","فَلِماذا يَتَمَنّى الثَوبَ عاري لَستُ أَدري",6,"ي",1,0],["كأنَّ ثَنَائي غِبَّ جَدواه مَرتَعٌ","تبسَّمَ غِبَّ السَّارياتِ ونَوَّرا",7,"ر",2,0],["كانَ ثَبتاً قَبلَ التَفَرُّقِ لَكِن","زَعزَعَت رَوعَةُ الفِراقِ ثَباتَه",8,"ت",2,0],["كَأَنَّ ثَوباً لَمّا اِلتَقى الرَكبُ تُد","نيهِ عَلَيها يَشِفُّ عَن قَمَرِ",9,"ر",1,0],["كأنَّ ثيابَ قيصرَ أدركتني","فتلك قُروحُها تَعِدُ التَّبابا",10,"ب",2,0],["كَأَنَّ ثَراها لِلشُعوبِ تَميمَةٌ","تَقي مِن جُنونِ الجَهلِ أَو تُبطِلُ السِحرا",11,"ر",2,0],["كَأَنَّ ثِيابَهُ أَطلَع","نَ مِن أَزرارِهِ قَمَرا",12,"ر",2,0],["كَأَن ثَلجاً بَينَ أَسنانِها","مُستَشرِكاً راحاً وَتُفّاحا",13,"ح",2,0],["كأنّ ثَناياهُ أوَانِسُ يُبْتَغَى","لها حُسنُ ذِكْرٍ بالصّيانةِ والسّجنِ",14,"ن",1,0],["كأن ثوباً في السماء احترق","فلم يزل حتى استحال الأفق",15,"ق",1,0],["كأنّ ثَقِيلاً أوّلاً تُزْدَهَى به","ضَمائِرُ قوْمٍ في الخطوبِ ثِقال",16,"ل",1,0],["كانَ ثوباً لَبستُه ما أَعانَ الدَّ","هرُ منهث وكلُّ ثَوبٍ بِبالِ",17,"ل",1,0],["كَأَنَّ ثَناياها بَناتُ سَحابَةٍ","حَداهُنَّ شُؤبوبٌ مِنَ الغَيثِ باكِرُ",18,"ر",1,0],["كأنَّ ثيابَ الموتِ كنَّ بواليا","عليهِ وبالأرواحِ أمستْ تُرَقَّعُ",19,"ع",1,0],["كأنَّ ثيابهُ شدَّتْ عليهِ","كما لبستْ من الريشِ الطيورُ",20,"ر",1,0],["كأنّ ثَراه كلّما صافَح النَّدى","وهزّ نسيمُ الرِّيح ألويةَ الدُّجى",21,"ج",2,0],["كَأَنَّ ثَناياها اِغتَبَقنَ مُدامَةً","ثَوَتَ حِجَجاً في رَأسِ ذي قُنَّةٍ فَردِ",22,"د",1,0],["كأنَّ ثَناياهُم من الخَبَثِ الذي","تَحَصْرَمَ في نِيَّاتِهِمْ وتَزَبَّبا",23,"ب",2,0],["كأن ثناياك التي رشفها المنى","ونكهتها الاري الذي مازج المسكا",24,"ك",2,1],["كَأنّ ثريّاتٍ تُناط لسقفهِ","قُروطُ عروسٍ في ذَوائبها تُنطا",25,"ط",2,0],["كانَ ثَديُ الرِضا إِلَيهِ رِضاعا","وَعَلى البِرِّ وَالكَمالِ فَطامَه",26,"م",2,0],["كَأَنّ ثُريّاها الحبابُ بدا لنا","وَقَد راحَ يَجلو الراح في الكاس ساكِبُه",27,"ب",2,0],["كأن ثنائي في مسامع حُسَّدي","وقد ضمَّ أبكار المعاني وأدرجا",28,"ج",2,0],["كأن ثناياها اصطبحن مدامة","من الخمر شنا فوقها ماء بارِق",29,"ق",1,0],["كأَنَّ ثَناياها تَعلَّلنَ موهِناً","غَبيقاً مِن الصَهباءِ بَل هيَ أَعذَبُ",30,"ب",1,0],["كأن ثرياه على الرأس حاسد","يصور بطرف ما تخال به خطوى",31,"و",2,0],["كَأَنَّ ثَناياهُ نَورُ الأَقاحِ","تَفَتّحَ في وَردَةٍ مُضعَفَه",32,"ه",1,0],["كَأَنَّ ثَناياها وَبَردَ رُضابِها","هُدُوّاً نِطافٌ بِالمَسيلَةِ حَشرَجُ",33,"ج",1,0],["كان ثأري لمالك بن زهيرٍ واحداً","كان فيهم معلوما",34,"م",2,0],["كأن ثمودَ قد نَحَلَتهُ جِسما","لِبسطَة خَلقِه وكأنَّ عادا",35,"د",2,0],["كأن ثانيَ فجرٍ غرةٌ وضحتْ","تسيلُ في وجهِ طِرْفٍ أدهمٍ وثبا",36,"ب",2,0],["كَأَنَّ ثَناياها تَلامُعُ بارقٍ","وَمَبسِمُها الألْمى كَدرٍّ مُنظَّمِ",37,"م",1,0],["كانَ ثَبتاً وَحجّةً وَإِماماً","عارِفاً بِالحَديثِ وَالأخبارِ",38,"ر",1,0],["كأن ثناياها ذرى اقحوانةٍ","علاها ندى الشؤبوبِ ساعةَ صابا",39,"ب",2,0],["كَأنَّ ثَنَايَا الصبْحِ عِنْدَ ابْتِسَامِهِ","سَنَا طَلْعَةِ المَسْعُودِ بَيْنَ الْكَتَائِبِ",40,"ب",1,0],["كأن ثرياه نجوم تئالفت","تالق في داج من الليل حسدس",41,"س",1,0],["كأنَّ ثناياهُ إقاحة روضةٍ","سَقاها الحيا مدراره وقطارهُ",42,"ر",2,0],["كَأَنَّ ثَناياهُ أَقاحٍ وَخَدَّهُ","شَقيقٌ وَعيْنَيْهِ بَقِيَّةُ نَرْجِسِ",43,"س",1,1],["كأنّ ثناياها أعيرت سُلافةً","تصفّق من درّ الغَمام بسَلسلِ",44,"ل",1,0],["كأن ثارها في الضحى ذوب عسجد","تضاحكه في الأفق شمس أصيل",45,"ل",1,0],["كأن ثمارَهُ المَجنيَّ مِنها","سماءٌ قَد تَحَلَّت بالنُجومِ",46,"م",1,0],["كأنَّ ثَراهُ عند تعفيرِ نَابهِ","عبيرٌ أطارتْهُ الصَّبا للمفَارقِ",47,"ق",1,0],["كأن ثناياها إذا ما لثامها","تزايل ياقوت نقي مصفف",48,"ف",1,0],["كأن ثراء المال عذراء أبصرت","كفي مشيباً فهي تنفر من كفي",49,"ف",2,0],["كَأَنَّ ثَناياها العِذابَ وَريقَها","وَنشوَةَ فيها خالَطَتهُنَّ قَرقَفُ",50,"ف",1,0],["كانَ ثديي سقاءهُ حينَ يضحي","ثُمّ حجري فناؤه بالأصيلِ",51,"ل",1,0],["كأنّ ثرَيّاهُ راحةُ خَوْدٍ","تُعَوِّذُهُ خَمْسُها إذْ أضا",52,"ض",2,0],["كأَنَّ ثَناياها وَبَردَ لِثاتِها","بُعَيدَ الكَرى تَجري عَليهِنَّ قَرقَفُ",53,"ف",1,0],["كأن ثريا أفقه في انبساطها","يمين كريم لا يخاف انضمامها",54,"م",3,0],["كأنْ ثناياها إذا غرَّها الكرى","بمشمولةٍ من خمر عانةَ عُلَّتِ",55,"ت",1,0],["كانَّ ثُرَياهُ جَنَتْ في مَسِيرِها","فَصُدَّتْ بِطَغْواها ولَما تُحاسَبِ",56,"ب",1,0],["كأن ثناياها المها ومجاجهَا","كأرْيٍ إذا ما خالط الأرْيَ شعشَع",57,"ع",1,0],["كأنّ ثبوت الراسيات ثبوته","اذا خفّ من خوف الردى كل محجم",58,"م",1,0],["كأن ثناءه في الناس مسك","اذا ما صر صرا لن يسرا",59,"ر",2,0],["كأنَّ ثريَّاهُ أناملُ فِضةٍ","تُقلَّب تُرساً مِن سَنا اللّيل مُذهَبا",60,"ب",2,0],["كأن ثغرك مباح توقّد في","مكانه فأعاد الربع يزدهر",61,"ر",1,0],["كَأنَّ ثَرَاكِ فِي خَلَدي","مِنَ اليَاقُوتِ وَالذَّهَبِ",62,"ب",1,0],["كأن ثراها المسك أمسى فهذه","بأعتابها الأقيال مستافها الترب",63,"ب",1,0],["[ كأَنَّ ثَبِيراً عَلَى هامَتِي ( أَو )","شَماماً وَيَذْبُلَ أَوْ طَوْدَ صَنْعا ]",64,"ع",2,0]]}