{"poems":[[9,"أترحل من ليلى ولما تزود","https://www.aldiwan.net/poem21924.html","الطويل"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[54,"كأن ثناياها وما ذقت طعمها","https://www.aldiwan.net/poem27384.html","الطويل"],[72,"تعشقته ظبي الكناس إذا عطا","https://www.aldiwan.net/poem19139.html","الطويل"],[26,"صبا صبوة بل لج وهو لجوج","https://www.aldiwan.net/poem24100.html","الطويل"],[29,"ألا يا اسلما على التقادم والبلى","https://www.aldiwan.net/poem6051.html","الطويل"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[61,"ونى في التصابي بعدما كان شمرا","https://www.aldiwan.net/poem51648.html","الطويل"],[66,"من لصب أدنى البعاد وفاته","https://www.aldiwan.net/poem40641.html","الخفيف"],[31,"قد هاج حزني وعادني ذكري","https://www.aldiwan.net/poem42523.html","المنسرح"],[105,"لهان على نعاتك أن نصابا","https://www.aldiwan.net/poem42124.html","الوافر"],[105,"مهاة اللوى حسبي وحسب الهوى ذعرا","https://www.aldiwan.net/poem43381.html","الطويل"],[48,"دع الرسم الذي دثرا","https://www.aldiwan.net/poem63390.html","مجزوء الوافر"],[50,"أنى دعاه الشوق فارتاحا","https://www.aldiwan.net/poem63965.html","السريع"],[46,"نقمت الرضى حتى على ضاحك المزن","https://www.aldiwan.net/poem23626.html","الطويل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20987","الخفيف"]],"verses":[["كَأَنَّ ثِيابَ القَومِ حَولَ عَرينِهِ","تَبابينُ أَنباطٍ لَدى جَنبِ مُحصَدِ",0,"د",1,0],["كَأَنَّ ثيابَنا مِنّا وَمِنهُم","خُضِبنَ بِأَرجوانٍ أَو طُلينا",1,"ن",2,0],["كَأَنَّ ثَناياها وَما ذُقتُ طَعمَها","لِبا نَعجَةٍ سَوَّطتَهُ بِدَقيقِ",2,"ق",1,1],["كأنَّ ثريا الأفق كفٌّ تطاولت","لتلقي له فرش الغمام وتبسطا",3,"ط",2,0],["كَأَنَّ ثِقالَ المُزنِ بَينَ تُضارِعٍ","وَشامَةَ بَركٌ مِن جُذامَ لَبيجُ",4,"ج",1,0],["كَأَنَّ ثِيابَ البَربَرِيِّ تُطيرُهُ","أَعاصِرُ ريحٍ حَرجَفٍ زَفَيانِ",5,"ن",1,0],["كانَ ثَوبي مِن حَريرٍ مُذهَبٍ أَو كانَ قِنَّب","فَلِماذا يَتَمَنّى الثَوبَ عاري لَستُ أَدري",6,"ي",1,0],["كأنَّ ثَنَائي غِبَّ جَدواه مَرتَعٌ","تبسَّمَ غِبَّ السَّارياتِ ونَوَّرا",7,"ر",2,0],["كانَ ثَبتاً قَبلَ التَفَرُّقِ لَكِن","زَعزَعَت رَوعَةُ الفِراقِ ثَباتَه",8,"ت",2,0],["كَأَنَّ ثَوباً لَمّا اِلتَقى الرَكبُ تُد","نيهِ عَلَيها يَشِفُّ عَن قَمَرِ",9,"ر",1,0],["كأنَّ ثيابَ قيصرَ أدركتني","فتلك قُروحُها تَعِدُ التَّبابا",10,"ب",2,0],["كَأَنَّ ثَراها لِلشُعوبِ تَميمَةٌ","تَقي مِن جُنونِ الجَهلِ أَو تُبطِلُ السِحرا",11,"ر",2,0],["كَأَنَّ ثِيابَهُ أَطلَع","نَ مِن أَزرارِهِ قَمَرا",12,"ر",2,0],["كَأَن ثَلجاً بَينَ أَسنانِها","مُستَشرِكاً راحاً وَتُفّاحا",13,"ح",2,0],["كأنّ ثَناياهُ أوَانِسُ يُبْتَغَى","لها حُسنُ ذِكْرٍ بالصّيانةِ والسّجنِ",14,"ن",1,0],["كأن ثوباً في السماء احترق","فلم يزل حتى استحال الأفق",15,"ق",1,0],["كأنّ ثَقِيلاً أوّلاً تُزْدَهَى به","ضَمائِرُ قوْمٍ في الخطوبِ ثِقال",16,"ل",1,0],["كانَ ثوباً لَبستُه ما أَعانَ الدَّ","هرُ منهث وكلُّ ثَوبٍ بِبالِ",17,"ل",1,0]]}