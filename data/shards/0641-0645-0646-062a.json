{"poems":[[53,"يا مادح الحقد محتالا له شبها","https://www.aldiwan.net/poem9213.html","البسيط"],[94,"ترجو السعادة يا قلبي ولو وجدت","https://www.aldiwan.net/poem38910.html","البسيط"],[64,"لنا شيمة لا ترتضي الغدر صاحبا","https://www.aldiwan.net/poem52252.html","الطويل"],[30,"كتبت وعجلت البرادة إنني","https://www.aldiwan.net/poem1291.html",""],[60,"العلم زين فكن للعلم مكتسبا","https://www.aldiwan.net/poem30998.html","البسيط"],[82,"تغنت قيان الورق في الورق الخضر","https://www.aldiwan.net/poem31443.html","الطويل"],[42,"يا من لعين قد أجلى نومها الأرق","https://www.aldiwan.net/poem42337.html","البسيط"],[69,"لا تظلموني وتظلموا الحسبه","https://www.aldiwan.net/poem18043.html","المنسرح"],[48,"الكون في جملة العوافي","https://www.aldiwan.net/poem22211.html","مجزوء البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54751","البسيط"],[92,"أطِل مكثاً","https://www.poetsgate.com/ViewPoem.aspx?id=179234",""],[82,"تَغَنَّتْ قيانُ الوُرْقِ في الوَرَق الخُضْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=3226",""],[186,"جهد الحزين إذا صرف القضا نزلا","https://www.aldiwan.net/poem67038.html","البسيط"],[208,"حسب الأنام من الأيام ما عرفوا","https://www.aldiwan.net/poem53098.html","البسيط"],[208,"لا تكبروا من ملاح المرد إنسانا","https://www.aldiwan.net/poem53168.html","البسيط"],[208,"أشفقت من إخفاء ما لم تخفه","https://www.aldiwan.net/poem53239.html","الكامل"],[208,"ألا يا من إذا ولوه جارا","https://www.aldiwan.net/poem53266.html","الوافر"],[208,"ما لي إلى مثلك من شافع","https://www.aldiwan.net/poem53268.html","السريع"],[214,"حتام تخلف وعدي","https://www.aldiwan.net/poem13529.html","المجتث"],[275,"لقد هاج الهوى هذا الحرير","https://www.aldiwan.net/poem35446.html","الوافر"],[302,"أمير المؤمنين فدتك نفسي","https://www.aldiwan.net/poem33023.html","الوافر"],[310,"بسعيك تبلغ الرتب العظام","https://www.aldiwan.net/poem56409.html","الوافر"],[325,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[341,"فسارعوا للعلم أجمعينا","https://www.aldiwan.net/poem67804.html","عموديه"],[382,"محبة المال أشقى ما بليت به","https://www.aldiwan.net/poem59116.html","البسيط"],[396,"تجري الليالي ولا تدري بعدتها","https://www.aldiwan.net/poem54570.html","عموديه"],[409,"والله ما أخطت المنايا","https://www.aldiwan.net/poem33730.html","مخلع البسيط"],[412,"صددت أن عاد روض الرأس ذا زهر","https://www.aldiwan.net/poem50174.html","البسيط"],[415,"ما أنصفوا في الحب إذ حكموا","https://www.aldiwan.net/poem32534.html","السريع"],[447,"إليك إليك يا ربي","https://www.aldiwan.net/poem14351.html","الهزج"],[463,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[466,"يذل الجحفل الجرار بأسا","https://www.aldiwan.net/poem15440.html","الوافر"],[556,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[567,"أدار خط عذار حول وجنته","https://www.aldiwan.net/poem52527.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138202",""],[701,"","https://poetry.dctabudhabi.ae/diwan/poem/107332","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64257","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62658","الرجز"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202130","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56259","المجتث"],[1294,"","https://poetry.dctabudhabi.ae/diwan/poem/101107","السريع"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48920","المتقارب"],[1768,"","https://poetry.dctabudhabi.ae/diwan/poem/101830","الطويل"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11189","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118422","الوافر"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100469","المنسرح"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102123","الهزج"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102103","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96039","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53190","المتقارب"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104977","البسيط"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67193","الرجز"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60859","البسيط"],[2491,"","https://poetry.dctabudhabi.ae/diwan/poem/115071","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137356",""],[2957,"","https://poetry.dctabudhabi.ae/diwan/poem/198401",""],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142903","السريع"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112681","الرجز"],[3419,"","https://poetry.dctabudhabi.ae/diwan/poem/130745","الرجز"],[3481,"","https://poetry.dctabudhabi.ae/diwan/poem/112964","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52977","الرجز"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126943","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86310","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205890","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85244","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135483","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77099","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125865","الوافر"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125813","السريع"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93770","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136468",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83582","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83456","البسيط"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127937","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66223","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72460","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72445","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120486","الوافر"],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4976,"في رحاب شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=207834",""],[5010,"العشق معضلة","https://www.poetsgate.com/ViewPoem.aspx?id=190461",""],[5237,"إن شئت عيشا هنيا واتباع هدى","https://www.poetsgate.com/ViewPoem.aspx?id=113119",""],[5381,"اخفض جناحك","https://www.poetsgate.com/ViewPoem.aspx?id=215421",""],[5574,"نُوَّارتي","https://www.poetsgate.com/ViewPoem.aspx?id=206011",""],[5596,"يا إيها الشيخ الذي ينصف","https://www.poetsgate.com/ViewPoem.aspx?id=205618",""],[5667,"حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=214890",""],[5861,"معزوفة الجحيم","https://www.poetsgate.com/ViewPoem.aspx?id=188090",""],[5939,"رسالة إلى أنثى","https://www.poetsgate.com/ViewPoem.aspx?id=178589",""],[5943,"إنصافٌ وإبخاسٌ","https://www.poetsgate.com/ViewPoem.aspx?id=52312",""],[5957,"تنحى الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=176787",""],[5997,"قيم الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=214222",""],[6003,"نكبة العرب","https://www.poetsgate.com/ViewPoem.aspx?id=188949",""],[4442,"مآذن النجف اهتزت أعاليها","https://www.poetsgate.com/ViewPoem.aspx?id=171229",""],[4442,"أناخ على ذكا فخبت ضياء","https://www.poetsgate.com/ViewPoem.aspx?id=171228",""],[6308,"انكسارات آخر الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87730&r=&rc=8",""],[5922,"أَمامَ يديْ ألمانيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88227&r=&rc=2",""]],"verses":[["فمن تثاقل عن حقٍّ فبادَرَهُ","إليه خَصْمٌ سَفَى في وجهه وَحَثا",0,"ث",2,0],["فمنْ تأَلَّمَ لمْ تُرْحَمْ مَضَاضَتَهُ","ومنْ تجلَّدَ لم تهزأ بهِ القِمَمُ",1,"م",1,0],["فمن تُنقصُ الأيامُ مِرَّةَ عهدِهِ","فإنَّا على العهدِ القديم كما كُنَّا",2,"ن",2,0],["فَمِن تِلكَ أَنَّ العامِرِيَّةَ ضَمَّها","وَبَيتي نَوارَ طابَ مِنها اِقتِرابُها",3,"ب",3,0],["فَمَن تَخلَّقَ بِالآدابِ ظَلَّ بِها","رَئيسَ قَومٍ إِذا ما فارَقَ الرُؤَسا",4,"س",2,0],["فَمِن تاركٍ وَكراً إليكَ مُهاجرٍ","وَمِن مُستَقِرٍّ من جنابِكَ في وَكرِ",5,"ر",1,0],["فَمَن تَكَلَّفَ حُباً أَو تَخَلَّقَهُ","فَإِنَّ حُبَّكِ مِنّي شِيمَةٌ خُلُقُ",6,"ق",1,0],["فمنْ تَبَاهَى بأَنَّهُ وتدٌ","فلْيَحْتَمِلْ دَقَّ كلِّ مِرْزَبَّهْ",7,"ب",2,0],["فَمِن تُرابٍ إِلى تُرابٍ","وَمِن سُفاةٍ إِلى سُفاةِ",8,"ه",1,0],["فَمِنْ تَآلِيفَ لاَ تُحْصَى فَوَائِدُهَا","مَحْدُودَةٍ وَمَدَاهَا غَيْرُ مَحْدُود",9,"د",1,0],["فمِنْ تأريخِكَ الألِقِ المدَّمى","تَبينُ بهذه النُقَطِ الحُروف",10,"ف",1,0],["فمن تاركٍ وكراً إليكَ مهاجرٍ","ومن مستقرٍ من جانبكَ في وكرِ",11,"ر",1,0],["فَمَن تَركْتَ سقاكَ العَفوُ صَيِّبَهُ","لِمن تَرَكت عَليلاً فيكَ مُنتَحِلا",12,"ل",2,0],["فمَن تَعَجَّل مسلوبٌ ومُختَرَمٌ","ومَن تأخَّرَ فالإيهانُ والخَرَفُ",13,"ف",1,0],["فمن تنزَّه يوماً في محاسنه","فليس مُستحسِناً ما عاش بستانا",14,"ن",2,0],["فمن تحيَّر فيه ماء شبابه","فتحيَّرت فِطَنُ الورى في وصفِهِ",15,"ف",2,0],["فمَن تجفوه لن يرجو حياةً","ومَن واصلتَه لم يخشَ عارا",16,"ر",2,0],["فمَن تولّى عترةً قد زكت","زُكِّيَ في الدنيا وفي الآخِرهْ",17,"ر",2,0],["فمن تصدى لظلمي","حتى اباحك صدي",18,"د",2,0],["فمن تلكَ المحاسنِ لي كنوزٌ","على كفَّيَّ جَوهَرُها نثير",19,"ر",1,0],["فمن تيم بن مرّة أَو عَديٌّ","وهم سيّان إِن حضَروا وغابوا",20,"ب",3,0],["فَمَن تكنِ الرئاسةُ جمّلتهُ","فَأنتَ جَمالُها وَالإحترامُ",21,"م",1,0],["فَمُنتَهى سُؤلي مِن فَيضِ نِعمَتِهِ","حُسنُ الخِتامِ وَفي الفِردَوسِ صُحبَتُهُ",22,"ت",2,0],["فمن تعلم لماقدذكرا","فسعيه في هدم دينه جرى",23,"ر",2,0],["فمن تَريَّبَ يوماً في أمانته","يسجدْ لدى صنم المال الذي يَمِقُ",24,"ق",1,0],["فمن تغانمها بالخير فاز بها","ومن عصى الله فيها باء بالوزر",25,"ر",1,0],["فمن تعامى وكان أعمى","أنَّى لِنَيل الهدى يحوز",26,"ز",1,0],["فمن تَجِد مِنهُم يَمدحك مادحه","وَالمَدح في أَرَجِ النَوار للمطرِ",27,"ر",1,0],["فَمن تُرى يحفَظُ عهدَ الهَوى","إِن ضيَّعُوهُ وهُمُ ما هُمُ",28,"م",1,0],["فمن تربي وإن كانوا","خلاف الترب عن تربي",29,"ب",2,0],["فمن تُزَنُّ عنده","بريبةٍ أو تُرجَمُ",30,"م",1,0],["فمُنتهب السَّنابكِ والعطايا","بيوميه ثَراه والثَّراءُ",31,"ا",2,0],["فمن تكسوه عُريانٌ","ومَن تسقيه ظمآنُ",32,"ن",1,0],["فمَن تأمَّلَ لمَّا أرَّخوهُ يرَى","في صحنِ ياقوتِ وجهٍ خطَّ رَيحانِ",33,"ن",1,0],["فمن تعدّى فعله من كانا","جار على أمته وخانا",34,"ن",2,0],["فمن تعدى ذاك فيما قد حكم","لم يجز الحكم له قالوا نعم",34,"م",1,0],["فمن تخلى عن العرفان مرتفع","نحو السها وإلى هاماته وثبا",35,"ب",2,0],["فَمن تولّى فقد ولّى لهاويةٍ","تذيبُ من كان فيها هاوياً هَبَبا",36,"ب",2,0],["فمن تفاحة لم تعد خداً","ومن رمانة لم تخط ثديا",37,"ي",2,0],["فمن تزَّكى جاهلاً","فقد تردّى كذبا",38,"ب",2,0],["فمن ترى لعقلك المجرد","من مرشد هاد له مسدد",39,"د",1,0],["فمن ترى لمصابي","يرثي ويغنم أجرا",40,"ر",2,0],["فمن ترى يجحده فضله","يأبى ضياء الصبح ان يجحدا",41,"د",2,0],["فمنتحرٌ من شقاء الحياةِ","إلى هارب للردى مُزمع",42,"ع",1,0],["فمن تلق منهم تلق بحر سماحة","إذا أمه ذو حاجة لم يقل غدا",43,"د",2,0],["فَمُنتَصِبٌ مِنهُ يَثورُ عَجاجُهُ","وَآخَرُ دانٍ لِلبِلادِ سَحيلُ",44,"ل",1,0],["فمن تارى قرآن او كلام","ومن تارى الطهارة والوصايا",45,"ا",3,0],["فمن تقي محمد خلقاً","ومن حسين في الدين أعلمها",46,"م",3,0],["فمن تُدنيهِ نُدنى","ومن تُبعِدهُ ضلّا",47,"ل",2,0],["فمن تُدنهِ أدنى ومن لا فلا صبغ","اغثني وكن لي حيث ما كنت جيرني",48,"ي",1,0],["فمن ترجو لصعب الخطب يوماً","ومن ندعوه لليوم العصيب",49,"ب",1,0],["فمن تَحْتِ سورة ذاك السطا","خلائق نعصر منها المُداما",50,"م",2,0],["فمن تَذكُّرِ ظبي بالحمى كلفي","لا من تذكر جيران بذي سلم",51,"م",1,0],["فمنتُضىَ عمر الزمان سَيفه","والسيفُ لا يُرهب حتى يُنتضى",52,"ض",2,0],["فمن توجه يبغَى قِبْلةً حَرماً","فما يفاعهُ إلاّ قبْلةُ القِبَل",53,"ل",1,0],["فَمَن تَكُنِ الأسرارُ تَطفُو بِصَدرِهِ","فأسرارُ صَدري بالأحاديثِ تُغرَقُ",54,"ق",1,0],["فمن ترض عنه حظى بالمنى","وأما عداك فيلقون غيا",55,"ي",2,0],["فمن تكن قرحة بفيه","يصبر على مصه الصديدا",56,"د",2,0],["فمن ترى أهدى له اللحنا ؟","ومن ترى خلده مضنى؟",57,"ا",1,0],["فمَن ترى أولى بهذا الأمرِ","فاحكُم بوجِد إنك يا ذا الخُبِر",58,"ر",1,0],["فمنتجٌ لأوّل اربعة","كالثان ثم ثالث فستّة",59,"ه",1,0],["فمن توجَّه نحو الله منتصباً","بكَسرة القلب يبنيهِ كم العلمِ",60,"م",1,0],["فمن تركتم خطاياهً لهُ تركت","ومن عقدتم عليهِ الحرم ينحرمِ",60,"م",1,0],["فمن تعدَّى وطغى","على حماكم يُصرع",61,"ع",1,0],["فمن تربها أصلي ومبدأ نشأتي","وأرجو بها مثواي بعد وفاتي",62,"ت",2,0],["فَمن تَكاسَل لا يَحظى بِمحمدة","وَلَيسَ