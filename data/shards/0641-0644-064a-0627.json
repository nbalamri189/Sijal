{"poems":[[65,"ألا بأبي من حيل دون مزاره","https://www.aldiwan.net/poem46137.html","الطويل"],[57,"قل لفوز ردي علي السلاما","https://www.aldiwan.net/poem26109.html","الخفيف"],[95,"مصر تناديكم فمن يحجم","https://www.aldiwan.net/poem11320.html","السريع"],[49,"لئن جمعتنا غدوة أرض بالس","https://www.aldiwan.net/poem25239.html","الطويل"],[53,"بات يدعو الواحدا الصمدا","https://www.aldiwan.net/poem61930.html","المديد"],[53,"ولي أصدقاء كثيرو السلام","https://www.aldiwan.net/poem65381.html","المتقارب"],[53,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[53,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[53,"دامت لك الصالحات والنعم","https://www.aldiwan.net/poem66347.html","المنسرح"],[82,"للأقاحي بفيك نور ونور","https://www.aldiwan.net/poem31434.html","الخفيف"],[107,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[50,"ومؤاتي الطرف عف اللسان","https://www.aldiwan.net/poem65277.html","المديد"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67331","الكامل"],[132,"لله في الأرض أقوام قد اشتملوا","https://www.aldiwan.net/poem50553.html","البسيط"],[132,"إني لأعلم لا أزال معلما","https://www.aldiwan.net/poem50679.html","الكامل"],[139,"حفظت لأصحاب العلوم شؤونهم","https://www.aldiwan.net/poem48905.html","الطويل"],[146,"وددت التصابى فيك إذ كان عاذرى","https://www.aldiwan.net/poem58434.html","الطويل"],[189,"يا خليلي الهوى برح بي","https://www.aldiwan.net/poem14115.html","الرمل"],[246,"أودى بي الحزن واغتال الجوى جلدي","https://www.aldiwan.net/poem45759.html","البسيط"],[266,"هلما نحييها ربى وربوعا","https://www.aldiwan.net/poem38241.html","الطويل"],[285,"لو كنت شاهد عبرتي يوم النقا","https://www.aldiwan.net/poem60695.html","الكامل"],[287,"أما والذي يحيي الورى ويميت","https://www.aldiwan.net/poem32845.html","الطويل"],[308,"أنا والحبيب ومن يلوم ثلاثة","https://www.aldiwan.net/poem57566.html","الكامل"],[409,"إذا كان حبي أحمدا وحديثه","https://www.aldiwan.net/poem34132.html","الطويل"],[416,"أتظن يا إدريس أنك مفلت","https://www.aldiwan.net/poem67503.html","الكامل"],[438,"أهلا بطيف في الدجنة أوبا","https://www.aldiwan.net/poem12551.html","الكامل"],[438,"لولا ظبى تنسل من لحظاته","https://www.aldiwan.net/poem12779.html","الكامل"],[445,"أعيا شفاء الهم إن لم تشفه","https://www.aldiwan.net/poem34840.html","الكامل"],[482,"هي العيس دعها بي إلى حاجر تحدى","https://www.aldiwan.net/poem15248.html","الطويل"],[498,"فليالي الصبا أسر ليال","https://www.aldiwan.net/poem67307.html","الخفيف"],[569,"إسق يا غيث بكرة وعشية","https://www.aldiwan.net/poem910.html",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86646","الخفيف"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130169","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38132","الخفيف"],[1119,"","https://poetry.dctabudhabi.ae/diwan/poem/116747","الكامل"],[1157,"","https://poetry.dctabudhabi.ae/diwan/poem/102916","الكامل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115914","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95494","البسيط"],[1602,"","https://poetry.dctabudhabi.ae/diwan/poem/144528","الكامل"],[1750,"","https://poetry.dctabudhabi.ae/diwan/poem/205175","الخفيف"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96490","الكامل"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74992","الخفيف"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52031","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104821","البسيط"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42468","الطويل"],[2085,"","https://poetry.dctabudhabi.ae/diwan/poem/202201","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53189","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53042","الطويل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28067","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88643","الخفيف"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120751","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93575","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65947","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58288","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204973","الطويل"],[3318,"","https://poetry.dctabudhabi.ae/diwan/poem/138743",""],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100192","الرجز"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45754","البسيط"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205965","المجتث"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59443","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111427","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86372","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123515","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123493","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54478","الخفيف"],[4280,"","https://poetry.dctabudhabi.ae/diwan/poem/130544","البسيط"],[4296,"","https://poetry.dctabudhabi.ae/diwan/poem/103324","الكامل"],[4303,"","https://poetry.dctabudhabi.ae/diwan/poem/110655","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73188","الوافر"],[4470,"","https://poetry.dctabudhabi.ae/diwan/poem/125349","المتدارك"],[4665,"","https://poetry.dctabudhabi.ae/diwan/poem/97749","الكامل"],[4726,"رسول الله لاحظني فإني","https://www.poetsgate.com/ViewPoem.aspx?id=146650",""],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[4812,"أيها الساري","https://www.poetsgate.com/ViewPoem.aspx?id=200828",""],[4908,"صفحة جديدة","https://www.poetsgate.com/ViewPoem.aspx?id=211567",""],[4927,"حَدِيْثُ الدُّمُوْع","https://www.poetsgate.com/ViewPoem.aspx?id=29724",""],[5002,"رجع ُ الصَّدى....","https://www.poetsgate.com/ViewPoem.aspx?id=210619",""],[5136,"شوقي إلى دست الخلافة شيق","https://www.poetsgate.com/ViewPoem.aspx?id=121631",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5156,"من زار دار أحبة لحياتهم","https://www.poetsgate.com/ViewPoem.aspx?id=99155",""],[5183,"بين العزاء والبكاء","https://www.poetsgate.com/ViewPoem.aspx?id=180220",""],[5213,"ان دهراً يجنى اليك الذنوبا","https://www.poetsgate.com/ViewPoem.aspx?id=170418",""],[5248,"روح","https://www.poetsgate.com/ViewPoem.aspx?id=208824",""],[5302,"وقوف على الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=200867",""],[5324,"إلى عينيك.","https://www.poetsgate.com/ViewPoem.aspx?id=211406",""],[592,"أقول هذا كله لا يعقل","https://www.poetsgate.com/ViewPoem.aspx?id=128804",""],[5428,"أراني كُلّما قطعوا المزارا","https://www.poetsgate.com/ViewPoem.aspx?id=124932",""],[5442,"تذكر بالحمي عهداً برامه","https://www.poetsgate.com/ViewPoem.aspx?id=114756",""],[5725,"أقل العثرة","https://www.poetsgate.com/ViewPoem.aspx?id=213611",""],[5956,"يا شقرائي المحترمة","https://www.poetsgate.com/ViewPoem.aspx?id=182086",""],[5956,"أشبّه بعض أعدائي","https://www.poetsgate.com/ViewPoem.aspx?id=194027",""],[5956,"ودّعتُ حبَّه مِن صَوبي","https://www.poetsgate.com/ViewPoem.aspx?id=204250",""],[6024,"الجد","https://www.poetsgate.com/ViewPoem.aspx?id=186353",""],[5080,"بلالٌ دونَ مئذنةٍ أنايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88134&r=&rc=4",""]],"verses":[["فَلَيّاً بأعرافِ الجِيادِ على الوَجى","تَزُرْهُ هَوادي الخَيْلِ في عُقْرِ دارهِ",0,"ر",2,0],["فَلِيَ اليَومَ فَوزُ خَمسَةَ أَيّا","مٍ كَئيباً أُذري دُموعي سِجاما",1,"م",2,0],["فَلْيَأْتِ عَهْدٌ عَادِلٌ نَيِّر","وَليَمْضِ عَهْدٌ ظَالِمٌ مُظْلِمُ",2,"م",1,0],["فَلي أَبَداً قَلبٌ كَثيرٌ نِزاعُهُ","وَلي أَبَداً نَفسٌ قَليلٌ نُزوعُها",3,"ع",3,0],["فليَ الويل الطويل غداً","ليت عمري قبلها نَفِدا",4,"د",2,0],["فلي أبداً معهم وقفة","وتسليمة وقتها ضائع",5,"ع",1,0],["فليالي أميرِنا بكَ في الطِّي","بِ كأسحارِها ذواتِ الظلالِ",6,"ل",1,0],["فليأمرِ السيدُ الحُجّابَ حضرتَه","بصونِ وجهٍ مصونٍ غيرِ مبتذلِ",7,"ل",1,0],["فليأتِ في العبدِ ما تقرُّ به ال","عينُ ويُشفَى الغليلُ والسَّقم",8,"م",1,0],["فَلِيَ الشوقُ خاذلٌ عن سُلُوّي","وَلِدينِ الهدى علَيَّ نَصيرُ",9,"ر",1,0],["فَليْأخذوا ما ليس فيه لمثلهم","إلا الأَذَى ومَلامةُ العُذّالِ",10,"ل",1,0],["فَلِيَ الصَهباءُ أَبكي عَلَيها","وَالمَغاني لِبُكاةِ المَغاني",11,"ن",2,0],["فلْيأتِ مَأْسدَةً تُسَنُّ سُيُوفُها","بينَ المذادِ وبين جِزعِ الخَنْدقِ",12,"ق",1,0],["فليأتِ بالحجةِ البيضاءِ واضحةً","من الكتابِ الذي جاءت به الرسُلُ",13,"ل",1,0],["فليأتني فأنا ابن نجدتها ولم","يأْنَفْ وَيْنأَ الحقُّ من آرائى",14,"ا",2,0],["فلي أن أباهي أو أنادي مؤرخا","بواجب آل الشرع أصبحت قائما",15,"م",2,0],["فَلَيًّا بأعناقِ المطىِّ فربّما","أصبنا الأماني في صدور الأباعرِ",16,"ر",1,0],["فلَياليه حَكَتْ أيامَه","فكأنّ الشمسَ لم تَحْتجب",17,"ب",1,0],["فليأسفِ العِلمُ ولتبكيهِ أُسرته","وليهنأ الجهلُ وليشمت أولو الحَسَدِ",18,"د",1,0],["فلي أمل في اللَه لست امله","وما كنت فيما لا ينال طموعا",19,"ع",2,0],["فَلْيَأْتِنا بِأَبٍ كَمِثْلِ أَبِيكَ فِي الْ","عَلْياءِ أَو جَدٍّ كَجَدِّكَ فِي التُّقا",20,"ق",2,0],["فَلي أَنّةٌ مِن بَعدِهِ إِثرَ حنَّةٍ","فَإِن دامَ بي هَذا الغَرامُ نُعيتُ",21,"ت",1,0],["فلي الجناس لأن دمعي عن دمي","يجري ألست تراه مثل العندم",22,"م",1,0],["فلي أسوة بالمصطفى ووصيه","فقد حبسا من قبل في ذلك الشِّعْبِ",23,"ب",1,0],["فَليَأتِيَنَّكَ أَو تَحُلَّ بِبَلدَةٍ","لا يَهتَدي فيها إِلَيكَ نَهارُ",24,"ر",1,0],["فليأتينّك ركْبُ شِعرٍ سائرٍ","قد عمّ مشرقَ شمسِها والمغربا",25,"ب",2,0],["فليَ الغرام وللإمامِ المُرتَجى","مجدٌ عقودُ الحمدِ في لبّاتِه",26,"ت",2,0],["فَلَيَأْتِيَنَّكَ شُكْرُ من لَمْ تُولِهِ","عَنِّي وصَفْوُ ثناءِ من لَمْ تُصْفِهِ",27,"ف",2,0],["فلي أسوةٌ بالأقدمينَ صبابةً","وقد وردوا للوجدِ منهلَه العِدّا",28,"د",2,0],["فَلَيالي الصِبا أَسَرُّ لَيالٍ","وَزَمانُ الهَوى أَلَذُّ زَمانِ",29,"ن",1,1],["فلي الشام والعراق ونجدٍ","كحجازٍ والساحة اليمنية",30,"ي",2,0],["فَلياليك بِالسُرور أَضاءَت","زُهرُها وَاتقاك كُلِّ رَقيب",31,"ب",1,0],["فليأتنا من رأى خلا يماثله","بمثله غير هياب ولا وكل",32,"ل",1,0],["فَلِئامُ الأنامِ أَهلٌ لِحِقدٍ","وكرامُ الأنامِ أهلٌ لعفوِ",33,"و",1,0],["فليأتينك غادياً بصحيفة","نكداء مثل صحيفة المتلمّس",34,"س",1,0],["فليأتين عليك يوم مرة","يبكي عليك مقنعا لا تسمع",35,"ع",1,0],["فليالى الهمومِ فيها طوالٌ","وليالى السرور فيها قصارُ",36,"ر",1,0],["فلى إباءٌ بنفس قد علت شَمعاً","إلاّ عليك رأيتُ الجبن مأواها",37,"ا",3,0],["فَليأتينَّكَ حيثُ كنتَ ثَناً","يُرضيكَ عَن قُربي وعَن بُعْدي",38,"د",2,0],["فلي الويل بعدهم وعليهم","صرت فرداً وملني أصحابي",39,"ب",2,0],["فلي الرياح عليك ان جاريتني","وذرى الجبال وكل بحر زاخر",40,"ر",1,0],["فَلَيالي خيرهنَّ اللواتي","كتمت سرنا وَنحن سكارى",41,"ر",2,0],["فَلِيَ البِشَارَةُ يَومَ كَشْفِ قِنَاعِهَا","وَلِرَبِّهَا شُكرٌ عَلَيْكَ مُرَتَّبُ",42,"ب",1,0],["فَلى التِفاتٌ إِلَى آثارِهِم أبَداً","وَلِى غَرَامٌ وَجَفنى هاطِلٌ كَمِدُ",43,"د",1,0],["فلي أسوَةٌ بالنجمِ للشرقِ سَيرهُ","مَدى الدهرِ والأفلاكُ تنْحو به الغَربْا",44,"ب",2,0],["فلي الويح بعدهم وعليهم","وإليهم من بعد ذاك مآبي",45,"ب",2,0],["فلياليه كالإماء لع","لياك وأيامه من الخدام",46,"م",1,0],["فلي ألف نِيلٍ من نداك ومنزلي","على رغم أنف الحادثات خصيب",47,"ب",1,0],["فليَأتِ بالفُرقانِ من هو فارقٌ","فرقا يُبَينُ لصالحِ الأذهانِ",48,"ن",1,0],["فَلِي أَشهُرٌ حَتّى إِذا اِنشَقَّتِ العَصا","وَطارَ شعاعاً أَمرُهُم فَتَبَدَّدا",49,"د",2,0],["فَلياليه كم حملن شجونا","وكأن كل ليلة منه حبلى",50,"ل",2,0],["فَليَ الحجابَةُ الكُبرَى الّتي","أحفَظُ السِرَّ بها حفظ الكرام",51,"م",1,0],["فَليأمن الإِسلام كَيد عَدوه","إِن الكَفيل بِحفظه مَوجود",52,"د",1,0],["فلي أنَفٌ قد شب في اللّه مهجتي","وعزم وهمَّات دوين الفراقد",53,"د",1,0],["فَلِيَ العذرُ في انقطاعي عن الخد","مةِ والمجلسِ الكريم السّامي",54,"م",2,0],["فلي أسوة في نشوتي بابن فارض","وبالمولوي الفذ فهو عميد",55,"د",1,0],["فلي اشفعوا ولوالدي وأسرتي","والسامعين مصابكم والقاري",56,"ر",2,0],["فلي أسى مهما عراني من أسى","بخيرة الخالق من هذا الملا",57,"ل",2,0],["فَليَأمَن الخيف لا خَوفَ لَدَيهِ وَلا","حيف فَإِن حُسام الظُلم مَغمود",58,"د",1,0],["فَليأتِ مِنهُ بِسورَةٍ أَو آيَةٍ","فَإِذا رأى النَظمَين يَشتَبِهانِ",59,"ن",1,0],["فلي أحق رجاء","في عالم الإنسانِ",60,"ن",1,0],["فلي الجوهرُ الخاِلصُ المنتقى","إذا نبذَ الجوهرُ ال