{"poems":[[75,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[95,"قد قام عرشك في أعز مكان","https://www.aldiwan.net/poem11213.html","الكامل"],[95,"أيها البالغ الثريا مقاماً","https://www.aldiwan.net/poem11412.html","الخفيف"],[32,"أمن دمنة جرت بها ذيلها الصبا","https://www.aldiwan.net/poem29607.html","الطويل"],[53,"أصبحت عاديت للصبا رشدك","https://www.aldiwan.net/poem65760.html","المنسرح"],[31,"بانت سعاد ففي العينين تسهيد","https://www.aldiwan.net/poem6030.html","البسيط"],[87,"النيل العذب هو الكوثر","https://www.aldiwan.net/poem7929.html","المتدارك"],[45,"لا تحسبوا ربعكم ولا طلله","https://www.aldiwan.net/poem10134.html","المنسرح"],[89,"واطول شوقي إليك يا وطن","https://www.aldiwan.net/poem8237.html","المنسرح"],[33,"خليلي مرا بي على رسم منزل","https://www.aldiwan.net/poem41841.html","الطويل"],[33,"يا من لقلب متيم كلف","https://www.aldiwan.net/poem42524.html","المنسرح"],[107,"مكسويني كتبت للناس درسا","https://www.aldiwan.net/poem43079.html","الخفيف"],[107,"سيد الرسل وأم المؤمنين","https://www.aldiwan.net/poem44196.html","الرمل"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21099","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55437","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[96,"بدعة الذل","https://www.poetsgate.com/ViewPoem.aspx?id=12816",""],[33,"يا منْ لقلبِ متيمٍ، كلفٍ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18877&r=&rc=140",""],[119,"يا نعم حسبك ان عين زماني","https://www.aldiwan.net/poem40475.html","عموديه"],[119,"قتل الاعداء يا هند الحسد","https://www.aldiwan.net/poem41154.html","عموديه"],[136,"أجدك أن بينهم أن آنا","https://www.aldiwan.net/poem54722.html","الوافر"],[170,"ينصف القرن فيرتد زكا عن","https://www.aldiwan.net/poem47048.html","الرجز"],[189,"خاض الظلام فاهتدى بغرة","https://www.aldiwan.net/poem14780.html","الرجز"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[215,"في طريقي إليك يا بحر أشدو","https://www.aldiwan.net/poem46227.html","الخفيف"],[333,"بين همس الشفاه والأحداق","https://www.aldiwan.net/poem55024.html","الخفيف"],[353,"غيرتك الأيام سبحان من لا","https://www.aldiwan.net/poem20366.html","الخفيف"],[396,"باسمك الله ابتدى","https://www.aldiwan.net/poem54499.html","عموديه"],[396,"من أراد لهم والغم الكبير","https://www.aldiwan.net/poem54561.html","عموديه"],[412,"أرحت نفسي من عداة الملاح","https://www.aldiwan.net/poem50195.html","السريع"],[463,"تعجب من صبري على ألوانِها","https://www.aldiwan.net/poem55823.html","الرجز"],[463,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[463,"وجد الجميم فعافه وتبقلا","https://www.aldiwan.net/poem55960.html","الكامل"],[463,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[463,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[463,"هبت ومنها الخلاب والخدع","https://www.aldiwan.net/poem56139.html","المنسرح"],[463,"الليل فالأرض لليث الشرى","https://www.aldiwan.net/poem56180.html","السريع"],[463,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[463,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[500,"قرة عيني بذكا محبتي أي فلكا","https://www.aldiwan.net/poem10256.html","مجزوء الرجز"],[520,"سقم الحاظ الحسان الخرد","https://www.aldiwan.net/poem12081.html","الرمل"],[520,"من كان لا يعشق الأجياد والحدقا","https://www.aldiwan.net/poem12182.html","البسيط"],[563,"عين حق إنسانها الإنسان","https://www.aldiwan.net/poem33815.html","الخفيف"],[593,"","https://poetry.dctabudhabi.ae/diwan/poem/107084","الرجز"],[601,"","https://poetry.dctabudhabi.ae/diwan/poem/143646","السريع"],[605,"","https://poetry.dctabudhabi.ae/diwan/poem/216404",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83266","الخفيف"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66749","السريع"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101513","الكامل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199561","المسحوب"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72328","السريع"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133844","الخفيف"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69195","المنسرح"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93093","الرجز"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95544","الخفيف"],[1515,"","https://poetry.dctabudhabi.ae/diwan/poem/101080","الكامل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202067","الرمل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109326","البسيط"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121017","الرجز"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93602","الوافر"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131689",""],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107071","الخفيف"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107063","الخفيف"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3826,"","https://poetry.dctabudhabi.ae/diwan/poem/84996","الرجز"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35512","السريع"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/199659","البسيط"],[4755,"ما بَين صِلصَالِي وفُولاذِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=197776",""],[4802,"الليره...والليره","https://www.poetsgate.com/ViewPoem.aspx?id=34357",""],[4968,"دثار العشق","https://www.poetsgate.com/ViewPoem.aspx?id=206756",""],[5397,"جلى صباح الهدى للخطب جنح دجى","https://www.poetsgate.com/ViewPoem.aspx?id=157955",""],[5559,"من يرد للقدس نصرا","https://www.poetsgate.com/ViewPoem.aspx?id=204217",""],[5582,"أَلا عُوجُوا عَلَى الطَّلَلِ القَدِيمِ","https://www.poetsgate.com/ViewPoem.aspx?id=187263",""],[5638,"حسن البيان","https://www.poetsgate.com/ViewPoem.aspx?id=199067",""],[5691,"يوم يُبعثون","https://www.poetsgate.com/ViewPoem.aspx?id=206744",""],[5691,"العم سام...!","https://www.poetsgate.com/ViewPoem.aspx?id=207063",""],[5701,"ذهب الشباب فلات حين شباب","https://www.poetsgate.com/ViewPoem.aspx?id=164620",""],[5759,"نشيدُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=214175",""],[402,"أيها البالغ الثريا مقاما","https://www.poetsgate.com/ViewPoem.aspx?id=36200",""],[5796,"نِمْتُمُ عن ليلِ حِلْفِ السَّهرِ","https://www.poetsgate.com/ViewPoem.aspx?id=189037",""],[5810,"َينَ صَبري من يَذكُر اليومَ صَبري","https://www.poetsgate.com/ViewPoem.aspx?id=6021",""],[192,"يا كاعب","https://www.poetsgate.com/ViewPoem.aspx?id=9857",""],[6038,"الاقصى","https://www.poetsgate.com/ViewPoem.aspx?id=27219",""],[6052,"هزة الضمير","https://www.poetsgate.com/ViewPoem.aspx?id=34893",""],[6093,"فَازَ بِالشِّعْرِ ظَرِيْفْ ( مجزوء الرمل)","https://www.poetsgate.com/ViewPoem.aspx?id=180593",""],[6142,"المرتضى غيره رفقاً ومرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=155722",""]],"verses":[["يَنصاعُ مَن جاراكَ مَقبوضَ الخُطا","فَكَأَنَّما عَضَّت بِهِ الأَقيادُ",0,"د",1,0],["يَنْصَبُّ فِي الْوَادِي البَعِيدِ قَرَارُهُ","بِأَحَبِّ تَهْدَارٍ إِلَى الآذَانِ",1,"ن",1,0],["يَنْصُرُ الدِّينَ يَنْشُرُ العِلمَ وَالفَنَّ","يُقِرُّ النِّظَامَ وَالأَحْكَامَا",2,"م",2,0],["يَنصِبنَ جَوناً مِن عَبيطٍ كَأَنَّهُ","حَريقٌ جَرَت فيهِ الرِياحُ النَوافِحُ",3,"ح",1,0],["ينصرفُ الوفدُ يحمدُون معاً","يومك فيهم ويأملون غدكْ",4,"ك",1,0],["يَنصَبُّ في بَطنِ أُبلِيٍّ وَيَبحَثُهُ","في كُلِّ مُنبَطَحٍ مِنهُ أَخاديدُ",5,"د",1,0],["يَنصَبُّ كَتَلٍ مُنهارِ","وَيَضِجُّ فَتَحسَبُهُ يَزأَر",6,"ر",1,0],["يَنصُرُها الغَيثُ وَهيَ ظامِئَةٌ","إِلى سِواهُ وَسُحبُها هَطِلَه",7,"ل",2,0],["يَنْصُرُنِي حَيْثُ لا يَكَادُ حَمٌ","يَمْنَحُنِي وُدَّهُ وَلا خَتَنُ",8,"ن",1,0],["يَنُصّونَ بِالمَوماةِ خَوصاً كَأَنَّها","شَرائِحُ يَنعٍ أَو سَراءٍ مُعَطَّلِ",9,"ل",1,0],["يُنصِتنَ يَوماً لَها إِذا نَطَقَت","كَيما يُفَضِّلنَها عَلى البَشَرِ",10,"ر",1,0],["يَنصَبُ النَفسَ لِلعَذابِ وَيَلقى","ما يُذيبُ النُفوسَ مِن سَكَراتِهْ",11,"ت",2,0],["ينصرُ الحقَّ ويقضي أمره","إن رماه كلُّ أفَّاكٍ مَهينْ",12,"ن",1,0],["يَنصُر الحقَّ ثائراً يمنعُ البا","طِلَ أن يستقرَّ أو أن يثورا",13,"ر",2,0],["يَنصبُ النّحرَ للحجارةِ والطّي","نِ يُغِيرُ الحِلَى ويُغري النُّحورا",13,"ر",2,0],["يَنصفُها نُستُقٌ تَكادُ تُكرِمُهُم","عَنِ النَّصَافَةِ كالغِزلانِ في السَّلَمِ",14,"م",1,0],["يَنْصُرُ الْعَقْلَ يَكْشِفُ الجَهْلَ يُوحِي ال","عَدْلَ يرْعَى الضَّعِيفَ وَالمِسْكِينَا",15,"ن",2,0],["يُنْصِتُ اللَّيْلُ حِينَ تُنْشِدُ يا شِعْرُ","وَتَنْفِي عَنْ مُقْلَتيْهِ الرُّقُودا",16,"د",2,0],["ينصف العبقريّ دهر فسيّان","وفي أصفياؤه أم خانوا",17,"ن",3,0],["ينصتنَ يوماً لها، إذانظقتْ،","كيما يفضلنها على البشر",18,"ر",1,0],["ينصب في عليا لؤي مجدها","مستكمل البرهان في عدنان",19,"ن",1,0],["ينصر الله تعالى عبده","بالتجلي لا يجيش وعدد",20,"د",1,0],["يَنُصُّ جِدَايَةً خَذَلَت وَيرنُو","غَزَالاَ مُونِقاً وَيَمِيسُ بَانَا",21,"ن",2,0],["ينَصُفُ القِرْنُ فيرتَدَ زَكا عن","حَومةِ الحرَبِ وقد جاءَ حَسا",22,"س",2,1],["ينصاع كالمرّيخ التهابه","وأنت فوق ظهره عُطارِد",23,"د",1,0],["ينصرُ اللَّه مَن يشاءُ بما شا","وَمنَ السمّ قد يكون الشفاءُ",24,"ا",2,0],["ينصح الدهر ما يشاء فإنا","لا نرى نصحه سوى إيلام",25,"م",1,0],["ين صبح مسهّد الأنداء","ومساء معذّب الأضواء",26,"ا",2,0],["يَنصُفُ الدّهْرُ منكَ إنْ غَرَّكَ الدَّه","رُ وأَغراكَ والحَياةُ غُرورُ",27,"ر",1,0],["ينصر الدين وأهله","باللسان وبالحسام",28,"م",1,0],["ينصح الجاهل ويرحم للضرير","يسكر المنكر وللحق نصير",29,"ر",1,0],["يَنصُل في الطَعنِ حراب القَنا","كَأَنَّها أَلسِنَة في الجِراح",30,"ح",1,0],["ينصل ما يعقد من عهودها","نُصولَ ما تخضِبُ من بنانِها",31,"ن",3,0],["ينُصلن من غِمدِ أُشَي","يَ مُنصُلاً فمُنصُلا",32,"ل",2,0],["ينصُبن للإشخاص حُولاً عُوَّداً","مثل الذكيِّ يرى الخفيَّ المشكلا",33,"ل",2,0],["ينصُّها السير على لاحبٍ","مثل صليفِ الجمَل الأورقِ",34,"ق",1,0],["يَنُصُّ شيطانُ القريضِ سمعَه","مرتقياً في جوّها مسترِقا",35,"ق",2,0],["ينصح للّهِ والخلافةِ لا","يرفع في شَهوةٍ ولا يَضعُ",36,"ع",1,0],["ينُصُّ من أرساغها والمطا","إما جناحاً طارَ أو مَنسِرا",37,"ر",2,0],["يُنصَرُ عنها القولُ بال","فعلِ فيسلم الخبَرْ",38,"ر",1,0],["ينصاعُ كالمرّيخ في التهابِهِ","وأنت فوق ظهره عُطاردُ",39,"د",1,0],["ينصِب في أسفله","لكل حوت شبكا",40,"ك",2,0],["ينصب الأشراك من ألفاظه","طالباً صيد المعاني الشرد",41,"د",1,0],["ينصها كل مغوار إذا سئمت","إعناقها السير زاد النص والعنقا",42,"ق",2,0],["ينصرون الهوى على الشرع عمداً","وعليه يستحوذ الشيطان",43,"ن",1,0],["ينصها لغاية","حمى علي ذا الحسب",44,"ب",1,0],["ينصرف الناسُ لحاجاتهِمْ","ونحنُ في المسجد أوتادُهُ",45,"ه",1,0],["ينْصَنَّه الهِجنْ المناكيف","لي من خْلاف السير ضُمَّر",46,"ر",1,0],["يَنصُرونَ الإِسلامَ بِالسَيفِ وَالمُص","حَفِ فَالقُوَّتانِ فيهِم سَواءُ",47,"ا",2,0],["يُنصبُ فيه علمٌ للهُدى","والحوضُ من ماءٍ له مُترَعُ",48,"ع",1,0],["ينصبنَ في الشباكِ دون تعمُّدٍ","شبكاً تصير بها الرجال اسارى",49,"ر",2,0],["ينصن ولد زايد ودارٍ فيها","حمدان يعله مْن الإله كفيل",50,"ل",1,0],["ينصفني فهو إذا زرته","أوزار أرضيه ويرضيني",51,"ن",2,0],["ينصُلُ الضوءُ في حوا","شيهِ واللونُ والوسَام",52,"م",1,0],["يَنصدع الجند عَن مواكبها","تَعدو بِها سرّبا ضَوامرها",53,"ر",3,0],["ينصب عن حرابها","سوط العذاب الواصب",54,"ب",1,0],["ينصر الدين في علاه فقيها","شافعيا وما له نظراءُ",55,"ا",2,0],["ينصب حرب خداعه","أبداً ليوقع للبشر",56,"ر",1,0],["ينصر الله ويرجو نصره","وبه يسطو اتكالا واعتصاما",57,"م",2,0],["ينصب من نفس عالٍ تخالهما","وادي المجرة يجرى عذب سلسال",58,"ل",1,0],["يُنصَبُ لكن أكثرُ استعمالِ من","يُعنى به في الخفضِ أو ذا صدع",59,"ع",1,0],["ينصبها جفانا كَالجَوابي","بِجَنب الراسيات مِن القُدور",60,"ر",1,0],["ينصف شجى مفتتن حيران","ضعيف في الحب ما يقوى",61,"و",2,0],["ينصر الحق عارف فهو حق","فيه تلفى الحقائق الجوهريه",62,"ي",2,0],["ينصر الحق جعفر فهو حق","فيه تلقى الحقايق الجوهريه",63,"ي",2,0],["يُنصَبُ مَفعولاً لهُ المصدَرُ إن","أبَانَ تَعلِيلاً كجُد شُكراَ وَدِن",64,"ن",1,0],["يُنصَبُ تَالِى الوَاوِ مَفعُولاَ مَعَه","فِى نَحوِ سِيرِى وَالطَّرِيقَ مُسرِعَه",64,"ه",1,0],["ينصرُنا ربُّ السماواتِ العَلِي","ويقطَعُ الهامَ بحدِّ المشرفي",65,"ي",1,0],["ينصِت لِلنّبأَةِ مِن حَشرَة","كَأَنَّها قادِمَة مِن جَناح",66,"ح",1,0],["ينصها كل مغوار إذا سئمت","إعناقها السير زاد النص والعنق",67,"ق",1,0],["يَنْصَاعُ قَلبِي إنْ دَعَانِي، كَمَا","يَنصَاعُ تِلمِيذٌ لِأستَاذِهِ",68,"ذ",2,0],["ينصف قبيلة,يقول الخير لخيره","معدن حقيقي يشو