{"poems":[[53,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21082","البسيط"],[111,"جرد النفس وانهها عن هواها","https://www.poetsgate.com/ViewPoem.aspx?id=530",""],[136,"إن كيهيدى من أشر البلاد","https://www.aldiwan.net/poem54845.html","الخفيف"],[254,"إنك يا أوس اللئيم محتده","https://www.aldiwan.net/poem2121.html","الرجز"],[342,"إنك يا ابن جعفر نعم الفتى","https://www.aldiwan.net/poem45287.html","الرجز"],[500,"لو كان بالدهر لحر يدان","https://www.aldiwan.net/poem10281.html","السريع"],[556,"هذي المصيبة ما أبقت لنا أبدا","https://www.aldiwan.net/poem47865.html","البسيط"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111788","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2111,"","https://poetry.dctabudhabi.ae/diwan/poem/119237","المنسرح"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94317","الرجز"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121613","الخفيف"],[5110,"أًحلِفْ","https://www.poetsgate.com/ViewPoem.aspx?id=49624",""],[6004,"عروسُ الشَّرق","https://www.poetsgate.com/ViewPoem.aspx?id=71985",""]],"verses":[["أنكَى وأذكى حريقاً في جوانِحنا","خَلْقٌ من الماءِ والألوانُ نيران",0,"ن",1,0],["أَن كيفَ أَبدَى إلَهُ الَخلقِ نِعمَتَهُ","فِينَا وعَرَّفَنَا آياتِهِ الأُوَلا",1,"ل",2,0],["ان كيد الشيطان كان ضعيفا","ودواهي النفوس لا تتضاهى",2,"ا",3,0],["إِنَّ كَيهَيدِى مِن أشَرِّ البِلاَدِ","ولَيَالِيه دائماتٌ السَّوَادِ",3,"د",1,1],["إِنَّكَ يا أَوسُ اللَئيمُ مَحتَدُه","عَبدٌ لِعَبدٍ في كِلابٍ تُسنِدُه",4,"د",2,1],["إِنَّكَ يا اِبنَ جَعفَرٍ نِعمَ الفَتى","وَنِعمَ مَأوى طارِقٍ إِذا أَتى",5,"ا",1,1],["إنك يا ذا العَزَمات التي","يسرن والشمس شريكي عنان",6,"ن",1,0],["أنكى بأفرسِ مَنْ ناجيتُه قدرٌ","جارٍ وأفرسِ مَن حاذرتُ منه رَدى",7,"د",2,0],["إنَّ كيدَ النساءِ كان عظيماً","كم سليمٍ غدا بهنَّ سقيما",8,"م",2,1],["إنَّ كيدَ الشيطانِ يفتِكُ فتكا","بضِعافِ العقولِ والإيمانِ",9,"ن",1,0],["إن كيدَ الشيطان كان ضعيفاً","وهو يدعو للشرِّ والعصيانِ",9,"ن",1,0],["إنك يا عمرو حين جدت به","جاء على حاجة الى الورق",10,"ق",1,0],["انكيسها نصرته بالعقله","وباجتماع النصرة انكس فعله",11,"ه",1,0],["إن كَيَّ الخُسوفِ للشمسِ ظُلْمٌ","وكذا الدهرُ لم يزَلْ ظَلاَّمَا",12,"م",2,0],["إنك يا مصرى فى عبورك","كنت أسطورة الزمان",13,"ن",1,0],["إنَّ كيدَ الأشرارِ كيدٌ عميقٌ","يُشعلُ الكَونَ بالجفا ، واقتتَِالِ",14,"ل",1,0]]}