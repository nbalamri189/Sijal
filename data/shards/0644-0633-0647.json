{"poems":[[109,"طمنوا ستي ام عطا","https://www.poetsgate.com/ViewPoem.aspx?id=29671",""],[147,"سل عن فضائلك الزمان لتخبرا","https://www.aldiwan.net/poem11760.html","الكامل"],[500,"دعا فأجابه القدح","https://www.aldiwan.net/poem9811.html","مجزوء الوافر"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138299",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63889","الهزج"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145627","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77359","الخفيف"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75975","الطويل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122492","الوافر"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103946","الطويل"],[5264,"لسه مستنظر ف بكره","https://www.poetsgate.com/ViewPoem.aspx?id=191584",""]],"verses":[["لسة بنفاصل القناصل عليها","زي ما بتفاصلي ع الملوخية",0,"ي",2,0],["لَسَهِرتَ في حِفظِ الذِمارِ وَإِنَّهُ","مَجدٌ لَدُنَّكَ أَن يَنامَ وَتَسهَرا",1,"ر",2,0],["لسهل في العلى غرر","فهلا عندكم لمح",2,"ح",1,0],["لسهمه الناس أهداف فلا عجب","إذا قضوا قبل ان يقضوا لهم وطرا",3,"ر",2,0],["لسهم اللحظةِ الواح","دِ فيه ألفُ برجاس",4,"س",1,0],["لِسُهُولٍ في بِلادِي وقِمَمْ","يا لَشَوْقِي كَمْ أُعَانِي كَمْ وَكَمْ؟؟!",5,"م",1,0],["لِسُهَيلٍ فَفيهِ خُضرُ الأَماني","فَهوَ نِعمَ المُقِرُّ لِلأُدَباءِ",6,"ا",2,0],["لَسَهَّلتُ هَذا العلمَ حَتّى لَقَد غَدا","كَشَربَةِ ماءٍ قَد جَرى علوَ رَضراضِ",7,"ض",1,0],["لسَهمِ سعادَ فِي قلبِي سهامُ","فَما يُجزِي عواذِلِيَ الملامُ",8,"م",1,1],["لسهل ودي فيك نحوك مسلكاً","ولم يتعذر لي اليك طريق",9,"ق",1,0],["لسه مستنظر ف بكره","بكره راح الإنتعاش",10,"ش",1,1]]}