"قف العيس هذا ربع سلمى فسلم","https://www.aldiwan.net/poem2538.html","الطويل"],[434,"إن العرين الذي يحتله الأسد","https://www.aldiwan.net/poem2613.html","البسيط"],[436,"كسيت بدولتك اليالي نورا","https://www.aldiwan.net/poem34851.html","الكامل"],[456,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[456,"أخلق الدهر لمتى وأجدا","https://www.aldiwan.net/poem56230.html","الخفيف"],[462,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[462,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[462,"قف بالمنازل أو كناس ظبائها","https://www.aldiwan.net/poem3275.html","عموديه"],[462,"ومخطف القد معسول مقبله","https://www.aldiwan.net/poem3322.html","عموديه"],[466,"وليلة أيقظني معانقي","https://www.aldiwan.net/poem59521.html","الرجز"],[466,"وليلة ليس لها مثل","https://www.aldiwan.net/poem59715.html","السريع"],[466,"زفت إلينا مواشط الطرق","https://www.aldiwan.net/poem59833.html","المنسرح"],[466,"زفرات ولوعة واكتئاب","https://www.aldiwan.net/poem60489.html","البسيط"],[475,"هل بعد بينك من جوى لمودع","https://www.aldiwan.net/poem15216.html","الكامل"],[477,"زاد المحب صبابة","https://www.aldiwan.net/poem37024.html","مجزوء الكامل"],[477,"إن كنت مثلي على الأحوال مطلعا","https://www.aldiwan.net/poem37575.html","البسيط"],[498,"وحياتكم يا أهل منعرج اللوى","https://www.aldiwan.net/poem37677.html","الكامل"],[512,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[513,"بصعود منزلة وجد صاعد","https://www.aldiwan.net/poem12058.html","الكامل"],[556,"زينة الله منه حرز حريز","https://www.aldiwan.net/poem33549.html","الطويل"],[560,"بغداد أيتها الركاب فبادري","https://www.aldiwan.net/poem52940.html","الكامل"],[565,"أتأسى يا أبا بكر","https://www.aldiwan.net/poem69652.html","مجزوء الوافر"],[573,"أضاء بثغرك وادي أضا","https://www.aldiwan.net/poem3054.html","المتقارب"]],"verses":[["زَفَرَ الزَمانُ عَليهِمُ فَتَفَرَّقوا","وَجَلَوا عَنِ الأَوطارِ وَالأَوطانِ",0,"ن",1,0],["زَفَتهُ النُعامى فَاِستَمَرَّ جِمامُهُ","تَجَفُّلَ سِربَي رَبرَبٍ وَنَعامَ",1,"م",1,0],["زَفَرَ الزَمانُ عَلَيهِمُ فَتَطارَحوا","فِرَقاً وَطاروا بِالمَنونِ جِفالا",2,"ل",2,0],["زُفَّت إِلَيكَ وَسِجفُ الخِدرِ يَعلَقُها","وَمَع قَبولِكَ لا يَغلو لَها مَهَرُ",3,"ر",1,0],["زَفيراً تَهاداهُ الجَوانِحُ كُلَّما","تَمَطّى بِقَلبي ضاقَ عَن مَرِّهِ جِلدي",4,"د",2,0],["زفت البشرى معانيه كما","زفت الأنسام أنفاس الخزاما",5,"م",2,0],["زفت إلى فهمي ونعم الفتى","أن يعقد المر وأن يحلل",6,"ل",1,0],["زُفَّتْ وَخَفَّ بِهَا إِلَى","أَلْبَابِنَا اللَّفْظُ الرَّصِينُ",7,"ن",1,0],["زُفَرُ الرَئيسِ أَبو الهُذَيلِ أَبادَكُم","فَسَبى النِساءَ وَأَحرَزَ الأَموالا",8,"ل",2,0],["زُفَّتْ إلى بدر الدجى الشمسُ","ولاح سعد وخبا نحسُ",9,"س",1,1],["زفراتُ أكيارٍ ووقعُ مطارقٍ","فكأن بيتك كورُ حدادينا",10,"ن",2,0],["زَفّافَةٍ زَفَّ الرِنا","لِ تَسفُ إِسفافَ النُسورِ",11,"ر",1,0],["زَففتَ نَحوي عَروساً","تَجتابُ رَوضاً أَريضا",12,"ض",2,0],["زفت الى وحش فسلت","في حيازته اكتئابا",13,"ب",2,0],["زَفَراتٌ كَأَنَّها بَثُّ قَيسٍ","في مَعاني الهَوى وَفي أَخبارِهِ",14,"ر",2,0],["زُفَّت إِلى مَلِكِ المُلوكِ يَحُثُّها","دينٌ وَيَدفَعُها هَوىً وَتَشَوُّقُ",15,"ق",1,0],["زَفَّها إِلى","خَيرِ مَن خَطَب",16,"ب",1,0],["زَفَّها لَكُم وَجلا","شاعِرُ الحِمى الأَرِبُ",17,"ب",1,0],["زَفَّ مِن آياتِهِ الكُبرى لَنا","طِلبَةً طالَ بِها عَهدُ الرَجاء",18,"ا",2,0],["زَفَراتٌ تَعتادُني كُلَّ يَومٍ","وَغَرامٌ كَأَنَّهُ لِيَ غَريمُ",19,"م",1,0],["زُفَّ العَفافُ إلى العَفافِ ولم يكُن","شرفُ الفَضِيلةِ فائتاً من يَفضُلُ",20,"ل",1,0],["زَفَفْتُ إليه من مَدحي عَروساً","مُعَرَّسةَ الهَوى في كلِّ نَادِي",21,"ي",1,0],["زَفَّ بِكرُ المُدامِ لَيلاً فَأَبدَت","جَيشَ نورٍ لِعَسكَرِ اللَيلِ غازِ",22,"ز",1,0],["زفَّ الصباحُ إلى الرمالِ نداءَها","وسرى النسيمُ عشيةً فنعاها",23,"ا",3,0],["زَفَراتٌ مُقَلقِلاتُ","أَسعَدَتها العَبَراتُ",24,"ت",1,1],["زَفَّ الزُجاجُ بِها عَروسَ مُدامَةٍ","تُجلى وَنُوّارُ الغُصونِ نِثارُ",25,"ر",1,0],["زَفَّت أَبا بَكرٍ إِلَيكَ مَحاسِناً","جاءَتكَ تَحمِلُ عُذرَةَ الأَبكارِ",26,"ر",1,0],["زَفُّوا البشائرَ للصِّبيان ما برحوا","حتّى دروا أنّهم في القوم صبيانُ",27,"ن",1,0],["زَفراتها زَفَراتُ مَصر تَصدَعَت","مِن هولهن قُلوبنا وَالأَكبد",28,"د",1,0],["زُفَّت إِلَينا مِن بَيتِ دَسكَرَةٍ","وَشَيَّعَتها جُنودُ إِبليسِ",29,"س",1,0],["زَفَفنا إِلى الشامِ رَجراجَةً","تَسُلُّ عَلى مَن عَصى سَيفَ باسِ",30,"س",1,1],["زُفَّت إِلى الرَوضِ وَهوَ يَأمَلُها","وَجِنحُ لَيلٍ كَالقارِ مُعتَكِرِ",31,"ر",1,1],["زُفَّت إِلى أَكرَمِ خُطّابِها","وِشاحُها وَردٌ وَنَسرينُ",32,"ن",1,0],["زُفَّت إِلى البَدرِ وَالدينارُ قيمَتُها","عِندَ السِباءِ وَكانَت تَسكُنُ المَدَرا",33,"ر",2,0],["زَفِيرُ مُتَمٍّ بالمُشَيَّأِ طَرَّقَت","بِكاهِلِهِ فَلا يَرِيمُ المَلاقِيا",34,"ي",2,0],["زفت إليه فلم تجد","شيئاً جميلاً في فتاها",35,"ا",3,0],["زَفَرَتْ خَوْفَها الرّماحُ ولم يَسْ","مَعْنَ منها تَغَيّظاً وزَفيرا",36,"ر",2,0],["زَفَّ عَروساً حُلِيُّها كَلِمٌ","تُنْجِدُهُ تارةً ويُنْجِدُها",37,"د",3,0],["زُفّتْ إلى داركَ شمسُ الضّحى","وحوْلَها من شَمَعٍ أنْجُمُ",38,"م",1,0],["زَفَفْتُ إِلى خَيْرِ الورى كُلَّ حُرّةٍ","مِن المدْحِ لم تَخْمُلْ برعِي الخَمائِلِ",39,"ل",1,0],["زفَّتْ إِلى رُوبرتُ وَهْوَ أَحَقُّ مَنْ","تخْتارُهُ ذاتُ الكمَالِ وَتصْطفِي",40,"ف",2,0],["زُفَّتْ بِه لَكَ مِن سَمَاءِ عَفَافِهَا","شَمْسٌ تُنَكَّسُ دونَهَا الأَبْصَار",41,"ر",1,0],["زفَّتْ فَقَالَ الَّذِي يَرَاهَا","أَبِنْتُ حِسٍّ أَمْ بِنتُ فِكْرِ",42,"ر",1,1],["زُفَّتْ إِلى شَهْمٍ لَبِيبٍ فَاضلٍ","يَنمِيهِ مِنْ خَيْرِ الأُصولِ نِجَارُ",43,"ر",1,0],["زُفَّتْ إِلَيْكَ وَالزَّمَانُ وَرْدُ","وَالنُّوْرَ تَاجٌ وَالْفَرِيدُ عِقْدُ",44,"د",1,1],["زُفَّتْ إِلَى نَابِهٍ حَصِيفٍ","فِي جِيلِهِ فَاقِدِ النَّدِيدِ",45,"د",1,0],["زُفَّتْ إِلَى فَهْمِي وَنِعْمَ الفَتَى","إِنْ يُعْقَدِ الأَمْرَ وَإِنْ يُحْلَلِ",46,"ل",1,0],["زَفَّ عَذْرَاءَهُمْ إِلَى كُفُؤٍ لَي","سَ لَهُ فِي السَّرَاةِ مِنْ أَكْفَاءِ",47,"ا",2,0],["زفرات أحمد في رسا","لته وآلام الصليب",48,"ب",1,0],["زُفَّتْ كريمةُ مصطفى لمحمَّدٍ","يا حبذا الأزواجُ والأصْهَار!",49,"ر",1,0],["زَفَرَاتُها متصَعِّدَا","تٌ مَلَّها طولُ الصعود!",50,"د",1,0],["زفّت البشرى معانيه كما","زفّت الأنسام أنفاس الحزاما",51,"م",2,0],["زَفَّتْ له مُتَعُ الدُّنيا بشائرَها","واستقبلَتْهُ مِن الطيرِ الأغاريد",52,"د",1,0],["زف العراق إلى علاك سلامه","ما بين حاضر ربعه والبادي",53,"د",2,0],["زفيفاً وقد حلَّقَ المعتلون","وزحفاً وقد أبْعَدَ الرّاكضونا ؟",54,"ن",2,0],["زِفَاقُهُمْ في الدار مَبْطُوحَة ٌ","وُعُودُهُمْ ليس بِمَبْطُوحِ",55,"ح",1,0],["زفرات متى صعدن من القل","ب ما العين عاجلاً تنحدر",56,"ر",1,0],["زَفَراتٌ لِلجَوى مَشْبُوبَةٌ","يا لَشَوقٍ، باتَ يُصْلِيني المِحَنْ",57,"ن",1,0],["زَفَفتُ إِلَيكَ فيها كُلَّ بَكرٍ","وَلَم أَسمَح لِغَيرِكَ بِالعَوانِ",58,"ن",1,0],["زفرات قلبي جمر نار أججت","منه دموع العين فاضت ذرّفا",59,"ف",2,0],["زفَراتٌ لِلقَلبِ فيها إِذا ما","ضَرَّمَتها الهُومُ فيهِ أَزيزُ",60,"ز",1,1],["زَفَرَتْ لموتِ أبي شجاعٍ زفرةً","لم يبقَ ساعَتَها لهنَّ حزام",61,"م",1,0],["زفتْ ولمّا يفترعها المزاج","كما تُزَفُّ البكرُ عندَ الزواجْ",62,"ج",1,1],["زفي عَيبتي عَنْهُ يرومُ مَذمَّتي","وهل عَثَرَ الجَوزا الرَّكوضَ الجنادِلُ",63,"ل",1,0],["زَفَّها مُحسِنٌ تُقِر","رُ لِإِحسانِهِ الفِطَن",64,"ن",1,0],["زَفَراتُ وَجدٍ ما يَبوخُ ضِرامُها","وَمَدامِعٌ مُتَناصِرٌ تَسجامُها",65,"م",3,1],["زًفَّتْ لَهُ بِكْرُ الْمَحَامِدِ مِثْلَمَا","زُفَّتْ لِعَاشِقِهَا الْعَهِيدِ عَرُوسُ",66,"س",1,0],["زَفَرَاتِي مُذْ غَدَاةِ الْوَدَاعِ","فَوَحَقِّ الْوِصَالِ بَعْدَ انْصِدَاعِ",67,"ع",1,0],["زففتها طوعاً إلى شاعرٍ","ما وقفت قط له قافيه",68,"ه",1,0],["زَفرتُ لضمِّ الخودِ بعدَ تلهُّفي","كذلك صوتُ الجمرِ في الماءِ ينطفي",69,"ي",1,1],["زفت اليك وأَنتَ مالك عنقها","لَبيك يا ذا لمن والاعتاق",70,"ق",1,0],["زفت معارف تونسٍ","في مظهر زان الأدب",71,"ب",1,1],["زُفَّت إِلى ماءِ السَماءِ فأَصبحَت","تَهزو بكلِّ مَهاةِ خدرٍ عانسِ",72,"س",1,0],["زفّتْ إليك كغادةٍ","هيفاءَ آنسة فتور",73,"ر",1,0],["زَفوفٍ نِيافِ هَيرَعٍ عَجرَفِيَّةٍ","تَرى البيدَ مِن إِعصافِها الجَرى تَرتَمي",74,"م",2,0],["زُفّت إليكَ عرائسُ البشرى برض","وانِ المهيمن في حِماه الأرفعِ",75,"ع",1,0],["زفّت لبابِكَ غبّ أترابٍ لها","هيَ للقلوبِ حبائل وصقورُ",76,"ر",1,0],["زَفَفْتُ البِكْرَ مِن مَدْحِي","لِمَن يُهْجَى وَلا يُمْدَحْ",77,"ح",1,1],["زَفاف بِالسُرور وَبِالتَهاني","تَهادَت لِلقُلوب بِهِ الأَماني",78,"ن",2,1],["زَفاف قَد تَلا آيات سَعد","فَخِلنا أَنَّها السَبع المَثاني",78,"ن",2,0],["زَفاف لِلحُسين أَخي المَعالي","زَها فَجَلا لَنا أَبهى المَعاني",78,"ن",2,0],["زَفافك قَد زفَّ الهَناءَ فَلَم يَزَل","لآمالنا فَوزاً وَأَعيُننا قرّه",79,"ر",2,0],["زَفاف لَهُ في طالع السَعد أَرّخوا","هِلال سُرور لاحَ قَد قارن الزهرَه",79,"ر",2,0],["زَفاف أعرب التاريخ عَنهُ","هَناً بِالخَير طالعه سَعيدُ",80,"د",1,0],["زفّت كُؤوس التَهاني لِلمَلا طَرَبا","فَأرشَفَت وَالداً مِنّا وَما وَلَدا",81,"د",2,0],["زُفَّت عَلى بَدر العُلى الأَفراح","وَبَدا السُرور فَزالَتِ الأَتراحُ",82,"ح",1,1],["زَفَّ المنامُ إليّ طَيْفَ خَيالِهِ","لو أنّ طَيْفاً كان من أبدالِهِ",83,"ل",2,1],["زُفّتْ إلى أحمدَ المحمودِ واجتنَبتْ","قَوماً إذا خَطَبوا أبكارَها فُرِكوا",84,"ك",3,0],["زَفَرَت بِالصَّبا صُدورُ اللَيالي","وَبَكَت بِالحَيا جُفونُ الشُهبِ",85,"ب",1,0],["زَفَفتُ عَرُوساً صُغتُ مَجدَك حليَها","كسَتها العُلى ثَوباً بذِكرِكَ مُعلَما",86,"م",2,0],["زَفَفتُ إلى نَداهُ عَروس فِكري","ليُمهرها فأولدَها المِطالا",87,"ل",2,1],["زَفَفتُ إلى نَبهانَ من صَفوِ فِكرَتي","عَروساً غَدا بطنُ الكتابِ لها خِدرا",88,"ر",2,1],["زفَّته قنبلة إليَّ، تصبَّحتْ","بلهيبها داري وابني الراحلُ",89,"ل",1,0],["زفت إليك رسائل ما مثلها","مما يزف إلى رفيع جناب",90,"ب",1,0],["زُفَّتْ إليكَ لَنا عرائِسُ أربَعٌ","فَفَضضْتَها بالسَّمعِ وهْيَ قَصائدُ",91,"د",1,1],["زَفَراتُه نَمَّتْ ولم يُفْصح بِمَا","يُخفِي فَجاءَ الدّمعُ بِالخَبرِ الجَلي",92,"ي",1,0],["زفرة رَدَّدْتها فاضْطَرمَتْ","في حشا الصبّ أشدَّ الاضطرام",93,"م",1,0],["زفَفْتُ إلى علاك بنات فكري","فكانت مُنيَة الكفو الكريم",94,"م",1,0],["زفت إلى علياك بنت قريحةٍ","من قاصرٍ ما عنده الاهي",95,"ا",3,0],["زفت إليك شريفةٌ لم يرضها","في غير مهد علائك استقرارُ",96,"ر",1,0],["زفها السعد فأرخ لهنا","طبقة في نعمة اللَه سمت",97,"ت",1,0],["زفّت لدى إسعاده","العلياء مذ بلغ الفطم",98,"م",1,0],["زُفَّتْ إليكَ الشَّمْسُ يا بَدْرَ العُلاَ","في سُحْبِ صَوْنٍ بَالصَّوَارِمِ أَمْطَرا",99,"ر",2,0],["زففتُ إليه أبكارَ القوافي","لعلمي أنّه البَعلُ الكَفيُّ",100,"ي",1,0],["زففت إلى الجدوى كريمة خاطري","هديّا