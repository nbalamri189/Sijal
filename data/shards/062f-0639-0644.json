{"poems":[[55,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[53,"دع لباك رسومه وطلوله","https://www.aldiwan.net/poem65987.html","الخفيف"],[50,"دع لباكيها الديارا","https://www.aldiwan.net/poem63264.html","مجزوء الرمل"],[146,"ما ضاع من أيامنا هل يغرم","https://www.aldiwan.net/poem58446.html","الكامل"],[147,"إدراك وصفك ليس في الإمكان","https://www.aldiwan.net/poem11827.html","الكامل"],[275,"دع للجهاد قواعد الزجاج","https://www.aldiwan.net/poem35000.html","الكامل"],[325,"دع لتيه الدلال واسمح برشفه","https://www.aldiwan.net/poem61700.html","البسيط"],[411,"يا أبا الطيب الذي طاب عيشي","https://www.aldiwan.net/poem50065.html","الخفيف"],[415,"يا لائم المشتاق دعه فقلما","https://www.aldiwan.net/poem32437.html","الكامل"],[463,"أدرك ما شاء غلام فطنا","https://www.aldiwan.net/poem55840.html","الرجز"],[592,"دع للعبرات تنسجم انسجاما","https://www.aldiwan.net/poem11522.html","عموديه"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122318","المتقارب"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120046","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80191","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108636","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66301","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53174","الخفيف"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101627","الكامل"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101641","الكامل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139978","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77124","الرجز"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139253","السريع"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66112","المتدارك"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33443","الخفيف"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204199","الكامل"],[4980,"يَا سَائِلِي عِتقًا","https://www.poetsgate.com/ViewPoem.aspx?id=191452",""],[5064,"حُطام مقدور بائس","https://www.poetsgate.com/ViewPoem.aspx?id=199131",""],[3271,"الشادوف","https://www.poetsgate.com/ViewPoem.aspx?id=104129",""],[5212,"رزءُ العليل","https://www.poetsgate.com/ViewPoem.aspx?id=212052",""],[5409,"هل مسك الوجد مثلي أيها البان","https://www.poetsgate.com/ViewPoem.aspx?id=155513",""],[5431,"زندقة!..","https://www.poetsgate.com/ViewPoem.aspx?id=194763",""],[5431,"كيما يموت الفرزدق","https://www.poetsgate.com/ViewPoem.aspx?id=208658",""],[5493,"مثلَ النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=208609",""],[5561,"المجد","https://www.poetsgate.com/ViewPoem.aspx?id=205111",""],[5703,"أشواق وهواجس","https://www.poetsgate.com/ViewPoem.aspx?id=208968",""],[5818,"لست تعرفني","https://www.poetsgate.com/ViewPoem.aspx?id=193182",""],[5906,"أجراس الحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=188073",""],[6152,"دع لي خيالك","https://www.poetsgate.com/ViewPoem.aspx?id=202694",""],[5464,"نسيب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66708&r=&rc=9",""]],"verses":[["دَع لِلمَشيبِ ذِمَّةً","إِنَّ لَهُ عِندي يَدا",0,"د",2,0],["دعْ لباكٍ رسومَه وطلولَهْ","ولحادٍ ركابه وحُمولَهْ",1,"ل",2,1],["دَع لِباكيها الدِيارا","وَاِنفِ بِالخَمرِ الخُمارا",2,"ر",2,1],["دع لمحةً إ تستطع عُلَقَ الهوى","فبذاك تعلمُ كيف نام النوَّمُ",3,"م",1,0],["دَع لِلمَناقِبِ بَعضَ سَعيِكَ حائِزاً","وَاِنظِم جَواهِرَها أَبا الفِتيانِ",4,"ن",1,0],["دَع للجهادِ قواعدَ الزجَّاجِ","ودفاترَ الورَّاقِ والسرّاجِ",5,"ج",1,1],["دَع لِتيهِ الدَلالِ وَاِسمَح بِرَشفَه","مِن رَحيقٍ قَد رَصَعَ الدُرَّ ظَرفَه",6,"ف",2,1],["دعْ لِتقصيرنا المَعاذيرَ يامَنْ","هُو عُذرُ الزَّمانِ مِن كُلِّ ذَنْبِ",7,"ب",1,0],["دَعْ لَومَه فكفَاهُ تعذِيبُ الهَوى","واستَبِقْ عَافيةَ النّعِيم السّابغِ",8,"غ",1,0],["دع للهوينَا الغَمرَ من أبنائها","وللمنى فما المنى إلا ضَنا",9,"ن",2,0],["دع للعبرات تنسجم انسجاما","ونار الوجد تضطرم اضطراما",10,"م",2,1],["دعله المعالي بمخدومها","وقالت بانسي كفى المجد فخرا",11,"ر",2,0],["دع للهوى جسما يذوب صبابة","وارفق فإن الخطب جد جسيمِ",12,"م",1,0],["دَع لَطم خَديكَ إِنَّ اللَطمَ يوجعها","سُدىً كَمَن يَندُبُ الأَحجار وَالطَلا",13,"ل",2,0],["دع لومه فلحاجةٍ جدعَ اَنفَه ال","غالي قصيرُ وما عراه العار",14,"ر",1,0],["دع لي ودادي فهو فو","زي والثبات على الوداد",15,"د",1,0],["دع لحسان آل جفنة واترك","لرميم الباكي الديار بلاله",16,"ل",2,0],["دع للقضاء كتابه يقضي بما","يقضي فلست رهين أمر كتابه",17,"ب",2,0],["دع لابنِ حامدَ من يُحبُّ ولا تكُن","أَلَّا تُذَلُّ على دُرَيدَ مزاحمي",18,"ي",1,1],["دعْ للحبيب ذمامي واحتمل رمقي","فليسَ ذا قدم من ليس ذا قدم",19,"م",1,0],["دَع لِلمُنى في ذي المَنافي لِلهُدى","وَاِجفِ الَّذي يَجفو سَبيلَ السَعدا",20,"د",2,0],["دع لذة الدنيا فمن يبتلى","بحبها ذاق عذاب السموم",21,"م",1,1],["دَعْ لَوْمِي عنكَ فَلِي كَبِدٌ","قَرِحَتْ منْ ذُلٍّ أَشْهَدُهُ",22,"د",2,0],["دَع لذيذ الكَرى حَبيسا علَيكا","إن جَفاني فَلا جَفا مُقلتيكا",23,"ك",2,1],["دع لي السواد وخذ بياضك إنني","أدري بما آتي وما أتخيرُ",24,"ر",1,0],["دَع لِلهَوَى نَبضًا لِقَلبٍ قَد هَوَى","مَا ذَاقَ طَعمَ العَيشِ مَن لَا يَعشَقُ",25,"ق",1,0],["دع لذِيذ العيشِ في أحلامِنَا","أَيُّنا أفلتَ من أيدي القضَاءْ ؟!",26,"ا",2,0],["دع لحنك الشادي بلا تعزيفِ","طرِب الخيال لأنّة الشادوفِ",27,"ف",1,1],["دَعْ لي روايَةَ سَبْينا مِنْ شامِتٍ","ظُلْمَاً يَسوقُ بِنا إلى أَرْضِ الفِتَنْ",28,"ن",1,0],["دع لومها أيها الوادي فإن له","عذراً وثق أن بعض اللوم بهتان",29,"ن",1,0],["دع للحسود كلامه وظلامه","وخذ الهوى صرْفا يجيئ لتشهقه",30,"ق",2,0],["دع لي ثمالة دنّي","فالخمر فيك تعتّق",31,"ق",1,0],["دعْ لِي سمائِي وانتشِلْني منْ ترابِ","اليأسِ إنَّ اليأسَ شَلًّ مُعمَّرَهْ",32,"ر",2,0],["دعْ للقصائدِ أهلَها فنبوغُهمْ","طبعٌ بهمْ وهُمُ الّذينَ توقّدوا",33,"د",3,0],["دعْ لومَ قلبي لاتلُمْ قلباً صَبا","ياعاذلي دارتْ عليكَ الدائره",34,"ر",2,0],["دعْ لبْس قولي واللباس وسحْنتي","يا وجْه .. إنّ الله ينظر للقلوبْ",35,"ب",1,0],["دَعْ لِلخَليقَةِ شَأنَها وتَعالى","فاللهُ أَوْلى بِالعِبادِ تَعالى",36,"ل",2,1],["دع لي خيالك أكتفي من دفئه‬","‫فالبرد قاسِ والمساء طويل‬",37,"ل",1,1],["دَعْ للزمانِ بني الزمانِ","فإنَّ أذرعَهُ تنوبُ",38,"ب",1,0]]}