{"poems":[[55,"بقلبي للنوائب جانحات","https://www.aldiwan.net/poem30186.html","الوافر"],[95,"اسمع شكاتي فهي إن لم تفد","https://www.aldiwan.net/poem11090.html","السريع"],[74,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[74,"تهن بمنزليك وجر ذيلي","https://www.aldiwan.net/poem18944.html","الوافر"],[64,"إذا التركيب سميناه باسم","https://www.aldiwan.net/poem52194.html","الوافر"],[47,"نحن الفداء فمأخوذ ومرتقب","https://www.aldiwan.net/poem10890.html","البسيط"],[82,"مرابعهم للوحش أضحت مراتعا","https://www.aldiwan.net/poem31383.html","الطويل"],[19,"فمندفع الغلان غلان مُنشد","https://www.aldiwan.net/poem331.html",""],[47,"نحنُ الفِداءُ، فمَأخُوذٌ وَمُرْتَقَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=31563",""],[139,"بالاجتهاد الشعوب ترقى","https://www.aldiwan.net/poem49179.html","مخلع البسيط"],[147,"بإحرازك الفضل الذي بهر الخلقا","https://www.aldiwan.net/poem11786.html","الطويل"],[170,"يذكرني الحمى عهد الوصال","https://www.aldiwan.net/poem46897.html","الوافر"],[170,"إذا الفجار أطغاهم غناهم","https://www.aldiwan.net/poem47070.html","الوافر"],[208,"وعذب المقبل والمبتسم","https://www.aldiwan.net/poem53184.html","المتقارب"],[216,"منازل للأحباب غبر طوامس","https://www.aldiwan.net/poem37874.html","الطويل"],[275,"شربناها على ذكر الوليد","https://www.aldiwan.net/poem35590.html","الوافر"],[276,"رفاقي الظاعنين متى الورود","https://www.aldiwan.net/poem52071.html","الوافر"],[280,"أدرك بخيلك خيل الله أندلسا","https://www.aldiwan.net/poem25469.html","البسيط"],[303,"ذر النفس لا يود الأسى بذمائها","https://www.aldiwan.net/poem36289.html","عموديه"],[310,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[369,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[466,"إذا اشتملت على شمس وبدر دجى","https://www.aldiwan.net/poem16103.html","البسيط"],[469,"سرت بدر تم في سحاب من النقب","https://www.aldiwan.net/poem3292.html","عموديه"],[482,"هو الدمع أضحى بالغرام يترجم","https://www.aldiwan.net/poem15192.html","الطويل"],[534,"إذا أعوز المرء الصعود إلى التي","https://www.aldiwan.net/poem37461.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86688","الوافر"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82596","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128787","الرجز"],[1877,"","https://poetry.dctabudhabi.ae/diwan/poem/115249","الوافر"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177828","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120991","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93666","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65134","الطويل"],[3277,"","https://poetry.dctabudhabi.ae/diwan/poem/125980","المتقارب"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112301","الطويل"],[3675,"","https://poetry.dctabudhabi.ae/diwan/poem/37567","الرجز"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111055","الوافر"],[4282,"","https://poetry.dctabudhabi.ae/diwan/poem/144821","السريع"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99120","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139519",""],[4709,"إليها وحدها أهدي فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=214802",""],[4927,"أبناء السحالي","https://www.poetsgate.com/ViewPoem.aspx?id=80797",""],[5582,"أَهذا الَّذِي تَحْتَ النِّقابِ هُوَ الخَدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=63487",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5830,"الْكَوْنُ يَنْظُرُكُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=200765",""],[5842,"سورية ( ثائر على الأسد )","https://www.poetsgate.com/ViewPoem.aspx?id=66279",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[6102,"لا كرامة لنبي في قومه ..","https://www.poetsgate.com/ViewPoem.aspx?id=186289",""]],"verses":[["فَمَن دَلَّ المَشيبَ عَلى عِذاري","وَما جَرَّ الذَبولَ عَلى غِراسي",0,"س",2,0],["فمن دعا يومئذٍ واجد","فينا عديد الخير مستكملا",1,"ل",2,0],["فمن دالٍ ومن ألفٍ وميمٍ","كقوسٍ أو كسهمٍ أو قتير",2,"ر",1,0],["فمن دار السعادة كلّ يوم","إلى دار الهنا وهلمَّ جرا",3,"ر",2,0],["فمن در الرموز على الاسامي","ففيهن الحقيرة والخطيره",4,"ر",2,0],["فمن در وياقوت ثمين","وأملاح وزاجات حقيره",4,"ر",2,0],["فَمِن دُموعِ عُيونٍ قَلَّما دَمَعَت","وَمِن وَجيبِ قُلوبٍ قَلَّما تَجِبُ",5,"ب",1,0],["فمن دمنةٍ تحت القطوب كمينةٍ","بها وثلاثٌ راكدات سوافعا",6,"ع",2,0],["فَمُندَفِعُ الغُلّانِ غُلّانِ مُنشِدُ","فَنَعفُ الغُرابَ خُطبُهُ فَأَساوِدُه",7,"ه",1,1],["فمِنْ دُموعِ عُيونٍ قلما ما دَمَعتْ،","وَمن وَجيبِ قُلُوبٍ قلما ما تَجِبُ",8,"ب",1,0],["فمن درى العلم واستفادهْ","بقدره أحرز السعادهْ",9,"د",2,0],["فَمِن دونِ دينٍ قَد تَوَلَّيتَ نَصرَهُ","قَبائِلَ مِن قَيسٍ وَقَحطانَ ما تُلقا",10,"ق",2,0],["فمن دالٍ تُصاغُ على اعتدالٍ","ومن ذالٍ تصانُ عنِ ابتِذالِ",11,"ل",1,0],["فمن دامي الكعوبِ بذي كعوبٍ","مَخضوبِ الفقارِ بذي الفقارِ",12,"ر",1,0],["فمن دام بالعهد دُمنا له","ونستودع الله مَن لم يَدم",13,"م",1,0],["فَمِنْ دون لُقياها رِماحٌ معاطف","وَمِنْ دون ذكراها ليوثٌ عوابسُ",14,"س",1,0],["فمن دائي الدواءُ وفي الحميّا","محيّا السَّعدِ يبسمُ للمجيد",15,"د",1,0],["فمن دار السَلام له نَسيم","ومن نور الجَلال له عمود",16,"د",1,0],["فَمِنْ دَسَاكِرَ كانَتْ دُونَهَا حَرَساً","وَمِنْ كَنَائِسَ كَانَتْ قَبْلَها كُنُسا",17,"س",2,0],["فمن دون هذا خِضْرمُ الدمعِ نافدٌ","وَقلبُك مصدوعٌ وإِن كان قاسيا",18,"ي",2,0],["فَمِن دُهُمٍ صوصٍ لحفّى تقلّصت","عنِ الصبحِ مِن ليلٍ تحالَكَ وَاِمتطّا",19,"ط",2,0],["فَمِن دَم الكَرمِ أُيعضس عُروقي","تُحيِ بِهِ نَفسَ أَمرِئٍ صَديقِ",20,"ق",1,0],["فمن دعاني قميصاً باتَ يَظْلمُني","وإنما أنا لو أنصفْتُمُ فَلكُ",21,"ك",1,0],["فمن دمعِ طلٍّ فوق وجنة وردها","يزين لمن ظلٍّ على خضرٍ عذب",22,"ب",1,0],["فمِنْ دمعةٍ فوقَ الخدودِ مُذالةٍ","وأخرى على تُرْبِ المنازلِ تُسْجَمُ",23,"م",1,0],["فمِنْ دُونِ تَحْلِيقِ النُّسورِ مَنَازلٌ","تَروحُ بِها رُقْشُ الْبُزاةِ وتَغْتَدي",24,"د",2,0],["فَمن دَعواك تب وَاِرجَع وَإلا","صَفعتك بِالنعال عَلى الخُدود",25,"د",1,0],["فَمن دونِها أَن تُستَباح دِماؤُنا","وَمن دونِها أَن يُستَذَمّ دِماؤُها",26,"ا",3,0],["فمن دون عرش النيل كل مدرب","كمي متى يرعد له الهول يبرق",27,"ق",1,0],["فمن دمى قد ارتوت حتى روت","للناظرين عن دمي عندمها",28,"م",3,0],["فمن دان بها لم تدن مني","حقيقته وآت غير آت",29,"ت",1,0],["فمن دمهم فوق الأباطح والربى","شقيق ومن زرق الأسنة نوفر",30,"ر",1,0],["فمن دارع في درعه وحسامه","أشعّة نار الحرب أضرمها الصقل",31,"ل",1,0],["فَمن دَعاك بِكرب قَد أَضَرَّ بِهِ","فَكُل كَرب بِعَون اللَه يَنكَشف",32,"ف",1,0],["فمن دون ما يبغي عواد تعوقُه","ومن دون ما يهوى تحزّ الغلاصم",33,"م",1,0],["فمن دسَّ فيه سموم الخمول","وأطفأ منه الضياء السنى",34,"ن",2,0],["فَمِن دَرَكاتِ الذلّ تصبحُ صَاعِداً","عَلى دَرَجاتِ العِزِّ تَعلو مَراتِبا",35,"ب",2,0],["فمِن دمِ الكَرْمِ أعِضْ عُروقي","تُحْيِ بهِ نَفْسَ امرئٍ صَديقِ",36,"ق",1,0],["فمن دل القضاء عليك يقضي","وكنت لكل غامضة دليلا",37,"ل",2,0],["فمن دنا منا فأهلاً به","ومن تولى فإلى النار",38,"ر",1,0],["فمن دأبه منا نحولٌ ودقةٌ","فمما جنى أحبابنا لا الحبائب",39,"ب",1,0],["فمن دونها طعنُ لدن القوا","م ومن دونها حدُّ ماضي الشبا",40,"ب",2,0],["فمن دلّ التي طرقتْ فؤادي","بأشجان الفؤادِ وما أنيني",41,"ن",2,0],["فَمِنْ دُوْمَاْ إِلَىْ حِمْصَ اجْتِيَاْحٌ","إِلَىْ جِسْرِ الشُّغُوْرِ، وَبُوْ كَمَاْلِ",42,"ل",1,0],["[ فَمَنْ دانَ مِنْهُمْ عاشَ فِي النَّاسِ مُعْتَقاً","وَمَنْ لَمْ يَدِنْ مِنْهُمْ تَضَمَّنَهُ اللَّحْدُ ]",43,"د",1,0],["فمن دورنهم كانوا المبشرين أنهم","طوالع قلب الجيش طه اليتيمتي",44,"ت",2,0],["فَمِنْ دِمِشْقَ لِسَيْحُونٍ ﻷَنْدَلُسٍ","ذِكْرَى الْمَآثِرِ دَمْعَ العَيْنِ تَمْتَاحُ",45,"ح",1,0],["فَمُنْدَسٌّ يُرافِقُهُ سِلاحٌ","وإرهابيةٌ تحتَ الرّداءِ",46,"ا",2,0],["فمن دعاهم ومن صلى على أحد","من النبيين حيانا وأتحفنا",47,"ن",2,0],["فَمِن دَمِيَ النَّزيفِ , وَشِلوِ لَحمي","كَأَنَّ \" المَنَّ \" وَ \" السَّلوى \" , \" خُضارُ \"",48,"ر",1,0]]}