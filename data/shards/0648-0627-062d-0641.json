 إلى سَجينِ السَّكَر","https://www.poetsgate.com/ViewPoem.aspx?id=156015",""],[5376,"إنِّي جَزِعْتُ وما لنا الا هو","https://www.poetsgate.com/ViewPoem.aspx?id=188286",""],[5376,"أردن يا الله فاحفظ أرضها","https://www.poetsgate.com/ViewPoem.aspx?id=188501",""],[5376,"وشجى على هولِ المصاب ِهَزَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=189133",""],[5376,"احزمْ متاعَك أيها الرجلُ","https://www.poetsgate.com/ViewPoem.aspx?id=198998",""],[5409,"دم ذاكراً فيك يا شعبان من وثبوا","https://www.poetsgate.com/ViewPoem.aspx?id=155253",""],[5419,"بين الشعراء أنا عجبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=31465",""],[5431,"يافتاتي قتيلك الصبّ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=196586",""],[5444,"راية الأمجاد","https://www.poetsgate.com/ViewPoem.aspx?id=209112",""],[5582,"أَلا ما لِدَمْعِكَ يَجْرِي طَلَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=187236",""],[5582,"دَعْهُ يَحِنُّ لِشَجْوِهِ وَشُجُونِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63583",""],[5596,"روحُ العوْدة","https://www.poetsgate.com/ViewPoem.aspx?id=206173",""],[5596,"رد على قصيدة حمزة بن عبد الحميد","https://www.poetsgate.com/ViewPoem.aspx?id=206717",""],[5626,"اربأ بنفسك","https://www.poetsgate.com/ViewPoem.aspx?id=189715",""],[5703,"ليلة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=206151",""],[5704,"قُمْ خليلي ...","https://www.poetsgate.com/ViewPoem.aspx?id=198798",""],[5829,"ولد السلام","https://www.poetsgate.com/ViewPoem.aspx?id=178915",""],[5829,"تلك الفتاة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=190585",""],[5829,"إنه شعبان","https://www.poetsgate.com/ViewPoem.aspx?id=204021",""],[5829,"ذكره العطر","https://www.poetsgate.com/ViewPoem.aspx?id=213703",""],[5830,"يَا صَاحِبَ الكَلِمَاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=200769",""],[5841,"قلي عَدَوك وغيروا من طباعك","https://www.poetsgate.com/ViewPoem.aspx?id=37036",""],[5879,"السودان","https://www.poetsgate.com/ViewPoem.aspx?id=215936",""],[5906,"أجراس الحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=188073",""],[5909,"جوهرُ العشق","https://www.poetsgate.com/ViewPoem.aspx?id=213328",""],[5977,"حرر قيودك","https://www.poetsgate.com/ViewPoem.aspx?id=212738",""],[161,"ربيعَا للأمة زَعَمُوا !","https://www.poetsgate.com/ViewPoem.aspx?id=211185",""],[6093,"أصابع ريح","https://www.poetsgate.com/ViewPoem.aspx?id=201753",""],[6115,"استغفرالله العظيم استغفر الله العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=180498",""],[6117,"شَهْرُ رَمَضَانْ الْمُبَارَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=182798",""],[6152,"نحو مكة","https://www.poetsgate.com/ViewPoem.aspx?id=204656",""],[5309,"خطرت وورد الروض بين يديها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573535",""],[6202,"خواطر صائم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86720&r=&rc=21",""]],"verses":[["وَاحْفَظْ بِحَزْمِكَ كُلَّ سِرْبٍ غَافِلٍ","وَاكْلأْ بِسُهْدِكَ جَفْنَ كُلِّ مُهَوِّمِ",0,"م",1,0],["وَاحفَظ لِمِصرَ حُقوقَ مِص","رَ فَأَنتَ في الجُلّى لَها",1,"ه",2,0],["وَاِحفَظِ العَهدَ فَإِنّي","لَستُ وَاللَهِ أَخونُ",2,"ن",1,0],["واحفذك شهبا مضيّا","قد نظيم حولك أسلاك",3,"ك",1,0],["واحفظْ فؤادَك إنْ شَربتَ ثلاثةً","واحْذَرْ عليهِ أنْ يطِيرَ من الفرحْ",4,"ح",1,0],["واحفظ على مصر السكينة إنها","روض بأفياء السكينة ممرع",5,"ع",1,0],["واحفظ له جاويشه","سامى العزيز المؤتمن",6,"ن",1,0],["وَأَحفَظُ العَهدَ لَهُ عَلى النَوى","وَالصِدقَ في الوُدِّ لَهُ وَفي الهَوى",7,"ه",3,0],["وَأَحفَظُ مِنكَ ما ضَيَّعتَ مِنّي","عَلى رَغمِ المُكاشِحِ وَالحَسودِ",8,"د",1,0],["وَأَحفَظُ لِلذِمامِ إِذا مَتَتنا","إِلَيكَ بِهِ وَأَحمى لِلذِمارِ",9,"ر",1,0],["وَإِحفَظ عَلَيهِ الحَديثَ مُكتَتِماً","ثُمَّ أَعِدهُ عَلَيَّ إِعلانا",10,"ن",2,0],["وَاِحفَظ لِسانَكَ وَاِحتَرِز مِن لَفظِهِ","فَالمَرءُ يَسلَمُ بِاللِسانِ وَيُعطَبُ",11,"ب",1,0],["وَاِحفَظ وَصِيَّةَ وَالِدٍ مُتَحَنِّنٍ","يَغذوكَ بالآدابِ كَيلا تُعطَبُ",12,"ب",1,0],["وَاَحفَظ صَديقَكَ في المَواطِنِ كُلِّها","وَعَلَيكَ بِالمَرءِ الَّذي لا يَكذِبُ",12,"ب",1,0],["وَاِحفَظ أَخاكَ لِما رَجاكَ لَهُ","وَإِذا دَعاكَ فَكُن لَهُ عَضَدا",13,"د",2,0],["واحفظْ لصاحبِكَ القديمِ مكانَهُ","لا تتركِ الودَّ القديمَ لطارِ",14,"ر",1,0],["وَأَحفى سَلامٍ يَعبُرُ البَحرَ دونَهُ","فَيَندى وَأَزهارَ البِطاحِ فَتَنفَحُ",15,"ح",1,0],["وَاِحفَظ لِسانَكَ في الواشينَ إِنَّ لَهُم","عَيناً تَرودُ وَتَنفيراً وَإِلهابا",16,"ب",2,0],["وأحفرُ بعد الردى قبرَه","هناك على قمَّةِ الهاويَهْ",17,"ه",1,0],["واحفزوا النجمَ إلى ثورتهِ","واحطموا أنوالَ ليلٍ لا يُفيقْ",18,"ق",1,0],["واحفظوا اللفظَ والأساليبَ والذو","قَ وهاتوا ما شئتُمُ من معاني",19,"ن",2,0],["وأحفرْ طريقاً ما رآه الذي","عن كُلِّ مَدْعُوٍّ وداعٍ يَنوب",20,"ب",1,0],["واحفظ لربك روحها وحياتها","سيان لو أبصرت ميتا والحجر",21,"ر",1,0],["واحفظ الود واصدق العهد واسلك","سبل الطيبين وارحم لترحم",22,"م",1,0],["واحفظ حقوق الصحب صحب المصطفى","والقوم من نسجوا على منواله",23,"ل",2,0],["وأحفادهم بالتدلي أنى","زمان النشور ويوم القيام",24,"م",1,0],["واحفظِ الشرعَ وكرّر دَرْسَه","أبداً في كلِّ حينٍ لا تملْ",25,"ل",1,0],["واحفظِ الجارَ وإن جارَ فمَنْ","حفظَ الجارَ فقد سدَّ الخَلَلْ",25,"ل",1,0],["واحفل بجارتكَ التي","لم ترعَ يا قلبي الجوارْ",26,"ر",1,0],["واحفظ بحفظ لائق بجنابكم","من كل هول وابتلاء ومصيبة",27,"ه",1,0],["واحفظ علاه وأرسل يا كريم له","من الملائك حفّاظاً وأعوانا",28,"ن",2,0],["واحفظ إلهي ما أوليتهم كرما","وقرّ أعينهم دنيا مع الدين",29,"ن",1,0],["وَأَحفَظُ وُدَّ الأَصدِقاءِ وَإِن هُمُ","إِلَيَّ بِلا جُرمٍ أَساؤُوا وَأَجرَمُوا",30,"م",3,0],["واحفظ حسابك ان تعدد سربها","واضرب لها الاخماس في اسداسها",31,"س",3,0],["واحفظ حديث الحسن عمن قد رأى","من آيه الكبرى وما زاغ البصر",32,"ر",1,0],["وَاِحفَظوا عهدي القَديمَ فَإني","حافظٌ عهدَكم بِرَغم البِعاد",33,"د",1,0],["وَاِحفَظ عُهوداً بِالحِمى عاهَدتَني","أَيّامَ كُنتَ مُنادِمي وَمُسامِري",34,"ر",2,0],["وَاحْفَظْ أَبِي فِي غَيْبَةٍ شَطَّتْ بِهِ","وَاكْلَأْهُ مِنْ غُولِ النَّوَى وَخَبَالِهَا",35,"ل",3,0],["وَاحْفَظْ أَبَاهُ وَأَهْلَهُ وَشُيُوخَهُ","فِي هَذِهِ الدُّنْيَا وَفِي أُخْرَاهَا",36,"ا",3,0],["وَاحْفُفْهُ يَارَبِّ بِكُلِّ سَنىً","وَاسْقِهِ مِنْ حَوْضِ الْمُنَى أَرْيَهْ",37,"ي",2,0],["واحْفَظيها في شِغافٍ","لَوْ إلى وقتٍ قريبِ!",38,"ب",1,0],["واحفظي عهدي ووعدي","لكِ مني كل ودّي.",39,"د",2,0],["واحفظه في تقلّبات الدهرِ","والحظه في السرّ كذا في الجهرِ",40,"ر",1,0],["واحفظه والأوالادَ والعيالا","ممّا لسوء الحال فيهم آلا",40,"ل",2,0],["واحفظ عليه سبلهم واطلبهم","فلقد أضاعوا الحق أي تضيع",41,"ع",1,0],["واحفظ بقلبكَ ما تراهُ بمقلةٍ","خشعت من التغريمِ والترنيخ",42,"خ",1,0],["واحْفَظوها مِن ظُبَى ألْحَاظِكم","حِفْظَكُم ذَاك اللّمى والفَلَجَا",43,"ج",2,0],["واحفظي يا دهور ذكرى أبي","المنذر فخر الشباب للأجيال",44,"ل",1,0],["واِحفظهمُ وصنهمُ","واِنفِ الظنونَ عنهمُ",45,"م",1,0],["واِحفظِ القَلبَ أَن يَبوحَ بسرٍّ","واِنتظِرها لوَقتِها المَوقوتِ",46,"ت",1,0],["وأحفظهم كتمان أمرِكِ فانطوتْ","صدورُهم مما كتمتُ عَلى بغض",47,"ض",1,0],["واحفظ لسانك من طعن علي أحد","من العباد ومن نقل ومن كذب",48,"ب",1,0],["واحفظي ودّي وعدي","وارحمي قلبي العليل",49,"ل",1,0],["وَاِحفظ لَنا يا ذا العُلى","ربَّ الوَلا والي الوِلايه",50,"ه",1,0],["واحفظ لنا ربنا في ابن وحاشية","وذي وداد بحبل الشيخ مرتبط",51,"ط",1,0],["وَاِحفَظ قَديم العَهد اِذ","شَملى وَشَملِكَ في اِلتِئام",52,"م",1,0],["واحفظ إلهي من آفات الزمان","وكمن لنار بنافي كل حين",53,"ن",1,0],["واحفظ مقالك إذا شئت الأمان","إلا بخير أو بمعروف مبين",53,"ن",1,0],["واحفظ القلب لا يدخله غير","صنه عن غيركم كل الصوان",54,"ن",1,0],["واحفظ إلهي لي جميع الصحاب","بجاه سيدنا اليماني",55,"ن",2,0],["واحفظ كلامك فإن القول كله شتيم","إلا كلاما يسرك في المقام العظيم",56,"م",1,0],["واحفظ أولادي ووفقهم لما","ترتضيه إنك الرب الرحيم",57,"م",1,0],["واحفظ القول فماكب الورى","في جهنم غير أقوال رذال",58,"ل",1,0],["واحفظ الأنفاس لا تنفقها","غير في كسب الفضائل والمعال",59,"ل",1,0],["واحفظ أهلي وأحيبابي ومن","ودنا فيك ووفق لرضاك",60,"ك",1,0],["واحفظ لسمعك وعينك والمقال","وكل أعضاك واحذر أن تحيد",61,"د",1,0],["وأحفظني حبّاً لِعَهدِ ودادِه","وأوهَنَ عقدُ الودّ منّي وأوهَاهُ",62,"ه",1,0],["وأحفَظُها وهيَ المُضِيعُ لَعَهْدهِ","فيا عجَبَاً من حافظٍ لِمُضيعِ",63,"ع",1,1],["وَأَحفَظُ مَنصِبي وَأَصونُ عِرضي","وَبَعضُ القَومِ لَيسَ بِذي حِياطِ",64,"ط",1,0],["واحفظ علينا السمع من آفات","والشم والذوق من العاهات",65,"ت",1,0],["واحفظ