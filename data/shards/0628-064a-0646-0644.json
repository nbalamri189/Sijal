{"poems":[[71,"ما لي وللسعي إلى","https://www.aldiwan.net/poem28384.html","مجزوء الرجز"],[71,"هنيت عاما مقبلا مقبلا","https://www.aldiwan.net/poem28741.html","السريع"],[107,"أعد الرجاء وجدد الأملا","https://www.aldiwan.net/poem42045.html","أحذ الكامل"],[107,"من حق ركبك أن يهز النيلا","https://www.aldiwan.net/poem43063.html","الكامل"],[104,"بين ليلى وسعاد ومنى","https://www.aldiwan.net/poem33048.html","الرمل"],[226,"صدقت فيما حكت عنك الدموع","https://www.aldiwan.net/poem55268.html","الرمل"],[237,"بين لوى الجزع ووادي العقيق","https://www.aldiwan.net/poem14784.html","السريع"],[242,"من للبيان خليفه","https://www.aldiwan.net/poem19798.html","المجتث"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101525","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64073","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37819","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77628","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145976","مجزوء الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95550","الخفيف"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203760","الخفيف"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49592","الخفيف"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199812","المسحوب"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2566,"","https://poetry.dctabudhabi.ae/diwan/poem/80115","البسيط"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71363","المنسرح"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110207","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110163","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114601","السريع"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83663","الخفيف"],[5183,"من طرائف المأمون","https://www.poetsgate.com/ViewPoem.aspx?id=180285",""],[5302,"ليل ونهار","https://www.poetsgate.com/ViewPoem.aspx?id=200550",""],[5596,"السحمية","https://www.poetsgate.com/ViewPoem.aspx?id=206361",""]],"verses":[["بينَ لئامٍ لوْ أتى","بضرطةٍ قالوا عَطَسْ",0,"س",1,0],["بيِّنْ ليَ القصدَ وصرِّحْ بما","تراهُ في أمري فقدْ أُشكلا",1,"ل",2,0],["بَيِّنْ لنا سُبْلَ الأُلىَ رَشَدُوا","وَاضْرِبْ بِسَيْفِ الله مَن عَدَلا",2,"ل",2,0],["بَيِّن لَهُ مَعنى الثَباتِ فَلَيسَ مِن","خُلُقِ المُجاهِدِ أَن يَكونَ مُلولا",3,"ل",2,0],["بَينَ لَيلى وَسُعاد وَمُنى","حارَ إِلياس كَما حرت أَنا",4,"ن",2,1],["بين ليل ونهار قد خلت","فجأة من شخصك الغالي الربوع",5,"ع",1,0],["بَينَ لَوى الجَزعِ وَوادي العَقيقِ","مَن لا إِلى السَلوانِ عَنهُ طَريق",6,"ق",1,1],["بَيِّنْ لَنَا مُقْتَضَاهُ","يَا رَبَّهُ وَحَلِيفَهْ",7,"ف",2,0],["بين لهوٍ ونعيم وصفا","وحديثٍ كاللآلي تُنضدُ",8,"د",1,0],["بين لينٍ وشدةٍ فتراه","وهو حُلُو المذاقِ مُرَّ المذق",9,"ق",1,0],["بَيِّنْ لنا أُحجيةً","يا مَنْ يحوزُ الأدَبا",10,"ب",2,1],["بَيّن لَنا ماذا جَرى لِلأَرض","ما فَعَلت في طولِها وَالعَرض",11,"ض",1,0],["بَينَ لصٍ وقاتلٍ","تتلَّوى وتركُنُ",12,"ن",1,0],["بين ليل دجا وصبح تداجى","سلبته للنون سمحاً رضيّا",13,"ي",2,0],["بين لفح من اللواعج حام","وملثّ من المدامع سكب",14,"ب",1,0],["بين ليلٍ كَخُضْرَةِ الرَّوضِ في الحُس","نِِ وَصُبْحٍ كَعَرْفِهِ في الشَّميم",15,"م",1,0],["بين لكتوف وبين ردفه تعازيل","امضمّرٍ طيّ الحقب فيه مجلود",16,"د",1,0],["بَيِّن لَنَا تِلكَ المَعَانِي وَالذِي","مِنهَا أرِيدَ بِوَاضِحِ التِّبيَانِ",17,"ن",1,0],["بَيِّنْ لنا يأْمُرِ الجنْدانِ أمرَهما","ماذا تريدُ بأنَّا منكُمُ قَمَنُ",18,"ن",1,0],["بَيْنَ لَمَاهُ وَحُمْرَةِ الخَدِّ","خَالٌ حَكَى نَحْلَةً عَلى شَهْدِ",19,"د",1,1],["بين لَعَمرُ ابيكَ ما","قولي لمن مَلَكَ اقتنص",20,"ص",1,0],["بَين لنا يا صاحبَ التِبيان ما","تعبٌ لهُ غِلٌّ حَشاهُ مُنكسِر",21,"ر",1,0],["بينَ لنا الجمعينِ يا ذا الذي","يُقيمُ فيما يدَّعي البيِّنَه",22,"ن",2,0],["بَينَ لَفظٍ وَبَين لَحظٍ مُشيرٍ","قَد يؤدّى المَعنى إلى الأفهامِ",23,"م",1,0],["بين ليلاه وليلته","طائش التفكير والقلم",24,"م",1,0],["بين ليل بظلمة ونهار","بضياء نظل نحيا انقيادا",25,"د",2,0],["بين لهوٍ وغفلةٍ وتمنٍّ","وتمادٍ في غفوةٍ وغوية",26,"ي",2,0]]}