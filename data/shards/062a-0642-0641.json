{"poems":[[72,"ركد الرجاء فما يهزك مأرب","https://www.aldiwan.net/poem43107.html","الكامل"],[94,"بالأمس قد كانت حياتي","https://www.aldiwan.net/poem38891.html","المجتث"],[91,"ويل لمملكة قضى اهمالها","https://www.aldiwan.net/poem44846.html","الكامل"],[87,"لمن المساكن كالمقابر","https://www.aldiwan.net/poem7768.html","مجزوء الكامل"],[87,"تاج البلاد تحية وسلام","https://www.aldiwan.net/poem8106.html","الكامل"],[47,"لازال محتفل الغمام الباكر","https://www.aldiwan.net/poem63617.html","الكامل"],[47,"لما استعنت على الخطوب بصالح","https://www.aldiwan.net/poem65624.html","الكامل"],[47,"إن الأمير أبا علي أصبحت","https://www.aldiwan.net/poem65628.html","الكامل"],[47,"قد ترى دارسات الرسوم","https://www.aldiwan.net/poem65654.html","الخفيف"],[47,"أرق العين أن قرة عيني","https://www.aldiwan.net/poem66693.html","الخفيف"],[51,"المرء آفته هوى الدنيا","https://www.aldiwan.net/poem10322.html","الكامل"],[76,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[54,"صاح بالوعظ شيب رأس مضي","https://www.aldiwan.net/poem26582.html","الخفيف"],[48,"اللب قطب والأمور له رحى","https://www.aldiwan.net/poem22570.html","الكامل"],[48,"سبحان ربك هل يزول كغيره","https://www.aldiwan.net/poem22706.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85329","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85418","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54741","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[112,"قطعة الحلوى","https://www.poetsgate.com/ViewPoem.aspx?id=8390",""],[47,"قَدْ تَرَى دارِاساتِ تِلْكَ الرّسومِ","https://www.poetsgate.com/ViewPoem.aspx?id=31726",""],[48,"سُبحانَ ربّكَ! هل يزولُ، كغيرِه،","https://www.poetsgate.com/ViewPoem.aspx?id=20281",""],[136,"ثلاث ليال حين جاز ينير","https://www.aldiwan.net/poem54674.html","الطويل"],[136,"تقفيت أزمانا مسيح زماني","https://www.aldiwan.net/poem54703.html","الطويل"],[280,"نادتك أندلس فلب نداءها","https://www.aldiwan.net/poem25647.html","الكامل"],[353,"شكواك من ألم المفاصل للذي","https://www.aldiwan.net/poem19819.html","الكامل"],[353,"شهدت دواة الفتح ساعة فتحها","https://www.aldiwan.net/poem20398.html","الكامل"],[412,"الليل حيث حللن فيه نهار","https://www.aldiwan.net/poem50176.html","الكامل"],[422,"كف الملام فما يفيد ملامي","https://www.aldiwan.net/poem53993.html","الكامل"],[454,"يزهو القريض به","https://www.aldiwan.net/poem972.html",""],[469,"ما كنت بالباكي ولا المتباكي","https://www.aldiwan.net/poem3512.html","عموديه"],[470,"وحدك الصوت","https://www.aldiwan.net/poem36434.html","عموديه"],[504,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[519,"ميلوا بنا نحو الحجون ونكبوا","https://www.aldiwan.net/poem20800.html","الكامل"],[519,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[543,"ثلاث شهور بل ثلاث دهور","https://www.aldiwan.net/poem48177.html","عموديه"],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198610","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63969","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70681","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64874","الكامل"],[1477,"","https://poetry.dctabudhabi.ae/diwan/poem/134232","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79859","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79850","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110327","الكامل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121184","السريع"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60922","الكامل"],[501,"","https://poetry.dctabudhabi.ae/diwan/poem/142581","الرمل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140088",""],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145047","الكامل"],[3928,"","https://poetry.dctabudhabi.ae/diwan/poem/131344","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111462","المتقارب"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54416","الطويل"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35047","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33359","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76746","الكامل"],[5338,"نبهتني والكرى يطوي الدجى","https://www.poetsgate.com/ViewPoem.aspx?id=187811",""],[5525,"نصال الخناجر","https://www.poetsgate.com/ViewPoem.aspx?id=7248",""],[5691,"صهيل وصليل","https://www.poetsgate.com/ViewPoem.aspx?id=206153",""],[5956,"أنا معجب بك‎ ‎","https://www.poetsgate.com/ViewPoem.aspx?id=182448",""],[5080,"إلى لحظتيكَ يحجّ السراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88130&r=&rc=0",""]],"verses":[["تَقِفُ الخَلائِقُ تَحتَ رايَةِ عَدلِهِ","فَيُقامُ ميزانُ الحُقوقِ وَيُنصَبُ",0,"ب",1,0],["تَقِفُ العَذَارَى الخالِداتُ","عَرَائِسُ الشِّعْرِ البَديعْ",1,"ع",1,0],["تقفو خطى الآباء انجال فما","الآباء راشدة ولا انجالها",2,"ل",3,0],["تقف الطبيعة دونه","تحمى الميامن والمياسر",3,"ر",1,0],["تَقِفُ القُرونُ غَداً عَلى دَرَجاتِهِ","تُملي الثَناءَ وَتَكتُبُ الأَيّامُ",4,"م",1,0],["تَقفونَ طَلحَةَ بِالفَعالِ وَإِنَّما","تَسرونَ في قَمَرِ السَماءِ الباهِرِ",5,"ر",1,0],["تَقِفُ المَوالي حَجرَتَيهِ فَإِن غَدا","أَغدى أُسوداً ما تُرامُ وَأَشبُلا",6,"ل",2,0],["تَقِفُ المَوالي حَجرَتَيهِ فَإِن غَدا","أَغدى لُيوثاً ما تُرامُ وَأَشبُلا",7,"ل",2,0],["تَقِفُ المَكرُماتُ لا يَتَوَجَّه","نَ لِوَجهٍ إِلّا إِلى حَيثُ يُمي",8,"م",2,0],["تَقِفُ العَينُ عِندَ أَنوَرِ وَجهٍ","يَتَجَلّى لَنا وَأَندى يَدَينِ",9,"ن",1,0],["تَقفو مَساويها مَحاسِنَها","لا شَيءَ بَينَ النَعيِ وَالبُشرى",10,"ا",1,0],["تَقِفُ الرِياحُ بِجانِبَيهِ هَيبَةً","وَيَعُبُّ بَحرُ العَسكَرِ الجَرّارِ",11,"ر",1,0],["تَقِفُ العُصَّفُ الزَعازِعُ فيها","وَلَها قَبلَها جَناحٌ سَرِيُّ",12,"ي",1,0],["تَقِفونَ وَالفُلكُ المُسَخَّرُ دائِرٌ","وَتُقَدِّرونَ فَتَضحَكُ الأَقدارُ",13,"ر",1,0],["تَقفوا الظَعائِنُ مِن نُوَيرَةَ أَجمَرَت","أَجمالَها سَحراً لِرَمي جِمارِ",14,"ر",1,0],["تقف العقول إذا أردن تفهُّما","حيرى هناك أمام أمرٍ مبهم",15,"م",1,0],["تقف العين عنده وَهي حيرى","يستبيها جماله المحبوب",16,"ب",1,0],["تقفُ لَوْ هَزَّهُ الخَطْبُ يَوْماً","هَزَ لدْناً منَ القَنا المَياد",17,"د",1,0],["تقِفُ الْعُيُونُ حِيَالَهَا","حَيْرَى عَلَى شَغَفٍ وَسُهْدِ",18,"د",1,0],["تَقِفُ الأوْهَأمُ حَسْرَى دُونَه","لاهثاتٍ قَصَّرَ الأيْن خُطَاها",19,"ا",3,0],["تقفل.. الفطره... وتفتح...... الف.....باب..","...؟للمضل.....او....للخفيف...او.....للرزين",20,"ن",1,0],["تَقِفُ المَكْرُمَاتُ لا يَتَوَجّهْ","نَ لِوَجْهٍ إلاّ إلى حيْثُ يومي",21,"م",2,0],["تَقفو الظّعائنُ من نُوَيرَةَ أجْمرَت","أجمالَها، سَحَراً، لرمي جِمار",22,"ر",1,0],["تَقَفَّيتُ مَجدَ الدِّينِ في ضَبطِ كُلِّ مَا","أتَيتُ بِهِ مِن مَنزِلٍ فَهوَ أشهَرُ",23,"ر",1,0],["تَقَفَّيتُ أزمَاناً مَسِيحَ زَمَاني","فَأَغرَقني في أَبحُرِ الهَيمَانِ",24,"ن",1,1],["تَقِفُ القوافي دُونَهنّ حَسيرةً","لا عِيّها تُخْفي ولا إعْيَاءها",25,"ا",3,0],["تَقِفُ البِحارُ ولَمْ تَقِفْ فارفِقْ بِها","أَو لَمْ تَكُنْ عُضْواً مِن الأَعضاءِ",26,"ا",2,0],["تَقِفُ الصَّوارِمُ وَهْي جَالِسَةٌ لها","شَرَفُ القِيامِ وَسؤْدَدُ الجُلاسِ",27,"س",1,0],["تَقِف العُيون إِذا وَقفن وَأَينَما","دارَت بِهِنَّ العيس فَهيَ تُدارُ",28,"ر",1,0],["تَقِفُ العقولُ حواسراً من دُونها","ما بين إقدامٍ إلى إحجام",29,"م",1,0],["تقف البصائر دونه مذهولة","لجلائل الأعمال حين تحدق",30,"ق",1,0],["تقف الملوكُ لهُ ولولا قسرها","وقفتْ لديهِ دوائرُ الأفلاك",31,"ك",1,0],["تَقِفْ كلُّ نَجمَة ٍفي مَداها","وَحدَكَ الآنَ كَوكَبٌ بَرّاقُ",32,"ق",1,0],["تُقفي بِعيشَةِ أَهلِها مَلبونَةً","أَو جُرشُعاً عَبلَ المَحازِمِ وَالشَوى",33,"ا",1,0],["تَقفوهُ من فتحِ العقابِ عِصابةٌ","ويحفّ فيه من الضّراغِم موكِبُ",34,"ب",1,0],["تقفُ المنيّةُ في الزّحامِ لديه لا","تسعى إلى المهجاتِ حتّى يأذَنا",35,"ن",2,0],["تَقَفَّاهُ في كَسبِ المَكارمِ والعُلى","فَلِلَّهِ شِبلٌ مُقتَفٍ لِهصَورِ",36,"ر",1,0],["تقفُو خُطَا المُختارِ فيما سَنَّهُ","من حِكمَةٍ وفريضةٍ وأداءِ",37,"ا",2,0],["تقفُ النباهةُ حيث ظلُّك واقفٌ","أبداً وتخطو حيث ظلُّك خاطي",38,"ي",1,0],["تقَفْوُا شريعةَ صَحبٍ تابعين لهم","وآخرين بترخيصٍ وتشديد",39,"د",1,0],["تَقُفو كتائبُهُ لِواءَ مُشَيَّعٍ","شَهْمٍ بنُصْرةِ رَبَّهِ مَحْفوفِ",40,"ف",1,0],["تقفاه في البلوى وواساه في البلى","فيا سعد من ساواهما في الورى معا",41,"ع",2,0],["تقفُ الملائكُ دون نور جلالها","خُضُعاً فتكثر نحوه استشرافَها",42,"ف",3,0],["تقف المكارمُ عنده","وتسير حيث يقول سيري",43,"ر",2,0],["تقفو بها الأثر المجيد وانت خافقاً","وعقدته بمطامح الآمال",44,"ل",1,0],["تقفو قوافي الشعر اثرى وما","عصت ولي أمرها القافيه",45,"ي",2,0],["تقف النساء بقبرها يبكين مِنْ","حُرَقٍ وَمِنْ حَزَنٍ وَمِنْ أشواق",46,"ق",1,1],["تقفُ النجمةُ عَن دورتِها","عندَ ثغرينِ وينهارُ الظلامْ",47,"م",1,0],["تقف الملايك فرد صف واحد","والروح صفا واحدا كالجملة",48,"ه",1,0],["تقف الوفود بها صوامت تجتلى","آثارها وترى بها أطلالها",49,"ل",3,0],["تَقِفُ النَّاسُ هَيْبَةً ووَقاراً","بِحمِاهُمْ إذا رأَوْهُمْ جُلوسَا",50,"س",2,0],["تَقَفَّى مَرَاضِعَ رَبِّ الخُمُورِ","عَلى طَودِ نِيسا خِلالَ الصُّخُورِ",51,"ر",1,0],["تقفيضُ لترويضِ الرَّجاءِ مياهُهُ","وللنُّجحِ يُرجى عدُّها ونضيضها",52,"ض",3,0],["تَقفُ العمر كأنّ الش","شِعر مدحٌ وتشبّب",53,"ب",1,0],["تقفُ العيونُ على محاسنهِ","بجميعِ ما فيها لهُ وَطَرُ",54,"ر",1,0],["تقف الرياح بها مقيدة الخطى","ويظل طرف النجم وهو كليل",55,"ل",1,0],["تَقِفُ الأَوْهَامُ فِي حَيْرَتِهَا","جَنْبَ سِرٍّ بَابُهُ قَدْ أُرْتِجَا",56,"ج",2,0],["تقفي وكن الحرف للحرف هاجر","وتقبل وقلب الصخر بالشعر بوّاح",57,"ح",1,0],["تَقَفّى مسارَ الشَّمْسِ في ضحَواتِها","وتَهْدى دُجىً بالفَرقَديْنِ دَليلا !",58,"ل",2,0],["تَقِفينَ لي وكأنّ كلَّ الأرض أنِ","تِ من الجبالِ إلى السفوحِ إلى ‏الحُفَرْ",59,"ر",1,0],["تُقفّيكَ هَدْهةُ الأمنياتْ","ويَسكبُ كأسكَ كَفّ العِتابْ",60,"ب",1,0]]}