{"poems":[[95,"إن بكى الشرق فالمصاب أليم","https://www.aldiwan.net/poem11409.html","الخفيف"],[4,"درس المنا بمتالع فأبان","https://www.aldiwan.net/poem21206.html","الكامل"],[2,"شطت أميمة بعدما صقبت","https://www.aldiwan.net/poem25042.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142031","الخفيف"],[4,"دَرَسَ المَنَا بمُتَالِعٍ فأبَانِ","https://www.poetsgate.com/ViewPoem.aspx?id=809",""],[231,"ذكرى سعد","https://www.aldiwan.net/poem24223.html","عموديه"],[369,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[463,"من طالب بي في الظباء العين","https://www.aldiwan.net/poem55833.html","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72295","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141268","الكامل"],[2921,"","https://poetry.dctabudhabi.ae/diwan/poem/34744","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59453","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59510","الكامل"],[5277,"حصان ديمقراطي","https://www.poetsgate.com/ViewPoem.aspx?id=186056",""],[402,"إن بكى الشرق فالمصاب أليم","https://www.poetsgate.com/ViewPoem.aspx?id=36206",""]],"verses":[["أَفَذَاكَ التَّفْرِيطُ يُجْزِئُ مِنْهُ","أَنْ تُعَادَ العِظَامُ وَهْيَ رَمِيمُ",0,"م",1,0],["أَفَذاكَ أَم صَعلٌ كَأَنَّ عِفائَهُ","أَوزاعُ أَلقاءٍ عَلى أَغصانِ",1,"ن",1,0],["أَفَذاكَ أَم ذو جُدَّتَينِ مُوَلَّعٌ","لَهَقٌ تُراعيهِ بِحَومَلَ رَبرَبُ",2,"ب",1,0],["أَفَذَاكَ أَمْ ضِرْغَامُ خِيسٍ مُدْهِسٌ","تَنْجَابُ عَنْ أَنْيَابِهِ الأَشْدَاقُ",3,"ق",1,0],["أفذّنبُ الهزارِ إن هامتِ","الأقفاصُ بالساحراتِ من آياته",4,"ت",2,0],["أفَذَاكَ أمْ صَعْلٌ كأنّ عِفَاءَهُ","أوزاعُ ألقَاءٍ على أغْصَانِ",5,"ن",1,0],["أ فذاكر أنت الجموع وحشدها","لما دعا سعد الجموع فثاروا ؟",6,"ر",3,0],["أفذاكِ جيدٌ من هِزَبْرٍ أغلب","يُجْليَ لنا أم من غَزالٍ أغيد",7,"د",1,0],["أفذكرةٌ تُرضِي الوفاءَ على النوى","إذ لا رجاءَ لنظرةٍ تُرضيني",8,"ن",2,0],["أفذاك يرجو أن يكون","محمد أبدا شفيعه",9,"ع",2,0],["أفذا جزا شعبٍ ألمّ به الشّقا","وقضت عليه من الزّمان عوّاد",10,"د",1,0],["أفذاك أم زعفٌ مُضاعفَةٌ","ومُهنَّدٌ من شأنِه القَطُّ",11,"ط",1,0],["أفذَاك أم شببٌ أقبُّ مُسفّعٌ","شخْتُ القوائم ربُّ رَوقٍ أعوجِ",12,"ج",1,0],["أفذاك أم جَأبٌ اقبُّ","مصلصلٌ صلب الحوامى",13,"م",2,0],["أفذاك أم ربُدُ الشوا","مت اسحم الرَّوقين سامِ",13,"م",1,0],["أفذلكَ التغييرُ بؤسى ما جرى","لكنني أخشى أقول: (كذا بمنْ!!!)",14,"ن",1,0],["أفذاك التفريط يجزيء منه","أن تعاد العظام وهي رميم",15,"م",1,0]]}