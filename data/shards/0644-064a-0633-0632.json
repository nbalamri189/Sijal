{"poems":[[29,"ليس زمان بالكميتين راجعاً","https://www.aldiwan.net/poem5800.html","الطويل"],[93,"كل ميت مهما علا في حياته","https://www.aldiwan.net/poem8780.html","عموديه"],[93,"موت العبقري","https://www.poetsgate.com/ViewPoem.aspx?id=52962",""],[354,"ليس زهد الفتى بتحريم حل","https://www.aldiwan.net/poem15523.html","الخفيف"],[458,"إسألوا الشاحب القمر","https://www.aldiwan.net/poem61574.html","مجزوء الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63937","المنسرح"]],"verses":[["لَيسَ زَمانٌ بِالكُمَيتَينِ راجِعاً","وَلَيسَ إِلى ذاكَ الزَمانِ رُجوعُ",0,"ع",1,1],["لَيسَ زَرعُ الغَصّاتِ مِنهُ لِثَأرٍ","لَيسَ حَصدُ اللَذاتِ مِن لَذّاتِه",1,"ت",2,0],["ليس زرع الغصّات منه الثأر","ليس حصد اللذات من لذّاته",2,"ت",2,0],["لَيسَ زُهدُ الفَتى بِتَحريمِ حَلٍّ","مِن نِكاحٍ وَمَطعَمٍ وَشَرابِ",3,"ب",1,1],["ليس زهدي بحاضري","بعد فقدان ما عبر",4,"ر",1,0],["ليس زبينا نعلاً لأخمصِهِ","بل هو نَعْلٌ للنَّعْلِ لا الأخْمَص",5,"ص",1,0]]}