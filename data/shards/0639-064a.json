?id=179522",""],[106,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[96,"راكبة الدراجة","https://www.poetsgate.com/ViewPoem.aspx?id=15719",""],[90,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[90,"ليلة معها","https://www.poetsgate.com/ViewPoem.aspx?id=179141",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[90,"خل النديم","https://www.poetsgate.com/ViewPoem.aspx?id=178950",""],[45,"يا عَارِضاً مُتَلَفّعاً بِبُرُودِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31608",""],[99,"لا تحبيني","https://www.poetsgate.com/ViewPoem.aspx?id=196733",""],[51,"يا أيُّها المعتضِدُ المعضودُ","https://www.poetsgate.com/ViewPoem.aspx?id=28493",""],[51,"أتصَاب إلى ذوي إسعادِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=27791",""],[51,"الحُبُّ ريحانُ المُحبِّ وراحه","https://www.poetsgate.com/ViewPoem.aspx?id=27420",""],[51,"لا تَلْحَ مَنْ يبكي شبيبته","https://www.poetsgate.com/ViewPoem.aspx?id=25857",""],[88,"لقد سمعوا من الوطن الأنينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19527&r=&rc=30",""]],"verses":[["عَيني مَعَ اليَقظى غَراماً بِهِم","وَعَينُ مَن يَلحى مَعَ النُوَّمِ",0,"م",1,0],["عيصٌ أَلَفَّ تَقابَلَت شُعُباتُهُ","في المَجدِ شَجرَ مُقَوَّمٍ لِمُقَوَّمِ",1,"م",1,0],["عُيونُ العَوالي وَالنُجومُ رَوامِقٌ","وَنَقعُ المَذاكي بَينَهُنَّ بَراقِعُ",2,"ع",1,0],["عَينانِ عَينٌ لِلمَزيدِ قَريرَةٌ","مِنّا وَعَينٌ لِلنَقيصَةِ تَدمَعُ",3,"ع",1,0],["عَيشُ الفَتى كُلُّهُ وَقتٌ يُسَرُّ بِهِ","مِنَ الدُنا وَجَميعُ العَيشِ مَفقودُ",4,"د",1,0],["عَينُ الزَمانِ أَصابَتنا فَلا نَظَرَت","وَعُذِّبَت بِفُنونِ الهَجرِ أَلوانا",5,"ن",2,0],["عيونُ العائِداتِ تَراكِ دوني","فَيا حَسَدي لِعَينَي مَن يَراكِ",6,"ك",1,1],["عَينايَ شامَت دَمي وَالشُؤمُ في النَظَرِ","بُعداً لِعَينٍ تَبيعُ النَومَ بِالسَهَرِ",7,"ر",1,1],["عَيني رَأَت ما أَنكَرَت","فَتَبادَرَت عَبَراتُها",8,"ت",3,0],["عيدَ قَيسٌ مِن حُبِّ لُبنى وَلُبنى","داءُ قَيسٍ وَالحُبُّ داءٌ شَديدُ",9,"د",1,1],["عِيدٌ أَعَادَ عَلَى الزَّمَانِ شَبَابَهُ","فَاعْجَبْ لأَشْمَطَ عِيدَ فِي رَيْعَانِ",10,"ن",1,0],["عيْني جَنَتْ فعَلامَ تحْرَقُ أضْلُعي","أبِما جَنى جارٌ يعَذَّبُ جارُ",11,"ر",1,1],["عِيالاً على الأحْرارِ أصْبَحتُ فلْتَقُمْ","بأمْري قيامَ الواحِدِ الماجِدِ الحُرِّ",12,"ر",1,0],["عُيوناً منَ الأخْبارِ والأدبِ الذي","تضوّعَ مسْراهُ وأيْنَعَ زهْرُهُ",13,"ر",2,0],["عَيْناً مِنْ الْمَاءِ وَمِنْ دُونِهِ","غَزَالَةٌ قَدْ أَقْبَلَتْ تَشْرَبُ",14,"ب",1,0],["عِيدٌ أَعَدْتَ الدّهْرَ فِيهِ يَافِعَاً","طَلْقَاً تَلُوحُ بِوَجْهِهِ السَّرَّاءُ",15,"ا",2,0],["عَيناً كمِرآةِ الصَناعِ تُديرُها","بِأَنامِلِ الكَفَّينِ كُلَّ مُدارِ",16,"ر",1,0],["عَيرانَةٌ قُذِفَت في اللَحمِ عَن عُرُضٍ","مِرفَقُها عَن بَناتِ الزورِ مَفتولُ",17,"ل",1,0],["عَينُ سَعدٍ تَرعاهُمُ بَعدَ عَينِ ال","لَهِ فَاِهدَأ فَقَد وَجَدتَ المُواتي",18,"ي",1,0],["عيدٌ هُنا وَهُناكَ قامَ المَأتَمُ","مَلِكٌ يَنوحُ وَتابِعٌ يَتَرَنَّمُ",19,"م",1,1],["عُيونُ القَصائِدِ مِثلُ العُيونِ","وَشِعرُكَ فيهِنَّ مِثلُ الحَوَر",20,"ر",1,0],["عَينٌ مُسَهَّدَةٌ وَقَلبٌ واجِفٌ","نَفسٌ مُرَوَّعَةٌ وَجَيبٌ خالي",21,"ل",2,0],["عيدَ الجُلوسِ لَقَد ذَكَّرتُ أُمَّتَهُ","يَوماً تَأَبَّهَ في الأَيّامِ وَالحِقَبِ",22,"ب",1,0],["عُيوبُ قَومٍ لَوَ انَّها جُمِعَت","في فَلَكٍ ما سَرت بِهِ شُهُبُ",23,"ب",1,0],["عَيٌّ قَلَبتَ إِلى البَلاغَةِ عِيَّهُ","لَولا تُقاكَ لَقُلتُ إِنَّكَ ساحِرُ",24,"ر",1,0],["عَيَّرتُمونا بِأَن قَد صارَ يَخلُفُنا","فيمَن نُحِبُّ وَما في ذاكَ مِن عارِ",25,"ر",1,0],["عيش تلاعبت الخطوب بعهده","حتى غدا خبرا من الأخبار",26,"ر",1,0],["عَيوفُ القَذى تَأبى فَلا تَعرِفُ الخَنا","وَتَرمي بِعَينَيها إِلى مَن تَكَرَّما",27,"م",2,0],["عُيوناً جلاها الكُحلُ أَمّا ضَميرُها","فَعَفٌّ وَأَمّا طَرفَها فَجَهولُ",28,"ل",1,0],["عينِ فابكي لي على صَخْرٍ إذا","عَلَتِ الشّفْرَة ُ أثباجَ الجُزُرْ",29,"ر",1,1],["عَينَيَّ جودا بِدَمعٍ مِنكُما جودا","جودا وَلا تَعِدا في اليَومِ مَوعودا",30,"د",2,1],["عَينَيَّ جودا بِدَمعٍ غَيرِ مَنزورِ","وَأَعوِلا إِنَّ صَخراً خَيرُ مَقبورِ",31,"ر",1,1],["عينك التي نظرت","منه جاءها الميل",32,"ل",1,0],["عيدٌ له ما بعده في معشر","يأبي الحياة مكبلاً ومسودا",33,"د",2,0],["عِيْدُ فريالُ فَوْقَ مَا يَبْلُغُ الإِبْدَاعُ","فِي وَصْفِ شَاعِرٍ أَوْ خَطِيبِ",34,"ب",1,0],["عيشي طويلاً وابسطي الظل الذي","هو رحمةٌ ونزاهةٌ ورشاد",35,"د",1,0],["عيدك باسم الخضر عيد الندى","وافى وللعلياء فيه وسام",36,"م",1,1],["عِيدٌ حَسِيبٍ عِيدٌ حَبِيبٌ","إِلَيَّ مِنْ مَبْدَأِ الطُّفُولَهْ",37,"ل",2,1],["عَيَّدَتْ مِصْرُ عِيدَهُ فَجَلَتْ","صُوَراً لِلسُّعُودِ أَلوَانَا",38,"ن",2,0],["عِيدٌ تَجَدَّدَ فِيهِ مَجْدُ عَدْنَانِ","وَقَدْ تَآخَى المَلِيكَانِ الوَفِيَّانِ",39,"ن",1,1],["عِيشَا وَزِيدَا فَخضارَ الأُمَّتَيْنِ بِمَا","آتَاكُمَا اللهُ مِنْ جَاهٍ وَسُلْطَانِ",39,"ن",1,0],["عِيدَانِ لا نَدْرِي أَأَوْفَرُ فِيِهِمَا","جَذَلُ المُزَكِّي أَمْ سُرُورُ المُعْدِمِ",40,"م",1,0],["عِيشُوا وَدَامَ لَنَا المَلِيكُ المُفْتَدَى","وَلْتَزْدَهِرْ فِي عَهْدِهِ الأَحْكَامُ",41,"م",1,0],["عِيشَا وَتَهْنِيكُمَا دَوَاماً","طَلاقَهُ العَيْشِ وَالوِئَامُ",42,"م",1,0],["عَيْنَاهُ كَالكَوْكَبَيْنِ السَّاطِعَيْنِ زَهَا","سَنَاهُمَا بِسَنىً لِلْفِكْرِ يَضْطَرِمُ",43,"م",1,0],["عِيشُوا وَتَحْيَا مَصْرُ بَالِغَةً بِكُمْ","فِي المَجْدِ مَا لَمْ تَبْلغِ الأَقْوَامُ",44,"م",1,0],["عِيدٌ يُجَدِّدُ لِلْبِلادِ وَأَهْلِهَا","بَهَجَاتِهِ بِتَجَدُّدِ الأَعْوَامِ",45,"م",1,0],["عِيشِي وَأَبْلِي الدَّهْرَ وَاغْتَفِرِي لَهُ","بِالصَّالِحَاتِ كَبَائِرَ الآثَامِ",45,"م",1,0],["عِيدَانِ أَعْلَنَتِ السَّرَائِرُ فِيهِمَا","مَا أَضْمَرَتْهُ بِأَبْلَغِ الإِعْلامِ",46,"م",1,0],["عِيدُكَ اليَوْمَ أَيُّ جَدِيرٍ","بِارْتِقَابِ المَشُوقِ عَاماً فَعَامَا",47,"م",2,0],["عِيشِي وَمُورِيسُ الحَبِيبُ","بِغِبْطَةٍ وَصَفَاءِ حَالِ",48,"ل",1,0],["عِيدُ فِرْيَال أَيُّ عِيدٍ تَحَلَّى","فِيهِ مَغْزًى سامٍ ومَعْنًى جَمِيلُ",49,"ل",1,0],["عَيرٌ رَأى أَسَدَ العَرينِ فَهالَهُ","حَتّى إِذا وَلّى تَوَلّى يَنهَقُ",50,"ق",1,1],["عَينَ مِهرانَ قَد لَطَمتَ مِراراً","فَاِتَّقِ ذا الجَلالِ في مِهرانِ",51,"ن",1,0],["عُيونَ المَهى وَالمِسكَ يَندى عَصيمُهُ","عَلى كُلِّ خَدٍّ مُشرِقٍ غَيرِ واجِمِ",52,"م",1,0],["عَيناً مُطَحلَبَةَ الأَرجاءِ طامِيَةً","فيها الضَفادِعُ وَالحيتانُ تَصطَخِبُ",53,"ب",1,0],["عيسٌ تُكَلَّفُ كُلَّ أَغبَرَ نازِحٍ","يَطوي تَنائِفَ بِالمَلا وَحُزونا",54,"ن",2,0],["عيدِيَّةٌ كانَ جَوّابٌ تَنَجَّبَها","وَاِبنا نَعامَةَ وَالمَهرِيُّ مَعكوبُ",55,"ب",1,0],["عَيَّت تَميمٌ بِأَمرٍ كانَ أَفظَعَها","فَفَرَّجَ الكَربَ عَبّادُ بنُ عَبّادِ",56,"د",1,1],["عيدانُكُم عُشَرٌ وَلَم يَكُ عودُكُم","نَبعاً وَلا سَبِطَ الفُروعِ نُضارا",57,"ر",2,0],["عيدِيَّةٌ بِرِحالِ المَيسِ تَنسُجُها","حَتّى تَفَرَّجَ ما بَينَ المَساميرِ",58,"ر",1,0],["عِيَزَاتُ الفَعَألِ والحَسَبِ العَو","دِ إليهم مَحطُوطَةُ الأَعكَامِ",59,"م",1,0],["عَينُ جودي بِدَمعِكِ المَنزورِ","وَاِذكُري في الرَخاءِ أَهلَ القُبورِ",60,"ر",1,1],["عَينَيَّ جودا عَلى فارِسٍ","بِأَجراعِ مُؤتَةَ فَالأَخرَجِ",61,"ج",1,1],["عينُ البرايا جمَّلت مملكةً","قامت فروضُ الهنا بواجِبها",62,"ه",2,1],["عيناهُ منصوبةٌ للقلبِ غالبةٌ","والخدُّ فيهِ لقتل النفس شامات",63,"ت",1,0],["عينُ الزمان تحلى في ملابسه","وإنَّما تتحلَّى العينُ بالدَّعج",64,"ج",1,0],["عينٌ حواجبها ترمي بأقواسٍ","منها السهام وقلبي منه قرطاسي",65,"ي",1,1],["عيشك والقدر كما تشتهي","تخفض هذاك وذا ترفع",66,"ع",1,0],["عيشك والقدر كما ترتضي","يخفض هذاك وذا يرفع",67,"ع",1,0],["عيدٌ يعود إلى هذا الثنا العالي","بخادمي أفقه يمنٍ وإقبال",68,"ل",1,1],["عيان الفضل دع خبر ابن قيس","ورأس الجود دع كعب بن مامهْ",69,"م",2,0],["عيش يضيءُ كما أضاء بتاجه","وجه القضايا فالمظالم تهزم",70,"م",1,0],["عيد يعود حماك ألف مثله","والبيض طوع يديك والأقلام",71,"م",1,0],["عيدٌ تعود بالهناء سعوده","فتهنّه في غبطة ودوام",72,"م",1,1],["عيدانِ قد أطربا ملكاً فراسلها","بمطرباتٍ من الأقلام عيدانِ",73,"ن",1,0],["عيش كريم كم عتبت بمنطق","فحشى فمي درًّا فقال لهُ ره",74,"ه",1,0],["عيش ذوي الصيد به عيش رخيّ","يصلحُ أن يدعى وكيل المطبخ",75,"خ",1,0],["عينيَّ شُحَّا ولا تَسُحَّا","جلَّ مُصابي عن البكاءِ",76,"ا",2,1],["عَيْنَاءُ في وَطَفٍ قَنْوَاءُ في ذَلفٍ","لفَّاءُ في هيفٍ عجزاءُ في قَببِ",77,"ب",1,0],["عيبُكم أنكم أناسٌ كرامٌ","كلُّ شرٍّ بفضلكم مغتوتُ",78,"ت",1,0],["عيني إلى من أحبُّ تَخْتَلِجُ","والصبر عن حسن وجهه سَمِجُ",79,"ج",1,1],["عيدٌ تَنافستِ الأيامُ زينَتَه","واستشرفتْه بأبصارٍ وأجيادِ",80,"د",1,0],["عيدان مجموعان في عيدِ","دليلُ تأ