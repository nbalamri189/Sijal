d=128803",""],[592,"سفاسط أملاها الغبي وسطرا","https://www.poetsgate.com/ViewPoem.aspx?id=128722",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[592,"تبصر نور الحق من كان يبصر","https://www.poetsgate.com/ViewPoem.aspx?id=128795",""],[5397,"أغاظ الدهر قدرك أن يسودا","https://www.poetsgate.com/ViewPoem.aspx?id=157926",""],[5442,"إذا البرق من تلقاء كاظمة عنا","https://www.poetsgate.com/ViewPoem.aspx?id=114776",""],[5573,"ترى من زهرة الدنيا نعيم","https://www.poetsgate.com/ViewPoem.aspx?id=204550",""],[5975,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=52972",""],[6004,"يا عاذلي","https://www.poetsgate.com/ViewPoem.aspx?id=59103",""],[6070,"حياةُ المرءِ تحكمُها الثواني","https://www.poetsgate.com/ViewPoem.aspx?id=188425",""],[6164,"الراحل المقيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66029&r=&rc=39",""],[6180,"رسالتي الأخيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81076&r=&rc=10",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""],[463,"عزفتُ فما أدري الفتى كيف يرغبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59986&r=&rc=42",""],[5190,"المفترق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78333&r=&rc=46",""]],"verses":[["وَلَكِنَّكَ المَرءُ الَّذي تَحتَ سُخطِهِ","أُسودٌ تَرامى بِالرَدى وَأَساوِدُ",0,"د",1,0],["ولكنّكَ ابنُ العمِّ والعمُّ والِدٌ","وما لامرِئٍ منْ بِرِّ والِدِهِ بُدُّ",1,"د",1,0],["وَلَكِنَّكَ الْمَوْلَى الْجَوَادُ وَجَارُهُ","عَلَى أَيَّ حَالٍ كَانَ لَيْسَ يَخِيبُ",2,"ب",1,0],["ولكن كفتنا اليتم دولة أحمدٍ","بأن لنا فيها ولياً من الفضل",3,"ل",1,0],["وَلَكِن كَما قالَ الَّذينَ تَتابَعوا مِنَ","السَلَفِ الماضي الَّذي ضَمَّهُ التُربُ",4,"ب",1,0],["ولكن كل نائبة خروج","من الأمثال والطُلُق المنيب",5,"ب",1,0],["ولكنكم لا تستثيبون نعمةً","وغيركم من ذي يدٍ يستثيبها",6,"ب",3,0],["ولكنكم حي معازيلُ حِشوةٌ","ولا يمنع الجيرانُ باللوم والعذلِ",7,"ل",1,1],["ولكنْ كَفاني مُسْلياً ومُعزِّياً","بأنْ المدى بيني وبينك يقربُ",8,"ب",1,0],["ولكنكم زرق يزين وجوهَكم","بني الرُّوم ألوانٌ من الرُّوم نُعَّجُ",9,"ج",1,0],["ولكنكُمْ كنتُمْ تريدون علّةً","فهيَّجَكُمْ أدْنَى عِتاب إلى الصَّدِّ",10,"د",1,0],["ولكنك المرء الذي لم تزل لهُ","عوائد بالمعروف والنائل الغمر",11,"ر",1,0],["ولكن كما ألقتهمُ أمهاتهمْ","قذفنَ بهمْ في كل مظلمة القعر",12,"ر",1,0],["ولكنَّكَ المخدوعُ صفحاً ونائلاً","فتصفحُ وضّاحاً وتمنحُ أروعا",13,"ع",2,0],["ولكنكم لا تبطنون محبة","لنخلتكم ما سحَّ أرضاً صقوعها",14,"ع",3,0],["ولكن كسرويٌّ ذو فعالٍ","له بدءٌ وليس له اختتامُ",15,"م",1,0],["وَلَكِن كُنتَ ذا خُلُقٍ رَضِيٍّ","عَلى خُلُقٍ لِغَيرِكَ لا يَكونُ",16,"ن",1,0],["وَلَكِنَّكَ الدُنيا إِليَّ حَبيبَةٌ","فَما عَنكَ لي إِلّا إِلَيكَ ذَهابُ",17,"ب",1,0],["وَلَكِن كُلُّ شَيءٍ فيهِ طيبٌ","لَدَيكَ مِنَ الدَقيقِ إِلى الجَليلِ",18,"ل",1,0],["وَلَكِنَّكُم قَومٌ ضَلِلتُم أَباكُمُ","فَمَولاكُمُ دوني سَدوسٌ وَعامِرُ",19,"ر",1,0],["وَلَكِنَّكَ إِنسانٌ","بِما أَكرَهُ مَزّاحُ",20,"ح",1,0],["وَلَكِن كَما قالَ الهُمامُ وَإِنَّني","أَقولُ وَفي الأَمثالِ لِلهَمِّ طارِدُ",21,"د",1,0],["وَلَكِنَّكَ لِلواشي","عَلى الطاعَةِ مَخبولُ",22,"ل",1,0],["وَلكن كَيفَ إقناعي لنفس","تعلُّقُها بدنياها شَديد",23,"د",1,0],["ولكن كيف راحة مستبد","غدا بديار أحرار سجينا",24,"ا",1,0],["ولكن كرامات ظهرن لربنا","عليك لكي ينفي من الشرك ما ينفى",25,"ف",2,0],["وَلَكِنَّكَ البَحرُ الَّذي كُلَّما طَما","صَفا وَحَلَت لِلوارِدينَ مَشارِبُهْ",26,"ب",2,0],["وَلَكِنَّكَ المَلكُ الَّذي مِن سَمائِهِ","نُجومي الَّتي تُصمي وَمِن شَمسِهِ بَدري",27,"ر",2,0],["ولكنْ كلُّ مُرتجِزٍ غزيرٍ","يفيض على السَّوارى",28,"ر",2,0],["وَلكنّكم مع تركهِ الحجّ مرّةً","وَحجّ لِباريزٍ ولندرةٍ عشرا",29,"ر",2,0],["ولكنكم في العائشين وحسنكم","يعيش بمصقول الخداع ويرزق",30,"ق",1,0],["ولكنّك الشمسُ حيث انصرفْتُ","من الأرض يصحبني نورها",31,"ر",3,0],["ولكنّك الذَّواد عنها بحَزْمِه","ومانِعها بالمشرَفيّة والقُضُب",32,"ب",1,0],["ولكن كان لا يقوى لشؤمي","وخذلاني به سواد بختي",33,"ت",2,0],["وَلَكِن كَيفَ أَصنَعُ حينَ يَأتي","بِسِحرٍ زاخِرٍ جَمِّ العُبابِ",34,"ب",1,0],["وَلكنّكم أَبعدتُمُ شُقَّة النَوى","فأَصبحتُ من جور النَوى أَتظلَّمُ",35,"م",1,0],["وَلَكِن كانَ فضلكَ مستحقّاً","لأن يَعلو فدان له الأنامُ",36,"م",1,0],["وَلَكِن كَلالُ الطَرفِ بِالسَقمِ في الهَوى","أَراني مَغيبي في شَهادَتِيَ الَّتي",37,"ي",1,0],["ولكن كَفاني الدَّهرَ من قلبِ ناصحٍ","وإن كَثُرَتْ آولاؤه قَلْبُ ناصح",38,"ح",1,0],["وَلَكِنَّكَ القِرنُ الَّذي لَو صَرَعتُهُ","لَكانَ قُصارى الحَمدِ أَن أَتَذَمَّما",39,"م",2,0],["ولكن كم رأينا من ظلوم","تجاذبه الرزايا والحمام",40,"م",1,0],["ولكنكم جئتم بأضعاف ظلمه","وزدتم على ما شاده من مناكر",41,"ر",1,0],["ولكِن كَنارِ الشَّبابِ الّتي","تُحَيِّ النُّفوسَ وتُحْيي السُّرورا",42,"ر",2,0],["ولَكِن كما قالَ ربُّ العبا","دِ فينا نَقولُ ولا نَفعَلُ",43,"ل",1,0],["ولكن كل جمع صاح فيه","غراب البين ينصدع انصداعا",44,"ع",2,0],["ولكنّكم ماءُ الطريق كددتهُ","على بَرْضه لمَّا عدِمتُ مَعينَهُ",45,"ن",2,0],["ولكنّك العينُ التي كلُّ غبطةٍ","إذا هي لو تُوجَدْ عناءٌ معذِّبُ",46,"ب",1,0],["ولكنكَ المُظْمي أسِنَّةَ سُمْرهِ","وقد أمكنت من دقِّها في الحَناجرِ",47,"ر",1,0],["وَلَكِن كَتَمتِ الوَجدَ إِلا تَرَنُّماً","أَطاعَ لَهُ مِنّي فؤَادٌ مُرَوَّعُ",48,"ع",1,0],["ولكنك الشمس التي لا محلها","بدان ولا أنوارها قط تحجب",49,"ب",1,0],["ولكن كفاني ذاك أنك خالد ال","مناقب في آي من الذكر محكم",50,"م",1,0],["ولكِنْ كانَ ذَا عَمَلٍ وعِلْمٍ","وما عِنْدِي لِذا أَبَداً وُجُودُ",51,"د",1,0],["ولكن كما شاءَ القضاءُ وكلُّ ما","جَرى به أمرُ اللهِ في خَلقِه يَجرِي",52,"ر",2,0],["وَلَكِن كُلُّ صُعلوكٍ ضَروبٍ","بِنَصلِ السَيفِ هاماتِ الرِجالِ",53,"ل",1,0],["ولكنّكم ضيّعتموه شَقاوةً","فكنتُمْ كمُهرِيقِ الإداوةِ صادِيا",54,"ي",2,0],["ولكن كيفما قد كنت يا خلِّي","تراني فيك إشراك وإيمان",55,"ن",1,0],["ولكن كل مرتبة يؤدَّى","لها حق على رغم الحسود",56,"د",1,0],["ولكن كل فضلى لا تبالي","بتلك المضحكات المبكيات",57,"ت",1,0],["وَلكن كانَ حَسبِي مِنكَ أنّي","وَصلتُ بِحَبلِكَ الأَقوى حِبالِي",58,"ل",2,0],["ولكن كلا يدعي أن رايه","لورد قليب الفضل خير رشاء",59,"ا",2,0],["ولكنَّكَ الشمسُ المنيرةُ ما لَها","بدائرةِ الأفلاكِ مَأوىً مُلازِمُ",60,"م",1,0],["ولكنكم امضوا لنوح فإنه","نبي كريم أولي مقدم",61,"م",1,0],["ولكنَّكم بعتم وفاء بغدرة","غداة اشتريتم وحشة البعد بالقرب",62,"ب",1,0],["ولكنكم عنم تصطفى","ويترك سائرها للذئاب",63,"ب",1,0],["ولكن كم قضيت بذا هموماً","وكم قاسيت فيه من متاعبْ",64,"ب",1,0],["ولكِنَّكَ المَلْكُ الّذي لُجُّ صَبْرِهِ","تَفيضُ لَهُ غُدْرُ الأَسى ومَذانِبُهْ",65,"ب",2,0],["ولكنّكم أبغضتموه لجهلكم","وأحببتُمُ المالَ الذي حُبُّهُ وصْمُ",66,"م",1,0],["ولكنك اخترت الوصول لرتبة الشهادة","شوقا وهي أعلى المراتب",67,"ب",1,0],["ولكن كما قد كانَ سؤدد حاجِبِ","إذا كنتَ أعلى سورة المجدِ تقتدِي",68,"د",2,0],["ولكنَّك المولى الذي انتشرت له","صنايعُ ما بين البريَّةِ تشكر",69,"ر",1,0],["ولكنْ كادني خبٌّ حقودٌ","لعقرب كيده نحوي دبيب",70,"ب",1,0],["ولكن كل أروعَ يعربيٍّ","يهز بكفه عَضْباً سنينا",71,"ن",2,0],["ولكنكم يا آل بكر بن وائل","يسودكم من كان في المال ذا وفر",72,"ر",1,0],["وَلكنك الدجال للناس فتنة","تأهب لروح اللَه فالحين قَد حانا",73,"ن",2,0],["ولكن كما تبكي لِصَخرٍ تُماضِرٌ","مَدامِعُ تُجريها الأُخوَّةُ وَالودُّ",74,"د",1,0],["وَلَكِنَّكُم قَبَّلتُمُوُهم ذَوابِلاً","مِنَ الخَطِّ مُشرِعُوها هُمُ اللُدُّ",75,"د",1,0],["ولكنْ كَبا طِرفُ الكلام ولم يُفِدْ","لمعنىً لقَوْلي مثْل ذاك نِظامُ",76,"م",1,0],["ولكن كان أمنع منهُ درعاص","وأوفرَ عدةً وأشدَّ ظهرا",77,"ر",2,0],["وَلَكِن كُلَّ مُختَبِطٍ فَقيرٍ","يَقولُ أَلا اِستَمِع أُنبِئكَ شَأني",78,"ن",2,0],["وَلَكِنَّكُم تَطرونَها بِهَواكُمُ","وَلَم تَخلُ أَرضٌ مِن مُحِبٍّ وَمِن مُطري",79,"ر",2,0],["وَلَكِنَّكُمُ نِمتُم وَلَم تَتَيَقَّظوا","وَذَلِكُمُ لَو تَشعُرونَ حِمامُ",80,"م",1,0],["ولكن كبارُ الرجال يرون","بأتباعهم صمماً أن دعوا",81,"ع",3,0],["ولكن كما أوفى السموأل إذا رأى","مصاب ابنه والغدر ثنتي مصائب",82,"ب",1,0],["ولكِنّكم لمّا مللتُم هجرتُمُ","وذنّبتُم في الحبّ من ليسَ يُذنِبُ",83,"ب",1,0],["ولكن كساها سموم الهجير","جلابيبَ تبرٍ بتضريج دم",84,"م",1,0],["وَلَكِن كانَ أَمرٌ فيهِ لَبسٌ","عَلى وَجَلٍ شَديدٍ وَارتِياعِ",85,"ع",1,0],["ولكنكم من قبل كنتم ولاتنا","فأسلمتمونا حين لحن القواطع",86,"ع",1,0],["ولكن كذا من حاول الحرب لم يمل","لباه ولو مالت إليه خدود",87,"د",1,0],["ولكن كما قال المهيمن أنها","ببيض رقاق لمعها كالبوارق",88,"ق",1,0],["ولكن كشفت معاضلاً وشدائداً","بعنايةٍ تعلو على الجوزاء",89,"ا",2,0],["ولكن كيف أسلو عن لسانٍ","وتاريخ تضمّن خير ذُخر",90,"ر",1,0],["ولكن كان عصرك صيرفيّاً","لصافي الشعر لم يبدِ الجحودا",91,"د",2,0],["ولكن كشفت لها عيبها","بماضي البصيرة فضّاحها",92,"ح",3,0],["ولكن كان سائقه ينادي","وكان الوجه منه يبين فقرا",93,"ر",2,0],["ولكن كان حب فتى كريم","بصير بالجميل على الكريم",94,"م",1,0],["ولكنك المرء التناهي علوه","فليس له في مجده من مآرب",95,"ب",1,0],["ولكن كنت فيه أخا ارتياح","خليا من مكافحة العوادي",96,"د",2,0],["وَلكن كَلامي لَيسَ هَذا وليس ذا","فَلَيسَ عتاباً بَل ضروبٌ من الذكرِ",97,"ر",1,0],["ولكنكَ المقدارُ سَلَمَ فضلَهُ","لكَ الملكُ والمَملوكُ والمتمالِكُ",98,"ك",1,0],["ولكن كأنك لم تدر ما","ألم بخدن الصبا من غير",99,"ر",1,0],["وَلكِن كُلَّما وارَيتُ حبي","اِرى نار الهَوى زادَت أُواري",100,"ي",1,0],["ولكن كرمتُ فَخُذْ يا قمر","من الزاد ما تشتهي في السفر",101,"ر",1,0],["ولكن كنزه التقوى وظنٌّ","جميل في المهين ذي الجلالي",102,"ل",2,0],["ولكن كل ذا التهويل فيه","لذي الألباب وعظ وازدجار",103,"ر",1,0],["ولكن كففت ليحفظه","ويفهمه حقَّ ما يفهمُ",104,"م",1,0],["ولكن كان قلبي غير راض","وإن الله قد قوى اعتقاده",105,"د",2,0],["ولكن كان سلواني وشوقي","لذكر محمد وله مقالي",106,"ل",2,0],["وَلكنّك قَد حجَّر","ت عَلَينا لذَّةَ السُّكرِ",107,"ر",1,0],["وَلَكِن كَآريسَ مِريونُ خَف","عَلى يَدِهِ بِالقَناةِ قَذَف",108,"ف",1,0],["ولَكِنَّ كُلَّ العارِ في عَودَة السُّرى","بِخَيبتِهِم مَهلاً فَسَوفَ نَعُودُها",109,"د",3,0],["وَلَكنّكَ الطفلُ البَريءُ إِذا هَوى","لِيَسقُطَ حَتّى تَحتَويهِ الحَفائرُ",110,"ر",1,0],["ولكن كان يأسا غير أني","تجدّد بالأمين لي الرجاءُ",111,"ا",2,0],["ولكن كهذا النعي لم أك حاملا","ولم ير قبلي مثل هذا ولا بعدي",112,"د",2,0],["وَلكِن كانَ ذَنبُ ال","قَلبِ لا أَفلَحَ مِن قَلبِ",113,"ب",1,0],["ولكن كله حِكَمٌ","إذا بين الورى نثرا",114,"ر",2,0],["ولكن كفى أهلَ النهي أيُّ رادعٍ","تَجَرُّعُ كأسِ الموتِ والقْبرُ واللَّحْدُ",115,"د",1,0],["ولكنك الطاغوت في الارض مفسدا","وفي كل امر كنت تدخل داغلا",116,"ل",2,0],["ولكن كليث الغاب إن رام ثروة","حوتها له أنياب ومخالبه",117,"ب",2,0],["ولكن كفاني الآن بث تهانئي","فادعوا إلى الباري الكريم وأطلبُ",118,"ب",1,0],["ولكن ْ كم دعوت َ الله يُغني","فقيرَ الشعر إذ طال الخواءُ",119,"ا",2,0],["ولكنْ كيف أقوى أن توارى","حنانكَ أيها الرزءُ الوبيلُ",120,"ل",1,0],["ولكن كل قلب(ن)عاش بدنيا مرة(ن) مرغم","يسايرها على جرحه وينسى انها الجاني",121,"ن",2,0],["وَلَكِنَّ كُلَّ النَّاْسِ تَعْلَمُ أَنَّهُ","عَمِيْلٌ ضَلِيْلٌ فِي التَّآمُرِ يَرْزَحُ",122,"ح",1,0],["ولكنْ كتمنا الذي خبَّأت","وما حيك في السر والمُشرع",123,"ع",1,0],["ولكِن كالكِرامِ مررتَ فينا","وشمسُكَ باتَ يؤذِنُها الأفولُ .",124,"ل",1,0],["ولكنّكم دمتم على زهوكم كما","مضى وبقيتم زهرة الدّول الزّهر",125,"ر",1,0],["ولكن كذاك يطيب العِنا","ق عند اللقاء لمن يفلح",126,"ح",1,0],["ولكنْ كنتِ أقوى يا حياتي","مِنَ الأيامِ في نفسي وأفرى",127,"ر",2,0],["ولكنك الشاعرُ المرتجى","وإنك في الشعرِ كالمِقْوَل",128,"ل",1,0],["ولكنكم من سائر الناس مالكم","من العلم ما فقتم به من تعلما",129,"م",2,0],["ولكن كفانا في الحقيقة قولكم","وكنا لهم سلماً ولم يحدثوا علل",130,"ل",1,0],["ولكنكم أخلدتموا ورضيتموا","وداهنتموا في دينكم من تجبرا",131,"ر",2,0],["ولكنكم عند القبور دعاكمو","تحري بقاع الصالحين ذوي المجد",132,"د",1,0],["ولكن كي لتحصى ثم يلقى","إلى قعر النهى بذوي النكال",133,"ل",1,0],["ولكنكم من بغيكم وعنادكم","وجهل بكم أزرى وخبث تجهما",134,"م",2,0],["ولكنكم عن فهمه في أكنة","بصائركم محجوبة عنه حسر",135,"ر",1,0],["ولكن كنت بحر ندى وعلم","مشارعه روى عذبت ورودا",136,"د",2,0],["ولكن كتشبيه السماء وزهرها","لناظرها بالزهر والروضة الغنا",137,"ن",2,0],["ولكن كن على حذر وخوف","تحيد عن الصراط المستقيم",138,"م",1,0],["ولكنْ كيفَ أعذرُ مذ تبدّى","لغيري حبُّكَ الصافي هُناكا",139,"ك",2,0],["وَلَكَنْ كَفَى أَمْسِي نَعِيمَاً وَبهْجَةً","شَرِبْنَا كُؤُوسَ الْوَصْلِ نَشْوَى تَوَالِيَا",140,"ي",2,0],["ولكنْ كلنا نسعى لأمرٍ","بأنْ نحظى بخيرٍ في المكانِ",141,"ن",1,0],["ولكنَّكَ اخْتَرْتَ السَّكوتَ تَرَفُّعاً","عن الهَزْل يُزْجِ