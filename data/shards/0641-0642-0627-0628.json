{"poems":[[79,"وجودك حي الملك والدين والدنيا","https://www.aldiwan.net/poem35717.html","الطويل"],[79,"هنيئا بما خولت من رفعة الشان","https://www.aldiwan.net/poem36064.html","الطويل"],[95,"يا ابن خير الفتيان فضلاً وعقلاً","https://www.aldiwan.net/poem11089.html","الخفيف"],[74,"يتيم ابتسامك ما يقهر","https://www.aldiwan.net/poem18706.html","المتقارب"],[74,"أتى الملبس الصوف الذي قد بعثته","https://www.aldiwan.net/poem19315.html","الطويل"],[87,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[68,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[48,"دع آدما لا شفاه الله من هبل","https://www.aldiwan.net/poem23166.html","البسيط"],[79,"وفعلك للصنع الجميل محالف","https://www.poetsgate.com/ViewPoem.aspx?id=34137",""],[113,"ألا فانصحا من رام حمدان شاعرا","https://www.aldiwan.net/poem16304.html","الطويل"],[164,"قناة العز في تلك الرماح","https://www.aldiwan.net/poem58967.html","الوافر"],[214,"بعتم لنا باللف ما طاب نشره","https://www.aldiwan.net/poem13537.html","الطويل"],[287,"نوح الحمام الورق في أوراقها","https://www.aldiwan.net/poem32693.html","الرجز"],[358,"علام فدتك النفس تجفو وتهجر","https://www.aldiwan.net/poem40348.html","الطويل"],[369,"سرى ولثام الصبح قد كاد ينحط","https://www.aldiwan.net/poem60859.html","الطويل"],[376,"إذا أنت لم ترع البروق اللوامحا","https://www.aldiwan.net/poem57514.html","الطويل"],[409,"أمثلك يرضى بارتكاب العظائم","https://www.aldiwan.net/poem33427.html","الطويل"],[409,"لك البشارة هذا منتهى أربي","https://www.aldiwan.net/poem34150.html","البسيط"],[412,"بعثن غداة تقويض الخيام","https://www.aldiwan.net/poem50124.html","الوافر"],[415,"أبا حسن وافى كتابك شاهرا","https://www.aldiwan.net/poem32280.html","الطويل"],[435,"فدر التهاني أرانا طالعا حسنا","https://www.aldiwan.net/poem39857.html","البسيط"],[438,"عزمي وحزمي والحسام الماضي","https://www.aldiwan.net/poem12440.html","مشطور الرجز"],[438,"هناك العيد وهو الآن أولى","https://www.aldiwan.net/poem12742.html","الوافر"],[438,"تولى سقي دارهم الولي","https://www.aldiwan.net/poem12770.html","الوافر"],[443,"مدحت الوزير بما ليس فيه","https://www.aldiwan.net/poem2524.html","المتقارب"],[445,"ألا هكذا فليسم للمجد من سما","https://www.aldiwan.net/poem34814.html","الطويل"],[463,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[463,"رق لبغداد القضاء والقدر","https://www.aldiwan.net/poem56181.html","الرجز"],[498,"أيا ماجدا مذ يمم المجد ما نكص","https://www.aldiwan.net/poem67358.html","الطويل"],[519,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[543,"دعاني من الهم الدفين دعانيا","https://www.aldiwan.net/poem47495.html","عموديه"],[556,"أراعك ما راعني من ردى","https://www.aldiwan.net/poem48121.html","المتقارب"],[572,"أتأسى يا أبا بكر","https://www.aldiwan.net/poem69652.html","مجزوء الوافر"],[572,"ما قمت حتى دعاني صوتها الغرد","https://www.aldiwan.net/poem69708.html","البسيط"],[591,"تداركه قبل البين فاليوم عهده","https://www.aldiwan.net/poem17487.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138220",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87089","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86591","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86984","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86624","البسيط"],[438,"","https://poetry.dctabudhabi.ae/diwan/poem/58807","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38403","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38320","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37862","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37748","الوافر"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77590","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70726","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120049","المنسرح"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138157",""],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64931","البسيط"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6749","الوافر"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124447",""],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108567","البسيط"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121907","الوافر"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109714","الطويل"],[2293,"","https://poetry.dctabudhabi.ae/diwan/poem/198992","الطويل"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100120","البسيط"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101717","المتقارب"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60957","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137076",""],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105666","الوافر"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107171","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94280","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133994","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134012","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132693","السريع"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103981","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138620",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138449",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91898","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91154","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117998","الوافر"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85246","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131272",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131040",""],[3838,"","https://poetry.dctabudhabi.ae/diwan/poem/105689","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135810","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136044","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77180","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77088","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77134","الطويل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199079","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83397","الوافر"],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[6117,"أَبَى الْعِيْدُ إلاَّ ..","https://www.poetsgate.com/ViewPoem.aspx?id=182793",""],[5126,"وَدِّعْ هَواك!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87807&r=&rc=22",""],[572,"ما قمت ُحتَّى دعَاني عودها الغَرِدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9251&r=&rc=108",""]],"verses":[["فقابِلُ عيد مُقْبِلٌ لك بالمُنى","وطالِعُ سعْدٍ حاكِمٌ لكَ بالبُقْيا",0,"ي",2,0],["فَقَابِلْ صَنِيعَ اللهِ بِالشُّكْرِ وَاسْتَعِنْ","بِهِ وَاجْزِ إِحْسَانَ الالإَِهِ بإِحْسَانِ",1,"ن",1,0],["فق أباك الهمام بالجاه لكن","حسبنا أن تكونه بالفضائل",2,"ل",1,0],["فقابل بعلياك فيهِ الهلال","لينحرَ حسَّادها خنجر",3,"ر",1,0],["فقابله الشكران شكر قصائدي","وسجعيَ والشكران من واجب الصوفي",4,"ي",1,0],["فقابلها بعطفك والنوال","وأنزلها بسوحك والظلال",5,"ل",1,0],["فَقابِل ثَناها بِالقُبولِ فَإِنَّها","عَرائِسُ فِكرٍ وَالقَبولُ مُهورُها",6,"ر",3,0],["فَقابَلَ التُربُ سِمطَي لُؤلُؤٍ بِفَمٍ","يَرومُ لِلمومِسِ الغَيداءِ تَقبيلا",7,"ل",2,0],["فقابلت بالصفح الجميل اعتذاره","وإن عظمت منه إليك الجرائر",8,"ر",1,0],["فَقابَلتها مني بِكُل تَحيَّة","وَأَمهَرتها روحي وَافرَشتَها خَدي",9,"د",2,0],["فقابلها بوجهك فهو وجه","يضئ بهاؤه وجه الصباح",10,"ح",1,0],["فقابلته بالبشر مني والرضا","ومهما اتى منكم على الرأي يحمل",11,"ل",1,0],["فَقابَلَ الشامَ بِرَأيٍ رَتَّقَ ال","أُمورَ بَعدَ شِدَّةِ اِنفِتاقِها",12,"ق",3,0],["فَقابل هِلال العيد مِنكَ بِنَظرةٍ","يَصير بِها بَدراً تَماماً فَيُسفرُ",13,"ر",1,0],["فَقابَلَ أَطرافَ العُلا في أَماثِلٍ","لَهُ حينَ يَعزى مِن بُيوتِهِمُ الوَسطُ",14,"ط",1,0],["فقابلتُ إنساناً بإنسانِ مُقلتي","فألفيتُه في ماءِ خديه سابِحا",15,"ح",2,0],["فقابل نصحي بالقبول فإنه","سيهديك نهجاً لست فيه بنادم",16,"م",1,0],["فقابل النزر فضلاً بالقبول ولا","تكشف معانيه واسترها ولا تعب",17,"ب",1,0],["فَقابَلَ فَضلَ خالِقِهِ بِشُكرِ","وَإِنَّ الشُكرَ داعِيَة الدَوامِ",18,"م",1,0],["فقابلتُ بالعُتَبى مَضِيضَ عِتَابهِ","ولم يَتَجَهَّمْهُ الحِجاجُ ولا الجَحْدُ",19,"د",1,0],["فقابلتهُ تحييه وتنشدهُ","يا حبذا كفوءٌ أشتاقه زمنا",20,"ن",2,0],["فقابلَ الإحلاءَ بالإحْماضِ","كما جمعْتَ شفرَتَيْ مِقراضِ",21,"ض",1,0],["فقابلْ يُمنَه في ظلّ مُلْكٍ","غدا لك باسطاً باليُمنِ يُمْنى",22,"ن",2,0],["فقابلَني له خُلُقٌ رضيُّ","يصدّق بشْرَهُ خَلقٌ وضيُّ",23,"ي",1,0],["فقابلني منه منع الثواب","ومنع الثواب جزاء الكذوب",24,"ب",1,0],["فقابَلَ وجهاً بالجمالِ مُتَوَّجاً","وقبَّلَ كَفّاً بالسماحِ مُخَتَّما",25,"م",2,0],["فقابْل به وجهَ الخُلود مبلَّغاً","شروطَ المنى ما كَرَّ عيدٌ وأقبلا",26,"ل",2,0],["فقابلوا هفوتَه بحلمكم","فمثلُكم إن كان ذنبٌ مَن غَفَرْ",27,"ر",1,0],["فَقابَلَت زَهرَ الرَوضِ مِنها وَلَم أَرِع","وَأَحرَزتُ دُرَّ البَحرِ مِنها وَلَم أَغُص",28,"ص",1,0],["فقابِلْ بالمسرّة وجهَ فِطْرٍ","تبسّم عن ثناياهُ العِذابِ",29,"ب",1,0],["فَقَابلَ ذاك الوفدَ طِبقَ مَشِيئَةٍ","لِمولاَه تَرحِيبا بهِم مُتَمَاديا",30,"ي",2,0],["فَقابَلتَنا بوَقارِ المَشيبِ","كَمالاً وَسِنُّك سِنُّ الفَتى",31,"ا",1,0],["فَقَابِلْ نِعْمَةَ اللَّهِ الَّتِي","أَوْلاَكَ بِالشُّكْرِ",32,"ر",1,0],["فقابَلَتْني بمثلِ الشَّمْسِ طالِعَةً","والغَيْمُ مُطَّرِدٌ والبدرُ مُفْتَقَدُ",33,"د",1,0],["فَقابَلْتُ وَجْهاً مُجْتَلى العَيْنِ بَدْرُهُ","وقَبَّلْتُ ثَغْراً مُشْتَهَى النَّفْسِ بَرْدُهُ",34,"د",2,0],["فقابلتها بإخلاص الولاء خلا","من كل شائبة في صدرها اختلجت",35,"ت",1,0],["فَقابلت الإِحسانَ بِالشُكر وَالدُعا","لِعَليائه في مُلكه بِدَوام",36,"م",1,0],["فَقابل مَحيّاها بِما أَنتَ أَهله","مِن الصفح عَما لَم يُنمِّقه كاتب",37,"ب",1,0],["فَقابل مَديحي بِالقبول فَإِنَّني","خَديم أَمين مُخلص لا أُنافق",38,"ق",1,0],["فَقابلوا حسن مَعروفي","بِقطعه وَأَضاعوا الصدق بِالكذب",39,"ب",1,0],["فقابلتُ من أسماطِها الزّهْر يُجتَلى","وقبّلتُ من أمراطِها الزّهر ينفَحُ",40,"ح",1,0],["فَقَابله في شَمسِ الجَبينِ وغرَّةٍ","أَضاءَت وَفي مِسكِ العِذارِ وَعارِضِ",41,"ض",1,0],["فَقابلها وَالعجزُ عذر مسلمٍ","بِشَوهاءِ فِكري حيثُ فيها أكلفُه",42,"ف",2,0],["فَقَابِلْ غَيبَها بِالسّت","رِ يا من صدرُه رَحبُ",43,"ب",1,0],["فَقابِلْ بِالقَبولِ لِبنتِ فِكري","وَلا تَسمَعْ لمَنْ فيها يُماري",44,"ر",2,0],["فَقابَلتهُ صدفَةً شلبايه","قالَ لَها لَيسَ بِكِ الكِفايَه",45,"ه",1,0],["فقابلتْنا بما يُغنِى المُجاِلسَ عنْ","بدرٍ وعن ضوء مِقباسِ ونبراس",46,"س",1,0],["فقابلتك الأعياد عائدة","باليمن تمضي وبالنجاح تجي",47,"ج",2,0],["فقابلت دمعه بالضحك ترسله","مجلجلا معلنا عن شكها فيه",48,"ي",2,0],["فقابَلَتْني بِوجْهٍ جَلَّ رَوْنَقُهُ","عَنْ أَنْ تُقابِلَهُ الأَفواهُ بالقُبْلَهْ",49,"ل",2,0],["فَقابِل بِالقَبولِ صَحيحَ نُصحي","فَإِن أَعرَضتَ عَنهُ فَقَد خَسِرتا",50,"ت",2,0],["فقا بتلك الدِّمَن","شرقي بير اللبن",51,"ن",1,1],["فقابل العيد بالوجه السعيد فإن","لم يدن نورك من نواره برحا",52,"ح",2,0],["فقابلت الخطوب بصبر حر","له قلب لدى الجلى شجاع",53,"ع",1,0],["فقابل حسن الصنع مني بصده","وهذا خلاف لا يوافقه العدل",54,"ل",1,0],["فقابلت بالفضل الذي أنت أهله","ومالك في حسن الصنيع قرين",55,"ن",1,0],["فقابلوها بتقبيل فإن لها","عليكم ذمة من أكبر الذمم",56,"م",1,0],["فقابلت ذا النصح لي بالقبول","وقبلت ثغرا لماه عسل",57,"ل",1,0],["فقابلتُه بالرّحْبِ من كل جانبٍ","وحييتُه في حين لاح محياه",58,"ا",2,0],["فقابلهم باللطف والبشر واعداً","بتحقيق ما راموا وقد اثمر الوعد",59,"د",1,0],["فقابلت الحياة بكل بشر","وقلبك بالأسى دامي القروف",60,"ف",1,0],["فقابَلَنا مِنهُم بَشيرٌ وَنَجدَةٌ","هُمامٌ أَبى في المَجدِ غيرَ التَقَدُّمِ",61,"م",1,0],["فقابل إلهى بالتقبل توبتي","وثبت على تقواك معناي والمبنى",62,"ن",2,0],["فقابلوا بين ماضيهم وحاضرهم","وميزوا النعم الكبرى ومسديها",63,"ي",3,0],["فقابل محياه الوسيم مهنئاً","يحييك بالعمر المديد ويشكر",64,"ر",1,0],["فقابل التكبير في أرضه","من السما تهليل أملاك",65,"ك",1,0],["فَقَابَلَتنِي بِألوَانٍ غَدَوتُ بِهَا","مُقَابَلاً مِن صَبَابَاتِي بِألوَانِ",66,"ن",1,0],["فقابل بالصبر الجميل مصائباً","لو الرسلُ قاستهن لم تر من جلد",67,"د",1,0],["فقابُ قوسين وأدنى قد دنى","ممن علا من الدنو موضعا",68,"ع",2,0],["فَقابلتُه بِالصدّ مني لودّهِ","وَ