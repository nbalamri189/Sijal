{"poems":[[57,"أيا هم نفسي من العالمين","https://www.aldiwan.net/poem26118.html","المتقارب"],[0,"أيا هند لا تنكحي بوهة","https://www.aldiwan.net/poem67.html",""],[53,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[53,"أيا هنتاه هل لك في هريس","https://www.aldiwan.net/poem65024.html","الوافر"],[30,"إن التي نظرت إليك بفادر","https://www.aldiwan.net/poem5215.html","الكامل"],[51,"ننافس في الدنيا ونحن نعيبها","https://www.aldiwan.net/poem10383.html","الطويل"],[82,"مرابعهم للوحش أضحت مراتعا","https://www.aldiwan.net/poem31383.html","الطويل"],[82,"تنهد لما عن سرب النواهد","https://www.aldiwan.net/poem31490.html","الطويل"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10783","الطويل"],[30,"إن التي نظرت إليك بفادر","https://www.poetsgate.com/ViewPoem.aspx?id=17966",""],[159,"أيا هذه إن السحاب التي تسري","https://www.aldiwan.net/poem55681.html","الطويل"],[275,"أيا هند الهوى أصل البلاء","https://www.aldiwan.net/poem35032.html","الوافر"],[287,"متى حثني الشوق يا ناقتي","https://www.aldiwan.net/poem32679.html","المتقارب"],[415,"أيا هاجرا كلما زدت في","https://www.aldiwan.net/poem32523.html","المتقارب"],[469,"أيا هالكاً كان يعطي الأمان","https://www.aldiwan.net/poem3272.html","عموديه"],[469,"أيا هاجري لا تجعل الهجر سنة","https://www.aldiwan.net/poem3486.html","عموديه"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37742","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59658","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67833","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202077","المتقارب"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/116017","الطويل"],[1956,"","https://poetry.dctabudhabi.ae/diwan/poem/121874","الطويل"],[2091,"","https://poetry.dctabudhabi.ae/diwan/poem/134209","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28056","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105066","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60879","السريع"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60969","الطويل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82877","البسيط"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107172","الطويل"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107174","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91411","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216576","الخفيف"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199020","الرجز"],[3850,"","https://poetry.dctabudhabi.ae/diwan/poem/203590","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70142","المتدارك"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101356","الوافر"],[4241,"","https://poetry.dctabudhabi.ae/diwan/poem/138845",""],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33716","المتقارب"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120502","الكامل"],[4691,"أيا هندُ هلاّ زرتِ بيت صبابتي","https://www.poetsgate.com/ViewPoem.aspx?id=156951",""],[4691,"أيا هيفاء حبّك في ضميري","https://www.poetsgate.com/ViewPoem.aspx?id=157231",""],[4710,"انتظار فجرٍ على شرفة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=203120",""],[4829,"الملحمة اليعربيّة","https://www.poetsgate.com/ViewPoem.aspx?id=36397",""],[5327,"لِسانُ الإفْك","https://www.poetsgate.com/ViewPoem.aspx?id=140354",""],[5431,"على مذبح الطغيان سالت دماؤنا","https://www.poetsgate.com/ViewPoem.aspx?id=190282",""],[5431,"عليك صلاة الروح ...","https://www.poetsgate.com/ViewPoem.aspx?id=190681",""],[470,"لماذا..؟!","https://www.poetsgate.com/ViewPoem.aspx?id=178067",""],[5847,"مولد الهادي عليه الصلاة والسلام 1436ه","https://www.poetsgate.com/ViewPoem.aspx?id=176762",""],[5953,"علت قباب لكم هداتي","https://www.poetsgate.com/ViewPoem.aspx?id=93794",""],[5956,"خوفي تحقق","https://www.poetsgate.com/ViewPoem.aspx?id=194821",""],[6152,"صبا نجد","https://www.poetsgate.com/ViewPoem.aspx?id=201750",""]],"verses":[["أَيا هَمَّ نَفسي مِنَ العالَمينَ","وَمَن لَيسَ يَرعى لِوَصلي ذِماما",0,"م",2,1],["أَيا هِندُ لا تَنكِحي بَوهَةَ","عَلَيهِ عَقيقَتُهُ أَحسَبا",1,"ب",2,1],["إياه كانت تراعي همتي وله","كانت تصون أديم الوجه والمِدَحا",2,"ح",2,0],["أيا هَنتاه هل لك في هريسٍ","بلُحمانِ النَّواهِض والبطوطِ",3,"ط",1,1],["إِيّاهُ كُنتُ أَرَدتُ لَو بَلَّغتِني","يَومَ اِرتَحَلتُ مِنَ العِراقِ الأَزوَرِ",4,"ر",1,0],["أَيا هادِمَ اللَذاتِ ما مِنكَ مَهرَبٌ","تُحاذِرُ نَفسي مِنكَ ما سَيُصيبُها",5,"ب",3,0],["أيا هذه إنّ العُلى لتهزّ بي","حُساماً على صَرْفِ الحوادثِ قاطعا",6,"ع",2,0],["أَيا هَذهِ استَبقي عَلى الجِسمِ إِنَّني","كَثيرٌ سَقامي حَيثُ قَلَّت عَوائِدي",7,"د",2,0],["أَيا هَجرَ لَيلى قَد بَلَغتَ بِيَ المَدى","وَزِدتَ عَلى ما لَم يَكُن بَلَغَ الهَجرُ",8,"ر",1,1],["إيّاهُ كُنْتُ أرَدْتُ، إنْ بَلّغْتِني","يَوْمَ ارْتَحَلْتُ من العِرَاقِ الأزْوَرِ",9,"ر",1,0],["أَيا هذِهِ إِنَّ السَّحابَ التي تَسْري","بَكَتْ لِبُكائي رَحْمَةً وَهْيَ لاَ تَدْري",10,"ر",2,1],["أيا هِندُ الهوى أصلُ البلاءِ","فَصِفِّينُ انتَهَت في كَربلاءِ",11,"ا",2,1],["أَيا هِندُ هِندُ بَني عامِرٍ","شِفا أَلَمي في اِرتِشافي لَماكِ",12,"ك",1,0],["أَيَا هاجراً كُلَّما زِدتُ في","خُضوعِي لَهُ زَادَ هِجرانُهُ",13,"ن",2,1],["أيا هالكاً كان يعطي الأمان","لمن خاف من دهره والأماني",14,"ي",1,1],["أيا هاجري لا تجعل الهجر سنَّةً","وإن كنت لا ترجو ثوابي فخف إثمي",15,"م",2,1],["أَيا هِبَةَ المَولى المُقدّس نَعتُهُ","وَمَن بِجَزيلِ الفَضلِ كلَّ الورى غَمَرْ",16,"ر",1,1],["أيا هاجراً مهلاً فقد ذهب المهل","فمنا الجفا جهلاً ومنك هو الفضل",17,"ل",1,1],["أيَا هَاجِرِي صِلْني جُعِلْتُ لَكَ الْفِدَا","وَإلاَّ فَدَعْ بَيْنِي وَبَيْنَكَ مَوْعِدَا",18,"د",2,0],["أيا هبَة الله آل العباء","كَفاكَ غداً فاتَّخِذْهُم وَكيلا",19,"ل",2,0],["أيا هاجرى من غير جُرمٍ ومانِعى","بإعراضهِ أن أشربَ الماءَ صافيا",20,"ي",2,1],["أيا هاجري من غير جرم جنيته","ومن دأبه ظلمي وهجري فديته",21,"ت",2,1],["أيا هبة الدين القويم ومن به","تباهت رجال الدين في النظم والنثر",22,"ر",1,0],["إيّاه أسأل عنه حين يسألني","عني وينسى إذا أنسى فأذكره",23,"ر",2,0],["إياه ينجز وعده","أم مال عن عهد المحب",24,"ب",1,0],["إياه لو لم يقترن","بوفاه كنت قضيت نحبي",24,"ب",2,0],["إياه كنّا بكثيب الحِمى","وخِدرَ ليلى خدرنا من سناه",25,"ا",2,0],["أيَا هذه رفقاً بقلبٍ أسَرْتِه","فما زال مِنْ شرطِ الرفيقِ الترَفّق",26,"ق",1,0],["إِيّاهُ فَاِتَّبِعوا تَتلون مُتَّبِعا","كَفاكُم طَلَباً ما كانَ من طَلَبِه",27,"ب",2,0],["أَيا هاشِمِيَّ الأَصلِ من خيرِ عِترَةٍ","هُمُ الصِّيدُ ساداتُ الوَرى وَأُسُودُها",28,"د",3,0],["أَيا هاشِميّاً من قديمٍ جُدُودُهُ","غِياثُ الوَرى في حِينِ ضِيقٍ وإِعسارِ",29,"ر",1,0],["أَيا هذي الملاحةُ وَالجَمالُ","يَحق لك التمنُّعُ وَالدَلالُ",30,"ل",1,1],["أي اهل وجيرة لهمام","اوحديّ المنى قليل النظير",31,"ر",1,0],["إياه فاعبد أيها الإنسان","فهو اللطيف القادر المنان",32,"ن",1,0],["أيا هَضْبَتَيْ مجدٍ ويا كَوكَبَيْ سعدِ","ويا رافدَيْ رفدٍ ويا صارمَيْ حدِّ",33,"د",1,1],["أيا هكطور حزنك سو","ف ينزل بي إلى قبري",34,"ي",1,0],["أيا هكطور إلف عنا","عقيب اللهو والطرب",34,"ب",1,0],["أَيُّاهُ عنيتُ واهليه","مَن قُلِدَ السَيف مِن عَبد العَزيز كَما",35,"م",2,0],["أيا هادي الفواحش سوف يأتي","اليك الهجو لماح الوميض",36,"ض",1,0],["أيا هجرٌ ذكراكِ هيَّجَ ما بيا","وأجَّجَ ناراً وَقدُها في فؤاديا",37,"ي",2,1],["أيا هاجِري ظالِماً","وليسَ بِحِلٍّ لكا",38,"ك",2,0],["اياه يشكر في العشية سارب","وعليه يثنى في الضحية سارح",39,"ح",1,0],["أيا هندُ هلاّ زرتِ بيتَ صبابتي","ففي أيكةِ الأشجانِ قلبيَ ينزفُ",40,"ف",1,0],["أيا هندُ هذي آية ُ الودِّ إنني","أرتّلُها ليلا ولستُ أحرّفُ",40,"ف",1,0],["أيا هيفاء حبّك في ضميري","فما أخفيه في بيض السطور",41,"ر",1,1],["أيا هذا المسجّى خلفَ ليلٍ","أقامَ؛ ولم تقلْ: آنستُ نارا",42,"ر",2,0],["أيا هذا فلا تعجل علينا","واصبر كم يوم ثم نبينا",43,"ن",2,0],["أيَا هَذا الذى عَرَفُوهُ بَسْماً","أرَاها بسْمَةً مِن سُوءِ مَنبَع",44,"ع",1,0],["أيا هيكلا يُسقى الدماء لينتشي","كريها على صرح أشيدَ تعسفا",45,"ف",2,0],["أيا هاطلا بالروح عشقا مُلامسي","وياساطعا في القلب بدرا مؤانسي",46,"س",2,1],["أيُّ آه ما قلتُها؟.. أيُّ دمعٍ","لم أوَسِّدْ ندَاهُ في كَفَّيكِ؟",47,"ك",1,0],["6- أيا هبةَ الرحيم أتيت رُحمى","بنور الله تنقذُ من يتوبُ",48,"ب",1,0],["إياه أعني أم كيف أكني","أم كيف أخفي مدائحات",49,"ت",1,0],["إيّاه ينزع جِبْسَهُ إلا إذا","أمرَ الطبيب بدقةٍ وحسابِ",50,"ب",1,0],["أيا هند والأيام ثكلى بفقدكم","فقد مسها ضر وألهبها فقد",51,"د",1,0]]}