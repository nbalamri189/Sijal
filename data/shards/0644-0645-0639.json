368,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[370,"تلك الرياض إذا تهجر حادث","https://www.aldiwan.net/poem17302.html","الكامل"],[375,"لمعت سيوف بني حميد بعد ما","https://www.aldiwan.net/poem57156.html","الكامل"],[404,"ياشذا المجد أين بغداد عنا ؟!","https://www.aldiwan.net/poem6735.html","عموديه"],[436,"أنجد الصب وغاروا","https://www.aldiwan.net/poem12645.html","مجزوء الرمل"],[436,"علمنا وقد مات الكمال التساويا","https://www.aldiwan.net/poem12769.html","الطويل"],[441,"ته فلو قستك بالظبي الغرير","https://www.aldiwan.net/poem2516.html","الرمل"],[443,"وفي غيابات أطباق الخطوب شج","https://www.aldiwan.net/poem34760.html","البسيط"],[443,"دواليك من دهر يواليك بالنجح","https://www.aldiwan.net/poem34846.html","الطويل"],[443,"جهز لنا في الأرض غزوة محتسب","https://www.aldiwan.net/poem34905.html","الكامل"],[464,"لمعت كتلويح الرداء المسبل","https://www.aldiwan.net/poem15089.html","الكامل"],[464,"جرد سيوفك للجلاد وأشهر","https://www.aldiwan.net/poem15128.html","الكامل"],[464,"يا عاقدا وضن الجمال البزل","https://www.aldiwan.net/poem16248.html","الكامل"],[467,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[471,"يا أبا إسحاق أخلا","https://www.aldiwan.net/poem60539.html","مجزوء الرمل"],[480,"هل بعد بينك من جوى لمودع","https://www.aldiwan.net/poem15216.html","الكامل"],[480,"ما لحبل الوصل قد أمسى رماما","https://www.aldiwan.net/poem15278.html","الرمل"],[485,"أسرت بدور أم بدت هالات","https://www.aldiwan.net/poem24292.html","الكامل"],[503,"طرق السر من البرهان ما","https://www.aldiwan.net/poem37802.html","الرمل"],[503,"بين النجوم وبين مسبار الضحى","https://www.aldiwan.net/poem37819.html","الكامل"],[503,"أورد الدلو لعقد الكرب","https://www.aldiwan.net/poem38069.html","الرمل"],[517,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[561,"ثوب صدق المجال فوق قميصي","https://www.aldiwan.net/poem34425.html","الخفيف"],[561,"أنا دائما يا نور كل مليح","https://www.aldiwan.net/poem34680.html","الكامل"],[561,"حرك الذت آلة الأسماء","https://www.aldiwan.net/poem34973.html","الخفيف"],[565,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"]],"verses":[["لُمَعٌ مِنَ الأَطلالِ يُحزِنُنا","مُحتَلُّها البالي وَمَألَفُها",0,"ف",3,0],["لَمعُ المَداري جُلنَ في العِقاصِ","كَأَنَّ خَفقَ الكَوكَبِ الوَباصِ",1,"ص",1,0],["لَمعَ النَّجمُ عَلى جَبهَتِها","وَتَرَدَّتْ بِجلابيبِ الدُّجَى",2,"ا",1,0],["لَمَعَتْ كناصِيَةِ الحِصانِ الأشْقَرِ","نارٌ بمُعتَلِجِ الكَثيبِ الأعْفَرِ",3,"ر",1,1],["لمَعْنَى أبي يَعْقوبَ رهْنُ ضَريحِهِ","يحِنُّ لأهْلِ اللّهِ أنْ تُعْمِلَ السّعْيا",4,"ي",2,0],["لمَعْنًى حَباكَ اللهُ بالمُلْكِ ناشِئاً","وكُنتَ بأهْلِ العِلْمِ في المَهْدِ مَهْدِيّا",5,"ي",2,0],["لُمَعٌ طَلَّةٌ مِنَ العَيشِ ما إِن","لِلهَوى عَن مَحَلَّها تَعويضُ",6,"ض",1,0],["لِمُعتَضِدٍ بِهِ أَرضاهُ سَعياً","فَأَقبَلَ وَجهَهُ وَجهَ الفَلاحِ",7,"ح",1,0],["لمع الذكاء بوجهه","كالبرق يلمع في سحابه",8,"ب",2,0],["لِمُعَفَّرٍ قَهدٍ تَنازَعَ شِلوَهُ","غُبسٌ كَواسِبُ لا يُمَنُّ طَعامُها",9,"م",3,0],["لمعشرٍ هم لمن ولاهمُ نعمٌ","هنيئة ولمن عاداهمُ نقمُ",10,"م",1,0],["لَمعاً وَإيماضَ بَرقٍ ما يَصوبُ لَنا","وَلَو بَدا مِن سُلَيمى النَحرُ وَالجيدُ",11,"د",1,0],["لَمَعَ القَتيرُ بِلِمَّتي","وَيلُ الشَبابِ مِنَ القَتيرِ",12,"ر",1,0],["لمعت نارهم وقد عسعس الليل","ومل الحادي وتاه الدليل",13,"ل",1,0],["لمعُ المكارمِ والثناءِ تقارنَا","فيها كما ضَمَّ السُّعودَ قِرانُ",14,"ن",1,0],["لمعتْ تباشيرُ العَلاء وأعرضتْ","سُحُبٌ من العِزِّ الجديد لتَهْطِلا",15,"ل",2,0],["لِمْ عِبْتَ شِعري وهو أو","ضاحٌ تَبسَّمُ أو غُرَر",16,"ر",1,0],["لمعَتْ بوارِقُه فكُنَّ سَحائباً","في معشرٍ وصَواعِقاً في معشَرِ",17,"ر",1,0],["لمَعتْ للعيونِ بعدَ اسودادٍ","فأَضاءَت حنادسُ الظَّلماءِ",18,"ا",2,0],["لِم عَكَستَ القِياسَ في نارِ قَلبي","فَإِذا ما ذُكِرتَ تَزدادُ وَقدا",19,"د",2,0],["لِمَ عُدنا أوَ لَم نَطوِ الغَرَام","وفَرغنا مِن حنينٍ وألَم",20,"م",1,0],["لَمَعَت أَسِنَّتُهُ فَهُنَّ مَعَ الضُحى","شَمسٌ وَهُنَّ مَعَ الظَلامِ نُجومُ",21,"م",1,0],["لَمعُ السُّيُوفِ وَتَصهالُ الخُيولِ بِهِ","كَالبَرقِ وَالرَّعدِ في مُغدَودِقٍ هَزِمِ",22,"م",1,0],["لَمَعَت بِأَطرافِ البَنانِ لَنا","إِنّا نُحاذِرُ أَعيُنَ الرَكبِ",23,"ب",1,0],["لَمعَ ايَواقيتِ مَعَ الشُذورِ","إِلى قَراطيمَ نِبالٍ حورِ",24,"ر",1,0],["لَمَعَت إِلَيَّ تَسومُني","لَعِبَ الشَبابِ وَقَد طَوَيتُه",25,"ت",2,0],["لمعت نارهم وَقَد عسعس اللَي","لُ وَمل الحادي وَحار الدَليل",26,"ل",1,0],["لِمُعْتَزِليِّ الرّأَىِ ناءٍ عن الهُدَى","بَعِيدِ المرامِي مُسْتَمِيتِ البَصَائِرِ",27,"ر",1,0],["لِمُعْجِزِهِ نَظْماً وَنَثْراً شَوَارِدٌ","مِنَ الفِكْرِ لَمْ تُغْلَلْ وَلَمْ تَتَقَيَّدِ",28,"د",1,0],["لِمَ عَوْدُ أُوتِللو وَعُقْبَى حَالِهِ","مَوْتُ الغَشُومِ وَصَرْعَةُ الخَدَّاعِ",29,"ع",1,0],["لمعت أنوارها للمجتلي","قوتل الإنسان كم دمر بي",30,"ي",1,0],["لَمَعَتْ في عُلاَكِ دُرَّةُ خِدْرٍ","كَرُمَتْ نَشْأَةً وَطَابَتْ جُدُودَا",31,"د",2,0],["لمعلِّم الوادي رجا","ء في نجيبٍ ولا يخيب",32,"ب",1,0],["لمعاهد الاسلام بعدك رنة","وعهود فضلك كالنجوم سواري",33,"ر",2,0],["لمعنى حباك الله بالملك ناشئا","أهل العلم في المهد مهديا",34,"ي",2,0],["لمعان الحسن وضاح السنى","بضياء الظرف غشى هيكلك",35,"ك",1,0],["لمع الصباح برونق السعد","فافاض فينا نفحة المجد",36,"د",1,1],["لمعت بوارق دولة الإرشاد","برحاب قطب الأوليا الصياد",37,"د",1,1],["لمعاليك جئت أعرض حالي","يا رسول المهيمن المتعالي",38,"ل",2,1],["لَمَعَانُ البُرُوقِ هَاجَ الهُمُومَا","ومَرَى م العُيُونِ دَمعاً جَمُومَا",39,"م",2,1],["لَمَعَ البَرقُ اليماني","فَشَجاني ما شَجاني",40,"ن",2,1],["لِمَ عافَ وِردَ الماءِ قَد ظَمِأَت لَهُ","شَفَتاهُ وَاِتَّخَذَ المَدامِعَ مَورِداً",41,"د",2,0],["لمعت جواهرُهُ فكان كليلةٍ","للنَّجمِ في آفاقِها إشراق",42,"ق",1,0],["لمعجزِهِ أَقرَّ الضدُّ عجزاً","وَظلَّت عنده الفُصحاء لُكنا",43,"ن",2,0],["لمعَت أَسِرَّةُ نوره في وجهه","فاِزورَّ عنها كُلُّ لَحظٍ أَخزَرِ",44,"ر",1,0],["لَمَعَت لَيلاً فَقالوا لَهبُ","وَصفَت لَناً فَقالوا ذهبُ",45,"ب",1,1],["لمعتْ في الشمسِ من طوقيهما","دررٌ تزري بأطواقِ الملاحِ",46,"ح",1,0],["لمعة البشر في مآقيه برق","يتندّى بالهاتن المغلول",47,"ل",1,0],["لم عنصر الأرض","يطير في الجو",48,"و",1,0],["لَمَعت بَطشاً قَواضبه","لِترى مِنهُ العِدا رُعبا",49,"ب",2,0],["لِمَعاجِ نِضْوٍ في مَحل داثرٍ","ومَجلِّ طَرْفٍ في رسومٍ هُمّد",50,"د",1,0],["لَمَعَ النُضارُ بِها فَقُلنا شَمسُها","وَجَرى اللُجَينُ فَخِلتُهُ أَمواها",51,"ا",3,0],["لمعَت سُيوفُ بَني حُميدٍ بَعدَ ما","صَدِئت وطالَ بهنَّ عَهدُ الرُّومِ",52,"م",1,1],["لمَّعَتْ وجهَها الدَّعاوىَ ولكنْ","مالها عند ربِّنا مِنْ خَلاَقِ",53,"ق",1,0],["لمعاليهِ على شأ","وِ معاليهِ الخِيارُ",54,"ر",1,0],["لِمَعْناهُ قامَ الجوّ بالرّعدِ نائحاً","وبالبرقِ مَلْطوماً وبالغيثِ باكيا",55,"ي",2,0],["لم عداني صوب كفّيك وما","زلت بالشكر لكم أطوي ضميري",56,"ر",2,0],["لِمُعْتَلِي هِمَّةٍ بَيْنَ النجومِ هَوَتْ","بِهِ النجومُ بِرُزْءٍ مَا لَهُ وَزَرُ",57,"ر",1,0],["لَمَعْتَ بِهِ فِي جوِّ ناجِرَ لمعةً","ثَنَتْ كَبِدَ الشيطانِ دامِيَةَ الجُرْحِ",58,"ح",1,0],["لمعاقلٍ من سَوسَنٍ قَدْ شَيَّدَتْ","أَيدي الربيع بِنَاءها فَوْقَ القُضُبْ",59,"ب",1,0],["لمعت كتلويح الرداء المُسبَل","والليل صبغ خضابه لم ينصل",60,"ل",1,1],["لمُعذَّلٍ في الجودِ صَوْبُ يمينه","يُزري بسيل الشاهق المُتحدر",61,"ر",1,0],["لمُعَظَّمٍ مَلأَ الزَّمانَ مَهابَةً","ذَلَّتْ لخيفَتها صُدورُ الذُبَّلِ",62,"ل",1,0],["لم على ما جناه طرفك والقلب","ولا تشتك الظباء الغيدا",63,"د",2,0],["لِمَ عَفا رَسمُ الزَيارا","تِ وَلَم رَيَّ اللِقاءُ",64,"ا",2,0],["لمعتْ فجددتِ الشجونَ وأجَّجَتْ","نارَ الهوى العذريَّ بينَ الأضلُعِ",65,"ع",1,0],["لمعتْ لي بارقاتُ المنحنى","وهي تُبدي في دجى الليلِ ابتساما",66,"م",2,0],["لمعت قبالة ناظري إنسانة","تزري بسعدي بالبها درجات",67,"ت",1,0],["لَمَعَتْ نارَ الحِمى واشَغَفي","للحِمى مذْ لَمَعَتْ نارُ الحِمى",68,"م",2,0],["لمَعَتْ له نارُ الشُؤُنِ فغابَ عن","أَجْزائِهِ حالاً وبالغَشْيِ اشْتَغَلْ",69,"ل",1,0],["لمعَتْ شمساً ولكنْ طوَتْ","كوكَباً مُنْبَجِساً عن كوكَبِ",70,"ب",1,0],["لمعادِنِ الأرزاقِ من أكْمامِه","طُرُقٌ وللبحرَيْنِ فيها مَجمَعُ",71,"ع",1,0],["لمعة بانحرافها عن ثريا","ذلك الوصف أطمعت للحريص",72,"ص",1,0],["لمعت بروق الأبرقين وقد جرت","أمطار جفن بالبكاء قريح",73,"ح",1,0],["لمعُ برقٍ إلهامُ كلِّ وليٍّ","وحي حق لسائر الأنبياء",74,"ا",2,0],["لمعْنَيَيْهِ ائتلافٌ وهْوَ قد فَتَنَ ال","أبصارَ بالحُسن والأسماعَ بالرَنَمِ",75,"م",1,0]]}