{"poems":[[53,"قضت المنازل يوم كاظمة","https://www.aldiwan.net/poem29962.html","الكامل"],[53,"ما هاج من ذي طرب مخماص","https://www.aldiwan.net/poem30179.html","الرجز"],[63,"وظلام قيد العين به","https://www.aldiwan.net/poem45729.html","الرمل"],[63,"لمعت كناصية الحصان الأشقر","https://www.aldiwan.net/poem46196.html","الكامل"],[77,"حفيد ولي الله ذي الرتبة العليا","https://www.aldiwan.net/poem35713.html","الطويل"],[77,"وجودك حي الملك والدين والدنيا","https://www.aldiwan.net/poem35717.html","الطويل"],[73,"غمرتني لك الأيادي البيض","https://www.aldiwan.net/poem11926.html","الخفيف"],[73,"أعرفك راح في عرف الرياح","https://www.aldiwan.net/poem11940.html","الوافر"],[88,"سر في حياتك سير نابه","https://www.aldiwan.net/poem44813.html","مجزوء الكامل"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[72,"بكيت ليلا بوجدي وهي تبتسم","https://www.aldiwan.net/poem19675.html","البسيط"],[29,"بانت سعاد ففي العينين تسهيد","https://www.aldiwan.net/poem6030.html","البسيط"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[89,"فجع المشرقين خطب جليل","https://www.aldiwan.net/poem44704.html","الخفيف"],[62,"لقياك من غير الزمان أمان","https://www.aldiwan.net/poem52256.html","الكامل"],[62,"هذا الزمان يزف أبكار العلى","https://www.aldiwan.net/poem52319.html","الطويل"],[61,"قل لابن حرب قد جنيت","https://www.aldiwan.net/poem51654.html","مجزوء الكامل"],[61,"عفر الظباء لدى الكثيب الأعفر","https://www.aldiwan.net/poem51686.html","الكامل"],[61,"خفقت راية الصباح وللنار","https://www.aldiwan.net/poem51827.html","البسيط"],[66,"يا سمي الذي له خبت النار","https://www.aldiwan.net/poem39534.html","الخفيف"],[97,"هذه الكعبة كنا طائفيها","https://www.aldiwan.net/poem24799.html","الرمل"],[44,"أسقى طلولهم أجش هزيم","https://www.aldiwan.net/poem30341.html","الكامل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[31,"لبس الظلام إليك مكتتما","https://www.aldiwan.net/poem42656.html","الكامل"],[48,"يا أيها المطنب ذا الغرور","https://www.aldiwan.net/poem63413.html","الرجز"],[50,"يا منظرا حسنا رأيته","https://www.aldiwan.net/poem64743.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85412","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30459","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54756","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55017","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[106,"تحيْة وقضيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179505",""],[77,"وجودك حيى الملك والدين والدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=34199",""]],"verses":[["لُمَعٌ مِنَ الأَطلالِ يُحزِنُنا","مُحتَلُّها البالي وَمَألَفُها",0,"ف",3,0],["لَمعُ المَداري جُلنَ في العِقاصِ","كَأَنَّ خَفقَ الكَوكَبِ الوَباصِ",1,"ص",1,0],["لَمعَ النَّجمُ عَلى جَبهَتِها","وَتَرَدَّتْ بِجلابيبِ الدُّجَى",2,"ا",1,0],["لَمَعَتْ كناصِيَةِ الحِصانِ الأشْقَرِ","نارٌ بمُعتَلِجِ الكَثيبِ الأعْفَرِ",3,"ر",1,1],["لمَعْنَى أبي يَعْقوبَ رهْنُ ضَريحِهِ","يحِنُّ لأهْلِ اللّهِ أنْ تُعْمِلَ السّعْيا",4,"ي",2,0],["لمَعْنًى حَباكَ اللهُ بالمُلْكِ ناشِئاً","وكُنتَ بأهْلِ العِلْمِ في المَهْدِ مَهْدِيّا",5,"ي",2,0],["لُمَعٌ طَلَّةٌ مِنَ العَيشِ ما إِن","لِلهَوى عَن مَحَلَّها تَعويضُ",6,"ض",1,0],["لِمُعتَضِدٍ بِهِ أَرضاهُ سَعياً","فَأَقبَلَ وَجهَهُ وَجهَ الفَلاحِ",7,"ح",1,0],["لمع الذكاء بوجهه","كالبرق يلمع في سحابه",8,"ب",2,0],["لِمُعَفَّرٍ قَهدٍ تَنازَعَ شِلوَهُ","غُبسٌ كَواسِبُ لا يُمَنُّ طَعامُها",9,"م",3,0],["لمعشرٍ هم لمن ولاهمُ نعمٌ","هنيئة ولمن عاداهمُ نقمُ",10,"م",1,0],["لَمعاً وَإيماضَ بَرقٍ ما يَصوبُ لَنا","وَلَو بَدا مِن سُلَيمى النَحرُ وَالجيدُ",11,"د",1,0],["لَمَعَ القَتيرُ بِلِمَّتي","وَيلُ الشَبابِ مِنَ القَتيرِ",12,"ر",1,0],["لمعت نارهم وقد عسعس الليل","ومل الحادي وتاه الدليل",13,"ل",1,0],["لمعُ المكارمِ والثناءِ تقارنَا","فيها كما ضَمَّ السُّعودَ قِرانُ",14,"ن",1,0],["لمعتْ تباشيرُ العَلاء وأعرضتْ","سُحُبٌ من العِزِّ الجديد لتَهْطِلا",15,"ل",2,0],["لِمْ عِبْتَ شِعري وهو أو","ضاحٌ تَبسَّمُ أو غُرَر",16,"ر",1,0],["لمعَتْ بوارِقُه فكُنَّ سَحائباً","في معشرٍ وصَواعِقاً في معشَرِ",17,"ر",1,0],["لمَعتْ للعيونِ بعدَ اسودادٍ","فأَضاءَت حنادسُ الظَّلماءِ",18,"ا",2,0],["لِم عَكَستَ القِياسَ في نارِ قَلبي","فَإِذا ما ذُكِرتَ تَزدادُ وَقدا",19,"د",2,0],["لِمَ عُدنا أوَ لَم نَطوِ الغَرَام","وفَرغنا مِن حنينٍ وألَم",20,"م",1,0],["لَمَعَت أَسِنَّتُهُ فَهُنَّ مَعَ الضُحى","شَمسٌ وَهُنَّ مَعَ الظَلامِ نُجومُ",21,"م",1,0],["لَمعُ السُّيُوفِ وَتَصهالُ الخُيولِ بِهِ","كَالبَرقِ وَالرَّعدِ في مُغدَودِقٍ هَزِمِ",22,"م",1,0],["لَمَعَت بِأَطرافِ البَنانِ لَنا","إِنّا نُحاذِرُ أَعيُنَ الرَكبِ",23,"ب",1,0],["لَمعَ ايَواقيتِ مَعَ الشُذورِ","إِلى قَراطيمَ نِبالٍ حورِ",24,"ر",1,0],["لَمَعَت إِلَيَّ تَسومُني","لَعِبَ الشَبابِ وَقَد طَوَيتُه",25,"ت",2,0],["لمعت نارهم وَقَد عسعس اللَي","لُ وَمل الحادي وَحار الدَليل",26,"ل",1,0],["لِمُعْتَزِليِّ الرّأَىِ ناءٍ عن الهُدَى","بَعِيدِ المرامِي مُسْتَمِيتِ البَصَائِرِ",27,"ر",1,0],["لِمُعْجِزِهِ نَظْماً وَنَثْراً شَوَارِدٌ","مِنَ الفِكْرِ لَمْ تُغْلَلْ وَلَمْ تَتَقَيَّدِ",28,"د",1,0],["لِمَ عَوْدُ أُوتِللو وَعُقْبَى حَالِهِ","مَوْتُ الغَشُومِ وَصَرْعَةُ الخَدَّاعِ",29,"ع",1,0],["لمعت أنوارها للمجتلي","قوتل الإنسان كم دمر بي",30,"ي",1,0],["لَمَعَتْ في عُلاَكِ دُرَّةُ خِدْرٍ","كَرُمَتْ نَشْأَةً وَطَابَتْ جُدُودَا",31,"د",2,0],["لمعلِّم الوادي رجا","ء في نجيبٍ ولا يخيب",32,"ب",1,0],["لمعنى حباك الله بالملك ناشئا","أهل العلم في المهد مهديا",33,"ي",2,0]]}