ae/diwan/poem/113835","الرمل"],[4691,"قهقهة 1","https://www.poetsgate.com/ViewPoem.aspx?id=105401",""],[4578,"عُرب اللوى عن عهود الود قد حالوا","https://www.poetsgate.com/ViewPoem.aspx?id=49505",""],[5012,"ما أوعدك","https://www.poetsgate.com/ViewPoem.aspx?id=26272",""],[585,"لمع اللجين وسال ذوب العسجد","https://www.poetsgate.com/ViewPoem.aspx?id=161875",""],[5092,"سيمفونية قصيرة","https://www.poetsgate.com/ViewPoem.aspx?id=139889",""],[5092,"أرص المحال","https://www.poetsgate.com/ViewPoem.aspx?id=161807",""],[5135,"المُعَلِّم","https://www.poetsgate.com/ViewPoem.aspx?id=201805",""],[5213,"يا نسيم الطلول طبت نسيما","https://www.poetsgate.com/ViewPoem.aspx?id=170535",""],[5277,"مذاقُ الشهادة","https://www.poetsgate.com/ViewPoem.aspx?id=206601",""],[5277,"وا جدّاهُ..","https://www.poetsgate.com/ViewPoem.aspx?id=215775",""],[5362,"لمعت في ظلام رأسي شهابا","https://www.poetsgate.com/ViewPoem.aspx?id=170375",""],[5409,"لم ضيعت منك سحر الغدائر","https://www.poetsgate.com/ViewPoem.aspx?id=155279",""],[5431,"معنى الرجولة","https://www.poetsgate.com/ViewPoem.aspx?id=183089",""],[5431,"دع عنك شكا في الوجود مؤرقا","https://www.poetsgate.com/ViewPoem.aspx?id=187362",""],[5436,"لهيب الثأر ماخمدا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177642",""],[5461,"لمعة النجمة","https://www.poetsgate.com/ViewPoem.aspx?id=5302",""],[5690,"لحسن رأيك باتت تخضع الفكرُ","https://www.poetsgate.com/ViewPoem.aspx?id=172163",""],[5843,"اخر مسافر","https://www.poetsgate.com/ViewPoem.aspx?id=51292",""],[5956,"طيف الحبيبة الميّتة","https://www.poetsgate.com/ViewPoem.aspx?id=182160",""],[5956,"وداعاً للغيريَّة","https://www.poetsgate.com/ViewPoem.aspx?id=183735",""],[5956,"أهجو أحدَ الأعدقاء ‏","https://www.poetsgate.com/ViewPoem.aspx?id=185613",""],[5956,"لِمَ عدت يا غالي لشعري؟","https://www.poetsgate.com/ViewPoem.aspx?id=193691",""],[6100,"الصمان","https://www.poetsgate.com/ViewPoem.aspx?id=52551",""],[6102,"رسالة إلى \"موديل\" ...","https://www.poetsgate.com/ViewPoem.aspx?id=184870",""],[6286,"لَمعَتْ ليلاً فقالوا لَهبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27561&r=&rc=10",""]],"verses":[["لُمَعٌ مِنَ الأَطلالِ يُحزِنُنا","مُحتَلُّها البالي وَمَألَفُها",0,"ف",3,0],["لَمعُ المَداري جُلنَ في العِقاصِ","كَأَنَّ خَفقَ الكَوكَبِ الوَباصِ",1,"ص",1,0],["لَمعَ النَّجمُ عَلى جَبهَتِها","وَتَرَدَّتْ بِجلابيبِ الدُّجَى",2,"ا",1,0],["لَمَعَتْ كناصِيَةِ الحِصانِ الأشْقَرِ","نارٌ بمُعتَلِجِ الكَثيبِ الأعْفَرِ",3,"ر",1,1],["لمَعْنَى أبي يَعْقوبَ رهْنُ ضَريحِهِ","يحِنُّ لأهْلِ اللّهِ أنْ تُعْمِلَ السّعْيا",4,"ي",2,0],["لمَعْنًى حَباكَ اللهُ بالمُلْكِ ناشِئاً","وكُنتَ بأهْلِ العِلْمِ في المَهْدِ مَهْدِيّا",5,"ي",2,0],["لُمَعٌ طَلَّةٌ مِنَ العَيشِ ما إِن","لِلهَوى عَن مَحَلَّها تَعويضُ",6,"ض",1,0],["لِمُعتَضِدٍ بِهِ أَرضاهُ سَعياً","فَأَقبَلَ وَجهَهُ وَجهَ الفَلاحِ",7,"ح",1,0],["لمع الذكاء بوجهه","كالبرق يلمع في سحابه",8,"ب",2,0],["لِمُعَفَّرٍ قَهدٍ تَنازَعَ شِلوَهُ","غُبسٌ كَواسِبُ لا يُمَنُّ طَعامُها",9,"م",3,0],["لمعشرٍ هم لمن ولاهمُ نعمٌ","هنيئة ولمن عاداهمُ نقمُ",10,"م",1,0],["لَمعاً وَإيماضَ بَرقٍ ما يَصوبُ لَنا","وَلَو بَدا مِن سُلَيمى النَحرُ وَالجيدُ",11,"د",1,0],["لَمَعَ القَتيرُ بِلِمَّتي","وَيلُ الشَبابِ مِنَ القَتيرِ",12,"ر",1,0],["لمعت نارهم وقد عسعس الليل","ومل الحادي وتاه الدليل",13,"ل",1,0],["لمعُ المكارمِ والثناءِ تقارنَا","فيها كما ضَمَّ السُّعودَ قِرانُ",14,"ن",1,0],["لمعتْ تباشيرُ العَلاء وأعرضتْ","سُحُبٌ من العِزِّ الجديد لتَهْطِلا",15,"ل",2,0],["لِمْ عِبْتَ شِعري وهو أو","ضاحٌ تَبسَّمُ أو غُرَر",16,"ر",1,0],["لمعَتْ بوارِقُه فكُنَّ سَحائباً","في معشرٍ وصَواعِقاً في معشَرِ",17,"ر",1,0],["لمَعتْ للعيونِ بعدَ اسودادٍ","فأَضاءَت حنادسُ الظَّلماءِ",18,"ا",2,0],["لِم عَكَستَ القِياسَ في نارِ قَلبي","فَإِذا ما ذُكِرتَ تَزدادُ وَقدا",19,"د",2,0],["لِمَ عُدنا أوَ لَم نَطوِ الغَرَام","وفَرغنا مِن حنينٍ وألَم",20,"م",1,0],["لَمَعَت أَسِنَّتُهُ فَهُنَّ مَعَ الضُحى","شَمسٌ وَهُنَّ مَعَ الظَلامِ نُجومُ",21,"م",1,0],["لَمعُ السُّيُوفِ وَتَصهالُ الخُيولِ بِهِ","كَالبَرقِ وَالرَّعدِ في مُغدَودِقٍ هَزِمِ",22,"م",1,0],["لَمَعَت بِأَطرافِ البَنانِ لَنا","إِنّا نُحاذِرُ أَعيُنَ الرَكبِ",23,"ب",1,0],["لَمعَ ايَواقيتِ مَعَ الشُذورِ","إِلى قَراطيمَ نِبالٍ حورِ",24,"ر",1,0],["لَمَعَت إِلَيَّ تَسومُني","لَعِبَ الشَبابِ وَقَد طَوَيتُه",25,"ت",2,0],["لمعت نارهم وَقَد عسعس اللَي","لُ وَمل الحادي وَحار الدَليل",26,"ل",1,0],["لِمُعْتَزِليِّ الرّأَىِ ناءٍ عن الهُدَى","بَعِيدِ المرامِي مُسْتَمِيتِ البَصَائِرِ",27,"ر",1,0],["لِمُعْجِزِهِ نَظْماً وَنَثْراً شَوَارِدٌ","مِنَ الفِكْرِ لَمْ تُغْلَلْ وَلَمْ تَتَقَيَّدِ",28,"د",1,0],["لِمَ عَوْدُ أُوتِللو وَعُقْبَى حَالِهِ","مَوْتُ الغَشُومِ وَصَرْعَةُ الخَدَّاعِ",29,"ع",1,0],["لمعت أنوارها للمجتلي","قوتل الإنسان كم دمر بي",30,"ي",1,0],["لَمَعَتْ في عُلاَكِ دُرَّةُ خِدْرٍ","كَرُمَتْ نَشْأَةً وَطَابَتْ جُدُودَا",31,"د",2,0],["لمعلِّم الوادي رجا","ء في نجيبٍ ولا يخيب",32,"ب",1,0],["لمعاهد الاسلام بعدك رنة","وعهود فضلك كالنجوم سواري",33,"ر",2,0],["لمعنى حباك الله بالملك ناشئا","أهل العلم في المهد مهديا",34,"ي",2,0],["لمعان الحسن وضاح السنى","بضياء الظرف غشى هيكلك",35,"ك",1,0],["لمع الصباح برونق السعد","فافاض فينا نفحة المجد",36,"د",1,1],["لمعت بوارق دولة الإرشاد","برحاب قطب الأوليا الصياد",37,"د",1,1],["لمعاليك جئت أعرض حالي","يا رسول المهيمن المتعالي",38,"ل",2,1],["لَمَعَانُ البُرُوقِ هَاجَ الهُمُومَا","ومَرَى م العُيُونِ دَمعاً جَمُومَا",39,"م",2,1],["لَمَعَ البَرقُ اليماني","فَشَجاني ما شَجاني",40,"ن",2,1],["لِمَ عافَ وِردَ الماءِ قَد ظَمِأَت لَهُ","شَفَتاهُ وَاِتَّخَذَ المَدامِعَ مَورِداً",41,"د",2,0],["لمعت جواهرُهُ فكان كليلةٍ","للنَّجمِ في آفاقِها إشراق",42,"ق",1,0],["لمعجزِهِ أَقرَّ الضدُّ عجزاً","وَظلَّت عنده الفُصحاء لُكنا",43,"ن",2,0],["لمعَت أَسِرَّةُ نوره في وجهه","فاِزورَّ عنها كُلُّ لَحظٍ أَخزَرِ",44,"ر",1,0],["لَمَعَت لَيلاً فَقالوا لَهبُ","وَصفَت لَناً فَقالوا ذهبُ",45,"ب",1,1],["لمعتْ في الشمسِ من طوقيهما","دررٌ تزري بأطواقِ الملاحِ",46,"ح",1,0],["لمعة البشر في مآقيه برق","يتندّى بالهاتن المغلول",47,"ل",1,0],["لم عنصر الأرض","يطير في الجو",48,"و",1,0],["لَمَعت بَطشاً قَواضبه","لِترى مِنهُ العِدا رُعبا",49,"ب",2,0],["لِمَعاجِ نِضْوٍ في مَحل داثرٍ","ومَجلِّ طَرْفٍ في رسومٍ هُمّد",50,"د",1,0],["لَمَعَ النُضارُ بِها فَقُلنا شَمسُها","وَجَرى اللُجَينُ فَخِلتُهُ أَمواها",51,"ا",3,0],["لمعَت سُيوفُ بَني حُميدٍ بَعدَ ما","صَدِئت وطالَ بهنَّ عَهدُ الرُّومِ",52,"م",1,1],["لمَّعَتْ وجهَها الدَّعاوىَ ولكنْ","مالها عند ربِّنا مِنْ خَلاَقِ",53,"ق",1,0],["لمعاليهِ على شأ","وِ معاليهِ الخِيارُ",54,"ر",1,0],["لِمَعْناهُ قامَ الجوّ بالرّعدِ نائحاً","وبالبرقِ مَلْطوماً وبالغيثِ باكيا",55,"ي",2,0],["لم عداني صوب كفّيك وما","زلت بالشكر لكم أطوي ضميري",56,"ر",2,0],["لِمُعْتَلِي هِمَّةٍ بَيْنَ النجومِ هَوَتْ","بِهِ النجومُ بِرُزْءٍ مَا لَهُ وَزَرُ",57,"ر",1,0],["لَمَعْتَ بِهِ فِي جوِّ ناجِرَ لمعةً","ثَنَتْ كَبِدَ الشيطانِ دامِيَةَ الجُرْحِ",58,"ح",1,0],["لمعاقلٍ من سَوسَنٍ قَدْ شَيَّدَتْ","أَيدي الربيع بِنَاءها فَوْقَ القُضُبْ",59,"ب",1,0],["لمعت كتلويح الرداء المُسبَل","والليل صبغ خضابه لم ينصل",60,"ل",1,1],["لمُعذَّلٍ في الجودِ صَوْبُ يمينه","يُزري بسيل الشاهق المُتحدر",61,"ر",1,0],["لمُعَظَّمٍ مَلأَ الزَّمانَ مَهابَةً","ذَلَّتْ لخيفَتها صُدورُ الذُبَّلِ",62,"ل",1,0],["لم على ما جناه طرفك والقلب","ولا تشتك الظباء الغيدا",63,"د",2,0],["لِمَ عَفا رَسمُ الزَيارا","تِ وَلَم رَيَّ اللِقاءُ",64,"ا",2,0],["لمعتْ فجددتِ الشجونَ وأجَّجَتْ","نارَ الهوى العذريَّ بينَ الأضلُعِ",65,"ع",1,0],["لمعتْ لي بارقاتُ المنحنى","وهي تُبدي في دجى الليلِ ابتساما",66,"م",2,0],["لمعت قبالة ناظري إنسانة","تزري بسعدي بالبها درجات",67,"ت",1,0],["لَمَعَتْ نارَ الحِمى واشَغَفي","للحِمى مذْ لَمَعَتْ نارُ الحِمى",68,"م",2,0],["لمَعَتْ له نارُ الشُؤُنِ فغابَ عن","أَجْزائِهِ حالاً وبالغَشْيِ اشْتَغَلْ",69,"ل",1,0],["لمعَتْ شمساً ولكنْ طوَتْ","كوكَباً مُنْبَجِساً عن كوكَبِ",70,"ب",1,0],["لمعادِنِ الأرزاقِ من أكْمامِه","طُرُقٌ وللبحرَيْنِ فيها مَجمَعُ",71,"ع",1,0],["لمعة بانحرافها عن ثريا","ذلك الوصف أطمعت للحريص",72,"ص",1,0],["لمعت بروق الأبرقين وقد جرت","أمطار جفن بالبكاء قريح",73,"ح",1,0],["لمعُ برقٍ إلهامُ كلِّ وليٍّ","وحي حق لسائر الأنبياء",74,"ا",2,0],["لمعْنَيَيْهِ ائتلافٌ وهْوَ قد فَتَنَ ال","أبصارَ بالحُسن والأسماعَ بالرَنَمِ",75,"م",1,0],["لمعت أسارير المليك فأوضحت","حب الفؤاد لنا بكل جلاء",76,"ا",2,0],["لمعاشرٍ غلبَ الشَّقاءُ عليهم","وهوىً أُمالَهُمُ لأَمرٍ مُتْعبِ",77,"ب",1,0],["لِمَعْهدٍ طالَما حَلَّ القُلوبُ بهِ","مُخَيِّمينَ وبانُوا عَنْ جُسومِهمِ",78,"م",1,0],["لَمَعتْ لِي بِخُلَّبِ الْوَمْضِ مِنْها","بِنَوَاحِيَّ بِهِ لِحَاظٌ سَقِيمُ",79,"م",1,0],["لمُعْتَصِمِيهَا ، لمُعْتَقَلِيهَا","لِموتٍ يَلِيقُ بِهِ شُهَدَاهَا",80,"ا",3,0],["لِمِعْرَاجِهِ حَتى رَأى مَالِكَ الْمُلْكِ","نَرُوحُ بِأشْوَاقٍ وَنَغْدُو بِمِثْلِهَا",81,"ه",2,0],["لمعَ البرقَ ولم يُروِ الحِمى","ودموعي فاض منهنَّ الفَضا",82,"ض",2,0],["لمعت وراء القارلي فحسبتها","شفقا ثوى غسقا من الأعغساقِ",83,"ق",1,0],["لَمَعَت أَشعَّتُكَ البَديعةُ في المَلا","تَجلو الهِدايَة حَيثُ زالَ ظَلامُ",84,"م",1,0],["لِمعتَ بِجيد هَذا العَصر عَقداً","وَأَنتَ بِمعصم الدُنيا سوارُ",85,"ر",1,0],["لَمَعَت أَشِعَتُهُ عَلَينا مُدَّةً","ثُمَ اِنثَنَت لِلغَيرِ بِاللُطفِ الخَفي",86,"ف",2,0],["لمعان البرق إذا أومض","أمضى بحشاي ظبا أومض",87,"ض",1,1],["لِمُعرِضِ القَوسِ وَمُستَديرِها","تَنبَجِهُ الحَيّاتُ في كُسورِها",88,"ر",3,0],["لمعاني بهاء حسنك يصبو","لا وحق الجمال يا نور عيني",89,"ي",1,0],["لُم على اللوم من عزمْ","إن تحرَّيت منعَ ذمْ",90,"م",1,1],["لمع السّيف كومض البرق في","كفّه فارتاع من في المعهد",91,"د",1,0],["لمعت من سناه لمعة قدس","غشيتهم فأغشت الأبصارا",92,"ر",2,0],["لمعة أهل الفضل كافي الذي","يطلب منه الرند والرشدا",93,"د",2,0],["لمعتْ بروقُ جيادِهمْ بطِرادهم","حتى كأَنّ على العيون بها هَبا",94,"ب",2,0],["لمَعَالِمٍ جَاشَت خِلاَلَ دِيَارِهَا","آيُ مَلاَئِكَةِ السَّمَاءِ تُسِيمُهَا",95,"م",3,0],["لمعت سِهامُ جُفونِها","لمَّا تحركت النِّبال",96,"ل",1,0],["لِمَعنىً تَرَى الأنحَاءَ مِنها ثَمَانياً","فَهَلْ هِيَ إلاَّ مِنْ جِنانٍ بِهَا الخُلْدُ",97,"د",1,0],["لَمَعَ الطَميمُ عَلَيهِمُ فَكَأَنَّهُ","خَمرٌ يُحَسَّرُ عَنهُ ثَوبُ قَتامِهِ",98,"م",2,0],["لَمَعَت لَنا بِالأَبرَقَينِ بُروقُ","قَصَفَت لَها بَينَ الضُلوعِ رُعودُ",99,"د",1,1],["لمعَ البرقُ علينا عشاءً","وكمثلِ الصبح ردَّ المساءُ",100,"ا",2,1],["لمعت بآفاق البلاد فسعرت","بالنار من اعصارها اعصارها",101,"ر",3,0],["لِمَعبَدٍ وَالسُرَيجِ