{"poems":[[53,"قضت المنازل يوم كاظمة","https://www.aldiwan.net/poem29962.html","الكامل"],[53,"ما هاج من ذي طرب مخماص","https://www.aldiwan.net/poem30179.html","الرجز"],[63,"وظلام قيد العين به","https://www.aldiwan.net/poem45729.html","الرمل"],[63,"لمعت كناصية الحصان الأشقر","https://www.aldiwan.net/poem46196.html","الكامل"],[77,"حفيد ولي الله ذي الرتبة العليا","https://www.aldiwan.net/poem35713.html","الطويل"],[77,"وجودك حي الملك والدين والدنيا","https://www.aldiwan.net/poem35717.html","الطويل"],[73,"غمرتني لك الأيادي البيض","https://www.aldiwan.net/poem11926.html","الخفيف"],[73,"أعرفك راح في عرف الرياح","https://www.aldiwan.net/poem11940.html","الوافر"],[88,"سر في حياتك سير نابه","https://www.aldiwan.net/poem44813.html","مجزوء الكامل"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[72,"بكيت ليلا بوجدي وهي تبتسم","https://www.aldiwan.net/poem19675.html","البسيط"],[29,"بانت سعاد ففي العينين تسهيد","https://www.aldiwan.net/poem6030.html","البسيط"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[89,"فجع المشرقين خطب جليل","https://www.aldiwan.net/poem44704.html","الخفيف"],[62,"لقياك من غير الزمان أمان","https://www.aldiwan.net/poem52256.html","الكامل"],[62,"هذا الزمان يزف أبكار العلى","https://www.aldiwan.net/poem52319.html","الطويل"],[61,"قل لابن حرب قد جنيت","https://www.aldiwan.net/poem51654.html","مجزوء الكامل"],[61,"عفر الظباء لدى الكثيب الأعفر","https://www.aldiwan.net/poem51686.html","الكامل"],[61,"خفقت راية الصباح وللنار","https://www.aldiwan.net/poem51827.html","البسيط"],[66,"يا سمي الذي له خبت النار","https://www.aldiwan.net/poem39534.html","الخفيف"],[97,"هذه الكعبة كنا طائفيها","https://www.aldiwan.net/poem24799.html","الرمل"],[44,"أسقى طلولهم أجش هزيم","https://www.aldiwan.net/poem30341.html","الكامل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[31,"لبس الظلام إليك مكتتما","https://www.aldiwan.net/poem42656.html","الكامل"],[48,"يا أيها المطنب ذا الغرور","https://www.aldiwan.net/poem63413.html","الرجز"],[50,"يا منظرا حسنا رأيته","https://www.aldiwan.net/poem64743.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85412","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30459","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54756","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55017","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[106,"تحيْة وقضيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179505",""],[77,"وجودك حيى الملك والدين والدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=34199",""],[113,"يا غزالا قلب مضناه ملك","https://www.aldiwan.net/poem40613.html","عموديه"],[113,"لمع الصباح برونق السعد","https://www.aldiwan.net/poem41172.html","عموديه"],[113,"لمعت بوارق دولة الإرشاد","https://www.aldiwan.net/poem41762.html","الكامل"],[113,"لمعاليك جئت أعرض حالي","https://www.aldiwan.net/poem42171.html","الخفيف"],[130,"لمعان البروق هاج الهموما","https://www.aldiwan.net/poem54745.html","الخفيف"],[230,"لمع البرق اليماني","https://www.aldiwan.net/poem14860.html","مجزوء الرمل"],[233,"لو بات من يلحي عليك مسهدا","https://www.aldiwan.net/poem32100.html","الكامل"],[268,"قلبي عليها حائم خفاق","https://www.aldiwan.net/poem35382.html","الكامل"],[295,"تذكر بالحمى رشأ أغنا","https://www.aldiwan.net/poem33152.html","الوافر"],[295,"لمن الكتائب في العجاج الأكدر","https://www.aldiwan.net/poem33273.html","الكامل"],[295,"لمعت ليلا فقالوا لهب","https://www.aldiwan.net/poem33330.html","الرمل"],[296,"ساجع حن إلى ذات جناح","https://www.aldiwan.net/poem36843.html","عموديه"],[326,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[340,"في هدأة الفكر","https://www.aldiwan.net/poem55319.html","منهوك المنسرح"],[351,"مستهام رق وانتحبا","https://www.aldiwan.net/poem40811.html","المديد"],[362,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[364,"تلك الرياض إذا تهجر حادث","https://www.aldiwan.net/poem17302.html","الكامل"],[369,"لمعت سيوف بني حميد بعد ما","https://www.aldiwan.net/poem57156.html","الكامل"],[397,"ياشذا المجد أين بغداد عنا ؟!","https://www.aldiwan.net/poem6735.html","عموديه"],[429,"أنجد الصب وغاروا","https://www.aldiwan.net/poem12645.html","مجزوء الرمل"],[429,"علمنا وقد مات الكمال التساويا","https://www.aldiwan.net/poem12769.html","الطويل"],[434,"ته فلو قستك بالظبي الغرير","https://www.aldiwan.net/poem2516.html","الرمل"],[436,"وفي غيابات أطباق الخطوب شج","https://www.aldiwan.net/poem34760.html","البسيط"],[436,"دواليك من دهر يواليك بالنجح","https://www.aldiwan.net/poem34846.html","الطويل"],[436,"جهز لنا في الأرض غزوة محتسب","https://www.aldiwan.net/poem34905.html","الكامل"],[459,"لمعت كتلويح الرداء المسبل","https://www.aldiwan.net/poem15089.html","الكامل"],[459,"جرد سيوفك للجلاد وأشهر","https://www.aldiwan.net/poem15128.html","الكامل"],[459,"يا عاقدا وضن الجمال البزل","https://www.aldiwan.net/poem16248.html","الكامل"],[462,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[466,"يا أبا إسحاق أخلا","https://www.aldiwan.net/poem60539.html","مجزوء الرمل"],[475,"هل بعد بينك من جوى لمودع","https://www.aldiwan.net/poem15216.html","الكامل"],[475,"ما لحبل الوصل قد أمسى رماما","https://www.aldiwan.net/poem15278.html","الرمل"],[480,"أسرت بدور أم بدت هالات","https://www.aldiwan.net/poem24292.html","الكامل"],[498,"طرق السر من البرهان ما","https://www.aldiwan.net/poem37802.html","الرمل"],[498,"بين النجوم وبين مسبار الضحى","https://www.aldiwan.net/poem37819.html","الكامل"],[498,"أورد الدلو لعقد الكرب","https://www.aldiwan.net/poem38069.html","الرمل"],[512,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[556,"ثوب صدق المجال فوق قميصي","https://www.aldiwan.net/poem34425.html","الخفيف"],[556,"أنا دائما يا نور كل مليح","https://www.aldiwan.net/poem34680.html","الكامل"],[556,"حرك الذت آلة الأسماء","https://www.aldiwan.net/poem34973.html","الخفيف"],[560,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"]],"verses":[["لُمَعٌ مِنَ الأَطلالِ يُحزِنُنا","مُحتَلُّها البالي وَمَألَفُها",0,"ف",3,0],["لَمعُ المَداري جُلنَ في العِقاصِ","كَأَنَّ خَفقَ الكَوكَبِ الوَباصِ",1,"ص",1,0],["لَمعَ النَّجمُ عَلى جَبهَتِها","وَتَرَدَّتْ بِجلابيبِ الدُّجَى",2,"ا",1,0],["لَمَعَتْ كناصِيَةِ الحِصانِ الأشْقَرِ","نارٌ بمُعتَلِجِ الكَثيبِ الأعْفَرِ",3,"ر",1,1],["لمَعْنَى أبي يَعْقوبَ رهْنُ ضَريحِهِ","يحِنُّ لأهْلِ اللّهِ أنْ تُعْمِلَ السّعْيا",4,"ي",2,0],["لمَعْنًى حَباكَ اللهُ بالمُلْكِ ناشِئاً","وكُنتَ بأهْلِ العِلْمِ في المَهْدِ مَهْدِيّا",5,"ي",2,0],["لُمَعٌ طَلَّةٌ مِنَ العَيشِ ما إِن","لِلهَوى عَن مَحَلَّها تَعويضُ",6,"ض",1,0],["لِمُعتَضِدٍ بِهِ أَرضاهُ سَعياً","فَأَقبَلَ وَجهَهُ وَجهَ الفَلاحِ",7,"ح",1,0],["لمع الذكاء بوجهه","كالبرق يلمع في سحابه",8,"ب",2,0],["لِمُعَفَّرٍ قَهدٍ تَنازَعَ شِلوَهُ","غُبسٌ كَواسِبُ لا يُمَنُّ طَعامُها",9,"م",3,0],["لمعشرٍ هم لمن ولاهمُ نعمٌ","هنيئة ولمن عاداهمُ نقمُ",10,"م",1,0],["لَمعاً وَإيماضَ بَرقٍ ما يَصوبُ لَنا","وَلَو بَدا مِن سُلَيمى النَحرُ وَالجيدُ",11,"د",1,0],["لَمَعَ القَتيرُ بِلِمَّتي","وَيلُ الشَبابِ مِنَ القَتيرِ",12,"ر",1,0],["لمعت نارهم وقد عسعس الليل","ومل الحادي وتاه الدليل",13,"ل",1,0],["لمعُ المكارمِ والثناءِ تقارنَا","فيها كما ضَمَّ السُّعودَ قِرانُ",14,"ن",1,0],["لمعتْ تباشيرُ العَلاء وأعرضتْ","سُحُبٌ من العِزِّ الجديد لتَهْطِلا",15,"ل",2,0],["لِمْ عِبْتَ شِعري وهو أو","ضاحٌ تَبسَّمُ أو غُرَر",16,"ر",1,0],["لمعَتْ بوارِقُه فكُنَّ سَحائباً","في معشرٍ وصَواعِقاً في معشَرِ",17,"ر",1,0],["لمَعتْ للعيونِ بعدَ اسودادٍ","فأَضاءَت حنادسُ الظَّلماءِ",18,"ا",2,0],["لِم عَكَستَ القِياسَ في نارِ قَلبي","فَإِذا ما ذُكِرتَ تَزدادُ وَقدا",19,"د",2,0],["لِمَ عُدنا أوَ لَم نَطوِ الغَرَام","وفَرغنا مِن حنينٍ وألَم",20,"م",1,0],["لَمَعَت أَسِنَّتُهُ فَهُنَّ مَعَ الضُحى","شَمسٌ وَهُنَّ مَعَ الظَلامِ نُجومُ",21,"م",1,0],["لَمعُ السُّيُوفِ وَتَصهالُ الخُيولِ بِهِ","كَالبَرقِ وَالرَّعدِ في مُغدَودِقٍ هَزِمِ",22,"م",1,0],["لَمَعَت بِأَطرافِ البَنانِ لَنا","إِنّا نُحاذِرُ أَعيُنَ الرَكبِ",23,"ب",1,0],["لَمعَ ايَواقيتِ مَعَ الشُذورِ","إِلى قَراطيمَ نِبالٍ حورِ",24,"ر",1,0],["لَمَعَت إِلَيَّ تَسومُني","لَعِبَ الشَبابِ وَقَد طَوَيتُه",25,"ت",2,0],["لمعت نارهم وَقَد عسعس اللَي","لُ وَمل الحادي وَحار الدَليل",26,"ل",1,0],["لِمُعْتَزِليِّ الرّأَىِ ناءٍ عن الهُدَى","بَعِيدِ المرامِي مُسْتَمِيتِ البَصَائِرِ",27,"ر",1,0],["لِمُعْجِزِهِ نَظْماً وَنَثْراً شَوَارِدٌ","مِنَ الفِكْرِ لَمْ تُغْلَلْ وَلَمْ تَتَقَيَّدِ",28,"د",1,0],["لِمَ عَوْدُ أُوتِللو وَعُقْبَى حَالِهِ","مَوْتُ الغَشُومِ وَصَرْعَةُ الخَدَّاعِ",29,"ع",1,0],["لمعت أنوارها للمجتلي","قوتل الإنسان كم دمر بي",30,"ي",1,0],["لَمَعَتْ في عُلاَكِ دُرَّةُ خِدْرٍ","كَرُمَتْ نَشْأَةً وَطَابَتْ جُدُودَا",31,"د",2,0],["لمعلِّم الوادي رجا","ء في نجيبٍ ولا يخيب",32,"ب",1,0],["لمعنى حباك الله بالملك ناشئا","أهل العلم في المهد مهديا",33,"ي",2,0],["لمعان الحسن وضاح السنى","بضياء الظرف غشى هيكلك",34,"ك",1,0],["لمع الصباح برونق السعد","فافاض فينا نفحة المجد",35,"د",1,1],["لمعت بوارق دولة الإرشاد","برحاب قطب الأوليا الصياد",36,"د",1,1],["لمعاليك جئت أعرض حالي","يا رسول المهيمن المتعالي",37,"ل",2,1],["لَمَعَانُ البُرُوقِ هَاجَ الهُمُومَا","ومَرَى م العُيُونِ دَمعاً جَمُومَا",38,"م",2,1],["لَمَعَ البَرقُ اليماني","فَشَجاني ما شَجاني",39,"ي",1,1],["لِمَ عافَ وِردَ الماءِ قَد ظَمِأَت لَهُ","شَفَتاهُ وَاِتَّخَذَ المَدامِعَ مَورِداً",40,"د",2,0],["لمعت جواهرُهُ فكان كليلةٍ","للنَّجمِ في آفاقِها إشراق",41,"ق",1,0],["لمعجزِهِ أَقرَّ الضدُّ عجزاً","وَظلَّت عنده الفُصحاء لُكنا",42,"ن",2,0],["لمعَت أَسِرَّةُ نوره في وجهه","فاِزورَّ عنها كُلُّ لَحظٍ أَخزَرِ",43,"ر",1,0],["لَمَعَت لَيلاً فَقالوا لَهبُ","وَصفَت لَناً فَقالوا ذهبُ",44,"ب",1,1],["لمعتْ في الشمسِ من طوقيهما","دررٌ تزري بأطواقِ الملاحِ",45,"ح",1,0],["لمعة البشر في مآقيه برق","يتندّى بالهاتن المغلول",46,"ل",1,0],["لم عنصر الأرض","يطير في الجو",47,"و",1,0],["لَمَعت بَطشاً قَواضبه","لِترى مِنهُ العِدا رُعبا",48,"ب",2,0],["لِمَعاجِ نِضْوٍ في مَحل داثرٍ","ومَجلِّ طَرْفٍ في رسومٍ هُمّد",49,"د",1,0],["لَمَعَ النُضارُ بِها فَقُلنا شَمسُها","وَجَرى اللُجَينُ فَخِلتُهُ أَمواها",50,"ا",3,0],["لمعَت سُيوفُ بَني حُميدٍ بَعدَ ما","صَدِئت وطالَ بهنَّ عَهدُ الرُّومِ",51,"م",1,1],["لمَّعَتْ وجهَها الدَّعاوىَ ولكنْ","مالها عند ربِّنا مِنْ خَلاَقِ",52,"ق",1,0],["لمعاليهِ على شأ","وِ معاليهِ الخِيارُ",53,"ر",1,0],["لِمَعْناهُ قامَ الجوّ بالرّعدِ نائحاً","وبالبرقِ مَلْطوماً وبالغيثِ باكيا",54,"ي",2,0],["لم عداني صوب كفّيك وما","زلت بالشكر لكم أطوي ضميري",55,"ي",1,0],["لِمُعْتَلِي هِمَّةٍ بَيْنَ النجومِ هَوَتْ","بِهِ النجومُ بِرُزْءٍ مَا لَهُ وَزَرُ",56,"ر",1,0],["لَمَعْتَ بِهِ فِي جوِّ ناجِرَ لمعةً","ثَنَتْ كَبِدَ الشيطانِ دامِيَةَ الجُرْحِ",57,"ح",1,0],["لمعاقلٍ من سَوسَنٍ قَدْ شَيَّدَتْ","أَيدي الربيع بِنَاءها فَوْقَ القُضُبْ",58,"ب",1,0],["لمعت كتلويح الرداء المُسبَل","والليل صبغ خضابه لم ينصل",59,"ل",1,1],["لمُعذَّلٍ في الجودِ صَوْبُ يمينه","يُزري بسيل الشاهق المُتحدر",60,"ر",1,0],["لمُعَظَّمٍ مَلأَ الزَّمانَ مَهابَةً","ذَلَّتْ لخيفَتها صُدورُ الذُبَّلِ",61,"ل",1,0],["لم على ما جناه طرفك والقلب","ولا تشتك الظباء الغيدا",62,"د",2,0],["لِمَ عَفا رَسمُ الزَيارا","تِ وَلَم رَيَّ اللِقاءُ",63,"ا",2,0],["لمعتْ فجددتِ الشجونَ وأجَّجَتْ","نارَ الهوى العذريَّ بينَ الأضلُعِ",64,"ع",1,0],["لمعتْ لي بارقاتُ المنحنى","وهي تُبدي في دجى الليلِ ابتساما",65,"م",2,0],["لمعت قبالة ناظري إنسانة","تزري بسعدي بالبها درجات",66,"ت",1,0],["لَمَعَتْ نارَ الحِمى واشَغَفي","للحِمى مذْ لَمَعَتْ نارُ الحِمى",67,"م",2,0],["لمَعَتْ له نارُ الشُؤُنِ فغابَ عن","أَجْزائِهِ حالاً وبالغَشْيِ اشْتَغَلْ",68,"ل",1,0],["لمعَتْ شمساً ولكنْ طوَتْ","كوكَباً مُنْبَجِساً عن كوكَبِ",69,"ب",1,0],["لمعادِنِ الأرزاقِ من أكْمامِه","طُرُقٌ وللبحرَيْنِ فيها مَجمَعُ",70,"ع",1,0],["لمعة بانحرافها عن ثريا","ذلك الوصف أطمعت للحريص",71,"ص",1,0],["لمعت بروق الأبرقين وقد جرت","أمطار جفن بالبكاء قريح",72,"ح",1,0],["لمعُ برقٍ إلهامُ كلِّ وليٍّ","وحي حق لسائر الأنبياء",73,"ا",2,0],["لمعْنَيَيْهِ ائتلافٌ وهْوَ قد فَتَنَ ال","أبصارَ بالحُسن والأسماعَ بالرَنَمِ",74,"م",1,0]]}