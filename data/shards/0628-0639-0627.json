=213054",""],[2110,"بعثت رسالات الدموع السواكب","https://www.poetsgate.com/ViewPoem.aspx?id=156264",""],[5794,"هلا يا صاح","https://www.poetsgate.com/ViewPoem.aspx?id=80283",""],[5829,"اليرموك في ذكرى بدء التحرير","https://www.poetsgate.com/ViewPoem.aspx?id=204254",""],[5956,"الرَّصيفُ ذو الحصى العسليّ","https://www.poetsgate.com/ViewPoem.aspx?id=184884",""],[6011,"لعمر أبيك إني ذبت وجدا","https://www.poetsgate.com/ViewPoem.aspx?id=169338",""],[6031,"أَمَوْلَى الوَرَى إنِّي جَعلْتُكَ في الذِي","https://www.poetsgate.com/ViewPoem.aspx?id=46412",""],[5309,"سلام على ذكر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""],[463,"أيقظني للبرقِ وهو نائمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60187&r=&rc=243",""]],"verses":[["بِعاداً لَمَن صاحَبتُ غَيرَ المُقَوَّمِ","وَبُعداً لِكُلِّ الرَيِّ إِلّا مِنَ الدَمِ",0,"م",1,1],["بَعاداً فَليتَ اليَمَّ دونَكَ أَزبَدا","وَلَيتَ مَكانَ الطَوقِ مِنكَ المُهَنَّدا",1,"د",2,1],["بِعارِفةٍ أريشُ بِها كَريماً","إذا طَلبَ الغِنى كرِهَ السُّؤالا",2,"ل",2,0],["بِعاداً وَإِدلالاً عَلَيَّ وَقَد رَأَت","ضَميرَ الهَوى قَد كادَ بِالجِسمِ يَبرَحُ",3,"ح",1,0],["بعادٌ وقربٌ فيهما النوحُ والبكا","أعلِّمُ وُرْقَ الطيرِ في الوَكنات",4,"ت",1,0],["بعارضيْهِ رياضُ حُسْنٍ","للنَّور مِن زَهرِها ابتسام",5,"م",1,0],["بِعاجِنَةِ الرَحوبِ فَلَم يَسيروا","وَسُيِّرَ غَيرُهُم مِنها فَساروا",6,"ر",3,0],["بِعارِضَينِ يَجولُ الطيبُ فَوقَهُما","وَمُقلَةٍ لَم يُخالِط طَرفَها قَمَعُ",7,"ع",1,0],["بِعاجِنَةِ الرَحوبِ فَلَم يَسيروا","وَآذَنَ غَيرُهمُ مِنها فَساروا",8,"ر",3,0],["بِعارِفَةٍ أَهدَت أَماناً بِمَذحَجٍ","وَغَوثاً لِمَلهوفٍ وَعَفواً لِمُذنِبِ",9,"ب",1,0],["بِعافِيَةٍ كانَت مِنَ اللَهِ جَلَّلَت","مَشارِقَها أَمناً إِلى مَغرِبِ الأُملِ",10,"ل",1,0],["بُعادي أَطمَعَ الأَعداءَ حَتّى","رَأوكَ اليَومَ خُزرَ الناظِرَينِ",11,"ن",1,0],["بعادك والذي صنعا","وهجرُك والذي ذقتُ",12,"ت",1,0],["بِعِ السَيفَ ثُمَّ اِستَجِد مِنجَلاً","وَأَبدِل بِسَوطِكَ رَفشاً وَسِر",13,"ر",1,0],["بِعادِلَةِ الإِثنَينِ عِندي وَبِالحَرى","يَكُونُ سَواءً مِنهُما لَيلَةُ القَدرِ",14,"ر",1,0],["بعارِضٍ جادَ أَوْ خِلْتَ البِطاحَ بها","سَيْبٌ مِنَ اليَمِّ أَوْ سَيْلٌ مِنَ العَرِمِ",15,"م",1,0],["بِعازِبِ حَرَّةٍ يُلفى","بِها العُصفورُ مُنجَحِرا",16,"ر",2,0],["بِعاري النَواهِقِ صَلتِ الجَبينِ","يَستَنَّ كَالتَيسِ في الحُلَّبِ",17,"ب",1,1],["بُعادٌ واقِعٌ فَمَتى التَداني","وَبَينٌ شاسِعٌ فَمَتى اللِقاءُ",18,"ق",3,0],["بِعالِجٍ باتَ هَمُّ النَفسِ يَعتَلِجُ","فهَل أَسيتَ لِعَينٍ حينَ تَختَلِجُ",19,"ج",1,1],["بِعاري النَواهِق صَلتِ الجَبي","نِ أَجرَدَ كالقَدعِ الأَشعَبِ",20,"ب",1,0],["بِعَازِبِ النَّبْتِ يَرْتَاعُ الفُؤَادُ لَهُ","رَأْدُ النَّهارِ لأَصْوَاتٍ مِنَ النُّعَرِ",21,"ر",1,0],["بعاطفٍ يتبنَّى كلَّ معتلِجٍ","خفَّاقه ويُزكّيهِ إذا انتسبا",22,"ب",2,0],["بعارِفَةٍ أهْدَتْ أمَانَاً لخَائِفٍ","وَغَوْثاً لمَلْهُوفٍ، وَعَفْواً لمُذنِبِ",23,"ب",1,0],["بعادُك أضْنانَا وهجرُك ساءَنا","وذا الصبر في هذين غيرُ مُفِيدِ",24,"د",1,0],["بعادُك يا عذبَ الثنايا ولا الصدُّ","وصدُّك يا حلوَ السجايا ولا البعدُ",25,"د",1,1],["بِعارِفَةٍ لَو عارَضَت آلَ بَرمَكٍ","لَأَكبَرَها يَحيى وَفَضلٌ وَجَعفَرُ",26,"ر",1,0],["بعاداتِ صبرٍ لم تزل تستعيدُهُ","إِلَى الحرب حتى مات صبرُ المحاربِ",27,"ب",1,0],["بِعاديةٍ كأَنَّ البِيضَ فيها","تَلهَّبُ أَو سَنا بَرقٍ عَروصِ",28,"ص",1,0],["بعارضه اقول ووجنتيه","وأجعل خضرتي آسا ووردا",29,"د",2,0],["بِعادٌ وَاِقتِرابٌ وَاِجتِماعٌ","وَتَفريقٌ وَوَصلٌ وَاِجتِنابُ",30,"ب",1,0],["بِعَالِمٍ مَا سَخَى قَطُّ الزَّمَانُ بِهِ","أَضْحَى بِصَرْفِ الْعُلاَ وَالْعِلْمِ يَسْقِيهَا",31,"ي",3,0],["بِعَادُكَ يَا مُحَمَّدُ وَهْوَ سُمٌّ","أَعَانَ الْبَثَّ وَالشَّكْوَى عَلَيَّا",32,"ي",2,0],["بعالم الأرواحِ بالملائكِ","بقائمٍ جنحَ الظلام الحالكِ",33,"ك",1,0],["بعاد على قرب وسخط على رضى","فلا أنت من يدنو ولا من نفارقه",34,"ق",2,0],["بِعَادٌ وإِعراضٌ عَلَيّ تَعَاقَبا","فيا فَاتِني بالحُسْنِ حسّنْ ليّ العُقبى",35,"ب",2,0],["بعامر شعب الصادقين عمارة ال","قلوب بغياضٍ من الفَضل غامر",36,"ر",1,0],["بِعابد الرَحمَن هنّئت يا","سميَّ مَن وَفّى بِأَبهى التَهان",37,"ن",1,0],["بِعاشقه وَلا ميل إِلَيهِ","مَحا الباري مَحاسن وَجنَتيه",38,"ه",1,0],["بِعام جَديد فيهِ قَد قَدم الهَنا","وَفيهِ يغاث الناس مِمّا يؤودها",39,"د",3,0],["بعالي القَدِّ سافِلُه وَثيقٌ","لراكبِه وعاليهِ وَطيّ",40,"ي",1,0],["بعافية عادت على مَنْ بمهجتي","إذا قبلت يفدي وحق لها الفخر",41,"ر",1,0],["بُعَادٌ وأشجان لما بمهجتي","ولو نزلا بالصخر ما احتمل الصخر",41,"ر",1,0],["بعامر عمر اللَه البلاد وقد","أحيا العباد به لما تولاها",42,"ا",3,0],["بعاد بيننا أبدا وفوتٌ","بعادَ الفضل من خَرْقٍ وأَفْنِ",43,"ن",1,0],["بعادُكِ حيث لا يرجوكِ راجٍ","كقربِك حيث لا يلقاكِ لاقي",44,"ق",2,0],["بعامٍ رطيب الجو أغنتْ رياضُه","بجوز الفلا عن مونقاتِ الحدائقِ",45,"ق",1,0],["بعامِر بيتٍ من خُزَيْمةَ شادَهُ","الدُّبَيْسانِ بالعَلْياءِ لا بالقرامدِ",46,"د",1,0],["بعادٌ مراميهم دوانٍ عيونهم","قصارٌ مواضيهم طوالُ الحمائل",47,"ل",1,0],["بِعاجِلِ المَوتِ يُدارَك بِالهَرَم","فَاتَّقِيَن مَروانُ في القَومِ السَلَم",48,"م",1,0],["بعامٍ أنشدَ التَّأريخُ فيهِ","إلى باريهِ قد ذَهَبَ الخليلُ",49,"ل",1,0],["بعالم عام في بحر العلوم فلم","يترك لمنتقد قولا ولا كلما",50,"م",2,0],["بِعالم كامل جاءَت تَراجمُه","في كُل شَيء لَنا مِنهُ بِبُرهان",51,"ن",1,0],["بعادك عن عيني وكونك ثاوياً","بمعقل شرٍّ في المعاقل مذمومِ",52,"م",1,0],["بعادي كان عذري حين أشكو","فلا تدري وقد أصبحت تدري",53,"ر",2,1],["بِعام ثَمانٍ بَعدَ ألفٍ لَقَد مَضى","كَذا مايتا عامٍ وَعُشرونَ تُحسَبُ",54,"ب",1,0],["بِعالي أُفقِها تَجلوكَ بَدراً","يسرُّ بِيمن مَطلَعِهِ الفُؤادُ",55,"د",1,0],["بِعادِلٍ مِنْهُ سِجالاً نُفَّحا","هَنَّا وَهَنَّا وَغُيُوثاً سُمَّحا",56,"ح",2,0],["بعام سعيد نور وجهكَ مشرق","قران ابتهاجك في سليم وقاسمِ",57,"م",1,0],["بعام قد كساه النور أرّخ","به فتحت بيوسفها الكنانه",58,"ه",1,0],["بعادي منه بالأرغام عني","وللأيام في الدنيا مكايدْ",59,"د",1,0],["بعادي عنكم طالا","وصبري عنكم زالا",60,"ل",2,1],["بعاطفة الرحمن عاذت حقائقي","وعمري وفقري وانقطاعي وذلتي",61,"ي",1,0],["بِعادٌ وَلا قُربٌ وَسُخطٌ وَلا رِضىً","وَهَجرٌ وَلا وَصلٌ وَعُذرٌ وَلا وَفا",62,"ف",2,0],["بعانٍ مات شكّاً ما تشكّى","وصرنا كلنا للحب ملكا",63,"ك",2,0],["بعاطلة من ليالي الحرو","ب اطلعت رأيك فيها قمر",64,"ر",1,0],["بعارضٍ للمنايا مسبِلٍ هَطِلِ","بالمَشرفِيّة والأَرواحِ مُنسَكِبِ",65,"ب",1,0],["بعاده نادي التي تتقي","وقربه لو زارني جنتي",66,"ت",2,0],["بعالِى الكُتبِ خَصَّانَا","كَلاَماً مِنهُ قُرآنا",67,"ن",2,0],["بِعانِساتٍ هَرِماتِ الأَزملِ","جُشٍّ كَبَحريِّ السَحابِ المُخيِلِ",68,"ل",1,1],["بعالي السنان نورها طيب الشذا","فتشرق أنواراً وتعبق نوارا",69,"ر",2,0],["بعام أرخوه وقد أجادوا","تنشأ للجنان فلا يراع",70,"ع",1,0],["بعارضه لامُ العذار كأنها","فواد محبٍ في هواه تلَّقا",71,"ق",2,0],["بعادك بي ضرام الوجد أوقد","فكاد يذوب فيه القلب أوقد",72,"د",1,1],["بُعَاضُ أيضاً وَكَذَا في الهَجرَه","جَاهُ أربَعٍ وَرُبعِ ياخِي مُحصَرَه",73,"ه",1,0],["بع النفس جد بالنفس كايس بها فلا","سبيل إِلى العليا لمن لا يكايس",74,"س",1,0],["بعادك شاغلي عن كل فكر","وقربك مركبي بحر الظنون",75,"ن",1,0],["بعامِلها الأرضي أبي جُمعَةَ الَّذِي","يُحبُّكَ حُبّاً لا يُكيَّفُ بالشِّعرِ",76,"ر",1,0],["بعارض جاد أَو خلت البطاح بها","طوفان نوح عليها طاف بالكرم",77,"م",1,0],["بعافية السلطان مولى الأنام قد","تهلل وجهه الدهر فهو جميل",78,"ل",1,1],["بِعابدين وَما أَدراك ما نظموا","بَعابدين وَما أَدراك ما نثروا",79,"ر",3,0],["بِعَادٌ وبَينٌ كُلُّ ذَاكَ يَهُونُ","فَهَل عَودَةٌ بَعدَ النَّوَى وسُكُونُ",80,"ن",1,1],["بِعادٌ وهجرٌ واشتياقٌ وَلَوعةٌ","وقلبٌ مراراً تَصدعونَ فيُشعَبُ",81,"ب",1,0],["بِعارِضٍ ذي بارق","يُمطِر غَيثَ النُوبِ",82,"ب",1,0],["بِعَالَمِ ذَرٍّ ألبَسَ اللهُ رُوحَهُ","نُبُوَّتَهُ فَكَانَ أوَّلَ مَن نَبَّا",83,"ب",2,0],["بعابد الرحمن نجلِ مَحْمَتْ","اجعل فعالي في الورى كلاً سمتْ",84,"ت",1,0],["بعابد الرحمن نجلِ القاضي","أعني به الفاسيَّ كن لي راضي",84,"ي",1,0],["بعابد الوهاب والجيهِ وبال","بشرا وبالمصطاف فاغفر لي الزلل",85,"ل",1,0],["بعابدِ الرحمنِ زدْ أماني","وسيدي عالِ عمِّرَنْ مكاني",85,"ي",1,0],["بعارضه لامٌ لها الحسن ينتهي","ولكنها في محنتي لام الابتدا",86,"د",2,0],["بع المهد لا تبكه اسفا","وَلَو بيع غبن بدون ثمن",87,"ن",1,0],["بِعاتِقِهِ واراهُ يَبدُو لِصدرِهِ","على حِينَ رَدَّ الخَيلَ يَجتَنِبُ اللِّقا",88,"ق",2,0],["بعادك يا معنى وجودي يبيدني","وقربك إن واصلت وصلى يعيدني",89,"ي",1,0],["بعارضٍ وعذارٍ ذاع عرفُهما","نشراً وشعر البها من قدّه نشرا",90,"ر",2,0],["بعادكم برح بي فاتقوا","اللَه وكفواً عن فؤادي الكفاح",91,"ح",1,0],["بعالي الشان مدحت الصداره","وحمدت الرئاسه والوزاره",92,"ر",2,1],["بعاد احبتي عني واني","احن إلى وصالهم حنينا",93,"ن",2,0],["بعاتقك العلى طرحت نجاداً","وعزمك قد شأى الجرد العتاقا",94,"ق",2,0],["(بعاصفةٍ) علَى أعلَى طرازٍ","يفوقُ جمالُها (علوانَ) و(المَرْ..)",95,"ر",1,0],["بعادك موت وبقربك حياتي","أرددها بعد قلبي هلابك",96,"ك",1,0],["بعام(ن)به(طغى الما)صدق قولي","كتب تاريخة ابناء الاحارس",97,"س",1,0],["بعارضك المسكي قد جن ناظري","فسلسله دمعي وكان راقيا",98,"ي",2,0],["بعارض جاد أو خلت البطاح بها","فيض تحدّر عن منهلةّ الديم",99,"م",1,0],["بِعَاطِرِ الآي فَاحَ المِسْكُ مِنْ صُحُفٍ","عَذْبًا وَرَتَّلَهُ الأَصْحَابُ بِالنّغَمِ",100,"م",1,0],["بعاداته دون الفعال تمسكوا","وذاك طعام أكله غير مسمن",101,"ن",1,0],["بعادي سيضنيه ويانفس فابلعي","وياروح جافيه عن الحب اقلعي",102,"ي",1,1],["بعادُك هيَّج الآلام عنْدي","وعكَّر عيشَتي بَعْد الصفاء",103,"ا",2,0],["بعادك والدهر الخؤون تجمعا","علي فضاقت يا أميم مذاهبي",104,"ب",2,0],["بعادولايجي ظن المسافه..الوقت او جوره","بليل نغيب عن بال التلاقي والغلا .. صداح",105,"ح",1,0],["بُعاد عزّ موطنهم فبانوا","بكل فجاج الأرض ساحوا كاليتامى",106,"م",2,0],["بعاطفةٍ للصداقة تزهو","وليست تُحَدُّ بأي مُعيقْ",107,"ق",1,0],["بعادا عاكسا آمال قري","ومولي الغمض في عيني طردا",108,"د",2,0],["بِعَادُهُمُ قُرْبٌ وفَقْرُهُمُ غِنَى","تُبَلُّ يَدِي اليُمْنَى بِهِ وشِمَالِيَا",109,"ي",2,0],["بِعاطِفَةِ الإِنسانِ يَنقادُ عَقلُهُ","وَما مِن عَظيمٍ عاشَ خِلواً مِنَ النَّقدِ",110,"د",1,0],["بعاُ رجائي بكمُ موسَّعٌ","وغصنُ عيشي في ذراكم ناعمُ",111,"م",1,0]]}