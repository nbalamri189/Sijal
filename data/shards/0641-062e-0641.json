/104333","المديد"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91111","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91928","المتقارب"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117862","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131008",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66589","المنسرح"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76451","المتقارب"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40077","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111455","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70018","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123507","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83401","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133152","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72505","الوافر"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76687","المتقارب"],[4935,"سلام الله يا ابن الأكرمينا","https://www.poetsgate.com/ViewPoem.aspx?id=129306",""],[585,"رويداً فحرب المرجفين سجال","https://www.poetsgate.com/ViewPoem.aspx?id=161916",""],[592,"بهجر أضاء الفجر واستعلن الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128846",""],[5409,"طرق الباب حالماً بلقاها","https://www.poetsgate.com/ViewPoem.aspx?id=155363",""],[5410,"هواجس على أسوار بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=152248",""],[1680,"يا من تحل بذكره","https://www.poetsgate.com/ViewPoem.aspx?id=108880",""],[6102,"كبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=184856",""],[463,"لمن دارٌ على إضم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60305&r=&rc=361",""]],"verses":[["فَخَفَّت عَلى ذاكَ أَيدي السُقاةِ","وَطابَت بِهِ أَنفُسُ الشارِبينا",0,"ن",2,0],["فَخَفِّفوا مِن أَذاهُ","إِن كُنتُمُ فاعِلينا",1,"ن",2,0],["فَخِف بَأسَها في الرَأسِ وَالرَأسُ يَصطَلي","وَخِف ضَعفَها في الكَأسِ وَالكَأسُ تُطرِبُ",2,"ب",1,0],["فخفّتْ إليها الذابلاتُ كأنها","طيورٌ إلى وكر أطلْنَ تهاويا",3,"ي",2,0],["فَخَفهُ حُرّاً رِقّا","وَخَفهُ مَلكاً عَلى العُروشِ",4,"ش",1,0],["فَخَفَّضتُ جَأشي ثُمَّ قُلتُ حَمامَةٌ","دَعَت ساقَ حُرٍّ في حَمامٍ تَنَفَّرا",5,"ر",2,0],["فَخَفَّت لَهُ خُذُفٌ ضُمَّرُح","فَأَورَدَهُنَّ قُبَيلَ الصَبا",6,"ب",2,0],["فخفقت حتى لاقرا","ر وذُبت حتى لا حراك",7,"ك",1,0],["فَخَفَقتَ مِن ذِكرى الشَبابِ وَعَهدِهِ","لَهفي عَلَيكَ لِكُلِّ ذِكرى تَخفُقُ",8,"ق",1,0],["فخَفِ الإلَهَ وما أظُنُّكَ خَائِفاً","أن تَدَّعي سُوَرَ الكِتابِ المُنزَلِ",9,"ل",1,0],["فَخَفِ اللَهَ وَاِترُكِ الزَهوَ وَاِذكُر","مَوقِفَ الخاطِئينَ يَومَ الحِسابِ",10,"ب",1,0],["فخفْتُ أنْ يكتبني منهمْ","فقالَ كُلْ قلتُ على نيَّهْ",11,"ه",1,0],["فَخِفتُ وَقَصرُ نَفسي لَكُم فيهِ","فَأَعطانيهِ ميثاقاً بِوُدِّهِ",12,"د",2,0],["فخفقٌ بالطبولِ من الملاهي","أحبُّ إليّ من عَلَمٍ خَفوق",13,"ق",1,0],["فَخَف قَولَ مَن لاقاكَ مِن غَيرِ سالِفٍ","حَميدٍ فَأَبدى بِالنِفاقِ تَشَكُّرا",14,"ر",2,0],["فَخَف دَعوَةَ المَظلومِ إِنَّ دَعاءَهُ","مُلِمٌّ بِنورَيّ الحِجابِ وَخارِقُه",15,"ق",2,0],["فخفَّت النار وقرَّ الهشيم","وعاودتني الذِّكَرُ الغابره",16,"ه",1,0],["فخفَّتْ له شِبْهَ مسحورةٍ","عَلَتْ وجهَها مَسْحَةٌ من خبالْ",17,"ل",1,0],["فَخِفافُ الأَفيالِ أَرفَقُ وَقعاً","لَو تَبَيَّنتَ مِن دَبيبِ النِمالِ",18,"ل",1,0],["فخف إلهاً عز سلطانه","وجل عن أين وعن كيف",19,"ف",1,0],["فخفّ للغياث في ليوث","صحابةٍ أهلّه غيوث",20,"ث",1,0],["فخفت يأسا أنثني راجعا","وأسكنت ما كان في صدري",21,"ر",2,0],["فَخَفَّت لَهُ خُذُفٌ ضُمَّرُ","فَأَورَدَهُنَّ قُبَيلَ الصَبا",22,"ب",2,0],["فخفّ من الجموع إليك قلبي","يرافقها وما درت الجموع",23,"ع",1,0],["فَخَفى اللَهُ في شَبابي ما آ","ن مَع الشَيب إِن أَراهُ مُلَوَثا",24,"ث",2,0],["فخف الله بمفتون متى","نظر الكوكب يزهو نظرك",25,"ك",1,0],["فخفف وامتدت هنالك بالدعا","أيادي البرايا شاكرين لها اليدا",26,"د",2,0],["فخف سيل حدوا كفه فهو مغرق","تظل الرواسي منه تسبح في بحر",27,"ر",1,0],["فخف على السلطان وزنا ولم يهن","على من عليه كان بالمدح يطنب",28,"ب",1,0],["فخف شومه يا نجل أحمد إنه","مشوم عظيم فامس منه على حذر",29,"ر",1,0],["فخفَّض الجأش منها أن ملكتُ يدَيْ","نهرٍ يَغصُّ به الواشون منْ شَرَق",30,"ق",1,0],["فَخَفَّ لِعَمِّهِ نَشوانَ جَذلاً","وَكاشَفَهُ فَلاقى مِنهُ زَجرا",31,"ر",2,0],["فَخَفَّ الشَبابُ نَدِيَّ الحَياةِ","يَستَقبِلُ الحُلُمَ المُنتَظَر",32,"ر",1,0],["فَخَفَّ اِلَيها وَفيهِ عَذابٌ","بَدا مِنه في مُقلَيته أَثَر",32,"ر",1,0],["فخفتُ أَن يُقضى عَلى عزَّتي","وَأَن يَعيثَ الخَزى لا يرتَدي",33,"د",2,0],["فَخَفِيفٌ مِنْ أَجْلِ هَذَا ثَقِيلٌ","مَنْ يَكَدْهُ يَجْعَلْهُ فِي تَضْلِيلِ",34,"ل",1,0],["فَخفَّ وشفَّ عن صبحٍ جميلٍ","كما شفَّ الحريرُ عن القدود",35,"د",1,0],["فخفَّضَ صوتَه حتى المنادي","وما جهر المؤذنُ والمتالي",36,"ل",2,0],["فخَفّفَ عنِّي وحتَّى مَتى","يُحمِّلني السرُّ أثقالَهُ",37,"ل",2,0],["فخفَّ بِها نَحوي عَلى الصوت مَعشرٌ","وقد كان مُلكُ الروم من دونِ مَعشَري",38,"ر",2,0],["فَخَفْ مولاك في الخَلواتِ واجأرْ","إليه بانْتِحابِكَ وابْتِهالكْ",39,"ك",1,0],["فخفت بنا النعماء من كل جانب","وما أنا فيما قلته بِمُغالي",40,"ل",2,0],["فخُفُّ حُنَيْنٍ فوقَ ما تَطلبونَهُ","فلِمْ بينَكمْ في ذاكَ حَربُ حُنَيْنِ",41,"ن",1,0],["فَخَفِ الله فما يَخْ","فى عَلَيْهِ مِنهُ سرُّ",42,"ر",1,0],["فخَفِّضْ من فؤادك حين يبدو","لعينك بارقٌ وتَهُبُّ ريح",43,"ح",1,0],["فخفّ ظهري منه وقلّ أذى","وِزْري فما فيّ لامرئٍ أرَبُ",44,"ب",1,0],["فخفّفَ اللّه عنه حرّ لظىً","تشفيه جمراتها من الكلب",45,"ب",1,0],["فخفْ عقبَى الغبينة فِي","يَ يومَ تفاوتِ القِيَمِ",46,"م",1,0],["فَخَفَّضتُ قَلبي بَعدَ ما قُلتُ إِنَّهُ","إِلى نارِها مِن عاصِفِ الشَوقِ طائِرُ",47,"ر",1,0],["فخف من خف منا للوغى طربا","مستسهلا حتفه مستصغر الرامي",48,"م",2,0],["فخفتُ شقاءَها بغيْر جريرةٍ","عدا أنّني كنعانُ تحتَ رِداها",49,"ا",3,0],["فَخِفتُ إِن ماتَ أَن أُقادَ بِهِ","فَقُمتُ أَبغي النَجاةَ مِن أَمَمِ",50,"م",1,0],["فَخَفِّف بالوُقُوفِ عَلى قُلوبٍ","تَفَتَّتَ حبُّها ظَمَأً وَجُوعا",51,"ع",2,0],["فَخَفِ الصَّديقَ فَكَم صَديقٍ عاجزٍ","ما نال فَتكَتَه عَدُوٌّ قادر",52,"ر",1,0],["فخفض عليك ونهنه جواك","فبدر الهداية فينا منير",53,"ر",1,0],["فَخِفتُ وَلَم أَسرقْ حاشا لأنَّه","هو البَطلُ الجنديّ ذو المَنطِقِ الشَّهدِي",54,"د",2,0],["فخفقت في القلب رايات الفرج","وامتلأ الصدر سرورا وانشرح",55,"ح",1,0],["فَخَفضتُ أَجفاني عَلى يَأس كَما","بُسِطَت يَدايَ وَفاضَتِ العَينانِ",56,"ن",1,0],["فخفتُ عيوني تغار الهوى","وتخشى منه جمال النظر",57,"ر",1,0],["فخفيت سقما من عيون عواذلي","والسقم في بعض المواضع ينفع",58,"ع",1,0],["فخفَّتْ له النفسُ تحتاطُه","كطيرٍ لأَفراخها تَغمُر",59,"ر",1,0],["فَخَفيتُ حتّى قُلتُ لَست بِظاهرٍ","وظَهرتُ مِن سَعيي على الأَوطانِ",60,"ن",1,1],["فخفف ما استطعت أذاك عني","وحاذر وقفة اليوم الرهيب",61,"ب",1,0],["فَخَفَّت إلى أغْوَارِهِ كُلُّ ضَامِرٍ","وَزَفَّتْ إلى أنجَادِهِ كُلُّ شَاحِبِ",62,"ب",1,0],["فخففوا من كربة البائسه","ومال للسلوى الفؤادُ الحزين",63,"ن",1,0],["فخفف الجور فينا","باللَه وأنس الضغينه",64,"ن",2,0],["فخفَّ الى غلسيا حيث كانت","تُقَطُّ مزابر النمسا وتبرى",65,"ر",2,0],["فَخَفِّضِ أَلهَمَّ وَاِنعَم في ذَرى مَلِكٍ","وَاِعفِ الرَكائِبَ مِن حِلٍّ وَمُرتَحَلِ",66,"ل",1,0],["فَخَفِّض عَليكَ الهَمَّ تَحظَ بِراحَةٍ","فَما نالَ خَفضَ العَيشِ إِلّا المُسالمُ",67,"م",1,0],["فخف سيفه في أسود النقع أحمراً","وخذ سيبه في أشهب الجدب أخضرا",68,"ر",2,0],["فخفتُ على نفسي لسبحة وجهه","فجاد على نفسي بأخضَرَ ماءِ",69,"ا",2,0],["فخفت عليها العين من كلّ عاشقٍ","وقد عبتها كذباً يكون لها عوذه",70,"ذ",2,0],["فَخَفَّضتها مِنّي بِقَولٍ فَراجَعَت","هَماهم مِنها بَينَهُنَّ خُروقُ",71,"ق",1,0],["فخفف ثقل ما بي ان فعل الصبا","بة عاد في قلبي مشدد",72,"د",1,0],["فخف بنو لبنان من كل جانب","اليه وكان الوفد يتبعه الوفد",73,"د",1,0],["فخفت ان اجبته لذلك","ان يظهر التأليف ما هنالك",74,"ك",1,0],["فُخفنقتُ من قول الصغار بعبرةٍ","كاد الفؤادُ لَقولِهم يتصدعُ",75,"ع",1,0],["فخفف من حماسك بعض شيء","ووفره ليوم وغى وباس",76,"س",1,0],["فخفِّض عليك الشأن لا يردِكَ الهوى","فليس انتقال خلَّةٍ ببديع",77,"ع",1,0],["فخفَّ لينظرَ الآسادَ جهراً","وخيرٌ مِن تَسمُّعكَ العيانُ",78,"ن",1,0],["فخفاف باقتصادهم","نصلوا مما يعانونا",79,"ن",2,0],["فَخف سهلهم فَالسَهل صَعب مَتى عَدا","كَذا الصلّ يُردي وَهم جسم خبرنج",80,"ج",1,0],["فَخفف رحالك إِنّ المَدا","مَديد وَداراً ترجّي شحيط",81,"ط",1,0],["فخفض يا فؤاد عليك واصبر","فما الموتور قبلك مستقيد",82,"د",1,0],["فخففتم اثقال حرب مبيدة","وقللتم الارزاء بالنعم الكثر",83,"ر",1,0],["فَخَفِّفِ الآنَ عَن فُؤادِ فَتىً","عَلَيهِ شُغْلٌ مِن حُبِّهِ شاغِلْ",84,"ل",1,0],["فخفف خطاك وكن عضدي","وَجذ بعزمك هَذا الرسن",85,"ن",1,0],["فَخفَّ إحداهما عَن وَزْنِ صاحِبِهِ","فَحَطَّ فوق الذي قد خفَّ قيراطا",86,"ط",2,0],["فخف في صدر السرى إليه","بعدةٍ تألقت عليه",87,"ه",1,0],["فخف هكطور وفوراً طعنا","لكن أفطميذ في الحال انحنى",87,"ن",2,0],["فخف نحو الفلك بالجياد","مرتعداً منخلع الفؤاد",87,"د",1,0],["فخف نحوه وصاح ادن ترى","يا أنطلوخ الصادع المفطرا",87,"ر",2,0],["فَخَفُّوا لِخَيمَةِ سَيِّدِهم","بِهِ يَدخُلُونَ بِسُودَدِهِم",88,"م",1,0],["فَخَفَّ وَأَحيَا خَفقَ أَكبادِ قَومِهِ","وَحَفَّ بِهِ مِن صَفوَةِ الصِّيدِ مَوكِبُ",89,"ب",1,0],["فخفت تحاذيه ومنها تزلفاً","تدور على أعطافه الكف والزند",90,"د",1,0],["فخف ومريون في الإثر خف","كربٍّ وللجيش جيشٌ زحف",91,"ف",1,0],["فخف أخيل كطيرٍ يدف","على بعد مرمى الرماح يزف",92,"ف",1,0],["فَخفير طوبيا دعاهُ مشجعاً","لا تخشَ ان جَيش المنية هوّلا",93,"ل",2,0],["فخفف خمسينا لخمس اشارة","لأن جزاء العشر عشر فلا نقصا",94,"ص",2,0],["فخفَّت إِلى الجيران تَلتَمِس النَدى","وَلم يَك فيهِم ذا نَدىً غير باخِلِ",95,"ل",1,0],["فخف واشتغل بالنفس زك فعالها","وهذا أهم ما خلقت لأجله",96,"ل",2,0],["فخفت من الشرار على ضلوعي","والمجلة التي",97,"ي",1,0],["فخف وشامخه ثابت","وجف وريحانه مخصب",98,"ب",1,0],["فخفف ما استطعت الأمر وأرحل","إلى انكلترا وأرحم بنينا",99,"ن",2,0],["فخف نظرة الجلاد وهو محملق","وفي يده البتار فيه صقال",100,"ل",1,0],["فخفهم وجانبهم ولا تأمننهم","وألف بني الأحرار إذ هم لك الجند",101,"د",1,0],["فخف الله إن تدن فيه أو عش","عيش حر إن لم يكن لك دين",102,"ن",1,0],["فخَفِّفْ عنكَ يا قلبي لهيفاً","وقُُلْ لهواكَ إنَّ غداً قريبُ",103,"ب",1,0],["فخفي لطفك يستعا","ن به على الزمن المعاند",104,"د",1,0],["فَخَفَضتُ - رُغمَ الجَهدِ - عَينِي فانثَنَتْ","فِي خَصرِها فاهتَزَّتِ الأَشواقُ",105,"ق",1,0],["فخفْ عقبى الغبينة فيَّ","يومَ تفاوتِ القيمِ",106,"م",1,0]]}