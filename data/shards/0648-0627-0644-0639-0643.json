{"poems":[[136,"عطف الزمان على ظرف المكان بدا","https://www.aldiwan.net/poem54676.html","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2296,"","https://poetry.dctabudhabi.ae/diwan/poem/138927","الرجز"],[3419,"","https://poetry.dctabudhabi.ae/diwan/poem/130745","الرجز"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[5956,"تعبتُ من ابتسامي","https://www.poetsgate.com/ViewPoem.aspx?id=183898",""],[5961,"الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=199835",""]],"verses":[["والعَكسُ بِالعَكسِ والصَّبَانُ جَاءَ بِذَا","وَضَّاحُ مَا مِن عَوِيصِ العِلمِ قَد شَرَدَا",0,"د",2,0],["والعكس في الأعلام من سواها","كحازم أطلق من رواها",1,"ه",2,0],["والعكس من علن يليه متفا","عنه مفاعلتن اجعل خلفا",2,"ف",2,0],["وَالعَكسُ أيضاً مِثلُ ذَا فإذَا هُمَا","اتَّحَدَا اعتبَاراً لَم يَكُن شَيئَانِ",3,"ن",1,0],["وَالعَكسُ أيضا ثابِتٌ فَسُفُولهُُ","وَخَفَاؤهُ إذ ذَاكَ مُصطَحِبَانِ",3,"ن",1,0],["وَالعَكسُ عِند سِوَاهُ فِي الأمرَينِ يَا","مَن يَهتَدِي هَل يَستَوِي النَّقلاَنِ",3,"ن",1,0],["والعكس أيضا مثل حوا أمنا","هي أربع معلومة التبيان",3,"ن",1,0],["والعكس والرجوع والايهام","واللف والنشروالاستخدام",4,"م",1,0],["والعكس لازمٌ لغير ما وجد","به اجتماع الخسّتين فاقتصد",5,"د",1,0],["والعكس في مرتب بالطبع","وليس في مرتّب بالوضع",5,"ع",1,0],["والعكس للسالبة الكلية","كنفسها في الكم والكيفية",6,"ه",1,0],["والعكس في الموجهات الموجبة","قرر كيفما الدليل أو جبة",6,"ه",1,0],["والعكس في السالبة الموجهة","عين كيفما الدليل وجهة",6,"ه",1,0],["والعكس للعامتين قررا","عرفية تعم فيما سطرا",6,"ر",2,0],["والعكس للخاصتين جعلا","عرفية تعم أيضا مسجلا",6,"ل",2,0],["والعكس أيضاً صائبٌ ، وتوازنٌ","يسري بنا في شدَّة ورَخاءِ",7,"ا",2,0],["والعكس ايضا وهو موضع خوفهم","فله المشيئة مطلقا يا غادي",8,"د",2,0]]}