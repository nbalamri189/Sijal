ى وَتَرِ الَيأسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86326&r=&rc=9",""],[6213,"شجون عاتية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85497&r=&rc=100",""],[5190,"عدتَ يا يوم مولدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85047&r=&rc=122",""],[5064,"في رثاء ملك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87519&r=&rc=14",""]],"verses":[["لَم تُبَقِّ يا فَتى المَحامِدِ مالاً","فَلَقَد كُنتَ مُغرَماً بِالهِباتِ",0,"ت",1,0],["لَم تَبدُ بارِقَةٌ في أُفقِ مُنتَجَعٍ","إِلّا وَكانَ لَها بِالشامِ مُرتَقِبُ",1,"ب",1,0],["لَم تُبقِ جارِحَةً بِالهَجرِ مِن جَسَدي","إِلّا خَلَعتَ عَلَيها بِالضَنى حُلَلا",2,"ل",2,0],["لم تُبق ليل أملاً وما بُلِّغتُهُ","بُلّغتَ ما ترجو من الآمالِ",3,"ل",1,0],["لَم تُبَيِّن عَن أَهلِها الأَطلالُ","قَد أَتى دونَ عَهدِها أَحوالُ",4,"ل",1,1],["لَم تَبقَ أَنفُسُهُم وَكا","نوا زينَةً لِلناظِرينا",5,"ن",2,0],["لم تبقَ أرضٌ قد زكَا زَرعها","حتَّى طواها ثمَّ ردَّ السبخ",6,"خ",1,0],["لمْ تبعْ طيب عيشةٍ بفضولٍ","دُوَنها خبثُ عيشةٍ كدْراءِ",7,"ا",2,0],["لم تُبْلَ مذ خُلقتْ نفوسُ ذوي الهوى","يوماً بمثل ترحُّلٍ وذَهابِ",8,"ب",1,0],["لَم تُبقِ أَرجالُ الدَبى في أَرضِهِم","ما يُستَظَلُّ بِهِ وَلا ما يُؤكَلُ",9,"ل",1,0],["لم تبق عين ما بكت في موته","حزنا على خلق عفا وصلاح",10,"ح",1,0],["لم تبلغ من الرسالة شيئاً","غير الهام قلبك الخفاق",11,"ق",1,0],["لم تبق للايام من هبة فقد","تعطى اليمين فتسترد شمالها",12,"ل",3,0],["لم تبق من ماء جمعت زلاله","في الحوض إلا هذه الأوشال",13,"ل",1,0],["لم تبق في تلك الديار أمامهم","إلا نساء الحيِّ والولدان",14,"ن",1,0],["لم تبك من ذكرى طلو","ل قد عفت وأرسم",15,"م",1,0],["لَم تَبدُ لِلأَبصارِ إِلّا غارِساً","لِخَوالِفِ الأَجيالِ أَو بَنّاءَ",16,"ا",2,0],["لَم تَبغِ دُنيا طالَما أَغضى لَها","حُمسُ الدُعاةِ وَطَأطَؤوا العِرنينا",17,"ن",2,0],["لَم تُبالِ النُيوبَ في الهامِ خُشناً","وَتَعَلَّقَت بِالحَواشي النَواعِم",18,"م",1,0],["لم تَبقَ منَّا ، يا فؤادُ ، بقيّةٌ","لفتوّةٍ ، أَو فَضلةٌ لعِراكِ",19,"ك",1,0],["لَم تُبقِ مِنهُ رَحى الوَقائِعِ أَعظُماً","تَبلى وَلَم تُبقِ الرِماحُ دِماءَ",20,"ا",2,0],["لَمْ تُبْلِ جِدَّةَ سمرهم سُمْرٌ ولَمْ","تَسِمِ السَّمُومُ لأُدْمِهِنَّ أَدِيما",21,"م",2,1],["لَمْ تَبْلُ عينُكَ أَبْيَضاً في أَسْودٍ","جَمَعَ الجمَالَ كوَجْهِهَا في شَعْرِهَا",22,"ر",3,0],["لَم تُبقِ إِلّا قَليلَ عافِيَةٍ","قَد وَفَدَت تَجتَدِيكَها العِلَلُ",23,"ل",1,0],["لَم تَبلُغِ الحَقَّ وَلَم تُنصِفِ","عَينٌ رَأَت بَيناً فَلَم تَذرِفِ",24,"ف",1,1],["لَم تَبلُغِ المِعشارَ مِن حَقَّيهِما","فَقدُ الشَبابِ وَفُرقَةُ الأَحبابِ",25,"ب",1,0],["لَم تَبكِ نَفسَكَ أَيّامَ الحَياةِ لِما","تَخشى وَأَنتَ عَلى الأَمواتِ بَكّاءُ",26,"ا",2,0],["لَم تُبقِ مِنها الأَرضُ غَيرَ جَماجِمٍ","بيضٍ تَلوحُ وَأَعظُمٍ نَخِراتِ",27,"ت",1,0],["لِم تَبخَلينَ عَلى فَتاً","مَحضَ المَوَدَّةِ وَالصَفاءِ",28,"ا",2,0],["لَم تُبقِ مِنّي إِلّا القَليلَ وَما","أَحسَبُها تَترُكُ الَّذي بَقِيا",29,"ي",2,1],["لَم تَبغِ هِمَّتُكَ المَحَلَّ العالي","إِلّا وَأَنتَ مُوَفَّقٌ لِكَمالِ",30,"ل",1,1],["لَم تَبتَذِل مِنهُ النُفوسُ سِوى","ما نالَ مِن وَجَناتِهِ اللَحظُ",31,"ظ",1,0],["لَم تَبِعهُم مِنهُم كِباراً وَلا صَدَّ","عتَ حَبَّ القُلوبِ بِالتَفريقِ",32,"ق",1,0],["لَم تَبقَ مُشرِكَةٌ إِلّا وَقَد عَلِمَت","إِن لَم تَتُب أَنَّهُ لِلسَيفِ ما تَلِدُ",33,"د",1,0],["لم تبقِ للناظمينَ الناثرينَ مدى","إلا سبقْتَ إليهِ تخرقُ الحُجُبا",34,"ب",2,0],["لم تُبْقِ من “نُقلٍ” يسرُّكِ","لم تَجِئْهُ .. ومن إدَامِ",35,"م",1,0],["لِم تَبوإِينَ بِاِثمِهِ","تائِباً غَيرَ واغِمِ",36,"م",1,0],["لَم تَبلُغِ البابَ حَتّى قالَ نِسوَتُها","مِن شِدَّةِ البُهرِ هَذا الجَهدُ فَاِتَّئدا",37,"د",2,0],["لَم تَبقَ في خِدرِها بَيضاءُ ناعِمَةٌ","مِنَ العذارى وَلا العوذِ المَطافيلِ",38,"ل",1,0],["لَم تَبدُ آمالُ الشُعوبِ بِعَيلَمٍ","إِلّا اِختَفَت آجالُها في عَيلَمِ",39,"م",1,0],["لَم تُبقِ لِلهَيمان لَواعِجُ","النيران قَلباً صَحيح",40,"ح",1,0],["لَم تُبَلِّغنِيَ السَعادَةَ بَعدُ","قُبلَةٌ إِنَّما وِصالِيَ وَعدُ",41,"د",1,1],["لم تَبْكِ للأَرْضِ السماءُ به ولا","رَقَّتْ لِشائِمِها البروقُ الخلَّبُ",42,"ب",1,0],["لَمْ تُبْقِ ذِكْراً لِذِي نُطْقٍ فَصاحَتُهُ","وهلْ تُضيءُ مَعَ الشِّمْسِ القناديل",43,"ل",1,0],["لَمْ تُبْقِ للشِّرْكِ مِنْ قَلْبٍ وَلا سَبَبٍ","إلاَّ غَدَا وَهْوَ مَتْبُولٌ وَمَبْتُولُ",43,"ل",1,0],["لَم تُبقِ مِن جَزلِها","شَيئاً وَلا شَختِها",44,"ت",3,0],["لَم تَبلُغِ الآرابَ شِدَّةُ ساعِدٍ","ما لَم يُعِنها اللَهُ بِالإِسعادِ",45,"د",1,0],["لَم تُبدِ لي عَنكَ إِلّا مُجَمَّلاً خَبَراً","وَقَد شَرَحتَ لِغَيري مُوَضِحاً جُمَلَك",46,"ك",1,0],["لم تَبْقَ في الشطِّ منهمو قَدَمٌ","قد خوَّضوا في العباب وانتثروا",47,"ر",3,0],["لم تبصرِ الأممُ الحياةَ على سنىً","كالنار في شَفَقِ الدماءِ القاني",48,"ن",2,0],["لم تبن بالصفاح والصوان","ولا علت تعاليَ الإيوان",49,"ن",1,0],["لَمْ تُبْقِ مِنِّي صَدَمَاتُ الْهَوَى","غَيْرَ صَدىً بَيْنَ حَشاً مُحْرَقِ",50,"ق",1,0],["لَمْ تُبْنَ قَافِيَةٌ فِيهِ عَلَى خَلَلٍ","كَلَّا وَلَمْ تَخْتَلِفْ فِي رَصْفِهَا الْجُمَلُ",51,"ل",1,0],["لَمْ تَبُتِّي الذِّمَامَ أَخْفَرَهُ المَوْ","تُ وَلَمْ تَصْرِمِي حِبَالَ القَرِينِ",52,"ن",1,0],["لَمْ تُبْقِ بَيْنَ أَخٍ وَبَيْ","نَ أَخٍ لَهُ فِي العُرْبِ صَدَّا",53,"د",2,0],["لم تبق لي من، سوى رمق","متراوح في أضلع همد",54,"د",1,0],["لم تبق للزهر والطي","ر من شذا وصداح",55,"ح",1,0],["لم تبد أنجمُهُ لترسل ضوءَها","لكن لتشهده من الشهّاد",56,"د",1,0],["لم تبقَ لولا فرطُ عزمِك ريبةٌ","أن العراق يسير نحو تَباب",57,"ب",1,0],["لم تبع شعبك لو أنصفته","فمن الشَّعب قبضت الثّمنا",58,"ن",2,0],["لم تبق لي مني ، سوى رمق","متراوح في أضلع همد ...",59,"د",1,0],["لم تبلغِ البابَ حتى قال نسوتها،","مِنْ شِدَّة ِ البُهْرِ هذا الجَهْدُ فَکتَّئِدا",60,"د",2,0],["لم تبدُ للأبصار إلا غارساً","لخالفِ الأجيالِ أو بنَّاءَ",61,"ا",2,0],["لَمْ تَبْقَ إلاَّ ليلةٌ أحْيا بِها","وأُحِسُّ أنَّ ظلامَها أكفاني",62,"ن",2,0],["لَم تَبقَ لي الأَيام إِلا مَن لَهُ","أَسعى بِخَير وَهُوَ في أَتلافي",63,"ف",2,0],["لم تبق قط مع الخيانة نعمة","فلتذكر الاشباه والامثال",64,"ل",1,0],["لَم تُبقِ في بَكرٍ لِرَبِّ هُنَيدَةٍ","بَكراً وَلا لِبَني عَتودَ عَتودا",65,"د",2,0],["لم تبق غير بلاقع منهوبة","وأرامل تحنو على أيتام",66,"م",1,0],["لم تبق معلوةٌ إلاَّ خصصت بها","في العلم والفضل والإقدام والكرمِ",67,"م",1,1],["لم تبق آباء إسمعيل مفتخراً","من البرايا لملك شط أو قربا",68,"ب",2,0],["لَم ت