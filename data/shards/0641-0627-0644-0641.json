ً لَاِقتَحَم",4,"م",1,0],["فَأَلفَيتَ مِلءَ الثَوبِ نَفساً طَموحَةً","إِلى المَجدِ مِن أَطمارِها تَتَطَلَّعُ",5,"ع",1,0],["فَأَلفَيتُ نادِيَها زاهِراً","وَأَلفَيتُ ثَمَّ نَعيماً ثَوى",6,"ا",1,0],["فَأَلِّف ذاتَ بَينِهِما بِرَأيٍ","وَعَزمٍ لا يَكِلُّ وَلا يَمَلُّ",7,"ل",1,0],["فَأَلفَيتُهُ يَهوى النَدى فَتَرُدُّهُ","عروقٌ إِلى أَخوالِهِ الزرقِ تَنتَمي",8,"م",2,0],["فالفلك تجري كما الأفلاك جارية","بحرُ السماء وبحرُ الأرض أشباهُ",9,"ا",2,0],["فالفتحُ بين معجّلٍ ومؤجلٍ","يُنسيك ماضيَه الذي يستقبلُ",10,"ل",1,0],["فالفكر منك كأبعاد الفضاء بلا","حدٍّ يسابق خطف البرق في الطلق",11,"ق",1,0],["فالفنّ مقياس الحضارة عند مَن","حازوا الرُقِيَّ وناطَحوا العَيُّوقا",12,"ق",2,0],["فالفضل مقتبلٌ بغير معارضٍ","والمجد منفردٍ بغير قرين",13,"ن",1,0],["فألَّفت منه إذ تجمَّع وحشُهُ","وهنَّ رُتوعٌ بالفلا وكوانس",14,"س",1,0],["فالفَظْ بِدُرِّ نثيرٍما له صدف","ألفَظ بدر نظيم ما له صدف",15,"ف",1,0],["فَأَلفى القَومَ قَد شَرِبوا فَضَمّوا","أَمامَ الماءِ مَنطِقُهُم نَسيفُ",16,"ف",1,0],["فَألفَيتُ أَعلى الناسِ قَدراً وَسُؤدُداً","وَعَدلاً فدَتهُ النَفسُ صدقاً بِلا كَذبِ",17,"ب",1,0],["فالفلك في تيار بحر زاخر","والموج حول الفلك كالاطواد",18,"د",1,0],["فَالفَخرُ عَن تَقصيرِهِ بِكَ ناكِبٌ","وَالمَجدُ مِن أَن تُستَزادَ بَراءُ",19,"ا",2,0],["فألف بينهم تظفر وتخرج","غوامض سرنا الخافي الدفينِ",20,"ن",1,0],["فَالفِعلُ فَوتَ القَولِ إِن فاضَ في","عارِفَةٍ وَالجودُ فَوتَ الجِدَه",21,"د",2,0],["فأَلفَيْتُ الأميرَ أليفَ مَجْدٍ","مُعَنَّىً بالمَكارِمِ مُستَهاما",22,"م",2,0],["فَالفَضلُ في حُسنِ لَفظٍ","يَقِلُّ فيهِ الفُضولُ",23,"ل",1,0],["فَالفِكرُ في ضَميري","وَالذِكرُ في لِساني",24,"ن",2,0],["فألفينا لديكم ألفَ عيدٍ","تُنَسّينا الأحبةَ والديارَا",25,"ر",2,0],["فالفحمُ يبقى زمانا","والجمرُ يفنى قريبا",26,"ب",2,0],["فَأَلفَت لَها مِن خالِصِ الوُدِّ وَالهَوى","جَديداً عَلى شَحطِ النَوى لَيسَ يَخلَقُ",27,"ق",1,0],["فالفيلَ تَقْتُلُه الأَفْعَى بِأَصْغَرِها","فيها ولم تخشَهُ منْ سِنِّها الصِّغَرُ",28,"ر",1,0],["فألفوه لا الدنيا تميل به ولا","كرائم ما تحوي عليه كرائم",29,"م",1,0],["فالفَيْءُ لا مُتَنَقِّلٌ والحوضُ لا","مُتَكَدِّرٌ والمَنُّ لا مَمنون",30,"ن",1,0],["فالفَتْحُ من أوَّل النعمى به ولَهُ","عَواقبٌ في بَني مَروانَ عن عَجَل",31,"ل",1,0],["فَأَلفَيتُ الأَمانَةَ لَم تَخُنها","كَذَلِكَ كانَ نوحٌ لا يَخونُ",32,"ن",1,0],["فَأَلفَيتُهُ يَوماً يُبيدُ عَدوَّهُ","وَبَحرَ عَطاءٍ يَستَخِفَّ المَعابِرا",33,"ر",2,0],["فَأَلفَيتُ البَهائِمَ لاعُقولٌ","تُقيمُ لَها الدَليلَ وَلا ضِياءُ",34,"ي",3,0],["فَالْفَتَى مَتَى","ذاقَها انْشَرَحْ",35,"ح",1,0],["فَأَلْفَيْتُ أَنْ لاَ حَيَّ إِلاَّ مُعَذَّبٌ","وَأَشْقَى ذَوِي الآلامِ مَنْ يَتَعَقَّلُ",36,"ل",1,0],["فَالْفَضْلُ مَنْقَصَةٌ لَهُ","وَخِلاَلُهُ الحُسْنَى عُيُوبُ",37,"ب",1,0],["فألفاك ميمونَ النقيبةِ كالذي","عُرفتَ به في أوّلٍ وأخير",38,"ر",1,0],["فألفت ما بين الظبا وجفونها","وقد أوحشت منهم جفون وأغماد",39,"د",1,0],["فألّف على الإسلام دنيا تمزّقت","إلى أمم مقهورة وشعوب",40,"ب",1,0],["فالفَخْرُ عَن تَقصِيرِهِ بكَ ناكِبٌ","والمَجْدُ مِنْ أنْ يُسْتَزادَ بَراءُ",41,"ا",2,0],["فالفت عنانك للمحبة والتفت","عن غيره يا من له اذعان",42,"ن",1,0],["فالفضل اثوابي ورثت قديمها","وشمائل الآناء في الاولاد",43,"د",1,0],["فألفيتني وسنانة تحت وارف","من الظل في أكنافه الزهر يبسم",44,"م",1,0],["فالفضلُ يشهد لي بأنك واحدٌ","فينا وأنك أنت نعمَ المقتنّى",45,"ن",2,0],["فَألَّفَ في شَأنِهِ دَفتَراً","وزَحرَفَ في نَعتِهِ زُخرُفَا",46,"ف",2,0],["فالفضل والمجد والإسعاد حلّ بهِ","والأنس والبشر والإفضال والجودُ",47,"د",1,0],["فالفوز فوز جنابهم ولهم من","المحبوب خير كرامة بمآب",48,"ب",1,0],["فالفضلُ فيه خليقة من أصلِ","خليقته الكريمةِ ليس فيه بمجتلب",49,"ب",1,0],["فألفوك أهدى في الفيافي من القطا","وأصبر من ضبٍّ على الماء صاديا",50,"ي",2,0],["فالفوه يسمو الضب صبرا على الظما","ويهدى القطا في البيد إن ضلت السبل",51,"ل",1,0],["فالفسح منك له عطاء صائن","للنفس منه فجد له بصيان",52,"ن",1,0],["فأَلفَيتُ قَوماً إِن طَلَبتَ اِنبِعاثَهُم","لِيَومِ سِبابٍ فَاِدعُ بِالخَيلِ وَالرَجلِ",53,"ل",1,0],["فَأَلفَت رِجالاً بِالكَمالِ تَزَيَّنوا","وَبِاللُّطفِ وَالآداب وَالشِّيَمِ الغرّا",54,"ر",2,0],["فالفرج تستره والعين تغمضها","والقلب تحرسه ممّا يخامره",55,"ر",2,0],["فالفرع من سَبَجٍ والخد من ضَرَجٍ","والطَّرف من غنجٍ يلقاك وسنانا",56,"ن",2,0],["فالفقر بي حاشاك اودى بالحشا","قسما وقد اعيا الطبيب علاجي",57,"ج",2,0],["فألفيت الخريف جنى عليها","جنايتهُ على الدوح الوريق",58,"ق",1,0],["فَالفَقيرُ جاءَ لهُ","في ديارهِ النَشبُ",59,"ب",1,0],["فالفخر عندك موروث ومُكْتَسَب","وعند غيرك مكذوب ومسروق",60,"ق",1,0],["فالفَرْعُ ليس يُخالفُ الأَصلَ الذي","منه ابْتَدا نَبْتاً وعنه تَفَرّعا",61,"ع",2,0],["فَالْفَضْلُ لاَ يَعْدُوهُمُ","وَهُمُ لاَ يَعْدُونَهْ",62,"ن",2,0],["فألفيت مني الحمد والشكر والثنا","عليك مدى الأيام ليس بذاهب",63,"ب",1,0],["فالفضلُ منكِ يُساوي فضلنا أبداً","ولا يُعَدُّ ظلوماً مَن يُساويك",64,"ك",1,0],["فالفضلُ كلُّ الفضلِ للحُسنِ الذي","أمسى بهِ روضُ الفنونِ نَضيرا",65,"ر",2,0],["فالفأل فيهم سَعيد","وَالطالِعات سعود",66,"د",1,0],["فالفخر مفتخر وَفيك فخاره","وَالجود مَوجود منك غمائمه",67,"م",2,0],["فَالفَرعُ مِنهُ عَناقيدٌ وَوَجنَتُهُ","تُفّاحُ لُبنانَ وَالنَهدانِ رُمّانُ",68,"ن",1,0],["فَالفَألُ أَخبَرَ عَن صَلاحٍ كامِلٍ","لِلعالَمينَ وَذاكَ أَصدَقُ مَخبَرِ",69,"ر",1,0],["فَالفاضِلُ المُشتَري في","كيوانَ وَالمَرّيخِ",70,"خ",1,0],["فألفيت صحبي قد شتتوا","وقد راح بعض وما ودعوا",71,"ع",3,0],["فالفَضلُ في الحالين له","وَوصلُ من تَهوى صِلَه",72,"ه",1,0],["فالفُحشُ في المزاحِ","ضربٌ من التَلاحِ",72,"ح",1,0],["فَالَفَهُم وَخالَفَ مِن مَعَدٍّ","وَنارُ الحَربِ تَستَعِرُ اِستِعارا",73,"ر",2,0],["فَأَلفَيتُهُ مُرِّ المَذاقِ عَنِ الصَبرِ","وَما ضِقتُ ذِرعاً ما غَدَوتُ مُعرِضاً",74,"ض",2,0],["فَالفَضلُ أَشهَرُ مِن أَنا نَبينِهِ","وَالخَلقُ أَعظَمُ مِن أَنا نُضاهيهِ",75,"ي",2,0],["فَالفَوز هَلّل بِالسَعادة مُقبِلاً","وَالضدّ وَلّى بِالشقاوة مُدبِرا",76,"ر",2,0],["فآل فلاح أفلح الناس كلِّهم","ومن يأتهِم يُمسِ به عُسرهُ يُسرا",77,"ر",2,0],["فَأَلفَيتُه بُستان فَضل تَرَنمت","بِه صادِحات العلم خَير تَرنم",78,"م",1,0],["فالفَضْلُ يا ابْنَ الفَضْلِ صاحبُهُ","قَمِنٌ بأَنْ تُرعَى لهُ الذِّمَم",79,"م",1,0],["فألّفتَ شاردَ أبنائها","وشَرّدتَ آلِفَ مُرّاقها",80,"ق",3,0],["فالفَجرُ يَطلُع كاذباً أو صادِقاً","ما زال قُدّامَ النّهارِ الماتع",81,"ع",1,0],["فألفاظُه طُرّاً ع