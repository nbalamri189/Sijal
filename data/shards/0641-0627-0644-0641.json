1.html","الطويل"],[318,"شكرا بالنصر عين العز ترقبكم","https://www.aldiwan.net/poem67182.html","البسيط"],[351,"بالفتح لاح لنا الهناء مبشرا","https://www.aldiwan.net/poem40350.html","الكامل"],[357,"أتى من أريج النصر ما يشرح الصدرا","https://www.aldiwan.net/poem810.html",""],[359,"بروضة هذا النظم نزهت ناظري","https://www.aldiwan.net/poem68054.html","الطويل"],[362,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[362,"رمين القلوب بأشواقها","https://www.aldiwan.net/poem60835.html","المتقارب"],[362,"أوجست من جمر بخدك ساطع","https://www.aldiwan.net/poem60852.html","الكامل"],[362,"أأحبابنا قد شقتمونا فأسعدوا","https://www.aldiwan.net/poem60942.html","الطويل"],[362,"نزل الأحبة خطة الأعداء","https://www.aldiwan.net/poem61017.html","الكامل"],[369,"أرى في عراصي راكبا مترنما","https://www.aldiwan.net/poem57161.html","الطويل"],[369,"إذا أنت لم ترع البروق اللوامحا","https://www.aldiwan.net/poem57514.html","الطويل"],[374,"بيني وبين المبدعين مرامي","https://www.aldiwan.net/poem59267.html","الكامل"],[374,"إن الذي ترك الثراء الأفخرا","https://www.aldiwan.net/poem59428.html","الكامل"],[374,"قف نبك نفسا عجبها بمماتها","https://www.aldiwan.net/poem66907.html","الكامل"],[377,"أترى أراك بلا رقيب","https://www.aldiwan.net/poem49250.html","مجزوء الكامل"],[388,"مسكين مسكين من قرب إلى المجزره","https://www.aldiwan.net/poem54438.html","عموديه"],[400,"الحمامة إن أثارت بالهديل","https://www.aldiwan.net/poem32903.html","الرمل"],[400,"قلب المتيم كل يذوده","https://www.aldiwan.net/poem33973.html","مجزوء الكامل"],[400,"قد أصبتم يا سيدي بالجواب","https://www.aldiwan.net/poem34148.html","الخفيف"],[402,"بنفسي كتاب أراني عيانا","https://www.aldiwan.net/poem49496.html","المتقارب"],[434,"ناحت صباح على الغصون حمامة","https://www.aldiwan.net/poem2507.html","الكامل"],[434,"أشاقتك من أطلال ليلى معالم","https://www.aldiwan.net/poem2587.html","الطويل"],[436,"منكم إليكم مساعي المجد تنصرف","https://www.aldiwan.net/poem34822.html","البسيط"],[441,"في بعلبك جنة الخوام","https://www.aldiwan.net/poem55930.html","عموديه"],[451,"دعوني من الدنيا من الأرض والسما","https://www.aldiwan.net/poem61581.html","الطويل"],[451,"حلمت ولم أعلم أحلمى يقظة","https://www.aldiwan.net/poem61799.html","الطويل"],[475,"حييت من دمن ومن أطلال","https://www.aldiwan.net/poem15352.html","الكامل"],[477,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[498,"حزب الغيوب أتانا","https://www.aldiwan.net/poem37698.html","الكامل"],[513,"صرف النسيب إلى اللوى وزرود","https://www.aldiwan.net/poem12082.html","الكامل"],[527,"يا بدر قد أطلعت في فلك العلى","https://www.aldiwan.net/poem37168.html","الكامل"],[549,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[549,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[556,"إن الحروف إشارات المداد فلا","https://www.aldiwan.net/poem33579.html","البسيط"],[557,"أيها اللائم رفقا","https://www.aldiwan.net/poem69350.html","مجزوء الرمل"],[560,"أتى مثل موسى حينما عاد من مصر","https://www.aldiwan.net/poem52768.html","الطويل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["فَالفَرقُ ما بَيني وَبَينَهُمُ","كَالفَرقِ بَينَ العَيِّ وَاللَسَنِ",0,"ن",1,0],["فألْفاظُها كالزّهْرِ والزّهْرُ يانِعٌ","وقدْرُ المَعاني في الأصالةِ كالزُّهْرِ",1,"ر",1,0],["فألّفْتَ ما بيْنَ الظُّبى وجُفونِها","وقد أوْحَشَتْ مِنْهُمْ جُفونٌ وأغْمادُ",2,"د",1,0],["فَأَلفَيتُهُ غَيرَ مُستَعتِبٍ","وَلا ذاكِرَ اللَهَ إِلّا قَليلا",3,"ل",2,0],["فَالفَتى كُلُّ الفَتى مَن لَو رَأى","في اِقتِحامِ النارِ عِزّاً لَاِقتَحَم",4,"م",1,0],["فَأَلفَيتَ مِلءَ الثَوبِ نَفساً طَموحَةً","إِلى المَجدِ مِن أَطمارِها تَتَطَلَّعُ",5,"ع",1,0],["فَأَلفَيتُ نادِيَها زاهِراً","وَأَلفَيتُ ثَمَّ نَعيماً ثَوى",6,"ا",1,0],["فَأَلِّف ذاتَ بَينِهِما بِرَأيٍ","وَعَزمٍ لا يَكِلُّ وَلا يَمَلُّ",7,"ل",1,0],["فَأَلفَيتُهُ يَهوى النَدى فَتَرُدُّهُ","عروقٌ إِلى أَخوالِهِ الزرقِ تَنتَمي",8,"ي",1,0],["فالفلك تجري كما الأفلاك جارية","بحرُ السماء وبحرُ الأرض أشباهُ",9,"ا",2,0],["فالفتحُ بين معجّلٍ ومؤجلٍ","يُنسيك ماضيَه الذي يستقبلُ",10,"ل",1,0],["فالفكر منك كأبعاد الفضاء بلا","حدٍّ يسابق خطف البرق في الطلق",11,"ق",1,0],["فالفنّ مقياس الحضارة عند مَن","حازوا الرُقِيَّ وناطَحوا العَيُّوقا",12,"ق",2,0],["فالفضل مقتبلٌ بغير معارضٍ","والمجد منفردٍ بغير قرين",13,"ن",1,0],["فألَّفت منه إذ تجمَّع وحشُهُ","وهنَّ رُتوعٌ بالفلا وكوانس",14,"س",1,0],["فالفَظْ بِدُرِّ نثيرٍما له صدف","ألفَظ بدر نظيم ما له صدف",15,"ف",1,0],["فَأَلفى القَومَ قَد شَرِبوا فَضَمّوا","أَمامَ الماءِ مَنطِقُهُم نَسيفُ",16,"ف",1,0],["فَألفَيتُ أَعلى الناسِ قَدراً وَسُؤدُداً","وَعَدلاً فدَتهُ النَفسُ صدقاً بِلا كَذبِ",17,"ب",1,0],["فالفلك في تيار بحر زاخر","والموج حول الفلك كالاطواد",18,"د",1,0],["فَالفَخرُ عَن تَقصيرِهِ بِكَ ناكِبٌ","وَالمَجدُ مِن أَن تُستَزادَ بَراءُ",19,"ا",2,0],["فألف بينهم تظفر وتخرج","غوامض سرنا الخافي الدفينِ",20,"ن",1,0],["فَالفِعلُ فَوتَ القَولِ إِن فاضَ في","عارِفَةٍ وَالجودُ فَوتَ الجِدَه",21,"د",2,0],["فأَلفَيْتُ الأميرَ أليفَ مَجْدٍ","مُعَنَّىً بالمَكارِمِ مُستَهاما",22,"م",2,0],["فَالفَضلُ في حُسنِ لَفظٍ","يَقِلُّ فيهِ الفُضولُ",23,"ل",1,0],["فَالفِكرُ في ضَميري","وَالذِكرُ في لِساني",24,"ن",2,0],["فألفينا لديكم ألفَ عيدٍ","تُنَسّينا الأحبةَ والديارَا",25,"ر",2,0],["فالفحمُ يبقى زمانا","والجمرُ يفنى قريبا",26,"ب",2,0],["فَأَلفَت لَها مِن خالِصِ الوُدِّ وَالهَوى","جَديداً عَلى شَحطِ النَوى لَيسَ يَخلَقُ",27,"ق",1,0],["فالفيلَ تَقْتُلُه الأَفْعَى بِأَصْغَرِها","فيها ولم تخشَهُ منْ سِنِّها الصِّغَرُ",28,"ر",1,0],["فألفوه لا الدنيا تميل به ولا","كرائم ما تحوي عليه كرائم",29,"م",1,0],["فالفَيْءُ لا مُتَنَقِّلٌ والحوضُ لا","مُتَكَدِّرٌ والمَنُّ لا مَمنون",30,"ن",1,0],["فالفَتْحُ من أوَّل النعمى به ولَهُ","عَواقبٌ في بَني مَروانَ عن عَجَل",31,"ل",1,0],["فَأَلفَيتُ الأَمانَةَ لَم تَخُنها","كَذَلِكَ كانَ نوحٌ لا يَخونُ",32,"ن",1,0],["فَأَلفَيتُهُ يَوماً يُبيدُ عَدوَّهُ","وَبَحرَ عَطاءٍ يَستَخِفَّ المَعابِرا",33,"ر",2,0],["فَأَلفَيتُ البَهائِمَ لاعُقولٌ","تُقيمُ لَها الدَليلَ وَلا ضِياءُ",34,"ي",3,0],["فَالْفَتَى مَتَى","ذاقَها انْشَرَحْ",35,"ح",1,0],["فَأَلْفَيْتُ أَنْ لاَ حَيَّ إِلاَّ مُعَذَّبٌ","وَأَشْقَى ذَوِي الآلامِ مَنْ يَتَعَقَّلُ",36,"ل",1,0],["فَالْفَضْلُ مَنْقَصَةٌ لَهُ","وَخِلاَلُهُ الحُسْنَى عُيُوبُ",37,"ب",1,0],["فألفاك ميمونَ النقيبةِ كالذي","عُرفتَ به في أوّلٍ وأخير",38,"ر",1,0],["فألفت ما بين الظبا وجفونها","وقد أوحشت منهم جفون وأغماد",39,"د",1,0],["فالفَخْرُ عَن تَقصِيرِهِ بكَ ناكِبٌ","والمَجْدُ مِنْ أنْ يُسْتَزادَ بَراءُ",40,"ا",2,0],["فالفت عنانك للمحبة والتفت","عن غيره يا من له اذعان",41,"ن",1,0],["فالفضل اثوابي ورثت قديمها","وشمائل الآناء في الاولاد",42,"د",1,0],["فألفيتني وسنانة تحت وارف","من الظل في أكنافه الزهر يبسم",43,"م",1,0],["فالفضلُ يشهد لي بأنك واحدٌ","فينا وأنك أنت نعمَ المقتنّى",44,"ن",2,0],["فَألَّفَ في شَأنِهِ دَفتَراً","وزَحرَفَ في نَعتِهِ زُخرُفَا",45,"ف",2,0],["فالفضل والمجد والإسعاد حلّ بهِ","والأنس والبشر والإفضال والجودُ",46,"د",1,0],["فالفوز فوز جنابهم ولهم من","المحبوب خير كرامة بمآب",47,"ب",1,0],["فالفضلُ فيه خليقة من أصلِ","خليقته الكريمةِ ليس فيه بمجتلب",48,"ب",1,0],["فألفوك أهدى في الفيافي من القطا","وأصبر من ضبٍّ على الماء صاديا",49,"ي",2,0],["فالفوه يسمو الضب صبرا على الظما","ويهدى القطا في البيد إن ضلت السبل",50,"ل",1,0],["فالفسح منك له عطاء صائن","للنفس منه فجد له بصيان",51,"ن",1,0],["فأَلفَيتُ قَوماً إِن طَلَبتَ اِنبِعاثَهُم","لِيَومِ سِبابٍ فَاِدعُ بِالخَيلِ وَالرَجلِ",52,"ل",1,0],["فَأَلفَت رِجالاً بِالكَمالِ تَزَيَّنوا","وَبِاللُّطفِ وَالآداب وَالشِّيَمِ الغرّا",53,"ر",2,0],["فالفرج تستره والعين تغمضها","والقلب تحرسه ممّا يخامره",54,"ر",2,0],["فالفرع من سَبَجٍ والخد من ضَرَجٍ","والطَّرف من غنجٍ يلقاك وسنانا",55,"ن",2,0],["فالفقر بي حاشاك اودى بالحشا","قسما وقد اعيا الطبيب علاجي",56,"ي",1,0],["فألفيت الخريف جنى عليها","جنايتهُ على الدوح الوريق",57,"ق",1,0],["فَالفَقيرُ جاءَ لهُ","في ديارهِ النَشبُ",58,"ب",1,0],["فالفخر عندك موروث ومُكْتَسَب","وعند غيرك مكذوب ومسروق",59,"ق",1,0],["فالفَرْعُ ليس يُخالفُ الأَصلَ الذي","منه ابْتَدا نَبْتاً وعنه تَفَرّعا",60,"ع",2,0],["فَالْفَضْلُ لاَ يَعْدُوهُمُ","وَهُمُ لاَ يَعْدُونَهْ",61,"ن",2,0],["فألفيت مني الحمد والشكر والثنا","عليك مدى الأيام ليس بذاهب",62,"ب",1,0],["فالفضلُ منكِ يُساوي فضلنا أبداً","ولا يُعَدُّ ظلوماً مَن يُساويك",63,"ك",1,0],["فالفضلُ كلُّ الفضلِ للحُسنِ الذي","أمسى بهِ روضُ الفنونِ نَضيرا",64,"ر",2,0],["فالفأل فيهم سَعيد","وَالطالِعات سعود",65,"د",1,0],["فالفخر مفتخر وَفيك فخاره","وَالجود مَوجود منك غمائمه",66,"م",2,0],["فَالفَرعُ مِنهُ عَناقيدٌ وَوَجنَتُهُ","تُفّاحُ لُبنانَ وَالنَهدانِ رُمّانُ",67,"ن",1,0],["فَالفَألُ أَخبَرَ عَن صَلاحٍ كامِلٍ","لِلعالَمينَ وَذاكَ أَصدَقُ مَخبَرِ",68,"ر",1,0],["فَالفاضِلُ المُشتَري في","كيوانَ وَالمَرّيخِ",69,"خ",1,0],["فألفيت صحبي قد شتتوا","وقد راح بعض وما ودعوا",70,"ع",3,0],["فالفَضلُ في الحالين له","وَوصلُ من تَهوى صِلَه",71,"ه",1,0],["فالفُحشُ في المزاحِ","ضربٌ من التَلاحِ",71,"ح",1,0],["فَالَفَهُم وَخالَفَ مِن مَعَدٍّ","وَنارُ الحَربِ تَستَعِرُ اِستِعارا",72,"ر",2,0],["فَأَلفَيتُهُ مُرِّ المَذاقِ عَنِ الصَبرِ","وَما ضِقتُ ذِرعاً ما غَدَوتُ مُعرِضاً",73,"ض",2,0],["فَالفَضلُ أَشهَرُ مِن أَنا نَبينِهِ","وَالخَلقُ أَعظَمُ مِن أَنا نُضاهيهِ",74,"ي",2,0],["فَالفَوز هَلّل بِالسَعادة مُقبِلاً","وَالضدّ وَلّى بِالشقاوة مُدبِرا",75,"ر",2,0],["فآل فلاح أفلح الناس كلِّهم","ومن يأتهِم يُمسِ به عُسرهُ يُسرا",76,"ر",2,0],["فَأَلفَيتُه بُستان فَضل تَرَنمت","بِه صادِحات العلم خَير تَرنم",77,"م",1,0],["فالفَضْلُ يا ابْنَ الفَضْلِ صاحبُهُ","قَمِنٌ بأَنْ تُرعَى لهُ الذِّمَم",78,"م",1,0],["فألّفتَ شاردَ أبنائها","وشَرّدتَ آلِفَ مُرّاقها",79,"ق",3,0],["فالفَجرُ يَطلُع كاذباً أو صادِقاً","ما زال قُدّامَ النّهارِ الماتع",80,"ع",1,0],["فألفاظُه طُرّاً عُقودٌ جَميعُها","وما في مَعانيهِنَّ مَعْنىً مُعقَّد",81,"د",1,0],["فالفضلُ قَرَّتْ عَينُه بك يا ابنَه","إذ كنتَ من أبنائه النجباء",82,"ا",2,0],["فألفَيتُهُ قَد طافَ بينَ دِنانِها","وصَلَّى لَها شَطرَ الظَّلامِ وهَوَّما",83,"م",2,0],["فألفيتُهم يستعرضونَ حوائجي","إليهم ولو كانَت عليهم جوانِحا",84,"ح",2,0],["فالفخر ليس برُتبةٍ أو زنيةٍ","بِيعيةٍ منظومةِ الإحكام",85,"م",1,0],["فالفقر جوهرةٌ ثمينٌ قدرها","فاقت بقيمتها الغنى والجوهرا",86,"ر",2,0],["فالفرع يعرف نوعه من أصله","وتبين الأشجار من ثماراتها",87,"ت",3,0],["فالفتح في راياتها والنجح في","غاياتها والربح في آياتها",87,"ت",3,0],["فَالفتك فيهِ ضَريبة","وَالحُسن مِنهُ بِلا ضَريب",88,"ب",1,0],["فالفضل واسع وعفو الله ما أكبره","والجود فايض عسى قسمي يقع وافره",89,"ر",2,0],["فالفتى الفتان سلاب المهج","قد أعاض الوصل بالبين",90,"ن",1,0],["فالفرع مثل الأصل يأ","بَى أن يرى شخصاً يسودُه",91,"د",2,0],["فالفلوس الفلوس أنفع شيء","فهي أقصى مطالب الطلاب",92,"ب",1,0],["فألفاظُهُ والمَعاني جَميعاً","مَرائي العُيونِ مَراعي العُقولِ",93,"ل",1,0],["فالفضل نقض إن شدت ولم أبكها","بدم ترقرقه شؤون جفوني",94,"ي",1,0],["فألفاك سيفا في الأعادي مجرّراً","وفي شفرتيه الموت إن شام شائم",95,"م",1,0],["فالفخر منتظِمٌ والملك منتقمٌ","والحقُّ منتصِرٌ والدينُ مُنْتَصِفُ",96,"ف",1,0],["فالفندق المرغوب مهما استعلى","مزية الطبخ تعد الأولى",97,"ل",2,0],["فألفيت في الأحلام ظل حقيقتي","ووحيا يناجيني وإن عد مبهما",98,"م",2,0],["فألفيت دُنيا غير غابٍ خشيته","مُرنقَّةً بالنور وِالعطر للظامي",99,"ي",1,0],["فالفضلُ تعرفهُ وتعرفُ أهلَه","بأقلَّ شيءٍ مِن بديعِ مقالِ",100,"ل",1,0],["فالفضل من ملكوته","أسمى لديه وأوسع",101,"ع",1,0],["فَالفتحُ سَهمُ مُحِبِنا أَبَدَا المدى","والخَيرُ مَبذُولٌ لِمَن والانا",102,"ن",2,0],["فالفتح فتحك سقت غرة نصره","بين الظبى والعزم والتأييد",103,"د",1,0],["فالفَخْرُ أَنْتَ عَقيدُهُ وهُمامُهُ","والْمَجْدُ أَنْتَ سِنانُهُ وحُسامُهُ",104,"م",2,0],["فالفقرُ فيها للغنى","خيرٌ كثيرٌ مِن غناها",105,"ا",3,0],["فَالفَتى مَن كانَ مَجداً","قاصراً عنه المديحُ",106,"ح",1,0],["فالفكر فالعقل أيضاً فالخيال بدا","فالطبع فالحس فالأشياء قد شغلا",107,"ل",2,0],["فَالْفَنا فيه حَيَاةٌ","فافْنَ إنَّ رِدْتَ تَبْقَى",108,"ق",2,0],["فألَّفَ ما بين القلوبِ بلطفهِ","كما امتَزَجَ الماءُ الزُلالُ مع الخَمرِ",109,"ر",1,0],["فالفضل في هذا على ما علما","أعظم مما قلتموه فيهما",110,"م",2,0]]}