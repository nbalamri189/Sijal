{"poems":[[90,"دع مزعج اللوم وخل العتاب","https://www.aldiwan.net/poem44807.html","السريع"],[91,"ترى هل إذا متنا تظل نفوسنا","https://www.aldiwan.net/poem45108.html","الطويل"],[87,"يمينا بالطلاق وبالعتاق","https://www.aldiwan.net/poem6824.html","الوافر"],[33,"زارنا زور سررت به","https://www.aldiwan.net/poem42024.html","المديد"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20997","الرمل"],[102,"أمام المفترق الاخير","https://www.poetsgate.com/ViewPoem.aspx?id=50359",""],[182,"هد الجوى ركبي","https://www.aldiwan.net/poem50687.html","المواليا"],[182,"صنوَ الروح","https://www.aldiwan.net/poem50712.html","الرمل"],[186,"أيها النائح المبكر مهلا","https://www.aldiwan.net/poem67040.html","الخفيف"],[275,"أتطمع كالضليل بالوطر العالي","https://www.aldiwan.net/poem35625.html","الطويل"],[567,"أسفا على أسف وليس بمنكر","https://www.aldiwan.net/poem52942.html","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108838","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93688","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204639","المجتث"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20606","المنسرح"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105564","السريع"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21551","الكامل"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103265","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83182","البسيط"],[4748,"حكمة الله","https://www.poetsgate.com/ViewPoem.aspx?id=6658",""],[4829,"الملحمة اليعربيّة","https://www.poetsgate.com/ViewPoem.aspx?id=36397",""],[182,"صنو روحي","https://www.poetsgate.com/ViewPoem.aspx?id=72810",""],[5170,"موت الضمير (سوريا)","https://www.poetsgate.com/ViewPoem.aspx?id=175518",""],[5587,"جيتك يا حبي","https://www.poetsgate.com/ViewPoem.aspx?id=197806",""],[5847,"مولد الهادي عليه الصلاة والسلام 1436ه","https://www.poetsgate.com/ViewPoem.aspx?id=176762",""],[5956,"الرَّصيفُ ذو الحصى العسليّ","https://www.poetsgate.com/ViewPoem.aspx?id=184884",""],[5956,"كل تقصير لديهم بأداء الضَّخِ","https://www.poetsgate.com/ViewPoem.aspx?id=194199",""]],"verses":[["نحسبها حسناء من زيَها","وما سوى جنبول تحت الثياب",0,"ب",1,0],["نحس بنور الشمس حيناً وبعده","نحور حطاما لا يحس إلى الترب",1,"ب",1,0],["نُحست فلو دعيت لأجل فتق","وجدت قليطة تحت الفتاق",2,"ق",1,0],["نَحسَبُ الراحَ الذَكيَّ بِهِ","وَسُلافَ الراحِ وَالسَلسَل",3,"ل",1,0],["نُحسِنُ الهِنءَ إذا استَهنَأتَنا","ودفِاعاً عَنكَ بالأََيدي الكِبارِ",4,"ر",1,0],["نحسّ أنّا مأسّويون","لا نملك للمأساة غير الصفه",5,"ف",2,0],["نَحْسٌ أنا مَبْناهْ","قَدْ عاثَ في نَثْري",6,"ي",1,0],["نَحْسُ حلاجٍ تَلَظّى في دَمي","وَبَناتُ الصَّدْرِ أذْكَتْ ألَمي",7,"م",2,1],["نَحسَب المَوتَ ظالِماً وَلَعَمري","يُحسبُ الظُلمُ في الوِلادة قَبلا",8,"ل",2,0],["نحسَّبُ فتياناً وتحني ظهورَنا","همومٌ وأحزانٌ كأثقلِ أحمال",9,"ل",1,0],["نَحِساتُ أيَّامٍ أثَرْنَ عَجاجةً","سَطَعَتْ ولكنْ لا بريحٍ صَرصَرِ",10,"ر",1,0],["نحسب الضم والعنا","ق ولا نحسب الشمم",11,"م",1,0],["نَحس وَسَعد بِآفاق العُلى اِعتَرَكا","فَالحَمد لِلّه إِذ نجم السُعود عَلا",12,"ل",2,0],["نحس بعد انتباه","منه بضعف شديد",13,"د",1,0],["نَحسهُ اِرتحل","سَعدَهُ أقم",14,"م",1,0],["نُحسَدُ فيها عَلى النَعيمِ وَما","يولَعُ إِلّا بِالنِعمَةِ الحَسَدُ",15,"د",1,0],["نحسو طلى الثغر وأري الجنى","بنهلةٍ من ريقك الصادر",16,"د",2,0],["نَحِسَ الزَمان بأَهلِها فتَصَدَّعوا","إِنَّ الزمَانَ بأَهلِهِ لَنَحوسُ",17,"س",1,0],["نحسٌ تقصدها ما أن يفارقها","حتام يا نحس عنها أنت تنتقلُ",18,"ل",1,0],["نُحِسُّ أَنَّ الثَرى مِن خَمرِها ثَمِلٌ","وَيوشِكُ الصَخرُ مِنها أَن يَسيل نَدا",19,"د",2,0],["نحسب الايام ونلوم الظروف","والتلاقي مالنا عنده نصيب",20,"ب",1,0],["نحسب انكم على العدوان معنا","واثاريكم علينا ثم علينا",21,"ن",2,0],["نحسُ حلاج(1 ) تلظّى في دمي","كلما يمَّمتُ درباً شاكني",22,"ن",2,1],["نحسب نقول النصر ما يطول شهر","واطفال تنحر واصبح الواقع مرير",23,"ر",1,0],["نْحَسْ عْضَايَا عَادَتْ لِلْجُرْحْ تْنَبِّي","غِيرْ الهَدْرَة قَصْدَتْ كِلْمَة هَا لَحْبَابْ",24,"ب",1,0],["2- نحسُّ ببهجة الايمان تسري","كما النسمات باسمةً تجوبُ",25,"ب",1,0],["نُحِسُّ بأمتار ذاك الرّصيف","كطول جميع الوجود الطليقْ",26,"ق",1,0],["نحسُنا الملعونُ لم يترك بتاتاً","مُوبِقاتٍ لم يُقارفها سِرارا..",27,"ر",2,0]]}