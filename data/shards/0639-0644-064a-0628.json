{"poems":[[53,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[77,"نشدتك هل أبصرت قبلي أو بعدي","https://www.aldiwan.net/poem36559.html","الطويل"],[86,"أيحصي معانيك القريض المهذب","https://www.aldiwan.net/poem10695.html","الطويل"],[86,"كحافظ ابراهيم لكنه","https://www.aldiwan.net/poem68860.html","السريع"],[93,"شهدنا زمانا في الكنانة ردنا","https://www.aldiwan.net/poem9798.html","عموديه"],[88,"أطالوا الحرب طاحنة زبونا","https://www.aldiwan.net/poem44459.html","الوافر"],[72,"خلقت على مرادي واقتراحي","https://www.aldiwan.net/poem18479.html","الوافر"],[72,"بدت في رداء الشعر باسمة الثغر","https://www.aldiwan.net/poem18703.html","الطويل"],[72,"سيج ورد الخدود بالآس","https://www.aldiwan.net/poem19018.html","المنسرح"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"أبى القلب إلا وجده برخاص","https://www.aldiwan.net/poem64933.html","الطويل"],[70,"لأجلك سعيي واجتهادي وخدمتي","https://www.aldiwan.net/poem42897.html","الطويل"],[38,"ألم يسأل الركب الديار العوافيا","https://www.aldiwan.net/poem7821.html","الطويل"],[85,"ما وصل من تهوى على أنسة","https://www.aldiwan.net/poem7121.html","السريع"],[45,"عذيرك من نأي غدا وبعاد","https://www.aldiwan.net/poem63453.html","الطويل"],[45,"أفي كل دار منك عين ترقرق","https://www.aldiwan.net/poem65183.html","الطويل"],[45,"عذيري من واش بها لم أواله","https://www.aldiwan.net/poem65537.html","الطويل"],[45,"علي بني الفياض يوم نواله","https://www.aldiwan.net/poem65610.html","الطويل"],[61,"سحابك في السماح لها انسجام","https://www.aldiwan.net/poem51440.html","البسيط"],[80,"رمى الموت في عين التصبر بالدم","https://www.aldiwan.net/poem31279.html","الطويل"],[31,"ألا يا حبذا نجد","https://www.aldiwan.net/poem42468.html","الهزج"],[31,"هاج القريض الذكر","https://www.aldiwan.net/poem42501.html","مجزوء الرجز"],[39,"أمن دمن بشاجنة الحجون","https://www.aldiwan.net/poem53733.html","الوافر"],[52,"بخيل قد شقيت به","https://www.aldiwan.net/poem27178.html","مجزوء الوافر"],[48,"أيا من سار منطلقا","https://www.aldiwan.net/poem64435.html","مجزوء الوافر"],[48,"فلا أشرب داريا","https://www.aldiwan.net/poem66255.html","الهزج"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116962","الطويل"],[106,"وطن ينادي أهله!","https://www.poetsgate.com/ViewPoem.aspx?id=179349",""],[77,"نشدتك هل أبصرت قبلي أو بعدي","https://www.poetsgate.com/ViewPoem.aspx?id=33937",""],[90,"بغداد على الغرق","https://www.poetsgate.com/ViewPoem.aspx?id=179069",""],[45,"أفي كُلّ دارٍ مِنكَ عَينٌ تَرَقْرَقُ","https://www.poetsgate.com/ViewPoem.aspx?id=32846",""],[122,"عفا الصفا وانتفى من كوخ ندماني","https://www.aldiwan.net/poem23777.html","البسيط"],[126,"وما لي تمن غير لقياك ساعة","https://www.aldiwan.net/poem50623.html","الطويل"],[158,"إِذا سفك الدماء لديك حلا","https://www.aldiwan.net/poem58931.html","الوافر"],[158,"على غيرك البهتان والزور ينفق","https://www.aldiwan.net/poem58945.html","الطويل"],[158,"إليك فقد حملت قلبي من الهوي","https://www.aldiwan.net/poem59013.html","الطويل"],[162,"أبا حسن والمرء يخلق صورة","https://www.aldiwan.net/poem67825.html","الطويل"],[164,"وسقت الركائب حتى أنخن","https://www.aldiwan.net/poem46823.html","المتقارب"],[164,"علي بها مدخنة بند","https://www.aldiwan.net/poem47055.html","الوافر"],[183,"أعز الورى من أفاد القنوعا","https://www.aldiwan.net/poem14571.html","المتقارب"],[184,"لقد هاج لي الوجد","https://www.aldiwan.net/poem43978.html","الهزج"],[208,"بدا يختال كالقمر المفدى","https://www.aldiwan.net/poem13553.html","الوافر"],[209,"أطوف بأحلامي عليكم لعنى","https://www.aldiwan.net/poem46319.html","الطويل"],[235,"علي بن داود علي مقامه","https://www.aldiwan.net/poem19088.html","الطويل"],[249,"رُبى لبنان","https://www.aldiwan.net/poem39738.html","عموديه"],[268,"أقول لها إذا الطرب استفزا","https://www.aldiwan.net/poem35022.html","الوافر"],[268,"تذكرت في الحمراء عهد الصبوة","https://www.aldiwan.net/poem35637.html","الطويل"],[268,"حبي الخليفة مولانا ومولاك","https://www.aldiwan.net/poem35652.html","البسيط"],[273,"لأندلس البشرى وحضرتها حمص","https://www.aldiwan.net/poem25492.html","الطويل"],[280,"على بيت عصرون العفاء فما لهم","https://www.aldiwan.net/poem32840.html","الطويل"],[283,"الله أكبر ساد الحق وانتصرا","https://www.aldiwan.net/poem39420.html","البسيط"],[295,"على باب ابن معصوم أنخنا","https://www.aldiwan.net/poem33303.html","الوافر"],[302,"يا صاح قلبي ما سلا ولا طاب","https://www.aldiwan.net/poem16777.html","الرجز"],[302,"سلام على إخواننا والأحبة","https://www.aldiwan.net/poem16830.html","الطويل"],[302,"حي ظبي الرمال والأطلال","https://www.aldiwan.net/poem16833.html","الخفيف"],[351,"يا من تنزه عن إبن ووالدة","https://www.aldiwan.net/poem40353.html","البسيط"],[362,"أتلك رياض أم خدود نواعم","https://www.aldiwan.net/poem60665.html","الطويل"],[374,"خليلي مرا بي على ربع ناسك","https://www.aldiwan.net/poem59305.html","الطويل"],[388,"يا سعد قلبي ما سلا ولا طاب","https://www.aldiwan.net/poem54478.html","عموديه"],[402,"علي بها لاكنار الخليل","https://www.aldiwan.net/poem49582.html","المتقارب"],[407,"وسدت بهارون الثغور فأحكمت","https://www.aldiwan.net/poem67500.html","الطويل"],[426,"حكم المنية سهم والورى عرض","https://www.aldiwan.net/poem40708.html","البسيط"],[436,"جهادك حكم الله من ذا يرده","https://www.aldiwan.net/poem34888.html","الطويل"],[438,"أريحي الوجا يا ناق ما بعد ذا وجا","https://www.aldiwan.net/poem14299.html","الطويل"],[438,"لهذا خلقنا والجديد سيخلق","https://www.aldiwan.net/poem14465.html","الطويل"],[451,"الأربعون صدى فؤادي الدامي","https://www.aldiwan.net/poem61769.html","الكامل"],[456,"لمن ظعن سوائر لو","https://www.aldiwan.net/poem55846.html","مجزوء الوافر"],[456,"لكِ الغرام وللواشي بكِ التعب","https://www.aldiwan.net/poem56274.html","البسيط"],[511,"أرى كل مرتاب يخاف خياله","https://www.aldiwan.net/poem67787.html","الطويل"],[513,"هل القلب إلا مضغة تتقلب","https://www.aldiwan.net/poem12016.html","الطويل"],[527,"إمام البهاليل الألى سبقوا إلى","https://www.aldiwan.net/poem37418.html","الطويل"],[560,"مليك الورى عبد المجيد قد ابتنى","https://www.aldiwan.net/poem52677.html","الطويل"],[560,"لهذا الفرق دان الفرقدان","https://www.aldiwan.net/poem52922.html","الوافر"],[573,"على كل حال ليس لي عنك مذهب","https://www.aldiwan.net/poem3109.html","الطويل"]],"verses":[["عُلىً بيدِ الحُسَينِ ذُؤابَتاها","وَفَرعاها اللَذا كَثُرا وَطابا",0,"ب",2,0],["علِيِّ بْنِ عُثْمانَ بْنِ يعْقوبَ يا لَها","مَفاخِرَ قدْ أرْبَتْ علَى الحَصْرِ والعَدِّ",1,"د",1,0],["عَلى بابِهِ العالي هُناكَ تَأَلَّقَت","سُطورٌ لِأَقلامِ الجَلالَةِ تُنسَبُ",2,"ب",1,0],["عَلى بِلادِ النيلِ تِلكَ الَّتي","تاهَت بِأَصحابِ الذَكا النادِرِ",3,"ر",1,0],["عَلَى بَرَكَاتِ اللهِ سِيرُوا مَسِيرَكُمْ","وَصِيدْوا الْمُنَى مِنْ كُلِّ مَنْحَىً وَمُضْطَرَبْ",4,"ب",1,0],["على بحر بلُجّته أقاموا","لفلق البحر من نار كُرينا",5,"ن",2,0],["عليَّ بها السرى وعلى أيادي","بني الفاروق إدراك النجاح",6,"ح",1,0],["على باب سلطان العباد كأنها","لنظم ثناياها عقودٌ من الدُّرِّ",7,"ر",1,0],["عليّ بحر أفاض جوهره","فنظمته الورى بمقياس",8,"س",1,0],["على بَحْرِهِ يُرْوَى الظِّمَاءُ ونَحْوَهُ","يشيرُ إذا ما غُصَّ بالماء مَزْرَدُ",9,"د",1,0],["عليُّ بن يحيى ذو الجناب الذي غدا","مراد القوافي روضهُ المتناصي",10,"ي",1,0],["عَلَيَّ بِأَنّي لا أُخِلُّ بِخِدمَةٍ","وَأَبذُلُ مَجهودي وَأَنتَ المُخَيَّرُ",11,"ر",1,0],["عَلى بَرَدى إِذ قالَ إِن كانَ عَهدُهُم","أُضيعَ فَكونوا لا عَلَيَّ وَلا لِيا",12,"ي",2,0],["على بساط نسجته الربى","شتى الحُلَى والوشى غض طليل",13,"ل",1,0],["عَلى بابِ قِنَّسرينَ وَاللَيلُ لاطِخٌ","جَوانِبَهُ مِن ظُلمَةٍ بِمِدادِ",14,"د",1,0],["عَلِيُّ بنُ عيسى بنِ موسى بنِ طَلحَةَ ب","نِ سائِبٍ اِبنِ مالِكٍ حينَ يُرمَقُ",15,"ق",1,0],["عَلِيُّ بنُ يَحيى إِنَّهُ اِنتَسَبَ النَدى","إِلى عَمِّهِ عَمِّ الكِرامِ وَخالِهِ",16,"ل",2,0],["عَلِيُّ بَني الفَيّاضِ يَومَ نَوالِهِ","أَخو الغَيثِ في إِغزارِهِ وَاحتِفالِهِ",17,"ل",2,1],["عُلىً بَعُدَتْ مسافَتُها ومَجْدٌ","تَعالَى أن يَهُمَّ بهِ هُمامُ",18,"م",1,0],["عليّ بن حمدون الذي كان حَمْدُهُ","تُرَفَّعُ منه همّةُ المتكلمِ",19,"م",1,0],["عَلى بُخلٍ وَتَصريدٍ","وَقَبضِ نَوالِكُم قَبضا",20,"ض",2,0],["عَلى بِغالٍ وُسَّجٍ","قَد ضَمَّهُنَّ السَفَرُ",21,"ر",1,0],["عَلى بَيدانَةٍ بِبَناتِ قَينٍ","تَسوفُ صِلالَ مُبتَدٍّ ظَنونِ",22,"ن",1,0],["عَلى بُستانِ خَدَّيهِ","زَرافينَ مِنَ السِيَجِ",23,"ج",1,0],["عَلى بَشَرٍ كَأَنَّ الدُر","رَ يَعلوهُ إِذا عَرِقا",24,"ق",2,0],["على بيض دخاميزٍ","ولا أكلٍ ملطوخا",25,"خ",2,0],["على بُرحاءَ الشوق منا هجرتنا","وزدت على ما ليس يبلغه الهجر",26,"ر",1,0],["على برهَةٍ نالوا بها العزَّ والتُقى","ألا ولذيذَ العيش بالبر والصبر",27,"ر",1,0],["على بابها صاح طَيْرٌ غريبٌ","فَنَاحَ على طْيره بَانُها!",28,"ن",3,0],["علي بن عثمان بن يعقوب ما لها","مفاخر قد أربت على الحصر والعد",29,"د",1,0],["على \" بغداد \" ما بَقِيتْ سَلامٌ","يَضُوعُ كما ذَكَا للوَردِ نَشْر",30,"ر",1,0],["عَلَىُّ بْنُ عِيسى بْنِ مُوسى بن طَلْحَةَ","بْنِ سَائِبٍ بْنِ مَالِكٍ حِينَ يُرْمَقُ",31,"ق",1,0],["علي بالكأس فالدنيا مهازلها","طغت على الناس لكن شر طغيان",32,"ن",1,0],["عليَّ بأنْ أبدي الجوهر مِن فَمي","وأجلو معانيها بيوت قَصيدي",33,"د",2,0],["على بن محمد يحكى كمالاً","علي بن محمد قولاً وفعلا",34,"ل",2,0],["عليَّ بها شكر تؤدى فروضه","ثناه يفوح المسك مني فيعبق",35,"ق",1,0],["على بن داود المليك ابن يوسف","خلائف لا بغياً تولوا ولا عدوى",36,"و",2,0],["عَلِيّ بنَ عيسى خَيرُ يَومَيكَ أَن تُرى","وَفَضلُكَ مَأمولٌ وَوَعدُكَ ناجِزُ",37,"ز",1,0],["عليِّ بنِ موسى مُواسي العُفاةِ","أبي القاسمِ السيِّدِ المُوسَويَ",38,"ي",1,0],["عليَّ بها مدخّنةً بندُ","عليَّ بها مُفَدَّمةً بقَزِّ",39,"ز",1,1],["على بابِ ذي حِجْبةٍ وَعْدُه","غرورٌ على كونه مستطيعا",40,"ع",2,0],["على بشباشة الخشني","أبي موسى بلا رد",41,"د",1,0],["على بسط الندى طبعت يداه","كما خلقت لقبض السيف قصدا",42,"د",2,0],["على بابها رضوان يرقب عودتي","وينظر ما أهدى له وهو الشعر",43,"ر",1,0],["عَلِيُّ بْنُ دَاوُدٍ عَلِيٌّ مَقَامُهُ","وَفِي الزُّهْدِ فِي الْفَانِي بَعِيدٌ مَرَامُهُ",44,"ه",1,1],["على(برج البراجن)أو (بصبرا)","و(شاتيلا) و(صيدا) والضواحي",45,"ح",2,0],["على بؤسٍ حوى شرَفاً وكبراً","فما حسدَ العزيزَ ولا المُعِزّا",46,"ز",2,0],["على بحرِها العمرانُ والنضرُ والغِنى","وقد كملت فيها صنوفُ الحضارة",47,"ه",1,0],["على بنيكِ غدا في أرضِهم أسداً","ولم يكن في حماهم غيرَ هتّاك",48,"ك",1,0],["عَلِيَّ بْنَ إدْريسَ بْنِ يَعْقوبَ وانْتَمَوا","لِيَحْيَى بْنِ عَبْدِ الواحِدِ بْنِ أبِي حَفْصِ",49,"ص",1,0],["عَلى بَيتِ عُصرونَ العَفاءُ فَما لَهُم","قَديمٌ وَلا عَندَ الفَخارِ حَديثُ",50,"ث",1,1],["على بساط الرضا والانس صف لهم","موائد المن ضاها نورها القمرا",51,"ر",2,0],["عَلى بابِ ابنِ مَعصومٍ أَنَخنا","فَفُزنا بالنَجاة وبالنَجاحِ",52,"ح",1,1],["على بساط العلم والعباده","والغيب عندي صار كالشهاده",53,"ه",1,0],["على بن أبي بكر الملاز إمامنا","وعمدتنا في نقل علم الحقيقة",54,"ه",1,0],["عل يبدو في الحسن خير عيش","وكفاني علم الإله بحالي",55,"ل",2,0],["عَليَّ بَغياً وَلي بِالسوء طالِبَةٌ","يا مَن نَجاتي بِهِ وَالنَفس ذاهِبَةٌ",56,"ه",1,0],["عليُّ ْبَن نَصْرٍ ما يزالُ مِنَ الوَرى","ثَناءٌ تَهاداهُ إليكَ المَواسِم",57,"م",1,0],["على بابها وفدُ العفاة وطَولُها","يَعُمُّ نفوساً أصبحت في المهالك",58,"ك",1,0],["على بساط العلم والعباده","على الصراط المستقيم",59,"م",1,0],["علَيَّ بِها لاكَنارِ الخَليلِ","فبَردُ المُدامِ يَزيدُ الفُتورا",60,"ر",2,1],["عَلَيَّ بَني ساقي الحَجيجِ تَتابَعَت","أَوائِلُ مِن مَعروفِكُم وَأَواخِرُ",61,"ر",1,0],["على بديع معانيك العروض بكى","بحور دمع من الأشجان ترتكضُ",62,"ض",1,0],["عَلى بادِئِ الإِنعَامِ فِيهِ تمامُهُ","وحَقٌّ عَلَى سِبْطِ الخِلافَةِ حَمدُهُ",63,"د",2,0],["على بابك اللهم ألقيت أرحلي","محملة ذنباً ومحشوةً رجا",64,"ج",2,0],["على بنت موسى رحمة اللَه إنها","برحمته في ظلمة القبر أخلق",65,"ق",1,0],["على بحبي واندماجي أشتفى","بعضَ الشفاءِ ويهتدى لوَّامى",66,"م",2,0],["على بيضاء مصقولٍ","عوارضُها من الدرنِ",67,"ن",1,0],["على بساطِكَ تُقضىَ كلُّ مُبْهِمةٍ","يعنو بها الخطْبُ او تعيا بها الخطَبُ",68,"ب",1,0],["على بوادٍ من يخاف اغتيابه","تبت لديها في الأنام مناقبه",69,"ب",2,0],["عُلى بهرت آياتها بطلائع","فهل في العُلى أيضاً نبي مقرب",70,"ب",1,0],["عَليُّ بنُ إبراهيمٍ بنِ عليّ ب","نِ إبراهيمٍ بن أحْمَدٍ ابن عامِرِ",71,"ر",1,0],["على بابهِ خطَّ المؤرِّخُ قائلاً","سلامٌ عليكم فادخُلوا البابَ سُجَّدا",72,"د",2,0],["على بَلَدِ السَّلامِ وساكِنيِها","سَلامُ اللهِ من غُرَفِ الجُنانِ",73,"ن",1,0],["على بابه الأَملاكُ تَزْحَمُ وفدَه","وإِن قَرُبوا بالإِذن فالوفدُ أَقرَبُ",74,"ب",1,0]]}