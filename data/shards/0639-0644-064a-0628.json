iewPoem.aspx?id=50658",""],[5789,"أفنية العنادل","https://www.poetsgate.com/ViewPoem.aspx?id=201407",""],[5843,"خيل الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=51277",""],[5848,"هذا هو المطلوب","https://www.poetsgate.com/ViewPoem.aspx?id=53453",""],[5884,"أغالب فيه الشوق والشوق غالبي","https://www.poetsgate.com/ViewPoem.aspx?id=124749",""],[5932,"صرخة الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=37129",""],[5943,"على برِّ الأمان فرشتُ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=34682",""],[5956,"على بِرْكَةِ الشوقِ","https://www.poetsgate.com/ViewPoem.aspx?id=184979",""],[5956,"مُكافأة من الله","https://www.poetsgate.com/ViewPoem.aspx?id=194053",""],[161,"بارك الله لكما","https://www.poetsgate.com/ViewPoem.aspx?id=175728",""],[6056,"حمامة الأفكار","https://www.poetsgate.com/ViewPoem.aspx?id=130504",""],[6075,"على بوابة الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=190650",""],[6113,"لعبة الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=120905",""],[6124,"أسدلت الستر","https://www.poetsgate.com/ViewPoem.aspx?id=174684",""],[6131,"ظِلِّيْ","https://www.poetsgate.com/ViewPoem.aspx?id=189267",""],[5309,"على بابه لوحة باليه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573914",""],[6185,"أحلى مهاة !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86942&r=&rc=2",""]],"verses":[["عليّ بلأواء النوى كل موقف","يراع به قتلي ويعظم مقتلي",0,"ل",2,0],["عُلىً بيدِ الحُسَينِ ذُؤابَتاها","وَفَرعاها اللَذا كَثُرا وَطابا",1,"ب",2,0],["علِيِّ بْنِ عُثْمانَ بْنِ يعْقوبَ يا لَها","مَفاخِرَ قدْ أرْبَتْ علَى الحَصْرِ والعَدِّ",2,"د",1,0],["عَلى بابِهِ العالي هُناكَ تَأَلَّقَت","سُطورٌ لِأَقلامِ الجَلالَةِ تُنسَبُ",3,"ب",1,0],["عَلى بِلادِ النيلِ تِلكَ الَّتي","تاهَت بِأَصحابِ الذَكا النادِرِ",4,"ر",1,0],["عَلَى بَرَكَاتِ اللهِ سِيرُوا مَسِيرَكُمْ","وَصِيدْوا الْمُنَى مِنْ كُلِّ مَنْحَىً وَمُضْطَرَبْ",5,"ب",1,0],["على بحر بلُجّته أقاموا","لفلق البحر من نار كُرينا",6,"ن",2,0],["عليَّ بها السرى وعلى أيادي","بني الفاروق إدراك النجاح",7,"ح",1,0],["على باب سلطان العباد كأنها","لنظم ثناياها عقودٌ من الدُّرِّ",8,"ر",1,0],["عليّ بحر أفاض جوهره","فنظمته الورى بمقياس",9,"س",1,0],["على بَحْرِهِ يُرْوَى الظِّمَاءُ ونَحْوَهُ","يشيرُ إذا ما غُصَّ بالماء مَزْرَدُ",10,"د",1,0],["عليُّ بن يحيى ذو الجناب الذي غدا","مراد القوافي روضهُ المتناصي",11,"ص",2,0],["عَلَيَّ بِأَنّي لا أُخِلُّ بِخِدمَةٍ","وَأَبذُلُ مَجهودي وَأَنتَ المُخَيَّرُ",12,"ر",1,0],["عَلى بَرَدى إِذ قالَ إِن كانَ عَهدُهُم","أُضيعَ فَكونوا لا عَلَيَّ وَلا لِيا",13,"ي",2,0],["على بساط نسجته الربى","شتى الحُلَى والوشى غض طليل",14,"ل",1,0],["عَلى بابِ قِنَّسرينَ وَاللَيلُ لاطِخٌ","جَوانِبَهُ مِن ظُلمَةٍ بِمِدادِ",15,"د",1,0],["عَلِيُّ بنُ عيسى بنِ موسى بنِ طَلحَةَ ب","نِ سائِبٍ اِبنِ مالِكٍ حينَ يُرمَقُ",16,"ق",1,0],["عَلِيُّ بنُ يَحيى إِنَّهُ اِنتَسَبَ النَدى","إِلى عَمِّهِ عَمِّ الكِرامِ وَخالِهِ",17,"ل",2,0],["عَلِيُّ بَني الفَيّاضِ يَومَ نَوالِهِ","أَخو الغَيثِ في إِغزارِهِ وَاحتِفالِهِ",18,"ل",2,1],["عُلىً بَعُدَتْ مسافَتُها ومَجْدٌ","تَعالَى أن يَهُمَّ بهِ هُمامُ",19,"م",1,0],["عليّ بن حمدون الذي كان حَمْدُهُ","تُرَفَّعُ منه همّةُ المتكلمِ",20,"م",1,0],["عَلى بُخلٍ وَتَصريدٍ","وَقَبضِ نَوالِكُم قَبضا",21,"ض",2,0],["عَلى بِغالٍ وُسَّجٍ","قَد ضَمَّهُنَّ السَفَرُ",22,"ر",1,0],["عَلى بَيدانَةٍ بِبَناتِ قَينٍ","تَسوفُ صِلالَ مُبتَدٍّ ظَنونِ",23,"ن",1,0],["عَلى بُستانِ خَدَّيهِ","زَرافينَ مِنَ السِيَجِ",24,"ج",1,0],["عَلى بَشَرٍ كَأَنَّ الدُر","رَ يَعلوهُ إِذا عَرِقا",25,"ق",2,0],["على بيض دخاميزٍ","ولا أكلٍ ملطوخا",26,"خ",2,0],["على بُرحاءَ الشوق منا هجرتنا","وزدت على ما ليس يبلغه الهجر",27,"ر",1,0],["على برهَةٍ نالوا بها العزَّ والتُقى","ألا ولذيذَ العيش بالبر والصبر",28,"ر",1,0],["على بابها صاح طَيْرٌ غريبٌ","فَنَاحَ على طْيره بَانُها!",29,"ن",3,0],["على بيضة الاسلام قر أساسه","وطائره فوق السماكين حائم",30,"م",1,0],["علي بن عثمان بن يعقوب ما لها","مفاخر قد أربت على الحصر والعد",31,"د",1,0],["على \" بغداد \" ما بَقِيتْ سَلامٌ","يَضُوعُ كما ذَكَا للوَردِ نَشْر",32,"ر",1,0],["عَلَىُّ بْنُ عِيسى بْنِ مُوسى بن طَلْحَةَ","بْنِ سَائِبٍ بْنِ مَالِكٍ حِينَ يُرْمَقُ",33,"ق",1,0],["على باب ((كسرى)) رميت الجبين","وأسلمت نهديك يوم (السقيفه)",34,"ف",2,0],["علي بالكأس فالدنيا مهازلها","طغت على الناس لكن شر طغيان",35,"ن",1,0],["عليَّ بأنْ أبدي الجوهر مِن فَمي","وأجلو معانيها بيوت قَصيدي",36,"د",2,0],["على بن محمد يحكى كمالاً","علي بن محمد قولاً وفعلا",37,"ل",2,0],["عليَّ بها شكر تؤدى فروضه","ثناه يفوح المسك مني فيعبق",38,"ق",1,0],["على بن داود المليك ابن يوسف","خلائف لا بغياً تولوا ولا عدوى",39,"و",2,0],["عَلِيّ بنَ عيسى خَيرُ يَومَيكَ أَن تُرى","وَفَضلُكَ مَأمولٌ وَوَعدُكَ ناجِزُ",40,"ز",1,0],["عليِّ بنِ موسى مُواسي العُفاةِ","أبي القاسمِ السيِّدِ المُوسَويَ",41,"ي",1,0],["عليَّ بها مدخّنةً بندُ","عليَّ بها مُفَدَّمةً بقَزِّ",42,"ز",1,1],["على بابِ ذي حِجْبةٍ وَعْدُه","غرورٌ على كونه مستطيعا",43,"ع",2,0],["على بشباشة الخشني","أبي موسى بلا رد",44,"د",1,0],["على بسط الندى طبعت يداه","كما خلقت لقبض السيف قصدا",45,"د",2,0],["على بابها رضوان يرقب عودتي","وينظر ما أهدى له وهو الشعر",46,"ر",1,0],["عَلِيُّ بْنُ دَاوُدٍ عَلِيٌّ مَقَامُهُ","وَفِي الزُّهْدِ فِي الْفَانِي بَعِيدٌ مَرَامُهُ",47,"ه",1,1],["على(برج البراجن)أو (بصبرا)","و(شاتيلا) و(صيدا) والضواحي",48,"ح",2,0],["على بؤسٍ حوى شرَفاً وكبراً","فما حسدَ العزيزَ ولا المُعِزّا",49,"ز",2,0],["على بحرِها العمرانُ والنضرُ والغِنى","وقد كملت فيها صنوفُ الحضارة",50,"ه",1,0],["على بنيكِ غدا في أرضِهم أسداً","ولم يكن في حماهم غيرَ هتّاك",51,"ك",1,0],["عَلِيَّ بْنَ إدْريسَ بْنِ يَعْقوبَ وانْتَمَوا","لِيَحْيَى بْنِ عَبْدِ الواحِدِ بْنِ أبِي حَفْصِ",52,"ص",1,0],["عَلى بَيتِ عُصرونَ العَفاءُ فَما لَهُم","قَديمٌ وَلا عَندَ الفَخارِ حَديثُ",53,"ث",1,1],["على بساط الرضا والانس صف لهم","موائد المن ضاها نورها القمرا",54,"ر",2,0],["عَلى بابِ ابنِ مَعصومٍ أَنَخنا","فَفُزنا بالنَجاة وبالنَجاحِ",55,"ح",1,1],["على بساط العلم والعباده","والغيب عندي صار كالشهاده",56,"ه",1,0],["على بن أبي بكر الملاز إمامنا","وعمدتنا في نقل علم الحقيقة",57,"ه",1,0],["عل يبدو في الحسن خير عيش","وكفاني علم الإله بحالي",58,"ل",2,0],["عَليَّ بَغياً وَلي بِالسوء طالِبَةٌ","يا مَن نَجاتي بِهِ وَالنَفس ذاهِبَةٌ",59,"ه",1,0],["عليُّ ْبَن نَصْرٍ ما يزالُ مِنَ الوَرى","ثَناءٌ تَهاداهُ إليكَ المَواسِم",60,"م",1,0],["على بابها وفدُ العفاة وطَولُها","يَعُمُّ نفوساً أصبحت في المهالك",61,"ك",1,0],["على بساط العلم والعباده","على الصراط المستقيم",62,"م",1,0],["علَيَّ بِها لاكَنارِ الخَليلِ","فبَردُ المُدامِ يَزيدُ الفُتورا",63,"ر",2,1],["عَلَيَّ بَني ساقي الحَجيجِ تَتابَعَت","أَوائِلُ مِن مَعروفِكُم وَأَواخِرُ",64,"ر",1,0],["على بديع معانيك العروض بكى","بحور دمع من الأشجان ترتكضُ",65,"ض",1,0],["عَلى بادِئِ الإِنعَامِ فِيهِ تمامُهُ","وحَقٌّ عَلَى سِبْطِ الخِلافَةِ حَمدُهُ",66,"د",2,0],["على بابك اللهم ألقيت أرحلي","محملة ذنباً ومحشوةً رجا",67,"ج",2,0],["على بنت موسى رحمة اللَه إنها","برحمته في ظلمة القبر أخلق",68,"ق",1,0],["على بحبي واندماجي أشتفى","بعضَ الشفاءِ ويهتدى لوَّامى",69,"م",2,0],["على بيضاء مصقولٍ","عوارضُها من الدرنِ",70,"ن",1,0],["على بساطِكَ تُقضىَ كلُّ مُبْهِمةٍ","يعنو بها الخطْبُ او تعيا بها الخطَبُ",71,"ب",1,0],["على بوادٍ من يخاف اغتيابه","تبت لديها في الأنام مناقبه",72,"ب",2,0],["عُلى بهرت آياتها بطلائع","فهل في العُلى أيضاً نبي مقرب",73,"ب",1,0],["عَليُّ بنُ إبراهيمٍ بنِ عليّ ب","نِ إبراهيمٍ بن أحْمَدٍ ابن عامِرِ",74,"ر",1,0],["على بابهِ خطَّ المؤرِّخُ قائلاً","سلامٌ عليكم فادخُلوا البابَ سُجَّدا",75,"د",2,0],["على بَلَدِ السَّلامِ وساكِنيِها","سَلامُ اللهِ من غُرَفِ الجُنانِ",76,"ن",1,0],["على بابه الأَملاكُ تَزْحَمُ وفدَه","وإِن قَرُبوا بالإِذن فالوفدُ أَقرَبُ",77,"ب",1,0],["عَلى بَيعَةِ الإِسلامِ بايَعنَ مُصعَباً","كَراديسَ مِن خَيلٍ وَجَمعاً ضُبارِكا",78,"ك",2,0],["على بضعةِ المختار خير تحيّةٍ","لها مِن إلهِ العرش لا بَرِحَت تترى",79,"ر",2,0],["على بني العلم من إيقاد فكرته","سحائبٌ هطَلَت كالعارض الهتنِ",80,"ن",1,0],["عَلى بابك السامي تعوّقتُ مدّةً","وَما نلتُ لَما أَن دخلت مَرامي",81,"م",2,1],["عَلى باب سُلطان السلاطين سائلٌ","مِن الإنس بَينَ الجن يرجو نَوالَهُ",82,"ل",2,1],["على بساط بسطْناهُ لكلِّ مُنىً","محبوبةٍ وهوَى للنفس مُقتَرحِ",83,"ح",1,0],["على باب الهوى وقف الجمالُ","وفي كبدي بفتنته اشتعالُ",84,"ل",1,1],["على بعد آلاف ميل تحاد","ث خلا وتسمع ماذا حكى",85,"ك",2,0],["عليَّ بنَ 