{"poems":[[110,"خليلي","https://www.shoaraa.com/p11134",""],[55,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[79,"نشدتك هل أبصرت قبلي أو بعدي","https://www.aldiwan.net/poem36559.html","الطويل"],[88,"أيحصي معانيك القريض المهذب","https://www.aldiwan.net/poem10695.html","الطويل"],[88,"كحافظ ابراهيم لكنه","https://www.aldiwan.net/poem68860.html","السريع"],[95,"شهدنا زمانا في الكنانة ردنا","https://www.aldiwan.net/poem9798.html","عموديه"],[90,"أطالوا الحرب طاحنة زبونا","https://www.aldiwan.net/poem44459.html","الوافر"],[74,"خلقت على مرادي واقتراحي","https://www.aldiwan.net/poem18479.html","الوافر"],[74,"بدت في رداء الشعر باسمة الثغر","https://www.aldiwan.net/poem18703.html","الطويل"],[74,"سيج ورد الخدود بالآس","https://www.aldiwan.net/poem19018.html","المنسرح"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[53,"أبى القلب إلا وجده برخاص","https://www.aldiwan.net/poem64933.html","الطويل"],[72,"لأجلك سعيي واجتهادي وخدمتي","https://www.aldiwan.net/poem42897.html","الطويل"],[40,"ألم يسأل الركب الديار العوافيا","https://www.aldiwan.net/poem7821.html","الطويل"],[87,"ما وصل من تهوى على أنسة","https://www.aldiwan.net/poem7121.html","السريع"],[47,"عذيرك من نأي غدا وبعاد","https://www.aldiwan.net/poem63453.html","الطويل"],[47,"أفي كل دار منك عين ترقرق","https://www.aldiwan.net/poem65183.html","الطويل"],[47,"عذيري من واش بها لم أواله","https://www.aldiwan.net/poem65537.html","الطويل"],[47,"علي بني الفياض يوم نواله","https://www.aldiwan.net/poem65610.html","الطويل"],[63,"سحابك في السماح لها انسجام","https://www.aldiwan.net/poem51440.html","البسيط"],[82,"رمى الموت في عين التصبر بالدم","https://www.aldiwan.net/poem31279.html","الطويل"],[33,"ألا يا حبذا نجد","https://www.aldiwan.net/poem42468.html","الهزج"],[33,"هاج القريض الذكر","https://www.aldiwan.net/poem42501.html","مجزوء الرجز"],[41,"أمن دمن بشاجنة الحجون","https://www.aldiwan.net/poem53733.html","الوافر"],[54,"بخيل قد شقيت به","https://www.aldiwan.net/poem27178.html","مجزوء الوافر"],[50,"أيا من سار منطلقا","https://www.aldiwan.net/poem64435.html","مجزوء الوافر"],[50,"فلا أشرب داريا","https://www.aldiwan.net/poem66255.html","الهزج"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116962","الطويل"],[108,"وطن ينادي أهله!","https://www.poetsgate.com/ViewPoem.aspx?id=179349",""],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[79,"نشدتك هل أبصرت قبلي أو بعدي","https://www.poetsgate.com/ViewPoem.aspx?id=33937",""],[92,"بغداد على الغرق","https://www.poetsgate.com/ViewPoem.aspx?id=179069",""],[47,"أفي كُلّ دارٍ مِنكَ عَينٌ تَرَقْرَقُ","https://www.poetsgate.com/ViewPoem.aspx?id=32846",""],[102,"صنعاء .. في طائرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67705&r=&rc=192",""],[128,"عفا الصفا وانتفى من كوخ ندماني","https://www.aldiwan.net/poem23777.html","البسيط"],[132,"وما لي تمن غير لقياك ساعة","https://www.aldiwan.net/poem50623.html","الطويل"],[164,"إِذا سفك الدماء لديك حلا","https://www.aldiwan.net/poem58931.html","الوافر"],[164,"على غيرك البهتان والزور ينفق","https://www.aldiwan.net/poem58945.html","الطويل"],[164,"إليك فقد حملت قلبي من الهوي","https://www.aldiwan.net/poem59013.html","الطويل"],[168,"أبا حسن والمرء يخلق صورة","https://www.aldiwan.net/poem67825.html","الطويل"],[170,"وسقت الركائب حتى أنخن","https://www.aldiwan.net/poem46823.html","المتقارب"],[170,"علي بها مدخنة بند","https://www.aldiwan.net/poem47055.html","الوافر"],[189,"أعز الورى من أفاد القنوعا","https://www.aldiwan.net/poem14571.html","المتقارب"],[190,"لقد هاج لي الوجد","https://www.aldiwan.net/poem43978.html","الهزج"],[214,"بدا يختال كالقمر المفدى","https://www.aldiwan.net/poem13553.html","الوافر"],[215,"أطوف بأحلامي عليكم لعنى","https://www.aldiwan.net/poem46319.html","الطويل"],[241,"علي بن داود علي مقامه","https://www.aldiwan.net/poem19088.html","الطويل"],[255,"رُبى لبنان","https://www.aldiwan.net/poem39738.html","عموديه"],[274,"أقول لها إذا الطرب استفزا","https://www.aldiwan.net/poem35022.html","الوافر"],[274,"تذكرت في الحمراء عهد الصبوة","https://www.aldiwan.net/poem35637.html","الطويل"],[274,"حبي الخليفة مولانا ومولاك","https://www.aldiwan.net/poem35652.html","البسيط"],[279,"لأندلس البشرى وحضرتها حمص","https://www.aldiwan.net/poem25492.html","الطويل"],[286,"على بيت عصرون العفاء فما لهم","https://www.aldiwan.net/poem32840.html","الطويل"],[289,"الله أكبر ساد الحق وانتصرا","https://www.aldiwan.net/poem39420.html","البسيط"],[301,"على باب ابن معصوم أنخنا","https://www.aldiwan.net/poem33303.html","الوافر"],[308,"يا صاح قلبي ما سلا ولا طاب","https://www.aldiwan.net/poem16777.html","الرجز"],[308,"سلام على إخواننا والأحبة","https://www.aldiwan.net/poem16830.html","الطويل"],[308,"حي ظبي الرمال والأطلال","https://www.aldiwan.net/poem16833.html","الخفيف"],[357,"يا من تنزه عن إبن ووالدة","https://www.aldiwan.net/poem40353.html","البسيط"],[368,"أتلك رياض أم خدود نواعم","https://www.aldiwan.net/poem60665.html","الطويل"],[381,"خليلي مرا بي على ربع ناسك","https://www.aldiwan.net/poem59305.html","الطويل"],[395,"يا سعد قلبي ما سلا ولا طاب","https://www.aldiwan.net/poem54478.html","عموديه"],[409,"علي بها لاكنار الخليل","https://www.aldiwan.net/poem49582.html","المتقارب"],[414,"وسدت بهارون الثغور فأحكمت","https://www.aldiwan.net/poem67500.html","الطويل"],[433,"حكم المنية سهم والورى عرض","https://www.aldiwan.net/poem40708.html","البسيط"],[443,"جهادك حكم الله من ذا يرده","https://www.aldiwan.net/poem34888.html","الطويل"],[445,"أريحي الوجا يا ناق ما بعد ذا وجا","https://www.aldiwan.net/poem14299.html","الطويل"],[445,"لهذا خلقنا والجديد سيخلق","https://www.aldiwan.net/poem14465.html","الطويل"],[456,"الأربعون صدى فؤادي الدامي","https://www.aldiwan.net/poem61769.html","الكامل"],[461,"لمن ظعن سوائر لو","https://www.aldiwan.net/poem55846.html","مجزوء الوافر"],[461,"لكِ الغرام وللواشي بكِ التعب","https://www.aldiwan.net/poem56274.html","البسيط"],[516,"أرى كل مرتاب يخاف خياله","https://www.aldiwan.net/poem67787.html","الطويل"],[518,"هل القلب إلا مضغة تتقلب","https://www.aldiwan.net/poem12016.html","الطويل"],[532,"إمام البهاليل الألى سبقوا إلى","https://www.aldiwan.net/poem37418.html","الطويل"],[565,"مليك الورى عبد المجيد قد ابتنى","https://www.aldiwan.net/poem52677.html","الطويل"],[565,"لهذا الفرق دان الفرقدان","https://www.aldiwan.net/poem52922.html","الوافر"],[578,"على كل حال ليس لي عنك مذهب","https://www.aldiwan.net/poem3109.html","الطويل"],[1163,"","https://poetry.dctabudhabi.ae/diwan/poem/28923","الطويل"]],"verses":[["عليّ بلأواء النوى كل موقف","يراع به قتلي ويعظم مقتلي",0,"ل",2,0],["عُلىً بيدِ الحُسَينِ ذُؤابَتاها","وَفَرعاها اللَذا كَثُرا وَطابا",1,"ب",2,0],["علِيِّ بْنِ عُثْمانَ بْنِ يعْقوبَ يا لَها","مَفاخِرَ قدْ أرْبَتْ علَى الحَصْرِ والعَدِّ",2,"د",1,0],["عَلى بابِهِ العالي هُناكَ تَأَلَّقَت","سُطورٌ لِأَقلامِ الجَلالَةِ تُنسَبُ",3,"ب",1,0],["عَلى بِلادِ النيلِ تِلكَ الَّتي","تاهَت بِأَصحابِ الذَكا النادِرِ",4,"ر",1,0],["عَلَى بَرَكَاتِ اللهِ سِيرُوا مَسِيرَكُمْ","وَصِيدْوا الْمُنَى مِنْ كُلِّ مَنْحَىً وَمُضْطَرَبْ",5,"ب",1,0],["على بحر بلُجّته أقاموا","لفلق البحر من نار كُرينا",6,"ن",2,0],["عليَّ بها السرى وعلى أيادي","بني الفاروق إدراك النجاح",7,"ح",1,0],["على باب سلطان العباد كأنها","لنظم ثناياها عقودٌ من الدُّرِّ",8,"ر",1,0],["عليّ بحر أفاض جوهره","فنظمته الورى بمقياس",9,"س",1,0],["على بَحْرِهِ يُرْوَى الظِّمَاءُ ونَحْوَهُ","يشيرُ إذا ما غُصَّ بالماء مَزْرَدُ",10,"د",1,0],["عليُّ بن يحيى ذو الجناب الذي غدا","مراد القوافي روضهُ المتناصي",11,"ص",2,0],["عَلَيَّ بِأَنّي لا أُخِلُّ بِخِدمَةٍ","وَأَبذُلُ مَجهودي وَأَنتَ المُخَيَّرُ",12,"ر",1,0],["عَلى بَرَدى إِذ قالَ إِن كانَ عَهدُهُم","أُضيعَ فَكونوا لا عَلَيَّ وَلا لِيا",13,"ي",2,0],["على بساط نسجته الربى","شتى الحُلَى والوشى غض طليل",14,"ل",1,0],["عَلى بابِ قِنَّسرينَ وَاللَيلُ لاطِخٌ","جَوانِبَهُ مِن ظُلمَةٍ بِمِدادِ",15,"د",1,0],["عَلِيُّ بنُ عيسى بنِ موسى بنِ طَلحَةَ ب","نِ سائِبٍ اِبنِ مالِكٍ حينَ يُرمَقُ",16,"ق",1,0],["عَلِيُّ بنُ يَحيى إِنَّهُ اِنتَسَبَ النَدى","إِلى عَمِّهِ عَمِّ الكِرامِ وَخالِهِ",17,"ل",2,0],["عَلِيُّ بَني الفَيّاضِ يَومَ نَوالِهِ","أَخو الغَيثِ في إِغزارِهِ وَاحتِفالِهِ",18,"ل",2,1],["عُلىً بَعُدَتْ مسافَتُها ومَجْدٌ","تَعالَى أن يَهُمَّ بهِ هُمامُ",19,"م",1,0],["عليّ بن حمدون الذي كان حَمْدُهُ","تُرَفَّعُ منه همّةُ المتكلمِ",20,"م",1,0],["عَلى بُخلٍ وَتَصريدٍ","وَقَبضِ نَوالِكُم قَبضا",21,"ض",2,0],["عَلى بِغالٍ وُسَّجٍ","قَد ضَمَّهُنَّ السَفَرُ",22,"ر",1,0],["عَلى بَيدانَةٍ بِبَناتِ قَينٍ","تَسوفُ صِلالَ مُبتَدٍّ ظَنونِ",23,"ن",1,0],["عَلى بُستانِ خَدَّيهِ","زَرافينَ مِنَ السِيَجِ",24,"ج",1,0],["عَلى بَشَرٍ كَأَنَّ الدُر","رَ يَعلوهُ إِذا عَرِقا",25,"ق",2,0],["على بيض دخاميزٍ","ولا أكلٍ ملطوخا",26,"خ",2,0],["على بُرحاءَ الشوق منا هجرتنا","وزدت على ما ليس يبلغه الهجر",27,"ر",1,0],["على برهَةٍ نالوا بها العزَّ والتُقى","ألا ولذيذَ العيش بالبر والصبر",28,"ر",1,0],["على بابها صاح طَيْرٌ غريبٌ","فَنَاحَ على طْيره بَانُها!",29,"ن",3,0],["على بيضة الاسلام قر أساسه","وطائره فوق السماكين حائم",30,"م",1,0],["علي بن عثمان بن يعقوب ما لها","مفاخر قد أربت على الحصر والعد",31,"د",1,0],["على \" بغداد \" ما بَقِيتْ سَلامٌ","يَضُوعُ كما ذَكَا للوَردِ نَشْر",32,"ر",1,0],["عَلَىُّ بْنُ عِيسى بْنِ مُوسى بن طَلْحَةَ","بْنِ سَائِبٍ بْنِ مَالِكٍ حِينَ يُرْمَقُ",33,"ق",1,0],["على باب ((كسرى)) رميت الجبين","وأسلمت نهديك يوم (السقيفه)",34,"ف",2,0],["علي بالكأس فالدنيا مهازلها","طغت على الناس لكن شر طغيان",35,"ن",1,0],["عليَّ بأنْ أبدي الجوهر مِن فَمي","وأجلو معانيها بيوت قَصيدي",36,"د",2,0],["على بن محمد يحكى كمالاً","علي بن محمد قولاً وفعلا",37,"ل",2,0],["عليَّ بها شكر تؤدى فروضه","ثناه يفوح المسك مني فيعبق",38,"ق",1,0],["على بن داود المليك ابن يوسف","خلائف لا بغياً تولوا ولا عدوى",39,"و",2,0],["عَلِيّ بنَ عيسى خَيرُ يَومَيكَ أَن تُرى","وَفَضلُكَ مَأمولٌ وَوَعدُكَ ناجِزُ",40,"ز",1,0],["عليِّ بنِ موسى مُواسي العُفاةِ","أبي القاسمِ السيِّدِ المُوسَويَ",41,"ي",1,0],["عليَّ بها مدخّنةً بندُ","عليَّ بها مُفَدَّمةً بقَزِّ",42,"ز",1,1],["على بابِ ذي حِجْبةٍ وَعْدُه","غرورٌ على كونه مستطيعا",43,"ع",2,0],["على بشباشة الخشني","أبي موسى بلا رد",44,"د",1,0],["على بسط الندى طبعت يداه","كما خلقت لقبض السيف قصدا",45,"د",2,0],["على بابها رضوان يرقب عودتي","وينظر ما أهدى له وهو الشعر",46,"ر",1,0],["عَلِيُّ بْنُ دَاوُدٍ عَلِيٌّ مَقَامُهُ","وَفِي الزُّهْدِ فِي الْفَانِي بَعِيدٌ مَرَامُهُ",47,"ه",1,1],["على(برج البراجن)أو (بصبرا)","و(شاتيلا) و(صيدا) والضواحي",48,"ح",2,0],["على بؤسٍ حوى شرَفاً وكبراً","فما حسدَ العزيزَ ولا المُعِزّا",49,"ز",2,0],["على بحرِها العمرانُ والنضرُ والغِنى","وقد كملت فيها صنوفُ الحضارة",50,"ه",1,0],["على بنيكِ غدا في أرضِهم أسداً","ولم يكن في حماهم غيرَ هتّاك",51,"ك",1,0],["عَلِيَّ بْنَ إدْريسَ بْنِ يَعْقوبَ وانْتَمَوا","لِيَحْيَى بْنِ عَبْدِ الواحِدِ بْنِ أبِي حَفْصِ",52,"ص",1,0],["عَلى بَيتِ عُصرونَ العَفاءُ فَما لَهُم","قَديمٌ وَلا عَندَ الفَخارِ حَديثُ",53,"ث",1,1],["على بساط الرضا والانس صف لهم","موائد المن ضاها نورها القمرا",54,"ر",2,0],["عَلى بابِ ابنِ مَعصومٍ أَنَخنا","فَفُزنا بالنَجاة وبالنَجاحِ",55,"ح",1,1],["على بساط العلم والعباده","والغيب عندي صار كالشهاده",56,"ه",1,0],["على بن أبي بكر الملاز إمامنا","وعمدتنا في نقل علم الحقيقة",57,"ه",1,0],["عل يبدو في الحسن خير عيش","وكفاني علم الإله بحالي",58,"ل",2,0],["عَليَّ بَغياً وَلي بِالسوء طالِبَةٌ","يا مَن نَجاتي بِهِ وَالنَفس ذاهِبَةٌ",59,"ه",1,0],["عليُّ ْبَن نَصْرٍ ما يزالُ مِنَ الوَرى","ثَناءٌ تَهاداهُ إليكَ المَواسِم",60,"م",1,0],["على بابها وفدُ العفاة وطَولُها","يَعُمُّ نفوساً أصبحت في المهالك",61,"ك",1,0],["على بساط العلم والعباده","على الصراط المستقيم",62,"م",1,0],["علَيَّ بِها لاكَنارِ الخَليلِ","فبَردُ المُدامِ يَزيدُ الفُتورا",63,"ر",2,1],["عَلَيَّ بَني ساقي الحَجيجِ تَتابَعَت","أَوائِلُ مِن مَعروفِكُم وَأَواخِرُ",64,"ر",1,0],["على بديع معانيك العروض بكى","بحور دمع من الأشجان ترتكضُ",65,"ض",1,0],["عَلى بادِئِ الإِنعَامِ فِيهِ تمامُهُ","وحَقٌّ عَلَى سِبْطِ الخِلافَةِ حَمدُهُ",66,"د",2,0],["على بابك اللهم ألقيت أرحلي","محملة ذنباً ومحشوةً رجا",67,"ج",2,0],["على بنت موسى رحمة اللَه إنها","برحمته في ظلمة القبر أخلق",68,"ق",1,0],["على بحبي واندماجي أشتفى","بعضَ الشفاءِ ويهتدى لوَّامى",69,"م",2,0],["على بيضاء مصقولٍ","عوارضُها من الدرنِ",70,"ن",1,0],["على بساطِكَ تُقضىَ كلُّ مُبْهِمةٍ",