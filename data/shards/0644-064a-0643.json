],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128922","الخفيف"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/132068","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95318","الطويل"],[3890,"","https://poetry.dctabudhabi.ae/diwan/poem/124624","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111447","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77070","الرجز"],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141840","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81273","الخفيف"],[4268,"","https://poetry.dctabudhabi.ae/diwan/poem/144265","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83668","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72377","المجتث"],[4755,"قَيِّدْ فَضَائِي.. وهَبْ لِي مِعْطَفًا وعَصَا","https://www.poetsgate.com/ViewPoem.aspx?id=184668",""],[4762,"جوهر اليقين","https://www.poetsgate.com/ViewPoem.aspx?id=212900",""],[4852,"عندما","https://www.poetsgate.com/ViewPoem.aspx?id=214366",""],[4888,"الشاطئان مصر والإمارات","https://www.poetsgate.com/ViewPoem.aspx?id=207744",""],[4897,"أظن الدهر قد آلى فبرا","https://www.poetsgate.com/ViewPoem.aspx?id=98898",""],[4927,"لصوص المخابرات","https://www.poetsgate.com/ViewPoem.aspx?id=80802",""],[4968,"أذكر سميرة كي تطيب لك اللحون","https://www.poetsgate.com/ViewPoem.aspx?id=208551",""],[4978,"!! أي وطن !!","https://www.poetsgate.com/ViewPoem.aspx?id=181591",""],[4984,"أ تريد أن تحكي الحكاية","https://www.poetsgate.com/ViewPoem.aspx?id=215861",""],[5072,"إدانة الصفصاف","https://www.poetsgate.com/ViewPoem.aspx?id=55364",""],[457,"ِليك نزعة آداب يَرِنُّ بها","https://www.poetsgate.com/ViewPoem.aspx?id=40734",""],[5145,"كنت التمست أخا العلى والسؤدد","https://www.poetsgate.com/ViewPoem.aspx?id=108205",""],[5149,"رسولَ اللهِ قد عَظُمَ البَلاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=212566",""],[5183,"مُلْغِزَه رق282م","https://www.poetsgate.com/ViewPoem.aspx?id=186400",""],[5183,"من وحي الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=180196",""],[5246,"ترددت قبل العزم نحوك يا مصر","https://www.poetsgate.com/ViewPoem.aspx?id=187026",""],[5324,"يامظهر الوجه الضحك.","https://www.poetsgate.com/ViewPoem.aspx?id=211079",""],[5324,"الفراق الجميل.","https://www.poetsgate.com/ViewPoem.aspx?id=211580",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5351,"وجع الجبال","https://www.poetsgate.com/ViewPoem.aspx?id=202145",""],[5351,"القادم أولاً وثانياً","https://www.poetsgate.com/ViewPoem.aspx?id=202236",""],[5518,"سلاماً على المختار/إسماعيل الصيّاح","https://www.poetsgate.com/ViewPoem.aspx?id=197226",""],[5599,"جرح الفقد","https://www.poetsgate.com/ViewPoem.aspx?id=213840",""],[5615,"رسالة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=187951",""],[5628,"ثورة حواء","https://www.poetsgate.com/ViewPoem.aspx?id=178669",""],[5688,"لو كان يملك...","https://www.poetsgate.com/ViewPoem.aspx?id=200776",""],[5690,"للقاك يوم جاء كالسمك أسعدُ","https://www.poetsgate.com/ViewPoem.aspx?id=172145",""],[5776,"الغلام والملكة","https://www.poetsgate.com/ViewPoem.aspx?id=199336",""],[5859,"الموعد","https://www.poetsgate.com/ViewPoem.aspx?id=29421",""],[5897,"الحياء في لحظات الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=157485",""],[5943,"الموت حرقًا","https://www.poetsgate.com/ViewPoem.aspx?id=34329",""],[6142,"أذاكر أنت أم ناس خطاب رسو","https://www.poetsgate.com/ViewPoem.aspx?id=155718",""]],"verses":[["لِيَكثُرَن خَطوُكِ أَو تَنتَعِلي","سَريرَ مُلكٍ أَو مَراقي مِنبَرِ",0,"ر",1,0],["لي كُلَّ عامٍ وَقفَةٌ","حَرّى عَلى مُتَرَحِّلِ",1,"ل",1,0],["لي كِساءٌ أَنعِم بِهِ مِن كِساءِ","أَنا فيهِ أَتيهُ مِثلَ الكِسائي",2,"ا",2,1],["لي كُلَّ حَولٍ لِبَيتِ الجاهِ مُنتَجَعٌ","كَما تُشَدُّ لِبَيتِ اللَهِ أَرحالُ",3,"ل",1,0],["لِيَكْلأُهُ رَبُّ العُلَى وَلَيَصُنْ","مِنَ الدَّهْرِ حِصْنَ البِلادِ الحَصِينْ",4,"ن",1,0],["لِيَكُنْ فِدًى لَكَ يَا أَلِيفَ طُفُولَتِي","أَنْ بِتُّ فِيكَ أَلِيفَةَ الأَشْجَانِ",5,"ن",1,0],["ليكون فيه شفاؤهم من جهلهم","ومن الظما ومن الطوى ومن الضنى",6,"ن",2,0],["ليكون مكتسباً بها","مالاً تهالك في اكتسابه",7,"ب",2,0],["لِيَكونَ جِيراني أُكالاً بَينَكُم","بُخلاً لِكِندِيٍّ وَسَبيٍ مُزنِدِ",8,"د",1,0],["ليكونَ الإنسانُ في غاية التعْ","ديلِ بين السراء والضراءِ",9,"ا",2,0],["ليكون باباً للفيا","شل عَجَّل اللَّه اجتبابهْ",10,"ب",2,0],["لِيَكفِكَ حاسداً حَسَدُهْ","وما تَصْلى به كَبِدُهْ",11,"د",2,1],["ليكفك من جر المخازي عليهِمُ","مكانك منهم فهْو أخزى وأعور",12,"ر",1,0],["ليكُنْ بعضكم لبعض ظهيراً","ثم قوموا لسطوتِي حين أسطو",13,"ط",2,0],["ليكبت أعدائي ويرغم حسَّدي","ويقمعهم عن شِرَّةِ البغي قامع",14,"ع",1,0],["ليكفيكَ ما قد قيل مما تقولُه","فلا تَكُ ممن يَعنِه اللَّه بالعَنا",15,"ن",2,0],["لِيَكونَ حَظُّ الحَيِّ مِن شُكرانِكُم","جَمّاً وَحَظُّ المَيتِ مِنهُ جَزيلا",16,"ل",2,0],["لِيَكتَنِفكَ السُرورُ وَالفَرَحُ","وَلا يَفُتكَ الإِبريقُ وَالقَدَحُ",17,"ح",1,1],["لَيُكافِئَنَّكَ عَن كِفايَتِكَ الَّتي","كانَت أَمانَ الدينِ بَعدَ تَخَوُّفِ",18,"ف",1,0],["لي كُلَّ يَومٍ مِنكَ عُذرٌ واضِحٌ","وَأَخافُ أَن يُقضي إِلى تَصحيفِهِ",19,"ه",1,0],["ليكُنْ منك يا بحيرةُ ما لجَّ","بك الصمتُ أو جنون اصطخابكْ",20,"ك",1,0],["ليكنْ هاتفٌ من الصوتِ يتلو","قد أحبَّا وأخلصا ما أحبا",20,"ب",2,0],["ليَكُنْ لكمْ في كلِّ أفقٍ طائرٌ","ليكُنْ لكمْ في كلِّ أرضٍ باني",21,"ن",2,0],["لِيَكُنْ بَيْتُكَ الَّذِي شِدْتَ صَرْحاً","رُكْنُهُ المَجْدُ وَالرِّفَاءُ الْعِمَادُ",22,"د",1,0],["لِيكنْ سَخَاءَكَ وَالحَياةُ سفِينَةٌ","فِي الدَّهْرِ بَيْنَ إِقَامَةٍ وَرحِيلِ",23,"ل",1,0],["لِيَكُنْ لَكِ الْحَظُّ الَّذِي تَرْجِينَهُ","فَلَقَدْ ظَفِرْتِ بِأَكْرَمِ الأَكْفَاءِ",24,"ا",2,0],["لي كُلَّ يَومٍ مِنهُمُ قِصَّةٌ","مِن أَمَةِ الواحِدِ أَو مِن صَقيل",25,"ل",1,0],["ليكُنْ أمامَكُمُ كتابٌ صارخٌ","فيه ثوابٌ يُرتَجى وعِقاب",26,"ب",1,0],["لِيَكُنْ عَزاؤكَ أَنَّ هَذا الْحَبْلَ ما","صَنَعَتْهُ في هِذي الرُّبوعِ يَدانِ",27,"ن",1,0],["ليكن لكم في كلّ أفق طائر","ليكن لكم قس كلّ أرض باني",28,"ن",2,0],["لي كل يومٍ منك موقف ذلة","صعبٌ على الطبع الحمي شديد",29,"د",1,0],["لي كؤوسٌ من مراشفه","ومن الأطيار ندمان",30,"ن",1,0],["ليكونَ الفؤادُ منكَ مُرِيحاً","مستَرِيحاً من تَرْحَةٍ وشقاءِ",31,"ا",2,0],["لي كلَّ يومٍ هَوىً جديدٌ","بلا وصالٍ ولا لِقاء",32,"ا",2,0],["ليّ كونوا مثلما كان الأولي","سلفوا لي أهل سعيِ لا يُردّ",33,"د",1,0],["لي كلُّ هذا في بِلادي وَلي","في البَيتِ أُختٌ شعرُها أَشقُر",34,"ر",1,0],["لِيَكيدَهُ فَكَفاهُ رَبٌّ لَم يَزَل","يَحميهِ كَيدَ الساحِرِ الخَزيانِ",35,"ن",1,0],["ليكون بوصلك مبتهجي","للمؤمن ورد الذكر حلا",36,"ل",2,0],["ليكثر الصَّب مِنْ ذكرى أَحبَّتِهِ","فالذِّكْرُ ما زال بِالتَّقريبِ مقرونا",37,"ن",2,0],["ليكاد يذهبها شعاعاً يأْسُها","لولا أمانٍ يعترضنَ فجاجها",38,"ج",3,0],["ليكونَ غداةَ الفَخْرِ به","لإمامِ العَصرِ يُقلِّده",39,"د",2,0],["ليكن عقابكِ لي بحسب تجلدي","لا بالنوى فضعيفةٌ عنها يدي",40,"د",2,1],["لي كلّ يومٍ رَوعةٌ بمودَّعٍ","ونَوىً فَهمِّي طارِفٌ وقديمُ",41,"م",1,0],["ليكيد فيها المسلمين بخدعة","لا يعرف الشيطان كيف يكيد",42,"د",1,0],["ليَ كالنَّخْلَةِ السَّحوقِ حديثٌ","غَيْرَ أَنِّي كما غَرَسْتُ النَّواتا",43,"ت",2,0],["ليكون بين المنجبين الشاذلي","يجني ثمار نجاته مسرورا",44,"ر",2,0],["لي كل يوم معها","حكاية تسطر",45,"ر",1,0],["لِي كلَّ يومٍ من جميلك مِنّةٌ","غرّاءُ تأتينِي وتقرعُ بابي",46,"ب",2,0],["لي كاتب يمحو السطور وينسخُ","وتراه يحكم ما أراد وينسخُ",47,"خ",1,1],["لي كُلَّ يَوْمٍ مَعَ الأَيام نائبةٌ","تسْطُو فتفْرِسُ أَشبَالِي وآسَادِي",48,"د",2,0],["ليكشف عنا الهم والغم والأسى","فنحن على أوصابها نترقب",49,"ب",1,0],["لي كُلَّما هَزَّ لُؤي البَينِ مِن كَبَدي","وَمِن دُمُوعي إحراقٌ وإغراقَُ",50,"ق",1,0],["ليكبح صولة أمواجه","فيأمن في جونها ما رسا",51,"س",2,0],["لي كلَّ آونةٍ شعرٌ تردده","عني التصاريف فيكم أي ترديد",52,"د",1,0],["ليكن لكم يا آل قصاب ولي","نفس على ضيق المعيشة صابرة",53,"ه",1,0],["لي كُلَّ يومٍ بهِ في الشِّعرِ قافيةٌ","فلَيسَ يَنْفَدُ حَتَّى يَنْفَدَ الزَّمَنُ",54,"ن",1,0],["ليكن ما تريده عيناك","ولامت بالهوى شهيدَ هواك",55,"ك",1,1],["لي كلّ عام مديحٌ فيه أبعثه","إليه تمليه أفكاري على قلم",56,"م",1,0],["ليكن قولكم أقلّ من الفع","ل فلن يبلغ العلاء الفجور",57,"ر",1,0],["لي كثر همّي طفى ضيجي","باتبعه ماني مخلّنّه",58,"ن",2,0],["لِيَكُن لَدَيكَ لِسائِلٍ فَرَجٌ","إِن لِم يَكُن فَليَحسُن الرَدُّ",59,"د",1,0],["لي كان في رَصَّةْ جِسِي الوقت محمود","هل كيف فِعْلَه في لياليه لَرْغاد",60,"د",1,0],["لي كُلَّ حينٍ مِن أَحِبّايَ حَين","وَكُلَّ يَومٍ بَينَ هَجرٍ وَبَين",61,"ن",1,1],["ليكف عنِّي عذله لوسيلةٍ","عظماً بها الرسل الكرام توسلوا",62,"ل",3,0],["ليكف واصفه فإن جليّه","لا دقّ من غيب الغيوب واشكل",62,"ل",1,0],["لي كتاب جمعت فيه فنونا","من ظريف الاشعار والاخبار",63,"ر",1,0],["ليكتسبا أن السكون استكانةٌ","وأن اقتناصُ الخيرِ نت حفظِ ذي الطولِ",64,"ل",1,0],["ليكبُ لساني إنْ ذكرتُ له الهوى","وتنطق عنّي بالغرامِ المدامعُ",65,"ع",1,0],["لي كلّ يوم من عروض هواه ما","مقصوره يغنيه عن ممدوده",66,"د",2,0],["ليكون الكلُّ في رحمتِه","إنه قال هو البرُّ الرحيم",67,"م",1,0],["لي كل ما شئتُ أخفيه وأظهرُه","من العماءِ إلى الأركان في السفل",68,"ل",1,0],["ليكون أول فارس شهد الوغى","ويقيم في أعلى الجحافل مشهدا",69,"د",2,0],["ليكون مفتتح النهار وختمه","تجريدك التوحيد للديان",70,"ن",1,0],["لي كُلُّ يَوم آيَةٌ مَشهورَة","فيهِ إِذا نُثِرَت عَلَيهِ الأَنجُمُ",71,"م",1,0],["ليكُن في كريمِ علمكِ أنِّي","لستُ أنسى الوداعَ يومَ الرحيلِ",72,"ل",1,0],["لي كلما ابتسم النهارُ تعلةٌ","بمحدثٍ ما شان قلبي شانه",73,"ه",1,1],["لِيَكونَ تَضليلُ المُضِلِّ مُجَسَّماً","وَيَرى مِنَ الشَعبِ ازدِراهُ وَامتِهانَه",74,"ن",2,0],["لِيَكُن مثله العَظيم جِهاداً","لِيَكُن مثله الطرير اِمتِشاقا",75,"ق",2,0],["لِيَكُن كلّنا كَما كانَ قح","طان أَو جدّنا وَجدّ أَبينا",76,"ن",2,0],["لي كل فتان الترائب ضامر ال","شحين يذكره الفؤاد فيخفق",77,"ق",1,0],["ليَكلا اللَهُ أَعداءي فانهمُ","قد قلَّدونيَ أطواقاً من المِنَنِ",78,"ن",1,0],["ليكونوا رجال علم صحيح","وجميلي الاعمال والغايات",79,"ت",1,0],["ليكفيكم ما فيكم من جوى نلق","فمهلاً بنا مهلاً ورفقاً بنا رفقا",80,"ق",2,1],["ليكرهُ طَعمُ الموتِ والموتُ طالبٌ","فَكيفَ يَلذُّ الموتُ والموتُ مطلوبُ",81,"ب",1,0],["ليكفينا شرّ الدنيا وأهلها","واهوال يوم لا تقاس شدائده",82,"د",2,0],["ليكون ساقي زفس بينهم","فلذاك في أولمبهم سعدا",83,"د",2,0],["لِيَكِلَّ وَقعُ نِصاَلِكُم وَقنيِّكُم","وأَخِيلُ لَيسَ بِجُملَةِ الأَعدادِ",84,"د",1,0],["لي كُل ذَنبٍ أَنتَ خَيرَ مَن دَعي","وَلَيسَ لي إِلّا إِلَيكَ مَفزَعي",85,"ي",1,0],["ليكسر جمع الشرك مفرد عزمه","إذا ما تثنى الرمح سكرا وعربدا",86,"د",2,0],["لِيَكاد اليَراع يَهتَز مِن شَو","ق فَيُملي عَلي وَحيّ جِنانه",87,"ن",2,0],["لي كل يوم كربةٌ من نكبةٍ","يهمي لها جفني وقلبي يصطلي",88,"ل",2,0],["لي كُلّ يَوم من أَياديهِ يدٌ","بَيضا تُضافُ إلى يَدٍ بَيضاءِ",89,"ا",2,0],["لي كل يوم عويل","على الحسين ومأتم",90,"م",1,1],["لِي كَأسُهُ.. واشتِهَاءٌ قالَ صَادِقُهُ:","لَنْ يَبلُغَ المَاءَ إلَّا كُلُّ مَن خَرَصَا",91,"ص",2,0],["لي كل ليل شهقة في خلوتي","أزجي بها صوب المهيمن ذي الجلال",92,"ل",1,0],["ليُكفّرَ ..النبضَ الذي ..","ذاقَ المرارَ العَلقمَا",93,"م",2,0],["لي كلَّ يومٍ مواقيتٌ أواعدُها","وصُحبةٌ في رُبوعِ المجدِ أعوانُ",94,"ن",1,0],["ليكسب من اقاصي الأفق كسباً","يحل به المحل المشمخرا",95,"ر",2,0],["لِيَكْتُبَ سِيْرَةَ الثُّوَّاْرِ شَعْبٌ","تَأَبَّىْ أَنْ يُذَلَّ، وَأَنْ يُبَاْدَاْ",96,"د",2,0],["ليكن هوانا مثل روض زاهر","فالودُّ عطّر رُوحَنا كالزّيزفون.",97,"ن",1,0],["ليكون دارًا لليهود وباركتْ","مسعاهما منا (رؤوسُ بني بُوَيْهْ)",98,"ي",2,0],["ليكرر الأحداث رغم مُضِيِّها","ويثير نشوة سحر ما ضيها بهاء",99,"ا",2,0],["لي كلُّ هذا الصوتِ .. غُصّتُهُ ندىً","آفاق ُ رجعتِه ِ وجوهرُ نُدْرَتِهْ",100,"ت",2,0],["ِليك نزعة آداب يَرِنُّ بها","طيرُ الفصاحة إيناساً وتطريبا",101,"ب",2,1],["ليكون في وضح النهار منادمي","وماسمري في ليلةٍ لم أرقد",102,"د",1,0],["لِيَكْشِفَ غَيْهَباً يَعْلُو سَمَاهَا","فَلَيْلُ الجَّهْلِ يَمْحَقُهُ الضِّيَاءُ",103,"ا",2,0],["ليكتم السر مطويا بخاتمه","عليه قهر معنَّى القلب طياش",104,"ش",1,0],["ليكتب معنى الحمد شعراً على الوفا","ويختمه بالمسك في نفح طيبه",105,"ب",2,0],["ليكرمني بالعلم فيها وبالتقى","ويحفظني من كل ما شأنه الشر",106,"ر",1,0],["ليكون عمرك للعراق مضاعفا","قربان من نذروا الحياة له الفدا",107,"د",2,0],["ليكن فراقك كاللقاء جميلا","خلا يودع بالدموع خليلا.",108,"ل",2,1],["ليكشف عنه الهم والغم والأسى","ويقضي له الحاجات كالمنعم المسدي",109,"د",2,0],["ليكن عبور الحالكاتِ","بمعجزاتكَ يا مُعين",110,"ن",1,0],["ليك