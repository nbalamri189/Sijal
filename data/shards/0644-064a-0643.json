{"poems":[[53,"قد زيلت عظيمة فشمري","https://www.aldiwan.net/poem30450.html","الرجز"],[86,"جل الأسى فتجملي","https://www.aldiwan.net/poem10486.html","مجزوء الكامل"],[86,"لي كساء أنعم به من كساء","https://www.aldiwan.net/poem68838.html","الخفيف"],[86,"قالوا صدقت فكان الصدق ما قالوا","https://www.aldiwan.net/poem68960.html","البسيط"],[93,"مددت طرافك للائدين","https://www.aldiwan.net/poem11200.html","المتقارب"],[93,"طفلان كالأخوين مؤتلفان","https://www.aldiwan.net/poem11268.html","الكامل"],[88,"لو كنت أعبد فانيا في ذي الدنى","https://www.aldiwan.net/poem44427.html","الكامل"],[88,"سر في حياتك سير نابه","https://www.aldiwan.net/poem44813.html","مجزوء الكامل"],[11,"أبلغ بني لأم بأن خيولهم","https://www.aldiwan.net/poem239.html",""],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"ليكفك حاسدا حسده","https://www.aldiwan.net/poem11457.html","مجزوء الوافر"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[51,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[51,"رفعت إلى وديك أبصار همتي","https://www.aldiwan.net/poem65396.html","الطويل"],[51,"أقول لراجي خالدٍ إذ رأيته","https://www.aldiwan.net/poem66530.html","الطويل"],[85,"قم للمعلم وفه التبجيلا","https://www.aldiwan.net/poem15422.html","الكامل"],[45,"ليكتنفك السرور والفرح","https://www.aldiwan.net/poem62695.html","المنسرح"],[45,"أتراك تسمع للحمام الهتف","https://www.aldiwan.net/poem65160.html","الكامل"],[66,"يا مانحي محض الوعود ومانعي","https://www.aldiwan.net/poem38723.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54704","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55189","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12821","السريع"],[90,"المجلس المفجوع","https://www.poetsgate.com/ViewPoem.aspx?id=179038",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""]],"verses":[["لِيَكثُرَن خَطوُكِ أَو تَنتَعِلي","سَريرَ مُلكٍ أَو مَراقي مِنبَرِ",0,"ر",1,0],["لي كُلَّ عامٍ وَقفَةٌ","حَرّى عَلى مُتَرَحِّلِ",1,"ل",1,0],["لي كِساءٌ أَنعِم بِهِ مِن كِساءِ","أَنا فيهِ أَتيهُ مِثلَ الكِسائي",2,"ا",2,1],["لي كُلَّ حَولٍ لِبَيتِ الجاهِ مُنتَجَعٌ","كَما تُشَدُّ لِبَيتِ اللَهِ أَرحالُ",3,"ل",1,0],["لِيَكْلأُهُ رَبُّ العُلَى وَلَيَصُنْ","مِنَ الدَّهْرِ حِصْنَ البِلادِ الحَصِينْ",4,"ن",1,0],["لِيَكُنْ فِدًى لَكَ يَا أَلِيفَ طُفُولَتِي","أَنْ بِتُّ فِيكَ أَلِيفَةَ الأَشْجَانِ",5,"ن",1,0],["ليكون فيه شفاؤهم من جهلهم","ومن الظما ومن الطوى ومن الضنى",6,"ن",2,0],["ليكون مكتسباً بها","مالاً تهالك في اكتسابه",7,"ب",2,0],["لِيَكونَ جِيراني أُكالاً بَينَكُم","بُخلاً لِكِندِيٍّ وَسَبيٍ مُزنِدِ",8,"د",1,0],["ليكونَ الإنسانُ في غاية التعْ","ديلِ بين السراء والضراءِ",9,"ا",2,0],["ليكون باباً للفيا","شل عَجَّل اللَّه اجتبابهْ",10,"ب",2,0],["لِيَكفِكَ حاسداً حَسَدُهْ","وما تَصْلى به كَبِدُهْ",11,"د",2,1],["ليكفك من جر المخازي عليهِمُ","مكانك منهم فهْو أخزى وأعور",12,"ر",1,0],["ليكُنْ بعضكم لبعض ظهيراً","ثم قوموا لسطوتِي حين أسطو",13,"ط",2,0],["ليكبت أعدائي ويرغم حسَّدي","ويقمعهم عن شِرَّةِ البغي قامع",14,"ع",1,0],["ليكفيكَ ما قد قيل مما تقولُه","فلا تَكُ ممن يَعنِه اللَّه بالعَنا",15,"ن",2,0],["لِيَكونَ حَظُّ الحَيِّ مِن شُكرانِكُم","جَمّاً وَحَظُّ المَيتِ مِنهُ جَزيلا",16,"ل",2,0],["لِيَكتَنِفكَ السُرورُ وَالفَرَحُ","وَلا يَفُتكَ الإِبريقُ وَالقَدَحُ",17,"ح",1,1],["لَيُكافِئَنَّكَ عَن كِفايَتِكَ الَّتي","كانَت أَمانَ الدينِ بَعدَ تَخَوُّفِ",18,"ف",1,0],["لي كُلَّ يَومٍ مِنكَ عُذرٌ واضِحٌ","وَأَخافُ أَن يُقضي إِلى تَصحيفِهِ",19,"ه",1,0],["ليكُنْ منك يا بحيرةُ ما لجَّ","بك الصمتُ أو جنون اصطخابكْ",20,"ك",1,0],["ليكنْ هاتفٌ من الصوتِ يتلو","قد أحبَّا وأخلصا ما أحبا",20,"ب",2,0],["ليَكُنْ لكمْ في كلِّ أفقٍ طائرٌ","ليكُنْ لكمْ في كلِّ أرضٍ باني",21,"ن",2,0],["لِيَكُنْ بَيْتُكَ الَّذِي شِدْتَ صَرْحاً","رُكْنُهُ المَجْدُ وَالرِّفَاءُ الْعِمَادُ",22,"د",1,0],["لِيكنْ سَخَاءَكَ وَالحَياةُ سفِينَةٌ","فِي الدَّهْرِ بَيْنَ إِقَامَةٍ وَرحِيلِ",23,"ل",1,0],["لِيَكُنْ لَكِ الْحَظُّ الَّذِي تَرْجِينَهُ","فَلَقَدْ ظَفِرْتِ بِأَكْرَمِ الأَكْفَاءِ",24,"ا",2,0],["لي كُلَّ يَومٍ مِنهُمُ قِصَّةٌ","مِن أَمَةِ الواحِدِ أَو مِن صَقيل",25,"ل",1,0],["ليكُنْ أمامَكُمُ كتابٌ صارخٌ","فيه ثوابٌ يُرتَجى وعِقاب",26,"ب",1,0],["لِيَكُنْ عَزاؤكَ أَنَّ هَذا الْحَبْلَ ما","صَنَعَتْهُ في هِذي الرُّبوعِ يَدانِ",27,"ن",1,0]]}