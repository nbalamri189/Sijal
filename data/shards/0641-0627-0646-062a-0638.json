{"poems":[[79,"روع بالي وهاج بلبالي","https://www.aldiwan.net/poem36366.html","المنسرح"],[85,"لك الله من فذ الجلالة أوحد","https://www.aldiwan.net/poem54297.html","الطويل"],[93,"أروي لكمعن شاعر ساحير","https://www.aldiwan.net/poem62815.html","عموديه"],[91,"احبل الليل نهار","https://www.aldiwan.net/poem44680.html","مجزوء الرمل"],[87,"خليفة ما جاء حتى ذهبا","https://www.aldiwan.net/poem7913.html","الرجز"],[87,"كان لبعضهم حمار وجمل","https://www.aldiwan.net/poem8010.html","الرجز"],[52,"يا طلل الحي بذات الصمد","https://www.aldiwan.net/poem63943.html","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39587","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202547","الرجز"],[207,"عجبت لفخر الأوس والحين دائر","https://www.aldiwan.net/poem68163.html","الطويل"],[376,"دار ما دار بيننا وتردد","https://www.aldiwan.net/poem57500.html","الخفيف"],[438,"يا إماما أحسن به من إمام","https://www.aldiwan.net/poem12528.html","الخفيف"],[453,"حبذا والحال داجي الظلم","https://www.aldiwan.net/poem53777.html","الرمل"],[463,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[463,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[463,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[509,"هواك لا نوار الملامة ملمع","https://www.aldiwan.net/poem38404.html","الطويل"],[520,"خادم ذيل المجلس العادلي","https://www.aldiwan.net/poem12197.html","السريع"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56578","الخفيف"],[1385,"","https://poetry.dctabudhabi.ae/diwan/poem/178070","المنسرح"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124720","السريع"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126194","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87318","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202979","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132792","الرجز"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123944","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86378","الخفيف"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35464","الرمل"],[5072,"زمن","https://www.poetsgate.com/ViewPoem.aspx?id=34351",""],[5739,"حضن السراب","https://www.poetsgate.com/ViewPoem.aspx?id=126714",""],[6093,"يذكر النَّاس ُ كلَّ مَيْتٍ بخيرٍ ( الخفيف)","https://www.poetsgate.com/ViewPoem.aspx?id=176024",""],[6142,"الله ما أسناك يا كوكب","https://www.poetsgate.com/ViewPoem.aspx?id=155677",""],[6152,"وليّ روحي","https://www.poetsgate.com/ViewPoem.aspx?id=203707",""]],"verses":[["فَانْتَظِرِينِي فالشَّوقُ يُقْلِقُنِي","وَيَقْتَضِي سُرَعَتِي وَإِعْجَالِي",0,"ل",2,0],["فإِنْ تظفرِ الخَيْلُ المغيرة بالضحى","فعن رأيك الميمون تظفر بالنَّضْرِ",1,"ر",1,0],["فَاِنتَظَمَت في قَصرِهِ عُصبَةٌ","كَريمَةٌ لا واغِلٌ فيها",2,"ي",3,0],["فانتظر ما تلد اللي","لة فالليلة حبلى",3,"ل",2,0],["فَاِنتَظَمت أَهلَ الحِجالا بَيعتُه","وَاِحتَكَمَت في البصرتين شِيعتُه",4,"ه",1,0],["فَاِنتَظَرا بَشائِرَ الظَلماءِ","وَاِنطَلَقا مَعاً إِلى البَيداءِ",5,"ا",2,0],["فَاِنتَظِري عُقبَةَ بَعدَ الوَخدِ","سِيّانَ مَن يَغزو وَمَن في اللَحدِ",6,"د",1,0],["فانتظروني ولا تظنوا الظْ","ظنون واستمطروا ثنائي",7,"ي",1,0],["فانتظمت أهل الحجاز بيعته","واحتكمت في البصرتين شيعتهْ",8,"ه",1,0],["فَإِن تَظفَروا في يَومِ بَدرٍ فَإِنَّما","بِأَحمَدَ أَمسى جَدُّكُم وَهوَ ظاهِرُ",9,"ر",1,0],["فانتظِرني أقل وأنتَ مع النا","سِ تراني كما أقولُ وتشهَد",10,"د",1,0],["فانتظامُ الخطوب فيه انتشاري","وانتثارُ النوالِ فيه انتظامي",11,"م",2,0],["فانتظرت العرس إذ يثمر لي","قدرة الشكر لتلك النعم",12,"م",1,0],["فانتظروها إنما مِيعادها","غدٌ ويا قربَ غدٍ منتظَرَا",13,"ر",2,0],["فانتظِروها ويدي رهنٌ بها","فربّما كانت كرجعِ الناظرِ",14,"ر",1,0],["فانتظموا نظمَ القنا","إلا الوصومَ والخَوَرْ",15,"ر",1,0],["فانت ظهير الحق يا معدن الوفا","فضولي رجاءً باب لطفي يقرع",16,"ع",1,0],["فانتظر التوفير في راتب","بقية العام أو الداخل",17,"ل",1,0],["فإن تظلموا فيكم جميلاً لغاية","فإن جميلاً ليس بغفل ثائره",18,"ر",2,0],["فانتظم الأمر غير مُحْتفلٍ","كذّب غرّ وغرَّ مكذوب",19,"ب",1,0],["فانتظمت أسطرها كشراً","يكدن أن يفضحن بالكثر",20,"ر",1,0],["فأنتَ ظاهرٌ فلا تَغِيبَ","وأنت حَاضرٌ كذا رَقِيبُ",21,"ب",1,0],["فإن تَظَلَّ لازماً للمجرَى","لَم تَلقَ شَيئاً قَطُّ إِلاّ الجُزرَا",22,"ر",2,0],["فإن تظفر سُررت بتاج نصر","وإن تخسر فمرتاح الضمير",23,"ر",1,0],["فانتظموا بالاتحاد عقدا","واغتنموا مكارماً وحمدا",24,"د",2,0],["فانتظر في صحيفة الكون ماذا","سوف يملي عليهم الملوان",25,"ن",1,0],["فَاِنتَظَمَ الأَبطالُ قُريبَ الخَندَقِ","تَجري وَراءَهُم عِجالُ الفَيلَقِ",26,"ق",1,0],["فانتظمنا عقداًوواسطة العق","د أغر قد راق طبعاً وشفا",27,"ف",2,0],["فَاِنتَظِروني تُبصِروه","أَنَّهُ وَاللَهِ أَنّي",28,"ي",1,0],["فانتظرها واغربْ بوجهكَ عنّي","وتهيَّأ فسوف يَبْدَا الشّجار ُ",29,"ر",1,0],["فإنتظارك نار .. بالقلب الجزوم.","وان لقيتك ضاع حرف ٍ للعتاب.",30,"ب",1,0],["فانتِظارُ المَنُون ِ في كلِّ درْبٍ","للضَّحايَا أشابَ منَّا الغُلامَا",31,"م",2,0],["فانتظمت فيه لآلى الندى","واللؤلؤ المنظوم لا يثقب",32,"ب",1,0],["فأنتظر المجيء ولا أبالي","بخوفي أو بما يمليه حدسي",33,"س",2,0]]}