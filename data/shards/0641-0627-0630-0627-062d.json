{"poems":[[95,"إن بكى الشرق فالمصاب أليم","https://www.aldiwan.net/poem11409.html","الخفيف"],[74,"صف مكرمات وزير مصر عزيزها","https://www.aldiwan.net/poem19232.html","الكامل"],[91,"إن للحزن إلى السير","https://www.aldiwan.net/poem44734.html","مجزوء الرمل"],[91,"جو السياسة مكفهر","https://www.aldiwan.net/poem44852.html","مجزوء الكامل"],[47,"ذاك وادي الأراك فاحبس قليلا","https://www.aldiwan.net/poem65580.html","الخفيف"],[30,"يا أخت ناجبة ابن سامة إنني","https://www.aldiwan.net/poem5542.html","الكامل"],[68,"هكذا إن بنى المنازل بان","https://www.aldiwan.net/poem40973.html","الخفيف"],[99,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[76,"ماذا عليك وقد نأيت ديارا","https://www.aldiwan.net/poem12958.html","الكامل"],[69,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[77,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[52,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125573","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55024","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54720","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54552","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55034","الكامل"],[151,"هن إذا ساعدك الدهر","https://www.aldiwan.net/poem47414.html","مجزوء الرمل"],[190,"ما اعتاض واهب نفسه عشيقه","https://www.aldiwan.net/poem43528.html","الكامل"],[190,"عامل الإنسان قبل ال","https://www.aldiwan.net/poem43947.html","مجزوء الرمل"],[275,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[325,"يا أيها الخل الذي لم ينسني","https://www.aldiwan.net/poem61704.html","الكامل"],[333,"من ترانيم وحيك القدسي","https://www.aldiwan.net/poem55045.html","الخفيف"],[369,"حيتك غادية الحيا من مربع","https://www.aldiwan.net/poem60850.html","البسيط"],[458,"ست من السنوات جاوز عمرها","https://www.aldiwan.net/poem61591.html","الكامل"],[469,"وأمير قوم لا يسر أخاً","https://www.aldiwan.net/poem3146.html","عموديه"],[469,"يا طارداً بالهجر لهوي","https://www.aldiwan.net/poem3408.html","عموديه"],[505,"صين سري ومدمعي عنوانه","https://www.aldiwan.net/poem37567.html","الخفيف"],[520,"لما أدار مدامة الأحداق","https://www.aldiwan.net/poem12187.html","الكامل"],[581,"إن الحبيبة حبها لم ينفد","https://www.aldiwan.net/poem1785.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86977","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87164","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48679","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48678","الكامل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100151","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62581","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62477","الكامل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17045","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80179","الرمل"],[1165,"","https://poetry.dctabudhabi.ae/diwan/poem/101343","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56096","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56057","الكامل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117655","الكامل"],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102233","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48913","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89530","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53106","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28580","الرمل"],[2365,"","https://poetry.dctabudhabi.ae/diwan/poem/34717","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93642","الكامل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112495","الرمل"],[3069,"","https://poetry.dctabudhabi.ae/diwan/poem/198310","الرمل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100831","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97886","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89332","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138696",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138665",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45736","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205750",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66556","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102982","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111484","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70137","البسيط"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67607","الكامل"],[4679,"الصحف تنطق والمنابر تشهدُ","https://www.poetsgate.com/ViewPoem.aspx?id=142755",""],[4859,"تناقض!","https://www.poetsgate.com/ViewPoem.aspx?id=194215",""],[4935,"ليلي سعيد إن رأيت جنابه","https://www.poetsgate.com/ViewPoem.aspx?id=129365",""],[585,"درج الهلال من الخباء","https://www.poetsgate.com/ViewPoem.aspx?id=161864",""],[3591,"تحكي الإمام اليازجيّ بطلعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=149438",""],[5284,"غيث الاشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=191798",""],[5376,"ما رانَ غصنٌ بالخُضَارِ تورُّقا","https://www.poetsgate.com/ViewPoem.aspx?id=193733",""],[333,"نشيد الصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=101256",""],[5864,"عادتكَ ياوطنَ الكِرامِ لئامُ","https://www.poetsgate.com/ViewPoem.aspx?id=190486",""],[5923,"تلكم جنتي","https://www.poetsgate.com/ViewPoem.aspx?id=150027",""],[6102,"ميرا","https://www.poetsgate.com/ViewPoem.aspx?id=185071",""],[243,"صحيفة الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68182&r=&rc=174",""]],"verses":[["فَإِذَا حَالَتِ الأُمورُ فَقَدْ كَ","فَّ وَلَمْ يَشْكُ وَالنَّبِيلُ كَظِيمُ",0,"م",1,0],["فإذا حسبت فعنده القلم الذي","شهد الحساب بأنه نفّاع",1,"ع",1,0],["فاذا حررته من","بعد حبس كان شعرا",2,"ر",2,0],["فاذا حييت فكل ما","يحلي لغيري لي يمر",3,"ر",1,0],["فَإِذا حارَبوا أَذَلّوا عَزيزاً","وَإِذا سالَموا أَعَزّوا ذَليلا",4,"ل",2,0],["فَإِذا حَلَفتِ هُناكَ أَنَّكِ مِن دَمي","لَبَريئَةٌ فَتَحَلَّلي لا تَأثَمي",5,"م",2,0],["فَإِذا حاوَلَ المُقَصِّرُ نَيلَ ال","عِزِّ نادى وَعِزَّتي لَن تَراني",6,"ن",2,0],["فإذا حسبتِ بأن ظفرتِ به","فازت به من ليس تفهمُه",7,"ه",1,0],["فَإِذا حَنَوتُ فَلا سَلَوتُ فَإِنَّما","أَنتَ القَريبُ وَإِن شَحَطتَ دِيارا",8,"ر",2,0],["فإذا حَصَلتَ عَلَى الهُدَى بِكِتابِهِ","لا تَبْغِ بَعْدُ لِغَيْرِهِ تَحْصِيلا",9,"ل",2,0],["فإذا حللت فكل واد ممرع","وإذا ظعنت فكل شِعب ماحل",10,"ل",1,0],["فَإِذا حَلَّتِ الوُفودُ إِلَيهِ","بَشَّرَت ريحُهُ بِيَومٍ مَطيرِ",11,"ر",1,0],["فإذا حُبُّكِ يَطغَى مُزبداً","كَدفُوقِ السَّيلِ طُغيانَ الجنون",12,"ن",1,0],["فَإِذَا حَنَوْتَ عَلَى الحِمى مُتَحَبِّباً","فَهُوَ النَّسِيمُ وَقَدْ ذَكَا وَتَلَطَّفَا",13,"ف",2,0],["فَإِذَا حَافِظٌ وَقَدْ بَشَّ مَا فِي","نَفْسِهِ مِنْ تَجَهمٍ وَارْبِدَادِ",14,"د",1,0],["فَإِذَا حَبَاكَ اللهُ فَضْلاً وَاسِعاً","فَالْبُخْلُ خُسْرَانٌ وَشِبْهُ جُحُودِ",15,"د",1,0],["فَإِذَا حَضَرْتَ عِمَادَهَا الأَسْنَى فَقُلْ","تَارِيخَ ثَالِثَةِ الشُّمُوسِ هَنَاءُ",16,"ا",2,0],["فَإِذَا حَبتْكِ حُكُومَةٌ بِوِسَامِها","فَبِأَيِّ مَا قَدَّمْتِ مِنْ فضْلٍ يَفِي",17,"ف",2,0],["فإذا حطك دهرٌ","فكما كنت تكون",18,"ن",1,0],["فإذا حباه أجل ما في ملكه","وأثابه بفعاله إرفاقه",19,"ق",2,0],["فإذا حجّ فدعهُ","فهو شيطان مريد",20,"د",1,0],["فإذا حكمت فأنتَ أعدلُ حاكمٍ","وإذا خطبتَ فأنت موجٌ يهدر",21,"ر",1,0],["فَإِذا حَضَرتَ فَأَنتَ أَفضَلُ قادِمٍ","عِندي وَأَنتَ أَجَلُ مَن يَلقاني",22,"ن",2,0],["فإذا حدثوا عن الصخر لانوا","ومن الصخر رقة العربي",23,"ي",1,0],["فإذا حلَلْتُ تقول خَجْلتيَ ارتَحِلْ","وإذا مضَيتُ تقولُ هِمّتُكَ ارْجِع",24,"ع",1,0],["فإذا حييتُ وقدرتني أمتي","وتحررت لبيَّتها بولائي",25,"ي",1,0],["فإذا حمقتَ فأنت أحسنُ في","لحظاتهِ من صورةٍ البُخل",26,"ل",1,0],["فإذا حلفت على الوصا","ل فنيةٌ قُرنتْ بلغْو",27,"و",1,0],["فإذا حاضروه غاب اندهاشاً","وإذا خالبوه كلَّ لسانه",28,"ن",2,0],["فإذا حنت مصر علي وربها","فالأرض داري والسماء رواقي",29,"ق",2,0],["فَإِذا حَلَلتُ وَدونَ بَيتَي غاوَةٌ","فَاِبرُق بِأَرضِكَ ما بَدا لَكَ وارعُدِ",30,"د",1,0],["فَإِذا حَملت عَلى الخُصوم أَصابَهُم","مِن عَضبك المَصقول ما لا يُوصف",31,"ف",1,0],["فَإِذا حَملت على الخُصوم أَصابَهُم","مِن عضبك المَصقول ما هُوَ كائن",32,"ن",1,0],["فإذا حدتهن الحوائم فوقها","لبَّى حصىً من تحتها وجنادل",33,"ل",1,0],["فإذا حملت عواطفاً وعوارفاً","ألفيتَهنَّ هناك مُتَّهَمات",34,"ت",1,0],["فإذا حضرت بحضرة القدس التي","تسمو بهم شرفاً على كيوان",35,"ن",1,0],["فإذا حظيتَ بنظرة من وجهه","أنستك ذكر الأهل والأوطان",36,"ن",1,0],["فإذا حَدَا الحادي طَرِبْنَ بقوله","هذي المناهل والمراعي الدانيهْ",37,"ي",2,0],["فَإِذا حَنَنتُ إِلى النُدا","مِ فَقَد حَنَنتُ إِلى المُدامِ",38,"م",1,0],["فَإِذا حَنَّت وَأَنتَ أَضلُعي فَعَلى","ذكرِ هَواها وَسَناها",39,"ا",3,0],["فإذا حللت بذلك النادي فقم","لِلّه مبتهلاً بخير مقام",40,"م",1,0],["فإذا حجمتِ عن رجايي فإنني","اقضي اسى وأنني ابدي الندا",41,"د",2,0],["فاذا حباه الله عقلاً بعد ذا","يحكي كما يبغي بغير تحسّبِ",42,"ب",1,0],["فإذا حساها الشاربو","نَ وأوقعتهم في الأمامي",43,"ي",1,0],["فإذا حل في ذراهم تراهم","يشتهون منه بعيد المزارِ",44,"ر",1,0],["فإذا حننتُ إلى مجاثم أَسره","فكما يحنّ الحرّ للأصفاد",45,"د",1,0],["فإذا حُمَّ لامَردَّ لأمرٍ","قد قضاهُ المحيطُ بالأكوانِ",46,"ن",1,0],["فَإِذا حَبا لَم تَلقَ غَيرَ مُمَوَّلٍ","وَإِذا سَطا لَم تَلقَ غَيرَ مُعَفَّرِ",47,"ر",1,0],["فإذا حبا ملأ البلاد مواهباً","وإذا سطا ملئت قناً وبواترا",48,"ر",2,0],["فَإِذا حاوَلتَ تَحقي","قاً فَجَهلاً فَوقَ جَهلِ",49,"ل",1,0],["فَإِذا حَلَّ بِقَومٍ فَبِهِم حَلَّ البَوارُ","وَبِهِ تُوقَدُ نارٌ وِبِهِ تُخمَدُ نارُ",50,"ر",1,0],["فَإِذا حَللت بمعشر آراؤهم","مَعوجة عدلتهم وَأَطاعوا",51,"ع",3,0],["فإذا حدثتني ألفيتني","غائب المهجة لله نجيّا",52,"ي",2,0],["فإذا حاولتَ نصْراً أو جَدًى","لم تقف إلا ببابٍ مُرتَجِ",53,"ج",1,0],["فاذا حكمت فان حكمك نافذ","واذا امرت فان امرك مبرم",54,"م",1,0],["فإذا حباك اللَه نعمته","فاشكر له بالبر في الأهل",55,"ل",1,0],["فإذا حضرتَ همَى على الناد الندي","وإذا ذكرت فما سوى الإكرام",56,"م",1,0],["فإذا حواهن الفتى ضربت له","قبب العلا تسمو على كيوان",57,"ن",1,0],["فإذا حكمةٌ قضت ببقا القو","م فلم لا يكون فيه اقتضاء",58,"ا",2,0],["فَإِذا حبا أَحيَ بِفَيض غَمامه","وَإِذا سَطا شَقيت بِهِ الأَحياءُ",59,"ا",2,0],["فإذا حفَّك البنون بما","شئت من بهجة ومن لعب",60,"ب",1,0],["فَإِذْا حَبا مَلأَ الْمَنازِلَ نِعْمَةً","وَإِذْا سَطا مَلأَ الْبَسِيطَةَ عَسْكَرَا",61,"ر",2,0],["فإذا حلمت حلمت لا عن ذلة","لكن لي معنى بذاك مقدرا",62,"ر",2,0],["فَإِذا حَيِيتَ مُسَرَّحاً أَو مُفتَدىً","فَلَسَوفَ تَرجِعُ رَاقِبا أو مُحرِبا",63,"ب",2,0],["فاذا حييتُ فَلي لِسانٌ شاكِرٌ","وَإِذا قَضيتُ فَلي عِظامٌ تحمدُ",64,"د",1,0],["فإذا حضرت وغبتُ عنك فإنه","ذنبٌ عقوبتُهُ على البوَّابِ",65,"ب",1,0],["فإذا حوت منك القبول فإنه","شرف يغض الطرف منه الحسَّدُ",66,"د",1,0],["فإذا حضرتُ يصدّني","وإذا تباعدتُ اقترب !",67,"ب",1,0],["فإذا حظيت بنور طلعته ضحى","لا شك في نظمي عليه أسلم",68,"م",1,0],["فإذا حييت فإنما","أحيا بتذكار اللقاء",69,"ا",2,0],["فإذا حزنت عليه قمت مقامه","فأعدت لي فرحي بذاك الراحل",70,"ل",1,0],["فإذا حلَّ الرَّبيعُ المُنتشي","سَكِرَ القلب بأطياف الجنى",71,"ن",2,0],["فإذا حظيْتُ من اللقاء تبسُّماً","من حرِّه جادَ الأديمَ تعرقا",72,"ق",2,0],["فإذا حدّثوا عن الصّخرِ لانوا ومن الصخر رقّة العربيّ","فهنا مصر أمّة مسختها كالتماثيل عصبة السامريّ",73,"ي",1,0],["فَإِذا حَبَاكَ اللهُ مِنْ نَعْمائِهِ","فَاشكُرْ لَهُ فالشَّاكِرونَ كِرامُ",74,"م",1,0],["فإذا حُرِمتُ رضا العزيز وحِلمَه","أضحتْ حياتي دمعةً في مقلتي",75,"ت",2,0],["فَإِذا حَرِصتِ عَلَى هَوايَ فَإِنَّنِي","لَأَجَلُّ حُبًّا - يا هَوايَ - وَ أَحرَصُ",76,"ص",1,0],["فإذا حطمت فلست وحدك حاطما","تلك القيود غنيت بالأنصار",77,"ر",1,0]]}