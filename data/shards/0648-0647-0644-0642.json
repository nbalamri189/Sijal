{"poems":[[88,"لمحت جلال العيد والقوم هيب","https://www.aldiwan.net/poem68955.html","الطويل"],[75,"ثقي بي يا معذبتي فإني","https://www.aldiwan.net/poem11877.html","الوافر"],[95,"ألا أيها الطالع المتبسم","https://www.aldiwan.net/poem11413.html","الطويل"],[87,"قفوا بالقبور نسائل عمر","https://www.aldiwan.net/poem62868.html","المتقارب"],[87,"لمن ذلك الملك الذي عز جانبه","https://www.aldiwan.net/poem63780.html","الطويل"],[87,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[70,"أبرق بدا من جانب الغور لامع","https://www.aldiwan.net/poem1506.html",""],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54203","الطويل"],[173,"دع الكاعب الحسناء تهوي ركابها","https://www.aldiwan.net/poem1600.html",""],[173,"إليكن عني فانصرفن على مهل","https://www.aldiwan.net/poem1643.html",""],[185,"قفى يا أميم القلب نقرأ تحية","https://www.aldiwan.net/poem58834.html","الطويل"],[185,"قفى يا اميم القلب نقض لبانة","https://www.aldiwan.net/poem59092.html","الطويل"],[189,"نحا البين في تشتيت شملي مقاصدا","https://www.aldiwan.net/poem14496.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[266,"متى يستفيق الدهر من غفلانه","https://www.aldiwan.net/poem38140.html","الطويل"],[280,"ألم ترها تسمو لأشرف غاية","https://www.aldiwan.net/poem25624.html","الطويل"],[285,"أظن الدهر جاءك مستثيرا","https://www.aldiwan.net/poem60698.html","الوافر"],[285,"سوى باكيك من ينهى العذول","https://www.aldiwan.net/poem60710.html","الوافر"],[287,"افتر ثغرك لي أم بارق لمعا","https://www.aldiwan.net/poem32715.html","البسيط"],[310,"سما للعلى يقظان عين حديدها","https://www.aldiwan.net/poem56578.html","الطويل"],[371,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[463,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83323","الطويل"],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102035","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59111","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96735","الوافر"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121116","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95503","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132250","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109279","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77295","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65965","الطويل"],[2803,"","https://poetry.dctabudhabi.ae/diwan/poem/123995","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205826","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100266","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201757","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65411","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48442","الطويل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118743","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91465","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85064","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85234","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85230","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131027",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103014","الوافر"],[3927,"","https://poetry.dctabudhabi.ae/diwan/poem/113703","الطويل"],[4043,"","https://poetry.dctabudhabi.ae/diwan/poem/92459","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94510","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94787","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76740","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139639",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139543",""],[5081,"مَا زِلْتُ مُنْتَظِرَاً","https://www.poetsgate.com/ViewPoem.aspx?id=185593",""],[592,"يلوم أناس أن نظمت رواية","https://www.poetsgate.com/ViewPoem.aspx?id=128818",""],[592,"شكت فجشت مذ أعلنت بجشاها","https://www.poetsgate.com/ViewPoem.aspx?id=128712",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5431,"سينقرُ شباكها اصبعُك...تساؤلات محقة","https://www.poetsgate.com/ViewPoem.aspx?id=199116",""],[5544,"عبري","https://www.poetsgate.com/ViewPoem.aspx?id=213406",""],[5625,"نعمة العشق","https://www.poetsgate.com/ViewPoem.aspx?id=183007",""],[5689,"هنا بين هذا الدوح والزهرات","https://www.poetsgate.com/ViewPoem.aspx?id=143393",""],[5717,"وهل قرأت من كتاب النفس ما","https://www.poetsgate.com/ViewPoem.aspx?id=170602",""],[5842,"رد ( الى بشار الاسد بعد خطابه الثاني ) / حسان الزا","https://www.poetsgate.com/ViewPoem.aspx?id=76594",""],[5975,"رد ( الى بشار الاسد بعد خطابه الثاني )","https://www.poetsgate.com/ViewPoem.aspx?id=76595",""],[5996,"وما ذاك إلا عارض من طماعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=181339",""]],"verses":[["وَهَل قَرَّ في بُرجِ السُعودِ مُتَوَّجٌ","كَما قَرَّ في يَلديزَ ذاكَ المُعَصَّبُ",0,"ب",1,0],["وَهَل قَلبٌ كَقَلبِكِ في ضُلوعي","فَأَسلو عَنكِ حينَ سَلَوتِ عَنّي",1,"ن",2,0],["وَهَلْ قُوَّةُ الأَجْنَادِ تَكْفُلُ قَوْمَها","إلَى آخِرِ الأيَّامِ وَالقَوْمُ نُوَّمُ",2,"م",1,0],["وَهَل قامَ رُضوانُ مِن خَلفِها","يُلاقي الرَضِيَّ النَقِيَّ الأَبَرّ",3,"ر",1,0],["وَهَل قَدَّمَت إِلّا دُعاةً شُعوبُهُ","وَساعَفَ إِلّا بِالصَلاةِ أَقارِبُه",4,"ب",2,0],["وَهَل قَبلَهُم مَن عانَقَ النارَ راغِباً","وَلَو أَنَّهُ عُبّادُها المُتَرَهِّبُ",5,"ب",1,0],["وهل قاعةُ الوعساء مخْضَرّةُ الرُّبى","وهل ما مضَى فيها من العيش راجع",6,"ع",1,0],["وهل قاصراتُ الطرف عِينٌ بعالجٍ","على عهدِيَ المَعهودِ أمْ هوَ ضائع",6,"ع",1,0],["وَهَلْ قَطَعَ الصَمْصَامُ في جَوْفِ غمْدِهِ","وَهَلْ طَابَ نَشْراً قَبْلَ إِحْراقِهِ النَدُّ",7,"د",1,0],["وَهَل قِيستِ الخَيلُ العِرابُ بعانَةٍ","كُدادِيَّةٍ لا يلحقُ الضَبَّ جابُها",8,"ب",3,0],["وَهَل قادَنا بِالجَهضَمِيَّةِ سَيِّدٌ","وَإِن كانَ فينا واسِعَ البَأسِ وَالفَضلِ",9,"ل",1,0],["وَهَل قُمتُ فِى أَظلالِهِنَّ عَشِيَّةً","مَقامَ أَخِى البأساءِ وَاختَرتُ ذلِكِ",10,"ك",1,0],["وَهَل قُمتُ بَعدَ الرائِحينَ عَشِيَّةً","مَقَامَ أخى البَغضاءِ واختَرتُ ذلكِ",11,"ك",1,0],["وهل قَلدتْ جِيد القليدة بعدنا","يدُ الغيثِ من زَهْرِ الربيع قلائِدا",12,"د",2,0],["وَهل قطُّ مَصنوعٌ بصانعهِ دَرى","لَقَد ضلّ عَبدٌ يدّعيه وما برّا",13,"ر",2,0],["وهل قصبات السبق إلا صحائف","منمقة بالفضل من قصباته",14,"ت",2,0],["وَهَلْ قَدَحتْ إلا لِفَوْزٍ قِداحُها","فَلا غَرْوَ أن تَحظَى بِكُبرَى المَواهِبِ",15,"ب",1,0],["وَهَلْ قَصَدَ الزَّمانُ سِوى كَرِيمٍ","حَماهُ أَنْ يَضِيمَ وَأَنْ يَضِيرا",16,"ر",2,0],["وَهَلْ قَدْرُ الرَّزِيَّةِ فَرْطُ حُزْنٍ","فَيُرْضِيَ فِيكَ دَمْعٌ أَوْ غَلِيلُ",17,"ل",1,0],["وَهَل قَوامُكَ غُصنُ البانِ مُعتَدِلاً","عَلى كَثيبٍ عَلَيهِ البَدرُ قَد طَلَعا",18,"ع",2,0],["وَهل قمرٌ يحكي سناهُ صقالَه","كَسُحب موارٍ للضياء ركودها",19,"د",3,0],["وَهَل قَذَفتَ الدَمعَ شُهباً إِذا","ما اِستَرَقَ السَلوَةَ شَيطانُ",20,"ن",1,0],["وهل قاتلي بلدٌ أن أقيم","إذا خُطَّ في غيره مصرعي",21,"ع",2,0],["وَهَل قيمَةُ الإِنسانِ إِلّا فِعالُهُ","وَهَل قُدرُهُ إِلّا عَناهُ وَجُهدُهُ",22,"د",2,0],["وهل قصرت كف تطول إلى العلى","لها ساعد من شيبة الحمد يمتد",23,"د",1,0],["وَهَلْ قَدْ رَوَى النعمَانُ عن سَهْلِ نُعْمِهَا","أحَادِيثَ ألْقَتْهَا الصَّبَا وَالشَّمَائِلُ",24,"ل",1,0],["وَهل قاضتهم الرحلا","ت بالخودانِ خودانا",25,"ن",2,0],["وهل قبلت ثم فما وخداً","فجئت بطيب وردٍ أو أقاح",26,"ح",1,0],["وهل قَدَّسَ الأقوام يوماً ولم يكن","له سُورَ الذكرىعلى صحف القلبِ",27,"ب",1,0],["وهل قط يحتاج النهار لنا إلى","دليل ولا شك إذا طلع الفجر",28,"ر",1,0],["وهل قام مجد الغرب إلا بأهله","وقد قتلوا الأيام في كدهم صبرا",29,"ر",2,0],["وَهَل قَمَري مِن ظُلمَةِ النَأيِ طالِعٌ","فَأَسرِيَ في نورِ المُنى وَالمَطامِعُ",30,"ع",1,0],["وهل قعدت منا على الضيم صبية","وهل كان منا بالمذلة قانع",31,"ع",1,0],["وهل قد أرى إنيا شوان وقد بدا","من أهلي مقيمٌ حولَهُ ونزيلُ",32,"ل",1,0],["وهل قرّ قلبٌ في هواه ولوغدا","يساجله فرط الحنان خدينه",33,"ن",2,0],["وهل قُصد القصيد تفيك حقّاً","وإن عضدت بجهد أوجهادِ",34,"د",1,0],["وهل قلت ما أحلاكَ حين ضممتني","لصدركِ إعجاباً أم الحبُّ غّلابا",35,"ب",2,0],["وهل قاولوا الغراب به غراب","يُدلُّ على تفرُّقه ويُملي",36,"ل",2,0],["وهلْ قهوةٌ حتى يُزاحَ فِدامُها","وهلْ مِسْكةٌ حتى يُزالَ إهابُها",37,"ب",3,0],["وهل قد أفادتك السفاهة مربحاً","نعم عُضت في أرض السفالة في وحل",38,"ل",1,0],["وَهل قدودُ غُصونِ البانِ راقصةٌ","وَهل حمائمُها يعتادها الصَدَح",39,"ح",1,0],["وهل قبلت منك الثغور زهورها","وجريت ذيلاً فوق خضر العمائم",40,"م",1,0],["وهل قاله النعمان أو قال مالك","به أو هل رواه الشافعي واشهب",41,"ب",1,0],["وهل قاله سفيان أو كان أحمد","إليه إذا نادى المؤذن يذهب",41,"ب",1,0],["وَهَل قَولُهُ يا رَبِّ قَلَّدتَ غَيرَهُ","لَدى اللَهِ عُذرُ يَومِ فَصلِ قَضائِهِ",42,"ا",3,0],["وهل قائل إن الرجال قلوبهم","قست فهي لا تحنو على من توجّعا",43,"ع",2,0],["وهل قبّلت عني ثغر خشف","كأن الريق منه رقى السليم",44,"م",1,0],["وهل قاسيونٌ قلبه متفطِّرٌ","وفيه الرجال الأربعون صِيامُ",45,"م",1,0],["وهل قدرت مذ أوحشته طلايع ال","ظهور عليه أن تؤنسه الخمر",46,"ر",1,0],["وهل قلب ايليا عن الاخت يَلتَوي","ويتركها ظمأى إلى حسن رؤيةِ",47,"ه",1,0],["وهل قد تولى الحورُ حوراء مقلةٍ","فغابت وليست للربوع تحورُ",48,"ر",1,0],["وهل قذف الجواهر غير بحري","فحتى كم يطيفون",49,"ن",1,0],["وهل قبة الأفلاك تعدل قبةً","حوت أنجماً أبراجهنَّ المراقد",50,"د",1,0],["وهل قاومت ليثاً كلابٌ وان غدا","لها مخلبٌ بالختل عاد خلوبا",51,"ب",2,0],["وَهَلْ قَلْبٌ بِلَا حُبٍّ","سَيَنْجُو دُونَ إِبْحَارِ؟",52,"ر",1,0],["وهل قلت إلا قول شيخ محقق","فلست لأقول الهداة بكاتم",53,"م",1,0],["وهل قائماً بالحق إن سل صارماً","أراق فرند الهند وإن دماها",54,"ا",3,0],["وهل قال هذا الشافعي وأحمد","فعمن أخذتم يا ذوي الجهل والعمى",55,"م",2,0],["وهل قاله من صحب أحمد قائل","وتابعهم أو تابعي نهج من سما",55,"م",2,0],["وهل قال إلا ما هو الحق والهدى","صريحاً لدينا تستبين دلائله",56,"ل",2,0],["وهل قد أتيت كطفلٍ حبا ؟","أم ال...وحده قد أتى يدفعك!؟",57,"ك",1,0],["وهل قلوب بنيك العرب نابضة","إلا بحبك العلا كانت ولم تزل",58,"ل",1,0],["وهل قربُ الأنوثةِ يرتجينا","كما قُرباكِ أرجوهُ بشوقِ",59,"ق",1,0],["وهل قد تراني كلما أطرح الجوى","على الأرض بي من تلكم الشرفات؟",60,"ت",1,0],["وهل قرأت من كتاب النفس ما","لم يك محتاجا الى مترجم",61,"م",1,1],["وهل قتّلَ الناسُ ظلماً وذلّوا","وهل ما تراهُ صحيحُ الحصولِ؟!",62,"ل",1,0],["وهل قتّلَ الناسُ ظلماً وذلّوا  وهل ما تراهُ صحيحُ الحصولِ؟!","وهل أنت تسكنُ أرضَ شآمٍ ؟!  وهل ذقتَ ما ذقتُ من نارِ ويلِ",63,"ل",1,0],["وهل قوضت خيم على أبرق الحما","وما ذاك من غدر الزمان بديع؟",64,"ع",1,0]]}