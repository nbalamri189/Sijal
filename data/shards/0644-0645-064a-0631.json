ف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[380,"يا مكثرا من ذم كل ذميم","https://www.aldiwan.net/poem48760.html","الخفيف"],[380,"لا واِختلاس النظر","https://www.aldiwan.net/poem49232.html","مجزوء الرجز"],[405,"ما أنصفت بغداد حين توحشت","https://www.aldiwan.net/poem49547.html","الكامل"],[406,"لو جادهن غداة رمن رواحا","https://www.aldiwan.net/poem50194.html","الكامل"],[409,"كلما امتد ناظري رده الدم","https://www.aldiwan.net/poem31616.html","عموديه"],[416,"بلغ الشوق لعمري ما أراد","https://www.aldiwan.net/poem53890.html","الرمل"],[416,"هذه الدار وهاتيك المغاني","https://www.aldiwan.net/poem54073.html","الرمل"],[432,"ضرب الناس في العلا الأمثالا","https://www.aldiwan.net/poem12373.html","الخفيف"],[432,"سائل لوى خبت فذاك لواؤه","https://www.aldiwan.net/poem12550.html","الكامل"],[437,"لك ذروة المجد الذي لا يرتقى","https://www.aldiwan.net/poem2535.html","الكامل"],[437,"مال في الحب على ضعيفي وملا","https://www.aldiwan.net/poem2545.html","الرمل"],[439,"نور الوفاء بأرضنا لك ساطع","https://www.aldiwan.net/poem34838.html","الكامل"],[448,"هل إلى برد الثنايا من سبيل","https://www.aldiwan.net/poem53767.html","الرمل"],[453,"أجل ضربت لكم في غربتي المثلا","https://www.aldiwan.net/poem61603.html","البسيط"],[458,"أدرك ما شاء غلام فطنا","https://www.aldiwan.net/poem55840.html","الرجز"],[458,"ظل المنى واسع والشمل ملتئم","https://www.aldiwan.net/poem55869.html","البسيط"],[458,"نوازع الشوق والغليلِ","https://www.aldiwan.net/poem55990.html","مخلع البسيط"],[458,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[458,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[479,"في الجد أو في اللعب","https://www.aldiwan.net/poem37612.html","مجزوء الرجز"],[498,"يا راكضاً في طلاب دنيا","https://www.aldiwan.net/poem3693.html","مخلع البسيط"],[514,"ميلوا بنا نحو الحجون ونكبوا","https://www.aldiwan.net/poem20800.html","الكامل"],[514,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[514,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[515,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[515,"لا وعيون لحظها ساهر","https://www.aldiwan.net/poem12116.html","السريع"],[515,"صفو الحياة وإن طال المدى كدر","https://www.aldiwan.net/poem12141.html","البسيط"],[515,"ثغر الهدى متبلج بسام","https://www.aldiwan.net/poem12245.html","الكامل"],[551,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[551,"أما ترى الربع الذي أقفرا","https://www.aldiwan.net/poem47804.html","السريع"],[558,"أتعبتني بقر الشام","https://www.aldiwan.net/poem34182.html","المديد"],[564,"إن الزمان الذي كنا نحاذره","https://www.aldiwan.net/poem851.html",""],[575,"أصبحت بعدك في الحياة كفان","https://www.aldiwan.net/poem2773.html","الكامل"],[575,"لم أذق بعد ريقه البابليه","https://www.aldiwan.net/poem2830.html","الخفيف"],[576,"لم يرجعوا من خشية الموت والردى","https://www.aldiwan.net/poem1786.html","الطويل"],[586,"أبدا بذكرك تنقضي أوقاتي","https://www.aldiwan.net/poem17455.html","الكامل"]],"verses":[["لَم يَرْضَ بالأرضِ فاختارَ السّماء لها","حتى اطمأنَّتْ بِرَبْعٍ غَيرِ مَسكونِ",0,"ن",1,0],["لَمْ يَرُقْ مُقْلَتِي وَلاَ رَاقَ قَلْبِي","كَعُلاَهَا بَرَاعَةً وَبَيَانَا",1,"ن",2,0],["لَمْ يُرَ مَلْكٌ فِي زَمَانٍ خَلاَ","قَامَ لَهُ رَسْمٌ بِأَتْرَابِهِ",2,"ب",2,0],["لَم يَرمِهِ في شَرخِهِ ما رَمى","لَو كانَ مَبنِيّاً عَلى أُسِّ",3,"س",1,0],["لم يَرعَ في طاعَةِ المولى خُؤُولَتَه","ولا رَعى غيرَها فيما يُنافيها",4,"ي",3,0],["لَم يَرتَفِع في الشَرقِ تا","جٌ فَوقَ تاجِ النيلِ مَجدا",5,"د",2,0],["لَمْ يُرْضهِ التَّقْوِيضُ مُدَّةَ حُكْمِهِ","فَبَنَى وَخَيْرُ القَائِمِينَ أَلبَانِي",6,"ن",2,0],["لَمْ يَرُعْهَا هَزِيمُ رَعْدٍ وَلا إِيمَا","ضُ بَرْقٍ وَلَمْ يَضِرْهَا صِدَامُ",7,"م",1,0],["لَمْ يُرْهِقِ الشَّرْقَ إِلاَّ عَيْشُهُ رَدَحاً","وَالجَهْلُ رَاعِيهِ وَالأَقْوَامُ كَالنَّعَمِ",8,"م",1,0],["لم يرقصِ الدّوح بالأكمام من طرب","حتى شدا من قيان الطير شاديها",9,"ي",3,0],["لم يرضَ سيفُك أن يُحَلَّى جوهراً","حتى يُحلّى عسجداً محلولا",10,"ل",2,0],["لَم يَركَبوا الخَيلَ إِلّا بَعدَما هَرِموا","فَهُم ثِقالٌ عَلى أَكتافِها ميلُ",11,"ل",1,0],["لم يُراقب إلّاً ولم يَرجُ أن يأ","تيَ يوماً يمشي على استحياءِ",12,"ا",2,0],["لم يرعَ حقَّ شَبَابٍ كان يصحبُهُ","من لم يُحَبِّبْ إليه فَقْدُهُ العَطَبا",13,"ب",2,0],["لم يرعَ سرحَ الملك رعيته","راعٍ ولا قمع العدى قمعه",14,"ع",2,0],["لم ير لي خلّة تعاب سوى ال","خلة أو رغبتي عن الحرف",15,"ف",1,0],["لم يَروا أن كلَّما شطَّ عني","زادَهُ بعدُه اقتراباً إليَّا",16,"ي",2,0],["لَم يَروِهِ لَمعُ السَرابِ فَرا","حَ يَستَسقي السَحاب",17,"ب",1,0],["لم يرتضوا من بعد سلب ثرائها","إلَّا بأن تتهتك النسوان",18,"ن",1,0],["لَم يَرَها الطَيرُ وَلَم","يَسمَع بِها إِلّا اِفتَتَن",19,"ن",1,0],["لَم يَرَ فيها زَوجَهُ","وَلا اِبنَهُ المُحَبَّبا",20,"ب",2,0],["لَم يَرَ الناسُ قَبلَها","مِنبَراً تَحتَ مُحتَضَر",21,"ر",1,0],["لَم يَرَ الشَرقُ داعِياً مِثلَ سَعدٍ","رَجَّهُ مِن بِطاحِهِ وَرِعانِه",22,"ن",2,0],["لَم يُرهِقِ الأُمَمَ المُلوكُ بِمِثلِها","فَخراً لَهُم يَبقى وَذِكراً يَعبَقُ",23,"ق",1,0],["لَم يَرُعني سِوى ثَرىً قُرطُبِيٍّ","لَمَسَت فيهِ عِبرَةَ الدَهرِ خَمسي",24,"س",2,0],["لَم يُرَفرِف مَلَكُ الحُبِّ عَلى","أَبَوَيهِم أَو يُبارِك في الثَمَر",25,"ر",1,0],["لَم يُرَ قَرنُ الشَمسِ في شَرقِهِ","فَشَكَّتِ الأَنفُسُ في غَربِهِ",26,"ب",2,0],["لَم يُرضِ قَلبَ أَبي شُجاعٍ مَبلَغٌ","قَبلَ المَماتِ وَلَم يَسَعهُ مَوضِعُ",27,"ع",1,0],["لم يرضَ لي ذُلَّ المطامعِ فانثنَى","نحوي يُطارِدُنِي بعزِّ الياسِ",28,"س",1,0],["لَم يَرجُها بِأَكاذيبِ الظُنونِ وَلَم","يَمتُت إِلى نَيلِها إِذ مُتَّ مِن بُعُدِ",29,"د",1,0],["لَم يَرعَ لَي حَقَّ القَرابَةِ طَيِّئٌ","فيها وَلا حَقَّ الصَداقَةِ فارِسُ",30,"س",1,0],["لَم يَرتَفِع عَن مُراعاةِ الصَغيرِ وَلَم","يَنزِل إِلى الطَمَعِ المَخسوسِ إِسفافا",31,"ف",2,0],["لَم يَرضَها لَمّا اِجتَلاها صَعبَةً","لَم تَرضَهُ خِدناً لَها وَرَفيقا",32,"ق",2,0],["لَم يَروَ مِن ماءِ الشَبابِ وَلا اِنجَلَت","ذَهَبِيَّةُ الصَبَواتِ عَن أَيّامِهِ",33,"م",2,0],["لَم يُرزَقوها بِعَقلٍ حينما رُزِقوا","لَكِنَّهُم رُزِقوها بِالمقاديرِ",34,"ر",1,0],["لَم يُرضِنا أَن دَعا بِالبَينِ طائِرُنا","شَقُّ الجُيوبِ وَما شُقَّت مَرائِرُنا",35,"ن",2,0],["لَم يَرحَلوا عَن حِمى أَرضٍ إِذا نَزَلوا","إِلّا وَأَبقَوا بِها مِن جودِهِم أَثَرا",36,"ر",2,0],["لَم يرض غير شبيبتي ودمي","زاداً يعيش به ويفنيني",37,"ي",1,0],["لَم يُرَ في عِترَتِهِ مِثلُهُ","أَنصَفَ لِلمَظلومِ مِن ظالِمِ",38,"م",1,0],["لم يْرو ِ فيها (الراقدين) على النهي","وعلى النبوغ غليل حقد وار",39,"ر",1,0],["لَم يَرُعني إِلّا الفَتاةُ وَإِلّا","دَمعُها في الرِداءِ سَحّاً سَنينا",40,"ن",2,0],["لَم يَرُعهُنَّ عِندَ ذاكَ وَقَد جِئ","تُ لَميعادِهِنَّ إِلّا دُخولي",41,"ي",1,0],["لَم يَرُعني بَعدَ أَخذي هَجعَةً","غَيرُ ريحِ المِسكِ مِنها وَالقُطُر",42,"ر",1,0],["لم يَرْقَ شعبٌ بالكلامِ ولم يَقُمْ","مُلكٌ على ضَعْفٍ ولا استسلامِ",43,"م",1,0],["لم يرفعوا الصَّوتَ حتّى لاحَ بارِقُهُ","تحت العَجَاجَةِ يجلو ضَوْؤُهُ السُّدُفا",44,"ف",2,0],["لم يَرْضَ ما نَالَ من مجدٍ فأَورثَهُ","مَجداً طريفاً وَعِزّاً منه مُؤْتَنَفا",44,"ف",2,0],["لَم يَرحَموني حينَ حانَ فِراقُهُم","ما ضَرَّهُم لَو أَنَّهُم رَحَموني",45,"ي",1,0],["لَم يُرَ قَطُّ صاحِبا إِمامِ","مِثلَهُما في سائِرِ الأَنامِ",46,"م",1,0],["لَمْ يُرِيدُوا بِذُكُورٍ جَلَوْهَا","لِلْحُرُوبِ العُونِ إِلَّا الضِّرَابا",47,"ب",2,0],["لَمْ يُرْزَقِ الرِّزْقَ المُقِيمُ بِأَهْلِهِ","فَشَكَوْأ عَنا بُعْدِي وَفَقْرَ مُقامِي",48,"م",2,0],["لَم يَرهَبِ الفُطورَ مِن سِبائِها","يُعزى اِبنُ عُصفورٍ إِلى بُرائِها",49,"ا",3,0],["لَم يَرضَ بِالإِعجامِ حينَ كَتَبتُهُ","حَتّى شَكَلتُ عَلَيهِ بِالإِعرابِ",50,"ب",1,0],["لَم يَرضَ إِبليسُ الظَريفُ فِعالَنا","حَتّى أَعانَ فَسادَنا بِفَسادِ",51,"د",1,0],["لَم يَرَها خاطِبٌ فَيُمنَعَها","وَلا دَعاهُ لَها أَخو فَنَدِ",52,"د",1,0],["لمْ يَرْقُبِ الرُّقَبَاءُ إلاّ في شَجٍ","مِن حَولِهِ يَتَسَلّلُون لِواذا",53,"ذ",2,0],["لم يَرُقْني مَنْزِلٌ بعدَ النّقَا","لا ولا مُسْتَحْسَنٌ مِنْ بَعدِ مَي",54,"ي",1,0],["لم يُربني أمرُ الصراط مقاماً","فوق وادٍ من الجحيم يفور",55,"ر",1,0],["لَم يَرُعني من الطَبيعة إِلّا","ما حوته من بسطة واتساع",56,"ع",1,0],["لم يَرْهَبُوا سَوطَ جلَّادٍ ولا حَفِلوا","بسيف باغٍ ولا أصفاد سجّانِ",57,"ن",1,0],["لم يرعني من جانبِ النيل إلَّا","كرمةٌ فوقها ترفُّ غمامَه",58,"م",2,0],["لم يَرْقَ عَقْلٌ أو تَرِقُّ سريرةٌ","وقضى الوجودُ ضلالةً وفسادا",59,"د",2,0],["لم يَرْوَ مِن ماءِ الشَّبا","بِ وكُلُّ أَشْيَبَ عنه خائِمْ",60,"م",1,0],["لَمْ يُرْضِهَا العَيْشُ إِذَا مَا نأَى","فَأَزْمَعَتْ نَأْياً وَقَدْ أَزْمَعَا",61,"ع",2,0],["لَمْ يُرْضِكَ اسْتِقْرَارُهَا ولَقَدْ تَرَى","أَنَّ الجُمُودَ حَلِيفُ الاِسْتِقْرَارِ",62,"ر",1,0],["لَمْ يَرضَ سَابَا أَنْ يَكُونَ لَهْ عِدَىً","وَاسْتَكْثَرَ الإِخْوَانَ وَالأَحْبَابَا",63,"ب",2,0],["لمْ يَرَ النَّاسُ قَبْلَهُ في مُصَابٍ","مِثْلَ ذَاكَ الإِزْرَاءِ بِالأَرْزَاءِ",64,"ا",2,0],["لَمْ يَرْجِعِ العِيدُ مُرِيباً إِنَّما","أَرَابَ قَوْمٌ مِنْكَ ضَلُّوا الْقَصْدَا",65,"د",2,0],["لَمْ يُرْضِ نَفْسِي أَنَّهَا","قَدْ أخْطَأَتْ ذَاكَ الخَطَاءْ",66,"ا",2,0],["لم يرتكوا زهرةً تغفو على غصنٍ","عرّوا البساتين من زهر البساتين",67,"ن",1,0],["لم يرتد المجد إلا من مطارفها","ولا انتشى النصرُ إلا من أغانيها",68,"ي",3,0],["لَم يَرُقني حَتّى بَدا آفِلا فَاِن","فَطَرَت لِلعُلا سَماء وَحُبكُ",69,"ك",1,0],["لم يَرَ حُسْنَ الصُّبحِ في شَمْسِه","ولا جَمالَ الليلِ في بَدْرِه",70,"ر",2,0],["لم يَرْعَ ماضيَها ولم","يحفِل بحاضرها العتيد",71,"د",1,0],["لم يرفعْ الصّوتَ يُومًا في جوانبها","مستعجمٌ، أو يَمُدَّ الكفَّ قُرصانا",72,"ن",2,0],["لم يُرغَم الحسّادُ الا مفخراً","أغناهُم التنزيل ُ عن تحريفه",73,"ف",2,0],["لم يُرد من بَراه مُتعةَ نَفسٍ","ان يُغَطّى ولم يُردْ كِتمانه",74,"ن",2,0],["لم يرعَ شرعَ الكافرينَ ، ولا وفى","حقَّيهما القرآن َ والانجيلا",75,"ل",2,0],["لَمْ يَرْعَ لي حَقَّ القَرَابَةِ طَيّءٌ","فيها، وَلاَ حَقَّ الصّداقَةِ فارِسُ",76,"س",1,0],["لم يرده ألف جرح من فواجعه","حتّى أصيب بسهم منك أرداه",77,"ا",2,0],["لم يرعك الزّمان في حالتيه","وتحدّيته وعيدا ووعدل",78,"د",2,0],["لمْ يرَ الناسُ مثلنا يومَ سرنا","نسلبُ الملكَ بالرماحِ الطوالِ",79,"ل",1,0],["لم يرعني من جانب النّيل إلاّ","كرمة فةقها ترفّ غمامه",80,"م",2,0],["لم ير التاثير الا للذي","بسط الأرض على ماء جمد",81,"د",1,0],["لَم يَرضَ بَذَلَ فِفتَنٍ","ذَاتاً لِعَبدِ القَادِرِ",82,"ر",1,0],["لم يُرَ في كِيصٍ شَبه","لِذَا الفَضِيل انتبَه",83,"ب",2,1],["لَم يَرَى الرَّائِى فِيهِ إلاَّ نؤياً","بَعدَ لأىٍ يَبدُو لَعَينِ الرَّائِى",84,"ا",2,0],["لم يريدوا بهم عذاباً فهلا","أرسلوهم للخرس والعميان",85,"ن",1,0],["لم يرتد المجدُ إذ أصيبَ بها","ولا مشى العزُّ وهو منتعلُ",86,"ل",1,0],["لم يرضَ ما سنّ الكرامُ أمامَه","حتى أتى بغرئبٍ ومَعانِ",87,"ن",1,0],["لم يرضَ عبدُ الله إِذعانَ الورى","بالخوفِ دونَ الحبِّ في الطاعاتِ",88,"ت",1,0],["لم يرمه لكن رمته سعوده","بسهامها وهي الحمام الحاضر",89,"ر",1,0],["لم يرعَ أكنافَ الهُوَيْنى مُمْرِجاً","نعمَ الرَّفاهةَ في رياض هُدون",90,"ن",1,0],["لَم يَرتَقي القَومُ الجَميمَ وَما لَنا","غَير الأَلاءَةِ مَرتَعاً وَالحَرمَلِ",91,"ل",1,0],["لَم يَرثَ لِلشَيخِ حَياءً مِن الش","شَيبِ وَلَم يَرحَم شَبابَ الغُلام",92,"م",1,0],["لَم يَرحَمِ البَينُ فيهِ قَلبَ والدِهِ","وَلا رَثى لِصباهُ لا وَلا عَطَفا",93,"ف",2,0],["لم يرضَ أنْ ملك العلياءَ أجمعَها","حتى بَنى باللُّهَى والسيف والقلم",94,"م",1,0],["لَم يُرَ في الهيجاء إلّا مُقدما","محمّدٌ سيفُ الهدى المخذّمُ",95,"م",1,0],["لَم يرَ في كلّ البرايا شبههُ","في كلّ عصرٍ قد مضى ولن يُرى",96,"ا",1,0],["لَم يَرُعهُ مِن قبله قطّ شيءٌ","مثلهُ إِذ أحيل منه الرواءُ",97,"ا",2,0],["لَم يُروَ عنهُ قطّ وصفُ جاحدِ","وَأُمُّهُ تنزَّهت عَن جحدِ",98,"د",1,0],["لَم يَرزَء الاَعداءُ مِنِّى زَندا","عَلَى عَناجِيجِ الخُيُولِ جُردا",99,"د",2,0],["لم يرق لي العيش لو","لاك فيا حوّا أفيقي",100,"ي",1,0],["لم يرعني من حادثات الليالي","طارق ما سوى الخيال الطروق",101,"ق",1,0],["لم يرعنا سوى الرقيب","كابليس يطفر",102,"ر",1,0],["لم يَرَ مِنهُ غيرَ شَطرِ ضَئيل","إِذا كانَ في مَيعَتِهِ الناعِمَه",103,"ه",1,0],["لم يَرَ الموتُ رَأيَه وَتقَضّى","حُلُمٌ قد سَرى بِأَقصى البِلاد",104,"د",1,0],["لَمْ يُرضِني دهري كما","أرضى سِوايَ فأَرتَضِيِه",105,"ي",2,1],["لَم يُرعَ يَوماً لَديهِ عَهدٌ","وَلا زَكا عِندَهُ صَنيعُ",106,"ع",1,0],["لم يرض مولاي علي","سبي لأصحاب النبي",107,"ي",1,0],["لَم يَرُعْنِي غَيْرُ مَطْلَعِها","دونَ تَسْويفٍ وتَسْويلِ",108,"ل",1,0],["لَمْ يَرْضَ سِوى قَلْبي وَطَناً","لَكِنْ بِالهَدّ يُهَدّدُهُ",109,"د",2,0],["لَم يُرَ مِنهُم غَيرُ ما مُستَوحِشٍ","أَو مُنطَو