","إلا علومك أن تقول وتنطقا",135,"ق",2,0],["لم يرم إلا انتفاعا بكم","وهو في جلسته مثل القرلي",136,"ل",2,0],["لم يَرفعُوا راياتِهِمْ إِلّا عَلَتْ","والحق مرفوعٌ بِهِنَّ ورافِعُ",137,"ع",1,0],["لم يرق قلبى خليل غيره","وسلام انها نار الخليل",138,"ل",1,0],["لم يرفع العدلَ والاحرارَ غيرهمو","وما تحَّرر شعبٌ هانَ أو جهلا",139,"ل",2,0],["لم ير مذ فارقَ كسرى مثلَها","أجملَ فوق جيدهِ وأزينا",140,"ن",2,0],["لم يرضَ جودُك أن تخضرَّ مخصِبةً","به الظواهرُ حتى ابيضّت العَتَمِ",141,"م",1,0],["لم يرتجعك الجفاءُ منّي","عن كرم العاطفِ الوَصولِ",142,"ل",1,0],["لم يرْعَ صحبتَك القديمةَ عازفاً","عنها وأين من الوفاء ملولُ",143,"ل",1,0],["لم يَرَيَا قبلك بيتاً له","نادٍ ولا ناراً لها سامرُ",144,"ر",1,0],["لم يرض إلا بالذي","يرضى أخوه اليثربي",145,"ب",2,0],["لَم يَرِدُوها فَهُم رِواءٌ","وَوارِدُوها هُم العِطاشُ",146,"ش",1,0],["لم يُرْوِ منتجِعاً رَشاشُ سحابةٍ","لولا نوالُ أبي الحُسينِ الصيّبُ",147,"ب",1,0],["لم يرْوَ من ماءِ الفُراتِ حُسامُه","كالنّارِ من إضرامِها لا تَشبَعُ",148,"ع",1,0],["لم يُرجَ بالعَفو منهم فعلُ مكرمةٍ","من عِندهم بل على الرّحمنِ محتَسبُ",149,"ب",1,0],["لم يرض بالأمر الذي رضيت به","في الملك أطراف طغت وعبيد",150,"د",1,0],["لم يرض بالإكرام لي وحده","فجادني إنعامه الغامر",151,"ر",1,0],["لم يرتحل قافلاً إلا وساكنها","إما مباح حماه أو دم هدر",152,"ر",1,0],["لم يرضك القصر الشريف وقد","شرفاته بالنيرات تقام",153,"م",1,0],["لم يَرُعْنِي وطالما أتْرَعَ النّا","عون فينا قلوبنا باِرتياعِ",154,"ع",1,0],["لَم يَرتَضوا درعاً ولم يلبسوا","بِالطّعن إلّا العَلَقَ الأحمرا",155,"ر",2,0],["لم يرقوا بالمواعظ إذ","ماؤهم من حجر هامي",156,"ي",1,0],["لم يرقب الله فينا إذ ألم بنا","ولم يحاذر جزاء البغي والضرر",157,"ر",1,0],["لم يَرْثهِ عني لسانٌ واحدٌ","لكن رَثَتْ بمدامِعي عَيْنَان",158,"ن",1,0],["لم يَرُقْني ولا حَلا بِفؤادِي","لا غَزاليَةٌ ولا غَزَليِه",159,"ي",2,0],["لَم يَرجِعوا مِن خَشيَةِ المَوتِ وَالرَّدى","وَقَد جَلَبَتها مِن بَعيدٍ جَوالِبُ",160,"ب",1,1],["لَمْ يَرْضَ بِالتَّقْليدِ حَتَّى جَاءَ فِي ال","تَوْحِيدِ بالبُرْهَانِ وَالآياتِ",161,"ت",1,0]]}