{"poems":[[53,"ساءلت يوما خالدا","https://www.aldiwan.net/poem65011.html","مجزوء الكامل"],[107,"رحمة يا أبا بصير ونعمى","https://www.aldiwan.net/poem44063.html","الرمل"],[385,"قلب يحبك مولع","https://www.aldiwan.net/poem48747.html","مجزوء الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80186","الكامل"],[2552,"","https://poetry.dctabudhabi.ae/diwan/poem/144424","الكامل"],[3048,"","https://poetry.dctabudhabi.ae/diwan/poem/100605","المجتث"],[3750,"","https://poetry.dctabudhabi.ae/diwan/poem/126510","الكامل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135131","المجتث"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89570","المديد"],[5689,"لمذا خلقت لماذا أعود","https://www.poetsgate.com/ViewPoem.aspx?id=143408",""],[5956,"الميْتُ الجديد يحتل مكان الميت القديم في قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=192226",""]],"verses":[["لمْ ذلَّ عِزُكَ للقُمُدْ","دِ فقال قول المستشيطِ",0,"ط",1,0],["لمَّ ذو العرشِ شَملهم بعد صَدْعٍ","وَخَلِيْقٌ بشَملِهِم أن يُلَمَّا",1,"م",2,0],["لِمَ ذا الصُدود وَلَيسَ","عِندي لِلتَجَلُد مَوضع",2,"ع",1,0],["لِمَ ذا التَباعُد وَالنفار مَع الجَفا","جُوراً وَنَحنُ عَلى الصَفا إِخوانُ",3,"ن",1,0],["لِمذكَّرِ الخُطواتِ غير مُؤنَّثٍ","ومؤنثِ الخَلوات غير مذكَّرِ",4,"ر",1,0],["لم ذا تكلمت جهلاً","في حمل ما كان عندك",5,"ك",1,0],["لم ذي الدعاوي يا فتى","أأحاط منك به البصر",6,"ر",1,0],["لم ذا التقاطع عني","وفي علاك طوافي",7,"ف",2,0],["لِمَ ذا هَل كُلُّ ذا شَغَفٌ","بِجَمالِ المُفرَدِ العَلَمِ",8,"م",1,1],["لمذا خلقت لماذا أعود","ترابا كما كنت تحت اللحود؟",9,"د",1,1],["لِمَ ذلك المحبوب أصبح باهتا","وأتى الجديد بمهجتي يتشبّثُ؟؟",10,"ث",1,0]]}