{"poems":[[84,"سرى والحب أمر لا يرام","https://www.aldiwan.net/poem29415.html","الطويل"],[32,"أمنزلتي مي سلام عليكما علي","https://www.aldiwan.net/poem29608.html","الطويل"],[74,"شجون نحوها العشاق فاؤا","https://www.aldiwan.net/poem18162.html","الوافر"],[72,"كان البياض يروقني","https://www.aldiwan.net/poem42445.html","مجزوء الكامل"],[91,"تحبهم ثم ارزم ثم سالا","https://www.aldiwan.net/poem44900.html","الوافر"],[87,"أصاب المجاهد عقبى الشهيد","https://www.aldiwan.net/poem62887.html","المتقارب"],[64,"لقاء الأماني في ضمان القواضب","https://www.aldiwan.net/poem52506.html","الطويل"],[82,"وأدهم ينهب عرض المدى","https://www.aldiwan.net/poem31301.html","المتقارب"],[82,"أخذت برأي في الصبا أنا تاركه","https://www.aldiwan.net/poem31356.html","الطويل"],[54,"كأن البركة الغناء","https://www.aldiwan.net/poem27167.html","الوافر"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[29,"","https://poetry.dctabudhabi.ae/diwan/poem/1613","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54748","الرجز"],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[189,"عسى يدنيك يا بلدي إياب","https://www.aldiwan.net/poem14108.html","الوافر"],[202,"كأن البحر إذ طلعت ذكاء","https://www.aldiwan.net/poem51931.html","الوافر"],[228,"لقد بلغت بهم الحده","https://www.aldiwan.net/poem41900.html","المتقارب"],[234,"نعت بالبين غربان","https://www.aldiwan.net/poem50762.html","مجزوء الوافر"],[234,"أطعت الصبا وشبابي نضير","https://www.aldiwan.net/poem51038.html","المتقارب"],[234,"كأن البركة الغنا إذا ما","https://www.aldiwan.net/poem51193.html","الوافر"],[234,"ألا من لنفسي وأوصابها","https://www.aldiwan.net/poem51210.html","المتقارب"],[371,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[416,"نفحت مكافئا عن قبر معن","https://www.aldiwan.net/poem67483.html","الطويل"],[445,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"],[466,"بني عمنا كفوا العضيهة أنها","https://www.aldiwan.net/poem15099.html","الطويل"],[473,"ينادي من الساري إلي ومزعجي","https://www.aldiwan.net/poem60224.html","الطويل"],[580,"كأن البحر ميدان وفيه","https://www.aldiwan.net/poem2734.html","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122811","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48801","المتقارب"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199619","المسحوب"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199605","المسحوب"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77486","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62536","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120028","الوافر"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[1370,"","https://poetry.dctabudhabi.ae/diwan/poem/26688","الوافر"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132852","الوافر"],[1418,"","https://poetry.dctabudhabi.ae/diwan/poem/114826","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50041","الهزج"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114805","البسيط"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46487","الوافر"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99082","المتقارب"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46741","الوافر"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93445","الطويل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136965",""],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140065",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202779","الوافر"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115435","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132619","الوافر"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106685","الطويل"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46831","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62880","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62870","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48442","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129503","الوافر"],[3784,"","https://poetry.dctabudhabi.ae/diwan/poem/18575","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131096",""],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99229","الوافر"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32430","الوافر"],[3987,"","https://poetry.dctabudhabi.ae/diwan/poem/146863","الوافر"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125816","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101354","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119603","الوافر"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33685","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120497","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120526","الطويل"],[5038,"غنّى الهزار","https://www.poetsgate.com/ViewPoem.aspx?id=189332",""],[5039,"قيثارة الملح والخوف","https://www.poetsgate.com/ViewPoem.aspx?id=48115",""],[5277,"يَا هَيَاهُ","https://www.poetsgate.com/ViewPoem.aspx?id=202654",""],[5573,"ياسعود لاصكت علي الغلايب","https://www.poetsgate.com/ViewPoem.aspx?id=200079",""],[5596,"ردي على قصيدة ناصر بن سعيد الرواحي","https://www.poetsgate.com/ViewPoem.aspx?id=206691",""],[5616,"الجوع.. الجوع!","https://www.poetsgate.com/ViewPoem.aspx?id=205221",""],[5690,"صدقتم لحظهُ لحظ الغزالِ","https://www.poetsgate.com/ViewPoem.aspx?id=172173",""],[6097,"خُطى القَدَر","https://www.poetsgate.com/ViewPoem.aspx?id=197430",""],[6147,"شهوة سريالية.. ليلة سقوط بغداد..","https://www.poetsgate.com/ViewPoem.aspx?id=151487",""]],"verses":[["كأن البدر تحت الغيم وجه","عليه من ملاحته لئام",0,"م",1,0],["كَأَن البُرى وَالعاجَ عيجَت مُتونُهُ","عَلى عُشَرٍ نَهًّى بِهِ السَيلُ أَبطَحُ",1,"ح",1,0],["كأنَّ البدرَ صفرهُ خشوعٌ","له والشمسَ ضرَّجها حياء",2,"ا",2,0],["كانَ البَياضُ يَروقُني","حَتّى رَأَيتُ الشَيبَ مِنّي",3,"ن",2,1],["كأن البرق في يده حسام","يشق به من السحب الجبالا",4,"ل",2,0],["كأن البرد جني تنزى","هنالك او هنا يلقى نبالا",4,"ل",2,0],["كَأَنَّ البَيانَ بِأَيّامِهِ","أَوِ العِلمَ تَحتَ ظِلالِ الرَشيد",5,"د",1,0],["كأن البروقَ استودعتها مشاعلاً","تباهي مصابيحَ النجومِ الثواقبِ",6,"ب",1,0],["كأن البروقَ على جِسمِه","مَدَاوِسُ تصْقُلُ منه أديم",7,"م",1,0],["كأنّ البروقَ الخاطفاتِ بُرُوقُهُ","وَزُهْرُ النجومِ اللائحاتِ نَيازِكُه",8,"ك",2,0],["كَأَنَّ البِركَةَ الغَنّاءَ لَمّا","غَدَت بِالماءِ مُفعَمَةً تَموجُ",9,"ج",1,1],["كَأَنَّ البُرينَ وَالدَماليجَ عُلِّقَت","عَلى عُشَرٍ أَو خِروَعٍ لَم يُخَضَّدِ",10,"د",1,0],["كَأَنَّ البَدرَ تَحمِلُهُ المَهارى","غَوارِبُهُنَّ وَالصَفَحاتُ شيبُ",11,"ب",1,0],["كانَ البِدَارُ دَأْبَهُ عِنَايَةً","بِشَأْنِ مَنْ يَرْعَى مِنَ العِبَادِ",12,"د",1,0],["كأن البرين والدماليج غلقت","على عشرٍ أو خروعٍ لم يحضد",13,"د",1,0],["كأنّ البدرَ فيها عينُ ماءٍ","لها من فائض النورِ انْسِكاب",14,"ب",1,0],["كأنَّ البحرَ إذْ طَلَعَتْ ذُكاءٌ","ولاح بمتنه منها شعاعُ",15,"ع",1,1],["كَأَنَّ البِلادَ لَدى حاجَةٍ","إِلى كذبٍ وَإِلى إِدَّه",16,"د",2,0],["كأنّ البَذْل والجُودَ","على مالكَ أَعوان",17,"ن",1,0],["كأنّ البنفسَج لثُم المحبّ","حوته خدودُ الدُّمَى والنُحُور",18,"ر",1,0],["كأنّ البركة الغَنَّا إذا ما","غدَتْ بالماء مفعمةً تموجُ",19,"ج",1,1],["كأنّ البروقَ سيوفُ الغمام","إذا هزَّها ثم رامَى بها",20,"ب",3,0],["كانَ البُكا بِالجَفنِ أَولى وَما","يَبقى عَلى الباكينَ أَجفانُ",21,"ن",1,0],["كَأَنَّ البَرمَكِيَّ بِكُلِّ مالٍ","تَجودُ بِهِ يَداهُ يُفيدُ مالا",22,"ل",2,0],["كَأَنَّ البَرَّ والبحرَ اسْتَطَارَا","تِجاراً هَمُّهُمْ بُعْدُ الثِّناءِ",23,"ا",2,0],["كأن البنان السبط يزجي سطورهُ","أخو الحرب يقتاد العديد المجمهرا",24,"ر",2,0],["كَأَنَّ البَهارَ الغَضَّ فيها مَداهِنٌ","مِنَ المتِبرِ صيغَت في غُصونِ زَبَرجَدِ",25,"د",1,0],["كأَن البَحْرَ مَيْدانٌ وفيه","من السُّفْن الَّتي تجري خيولُ",26,"ل",1,1],["كَأنَّ البَدرَ يَعذِلُ مَن بَهاهُ","عَلَى قَمَرٍ تَمامٍ اُضحيانِ",27,"ن",1,0],["كأن البلاد أبت نده","وجاءت به وحده معدنا",28,"ن",2,0],["كان البخت لي مْواسم","بابني الهوى باركان",29,"ن",1,0],["كان البصرة محلّه","نجم ضرب لمغيب",30,"ب",1,0],["كانَ البَخيل عِندَهُ دَجاجه","تَكفيهِ طولَ الدَهر شَرَ الحاجه",31,"ه",1,1],["كأن البيت يخطبها فردت","بهدٍّ لا يؤلف وجه عِرسِ",32,"س",1,0],["كأن البينَ أصبح مستهاما","بتعذيب المحب المستهامِ",33,"م",1,0],["كان البخاري صاحب الصحيح","وصاحب التعديل والتجريح",34,"ح",1,0],["كَأَنَّ البَدرَ لَيلَةَ لا غَمام","عَلى أَنماطِها حَرِجاً رَهينا",35,"ن",2,0],["كأنَّ البينَ مَحتومٌ علينا","فليس سِوَى التلاقي والوَداعِ",36,"ع",1,0],["كأنَّ البَينَ جَرَّعني زُعافاً","من الحيَّاتِ مَطعَمُهُ فظيعُ",37,"ع",1,0],["كأَن البرق منقضّ","إذا لاحت ثناياهُ",38,"ا",2,0],["كانَ البقيّةَ في قومٍ قد انقَرَضُوا","فَهاجَ ما شاءَ ذاكَ القرنَ من شَجنِ",39,"ن",1,0],["كَأَن البَدر فيهِ أَمير قَومٍ","سَرى مِنهن في جَيشٍ لَهام",40,"م",1,0],["كأن البنادق طوع له","فهن يصبن له ما اشتهى",41,"ا",1,0],["كَأَنَّ البختَريَةَ أم خِشفٍ","تَرَبَّعَتِ الجُنَينَةَ فالسلاما",42,"م",2,0],["كَأَنَّ البُروقَ الخافِقَاتِ مُعارَةٌ","حَشى هايمٍ مِن شِدَّةِ الخَفَقانِ",43,"ن",1,0],["كان البكاء نشيدي عند مشيتها","عن الربوع وآلامي هي النغم",44,"م",1,0],["كان البرق بارزه بليل","فسل على مفارقه حساما",45,"م",2,0],["كأن البرّ لي سجن كبير","ولي في البحر من سجني انطلاق",46,"ق",1,0],["كأنّ البدر طلعَتُهُ إذا ما","تبدّى طالعا بعد المغيب",47,"ب",1,0],["كأن البندقيات","عليه تنثر الدره",48,"ر",2,0],["كأنَّ البنفسَجَ النَّضِيرَ خمَائِلٌ","تقلَّدَهَا بينَ الوُفُودِ سِلاَحُ",49,"ح",1,0],["كأَنَّ البَحْرَ طَفّاحاً","لِبَحْرِ نَوالِهِ زَبَدُ",50,"د",1,0],["كان البرقَ ليلةَ زرتِ يَجلي","لُمامَكِ في النقاءِ وفي الشُّعَاعِ",51,"ع",1,0],["كأَنَّ البدرَ تعلوه الثُّريَّا","مليكٌ فوقهُ خَرَزَاتُ تَاجِ",52,"ج",1,0],["كأنّ البِلادَ النّاصريّةَ رامَها","عدوٌّ فراعَتْهُ امتِناعاً صِعابُها",53,"ب",3,0],["كأن البيض في الهيجاء برق","ووقع الخيل رعد في سماكا",54,"ك",2,0],["كَأنَّ البُرى وَالعاجَ في قَصَباتِها","تَغمُرنَ ضالاً أَو تعمرنَ خروعا",55,"ع",2,0],["كأن البكا والسهد صبان اصبحا","وكلهما مغزى بعيني مولع",56,"ع",1,1],["كأن البرقَ في الظلماءِ سِرٌّ","تَضَمَّنَ غيرَ كاتمِهِ فباحا",57,"ح",2,0],["كَأَنَّ البَدرَ ذاكَ الخا","لُ وافى لَيلَةَ السَعدِ",58,"د",1,0],["كأن البين ترب الموت لكن","يواري في الضنا لا في الثياب",59,"ب",1,1],["كأن البلاد الشاسعاتِ خريطةٌ","فيختار منها خِطَّة ما يسيرها",60,"ر",3,0],["كأن البر لج من حديد","تسيل به الأباطح والوهاد",61,"د",1,0],["كأن البندق الزعّاج عِيسٌ","سَرَت والطوب في الهيجاء حادي",62,"د",2,0],["كأنَّ البينَ كان يُحبُّ فجعي","به أو كانَ يحسدُني عليهِ",63,"ي",2,0],["كأن البيد صدري والثنايا","هواجسه قد اعتاصت سبيلا",64,"ل",2,0],["كأن البرايا كلفت بولائه","فما هو الا ان يقول لها جدوى",65,"د",3,0],["كَأَنَّ الْبَدْرَ فَضَّضَهُ فَريصٌ","وَأَنَّ النَّجْمَ أَفْتَرَ في الْفُتُورِ",66,"ر",1,0],["كان البحر قيثارة الملح والخوف","والريشه المجداف بكفوف قارب",67,"ب",1,1],["كأنَّ البحرَ في عينيكِ يبكي","ويبكي بدرَ ضحكتهِ المحاقُ",68,"ق",1,0],["كان البليد اللي عليه الطلايب","ارعد رعيد ابراعد الصوت ولحا",69,"ح",2,0],["كَأَنَّ البروق المسبكرّات في السما","سيوف علت عند اللقاء تنور",70,"ر",1,0],["كأَنَّ البِيدَ تَلفِظُهمْ، فَتَجْرِي","بِهِمْ بِيدٌ إلَى بِيدٍ خَوَالِ",71,"ل",1,0],["كأن البدرَ قد ألقى علينا","ضياءَ بين أشجارٍ عوالي",72,"ل",2,0],["كَأنَّ البَحرَ للآمالِ ملهىً","وَشَطّ البَحرِ لِلّاهِينَ حَدُّ",73,"د",1,0],["كأنّ البحارَ من الحوت فرّت","ففرّ الّرمال يُِردْن القمورا",74,"ر",2,0]]}