{"poems":[[310,"الدهر حرب بالرزايا الفجع","https://www.aldiwan.net/poem56486.html","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110292","المتقارب"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32657","الرجز"],[5608,"تخنقني عبْرَه","https://www.poetsgate.com/ViewPoem.aspx?id=33244",""]],"verses":[["تُخني تخونُ تمينُ تمني لا تفي","تُغري تغرُّ تبيحُ كلّ ممنّعِ",0,"ع",1,0],["تخنث فتيان هذا الزمان","فدلوا علينا دلال الحسان",1,"ن",1,1],["تَخنُقُها العَبرَةُ إِن","مَرَّت بِأَصحابِ العَلَف",2,"ف",1,0],["تخنقني عَبْرَه .. كل ما انا.. ذكرته","ويفزّ قلبي .. كل ما حلّ .. طاريه",3,"ي",2,1]]}