etry.dctabudhabi.ae/diwan/poem/55437","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54761","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54565","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55010","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54754","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43854","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54285","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[106,"إهداء","https://www.poetsgate.com/ViewPoem.aspx?id=179372",""],[106,"مولد الهادي الأمين","https://www.poetsgate.com/ViewPoem.aspx?id=179620",""],[106,"الوحدة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=179293",""],[77,"وفعلك للصنع الجميل محالف","https://www.poetsgate.com/ViewPoem.aspx?id=34137",""],[77,"أبدى لِداعي الفوزِ وجْهَ مُنيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33318",""],[50,"أنجزي يا سلامة الموعودا","https://www.poetsgate.com/ViewPoem.aspx?id=21672",""],[90,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[90,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[45,"إنْ دَعَاهُ داعي الصبَى، فأجابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31576",""],[45,"قَدْ مَرَرْنَا بِزَحْوَلٍ يَوْمَ دَجْنٍ","https://www.poetsgate.com/ViewPoem.aspx?id=31872",""],[45,"لا أرى بالعقيق رسما يجيب","https://www.poetsgate.com/ViewPoem.aspx?id=33099",""],[80,"ما أغمدَ العضبُ حتى جُرّد الذكرُ","https://www.poetsgate.com/ViewPoem.aspx?id=3241",""],[91,"بنت سورية","https://www.poetsgate.com/ViewPoem.aspx?id=53216",""],[51,"قدِم الأميرُ أخو الأمي","https://www.poetsgate.com/ViewPoem.aspx?id=27030",""],[51,"قدَّمتَ لي وعداً فأين نجاحُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=27390",""],[51,"يا خَلِيلَيَّ تَيَّمَتْني وَحيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=25883",""],[97,"بطل الأبطال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63541&r=&rc=87",""],[20,"بكر العاذلون في وضح الصب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70005&r=&rc=27",""],[3,"فؤادٌ لا يسلّيهِ المدامُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10754&r=&rc=108",""],[18,"هَلْ عَرَفْتَ الْغَدَاة َ مِنْ أَطْلاَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26460&r=&rc=26",""]],"verses":[["قَدِمَ السُرورُ بِقُدمَةٍ لَكَ بَشَّرَت","غُرَرَ العُلى وَعَوالِيَ التيجانِ",0,"ن",1,0],["قَد مَرَرنا عَلى الدِيارِ خُشوعاً","وَرَأَينا البِنى فَأَينَ الباني",1,"ن",2,0],["قَدَّمَت غَيرَكَ الجُدودُ وَأُخَّز","تَ وَلَكِن أَنافَ غَيرَ مُنيفِ",2,"ف",1,0],["قَدَمٌ تَؤُمُّكُمُ وَأُخرى تَنثَني","عَنكُم وَحَزمُ الرَأيِ للمُتَثَبِّتِ",3,"ت",1,0],["قَدِمتَ فَأَطرَقَ صَرفُ الزَمانِ","عَناءً وَأَغضَت عُيونُ النُوَب",4,"ب",1,0],["قَدِمتَ قُدومَ رِقاقِ السَحا","بِ تَخُطُّ وَالرَبعُ رَبعٌ جَديبُ",5,"ب",1,0],["قَد مَضى الدَهرُ وَعَفّى بَعدَكُم","لا الجَوى باخَ وَلا الدَمعُ رَقا",6,"ا",1,0],["قد مَلَكوا الدُّنيا وكانتْ عاطِلاً","فما لَها غَيْرَ مَساعِيهمْ حُلى",7,"ا",1,0],["قد مات قوم وما ماتت مكارمهم","وعاش قوم.. وهم في الناس اموات",8,"ت",1,0],["قدّمْتَ صُبْحاً فاسْتضأتَ بنورِهِ","ووجَدْتَ عنْدَ الشِّدّةِ التّنْفيسا",9,"س",2,0],["قَدِمَتْ قَبْلَهَا كَتِبَةُ سِحْرٍ","مِنْ كِتَابِ سَبَتْ بِهِ الأَذْهَانَا",10,"ن",2,0],["قَدْ مَرَرْنَا بِدَارِ عَبُّو الْوَالِي","وَهْيَ ثكْلَى تَشْكُو صُرُوفَ اللَّيَالِي",11,"ي",1,1],["قَدِمَ البَنَفْسَجُ وهْوَ نِعْمَ الوارِدُ","قدْ نمّ منْهُ إليَّ طيبٌ زائِدُ",12,"د",1,1],["قَدَّمْتَ سَالِبَةَ الْعَدْوّ وَبَعْدَهَا","أخْرَى لِغِزَِّ النَّصْرِ ذَاتُ وُجُوبِ",13,"ب",1,0],["قَد مَلَكتُم فَمَ السَبيلِ عَلَينا","وَفَتَحتُم لِكُلِّ شَعواءَ بابا",14,"ب",2,0],["قَد مَشى جَمعُهُم إِلى المَقصِدِ الأَس","مى يُغِذّونَ لِلوُصولِ الرِكابا",14,"ب",2,0],["قَد مَضى حِفني وَهَذا يَومُنا","يَتَدانى فَاِستَثيبي وَأَنيبي",15,"ب",2,0],["قَدِّمي الخَيرَ اِحتِساباً فَكَفى","بَعضُ ما قَدَّمتِ مِن تِلكَ الذُنوبِ",15,"ب",1,0],["قَد مَضَت عَشرٌ وَسَبعٌ وَالنُهى","في ذُبولٍ وَالأَماني في نُضوبِ",15,"ب",1,0],["قَد ماتَ نابِغَةُ القَضا","ءِ وَغابَ بَدرُ المَحفِلِ",16,"ل",1,0],["قَد مَرَّ عامٌ بِنا وَالأَمرُ يَحزُبُنا","آناً وَآوِنَةً تَنتابُنا النِقَمُ",17,"م",1,0],["قَد مَرَّ عامٌ يا سُعادُ وَعامُ","وَاِبنُ الكِنانَةِ في حِماهُ يُضامُ",18,"م",1,1],["قَد مَلَأنا البَرَّ مِن أَشلائِهِم","فَدَعوهُم يَملَئوا الدُنيا كَلاما",19,"م",2,0],["قَد مَسَحتَ البِلادَ شَرقاً وَغَرباً","بِذِراعَي مُشَمِّرٍ مِقدامِ",20,"م",1,0],["قَد ماتَ والِدُها وَماتَت أُمُّها","وَمَضى الحِمامُ بِعَمِّها وَالخالِ",21,"ل",1,0],["قَد مَلِلنا وُقوفَنا فيهِ نَبكي","حَسَباً زائِلاً وَمَجداً مُضاعا",22,"ع",2,0],["قَد مَضى شَهرٌ وَأَعقَبَهُ","ضِعفُهُ وَالفِكرُ مُشتَغِلُ",23,"ل",1,0],["قَد مَلَّ فيهِ كاتِبُ الآثامِ","تَحِيَّةٌ كَالوَردِ في الكِمامِ",24,"م",1,0],["قَد مَلَأَ الشَوقُ الحَشا نُدوبا","في الغَربِ إِذ رُحتُ بِهِ غَريبا",25,"ب",2,0],["قَد مِتُّ إِلّا ذَماءً فِيَّ يُمسِكُهُ","أَنَّ الفُؤادَ بِلُقياهُم يُرَجّيني",26,"ي",1,0],["قَدْ مَالأَ العِلْمُ الغَريزَةَ فَهْيَ لَمْ","تَتْرُكْ لِغَيْرِ السَّيْفِ مِنْ سُلْطَانِ",27,"ن",1,0],["قَدَّمْتَ ذَاكَ الكَنْزَ بِالدُّرَرِ الَّتِي","حَاكَتْ فَرَائِدَهُ النَّفِيسَةَ فَاسَلَمِ",28,"م",1,0],["قَدَّمَتْكَ الدُّنْيَا وَفِي غَيْرِ هَذَا الشَّ","وْطِ كُنْتَ الْجَدِيرَ بِالتَّقْدِيمِ",29,"م",1,0],["قَد مَرَّ أَحوالٌ لَها وَأَشهُرُ","وَقَد يُرى فِيها لِعِينٍ مَنظَرُ",30,"ر",1,0],["قدمتّ قرير العين في كلِّ غبطةٍ","بما شئت من آمالِكَ الغُرِّ تُسعِفُ",31,"ف",1,0],["قدِمْتَ على الرحمن أكرم مَقدّمٍ","وزُوَدت من رُحماه خير مُزوَّدِ",32,"د",1,0],["قد مَثّلا منكما للناس قاطبةً","عِجلاً أضلّ الورى من قبل أو وثنا",33,"ن",2,0],["قَدِمتَ عَلى أَهلِ العِراقِ وَمِنهُمُ","مُخالِفُ دينِ المُسلِمينَ وَخاذِلُ",34,"ل",1,0],["قَدَّموا إِذ قالَ قَيسٌ قَدَّموا","وَاِحفَظوا المَجدَ بِأَطرافِ الأَسَل",35,"ل",1,0],["قَد مَنَحتُ الرُقادَ عَينَ خَلِيٍّ","باتَ خِلواً مِمّا يُجِنُّ ضَميري",36,"ر",2,0],["قدمت قدوم الغيث والحيُّ مجذبٌ","وعدت كعود البدر والأفق غيهب",37,"ب",1,1],["قدمت كما ترضى السيادة والعلى","على الشامِ من نعمى يديك سحاب",38,"ب",1,1],["قدِمتَ بوفد الرأي والعزمِ والندَى","وقدْ كانَ يكفِي وافد البركات",39,"ت",1,0],["قدمت كالسيف إلى غمدهِ","واليمنُ موقوف على حدِّه",40,"د",2,1],["قدمت قدومَ الغيث يهمي نواله","ويعبق ريَّاه ويبسم ثغره",41,"ر",2,0],["قدم الحبيب من السَّفر","أرأيت بدراً قد سفر",42,"ر",1,1],["قدمت أميراً في بني الدهر آمراً","على الدهرِ يصغي سامعاً ويطيع",43,"ع",1,1],["قدَّمت فيها الهنا ثمَّ المديح وما","أخليتها بعدُ من عادات أغزال",44,"ل",1,0],["قد ملئت من ظفر أيدينا","وقد شكرنا الفضل ما حيينا",45,"ن",2,0],["قدم الإمامُ يسير تحت لوائه","سَيْرَ السكينةِ سيدُ الأمراءِ",46,"ر",3,1],["قد مضى أكثر الشتاء وجاء الصي","فُ يعدو فلا تَزِدْهُ التِظاءَ",47,"ا",2,0],["قِدِم الأميرُ أخو الأمي","رِ أبو الحسين المُصْعَبُ",48,"ب",1,1],["قد مَللنا بشاعةَ الوجهِ منهُ","وأحاديثَه الغِثاثَ الرِّثاثا",49,"ث",2,0],["قدَّمتَ لي وعداً فأين نجاحُهُ","قَدْ حان يا ابنَ الأكرمينَ سَرَاحُهُ",50,"ح",2,1],["قدِم الفطر صاحباً مودُودا","ومضى الصوم صاحباً محمودا",51,"د",2,1],["قدمتَ قدوم البدر بيتَ سُعُودِهِ","وأمرُك عالٍ صاعدٌ كصعودِهِ",52,"د",2,1],["قَد مَلَلْنا من ستر شيءٍ مليح","نشتهيه فهلْ له تجريدُ",53,"د",1,0],["قد مضت كرَّة موتٍ وأتت","بعدها كرّةُ خلدٍ غابره",54,"ر",2,0],["قِدماً كفاني وما عرفتك في","بدوٍ من الأرض لا ولا حضر",55,"ر",1,0],["قدِّمه إن ذكر المكارِمَ ذاكرٌ","فحظوظه منهن غير خِساس",56,"س",1,0],["قد مججناك يا كنيزة رِيّاً","فانبغي في زناك كل نبوغ",57,"غ",1,0],["قد مشقنا في قراطي","سك هاتيك الرقاق",58,"ق",1,0],["قد محا جورُك فيه","كلَّ حقٍّ وحقاق",58,"ق",1,0],["قدِمتُمُ سالمين والمجدُ مق","صورٌ عليكُم والفضلُ مشتركُ",59,"ك",1,0],["قد مشتْ فيهمُ حُميّا حفاظٍ","كحُميّا سُلافةِ الجِريالِ",60,"ل",1,0],["قدمتَ قُدومَ البُرء بعد سقامِ","على دارِ إسلامٍ ودار سلامِ",61,"م",1,1],["قدِمَ الأميرُ فمرحباً","بالقادمينَ وبالقُدوم",62,"م",1,0],["قَد ماتَ اهلُهُمُ مِن قَبلَ ميتَتِهِ","وَشاخَ ناشِءُهُم مِن قَبلِ يَكتَهِلُ",63,"ل",1,0],["قَد مَشى الغَربُ عَلى هامِ السُهى","وَمَشَينا في الحَضيضِ الأَسفَلِ",64,"ل",1,0],["قَد مَضى مَن تَتَمَنّى","كُلُّ عَينٍ أَن تَراه",65,"ه",1,0],["قَد مَلَكتني قَبلَما حِزتُها","وَمَلَكَتني وَهيَ في حَوزَتي",66,"ي",1,0],["قَدِمتَ قُ