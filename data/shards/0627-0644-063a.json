em36849.html","عموديه"],[303,"يا سيدا ألسن أقلامه","https://www.aldiwan.net/poem57732.html","البسيط"],[342,"نيسان يا روح القلوب","https://www.aldiwan.net/poem55318.html","مجزوء الكامل"],[348,"الغوث قد أكل الصيام ثيابي","https://www.aldiwan.net/poem19871.html","الكامل"],[366,"الغصن تثمره الأغصان من بان","https://www.aldiwan.net/poem17137.html","البسيط"],[371,"الغيث أبعد منك دارا","https://www.aldiwan.net/poem57259.html","مجزوء الكامل"],[377,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[391,"هذا وإن كنت أنا الظالم","https://www.aldiwan.net/poem54623.html","عموديه"],[394,"أجراس سوداء","https://www.aldiwan.net/poem17746.html","عموديه"],[402,"وافاك يصحبه الإسعاد والظفر","https://www.aldiwan.net/poem46940.html","البسيط"],[403,"يا أيها المولى","https://www.aldiwan.net/poem33758.html","مجزوء الرجز"],[405,"يا سيد الأمراء يا من جوده","https://www.aldiwan.net/poem49482.html","الكامل"],[410,"طاف الخيال وحيه بسلام","https://www.aldiwan.net/poem67468.html","الكامل"],[437,"ثلاثة لم يرها ناظر","https://www.aldiwan.net/poem2518.html","السريع"],[439,"نور الوفاء بأرضنا لك ساطع","https://www.aldiwan.net/poem34838.html","الكامل"],[453,"لا الطعنة البكر يوم الثأر تكفيني","https://www.aldiwan.net/poem61614.html","البسيط"],[453,"بوركت يا شعب الكنانة ثائرا","https://www.aldiwan.net/poem61626.html","الكامل"],[458,"نوازع الشوق والغليلِ","https://www.aldiwan.net/poem55990.html","مخلع البسيط"],[458,"مطل الدين ولو شاء قضى","https://www.aldiwan.net/poem56147.html","الرمل"],[464,"لو ألمت فأباحتني لما لها","https://www.aldiwan.net/poem3295.html","عموديه"],[468,"الغيم بين مزرر ومحلل","https://www.aldiwan.net/poem59763.html","الكامل"],[468,"الغيم ممدود السرادق","https://www.aldiwan.net/poem59837.html","مجزوء الكامل"],[468,"الغيم يبسط في السماء ويفرش","https://www.aldiwan.net/poem59930.html","الكامل"],[468,"الغرب بالليل مسك","https://www.aldiwan.net/poem60244.html","المجتث"],[468,"الغيم بين بكا وبين نحيب","https://www.aldiwan.net/poem60394.html","الكامل"],[468,"الغيم في حافتيه البرق يلتهب","https://www.aldiwan.net/poem60464.html","البسيط"],[468,"الغيم يخلط نوحه ببكائه","https://www.aldiwan.net/poem60507.html","الكامل"],[482,"ما الزهر ما ما الرحمن ما الحلل","https://www.aldiwan.net/poem24462.html","عموديه"],[500,"الغيب صف مواكبه","https://www.aldiwan.net/poem37562.html","مجزوء الكامل"],[503,"الغمرات ثم تنجلينا","https://www.aldiwan.net/poem21756.html","الرجز"],[515,"هل تعلمان طريقة لم تطرق","https://www.aldiwan.net/poem12186.html","الكامل"],[515,"ثغر الهدى متبلج بسام","https://www.aldiwan.net/poem12245.html","الكامل"],[551,"سائل بيثرب هل ثوى الركب","https://www.aldiwan.net/poem48101.html","أحذ الكامل"],[558,"يا من أرومهم بكل مرام","https://www.aldiwan.net/poem35091.html","الكامل"],[575,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[575,"باتت معانقتي ولكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"],[575,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"],[576,"أطردتني حذر الهجاء ولا","https://www.aldiwan.net/poem1778.html","أحذ الكامل"]],"verses":[["الغَورُ مِنهُ مَعانٌ","وَعاقِلٌ وَالهَضبُ",0,"ب",1,0],["الْغَمَامُ الأرْضَ يَسْقِي","وَأَنَا أَسْقِي الْغَمَامَا",1,"م",2,0],["أَلغَزتَ في شَيءٍ يَنم","مُ سِواهُ عَنهُ بِسِرِّهِ",2,"ر",2,1],["الغافِرُ الذَنبِ العَظيمِ","لِذي القَرابَةِ وَالمُمالِح",3,"ح",1,0],["أُلغِيَ البُعْدُ فِي المَسَافَةِ إِلاَّ","مِنْ جَنَانٍ وَقَدْ نَبَا بِجَنَانِ",4,"ن",1,0],["أَلْغَرْسُ غَرْسُكَ أَيُّهَا البُسْتَانِي","فَانْظُرْ إلى الثَّمَرَاتِ وَالأَغْصَانِ",5,"ن",1,1],["أَلغِيلُ تَطْرُقُهُ الذِّئَابُ عَشِيَّةً","وَبِلُهْنَةٍ يَتَشَاغَلُ اللَّيْثَانِ",6,"ن",1,0],["أَلْغَيْبُ خَاطَبَنَا بِنطْقٍ إِمَامِنَا","يدْعُو إِلَى العَلْيَاءِ فَلْنتَقدَّمِ",7,"م",1,0],["الغني باللّه صيفا","هي تسمّيه هي تكنّيه",8,"ه",1,0],["ألغز الدهر في الحقائق لكن","أفهم العلمُ أهلَه الغازه",9,"ز",2,0],["الغوث يا من إليه قد مددت يدي","ثم اقتدحت فاوْرى بالثنا زندي",10,"ي",1,0],["الغيث أنتَ وأنتَ أكرم ديمةً","والسهم أنت وأنت أسرع منفذا",11,"ذ",2,0],["الغيث والوحل عذري إن قعدت فمن","ذنب السماء وذنب الأرض أعتذر",12,"ر",1,0],["ألغازه في ضحى وممسى","فليس يخفى وليس يخفو",13,"ف",2,0],["ألغزته في واقف خاضع","كالعبد في تصريف أفعالك",14,"ك",1,0],["ألغتْ مواعيدَه فواضلُهُ","فلم يَقُل قطُّ لا ولا نعما",15,"م",2,0],["الغَدرُ في كُلِّ الطِبا","عِ فَلا أَخُصُّكَ بِالمَلامِ",16,"م",1,0],["الغادة الحسناء تشبه","النجوم الحاسره",17,"ر",2,0],["الغيد تبكي شجاها في المصاب وما","اشجى دموعا همت تبكي بها الغيد",18,"د",1,0],["الغرب والشرق طول الدهر بينهما","تنازع عجزت عن حسمها الحيل",19,"ل",1,0],["الغرب يشغله مال ومتربة","والشرق يشغله كفر وايمان",20,"ن",1,0],["الغرب عز بنوه اينما نزلوا","والشرق الا قليلا اهله هانوا",20,"ن",3,0],["الغرب مركبه البخا","ر أو الهواء أو الأثير",21,"ر",1,1],["الغرب فيه نشاط خلف حاجته","يسعى ليبلغها والشرق كسلان",22,"ن",1,0],["الغرب مستلب والشرق مهتضم","والغرب منتبه والشرق وسنان",22,"ن",1,0],["الغرب يكسوهم ملابس هم بها","يَعرَوْن من مال لهم ونُقود",23,"د",1,0],["الغاديات بلبى","الرائحات ببالى",24,"ل",2,0],["الغيم فيه كالنعام بدينة","بركت وأخرى حلقت بجناح",25,"ح",1,0],["الغادِيانِ لِنَجدَةٍ","الرائِحانِ إِلى وِقايَه",26,"ا",3,0],["الغافِلُ الأُمِّيُّ يَنطُقُ عِندَكُم","كَالبَبَّغاءِ مُرَدِّداً وَمُكَرِّرا",27,"ر",2,0],["أَلغَت مَسامِعُهُ المَلامَ وَغادَرَت","سِمَةً عَلى أَنفِ اللِئامِ تَلوحُ",28,"ح",1,0],["الغانِياتُ اللَواتي قَد رُزِقنَ غِنىً","عَنّا وَنَحنُ إِلَيهِنَّ المَحاويجُ",29,"ج",1,0],["الغِنى في النُفوسِ وَالفَقرُ فيها","اِن تَجَزَّت فَقَلَّ ما يُجزيها",30,"ه",2,0],["الغَيتَ ما رَوِّضوا مِن دونِ نائِلِهِم","وَالأُسدُ تَرهَبُهُم يَوماً إِذا غَضِبوا",31,"ب",3,0],["الغَيُّ أَوضَحُ مِن أَن","يَراهُ ذو العَقلِ رُشدا",32,"د",2,0],["الغَيُّ في ظُلمَةٍ وَالرُشدُ في صُوَرٍ","مُسَربَلاتٍ بِإِحسانٍ وَإِجمالِ",33,"ل",1,0],["الغَيُّ مُزدَحَمٌ عَلَيهِ وُعورَةٌ","وَالرُشدُ سَهلٌ ما عَلَيهِ زِحامُ",34,"م",1,0],["الغَيثُ عَقيبَ ما هَمى عارِضُهُ","وَالحُبُّ قَبيلَ ما نَمى عارِضُه",35,"ه",1,1],["الغَرامُ أَنحَلَهُ","إِذ أَصابَ مَقتَلَهُ",36,"ه",1,0],["الغَيمُ مِن بَينِ مَغبوقٍ وَمُصطَبَحِ","مِن ريقِ مُكتَفِلاتٍ بِالثَرى دُلُحِ",37,"ح",1,1],["الغصنُ حرَّكه الهوا","ءُ وأنتِ حركْتِ الهوى",38,"ه",3,0],["الغاسلِ الهمَّ في ثغرٍ، وفي حَبَبٍ","والمُلبسِ العقلَ أزياءَ المجانين",39,"ن",1,0],["الغاصبُ المغتالُ أعرضَ ساخراً","لمّا دَعَوهُ الواهبَ المِفضالا",40,"ل",2,0],["الغَربُ في بَرَكاتِ العِلمِ مُنغَمِسٌ","وَالشَرقُ في ظُلُماتِ الجَهلِ مَوؤودُ",41,"د",1,0],["ألغَى الصّلاةَ وأعطى النَّاسَ بُغْيَتَهُمْ","مِنَ الزِّنا ومن السُّمِّ الذُّعافِ مَعا",42,"ع",2,0],["الغَيثُ أَنتَ بَل أَنتَ أَعذَبُ شيمَةً","وَأَعَمُّ إِحساناً وَأَعظَمُ عُنصُرا",43,"ر",2,0],["الغُصنُ يَمرَحُ تَحتَهُ وَالنَهرُ في","قَصفٍ تُدَرِّجُهُ يَدُ الأَرواحِ",44,"ح",1,0],["الغيثُ أوّلهم وليْسَ بمُعْدِمٍ","والبحرُ منهُم وهو غير ضريك",45,"ك",1,0],["الغِيُّ يُعدي فَاِجتَنِب قُربَهُ","وَاِحذَر بُغى مُعتَزَلِ الأَجرَبِ",46,"ب",1,0],["أَلغى صَلاةَ العَصرِ مُحتَقِراً","وَرَمى وَراءَ الظَهرِ بِالظُهرِ",47,"ر",1,0],["الغَيبُ مَجهولٌ يُحارُ دَليلُهُ","وَاللُبُّ يَأمُرُ أَهلَهُ أَن يَتَّقوا",48,"ق",3,1],["الغامِرُ الطارِقُ المُحتاجَ نائِلُهُ","أَو اِبنَ مِريَةَ مِن أُمّاتِهِ يَتِما",49,"م",2,0],["الغَدرُ فينا طِباعٌ لا تَرى أَحَداً","وَفاءُهُ لَكَ خَيرٌ مِن تَوافيهِ",50,"ف",3,1],["الغالبونَ وإن قلّوا وظَنّ بهم","ما يكرهُ اللَّهُ أهلُ الزُّورِ والخَطَلِ",51,"ل",1,0],["الغرب سباق وأَنت مقصر","يا شرق نحو مدى يرام سحيق",52,"ق",1,0],["الغرب مستند إلى التدبيرِ","والشرق معتمد على التقديرِ",53,"ر",1,1],["الغرب حر للقيود مقطع","والشرق من عاداته كأسير",53,"ر",1,0],["الغرب قد أَخذ اللباب لنفسه","والشرق لاه أَهله بقشور",53,"ر",1,0],["الغرب كان يُعدُّ أَمر رقيِّه","إذ لَم يكن للشرق من إِعداد",54,"د",1,1],["الغامزات بالعيو","نِ النجل والحواجب",55,"ب",1,0],["الغرب يَلقاك من مَكْ","رِهِ بوجه طَليقِ",56,"ق",1,1],["الغرب والشرق حتى اليوم ما اِستويا","هَذا نَشيط وَهَذا بعد كسلان",57,"ن",1,0],["الغريبانِ عليها التَقَيَا","يستعينان على الدَّربِ الطويل",58,"ل",1,0],["الغريبانِ ههنا","ليس يُجديهما الحذَرْ",59,"ر",1,0],["الغارُ أحقرُ أن يكلِّلَ هامَهمْ","ورؤوسهم أغلى من التيجانِ",60,"ن",1,0],["الغَيْثُ جِدّاً في نِهَايَةِ أَمْرِهِ","مَا خِلْتُهُ إِحْدَى المَهَازِلِ بَادِئا",61,"ا",2,0],["أَلْغَنِيُّ يَعْصِمُ الشُّعُوبَ","وَيَعْلِيهَا وَحِرْمَانُهَا يَذِلُّ وَيُشْقِي",62,"ق",2,0],["أَلغَازِيَاتُ قُلوبَ عُشاقِ النهَى","بِالفَضْلِ لاَ بِمُثَقَّفٍ وَمُهَنَّدِ",63,"د",1,0],["أَلغَانِيَاتُ بِمَعْنَوِيَّاتِ الحِلَى","عَنْ لُؤْلؤ بِنُحُورِهِنَّ وَعَسْجَد",63,"د",1,0],["ألغَيمةُ البيضاءُ مثل القبه","كأنها من الحريرِ جُبّه",64,"ه",1,0],["الغربُ سار على هُدَى أطماعِهِ","فتعثَّرَتْ قَدَمَاهُ أيَّ عِثار",65,"ر",1,0],["الغثُّ لا بُقْيا له","مهما أَذِيع أو انتشر",66,"ر",1,0],["الغيدُ تسبحُ أو تميسُ بشطَّه","أسراب آرامٍ بغير نفار",67,"ر",1,0],["الغدرُ دَيْدَن شعبهم؛ فلوَ أنَّهُ","يومًا وَفَى، لعجبت ألاَّ يَغْدرا!",68,"ر",2,0],["الغربُ يعرف ما أدَّى بنوك لهُ","الكُتْبُ تنطق، والأقلامُ شُهَّاد",69,"د",1,0],["الغبار امتد سقفا أرجلا","أعينا مثل الحصى ، تغلي وتمطر",70,"ر",1,0],["الغزاة الذين يوما تلاشوا","بقوانا لهم علينا اقتحام",71,"م",1,0],["الغَرامُ مِجْمَرَةٌ","والتَّريُّبُ الشَّرَرُ",72,"ر",1,1],["الْغَيُّ يُنْجِدُ بالرَصاصُ مُزَمْجِراً","والرّشدَ يَنجِدُ بالحجارةِ حاصبا",73,"ب",2,0],["ألغات هذا الشرق سيري للعلى","جنباً لجنب رافقتك الضاد",74,"د",1,0],["ألغانيات اللواتي قد رزقن عنى","عنا ونحن إليهن المحاويج",75,"ج",1,0],["ألغدر في داود بعد مشيبه","ورعاية الأضياف من راحاب",76,"ب",1,0],["ألغد الميمون في الدنيا لكم","فاقتحم يا جيش واخفق يا لواء",77,"ا",2,0],["الغوالي أديمها واللآلي","وحصاها الياقوت والمرجان",78,"ن",1,0],["الغافيات فلم ترع منها الزماجر والوثاب","أشتاق أحضنها وألثمها وللدمع انسكاب",79,"ب",1,0],["الغوث من هذا الجمود فإنه","تالله أهونُ منه صُمَّ الجندل",80,"ل",1,0],["ألغارة الشعواء عيد كماتها","ودم اللطّلى المشبوب كأس مدامها",81,"م",3,0],["الغارة الغارة يا مصطفى","فالحظ اعيته قيود الجفا",82,"ف",2,1],["الغوث عز الدين احمد مقتدى","اهل الهدى اذ تغلط الاهواء",83,"ا",2,0],["ألغَيتُهُ خُلَّباً بَرقاً مُسَيلَمَةً","وتُصبِحَ نَهباً لِلمَزَابِرِ والدَّوَا",84,"و",2,0],["الغَيثُ يَهمي ثُمَّ يُقلِعُ صَوبُهُ","حيناً وَلَيسَ نَداكَ عَنّا مُقلِعا",85,"ع",2,0],["أَلغَيتُ آبائي وَشامِخَ ما بَنوا","لي مِن عُلىً وَعَدَدتُ هَذا المَوقِفا",86,"ف",2,0],["الغيثُ وال