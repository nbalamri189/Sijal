{"poems":[[53,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[77,"علم الملوك أعني","https://www.aldiwan.net/poem36098.html","مجزوء الرمل"],[71,"ألغزت في شيء","https://www.aldiwan.net/poem3852.html","مجزوء الكامل"],[10,"يا عين جودي بالدموع","https://www.aldiwan.net/poem21064.html","مجزوء الكامل"],[93,"يا ابن لبنان عد إلى لبنان","https://www.aldiwan.net/poem11175.html","الخفيف"],[93,"ألغرس غرسك أيها البستاني","https://www.aldiwan.net/poem11219.html","الكامل"],[93,"صدق النعي وردد الهرمان","https://www.aldiwan.net/poem11225.html","الكامل"],[93,"عد لابساً ثوب الخلود وعلم","https://www.aldiwan.net/poem11356.html","الكامل"],[83,"شت أن معين مبارك","https://www.aldiwan.net/poem54201.html","مجزوء الرمل"],[88,"أن من حاز في العلوم إجازه","https://www.aldiwan.net/poem45000.html","الخفيف"],[72,"قد آثر القوم من بيروت همهم","https://www.aldiwan.net/poem18616.html","البسيط"],[72,"قاضي القضاة المرتجى دمت ذا","https://www.aldiwan.net/poem18681.html","السريع"],[72,"يا سيد الوزراء الأكرمين ومن","https://www.aldiwan.net/poem18783.html","البسيط"],[72,"يا من له في طريق زهد","https://www.aldiwan.net/poem19262.html","مخلع البسيط"],[72,"فتحت لي بابا من الود ما","https://www.aldiwan.net/poem19531.html","السريع"],[51,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[70,"يا معرضا متجنبا","https://www.aldiwan.net/poem42698.html","مجزوء الكامل"],[89,"ما انت الا نادره","https://www.aldiwan.net/poem44632.html","مجزوء الرجز"],[89,"قد عدت بعد ذهاب منك يا عيد","https://www.aldiwan.net/poem44645.html","البسيط"],[89,"في الغرب حيث كلا الجنسين يشتغل","https://www.aldiwan.net/poem44869.html","الطويل"],[89,"قد قلت حقا فلم تقبله أذهان","https://www.aldiwan.net/poem44873.html","البسيط"],[89,"الغرب مركبه البخار","https://www.aldiwan.net/poem44884.html","مجزوء الكامل"],[89,"قد طال للغرب فوق الارض سلطان","https://www.aldiwan.net/poem44895.html","البسيط"],[89,"من كان في المجد المؤثل راغبا","https://www.aldiwan.net/poem44986.html","الكامل"],[85,"على منازل غالي","https://www.aldiwan.net/poem7249.html","المجتث"],[85,"آذار أقبل قم بنا يا صاح","https://www.aldiwan.net/poem7257.html","الكامل"],[85,"جبريل أنت هدى السماء","https://www.aldiwan.net/poem63729.html","مجزوء الكامل"],[85,"قم في فم الدنيا وحي الأزهرا","https://www.aldiwan.net/poem63764.html","الكامل"],[43,"جللا كما بي فليك التبريح","https://www.aldiwan.net/poem9522.html","الكامل"],[45,"قد كان يعلم من طرفي بها طرفا","https://www.aldiwan.net/poem62683.html","البسيط"],[58,"فلا تصحب أخا الجهل","https://www.aldiwan.net/poem30813.html","الهزج"],[58,"الأزد سيفي على الأعداء كلهم","https://www.aldiwan.net/poem31152.html","البسيط"],[49,"ما أقرب الموت جدا","https://www.aldiwan.net/poem62058.html","المجتث"],[49,"ما لي أفرط فيما ينبغي مالي","https://www.aldiwan.net/poem63080.html","البسيط"],[49,"نادت بوشك رحيلك الأيام","https://www.aldiwan.net/poem63112.html","الكامل"],[66,"الغيث عقيب ما همى عارضه","https://www.aldiwan.net/poem39036.html","الدوبيت"],[66,"وحق الهوى ما حلت يوما عن الهوى","https://www.aldiwan.net/poem39641.html","الطويل"],[44,"الغيم من بين مغبوق ومصطبح","https://www.aldiwan.net/poem29698.html","البسيط"],[69,"فعلت وقالت قامتي","https://www.aldiwan.net/poem28619.html","مجزوء الكامل"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[105,"ركب الرفاق الظاعنين عجالا","https://www.aldiwan.net/poem42127.html","الكامل"],[105,"مهلا بني الشرق لا تعطف بكم همم","https://www.aldiwan.net/poem43411.html","البسيط"],[105,"بني حنيفة ما أشقى مسيلمة","https://www.aldiwan.net/poem44011.html","البسيط"],[81,"ذد عن موارد أدمعي طير الكرى","https://www.aldiwan.net/poem61523.html","الكامل"],[81,"غيري يميل إلى كلام اللاحي","https://www.aldiwan.net/poem61541.html","الكامل"],[75,"فتكات طرفك أم سيوف أبيك","https://www.aldiwan.net/poem69051.html","الكامل"],[50,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[46,"استحي من شمس النهار ومن","https://www.aldiwan.net/poem22726.html","الكامل"],[46,"الغيب مجهول يحار دليله","https://www.aldiwan.net/poem23025.html","الكامل"],[46,"يدعو الغراب أناس حاتما سفها","https://www.aldiwan.net/poem23344.html","البسيط"],[46,"الغدر فينا طباع لا ترى أحدا","https://www.aldiwan.net/poem23589.html","البسيط"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49158","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85550","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85539","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85491","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85812","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85712","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85600","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125573","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54544","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55081","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54718","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142040","الرجز"],[106,"مهبِط الوحي","https://www.poetsgate.com/ViewPoem.aspx?id=179626",""],[106,"هل عاد قيس؟","https://www.poetsgate.com/ViewPoem.aspx?id=179386",""],[106,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179775",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[106,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[98,"غيرة","https://www.poetsgate.com/ViewPoem.aspx?id=55306",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"الوحدة العربية الممزقة","https://www.poetsgate.com/ViewPoem.aspx?id=178953",""],[45,"قد كان يعلم من طرفي بها طرفاً","https://www.poetsgate.com/ViewPoem.aspx?id=32944",""],[88,"يا عدل طال الانتظار فعجلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19514&r=&rc=17",""]],"verses":[["الغَورُ مِنهُ مَعانٌ","وَعاقِلٌ وَالهَضبُ",0,"ب",1,0],["الْغَمَامُ الأرْضَ يَسْقِي","وَأَنَا أَسْقِي الْغَمَامَا",1,"م",2,0],["أَلغَزتَ في شَيءٍ يَنم","مُ سِواهُ عَنهُ بِسِرِّهِ",2,"ر",2,1],["الغافِرُ الذَنبِ العَظيمِ","لِذي القَرابَةِ وَالمُمالِح",3,"ح",1,0],["أُلغِيَ البُعْدُ فِي المَسَافَةِ إِلاَّ","مِنْ جَنَانٍ وَقَدْ نَبَا بِجَنَانِ",4,"ن",1,0],["أَلْغَرْسُ غَرْسُكَ أَيُّهَا البُسْتَانِي","فَانْظُرْ إلى الثَّمَرَاتِ وَالأَغْصَانِ",5,"ن",1,1],["أَلغِيلُ تَطْرُقُهُ الذِّئَابُ عَشِيَّةً","وَبِلُهْنَةٍ يَتَشَاغَلُ اللَّيْثَانِ",6,"ن",1,0],["أَلْغَيْبُ خَاطَبَنَا بِنطْقٍ إِمَامِنَا","يدْعُو إِلَى العَلْيَاءِ فَلْنتَقدَّمِ",7,"م",1,0],["الغني باللّه صيفا","هي تسمّيه هي تكنّيه",8,"ه",1,0],["ألغز الدهر في الحقائق لكن","أفهم العلمُ أهلَه الغازه",9,"ز",2,0],["الغوث يا من إليه قد مددت يدي","ثم اقتدحت فاوْرى بالثنا زندي",10,"ي",1,0],["الغيث أنتَ وأنتَ أكرم ديمةً","والسهم أنت وأنت أسرع منفذا",11,"ذ",2,0],["الغيث والوحل عذري إن قعدت فمن","ذنب السماء وذنب الأرض أعتذر",12,"ر",1,0],["ألغازه في ضحى وممسى","فليس يخفى وليس يخفو",13,"ف",2,0],["ألغزته في واقف خاضع","كالعبد في تصريف أفعالك",14,"ك",1,0],["ألغتْ مواعيدَه فواضلُهُ","فلم يَقُل قطُّ لا ولا نعما",15,"م",2,0],["الغَدرُ في كُلِّ الطِبا","عِ فَلا أَخُصُّكَ بِالمَلامِ",16,"م",1,0],["الغادة الحسناء تشبه","النجوم الحاسره",17,"ر",2,0],["الغيد تبكي شجاها في المصاب وما","اشجى دموعا همت تبكي بها الغيد",18,"د",1,0],["الغرب والشرق طول الدهر بينهما","تنازع عجزت عن حسمها الحيل",19,"ل",1,0],["الغرب يشغله مال ومتربة","والشرق يشغله كفر وايمان",20,"ن",1,0],["الغرب عز بنوه اينما نزلوا","والشرق الا قليلا اهله هانوا",20,"ن",3,0],["الغرب مركبه البخا","ر أو الهواء أو الأثير",21,"ر",1,1],["الغرب فيه نشاط خلف حاجته","يسعى ليبلغها والشرق كسلان",22,"ن",1,0],["الغرب مستلب والشرق مهتضم","والغرب منتبه والشرق وسنان",22,"ن",1,0],["الغرب يكسوهم ملابس هم بها","يَعرَوْن من مال لهم ونُقود",23,"د",1,0],["الغاديات بلبى","الرائحات ببالى",24,"ل",2,0],["الغيم فيه كالنعام بدينة","بركت وأخرى حلقت بجناح",25,"ح",1,0],["الغادِيانِ لِنَجدَةٍ","الرائِحانِ إِلى وِقايَه",26,"ا",3,0],["الغافِلُ الأُمِّيُّ يَنطُقُ عِندَكُم","كَالبَبَّغاءِ مُرَدِّداً وَمُكَرِّرا",27,"ر",2,0],["أَلغَت مَسامِعُهُ المَلامَ وَغادَرَت","سِمَةً عَلى أَنفِ اللِئامِ تَلوحُ",28,"ح",1,0],["الغانِياتُ اللَواتي قَد رُزِقنَ غِنىً","عَنّا وَنَحنُ إِلَيهِنَّ المَحاويجُ",29,"ج",1,0],["الغِنى في النُفوسِ وَالفَقرُ فيها","اِن تَجَزَّت فَقَلَّ ما يُجزيها",30,"ه",2,0],["الغَيتَ ما رَوِّضوا مِن دونِ نائِلِهِم","وَالأُسدُ تَرهَبُهُم يَوماً إِذا غَضِبوا",31,"ب",3,0],["الغَيُّ أَوضَحُ مِن أَن","يَراهُ ذو العَقلِ رُشدا",32,"د",2,0],["الغَيُّ في ظُلمَةٍ وَالرُشدُ في صُوَرٍ","مُسَربَلاتٍ بِإِحسانٍ وَإِجمالِ",33,"ل",1,0],["الغَيُّ مُزدَحَمٌ عَلَيهِ وُعورَةٌ","وَالرُشدُ سَهلٌ ما عَلَيهِ زِحامُ",34,"م",1,0],["الغَيثُ عَقيبَ ما هَمى عارِضُهُ","وَالحُبُّ قَبيلَ ما نَمى عارِضُه",35,"ه",1,1],["الغَرامُ أَنحَلَهُ","إِذ أَصابَ مَقتَلَهُ",36,"ه",1,0],["الغَيمُ مِن بَينِ مَغبوقٍ وَمُصطَبَحِ","مِن ريقِ مُكتَفِلاتٍ بِالثَرى دُلُحِ",37,"ح",1,1],["الغصنُ حرَّكه الهوا","ءُ وأنتِ حركْتِ الهوى",38,"ه",3,0],["الغاسلِ الهمَّ في ثغرٍ، وفي حَبَبٍ","والمُلبسِ العقلَ أزياءَ المجانين",39,"ن",1,0],["الغاصبُ المغتالُ أعرضَ ساخراً","لمّا دَعَوهُ الواهبَ المِفضالا",40,"ل",2,0],["الغَربُ في بَرَكاتِ العِلمِ مُنغَمِسٌ","وَالشَرقُ في ظُلُماتِ الجَهلِ مَوؤودُ",41,"د",1,0],["ألغَى الصّلاةَ وأعطى النَّاسَ بُغْيَتَهُمْ","مِنَ الزِّنا ومن السُّمِّ الذُّعافِ مَعا",42,"ع",2,0],["الغَيثُ أَنتَ بَل أَنتَ أَعذَبُ شيمَةً","وَأَعَمُّ إِحساناً وَأَعظَمُ عُنصُرا",43,"ر",2,0],["الغُصنُ يَمرَحُ تَحتَهُ وَالنَهرُ في","قَصفٍ تُدَرِّجُهُ يَدُ الأَرواحِ",44,"ح",1,0],["الغيثُ أوّلهم وليْسَ بمُعْدِمٍ","والبحرُ منهُم وهو غير ضريك",45,"ك",1,0],["الغِيُّ يُعدي فَاِجتَنِب قُربَهُ","وَاِحذَر بُغى مُعتَزَلِ الأَجرَبِ",46,"ب",1,0],["أَلغى صَلاةَ العَصرِ مُحتَقِراً","وَرَمى وَراءَ الظَهرِ بِالظُهرِ",47,"ر",1,0],["الغَيبُ مَجهولٌ يُحارُ دَليلُهُ","وَاللُبُّ يَأمُرُ أَهلَهُ أَن يَتَّقوا",48,"ق",3,1],["الغامِرُ الطارِقُ المُحتاجَ نائِلُهُ","أَو اِبنَ مِريَةَ مِن أُمّاتِهِ يَتِما",49,"م",2,0],["الغَدرُ فينا طِباعٌ لا تَرى أَحَداً","وَفاءُهُ لَكَ خَيرٌ مِن تَوافيهِ",50,"ف",3,1],["الغالبونَ وإن قلّوا وظَنّ بهم","ما يكرهُ اللَّهُ أهلُ الزُّورِ والخَطَلِ",51,"ل",1,0],["الغرب سباق وأَنت مقصر","يا شرق نحو مدى يرام سحيق",52,"ق",1,0],["الغرب مستند إلى التدبيرِ","والشرق معتمد على التقديرِ",53,"ر",1,1],["الغرب حر للقيود مقطع","والشرق من عاداته كأسير",53,"ر",1,0],["الغرب قد أَخذ اللباب لنفسه","والشرق لاه أَهله بقشور",53,"ر",1,0],["الغرب كان يُعدُّ أَمر رقيِّه","إذ لَم يكن للشرق من إِعداد",54,"د",1,1],["الغامزات بالعيو","نِ النجل والحواجب",55,"ب",1,0],["الغرب يَلقاك من مَكْ","رِهِ بوجه طَليقِ",56,"ق",1,1],["الغرب والشرق حتى اليوم ما اِستويا","هَذا نَشيط وَهَذا بعد كسلان",57,"ن",1,0],["الغريبانِ عليها التَقَيَا","يستعينان على الدَّربِ الطويل",58,"ل",1,0],["الغريبانِ ههنا","ليس يُجديهما الحذَرْ",59,"ر",1,0],["الغارُ أحقرُ أن يكلِّلَ هامَهمْ","ورؤوسهم أغلى من التيجانِ",60,"ن",1,0],["الغَيْثُ جِدّاً في نِهَايَةِ أَمْرِهِ","مَا خِلْتُهُ إِحْدَى المَهَازِلِ بَادِئا",61,"ا",2,0],["أَلْغَنِيُّ يَعْصِمُ الشُّعُوبَ","وَيَعْلِيهَا وَحِرْمَانُهَا يَذِلُّ وَيُشْقِي",62,"ق",2,0],["أَلغَازِيَاتُ قُلوبَ عُشاقِ النهَى","بِالفَضْلِ لاَ بِمُثَقَّفٍ وَمُهَنَّدِ",63,"د",1,0],["أَلغَانِيَاتُ بِمَعْنَوِيَّاتِ الحِلَى","عَنْ لُؤْلؤ بِنُحُورِهِنَّ وَعَسْجَد",63,"د",1,0],["ألغَيمةُ البيضاءُ مثل القبه","كأنها من الحريرِ جُبّه",64,"ه",1,0],["الغربُ سار على هُدَى أطماعِهِ","فتعثَّرَتْ قَدَمَاهُ أيَّ عِثار",65,"ر",1,0],["الغثُّ لا بُقْيا له","مهما أَذِيع أو انتشر",66,"ر",1,0],["الغيدُ تسبحُ أو تميسُ بشطَّه","أسراب آرامٍ بغير نفار",67,"ر",1,0],["الغدرُ دَيْدَن شعبهم؛ فلوَ أنَّهُ","يومًا وَفَى، لعجبت ألاَّ يَغْدرا!",68,"ر",2,0],["الغربُ يعرف ما أدَّى بنوك لهُ","الكُتْبُ تنطق، والأقلامُ شُهَّاد",69,"د",1,0],["الغَرامُ مِجْمَرَةٌ","والتَّريُّبُ الشَّرَرُ",70,"ر",1,1],["الْغَيُّ يُنْجِدُ بالرَصاصُ مُزَمْجِراً","والرّشدَ يَنجِدُ بالحجارةِ حاصبا",71,"ب",2,0],["ألغات هذا الشرق سيري للعلى","جنباً لجنب رافقتك الضاد",72,"د",1,0],["ألغانيات اللواتي قد رزقن عنى","عنا ونحن إليهن المحاويج",73,"ج",1,0],["الغوث من هذا الجمود فإنه","تالله أهونُ منه صُمَّ الجندل",74,"ل",1,0]]}