{"poems":[[63,"ألفت الندى والعامرية تعذل","https://www.aldiwan.net/poem46139.html","الطويل"],[77,"سقى دارهم هام من السحب هامع","https://www.aldiwan.net/poem35996.html","الطويل"],[9,"ألا يا قتل قد خلق الجديد","https://www.aldiwan.net/poem21929.html","الوافر"],[86,"لم يبق شيء من الدنيا بأيدينا","https://www.aldiwan.net/poem10507.html","البسيط"],[93,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[83,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[88,"سقتنا المعالي من سلافتها صرفا","https://www.aldiwan.net/poem44835.html","الطويل"],[47,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[47,"تواعدنا بآذار","https://www.aldiwan.net/poem25247.html","الهزج"],[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[51,"ذكرتك حين ألقت بي عصاها","https://www.aldiwan.net/poem8527.html","الوافر"],[51,"زارت على غفلة من الحرس","https://www.aldiwan.net/poem64675.html","المنسرح"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[91,"سرى يطوي بنا الأميال طيا","https://www.aldiwan.net/poem8858.html","عموديه"],[70,"أرى قوما بليت بهم","https://www.aldiwan.net/poem43003.html","مجزوء الوافر"],[38,"أبت آيات حبى أن تبينا","https://www.aldiwan.net/poem7818.html","الوافر"],[38,"ألم يسأل الركب الديار العوافيا","https://www.aldiwan.net/poem7821.html","الطويل"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[43,"لجنية أم غادة رفع السجف","https://www.aldiwan.net/poem9728.html","الطويل"],[62,"يا حادي الظعن رفقا إنك الجاني","https://www.aldiwan.net/poem52253.html","البسيط"],[28,"عجبتُ لركب فرحتهم مليحة","https://www.aldiwan.net/poem1235.html",""],[61,"يورقه إذا البرق استنارا","https://www.aldiwan.net/poem51678.html","الوافر"],[61,"وسألت عنه فقيل مات لما به","https://www.aldiwan.net/poem51761.html","الكامل"],[97,"يا سجين الحياة أين الفرار","https://www.aldiwan.net/poem24992.html","الخفيف"],[52,"الآن سرت فؤادي مقلة الريم","https://www.aldiwan.net/poem26682.html","البسيط"],[48,"يا طيبنا بقصور القفص مشرفة","https://www.aldiwan.net/poem62551.html","البسيط"],[48,"أذاقني الصد سوء تدبيري","https://www.aldiwan.net/poem63283.html","المنسرح"],[48,"بدير بهرذان لي مجلس","https://www.aldiwan.net/poem65291.html","السريع"],[48,"دعني من الدار أبكيها وأرثيها","https://www.aldiwan.net/poem66175.html","البسيط"],[8,"إما تري ظلل الأيام قد حسرت","https://www.aldiwan.net/poem21815.html","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42504","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54693","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55058","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54850","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54638","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67333","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54235","الوافر"],[106,"صدى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179584",""],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[100,"في المساء","https://www.poetsgate.com/ViewPoem.aspx?id=50420",""],[97,"السراب في السجن","https://www.poetsgate.com/ViewPoem.aspx?id=11415",""],[133,"أدينك أن تذمى الخيزرانا","https://www.aldiwan.net/poem54721.html","الوافر"],[136,"كنت في مصر قوة ذات بال","https://www.aldiwan.net/poem49176.html","الخفيف"],[143,"هززناكم بالمدح نجنى ثماركم","https://www.aldiwan.net/poem58387.html","الطويل"],[144,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[151,"دليل علاك ليس على اعتراض","https://www.aldiwan.net/poem68471.html","الوافر"],[200,"مالت دلالا فارتمى شعرها","https://www.aldiwan.net/poem45536.html","السريع"],[212,"إلى شاطئ فيه إغراقكم","https://www.aldiwan.net/poem46245.html","المتقارب"],[236,"لو أن قلبك مثل قلبي مغرم","https://www.aldiwan.net/poem31768.html","الكامل"],[278,"ألا من مُبلغ عمرو بن لأيٍ","https://www.aldiwan.net/poem1169.html",""],[283,"دعا مهجة الصب لا تردعاها","https://www.aldiwan.net/poem32310.html","المتقارب"],[298,"وافى وأفق الدجى بالزهد متشح","https://www.aldiwan.net/poem33301.html","البسيط"],[365,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[365,"إذا ضربوا بكاظمة الخياما","https://www.aldiwan.net/poem60656.html","الوافر"],[365,"لها في حمى مني وراء الترائب","https://www.aldiwan.net/poem60994.html","الطويل"],[366,"ديار أقفرت من أم سلمى","https://www.aldiwan.net/poem44528.html","الوافر"],[372,"أبقى الرسيم من الركاب رسوما","https://www.aldiwan.net/poem57136.html","الكامل"],[403,"ركبنا مطايا الشوق سعيا إليكم","https://www.aldiwan.net/poem46449.html","الطويل"],[417,"تذكر عهدا بالحمى قد تقدما","https://www.aldiwan.net/poem53977.html","الطويل"],[417,"بلغتم كمال الرشد أبناء راشد","https://www.aldiwan.net/poem54010.html","الطويل"],[417,"قدمت قدوم الغاديات السواجم","https://www.aldiwan.net/poem54041.html","الطويل"],[422,"لولاك ما كان ودي","https://www.aldiwan.net/poem46399.html","المجتث"],[438,"قف إن شاني بهم أن يسفح الشان","https://www.aldiwan.net/poem2574.html","البسيط"],[453,"كم حللت الحبى بشرخ الشباب","https://www.aldiwan.net/poem13629.html","الخفيف"],[453,"سواي استمالته الظباء الأوانس","https://www.aldiwan.net/poem13805.html","الطويل"],[454,"لكما شكرت تحية الزهر","https://www.aldiwan.net/poem61295.html","أحذ الكامل"],[459,"آنسة لا تكتم القول الحسن","https://www.aldiwan.net/poem55847.html","الرجز"],[459,"لنا من ليلنا بلِوى الصريمِ","https://www.aldiwan.net/poem55891.html","الوافر"],[462,"نحن قوم من تميم بن مر","https://www.aldiwan.net/poem16100.html","المديد"],[465,"وجودك غادر النعمى معينا","https://www.aldiwan.net/poem3274.html","عموديه"],[469,"غنى فأبكى بصوته الفرنجا","https://www.aldiwan.net/poem60320.html","المنسرح"],[480,"تهاطلت الرسائل منك تترى","https://www.aldiwan.net/poem36932.html","الوافر"],[545,"حديقة بلا غناء","https://www.aldiwan.net/poem67250.html","عموديه"],[559,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[559,"سلام عظيم من عظيم تفردا","https://www.aldiwan.net/poem34594.html","الطويل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["فلَمْ نَدْرِ إذا أمّتْ بِنا بابَ أحْمَدٍ","أنَحنُ إِلى نادِيهِ أمْ هِيَ أعْجَلُ",0,"ل",1,0],["فلمْ نَرَ منْ قبْلِ اسْتِلامِ يَمينِه","بِحارَ نَوالٍ قِيلَ هُنّ أصابعُ",1,"ع",1,0],["فَلَم نَطلُب لَهُ شُكراً وَلَكِن","نُوَلّي حَمدَ ذَلِكَ مَن يُريدُ",2,"د",1,0],["فَلَم نَزَل وَصُروفُ الدَهرِ تَرمُقُنا","شَزراً وَتَخدَعُنا الدُنيا وَتُلهينا",3,"ن",2,0],["فَلَّ مِنْ غَرْبِ مِصْرَ أَنْ يَتَوَلَّى","خِلُّهَا البَرُّ وَالوَلِيُّ الأَمِينُ",4,"ن",1,0],["فلم ندرِ روضاً منه أنعَمَ نَضْرَةً","وأعطرَ أرجاءً وأحلى مجانيا",5,"ي",2,0],["فلم نَرضَ غير العلم تاجاً لرأسها","ولا غير شَنْف العدل في أذنها شَنفا",6,"ف",2,0],["فَلَم نَزَل نَصيدُها وَنَصرَعُ","حَتّى تَبَقّى في القَطيعِ أَربَعُ",7,"ع",1,0],["فَلَم نَزَل بِالخَيلِ وَالكِلابِ","نَجزُرُها جَزراً إِلى الأَغبابِ",7,"ب",1,0],["فَلَم نَزَل نَقلي وَنَشوي وَنَصُب","حَتّى طَلَبنا صاحِياً فَلَم نُصِب",7,"ب",1,0],["فَلَم نَزَل سَبعَ لَيالٍ عَدَدا","أَسعَدَ مَن راحَ وَأَحظى مَن غَدا",7,"د",2,0],["فَلَم نَدرِ وَقَد فاحَت","لَنا مِن جانِبِ الدارِ",8,"ر",1,0],["فلم نزل في منزل كريم","نروي حديث الرمي عن قديم",9,"م",1,0],["فلم نملك سوابق مُقْرَحَاتٍ","من الأجفان بالدمع السكوبِ",10,"ب",1,0],["فلم نزل من نعيم ليلتنا","باللهو في مثل ليلة العُرس",11,"س",1,0],["فلم نَرَكَ استوحشتَ منها لوحْدَة","ولا جُرْتَ عن قصد لأنك مُعلَمُ",12,"م",1,0],["فلِمَنْ يُسالِمُهُ سلامَتُهُ","ولمن يُحاربُ عطْسَةُ اللَّجَمِ",13,"م",1,0],["فَلَم نَدر وَجُنحُ اللَيلِ داجٍ","أَبَرقاً ما رَكِبنا أَم قِطارا",14,"ر",2,0],["فَلَم نَظفَر بِحاجَتِنا","وَأَشفَينا عَلى العَطَبِ",15,"ب",1,0],["فَلَم نَشعُر بِضَوءِ الصُبحِ حَتّى","سَمِعنا في مَساجِدِنا الأَذينا",16,"ن",2,0],["فَلَم نَرَ خالاً مِثلَ خالِكَ سوقَةً","إِذا اِبتَدَرَ القَومُ الكِرامُ المَساعِيا",17,"ي",2,0],["فلِمَنْ كنتِ تنشدين فقالتْ","للضياءِ البنفسجيِّ الحزينِ",18,"ن",1,0],["فَلِمَن حاوَلَ النَعيمَ نَعيمٌ","وَلِمَن آثَرَ الشَقاءَ شَقاءُ",19,"ا",2,0],["فَلَم نَرَ قَبلَ اِبنِ الحُسَينِ أَصابِعاً","إِذا ما هَطَلنَ اِستَحيَتِ الدِيَمُ الوُطفُ",20,"ف",1,0],["فلم نزلْ تحتَ جُنْحِ الليلِ في عُلَقٍ","من العِناقِ ولم نَهْمُمْ بعدوانِ",21,"ن",1,0],["فَلَم نَأتِها حَتّى لَعَنّا مَكانَها","وَحَتّى اِشتَفى مِن نَومِهِ صاحِبُ الكَرى",22,"ا",1,0],["فلم نُظْهِرْ له إلا قِراعاً","ولم نَلْبَسْ له إلا وَقارا",23,"ر",2,0],["فلِمَن أصونُ مَدامعي من بعدِه","ولأيِّما أبكيهِ من أسبابِه",24,"ب",2,0],["فلمن لفتةٌ وفيم ارتقاب","ليس بعد الذي انتظرت انتظار",25,"ر",1,0],["فَلَم نَزَل لَيلَنا نُسقى مُشَعشَعَةً","كَأَنَّما المَءُ يُغريها بِتَصريمِ",26,"م",1,0],["فَلَم نَزَل في صَباحِ السَبتِ نَأخُذُها","وَاللَيلُ يَجمَعُنا حَتّى بَدا الأَحَدُ",27,"د",1,0],["فَلَم نَزَل يَومَنا وَلَيلَتَنا","نَقراً عَلى السَطحِ بِالطَنابيرِ",28,"ر",1,0],["فَلَم نَزَل نُسقى وَنَلهو بِهِ","وَنَأخُذُ القَصفَ بِآيِينِهِ",29,"ن",2,0],["فَلَم نَزَل نَتَعاطى الكَأسَ مُذهَبَةً","كَأَنَّ طَوقَ جُمانٍ في نَواحيها",30,"ي",3,0],["فَلَم نُوَقِّف مُشيلينَ الرِماحَ وَلَم","نُوجَد عَواويرَ يَومَ الروع عُزّالا",31,"ل",2,0],["فَلَمْ نَأْلُ أَنْ دَارَتْ بِنَا الأَرْضُ دَوْرَةً","وَحَتَّى رَأَيْنَا الأُفْقَ يَنْأَى وَيَقْرُبُ",32,"ب",1,0],["فَلَم نَكُنْ إِلاَّ كِرَاماً ظُلِمُوا","فَاسْتَنْصَفُوا وَلَمْ نَطِش فَنَرْدَى",33,"د",2,0],["فَلَمْ نَذْمُمْ لَهَا عَهْداً وَلكِن","قَضَى عَهْدٌ جَدِيدٌ بِالفِرَاقِ",34,"ق",1,0],["فَلِمَنْ جَاوَرَ أَهْدَتْ نَفْحَةً","وَلِمَنْ طَالَعَ أَسْدَتْ مَنْظَرَا",35,"ر",2,0],["فَلِمَنْ تَوَلَّى رَحْمَةً","في خِلْدِهِ وَلَكَ احْتِسَابْ",36,"ب",1,0],["فَلَمْ نَلْقَ في تَطْوافِنَا والتِمَاسِنَا","فُراتَ بنَ حيَّانٍ يَكُنْ رَهْنَ هَالِكِ",37,"ك",1,0],["فلم نعرف له في الفضلِ قبْلاً","ولم نعرف له في النُبْل بَعْدا",38,"د",2,0],["فلم نكتسبْ من وراءِ الخلافِ","سوى أنَّ عِقْدَ البلادِ انفصَمْ",39,"م",1,0],["فلم نعرف لهم إلا فَطِيرا","من الآراء ليس له اختمار؟",40,"ر",1,0],["فلمن هنا أصغي ؟ وكيف ؟ وما هنا","إلا أنا ، والصمت ، والإطراق",41,"ق",1,0],["فلمن لفتة وفيم إرتقاب ليس","بعد الذي إنتظرت إنتظاراً",42,"ر",2,0],["فَلَم نَأتِ القَبَائِلَ طَالِبِيهِ","وَمن عَلِقتهُ هِمتُهُ أتَانَا",43,"ن",2,0],["فلمن تترك الصحافة فينا","وعلى من يكون فصلُ المقال",44,"ل",1,0],["فلم نحظَ من رِبح الثناءِ بطائلٍ","فرُدُّوا كرأس المال أو بعِضه شِعرا",45,"ر",2,0],["فَلِمَن مَضى زَجرٌ بِأَلسِنَةِ القَنا","مِنهُم وَلِلثاوي مُناخٌ جَعجَعُ",46,"ع",1,0],["فلم نحن الضلوع على سلوٍ","ولم نطو الجفونَ على اغتماض",47,"ض",1,0],["فلم نزلْ نرقبُ بدرَ الدجى","حتى تجلى البدرُ من وجهها",48,"ه",2,0],["فلم نر من فوق أثباجه","سوى الغدر من رمم باليه",49,"ي",2,0],["فَلِمَنكِبٍ وَلِعاتِقٍ وَلِخِنصِرٍ","مِنهُ ثَلاثٌ قَدرُهُنَّ مُعَظَّمُ",50,"م",1,0],["فَلَم نَقتُلهُمُ بِدَمٍ وَلَكن","لِلؤمِهمُ وَهَونِهمُ عَلَينا",51,"ن",2,0],["فَلَم نَكُ نَقصِدُ يَوماً سِواها","وَلَم تَكُ تَعرِفُ يَوماً سِوى ها",52,"ا",3,0],["فَلَم نَزل لابِسي ثَوب العَفاف إِلى","أَن كادَ يظهرُ في فرع الدُجى جَلحُ",53,"ح",1,0],["فلَم نَنزِلْ بشابُر خُواةَ إلاّ","وكلُّ رِكابنا نِضْوٌرَذيّ",54,"ي",1,0],["فلم نَرَ مثْلَه قلماً بكفٍّ","غدا لزمانِ صاحبِه زِماما",55,"م",2,0],["فلم نَدْرِ ماذا منه نَقْضِي تَعجُّباً","سُؤالُ المطايا أم جوابُ الحقائب",56,"ب",1,0],["فلم نقتل شِرارَهُمُ ولكن","قَتَلنا الصالحين ذوي السِّلاحِ",57,"ح",1,0],["فَلِمَن أقولُ وما أقولُ وأينَ بِي","فأسيرَ أو لا أينَ بِي فأُقيما",58,"م",2,0],["فلم نلقَ منكمْ مَا عَهِدناه أوّلا","ولا قلتم أَهلاً وسَهلاً ومَرحبا",59,"ب",2,0],["فلم نرتحل يوماً لنسقي معاهداً","من الدَّار في سلع وفي الدَّار من ظما",60,"م",2,0],["فلم نَرَ في إحسانكم غير شاكر","مليٍّ بما يملي لسان المحامد",61,"د",1,0],["فلم نرَ من صرف الزَّمان محارباً","تنازله الأَرزاء غير مسالم",62,"م",1,0],["فلم نسمَع ولم نبصِر","إلّا هواكَ لي سهلا",63,"ل",2,0],["فلم نلاق أمرا في عصره أبدا","يقول لازمني فقر وحرمان",64,"ن",1,0],["فلمن مثلك الإِجازة تستا","م بنظمِ القريض للأحباب",65,"ب",1,0],["فلم نتخذ غير السماك مُنادِماً","وما راقنا غير الثريّا مُجالِسُ",66,"س",1,0],["فلمن أفاضا الأنس ألوانا","شكرا وشكرا من حنايانا",67,"ن",2,0],["فلم نجدْ غيرَ ابن أيّوب فتىً","ل