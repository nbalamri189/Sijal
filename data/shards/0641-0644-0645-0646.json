iewPoem.aspx?id=30412",""],[5888,"شفاء القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=214503",""],[5937,"خَلْفَ اللثام","https://www.poetsgate.com/ViewPoem.aspx?id=211889",""],[6089,"الجفن المضنّى","https://www.poetsgate.com/ViewPoem.aspx?id=213036",""],[6093,"لقد سالت المآقي","https://www.poetsgate.com/ViewPoem.aspx?id=178383",""],[6142,"أغضض اللحظ عن محبك غمزا","https://www.poetsgate.com/ViewPoem.aspx?id=155732",""],[5957,"الموت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82384&r=&rc=18",""],[6225,"شفيعنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80904&r=&rc=173",""],[6237,"حيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77869&r=&rc=11",""],[6242,"لغة الخلود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87552&r=&rc=0",""],[6251,"أتيتك بالبشر لا بالعزاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76474&r=&rc=14",""]],"verses":[["فلَمْ نَدْرِ إذا أمّتْ بِنا بابَ أحْمَدٍ","أنَحنُ إِلى نادِيهِ أمْ هِيَ أعْجَلُ",0,"ل",1,0],["فلمْ نَرَ منْ قبْلِ اسْتِلامِ يَمينِه","بِحارَ نَوالٍ قِيلَ هُنّ أصابعُ",1,"ع",1,0],["فَلَم نَطلُب لَهُ شُكراً وَلَكِن","نُوَلّي حَمدَ ذَلِكَ مَن يُريدُ",2,"د",1,0],["فَلَم نَزَل وَصُروفُ الدَهرِ تَرمُقُنا","شَزراً وَتَخدَعُنا الدُنيا وَتُلهينا",3,"ن",2,0],["فَلَّ مِنْ غَرْبِ مِصْرَ أَنْ يَتَوَلَّى","خِلُّهَا البَرُّ وَالوَلِيُّ الأَمِينُ",4,"ن",1,0],["فلم ندرِ روضاً منه أنعَمَ نَضْرَةً","وأعطرَ أرجاءً وأحلى مجانيا",5,"ي",2,0],["فلم نَرضَ غير العلم تاجاً لرأسها","ولا غير شَنْف العدل في أذنها شَنفا",6,"ف",2,0],["فَلَم نَزَل نَصيدُها وَنَصرَعُ","حَتّى تَبَقّى في القَطيعِ أَربَعُ",7,"ع",1,0],["فَلَم نَزَل بِالخَيلِ وَالكِلابِ","نَجزُرُها جَزراً إِلى الأَغبابِ",7,"ب",1,0],["فَلَم نَزَل نَقلي وَنَشوي وَنَصُب","حَتّى طَلَبنا صاحِياً فَلَم نُصِب",7,"ب",1,0],["فَلَم نَزَل سَبعَ لَيالٍ عَدَدا","أَسعَدَ مَن راحَ وَأَحظى مَن غَدا",7,"د",2,0],["فَلَم نَدرِ وَقَد فاحَت","لَنا مِن جانِبِ الدارِ",8,"ر",1,0],["فلم نزل في منزل كريم","نروي حديث الرمي عن قديم",9,"م",1,0],["فلم نملك سوابق مُقْرَحَاتٍ","من الأجفان بالدمع السكوبِ",10,"ب",1,0],["فلم نزل من نعيم ليلتنا","باللهو في مثل ليلة العُرس",11,"س",1,0],["فلم نَرَكَ استوحشتَ منها لوحْدَة","ولا جُرْتَ عن قصد لأنك مُعلَمُ",12,"م",1,0],["فلِمَنْ يُسالِمُهُ سلامَتُهُ","ولمن يُحاربُ عطْسَةُ اللَّجَمِ",13,"م",1,0],["فَلَم نَدر وَجُنحُ اللَيلِ داجٍ","أَبَرقاً ما رَكِبنا أَم قِطارا",14,"ر",2,0],["فَلَم نَظفَر بِحاجَتِنا","وَأَشفَينا عَلى العَطَبِ",15,"ب",1,0],["فَلَم نَشعُر بِضَوءِ الصُبحِ حَتّى","سَمِعنا في مَساجِدِنا الأَذينا",16,"ن",2,0],["فَلَم نَرَ خالاً مِثلَ خالِكَ سوقَةً","إِذا اِبتَدَرَ القَومُ الكِرامُ المَساعِيا",17,"ي",2,0],["فلِمَنْ كنتِ تنشدين فقالتْ","للضياءِ البنفسجيِّ الحزينِ",18,"ن",1,0],["فَلِمَن حاوَلَ النَعيمَ نَعيمٌ","وَلِمَن آثَرَ الشَقاءَ شَقاءُ",19,"ا",2,0],["فَلَم نَرَ قَبلَ اِبنِ الحُسَينِ أَصابِعاً","إِذا ما هَطَلنَ اِستَحيَتِ الدِيَمُ الوُطفُ",20,"ف",1,0],["فلم نزلْ تحتَ جُنْحِ الليلِ في عُلَقٍ","من العِناقِ ولم نَهْمُمْ بعدوانِ",21,"ن",1,0],["فَلَم نَأتِها حَتّى لَعَنّا مَكانَها","وَحَتّى اِشتَفى مِن نَومِهِ صاحِبُ الكَرى",22,"ا",1,0],["فلم نُظْهِرْ له إلا قِراعاً","ولم نَلْبَسْ له إلا وَقارا",23,"ر",2,0],["فلِمَن أصونُ مَدامعي من بعدِه","ولأيِّما أبكيهِ من أسبابِه",24,"ب",2,0],["فلمن لفتةٌ وفيم ارتقاب","ليس بعد الذي انتظرت انتظار",25,"ر",1,0],["فَلَم نَزَل لَيلَنا نُسقى مُشَعشَعَةً","كَأَنَّما المَءُ يُغريها بِتَصريمِ",26,"م",1,0],["فَلَم نَزَل في صَباحِ السَبتِ نَأخُذُها","وَاللَيلُ يَجمَعُنا حَتّى بَدا الأَحَدُ",27,"د",1,0],["فَلَم نَزَل يَومَنا وَلَيلَتَنا","نَقراً عَلى السَطحِ بِالطَنابيرِ",28,"ر",1,0],["فَلَم نَزَل نُسقى وَنَلهو بِهِ","وَنَأخُذُ القَصفَ بِآيِينِهِ",29,"ن",2,0],["فَلَم نَزَل نَتَعاطى الكَأسَ مُذهَبَةً","كَأَنَّ طَوقَ جُمانٍ في نَواحيها",30,"ي",3,0],["فَلَم نُوَقِّف مُشيلينَ الرِماحَ وَلَم","نُوجَد عَواويرَ يَومَ الروع عُزّالا",31,"ل",2,0],["فَلَمْ نَأْلُ أَنْ دَارَتْ بِنَا الأَرْضُ دَوْرَةً","وَحَتَّى رَأَيْنَا الأُفْقَ يَنْأَى وَيَقْرُبُ",32,"ب",1,0],["فَلَم نَكُنْ إِلاَّ كِرَاماً ظُلِمُوا","فَاسْتَنْصَفُوا وَلَمْ نَطِش فَنَرْدَى",33,"د",2,0],["فَلَمْ نَذْمُمْ لَهَا عَهْداً وَلكِن","قَضَى عَهْدٌ جَدِيدٌ بِالفِرَاقِ",34,"ق",1,0],["فَلِمَنْ جَاوَرَ أَهْدَتْ نَفْحَةً","وَلِمَنْ طَالَعَ أَسْدَتْ مَنْظَرَا",35,"ر",2,0],["فَلِمَنْ تَوَلَّى رَحْمَةً","في خِلْدِهِ وَلَكَ احْتِسَابْ",36,"ب",1,0],["فَلَمْ نَلْقَ في تَطْوافِنَا والتِمَاسِنَا","فُراتَ بنَ حيَّانٍ يَكُنْ رَهْنَ هَالِكِ",37,"ك",1,0],["فلم نعرف له في الفضلِ قبْلاً","ولم نعرف له في النُبْل بَعْدا",38,"د",2,0],["فلم نكتسبْ من وراءِ الخلافِ","سوى أنَّ عِقْدَ البلادِ انفصَمْ",39,"م",1,0],["فلم نعرف لهم إلا فَطِيرا","من الآراء ليس له اختمار؟",40,"ر",1,0],["فلمن هنا أصغي ؟ وكيف ؟ وما هنا","إلا أنا ، والصمت ، والإطراق",41,"ق",1,0],["فلمن لفتة وفيم إرتقاب ليس","بعد الذي إنتظرت إنتظاراً",42,"ر",2,0],["فَلَم نَأتِ القَبَائِلَ طَالِبِيهِ","وَمن عَلِقتهُ هِمتُهُ أتَانَا",43,"ن",2,0],["فلمن تترك الصحافة فينا","وعلى من يكون فصلُ المقال",44,"ل",1,0],["فلم نحظَ من رِبح الثناءِ بطائلٍ","فرُدُّوا كرأس المال أو بعِضه شِعرا",45,"ر",2,0],["فَلِمَن مَضى زَجرٌ بِأَلسِنَةِ القَنا","مِنهُم وَلِلثاوي مُناخٌ جَعجَعُ",46,"ع",1,0],["فلم نحن الضلوع على سلوٍ","ولم نطو الجفونَ على اغتماض",47,"ض",1,0],["فلم نزلْ نرقبُ بدرَ الدجى","حتى تجلى البدرُ من وجهها",48,"ه",2,0],["فلم نر من فوق أثباجه","سوى الغدر من رمم باليه",49,"ي",2,0],["فَلِمَنكِبٍ وَلِعاتِقٍ وَلِخِنصِرٍ","مِنهُ ثَلاثٌ قَدرُهُنَّ مُعَظَّمُ",50,"م",1,0],["فَلَم نَقتُلهُمُ بِدَمٍ وَلَكن","لِلؤمِهمُ وَهَونِهمُ عَلَينا",51,"ن",2,0],["فَلَم نَكُ نَقصِدُ يَوماً سِواها","وَلَم تَكُ تَعرِفُ يَوماً سِوى ها",52,"ا",3,0],["فَلَم نَزل لابِسي ثَوب العَفاف إِلى","أَن كادَ يظهرُ في فرع الدُجى جَلحُ",53,"ح",1,0],["فلَم نَنزِلْ بشابُر خُواةَ إلاّ","وكلُّ رِكابنا نِضْوٌرَذيّ",54,"ي",1,0],["فلم نَرَ مثْلَه قلماً بكفٍّ","غدا لزمانِ صاحبِه زِماما",55,"م",2,0],["فلم نَدْرِ ماذا منه نَقْضِي تَعجُّباً","سُؤالُ المطايا أم جوابُ الحقائب",56,"ب",1,0],["فلم نقتل شِرارَهُمُ ولكن","قَتَلنا الصالحين ذوي السِّلاحِ",57,"ح",1,0],["فَلِمَن أقولُ وما أقولُ وأينَ بِي","فأسيرَ أو لا أينَ بِي فأُقيما",58,"م",2,0],["فلم نلقَ منكمْ مَا عَهِدناه أوّلا","ولا قلتم أَهلاً وسَهلاً ومَرحبا",59,"ب",2,0],["فلم ن