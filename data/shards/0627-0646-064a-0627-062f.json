{"poems":[[93,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[72,"يا سيدا لي حيث كنت","https://www.aldiwan.net/poem42883.html","مجزوء الكامل"],[72,"يا صاحبي فيما ينو","https://www.aldiwan.net/poem43034.html","مجزوء الكامل"],[91,"الشمس قد طلعت بوجه اروع","https://www.aldiwan.net/poem44622.html","الكامل"],[136,"أني على هيمى مى تلحاني","https://www.aldiwan.net/poem54712.html","البسيط"],[193,"أنا في حمى عائذ","https://www.aldiwan.net/poem35165.html","مجزوء الكامل"],[369,"من حكم طرفي إذ يكون مريبا","https://www.aldiwan.net/poem60989.html","الكامل"],[440,"عيناك أمكنت الشيطان من خلدي","https://www.aldiwan.net/poem25312.html","البسيط"],[440,"عيناك أمكنت الشيطان من خلدي","https://www.aldiwan.net/poem25674.html","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66813","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77623","الرجز"],[1042,"","https://poetry.dctabudhabi.ae/diwan/poem/204376","الكامل"],[2620,"","https://poetry.dctabudhabi.ae/diwan/poem/34983","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131276",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135273","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135743","الرجز"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136938",""],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33213","الكامل"],[5561,"قارورة عطر","https://www.poetsgate.com/ViewPoem.aspx?id=192898",""],[5688,"ما بال قلبك","https://www.poetsgate.com/ViewPoem.aspx?id=200961",""],[5956,"خالٍ من الحاجات","https://www.poetsgate.com/ViewPoem.aspx?id=184466",""],[5956,"أرنو لطيفكِ","https://www.poetsgate.com/ViewPoem.aspx?id=192722",""],[6102,"الشهيد ..","https://www.poetsgate.com/ViewPoem.aspx?id=182893",""]],"verses":[["أَنّى أَدَرتُ الطَرفَ في","ها جالَ في قَمَرٍ مُنيرِ",0,"ر",1,0],["إِنّي أَدِلُّ لِأَنّني","ضَيفٌ وَمَملوكٌ وَجارُ",1,"ر",1,0],["إِنّي اِدَّخَرتُكَ لِلزَما","نِ وَما عَرا مِن كُلِّ خَطبِ",2,"ب",1,0],["اني ادين بحسنها لا كالذي","املى عليه جهله ان لا يعي",3,"ع",2,0],["إني ادَّكَرتُ لَيَالِىَ اغتَبَقتُ بِها","صَفوَ التَّصَابي بِرَغمِ الكَاشِحِ الشَّآني",4,"ن",2,0],["إنّي أدينُ بحبّهم","وَلضدّهم أَبداً أنابِذ",5,"ذ",1,0],["إني أُدِلُّ على عُلاك بهمّةٍ","بلَغَتْ بوُدِّك مَطْمَحاً مَطْلوبا",6,"ب",2,0],["إنِّي أدِينُ بِدِينش الحُبِّ وَيحَكُمُ","وَاللهُ قَد قَالَ لاَ إكرَاهَ فِي الدِّينِ",7,"ن",1,0],["إِنّي أَدينُ بِدِين الحُبّ وَيَحَكُمُ","وَاللَهُ قَد قالَ لا إِكراهَ في الدين",8,"ن",1,0],["إنّي أدينُ بما دان الوصيُّ به","يوم الخُريْبةَ من قَتلِ المُحلِّينا",9,"ن",2,0],["إِنيَ أَدري أَلفَ أَلف حيلَه","وَكُلُّها حَميدةٌ جَميلَه",10,"ه",1,0],["أني أدل على دمشق وطيبها","من حسن وصفي بالدليل القاطع",11,"ع",1,1],["إِنّي أَدينُ بِما دانَ الشَراةُ بِهِ","يَومَ النَخيلَةِ عِندَ الجَوسَقِ الخَرِبِ",12,"ب",1,1],["اني ادرت الطرف يبدو له","جيشان قد ضمهما مأزق",13,"ق",1,0],["إني أدعوكَ دعاءً لأرى","يا ربَّنا عطاءكَ المكثّرا",14,"ر",2,1],["إنيَ أدعوكَ دعاء ذي اضطرارْ","ولا له أمرٌ ولا له اختيارْ",15,"ر",1,0],["أنيَّ ادير الطرف يؤلمني","أن المنازل بعدهُ قفر",16,"ر",1,0],["إني أدين بطول حبكَ خالقي","يا غايتي وتدينه ببعاد",17,"د",1,0],["إنّي أدمنتُ مسالكَه","فوجدتُكِ نورا أبصره",18,"ر",2,0],["إنّي أدافع عن نفسي وعن خلُقي","بما ملكْتُ ولو رجما بقرطاس",19,"س",1,0],["إني أدرس أمتي معنى العُلا","ما كُنتُ يوماً بالجهالة أفخَرُ",20,"ر",1,0],["إني أدين إليك فيما أقتني","من أي مَكْرُمة وأيِّ علاءِ",21,"ا",2,0],["إِنِّي ادَّكَرتُكَ وَ الأبطالُ تُدَّكَرُ","فَاهتَزَّ شِعرِيَ تَجلُو هَمَّهُ العِبَرُ",22,"ر",1,1]]}