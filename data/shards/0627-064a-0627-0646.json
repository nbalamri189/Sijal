.php?name=Sh3er&doWhat=shqas&qid=65508&r=&rc=7",""]],"verses":[["أَيا نَفسَ مَن نَفسي إِليهِ مَشوقَةٌ","وَمَن قَد بَرى جِسمي هَواهُ وَما شَعَر",0,"ر",1,1],["أَيُّ انْشِرَاحٍ لِلصَّدْرِ فِي نَقْلٍ","بَيْنَ الرُّبَى وَالنُّجُوعِ وَالأَجَمِ",1,"م",1,0],["أَيَا نَخلَتَي وادي بُوانَةَ حَبَّذا","إِذَا نَام حُرَّاسُ النَخيلِ جَنَاكُمَا",2,"م",2,1],["أيَّانَ ما لعبت بها أيدي النوى","وتراهنت في الحل والتَّرْحالِ",3,"ل",1,0],["أَيا نيلُ نَبِّئني أَحاديثَ مَن مَضَوا","لَعَلَّ شِفاءَ النَفسِ ما أَنتَ ذاكِرُه",4,"ر",2,0],["أَيا نيلُ فَاِمنَحني عَلى الحَقِّ قُوَّةً","فَما سَوَّدَ الضِرغامُ إِلّا أَظافِرُه",4,"ر",2,0],["أَيا نورَ العُيونِ بَعُدَت عَنّا","وَلَمّا تَمَتَلِئ مِنكَ العُيونُ",5,"ن",1,0],["أَيا نَفسُ لا تَجزَعي وَاِصبِري","فَإِنَّ الهَوى ما بِهِ مُنصفُ",6,"ف",1,1],["أَيا ناشِدِ الإِحسانِ أَقوَت نُجودُهُ","وَيا ناشِدَ الإِسلامِ أَقوَت تَهائِمُه",7,"م",2,0],["أَيا نَفسُ ما الدُنيا بِأَهلٍ لِحَيِّها","دَعيها لِأَقوامٍ عَلَيها تَعادَتِ",8,"ت",1,0],["أَيا نَفسُ أَنتِ الدَهرُ في حالِ غَفلَةٍ","وَلَيسَت صُروفُ الدَهرِ غافِلَةً عَنكَ",9,"ك",1,0],["أَيا نَفسُ كَم لي مِنكِ مِن يومِ صَرعَةٍ","إِلى اللَهِ أَشكو ما أُعالِجُهُ مِنكَ",9,"ك",1,0],["أَيا نَفسُ إِن لَم أَبكِ مِمّا أَخافُهُ","عَلَيكَ غَداً يَومَ الحِسابِ فَمَن يَبكي",9,"ك",2,0],["أَيا نَفسُ هَذي الدارُ لا دارُ قُلعَةٍ","فَلاتَجعَلِنَّ القَصدَ إِلّا إِلى تِلكَ",9,"ك",1,0],["أَيا نَفسُ لا تَنسي عَنِ اللَهِ فَضلَهُ","فَتَأيِيدُهُ مُلكي وَخِذلانُهُ هُلكي",9,"ك",2,0],["أَيا نَفسُ لا تَستَوطِني دارَ قُلعَةٍ","وَلَكِن خُذي في الزادِ قَبلَ ارتِحالِكِ",10,"ك",1,0],["أَيا نَفسُ لا تَنسي كِتابَكِ وَاذكُري","لَكِ الوَيلُ إِن أُعطيتِهِ بِشِمالِكِ",10,"ك",1,0],["أَيا نَفسُ إِنَّ اليَومَ يَومُ تَفَرُّغٍ","فَدونَكِهِ مِن قَبلِ يَومِ اشتِغالِكِ",10,"ك",1,0],["أَيا نَفسُ مَهما لَم يَدُم فَذَريهِ","وَلِلمَوتِ رَأيٌ فيكِ فَاِنتَظِريهِ",11,"ي",2,1],["أَيا ناصِرَ الدينِ يا اِبنَ الَّذي","بِهِ أَصبَحَ المُلكُ في مَعقِلِ",12,"ل",1,0],["أَيا ناعِيَي لَيلى بِجانِبِ هَضبَةٍ","أَما كانَ يَنعاها إِلَيَّ سِواكُما",13,"م",2,1],["أَيّانَ أُنضى وَرَفِيقَينِ لي","يُعاوِرانِ الوَجدَ أَحيانا",14,"ن",2,0],["أَيا نَفسِ قَد أَثقَلتِني بِذُنوبِ","أَيا نَفسِ كُفِّ عَن هَواكِ وَتوبي",15,"ي",1,1],["أَيا نَفسِ لا تَعظُم عَلَيكِ خُطوبُها","فَمُتَفِقوها مِثلُ مُختَلِفيها",16,"ي",3,0],["أيا نارُ كفاي أثلجُ منه","فهلاَّ بعثتِ بدفءِ الحريقِ",17,"ق",1,0],["أَيَا نَاشِدَ الحُسْنِ فِي كُلِّ فَنٍّ","رَصِينِ المَعَانِي مَكِينِ البِنَاءْ",18,"ا",2,0],["أَيُّ أُنْسٍ فِي كُلٍّ نَفْسٍ إِذَا","خَالَطَهَا كَانَ فِعْلُهُ خَلاَّبَا",19,"ب",2,0],["أَيا نَفسُ، لا تَجزَعي، وَاصبِري","وإلّا فإِنَّ الهَوى مُتلِفُ",20,"ف",1,1],["أيُّ أنشودةِ خزيٍ غصَّ في","بثّها بينَ الأسى والكربِ",21,"ب",1,0],["أيا نور العيون بعدت عنّا","ولمّا تمتليء منك العيون",22,"ن",1,0],["أيَا نائياً بَرِّدْ حشاى بنظرةٍ","فإني بأدنى نظرةٍ منك أَقْنَعُ",23,"ع",1,0],["أيا نَجمَةً سَطَعَت في الظَلام","أنِيري طريقَ فتىً لا يَنام",24,"م",1,1],["أيا نَجمَةً في أعالي السَماءِ","أَطَلتِ السُكوتَ فهل من كلام",24,"م",1,0],["أيا نفس إن الأمر غيبٌ فما تدري","بماذا يكون الكشف في آخر العمر",25,"ر",1,1],["أَيا نَفسُ صَبراً لِلبَلايا فَرُبَّما","أَتى فَرَجٌ لِلمَرءِ وَالمَرءُ غافِلُ",26,"ل",1,0],["أَيُّ أنس وافى لِمصرَ وقد وا","فى لها فَخرُها وَأيُّ صفاء",27,"ا",2,0],["أَيا نازِلينَ الحِمى هَل يَعودُ","لَنا بَعدَ وَقعِ الشتاتِ التِئام",28,"م",1,0],["أَيا نازِحاً وَجدي بِه غَيرُ نازِحٍ","يَجدُّ بِقَلبي حُبُّهُ وَهوَ يَلعَبُ",29,"ب",1,0],["أيا نفسُ أنتِ السرُّ والسرُّ غامضٌ","كخطِّ كتابٍ فوقَهُ اندَلقَ النقس",30,"س",1,0],["أيا نجمة في قربها القلبُ طامعُ","ضِياؤك وَعدٌ للمحبين جامعُ",31,"ع",1,1],["أَيا نسمات الريح من طيب طيبة","أعيدي لروحي روح ند ومندل",32,"ل",1,0],["أَيا ناهِضَ الْمُلْكِ أَيُّ الثَّناءِ","يَقُومُ بِشُكْرِكَ أَوْ يَنْهَضُ",33,"ض",1,1],["أَيا نازِلاً حَيْثُ يَبْلى الْجَديدُ","وَيَذْوِي أَخُو الْبَهْجةِ الْواضِحُ",34,"ح",1,0],["أيا نور عيني صرت في ظلمة اللحد","وبالغت مع قرب المنازل في البعد",35,"د",1,1],["أَيا نازِحاً أَفنى نَواظِرَنا نَزحا","وَيا بارِحاً أَفنى خَواطِرَنا بَرحا",36,"ح",2,1],["أَيُّ اِنحِطامٍ أَنَّ بَي","تَ العِزِّ يُمسي في الحُطامِ",37,"م",1,0],["أَيا نَجيباً لَم تَنبِهِ نُجُبٌ","وَلا تَخَطّى سَنامَهُ قَتَبُ",38,"ب",1,0],["أَيا نِعمَةً حَلَّت وَوَلَّت وَلَم أَكُن","نهَضتُ بِما لِلَّهِ فيها مِنَ الشُكرِ",39,"ر",1,0],["أيَا نَازِحاً لم أحتَسِبْ بُعدَ دَارِهِ","وقَد كان لو نِلتُ المُنَى قُرْبُه حَسبْي",40,"ب",2,1],["أَيَأْنَفُ أَنْ يُقَلِّدَنِي جَميلاً","فَيَغْدو وقد تَقَلَّدَنِي جَمَالا",41,"ل",2,0],["أيا نجمَ عوفٍ يا مفرِّج كربِها","أما آن لي أن يَخجلَ المطلُ من صبري",42,"ر",2,0],["أيانِقُ تقطعُ عَرْضَ الفلا","صَوادٍ إلى الأمدِ الأبعدِ",43,"د",1,0],["أي أن أمري وشاني","اليك بعده يصمد",44,"د",1,0],["أيان وقفت على الرمم","حققت رجوعك للعدم",45,"م",1,1],["أيا ناقةً بلّغتِنيه محرّم","عليك السرى لا بل على ظهركِ الرحل",46,"ل",1,0],["أَيا نَفسُ رِفقاً في الوَغى وَمَسَرَّةً","فما كَأسُها إِلّا مِنَ السُمِّ يُنقَعُ",47,"ع",1,0],["أيانَ ولَّى منكمو","أبصر وجهاً حسنا",48,"ن",2,0],["أيان تقصده تجد","منه تمد موائد",49,"د",1,0],["أَيَا نِشْوَانُ مِنْ خَمْرٍ بِفِيْهِ","مَتَى تَصْحُو وَرِيْقُكَ خَنْدَرِيْسُ",50,"س",1,1],["أَيا ناصِرَ الدِّينِ الَّذي بسيوفِه","لذا الدِّينِ إِعْزَارٌ وللكفرِ إِذْلاَل",51,"ل",1,0],["أَيا نعمةً من بعدِ أَنْ نالنا الأَذَى","ويا رحمةً من بعدِ أَنْ مَسَّنا الضُّرُّ",52,"ر",1,0],["أيا ناصر الدِّينِ لم أنتَصر","بغيرك مِن زَمنٍ ظالم",53,"م",1,1],["أيَّ أُنسٍ أيَّ صبرٍ أَلوفِ","يَرْتَجي مثلي بعد موت الخروفِ",54,"ف",1,1],["أيا نائما في ظلال الصفا","أفق حذرا من صروف المدى",55,"ا",1,1],["ايا نفس صبراً عسى الله أن","يقدر لي عن قريب فرج",56,"ج",1,0],["أَيَا ناصرَ الإيمان إنْ غبتَ في الثرى","فذكرُك في طيِّ الضمائر نازل",57,"ل",1,0],["أيا نبأَ أتى من خير أُسره","لقد أطلقت من ذا القلب أَسره",58,"ر",2,1],["أي أُنس أرتجيه بعد ما","غاب عني الأنسُ طرًّا في غيابك",59,"ك",1,1],["أَيا ناظِرَ الإِسلامِ شِم بارِقَ المُنى","وَباكِر لِرَوضٍ في ذُرى المَجدِ فَينانِ",60,"ن",1,0],["أيا نَخلَةً في رِياضِ البَها","يُكلِلُها اللُطف لَيسَ النَدا",61,"د",2,0],["أيا نازحا عني ومسكنه الحشا","اجب من ملا كل النواحي نداؤه",62,"ا",3,0],["أيا نجل عبد الله يا جامع التقى","مع الفضل يا بحر الندى والكرمات",63,"ت",1,0],["أَيا ناقِصاً يَدّعي أَنَّه","كَريمُ ال