"المجتث"],[469,"يا من هو الأم لنا والأب","https://www.aldiwan.net/poem60460.html","السريع"],[478,"أما الشباب فشيء عز مطلبه","https://www.aldiwan.net/poem15274.html","البسيط"],[480,"جنحت للغروب شمس الأصيل","https://www.aldiwan.net/poem37184.html","الخفيف"],[480,"يا علوة ما كان ظني أن أجزى","https://www.aldiwan.net/poem37875.html","الطويل"],[483,"تبدت معاني الجمع حشو ردائها","https://www.aldiwan.net/poem24496.html","عموديه"],[483,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[496,"كذا من شام بارقة العذاب","https://www.aldiwan.net/poem9765.html","الوافر"],[496,"ما كان ليلي ليلا","https://www.aldiwan.net/poem9881.html","المجتث"],[496,"أنعت جهما لم أجد فيما مضى","https://www.aldiwan.net/poem10223.html","الرجز"],[501,"آمنت بالله الوجود كله","https://www.aldiwan.net/poem37823.html","الرجز"],[501,"وآيات ألواح رقمن مع العما","https://www.aldiwan.net/poem37957.html","الطويل"],[501,"رفرف غصن البان لا بمرق","https://www.aldiwan.net/poem37963.html","الرجز"],[501,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[501,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[515,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[530,"ردوا فؤادي ما يعيش الفتى","https://www.aldiwan.net/poem37281.html","السريع"],[552,"قد مضى شهر الصيام","https://www.aldiwan.net/poem47208.html","مجزوء الرمل"],[552,"أما ترى الرزء الذي أقبلا","https://www.aldiwan.net/poem47307.html","السريع"],[554,"خليلي لست أرى الحب عارا","https://www.aldiwan.net/poem68409.html","المتقارب"],[559,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[559,"صح قولي إن السماع دواء","https://www.aldiwan.net/poem33528.html","الخفيف"],[559,"ومن شدة القرب مني","https://www.aldiwan.net/poem33786.html","المجتث"],[559,"أزال عن الوجه الجميل قناعه","https://www.aldiwan.net/poem34366.html","الطويل"],[559,"قد فاض نور الإله فيضا","https://www.aldiwan.net/poem34412.html","مخلع البسيط"],[559,"أنا كل الوجود والكائنات","https://www.aldiwan.net/poem34732.html","الخفيف"],[559,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[559,"بلاء الأنبياء هو البلاء","https://www.aldiwan.net/poem35089.html","الوافر"],[568,"سارية بين الدياجي السود","https://www.aldiwan.net/poem69731.html","الرجز"],[576,"أكلت طعاما طالما قد عرضته","https://www.aldiwan.net/poem2822.html","الطويل"],[576,"يا ليلة مرت لنا حلوه","https://www.aldiwan.net/poem2949.html","السريع"],[576,"يا طرف من فتن الأنام بفتنة","https://www.aldiwan.net/poem3002.html","الكامل"],[576,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[576,"قد عجز المملوك عن خدمة","https://www.aldiwan.net/poem3055.html","السريع"],[576,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"],[576,"يا ليلة الوصل بل يا ليلة العمر","https://www.aldiwan.net/poem3063.html","البسيط"],[576,"أمورد يا ناظري أم وريد","https://www.aldiwan.net/poem3088.html","الرجز"],[588,"أرى كل ما قد قدر الله يكتب","https://www.aldiwan.net/poem11510.html","عموديه"],[588,"ألا مال نيران الأسى تتضرم","https://www.aldiwan.net/poem11519.html","عموديه"]],"verses":[["وَصِرتُ أُعَدِّدُ في ذا الزَمان","صَديقِيَ أَوَّلَ أَعدائِيَه",0,"ي",2,0],["وَصِرتُ أَرى أَنَّ الشُجونَ عَلاقَةٌ","تَليقُ بِقَلبِ العاجِزِ المُتَواني",1,"ن",2,0],["وَصَرَّحَ كُلُّ قَولٍ عَن","غُرورِ الحِلفِ وَالقَسَمِ",2,"م",1,0],["وَصِرتُ أَهوَنَ عِندَ الحَيِّ بَعدَهُمُ","مِمّا عَلى الإِبِلِ الجَربا مِنَ العَبَسِ",3,"س",1,0],["وَصَريعاً عالَجَ المَوتَ بِلا","شَدَّ لَحيَينِ وَلا مَدَّ رِدا",4,"ا",1,0],["وَصِرتُ فَرداً مِن خَليلي الَّذي","كانَت بِهِ تورِقُ أَغصاني",5,"ن",2,0],["وَصِرنا حَديثاً لِمَن بَعدَنا","تُحَدِّثُ عَنّا القُرونُ القُرونا",6,"ن",2,0],["وَصِرنا فَريقَينِ في مَجمَعٍ","فَأَحسِن بِهِنَّ قَريناً قَرينا",7,"ن",2,0],["وَصِرتُ إِذا اِنتَهى مِنّي كِتابٌ","إِلَيكِ لِتَعطِفي نُبِذَ الكِتابُ",8,"ب",1,0],["وَصِرتُ مِنَ الدُنيا إِلى قَعرِ حُفرَةٍ","حَليفَ صَفيحٍ مُطبَقٍ وَكَثيبِ",9,"ب",1,0],["وَصَريرُ أَقلامي عَلى صَفَحاتِها","أَحلى مِنَ الدَوكاءِ وَالعُشّاقِ",10,"ق",1,0],["وصِرْتَ والدّينُ ضاحٍ في جَواهرِها","ظِلالَ أمْنٍ وسَلْمٍ أمّنَ السُبُلا",11,"ل",2,0],["وَصَرماءَ مِذكارٍ كَأَنَّ دَوِيَّها","بُعَيدَ جَنانِ اللَيلِ مِما يُخَيَّلُ",12,"ل",1,0],["وَصَرعَةُ الغَمِّ أَدهى","مِن صَرعَةِ الخَندَريسِ",13,"س",1,0],["وَصِرنا إِلى الحُسنى وَرَقَّ كَلامُن","وَرُضتُ فَذَلَّت صَعبَةٌ أَيَّ إِذلالِ",14,"ل",1,0],["وَصِرتُ عَمَّ الفَتاةِ تَتئِبُ ال","كَاعِبُ من رُؤيتي وأتَئِبُ",15,"ب",1,0],["وَصِرنا نَرى أَنَّ المُتارِكَ مُحسِنٌ","وَأَنَّ صَديقاً لايُضِرُّ خَليلُ",16,"ل",1,0],["وَصِرتُ إِذا مارُمتُ في الخَيرِ لَذَّةً","تَتَبَّعتُها بَينَ الهُمومُ تَتَبُّعا",17,"ع",2,0],["وَصِرمٍ مِنَ الأَحياءِ عَمروُ بنُ مالِكٍ","إِذا ما غَدَوا كانَت لَهُم عِزَّةُ النَصرِ",18,"ر",1,0],["وصرف لأرواح البريَّة ناقدٌ","على أنه في أخذ نقديه مجمع",19,"ع",1,0],["وصرفوا الرأي في عدلٍ ومعرفةٍ","حتَّى بكلِّ طرير السنِّ معتدل",20,"ل",1,0],["وصريعٍ تحت السنابك ينجو","برِماقٍ ولات حين نجاءِ",21,"ا",2,0],["وصرفُ الدهرِ يسلك في مدارٍ","يُجيلُ خطوبه فيها مُجيل",22,"ل",1,0],["وَصُرّادُ غَيمٍ لا يَزالُ كَأَنَّهُ","مُلاءٌ بِأَشرافِ الجِبالِ مَكورُ",23,"ر",1,0],["وَصَرَّحَ المَوتُ عَن غُلبٍ كَأَنَّهُم","جُربٌ يُدافِعُها الساقي مَنازيحُ",24,"ح",1,0],["وَصِرتُ لا يَنطَوي صَباحٌ","إِلّا بِأَمري وَلا مَساء",25,"ا",2,0],["وَصُرتُ وَحدي وَلَيسَ لي","أَرَبٌ في التَوَحُّدِ",26,"د",1,0],["وَصِرتُ لا يُطريني مُنشِدٌ","وَلا أَنا أَصبو إِلى مُنشِدِ",27,"د",1,0],["وَصُرنا عَلى الدُنيا عِيالا وَطالَما","تَعَلَّمَ مِنّا أَهلُها البَذل وَالرَفدا",28,"د",2,0],["وَصُرتُ وَقداً لَكِ أَو خاتِماً","في جيدِكِ الناصِعِ أَو إِصبَعِك",29,"ك",1,0],["وَصُرتُ أَرى بُغضاً وَصُرتُ أَرى هَوىً","وَصُرتُ أَرى عَبداً وَصُرتُ أَرى مَولى",30,"ل",2,0],["وَصِرتُ كَالجَدوَلِ في فَدفَدٍ","أَو شاعِرٍ ما بَينَ أَصنامِ",31,"م",1,0],["وَصَرَخَ الأَبلَهُ مُستَفسِراً","ما القَصدُ مِن خَلقي كَذا وَالمُراد",31,"د",1,0],["وَصِرتُ أَجمَعُ شَملي","بِسالِفٍ وَسُلافِ",32,"ف",1,0],["وَصِرتُ فيها فَقيراً","مِن ثَروَتي وَعَفافي",32,"ف",2,0],["وَصَريعاً مِنَ الثُمامِ تَرى","عارِماتِ المَدَبِّ في أَسَلِه",33,"ل",2,0],["وصرت على حكم الذين تحرّزوا","من العلم يا هذا إلى ما ترانيا",34,"ي",2,0],["وصرفنا ثلاثة وبما يبق","قى نرجِّى قضاء دين ثقيل",35,"ل",1,0],["وَصَرّف الأَيّامَ حَتّى أَحدَثَت","ما كانَ في الأَحلامِ أَحلامَ الكَرى",36,"ا",1,0],["وَصَرَّفَ قُطعانَهُ فَاِستَبَدّ","وَلَم يَخشَ شَيئاً وَلَم يَرهَبِ",37,"ب",1,0],["وَصِرتُ أَشُكُّ فيمَن أَصطَفيهِ","لِعِلمي أَنَّهُ بَعضُ الأَنامِ",38,"م",1,0],["وصَرامةٌ لو أنّ أيسرَهَا","للسيف لم يُثلَمْ له غرْبُ",39,"ب",1,0],["وَصَرفٍ بَينَ صَرفَي كُلِّ دَهرٍ","زِياداتُ الخُطوبِ عَلى الخُطوبِ",40,"ب",1,0],["وصَرْفُ الدَّهْرِ عنَّا ب","أبي العبَّاسِ مَصروفُ",41,"ف",1,0],["وَصُروفُ الدَهرِ في أَطباقِهِ","حَلقَةٌ فيها إرتِفاعٌ وَانحِدار",42,"ر",1,0],["وَصِراطٌ مَن يَزُل عَن حَدِّهِ","فَإِلى خِزيٍ طَويلٍ وَنَصَب",43,"ب",1,0],["وَصِرتَ إِلى دارٍ هِيَ الدارُ لا الَّتي","أَقَمتَ بِها حَياً وَأَنتَ نَشيطُ",44,"ط",1,0],["وَصِرتُ مِنَ الهَوى دَنِفاً سَقيماً","صَريعاً كَالصَريعِ مِنَ السُلافَه",45,"ف",2,0],["وَصَرِّفِ الهَمَّ بِصَر","فِ مائِها المُرَوَّقِ",46,"ق",1,0],["وَصِراطٍ لَستَ بالنَّاجي إِذا","وَطِئَتْهُ زلّةٌ من قَدَمَيك",47,"ك",1,0],["وَصَرَمتُ حَبلَكَ إِذ صَرَمتَ لِأَنَّني","أُخبُرتُ أَنَّكَ قَد هَويتَ سِوانا",48,"ن",2,0],["وَصَرَّمتَ حَبلَ الوُدِّ مِن وُدِّكَ الَّذي","حَباكَ بِمَحضِ الوُدِّ قَبلَ التَفَهُّمِ",49,"م",1,0],["وَصَرَمتُم مُشَيَّعاً","وُدُّهُ غَيرُ زائِلِ",50,"ل",1,0],["وَصَرَمتُ فيكِ أَقارِبي وَعواذِلي","وَوَصَلتُ عَمداً فيكِ حَبلَ المُبغِضِ",51,"ض",1,0],["وَصَرَّمَ حَبلَنا ظُلماً","لِبَلغَةِ كاشِحٍ كَذَبا",52,"ب",2,0],["وَصَرَختُ يالَبَني رَحيمٍ صَرخَةً","فَاِلتَفَّتِ الأَنجادُ حَولي عَسكَرا",53,"ر",2,0],["وَصِرتُ بِقَلبٍ عاشَ أَمّا نَهارُهُ","فَحُزنٌ وَأَمّا لَيلُهُ فَأَنينُ",54,"ن",1,0],["وَصَرَخنَ في وَجه العَمي","د وَحقهن لَهُنَ حارس",55,"س",1,0],["وَصَرفُ دَهرٍ لَم أَخَف صَرفَهُ","وَصَرفُ هذا الدَهرِ أَبلانا",56,"ن",2,0],["وَصَريمَةٍ بَعدَ الخِلاجِ قَطَعتُها","بِالحَزمِ إِذ جَعَلَت رَحاهُ تَدورُ",57,"ر",1,0],["وَصَرَ إِذا جاءَنا بِالسَلا","مِ في مَشيِهِ عاجِلَ القَفزَه",58,"ز",2,0],["وصَرَّفَ منه الملكُ ما شاء صارماً","وسهماً وخَطّيّاً ودِرعاً ومِغفرا",59,"ر",2,0],["وَصِرتُ وَالأَمثالُ مَضروبَةٌ","في بَعضِ ما يُؤثَرُ في الشِعرِ",60,"ر",1,0],["وَصَرَمنَ حَبلَكَ بَعدَ أَوَّلِ نَظرَةٍ","وَبِما يَكُنَّ إِلى حَديثِكِ صيدا",61,"د",2,0],["وَصَرورَةٌ في شيمَتَينِ لِأَنَّني","مُذ كُنتُ لَم أَحجُج وَلَم أَتَزَوَّجِ",62,"ج",1,0],["وَصُروفُ الأَيّامِ فَرَّقنَ ما يَج","بي الفَتى في حِياضِهِ وَجَبينا",63,"ن",2,0],["وصراخُ الجرحى إلى العرش يعلو","وجروح المجندلين تفور",64,"ر",1,0],["وَصروح للعلم مرتفعات","قوضتها الأيام إلا قَليلا",65,"ل",2,0],["وصرت لا يطربني منشد","ولا أنا أصبو إلى منشد",66,"د",1,0],["وصَرختَ حين أجنّك الليلُ","مُتمَرِّداً تجتاحُكَ النَّارُ",67,"ر",1,0],["وصريرُ دفّتها وعَزفُ رياحهِ","وخفوقُ قلعٍ أبيضٍ في مائه",68,"ه",1,0],["وصرختُ بالليلِ المودِّعِ باكياً","ويداكَ تمسك بي وأنت مغادري",69,"ر",2,0],["وَصَريرُ الرُمحِ جَهراً","في الوَغى يَومَ الطِعانِ",70,"ن",1,0],["وصَريعٍ مُضَرَّجٍ بِدماءٍ","أَجَزرَتهُ قَنَا الُحرُوبِ النُّسورا",71,"ر",2,0],["وَصِرْتُ إِلى هَوَانٍ بَعْدَ عِزٍّ","فَيَا حُزني وَيَا بئْسَ المَصيرُ",72,"ر",1,0],["وَصَرَّفتني الخُطوبُ حَتّى","غَيَّرنَني مِثلَ يا وَواوِ",73,"و",1,0],["وَصِرنا إِلى الحُسنى وَرَقَّ كَلامُنا","وَرُضتُ فَذَلَّت صَعبَةٌ أَيَّ إِذلالِ",74,"ل",1,0],["وصرتَ مجنوناً بها بعدَما","كنتَ دواءً للمجانين",75,"ن",1,0],["وصراحةً بهرت عيونَ رجالِهم","لمّا بدتْ نُوراً بِلا أسدافِ",76,"ف",1,0],["وصراحةٌ في الرأي بيديه وإن","لم يَرضَ ذو الجبروتِ عن إبدائه",77,"ا",3,0],["وصرح علاك في سراوة يعرب","تبيد الليالي دونه وهو عامر",78,"ر",1,0],["وصرت والدين ضاح في هواجرها","ظلال أمن وسلم أمن السبلا",79,"ل",2,0],["وصريمة ٍ بعد الخلاج قطعتها","بالحَزْمِ أو جَعَلَتْ رَحَاهُ تَدُورُ",80,"ر",1,0],["وصراع إن أطفأ الضعف حربا","شبّ حقد الرماد حربا فحربا",81,"ب",2,0],["وصرمنا حبلك بعد أول نظرة","ٍ وبما يكن إلى حديثك صيدا",82,"د",2,0],["وصريحُ رأيٍ لم يَحِد عن خُطَّةٍ","ليلوذَ من تأويلها بجِدار",83,"ر",1,0],["وصرخة أغيار لإنهاض شعبهم","وإنعاشه تستك منها المسامع",84,"ع",1,0],["وصرمتَ حبلَ الودّ من ودك الذي","حَبَاكَ بِمَحْضِ الوُدِّ، قَبْلَ کلتَّفَهُّم",85,"م",1,0],["وصر كشأني على الرحمن متكلا","فكل شخص له في طوره شان",86,"ن",1,0],["وصرت عشير انذال طغام","ستبصر ما يكون من الطغام",87,"م",1,0],["وصراط عنده قضيت","بسلوك عدة المدد",88,"د",1,0],["وصراط الشهود معنى ومعرا","ج سماوات حضرة الأفضال",89,"ل",1,0],["وصرت لا شيء في الدنيا أسر به","ولا يفزعني دهري بأرزاء",90,"ا",2,0],["وصرت أنكر أيامي وينكرني","صفو اللذاذات من قصف وإصباء",90,"ا",2,0],["وصرت لا الصيف يؤذيني بوقدته","ولا الشتاء بتوكافٍ وإرزام",91,"م",1,0],["وصرت لا أنا من ضراء مبتئسٌ","يوماً ولا أنا بالسراء فرحان",92,"ن",1,0],["وصرت أبصر منه القلب محترقاً","والروح والجسم والفؤاد يحترق",93,"ق",1,0],["وصرفة قالوا بثاني عشرا","فبرايرٍ في أول ليل تُرَى",94,"ر",2,0],["وصرفت العِنَانَ عَنها وَيم","مَتُ دَوياً فاجراً بخيلاً أثيما",95,"م",2,0],["وصرفةُ ثاني عشر فباير انتمى","فعن ثاني عشرَ منه لا تتأخرُ",96,"ر",1,0],["وصِرتُ أحسَبُ مِنكَ الوَصلً مَنقَصةً","فَقُلتُ مَاذَا لِمَه قُلتُ رُوَيدَكَ مَه",97,"م",2,0],["وصرتُ في العالمِ مغرىً به","وألسن العذال لم تَنسني",98,"ن",2,0],["وصرفتَ عنِّى كلَّ نائبةٍ","صرفَ الهموم سلافةُ الخمرِ",99,"ر",1,0],["وصرتُ إذا رأيتُ الظبَى يرنو","كأنّى ناظرٌ ليثاً مُدِلاّ",100,"ل",2,0],["وَصِرتُ إِذا ما قالَةُ الشِعرِ قُلِّبَت","بَضائِعُهُم أُلفيتُ أَنفَسَهُم عِلقا",101,"ق",2,0],["وصرّح بمن تهوى ودعني من الكنى","فلا خير في اللذات من دونها ستر",102,"ر",1,0],["وصرت مليكاً بعد ما كنت سوقة","وساعدني سعد فحصباؤنا درّ",102,"ر",1,0],["وصرَّفت فكراً يقذف الدرَّ بحرُهُ","دراكاً وأقصى فكر غيرك آل",103,"ل",1,0],["وصرت حقل هشيم غربة وأسىً","يجتاحني شرر التحنان والأسف",104,"ف",1,0],["وصرح فيما ضمنا برجوعه","إلى الكفر من غير احتشام ولا ستر",105,"ر",1,0],["وَصَرَّفتُ الحَدِيثَ لَهُنَّ حَتَّى","اُصافِىَ وُدَّهُنَّ عَلَى اقتِدَارِ",106,"ر",1,0],["وصرنا من أذى الصفع","كمثل العمي والعور",107,"ر",1,0],["وصرت مؤرخا عنها وصارت","إلى يوم القيامه كالعلامه",108,"م",2,0],["وصرفت عن وجه الحلال إرادتي","إذ كان حتفي في قليل حرامها",109,"م",3,0],["وصرّحت لي بقول بتّ أكرهه","مضى شبابك فاستاثرت بالكسل",110,"ل",1,0],["وصرفت وجهك عن عيو","ب الناس مشتغلا بشانك",111,"ك",1,0],["وصرت كالوحش