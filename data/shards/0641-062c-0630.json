{"poems":[[228,"رن رن ألو مركز القلب","https://www.aldiwan.net/poem41902.html","المجتث"],[276,"قسمت قلبك في الهوى فتقسما","https://www.aldiwan.net/poem52077.html","الكامل"],[315,"سيدي والظنون فيك جميلة","https://www.aldiwan.net/poem59510.html","الخفيف"],[469,"نضت يد الشرق سيوف الصباح","https://www.aldiwan.net/poem3576.html","عموديه"],[563,"يا عقل كم منك قلة الأدب","https://www.aldiwan.net/poem34932.html","المنسرح"],[747,"","https://poetry.dctabudhabi.ae/diwan/poem/143275","الوافر"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67024","البسيط"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67987","الطويل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45996","الطويل"],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5411,"( وتَأبَى شُموسُكَ )","https://www.poetsgate.com/ViewPoem.aspx?id=186720",""],[5725,"شيخ المتظاهرين","https://www.poetsgate.com/ViewPoem.aspx?id=198883",""],[5829,"وليس لعاشق عنها حياد","https://www.poetsgate.com/ViewPoem.aspx?id=204665",""],[5956,"الشعب والأرض","https://www.poetsgate.com/ViewPoem.aspx?id=192332",""],[6213,"ما أحيلاه العناق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76271&r=&rc=28",""]],"verses":[["فَجذوةُ الشِعرِ دوماً","تَعيشُ في الموجوعِ",0,"ع",1,0],["فجذبتما بسلاسل الانوار في","سبق العناية فاِفعَلا ما شئتما",1,"م",2,0],["فجذبتم بضبعه وأنلتم","كل ما شاءت العلا أن تنيله",2,"ل",2,0],["فجذوةُ الوجد لبرد اللّمى","وقوَّةُ الشوق لضعف الوشاح",3,"ح",1,0],["فجذوة النار يستحيل بأن","تكون في الماء رح بلا تعب",4,"ب",1,0],["فجَذَّ اللهُ دابِرهُم فما هُم","سوى غيظِ الأُداني والأقاصي",5,"ص",2,0],["فَجّذْرُ أَوَّلِهِ رُبْعٌ لآخِرِهِ","وجَذْرُ آخِرِهِ رُبْعٌ لِثَانِيْهِ",6,"ي",2,0],["فَجَذَّهُم بِالسَيفِ أَردَشيرُ","ثُمَّ اِبنُهُ مِن بَعدِهِ سابورُ",7,"ر",1,0],["فجَذَّت صروفُ الدهرِ حيناً بمِقْوَدي","عَلَى أنني فِي الحرب شهمٌ غَشَمْشم",8,"م",1,0],["فَجَذرُ الجَميعِ أَربَعونَ بِأَسرِها","وَذلِكَ رُبعُ العُشرِ مِن غَيرِ ما خَلَطِ",9,"ط",1,0],["فجذبت أعناق الرجال وأشرقت","طربا مشاعرهم خلال ثوان",10,"ن",1,0],["فَجذْرُكَ مَدَّ بِرُكْنِ الضِّفافِ","بِساطَ الأمانِي وَلَنْ يَرْحَلا",11,"ل",2,0],["فجذعي شموخ النخل ماهزه الردى","وادري جذوع الظلم منقعراتِ",12,"ت",1,0],["فجذوة عشقِها في الرّوحِ تسري","ويبقى بعد شعلته اتقادُ",13,"د",1,0],["فجذري بأرضي وساقي هنا","وهم يحفرون القبور لقصمِهْ",14,"م",2,0],["فجذبتها لفضاء قلبي والمنى","من دونها تلك المسيرة لا تطاق",15,"ق",1,0]]}