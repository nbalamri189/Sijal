=&rc=19",""],[5126,"ملل ويأس وأفكار سوداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87789&r=&rc=4",""],[5190,"وصية شهيد فلسطيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78343&r=&rc=56",""]],"verses":[["وَلَو مُدَّ لي طُنُبٌ بِالفَلا","حَماني لِداغَ القَنا الذُبَّلِ",0,"ل",1,0],["وَلَو ما جَزَيتُ القَرضَ بِالعِرضِ لَم يَضِع","فَإِنَّ النَدى عِندَ الكِرامِ وَدائِعُ",1,"ع",1,0],["وَلَو مَلَكوا لَم يَأتلوا في دِمائِنا","وُلوغاً وَلكِنّا مَلَكنا فَأَسجَحنا",2,"ن",2,0],["ولو مثلَتْ في سابقيه لسابقت","إلى خدمةٍ ترضيك منها الجواريا",3,"ي",2,0],["وَلَو مِنّا فَتاتُكُمُ لَغِرنا","وَلَو عادَ الزُبَيرُ بِنا وَفَينا",4,"ن",2,0],["وَلو مُتنا لَشَدَّ عَلَيكَ قَبري","بِسُمومٍ مَضارِبُهُ حُسامِ",5,"م",1,0],["ولو مات من نُصْحٍ لقوم أخوهم","لقد لقيتني بالمنايا شعوبها",6,"ب",3,0],["ولو مُلِّكْتُ صَوْنَكَ فاعلمَنْهُ","لَصنتُكَ في الحريز من العِيابِ",7,"ب",1,0],["ولو ملكت كفي على الشعر غربَهُ","لكان له معدىً سواك ومَقْصر",8,"ر",1,0],["ولو مسّ ثوبي ثوبَ أمك مسّةً","لأولدها خمسين مثلَكَ في شهر",9,"ر",1,0],["ولو مَهَرَ الأحماءُ صِهراً لكنتَهُ","ولم تَغْلُ بالدنيا على متَكَثِّرِ",10,"ر",1,0],["ولؤْمُكَ لؤمٌ له فضلُهُ","رَوَيناهُ قِدماً على الأعْمش",11,"ش",1,0],["ولؤم الناس طولٌ دون عَرضٍ","ولكن لؤمُهُ طُولٌ وعَرض",12,"ض",1,0],["ولو مِنْ سواكَ أتَتْ هذه","لأصبح نصْباً لرجْم الظنون",13,"ن",1,0],["وَلَو مارَسوهُ ساعَةً إِنَّ قِرنَهُ","إِذا خامَ أَخدانُ الرِجالِ يَطيحُ",14,"ح",1,0],["وَلَو مَلَكوا الأَقدارَ اِستَغفَرَ الَّذي","لَهُ المُلكُ يُؤتيهِ الَّذي هُوَ آثِرُه",15,"ر",2,0],["وَلَومِ عاذِلَةٍ باتَت تُؤَرِّقُني","حَزّى المَلامَةِ ما تُبقي وَما تَدَعُ",16,"ع",1,0],["ولو مَشَى فيهُمُ حيًّا لحطَّمَهُ","قومٌ وقالوا بخبثٍ إنَّهُ صَنَمُ",17,"م",1,0],["وَلَو مَلَكَت كُنوزَ الأَرضِ كَفّي","جَعَلتُ أَساسَها ماساً وَرادا",18,"د",2,0],["وَلَومُ الرَكبِ أَن حَيَّيتَ رَبعاً","تَغَيَّرَ بُعدَ مَعهَدِهِ الجَديدِ",19,"د",1,0],["وَلَو مَلَكتُ زَماعاً ظَلَّ يَجذِبُني","قَوداً لَكانَ نَدى كَفَّيكَ مِن عُقُلي",20,"ل",2,0],["ولو مَنَعَتْه أن يُضامَ جَهَنَّمٌ","لَخاضا إليه مُقْدِمَيْنِ جهَنَّما",21,"م",2,0],["وَلَو مَدَّ إِلى أُذنَي","هِ كَفَّيهِ لَما نالا",22,"ل",2,0],["ولو مُزِجَتْ حلاوَتُهُ بنفطٍ","لسَاغَ وَجَلّ عن خَصرِ الفَضيضِ",23,"ض",1,0],["وَلَو مَرَّتِ الريحُ الصَبا عِندَ أُذنِهِ","بِذِكري لَسَبَّ الريحَ أَو لَتَعَتَّبا",24,"ب",2,0],["ولو ملكْتُ قيادي","فارقْتُها وَهْيَ تصفرْ",25,"ر",1,0],["وَلَوماهُ وَقَيتُكُما","عَلى الهِجرانِ وَاِستَتِرا",26,"ر",2,0],["وَلَو مُلِئَت عَينُ الدُجى لَمَلَأتُها","بِغُرَّةِ شَمسِ العَصرِ في مَطلَعِ القَصرِ",27,"ر",1,0],["وَلَو مَسَحَت بِالكَفِّ أَعمى لَأَذهَبَت","عَماهُ وَشيكاً ثُمَّ عادَ بِلا عَمى",28,"م",2,0],["ولو ملكَتْ مَسامِعَهُم فَلَبَّوا","لمَا مَلكوا الجماجمَ والرقابا",29,"ب",2,0],["ولو مَلَكَ الجنَاحَ لطار يَطوي","طِباقَ الجوِّ ذُعْراً وَارْتِعَابا",29,"ب",2,0],["وَلَو مَلَكَت كَفُّها سِمسِماً","لَما ضَيَّعَت كَفُّها سِمسِمَه",30,"م",2,0],["وَلَو مَرَّ نَفحُ الريحِ مِن خَلفِ أُذنِهِ","بِذِكرى لِسَبِّ الريحَ ثُمَّ تَغَضَّبا",31,"ب",2,0],["وَلَو مَثَّلَ نَفسَ الحُس","نِ شَخصاً ما تَعَدّاهُ",32,"ا",2,0],["وَلَو مُتُّ كانَ المَوتُ خَيراً مِنَ الشَقا","وَما لِلفَتى مِمّا قَضى اللَهُ مَخرَجُ",33,"ج",1,0],["ولو مَرّتْ بخَيْلِكَ هُجْنُ خيلٍ","وهَبْنَ لعُجْمِها نسَباً صريحا",34,"ح",2,0],["ولو منحوك عمرهم جميعا","وما هو بالكثير ولا الجزيل",35,"ل",1,0],["ولو مَلأ السُّهى عَيْنَيْهِ مِنّي","أَبَرَّ على مَدَى زُحَلٍ وزادا",36,"د",2,0],["وَلَو مُنِعَت أُريقَت لِلعِبادِ دِماً","وَطاحَ مِن مُهَجِ الأَجنادِ غاليها",37,"ي",3,0],["وَلَو متَّ قَبلَ البَينِ يا واحِد العُلا","رَجَوتُ لِفهرٍ أَن تَرى لَكَ ثاني",38,"ن",2,0],["ولو مَسَّ رَضْوَى عاصفُ الريح مَرّةً","لباتت له أكبادُنا تتقطّع",39,"ع",1,0],["ولو مُكِّنََتْ نفسي لأرسلتَ عاصفاً","على الناس يَذروهم وفجَّرتُ حاصبا",40,"ب",2,0],["وَلو ملكَ قارونٍ ملكتُ دَفعتُه","على كرهِ بعض الناسِ بعضَهم أجرا",41,"ر",2,0],["ولو مشى الموت في شهباء معلمة","مشوا إلى الموت في الهنديّة القضب",42,"ب",1,0],["ولومِ عاذلة ٍ باتتْ تؤرّقني","حَرَّى الْمَلاَمَة ِ مَا تُبْقِي وَمَا تَدَعُ",43,"ع",1,0],["ولو ماشيتها لعجلت عنها","وذات الخال مقصور خطاها",44,"ا",3,0],["ولو مسحت كفاك قلباً فقدته","لعاد طروباً للحياة مناجيا",45,"ي",2,0],["ولو ملأتُ قُرَابَ الأرضِ مِنْ زَلَلٍ","أيقنتُ أنّكَ تمحوها بِلاَ سَأَمِ",46,"م",1,0],["ولو ملك الفَتى مالا عظيما","وشيَّدَ في ذُرى الدنيا قُصورَا",47,"ر",2,0],["ولو ملَكتْها الغانياتُ بحيلةٍ","لِزنَّ بها جِيدا وحَلَّين مِعصما",48,"م",2,0],["وَلَو مَشَت غِيَرُ الدَهرِ البَراحَ لَهُ","لَحاوَلَت مِن رَداهُ مَطلَباً عَسِرا",49,"ر",2,0],["وَلَو مُنِيَت عَوفُ اِبنُ عَبدٍ بِفَقدِهِم","لَكانَت أَكُفّاً لَم تُعَن بِأَصابِعِ",50,"ع",1,0],["وَلَو مِن عِندِ غَيرِكَ يَبتَغيها","لَعَزَّت عِندَهُ العَنسُ الأَمونُ",51,"ن",1,0],["ولو ملأ المراقبُ منكَ لحظاً","لكادَ من المهابةِ أن يذوبا",52,"ب",2,0],["ولو مت وجداً ما أسفت لمهجتي","ولكنْ عليكم دونها أتاسَفُ",53,"ف",1,0],["ولو ملكت اتّساعا لا تسعت به","على المكارم في التفصيل والجمل",54,"ل",1,0],["وَلَو ماتَ مِنهُم مَن جَرَحنا لَأَصبَحَت","ضِباعٌ بِأَكنافِ الأَراكِ عَرائِسا",55,"س",2,0],["وَلَو مَنَّ لي مَنْ ريْقِهِ بِجُريَعة","عَرَفْتُ بأنَّ المَنَّ أحلى من السَلْوى",56,"و",2,0],["ولو مَلَكَ المُنَى بَلَدٌ","لطَاعَتْكَ خُراسانُ",57,"ن",1,0],["ولو مَنَحوكَ الوُدَّ بالصِّدق لم يكن","لودِّهمُ مِن جهلهمْ بك عاصم",58,"م",1,0],["ولو معهم حبست لكان سهلاً","ولكني حبست مع الدجاج",59,"ج",1,0],["وَلَو مُهِرَت مَهرو عَلى وَصلِ ساعَةٍ","نُجومَ السَماءِ الزُّهرِ قَلَّ لَها المَهرُ",60,"ر",1,0],["وَلَو مسّ حدّ السيفِ رِقراقُ حلمه","إِذاً لَنبا في كفّ مَعمَله ضربا",61,"ب",2,0],["وَلو مسّ حرّ النارِ أَصبَحَ حرّها","سَلاماً وبرداً لا تحسّ له لهبا",61,"ب",2,0],["وَلَو مرّ في جنحٍ منَ اللّيل رأيه","لَوارى سناه الشهب وَاِستنهضَ السربا",61,"ب",2,0],["وَلَو مَلَكتُ عِنانَ الريحِ أَصرِفُها","في كُلِّ ناحِيَةٍ ما فاتَها الطَلَبُ",62,"ب",1,0],["وَلَومك عندي لا يُفيد وَكُله","فُضول اِذا كَرّرته وَتعسف",63,"ف",1,0],["ولو مَلَكتْ كَفّي لوجهي وقايةً","تقدَّمتُ قوماً أُدخِلوا البابَ قُدّامي",64,"م",2,0],["وَلَو مَدَحو أَيّامَ أُنسي بِلَفظَةٍ","فَما ذاكَ إِلّا أَلفُ بِرٍّ مِنَ الدَهرِ",65,"ر",1,0],["وَلَو مَضى الكُلُّ مِنها لَم يَكُن عَجَباً","وَاِنَّما عَجَبي لِلبَعضِ كَيفَ بَقي",66,"ق",2,0],["وَلَو مَسَّ أَنبوب اليَراعِ رأَيته","يُلَبي أَنابيبَ الرِماحِ إِذا دَعى",67,"ع",2,0],["ولو مُكِّنْتُ مما أشتهيه","خَدَمْتُك دون أصحابي بنفسي",68,"س",2,0],["ولو مدّ من نأيَته عنكم يداً","لعاد بحدّ السَّيف أَجْدَعَ أجْذما",69,"م",2,0],["ولو ميّزتَه تمْييز مثلى","لقُلتَ بأنه قد قالَ شَعْرهْ",70,"ه",1,0],["ولو منها قنعت غني","ت بالنزر من الدون",71,"ن",1,0],["ولو ملكتُ سمعَهُ","لقد أطلتُ عذلَهْ",72,"ل",2,0],["ولو مُنعَ الجُبنُ بالسيفِ كان","أحقَّ بضرب الطُّلى الصيقلُ",73,"ل",1,0],["ولو ما أغبّاك الطُّروقَ كفتهما","خلافة جبريلٍ عليك وميكالِ",74,"ل",1,0],["ولو مسحتم زحلاً ببُوعكم","رجوتُ بعدُ لعلاكم مَظهَرا",75,"ر",2,0],["ولو مُكنت من عطفِ المَطايا","لكانَ إلى أبي نَصْرٍ رجوعي",76,"ع",2,0],["ولو مَسَسْتُ حَديداً لانَ لي وغَدا","يُلْوى بِطَيٍّ كَلَيِّ الخَزِّ مُنْجَدِلِ",77,"ل",1,0],["ولو ملأ الدنيا علوماً جليلةً","وسيَّرَ للقرآنِ بيضَ الرَّكائِبِ",78,"ب",1,0],["ولو مَنبِتُ الزّقّومِ يُسْقى بجودِه","لما كان إلّا منبِتَ الوردِ والزّهرِ",79,"ر",1,0],["وَلَو مِمَّن يَقودُ لَهُم","جُنودَ الغزوِ مُحتَفِلا",80,"ل",2,0],["ولو ملَكَت نفسِي زِمامَ اختِيارهَا","لَقَضَيتُ عُمرِي في المدَارِسِ ثَاويا",81,"ي",2,0],["ولو ملَكَتْ من الأمرينِ شيئاً","لما مرّتْ بدُنياها الطُّيُوبُ",82,"ب",1,0],["ولو مدَّ نحوي حادِثُ الدهرِ طَرْفهُ","لحدَّثت نَفْسِي أَنْ أَمُدَّ لَهُ يَدا",83,"د",2,0],["ولو مُتُّ ضَرّاً ما عَقدْتُ قِلادةً","على جيدِ مَنْ لا يستحقُّ لها لُبْسا",84,"س",2,0],["ولو مرّتْ على حلم ابن قيسٍ","لأَضحى وهو كالطفل الرضيع",85,"ع",1,0],["وَلوْ مَزجْتَ بِماءِ المُزْنِ ما اكْتَسَبتْ","مِنْ لُطْفِهِ شِيَمي ما غَصَّ مَنْ شَرِبَا",86,"ب",2,0],["وَلَوْمُ عَوَاذلي في الحُبِّ فِيكُمْ","وَحَقِّكُمُ بِأذْني لا يَجُوزُ",87,"ز",1,0],["وَلَو مَزَجَ اللَهُ الحَياةَ بِلُطفِهِ","لَمّا اِحتَمَلَت سَقمَ الجُسومِ جُلودِها",88,"د",3,0],["ولو ملكت يدي في يومه وفمي","كانت له منّيَ الأوضاح والغرر",89,"ر",1,0],["ولو مكنتني من مرامٍ حوادث","لحقت بهم من قبل ما يصلونا",90,"ن",2,0],["ولو ملكت جعلت الناس كلهمُ","ملائكاً وجميع الأرض جنات",91,"ت",1,0],["ولو مشى في جانب الأرض من","ثِقْلٍ إِذنْ مالتْ إِلى جانب",92,"ب",1,0],["ولو ما عرفناها عسانا نعرفها","وعسى أن نقبض من بقايا شهودها",93,"د",3,0],["ولو ما وليناها عسانا نشوفها","وعسى ان نولى سْديّدٍ من سدودها",93,"د",3,0],["ولو منت عمداً في مديحك مفرطا","برغمي انتحيت الصدق في ذلك العمد",94,"د",1,0],["ولوم العذول لشرب الشمول","كوقع النصول بخلب الكبد",95,"د",1,0],["ولو منحت من التوفيق موهبة","أزاحني الرشد عن طريق الغوايات",96,"ت",1,0],["ولو من بعد أحمد من رسول","لخالقنا لكنتَ له رسولا",97,"ل",2,0],["ولوْ مِنْ حَياتي رَامَ النزُول","لُجدْتُ بِها واغْتَنَمتُ النُّزولا",98,"ل",2,0],["وَلَو مَد لَيلاً بِهِ صَوته","رَأَيت الدجى يَنثُر الأَنجُما",99,"م",2,0],["ولو ملكت رقاب الناس كلهم","شرقاً وغرباً لما جئنا نهنيكا",100,"ك",2,0],["ولو ملكت لها السقيا وهامتها","تكفكف المحل عنها أدمع الرحم",101,"م",1,0],["وَلَو مَلَكَ الدُنيا لَما كانَ سائِلٌ","وَلا اِعتامَ فيها صاحِبُ فَضل صاحِبِ",102,"ب",1,0],["ولو مكثت ولم ترحل لما قعدت","سياسة منك عزت حيطة الفطر",103,"ر",1,0],["وَلَو مَعَهُم حُبِستُ لَهانَ وَجدي","وَلَكِنّي حُبِستُ مَعَ الدَّجاجِ",104,"ج",1,0],["ولو ملكتْ مهجتي أمرَها","حبستكِ بالقلب القُوى الكافيه",105,"ي",2,0],["ولو ملكت خزائن كل شيء","من الأشياء دونك ما غنينا",106,"ن",2,0],["ولو مشيت على الحصباء غادرها","غبار نعليك طيباً ينعش الميتا",107,"ت",2,0],["ولوم لاح في هواها مُغرياً","فكم على عينيه من غشا الرّين",108,"ن",1,0],["ولو من بعد عدتها أعلماها","ومن بعد التناكح والمحاق",109,"ق",1,0],["ولو مر بنا ماني","أكلناه على الريق",110,"ق",1,0],["ولو ملّكتهُ رأيَهُ يومَ بَقّةٍ","لما فاتَهُ من يومِ مكروهِها وَعدُ",111,"د",1,0],["ولو من الردى ببقاه دهراً","به ممن يناضلنا اشتفينا",112,"ن",2,0],["ولو مر قبلي من يعلمك الهوى","لما بت حتى اليوم في مثل ذا الجهل",113,"ل",1,0],["ولو مثلي افتكرت بهِ قليلاً","لما صوَّبت فيهِ قطُّ فكرا",114,"ر",2,0],["ولو مال غصن البان ميلة عطفها","تردى فهل يا عطف أنت عجين",115,"ن",1,0],["ولو مرّ بي عامٍ ورا عام","رضيت به لو كنت ما يوز",116,"ز",1,0],["ولومك ان ساءتك منه خليقة","على شيخك المعروف اذ كان هاديا",117,"ي",2,0],["ولو ملكت كنوز الأرض قاطبةً","من دون رؤياه لم أبلغ بها أملا",118,"ل",2,0],["ولو مشيت على الحصباء صيرها","أريج ذيلك تحكي المسك مفتوتا",119,"ت",2,0],["ولو مَثُلَ الهدى لغدا يحلَّي","ثراك لدمعه عقد فريد",120,"د",1,0],["ولو مع إمكان الدفاع بدونه","وفقد النسا أو كون محرم معتد",121,"د",1,0],["وَلَو مَرَّ مَيلٌ بعد ميل وَأَصبَحَت","عِتاقُ المَطايا قَد تَعادَينَ بِالفَترِ",122,"ر",1,0],["ولو مَدحتُك بالقرءأن فهو أتي","إلى ابن عمّك طوراً بعد أطوارِ",123,"ر",1,0],["ولو مارسوا ما كنت فيه لأحرجوا","ورائي ولم يطلب إلى المهر طالب",124,"ب",1,0],["ولو مر بنا فيها","بكم طيف سهرناها",125,"ا",3,0],["ولو ملأ الأرضين والأمر مسعد","جماجم قالوا ذا هو المتلطف",126,"ف",1,0],["ولو مت بالهجران لم أستمع لهم","أرسلو حبيبا بالصبابة أوصالي",127,"ل",2,0],["ولو مشى في بلادٍ غير مخصبةٍ","لأخصب الكل ناديها وباديها",128,"ي",3,0],["ولو ملكتْ يدي يوماً شعوري","لجُدتُ به لمعدومِ الشعور",129,"ر",1,0],["ولو مات امرؤ منا شهيدا","لصارعكم رفاتا أو عظاما",130,"م",2,0],["ولو مُذنب غيري جنى الذّنب كلّه","ما مسّهُ بعض الّذي بي قائمُ",131,"م",1,0],["ولو مت قالوا أظلم الجو بعده","وغاض الحيا الهطال إذ غاض جوده",132,"ه",1,0],["ولو مر أهيف مجدولٌ على حجر","صبا له إن رآه ذلك الحجر",133,"ر",1,0],["ولو ملك الدنيا فأضحى ملوكها","عبيداً له في الشرق والغرب مازها",134,"ه",2,0],["ولو مزجوا بالخمر طينة آدم","لعاش ولم يدرِ القطوبَ محياه",135,"ا",2,0],["ولو مطرتجحيم الوقد جمراً","فكانت مدةً بقياس عام",136,"م",1,0],["ولو منها فرضنا جحد شيءٍ","لألقم دونه الحجر الجحود",137,"د",1,0],["ولو مثلت في الخطب مصر دهاءه","إذاً لتحامتها الاساطيل والجند",138,"د",1,0],["ولَومُ الجَمِيعِ عَليكَ استَقَر","لأَنَّكَ َأنسجَتَ رَبَّةَ شَر",139,"ر",1,0],["وَلَومُهُم لِزَفسِ طُرّاً بادِ","لِمَيلِهِ لَنُصرَةِ الطُروادِ",140,"د",1,0],["ولو مثلما قد قيل للدهر سطوة","على المرء تقضي بالشقاء وتحكم",141,"م",1,0],["ولو مثلت للمعاني الريا","ض لكانت معانيك أزهارها",142,"ر",3,0],["ولو مشيت على الحصباء صيرها","شعاع خديك مرجانا وياقوتا",143,"ا",1,0],["ولو مازجَ النارَ في حَرِّها","حديثُكَ أخْمَد منها اللَّهب",144,"ب",1,0],["ولو مال بالجهال ميلته بنا","لجاء بعذر إن ذا لعجيب",145,"ب",1,0],["ولو ملكت نطقاً لأبدت ثناءها","وقامت تؤدي واجب الحمد والشكر",146,"ر",1,0],["ولوم النفس يغسل ما تبقى","بقاع القلب من 