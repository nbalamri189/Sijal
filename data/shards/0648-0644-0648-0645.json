{"poems":[[53,"أشم ببابل بو الصغار","https://www.aldiwan.net/poem29843.html","المتقارب"],[53,"سيسكتني يأسي وفي الصدر حاجة","https://www.aldiwan.net/poem30091.html","الطويل"],[71,"سلوا صهوات الخيل يوم الوغى عنا","https://www.aldiwan.net/poem4023.html","الطويل"],[83,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[27,"عفا قو وكان لنا محلاً","https://www.aldiwan.net/poem4445.html","الوافر"],[27,"عرفت الدار بعد بلى الخيام","https://www.aldiwan.net/poem5986.html","الوافر"],[37,"ألا لا أرى الأيام يقضى عجيبها","https://www.aldiwan.net/poem6494.html","الطويل"],[51,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[51,"أبا منذر بالله إلا صدقتني","https://www.aldiwan.net/poem64004.html","الطويل"],[51,"دع الفكر في أمري فقدري لا يفي","https://www.aldiwan.net/poem64030.html","الطويل"],[51,"ألا قل لنحويك الأخفش","https://www.aldiwan.net/poem64923.html","المتقارب"],[51,"نظرت إلى الرغيف فرد روحي","https://www.aldiwan.net/poem64959.html","الطويل"],[51,"أصبت مصائب كنت الشري","https://www.aldiwan.net/poem66523.html","البسيط"],[26,"نام الخلي وبت الليل مشتجرا","https://www.aldiwan.net/poem24088.html","البسيط"],[91,"وقفت ضحى في شاطء النيل وقفة","https://www.aldiwan.net/poem8826.html","عموديه"],[38,"عاد الهموم وما يدري الخلي بها","https://www.aldiwan.net/poem7725.html","البسيط"],[92,"ما قدس المثل الأعلى وجمله","https://www.aldiwan.net/poem38909.html","البسيط"],[85,"نراوح بالحوادث أو نغادى","https://www.aldiwan.net/poem8105.html","الوافر"],[45,"ألما يكف في طللي زرود","https://www.aldiwan.net/poem63486.html","الوافر"],[45,"لئن ثنى الدهر من سهمي فلم يصل","https://www.aldiwan.net/poem65622.html","الخفيف"],[61,"هم صرموا حبل الهوى فتصرما","https://www.aldiwan.net/poem51445.html","الطويل"],[49,"ألا قل لابن معن ذا","https://www.aldiwan.net/poem64281.html","الهزج"],[80,"أيا خلج المدامع لا تغيضي","https://www.aldiwan.net/poem31397.html","الوافر"],[44,"تلقاه طيفي في الكرى فتجنبا","https://www.aldiwan.net/poem30281.html","الطويل"],[69,"كم شببت لي فتاة","https://www.aldiwan.net/poem28163.html","المجتث"],[31,"طربت ورد من تهوى","https://www.aldiwan.net/poem42505.html","مجزوء الوافر"],[74,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[33,"خليلي هذا الربع أعلم آيه","https://www.aldiwan.net/poem25798.html","الطويل"],[105,"أعدي النمل خيبر والذبابا","https://www.aldiwan.net/poem44062.html","الوافر"],[52,"أمن فقد جود الحسان الملاح","https://www.aldiwan.net/poem26688.html","المتقارب"],[48,"تمناه طيفي في الكرى فتعتبا","https://www.aldiwan.net/poem10803.html","الطويل"],[48,"وظبي تقسم الآجال","https://www.aldiwan.net/poem66189.html","الهزج"],[50,"أخشاب حقا أن دارك تزعج","https://www.aldiwan.net/poem63985.html","الطويل"],[46,"ألاح وقد رأى برقا مليحا","https://www.aldiwan.net/poem23637.html","الوافر"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125533","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16643","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19074","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54272","الطويل"],[90,"الأنانية","https://www.poetsgate.com/ViewPoem.aspx?id=179128",""],[90,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[94,"لبنان والغوطتان","https://www.poetsgate.com/ViewPoem.aspx?id=15652",""],[38,"عادَ الهمومُ وما يدري الخليُّ بها","https://www.poetsgate.com/ViewPoem.aspx?id=21204",""],[32,"على الدار التي لبست بلاها","https://www.poetsgate.com/ViewPoem.aspx?id=126",""],[127,"وحق الهوى لو نلت من فيك رشفة","https://www.aldiwan.net/poem803.html",""],[129,"إن أبطأ المرء في وعد وفي عدة","https://www.aldiwan.net/poem50517.html","البسيط"],[129,"أرى الدنيا وزخرفها غرورا","https://www.aldiwan.net/poem50617.html","الطويل"],[143,"أبى الله إلا أن تجود وتنعما","https://www.aldiwan.net/poem58433.html","الطويل"],[144,"لو أن شامخ قدر دافع قدرا","https://www.aldiwan.net/poem11764.html","البسيط"],[144,"محل لهم بين النقا والأجارع","https://www.aldiwan.net/poem11772.html","الطويل"],[144,"بنصرك يدرك الفتح المبين","https://www.aldiwan.net/poem11833.html","الوافر"],[161,"تولى بعد ما غسل الذنوبا","https://www.aldiwan.net/poem58907.html","الوافر"],[161,"محب يمنى نفسه ويسوف","https://www.aldiwan.net/poem58925.html","الطويل"],[187,"باتت تلوم على طول الونى وغدت","https://www.aldiwan.net/poem43360.html","البسيط"],[208,"لأسماء رسم أصبح اليوم دارسا","https://www.aldiwan.net/poem27943.html","الطويل"],[213,"أهل خبر فيه النجيد لنا يروى","https://www.aldiwan.net/poem37825.html","الطويل"],[230,"نعت بالبين غربان","https://www.aldiwan.net/poem50762.html","مجزوء الوافر"],[230,"تميط الأذى عن حامليها الصوارم","https://www.aldiwan.net/poem50832.html","الطويل"],[263,"أمير المؤمنين فدتك نفسي","https://www.aldiwan.net/poem68179.html","الوافر"],[283,"معذبتي حتام ذا الهجر والهجر","https://www.aldiwan.net/poem32745.html","الطويل"],[306,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[327,"إني أتتني عن المهدي معتبة","https://www.aldiwan.net/poem44292.html","البسيط"],[362,"لقد شاقني هذا القوام المهفهف","https://www.aldiwan.net/poem68090.html","الطويل"],[365,"تصرف أحوالي على حكم أيامي","https://www.aldiwan.net/poem60644.html","الطويل"],[367,"يعز على محلي مفارقة القطر","https://www.aldiwan.net/poem17317.html","الطويل"],[394,"يا من وهبت له روحي فعذبها","https://www.aldiwan.net/poem53479.html","الوافر"],[407,"أبان لنا من دره يوم ودعا","https://www.aldiwan.net/poem50150.html","الطويل"],[417,"يشق علي أن تشقى بحبس","https://www.aldiwan.net/poem53982.html","الوافر"],[417,"أبى الله إلا إن تعز وتكرما","https://www.aldiwan.net/poem54043.html","الطويل"],[433,"يشمر أنفه إن قال شعرا","https://www.aldiwan.net/poem12625.html","الوافر"],[442,"إلى كم أرقع الدنيا","https://www.aldiwan.net/poem14389.html","مجزوء الوافر"],[459,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[459,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[459,"كذا تنقضي الأيام حالا على حال","https://www.aldiwan.net/poem56070.html","الطويل"],[459,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[462,"ألا من مبلغ عني هماما","https://www.aldiwan.net/poem15137.html","الوافر"],[501,"يستغرب الخب أن نعلو وقد برزت","https://www.aldiwan.net/poem37809.html","البسيط"],[501,"رغبنا بأسرار الشهود لوجهكم","https://www.aldiwan.net/poem38082.html","الطويل"],[515,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[537,"صحا من سكره وسلا","https://www.aldiwan.net/poem23848.html","مجزوء الوافر"],[539,"رعى الله أيام الصبا واللياليا","https://www.aldiwan.net/poem47491.html","عموديه"],[561,"قلوب ودروب","https://www.aldiwan.net/poem67273.html","عموديه"],[576,"سواي يخاف الدهر أو يرهب الردى","https://www.aldiwan.net/poem2749.html","الطويل"],[586,"أصوغ الحلى في كل يوم وليلة","https://www.aldiwan.net/poem1562.html",""],[586,"نواحي الأرض ضاحكة الربوع","https://www.aldiwan.net/poem1568.html",""],[587,"صبا وهزته أيدي شوقه طربا","https://www.aldiwan.net/poem17425.html","البسيط"],[587,"سلوي عن هواكم لا يجوز","https://www.aldiwan.net/poem17552.html","الوافر"]],"verses":[["وَلَو مُدَّ لي طُنُبٌ بِالفَلا","حَماني لِداغَ القَنا الذُبَّلِ",0,"ل",1,0],["وَلَو ما جَزَيتُ القَرضَ بِالعِرضِ لَم يَضِع","فَإِنَّ النَدى عِندَ الكِرامِ وَدائِعُ",1,"ع",1,0],["وَلَو مَلَكوا لَم يَأتلوا في دِمائِنا","وُلوغاً وَلكِنّا مَلَكنا فَأَسجَحنا",2,"ن",2,0],["ولو مثلَتْ في سابقيه لسابقت","إلى خدمةٍ ترضيك منها الجواريا",3,"ي",2,0],["وَلَو مِنّا فَتاتُكُمُ لَغِرنا","وَلَو عادَ الزُبَيرُ بِنا وَفَينا",4,"ن",2,0],["وَلو مُتنا لَشَدَّ عَلَيكَ قَبري","بِسُمومٍ مَضارِبُهُ حُسامِ",5,"م",1,0],["ولو مات من نُصْحٍ لقوم أخوهم","لقد لقيتني بالمنايا شعوبها",6,"ب",3,0],["ولو مُلِّكْتُ صَوْنَكَ فاعلمَنْهُ","لَصنتُكَ في الحريز من العِيابِ",7,"ب",1,0],["ولو ملكت كفي على الشعر غربَهُ","لكان له معدىً سواك ومَقْصر",8,"ر",1,0],["ولو مسّ ثوبي ثوبَ أمك مسّةً","لأولدها خمسين مثلَكَ في شهر",9,"ر",1,0],["ولو مَهَرَ الأحماءُ صِهراً لكنتَهُ","ولم تَغْلُ بالدنيا على متَكَثِّرِ",10,"ر",1,0],["ولؤْمُكَ لؤمٌ له فضلُهُ","رَوَيناهُ قِدماً على الأعْمش",11,"ش",1,0],["ولؤم الناس طولٌ دون عَرضٍ","ولكن لؤمُهُ طُولٌ وعَرض",12,"ض",1,0],["ولو مِنْ سواكَ أتَتْ هذه","لأصبح نصْباً لرجْم الظنون",13,"ن",1,0],["وَلَو مارَسوهُ ساعَةً إِنَّ قِرنَهُ","إِذا خامَ أَخدانُ الرِجالِ يَطيحُ",14,"ح",1,0],["وَلَو مَلَكوا الأَقدارَ اِستَغفَرَ الَّذي","لَهُ المُلكُ يُؤتيهِ الَّذي هُوَ آثِرُه",15,"ر",2,0],["وَلَومِ عاذِلَةٍ باتَت تُؤَرِّقُني","حَزّى المَلامَةِ ما تُبقي وَما تَدَعُ",16,"ع",1,0],["ولو مَشَى فيهُمُ حيًّا لحطَّمَهُ","قومٌ وقالوا بخبثٍ إنَّهُ صَنَمُ",17,"م",1,0],["وَلَو مَلَكَت كُنوزَ الأَرضِ كَفّي","جَعَلتُ أَساسَها ماساً وَرادا",18,"د",2,0],["وَلَومُ الرَكبِ أَن حَيَّيتَ رَبعاً","تَغَيَّرَ بُعدَ مَعهَدِهِ الجَديدِ",19,"د",1,0],["وَلَو مَلَكتُ زَماعاً ظَلَّ يَجذِبُني","قَوداً لَكانَ نَدى كَفَّيكَ مِن عُقُلي",20,"ل",2,0],["ولو مَنَعَتْه أن يُضامَ جَهَنَّمٌ","لَخاضا إليه مُقْدِمَيْنِ جهَنَّما",21,"م",2,0],["وَلَو مَدَّ إِلى أُذنَي","هِ كَفَّيهِ لَما نالا",22,"ل",2,0],["ولو مُزِجَتْ حلاوَتُهُ بنفطٍ","لسَاغَ وَجَلّ عن خَصرِ الفَضيضِ",23,"ض",1,0],["وَلَو مَرَّتِ الريحُ الصَبا عِندَ أُذنِهِ","بِذِكري لَسَبَّ الريحَ أَو لَتَعَتَّبا",24,"ب",2,0],["ولو ملكْتُ قيادي","فارقْتُها وَهْيَ تصفرْ",25,"ر",1,0],["وَلَوماهُ وَقَيتُكُما","عَلى الهِجرانِ وَاِستَتِرا",26,"ر",2,0],["وَلَو مُلِئَت عَينُ الدُجى لَمَلَأتُها","بِغُرَّةِ شَمسِ العَصرِ في مَطلَعِ القَصرِ",27,"ر",1,0],["وَلَو مَسَحَت بِالكَفِّ أَعمى لَأَذهَبَت","عَماهُ وَشيكاً ثُمَّ عادَ بِلا عَمى",28,"م",2,0],["ولو ملكَتْ مَسامِعَهُم فَلَبَّوا","لمَا مَلكوا الجماجمَ والرقابا",29,"ب",2,0],["ولو مَلَكَ الجنَاحَ لطار يَطوي","طِباقَ الجوِّ ذُعْراً وَارْتِعَابا",29,"ب",2,0],["وَلَو مَلَكَت كَفُّها سِمسِماً","لَما ضَيَّعَت كَفُّها سِمسِمَه",30,"م",2,0],["وَلَو مَرَّ نَفحُ الريحِ مِن خَلفِ أُذنِهِ","بِذِكرى لِسَبِّ الريحَ ثُمَّ تَغَضَّبا",31,"ب",2,0],["وَلَو مَثَّلَ نَفسَ الحُس","نِ شَخصاً ما تَعَدّاهُ",32,"ا",2,0],["وَلَو مُتُّ كانَ المَوتُ خَيراً مِنَ الشَقا","وَما لِلفَتى مِمّا قَضى اللَهُ مَخرَجُ",33,"ج",1,0],["ولو مَرّتْ بخَيْلِكَ هُجْنُ خيلٍ","وهَبْنَ لعُجْمِها نسَباً صريحا",34,"ح",2,0],["ولو منحوك عمرهم جميعا","وما هو بالكثير ولا الجزيل",35,"ل",1,0],["ولو مَلأ السُّهى عَيْنَيْهِ مِنّي","أَبَرَّ على مَدَى زُحَلٍ وزادا",36,"د",2,0],["وَلَو مُنِعَت أُريقَت لِلعِبادِ دِماً","وَطاحَ مِن مُهَجِ الأَجنادِ غاليها",37,"ي",3,0],["وَلَو متَّ قَبلَ البَينِ يا واحِد العُلا","رَجَوتُ لِفهرٍ أَن تَرى لَكَ ثاني",38,"ن",2,0],["ولو مَسَّ رَضْوَى عاصفُ الريح مَرّةً","لباتت له أكبادُنا تتقطّع",39,"ع",1,0],["ولو مُكِّنََتْ نفسي لأرسلتَ عاصفاً","على الناس يَذروهم وفجَّرتُ حاصبا",40,"ب",2,0],["وَلو ملكَ قارونٍ ملكتُ دَفعتُه","على كرهِ بعض الناسِ بعضَهم أجرا",41,"ر",2,0],["ولو مشى الموت في شهباء معلمة","مشوا إلى الموت في الهنديّة القضب",42,"ب",1,0],["ولومِ عاذلة ٍ باتتْ تؤرّقني","حَرَّى الْمَلاَمَة ِ مَا تُبْقِي وَمَا تَدَعُ",43,"ع",1,0],["ولو ماشيتها لعجلت عنها","وذات الخال مقصور خطاها",44,"ا",3,0],["ولو مسحت كفاك قلباً فقدته","لعاد طروباً للحياة مناجيا",45,"ي",2,0],["ولو ملأتُ قُرَابَ الأرضِ مِنْ زَلَلٍ","أيقنتُ أنّكَ تمحوها بِلاَ سَأَمِ",46,"م",1,0],["ولو ملك الفَتى مالا عظيما","وشيَّدَ في ذُرى الدنيا قُصورَا",47,"ر",2,0],["ولو ملَكتْها الغانياتُ بحيلةٍ","لِزنَّ بها جِيدا وحَلَّين مِعصما",48,"م",2,0],["وَلَو مَشَت غِيَرُ الدَهرِ البَراحَ لَهُ","لَحاوَلَت مِن رَداهُ مَطلَباً عَسِرا",49,"ر",2,0],["وَلَو مُنِيَت عَوفُ اِبنُ عَبدٍ بِفَقدِهِم","لَكانَت أَكُفّاً لَم تُعَن بِأَصابِعِ",50,"ع",1,0],["وَلَو مِن عِندِ غَيرِكَ يَبتَغيها","لَعَزَّت عِندَهُ العَنسُ الأَمونُ",51,"ن",1,0],["ولو ملأ المراقبُ منكَ لحظاً","لكادَ من المهابةِ أن يذوبا",52,"ب",2,0],["ولو مت وجداً ما أسفت لمهجتي","ولكنْ عليكم دونها أتاسَفُ",53,"ف",1,0],["ولو ملكت اتّساعا لا تسعت به","على المكارم في التفصيل والجمل",54,"ل",1,0],["وَلَو ماتَ مِنهُم مَن جَرَحنا لَأَصبَحَت","ضِباعٌ بِأَكنافِ الأَراكِ عَرائِسا",55,"س",2,0],["وَلَو مَنَّ لي مَنْ ريْقِهِ بِجُريَعة","عَرَفْتُ بأنَّ المَنَّ أحلى من السَلْوى",56,"و",2,0],["ولو مَلَكَ المُنَى بَلَدٌ","لطَاعَتْكَ خُراسانُ",57,"ن",1,0],["ولو مَنَحوكَ الوُدَّ بالصِّدق لم يكن","لودِّهمُ مِن جهلهمْ بك عاصم",58,"م",1,0],["ولو معهم حبست لكان سهلاً","ولكني حبست مع الدجاج",59,"ج",1,0],["وَلَو مُهِرَت مَهرو عَلى وَصلِ ساعَةٍ","نُجومَ السَماءِ الزُّهرِ قَلَّ لَها المَهرُ",60,"ر",1,0],["وَلَو مسّ حدّ السيفِ رِقراقُ حلمه","إِذاً لَنبا في كفّ مَعمَله ضربا",61,"ب",2,0],["وَلو مسّ حرّ النارِ أَصبَحَ حرّها","سَلاماً وبرداً لا تحسّ له لهبا",61,"ب",2,0],["وَلَو مرّ في جنحٍ منَ اللّيل رأيه","لَوارى سناه الشهب وَاِستنهضَ السربا",61,"ب",2,0],["وَلَو مَلَكتُ عِنانَ الريحِ أَصرِفُها","في كُلِّ ناحِيَةٍ ما فاتَها الطَلَبُ",62,"ب",1,0],["وَلَومك عندي لا يُفيد وَكُله","فُضول اِذا كَرّرته وَتعسف",63,"ف",1,0],["ولو مَلَكتْ كَفّي لوجهي وقايةً","تقدَّمتُ قوماً أُدخِلوا البابَ قُدّامي",64,"م",2,0],["وَلَو مَدَحو أَيّامَ أُنسي بِلَفظَةٍ","فَما ذاكَ إِلّا أَلفُ بِرٍّ مِنَ الدَهرِ",65,"ر",1,0],["وَلَو مَضى الكُلُّ مِنها لَم يَكُن عَجَباً","وَاِنَّما عَجَبي لِلبَعضِ كَيفَ بَقي",66,"ق",2,0],["وَلَو مَسَّ أَنبوب اليَراعِ رأَيته","يُلَبي أَنابيبَ الرِماحِ إِذا دَعى",67,"ع",2,0],["ولو مُكِّنْتُ مما أشتهيه","خَدَمْتُك دون أصحابي بنفسي",68,"س",2,0],["ولو مدّ من نأيَته عنكم يداً","لعاد بحدّ السَّيف أَجْدَعَ أجْذما",69,"م",2,0],["ولو ميّزتَه تمْييز مثلى","لقُلتَ بأنه قد قالَ شَعْرهْ",70,"ه",1,0],["ولو منها قنعت غني","ت بالنزر من الدون",71,"ن",1,0],["ولو ملكتُ سمعَهُ","لقد أطلتُ عذلَهْ",72,"ل",2,0],["ولو مُنعَ الجُبنُ بالسيفِ كان","أحقَّ بضرب الطُّلى الصيقلُ",73,"ل",1,0],["ولو ما أغبّاك الطُّروقَ كفتهما","خلافة جبريلٍ عليك وميكالِ",74,"ل",1,0],["ولو مسحتم زحلاً ببُوعكم","رجوتُ بعدُ لعلاكم مَظهَرا",75,"ر",2,0],["ولو مُكنت من عطفِ المَطايا","لكانَ إلى أبي نَصْرٍ رجوعي",76,"ع",2,0],["ولو مَسَسْتُ حَديداً لانَ لي وغَدا","يُلْوى بِطَيٍّ كَلَيِّ الخَزِّ مُنْجَدِلِ",77,"ل",1,0],["ولو ملأ الدنيا علوماً جليلةً","وسيَّرَ للقرآنِ بيضَ الرَّكائِبِ",78,"ب",1,0],["ولو مَنبِتُ الزّقّومِ يُسْقى بجودِه","لما كان إلّا منبِتَ الوردِ والزّهرِ",79,"ر",1,0],["وَلَو مِمَّن يَقودُ لَهُم","جُنودَ الغزوِ مُحتَفِلا",80,"ل",2,0],["ولو ملَكَت نفسِي زِمامَ اختِيارهَا","لَقَضَيتُ عُمرِي في المدَارِسِ ثَاويا",81,"ي",2,0],["ولو ملَكَتْ من الأمرينِ شيئاً","لما مرّتْ بدُنياها الطُّيُوبُ",82,"ب",1,0],["ولو مدَّ نحوي حادِثُ الدهرِ طَرْفهُ","لحدَّثت نَفْسِي أَنْ أَمُدَّ لَهُ يَدا",83,"د",2,0],["ولو مُتُّ ضَرّاً ما عَقدْتُ قِلادةً","على جيدِ مَنْ لا يستحقُّ لها لُبْسا",84,"س",2,0],["ولو مرّتْ على حلم ابن قيسٍ","لأَضحى وهو كالطفل الرضيع",85,"ع",1,0],["وَلوْ مَزجْتَ بِماءِ المُزْنِ ما اكْتَسَبتْ","مِنْ لُطْفِهِ شِيَمي ما غَصَّ مَنْ شَرِبَا",86,"ب",2,0],["وَلَوْمُ عَوَاذلي في الحُبِّ فِيكُمْ","وَحَقِّكُمُ بِأذْني لا يَجُوزُ",87,"ز",1,0]]}