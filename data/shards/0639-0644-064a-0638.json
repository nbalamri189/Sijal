{"poems":[[55,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[88,"يحييك من أرض الكنانة شاعر","https://www.aldiwan.net/poem68927.html","الطويل"],[37,"عفت غيقة من أهلها فحريمها","https://www.aldiwan.net/poem38833.html","الطويل"],[37,"خليلي إن أم الحكيم تحملت","https://www.aldiwan.net/poem39117.html","الطويل"],[32,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[45,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[30,"تراها إذا صم النهار كأنما","https://www.aldiwan.net/poem5057.html","الطويل"],[21,"ثم لوط أخو سدوم أتاها","https://www.aldiwan.net/poem36138.html","الخفيف"],[7,"عفا ذو حساً من فرتنى فالفوارع","https://www.aldiwan.net/poem1983.html","الطويل"],[19,"صحا قلبه عن سُكره فتأملا","https://www.aldiwan.net/poem356.html",""],[34,"","https://poetry.dctabudhabi.ae/diwan/poem/8237","الطويل"],[102,"استنطاق","https://www.poetsgate.com/ViewPoem.aspx?id=206345",""],[147,"لكم أن تجوروا معرِضين وتغضبوا","https://www.aldiwan.net/poem11720.html","الطويل"],[273,"عن العرب الصيد الألى أحرزوا العلى","https://www.aldiwan.net/poem69132.html","الطويل"],[287,"هب نسيم بالطل مبلول","https://www.aldiwan.net/poem32639.html","المنسرح"],[369,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60658.html","المتقارب"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53919","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53879","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59738","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136104","الطويل"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93090","الطويل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21671","المتقارب"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69407","الطويل"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143012","الخفيف"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87338","الطويل"],[2761,"","https://poetry.dctabudhabi.ae/diwan/poem/45537","الطويل"],[3383,"","https://poetry.dctabudhabi.ae/diwan/poem/34989","الطويل"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46873","المتقارب"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129431","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117844","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85237","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125816","الطويل"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121272","الطويل"],[5031,"شدوُ البلابل","https://www.poetsgate.com/ViewPoem.aspx?id=165139",""],[5212,"سلاماً يا وطني","https://www.poetsgate.com/ViewPoem.aspx?id=212058",""],[592,"لعمرك ما يدري الغبي بأنه","https://www.poetsgate.com/ViewPoem.aspx?id=128805",""],[5365,"وطن المعجزات","https://www.poetsgate.com/ViewPoem.aspx?id=191266",""],[5444,"صفيُّ العِلم","https://www.poetsgate.com/ViewPoem.aspx?id=205525",""],[5725,"سلاماً لا تزور ولا تزارُ","https://www.poetsgate.com/ViewPoem.aspx?id=208671",""],[5956,"أليفٌ رَمْقُكمَ","https://www.poetsgate.com/ViewPoem.aspx?id=183485",""],[6147,"أم الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=151698",""],[6302,"تَلاهِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86230&r=&rc=28",""]],"verses":[["عَلى ظَلماءَ قابِضَةٍ إِلَيهِ","بِلَحظِ المُجتَلي وَيدِ المُشيرِ",0,"ر",1,0],["عَلى ظَهرِها مِن شَرِّ أَطماعِهِم دَمٌ","وَفَوقَ عُبابِ البَحرِ مِن صُنعِهِم دَمُ",1,"م",1,0],["عَلى ظَهرِ حُرجوجٍ يُقَطَّعُ بِالفَتى","نِعافَ الفَيافي سَبتُها وَرَسيمُها",2,"م",3,0],["عَلى ظَهرِ عادِيٍّ تَلوحُ مُتونُهُ","إِذا العيسُ عالَتهُ اِسبَطَرَّت فَعالَها",3,"ل",3,0],["عَلى ظَهرَ جَرعاءِ الكَثيبِ كَأَنَّها","سَنِيَّةُ رَقمٍ في سَراةِ قِرامِ",4,"م",1,0],["على ظهرِ مَرْتٍ ليس فيه مُعرَّجٌ","ولكنْ مَخَبٌّ للركاب ومَسْعَمُ",5,"م",1,0],["عَلى ظُهورِ الإِبِلِ الأُبّالِ","فَقَد بَلَغتَ غايَةَ الآمالِ",6,"ل",1,0],["عَلى ظَهرِ عادِيٍّ كَأَنَّ مُتونَهُ","ظُهورُ لَأىً تُضحي قَياقِيُّهُ حُمرا",7,"ر",2,0],["عَلى ظَهرِ جَونٍ لَم يُعَدَّ لِراكِبٍ","سَراهُ وَغيمٍ أَلبَسَ الماءَ داجِيا",8,"ا",1,0],["عَلى ظَهرِ مِبناةٍ جَديدٍ سُيورُها","يَطوفُ بِها وَسطَ اللَطيمَةِ بائِعُ",9,"ع",1,0],["عَلى ظَهرِ صَفوانٍ كَأَنَّ مُتونَهُ","عُلِلنَ بِدُهنٍ يُزلِقُ المُتَنَزِّلا",10,"ل",2,0],["عَلى ظَهرِ مَرهوبٍ كَأَنَّ نَشوزَهُ","إِذا جازَ هُلّاكُ الطَريقِ رُقودُ",11,"د",1,0],["على ظهره يأتون من كل موقعٍ","ويذكون عنه ريحه، وهو خامد",12,"د",1,0],["عَلى ظَهرِهِ وِقرٌ وَفي عَينِهِ قَذىً","وَفي سَمعِهِ وَقرٌ وَفي فِيهِ إِثلِبُ",13,"ب",1,0],["عَلى ظَهرِها لَم يَخلقِ اللَهُ أُمَّةً","تُناسِبُهُم في خصلَةٍ أَو تُلابِسُ",14,"س",1,0],["عَلى ظُبى السَّيفِ حُمرَةٌ شَهِدَت","يا صاحِ أَنَّ الزِنجِيَّ مَقتولُ",15,"ل",1,0],["على ظَهْرِها وقَف الصّاحبُ ال","أجَلُّ على المشهدِ المُحترَم",16,"م",1,0],["على ظُلم الورى أبداً مُصِرٌّ","وفي إبداء عوْرَتِهمْ دَؤُوبُ",17,"ب",1,0],["على ظهر مركوبٍ يُبارِي إذا جرى","بخِفَّتِه ريحَ الصَّبَا حينَ تَنْفَحُ",18,"ح",1,0],["على ظلال من عناية يوسف","ودوني حسام للخلافة مرهف",19,"ف",1,0],["على ظمأ قد كان يا صاحبي شربي","فيا حبذا المشروب للروح والقلب",20,"ب",1,1],["عَلَى ظُباتِ المُرهَفاتِ وَالقنا","وَكُلُّ خِلٍّ أستَلِذُّ وَصلَهُ",21,"ه",1,0],["عَلَيَّ ظِلا مِن نَعِيمٍ قَد ضَفَا","هُمَا اللَّذَانِ كَلَّفَانِي الرِّحَلا",21,"ل",2,0],["على ظالميكم لعنة إثر لعنةٍ","من الله ماكرت جيوش الغياهب",22,"ب",1,0],["عَلى ظَبيَةٍ مُغزِلٍ أَشرَفَت","لِخَشفٍ لَها لَم يُلِحها اِرتَغاثا",23,"ث",2,0],["عَلى ظَهرِ مَدمُوجِ المَرافِقِ سابِحٍ","عَلى أَربَعِ مُلدٍ تَطُولُ القَنا المُلدا",24,"د",2,0],["على ظهر أفعى تلتوي في توثب","وتمتد، أو تلتفُّ، أو تتحسَّسُ",25,"س",1,0],["على ظَهرِ مُعتَدٍّ مِنَ الساج هَلَّلَتْ","عليهِ المسا والصبحَ سَبعُ العشاير",26,"ر",1,0],["عَلى ظَهرِ مَحبوكٍ كَأَنَّ عِنانَهُ","أَنافَ بِهِ جِذعٌ بِقُرّانَ مُشنَقُ",27,"ق",1,0],["عَلى ظَهرِ مَحبوكِ القَرا مُتَمَطِّراً","إِلى فِتيَةٍ بيضِ الوُجوهِ مباهِجِ",28,"ج",1,0],["على ظَاهِرِي مَشْعَرٌ بالذُّبولِ","وفِي باطِنِي مِسْعرٌ للذُّبَالِ",29,"ل",1,0],["على ظمأ أرجو الفرات وإنني","أصد ولو مس الظمآء عن الوشل",30,"ل",1,0],["على ظالمي آل الرسول وهم هم","لعاين ما لبى الحجيج وكبرا",31,"ر",2,0],["على ظهر قباء الكلى لا يربيها","حفا حزن منجاة قفر منكد",32,"د",1,0],["على ظهره لاحت ذكاء منيرة","بأضوائها والأبلج الحق نورها",33,"ر",3,0],["على ظاهري صبرٌ كنَسجِ العناكِبِ","وفي باطنى همٌّ كلَدغِ العقاربِ",34,"ب",1,1],["عَلَى ظَهْرِ الُحرُوفِ سَرَجْتُ حِبري","أناشِيْداً يُرَتّلُها (الخَلِيْلُ)",35,"ل",1,0],["على ظُلْمٍ وَقَومُ الظُّلمِ في بَلَدي","كَداءٍ إِنْ أَصابَ الجِّسْمَ اَنْصَرَعا",36,"ع",2,0],["على ظهرها من معبد لذوي الردى","ومشهد كفر غيه قد تعظما",37,"م",2,0],["على ظهرِ البُراقِ ركبتَ خيراً","فأكملْ رسمَ ضحكتِنا سحابَا",38,"ب",2,0],["على ظلالٍ ل(بيت الفاجةِ) اتسعت","بذي علومٍ وأخلاقٍ وإجلال2",39,"ل",1,0],["على ظبيٍ يدس العشق شذرا","بواهي العقد فأنتحر المحارُ",40,"ر",1,0],["على ظمئي ، وأرجوكمَ ثُغاءاً","جميلاً قَدْ تُسَرُّ به ( رفاهُ )",41,"ا",2,0],["على ظهر علْجيّ طبعْنا وسامنا","وصحنا:هنا مصرٌ فمَنْ ذا يغالب؟",42,"ب",1,0],["على ظمأ تحومُ .. فَهل تَنَدَّى","إذا سكَّنْتُها شَفَتي كَمَا هِيْ؟!",43,"ا",3,0]]}