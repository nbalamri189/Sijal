{"poems":[[53,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[86,"يحييك من أرض الكنانة شاعر","https://www.aldiwan.net/poem68927.html","الطويل"],[35,"عفت غيقة من أهلها فحريمها","https://www.aldiwan.net/poem38833.html","الطويل"],[35,"خليلي إن أم الحكيم تحملت","https://www.aldiwan.net/poem39117.html","الطويل"],[30,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[43,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[28,"تراها إذا صم النهار كأنما","https://www.aldiwan.net/poem5057.html","الطويل"],[21,"ثم لوط أخو سدوم أتاها","https://www.aldiwan.net/poem36138.html","الخفيف"],[7,"عفا ذو حساً من فرتنى فالفوارع","https://www.aldiwan.net/poem1983.html","الطويل"],[19,"صحا قلبه عن سُكره فتأملا","https://www.aldiwan.net/poem356.html",""],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8237","الطويل"],[141,"لكم أن تجوروا معرِضين وتغضبوا","https://www.aldiwan.net/poem11720.html","الطويل"],[266,"عن العرب الصيد الألى أحرزوا العلى","https://www.aldiwan.net/poem69132.html","الطويل"],[280,"هب نسيم بالطل مبلول","https://www.aldiwan.net/poem32639.html","المنسرح"],[362,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60658.html","المتقارب"]],"verses":[["عَلى ظَلماءَ قابِضَةٍ إِلَيهِ","بِلَحظِ المُجتَلي وَيدِ المُشيرِ",0,"ر",1,0],["عَلى ظَهرِها مِن شَرِّ أَطماعِهِم دَمٌ","وَفَوقَ عُبابِ البَحرِ مِن صُنعِهِم دَمُ",1,"م",1,0],["عَلى ظَهرِ حُرجوجٍ يُقَطَّعُ بِالفَتى","نِعافَ الفَيافي سَبتُها وَرَسيمُها",2,"م",3,0],["عَلى ظَهرِ عادِيٍّ تَلوحُ مُتونُهُ","إِذا العيسُ عالَتهُ اِسبَطَرَّت فَعالَها",3,"ل",3,0],["عَلى ظَهرَ جَرعاءِ الكَثيبِ كَأَنَّها","سَنِيَّةُ رَقمٍ في سَراةِ قِرامِ",4,"م",1,0],["على ظهرِ مَرْتٍ ليس فيه مُعرَّجٌ","ولكنْ مَخَبٌّ للركاب ومَسْعَمُ",5,"م",1,0],["عَلى ظُهورِ الإِبِلِ الأُبّالِ","فَقَد بَلَغتَ غايَةَ الآمالِ",6,"ل",1,0],["عَلى ظَهرِ عادِيٍّ كَأَنَّ مُتونَهُ","ظُهورُ لَأىً تُضحي قَياقِيُّهُ حُمرا",7,"ر",2,0],["عَلى ظَهرِ جَونٍ لَم يُعَدَّ لِراكِبٍ","سَراهُ وَغيمٍ أَلبَسَ الماءَ داجِيا",8,"ا",1,0],["عَلى ظَهرِ مِبناةٍ جَديدٍ سُيورُها","يَطوفُ بِها وَسطَ اللَطيمَةِ بائِعُ",9,"ع",1,0],["عَلى ظَهرِ صَفوانٍ كَأَنَّ مُتونَهُ","عُلِلنَ بِدُهنٍ يُزلِقُ المُتَنَزِّلا",10,"ل",2,0],["عَلى ظَهرِ مَرهوبٍ كَأَنَّ نَشوزَهُ","إِذا جازَ هُلّاكُ الطَريقِ رُقودُ",11,"د",1,0],["عَلى ظَهرِهِ وِقرٌ وَفي عَينِهِ قَذىً","وَفي سَمعِهِ وَقرٌ وَفي فِيهِ إِثلِبُ",12,"ب",1,0],["عَلى ظَهرِها لَم يَخلقِ اللَهُ أُمَّةً","تُناسِبُهُم في خصلَةٍ أَو تُلابِسُ",13,"س",1,0],["عَلى ظُبى السَّيفِ حُمرَةٌ شَهِدَت","يا صاحِ أَنَّ الزِنجِيَّ مَقتولُ",14,"ل",1,0],["على ظَهْرِها وقَف الصّاحبُ ال","أجَلُّ على المشهدِ المُحترَم",15,"م",1,0]]}