{"poems":[[23,"أهاجك بالبيداء رسم المنازل","https://www.aldiwan.net/poem21249.html","الطويل"],[87,"إثن عنان القلب واسلم به","https://www.aldiwan.net/poem63782.html","السريع"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[215,"أجبني إن تفضلت","https://www.aldiwan.net/poem46344.html","مجزوء الوافر"],[275,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[369,"سبى مني الفؤاد لحاظ فاتن","https://www.aldiwan.net/poem60611.html","الوافر"],[398,"أيعسوب دين الله صنو نبيه","https://www.aldiwan.net/poem53623.html","الطويل"],[398,"لقد رحلت سعدى فهل لك مسعد","https://www.aldiwan.net/poem53688.html","الطويل"],[422,"دعاه إلى الهوى داعي التصابي","https://www.aldiwan.net/poem54151.html","الوافر"],[447,"أرى بدرا فصار به هلالا","https://www.aldiwan.net/poem14472.html","الوافر"],[622,"","https://poetry.dctabudhabi.ae/diwan/poem/130717","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59430","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128717","الوافر"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113756","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109333","الوافر"],[2371,"","https://poetry.dctabudhabi.ae/diwan/poem/142612","الوافر"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76057","الوافر"],[3242,"","https://poetry.dctabudhabi.ae/diwan/poem/124094","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62746","الوافر"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45741","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205965","المجتث"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117845","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119603","الوافر"],[1012,"لقد دارت على رغم الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=124956",""],[4961,"النصفُ الثاني للإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=33329",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[5587,"سيد الثقلين","https://www.poetsgate.com/ViewPoem.aspx?id=193801",""],[5870,"مشوارٌ صَغير","https://www.poetsgate.com/ViewPoem.aspx?id=60862",""],[6102,"قافية خضراء","https://www.poetsgate.com/ViewPoem.aspx?id=184629",""]],"verses":[["وَفي أُحُدٍ يَومٌ لَهُم كانَ مُخزِياً","نُطاعِنُهُم بِالسَمهَرِيِّ الذَوابِلِ",0,"ل",1,0],["وَفي اِحتِشامِ الأُسدِ دونَ القَذى","إِذا هِيَ اِضطُرَّت إِلى شُربِهِ",1,"ب",2,0],["وفي أُحُدٍ رُؤيا النبيِّ تعبّرت","رَأى بَقراً فيها فعبَّرَها بقرا",2,"ر",2,0],["وفيّاً حافظاً أشقى","ليسعدَ ناقضُ العهد",3,"د",1,0],["وفي احتقاري لمن دوني أرى ظفراً","هذا افتخاري على من ذمَّ أو عابا",4,"ب",2,0],["وفي أَحَدِ الهوادجِ بَدْرُ تمٍ","ففي أَنوارِه تَسْري الظَّعائن",5,"ن",1,0],["وَفي أُحُدٍ لَمّا أَتَيتَ وَبَعضُهُم","وَان سَأَلوا صَرَّحتُ أَسوانُ هارِب",6,"ب",1,0],["وَفي أُحُدٍ َلّى رِجالٌ وَسيفُهُ","يُسَوِّد وَجهَ الكُفرِ وهو يُسَوَّدُ",7,"د",1,0],["وفي أحشائه وجدٌ كمينٌ","يعذّبه بأنواع العذاب",8,"ب",1,0],["وفي أحداج آل بني هلال","سرى قمرا وأشمس لي هلالا",9,"ل",2,0],["وفي أحزابهِ هَتَّانُ سِرٍّ","تَجُودُ بهِ سُحبُ الوِصالِ",10,"ل",1,0],["وفي أحد قد وحد النصر دينه","فعززا إسلام وذل صيلب",11,"ب",1,0],["وفي أحد يد الإسلام طالت","وبات الشرك مغلول اليدين",12,"ن",1,0],["وفي أحُدٍ أحذى ابنَ جَحسٍ عسيبَهُ","فأضحى حُساماً قاطعَ القَطعِ",13,"ع",1,0],["وفي أحشائهم للحقد نار","يكاد ضرامها يشوى البطونا",14,"ن",2,0],["وفي أحزانه أمشي كليما","وفي عبراته الحرّى اضطرابي",15,"ب",2,0],["وَفي أَحداجِهِم قَمرٌ تَبدّى","فَقَد خَفِيت لِمطلعِهِ النُجومُ",16,"م",1,0],["وفي أحد وفي حملات بدرٍ","وحرب بني قريظة والنضير",17,"ر",1,0],["وفي أحْشائِنا منها نُجومٌ","وفي آذانِنا منها شُنوفُ",18,"ف",1,0],["وَفي أُحد وَجد وَما حَولَ يَثرب","فَسَفح اللَوى نَحوَ اللوا كَالمُراقب",19,"ب",1,0],["وفي احتفال ختان","وفي احتفال قِرَانِ",20,"ن",1,0],["وفي احتفال نجاح","يجوز كل امتحانِ",20,"ن",1,0],["وفي أحد أبلى تجاه ابن عمه","وفل صفوف الكفر بعد التئامها",21,"م",3,0],["وفي أُحُدٍ به كان ائتسانا","فيا بشرى لنا يوم المعاد",22,"د",1,0],["وفي إحدى وعشرين الجمادى","الأخيرة فتح ذا القصر المشيد",23,"د",1,0],["وفي أحلى المبادئ ِ كلُّ جودٍ","تفرَّعَ منكِ أوراقاً وغصنا",24,"ن",2,0],["وفي احاديثه ذكرى وموعظة","فكل لفظ من الالفاظ قنديل",25,"ل",1,0],["وَفِي أَحْمَدٍ وَهْجُ العُلُومِ تَأَلُّقٌ","هُوَ المِسْكُ فِي الدُّنْيَا وَ غَارٌ وَعَوْسَجُ",26,"ج",1,0],["وَفِي أحَدِ المَسَاءَاتِ","عَلَى دَرَّاجَتِي الأشهَر",27,"ر",1,0],["وَ فِي أَحْرُفِي كَمْ مِنْ جِبَالٍ نَسَفْتُها","أَيَصْمُدُ فِي وَجْهِي - ثَبَاتًا - جِدارُها ؟",28,"ر",3,0]]}