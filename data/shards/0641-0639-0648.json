""],[4929,"جزء من قصيدة ملحمة النبوة","https://www.poetsgate.com/ViewPoem.aspx?id=199886",""],[4981,"نداءٌ من لغتنا","https://www.poetsgate.com/ViewPoem.aspx?id=190503",""],[5061,"افضفض للفضاء","https://www.poetsgate.com/ViewPoem.aspx?id=147185",""],[5216,"موعد","https://www.poetsgate.com/ViewPoem.aspx?id=187647",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5459,"ازرع الخير","https://www.poetsgate.com/ViewPoem.aspx?id=198569",""],[5612,"إلى الرّحمنِ أضْرَعُ في الكُروبِ","https://www.poetsgate.com/ViewPoem.aspx?id=179483",""],[5725,"تداعى علينا القوم","https://www.poetsgate.com/ViewPoem.aspx?id=177466",""],[5736,"لا قانون .. لا منطق","https://www.poetsgate.com/ViewPoem.aspx?id=208194",""],[5853,"عودي لأجلي","https://www.poetsgate.com/ViewPoem.aspx?id=175621",""],[5956,"تعال نحترق","https://www.poetsgate.com/ViewPoem.aspx?id=182069",""],[5956,"على زنديك","https://www.poetsgate.com/ViewPoem.aspx?id=184495",""],[5956,"سَقامٌ وبيلٌ بعادكِ عني","https://www.poetsgate.com/ViewPoem.aspx?id=193938",""],[5956,"مناجاةُ أبٍ موَسوَسٍ على ابنته العُزَّى","https://www.poetsgate.com/ViewPoem.aspx?id=207206",""],[6031,"مَا بَالُ عينِكَ لا تَجُودُ بِمَائِهَا","https://www.poetsgate.com/ViewPoem.aspx?id=46293",""],[6052,"شيخ القضية احمد","https://www.poetsgate.com/ViewPoem.aspx?id=35211",""],[6102,"معاذ الله","https://www.poetsgate.com/ViewPoem.aspx?id=185059",""],[6102,"هَشِيمُ الهَجر !!","https://www.poetsgate.com/ViewPoem.aspx?id=185298",""],[6120,"أَيَحسَبُ أَنَّنِي كَلِفٌ عَلَيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=213525",""],[6120,"هَجَرتِ الفُؤَادَ سِنِينًا طوَالْ","https://www.poetsgate.com/ViewPoem.aspx?id=214820",""],[6134,"احفظ ودادك في فؤادك كامناً","https://www.poetsgate.com/ViewPoem.aspx?id=169570",""],[520,"أراجعة لي عيشة الزمن النضر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577522",""],[6223,"طارقة السحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1216&r=&rc=1",""],[6277,"على الأطلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64490&r=&rc=53",""]],"verses":[["فَعَوداً إِلى الحِلمِ الَّذي أَنتَ أَهلُهُ","فَمِثلُكَ بِالإِحسانِ بادٍ وَعائِدُ",0,"د",1,0],["فَعُوجِلُوا بِالرَّدَى فِي نَكْبَةٍ عَمَمٍ","تَخَرَّمَتْهُمْ وَمَا كَانَتْ بِحِسْبَانِ",1,"ن",1,0],["فَعودُكَ مِن خُدَعٍ مورِقٍ","وَواديكَ مِن عِلَلٍ مُخصِبُ",2,"ب",1,0],["فعوّذوني دونه بالرّقى","أو بخِّروني بالحصى والكلخ",3,"خ",1,0],["فعودوا كما عاد الوزير لظامئٍ","دعا برّه المعهود فانهلّ يسجم",4,"م",1,0],["فعولت منكم هناك على","فاتِقِ أحوالها وراتقها",5,"ق",3,0],["فَعُوِّضَ سَيفُ الدَولَةِ الأَجرُ إِنَّهُ","أَجَلُّ مُثابٍ مِن أَجَلِّ مُثيبِ",6,"ب",1,0],["فعود الطفل يسي","ر النار لا يحترقِ",7,"ق",1,0],["فَعَوِّض مِنهُ جاهاً أَرتَضيهِ","وَمِثلُكَ عِندَهُ العِوَضُ الخَطيرُ",8,"ر",1,0],["فعُودوا ليَحتلَّ النَّدى في خِلالِها","ويرحلَ لؤمٌ حلَّها ولِئامُ",9,"م",1,0],["فعوَّضَني من الأُنسِ انحرافاً","وبدَّلَني من البِشْرِ ازوِرارا",10,"ر",2,0],["فعوّضْتُ شيباً من شبابي كأنّني","تَوَلّيتُ عن ظلٍّ برغمي إلى الشمسِ",11,"س",1,1],["فَعوجا صُدورَ الأَرحَبِيِّ وَأَسهِلا","بِذاكَ الكَثيبِ السَهلِ وَالعَلَمِ الفَردِ",12,"د",1,0],["فَعودي إِلَيها فَقولي لَها","مَساءُ غَدٍ لَكُمُ مَوعِدُ",13,"د",1,0],["فعودوا إلى عامٍ من الخصبِ صالحٍ","ولا تقربوا الهيجاءَ فالقومُ أصلال",14,"ل",1,0],["فَعُودِي صُلْبٌ لا يَلِينُ لِغَامِزٍ","وَقَلْبِيَ سَيْفٌ لا يُفَلُّ لَهُ حَدُّ",15,"د",1,0],["فعوّذتها وقالت: كنت أشبهها","لكن لكل طويل يا ابنتي طرف",16,"ف",1,0],["فَعول وَلَكن لَيسَ يَدعى بِفاعل","قَؤُول وَلَكن لَيسَ بِالمُتَكَلم",17,"م",1,0],["فعوجا عليها واعذراني في الأسى","وإن لم تعوجا فاقبلاَ العذرَ منيا",18,"ي",2,0],["فَعُوِّضتُ مِن ذُلِّ المَطامِعِ عِزَّةً","وَمِن خيفَةٍ أَمناً وَمِن عَدَمٍ وَجدا",19,"د",2,0],["فعوق عنه الحادثات مثيرها","ونماه حتى عاد أضعاف ما بدا",20,"د",2,0],["فعودوا إِذا شئتم وإن شئتم انتهوا","فقد وهب الأولى ولا عفو بعدما",21,"م",2,0],["فَعودوا يَعُد فهوَ الكريمُ وإنّه","إِذا اِعتذرَ الجاني لهُ يقبلُ العُذرا",22,"ر",2,0],["فَعولن فَعولن فَعولن فعولُ","تقاربَ حيثُ نأَى جبرئيلُ",23,"ل",1,0],["فَعولن مَفاعيلن فَعولن مفاعلُ","طويلُ نجادِ السيف أروع باسلُ",24,"ل",1,0],["فعُوا ما قرأتْ عيني","فإنَّ كتابها الصدرُ",25,"ر",1,0],["فعودي يا صروف الدهر عودي","مولولة الزئير كما عهدتُ",26,"ت",1,0],["فعوّضنا من التبريج صفواً","ومن صور الخشونة بالرقيق",27,"ق",1,0],["فعوضنا من التبريح صفواً","ومن صور الخشونة بالرقيق",28,"ق",1,0],["فَعُوجا على أَرِجٍ مُونِقٍ","أنيقِ الدَّسَاكِر مِعْشابِها",29,"ب",3,0],["فعوّجتَ من أمره ما استوى","وكدّرت من عيشه ما صفا",30,"ا",1,0],["فعوجا على أفيائه وعيونه","وما سال منها فوق تلك الأباطح",31,"ح",1,0],["فعودي بإيمانٍ يكن لكِ موطنٌ","وإلا انتهى في الحفرةِ السّ عدُ والنحس",32,"س",1,0],["فعودوا إلى عهد الفتوحِ التي بها","بَنيتم على الإسلامِ أضخمَ دولة",33,"ه",1,0],["فعو حَوابي علي آثار لَيلى","فَم يَدري الغعَريب مَتى يَعود",34,"د",1,0],["فَعُوِّضْتُ بَعْدَ الْحَنِينِ الأَنِينَ","وَبُدِّلْتُ بَعْدَ الْجَوى بِالسَّقامِ",35,"م",1,0],["فعود جسمي ذاو من تذكره","فكيف ينعم فرع أصله انجعفا",36,"ف",2,0],["فعوقتهم مقادير مقدرة","محتومها ماله دفعت ولا راد",37,"د",1,0],["فَعوجَ مِنّي المُستَقيمُ بِجورِهِ","وَأَجلَسَني مِن فَوقِ تِلكَ المَسانِدِ",38,"د",1,0],["فَعَوَّضوا بَعدَ طولِ الكَدِّ بِالقَفلِ","وَأَصبَحوا في مَدارٍ كُلَّما اِحتَمَلوا",39,"ل",3,0],["فَعَوَّضَ العينَ السّهَر","لمّا رأَى أُنْسي نَفَر",40,"ر",1,0],["فَعوَّضَ من أعلامِه بأهلّةٍ","طلَعْنَ عليه يومَ مَوكبِه تَتْرى",41,"ر",2,0],["فعَوالي الآراء منه نُجومٌ","بات للمُلْكِ كلّهنّ سُعودا",42,"د",2,0],["فعوِّلْ على خَلَّتَيْنِ اثنَتَ","يْنِ خَرْقِ الحُسامِ ورِفْقِ القَلَمْ",43,"م",1,0],["فَعَوْدُ عاداتِه بالخَيرِ مبدؤُهُ","إذا عدا عادةً مِن عادِهَا عادي",44,"د",2,0],["فعوانَ فالركمايِ فالحبلِ الذي","فيه المَغَاصُ فما حوى من دُرَّةِ",45,"ه",1,0],["فَعَوَّضَ منكِ فِي مثواه بِرِّي","وأذْهَلَ عنكِ فِي مثواهُ نُزْلي",46,"ل",2,0],["فعوَّضتُموهُ عن تداني مزارِكمْ","بِعاداً لقد خابَ الذي كانَ يأمُلُه",47,"ل",2,0],["فعوضه بابن ثلاثة أخوة","وقد يستفاد الربح من موضع الخسر",48,"ر",1,0],["فَعوجا فَاِنظُر اتبين عَمّا","سَأَلناها بِهِ ام لا تَبين",49,"ن",1,0],["فَعَوِّذ بها مِنِّي فُؤاداً أصابَهُ","على حَذَرٍ مِن نَفثِ أجفانِه سِحرُ",50,"ر",1,0],["فعوِّلوا بعدي عليهِ ولا","تَبغوا سرابَ المهمِهِ الجاري",51,"ر",2,0],["فعودوا أمام الدهر صفّاً وأدركوا","بلادكم من قبل أن تنفذ السهم",52,"م",1,0],["فعودوا إلى العب الضعيف بنظرة","بها عنه يوم البعث يعفى ويرحم",53,"م",1,0],["فَعَوى فَطارَ النَوم مِن عَين الكِلا","بِ وَأَقبَلوا مِن كُل فَج أَعمَق",54,"ق",1,0],["فعوَّضتها ليل الصبابة بالسرى","وأنس التلاقي بالحبيب المفارق",55,"ق",1,0],["فعوجا على تلك الديار وجددا","عهودي وإن لم ترعيا ذمة العهد",56,"د",1,0],["فعوجي إلى نهج الهداية وارجعي","لمولى كريم قابل التوب واسع",57,"ع",1,0],["فعول إذا ما قال في السلم قائل","فعول إذا ما هتز في النقع لهذم",58,"م",1,0],["فَعَوَّجا ضَمعِجاً فى سيرِها دَفَقٌ","ومِرجما كشِّبيبِ النبع مُبتَذلا",59,"ل",2,0],["فعول على الصدق في كل حال","وخذ ما بدا عنه في كل حق",60,"ق",1,0],["فعوجوا بي إليه فقط ظلمنا","نفوساً حملت حملاً ثقيلا",61,"ل",2,0],["فَعوذ النعمة مِن زَوال","بِكَثرة الإِحسان وَالإجمال",62,"ل",1,0],["فعول عليها في المهمات داعيا","بياء الندا مستهديا متوكلا",63,"ل",2,0],["فَعَوَّضت مِن حُسَينِ الخَيرِ أَو حَسَنٍ","بِالأَرقَطِ اِبنِ أَبيهِ أَو بِعَبّادِ",64,"د",1,0],["فَعُوجا على جَفرِ الهباءةِ عَوجةً","لضيعةِ أعلاقٍ هناك ثَمَاني",65,"ن",2,0],["فعولن مفاعيلن فعولن مفاعلن","على كل من قد رامها تثير",66,"ر",1,0],["فعوجا يا خليلي الذين","هما مني بمنزلة اليدين",67,"ن",1,0],["فعوذني بكتبك من أذاه","فما لي غيرها من راقيات",68,"ت",1,0],["فعوجا بنفسي انتما وبيننا","فخير صحاب المرء من لا يؤنب",69,"ب",1,0],["فعودوا علينا فأنتم كرام","فليس لنا عن هواكم بديل",70,"ل",1,0],["فَعود إِسحق ملغى في تَرنُّمه","وَلحن مَعبَدَ يَجري في تكلمه",71,"ه",1,0],["فَعَواطِفٌ نَشوَى وَوِجدانٌ سَما","وَمَسَرَّةٌ فاضَت بِها الأَحلامُ",72,"م",1,0],["فعوجى على الأرجاء ناق وعرجى","تفوزي بما فيه شفا رجلك العرجا",73,"ج",2,0],["فعولن مفاعيلن مفاعلتن وفا","ع لاتن ذووا الأوتاد أصل بدانقي",74,"ق",2,1],["فعوجا خليلي الغداة بربعها","وقولاشج يشكو النوى وفريق",75,"ق",1,0],["فَعُوِّضْتَ عنها فوق عينيكَ مِثلها","فصوص عمى يا قرمَةَ النار يا جمرى",76,"ر",2,0],["فعودي إليهم ذكّريهم بفضلنا","عليهم تكوني بالوفاء تفضّلت",77,"ت",1,0],["فعودوا رفاقي في الشباب فإنني","لكم بانتظار والقلوب شهود",78,"د",1,0],["فعوجا عليه بالدموع فانما","تحيته منا الدموع الذوارف",79,"ف",1,0],["فعوداً يا ليالي الوصل عوداً","إلى صب بأسر الشوق عاني",80,"ن",2,0],["فعودوا لنصرته مثلما","بدأتهم بنصرته منجدينا",81,"ن",2,0],["فعودتهُ إلى الأوطان فألٌ","بأنّ الشعب قد فكَّ القُيودا",82,"د",2,0],["فعودوا كما شاء الإله أهلّة","تُشيدونَ مِن بُنياننا ما تهدَّما",83,"م",2,0],["فَعودا عَن اللَومِ الَّذي مُهجَتي كَوى","وَرِفقاً بِصَبٍّ جنَّ حُبّاً وَما غَوى",84,"غ",3,0],["فَعُولَةٌ فَعالَةٌ لِفَعُلاَ","كسَهُلَ الأمرُ وَزَيدٌ جَزُلا",85,"ل",2,0],["فعوضوا الدار وزيدوا بها","على ثريا النور مصباحا",86,"ح",2,0],["فعودوا إلى الإسلام واجتنبوا الردى","وإلا فلا يأويكم السهل والوعر",87,"ر",1,0],["فعوض عن شعري بشعر وزاد في","عطاه فهذا رأس مالي وذا ربحي",88,"ح",2,0],["فَعَوَّلَ في شِدَّةِ المَعمَعَه","يَلوذُ بِأَنياسَ يَأتي مَعَه",89,"ه",1,0],["فعول أن يستحث إلى الفت","ك بالبهم إلف أخيل العميد",90,"د",1,0],["فَعوذَتِها بِالفَجرِ مِن شَرِّ كاشِح","وَمِن خَدعِ الواشينَ بِالشَفعِ وَالوَترِ",91,"ر",1,0],["فعودي ليالي الوصل لا طال بيننا","بعد فما أحلى لدينا تقاربه",92,"ب",2,0],["فَعودى يا أَويقاني وَهنى","لَقَد عادَ الهَنا بَعد التَواني",93,"ن",2,0],["فعودوا وداووا باللقاء حشاشتي","لينظركم طَرفي ويجلى بكم صَدري",94,"ر",2,0],["فعودي باللقاءِ عليَّ يوماً","عسى بالعَود إبعادُ المنيَّه",95,"ي",2,0],["فعودا إلى الرحمن فهو الذي به","تقوم معالى الدين في البر والبحر",96,"ر",1,0],["فعُوَّادُه مَلُّوا ومَلَّ أقاربٌ","سياستَهُ ما الحالُ حين تحولُ",97,"ل",1,0],["فَعُولٌ إذا ما قال في الخطب قائل","شديدٌ على الأعدا عزيزٌ مُصَاحبُهْ",98,"ب",2,0],["فعوّدتَ كلا منهما ما تعودا","يراعك ان ابكيته ضحك الندى",99,"د",2,0],["فعودي لأيام الطفولة مرة","ولا تدعي الأحزان تزجيك للفنا",100,"ن",2,0],["فعودي له يا عبلة القلب ليلة","لينشدك المشتاق أشعار عنترة",101,"ر",2,0],["فعُودي سامقٌ يخضرُّ لوناً","وعُودُ الناصبين لنا ضئيل",102,"ل",1,0],["فعولن مفاعيلُنْ مفاعلتن وفا","ع لا تن أُصُولُ السِّت فالعشر ما حوى",103,"ا",1,0],["فَعَوَتْ عَلَيْهَاْ فِي الْجَنُوْبِ 