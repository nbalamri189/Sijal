فيا","https://www.aldiwan.net/poem15185.html","الكامل"],[475,"أراها عن الجزع تبغي عدولا","https://www.aldiwan.net/poem15225.html","المتقارب"],[475,"دمع على عرصات الربيع مسكوب","https://www.aldiwan.net/poem15258.html","البسيط"],[475,"يا أيها البدر الذي ريقه","https://www.aldiwan.net/poem15302.html","السريع"],[477,"لما تعذر أن أكو","https://www.aldiwan.net/poem36887.html","مجزوء الكامل"],[477,"الخفيف","https://www.aldiwan.net/poem36924.html","الخفيف"],[477,"خدمتك أيها المولى بصدق","https://www.aldiwan.net/poem37593.html","الوافر"],[491,"غادني بالصبوح قبل الصباح","https://www.aldiwan.net/poem67400.html","الخفيف"],[496,"أيها المغتر بالزمن","https://www.aldiwan.net/poem3701.html","المديد"],[508,"أزوركم فتكاد الأرض تقبض بي","https://www.aldiwan.net/poem1579.html",""],[512,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[513,"دانت لأمرك طاعة الأقدار","https://www.aldiwan.net/poem12106.html","الكامل"],[525,"وكنت سماء والعجاج سحائبا","https://www.aldiwan.net/poem45975.html","الطويل"],[540,"وصف البدر حسن وجهك حتى","https://www.aldiwan.net/poem34046.html","الخفيف"],[549,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"],[549,"كم للنواظر من دم مطلول","https://www.aldiwan.net/poem47277.html","الكامل"],[549,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[549,"أيا ملك الأملاك قد جاءني الذي","https://www.aldiwan.net/poem47842.html","الطويل"],[549,"كم ذا سرى بالموت عنا مدلج","https://www.aldiwan.net/poem48018.html","الكامل"],[549,"إيابا أيها المولى إيابا","https://www.aldiwan.net/poem48081.html","الوافر"],[561,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[571,"أجيرة بيتي ما لكم بكم السهو","https://www.aldiwan.net/poem3636.html","الطويل"],[573,"لما دعا في الركب داعي الفراق","https://www.aldiwan.net/poem2701.html","السريع"],[573,"أصبحت بعدك في الحياة كفان","https://www.aldiwan.net/poem2773.html","الكامل"],[573,"قلت وقد لج في معاتبتي","https://www.aldiwan.net/poem2874.html","المنسرح"],[573,"وصغير القد همت به","https://www.aldiwan.net/poem2942.html","المديد"],[573,"ويح نفس مغطره","https://www.aldiwan.net/poem2948.html","مجزوء الخفيف"],[573,"تخطو وتخطر بين الحلي والحلل","https://www.aldiwan.net/poem3024.html","البسيط"],[573,"وجنة فوقها عذار أطلا","https://www.aldiwan.net/poem3027.html","الخفيف"],[573,"ما على الدهر بعد رؤياك عتب","https://www.aldiwan.net/poem3096.html","الطويل"]],"verses":[["خَدائِعٌ أُغضي عَلى عِلمِها","لَعَلَّها تَنقَعُ هَذا الأُوام",0,"م",1,0],["خَدٌّ وَخالٌ يُعْشَقانِ كَأَنَّما","نُقِطَتْ بِحبّاتِ القُلوبِ خُدودِ",1,"د",1,0],["خُدَعُ المُنى وخواطِرُ الأوهامِ","أضْغاثُ كاذِبَةٍ منَ الأحْلامِ",2,"م",1,1],["خِدي بي رَعاكِ اللهُ إنَّ أمَامَنا","أغرَّ بهِ في كُلِّ حادِثَةٍ نَسْطو",3,"ط",2,0],["خدَعَ الشّوْقُ فؤادي فانخَدَعْ","أفَلا أقْصَرَ شَيْئاً وارتَدَعْ",4,"ع",1,1],["خَدَعَ اليَراعُ بِها فدَبّجَها","وسَأَلْتُ مُجْتَهِداً عنِ الغَرَضِ",5,"ض",1,1],["خِدَماً رَآهَا بِالْعِيَانِ حَمِيدَةً","وَالْمَوتُ يَخْطُرُ مِنْ ظُبىً لِسِنَانِ",6,"ن",1,0],["خَديمَةٌ منْ بَناتِ الرّومِ واقِفَةٌ","رَفَعْتُ منْ فَوْقِ رأسي بِنْتَ مَوْلاتي",7,"ت",2,0],["خَدَما رُبوعَ النيلِ في عَهدَيهِما","وَالطِبُّ نَبتٌ لَم يَجُدهُ غَمامُ",8,"م",1,0],["خِدرانِ لِلضادِ لَم تُهتَك سُتورُهُما","وَلا تَحَوَّلَ عَن مَغناهُما الأَدَبُ",9,"ب",1,0],["خَدُّكَ ذا الأَشعَرِيُّ حَنَّفَني","فَقالَ مِن أَحمَدِ المَذاهِبِ لي",10,"ل",2,0],["خَدَت فيهِ بِرَحلي ذاتُ لَوثٍ","مِنَ العيدِيِّ ناجِيَةٌ ذَمولُ",11,"ل",1,0],["خَدَا فَأَدْرَكَ قَبْلَ الأَوَ","انِ شَأْوَ طُمُوحِهْ",12,"ح",2,0],["خِدمَةُ الضَيفِ وَكَأسٌ لَذَّةٌ","وَنَديمٌ وَفَتاةٌ وَغِنا",13,"ا",1,0],["خِدَبُّ الشَوى لَم يَعُد في آلِ مُخلِفٍ","أنِ اِخضَرَّ أَو أَن زَمَّ بِالأَنفِ بازِلُه",14,"ل",2,0],["خِدالاً قَذَفنَ السورَ مِنهُنَّ وَالبَرى","عَلى ناعِمِ البَردِيِّ بَل هُنَّ أَخدَلُ",15,"ل",1,0],["خُدوداً جفَتَ في السَيرِ حَتّى كَأَنَّما","يُباشِرنَ بالمَعزاءِ مَسّ الأَرائِكِ",16,"ك",1,0],["خِدالُ الشَوى نِصفانِ نِصفٌ عَوانِسٌ","وَنِصفٌ عَلَيهِنَّ الشُفوفُ مَعاصِرُه",17,"ر",2,0],["خِدَبٍّ حَنا مِن ظَهِرهِ بَعَدَ بدنِهِ","عَلى قُصبِ مُنضَمِّ الثَميلَةِ شازِبِ",18,"ب",1,0],["خدلة ساقها مهفهفة الخًص","ر كعاب براقة سيفانه",19,"ن",2,0],["خدود جرى ماء الشبية فوقها","ففيه عقول الناظرين من الغرقى",20,"ق",2,0],["خِداع لا يراه ذووه شَيْناً","ولا يُمسي به أحد مَشِينا",21,"ن",2,0],["خِدنُ الوَفاءِ وَلا وَفِيٌّ غَيرَهُ","يَرضى أُعاني ضيقَ حالَةِ عانِ",22,"ن",1,0],["خدمتكَ مدَّاحاً فلمْ لا أرى الغنى","وبرُّك موصولٌ فلمْ لا أشبّب",23,"ب",1,0],["خدَمتك من فلك الثناء الدائر","غرَرُ النجوم بكل معنًى باهر",24,"ر",1,1],["خدّك بالورد من حشاه ومن","بمسكِ هذا العذار قد نقشه",25,"ش",2,1],["خدمته حتَّى أنجم مرِّيخها","لو عاد كسرى ظنَّه سيَّافَهُ",26,"ف",2,0],["خدٌّ يريك تنعماً وتلهباً","يا من رأى الجنات في النيران",27,"ن",1,0],["خِدْنُ أبي المُسْتَهِلِّ خبَّرني","عنْ جُوده في الورى بِحُرْمَتِهِ",28,"ت",2,1],["خَدَّانِ فينا لظى حريقهما","ونوره فيهما بلا وهجِ",29,"ج",1,0],["خِدْنَيْ شبابٍ إذا تقضَّى","أعادَهُ المبْدىءُ المعِيدُ",30,"د",1,0],["خَدَّ في الأرض حين خدَّدْتَ في الها","م بِبِيض صوارمٍ تَخْديدَكْ",31,"ك",1,0],["خُدعة ثم فزعةٌ إن هذا","لحقيق بكثرة الرُّفّاض",32,"ض",1,0],["خدعتُك وانخداعك لي خليقٌ","على الله الزيادةُ والتمامُ",33,"م",1,0],["خُدِعتُ بِها وَالحُرُّ سَهلٌ خِداعُهُ","فَلا طالِعي يُمن وَلا كَوكَبي سَعدُ",34,"د",1,0],["خَدَعوكِ بِالقَولِ المُحا","لِ فَصَحَّ أَنَّكِ أُمُّ عامِر",35,"ر",1,0],["خِدالَ الشَوى غيدِ السَوالِفِ بِالضُحى","عِراضَ القَطا لا يَتَّخِذنَ الرَفائِعا",36,"ع",2,0],["خدٌّ كنُوار الربيع مورد","ونواظرٌ دعج وجيد أتلع",37,"ع",1,0],["خدعوها بقولهم حسناء","شعرها الليل والجبين ذُكاء",38,"ا",2,1],["خَدَمَتهُ عُمراً مِثلَما","قَد ساءَ صِدقاً وَاِستِقامَه",39,"م",2,0],["خَدَموا حِمى الوَطَنِ العَزيزِ فَبورِكوا","خَدَماً وَبورِكَ في الحِمى مِن سَيِّدِ",40,"د",1,0],["خَدَعَت حَبائِلُك المِلاحَ هُنَيَّةً","وَاليَومَ كُلُّ حِبالَةٍ لا تَعلَقُ",41,"ق",1,0],["خَدَعوها بِقَولِهِم حَسناءُ","وَالغَواني يَغُرُّهُنَّ الثَناءُ",42,"ا",2,1],["خَدَعَ العُيونَ وَلَم يَزَل","حَتّى تَحَدّى اللامِسين",43,"ن",1,0],["خَدٌّ سوادُ الصُّدْغِ من فوقهِ","قد صبغتْهُ يدُ صبَّاغِهِ",44,"ه",1,1],["خدمتكُمُ والعمرُ غَضٌّ جميمُهُ","نَدٍ وأهاضيبُ الشبيبةِ نُضَّخُ",45,"خ",1,0],["خَدٌ يُعَضُّ لِحُمرَةٍ","تُفّاحُهُ وَيُشَمُّ وَردُه",46,"د",2,0],["خُدِعوا عَنِ الشَرَفِ المُقيمِ تَظَنِّياً","مِنهُم بِأَنَّ الواهِبَ المَخدوعُ",47,"ع",1,0],["خَدٌّ أَسيلٌ وقَوامٌ أَهيَفُ","فصاحباهُ فِتْيَةٌ وقَرقَفُ",48,"ف",1,0],["خُدِعتَ عَنِ الساعاتِ حَتّى غُبِنتَها","وَغَرَّتكَ أَيّامٌ قِصارٌ وَأَشهُرُ",49,"ر",1,0],["خَدّاعَةٌ بِغُرورِها","وَبِنَقضِها وَبِفَتلِها",50,"ل",3,0],["خَدَعَتنا الآمالُ حَتّى طَلَبنا","وَجَمَعنا لِغَيرِنا وَسَعَينا",51,"ن",2,0],["خَدَمتُكُمُ فَما أَبقَيتُ جُهداً","وَلا أَطمَحتُ بِالأَطماحِ طَرفي",52,"ي",1,1],["خِدمَتي في الهَوى عَليكُم حَرامُ","كَيفَ أَشقى بِكُم وَأَنتُم كِرامُ",53,"م",1,1],["خَدُّهُ بِاللَفظِ لا ال","لَحظِ يَدمى",54,"م",2,0],["خَدٌّ يُقِرِّ بِقَتلي","وَرِدفُهُ يَتَبَرّى",55,"ر",2,0],["خَدَمَتَهُ البيضُ الحِدادُ وَإِب كا","نَ صَبِياً كَمِبضَعِ الفَصّادِ",56,"د",1,0],["خَدٌّ بِلُطفِ النَعيمِ قَد صُقِلا","كَأَنَّهُ مِن دَمي إِذا خَجَلا",57,"ل",2,0],["خَدَعَتنا مُقلَتاهُ خدعتنا","وجنتاهُ خدعتنا شَفَتاه",58,"ه",1,0],["خداعةُ الصبّ بالآمالِ مرسلةٌ","إليّ بالعضّ في التفّاحِ والقُبَلِ",59,"ل",1,0],["خَدَعَ الظلامَ وكان من لمعانه","مِسْبَارُه وحُسَامُهُ ونجيعُهُ",60,"ع",2,0],["خَدَعْتُ قِرْنَ الهوى حتَّى فتكت به","باللّه قل هل بخدع القِرْنِ من باسِ",61,"س",1,0],["خدمتْ رئاستَك السعودُ وأصبحتْ","للفضل تحْسُدُ عَصرَكَ الأعصارُ",62,"ر",1,0],["خُدِعتُ لَئِن صَدَّقتُ أَنَّ غُيابَةً","تَكَشَّفُ إِلّا عَن وُجوهِ الهَياثِمِ",63,"م",1,0],["خَدَمَ العُلى فَخَدَمنَهُ وَهيَ الَّتي","لا تَخدُمُ الأَقوامَ ما لَم تُخدَمِ",64,"م",1,0],["خَدينُ العُلى أَبقى لَهُ البَذلُ وَالتُقى","عَواقِبَ مِن عُرفٍ كَفَتهُ العَواقِبا",65,"ب",2,0],["خَدَمتُهُ بِمَديحي فَاِعتَلَوتُ عَلى","هامِ السِّماكِ وَصارَ السَّعدُ مِن خَدَمِي",66,"م",2,0],["خَدَعَتْهُ سَاحِرَةُ الْعُيُونِ بِنَظْرَةٍ","مِنْهَا فَمَلَّكَهَا عِذَارَ لِجَامِهِ",67,"م",2,0],["خدُّكَ بالماءِ اتقى","لولاهُ بالنارِ اتقدْ",68,"د",1,0],["خدُّكَ كانَ الصَّفا ولكنْ","قدْ أصبحَ المشعرَ الحراما",69,"م",2,0],["خَدَلَّجَهٌ إِذا اِنصَرَفَت","أَلِفتُ السُهدَ وَالأَرَقا",70,"ق",2,0],["خَدَلَّجَهٌ إِذا اِنصَرَفَت","رَأَيتَ وِشاحَها قَلِقا",70,"ق",2,0],["خُدَلِ السوقِ رُجَّحٍ","ناعِماتِ الحَقائِبِ",71,"ب",1,0],["خَدَمَ القَضاءُ مُرادَهُ فَكَأَنَّما","مَلَكَت يَداهُ أَعِنَّةَ الأَقدارِ",72,"ر",1,0],["خَدَلَّجَةُ الساقَينِ بَضٌّ بَضيضَةٌ","مُفَلَّجَةُ الأَنيابِ مَصقولَةُ العُمرِ",73,"ر",1,0],["خَدَعوكَ حين أطعتَهم وخدعتهم","إذ طاوعوكَ وتلكَ منزلةُ العَمى",74,"م",2,0],["خدعوهم بالصَّدَى يُزجِي الصّدَى","والرّنينِ العذبِ يجري في الرنينْ",75,"ن",1,0],["خدعوا السَّوادَ فراح يَنعقُ حولهم","فَرِحاً ويُمعِنُ في أذىً وفسادِ",76,"د",1,0],["خَدعوكَ بالتّاج المُلفَّقِ وَابْتَنوا","لكَ عرشَ مملكةٍ من الأوهامِ",77,"م",1,0],["خَدعَ الأميرة وادّعاها شركةً","للزُّورِ فيها هَدّةُ المُنهالِ",78,"ل",1,0],["خدنُ المروءة لم تُقدَر مراتبه","في حبِّ مصرَ لأترابٍ وَأَخدانِ",79,"ن",1,0],["خَدَعوهُ إِذ ضاقَ السَبيلُ بِمَكرِهِم","وَرَموا بِآمالٍ إِلَيهِ حِسانِ",80,"ن",1,0],["خَدَعوا الصِغارَ بِها وَقالوا نِعمَةٌ","شَرُّ البَلِيَّةِ نِعمَةٌ لا تُحمَدُ",81,"د",1,0],["خَدشٌ كوقعِ الظُّفْرِ أو هُوَ دونه","لِمَ تشتكِي وتَضِجُّ من آلامِهِ",82,"م",2,0],["خدعوا فأعجبك الخداع ولم تكن","من قبل بالزيف المعطر تعجب",83,"ب",1,0],["خَدّ تَردَّى احمِرَارَ الصَّبغِ عَن خَفَرٍ","جَفن تَحَلَّى سَوادَ القَارِ عَن كَحَلِ",84,"ل",1,0],["خَدُّهُ بُستَانُ حُسنٍ","حَبَّذَا البُستَانَ بُستَا",85,"ت",2,0],["خَدَعوا فُؤادي بِالوِصالِ وَعِندَما","شَبّوا الهَوى في أَضلُعي هَجَروني",86,"ي",1,0],["خَدٌّ جَرى ماءُ النَعيمِ بِجَمرِهِ","فاِسوَدَّ مَجرى الماءِ في الجَمَراتِ",87,"ت",1,0],["خُدِعوا بالمنافقين وهل يَنْ","فُقُ إلَّا على السفيهِ الشَّقاءُ",88,"ا",2,0],["خَدَمْتُهُ بِمَدِيحٍ أسْتَقِيلُ بِهِ","ذُنُوبَ عُمْرٍ مَضَى في الشِّعْرِ والخِدَمِ",89,"م",1,0],["خَدَعُونا واللهِ مَمَّا يَمُدُّو","نَ أَكُفَّا كَكِفَّةِ المِيزانِ",90,"ن",1,0],["خَدَمُ المُلوكِ إِذا قَعَدنا في الحُبى","قاموا وَإِن نَفزَع لِرَوعٍ يَقعُدوا",91,"د",3,0],["خِدرُ العَروسِ وَإِن كانَت مُحَبَّبَةً","أَدهى وَأَفتَكُ مِن عَريسَةِ الأَسَدِ",92,"د",1,1],["خَدَمَ اللَهَ غَيرُنا وَأَرانا"