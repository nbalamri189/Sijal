{"poems":[[73,"لا تعرضن لضيق المقل","https://www.aldiwan.net/poem4018.html","أحذ الكامل"],[45,"ذكر الصبى ومراتع الآرام","https://www.aldiwan.net/poem10528.html","الكامل"],[50,"يزيد ماذا دهاكا","https://www.aldiwan.net/poem64487.html","المجتث"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54956","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54314","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[415,"مثل منهل أنعم الملك الصالح","https://www.aldiwan.net/poem32212.html","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70689","السريع"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35387","الخفيف"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202169","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53039","الرجز"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66538","الكامل"]],"verses":[["مَلِكٌ زَهَت أَيّامُ دَولَتِهِ ال","غَرّاءِ وَاِفتَخَرَت عَلى الدُوَلِ",0,"ل",1,0],["مَلِكٌ زُهَت بِمَكانِهِ أَيّامُهُ","حَتّى اِفتَخَرنَ بِهِ عَلى الأَيّامِ",1,"م",1,0],["مُلكٌ زَها بِكَ بَعدي","أَم صاحِبٌ أَغواكا",2,"ك",2,0],["مَلِكٌ زَادَهَا فَخَاراً وَمَجْداً","مُذْ تَوَلَّى بِالنَّصْرِ يَعْقَبُ نَصْرَا",3,"ر",2,0],["ملِك زانه الجلال وطافتْ","حوْله هالةٌ من الإيمان",4,"ن",1,0],["مَلِكٌ زَهَا الإِسلامُ تَحْتَ لِوَائِه","وَأَوَى لِرُكْنٍ من حِمَاهُ شَدِيدِ",5,"د",1,0],["ملكٌ زاده التواضعُ للّ","هِ جلالاً يَروعُ ثمَّ يَروقُ",6,"ق",1,0],["مَلْكٌ زَرَى عدْلاً بكسرى وفي الْ","ملكِ زَرَى مُلكاً بمُلْكِ ابنِ عادْ",7,"د",1,0],["مَلِكٌ زَيَّنَ الخِلافَةَ عَدلاً","مِثلَ ما زانَ الجيدَ سِلكُ اللَآلي",8,"ل",2,0],["مَلِكٌ زُرَيْعيّ النِّجار مُؤَيَّد ال","أَنْصار رَحْبُ البابِ رحبُ الباعِ",9,"ع",1,0],["ملك زهت لنصره صحائف","يملي الردى إنشاءها فيطنب",10,"ب",1,0],["مَلْكٌ زِمَامُ الزَّمانِ فِي يَدِهِ","فَاخْتَلَفَتْ كاخْتِلافِ أَلْوانِهْ",11,"ه",1,0]]}