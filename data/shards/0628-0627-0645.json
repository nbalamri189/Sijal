D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6213,"مركب ووقود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76267&r=&rc=24",""],[6225,"نسيمُ الخلود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81328&r=&rc=355",""],[4890,"يقين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72393&r=&rc=83",""]],"verses":[["بآمالٍ تُلَقِّحُهُنَّ عُجْبا","بِهِنَّ وهُنَّ يُسرِرْنَ الحِيالا",0,"ل",2,0],["بِأَمثالِها يُستَرَقُّ الكَريمُ","إِذا مَطمَعٌ بِسِواهُ أَخَلّ",1,"ل",1,0],["بأمداحه جاء الكتاب مفصلاً","يرتِّلُه في الذكر من كان تاليا",2,"ي",2,0],["بِأَمضى مِنَ الحَجّاجِ في الحَربِ مُقدِماً","إِذا بَعضُهُم هابَ الخِياضَ فَعَرَّدا",3,"د",2,0],["بِأَمرِ رَسولِ اللَهِ وَالأَمرُ أَمرُهُ","يُهيبُ لِلِحيانَ الخَنا بِفَناءِ",4,"ا",2,0],["بِأَمرِ رَسولِ اللَهِ إِنَّ رَسولَهُ","رَأى رَأيَ ذي حَزمٍ بِلِحيانَ عالِمِ",5,"م",1,0],["بإمامٍ لم تزل آلاؤهُ","تتوالى كالغيوث الماطره",6,"ر",2,0],["بأمثالهنَّ انقاد ذو الحلم للهوى","جَنيباً وأبكتهُ الرسومُ الدوارس",7,"س",1,0],["بأمثاله تَمضي السيوف مضاءَها","وتنفذ أطرافُ الرماح العوارص",8,"ص",1,0],["بأمثال من المَثُلات شنعٍ","تسير فتخرق الأفق المطيفا",9,"ف",2,0],["بامير الغناء من شهدت آ","يات الحانه له باقتدار",10,"ر",1,0],["بِأَمثالِها مِن حِكمَةٍ في بَلاغَةٍ","تُحَلِّلُ أَضغانٌ وَتَرحَلُ أَظعانُ",11,"ن",1,0],["بِأُمِّ سَعيدٍ جَفوَةٌ عَن لِقائِهِ","وَإِن كانَتِ البَلوى بِأُمِّ سَعيدِ",12,"د",1,0],["بأَمْرِ محمّدٍ إذْ دَسَّ ليلاً","إلى كَعْبٍ أَخَا كعبٍ يَسِيرُ",13,"ر",1,0],["بأمثال هذا يرحم الله خلقه","وان عظمت أحداثهم والشنائع",14,"ع",1,0],["بأمثال هذا تحفل الشاة ضرعها","ويسمن مهزول ويقطف يانع",14,"ع",1,0],["بأمثال هذا يخصب الله أرضه","ويشرب عطشان ويشبع جائع",14,"ع",1,0],["بأمثال هذا تنزل السحب رجعها","وينضر صدع الأرض وهي بلاقع",14,"ع",1,0],["بأمثال هذا يدفع الله سخطه","وليس لسخط الله في الأرض دافع",14,"ع",1,0],["با مِدفعَ الأبطالِ أنَّك حاملٌ","من كانَ ينهضُ حينَ يعجَزُ مِدفَع",15,"ع",1,0],["بامركَ تحريكُ درع الفضاء","وان رَجَمَ الخلق فيك الظنونا",16,"ن",2,0],["بأموت بك بالحس والسمع والصوت","ياأم الكثير اللي يكفي قليله",17,"ل",2,0],["َبا مُنذِرٍ كانَت غَروراً صَحيفَتي","وَلَم أُعطِكُم بِالطَوعِ مالي وَلا عِرضي",18,"ض",2,1],["بأمثال هذا تحفل الشاة ضرعها","ويسمن مهزول ويقطع يانع",19,"ع",1,0],["بآمد السوداء أعجوبة","دلت على القدرة للباري",20,"ي",1,1],["بأمك بضعة المختار ذات ال","وقار وشبلها الحسن الأمير",21,"ر",1,0],["بأمهما نور عين الرسول","وأم الفحول الصدور العظام",22,"م",1,0],["بامُنْجدى لا تسلِّى القلب عن هِمَمٍ","لا تنسنى فمديحى ما به دَخَلُ",23,"ل",1,0],["بِأَمنٍ لِمَن يَخشى وَقَهرٍ لِمَن طَغى","وَسَبقٍ لِمَن جارى وَعَفوٍ لِمَن هَفا",24,"ف",2,0],["بأمر الله مضطلع","لدين الله محتسب",25,"ب",1,0],["بأمر قضاة الدين فيها ليدفعوا","عن الدين ما يؤذى وما يتجنب",26,"ب",1,0],["بِأَمنٍ وَيمُنٍ وَدُنيَا وَدِينٍ","بَنَجلس كَرِيمٍ وَمَجدٍ كَمُلَ",27,"ل",1,0],["بأمور محكمات","حاريات في امور",28,"ر",1,0],["بِإمدادهِ أقسامها خمسةً أتت","مُنظّمةً قد أحرَزَت كلُّها النَصرا",29,"ر",2,0],["بِأَمنٍ لا يَحِلُّ لَهُ حَرامٌ","وَعِزٍّ لا يُباحُ لَهُ حَريمُ",30,"م",1,0],["بأمر من أعملت فيهم قواذفكم","وضارب الأخ للأرحام يختان",31,"ن",1,0],["بإمر من صوّبت بغيا وموجدةً","إلى صدور الشباب الغض نيران",31,"ن",1,0],["بأمر الهوى أقبلت والحب حاكمٌ","يطاع على رغم الدلال كلامه",32,"ه",1,0],["بأمرِ الجمالِ فتاكِ ائتَمَرْ","وقلبي لِقَلبكِ رَبِّي خلق",33,"ق",1,0],["بأمثالِنا الدّنيا تضيقُ وصدرُها","رحيبٌ لأشرارِ وأصحابِ آثام",34,"م",1,0],["بِأَمْرِ اللَّهِ قامَ المَلْكُ يَحْيَى","وَقَدْ قَعَدَتْ بهِ زُمَرُ النِّفَاقِ",35,"ق",1,0],["بإِمْرَتِهِ ازْدانَ الزَّمانُ وَأَصْبَحَتْ","مُوَدَّعَةَ الآمالِ وَهْيَ رَواجِعُ",36,"ع",1,0],["بإِمْرَتِهِ تَخْتالُ عِزّةُ أنْفُسٍ","وَلَولا أواقِيها العِظَامُ هُنَا هُنَّا",37,"ن",2,0],["بِأَمَقَّ أَغبَرَ يَلتَقي حَنّانَهُ","لِلريحِ بَينَ فُروعِهِ تَرجيعُ",38,"ع",1,0],["بآمالٍ كما قَطَعوا طِوالٍ","إليه ومثْلما عَقَدوا مِتان",39,"ن",1,0],["بأمرِ الحَزمِ تعملُهُ","وتأتيهِ وتعتمدُه",40,"د",2,0],["بامْرِىءٍ ما فَعَلْت عَفٍّ يَؤُوسٍ","صَدَقَتْهُ المُنى لِعَوْضِ الحينِ",41,"ن",1,0],["باملاكك الله يا رازقي","وبالأوليا إن تقينا الزلل",42,"ل",1,0],["بأمْنَع مَنْ سَمعَ الس