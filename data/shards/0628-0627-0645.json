{"poems":[[65,"أثرها وهي تنتعل الظلالا","https://www.aldiwan.net/poem46214.html","الوافر"],[75,"هي الشمس مغربها في الكلل","https://www.aldiwan.net/poem11950.html","المتقارب"],[85,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[29,"غدا باجتماع الحي نقضي لبانة","https://www.aldiwan.net/poem5735.html","الطويل"],[23,"لحا الله لحيانا فليست دمائهم","https://www.aldiwan.net/poem21492.html","الطويل"],[23,"لعمري لقد شانت هذيل بن مدرك","https://www.aldiwan.net/poem21617.html","الطويل"],[53,"لا وألحاظ العيون الساحره","https://www.aldiwan.net/poem62878.html","الطويل"],[53,"ألم تسأل اليوم الظباء الكوانس","https://www.aldiwan.net/poem64666.html","الطويل"],[53,"رمين فؤادي من عيون الوصاوص","https://www.aldiwan.net/poem64935.html","الطويل"],[53,"ليوقن من يعارضني بأني","https://www.aldiwan.net/poem65446.html","الوافر"],[91,"الأغاني تصبي ولست بدار","https://www.aldiwan.net/poem44756.html","الكامل"],[76,"أبشرك أم ماء يسح وبستان","https://www.aldiwan.net/poem13268.html","الطويل"],[52,"ألا من لمطروب الفؤاد عميد","https://www.aldiwan.net/poem63957.html","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67306","الوافر"],[111,"ألا هل لداعي الله في الأرض سامع","https://www.poetsgate.com/ViewPoem.aspx?id=103",""],[92,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""],[92,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[112,"أحلى وسيلة","https://www.poetsgate.com/ViewPoem.aspx?id=8387",""],[1,"َبا مُنذِرٍ كانَت غَروراً صَحيفَتي","https://www.poetsgate.com/ViewPoem.aspx?id=37514",""],[111,"ألا هل لداعي الله في الأرض سامع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545618",""],[119,"بآمد السوداء أعجوبة","https://www.aldiwan.net/poem41730.html","السريع"],[119,"أغث يا أحمد البدوي وأدرك","https://www.aldiwan.net/poem41747.html","الوافر"],[119,"إلهي بطه شفيع الأنام","https://www.aldiwan.net/poem42186.html","المتقارب"],[132,"ملك بدا ما به زيغ ولا خطل","https://www.aldiwan.net/poem50538.html","البسيط"],[147,"تخلف عنه الصبر فيمن تخلفا","https://www.aldiwan.net/poem11783.html","الطويل"],[154,"بذكرك يبلغ الأرب","https://www.aldiwan.net/poem68500.html","مجزوء الوافر"],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[177,"بعيد السعود وخفق البنود","https://www.aldiwan.net/poem4379.html","عموديه"],[190,"لو رأى الناس مسير ال","https://www.aldiwan.net/poem43863.html","مجزوء الرمل"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[197,"ألا ليت الركاب غدون وقفا","https://www.aldiwan.net/poem13131.html","الوافر"],[215,"أتبكي ماهرا وبه تراخت","https://www.aldiwan.net/poem46634.html","الوافر"],[215,"لقيتك بعد اليأس منك فصفقت","https://www.aldiwan.net/poem46765.html","الطويل"],[274,"خمارك فيه لقلبي خمر","https://www.aldiwan.net/poem35423.html","المتقارب"],[274,"على الشاطىء المصري ضل فتى الشام","https://www.aldiwan.net/poem35638.html","الطويل"],[279,"من الملك المحيا في الرواق","https://www.aldiwan.net/poem25475.html","الوافر"],[279,"تناضل عن دين الهدى وتدافع","https://www.aldiwan.net/poem25485.html","الطويل"],[279,"رأى الله ما أرضاه من سعيه الأسنى","https://www.aldiwan.net/poem25512.html","الطويل"],[349,"أمن الجميع بذي البقاع ربوع","https://www.aldiwan.net/poem4472.html","الكامل"],[368,"إذا لم تقدرا أن تسعداني","https://www.aldiwan.net/poem60633.html","الوافر"],[369,"أمرتك يوم ذي صنعاء","https://www.aldiwan.net/poem44518.html","مجزوء الوافر"],[372,"لمن الظعن بالضحى طافيات","https://www.aldiwan.net/poem1882.html","الخفيف"],[395,"أنحت بباب الكريم الأمل","https://www.aldiwan.net/poem54548.html","عموديه"],[406,"سقامي يظهر ما أضمر","https://www.aldiwan.net/poem46931.html","المتقارب"],[410,"طيف ألم فزاد في آلامي","https://www.aldiwan.net/poem50127.html","الكامل"],[420,"تنقلت مثل البدر يا طلعة البدر","https://www.aldiwan.net/poem54158.html","الطويل"],[464,"طوت ما طوت في سهل أرض ووعرها","https://www.aldiwan.net/poem15314.html","الطويل"],[480,"كفى حزنا أني أبثك ما عندي","https://www.aldiwan.net/poem15281.html","الطويل"],[509,"صلاح الدين انت له نظام","https://www.aldiwan.net/poem2399.html","الوافر"],[561,"جئنا إلى الحسن المعروف بالراعي","https://www.aldiwan.net/poem34367.html","البسيط"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/216858","الخفيف"]],"verses":[["بآمالٍ تُلَقِّحُهُنَّ عُجْبا","بِهِنَّ وهُنَّ يُسرِرْنَ الحِيالا",0,"ل",2,0],["بِأَمثالِها يُستَرَقُّ الكَريمُ","إِذا مَطمَعٌ بِسِواهُ أَخَلّ",1,"ل",1,0],["بأمداحه جاء الكتاب مفصلاً","يرتِّلُه في الذكر من كان تاليا",2,"ي",2,0],["بِأَمضى مِنَ الحَجّاجِ في الحَربِ مُقدِماً","إِذا بَعضُهُم هابَ الخِياضَ فَعَرَّدا",3,"د",2,0],["بِأَمرِ رَسولِ اللَهِ وَالأَمرُ أَمرُهُ","يُهيبُ لِلِحيانَ الخَنا بِفَناءِ",4,"ا",2,0],["بِأَمرِ رَسولِ اللَهِ إِنَّ رَسولَهُ","رَأى رَأيَ ذي حَزمٍ بِلِحيانَ عالِمِ",5,"م",1,0],["بإمامٍ لم تزل آلاؤهُ","تتوالى كالغيوث الماطره",6,"ر",2,0],["بأمثالهنَّ انقاد ذو الحلم للهوى","جَنيباً وأبكتهُ الرسومُ الدوارس",7,"س",1,0],["بأمثاله تَمضي السيوف مضاءَها","وتنفذ أطرافُ الرماح العوارص",8,"ص",1,0],["بأمثال من المَثُلات شنعٍ","تسير فتخرق الأفق المطيفا",9,"ف",2,0],["بامير الغناء من شهدت آ","يات الحانه له باقتدار",10,"ر",1,0],["بِأَمثالِها مِن حِكمَةٍ في بَلاغَةٍ","تُحَلِّلُ أَضغانٌ وَتَرحَلُ أَظعانُ",11,"ن",1,0],["بِأُمِّ سَعيدٍ جَفوَةٌ عَن لِقائِهِ","وَإِن كانَتِ البَلوى بِأُمِّ سَعيدِ",12,"د",1,0],["بأَمْرِ محمّدٍ إذْ دَسَّ ليلاً","إلى كَعْبٍ أَخَا كعبٍ يَسِيرُ",13,"ر",1,0],["بأمثال هذا يرحم الله خلقه","وان عظمت أحداثهم والشنائع",14,"ع",1,0],["بأمثال هذا تحفل الشاة ضرعها","ويسمن مهزول ويقطف يانع",14,"ع",1,0],["بأمثال هذا يخصب الله أرضه","ويشرب عطشان ويشبع جائع",14,"ع",1,0],["بأمثال هذا تنزل السحب رجعها","وينضر صدع الأرض وهي بلاقع",14,"ع",1,0],["بأمثال هذا يدفع الله سخطه","وليس لسخط الله في الأرض دافع",14,"ع",1,0],["با مِدفعَ الأبطالِ أنَّك حاملٌ","من كانَ ينهضُ حينَ يعجَزُ مِدفَع",15,"ع",1,0],["بامركَ تحريكُ درع الفضاء","وان رَجَمَ الخلق فيك الظنونا",16,"ن",2,0],["بأموت بك بالحس والسمع والصوت","ياأم الكثير اللي يكفي قليله",17,"ل",2,0],["َبا مُنذِرٍ كانَت غَروراً صَحيفَتي","وَلَم أُعطِكُم بِالطَوعِ مالي وَلا عِرضي",18,"ض",2,1],["بأمثال هذا تحفل الشاة ضرعها","ويسمن مهزول ويقطع يانع",19,"ع",1,0],["بآمد السوداء أعجوبة","دلت على القدرة للباري",20,"ي",1,1],["بأمك بضعة المختار ذات ال","وقار وشبلها الحسن الأمير",21,"ر",1,0],["بأمهما نور عين الرسول","وأم الفحول الصدور العظام",22,"م",1,0],["بامُنْجدى لا تسلِّى القلب عن هِمَمٍ","لا تنسنى فمديحى ما به دَخَلُ",23,"ل",1,0],["بِأَمنٍ لِمَن يَخشى وَقَهرٍ لِمَن طَغى","وَسَبقٍ لِمَن جارى وَعَفوٍ لِمَن هَفا",24,"ف",2,0],["بأمر الله مضطلع","لدين الله محتسب",25,"ب",1,0],["بأمر قضاة الدين فيها ليدفعوا","عن الدين ما يؤذى وما يتجنب",26,"ب",1,0],["بِأَمنٍ وَيمُنٍ وَدُنيَا وَدِينٍ","بَنَجلس كَرِيمٍ وَمَجدٍ كَمُلَ",27,"ل",1,0],["بأمور محكمات","حاريات في امور",28,"ر",1,0],["بِإمدادهِ أقسامها خمسةً أتت","مُنظّمةً قد أحرَزَت كلُّها النَصرا",29,"ر",2,0],["بِأَمنٍ لا يَحِلُّ لَهُ حَرامٌ","وَعِزٍّ لا يُباحُ لَهُ حَريمُ",30,"م",1,0],["بأمر من أعملت فيهم قواذفكم","وضارب الأخ للأرحام يختان",31,"ن",1,0],["بإمر من صوّبت بغيا وموجدةً","إلى صدور الشباب الغض نيران",31,"ن",1,0],["بأمر الهوى أقبلت والحب حاكمٌ","يطاع على رغم الدلال كلامه",32,"ه",1,0],["بأمرِ الجمالِ فتاكِ ائتَمَرْ","وقلبي لِقَلبكِ رَبِّي خلق",33,"ق",1,0],["بأمثالِنا الدّنيا تضيقُ وصدرُها","رحيبٌ لأشرارِ وأصحابِ آثام",34,"م",1,0],["بِأَمْرِ اللَّهِ قامَ المَلْكُ يَحْيَى","وَقَدْ قَعَدَتْ بهِ زُمَرُ النِّفَاقِ",35,"ق",1,0],["بإِمْرَتِهِ ازْدانَ الزَّمانُ وَأَصْبَحَتْ","مُوَدَّعَةَ الآمالِ وَهْيَ رَواجِعُ",36,"ع",1,0],["بإِمْرَتِهِ تَخْتالُ عِزّةُ أنْفُسٍ","وَلَولا أواقِيها العِظَامُ هُنَا هُنَّا",37,"ن",2,0],["بِأَمَقَّ أَغبَرَ يَلتَقي حَنّانَهُ","لِلريحِ بَينَ فُروعِهِ تَرجيعُ",38,"ع",1,0],["بآمالٍ كما قَطَعوا طِوالٍ","إليه ومثْلما عَقَدوا مِتان",39,"ن",1,0],["بأمرِ الحَزمِ تعملُهُ","وتأتيهِ وتعتمدُه",40,"د",2,0],["بامْرِىءٍ ما فَعَلْت عَفٍّ يَؤُوسٍ","صَدَقَتْهُ المُنى لِعَوْضِ الحينِ",41,"ن",1,0],["باملاكك الله يا رازقي","وبالأوليا إن تقينا الزلل",42,"ل",1,0],["بأمْنَع مَنْ سَمعَ السَّامعونَ","وأكْرم مَن أَبْصَرَ المبصرُ",43,"ر",1,0],["بأمونَةٍ حَرفٍ سَمَت بِمَناسِمٍ","فيها من الرَمضاء كالأَوشامِ",44,"م",1,0],["بأمر وليِّ الأَمر سرت ولم تزل","كما أنت تهوى صاحب النهي والأَمر",45,"ر",1,0],["بأمضى من السلطان بأساً إذا جرى","يُطاردُ فقراً أو لطرْد الجحافلِ",46,"ل",1,0],["بأمضى غِراراً مِن لساني إذا انبرى","يُنَظَّمُ شِعراً ليس لي فيه مِن نِدِّ",47,"د",1,0],["بأم المؤمنين قد استهانُوا","وللصّديق والفَاروق ذَاموا",48,"م",3,0],["بأمر رب قديم لا حدوث له","إني مددت إليه في الهوى باعي",49,"ع",2,0],["بأمْنُونٍ كالبُرْجِ صادقةِ العدْ","وولا تشتكي من البَخَصَاتِ",50,"ت",1,0]]}