{"poems":[[63,"أثرها وهي تنتعل الظلالا","https://www.aldiwan.net/poem46214.html","الوافر"],[73,"هي الشمس مغربها في الكلل","https://www.aldiwan.net/poem11950.html","المتقارب"],[83,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[27,"غدا باجتماع الحي نقضي لبانة","https://www.aldiwan.net/poem5735.html","الطويل"],[23,"لحا الله لحيانا فليست دمائهم","https://www.aldiwan.net/poem21492.html","الطويل"],[23,"لعمري لقد شانت هذيل بن مدرك","https://www.aldiwan.net/poem21617.html","الطويل"],[51,"لا وألحاظ العيون الساحره","https://www.aldiwan.net/poem62878.html","الطويل"],[51,"ألم تسأل اليوم الظباء الكوانس","https://www.aldiwan.net/poem64666.html","الطويل"],[51,"رمين فؤادي من عيون الوصاوص","https://www.aldiwan.net/poem64935.html","الطويل"],[51,"ليوقن من يعارضني بأني","https://www.aldiwan.net/poem65446.html","الوافر"],[89,"الأغاني تصبي ولست بدار","https://www.aldiwan.net/poem44756.html","الكامل"],[74,"أبشرك أم ماء يسح وبستان","https://www.aldiwan.net/poem13268.html","الطويل"],[50,"ألا من لمطروب الفؤاد عميد","https://www.aldiwan.net/poem63957.html","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67306","الوافر"],[90,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""],[90,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[1,"َبا مُنذِرٍ كانَت غَروراً صَحيفَتي","https://www.poetsgate.com/ViewPoem.aspx?id=37514",""],[113,"بآمد السوداء أعجوبة","https://www.aldiwan.net/poem41730.html","السريع"],[113,"أغث يا أحمد البدوي وأدرك","https://www.aldiwan.net/poem41747.html","الوافر"],[113,"إلهي بطه شفيع الأنام","https://www.aldiwan.net/poem42186.html","المتقارب"],[126,"ملك بدا ما به زيغ ولا خطل","https://www.aldiwan.net/poem50538.html","البسيط"],[141,"تخلف عنه الصبر فيمن تخلفا","https://www.aldiwan.net/poem11783.html","الطويل"],[148,"بذكرك يبلغ الأرب","https://www.aldiwan.net/poem68500.html","مجزوء الوافر"],[158,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[171,"بعيد السعود وخفق البنود","https://www.aldiwan.net/poem4379.html","عموديه"],[184,"لو رأى الناس مسير ال","https://www.aldiwan.net/poem43863.html","مجزوء الرمل"],[187,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[191,"ألا ليت الركاب غدون وقفا","https://www.aldiwan.net/poem13131.html","الوافر"],[209,"أتبكي ماهرا وبه تراخت","https://www.aldiwan.net/poem46634.html","الوافر"],[209,"لقيتك بعد اليأس منك فصفقت","https://www.aldiwan.net/poem46765.html","الطويل"],[268,"خمارك فيه لقلبي خمر","https://www.aldiwan.net/poem35423.html","المتقارب"],[268,"على الشاطىء المصري ضل فتى الشام","https://www.aldiwan.net/poem35638.html","الطويل"],[273,"من الملك المحيا في الرواق","https://www.aldiwan.net/poem25475.html","الوافر"],[273,"تناضل عن دين الهدى وتدافع","https://www.aldiwan.net/poem25485.html","الطويل"],[273,"رأى الله ما أرضاه من سعيه الأسنى","https://www.aldiwan.net/poem25512.html","الطويل"],[343,"أمن الجميع بذي البقاع ربوع","https://www.aldiwan.net/poem4472.html","الكامل"],[362,"إذا لم تقدرا أن تسعداني","https://www.aldiwan.net/poem60633.html","الوافر"],[363,"أمرتك يوم ذي صنعاء","https://www.aldiwan.net/poem44518.html","مجزوء الوافر"],[366,"لمن الظعن بالضحى طافيات","https://www.aldiwan.net/poem1882.html","الخفيف"],[388,"أنحت بباب الكريم الأمل","https://www.aldiwan.net/poem54548.html","عموديه"],[399,"سقامي يظهر ما أضمر","https://www.aldiwan.net/poem46931.html","المتقارب"],[403,"طيف ألم فزاد في آلامي","https://www.aldiwan.net/poem50127.html","الكامل"],[413,"تنقلت مثل البدر يا طلعة البدر","https://www.aldiwan.net/poem54158.html","الطويل"],[459,"طوت ما طوت في سهل أرض ووعرها","https://www.aldiwan.net/poem15314.html","الطويل"],[475,"كفى حزنا أني أبثك ما عندي","https://www.aldiwan.net/poem15281.html","الطويل"],[504,"صلاح الدين انت له نظام","https://www.aldiwan.net/poem2399.html","الوافر"],[556,"جئنا إلى الحسن المعروف بالراعي","https://www.aldiwan.net/poem34367.html","البسيط"]],"verses":[["بآمالٍ تُلَقِّحُهُنَّ عُجْبا","بِهِنَّ وهُنَّ يُسرِرْنَ الحِيالا",0,"ل",2,0],["بِأَمثالِها يُستَرَقُّ الكَريمُ","إِذا مَطمَعٌ بِسِواهُ أَخَلّ",1,"ل",1,0],["بأمداحه جاء الكتاب مفصلاً","يرتِّلُه في الذكر من كان تاليا",2,"ي",2,0],["بِأَمضى مِنَ الحَجّاجِ في الحَربِ مُقدِماً","إِذا بَعضُهُم هابَ الخِياضَ فَعَرَّدا",3,"د",2,0],["بِأَمرِ رَسولِ اللَهِ وَالأَمرُ أَمرُهُ","يُهيبُ لِلِحيانَ الخَنا بِفَناءِ",4,"ا",2,0],["بِأَمرِ رَسولِ اللَهِ إِنَّ رَسولَهُ","رَأى رَأيَ ذي حَزمٍ بِلِحيانَ عالِمِ",5,"م",1,0],["بإمامٍ لم تزل آلاؤهُ","تتوالى كالغيوث الماطره",6,"ر",2,0],["بأمثالهنَّ انقاد ذو الحلم للهوى","جَنيباً وأبكتهُ الرسومُ الدوارس",7,"س",1,0],["بأمثاله تَمضي السيوف مضاءَها","وتنفذ أطرافُ الرماح العوارص",8,"ص",1,0],["بأمثال من المَثُلات شنعٍ","تسير فتخرق الأفق المطيفا",9,"ف",2,0],["بامير الغناء من شهدت آ","يات الحانه له باقتدار",10,"ر",1,0],["بِأَمثالِها مِن حِكمَةٍ في بَلاغَةٍ","تُحَلِّلُ أَضغانٌ وَتَرحَلُ أَظعانُ",11,"ن",1,0],["بِأُمِّ سَعيدٍ جَفوَةٌ عَن لِقائِهِ","وَإِن كانَتِ البَلوى بِأُمِّ سَعيدِ",12,"د",1,0],["بأَمْرِ محمّدٍ إذْ دَسَّ ليلاً","إلى كَعْبٍ أَخَا كعبٍ يَسِيرُ",13,"ر",1,0],["با مِدفعَ الأبطالِ أنَّك حاملٌ","من كانَ ينهضُ حينَ يعجَزُ مِدفَع",14,"ع",1,0],["بامركَ تحريكُ درع الفضاء","وان رَجَمَ الخلق فيك الظنونا",15,"ن",2,0],["َبا مُنذِرٍ كانَت غَروراً صَحيفَتي","وَلَم أُعطِكُم بِالطَوعِ مالي وَلا عِرضي",16,"ض",2,1],["بآمد السوداء أعجوبة","دلت على القدرة للباري",17,"ي",1,1],["بأمك بضعة المختار ذات ال","وقار وشبلها الحسن الأمير",18,"ر",1,0],["بأمهما نور عين الرسول","وأم الفحول الصدور العظام",19,"م",1,0],["بامُنْجدى لا تسلِّى القلب عن هِمَمٍ","لا تنسنى فمديحى ما به دَخَلُ",20,"ل",1,0],["بِأَمنٍ لِمَن يَخشى وَقَهرٍ لِمَن طَغى","وَسَبقٍ لِمَن جارى وَعَفوٍ لِمَن هَفا",21,"ف",2,0],["بأمر الله مضطلع","لدين الله محتسب",22,"ب",1,0],["بأمر قضاة الدين فيها ليدفعوا","عن الدين ما يؤذى وما يتجنب",23,"ب",1,0],["بِأَمنٍ وَيمُنٍ وَدُنيَا وَدِينٍ","بَنَجلس كَرِيمٍ وَمَجدٍ كَمُلَ",24,"ل",1,0],["بأمور محكمات","حاريات في امور",25,"ر",1,0],["بِإمدادهِ أقسامها خمسةً أتت","مُنظّمةً قد أحرَزَت كلُّها النَصرا",26,"ر",2,0],["بِأَمنٍ لا يَحِلُّ لَهُ حَرامٌ","وَعِزٍّ لا يُباحُ لَهُ حَريمُ",27,"م",1,0],["بأمر من أعملت فيهم قواذفكم","وضارب الأخ للأرحام يختان",28,"ن",1,0],["بإمر من صوّبت بغيا وموجدةً","إلى صدور الشباب الغض نيران",28,"ن",1,0],["بأمر الهوى أقبلت والحب حاكمٌ","يطاع على رغم الدلال كلامه",29,"ه",1,0],["بأمرِ الجمالِ فتاكِ ائتَمَرْ","وقلبي لِقَلبكِ رَبِّي خلق",30,"ق",1,0],["بأمثالِنا الدّنيا تضيقُ وصدرُها","رحيبٌ لأشرارِ وأصحابِ آثام",31,"م",1,0],["بِأَمْرِ اللَّهِ قامَ المَلْكُ يَحْيَى","وَقَدْ قَعَدَتْ بهِ زُمَرُ النِّفَاقِ",32,"ق",1,0],["بإِمْرَتِهِ ازْدانَ الزَّمانُ وَأَصْبَحَتْ","مُوَدَّعَةَ الآمالِ وَهْيَ رَواجِعُ",33,"ع",1,0],["بإِمْرَتِهِ تَخْتالُ عِزّةُ أنْفُسٍ","وَلَولا أواقِيها العِظَامُ هُنَا هُنَّا",34,"ن",2,0],["بِأَمَقَّ أَغبَرَ يَلتَقي حَنّانَهُ","لِلريحِ بَينَ فُروعِهِ تَرجيعُ",35,"ع",1,0],["بآمالٍ كما قَطَعوا طِوالٍ","إليه ومثْلما عَقَدوا مِتان",36,"ن",1,0],["بأمرِ الحَزمِ تعملُهُ","وتأتيهِ وتعتمدُه",37,"د",2,0],["بامْرِىءٍ ما فَعَلْت عَفٍّ يَؤُوسٍ","صَدَقَتْهُ المُنى لِعَوْضِ الحينِ",38,"ن",1,0],["باملاكك الله يا رازقي","وبالأوليا إن تقينا الزلل",39,"ل",1,0],["بأمْنَع مَنْ سَمعَ السَّامعونَ","وأكْرم مَن أَبْصَرَ المبصرُ",40,"ر",1,0],["بأمونَةٍ حَرفٍ سَمَت بِمَناسِمٍ","فيها من الرَمضاء كالأَوشامِ",41,"م",1,0],["بأمر وليِّ الأَمر سرت ولم تزل","كما أنت تهوى صاحب النهي والأَمر",42,"ر",1,0],["بأمضى من السلطان بأساً إذا جرى","يُطاردُ فقراً أو لطرْد الجحافلِ",43,"ل",1,0],["بأمضى غِراراً مِن لساني إذا انبرى","يُنَظَّمُ شِعراً ليس لي فيه مِن نِدِّ",44,"د",1,0],["بأم المؤمنين قد استهانُوا","وللصّديق والفَاروق ذَاموا",45,"م",3,0],["بأمر رب قديم لا حدوث له","إني مددت إليه في الهوى باعي",46,"ي",1,0]]}