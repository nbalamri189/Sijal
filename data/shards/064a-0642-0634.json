{"poems":[[46,"أراك أكبرت إدماني على الدمن","https://www.aldiwan.net/poem30331.html","البسيط"],[107,"أنشروا الآثار واستقصوا السير","https://www.aldiwan.net/poem43071.html","الرمل"],[50,"أنعت ديكا من ديوك الهند","https://www.aldiwan.net/poem63251.html","الرجز"],[50,"أنعت كلبا جال في رباطه","https://www.aldiwan.net/poem64372.html","البسيط"],[170,"حبا من تحت ذيل الحبي","https://www.aldiwan.net/poem46824.html","المتقارب"],[5377,"حراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79568&r=&rc=24",""]],"verses":[["يُقَشِّعُ الفِتَنَ المُسوَدَّ جانِبُها","وَمالُهُ مِن نَداهُ الدَهرَ في فِتَنِ",0,"ن",1,0],["يَقشَعِرُّ الدَهرُ مِن هَيبَتِها","وَهيَ راسٍ عِزُّها ما يَقشَعِرّْ",1,"ر",1,0],["يَقُشُّهُ بِالكَدِّ بَعدَ الكَدِّ","وَتَعَبٍ مُوَصَّلٍ بِجَهدِ",2,"د",1,0],["يَقشِرُ جِلدَ الأَرضِ مِن بِلاطِهِ","بِأَربَعٍ يَقولُ في إِفراطِهِ",3,"ط",2,0],["يُقشّرُ بالضربِ منها اللِّحى","وتُشغلُ عن ضَربها باللِّحيِّ",4,"ي",1,0],["يقشعر التسبيح في حرام الله","إذا همهمت بع الحنفاء",5,"ا",2,0]]}