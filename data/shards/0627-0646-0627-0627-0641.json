{"poems":[[95,"يا حبيباً ما لي سواه حبيب","https://www.aldiwan.net/poem11285.html","الخفيف"],[72,"يا أعز الناس عندي","https://www.aldiwan.net/poem42942.html","مجزوء الرمل"],[46,"أنا في لوعة وحزن شديد","https://www.aldiwan.net/poem30266.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85749","الرمل"],[112,"يئوى النّعاس","https://www.poetsgate.com/ViewPoem.aspx?id=8400",""],[159,"أنا أفدي مكتومة لا تسمى","https://www.aldiwan.net/poem55550.html","الخفيف"],[159,"رسم صبري في ربع شوقي محيل","https://www.aldiwan.net/poem55583.html","الخفيف"],[164,"من يقبل الصب من عاذله","https://www.aldiwan.net/poem58779.html","الرمل"],[190,"أنا أفديك لم صددت وقد تعلم","https://www.aldiwan.net/poem43900.html","الخفيف"],[208,"أنا أفديك من ملول أَلوف","https://www.aldiwan.net/poem53242.html","الخفيف"],[333,"مزجت مصر دمعها بدمائه","https://www.aldiwan.net/poem55012.html","الخفيف"],[347,"إليك إليك يا وطني","https://www.aldiwan.net/poem55317.html","مجزوء الوافر"],[398,"يا غزالا عذاره كالطراز","https://www.aldiwan.net/poem53679.html","الخفيف"],[415,"أنا أفدي مغرى بصدي وهجري","https://www.aldiwan.net/poem32585.html","الخفيف"],[458,"أخي سليمان هذي غربتي بلغت","https://www.aldiwan.net/poem61238.html","البسيط"],[469,"ما على ما لاقيته من مزيد","https://www.aldiwan.net/poem3440.html","عموديه"],[473,"إذا كدر المرء ألفاظه","https://www.aldiwan.net/poem59878.html","المتقارب"],[572,"أنا أفدي من ليس يعلم تيها","https://www.aldiwan.net/poem69472.html","الخفيف"],[572,"أنا أفدي التي تغدو","https://www.aldiwan.net/poem69590.html","مجزوء الوافر"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122305","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63783","الخفيف"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115988","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200767","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200057","الخفيف"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132930","الرمل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66575","الخفيف"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139455",""],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28641","الخفيف"],[3591,"أين الذي كان في باريس يزدهر","https://www.poetsgate.com/ViewPoem.aspx?id=149476",""],[5150,"أنا الشهيدة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203060",""],[333,"من وحي الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=105874",""],[5970,"أنا في هذه الحياة غريب","https://www.poetsgate.com/ViewPoem.aspx?id=130627",""],[572,"أنا أفدِي التي تَبدُو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9394&r=&rc=251",""],[572,"أنا أفْدي منْ لَيسَ أعرف تيهاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9493&r=&rc=350",""]],"verses":[["أَنَا أَفْدِيكَ يَا حَبِيبِي وَتَفْدِيهَا","وَيَفْدِيكُمَا جَمِيعُ الأَنَامِ",0,"م",1,0],["أَنا أَفسَدتُكَ عَن كُلِّ","مُحِبٍّ لَكَ بَعدي",1,"د",2,0],["أَنا أَفدي ساجي الجُفونِ يُسَمّى","وَيُكَنّى بِبَعضِ عَبدِ الحَميدِ",2,"د",1,0],["أنا أفديك برو","حي وأمي وأبي",3,"ي",1,0],["أنا أفكّر كيف أزيل المنحدر من ألأساس","والاغبيا .. لاهين في لعبة صعود المنحدر",4,"ر",1,0],["أَنا أَفْدي مَكْتُومَةً لا تُسَمَّى","هَامَ قَلْبي بِها هُياماً وَهَمَّا",5,"م",2,1],["أَنا أَفْدِي مَنْ أَسْتَقِلُّ لَهُ رُو","حِي فِداءً وَذاكَ فيهِ قَلِيلُ",6,"ل",1,0],["أنا أفدي وجهه من آخذ","بيد الفضل فمن يعدله",7,"ل",2,0],["أنا أفديك لم صددت وقد تع","لم حالي إذا نويت الصدودا",8,"د",2,1],["أنا أفديكَ من مَلُولٍ أَلُوفٍ","راضَني بالأمان والتخويفِ",9,"ف",1,1],["أنا أفنى في مصرَ جوعاً وغري","يتسلّى بتبره وثرائه",10,"ا",3,0],["أنا أفنى في موطني وعدُوّي","يتلهّى بخمره ونسائه",10,"ا",3,0],["انا أفديك يا وطني","بروح ثائر اشر",11,"ر",1,0],["أَنا أَفدي تُرابَ نَعلَيكَ بِالرو","حِ وَبِالنَفسِ دونَ بَذلِ الرِكازِ",12,"ز",1,0],["أَنَا أَفدِي مُغرَىً بصدِّي وهجري","وهو شمسِي ضُحىً وفي الليل بَدْري",13,"ي",1,1],["إنا افتقدناك في وقت أحق به","من كان مثلك يحمي كل علياء",14,"ا",2,0],["أنا أفدي من خدّهِ فضَّةً بيضا","ءَ لكنَّ قلبه من حديدِ",15,"د",1,0],["أَنا أَفديكَ ظالِماً","كُنتَ أَم كُنتَ مُنصِفا",16,"ف",2,0],["أَنَا أَفْدِي مَنْ لَيْسَ يَعْلَمُ تِيْهَاً","وَدَلاَلاً فِي أَيِّ شَيْءٍ رِضَاهُ",17,"ا",2,1],["أَنَا أَفْدِي الَّتِي تَغْدُو","فَتَغْدُو الشَّمْسُ مُنْكَسِفَهْ",18,"ف",2,1],["انا افديك انادي","ك فهل منك مجيب",19,"ب",1,0],["أنا أفديكَ ماءُ عينيَّ نارُ","حين أبكيكَ والدموعُ الشَّرارُ",20,"ر",1,1],["أنا أفديهِ من غزالٍ وحاشا","مالكى أن أقيسَهُ بغزالِ",21,"ل",1,0],["أنا أفرغت في القريض قوايا","معطياً من كهولتي وصبايا",22,"ي",2,1],["انا أفنى في كل شيءٍ شعورا","لست أبقى ولست أبقي بقية",23,"ي",2,0],["أنا أفدي مَن مُحَيّا","ه على الجرح مَليحُ",24,"ح",1,0],["أنا أَفْدِي بَياضَهُ بِبَياضِي","أنا أَفْدِي سَوادَهُ بِسَوادِي",25,"د",2,0],["أنا أفدي على الهجران زينا","وإن كنا على عمدٍ كنينا",26,"ن",2,1],["أَنا أَفديهِ مِن حَبيبٍ لَهُ الفَض","لُ عَلى مَن أَرى وَمَن قَد رَأَيتُ",27,"ت",1,0],["إنا افتقدناه في ذا العام فانفطرت","أحشاؤنا حين لم يرمق له أثر",28,"ر",1,0],["أنا أفدي الجنوبَ ولا أُبالي","أنا والعزُّ في شرفي وليدَهْ",29,"د",2,0],["أنا أفنى في مصر جُوعاً وغيري","يتسلّى بتبره وثرائه",30,"ا",3,0],["أنا أفني وأنت تفني ويفنى","ذلك الدهر والفناء ضروب",31,"ب",1,0],["أنا أفدِي التي تَبدُو","فتغُدو الشَّمسُ منكسِفَهْ",32,"ف",2,1],["أنا أفْدي منْ لَيسَ أعرف تيهاً","ودلالاً في أي شيءٍ رِضَاهُ",33,"ا",2,1]]}