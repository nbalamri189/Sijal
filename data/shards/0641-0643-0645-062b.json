{"poems":[[85,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[53,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[53,"وشيخ يبيت غلام له","https://www.aldiwan.net/poem66537.html","المتقارب"],[47,"أبا جعفر كل أكرومة","https://www.aldiwan.net/poem62671.html","المتقارب"],[47,"إذا عرضت أحداج سلمى فنادها","https://www.aldiwan.net/poem63485.html","الطويل"],[63,"تذكر أيامه الخاليه","https://www.aldiwan.net/poem51396.html","المتقارب"],[51,"ننافس في الدنيا ونحن نعيبها","https://www.aldiwan.net/poem10383.html","الطويل"],[48,"إرجع إلى السن فانظر ما تقادمها","https://www.aldiwan.net/poem22668.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42720","الطويل"],[189,"عسى يجري الزمان على اختياري","https://www.aldiwan.net/poem14534.html","الوافر"],[275,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[285,"أبا حسن أنت أهل الجميل","https://www.aldiwan.net/poem60592.html","المتقارب"],[519,"هلم بنا يا برق في أبرق الحمى","https://www.aldiwan.net/poem20828.html","الطويل"],[556,"ألا هل أتاها كيف حزني بعدها","https://www.aldiwan.net/poem47860.html","الطويل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96584","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16726","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202075","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65011","الطويل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110616","المتقارب"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110130","السريع"],[3770,"","https://poetry.dctabudhabi.ae/diwan/poem/111346","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111504","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136692",""],[4613,"","https://poetry.dctabudhabi.ae/diwan/poem/101946","الطويل"],[4822,"طربت وما شوقي لباسمة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=171236",""],[5155,"في ذكرى الرصافي","https://www.poetsgate.com/ViewPoem.aspx?id=176479",""],[5266,"الفارس","https://www.poetsgate.com/ViewPoem.aspx?id=210744",""],[5431,"بصبر الصالحين شفاء جرحي","https://www.poetsgate.com/ViewPoem.aspx?id=187206",""],[5431,"تراود منك الروح حتى تُسلّما","https://www.poetsgate.com/ViewPoem.aspx?id=196983",""]],"verses":[["فكم ثار بي شوق إليك مُبَرْحٌ","فظلَّت يدُ الأشواق تقدح من زندي",0,"د",2,0],["فكم ثأرٍ تلاقتْ لي يداهُ","ولو من بين أطرافِ الحرابِ",1,"ب",1,0],["فكم ثَمَّ للشيخِ من سجدةٍ","تُعفِّر بالخَدِّ تُربَ الجبين",2,"ن",1,0],["فَكَم ثُلمَةٍ بِكَ مَسدودَةٍ","وَكَم شِدَّةٍ بِكَ مَفروجَه",3,"ج",2,0],["فَكَم ثَمَّ مِن إِجلابَةٍ تَحتَ خَفتَةٍ","وَمِن جَمرَةٍ مَخبوءَةً في رَمادِها",4,"د",3,0],["فَكَم ثَمَّ من ظَبيةٍ عاطلٍ","وكم ثَمَّ من روضةٍ حالِيَه",5,"ي",2,0],["فَكَم ثَمَّ مِن مُستَرجِعٍ مُتَوَجِّعٍ","وَباكِيَةٍ يَعلو عَلَيَّ نَحيبُها",6,"ب",3,0],["فَكَم ثَلاثينَ حَولاً شَيَّبَت وَمَضَت","سُتّونَ وَالشَيبُ فيها غَيرُ مُستَعَرِ",7,"ر",1,0],["فَكَمْ ثَلَّ عَرْشَاً وَاسْتَبَاحَ قَبِيلَةً","وَفَرَّقَ جَمْعَاً وَهْوَ لا يَتَفَرَّقُ",8,"ق",1,0],["فكم ثغرٌ بذاك الثغرِ عَذْبٌ","كطعم الشّهد في أَرَج العُقار",9,"ر",1,0],["فكم ثمَّ مِن دبّابةٍ دكَّتِ الرُّبى","وطيّارَةٍ شعلولها دكدَكَ البرى",10,"ر",2,0],["فَكَمْ ثَمَّ مِنْ زاعِبِيٍّ تَخالُ","مَكانَ المِدادِ بِهِ لَهْذَمَهْ",11,"م",2,0],["فكم ثَمّ من شمس بلَيلٍ تقنّعتْ","وبدرِ ظلامٍ بالنّهارِ تعمّما",12,"م",2,0],["فَكَمْ ثَمَّ مِن أَشلاءِ قومٍ أعدَّها","لِيُعطِيَها ما تبتغي مَنْ أعدّها",13,"د",3,0],["فكم ثُمَّ كم من عَبرةٍ قد رَدَدتُها","سريع على جيبَِ القميصِ انهِلالُها",14,"ل",3,0],["فَكَم ثَمَّ مِن خَشفٍ عَلى الماءِ لاعِبٌ","فَيا مَن رَأى خَشفاً عَلى الماءِ يَلعَبُ",15,"ب",1,0],["فَكَمثلهِ الدنيا تُنيلكَ مُلكها","ثمَراً فلا تَعجَل فَدَيتُك واصبر",16,"ر",1,0],["فكم ثَرْوةٍ بِكْرٍ وَصَلْنا شُموسَها","وأَقْرانِ دَهْرٍ في ذُراكَ قَطْعَناها",17,"ا",3,0],["فكم ثلمت للمواضي شباً","وكم حطمت للعوالي كعوبا",18,"ب",2,0],["فكم ثِمارٍ قد حلا طَعمُها","لما زكت اغصانُها مَغرَسا",19,"س",2,0],["فكم ثلم الشرع في فقده","وكم بعده الدين أبدى انكسارا",20,"ر",2,0],["فكم ثم طرواديةً دردنيةً","سبيناً بدارٍ بأسنا فوقها امتدا",21,"د",2,0],["فكم ثنينا لدى نار الوغَى رُكباً","كما ثنت للقرى أضيافنا الركبا",22,"ب",2,0],["فكم ثل عرش منه وأنهار شامخ","وكم خرّ مصعوق وألقت حوامل",23,"ل",1,0],["فكم ثلموا البيض الصفاح وحطموا","الرماح وقاموا للكفاح على جمر",24,"ر",1,0],["فكم ثعلب تلقاه في زي راهب","برغم المسوح السود مازال ثعلبا",25,"ب",2,0],["فكمثله لن ينجب الدهر فتى","يحيى ليحى الناس سيمته التقى",26,"ق",2,0],["فكم ثُكلتْ نفوسٌ مؤمناتٌ","إلى أن ضاقَ بالناس السبيلُ",27,"ل",1,0],["فكم ثائرٍ أضحى طحينا على الرحى","وكم فارسٍ نبكيه ذكْرا ترّحما",28,"م",2,0]]}