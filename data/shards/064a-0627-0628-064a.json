,0,"ن",2,0],["يَأبى النَدى تَركَ الثَراءِ عَلى الفَتى","وَيَقِلُّ ميراثُ الجَوادِ المُنعِمِ",1,"م",1,0],["يَأبى إِذا الضَيمُ غَدا مُضغَةً","سَلسالَةً سائِغَةً في الحُلوق",2,"ق",1,0],["يَأبى لِيَ العِزُّ وَالغَرّاءُ مِن شِيَمي","إِمساكَ حَبلِ غُرورٍ ما لَهُ طَرَفُ",3,"ف",1,0],["يا بِئسَ ما جَرَّت عَليكَ عامِداً","مِن رائِعاتٍ تُكثِرُ اِرتِياعَها",4,"ع",3,0],["يَأبى الدَنِيَّةَ في عَشيرَتِهِ","وَيُجاذِبُ الأَيدي عَلى الفَخرِ",5,"ر",1,0],["يا بَينُ رَوَّعتَ قَلبي بِالفِراقِ وَم","أَبكي لِفُرقَةِ أَصحابٍ وَلا طَلَلِ",6,"ل",1,0],["يأبَى المَوارِدَ أنْ تؤتَى مشارِعُها","حتّى إذا أرْسَلَتْ رُعْيانُها الرَّسَلا",7,"ل",2,0],["يَأَبَى لِيَ الأَعْدَاءُ أَنِّي مُقْتَدٍ","بِهُدَاكَ سِراً كَانَ أَوْ إِعْلاَنَا",8,"ن",2,0],["يَأْبَى الُّسلُوَّ فُؤادِي","بَعْدَ الصَّدِيقِ الْحَمِيمِ",9,"م",1,0],["يأبَى وفائيَ أن أصغي للائمةٍ","وأن أطيع عذولي غَشَّ أو نَصَحا",10,"ح",2,0],["يَأبى لِيَ السَيفُ وَاللِسانُ وَقَو","مٌ لَم يُضاموا كَلِبدَةِ الأَسَدِ",11,"د",1,0],["يأبي غزالٌ كاسرٌ","قلبي بناظره الكسير",12,"ر",1,1],["يأبى محاباةَ الأحبة عدلهُ","فأخوه فيه والغريبُ سواءُ",13,"ا",2,0],["يا بينُ أنت البينُ في عزَّةٍ","بين غراب البين والأخطبِ",14,"ب",1,0],["يأبى لها ذاك أن ناظرها","في شُغُلٍ بالسهاد والعبرِ",15,"ر",1,0],["يا بينُ كُلْ من شوائِهِ رغَداً","فقد شويناه غيرَ رشّاش",16,"ش",1,0],["يا بيهقيُّ دع القريض لذي","حذقٍ يعاون علمُه طبعه",17,"ع",2,0],["يأبى لك التفضيلُ إلا أن تُرى","وعلى التطوّلِ من يديك تفضلُ",18,"ل",1,0],["يأبى ليَ الضَّيْم فرْعيَ السامي","إلى المعالي وأصْليَ النامي",19,"م",2,1],["يا بياضَ المشيبِ سوَّدْتَ وجهي","عند بيض الوجوه سُودِ القرونِ",20,"ن",1,1],["يأبى مسالمةَ الأمانة مثله","أنى يسالمُ بطَّةً شاهين",21,"ن",1,0],["يا بَيتَ خَثماءَ الَّذي يُتَحَبَّبُ","ذَهَبَ الشَبابُ وَحُبُّها لا يَذهَبُ",22,"ب",1,1],["يَأبى فُؤادي أَن يَميلَ إِلى الأَذى","حُبُّ الأَذِيَّةِ مِن طِباعِ العَقرَبِ",23,"ب",1,0],["يَأبى لَنا العِزُّ أَن نَرضى المَذَلَّةَ في","عَصرٍ رَأَينا بِهِ العَبدانَ تُحتَرُمُ",24,"م",1,0],["يَأبى الشَقاءُ الَّذي يَدعونَهُ أَدَباً","أَن يَضحَكَ الطِرسُ إِلّا إِن سَفَكتُ دَمي",25,"م",2,0],["يا بيت آمالي انهدمت وإنما","قد كنت آمل أن تكون رصينا",26,"ن",2,0],["يا بَينُ وَلّى جَلَدي فَاِتَّئِد","وَيا زَماني بَعضُ هَذا حَرام",27,"م",1,0],["يَأبى لَهُ في الشَيبِ غَيرَ سَفاهَةٍ","قَلبٌ صَغيرُ الهَمِّ وَالأَوطارِ",28,"ر",1,0],["يأبَى لك العِزُّ أن تثوي بمنزلةٍ","حتى تُغَشِّي رداءَ الخِزي شانِيكا",29,"ك",2,0],["يَأبى سُمُوُّكَ وَاِعتِلاؤُك","إِلّا الَّتي فيها سَناؤُك",30,"ك",1,1],["يَأبى الخَلِيُّ بُكاءَ المَنزِلِ الخالي","وَالنَوحَ في أَرسُمٍ أَقوَت وَأَطلالِ",31,"ل",1,1],["يَأبى إِذا قُلتُ أَنسى ذِكرَ غانِيَةٍ","قَلبٌ يَحِنُّ إِلى البيضِ الرَعابيبِ",32,"ب",1,0],["يَأبى لَهُم طولَ أَيديهِم وَأَنَّ لَهُم","مَجدَ الرِهانِ إِذا ما أُعظِمَ الخَطَرُ",33,"ر",1,0],["يَأبَي‌ لَهُمْ أَنْ يَحِلَّ الذَّمُّ سَاحَتَهُمْ","خِيمٌ كَرِيمٌ وَأيْدٍ بِالنَّدَي‌ هُضُمُ",34,"م",1,0],["يَأبَى إذا خَطَرَ العقيقُ ببالِه","إلا اطَّراحَ العَذلِ من عُذَّالِه",35,"ل",2,1],["يَأبى المُعَلَّقُ بِالهَوى","إِلّا رَواحاً وَادِّلاجا",36,"ج",2,0],["يا بَيتُ بَيتَ الرَدى يا بَيتَ مُنقَطَعي","يا بَيتُ بَيتَ الرَدى يا بَيتَ غُربَتِيَه",37,"ت",3,0],["يا بَيتُ بَيتَ النَوى عَن كُلِّ ذي ثِقَةٍ","يا بَيتُ بَيتَ الرَدى يا بَيتَ وَحشَتِيَه",37,"ت",3,0],["يا بَياضَ البَياضِ أَنتَ مِنَ الأَع","يُنِ وَالقَلبِ في سَوادِ السَوادِ",38,"د",1,1],["يَأبى لِعِرضِكَ أَن يُغادَرَ عُرضَةً","ما حَولَهُ مِن مالِكِ المُستَلحَمِ",39,"م",1,0],["يَأبى لِعِرضي أَن يَكونَ مُشَعَّثاً","جودٌ وَقاهُ بِطارِفٍ وَبِمُتلَدِ",40,"د",1,0],["يَأْبَى حَياةَ البائِدينَ لِقومهِ","ويَرى منايا الخالِدينَ فَيُقدِمُ",41,"م",1,0],["يأبى على البَطِرِ المُدِلِّ ببأسِه","ما استنَّ من عَنَتِ ومن عُدوانِ",42,"ن",1,0],["يَأبَى الأُلىَ خذلوا الكِنانةَ أن يَرَوْا","لبني الكِنانةِ في الشّدائدِ ناصرا",43,"ر",2,0],["يَأبى الضَراعَةَ إِلّا أَن يَدينَ بِها","لِواحِدٍ قاهِرِ السُلطانِ ديَّانِ",44,"ن",1,0],["يَأبى النَعيمَ مُلَطَّخاً بِمَذَلَّةٍ","وَيَرى مُقامَ السوءِ عاراً باقِيا",45,"ي",2,0],["يَأبى اِشتِدادَ الخَطبِ حينَ تَروضُهُ","عَزمٌ لَهُ النُوَبُ الشِدادُ تَلينُ",46,"ن",1,0],["يَأبَى الغَوِيُّ الرُّشدَ يرفعَ شأنَهُ","فإذا هوى ألفيتَهُ يَتأسَّفُ",47,"ف",1,0],["يَأبَى ليَ الغدرَ الوَفاءُ بذِمّتي","والذَّمَّ آبَاهُ كما يأبَاني",48,"ن",2,0],["يَأبى الفَتى إِلّا اتِّباعَ الهَوى","وَمَنهَجُ الحَقِّ لَهُ واضِحُ",49,"ح",1,0],["يَأبى لِهارونَ الخِلافَةَ عُنصُرٌ","مَحضٌ تَمَكَّنَ في المُصاصِ المُعرِقِ",50,"ق",1,0],["يَأبى البَلاءُ فَلا نَبغي بِهِم بَدَلاً","وَلا نُريدُ خَلاءً بَعدَ إِحكامِ",51,"م",1,0],["يأبى تأخرها قوم لهم شمم","وَبالرقيّ لهم دين وإيمان",52,"ن",1,0],["يَأْبَى عَلَى النَّاسِ إِنْ رَامُوا ظُلاَمَتَهُ","عُودٌ نَمَا في صَفَاةٍ ظَهْرُهَا عَارِي",53,"ر",2,0],["يأبى يَراعُك أن يُفارق راحةً","خُلِقَتْ لردِّ تحيّةٍ وسلامِ",54,"م",1,0],["يا بَينُ رَوَّعتَ قَلبي بِالفِراقِ وَما","أَبكي لِفُرقَةِ أَصحابٍ وَلا طَلَلِ",55,"ل",1,0],["يَأبَى لِيَ اللهُ خَونَ الأَصفياء وإن","خانُوا وِدادي لأَنِّي حاجِزي كَرَمي",56,"ي",1,0],["يَأْبَى لِيَ الْغَيَّ قَلْبٌ لا يَمِيلُ بِهِ","عَنْ شَرْعَةِ الْمَجْدِ سِحْرُ الأَعْيُنِ النُجُلِ",57,"ل",1,0],["يَأْبَى عَلَى مُصِيبَاتِ ال","حَلِيمِ أَنْ تَسْتَخِفَّهْ",58,"ف",2,0],["يَا بَيْنُ أَحْمَدَ قَدْ فَجَعْتَ الشَّرقَ فِي","رَجُلٍ يُفَدَّى مِثْلُهُ بِرِجَالِ",59,"ل",1,0],["يَأُبَى التَّعَمُّلَ كَاتِباً أوْ خَاطِباً","وَيُحِبُّ فِي الإنْشَاءِ غَيْرَ الحَالِي",59,"ل",2,0],["يَأْبَى عَلَيْكَ النُّبْلُ إِلاَّ أَنْ تُرَى","فِي أَوَّلِ الْوَافِينَ لِلزُّمَلاَءِ",60,"ا",2,0],["يَأْبَى عَلَى الْعَفَافِ مِنْهَا","وَصْفُ قَوَمٍ أَوْ نَعْتُ جِيدِ",61,"د",1,0],["يَأْبَى التَّشبُّه بِالدَّرَارِيءِ دُرُّهُ","وَكَأَنَّ نُورَ الشَّمْسِ فِيهِ نُضَارُ",62,"ر",1,0],["يأبى الجواب فما يراجع هيبةً","فالسائلون نواكسُ الأذقان",63,"ن",1,1],["يأبى عليه نِجاره","وإباؤه ألاّ يبادرْ",64,"ر",1,0],["يأبى لى َ الغى َّ لا يميلُ بهِ","عَنْ شِرْعَة ٍ الْمَجْدِ سِحْرُ الأَعْيُنِ النُّجُلِ",65,"ل",1,0],["يا بيْعةَ الحقِّ والرِّضوانِ، تلك يدي","الحُكْمُ للشَّعبِ بعدَ الواحد الصَّمدِ",66,"د",1,1],["يأبى عليَّ قرِيضي أن يصدِّقَني","إن قلت: أصبح بطنُ الأرض يُؤُويه!",67,"ي",2,0],["يأبى شعوريَ أن يلقاك عن كثب","إّلا بقافيةٍ تأتيك غراء",68,"ا",2,0],["يأبى دمٌ عربيٌ في عروقِهِمُ","أنْ يُصبِحَ العربيُّ الحرُّ 