udhabi.ae/diwan/poem/39673","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39567","الخفيف"],[72,"","https://poetry.dctabudhabi.ae/diwan/poem/41383","السريع"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21117","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42554","المتدارك"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42575","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42669","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42656","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42644","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42493","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54923","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55156","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54616","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54909","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55126","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55038","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54870","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54614","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54594","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54265","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[77,"يا ربة البيت الممنع جاره","https://www.poetsgate.com/ViewPoem.aspx?id=34095",""],[77,"بشرى تقوم لها الدنيا على قدم","https://www.poetsgate.com/ViewPoem.aspx?id=34158",""],[77,"زارت ونجم الدجى يشكو من الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=34208",""],[7,"كتمتكَ ليلاً بالجمومينَ ساهرا","https://www.poetsgate.com/ViewPoem.aspx?id=17564",""],[45,"كدت أقضي إذ غاب عني حبيب","https://www.poetsgate.com/ViewPoem.aspx?id=31403",""],[91,"أقوى من الشيب والهرم","https://www.poetsgate.com/ViewPoem.aspx?id=53237",""],[35,"سقى دمنتينِ لم نجدْ لهما مثلا","https://www.poetsgate.com/ViewPoem.aspx?id=22066",""]],"verses":[["فَأَهلاً بِعَينَيهِ وَإِن طَلَّتا دَمي","فَكَم مالِكٍ لَم يُرزَقِ العَبدُ عَدلَه",0,"ل",2,0],["فَآهٍ عَلى الدُنيا إِذ الجَدُّ صاعِدٌ","وَأَوهِ مِنَ الدُنيا إِذا النَعلُ زَلَّتِ",1,"ت",1,0],["فأهْوى إليها وهْوَ طاوٍ وعِنْدَهُ","أُزَيْغِبُ مُصْفَرُّ الشّكيرِ ضَئيلُ",2,"ل",1,0],["فآهاً منَ البَرْقِ الذي بَزَّ ناظِري","كَراهُ وأسْرابُ الدُّموعِ هُمولُ",2,"ل",1,0],["فأهْدى إليكَ الشِّعْرَ حُلْواً مَذاقُهُ","تَضُمُّ قوافِيهِ الجُمانَ المُنَظَّما",3,"م",2,0],["فَاِهرُب بِنَفسِكَ وَاِستَأنِس بِوِحدَتِها","تَبقى سَعيداً إِذا ما كُنتَ مُنفَرِدا",4,"د",2,0],["فاهْزُز برُعْبِكَ قبلَ الجيْشِ ما جمَعوا","واضْرِبْ بسَعْدِكَ قبل الصّارمِ الذَّلِقِ",5,"ق",1,0],["فاهْتَزّتْ حينَ أتى ورَبَتْ","وأسالَ بِها ماءً غدَقا",6,"ق",2,0],["فَآهٍ عَلَى نَفْسِي أُرَدّدُهَا أَسىً","لِوَخْطٍ أضَاءَتْ لَيْلَ فَوْدِي نُجُومُهُ",7,"م",2,0],["فَاهْنَأ بِهِ صُنْعاً جَمِيلاً وَارْتَقِبْ","مِنْ بَعْدِهِ إِتْيَانَ صُنْعٍ أَعْظَمِ",8,"م",1,0],["فَأَهْنَأْ بِغُرَّةِ سَعْدٍ طَالِعٍ لِبَنِي","سَعْدٍ بِعِزٍّ جَدِيدٍ غَيْرِ مُنْصَرِمِ",9,"م",1,0],["فَاهْتَزَّ لِلْحَرْبِ الْكَمِيُّ بَساَلةً","وَاهْتَزَّ فِي مِحْرَابِهِ الْمُتَبَتِّلُ",10,"ل",1,0],["فَاهْنَأَ بِمَوْصُولِ الْفُتُوحِ فإِنَّمَا","هِيَ سُنَّةٌ مَا إِنْ لَهَا تَبْدِيلُ",11,"ل",1,0],["فاهْتزّتِ الأغْصانُ منْ فوقِهِ","وصاحَتِ الأطْيارُ في إثْرِهِ",12,"ه",1,0],["فاهْتزّ نبْتُ الأرضِ بعْدَ سُكونِهِ","نشّاً وفُكَّ منَ الرُّغامِ إسارُهُ",13,"ر",2,0],["فاهْزُزْ ظُبى النّصْرِ العَزيزِ فإنّ مَنْ","عاداكَ مَطلولُ النّجيعِ جُبارُهُ",13,"ر",2,0],["فاهْنَأْ بهِ في الدّهْرِ أسْعَدَ قابِلٍ","طَلَعَتْ بعِزِ المُسْلِمينَ سُعودُهُ",14,"د",2,0],["فَأَهلي فِداؤُكَ يَومَ الجِفا","رِ إِذ تَرَكَ القَيدُ خَطوي قَصيرا",15,"ر",2,0],["فَاِهنَأ بِمَنزِلِكَ الجَديدِ وَنَم بِهِ","في غِبطَةٍ وَاِنعَم بِخَيرِ جِوارِ",16,"ر",1,0],["فَاِهنَأ بِما نِلتَ مِن فَضلٍ وَإِن قُطِعَت","بَيني وَبَينَكَ بَعدَ اليَومِ أَسبابُ",17,"ب",1,0],["فَاِهنَأ بِمُلكِكَ يا حُسَينُ فَعَهدُهُ","عَهدٌ بِتَحقيقِ الرَجاءِ كَفيلُ",18,"ل",1,0],["فَأَهلاً بِالدَليلِ إِلى المَعالي","أَلا سِر يا حُسَينُ وَنَحنُ نَتلو",19,"ل",2,0],["فَأَهلاً وَسَهلاً بِالَّذي شَدَّ وَصلَنا","وَلا مَرحَباً بِالقائِلِ اِصرِم لَها حَبلا",20,"ل",2,0],["فاهنأ بزوجك واسعدا وردا","ورد المنى صفو مدى العمر",21,"ر",1,0],["فَأَهْلاً بِالَّتِي آبَتْ بِفَوزٍ","يُكَلِّلُهَا بِإِكْلِيلٍ سَنِيِّ",22,"ي",1,0],["فَاهْنَئِي أَيُّهَا العَرُوسُ وَيَا ابْنَ","العَمِّ فَاغْنَمْ سَعْدَ القِرَانِ وَيُمْنَهْ",23,"ن",2,0],["فَاهْتَزَّتِ الغَبْرَاءُ حَتَّى صَافَحَتْ","عَذَبَاتِ سَرْحَتِهَا مَنَابِتُ نَجْمِهَا",24,"م",3,0],["فَاهْنَأْ بِقُرْبِكَ مِنْهُ يَا صِدْقِي وَنَلْ","مَا شِئْتَ فَخْرٍ وَرِفْعَةِ شَانِ",25,"ن",1,0],["فَاهْنَأْ بِمَالَكَ مِنْ مَحَبَّةِ أُمَّةٍ","وَتَجِلَّةٍ زَكَّاهُمَا لُبْنَانُ",26,"ن",1,0],["فَاهْنَأْ وَسَعْدٌ خَيْرُ مُبْتَدِيءٍ","بِجَدِيدِ تَقْدِيرٍ مِنَ الوَطَنِ",27,"ن",1,0],["فَاهْنَأْ بِمَا نِلْتَ حَقّاً مِنْ مَكَافَأَةٍ","هَيْهَاتَ يَعْدِلُهَا غَالٍ مِنَ الثَّمَنِ",28,"ن",1,0],["فَاهْنَأْ بَهَا وَلَكَ المَعَالِي بَعْدَهَا","أَبْرَاجُ سَعْدٍ بَيْنَهَا تَتَنَقَّلُ",29,"ل",1,0],["فَاهْنَأْ بِهِ وتَمَلَّهُ","شَرفاً لِجِيلٍ بَعْدَ جِيلِ",30,"ل",1,0],["فَأَهدَأَ ريحَهُ قَدَرُ المَنايا","وَقَد كانَت لَهُ ريحٌ عَصوفُ",31,"ف",1,0],["فَأَهلاً وَسَهلاً بالَّتي حَلَّ حبُّها","فؤادي وحلَّت دارَ شَحطٍ من النَّوى",32,"ا",1,0],["فاهنأ بما شئت من صنع تُسَرُّ به","وانْو الأمانيَّ فالأقدار تُدنيها",33,"ي",3,0],["فاهنأ بعيد عاد يشتمل الرضى","جذلان يرفلُ في حلى استبشارِ",34,"ر",1,0],["فاهُنَ في غبطةٍ وعزة مُلْكٍ","أنت والله فخر هذا الوُجودِ",35,"د",1,0],["فاهنأ بملك واعتمد شكراً به","لطفَ الإله وصنعَه تَتَخَوَّلُ",36,"ل",1,0],["فاهنأ ودم عيشة راضيه","رغم المعادي وسرور الحميم",37,"م",1,0],["فأهلاً بالحكيم وألف أهل","بمَن لازال مُرشِد كل غاو",38,"و",1,0],["فاهتزّ لابنٍ أبٌ قي قبره وغدا","يبدي الحفاوة خير ابن لخير أب",39,"ب",1,0],["فَأَهلُكَ مَن أَصفى وَوُدُّكَ ماصَفا","وَإِن نَزَحَت دارٌ وَقَلَّت عَشائِرُ",40,"ر",1,0],["فَأَهلَكَ رَبّي يا عُتَيبَ بنَ مالِكٍ","وَلَقّاكَ قَبلَ المَوتِ إِحدى الصَواعِقِ",41,"ق",1,0],["فآهاً لعلاَّت الروادف برَّحت","بأكباد قومٍ مستنين عجاف",42,"ف",1,0],["فآه من عاطل صبرٍ مضى","والحمد لله على كلِّ حا",43,"ح",2,0],["فآهاً عليه راحت وظيفته","فهو على الحالين يأكل اللّجما",44,"م",2,0],["فاهْنأ به وبألفٍ مثله أمماً","وأنتما في بروجِ السعد إلفانِ",45,"ن",1,0],["فاهجُني إنما هجاؤك عندي","ضَحكاتٌ تَزيد في السرّاءِ",46,"ا",2,0],["فَاهُ الخبيثَ ومَنخِرَيْ","هِ وفقحةً منهُ رُحابهْ",47,"ب",2,0],["فأهْوِنْ عليكم في المعالي ونَيْلِهَا","هناكَ بما يَدْمَى ومَا يَتَقَصَّدُ",48,"د",1,0],["فأهِبْ بشاردهم إليك وأرْوِهِمْ","من جَمَّةٍ يُروَى بها الورَّادُ",49,"د",1,0],["فاهرُبْ وأينَ بهاربٍ من طالبٍ","في كلِّ مُطَّلعٍ له مرصادُ",50,"د",1,0],["فأهداه لي أهدى له الله نعمةً","محصَّنةً من سوء دَوْر الدوائر",51,"ر",1,0],["فاهْتِك المَطْلَ بالوفاءِ كما يه","تِك مُحْلَولِكَ الدُّجَى إشراقُكْ",52,"ك",1,0],["فأهدى لهم مِدحةً حسْرةً","لتقصيرهِم عن مَدى الكاملِ",53,"ل",1,0],["فأَهِبُّ قد وجب الطهورُ ولم أنَلْ","ممَّنْ هويت سوى جوىً وسقامِ",54,"م",1,0],["فاهتبلْ أجْر وقفها واتخذها","لك فخراً في دولة المُستعين",55,"ن",1,0],["فَاِهتاجَ مِن فَزَعٍ وَسَدَّ فُروجَهُ","غُبرٌ ضَوارٍ وافِيانِ وَأَجدَعُ",56,"ع",1,0],["فَاِهتَم لِنَفسِكَ يا جُمَيعُ وَلا تَكُن","لِبَني قَريبَةَ وَالبُطونِ تَهيمُ",57,"م",1,0],["فَأَهوى لَها ما لا تَرى وَتَحَرَّدَت","وَقَد فَرَّقَت ريشَ الذُنابى المَخالِبُ",58,"ب",1,0],["فَاِهتَزَّ قَلبي كَما تَهتَزُّ نابِتَةٌ","في القَفرِ مَرَّ عَلَيها النورُ وَالنَسَمُ",59,"م",1,0],["فَاِهجُري المَخدَعَ الجَميلَ وَزوري","ذَلِكَ القَبرَ ثُمَّ حَيِّ قَطينَه",60,"ن",2,0],["فاهدمْ فؤادي ما استطعتَ فانَّهُ","سيكون مثلَ الصَّخرة الصَّمَّاءِ",61,"ا",2,0],["فَاِهتاجَ قَلبي لِحُزنٍ قَد يُضَيِّقَهُ","فَما أُغَمِّضُ غُمضاً غَيرَ تَهياعِ",62,"ع",1,0],["فأهلا بالأمير وما رأينا","هلالا تستقرّ به الركاب",63,"ب",1,0],["فاهنأ مكانك واهنأ ما يلوح به","لرب يلدز من آثار إحسان",64,"ن",1,0],["فَاِهنَأ أَخي بِوُفودِها","وَتَلَقَّ تَهنِئَةَ الحَميمِ",65,"م",1,0],["فَاِهنَأ بِطالِعِهِ السَعيدِ يَزينُهُ","عيدُ الفَقيرِ وَلَيلَةُ الأَرزاقِ",66,"ق",1,0],["فَأَهيني أَو أَكرِمي فَلَعَمري","ما لِأُنثى سِواكِ عِندي نَصيبُ",67,"ب",1,0],["فَأَهوِن عَلَيَّ بِتِلكَ الدُمو","عِ تَرَقرَقَ في الخَدِّ أَو تَنحَدِر",68,"ر",1,0],["فَأَهلاً وَسَهلاً بِالإِمامِ وَقادِمٍ","أَتَت بِالسُرورِ كُتبُهُ وَرَسائِلُه",69,"ل",2,0],["فَأَهوى وَناباها حَوالَي يَتيمَةٍ","هِيَ المَوتُ أَو دُنيا يُنادي بَشيرُها",70,"ر",3,0],["فَاِهجُر دِيارَ بَني سَعدٍ فَإِنَّهُمُ","قَومٌ عَلى هَوَجٍ فيهِم وَتَهشيمِ",71,"م",1,0],["فاهتزَّ جِسمُكَ مثلَما","يَهتَزُّ ماضي الحدِّ باتِر",72,"ر",1,0],["فَأَهلاً وَسَهلاً بَضَيفٍ نَزَل","وَاِستَودَعَ اللَهُ إِلفاً رَحَل",73,"ل",1,1],["فَأَهمَلتُ واجِبَ سَعيي إِلَيكَ","وَما كُنتُ عِندَكَ بِالمُهمَلِ",74,"ل",1,0],["فاهنآ إنكما ح","قاً سواء في السمات",75,"ت",1,0],["فَاِهتَصِرنا مِنَ الحَديثِ ثِماراً","ما جَنى مِثلَها لَعَمرُكِ جانِ",76,"ن",1,0],["فَأَهوَت تَخُرُّ هُناكَ البُنى","كَما تَتَلَقّى المُلوكُ الوُفود",77,"د",1,0],["فَآهٍ طَويلاً ثُمَّ آهٍ لِكَبرَةٍ","بَكَيتُ عَلى عَهدِ الشَبابِ بِها دَما",78,"م",2,0],["فأهلاً بالشَّوِيِّ تُساقُ نَهْباً","وأهلاً بالجِمالِ وبالنِّياقِ",79,"ق",1,0],["فاهتاجَ عكرمةٌ وقال أهكذا","يَهِنُ الزعيمُ ألا تُقيم لياليا",80,"ي",2,0],["فَاِهنَأ فَلَو أَنَّ الكَواكِبَ خُيّرَت","لَأَتَتكَ مِنها لِلثَناءِ وُفودُ",81,"د",1,0],["فاهدأي يا عواصفُ","خجلاً من جراءتِهْ",82,"ه",1,0],["فَأَهلَكَني ما أَهلَكَ الناسَ كُلَّهُم","صُروفُ المُنى وَالحِرصُ وَاللَوُّ وَاللَيتُ",83,"ت",1,0],["فَاِهتَبِل عِندِيَ النَصيحَةَ وَاِذخَر","ني لِقَولٍ أُجيدُهُ وَأُجِدُّه",84,"د",2,0],["فَأَهرَمَني بِلا كِبَرٍ","وَبَثَّ الشَيبَ في شَعري",85,"ي",1,0],["فَاهتَدى ساري الظَلامِ بِها","كَاهتِداءِ السَفرِ بِالعَلَمِ",86,"م",1,0],["فَاِهجُرِ الشَوقَ إِلى رُؤيَتِها","أَيُّها المَهجورُ إِلّا في الحُلُم",87,"م",1,0],["فَاِهتَزَّتِ الأَرضُ إِذ طابَت مَشارِبُها","وَحَنَّتِ الوَحشُ وَالأَنعامُ وَالشَجَرُ",88,"ر",1,0],["فَأَهلي فِداءٌ لِاِمرِئٍ إِن أَتَيتُهُ","تَقَبَّلَ مَعروفي وَسَدَّ المَفاقِرا",89,"ر",2,0],["فَاِهجُر صَديقَكَ إِن خِفتَ الفَسادَ بِهِ","إِنَّ الهِجاءَ لَمَبدوءٌ بِتَشبيبِ",90,"ب",1,0],["فَأَهنَأُ غَيمٍ جادَ في الأَرضِ نائِلاً","غَمامٌ سَقاها في صَمو