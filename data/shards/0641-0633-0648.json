,"https://www.poetsgate.com/ViewPoem.aspx?id=12930",""],[5431,"وسوريٌ تمجده الخصالُ","https://www.poetsgate.com/ViewPoem.aspx?id=185127",""],[5667,"يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=214888",""],[5689,"ترى يطب بي شعبي رجوعي لغيله","https://www.poetsgate.com/ViewPoem.aspx?id=143430",""],[5691,"هراوة أمريكا","https://www.poetsgate.com/ViewPoem.aspx?id=206339",""],[5791,"ميقات نرد ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208602",""],[5818,"البنات كالنبات","https://www.poetsgate.com/ViewPoem.aspx?id=181760",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[6052,"روضة الايمان","https://www.poetsgate.com/ViewPoem.aspx?id=35138",""],[6084,"أبا موسى اليك شددت رحلي","https://www.poetsgate.com/ViewPoem.aspx?id=170864",""],[6093,"حُوارٌ مَعَ نَاقِدٍ ( الهَزَج )","https://www.poetsgate.com/ViewPoem.aspx?id=187204",""],[5309,"رأيت الفتى يسعى ليذكر بره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573699",""],[5126,"تأمل! فلا سرّ لديك ولا جهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87800&r=&rc=15",""],[5126,"فلسطين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87828&r=&rc=43",""],[6343,"نفس من النفس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1972&r=&rc=2",""]],"verses":[["فَسَوفَ تَراني طائِراً في غُبارِها","عَلى سابِحٍ تَهفو غَدائِرُ لِمَّتي",0,"ت",2,0],["فَسَواءٌ في تُرابِ الشَرقِ أَم","في تَرابِ الغَربِ كانَ المُستَقَر",1,"ر",1,0],["فَسَوفَ يُرضيكَ ثَأرٌ","يُذيبُ قَلبَ الجَمادِ",2,"د",1,0],["فَسَوَّدُوا أَوْجُهَ أَحْكَامِهِمْ","وَابْيَضَّ وَجْهُ الفَاضِلِ المُتهَمْ",3,"م",1,0],["فَسَوفَ يُعطيكُم حُنَينِيَّةً","يَلتَذُّها الأَمرَدُ وَالأَشمَطُ",4,"ط",1,0],["فسوف تكفّ عنهن الليالي","مطامع ساسة متحكمينا",5,"ن",2,0],["فسوف على الرغم من أوربا","نقوم لها فَيلقاً فيلقا",6,"ق",2,0],["فسوف يَحْتَزّ منه عُنقه جَزَعاً","ولا أقول سيُدمى كفّه ندما",7,"م",2,0],["فسوف يقرع كل سِنّةُ ندماً","ويُسبل الدمع في الخدين مسكوبا",8,"ب",2,0],["فسوف تحمدك الأوطان شاكرةً","وسوف يذكرك التأريخ مفتخرا",9,"ر",2,0],["فسوف بحول الله أرأب صدعهم","وأغزو العدى فيهم على الضمّر الجرد",10,"د",1,0],["فَسَوَّدَ بِشرَ اِبنَ البَراءِ بِجودِهِ","وَحَقَّ لِبِشرِ اِبنِ البَرا أَن يُسوَّدا",11,"د",2,0],["فَسَوفَ يَرَونَ النَصرَ يَوماً عَلَيهُمُ","بِقَتلِ الَذي تَحميهِ دونَ الحَرائِمِ",12,"م",1,0],["فسوء الفعل يردفُ سوء قول","ونتْنُ الثوم يردف نتنَ لوم",13,"م",1,0],["فَسَوفَ تَقولُ إِن هِيَ لَم تَجِدني","أَخانَ العَهدَ أَم أَثِمَ الحَليفُ",14,"ف",1,0],["فَسَوّى في الشَريعَةِ حافِرَيهِ","وَدارَت إِلفُهُ مِن حَيثُ دارا",15,"ر",2,0],["فسواءٌ على الطُّيورِ إِذا غنَّ","تْ هُتافُ السَّؤُوم والمُسْتَعيدِ",16,"د",1,0],["فَسَوفَ أُورِدُ رمحي","عَلَيهِ قَلب الكَميِّ",17,"ي",1,0],["فَسَوفَ تُحِلُّ الخَليطَ القَريبَ","دَواعي النَوى في مَحَلٍّ بَعيدِ",18,"د",1,0],["فسوفَ أستشعرُ الجميلَ مِنَ الصْ","صَبْرِ عسى اللهُ منه يَرزُقُها",19,"ق",3,0],["فسُودِ اللَّيالي من بَنِيَّةِ جَعْفَرٍ","فَدِمنَةِ آثارِ الخليفةِ أحمدِ",20,"د",1,0],["فَسَوفَ يَجزيهُمُ إِن لَم يَمُت عَجَلاً","كَيلاً بِكَيلٍ جَزاءً غَيرَ مَغبونِ",21,"ن",1,0],["فَسِواكَ مَن يَرضى بِفِعلِ دَنِيَّةٍ","يَشكو الصَديقَ مِنَ المِطالِ فَيَشكُلُ",22,"ل",1,0],["فَسَوفَ أَسوءُ نَفسي بِاِنقِطاعي","بِحيثُ أُسِرُّ نَفسَكَ بِاِرتِحالي",23,"ل",2,0],["فَسَوفَ تَعرِفُ مِقداري إِذا سَمِيَت","نُفوسُهُم وَاِنقَضى مِن وَصلِكَ الغَرَضُ",24,"ض",1,0],["فَسَوفَ تَرثيكَ مِنّي كُلُّ قافِيَةٍ","بِها لِذِكرِكَ بَينَ الناسِ تَخليدُ",25,"د",1,0],["فَسَوفَ يَعتادُهُما","مِنّي اِمرُؤٌ مَحضُ الوَلا",26,"ا",1,0],["فَسَوفَ أُجيدُ النَظمَ فيكَ وَأَنثَني","إِلى النَثرِ إِن أَفنى النِظامُ القَوافِيا",27,"ي",2,0],["فَسَوفَ أُصفيكَ مَحضَ المَدحِ مُجتَهِداً","فَالخَلقُ تَفنى وَهَذا إِن فَنيتُ بَقي",28,"ق",2,0],["فَسَواءٌ بَينَ إِخوانِ الصّفا","وذَوي اللَّهوِ مَغيبي والحُضور",29,"ر",1,0],["فسوقي إليّ جهامَ السحاب","لأملأهنّ من الدمع ماءَ",30,"ا",2,0],["فَسَوفَ يُثبِتُ رُكنَ المَدحِ فيكَ أَخٌ","لَولا رَجاؤُكَ لَم يَثبُت لَهُ قَدَمُ",31,"م",1,0],["فَسَواءٌ إِجابَتي غَيرَ داعٍ","وَدُعائي بِالقَفرِ غَيرَ مُجيبِ",32,"ب",1,0],["فَسَوَادِي بِمِصْرَ ثَاوٍ وَقَلْبِي","فِي إِسَارِ الْهَوَى بِأَرْضِ الشَّآمِ",33,"م",1,0],["فَسُودوا في الممالكِ واستَبِدُّوا","بتيجانِ الملوكِ المُعوزِينا",34,"ن",2,0],["فَسَوفَ إِذا فَكَّروا يَعلَمُونَ","أَجَيبُكَ أَم جَيبُهُ أَنصَحُ",35,"ح",1,0],["فَسوقُ الإِبلِ حَيثُ تُسا","قُ فيهِ الخَيلُ تَطَّرِدُ",36,"د",1,0],["فَسَوفَ تَلقى بِها الآمالَ واسِعَةً","إِذا أَجَزتَ مَداً مِنها رَأَيتَ مَدى",37,"د",2,0],["فسواء أردت أم","لم أرد سوف أكفر",38,"ر",1,0],["فَسَوفَ أبرح بيتاً","إليه كنت أويت",39,"ت",1,0],["فسوف يُلقيه خفيُّ القضا","مُحطّما فوق الصخور الصلابْ",40,"ب",1,0],["فسواءٌ في مسمعي من ذَراهُ","صدحةُ الطير أو نعيقُ الغرابِ",41,"ب",1,0],["فَسَوفَ يُرى مِنها اِشتِياقٌ وَلَوعَةٌ","بِبَينٍ وَغَربٌ مِن مَدامِعِها يَجري",42,"ر",2,0],["فَسَوفَ يُرى مِنها صُدودٌ وَلَم تَكُن","بِنَفسِيَ مِن أَهلِ الخِيانَةِ وَالغَدرِ",42,"ر",1,0],["فَسَوفَ تَرى إِن كُنتُ بَعدَكَ باقِياً","وَأَمكَنَني دَهرٌ وَطَولُ زَمانِ",43,"ن",1,0],["فَسَوادُ اللَّيْلِ مَا إِنْ يَنْقَضِي","وَبَيَاضُ الصُّبْحِ مَا إِنْ يُنْتَظَرْ",44,"ر",1,0],["فَسَوْفَ تَصْفُو اللَّيَالي بَعْدَ كُدْرَتِها","وَكُلُّ دَوْرٍ إِذَا ما تَمَّ يَنْقَلِبُ",45,"ب",1,0],["فَسَوْفَ يَبِينُ الحَقُّ يَوْماً لِنَاظِرٍ","وَتَنْزُو بِعَوْرَاءِ الْحقُودِ السَّرائِرُ",46,"ر",1,0],["فَسودٌ مِنَ التَكحيلِ حُمرٌ مِنَ البُكا","عَلَيكَ وَملسٌ مِن نَعيمِ الصبا حَرشُ",47,"ش",1,0],["فسوقُ الرِّق لم يكسُد ولكن","تبدَّلَ فيه بيعٌ أو شِراء",48,"ا",2,0],["فسوف يدوِّرُ \" ساعاتِكم \"","بما لا يَسُرُّكُمُ \" عقرب \"",49,"ب",1,0],["فسوفَ تلقى بها الآمالَ واسعةً،","إذا أجزْتَ مدًى منها رأيتَ مَدا",50,"د",2,0],["فسوف ترى إن رَدَّتِ الأوْسُ حِلْفَها","وزالتْ وأَحسابُ الرجالِ تَزَيَّلُ",51,"ل",1,1],["فسوف أخزيه في النادِى وألبسه","بين البرية مِن سوءاته حُلَلاَ",52,"ل",2,0],["فَسؤَالِ الضَّيفش مَنقَصَةٌ","وَخنًى عِندَ الأَلبَّاءِ",53,"ا",2,0],["فَسَوفَ نَجزيهمُ إِن لَم يَمُت عَجِلاً","كَيلاً بِكَيلٍ جَزاءً غَيرَ مَغبونِ",54,"ن",1,0],["فسوفَ يُورِقُ عُودي إن بنيتُ على ال","مطيِّ من شجراتِ الميسِ عيدانا",55,"ن",2,0],["فَسَوفَ تَرونَ الشَمسَ قَد غالَ نُورُها","نُجُوماً مُسَمّاةً وَبَدرِ كَمالِ",56,"ل",1,0],[