.com/ViewPoem.aspx?id=184531",""],[4755,"صَيرُورَة","https://www.poetsgate.com/ViewPoem.aspx?id=184574",""],[4908,"دروب الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=207389",""],[4968,"نافورة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=208099",""],[3647,"وما اسمٌ اصلهُ نَبتٌ","https://www.poetsgate.com/ViewPoem.aspx?id=125688",""],[5050,"أسعد الأقوام في الحرب البطل","https://www.poetsgate.com/ViewPoem.aspx?id=38205",""],[5104,"فاسألوا عنه غامضات المعاني","https://www.poetsgate.com/ViewPoem.aspx?id=38510",""],[5246,"المرء لابد عن دنياه منتقلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187092",""],[5376,"بلقيس ألقت جمالا من خمائلها","https://www.poetsgate.com/ViewPoem.aspx?id=189751",""],[5442,"إذا البرق من تلقاء كاظمة عنا","https://www.poetsgate.com/ViewPoem.aspx?id=114776",""],[5558,"أردْتُ قطاف النجم من جانب البدْر","https://www.poetsgate.com/ViewPoem.aspx?id=211688",""],[5616,"قنديل","https://www.poetsgate.com/ViewPoem.aspx?id=205034",""],[5677,"مقادير","https://www.poetsgate.com/ViewPoem.aspx?id=179849",""],[5848,"فرصه","https://www.poetsgate.com/ViewPoem.aspx?id=53200",""],[5937,"هاربٌ مِن سَدِّ مَأرِب","https://www.poetsgate.com/ViewPoem.aspx?id=211810",""],[5974,"أُسْتَاذي","https://www.poetsgate.com/ViewPoem.aspx?id=200426",""],[6093,"على قدر اهتمامك سوف تزهر","https://www.poetsgate.com/ViewPoem.aspx?id=213345",""],[6131,"عَينايَ زرقاءُ اليَمامةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189287",""],[6152,"الصلاة على خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=204528",""],[6256,"المعارف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65931&r=&rc=19",""],[2220,"أسماءُ أسمائهِ الحسنى التي تبدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11317&r=&rc=191",""],[6305,"رؤى في أخريات الطريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87346&r=&rc=19",""],[6336,"من بعيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73556&r=&rc=17",""],[6355,"الفجر خصيمي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66665&r=&rc=125",""]],"verses":[["وَإِنَّ أُسوداً كُنتُ شِبلاً لِبَعضِها","لَمَحقوقَةٌ أَن لا يُذَلَّ قَتيلُها",0,"ل",3,0],["وَإِن أَسرى يَوَدُّ الأُف","قُ أَنَّ البَدرَ ضامِرُه",1,"ر",2,0],["وَإِن أَسلَم يَمُت قَبلي حَبيبٌ","وَمَوتُ أَحِبَّتي قَبلي يَسوِني",2,"ي",1,0],["وإنْ اسْتَرَبْتِ سَلي شُهودَ مَدامِعي","قدْ صحَّ مَنْ في وَجْنَتَيْهِ شُهودُهُ",3,"د",2,0],["وَإِن أَستَطِع صَبراً فَمِن شيمَتي الصَبرُ","وَإِن يَكُ رُزأً ما أَصابَ بِهِ الدَهرُ",4,"ر",1,0],["وَإِنّا سَوفَ تُدرِكُنا المَناي","مُقَدَّرَةً لَنا وَمُقَدَّرينا",5,"ن",2,0],["وإن أسنَدَتُ ما بين نجد وحاجر","تقول رواةُ الشرق يا حبذا الغربُ",6,"ب",1,0],["وَإِن أَسلَم فَقَرضٌ سَوفَ يوفى","وَأَتبَعَكُنَّ إِن قَدَّمتُكُنَّه",7,"ن",2,0],["وإن أساء فأوجِبْ قتلَهُ قَوَداً","بمن يُميتُ إذا أبقى على السلبِ",8,"ب",1,0],["وأنَاسٍ تعرَّضُوا لعُرامي","فاجتواهم وحدُّه مَذْروبُ",9,"ب",1,0],["وأنَّ استه كانت تجود بمالها","وتعطي العطايا مَن عَلاها فتُكثِر",10,"ر",1,0],["وإن استرحت إلى السكوت فما","لك فيه من لؤم الكرام دعه",11,"ع",2,0],["وإن استترتَ بقحبةٍ","لك عند ناكتها طوائلْ",12,"ل",1,0],["وإن استحوذ الشقاءُ عليكم","فلساني بما وأيتُ رَهيني",13,"ن",2,0],["وأن أساق صاغراً","بين يد المتقم",14,"م",1,0],["وَإِن أَسلَم فَما أَبقى وَلَكِن","سَلِمتُ مِنَ الحِمامِ إِلى الحِمامِ",15,"م",1,0],["وإنْ أسْلُ يوماً عنكِ أسْلُ ضرورةً","وإلّا فإنّي عن قريبٍ على الأِثْرِ",16,"ر",1,0],["وإنِ استَمَرَّ به الفَسادُ فخَلِّهِ","فالغُصْنُ يُقْطَعُ للفسادِ الزائدِ",17,"د",1,0],["وَأُناسٌ إِن ضَيَّعَ المَجدُ قَومٌ","حَفِظوا المَجدَ أَن يُضيعوا طِلابَه",18,"ب",2,0],["وَإِنِ اِستِطاعَتهُ المَنونُ فَبَعدَ ما","دَخَلَت عَلى الآسادِ في الأَخياسِ",19,"س",1,0],["وَإِنِ اِستَوَت لِلنَملِ أَجنِحَةٌ","حَتّى يَطيرَ فَقَد دَنا عَطَبُه",20,"ب",2,0],["وَإِنَّ أَسمَجَ مَن تَشكو إِلَيهِ هَوىً","مَن كانَ أَحسَنَ شَيءٍ عِندَهُ العَذَلُ",21,"ل",1,0],["وَإِنِ اِستَجَرتَ بِهِ اِستَجَرتَ بِهَضبَةٍ","مَأوى الطَريدِ بِها وَكَنزُ المُعدَمِ",22,"م",1,0],["وَإِنّا سَوفَ تُدرِكُنا المَنايا","مُقَدَّرَةً لَنا وَمُقَدَّرينا",23,"ن",2,0],["وَأُناس صَحِبْتُ مِنْهُمْ ذِئَاباً","تَحْتَ أَثْوَابِ أُلْفَةٍ وَوِدَادِ",24,"د",1,0],["وأنّ اسمها بنت الملوك وأنّها","تبيع بأسواق الرفيق أباها",25,"ا",3,0],["وإن استقلتَ أقلتُها وجزاؤها","منّى مَثوبةُ تائبٍ من غافرِ",26,"ر",1,0],["وَإِنِ اِستَعجَمَ المَقالُ فَذي الأَف","عالُ قَد أَصبَحَت بِهِ فُصَحاءَ",27,"ا",2,0],["وَإِنَ اِستَنفَدَت جَرائِمَهُ الرَح","مَةَ فَاِصفَح حَميَّةً وَإِباءَ",27,"ا",2,0],["وَإِن أَسِدَت ذُؤبانُ ذُبيانَ فَاِحتَمَت","فَكَم رَوَّعَت مِن طَيِّئٍ روعَ أَروَعا",28,"ع",2,0],["وإن أساء علينا الجار عشرته","نبين عنه بلا ضرٍّ ولا ضرَر",29,"ر",1,0],["وَ إنِ اسْتَنَرْتَ بِوَمْضِ فِطْرَةِ كَامِنٍ","بَبَصِيرَةٍ تَرْجُو العلاَ بِجِنَانِ",30,"ن",1,0],["وَإِن اِستَطَعتَ عَلى الصَّبابَةِ وَالأَسى","فَأَعِنهُ تَحظَ بِوُدِّهِ وَإِخائِهِ",31,"ا",3,0],["وَإِنِ اِستَطَعتَ غَداةَ داعِيَةِ النَوى","فَاِجعَل لِدَمعِكَ في الدِيارِ سَبيلا",32,"ل",2,0],["وإن أَسمَعَتنِى دَعوَةً لأَجبُتها","أُلبِّى سُلَيمَى قَبلَ كُلِّ مُجِيبِ",33,"ب",1,0],["وأناس ما بين غر جهول","وسفيه على الكرام تهجم",34,"م",1,0],["وأنا سنذكره فاضلا","على الجبن والملق استكبرا",35,"ر",2,0],["وإن استوى لكما نديم ماجد","مثلي فحسبي قهوةٌ ومُدام",36,"م",1,0],["وإِن أَساؤوا الأَدَبا","كَي لا يَروكَ مُغضَبا",37,"ب",2,0],["وأناس لم يمتطوا الأرض إلا","ليزيدوا أهل الحميم عويلا",38,"ل",2,0],["وَأُناسٌ غَرَّني ظَاهِرُهُمْ","وَجَوَى بَاطِنِهمْ كُلُّ مُعِيبَه",39,"ه",1,1],["وَإنْ اسْتَقْللْتَ أَنْ تُفْدَى بِنَا","فَبِكَبشٍ قَدْ فَدَى اللَّهُ الذَّبِيحَا",40,"ح",2,0],["وأنا سَوف نَجعلُ موليينا","مكان الكليتين من الطحالِ",41,"ل",1,0],["وأنا سوف أَهجُرُ القافَ والرّا","ءَ معَ الضّادِ من حُروفِ الهِجاء",42,"ا",2,0],["وَإِن أَساءَت بِنا الدُنيا وَما اِعتَذَرَت","مِنّا فَإِنَّكَ تُعطينا وَنعَتَذِرُ",43,"ر",1,0],["وأن أَسيافك من غَيظِها","ما طَعمتْ أجفانها غَمْضَا",44,"ض",2,0],["وإنْ أساءَ مُسيءٌ فلْيَكنْ لكَ في","عُروضِ زَلَّتِهِ صَفْحٌ وغُفرانُ",45,"ن",1,0],["وإن أساءت فعالي","فإن عفوك أعظم",46,"م",1,0],["وإن أسلمته للمنون فطالما","غدا جاره الأقصى يجير على الدهر",47,"ر",1,0],["وإنا سلالة ماء السماء","فرعنا عُلا باذخات الرتب",48,"ب",1,0],["وإِنْ أَسْبَلَتْ شَكْوَاكَ دَمْعَ أَبِيِّها","فقد أَرْقَأَتْ بُشْراكَ عَيْنَ أَسِيفِها",49,"ف",3,0],["وإن أسيىء إلى عليائها كشفت","للناس عن كبرياء الجاهل الحرد",50,"د",1,0],["وإن استغنيتِ عن وك","ف حياً غيرِ حياكِ",51,"ك",1,0],["وإنْ استطع من فرض حبي لانقضى","زماني في شكريك واللهُ شاهدُ",52,"د",1,0],["واِنْ أسدلَ الليلُ البهيمُ ستورَه","سَرَى عَنَقاً في البيدِ يَعْسِلُ كالطَّملِ",53,"ل",1,0],["وَإِن أَسهبت أَو أَطنَبَت فيما","بِهِ أَمعَنَت كانَ العَجز شاني",54,"ن",2,0],["وإن اسقطت المقدم إنه","يسمى حروفا للنحاة كحلتي",55,"ت",2,0],["وأن اسمك المشتق من شد أزرها","إذا اشتق من أسماء غيرك وزرها",56,"ر",3,0],["وإنْ أَسَأْتُ بِهذَا فاحْتَمِلْ كَرَماً","لا خَيْرَ في الحُبِّ لا يَعْرُوهُ إدْلالُ",57,"ل",1,0],["وَإِنْ أَسعَفوكَ بِالنّحيبِ تَوجّعاً","فَمن بعدِ أَن أَسعفتَهمْ بالحرائبِ",58,"ب",1,0],["وإنّ أُسامةَ ذا اللِّبدَتيْ","نِ صُرِّع عن خُدَعِ الأَذْؤُبِ",59,"ب",1,0],["وأناس قد بدلوا الدين عنه","طردوا فامتلوا له طغيانا",60,"ن",2,0],["وإِن اسَجَار النجمَ بع","ضُهُمُ فَمِنْكَ النَّجْمُ حَائِرْ",61,"ر",1,0],["وإن استَطَعتَ عَنِ العَقيقِ فَهاتَ مِن","بَعض الحديثِ صَدَقتَ أم لَم تَصدُقِ",62,"ق",1,0],["وَإنا سَنَنسى ما لَقينا مِن العَنا","وَنَذكُرُ في الجَنات حُسن صَفاها",63,"ا",3,0],["وَأَن أَساطيل السَعادة أَقبَلَت","وَبِالوَطَن المألوف حلّ رِكابها",64,"ب",3,0],["وَأَن أَسمَعَ الطُرّاقَ يَلقَونَ رُفقَةً","مُخَيِّمَةً بِالسِيِّ ضاعَت رِكابُها",65,"ب",3,0],["وإن استبد بنيلها","قتل الشقيقة بالشقيقه",66,"ق",2,0],["وإنِ اسْتُنطِقَ بَقٌّ","وإنِ اسْتُكتِمَ بُوقُ",67,"ق",1,0],["وأناسٍ على المعاصي جهاراً","قد أباحوا حريمنا للعداةِ",68,"ا",2,0],["وَإن أسفَرتْ عَنْ وَاضِحِ الحسنِ أوْ رنتْ","فَيَا لُطْفَ مَا تُهدِيهِ تِلْكَ الشَّمَائِلُ",69,"ل",1,0],["وان أسغت لغيري في الهوى مننا","فلا تسغ لي يوما فضلة المنن",70,"ن",1,0],["وان أسوم الذل من سامني","من الورى ذلاً وخذلانا",71,"ن",2,0],["وإن أساءَ قيل فيه","من له الحسنى فقط",72,"ط",1,0],["وإناسٍ أهل جودٍ وباسٍ","والتماسٍ للعلى وامْتنانِ",73,"ن",1,0],["وَإِنّا سَواءٌ كَهلُنا وَوَليدُنا","لَنا خُلُقٌ جَزلٌ شَمائِلُهُ جَلدُ",74,"د",1,0],["وَأُناسٍ عَتَوا عَلى الدَّهرِ حَتّى","هَبَّ في جَمعِهِم بِعاصِفِ هُلكِ",75,"ك",1,0],["وأَنا سليلُ عشيرةٍ","واللهِ من خيرِ العشائر",76,"ر",1,0],["وأنّا سنَلقى بعدَهُ سنَنَ الرَدى","كما سنَّ من قبلُ القرونُ الأوائِلُ",77,"ل",1,0],["وَأَن أَسأَلَ المَرءَ اللَئيمَ بَعيرَهُ","وَبَعرانُ رَبّي في البِلادِ كَثيرُ",78,"ر",1,0],["وإن أسعرت عيناهُ وجه صنيعةً","رأيتَ عيون الأسدِ وهي مضاحك",79,"ك",1,0],["وأنا سائل أيا ابن ودادي","فابن لي عما يجول بسري",80,"ر",2,0],["وَإن أسَاءوا حَيْثُ لَمْ يُلْهِهِمْ","عَن ذَاكَ سِرُّ الْحَضرَةِ الأطْيَبُ",81,"ب",1,0],["وأناسٌ رخصوا فيه ولم","يجبوا في ذاك تفريقاً وجد",82,"د",1,0],["وأناسٌ أوجبوا خدمته","لأولي الميراث حتى يغترق",83,"ق",1,0],["وأناسٌ أثبتوها أمةً","فإذا مات استمرت لم تعق",83,"ق",1,0],["وَإِن استَطَعتَ فَسِر بِسِيرَةِ أَحمَدٍ","تَأمَن خَدِيعَةَ مَن يَغُرَّ وَيَخدَعُ",84,"ع",1,0],["وأنا سرت على أثاره","ودليلي ما تجلى للعيان",85,"ن",1,0],["وأنا سرُّ إمام","فاضلٍ سامي المكانِ",86,"ن",1,0],["وإنّ أسماءَه الحسنى التي بقيت","لنا وإن جهات من أعظم العدد",87,"د",1,0],["وان اسدل الليل الدجوجي ستره","نضيءُ لمن يسري الينا ولا نقري",88,"ر",2,0],["وانا سنلقاه بأحسن جنةٍ","مع الأتقياء الصالحين ينعم",89,"م",1,0],["وأنا سميك يا محمدُ مثل ما","خِلاكَ أبي بكر وصَاحبه عُمر",90,"ر",1,0],["وإن أسرت فأطلقْ أو طلبت فدى","فهاك فالرومُ قد يفدون من أسروا",91,"ر",3,0],["وإنا سُليك القفر","لا أرضى بذل المُضطجع",92,"ع",1,0],["وإن أساء أو تمحن","زادك على الشوق محنه",93,"ه",1,0],["وان اسهرك ريم رامه","هيهات بعد السهر نوم",93,"م",1,0],["وإن اسرع الساعون للمجد فاتهم","وان قبلوا الدنيا على ما بها أبى",94,"ب",2,0],["وإن اسفرت ليلى جلى الليل وجهها","وخرت لها خوف الكسوف الكواكب",95,"ب",1,0],["وإن استحال الإنتها","في الجامع المتوحد",96,"د",1,0],["وإن استرق السمع الشيطا","ن يجدها قد ملئت حرسا",97,"س",2,0],["وأنا سابح تفيض بي الذك","رى وتنساب أدمعي من عيوني",98,"ن",2,0],["وَإِن اِستَحالَت عِندَها نَفسي دماً","تَهمي بِهِ عَيني فَخَضَّبَ محجري",99,"ر",2,0],["وَأُناساً عَقَدوا بَيعَتَهُم","وَبِها نالوا مِنَ اللَهِ الثَنا",100,"ن",2,0],["وَأُناساً ما تَناسَوا عَهدَنا","مِن أُصَيحابٍ وَمَن يَعرِفُنا",100,"ن",2,0],["وإن أسرْ للإلف سرتُ مسرعاً","فكهرباء الحبّ تجري بي له",101,"ه",1,0],["وإن أسمع كلامهم أخلْه","رياحاً أحدثت في السمع صوتا",102,"ت",2,0],["وَأنَا سَدِيْمُ الحُزنِ زَلْزَلَ جَبْهَتِي","وَالصَّبْرُ آخِرُ فَيْلَقٍ يَتَدَفَّقُ",103,"ق",1,0],["وإن أسرع الأواب يطلب ما","يفيدك إلا وانتضى السيف للوقت",104,"ت",1,0],["وان أسير المجد غال فداؤه","وليس سوى بذل النفوس له فدا",105,"د",2,0],["وان اسعفت يوما كريما بمظهر","توارب عن حقد وتسعف عن غيظ",106,"ظ",1,0],["وأنا سبسبٌ توهَّج منهُ","لخُطاها أَيْكٌ رطيب وزهر",107,"ر",1,0],["وأناس تهودوا وأناس","جاءهم دين ربهم من بخارى",108,"ر",2,0],["واناسٍ بالحَضرِ افناهم الده","رُ وأَبقى آثارهم في البلادِ",109,"د",1,0],["وإنْ أسهلَ اسْتَتْلَيْنَ نَقعاً كأنّهُ","شَماطيطُ كتّانٍ تطيرُ رَعابلُهْ",110,"ل",2,0],["وَاِن اِساءَ مُسيءٌ فَليَكُن لَكَ في","تِلكَ الاِساءَة عَفو صاحِ مجّان",111,"ن",1,0],["وإن أساءَت اليَّ الحادثات فما","أنكرت من شعريَ الممتاز حسناها",112,"ا",3,0],["وَإِن أَسفرت فَامزج بِها ذكرَهم فَما","تَسوغ بلا هَذا المدام لِأَمثالي",113,"ل",2,0],["وَإن أَسفرت كانَت هي الشَمسَ تنجلي","وَإِن غربت تجلو نجومَ المباسم",114,"م",1,0],["وأن اسمه الموعود في كل مِقول","سيسمعه الناعون من فم ناعيةْ",115,"ي",2,0],["وأن أسيغ الحق ما سرني","فإن أبى، فالكذب المفترى",116,"ر",2,0],["وأناس يزعمون ال","قرد إنسانًا تدلَّى",117,"ل",2,0],["وإن أسكت المشتاق رمح قوامه","تكلمه من غمد جفن بواتره",118,"ر",2,0],["وإن أساؤا الأدبا","كي لا يروك مغضبا",119,"ب",2,0],["وأناسا لا يذكرون جميلي","للئام تسلموا من لئام",120,"م",1,0],["وأنا سُليمانُ المعظَّ","مُ في ملوكهم الأطاولْ",121,"ل",1,0],["وإن اسبقَ الشُّوسَ البهاليلَ في الوغى","على نهب نفس الشّمِرىّ الغضنفرِ",122,"ر",1,0],["وأنا سراة من بني تيم مرة","يذر بنا من آل غالب شارق",123,"ق",1,1],["وإن استفاقوا صارخين فما لهم","في دفع أرزاءِ البلاءِ يدان",124,"ن",1,0],["وإِن استجار فإِنّ جا","رك يا ضياء الدين آمن",125,"ن",1,0],["وأَن أَسأَلُ الناسَ أَشياءَهم","وأَمنَعُ مالي فَلا أُسأَلُ",126,"ل",1,0],["وإن أساءك مني ملبس خلق","باد ففي طيه ماض من القضب",127,"ب",1,0],["وإن استهوت به نازلة","أخذت أيدي علاكم بيديه",128,"ي",2,0],["وأنا سِألت الله يا مِنْ لَه الثّنا","سبحان يا مُغيث الملا مَع أطفالها",129,"ل",3,0],["وان اسعى على قدمي بهرا","كتجوالي على فرس سبوح",130,"ح",1,0],["وَإِنِ اِستَحَبَّ القَطرُ سُقيا مَوضِعي","فَمَكانُ مِثلي عِندَهُ مَعلومُ",131,"م",1,0],["وانّا سعينا بين أيديه مثلما","سعى إذ رأى مولاه للسعى نادبا",132,"ب",2,0],["وإنَّا سَمِعنا بِ(شَملانَ) صَوتًا","تَفاصِيلُهُ في \"قناةِ المَنَارْ\"",133,"ر",1,0],["وأَنا سَقَطتُ مُحَمَّلًا ببيُوتِها ال","مُتَشابكاتِ كَجُملةٍ بالكُوفي",134,"ف",2,0],["وأنَّا سَوفَ نَعبُرُهُ كِرَامًا","وإنْ طَالَ اقتِناصٌ واحتِجَازُ",135,"ز",1,0],["وإنَّا سائرون إلى معادٍ","لنقتبسَ الحياةَ بلا تراجعْ",136,"ع",1,0],["وأنا سميرةُ والحبيب بساحلي","يخشى السّباحةَ ما ارتمى متجرّدا",137,"د",2,0],["وان اسقطتُ أَوسَطهُ","اتى في القلب منهُ دَمُ",138,"م",1,0],["وأناس آثروا العجز على","رتبة العز فباؤوا بالفشل",139,"ل",1,0],["وأناسٌ أعراقهم مدنيون","من صحاب الرسولِ خير أناسِ",140,"س",1,0],["وإن أسوءَ شيء أن يفارقنا","ذو العلم يا لك أمرٌ ليس يُحتَمل",141,"ل",1,0],["وإن أساء بتفسير يحررها","فما الرجاء بكاف عند قاتلها",142,"ل",3,0],["وإن أسفرت عن فوزنا ليلة السرى","ولاحت لنا الأنوار من ذلك المغني",143,"ن",2,0],["وأن أسحبَ النحلاتِ شهدَ ربيعها","وأن أعصرَ العذبَ الرحيقَ من الزهر",144,"ر",1,0],["وأن أسأل القلبَ العميق بنبضه","يُدوِّنُ آيَ الحبِّ في فسْحة الصدر",144,"ر",1,0],["وأنا سيدُ المواقف في اللَّي","لِ وعندي من النساءِ قبيلُ!",145,"ل",1,0],["وانا سمعت لحونك وجيتك مغير","اورحت عود وجيت ابي منه توله",146,"ل",2,0],["وانا سريت الهم جمله وتفصيل","وعلقت قلبي لين من طيبه ارتحت",147,"ت",1,0],["وأنا سأفنى فيك حتى أرى","بالحب ، مالم تبصرِ الفلسفَةْ",148,"ف",2,0],["وأُنَاسٍ لا تَهْوى إلَّا","أكتافَ الخَلْقِ لها سُلَّمْ",149,"م",1,0],["وإن أسقيتها كاسات حب","على أغصان عمرك سوف تثمر",150,"ر",1,0],["وَ أنَا سَأُحييْ بالقصائِدِ موطنيْ عزًّا ،","وَ أَبعَثُ فيْ المحافلِ عبقَرَا",151,"ر",2,0],["وإن أسرفت في ذنب ولهو","فلا تقنط , وصل على محمد",152,"د",1,0],["وإن استدرت رموك من بهتانهم","وتقولوا فيما أردتَ وألفوا",153,"ف",3,0],["وإنَّ أسماءَه الحسنى التي بقيتْ","لنا وإن جهلت من أعظم العدد",154,"د",1,0],["وأنا سقيمٌ أصطلي بلظى دمي","منْ غير ِطِبِّك شافياً لا أسْلَم",155,"م",1,0],["وان استراقَ اللحظ في حفل ليلةٍ","أحاديثُ وجدٍ مضمرٌ ومذاع",156,"ع",1,0],["وإنْ أسْعَفَتْ بالوصْلِ في العُمْرِ لحظةٌ","تَمُدُّ ذراعيها البشاشةُ والبِشْرُ",157,"ر",1,0]]}