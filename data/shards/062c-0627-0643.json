{"poems":[[4988,"أقضب لسانك","https://www.poetsgate.com/ViewPoem.aspx?id=196640",""],[5039,"المسامح كريم","https://www.poetsgate.com/ViewPoem.aspx?id=48114",""],[5045,"سجل حديث النصر","https://www.poetsgate.com/ViewPoem.aspx?id=185179",""],[5525,"ليلي","https://www.poetsgate.com/ViewPoem.aspx?id=7195",""],[5606,"مرحبا يالغالي","https://www.poetsgate.com/ViewPoem.aspx?id=197407",""],[5739,"فرحة بخيل ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131229",""],[5848,"فلسطين وبغداد","https://www.poetsgate.com/ViewPoem.aspx?id=50587",""],[5934,"الشرهه","https://www.poetsgate.com/ViewPoem.aspx?id=35773",""]],"verses":[["جاكم الرّطبي وانا شاعر ومجنون","والجّنون ان ثار بالشّاعر جحيمه",0,"م",2,0],["جاك من عقب ماخلا حياته سقيم","صابه اللي تعرفه وانت مشفي وصايب",1,"ب",1,0],["جاكم رسول الموت نباش القبور","جاكم من التوشكا فناكم ياالشرار",2,"ر",1,0],["جاك الظلام .. وجاك ربع ومسايير","وجاني الظلام وكل ما احب راحي",3,"ح",2,0],["جاك ردي يالفطين وربنا راعي الكمالي","الله الكامل ولا نعرف كمال الا كماله",4,"ل",2,0],["جاك قاف ٍ من سنامه ..! مايغدي.","عارف ٍ قدره .! من الوزن الثقيل.",5,"ل",1,0],["جاك اليهودي بوش فازع له اثنين","توني بلير وراعي اسبانيا",6,"ي",2,0],["جاك علمٍ فيه ظيقه فيه لوعه","اقبله ماتقبله خله ونطه",7,"ط",2,0]]}