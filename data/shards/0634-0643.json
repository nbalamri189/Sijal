m.aspx?id=178935",""],[54,"شكرنا الخليفة َ إجراءهُ","https://www.poetsgate.com/ViewPoem.aspx?id=14477",""],[57,"شكوت إلي وكيع سوؤ حفظي","https://www.poetsgate.com/ViewPoem.aspx?id=3387",""],[45,"لَيْتَ الخَليطَ الذي قد بانَ لمْ يَبِنِ","https://www.poetsgate.com/ViewPoem.aspx?id=31727",""],[45,"أقِمْ عَلّها أنْ تُرْجعَ القَوْلَ، أوْ عَلَيّ","https://www.poetsgate.com/ViewPoem.aspx?id=32055",""],[45,"فِدَاؤكَ نَفسِي، دونَ رَهطي وَمَعشرِي","https://www.poetsgate.com/ViewPoem.aspx?id=31252",""],[45,"رَأتْ وَخْطَ شيْبٍ من عذاري، فصَدّت","https://www.poetsgate.com/ViewPoem.aspx?id=33105",""],[80,"ومحسودة ٍ لا تحسُدِ الغيدُ مِثلها","https://www.poetsgate.com/ViewPoem.aspx?id=3344",""],[51,"شكوى لو أنيَ أشكوها إلى حجر","https://www.poetsgate.com/ViewPoem.aspx?id=29972",""],[51,"ما رَشَأ الأنسِ بمستأنِس","https://www.poetsgate.com/ViewPoem.aspx?id=29403",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[51,"أجنتْ لك الوجدَ أغصانٌ وكثبانُ","https://www.poetsgate.com/ViewPoem.aspx?id=25836",""],[97,"ليالي الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=17271",""],[31,"أرقتُ ولم آرق لسقمٍ أصابني،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19019&r=&rc=282",""],[7,"يا دارَ مَيّة َ بالعَليْاءِ، فالسَّنَدِ، ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13895&r=&rc=13",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[72,"أودت فعالكِ يا أسما بأحشائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=57644&r=&rc=2",""]],"verses":[["شَكا الناسَ يَبكي قَلبُهُ وَلِسانُهُ","وَإِن كَتَمَت عَنكَ الدَموعَ النَواظِرُ",0,"ر",1,0],["شَكَت سَقَماً أَلحاظُها وَهي صِحَّةٌ","فَلَستُ أَرى إِلّا القُلوبَ تَعودُها",1,"د",3,0],["شَكَتْ عُقَبَ المَسْرَى مَطَايَا تَؤُمُّهُمْ","وَتَذْرَعُ أَجْوازَ الفَلا وَتَبوعُ",2,"ع",1,0],["شَكَوْتُهُمُ سِرّاً شِكايَةَ مُشْفِقٍ","وحَيَّيْتُهمْ جَهراً تحيّةَ عاتِبِ",3,"ب",1,0],["شَكَت سَقَماً كَيما تُعادُ وَما بِه","سِوى فَترَةِ العَينَينِ سُقمٌ لِعائِدِ",4,"د",1,0],["شَكَكتُ فُؤادَهُ لَمّا تَوَلّى","بِصَدرِ مُثَقَّفٍ ماضي السِنانِ",5,"ن",1,0],["شَكا ما بِهِ مِن شَوقِهِ في كِتابِهِ","وَأَكثَرُ مِنهُ ما تُجِنُّ أَضالِعُه",6,"ع",2,0],["شَكَت ما بِها نَفسي مِنَ الشَوقِ وَالهَوى","فَقُلتُ لَقَد طالَبتِ وِدَّ مُمَنَّعِ",7,"ع",1,0],["شَكَوتُ إِلى وَكيعٍ سوءَ حِفظي","فَأَرشَدَني إِلى تَركِ المَعاصي",8,"ي",1,1],["شَكَوْتُ لكَ التّغرُّبَ قبْلَ هَذا","وها أنا بعْدَهُ أشْكُو الفِراقَا",9,"ق",2,0],["شكَرْتُ مَخيلةَ كانَتْ مَجازاً","لكمْ وحصلْتُ بعْدُ علَى الحَقيقَهْ",10,"ق",2,0],["شكَرَتْ حتّى بعِبارَتِها","وبمَعْناها وبأحْرُفِها",11,"ف",3,0],["شكَرَتْ لَكَ الدُّنْيَا صَنِيعَكَ عِنْدَها","لَمَّا شَفَيْتَ زَمَانَهَ الأَزْمَانِ",12,"ن",1,0],["شُكْراً لأنْعُمِكَ التي","يَزْدادُ منْها مَنْ شَكَرْ",13,"ر",1,0],["شَكا مَرَهَ الألْحاظِ في حوْمَةِ الوَغى","فوافاهُ مُلْتَفُّ الغُبارِ بإثْمِدِ",14,"د",1,0],["شَكَرَ اللهُ أنْعُماً ألْبَسَتْني","حُلَلَ البِرِّ والرِّضَى مُعْلَماتِ",15,"ت",1,0],["شَكَوْتُ لَهَا دَاءَ الْهَوَى فَاشْتَكَتْ بِهِ","فَأَبْكي لَهَا مِنْ حُبِّهَا وَهْيَ مِنْ حُبِّي",16,"ي",1,0],["شُكْراً بجودِ يَدٍ احْتَرَقَتْ","سُحْبُ الحَيا ببَنانِه الخمْسِ",17,"س",1,0],["شَكا النَوى فَبَكى خَوفَ الأَسى فَرَمى","بَينَ الجَوانِحِ مِن أَوجاعِهِ وَجَعا",18,"ع",2,0],["شَكَرتُ جَميلَ صُنعِكُمُ بِدَمعي","وَدَمعُ العَينِ مِقياسُ الشُعورِ",19,"ر",1,1],["شَكا عُمانُ وَضَجَّ الغائِصونَ بِهِ","عَلى اللَآلي وَضَجَّ الحاسِدُ الشاني",20,"ن",2,0],["شَكَوتُ إِلَيهِ مِن كانونَ قُرّاً","أَبيتُ لِضُرِّهِ أَرعى النُجوما",21,"م",2,0],["شَكَت لَهُ أُختُهُ لَهيبُ حِمىً","في حِرِها تَستَثيرُ كَالجَمرِ",22,"ر",1,0],["شَكا شِعري إِلَيَّ وَقالَ تَهجو","بِمِثلي عرضَ ذا الكَلبِ اللَئيمِ",23,"م",1,1],["شُكرٌ يَروقُ وَيُرضي طيبُ طُعمَتِهِ","في طَيِّهِ نَفَحاتٌ بَينَها خِلَعُ",24,"ع",1,0],["شَكَكنا فَلَم نُثبِت أَأَيّامُ دَهرِنا","بِها وَسَنٌ أَم هَزَّ أَعطافَها سُكرُ",25,"ر",1,0],["شَكلانِ إِن حُمَّ الحَمامُ تَجاذَبا","لا غَروَ أَن تَتَجاذَبَ الأَشكالُ",26,"ل",1,0],["شُكْرُهُمْ وَهْوَ مَا تَبَيَّنْتَ يَجْلُو","أَثَرَ الْغَيْثِ فِي الْمَكَانِ الخَصِيبِ",27,"ب",1,0],["شكا الدهر ما تأسو جراح كرامه","وأنكر منك الرفق جانبه الصلد",28,"د",1,0],["شكراً لمن أسسوه","بهمة وبراعه",29,"ع",2,0],["شُكْراً لِمَا أَوْلَيْتُمُ الْ","عَبْدَ الْفَقِيرَ مِنَ التَّجَلَّهْ",30,"ل",2,0],["شُكْراً لَكُمْ عَنْهَا وَشُكْراً عَنْهُمُ","وَكَفَى جَمِيلاً مِنْكمُ الإِلمَامُ",31,"م",1,0],["شَكَوا إِلَى مِصْرَ مَا عَانُوهُ فَاسْتَمَعَتْ","وَمَنْ شَكَا فَدَعَا مِصْراً دَعَا الكَرَمَا",32,"م",2,0],["شَكَكتُ فَما أَدري أَمَسقِيُّ شَربَةٍ","فَأَبكيكَ أَم رَيبُ الرَدى فَيَهونُ",33,"ن",1,0],["شَكَرنا الخَليفَةَ إِجرائَهُ","عَلى اِبنِ أَبي خالِدٍ نُزلَهُ",34,"ل",2,1],["شكراً لمن عظمت منا مواهبُهُ","وإنْ تُعَدَّ فليس العدُّ يُحصيها",35,"ي",3,0],["شكوت من خصرها ضعفاً وقلت لها","مليكة الحسن هل عطف على الشاكي",36,"ك",2,0],["شكواي بُحت بها إليك وليس في","شكوى الزميل غَضاضةٌ لزميله",37,"ل",2,0],["شكايةُ قلب بالأسى نابض العرق","إلى قائم الدستور والعدل والحق",38,"ق",1,1],["شكَوْت إلى ربّ السموات أرضَه","وما الأرض إلاّ من سمواته السبع",39,"ع",1,0],["شكراً لبانيه ما أقام به","شُبّانه القاطنون في قُبَبه",40,"ب",2,0],["شكراً لأقلامك اللائى كشفت بها","عن أوجه العلم أستاراً وأسدالا",41,"ل",2,0],["شَكَونا ما عَلِمتِ فَما أَوَيتُم","وَباعَدنا فَما نَفَعَ الصُدودُ",42,"د",1,0],["شُكراً فَقَد وَفَتِ الأَيّامُ ماوَعَدَت","أَقَرَّ مُمتَنِعٍ وَاِنقادَ مُعتَصِمِ",43,"م",1,0],["شكراً لوجناء سارتْ بي إلى ملكٍ","لولاهُ لو يطو نظمي سمعةَ الطائي",44,"ا",2,0],["شكراً لفضلك فهو ناعشُ عيشتي","ونداك فهو مجيبُ صوتَ نِدائي",45,"ا",2,0],["شكراً لنعماك يا من","عليه سرُّ ثنائي",46,"ا",3,1],["شكراً لها من معانٍ فيكَ طالعةً","لو أنَّ طالعها للنجمِ ما غرُبا",47,"ب",2,0],["شكراً لأقلامك اللاَّتي جرت لمدىً","في الفضلِ أبقي لباغِي شأوهُ التعبا",48,"ب",2,0],["شكرتْك نفسٌ أنت أصل حياتها","وبقائها وطعامها وشرابها",49,"ه",2,0],["شكراً لأقلامك اللاتي جرتْ لمدى","في الفضلِ أضحى لباغي شأوه التَّعَبا",50,"ب",2,1],["شكراً لنعماك يا غوثَ العفاةِ ولا","زالت مدائحك العلياء تنتحب",51,"ب",1,1],["شكراً لها من أنعمٍ قدْ شادَها","نعمَ العمادُ فمكَّنت أسبابي",52,"ي",1,1],["شكراً لنعماك وإن أفحمت","لساني الشاكر عما نويت",53,"ت",1,1],["شكر الله أياديكَ التي","عاجلت قصدي بأنواعِ الهبات",54,"ت",1,1],["شكت من شيبتي عينُ الفتاة","فيا لكِ ثمّ يا لكِ من قذَاة",55,"ه",1,1],["شكراً لأنعمك التي قد أفصحتْ","عن شكرِها حتَّى جوارِحي الصُّمت",56,"ت",1,0],["شكرت نعماك أعظمنا","في البقا والبعث والجدَث",57,"ث",1,0],["شكراً لنسَّاجها بل للجواد بها","مستفتحاً باب شعري بعد إرتاج",58,"ج",1,0],["شكراً لها نعمى يدٍ من سيِّدٍ","أغنى عن التطفيلِ والتشريخ",59,"خ",1,1],["شكرتك حتى لم تدعْ ليَ لفظةً","وكدت بأن أشكوكَ في كل مشهد",60,"د",1,0],["شكرَتك الرُّواةُ عنِّي بعزِّ","قاطعات السرى آكاماً ووهدا",61,"د",2,0],["شكراً لمولانا الذي قال في","ثنائه الواصف قولاً سديد",62,"د",1,1],["شكرَ الله أياديك التي","كل يوم أتلقى رفدها",63,"د",3,1],["شكت وقد سارقتها قبلةً","يا بردها في كبدي الواقده",64,"ه",1,1],["شكراً لشخصك ما أسير ممدحاً","وأعز منتصراً وأحلم قادرا",65,"ر",2,0],["شكراً لعلياك التي أورثتها","يا ابن السيادة كابراً عن كابر",66,"ر",1,1],["شكراً لها يا سيدي منحةً","معهودة وانْظر لها أيضا",67,"ض",2,1],["شكراً لها فرجية قد بيضت","عيشي وعين الحاسد المتواطي",68,"ي",1,1],["شكوت إلى سفحِ النقا طول نأيكُم","وسفحُ النقا بالنأي مثلي مروَّع",69,"ع",1,0],["شكوتُ لها ضرّ الغرام وحالها","كحالي بكاءً أو حنيناً يرجع",70,"ع",1,0],["شكراً لها من أنعمٍ سعديةٍ","غنَّى بها المثنى غناءً سائغا",71,"غ",2,1],["شكراً لعطفٍ وأعراضٍ لديك هما","لعبد أبوابكم برٌّ وتثقيف",72,"ف",1,0],["شكراً لأنعم مولانا التي فضلت","جهد الثناء فأبدى وجه معترف",73,"ف",1,1],["شكراً لها كنافة من بعدها","قطافٌ جاء بقطرٍ مغدق",74,"ق",1,1],["شكرت لهاك فما أشكُّ بأنني","ثقَّلت وهي مطيقة أثقالها",75,"ل",3,0],["شكراً لها خلعةً فاءَت غمامتها","عليَّ من يد هامي المزْن هطَّال",76,"ل",1,0],["شكراً لبرّك لي على طول المدى","إن كانَ يقضي الشكر حقّ أقله",77,"ل",2,0],["شكراً تقيّ الدين للمنن التي","رفعت على حامي حماك ظلالها",78,"ل",3,1],["شكوتَ وبالشكوى إلى غير راحمٍ","تعذَّر مني للمراد حصول",79,"ل",1,1],["شكراً لفضلك ما غنّت مطوّقة","وما تتاوح غبّ الوابل السّلم",80,"م",1,0],["شكراً لأوقات عدلٍ قد أنمت بها","عين الرّعايا فهم في طيب أحلام",81,"م",1,0],["شكوتُ