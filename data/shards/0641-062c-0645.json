,2,"م",1,0],["فَجَمَّعتُها بَعدَ الشَتاتِ فَأَصبَحَت","لَدى اِبنِ أَسيدٍ مُؤنِقاتٌ خَناجِرُ",3,"ر",1,0],["فَجَميلُ العَدُوِّ غَيرُ جَميلٍ","وَقَبيحُ الصَديقِ غَيرُ قَبيحِ",4,"ح",1,0],["فجمالٌ لمنظرٍ وثناءٌ","لمَشمٍّ يحكي ثَناكَ ذكاءَ",5,"ا",2,0],["فجميع الناس أقدا","مٌ وهم للناس هامُ",6,"م",1,0],["فجميع النساء في الْ","حلِّ والمطبخُ الحَرَمْ",7,"م",1,0],["فَجَمَدَ السائِلُ في الزُجاجِ","وَاِكتَسَتِ الأَرضُ بِمِثلِ العاجِ",8,"ج",1,0],["فجمال في غد أو بعده","بوزيرين تُساوي ثروته",9,"ه",1,0],["فَجَمَعتُهُنَّ إِلى الحَديثِ بَدَأتُهُ","فَغَضِبنَ ثُمَّ أَعَدتُهُ فَرَضينا",10,"ن",2,0],["فجميع الذي تريد","دونه فهو مستطر",11,"ر",1,0],["فَجَمَعتَ بَعدَ تَفَرُّقٍ أَجنادَهُ","وَأَقَمتَ مَيلَ بِنائِهِ المُنهارِ",12,"ر",1,0],["فَجَميلُ صُنعِكُمُ أَجَلُّ صَنائِعاً","وَبَديعُ فَضلِكُمُ أَدَقُّ مَعانِ",13,"ن",1,0],["فَجَمَعتُ بَينَ رُضابِهِ وَشَرابِهِ","وَشَرِبتُ مِن ريقٍ وَمِن صَهباءِ",14,"ا",2,0],["فَجَمَعَ الرَأيَ الَّذي تَفَرَّقا","وَأَبرَأَ الداءَ الَّذي أَعيا الرُقى",15,"ق",2,0],["فَجَمجَمَ وَالكَرى في مِقلَتَيهِ","كَمَخمورٍ شَكا أَلَمَ الخُمارِ",16,"ر",1,0],["فجمَّعَ الأجنادَ والحُشودَا","ونَفَّرَ السَّيِّدَ والمَسودَا",17,"د",2,0],["فَجَمِيعُ أَمْصَارِ الْعُرُوبَةِ فِي","إِكْرَامِهِ قَدْ شَارَكَتْ مِصْرا",18,"ر",2,0],["فجمعهم فرد وفردهم به","غناء إذا كرَّ اللهام الخضارم",19,"م",1,0],["فجمعتهن إلى الحديث بدأته","فغصبن ، ثم أعدته فرضينا",20,"ن",2,0],["فجميع هذه الحادثات مثالها","طيف الخيال وغير ربي فاني",21,"ن",2,0],["فجميعُ ما تهواه يهوَى للفِتَنِ","واحذرْ مصائِدَها فإنك تمتحنْ",22,"ن",1,0],["فَجَمَّعَ اللهُ فِيكُم كُلَّ مَلأَمَةٍ","إِن تُذكَرُوا بِنَواحِىِ مُسلِمٍ تَفَلا",23,"ل",2,0],["فَجَميعُ أَهلِ الأَرضِ مُذ سَمِعوا بِهِ","تَرَكوا البِلادَ وَيَمَّموا ذا الشاما",24,"م",2,0],["فجمَّع الشمل ربٌّ كان فَرَّقَه","وليس لله في الحالين معترض",25,"ض",1,0],["فجمالَ يوسفَ ليس فوق جمالها","لكنَّه قد كان بادٍ يشهدُ",26,"د",1,0],["فجميع الناس محتا","ج إلى العصمة باللّه",27,"ل",2,0],["فَجميعُ المدحِ من كلّ الورى","لَو أتى في حقّهِ كان قُصورا",28,"ر",2,0],["فَجَميعُ الأنامِ منهُ إلى الحش","رِ بليلٍ نجومهُ الأولياءُ",29,"ا",2,0],["فجمّعتَنا بعد اختلاف ومِرْية","وألفَّتنا بعد التنافر والزَّجْر",30,"ر",1,0],["فجمعتَ بالإسلام كلَّ فلولهم","فكأنهم بالاجتماع قبيل",31,"ل",1,0],["فَجِمادِ ذي بَهدى فَجَوِّ ظُلامَةٍ","عُرّينَ لَيسَ بِهِنَّ عَينٌ تَطرِفُ",32,"ف",1,0],["فَجَمَّع أهلَ الشرقِ والغربِ حَوله","وصارَ بهِ كالإخوة الغرباء",33,"ا",2,0],["فجمِّعيهم وإلا جمّعي عرباً","تفرقوا بعدَ ما ناخَت مطاياك",34,"ك",1,0],["فَجَميع الرسل قاصرة","عَن مَساعي ظاهر القدم",35,"م",1,0],["فَجمَّعَ مِن شَمْلي وشَمْلي مُفَرَّقٌ","وَرفَّه من شِربي وشرْبي مُصَرَّدُ",36,"د",1,0],["فجميعهم يرجو النبي وإنما","يرجى العظيمُ لأعظم الأشياء",37,"ا",2,0],["فَجَمعُكَ السالِمُ الصَحيحُ وَمن","عاداكَ غادٍ في جَمعِ تَكسيرِ",38,"ر",1,0],["فَجَمالُ يوسُفَ لَو رَأَى حُسنَ الَّذي","أَهوى لَكانَ لِحُسنِهِ يَتَتَلمَذُ",39,"ذ",1,0],["فجميل الذكر ذاك المنتقى","نجله الاكبر قد صارلوا",40,"و",2,0],["فَجَمعُه أَشيياءٌ عند قائلِهِ","كأهوِناء وبعد الحَذف أَشياءُ",41,"ا",2,0],["فَجَمَّعتُ بِلا وَصلٍ","وَفَرَّقتُ بِلا فَصلِ",42,"ل",1,0],["فَجَمَعت الَّذي تَفرّق وَاِستَي","قظ فَنّ البَديع بَعد الهُجوع",43,"ع",1,0],["فجماله نفس الجمال وإنما","من حسنه قد كُوِّنَ ابنُ ذُكاء",44,"ا",2,0],["فجميع ما في الأرض يصغر شأنه","لما يجود بنصره الرحمن",45,"ن",1,0],["فجميع تلك كلامه سبحانه","والحكم فيها واحد فتأمل",46,"ل",1,0],["فجميعُ ما فيهِ الأَنَا","مُ أَلَيْسَ آخِرَهُ القبورُ",47,"ر",1,0],["فجمال وجهك قد تملك مهجتي","ونحيل خصرك قاتلي بسقامي",48,"م",2,0],["فجميعكم يا آل كندة إن دعت","أبناء أحمد أن يكون مطيعا",49,"ع",2,0],["فجميل قولك عاشقٌ يشتاقني","فيها وفعلُك تائه يجفوني",50,"ن",2,0],["فجمال أيّامي بحضرتك التي","هي منيتي يومَ الفخار ومفزعي",51,"ع",2,0],["فَجَمِّلني بِنَفسِكَ فَهوَ يَومٌ","جَميلُ الوَجهِ مِن نَسلِ الزَمانِ",52,"ن",1,0],["فَجَميلُ الخَمرِ يُسلي","عَن إِساءاتِ الخُمارِ",53,"ر",1,0],["فجَمَعَ الناسَ على مأدُبةٍ","وصارَ يَفخَر بمَا تَعَلَّمَا",54,"م",2,0],["فجَمَعْتَ حَوْلَكَ أُمَّةً من أَحْرُفٍ","أَرْكَبْتَهاَ في الحِبْرِ صهوةَ سَيْلِهِ",55,"ل",2,0],["فَجميعُ أَعضاءِ الرّجالِ تصرُّفاً","طولَ الزّمانِ توابعٌ للهامِ",56,"م",1,0],["فجميعنا منه له","طول الزمان محامد",57,"د",1,0],["فجميع ما أدركته الموجود لا","هو ذا الوجود الحق ذو الآلاء",58,"ا",2,0],["فجمرةُ وَجْدِي ليس تخلو من اللَّظَى","وشُعْلَةُ قَلْبي ليس تُطْفَا من الوَقْدِ",59,"د",1,0],["فجماد حي وحي جماد","إنتقال في إثره إنتقال",60,"ل",1,0],["فجميعنا بك فارح متهلل","وجميعنا بك معجب وفخور",61,"ر",1,0],["فجميع صنعك اولا أو آخرا","لله والاوطان كان جميلا",62,"ل",2,0],["فَجَميع السدّان كانوا نجوماً","في سماءِ العلى وشخصك بدرُ",63,"ر",1,0],["فجماله مجلى لكل جميلة","وله منازل ضوء وجه نير",64,"ر",1,0],["فجمعت شمل الدين وهو مفرَّق","وَفرَّقت شمل الشرك وهو مجمَّع",65,"ع",1,0],["فجميعُ مَنْ سألوه ممّنْ جاءَهُمْ","بالقَصْد أخبرَهُم به إخْبارَا",66,"ر",2,0],["فجميعُ مَنْ فيه أقرَّ بعجْزهِ","عنْ أنْ يُعارِضَ سُورةً إقْرارَا",66,"ر",2,0],["فجمعناهما لدى مجلسٍ تص","خبُ فيه الأطيار والأوتار",67,"ر",1,0],["فجميلُ الثوابِ بعدك من أق","بحِ ما يستعيضُهُ المستعيض",68,"ض",1,0],["فَجَمَعَ الأَولاد ذاتَ يَوم","وَجسمه مضطجع لِلنَوم",69,"م",1,0],["فجمع السَبعُ العَظيم جُنده","وَقامَ فيهم بِالكلام وَحده",70,"ه",1,0],["فجمرة وجدي به ما تذوب","وعبرة عيني ما تجمدُ",71,"د",1,0],["فجمعتهم حرفة الشرع في","منظومةٍ ذات كلامٍ فكيهْ",72,"ي",2,0],["فجميل نقش الصين أقبح خطه","وثمين در السمط أحقر دره",73,"ر",2,0],["فجَمَّعَ اللهُ شملَ الفَضْلِ أَجْمَعَهُ","فيهِ وأَيَّدَ في تأَييدِهِ الأَدبا",74,"ب",2,0],["فجميع من سلك الطريقة بعده","مستصبحون بنوره الوقاد",75,"د",1,0],["فجمعت القوافي مثل غقد","تضيئ معانياً وتذيع سري",76,"ر",2,0],["فجميلٌ خلعُ العذار وقد حر","ك عطفَ القضيب سجعُ الحمامِ",77,"م",1,0],["فَجَمعوا شَيئاً مِن الزكاة","وَبادَروا إَلَيهِ بِالهبات",78,"ت",1,0],["فَجَمَعوا مِن الزكاة أَلفا","فَجاءهُ الشَّيخ بِها وَخَفا",79,"ف",2,0],["فجميع هذا قد تداوله الورى","حتى غدا ما فيه موضع إصبع",80,"ع",1,0],["فَجَمَّعْتُ بَيْنَ المَاءِ وَالنَّارِ ذَاكَ مِنْ","دُمُوعِي وَهَاذِي مِنْ لَوَاعِجِ أَشْجَانِي",81,"ن",2,0],["فجميعهم تحت الثرى في ملحدٍ","وجميعهم فوق الثرى في مأتم",82,"م",1,0],["فجمرةُ الصدر تثير البكا","وجمرُ خدّي ناسخُ الأَدمُع",83,"ع",1,0],["فجمي