{"poems":[[73,"أضالع تنطوي على كرب","https://www.aldiwan.net/poem3834.html","المنسرح"],[23,"ما بال عيني دموعها تكف","https://www.aldiwan.net/poem21478.html","المنسرح"],[72,"أصبح عندي سمكه","https://www.aldiwan.net/poem42770.html","مجزوء الرجز"],[47,"لم تبلغ الحق ولم تنصف","https://www.aldiwan.net/poem65144.html","السريع"],[68,"ألآل أشرقت في نحور","https://www.aldiwan.net/poem40642.html","المديد"],[107,"اشهدي يا مصر أعمال البنين","https://www.aldiwan.net/poem43070.html","الرمل"],[107,"هواك هواك والدنيا شؤون","https://www.aldiwan.net/poem43372.html","الوافر"],[48,"الحمد لله الذي صاغني","https://www.aldiwan.net/poem23537.html","السريع"],[308,"تجعد النهر في صفاء","https://www.aldiwan.net/poem57817.html","مخلع البسيط"],[422,"أهاج الجوى برقا أغار وأنجدا","https://www.aldiwan.net/poem54165.html","الطويل"],[428,"مرثية رجل عظيم","https://www.aldiwan.net/poem24295.html","عموديه"],[463,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[466,"يفضل الصارم في عزمته","https://www.aldiwan.net/poem16119.html","الرمل"],[469,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[580,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48541","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62693","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126128","الرجز"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77227","الخفيف"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87328","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199996","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205040","الوافر"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112674","الرجز"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53026","الرجز"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103972","الخفيف"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32367","الخفيف"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88573","الخفيف"],[4875,"سلامتك","https://www.poetsgate.com/ViewPoem.aspx?id=133837",""],[4899,"الوصايا","https://www.poetsgate.com/ViewPoem.aspx?id=177222",""],[4984,"رغبة","https://www.poetsgate.com/ViewPoem.aspx?id=181625",""],[5732,"يقول من عدا على رأس عالي","https://www.poetsgate.com/ViewPoem.aspx?id=34388",""],[5956,"مهاتفة خالد لرفاه","https://www.poetsgate.com/ViewPoem.aspx?id=182388",""],[5957,"إنتظار","https://www.poetsgate.com/ViewPoem.aspx?id=26226",""],[6008,"زواج الأمير فهد نواف الشعلان","https://www.poetsgate.com/ViewPoem.aspx?id=60993",""],[6008,"المكوك","https://www.poetsgate.com/ViewPoem.aspx?id=61067",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""]],"verses":[["تَجَعمُسٌ قَلَّ مَن يُناظِرُهُ","في الناسِ إِلّا تَعَنفُقُ الرَحبي",0,"ب",2,0],["تَجعَلُ مَن كانَ المَجدُ مَحتِدَهُ","كَأَعبُدِ الأَوسِ كُلَّما وُصِفوا",1,"ف",3,0],["تَجعَلُها لِما يَجي مِن","بَعدِها مُحَرِّكَه",2,"ك",2,0],["تَجعَلُها رِفداً لِمُستَرفِدٍ","أَو سَلَفاً قَرَضاً لِمُستَسلِفِ",3,"ف",1,0],["تَجعَلُ الغُمضَ عَلينا حَراماً","كُلَّما جاءَت بِسِحرٍ حَلالِ",4,"ل",1,0],["تَجعَلينَ الأَمرَ فَوضى ما لَهُ","مِن نِظامٍ واضِحٍ لِلمُستَبينْ",5,"ن",1,0],["تَجعَلونَ الهَوى المُضَلِّلَ ديناً","وَتَعُدّونَ باطِلَ الأَمرِ شُغلا",6,"ل",2,0],["تَجعَلُ نَمِيَّكَ تِبراً وَما","تَخلُطُهُ حَبَّةَ عُقيانِ",7,"ن",1,0],["تجعد النهر في صفاءٍ","فقلت من أين ذا أجابا",8,"ب",2,1],["تجعجع مثل الفحل هاج وكلَّما","أُريعَ بضرب السَّوْط أرغى وأزبدا",9,"د",2,0],["تجعلنا نهتزُّ ونتفتَّح","تجعلنا نتكسَّر",10,"ر",1,0],["تجعجعُ فيكُمُ بَرْكُ المعالي","وتُلقِي بين أظهركم عصاها",11,"ا",3,0],["تجعلُ الصَّلْدَ حَوامي خيْلِهِ","وعَزازَ الأرضِ وعْثاً وخَبارا",12,"ر",2,0],["تجعلُ الليلَ بالسفور صباحاً","وسنا الصبح باللثّام ظلاما",13,"م",2,0],["تجعلُ لي ذِكراً لها","يَجُول في الْمَجَالِس",14,"س",1,0],["تجعل في كل فؤا","د لوعة تستعر",15,"ر",1,0],["تجعل النفس حَسرى إلْفَ أَنّتِها","من المقادير إذ جاءت برَنّتها",16,"ت",3,1],["تجعل من نهضتك وقومتك","أن تجمع المال لبعل زوجتك",17,"ك",1,0],["تَجعَلُ النيلَ إِن تَشَأ رافِدَ الت","تاميزِ والمُسلِمين سَبيَ اليَهودِ",18,"د",1,0],["تَجعَلوها كَمائِماً لِذَويها","أَو طَعاماً لِلنارِ ذاتِ الوَقودِ",18,"د",1,0],["تَجعَلُهُ ستّاً ونصفاً مثلي","وضلعَكَ المنيرَ جاهاً أصلي",19,"ي",1,0],["تجعل من ثوب الدجى سترها","تلدغنا في جيئة أو ذهاب",20,"ب",1,0],["تجعد وجهه ويداه حتى","لتحكي كعب أرجله يداه",21,"ا",2,0],["تجعلُنا فيها منَ الدُعاةِ","إلى سبيلِ الحَقِ والنجاةِ",22,"ه",1,0],["تجعله الاعراب لليث كبد","لانه بالقرب من شكل الاسد",23,"د",1,0],["تجعله الروم له سناما","والعرب فيه تكثر الكلاما",23,"م",2,0],["تجعله الروم فؤادا للأسد","تتلو نجوما كاللآلي تتقد",23,"د",1,0],["تجعل هنداً في النُّهى كزيدِ","والدرسُ للأُنثى كما الغُلامْ",24,"م",1,0],["تجعل الشمس منك لي عوضا هي","هات ماذا الفعال منك قويما",25,"م",2,0],["تَجعَلُ النَدَّ وَالأُلُوَّةَ وَالمِس","كَ صِلاءً لَها عَلى الكانونِ",26,"ن",1,0],["تجعل المسكَ واليلنجوج والنَّ","دِّ صِلاءً لها على الكانون",27,"ن",1,0],["تجعل علينا شمسها دوم بشروق","ولا للمرض يبقى عليها طريقه",28,"ق",2,0],["تجعل لنا من باب نصرك تباشير","ترسل لنا من فيض غيثك بمدرار",29,"ر",1,0],["تجعل السير ملاذا دائما","ونفيرا ومقاما وقرار",30,"ر",1,0],["تجعل مقره دارس العهد بالي","صحصاح دو دارس مابه اوناس",31,"س",1,0],["تجعل البيت جحيما ملتهبْ","ردُّ فعل لغرامٍ مضطربْ",32,"ب",1,0],["تجعل الدنيا ترى وهج السنا","مشرقٌ ليلي ويحدوني السعدْ",33,"د",1,0],["تجعل ملكنا بعز ياعالي الشان","نطلبك يالمعبود تقبل طلبنا",34,"ن",2,0],["تجعلنا في جنة الخلد ندعوك","في جنة الفردوس نطلب ملاقاك",35,"ك",1,0],["تجعل العابدَ المهيمن ينسا","هُ ، ويغدو من زمرة الفُسّاق",36,"ق",1,0]]}