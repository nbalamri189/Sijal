x?id=158435",""],[5970,"أيها الراحلون جيلاً فجيلا","https://www.poetsgate.com/ViewPoem.aspx?id=130606",""],[5975,"أنتِ قلبي ...","https://www.poetsgate.com/ViewPoem.aspx?id=53268",""],[5976,"يا ملكْة الشعْر ..","https://www.poetsgate.com/ViewPoem.aspx?id=31767",""],[5977,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=212743",""],[6056,"اقول معصي","https://www.poetsgate.com/ViewPoem.aspx?id=130136",""],[6056,"ماكل من يجهد مصيب","https://www.poetsgate.com/ViewPoem.aspx?id=130341",""],[6093,"نسخة معدلة","https://www.poetsgate.com/ViewPoem.aspx?id=193066",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""],[520,"قل للأمير الأكرم الكمال","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577602",""],[6198,"أجنحة الصمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79236&r=&rc=10",""],[5355,"لا تعذليه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87225&r=&rc=50",""],[119,"ضارعت زفرة الذنوب بكائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55607&r=&rc=4",""],[6290,"لَكَ فِي الْأَفْئِدَةِ الْغَرَّاءِ حُبٌّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85517&r=&rc=35",""],[2220,"الحمدُ للهِ جلَّ اللهُ منْ خالقٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11611&r=&rc=485",""],[6302,"فَكُونيْ ... عيدَهُ!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86203&r=&rc=1",""],[6337,"آنَستُ وجهك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81399&r=&rc=11",""],[6353,"بطاقة حب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64726&r=&rc=147",""],[572,"جاءَتْ بِعُودٍ كأَنَّ نَغْمَتَهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9183&r=&rc=40",""]],"verses":[["لَو حارَبَت أُفقَ السَماءِ لِفَرَّقَت","بَينَ الثُرَيّا فيهِ وَالدَبَرانِ",0,"ن",1,0],["لَو حَيثُ يُستَمَعُ السِرارُ وَقَفتُما","لَعَجِبتُما مِن عِزِّهِ وَخُضوعي",1,"ع",2,0],["لَو حَرَّكَت ذاكَ الرَمادَ يَدٌ","لَرَأَت بَقايا الجَمرِ وَالوَقدِ",2,"د",1,0],["لَو حَنَّطوكَ بِشِعرٍ أَنتَ قائِلُهُ","غَنيتَ عَن نَفَحاتِ المِسكِ وَالعودِ",3,"د",1,0],["لَوْ حُصِّلَتْ أَسْمَاؤُهَا لاسْتَنْفَدَتْ","دُرَّ المُحِيطِ وَمُفْرَدَاتِ المُعْجَمِ",4,"م",1,0],["لو حاز موسى مضاء عزمته","ماتاه في التيه عندما دخله",5,"ل",2,0],["لو حكّم العقلَ الحجيج بحجّهم","أبَوُ الطواف بتلكم الجدران",6,"ن",1,0],["لَو حَلَّ جارُكُمُ إِلَيَّ مَنَعتُهُ","بِالخَيلِ تَنحِطُ وَالقَنا يَتَزَعزَعُ",7,"ع",1,0],["لَو حَلَّ مِثلَكَ مِن رِياحٍ وَسطَنا","جاراً لَكانَ جِوارُهُ في مَحرَمِ",8,"م",1,0],["لو حنّت الورق حنيني نحوكم","لمزقت من أسفٍ أطواقها",9,"ق",3,0],["لو حُدِّثتْ عن فيشةٍ ضخمةٍ","بطَنْجةٍ سارتْ إلى طنجَهْ",10,"ج",2,0],["لو حُكتَ في السيفِ الذي كافحتَهُ","ما حاك فيك لأسرعَ التهليلا",11,"ل",2,0],["لو حُسّنَتْ معشارَ ما قبّحتْ","خُوّلتِ الأهواءُ تخويلا",12,"ل",2,0],["لَوْ حزَّ مِنْ نفسه لسائله","أَنْفَسَ أعضائه لما أَلِما",13,"م",2,0],["لو حيزت الجنات يوما حازها","ذو العلم قبل الزاهد المتهجد",14,"د",1,0],["لو حكم النقد بعد","ل فهو نعم الحكم",15,"م",1,0],["لَو حَلَّ خاطِرُهُ في مُقعَدٍ لَمَشى","أَو جاهِلٍ لَصَحا أَو أَخرَسٍ خَطَبا",16,"ب",2,0],["لَو حَمى سَيِّداً مِنَ المَوتِ حامٍ","لَحَماكَ الإِجلالُ وَالإِعظامُ",17,"م",1,0],["لَو حَسَبنا ما عَلَيهِ وَلَهُ","لَكَفَرنا أَن حُرِمنا وَرُزِق",18,"ق",1,0],["لو حُدَّ مُنْتَهِبُ القَريضِ تجاوَزوا","في الحَدِّ أو قُطعوا منَ الآباطِ",19,"ط",1,0],["لَو حَسا اِبنُ التِسعينَ مِنها ثَلاثاً","أَبدَلَت قَوسَ قَدِّهِ بِقَناةِ",20,"ه",1,0],["لَو حَسَوها بِما لَها مِن شُروطٍ","بَدَّلَت سَيِّئاتِهِم حَسَناتِ",20,"ت",1,0],["لَو حَسا مِن سُلافِها الأَكمَهُ الأَخ","رَسُ كَأساً لَاِ ستَخرَجَ التَقويما",21,"م",2,0],["لو حملت منه قلوبُ العدى","جراحَ قلبٍ ما حَمَلْنَ الجراح",22,"ح",1,0],["لَو حارَ مُرتادُ المَنِيَّةِ لَم يُرِد","إِلّا الفِراقَ عَلى النُفوسِ دَليلا",23,"ل",2,0],["لو حطَّ رحلي فوقَ النجمِ رافعُهُ","ألفيتُ ثمَّ خيالاً منك ينتظرُ",24,"ر",1,0],["لو حطَّ رحلي فوقَ النجمِ رافعُهُ","ألفيتُ ثمَّ خيالاً منكَ منتظري",25,"ر",2,0],["لَو حَمَلَ اللَيلُ حُسنَ دُهمَتِهِ","أَمتَعَ طَرفَ المُحِبِّ بِالسَهَرِ",26,"ر",1,0],["لَو حَباني مِن ريقِهِ","كانَ تِرياقَ عَقرَبَين",27,"ن",1,0],["لَو حَوَت مِن جَلالِكَ الشُهُبُ حَظّاً","ما بَدَت في العُيونِ وَهيَ صِغارُ",28,"ر",1,0],["لَو حانَ وِردُ تَميمٍ ثُمَّ قيلَ لَها","حَوضُ الرَسولِ عَلَيهِ الأَزدُ لَم تَرِدِ",29,"د",1,0],["لَو حَلَلنا وَسطَ جَنَّةِ عَدنٍ","لَاِقتَرَحناكَ عَلَيها اِقتِراحا",30,"ح",2,0],["لو حمتْه الطعنة السُّلْكى لمَا","كان إبراهيمُ فيه يُضْطهَدَ",31,"د",1,0],["لَو حَلَبَ الأَرضَ بِأَخلافِها","دَرَّت لَكَ الحَربُ دَماً فَاِحلُبِ",32,"ب",1,0],["لَو حاطَنا اللَهُ لَم نَحفِل بِمَرزِيَةٍ","وَكَيفَ يَخشى رَزايا الدَهرِ مَن حاطا",33,"ط",2,0],["لَو حاوَرَتكَ الضَأنُ قالَ حَصيفُها","الذِئبُ يَظلِمُ وَاِبنَ آدَمَ أَظلَمُ",34,"م",1,0],["لو حَطّ رَحْليَ فَوْقَ النجْمِ رافِعُه","وجَدتُ ثَمّ خَيالاً منكِ مُنتظِري",35,"ر",2,0],["لوَحْشِيِّها مِنْ جانبَيْ زَفَيانِها","حَفِيفٌ كَخُذْرُوفِ الوَلِيدِ المُثَقَّبِ",36,"ب",1,0],["لو حَمَلُ الشُّهْبِ كان يَمْلِكُها","ثُمّ هَوَتْ عنه للتّرابِ مَأى",37,"ا",2,0],["لَوْ حَذِرَ الْمَرءُ كُلَّ لائِمَةٍ","لَضَاعَ مِنْهُ الصَّوَابُ وَالرَّشَدُ",38,"د",1,0],["لو حاق مكرهم بأجهل أمة","برمت محاكمها بهم وحبوسها",39,"س",3,0],["لوحان من فجر الصبا وورده","غذاهما قلب وروى محجر",40,"ر",1,0],["لو حلَّ بالوادي المقدَّسِ ركبُهُم","لشِفَاء غُلَّتهم لجفَّ الوادِي",41,"د",2,0],["لَوحهُ المَكتوبُ أَرجَت مَحوهُ","لِتَرى ما خَطَّ مِنهُ وَمَشَق",42,"ق",1,0],["لو حزتَ كلَّ حياةٍ صنت مهجتَها","خَلَدت كالشمسِ إشراقاً وإصباحا",43,"ح",2,0],["لو حاكت التيجانُ تاجَك، لم يجد","يومًا إليها الثائرون سبيلا",44,"ل",2,0],["لوحي لنا مثل الجُما","ن مجرَّدًا من قشره",45,"ر",2,0],["لوّحوا بالقيود فابتدر الموت","أباة تنمّروا للقيود",46,"د",1,0],["لوحشِيها من جانبَي زَفيَانِها","حفيف كخذروف الوليد المنقبِ",47,"ب",1,0],["لوح عرفان دقائقه","نقشت في هيكل الأمد",48,"د",1,0],["لوح البراهين ختم المرسلين ملا","ذ الخاطئين مغيث المذنب الجاني",49,"ن",2,0],["لو حَوَى الدنيا جميعاً في يديهِ","وبكَى إن فاتَه شىءٌ عليهِ",50,"ه",1,0],["لو حدَّقَ المرءُ في البَرايا","لَشامَ ما لا تَرى العُيون",51,"ن",1,0],["لوحتِ باليد والرِّداء","لتَراكِ لكن لا رَجاء",52,"ا",2,0],["لو حاول المحظوظ خرق عادة","شد على ظهر البعوض القتب",53,"ب",1,0],["لو حاول الثقلان ضرك بعدما","أواك ما وجدوا إليك سبيلا",54,"ل",2,0],["لَو حَلَّها كِسرى لَقالَ لِما يَرى","نَفسي لِمَن يبغي الخَرابَ لَها الفِدا",55,"د",2,0],["لَو حَلَّها آدَمٌ مِن بَعدِ جَنَّتِهِ","لَم يَبغ عَنها إِلى الفِردَوسِ مِن حِوَلِ",56,"ل",1,0],["لو حصّل الناس ما أحصّله","ما تم للمرء ما يؤمّله",57,"ل",2,1],["لَو حَباهم مِن عُلاه طرَفا","أغرقَ الكلّ ببحر المننِ",58,"ن",1,0],["لو حُزَّ بالسيف رأسي في محبَّتكم","لَمالَ يهوي إليكم مسرعاً راسي",59,"ي",1,1],["لو حُرِّكا انتثرا شكلاً وإن نطقا","تناثرا لؤلؤاً نظماً وما نُظِما",60,"م",2,0],["لو حلَّ جَدْبٌ على الدُّنيا وكانَ بها","يُغْنِي نَدى كفِّهِ عن وابلِ العرمِ",61,"م",1,0],["لَو حباكِ السُلطانَ رَبُّكِ يَوماً","لَاِستَحَلَّيتِ مصرعاً لِلرِّجالِ",62,"ل",1,0],["لو حملَتْني مُقْلةٌ لم يكن","يَألَمُ مِنْ حَمْلي لها جَفْنُ",63,"ن",1,0],["لو حَمَى معشراً من القوم حامٍ","لحمتْ قوميَ العُلاَ والخِيرُ",64,"ر",1,0],["لو حملتها العيون ما ألِمتْ","ولو حواها الفؤاد ما شعرا",65,"ر",2,0],["لو حاسبوا أنفسَهم لم يكن","لهمْ على إحدى المعاصي ثَباتْ",66,"ت",1,0],["لَو حَلَّهُ ذِئبُ الفَلا مَوهِناً","ذاقَ الرَدى وَالصُبحُ لَم يُسفِرِ",67,"ر",1,0],["لَوْ حَمَلَتْهُ جِبَالُ رَضْوَى","لَظَلَّتْ أَعْنَاقُهَا مَرْقُوصَهْ",68,"ص",2,0],["لَوْ حَلَّ فِيهَا مَنْ بَرَاهُ الْجَوَى","عَلَّلَهُ الأُنْسُ بِأَسْنَى الْكُؤُوسْ",69,"س",1,0],["لو حاولوا ما يدعون لوحدوا","دولا لهم مجموعهن قليل",70,"ل",1,0],["لَو حارَبَت أَرضٌ سِواها حارَبَت","أَرض الشامِ عليه أَرضَ الموصِل",71,"ل",1,0],["لو حدثت كسرى بذا نفسه","صفعته في وسط إيوانه",72,"ن",2,0],["لَو حملتهوج المطي غَرامه","ما جاوزتوادي الاراك وجودا",73,"د",2,0],["لَو حملت بعض ما حملت من حرق","ما اِستَعذبت ماءها الصافي وَمَرعاها",74,"ا",3,0],["لَوْ حُلِّيَ الْمَدْحُ السَّنِيُّ بِحِلْيَةٍ","يَوْماً لَذُهِّبَ ما أَقُولُ وَفُضِّضا",75,"ض",2,0],["لو حاكمته أواني ذا الأوان إلى","قاضٍ لقال أنا من خيرهن إنا",76,"ن",2,0],["لَوحٌ وَأَيدي الفيض ناقشةٌ بهِ","مثلَ الحقائقِ قدر ما يتوسّعُ",77,"ع",1,0],["لوحةٌ أثبتَ الزمان عليها","أبَدِيَّ الظلال والألوان",78,"ن",1,0],["لو حكَى الدّهرُ بعضَهنّ بقاءً","عاش من بعدِ عُمْرِه الدَّهرُ دهرا",79,"ر",2,0],["لو حَمَّلوا عِبْءَ قلبي مَتْنَ شاهقةٍ","صارتْ طرائقَ من أقطارِها قِدَدا",80,"د",2,0],["لو حزته لحظيت منه بمقلةٍ","حوراء تخلِسُ لحظهن وتسلخ",81,"خ",1,0],["لو حابك ألفي سَنه","كأنها فيه سِنه",82,"ه",1,0],["لَو حَلَّ هَميانُهُ مِن خصره سَقطت","مِنهُ قُلوب طَواها تَحتَ عقدَتِهِ",83,"ت",2,0],["لو حاولُوا الأفلاكَ ما قَصُرتْ","عنها أكفُّهُمُ ولا ضَعُفُوا",84,"ف",3,0],["لو حَاوَل الخلقُ جمعاً حملَ ما لَكَ مِن","مَنٍّ عليه وأدنى شكرِهِ ضَعُفُوا",85,"ف",3,0],["لو حاتم ابصر بعضا من","جدواه لا طرق ذا غما",86,"م",2,0],["لو حَجَبَ الحَمْدَ عنه ذو شَرَف","ما سَمِعَ اللهُ حَمْدَ مَنْ حَمِده",87,"د",2,0],["لو حلّقَتْ يوماً قوادمُه","لم يرضَ عند سواك من وكْرِ",88,"ر",1,0],["لو حلّ عن خدّيْهِ عِقد لثامِه","نقلَ الهلال الى صِفاتِ تمامِه",89,"م",2,1],["لو حكى سقمي خلال فيه ما","كنت أظهرت هواه للأخلا",90,"ل",2,0],["لو حَبانِي بذاكَ عَصْرُ شبابِي","لَرآنِي عَلَى العبادِ أتِيهُ",91,"ه",1,0],["لو حلت الأسد فيها نوحت زهقاً","والخوف من ظلمها ماتت به السيد",92,"د",1,0],["لو حَرَص الموتُ على إيغاله","يطلبُ مَنْ تمنَعُهُ ما وصَلا",93,"ل",2,0],["لو حملَتْ عتبيَ الليالي","أو سمعتْ قلتُ ما بدا لي",94,"ل",2,1],["لو حفظَتْ عهديَ في ذخيرةٍ","لم أُلفَ يوماً بالشباب فاجعا",95,"ع",2,0],["لو حُكِّمتْ يقظَى لما زارت بلا","عِدَةٍ ولا وصلتْ بغيرِ رقيبِ",96,"ب",1,0],["لو حلَّ قفراً أوقدتْ رمضاؤهُ","ظُهراً لبُدِّلَ بالربيعِ المُبْقِلِ",97,"ل",1,0],["لو حمتْ منْ قَدرِ اللهِ وَغىً","وانثْنى جيشُ حِمامٍ بقِتالِ",98,"ل",1,0],["لو حَلَّ قَيْظَ تَنوفَةٍ","عادَتْ عَذاةً منْ رَبيعِ",99,"ع",1,0],["لو حَلَّ قَيْظاً عند مُقْفِرَةٍ","لزَها بها الحَوْذانُ والنَّفَلُ",100,"ل",1,0],["لو حَلَّ فوق النَّجم ذو شَرفٍ","أمْسى ومَوْطىءُ رِجْلِهِ زُحَل",101,"ل",1,0],["لو حاولت زهرَ الدُّجى عزماتهُ","لاستنفذت سلبَ السماكِ الأعزل",102,"ل",1,0],["لو حلَّ برح الجوى بمهجته","لدق معنى السقام في بدنه",103,"ن",2,0],["لو حلَّ جانحتيه فكرُ متيمٍ","وأراد معنى صبّوة لم يهتد",104,"د",1,0],["لَو حَلَت هَذِهِ الخِصلُ وَطابَت","لَم أَكُن مِن ذَواقِها كَالخِلالِ",105,"ل",1,0],["لو حل في الخمر حلت في شريعتنا","لكنما الخمر حلت في معانيه",106,"ي",2,0],["لو حملتم في الساقة اليوم عبداً","هو مداحُ ركبكم حسانه",107,"ن",2,0],["لو حارَبَتْكَ الأُسْدُ في فَلَواتِها","دُهِيَتْ ونابَ الكُلَّ منها عي",108,"ي",1,0],["لَوْحُ سِرِّ الحَقائقِ المُتَدلِّي","من ضَميرِ الغَيْبِ المَصونِ الأَمينِ",109,"ن",1,0],["لوْحُ محفوظُ العَما في طَيِّ ما","قامَ بالغيْبِ بهذا يُسْطَرُ",110,"ر",1,0],["لو حلَّ فيهم علة فرضِ المُحالِ لما","منهم تحَلَّلَ بالتَّحويلِ أجزاءُ",111,"ا",2,0],["لوحَنا الدّهر علينا لقَضى","باجتماعٍ بكمُ في المنُحَنى",112,"ن",2,0],["لو حصلت نوب الزمان بأسرها","وصروفه لغرقن في احسانه",113,"ن",2,0],["لو حَساها بَنو زُغاوَةَ يوماً","من سَناها لَلُقّبوا بالبُدورِ",114,"ر",1,0],["لو حوَتْ بعضَها سَجايا اللّيالي","بدّلَتْ غَدْرَها بحُسْنِ وَفاها",115,"ا",3,0],["لو حملت شم الجبال الذي","حملته منك على الكاهل",116,"ل",1,0],["لَو حاكَمَتكَ وَطالَبَتكَ بِذَحلِها","شَهِدَت عَلَيكَ مَلاحِمٌ وَنُسورُ",117,"ر",1,0],["لوحُ الوجود المسمى روح نفخته","وعقلُهُ قلمٌ كلَّ الورى رقما",118,"م",2,0],["لَوْ حرَّكَتْهُ وراء مُنْهَزِمٍ","عَلَى بَرِيدٍ لعاجَ والتَفَتَا",119,"ت",2,0],["لو حلَّها آدمُ مِنْ بعد مَا","أُخرج لم يَحْزن ولَمْ يَكْمَد",120,"د",1,0],["لوحدةِ العربِ يَسعى طالباً لهم","نيلَ السعادة حتّى شملهم جمعا",121,"ع",2,0],["لوح تضمن أحرفاً من فعله","قلم يشكل حرفه ويسطر",122,"ر",1,0],["لو حاولَ النسر الفتيُّ لحاقها","لارتدَّ خوارَ القُوى عَيانا",123,"ن",2,0],["لو حدَّثوا هُومير في دِيماسهِ","ببديع صنعكَ لاستردَّ حياتَه",124,"ت",2,1],["لوَّحَ الرأسَ وأبدى عجباً","وعَجيباً ما رآه بَيِّنا",125,"ن",2,0],["لو حكَّموه كما تعوَّد لم يكن","في الأرض إلا طاعة وجنوح",126,"ح",1,0],["لو حُمّل الثقلانِ ما حُمِّلْتُ من","شوقٍ لأثْقَلَ حَمْلُهُ الثقلين",127,"ن",1,0],["لو حمى نوبةً ودودٌ ودوداً","يا صحابي الوداد لا الأغشاشا",128,"ش",2,0],["لو حطّوا له قرايه","ما لقيوا له مطاح",129,"ح",1,0],["لَو حَلَّها زَمن الفُرسِ الّذينَ مَضوا","ما الفُرس فُرسٌ وَلا الإِيوانُ إِيوانُ",130,"ن",1,0],["لَو حَبَتني بِوَصلِها بَعدَ شَيبي","عادَ بَعدَ المَشيبِ حسنُ شبابي",131,"ب",2,0],["لَو حَبا وَرد ثَغرِهِ صَبّه كا","نَ عَلى الثَّ