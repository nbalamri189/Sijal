{"poems":[[53,"بمجال عزمي يملأ الملوان","https://www.aldiwan.net/poem29659.html","الكامل"],[53,"يا صاحب القلب الصحيح أما اشتفى","https://www.aldiwan.net/poem30126.html","الكامل"],[53,"يا دار من قتل الهوى بعدي","https://www.aldiwan.net/poem30622.html","الكامل"],[86,"ردوا علي بياني بعد محمود","https://www.aldiwan.net/poem10495.html","البسيط"],[93,"لقيتك مصر بثغرها المتبسم","https://www.aldiwan.net/poem11335.html","الكامل"],[88,"كان أبو الطيب امرأ قوله","https://www.aldiwan.net/poem44436.html","المنسرح"],[88,"لو أسكر الإنسان باطل أمره","https://www.aldiwan.net/poem45061.html","الطويل"],[27,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[27,"ما بال شرب بني الدلنطى ثابتا","https://www.aldiwan.net/poem6003.html","الكامل"],[72,"يا تاركين للمحب أدمعا","https://www.aldiwan.net/poem19361.html","الرجز"],[51,"وقينة أبرد من ثلجه","https://www.aldiwan.net/poem9259.html","السريع"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[51,"إذا تغنت شنطف مرة","https://www.aldiwan.net/poem65930.html","السريع"],[51,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[89,"لهفي على شيخ العروبة احمد","https://www.aldiwan.net/poem44636.html","الكامل"],[89,"ما الشعر الا نغم","https://www.aldiwan.net/poem44737.html","مجزوء الرجز"],[43,"دمع جرى فقضى في الربع ماوجبا","https://www.aldiwan.net/poem9465.html","البسيط"],[43,"لا افتخار إلا لمن لا يضام","https://www.aldiwan.net/poem10542.html","الخفيف"],[45,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[61,"بين الشنوف الحمر والأقراط","https://www.aldiwan.net/poem51578.html","البسيط"],[66,"أرسلت في الكؤوس بالمعجزات","https://www.aldiwan.net/poem39185.html","الخفيف"],[66,"أذكروا لما أروها النديما","https://www.aldiwan.net/poem39208.html","الخفيف"],[80,"من شاء أن تسكر راح براح","https://www.aldiwan.net/poem31514.html","السريع"],[44,"يوم الفراق لقد خلقت طويلا","https://www.aldiwan.net/poem30378.html","الكامل"],[69,"أزهر أفق أم الأزهار والغدر","https://www.aldiwan.net/poem28603.html","البسيط"],[69,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[74,"تقبل المهر من أخي ثقة","https://www.aldiwan.net/poem12929.html","المنسرح"],[81,"كيف أصغي للعاذلين","https://www.aldiwan.net/poem61482.html","مجزوء الخفيف"],[81,"هاتها كالمنار لاح النهار","https://www.aldiwan.net/poem61524.html","الخفيف"],[39,"إن الفؤاد للبائن الغرد","https://www.aldiwan.net/poem53795.html","البسيط"],[52,"عرف الدار فحيا وناحا","https://www.aldiwan.net/poem27159.html","المديد"],[75,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[50,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[46,"حملت ثقل الليالي في بني زمني","https://www.aldiwan.net/poem22910.html","البسيط"],[46,"وعظ الزمان فما فهمت عظاته","https://www.aldiwan.net/poem23321.html","الكامل"],[46,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72185","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16707","المنسرح"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42586","المنسرح"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142037","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141976","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43905","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54247","البسيط"],[106,"مبايعة الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179496",""],[106,"تمثال فينوس","https://www.poetsgate.com/ViewPoem.aspx?id=179776",""],[36,"طربت وما هذا بساعة مطرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16615&r=&rc=0",""]],"verses":[["لَو حارَبَت أُفقَ السَماءِ لِفَرَّقَت","بَينَ الثُرَيّا فيهِ وَالدَبَرانِ",0,"ن",1,0],["لَو حَيثُ يُستَمَعُ السِرارُ وَقَفتُما","لَعَجِبتُما مِن عِزِّهِ وَخُضوعي",1,"ع",2,0],["لَو حَرَّكَت ذاكَ الرَمادَ يَدٌ","لَرَأَت بَقايا الجَمرِ وَالوَقدِ",2,"د",1,0],["لَو حَنَّطوكَ بِشِعرٍ أَنتَ قائِلُهُ","غَنيتَ عَن نَفَحاتِ المِسكِ وَالعودِ",3,"د",1,0],["لَوْ حُصِّلَتْ أَسْمَاؤُهَا لاسْتَنْفَدَتْ","دُرَّ المُحِيطِ وَمُفْرَدَاتِ المُعْجَمِ",4,"م",1,0],["لو حاز موسى مضاء عزمته","ماتاه في التيه عندما دخله",5,"ل",2,0],["لو حكّم العقلَ الحجيج بحجّهم","أبَوُ الطواف بتلكم الجدران",6,"ن",1,0],["لَو حَلَّ جارُكُمُ إِلَيَّ مَنَعتُهُ","بِالخَيلِ تَنحِطُ وَالقَنا يَتَزَعزَعُ",7,"ع",1,0],["لَو حَلَّ مِثلَكَ مِن رِياحٍ وَسطَنا","جاراً لَكانَ جِوارُهُ في مَحرَمِ",8,"م",1,0],["لو حنّت الورق حنيني نحوكم","لمزقت من أسفٍ أطواقها",9,"ق",3,0],["لو حُدِّثتْ عن فيشةٍ ضخمةٍ","بطَنْجةٍ سارتْ إلى طنجَهْ",10,"ج",2,0],["لو حُكتَ في السيفِ الذي كافحتَهُ","ما حاك فيك لأسرعَ التهليلا",11,"ل",2,0],["لو حُسّنَتْ معشارَ ما قبّحتْ","خُوّلتِ الأهواءُ تخويلا",12,"ل",2,0],["لَوْ حزَّ مِنْ نفسه لسائله","أَنْفَسَ أعضائه لما أَلِما",13,"م",2,0],["لو حيزت الجنات يوما حازها","ذو العلم قبل الزاهد المتهجد",14,"د",1,0],["لو حكم النقد بعد","ل فهو نعم الحكم",15,"م",1,0],["لَو حَلَّ خاطِرُهُ في مُقعَدٍ لَمَشى","أَو جاهِلٍ لَصَحا أَو أَخرَسٍ خَطَبا",16,"ب",2,0],["لَو حَمى سَيِّداً مِنَ المَوتِ حامٍ","لَحَماكَ الإِجلالُ وَالإِعظامُ",17,"م",1,0],["لَو حَسَبنا ما عَلَيهِ وَلَهُ","لَكَفَرنا أَن حُرِمنا وَرُزِق",18,"ق",1,0],["لو حُدَّ مُنْتَهِبُ القَريضِ تجاوَزوا","في الحَدِّ أو قُطعوا منَ الآباطِ",19,"ط",1,0],["لَو حَسا اِبنُ التِسعينَ مِنها ثَلاثاً","أَبدَلَت قَوسَ قَدِّهِ بِقَناةِ",20,"ه",1,0],["لَو حَسَوها بِما لَها مِن شُروطٍ","بَدَّلَت سَيِّئاتِهِم حَسَناتِ",20,"ت",1,0],["لَو حَسا مِن سُلافِها الأَكمَهُ الأَخ","رَسُ كَأساً لَاِ ستَخرَجَ التَقويما",21,"م",2,0],["لو حملت منه قلوبُ العدى","جراحَ قلبٍ ما حَمَلْنَ الجراح",22,"ح",1,0],["لَو حارَ مُرتادُ المَنِيَّةِ لَم يُرِد","إِلّا الفِراقَ عَلى النُفوسِ دَليلا",23,"ل",2,0],["لو حطَّ رحلي فوقَ النجمِ رافعُهُ","ألفيتُ ثمَّ خيالاً منك ينتظرُ",24,"ر",1,0],["لو حطَّ رحلي فوقَ النجمِ رافعُهُ","ألفيتُ ثمَّ خيالاً منكَ منتظري",25,"ر",2,0],["لَو حَمَلَ اللَيلُ حُسنَ دُهمَتِهِ","أَمتَعَ طَرفَ المُحِبِّ بِالسَهَرِ",26,"ر",1,0],["لَو حَباني مِن ريقِهِ","كانَ تِرياقَ عَقرَبَين",27,"ن",1,0],["لَو حَوَت مِن جَلالِكَ الشُهُبُ حَظّاً","ما بَدَت في العُيونِ وَهيَ صِغارُ",28,"ر",1,0],["لَو حانَ وِردُ تَميمٍ ثُمَّ قيلَ لَها","حَوضُ الرَسولِ عَلَيهِ الأَزدُ لَم تَرِدِ",29,"د",1,0],["لَو حَلَلنا وَسطَ جَنَّةِ عَدنٍ","لَاِقتَرَحناكَ عَلَيها اِقتِراحا",30,"ح",2,0],["لو حمتْه الطعنة السُّلْكى لمَا","كان إبراهيمُ فيه يُضْطهَدَ",31,"د",1,0],["لَو حَلَبَ الأَرضَ بِأَخلافِها","دَرَّت لَكَ الحَربُ دَماً فَاِحلُبِ",32,"ب",1,0],["لَو حاطَنا اللَهُ لَم نَحفِل بِمَرزِيَةٍ","وَكَيفَ يَخشى رَزايا الدَهرِ مَن حاطا",33,"ط",2,0],["لَو حاوَرَتكَ الضَأنُ قالَ حَصيفُها","الذِئبُ يَظلِمُ وَاِبنَ آدَمَ أَظلَمُ",34,"م",1,0],["لو حَطّ رَحْليَ فَوْقَ النجْمِ رافِعُه","وجَدتُ ثَمّ خَيالاً منكِ مُنتظِري",35,"ر",2,0],["لوَحْشِيِّها مِنْ جانبَيْ زَفَيانِها","حَفِيفٌ كَخُذْرُوفِ الوَلِيدِ المُثَقَّبِ",36,"ب",1,0],["لو حَمَلُ الشُّهْبِ كان يَمْلِكُها","ثُمّ هَوَتْ عنه للتّرابِ مَأى",37,"ا",2,0],["لَوْ حَذِرَ الْمَرءُ كُلَّ لائِمَةٍ","لَضَاعَ مِنْهُ الصَّوَابُ وَالرَّشَدُ",38,"د",1,0],["لو حاق مكرهم بأجهل أمة","برمت محاكمها بهم وحبوسها",39,"س",3,0],["لوحان من فجر الصبا وورده","غذاهما قلب وروى محجر",40,"ر",1,0],["لو حلَّ بالوادي المقدَّسِ ركبُهُم","لشِفَاء غُلَّتهم لجفَّ الوادِي",41,"ي",1,0],["لَوحهُ المَكتوبُ أَرجَت مَحوهُ","لِتَرى ما خَطَّ مِنهُ وَمَشَق",42,"ق",1,0],["لو حزتَ كلَّ حياةٍ صنت مهجتَها","خَلَدت كالشمسِ إشراقاً وإصباحا",43,"ح",2,0],["لو حاكت التيجانُ تاجَك، لم يجد","يومًا إليها الثائرون سبيلا",44,"ل",2,0],["لوحي لنا مثل الجُما","ن مجرَّدًا من قشره",45,"ر",2,0],["لوحشِيها من جانبَي زَفيَانِها","حفيف كخذروف الوليد المنقبِ",46,"ب",1,0]]}