{"poems":[[45,"هذي المعاهد من سعاد فسلم","https://www.aldiwan.net/poem66637.html","البسيط"],[31,"نعق الغراب ببين ذات الدملج","https://www.aldiwan.net/poem42592.html","الكامل"],[31,"ردع الفؤاد تذكر الأطراب","https://www.aldiwan.net/poem42614.html","الكامل"],[74,"الليل إلا حيث كنت طويل","https://www.aldiwan.net/poem13223.html","الكامل"],[429,"لو أن ذا قلمي قوى كلمي","https://www.aldiwan.net/poem12401.html","أحذ الكامل"],[456,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"]],"verses":[["فَقَعوا عَلى أَحسابِكُم وَهُبوطِها","وَدَعوا العُلُوَّ فَإِنَّهُ لِلأَنجُمِ",0,"م",1,0],["فَقَعَدتُ مُرتَقِباً أُلِمُّ بِبَيتِها","حَتّى وَلَجتُ بِهِ خَفِيَّ المَولَجِ",1,"ج",1,0],["فَقَعَدتُ كَالمُهريقِ فَضلَةَ مائِهِ","في حَرِّ هاجِرَةٍ لِلَمعِ سَرابِ",2,"ب",1,0],["فَقَعَدتَ بِالأَعداءِ قِعدَةَ خالِعٍ","ثَوبَ العَزازَةِ عَنهُ فَهوَ ذَليلُ",3,"ل",1,0],["فقعدتُ عن تكليفِها سِيراً","قامَ الزمانُ بها على قَدَمِ",4,"م",1,0],["فقع بكوفان فقل لبدرها","إن بلَّغتك العيسُ ذاك الأفُقا",5,"ق",2,0]]}