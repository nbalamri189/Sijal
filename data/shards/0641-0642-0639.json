{"poems":[[47,"هذي المعاهد من سعاد فسلم","https://www.aldiwan.net/poem66637.html","البسيط"],[33,"نعق الغراب ببين ذات الدملج","https://www.aldiwan.net/poem42592.html","الكامل"],[33,"ردع الفؤاد تذكر الأطراب","https://www.aldiwan.net/poem42614.html","الكامل"],[76,"الليل إلا حيث كنت طويل","https://www.aldiwan.net/poem13223.html","الكامل"],[438,"لو أن ذا قلمي قوى كلمي","https://www.aldiwan.net/poem12401.html","أحذ الكامل"],[463,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63820","الوافر"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129516","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26403","الوافر"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114751","الكامل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139923","الكامل"],[4729,"جَاذِبِ العيسَ نُسوعاً وزَماما","https://www.poetsgate.com/ViewPoem.aspx?id=109474",""],[5582,"أَلا حَيِّ مِنْ دارِ سُعْدَى مُقامَا","https://www.poetsgate.com/ViewPoem.aspx?id=63572",""],[5732,"دار لنا","https://www.poetsgate.com/ViewPoem.aspx?id=177832",""]],"verses":[["فَقَعوا عَلى أَحسابِكُم وَهُبوطِها","وَدَعوا العُلُوَّ فَإِنَّهُ لِلأَنجُمِ",0,"م",1,0],["فَقَعَدتُ مُرتَقِباً أُلِمُّ بِبَيتِها","حَتّى وَلَجتُ بِهِ خَفِيَّ المَولَجِ",1,"ج",1,0],["فَقَعَدتُ كَالمُهريقِ فَضلَةَ مائِهِ","في حَرِّ هاجِرَةٍ لِلَمعِ سَرابِ",2,"ب",1,0],["فَقَعَدتَ بِالأَعداءِ قِعدَةَ خالِعٍ","ثَوبَ العَزازَةِ عَنهُ فَهوَ ذَليلُ",3,"ل",1,0],["فقعدتُ عن تكليفِها سِيراً","قامَ الزمانُ بها على قَدَمِ",4,"م",1,0],["فقع بكوفان فقل لبدرها","إن بلَّغتك العيسُ ذاك الأفُقا",5,"ق",2,0],["فقعْ في بابِ قِنّسْرِينَ فانظرْ","إلى جَزَعِ النساءِ على القبور",6,"ر",1,0],["فقعدت عن زجر القلا","ص وكنت قبلا غير قاعد",7,"د",1,0],["فَقَعقَعَتِ السَرايا جانِبَيها","وَأَلحَفَتِ الفَوارِسُ بِالسِهامِ",8,"م",1,0],["فَقَعُوا عن الأكوار وق","عةَ خاضعِ الذِّفرى ذليل",9,"ل",1,0],["فقعدتُ في بيتٍ صغير مُظلم","لا شيءَ فيه سوى حصير الجامعِ",10,"ع",1,0],["فقعَدتُم عن أخٍ لو رُمتُم","لهززتُم منهُ في حَفلٍ حُسَاما",11,"م",2,0],["فَقَعْ خاسِئاً يا حَسُودِي وَمُتْ","بِغَيْظِكَ كُرْهاً وَسُفَّ الرَّغاما",12,"م",2,0],["فقعه مصاليع على روس الاشهاد","والوبل من غر الروايح غبوقه",13,"ق",2,0]]}