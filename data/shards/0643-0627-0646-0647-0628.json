{"poems":[[36,"لو أنني أسطيع صبرا وسلوة","https://www.aldiwan.net/poem4885.html","الطويل"],[32,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[32,"يا حاديي بنت فضاض أما لكما","https://www.aldiwan.net/poem29609.html","البسيط"],[32,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[29,"انظر خليلي بأعلى ثرمداء ضحى","https://www.aldiwan.net/poem5927.html","البسيط"],[74,"سقى حماك من الوسمي باكره","https://www.aldiwan.net/poem18704.html","البسيط"],[53,"ألذ من فائقة الإبهط","https://www.aldiwan.net/poem65027.html","الرجز"],[53,"يا من أغار عليه من غلائله","https://www.aldiwan.net/poem65939.html","البسيط"],[31,"حلت صبيرة أمواه العداد وقد","https://www.aldiwan.net/poem6069.html","البسيط"],[91,"انظر إلى الكواكب","https://www.aldiwan.net/poem44667.html","مجزوء الرجز"],[87,"يا سعد إن أنت دخلت لوندرة","https://www.aldiwan.net/poem7263.html","الرجز"],[58,"نغفل والأيام لا تغفل","https://www.aldiwan.net/poem58538.html","السريع"],[45,"وشامخ من الجبال أقود","https://www.aldiwan.net/poem9548.html","الرجز"],[64,"ورافل في صوان الحسن مشتمل","https://www.aldiwan.net/poem52300.html","البسيط"],[68,"أما ترى الأنواء والسحائبا","https://www.aldiwan.net/poem40945.html","الرجز"],[50,"بادر شبابك قبل الشيب والعار","https://www.aldiwan.net/poem63284.html","البسيط"],[50,"وبلدة فيها زور","https://www.aldiwan.net/poem63368.html","مجزوء الرجز"],[8,"هل بالديار الغداة من صمم","https://www.aldiwan.net/poem21838.html","المنسرح"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85422","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[36,"ولَوْ أنَّني أسطيعُ صبراً وسلوة ً","https://www.poetsgate.com/ViewPoem.aspx?id=14397",""],[119,"من الهوى آه","https://www.aldiwan.net/poem40430.html","عموديه"],[129,"انظر إلى البدر في السماء وقد","https://www.aldiwan.net/poem4088.html","المنسرح"],[136,"إن لم تكن قد أحست البين من سلمه","https://www.aldiwan.net/poem54753.html","البسيط"],[234,"مزجت ماء الكروم","https://www.aldiwan.net/poem50818.html","مجزوء الرمل"],[242,"ثغر الزمان تبسم","https://www.aldiwan.net/poem19075.html","المجتث"],[266,"رمقن ما بي فعفن الحب من رمقي","https://www.aldiwan.net/poem38225.html","البسيط"],[287,"وشادن صبغة شربوشه","https://www.aldiwan.net/poem32444.html","السريع"],[336,"إني أتتني لسان ما أسر بها","https://www.aldiwan.net/poem518.html",""],[368,"أو قارح في الغرابيات ذو نسب","https://www.aldiwan.net/poem1711.html","البسيط"],[411,"لنا صديق خير أحواله","https://www.aldiwan.net/poem49566.html","السريع"],[435,"للمرء في حادثات الدهر آمال","https://www.aldiwan.net/poem40075.html","البسيط"],[435,"يا نائيا وفؤاد الصب مأواه","https://www.aldiwan.net/poem41023.html","البسيط"],[463,"أروض الوادي أم ابيض الغسق","https://www.aldiwan.net/poem56090.html","الرجز"],[473,"وليلة أيقظني معانقي","https://www.aldiwan.net/poem59521.html","الرجز"],[490,"إني أتتني لسان لا أسر بها","https://www.aldiwan.net/poem1121.html",""],[706,"","https://poetry.dctabudhabi.ae/diwan/poem/144827","البسيط"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39086","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37928","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56124","البسيط"],[1192,"","https://poetry.dctabudhabi.ae/diwan/poem/74130","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46507","الرجز"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128696","البسيط"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11886","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77911","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128045","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49590","الرجز"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87856","البسيط"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66244","الرجز"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93541","البسيط"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115480","السريع"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100787","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87393","البسيط"],[3374,"","https://poetry.dctabudhabi.ae/diwan/poem/145402","الطويل"],[3552,"","https://poetry.dctabudhabi.ae/diwan/poem/27121","البسيط"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35892","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110119","الطويل"],[3680,"","https://poetry.dctabudhabi.ae/diwan/poem/203331","الرجز"],[3715,"","https://poetry.dctabudhabi.ae/diwan/poem/17486","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85259","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66533","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59457","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114518","البسيط"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119503","البسيط"],[4306,"","https://poetry.dctabudhabi.ae/diwan/poem/121962","المنسرح"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76689","الوافر"],[4927,"حلب","https://www.poetsgate.com/ViewPoem.aspx?id=30191",""],[4978,"ترحيبية بالشاعر الدكتور جمال مرسي","https://www.poetsgate.com/ViewPoem.aspx?id=188888",""],[778,"اشرب فقد زالت المعاذير","https://www.poetsgate.com/ViewPoem.aspx?id=89156",""],[5392,"..للخيوط ذهولُ","https://www.poetsgate.com/ViewPoem.aspx?id=11293",""],[5703,"لن أنساه","https://www.poetsgate.com/ViewPoem.aspx?id=215194",""],[463,"أروَّضَ الوادي أمْ ابيضَّ الغسقْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60167&r=&rc=223",""]],"verses":[["كَأَنَّ هُبوبَ الريحِ مِن نَحوِ أَرضَكُم","يُثيرُ فُتاتَ المِسكِ وَالعَنبَرَ النَدى",0,"د",2,0],["كَأَنَّهُ بِالضُحى تَرمي الصَعيدَ بِهِ","دَبّابَةٌ في عِظامِ الرَأسِ خُرطومُ",1,"م",1,0],["كَأَنَّهُ بَينَ شَرخَي رَحلِ ساهِمَةٍ","حَرفٍ إِذا ما اِستَرَقَّ اللَيلُ مَأمومُ",1,"م",1,0],["كَأَنَّهُ بَعدَ ما تُغضي العُيونُ بِهِ","عَلى الرُقادِ سُلافٌ غَيرُ مَمزوجِ",2,"ج",1,0],["كَأَنَّهُ بَيتُ عَطّارٍ يُضَمِّنُهُ","لَطائِمَ المِسكِ يَحويها وَتُنتَهَبُ",3,"ب",1,0],["كَأَنَّهُ بَعدَ تَحنانِ الرِياحِ بِهِ","رَقٌّ تَبَيَّنُ فيهِ اللامُ وَالأَلِفُ",4,"ف",1,0],["كأنه بيت شعر في عروض جوى","دارت عليهِ بلا ذنبٍ دوائره",5,"ر",2,0],["كأنه بعضُ رجال الزُّطِ","قالت نحُطُّ الهدْي قلنا حُطِّي",6,"ط",2,0],["كأنه بين أحوالٍ تَدَاوَلُهُ","بدرٌ تهاداه شتّى من مَغازلِهِ",7,"ل",2,0],["كَأَنَّهُ بَعدَ طولِ الشَدِّ إِذ لَحِقَت","جِحشانُها وَاِنطَوَت أَمعاؤُهُ مَسَدُ",8,"د",1,0],["كأنه باز جرى","يسطو على ارانب",9,"ب",1,0],["كأنه بوتا الفتى المظفّر","بين صفوف المعجبين يخطر",10,"ر",1,0],["كأنّهُ بينَ شَنَاظِيرِهَا","بارِقَةٌ تَكْمُنُ أَوْ تَمْثُلُ",11,"ل",1,0],["كَأَنَّهُ بَدءُ عِذارِ الأَمرَدِ","فَلَم يَكَد إِلّا لِحَتفٍ يَهتَدي",12,"د",2,0],["كأنه بين أطمارٍ له قطعٍ","بدرٌ بدا من شقوقِ الغيم في سَمَلِ",13,"ل",1,0],["كَأَنَّهُ بَرقٌ أَضاءَ وَخَبا","يَقطَعُ مَتنَ الريحِ مِن غيرِ شَبا",14,"ب",2,0],["كَأَنَّهُ بَرَدٌ في الطَوقِ مِنتَظِمٌ","في غَيرِ سِلكٍ وَلَم يوثَق بِمِسمارِ",15,"ر",1,0],["كَأَنَّهُ بَعدَ الضُمُر","وَبَعدَما جالَ الضُفُر",16,"ر",1,0],["كأَنَّهُ بَعَدما تَقَطَّعتِ ال","خَيلُ وَمالَ الحَمِيمُ بِالجُرُمِ",17,"م",1,0],["كأَنَّه بحر هوى","من المحل الأرفع",18,"ع",1,0],["كأنه بالحنين يقضي","لُبانةَ الروح والجسدْ",19,"د",1,0],["كأَنَّه بَسَماتٌ","للوصلِ بعد التجنّي",20,"ن",2,0],["كأَنَّ هُبُوبَ الرِّيحِ مِنْ نَحْوِ أَرْضِكُمْ","يُثِيرُ فُتَاتَ المِسْكِ والعَنْبَرَ النَّدَّا",21,"د",2,0],["كأنه بدر","في برج مجلاه",22,"ا",2,0],["كأنّه بِركة مفضَّضةٌ","حَفّ بِها مِن جِهاتِها زَهرُ",23,"ر",1,0],["كَأنَّه بَينَها لَو لَم يَكُن خَرقاً","عِرسٌ كَرِيمٌ عَلاَ الأقوَامَ في الكَرَمَه",24,"م",2,0],["كأنّه بدُر تِمٍّ","في جُنحِ ليل بهيم",25,"م",1,0],["كَأَنَّهُ بِنَدَاهُ","وَجْهٌ صَبِيحٌ مُلَثَّمْ",26,"م",1,0],["كأنه بعض حسادي بها حنقا","إن الحسود وعاء الحمق والحنق",27,"ق",1,0],["كَأَنَّهُ بَدرٌ تَجَلّى لَنا","مِن شَفَقٍ أَحمَرَ كَالعَندَمِ",28,"م",1,0],["كَأَنّهُ بَعْدَ صِدْقِ القَوْمِ أَنْفُسَهم","بِالبأسِ يَلْمَعُ مِنْ أَقْدَامِهِ الشّرَرُ",29,"ر",1,0],["كَأَنَّهُ بَعدَما صَدَّرنَ مِن عَرَقٍ","سيدٌ تَمطَّرَ جُنحَ اللَيلِ مَبلولُ",30,"ل",1,0],["كأنَّهُ بابُ المُضافِ الذّي","ليسَ يُواتيهِ سِوى الجَرِّ",31,"ر",1,0],["كأنه بهم والحرب دائرةٌ","على كتائبها ليثٌ وأشبالُ",32,"ل",1,0],["كأنه بلبل الآداب حين شدا","نظما بليغا غدا قلبي معنّاه",33,"ا",2,0],["كأنه بالموت يقضي لذّةً","أو بفراقِ نفسهِ يشفي حَنَقْ",34,"ق",1,0],["كَأَنَّهُ بَدرٌ عَلى قَضيبِ","تَميلُهُ الرِياحُ في كَثيبِ",35,"ب",1,0],["كأنه بعد صدق القوم أنفسهم","باليأس تلمع من قدامه البشر",36,"ر",1,0],["كأنه بظلام الليلِ ممتزجاً","سمراءُ تفترُّ أبدتْ مبسماً شَنِبَا",37,"ب",2,0],["كأنَّهُ بَحْرٌ طَما مَوْجُهُ","نُوّارُهُ مِنْ فَوْقِهِ كالحَبابْ",38,"ب",1,0],["كَأَنّهُ بَحرُ عودٍ مَوجُه ذَهبٌ","ما ماجَ حتّى اِستَحالَ العُودُ ياقوتا",39,"ت",2,0],["كَأَنَّهُ بَعْدَ رِيَاحٍ تَدْهَمُهْ","وَمُرْثَعِنّاتِ الدُجُونِ تَثِمُهْ",40,"م",2,0],["كأنه بلبل الأدب حين شدا","نظماً بديعاً إلى القمريّ معناهُ",41,"ا",2,0],["كأَنَّه بمشيبي حين كتَّبها","صَحيفَةٌ كَتبتها كَفُّ أُمى",42,"ا",1,0],["كَأَنَّهُ بَينَ القريض وَالخطب","مخدومه بَينَ المُلوك وَالعَرَب",43,"ب",1,0],["كأنه بيت شعر في عروض جفا","مقطّع عملت فيه التفاعيل",44,"ل",1,0],["كَأَنَّهُ بَدرُ دُجىً","في كَفِّهِ شَمسُ ضُحى",45,"ح",2,0],["كأَنَّ هبوب الريح كل عشية","وَضاحية بين الجهات هبوبي",46,"ب",2,0],["كأنه بسواد الصدغ مكتحل","فما رنا الا سل باتره",47,"ر",2,0],["كأنّه بالشّفَقِ الأدْنى طُلِي","يَرْنُو بشعلتي لظىً لم يُشعَل",48,"ل",1,0],["كَأَنَّهُ بِدَمِ العُشّاقِ مُختَضِبٌ","عَذبُ المُقَبَّلِ أَمّا رَشفُهُ فَمَري",49,"ر",2,0],["كأنه برج السما","اطلع منه الفرقدا",50,"د",2,0],["كَأَنَّهُ بِجهاد المارقين شَبا","سَيف الوَصي أَبيه لَيسَ بِالنابي",51,"ب",2,0],["كأنّه بدرٌ وقد رُصِّعَت","فيه ثريّا من سكاريج",52,"ج",1,0],["كأنه بالشباب الغض منطلق","كلاهما في براح العمر منتهب",53,"ب",1,0],["كأَنَّهُ بلسان الحال يهتِفُ في","بكآئِه اليُتمُ يا أُمّاهُ أَبكاني",54,"ن",2,0],["كأن هبوبك وقت الصباح","على الروض من ريش جبريل مسحه",55,"ح",2,0],["كَأَنَّهُ بَينَ إِستارَينِ قَدَّهُما","سُراةُ أَورَقَ مَطلِيٍّ مِنَ القارِ",56,"ر",1,0],["كَأَنَّهُ بَنَفسَجٌ يَميسُ","أَو زَهرٌ في رَوضَةٍ يَنوسُ",57,"س",1,0],["كأَنَّ هِباتِ اللَهِ حينَ تَقَسَّمَت","اتى حظُّهُ بينَ الوَرَى وافرَ القِسمِ",58,"م",1,1],["كأنه بعل لها","من بعده ترملت",59,"ت",1,0],["كَأَنَّهُ بَعدَ ما جَدَّ النَجاءُ بِهِ","سَيفٌ جَلا مَتنَهُ الأَصناعُ مَسلولُ",60,"ل",1,0],["كأنه بحر جود والورود له","ما بين منتضح منه ومغترف",61,"ف",1,0],["كَأَنَّهُ بِسَوَادِ الَّليْلِ مُكْتَحِلٌ","أو رُكَّبَتْ فَوْقَ صُدْغَيهِ مَحاجِرُهُ",62,"ر",2,0],["كأنه بيتُ راعي سُلَّةٍ سَمِقٍ","أو هودجٍ حفَّ بالأنماطِ والنَّجَدِ",63,"د",1,0],["كأنَّهُ بعدَ أنسِهِ توحشَ إذ","رأى ظباءَ الفلاةِ لا تُخالِفُهُ",64,"ه",1,0],["كأنه برد صاغ الهواء له","من ريق القطر أكنانا توقيه",65,"ه",1,0],["كأَنَّهُ بَعدَ قَطعِهِ وقد اصفَ","رَّ لِمَا نَالَ مِن أَذَى حجرِه",66,"ر",2,0],["كان هباتها من غير وعد","نتائج مالهن مقدمات",67,"ت",1,0],["كَأَنَّهُ بُلْبُلٌ فِي الصَّدْرِ مُحْتَجَزٌ","وَحَوْلَهُ يُحْشَدُ الإِغْرَاْءُº وَالطَّرَبُ",68,"ب",1,0],["كأنه بفرات الشعر منهمرا","نهرٌ به الريّ للذّواقة الصادي",69,"د",2,0],["كأنه بسط سندس بهج","قد نثرت فوقه الدنانير",70,"ر",1,0],["كأنه بذلٌ والبداياتُ ذبَّلٌ","وللرمْح عمْرٌ، والمطايا ذلولُ",71,"ل",1,0],["كأنّهُ بلقائي من تشَوِّقهِ","قيسُ الغَرامِ إذا مااشتاقَ ليلاهُ",72,"ا",2,0],["كأنَّهُ بالموتِ يقضي لذّة ً","أو بفراقِ نفسهِ يشقي حنقْ",73,"ق",1,0]]}