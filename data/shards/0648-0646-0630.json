{"poems":[[108,"خليلي","https://www.shoaraa.com/p11134",""],[53,"ترى نوب الأيام ترجي صعابها","https://www.aldiwan.net/poem30759.html","الطويل"],[93,"شجانا نوح شاديها","https://www.aldiwan.net/poem11106.html","مجزوء الوافر"],[70,"أعلمتم أن النسيم إذا سرى","https://www.aldiwan.net/poem42922.html","السريع"],[85,"فتى العقل والنغمة العاليه","https://www.aldiwan.net/poem8108.html","المتقارب"],[43,"أمن ازديارك في الدجى الرقباء","https://www.aldiwan.net/poem9445.html","الكامل"],[52,"وقف الشباب وأنت تابع غيه","https://www.aldiwan.net/poem26593.html","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140863",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142018","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54228","الطويل"],[116,"الى حلب الشهباء ثار بنا الوجد","https://www.aldiwan.net/poem41167.html","عموديه"],[125,"سكر الدهر فقل لي كيف أَصحو","https://www.aldiwan.net/poem23736.html","الرمل"],[133,"آي أطلال الأوداء","https://www.aldiwan.net/poem54896.html","المديد"],[144,"إن العلى المعيي الملوك طلابها","https://www.aldiwan.net/poem11732.html","الكامل"],[271,"إذا غاب جسمي في الثرى رافقي ظلي","https://www.aldiwan.net/poem35631.html","الطويل"],[271,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[343,"شباب العرب بوركتم شبابا","https://www.aldiwan.net/poem55363.html","الوافر"],[453,"عهدي بأيامي على النيربين","https://www.aldiwan.net/poem13897.html","السريع"],[501,"ودار بها قوم كرام ألفتهم","https://www.aldiwan.net/poem37788.html","الطويل"],[541,"سرى ثوبه عنك الصبا المتخايل","https://www.aldiwan.net/poem56720.html","الطويل"],[559,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"]],"verses":[["ونذرٌ علي الدمع في كل مشهدٍ","تمثلت طيفاً ثم خاب تمثلي",0,"ل",2,0],["وَنُذكِرُها الأَشواقَ حَتّى تُحِنَّها","وَتُعدي بِأَطرافِ الحَنينِ رِكابَها",1,"ب",3,0],["وَنَذْكرَ كُل عَارِفَةٍ","لَهَا بِالشُّكْرِ نقْضِيهَا",2,"ي",3,0],["وَنَذَرتُ أَنّي إِن لَقَيتُكَ سالِماً","قَلَّدتُ جيدَ الدَهرِ هَذا الجَوهَرا",3,"ر",2,0],["وَنَذكُرُ تِلكَ اللَيالي بِها","وَنَنشُدُ تِلكَ الرُؤى السارِيَه",4,"ي",2,0],["وَنَذيمُهُم وَبِهِم عَرَفنا فَضلَهُ","وَبِضِدِّها تَتَبَيَّنُ الأَشياءُ",5,"ا",2,0],["وَنَذيرُ ناظِرَتَينِ في أَجفانِها","لَم تَعرِفا عَنَتَ الدُموعِ فَتَمرَها",6,"ه",2,0],["ونذمهم وبهم عرفنا فضله","وبضدها تتبين الأشياء",7,"ا",2,0],["ونذوب مهجتينا","رضي الحب علينا يا حبيبي",8,"ي",1,0],["وَنذكر عيْشاً كالأزاَهِر لم يَطُلْ","وَوُدّاً كَمشْمُولِ الرَّحيقِ الْمُصَفقِ",9,"ق",1,0],["ونذكر للود القديم رقائقا","ويشرف شأن المجد اذ يذكر الود",10,"د",1,0],["ونذرت الصمت لما قيل لي","من يقول الحق يؤذى ويدح",11,"ح",1,0],["ونَذُودَ الزَّيغَ حِينَ عَرَا","بِعَصَا آىٍ وأنبَاءِ",12,"ا",2,0],["وَنَذَرتَني كَرَماً بِمُقلَةِ عالِمٍ","أَنَّ الرِجالَ حُليُّها آدابُها",13,"ب",3,0],["ونذكر أيامَ الصبابةِ والصِّبا","وما بتُّ ألقى في الترحُّلِ والحلِّ",14,"ل",1,0],["ونذكر يوماً أثبت الحقَّ بالرَّدى","ونحفَظُ تبلاً صَيّرَ القلبَ مُجمرا",15,"ر",2,0],["ونذكر ما أرقتم من دماء","جرت حمراً فخضبت الشعابا",16,"ب",2,0],["ونذكر ما فقدتم من نفوس","زكت اصلا وطاولت السحابا",16,"ب",2,0],["ونذكركم وكلكم شجاع","حمي الانف قد ولى وغابا",16,"ب",2,0],["ونذكركم إذا ما سال جرح","ونار القلب تلتهب التهابا",16,"ب",2,0],["ونذكركم وعهد الظلم ثاو","يرجع أنة ساءت مآبا",16,"ب",2,0],["ونذَّكر آثارها بَعْدَ عَيْنْ","وإِنّما اللذاتُ مثلُ الخيالْ",17,"ل",1,0],["ونذكُرُ طَهَ بالوُلوهِ وإنَّنا","عَلَيْهِ نُصلَّي دائِماً ونُسَلِّمُ",18,"م",1,0],["وَنَذكُرُ وُدّا شَدَّهُ اللَهُ بَينَنا","عَلى الدَهرِ لَم تَدبب إِلَيهِ الغَوائِلُ",19,"ل",1,0],["ونذنب سراً وجهراً ولا","نبالي بما فيه زلّ القدم",20,"م",1,0]]}