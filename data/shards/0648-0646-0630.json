{"poems":[[110,"خليلي","https://www.shoaraa.com/p11134",""],[55,"ترى نوب الأيام ترجي صعابها","https://www.aldiwan.net/poem30759.html","الطويل"],[95,"شجانا نوح شاديها","https://www.aldiwan.net/poem11106.html","مجزوء الوافر"],[72,"أعلمتم أن النسيم إذا سرى","https://www.aldiwan.net/poem42922.html","السريع"],[87,"فتى العقل والنغمة العاليه","https://www.aldiwan.net/poem8108.html","المتقارب"],[45,"أمن ازديارك في الدجى الرقباء","https://www.aldiwan.net/poem9445.html","الكامل"],[54,"وقف الشباب وأنت تابع غيه","https://www.aldiwan.net/poem26593.html","الكامل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140863",""],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142018","المديد"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54228","الطويل"],[111,"ألا هل لداعي الله في الأرض سامع","https://www.poetsgate.com/ViewPoem.aspx?id=103",""],[119,"الى حلب الشهباء ثار بنا الوجد","https://www.aldiwan.net/poem41167.html","عموديه"],[128,"سكر الدهر فقل لي كيف أَصحو","https://www.aldiwan.net/poem23736.html","الرمل"],[136,"آي أطلال الأوداء","https://www.aldiwan.net/poem54896.html","المديد"],[147,"إن العلى المعيي الملوك طلابها","https://www.aldiwan.net/poem11732.html","الكامل"],[275,"إذا غاب جسمي في الثرى رافقي ظلي","https://www.aldiwan.net/poem35631.html","الطويل"],[275,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[347,"شباب العرب بوركتم شبابا","https://www.aldiwan.net/poem55363.html","الوافر"],[457,"عهدي بأيامي على النيربين","https://www.aldiwan.net/poem13897.html","السريع"],[505,"ودار بها قوم كرام ألفتهم","https://www.aldiwan.net/poem37788.html","الطويل"],[545,"سرى ثوبه عنك الصبا المتخايل","https://www.aldiwan.net/poem56720.html","الطويل"],[563,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126815","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48795","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48822","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70771","الخفيف"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44789","الكامل"],[1353,"","https://poetry.dctabudhabi.ae/diwan/poem/124302","الوافر"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108833","الكامل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126659","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118416","الوافر"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71065","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137097",""],[2656,"","https://poetry.dctabudhabi.ae/diwan/poem/124602","الكامل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116495","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100425","الوافر"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109812","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87397","الطويل"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112372","الكامل"],[3750,"","https://poetry.dctabudhabi.ae/diwan/poem/126515","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77151","الطويل"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105528","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133201",""],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136379",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139554",""],[4852,"بنت الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=214390",""],[4852,"بنت الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=214585",""],[4858,"ما كلّ برقٍ يصحبُ المطرا","https://www.poetsgate.com/ViewPoem.aspx?id=138316",""],[5055,"رحلة","https://www.poetsgate.com/ViewPoem.aspx?id=103648",""],[5106,"زَاْكِيَاْتٍ كَفَرْحَةِ الأَنْبِيَ","https://www.poetsgate.com/ViewPoem.aspx?id=156840",""],[5324,"بين شك ويقين","https://www.poetsgate.com/ViewPoem.aspx?id=207178",""],[5324,"رثاء والدي (رحمه الله)","https://www.poetsgate.com/ViewPoem.aspx?id=211105",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5376,".قالوا الوغى قد فرَّها فرَّارُها......حلب","https://www.poetsgate.com/ViewPoem.aspx?id=188500",""],[5408,"إحتفالية المقاتل في محراب الشهادة","https://www.poetsgate.com/ViewPoem.aspx?id=190866",""],[5431,"وجهٌ له الأنوارحتما تُشرقُ","https://www.poetsgate.com/ViewPoem.aspx?id=187197",""],[5455,"الحسد","https://www.poetsgate.com/ViewPoem.aspx?id=34430",""],[5493,"بحرُ العبور","https://www.poetsgate.com/ViewPoem.aspx?id=198115",""],[5500,"شرنقة","https://www.poetsgate.com/ViewPoem.aspx?id=190065",""],[5616,"القصاص","https://www.poetsgate.com/ViewPoem.aspx?id=204855",""],[5701,"تعجبت حتى كدت لا أتعجب","https://www.poetsgate.com/ViewPoem.aspx?id=164590",""],[5770,"سأزف للموتى بشارة","https://www.poetsgate.com/ViewPoem.aspx?id=178250",""],[5795,"نصرت دولة المهى التركيه","https://www.poetsgate.com/ViewPoem.aspx?id=167910",""],[5804,"سوريا","https://www.poetsgate.com/ViewPoem.aspx?id=180088",""],[5809,"دموع العين","https://www.poetsgate.com/ViewPoem.aspx?id=205702",""],[5818,"إلى روح البردوني","https://www.poetsgate.com/ViewPoem.aspx?id=181721",""],[5956,"ونذرتُ إن أرزقْ بطفل","https://www.poetsgate.com/ViewPoem.aspx?id=194025",""],[6102,"خرف أنا","https://www.poetsgate.com/ViewPoem.aspx?id=183985",""],[6152,"أحرقت بعد هواكِ كل مراكبي","https://www.poetsgate.com/ViewPoem.aspx?id=213208",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6177,"قلق الحُروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79602&r=&rc=0",""],[6189,"قراءة لعوامل التعرية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83585&r=&rc=52",""]],"verses":[["ونذرٌ علي الدمع في كل مشهدٍ","تمثلت طيفاً ثم خاب تمثلي",0,"ل",2,0],["وَنُذكِرُها الأَشواقَ حَتّى تُحِنَّها","وَتُعدي بِأَطرافِ الحَنينِ رِكابَها",1,"ب",3,0],["وَنَذْكرَ كُل عَارِفَةٍ","لَهَا بِالشُّكْرِ نقْضِيهَا",2,"ي",3,0],["وَنَذَرتُ أَنّي إِن لَقَيتُكَ سالِماً","قَلَّدتُ جيدَ الدَهرِ هَذا الجَوهَرا",3,"ر",2,0],["وَنَذكُرُ تِلكَ اللَيالي بِها","وَنَنشُدُ تِلكَ الرُؤى السارِيَه",4,"ي",2,0],["وَنَذيمُهُم وَبِهِم عَرَفنا فَضلَهُ","وَبِضِدِّها تَتَبَيَّنُ الأَشياءُ",5,"ا",2,0],["وَنَذيرُ ناظِرَتَينِ في أَجفانِها","لَم تَعرِفا عَنَتَ الدُموعِ فَتَمرَها",6,"ه",2,0],["ونذمهم وبهم عرفنا فضله","وبضدها تتبين الأشياء",7,"ا",2,0],["ونذوب مهجتينا","رضي الحب علينا يا حبيبي",8,"ي",1,0],["وَنذكر عيْشاً كالأزاَهِر لم يَطُلْ","وَوُدّاً كَمشْمُولِ الرَّحيقِ الْمُصَفقِ",9,"ق",1,0],["ونذروا وصايا الله في الريح تربة","فليس بها ، استغفر الله، نافع",10,"ع",1,0],["ونذكر للود القديم رقائقا","ويشرف شأن المجد اذ يذكر الود",11,"د",1,0],["ونذرت الصمت لما قيل لي","من يقول الحق يؤذى ويدح",12,"ح",1,0],["ونَذُودَ الزَّيغَ حِينَ عَرَا","بِعَصَا آىٍ وأنبَاءِ",13,"ا",2,0],["وَنَذَرتَني كَرَماً بِمُقلَةِ عالِمٍ","أَنَّ الرِجالَ حُليُّها آدابُها",14,"ب",3,0],["ونذكر أيامَ الصبابةِ والصِّبا","وما بتُّ ألقى في الترحُّلِ والحلِّ",15,"ل",1,0],["ونذكر يوماً أثبت الحقَّ بالرَّدى","ونحفَظُ تبلاً صَيّرَ القلبَ مُجمرا",16,"ر",2,0],["ونذكر ما أرقتم من دماء","جرت حمراً فخضبت الشعابا",17,"ب",2,0],["ونذكر ما فقدتم من نفوس","زكت اصلا وطاولت السحابا",17,"ب",2,0],["ونذكركم وكلكم شجاع","حمي الانف قد ولى وغابا",17,"ب",2,0],["ونذكركم إذا ما سال جرح","ونار القلب تلتهب التهابا",17,"ب",2,0],["ونذكركم وعهد الظلم ثاو","يرجع أنة ساءت مآبا",17,"ب",2,0],["ونذَّكر آثارها بَعْدَ عَيْنْ","وإِنّما اللذاتُ مثلُ الخيالْ",18,"ل",1,0],["ونذكُرُ طَهَ بالوُلوهِ وإنَّنا","عَلَيْهِ نُصلَّي دائِماً ونُسَلِّمُ",19,"م",1,0],["وَنَذكُرُ وُدّا شَدَّهُ اللَهُ بَينَنا","عَلى الدَهرِ لَم تَدبب إِلَيهِ الغَوائِلُ",20,"ل",1,0],["ونذنب سراً وجهراً ولا","نبالي بما فيه زلّ القدم",21,"م",1,0],["ونَذرِفُ الدمعَ حزناً لاِبن فاطمة","منَ القلوبِ دماء لا منَ المُقَلِ",22,"ل",1,0],["ونذير الحرب الجديدة في الأف","ق ومن بالعواقب السود يدري",23,"ر",2,0],["ونذير الدمار والحرب منه","قام في كل جانب فحذار",24,"ر",1,0],["ونُذِعْ بالأخبارِ في كل نادٍ","ونُفَتِّشْ دقيقَها والجليلا",25,"ل",2,0],["وَنُذيبُ في نارِ الجِها","دِ وَحَرِّها عَنّا الصَفائِدْ",26,"د",1,0],["ونذهب تارة لأبي نواس","ونذهب تارة لابن الحسين",27,"ن",1,0],["ونذوق خصب البعد بعد لقائهِ","لا تعجبي ان كان لا",28,"ل",2,0],["ونذوقَ من فيك الشفوقِ مدامةً","تسني حلاوتُها المشوقَ العلقما",29,"م",2,0],["ونذيق أعداء السلا","م شواظ نار حاميه",30,"ي",2,0],["ونذهب تار لابي نراس","ونصعب تارة لابي الحسين",31,"ن",1,0],["ونَذَرتُ أَنْ آتيهم في جحفَل","من يعْرُبٍ كالمُزْبِدِ التّيارِ",32,"ر",1,0],["ونذود عنك بمقول وبمرقم","وكلاهما امضى من التيار",33,"ر",1,0],["ونذل متضعين حيث تكَبّروا","حتى كأنهم هم الامراء",34,"ا",2,0],["ونذكر حزب الله كل مجاهد","ولا سيما في قدير حلو قدرا",35,"ر",2,0],["ونذهب في القريض معاً بطبع","هو الذهب الخليص لناقديه",36,"ي",2,0],["ونذكر اياماً بهم ثم ننثني","نضم بايدينا الحشى والاضالعا",37,"ع",2,0],["وَنذكرُهُ لا قصدَ مدحٍ وانما","لنُطرِبَ أَسماعا بذاك وأَلسُنا",38,"ن",2,0],["ونذكر الجائي على ركبته","وكلما يقال في صورته",39,"ه",1,0],["ونذكر الآن على اتساق","كواكبا تعرف بالشلياق",39,"ق",1,0],["ونذيعَ في الدنيَا البشا","رةِ باكتشافِ الآخرَه",40,"ر",2,0],["ونذكره كي نستضيء بعلمه","وأعظم بما أبقى الامام لنا علما",41,"م",2,0],["وَنَذر الأَماقي وَدَق هاطِل مَزنَة","وَيوشِكُ بَعدَ الدَمعِ أَن يَجري الدَم",42,"م",1,0],["ونذير يتلو لقلب الأعادي","سورة الإنشقاق والانفطار",43,"ر",1,0],["ونذكر الماضي المعهود من قدم","على الوصال على زين المواجيد",44,"د",1,0],["ونذكر من أوصافه وهي كلها","محاسن غر إذ نكل عن الحصر",45,"ر",1,0],["ونذهل عن اُسد الحمام وقد غدت","تدلُّ بأنيابٍ لها ومخالب",46,"ب",1,0],["ونذرُ الأمسِ .. -ياربَّ الوفاءِ- لُقَى","وخيرُ الناسِ مَن يوفونَ بالنذر",47,"ر",1,0],["ونذرُ الصبِّ .. -ياربَّ الوفا- .. لُقَيا","وخيرُ الناسِ مَن يوفونَ بالنذر.",48,"ر",1,0],["ونذوق حلوَ العيش قبل ردىً","يُنهي المسيرةَ مُسكتاً وترا",49,"ر",2,0],["ونذكر ما مضى فيها سعيدٍ أو كدر لزمان","نقول الشعر نتسامر نعني كل معانينا",50,"ن",2,0],["وَنَذَرْتُ عِلَىْ الشِّعَاْبِ جُفُوْنِيْ","وَرَهْنْتُ مُنَىْ الشَّبَاْبِ وَلائِيْ",51,"ا",3,0],["ونذوب حبّا بل نذوب صبابة ..","وبلا اعتراض للهوى نستسلمُ",52,"م",1,0],["ونذيعُ في الأرجاءِ طيبَ مكارمٍ","ونصدّ عمّن يستطيبُ هوانا",53,"ن",2,0],["ونذر واستغاثة مستضام","فباءوا بالوبال وبالنكال",54,"ل",1,0],["ونذودُ عن أحواضِهاوسمائها","سجيلُها أمطارُها وحجارُها",55,"ر",3,0],["ونذوره ائتلقت بدورا في الدجى","وسواك فيها كان بدرا كاسفا",56,"ف",2,0],["ونذوب من وهج الصبابة بينما","نار الهوى تزداد عنفا تُحرقُ",57,"ق",1,0],["ونذر ٍ علي لأعطيه .. وأعطيه .. وأعطيه","حتى يملّ من الشعر والصحافه",58,"ف",2,0],["ونذرفُ دمعة لتجفَّ أخرى","وندفنُ صوتَنا بين الصخور",59,"ر",1,0],["ونذرت صوما يا قصيدة فاشهدي","أني جمعت القلب ذات تفرقا",60,"ق",2,0],["ونذودُ بالأشعارِ عن وطنٍ","بينَ الذئابِ كأنَّهُ الحمَلُ",61,"ل",1,0],["ونذكرهم بالخير كي يولعوا به","نهذبهم والشعر نعم المهذب",62,"ب",1,0],["ونذرت عُمريَ كي أراه وكي أعلق فيه شارة","ولقد هرمتُ وفرحتي الكبرى بأن أدركتُ ثارهْ",63,"ر",2,0],["ونذوق الغرام عذباً وإن كا","ن عذاباً لدى النفوس الأبيه",64,"ي",2,0],["ونذلٍ لا تراهُ على وقارٍ","ولكنْ لمزُهُ لمزٌ عجيبُ",65,"ب",1,0],["ونذكرُ ربَّنا ونقول حمداً","لكم يارب إذ عَظُمَ البلاءُ",66,"ا",2,0],["ونذوي ونعوي كما قلتَ يومًا","ونصهلُ نصهلُ لا ك الصهيلْ",67,"ل",1,0],["ونذرتُ إن أرزقْ بطفلٍ أدْعُهُ","تركي ليملأ صيتُه الآفاقا",68,"ق",2,1],["وَ نَذَرْتُ أَنِّي لَو أَطُوفُ بِرِعْشَتِي","- حَولَ اضْطِرَامِ الكَرْزِ - أَنْ أَتَلَفَّحا",69,"ح",2,0],["ونذرتُ أن أبقى لقلبكِ روضة","تتنعمين برقتي وحناني",70,"ي",1,0],["ونذكر فظايعهم ونخسي شوارنا","يوم أَن بقينا في الجبل عدوان",71,"ن",1,0],["وَنذكر فظائعهم عَلى الغيظ وَالرضى","كَما يذكر الشعار عنا بخالها",72,"ل",3,0],["ونذوبُ حتى نستعيد صفاءنا","باليعربية رايةً لا تُثلَمُ",73,"م",1,0],["ونذوب في عينيك نفح قصيدة","عربيةٍ ومن المدامع نشرب",74,"ب",1,0],["ونُذيب فيك حناجراً ذهبية","فإلى متى نجني عليك ونكذب",74,"ب",1,0]]}