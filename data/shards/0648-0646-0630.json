{"poems":[[110,"خليلي","https://www.shoaraa.com/p11134",""],[55,"ترى نوب الأيام ترجي صعابها","https://www.aldiwan.net/poem30759.html","الطويل"],[95,"شجانا نوح شاديها","https://www.aldiwan.net/poem11106.html","مجزوء الوافر"],[72,"أعلمتم أن النسيم إذا سرى","https://www.aldiwan.net/poem42922.html","السريع"],[87,"فتى العقل والنغمة العاليه","https://www.aldiwan.net/poem8108.html","المتقارب"],[45,"أمن ازديارك في الدجى الرقباء","https://www.aldiwan.net/poem9445.html","الكامل"],[54,"وقف الشباب وأنت تابع غيه","https://www.aldiwan.net/poem26593.html","الكامل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140863",""],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142018","المديد"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54228","الطويل"],[111,"ألا هل لداعي الله في الأرض سامع","https://www.poetsgate.com/ViewPoem.aspx?id=103",""],[119,"الى حلب الشهباء ثار بنا الوجد","https://www.aldiwan.net/poem41167.html","عموديه"],[128,"سكر الدهر فقل لي كيف أَصحو","https://www.aldiwan.net/poem23736.html","الرمل"],[136,"آي أطلال الأوداء","https://www.aldiwan.net/poem54896.html","المديد"],[147,"إن العلى المعيي الملوك طلابها","https://www.aldiwan.net/poem11732.html","الكامل"],[274,"إذا غاب جسمي في الثرى رافقي ظلي","https://www.aldiwan.net/poem35631.html","الطويل"],[274,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[346,"شباب العرب بوركتم شبابا","https://www.aldiwan.net/poem55363.html","الوافر"],[455,"عهدي بأيامي على النيربين","https://www.aldiwan.net/poem13897.html","السريع"],[503,"ودار بها قوم كرام ألفتهم","https://www.aldiwan.net/poem37788.html","الطويل"],[543,"سرى ثوبه عنك الصبا المتخايل","https://www.aldiwan.net/poem56720.html","الطويل"],[561,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"]],"verses":[["ونذرٌ علي الدمع في كل مشهدٍ","تمثلت طيفاً ثم خاب تمثلي",0,"ل",2,0],["وَنُذكِرُها الأَشواقَ حَتّى تُحِنَّها","وَتُعدي بِأَطرافِ الحَنينِ رِكابَها",1,"ب",3,0],["وَنَذْكرَ كُل عَارِفَةٍ","لَهَا بِالشُّكْرِ نقْضِيهَا",2,"ي",3,0],["وَنَذَرتُ أَنّي إِن لَقَيتُكَ سالِماً","قَلَّدتُ جيدَ الدَهرِ هَذا الجَوهَرا",3,"ر",2,0],["وَنَذكُرُ تِلكَ اللَيالي بِها","وَنَنشُدُ تِلكَ الرُؤى السارِيَه",4,"ي",2,0],["وَنَذيمُهُم وَبِهِم عَرَفنا فَضلَهُ","وَبِضِدِّها تَتَبَيَّنُ الأَشياءُ",5,"ا",2,0],["وَنَذيرُ ناظِرَتَينِ في أَجفانِها","لَم تَعرِفا عَنَتَ الدُموعِ فَتَمرَها",6,"ه",2,0],["ونذمهم وبهم عرفنا فضله","وبضدها تتبين الأشياء",7,"ا",2,0],["ونذوب مهجتينا","رضي الحب علينا يا حبيبي",8,"ي",1,0],["وَنذكر عيْشاً كالأزاَهِر لم يَطُلْ","وَوُدّاً كَمشْمُولِ الرَّحيقِ الْمُصَفقِ",9,"ق",1,0],["ونذروا وصايا الله في الريح تربة","فليس بها ، استغفر الله، نافع",10,"ع",1,0],["ونذكر للود القديم رقائقا","ويشرف شأن المجد اذ يذكر الود",11,"د",1,0],["ونذرت الصمت لما قيل لي","من يقول الحق يؤذى ويدح",12,"ح",1,0],["ونَذُودَ الزَّيغَ حِينَ عَرَا","بِعَصَا آىٍ وأنبَاءِ",13,"ا",2,0],["وَنَذَرتَني كَرَماً بِمُقلَةِ عالِمٍ","أَنَّ الرِجالَ حُليُّها آدابُها",14,"ب",3,0],["ونذكر أيامَ الصبابةِ والصِّبا","وما بتُّ ألقى في الترحُّلِ والحلِّ",15,"ل",1,0],["ونذكر يوماً أثبت الحقَّ بالرَّدى","ونحفَظُ تبلاً صَيّرَ القلبَ مُجمرا",16,"ر",2,0],["ونذكر ما أرقتم من دماء","جرت حمراً فخضبت الشعابا",17,"ب",2,0],["ونذكر ما فقدتم من نفوس","زكت اصلا وطاولت السحابا",17,"ب",2,0],["ونذكركم وكلكم شجاع","حمي الانف قد ولى وغابا",17,"ب",2,0],["ونذكركم إذا ما سال جرح","ونار القلب تلتهب التهابا",17,"ب",2,0],["ونذكركم وعهد الظلم ثاو","يرجع أنة ساءت مآبا",17,"ب",2,0],["ونذَّكر آثارها بَعْدَ عَيْنْ","وإِنّما اللذاتُ مثلُ الخيالْ",18,"ل",1,0],["ونذكُرُ طَهَ بالوُلوهِ وإنَّنا","عَلَيْهِ نُصلَّي دائِماً ونُسَلِّمُ",19,"م",1,0],["وَنَذكُرُ وُدّا شَدَّهُ اللَهُ بَينَنا","عَلى الدَهرِ لَم تَدبب إِلَيهِ الغَوائِلُ",20,"ل",1,0],["ونذنب سراً وجهراً ولا","نبالي بما فيه زلّ القدم",21,"م",1,0]]}