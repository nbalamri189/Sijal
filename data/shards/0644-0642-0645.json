{"poems":[[88,"يا يوم تكريم حفني","https://www.aldiwan.net/poem68862.html","المجتث"],[88,"ملكتم علي عنان الخطب","https://www.aldiwan.net/poem68863.html","المتقارب"],[46,"إن بكاء في الدار من أربه","https://www.aldiwan.net/poem30574.html","المنسرح"],[107,"كم دون مية من عين أحاذرها","https://www.aldiwan.net/poem43153.html","البسيط"],[147,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[160,"أيئست من أسماء أم لم تيأس","https://www.aldiwan.net/poem423.html",""],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119254","الخفيف"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106705","الكامل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26187","السريع"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140291",""],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95328","الرجز"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35079","الطويل"],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[327,"آذَنَ اليومَ جِيرتي بارتحالِ","https://www.poetsgate.com/ViewPoem.aspx?id=3928",""],[5725,"الى نينوى","https://www.poetsgate.com/ViewPoem.aspx?id=203639",""],[5739,"مصنع عبير..!","https://www.poetsgate.com/ViewPoem.aspx?id=135076",""],[5794,"مهد حمرين","https://www.poetsgate.com/ViewPoem.aspx?id=80289",""]],"verses":[["لَقُمتُ في يَومِ حِفني","أَدعو لِسَكرَةِ يَنّي",0,"ن",2,0],["لَقُمتُ بِشُكرِكَ حَقَّ القِيامِ","وَلَكِن طَلَبتُ فَعَزَّ الطَلَب",1,"ب",1,0],["لُقمانُ صَمتاً وَحِكمَةً فَإِذا","قالَ لَقَطنا المُرجانَ مِن خُطَبِه",2,"ب",2,0],["لَقُمتَ فينا بِأَمرِ اللَهِ مُرتَقِباً","تَرُدُّ عَنّا العِدى مِن كُلِّ مُرتَقِبِ",3,"ب",1,0],["لَقَمٌ جُبتَهُ بِغَيرِ دَليلٍ","وَهوَ خافي المَجازِ ضَنكُ المَجالِ",4,"ل",1,0],["لُقمانُ مُنتَصِراً وَقُسٌّ ناطِقاً","وَلَأَنتَ أَجرأُ صَولَةً مِن بَيهَسِ",5,"س",1,0],["لقم لسلس لجين لبان","لؤلؤ لهذم لهيم لواء",6,"ا",2,0],["لَقَمَت موارِجَ من جحيمٍ فاغتَدَت","للرُّومِ ترجُمُهُم بِشُهبٍ سُطَّعِ",7,"ع",1,0],["لُقمَتُهُ قيمَتُها وَحدَها","مِن غَيرِ خُلفٍ أَلفَ دينارِ",8,"ر",1,0],["لقمنا عند ذلك باجتهاد","وصرنا بالعواذل ما نبالي",9,"ل",2,0],["لَقِمته ومثله جرعته","مسِسته ومثله شَمِمته",10,"ه",1,0],["لَقُمتُ لَهُ ما بَينَ أَعلامِ رَيَّةٍ","وَبَينَ حِمى وادي الأَشاءِ مِنَ التُربِ",11,"ب",1,0],["لقمان أوتي حكمة لم يؤتها","إلا أخو الناموس في برهانه",12,"ن",2,0],["لقِ مِنْ ذُعْرِ هَيْقة ٍ مِجْفالِ","أو كجأبٍ مكدمٍ أخدري",13,"ي",1,0],["لقموه حوتا مثلهم شرهاً","فنفوه قسراً مذ سبوا اهلهْ",14,"ل",2,0],["لقمة هنا ماني لها اليوم وضّاح.","اخاف سهم ابليس يطعن فتوني.",15,"ن",2,0],["لقمه توزعها كفوف .. الشياطين","وتشب بين ضلوعنا من حطبنا",16,"ن",2,0]]}