{"poems":[[86,"يا يوم تكريم حفني","https://www.aldiwan.net/poem68862.html","المجتث"],[86,"ملكتم علي عنان الخطب","https://www.aldiwan.net/poem68863.html","المتقارب"],[44,"إن بكاء في الدار من أربه","https://www.aldiwan.net/poem30574.html","المنسرح"],[105,"كم دون مية من عين أحاذرها","https://www.aldiwan.net/poem43153.html","البسيط"],[141,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[154,"أيئست من أسماء أم لم تيأس","https://www.aldiwan.net/poem423.html",""]],"verses":[["لَقُمتُ في يَومِ حِفني","أَدعو لِسَكرَةِ يَنّي",0,"ي",1,0],["لَقُمتُ بِشُكرِكَ حَقَّ القِيامِ","وَلَكِن طَلَبتُ فَعَزَّ الطَلَب",1,"ب",1,0],["لُقمانُ صَمتاً وَحِكمَةً فَإِذا","قالَ لَقَطنا المُرجانَ مِن خُطَبِه",2,"ب",2,0],["لَقُمتَ فينا بِأَمرِ اللَهِ مُرتَقِباً","تَرُدُّ عَنّا العِدى مِن كُلِّ مُرتَقِبِ",3,"ب",1,0],["لَقَمٌ جُبتَهُ بِغَيرِ دَليلٍ","وَهوَ خافي المَجازِ ضَنكُ المَجالِ",4,"ل",1,0],["لُقمانُ مُنتَصِراً وَقُسٌّ ناطِقاً","وَلَأَنتَ أَجرأُ صَولَةً مِن بَيهَسِ",5,"س",1,0]]}