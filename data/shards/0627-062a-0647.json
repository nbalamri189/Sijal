udhabi.ae/diwan/poem/94657","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73418","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136602",""],[4473,"","https://poetry.dctabudhabi.ae/diwan/poem/130602","الوافر"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33785","البسيط"],[4665,"","https://poetry.dctabudhabi.ae/diwan/poem/97742","الكامل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204304",""],[4691,"شكايات في كفها","https://www.poetsgate.com/ViewPoem.aspx?id=104332",""],[4727,"نسيبٌ وهجاءْ","https://www.poetsgate.com/ViewPoem.aspx?id=211408",""],[4859,"نواة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=186895",""],[4884,"أرى الظّلمَ كالدّجّالِ أعورَ","https://www.poetsgate.com/ViewPoem.aspx?id=201727",""],[4988,"مدرسة دنياي","https://www.poetsgate.com/ViewPoem.aspx?id=214087",""],[5137,"مدمنها","https://www.poetsgate.com/ViewPoem.aspx?id=101146",""],[5156,"أتهجروني لتعريفي بكم تيهاً","https://www.poetsgate.com/ViewPoem.aspx?id=99210",""],[5189,"أتهوى اللهوَ والبذخَا","https://www.poetsgate.com/ViewPoem.aspx?id=211152",""],[5376,"ما عابني في الهوى قولٌ بنائحة","https://www.poetsgate.com/ViewPoem.aspx?id=188546",""],[5425,"شَفَتِي الغَلِيْلُ وَثَغْرُكِ المُتَبَرَّضُ","https://www.poetsgate.com/ViewPoem.aspx?id=207511",""],[5431,"على مذبح الطغيان سالت دماؤنا","https://www.poetsgate.com/ViewPoem.aspx?id=190282",""],[5431,"طوفان عروبي...","https://www.poetsgate.com/ViewPoem.aspx?id=215568",""],[5587,"هيا نتسامح","https://www.poetsgate.com/ViewPoem.aspx?id=194341",""],[5616,"القصاص","https://www.poetsgate.com/ViewPoem.aspx?id=204855",""],[5725,"اتصبوا في غرامك","https://www.poetsgate.com/ViewPoem.aspx?id=178278",""],[5756,"الثريا","https://www.poetsgate.com/ViewPoem.aspx?id=5417",""],[5847,"طار قلبي عندما..","https://www.poetsgate.com/ViewPoem.aspx?id=53723",""],[6093,"الحب مثل رواية غربية","https://www.poetsgate.com/ViewPoem.aspx?id=194332",""],[6093,"أتهجأ البسمات","https://www.poetsgate.com/ViewPoem.aspx?id=194335",""],[5309,"أتهذي وتغرينا طيوف المحاسن","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573844",""],[6174,"لا أريدُ اعتذاراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86186&r=&rc=3",""],[6262,"الرجفةُ تبدأُ من يدِها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80104&r=&rc=2",""],[6277,"توبة عن التوبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64442&r=&rc=1",""],[6343,"فاكهة الكلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86039&r=&rc=10",""]],"verses":[["أتهمت يا قلب رشداً لا يعي أرباً","فلست أدري علامَ أنت مصطلم",0,"م",1,0],["أَتَهويمَةً في ظِلِّ أَمنٍ وَغِبطَةٍ","وَعَيشٍ كَنُّوارِ الخَميلَةِ ناعِمِ",1,"م",1,0],["أتَهْجُرُ مَن غادَرْتَ بينَ ضُلوعِهِ","جَوًى يتلظّى مثلَما يَقِدُ الجَمْرُ",2,"ر",1,0],["أَتَهزَأُ بِالدُعاءِ وَتَزدَريهِ","وَما تَدري بِما صَنَعَ الدُّعاءُ",3,"ا",2,1],["أَتَهجُرُ غانِيَةً أَم تُلِم","أَمِ الحَبلُ واهٍ بِها مُنجَذِم",4,"م",1,1],["أَتَهجُرُني وَتَغصِبُني كِتابي","وَما في الحَقِّ غَصبي وَاجتِنابي",5,"ب",2,1],["أَتَهوى مَن دَعاكَ لِطولِ شَجوٍ","وَمَن أَضنى فُؤادَكَ إِذ دَعاكا",6,"ك",2,0],["أَتَهجونَ يَربوعاً وَأَترُكُ دارِماً","تَهَدَّمَ أَعلى جَفرِكُم وَأَسافِلُه",7,"ل",2,0],["أَتَهجوهُ وَلَستَ لَهُ بِكُفءٍ","فَشَرُّكُما لِخَيرِكُما الفِداءُ",8,"ا",2,0],["أتهتك ستريَ عن خَلَّتي","وتُغلق دون عطاياك بابا",9,"ب",2,0],["أتهدي لك الأيام غوْلاً وإنما","مساعيك في أعناقهن قلائدُ",10,"د",1,0],["أتهلعُ وحشةً لفراقِ إلفٍ","وقد وطنتُها لحلول رَمْس",11,"س",1,0],["أتهتزُّ في ورقٍ ناضرٍ","وليس لعبدِكَ في ذاك ظِلُّ",12,"ل",1,0],["أتهجرني والحبلُ في خير معقدٍ","وتحنو وتدنو عند مضطرب الحبلِ",13,"ل",1,0],["أَتَهزَأُ مِنّي أَن سَمِنتَ وَأَن تَرى","بِوَجهي شُحوبَ الحَقِّ وَالحَقُّ جاهِدُ",14,"د",1,0],["أَتَهجُرُ هَذا الرَبعَ أَم أَنتَ زائِرُه","وَكَيفَ يُزارُ الرَبعُ قَد بانَ عامِرُه",15,"ه",1,1],["أَتَهدِمُ جُرفَيها وَطَودُكَ طَودُها","وَتَنحِتُ فَرعَيها وَعودُكَ عودُها",16,"د",3,0],["أَتَهجو بِالأَقارِعِ وَاِبنِ لَيلى","وَصَعصَعَةَ الَّذي غَمَرَ البِحارا",17,"ر",2,0],["أَتَهجُرُني وَما أَسلَفتُ ذَنباً","وَيَظهَرُ مِنكَ زَورٌ وَازوِرارُ",18,"ر",1,1],["أَتَهجُرُني وَتَحفَظُ عَهدَ غَيري","وَهَل لِلمَوتِ عُذرٌ بَعدَ دَينِ",19,"ن",1,0],["أَتْهَمُونِي فِي مَوَدَّتِهِ","وَالْهَوَى مِنْ شَأْنِهِ التُّهَمُ",20,"م",1,0],["أتهزأُ بي لمَّا أجدُّ وتلعبُ","وتعجبُ مِنْ حالي وحالُكَ أَعْجبُ",21,"ب",1,1],["أَتَهجُرُ بَيتاً لِلحَبيبِ تَعَلَّقَت","بِهِ الحِبُّ وَالأَعداءُ أَم أَنتَ زائِرُه",22,"ر",2,0],["أَتُهانُ مصرُ ونحن حول لوائها","الموتُ أكرمُ والقبورُ فِساحُ",23,"ح",1,0],["أَتَهدِمُ طولَ يَومِكَ ما بَنَتهُ","يَداكَ مِنَ المَعاقِلِ طولَ أَمسِكْ",24,"ك",1,0],["أَتَهيجُهُم طَشيوزُ وَهيَ سَحابَةً","تَمضي كَما يَمضي السَحابُ الجُونُ",25,"ن",1,0],["أَتَهجوا مَن رَوى جَزَعاً وَلُؤماً","كَساقي اللَيلِ مِن كَدَرٍ وَصافي",26,"ف",2,0],["أَتَهِدُّ الإِنجيلَ في يَومِ كَنسٍ","بَعدَ حِفظِ الأَسباعِ وَالأَخماسِ",27,"س",1,0],["أتهدأ وهي في الغمرات تأسو","جريحاً أو تشدُّ له ضِمامهْ",28,"م",2,0],["أتهتف بي أنتَ أم هُنَّ أمْ","نذيرُ الردى والقضاءُ المتاحْ",29,"ح",1,0],["أَتَهجونَ يَربوعاً وَقَد رَدَّ سَيبَكُم","فَوارِسُهُم وَالبيضُ يُلوينَ بِالخُمرِ",30,"ر",1,0],["أَتُهيِّيءُ اسْتِقْلاَل قَوْمِكَ جَاهِداً","وَتُذَادُ عنْهُم يَوْمَ الاِستِقْلالِ",31,"ل",1,0],["أَتَهَادَتِ الأَهْرَامُ وَهْيَ طَرُوبَةٌ","لِمَديحِهِ تَهْتَزُّ كَالأَفْيَاءِ",32,"ا",2,0],["أَتهَمتُهُ فَوَرَبّي","لَولا التُقى لَأَقَدتُه",33,"ت",2,0],["أتُهْدِي لِيَ الْفَحْشَا وأنْتَ..","مَطِيَّة ُ كِنْدِيرٍ تَرُوحُ وَتُبْكِرُ",34,"ر",1,0],["أَتةكَ يُزْجِيهُمُ للحَينِ جاهِلهُمْ","مُستَقْدِماً بِهمُ للبَغْيِ مُزْدَلِقَا",35,"ق",2,0],["أتهدِّدينَ بحبِّك الثاني..","وزندٍ غير زندي؟",36,"د",2,0],["أَتهذي بالسلو وقد","غرام الغيد أَضنانا",37,"ن",2,0],["أَتَهْجُرُ مَنْ لَيْسَ يَهْوى سِواكَ","وَيَهْوى هَواكَ وَتَهْوى جَفَاهْ",38,"ا",2,0],["أتهلكني من غير ذنبٍ وزلَّةٍ","فماذا بقتلي يا حبيب تريدُ",39,"د",1,0],["أَتُهدي لي الوَعيدَ عَلى التَنائي","وَما مِثلي يُخَوَّفُ بِالقَوافي",40,"ف",2,0],["أَتُهدي الهِجاءَ لِامرِىءٍ غَيرِ مُفحَمٍ","وَتُهدي الوَعيدَ لِامرِىءٍ غَيرِ موعَدِ",41,"د",1,0],["أتهجر بيتي أنت آهاً ولوعة","لأنك في القلب المتيّم أشغالي",42,"ي",1,0],["أُتهمتَ زوراً بالقباحةِ والأذى","واغتابكَ الدوريشُ والقسيس",43,"س",1,0],["أتْهِمْ وَأنْجِدْ يَا نَجِيبُ فَقَد قَضَى","نَحْباً أَخُو الإنْجَادِ وَالإتهامِ",44,"م",1,0],["أتْهَمَ بِي في الهَوَى وأَنْجَدْ","مُهَفهَفُ الخَصْرِ أَهْيف القَد",45,"د",1,1],["أتُهادِنُ الأعداءَ تَطلُبُ سِلْمَهُمْ","خَطْباً لعَمرُك لو عَلِمتَ جليلا",46,"ل",2,0],["أتهدمُ ما شيّدتَ من بعض توبة","تخفِّف من ذنب عليك مثقَّل",47,"ل",1,0],["أتهجر قول اللّه فيما أتيته","وتؤثر قول الشاعر المتقادم",48,"م",1,0],["أتهوى الرياض وأزهارها","وعندي من الروض ما لا يعد",49,"د",1,0],["أتْهَم فيكُم لائمي وأنْجَدا","وما أفادَ سلوةً إذْ فنّدَا",50,"د",2,1],["أتهملون الآلى قد مهدوا زمنا","لنصركم وتعزون الألى هانوا",51,"ن",3,0],["أتهدر فيك سالفة القوافي","وختمي بالمحامد وافتتاحي",52,"ح",2,0],["أتهويماً وليلُ الهمّ داجي","فهاتِ من السّلاف سنا سراج",53,"ج",1,1],["أَتَهجُرُ بَيتاً بِالحِجازِ تَلَعَّبَت","بِهِ الحَربُ وَالأَعداءُ أَم أَنتَ زائِرُه",54,"ر",2,0],["أتهاجم الآساد في آجامها","وعرينها بليوثه مأهول",55,"ل",1,0],["أتهجر من تحب وأنت جار","وتطلبهم وقد بعد المزار",56,"ر",1,1],["أَتَهجُرُ أَم لا اليَومَ مَن أَنتَ عاشَقُهْ","وَمَن أَنتَ مُشتاقٌ إِلَيهِ وَشائِقُهْ",57,"ق",2,1],["أتَهجُرُني لَيلى ولَيلَى وَذُو الهَوى","مُراهِقَةُ الإعصارِ وَهوَ مُراهِقُ",58,"ق",1,0],["أتهجعون وهم أسرى وجدهم","لعمه ليل بدر قط ما هجعا",59,"ع",2,0],["اتهمتِ قلبي يا ظلوم بوصمةٍ","لا زال عنها ما حييتُ بعيدا",60,"د",2,0],["أتهوينهُ يا من ملكتِ عنانهُ","ولوعاً ولا تنوينَ تفريج كربهِ",61,"ب",2,0],["أتهربُ معْ فرسي يا خَبيثُ؟","أراحَني الله من شَرِّكا",62,"ك",2,1],["أتهجرني قصداً وتسأل لم أبكي","كأنك من هجري وحبي في شك",63,"ك",1,1],["أتهزأ مني أن سمنت وقد ترى","بجسمي مس الحق والحق جاهد",64,"د",1,0],["أتهمُّ بالأعباء عنهم ثم لا","يرضيهمُ إلا الخمول المقعد",65,"د",1,0],["أتهز يوماً عرشك العالي يد","وله قلوب المخلصين دعائم",66,"م",1,0],["أتهزوا بني البيوت قناةً","فلطعن حمل القنا الأملود",67,"د",1,0],["أَتَهجُرُ لَيلى بِالعِراقِ حَبيبَها","وَما كانَ نَفساً بِالفِراقِ تَطيبُ",68,"ب",1,1],["أتهمَ البرقُ وأنجدْ","والهوى جاش وأنجدْ",69,"د",1,1],["أَتُهْتَك حُرمَة آل النبي","وفي الأرض منكم صَبي صَغِير",70,"ر",1,0],["أتُهدي من بنات الفكر ما قد","تقول بحُسنها للشمسِ غيبي",71,"ب",2,0],["أتهجرُها صرفاً لأجلِ خُمارِها","وذلكَ شيءٌ لو جرى غيرُ ضائرِ",72,"ر",1,1],["أتهادى بين الغصون فتنآ","د وتغضي نواظر الأزهار",73,"ر",1,0],["اتهجوا أشرف العربين آلاً","وتمدح أخبث العربين آلا",74,"ل",2,0],["إتّهموه بالحبِّ وهو يتيمٌ","أَعجميٌّ يقولُ بابا وماما",75,"م",2,0],["أَتهدَم أبياتي ومثلك جارها","وتكتب يا ليلى ولا أحدٌ يقرا",76,"ر",2,0],["أَتَهجُرُ بَيْتاً بالحجازِ تَكَنَّفَتْ","جَوَانِبَهُ الأعْداءُ أَمْ أَنْتَ زَائِرهْ",77,"ر",2,0],["أتهجرنى ومالى عنك صبر","رعاك الله جد لو بالسلام",78,"م",1,0],["أَتهدم دار العلم في حانك الَّذي","تَبيت وَتضحى فيه وَيحك سكرانا",79,"ن",2,0],["أَتَهِيمُ بِساكِنَةِ البُرقِ","فَيَعُودَ فُؤادُكَ ذا عَلَقِ",80,"ق",1,1],["أتهتك الخدور من هاشم","ولا يهز الهاشمين الإبا",81,"ب",2,0],["أَتَهجُرُ نُعماً أَم تُديمُ لَها وَصلا","وَكَم صَرَمَت نُعمٌ لِذي خُلَّةٍ حَبلا",82,"ل",2,1],["أَتَهجُر جُملاً أَم تُلِمُّ عَلى جُمل","وَجُملٌ عيوفُ الرِّيقِ جاذِبَةُ الوَصلِ",83,"ل",1,0],["أَتَهجُرُ لَيلى لِلفِراقِ حَبيبُها","وَما كانَ نَفساً بِالفِراقِ تَطيبُ",84,"ب",1,1],["أَتَهزَأُ مِنّي أُمُّ عَمرَةَ أَن رَأَت","نَهاراً وَلَيلاً بَلَّياني فَأَسرَعا",85,"ع",2,1],["أتهدر معرضاً وأعض عضاً","وما يغني مع العض الهدير",86,"ر",1,0],["أَتَهوى خُنفَساء كَأَن زِفتاً","كَسا جلداً لَها وَهوَ السَوادُ",87,"د",1,0],["أَتهجُرُ لَيلَى لا ولا نِعمَةُ الهَجرِ","وما لكَ عن لَيلى المَليحَةِ من صَبرِ",88,"ر",1,1],["أتهجر صباً فيك أسقمه الجوى","وتكسر قلباً غير حبك ما هوى",89,"ا",1,1],["أتهجرني والهجرُ لا شكَّ قاتِلي","وتُغري بيَ الأعداء وتُرضي عواذلي",90,"ي",1,1],["أتهجرني كذا من غير ذنبٍ","وتُعرض والهوى يَسْطو بعَضْبِ",91,"ب",1,1],["أتهجُو أبا بكرٍ وتخلع بعْدَه","عليّاً وتعْزو كلَّ ذاك إلى بُرْدِ",92,"د",1,0],["أتّهم النطق بالجُمود وَما","جفّ بأعلى يراعتي النقسُ",93,"س",1,0],["أتَهْوي الدّواهي حولَهُ وهو سالِمٌ","لقد نامَ عنها الدهرُ نومةَ غافِلِ",94,"ل",1,0],["أتهجر صبّاً أسقمه الهوى","وتكسر قلباً غير حبّك ما هوى",95,"ا",1,1],["أتهجوه لما راح يطلب 