{"poems":[[110,"حتام يا قلب","https://www.shoaraa.com/p11133",""],[65,"مزجنا دماء بالدموع السواجم","https://www.aldiwan.net/poem45816.html","الطويل"],[65,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[59,"أتهزأ بالدعاء وتزدريه","https://www.aldiwan.net/poem24736.html","الوافر"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[75,"أتهجرني وتغصبني كتابي","https://www.aldiwan.net/poem11903.html","الوافر"],[29,"ألا تصحو وتقصر عن صباكا","https://www.aldiwan.net/poem5946.html","الوافر"],[29,"ألم تر أن الجهل أقصر باطله","https://www.aldiwan.net/poem5976.html","الطويل"],[23,"عفت ذات الأصابع فالجواء","https://www.aldiwan.net/poem21233.html","الوافر"],[53,"أبا الصقر لست أرى مهديا","https://www.aldiwan.net/poem8301.html","المتقارب"],[53,"تجافت بنا منذ اشتكيت المراقد","https://www.aldiwan.net/poem61885.html","الطويل"],[53,"ترحل من هويت وكل شمس","https://www.aldiwan.net/poem64565.html","الوافر"],[53,"أيا من له الشرف المستقل","https://www.aldiwan.net/poem65882.html","المتقارب"],[53,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[14,"إني امرؤ عافي إنائي شركة","https://www.aldiwan.net/poem38307.html","الطويل"],[34,"أتهجر هذا الربع أم أنت زائره","https://www.aldiwan.net/poem27745.html","الطويل"],[47,"لدارك يا ليلى سماء تجودها","https://www.aldiwan.net/poem63478.html","الطويل"],[30,"تلوم على هجاء بني كليب","https://www.aldiwan.net/poem5239.html","الوافر"],[68,"أتهجرني وما أسلفت ذنبا","https://www.aldiwan.net/poem38756.html","الوافر"],[68,"أذاب التبر في كأس اللجين","https://www.aldiwan.net/poem40114.html","الوافر"],[89,"دع حبيب القلب يا سقم","https://www.aldiwan.net/poem8281.html","المديد"],[71,"أتهزأ بي لما أجد وتلعب","https://www.aldiwan.net/poem28601.html","الطويل"],[35,"بنفسي من لا بد لي أن أهاجره","https://www.aldiwan.net/poem25922.html","الطويل"],[107,"قل ما أردت فما عليك جناح","https://www.aldiwan.net/poem42081.html","الكامل"],[107,"أبا شادي وكنت لنا حليفا","https://www.aldiwan.net/poem43069.html","الوافر"],[107,"سر فالسعادة حيث كنت تكون","https://www.aldiwan.net/poem43406.html","الكامل"],[41,"أهاجك بالملا دمن عوافي","https://www.aldiwan.net/poem53768.html","الوافر"],[48,"أم دفر جزيت شرا فديا","https://www.aldiwan.net/poem22852.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[29,"","https://poetry.dctabudhabi.ae/diwan/poem/1691","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43667","المجتث"],[52,"صَحَا الْقَلْبُ عَنْ سَلْمَى وَشَابَ الْمُعَذَّرُ","https://www.poetsgate.com/ViewPoem.aspx?id=22676",""],[47,"اسْتَوقِفا الرَّكبَ في أَطْلالِهم، وقِفا","https://www.poetsgate.com/ViewPoem.aspx?id=32848",""],[101,"إمرأة من زجاج","https://www.poetsgate.com/ViewPoem.aspx?id=16897",""],[127,"وهمت فليس ما سمي","https://www.aldiwan.net/poem23710.html","الهزج"],[158,"أيا من يرى أن حبي له","https://www.aldiwan.net/poem55499.html","المتقارب"],[207,"مزاري قريب والوصال بعيد","https://www.aldiwan.net/poem53338.html","الطويل"],[210,"ألا من مبلغ عني خفافا","https://www.aldiwan.net/poem27929.html","الوافر"],[210,"ألا أبلغا عمرا على نأي داره","https://www.aldiwan.net/poem27970.html","الطويل"],[214,"أتخطر في بالي خطرت فليتني","https://www.aldiwan.net/poem46622.html","الطويل"],[273,"مني السلام عليك يا إبليس","https://www.aldiwan.net/poem35266.html","الكامل"],[278,"بيني ثلاثا سلوة الأيام","https://www.aldiwan.net/poem25529.html","الكامل"],[278,"أتهم بي في الهوى وأنجد","https://www.aldiwan.net/poem25576.html","مخلع البسيط"],[367,"قسما لقد رجع النسيم عليلا","https://www.aldiwan.net/poem60803.html","الكامل"],[372,"رأيتك سعد الدين أكرم منتم","https://www.aldiwan.net/poem4299.html","الطويل"],[406,"أمثلك يرضى بارتكاب العظائم","https://www.aldiwan.net/poem33427.html","الطويل"],[406,"يقول حبيبي وقد زارني","https://www.aldiwan.net/poem33939.html","المتقارب"],[412,"أتهم فيكم لائمي وأنجدا","https://www.aldiwan.net/poem32486.html","الرجز"],[455,"لم يفجع الدهر أحلامي ويرهقها","https://www.aldiwan.net/poem61567.html","البسيط"],[466,"وهبت وقد سرت ذات الوشاح","https://www.aldiwan.net/poem3519.html","عموديه"],[466,"أتهويماً وليل الهم داجي","https://www.aldiwan.net/poem3585.html","عموديه"],[468,"ألا أيها البيت الذي أنا هاجره","https://www.aldiwan.net/poem50432.html","الطويل"],[481,"أقلع بقشك أيها الأسطول","https://www.aldiwan.net/poem37195.html","الكامل"],[515,"أتهجر من تحب وأنت جار","https://www.aldiwan.net/poem67752.html","الوافر"],[580,"أتهجر أم لا اليوم من أنت عاشقه","https://www.aldiwan.net/poem710.html",""],[572,"","https://poetry.dctabudhabi.ae/diwan/poem/21179","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/28060","الطويل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/21473","الطويل"],[873,"","https://poetry.dctabudhabi.ae/diwan/poem/17685","الطويل"],[873,"","https://poetry.dctabudhabi.ae/diwan/poem/17702","الطويل"],[1118,"","https://poetry.dctabudhabi.ae/diwan/poem/26693","الطويل"],[1197,"","https://poetry.dctabudhabi.ae/diwan/poem/97742","الكامل"]],"verses":[["أتهمت يا قلب رشداً لا يعي أرباً","فلست أدري علامَ أنت مصطلم",0,"م",1,0],["أَتَهويمَةً في ظِلِّ أَمنٍ وَغِبطَةٍ","وَعَيشٍ كَنُّوارِ الخَميلَةِ ناعِمِ",1,"م",1,0],["أتَهْجُرُ مَن غادَرْتَ بينَ ضُلوعِهِ","جَوًى يتلظّى مثلَما يَقِدُ الجَمْرُ",2,"ر",1,0],["أَتَهزَأُ بِالدُعاءِ وَتَزدَريهِ","وَما تَدري بِما صَنَعَ الدُّعاءُ",3,"ا",2,1],["أَتَهجُرُ غانِيَةً أَم تُلِم","أَمِ الحَبلُ واهٍ بِها مُنجَذِم",4,"م",1,1],["أَتَهجُرُني وَتَغصِبُني كِتابي","وَما في الحَقِّ غَصبي وَاجتِنابي",5,"ب",2,1],["أَتَهوى مَن دَعاكَ لِطولِ شَجوٍ","وَمَن أَضنى فُؤادَكَ إِذ دَعاكا",6,"ك",2,0],["أَتَهجونَ يَربوعاً وَأَترُكُ دارِماً","تَهَدَّمَ أَعلى جَفرِكُم وَأَسافِلُه",7,"ل",2,0],["أَتَهجوهُ وَلَستَ لَهُ بِكُفءٍ","فَشَرُّكُما لِخَيرِكُما الفِداءُ",8,"ا",2,0],["أتهتك ستريَ عن خَلَّتي","وتُغلق دون عطاياك بابا",9,"ب",2,0],["أتهدي لك الأيام غوْلاً وإنما","مساعيك في أعناقهن قلائدُ",10,"د",1,0],["أتهلعُ وحشةً لفراقِ إلفٍ","وقد وطنتُها لحلول رَمْس",11,"س",1,0],["أتهتزُّ في ورقٍ ناضرٍ","وليس لعبدِكَ في ذاك ظِلُّ",12,"ل",1,0],["أتهجرني والحبلُ في خير معقدٍ","وتحنو وتدنو عند مضطرب الحبلِ",13,"ل",1,0],["أَتَهزَأُ مِنّي أَن سَمِنتَ وَأَن تَرى","بِوَجهي شُحوبَ الحَقِّ وَالحَقُّ جاهِدُ",14,"د",1,0],["أَتَهجُرُ هَذا الرَبعَ أَم أَنتَ زائِرُه","وَكَيفَ يُزارُ الرَبعُ قَد بانَ عامِرُه",15,"ه",1,1],["أَتَهدِمُ جُرفَيها وَطَودُكَ طَودُها","وَتَنحِتُ فَرعَيها وَعودُكَ عودُها",16,"د",3,0],["أَتَهجو بِالأَقارِعِ وَاِبنِ لَيلى","وَصَعصَعَةَ الَّذي غَمَرَ البِحارا",17,"ر",2,0],["أَتَهجُرُني وَما أَسلَفتُ ذَنباً","وَيَظهَرُ مِنكَ زَورٌ وَازوِرارُ",18,"ر",1,1],["أَتَهجُرُني وَتَحفَظُ عَهدَ غَيري","وَهَل لِلمَوتِ عُذرٌ بَعدَ دَينِ",19,"ن",1,0],["أَتْهَمُونِي فِي مَوَدَّتِهِ","وَالْهَوَى مِنْ شَأْنِهِ التُّهَمُ",20,"م",1,0],["أتهزأُ بي لمَّا أجدُّ وتلعبُ","وتعجبُ مِنْ حالي وحالُكَ أَعْجبُ",21,"ب",1,1],["أَتَهجُرُ بَيتاً لِلحَبيبِ تَعَلَّقَت","بِهِ الحِبُّ وَالأَعداءُ أَم أَنتَ زائِرُه",22,"ر",2,0],["أَتُهانُ مصرُ ونحن حول لوائها","الموتُ أكرمُ والقبورُ فِساحُ",23,"ح",1,0],["أَتَهدِمُ طولَ يَومِكَ ما بَنَتهُ","يَداكَ مِنَ المَعاقِلِ طولَ أَمسِكْ",24,"ك",1,0],["أَتَهيجُهُم طَشيوزُ وَهيَ سَحابَةً","تَمضي كَما يَمضي السَحابُ الجُونُ",25,"ن",1,0],["أَتَهجوا مَن رَوى جَزَعاً وَلُؤماً","كَساقي اللَيلِ مِن كَدَرٍ وَصافي",26,"ف",2,0],["أَتَهِدُّ الإِنجيلَ في يَومِ كَنسٍ","بَعدَ حِفظِ الأَسباعِ وَالأَخماسِ",27,"س",1,0],["أتهدأ وهي في الغمرات تأسو","جريحاً أو تشدُّ له ضِمامهْ",28,"م",2,0],["أتهتف بي أنتَ أم هُنَّ أمْ","نذيرُ الردى والقضاءُ المتاحْ",29,"ح",1,0],["أَتَهجونَ يَربوعاً وَقَد رَدَّ سَيبَكُم","فَوارِسُهُم وَالبيضُ يُلوينَ بِالخُمرِ",30,"ر",1,0],["أَتُهيِّيءُ اسْتِقْلاَل قَوْمِكَ جَاهِداً","وَتُذَادُ عنْهُم يَوْمَ الاِستِقْلالِ",31,"ل",1,0],["أَتَهَادَتِ الأَهْرَامُ وَهْيَ طَرُوبَةٌ","لِمَديحِهِ تَهْتَزُّ كَالأَفْيَاءِ",32,"ا",2,0],["أَتهَمتُهُ فَوَرَبّي","لَولا التُقى لَأَقَدتُه",33,"ت",2,0],["أتُهْدِي لِيَ الْفَحْشَا وأنْتَ..","مَطِيَّة ُ كِنْدِيرٍ تَرُوحُ وَتُبْكِرُ",34,"ر",1,0],["أَتةكَ يُزْجِيهُمُ للحَينِ جاهِلهُمْ","مُستَقْدِماً بِهمُ للبَغْيِ مُزْدَلِقَا",35,"ق",2,0],["أتهدِّدينَ بحبِّك الثاني..","وزندٍ غير زندي؟",36,"د",2,0],["أَتهذي بالسلو وقد","غرام الغيد أَضنانا",37,"ن",2,0],["أَتَهْجُرُ مَنْ لَيْسَ يَهْوى سِواكَ","وَيَهْوى هَواكَ وَتَهْوى جَفَاهْ",38,"ا",2,0],["أتهلكني من غير ذنبٍ وزلَّةٍ","فماذا بقتلي يا حبيب تريدُ",39,"د",1,0],["أَتُهدي لي الوَعيدَ عَلى التَنائي","وَما مِثلي يُخَوَّفُ بِالقَوافي",40,"ف",2,0],["أَتُهدي الهِجاءَ لِامرِىءٍ غَيرِ مُفحَمٍ","وَتُهدي الوَعيدَ لِامرِىءٍ غَيرِ موعَدِ",41,"د",1,0],["أتهجر بيتي أنت آهاً ولوعة","لأنك في القلب المتيّم أشغالي",42,"ي",1,0],["أُتهمتَ زوراً بالقباحةِ والأذى","واغتابكَ الدوريشُ والقسيس",43,"س",1,0],["أتْهِمْ وَأنْجِدْ يَا نَجِيبُ فَقَد قَضَى","نَحْباً أَخُو الإنْجَادِ وَالإتهامِ",44,"م",1,0],["أتْهَمَ بِي في الهَوَى وأَنْجَدْ","مُهَفهَفُ الخَصْرِ أَهْيف القَد",45,"د",1,1],["أتُهادِنُ الأعداءَ تَطلُبُ سِلْمَهُمْ","خَطْباً لعَمرُك لو عَلِمتَ جليلا",46,"ل",2,0],["أتهدمُ ما شيّدتَ من بعض توبة","تخفِّف من ذنب عليك مثقَّل",47,"ل",1,0],["أتهجر قول اللّه فيما أتيته","وتؤثر قول الشاعر المتقادم",48,"م",1,0],["أتهوى الرياض وأزهارها","وعندي من الروض ما لا يعد",49,"د",1,0],["أتْهَم فيكُم لائمي وأنْجَدا","وما أفادَ سلوةً إذْ فنّدَا",50,"د",2,1],["أتهملون الآلى قد مهدوا زمنا","لنصركم وتعزون الألى هانوا",51,"ن",3,0],["أتهدر فيك سالفة القوافي","وختمي بالمحامد وافتتاحي",52,"ح",2,0],["أتهويماً وليلُ الهمّ داجي","فهاتِ من السّلاف سنا سراج",53,"ج",1,1],["أَتَهجُرُ بَيتاً بِالحِجازِ تَلَعَّبَت","بِهِ الحَربُ وَالأَعداءُ أَم أَنتَ زائِرُه",54,"ر",2,0],["أتهاجم الآساد في آجامها","وعرينها بليوثه مأهول",55,"ل",1,0],["أتهجر من تحب وأنت جار","وتطلبهم وقد بعد المزار",56,"ر",1,1],["أَتَهجُرُ أَم لا اليَومَ مَن أَنتَ عاشَقُهْ","وَمَن أَنتَ مُشتاقٌ إِلَيهِ وَشائِقُهْ",57,"ق",2,1],["أتهزأ مني أن سمنت وقد ترى","بجسمي مس الحق والحق جاهد",58,"د",1,0],["أَتَهجُرُ نُعماً أَم تُديمُ لَها وَصلا","وَكَم صَرَمَت نُعمٌ لِذي خُلَّةٍ حَبلا",59,"ل",2,1],["أَتَهجُر جُملاً أَم تُلِمُّ عَلى جُمل","وَجُملٌ عيوفُ الرِّيقِ جاذِبَةُ الوَصلِ",60,"ل",1,0],["أَتَهجُرُ لَيلى لِلفِراقِ حَبيبُها","وَما كانَ نَفساً بِالفِراقِ تَطيبُ",61,"ب",1,1],["أَتَهزَأُ مِنّي أُمُّ عَمرَةَ أَن رَأَت","نَهاراً وَلَيلاً بَلَّياني فَأَسرَعا",62,"ع",2,1],["أَتهجونَ قَوماً ثَأرُكُم في بُيوبِهِم","وَلَم تَصبِرا يَومَ اللِقاءِ فَتُعذَرا",63,"ر",2,0],["أَتهاتفونَ وَتشحذونَ سُيفوكم","وَتقوّمونَ ذَوابل المرّانِ",64,"ن",1,0]]}