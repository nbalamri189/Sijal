{"poems":[[63,"مزجنا دماء بالدموع السواجم","https://www.aldiwan.net/poem45816.html","الطويل"],[63,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[57,"أتهزأ بالدعاء وتزدريه","https://www.aldiwan.net/poem24736.html","الوافر"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[73,"أتهجرني وتغصبني كتابي","https://www.aldiwan.net/poem11903.html","الوافر"],[27,"ألا تصحو وتقصر عن صباكا","https://www.aldiwan.net/poem5946.html","الوافر"],[27,"ألم تر أن الجهل أقصر باطله","https://www.aldiwan.net/poem5976.html","الطويل"],[23,"عفت ذات الأصابع فالجواء","https://www.aldiwan.net/poem21233.html","الوافر"],[51,"أبا الصقر لست أرى مهديا","https://www.aldiwan.net/poem8301.html","المتقارب"],[51,"تجافت بنا منذ اشتكيت المراقد","https://www.aldiwan.net/poem61885.html","الطويل"],[51,"ترحل من هويت وكل شمس","https://www.aldiwan.net/poem64565.html","الوافر"],[51,"أيا من له الشرف المستقل","https://www.aldiwan.net/poem65882.html","المتقارب"],[51,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[14,"إني امرؤ عافي إنائي شركة","https://www.aldiwan.net/poem38307.html","الطويل"],[32,"أتهجر هذا الربع أم أنت زائره","https://www.aldiwan.net/poem27745.html","الطويل"],[45,"لدارك يا ليلى سماء تجودها","https://www.aldiwan.net/poem63478.html","الطويل"],[28,"تلوم على هجاء بني كليب","https://www.aldiwan.net/poem5239.html","الوافر"],[66,"أتهجرني وما أسلفت ذنبا","https://www.aldiwan.net/poem38756.html","الوافر"],[66,"أذاب التبر في كأس اللجين","https://www.aldiwan.net/poem40114.html","الوافر"],[87,"دع حبيب القلب يا سقم","https://www.aldiwan.net/poem8281.html","المديد"],[69,"أتهزأ بي لما أجد وتلعب","https://www.aldiwan.net/poem28601.html","الطويل"],[33,"بنفسي من لا بد لي أن أهاجره","https://www.aldiwan.net/poem25922.html","الطويل"],[105,"قل ما أردت فما عليك جناح","https://www.aldiwan.net/poem42081.html","الكامل"],[105,"أبا شادي وكنت لنا حليفا","https://www.aldiwan.net/poem43069.html","الوافر"],[105,"سر فالسعادة حيث كنت تكون","https://www.aldiwan.net/poem43406.html","الكامل"],[39,"أهاجك بالملا دمن عوافي","https://www.aldiwan.net/poem53768.html","الوافر"],[46,"أم دفر جزيت شرا فديا","https://www.aldiwan.net/poem22852.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1691","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43667","المجتث"],[50,"صَحَا الْقَلْبُ عَنْ سَلْمَى وَشَابَ الْمُعَذَّرُ","https://www.poetsgate.com/ViewPoem.aspx?id=22676",""],[45,"اسْتَوقِفا الرَّكبَ في أَطْلالِهم، وقِفا","https://www.poetsgate.com/ViewPoem.aspx?id=32848",""],[99,"إمرأة من زجاج","https://www.poetsgate.com/ViewPoem.aspx?id=16897",""],[124,"وهمت فليس ما سمي","https://www.aldiwan.net/poem23710.html","الهزج"],[155,"أيا من يرى أن حبي له","https://www.aldiwan.net/poem55499.html","المتقارب"],[204,"مزاري قريب والوصال بعيد","https://www.aldiwan.net/poem53338.html","الطويل"],[207,"ألا من مبلغ عني خفافا","https://www.aldiwan.net/poem27929.html","الوافر"],[207,"ألا أبلغا عمرا على نأي داره","https://www.aldiwan.net/poem27970.html","الطويل"],[211,"أتخطر في بالي خطرت فليتني","https://www.aldiwan.net/poem46622.html","الطويل"],[270,"مني السلام عليك يا إبليس","https://www.aldiwan.net/poem35266.html","الكامل"],[275,"بيني ثلاثا سلوة الأيام","https://www.aldiwan.net/poem25529.html","الكامل"],[275,"أتهم بي في الهوى وأنجد","https://www.aldiwan.net/poem25576.html","مخلع البسيط"],[364,"قسما لقد رجع النسيم عليلا","https://www.aldiwan.net/poem60803.html","الكامل"],[369,"رأيتك سعد الدين أكرم منتم","https://www.aldiwan.net/poem4299.html","الطويل"],[403,"أمثلك يرضى بارتكاب العظائم","https://www.aldiwan.net/poem33427.html","الطويل"],[403,"يقول حبيبي وقد زارني","https://www.aldiwan.net/poem33939.html","المتقارب"],[409,"أتهم فيكم لائمي وأنجدا","https://www.aldiwan.net/poem32486.html","الرجز"],[453,"لم يفجع الدهر أحلامي ويرهقها","https://www.aldiwan.net/poem61567.html","البسيط"],[464,"وهبت وقد سرت ذات الوشاح","https://www.aldiwan.net/poem3519.html","عموديه"],[464,"أتهويماً وليل الهم داجي","https://www.aldiwan.net/poem3585.html","عموديه"],[466,"ألا أيها البيت الذي أنا هاجره","https://www.aldiwan.net/poem50432.html","الطويل"],[479,"أقلع بقشك أيها الأسطول","https://www.aldiwan.net/poem37195.html","الكامل"],[513,"أتهجر من تحب وأنت جار","https://www.aldiwan.net/poem67752.html","الوافر"],[578,"أتهجر أم لا اليوم من أنت عاشقه","https://www.aldiwan.net/poem710.html",""]],"verses":[["أَتَهويمَةً في ظِلِّ أَمنٍ وَغِبطَةٍ","وَعَيشٍ كَنُّوارِ الخَميلَةِ ناعِمِ",0,"م",1,0],["أتَهْجُرُ مَن غادَرْتَ بينَ ضُلوعِهِ","جَوًى يتلظّى مثلَما يَقِدُ الجَمْرُ",1,"ر",1,0],["أَتَهزَأُ بِالدُعاءِ وَتَزدَريهِ","وَما تَدري بِما صَنَعَ الدُّعاءُ",2,"ا",2,1],["أَتَهجُرُ غانِيَةً أَم تُلِم","أَمِ الحَبلُ واهٍ بِها مُنجَذِم",3,"م",1,1],["أَتَهجُرُني وَتَغصِبُني كِتابي","وَما في الحَقِّ غَصبي وَاجتِنابي",4,"ب",2,1],["أَتَهوى مَن دَعاكَ لِطولِ شَجوٍ","وَمَن أَضنى فُؤادَكَ إِذ دَعاكا",5,"ك",2,0],["أَتَهجونَ يَربوعاً وَأَترُكُ دارِماً","تَهَدَّمَ أَعلى جَفرِكُم وَأَسافِلُه",6,"ل",2,0],["أَتَهجوهُ وَلَستَ لَهُ بِكُفءٍ","فَشَرُّكُما لِخَيرِكُما الفِداءُ",7,"ا",2,0],["أتهتك ستريَ عن خَلَّتي","وتُغلق دون عطاياك بابا",8,"ب",2,0],["أتهدي لك الأيام غوْلاً وإنما","مساعيك في أعناقهن قلائدُ",9,"د",1,0],["أتهلعُ وحشةً لفراقِ إلفٍ","وقد وطنتُها لحلول رَمْس",10,"س",1,0],["أتهتزُّ في ورقٍ ناضرٍ","وليس لعبدِكَ في ذاك ظِلُّ",11,"ل",1,0],["أتهجرني والحبلُ في خير معقدٍ","وتحنو وتدنو عند مضطرب الحبلِ",12,"ل",1,0],["أَتَهزَأُ مِنّي أَن سَمِنتَ وَأَن تَرى","بِوَجهي شُحوبَ الحَقِّ وَالحَقُّ جاهِدُ",13,"د",1,0],["أَتَهجُرُ هَذا الرَبعَ أَم أَنتَ زائِرُه","وَكَيفَ يُزارُ الرَبعُ قَد بانَ عامِرُه",14,"ه",1,1],["أَتَهدِمُ جُرفَيها وَطَودُكَ طَودُها","وَتَنحِتُ فَرعَيها وَعودُكَ عودُها",15,"د",3,0],["أَتَهجو بِالأَقارِعِ وَاِبنِ لَيلى","وَصَعصَعَةَ الَّذي غَمَرَ البِحارا",16,"ر",2,0],["أَتَهجُرُني وَما أَسلَفتُ ذَنباً","وَيَظهَرُ مِنكَ زَورٌ وَازوِرارُ",17,"ر",1,1],["أَتَهجُرُني وَتَحفَظُ عَهدَ غَيري","وَهَل لِلمَوتِ عُذرٌ بَعدَ دَينِ",18,"ن",1,0],["أَتْهَمُونِي فِي مَوَدَّتِهِ","وَالْهَوَى مِنْ شَأْنِهِ التُّهَمُ",19,"م",1,0],["أتهزأُ بي لمَّا أجدُّ وتلعبُ","وتعجبُ مِنْ حالي وحالُكَ أَعْجبُ",20,"ب",1,1],["أَتَهجُرُ بَيتاً لِلحَبيبِ تَعَلَّقَت","بِهِ الحِبُّ وَالأَعداءُ أَم أَنتَ زائِرُه",21,"ر",2,0],["أَتُهانُ مصرُ ونحن حول لوائها","الموتُ أكرمُ والقبورُ فِساحُ",22,"ح",1,0],["أَتَهدِمُ طولَ يَومِكَ ما بَنَتهُ","يَداكَ مِنَ المَعاقِلِ طولَ أَمسِكْ",23,"ك",1,0],["أَتَهيجُهُم طَشيوزُ وَهيَ سَحابَةً","تَمضي كَما يَمضي السَحابُ الجُونُ",24,"ن",1,0],["أَتَهجوا مَن رَوى جَزَعاً وَلُؤماً","كَساقي اللَيلِ مِن كَدَرٍ وَصافي",25,"ي",1,0],["أَتَهِدُّ الإِنجيلَ في يَومِ كَنسٍ","بَعدَ حِفظِ الأَسباعِ وَالأَخماسِ",26,"س",1,0],["أتهدأ وهي في الغمرات تأسو","جريحاً أو تشدُّ له ضِمامهْ",27,"م",2,0],["أتهتف بي أنتَ أم هُنَّ أمْ","نذيرُ الردى والقضاءُ المتاحْ",28,"ح",1,0],["أَتَهجونَ يَربوعاً وَقَد رَدَّ سَيبَكُم","فَوارِسُهُم وَالبيضُ يُلوينَ بِالخُمرِ",29,"ر",1,0],["أَتُهيِّيءُ اسْتِقْلاَل قَوْمِكَ جَاهِداً","وَتُذَادُ عنْهُم يَوْمَ الاِستِقْلالِ",30,"ل",1,0],["أَتَهَادَتِ الأَهْرَامُ وَهْيَ طَرُوبَةٌ","لِمَديحِهِ تَهْتَزُّ كَالأَفْيَاءِ",31,"ا",2,0],["أَتهَمتُهُ فَوَرَبّي","لَولا التُقى لَأَقَدتُه",32,"ت",2,0],["أتُهْدِي لِيَ الْفَحْشَا وأنْتَ..","مَطِيَّة ُ كِنْدِيرٍ تَرُوحُ وَتُبْكِرُ",33,"ر",1,0],["أَتةكَ يُزْجِيهُمُ للحَينِ جاهِلهُمْ","مُستَقْدِماً بِهمُ للبَغْيِ مُزْدَلِقَا",34,"ق",2,0],["أتهدِّدينَ بحبِّك الثاني..","وزندٍ غير زندي؟",35,"د",2,0],["أَتهذي بالسلو وقد","غرام الغيد أَضنانا",36,"ن",2,0],["أَتَهْجُرُ مَنْ لَيْسَ يَهْوى سِواكَ","وَيَهْوى هَواكَ وَتَهْوى جَفَاهْ",37,"ا",2,0],["أتهلكني من غير ذنبٍ وزلَّةٍ","فماذا بقتلي يا حبيب تريدُ",38,"د",1,0],["أَتُهدي لي الوَعيدَ عَلى التَنائي","وَما مِثلي يُخَوَّفُ بِالقَوافي",39,"ف",2,0],["أَتُهدي الهِجاءَ لِامرِىءٍ غَيرِ مُفحَمٍ","وَتُهدي الوَعيدَ لِامرِىءٍ غَيرِ موعَدِ",40,"د",1,0],["أتهجر بيتي أنت آهاً ولوعة","لأنك في القلب المتيّم أشغالي",41,"ي",1,0],["أُتهمتَ زوراً بالقباحةِ والأذى","واغتابكَ الدوريشُ والقسيس",42,"س",1,0],["أتْهِمْ وَأنْجِدْ يَا نَجِيبُ فَقَد قَضَى","نَحْباً أَخُو الإنْجَادِ وَالإتهامِ",43,"م",1,0],["أتْهَمَ بِي في الهَوَى وأَنْجَدْ","مُهَفهَفُ الخَصْرِ أَهْيف القَد",44,"د",1,1],["أتُهادِنُ الأعداءَ تَطلُبُ سِلْمَهُمْ","خَطْباً لعَمرُك لو عَلِمتَ جليلا",45,"ل",2,0],["أتهدمُ ما شيّدتَ من بعض توبة","تخفِّف من ذنب عليك مثقَّل",46,"ل",1,0],["أتهجر قول اللّه فيما أتيته","وتؤثر قول الشاعر المتقادم",47,"م",1,0],["أتهوى الرياض وأزهارها","وعندي من الروض ما لا يعد",48,"د",1,0],["أتْهَم فيكُم لائمي وأنْجَدا","وما أفادَ سلوةً إذْ فنّدَا",49,"د",2,1],["أتهملون الآلى قد مهدوا زمنا","لنصركم وتعزون الألى هانوا",50,"ن",3,0],["أتهدر فيك سالفة القوافي","وختمي بالمحامد وافتتاحي",51,"ح",2,0],["أتهويماً وليلُ الهمّ داجي","فهاتِ من السّلاف سنا سراج",52,"ج",1,1],["أَتَهجُرُ بَيتاً بِالحِجازِ تَلَعَّبَت","بِهِ الحَربُ وَالأَعداءُ أَم أَنتَ زائِرُه",53,"ر",2,0],["أتهاجم الآساد في آجامها","وعرينها بليوثه مأهول",54,"ل",1,0],["أتهجر من تحب وأنت جار","وتطلبهم وقد بعد المزار",55,"ر",1,1],["أَتَهجُرُ أَم لا اليَومَ مَن أَنتَ عاشَقُهْ","وَمَن أَنتَ مُشتاقٌ إِلَيهِ وَشائِقُهْ",56,"ق",2,1]]}