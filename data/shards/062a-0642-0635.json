id=215390",""],[5102,"حنين..","https://www.poetsgate.com/ViewPoem.aspx?id=12883",""],[4045,"لئن حبس المشيب عنان لهوي","https://www.poetsgate.com/ViewPoem.aspx?id=200298",""],[5307,"حيّ جيلٍ يا بِلَمْثَالي","https://www.poetsgate.com/ViewPoem.aspx?id=10538",""],[5353,"عندما ماتَ الشّاعرُ بينَ يديه ِ","https://www.poetsgate.com/ViewPoem.aspx?id=212466",""],[5397,"تعجب الدهر من صبري ومن جلدي","https://www.poetsgate.com/ViewPoem.aspx?id=157958",""],[5397,"أترع لي في سفحه الأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=157902",""],[5431,"على الغيم من ثقب الجدار أبصبصُ","https://www.poetsgate.com/ViewPoem.aspx?id=197644",""],[5997,"عَصْفُ رِيْح","https://www.poetsgate.com/ViewPoem.aspx?id=214286",""],[6038,"روح عساف","https://www.poetsgate.com/ViewPoem.aspx?id=25693",""],[463,"نرقُّ وتقسو بالغوير قلوبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59978&r=&rc=34",""],[463,"وصفحة ِ وجه من وجوهٍ علقتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59990&r=&rc=46",""],[6302,"بَغدادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86227&r=&rc=25",""]],"verses":[["تَقصُرُ الأَلحاظُ عَنهُنَّ فَما","ظَنُ مَن مَدَّ يَدَيهِ لِلمَنالِ",0,"ل",1,0],["تُقَصُّ بِآثارِ الدِماءِ كَأَنَّها","مَساحِبُ جَرحى يَومَ طالَ طِرادُ",1,"د",1,0],["تَقصُرُ الآجالُ مِن أَعدائِكُم","وَيُطالُ العَيشُ فيكُم وَيُمَد",2,"د",1,0],["تَقصُرُ عَنهُ هِمَّةُ الأَقلامِ","يا لَيتَ شِعري بَعدَ هَذا العامِ",3,"م",1,0],["تَقَصّى إِلَيَّ الحَيُّ إِمّا دَلالَةً","عَلَيَّ وَإِمّا قادَهُ لِيَ ناصِحُ",4,"ح",1,0],["تقصر أفكار العدى عن خداعهِ","ويخدعه في الجودِ من لا يخادع",5,"ع",1,0],["تُقصِّرُ الدهرَ أحاديثُهُ","وتُعجِبُ الأمردَ والأشيبا",6,"ب",2,0],["تقصد أن يصفو الحرامُ لها","ما ظَلَمتْها سياط عيَّاش",7,"ش",1,0],["تُقَصِّرُ عَنهُ الريحُ إِمّا تَسابُقاً","فَكَيفَ تُجاريهِ المُطَهَّمَةُ الجُردُ",8,"د",1,0],["تَقُصُّ عَلى المَدائِنِ وَالقَرايا","حِكايَةَ قَومِكِ المُستَنبِطينا",9,"ن",2,0],["تُقَصِّرُ الأَلسُنُ عَن وَصفِها","لَو بالَغَت وَاِستَغرَقَت جُهدَها",10,"د",3,0],["تَقَصَّدَهُ المِقدارُ بَينَ صِحابِهِ","عَلى ثِقَةٍ مِن دَهرِهِ وَأَمانِ",11,"ن",1,0],["تَقَصّاهُمُ بِالجودِ حَتّى لَأَقسَموا","بِأَنَّ نَداهُ كانَ وَالبَحرَ تَوءَما",12,"م",2,0],["تُقَصِّرُ عَن مِثالِ يَدَيهِ عِلماً","فَقَصرُكَ أَن تَظُنَّ بِهِ الظُنونا",13,"ن",2,0],["تُقَصِّرُ عن مَداها الرِّيحُ جَرْياً","وتَعْجَزُ عن مواقِعِها السِّهامُ",14,"م",1,0],["تَقصُرُ الكُتبُ عَن تَطاوُلِ عَتبي","لَيتَ شِعري فَما الَّذي كانَ ذَنبي",15,"ب",2,1],["تَقصُرُ عَينُ البَصيرِ عَنهُ وَكَم","دَهرٍ رَماهُ بِطولِ تَخليجِ",16,"ج",1,0],["تُقصَفُ بِالقُدرَةِ رَضوى كَما","يُقصَفُ هَذا الغُصنُ المائِدُ",17,"د",1,0],["تُقصيكِ عن أرضِ بغدادٍ ودجلتها","أمَّا الفراتُ فنبعٌ بيننا شَرع",18,"ع",1,0],["تقصر عنه الرّيح إما تسابقا","فكيف تجاربه المطهّمة الجرد؟",19,"د",1,0],["تقصر أيامها عليها","فتغنم الطُّول في الليالي",20,"ل",2,0],["تُقصي الجَهالَةَ تُهْدي النّاسَ مَعْرِفةً","والنَّاسُ ما بَرِحوا أعْداءَ ما جَهِلوا",21,"ل",3,0],["تَقصيرُكَ الذَيلَ حَقّاً","أَبقى وَأَنقى وَأَتقَى",22,"ق",2,1],["تقصُّ أخبارَ حالي وهي حاملةٌ","منّي سلاماً كمثلِ الدُّرِ يَنْتَشِرُ",23,"ر",1,0],["تَقصُّ السريجيّاتُ أخبارَ فِعلهِ","وتروي الوشيجُ اللّدنُ وهي شواهِدُ",24,"د",1,0],["تَقصُّ لنا أخبارَ عادٍ وقومِه","وتروي لنا ما فاردَ العجمَ العُرْبُ",25,"ب",1,0],["تقصر للراقد في لذة","وطالما طالت علي الساهر",26,"ر",1,0],["تقصر الرسل طرا","عنه وَجها وَجاها",27,"ا",3,0],["تُقَصِّرُ عَنْهُ أَمْلاكُ البَرايا","وَهَيْهَاتَ الزُلالُ مِنَ الزعاقِ",28,"ق",1,0],["تُقَصِّرُ عَنْهُ أمْلاكُ البَرَايا","وعُودُ النَّبْعِ لَيْسَ مِنَ الثِّمامِ",29,"م",1,0],["تقِصُ الأَعادي ظاعِناً أَوْ قاطِناً","واللَّيْثُ أَغْلَبُ مُصْحِراً وَمُغَيِّضا",30,"ض",2,0],["تَقَصَّت عِداهُ من مدى البين غايةً","فَلا دَنَت القُصوى ولا بَعُد الحَتفُ",31,"ف",1,0],["تَقِصُ الأُسودَ بكلّ ناحلةٍ","في الكفِّ ممّا تُنبِتُ الأجَم",32,"م",1,0],["تَقْصُرُ الأنجُمُ عن آرائه","إن حكَتْها في سناً أو في سَناء",33,"ا",2,0],["تَقِصُ اللُيوث الغلب وَهي ضَعائِف","وَتَطول سُمر الخُطِّ وَهيَ قِصارُ",34,"ر",1,0],["تقصّرَ عن نُعماكَ أولادُ جفنةٍ","ويعصُرُ عن إدراكِ شأوي حسّانُ",35,"ن",1,0],["تُقصِّرُ الرِّيحُ عن مَسْرى كتائِبِهِ","كما تَقاصَرَتِ الأَملاكُ عن أَمَدِهْ",36,"د",2,0],["تقصِّر الأقدارُ عن ملككم","ما قصر الحافي عن الناعلِ",37,"ل",1,0],["تقصُّ علَيَّ الحقَّ ما حضَرتْ معي","ولا تصدقُ الإخبارَ بعدي ولا قبلي",38,"ل",2,0],["تُقصِّر عن أقدامِها ورءوسِها","وتملأ أصلاباً لها وجُنوبا",39,"ب",2,0],["تَقْصُرُ الأَقْوالُ عِنْدَ ال","شَّرْعِ والشَّرعُ يَطولُ",40,"ل",1,0],["تقصّتْ نهاياتِ المعالِي أُصولُه","وساعفها فرعٌ على النّجمِ فارعُ",41,"ع",1,0],["تَقْصُرُ عَنْهُ الرِّيْحُ فِي","إِعْنَاقِهِ وَمَا انْبِسَطْ",42,"ط",1,0],["تقصّر إِنْ سابقتْه الرياحُ","وتوجَدُ في إِثْره تَعْثُر",43,"ر",1,0],["تَقْصِدُه خشَّعَ القلوبِ كَما","تدخلُ مِنْ بِابِه لَهُ سُجَّدَا",44,"د",2,0],["تَقصُرُ الشَّمسُ أن تَظَلَّ لَهُ نَع","لاً ويُمسيِ الهَلالُ فيهِ شِراكا",45,"ك",2,0],["تقصرُ عن أطرافه المطارف","إذا مَشت ترفعه الروادف",46,"ف",1,0],["تْقصّ بْها الخلفات تهبّ وْتسند","وما تنعرف مضموتها من رغودها",47,"د",3,0],["تَقصّر شأواً عنه في جلّة العلا","عصامٌ وقعقاع بن شور وأحنفُ",48,"ف",1,0],["تقصي الكرام بلا ذنب ولا جرم","وأنت تدني رخيص القدر ما العلل",49,"ل",1,0],["تقصّها الانسام في سكرةٍ","في الغاب للغرّيدة الحوّم",50,"م",1,0],["تقصدت لفظ الساق في ذكر نعته","لانجو إذا ما التفت الساق بالساق",51,"ق",1,0],["تقص عليهم أقاصيص ما","أتاها عن الأعصر الخالية",52,"ه",1,0],["تقصفت تلكم الأغصان كلّ أخٍ","في إثر من سار من أهليه يلتحم",53,"م",1,0],["تقصر عن أعدادها حيث أعتقت","تجوب الفيافي الناسمات اللوامح",54,"ح",1,0],["تقصد الذابلات السمر سطوته","في محفل من أعاديه يصرعه",55,"ع",2,0],["تُقَصِّرُ كَفُّ الحَمدِ عَنكَ وَباعُهُ","وَتَعجَزُ أَوصالُ النُهى وَالمَناصِلُ",56,"ل",1,0],["تُقَصِّرُ الوَرَلَ العادي بِضَربَتِها","نَكزاً وَيَهرُبُ عَنها الحَيَّةُ الذَكَرُ",57,"ر",1,0],["تَقصد المَوت عَياناً","تَحتَ ظل السَمهريّه",58,"ي",2,0],["تَقِصُ الإِكام إِذا عدَت بِملاطِسٍ","سُمرِ المَناسِمِ كلّهنَّ رَثيمُ",59,"م",1,0],["تقصر عنه آيات المراثي","ولو اتت المراثي من جرير",60,"ر",1,0],["تَقصد في لباتها تحت قسطلٍ","به الأروع المقدام حاد عن القصد",61,"د",1,0],["تقصدُ بحرا قد طما عبابهُ","لو نفد البحر ندىً ما نفدا",62,"د",2,0]