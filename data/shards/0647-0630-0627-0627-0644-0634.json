{"poems":[[107,"صاح الحمى ببني الهيجاء فاعتزموا","https://www.aldiwan.net/poem42113.html","البسيط"],[77,"الحب حيث المعشر الأعداء","https://www.aldiwan.net/poem69109.html","الكامل"],[92,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[124,"ما أنس لا أنس أياما نعمت بها","https://www.aldiwan.net/poem49318.html","البسيط"],[182,"الطريد","https://www.aldiwan.net/poem50688.html","الكامل"],[228,"هذي الروائع من ذاك اللظى خلق","https://www.aldiwan.net/poem39686.html","البسيط"],[228,"أشعة من مقلتيك ملهبه","https://www.aldiwan.net/poem39698.html","الرجز"],[287,"شابت ذوائب لوز بقين","https://www.aldiwan.net/poem32317.html","أحذ الكامل"],[449,"أهلا بطلعة وجهك المحبوب","https://www.aldiwan.net/poem55944.html","عموديه"],[558,"عاود عزاءك لا يعنف بك الذكر","https://www.aldiwan.net/poem68392.html","البسيط"],[567,"أعطى الأمير المجيد اليوم تربته","https://www.aldiwan.net/poem52526.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122721","الكامل"],[816,"","https://poetry.dctabudhabi.ae/diwan/poem/107101","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77556","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145944","البسيط"],[998,"","https://poetry.dctabudhabi.ae/diwan/poem/205359",""],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59422","البسيط"],[1206,"","https://poetry.dctabudhabi.ae/diwan/poem/143152","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136264","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93813","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203000","الكامل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115469","الكامل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115590","الكامل"],[3235,"","https://poetry.dctabudhabi.ae/diwan/poem/111107","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87390","الكامل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34571","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40104","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70115","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77090","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119665","البسيط"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136942",""],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58169","الكامل"],[4717,"الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=199575",""],[4755,"هذا السَّعِيدُ \"تَقَدَّسَتْ أَسماؤُهُ\"","https://www.poetsgate.com/ViewPoem.aspx?id=188670",""],[4755,"عَرَبيٌّ في الجِيتُو","https://www.poetsgate.com/ViewPoem.aspx?id=215951",""],[4869,"غاب اتصاله","https://www.poetsgate.com/ViewPoem.aspx?id=151621",""],[4991,"عطر الليل","https://www.poetsgate.com/ViewPoem.aspx?id=190437",""],[5038,"رذاذ القسطل","https://www.poetsgate.com/ViewPoem.aspx?id=189378",""],[5106,"يَا مِسْكَةَ العَرَبِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=154846",""],[5121,"نَبْضُ السَّهَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=216074",""],[5187,"درس في الحب","https://www.poetsgate.com/ViewPoem.aspx?id=29792",""],[5190,"النيل يتحدث عن نفسه","https://www.poetsgate.com/ViewPoem.aspx?id=61840",""],[5480,"(هذا الزمن) في غلاء المهور","https://www.poetsgate.com/ViewPoem.aspx?id=4166",""],[5526,"حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=192345",""],[5573,"انشد عن الي مر به","https://www.poetsgate.com/ViewPoem.aspx?id=202260",""],[5887,"يا طائر الدوح","https://www.poetsgate.com/ViewPoem.aspx?id=35290",""],[5956,"حول أحمد وسعاد","https://www.poetsgate.com/ViewPoem.aspx?id=193720",""],[5956,"أنهكتَ نفسك لتنفعني وتنفعَ العالم","https://www.poetsgate.com/ViewPoem.aspx?id=206262",""],[6093,"نفس كشمس","https://www.poetsgate.com/ViewPoem.aspx?id=197702",""],[6102,"الشهيد ..","https://www.poetsgate.com/ViewPoem.aspx?id=182893",""],[6213,"ومضة من الألق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81912&r=&rc=87",""],[6222,"يا تائهون على الدروب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1930&r=&rc=1",""]],"verses":[["هذا الشّهيد الذي ما انفكّ من دمِه","في جَفْنِ كلّ فتىً بالمشرقَيْنِ دَمُ",0,"م",1,0],["هذا الشّفيعُ لأمّةٍ يأتي بها","وجُدُودُهُ لجدُودِها شُفعاء",1,"ا",2,0],["هذا الشَّبابُ ومِن سَناكَ رفيفُهُ","مجدُ البلادِ بهِ يرفُّ ذوائبا",2,"ب",2,0],["هذا الشراب وهذي الكأس مترعة","فاشرب وهات اسقنيها غير محتفل",3,"ل",1,0],["هَذا الشّقيُّ أقالَهُ كفُّ الهَنا","البُؤْسُ فيهِ لأنني فيهِ أنا",4,"ن",2,1],["هذا الشَبابُ رِضاعُ الحَقِّ في دَمِهِ","فَكَيفَ يَسلَمُ مَن في عِرقِهِ رَنَقُ",5,"ق",1,0],["هذا الشَقا يا غَلوَ يا حَبيبَتي","يا أُختِ يا عَروسس يا رَفيقَتي",6,"ي",1,0],["هذا الشَقا في مَطهَرِ التَكفيرِ","آخِرُ حدٍّ لِشَقا الضَمير",6,"ر",1,0],["هَذا الشَّبابُ هُوَ المَشيبُ أَلا","فَاِعجَب لِجَمعٍ بَينَ ضِدَّينِ",7,"ن",1,0],["هذا الشآم وهذه ابناؤه","هرعوا اليك بافصح الترحيب",8,"ب",1,0],["هَذا الشَبابُ لَهُ في شِرَّةٍ أُنُفُ","دونَ الثَلاثينَ مَجلوبٌ بِهِ الشِرَرُ",9,"ر",1,0],["هذا الشِّهابُ الذي قد كانَ مرتفِعاً","في الأرضِ واليومَ في أوج العُلَى اُرْتَفَعَا",10,"ع",2,0],["هذا الشّتاءُ أمَضَّني تِشرينُهُ","جَهمُ المُقابَلِ وانقَضَى أيلُوله",11,"ل",2,0],["هذا الشهاب المستضاء بنوره","علم الهدى هذا الإمام الأوحد",12,"د",1,0],["هَذا الشَعير فالقطوه حبا","مِن قبل أَن يَشعل فيكُم حَربا",13,"ب",2,0],["هذا الشراعُ الذي صيِّرتهُ كفناً","إليكَ ما زال فوقَ الموجِ متسِدا",14,"د",2,0],["هذا الشهيدي رهن قبر","وشعره ناطق شهيد",15,"د",1,0],["هذا الشفيع والوجيه المتجتبى شرفا","خير الورى غاية الإيجاد مبداه",16,"ا",2,0],["هذا الشهاب وزيرنا","في الفقه بحر ذو غزاره",17,"ر",2,1],["هذا الشهود تبلجت أنواره","هذا العيان بشاهد التحقيق",18,"ق",1,0],["هذا الشريف الذي أسلاف نسبته","در تنظم في سمط من الحسب",19,"ب",1,0],["هذا الشتاء بدا من الآكامِ","متلقعاً من صحبه بلئام",20,"م",1,1],["هذا الشقيقُ أحمرّ من خجل به","لما غدا لسوى خدودِك يُنسَبُ",21,"ب",1,0],["هذا الشقيقُ وقد أتانا زائِراً","من بعدِ غيبتِه وطول مزارهِ",22,"ه",1,1],["هذا الشباب قضيته","لهواً كما يهوى هواكا",23,"ك",2,0],["هَذا الشُمَيِّلُ مُلحِمٌ من عزِّهِ","وَالمَجدِ انزلهُ القضاءُ الانكَدُ",24,"د",1,0],["هذا الشميط كأنه متحيرٌ","في الأفقِ سد طريقه فألاحا",25,"ح",2,0],["هذا الشّريفُ أَضَلَّنِي","بَعدَ الهداية والنَّظَرْ",26,"ر",1,0],["هَذا الشَمالي بِاليَمين مودّعٌ","جَمعاً يُفارقهُ بدمعٍ ساكِبِ",27,"ب",1,1],["هَذا الشَريفُ المُرتَضى","زانَت مَكارِمَهُ الوُجود",28,"د",1,0],["هذا الشفيع الذي ترجى شفاعته","فينا لكل مهولٍ كان من زلل",29,"ل",1,0],["هذا الشجاع الذي ما ذلّ قط ولم","يهب لدى الحرب من سيفٍ ومن أسل",29,"ل",1,0],["هذا الشبابُ وقد أشفت نواصيه","على المشيب أمن رجعى لماضيهِ",30,"ي",2,1],["هذا الشجاعُ المرتَضَى البطلُ الذِي","يخشاهُ طُرّاً جملةُ الأقرانِ",31,"ن",1,0],["هذا الشهيدُ وَذَا خؤونٌ نافقٌ","شتَّانَ ليسوا في غدٍ رفقاءَ",32,"ا",2,0],["هذا الشَّتَاتُ اليَومَ طِفلُ خَطيئَةٍ","ولِكُلِّ طِفلِ خَطيئةٍ أخطاؤُهُ",33,"ا",3,0],["هذا الشُّذُوذُ له عَوَاقِبُهُ","فمتى..؟ متى يُستَوعَبُ الدَّرسُ؟!",34,"س",1,0],["هذا الشعر جيته عقب ما ترديت","اشكي لاوزانه وتبكي قوافيه",35,"ي",2,0],["هذا الشعور العذب صغته لك لحون","وابيات شعرٍ طالعه من حناياي",36,"ا",2,0],["هذا الْشّجاعُ تروقهُ سوحُ الْوغى","لو غيرهُ يبْقى أسيرَ الْأكْحلِ",37,"ل",1,0],["هَذَاْ الشُّعَاْعُ بِكَأسِ الصُّبِْحِ مِنْ دَمِِهِ","هَذِيْ الْبِقَاْعُ لِعَرْشِ الشَّمْسِ مُنْتَدَبِ",38,"ب",1,0],["هَذَا الشُّعُورُ عَجِيبٌ أَمْرُ رِحْلَتِهِ","وَأَعْجَبُ الأَمْرِ أَنِّي قَائِدُ السَّفَرِ",39,"ر",1,0],["هذا الشعور إذا درجت بهِ","قد فزتِ بالأولى بلا جَدَلِ",40,"ل",1,0],["هَذَا الشَّبَابُ الَّذِي أَسقَيْتُهُ شَمَماً","هَامَاتُهُ لَمَسَت مِن طُولِهَا الأُفُقا",41,"ق",2,0],["هذا الشقاء يا ناس صرحن به التمثيل","والسموحه يا عرب باللي قولي يحده",42,"د",2,0],["هذا الشعور اللي تكوّن من اعوام","من قبل اعرفك لين لحظة وفاتي",43,"ت",2,0],["هذا الشعيب وسنّده","وانشد عن الي مر به",44,"ب",2,0],["هذا الشباب يخاف الكفر غضبته","يرمي الجنود بزخات من الحصب",45,"ب",1,0],["هذا الشعور بريئٌ لا عقاب له","في خانة الخوف والتقدير والحُلُمِ",46,"م",1,0],["هذا الشَّمالي رعاني في الجنوب وفي","شرقٍ وغرب وفي الزُّهرى وفي زُحَلِ",47,"ل",1,0],["هذا الشَّهيْدُ الخُلدُ مَوْئِلُهُ","ومَآلُ خَوَّارٍ بِهِ لَبْسُ",48,"س",1,0],["هَذا الشَّهيدُ عَرُوسُ المَجدِ فَابتَهِجُوا","مَشَى إِلَى اللَّهِ فِيما نَحنُ نَعتَذِرُ",49,"ر",1,0],["هذا الشموخ وهذا العقد والحلقُ","هذي البروق وهذا الغيم والودقُ",50,"ق",1,1],["هذا الشهيد ... ألسْتَ تعْرفُه ؟","ألعِزُّ بين يديهِ والجاهُ",51,"ا",2,0]]}