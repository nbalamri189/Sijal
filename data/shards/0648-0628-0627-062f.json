/www.poetsgate.com/ViewPoem.aspx?id=161861",""],[585,"ذكرت له أيامنا فتنهدا","https://www.poetsgate.com/ViewPoem.aspx?id=161845",""],[5135,"هِلَالٌ أَطَلَّ","https://www.poetsgate.com/ViewPoem.aspx?id=204535",""],[5183,"على شعر ابن الدَّمينة","https://www.poetsgate.com/ViewPoem.aspx?id=180216",""],[5200,"سبقت إلى فصدة شافية","https://www.poetsgate.com/ViewPoem.aspx?id=200808",""],[5206,"حَيَاةُ المُهَج","https://www.poetsgate.com/ViewPoem.aspx?id=187392",""],[5282,"رفقاً بنبع الحنان","https://www.poetsgate.com/ViewPoem.aspx?id=213983",""],[5415,"ألآ أيها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=212280",""],[5472,"الى الله من عودتى توبتى","https://www.poetsgate.com/ViewPoem.aspx?id=200466",""],[5605,"شقاق الرفاق","https://www.poetsgate.com/ViewPoem.aspx?id=177661",""],[5674,"نسمة الدير","https://www.poetsgate.com/ViewPoem.aspx?id=185169",""],[5837,"مسمّى مزامل","https://www.poetsgate.com/ViewPoem.aspx?id=177547",""],[6102,"قبلة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=184634",""],[6148,"نصائح غالية","https://www.poetsgate.com/ViewPoem.aspx?id=203066",""],[2220,"وبادر لتهجير العروبة ِ قاصداً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11161&r=&rc=35",""]],"verses":[["وَبادِر إِلى اللَذّاتِ فَالدَهرُ مولَعٌ","بِتَنغيصِ عَيشٍ وَاِصطِلامِ عَلاءِ",0,"ا",2,0],["وَبَادِرْ عَدُوَّ اللهِ عِنْدَ اضْطِرَابِهِ","وَعَاجِلْهُ بِالْبيِضِ الرِّقَاقِ الْقَوَاضِبِ",1,"ب",1,0],["وبادرهم كالسيل عند انحداره","وهم في مهاوي غفلة عن بِداره",2,"ر",2,0],["وبادرها دفء الكنيف ولم يُعِن","على الضيف ذي الصحْن المسنَّ حلوبُها",3,"ب",3,0],["وبادر لمحيي الدين تلق شمائلاً","مدربةً لم تدرِ ما هيئة الشحّ",4,"ح",1,0],["وبادي الجهل جَاوَدَهُ فقلنا","متى استعلى على النخلِ البشامُ",5,"م",1,0],["وَباد وَيُعجِزُ خاطِري إِدراكَهُ","وَفِتنَتي بِالظاهِرِ المُتَواري",6,"ر",2,0],["وَبادَرَهُ بِالدَمعِ جَفني كَأَنَّهُ","كَريمٌ رَأى ضَيفاً فَدَرَّت مَكارِمُه",7,"م",2,0],["وبادرْ بلذاتكَ الحادثاتِ","فإِن الزمانَ كثيرُ العُرامِ",8,"م",1,0],["وَبادِروا بِاِبنِ لَيلى المَوتَ إِنَّ لَهُ","كَفَّينِ ما فيهِما بُخلٌ وَلا حَصَرُ",9,"ر",1,0],["وَبادِل بِهِ مِن قَومِ بَضعَةَ مِثلَهُ","أَباً شَرَّ ذي نَعلَينِ أَو غَيرِ مُنعَلِ",10,"ل",1,0],["وبادر فإن اليوم صاف من القذى","ويا رب يوم كدرته النوائب",11,"ب",1,0],["وبادِرْ إلى الرَّاحِ التي أنتَ خُلُّها","فقد قامَ ساقينا الأَغَرُّ يُديرُها",12,"ر",3,0],["وَبادي مَواعيدٍ يَعودُ بِمِثلِها","مَتى يُصدِرِ المَوعودَ بِالنُجحِ يورِدِ",13,"د",1,0],["وَبادِر غَيرَ مَأمورٍ","وَكُن لِلهَمِّ ذا مَقتِ",14,"ت",1,0],["وبادرتِ الإقدام منهم بمقدم","فكم خَبَرٍ عنها يصدِّقه الخبرُ",15,"ر",1,0],["وبادرْ ولا تهمل سُرَى العيس إنّها","لنا خببٌ في النُّجْح ليسَ يخيبُ",16,"ب",1,0],["وَبادَهُوا أَهلَ دِينِ اللَهِ وَاِهتَضَمُوا","حُقُوقَهُم بِالتَّمادِي شَرَّ مُهتَضَمِ",17,"م",1,0],["وَبادِر بِلَيلى أَوبَةَ الرَكبِ إِنَّهُم","مَتى يَرجِعوا يَحرُم عَلَيكَ لِمامُها",18,"م",3,0],["وَبادية الثَديَينِ أَخلَقَ ثَوبُها","وَأَبلاهُ بَعد الحَولِ حَولٌ مُجرَّمُ",19,"م",1,0],["وبادرها الميامينُ الكرامُ","مَقامٌ ما يُطاوله مَقامُ",20,"م",1,0],["وَبادِر بَوادي السَمِّ إِن كُنتَ راقِياً","وَعاجِل رُقوعَ الفَتقِ إِن كُنتَ راقِعا",21,"ع",2,0],["وَبادَرَت مِصرُ إِلى رِضائِهِ","تَنتَظِرُ الإِصعاقَ مِن سَمائِهِ",22,"ه",1,0],["وبادَرَ الحَزْمَ حتى قامَ هاجِسُهُ","يَقْضي له بَحْثَ أمْرٍ غيرِ مَقضيّ",23,"ي",1,0],["وَبادَرَ نَحوَ البابِ سَعياً مُلَبِّياً","لَهُ طَرَبٌ بِالزائِرينَ عَجيبُ",24,"ب",1,0],["وَبادِر بَقايا اللَيلِ يَبلُغكَ سُكرُهُ","يُحَدِّثُ مَن لاقى الصَباحَ بِهِ عَنكا",25,"ك",2,0],["وَبادِر بِالصَبوحِ فَإِنَّ فيهِ","شِفاءَ السَقمِ لِلرَجُلِ السَقيمِ",26,"م",1,0],["وَبادَ لِلرومِ أُسرَةٌ عَجَبٌ","تُعرَفُ في وُلدِها شَناشِنُها",27,"ن",3,0],["وبادرتْ نحوكَ الأبصارُ واكتحلتْ","بحسنِ يوسُفَ في محرابِ داودِ",28,"د",1,0],["وَبادَرتُ الفَوارِسَ وَهيَ تَجري","بِطَعنٍ في النُحورِ وَفي التَراقي",29,"ق",2,0],["وبادر ولا تمهل سُرى العيس إنها","لنا خيبٌ في النجح ليس يخيب",30,"ب",1,0],["وباده لطف الله من يمن أحمد","ببرد على عري الرّجاء  قشيب",31,"ب",1,0],["وبادر إلى الخيراتِ من كل وجهةٍ","وكن كيِّساً تُسْدَى إليك العَوَارِفُ",32,"ف",1,0],["وبَادِر لِرَقعِ الخَرقِ قَبل إتِّسَاعِهِ","فَقَد كَانَ صَعباً رَقعُهُ بَعدَمَا اتَّسَع",33,"ع",1,0],["وبادر ثُمَّ بادر ثم بادر","إلى ملك زيارته دمام",34,"م",1,0],["وبادر قبلَ هَولٍ ما","له رأسٌ ولا ذنب",35,"ب",1,0],["وَبادِر إِلى اللَّذّاتِ مِن قَبلِ حِليَةٍ","تَصُدُّ لَها عَنكَ العُيونُ اللَوامِحُ",36,"ح",1,0],["وبادرةٍ للشيبِ بادرتُ قَصَّها","لآرفعَ بادِى خَيْطِها وهْو ينزلُ",37,"ل",1,1],["وبادْر بجودك قبلَ السؤال","بلا مِنةٍ ولْيَكُنْ في اكتِتام",38,"م",1,0],["وبادر ب لم أَدْرِ عندَ السؤال","إذا ما جهلتَ بغير احْتِشام",38,"م",1,0],["وبادر في المكارم والمعالي","فإن المجد من خلق الملوك",39,"ك",1,0],["وبادر به قبل المنيّة لا تكن","لدى غفلة فالموت لا بدّ واقع",40,"ع",1,0],["وبادر بتقريب الدقائق ترتقي","علا درج مدّ الحبيب بها باعه",41,"ع",2,0],["وَبادِرني بِها وَالكَأسُ مَلأى","وَلا تَخلِط حَراماً بِالحَلالِ",42,"ل",1,0],["وبادر لا تسوفنا فبرٌ","نعاجله دواءٌ من طبيب",43,"ب",1,0],["وبادرْ لذاك الركبِ تلف أَمامه","سراجاً إذا ما الليلُ عَسْعَسَ ساجيا",44,"ي",2,0],["وبادر بافشاء السلام لصاحب","وخاطب بايجاز الكلام وتبيان",45,"ن",1,0],["وبادر بشغل الخلق في كل حالة","وفض كتاب أو ملاقاة ضيفان",45,"ن",1,0],["وَبادرَ العالم العلويّ طاعتهُ","فالشمسُ واقفةٌ والبدرُ منقسمُ",46,"م",1,0],["وَبادرةٌ في راحَةِ الرأي قودها","وَحلمٌ به يُستَجمَعُ العلمُ والنصرُ",47,"ر",1,0],["وَبادِر بِالإِنابَةِ قَبلَ مَوتٍ","عَلى ما فيكَ مِن عِظَمِ الجُناحِ",48,"ح",1,0],["وباد الجسم يا ليلى","وساءت في الهوى حالي",49,"ي",1,0],["وَبِإدْراجِها جَوَاهِرَ جَلَّتْ","عَنْ دُسُوتِ الوَرَّاق والأَدْراجِ",50,"ج",1,0],["وَبادَهني دَهري بِكُل بَليةٍ","فَلم يَكُ فيها كَالتَفَرّق مُهلك",51,"ك",1,0],["وبادِرْ بحظِّكَ قبلَ الفَواتِ","وسارِعْ إلى العَملِ الأفضلِ",52,"ل",1,0],["وبادرْتُ اعتِناق البد","رِ من ليلي إلى الفَجْرِ",53,"ر",1,0],["وبادِهُ صارفِ الدهر بالعَزمةِ التي","خواطرُه عن حلِّها تتبلّدُ",54,"د",1,0],["وبادرتهم من أوْجِ مجدكَ طالعاً","تُحاذرُ تضْجيعاً وتأبى تَلَوُّما",55,"م",2,0],["وبادر في الرياض لقطف زهر","فإن العود أصبح في اخضرار",56,"ر",1,0],["وبادِرْ بِتَقْطيعِ الرِّباقِ وحَلِّها","وتَفْكِيكِ غِلٍّ للإسارِ مُشَدِّدا",57,"د",2,0],["وبادهَنْجٍ عَلاَ بِنَاءً","لكنَّه قد هَوى هواءَ",58,"ا",2,1],["وباديةٍ للحُسْن أَما عقيقها","فخدٌّ وأَمَّا الصُّدْغُ فيه فَمُنحَنَى",59,"ن",2,0],["وبادرْ نحو رَبْوتِها ففيها","إِذا واجهتها بُرْءُ السقيم",60,"م",1,0],["وبادر الراح من راحاتها فلقد","حيا بها الحيا الأحياء من إضم",61,"م",1,0],["وَبادرا بمتابٍ عَن مَلامةِ مَن","يَهوى المِلاح وَمَن يَصبو لغزلان",62,"ن",1,0],["وَبادرت مضمار الحَماسة وَالثَنا","بِسابق فكر في المَدائح سامي",63,"م",2,0],["وَبادر إِلى ما فيهِ لِلنَفس نُزهة","بِرَوض تَهانٍ يَزدَهي بِنبات",64,"ت",1,0],["وَبادَرتَ المَكارِم تقتَنيها","وَلِلخَيرات إِنَّ لَكَ اِنتِهازا",65,"ز",2,0],["وبادِرْ زَمانَ الحُكْم من قبل فوتِه","فما كلُّ وقتٍ أنتَ تَقْضِي وتَحْكُمُ",66,"م",1,0],["وبادِرْ نَحْوَ طاعَتِهِ بِعَزْمٍ","فَما تَدري مَتى يُمْضَى بعُمْرِكْ",67,"ك",1,0],["وبادرِ العيشَ واغتَنِمهُ","قبلَ اختطافٍ مِنَ المنونِ",68,"ن",1,0],["وبادرْ شَقَّ حافِرهِ","وسيِّبْهُ معَ البَقَر",69,"ر",1,0],["وَبادَر في ذَقنِهِ حَلقَها","وَقَد رامَ في العِشقِ تَركَ اِستِتارْ",70,"ر",1,0],["وَبادِروا السَّيرَ مِن يافا وَقَد قَرُبَت","آجالُهم وَلَها قَد حَلَّ تَأجيلُ",71,"ل",1,0],["وبادين والأبطال حشو دروعها","لتخفي فتبديها البوارق بالخطف",72,"ف",1,0],["وبادروا وامحضُوهُ","نصحيةً تصلحُ البالْ",73,"ل",1,0],["وبادرْ وإن قال الحسودُ مقالةً","فدعْها وخذْها بالتي هيَ أرفَق",74,"ق",1,0],["وبادرْه بالضرب الشديد فإنهم","حميرُ أذىً والضربْ حسنُ اعتبارها",75,"ر",3,0],["وبادر فإن الوقت ضاق على الونا","وصم فسكيت الرهان المذبذب",76,"ب",1,0],["وبادٍ عن نواجذه مِفر","كررت وراءه والقوم قاموا",77,"م",3,0],["وبآدم وبشيت والأسباط","باليسع الرضى والإشراق والأغلاس",78,"س",1,0],["وَبادر صَلاة الليل قَبل انبِلاجه","فَقَد أسمع الداعي وَأَبكى المذكر",79,"ر",1,0],["وبادروا يا ندامى للصفا وردوا","موارداً نزهت عن طرد كل شقا",80,"ق",2,0],["وبادِرْ صالحُ الأَعمالِ واعْجَلْ","وصِلْ فيها رَواحَكَ بالغُدوِّ",81,"و",1,0],["وبادر تصاريف الزمان فانما","تشاهده فيها اعتبار لمن عقل",82,"ل",1,0],["وبادر إلى زاد المعاد الذي هو التقى واترك","الاعراض عن ذي الجلل جل",83,"ل",1,0],["وبادر إليه قبل حينك ياتين","فان