{"poems":[[53,"إذا احتبى بالعشب الوادي","https://www.aldiwan.net/poem30630.html","السريع"],[55,"كأني لم أكن شجنا لفوز","https://www.aldiwan.net/poem26188.html","الوافر"],[71,"صليل المواضي واهتزاز القنا السمر","https://www.aldiwan.net/poem4024.html","الطويل"],[35,"وإني لأرعى قومها من جلالها","https://www.aldiwan.net/poem39158.html","الطويل"],[83,"هنيئا هنيئا لا نفاد لعده","https://www.aldiwan.net/poem54317.html","الطويل"],[27,"ألا حي ربع المنزل المتقادم","https://www.aldiwan.net/poem4453.html","الطويل"],[27,"لمن رسم دار هم أن يتغيرا","https://www.aldiwan.net/poem5761.html","الطويل"],[72,"أودت فعالك يا أسما بأحشائي","https://www.aldiwan.net/poem18168.html","البسيط"],[72,"يا طالب الجود لا تتعب أمانيكا","https://www.aldiwan.net/poem19443.html","البسيط"],[72,"دعوني لذكرى حسنه أقتضي العذلا","https://www.aldiwan.net/poem20545.html","الطويل"],[51,"وما الفقر عيبا ما تجمل أهله","https://www.aldiwan.net/poem8133.html","الطويل"],[51,"أسالم قد سلمت من العيوب","https://www.aldiwan.net/poem8313.html","الوافر"],[51,"أبى القلب إلا وجده برخاص","https://www.aldiwan.net/poem64933.html","الطويل"],[29,"عفا الجو من سلمى فبادت رسومها","https://www.aldiwan.net/poem6053.html","الطويل"],[29,"ألا يا إسلمي بالسعد يا أخت دارم","https://www.aldiwan.net/poem6171.html","الطويل"],[70,"وكم بائع دينا بدنيا يرومها","https://www.aldiwan.net/poem42668.html","الطويل"],[70,"كلفت بشمس لا ترى الشمس وجهها","https://www.aldiwan.net/poem43021.html","الطويل"],[32,"ألا هل لعهد من بثينة قد خلا","https://www.aldiwan.net/poem27711.html","الطويل"],[85,"سلو قلبي غداة سلا وثابا","https://www.aldiwan.net/poem63783.html","الوافر"],[43,"حشاشة نفس ودعت يوم ودعوا","https://www.aldiwan.net/poem9720.html","الطويل"],[43,"فؤاد ما تسليه المدام","https://www.aldiwan.net/poem10538.html","الوافر"],[45,"قليل لها أني بها مغرم صب","https://www.aldiwan.net/poem10656.html","الطويل"],[45,"وراءك عني يا عذول الأشايب","https://www.aldiwan.net/poem11493.html","الطويل"],[61,"للخالديين جمال منظر","https://www.aldiwan.net/poem51665.html","الرجز"],[61,"شفاه قربا وقد أشفى على العطب","https://www.aldiwan.net/poem51799.html","البسيط"],[49,"ألم يك في وجدي وبرح تلددي","https://www.aldiwan.net/poem63543.html","البسيط"],[44,"متى أنت عن ذهلية الحي ذاهل","https://www.aldiwan.net/poem30372.html","الطويل"],[69,"تخاطبني بلا كرم وحلم","https://www.aldiwan.net/poem28730.html","الوافر"],[69,"علا لك ذكر لا يشابهه ذكر","https://www.aldiwan.net/poem28801.html","الطويل"],[69,"عثا في عرضه قوم سلاط","https://www.aldiwan.net/poem28860.html","الوافر"],[69,"تصوفت لما أن تصونت سيرة","https://www.aldiwan.net/poem29235.html","الطويل"],[75,"تظلم منا الحب والحب ظالم","https://www.aldiwan.net/poem69037.html","الطويل"],[75,"تنبأ المتنبي فيكم عصرا","https://www.aldiwan.net/poem69075.html","البسيط"],[48,"قولوا لمن قد تنفر","https://www.aldiwan.net/poem66288.html","المجتث"],[46,"نقمت الرضى حتى على ضاحك المزن","https://www.aldiwan.net/poem23626.html","الطويل"],[46,"سمعت نعيها صما صمام","https://www.aldiwan.net/poem23631.html","الكامل"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140816",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23993","الطويل"],[106,"سلاح غاندي","https://www.poetsgate.com/ViewPoem.aspx?id=179409",""],[90,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[94,"النبع المسحور","https://www.poetsgate.com/ViewPoem.aspx?id=15631",""],[96,"معرض الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66397&r=&rc=73",""],[121,"ألا عم صباحاً أيها الربع منعما","https://www.aldiwan.net/poem23818.html","الطويل"],[135,"قد بلغتني دعوة","https://www.aldiwan.net/poem49070.html","مجزوء الرجز"],[142,"ليحيى بن عبد الله عرس كريمة","https://www.aldiwan.net/poem58333.html","الطويل"],[143,"لكم أن تجوروا معرِضين وتغضبوا","https://www.aldiwan.net/poem11720.html","الطويل"],[143,"شفاء الهدى يا سيفه العضب أن تشفا","https://www.aldiwan.net/poem11779.html","الطويل"],[157,"تقبل الله منا ومنكم","https://www.aldiwan.net/poem23649.html","مجزوء الرجز"],[164,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[185,"لعل اعترافي باقترافي شافع","https://www.aldiwan.net/poem14578.html","الطويل"],[185,"إذا شرفت نفس الفتى عافت الذلا","https://www.aldiwan.net/poem14631.html","الطويل"],[186,"إذا ابن جميل مشى خلتنا","https://www.aldiwan.net/poem43437.html","المتقارب"],[186,"قالوا أتى العيد قلت العيد عادته","https://www.aldiwan.net/poem43794.html","البسيط"],[189,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[270,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[279,"أيحسن بعد ضنك حسن ظني","https://www.aldiwan.net/poem2631.html","الوافر"],[282,"وبالزبداني الكروم كثيرة","https://www.aldiwan.net/poem32431.html","الطويل"],[305,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[305,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[309,"فما ساءني شيء كما ساءني أخي","https://www.aldiwan.net/poem50281.html","الطويل"],[364,"حيث انتهيت من الهجران بي فقف","https://www.aldiwan.net/poem60841.html","البسيط"],[366,"أأحبابنا هل تسمعون على النوى","https://www.aldiwan.net/poem17854.html","الطويل"],[377,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[406,"هل الوجد إلا أن تلوح خيامها","https://www.aldiwan.net/poem50126.html","الطويل"],[409,"أظن العدا أن ارتحالي ضائري","https://www.aldiwan.net/poem32201.html","الطويل"],[409,"يلط بالدين من مولاه مسلمه","https://www.aldiwan.net/poem32251.html","البسيط"],[416,"تبين حق للعباد وباطل","https://www.aldiwan.net/poem53998.html","الطويل"],[416,"يمينا برب النجم والنجم إذ يسري","https://www.aldiwan.net/poem54085.html","الطويل"],[432,"بك الإسلام قد لبس الشبابا","https://www.aldiwan.net/poem12461.html","الوافر"],[432,"أي فؤاد فيك لم يكلف","https://www.aldiwan.net/poem12670.html","السريع"],[432,"كم نابل في طرفيك البابلي","https://www.aldiwan.net/poem12697.html","السريع"],[432,"حيث التفت فكثبان وقضبان","https://www.aldiwan.net/poem12748.html","البسيط"],[449,"صباحك عيد مشرف","https://www.aldiwan.net/poem974.html",""],[458,"سقى زمنا ببابل عقربي","https://www.aldiwan.net/poem56146.html","الوافر"],[458,"ألا من مبلغ أسدا رسولا","https://www.aldiwan.net/poem56278.html","الوافر"],[464,"نعم هذه آثارهم والمنازل","https://www.aldiwan.net/poem3164.html","عموديه"],[500,"من كان عبدا لقوم فليوف بهم","https://www.aldiwan.net/poem38072.html","البسيط"],[515,"رجونا قطع هجرك بالوصال","https://www.aldiwan.net/poem12224.html","الوافر"],[515,"ولاؤك مفروض على كل مسلم","https://www.aldiwan.net/poem12246.html","الطويل"],[529,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[553,"أحب الريح إن هبت شمالا","https://www.aldiwan.net/poem68381.html","الوافر"],[559,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[562,"هوى في القلب يعذب وهو داء","https://www.aldiwan.net/poem52983.html","الوافر"],[567,"أخ لي كنت أغبط باعتقاده","https://www.aldiwan.net/poem69712.html","الكامل"],[575,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"]],"verses":[["وَلَو حَسَدتُ الفَضلَ في أَهلِهِ","حَسَدتُ آبائي وَأَجدادي",0,"ي",1,0],["وَلَو حُدِّثتُم عَني وَعَنها","عَلِمتُم أَنَّ قِصَّتَنا تَطولُ",1,"ل",1,0],["وَلَو حاوَلَ المِريخُ في الأُفقِ مَنعَها","لَخَيَّمَ ما بَينَ النَعائِمِ وَالغَفرِ",2,"ر",1,0],["وَلو حارَبوا قومي لَكُنتُ لِقومِها","صَديقًا وَلَم أَحمِل عَلى قَومِها حِقدي",3,"ي",1,0],["ولوَّحتِ الأعلامُ فيها بنصره","كما لوَّح الصبح المبين ببندِه",4,"د",2,0],["وَلَو حَبلَ تَيمِيٍّ تَناوَلَ جارُكُم","لَما كانَ عاراً ذِكرُهُ في المَواسِمِ",5,"م",1,0],["وَلَو حَلَّ فينا عايَنَ القَومُ دونَهُ","عَوابِسَ يَعلِكنَ الشَكيمَ وَضُمَّرا",6,"ر",2,0],["ولو حمى حملَ الأبراجِ دَعْ حملاً","يومَ الهباءة لم يقصدْ بدهياء",7,"ا",2,0],["ولو حمى المرءَ من موت صنائعه","لأقبلت من فجاج الأرض تحميكا",8,"ك",2,0],["ولو حلَّ بي طيفاً وللراح سوْرَةٌ","بعقليَ لم أسلك به غير ما حلاَّ",9,"ل",2,0],["ولو حُظَّ أضحى مالُه من أمامه","وِقاءً وأضحى عِرضُه من ورائِهِ",10,"ا",3,0],["ولو حيَّتْ بريَّا الروض أنفي","ولو جاءت بكل حَياً سَكوبِ",11,"ب",1,0],["ولو حارب الدهرَ النساءُ وكِدنه","لأصبح مغلوباً أسيرَ عِقَاص",12,"ص",1,0],["وَلَو حَمَّلَتني السِرَّ سَلمى حَمَلتُهُ","وَهَل يَحمِلُ الأَسرارَ إِلّا كَتومُها",13,"م",3,0],["وَلَو حَمَّلَتني السِرَّ دَوسَرُ لَم تُضِع","مَقالَةَ ذي نُصحٍ وَلِلسِرِّ كاتِمِ",14,"م",1,0],["وَلو حَصَلَت ما فازَ مِنها بِطائِلٍ","وَأَصبَحَ مَفتوناً بِها وَهوَ مَغبونُ",15,"ن",1,0],["وَلَو حَمَلَت عَنّي الرِياحُ تَحِيَّةً","لَما نَفَذَت بَينَ القَنا وَالقَواضِبِ",16,"ب",1,0],["وَلَو حاوَلت هجرانَها النفسُ لَم يَعُد","إِلَى سلوَةٍ بَل زادَ وَجداً عَلى وَجدِ",17,"د",1,0],["وَلَو حَفَظوا سَبيلَكَ كان نوراً","وَكانَ مِنَ النُحوسِ لَهُم حِجابا",18,"ب",2,0],["وَلَو حُمِّلَت صُمُّ الجِبالِ الَّذي بِنا","غَداةَ اِفتَرَقنا أَو شَكَت تَتَصَدَّعُ",19,"ع",1,0],["وَلَو حيزَ الحِفاظُ بِغَيرِ عَقلٍ","تَجَنَّبَ عُنقَ صَيقَلِهِ الحُسامُ",20,"م",1,0],["وَلَو حَضَرَتهُ أُنثَياهُ استَقَلَّتا","إِلى كُليَتَيهِ حينَ أَزعَجَهُ الرُعبُ",21,"ب",1,0],["وَلَو حَرَمَ اللَهُ المُعَظَّمَ قَدرُهُ","وَكانوا بِهِ حُكّامَ تِلكَ الأَخاشِبِ",22,"ب",1,0],["ولو حَكَت عِرْسَ الضَّرير الأبخَرِ","وزوجةُ ابنِ العَصَبِ المحكَّر",23,"ر",1,0],["ولو حَمْدتُ بها الأيامَ قلتُ سقَى","ربوعَها أحمدُ المحمودُ في النُّوبِ",24,"ب",1,0],["وَلَو حَرِجَت مِمّا أَتَتهُ لَراعَها","مُصابُ رَمِيٍّ عَن جَوى الحُبِّ مُقصَدِ",25,"د",1,0],["وَلَو حارَدَت شَولٌ عَذَرتُ لِقاحَها","وَلَكِن حُرِمتُ الدَرَّ وَالضَرعُ حافِلُ",26,"ل",1,0],["ولو حَسُنَ الجوابُ لكانَ عندي","جوابٌ يسمعُ الصخرَ الأصما",27,"م",2,0],["ولو حلفوا أنَّا سننزعُ أختَها","لما وجبيتْ كفارةٌ ربَّما برُّوا",28,"ر",3,0],["ولو حضروهُ حينَ قضى لألفَوا","ملائكةَ النعيمِ به أحاطوا",29,"ط",3,0],["ولو حضرَ الملوكُ سجّادةٌ لكمْ","قدِ افْتُرِشَتْ صلى عليها وسلّما",30,"م",2,0],["ولو حاربتْكَ الشمسُ دونَ لقائِهم","لأعْجَلَها جُنْدٌ من اللّهِ هازم",31,"م",1,0],["ولو حَرصْتُم على إحياء مُهْجَتِهِ","كما حرَصْتُم على ديوانه نُشِرا",32,"ر",2,0],["ولو حملتَ لقتلي","عَضب الشفار مذكّر",33,"ر",1,0],["ولو حَفَرُوا في دُرّةٍ ما رَضِيتُها","لجِسْمِكَ إبْقاءً عَلَيْهِ منَ الدّفنِ",34,"ن",1,0],["ولو حَدّوا الفِراقَ بعُمْرِ نَسْرٍ","طَفِقْتُ أعُدّ أعْمَارَ السِّمامِ",35,"م",1,0],["وَلَوحُ ذِراعَينِ في بِركَةٍ","إِلى جُؤجُؤ رَهِلِ المَنكِبِ",36,"ب",1,0],["ولو حملت صم الجبال الذب بنا","غداة افترقنا أوشكت تتصدع",37,"ع",1,0],["ولوحاتُهُ صُوَرُ العارياتِ","إذا مَزَّقَ الفنُّ عنها القِناعْ",38,"ع",1,0],["ولو حاولوه في سواكمْ لصادفوا","مناكبَ دفع دون ذاك مدالظا",39,"ظ",2,0],["ولوَّح وهْو مسجون","بسيف الجوع من بعد",40,"د",1,0],["وِلو حُمَّ لي أنْ أحكمَ الناسَ ساعةً","وأن أتوَلى فيهُمُ النهىَ والأمرا",41,"ر",2,0],["ولوّحت من بعض أفيائنا","كفّان بالحنّاء مخضوبتان",42,"ن",1,0],["ولوحاته صور العاريات","إذا مزّق افنذ عنها القناع",43,"ع",1,0],["ولوحٍ وعرشٍ ثم كرس وحَجْبِهِمْ","وبَحْرٌ لأفلاكٍ فعنهم تقدّما",44,"م",2,0],["ولو حكت أنغامه","صوت صفير البلبلِ",45,"ل",1,0],["ولو حَمَل الثَّورُ السمائِى قَرنَهُ","لخرَّ من الأفلاكِ بالأرض هابطا",46,"ط",2,0],["وَلَو حِدتُ عَنهُ دَلَّةً وَاِستَمالَني","كَريمٌ مُرَجّىً أَو هُمامٌ مُحَجَّبُ",47,"ب",1,0],["وَلَو حَزَموا أَعطَوكَ شَطرَ الَّذي حَوَوا","فَذَلِكَ فَوقَ النِصفِ أَن تَأخُذَ النِصفا",48,"ف",2,0],["وَلُوحِظَتْ سِمَاتُهَا","مِثْلُ السَّنَا وَعَبَّرَتْ",49,"ت",1,0],["وَلَو حَمى المقدارُ عَنهُ مُهجَةً","لَرامَها أَو يَستَبيحَ ما حَمى",50,"ا",1,0],["ولو حاد قلبي عنك مِثْقال ذَرّةٍ","لأَبْعَدَه عني من النَّخْرِ دافع",51,"ع",1,0],["ولو حاز مُلكَ الأرضِ والعيشَ خالدا","بذلَّةِ يومٍ واحد ترك الكُلاّ",52,"ل",2,0],["ولو حملت كفّه خردلا","لما ضاع من كفّه خردله",53,"ل",2,0],["ولو حللت بكينائي لكان على","ترك الزيارة عندي غير معذور",54,"ر",1,0],["وَلَو حلَّ مَدحي للنبيّ بسفرهِ","لَلوّثهُ تبّاً لهُ وله سِفرا",55,"ر",2,0],["ولو حَدَست أجفانُهم وقُلوبُهم","لكانَ وربِّ الكعبةِ الحدسُ أيسرا",56,"ر",2,0],["ولو حكم الهوى فينا بعدلٍ","لكنتَ أَحَقَّ بالتعذيب مِنّي",57,"ي",1,0],["وَلَو حَفِظوا أَعراضَهُم مِثلَ حفظِها","لَكانوا لَعَمرُ اللهِ غَيرَ لِئامِ",58,"م",1,0],["وَلِوحدةِ الحقّ الّتي هي مركزٌ","بِسهامِ أغراضِ المظاهر ينزعُ",59,"ع",1,0],["وَلَو حلّ فيهِ اللّيثُ في درعِ زبرةٍ","تَضاءلَ وَاِنقدّت مفاضتهُ عَبطا",60,"ط",2,0],["وَلو حلَّه الرامي لَطاشَت سهامهُ","وَلو طائرُ النسرين حامَ بها اِرتطّا",60,"ط",2,0],["وَلَو حاوَلَت فيهِ الفوارسُ جولةً","لَحامَت وَلَم تقحم به شُهبها ثَمطا",60,"ط",2,0],["وَلَو حُزَّ أَنفي قَبلَ ذَلِكَ حَزَّةً","بِموسى لَما أَلقَيتُ لِلصُلحِ تابِعا",61,"ع",2,0],["ولو حلَفْتُ يَميناً أنَّ عِدَّتَه","من الحميرِ لَما استَثنَيْتُ من حَلِفي",62,"ف",2,0],["وَلَو حَمَلَت ريحُ الشَمالِ إِلَيكُمُ","كَلاماً طَلَبنا مِثلَهُ في الجَنائِبِ",63,"ب",1,0],["ولو حملوا من تربها في رحالهم","لما ضل من يَهدي ولو ظلَّ يَعسِف",64,"ف",1,0],["ولو حل يوسفْ عزِّها من مُعِزِّها","لما شذَّ عنها وهو في الحق يوسف",64,"ف",1,0],["وَلوَ حُزِمَت من ضُمرها بِحُذامِها","لَجالَت عَلى أَوساطِهِنَّ حُذامُها",65,"م",3,0],["ولو حكَمَتْ بيني وبَينهُم الظُّبَا","رضيتُ بما تَقضي المهنَّدَةُ البُتْرُ",66,"ر",1,0],["ولو حلَلْتَ بِوادِينا على وجَلٍ","أيْقَنْتَ من غيرِ شكٍ أنَّه الحَرمُ",67,"م",1,0],["ولو حكموا من قبلها في جنونه","وعاقَتْه عما كانَ منه السلاسل",68,"ل",1,0],["ولو حُصِدَتْ أيديك فينا حصرْتها","ولكنها ممَّا يجلُّ عن الحَصْرِ",69,"ر",1,0],["ولو حيّا محيّاها بنورٍ","لما كان الظلامُ لها حِجابا",70,"ب",2,0],["ولو حَمى ذا الظِلْفِ أحجامه","لم يقدِم الأغلبُ ذو المِخْصَفِ",71,"ف",1,0],["ولو حَواها لم يَقُلْ سائلاً","ماذا تردّون على السائِلِ",72,"ل",1,0],["ولو حوى البدرُ جُزْءاً من محاسنِه","لم يعترضْ لكمالِ البدرِ نُقصانُ",73,"ن",1,0],["ولو حكم العقل اللبيب بدت له","مصائب عقباها لظى ووقود",74,"د",1,0],["ولو حامى كمال الملك عني","رعيتُ الخِصبَ في دَعةٍ وخفضِ",75,"ض",1,0],["ولو حمَّادُ يزقو لي صداه","لأُكرِمَ ذلك الجسدُ التريبُ",76,"ب",1,0],["ولو حلت عن عهد هابك سالف","لبانت وعاليها بسخطك سافل",77,"ل",1,0],["ولوحِ أَحكامِهِمْ يَفْتَرُّ عن حِكَمٍ","بديعَةٍ تستفِزُّ العقلَ للعَجَبِ",78,"ب",1,0],["ولو حمل الزمان ثقيل همي","على متنيه ضج من الكلال",79,"ل",1,0],["ولو حفظوا فيك الوصية لم يكن","لغيرك في أقطارها دور درهم",80,"م",1,0],["ولِوَحْدَةٍ جَعَلُوا المثَاني مُؤْنِسا","واللَّحْنَ عِنْدَ الذّكْرِ منْ إعْرابِهِ",81,"ب",2,0],["وَلَو حَمَّلتُ نَفسي الصَبرَ عَنهُ","لَكانَ الصَبرُ في قَلبي غَريبا",82,"ب",2,0],["ولوْحاً إِذا لاحَت سُطورُ كَيانِنا","له فيه وهو اللَّوْح والقلم الأدنى",83,"ن",2,0],["ولو حسُنت بعين الكُلِّ لَيْلَى","لَجُنَّ الكُلُّ واشْتَملَ البَلاءُ",84,"ا",2,0],["وَلَوْ حَاوِلْتَ أَنْ تُزْرِي بِبَدْرِ","طَلَبْتَ لَهُ الْمَعَايِبَ مِنْ سَوَادِهْ",85,"د",2,0],["ولو حلَّ من رَعْدِها خاطِبٌ","لَوافَاهُ مِن سَرْوِها مِنْبَرُ",86,"ر",1,0]]}