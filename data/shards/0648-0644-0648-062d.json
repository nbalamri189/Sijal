َخَيَّمَ ما بَينَ النَعائِمِ وَالغَفرِ",2,"ر",1,0],["وَلو حارَبوا قومي لَكُنتُ لِقومِها","صَديقًا وَلَم أَحمِل عَلى قَومِها حِقدي",3,"ي",1,0],["ولوَّحتِ الأعلامُ فيها بنصره","كما لوَّح الصبح المبين ببندِه",4,"د",2,0],["وَلَو حَبلَ تَيمِيٍّ تَناوَلَ جارُكُم","لَما كانَ عاراً ذِكرُهُ في المَواسِمِ",5,"م",1,0],["وَلَو حَلَّ فينا عايَنَ القَومُ دونَهُ","عَوابِسَ يَعلِكنَ الشَكيمَ وَضُمَّرا",6,"ر",2,0],["ولو حمى حملَ الأبراجِ دَعْ حملاً","يومَ الهباءة لم يقصدْ بدهياء",7,"ا",2,0],["ولو حمى المرءَ من موت صنائعه","لأقبلت من فجاج الأرض تحميكا",8,"ك",2,0],["ولو حلَّ بي طيفاً وللراح سوْرَةٌ","بعقليَ لم أسلك به غير ما حلاَّ",9,"ل",2,0],["ولو حُظَّ أضحى مالُه من أمامه","وِقاءً وأضحى عِرضُه من ورائِهِ",10,"ا",3,0],["ولو حيَّتْ بريَّا الروض أنفي","ولو جاءت بكل حَياً سَكوبِ",11,"ب",1,0],["ولو حارب الدهرَ النساءُ وكِدنه","لأصبح مغلوباً أسيرَ عِقَاص",12,"ص",1,0],["وَلَو حَمَّلَتني السِرَّ سَلمى حَمَلتُهُ","وَهَل يَحمِلُ الأَسرارَ إِلّا كَتومُها",13,"م",3,0],["وَلَو حَمَّلَتني السِرَّ دَوسَرُ لَم تُضِع","مَقالَةَ ذي نُصحٍ وَلِلسِرِّ كاتِمِ",14,"م",1,0],["وَلو حَصَلَت ما فازَ مِنها بِطائِلٍ","وَأَصبَحَ مَفتوناً بِها وَهوَ مَغبونُ",15,"ن",1,0],["وَلَو حَمَلَت عَنّي الرِياحُ تَحِيَّةً","لَما نَفَذَت بَينَ القَنا وَالقَواضِبِ",16,"ب",1,0],["وَلَو حاوَلت هجرانَها النفسُ لَم يَعُد","إِلَى سلوَةٍ بَل زادَ وَجداً عَلى وَجدِ",17,"د",1,0],["وَلَو حَفَظوا سَبيلَكَ كان نوراً","وَكانَ مِنَ النُحوسِ لَهُم حِجابا",18,"ب",2,0],["وَلَو حُمِّلَت صُمُّ الجِبالِ الَّذي بِنا","غَداةَ اِفتَرَقنا أَو شَكَت تَتَصَدَّعُ",19,"ع",1,0],["وَلَو حيزَ الحِفاظُ بِغَيرِ عَقلٍ","تَجَنَّبَ عُنقَ صَيقَلِهِ الحُسامُ",20,"م",1,0],["وَلَو حَضَرَتهُ أُنثَياهُ استَقَلَّتا","إِلى كُليَتَيهِ حينَ أَزعَجَهُ الرُعبُ",21,"ب",1,0],["وَلَو حَرَمَ اللَهُ المُعَظَّمَ قَدرُهُ","وَكانوا بِهِ حُكّامَ تِلكَ الأَخاشِبِ",22,"ب",1,0],["ولو حَكَت عِرْسَ الضَّرير الأبخَرِ","وزوجةُ ابنِ العَصَبِ المحكَّر",23,"ر",1,0],["ولو حَمْدتُ بها الأيامَ قلتُ سقَى","ربوعَها أحمدُ المحمودُ في النُّوبِ",24,"ب",1,0],["وَلَو حَرِجَت مِمّا أَتَتهُ لَراعَها","مُصابُ رَمِيٍّ عَن جَوى الحُبِّ مُقصَدِ",25,"د",1,0],["وَلَو حارَدَت شَولٌ عَذَرتُ لِقاحَها","وَلَكِن حُرِمتُ الدَرَّ وَالضَرعُ حافِلُ",26,"ل",1,0],["ولو حَسُنَ الجوابُ لكانَ عندي","جوابٌ يسمعُ الصخرَ الأصما",27,"م",2,0],["ولو حلفوا أنَّا سننزعُ أختَها","لما وجبيتْ كفارةٌ ربَّما برُّوا",28,"ر",3,0],["ولو حضروهُ حينَ قضى لألفَوا","ملائكةَ النعيمِ به أحاطوا",29,"ط",3,0],["ولو حضرَ الملوكُ سجّادةٌ لكمْ","قدِ افْتُرِشَتْ صلى عليها وسلّما",30,"م",2,0],["ولو حاربتْكَ الشمسُ دونَ لقائِهم","لأعْجَلَها جُنْدٌ من اللّهِ هازم",31,"م",1,0],["ولو حَرصْتُم على إحياء مُهْجَتِهِ","كما حرَصْتُم على ديوانه نُشِرا",32,"ر",2,0],["ولو حملتَ لقتلي","عَضب الشفار مذكّر",33,"ر",1,0],["ولو حَفَرُوا في دُرّةٍ ما رَضِيتُها","لجِسْمِكَ إبْقاءً عَلَيْهِ منَ الدّفنِ",34,"ن",1,0],["ولو حَدّوا الفِراقَ بعُمْرِ نَسْرٍ","طَفِقْتُ أعُدّ أعْمَارَ السِّمامِ",35,"م",1,0],["وَلَوحُ ذِراعَينِ في بِركَةٍ","إِلى جُؤجُؤ رَهِلِ المَنكِبِ",36,"ب",1,0],["ولو حملت صم الجبال الذب بنا","غداة افترقنا أوشكت تتصدع",37,"ع",1,0],["ولوحاتُهُ صُوَرُ العارياتِ","إذا مَزَّقَ الفنُّ عنها القِناعْ",38,"ع",1,0],["ولو حاولوه في سواكمْ لصادفوا","مناكبَ دفع دون ذاك مدالظا",39,"ظ",2,0],["ولوَّح وهْو مسجون","بسيف الجوع من بعد",40,"د",1,0],["ولو حجزت بيني وبين صروفها","صروف لكان العزم لي في ضرابها",41,"ب",3,0],["ولو حاولت نفس عن الشر نزعة","تنازعها طبع هناك خؤور",42,"ر",1,0],["وِلو حُمَّ لي أنْ أحكمَ الناسَ ساعةً","وأن أتوَلى فيهُمُ النهىَ والأمرا",43,"ر",2,0],["ولوّحت من بعض أفيائنا","كفّان بالحنّاء مخضوبتان",44,"ن",1,0],["ولوحاته صور العاريات","إذا مزّق افنذ عنها القناع",45,"ع",1,0],["ولوحٍ وعرشٍ ثم كرس وحَجْبِهِمْ","وبَحْرٌ لأفلاكٍ فعنهم تقدّما",46,"م",2,0],["ولو حكت أنغامه","صوت صفير البلبلِ",47,"ل",1,0],["ولو حَمَل الثَّورُ السمائِى قَرنَهُ","لخرَّ من الأفلاكِ بالأرض هابطا",48,"ط",2,0],["وَلَو حِدتُ عَنهُ دَلَّةً وَاِستَمالَني","كَريمٌ مُرَجّىً أَو هُمامٌ مُحَجَّبُ",49,"ب",1,0],["وَلَو حَزَموا أَعطَوكَ شَطرَ الَّذي حَوَوا","فَذَلِكَ فَوقَ النِصفِ أَن تَأخُذَ النِصفا",50,"ف",2,0],["وَلُوحِظَتْ سِمَاتُهَا","مِثْلُ السَّنَا وَعَبَّرَتْ",51,"ت",1,0],["وَلَو حَمى المقدارُ عَنهُ مُهجَةً","لَرامَها أَو يَستَبيحَ ما حَمى",52,"ا",1,0],["ولو حاد قلبي عنك مِثْقال ذَرّةٍ","لأَبْعَدَه عني من النَّخْرِ دافع",53,"ع",1,0],["ولو حاز مُلكَ الأرضِ والعيشَ خالدا","بذلَّةِ يومٍ واحد ترك الكُلاّ",54,"ل",2,0],["ولو حملت كفّه خردلا","لما ضاع من كفّه خردله",55,"ل",2,0],["ولو حللت بكينائي لكان على","ترك الزيارة عندي غير معذور",56,"ر",1,0],["وَلَو حلَّ مَدحي للنبيّ بسفرهِ","لَلوّثهُ تبّاً لهُ وله سِفرا",57,"ر",2,0],["ولو حَدَست أجفانُهم وقُلوبُهم","لكانَ وربِّ الكعبةِ الحدسُ أيسرا",58,"ر",2,0],["ولو حكم الهوى فينا بعدلٍ","لكنتَ أَحَقَّ بالتعذيب مِنّي",59,"ن",2,0],["وَلَو حَفِظوا أَعراضَهُم مِثلَ حفظِها","لَكانوا لَعَمرُ اللهِ غَيرَ لِئامِ",60,"م",1,0],["وَلِوحدةِ الحقّ الّتي هي مركزٌ","بِسهامِ أغراضِ المظاهر ينزعُ",61,"ع",1,0],["وَلَو حلّ فيهِ اللّيثُ في درعِ زبرةٍ","تَضاءلَ وَاِنقدّت مفاضتهُ عَبطا",62,"ط",2,0],["وَلو حلَّه الرامي لَطاشَت سهامهُ","وَلو طائرُ النسرين حامَ بها اِرتطّا",62,"ط",2,0],["وَلَو حاوَلَت فيهِ الفوارسُ جولةً","لَحامَت وَلَم تقحم به شُهبها ثَمطا",62,"ط",2,0],["وَلَو حُزَّ أَنفي قَبلَ ذَلِكَ حَزَّةً","بِموسى لَما أَلقَيتُ لِلصُلحِ تابِعا",63,"ع",2,0],["ولو حلَفْتُ يَميناً أنَّ عِدَّتَه","من الحميرِ لَما استَثنَيْتُ من حَلِفي",64,"ف",2,0],["وَلَو حَمَلَت ريحُ الشَمالِ إِلَيكُمُ","كَلاماً طَلَبنا مِثلَهُ في الجَنائِبِ",65,"ب",1,0],["ولو حملوا من تربها في رحالهم","لما ضل من يَهدي ولو ظلَّ يَعسِف",66,"ف",1,0],["ولو حل يوسفْ عزِّها من مُعِزِّها","لما شذَّ عنها وهو في الحق يوسف",66,"ف",1,0],["وَلوَ حُزِمَت من ضُمرها بِحُذامِها","لَجالَت عَلى أَوساطِهِنَّ حُذامُها",67,"م",3,0],["ولو حكَمَتْ بيني وبَينهُم الظُّبَا","رضيتُ بما تَقضي المهنَّدَةُ البُتْرُ",68,"ر",1,0],["ولو حلَلْتَ بِوادِينا على وجَلٍ","أيْقَنْتَ من غيرِ شكٍ أنَّه الحَرمُ",69,"م",1,0],["ولو حكموا من قبلها في جنونه","وعاقَتْه عما كانَ منه السلاسل",70,"ل",1,0],["ولو حُصِدَتْ أيديك فينا حصرْتها","ولكنها ممَّا يجلُّ عن الحَصْرِ",71,"ر",1,0],["ولو حيّا محيّاها بنورٍ","لما كان الظلامُ لها حِجابا",72,"ب",2,0],["ولو حَمى ذا الظِلْفِ أحجامه","لم يق