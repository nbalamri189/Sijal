aspx?id=178195",""],[5650,"ما غيره نحب","https://www.poetsgate.com/ViewPoem.aspx?id=131225",""],[5660,"نسمه *من أجل مصر*","https://www.poetsgate.com/ViewPoem.aspx?id=24780",""],[5725,"يا نخلة البصرة","https://www.poetsgate.com/ViewPoem.aspx?id=210802",""],[5736,"ولدي","https://www.poetsgate.com/ViewPoem.aspx?id=203867",""],[5906,"يا عازف النّاي","https://www.poetsgate.com/ViewPoem.aspx?id=188074",""],[5933,"قال النبي مقالةً","https://www.poetsgate.com/ViewPoem.aspx?id=40707",""],[5956,"أقصوصة شاعر وحانوت","https://www.poetsgate.com/ViewPoem.aspx?id=193640",""],[6068,"فيسبوكْ -05-","https://www.poetsgate.com/ViewPoem.aspx?id=175932",""],[6070,"زكاة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=188817",""],[6093,"رمضانُ أقبل ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176206",""],[6102,"تحذير ..","https://www.poetsgate.com/ViewPoem.aspx?id=183311",""],[6102,"ثأر الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=183321",""],[5309,"إليكم في جليل الأمر يحتكم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573663",""]],"verses":[["فَرضٌ عَليَّ لِكُلِّ دارٍ وَقفَةٌ","تَقضي حُقوقَ الدارِ وَالأَجفانِ",0,"ن",1,0],["فرضت مواهبه وأرهف عزمه","فتوافق المفروض والمسنون",1,"ن",1,0],["فَرَضَ الخوفُ دمْعَهُ","لثرى الأرضِ مشربا",2,"ب",2,0],["فَرِضا البَعضِ فيهِ لِلبَعضِ سُخطٌ","وَرِضا الكُلِّ مَطلَبٌ لا يُنالُ",3,"ل",1,0],["فَرَضَ البِرَّ بِها فَرضُ حَكيم","فَإِذا ما زِدتَ فَاللَهُ كَريم",4,"م",1,0],["فرَضَت عليه المكرُماتُ فَرائضاً","للمَجدِ أدَّاها وزادَ نَوافِلا",5,"ل",2,0],["فَرضُ الإِمامَةِ لِي مِن بَعدِ أَحمَدِنا","كَالدَّلوِ عَلَقَّتِ التَكريبَ وَالوَذما",6,"م",2,1],["فَرضٌ عَلى الناسِ أَن يَتوبوا","لَكِنَّ تَركَ الذُنوبِ أَوجَب",7,"ب",1,1],["فَرضٌ عَلى أَسيافِهِ وَبَنانِهِ","بِالعَدِّ رَدَّدَهُ وَصَرفِ صُروفِ",8,"ف",1,0],["فَرَضيتُ ثُمَّ عَلِمتُ ما لَم يَصنَعوا","فَغَضِبتُ ثُمَّ رَضيتُ غَيرَ مُحابِ",9,"ب",1,0],["فَرَضَ الجَلاءَ عَلى العَدُوِّ فَما لَهُ","مُتَزَحزِحٌ عَنهُ وَلا مُتَقَلِّبُ",10,"ب",1,0],["فَرْضانِ من صوْمٍ وشُكرِ خليفةٍ","هذا بهذا عندنا مَقْرونُ",11,"ن",1,0],["فَرَضَعنا دُرَّ السُرورِ وَظَلنا","في أَمانٍ مِن طارِقِ الحِدثانِ",12,"ن",1,0],["فَرَض القوى على الضعيف رقابة","من ذا يكون على الرقيب رقيبا؟",13,"ب",2,0],["فرضاك زبدة قصده","ولقاك غاية ما تمنى",14,"ن",2,0],["فرضوا جميعاً بالقضا","والنارُ مأْوَى الجاحِدَهْ",15,"د",2,0],["فَرَضَ اللهُ أن تُعَظَّمَ تَعظي","مَاً وأن تُرتَضَى وأن لا تُبَاهَى",16,"ا",3,0],["فرضتم عليكم للمتيم سنة","تؤدّونها بعد الفراغِ من الفجرِ",17,"ر",1,1],["فرضْ على الصبر نفساً ما بنبعتها","في الخطب مهما غزا لينُ ولا قصفُ",18,"ف",1,0],["فرِضاك عَدْلٌ واصْطِناعك رحمةٌ","وسُطاك مَهْلكةٌ وعزمُك نار",19,"ر",1,0],["فرضت عليّ يا مولاي حجا","إلى البيت العتيق وفيه نور",20,"ر",1,1],["فَرُضتها حتّى أتت مطيعه","أَحكمتُ مدحهُ بها فاِستَحكما",21,"م",2,0],["فَرضهُ أيُّ نعمةٍ وأداءُ ال","فَرضِ أُخرى لا تُحصرُ الآلاءُ",22,"ا",2,0],["فَرض عَلى البَيت وَما فيه أَن","يَبقى عى مرضاتِها يسهرُ",23,"ر",1,0],["فرضٌ على كلّ ذي علم بلذّته","في مثل ذا اليوم لبسُ اللَّهو واللَّعب",24,"ب",1,0],["فَرَضَ الصَّلاةَ عَلَيهِ خَمساً أَصلُها","خَمسونَ وَهيَ الأَجرُ في الحُسبانِ",25,"ن",1,0],["فرضٌ على أهل الفضيلةِ حبُّها","في كلِّ نافحةٍ يُشمُّ وينشر",26,"ر",1,0],["فرضٌ على العربيّ بغضُكِ ما بدا","قوّادُ جَيشكِ بعدَ قوَّاديك",27,"ك",1,0],["فرض العمرة وَالحج لنا","وَصَلاة وَزَكاة وَصياما",28,"م",2,0],["فَرَضَ المَنسوخَ مِن آيِ النَدى","أَسَدُ الدينِ وَسَنّاهُ وَسَنّا",29,"ن",2,0],["فَرُضابُهُ العَسَلُ المُصَف","فى وَالشَرابُ السَلسَبيلُ",30,"ل",1,0],["فرضَّ منه الراسا","وفرَّق الأَضراسا",31,"س",2,0],["فَرضٌ عَلَيَّ عَزيزُ وُدِّكَ","فَلَقَد عَلِمتُ كَيانَ جَدِّكَ",32,"ك",1,1],["فَرُضوانُ الجَنانِ بِغَيرِ شِكٍّ","عَلى أَبوابِ مالِكِها طَريحُ",33,"ح",1,0],["فَرضُ المَحَبَّةِ وَدُّ شيعَةِ حُبِّكُم","عِندي وَسُنَّتُهُ قِلى العُذّالِ",34,"ل",1,1],["فَرَضَ الحبيب ُ دَلالَهُ وتَمَنَّعَ","وَأَبَى بغيرِ عذابِنَا أَنْ يَقْنعا",35,"ع",2,1],["فرض علينا حبهم للإيمان","أوثق عراه عندما يعدون",36,"ن",1,0],["فَرضٌ على كلّ الورَى","مِن والدٍ وَوَلَدِ",37,"د",1,0],["فرضوا وقد فرضوا اللهى حسن الثنا","وسموا وقد وسموا جباه الورد",38,"د",1,0],["فرِضَاكَ تأْميلي وقربُكَ هِمَّتِي","ونداكَ مَحْيائِي وحمدُكَ دَابِي",39,"ب",2,0],["فَرضاَ على الأدباءِ","اذلال المبايِعِ والمنيب",40,"ب",1,0],["فَرضَ الضريبةَ للسلامة من أذَّى","سُوَرَ التملق والتملقُ آسرُ",41,"ر",1,0],["فَرُضتُموني بألسن وبأخ","لاقٍ ليانٍ أصبحن لي لُجُما",42,"م",2,0],["فرضت صلاتك كالصّلاة","وحمدُ وافدك الإقامة",43,"م",2,0],["فرضيت عن نفسي بنفسي في الهوى","وكذاك يرضى من عراه تدله",44,"ل",2,0],["فرض على الأرواح اجلاله","التعظيم والتكريم والتبجيل",45,"ل",1,0],["فرض على الشعر أن يبدا بما يجب","من الهناء الذي وافى له رجب",46,"ب",1,1],["فَرُضِ النَّفْسِ إذا زادَ الهَوَى","فَهُوَ إن مَا رُضْتَها يَنْتَقِصُ",47,"ص",1,0],["فرضتنا فظهرنا","بك العراض الطوال",48,"ل",1,0],["فَرْضٌ كتسليمِ المُصِلِّي عِندَنا","إِهداءُ تَسليمٍ لهُ ودُعاءِ",49,"ا",2,0],["فَرَضينا فَمُت بِدائِكَ غَمّاً","لا تُميتَنَّ غَيرَكَ الأَدواءُ",50,"ا",2,0],["فرضٌ علينا ثياب الحزن نلبسها","على الحُسين اِبن طه سيّد الرسلِ",51,"ل",1,0],["فَرضٌ وَكُلُّ مُلُوكِ الأَرضِ نافِلَةٌ","إنَّ الفُرُوضَ لَها فَضلٌ عَلَى السُّنَنِ",52,"ن",1,0],["فَرضٌ على الخَلقِ حَجُّ بيتِك فالأ","مَّةُ مِن وارِدٍ ومِن صادِر",53,"ر",1,0],["فَرَضوا بآخرَ كان أقربَ منهمُ","داراً فمتّوا بالجِوارِ الأقربِ",54,"ب",1,0],["فرض على البالغ الغايات عالية","تكريم ما مرّ من بدءٍ وتمهيد",55,"د",1,0],["فَرَضِيَ التاجر بِالثَلاثَه","وَلَم يَكُن يَفطن لِلخَباثَه",56,"ه",1,0],["فَرَضْنَا عَلَيْهِمْ وَالْفُرُوضُ لَوَازِمُ","قَدُودُهُمُ لِلْقَدِّ بِالْبِيضِ وَالزَّحْفِ",57,"ف",1,0],["فرَضَ الواجِبُ من مَدمَعِهِ","في أَديمِ الخَدِّ خَدّاً إِذ سَكَب",58,"ب",1,0],["فرضوا دخول جهنم في قتله","عطشاً وشربهم الحميم الآني",59,"ن",2,0],["فَرُضْني بما يُرْضيكَ عَنّي مِنَ الأَذى","تَجِدْني شَكُوراً في المَحَبَّةِ صَبّارا",60,"ر",2,0],["فرضضن صدر هداية","هو مصدر الدين الحنيف",61,"ف",1,0],["فَرضٌ عَلَينا بِرُّنا أُمّاتِنا","وَعُقوقُهُنَّ مُحَرَّمٌ إِلّاكِ",62,"ك",1,0],["فرضٌ على اهلِ المقام العالي","قد صنتُ امكِ يوم راموها بشرّ",63,"ر",1,0],["فرضابه ورديْ الرويُّ وخدُّه","ورديْ الذكيُّ وثغرُه نوّاري",64,"ر",2,0],["فرضت على قلبي هواه وإنني","على سنة قد سنها لي أبي قبلي",65,"ل",2,0],["فُرِضَت عَلى الشَعبِ الأَبِيِّ وَلَيتَها","مَع أَهلِها طُوِيَت بِلَيلٍ مُظلِمِ",66,"م",1,0],["فرضاً وخبوتاً وأشباهه","إن كان إن أجملته يطلعُ",67,"ع",1,0],["فرَضيَ بَنو الإِسلامِ ذاكَ وَبايَعوا","وَقالوا عَلَينا الشُكرُ لِلَّهِ وَالحَمدُ",68,"د",1,0],["فَرَضُوا وقد قَرَضُوا اللُّهى حسن الثنا","وَسَمَوْا وقد وَسَمُوا جباه السؤدد",69,"د",1,0],["فرضنا له عينَ الكمالِ لأنه","إذا كان في الأحجارِ فيها من العين",70,"ن",1,0],["فرضنا انه بالأصل طين","ولكن السماجة حجرته",71,"ه",1,0],["فَرضٌ مِنَ الأذهَانِ يَفرضُهُ كَفَر","ضِ المُستَحِيلِ هُمَا لَهَا فَرضَانِ",72,"ن",1,0],["فَرُضابُ هَذا النَهر أَحلى في فَمي","مِن ذائِبِ التُفّاحِ وَالأَعنابِ",73,"ب",1,0],["فَرَضَوا بِهِ صُلحاً وَرُحتُ وَضامني","جُرحي وَجاءَ مِنَ الدَلالِ بِضامِنِ",74,"ن",1,0],["فرضاك عني بنفع","إن قصدك تنفعني",75,"ن",2,0],["فرض يقينك فيها واعتبر وأفق","فان غفلت يضيع الحق مكفولا",76,"ل",2,0],["فرضيتُ ما قسم القضاءُ وما انطوت","نفسي عليه من الأسى القتّال",77,"ل",1,0],["فَرضانِ سقمٌ ثمَّ فقرٌ مدقعٌ","فلعلَّ جودَكَ أن يداوي الأخطرا",78,"ر",2,0],["فرضها بها عين لحياة وأنني الخضر","الذي قد ذاق طعم زلالها",79,"ل",3,0],["فرض العمرة والحج لنا","وأبان الحكم حلاً وحراما",80,"م",2,0],["فرضيتُ منكسراً بجرْحِ كرامتي","وقبلت جرحي خوف جرح شعوره",81,"ر",2,0],["فرض عليّ له الرواحُ عشية","فكأنما أنا ذاهب للمعبد",82,"د",1,0],["فرضوا سفاسفهم على أسماعنا","يا سعد من يحظى بسمع موقر",83,"ر",1,0],["فرض الغناء بدون رغبة سامع","في منكر الأصوات أو بالأنكر",83,"ر",1,0],["فرضوان مذ لاقاه قال مؤرخاً","لقد سار للجنات بالجود جعفر",84,"ر",1,0],["فرض على شعب مصر أن يدين لهم","كالسامريين بين العجل والقرب",85,"ب",1,0],["فرضاك والود الذي تبديه لي","خير من الإعطاء والإرفاد",86,"د",1,0],["فرض هجاءكمُ بكل لسان","يا عصبة عكفت على الطغيان",87,"ن",1,1],["فَرضٌ عليَّ لك الرثآءُ اخطُّهُ","بدمٍ على لوح الفؤاد الهائِمِ",88,"م",1,0],["فرضان إما فناء والبناء له","لغو وإمَّا بقاء شاءه البانى",89,"ن",2,0],["فَرضٌ عَلَينا حبّ شَع","بٍ حبّ سَعدٍ فيهِ نفلُ",90,"ل",1,0],["فَرِضاكَ بَعد رِضا الاله مَرامُهُم","يُصبى اِلَيهِ مِنه