,"https://www.poetsgate.com/ViewPoem.aspx?id=34284",""],[5956,"الخير يجري","https://www.poetsgate.com/ViewPoem.aspx?id=192438",""],[5961,"الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=199835",""],[5977,"البوح بالشوق","https://www.poetsgate.com/ViewPoem.aspx?id=213073",""],[5988,"عاذلي بت نائما","https://www.poetsgate.com/ViewPoem.aspx?id=99722",""],[6031,"حَتَّامَ أمطلُ سيِّدي شكرَ اليدِ","https://www.poetsgate.com/ViewPoem.aspx?id=46263",""],[6142,"هل أنت معطي العين بعض سناتها","https://www.poetsgate.com/ViewPoem.aspx?id=155761",""],[6225,"اليقين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81036&r=&rc=273",""],[6277,"عبود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64440&r=&rc=3",""]],"verses":[["فَلْيَهْنِ أَنْدَلُساً قُدُومُكَ إِنَّهُ","حِرْزٌ لَهَا مِنْ طَاغِيَاتِ عُتَاتِهَا",0,"ت",3,0],["فَليَهنَأَ الجَيشُ الفَخو","رُ بِنَصرِهِ وَبِكَسرِهِنَّه",1,"ن",2,0],["فَليَهنَئِ العَبّاسُ أَنَّ بِكَفِّهِ","عَلَمَينِ هَزَّهُما الوَلاءُ المُطلَقُ",2,"ق",1,0],["فليهنأ القربُ من حماك بهِ","صوماً وفطراً ولتهنك القربه",3,"ب",2,0],["فليهنه الذكر سيار المديح له","إن قيلَ ما اخْترتَ منه قلتُ سائره",4,"ر",2,0],["فليهنه العيد السعيد لمثله","مِدَح تساغ لواردٍ وتسوغ",5,"غ",1,0],["فليهنَ شامٌ له من دأبه حلبٌ","حماه بأساً فلا بأس ولا دَرَك",6,"ك",1,0],["فليهنها إن راعي حكمها يقِظٌ","بالعلم حكم لا بالسعي والحيل",7,"ل",1,0],["فليهنه الشهر الأصمّ عرفته","عند المدائح مصغياً يتهلّل",8,"ل",1,0],["فليهن مجدك إذ يعلو وقد سفلوا","وليهن رأيك إذ يزكوا وقد أثموا",9,"م",3,0],["فليهنه العيد إذ هنى بطلعته","عيداً وهنى جميع الناس عيدان",10,"ن",1,0],["فليهنه العيد في عزٍّ وفي نعم","وللأنام بهِ والعيِ عيدان",11,"ن",1,0],["فليهنه من هلال العيد مقترف","يدنو فيركع إعظاماً وإجلالا",12,"ل",2,0],["فليهنَأِ الأملاكَ أن ملَّكتَهم","مِلْكَ السلامةِ زائناً لا شائنا",13,"ن",2,0],["فَليَهنِهِم حازَ اِلتِفاتَكَ سَعيُهُم","وَكَسا نَدِيَّهُمو سَناً وَسَناءَ",14,"ا",2,0],["فَليَهنِ بَدرَ الأَرضِ أَنَّكَ صِنوُهُ","وَنَظيرُهُ قُرباً وَبُعدَ مَزارِ",15,"ر",1,0],["فَليَهنِها وَليَهنِنا","أَنَّ القَضاءَ بِهِ اِضطَلَع",16,"ع",1,0],["فَليَهنِءِ الحَسَنَ بنَ وَهبٍ أَنَّهُ","يَلقى أَحِبَّتَهُ وَنَحنُ نُفارِقُ",17,"ق",1,0],["فَلْيَهْنَه البُرْءُ الذي أبرى النَّدى","من دائِه وأراه سَعْداً مُنْجِما",18,"م",2,0],["فليهنِك الشهرُ المعظَّمُ إنّه","ضيفٌ قِراه البِرُّ والإيثارُ",19,"ر",1,0],["فَليَهنَكَ الأَجرُ وَالنُعمى الَّتي عَظُمَت","حَتّى جَلَت صَدَأَ الصَمصامَةِ الخَذِمِ",20,"م",1,0],["فَلْيَهْنَإِ الدَّهْرُ الْغَيُورُ بِرِحْلَتِي","عَنْ مِصْرَ وَلْتَهْدَأْ صُرُوفُ زَمَانِي",21,"ن",2,0],["فَليَهنَني أننَّي شَهيدُ","أَدرَكتُ حُلوَ المُنى مُباح",22,"ح",1,0],["فَلِيَهنِكَ الظَفَرُ الَّذي أوتَيتَهُ","وَتَرَدَّدَ الأَعداءُ عَنكَ نُكولا",23,"ل",2,0],["فلْيَهنِ جَمْعاً في الفِراقِ ووُصْلةً","مِنْ قاطِعٍ وترَقِّياً مِنْ مُخْلِدِ",24,"د",1,0],["فَلْيَهْنِ أَحْمَدَ كيمياءُ سَعَادَةٍ","صَحَّتْ فلا نارٌ عليه تَغْتَدِي",24,"د",2,0],["فَلْيَهْنِ هذا أنَّ هذا صِنْوُهُ","وَكِلاهُما لإِبيهِ حَدُّ حُسامِ",25,"م",1,0],["فليهنأ الملِكُ الهمامُ بعيدهِ","ولْيعرضِ الجيشُ الكميُّ المعلمُ",26,"م",1,0],["فَلْيُهْنِيءِ اللهُ إِبْرَاهِيمَ مُرْتَقِياً","في السَّعْدِ مِنْ َأَرَبٍ يَقْضِي إلى أَرَبِ",27,"ب",1,0],["فَلْيَهْنَأُوا بِكَ زَائِراً","وَتَطِبْ نُفُوسُهُمُ الوَدُودَهْ",28,"د",2,0],["فلْيهْنَإ الْمُتَعَاقِدَانِ وَيُرْزَقَا","حَظّاً يَدُومُ مِن السرُورِ الْحَاضِرِ",29,"ر",1,0],["فَلْيَهَبْهُ الرَّحْمَنُ أَوْفَى جَزَاءٍ","وَلْيُثِبْهُ التَّارِيخُ بِالتَّمْجِيدِ",30,"د",1,0],["فليهنئِ اسَمك مجدُهُ، ولوَ أنه","كالبحر مستغنٍ عن الإمداد",31,"د",1,0],["فَلْيَهْنِىءِ الحَسَنَ بنَ وَهْبٍ أنّهُ","يَلْقَى أحِبّتَهُ، وَنحنُ نُفارِقُ",32,"ق",1,0],["فليهبهمْ ، حاز التفاتك سعيهم","وكسا ندِيَّهُمُ سَناً وسَناءَ",33,"ا",2,0],["فليهنك القيام والقعود","ويهنك الركوع والسجود",34,"د",1,0],["فليهْن هذا الدهرُ أنك خالدٌ","يا كعبةَ الأمراءِ والحكامِ",35,"م",1,0],["فَلْيَهْنَ دهرٌ أنتمُ أَقيلُه","ومُلوكه ووُلاتُه وقُضاتُه",36,"ت",2,0],["فليهجنا فلنا إن يهجنا بهمُ","حسن التأسى وحسنُ القفو للأثر",37,"ر",1,0],["فليهنئ الدنيا وجودُ خليفةٍ","جزلِ المواهبِ سابغ الإنعامِ",38,"م",1,0],["فَليَهنِ بَيتاً أَنتَ مِنهُ أَنَّهُ","أَبَداً عَلى ظَهرِ السِماكِ مُطَنَّبُ",39,"ب",1,0],["فَليَهنِ مَولاكَ أَنَّ دَولَتَهُ","تَنتَجِبُ الصَفوَ ثُمَّ تَنتَخِبُ",40,"ب",1,0],["فَليَهنِ آمالَ الخَلائِقِ أَنَّها","عَلِقَت بِأَروَعَ بِالمَكارِمِ مولَعِ",41,"ع",1,0],["فَليَهنِكَ الشَهرُ الَّذي يُثني بِما","صَيَّرتَهُ خَلفاً لَهُ وَأَماما",42,"م",2,0],["فليهنهم وليهن كل متابع","لهم الرضا والقرب للأحباب",43,"ب",1,0],["فَليَهنَكَ العيدُ السعيد","ويهنَهُ أن كنت عيده",44,"د",2,0],["فليهن يحيى أَنه لم يلهه","ملكٌ به تلهو الملوك ولا نَبا",45,"ب",2,0],["فليهنكَ العيد والخيراتُ تتبعهُ","وافي بشيرٌ بها والنصرُ والظفرُ",46,"ر",1,0],["فليهنه مِنك هذا الاحتفال به","فما يُهنّى سوى من أنت تحفلهُ",47,"ل",2,0],["فليهنَ عبدُ الله إنَّ سيوفه","يفتكنَ سراً فتكها إِعلانا",48,"ن",2,0],["فليهن أهل الأرض ملك عدلهِ","تدني مقاطفه جني جناتهِ",49,"ت",2,0],["فلي هجرة في السابقين قديمة","وخالص ودٍّ ليس فيه تصنع",50,"ع",1,0],["فليهنك العيد وليهن الذي نظروا","إلى محياك يوم العيد ما نظروا",51,"ر",3,0],["فَليُهَنّى بِكَ النَدا وَالعُلا وَال","مَجدُ وَالمُرمِلونَ وَالضُعَفاءُ",52,"ا",2,0],["فَلي هِمَّةٌ عَلَيا وَنَفسٌ أَبِيَّةٌ","تَمُجُّ وِصال اللّاوِياتِ المَواعِكِ",53,"ك",1,0],["فَلي هِمَمٌ إِذا جاشَت أَرَتني","قُرى عَمّان مِيلاً مِن عُمانِ",54,"ن",1,0],["فليَهنَ بِالرُتبةِ العَلياء مُرتَقياً","لِكُلِّ أَوجٍ رَفيعِ العزِّ مُؤتَنفِ",55,"ف",1,0],["فليهن حسنك والجدود مواهب","اني به بين البرية اعرف",56,"ف",1,0],["فَليَهنِكَ الظَفَرُ الَّذي لَولاكَ ما","خَطَرَت بَشائِرُهُ عَلى الأَوهامِ",57,"م",1,0],["فَليَهنِكُم شَرَفٌ ثانٍ إِلى شَرَفٍ","طُلتُم بِهِ الناسَ مِن عُربٍ وَمِن عَجَمِ",58,"م",1,0],["فَليَهنَ مِنكَ المُسلِمونَ أَباً إِذا","لا ذوا بِهِ حَدَباً عَلَيهِم يُشفِقُ",59,"ق",1,0],["فَليَهنَ مِنكَ الآباءُ ما زَرَعوا","مِن خَلَفٍ صالِحٍ وَما حَصَدوا",60,"د",3,0],["فليهدموا كل المآذن فوقنا","نحن المآذن فإسمع التهليلا",61,"ل",2,0],["فليهنَ مولانا الهناء بنجله","فلقد أسرّ أكابراً وأصاغرا",62,"ر",2,0],["فَلْيَهْنئ الدّينُ أنْ حَمَاهُ","مِنْكَ إِمامٌ حَبَاهُ يُمْنا",63,"ن",2,0],["فَليَهنِهِ الفَتحُ الَّذي سُدَّت بِهِ","عَن مُلكِهِ أَبوابُ غَدرِ الأَدهُرِ",64,"ر",1,0],["فليهن دائرة الأمين سرورهم","وليحمدوا المولى بكل لسان",65,"ن",1,0],["فليهنك العمران وليهن التلا","ميذ الكرام نجاح حال لا يبيد",66,"د",1,0],["فليهنكَ اليومَ الوصالُ فإنَّني","باقٍ وإِن أَخلفتني إِخلافا",67,"ف",2,0],["فليَهتدوا وَليَحمدوا وَيؤرّخوا","صبحاً بدا مِن رأي خير الدينِ",68,"ن",1,0],["فَليَهن دستورَ الوزارةِ غرسهُ","تلكَ الصنائعُ في القرار المطعمِ",69,"م",1,0],["فَليهنّأ بِهم إلى أَن يَراهم","وُزراء التصريفِ والتدبيرِ",70,"ر",1,0],["فَليَهنها من ربّها حفظهُ","مَن أودَعت إِذ راعَهم بُعدها",71,"د",3,0],["فَليهنِ مَجدك ما أوليب من رتبٍ","كُنتَ الأحقّ بِها من غير ترديدِ",72,"د",1,0],["فَليَهنَئ كُلَّ مِصري أَخا","هُ وَيوفي النُذرَ مَن كانَ نُذُر",73,"ر",1,0],["فَليهن قَوم بفَضل اللَه قَد بَلَغوا","حجّاً وَزاروا فَأَدّوا الفَرض وَالسننا",74,"ن",2,0],["فَلْيَهنأ النّاسَ عَوْدٌ من أخي كرمٍ","عُداتُه اليومَ تَرجو كلَّ من خُشيا",75,"ي",2,0],["فَلْيَهْنِها أنّها باتَتْ ولا هِمَمي","ولا هُمومي تُعَنّيها وتَعْنيها",76,"ي",3,0],["فَلْيَهْنِ أعمالَ خُوزِسْتانَ إذ رُزِقَتْ","إقبالَ طَبٍّ بأسرارِ العُلا طَبِن",77,"ن",1,0],["فَلْيَهنأ الإسلامَ أَنَّ عِمادَه","مُذْ جَدَّ في طَلَقِ المكارمِ ما ونَى",78,"ن",2,0],["فَلْيَهْنِ ألحاظَها وإن سَقُمَتْ","سُقْمٌ بنا منْه لا بها الأَلَم",79,"م",1,0],["فَلْيَهْنِكَ العَوْدُ الحَميدُ ولا تَزلْ","يُكفَى الوَرى بك كُلَّ خَطْبٍ مُعْضِل",80,"ل",1,0],["فلْيَهْنِ ذا التّاجَيْنِ أنّ جَمالَه","لَهُما أفادا وَجْهَه التّجْميلا",81,"ل",2,0],["فَلْيَهْنِ آفاقَ السِّيادة أنّها","نَجَمتْ ثَنيّتُها ببَدْرٍ طالع",82,"ع",1,0],["فلْيَهْنِه شَرَفٌ في جُودِه سَرَفٌ","وبأْسُه الدَّهْرَ مَوزونٌ بقِسْطاس",83,"س",1,0],["فلْيَهْنِك شَهْرٌ مُشتَهِرٌ","قد أمَّ جنابَك يَقْصِده",84,"د",2,0],["فَلْيَهنِه عِيدانِ أمَّا بَيتُه","من كُلِّ عيدٍ قد ألمَّ سعيد",85,"د",1,0],["فلْيَهنأِ الواشينَ أنّهم","شَبّوا لنا ناراً فما تَخْبو",86,"ب",2,0],["فلْيهنأِ الغَيرانَ أنّ صدودَها","مِمّا يُروّحُ مَعشراً وبكائي",87,"ا",2,0],["فَلي هِمَّةٌ قَد أَكرَمَتني هُمومُها","وَلَم أَمتَهِنها بِالطَماحِ إِلى الوَفرِ",88,"ر",1,0],["فليهنكَ العيدان عيدٌ مقبلٌ","لا زلتَ تدركه