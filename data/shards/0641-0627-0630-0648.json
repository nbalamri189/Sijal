{"poems":[[7,"إني كأني لدى النعمان خبره","https://www.aldiwan.net/poem2016.html","البسيط"],[240,"حللت حلول الغيث في البلد المحل","https://www.aldiwan.net/poem31791.html","الطويل"],[347,"طيف الحبيب ولهفة المحزون","https://www.aldiwan.net/poem55353.html","الكامل"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44805","الكامل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203678","الهزج"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28013","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93660","الوافر"],[4888,"مدرسة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=207751",""],[5111,"فِي لُجِّ الْغِيَابِ","https://www.poetsgate.com/ViewPoem.aspx?id=212357",""],[5419,"إصرار","https://www.poetsgate.com/ViewPoem.aspx?id=32222",""],[5567,"أبدو .. ولا أبدو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81749&r=&rc=21",""]],"verses":[["فَإِذ وُقيتِ بِحَمدِ اللَهِ شِرَّتَها","فَاِنجي فَزارَ إِلى الأَطوادِ فَاللوبِ",0,"ب",1,0],["فَأَذوي وَلا أُبدي لِخلَّةٍ شِكايَتي","وَأَعيا وَلا أُلقي عَلى أَحَدٍ ثِقلي",1,"ل",2,0],["فأذوب في ملأ تباعد افقه","في الجو في هامات عليين",2,"ن",1,0],["فَأَذوقُها مَمزوجَةً","بِشَذا الهَوى وَلُفى الحِنان",3,"ن",1,0],["فأَذوي، مثلما يذوي","ربيبُ الجو في الأَسر",4,"ر",1,0],["فإذْ ولا بد من علمٍ فأحسنُه","العلمُ بالله لا بالكونِ فاستزد",5,"د",1,0],["فَأَذوى الدَهر غُصنك وَهوَ غَض","وَألوى المَوت صَعدتك اِنقِصافا",6,"ف",2,0],["فأذوق من هذا النميرِ وأرتوي","متضلِّعًا بالشَّهدِ حتّى أعرَقُ",7,"ق",1,0],["فَأ ذوبُ في ْلجّ الغِيَابِ صَبَابَةً","تِيهٌ تَشَافَرَ فيْ الصِّبَا يَتَسَعَّرُ",8,"ر",1,0],["فأذوب في سهرٍ أهدئ روعَه","والحزن يجلدني بأسواط الأرقْ",9,"ق",1,0],["فأذوب في رؤياي من وله ٍ","يسعى فليس من الهوى بدُّ",10,"د",1,0]]}