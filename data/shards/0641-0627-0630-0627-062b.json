{"poems":[[68,"ما بين طيفك والجفون مواعد","https://www.aldiwan.net/poem41369.html","الكامل"],[33,"إن الخليط مع الصباح تصدعوا","https://www.aldiwan.net/poem42244.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"],[108,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[382,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[466,"يفضل الصارم في عزمته","https://www.aldiwan.net/poem16119.html","الرمل"],[466,"تتبارى أقلامه وقناه","https://www.aldiwan.net/poem16166.html","الخفيف"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216878","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80014","الكامل"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101588","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87572","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91209","الكامل"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/205870","الكامل"],[4782,"طال صبري","https://www.poetsgate.com/ViewPoem.aspx?id=201306",""]],"verses":[["فَإِذا ثَنائي عَنكَ هَمٌّ سائِقٌ","جَذَبَ العِنانَ إِلَيكَ شَوقٌ قائِدُ",0,"د",1,0],["فَإِذا ثَلاثٌ بَينَهُنَّ عَقيلَةٌ","مِثلُ الغَمامَةِ نَشرُها يَتَضَوَّعُ",1,"ع",1,0],["فإِذَا ثَنَيْتَ لَهُ الْعِنَانَ وَجَدْتَهُ","يَمْطُو كَسِيدِ الرَّدْهَةِ الْمُتَوَرِّدِ",2,"د",1,0],["فإذا ثورة على الظلم تَبْرى","رأسه، ثم تقتفي أذنابَه",3,"ب",2,0],["فإذا ثبتِّ ظلِلتِ فيَّ جميلةً","أو لا غدوتِ كقِرمَةٍ دَكناء",4,"ا",2,0],["فإذا ثَعْلَبُ رُمحٍ لم يَجِد","مَنزلاً كانَ لهُ النَّحْرُ وِجارا",5,"ر",2,0],["فإذا ثَرْوَةٌ ألَمَّتْ بكفَّيْه","فحظُّ النُّوَّال والسَّؤَّالِ",6,"ل",1,0],["فإذا ثلاثٌ واثنتان وأربعٌ","مشي الهجانِ على كثيبِ جُرادِ",7,"د",1,0],["فإذا ثرى الأرض اقشع","رَّ أديمه كانوا ربيعه",8,"ع",2,0],["فإذا ثنته عنك فترة صُدفةٍ","وارتدَّ بعد علمت بعد سلوّه",9,"و",2,0],["فاذا ثَوى فيهِ الخَفيف فعندَنا","سَلبٌ لبعض الثقل حين نَحلُّهُ",10,"ل",2,0],["فَإِذا ثملتُ صَحوتُ من نغماته","وَإِذا صَحَوت ثملت بالحركات",11,"ت",1,0],["فإذا ثمارُ الخَيْرِ تُؤتي أُكْلها","والجدولُ الرّقراقُ يروى الظّامي",12,"م",2,0],["فإذا ثوب الليالي مخصبٌ","وحصاد الصبر معسول الجنى",13,"ن",2,0]]}