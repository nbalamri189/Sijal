{"poems":[[74,"لنون صدغك آية فتنت","https://www.aldiwan.net/poem19330.html","المنسرح"],[45,"حيا وأيسر ما قاسيت ما قتلا","https://www.aldiwan.net/poem9983.html","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140806",""],[482,"بي من جوى التبريح اشفاق","https://www.aldiwan.net/poem15351.html","السريع"],[563,"لنور عين الوجود أعيان","https://www.aldiwan.net/poem33781.html","المنسرح"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96734","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56084","الوافر"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67203","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75946","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204998","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65128","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89468","المواليا"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40078","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77130","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54388","الرجز"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54418","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133193","الكامل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89598","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72459","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139749",""],[4867,"بعض","https://www.poetsgate.com/ViewPoem.aspx?id=13196",""],[5038,"حبيس الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=197668",""],[5362,"يا من تفرد بالجمال وصبه","https://www.poetsgate.com/ViewPoem.aspx?id=170377",""],[5561,"ومضة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=193806",""],[5582,"صَبٌّ بِدِرَّةِ ثَدْيِ الحُبِّ مَلْبُونُ","https://www.poetsgate.com/ViewPoem.aspx?id=63587",""],[482,"ما لم تزوروا فالمامُ الكرى زورُ","https://www.poetsgate.com/ViewPoem.aspx?id=111256",""]],"verses":[["لنون صدغك آيةٌ فتنت","بحسنها كلّ طامح الطرف",0,"ف",1,1],["لِنورِهِ في سَماءِ الفَخرِ مُختَرَقٌ","لَو صاعَدَ الفِكرُ فيهِ الدَهرَ ما نَزَلا",1,"ل",2,0],["لنوره في سماء المجد مخترقٌ","لو صاعد الفكر فيه الدهر ما نزلا",2,"ل",2,0],["لنوحِها في كبدي كلَّما","ناحتْ على الأغصانِ اِحراقُ",3,"ق",1,0],["لنور عينِ الوجودِ أعيانُ","وفوق إنسان تلك إنسانُ",4,"ن",1,1],["لنور محياه البديع تشعشع","له أبصر العميان والأفق مظلم",5,"م",1,0],["لِن واِقس في الطبع حتّى منك تمتزجا","طبع القساوة ما عاشرت واللينُ",6,"ن",1,0],["لنور الحق كم يهدي","لمغشوشٍ ومغرورِ",7,"ر",1,0],["لنوره ضرب الباري بهم مثلاً","فهل ترى لهم في النّاس من مثل",8,"ل",1,0],["لَنَوَّةَ بِي علمي وَزِدتُ جَلالَةً","وَغَيريَ فيهِ خاملُ الذكرِ باخِسُه",9,"س",2,0],["لنواقص الدنيا أساء فهل ترى","عن كل نقص سوف أسأل مرغما",10,"م",2,0],["لنومي على عيني تولّ بقربهم","ولمّا تولّوا عاد نومي يُعزلُ",11,"ل",1,0],["لنور جبينك أقول يا فالق الإصباح","عطف فؤاده فدمعي في غرامه باح",12,"ح",1,0],["لنَواعِيرِهَا على الماء ألحا","نٌ تَهيجُ الشَّجا لقلْب المَشُوقِ",13,"ق",1,1],["لِنوري الأُوارَ وَنَحمي السَفينا","فَما هُوَ كَلخاسُ فَاِعلَم يَقينا",14,"ن",2,0],["لِنَومِكَ يا عَيني فَعادَت وَلَم يَعُد","فَجادَت بِدَمعٍ صارَ بَعضُ المَوارِد",15,"د",1,0],["لنومها يسهرُ بل لأمنها","يخافُ بل يخصبها بجودها",16,"د",3,0],["لنومِ الرَّعايا وادعين سهادُهُ","إذا وادِعوا الأملاك في نومهم غَطُّوا",17,"ط",3,0],["لنوالكم ذات افتقارٍ ولا غنى","عنكم لها في سابق الأشياء",18,"ا",2,0],["لَنَوى إِمامِ العالَمينَ وَخَيرِها","بَعدَ الرَسولِ المُصطَفى طَرفي خِضَم",19,"م",1,0],["لنوله ما عشنا في","نعمائه حمدا وشكرا",20,"ر",2,0],["لنوى مَن نوت عن المجد ظعنا","فيه كم قَّوضت لصفوٍ ظعونا",21,"ن",2,0],["لنويتي يابنت معي تغامري وتصعدي","كوني مستعده معي لمواجهة اخطري",22,"ر",2,0],["لَنَوحُكِ قُرْبي قَدْ أَضَرَّ بِحالي","هَلُمّي إِلى نَجْوى الْعَليلِ تَعالي",23,"ل",2,1],["لن وانعطف يا أيها الغصن الذي","ما زال في روح الجمال رطيبا",24,"ب",2,0],["لَنور طُهرك شمس في مشارقها","وكيف للشمس أن ترقى له الطهر",25,"ر",1,0],["لِنْ وَاقْسُ فِي الطَّبْعِ حَتَّى مِنْكَ يَمْتَزِجا","طَبْعُ القَساوَةِ ما عاشَرْتَ وَاللِّينُ",26,"ن",1,0],["لنوحها فوقَ أفنانِ الأراكِ وقد","غابَ الهديلُ مِن الأشواقِ تكريرُ",27,"ر",1,0]]}