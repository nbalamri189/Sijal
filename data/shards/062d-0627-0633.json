{"poems":[[90,"حياكم الله أيها العرب","https://www.aldiwan.net/poem44469.html","المنسرح"],[72,"لا تعتب الدهر في خطب رماك به","https://www.aldiwan.net/poem43037.html","البسيط"],[47,"يمزج خمرا بجنى ريقه","https://www.aldiwan.net/poem65194.html","السريع"],[63,"أقررت في شكرك بالتقصير","https://www.aldiwan.net/poem51655.html","الرجز"],[82,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[50,"قد كان لي حمدان ذا زورة","https://www.aldiwan.net/poem64453.html","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43799","المقتضب"],[53,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[96,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[240,"الحمد لله عوفي الكرم","https://www.aldiwan.net/poem31763.html","المنسرح"],[246,"يا يراعي لولا يد لك عندي","https://www.aldiwan.net/poem45751.html","الخفيف"],[308,"إني لأعجب من صدودك والجفا","https://www.aldiwan.net/poem58115.html","البسيط"],[438,"عزمي وحزمي والحسام الماضي","https://www.aldiwan.net/poem12440.html","مشطور الرجز"],[440,"عيناك أمكنت الشيطان من خلدي","https://www.aldiwan.net/poem25312.html","البسيط"],[449,"لست أنسى عهد ليل قريب","https://www.aldiwan.net/poem56036.html","المديد"],[458,"كم زعيم مسخر شرفه","https://www.aldiwan.net/poem61355.html","الخفيف"],[466,"يا بهاء الدهر والدي","https://www.aldiwan.net/poem15369.html","مجزوء الرمل"],[469,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[520,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[520,"العلم مذ كان محتاج إلى العلم","https://www.aldiwan.net/poem12262.html","البسيط"],[520,"من استعان بغير الله لم يعن","https://www.aldiwan.net/poem12278.html","البسيط"],[591,"أبدا بذكرك تنقضي أوقاتي","https://www.aldiwan.net/poem17455.html","الكامل"],[704,"","https://poetry.dctabudhabi.ae/diwan/poem/120171","الخفيف"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146215","المديد"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48677","الكامل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99985","المديد"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123414","الرمل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145795","الخفيف"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144775","الخفيف"],[1780,"","https://poetry.dctabudhabi.ae/diwan/poem/116736","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48267","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27761","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27762","الخفيف"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99067","الخفيف"],[2957,"","https://poetry.dctabudhabi.ae/diwan/poem/198430",""],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112664","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74066","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108030","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117920","الخفيف"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107501","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83197","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72769","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72350","الخفيف"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204309","المنسرح"],[4578,"هيهات أبلغ في هواك مرامي","https://www.poetsgate.com/ViewPoem.aspx?id=49518",""],[4875,"أوّل جزا","https://www.poetsgate.com/ViewPoem.aspx?id=137106",""],[4896,"وحشة الليل","https://www.poetsgate.com/ViewPoem.aspx?id=180896",""],[5225,"بو خليفه لي يشجعنا","https://www.poetsgate.com/ViewPoem.aspx?id=27618",""],[5324,"أنا لا أسميه شيا","https://www.poetsgate.com/ViewPoem.aspx?id=207173",""],[5694,"أسطورة العصر","https://www.poetsgate.com/ViewPoem.aspx?id=129916",""],[5784,"لا تلمني","https://www.poetsgate.com/ViewPoem.aspx?id=189832",""],[5784,"لا تكوني كوكب نار","https://www.poetsgate.com/ViewPoem.aspx?id=191091",""],[6069,"ألآل ضواحكٌ أم ثغور","https://www.poetsgate.com/ViewPoem.aspx?id=105665",""],[6115,"في ذمتي ماكان يزعل عليه","https://www.poetsgate.com/ViewPoem.aspx?id=181763",""],[6115,"الرخوم اللى تهايط على الفاضي بلاش","https://www.poetsgate.com/ViewPoem.aspx?id=196462",""],[5309,"أيها الشاكي ولا ناصر له","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573539",""],[520,"من استعان بغير الله لم يعن","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577661",""],[5080,"حتّام ترثي نخيلا في العناوينِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88135&r=&rc=5",""],[2220,"حاسبونا فدفقُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11574&r=&rc=448",""]],"verses":[["حاسرة الرأس غير ناطقة","إلا بدمع لسانه ذَرِب",0,"ب",1,0],["حاسِب زَمانَكَ في حالَي تَصَرُّفِهِ","تَجِدهُ أَعطاكَ أَضعافَ الَّذي سَلَبا",1,"ب",2,0],["حاسِدَنا في الحُبِّ مُت حَسرَةً","سُهِّلَ دَهرٌ بَعدَ تَعويقِهِ",2,"ق",2,0],["حاسرةٍ عن أرجٍ حَسيرِ","مثلِ نَسيمِ الزَّهَرِ المَمطورِ",3,"ر",1,0],["حاسرٌ درعه تَضَرُّمَ قلبٍ","خافقٍ في حشا فتىً شَمّريِّ",4,"ي",1,0],["حاسراتٍ يَنُحْنَ في كلّ صُبْحٍ","بلّه دمعها وكلّ عشيِّ",4,"ي",1,0],["حاسِرُ كَفَّيكَ عَلى هاوُنٍ","لِدَقِّ ثومٍ أَو لِسُمّاقِ",5,"ق",1,0],["حاسِدٌ أَصابَكَ عَن","أَمرِ رَبِّهِ فَسَقا",6,"ق",2,1],["حاسرٍ للسِّلاح مجتابِ درعٍ","دون أدنى قوارِص القول زَعْفِ",7,"ف",1,0],["حاسنوا غرّة الصباح بسعد","فعلمنا أيّ الصباحين أهدى",8,"د",2,0],["حاسبونا على هنات المعالي","ثمّ غالوا بها حسابا وعدّا",8,"د",2,0],["حاسِمُ داءِ الدُنيا العُضالِ وَما","خِلناهُ لَولا الوَزيرُ يَنحَسِمُ",9,"م",1,0],["حاسبُوه على الذكاءِ وقالوا","حسبه صِيتُه البعيدُ فَخارا",10,"ر",2,0],["حاسا شمائلك اللطيفة أن ترى","عوناً على مع الزمان القاسي",11,"ي",1,0],["حاسِمِ ما بالدّهرِ من أمراضِ","على الليالي منه حين قاضِ",12,"ض",1,0],["حَاسِب هَوَاكَ بِمَا أنفَقتُ مِن عُمُرِي","وَاللهِ لَو كَانَ عُمرِي كَنزَ قَارُونِ",13,"ن",1,0],["حاسدٌ لي فهو حيث استقر","لذوي الفضل عدوّ خصيم",14,"م",1,0],["حاسدٌ يفسد بين البشر","بل عدوّ للنبيل الكريم",14,"م",1,0],["حاسبا ستر عورته المال","الذي في جموعه خصفه",15,"ف",2,0],["حاسِدا بأسِكَ والحِ","لمِ بسَلْمٍ ونِزالِ",16,"ل",1,0],["حاسدوها شهودها وقضاة","العقل قامت بفضلها حكاماً",17,"م",2,0],["حاسب ضميرك إن خلوت وقل له","غيري يباع وداده ويعار",18,"ر",1,0],["حاسب ضميرك عن رأي أتاك وقل","نصيحة وردت من غير متهم",19,"م",1,0],["حاسب ضميرك تأمن من بوائقه","وازجره من خطرات العين والأذن",20,"ن",1,0],["حَاسَبْتُ أَنْفاسِي فَلمْ أَرَ وَاحِداً","مِنْهَا خَلَا وَقْتاً مِنَ الأَوْقَاتِ",21,"ت",1,0],["حاسديه تعجبوا","ليس ذا الفضل بالحيل",22,"ل",1,0],["حاسراً أو ذات مقنعة","ذات تاج فيه إكليل",23,"ل",1,0],["حاسنتهم لترد عنا شبهة","كم حاربوك بها وما حربوكا",24,"ك",2,0],["حَاسِدِي في حُسْنِ فِعْلِكِ بِي","غَيْرُ مَعْذُولٍ عَلَى الْحَسَدِ",25,"د",1,0],["حاسِرٌ بالليلِ حافِ","ودُجى الليلِ لِحافي",26,"ي",1,1],["حاسِرٌ واثِبٌ عنيدٌ مُدوٍ","هو هذا وذا وذاكَ وهذا",27,"ذ",2,0],["حاسراً بردة الجدال يقضي","تفثاغب نثرة المرغوب",28,"ب",1,0],["حاسيته الموتَ حتى اشتفّ آخِرهُ","فما استكانَ لما لاقى ولا جزعا",29,"ع",2,0],["حاسمُ الليلِ بالقُرانِ وبالسبْ","عِ المثاني لا باصطفاقِ المثاني",30,"ن",2,0],["حاسَبونا فدققوا","قيَّدونا فأوثقوا",31,"ق",3,1],["حاسبونا ما دقّقوا","قيَّدونا ما أوثقوا",32,"ق",3,1],["حاسداً للجفون لما أزالت","في مغانيه دمعها المذروفا",33,"ف",2,0],["حاسدي لي معذب","يتقلى من الحسد",34,"د",1,1],["حاسرةَ الوجهِ بغيرِ بُرقِع","لا سترَ غيرُ ساعدٍ وأذرع",35,"ع",1,0],["حاسِباً وَالحِساب غير صَحيح","إِن رَمانا من حالق أَصمانا",36,"ن",2,0],["حاسبين الفراقَ عنها دواءَ","فرأيناه افتك العلات",37,"ت",1,0],["حاسب أن من سواه تراب","وهو من بينهم تكون تبرا",38,"ر",2,0],["حاسباً أنَّ للصفاء دواماً","هل دوام الصفاءِ بالإمكانِ",39,"ن",1,0],["حاسِنهُ لا تَبغِ الذي يَبغيهِ","كُلُّ إِناءٍ ناضِحٌ ما فيهِ",40,"ه",1,0],["حاسم مضى واللحد أصبح جفنه","فغازلنه من أعين العين أجفان",41,"ن",1,0],["حاسدا عند قبره أثلات","فزن من قربه بمجد أثيل",42,"ل",1,0],["حاسبت عن لمّتي مزيِّنَها","حساب شيخ للحزم متبع",43,"ع",1,0],["حاسبت أجفاناً لهُ بكسورها","فغدت تطالب مهجتي بسهامِ",44,"م",1,0],["حاسب شياطينك مع الناس تغويك","وتمضي على لاشيّ باقي حياتك",45,"ك",1,0],["حاسر الرأس عند كل جمال","مستشف من كل شئ جمالا",46,"ل",2,0],["حاسب احسابك وراقبنا","ونزّل اشياطينك قبل تينا",47,"ن",2,0],["حاسِماً كالسّيفِ في الصُبحِ عَتِيّا","دافئ الأطباعِ في الليلِ حَنِيّا",48,"ي",2,0],["حاسبني الله في بخلي وتبذيري!","وأرسلي اللي لها الأرواح تواقه",49,"ق",2,0],["حٙاسِبِ النّٙفْسٙ فِي أُمُورٍ تٙرٙاهٙا","بٙعْضُ مٙاءٍ وٙٱلْمٙاءُ فِيهٙا جٙفٙاءُ",50,"ا",2,0],["حاسبي أن تبددي الحب فينا","واحرصي أن نحيا الغرام جنونا",51,"ن",2,1],["حاسرات سجف الأكلة تيهاً","ولها من قنا الوشيج ستور",52,"ر",1,0],["حاسد نذل جاحد منافق وكذاب","ويحسّب المغرور مافيه زيّه",53,"ي",2,0],["حاسبين المرجله بالتفاخروالهدوم","نافخين متونهم بالهمايل والخياش",54,"ش",1,0],["حاسِبوا أَنفُسَكُم عَمّا جَنَت","كُلُّ ظُلمٍ سَيُلاقي أَجلَه",55,"ل",2,0],["حاسب ضميرك لا تأمن بوئقه","وازجره من خطرات العين والأذن",56,"ن",1,0],["حاسبْ نبوءاتِ هذي الأرضِ هل تركتْ","عُشبا يصلّي عليه اليومَ ذو النونِ",57,"ن",1,0],["حاسبونا فدفقُوا","قيدونا فأوثقوا",58,"ق",3,1]]}