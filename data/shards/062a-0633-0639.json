","https://www.poetsgate.com/ViewPoem.aspx?id=166830",""],[5893,"ما للعرب تاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=141278",""],[5897,"همسة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=156356",""],[5917,"الحمد لله هذا العين لا الأثر","https://www.poetsgate.com/ViewPoem.aspx?id=106533",""],[5956,"أقصوصة امرأة بوصلتها الجنس","https://www.poetsgate.com/ViewPoem.aspx?id=182704",""],[5956,"هل أنا أكبرُ المعمَّرين؟","https://www.poetsgate.com/ViewPoem.aspx?id=192731",""],[5956,"مَن هي جانْسيت قازان (أمِّ خالد)؟","https://www.poetsgate.com/ViewPoem.aspx?id=207236",""],[5957,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=180143",""],[5970,"ساحة الأرض ضيقت بي فهاتوا","https://www.poetsgate.com/ViewPoem.aspx?id=130613",""],[5970,"بعض شر من شرور العالمين","https://www.poetsgate.com/ViewPoem.aspx?id=130583",""],[5994,"كلام في الظل","https://www.poetsgate.com/ViewPoem.aspx?id=184662",""],[6019,"فَضَحَ الهَوَى سِرِّيْ ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=53001",""],[6031,"بعثَتْ طَيْفَها فَزَارَ طُرُوقَا","https://www.poetsgate.com/ViewPoem.aspx?id=46276",""],[6056,"أبدع المنظوم","https://www.poetsgate.com/ViewPoem.aspx?id=156714",""],[6102,"أُمِّي وَأُمِّي","https://www.poetsgate.com/ViewPoem.aspx?id=182734",""],[6127,"شاخت عروقك","https://www.poetsgate.com/ViewPoem.aspx?id=202361",""],[6189,"اعترافات شاهد الموت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83556&r=&rc=23",""],[6189,"قصيدة عن حب قديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67119&r=&rc=4",""],[6319,"الجنوب الصعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86563&r=&rc=5",""],[572,"ما قمت ُحتَّى دعَاني عودها الغَرِدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9251&r=&rc=108",""],[6366,"لهواك أسرارٌ وصمتك ساحرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86673&r=&rc=0",""]],"verses":[["تَسعى البِكارُ مُعَنّاةً وَقَد مَلَكَت","أولى الجُمامِ عَلَيها الجِلَّةُ الشُرُفُ",0,"ف",1,0],["تسعون ألفاً (لعمورية( اتقدوا","وللمنجم قالوا: إننا الشهب",1,"ب",1,0],["تَسعى حَلائِلُنا إِلى جُثمانِهِ","بِجَنى الأَراكِ تَفيئَةً وَالشَبرُمِ",2,"م",1,0],["تَسعى وَراءَ الباقِيا","تِ الصالِحاتِ وَتَعتَلي",3,"ل",2,0],["تِسعونَ أَلفاً حَولَ نَعشِكَ خُشَّعُ","يَمشونَ تَحتَ لِوائِكَ السَيّارِ",4,"ر",1,0],["تِسعونَ بَيتاً شِدتَها","فَوقَ سِنانِ السَمهَري",5,"ر",2,0],["تَسعى بِصافيةٍ مُعَتَّقَةٍ","تَبدو لَنا في الكَأسِ كَالشُعَلِ",6,"ل",1,0],["تِسْعُونَ عَاماً بَعْضُ أَوْصَافِهَا","يَعْجِزُ عَنْهُ كُلُّ تَبْيانِ",7,"ن",1,0],["تُسَعِّرُها بِأَبيَضَ مَشرَفِيٍّ","كَضَوءِ البَرقِ يَختَلِسُ القِلالا",8,"ل",2,0],["تِسعَةٌ تَحمِلُ اللِواءَ وَطارَت","في رِعاعٍ مِنَ القَنا مَخزومُ",9,"م",1,0],["تَسعى وَتَرقُصُ حَولَ أَيرِ حِمارِها","حَتّى يَكادَ يَمَسُّها أَو يَفعَلِ",10,"ل",1,0],["تَسعى إِلى الصَباحِ مُعوِلَةً","يا هِندُ إِنَّكَ صُلبَةُ الهَردِ",11,"د",1,0],["تسعى لها قوائم لا تتبع","وكيف لا وهي الرياح الأربع",12,"ع",1,0],["تَسعى لكي تجمعَ وسْطَيهما","كأنها مِسمارُ مقراضِ",13,"ض",1,1],["تَسعى بِها جارِيَةٌ إِذا اِنثَنَت","أَخجَلَ لينُ عِطفِها أَغصانا",14,"ن",2,0],["تَسْعى بهِ الأَمواجُ","باسمةً كأَحْلامِ الصِّبَا",15,"ب",2,0],["تسع المجرة في السماء عوالما","اما الطبيعة فهي منها اوسع",16,"ع",1,0],["تِسعونَ لَو رَكِبَت مَناكِبَ شاهِقٍ","لَتَرَجَّلَت هَضَباتُهُ إِعياءَ",17,"ا",2,0],["تَسَعُ الحَياةَ عَلى طَويلِ بَلائِها","وَتَضيقُ عَنهُ عَلى قَصيرِ عَذابِهِ",18,"ب",2,0],["تسعى المكارم حوله وكأنها","غرر السوابق لحن يوم سباق",19,"ق",1,0],["تسعى بصهباوين من","ألحاظها وشرابها",20,"ب",3,0],["تِسعٌ وَعِشرونَ إِن عُدَّت قَصائِدُها","وَمِثلُها عَدَدُ الأَبياتِ في النَسَقِ",21,"ق",1,0],["تِسعونَ أَلفاً كَآسادِ الشَرى نَضِجَت","جُلودُهُم قَبلَ نُضجِ التينِ وَالعِنَبِ",22,"ب",1,0],["تَسَعُ الممالِكَ والشُّعوبَ بأسرها","وتفيضُ خيراً ما بَقِينَ وما بَقُوا",23,"ق",3,0],["تَسعى الشُعوبُ وَنَحنُ في غَفَلاتِنا","نَأبى الفِعالَ وَنُكثِرُ الأَقوالا",24,"ل",2,0],["تَسعى لِقَلبِ الصَبِّ مِنها حَيَّةٌ","أَودَت بِهِ لَسعاً فَمَن يَرقيهِ",25,"ي",2,0],["تُسعِدَنَّ الأَقدارُ جُهدي وَإِلّا","لَم أَمُت في ذا الحَيَّ مَوتَ النِساءِ",26,"ا",2,0],["تَسْعَى لأَبْوَابِهِمْ قُصَّادُ مالِهم","وجاهِهِمْ زُمَراً في إثْرِها زُمَرُ",27,"ر",1,0],["تَسْعَى بنورِ اللّهِ بَينَ عِبادِهِ","لتُضيءَ بُرهاناً لهم وتلوحا",28,"ح",2,0],["تَسعى إِلَيَّ بِكَأسِها كَرخِيَّةً","يَختَصُّها نَدمانُها بِوَدادِ",29,"د",1,0],["تَسعى بِها حَوراءُ في طَرفِها","ضَحكٌ وَفي المَضحَكِ تَقيِيِنُ",30,"ن",1,0],["تَسعى وما غير دفع","من الأثير ذريعه",31,"ع",2,0],["تَسَعُ الناسَ على ألوانهم","لم تفرِّقْ بين آريٍّ وسامي",32,"م",2,0],["تسْعَى مَمَالِكهَا إِليْكَ وَقدْ رَأَتْ","بِيَدَيْكَ رَايَةَ الاتَّحَادِ الأَكْبرِ",33,"ر",1,0],["تَسعى ويَعْتَرِضُ السَّبِيلَ قنُوطُهُمْ","فِي كُلِّ حَل مِنْكَ أَوْ تَرْحَالِ",34,"ل",1,0],["تِسْعٌ بَرَزْنَ مِنَ الصُّفُوفِ تَوَارِكا","لِلاَّحِقَاتِ الشَّوْطَ مجِدَّ مُمَهَّد",35,"د",1,0],["تسعى الطيور فكُلُهُنّ حمائمٌ حمرٌ","على تلك المناهل حوّم",36,"م",1,0],["تسع وعشرُ_ رعاك الله _ كيف جرى؟","بنا الزمان .. يكاد البرق يخطفه؟",37,"ه",1,0],["تَسعى الرِجالُ فَلا تَنالُ بِحِرصِها","ما نالَ في تِسعٍ مِنَ العَلياءِ",38,"ا",2,0],["تِسعينَ في المِقدارِ كانَت تِسعَةً","فَلَقَد أَقامَ بِها مَنارَ بهائي",38,"ا",2,0],["تَسْعَى إِلى بارِيسَ كالْمُخْتارِ","ضَمَّ إِليْهِ صَحْبَا",39,"ب",2,0],["تَسْعَى إِلى أغْيَدٍ ما طَرَّ شَارِبُهُ","كأنَّما صَفْحَتاهُ وجْهُ دِينارِ",40,"ر",1,0],["تسعى جنائزها بجرا حقائبها","مما انتهبن بحرب الصبح والطفل",41,"ل",1,0],["تسعل الأشجار تحسو ظلها","تجمد الساعات من برد التابة",42,"ب",2,0],["تَسْعَى º وأَيْسَرُ هَذَا السَّعْيِ يَكْفِينا","لَوْلاَ تَكَلُّفُنَا مَا لَيْسَ يَعْنِينَا",43,"ن",2,1],["تَسْعَى بنورِ الله بَينَ عِبادِهِ","لتضئَ برهاناً لهم وتلوحا",44,"ح",2,0],["تسعل الأشجار ، تحسو ظلّها","تجمد الساعات من برد الرتابه",45,"ب",2,0],["تَسعى المَواسم كُلَها لِركابِهِ","إِذ لا بَهاءَ لَها بِغَير بَهائِهِ",46,"ا",3,0],["تِسعاً وَتسعيناً بَناها مُخلِصاً","ذاكَ الأَمير المُحسن المنعام",47,"م",1,0],["تسعَى بنا قدمُ الرجاءِ وما الذي","يُغنِى إذا قَعدتْ بنا الأرزاقُ",48,"ق",1,1],["تِسعَةُ أَعشارِها اِستَبَدَّ بِها","وَعُشرُها في بَني الدُنى بَدَدُ",49,"د",1,0],["تسعى على قدم التقصير تابعة","كعبا وان كان للتقديم تفضيل",50,"ل",1,0],["ت