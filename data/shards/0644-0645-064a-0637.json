{"poems":[[93,"يا ابنة العم إن ذاك الذي","https://www.aldiwan.net/poem11116.html","الخفيف"],[54,"لم يطيقوا أن يسمعوا وسمعنا","https://www.aldiwan.net/poem27368.html","الخفيف"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[37,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[51,"لم يطرف طارف المساعي","https://www.aldiwan.net/poem61830.html","مخلع البسيط"],[91,"بورك الصمام من حكم","https://www.aldiwan.net/poem62717.html","عموديه"],[89,"لم يطمئن القوم في بغداد","https://www.aldiwan.net/poem44851.html","الكامل"],[85,"يموت في الغاب أو في غيره الأسد","https://www.aldiwan.net/poem62890.html","البسيط"],[85,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[85,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[44,"أصغى إلى البين مغترا فلا جرما","https://www.aldiwan.net/poem30366.html","البسيط"],[31,"ولقد قالت لأتراب لها","https://www.aldiwan.net/poem42600.html","الرمل"],[102,"شيعي الليل وقومي استقبلي","https://www.aldiwan.net/poem32992.html","الرمل"],[22,"إن الخليط أجدوا البين فانفرقوا","https://www.aldiwan.net/poem22068.html","البسيط"],[48,"ما لي وللعاذلات","https://www.aldiwan.net/poem62464.html","المجتث"],[50,"لم يطل ليلي ولكن لم أنم","https://www.aldiwan.net/poem62251.html","الرمل"],[50,"طال هذا الليل بل طال السهر","https://www.aldiwan.net/poem63795.html","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85430","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30442","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54935","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[106,"بطل الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179606",""],[100,"راهب الفن","https://www.poetsgate.com/ViewPoem.aspx?id=50160",""],[31,"ولقد قالتْ لأترابٍ لها،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18803&r=&rc=66",""],[18,"بَاتَ لَيْلِي بِالأَنْعَمَيْنِ طَوِيلاَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26456&r=&rc=22",""],[129,"شمر الذيل وبادر للعمل","https://www.aldiwan.net/poem50540.html","الرمل"],[133,"آي أطلال الأوداء","https://www.aldiwan.net/poem54896.html","المديد"],[143,"يا صحابي واين منى صحبى","https://www.aldiwan.net/poem58430.html","البسيط"],[144,"بك اقتضى الدين دينا كان قد وجبا","https://www.aldiwan.net/poem11722.html","البسيط"],[198,"هات يا ساق هات بنت النخيل","https://www.aldiwan.net/poem39944.html","الخفيف"],[304,"لا قبلنا في ذا المصاب عزاء","https://www.aldiwan.net/poem58419.html","الخفيف"],[350,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[367,"لم يطمع الليل مني أن أرق له","https://www.aldiwan.net/poem17016.html","البسيط"],[368,"ولي النبعة من سلافها","https://www.aldiwan.net/poem4618.html","الرمل"],[394,"طويت محمودا على جفوته","https://www.aldiwan.net/poem53604.html","السريع"],[403,"بلغت ما شئت من حزني ومن كمدي","https://www.aldiwan.net/poem46749.html","البسيط"],[417,"هل عرفت الديار من آل نعمى","https://www.aldiwan.net/poem54169.html","الخفيف"],[422,"يا صاح ليس على المحب جناح","https://www.aldiwan.net/poem46389.html","الكامل"],[433,"لم يطق هواه فباحا","https://www.aldiwan.net/poem12581.html","المديد"],[438,"قد أعرب الدمع عن وجدي وكتماني","https://www.aldiwan.net/poem2565.html","البسيط"],[438,"ها قد بلغت الذي قد كان ينتظر","https://www.aldiwan.net/poem2614.html","البسيط"],[440,"نور الوفاء بأرضنا لك ساطع","https://www.aldiwan.net/poem34838.html","الكامل"],[552,"ما أرادت إلا الجفاء ظلوم","https://www.aldiwan.net/poem47245.html","الخفيف"],[552,"أما الحبيب فقد فزنا بزورته","https://www.aldiwan.net/poem47760.html","البسيط"],[552,"هل أنت لصب القلب معمود","https://www.aldiwan.net/poem47841.html","البسيط"],[576,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"]],"verses":[["لَمْ يُطِعْهُ البَيَانُ أَطْوَعَ مَا كَا","نَ مَدِيحٌ لِوَالِدٍ يَصِفُ ابْنَهْ",0,"ن",2,0],["لَم يَطيقوا أَن يَسمَعوا وَسَمِعنا","وَصَبَرنا عَلى رَحى الأَسنانِ",1,"ن",1,1],["لم يَطعَنِ الرِّيشُ في مَطَاعنِهِ","مِنها ولم يَنتَعِش بها القًصَبُ",2,"ب",1,0],["لم يطعن الريش في مطاعنه منها","ولم تنتعش بها القضب",3,"ب",1,0],["لم يطَّرِفْ طارف المساعي","من لم يؤثِّل لها تِلاد",4,"د",1,1],["لَم يَطُق صَبراً عَلى مَضَضٍ","فَأَتى يَسعى عَلى قَدَمِ",5,"م",1,0],["لم يطمئن القوم في بغداد","إلا إلى الأغلال والأصفاد",6,"د",1,1],["لَم يُطغِكَ الحُكمُ في شَتّى مَظاهِرِهِ","وَلا اِستَخَفَّكَ لينُ العَيشِ وَالرَغَدُ",7,"د",1,0],["لَم يُطوَ مَأتَمُها وَهَذا مَأتَمٌ","لَبِسوا السَوادَ عَلَيكِ فيهِ وَقاموا",8,"م",3,0],["لَم يَطعَمِ الغُمضَ جَفَنُ المُسلِمينَ لَها","حَتّى اِنجَلى لَيلُها عَن صُبحِهِ الشَنِبِ",9,"ب",1,0],["لَم يَطغَ قَومٌ وَإِن كانوا ذَوي رَحِمٍ","إِلّا رَأى السَيفَ أَدنى مِنهُمُ رَحِما",10,"م",2,0],["لَم يَطِش قَطُّ لَها سَهمٌ وَمَن","تَرمِهِ لا يَنجُ مِن رَميَتِها",11,"ت",3,0],["لَم يُطِق شبلُك ضَيماً سَيدي","فَاِستمع للعذر قَبل العذلِ",12,"ل",1,0],["لَم يُطلِعوكَ عَلى ما في نُفوسِهِمُ","وَلَم يَكُن لَكَ في أَيمانِهِم عَلَقُ",13,"ق",1,0],["لَم يَطَّلِع طَلعَ شاني","إِلّا اِتِّهامَ هَناتي",14,"ت",2,0],["لَم يَطُل لَيلي وَلَكِن لَم أَنَم","وَنَفى عَنّي الكَرى طَيفٌ أَلَم",15,"م",1,1],["لَم يَطُل حَتّى جَفاني شادِنٌ","ناعِمُ الأَطرافِ فَتّانُ النَظَر",16,"ر",1,0],["لَم يطو من أَسَفي عليهم كونهم","متوارثين عبادة الأوثان",17,"ن",1,0],["لم يُطِقْ عامِرُ قِدْما مِثْلَها","لا ولا عَمْرُو بن مَعْدِ يكرِبِ",18,"ب",1,0],["لَمْ يطُلْ فَخْرَهُ الْقَدِيمَ سوَى مَا","أَحْدَثَتْ آيَةُ الزَّمَانِ الأَخِيرِ",19,"ر",1,0],["لَمْ يَطُلْ عَهْدُ مِصْرَ بِالوَثْبَة الأُو","لَى وَدُونَ الوُصُولِ خَرْطُ القَتَاد",20,"د",1,0],["لم يطوها الفَلكُ المدارُ، كأنها","أخذت على الفلك المدارِ عهودا",21,"د",2,0],["لم يطمعوا -إذا دافعوا","عن أرضهم- في أجر آجر",22,"ر",1,0],["لم يطمَحُوا في غير إر","ثِ بني كنانةَ أو تميمَ",23,"م",1,0],["لم يطق حشمة الجوى","من رأى الشاعر احتشم ؟",24,"م",1,0],["لم يطشْ قطُّ سهمٌ، ومنْ","تَرْمِهِ لا يَنْجُ مِنْ رَمْيَتِها",25,"ت",3,0],["لمْ يطيقوا أنْ ينزلوا وَ نزلنا","وَأَخُو الْحَرْبِ مَنْ أَطَاقَ النُّزُولاَ",26,"ل",2,0],["لم يطق كتمانَه خلقٌ سوى","مَنْ أرادَ اللهُ ربى ذُو الأزَلْ",27,"ل",1,0],["لم يطق دفعا لها أبَداً","جندُ إخفَاءٍ وإبدَاءِ",28,"ا",2,0],["لم يُطقْ واحدٌ قضاءَ أيادِي","ك فوافاك مستغيثا بِتِرْبِ",29,"ب",1,0],["لَم يَطرُقوا الشامَ إِلّا بَعدَ أَن جَمَعوا","مِنَ العَشيرَةِ مُختاراً وَمُغتَصَبا",30,"ب",2,0],["لم يَطب لي لؤلا الحبيبُ مقام","بك يا سجنَ كل حرّ نبيلِ",31,"ل",1,0],["لم يُطيقوا أ يدفعوا نوب الأ","يّامِ عنهم فسيَّروا ألأسماءَ",32,"ا",2,0],["لَم يَطغَ فيها بَصَري مُجاوِزاً","عَن رُتَبي وَإِن تَناهى بي السَدَر",33,"ر",1,0],["لَم يَطمَعِ اللَيلُ مِنّي أَن أَرِقَّ لَهُ","يَنسى جِناياتِهِ الناسي عَلى الناسِ",34,"س",1,1],["لَم يُطاوِعْنَ بِصُرْمٍ عاذِلاً","كادَ مِن شِدَّةِ لَوْم يَنْتَحِرْ",35,"ر",1,0],["لَم يُطرِ ما بي لا وَلا مرَّ بي","كَأَنَّ سَقمي كانَ من شَهوَتِهِ",36,"ت",2,0],["لم يطرقِ النومُ بابَ الجفنِ من أسفٍ","فما ارتقا بي لطيف منك يطرقني",37,"ي",1,0],["لم يطش لي سهم إذا أنا س","دَّدْتُ إلى غاية المطالب سهما",38,"م",2,0],["لم يطربوا إلّا بذكرِ حبيبهم","ولهم بطولِ زمانهِم أفراحُ",39,"ح",1,0],["لم يُطِقْ هواهُ فَباحا","عندما رام الخليطَ ورواحا",40,"ح",2,1],["لم يطرق النوم أجفاني ولا عجب","من بعد فرقتكم أنى تجافاني",41,"ن",2,0],["لم يطلبوا السلم إلا بعد علمهم","بأن سيفك لا يبقي ولا يزرُ",42,"ر",1,0],["لم يطلُعِ البدرُ المنيرُ ببلْدَةٍ","إِلّا لكُمْ فِيهَا هلالٌ طالِعُ",43,"ع",1,0],["لم يَطُلْ بيننا غداةَ اِفترقنا","من حِذارٍ ضمٌّ ولا تسليمُ",44,"م",1,0],["لم يطعَمِ الغُمْضَ قلبٌ فيه مُقْتَسَمٌ","وإِنّه لقريرٌ العين بالسَّهَرِ",45,"ر",1,0],["لم يطعموا الموتَ إلّا بَعد أنْ حطموا","بالضّربِ والطعنِ أعناقَ الصَّناديدِ",46,"د",1,0],["لم يُطِيقُوا الهُروبَ ضَعْفاً وعَجْزاً","هل يُطيقوا الهروبَ عَقْرى وزَمْنى",47,"ن",2,0]]}