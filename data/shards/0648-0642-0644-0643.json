{"poems":[[276,"لي في نوالك يا مولاي آمال","https://www.aldiwan.net/poem52046.html","البسيط"],[463,"أروض الوادي أم ابيض الغسق","https://www.aldiwan.net/poem56090.html","الرجز"],[563,"شهدت القديم الحق بالحادث الفاني","https://www.aldiwan.net/poem33708.html","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202085","الطويل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141281","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49579","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83211","الوافر"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74270","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91961","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91999","البسيط"],[5689,"هنا بين هذا الدوح والزهرات","https://www.poetsgate.com/ViewPoem.aspx?id=143393",""],[5690,"ماذا الشفيع وماذا ينفع الحذرُ","https://www.poetsgate.com/ViewPoem.aspx?id=172157",""]],"verses":[["وَقل كفيتك يا عَبد الرَحيم أَذى","الدارين فانزل حمى ما فيه اهمال",0,"ل",1,0],["وقل كما شاء الندى لخالدٍ","قولةَ لا تخلُّبٍ ولا مَلَقْ",1,"ق",1,0],["وقل كل شيء هالك غير وجهه","كما جاء عنه القول في وحي قرآن",2,"ن",1,0],["وقُلْ كيفَ أنتم بعْدُ عَهدي فإنني","بُليتُ بأهْوَالٍ تُشيبُ النَّواصِيا",3,"ي",2,0],["وقل كما قال أيّوب النّبيّ لدى","فقدان أولاده يا نعم ما قالا",4,"ل",2,0],["وقلْ كيفَ كانَ الدهرُ إذ كنتَ شاكيَاً","ولو بَهَرَتْ فيه النباهةُ والنبل",5,"ل",1,0],["وَقُل كونوا جَميعاً في اِئتِلافٍ","يَزِد رِفدُ البِلادِ مِنَ المَواتِ",6,"ت",1,0],["وَقُل كَيفَ خَلفت العَقيق وَأَهله","فَشَوقي بِهم شَوقي وَوجدي بِهم وَجدي",7,"د",2,0],["وَقل كثيرٌ عَلى ابن المَوت ما ملكت","يُمناه من عيشها زاداً لمرتحل",8,"ل",1,0],["وَقُل كثيرٌ قَليلُ العَيشِ عِندَ فَتىً","يَنتابه الملبسان الخزُّ وَالكَفن",9,"ن",1,0],["وقل كيف طعم الموت، ماذا وجدته","أمامك في الظلماءذي الحفرات؟",10,"ت",1,0],["وقل كما شئت فيه أن غضبت وأن","رضيت سيَّان لا همٌ ولا ضررُ",11,"ر",1,0]]}