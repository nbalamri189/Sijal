{"poems":[[93,"باعوا المخلد بالحطام الفاني","https://www.aldiwan.net/poem11248.html","الكامل"],[93,"عد لابساً ثوب الخلود وعلم","https://www.aldiwan.net/poem11356.html","الكامل"],[88,"نزلت تجر إلى الغروب ذيولا","https://www.aldiwan.net/poem44454.html","الكامل"],[88,"هلم نبك النهى والعلم والشرفا","https://www.aldiwan.net/poem45047.html","البسيط"],[72,"قدمت كالسيف إلى غمده","https://www.aldiwan.net/poem18559.html","السريع"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[45,"أنافعي عند ليلى فرط حبيها","https://www.aldiwan.net/poem66850.html","البسيط"],[105,"أقبل نعيم هداك ربك ساريا","https://www.aldiwan.net/poem44192.html","الكامل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[75,"هل كان ضمخ بالعبير الريحا","https://www.aldiwan.net/poem69095.html","الكامل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85389","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16673",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55048","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[113,"خبر طوى شقق البقاع فاخبرا","https://www.aldiwan.net/poem41104.html","عموديه"],[141,"لو أن شامخ قدر دافع قدرا","https://www.aldiwan.net/poem11764.html","البسيط"],[141,"أرقدت عن قلق الفؤاد مشوقه","https://www.aldiwan.net/poem11787.html","الكامل"],[180,"رمس به من آل طنبة راحل","https://www.aldiwan.net/poem61144.html","الكامل"],[180,"قف عند قبر توارت فيه ذات تقى","https://www.aldiwan.net/poem66930.html","البسيط"],[237,"الله ربي والحنيفةُ ديني","https://www.aldiwan.net/poem1095.html","الكامل"],[237,"لمقامك التعظيم والتبجيل","https://www.aldiwan.net/poem23840.html","الكامل"],[295,"ما طاب ليل الوصل إلا وانبرى","https://www.aldiwan.net/poem33251.html","الكامل"],[295,"ألية بانعطاف القامة النضرة","https://www.aldiwan.net/poem33265.html","البسيط"],[301,"كلفي بساق كل وعد منه لي","https://www.aldiwan.net/poem57800.html","الكامل"],[351,"أأنت أم أنا أم ما نلت من رتب","https://www.aldiwan.net/poem40818.html","البسيط"],[362,"يا أيها المولى الذي","https://www.aldiwan.net/poem60663.html","مجزوء الكامل"],[377,"عظمت من الله المواهب","https://www.aldiwan.net/poem48755.html","مجزوء الكامل"],[406,"باح بشكوى ما به فاستراح","https://www.aldiwan.net/poem32606.html","السريع"],[436,"إن تفخر الدنيا فأنت فخارها","https://www.aldiwan.net/poem34810.html","الكامل"],[436,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[438,"ألق العصي فهذا مقتضى الأرب","https://www.aldiwan.net/poem14330.html","البسيط"],[438,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[446,"لم يقنع البين في شملي بما فعل","https://www.aldiwan.net/poem53765.html","البسيط"],[456,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[456,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[477,"يا راكب الرتل السريع","https://www.aldiwan.net/poem37043.html","مجزوء الكامل"],[560,"زر قبر سلمان تلحوق الذي اشتهرت","https://www.aldiwan.net/poem52552.html","البسيط"]],"verses":[["حَتَّى قَضَيْتَ شَهِيدَ رَأيِكَ وَانْقَضَى","مَاكُنْتَ تَلْقَى دُونَهُ وَتُعَانِي",0,"ن",2,0],["حَتَّى قَضَتْ لَكَ أُمَّةٌ شَرَّفْتَهَا","حَيّاً وَمَيْتاً بِالمَقَامِ الأَعْظَمِ",1,"م",1,0],["حتى قضت روح الضياء ولم يكن","غير الظلام هناك عزرائيلا",2,"ل",2,0],["حتى قضى راسباً في مكرهم غرقاً","إذ عطّل الموت منه الكفّ والكتفا",3,"ف",2,0],["حتَّى قضيت النسك من بعدِ ما","قضيت نسك الجود في وفده",4,"د",2,0],["حَتّى قَضى عِندَ مَدى آمالِهِ","لَو تَعرِفُ الآمالُ بِالنَفس مَدى",5,"ا",1,0],["حَتّى قَطَعتَ بِها القاطولَ وَاِفتَرَقَت","بِالحَيرِ في عَرصَةٍ فيحٍ نَواحيها",6,"ي",3,0],["حتى قضاها سَمحةً مقبولةً","مُتهجّداً يتلو الكتابَ مُناجيا",7,"ي",2,0],["حَتّى قَضى اللَهُ لَهُ بِالفَتحِ","مِن بَعدِ طولِ تَعَبٍ وَكَدحِ",8,"ح",1,0],["حتَّى قضَى بالنَّصْرِ دينُكَ دِينهُ","وغَدَا لِدِينِ الكافِرِين مُزيلا",9,"ل",2,0],["حتى قَطَعْنَ إلى العراقِ الشأمَ عن","عُرُضٍ وخُضنَ إلى الفُراتِ النيلا",10,"ل",2,0],["حتى قَرَنْتَ الشمْلَ والتفريقَ في","عَرَصَاتهمْ والنّبْتَ والتّصْويحا",11,"ح",2,0],["حتّى قَضَى مِنهُنَّ كُلَّ حاجَهْ","وافتُتحَتْ أَكْشُونَبه وباجّه",12,"ه",1,0],["حتىّ قَضَت حزناً وذلك بعدما","عبثت بناعم جسمها الأوصاب",13,"ب",1,0],["حتى قَضَيْتَ طَوافَها","سَبْعاً وزُرْتَ جِبالَها",14,"ل",3,0],["حَتى قَضَى الأَيَّامَ لاَ يَلْقَى بِهَا","إِلاَّ تَجِلَّةَ مُكْبِرٍ أَوْ وَامِقِ",15,"ق",1,0],["حَتَّى قَضَى فِي يَأْسِهِ","دَنِقاً مَشُوقاً غَيْرَ صَابِرْ",16,"ر",1,0],["حتى قضت مرضية مبرورة","وسرت وحينها يحمد القوم السرى",17,"ر",2,0],["حَتّى قَضى ما قَضى مِن لَذَّةٍ وَطَراً","وَكَم قَضَت مِنهُ آمالُ الوَرى وَطَرا",18,"ر",2,0],["حَتّى قَرَنتُ بِدُرِّهِ ياقوتَهُ","وَسِوايَ يَقرِنُ دُرَّهُ بِعَقيقِهِ",19,"ق",2,0],["حَتّى قَضى وَمَضى فَحَلَّ بِمَرتَعٍ","يَغشى العُيونَ بِهِ جَمالُ المَوقِفِ",20,"ف",1,0],["حَتّى قَضَت وَمَضَت نَحوَ النَعيم وَقَد","فازَت بِراحَتِها في دارِ مَولاها",21,"ا",3,0],["حتى قضوا لكنهم أبقوا به","أثرا كندبة طعنة المطعون",22,"ن",1,0],["حتى قضى بيد الإمام وكل من","قَتل البريء فإنه مقتول",23,"ل",1,0],["حتّى قضيتُ به لُباناتِ الهَوى","وَحمدتُ عند الصُبح عاقبةَ السُرى",24,"ر",2,0],["حَتّى قَضى بنَوى الأَحباب كلِّهم","فَلَم أَزَل بعدهم في عيشةٍ كدِرَه",25,"ر",2,0],["حتى قطعت مطامعي في وعده","ونسيت عرقوباً بهذا الساق",26,"ق",1,0],["حَتّى قَضى اللَه أَن نَبني الَّذي دَرَست","مِن مجدِنا عَثَرات الدَهر وَالنوبِ",27,"ب",1,0],["حَتّى قَضَيتُ مَآرِبي","في ظِلِّ أَروَعَ ذي شَهامَه",28,"م",2,0],["حَتّى قَضى بِشُروقِهِ","رَب المَشارق وَالمَغارب",29,"ب",1,0],["حتَى قَضى الدّهرُ بتفريقنا","فما احتيالي في القضاءِ المُتاحْ",30,"ح",1,0],["حَتَّى قَدِمْتَ بِمَفْخَرِ الفَتْحِ الَّذِي","أَحْيا المُنى بقدومِهِ اسْتِبْشَارُها",31,"ر",3,0],["حتى قَدِمْتَ وَمَا تَقَلَّبَ ناظِرٌ","إِلّا لَهُ بقدُومِكَ استِبشارُ",32,"ر",1,0],["حتى قرعت عليك الباب يا هادي","بعد الكلال وبعد النص واللتعب",33,"ب",1,0],["حتى قضى نحبا فها هي أَصبحت","كالحيزبون الشوهة الغبراء",34,"ا",2,0],["حتى قضى ببعاد الدار ثانية","لكي أفارق أمواتا وأحياءا",35,"ا",2,0],["حتى قضى اللّهُ لحظَّيْهما","عندك قسماً كلُّه وافرُ",36,"ر",1,0],["حتى قضى الصبرُ لهم قَضاءَهُ","واستحيتِ الأيَّام مما نَصبوا",37,"ب",3,0],["حتى قضى مستبشرا","ونعاه ناعيه المريع",38,"ع",1,0],["حتَّى قَضَى والي المولى مَضَى فإذا","أرَّختَ قُلْ عندَ مَولَى الخَلقِ سَلْمانُ",39,"ن",1,0]]}