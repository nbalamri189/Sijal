دِرَّةِ ثَدْيِ الحُبِّ مَلْبُونُ","https://www.poetsgate.com/ViewPoem.aspx?id=63587",""],[5582,"خلّ المتيّم في نهج الغواياتِ","https://www.poetsgate.com/ViewPoem.aspx?id=63473",""],[5638,"يا قدس صبرًا","https://www.poetsgate.com/ViewPoem.aspx?id=198037",""],[5937,"الثُّقب الأسود","https://www.poetsgate.com/ViewPoem.aspx?id=214121",""],[6019,"يا أَيُّهَا ( الجَمرِيُّ ) أَشعَلَ أَضلُعِي","https://www.poetsgate.com/ViewPoem.aspx?id=137671",""],[6019,"ما لي أراني","https://www.poetsgate.com/ViewPoem.aspx?id=176718",""],[6056,"كفيّ ، طوّ قت معصمه","https://www.poetsgate.com/ViewPoem.aspx?id=130137",""],[6068,"قَدْ جُزْتُ بالسلفيّ عَادِلْ -09-","https://www.poetsgate.com/ViewPoem.aspx?id=175812",""],[463,"لعلها واليأسُ منها أغلبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59974&r=&rc=30",""],[6305,"حياتي ... أنْ أموتَ فِداك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87348&r=&rc=22",""],[6355,"بيتٌ ومصراع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66658&r=&rc=118",""]],"verses":[["حَتَّى قَضَيْتَ شَهِيدَ رَأيِكَ وَانْقَضَى","مَاكُنْتَ تَلْقَى دُونَهُ وَتُعَانِي",0,"ن",2,0],["حَتَّى قَضَتْ لَكَ أُمَّةٌ شَرَّفْتَهَا","حَيّاً وَمَيْتاً بِالمَقَامِ الأَعْظَمِ",1,"م",1,0],["حتى قضت روح الضياء ولم يكن","غير الظلام هناك عزرائيلا",2,"ل",2,0],["حتى قضى راسباً في مكرهم غرقاً","إذ عطّل الموت منه الكفّ والكتفا",3,"ف",2,0],["حتَّى قضيت النسك من بعدِ ما","قضيت نسك الجود في وفده",4,"د",2,0],["حَتّى قَضى عِندَ مَدى آمالِهِ","لَو تَعرِفُ الآمالُ بِالنَفس مَدى",5,"ا",1,0],["حَتّى قَطَعتَ بِها القاطولَ وَاِفتَرَقَت","بِالحَيرِ في عَرصَةٍ فيحٍ نَواحيها",6,"ي",3,0],["حتى قضاها سَمحةً مقبولةً","مُتهجّداً يتلو الكتابَ مُناجيا",7,"ي",2,0],["حَتّى قَضى اللَهُ لَهُ بِالفَتحِ","مِن بَعدِ طولِ تَعَبٍ وَكَدحِ",8,"ح",1,0],["حتَّى قضَى بالنَّصْرِ دينُكَ دِينهُ","وغَدَا لِدِينِ الكافِرِين مُزيلا",9,"ل",2,0],["حتى قَطَعْنَ إلى العراقِ الشأمَ عن","عُرُضٍ وخُضنَ إلى الفُراتِ النيلا",10,"ل",2,0],["حتى قَرَنْتَ الشمْلَ والتفريقَ في","عَرَصَاتهمْ والنّبْتَ والتّصْويحا",11,"ح",2,0],["حتّى قَضَى مِنهُنَّ كُلَّ حاجَهْ","وافتُتحَتْ أَكْشُونَبه وباجّه",12,"ه",1,0],["حتىّ قَضَت حزناً وذلك بعدما","عبثت بناعم جسمها الأوصاب",13,"ب",1,0],["حتى قَضَيْتَ طَوافَها","سَبْعاً وزُرْتَ جِبالَها",14,"ل",3,0],["حَتى قَضَى الأَيَّامَ لاَ يَلْقَى بِهَا","إِلاَّ تَجِلَّةَ مُكْبِرٍ أَوْ وَامِقِ",15,"ق",1,0],["حَتَّى قَضَى فِي يَأْسِهِ","دَنِقاً مَشُوقاً غَيْرَ صَابِرْ",16,"ر",1,0],["حتى قضت مرضية مبرورة","وسرت وحينها يحمد القوم السرى",17,"ر",2,0],["حَتّى قَضى ما قَضى مِن لَذَّةٍ وَطَراً","وَكَم قَضَت مِنهُ آمالُ الوَرى وَطَرا",18,"ر",2,0],["حَتّى قَرَنتُ بِدُرِّهِ ياقوتَهُ","وَسِوايَ يَقرِنُ دُرَّهُ بِعَقيقِهِ",19,"ق",2,0],["حَتّى قَضى وَمَضى فَحَلَّ بِمَرتَعٍ","يَغشى العُيونَ بِهِ جَمالُ المَوقِفِ",20,"ف",1,0],["حَتّى قَضَت وَمَضَت نَحوَ النَعيم وَقَد","فازَت بِراحَتِها في دارِ مَولاها",21,"ا",3,0],["حتى قضوا لكنهم أبقوا به","أثرا كندبة طعنة المطعون",22,"ن",1,0],["حتى قضى بيد الإمام وكل من","قَتل البريء فإنه مقتول",23,"ل",1,0],["حتّى قضيتُ به لُباناتِ الهَوى","وَحمدتُ عند الصُبح عاقبةَ السُرى",24,"ر",2,0],["حَتّى قَضى بنَوى الأَحباب كلِّهم","فَلَم أَزَل بعدهم في عيشةٍ كدِرَه",25,"ر",2,0],["حتى قطعت مطامعي في وعده","ونسيت عرقوباً بهذا الساق",26,"ق",1,0],["حَتّى قَضى اللَه أَن نَبني الَّذي دَرَست","مِن مجدِنا عَثَرات الدَهر وَالنوبِ",27,"ب",1,0],["حَتّى قَضَيتُ مَآرِبي","في ظِلِّ أَروَعَ ذي شَهامَه",28,"م",2,0],["حَتّى قَضى بِشُروقِهِ","رَب المَشارق وَالمَغارب",29,"ب",1,0],["حتَى قَضى الدّهرُ بتفريقنا","فما احتيالي في القضاءِ المُتاحْ",30,"ح",1,0],["حَتَّى قَدِمْتَ بِمَفْخَرِ الفَتْحِ الَّذِي","أَحْيا المُنى بقدومِهِ اسْتِبْشَارُها",31,"ر",3,0],["حتى قَدِمْتَ وَمَا تَقَلَّبَ ناظِرٌ","إِلّا لَهُ بقدُومِكَ استِبشارُ",32,"ر",1,0],["حتى قرعت عليك الباب يا هادي","بعد الكلال وبعد النص واللتعب",33,"ب",1,0],["حتى قضى نحبا فها هي أَصبحت","كالحيزبون الشوهة الغبراء",34,"ا",2,0],["حتى قضى ببعاد الدار ثانية","لكي أفارق أمواتا وأحياءا",35,"ا",2,0],["حتى قضى اللّهُ لحظَّيْهما","عندك قسماً كلُّه وافرُ",36,"ر",1,0],["حتى قضى الصبرُ لهم قَضاءَهُ","واستحيتِ الأيَّام مما نَصبوا",37,"ب",3,0],["حتى قضى مستبشرا","ونعاه ناعيه المريع",38,"ع",1,0],["حتَّى قَضَى والي المولى مَضَى فإذا","أرَّختَ قُلْ عندَ مَولَى الخَلقِ سَلْمانُ",39,"ن",1,0],["حَتّى قَضى وَالمَوتُ فينا سَنَةً","وَسُيوفُ مَدرَجِهِ رَواتِعٌ في الطَلا",40,"ل",2,0],["حتّى قَضى فرداً وحي","داً أفتديهِ من وحيدِ",41,"د",1,0],["حتى قضوا فغدا كل بمصرعه","سكينةٌ وسط تابوتٍ من الكثب",42,"ب",1,0],["حَتّى قَضى اللَه بِالتِرحال عنه فَقَد","أَمسى الحَبيب بظهر الغيب مُحتَجِبا",43,"ب",2,0],["حتى قضى عليهم ال","خصم بشر الكرب",44,"ب",1,0],["حتى قَرَى الوحوشَ في القفار","وعافياتِ الطَّير في الأوكار",45,"ر",1,0],["حتى قضيتَ وما قضيتَ مآربا","وهو النفوس حياتها وَرَداها",46,"ا",3,0],["حتّى قَدِمنا على الزاكي عرار أبي الط","طيب الّذي قاله الطبن الميامينُ",47,"ن",1,0],["حتّى قَدمن بنا بعد الكلال على","أعزّ أروع زاكي الوجد ميمونِ",48,"ن",1,0],["حتّى قصدتُ إِلى أبي الطيبِ الّذي","بِالجاهِ للجادي يجودُ وبالجدا",49,"د",2,0],["حتّى قدمت بنا بعد الكلال على","متوّجٍ مالكٍ عقد الرياساتِ",50,"ت",1,0],["حتى قَدِمْتُ على أَغرُّ مُتوَّجِ","جَدْواهُ رَحْمةُ ربِّهِ في أَرْضِهِ",51,"ض",2,0],["حَتَّى قَهَرْتَ الأعادي","بِشَأْمِنا غَيْرَ هائِبْ",52,"ب",1,0],["حتى قضوا بجهدهم","حق الجهاد الواجب",53,"ب",1,0],["حتّى قضى الدهر منه بالنوى فغدا","منها مليّ الملاهي يشتكي الفلَسا",54,"س",2,0],["حتَّى قضت حيث ما عليها","في غربة البينِ من ينوحُ",55,"ح",1,0],["حتى قضى الله بأن تَرجعي","بكل تكريم إلى أهلك",56,"ك",1,0],["حتى قضى عطشا قتيل أراذل","تستحقر الشفتان ذم صفاتها",57,"ت",3,0],["حتى قرعت السن من ندم","وقطعت خمس أناملي عضا",58,"ض",2,0],["حتى قضى بالسيف عطشاناً ولم","يبرح ندى كفيه يروي العطشا",59,"ش",2,0],["حتى قضى اللَه أن أحظى بقُربِكَ يا","مليكةَ الحُسنِ عن أمٍّ لها وأبِ",60,"ب",1,0],["حتى قضى نحبه فيهم فدب لهم","من المكاره حيّات وأصلالُ",61,"ل",1,0],["حتى قضى الدهر الخؤون بفرقة","قد كنت احسبها كطيف خيال",62,"ل",1,0],["حتى قضينا بها ما سن من قرب","رميا وحلقا وتقريبا لقربان",63,"ن",1,0],["حتى قضوا حق المكارم والعلى","بسيوفهم وتقمصوا أطمارها",64,"ر",3,0],["حتى قضى فعلى الدنيا العفا فلقد","أودى بمهجة طه حادث الزمن",65,"ن",1,0],["حتى قضى والماء يجري","وهو ملهوف الفؤاد",66,"د",1,0],["حتى قرأتُ كتابه وحديثه","عن نفسه في ضربه الأمثالا",67,"ل",2,0],["حتّى قَضى اسفا على رجل","ما ان له من بعده بدل",68,"ل",1,0],["حتى قضى صابراً ظمئانَ محتسباً","نفسي الفداء لظاميها وصابِرها",69,"ر",3,0],["حتى قضى وله الرسلُ الهداةُ غدت","في مَدمعٍ كغوادي المزن مُنهمل",70,"ل",1,0],["حتى قضى عطشا بمعترك الوغى","والسمر تصدر منه في نهلاتها",71,"ت",3,0],["حتى قطعت الطباق سبعاً","وكان فيها عظيم شاني",72,"ن",2,0],["حتى قضى جهدا وراح شبابه","ونأى عن الزوار أي تناء",73,"ا",2,0],["حتى قريضي لا يسير بوصفه","بغضاً له وإذا تقيدّ يفلت",74,"ت",1,0],["حتى قضوا نهب القنا والظبا","ما بين كهل أو فتى أمرد",75,"د",1,0],["حتّى قضَوْا طوْعَ الجِهادِ وخلّفوا","خُلَفاءَ أُنْجِزَ بالعُلى مَوْعودُها",76,"د",3,0],["حتى قضى بالسم تفديه الورى","من بعد أوصابٍ وطول شجون",77,"ن",1,0],["حتى قضوا في نصر آل أحمد","من رغبة بجهدهم ما يجب",78,"ب",1,0],["حتى قضى وبعينيه قذى وشجىً","بحلقه أسفاً والقلبُ في ضرم",79,"م",1,0],["حتى قضى بابي فقل لذوي الهدى","هاديكم قد حل في الأرماس",80,"س",1,0],["حتى قضوا حق العلا وانتصفوا","من معشرٍ عن الهدى قد نكبوا",81,"ب",3,0],["حتى قضوا عطشى بصدرٍ","مثقفٍ وبحد صارم",82,"م",1,0],["حتى قضيت وما قضى منك الهدى","وطراً ونال القصد فيك طغامها",83,"م",3,0],["حتى قنعنا اضطراراً","منه بمص الأصابع",84,"ع",1,0],["حَتى قَضيتُ مآربي","وَصرمتها صَرم المرَس",85,"س",1,0],["حتى قدحت من الآسنة والظبى","نار المنون فأشعلت إشعالا",86,"ل",2,0],["حَتّى قَدَّمنا بِاِعتِجالُ سَترِهِ","وَاللّهِ مُسبِل عَلَينا سَترَهُ",87,"ه",1,0],["حتى قضوا نهب القنا والظبا","ما بين كهل أو فتى أمردا",88,"د",2,0],["حتى قدمتَ على المصلى مخلصاً","للهِ طاعةَ مخبتٍ قوّام",89,"م",1,0],["حتى قضى بنجيع السم ممتثلاً","لأمر بارئه في السر والعلن",90,"ن",1,0],["حتى قضى وبشهر شوال مضى","أرخت حاز الختم في الإيمان",91,"ن",1,0],["حتى قضى ومضى وابقى بعده ال","ذكر الحميد إلى الزمان القادم",92,"م",1,0],["حتَّى قَدِمْتُ على مقامٍ عنده","بشَّرتُ آمالي بأسعدِ مَقْدَم",93,"م",1,0],["حتى قدمت وصار الشمل مجتمعاً","وقد حلى الشرب بعد العلقم الصبر",94,"ر",1,0],["حتى قطعتَ مسافاتٍ وأزمنةً","منها عرفت الذي ما كنت تعرفهُ",95,"ف",2,0],["حتّى قطفتَ الياسَمِينَ بِجَنَّةٍ","شوْقَاً وقطفُ الياسَمِينِ هِوَايَتِي",96,"ت",2,0],["حتى قد فُلَّتْ شوكتنا","والهمة راحت والشيم",97,"م",1,0],["حتى قضى الله أمراً فيه قد وُضعتْ","منها عمود الضيا بالُحسن ينفجرُ",98,"ر",1,0],["حتى قد بانت عورتها","للناظر منظرها أفزع",99,"ع",1,0],["حتى قد جفَّف منبَعها","لم يبقِ به قرشاً ينفع",99,"ع",1,0],["حتّى قضى ربُّ العباد بنصرهم","والجنّة العليا مقرُّ فتاها",100,"ا",3,0],["حتى قناديلُه يعوي الهزيعُ بها","لمْ يقترحْها على الظلماءِ إيقادُ",101,"د",1,0],["حتَّى قيَاصِرَةُ الرُّومَانِ قَدْ قَصُرَتْ","أخبَارُهُمْ مِثلمَا الأكاسِرُ انكسَرُوا",102,"ر",3,0],["حتى قضى في حضنها أوصَى لهَا","لحْنَ الجهادِ بأنْ تظلَّ تُردِّدَا",103,"د",2,0],["حتى قضيتَ وما قضيتَ مآرا","وهوى النفوس حياتها وَرَداها",104,"ا",3,0],["حَتَّى قَدِمْتُ عَلَى فَلاحٍ خَيْرِ مَنْ","قَطَعَتْ بِهِ عَرْضَ السَّباسِبِ كُومُها",105,"م",3,0],["حَتَّى قَدِمْتُ عَلَى مَنْ لَيْسَ يَشْغَلُهُ","عَنْ المَحامِدِ أَقْداحٌ وَأَلْحانُ",106,"ن",1,0],["-حَتَّى قَدِمْنا عَلَى الزَّاكِي عَرارِ أَبِي ال","طِّيبِ الَّذِي فأْلُهُ الطَّيْرُ المَيامِينُ",107,"ن",1,0],["حَتَّى قَدِمْنا بِها بَعْدَ الكَلالِ عَلَى","مُتَوَّجٍ مالِكٍ عَقْدَ الرِّئاساتِ",108,"ت",1,0],["حَتَّى قَرِيضِي أَسِيرٌ مِثْلُ شَاعِرِهِ","لَكِنَّ يَوْمًا سَيُضْحِي فِيهِ كَالْحُمَمِ",109,"م",1,0],["حتى قطفت قصيدتي فتساقطت","فوقي بكور القافيات ، كِعابا",110,"ب",2,0],["حتَّى قَوافي الشِّعرِ تَاهَتْ منْ يدي","فإذا بِهَا قد أَربَكَتْ أَوزَانَا",111,"ن",2,0],["حتَّى قَوافيهِ لَزِمْنَّ الصَّمتَ في","أُطُرٍ ، تَقَاصَرَ بالسكوتِ تَمَدُّدُهْ",112,"د",2,0],["حتى قافي عصاني ، فيه وأنا أنظمه","قام يرجع خلافه ، ماعرفت السبب",113,"ب",1,0],["حَتَّى قَدَرْتُ عَلَى زَواجٍ","بِحَبيبَةٍ يا حُلْوَ عَاجِلْ",114,"ل",1,0],["حتى قضى الصبرُ لهم قضاءهُ","واستحييتِ الأيام مما نصبوا",115,"ب",3,0],["حتّى قضيتُ ثلاثاً بعدَها وأنا","ما بينَ مُنكسِر ٍفيها ومندحِر",116,"ر",1,0],["حَتَّى قصيدتها الشمطاءُ مُنْتِنَةٌ","تعافُها أعينٌ مِنَّا وأسْماعُ",117,"ع",1,0]]}