{"poems":[[77,"أقوى المحصب من هاد ومن هيد","https://www.aldiwan.net/poem69092.html","الطويل"],[48,"ليذمم والدا ولد ويعتب","https://www.aldiwan.net/poem23172.html","الوافر"],[280,"تهاب السيوف البيض والأسل السمر","https://www.aldiwan.net/poem25549.html","الطويل"],[287,"أريقك أم صهباء في الكأس إسفنط","https://www.aldiwan.net/poem32718.html","الطويل"],[303,"تسر الناظرين فراشتان","https://www.aldiwan.net/poem36854.html","عموديه"],[457,"لك الطائر الميمون فاسرج به طرفا","https://www.aldiwan.net/poem13844.html","الطويل"],[498,"تنكب مذهب الهمج","https://www.aldiwan.net/poem67404.html","مجزوء الوافر"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124754","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106974","الرجز"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87366","الطويل"],[4217,"","https://poetry.dctabudhabi.ae/diwan/poem/123953","الطويل"],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5105,"إلام اتباعي للأماني الكواذبِ","https://www.poetsgate.com/ViewPoem.aspx?id=135342",""],[5718,"\"إلهى\"","https://www.poetsgate.com/ViewPoem.aspx?id=213785",""]],"verses":[["فمن ضميرٍ بصدْقِ القوْلِ مشتملٍ","ومن لِسانٍ بِحُرّ المدحِ غِرِّيد",0,"د",1,0],["فَمِن ضارٍ يُمَزِّقُ مِنهُ شِلواً","وَيُعطي فَضلَ أَكرُعِهِ جُعالَه",1,"ل",2,0],["فَمَنْ ضَامَهُ دَهرٌ وأَلوَى بِوَفْرِهِ","فَمِنِّي له نَصرٌ وعِندِي له وَفْرُ",2,"ر",1,0],["فَمِن ضَربِهِ طولاً وَعَرضاً بِسَيفِهِ","يُرى القَدُّ في صَرعى أَعاديهِ وَالقطُّ",3,"ط",1,0],["فمنْ ضَمٍّ إِلى نشرٍ لوثبٍ","لرفرفةٍ إِلى حربٍ عوان",4,"ن",1,0],["فمن ضارعٍ تحت الظلام وخاشعٍ","يبيت بها ينحاز للمورد الأصفى",5,"ف",2,0],["فمن ضيقٍ إلى سِعَةٍ","ومن غَمٍ إلى فرجِ",6,"ج",1,0],["فمن ضرب الأولاد ضرب مؤدّب","وزوجته عند النشوز المنكد",7,"د",1,0],["فمن ضعيف لجريح انتمي","ومرسل منه إلى الأعشى انتسب",8,"ب",1,0],["فمن ضاربٍ سيفاً ومن طاعنٍ قناً","اذا التقتِ الابطال في الكَرِّ وَالفَرِّ",9,"ر",1,0],["فمن ضلّ عن لذاته واهتدى بها","رآها الى اللذات اوضح منهجا",10,"ج",2,0],["فمن ضءضئي الأقطاب عنصر","طيبه فوازاهم مجدا وأم واقدما",11,"م",2,0],["فمن ضلَّ عن طُرْقِ العلاء فإنني","دُلِلْتُ عليها بالقَنَا والقواضب",12,"ب",1,0],["فَمِنْ ضَعْفٍ تُغَالِبُنِي","فَإِنَّ النَّفْسَ مِنْ طِينِ",13,"ن",1,0]]}