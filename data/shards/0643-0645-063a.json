حياء","https://www.poetsgate.com/ViewPoem.aspx?id=127081",""],[3271,"دمعة في قلب الليل","https://www.poetsgate.com/ViewPoem.aspx?id=102704",""],[5072,"يا رمزنا أنت قد بعناك","https://www.poetsgate.com/ViewPoem.aspx?id=53759",""],[3591,"لا يعجبنك حسن قط إن لمحت","https://www.poetsgate.com/ViewPoem.aspx?id=149427",""],[5121,"رِيَاضُ","https://www.poetsgate.com/ViewPoem.aspx?id=215126",""],[5121,"لُبْنَان","https://www.poetsgate.com/ViewPoem.aspx?id=215298",""],[5187,"نغم عذري","https://www.poetsgate.com/ViewPoem.aspx?id=33002",""],[5189,"يا هاجر الصلواتِ","https://www.poetsgate.com/ViewPoem.aspx?id=196887",""],[5226,"القدس .. في القلب","https://www.poetsgate.com/ViewPoem.aspx?id=24251",""],[5232,".. الشاعرة الحسناء ..","https://www.poetsgate.com/ViewPoem.aspx?id=211254",""],[307,"القطار","https://www.poetsgate.com/ViewPoem.aspx?id=215236",""],[5428,"أراني كُلّما قطعوا المزارا","https://www.poetsgate.com/ViewPoem.aspx?id=124932",""],[5431,"أهواك حيّا ..","https://www.poetsgate.com/ViewPoem.aspx?id=196754",""],[5431,"أي صبرٍ على الطُوى رمضانُ","https://www.poetsgate.com/ViewPoem.aspx?id=198195",""],[5431,"ماروته شهرذاد...","https://www.poetsgate.com/ViewPoem.aspx?id=202447",""],[5459,"أخرستُ أصواتي ..","https://www.poetsgate.com/ViewPoem.aspx?id=202213",""],[5542,"ليس هذا عيدي","https://www.poetsgate.com/ViewPoem.aspx?id=10193",""],[5573,"ياعين مالك بالسهر زود راحه","https://www.poetsgate.com/ViewPoem.aspx?id=200080",""],[5582,"طَرَقَ الطَّيْفُ وَقَدْ زارَ وِسادِي","https://www.poetsgate.com/ViewPoem.aspx?id=186881",""],[5582,"هَلْ مِنْ مُجِيدٍ لِي بِأَنْباءِ","https://www.poetsgate.com/ViewPoem.aspx?id=186648",""],[5582,"إِنَّما نَوْحُ الحَمامِ","https://www.poetsgate.com/ViewPoem.aspx?id=63567",""],[5616,"تعليق هامشي على هامش أحداث هامشية!","https://www.poetsgate.com/ViewPoem.aspx?id=205035",""],[5642,"الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=123668",""],[5674,"تغازل مصرعك","https://www.poetsgate.com/ViewPoem.aspx?id=190748",""],[5689,"ما بال دمعك ينهمر","https://www.poetsgate.com/ViewPoem.aspx?id=143433",""],[5739,"ساحر البطه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127034",""],[5753,"خاتمة المنى","https://www.poetsgate.com/ViewPoem.aspx?id=207645",""],[5758,"تَرَاتِيلُ الشَّمْس","https://www.poetsgate.com/ViewPoem.aspx?id=200496",""],[5842,"استغفرُ الله / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=135811",""],[5937,"صلاةُ الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=211799",""],[5956,"مُقَلُ النِّسوانْ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182614",""],[6093,"مَاذَا بِأرضيَ غَيْرُ مَكَةَ والمَديْنَه","https://www.poetsgate.com/ViewPoem.aspx?id=181835",""],[6120,"الْمَاءُ وَالنِّيرَانُ تَتَّفِقُ!","https://www.poetsgate.com/ViewPoem.aspx?id=215805",""],[6242,"حكاية الحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87566&r=&rc=13",""],[6275,"سنوات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83611&r=&rc=3",""],[4222,"أقسمت لا جزت الكمال مودة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52817&r=&rc=109",""]],"verses":[["كَم غارِسٍ أَمَّلَ في غَرسِهِ","فَأَعجَلَ المِقدارُ أَن يُجتَنى",0,"ن",2,0],["كَم غِبتُ عَنهُ وَما غابَت مَكارِمُهُ","وَنِمتُ عَنهُ بِآمالي وَلَم يَنَمِ",1,"م",1,0],["كَم غَرَّني غَيرُكَ مِن ناصِرٍ","أَبطَأَ وَالمُبطِئُ كَالخاذِلِ",2,"ل",1,0],["كَم غَبَنَ المَوتُ عَن كَريمٍ","وَقارَعَ الخَطبُ عَن قَريعِ",3,"ع",1,0],["كَم غَداةٍ صَباحُها في حِدادٍ","نَسَجَتهُ أَيدي نَزائِعَ قُبِّ",4,"ب",1,0],["كَمَغبونٍ يَعَضُّ عَلى يَدَيهِ","تَبَيَّنَ غَبنَهُ بَعدَ البَياعِ",5,"ع",1,0],["كمْ غَمْرَةٍ جلَّى وكمْ خطْبٍ كَفَى","إنْ أوْطَأ الجُرْدَ العِتاقَ وَطيسا",6,"س",2,0],["كمْ غَريبٍ أسْرَى إليْكَ فَوافَى","برِضىً عاجِلٍ وخَيْرٍ سَريعِ",7,"ع",1,0],["كَم غادَروا مِن ذي أَرامِلَ عائِلٍ","جَزَرَ السِباعِ وَمِن ضَريكٍ حاجِنِ",8,"ن",1,0],["كَم غادَةٍ بِرُبوعِ الشَأمِ باكِيَةٍ","عَلى أَليفٍ لَها يَرمي بِهِ الطَلَبُ",9,"ب",1,0],["كَم غُرَّةٍ لي تَلَقَتّها قُلوبُهُمُ","كَما تَلَقّى شِهابَ الموقِدِ الشَمَعُ",10,"ع",1,0],["كم غدا ينصحهم حتى إذا","راء أن الداء في القوم عضال",11,"ل",1,0],["كَم غَدرَةٍ لَكُمُ في الدينِ واضِحَةٍ","وَكَم دَمٍ لِرَسولِ اللَهِ عِندَكُمُ",12,"م",1,0],["كم غارةٍ عن حمى الإسلام كفكفها","بالضربِ والطعنِ أو بالرعبِ والرّهب",13,"ب",1,0],["كم غيَّرَ الدهرُ من دارٍ وساكنها","لا عن عميدِ ثنى بطشاً ولا عمُدِ",14,"د",1,0],["كم غزال رمى فلو أمكن الشم","س من الخوف ما تسمَّمت غزاله",15,"ل",2,0],["كم غرَّ قوماً حُلْوُها","من مُرِّها إلا الألِبَّهْ",16,"ب",2,0],["كم غافلٍ في سُوقه قنَّعتَهُ","في عُونه خِزياً وفي أبكارِهِ",17,"ر",2,0],["كم غدَوْنا كأن بِيضَ أيادي","هم علينا سبائِبُ الرُّحَّاض",18,"ض",1,0],["كم غبطة لمعاشر صدرت","عنه وكم لمعاشر فجعه",19,"ع",2,0],["كم غائبٍ غابَ ثم عاد فأل","فاكَ أخا سؤدَدٍ كما عَهِدكْ",20,"ك",1,0],["كم غُرْبةٍ آنستْك في وطنٍ","للمجدِ آثرتَها على وطنك",21,"ك",1,0],["كم غليظٍ من الرجال ثقيلٍ","ناقصُ الوزن شائل المثقالِ",22,"ل",1,0],["كم غمرةٍ لو سواه غامسَها","كانت ضَحَاضيحُها له حُوَما",23,"م",2,0],["كَم غَدوَةٍ لَكَ في النَدى","وَرَواحِ مَكرُمَةٍ تَروحُه",24,"ح",2,0],["كم غريب في جنب دجلة راو","وقريب في جنب دجلة صاد",25,"د",1,0],["كَم غارَةٍ شَنّوا عَلَيكَ دَفَعتَها","تَصِلُ الجُهودَ فَكُنَّ خَيرَ دِفاعِ",26,"ع",1,0],["كَم غُلامٍ خامِلٍ في دَرسِهِ","صارَ بَحرَ العِلمِ أُستاذَ العُصُر",27,"ر",1,0],["كَم غَرَّ صَبرُكَ وَاِبتِسامُكَ صاحِباً","لَمّا رَآكَ وَفي الحَشى مالا يُرى",28,"ر",2,0],["كَم غَرامٍ لَنا بِأَلحاظِ عَينَي","هِ شَهِيٍّ إِلى النُفوسِ عَذابُه",29,"ب",2,0],["كَم غافِلٍ أَودى بِهِ المَوتُ","لَم يَأخُذِ الءُهبَةَ لِلفَوتِ",30,"ت",1,1],["كَم غافِلٍ عَن حِياضِ المَوتِ في لَعِبٍ","يُمسي وَيُصبِحُ رَكّاباً لِما هَوِيا",31,"ي",2,0],["كَم غادَرَت بِفِناكَ يَومَ وَداعِنا","سُحبُ المَدامِعِ مَنهَلاً مَورودا",32,"د",2,0],["كَم غارَةٍ شَعواءَ حينَ شَهِدتَها","أُعطَيتَ فيها النَصرَ وَالتَأكيدا",32,"د",2,0],["كم غادة بين الصبا والشباب","تأنّق الصانع في صنعها",33,"ه",2,0],["كم غريبٍ حنّتْ إليه غريبَهْ","وكئيبٍ شجاه شَجْوُ كئيبَهْ",34,"ب",2,1],["كَمْ غادَرَ الشُّعَرَاءُ مِنْ مُتَرَدَّمِ","وَلَرُبَّ تَالٍ بَزَّ شَأْوَ مُقَدَّمِ",35,"م",1,1],["كم غنيٍّ أضحى نظيرَ عديمٍ","وفقيرٍ أمسى عديمَ نظيرِ",36,"ر",1,0],["كَم غَيَّبوا فيهِ كَريماً ماجِداً","شَهماً وَمُقتَبِلَ الشَبابِ غُلاما",37,"م",2,0],["كَم غِبتُ عَنكَ وَحُسنُ صُنعِكَ لَم يَزَل","عِندي عَبيراً حَيثُ كُنتَ وَعَنبَرا",38,"ر",2,0],["كَم غَدوَةٍ وَعَشِيَّه","نَعِمتُ بِالقادِسِيَّه",39,"ي",2,1],["كَم غَمرَةٍ لِلمَوتِ يُخشى خَوضُها","جَرَيتُ فيها جَريَ سِلكٍ في ثَقَب",40,"ب",1,0],["كَمْ غَيَّةٍ قدْ أتَاكَ بها ال","شاهدُ في سَلَمٍ وَفي كِذْبَهْ",41,"ب",2,0],["كم غادَروا الملك الجليلَ مُقَيَّداً","والقَرْمَ مِنْ أشْرَافِهِمْ مَغْلُولا",42,"ل",2,0],["كَم غُلْنَ من مُستَكبِرٍ في قَوْمِه","متَمَنِّعٍ بالعِزّ والسُّلطانِ",43,"ن",1,0],["كَم غادَرَت خَيلُنا مِنكُم بِمُعتَرَكٍ","لِلخامِعاتِ أَكُفّاً بَعدَ أَقدامِ",44,"م",1,0],["كَم غادَةٍ مِثلَ الثُرَيّا في العُلا","وَالحُسنُ قَد أَضحى الثَرى مِن حُجبِها",45,"ه",2,1],["كَم غَيَّرَتنا بِأَمرٍ خُطَّ حادِثُهُ","وَرَبُّنا اللَهُ لَم تُلمِم بِهِ الغِيَرُ",46,"ر",1,0],["كَم غُرِسَت نَخلَةٌ بِأَرضٍ","فَلَم يُقَدَّر لَها بُسوقُ",47,"ق",1,0],["كَم غالَ طاهيكَ مِن عَفراءَ مُرضِعَةٍ","وَذاتِ لونَينِ صارَت قوتَ مِكسالِ",48,"ل",1,0],["كَم غَرَّ صاحِبَةَ الجَما","لِ مُنَجَّمٌ بِحِسابِ جُمَّل",49,"ل",1,0],["كَم غادَةٍ لي أَيَّما غادَةٍ","غادَرَتها مِن بَعلِها أَيِّما",50,"م",2,0],["كمْ غديرٍ غادَرَ الدّمعُ بهِ","أَهْلَهُ غيرَ أُلي حاج لِرَي",51,"ي",1,0],["كَم غمرت مياهه","من مربع فمربع",52,"ع",1,0],["كَم غير الأرض من حا","دث عَلى الأرض مرا",53,"ر",2,0],["كم غرّ صبرك وابتسامك صاحباً","لمّا رآه وفي الحشى ما لا يرى",54,"ر",2,0],["كم غرّرت بالغزاة الصيد والتفتَت","إلى جحافلهم هزوا وإصغارا",55,"ر",2,0],["كمُغْتَسَلٍ أعْلى جُمادى ببارِدٍ","وما سَجْلُ ماءٍ حينَ يُفْرَغُ سائح",56,"ح",1,0],["كَمْ غَزْوَةٍ لَكَ في عِدَاكِ عَجِيبَةٍ","لاَ شَيْءَ غَيْرَ نَدَاكَ مِنْهَا أَعْجَبُ",57,"ب",1,0],["كَمْ غُرَابٍ قَدْ تبَدَّى وَاقِعاً","كشِهَابٍ وَتَرَدَّى مُصْمَقِرَّا",58,"ر",2,0],["كم غَرسْنا من نبات عبقريُ النفحاتِ","مُورقٌ داني الجناة",59,"ه",1,0],["كم غزتْهُ الخُطوبُ دُهمَ النواصي","وهو أصفى من الصباح وأسنَى",60,"ن",2,0],["كم غيَّرت بدخانها وجها إذا","بصُرت به شمس السماء أغارها",61,"ر",3,0],["كم غادةٍ هيفاءَ يش","كُو جيدُها حملَ الجواهر",62,"ر",1,0],["كم غَلْغَلا خلف ذؤاباتها","وخوّضا في المسكِ والعنبر ِ..",63,"ر",1,0],["كم غائبٍ غابَ ثم عاد فأل","فاكَ أخا سؤدَدٍ عَهِدكْ",64,"ك",1,0],["كم غدَوْنا كأن بِيضَ أيادي","يهم علينا سبائِبُ الرُّحَّاضِ",65,"ض",1,0],["كَم غَدير يَنساب فيها لَجيناً","أَعشب الرَوض مِنهُ بِالعقيان",66,"ن",1,0],["كم غصة زالت بايسر فرصة","وتبدلت بالرمشة الاحوال",67,"ل",1,0],["كم غدا الخاطر في يقظته","حاملاً منها كأجبال الصفا",68,"ا",1,0],["كم غدونا نشتكي من بعدها","نغرة الجرح الذي كان أرى",68,"ا",1,0],["كَم غَرَّتِ الآمالُ مِن تَكذيبِها","فَأَعَرتَها في سائِماتِ المالِ",69,"ل",1,0],["كم غمة كشفوا كم كربة رفعوا","وكم أزاحوا عن الإسلام عدوانا",70,"ن",2,0],["كَم غادَرَت أَسيافُهُ مِن ماجِدٍ","جَزر السِباعِ مُجَدَّلٍ لَم يُقبَرِ",71,"ر",1,0],["كَم غادَرَت مِن فَتىً حُلوٍ شَمائِلُهُ","يُمسي وَحَشوُ حَشاهُ الخَوفُ وَالحَذَرُ",72,"ر",1,0],["كَم غادِرٍ غادَرَهُ مُجَدَّلاً","وَالخَيلُ تُردي وَالكُماةُ تَدَّعي",73,"ع",2,0],["كَم غَصَّ نادٍ بِهِم قَدَماً وَكَم عَمَرَت","آثارَهُم نادياً في العُجمِ وَالعَرَبِ",74,"ب",1,0],["كم غصّة جرعتها من جاهل","عدم المعين لكثرة الجهّال",75,"ل",1,0],["كم غادروا فوق الصعيد مزملا","ما بين بيض ظبا وسمر صعاد",76,"د",1,0],["كَم غارَةٍ شَعواءَ جَدَّلَ أُسدَها","يَومَ الكَريهَةِ عَن مُتونِ أَجادِلِ",77,"ل",1,0],["كم غوادٍ في غور وجدٍ بوادٍ","سافراتٌ عن حسن بدر القناع",78,"ع",1,0],["كم غادةٍ برزت في السوقِ فاتنةً","حتى إذا عريت من وَشي ديباج",79,"ج",1,0],["كم غادةٍ يا جُملُ قَبلكِ زِرتُها","وشمَمتُ منها الوردَ والنّسرينا",80,"ن",2,0],["كَم غلطة من نوار بالحمى بدرت","لَنا وَعين الهَوى العذرى تَرعانا",81,"ن",2,0],["كَم غادَةٍ ظاعِنَةٍ","سارَت بِها الأَظعانُ",82,"ن",1,0],["كَم غارَةٍ في الأَعادي شَنَّها فَدَهَت","بِالقَتلِ وَالسَبيِ وَالأَطفالِ وَالحُرَمِ",83,"م",1,0],["كَم غادَةٍ خارِقَةٍ عادَةً","مُسفِرَةٍ كَالبَدرِ إِذ أَسفَرا",84,"ر",2,0],["كَم غَدونا نجرُّ ذيلَ التَصابي","بِصَبوحٍ من كأسِها وَغَبوقِ",85,"ق",1,0],["كم غادةٍ حضريّةٍ","كمل الجمالُ لها وَتم",86,"م",1,0],["كَم غادَرَ العلماءُ من متردّمٍ","بِمغاصها وَجَنى قصيّ مجانِ",87,"ن",1,0],["كَم غَزا القَلب لابِساً","لامه بَعد ما غَزا",88,"ز",2,0],["كم غادةٍ سَفَرت وكانَ حياؤها","يُنبيكَ عَنها أنَّها لم تسفِرِ",89,"ر",1,0],["كم غرتَ للغاراتِ من","متهجِّمٍ فيها مُغيرِ",90,"ر",1,0],["كم غافلٍ قد جئته عن غفلةٍ","ما أنت أول خائنٍ لا يفزع",91,"ع",1,0],["كم غافلٍ بات في الشهْوات مخترصاً","حتى دعاه الردى لبّاه محتَرِصا",92,"ص",2,0],["كم غديرٍ يُظَنُّ ماءً فراتاً","وهو في شدة اللُغوب سَراب",93,"ب",1,0],["كَم غَرَني التَرحيب حَتّى","أَظهَر التَجريب زورَه",94,"ر",2,0],["كم غرفة فيها ترى الكلفه","كم جدر صاحبه به فرحان",95,"ن",1,0],["كَم غُصونٍ من العُلو","مِ بِعلياهُ مُثمِرَه",96,"ر",2,0],["كم غَدتْ تضربُ في","الناسِ بسيفٍ غير نابَى",97,"ب",2,0],["كم غائب في القلب أضحى حاضراً","يغدو ويمسي في الفؤاد نزيلا",98,"ل",2,0],["كم غُمَّةٍ كشَفَتْ عنكم صوارمُه","ولم يزل كاشفَ اللأْواءِ والغُمَمِ",99,"م",1,0],["كَم غايةٍ في النَدى وَالبَأسِ أَحرَزَها","لِلطّالِبينَ مَداها دونَها تَعَبُ",100,"ب",1,0],["كم غزت يا صاح أسداً وظبا","إذ نضت أجفانها بيض الظبا",101,"ب",2,0],["كم غُرَّ قومٌ إِلى أَن غَرَّروا سَفَهاً","وربما ركِبَ التَّغْريرَ مَغْرورُ",102,"ر",1,0],["كم غارةٍ في مصرَ جاءَ بها","وسمعْتَ بالغاراتِ في القَفْرِ",103,"ر",1,0],["كم غافلٍ ونجوم السعد طالعةً","له ومجتهد في الرأي لم يصب",104,"ب",1,0],["كم غدا ليلة الثلاثاء والسب","ت يوالي الغبوق بالقرقاره",105,"ر",2,0],["كم غريرٍ حلو المراشف سا","جي الطرف أضحى قتيلُه لا يُبِلُّ",106,"ل",1,1],["كم غناء بجوِّها يُعشقُ","الدهرَ خليقٍ بعيده الصداحِ",107,"ح",1,0],["كم غرَّني من بنيكَ آلٌ","أنضَى ركابي وما سقاني",108,"ن",2,0],["كم غادةٍ منها رضيتُ لمهرها","منك القبولَ فشيد بالإفضالِ",109,"ل",1,0],["كم غزالٍ بالمصلَّى","سام وصلي فحكاكِ",110,"ك",1,0],["كم غارَ من بعد الغرورِ مدَّةً","بغيركم أما يَغارُ من يُغَرّْ",111,"ر",1,0],["كم غالَ فضلك مغروراً بمقولة","لمَّا نحاه وشرُّ الحتف في الغَرر",112,"ر",1,0],["كم غيبت من أمة كم شيبت","من لمة غاراتها المتماديه",113,"ي",2,0],["كم غادرت جثت الكلاب مجافة","أو جيفة في البحر تذهب طافيه",113,"ي",2,0],["كم غادر الحيانِ من بئرٍ معطَّل","ة ومن قصرٍ هناك مشيد",114,