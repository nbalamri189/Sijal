{"poems":[[53,"ما أسرع الأيام في طينا","https://www.aldiwan.net/poem29723.html","السريع"],[53,"أحق من كانت النعماء سابغة","https://www.aldiwan.net/poem29814.html","البسيط"],[53,"إياك عنه عذل العاذل","https://www.aldiwan.net/poem29842.html","السريع"],[53,"أأترك الغر من لداتي","https://www.aldiwan.net/poem30129.html","مجزوء البسيط"],[53,"لو على قدر ما يحاول قلبي","https://www.aldiwan.net/poem30765.html","الخفيف"],[34,"ألا يا شبه لبنى لا تراعي","https://www.aldiwan.net/poem4909.html","الوافر"],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[77,"يا ولي الإلاه أنت جواد","https://www.aldiwan.net/poem35987.html","الخفيف"],[24,"بان الشباب وكل إلف بائن","https://www.aldiwan.net/poem21886.html","الكامل"],[86,"لمصر أم لربوع الشام تنتسب","https://www.aldiwan.net/poem10918.html","البسيط"],[73,"هل النداء الذي أعلنت مستمع","https://www.aldiwan.net/poem11935.html","البسيط"],[88,"هكذا يدرك في الدنيا الكمال","https://www.aldiwan.net/poem45045.html","الرمل"],[47,"الدين مخترم والحق مهتضم","https://www.aldiwan.net/poem25156.html","البسيط"],[72,"عوض بكأسك ما أتلفت من نشب","https://www.aldiwan.net/poem18227.html","البسيط"],[72,"أستغفر الله لا مالي ولا ولدي","https://www.aldiwan.net/poem18543.html","البسيط"],[72,"مرحبا بالحيا لكل جديب","https://www.aldiwan.net/poem19533.html","الخفيف"],[51,"يا لهف نفسي للأحبه","https://www.aldiwan.net/poem8185.html","مجزوء الكامل"],[51,"يا باني الدرج الذي أولى به","https://www.aldiwan.net/poem62842.html","الكامل"],[51,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[51,"أصل نما بك ربه فرعه","https://www.aldiwan.net/poem65410.html","أحذ الكامل"],[51,"أصبحت عاديت للصبا رشدك","https://www.aldiwan.net/poem65760.html","المنسرح"],[51,"أنى تشاغلت عن أبي حسنك","https://www.aldiwan.net/poem65777.html","الخفيف"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[70,"أضنى الفؤاد فمن يريحه","https://www.aldiwan.net/poem42980.html","مجزوء الكامل"],[89,"هل لمن يرقدون في الالحاد","https://www.aldiwan.net/poem44644.html","الخفيف"],[85,"اخترت يوم الهول يوم وداع","https://www.aldiwan.net/poem62860.html","الكامل"],[85,"ناشئ في الورد من أيامه","https://www.aldiwan.net/poem63769.html","الرمل"],[43,"باد هواك صبرت أم لم تصبرا","https://www.aldiwan.net/poem9608.html","الكامل"],[45,"عاد للصب شجوه واكتئابه","https://www.aldiwan.net/poem10654.html","الخفيف"],[49,"كم غافل أودى به الموت","https://www.aldiwan.net/poem10849.html","السريع"],[49,"إن السلامة أن ترضى بما قضيا","https://www.aldiwan.net/poem63202.html","البسيط"],[66,"لا تخش ياربع الحبيب همودا","https://www.aldiwan.net/poem41375.html","الكامل"],[97,"جلست يوما حين حل المساء","https://www.aldiwan.net/poem24794.html","السريع"],[80,"كم غريب حنت إليه غريبه","https://www.aldiwan.net/poem31553.html","الخفيف"],[87,"كم غادر الشعراء من متردم","https://www.aldiwan.net/poem8260.html","الكامل"],[69,"أنا في الحب قانع باليسير","https://www.aldiwan.net/poem28994.html","الخفيف"],[31,"يا راكبا نحو المدينة جسرة","https://www.aldiwan.net/poem41309.html","الكامل"],[81,"أهدى التلاقي صبح وجهك مسفرا","https://www.aldiwan.net/poem61522.html","الكامل"],[52,"كم غدوة وعشيه","https://www.aldiwan.net/poem26570.html","المجتث"],[52,"رأيت فيها برقها لما وثب","https://www.aldiwan.net/poem27297.html","الرجز"],[67,"لا تظلموني وتظلموا الحسبه","https://www.aldiwan.net/poem18043.html","المنسرح"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[75,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[7,"قالت بنو عامر خالوا بني أسد","https://www.aldiwan.net/poem1972.html","البسيط"],[46,"كم غادة مثل الثريا في العلا","https://www.aldiwan.net/poem22348.html","الرجز"],[46,"من ادعى الخير من قوم فهم كذب","https://www.aldiwan.net/poem22539.html","البسيط"],[46,"يغنيك ماحل في السجايا","https://www.aldiwan.net/poem23021.html","مجزوء البسيط"],[46,"قد طال في العيش تقييدي وإرسالي","https://www.aldiwan.net/poem23221.html","البسيط"],[46,"غض الجفون إذا جلس","https://www.aldiwan.net/poem23269.html","مجزوء الكامل"],[46,"قال زمان الناس في صفوه","https://www.aldiwan.net/poem23357.html","السريع"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85422","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85359","المجتث"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141028",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39680","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16694","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54563","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54257","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[106,"محنة فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=179418",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[99,"القرط الطويل","https://www.poetsgate.com/ViewPoem.aspx?id=36382",""],[51,"أصبحتَ عاديتَ للصبا رشدكْ","https://www.poetsgate.com/ViewPoem.aspx?id=30012",""],[51,"لهف نفسي على العيون المِراضِ","https://www.poetsgate.com/ViewPoem.aspx?id=29407",""]],"verses":[["كَم غارِسٍ أَمَّلَ في غَرسِهِ","فَأَعجَلَ المِقدارُ أَن يُجتَنى",0,"ن",2,0],["كَم غِبتُ عَنهُ وَما غابَت مَكارِمُهُ","وَنِمتُ عَنهُ بِآمالي وَلَم يَنَمِ",1,"م",1,0],["كَم غَرَّني غَيرُكَ مِن ناصِرٍ","أَبطَأَ وَالمُبطِئُ كَالخاذِلِ",2,"ل",1,0],["كَم غَبَنَ المَوتُ عَن كَريمٍ","وَقارَعَ الخَطبُ عَن قَريعِ",3,"ع",1,0],["كَم غَداةٍ صَباحُها في حِدادٍ","نَسَجَتهُ أَيدي نَزائِعَ قُبِّ",4,"ب",1,0],["كَمَغبونٍ يَعَضُّ عَلى يَدَيهِ","تَبَيَّنَ غَبنَهُ بَعدَ البَياعِ",5,"ع",1,0],["كمْ غَمْرَةٍ جلَّى وكمْ خطْبٍ كَفَى","إنْ أوْطَأ الجُرْدَ العِتاقَ وَطيسا",6,"س",2,0],["كمْ غَريبٍ أسْرَى إليْكَ فَوافَى","برِضىً عاجِلٍ وخَيْرٍ سَريعِ",7,"ع",1,0],["كَم غادَروا مِن ذي أَرامِلَ عائِلٍ","جَزَرَ السِباعِ وَمِن ضَريكٍ حاجِنِ",8,"ن",1,0],["كَم غادَةٍ بِرُبوعِ الشَأمِ باكِيَةٍ","عَلى أَليفٍ لَها يَرمي بِهِ الطَلَبُ",9,"ب",1,0],["كَم غُرَّةٍ لي تَلَقَتّها قُلوبُهُمُ","كَما تَلَقّى شِهابَ الموقِدِ الشَمَعُ",10,"ع",1,0],["كم غدا ينصحهم حتى إذا","راء أن الداء في القوم عضال",11,"ل",1,0],["كَم غَدرَةٍ لَكُمُ في الدينِ واضِحَةٍ","وَكَم دَمٍ لِرَسولِ اللَهِ عِندَكُمُ",12,"م",1,0],["كم غارةٍ عن حمى الإسلام كفكفها","بالضربِ والطعنِ أو بالرعبِ والرّهب",13,"ب",1,0],["كم غيَّرَ الدهرُ من دارٍ وساكنها","لا عن عميدِ ثنى بطشاً ولا عمُدِ",14,"د",1,0],["كم غزال رمى فلو أمكن الشم","س من الخوف ما تسمَّمت غزاله",15,"ل",2,0],["كم غرَّ قوماً حُلْوُها","من مُرِّها إلا الألِبَّهْ",16,"ب",2,0],["كم غافلٍ في سُوقه قنَّعتَهُ","في عُونه خِزياً وفي أبكارِهِ",17,"ر",2,0],["كم غدَوْنا كأن بِيضَ أيادي","هم علينا سبائِبُ الرُّحَّاض",18,"ض",1,0],["كم غبطة لمعاشر صدرت","عنه وكم لمعاشر فجعه",19,"ع",2,0],["كم غائبٍ غابَ ثم عاد فأل","فاكَ أخا سؤدَدٍ كما عَهِدكْ",20,"ك",1,0],["كم غُرْبةٍ آنستْك في وطنٍ","للمجدِ آثرتَها على وطنك",21,"ك",1,0],["كم غليظٍ من الرجال ثقيلٍ","ناقصُ الوزن شائل المثقالِ",22,"ل",1,0],["كم غمرةٍ لو سواه غامسَها","كانت ضَحَاضيحُها له حُوَما",23,"م",2,0],["كَم غَدوَةٍ لَكَ في النَدى","وَرَواحِ مَكرُمَةٍ تَروحُه",24,"ح",2,0],["كم غريب في جنب دجلة راو","وقريب في جنب دجلة صاد",25,"د",1,0],["كَم غارَةٍ شَنّوا عَلَيكَ دَفَعتَها","تَصِلُ الجُهودَ فَكُنَّ خَيرَ دِفاعِ",26,"ع",1,0],["كَم غُلامٍ خامِلٍ في دَرسِهِ","صارَ بَحرَ العِلمِ أُستاذَ العُصُر",27,"ر",1,0],["كَم غَرَّ صَبرُكَ وَاِبتِسامُكَ صاحِباً","لَمّا رَآكَ وَفي الحَشى مالا يُرى",28,"ر",2,0],["كَم غَرامٍ لَنا بِأَلحاظِ عَينَي","هِ شَهِيٍّ إِلى النُفوسِ عَذابُه",29,"ب",2,0],["كَم غافِلٍ أَودى بِهِ المَوتُ","لَم يَأخُذِ الءُهبَةَ لِلفَوتِ",30,"ت",1,1],["كَم غافِلٍ عَن حِياضِ المَوتِ في لَعِبٍ","يُمسي وَيُصبِحُ رَكّاباً لِما هَوِيا",31,"ي",2,0],["كَم غادَرَت بِفِناكَ يَومَ وَداعِنا","سُحبُ المَدامِعِ مَنهَلاً مَورودا",32,"د",2,0],["كَم غارَةٍ شَعواءَ حينَ شَهِدتَها","أُعطَيتَ فيها النَصرَ وَالتَأكيدا",32,"د",2,0],["كم غادة بين الصبا والشباب","تأنّق الصانع في صنعها",33,"ه",2,0],["كم غريبٍ حنّتْ إليه غريبَهْ","وكئيبٍ شجاه شَجْوُ كئيبَهْ",34,"ب",2,1],["كَمْ غادَرَ الشُّعَرَاءُ مِنْ مُتَرَدَّمِ","وَلَرُبَّ تَالٍ بَزَّ شَأْوَ مُقَدَّمِ",35,"م",1,1],["كم غنيٍّ أضحى نظيرَ عديمٍ","وفقيرٍ أمسى عديمَ نظيرِ",36,"ر",1,0],["كَم غَيَّبوا فيهِ كَريماً ماجِداً","شَهماً وَمُقتَبِلَ الشَبابِ غُلاما",37,"م",2,0],["كَم غِبتُ عَنكَ وَحُسنُ صُنعِكَ لَم يَزَل","عِندي عَبيراً حَيثُ كُنتَ وَعَنبَرا",38,"ر",2,0],["كَم غَدوَةٍ وَعَشِيَّه","نَعِمتُ بِالقادِسِيَّه",39,"ي",2,1],["كَم غَمرَةٍ لِلمَوتِ يُخشى خَوضُها","جَرَيتُ فيها جَريَ سِلكٍ في ثَقَب",40,"ب",1,0],["كَمْ غَيَّةٍ قدْ أتَاكَ بها ال","شاهدُ في سَلَمٍ وَفي كِذْبَهْ",41,"ب",2,0],["كم غادَروا الملك الجليلَ مُقَيَّداً","والقَرْمَ مِنْ أشْرَافِهِمْ مَغْلُولا",42,"ل",2,0],["كَم غُلْنَ من مُستَكبِرٍ في قَوْمِه","متَمَنِّعٍ بالعِزّ والسُّلطانِ",43,"ن",1,0],["كَم غادَرَت خَيلُنا مِنكُم بِمُعتَرَكٍ","لِلخامِعاتِ أَكُفّاً بَعدَ أَقدامِ",44,"م",1,0],["كَم غادَةٍ مِثلَ الثُرَيّا في العُلا","وَالحُسنُ قَد أَضحى الثَرى مِن حُجبِها",45,"ه",2,1],["كَم غَيَّرَتنا بِأَمرٍ خُطَّ حادِثُهُ","وَرَبُّنا اللَهُ لَم تُلمِم بِهِ الغِيَرُ",46,"ر",1,0],["كَم غُرِسَت نَخلَةٌ بِأَرضٍ","فَلَم يُقَدَّر لَها بُسوقُ",47,"ق",1,0],["كَم غالَ طاهيكَ مِن عَفراءَ مُرضِعَةٍ","وَذاتِ لونَينِ صارَت قوتَ مِكسالِ",48,"ل",1,0],["كَم غَرَّ صاحِبَةَ الجَما","لِ مُنَجَّمٌ بِحِسابِ جُمَّل",49,"ل",1,0],["كَم غادَةٍ لي أَيَّما غادَةٍ","غادَرَتها مِن بَعلِها أَيِّما",50,"م",2,0],["كمْ غديرٍ غادَرَ الدّمعُ بهِ","أَهْلَهُ غيرَ أُلي حاج لِرَي",51,"ي",1,0],["كَم غمرت مياهه","من مربع فمربع",52,"ع",1,0],["كَم غير الأرض من حا","دث عَلى الأرض مرا",53,"ر",2,0],["كم غرّ صبرك وابتسامك صاحباً","لمّا رآه وفي الحشى ما لا يرى",54,"ر",2,0],["كم غرّرت بالغزاة الصيد والتفتَت","إلى جحافلهم هزوا وإصغارا",55,"ر",2,0],["كمُغْتَسَلٍ أعْلى جُمادى ببارِدٍ","وما سَجْلُ ماءٍ حينَ يُفْرَغُ سائح",56,"ح",1,0],["كَمْ غَزْوَةٍ لَكَ في عِدَاكِ عَجِيبَةٍ","لاَ شَيْءَ غَيْرَ نَدَاكَ مِنْهَا أَعْجَبُ",57,"ب",1,0],["كَمْ غُرَابٍ قَدْ تبَدَّى وَاقِعاً","كشِهَابٍ وَتَرَدَّى مُصْمَقِرَّا",58,"ر",2,0],["كم غَرسْنا من نبات عبقريُ النفحاتِ","مُورقٌ داني الجناة",59,"ه",1,0],["كم غزتْهُ الخُطوبُ دُهمَ النواصي","وهو أصفى من الصباح وأسنَى",60,"ن",2,0],["كم غيَّرت بدخانها وجها إذا","بصُرت به شمس السماء أغارها",61,"ر",3,0],["كم غادةٍ هيفاءَ يش","كُو جيدُها حملَ الجواهر",62,"ر",1,0],["كم غَلْغَلا خلف ذؤاباتها","وخوّضا في المسكِ والعنبر ِ..",63,"ر",1,0],["كم غائبٍ غابَ ثم عاد فأل","فاكَ أخا سؤدَدٍ عَهِدكْ",64,"ك",1,0],["كم غدَوْنا كأن بِيضَ أيادي","يهم علينا سبائِبُ الرُّحَّاضِ",65,"ض",1,0]]}