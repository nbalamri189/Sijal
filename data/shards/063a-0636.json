َاهُ داعي الصبَى، فأجابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31576",""],[45,"قَدْ كَانَ طَيْفُكِ مَرّةً يُغرَى بي","https://www.poetsgate.com/ViewPoem.aspx?id=31420",""],[45,"مَهْرِجْ صَبُوحَك سَعْدُه ُلم يُنْحَسِ","https://www.poetsgate.com/ViewPoem.aspx?id=31143",""],[51,"أعقب القربَ من حبيبك شحطُ","https://www.poetsgate.com/ViewPoem.aspx?id=29399",""],[51,"غضبٌ ألحُّ من السحابِ الأسحمِ","https://www.poetsgate.com/ViewPoem.aspx?id=30398",""],[51,"يا غُصُنا من لُؤلُؤٍ رَطْبِ","https://www.poetsgate.com/ViewPoem.aspx?id=27031",""],[105,"خلت المنازل منك والأوطان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55119&r=&rc=289",""]],"verses":[["غَضَبى إِذا لَم يَلقَ أَع","يُنَها ضَريبٌ أَو طَعينُ",0,"ن",1,0],["غَضبانَ قَد غَرَّكِ هَمهامُهُ","عَلى مَجازي اللَقَمِ المَهيَعِ",1,"ع",1,0],["غَضبانُ سُلَّ خِطامُهُ","عَنهُ وَحُلَّ إيِاضُهُ",2,"ض",2,0],["غَضبانَ يَغلي بِالزَما","جِرِ كُلَّما نَظَرَ الفَريسا",3,"س",2,0],["غُضّي منَ الإدْلالِ فهْوَ على النّوى","ما دامَ يَجْلِبُهُ المَلالُ دَليلُ",4,"ل",1,0],["غَضِبَتْ قُرَيشٌ إذْ مَلَكْتُ مَقادَتي","غَضباً يَكادُ السُّمُ منهُ يَقْطُرُ",5,"ر",1,0],["غَضِبتِ لِأَن جادَ الرُقادُ بِنَظرَةٍ","لَنا مِنكِ في الأَحلامِ وَالناسُ نُوَّمُ",6,"م",1,1],["غَضِبَ الحَبيبُ فَهاجَ لي اِستِعبارُ","وَاللَهُ لي مِمّا أُحاذِرُ جارُ",7,"ر",1,1],["غَضِبتُ عَلَيكِ سَيِّدَتي","وَما لِلعَبدِ وَالغَضَبِ",8,"ب",1,1],["غضِبَ الإلاهُ علَى بَني عيْسِ","وعلى منِ اشْتمَلَتْ عليْهِ منْ تَيْسِ",9,"س",1,1],["غَضَضْتُ عَلَى التَّوْدِيعِ جَفْنِيَ عِنْدَهَا","وَفِي الْقَلْبِ دَاءٌ لِلْفِرَاقِ دَخِيلُ",10,"ل",1,0],["غَضِبَ الأَميرُ بِأن صَدقتُ وَرُبَما","غَضِبَ الأَميرُ عَلى البَريِّ المُسلِمِ",11,"م",1,1],["غَضوبٍ مِنَ السَوطِ زَيّافَةٍ","إِذا ما اِرتَدى بِالسَراةِ الأَكَم",12,"م",1,0],["غَضبى لِمَنسِمِها صَياحٌ بِالحَصى","وَقعَ القَدومِ بِغَضرَةِ الأَفنانِ",13,"ن",1,0],["غُضّوا العُيونَ وَحَيّوهُ تَحِيَّتَهُ","مِنَ القُلوبِ إِذا لَم تُسعِدِ الكَلِمُ",14,"م",1,0],["غَضَبَ التَقِيِّ لِرَبِّهِ وَكِتابِهِ","أَو غَضبَةَ الفاروقِ لِلمُختارِ",15,"ر",1,0],["غُضّوا العُيونَ فَإِنَّ الروحَ يَصحَبُكُم","مَعَ المَلائِكِ تَكريماً لِمَحمودِ",16,"د",1,0],["غُضّي جُفونَ السِحرِ أَو فَاِرحَمي","مُتَيَّماً يَخشى نِزالَ الجُفون",17,"ن",1,1],["غَضِبَ اللَهُ أَم تَمَرَّدَتِ الأَر","ضُ فَأَنحَت عَلى بَني الإِنسانِ",18,"ن",1,0],["غَضبانُ لا يَرضى فَما قابَلتُهُ","مُتَبَسِّماً إِلّا اِستَحالَ مُقَطَّبا",19,"ب",2,0],["غُضفٌ مُهَرَّتَةُ الأَشداقِ ضارِيَةٌ","مِثلُ السَراحينِ في أَعناقِها العَذَبُ",20,"ب",1,0],["غضبتَ للدين والدنيا بحقهما","يا حبّذا غضب في الله أرضاهُ",21,"ا",2,0],["غَضِبَت طُهَيَّةُ أَن سَبَبتُ مُجاشِعاً","عَضّوا بِصُمِّ حِجارَةٍ مِن عُليَبِ",22,"ب",1,1],["غَضِبنا يَومَ طِخفَةَ قَد عَلِمتُم","فَصَفَّدنا المُلوكَ بِها اِعتِسارا",23,"ر",2,0],["غَضِبتُم عَلَيها أَو تَغَنَّيتُمُ بِها","أَنِ اِخضَرَّ مِن بَطنِ التِلاعِ غَميرُها",24,"ر",3,0],["غَضِبتَ عَلَينا أَن مَنَعنا مُجاشِعاً","قَديماً مَعينَ الماءِ فَاِحتَفَروا الضَحلا",25,"ل",2,0],["غَضِبنا لِلَذي لاقَت نُفَيلٌ","وَخَيرُ الطالِبي التَرَةِ الغَضوبُ",26,"ب",1,0],["غضاباً علينا أن تُسمَّي أمهم","حَصاناً ولا ننمي بنيها إلى بَعْلِ",27,"ل",1,1],["غَضَباً لِدينِ اللَهِ أَن لاتَغضَبوا","لَم يَشتَهِر في نَصرِهِ سَيفانِ",28,"ن",1,0],["غَضَبُ الإِلَهِ عَلى الزَبَعرى وَاِبنِهِ","وَعَذابُ سوءٍ في الحَياةِ مُقيمِ",29,"م",1,0],["غضضتُ من الجفون فلست أَرمي","ولا أُرمى بطرفٍ مسترابِ",30,"ب",1,0],["غضبتَ وظِلتَ من سَفهٍ وطيشٍ","تُهزهِزُ لحيةً في قدّ رَفْشِ",31,"ش",1,1],["غضباً فليُضَرَّم الغيظُ في الأح","شاءِ منكم ما ضرَّمُ النارَ نفطُ",32,"ط",1,0],["غضبتْ لي السماءُ والأرضُ والنا","سُ على ابن اللَّبُونِ إسماعيلِ",33,"ل",1,1],["غضبٌ ألحُّ من السحابِ الأسحمِ","ورضاً أعزُّ من الغُرابِ الأعصمِ",34,"م",1,1],["غُضّي الملامة قد كفاك ملامتي","ضيفٌ ثوى عندي بدار مُقامِ",35,"م",1,0],["غِضابٌ كَأَنّي في بَياضٍ أَكُفِّهِم","أَلا رُبَّما لَم تَستَطِعني اللَهازِمُ",36,"م",1,0],["غَضِبتَ عَلى الهِلالِ فَخَرَّ ذُعراً","وَلُحتَ لَهُ فَحاذَرَ أَن يَلوحا",37,"ح",2,0],["غَضِبَ الدَهرُ عَلى كَأسِ الصَفاء","مُذ رَآها فَأَبى أَلّا تُراق",38,"ق",1,0],["غَضَبُ العَذولِ أَخَفُّ مِن","غَضَبِ الحَبيبِ وَأَسهَلُ",39,"ل",1,0],["غَضوباً كَحَيزومِ النَعامَةِ أُحمِشَت","بِأَجوازِ خُشبٍ زالَ عَنها هَشيمُها",40,"م",3,0],["غَضبانَ قَد هَدَّدَ بِالضَر","بِ وَإِن لَم يَضرِبِ",41,"ب",1,0],["غَضَّ الشَبابُ فَكَيفَ كُن","تَ عَنِ الشَبابِ بِمَعزِلِ",42,"ل",1,0],["غَضٌّ عَلى طولِ البِلى","حَيٌّ عَلى طولِ المَنون",43,"ن",1,0],["غَضِبَت فَغَضَّ الطَرفَ كُلُّ مُكابِرٍ","يَلقاكَ بِالخَدِّ اللَطيمِ مُصَعَّرا",44,"ر",2,0],["غَضِبتُ لَهُ لَمّا رَأَيتُ صِفاتِهِ","بِلا واصِفٍ وَالشِعرُ تَهذي طَماطِمُه",45,"م",2,0],["غَضَبُ الحَسودِ إِذا لَقيتُكَ راضِياً","رُزءٌ أَخَفُّ عَلَيَّ مِن أَن يوزَنا",46,"ن",2,0],["غَضُّ الشَبابِ بَعيدٌ فَجرُ لَيلَتِهِ","مُجانِبُ العَينِ لِلفَحشاءِ وَالوَسَنِ",47,"ن",1,0],["غضبان ترمي بأمواجٍ فواقِعُها","كواكبٌ في سَناءِ المجدِ تَحكيكا",48,"ك",2,0],["غَضارَةُ دُنيا شاكَلَت بِفُنونِها","مُعاقَبَةَ الدُنيا الَّتي تَتَقَلَّبُ",49,"ب",1,0],["غَضدُ عَيشٍ زالَت غَمامَتُهُ عَن","ني وَمَن بِالغَمامَةِ المُنجابَه",50,"ب",2,0],["غَضبانُ تُجلى عَن وَقائِعِ سَيفِهِ","عَكَراتُ حُمسٍ في الحَديدِ غِضابِ",51,"ب",1,0],["غُضّي جُفونَكِ يا عُيونَ النَرجِسِ","كَي ما أَفوزَ بِقُبلَةٍ مِن مُؤنِسِ",52,"س",1,0],["غَضبانَ حُمِّلَ إِحنَةً لَو حُمِّلَت","ثَبَجَ الصَباحِ لَثَقَّلَت مِن نَهضِهِ",53,"ض",2,0],["غَضبانَ يَلقى الشَمسَ مِنهُ بِهامَةٍ","تُغشي العُيونَ تَأَلُّقاً وَبَريقا",54,"ق",2,0],["غَضُّ الأَمانَةِ فيها مِن تَنَزُّهِهِ","وَأَبيَضُ الزَوبِ فيها مِن تَوَقّيهِ",55,"ي",2,0],["غَضِبتُم عَلَينا أَن عَلَتكُم مُجاشِعٌ","وَكانَ الَّذي يَحمي ذِمارُكُمُ عَبدا",56,"د",2,0],["غَضِبتُ وَلَم أَملِك لِبِشرٍ بِصارِمٍ","عَلى فَرَسي عِندَ الجَنازَةِ وَالقَبرِ",57,"ر",1,0],["غَضِبنا لَكُم يا آلَ مَروانَ فَاِغضَبوا","عَسى أَنَّ أَرواحاً يَسوغُ طَعامُها",58,"م",3,0],["غَضِبْتَ للدِّينِ حتى عادَ كَوكَبُه","طَلْقاً يُضيءُ على الآفاقِ آفِلُه",59,"ل",2,0],["غَضبانُ ينساني وأذكرُه","ويَنامُ عن ليلي وأسهرُه",60,"ر",2,1],["غضبانُ يستُرُ عني وجهَه بِيَدٍ","وَدِدْتُ لو سُمِّرَتْ فيه بمسمارِ",61,"ر",1,0],["غَضَّةٌ ريحانُنا الغَضُّ بها","أسَدٌ من غابةِ الوَردِ وَرَدْ",62,"د",1,0],["غُضَّ عَيناً عَلى القَذى","وَتَصَبَّر عَلى الأَذى",63,"ذ",2,1],["غَضِبتُ عَلَيكَ ثُمَّ رَأَي","تُ وَجهَكَ فَانجَلى غَضَبي",64,"ب",2,0],["غَضِبَت فَاِنثَنَت تُوَسوِسُ في العَق","لِ شَياطينُ فِكرِها في النُزاغِ",65,"غ",1,0],["غُضَّ طَرفُ الأَعداءِ عَنكَ أَبا الفَت","حِ وَباتَت قُلوبُهُم في اِرتِياغِ",65,"غ",1,0],["غَضِبتُ بِتَبيينِ غِشٍّ جَنى","فَبِتُّ بِغَيظِيَ في غَضبَتي",66,"ت",2,0],["غَضَّ الزَمانُ عُيونَ السَوءِ عَن مَلِكٍ","كُلُّ العُيونِ إِلى مَعروفِهِ طَمَحَت",67,"ت",1,0],["غَضُّ الحَيا قَحلُ الوَدادِ كَأَنَّما","نَهِلَت بَشاشَةُ وَجهِهِ مِن وُدِّهِ",68,"د",2,0],["غَضباً على الأعلاج منه فَرَبّهُ","يَرْضَى به ونَبِيُّهُ المختارُ",69,"ر",1,0],["غضّ الصّبا كأنّما حديثهُ","يمازجُ النّفسَ بأنفاسِ الملح",70,"ح",1,0],["غَضِبَ الخَليفَةُ لِلخِلافَةِ غَضبَةً","رَخُصَت لَها المُهجاتُ وَهيَ غَوالي",71,"ل",2,0],["غُضَّ مِنْ طرفِكَ إنْ قابلْتَها","كلُّ نفسٍ مقلتاها مقتلاها",72,"ا",3,0],["غَضِبَت أَن نَظَرتُ نَحوَ نِساءٍ","لَيسَ يَعرِفنَني سَلَكنَ الطَريقا",73,"ق",2,0],["غُضّوا النّواظرَ خاشعين أوِ انْظُروا","هذا عليٌّ في الندِيِّ وجعفرُ",74,"ر",1,0],["غضبوا على معبودهم وتجنّبوا","محسودهم فكأنّه لم يُحسدِ",75,"د",1,0],["غَضِبوا لمِصرَ تُصابُ في آمالها","ولِحقِّها الغالي المَصُونِ يُباحُ",76,"ح",1,0],["غضبوا فما ركبوا إلى استقلالهم","إلا عُبابَ دمٍ ولُجَّةَ نارِ",77,"ر",1,0],["غَضبَ الصّغيرُ وقال أُمّاهُ احذري","وتأهّبِي للخطبِ ذي الأهوالِ",78,"ل",1,0],["غَضِبوا عَلى الأَحرارِ في أَوطانِهِم","وَرَضوا بِكُلِّ مُداهِنٍ خَوّانِ",79,"ن",1,0],["غَضِبنا فَباتَ الجَيشُ يَرميهِ بأسُهُ","وَباتَ الحُسامُ العَضبُ يَلفِظُهُ الغِمدُ",80,"د",1,0],["غُضّوا العُيونَ وَطَأطِئوا هاماتِكُم","وَاِرضوا مُقامَ المُستَميتِ مُقاما",81,"م",2,0],["غَضِبنا لِمِصرٍ غَضبَةً ما نَرُدُّها","إِلى أَن نَرى المُختارَ في القَبرِ راضِيا",82,"ي",2,0],["غَضِبَ الحُماةُ لدين أَحمدَ غَضبَةً","نُصر الإِلهُ بِها وَعزَّ المُصحَفُ",83,"ف",1,1],["غَضِبَ النبيُّ وقال إنّي بالذي","جَهِلَ الغِضابُ السّاخطونَ لعالِمُ",84,"م",1,0],["غَضِبَ اللّهُ عليهم فَرَضُوْا","رَبِّ زِدْهُم كلَّ يومٍ غَضَبَا",85,"ب",2,0],["غَضِبُوا فقال رُوَيْدَكُم ما بي سوى","أن أستبين وأي