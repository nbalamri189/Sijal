.net/poem32615.html","مجزوء الكامل"],[416,"يا رعى الله للأحبة في الجزع","https://www.aldiwan.net/poem53961.html","الخفيف"],[416,"يمينا برب النجم والنجم إذ يسري","https://www.aldiwan.net/poem54085.html","الطويل"],[416,"بلغت بحمد الله ما أنا طالب","https://www.aldiwan.net/poem54188.html","الطويل"],[429,"من الأحبة أم من طيب ربعهم","https://www.aldiwan.net/poem41426.html","البسيط"],[432,"أرابه البان إذ لم يقض آرابا","https://www.aldiwan.net/poem12342.html","البسيط"],[432,"قل للشريف على تقوله","https://www.aldiwan.net/poem12403.html","أحذ الكامل"],[439,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[452,"غضارة عيش ما أعانيه أم ضنك","https://www.aldiwan.net/poem13872.html","الطويل"],[453,"غضي عيونك يا نجوم فإنني","https://www.aldiwan.net/poem61323.html","الكامل"],[458,"سل بسلع شجنا كان وكنا","https://www.aldiwan.net/poem55822.html","الرمل"],[458,"جرت لها ببابلٍ يمينا","https://www.aldiwan.net/poem55838.html","الرجز"],[458,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[458,"تموق الليالي فيكم ثم تعقِل","https://www.aldiwan.net/poem55908.html","الطويل"],[458,"عثرت يوم العذيب فاستقل","https://www.aldiwan.net/poem55993.html","المنسرح"],[458,"لو حملت عتبي الليالي","https://www.aldiwan.net/poem56006.html","مخلع البسيط"],[458,"ياابنة القوم تراك","https://www.aldiwan.net/poem56083.html","مجزوء الرمل"],[458,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[458,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[458,"مالكم لا تغضبون للهوى","https://www.aldiwan.net/poem56311.html","الرجز"],[464,"قف أن وقفت فذاك وادي المنحى","https://www.aldiwan.net/poem3179.html","عموديه"],[464,"بالله يا رسل الرياح","https://www.aldiwan.net/poem3515.html","عموديه"],[464,"وجه الحبيب شهية ألطافه","https://www.aldiwan.net/poem3540.html","عموديه"],[479,"أسفي على هذا الزمان وأهله","https://www.aldiwan.net/poem37188.html","الكامل"],[495,"غضي جفونك يا رياض","https://www.aldiwan.net/poem9883.html","مجزوء الكامل"],[495,"راض كلا أو ساخط كالراضي","https://www.aldiwan.net/poem10225.html","الكامل"],[500,"قالوا تحب عليا قلت مبتهجا","https://www.aldiwan.net/poem37650.html","البسيط"],[511,"لو كنت في ريمان لست ببارح","https://www.aldiwan.net/poem20953.html","الكامل"],[514,"ما الراح إلا روح كل حزين","https://www.aldiwan.net/poem20791.html","الكامل"],[515,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[515,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[515,"في مثل مدحك شرح القول مختصر","https://www.aldiwan.net/poem12117.html","البسيط"],[544,"هدهد لظاك","https://www.aldiwan.net/poem67254.html","عموديه"],[551,"فجعة ما احتسبتها في زماني","https://www.aldiwan.net/poem47168.html","الخفيف"],[551,"ما للخيال ببطن مر يطرق","https://www.aldiwan.net/poem47378.html","الكامل"],[561,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[562,"كيف هذي الدنيا وهذا الزمان","https://www.aldiwan.net/poem52761.html","الخفيف"],[562,"الحمد لله من الله بالفرج","https://www.aldiwan.net/poem52832.html","البسيط"],[562,"آس العذار على خديه قد كتبا","https://www.aldiwan.net/poem52882.html","البسيط"],[562,"غضي جفونك يا عيون النرجس","https://www.aldiwan.net/poem52891.html","الكامل"],[563,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[567,"حسبي من اللهو وآلات الطرب","https://www.aldiwan.net/poem69818.html","الرجز"],[575,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"],[575,"ليس حظي من الهوى","https://www.aldiwan.net/poem2881.html","مجزوء الخفيف"],[586,"وافى وأرواح العذيب نواسم","https://www.aldiwan.net/poem17701.html","الكامل"]],"verses":[["غَضَبى إِذا لَم يَلقَ أَع","يُنَها ضَريبٌ أَو طَعينُ",0,"ن",1,0],["غَضبانَ قَد غَرَّكِ هَمهامُهُ","عَلى مَجازي اللَقَمِ المَهيَعِ",1,"ع",1,0],["غَضبانُ سُلَّ خِطامُهُ","عَنهُ وَحُلَّ إيِاضُهُ",2,"ض",2,0],["غَضبانَ يَغلي بِالزَما","جِرِ كُلَّما نَظَرَ الفَريسا",3,"س",2,0],["غُضّي منَ الإدْلالِ فهْوَ على النّوى","ما دامَ يَجْلِبُهُ المَلالُ دَليلُ",4,"ل",1,0],["غَضِبَتْ قُرَيشٌ إذْ مَلَكْتُ مَقادَتي","غَضباً يَكادُ السُّمُ منهُ يَقْطُرُ",5,"ر",1,0],["غَضِبتِ لِأَن جادَ الرُقادُ بِنَظرَةٍ","لَنا مِنكِ في الأَحلامِ وَالناسُ نُوَّمُ",6,"م",1,1],["غَضِبَ الحَبيبُ فَهاجَ لي اِستِعبارُ","وَاللَهُ لي مِمّا أُحاذِرُ جارُ",7,"ر",1,1],["غَضِبتُ عَلَيكِ سَيِّدَتي","وَما لِلعَبدِ وَالغَضَبِ",8,"ب",1,1],["غضِبَ الإلاهُ علَى بَني عيْسِ","وعلى منِ اشْتمَلَتْ عليْهِ منْ تَيْسِ",9,"س",1,1],["غَضَضْتُ عَلَى التَّوْدِيعِ جَفْنِيَ عِنْدَهَا","وَفِي الْقَلْبِ دَاءٌ لِلْفِرَاقِ دَخِيلُ",10,"ل",1,0],["غَضِبَ الأَميرُ بِأن صَدقتُ وَرُبَما","غَضِبَ الأَميرُ عَلى البَريِّ المُسلِمِ",11,"م",1,1],["غَضوبٍ مِنَ السَوطِ زَيّافَةٍ","إِذا ما اِرتَدى بِالسَراةِ الأَكَم",12,"م",1,0],["غَضبى لِمَنسِمِها صَياحٌ بِالحَصى","وَقعَ القَدومِ بِغَضرَةِ الأَفنانِ",13,"ن",1,0],["غُضّوا العُيونَ وَحَيّوهُ تَحِيَّتَهُ","مِنَ القُلوبِ إِذا لَم تُسعِدِ الكَلِمُ",14,"م",1,0],["غَضَبَ التَقِيِّ لِرَبِّهِ وَكِتابِهِ","أَو غَضبَةَ الفاروقِ لِلمُختارِ",15,"ر",1,0],["غُضّوا العُيونَ فَإِنَّ الروحَ يَصحَبُكُم","مَعَ المَلائِكِ تَكريماً لِمَحمودِ",16,"د",1,0],["غُضّي جُفونَ السِحرِ أَو فَاِرحَمي","مُتَيَّماً يَخشى نِزالَ الجُفون",17,"ن",1,1],["غَضِبَ اللَهُ أَم تَمَرَّدَتِ الأَر","ضُ فَأَنحَت عَلى بَني الإِنسانِ",18,"ن",1,0],["غَضبانُ لا يَرضى فَما قابَلتُهُ","مُتَبَسِّماً إِلّا اِستَحالَ مُقَطَّبا",19,"ب",2,0],["غُضفٌ مُهَرَّتَةُ الأَشداقِ ضارِيَةٌ","مِثلُ السَراحينِ في أَعناقِها العَذَبُ",20,"ب",1,0],["غضبتَ للدين والدنيا بحقهما","يا حبّذا غضب في الله أرضاهُ",21,"ا",2,0],["غَضِبَت طُهَيَّةُ أَن سَبَبتُ مُجاشِعاً","عَضّوا بِصُمِّ حِجارَةٍ مِن عُليَبِ",22,"ب",1,1],["غَضِبنا يَومَ طِخفَةَ قَد عَلِمتُم","فَصَفَّدنا المُلوكَ بِها اِعتِسارا",23,"ر",2,0],["غَضِبتُم عَلَيها أَو تَغَنَّيتُمُ بِها","أَنِ اِخضَرَّ مِن بَطنِ التِلاعِ غَميرُها",24,"ر",3,0],["غَضِبتَ عَلَينا أَن مَنَعنا مُجاشِعاً","قَديماً مَعينَ الماءِ فَاِحتَفَروا الضَحلا",25,"ل",2,0],["غَضِبنا لِلَذي لاقَت نُفَيلٌ","وَخَيرُ الطالِبي التَرَةِ الغَضوبُ",26,"ب",1,0],["غضاباً علينا أن تُسمَّي أمهم","حَصاناً ولا ننمي بنيها إلى بَعْلِ",27,"ل",1,1],["غَضَباً لِدينِ اللَهِ أَن لاتَغضَبوا","لَم يَشتَهِر في نَصرِهِ سَيفانِ",28,"ن",1,0],["غَضَبُ الإِلَهِ عَلى الزَبَعرى وَاِبنِهِ","وَعَذابُ سوءٍ في الحَياةِ مُقيمِ",29,"م",1,0],["غضضتُ من الجفون فلست أَرمي","ولا أُرمى بطرفٍ مسترابِ",30,"ب",1,0],["غضبتَ وظِلتَ من سَفهٍ وطيشٍ","تُهزهِزُ لحيةً في قدّ رَفْشِ",31,"ش",1,1],["غضباً فليُضَرَّم الغيظُ في الأح","شاءِ منكم ما ضرَّمُ النارَ نفطُ",32,"ط",1,0],["غضبتْ لي السماءُ والأرضُ والنا","سُ على ابن اللَّبُونِ إسماعيلِ",33,"ل",1,1],["غضبٌ ألحُّ من السحابِ الأسحمِ","ورضاً أعزُّ من الغُرابِ الأعصمِ",34,"م",1,1],["غُضّي الملامة قد كفاك ملامتي","ضيفٌ ثوى عندي بدار مُقامِ",35,"م",1,0],["غِضابٌ كَأَنّي في بَياضٍ أَكُفِّهِم","أَلا رُبَّما لَم تَستَطِعني اللَهازِمُ",36,"م",1,0],["غَضِبتَ عَلى الهِلالِ فَخَرَّ ذُعراً","وَلُحتَ لَهُ فَحاذَرَ أَن يَلوحا",37,"ح",2,0],["غَضِبَ الدَهرُ عَلى كَأسِ الصَفاء","مُذ رَآها فَأَبى أَلّا تُراق",38,"ق",1,0],["غَضَبُ العَذولِ أَخَفُّ مِن","غَضَبِ الحَبيبِ وَأَسهَلُ",39,"ل",1,0],["غَضوباً كَحَيزومِ النَعامَةِ أُحمِشَت","بِأَجوازِ خُشبٍ زالَ عَنها هَشيمُها",40,"م",3,0],["غَضبانَ قَد هَدَّدَ بِالضَر","بِ وَإِن لَم يَضرِبِ",41,"ب",1,0],["غَضَّ الشَبابُ فَكَيفَ كُن","تَ عَنِ الشَبابِ بِمَعزِلِ",42,"ل",1,0],["غَضٌّ عَلى طولِ البِلى","حَيٌّ عَلى طولِ المَنون",43,"ن",1,0],["غَضِبَت فَغَضَّ الطَرفَ كُلُّ مُكابِرٍ","يَلقاكَ بِالخَدِّ اللَطيمِ مُصَعَّرا",44,"ر",2,0],["غَضِبتُ لَهُ لَمّا رَأَيتُ صِفاتِهِ","بِلا واصِفٍ وَالشِعرُ تَهذي طَماطِمُه",45,"م",2,0],["غَضَبُ الحَسودِ إِذا لَقيتُكَ راضِياً","رُزءٌ أَخَفُّ عَلَيَّ مِن أَن يوزَنا",46,"ن",2,0],["غَضُّ الشَبابِ بَعيدٌ فَجرُ لَيلَتِهِ","مُجانِبُ العَينِ لِلفَحشاءِ وَالوَسَنِ",47,"ن",1,0],["غضبان ترمي بأمواجٍ فواقِعُها","كواكبٌ في سَناءِ المجدِ تَحكيكا",48,"ك",2,0],["غَضارَةُ دُنيا شاكَلَت بِفُنونِها","مُعاقَبَةَ الدُنيا الَّتي تَتَقَلَّبُ",49,"ب",1,0],["غَضدُ عَيشٍ زالَت غَمامَتُهُ عَن","ني وَمَن بِالغَمامَةِ المُنجابَه",50,"ب",2,0],["غَضبانُ تُجلى عَن وَقائِعِ سَيفِهِ","عَكَراتُ حُمسٍ في الحَديدِ غِضاب