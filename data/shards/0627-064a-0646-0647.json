{"poems":[[88,"أين يوم القنال يا ربة التاج","https://www.aldiwan.net/poem10696.html","الخفيف"],[90,"نكب الشارع الكبير ببغداد","https://www.aldiwan.net/poem44426.html","الخفيف"],[90,"يا إمام الهدى ورب المعالي","https://www.aldiwan.net/poem44433.html","الخفيف"],[53,"قالوا سقى الماء بطن وهب","https://www.aldiwan.net/poem8125.html","مجزوء البسيط"],[53,"قل لنجح أخطأت باب النجاح","https://www.aldiwan.net/poem9402.html","الخفيف"],[94,"ليت لي أن أعيش في هذه الدنيا","https://www.aldiwan.net/poem38950.html","الخفيف"],[87,"أيها المنتحي بأسوان دارا","https://www.aldiwan.net/poem63710.html","الخفيف"],[71,"هنيت عاما مقبلا مقبلا","https://www.aldiwan.net/poem28741.html","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39620","الخفيف"],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[325,"ماس عجبا بعطفه وترنح","https://www.aldiwan.net/poem67138.html","الخفيف"],[333,"بين أمواجك يا ده","https://www.aldiwan.net/poem55033.html","مجزوء الرمل"],[347,"يا حبيبي عد الينا","https://www.aldiwan.net/poem55358.html","مجزوء الرمل"],[376,"يا قفا طاهر وكف أبي مل","https://www.aldiwan.net/poem57006.html","الطويل"],[385,"أيد الله أسعد الوزراء","https://www.aldiwan.net/poem48764.html","الخفيف"],[519,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87116","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71071","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53148","الخفيف"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106893","الخفيف"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100509","الخفيف"],[3257,"","https://poetry.dctabudhabi.ae/diwan/poem/20060","المنسرح"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62911","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109972","الرمل"],[399,"","https://poetry.dctabudhabi.ae/diwan/poem/205765","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128934","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76503","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111454","الخفيف"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32440","الخفيف"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97073","الخفيف"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35047","الرمل"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123863","الخفيف"],[4691,"منعتني ذكر اسمها في قصيدي","https://www.poetsgate.com/ViewPoem.aspx?id=123537",""],[4737,"مثلها ليس يُنسى","https://www.poetsgate.com/ViewPoem.aspx?id=212160",""],[5186,"قلب الدهر اختيارا","https://www.poetsgate.com/ViewPoem.aspx?id=156521",""],[5213,"يا أخلاي والمناخ قريب","https://www.poetsgate.com/ViewPoem.aspx?id=170405",""],[5444,"صلوات على أعتاب بيت المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=205077",""],[5559,"من يرد للقدس نصرا","https://www.poetsgate.com/ViewPoem.aspx?id=204217",""],[6219,"معبد الشمس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77421&r=&rc=43",""],[6256,"أقفر الساح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65925&r=&rc=13",""]],"verses":[["أَينَ هارونُ مِصرَ أَينَ أَبو الأَش","بالِ رَبُّ القُصورِ رَبُّ القِيانِ",0,"ن",1,0],["أين هذا من الشوارع في الأم","صار زانت بحسنها الأمصارا",1,"ر",2,0],["أين هم منك قدروة وفعالاً","حين جاءوا وأين هم منك قدرا",2,"ر",2,0],["أين هواضيمُهُ اللواتي","كان يُداوي بها بِراكا",3,"ك",2,0],["أين هذا من دلْك نُجْحٍ فقالت","طُرُقُ الجِدِّ غَيْر طُرْقِ المُزَاحِ",4,"ح",1,0],["أينَ هوَ من خريرِ ساقية الوادي","وخفْقِ الصَّدى وشدوِ الشَّادي",5,"د",2,0],["أَينَ هوروسُ بَينَ سَيفٍ وَنِطعٍ","أَبِهَذا في شَرعِهِم كانَ يُقضى",6,"ض",2,0],["أينَ هيَ النعمةُ في قاطعٍ","بقربِهِ ما حقَّ أَنْ يوصَلا",7,"ل",2,0],["أين هذا الجمالُ أرعاهُ كالبرْ","قِ خلوباً وأجتليهِ لموعا",8,"ع",2,0],["أينَ هذا الخيالُ أُسقاهُ كأساً","بيدٍ منه فجَّرتْ ينبوعا",8,"ع",2,0],["أينهض أهل الله والحق عندهم","ونصري محصور وهمي عاسم",9,"م",1,0],["أَينَ هَذي مَهما نَكُن ذاتَ حُسنٍ","مِن صِفاتِ الَّذي بِهِ أَتَمَدَّح",10,"ح",1,0],["أين هذا الطفل ملء القل","ب ملء الناظر",11,"ر",1,0],["أين هاتيك الليالي","يا حبيبي الروح أينا",12,"ن",2,0],["أينَ هَذا وذا ومَا صَنعةُ الفَق","قاعِ مِن جِنسِ صَنعةِ الدِّيوانِ",13,"ن",1,0],["أَينَ هَذا الخَفاء بَعد ظُهور","أَينَ ذاكَ الظُهور بَعدَ الخَفاءِ",14,"ا",2,0],["أينَها منهُ رفعةً ومحلّاً","ليس قدرُ المُفيدِ كالمُستفيدِ",15,"د",1,0],["أَيُّ نَهرٍ يَجري بِأَقذر وادٍ","هُوَ لِلخَلقِ أَجمَعين مدامُ",16,"م",1,1],["أين هم من ذي سماحٍ لو قدر","وعلى قدرِ عُلاهُ وهبا",17,"ب",2,0],["أين هذا ممن بأيسر شادٍ","جاز من حلية المعالي مداها",18,"ا",3,0],["أين هذا من مقدم ترجف الأر","ض وتندك أن سطا أرجاها",18,"ا",3,0],["أين هُودٌ وقد دعا قومَ عادٍ","فعصوهُ فحلَّ فيهم وباء",19,"ا",2,0],["أَينهضُ بي نحو المكارم والعُلَي","وأَقْعُدُ إِني للحياء لطارِحُ",20,"ح",1,0],["أين هم عن تفرعاتك في الق","ول ولكن عموا عن الإنصاف",21,"ف",1,0],["أين هندٌ وهل أرادت لي الأو","جاعَ هندٌ وهل أنا في سبات",22,"ت",1,0],["أين هتاك ستر أبكار أسرا","ر علوم دجت على الأفهام",23,"م",1,0],["أَينَ هُمام الجديل إِذ أمرا","وَأَينَ رب السدير إِذ قدرا",24,"ر",2,0],["أَينَ هم عن طِرادِ خيلكَ والكرْ","رِ وقد هَرَّتِ الكُماةُ النّزالا",25,"ل",2,0],["أين هاتِيكَ الممالك والغِنَى","اينَ ذاكَ الشأنُ مع ذاكَ السَنَى",26,"ن",2,0],["اينَ هاتِيكَ العُلُومُ النَيِّره","اين تِلكَ الرَهبَناتُ المُزهِره",26,"ه",1,0],["اينَ هاتيكَ الوُجوهُ المُسفِره","ما تبَّقى غيرُ رسمٍ قد دَثَر",26,"ر",1,0],["أين همس النسيم أشواقه السك","رى انطفت لم تعد تثير خيالي",27,"ي",1,0],["أين هاروت من معاني جمال","جذبت للغرام روح قرينك",28,"ك",1,0],["أَينَ هَذا العهد من عهد مَضى","هل إِلى المَسكونة النَمرود عاد",29,"د",1,0],["أَينَ هَكطُورُ هِمَّةٌ لَكَ قِدماً","أَينَ بأسٌ وَباعُ عَزمٍ مَتين",30,"ن",1,1],["أَينَ هُم أَينَ لَستُ أَلقى كَمِيًّا","كالككلابِ التوَوا لأُسدِ العَرِينِ",30,"ن",1,0],["أَينَ هذا مِن ذاكَ سَقيا لِهذا","كَ وَلَسنا نَقولُ سَقياً لِهذا",31,"ذ",2,0],["أين هم عن عقائل ما عرفن","السير كلا ولا الهزال العواري",32,"ر",2,0],["أين هم عن حرائر بأنين","يتشاكين عن قلوب حرار",32,"ر",1,0],["أين هذا العلم ينضو","سيفه العَضب المشطّب",33,"ب",1,0],["اين هذا مما هنا يصلح الطا","هي طعاماً للهضم يصلح نافع",34,"ع",1,0],["أين هيفا؟هي التي كنت أعني","أهوانا العذريُ صار يُعاب ُ",35,"ب",1,0],["أينَها اسألُ الدَّهرَ ماذا بها","هدَّني الوجدُ هدَّاً.. أما هدَّها",36,"د",3,0],["أين هم ليلا نهارا","هم سهارى هم سكارى",37,"ر",2,0],["أين هاتيكم الليالي اللواتي","كنت فيها منعما محبوبا",38,"ب",2,0],["أينهدَّ طودُ الظَلامِ الذي","ولِدنا على سَفحه نائمين؟",39,"ن",1,0],["أين هم أبناء عرب","بالهدى سادوا النَّواح",40,"ح",1,0],["أين هم سادات قومي","قد طغا الظّلم وساح",40,"ح",1,0],["أي نهر هذا الذي يقولون","إنه يعيد الصبا؟",41,"ب",2,1],["أين هذا الشعب الذي ثار بالأمس","أحقا قد مات فيه الإباء ؟",42,"ا",2,0]]}