{"poems":[[53,"تزود من الماء النقاخ فلن ترى","https://www.aldiwan.net/poem30517.html","الطويل"],[53,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[63,"وظباء من بني أسد","https://www.aldiwan.net/poem45804.html","المديد"],[3,"بين العقيق وبين بُرقة ثهمد","https://www.aldiwan.net/poem152.html",""],[77,"وكريمة شهد الخضاب شهادة","https://www.aldiwan.net/poem36512.html","الكامل"],[88,"حق للدمع أن يكون نشيدا","https://www.aldiwan.net/poem45032.html","الخفيف"],[27,"أتذكرهم وحاجتك ادكار","https://www.aldiwan.net/poem5757.html","الوافر"],[72,"يتيم ابتسامك ما يقهر","https://www.aldiwan.net/poem18706.html","المتقارب"],[72,"جاء البشير بها فقلت لدره","https://www.aldiwan.net/poem19175.html","الكامل"],[72,"أمط بالدواء ثياب الأذى","https://www.aldiwan.net/poem20530.html","المتقارب"],[72,"جاءت العاذلات شيئا فريا","https://www.aldiwan.net/poem20564.html","الخفيف"],[29,"ألا طرقت أروى الرحال وصحبتي","https://www.aldiwan.net/poem6158.html","الطويل"],[91,"الأربعون لو انها تتكلم","https://www.aldiwan.net/poem62688.html","عموديه"],[85,"يا شبه سيدة البتول","https://www.aldiwan.net/poem6837.html","عموديه"],[56,"أصبحت ملقى في الفراش سقيما","https://www.aldiwan.net/poem58506.html","الكامل"],[43,"ليالي بعد الظاعنين شكول","https://www.aldiwan.net/poem9967.html","الطويل"],[62,"سرى يكتسي قطعا من الليل مظلما","https://www.aldiwan.net/poem52297.html","الطويل"],[62,"ما بعد يومك للحزين الموجع","https://www.aldiwan.net/poem52353.html","الكامل"],[62,"وكرمة أعراقها في الثرى","https://www.aldiwan.net/poem52501.html","السريع"],[45,"عاود القلب بثه وخباله","https://www.aldiwan.net/poem65603.html","الخفيف"],[45,"قد فقدنا الوفاء فقد الحميم","https://www.aldiwan.net/poem65689.html","الخفيف"],[28,"بنو العم أدنى الناس منا قرابة","https://www.aldiwan.net/poem4985.html","الطويل"],[2,"تبين خليلي هل ترى من ظعائن","https://www.aldiwan.net/poem25003.html","الطويل"],[58,"لنا الراية الحمراء يخفق ظلها","https://www.aldiwan.net/poem30883.html","الطويل"],[80,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[74,"ألا ليت أنفاس الرياح النواسم","https://www.aldiwan.net/poem13258.html","الطويل"],[105,"أئن تولت جنود الشرك مدبرة","https://www.aldiwan.net/poem44211.html","البسيط"],[13,"ألا تلكما عرسي منيعة ضمنت","https://www.aldiwan.net/poem2198.html","الطويل"],[52,"ومستبصر في الغدر مستعجل القلى","https://www.aldiwan.net/poem26992.html","الطويل"],[48,"أيها المنتاب عن عفره","https://www.aldiwan.net/poem63366.html","المديد"],[50,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[50,"ألا قل لعبدة إن جئتها","https://www.aldiwan.net/poem63871.html","المتقارب"],[46,"يا راعي الود الذي أفعاله","https://www.aldiwan.net/poem23629.html","الكامل"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85597","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202538","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67347","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54216","الرمل"],[106,"الوحدة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=179293",""],[58,"لَنا الرَّايَة ُ الحَمْرَاءُ يَخْفِقُ ظِلُّها","https://www.poetsgate.com/ViewPoem.aspx?id=22780",""],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[68,"شربنا على ذكرِ الحبيبِ مدامة ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15405&r=&rc=11",""],[18,"هَلْ عَرَفْتَ الْغَدَاة َ مِنْ أَطْلاَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26460&r=&rc=26",""]],"verses":[["وَكُرَّ إِلى نَجدٍ بِطَرفِكَ إِنَّهُ","مَتى يَعدُ لا يَنظُر عَقيقاً وَلا نَجدا",0,"د",2,0],["وَكَرَعتُ في حُلوِ الزَمانِ وَمُرِّهِ","ما شِئتُ وَاِعتَقَبَ العَواجِمُ عودي",1,"د",2,0],["وَكَرَيَّاهَا فَلا تَفِلَتْ","زَهَرٌ رَيّانُ مَطلولُ",2,"ل",1,0],["وَكَرَرتُ وَالأَبطالُ بَينَ تَصادُمٍ","وَتَهاجُمٍ وَتَحَزُّبٍ وَتَشَدُّدِ",3,"د",1,0],["وكَريمةٍ شهِدَ الخِضابُ شَهادَةً","بفُتُوِّها عنْدَ الأداءِ مُزوّرَهْ",4,"ه",1,1],["وكريماً زكت سجاياه حتى","كان بدعاً في المكرمات فريدا",5,"د",2,0],["وَكَرّوا كُلَّ مُقرَبَةٍ سَبوحٍ","وَطَرفٍ في حَوالِبِهِ اِضطِمارُ",6,"ر",1,0],["وكرّر لي ذكرك العاذلون","فما كانَ أحلى الذي كرَّروا",7,"ر",3,0],["وكريمة الأنساب أصدقها الندى","كفؤاً إذ أمر القريض أضاعا",8,"ع",2,0],["وكرّر أحاديث بيت الخلا","ولكن على رغم أنف العدوّ",9,"و",1,0],["وكريمُ زاكي الأصول هززنا","منه للمكرماتِ فرعاً زكيّا",10,"ي",2,0],["وَكَرّارُ خَلفَ المُرهَقينَ جَوادِهِ","حِفاظاً إِذا لَم يَحمِ أُنثى حَليلُها",11,"ل",3,0],["وَكَرِهتُمُ أَن تَنقَضي أَيّامُكُم","شَكوى لِمَن يَرثي وَمَن لا يَرحَمُ",12,"م",1,0],["وكرائمٌ من لؤلؤ","زَيَّنَّ مَرجان النحور",13,"ر",1,0],["وَكَرى يُرَوِّعُني سَرَى لَوْ أنّهُ","ظِلٌّ لكانَ الحَرَّ واليَحْمُوما",14,"م",2,0],["وَكَرّتْ فمَرّتْ في دِماءِ مَلَطْيَةٍ","مَلَطْيَةُ أُمٌّ للبَنِينَ ثَكُولُ",15,"ل",1,0],["وكرَّ بها نحوَ التِلادِ فأصبحتْ","بمدرجةِ العافينَ نهباً مقسَّمَا",16,"م",2,0],["وكرهتَ مأثورَ الحديثِ فلم تَلُذْ","بالعفوِ مأسوراً ولم تتضَرَّعِ",17,"ع",1,0],["وكَرمةٍ أعراقُها في الثَّرَى","بعيدةِ المنزِعِ والمضرَبِ",18,"ب",1,1],["وَكُراعِ الغَميمِ يَنآدُ فيها","مُرجَحِنّاً أَثلُ الغَميمِ وَضالُه",19,"ل",2,0],["وَكَريمٍ غَدا فَأَعلَقَ كَفّي","مُستَميحاً في نِعمَةٍ مِن كَريمِ",20,"م",1,0],["وَكَرّوا حِفاظاً يَومَ شُعبَةَ بِالقَنا","فَكانَت لَهُم ما كانَ آخِرُهُم مَجدا",21,"د",2,0],["وَكُرَّت جَميعاً ثُمَّ فُرِّقَ بَينَها","سَقى رُمحَهُ مِنها بِأَحمَرَ آني",22,"ن",2,0],["وَكَرزَبن نَبهانَ وَعَمرو بن جَحدَرٍ","وَصبّاحاً القَينِيِّ يَدعو وَأَسلَما",23,"م",2,0],["وكرَّت بنو زيدٍ على كلِّ شَيظَمٍ","وَسِرّ المواضي في أكفِّهمُ جهرُ",24,"ر",1,0],["وَكَرّوا وَصَدرَ السَيفِ يَدمى فَثَلَّموا","رِقاقَ الظُبى بَينَ الطُلى وَالجَماجِمِ",25,"م",1,0],["وكرّتِ الخيلُ تردِي في فوارسها","بعد الفرار فأمسى الأمرُ قد حَزبا",26,"ب",2,0],["وَكَرّي إِذا أَكرَهتُ رَهطاً وَأَهلَهُ","وَأَرضاً يَكونُ العَوصُ فيها عُجاهِنا",27,"ن",2,0],["وَكَرخِيَّةِ الأَنسابِ أَو بابِلِيَّةٍ","ثَوَت حِقَبٌ في ظُلمَةِ القارِ لا تَسري",28,"ر",2,0],["وَكَريمُ الخالِ مِن يَمَنٍ","وَكَريمُ العَمِّ مِن مُضَرِه",29,"ر",2,0],["وَكَريمٌ يَرى المَلامَةَ كَالحَي","يَةِ صَبَّحنَهُ مَذَرَّ الذُرورِ",30,"ر",1,0],["وَكَرشاءُ مُلتَئِمٌ في الحَرير","كَأَنَّ بِلَبّاتِها جاسِدا",31,"د",2,0],["وكرِهتُ من بعدِ الثلاثِ تجَشُّمي","طُرُقَ العزاءِ على تغيّرِ سَمتِها",32,"ت",3,0],["وَكَرّي إِذا نادى المُضافُ مُحَنَّباً","كَسيدِ الغَضا نَبَّهتَهُ المُتَوَرِّدِ",33,"د",1,0],["وكرَّموني وما لي ما أقابلهم","سوى ثناء على تكريمهم عطِر",34,"ر",1,0],["وكرهوا التمصير والتمدينا","وزعموا الدنيا تعفّي الدّينا",35,"ن",2,0],["وَكَرَبِّ الغِرَاسِ ي كُلِّ رَوْضٍ","ضَحِكَتْ عَنْ وُرُودِهَا الأَكْمَامُ",36,"م",1,0],["وَكَرُزْئِهِمْ رُزِئَ الرِّجَالُ مُرَحِّباً","عَفَّ اللِّسَانِ مُهَذَبَ الإِيمَاءِ",37,"ا",2,0],["وَكَرْرْتُمُ كَرَّ المُحَافِظِ إِنَّما","يَسْعَى الحَلِيمُ لِمِثْلِهِ أَحْيَانَا",38,"ن",2,0],["وكريماً بشَّرَ استهلالُه","أنَّ في فيه الهدى والْحِكمَا",39,"م",2,0],["وكرامُ النفوس تَنْسى إساءا","تِ الموالي، وتَذْكُرُ الإحسانا",40,"ن",2,0],["وكرزبن نبهان وعمر بن جحدر","وَصَبَّاحا القَيْنِيَّ يَدْعُو وَأَسْلَمَا",41,"م",2,0],["وكريٌ إذا نادى المضاف محنباً","كسيد الفضا بنهته المتورد",42,"د",1,0],["وكَرْمٌ ولا خَمْرٌ، ولي أُمُّها أُمُّ","وكرمٌ ولا خمرٌ وفي أم‍ِّها أمُّ",43,"م",1,0],["وَ كررنا عليهمِ وَ انثنينا","بسيوفٍ تقدُّ في الأوصالِ",44,"ل",1,0]]}