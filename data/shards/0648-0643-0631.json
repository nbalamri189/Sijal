ml",""],[458,"ألا فتى يسأل قلبي ماله","https://www.aldiwan.net/poem55905.html","الرجز"],[458,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[458,"أمرتجع لي فارط العيش بالحمى","https://www.aldiwan.net/poem56129.html","الطويل"],[458,"سقى زمنا ببابل عقربي","https://www.aldiwan.net/poem56146.html","الوافر"],[458,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[458,"سل في الغضا وصبا الأصائل تنفح","https://www.aldiwan.net/poem56248.html","الكامل"],[458,"دعها تكن كالسلف من أخواتها","https://www.aldiwan.net/poem56263.html","البسيط"],[458,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[458,"رعى الله في الحاجات كل نجيب","https://www.aldiwan.net/poem56301.html","الطويل"],[461,"وكريم الملتقى ذو لسن","https://www.aldiwan.net/poem16152.html","الرمل"],[479,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[479,"عاطني يا تونسي في نخبها","https://www.aldiwan.net/poem37603.html","الرمل"],[482,"فاح عرف المسك من عرف الخزام","https://www.aldiwan.net/poem24551.html","عموديه"],[486,"وكريم نال الكرامة منا","https://www.aldiwan.net/poem486.html",""],[495,"وأبى الدهر لقد جذذ","https://www.aldiwan.net/poem10234.html","مجزوء الرمل"],[495,"قرة عيني بذكا محبتي أي فلكا","https://www.aldiwan.net/poem10256.html","مجزوء الرجز"],[500,"برق حماهم ينجلي","https://www.aldiwan.net/poem37805.html","مجزوء الرجز"],[500,"رقمت في معارفي الأشياء","https://www.aldiwan.net/poem38098.html","الخفيف"],[515,"ما كنت آلف منزلي إلا به","https://www.aldiwan.net/poem12027.html","الكامل"],[515,"خطبتني الخطوب بالهم لما","https://www.aldiwan.net/poem12295.html","الخفيف"],[529,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[538,"دعاني من ذكر السقام دعانيا","https://www.aldiwan.net/poem47498.html","عموديه"],[551,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[551,"كم ذا سرى بالموت عنا مدلج","https://www.aldiwan.net/poem48018.html","الكامل"],[551,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[551,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[551,"من لداع لا يجاب","https://www.aldiwan.net/poem48097.html","مجزوء الرمل"],[558,"واحد وهو في الظهور ثلاثه","https://www.aldiwan.net/poem33515.html","الخفيف"],[561,"الحمد لله الذي استقلت","https://www.aldiwan.net/poem27845.html","الرجز"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[586,"كيف يصغي لعاذل أو يميل","https://www.aldiwan.net/poem17641.html","الخفيف"]],"verses":[["وَكُرَّ إِلى نَجدٍ بِطَرفِكَ إِنَّهُ","مَتى يَعدُ لا يَنظُر عَقيقاً وَلا نَجدا",0,"د",2,0],["وَكَرَعتُ في حُلوِ الزَمانِ وَمُرِّهِ","ما شِئتُ وَاِعتَقَبَ العَواجِمُ عودي",1,"د",2,0],["وَكَرَيَّاهَا فَلا تَفِلَتْ","زَهَرٌ رَيّانُ مَطلولُ",2,"ل",1,0],["وَكَرَرتُ وَالأَبطالُ بَينَ تَصادُمٍ","وَتَهاجُمٍ وَتَحَزُّبٍ وَتَشَدُّدِ",3,"د",1,0],["وكَريمةٍ شهِدَ الخِضابُ شَهادَةً","بفُتُوِّها عنْدَ الأداءِ مُزوّرَهْ",4,"ه",1,1],["وكريماً زكت سجاياه حتى","كان بدعاً في المكرمات فريدا",5,"د",2,0],["وَكَرّوا كُلَّ مُقرَبَةٍ سَبوحٍ","وَطَرفٍ في حَوالِبِهِ اِضطِمارُ",6,"ر",1,0],["وكرّر لي ذكرك العاذلون","فما كانَ أحلى الذي كرَّروا",7,"ر",3,0],["وكريمة الأنساب أصدقها الندى","كفؤاً إذ أمر القريض أضاعا",8,"ع",2,0],["وكرّر أحاديث بيت الخلا","ولكن على رغم أنف العدوّ",9,"و",1,0],["وكريمُ زاكي الأصول هززنا","منه للمكرماتِ فرعاً زكيّا",10,"ي",2,0],["وَكَرّارُ خَلفَ المُرهَقينَ جَوادِهِ","حِفاظاً إِذا لَم يَحمِ أُنثى حَليلُها",11,"ل",3,0],["وَكَرِهتُمُ أَن تَنقَضي أَيّامُكُم","شَكوى لِمَن يَرثي وَمَن لا يَرحَمُ",12,"م",1,0],["وكرائمٌ من لؤلؤ","زَيَّنَّ مَرجان النحور",13,"ر",1,0],["وَكَرى يُرَوِّعُني سَرَى لَوْ أنّهُ","ظِلٌّ لكانَ الحَرَّ واليَحْمُوما",14,"م",2,0],["وَكَرّتْ فمَرّتْ في دِماءِ مَلَطْيَةٍ","مَلَطْيَةُ أُمٌّ للبَنِينَ ثَكُولُ",15,"ل",1,0],["وكرَّ بها نحوَ التِلادِ فأصبحتْ","بمدرجةِ العافينَ نهباً مقسَّمَا",16,"م",2,0],["وكرهتَ مأثورَ الحديثِ فلم تَلُذْ","بالعفوِ مأسوراً ولم تتضَرَّعِ",17,"ع",1,0],["وكَرمةٍ أعراقُها في الثَّرَى","بعيدةِ المنزِعِ والمضرَبِ",18,"ب",1,1],["وَكُراعِ الغَميمِ يَنآدُ فيها","مُرجَحِنّاً أَثلُ الغَميمِ وَضالُه",19,"ل",2,0],["وَكَريمٍ غَدا فَأَعلَقَ كَفّي","مُستَميحاً في نِعمَةٍ مِن كَريمِ",20,"م",1,0],["وَكَرّوا حِفاظاً يَومَ شُعبَةَ بِالقَنا","فَكانَت لَهُم ما كانَ آخِرُهُم مَجدا",21,"د",2,0],["وَكُرَّت جَميعاً ثُمَّ فُرِّقَ بَينَها","سَقى رُمحَهُ مِنها بِأَحمَرَ آني",22,"ن",2,0],["وَكَرزَبن نَبهانَ وَعَمرو بن جَحدَرٍ","وَصبّاحاً القَينِيِّ يَدعو وَأَسلَما",23,"م",2,0],["وكرَّت بنو زيدٍ على كلِّ شَيظَمٍ","وَسِرّ المواضي في أكفِّهمُ جهرُ",24,"ر",1,0],["وَكَرّوا وَصَدرَ السَيفِ يَدمى فَثَلَّموا","رِقاقَ الظُبى بَينَ الطُلى وَالجَماجِمِ",25,"م",1,0],["وكرّتِ الخيلُ تردِي في فوارسها","بعد الفرار فأمسى الأمرُ قد حَزبا",26,"ب",2,0],["وَكَرّي إِذا أَكرَهتُ رَهطاً وَأَهلَهُ","وَأَرضاً يَكونُ العَوصُ فيها عُجاهِنا",27,"ن",2,0],["وَكَرخِيَّةِ الأَنسابِ أَو بابِلِيَّةٍ","ثَوَت حِقَبٌ في ظُلمَةِ القارِ لا تَسري",28,"ر",2,0],["وَكَريمُ الخالِ مِن يَمَنٍ","وَكَريمُ العَمِّ مِن مُضَرِه",29,"ر",2,0],["وَكَريمٌ يَرى المَلامَةَ كَالحَي","يَةِ صَبَّحنَهُ مَذَرَّ الذُرورِ",30,"ر",1,0],["وَكَرشاءُ مُلتَئِمٌ في الحَرير","كَأَنَّ بِلَبّاتِها جاسِدا",31,"د",2,0],["وكرِهتُ من بعدِ الثلاثِ تجَشُّمي","طُرُقَ العزاءِ على تغيّرِ سَمتِها",32,"ت",3,0],["وَكَرّي إِذا نادى المُضافُ مُحَنَّباً","كَسيدِ الغَضا نَبَّهتَهُ المُتَوَرِّدِ",33,"د",1,0],["وكرَّموني وما لي ما أقابلهم","سوى ثناء على تكريمهم عطِر",34,"ر",1,0],["وكرهوا التمصير والتمدينا","وزعموا الدنيا تعفّي الدّينا",35,"ن",2,0],["وَكَرَبِّ الغِرَاسِ ي كُلِّ رَوْضٍ","ضَحِكَتْ عَنْ وُرُودِهَا الأَكْمَامُ",36,"م",1,0],["وَكَرُزْئِهِمْ رُزِئَ الرِّجَالُ مُرَحِّباً","عَفَّ اللِّسَانِ مُهَذَبَ الإِيمَاءِ",37,"ا",2,0],["وَكَرْرْتُمُ كَرَّ المُحَافِظِ إِنَّما","يَسْعَى الحَلِيمُ لِمِثْلِهِ أَحْيَانَا",38,"ن",2,0],["وكريماً بشَّرَ استهلالُه","أنَّ في فيه الهدى والْحِكمَا",39,"م",2,0],["وكرامُ النفوس تَنْسى إساءا","تِ الموالي، وتَذْكُرُ الإحسانا",40,"ن",2,0],["وكرّ شباب الحمى فالطريق","ربيع تهادى وفجر بدا",41,"د",2,0],["وكرزبن نبهان وعمر بن جحدر","وَصَبَّاحا القَيْنِيَّ يَدْعُو وَأَسْلَمَا",42,"م",2,0],["وكريٌ إذا نادى المضاف محنباً","كسيد الفضا بنهته المتورد",43,"د",1,0],["وكَرْمٌ ولا خَمْرٌ، ولي أُمُّها أُمُّ","وكرمٌ ولا خمرٌ وفي أم‍ِّها أمُّ",44,"م",1,0],["وَ كررنا عليهمِ وَ انثنينا","بسيوفٍ تقدُّ في الأوصالِ",45,"ل",1,0],["وكرام العرق فاحفظ ودهم","انما اهل الوفاء الكرما",46,"م",2,0],["وكراماته الجليلة جلت","عن بلوغ الاحصاء والتعداد",47,"د",1,0],["وكرامته الشريفة جلت","على حساب وقد علت أسماه",48,"ا",2,0],["وكراماته الشريفة تتلى","بلسان الثنا على الأسماع",49,"ع",1,0],["وكَرِهْتُ زَجْرَ القاعِدِينَ عَنِ العُلَى","ومَلَلْتُ موعظةً ونَهيَ الزَّاجِرِ",50,"ر",1,0],["وكرمت حتى لست تدرين الهوى","والبغض والأطماع والأوجالا",51,"ل",2,0],["وكرم جلعاد ما بعد التي عصروا","بالسلط منها تلذ الشرب صهباء",52,"ا",2,0],["وكرّر الخطب أحمالاً فما ضعفت","منّا نفوس ولا كلّت مرامينا",53,"ن",2,0],["وكريماً يفرهُ كلُّ لسان","في البرايا بمدحِه وثنائه",54,"ا",3,0],["وكريماً يهجِّنُ الكرمَ الفذَّ","نداه ويفضحُ الأجوادَا",55,"د",2,0],["وكَرعتُ سَلسالَ الغدير وليس ما","بُلّ الشفاهُ به يُبَلُّ غليلُ",56,"ل",1,0],["وَكَرِيمَةٍ سَقَتِ الرّيَاضَ بِدرِّها","فَغَدتْ تَنُوبُ عَنِ السَّحَابِ الهَامِعِ",57,"ع",1,1],["وَكَريمَةُ الطَرفينِ ذِروَةُ وائِلٍ","آباؤُها وَجُدودُها إِذ تُنسَبُ",58,"ب",1,0],["وكرّمت نفسي من مؤاخاة جاهل","كثير الخطايا جهلُه ما يغبّه",59,"ب",2,0],["وَكرِّر المولِدَ ثمَّ المولدا","تَعِش سَعيداً وتمُت في سعدِ",60,"د",1,0],["وكريمٍ سَلَبَتْهُ عَقْلَهُ","فانبرى يرفلُ في ثوبِ لئيم",61,"م",1,0],["وكَرِينَةٌ عَذراءُ يونانيَّةٌ","كالبدر غُرَّتها لذي إقمار",62,"ر",1,0],["وكريما بحاتم الجود يزري","بالعطا الوافر المديد السريع",63,"ع",1,0],["وكرامة يشتط في تحقيرها","نذل حقير القلب لا يتأثم",64,"م",1,0],["وكَرَّاتِ مجارِينا","من المختار للجَسْر",65,"ر",1,0],["وَكَرَّ عَلى الحِيَاضِ مُحَلَّآتٍ","حَوائِمُ لا يُبَلُّ لَها هِيامُ",66,"م",1,0],["وَكررتَ يَومَ التَلِّ حَتّى لَم يَكُن","إِلّا أَسيرٌ مِنهُمُ وَقَتيلُ",67,"ل",1,0],["وكرّر على سمعي أحاديثَ وصفِها","ففيها شفاء القلب يا سعد يا سعدُ",68,"د",1,0],["وَكَرَّمَهُ عَنْ أَنْ يُسَبَّ بِمِثْلِهِ الزَّ","مانُ كَمالٌ زَيَّنَ الجَدَّ بِالْفَهْمِ",69,"م",1,0],["وكرامةً لسهامِه","نَحَّيْتُ عن قلبي مجنّي",70,"ن",2,0],["وَكرّر بها سُكراً حلالاً وسكّراً","حَلا لا يملّ الدهر ذائقه اللبّي",71,"ب",2,0],["وَكَريماً مِن بَيتِ مَجدٍ مُشَيَّدِ","جَلَّ شَأناً مَقامَهُ عَن قُصورِ",72,"ر",1,0],["وَكَريم النَفس تَأبى نَفسه","خُطّةَ الخسف وَاِيضاع الجَنابِ",73,"ب",1,0],["وَكرّر عَلى سَمعي أَحاديث نيبها","فَقد رَدّت الاِمواج سائِلَة نَهرا",74,"ر",2,0],["وكريمٌ من السّماءِ مُعانٌ","وعلى الدّهرِ للعُفاةِ مُعِين",75,"ن",1,0],["وكَرعْنَ من ماء النُّقَيْبِ عَشيّةً","واللّيلُ جَفْنٌ بالدُّجَى لم يُكْحَل",76,"ل",1,0],["وكرامٍ مثْلِ الأهِّلةِ أيا","مَ سِرارٍ فما لَها من تَراء",77,"ا",2,0],["وَكَريمُ أَنسابِ الطِعانِ فَلَم يَكُن","ذا طَعنَةٍ في مُدبِرٍ مِن مُقبِلِ",78,"ل",1,0],["وَكَرَّرتُهُ","فَمِن حَيثُما واجَهتُهُ قَد تَبَسَّما",79,"م",2,0],["وكرهت منه محبةً أبويةً","ورضيت منه ببعده وببغضه",80,"ض",2,0],["وكرور أيامٍ تمرُّ كأنها","مرُّ السحاب تُفيدنا الأنباءَ",81,"ا",2,0],["وكرعتُ فيهِ ماءَ عيشٍ آجناً","أَضحى الفُؤادُ بسُؤرهِ يتقاءى",82,"ا",2,0],["وَكَرّم خاطِراً لَم يَجرِ فيهِ","مني إِلّا حَديثك مِن قَريب",83,"ب",1,0],["وكروب وأمور جمة","ما لداها سيدي الأدواك",84,"ك",1,0],["وكر وبه لا تنتهي","وهمومه نحو البطط",85,"ط",1,0],["وكريمٌ بما وجدتُ على فَقري","وكم باخلٍ بردّ السَّلام",86,"م",1,0],["وكره الدنيا إلى كامل","لكل ما أهلته يكمل",87,"ل",1,0],["وَكَرَّ عَلَيهِم كَرَّة حميرية","أَبادهمُ بالسَيفِ طراً فَأَزعَجا",88,"ج",2,0],["وكرامةٍ أبداً أبوحُ بشكرِها","إنّ الكريمَ على الكرامةِ يُشكَرُ",89,"ر",1,0],["وكريمٍ من معالي ذاتِهِ","لم تجد في نفسه عُجباً وكِبرا",90,"ر",2,0],["وكرّ البلا في كربلاء فأَصْبَحَتْ","مواقف للبلوى ووقفاً على الضّرّ",91,"ر",1,0],["وكرام من كل قاسم جيش","قد تسامى به النداء الغزيرُ",92,"ر",1,0],["وكرمةٌ من أدبٍ كاد أن","يعصُرَ منها عنبُ القَرْقَفِ",93,"ف",1,0],["وكَرَّةٍ بعدَ أُخرى فِي نَدى ووَغىً","بَنْيتَها لسماواتِ العُلا دَرَجَا",94,"ج",2,0],["وَكَرَرْتَ خيلَ اللهِ تَحْمِلُ مِثْلَها","أَطْلاحَ أَسفارٍ عَلَى أَطلاحِها",95,"ح",3,0],["وكَرَّمَ نفسَ الحِلْمِ عن وَغَرِ ا