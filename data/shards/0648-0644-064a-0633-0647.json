{"poems":[[23,"بطيبة رسم للرسول ومعهد","https://www.aldiwan.net/poem21547.html","الطويل"],[51,"كم من حكيم يبغي بحكمته","https://www.aldiwan.net/poem10853.html","المنسرح"],[92,"أعيذك أن يعاصيك القصيد","https://www.aldiwan.net/poem60159.html","عموديه"],[48,"تجاوزت عني الأقدار ذاهبة","https://www.aldiwan.net/poem22334.html","البسيط"],[23,"بطيبة رسم للرسول","https://www.poetsgate.com/ViewPoem.aspx?id=11422",""],[92,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[124,"رعى الله أيام الطفولة إنها","https://www.aldiwan.net/poem49279.html","الطويل"],[164,"وافا على قدر لأمر قد قدر","https://www.aldiwan.net/poem58838.html","الكامل"],[261,"أبا الحسين الزمان ذو دول","https://www.aldiwan.net/poem48473.html","المنسرح"],[275,"ها ردفها يأخذ من صدرها","https://www.aldiwan.net/poem35390.html","السريع"],[280,"أبين واشتياق وارتياع","https://www.aldiwan.net/poem25483.html","الوافر"],[347,"ما بين اخفاق حبي","https://www.aldiwan.net/poem55335.html","المجتث"],[563,"لقد أوقعت دعوى المحبة في البلا","https://www.aldiwan.net/poem33884.html","الطويل"],[563,"كلانا له هذا الوجود المحقق","https://www.aldiwan.net/poem34293.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48509","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46540","الرجز"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42445","الوافر"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42404","الوافر"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120954","البسيط"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45698","السريع"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84833","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201713","الوافر"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132168","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83189","الرجز"],[4691,"تهيّف شعري","https://www.poetsgate.com/ViewPoem.aspx?id=136805",""],[4767,"موسم الأمطار","https://www.poetsgate.com/ViewPoem.aspx?id=180857",""],[5050,"تجلد أخي وخل الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=38207",""],[5072,"كفى هوساً","https://www.poetsgate.com/ViewPoem.aspx?id=52569",""],[231,"إلى الشاطئ المجهول","https://www.poetsgate.com/ViewPoem.aspx?id=186165",""],[592,"لعمرك ما يدري الغبي بأنه","https://www.poetsgate.com/ViewPoem.aspx?id=128805",""]],"verses":[["وَلَيسَ هَوايَ نازِعاً عَن ثَنائِهِ","لَعَلّي بِهِ في جَنَّةِ الخُلدِ أَخلَدُ",0,"د",1,0],["وَلَيسَ هَذا الَّذي بِهِ حَكَمَ ال","رَحمَنُ في عَدلِهِ وَرَحمَتِهِ",1,"ت",2,0],["وليس هناك إلا من يطاطي","إلى المستعمرين ومن يذود",2,"د",1,0],["وَلَيسَ هُدبا جُفوني ريشَتَي سُبَدٍ","إِذا تَمَطَّرَ تَحتَ العارِضِ السَبَد",3,"د",1,0],["وليسَ هوائي نازعاً عنْ ثنائهِ","لعلي بهِ فِي جنةِ الخلدِ أخلدُ",4,"د",1,0],["وليس هناكَ شكٌ في حياةٍ","تدوسُ العاجزين ولا مِراء",5,"ا",2,0],["ولي سهمة من كل لهو كأنما","تباري الورى أن يبلغوني مراديا",6,"ي",2,0],["وليسهلنَّ عليك يا ملك الورى","فأحمد إلهك كلُّ مطلوب عسر",7,"ر",1,0],["وليس هذا وقت الخطاب على","جرايةٍ تقتضي ولا عمل",8,"ل",1,0],["وليسَ هذا الشعرُ من حُسنِها","إلا خُماراً جاءَ من خَمرها",9,"ر",3,0],["وَلَيْسَ هَوَى الأَحِبَّة غَيْرَ عِلْقٍ","لَدَيَّ فَمَا يُعَارُ ولا يُباعُ",10,"ع",1,0],["وليس همي أبقى","حياً أو اودع رمسي",11,"س",2,0],["وليس هما شيئين يا نفس فافهمي","كلامي فكم حارت بذاك فهوم",12,"م",1,0],["وليس هما باثنين ندريهما معاً","كما عند ذي جهل بذلك ينطق",13,"ق",1,0],["وليس همك من أمري بأكبر من","همي ولكنني مستعذبٌ ألمي",14,"م",2,0],["وَلَيسَ هَذا حَقاً","وَلا أراه صدقا",15,"ق",2,0],["وليسَ هزارُ طبعي غيرَ ظامٍ","رأى ورداً على بُعدٍ فغرَّدْ",16,"د",1,0],["وليسَ هناك إلّا المسكُ لكنْ","لهيبُ الوجنةِ الحمرا أسالهْ",17,"ل",2,0],["وليس هذا ببدع من مكارمه","ساوت أوائله فيه أواخره",18,"ه",1,1],["وَلَيسَ هَذا لِسوى كسرةٍ","تكسر ما زالَت لَهُ سالِمَه",19,"م",2,0],["وَلَيسَ هَولاَءِ قِيَاسَ مَنتَخِ","بَل ذِكرُهُم أليَقُ عِندِي يا أَخي",20,"ي",1,0],["وَلَيسَ هَذا عَجيباً حَيث شَرفها","مَن صارَ مُبتَهِجاً مِن نُورِهِ الدَهر",21,"ر",1,0],["وليس هجومهم إلا دفاعاً","لصدِّ النور عن دنيا الظلام",22,"م",1,0],["وليس هنالك أمن فان","رمتكِ يدا صائدٍ تصرعي",23,"ع",2,0],["وليس هذا منتهى القتال","وعبث الأزمة والوبال",24,"ل",1,0],["وَلَيسَ هَذا مِن سِماتِ الفَضلِ","بَل إِنَّهُ خرقٌ وَسُوءُ فِعلِ",25,"ل",1,0],["وليس هوى إذ لا تموت من الهوى","وتصرعك الأشواق إذ غابَ مسعفُ",26,"ف",1,0],["وليس هذا كل ما أتى به","على البلاد موسمُ الأمطار",27,"ر",1,0],["وليس هماما فتى ظل في","جميع مطالبه ذا أسى",28,"س",2,0],["وليس هناك خاتمة ً لحزني","فحزني حزن ُ جائعة ِ القطيع ِ",29,"ع",1,0],["وليس هنا ( غير ) وليس هنا ( أنا )","هنا الوحدة الكبرى التي احتجبت سرا",30,"ر",2,0],["وليس هو الدين الحنيفي الهدى","وكان لدى هذا ابتداعاً ومأثما",31,"م",2,0]]}