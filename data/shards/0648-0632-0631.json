الله صل وسلِّم","https://www.poetsgate.com/ViewPoem.aspx?id=171099",""],[4927,"يا قبلة الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=4540",""],[4927,"تحية البلاد","https://www.poetsgate.com/ViewPoem.aspx?id=4573",""],[4984,"الفاصلة .. ، ..","https://www.poetsgate.com/ViewPoem.aspx?id=197617",""],[5001,"في مدح النبي صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=176233",""],[4119,"تفي بضمانها البيض الحداد","https://www.poetsgate.com/ViewPoem.aspx?id=16114",""],[5038,"طوق الحمام","https://www.poetsgate.com/ViewPoem.aspx?id=189986",""],[5092,"إلى الفاتنة","https://www.poetsgate.com/ViewPoem.aspx?id=139721",""],[5145,"من للأرامل واليتامى","https://www.poetsgate.com/ViewPoem.aspx?id=108053",""],[5145,"حكم اعتساف قضية الأزمان","https://www.poetsgate.com/ViewPoem.aspx?id=108117",""],[5185,"حلاوة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=72851",""],[5185,"الله أكبر أيها الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=117929",""],[5273,"قَبَسٌ من دارِ الأرقَم","https://www.poetsgate.com/ViewPoem.aspx?id=208601",""],[5277,"قبضةٌ من أثرِ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=210888",""],[5285,"الكلُّ أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=203143",""],[5285,"نوَّارة","https://www.poetsgate.com/ViewPoem.aspx?id=203655",""],[5300,"ذكرت فراقا والتفرّق يصدع","https://www.poetsgate.com/ViewPoem.aspx?id=200452",""],[5329,"فكرةٌ شدهى","https://www.poetsgate.com/ViewPoem.aspx?id=214707",""],[592,"على الحبر بحر العلم بدر المنابر","https://www.poetsgate.com/ViewPoem.aspx?id=128847",""],[5431,"معادلة رياضياتية!","https://www.poetsgate.com/ViewPoem.aspx?id=192664",""],[5431,"حتى نعود إلى الدروب البوصلة ...","https://www.poetsgate.com/ViewPoem.aspx?id=198783",""],[5431,"والحب لا يتقسمُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=198932",""],[5561,"شهرزاد","https://www.poetsgate.com/ViewPoem.aspx?id=192903",""],[5582,"لَئِنْ تُخْفِ ما بِكَ أَوْ تَصْبِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=187009",""],[5691,"وفاق","https://www.poetsgate.com/ViewPoem.aspx?id=206444",""],[5720,"قراري ..","https://www.poetsgate.com/ViewPoem.aspx?id=198925",""],[3967,"دَع ودرود ذات دل رداح","https://www.poetsgate.com/ViewPoem.aspx?id=104003",""],[5736,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=203802",""],[5759,"نشيدُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=214175",""],[5784,"علم فؤادك","https://www.poetsgate.com/ViewPoem.aspx?id=189812",""],[5786,"يا بارقاً لاحَ من أكتاف كوفانِ","https://www.poetsgate.com/ViewPoem.aspx?id=50655",""],[5861,"ذا ردها","https://www.poetsgate.com/ViewPoem.aspx?id=188044",""],[5861,"صرخة أم","https://www.poetsgate.com/ViewPoem.aspx?id=188056",""],[5888,"رؤيا وواقع مرير","https://www.poetsgate.com/ViewPoem.aspx?id=214508",""],[5957,"لَكَ أنتَ","https://www.poetsgate.com/ViewPoem.aspx?id=12232",""],[5974,"غربة","https://www.poetsgate.com/ViewPoem.aspx?id=208112",""],[469,"وزرت مصرا بغاب من قنا وظبى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574817",""],[520,"أيا اذن الأيام ان قلت فاسمعي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577575",""],[6233,"عيناكِ تعلنان هزيمتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82633&r=&rc=32",""],[454,"اللغة العربية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82687&r=&rc=51",""]],"verses":[["وَزُرنا رَسولَ اللَهِ ثُمَّ بُعَيدَهُ","قُبورَ رِجالٍ ما سَلَونا مُصابَها",0,"ب",3,0],["وزُرْنا فِناءً لمْ تَزَلْ في عِراصِهِ","مِدائِحُ تُروَى أو جِباهٌ تُعَفَّرُ",1,"ر",1,0],["وزُرْنا بَني كَعْبٍ فخِلْنا وُجُوهَهُمْ","شُموساً نَبَتْ عَنها النّواظِرُ بُزَّغا",2,"غ",2,0],["وزُرْنَ أروَعَ لا يَثني مَسامِعَهُ","عنْ دَعوَةِ الجارِ تأنيبٌ وتَفنيدُ",3,"د",1,0],["وزُرْتَ كما زارَ الرّبيعُ مُطَبِّقاً","نَداهُ فأحْيا كُلَّ مُثْرٍ ومُعْدِمِ",4,"م",1,0],["وزُرْ تُرْبَةَ المعْصومِ إنّ مَزارَها","هو الحجُّ يُمْضى نحْوَهُ كلّ ضامِرِ",5,"ر",1,0],["وزرقِ عيونِ للأسنة قد بكت","ولا دمعَ إلاّ ما أسيل به الدمُ",6,"م",1,0],["وَزُرقٍ تَشُقُّ البُردَ عَن مُهَجِ العِدى","وَتَسكُنُ مِنهُم أَينَما سَكَنَ الحِقدُ",7,"د",1,0],["وُزَراءُ الخلائف المسْتشارُو","نَ إذا حار خائِضُو الأخواض",8,"ض",1,0],["وَزِرٌّ أَضاعَتهُ الكَتائِبُ حَولَهُ","فَأَصبَحَ مَحطومَ الذِراعَينِ وَالنَحرِ",9,"ر",1,0],["وزَرَعْتُ الأَحلامَ في قلبيَ الدَّا","مي وحوَّطْتُها بكلِّ انتباهي",10,"ي",1,0],["وَزُراءُ مَملَكَةٍ وَدَعائِمُ دَولَةٍ","أَعلامُ مُؤتَمَرٍ أُسودُ صَباحِ",11,"ح",1,0],["وزُرْقٌ كأحداقِ الوُشاةِ خبيرةٌ","بحيثُ الهَوى والوجدُ والسِرُّ أجمعُ",12,"ع",1,0],["وَزَرُ الخِلافَةِ حينَ يُعضِلُ حادِثٌ","وَشَهابُها في المُظلِماتِ الواقِدِ",13,"د",1,0],["وَزَرُ الهُدى وَمَغاثُهُ ال","أَدنى وَمَفزَعُهُ وَرِدُّه",14,"د",2,0],["وَزَرَّ فُروجَ المُرهَفاتِ عَلى بَني","زُرارَةَ فَاِختاروا عَلَيها السَلاسِلا",15,"ل",2,0],["وزُرْنا منه ليثَ الغابِ طَلْقاً","ولم نرَ قبلَه ليثاً يُزارُ",16,"ر",1,0],["وَزُرنا فَإِنَّ أَلَذَّ الهِباتِ","إِعادَةُ أَيّامِنا الذاهِباتِ",17,"ت",1,0],["وَزُرتُ بِلاداً يُنبِتُ العِزَّ أَرضُها","وَيَنجَحُ في أَبناءِ أَبياتِها العَقدُ",18,"د",1,0],["وَزُرنا فَأُسدُ الحَيِّ تُذكي لِحاظَها","وَيُسمَعُ في غابِ الرِماحِ زَئيرُها",19,"ر",3,0],["وَزُرتُ مُلوكاً كُنتُ أَسمَعُ وَصفَهُم","فَيُنهِضُني شَوقي وَيُقعِدُني أَمني",20,"ن",2,0],["وزرافةٍ في الجوفِ من أنبوبها","ماءٌ يريكَ الجري في الطيرانِ",21,"ن",1,0],["وزرق ذبابٍ في الثعالب أجْدَبَتْ","وما انتجعتْ إلّا نجيعَ الضراغمِ",22,"م",1,0],["وَزَرقاءَ في لَونِ السَّماءِ تَنَبَّهَتْ","لِتَحبِيكِها ريحٌ تَهُبُّ مَعَ الفَجرِ",23,"ر",1,1],["وزرتُهُ يوماً فصادفْتُهُ","يكتبُ أسماءَ الطفيليَّهْ",24,"ه",1,1],["وَزُرقُ مَقيلِ المَوتِ تَحتَ ظُباتِها","وَنَبلٌ وَسُمرٌ ما لَهُنَّ مُجيرُ",25,"ر",1,0],["وزرعناكَ على أجفانِنا","ونشرنا فوقكَ الهُدْبَ الورِيقا",26,"ق",2,0],["وَزُرتُ هُماماً يُصبِحُ الناسُ حَولَهُ","عُكوفاً عَلَيهِم ذِلَّةٌ وَخُضوعُ",27,"ع",1,0],["وَزُرنَ شَيبانَ فَنامَت بِهِ","عَينٌ وَلَم تَأرَق عَلى مُذنِبِ",28,"ب",1,0],["وَزُرنَ عَن غَيرِ بِرٍّ","عُجمَ الأَنامِ وَعُربَه",29,"ب",2,0],["وَزَرَّ عَلَيْكَ الأُفْقُ طَوْقَ غَمَامَةٍ","خَضِيبَةِ كَفِّ الْبَرْقِ حَنَّانَةِ الرَّعْدِ",30,"د",1,0],["وزرعتَ من المعروف لها","ما عند اللّه ستَحْصُدهُ",31,"د",2,0],["وزرعت اللصوص في كل درب","وعلّي ابتلاع أشواك زرعي",32,"ع",2,0],["وزرعناها وداعا ولقا","وفرشناها حوارا وعتابا",33,"ب",2,0],["وَزَرَّ فُرُوجَ المُرْهَفَاتِ عَلى بَني","زُراةَ، فاختارُوا علَيها السّلاسِلا",34,"ل",2,0],["وزرقٍ تشقُّ البردَ عنْ منهجِ العدا","وتسكنُ منهمْ أينما سكنَ الحقدُ",35,"د",1,0],["وزُرقُ الحساسين من بعدنا","سيطعمها وهي أولادنُا",36,"ن",2,0],["وَزُرْقَةِ عَيْنَيْهَا وَبَرْدِ صَفَائِهَا","وَحُمْرَةِ خَدَّيْهَا وَوَرْدِ حَيَائِهَا",37,"ه",2,0],["وَزُرتَهُ لا سِوى ظِلي يُسايِرُني","ثُم اِنثَنيت وَحَولي الغيد وَالصَيدُ",38,"د",1,0],["وزر ثقيل لا اقوم بعبإه","قد شب منه بمهجتي نيران",39,"ن",1,0],["وَزُرهُ فَإنَّ رَائِرَهُ جَدِيرٌ","بإعطَاءِالعُلُوِّ مِن العَلِيِّ",40,"ي",1,0],["وَزَرافَتانِ أُقيمَتا كِلتاهُما","رانٍ إِلَيكَ بِمُقلَةٍ لا تَهجَعُ",41,"ع",1,0],["وزروة لغدير الجور قد لبست","لنا أباطحها موشية الحبر",42,"ر",1,0],["وزريتَ في شاوِ السَّماح","على علا كعب بن مامه",43,"م",2,0],["وزرت عمّا قريب","للأنس بابالبنود",44,"د",1,0],["وزر قرن الشمس أو كادت ترى","البسها الغيم صفات الخمر",45,"ر",1,0],["وَزَرداً وَآذيناً وَفَهداً وَجَمعَهُم","غَداةَ الوَغى بِالمُرهَفاتِ القَواصِلِ",46,"ل",1,0],["وزرته ذات يوم","فكان في الهرب حاذق",47,"ق",1,0],["وَزَرَعتِ الآمالَ فيَّ نُجوماً","أَيُّ كَنز أَحبَّ مِنها وَأَغنى",48,"ن",2,0],["وَزَرّ على الأفْق الغمامُ ثِيابَه","فقُمْ فالْقه في عُدّةٍ وحِراب",49,"ب",1,0],["وَزُرتُ الوُلاةَ وَخُضتُ الفَلاةَ","طَوراً ثَواءً وَطَوراً صُرى",50,"ر",2,0],["وَزُرتُ بِها حِمى مَلِكٍ كَريمٍ","يُبَخَّلُ حينَ تَذكُرُهُ الكِرامُ",51,"م",1,0],["وَزر قبور أَولاك الصالحين فهم","لِلَّه في الارض أَبدال من الرسل",52,"ل",1,0],["وزرْ في ربى نجدٍ ديار ابن مالك","تجد كل مجد من تليد وطارف",53,"ف",1,0],["وَزُر أَخاكَ عارفا","بحقّه مُلاطفا",54,"ف",2,0],["وزرنا عروس الحي وسط خبائها","مسربلة بالحسن والنور والثنا",55,"ن",2,0],["وَزَرعٌ وَكُلُّ الزَرعِ يُشبِهُ أَصلَهُ","هُمُ وُلِدوا شَتّى مُكِيسٌ وَمُحمِقُ",56,"ق",1,0],["وزرتكَ في الدير والمسجد","فلم تدنُ مني ولم تبعد",57,"د",1,0],["وزرعنا فيكم مرحمة","فحصدنا منكم الشتم جزاء",58,"ا",2,0],["وَزُر حِمى