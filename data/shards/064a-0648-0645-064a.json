//www.poetsgate.com/ViewPoem.aspx?id=205251",""],[5690,"هذا زفاف لهُ الأكوان قد قصت","https://www.poetsgate.com/ViewPoem.aspx?id=172271",""],[5694,"الهوى الأصلي","https://www.poetsgate.com/ViewPoem.aspx?id=132091",""],[5764,"يومين !","https://www.poetsgate.com/ViewPoem.aspx?id=153632",""],[5770,"نجوى طائر","https://www.poetsgate.com/ViewPoem.aspx?id=178264",""],[5864,"يومٌ يظلُّ بسِفرِ الدَّهر عنوانا","https://www.poetsgate.com/ViewPoem.aspx?id=190052",""],[6008,"المكوك","https://www.poetsgate.com/ViewPoem.aspx?id=61067",""],[6068,"لو تسألوني عن هوى كبدي -12-","https://www.poetsgate.com/ViewPoem.aspx?id=175855",""],[463,"اللَّيلُ بعدَ اليأسِ أطمعَ ناظري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60083&r=&rc=139",""],[6273,"أسئلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78503&r=&rc=1",""]],"verses":[["يَومٌ يَوَدُّ القِرنُ لَو أَنَّهُ","يَزيدُ في الرُمحِ مِنَ المِعصَمِ",0,"م",1,0],["يَومَ يَغدو وَجهُهُ عَن مَعشَرٍ","مُعرِضاً مُمتَنِعاً عِندَ اللُقى",1,"ا",1,0],["يَومٌ يُريكَ جَلالُهُ وَرُواؤُهُ","في الحُسنِ قُدرَةَ فالِقِ الإِصباحِ",2,"ح",1,0],["يومئذ والكون ملك لكم","ثم وقد أصلحه الانقلاب",3,"ب",1,0],["يومي على ليلايَ عامٌ كاملٌ","الصيف قلبي والشتاء جفوني",4,"ن",2,0],["يومٌ يُسمَّى حين يكنى غيرُهُ","لا بل يُكَنَّى غيرُهُ ويُلَقَّبُ",5,"ب",1,0],["يومٌ يبكِّينا وآونةً","يومٌ يبكِّينا عليه غَدُهْ",6,"د",2,0],["يومٌ يُثار به ندى غده","لا زال دأَبُكَ هكذا أبدا",7,"د",2,0],["يَومَ يَستَشعِرُ المُراؤونَ مِنّا","إِنَّما الخاسِرونَ أَهلُ الرِياءِ",8,"ا",2,0],["يَومٌ يَكونُ بِهِ الجَميعُ عَساكِراً","وَالكُلُّ يَدخُلُ في الوَغى مُختارا",9,"ر",2,0],["يَومٌ يُسَطَّرُ في الكِتابِ مَكانُهُ","كَمَكانِ بِسمِ اللهَِ في خَتَماتِهِ",10,"ت",2,0],["يَومَ يَقول الرَسول قَد أَذنَت","فأت عَلى غَيرِ رِقبَةٍ وَلِجِ",11,"ج",1,1],["يومئذ يود كل","ناقد لو يسلم",12,"م",1,0],["يوم يزجوني للجحيم تلظى","سبعة من أملاك ربي الشداد",13,"د",1,0],["يومي بِتاجٍ في الحَضارَةِ مُعرِقٍ","تَعنو الجِباهُ لِعِزِّهِ وَالهامُ",14,"م",1,0],["يَومٌ يَتيهُ عَلى الزَمانِ صَباحُهُ","وَمَساؤُهُ بِمُحَمَّدٍ وَضّاءُ",15,"ا",2,0],["يومٌ يقوتُ المُرْهَفاتِ وقد غدتْ","غرثَى ويُروي السُمْرَ وهي حِرارُ",16,"ر",1,0],["يَومَ يَهديكَ مُحِبّوكَ إِلى","ظُلمَةِ القَبرِ وَضيقِ المُضطَجَع",17,"ع",1,0],["يَومٌ يُنادى فيهِ كُلُّ مُضَلِّلٍ","بُمُقَطَّعاتِ النارِ وَالأَغلالِ",18,"ل",1,0],["يَومٌ يَجيءُ إِذا قامَ الحِسابُ وَلَم","يَذمُمهُ بَدرٌ وَلَم يُفضَح بِهِ أُحُدُ",19,"د",1,0],["يَومي مِنَ الدَهرِ مِثلُ الدَهرِ مُشتَهِرٌ","عَزماً وَحَزماً وَساعي مِنهُ كَالحِقَبِ",20,"ب",1,0],["يومَ يَمشِي الصِّدِّيقُ في نوره الزا","هي يُوالِي رواحه والبُكورا",21,"ر",2,0],["يومئذٍ أُلقي على عودَيهْ","لَحْنَ الهوى أْمزُجُه بالعتابْ",22,"ب",1,0],["يَومَ يَقُولُ الرَسُولُ قَد أَذِنَت","فَأَتِ عَلى غَير رِقبَةٍ فَلِجِ",23,"ج",1,0],["يَومَ يَشكو طَرفي إِلى طَرفِكَ الحُب","بُ فَأَوحى إِلَيهِ أَن قَد عَلِمتا",24,"ت",2,0],["يَومَ يَخوضُ الحَربَ مِنّي عالِمٌ","إِنَّ يَدَ الحَتفِ تُصيبُ مَن طَلَب",25,"ب",1,0],["يومئذ يود كل","لُ ناقد لو يسلمُ",26,"م",1,0],["يومي وَلَيلي سواء","كِلاهُما لا يُنير",27,"ر",1,0],["يومَ يَقولُونَ يالَ بَربَرَ وأل","يَكسُوَم لا يَفلِتنَ هارِبُها",28,"ب",3,0],["يَومَئِذٍ عِندَنا صَنيعٌ","يَشهَدُهُ الكَهلُ وَالصَبِيُّ",29,"ي",1,0],["يَوْمُ يُمْنٍ لمِصْرَ ليس له مِثْلٌ","ولا جَالَ للدهُورِ ببال",30,"ل",1,0],["يومي إلى السّقف ، تسترخي أنامله","تمتدّ كالدود ، كالأجراس تنزرع",31,"ع",1,0],["يوم يكاد الصمت يهدر بالغنا","فيه ويرتجل النشيد الأبكمُ",32,"م",1,0],["يوم يرنّحه الهنا وله ... غد","أهنا وأحفل بالجمال وأنغمُ",32,"م",1,0],["يوم يستشعر المواؤون منّا","إنّما الخاسرون أهل الرّياء",33,"ا",2,0],["يَومَ يُنادونَ آلَ بَربَرَ وال","يَكسومُ لا يُفلِتَنَّ هارِبُها",34,"ب",3,0],["يومي من الموت يوم بتّ أكرهه","يتلوه يوم من الأهوال متصل",35,"ل",1,0],["يومٌ يسوء ويوم فيه مفرجة","وبين هذين ما قد يذهب الياس",36,"س",1,0],["يومي الى صحوه وسخطَتُه","تفعل ما ليس يفعل الخَنجَر",37,"ر",1,0],["يَومَ يَحكي أَبناءُ سامٍ بِهِ مِن","صَدَأ السابِغاتِ أَبناءَ حامِ",38,"م",1,0],["يَومَ يَنفُخُ نَفخَةً","لِلبَرِيَّةِ تَجمَعُ",39,"ع",1,0],["يَومَ يُبرِزُ رَبَّنا","لِلحِسابِ وَنَخضَعُ",39,"ع",1,0],["يَومي فَتَفهَمُ أَو يُقَرِّرُ تَشتَفي","وَتَرى لَهُ العَجَب العُجابَ إِذا كَتَب",40,"ب",1,0],["يوَمي بِأَعلى رُتبَةٍ سَتالُها","وَهوَ الَّذي وَاللَهِ حَقَّقَ ظَنّي",41,"ي",1,0],["يومٌ يجازَى المَرءُ فيه وواجِبٌ","أن يُذكَرَ الإنسانُ يومَ جَزائه",42,"ا",3,0],["يوم يشيب الطفل من أهواله","ويصير مثل شيوخه وكهوله",43,"ل",2,0],["يوم يشيب الطفل من أهواله","والناس سكرى لا بكأس دهاق",44,"ق",1,0],["يومٌ يُعَدُّ الجَلْدُ كلّ ملاوِذٍ","منه ويعذُبُ فيه مِلحُ الأدمعِ",45,"ع",1,0],["يومٌ يَمُتُّ إليه طالعُ سعدهِ","بوشائجٍ في سعدِهِ وأواصرِ",46,"ر",1,0],["يومٌ يكُرُّ به إقبالُ جَدّكُمُ","غداً على ملككم ما كرّت الحِقَبُ",47,"ب",1,0],["يَومَ يَقولُ الرَسولُ قَد أذِنَت","فائتِ عَلى غَيرِ رِقبَةٍ فَلِجِ",48,"ج",1,0],["يَومي وَيَومَكِ بِالعَقيقِ إِذِ الهَوى","مِنّا جَميعُ الشَملِ لَم يَتَبَدَّدِ",49,"د",1,0],["يوم يقول لك السرور به اقترح","ما شئت من بيض الأماني يفعل",50,"ل",1,0],["يَومَ يَروي مِنكُم أَطرافَهُ","عَلَقٌ فيهِ اسوِدادٌ وَاِحمِرارُ",51,"ر",1,0],["يومٌ يكُرّ عزيزهُ يبغي الرّدى","ويفرّ يستبقي الحياةَ ذليلُهُ",52,"ل",2,0],["يومٌ يَرى منكُمُ فيه عدوُّكُمُ","ما شاء من قَطْع أرحامٍ وأَمراسِ",53,"س",1,0],["يُومي إليهِ لو أصابَ لهُ يداً","ويفوهُ حمداً لو أصابَ لهُ فَما",54,"م",2,0],["يومٌ يَحقُّ لهُ التَذَكُّرُ بعدَ ما","طالَ المَدَى لا يومُ دارةِ جُلجُلِ",55,"ل",1,0],["يومٌ يمُرُّ كأمسِهِ بغُرورِهِ","وغَدٌ يمُرُّ كيومهِ بمِحالهِ",56,"ل",2,0],["يومي إليك بأطرافٍ مطرَّفَةٍ","لها خضابان للعُنّاب والعنبِ",57,"ب",1,0],["يومٌ يناسبُ غَبْنَ من","قتلوه ظُلماً مثْل غَبْني",58,"ن",2,0],["يومٌ يُساءُ بِه وفي","ه كُلُّ شيعيٍّ وسُنِّي",58,"ن",2,0],["يَومٍ يَعض عَلى الكَفين مِن نَدَمٍ","فيهِ وَيُمسي ذَليلاً بَين إِخوان",59,"ن",1,0],["يَوْمي كَلَيْلِي في الظّلام لِبَيْنِكمْ","وضياءُ قُرْبِي مِنْكَ غيْرُ مُباحِ",60,"ح",1,1],["يوم ييت يلن الذاري","والمنزل مختلف",61,"ف",1,0],["يُومي إلينا طَرفُها","بالعَودِ من بعدِ الرحيل",62,"ل",1,1],["يَوْمي عَلىَ الْمَحْبُوبِ عَامٌ كَامِلٌ","الصيفُ قَلْبِي وَالشتَاءُ ضُلُوعِي",63,"ع",2,0],["يوم يسدُّ شعاع الشمس غيهبهُ","إِذا عجاجُ الوغى ثارَت قساطلهُ",64,"ل",2,0],["يَوم يَقول اللَّه أَين الَّذي","خطته يُمناك أَلا فأتِ بِهِ",65,"ه",1,0],["يوم يفر المرء من أخيه","وأمه أيضا ومن أبيه",66,"ه",1,0],["يومئذٍ يظهر للكفار","وغيرهم عظمة الجبار",66,"ر",1,0],["يومٌ يقال بحقه","لله درك من نهارْ",67,"ر",1,0],["يومي إليها بالركوع مخادعاً","فتخرُّ ساجدةً له وتسلمُ",68,"م",1,0],["يُومي إِليْكَ بِأَطْرافٍ مُطَرَّفَةٍ","بِها خِضابانِ للعِنّابِ والعِنَبِ",69,"ب",1,0],["يومَ يريهِ الخلَّ من أعدائهِ","لوْ لم يسؤه الفقد من أحبابهِ",70,"ب",2,0],["يومى إلي إذا عبر","ت يقال ذا ابن أبي أسامه",71,"م",2,0],["يَوْمَ يَغْشَى ديارَهُمْ قَبْلَكَ","الرُّعْبُ على نَخْوَةٍ بها وَاختيال",72,"ل",1,0],["يوم يستأذن النبيَّ فريق","لمساعٍ وما سعى لاقتناها",73,"ا",3,0],["يومَ يدعو كل امرئ رب نفسي","وينادي الحسابُ آنَ أواني",74,"ن",2,0],["يوم يُدعى هل امتلأتِ وتدعو","ربِّ زدني من طعمةِ الإنسانِ",74,"ن",1,0],["يَومَ يَهتزُّ منكِبُ الأرضِ رُعباً","والسمواتُ وردةٌ كالدهانِ",74,"ن",1,0],["يوم يدعو كل امرئٍ ربِّ نفسي","وتفرُّ الأباءُ والأبناء",75,"ا",2,0],["يوم يَلتفُّ كلُّ ساقٍ بساقٍ","ويُساقُ الضعافُ والاقوياء",75,"ا",2,0],["يوم يُدعى هل امتلأتِ وتدعو","بزفيرٍ إليَّ يا أشقِيَاء",75,"ا",2,0],["يومٌ يردُّ على الفتى أطرابَهُ","ويكف عاديةَ الزمان المعتدي",76,"د",2,0],["يَومَ يَدعو مُهَلهِلٌ يا لَبَكرِ","ها أَهَذي حَفيظَةُ الأَحسابِ",77,"ب",1,0],["يوم يقول الرُّسْل أنتَ لها","وكلُّهم من هوله يَوْجل",78,"ل",1,0],["يومي إليهم سيفه بذبابه","فتراهم يتطايرون ذبابا",79,"ب",2,0],["يومي إلي بكاسها خنث","دارت ملاحته على عطيي",80,"ي",1,0],["يومٌ يمرُّ ولا أرى","فيه حبيبي لا يسمّى",81,"م",2,0],["يَومَينِ أو ثَلثَةً بِالمُعتَدِّ","في المَركَبِ الماشِي الذي يُعَدِّي",82,"ي",1,0],["يَومَئذٍ وتستقلٌّ الصَّرفَه","سَيِّدَةُ المَنازلِ المُعتَرَفَه",83,"ه",1,0],["يومين في أَيلول إحسِب هذا","ففيه أرياحُ الصَّبا تحاذا",83,"ذ",2,0],["يومينِ ضوءُ الشَّمس لم يغشَ الثرى","من فرط ما ازدحمت بهِ الأَقدام",84,"م",1,0],["يوم يشيب له الولي","د ويستهام به الجنين",85,"ن",1,0],["يوم يرى ما قدمت أيدي الورى","فتزل أقدام لهم وتسوخ",86,"خ",1,0],["يَومي بِهَيكَلِ ديرِ حَنَّةَ لَم يَزَل","غَرَّ السَحابِ يَجودُ فيهِ وَيَمرَ