{"poems":[[65,"","https://poetry.dctabudhabi.ae/diwan/poem/29753","الرجز"],[173,"سقها ولو ذهب السرى بسراتها","https://www.aldiwan.net/poem1609.html",""],[438,"خبراني بهول يوم الفراق","https://www.aldiwan.net/poem12469.html","الخفيف"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89521","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60856","الكامل"],[5747,"ضوامي","https://www.poetsgate.com/ViewPoem.aspx?id=61677",""]],"verses":[["سُقْها ولَوْ بالصّارِمِ الهَذّاذِ","مُقلَّصَ الذّيْلِ خَفيفَ الحاذِ",0,"ذ",1,0],["سُقها وَلَو ذَهَبَ السُّرى بِسَراتِها","كَم ذا تَرُدُّ النَفسَ عَن عَزَماتِها",1,"ت",3,1],["سقِّها سقِّ طال ما قد سقاها","فيضُ دمعٍ من هائمٍ مُشتاقِ",2,"ق",1,0],["سُقها مِنَ البَلَدِ المَعمورِ مُتَّخِذاً","دَليلَكَ الجَديَ إِن لَم تَهدِكَ النُصبُ",3,"ب",1,0],["سُقها لَهُمَ نحو الأباطح شزّباً","وأصْبَحَهُمُ قبل الصّباح إذا بدَا",4,"د",2,0],["سقها مغاتيرٍ تحن وتَلَدد","لاخالف المرباع مرحان الاجواد",5,"د",1,0]]}