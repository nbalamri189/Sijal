{"poems":[[55,"لغير العلى مني القلى والتجنب","https://www.aldiwan.net/poem30749.html","الطويل"],[51,"نسيت منيتي وخدعت نفسي","https://www.aldiwan.net/poem62121.html","الوافر"],[147,"مساعيك لا تحصى فتدرك بالعد","https://www.aldiwan.net/poem11749.html","الطويل"],[285,"أفيض دموع أم سيول تموج","https://www.aldiwan.net/poem60699.html","الطويل"],[438,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[449,"بالله يا نسمات الرند والبان","https://www.aldiwan.net/poem55955.html","عموديه"],[463,"رعت بين حاجر والنعف شهرا","https://www.aldiwan.net/poem56188.html","المتقارب"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86975","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1113,"","https://poetry.dctabudhabi.ae/diwan/poem/101183","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106886","المتقارب"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73206","البسيط"],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""]],"verses":[["وَكُلُّ ثَقيلِ الصَدرِ مِن جَلَبِ القَنا","خَفيفِ الشَوى وَالمَوتُ عَجلانُ مُقرِبُ",0,"ب",1,0],["وَكُلُّ ثَمينَةٍ أَصبَحتُ أُغلي","بِها سَتُباعُ مِن بَعدي بِوَكسِ",1,"س",1,0],["وَكُلُّ ثَقيلِ السَمعِ عَن مُستَغيثِهِ","فَداعيهِ مِن قُربٍ كَداعيهِ مِن بُعدِ",2,"د",1,0],["وَكُلُّ ثَناءٍ دُونَ قَدْرِكَ قَدْرُهُ","وَإِنْ زانَ قَوْماً وَشْيُهُ والْمُدَبَّجُ",3,"ج",1,0],["وكلُّ ثوبٍ للرّيا فاتْرُكْهُ يا","ويحَ امرئٍ لِباسُه ثوبُ التُقى",4,"ا",1,0],["وكل ثوب عليها ثوب فاتنة","ولم يشن حسنها تبديل الوان",5,"ن",1,0],["وكلّ ثقيلةِ حملِ الإزار","خفيفةِ ما ضمَّ عُنْقا وخَصْرا",6,"ر",2,0],["وَكُل ثَناء فيهِ كانَت جَوائِزي","خلوُّيَ عَما في يَدي مِن وَظائف",7,"ف",1,0],["وكل ثغر بحسن الذكر مفتتح","وكل وجه بسيما الخير متسما",8,"م",2,0],["وكل ثاقب فكر عيلم علم","رأى طريق أبيه في العلى فقفا",9,"ف",2,0],["وكلُّ ثقيلٍ من اللفظ وافاه","ثم أقام لديه ثقيلا",10,"ل",2,0],["وكلِّ ثغرٍ يُرينا الدرَّ مُنتثراً","عندَ الحديثِ ومنظوماً كمبُتَسِمِ",11,"م",1,0],["وُكُلْثُوْمَاً جَزَاْكَ اللهُ خَيْرَاً","وَسَاْمِحْنَاْ فَقَدْ خُنَّاْ الْعَرِيْنَاْ",12,"ن",2,0]]}