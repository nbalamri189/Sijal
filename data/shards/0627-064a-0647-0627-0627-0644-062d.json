w.aldiwan.net/poem61764.html","الخفيف"],[470,"في رحاب النجف الأشرف","https://www.aldiwan.net/poem61432.html","عموديه"],[484,"أيها الحافظ عهدي","https://www.aldiwan.net/poem36873.html","مجزوء الرمل"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53747","الرمل"],[794,"","https://poetry.dctabudhabi.ae/diwan/poem/101203","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64174","الخفيف"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90565","الخفيف"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80206","الرمل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61085","الرمل"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128267","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109060","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80016","الرمل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48963","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141254","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125458","الخفيف"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115593","الخفيف"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112600","الخفيف"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138661",""],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85196","الرمل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29273","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44892","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86447","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136499",""],[4701,"لارا","https://www.poetsgate.com/ViewPoem.aspx?id=176662",""],[4767,"مولد الانتصار","https://www.poetsgate.com/ViewPoem.aspx?id=179794",""],[4578,"يا غزالاً قد نسجت الغزلا","https://www.poetsgate.com/ViewPoem.aspx?id=49611",""],[5111,"تَمَرُّدْ","https://www.poetsgate.com/ViewPoem.aspx?id=212270",""],[5111,"نِسْيَان","https://www.poetsgate.com/ViewPoem.aspx?id=212295",""],[5155,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=176566",""],[5183,"المصلى","https://www.poetsgate.com/ViewPoem.aspx?id=180159",""],[5277,"سيدي العراق","https://www.poetsgate.com/ViewPoem.aspx?id=201721",""],[5281,"حُسنُ الخِتامِ","https://www.poetsgate.com/ViewPoem.aspx?id=200234",""],[5302,"أيها الحلو","https://www.poetsgate.com/ViewPoem.aspx?id=200602",""],[5377,"إلى الغاضبين علينا","https://www.poetsgate.com/ViewPoem.aspx?id=61899",""],[5409,"يا رواق المجلس الحا","https://www.poetsgate.com/ViewPoem.aspx?id=155291",""],[5542,"نحن أدرى","https://www.poetsgate.com/ViewPoem.aspx?id=10197",""],[5561,"تحدّي الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=192956",""],[5561,"الشاعرُ السجين","https://www.poetsgate.com/ViewPoem.aspx?id=193065",""],[5561,"صراع الذات","https://www.poetsgate.com/ViewPoem.aspx?id=194666",""],[5628,"لحن الانتظار","https://www.poetsgate.com/ViewPoem.aspx?id=178524",""],[5689,"حي بدرا بافق مسرتا، تلالا","https://www.poetsgate.com/ViewPoem.aspx?id=143437",""],[5725,"لم يجرْني","https://www.poetsgate.com/ViewPoem.aspx?id=216019",""],[5956,"صرخة أهل فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192087",""],[6102,"حُداءُ الجَثامِين !!","https://www.poetsgate.com/ViewPoem.aspx?id=183615",""],[406,"حوار في ساحة المطاف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=847&r=&rc=38",""],[6288,"فراديس الرند","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78520&r=&rc=0",""]],"verses":[["أَيُّها الحَيُّ إِن بَكَرتُم رَحيلا","فالبَثوا لِلمودِّعَينَ قَليلا",0,"ل",2,1],["أيّها الحارس تدري من أنا ؟","إشتروا نومي … طويل ليل همي",1,"م",2,0],["أَيُّها الحائِرُ في البَحرِ اِقتَرِب","مِن حِمى البُسفورِ إِن كُنتَ هُماما",2,"م",2,0],["أيها الحاسد المعذب فيه","جئت شيئاً من الشقاوَة إدَّا",3,"د",2,0],["أيُّها الحاكم الذي من يَقُلْ خي","راً يَقُلْ فيهِ مُكثراً ومطيبا",4,"ب",2,0],["أيها الحاكم الذي طاب فرعاً","في نصاب الهدى وأصلاً وعرقا",5,"ق",2,0],["أيُّها الحاسدِي على صُحْبتي العُس","ر وذَمِّي الزمانَ والإخوانا",6,"ن",2,1],["أَيُّها الحامِلُ هَمّاً","إِنَّ هَذا لا يَدومُ",7,"م",1,1],["أَيُّها الحُبُّ أنتَ سِرُّ بَلائِي","وهُمُومي وَرَوْعَتي وعَنَائي",8,"ي",1,1],["أَيُّها الحُبُّ أَنتَ سِرُّ وُجُودي","وحَيَاتي وعِزَّتي وإبَائي",8,"ي",1,0],["أَيُّها الحُبُّ قَدْ جَرَعْتُ بِكَ الحُزْ","نَ كُؤُوساً وما اقْتَنَصْتُ ابْتِغَائي",8,"ي",1,0],["أيها الحب لا يصورك النطق","بل الدمع وحده ترجمانك",9,"ك",1,0],["ايها الحب والجمال المذيعا","ن سلاماً كلاكما ذو تعال",10,"ل",1,0],["ايها الحب انت لي كل شيء","بك احيا وفي سبيلك اعطب",11,"ب",1,0],["ايها الحب انت اول حسي","في حياتي وانت آخر حسي",12,"س",2,0],["ايها الحب انت خيري وشري","ايها الحب انت سعدي ونحسي",12,"س",2,0],["أَيُّها الحُرُ الَّذي شيمَتُهُ","صِحَّةُ الرَأيِ إِذا الرَأيُ اِختَلَط",13,"ط",1,0],["أيها الحي وما ضر","ر الورى لو كنت متا",14,"ت",2,1],["أيُّها الحاسدُ لولا أنني","رجلٌ منْ دونِ حدي أقفُ",15,"ف",1,0],["أَيُّها الحق لا عدمتك حقاً","أَنتَ لي أَنتَ في العراق ظهير",16,"ر",1,0],["أَيُّها الحوت قل إلى أَي وقت","هَكَذا أَنتَ سابح في الفضاء",17,"ا",2,0],["أيها الحالمُ غرَّرتَ بنا","وكفى سُكركَ ما جرَّ علينا",18,"ن",2,0],["أَيُّهَا الحَامِلُ أَثْقالاً بِهَا","كُلُّ صِنْدِيدٍ شَدِيدِ الأَيْدِ نَاءْ",19,"ا",2,0],["أَيُّهَا الحاَفظُ الأَمينُ بحَقٍّ","للمَعَالي منْ طَارقَ وَتَلاَد",20,"د",1,0],["اَيُّهَا الحَافِظُونَ ذِكْرَاهُ مَا أَجْ","دَرَ ذِكْرَى الأَبْطَالِ بِالتَّخْلِيدِ",21,"د",1,0],["أيها الحَضْرُ وفي أبياتكم","أوجه تُفدى بما ضم النصيف",22,"ف",1,0],["أيّها الحاكمون ما ضاعت الحجّة","منكم ولا انطوى البرهان",23,"ن",1,0],["أيُّها الحاكم الذي إن نَقُلْ في","ه نَقُلْ مُكثراً ومطيبا",24,"ب",2,0],["ايها الحب الذي ع","ن غيره الانظار نصرف",25,"ف",1,0],["أيُّهَا الحَائِرُ المُدَلَّهُ يَمِّم","سُلَّمَ الهَدىِ والفَخَارَ اللُّبَابَا",26,"ب",2,0],["أيها الحبُّّ أمانا","لم أعدْ أهوى حبيبا",27,"ب",2,1],["أيها الحسناء أين الموعد","في مساء مظلم أو في صباح",28,"ح",1,0],["أيها الحبّ وبالذكرى أراك","أين أيامك يا روح الوجود",29,"د",1,1],["أَيُّها الحارِسُ الأَمين","هَيكَلَ المَنطِقِ المُبين",30,"ن",1,0],["أَيُّها الحُبُّ قَد وَهَبتك قَلبي","يَوم كانَ الهَوى كانَ الرَبيعُ",31,"ع",1,0],["أَيُّها الحامِلُ قيثارَ الشَباب","قَطِّعِ الأَوتارِ",32,"ر",1,0],["أيها الحب فلا","تنس دعاء بالدوام",33,"م",1,0],["أَيُّها الحامي حِمى الأَر","ضِ بِأَطرافِ الرِماحِ",34,"ح",1,0],["أيّها الحبّ بالمحبّين رفقاً","نحن مثل الشخوص في مرآتك",35,"ك",1,0],["أَيُّها الحادِيانِ حُثّا العِيسا","حامِلاتٍ مِنَ العَذارى شُموسا",36,"س",2,1],["أيها الحامل المتاع تمهل","أي داع يدعو إلى الإسراع",37,"ع",1,0],["أَيُّها الحاسِدُ تَعساً","لَكَ اِذ رمتَ قلاها",38,"ا",3,0],["أيُّها الحكامُ في أوطانِن","ليتَ شعري,مالذي تنتظرون",39,"ن",1,0],["أَيُّها الحاكم بِالظَّن","نِ وما بالظَّنِّ حُكْمُ",40,"م",1,1],["أيها الحافظُ الذي طاولَ النج","مَ الى نيلِه المعالي فطالَهْ",41,"ل",2,0],["أيها الحافظُ الإمام المفدّى","والكريمُ الأخلاقِ والأعراقِ",42,"ق",1,0],["أيها الحافظُ الذي من يدَيْه","للورى باللُّهى تفيضُ بِحارُ",43,"ر",1,0],["أيها الحافظُ الإمام المفدّى","جُدْتَ فالمكرماتُ عنك رَواضِ",44,"ض",1,0],["أيها الحَبرُ ليس عندي حِبرٌ","واشتغالي من البطالةِ أولى",45,"ل",2,0],["أيها الحافظُ لم تُلْ","فِ لك العينُ مِثالا",46,"ل",2,0],["أيها الحافظُ الإمامُ المرجّى","والذي ما لهُ إذاً من نظيرِ",47,"ر",1,0],["أيها الحافظُ الذي حفظ الدي","نَ فما للهَوى لهُ تطْريقُ",48,"ق",1,0],["أيها الحجاج في ال","قدس زُرافات تأود",49,"د",1,0],["أيُّها الحاكمُ العتُّى ترَّفق","أنتَ تلهو بُجثَّةٍ للزمان",50,"ن",1,0],["أيُّها الحاسِرُ الذي أبَداً","بِشِغافِ القلوبِ يَلتَحِفُ",51,"ف",1,0],["أيها الحافظ عهدي","حفظ الله جنابك",52,"ك",1,1],["أيها الحاكم أنتم","حكم فاصلوِ العشيرهْ",53,"ر",2,0],["أيها الحادي عليها","إحبس العيس نهارا",54,"ر",2,0],["أيها الحاسدُ المعدُّ لذمّي","ذمَّ ما شئتَ رُبَّ ذمٍّ كحمدِ",55,"د",1,1],["أيها الحبَرُ أنتَ في العِلم بَحرٌ","أنتَ حُلوٌ والبحرُ لا شكَّ مُرُّ",56,"ر",1,1],["أَيُّها الحامِلُ سَيفاً لِلهُدى","تَعقدُ العَدلَ لَهُ فَوقَ النِجاد",57,"د",1,0],["أَيُّها الحادي بِنا نَحوَ منى","خُذ عَلى نَفسك كَي لا تَفتنا",58,"ن",2,1],["أيُّها الحامِلُونَ لِلقَبْرِ دُرْجاً","مِن عُطُور أوْ باقَةً مِن بَهارِ",59,"ر",1,0],["أيها الحسناءُ إني قائلٌ","قول نصح ايدته الحكماء",60,"ا",2,0],["أيُّها الحاملُ أعباءَ العُ