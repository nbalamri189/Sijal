m/58031","الكامل"],[4583,"","https://poetry.dctabudhabi.ae/diwan/poem/130725","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120290","الكامل"],[4755,"هذا السَّرَابُ القائِمُ القاعِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=183630",""],[4767,"بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=95450",""],[4782,"صبابة","https://www.poetsgate.com/ViewPoem.aspx?id=207000",""],[4836,"حنان أم","https://www.poetsgate.com/ViewPoem.aspx?id=203718",""],[4954,"ليْتَهُ صافى","https://www.poetsgate.com/ViewPoem.aspx?id=208828",""],[4978,"الفقيرة زينب","https://www.poetsgate.com/ViewPoem.aspx?id=189776",""],[585,"هي لفتةٌ أوحت إلي الموعدا","https://www.poetsgate.com/ViewPoem.aspx?id=161932",""],[3591,"هي الحسان أراقت مهجة البطل","https://www.poetsgate.com/ViewPoem.aspx?id=149410",""],[5105,"أهجر رشادَكَ في وَصْلِ ابنةِ العنب","https://www.poetsgate.com/ViewPoem.aspx?id=135328",""],[5277,"جوريّة قيسية","https://www.poetsgate.com/ViewPoem.aspx?id=200587",""],[5376,"الدهرُ أمتعنا بالرود والغيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=188404",""],[5409,"تخشع النفس هيبةً من جلال ال","https://www.poetsgate.com/ViewPoem.aspx?id=155478",""],[5431,"تونس الحب...","https://www.poetsgate.com/ViewPoem.aspx?id=198948",""],[5464,"بهمومنا لا بالخمور سكارى","https://www.poetsgate.com/ViewPoem.aspx?id=697",""],[5672,"سلم له جل جلاله","https://www.poetsgate.com/ViewPoem.aspx?id=206543",""],[5691,"جيل الحروب","https://www.poetsgate.com/ViewPoem.aspx?id=205892",""],[5725,"وقفة على باب ابي الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=177475",""],[5725,"مرت عجالا","https://www.poetsgate.com/ViewPoem.aspx?id=181676",""],[5751,"شَكوى مُسافر","https://www.poetsgate.com/ViewPoem.aspx?id=214716",""],[5829,"اشهى من الورود","https://www.poetsgate.com/ViewPoem.aspx?id=150973",""],[5943,"تشطير ( يا صاحِبِي مالي وللأُنْسِ )","https://www.poetsgate.com/ViewPoem.aspx?id=138278",""],[5956,"لله أشكو ذلّتي","https://www.poetsgate.com/ViewPoem.aspx?id=182498",""],[6052,"بطاقات حمراء من غزة","https://www.poetsgate.com/ViewPoem.aspx?id=47578",""],[6069,"ومهفهفٍ جعل الغرام محله","https://www.poetsgate.com/ViewPoem.aspx?id=105683",""],[5464,"يا منقذي من وحول العار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=490&r=&rc=4",""]],"verses":[["تَخشى عَلَيهِ إِن تَباعَدَ أَن","تَغنى بِهِ مَكانَهُ فَيَضِل",0,"ل",1,0],["تَخَشُّعٌ ما وَراءَهُ نُسُكٌ","يَصدُرُ عَن نِيَّةٍ وَلا قَلبِ",1,"ب",1,0],["تَخشى بِها الجَوناءُ بِالقَيظِ الرَدى","إِذا شِناخاً قورِها تَوَقَدا",2,"د",2,0],["تخشى مؤدّبها والصولجان له","في الكفّ فرقعةٌ كالرعد في السحب",3,"ب",1,0],["تخشى إذا أبصرته مرتجى","فاعجب له في كلّ أحوالك",4,"ك",1,0],["تَخَشخَشُ أَبدانُ الحَديدِ عَلَيهِمُ","كَما خَشخَشَت يَبسَ الحَصادِ جَنوبُ",5,"ب",1,0],["تَخشاهُ آسادُ الرِجا","لِ كَما تَهيمُ بِهِ القيانْ",6,"ن",1,0],["تخشى الردى واجفا في كل نازلة","وانت بالجنة الغناء موعود",7,"د",1,0],["تُخَشّى بِأَلّا يَخلَدَ الدَهرَ حُبُّنا","وَما كُلُّ ما تَخشى النُفوسُ يَضيرُها",8,"ر",3,0],["تُخشى الأَعِنَّةُ حَيثُ يَجمَعُها","وَالسَيلُ يُخشى حَيثُ مُجتَمَعُه",9,"ع",2,0],["تَخَشَّيتُ غِبَّ تَجَنٍّ يَفي","يَقينِيَ جَنِّيَ في خَشيَتي",10,"ت",2,0],["تَخْشَى الضِّيَاءَ وَفِي أَزْرَارِهَا قَمَرٌ","يَسْتَوْقِفُ الْعَيْنَ حَيْرَى فِي مَجَارِيهَا",11,"ي",3,0],["تخشى أساطيلُ الغزاة عبوره","ويروع وحشَ البحرَ صمتُ قرارِهِ",12,"ر",2,0],["تَخْشى اللُّيُوثُ لِقَاءَهُ","وَتَوَدُّ رُؤيَتهُ الْجَآذِرْ",13,"ر",1,0],["تخشى مهابته قبل المثار فان","غشى المثار أطار البطل وانقصما",14,"م",2,0],["تخشى البوادر من جلالة قهره","نوب الصروف فما يشب ضرامها",15,"م",3,0],["تَخشى المَوالي سَطاهُ خاضِعين لَهُ","كَأَنَّهُم في مَعالي عِزِهِ حشم",16,"م",1,0],["تَخشى الأُسود مَهابة","مِن أَن تَمرّ عَلى كناسك",17,"ك",1,0],["تُخشى وَتُرجى سَيفُ بَأسِكَ قاطِعٌ","بَينَ الوَرى وَسَحابُ جودِكَ هامِ",18,"م",1,0],["تخشى من الأوتار وهي مروعة","منها فكم غنت على العيدان",19,"ن",1,0],["تَخشى عَرانينُها خَرماً إِذا نَفَرَت","فَالذُّلُّ يَسحَبُها في الرَيثِ وَالعَجَلِ",20,"ل",1,0],["تَخشى الشَواهينُ سُطا حَمامِهِ","فَهوَ الأَكَرُّ وَالشَواهينُ الأَرَك",21,"ك",1,0],["تخشى بوادرهم ويرجى حلمهم","والعز شيمة مرتجى ومهيب",22,"ب",1,0],["تخشع النفس في حماه وتحلو","سبحات الأرواح والأفكار",23,"ر",1,0],["تَخْشَى سُلوِّي كلّما بَعُدَتْ","فتُقيمُ لي طَيْفاً يُشوِّقُني",24,"ن",2,0],["تخشى على الممدوح تُظهِرُ ذاتَه","حقّاً وخير المدح ما فيه مثل",25,"ل",1,0],["تَخشى العِدى أَبَداً صَدرَ الجَوادِ فَقَد","ظَنَّ العِدى أَنَّه صَدرٌ بِلا كَفَلِ",26,"ل",1,0],["تخشى الفناء وكل يوم ينقضي","يأتي بألف بلية وصغار",27,"ر",1,0],["تخشى الفناء ولك يوم ينقضي","يأتي بألف مضيبة ودمار",27,"ر",1,0],["تُخشى سُطاهُ على طلاقة وجههِ","ولرُبَّ بَرقٍ بالصَّواعق مُنذرِ",28,"ر",1,0],["تخشى بوادرهُ العِدى منْ صاعقٍ","ويشيمُ بارقَهُ المُسيفُ المرْمِلُ",29,"ل",1,0],["تخشى المَنونُ إذا سُلَّتْ سيوفُهم","وتُخجل السُّحب أيديهم إذا هتنوا",30,"ن",3,0],["تَخْشى صَوارِمَهُ بلَيْلَتِه","وصَباحِهِ الأعْداءُ والإِبِلُ",31,"ل",1,0],["تخْشى الصَّوارمُ بأسَهُ","ويَهابُ حُجَّتَهُ الخَصيمُ",32,"م",1,1],["تُخْشى وتُرجى نَجْدةً ونَدىً","أبَداً فأنْتَ السَّيْفُ والسُّحُبُ",33,"ب",1,0],["تُخشى شباةُ لحاظهِ في جفنهِ","وكذا السيوفُ تخاف في الأجفان",34,"ن",1,0],["تَخشَى اشتِعالَ العُودِ منها إذ تَرَى","لَيلاً أسِنَّتها كوَرْي زِنادِ",35,"د",1,0],["تَخْشَعُ أَصْوَاتُهُمْ خِيفَةً","فَلاَ تُنَاجِي بِسَوَى الْهَمْسِ",36,"س",1,0],["تَخشَى رَبِيعَةُ أن أُلِمَّ بِدَارِهَا","وَكَأنَّنِى بِطِلابِهَأ مَأمُورُ",37,"ر",1,0],["تخشى الخلائق ثم لا","تخشى الإله وترقب",38,"ب",1,0],["تخشى المشاكل بأسه إن صدّها","في عزمه أو رأيه المستحكمِ",39,"م",1,0],["تخشى صروف الدهر بأسك عندما","تُبدي لها الهمات والعزم الأشدْ",40,"د",1,0],["تَخْشَى الغَزَالةُ طَيْرَهُ فَتغيبُ في","سَجْفٍ عليهِ مِنَ القَتامِ كَثيفِ",41,"ف",1,0],["تَخشى العَصا وَالزَجِرانِ قالَ حَلِ","يُرسِلُها التَغميضُ إِن لَم تُرسَلِ",42,"ل",1,0],["تخشى وترجى عطاياه وسطوته","كالغيث في صبب والليث في غضب",43,"ب",1,0],["تَخشَى على خَصرِهِ إِن مالَ مِن طربٍ","مِن ثقلِ أردافِهِ أو مالَ مِن تِيهِ",44,"ي",2,0],["تخشى حواجبَها الرماةُ كأن قو","س الحاجب بن زرارةٍ إحداها",45,"ا",3,0],["تَخشى الزمام فتثني جِيدَها فَرَقاً","كأنَهُ من تثنّي حَيَّةٍ ذكر",46,"ر",1,0],["تخشى عيونُ الليالي أن تُلِمَّ بهم","وحياً وتفزع أن تلقاهم الكرَب",47,"ب",1,0],["تخشى الفضيحة من جوا","بي إذ يؤمُّ جنابها",48,"ب",3,0],["تخشى النهار من العيون إذا بدت","إذ كان يسترها الدجى إن اظلما",49,"م",2,0],["تخشى الضّراغمُ بأسَهُ في غابِها","وتصَاغَرُ الأبطالُ وهي كبارُ",50,"ر",1,0],["تخشى السلاطينُ من بُعْدٍ بَوَادِرَهُ","لِمَا له من جلالٍ غَيْرِ مجحود",51,"د",1,0],["تخشى الملوكُ مَقَامَهُ ولذكره","رُعْباً تطير فَرَائِصُ الأبطال",52,"ل",1,0],["تخشاه أيقاظا عداه فإن ينم","وتراه في حلم المضاجع تفرق",53,"ق",1,0],["تخشى الطيور هياج قو","مك إن أحست بالضجيج",54,"ج",1,0],["تخشَ اختلافاً ففيكَ الأمرُ مُنحصرُ","متى نفوزُ بمرءاك الجميل متى",55,"ت",2,0],["تخشاهُ كلّ قبيلةٍ وعشيرةٍ","ويهابهُ عربيُّها والاعجمُ",56,"م",1,0],["تخشى الأسود لدى الهيجاء صارمه","وفي مكارمه من ذا يحاكيه",57,"ي",2,0],["تخشى بوادرَهُ إذا ادّكرتْ له","ما تمّ من دُكْر على بدران",58,"ن",1,0],["تخشى اللصوصُ المرور في طرقٍ","فالدور تبقى بدون إقفال",59,"ل",1,0],["تخشى بأيديهم تصادف كرها","للرجل منهم والثري ولهان",60,"ن",1,0],["تخشى اعاصير العلوم معاشر","ليسوا ببحر العلم غير فواقع",61,"ع",1,0],["تخشى سلوى كلما بعدت","فتعيد لي طيفا يشرقني",62,"ن",2,0],["تخشى الفتاة حبائلاً منصوبة","غشيتموها فى الكلام برونق",63,"ق",1,0],["تَخشى العَواقب قَبله فَأمنتها","إِذ كانَ رَحمة كُل مَرحوم كفي",64,"ف",2,0],["تُخشى بوادرُ بأسه حتى يُرى","بالخوف منه كلُّ شيءٍ باسا",65,"س",2,0],["تخشى الجوارح من غرار كلامه","كلماً تعذر جرحه أن يدملا",66,"ل",2,0],["تخشى عذولا أطال اللوم في قمرى","فإنه عند أهل العشق إغواء",67,"ا",2,0],["تخشى صُروفُ اللَيالي بَأسَ سَطوَتِهِ","فَكَيفَ يَبلُغ يَوماً قَصدَه الضِدُّ",68,"د",1,0],["تَخَشُّشُ بالي عِشرِقٍ زَجَلَت بِهِ","يَمانِيَةٌ هَبَّت مِنَ اللَيلِ سَجسَجُ",69,"ج",1,0],["تخشى العقول فليس كل مقرّظ","يهدى القوافيَ بالقوافي دار",70,"ر",1,0],["تَخشى الكَتائب مِن قَضاء كِتابه","في الحالتين معجّلاً وَمُؤَجَّلا",71,"ل",2,0],["تَخشى الغَزالة إِن تَدنو لتلثم ما","ضَم الشِراك وَلم يَنصب لَها شُرك",72,"ك",1,0],["تَخشى الأُسود الغلب سَطوة بَأسَهُ","أَبَداً كَما تَخشى الأُسود الشاءُ",73,"ا",2,0],["تخشى وتأمن نفسها","فهي المخيفة والوديعة",74,"ع",2,0],["تخشى فلسطين الأذاة لأجلها","عاد الصليب وعادت الألام",75,"م",1,0],["تخشى الصواعقَ إن سمعتَ باطِنَهَا","مُصوِّتاً مثلَ رعدٍ في الميادينِ",76,"ن",1,0],["تخشى عليهم من البرد النشاف","لا به مربا ولا ثربه عليف",77,"ف",1,0],["تَخشَعُ شَمسُ النَهارِ طالِعةً","حينَ تَراه وَيَخشَعُ القَمَرُ",78,"ر",1,1],["تَخشى الرمُاة قسياً من حواجبهم","تَرمي القلوبَ ولكن نبلَها المُقل",79,"ل",1,0],["تخشاه كلُّ الأسْدِ في غاباتِها","وعليه من زهدِ الكرامِ دِثَارُ",80,"ر",1,0],["تخشى ملوكُ الأرضِ سطوةَ بأسهِ","لو شاهدُوهُ لقبلُوا الأقداما",81,"م",2,0],["تخشى الاسود مقامه لكنما","يدنو اليه ذو الضراعة مزلفا",82,"ف",2,0],["تَخَشَّبَت كَفَّايَ طَرقًا.. ومَا","أَجَابَ إِنسِيٌّ ولا مارِدُ",83,"د",1,0],["تخشى بحارُ الجود إن ذكروا","فضلاً وتخشى غايةُ الكرم",84,"م",1,0],["تخشى عليّ من الشتاء وبردهِ","وأنا خشيتُ عليك من أهوائي",85,"ا",3,0],["تخشى عليه من الحياة وليتها","تفديه من ألم ومن أحزان",86,"ن",1,0],["تخْشَى مِنَ الْمَنْأى وقدْ كانَتْ نَأَتْ","فكَأَنّ قلْبي قدْ تَهاوى مِنْ عَلِ",87,"ل",1,0],["تخشى الغرور بما الرحمن زيّنها","من فضله فهي تستعلي على الزلل",88,"ل",1,0],["تخشى الإصابة بالعيون وإنها","تُخفي الصواب تخاف فيه الحسدا",89,"د",2,0],["تخشى الحسان انتقاد الحران وصلت","حرَّ افتعرض عنه من حرى الوجلِ",90,"ل",1,0],["تُخْشَى بوادِرُهُ والحلمُ حاجِزُهَا","إن السيوفَ لَتُخْشَى وهي في القِرَبِ",91,"ب",1,0],["تخشى إذا خانَ الضميرُ طريقَها","أن تستجيبَ لهاجسِ المرتابِ",92,"ب",1,0],["تخشى عليَّ مبيتا بعد مكرهة","وما لججت بأقوالٍ وتشديدِ",93,"د",1,0],["تخشع النفس هيبةً من جلال ال","موت إن حل في عظام الرجال",94,"ل",1,1],["تخشع النفس بينهم وتصلي","تحمد الله أنها عربية",95,"ي",2,0],["تخشى من الموت الجميل شهادة","ونكاد نحسب شوك ذلّ غارا",96,"ر",2,0],["ﻻ تخش غير الله لو","جمعت عليك هنا القبائلْ",97,"ل",1,0],["تخْشى منَ القادِمِ المخْبوءِ في غَدِها","إنْ كانَ في الغَدِ إبْقاءٌ على أحَدِ !",98,"د",1,0],["تخشاه اكباش الطراد ودونهم","حلقُ الجواشن سابغات تمنعُ",99,"ع",1,0],["تخشى العذول عيونه عسس","متلصّصا ينتابه بؤسُ",100,"س",1,0],["تَخشى المَطاراتُ لو مَرَّتْ حقائبُنا","وَنحنُ قانونُها تَبّاً لِمَنْ جَحَدا",101,"د",2,0],["تخشى على غدها الايام إن بلغت","مما اعتراها هوىً تقضي من الكمد",102,"د",1,0],["تخشى عيونًا قد تصادفُها))","خَجَلاً ، فَما عَبْسٌ بَنُو عَبْسِ",103,"س",1,0],["تخشى على العفش الجميل ولا أرى","من خَشية منها عليَّ ورحمةِ",104,"ه",1,0],["تخشى عقابا من الديان يلحقها","وإنها انبت في الناس إخوانا",105,"ا",1,0],["تخشى القلوب عليه فاتر طرفه","فكأنهن نفرن من ألحاظه",106,"ظ",2,0],["تخشى سفائننا الحيرى ربابنةً","زاغوا بها بين ديجور ومنقلب",107,"ب",1,0],["تخشّبوا ك«كراسيهم».. متى نبضت","شهامةٌ في عروق الصخر والخشب؟",107,"ب",1,0]]}