{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54635","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54894","الكامل"],[92,"يافا الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179202",""],[125,"بالواسعات أرى الأشواق تنهمر","https://www.aldiwan.net/poem23811.html","البسيط"],[136,"يا حاكم اعلم بأني أنت مستندى","https://www.aldiwan.net/poem54851.html","البسيط"],[161,"خير الكلام","https://www.aldiwan.net/poem23647.html","البسيط"],[199,"لمن المنازل أقفرت بغباء","https://www.aldiwan.net/poem54412.html","الكامل"],[266,"قد أحرز السبق مولانا الحريزي","https://www.aldiwan.net/poem38108.html","البسيط"],[369,"نزل الأحبة خطة الأعداء","https://www.aldiwan.net/poem61017.html","الكامل"],[396,"أشكو إلى الله مولانا عظيم الشان","https://www.aldiwan.net/poem54472.html","عموديه"],[409,"الحمد لله عظيم الشأن","https://www.aldiwan.net/poem33345.html","الرجز"],[438,"هذا اللوى لا حط منه لواء","https://www.aldiwan.net/poem12549.html","الكامل"],[451,"لهوى الحجاز بأفق قلبي مبدأ","https://www.aldiwan.net/poem23812.html","الكامل"],[463,"يقولون يوم البين عينك تدمع","https://www.aldiwan.net/poem56134.html","الطويل"],[563,"لا معه نحن ولا معنا","https://www.aldiwan.net/poem33753.html","السريع"],[567,"قد قام رب الدار في أوطانه","https://www.aldiwan.net/poem52767.html","الكامل"],[567,"عوجا على غرب لبنان الذي اشتهرا","https://www.aldiwan.net/poem52843.html","البسيط"],[568,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86988","الطويل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90552","السريع"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62656","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62658","الرجز"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133806","المتقارب"],[1144,"","https://poetry.dctabudhabi.ae/diwan/poem/199144","الرجز"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145111","المنسرح"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46524","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137861",""],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49991","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95511","البسيط"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101898","الرجز"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131524",""],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124734","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118407","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2296,"","https://poetry.dctabudhabi.ae/diwan/poem/138927","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140092",""],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35907","المنسرح"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85189","الرجز"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103039","الكامل"],[4044,"","https://poetry.dctabudhabi.ae/diwan/poem/105883","الرجز"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90842","الكامل"],[4767,"دوحة الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179942",""],[5206,"الرد على منكر علم الحِكمة","https://www.poetsgate.com/ViewPoem.aspx?id=187403",""],[5206,"لَمَّا طَمَى قامُوسُ سِحرِكَ فَايِرًا","https://www.poetsgate.com/ViewPoem.aspx?id=187423",""],[5206,"حياة الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=187335",""],[5764,"الاصدقاء الثلاثه","https://www.poetsgate.com/ViewPoem.aspx?id=175121",""],[5848,"ارتباكات القلق","https://www.poetsgate.com/ViewPoem.aspx?id=48862",""],[6093,"حَافِظ","https://www.poetsgate.com/ViewPoem.aspx?id=188245",""],[199,"لمن المنازل أقفرت بغباء","https://www.poetsgate.com/ViewPoem.aspx?id=20779",""],[463,"يقولونَ يومَ البينُ عينكَ تدمعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60123&r=&rc=179",""]],"verses":[["وَالأَصْفِياءُ الكُثْرُ مَا وَحْشَتُهُمْ","إِنْ فَقَدوا أُنْسَ الصَّفِيِّ المُجْتَبَى",0,"ب",2,0],["وَالأَصْدِقَاءُ حِيَالَهُ","لا يَمْلِكُونَ سِوَى الزَّفِيرْ",1,"ر",1,0],["وإلاّ صحوةٌ حتّى تمطَّتْ","قوادِمُها ، كما انتفَضَ الغُراب",2,"ب",1,0],["والأصل والفرع منه كلما وُجدا","ومنه ما وَجدا والعين والأثر",3,"ر",1,0],["وَالأصلُ أنَّ الدَّعَاوي دُونَ بَيِّنَةٍ","لَم تُجدِ شَرعاً وفي القَانُونِ لَم تُفُدِ",4,"د",1,0],["والأصْلُ أَصْدَقُ مِنْ صُنْعٍ تُحَسِّنُهُ","فِي كُلِّ طَبْعٍ طَغَى ، نُضْجًا بِفَحْوَاهُ",5,"ا",2,0],["وَالأَصلُ يَنبُتُ فرعه مُتَناثِلاً","وَالكَفُّ لَيسَ بَنانُها بِسواءِ",6,"ا",2,0],["والأصمعي إذا ما قيس منه به","فهو الأصم وفي تركيبه عي",7,"ي",1,0],["والأصل للخضراء فهْوَ بِكَفّها","وبهِ تُقابِلُ نُسخةَ الغَبراء",8,"ا",2,0],["والأصل والراس بل والساس والبنيان","في كل منكر على ماقال ذو العرفانط",9,"ط",1,0],["والأصل إخلاص الفتى للنية","بقصده لوجه رب العزة",10,"ه",1,0],["والأصدقاء إذا همُ لم يُنصَفوا","فاعلَمْ بأنهم هم الأعداء",11,"ا",2,0],["والأصل في الحب ابتداءً نظرةٌ","فَنَمت وعادت عِلّةً لا تبرأ",12,"ا",1,0],["وإلا صديقاً كابن أيّوبَ حافظاً","بحيث السواد في الفؤاد مضيّعُ",13,"ع",1,0],["والأصل لا علمٌ به عندنا","كلا ولا جهلٌ به منا",14,"ن",2,0],["والأصلُ يجري في الفُروعِ زكاؤُهُ","فيُولِّدُ الأثمارَ في أغصانهِ",15,"ن",2,0],["والأصلُ أدنَى منَ الأغصانِ مَنزلةً","وَهْوَ الذي يُرفِدُ الأغصانَ والثَمَرا",16,"ر",2,0],["وَالأَصلُ وَالعُرفُ أَن تَعارَضا لَكُمُ","فَما المُقَدَّمُ مِنهُما لَدا الكُبَرا",17,"ر",2,0],["وَالأَصلُ وَالظاهِرُ الجَلِيُّ يا فَطِنٌ","ما الفَرقُ بَينَهُما فَاِقضوا لَنا وَطَرا",17,"ر",2,0],["وَإِلّا صَفعناه عَلى الوَجه وَالقَفا","وَملنا عَلى أَضلاعه بِالمَطارق",18,"ق",1,0],["والأصلُ إن كان رديئاً فإن","تُعزَّهُ كساكَ ثوبَ الصِّغار",19,"ر",1,0],["والأصل في الناس الوَلا","والضد حادث الطباع",20,"ب",3,0],["والأصل فيهما مراعا","ةُ الصلاح وجبا",21,"ب",2,0],["وإلا صباحا بكياً ذرياً","ينمّ به ضوءه الأشهب",22,"ب",1,0],["والأصل في الأخباز أن تقمّرا","وجوزوا التقديد إذ لا ضررا",23,"ر",2,0],["والأصل ختار","وفرعه أختر",24,"ر",1,0],["وَالأَصدِقاء كَرِهوا أَن يَنسِبوا","فيهِ إِلى اللوم وَأن يُؤنبوا",25,"ب",3,0],["والأصل في البناء للحروف","والأصل بالتسكين في الوقوف",26,"ف",1,0],["والأصل في الإعراب أن يكونا","حركة في الختم أو سكونا",26,"ن",2,0],["والأصل في الرفع بضم قد عرف","والأصل في النصب بفتح قد ألف",26,"ف",1,0],["والأصل في الجر بكسر ظاهر","والأصل في الجزم سكون الآخر",26,"ر",1,0],["والأصل في المبتدإ التعريف","والأصل في تقديمه معروف",26,"ف",1,0],["والأصل في خبره التنكير","والأصل في رتبته التأخير",26,"ر",1,0],["والأصل في تقديم ما تقول","الفعل والفاعل والمفعول",26,"ل",1,0],["والأصل بالمد أبدلن والثاني","شبيهها ماذا معرّى الشان",27,"ن",1,0],["والاصل نحن أحق بالدعوى به","لو كان يروي غلة العطشان",28,"ن",1,0],["والاصل لما كان لا اصل له","من اصله اضحى عديم مبان",28,"ن",1,0],["والاصل اما في صناديق الحجى","او حسب زعم البعض بالهيمان",28,"ن",1,0],["والاصل انت فضع جبينك بالثرى","والفرع فوقك نحن كالاغصان",28,"ن",1,0],["والأصْفياء من الأحبّة جيرةٌ","يَغْنَون في المصْطَافِ والمُتَربَّعِ",29,"ع",1,0],["والأصل كالماء في غرسٍ يُنضرِّه","تراه مُقترنَ الأَبناء مُصطحبَا",30,"ب",2,0],["والأصل بانفعاله ما انفعلا","أصلا ولا عن عهده تحولا",31,"ل",2,0],["والأصل للفحل عليه حملا","بكل قسميه علا أو سفلا",31,"ل",2,0],["والأصل يفرع وفي فرعه جناه","فهو جنى الجنتين في الارض دان",32,"ن",1,0],["وإلا صوم شهرين تماماً","إذا هو لم يجد متتابعين",33,"ن",1,0],["والاصغرون غدوا لدين جميعهم","من اجله وغدا الاسن سنينا",34,"ن",2,0],["وَالأصلُ مَاذَا فِيهِ خُلفٌ ثَابِتٌ","عِندَ النُّحَاةِ وَذَاكَ ذُو ألوَانِ",35,"ن",1,0],["والاصل في الخطاب للمعين","والترك فيه للعموم البين",36,"ن",1,0],["والأصل منه صخرة مصلادة","عظماً علاها الرمل بالريحية",37,"ه",1,0],["وَالأَصلُ فِى الأخبَارِ أن تُؤَخَّرَا","وَجَوَّزُوا التَّقدِيمَ إذ لاَ ضَرَرَا",38,"ر",2,0],["وَالأصلُ فِى الفَاعِلِ أن يَتَّصِلاَ","وَالأصلُ فِى المفعولِ أن يَنفَصِلاَ",38,"ل",2,0],["والأصلُ سَبقُ فَاعِلٍ مَعنىً كَمَن","مِن ألبِسن مَن زَار كم نَسجَ اليمَن",38,"ن",1,0],["وَالأَصرَحُ الأَصبَحُ الَّذي اِمتَحَنَ ال","لَهُ أَباهُ فيهِ وَصانَ دَمَه",39,"م",2,0],["وَالأَصلُ أَنَّ اللَه لَيسَ كَمِثلِهِ","شَيءٌ تَعالى الرَبُّ ذو الإِحسانِ",40,"ن",1,0],["والأصل منه من بني عدنان","وفرعه يعزى إلى السودان",41,"ن",1,0],["والاصل في طريقه الترديد","والدوران عندهم سديد",42,"د",1,0],["والأصل عبل والنجّار مطهّم","والفرع سبط خالص من جدّه",43,"د",2,0],["والاصبهان وبه تسبحُ","حور الجنان واليه تجنحُ",44,"ح",1,0],["والأصل فخر للفروع إذا بدت","ببني البنين سريرة الأجداد",45,"د",1,0],["والأصل قد كان في الجنات مَغرِسُه","أشجاره طاب في أغصانِها الثمر",46,"ر",1,0],["والأَصلُ فِيهَا أنَّهَا عَن آدَمٍ","عَمَّن لَهُ التَّفْرِيْدُ والتَّقدِيسُ",47,"س",1,0],["وَالأَصْلُ فِيهِ أنَّهُ لمُصَعْصَعٌ","مِن غَيرِ وُكْسٍ كُن لَهُ مُتَدَبِّرَا",48,"ر",2,0],["وَالأَصْلُ تَجْرِيْدُ الهَوَى عَنْ نَفسِهِ","وَبِنَفسِهِ تَجْرِيدُهَا يَا نَاعِسُ",49,"س",1,0],["والاصدقا رغم كثرتهم ، بْ عَثرتهم؟","واسيتهم بس منهو من يواسيني ؟",50,"ن",2,0],["والا صديق يشتكي اربع خناجر فاالظهر","جت من عزيز كان ياماكان فالماضي صديق",51,"ق",1,0],["والأصْلُ جُهْدُكَ في بِنَاءِ فَضِيْلَةٍ","وَ جُهُوْدُ غِيْرِكَ كَانَ جُهْدَاً فَائِظَا",52,"ظ",2,0],["والأصل ينبت فرعه متأثلا","والكف ليس بنانها بسواء",53,"ا",2,0],["وإلاَّ صديقاً كانَ أيُّوبّ حافظاً","بحيثُ السَّوادُ في الفؤادِ مضيَّعُ",54,"ع",1,0]]}