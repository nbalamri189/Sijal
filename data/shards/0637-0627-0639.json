في جناته","https://www.poetsgate.com/ViewPoem.aspx?id=171233",""],[463,"حيها أوجهاً على السفحِ غرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60067&r=&rc=123",""]],"verses":[["طاعَ لَها حَمضُ اللَوى وَنَشَّرَت","لَها رُبى قَباقِبٍ أَقطاعَها",0,"ع",3,0],["طاعِنُ الفُرسانِ في الأَحداقِ شَزراً","وَعَجاجُ الحَربِ لِلشَمسِ نِقابُ",1,"ب",1,0],["طاعِنُ الطَعنَةِ الَّتي تَطعَنُ الفَي","لَقَ بِالذُعرِ وَالدَمِ المُهَراقِ",2,"ق",1,0],["طاعاتُهُ فَرضٌ فَإِن عَصَيتَهُ","كُنتَ بِعِصيانِكَ لِلنارِ حَطَب",3,"ب",1,0],["طاعَتُهُ فَرضٌ وَعِصيانُهُ","مِن أَعظَمِ الكُفرِ وَأَعلى الشِقاق",4,"ق",1,0],["طاعَةُ اللَهِ خَيرُ زادٍ إِلَيهِ","حِكمَةُ اللَهِ لِلقُلوبِ رَبيعُ",5,"ع",1,0],["طاعَنَ الخَيلَ قَبلَ ذابِلَةِ اللُد","نِ بِلُدنٍ مِن عَزمِهِ ذي شِطاطِ",6,"ط",1,0],["طاعِناً مَنحَرَ الشَمالِ مُتيحاً","لِبِلادِ العَدُوِّ مَوتاً جَنوبا",7,"ب",2,0],["طاعِنٌ في العِنانِ يَستَنكِرُ السَو","طَ مُدِلّاً وَيَأخُذُ الأَرضَ أَخذا",8,"ذ",2,0],["طاعِمٌ أَنتَ وارِدٌ عَذبَ ماءٍ","مُعرِسٌ بِالفَتاةِ حاذٍ كاسي",9,"ي",1,1],["طاعُوا لهُ من بعدِ عِصيانِهم","وطاعةُ الأعداءِ عن رَغْمِ",10,"م",1,0],["طاعَت لِعَيني الدُموعُ فيهِ","وَاِختَلَطَت بِالدَمِ اِختِلاطا",11,"ط",2,0],["طاعة الأملاك فيه امتزجت","في السموات بعز المالكين",12,"ن",1,0],["طاعته فرض، فإن عصيته","كنت بعصيانك للنار حطب",13,"ب",1,0],["طاعناتٌ فروعُها في الدَّرارِى","ضارباتٌ عروقُها في التُّربِ",14,"ب",1,0],["طاعَ الزَمانُ لِصالِحٍ فَاِبتَزَّها","بِيَدِ الخُطوبِ وَإِنَّها لَكَ أَطوَعُ",15,"ع",1,0],["طاعَتُهُم كَفّارَةٌ","لِكُلِّ ذَنبٍ موبِقِ",16,"ق",1,0],["طاعِنُ الفارِسِ المُدَجَّجِ بِالرَأ","يِ وَمُردي الكَمِيِّ بِالتَدبيرِ",17,"ر",1,0],["طاعِناتٍ طَعنَ مَن كانَ إِلى","مَردَنيشٍ يَعتَزي أَو تاشفين",18,"ن",1,0],["طاعَتهُ جلّ لأهلِ النّهى","مِن هذهِ الحياةِ أَسنى اِغتِنام",19,"م",1,0],["طاعَنوا بَعدَ رِماءٍ","وَضِرابٍ بِالذُكورِ",20,"ر",1,0],["طاعماً ذائقاً لكل لذيذ","وكريه أتاك من أقواتك",21,"ك",1,0],["طاعنات بقدودٍ من قناً","راميات من لحاظٍ بسهام",22,"م",1,0],["طاعته فرض علينا واجبٌ","ويل لمن عن أمره السامي عتا",23,"ا",1,0],["طاعَتْ لَكَ الأَحرارُ باستعبادِها","وأَباحَتِ الأَملاكُ صَعْبَ قِيادِها",24,"د",3,1],["طاعنا في السنين تطوي عليهن","نَ طوالَ السنين عصراً فعصرا",25,"ر",2,0],["طاعةُ الدمع وعصيانُ المنامِ","ألبساني خاضعاً ثوب السَّقامِ",26,"م",1,1],["طاعنوا بالقدود في حومة الت","توديع لمَّا تلثَّموا بالحياءِ",27,"ا",2,0],["طاعت ليمناك واسطاعت رياضتها","فشأنها الدهر ترقيع وتمزيق",28,"ق",1,0],["طاعات أقوام معاصي غيرهم","فاجعل فؤادك للغزالة مهبطا",29,"ط",2,0],["طاعناً في اعتقادهم أوهاماً","وخيالاً جميع ذي الأكوان",30,"ن",1,0],["طاعة الله والرسول وأهل ال","أمر منكم إشارة لا تبيد",31,"د",1,0],["طاعَت لَهُ أَيدي الملوك وَأَذعَنَت","مِن نيل مصر أَصابع المقياسِ",32,"س",1,0],["طاعةٌ أَعجَلَتهُ عن أن تراه","سالكَ العزم مَسلَك التسويف",33,"ف",1,0],["طاعةُ الله فهْي خيرُ لباسٍ","فالبْسَنْها ولو على أسمالِ",34,"ل",1,0],["طاعة للنهى على وفق علم","حقق الفهم فيه فرعا واصلا",35,"ل",2,0],["طاعن النجلاء باللدن كما","قَهقَهَتْ بالماء أفواه المزاد",36,"د",1,0],["طاعاته مردودةٌ في وجهه","لما أطاع وما رأى عين العطا",37,"ط",2,0],["طاعونها لا يكتفي بِأَقَلَّ مِنْ","أَخْذِ النّفوس ولا يقول كفاني",38,"ن",2,0],["طاعِنُ الحالِ هل تّرىَ لِكلامِى","شاهِداً لحالٍ مُوجَزاً أم وسيطاً",39,"ط",2,0],["طاعنتها نائِباتٌ جَمَّةٌ","فَاِنثَنَت صَرعى ضِراب وَطِعان",40,"ن",1,0],["طاعت لهُ حصصً الأزمان أجمعها","فلا عجيبٌ إذا طاعته أزمانُ",41,"ن",1,0],["طاعنته حتى إذا","ما كان رمحانا شظيا",42,"ي",2,0],["طاعناً في البلادِ يُهدى لك النص","رُ ويُطْوَى لكَ البعيدُ السحيقُ",43,"ق",1,0],["طاعتي فرض لحكمهم","إن نهوا في الحب أو أمروا",44,"ر",3,0],["طاعوا له ثم عدوا عليه","وقطعوا حاجز منخريه",45,"ه",1,0],["طاعته منّي حشاً لولا الهوى لعصت","كما أطاعت قديماً للكليم عصا",46,"ص",2,0],["طاعَتُهُ مِن طاعَةِ اللَهِ فَمَن","دَعا إلى هذي إلى تلك دَعَا",47,"ا",1,0],["طاعني فيك أنا قلبي وصدّ ونساك","الغلا حطّه الله بين ناسٍ وناس",48,"س",1,0],["طاعتهُ حتى لوان الروح عادلها","وجاءَ يطلبه قالت لهُ ها كا",49,"ك",2,0],["طاعةٍ للي بعث طه رسول","مكنوا بالضد روس الباترات",50,"ت",1,0],["طاعوا المليك الذي قد كان يأمرُهمْ","بالرفقِ بالأهل والأصحاب والبُهُمِ",51,"م",1,0],["طاعة يلقح الليالي وتقوى","فاحتواهن من نتاج صلاته",52,"ت",2,0],["طاعنا في السنين تطوى عليه","نَّ طوالَ السنين عصرا فعصرا",53,"ر",2,0]]}