aspx?id=170588",""],[5751,"مَعارجُ الصعيد","https://www.poetsgate.com/ViewPoem.aspx?id=214714",""],[5888,"عرش مملكتي","https://www.poetsgate.com/ViewPoem.aspx?id=214504",""],[5956,"بالشعر أصنع وحدة قلبية ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182949",""],[5956,"سأصاحب الأطيار والأشجار","https://www.poetsgate.com/ViewPoem.aspx?id=183315",""],[5956,"أوقات الإلهام","https://www.poetsgate.com/ViewPoem.aspx?id=186120",""],[5956,"بالشعر ألغي بعض موتي","https://www.poetsgate.com/ViewPoem.aspx?id=202515",""],[6089,"الظلام الضالعُ","https://www.poetsgate.com/ViewPoem.aspx?id=213035",""],[6102,"منفى \"المتنبي\" الأخير...","https://www.poetsgate.com/ViewPoem.aspx?id=182749",""],[6139,"بوح الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=211302",""],[6139,"ميلاد آذار","https://www.poetsgate.com/ViewPoem.aspx?id=212333",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6164,"الثمانون؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66038&r=&rc=48",""],[6235,"معزوفة الصدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77692&r=&rc=7",""],[6333,"جرح وقصيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7035&r=&rc=6",""]],"verses":[["بِالشَّرْقِ مَا بِالشَّرْقِ مِنْ عِلَلٍ وَمَا","فِيهَا أَشَدُّ أَذىً مِنَ الخُذْلانِ",0,"ن",1,0],["بِالشاعِرِ الغِرّيدِ في أَلحانِهِ","عَبَقُ الرَبيعِ وَنُضرَةُ الأَكمامِ",1,"م",1,0],["بِالشِفاهِ الَّتي طَفا","بَينَ أَهدابِها الأُوام",2,"م",1,0],["بِالشَذى وَهوَ فائِحٌ","وَالشَذى وَهوَ بِالكَمام",2,"م",1,0],["بالشعر والادب الايام طيبة","فان خلت منهما الايام لم تطب",3,"ب",1,0],["بالشمس في الافق البعيد تغزلي","لا بالعقيق ورامتين ولعلع",4,"ع",1,0],["بِالشام صادوا الملكَ وَالإِمامَه","ما بال بازيهم غَدا حَمامَه",5,"ه",1,0],["بِالشَرقِ وَالغَربِ أَقوامٌ نُحِبُّهُمُ","فَطالِعاهُم وَكونا أَبلَغَ الرُسُلِ",6,"ل",1,0],["بالشرق غيبتُهُ وهيبتُه","بالغربِ حيثُ الشمسُ تُحْتَجَبُ",7,"ب",1,0],["بِالشِعرِ تُنشِدُهُ الجَليسَ فَيَنتَشي","طَرَباً وَبِالخَبَرِ الخَطيرِ المُنفِسِ",8,"س",1,0],["بالشعر أم بالمقلتين معلَّقٌ","من ناظري وخواطري لا يبرح",9,"ح",1,0],["بِالشامِ أَهلي وَبَغدادُ الهَوى","وَأَنا بِالرَقَّتَينِ وَبِالفُسطاطِ إِخواني",10,"ن",2,0],["بِالشَدقَمِيّاتِ العِتاقِ كَأَنَّما","أَشباحُها بَينَ الإِكامِ إِكامُ",11,"م",1,0],["بِالشِعرِ طولٌ إِذا اِصطَكَّت قَصائِدُهُ","في مَعشَرٍ وَبِهِ عَن مَعشَرٍ قِصَرُ",12,"ر",1,0],["بِالشَليلِ الَّذي أَتى عَن يَميني","قَد تَعَفَّت إِلّا ثَلاثاً جُثوما",13,"م",2,0],["بِالشَهرِ بَعدَ الحَولِ نُتبِعُهُ","ما الدَهرُ إِلّا الحَولُ وَالشَهرُ",14,"ر",1,0],["بِالشِعبِ ذي الماءِ الَّذي سَيلُهُ","يَسلُكُ خَلفِ الظَرِبِ الأَسوَد",15,"د",1,0],["بِالشامِ مَلكاً قَد تَبَدَّدَ مُلكُهُ","بِمَسَرَّةٍ مِن أَنفُسٍ وَعُيونِ",16,"ن",1,0],["بالشّعب كَذا عن يَمْنَةِ الحيّ قفِ","واذْكرْ جُملاً من شَرْحِ حالي وَصِفِ",17,"ف",1,1],["بالشعر يلْهَجُ معشرُ","ما عندهم عنه خبر",18,"ر",1,0],["بالشاطئِ الأدنى وبَسطةِ رملِهِ","بالشاطئِ الأعلى وبَردِ مَقيله",19,"ل",2,0],["بِالشَفيع الحَبيب خَير البَرايا","مِن هُدانا إِلى طَريق الصَواب",20,"ب",1,1],["بالشيخ قطب الدين نور الحق","والشيخ شمس الدين بدر الشرق",21,"ق",1,0],["بالشيخ صدر الدين ذي الإرشاد","والقطب صدر الأوليا الصاد",21,"د",1,0],["بالشيخ تاج العارفين الطيب","شيخي أبي منصور المقرب",21,"ب",1,0],["بالشيخ أبي القاسم السندوسي","وبرويم الغائب المأنوس",21,"س",1,0],["بالشام ألَّفَ خوفُ بإسك بينهم","وقلوبُهم شتَّى في الأضغانِ",22,"ن",1,0],["بِالشِعرِ يُبدي المَرءُ صَفحَةَ عَقلِهِ","فَيُعلِنُ مِنهُ كُلَّ ما كانَ يَكتُمُ",23,"م",1,0],["بالشام دولته ومكة ربه ال","حرمات مولده وطيبة داره",24,"ر",2,0],["بِالشارِبِ المُخضَرِّ صِل مُذنِفاً","سوى كَؤسِ الدَمعِ لَم يَشرَبِ",25,"ب",1,0],["بالشيخ الأكبر عارفهم","وبختمهم محيي النهج",26,"ج",1,0],["بالشيخِ والقيصومِ يَعْبَقُ شعرُه","والعُنْجُهِيَّةُ فيهما تتمرد",27,"د",1,0],["بالشمس شمس الذات حتى لا يرى","شيء سوى متقدس اللاهوت",28,"ت",1,0],["بِالشاذلي اِجعَلهُ مر","ضيّاً لَديك محمّدا",29,"د",2,0],["بِالشِركِ شاهِدُهُم عَلَيهِم شاهِدٌ","هَذا وَعِندَهُم بِأَن قَد وَحَّدوا",30,"د",3,0],["بِالشُكر ضَمَّخ طَيبُ الذكر سُدَّته","مِن حين ضَمَّ خَطيب المَجد منبرهُ",31,"ر",2,0],["بِالشَرَفَينِ اِستَسعَدَ الشَمسانِ","شَمسُ الضُحى وَغُرَّةُ السُلطانِ",32,"ن",1,0],["بالشِّعْرِ يَفْخَرُ قَومٌ وهْو يَفْخَرُ بي","إن عُدَّ مِن قَوليَ المَشْهورِ أو عَمَلي",33,"ل",2,0],["بالشح والبخل لقد عرفتك","فلست أسمع للذي يلومون",34,"ن",1,0],["بالشعب من شرقي نجد غزال","حلو الجنايات مليح السلال",35,"ل",1,1],["بالشاعرين نحيي ندوة الأدب","ولنحيي بالشعر أسواقا إلى العرب",36,"ب",1,1],["بِالشّعرِ مَفخرُ مَن قلّت فَضائلهُ","وَمفخرُ الشعرِ أَن حلّيتُهُ كلمي",37,"م",2,0],["بالشمس ان شبهوا آياته افترقت","تنمو شروقا وتخفى الشمس في الظلم",38,"م",1,0],["بالشمس إن أوصلته لأصله","بالغسل والتخليص والتنعم",39,"م",1,0],["بالشرع مؤمنهم لا بالحقيقة قل","أو بالحقيقة لا بالشرع دجال",40,"ل",1,0],["بالشَّمسِ بالملك المظفر يوسف","بأبي الهَزبرَ مُعيدِ ما أبدى سبا",41,"ب",2,0],["بالشتم للَعلَمِ الإمامِ ومَن له","إرثُ النبيِّ بأوكَدِ الإيضاحِ",42,"ح",1,0],["بِالشَمس وَهوَ سِراجُ الدين يتبعُهُ","بَدرُ الدياجر زينُ الدين في الأثرِ",43,"ر",1,0],["بالشرِّ مُنْبَسِطٌ بالخير منقبضُ","وإنَّ أصْغرَهمْ بالسوء مُعترضُ",44,"ض",1,0],["بالشملِ لا بالحديد اليومَ والنارِ","يا فتيةَ الدار صنتم حوزة الدارِ",45,"ر",1,1],["بالشدة التي هوى","فيها العديد الأكثر",46,"ر",1,0],["بآل شهاب كمّل الله عزها","وشرّف منها أربعاً وطلولا",47,"ل",2,0],["بالشوق وَالذوق وَالخضوع إِلى","جلال وجه من الجَليل علا",48,"ل",2,0],["بالشام بين صفائح","صم ترصف بالجنوب",49,"ب",1,0],["بالشمس والبدر جهلا شبههوه وما","بالشمس والبدر معنى من معانيه",50,"ي",2,0],["بالشُّمّ من مُولَهٍ لُيوثِ ال","وغى ومن أُخْتِها أَوامِ",51,"م",1,0],["بالشرعِ أعلم ما البرهان ينكره","والشرعُ أولى بما أولى وأقصدُهُ",52,"د",2,1],["بالشمِّ أدرك أحياناً وبالنظر","ما ليس يدركه غيري من النظرِ",53,"ر",1,1],["بالشرعة الغراء طلت وطالما","بالغر من آباك كان قيامها",54,"م",3,0],["بالشِّعْب بين صفائح","صلد ترصص بالجنوب",55,"ب",1,0],["بالشكرِ حين دَلَّها الصدّيقُ","على مقامٍ بالعُلا حَقيق",56,"ق",1,0],["بِالشاه سُلطان الوَرى محمد","إِلى علي جاءَ وَهُوَ زائر",57,"ر",1,0],["بالشرق والغرب غدا ذكره","يحث من حمد وشكر جناح",58,"ح",1,0],["بالشبه تحفظ صحة موجود","والضد فيه شفاء كل سقام",59,"م",1,0],["بالشعرِ والتاريخ والأمثال وال","أنساب سل تُصَدِّق",60,"ق",1,0],["بالشيب آمن رفقتي أما أنا","فبقيت دونهم بشيبي كافرا",61,"ر",2,0],["بالشاعر السوري رحت ملقبا","وبنسبتي ارض العراق تزانُ",62,"ن",1,1],["بالشُّكر كما قيل دوامُ النِّعَمِ","أعطاك غنى حسنك، فارحَمْ عَدَمي",63,"ي",1,0],["بالشام من لست بناس له","بل فيه لي شغل عن الناس",64,"س",1,1],["بالشتم والزَجرِ وبالتهديدِ","وبالجفا والأسرِ والقيودِ",65,"د",1,0],["بالشام والغرب بات يصمى","كليهما قول رائييه",66,"ي",2,0],["بالشرطين يسميهما اذن","بالنطح والاشراط ايضا فاعلمن",67,"ن",1,0],["بالشعبِ مِنْ بوَّان حلّ شَغوفها","ومَحَلُّها بالكَرْخِ مِنْ بَغداذا",68,"ذ",2,0],["بالشيخ كم طبت وطببها","والكي أحرز رتبة الطب",69,"ب",1,0],["بِالشَّمسِ حينَ تغيبُ عن أَبصارِنا","كَلَفٌ وبالبيداءِ بَعدَكَ ضِيْقُ",70,"ق",1,0],["بالشكر تجزى أيادي من له نعم","إلا أياديه لا شكر يجازيها",71,"ي",3,0],["بالشمس أم شمس غد وحدَه","مذخورة من أجله تُخلَق",72,"ق",1,0],["بالشاعر الندس الأغر","الكاتب الفذ المجيد",73,"د",1,0],["بالشعر بالإلهام بالنسب الذي","بيني وبينك محكم الأسباب",74,"ب",1,0],["بالشط لي سكنٌ أفديه من سكنِ","أهدى من الآس لي غصنين في غصُنِ",75,"ن",1,1],["بِالشَّاذليِّ وَحِزِبِهِ وكُلِّ قُط","بٍ فِي الوَرَى فِي نَهجِ أحمَدَ قَد جَرَى",76,"ر",2,0],["بالشافعي وأهل البيت فاغتبطي","مصر وقولى لقد بلغت آمالي",77,"ل",2,0],["بالشاكر الغافر فاشكر سعيي","واغفر ذنوبي وارعين رعيي",78,"ي",1,0],["بالشورى والزخرف والدّخانِ","جاثيةِ الأحقافِ صدْ عدواني",79,"ي",1,0],["بالشهم آخيل ألم ألفه","في خيمه يبكي على إلفه",80,"ه",1,0],["بالشَّحمِ غَشَّى حَواشِيها وأَتبَعَهَا ال","أَحتساءَ دامِيةً من فَوقِها وَشَلا",81,"ل",2,0],["بالشَّحم غَشَّى حَوَاشيها وَأَتبَعَهَا","الأَحشاءَ دامِيةً من فَوقِها وَشَلا",82,"ل",2,0],["بالشمأل الشمل استقل نسيمها","وأريجها قد ضاع بالند الندي",83,"د",2,0],["بِالشاهِد قالَ ائت لِتَصحيحكَ ذا","إِنَّ اليدَ في المُلكِ دَليلُ الحَقِّ",84,"ق",1,0],["بِالشوكَةِ قَد يَذُبُّ عَن حَوزَتِهِ","مَهما عقد التمائم الأَزهارُ",85,"ر",1,0],["بالشع