ps://www.poetsgate.com/ViewPoem.aspx?id=211894",""],[5956,"عيوني شموس","https://www.poetsgate.com/ViewPoem.aspx?id=183269",""],[5956,"وكنتُ أعي التوائي في الصعودِ","https://www.poetsgate.com/ViewPoem.aspx?id=186211",""],[5957,"العناق الطويل","https://www.poetsgate.com/ViewPoem.aspx?id=53578",""],[6003,"نبية القلب","https://www.poetsgate.com/ViewPoem.aspx?id=207392",""],[6090,"قل لسكرى فليحيي آنا ليرنو","https://www.poetsgate.com/ViewPoem.aspx?id=170906",""],[6152,"روحي تشتاقك","https://www.poetsgate.com/ViewPoem.aspx?id=204439",""],[6277,"توبة عن التوبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64442&r=&rc=1",""],[5190,"المفترق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78333&r=&rc=46",""],[572,"جُدْلِي ببر كارِكَ الذي صَنَعَتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9167&r=&rc=24",""]],"verses":[["فَعَيشُكَ تَحتَ ظِلِّ العِزِّ يَوم","وَلا تَحتَ المَذَلَّةِ أَلفَ عامِ",0,"م",1,0],["فَعُيُونُهُمْ صُورٌ وَوَقْعُ حَدِيْثِهِمْ","هَمْسٌ وَرَجْعُ كَلاَمِهِمْ إِيمَاءُ",1,"ا",2,0],["فَعَيناكَ عَيناهُ وَصَوتُكَ صَوتُهُ","تَمَثَّلتَهُ لي غَيرَ أَنَكَ لا تَعدو",2,"د",2,0],["فَعيرُكُمُ كانَت أَذَلُّ وَأَرضُكُم","كَما قَد عَلِمتُم جَدبُها وَمُحولُها",3,"ل",3,0],["فَعَيناكَ غَربا جَدوَلٍ في مَفاضَةٍ","كَمَرِّ الخَليجِ في صَفيحٍ مُصَوَّبِ",4,"ب",1,0],["فَعَيناكِ مِنها وَالدَلالُ دَلالُها","وَجيدُكِ إِلاّ أَنَّهُ في العَقائِصِ",5,"ص",1,1],["فَعَيناكِ عَيناها وَلَونُكِ لَونُها","وَجيدُكِ إِلّا أَنَّها غَيرُ عاطِلِ",6,"ل",1,0],["فَعَينَيَّ إِذ أَودى الفِراقُ بِأَربَدٍ","فَلا تَجمُدا أَن تَستَهِلّا فَتَدمَعا",7,"ع",2,0],["فَعَيَّت وَجاوَبَني دونَها","بِما راعَ قَلبِيَ أَعوانَها",8,"ن",3,0],["فعيون من الجلالة والحس","ن لها بين بسطة وانْقباض",9,"ض",1,0],["فعينايَ في الليل محلوقتان","وفي اليوم من مائها الدافق",10,"ق",1,0],["فعيناه في المرخ حيث اجتلت","بديعاً وأحشاه في دابق",10,"ق",1,0],["فعيون من المدامع شكرى","وصدور للحزن فيها غليل",11,"ل",1,0],["فعيشا فرقدين من الليالي","وعاش خلائق بكما وطابوا",12,"ب",3,0],["فَعَينٌ إِلى مَن بَدا لِلوُجودِ","وَأُخرى مُشَيِّعَةٌ مِن غَبَر",13,"ر",1,0],["فَعَينَيَّ ما المَوتى سَواءً بُكاهُمُ","فَبِالدَمِّ إِن أَنزَفتُما الماءَ فَاِدمَعا",14,"ع",2,0],["فَعَينَكَ لُمها إِنَّ عَينَكَ حَمَّلَت","فُؤادَكَ ما يَعيا بِهِ المُتَحَمِّلُ",15,"ل",1,0],["فَعَيناكِ عَيناها وَجيدُكِ جيدُها","سِوى أَنَّ عَظمَ الساقِ مِنكِ دَقيقُ",16,"ق",1,0],["فَعَيناهُ لِصَرمِ حِبالِ سَلمى","وَطولِ فِراقِها بَعدَ اِئتِلافِ",17,"ف",1,0],["فعيونُ الأَقْصَابِ يَتبعُها النَّب","كُ وَيتْلو كُفَافَةَ العَوْجاءُ",18,"ا",2,0],["فَعَيني تَسكُبُ الدَمعَ","وَقَلبي بِكِ مَكروبُ",19,"ب",1,0],["فَعيشا مُفضِلَينِ أَوِ اِستَميحا","وَسودا مَعشَراً أَو لا تَسودا",20,"د",2,0],["فَعيشا أَبِيَّينِ لِلمُخزِيا","تِ مِثلَ السِماكينِ لا تَأبُوانِ",21,"ن",1,0],["فَعَينايَ طَوراً تَغرَقانِ مِنَ البُكا","فَأَعشى وَطَوراً تَحسِرانِ فَأُبصِرُ",22,"ر",1,0],["فَعَيشُكَ تَحتَ ظِلِّ العِزِّ يَوماً","وَلا تَحتَ المَذَلَّةِ أَلفَ عامِ",23,"م",1,0],["فَعِيشَا وَاهْنَآ وَلدَا وَكُونَا","حَلِيفَيْ غِبْطَةٍ فِي كُلِّ حَالِ",24,"ل",1,0],["فَعيْن اشْتِياقٍ تَرْتَجِي لُقْيَة المُنَى","وصَدْرُ وَلاَءٍ خافِق القَلْبِ واجِبُه",25,"ب",2,0],["فَعَيْنَيّ ما المَوْتَى سَوَاءً بُكَاهُمُ","فَالبدّمِ، إنْ أنْزَفْتُما المَاء، فادْمَعا",26,"ع",2,0],["فَعَينَيَّ لا يَبقى عَلى الدَهرِ فادِرٌ","بِتَيهورَةٍ تَحتَ الطِخافِ العَصائِبِ",27,"ب",1,0],["فعيني عن سواك لها انكفاف","وسمعي فيك صم عن الملام",28,"م",1,0],["فعين العزم ترمقنا","وعين الحزم ترعانا",29,"ن",2,0],["فَعيشوا جميعا في نعيمٍ مخلّدٍ","وضدكم في الذلِّ والحشر خَاضِعُ",30,"ع",1,0],["فعيشوا بخيرٍ في نعيمِ ولَذّةٍ","ومُلْكٍ أَثيلٍ ثابِتٍ غير عازِبِ",31,"ب",1,0],["فَعينُكَ إِن رَأتهُ رأت أميرا","مَهِيباً هو أجدُران يَسُودَا",32,"د",2,0],["فعيشك فيها ألف عام وينقضي","كعيشك فيها بعض يوم وليلة",33,"ه",1,0],["فَعَيَّثَ ثُمَّ اِعتامَ مِنهُنَّ بَكرَةً","مِنَ الكومِ لَم يَعلَق بِها حَبلُ طامِثِ",34,"ث",1,0],["فَعَينَىَّ يا عَينَىَّ حَتَّامَ أَنتُما","بِهِجرانِ أُمِّ الغَمرِ تَختَلِجانِ",35,"ن",1,0],["فعيِشي مذ سَباني البي","نُ منكَ جميعُه كُلَف",36,"ف",1,0],["فعيني قد انصبغتْ بالفؤاد","كمثلِ الزجاجةِ والسائلِ",37,"ل",1,0],