خال","https://www.aldiwan.net/poem3230.html","عموديه"],[467,"هي ظبية الوادي وعين لداتها","https://www.aldiwan.net/poem3345.html","عموديه"],[471,"إنا لقوم إذا دعا بهم","https://www.aldiwan.net/poem60317.html","المنسرح"],[473,"والنفس فاستيقنا ليست بمعولة","https://www.aldiwan.net/poem4765.html","البسيط"],[482,"هب لي بيانك في ممدوحك الهادي","https://www.aldiwan.net/poem36957.html","البسيط"],[517,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[525,"لسائل الدمع عن بغداد أخبار","https://www.aldiwan.net/poem1307.html",""],[543,"لا عيب يعاب فيك إلا أنني","https://www.aldiwan.net/poem56735.html","الكامل"],[561,"إن القناعة في الدنيا هي الشرف","https://www.aldiwan.net/poem34345.html","البسيط"],[565,"يا نفس هل من أمر ربك عاصم","https://www.aldiwan.net/poem52796.html","الكامل"],[576,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"],[590,"إن القريض إن أرسلت قد وصلا","https://www.aldiwan.net/poem11507.html","عموديه"],[931,"","https://poetry.dctabudhabi.ae/diwan/poem/133883","الكامل"],[1133,"","https://poetry.dctabudhabi.ae/diwan/poem/18989","البسيط"],[1145,"","https://poetry.dctabudhabi.ae/diwan/poem/31514","الكامل"]],"verses":[["إِنَّ القُرى يَوماً سَتَه","لِكُ قَبلَ حَقِّ عَذابِها",0,"ب",3,0],["إِنَّ القَناعَةَ كَنزٌ كُنتَ حارِسَهُ","تَرى بِهِ القوتَ ياقوتاً وَمُرجانا",1,"ن",2,0],["إِنَّ القُدودَ عَلى تَأَوُّدِها","فَتكَت بِكُلِّ مُقَوَّمٍ لَدنِ",2,"ن",1,1],["إن ألقهم أتغال في إكرامهم","متحاشياً إبداء الاستصغار",3,"ر",1,0],["إِنَّ القُرَى مِنْ هَمِّهَا فَاعْلَمُوا","لِنَهْضَةٍ تَرْقُبُهَا مِنكُمُ",4,"م",1,0],["إِنَّ القَليلَ الَّذي يَأتيكَ في دَعَةٍ","هُوَ الكَثيرُ فَأَعفِ النَفسَ مِن تَعَبِ",5,"ب",1,1],["إِنَّ القَصائِدَ يا أُخَيطِلُ فَاِعتَرِف","قَصَدَت إِلَيكَ مُجِرَّةَ الأَرسانِ",6,"ن",1,0],["إِنَّ القَصائِدَ قَد جازَت غَرائِبُها","ما بَينَ مِصرَ إِلى الأَجزاعِ مِن عَدَنِ",7,"ن",1,0],["إِنَّ القَصائِدَ قَد جَدَعنَ مُجاشِعاً","بِالسُمِّ يُلحَمُ نَسجُها وَيُنارُ",8,"ر",1,0],["إِنَّ القَصائِدَ قَد وَطِئنَ مُجاشِعاً","وَوَطِئنَ تَغلِبَ ما لَها مِن زاجِرِ",9,"ر",1,0],["إِنَّ القَصائِدَ لَن يَزَلنَ سَوائِحاً","بِحَديثِ جِعثِنَ ما تَرَنَّمَ ساري",10,"ر",2,0],["إِنَّ القَديمَ وَأَسلافاً تُعَدُّ لَكُم","نِعمَ القَديمُ إِذا ما عُدَّ وَالسَلَفُ",11,"ف",1,0],["إِنَّ القِرافَ بِمِنخَرَيكَ لَبَيِّنٌ","وَسَوادِ وَجهِكَ يا اِبنَ أُمِّ عِفاقِ",12,"ق",1,0],["إِنَّ القَتيلَ الَّذي جَرَّت بَنو قَطَنٍ","أَن سُبَّ قُرحانُ لا ذاكٍ وَلا عالي",13,"ل",2,0],["إِنَّ القَوافِيَ قَد أُمِرَّ مَريرُها","لِبَني فَدَوكَسَ إِذ جَدَعنَ عِقالا",14,"ل",2,0],["إِنَّ القُدورَ لَواقِحٌ","يُحلَبنَ أَمثَلَ ما رُعينا",15,"ن",2,0],["إن القبيحَ وإن صنَّعْتَ ظاهرَهُ","يعودُ ما لُمَّ منه مرةً شَعِثَا",16,"ث",2,0],["إن القريض الذي يخزَى بحائكه","ليَكتسي بك فخراً غير أطمار",17,"ر",1,0],["إِنَّ القَوافي كَالخَرائِدِ مِنعَةً","وَتَفوقُها في نَبذِ كُلِّ مُداجِ",18,"ج",1,0],["إِنّا لَقَومٍ لَنا مَجدٌ سَنَذكُرُهُ","ما دامَ فينا لِسانٌ ناطِقٌ وَفَمُ",19,"م",1,0],["إِنَّ القَضِيَّةَ تَغَط","طَت عَن سِوايَ فَكَيفَ عَنّي",20,"ن",2,0],["إِنَّ القَليلَ كَثيرٌ مِنكِ يَنفَعُني","وَما سِواهُ كَثيرٌ غَيرُ نَفّاعِ",21,"ع",1,0],["ان القضيب الذي تلهو يداك به","يكاد يخطف منه البرق ابصاري",22,"ر",2,0],["ان القوي ليبقى والحياة وغى","في البر في البحر في الاجواء في الغار",22,"ر",1,0],["ان القبور لا ولى بالألى عجزوا","عن الدفاع بدار الضيم فانتحروا",23,"ر",3,0],["انا لقوم راحلون الى التي","نجزى بها والدين احسن زاد",24,"د",1,0],["ان القميص به خروق جمة","فاذا رتقت فاي فتق ترتق",25,"ق",1,0],["إِنَّ القَديمَ ذَخيرَةٌ مِن صالِحٍ","تَبني المُقَصِّرَ أَو تَحُثُّ المُقتَدي",26,"د",2,0],["إِنَّ القُلوبَ وَأَنتَ مِلءُ صَميمِها","بَعَثَت تَهانيها مِنَ الأَعماقِ",27,"ق",1,0],["إِنَّ القَضاءَ إِذا رَمى","دَكَّ القَواعِدِ مِن ثَبير",28,"ر",1,0],["إِنَّ القَتيلَ مُضَرَّجاً بِدُموعِهِ","مِثلُ القَتيلِ مُضَرَّجاً بِدِمائِهِ",29,"ا",3,0],["إِنَّ القَريضَ شَجٍ بِعِطفي عائِذٌ","مِن أَن يَكونَ سَواءَكَ المَمدوحُ",30,"ح",1,0],["إِنَّ القَوافي لَم تُنِمكَ وَإِنَّما","مَحَقَتكَ حَتّى صِرتَ ما لا يوجَدُ",31,"د",1,1],["إِنَّ القَناني وَإِنَّ النَدى","تِربا اِصطِحابٍ وَأُخَيّا لِدَه",32,"د",2,0],["إِنَّ القَبائِلَ مِن نِزارٍ أَصبَهَت","وَقُلوبُها جَزَعاً عَلَيكَ حِرارُ",33,"ر",1,0],["إِنَّ القُصورَ بِجيلِ جَيلانَ الَّتي","أَعيَت مَعاقِلُها بَني الأَحرارِ",34,"ر",1,0],["إِنَّ القِيامَةَ قَد دَنَت أَشراطُها","حَتّى أُمَيَّةُ عَن فَزارَةَ تَنزِعُ",35,"ع",1,0],["إِنَّ القِرى سُجِنَت مَعي نيرانُهُ","عَن كُلِّ نازِلِ جَنبَةٍ وَدَخيلِ",36,"ل",1,0],["إِنَّ القَوافِيَ لَن يَرجِعنَ فَاِستَمِعوا","إِذا بَلَغنَ شِعابَ الغَورِ ذي القُنَنِ",37,"ن",1,0],["إِنّا لِقَومٌ ما نَرى ما لاقى","أَقَدَّ هاماً وَأَقَطَّ ساقا",38,"ق",2,0],["إِنَّ القَليلَ مِنَ الكَلامِ بِأَهلِهِ","حسَنٌ وَإِنَّ كَثيرَهُ مَمقوتُ",39,"ت",1,1],["إِنَّ القُلوبَ إِذا تَنافَرَ وُدُّها","شِبهَ الزُجاجَةِ كَسرُها لا يُشعَبُ",40,"ب",1,0],["إِنَّ القَريرَةَ عَينُهُ عَبدُ","خَشِيَ الإِلَهَ وَعَيشُهُ قَصدُ",41,"د",1,1],["إِنَّ القُنوعَ لَزادٌ إِن رَضيتَ بِهِ","كُنتَ الغَنِيَّ وَكُنتَ الوافِرَ العِرضِ",42,"ض",1,0],["إِنَّ القَناعَةَ بِالكَفافِ هِيَ الغِنى","وَالفَقرُ عَينُ الفَقرِ في الأَموالِ",43,"ل",1,0],["إِنَّ القُبورَ سُجونٌ","ما مِثلُهُنَّ سُجونُ",44,"ن",1,0],["إِنَّ القُلوبَ إِذا طَوَت أَسرارَها","أَبدَت لَكَ الأَسرارَ مِنها الأَوجُهُ",45,"ه",1,0],["إنِ أُلقِها تَتَلَقَّف كُلَّما صَنَعوا","إِذا أُتيتُ بِسِحرٍ مِن كَلامِهِمِ",46,"م",1,0],["إِنَّ القَوافي عِندَنا حَرَكاتُها","سِتٌّ عَلى نَسَقٍ بِهِنَّ يُلاذُ",47,"ذ",1,1],["إِنّا لَقَومٌ أَبَت أَخلاقُنا شَرَفاً","أَن نَبتَدي بِالأَذى مَن لَيسَ يُؤذينا",48,"ن",2,0],["إِنَّ القَبائِلَ أَضرَمَت مِن جَمعِنا","يَومَ الذَنائِبِ حَرَّ مَوتٍ أَحمَسِ",49,"س",1,0],["إنّ القسنطينة الكبرى مُمَلَّكُها","قد اتّقى منك حدّ السيفِ بالقلمِ",50,"م",1,0],["إِنَّ القَصائِدَ يَمَّمَتكَ شَوارِداً","فَتَحَرَّمَت بِنَداكَ قَبلَ تَحَرُّمي",51,"م",2,0],["إِنَّ القِبابَ المُستَقِلَّةَ بَينَها","مَلِكٌ يَطيبُ بِهِ الزَمانُ وَيَكرُمُ",52,"م",1,0],["إِنَّ القَوافِيَ وَالمَساعِيَ لَم تَزَل","مِثلَ النِظامِ إِذا أَصابَ فَريدا",53,"د",2,0],["إنَّ القناديلَ بكمْ","زادتْ علوّاً وارتقا",54,"ق",2,1],["إنَّ القلوبَ إلى القلوبِ مشوقةٌ","قدْ أذكرتها بالرحيقِ السلسلِ",55,"ل",1,0],["إِنَّ القَتولَ تَقَتَّلَت","بِالدَلِّ لِلقَلبِ الرَهينِ",56,"ن",1,0],["إِنَّ القَضاءَ عَلى الشُعوبِ يُصيبُها","في حَقِّها الأَوفى لَغَيرُ جَميلِ",57,"ل",1,0],["إِنَّ القَضِيَّةَ ما عَلِمتُم فَاِحكُموا","فيها حُكومَةَ صادِقينَ عُدولِ",57,"ل",1,0],["إنّ القتيلَ لمن غرّته صَخرتُه","فَظنَّ أنّ رسولَ اللهِ مقتول",58,"ل",1,0],["إِنَّ القُلوبَ مَعَ العُيونِ إِذا جَنَت","جاءَت بَلِيَّتُها عَلى الأَجسادِ",59,"د",1,0],["إِنَّ القُلوبَ لَأَجنادٌ مُجَنَّدَةٌ","لِلَّهِ في الأَرضِ بِالأَهواءِ تَختَلِفُ",60,"ف",1,0],["إِنَّ القُفولَ إِلى حَيٍّ وَإِن بَعُدوا","أَمسَوا وَدونَهُمُ ثَهلانُ فَالنيرُ",61,"ر",1,0],["إِنِ القَولُ حَرَّفَهُ كاذِبٌ","فَإِنَّ القَضاءَ بِهِ ما اِنحَرَف",62,"ف",1,0],["إِنَّ القِيانَ وَشُربَ الراحِ مَفسَدَةٌ","مِن قَبلِ لَمكٍ وَقَينانٍ وَقابيلا",63,"ل",2,0],["إن القلوب من الغي","ظِ في الصدور لتغلي",64,"ل",2,0],["إِنَّ القُلوب إذا غدت","في الحُبِّ مترعة الحياضِ",65,"ض",1,1],["إن القوي جسور في تكلمه","ومن علامات ضعف القائل الوجل",66,"ل",1,0],["إن القلوب إذا لم يعترفن بما","منه تحس فلا تجدي البراهين",67,"ن",1,0],["إن القنوط من الأعمال مهلكة","ويل لمن هو من أَعماله قنطا",68,"ط",2,0],["إِنْ أَلْقَهُمْ أَتَغَالى فِي إِكْرَامِهِمْ","مُتَحَاشِياً إِبْدَاءَ الاِسِتصْغَارِ",69,"ر",1,0],["إن القصيدة ليس ما كتبت يدي","لكنها ما تكتب الأهداب",70,"ب",1,0],["إن القساورَ في المغاور تنقي","من يتقي الرحمنَ حقَّ تقاته",71,"ت",2,0],["إِنَّا لقَوم ليسَ يُمْحَى عارهُم","حتى يُرَى بدمائهم مغسولا",72,"ل",2,0],["إن القَرِيضَ بلا وزن وقَافِيَةٍ","خُنْثَى؛ فلا هو بالأُنثى ولا الرجل!",73,"ل",1,0],["إن القلوب التي ترمي تطير بها","مصاحف الذكر والإيمان لم يطر",74,"ر",1,0],["ان القوي من ثنى شرته","ومن اذا مال الى النفس انتهى",75,"ا",1,0],["ان القلوب استشعرت جبلة","فتاركت أحلامها الى الهوى",75,"ا",1,0],["إن القصورَ التي شاهَدْتَ ، قائمةٌ","على أساسٍ من الإجحافِ مُنهار",76,"ر",1,0],["أن ألقحت.........؟ تباركوها المسلمين","وأن أكسرت ....؟ خطو على ذاك الجدااار",77,"ر",1,0],["إنّ القَبَائِلَ مِنْ نِزَارٍ أصْبَحَتْ","وَقُلُوبُها، جَزَعاً عَلَيْكَ، حِرَارُ",78,"ر",1,0],["إنَّ القَتُولَ تَقَتَّلَتْ","بِکلدَّلِّ لِلْقَلْبِ الرَّهِين",79,"ن",1,0],["إن القدود المأدبية","والعيون العجرمية",80,"ي",2,0],["إن القداسة لو تقي يا","شيخ من وقع السهام",81,"م",1,0],["إنّا لقوم إذا ما الحب خامرنا","للحب نوفي وإن لم نلق موفينا",82,"ن",2,0],["إن القريض الذي كانت مغلَّقةً","أبوابُه فتحت منها لنا السُّدَدُ",83,"د",1,0],["إنَّ القَوَافي طَوعِى مَن يُسَابِقنِي","في شَأوِهَا عَاقَه عَن شَأوِيَ الحَرَدُ",84,"د",1,0],["إِنَّ القَرابَةَ وَالمَوَدَّةَ أَلَّفا","بَينَ الوَليد وَبَينَ بِنتِ سَعيدِ",85,"د",1,0],["إن القناعة مذ خَطمتُ بحبلها","طمعى تساوت رحلتى ومقامى",86,"م",2,0],["إنَّ القوافى وإن جاشت غواربُها","لا يُستطاه بها تحويلُ أطوادِ",87,"د",1,0],["إِنَّ القَوافِيَ مُذ أَتَتكَ مَوادِحاً","أَمِنَت مِنَ الإِكداءِ وَالإِكذابِ",88,"ب",1,0],["إِنَّ القَوافِيَ وَهيَ غَيرُ مَلومَةٍ","مُذ أَصبَحَت دَأبي فَمَدحُكَ دابُها",89,"ب",3,0],["إِنَّ القَوافي لا عَدَتكَ مَوادِحاً","أَمِنَت بِكَ الإِخفاقَ وَالتَأثيما",90,"م",2,0],["إنَّ القلوب إذا اعتلت خواطرها","فذكر أحمد فيها المبرىء الآسي",91,"س",2,0],["أن القلوب على القلوب شواهد","والقلب أعدل حاكم وشهيد",92,"د",1,0],["أَنَّ القَضاءَ قاذِفي في هُوَّةٍ","لا تَستَبِلُّ نَفس مَن فيها هوى",93,"ا",1,0],["إِنَّ القُرُومَ السَوامي مِن بَني حَسَنٍ","يُحصى التُرابُ وَلا تُحصى أَيادِيها",94,"ي",3,0],["إن القلوب تألفت واستسلمتْ","طوعا إليك بعلمِها لا جهلها",95,"ل",3,0],["إن القلوبَ كأهلها ذكرٌ وأن","ثى كلُّ قلبٍ فيهِ من شهواتهِ",96,"ت",2,0],["إنَّ القرين هو النظير فإن تكن","حُرّاً فدونك صحبة الأحرار",97,"ر",1,0],["إِنَّ القُرَيَّةَ قَد تَبَيَّنَ أَمرُها","إِن كانَ يَنفَعُ عِندَكَ التَّبيينُ",98,"ن",1,0],["إن القويَّ يَرى أذاهُ عدالةً","أما الضعيفُ فلا يلاقي مُنقِذا",99,"ذ",2,0],["إنّ القلوبَ هي النجومُ تجاذُباً","ولكلِّ قلبٍ كوكبٌ سيّار",100,"ر",1,0],["إنّ القصورَ التي بِتنا نشيِّدُها","حقيرةٌ عندَ قبرٍ من قُبورِهم",101,"م",1,0],["إِنَّ القَناعَةَ لَم تَخلَع مَلابِسَها","إِلّا عَلى رَجُلٍ ناهيكَ مِن رَجُلِ",102,"ل",1,0],["إِنَّ القَيسِ عَلى عَهدِهِ","في إِرثِ ما كانَ بَناهُ حُجُر",103,"ر",1,0],["إن القناعة كنز ليس بالفاني","فاغنم هديت أخي عيشها الفاني",104,"ن",2,1],["إن القصيدة أنجزت واستنجزت","عرضا فكيف علي فيه تشير",105,"ر",1,0],["إِنّ القلوبَ عَلى اِختلافِ طِباعها","بِودادِ أحمَد كلّها معمورُ",106,"ر",1,0],["إنَّ القَنَاعَةَ مَن يحلل بِسَاحَتِهَا","لَم يَلقَ في دَهرِهِ شَيئاً يُؤرقهُ",107,"ق",2,0],["إِنَّ القَصائِدَ خَيرَها وَشِرارَها","مِثلُ المَناهِلِ عَذبَةٌ وَمِلاحُ",108,"ح",1,0],["إِنَّ القَناعَةَ ما عَلِمتَ غِنىً","وَالحِرصُ يورِثُ ذا الغِنى فَقرا",109,"ر",2,1],["إن القفول الذي أوفى بعيدين","مكرمين على الدنيا عزيزين",110,"ن",1,1],["إن القضايا تعاكست خطأً","نقيضها للعيان يَبذلُها",111,"ل",3,0],["إن القداسة والنفاسة والرضا","سيفٌ يجرَّد إن أردتَ ويغمد",112,"د",1,0],["إن القضاء لسيف لا يقاومه","شيء من الخلق إلا وهو محبوب",113,"ب",1,0],["إِنَّ القتالَ واجب","بَعدَ كليب الذاهب",114,"ب",1,1],["إِنَّ القداحَ أَمرُها عَجيبُ","الفَذُّ وَالتَوأَمُ وَالرَقيبُ",115,"ب",1,1],["إنَّ القوادِمَ بالخَوا","في والقَصائِدَ بالقوافي",116,"ف",2,0],["إن ألَقَهُ سرَّهُ قُربي وآنسَهُ","وإن أغِبْ صَدّ عَنّي مُعرِضاً ولَهَا",117,"ه",2,1],["إنَّ القوافي في مديحك لم تزلْ","تُثني عليك بلفظها ولسانها",118,"ن",3,0],["أن القناعة كنز لا مثيل له","يبدل العيش معسورا بميسور",119,"ر",1,0],["إن القيود وإن تفك ثقيلة","فلتطرحوها طرح من عاداكمو",120,"م",2,0],["أنّ القوارحَ أُخِّرتْ","وتقدّمتْ أمهارُها",121,"ر",3,0],["إن القوافي كالمطايا أنت را","كبها وهذا الجود خير عقال",122,"ل",1,0],["أنَّ القوافي زلزلت أقدامها","ورمت إليك حاومها بحصاتها",123,"ت",3,0],["إِنّا لَقَومٌ إِذا دَعا بِهِمُ","أَسيرُ خَطبٍ أَجابَهُ الفَرَجُ",124,"ج",1,1],["إِنَّ القَديمَ وَإِن جَلَّت رَزيئَتُهُ","يَنضُو فَيُنسَى وَيَبقَى الحادِثُ الأُنُفُ",125,"ف",1,0],["إن القلوب براكين مؤججة","العدل لا الجور يلجيها لإخماد",126,"د",1,0],["إنّا لَقومٌ تقُدُّ البيضَ أنصُلُنا","وما لَنا في لقاءِ البيضِ من قِبَلِ",127,"ل",1,0],["إن القيامة في بغداد قد وجدت","وحدها حين للإقبال إدبار",128,"ر",1,0],["إِنَّ القَرابَةَ مِنكَ يأمَلُ أَهلها","صلةً وَيأمن غلظَةً وَعقوقا",129,"ق",2,0],["إن القناعة في الدنيا هي الشرفُ","وغيرها عندنا التبذير والسرفُ",130,"ف",1,1],["إن القلوبَ إذا شكت جُرحَ الأسَى","فلها مِن الصَّبرِ الجميلِ مَراهمُ",131,"م",1,0],["إِنَّ القَوافي ذو تقِلُّ لِقَدر ِهِ","لِيَقِلُّ عَنها قَدرُ كُلِّ عَظيمِ",132,"م",1,0],["إن القريض إن أرسلت قد وصلا","فهيج الشوق حتى ثار واشتعلا",133,"ل",2,1],["إِن القداحَ إذا جُمعن فرامها","بالكسر ذو حَنَقٍ وبطشٍ أيِّدٍ",134,"د",1,0],["إِنَّ القُرَيطينَ لَم يَدعوكَ كُنيَتَهُم","فَإِنصُر بَني آلِ مَسعودٍ وَدينارِ",135,"ر",1,0],["أَنّا لَقينا بَعدَكُم بِدِيارِنا","مِن جانِبِ الأَمراجِ يَوماً يُسأَلُ",136,"ل",1,0]]}