],[270,"ما الدار إن رحل الأحبة دار","https://www.aldiwan.net/poem35218.html","الكامل"],[270,"حرية الشعب بين السيف والعلم","https://www.aldiwan.net/poem35586.html","البسيط"],[282,"في عنفوان الصبا ما كنت بالغزل","https://www.aldiwan.net/poem32668.html","البسيط"],[300,"قد بكرت عاذلتي بكرة","https://www.aldiwan.net/poem45491.html","السريع"],[304,"إن القناعة كنز ليس بالفاني","https://www.aldiwan.net/poem16811.html","البسيط"],[305,"أنهي إلى المولى بإثر تحية","https://www.aldiwan.net/poem56538.html","الكامل"],[305,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[313,"أسعد ببال امرئ يمسي على ثقة","https://www.aldiwan.net/poem59488.html","البسيط"],[322,"اليأس من طول الثواء رواح","https://www.aldiwan.net/poem56342.html","الكامل"],[338,"إن القناعة ما علمت غنى","https://www.aldiwan.net/poem68777.html","الطويل"],[351,"إن القفول الذي أوفى بعيدين","https://www.aldiwan.net/poem68964.html","البسيط"],[377,"نفس غدت قد عصاك أسهلها","https://www.aldiwan.net/poem59283.html","المنسرح"],[377,"قالت إليك فقلت طرفي أرمد","https://www.aldiwan.net/poem66873.html","الكامل"],[391,"خل المقادير تمضي لا تغالبها","https://www.aldiwan.net/poem54612.html","عموديه"],[392,"إن القتال واجب","https://www.aldiwan.net/poem454.html",""],[393,"إن القداح أمرها عجيب","https://www.aldiwan.net/poem53611.html","الرجز"],[405,"ظفر بن عبد الله أكرم","https://www.aldiwan.net/poem49852.html","مجزوء الكامل"],[409,"إن ألقه سره قربي وآنسه","https://www.aldiwan.net/poem32246.html","البسيط"],[416,"ورد السرور وطاف بحانها","https://www.aldiwan.net/poem54038.html","الكامل"],[443,"أشمة نسجت من معدن النور","https://www.aldiwan.net/poem55941.html","عموديه"],[453,"لا أرتضيه لكم ولا أرضاكمو","https://www.aldiwan.net/poem61227.html","الكامل"],[458,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[464,"قلبي بذاك الخال ليس بخال","https://www.aldiwan.net/poem3230.html","عموديه"],[464,"هي ظبية الوادي وعين لداتها","https://www.aldiwan.net/poem3345.html","عموديه"],[468,"إنا لقوم إذا دعا بهم","https://www.aldiwan.net/poem60317.html","المنسرح"],[470,"والنفس فاستيقنا ليست بمعولة","https://www.aldiwan.net/poem4765.html","البسيط"],[479,"هب لي بيانك في ممدوحك الهادي","https://www.aldiwan.net/poem36957.html","البسيط"],[514,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[522,"لسائل الدمع عن بغداد أخبار","https://www.aldiwan.net/poem1307.html",""],[540,"لا عيب يعاب فيك إلا أنني","https://www.aldiwan.net/poem56735.html","الكامل"],[558,"إن القناعة في الدنيا هي الشرف","https://www.aldiwan.net/poem34345.html","البسيط"],[562,"يا نفس هل من أمر ربك عاصم","https://www.aldiwan.net/poem52796.html","الكامل"],[573,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"],[587,"إن القريض إن أرسلت قد وصلا","https://www.aldiwan.net/poem11507.html","عموديه"]],"verses":[["إِنَّ القُرى يَوماً سَتَه","لِكُ قَبلَ حَقِّ عَذابِها",0,"ب",3,0],["إِنَّ القَناعَةَ كَنزٌ كُنتَ حارِسَهُ","تَرى بِهِ القوتَ ياقوتاً وَمُرجانا",1,"ن",2,0],["إِنَّ القُدودَ عَلى تَأَوُّدِها","فَتكَت بِكُلِّ مُقَوَّمٍ لَدنِ",2,"ن",1,1],["إن ألقهم أتغال في إكرامهم","متحاشياً إبداء الاستصغار",3,"ر",1,0],["إِنَّ القُرَى مِنْ هَمِّهَا فَاعْلَمُوا","لِنَهْضَةٍ تَرْقُبُهَا مِنكُمُ",4,"م",1,0],["إِنَّ القَليلَ الَّذي يَأتيكَ في دَعَةٍ","هُوَ الكَثيرُ فَأَعفِ النَفسَ مِن تَعَبِ",5,"ب",1,1],["إِنَّ القَصائِدَ يا أُخَيطِلُ فَاِعتَرِف","قَصَدَت إِلَيكَ مُجِرَّةَ الأَرسانِ",6,"ن",1,0],["إِنَّ القَصائِدَ قَد جازَت غَرائِبُها","ما بَينَ مِصرَ إِلى الأَجزاعِ مِن عَدَنِ",7,"ن",1,0],["إِنَّ القَصائِدَ قَد جَدَعنَ مُجاشِعاً","بِالسُمِّ يُلحَمُ نَسجُها وَيُنارُ",8,"ر",1,0],["إِنَّ القَصائِدَ قَد وَطِئنَ مُجاشِعاً","وَوَطِئنَ تَغلِبَ ما لَها مِن زاجِرِ",9,"ر",1,0],["إِنَّ القَصائِدَ لَن يَزَلنَ سَوائِحاً","بِحَديثِ جِعثِنَ ما تَرَنَّمَ ساري",10,"ر",2,0],["إِنَّ القَديمَ وَأَسلافاً تُعَدُّ لَكُم","نِعمَ القَديمُ إِذا ما عُدَّ وَالسَلَفُ",11,"ف",1,0],["إِنَّ القِرافَ بِمِنخَرَيكَ لَبَيِّنٌ","وَسَوادِ وَجهِكَ يا اِبنَ أُمِّ عِفاقِ",12,"ق",1,0],["إِنَّ القَتيلَ الَّذي جَرَّت بَنو قَطَنٍ","أَن سُبَّ قُرحانُ لا ذاكٍ وَلا عالي",13,"ي",1,0],["إِنَّ القَوافِيَ قَد أُمِرَّ مَريرُها","لِبَني فَدَوكَسَ إِذ جَدَعنَ عِقالا",14,"ل",2,0],["إِنَّ القُدورَ لَواقِحٌ","يُحلَبنَ أَمثَلَ ما رُعينا",15,"ن",2,0],["إن القبيحَ وإن صنَّعْتَ ظاهرَهُ","يعودُ ما لُمَّ منه مرةً شَعِثَا",16,"ث",2,0],["إن القريض الذي يخزَى بحائكه","ليَكتسي بك فخراً غير أطمار",17,"ر",1,0],["إِنَّ القَوافي كَالخَرائِدِ مِنعَةً","وَتَفوقُها في نَبذِ كُلِّ مُداجِ",18,"ج",1,0],["إِنّا لَقَومٍ لَنا مَجدٌ سَنَذكُرُهُ","ما دامَ فينا لِسانٌ ناطِقٌ وَفَمُ",19,"م",1,0],["إِنَّ القَضِيَّةَ تَغَط","طَت عَن سِوايَ فَكَيفَ عَنّي",20,"ن",2,0],["إِنَّ القَليلَ كَثيرٌ مِنكِ يَنفَعُني","وَما سِواهُ كَثيرٌ غَيرُ نَفّاعِ",21,"ع",1,0],["ان القضيب الذي تلهو يداك به","يكاد يخطف منه البرق ابصاري",22,"ي",1,0],["ان القوي ليبقى والحياة وغى","في البر في البحر في الاجواء في الغار",22,"ر",1,0],["ان القبور لا ولى بالألى عجزوا","عن الدفاع بدار الضيم فانتحروا",23,"ر",3,0],["انا لقوم راحلون الى التي","نجزى بها والدين احسن زاد",24,"د",1,0],["ان القميص به خروق جمة","فاذا رتقت فاي فتق ترتق",25,"ق",1,0],["إِنَّ القَديمَ ذَخيرَةٌ مِن صالِحٍ","تَبني المُقَصِّرَ أَو تَحُثُّ المُقتَدي",26,"د",2,0],["إِنَّ القُلوبَ وَأَنتَ مِلءُ صَميمِها","بَعَثَت تَهانيها مِنَ الأَعماقِ",27,"ق",1,0],["إِنَّ القَضاءَ إِذا رَمى","دَكَّ القَواعِدِ مِن ثَبير",28,"ر",1,0],["إِنَّ القَتيلَ مُضَرَّجاً بِدُموعِهِ","مِثلُ القَتيلِ مُضَرَّجاً بِدِمائِهِ",29,"ا",3,0],["إِنَّ القَريضَ شَجٍ بِعِطفي عائِذٌ","مِن أَن يَكونَ سَواءَكَ المَمدوحُ",30,"ح",1,0],["إِنَّ القَوافي لَم تُنِمكَ وَإِنَّما","مَحَقَتكَ حَتّى صِرتَ ما لا يوجَدُ",31,"د",1,1],["إِنَّ القَناني وَإِنَّ النَدى","تِربا اِصطِحابٍ وَأُخَيّا لِدَه",32,"د",2,0],["إِنَّ القَبائِلَ مِن نِزارٍ أَصبَهَت","وَقُلوبُها جَزَعاً عَلَيكَ حِرارُ",33,"ر",1,0],["إِنَّ القُصورَ بِجيلِ جَيلانَ الَّتي","أَعيَت مَعاقِلُها بَني الأَحرارِ",34,"ر",1,0],["إِنَّ القِيامَةَ قَد دَنَت أَشراطُها","حَتّى أُمَيَّةُ عَن فَزارَةَ تَنزِعُ",35,"ع",1,0],["إِنَّ القِرى سُجِنَت مَعي نيرانُهُ","عَن كُلِّ نازِلِ جَنبَةٍ وَدَخيلِ",36,"ل",1,0],["إِنَّ القَوافِيَ لَن يَرجِعنَ فَاِستَمِعوا","إِذا بَلَغنَ شِعابَ الغَورِ ذي القُنَنِ",37,"ن",1,0],["إِنّا لِقَومٌ ما نَرى ما لاقى","أَقَدَّ هاماً وَأَقَطَّ ساقا",38,"ق",2,0],["إِنَّ القَليلَ مِنَ الكَلامِ بِأَهلِهِ","حسَنٌ وَإِنَّ كَثيرَهُ مَمقوتُ",39,"ت",1,1],["إِنَّ القُلوبَ إِذا تَنافَرَ وُدُّها","شِبهَ الزُجاجَةِ كَسرُها لا يُشعَبُ",40,"ب",1,0],["إِنَّ القَريرَةَ عَينُهُ عَبدُ","خَشِيَ الإِلَهَ وَعَيشُهُ قَصدُ",41,"د",1,1],["إِنَّ القُنوعَ لَزادٌ إِن رَضيتَ بِهِ","كُنتَ الغَنِيَّ وَكُنتَ الوافِرَ العِرضِ",42,"ض",1,0],["إِنَّ القَناعَةَ بِالكَفافِ هِيَ الغِنى","وَالفَقرُ عَينُ الفَقرِ في الأَموالِ",43,"ل",1,0],["إِنَّ القُبورَ سُجونٌ","ما مِثلُهُنَّ سُجونُ",44,"ن",1,0],["إِنَّ القُلوبَ إِذا طَوَت أَسرارَها","أَبدَت لَكَ الأَسرارَ مِنها الأَوجُهُ",45,"ه",1,0],["إنِ أُلقِها تَتَلَقَّف كُلَّما صَنَعوا","إِذا أُتيتُ بِسِحرٍ مِن كَلامِهِمِ",46,"م",1,0],["إِنَّ القَوافي عِندَنا حَرَكاتُها","سِتٌّ عَلى نَسَقٍ بِهِنَّ يُلاذُ",47,"ذ",1,1],["إِنّا لَقَومٌ أَبَت أَخلاقُنا شَرَفاً","أَن نَبتَدي بِالأَذى مَن لَيسَ يُؤذينا",48,"ن",2,0],["إنّ القسنطينة الكبرى مُمَلَّكُها","قد اتّقى منك حدّ السيفِ بالقلمِ",49,"م",1,0],["إِنَّ القَصائِدَ يَمَّمَتكَ شَوارِداً","فَتَحَرَّمَت بِنَداكَ قَبلَ تَحَرُّمي",50,"م",2,0],["إِنَّ القِبابَ المُستَقِلَّةَ بَينَها","مَلِكٌ يَطيبُ بِهِ الزَمانُ وَيَكرُمُ",51,"م",1,0],["إِنَّ القَوافِيَ وَالمَساعِيَ لَم تَزَل","مِثلَ النِظامِ إِذا أَصابَ فَريدا",52,"د",2,0],["إنَّ القناديلَ بكمْ","زادتْ علوّاً وارتقا",53,"ق",2,1],["إنَّ القلوبَ إلى القلوبِ مشوقةٌ","قدْ أذكرتها بالرحيقِ السلسلِ",54,"ل",1,0],["إِنَّ القَتولَ تَقَتَّلَت","بِالدَلِّ لِلقَلبِ الرَهينِ",55,"ن",1,0],["إِنَّ القَضاءَ عَلى الشُعوبِ يُصيبُها","في حَقِّها الأَوفى لَغَيرُ جَميلِ",56,"ل",1,0],["إِنَّ القَضِيَّةَ ما عَلِمتُم فَاِحكُموا","فيها حُكومَةَ صادِقينَ عُدولِ",56,"ل",1,0],["إنّ القتيلَ لمن غرّته صَخرتُه","فَظنَّ أنّ رسولَ اللهِ مقتول",57,"ل",1,0],["إِنَّ القُلوبَ مَعَ العُيونِ إِذا جَنَت","جاءَت بَلِيَّتُها عَلى الأَجسادِ",58,"د",1,0],["إِنَّ القُلوبَ لَأَجنادٌ مُجَنَّدَةٌ","لِلَّهِ في الأَرضِ بِالأَهواءِ تَختَلِفُ",59,"ف",1,0],["إِنَّ القُفولَ إِلى حَيٍّ وَإِن بَعُدوا","أَمسَوا وَدونَهُمُ ثَهلانُ فَالنيرُ",60,"ر",1,0],["إِنِ القَولُ حَرَّفَهُ كاذِبٌ","فَإِنَّ القَضاءَ بِهِ ما اِنحَرَف",61,"ف",1,0],["إِنَّ القِيانَ وَشُربَ الراحِ مَفسَدَةٌ","مِن قَبلِ لَمكٍ وَقَينانٍ وَقابيلا",62,"ل",2,0],["إن القلوب من الغي","ظِ في الصدور لتغلي",63,"ل",2,0],["إِنَّ القُلوب إذا غدت","في الحُبِّ مترعة الحياضِ",64,"ض",1,1],["إن القوي جسور في تكلمه","ومن علامات ضعف القائل الوجل",65,"ل",1,0],["إن القلوب إذا لم يعترفن بما","منه تحس فلا تجدي البراهين",66,"ن",1,0],["إن القنوط من الأعمال مهلكة","ويل لمن هو من أَعماله قنطا",67,"ط",2,0],["إِنْ أَلْقَهُمْ أَتَغَالى فِي إِكْرَامِهِمْ","مُتَحَاشِياً إِبْدَاءَ الاِسِتصْغَارِ",68,"ر",1,0],["إن القصيدة ليس ما كتبت يدي","لكنها ما تكتب الأهداب",69,"ب",1,0],["إن القساورَ في المغاور تنقي","من يتقي الرحمنَ حقَّ تقاته",70,"ت",2,0],["إِنَّا لقَوم ليسَ يُمْحَى عارهُم","حتى يُرَى بدمائهم مغسولا",71,"ل",2,0],["إن القَرِيضَ بلا وزن وقَافِيَةٍ","خُنْثَى؛ فلا هو بالأُنثى ولا الرجل!",72,"ل",1,0],["إن القصورَ التي شاهَدْتَ ، قائمةٌ","على أساسٍ من الإجحافِ مُنهار",73,"ر",1,0],["أن ألقحت.........؟ تباركوها المسلمين","وأن أكسرت ....؟ خطو على ذاك الجدااار",74,"ر",1,0],["إنّ القَبَائِلَ مِنْ نِزَارٍ أصْبَحَتْ","وَقُلُوبُها، جَزَعاً عَلَيْكَ، حِرَارُ",75,"ر",1,0],["إنَّ القَتُولَ تَقَتَّلَتْ","بِکلدَّلِّ لِلْقَلْبِ الرَّهِين",76,"ن",1,0],["إِنَّ الْقَبَائِلَ أَضْرَمَتْ مِنْ جَمْعِنَا","يَوْمَ الذَّنَائِبِ حَرَّ مَوْتٍ أَحْمَسِ",77,"س",1,0],["إن القدود المأدبية","والعيون العجرمية",78,"ي",2,0],["إن القداسة لو تقي يا","شيخ من وقع السهام",79,"م",1,0],["إنّا لقوم إذا ما الحب خامرنا","للحب نوفي وإن لم نلق موفينا",80,"ن",2,0],["إن القريض الذي كانت مغلَّقةً","أبوابُه فتحت منها لنا السُّدَدُ",81,"د",1,0],["إنَّ القَوَافي طَوعِى مَن يُسَابِقنِي","في شَأوِهَا عَاقَه عَن شَأوِيَ الحَرَدُ",82,"د",1,0],["إِنَّ القَرابَةَ وَالمَوَدَّةَ أَلَّفا","بَينَ الوَليد وَبَينَ بِنتِ سَعيدِ",83,"د",1,0],["إن القناعة مذ خَطمتُ بحبلها","طمعى تساوت رحلتى ومقامى",84,"م",2,0],["إنَّ القوافى وإن جاشت غواربُها","لا يُستطاه بها تحويلُ أطوادِ",85,"د",1,0],["إِنَّ القَوافِيَ مُذ أَتَتكَ مَوادِحاً","أَمِنَت مِنَ الإِكداءِ وَالإِكذابِ",86,"ب",1,0],["إِنَّ القَوافِيَ وَهيَ غَيرُ مَلومَةٍ","مُذ أَصبَحَت دَأبي فَمَدحُكَ دابُها",87,"ب",3,0],["إِنَّ القَوافي لا عَدَتكَ مَوادِحاً","أَمِنَت بِكَ الإِخفاقَ وَالتَأثيما",88,"م",2,0],["إنَّ القلوب إذا اعتلت خواطرها","فذكر أحمد فيها المبرىء الآسي",89,"س",2,0],["أن القلوب على القلوب شواهد","والقلب أعدل حاكم وشهيد",90,"د",1,0],["أَنَّ القَضاءَ قاذِفي في هُوَّةٍ","لا تَستَبِلُّ نَفس مَن فيها هوى",91,"ا",1,0],["إِنَّ القُرُومَ السَوامي مِن بَني حَسَنٍ","يُحصى التُرابُ وَلا تُحصى أَيادِيها",92,"ي",3,0],["إن القلوب تألفت واستسلمتْ","طوعا إليك بعلمِها لا جهلها",93,"ل",3,0],["إن القلوبَ كأهلها ذكرٌ وأن","ثى كلُّ قلبٍ فيهِ من شهواتهِ",94,"ت",2,0],["إنَّ القرين هو النظير فإن تكن","حُرّاً فدونك صحبة الأحرار",95,"ر",1,0],["إِنَّ القُرَيَّةَ قَد تَبَيَّنَ أَمرُها","إِن كانَ يَنفَعُ عِندَكَ التَّبيينُ",96,"ن",1,0],["إن القويَّ يَرى أذاهُ عدالةً","أما الضعيفُ فلا يلاقي مُنقِذا",97,"ذ",2,0],["إنّ القلوبَ هي النجومُ تجاذُباً","ولكلِّ قلبٍ كوكبٌ سيّار",98,"ر",1,0],["إنّ القصورَ التي بِتنا نشيِّدُها","حقيرةٌ عندَ قبرٍ من قُبورِهم",99,"م",1,0],["إِنَّ القَناعَةَ لَم تَخلَع مَلابِسَها","إِلّا عَلى رَجُلٍ ناهيكَ مِن رَجُلِ",100,"ل",1,0],["إِنَّ القَيسِ عَلى عَهدِهِ","في إِرثِ ما كانَ بَناهُ حُجُر",101,"ر",1,0],["إن القناعة كنز ليس بالفاني","فاغنم هديت أخي عيشها الفاني",102,"ي",1,1],["إن القصيدة أنجزت واستنجزت","عرضا فكيف علي فيه تشير",103,"ر",1,0],["إِنّ القلوبَ عَلى اِختلافِ طِباعها","بِودادِ أحمَد كلّها معمورُ",104,"ر",1,0],["إنَّ القَنَاعَةَ مَن يحلل بِسَاحَتِهَا","لَم يَلقَ في دَهرِهِ شَيئاً يُؤرقهُ",105,"ق",2,0],["إِنَّ القَصائِدَ خَيرَها وَشِرارَها","مِثلُ المَناهِلِ عَذبَةٌ وَمِلاحُ",106,"ح",1,0],["إِنَّ القَناعَةَ ما عَلِمتَ غِنىً","وَالحِرصُ يورِثُ ذا الغِنى فَقرا",107,"ر",2,1],["إن القفول الذي أوفى بعيدين","مكرمين على الدنيا عزيزين",108,"ن",1,1],["إن القضايا تعاكست خطأً","نقيضها للعيان يَبذلُها",109,"ل",3,0],["إن القداسة والنفاسة والرضا","سيفٌ يجرَّد إن أردتَ ويغمد",110,"د",1,0],["إن القضاء لسيف لا يقاومه","شيء من الخلق إلا وهو محبوب",111,"ب",1,0],["إِنَّ القتالَ واجب","بَعدَ كليب الذاهب",112,"ب",1,1],["إِنَّ القداحَ أَمرُها عَجيبُ","الفَذُّ وَالتَوأَمُ وَالرَقيبُ",113,"ب",1,1],["إنَّ القوادِمَ بالخَوا","في والقَصائِدَ بالقوافي",114,"ف",2,0],["إن ألَقَهُ سرَّهُ قُربي وآنسَهُ","وإن أغِبْ صَدّ عَنّي مُعرِضاً ولَهَا",115,"ه",2,1],["إنَّ القوافي في مديحك لم تزلْ","تُثني عليك بلفظها ولسانها",116,"ن",3,0],["أن القناعة كنز لا مثيل له","يبدل العيش معسورا بميسور",117,"ر",1,0],["إن القيود وإن تفك ثقيلة","فلتطرحوها طرح من عاداكمو",118,"م",2,0],["أنّ القوارحَ أُخِّرتْ","وتقدّمتْ أمهارُها",119,"ر",3,0],["إن القوافي كالمطايا أنت را","كبها وهذا الجود خير عقال",120,"ل",1,0],["أنَّ القوافي زلزلت أقدامها","ورمت إليك حاومها بحصاتها",121,"ت",3,0],["إِنّا لَقَومٌ إِذا دَعا بِهِمُ","أَسيرُ خَطبٍ أَجابَهُ الفَرَجُ",122,"ج",1,1],["إِنَّ القَديمَ وَإِن جَلَّت رَزيئَتُهُ","يَنضُو فَيُنسَى وَيَبقَى الحادِثُ الأُنُفُ",123,"ف",1,0],["إن القلوب براكين مؤججة","العدل لا الجور يلجيها لإخماد",124,"د",1,0],["إنّا لَقومٌ تقُدُّ البيضَ أنصُلُنا","وما لَنا في لقاءِ البيضِ من قِبَلِ",125,"ل",1,0],["إن القيامة في بغداد قد وجدت","وحدها حين للإقبال إدبار",126,"ر",1,0],["إِنَّ القَرابَةَ مِنكَ يأمَلُ أَهلها","صلةً وَيأمن غلظَةً وَعقوقا",127,"ق",2,0],["إن القناعة في الدنيا هي الشرفُ","وغيرها عندنا التبذير والسرفُ",128,"ف",1,1],["إن القلوبَ إذا شكت جُرحَ الأسَى","فلها مِن الصَّبرِ الجميلِ مَراهمُ",129,"م",1,0],["إِنَّ القَوافي ذو تقِلُّ لِقَدر ِهِ","لِيَقِلُّ عَنها قَدرُ كُلِّ عَظيمِ",130,"م",1,0],["إن القريض إن أرسلت قد وصلا","فهيج الشوق حتى ثار واشتعلا",131,"ل",2,1]]}