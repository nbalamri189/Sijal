,""]],"verses":[["إِنَّ القُرى يَوماً سَتَه","لِكُ قَبلَ حَقِّ عَذابِها",0,"ب",3,0],["إِنَّ القَناعَةَ كَنزٌ كُنتَ حارِسَهُ","تَرى بِهِ القوتَ ياقوتاً وَمُرجانا",1,"ن",2,0],["إِنَّ القُدودَ عَلى تَأَوُّدِها","فَتكَت بِكُلِّ مُقَوَّمٍ لَدنِ",2,"ن",1,1],["إن ألقهم أتغال في إكرامهم","متحاشياً إبداء الاستصغار",3,"ر",1,0],["إِنَّ القُرَى مِنْ هَمِّهَا فَاعْلَمُوا","لِنَهْضَةٍ تَرْقُبُهَا مِنكُمُ",4,"م",1,0],["إِنَّ القَليلَ الَّذي يَأتيكَ في دَعَةٍ","هُوَ الكَثيرُ فَأَعفِ النَفسَ مِن تَعَبِ",5,"ب",1,1],["إِنَّ القَصائِدَ يا أُخَيطِلُ فَاِعتَرِف","قَصَدَت إِلَيكَ مُجِرَّةَ الأَرسانِ",6,"ن",1,0],["إِنَّ القَصائِدَ قَد جازَت غَرائِبُها","ما بَينَ مِصرَ إِلى الأَجزاعِ مِن عَدَنِ",7,"ن",1,0],["إِنَّ القَصائِدَ قَد جَدَعنَ مُجاشِعاً","بِالسُمِّ يُلحَمُ نَسجُها وَيُنارُ",8,"ر",1,0],["إِنَّ القَصائِدَ قَد وَطِئنَ مُجاشِعاً","وَوَطِئنَ تَغلِبَ ما لَها مِن زاجِرِ",9,"ر",1,0],["إِنَّ القَصائِدَ لَن يَزَلنَ سَوائِحاً","بِحَديثِ جِعثِنَ ما تَرَنَّمَ ساري",10,"ر",2,0],["إِنَّ القَديمَ وَأَسلافاً تُعَدُّ لَكُم","نِعمَ القَديمُ إِذا ما عُدَّ وَالسَلَفُ",11,"ف",1,0],["إِنَّ القِرافَ بِمِنخَرَيكَ لَبَيِّنٌ","وَسَوادِ وَجهِكَ يا اِبنَ أُمِّ عِفاقِ",12,"ق",1,0],["إِنَّ القَتيلَ الَّذي جَرَّت بَنو قَطَنٍ","أَن سُبَّ قُرحانُ لا ذاكٍ وَلا عالي",13,"ل",2,0],["إِنَّ القَوافِيَ قَد أُمِرَّ مَريرُها","لِبَني فَدَوكَسَ إِذ جَدَعنَ عِقالا",14,"ل",2,0],["إِنَّ القُدورَ لَواقِحٌ","يُحلَبنَ أَمثَلَ ما رُعينا",15,"ن",2,0],["إن القبيحَ وإن صنَّعْتَ ظاهرَهُ","يعودُ ما لُمَّ منه مرةً شَعِثَا",16,"ث",2,0],["إن القريض الذي يخزَى بحائكه","ليَكتسي بك فخراً غير أطمار",17,"ر",1,0],["إِنَّ القَوافي كَالخَرائِدِ مِنعَةً","وَتَفوقُها في نَبذِ كُلِّ مُداجِ",18,"ج",1,0],["إِنّا لَقَومٍ لَنا مَجدٌ سَنَذكُرُهُ","ما دامَ فينا لِسانٌ ناطِقٌ وَفَمُ",19,"م",1,0],["إِنَّ القَضِيَّةَ تَغَط","طَت عَن سِوايَ فَكَيفَ عَنّي",20,"ن",2,0],["إِنَّ القَليلَ كَثيرٌ مِنكِ يَنفَعُني","وَما سِواهُ كَثيرٌ غَيرُ نَفّاعِ",21,"ع",1,0],["ان القضيب الذي تلهو يداك به","يكاد يخطف منه البرق ابصاري",22,"ر",2,0],["ان القوي ليبقى والحياة وغى","في البر في البحر في الاجواء في الغار",22,"ر",1,0],["ان القبور لا ولى بالألى عجزوا","عن الدفاع بدار الضيم فانتحروا",23,"ر",3,0],["انا لقوم راحلون الى التي","نجزى بها والدين احسن زاد",24,"د",1,0],["ان القميص به خروق جمة","فاذا رتقت فاي فتق ترتق",25,"ق",1,0],["إِنَّ القَديمَ ذَخيرَةٌ مِن صالِحٍ","تَبني المُقَصِّرَ أَو تَحُثُّ المُقتَدي",26,"د",2,0],["إِنَّ القُلوبَ وَأَنتَ مِلءُ صَميمِها","بَعَثَت تَهانيها مِنَ الأَعماقِ",27,"ق",1,0],["إِنَّ القَضاءَ إِذا رَمى","دَكَّ القَواعِدِ مِن ثَبير",28,"ر",1,0],["إِنَّ القَتيلَ مُضَرَّجاً بِدُموعِهِ","مِثلُ القَتيلِ مُضَرَّجاً بِدِمائِهِ",29,"ا",3,0],["إِنَّ القَريضَ شَجٍ بِعِطفي عائِذٌ","مِن أَن يَكونَ سَواءَكَ المَمدوحُ",30,"ح",1,0],["إِنَّ القَوافي لَم تُنِمكَ وَإِنَّما","مَحَقَتكَ حَتّى صِرتَ ما لا يوجَدُ",31,"د",1,1],["إِنَّ القَناني وَإِنَّ النَدى","تِربا اِصطِحابٍ وَأُخَيّا لِدَه",32,"د",2,0],["إِنَّ القَبائِلَ مِن نِزارٍ أَصبَهَت","وَقُلوبُها جَزَعاً عَلَيكَ حِرارُ",33,"ر",1,0],["إِنَّ القُصورَ بِجيلِ جَيلانَ الَّتي","أَعيَت مَعاقِلُها بَني الأَحرارِ",34,"ر",1,0],["إِنَّ القِيامَةَ قَد دَنَت أَشراطُها","حَتّى أُمَيَّةُ عَن فَزارَةَ تَنزِعُ",35,"ع",1,0],["إِنَّ القِرى سُجِنَت مَعي نيرانُهُ","عَن كُلِّ نازِلِ جَنبَةٍ وَدَخيلِ",36,"ل",1,0],["إِنَّ القَوافِيَ لَن يَرجِعنَ فَاِستَمِعوا","إِذا بَلَغنَ شِعابَ الغَورِ ذي القُنَنِ",37,"ن",1,0],["إِنّا لِقَومٌ ما نَرى ما لاقى","أَقَدَّ هاماً وَأَقَطَّ ساقا",38,"ق",2,0],["إِنَّ القَليلَ مِنَ الكَلامِ بِأَهلِهِ","حسَنٌ وَإِنَّ كَثيرَهُ مَمقوتُ",39,"ت",1,1],["إِنَّ القُلوبَ إِذا تَنافَرَ وُدُّها","شِبهَ الزُجاجَةِ كَسرُها لا يُشعَبُ",40,"ب",1,0],["إِنَّ القَريرَةَ عَينُهُ عَبدُ","خَشِيَ الإِلَهَ وَعَيشُهُ قَصدُ",41,"د",1,1],["إِنَّ القُنوعَ لَزادٌ إِن رَضيتَ بِهِ","كُنتَ الغَنِيَّ وَكُنتَ الوافِرَ العِرضِ",42,"ض",1,0],["إِنَّ القَناعَةَ بِالكَفافِ هِيَ الغِنى","وَالفَقرُ عَينُ الفَقرِ في الأَموالِ",43,"ل",1,0],["إِنَّ القُبورَ سُجونٌ","ما مِثلُهُنَّ سُجونُ",44,"ن",1,0],["إِنَّ القُلوبَ إِذا طَوَت أَسرارَها","أَبدَت لَكَ الأَسرارَ مِنها الأَوجُهُ",45,"ه",1,0],["إنِ أُلقِها تَتَلَقَّف كُلَّما صَنَعوا","إِذا أُتيتُ بِسِحرٍ مِن كَلامِهِمِ",46,"م",1,0],["إِنَّ القَوافي عِندَنا حَرَكاتُها","سِتٌّ عَلى نَسَقٍ بِهِنَّ يُلاذُ",47,"ذ",1,1],["إِنّا لَقَومٌ أَبَت أَخلاقُنا شَرَفاً","أَن نَبتَدي بِالأَذى مَن لَيسَ يُؤذينا",48,"ن",2,0],["إِنَّ القَبائِلَ أَضرَمَت مِن جَمعِنا","يَومَ الذَنائِبِ حَرَّ مَوتٍ أَحمَسِ",49,"س",1,0],["إنّ القسنطينة الكبرى مُمَلَّكُها","قد اتّقى منك حدّ السيفِ بالقلمِ",50,"م",1,0],["إِنَّ القَصائِدَ يَمَّمَتكَ شَوارِداً","فَتَحَرَّمَت بِنَداكَ قَبلَ تَحَرُّمي",51,"م",2,0],["إِنَّ القِبابَ المُستَقِلَّةَ بَينَها","مَلِكٌ يَطيبُ بِهِ الزَمانُ وَيَكرُمُ",52,"م",1,0],["إِنَّ القَوافِيَ وَالمَساعِيَ لَم تَزَل","مِثلَ النِظامِ إِذا أَصابَ فَريدا",53,"د",2,0],["إنَّ القناديلَ بكمْ","زادتْ علوّاً وارتقا",54,"ق",2,1],["إنَّ القلوبَ إلى القلوبِ مشوقةٌ","قدْ أذكرتها بالرحيقِ السلسلِ",55,"ل",1,0],["إِنَّ القَتولَ تَقَتَّلَت","بِالدَلِّ لِلقَلبِ الرَهينِ",56,"ن",1,0],["إِنَّ القَضاءَ عَلى الشُعوبِ يُصيبُها","في حَقِّها الأَوفى لَغَيرُ جَميلِ",57,"ل",1,0],["إِنَّ القَضِيَّةَ ما عَلِمتُم فَاِحكُموا","فيها حُكومَةَ صادِقينَ عُدولِ",57,"ل",1,0],["إنّ القتيلَ لمن غرّته صَخرتُه","فَظنَّ أنّ رسولَ اللهِ مقتول",58,"ل",1,0],["إِنَّ القُلوبَ مَعَ العُيونِ إِذا جَنَت","جاءَت بَلِيَّتُها عَلى الأَجسادِ",59,"د",1,0],["إِنَّ القُلوبَ لَأَجنادٌ مُجَنَّدَةٌ","لِلَّهِ في الأَرضِ بِالأَهواءِ تَختَلِفُ",60,"ف",1,0],["إِنَّ القُفولَ إِلى حَيٍّ وَإِن بَعُدوا","أَمسَوا وَدونَهُمُ ثَهلانُ فَالنيرُ",61,"ر",1,0],["إِنِ القَولُ حَرَّفَهُ كاذِبٌ","فَإِنَّ القَضاءَ بِهِ ما اِنحَرَف",62,"ف",1,0],["إِنَّ القِيانَ وَشُربَ الراحِ مَفسَدَةٌ","مِن قَبلِ لَمكٍ وَقَينانٍ وَقابيلا",63,"ل",2,0],["إن القلوب من الغي","ظِ في الصدور لتغلي",64,"ل",2,0],["إِنَّ القُلوب إذا غدت","في الحُبِّ مترعة الحياضِ",65,"ض",1,1],["إن القوي جسور في تكلمه","ومن علامات ضعف القائل الوجل",66,"ل",1,0],["إن القلوب إذا لم يعترفن بما","منه تحس فلا تجدي البراهين",67,"ن",1,0],["إن القنوط من الأعمال مهلكة","ويل لمن هو من أَعماله قنطا",68,"ط",2,0],["إِنْ أَلْقَهُمْ أَتَغَالى فِي إِكْرَامِهِمْ","مُتَحَاشِياً إِبْدَاءَ 