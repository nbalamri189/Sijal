{"poems":[[55,"قليل من الخلان من لا تذمه","https://www.aldiwan.net/poem29759.html","الطويل"],[55,"تمنى رجال نيلها وهي شامس","https://www.aldiwan.net/poem30198.html","الطويل"],[49,"وظبي غرير في فؤادي كناسه","https://www.aldiwan.net/poem25267.html","الطويل"],[87,"سلام من صبا بردى أرق","https://www.aldiwan.net/poem24321.html","عموديه"],[87,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[63,"صدودك علم النوم الصدودا","https://www.aldiwan.net/poem51720.html","الوافر"],[63,"يريك قوامها الغصن الرطيب","https://www.aldiwan.net/poem51809.html","الوافر"],[107,"يقول أبو سفيان أودى محمد","https://www.aldiwan.net/poem44208.html","الطويل"],[83,"تجلى شهاب للسعادة آفل","https://www.aldiwan.net/poem61333.html","الطويل"],[214,"أيا حسنا قد حاز كل فضيلة","https://www.aldiwan.net/poem13394.html","الطويل"],[275,"أهزتك الحمية في الحميا","https://www.aldiwan.net/poem35287.html","الوافر"],[287,"لقد كنت من وشك الفراق أليح","https://www.aldiwan.net/poem32832.html","الطويل"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[382,"أجد يا راهبا سعيا","https://www.aldiwan.net/poem59169.html","مجزوء الوافر"],[422,"ليهنك ما بلغت من الأماني","https://www.aldiwan.net/poem54133.html","الوافر"],[457,"ألا مرحبا باقتبال الربيع","https://www.aldiwan.net/poem13766.html","المتقارب"],[458,"لماذا أعزي بل لماذا أهنىء","https://www.aldiwan.net/poem61308.html","الطويل"],[482,"رضيت بربقة العشاق حبسا","https://www.aldiwan.net/poem15212.html","الوافر"],[572,"شطت لليلى باللوى","https://www.aldiwan.net/poem69615.html","مجزوء الرجز"],[580,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"],[713,"","https://poetry.dctabudhabi.ae/diwan/poem/104863","الطويل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66967","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/39004","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38576","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38663","الوافر"],[1416,"","https://poetry.dctabudhabi.ae/diwan/poem/199206","الوافر"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42462","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109412","الطويل"],[2274,"","https://poetry.dctabudhabi.ae/diwan/poem/144757","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120994","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120724","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93599","الوافر"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140066",""],[402,"","https://poetry.dctabudhabi.ae/diwan/poem/141718","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74206","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100773","المتقارب"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89248","الطويل"],[3915,"","https://poetry.dctabudhabi.ae/diwan/poem/31424","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127125","الطويل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105131","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72788","الطويل"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99098","الوافر"],[5009,"إليك يابن الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=68819",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5121,"الْمِنْهَاجُ","https://www.poetsgate.com/ViewPoem.aspx?id=34716",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5392,"..للخيوط ذهولُ","https://www.poetsgate.com/ViewPoem.aspx?id=11293",""],[5413,"خذها من القلب ياصِدِّيقُ","https://www.poetsgate.com/ViewPoem.aspx?id=201374",""],[5477,"حمداً من ردّ أهل الزيغ والزلل","https://www.poetsgate.com/ViewPoem.aspx?id=124908",""],[6234,"الربيع الفاتن في نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6538&r=&rc=5",""]],"verses":[["فَمِن خائِفٍ عِندَ اللَيالي نُجيرُهُ","وَمِن شَعَثٍ بَينَ المَعالي نَلُمُّهُ",0,"م",2,0],["فَمِن خائِضٍ غَمرَ الرَدى غَيرَ ناكِصٍ","وَمِن صافِقٍ يَومَ النَدى لا يُماكِسُ",1,"س",1,0],["فَمِن خَلقِهِ لِبّاتُها وَنُحورُها","وَمِن خُلقِهِ عِصيانُها وَنُفورُها",2,"ر",3,0],["فَمِن خِدَعِ السِياسَةِ أَن تُغَرّوا","بِأَلقابِ الإِمارَةِ وَهيَ رِقُّ",3,"ق",1,0],["فَمِن خَلفِها طَوراً وَحيناً أَمامَها","وَآوِنَةً مِن كُلِّ أَوبٍ تَأَلَّبُ",4,"ب",1,0],["فمِنْ خَدٍّ يُصافِحُ فيه خَدّاً","ومن جيدٍ يُعانِقُ فيه جِيدَا",5,"د",2,0],["فمن خدٍّ تخدِّدُه دموعٌ","ومن قلبٍ يُقلِّبُهُ حبيبُ",6,"ب",1,0],["فَمن خاف منكم أن يعودَ إلى الوغى","فذا مغزلي وليعطني السَّيفَ ماضيا",7,"ي",2,0],["فَمَن خَذلَتهُ في الحُرُوبِ جُنُودُهُ","فَأنتَ الَّذِي الأعدَاءُ عَنهُ تُنَاضِلُ",8,"ل",1,0],["فمن خاطري لم بطو نشر حديهم","وذلك اني لم احل عن طويتي",9,"ي",1,0],["فمِن خَمرين في كأسٍ وعَينٍ","شربتُ وقد طوَيتُ الهمَّ طيا",10,"ي",2,0],["فَمِن خَطِّهِ يَقري العُيونَ حَلاوَةً","وَتُقرَأُ مِن شَرحِ الصُدورِ شُروحُ",11,"ح",1,0],["فَمِن خجلٍ يثني الصرائمَ رهبة","وَمِن جذلٍ قد كاد يهفو بها رغبا",12,"ب",2,0],["فمن خبثٍ إلى زورٍ","إلى كذبٍ بلا استِحيا",13,"ي",2,0],["فمن خضرٍ ومن صُفرٍ وحُمرٍ","كأمثال الشقيق الأرجواني",14,"ن",2,0],["فمن خلقه نسمات البكور","سرت بمكاسر نوّارهِ",15,"ر",2,0],["فمن خانه خان النبي محمدا","ومن خانه لا بد يشقى ويرزأ",16,"ا",1,0],["فمَنْ خالَ الهوى سهلاً فدعْهُ","لقد ترِبَتْ يداه وخابَ حَدْسا",17,"س",2,0],["فَمِنْ خَلَنْجِيِّ كَمِثْ","لِ العَضْبِ مَوْمُوقِ الخُطَطْ",18,"ط",1,0],["فمِنْ خوفهِ يستغفِر الدَّهرُ ذنْبه","ومِنْ بأْسِه يسْتذْئِب الأَسدُ الوَرْدُ",19,"د",1,0],["فمن خصره ضعفي وحتفي بعينه","وقلبي خفوق حيثما خفق القرط",20,"ط",1,0],["فمن خُدُودٍ قَمَرِيّاتٍ","على قُدُوْدٍ غُصُنِيَّاتِ",21,"ت",1,0],["فَمن خلقه عَفوٌ وَحلمٌ وَرحمَة","وَعِتق وَإِحسان يَدومُ مُؤَبّدا",22,"د",2,0],["فَمِن خَوفِه يَبكي دُموعاً غَزيرَةً","وَيَسري يهابُ الصّوتَ وَالسّيفُ مُصلَتُ",23,"ت",1,0],["فَمِن خَجَلٍ بِذاكَ بدا مُزيلا","عَنِ الشّمسِ الكواكبَ بِالهِلالِ",24,"ل",1,0],["فمِن خِلّ يُراوِحُني بخَلٍّ","ومِن عَمٍّ يغاديني بغَمِّ",25,"م",1,0],["فمنْ خوفهِ الإنسانُ يصبحُ ناصباً","شياكاً لصيدِ القوتِ أنواعُها تَترى",26,"ر",2,0],["فمن خده القاني واس عذاره","جنى الورد غضاً ناظري والبنفسجا",27,"ج",2,0],["فمن خلقه لم تلق أحسنَ مظهراً","سوَى مضمرٍ من خُلْقِهِ والعزائمِ",28,"م",1,0],["فمن خطّها الباهي متاعٌ لناظري","وسمعي وحظُّ الروح من حظّها الباقي",29,"ق",2,0],["فمن خطِّها الفاني متاع لناظري","وسمعي وحظ الروح من حَظّها الباقي",30,"ق",2,0],["فمن خَلف الخمار تَشف نُورا","وَلَو مِن شعرها لاثَت خِمارا",31,"ر",2,0],["فمن خزام جآ في حلة","من لازورد كنبات العذار",32,"ر",1,0],["فَمن خَبيثٍ لَهُ نَفسان واحِدَةٌ","مِنَ العَجينِ وَأُخرى دُونَها الحجَرُ",33,"ر",1,0],["فَمِن خضركم تَخضر يابسة الفَلا","وَيحمَد من عَبد الكَريم جُدودها",34,"د",3,0],["فمن خائن يستحق الردى","اذا عاقبوه ومن غادر",35,"ر",1,0],["فمن خلقٍ عذبٍ ومجدٍ مؤثَّلٍ","ربا عَرفِه تزكو على طيبها عرفا",36,"ف",2,0],["فَمِن خَيرى بَني عُلوي اِنشَعَبنا","فَطَيبَةُ مَسكِني وَبِها قَراري",37,"ر",2,0],["فمن خرافٍ وثيارٍ غر","هالعةٍ تحقق عند النحر",38,"ر",1,0],["فمن خوفه فرت عداك بأسرها","فرار بغاث الطير من هيبة الطير",39,"ر",1,0],["فمن خديك في كبدي لهيب","ومن جفنيك في جسدي كلوم",40,"م",1,0],["فمِن خلَدٍ لم يبقَ إلا نسيسُهُ","ومن شبحٍ لم تبقَ إلا رسومهُ",41,"م",2,0],["فمن خضعت له الأسد الضواري","ترقّع عن مراوغة الذئاب",42,"ب",1,0],["فمن خطا خطوة في الخير يجز به","مادام لله صدقاً قد سعا وخطا",43,"ط",2,0],["فمن خشي السوء لسوءاء هاجراً","يفز وهنا أيضاً لديه هناء",44,"ا",2,0],["فَمَنْ خَاضَ دَرْبَ الْخَيْرِ ذَاقَ نَعِيِمَهُ","وَنِقْمَةُ زَقُّومٍ لِشَرٍّ تَهَرَّعَا",45,"ع",2,0],["فمن خلل كانوا عليه مناقضاً","لتجريد توحيد العبادة لو عقل",46,"ل",1,0],["فمنْ خببٍ أدْمى إلى خببٍ نما","إليكَ شكاة النجم حينَ يؤولُ",47,"ل",1,0],["فمنْ خلا منهُ -مهما قيلَ- ليسَ لهُ","شيْئٌ يُحَبَّذُ بين العرب والعجم",48,"م",1,0],["فمن خروص إذا ما شئت نسبته","من يحمد جائت العليا على عجل",49,"ل",1,0],["فمن خزامى إلى رند يضوع بما","يشفي الصدور ويقضي الهم محروبا",50,"ب",2,0]]}