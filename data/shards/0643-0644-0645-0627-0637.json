{"poems":[[74,"بين أجفان ابن عمرو وسواد","https://www.aldiwan.net/poem18929.html","المديد"],[93,"ليس يدري الهم غير المبتلي","https://www.aldiwan.net/poem9064.html","عموديه"],[87,"مال واحتجب","https://www.aldiwan.net/poem63725.html","مجزوء المتدارك"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85379","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[112,"أحسد الاغبيا","https://www.poetsgate.com/ViewPoem.aspx?id=8403",""],[326,"سكن الليل والأماني عذاب","https://www.aldiwan.net/poem26685.html","عموديه"],[333,"هو ناي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[369,"شام برقا من أقاصي الشآم","https://www.aldiwan.net/poem60641.html","المديد"],[463,"سأَلت ظبية ما هذا النحول","https://www.aldiwan.net/poem55929.html","المتقارب"],[463,"ما جد السعي أتاه ما سعى له","https://www.aldiwan.net/poem55933.html","الرمل"],[466,"علقته والصبا غض الأديم","https://www.aldiwan.net/poem15087.html","الرمل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104600","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70791","الخفيف"],[1165,"","https://poetry.dctabudhabi.ae/diwan/poem/101334","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79843","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53052","الخفيف"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70316","المقتضب"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104671","الرمل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138563",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91733","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29274","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40125","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81282","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81278","الرمل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73124","الرمل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73429","الرمل"],[4797,"سولفوا","https://www.poetsgate.com/ViewPoem.aspx?id=29424",""],[4802,"لعن أبوها","https://www.poetsgate.com/ViewPoem.aspx?id=34420",""],[4805,"هجينيه 1","https://www.poetsgate.com/ViewPoem.aspx?id=176593",""],[5055,"في رحيل","https://www.poetsgate.com/ViewPoem.aspx?id=177467",""],[5111,"غَفْوَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212512",""],[5155,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=176566",""],[5186,"ما اضطهاد الذين يثني اللواتي","https://www.poetsgate.com/ViewPoem.aspx?id=156493",""],[5232,"الأخطل الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=213530",""],[5455,"بايعها","https://www.poetsgate.com/ViewPoem.aspx?id=35124",""],[5455,"صمت المكان","https://www.poetsgate.com/ViewPoem.aspx?id=34700",""],[5573,"فاز بالخير بادي يوم يقري سلام","https://www.poetsgate.com/ViewPoem.aspx?id=202543",""],[5670,"جئتُ يا شِعري","https://www.poetsgate.com/ViewPoem.aspx?id=211123",""],[5756,"اثنا عشر شهر","https://www.poetsgate.com/ViewPoem.aspx?id=5433",""],[5756,"الذهب","https://www.poetsgate.com/ViewPoem.aspx?id=5187",""],[5950,"السماء لا تطيحَ","https://www.poetsgate.com/ViewPoem.aspx?id=128124",""],[572,"من ترى ينصفُني من خَليلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9428&r=&rc=285",""]],"verses":[["كلما طافَ على الصبّ غنى","إسقنيها يا سواد بن عمرو",0,"و",1,0],["كُلَّما طالَعتُ خَطباً جَلَلاً","جاءَني الدَهرُ بِخَطبٍ جَلَلِ",1,"ل",1,0],["كُلَّما طَغى","راضَها الحَسَب",2,"ب",1,0],["كُلَمّا طال خوطها بشرت قَل","بي بقرب اتساقه العينان",3,"ن",1,0],["كلّما طارَ خَلفَهُنَّ تَسَرَّبْنَ","هَباءً في غَيْهَبِ النسْيانِ",4,"ن",1,0],["كل ماطرّقت قلبي للهوا ... المستسهي","هبّة أرياح الزمان .. وصككت بيبانه",5,"ن",2,0],["كُلَّما طالَ بُعدُنا زِدتُّ قُرباً","يجمعُ الحَرفُ بيننا والخِطاب",6,"ب",1,0],["كلّما طار بنجواهُ إلى","المجهول لحنُ",7,"ن",1,0],["كُلّما طولبَ بالقَطْرِ وَهْناً","وهْو لا يَملِكُ غيرَ ابْتسام",8,"م",1,0],["كلما طامنَ منها كَفلٌ","مُرْدَفٌ أشرفَ هادٍ وتليلُ",9,"ل",1,0],["كلّما طال به ميدانُهُ","تمّ بالبعد وأجرَى في الإطالَهْ",10,"ل",2,0],["كلما طولعَ حالت دونهُ","سورة المقدار لا بأس الخصوم",11,"م",1,0],["كلّما طرّبَ الهزارُ هديلاً","حنّتِ الورقُ مِن شجاهُ الشّجيِّ",12,"ي",1,0],["كلما طار طائر بجناحيْ","ه وما ناقضَ الضياءُ الظلاما",13,"م",2,0],["كلما طالبته الوصل أبى","قلت ما ضرك لو واصلتني",14,"ي",1,0],["كلّما طلّه الحيا بنداه","رشَّ ماءً فبلَّ فيه القلوبا",15,"ب",2,0],["كلما طاردته خيل غرامٍ","رُحْنَ عنه وصبره مغلوبُ",16,"ب",1,0],["كلما طلبتُ رِضاً","بالوصال لم أَجدِ",17,"د",1,0],["كُلَّما طَرَّزَ أَثوابَ الدُجى","نَسجُهُ أَلبَسَني ثَوبَ الضَنى",18,"ن",2,0],["كلما طال المدى تحسبه","نصب عينيك وقوعاً لا سماعا",19,"ع",2,0],["كُلما طالَت اللَيالي وَجادَت","قُلت علّ اللقا وَتسعد علا",20,"ل",2,0],["كُلَّما طافَها الفَناءُ بِصَوتٍ","رَفَعَت قَلعَها لَهُ إِرهافا",21,"ا",1,0],["كُلُّما طَنَّ ذِكْرُهَا منه في الس","سَمعِ يكمَى في النَّافِقاء نِفاقُه",22,"ق",2,0],["كُلَّما طَوق الكَنانَة عِلماً","خَوَلَتنا مِنهُ رَوافد تَتَرى",23,"ر",2,0],["كُلَّما طارَ بِها العُ","ود وَفراها المَغني",24,"ن",2,0],["كلَّما طافَ بها السَّاقي تَرى ال","شمسَ بالبدرِ علينا تُقرَنُ",25,"ن",1,0],["كُلَّما طالَت عَليهِ ليلَةٌ","صاحَ من فَرطِ جَوىً أَشغَلَهُ",26,"ل",2,0],["كل ما طروه لو هم يمزحون ..",".. احرموني من غداي ومن عشاي",27,"ا",2,0],["كل ماطالع عليها مستهام","قلت ياربي دخيلك صونها",28,"ن",3,0],["كل ماطرتلي ابزعجله","شوق ٍ امفيّض اببيتيني",29,"ن",2,1],["كلما طال السفر عدة الحساب","أتذكر بوح عينك والهدب",30,"ب",1,0],["كُلَّمَا طَافَتْ بِحُلْمِيْ","نَاشَدَ الْقَلْبُ هَوَاهَا",31,"ا",3,0],["كلما طافت الخمائل نجواه","تمشي بها الصبا والنماء",32,"ا",2,0],["كل ما طاب لا يطيب بلاها","كل آت من دونها غير آت",33,"ت",1,0],["كلما طرتُ إلى زهر الهوى","يخفقُ القلبُ ، فأخشى أن يطيرْ",34,"ر",1,0],["كل ما طعنّي زماني رحت ادلّعها","يوم الزمن ما ترك لي غير اياديها",35,"ي",3,0],["كل ماطابت هجوسي .. رحت اسولف للزوايا","عن فتاة ٍ كان يملى صوتها صمت المكان",36,"ن",1,1],["كل ماطال صمته في حظور الانام","بين طول الليالي والنهار الطويل",37,"ل",1,0],["كلما طافتْ بعقلي فكرةٌ","جاءت الفوضى فباءت بالممات",38,"ت",1,0],["كل ماطلت الحقيقة وامتلا قلبي سرور","طاولتني من عذولي طعنة وسط الظهر",39,"ر",1,0],["كل ما طرالي منظر مريب وارتاب","كان الوحيد اللي يحرك شجوني",40,"ن",2,0],["كل ما طاح نجم من السما قلت خير","يستر الله بس إن السما ما تطيح",41,"ح",1,1],["كلّما طَافَ بهِ العاذِلونَ","لجّ به في سرعة ٍ بالقُبُولِ",42,"ل",1,0]]}