{"poems":[[65,"من الركب يا بن العامري أمامي","https://www.aldiwan.net/poem46178.html","الطويل"],[79,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[88,"لقد عاشرتنا فلبثت فينا","https://www.aldiwan.net/poem68905.html","الوافر"],[47,"جدد بكاء لبين جديد","https://www.aldiwan.net/poem63514.html","المتقارب"],[47,"سرى من خيال المالكية ما سرى","https://www.aldiwan.net/poem63587.html","البسيط"],[63,"ثنت لك أعطافها والخصورا","https://www.aldiwan.net/poem51673.html","المتقارب"],[82,"ننام من الأيام في غرض النبل","https://www.aldiwan.net/poem31332.html","الطويل"],[82,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[13,"بحليلة البجلي بت من ليلها","https://www.aldiwan.net/poem2215.html","الكامل"],[47,"جَدَّد بُكاءَ لبَينٍ جَدِيدْ","https://www.poetsgate.com/ViewPoem.aspx?id=31393",""],[95,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[371,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[382,"ألا يا أيها الخل الوفي","https://www.aldiwan.net/poem59168.html","الوافر"],[556,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38984","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38361","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38659","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38983","الطويل"],[1138,"","https://poetry.dctabudhabi.ae/diwan/poem/100657","السريع"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50017","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128705","الطويل"],[2085,"","https://poetry.dctabudhabi.ae/diwan/poem/202201","الخفيف"],[2162,"","https://poetry.dctabudhabi.ae/diwan/poem/96043","الخفيف"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126231","المتدارك"],[2822,"","https://poetry.dctabudhabi.ae/diwan/poem/131387","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65134","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65126","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132615","الرجز"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132789","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89069","السريع"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123924","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48378","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91095","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72779","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72625","الطويل"],[4578,"يا قوت خد بريحان العذار بدا","https://www.poetsgate.com/ViewPoem.aspx?id=49404",""],[4859,"بئر روحك","https://www.poetsgate.com/ViewPoem.aspx?id=207371",""],[4881,"نصائح","https://www.poetsgate.com/ViewPoem.aspx?id=181833",""],[4935,"بدت كالعين بالعين","https://www.poetsgate.com/ViewPoem.aspx?id=129334",""],[4968,"تعويذة العشق","https://www.poetsgate.com/ViewPoem.aspx?id=208104",""],[4988,"رحيلي وحلّي","https://www.poetsgate.com/ViewPoem.aspx?id=198227",""],[5237,"هذي رياح اليمن هب نسيمها","https://www.poetsgate.com/ViewPoem.aspx?id=113116",""],[5274,"البردوني وعروبة اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=203259",""],[307,"العيون الملاح","https://www.poetsgate.com/ViewPoem.aspx?id=214158",""],[5510,"مرايا الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=206318",""],[5725,"على جيدك المصقول","https://www.poetsgate.com/ViewPoem.aspx?id=177422",""],[5561,"حلو الكلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86130&r=&rc=4",""],[6289,"دِمّشْقْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81753&r=&rc=5",""]],"verses":[["بحِلْمٍ إذا الخَطْبُ استُطيرَتْ لهُ الحُبا","رَماهُ برُكْنَيْ يَذْبُلٍ وشَمامِ",0,"م",1,0],["بِحُلَى عُلاَكَ أَطَلْتُهَا وَأَطَبْتُهَا","وَلَكَمْ مُطِيلٍ وَهْوَ غَيْرُ مُطِيبِ",1,"ب",1,0],["بِحِلمٍ كانَ مَحمودَ المَزايا","وَعَدلٍ كانَ مَمدودَ الظِلالِ",2,"ل",1,0],["بِحَلٍّ وَعَقدٍ وَعَزمٍ وَفَضلٍ","وَنَيلٍ وَبَذلٍ وَبَأسٍ وَجودِ",3,"د",1,0],["بِحِلمٍ كَأَنَّ الأَرضَ مِنهُ تَوَقَّرَت","وَجودٍ كَأَنَّ البَحرَ مِنهُ تَفَجَّرا",4,"ر",2,0],["بحُلَّةِ وَرْدٍ إذا رَدَّها","على الشَّرْبِ عاوَدَها مُستَعيرا",5,"ر",2,0],["بحلمكَ تعفُو عن تَعَاظُمِ زَلّتي","وفضلك عن نقصي وحلمك عن جهلي",6,"ل",2,0],["بِحَلاوَةِ اسمِك للمَنونِ مَرارةً","طُرِحَتْ بِعَذْبِ الوِرْدِ للورّادِ",7,"د",1,0],["بِحَليلَةِ البَجليِّ بِت مِن لَيلِها","بَينَ الإِزارِ وَكَشحِها ثُمَّ اِلصَقِ",8,"ق",1,1],["بِحَلٍّ وقْدٍ وَحَزْمٍ وفضلٍ","ونَيَلٍ وبذل وبَأسٍ وَجُودْ",9,"د",1,0],["بِحَلْيٍ وَلَمْ تُصْلَحْ بِطَلْيٍ ولاَ صَقْلٍ","ضرُوبُ جَمالٍ لَوْ رَأَتْهَا أَميرَةٌ",10,"ه",1,0],["بِحِلمٍ بِلا ضَعفٍ وَحُكمٍ بِلا هَوىً","وَفَتكٍ بِلا ذُعرٍ وَجودٍ بِلا عُذرِ",11,"ر",1,0],["بحلِّكَ مشكلاتٍ ذات قدر","بها إنجيلُنا أبداً رضي",12,"ي",1,0],["بحُلومٍ مثل الصُّخورِ رِزانٍ","ووجوهٍ مثلَ البُدورِ تَمامِ",13,"م",1,0],["بِحلّة أَوصافٍ تَجلّ حميدة","بِحُسنِ خِصالٍ صاحبت رفعة القدرِ",14,"ر",1,0],["بِحلم فَما حلمُ اِبن قَيسٍ فَبالغوا","عَنِ البحرِ بِالتحديثِ فَالبحرُ واسعُ",15,"ع",1,0],["بِحلَّةِ حُسنٍ في سَريرِ مَحاسِنٍ","بِعَرشِ دَلالٍ بِالكَمالِ قِيامُهُ",16,"م",2,0],["بِحُلّة آدابٍ بِثَوبٍ مِنَ التّقى","وَمِنك لَهُ الإِخلاصُ قَد كانَ حايِكا",17,"ك",2,0],["بحلمه أدركتُ ما اشتهي","وقد كفاني الله شرَّ الفضا",18,"ض",2,0],["بحلم بلا ضعف وقولٍ بلا خنا","وصمتٍ بلا عيٍّ ويسرٍ بلا هزلِ",19,"ل",1,0],["بحلق كل حول أعداء دينه","ولم يلف خلف النفر منهم مقصر",20,"ر",1,0],["بحلوم رواجح وبهاء","واقتدار على الأمور الصعاب",21,"ب",1,0],["بُحلومٍ إذا الحلوم تَقضَّت","ووجوهٍ مثل الدنانيرِ مُلسِ",22,"س",1,0],["بِحَلاَلَتَِها تُرجى صَمَداً","هو مَنجَانَا صمداً سندا",23,"د",2,0],["بحلمك فاقبل توبتي وتولني","بفضلك واجعل لي جنابي ممرعا",24,"ع",2,0],["بحلم وعدل خص هذا لمن جنى","وهذا لجرح النائبات مراهم",25,"م",1,0],["بحلّة ملك أهديت من خليفة","إمام البرايا مصطفى قامع الشّرك",26,"ك",1,0],["بحلية الحسن تحلت فغدت","تميس في وشي الجمال الباهر",27,"ر",1,0],["بحلمه والندى موصوف","قد ساد بالجود في الأجواد",28,"د",1,0],["بحلول عبد اللَه يا حبذا","ابن محمد بن عون الجواد",29,"د",1,0],["بحلم اذا اشتد البلا غير طايش","وعزم إذا الداعي دعي غير رايث",30,"ث",1,0],["بحُلا يوسُفٍ وغُرّ صِفاتي","يُهْتَدى للصِّلات أو للصّلاةِ",31,"ه",1,1],["بحلم وَعلم واحتكام وَحكمة","تَجلّى فَلا بَطش يَشين وَلا عَفو",32,"و",1,0],["بحلبةِ مجدٍ عادياتٍ بصبحِها","فهم عجبٌ للحسنِ والجرى جُمَّعُ",33,"ع",1,0],["بحلة خدَّيه العذار قد أزدرى","بحسن اخضرار في سواعد عراقه",34,"ه",1,0],["بحلية المسك قد أحييت سنة من","أولى البريّة منه بالتقى رشدا",35,"د",2,0],["بح لي بسرّك إنّي اليوم مخبؤه","ولاتخف أذنا للآه تستمعُ",36,"ع",1,0],["بحلْمٍ تَخَلَّقْ ،ربما سوف تلتقي","صفيقاً يقول القولَ لا يتَلَطَّفُ",37,"ف",1,0],["بحلوان الصفا تجلى","بحلى صيغ من عين",38,"ن",1,0],["بح للّقاءِ بوردٍ في منادمة","تلق الفؤاد انتشى في أفخر النّزل",39,"ل",1,0],["بحلوقهم واقف ولا أحسب آ حساب","لآا من حظرت احظر وجاهز محلّي",40,"ل",2,0],["بحلول مولد أحمد قد بشرت","فاستنشقت ندا وتم نعيمها",41,"م",3,0],["بُحْ لي بِماشِئتَ لا لومٌ ولا عَتَبُ","ولا يضقْ بقريضي صدْرُكَ الرحبُ",42,"ب",1,1],["بُحْ لي بِماشِئتَ وارْحَلْ بالحَنِينِ إلى","مرَابِعٍ أبْحَرَتْ منْ رَمْلها الشهُبُ",42,"ب",1,0],["بُحْ لي بِماشِئتَ هذا اللحنُ تعْرِفهُ","ولاتسلْ كيْفَ تَنْسَى ثأرها العَرَبُ؟",42,"ب",1,0],["بحُلاك قد فقتَ البهاءَ بحسنه","وبك استحقّ سنا الجمال وساما",43,"م",2,0],["بح لي بهمك يا نايا بقافيتي","ولا تكن فيه لحنا ناشزا يثبُ",44,"ب",1,0],["بحلم كأنّ الدهر اعمى جفونه","وما فلقُ الاصباح في العين حسحسا",45,"س",2,0],["بحلو الكلام خلود الحياة","وليس بقول معاد غبي",46,"ي",1,0],["بِحُلَّةٍ مِنْ نَضاراتٍ مُطَرَّزَةٍ","لَمْ تُكْسَها في رِحابِ الأرْضِ أَوْطانُ",47,"ن",1,0]]}