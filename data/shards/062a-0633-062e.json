{"poems":[[55,"أيا لله أي هوى أضاء","https://www.aldiwan.net/poem30781.html","الوافر"],[95,"يا غرباء الحمى سلاما","https://www.aldiwan.net/poem11291.html","مخلع البسيط"],[85,"طلع الهلال وأفقه متهلل","https://www.aldiwan.net/poem54255.html","الكامل"],[74,"الحمد لله على إنعامه","https://www.aldiwan.net/poem19685.html","المنسرح"],[80,"أيا ملكا يجل عن الضريب","https://www.aldiwan.net/poem14153.html","الوافر"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[240,"سقاك سار من الوسمي هتان","https://www.aldiwan.net/poem31744.html","البسيط"],[266,"يا جامع الصدر الوزير الذي","https://www.aldiwan.net/poem38172.html","السريع"],[318,"ما بال نفس تطيل شكواها","https://www.aldiwan.net/poem59508.html","المنسرح"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[369,"حلفت بالساعين يوم الموقف","https://www.aldiwan.net/poem60837.html","الرجز"],[371,"أخرج حديثك من سمعي وما دخلا","https://www.aldiwan.net/poem17081.html","البسيط"],[463,"دعها تكن كالسلف من أخواتها","https://www.aldiwan.net/poem56263.html","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77667","الرجز"],[5334,"إلى اللهِ أشكو أنَّ قلبي معلَّقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=96974",""],[5348,"صوت من الصف الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=59563",""],[402,"يا غرباء الحمى سلاما","https://www.poetsgate.com/ViewPoem.aspx?id=36423",""],[5956,"أوَ ما نخجل من أنفسنا؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=194418",""]],"verses":[["تَسَخَّطنا القَضاءَ وَلَو عَقَلنا","فَما يُغني تَسَخُّطُنا القَضاءَ",0,"ا",2,0],["تَسْخُونَ بِالأَنْفُسِ الغَوَالِي","سَخَاءَ مَنْ يَبْذُلُ الحُطَامَا",1,"م",2,0],["تسخو الغمام ووجهها متجهم","والوجه منه مع الندى يتهلّلُ",2,"ل",1,0],["تسخو لنا بالعيان وابن دقي","ق العيد طيف يسخو بألمامه",3,"م",2,0],["تَسَخّطك المُمِضُّ أَعَلَّ نَفسي","وَما لي غير عفوِكَ من طَبيبِ",4,"ب",1,0],["تسخَر الريحُ بالضعيفِ من النَّب","تِ وتخشَى القويَّ من باسقاتهْ",5,"ت",2,0],["تَسخو بِكُلِّ نَفيسٍ نَفسُهُ وَيَرى","أَنَّ النَفائِسَ لِلعَلياءِ أَثمانُ",6,"ن",1,0],["تسخر بالناثر أوصافه","الحسني وتاريخك بالناظم",7,"م",1,0],["تسخطه في رضا بريته","تباً له ما أجل يلواها",8,"ا",3,0],["تسخّرهُم شهوات الحضيض","ويخنقهم جشَعُ الطينة",9,"ه",1,0],["تَسخو لأبناءِ الزّمانِ كفُّه","بكُلِّ عَفْوٍ قَبلَه لم يُعْرَف",10,"ف",1,0],["تَسخو بِعَذلي وَعُذّالي عَلى عَذلي","هُمُ الكِرامُ وَأَحبابي هُمُ البُخَلا",11,"ل",2,0],["تسخو به لك من نَخيلةِ سرها","نفسٌ تَرى بك ما تَرى بحياتِها",12,"ت",3,0],["تَسخَرُ بي وَقَد تَلاشى جَلدي","لِفَقد زَوجَتي وَأُمِّ وَلدي",13,"ي",1,0],["تسخَّطُ ما يُرضَى وتخرَقُ بالأذَى","وليس بِناهيها لِحايةُ لاحِ",14,"ح",1,0],["تَسخُو بروحِكَ للخُلودِ مَطيّة","وحُبِيتَ حظّاً في الخلودِ ضَئيلا",15,"ل",2,0],["تسخون بالنفس الغوالي","سخاء من يبذل الحطاما",16,"م",2,0],["تسخر الصهيون منا إنْ فُصِلنا","أو توحَّدنا وتدري ما يجِبْ",17,"ب",1,0]]}