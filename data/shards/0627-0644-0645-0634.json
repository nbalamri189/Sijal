{"poems":[[95,"إن ينتقل أغناطيوس الثاني","https://www.aldiwan.net/poem11262.html","الكامل"],[95,"أدعو القريض فيعصي بعد طاعته","https://www.aldiwan.net/poem11272.html","البسيط"],[49,"أي اصطبار ليس بالزائل","https://www.aldiwan.net/poem25210.html","السريع"],[74,"جسم سقيم لا يرام شفاؤه","https://www.aldiwan.net/poem18173.html","الكامل"],[74,"يا ناسيا عهدي ولست بناسي","https://www.aldiwan.net/poem19017.html","الكامل"],[53,"أشجتك منزلة بمرجي راهط","https://www.aldiwan.net/poem65022.html","الكامل"],[87,"المشرقان عليك ينتحبان","https://www.aldiwan.net/poem8188.html","الكامل"],[87,"تلك الطبيعة قف بنا يا ساري","https://www.aldiwan.net/poem63715.html","الكامل"],[87,"قم ناد أنقرة وقل يهنيك","https://www.aldiwan.net/poem63757.html","الكامل"],[87,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[107,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[104,"عهد الجدود سقاك صوب عهاد","https://www.aldiwan.net/poem33003.html","الكامل"],[77,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[48,"المشيدات التي رفعت","https://www.aldiwan.net/poem22788.html","المديد"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85373","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/1314","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54815","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54719","الكامل"],[105,"قف في ربوع المجد وابك الأزهرا","https://www.poetsgate.com/ViewPoem.aspx?id=1337",""],[112,"مدري","https://www.poetsgate.com/ViewPoem.aspx?id=8381",""],[113,"من مشبهي بين الصنا","https://www.aldiwan.net/poem16313.html","مجزوء الكامل"],[160,"أيئست من أسماء أم لم تيأس","https://www.aldiwan.net/poem423.html",""],[164,"المشتري الحمد بالإفعال يصلحها","https://www.aldiwan.net/poem59003.html","البسيط"],[263,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[326,"اليأس من طول الثواء رواح","https://www.aldiwan.net/poem56342.html","الكامل"],[366,"سر منقلبًا","https://www.aldiwan.net/poem11643.html","عموديه"],[370,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[433,"زارت فكان بأمر الله اسراها","https://www.aldiwan.net/poem41037.html","البسيط"],[461,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"]],"verses":[["أَلمَشْرِقَانِ مشَاطِرَاكُمْ رُزْءهُ","فَعَزَاءَكُمْ يَا مَعْشَرَ السِّرْيَانِ",0,"ن",1,0],["أَلمُشْتَرِينَ وَهُمْ أَبْدَالُ مَنْ سَلَفُوا","بِكُلِّ فَانٍ فَخَاراً لَيْسَ بِالفَانِي",1,"ن",2,0],["المُشتَري الحَمدَ بِأَموالِهِ","وَالبائِعِ النائِلَ بِالنائِلِ",2,"ل",1,0],["المشتري سلعَ الثناء بجودِهِ","وبهاؤه لعطاردٍ وذكاؤه",3,"ا",3,0],["المشرقين إذا ادلهمت حالةٌ","إشراق ضوءِ الصبح في الإغلاس",4,"س",1,0],["المشترين فياشلاً لنسائهم","بدراهمٍ ووظائفاً بقرارط",5,"ط",1,0],["المَشرِقانِ عَلَيكَ يَنتَحِبانِ","قاصيهُما في مَأتَمٍ وَالداني",6,"ن",2,1],["المُشتَرينَ اللَهَ بِالأَبناءِ وَال","أَزواجِ وَالأَموالِ وَالأَعمارِ",7,"ر",1,0],["المُشتَروكِ بِمالِهِم وَدِمائِهِم","حينَ الشُيوخُ بِجُبَّةٍ باعوكِ",8,"ك",1,0],["المُشرِفاتُ وَما اِنتَقَل","نَ عَلى المَمالِكِ وَالبُحور",9,"ر",1,0],["المشركونَ عَمُوا وأنتَ مُوكَّلٌ","بالشّركِ يُمحَى والعَمايَةِ تُمسَحُ",10,"ح",1,0],["المشرفية في الوغى خطباؤه","تعلو منابر من متون جياد",11,"د",1,0],["المُشرِقاتُ كأنّهُنّ كَواكِبٌ","والنّاعِماتُ كأنّهُنّ غُصُون",12,"ن",1,0],["المَشيداتُ الَّتي رُفِعَت","أَربَعٌ مِن أَهلِها دُرُسُ",13,"س",1,1],["المشكلات برأَيه","منحلة فهو العَريف",14,"ف",1,0],["المُشعِلُ الحَربَ ناراً وَهيَ خامِدَةٌ","وَالمُستَبيحُ حِماها وَهيَ تَشتَعِلُ",15,"ل",1,0],["أَلمُشِقَياتُ الوَرَى لأَِيْسرِ مَا","يُسْدِينَ مِن نِعْمَةٍ إلى النَّظَرِ",16,"ر",1,0],["أَلمُشْتَرِي بِمُنَى المَعَا","شِ تَسَلُّفاً نِعَمَ المَعَادْ",17,"د",1,0],["المشعلون لنارها أبناؤه","تَخِذوا به جنداً هناك وعسكرا",18,"ر",2,0],["المشكله.؟ ماهيب نفسي وزلاّت قدمي","وماهيب بحّة صوت أحبّه ولاعاد أسمعه",19,"ع",2,0],["المشكله؟ لاجات من بين دمّي والحمي","مدري من أخلّي ولا أدري من اوقّف معه",19,"ع",2,0],["المشرقات الطَيبات","الغاليات شراءَ مالي",20,"ل",2,0],["المُشتَرِي حُسنَ الثَّناءِ بِمالِهِ","وَإِذا تَوَجَّهَ مُعطِياً لَم يَحبِسِ",21,"س",1,0],["المشتري الحمد بالإفعال يصلحها","والحمد أفضل مايقنيه مدخرا",22,"ر",2,1],["المشبع في زمن الوأَجِ","وعلى من بالتقرير رضي",23,"ي",1,0],["المُشتَري حُسنَ الثَناءِ بِمالِهِ","فَلَهُ بِذاكَ مَزِيَّةٌ وَرَباحُ",24,"ح",1,0],["المشرِقُ تغشاهُ دَياجٍ","تمتدُّ قرونًا وَحُقوبا",25,"ب",2,0],["المُشرِقاتُ بَنوها حينَ تَسمَعُها","تَرى بِها وَجَناتِ الخُرَّدِ العُرُبِ",26,"ب",1,0],["المشمعل الى الآداب وهي له","عرنا ويزرع في احكام مجراها",27,"ا",3,0],["المشتري الحمدَ الربي","حَ لا يبالي ما خسِرْ",28,"ر",1,0]]}