,""],[5606,"القلوب تطير لكن من دون أجنحه","https://www.poetsgate.com/ViewPoem.aspx?id=194769",""],[5694,"اخويي","https://www.poetsgate.com/ViewPoem.aspx?id=129913",""],[5739,"جاوبيني","https://www.poetsgate.com/ViewPoem.aspx?id=126426",""],[5739,"الشريط ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127064",""],[5739,"برج الهواوي ورادار العشير ..!","https://www.poetsgate.com/ViewPoem.aspx?id=130849",""],[5739,"فرحة بخيل ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131229",""],[5776,"خاتمٌ بلا إصبع","https://www.poetsgate.com/ViewPoem.aspx?id=199329",""],[5830,"كل الشرائع في محرابك اجتمعت","https://www.poetsgate.com/ViewPoem.aspx?id=204642",""],[5848,"ترنيمة ورق","https://www.poetsgate.com/ViewPoem.aspx?id=51959",""],[5848,"أطلق شنب","https://www.poetsgate.com/ViewPoem.aspx?id=48988",""],[5848,"المشكلة ماهيب في جرح الصديق","https://www.poetsgate.com/ViewPoem.aspx?id=49225",""],[5950,"كلمتين أبيك تسمعها","https://www.poetsgate.com/ViewPoem.aspx?id=128131",""],[5956,"النساء","https://www.poetsgate.com/ViewPoem.aspx?id=181836",""],[5956,"إني لأخضعُ لاحترامك باكيا","https://www.poetsgate.com/ViewPoem.aspx?id=182371",""],[5956,"القومية الآدمية الحوّائية العالمية","https://www.poetsgate.com/ViewPoem.aspx?id=182850",""],[5956,"إني لأخضعُ لاحترامك باكيا","https://www.poetsgate.com/ViewPoem.aspx?id=192034",""],[5956,"ألمٌ ألمَّ به","https://www.poetsgate.com/ViewPoem.aspx?id=194579",""],[6056,"عيونه الخرسا","https://www.poetsgate.com/ViewPoem.aspx?id=130503",""],[6318,"فلق الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66162&r=&rc=12",""]],"verses":[["أَلمَشْرِقَانِ مشَاطِرَاكُمْ رُزْءهُ","فَعَزَاءَكُمْ يَا مَعْشَرَ السِّرْيَانِ",0,"ن",1,0],["أَلمُشْتَرِينَ وَهُمْ أَبْدَالُ مَنْ سَلَفُوا","بِكُلِّ فَانٍ فَخَاراً لَيْسَ بِالفَانِي",1,"ن",2,0],["المُشتَري الحَمدَ بِأَموالِهِ","وَالبائِعِ النائِلَ بِالنائِلِ",2,"ل",1,0],["المشتري سلعَ الثناء بجودِهِ","وبهاؤه لعطاردٍ وذكاؤه",3,"ا",3,0],["المشرقين إذا ادلهمت حالةٌ","إشراق ضوءِ الصبح في الإغلاس",4,"س",1,0],["المشترين فياشلاً لنسائهم","بدراهمٍ ووظائفاً بقرارط",5,"ط",1,0],["المَشرِقانِ عَلَيكَ يَنتَحِبانِ","قاصيهُما في مَأتَمٍ وَالداني",6,"ن",2,1],["المُشتَرينَ اللَهَ بِالأَبناءِ وَال","أَزواجِ وَالأَموالِ وَالأَعمارِ",7,"ر",1,0],["المُشتَروكِ بِمالِهِم وَدِمائِهِم","حينَ الشُيوخُ بِجُبَّةٍ باعوكِ",8,"ك",1,0],["المُشرِفاتُ وَما اِنتَقَل","نَ عَلى المَمالِكِ وَالبُحور",9,"ر",1,0],["المشركونَ عَمُوا وأنتَ مُوكَّلٌ","بالشّركِ يُمحَى والعَمايَةِ تُمسَحُ",10,"ح",1,0],["المشرفية في الوغى خطباؤه","تعلو منابر من متون جياد",11,"د",1,0],["المُشرِقاتُ كأنّهُنّ كَواكِبٌ","والنّاعِماتُ كأنّهُنّ غُصُون",12,"ن",1,0],["المَشيداتُ الَّتي رُفِعَت","أَربَعٌ مِن أَهلِها دُرُسُ",13,"س",1,1],["المشكلات برأَيه","منحلة فهو العَريف",14,"ف",1,0],["المُشعِلُ الحَربَ ناراً وَهيَ خامِدَةٌ","وَالمُستَبيحُ حِماها وَهيَ تَشتَعِلُ",15,"ل",1,0],["أَلمُشِقَياتُ الوَرَى لأَِيْسرِ مَا","يُسْدِينَ مِن نِعْمَةٍ إلى النَّظَرِ",16,"ر",1,0],["أَلمُشْتَرِي بِمُنَى المَعَا","شِ تَسَلُّفاً نِعَمَ المَعَادْ",17,"د",1,0],["المشعلون لنارها أبناؤه","تَخِذوا به جنداً هناك وعسكرا",18,"ر",2,0],["المشكله.؟ ماهيب نفسي وزلاّت قدمي","وماهيب بحّة صوت أحبّه ولاعاد أسمعه",19,"ع",2,0],["المشكله؟ لاجات من بين دمّي والحمي","مدري من أخلّي ولا أدري من اوقّف معه",19,"ع",2,0],["المشرقات الطَيبات","الغاليات شراءَ مالي",20,"ل",2,0],["المُشتَرِي حُسنَ الثَّناءِ بِمالِهِ","وَإِذا تَوَجَّهَ مُعطِياً لَم يَحبِسِ",21,"س",1,0],["المشتري الحمد بالإفعال يصلحها","والحمد أفضل مايقنيه مدخرا",22,"ر",2,1],["المشبع في زمن الوأَجِ","وعلى من بالتقرير رضي",23,"ي",1,0],["المُشتَري حُسنَ الثَناءِ بِمالِهِ","فَلَهُ بِذاكَ مَزِيَّةٌ وَرَباحُ",24,"ح",1,0],["المشرِقُ تغشاهُ دَياجٍ","تمتدُّ قرونًا وَحُقوبا",25,"ب",2,0],["المُشرِقاتُ بَنوها حينَ تَسمَعُها","تَرى بِها وَجَناتِ الخُرَّدِ العُرُبِ",26,"ب",1,0],["المشمعل الى الآداب وهي له","عرنا ويزرع في احكام مجراها",27,"ا",3,0],["المشتري الحمدَ الربي","حَ لا يبالي ما خسِرْ",28,"ر",1,0],["المُشَبَّعُ العَقلَ الَّذي أَخلاقُهُ","غَرُّ الوُجوهِ حَسيبَةٌ لا تُرجَحُ",29,"ح",1,0],["المشتري من عُلوقِ الفضلِ أثمنَها","والمكتسي 