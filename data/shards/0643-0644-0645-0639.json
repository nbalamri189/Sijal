,[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106915","الرمل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126221","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205074","الخفيف"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103517","الخفيف"],[3164,"","https://poetry.dctabudhabi.ae/diwan/poem/146991","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66485","الخفيف"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66620","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40097","الخفيف"],[4896,"نضال لا ينتهي","https://www.poetsgate.com/ViewPoem.aspx?id=180869",""],[4984,"ومض السها","https://www.poetsgate.com/ViewPoem.aspx?id=175796",""],[5431,"الحب المجلجل...","https://www.poetsgate.com/ViewPoem.aspx?id=210261",""],[5950,"ياسيد الأحباب","https://www.poetsgate.com/ViewPoem.aspx?id=126263",""],[6207,"بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78948&r=&rc=4",""]],"verses":[["كَلَمعَةِ البارِقِ مُجتازَةً","تَقضي عَلى زَمجَرَةِ الراعِدِ",0,"د",1,0],["كلُّ معنًى كالنجمِ أو كلّ بيتٍ","هو أهدى في الأفقِ من أن يهدى",1,"د",2,0],["كَلَمعِ أَيدي مَثاكيلٍ مُسَلِّبَةٍ","يَنعَينَ فِتيانَ ضَرسِ الدَهرِ وَالخُطُبِ",2,"ب",1,0],["كُلٌّ مُعَنّى مُبتَلىً","بِعَطائِها وَبِسَلبِها",3,"ب",3,0],["كَلِمٌ عنتني غير أن","ني لا أُحاوِل أَن أردا",4,"د",2,0],["كلَّ مَعنى كانَ يوضِحُهُ","في العُلا لمّا اِشتَكى اِشتَكَلا",5,"ل",2,0],["كَلَمْعِ الطَّلِّ فِي حََرٍّ","سَقَاهُ الغَيْثُ والصَبُّ",6,"ب",1,0],["كلُّ معنىً بلقيسُ والبيت صرحٌ","ومنَ الدرّ لا الزجاج البناءُ",7,"ا",2,0],["كُلّ مَعنى حازَهُ حسنا","عِندَما باهَت مفاخرُه",8,"ر",2,0],["كُلّ مَعنى حازَهُ حسنا","عِندَما باهَت فَضائلُه",9,"ل",2,0],["كُلّ مَعنى حازَهُ حسنا","عِندَما باهَت مراتبُه",10,"ب",2,0],["كُلّ مَعنى حازَهُ حسنا","حين عَمّا دونَهُ رَغبا",11,"ب",2,0],["كلَمْعِ البَرقِ أَنملُه حِساباً","وفيه الغَيثُ مَشرَبُه رَويّ",12,"ي",1,0],["كل معنى نحوم حول تعاطي","ه وجدناه في فصيح لسانك",13,"ك",1,0],["كل معنى إن سار في كل لفظ","فهو بدر يحوز فيه كماله",14,"ل",2,0],["كلُّ معنى كالسحر لطفاً ولفظٍ","في عيون القلوب يحلو ويحلا",15,"ل",2,0],["كلُّ معشوقةٍ إلى النّفس أشهى","من ثَنايا الحِسان دونَ ثَناها",16,"ا",3,0],["كلُّ معنىً رائقٍ في لفظِه","كزنادٍ فيه لَمعُ النارِ كَنّا",17,"ن",2,0],["كلمعةِ البرقِ اليما","نيِّ إذا البرقُ لمع",18,"ع",1,0],["كلُّ معزوفة نحيبٌ إذا غبت","وصوت الفناءِ رجعُ فحيح",19,"ح",1,0],["كُلُّ مَعَدِّ وَكُلُّ ذي يَمَنٍ","نَزُمُّها مُلكِها وَنَخطِمُها",20,"م",3,0],["كلُّ معنًى مهذَّبٌ","من معانيك مبتكر",21,"ر",1,0],["كل معنى سواك أمسى","صبا بغير العلا عميدا",22,"د",2,0],["كلِّ مُعمٍّ في الجيادِ مُخْول","أَغَرَّ مِنْ عِتَاقِها مُحَجَّلِ",23,"ل",1,0],["كل معنى بلفظه يترامى","قطعاً من عزائم وضرام",24,"م",1,0],["كَلَمعَةِ البارِقِ مجتازَة","بِمائِها في البَلَدِ الماحِل",25,"ل",1,0],["كل معنىً فيه بهيجٌ كأح","لام الليالي البواسم السافرات",26,"ت",1,0],["كل معنىً حرقة الأن","فاس من صدري تصعَّد",27,"د",1,0],["كُلٌّ مَعَالى حَظُّ هذا السَالِكَ","نوّرَ لهُ ليلُ الظَلامِ الحالِكِ",28,"ك",1,1],["كل معنى قنابل لك تدوي","كل لفظ دبابة لك ضخمه",29,"م",2,0],["كل معنىً أتاك منه على ما","تتمنى لو لم يكن أن يكونا",30,"ن",2,0],["كل معاشٍ إلى فناءِ","كل نعيم إلى زوال",31,"ل",1,1],["كل معنىً أفاد معنىً نبيلاً","من نبيل جليل لفظ جليل",32,"ل",1,0],["كُلِّ مَعْسُولَةِ المَراشِفِ بَيْضا","ءَ حَمَتْها سُمْرُ القَنا العَسَّالَهْ",33,"ل",2,0],["كُلُّ مَعروفِهم لِمَعروفهم طَلْق","وَهُم في مَكروهِهِ شُرَكاؤُه",34,"ا",3,0],["كل معيار لدينا معلم","للذي يضمره الغيب لنا",35,"ن",2,0],["كلمعة ومض السها أرسلت","بريقا تلاشى بجوف السحر",36,"ر",1,0],["كل مُعنّى والحرب داعسة","أشلاءَ فجرٍ في غِلْسها انحبسا",37,"س",2,0],["كلٍ معاه أسباب","محد يجي مغصوب",38,"ب",1,0],["كل معنى يطاول الدهر قدما","يلهب الروح بين قر الظراب",39,"ب",1,0],["كل معنى مسوم ، كخيول","تركل النقع ، تختفي في اليباب",39,"ب",1,0]]}