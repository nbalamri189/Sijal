an.net/poem47358.html","الطويل"],[572,"أمسك ديف بالقهوة","https://www.aldiwan.net/poem69769.html","الهزج"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133811","الرجز"],[1177,"","https://poetry.dctabudhabi.ae/diwan/poem/28389","الطويل"],[1704,"","https://poetry.dctabudhabi.ae/diwan/poem/100674","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75879","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65945","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94235","الكامل"],[3098,"","https://poetry.dctabudhabi.ae/diwan/poem/131896","الطويل"],[3268,"","https://poetry.dctabudhabi.ae/diwan/poem/98148","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74040","المديد"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91274","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91095","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131217",""],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105556","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58170","الكامل"],[4755,"أَنا مُنهَكٌ أَيُّها المُنهَكُونا","https://www.poetsgate.com/ViewPoem.aspx?id=192452",""],[4791,"يا للأسف","https://www.poetsgate.com/ViewPoem.aspx?id=28404",""],[4791,"للطير طبع","https://www.poetsgate.com/ViewPoem.aspx?id=37109",""],[4869,"احبك لحالك","https://www.poetsgate.com/ViewPoem.aspx?id=151550",""],[4869,"مقطوع من شجْرة احزاني","https://www.poetsgate.com/ViewPoem.aspx?id=151719",""],[5055,"كل السحايب","https://www.poetsgate.com/ViewPoem.aspx?id=104295",""],[585,"هل في القطين وراء المنش مستمع","https://www.poetsgate.com/ViewPoem.aspx?id=161904",""],[5183,"مُلْغِزَه رق282م","https://www.poetsgate.com/ViewPoem.aspx?id=186400",""],[5183,"العراقين","https://www.poetsgate.com/ViewPoem.aspx?id=180174",""],[5344,"نواف ما مَثّل ضنا بن وايل.!","https://www.poetsgate.com/ViewPoem.aspx?id=180701",""],[5691,"روح المدائن","https://www.poetsgate.com/ViewPoem.aspx?id=206312",""],[5909,"النفس أخصب رهوَها الإفناءُ","https://www.poetsgate.com/ViewPoem.aspx?id=210697",""],[5956,"فانوسُ أبي و(جلّ)* الصَّبي","https://www.poetsgate.com/ViewPoem.aspx?id=184561",""],[6268,"مرثية الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82926&r=&rc=12",""],[6305,"أجِزْ حَرَامَاً ...!!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87338&r=&rc=11",""],[6318,"القدس في خطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66164&r=&rc=14",""]],"verses":[["وَلِليَتامى وَلِلأَضيافِ إِن طَرَقوا","أَبياتَنا لَفَعالٍ مِنكَ مَخبورِ",0,"ر",1,0],["ولليهوديّ مع كحل العمى نظر","على المجوسيّ أيضاً فيه تكحيل",1,"ل",1,0],["ولليمِّ إعذارٌ بعرضِ متونِهِ","وما فيه من آذيِّهِ المتراكبِ",2,"ب",1,0],["ولليَأسُ خيرٌ في الأمور مغبّةً","وأروَحُ من وعد امرئٍ غير منجِزِ",3,"ز",1,0],["وللْيَعْفورِ في الكَزِّ انغماسٌ","وللحِرباء في الضِّحِّ اصْطخامُ",4,"م",1,0],["وَلِليَدَينِ اِرتِعاشٌ","وَلِلعِظامِ صَريرُ",5,"ر",1,0],["وَلِليَومِ المُغَيَّبِ عَنكَ شَخصي","أَمارَةُ يَومِ نَحسٍ مُستَمِرِّ",6,"ر",1,0],["وَلِلَّيالي في تَصاريفِها","حُكمانِ فيما رابَنا اثنانِ",7,"ن",1,0],["وَللّيالي في صَرْفِها عِبَرٌ","فهْيَ سهامٌ ونحن أغْراضُ",8,"ض",1,0],["وَلِلَّيلِ ظِلٌّ قَد تَقَلَّصَ أَخضَرٌ","وَلِلصُبحِ ماءٌ قَد تَسَلسَلَ أَزرَقُ",9,"ق",1,0],["وَلِلَّيلِ جِلبابٌ عَلَينا وَحَولَنا","فَما إِن تَرى إِنساً لَدَيهِ وَلا جِنّا",10,"ن",2,0],["ولليلِ إصغاءٌ وللريح حولَه","رفيفٌ كهمسِ الروحِ في ظل معبدِ",11,"د",1,0],["ولليَأسُ خيرٌ في الأمور مغبَّة","ً وأروَحُ من وعد امرىء ٍ غير منجِز",12,"ز",1,0],["وَکللَّيَالي إذا نَأَيْتِ طِوالٌ","وأَرَاها إذا دَنَوْتِ قِصارا",13,"ر",2,0],["وَلِليّالي صَفاءٌ بعد أَن كَدُرَت","تَرجوكَ صفحاً وَسيفُ الغَدرِ مَغمودُ",14,"د",1,0],["وَلِلَّيالي دُوَلٌ بَينَهُم","تَنقُلُ مِن زَيدٍ إِلى عَمرِو",15,"ر",2,0],["ولليل اشراق بزهر نجومه","كليلة اعراس توقد شمعها",16,"ع",3,0],["ولِلَّيالي تَصاريفٌ وأَصعَبُها","ما استَبطَنَ القلبَ من وَجدٍ ومن خبَلِ",17,"ل",1,0],["ولليوم أعددت الدموع وصنتها","وما يستجم الدمع إلا ليسجما",18,"م",2,0],["ولِلّيالي واعظٌ صامتٌ","يُسمِعُنا لو أنّنا نَفهَمُ",19,"م",1,0],["ولليالي إغارات على عصر","من الشباب ولذات وأعمار",20,"ر",1,0],["ولليتامى على تقدير قسمهم","ثلاثة مثلها يعطى بنو السبل",21,"ل",1,0],["وللّيلة الظلماء قمتَ سراجَها","على رِجْلِ قوّالٍ مع الله عمّالِ",22,"ل",1,0],["ولَليوم ما تَلْقَى المطايا مُشيحةً","تَقَلْقَلُ في أكوارها والنّمارقِ",23,"ق",1,0],["وللّيْلِ سَرَابِيلٌ","مِنَ الظَّلْماءِ مَنْسُوجَهْ",24,"ج",2,0],["وللينابيع هلا","فانطلقت من الأكم",25,"م",1,0],["وَلِلَّيلِ أَنباءٌ وَلِلصُّبحِ إِخوَةٌ","وَأَبناءُ لَيلى مَعشَري وَقيلي",26,"ل",2,1],["ولليث كل الليث إذ يحملونه","إلى حفرةٍ ملحودة وسقيف",27,"ف",1,0],["وَلِليلِ مِن تلكَ الذَوائبِ ظُلمَةٌ","وَلِلصُبحِ مِن خَدَّيهِ نُورٌ تَبَلَّجا",28,"ج",2,0],["ولليوم يعطى قوته قوت شارىء","إلى ربع صاع ربع صاع بلا نكد",29,"د",1,0],["ولليلة البدر السنية أرخت","بشر المسرة جاءه بوهيبه",30,"ب",2,0],["ولليعملات اليوم يلتذّ راكبٌ","لقطع الفيافي غير وانٍ وهازل",31,"ل",1,0],["وَللّيث فوقَ النعشِ إِذ يَحملونه","إِلى حفرةٍ ملحودةٍ وسقوفِ",32,"ف",1,0],["وَلليلاتٍ لَنا سَلفت","كنّ في أَمنٍ من الريبِ",33,"ب",1,0],["وَلليل أستار من الندّ مَدَّها","عَلينا رواقاً فَوقَ أَطناب يانع",34,"ع",1,0],["وَلليوم يشجيني الحجاز وذكره","وَتزجي سَماء العَين ما غالها صَحو",35,"و",1,0],["ولليل من بيض السيوف قلائدٌ","وللنجم من سمر الرماح ذوائب",36,"ب",1,0],["ولليل كفرعين منسدل","والنجم كالقرطين في وجب",37,"ب",1,0],["ولِليْلَةِ القَدْرِ المعظَّم قَدْرُهَا","فيه تَدُورُ بقدْرَةِ الرحمن",38,"ن",1,0],["ولِلَّيلِ قُدَّامَ شُبَّاكِ رُوحِي","عُبُوسٌ, كَمَن يَقتَضُونَ الدّيونا",39,"ن",2,0],["وللِّي مثل شرواك مانحسب حساب","الحب خلّه عنك عرضه وطوله",40,"ل",2,0],["وللي بخيصٍ في معان القصايد","لازم يعرف القصة اللي لهاروح",41,"ح",1,0],["وللي سئل اقول مآلي ومآلك","انا الخليل اللي بكآ لاجل خلّه",42,"ل",2,0],["ولليتم بانت عليّ إشهود","مقطوع من شجْرة احزاني",43,"ن",2,0],["وللّي خبير القاف فالشعر زجا","خيله صهاب الريح عند العراجي",44,"ج",2,0],["ولليهود كما شئتم مصانعهم","من السلاح ومنكم عندها الصنع",45,"ع",1,0],["ولليالي تلاق في خمائلها","يغشى الأسِرَّة من ظلمائها غاش",46,"ش",1,0],["ولليل نسر لا يجنحه الفضا","بظلمته لولا القضاء المحجب",47,"ب",1,0],["وللي مثيله ما نبي حصايل","بنقدمه للي لهم ناكرها..",48,"ر",3,0],["ولليونانِ كانَ هُنا حُضورٌ","لدى الإسْكَنْدَرِ المَفْطورِ بأْسا",49,"س",2,0],["ولِليلُ عهدٌ بالكؤوسِ وراحِها","وببابِ ليلى خُلوةٌ شعواءُ",50,"ا",2,0],["ولليوم عظمي الرقيقُ النضير","يكرِّر لي لكمات الأميرْ",51,"ر",1,0],["ولليل إذ ينتشي أَرْجُلٌ","حديديةٌ في جبينِ \"الصعيدْ \"",52,"د",1,0],["ولليهودِ على أعناق ساستِنا","فرضٌ يُطاعُ وهم في طوْعِهِ خدمُ",53,"م",1,0],["ولليهودِ ميادين القنا فُتِحتْ","كلٌّ بأُهبَتِه في ساحها يَثِبُ",54,"ب",1,0]]}