{"poems":[[5,"إن لله علينا نعم","https://www.aldiwan.net/poem309.html",""],[41,"أمن دمن بشاجنة الحجون","https://www.aldiwan.net/poem53733.html","الوافر"],[48,"لأمواه الشبيبة كيف غضنه","https://www.aldiwan.net/poem23485.html","الوافر"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141951","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43896","المتقارب"],[132,"ورد الكتاب من الحبيب الواثق","https://www.aldiwan.net/poem50566.html","الكامل"],[136,"راق قلبي ومقلتي والطور","https://www.aldiwan.net/poem54825.html","الطويل"],[189,"الفضل فضلان فضل المرء بالأدب","https://www.aldiwan.net/poem14103.html","البسيط"],[189,"هل المجد إلا دون ما أنت رافع","https://www.aldiwan.net/poem14573.html","الطويل"],[208,"سنة يزاد بها الأمير جمالا","https://www.aldiwan.net/poem53156.html","الكامل"],[234,"وصامت الجو بعيد الفرقد","https://www.aldiwan.net/poem51126.html","الكامل"],[254,"لمن الديار غشيتها بالأنعم","https://www.aldiwan.net/poem2093.html","الكامل"],[266,"محل العلا لولا الدني شريف","https://www.aldiwan.net/poem38231.html","الطويل"],[275,"يا شارب الراح على ورد","https://www.aldiwan.net/poem35292.html","السريع"],[325,"أبا مصطفى استمتع فحظك وافر","https://www.aldiwan.net/poem67164.html","الطويل"],[358,"نفسي الفداء لمن حوت","https://www.aldiwan.net/poem40169.html","مجزوء الكامل"],[369,"بالكتب طرا كتاب خطه ملك","https://www.aldiwan.net/poem60873.html","البسيط"],[382,"قلب يذوب إلى الأطلال والحلل","https://www.aldiwan.net/poem59287.html","البسيط"],[382,"أفنظم در ما أره نفيسا","https://www.aldiwan.net/poem59382.html","الكامل"],[382,"سر عجيب فيه معنى أعجب","https://www.aldiwan.net/poem66932.html","الكامل"],[396,"ألا يا ابن العفيف يا","https://www.aldiwan.net/poem54588.html","عموديه"],[409,"يا سعد خذ بأبي وأمي","https://www.aldiwan.net/poem33426.html","مجزوء الكامل"],[409,"قد شف جسمي طول ما أتشوف","https://www.aldiwan.net/poem33640.html","الكامل"],[412,"محل العلى أني حللت محلها","https://www.aldiwan.net/poem50133.html","الطويل"],[412,"ألم بمضجعي بعد الكلال","https://www.aldiwan.net/poem50138.html","الوافر"],[435,"ورد الكتاب مصرحا ومسطرا","https://www.aldiwan.net/poem41038.html","الكامل"],[443,"سرى الطيف وهنا والرقاد مرنق","https://www.aldiwan.net/poem2618.html","الطويل"],[463,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[466,"ملكت بك العرب الفخار وقد","https://www.aldiwan.net/poem16264.html","أحذ الكامل"],[473,"روابي القاش مذهبة الخيام","https://www.aldiwan.net/poem59656.html","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87068","الطويل"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146225","المتقارب"],[984,"","https://poetry.dctabudhabi.ae/diwan/poem/122195","المنسرح"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62560","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62575","الطويل"],[1281,"","https://poetry.dctabudhabi.ae/diwan/poem/77439","البسيط"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128707","الوافر"],[1687,"","https://poetry.dctabudhabi.ae/diwan/poem/138026","الوافر"],[1711,"","https://poetry.dctabudhabi.ae/diwan/poem/145770","المنسرح"],[2071,"","https://poetry.dctabudhabi.ae/diwan/poem/122427","المتقارب"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134022","الطويل"],[3102,"","https://poetry.dctabudhabi.ae/diwan/poem/113894","الطويل"],[3156,"","https://poetry.dctabudhabi.ae/diwan/poem/34722","المتقارب"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139975","المتقارب"],[3456,"","https://poetry.dctabudhabi.ae/diwan/poem/206009","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126980","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110058","البسيط"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/90050","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133239","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199055","الطويل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78194","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119602","الرجز"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21577","المتقارب"],[4211,"","https://poetry.dctabudhabi.ae/diwan/poem/200353","الوافر"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135132","المجتث"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58052","السريع"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89587","الطويل"],[4929,"الأعمى والحمامة","https://www.poetsgate.com/ViewPoem.aspx?id=202405",""],[4978,"أستاذتي زينب","https://www.poetsgate.com/ViewPoem.aspx?id=189775",""],[5183,"نهر الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=186612",""],[5183,"أبا دواؤد","https://www.poetsgate.com/ViewPoem.aspx?id=180195",""],[5829,"الصوم عن المفاسد","https://www.poetsgate.com/ViewPoem.aspx?id=212595",""],[5906,"رسول وآل","https://www.poetsgate.com/ViewPoem.aspx?id=188071",""],[5309,"ذكرى ليالي الهوى العذري تصبينا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573536",""],[6259,"محلَّ العلى أنى حللتَ محلّها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59395&r=&rc=43",""],[6315,"قَبائلُ النِّسْرِين !! هامشٌ على قرطاسِ المُتَنَبّي ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87575&r=&rc=0",""]],"verses":[["فَفَضَلناهُم بِعِزٍّ باذِخٍ","ثابِتٍ الأَصلِ عَزيزِ المُدَّعَم",0,"م",1,0],["فَفَضَّلَني هُدايَ وَتِهنَ حَيرى","بِمُشتَبِهِ الظَواهِرِ وَالصُحونِ",1,"ن",1,0],["فَفُضَّ زَكاةَ مالِكَ غَيرَ آبٍ","فَكُلُّ جُموعِ مالِكَ يَنفَضِضنَه",2,"ن",2,0],["ففضلة الكأس التي عفتها","تركتها للخدم الساقطين",3,"ن",1,0],["فَفَضْلُكَ مَنْ لي بإِحْصَائِهِ","وفي بعضِه عِلَّةُ الحاسبِ",4,"ب",1,0],["ففضضتُ خَتْمَ كتابِه ونشرتُه","فعرفتُه مِنْ سيدِّي ومُوابِقي",5,"ق",2,0],["فَفَضَضتُ الخِتامَ عَنهُ وقَد","بُثث على جَانِب السَّرِيرِ سُرُورِي",6,"ر",2,0],["ففَضْلُ ذي أدَبٍ يُغْنيه عن نسبٍ","وليس ذو نَسَبٍ غانٍ عن الأدب",7,"ب",1,0],["ففضُلك فينا فضُله في شهورِه","فكلٌّ لكلٍّ مُشْبِهٌ ومُضارِع",8,"ع",1,0],["ففضلتهم عند الخطاب مقالا","وفضلتَهم عند الخطوب فعالا",9,"ل",2,0],["ففضلك الفضل الذي لم يُجْحَد","شهِدْتُ والملعون لم يَشهد",10,"د",1,0],["فَفَضَضنَ جَمعَهُمُ وَأَفلَتَ حاجِبٌ","تَحتَ العَجاجَةِ في الغُبارِ الأَقتَمِ",11,"م",1,0],["ففضلك در والأماني نواهل","ولفظك دُر والزمان رصوف",12,"ف",1,0],["ففضنَ بينَ الزَّهرِ حمراءَ عَن","صَفراءَ كالميِّتِ في اللَّحد",13,"د",1,0],["فَفضلُكَ بِالإِجماعِ في الناسِ ثابِتٌ","عَلَيهِ مَليكَ القُطرِ قَدرُكَ أَعلى لَك",14,"ك",1,0],["فَفَضضت مِسك خِتامها","بِحُضور أَهل المَجلسِ",15,"س",1,0],["فَفُض عن كرمٍ غَمْرٍ وعن كَلِمٍ","غُرٍّ لجُرْحِ فؤادي كُلُّها آس",16,"س",1,0],["ففضله فاق حد الفضل ليس له","حدٌّ وندٌّ فقل في وصفه وطُل",17,"ل",1,0],["ففضيلةٌ تُتلى وفضلٌ يُجتلى","ببهائه السامي وداءٌ يوسى",18,"س",2,0],["ففضضتُها وقرأتها وفهمتها","فإذا بها ما ليس عنه مهرب",19,"ب",1,0],["ففضل الله واسع","وجوده ليس ينفد",20,"د",1,0],["ففضضته فإذا به","بحران من نثر ونظم",21,"م",1,0],["ففضضته فأفاض بحر مدامعي","وذكرت ما لم أنس مما أعرف",22,"ف",1,0],["فَفَضلُكَ مَشهورٌ وَلوَ لَم يَكُن بِها","يَمُتّ إِذا لَم يَسرِ في الناس فَضلُها",23,"ل",3,0],["فَفَضلك قَد غَدا لِلفَضلِ جيداً","وَهَذا المَدح عقدٌ مِن لآلي",24,"ل",2,0],["ففضضت منه ختامه ولطالما","فاضت دموع قبله لن تكرا",25,"ر",2,0],["ففضلك إذ نبلى وبأسكَ والندى","فمن حاتم أو عامر والمحرّق",26,"ق",1,0],["ففضلُنا يُعرفُ في أقوالنا","وكرمُ الملوك في أفعالها",27,"ل",3,0],["ففَضْلتَ نُعْماناً ومُنْذِرَهُ","ومُحَرِّقاً فلا فَحَحٌ ولا صَكَكُ",28,"ك",1,0],["فَفُضَّ خِتامَ دَنِّكَ عَن عَقيقٍ","يُحَسِّنُ لَمعَهُ سَبَجُ الظَلامِ",29,"م",1,0],["ففضلها بَينَ اللَيالي لِيُمنها","عَلى أَلف شَهر بِالأَدلة عالم",30,"م",1,0],["ففضت لهن خواتيمها","وبدرتنا الدهر لا تختم",31,"م",1,0],["ففضله يبهر الأهلّة في","سعودها والشموس في الحمل",32,"ل",1,0],["ففضله أطاعني","وكان خير ناصر",33,"ر",1,0],["ففضلكم للحي في اليوم أجرُه","وحِسبتكم للميت تَلقونَ في غدِ",34,"د",1,0],["فَفَضلُهُ رَوضَةٌ غَنّاءُ دانِيَةٌ","قُطُوفُها وَجَنى كَفَّيه مَعسولُ",35,"ل",1,0],["ففضلك منتهى أملي وسؤلي","وكنزي واعتمادي واعتضادي",36,"د",2,0],["فَفَضَّلَهُ النبيُّ بِصِدْقِ ضَرْبٍ","على مَن صَدَّقوهُ في الثَوابِ",37,"ب",1,0],["ففضله في البلاد من نعمه","وصوله في البلاد من نقمه",38,"م",2,0],["ففضَّلَهُ اللَهُ ربُّ العباد","وأنزَلَ في شأنِهِ هل أتى",39,"ا",1,0],["ففضل امير المؤمنين مكافئ","لمن هو للأوطان بالخير انفع",40,"ع",1,0],["ففضلا على شغفي بمجد أيمتي","أكابد محنات الصبا وبلاها",41,"ا",3,0],["فَفَضلٌ وَزيرٌ وَبَكرٌ مُشيرٌ","يُريدانِ ما فيهِ حَتفُ الأَمير",42,"ر",1,0],["ففضّهم اللّه بعدَ اجتماع","وبدّد جمعَهم المحتفل",43,"ل",1,0],["فَفَضّل عبدُ اللَّه خُطبةَ واصلٍ","وضُوعف في قَسْمِ الصِّلات له الشُّكْدُ",44,"د",1,0],["ففضلك اليوم لم ينكره عارفه","وكيف ينكره من بعد توكيد",45,"د",1,0],["ففضلهم شاملٌ والحزمُ ناسبهم","وَجُودُهم هاملٌ أَغنَى أُولِي العُدُمِ",46,"م",1,0],["فَفَضَضتُهُ وجعلت ألثمُ كُلَّ ما","كتبتهُ أو مرَّت عليه يداه",47,"ا",2,0],["ففضلا منك جد لي باقتراب","وتسهيل المقاصد والسداد",48,"د",1,0],["ففض أتريذ الجموع فمضت","إلى سفينها وعنهم أعرضت",49,"ت",1,0],["ففضلك مشهود ومجدك واضح","وليس لما تملي يداك جحود",50,"د",1,0],["فَفَضاء عَفوِكَ لا حُدودَ لِوُسعِهِ","وَعَلَيهِ مُعتَمِدي وَحُسنُ رَجائي",51,"ي",1,0],["فَفضلُهم لقد أتى وهو العلي","في الخبر المُثبتِ والأمر الجلي",52,"ي",1,0],["فَفَضّا الخَواتيم عَن جَونَةٍ","صَدوفٍ عَن الفَحلِ بكرٍ عَوانِ",53,"ن",1,0],["ففض مجامع الكتفين منه","بأبيض ما يغب عن الصقال",54,"ل",1,0],["ففضك النجم سمكا","وعلمك المتعالي",55,"ل",2,0],["ففضِّل العلم على واصل","في حِندس يختال في العبقر",56,"ر",1,0],["فَفَضلي صَميمٌ دونَ غَيري مُقَدَّسٌ","وَعِرضي سَليمٌ لا يُرامُ طَهورُ",57,"ر",1,0],["ففضائلُ الأخلاقِ فينا جينُها","باقٍ ويبقى للزمانِ الباقي",58,"ق",2,0],["ففضلك في الأعناق خير قلادة","وأدعو إلهي أن يكون لك الأجر",59,"ر",1,0],["ففض ختام المسك عنها مصليا","على من أتاه الذكر تترى عجائبه",60,"ب",2,0],["ففض ختام المسك عن خمر ريقها","لتشرب شهد الحب من خير مشرب",61,"ب",1,0],["ففضائلُ الأعمالٍ تَسمو بالذي","جعلَ الصيامَ تَخَلُقاً وتََصَبُّرا",62,"ر",2,0],["فَفَضلٌ لِرَبّ العِبادِ فما","ورَبّ العِبادِ ِنَبِيْنا كَذَبْ",63,"ب",1,0],["فَفَضَّلَتني عَلَى العُشاقِ كُلِّهِمِ","لأَنَّني عِشتُ في حَرِّ الهَوى حينا",64,"ن",2,0],["ففضلك مشكورٌ ولو لم يكن بها","يمتُّ إذا لم يسر في الناس فضلها",65,"ل",3,0],["فَفَضَحتُ ( أَلغَازَ الحَياةِ ) بِجُثَّةٍ","طَفَحَتْ عَلَى زَبَدِ الرِّثَاءِ عَذَابا",66,"ب",2,0]]}