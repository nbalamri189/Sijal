{"poems":[[37,"لعزة هاج الشوق فالدمع سافح","https://www.aldiwan.net/poem39173.html","الطويل"],[47,"سرى من خيال المالكية ما سرى","https://www.aldiwan.net/poem63587.html","البسيط"],[51,"ألم يك في وجدي وبرح تلددي","https://www.aldiwan.net/poem63543.html","البسيط"],[422,"تلفت في منازل آل مي","https://www.aldiwan.net/poem53835.html","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50041","الهزج"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87315","الرجز"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108388",""],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70097","الوافر"],[4796,"الى الاستاذ الشاعر يوسف الخطيب","https://www.poetsgate.com/ViewPoem.aspx?id=34722",""],[4869,"المقفص","https://www.poetsgate.com/ViewPoem.aspx?id=151534",""],[4908,"صفحة جديدة","https://www.poetsgate.com/ViewPoem.aspx?id=211567",""],[5732,"حل الرحيل وفرقوا شمل الاحباب","https://www.poetsgate.com/ViewPoem.aspx?id=177871",""],[5953,"سئمت المقام بنادي حلب","https://www.poetsgate.com/ViewPoem.aspx?id=93858",""],[5969,"على رسل الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=198684",""],[6127,"فداءٌ وإباء","https://www.poetsgate.com/ViewPoem.aspx?id=215939",""],[6152,"أزيز شوق","https://www.poetsgate.com/ViewPoem.aspx?id=203101",""],[6152,"بياض قلب","https://www.poetsgate.com/ViewPoem.aspx?id=203103",""],[6152,"سراييفو حلم متجدد","https://www.poetsgate.com/ViewPoem.aspx?id=203271",""],[6177,"شرايين التراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79077&r=&rc=20",""],[5190,"على بُعدِ شاطئين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85032&r=&rc=107",""]],"verses":[["إِلى أُرُكٍ بالجَزعِ مِن بَطنِ بيشَةٍ","عَليهنَّ صَيّفنَ الحَمامُ النَوائِحُ",0,"ح",1,0],["إِلى أُرجُوانِيٍّ مِنَ البَرقِ كُلَّما","تَنَمَّرَ عُلوِيُّ السَحابِ تَعَصفَرا",1,"ر",2,0],["إِلى إِرَمٍ ذاتِ العِمادِ وَإِنَّها","لَمَوضِعُ قَصدي موجِفاً وَتَعَمُّدي",2,"د",2,0],["إلى أرواحها ترتاح روحي","وألقى بالأحِبَّة ما أُحِب",3,"ب",1,0],["إلى أروع يَستسقى","حيا المزن محياهُ",4,"ا",2,0],["إلى أربَعَه أَشهرِ يا خليلي","تمضي منَ النيروزِ بالدَّليلِ",5,"ل",1,0],["إلى أرض لبنان يجاذبني وجدي","كما اشتاق قبلي قيس للعلم السعدي",6,"د",2,1],["إِلى ارسانيوس الفَضل يعزى","بِتاريخٍ بِهِ ضاعفت شُكري",7,"ر",2,0],["إلى أريحا إلى يافا لِناصرةٍ","إلى الجليل لرام الله قم وَجُبِ",8,"ب",1,0],["إليا ركبته يعني انت مْتجعص","كنك ملك واقف له الشعب طابور",9,"ر",1,0],["إلى ّأرض المحبين البعيدةْ","خذ أشواقي أمانة لاترددْ",10,"د",1,0],["اليا رقا مرقاب ناداه مرقاب","بمفارق الخلان شاف الغرابيل",11,"ل",1,0],["إلى أرض كوفان دار الوصي","وهجرته ومحل الرغب",12,"ب",1,0],["إلى أَرْضِ القَصيدِ هَبَطتُ شَوقا","فَأَزْهَرَ حَرفُها غَرْباً وَشَرْقا",13,"ق",2,1],["إلى أرضِ الفداءِ تخبُّ خبّا","ولاحقُكُمْ لَهُ حَجٌّ وكرُّ",14,"ر",1,0],["إلى أرض الحجاز أذوب شوقا","ومن لهواي رغم البعد صانا",15,"ن",2,0],["إلى أرض الحجاز أبثُ شوقي","فإن القلب مزقه الحنين",16,"ن",1,0],["إلى أرض الحجاز أبث شوقي","وأرسله مع الغيم طروبا",17,"ب",2,0],["إلى أرض الكنانة فاض شوقي","وأغرتني القصيدة والحبيبُ",18,"ب",1,0],["إلى أَرضِها خُذنِي،فَقَد هَدَّنِي النَّوَى","وفِي حِضنِهَا دَعنِي، فَفِي حِضنِهَا الطُّهرُ",19,"ر",1,0]]}