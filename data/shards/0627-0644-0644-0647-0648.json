{"poems":[[75,"ما للمدام تديرها عيناك","https://www.aldiwan.net/poem11913.html","الكامل"],[74,"الحمد لله على إنعامه","https://www.aldiwan.net/poem19685.html","المنسرح"],[53,"لج الفؤاد فليس يلذعه","https://www.aldiwan.net/poem65413.html","أحذ الكامل"],[47,"العيش في ليل داريا إذا بردا","https://www.aldiwan.net/poem63497.html","البسيط"],[107,"الكتب تترى والكتائب تدلف","https://www.aldiwan.net/poem43999.html","الكامل"],[69,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[50,"اسمي لوجهك يا منى صفة","https://www.aldiwan.net/poem65236.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55048","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43828","الرجز"],[92,"في ذكرى الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179047",""],[112,"الاولين","https://www.poetsgate.com/ViewPoem.aspx?id=8407",""],[168,"وإذا قرأت كلامه قدرته","https://www.aldiwan.net/poem67831.html","الكامل"],[244,"الله ربي والحنيفةُ ديني","https://www.aldiwan.net/poem1095.html","الكامل"],[347,"وافيصلاه القلب منفطر","https://www.aldiwan.net/poem55331.html","أحذ الكامل"],[443,"خذ من قياد الدهر خير زمام","https://www.aldiwan.net/poem2495.html","الكامل"],[447,"هذا الفراق وهكذا التوديع","https://www.aldiwan.net/poem14378.html","الكامل"],[563,"نحن الجفون نحفظ العيونا","https://www.aldiwan.net/poem33809.html","الرجز"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66976","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64074","الكامل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138103",""],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126142","الرجز"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114796","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27811","الرجز"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77329","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93573","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205749","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81303","البسيط"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139308","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58082","الكامل"],[4978,"رفح والأمة المشبورة","https://www.poetsgate.com/ViewPoem.aspx?id=177177",""],[5055,"المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=102729",""],[5122,"لا تجرح المجروح","https://www.poetsgate.com/ViewPoem.aspx?id=17972",""],[5122,"صدفه","https://www.poetsgate.com/ViewPoem.aspx?id=31519",""],[5136,"قال خليلي إذا جرى مدمعي","https://www.poetsgate.com/ViewPoem.aspx?id=121498",""],[5136,"ريحاننا لا إله إلا الله","https://www.poetsgate.com/ViewPoem.aspx?id=121768",""],[5191,"إنّي أنا العربيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=211967",""],[5198,"ليل داجي","https://www.poetsgate.com/ViewPoem.aspx?id=136228",""],[5279,"حبيبي يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=183880",""],[5370,"الله أكبر","https://www.poetsgate.com/ViewPoem.aspx?id=81631",""],[5573,"الله وكيلي","https://www.poetsgate.com/ViewPoem.aspx?id=200181",""],[5652,"ياكبر ضيقات الليالي والايام","https://www.poetsgate.com/ViewPoem.aspx?id=208686",""],[5664,"لا يالقصيده","https://www.poetsgate.com/ViewPoem.aspx?id=176686",""],[5756,"الذهب","https://www.poetsgate.com/ViewPoem.aspx?id=5187",""],[5794,"النضال العفاف","https://www.poetsgate.com/ViewPoem.aspx?id=80278",""],[5848,"خمسة عشر ماتوا علشان صندق","https://www.poetsgate.com/ViewPoem.aspx?id=53364",""],[5875,"عبق الخزامى","https://www.poetsgate.com/ViewPoem.aspx?id=37155",""],[5956,"الله وحدَهُ فاطرُ الأكوانِ","https://www.poetsgate.com/ViewPoem.aspx?id=183100",""],[5956,"أرجو بقايَ لأجل زوجي الصابرِ","https://www.poetsgate.com/ViewPoem.aspx?id=183732",""],[5956,"يا كوكب العلم","https://www.poetsgate.com/ViewPoem.aspx?id=194140",""],[5956,"أرتين قد بدأ المسير مهللا","https://www.poetsgate.com/ViewPoem.aspx?id=205422",""],[5956,"وخْزٌ في زَند ابنتي آن؟","https://www.poetsgate.com/ViewPoem.aspx?id=213372",""],[5993,"الشعر ديوان العرب وانت بومه","https://www.poetsgate.com/ViewPoem.aspx?id=186756",""],[6115,"أخزاك يالحوثي وبيت الله حماه","https://www.poetsgate.com/ViewPoem.aspx?id=196453",""]],"verses":[["اللَهوُ ذِكرُكِ لا غِناءُ مُرَجِّعٍ","يَفتَنُّ في الإِطلاقِ وَالإِمساكِ",0,"ك",1,0],["الله وهَّاب عبده شرفاً","وفره فيه قسم قسَّامه",1,"م",2,0],["الله وفق مبتغيك لها","وحباك أمراً كنت تدفعه",2,"ع",2,0],["اللَهُ وَلّاكَ عَن عِلمٍ خِلافَتَهُ","وَاللَهُ أَعطاكَ ما لَم يُعطِهِ أَحَدا",3,"د",2,0],["الله وكَّلَ بالملوكِ رَسولَه","فإذا العروشُ بهم تَميدُ وتَرجُفُ",4,"ف",1,0],["اللهُ وَفَّقَهُ فَوَفَّقَ كُلَّ ما","يَنْوِيهِ مِنْ نَقْضٍ وَمِنْ إبْرَامِ",5,"م",1,0],["اللَهُ وَفَّقَ والِدَيَّ لَهُ","مِن قَبلِ أَن أَهواكِ عَن عِلمِ",6,"م",1,0],["أللهو والله ليس بلاهٍ","أم لجورٍ والله ليس يجور",7,"ر",1,0],["أَللهْوُ ظَاهِرُها وَفِي تَوْجِيهِهَا","كَمْ مِنْ مَنَافِعَ لِلحِمَى وَمَرَافِقِ",8,"ق",1,0],["اللَهُ وَالحَمدُ لَهُ","صَبَّرَهُ حينَ بَلا",9,"ل",2,0],["الله ، والأوطان تعرِفُ نيّتي","وعليَّ فيما أدعيهِ ، وكيل",10,"ل",1,0],["الله وأكبر يالرجال الاوّلين","أهل الكرم وأهل الضفر وأهل الوقار",11,"ر",1,1],["اللَهُ وَفَّقَهُ اِتِّباعَ رَسولِهِ","وَكِتابِهِ الأَصلَينِ في التِبيانِ",12,"ن",1,0],["الله والإسلام يبرأُ منهم","فالجأ لحصن من هداه حصين",13,"ن",1,0],["اللَه والالام مغرقة","في الحزن والآمال تنحدر",14,"ر",1,0],["اللَه والافكار هائمة","تحتاطها الاشباح والصور",14,"ر",1,0],["اللّه ولاك الرعية بعدما","أولاك فضلاً أوفر الأقسام",15,"م",1,0],["اللَه وفقها لحسن صيامه","وقيامه لا مغلثٌ وهجوع",16,"ع",1,0],["الله وحده هو الموجود لا","سواه والجميع معدومونا",17,"ن",2,0],["اللهُ والإشفاقُ يَعْلَمُ أنَّني","لو أستطيعُ فِدىً لَكُنْتُ لَكَ الفِدَا",18,"د",2,0],["الله وَفَّقَهُ لإدراكِ الذي","تهوى النفوس فما يزالُ مُوَفَّقا",19,"ق",2,0],["اللهو يغضبني واليأس يضحكني","أبغض بحالين هاضا في الهوى مُننى",20,"ن",2,0],["اللهو بالضامة أو بالمنقلة","قد كثرت فيه نصوص النقلة",21,"ه",1,0],["اللهوُ إلفي والبَطالَةُ مَركبي","والأَمن ظِلّي والشَّبَابُ رواقِي",22,"ق",2,0],["الله والله لمن","حمدُه كذا وقع",23,"ع",1,0],["اللَهُ والاهُ بِالنُعمى وَقَرَّبَهُ","وَزانَهُ بِكَمالِ الخَلقِ وَالشِيَمِ",24,"م",1,0],["اللَه وَرّثك الإِمارة فلتقم","في عبئها وَلَكَ الآله مؤيد",25,"د",1,0],["الله والنيل قد صانا وقد عرفا","من ليس يعرف إلَّا النيلَ واللهَ",26,"ه",1,0],["اللَه وَالرُوح كَم نَسعى وَراءَهُما","وَنَستَعين بِأَموات وَأَحياء",27,"ا",2,0],["اللهو منقصة بصاحبه","فاحذر مذلة مؤثر اللهو",28,"و",1,1],["اللهو واللعب الدَّنيُّ مُحَّرمُ","قد قيلَ إلاّ في ثلاثِ مواضعِ",29,"ع",1,1],["الله وحّدها وقسّمها الذي","أسموه الاستقلال، من يتجارا ؟",30,"ر",2,0],["الله وجب شكرٍ وشكرك لنا عم","صلّت لك الحيتان في غبة أبحور",31,"ر",1,0],["الله ولا حب(ن)،ضنى الهجر قافيه","مادام يجعل صاحبه في إحراجا",32,"ج",2,0],["الله وكبر من جمالآ عليها فظيع","من بعد ما شفتها غادين حالي دمار",33,"ر",1,0],["اللهو يثنيها ثمار الهوى","كما تثنى الغصن الرطب",34,"ب",1,0],["الله والله لا إله سوى","الله ألا لا إله إلا الله",35,"ل",2,0],["الله، والحُبُّ، والأوطانُ، مُعتقدي","والصّبرُ والحقُّ ما زالا لنا دينا",36,"ن",2,0],["الله وهبلي عقل ولسان وعيون","عيني تقديني وعقلي سراجي",37,"ج",2,0],["اللهَ وَحَّدَ وَالكِتَابُ سَبِيلُنَا","وَالشِّرْكُ نَارٌ بِالجَحِيمِ أَقَامَا",38,"م",2,0],["الله واكبر وميتين استعاذه","ما كنّه الا نازل لي من الغيث",39,"ث",1,0],["الله وكيلي هو خلقني من امشاج","وخلق لي اعيوني وسمعي معاديل",40,"ل",1,1],["الله وكيلك مابقى غير الاقلاااام","أكتبّها ..شوقي على .. فقد غالي",41,"ل",2,0],["الله واكبر كيف قلب الموازيين","شهرين ما فاض القلم من قريحه",42,"ح",2,0],["الله وهبني هم بني عم وأجناب","من يوم ما جيت أعجبتهم وأعجبوني",43,"ن",2,0],["الله وأكبر كيف والدنيا جفاف","ينبت القمح في صدري وأتامله",44,"ل",2,1],["الله وكيلك ما طرى لبالي يروق","ما دام يدّك ما غفت في يديّه",45,"ي",2,0],["الله وهبك الحب بعهود ووثاق..","يبقى طوال العمر لحن وغناوي",46,"ا",3,0],["الله وحدَهُ فاطرُ الأكوانِ","قُلْ: لا إلهَ سِواه في الأزمانِ ‏",47,"ن",1,0],["الله وحَّدَ نسلَ آدمَ كلَّهُمْ ‏","برباطِ إنسانيّةِ الأديانِ ‏",47,"ن",1,0],["الله وَحْدُهُ مُعتنٍ بحياتها","ليست بحاجة مؤمن أو كافرِ",48,"ر",1,0],["الله وجّهكم للخير يا ولدي","بِوَحْي طيبتكم فيما يكون سَمِي",49,"م",2,0],["الله وعَّى والديه لصونه","وأجاد في ذهنيهما التنويرا",50,"ر",2,0],["الله وحدُهُ كافلٌ لك حارسٌ","لذويك لا تأسَيْ غداً يَشفيكِ",51,"ك",1,0],["الله واكبر صرت شاعر ومطفوق","تكتب بيوتك فوق الاوراق كومه",52,"م",2,1],["الله وعد والله صادق فالوعد","أخزاك يالحوثي وبيت الله حماه",53,"ا",2,1]]}