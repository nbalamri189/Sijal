{"poems":[[65,"من أغفل الحزم أدمى كفه ندما","https://www.aldiwan.net/poem46181.html","البسيط"],[65,"من رام عزا بغير السيف لم ينل","https://www.aldiwan.net/poem46207.html","البسيط"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[45,"عقبى اليمين على عقبى الوغى ندم","https://www.aldiwan.net/poem10529.html","البسيط"],[30,"وشغلت عن حسب الكرام وما بنوا","https://www.aldiwan.net/poem5477.html","الكامل"],[46,"دمن ألم بها فقال سلام","https://www.aldiwan.net/poem30368.html","الكامل"],[54,"ألا تريان البرق ما هو صانع","https://www.aldiwan.net/poem26872.html","الطويل"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[77,"الحب حيث المعشر الأعداء","https://www.aldiwan.net/poem69109.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85388","البسيط"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[102,"حوار جارين","https://www.poetsgate.com/ViewPoem.aspx?id=50201",""],[102,"حيرة الساري","https://www.poetsgate.com/ViewPoem.aspx?id=50134",""],[34,"أبت مقلتي كتمان ما بي","https://www.poetsgate.com/ViewPoem.aspx?id=116",""],[139,"لمهندس الكون العظيم","https://www.aldiwan.net/poem49099.html","مجزوء الكامل"],[147,"إن لم أقل فيك ما يردي العدى كمدا","https://www.aldiwan.net/poem11753.html","البسيط"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[240,"زفرات وجد ما يبوخ ضرامها","https://www.aldiwan.net/poem31746.html","الكامل"],[264,"قم نحو حماه وانصرف","https://www.aldiwan.net/poem35942.html","المتدارك"],[266,"سلا عن ربي سلع فأعين عينها","https://www.aldiwan.net/poem38135.html","الطويل"],[266,"هنئت بالإكرام والإعزاز","https://www.aldiwan.net/poem38261.html","الكامل"],[463,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[543,"فدع مراكشا ما دمت فيه","https://www.aldiwan.net/poem47993.html","عموديه"],[556,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[563,"إن من بعض ما هي الأطوار","https://www.aldiwan.net/poem35092.html","الخفيف"],[580,"عشقت ومن هذا الذي ليس يعشق","https://www.aldiwan.net/poem2909.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86940","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48688","البسيط"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203781",""],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133806","المتقارب"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1491,"","https://poetry.dctabudhabi.ae/diwan/poem/107308","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108908","الكامل"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131533",""],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60942","الطويل"],[2546,"","https://poetry.dctabudhabi.ae/diwan/poem/33958","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2782,"","https://poetry.dctabudhabi.ae/diwan/poem/144339","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94317","الرجز"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104677","الرمل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121585","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91193","الطويل"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123529","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95331","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119661","الخفيف"],[4083,"","https://poetry.dctabudhabi.ae/diwan/poem/147649","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54378","الخفيف"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67663","المتقارب"],[4827,"يا استاااااذ ...؟","https://www.poetsgate.com/ViewPoem.aspx?id=29525",""],[5158,"للحلم للشعر وأشياء أخرى","https://www.poetsgate.com/ViewPoem.aspx?id=59128",""],[5225,"زهور الحب","https://www.poetsgate.com/ViewPoem.aspx?id=36891",""],[5324,"لاتنكروا بغداد فهي ملاذكم .","https://www.poetsgate.com/ViewPoem.aspx?id=207544",""],[5401,"يااااا تركي","https://www.poetsgate.com/ViewPoem.aspx?id=85474",""],[3294,"أين الوفاء وللوفاء دلايل","https://www.poetsgate.com/ViewPoem.aspx?id=173271",""],[5776,"يوم الصمود اليماني","https://www.poetsgate.com/ViewPoem.aspx?id=203770",""],[5847,"ألم وأمل","https://www.poetsgate.com/ViewPoem.aspx?id=6444",""],[5997,"لَا تلُوْمِيْنِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=214225",""],[6068,"أقسام قلبي...-15-","https://www.poetsgate.com/ViewPoem.aspx?id=175861",""]],"verses":[["والأعْوَجِيّةُ كادَتْ مِنْ تَغَيُّظِها","على فَوارِسِها أنْ تَلْفِظَ اللُّجُما",0,"م",2,0],["والأعوَجِيّةُ مُرخاةٌ أعِنَّتُها","تَسْتَنُّ في لَهَواتِ السَّهْلِ والجَبَلِ",1,"ل",1,0],["وَالأَعادي شَواخِصٌ وَأَبوها","بِيَدِ الخَطبِ صَخرَةٌ صَمّاءُ",2,"ا",2,0],["وَالأَعوَجِيَّةُ مِلءَ الطُرقِ خَلفَهُمُ","وَالمَشرَفِيَّةُ مِلءَ اليَومِ فَوقَهُمُ",3,"م",1,0],["وَالأَعشَيانِ كِلاهُما وَمُرَقِّشٌ","وَأَخو قُضاعَةَ قَولُهُ يُتَمَثَّلُ",4,"ل",1,0],["وَالأَعوَجِيّاتُ الجِيادِ كَأَنَّها","تَهوي وَقَد وَنَتِ الرِياحُ سَمامُ",5,"م",1,0],["وَإِلّا عَزَلتُ الأَمرَ عَنّي وَعَنكُمُ","وَكُنتُ كَأَنّي لَيسَ لي مِنكُمُ رَهطُ",6,"ط",1,0],["وَالأَعادِي كَأَنَّ كلَّ طَرِيحٍ","منهمُ الزَّقُّ حُلَّ عَنْه الوِكاءُ",7,"ا",2,0],["والأعوجيّات التي إن سُوبقَتْ","سَبقَتْ وجَرْيُ المذكيات غِلاء",8,"ا",2,0],["والأعين النجل أَثخنته","بسيف أَلحاظها جراحا",9,"ح",2,0],["والاعتمادُ خارجٌ عن شَكلها","وفِعْلُهُ مُخالفٌ لفِعْلها",10,"ه",2,0],["والأعاصير تركب القمم الحيرى","كما يركب الجبان الفرارا",11,"ر",2,0],["والأعاصير تدوّي في الربا","وتميت العطر في صدر الأقاح",12,"ح",1,0],["وإلا عداني دون بثنة أعينٌ","حداد ولامتها النساء الهلامع",13,"ع",1,0],["والاعتناء","بخدمة الإنسانْ",14,"ن",1,0],["وَالأَعيُنُ الشوسُ قَد غُضَّت فَلا شَوَسٌ","وَالصِيدُ قَد تَرَكوا في عَصرِكَ الصَيَدا",15,"د",2,0],["وَالأعادي مِن عدّةٍ وعديدٍ","لَعِبَت في عقولهم صهباءُ",16,"ا",2,0],["وَالأَعوَجِيّاتُ الجِيادُ مُغيرُها","يَومَ الوَغا وَصُفونُها وَصِيامُها",17,"م",3,0],["والأعمى من لا يبصرها","في مؤتلفٍ أو مختلف",18,"ف",1,0],["والا عروساً في ملاءٍ محبر","تزف بأبكار المعاني وعونها",19,"ن",3,0],["والأعوجيات العتاق إلى المدا","في ركضهن غنى عن المهماز",20,"ز",1,0],["والأعطياتُ جمالُها ال","مشكورُ لا أقدارُها",21,"ر",3,0],["وإلاَّ عِش وأنتَ بِه ذَليلٌ","وسَيفي في حَشاكَ له صَليلُ",22,"ل",1,0],["وإلّا عِضاضٌ للأباهِم من جوىً","وهل نافعٌ أنْ أدْمِيَتْ لِيَ إصبعُ",23,"ع",1,0],["والأعادي مظاهر القبض منا","عندهم من شئوننا الإنكار",24,"ر",1,0],["وإِلاَّ على الخَصْرِ الدَّقيق فقال لي","إِلَيْكَ فإِنَّ الخَصْرَ مِنْ ذَاكَ أَضْيَقُ",25,"ق",1,0],["وَالأَعرَج العَجميُّ صفَّى مِن دَمي","ما صرتُ مِنهُ فاقدَ الإِحساس",26,"س",1,0],["والاعتماد على أبطال تجربة","قبل اعتماد على أبطال غارات",27,"ت",1,0],["والأعاصير التي هبت على","ناره لم تلق إلا ثَوَرانا",28,"ن",2,0],["وإلا عزيفُ الغصون تحطّم","والغاب مجرودة سيِّب",29,"ب",1,0],["والاعتماد صاحب الزحاف","وغير مجزوء يقال الوافي",30,"ي",1,0],["وإِلا عِدِينيهِ وإن شئتِ فامطُلِي","بإِنجازِهِ إنّي قَنوعٌ أَخُو شُكرِ",31,"ر",1,0],["والأعجميات القليلات الوفا ال","متلصفات على أولي العرفان",32,"ن",1,0],["والا على نفثة المصدور","فنفثته تبعث الأشجان",33,"ن",1,0],["والاّ عبيراً حينَ تستنشقينه","يعلّ به منك المفارق والشعر",34,"ر",1,0],["وَالأَعظَمينَ إِذا العِظامُ تَنافَسوا","بِالمَكرُماتِ وَحَصَّلوا تَحصيلا",35,"ل",2,0],["وَالأعزَلُ المَشهُورُ وَالمُرَبَّع","عشرُ أَصابِع في القِياسِ فَآسمَع",36,"ع",1,0],["وَالأعرَجُ هُنَاكَ ذَاكَ الحِينَا","ثَمَانِيَه فَكُن بِهَا فَطِينَا",36,"ن",2,0],["والأعْوَجِيَّةُ بالأَبطال مُقِبلَةٌ","والخَلْقُ صِنْفان : مَقتولٌ ومُنْهَزِم",37,"م",1,0],["والاعتكاف لا يصح فيه","فاعلمه وارو الحكم عن فقيه",38,"ه",1,0],["وَالأَعادي عَنكَ صُدَّت","صَدَّها ريحُ الجَلاءِ",39,"ا",2,0],["والا عيون الناس من دهشة به","تخلف أهداباً فتحسبها فروا",40,"ر",3,0],["وَالأَعادي إِذا رَمَيتُم رَميتم","كلها من يدا القَضا مقذوفه",41,"ف",2,0],["والاعْتدالُ في الأمور أعْدَلُ","والمَسْلَك الأوسطُ فيها أمْثَلُ",42,"ل",1,0],["والأَعجمي بالكلام أفصحا","وفصُح اللحان والآن صحا",43,"ح",2,0],["والأعادي يرونها كل وقتٍ","حيث كانت هناك بيت القصيد",44,"د",1,0],["والأعوجيات السوابق تمتطي","فتظلل الآفاق سحب عجاجِ",45,"ج",1,0],["والأعادي جرى عليهم من التّد","ميرِ ما قد جرى على قوم عادِ",46,"د",1,0],["وإلاّ على رِقْبةٍ في المسير","وخوفٍ على النفس دون السّلَبْ",47,"ب",1,0],["والا علوم ٍ من علوم الطويلات","او انها .. كبّر وعناد ونحاسه",48,"س",2,0],["وإلا عليه اليوم ! ما الله حداني !","هو ابتلاني لين ماصرت .. بلواه !",49,"ا",2,0],["والاعب الشرتا على كل فنّي","وانته على الغصن الرّفيع العلاوي",50,"ا",3,0],["والأعظميّةٌ لم تزل للكاظميّ","يةٍ أختًها ..رغم اللذين تزندقوا",51,"ق",3,0],["والا عنود الصيد في طبعه وجل","يجفل ليا هز الهوى غصن شجره",52,"ر",2,0],["والاعتدءا على الضعيف سجية","فيهم وأمر ظاهر مشهور",53,"ر",1,0],["والأعادي تعوّذتْ","شاهدُوا الموتَ أحمرا",54,"ر",2,0],["والاعادي عليه صاروا لفيفا","ذا اقتران ليسلبوا أوطانه",55,"ن",2,0],["والأعاصير أَفْطَرَت مِن عَاصِف","نال مِنِّي مقتلا فِي كُلِّ عامْ",56,"م",1,0],["7-و الأعظم العملاق يبدأ خطوة","حتى تراه بالكمال نهائيا",57,"ي",2,0]]}