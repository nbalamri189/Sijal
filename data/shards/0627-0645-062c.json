395",""],[4680,"مجازر الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=185033",""],[4767,"أيكة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=91456",""],[4767,"لا عودة","https://www.poetsgate.com/ViewPoem.aspx?id=190159",""],[4852,"جمال فذ ...","https://www.poetsgate.com/ViewPoem.aspx?id=214621",""],[4852,"نظرات عينك","https://www.poetsgate.com/ViewPoem.aspx?id=215533",""],[4858,"ماذا بركبك يا أيّار","https://www.poetsgate.com/ViewPoem.aspx?id=137598",""],[4859,"إن العيد من ديني!","https://www.poetsgate.com/ViewPoem.aspx?id=213579",""],[4869,"وشفيه امجد","https://www.poetsgate.com/ViewPoem.aspx?id=151654",""],[4968,"أمّاه","https://www.poetsgate.com/ViewPoem.aspx?id=206754",""],[4999,"حالنا اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=184275",""],[3271,"إلى دخان الكوخ","https://www.poetsgate.com/ViewPoem.aspx?id=102364",""],[5120,"وَ يَنْتَهِي اَلْإِغْرَاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=184371",""],[5183,"ملغزه رق223م","https://www.poetsgate.com/ViewPoem.aspx?id=186403",""],[5183,"قالا","https://www.poetsgate.com/ViewPoem.aspx?id=186483",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5186,"عوفيت يا شيخ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=156545",""],[5187,"درس في الحب","https://www.poetsgate.com/ViewPoem.aspx?id=29792",""],[5249,"هذا هو المجد من يعلقه لم ينم","https://www.poetsgate.com/ViewPoem.aspx?id=124961",""],[5409,"ضمني الحلم ومن أه","https://www.poetsgate.com/ViewPoem.aspx?id=155515",""],[5409,"حدثينا يا فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=155283",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""],[5612,"أوَ كُلُّ هذا الحُسْن !!","https://www.poetsgate.com/ViewPoem.aspx?id=181539",""],[5618,"القدس في عين شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=208919",""],[5671,"أضيق صدر الدهر والحزم واسع","https://www.poetsgate.com/ViewPoem.aspx?id=169351",""],[5784,"إلى متعنتة...","https://www.poetsgate.com/ViewPoem.aspx?id=190786",""],[5804,"الوردة والنار","https://www.poetsgate.com/ViewPoem.aspx?id=191787",""],[6318,"فلق الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66162&r=&rc=12",""]],"verses":[["أَم جَنايا بَني عَتيقٍ فَمَن يَغ","دِر فَإِنّا مِن حَربِهِم بُراءُ",0,"ا",2,0],["أمُجاهِدَ دِينِ اللهِ لقدْ","أمّنْتَ بصارِمِكَ الطُّرُقا",1,"ق",2,0],["أَم جَمَعتَ الأَعداءَ فَوقَ صَعيدٍ","وَخَلَطتَ الأُسودَ بِالآرامِ",2,"م",1,0],["أمْجِدْ بِسَمْعَانَ إذْ أَبْدَى رَوَائِعِهَا","وَرُدَّ حُجَّةَ من مَارَى بِبُرْهَانِ",3,"ن",1,0],["أَمْجِدْ بِذِكْرَى زَمَنٍ مُنْقَضٍ","جَعَلْتَهُ غُرَّةَ أَزْمَانِ",4,"ن",1,0],["أم جُيوب زَرّها الده","ر على كل دَعاره",5,"ر",2,0],["أَمُجاوِرَ الديماسِ رَهنَ قَرارَةٍ","فيها الضِياءُ بِوَجهِهِ وَالنورُ",6,"ر",1,0],["أَم جِئتَهُ مُخَندِقاً حُصونَهُ","إِنَّ الجِيادَ وَالقَنا يَكفينَهُ",7,"ن",2,0],["أمجادها؟ ومسحت جرحاً نازف","ومسحت جرحاً ثانياً بفؤادي",8,"د",2,0],["أمُجُّ له العَذْبَ النَّميرَ كأنَّه","مُجاجةُ مُحمَرِّ الحماليقِ أسوَدِ",9,"د",1,0],["أُمُجَندِلَ الأَبطالِ بَل يا مُنتَهى","الآمالِ بَل يا كَعبَةَ الشُعَراءِ",10,"ا",2,0],["أَمُجَدِّلَ الأَبطالِ بَل يا باذِلَ ال","أَموالِ بَل يا حامِلَ الأَثقالِ",11,"ل",1,0],["أمْ جميعٌ عَلَى الحمار لقد جَل","لَ حِمَارٌ بِجَمْعِهِم مَشَّاءُ",12,"ا",2,0],["أم جاء طيبةَ من أربابها نباًٌ","أم أنّ كهّانها بالوحي قد جاؤوا",13,"ا",1,0],["أَمْجَادِ مِصْرَ وَأَجْوَادُ الأجَانِبِ مِنْ","بُنَاةِ جَاهٍ وَمِنْ أَرْبَابِ أَعْمَالِ",14,"ل",1,0],["أَمَجْدُكَ الضَّخْمُ البَعِيدُ المَدَى","مُجْتَمِعٌ في جِسْمِهِ النَّاحِلِ",15,"ل",1,1],["أَمْجِدْ بِطَلَعت حَرْبِ فِي زُعَمائِهَا","وَفؤادِ سُلطَانِ فتَاهَا العَبْقَرِي",16,"ر",2,0],["أم جنايا بني عتيقٍ فإنا","منكم إن غدرتم برآء",17,"ا",2,0],["أم جندول الحبيب","إلى لياليه حننت ؟",18,"ت",1,0],["امجانباً عرض البسيط أعيذه","من ان يَضيقَ عليك رحبٌ فضائه",19,"ا",3,0],["أَم جَلاءُ الشُراةِ أَم أَمنُهُ السُب","لَ بِقَتلِ اللُصوصِ وَالمُرّادِ",20,"د",1,0],["أم جائز لمن نوى","اظهار حال الآدمي",21,"ي",1,0],["أم جاء يعبث؟ والهوى","أضحى بحمدِ الله جدّا",22,"د",2,0],["أم جفاني إذ رآني","واللَّيالي من خُصومي",23,"م",2,0],["أَمجرعي كاس النَوى","وَالمَوت دونَ مَذاقِهِ",24,"ق",2,0],["أَمُجَرِّدَ الأسيافِ لم يُغْمَدْنَ في","شيءٍ سِوى الهاماتِ والأكبادِ",25,"د",1,0],["أمجنون ليلى به نازل","ترى لا سواه له مدخلا",26,"ل",2,0],["أم جئت بالسحر شعراً","لقد تحير حَدْسي",27,"س",2,0],["أمجتهداً يُدْعَى ابن هند محققاً","ومن قال هذا فهو لا شك مفتري",28,"ر",2,0],["أم جفاها الْمُزْنُ بعدي مثلما","قد جافني زمني لا جفيت",29,"ت",1,0],["أم جرى مني ما عَنِّي خفا","فعتاب الخِلِّ للخِل يطيب",30,"ب",1,0],["أم جُننتم أينَ الحفاوهُ منكم","أيلاقى التَّفضُّل النُّكرانُ",31,"ن",1,0],["أم جئتِنا بسِحرِها","تلفّتاً ولَمحا",32,"ح",2,0],["أمجداً بال سعيٍ لقد كذبتكمُ","نفوس ثناها الذلُّ أن تترفَّعا",33,"ع",2,0],["أمجادلي فيمن رويتُ صفاتهِ","عن هل أتى وشرفنَ من أوصافِ",34,"ف",1,1],["أَمجلسَ لهْوِي ليسَ لي منكَ مَجْلسُ","لأَوْحشتَ لمَّا غاب لي عنك مؤْنِسُ",35,"س",1,1],["أمجاد نهيان عند الناس حاضرة","وكلُّ مجد إلى نهيان يلتحق",36,"ق",1,0],["أم جَاوزُوا الدَّكداكَ مِن رَملِ النَّقا","فَسَقَى الغَمامُ الرّملَ وَالدَّكداكا",37,"ك",2,0],["أمُجَرِّعي غُصَصَ المَلامِ مُذَكِّري","عَصرض الصَّريمِ وَمُلتَقَى أجراعِهِ",38,"ع",2,0],["أمُجاوِزي خَمِرَ الطَّريقِ بجانِبِ المَ","أثُولِ كَيفَ رَأيتُمُ المَأثولا",39,"ل",2,0],["أَم جَعَلتَ الجَزاء نَقض ذمام","كانَ فيهِ إِقالَتي مِن عثاري",40,"ر",2,0],["أم جمان فصلتماه عقوداً","فيه زانت وقد تحلت نحور",41,"ر",1,0],["أم جاء في فترة أجفانك ال","المرضى بقتلى صدغك المرسل",42,"ل",1,0],["أمجد الدين مالك في انتقاص","وشكرك في نمو وازدياديِ",43,"د",2,0],["أمْ جَنَّةُ المَأوَى وَفِرْدَوْسُ المُنَى","أوْ دَارَةُ العَلْيَا وَشَمْسُ المَشْرِقِ",44,"ق",1,0],["أَم جَميلٌ بِجَميلِ الوَجهِ","أَن يَنقُضَ عَهدَه",45,"د",2,0],["أَمجمّع الأَلطافِ وَهُوَ يَفيضها","هَلا سَمحتَ بِفضلةٍ لِسواكا",46,"ك",2,0],["أَمَجْدَ الدِّينِ دونَكَ كلَّ وَصْفٍ","فَما وصْفي وجودُكَ فَوْقَ سولي",47,"ل",2,0],["أم جندنا أضحوا كسرب المها","أم أصبح العُرب كخيط النعام",48,"م",1,0],["أم جدت بالنفس كي يزهو بها كرماً","والجود بالنفس أقصى غاية الجود",49,"د",1,0],["أم جدّ من مهده لِلَّحدِ مُطَّلباً","للعلم مُقتفياً أقوال مُختارِ",50,"ر",1,0],["أَمَجنونٌ فَلَيسَ عَلَيكَ عَتبٌ","وَلَست مُعاتِباً إِلّا صَحيحا",51,"ح",2,0],["أمجشّماً أنضاءَ أغيابِ السُرى","هيماء تمنع قطعها الأخطارُ",52,"ر",1,0],["أمجلساً لك هذي الأرض قد جُمعت","أم أنتَ قد ضمنتْ أبرادُك البشرا",53,"ر",2,0],["أَمُجيرَ دينِ اللَهِ وَاِبنَ جَمالِهِ","وَالسَيَّدَ بنَ السَيَّدِ بنِ السَيَّدِ",54,"د",1,0],["أم جنة ولدانها قد غافلت","رضوانها غلساً وجدّ قرارُها",55,"ر",3,0],["أم جنودٌ دُكْنُ السّرابيل سُلَّتْ","للقاءٍ فيها سيوفٌ بيضُ",56,"ض",1,0],["أم جهلتم بأنكم من ترابٍ","قاصراتٌ أحلامكم أغبياء",57,"ا",2,0],["أمجاور النسر الكبير بقبره","هل مر هوغو باكياً بثراكا",58,"ك",2,0],["أَمجدد البرد القشيب لعيده","ولعرسه قد زف بالتَهليل",59,"ل",1,0],["امجدل الأبطال في يوم الوغى","ومنكس الرايات في الهيجاء",60,"ا",2,0],["أم جفته فصَيّرَتهُ هشيماً","تركته تذروه هوج الرياح",61,"ح",1,0],["أمجتمع المنى إن شئت شمل","لمجتمع لنا بمنىً شتات",62,"ت",1,0],["أمجتمعي قد رضعتَ العقوق","فلستَ تصافي سوى خاذل",63,"ل",1,1],["أم جزت في روض به قد مشت","أم ثغرها قَبَّلَكَ الأشنبُ",64,"ب",1,0],["أم جواسيس علينا رقباء","كل حين",65,"ن",1,0],["أم جاء في التّنزيل لا تنابزُوا","بالألقاب نهي فيه عن ذاك جازمُ",66,"م",1,0],["امجهد عيس السائرين الى الحمى","رويدا فما الرسم المخيل بالرسم",67,"م",1,0],["أَم جالَ طَيفُهمُ بفكرك ساعةً","فَشكَوتَ ظَنّاً أَنّهُ يَترحّم",68,"م",1,0],["أمجاورَ الميناء إنك لم تزل","ميناء مصر، والخطوب خضارم",69,"م",1,0],["أمجيبي أنت أم عند الصدى","أبد الدهر سؤالي والجواب",70,"ب",1,0],["أمجرِّدَ السيفين اغمد واحداً","والقً الكٌماةَ بواحِدٍ مَسلُول",71,"ل",1,0],["أم جاد المام الخيال بزورة","ثم أرعوى فألمت البرحاء",72,"ا",2,0],["أم جددت ذكرى الشباب لك الأسى","أين الشباب وأين منه وفاء",72,"ا",2,0],["أم جفاء أم أعوزتك القراطي","سُ أم أمري به عليك هوان",73,"ن",1,0],["أم جِئتَ مِن تِلقاءِ نَفسِكَ خابِطاً","فأَجابَ يَحقُقُ جازِعاً يتَهَلَّعُ",74,"ع",1,0],["أم جنة الفردوس من ولدانها","ذا وارد زهت الدنا بوروده",75,"د",2,0],["أمُجَبّرَ القلب الكسير بعطفهِ","يا شافي الطرف الضرير من العما",76,"م",2,0],["أمجرعي كأس المنية","دونَ ذياكَ الرضاب",77,"ب",1,0],["أم جَفاك الحبيبُ مثلي فأمسيت","تُعاني أسىً وداءً دخيلا",78,"ل",2,0],["أَمُجمِّعَ الأَخلاقِ رُزؤُك لَم يَدَع","حُزناً مِن الأَحزانِ إِلا جَمَّعا",79,"ع",2,0],["أَمْ جَنَّةُ الخُلْدِ فيها الحُورُ قَدْ بَرَزَتْ","يَقْصُفْنَ في الرَّوْضِ بينَ الدَّلّ والصَّلَفِ",80,"ف",1,0],["أمجشميها كل ليل حندس","شعثا تنفس كل مرت أجله",81,"ه",1,0],["أم جنان فيها خمائل زهر","وفنون الثمار في الافنان",82,"ن",1,0],["أمجزرة الأرواح ما فيكِ عاقلٌ","وهلْ عادَ من هول المنيّةِ عاقلُ؟",83,"ل",1,0],["أم جنينا بما عملنا إليهم","ملبسا باليا ودرعا صديا",84,"ي",2,0],["أمجاد الأمة قد هُدِمت","والأمة ما زالت تخضع",85,"ع",1,0],["أم جنةٌ ..بالأرضِ كانت قسمتي؟","تُغنِي عن الفردوسِ يَعلو أنهرا ؟!",86,"ر",2,0],["أم جنة بالأرضِ أضحت قسمتي؟","جاءت من الفردوس تهدي كوثرا؟!",87,"ر",2,0],["أم جئتَ تنذر قوماً ما ارعَوَوا أبدا","عن غيّهم , فهمُ خلقٌ بلا نظرِ ؟",88,"ر",1,0],["أم جئت تشعل نار الشوق في خلدي","وتطفئ الصبر بالذكرى وتشقيني",89,"ن",2,0],["امجد ماعاده مثل ماكان امجد","يعني طبيعي لو عليكم تغيّب",90,"ب",1,0],["أمْجَادُنَا بَاتَت حُطامَ خُضوعِنا","وأضَاعَ أنْصَارُ العِدَى مَرْسَاتَها",91,"ا",1,0],["أمجادُنا الأولى التي","كانت لنا باتت حرام.",92,"م",1,0],["أم جراحُ الكوخ سجّا","ها منَ البؤس الزمانُ",93,"ن",1,0],["أَمْ جُنُونٌ مَا مَسَّهُ شَغَفٌ،دَمْ","عَةُ ثَكْلَى تَلُوكُهَا اَلْأَنْدَاءُ ؟",94,"ا",2,0],["أم جفاها في النوم طيف كراها","فأماطت لثامها مكشوفا",95,"ف",2,0],["أم جاذباه الحبل لما غفا","عن حلم يأبى له أن يفيق ؟",96,"ق",1,0],["أم جادك المزن فياّضا بصيِّبه","وأومض البرق في الظلماء من إضم",97,"م",1,0],["أم جبنها، أم كشكها،","\"أم ذي \"\"القريشة\"\" بالقرب؟ \"",98,"ب",1,0],["أم جئتِ في طلبِ الهوى وأنا","ذو خبرةٍ بالعشقِ والغزل ؟ !",99,"ل",1,0],["أمجادنا تلك لم تبرح تطوف بنا","فوق السماكين هذا المجد إن ترمِ",100,"م",1,0],["أم جناناً كن منها","كأبينا قد خرجنا",101,"ن",2,0],["أم جعلت ذلك الحق","ق على أرضك حبسا",102,"ا",1,0],["أم جرت كلها كدافق نهرٍ","من أحاسيس أضرمت إضراما",103,"م",2,0],["أمْ جِئْتِ عَوْناً للرّبيعِ ومِنْحَةً ؟؟","مِنْ بعْدِ ما فَرَضَ الخَريفُ ذُبولَهْ",104,"ل",2,0],["أمجادُ أجدادنا من ذا سيرجعها","إلا الأسودُ التي لم تنسَ باريها",105,"ي",3,0],["أمجترئ دهري على أما درى","أنا الصل في أنيابه السم ناقع",106,"ع",1,0],["أمجنونة أنت حتى تظني","بأن الكسور ستحتاج جبرا",107,"ر",2,0],["أم جئتني نارًا ترومُ حَشاشتي","فتذيبُني في عصفةِ الأوهامِ",108,"م",1,0],["أَمجَادُ تاريخ وَوحيُ نُبُوة","وَجَلالُ إِسْراءٍ وَعِزَّةُ مُسْلِمِ",109,"م",1,0]]}