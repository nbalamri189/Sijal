{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[79,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[88,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[95,"دعا الوفاء وهذا وقت تبيان","https://www.aldiwan.net/poem11236.html","البسيط"],[95,"بلغت أقصى العمر الفاني","https://www.aldiwan.net/poem11247.html","السريع"],[90,"دار ذا الدهر مداره","https://www.aldiwan.net/poem44820.html","مجزوء الرمل"],[45,"إني لأعلم واللبيب خبير","https://www.aldiwan.net/poem9573.html","الكامل"],[45,"ثياب كريم ما يصون حسانها","https://www.aldiwan.net/poem10579.html","الرجز"],[101,"غرناطة","https://www.aldiwan.net/poem6258.html","عموديه"],[63,"أقول لحنان العشي المغرد","https://www.aldiwan.net/poem51699.html","الطويل"],[68,"أبت الوصال مخافة الرقباء","https://www.aldiwan.net/poem38501.html","الكامل"],[68,"لم تبغ همتك المحل العالي","https://www.aldiwan.net/poem38695.html","الكامل"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55179","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55138","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54882","الكامل"],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[98,"سمر","https://www.poetsgate.com/ViewPoem.aspx?id=17489",""],[92,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[172,"كره الله ما أحب الأعادي","https://www.aldiwan.net/poem1621.html",""],[288,"هل ذا اغتياب عن هوى","https://www.aldiwan.net/poem39360.html","مجزوء الرجز"],[301,"أعطى قليلا واستردا","https://www.aldiwan.net/poem36857.html","عموديه"],[367,"أعلى العهد القديم","https://www.aldiwan.net/poem60643.html","مجزوء الرمل"],[383,"قد نمت عن أشواقه","https://www.aldiwan.net/poem49233.html","مجزوء الكامل"],[405,"كم ذا يذوب أسى وكم يتجلد","https://www.aldiwan.net/poem46938.html","الكامل"],[406,"أما آن للقلب أن يعقلا","https://www.aldiwan.net/poem33484.html","المتقارب"],[406,"بالله هل نور شمس","https://www.aldiwan.net/poem33719.html","المجتث"],[406,"عجبت لقوم ينسبون مقالة","https://www.aldiwan.net/poem33933.html","الطويل"],[406,"كل أخبار الهوى قد رويت","https://www.aldiwan.net/poem34111.html","الرمل"],[406,"هل جرى مني لذا الهجر ذنوب","https://www.aldiwan.net/poem34159.html","الرمل"],[455,"في الشتاء العويل والأشجان","https://www.aldiwan.net/poem61727.html","الخفيف"],[460,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[463,"تمنى مقامي والمطالع ضلة","https://www.aldiwan.net/poem15107.html","الطويل"],[466,"أمجادلي فيمن رويت صفاته","https://www.aldiwan.net/poem3161.html","عموديه"],[577,"أمجلس لهوي ليس لي منك مجلس","https://www.aldiwan.net/poem3058.html","الطويل"]],"verses":[["أَم جَنايا بَني عَتيقٍ فَمَن يَغ","دِر فَإِنّا مِن حَربِهِم بُراءُ",0,"ا",2,0],["أمُجاهِدَ دِينِ اللهِ لقدْ","أمّنْتَ بصارِمِكَ الطُّرُقا",1,"ق",2,0],["أَم جَمَعتَ الأَعداءَ فَوقَ صَعيدٍ","وَخَلَطتَ الأُسودَ بِالآرامِ",2,"م",1,0],["أمْجِدْ بِسَمْعَانَ إذْ أَبْدَى رَوَائِعِهَا","وَرُدَّ حُجَّةَ من مَارَى بِبُرْهَانِ",3,"ن",1,0],["أَمْجِدْ بِذِكْرَى زَمَنٍ مُنْقَضٍ","جَعَلْتَهُ غُرَّةَ أَزْمَانِ",4,"ن",1,0],["أم جُيوب زَرّها الده","ر على كل دَعاره",5,"ر",2,0],["أَمُجاوِرَ الديماسِ رَهنَ قَرارَةٍ","فيها الضِياءُ بِوَجهِهِ وَالنورُ",6,"ر",1,0],["أَم جِئتَهُ مُخَندِقاً حُصونَهُ","إِنَّ الجِيادَ وَالقَنا يَكفينَهُ",7,"ن",2,0],["أمجادها؟ ومسحت جرحاً نازف","ومسحت جرحاً ثانياً بفؤادي",8,"د",2,0],["أمُجُّ له العَذْبَ النَّميرَ كأنَّه","مُجاجةُ مُحمَرِّ الحماليقِ أسوَدِ",9,"د",1,0],["أُمُجَندِلَ الأَبطالِ بَل يا مُنتَهى","الآمالِ بَل يا كَعبَةَ الشُعَراءِ",10,"ا",2,0],["أَمُجَدِّلَ الأَبطالِ بَل يا باذِلَ ال","أَموالِ بَل يا حامِلَ الأَثقالِ",11,"ل",1,0],["أمْ جميعٌ عَلَى الحمار لقد جَل","لَ حِمَارٌ بِجَمْعِهِم مَشَّاءُ",12,"ا",2,0],["أم جاء طيبةَ من أربابها نباًٌ","أم أنّ كهّانها بالوحي قد جاؤوا",13,"ا",1,0],["أَمْجَادِ مِصْرَ وَأَجْوَادُ الأجَانِبِ مِنْ","بُنَاةِ جَاهٍ وَمِنْ أَرْبَابِ أَعْمَالِ",14,"ل",1,0],["أَمَجْدُكَ الضَّخْمُ البَعِيدُ المَدَى","مُجْتَمِعٌ في جِسْمِهِ النَّاحِلِ",15,"ل",1,1],["أَمْجِدْ بِطَلَعت حَرْبِ فِي زُعَمائِهَا","وَفؤادِ سُلطَانِ فتَاهَا العَبْقَرِي",16,"ر",2,0],["أم جنايا بني عتيقٍ فإنا","منكم إن غدرتم برآء",17,"ا",2,0],["أم جندول الحبيب","إلى لياليه حننت ؟",18,"ت",1,0],["امجانباً عرض البسيط أعيذه","من ان يَضيقَ عليك رحبٌ فضائه",19,"ا",3,0],["أَم جَلاءُ الشُراةِ أَم أَمنُهُ السُب","لَ بِقَتلِ اللُصوصِ وَالمُرّادِ",20,"د",1,0],["أم جائز لمن نوى","اظهار حال الآدمي",21,"ي",1,0],["أم جاء يعبث؟ والهوى","أضحى بحمدِ الله جدّا",22,"د",2,0],["أم جفاني إذ رآني","واللَّيالي من خُصومي",23,"م",2,0],["أَمجرعي كاس النَوى","وَالمَوت دونَ مَذاقِهِ",24,"ق",2,0],["أَمُجَرِّدَ الأسيافِ لم يُغْمَدْنَ في","شيءٍ سِوى الهاماتِ والأكبادِ",25,"د",1,0],["أمجنون ليلى به نازل","ترى لا سواه له مدخلا",26,"ل",2,0],["أم جئت بالسحر شعراً","لقد تحير حَدْسي",27,"س",2,0],["أمجتهداً يُدْعَى ابن هند محققاً","ومن قال هذا فهو لا شك مفتري",28,"ر",2,0],["أم جفاها الْمُزْنُ بعدي مثلما","قد جافني زمني لا جفيت",29,"ت",1,0],["أم جرى مني ما عَنِّي خفا","فعتاب الخِلِّ للخِل يطيب",30,"ب",1,0],["أم جُننتم أينَ الحفاوهُ منكم","أيلاقى التَّفضُّل النُّكرانُ",31,"ن",1,0],["أم جئتِنا بسِحرِها","تلفّتاً ولَمحا",32,"ح",2,0],["أمجداً بال سعيٍ لقد كذبتكمُ","نفوس ثناها الذلُّ أن تترفَّعا",33,"ع",2,0],["أمجادلي فيمن رويتُ صفاتهِ","عن هل أتى وشرفنَ من أوصافِ",34,"ف",1,1],["أَمجلسَ لهْوِي ليسَ لي منكَ مَجْلسُ","لأَوْحشتَ لمَّا غاب لي عنك مؤْنِسُ",35,"س",1,1]]}