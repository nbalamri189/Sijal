{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[77,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[86,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[93,"دعا الوفاء وهذا وقت تبيان","https://www.aldiwan.net/poem11236.html","البسيط"],[93,"بلغت أقصى العمر الفاني","https://www.aldiwan.net/poem11247.html","السريع"],[88,"دار ذا الدهر مداره","https://www.aldiwan.net/poem44820.html","مجزوء الرمل"],[43,"إني لأعلم واللبيب خبير","https://www.aldiwan.net/poem9573.html","الكامل"],[43,"ثياب كريم ما يصون حسانها","https://www.aldiwan.net/poem10579.html","الرجز"],[99,"غرناطة","https://www.aldiwan.net/poem6258.html","عموديه"],[61,"أقول لحنان العشي المغرد","https://www.aldiwan.net/poem51699.html","الطويل"],[66,"أبت الوصال مخافة الرقباء","https://www.aldiwan.net/poem38501.html","الكامل"],[66,"لم تبغ همتك المحل العالي","https://www.aldiwan.net/poem38695.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55179","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55138","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54882","الكامل"],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[96,"سمر","https://www.poetsgate.com/ViewPoem.aspx?id=17489",""],[90,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""]],"verses":[["أَم جَنايا بَني عَتيقٍ فَمَن يَغ","دِر فَإِنّا مِن حَربِهِم بُراءُ",0,"ا",2,0],["أمُجاهِدَ دِينِ اللهِ لقدْ","أمّنْتَ بصارِمِكَ الطُّرُقا",1,"ق",2,0],["أَم جَمَعتَ الأَعداءَ فَوقَ صَعيدٍ","وَخَلَطتَ الأُسودَ بِالآرامِ",2,"م",1,0],["أمْجِدْ بِسَمْعَانَ إذْ أَبْدَى رَوَائِعِهَا","وَرُدَّ حُجَّةَ من مَارَى بِبُرْهَانِ",3,"ن",1,0],["أَمْجِدْ بِذِكْرَى زَمَنٍ مُنْقَضٍ","جَعَلْتَهُ غُرَّةَ أَزْمَانِ",4,"ن",1,0],["أم جُيوب زَرّها الده","ر على كل دَعاره",5,"ر",2,0],["أَمُجاوِرَ الديماسِ رَهنَ قَرارَةٍ","فيها الضِياءُ بِوَجهِهِ وَالنورُ",6,"ر",1,0],["أَم جِئتَهُ مُخَندِقاً حُصونَهُ","إِنَّ الجِيادَ وَالقَنا يَكفينَهُ",7,"ن",2,0],["أمجادها؟ ومسحت جرحاً نازف","ومسحت جرحاً ثانياً بفؤادي",8,"ي",1,0],["أمُجُّ له العَذْبَ النَّميرَ كأنَّه","مُجاجةُ مُحمَرِّ الحماليقِ أسوَدِ",9,"د",1,0],["أُمُجَندِلَ الأَبطالِ بَل يا مُنتَهى","الآمالِ بَل يا كَعبَةَ الشُعَراءِ",10,"ا",2,0],["أَمُجَدِّلَ الأَبطالِ بَل يا باذِلَ ال","أَموالِ بَل يا حامِلَ الأَثقالِ",11,"ل",1,0],["أمْ جميعٌ عَلَى الحمار لقد جَل","لَ حِمَارٌ بِجَمْعِهِم مَشَّاءُ",12,"ا",2,0],["أم جاء طيبةَ من أربابها نباًٌ","أم أنّ كهّانها بالوحي قد جاؤوا",13,"ا",1,0],["أَمْجَادِ مِصْرَ وَأَجْوَادُ الأجَانِبِ مِنْ","بُنَاةِ جَاهٍ وَمِنْ أَرْبَابِ أَعْمَالِ",14,"ل",1,0],["أَمَجْدُكَ الضَّخْمُ البَعِيدُ المَدَى","مُجْتَمِعٌ في جِسْمِهِ النَّاحِلِ",15,"ل",1,1],["أَمْجِدْ بِطَلَعت حَرْبِ فِي زُعَمائِهَا","وَفؤادِ سُلطَانِ فتَاهَا العَبْقَرِي",16,"ر",2,0],["أم جنايا بني عتيقٍ فإنا","منكم إن غدرتم برآء",17,"ا",2,0],["أم جندول الحبيب","إلى لياليه حننت ؟",18,"ت",1,0],["امجانباً عرض البسيط أعيذه","من ان يَضيقَ عليك رحبٌ فضائه",19,"ا",3,0]]}