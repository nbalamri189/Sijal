{"poems":[[53,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[53,"دع من دموعك بعد البين للدمن","https://www.aldiwan.net/poem29648.html","البسيط"],[53,"أعلى الغور تعرفت الخياما","https://www.aldiwan.net/poem29816.html","الرمل"],[53,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[53,"آب الرديني والحسام معا","https://www.aldiwan.net/poem30137.html","المنسرح"],[53,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[53,"أي العيون تجانب الأقذاء","https://www.aldiwan.net/poem30780.html","الكامل"],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[77,"فتحت سعودك كل باب مبهم","https://www.aldiwan.net/poem36122.html","الكامل"],[9,"ما تعيف اليوم في الطير الروح","https://www.aldiwan.net/poem21921.html","الرمل"],[86,"صونوا يراع علي في متاحفكم","https://www.aldiwan.net/poem10487.html","البسيط"],[86,"كم مر بي فيك عيش لست أذكره","https://www.aldiwan.net/poem10506.html","البسيط"],[86,"طف بالأريكة ذات العز والشان","https://www.aldiwan.net/poem68949.html","البسيط"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[93,"يا غرباء الحمى سلاما","https://www.aldiwan.net/poem11291.html","مخلع البسيط"],[41,"حتام نكتم حزننا حتاما","https://www.aldiwan.net/poem42355.html","الكامل"],[88,"يا إمام الهدى ورب المعالي","https://www.aldiwan.net/poem44433.html","الخفيف"],[88,"نعمت الدار للنفيض دارا","https://www.aldiwan.net/poem44999.html","الخفيف"],[88,"لا يبلغ المرء منتهى أربه","https://www.aldiwan.net/poem45001.html","المنسرح"],[88,"ما للحقيقة من بداية","https://www.aldiwan.net/poem45063.html","مجزوء الكامل"],[72,"عوض بكأسك ما أتلفت من نشب","https://www.aldiwan.net/poem18227.html","البسيط"],[72,"قمرا نراه أم مليحا أمردا","https://www.aldiwan.net/poem18555.html","الكامل"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[51,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[51,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[51,"قالوا هجاك أبو حفص فقلت لهم","https://www.aldiwan.net/poem61877.html","البسيط"],[51,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[51,"هجرتني ظلما لتحميل واش","https://www.aldiwan.net/poem64929.html","الخفيف"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[51,"قل لمن ألبس الجمال جمالا","https://www.aldiwan.net/poem65878.html","الخفيف"],[51,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[51,"غابن الحمد حقه مغبونه","https://www.aldiwan.net/poem66432.html","الخفيف"],[91,"كن بلسما إن صار دهرك أرقما","https://www.aldiwan.net/poem62736.html","عموديه"],[91,"منذ افترقنا لم أذق وسنا","https://www.aldiwan.net/poem62782.html","عموديه"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[70,"يا سيدا بوداده","https://www.aldiwan.net/poem42434.html","مجزوء الكامل"],[70,"خذ فارغا وهاته ملآنا","https://www.aldiwan.net/poem42685.html","الرجز"],[70,"جعل الرقاد لكي يواصل موعدا","https://www.aldiwan.net/poem42964.html","الكامل"],[89,"يا موطنا قد ذبت فيه غراما","https://www.aldiwan.net/poem44748.html","الكامل"],[45,"من قائل للزمان ما أربه","https://www.aldiwan.net/poem11054.html","المنسرح"],[45,"لم تبلغ الحق ولم تنصف","https://www.aldiwan.net/poem65144.html","السريع"],[61,"وهي الشموس فإن رأين طوالعا","https://www.aldiwan.net/poem51459.html","الكامل"],[61,"شفاه قربا وقد أشفى على العطب","https://www.aldiwan.net/poem51799.html","البسيط"],[49,"الخير والشر عادات وأهواء","https://www.aldiwan.net/poem10313.html","البسيط"],[49,"قد سمعنا الوعظ لوينفعنا","https://www.aldiwan.net/poem10334.html","الرمل"],[49,"خانك الطرف الطموح","https://www.aldiwan.net/poem62028.html","مجزوء الرمل"],[49,"أين من كان قبلنا أين أينا","https://www.aldiwan.net/poem63128.html","الخفيف"],[66,"حبذا أرض ماردين وبر الظل","https://www.aldiwan.net/poem40660.html","الخفيف"],[80,"أي خطب عن قوسه الموت يرمي","https://www.aldiwan.net/poem31283.html","الخفيف"],[69,"قلب كواه البين حتى أنضجا","https://www.aldiwan.net/poem28762.html","الكامل"],[69,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[69,"في دير بيرة دادخين حور","https://www.aldiwan.net/poem28805.html","الكامل"],[69,"ذهب الصدق وإخلاص العمل","https://www.aldiwan.net/poem29305.html","الرمل"],[105,"حملت سناك مواكب الأعوام","https://www.aldiwan.net/poem42074.html","الكامل"],[105,"الله أكبر باسم الله أهديها","https://www.aldiwan.net/poem43131.html","البسيط"],[105,"كذب الملوك ومن يحاول عندهم","https://www.aldiwan.net/poem43400.html","الكامل"],[105,"رحمة يا أبا بصير ونعمى","https://www.aldiwan.net/poem44063.html","الرمل"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"كسر الحب نشاطي","https://www.aldiwan.net/poem64369.html","مجزوء الرمل"],[48,"وملحة في العذل ذات نصيحة","https://www.aldiwan.net/poem64431.html","الكامل"],[50,"آب ليلي ليت ليلي لم يأب","https://www.aldiwan.net/poem64814.html","الرمل"],[46,"ما لي بما بعد الردى مخبره","https://www.aldiwan.net/poem22635.html","السريع"],[46,"أوف ديوني وخل أقراضي","https://www.aldiwan.net/poem22894.html","المنسرح"],[15,"يا خليلي اربعا واستخبرا المنزل","https://www.aldiwan.net/poem45251.html","الرمل"],[8,"خليلي عوجا ساعة وتهجرا","https://www.aldiwan.net/poem21785.html","الطويل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39548","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39636","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20249","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54563","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54720","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54965","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54629","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54978","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54542","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142062","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43778","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54329","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54318","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[106,"إلى القائد المظفر","https://www.poetsgate.com/ViewPoem.aspx?id=179595",""],[106,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[106,"الطبيب الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=179681",""],[106,"زورق في الفضاء","https://www.poetsgate.com/ViewPoem.aspx?id=179453",""],[106,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[106,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[106,"فجيعة في ساعة","https://www.poetsgate.com/ViewPoem.aspx?id=179526",""],[77,"فتحت سعودك كل باب مبهم","https://www.poetsgate.com/ViewPoem.aspx?id=34204",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[96,"الطريد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66355&r=&rc=31",""]],"verses":[["كَم رَمَوا بِالمَطِيِّ تِل","كَ الحُزونَ الفَيافِيا",0,"ي",2,0],["كَم راشَنا وَبَرانا غَيرَ مُكتَرِثٍ","بِما نُعالِجُ بَريَ القِدحِ بِالسَفَنِ",1,"ن",1,0],["كَم رَعَينا العَيشَ فيهِ ناضِراً","وَوَرَدنا أَوَّلَ الحُبِّ جِماما",2,"م",2,0],["كَم رامَها مِنكَ الجَبانُ فَراوَغَت","شَقّاءَ يَلعَبُ شِدقُها بِالمَسحَلِ",3,"ل",1,0],["كَم رَحِمٍ بِالعُقوقِ نَقطَعُها","وَرَحِمُ الوُدِّ غَيرُ مُنقَطِعَه",4,"ع",2,0],["كَم رِقابٍ مِن بَني فاطِمَةٍ","عُرِقَت ما بَينَهُم عَرقَ المِدى",5,"ا",1,0],["كَم راحِلٍ وَلَّيتُ عَنهُ وَمَيِّتٍ","رَجَعَت يَدي مِن تُربِهِ غَبراءَ",6,"ا",2,0],["كمْ راضَ صعْباً لا يُراضُ مُعاصِياً","كمْ خاضَ حرْباً لا تُخاضُ ضَروسا",7,"س",2,0],["كَمْ رَايَةٍ لِلْفَتْحِ فَوْقَ رُؤُوسِهِمْ","خَفَقَتْ وَكَمْ مَلْكٍ هُنَاكَ مُسَوَّمِ",8,"م",1,0],["كَم رَأَينا مِن أُناسٍ هَلَكوا","وَرَأَينا المَرءَ عَمراً بِطَلَح",9,"ح",1,0],["كَم رَدَّ عَنّا وَعَينُ الغَربِ طامِحَةٌ","مِنَ الرَزايا وَكَم جَلّى مِنَ الكُرَبِ",10,"ب",1,0],["كَم رَوَّحَ الدَمعُ عَن قَلبي وَكَم غَسَلَت","مِنهُ السَوابِقُ حُزناً في حَناياهُ",11,"ا",2,0],["كَم رامَ شَأوي فَلَم يُدرِك سِوى صَدَفٍ","سامَحتُ فيهِ لِنَظّامٍ وَوَزّانِ",12,"ن",1,0],["كَمْ رَاحَ جَمْعٌ فِدَى فَرْدٍ وَكَمْ بُذِلَتْ","فِي مُشْتَرَى سَيِّدٍ أَرْوَاحُ عُبْدَانِ",13,"ن",1,0],["كَمْ رَاحَ قَتْلَى دُونَ مَرَامٍ","وَقَوْمُهُمْ أَدْرَكُوا المَرَامَا",14,"م",2,0],["كَم رَاغبِينَ وَرَاهبينَ وَبُؤَّسٍ","عُصِمُوا بِقُربِ جَنَابِها إِعصَامَا",15,"م",2,0],["كم رأيناك جاهداً تتسامى","بفعال غدت له الناس أسرى",16,"ر",2,0],["كم رفعنا للعلم في الأرض بُرجاً","وبنَيْنا له كغُمدان دارا",17,"ر",2,0],["كم رفع العلم بيت ذي ضَعَة","فقصّر الناس عن مدى حَسَبه",18,"ب",2,0],["كَم راح مرفوعاً لها","فوق الربا علَم وراية",19,"ا",3,0],["كم رمتُ كتمَ الجوى فيه فنمَّ به","إلى الوُشاةِ لسانُ المدمعِ السرب",20,"ب",1,0],["كم راحةٍ أوليتها من راحةٍ","ويدٍ صنعت بها لمفتقرٍ يدا",21,"د",2,0],["كم رأيتُ المُكلَّفين جنوداً","ينصرون الأباعد الغُرباءَ",22,"ا",2,0],["كم رايةٍ للمجد فا","زَ بِهَا وأخطأها عَرابهْ",23,"ب",2,0],["كم رأى القلبُ حَتْفَهُ مُذْ نَوَيْتُمْ","ما نويتمْ وكم عرتْهُ الكروبُ",24,"ب",1,0],["كم رأينا إنهابَكُم ما ملكْتم","في العطايا إلا بقايا تَقُوتُ",25,"ت",1,0],["كم رأينا لجُود كفَّيْهِ مَصْفُو","داً طليقاً من حِلْيَةِ المصْفُودِ",26,"د",1,0],["كم ركْعةٍ ركع الصَّفعانُ تحت يدي","ولم يقل سمع الله لمن حمدَهْ",27,"د",2,0],["كم رأى الله منك عَرْفاً وعُرْفاً","لا يرى شُكْرَ بعضه تخليدَكْ",28,"ك",1,0],["كم رأينا الأكفَّ جادتْ قفاه","برذاذٍ من وقعها ورشاش",29,"ش",1,0],["كم رام ذو الجد والأجداد غايتَهُ","فقام ذو الجد والأجداد زحافا",30,"ف",2,0],["كم رجاءٍ فيكم أثار جمالاً","وعطاءٍ منكم أناخَ جِمالا",31,"ل",2,0],["كم رضيع هناكَ قد فطموه","بشبا السيف قبل حينِ الفطام",32,"م",1,0],["كم رُكونٍ جنى عليكَ حِذاراً","مَنْ أطالَ الركونَ قلَّ رُكونه",33,"ن",2,0],["كَم رَوَّعوا بِجَهَنَّمٍ أَرواحَنا","فَتأَلَّمَت مِن قَبلُ أَن تَتَأَلَّما",34,"م",2,0],["كَم رُحتُ أَستَسقي سَحائِبَها","فَهَمَت وَلَكِن مِحنَةً وَضَنى",35,"ن",2,0],["كَم رَيبَةٍ دَبَّت إِلى مَضجَعي","مَعَ الجَمالِ الرائِعِ المُمكِنِ",36,"ن",1,0],["كَم راحَةٍ قَد نِلتُها","مِن جودِ تِلكَ الراحَتَينِ",37,"ن",1,0],["كَم رَفَعَت مُتَّضِعاً وَكَرَّمَت","مُبَخَّلاً وَشَجَّعَت جَبانا",38,"ن",2,0],["كَم راحَ نَحوي لائِمٌ وَغَدا وما","راحَ المَلامُ بِمَسمَعَيَّ وَلا غَدا",39,"د",2,0],["كم ريشة في كف اروع بددت","جيشا تدجج بالحديد لهاما",40,"م",2,0],["كَم راحَ طَلقاً وَراحَ تالِدُهُ","مَطِيَّةً لِلحُقوقِ تَعتَقِبُه",41,"ب",2,0],["كَم رَفَعَت حالي إِلى حالِهِ","يَدٌ مَتى تَخلُف غِنىً تُتلِفِ",42,"ف",1,0],["كم روضةٍ للمَجدِ زاهرةِ الرُّبا","ظَمِئَت إليك فكنتَ غَيثاً هَاطِلا",43,"ل",2,0],["كم رُضتُ بالفِكْر منها روضةً أُنُفاً","تفتَّحَ الزَّهْرُ منها عن جَنَى الأدبِ",44,"ب",1,0],["كَم راتِعٍ في ظِلالِ العَيشِ تَتبَعُهُ","مِنهُنَّ داهِيَةٌ تَرتَجُّ دَهياءُ",45,"ا",2,0],["كَم رَأَينا مِن مُلوكٍ سادَةٍ","رَجَعَ الدَهرُ عَلَيهِم فَاِنقَلَب",46,"ب",1,0],["كَم رَأَينا مِن عَزيزٍ","طُوِيَت عَنهُ الكُشوحُ",47,"ح",1,0],["كَم رَأَينا مِن مَيِّتٍ كانَ حَيّاً","وَوَشيكاً يُرى بِنا ما رَأَينا",48,"ن",2,0],["كَم رَأَينا لَها وَفيها وَمِنها","صُوَراً تَسفِكُ الدِماءَ دُماها",49,"ا",3,0],["كم رأينا وكم سمعنا المنايا","غيرَ أنّ الهوَى يُصِمّ ويعمي",50,"ي",1,0],["كم ردَّ عيناً كم برا ذا عاهةٍ","بدعائهِ كمْ شدَّةٍ قدْ فرَّجا",51,"ج",2,0],["كمْ راقَبتْ أممٌ من