 الخضراء","https://www.aldiwan.net/poem10308.html","عموديه"],[402,"فيك أما في سواك فلا","https://www.aldiwan.net/poem46911.html","المديد"],[402,"يا دار سلمى بسفح ذي سلم","https://www.aldiwan.net/poem46982.html","المنسرح"],[403,"كل أخبار الهوى قد رويت","https://www.aldiwan.net/poem34111.html","الرمل"],[405,"قل لمن رام سموا وعلامه","https://www.aldiwan.net/poem49733.html","الرمل"],[406,"عصرت مدامعك الأناة المعصر","https://www.aldiwan.net/poem50167.html","الكامل"],[409,"حمائم الأيك هيجتن أشجانا","https://www.aldiwan.net/poem31850.html","البسيط"],[416,"لك بالمعالي رتبة تختارها","https://www.aldiwan.net/poem54015.html","الكامل"],[416,"كن بالمدامة للسرور متمما","https://www.aldiwan.net/poem54035.html","الكامل"],[416,"ذكراني عهد الصبا بسعاد","https://www.aldiwan.net/poem54075.html","الخفيف"],[416,"شرب القوم من لماك عقارا","https://www.aldiwan.net/poem54115.html","الخفيف"],[416,"هل عرفت الديار من آل نعمى","https://www.aldiwan.net/poem54169.html","الخفيف"],[432,"هل لركب العراق بعد نجوده","https://www.aldiwan.net/poem12470.html","الخفيف"],[432,"احكم على الثقلين الإنس والجان","https://www.aldiwan.net/poem12753.html","البسيط"],[437,"ولى ولم يقض منكم وطره","https://www.aldiwan.net/poem2609.html","المنسرح"],[441,"رضى بما قدر الباري وألزمنا","https://www.aldiwan.net/poem14486.html","البسيط"],[452,"يا ليالي السفح من عهد الصبا","https://www.aldiwan.net/poem13926.html","الرمل"],[453,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[458,"من جب غارب هاشم وسنامها","https://www.aldiwan.net/poem55867.html","الكامل"],[458,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[461,"يا للصوارم والرماح الذبل","https://www.aldiwan.net/poem15925.html","الكامل"],[464,"أضاء ثغر سليمى ليلة العلم","https://www.aldiwan.net/poem3473.html","عموديه"],[464,"وصل السقام فصد عن لوامه","https://www.aldiwan.net/poem3475.html","عموديه"],[464,"سقيت دمشق وجارتا جيرونها","https://www.aldiwan.net/poem3549.html","عموديه"],[477,"كم رضت جامح قلبي عنكم فأبى","https://www.aldiwan.net/poem15242.html","البسيط"],[477,"آليت لا حلت ولا حلتم","https://www.aldiwan.net/poem15270.html","السريع"],[477,"كم يذهب هذا العمر في الخسران","https://www.aldiwan.net/poem15365.html","الدوبيت"],[482,"لاح لي برق بنجد فسبا","https://www.aldiwan.net/poem24283.html","الرمل"],[495,"وفتية كنجوم الليل مسعدة","https://www.aldiwan.net/poem10247.html","البسيط"],[500,"زاحمتنا بوهمها أسماء","https://www.aldiwan.net/poem37652.html","الخفيف"],[500,"أسكرت أهل الوحا خمرتنا","https://www.aldiwan.net/poem37672.html","الرمل"],[500,"كم رجت الأرض بالأعداء واضطربت","https://www.aldiwan.net/poem37815.html","البسيط"],[515,"يا دار عليك سعد المشتري","https://www.aldiwan.net/poem12135.html","الكامل"],[515,"كن لي على شكر ما أوليت من نعم","https://www.aldiwan.net/poem12253.html","البسيط"],[529,"يا ناقدا لكلام ليس يفهه","https://www.aldiwan.net/poem37468.html","البسيط"],[551,"قال لجاف كلما سيم","https://www.aldiwan.net/poem47177.html","مجزوء الرمل"],[551,"أرسلها ترعى ألاء ونفل","https://www.aldiwan.net/poem47254.html","الرجز"],[551,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[551,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[551,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[553,"كم رأينا من أناس هلكوا","https://www.aldiwan.net/poem68358.html","الرمل"],[553,"هاجت وساوسه برومة دور","https://www.aldiwan.net/poem68402.html","الكامل"],[558,"غزال ذاك الحمى صبري قضى فيه","https://www.aldiwan.net/poem33644.html","البسيط"],[564,"إن نكن يا حبيب بالرغم غبنا","https://www.aldiwan.net/poem861.html",""],[567,"من يبك من وجد على هالك","https://www.aldiwan.net/poem69768.html","السريع"],[586,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"],[586,"يا رب قد علقته","https://www.aldiwan.net/poem17603.html","مجزوء الكامل"],[586,"نعم هي الدار من يناديها","https://www.aldiwan.net/poem17965.html","المنسرح"]],"verses":[["كَم رَمَوا بِالمَطِيِّ تِل","كَ الحُزونَ الفَيافِيا",0,"ي",2,0],["كَم راشَنا وَبَرانا غَيرَ مُكتَرِثٍ","بِما نُعالِجُ بَريَ القِدحِ بِالسَفَنِ",1,"ن",1,0],["كَم رَعَينا العَيشَ فيهِ ناضِراً","وَوَرَدنا أَوَّلَ الحُبِّ جِماما",2,"م",2,0],["كَم رامَها مِنكَ الجَبانُ فَراوَغَت","شَقّاءَ يَلعَبُ شِدقُها بِالمَسحَلِ",3,"ل",1,0],["كَم رَحِمٍ بِالعُقوقِ نَقطَعُها","وَرَحِمُ الوُدِّ غَيرُ مُنقَطِعَه",4,"ع",2,0],["كَم رِقابٍ مِن بَني فاطِمَةٍ","عُرِقَت ما بَينَهُم عَرقَ المِدى",5,"ا",1,0],["كَم راحِلٍ وَلَّيتُ عَنهُ وَمَيِّتٍ","رَجَعَت يَدي مِن تُربِهِ غَبراءَ",6,"ا",2,0],["كمْ راضَ صعْباً لا يُراضُ مُعاصِياً","كمْ خاضَ حرْباً لا تُخاضُ ضَروسا",7,"س",2,0],["كَمْ رَايَةٍ لِلْفَتْحِ فَوْقَ رُؤُوسِهِمْ","خَفَقَتْ وَكَمْ مَلْكٍ هُنَاكَ مُسَوَّمِ",8,"م",1,0],["كَم رَأَينا مِن أُناسٍ هَلَكوا","وَرَأَينا المَرءَ عَمراً بِطَلَح",9,"ح",1,0],["كَم رَدَّ عَنّا وَعَينُ الغَربِ طامِحَةٌ","مِنَ الرَزايا وَكَم جَلّى مِنَ الكُرَبِ",10,"ب",1,0],["كَم رَوَّحَ الدَمعُ عَن قَلبي وَكَم غَسَلَت","مِنهُ السَوابِقُ حُزناً في حَناياهُ",11,"ا",2,0],["كَم رامَ شَأوي فَلَم يُدرِك سِوى صَدَفٍ","سامَحتُ فيهِ لِنَظّامٍ وَوَزّانِ",12,"ن",1,0],["كَمْ رَاحَ جَمْعٌ فِدَى فَرْدٍ وَكَمْ بُذِلَتْ","فِي مُشْتَرَى سَيِّدٍ أَرْوَاحُ عُبْدَانِ",13,"ن",1,0],["كَمْ رَاحَ قَتْلَى دُونَ مَرَامٍ","وَقَوْمُهُمْ أَدْرَكُوا المَرَامَا",14,"م",2,0],["كَم رَاغبِينَ وَرَاهبينَ وَبُؤَّسٍ","عُصِمُوا بِقُربِ جَنَابِها إِعصَامَا",15,"م",2,0],["كم رأيناك جاهداً تتسامى","بفعال غدت له الناس أسرى",16,"ر",2,0],["كم رفعنا للعلم في الأرض بُرجاً","وبنَيْنا له كغُمدان دارا",17,"ر",2,0],["كم رفع العلم بيت ذي ضَعَة","فقصّر الناس عن مدى حَسَبه",18,"ب",2,0],["كَم راح مرفوعاً لها","فوق الربا علَم وراية",19,"ا",3,0],["كم رمتُ كتمَ الجوى فيه فنمَّ به","إلى الوُشاةِ لسانُ المدمعِ السرب",20,"ب",1,0],["كم راحةٍ أوليتها من راحةٍ","ويدٍ صنعت بها لمفتقرٍ يدا",21,"د",2,0],["كم رأيتُ المُكلَّفين جنوداً","ينصرون الأباعد الغُرباءَ",22,"ا",2,0],["كم رايةٍ للمجد فا","زَ بِهَا وأخطأها عَرابهْ",23,"ب",2,0],["كم رأى القلبُ حَتْفَهُ مُذْ نَوَيْتُمْ","ما نويتمْ وكم عرتْهُ الكروبُ",24,"ب",1,0],["كم رأينا إنهابَكُم ما ملكْتم","في العطايا إلا بقايا تَقُوتُ",25,"ت",1,0],["كم رأينا لجُود كفَّيْهِ مَصْفُو","داً طليقاً من حِلْيَةِ المصْفُودِ",26,"د",1,0],["كم ركْعةٍ ركع الصَّفعانُ تحت يدي","ولم يقل سمع الله لمن حمدَهْ",27,"د",2,0],["كم رأى الله منك عَرْفاً وعُرْفاً","لا يرى شُكْرَ بعضه تخليدَكْ",28,"ك",1,0],["كم رأينا الأكفَّ جادتْ قفاه","برذاذٍ من وقعها ورشاش",29,"ش",1,0],["كم رام ذو الجد والأجداد غايتَهُ","فقام ذو الجد والأجداد زحافا",30,"ف",2,0],["كم رجاءٍ فيكم أثار جمالاً","وعطاءٍ منكم أناخَ جِمالا",31,"ل",2,0],["كم رضيع هناكَ قد فطموه","بشبا السيف قبل حينِ الفطام",32,"م",1,0],["كم رُكونٍ جنى عليكَ حِذاراً","مَنْ أطالَ الركونَ قلَّ رُكونه",33,"ن",2,0],["كَم رَوَّعوا بِجَهَنَّمٍ أَرواحَنا","فَتأَلَّمَت مِن قَبلُ أَن تَتَأَلَّما",34,"م",2,0],["كَم رُحتُ أَستَسقي سَحائِبَها","فَهَمَت وَلَكِن مِحنَةً وَضَنى",35,"ن",2,0],["كَم رَيبَةٍ دَبَّت إِلى مَضجَعي","مَعَ الجَمالِ الرائِعِ المُمكِنِ",36,"ن",1,0],["كَم راحَةٍ قَد نِلتُها","مِن جودِ تِلكَ الراحَتَينِ",37,"ن",1,0],["كَم رَفَعَت مُتَّضِعاً وَكَرَّمَت","مُبَخَّلاً وَشَجَّعَت جَبانا",38,"ن",2,0],["كَم راحَ نَحوي لائِمٌ وَغَدا وما","راحَ المَلامُ بِمَسمَعَيَّ وَلا غَدا",39,"د",2,0],["كم ريشة في كف اروع بددت","جيشا تدجج بالحديد لهاما",40,"م",2,0],["كَم راحَ طَلقاً وَراحَ تالِدُهُ","مَطِيَّةً لِلحُقوقِ تَعتَقِبُه",41,"ب",2,0],["كَم رَفَعَت حالي إِلى حالِهِ","يَدٌ مَتى تَخلُف غِنىً تُتلِفِ",42,"ف",1,0],["كم روضةٍ للمَجدِ زاهرةِ الرُّبا","ظَمِئَت إليك فكنتَ غَيثاً هَاطِلا",43,"ل",2,0],["كم رُضتُ بالفِكْر منها روضةً أُنُفاً","تفتَّحَ الزَّهْرُ منها عن جَنَى الأدبِ",44,"ب",1,0],["كَم راتِعٍ في ظِلالِ العَيشِ تَتبَعُهُ","مِنهُنَّ داهِيَةٌ تَرتَجُّ دَهياءُ",45,"ا",2,0],["كَم رَأَينا مِن مُلوكٍ سادَةٍ","رَجَعَ الدَهرُ عَلَيهِم فَاِنقَلَب",46,"ب",1,0],["كَم رَأَينا مِن عَزيزٍ","طُوِيَت عَنهُ الكُشوحُ",47,"ح",1,0],["كَم رَأَينا مِن مَيِّتٍ كانَ حَيّاً","وَوَشيكاً يُرى بِنا ما رَأَينا",48,"ن",2,0],["كَم رَأَينا لَها وَفيها وَمِنها","صُوَراً تَسفِكُ الدِماءَ دُماها",49,"ا",3,0],["كم رأينا وكم سمعنا المنايا","غيرَ أنّ الهوَى يُصِمّ ويعمي",50,"ي",1,0],["كم 