{"poems":[[75,"ألا هل درى الداعي المثوب إذ دعا","https://www.aldiwan.net/poem11947.html","الطويل"],[75,"هي الشمس مغربها في الكلل","https://www.aldiwan.net/poem11950.html","المتقارب"],[29,"لولا ابن حكام وأشراف قومه","https://www.aldiwan.net/poem4433.html","الطويل"],[72,"إلى عدلكم أنهي حديثي وأنتهي","https://www.aldiwan.net/poem43042.html","الطويل"],[47,"أبا العباس برزت على قومك","https://www.aldiwan.net/poem64567.html","الهزج"],[82,"بكى فقدك العز المؤيد والمجد","https://www.aldiwan.net/poem31472.html","الطويل"],[46,"عسى وطن يدنو بهم ولعلما","https://www.aldiwan.net/poem30356.html","الطويل"],[46,"خذي عبرات عينك عن زماعي","https://www.aldiwan.net/poem30464.html","الوافر"],[48,"ألاح وقد رأى برقا مليحا","https://www.aldiwan.net/poem23637.html","الوافر"],[164,"أتسأل عن دم لك فيه حلا","https://www.aldiwan.net/poem58930.html","الوافر"],[170,"إذا كان من عزمي التقدم في العلا","https://www.aldiwan.net/poem47133.html","الطويل"],[254,"تعناك نصب من أميمة منصب","https://www.aldiwan.net/poem2132.html","الطويل"],[287,"دع الأثلات وآرام رامه","https://www.aldiwan.net/poem32456.html","المتقارب"],[292,"فلو صادموا الرأس الملفف حاجباً","https://www.aldiwan.net/poem1900.html","الطويل"],[412,"ألمت بنا بعد الهدو سعاد","https://www.aldiwan.net/poem50185.html","الطويل"],[422,"أقول لها يوم جدت بنا","https://www.aldiwan.net/poem53955.html","المتقارب"],[443,"أحقا صددت وخنت الودادا","https://www.aldiwan.net/poem2615.html","المتقارب"],[463,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[469,"نسيم الصبا والليل منتظم العقد","https://www.aldiwan.net/poem3176.html","عموديه"],[543,"يوم أناخ بباب خير إمام","https://www.aldiwan.net/poem47941.html","عموديه"],[556,"ولما أردت طروق الفتاة","https://www.aldiwan.net/poem47811.html","المتقارب"],[563,"إني أنا وبينما","https://www.aldiwan.net/poem33772.html","مجزوء الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122543","الوافر"],[748,"","https://poetry.dctabudhabi.ae/diwan/poem/131362","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38366","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38361","الطويل"],[1083,"","https://poetry.dctabudhabi.ae/diwan/poem/29501","الوافر"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126615","الوافر"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[2598,"","https://poetry.dctabudhabi.ae/diwan/poem/17411","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76043","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65977","الطويل"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110122","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109970","الطويل"],[3873,"","https://poetry.dctabudhabi.ae/diwan/poem/143534","الطويل"],[3975,"","https://poetry.dctabudhabi.ae/diwan/poem/75830","الوافر"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101356","الوافر"],[4058,"","https://poetry.dctabudhabi.ae/diwan/poem/118051","الطويل"],[4348,"","https://poetry.dctabudhabi.ae/diwan/poem/198543","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133167","الوافر"],[3975,"صَباحك واسلمي عنا أَماما","https://www.poetsgate.com/ViewPoem.aspx?id=8294",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[5397,"رميت بقوس الحزم عن قوس حاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157922",""],[5689,"على قدر ما تعطي الملاح من الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=143395",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""]],"verses":[["فَلَو صَرَفَت صَرفَ المَنونِ جَلالَةً","لَكُنتَ بِمَحيا مَن تَوَدَّ مُمَتَّعا",0,"ع",2,0],["فَلَو صافَحَ التِبرَ خَدّي لَهانَ","وَلَو كاثَرَ القَطرَ شُكري لَقَلّ",1,"ل",1,0],["فَلَو صادَفَت تِلكَ الحِجارَةُ رَأسَهُ","لَغادَرتَ أُمَّ الرَأسِ تَغلي شُؤُونُها",2,"ن",3,0],["فَلَو صَدَقَ الحُبُّ الَّذي تَدَّعونَهُ","وَأَخلَصتُمُ فيهِ مَشَيتُم عَلى الماءِ",3,"ا",2,0],["فَلَو صُوِّرتَ مِن شَيءٍ سِوى الناسِ","إِذاً كُنتَ مِنَ العِقيانِ إِبريزا",4,"ز",2,0],["فَلَو صَحَّ في الدُّنيا الخُلودُ لِماجِدٍ","لأُبْقِيَ فيها ثمَّ صَحَّ له الخُلدُ",5,"د",1,0],["فَلَو صَحَّ قَولُ الجَعفَرِيَّةِ في الَّذي","تَنُصُّ مِنَ الإِلهامِ خِلناكَ مُلهَما",6,"م",2,0],["فَلَو صَوَّرتَ نَفسَكَ لَم تَزِدها","عَلى ما فيكَ مِن كَرَمِ الطِباعِ",7,"ع",1,0],["فلو صَحّ التّناسُخُ كنْتَ موسى","وكان أبوكَ إسحقَ الذّبيحَا",8,"ح",2,0],["فلو صيغت بدهُمتِه الليالي","وزاحَمها صباحٌ ما تجلّى",9,"ل",2,0],["فلو صُبَّ في الأجبال حُمْرُ كُؤوسِها","لمعْن الصخورُ السودُ خضراً من العُشب",10,"ب",1,0],["فَلَو صادَفوا الرَأسَ المُلَفَّفَ حاجِباً","لَلاقى كَما لاقى الحِمارُ وَجُندُبُ",11,"ب",1,0],["فَلَو صَدَموا جَبَلاً دَهدَهوهُ","سَريعاً وَلَو أَنَّهُ أَلفُ قامَه",12,"م",2,0],["فَلَو صادَموا الرَأسَ المُلَفَّفَ حاجِباً","لَلاقى كَما لاقى الحِمارُ وَجُندَبُ",13,"ب",1,1],["فَلَو صَوَّرَ اللَهُ البَريَّةَ واحِداً","لصوَّرَهُم جِسماً وَأَنتَ فُؤادُ",14,"د",1,0],["فلو صَبَرتْ عن ربوع الحمى","لكان التصبُّر أولى لها",15,"ل",3,0],["فلو صال من غضب صولةً","على الطود من خشية منه مادا",16,"د",2,0],["فلو صاحبُ السَّدِّ لاحت له","تبيَّن فيما بناه العَوارا",17,"ر",2,0],["فلو صافحت كفاهُ أرضا جديبة","لأورق منها صفحة الحجر الصلد",18,"د",1,0],["فلِوَصفِهِ أرهِف لأقلامِ الثَّنا","فَلِمثل وصفِه مُرهَفُ الأٌقلامِ",19,"م",1,0],["فَلو صُبَّتِ الكأس ما بَيننا","لما خرجت من يدينا العُقارُ",20,"ر",1,0],["فلو صحا من سكره","رأى الإله غيرنا",21,"ن",2,0],["فلو صَدَم النُّجُومَ رَأيتَ منها","رميًّا أو طَعيناً أو ضَريبا",22,"ب",2,0],["فلو صان من لوك المصائب سؤددا","أمنتم من ادراس الخطوب اللوائك",23,"ك",1,0],["فَلَو صاحَ بِالأَعداءِ صَيحَةَ ضَيثَمٍ","رَأَيتهُمُ ما بَينَ مَيْتٍ وَهارِبِ",24,"ب",1,0],["فَلَو صَهَلَت بَينَ الجبالِ عَلى العِدى","لَمِنها اِغتَدى تَعرو الجِبالَ الزّعازِعُ",25,"ع",1,0],["فلو صادفتني وأُثالُ فيها","أعنتَ العبدَ يطعنُ في كَلاها",26,"ا",3,0],["فلو صدق الهوى لم يحيي يوماً","بإثر البين عنه ولا أقاما",27,"م",2,0],["فَلَو صَبَرت مُدة عَن أَكلي","كَيما تَزول علَّتي وَسِلِّي",28,"ي",1,0],["فَلَو صُمَّ تَمَّت لَعنَةُ اللَهِ كُلُّها","عَلَيهِ وَما فيهِ مِنَ الشَرِّ أَفضَلُ",29,"ل",1,0],["فَلَو صَحَّ قَولٌ بِالتَناسُخِ قُلتُ قَد","سَرَت رَوحُ أَرسطو لِجُثمانِهِ العَبلِ",30,"ل",1,0],["فلو صحت يال المسلمات لمثلها","لقمن إلى صوتي ذوات الخلاخل",31,"ل",1,0],["فلو صح لك العلم بامر سرها","لكنت بقدرها عظيم المزية",32,"ه",1,0],["فلو صافَحَتهُ يدُ النُهَى سجدت لهُ","وقاراً بمِحراب الأَكُفِّ الخناصرُ",33,"ر",1,0],["فلو صَمَتَ الراوُونَ عن نعتِ خِيمِهِ","لأَومَت اليهِ منهمُ الأَنمُلُ العَشرُ",34,"ر",1,0],["فلو صحت الأيام صح وفاؤنا","ودام ولكن الزمان عليل",35,"ل",1,0],["فلو صَاحَبْتنِا لَرَضِيتِ مِنَّا","إذا لمْ تغبِقِ المائةُ الغلاما",36,"م",2,0],["فلو صورت غمضاً للأماقي","لقال سوادها هذا بغيضي",37,"ض",2,0],["فلو صدقت عيني لقلت كأنّني","أرى النار قد أمست تضيء لنا هندا",38,"د",2,0],["فلو صب في كأسي أذىً لشربته","على شرط أن أسقاه من كف أزهر",39,"ر",1,0],["فلو صحت بأعلا صوت","لما لباك من يسمع",40,"ع",1,0],["فَلَو صاحبتنا لرضيت عنا","إِذا لَم تغبق المائة الغلاما",41,"م",2,0],["فلو صح هذا وهو لاشك باطلٌ","وزوٌ وبهتان من الناظم المبدي",42,"د",2,0],["فلو صدقت أدت لسبط محمد","حقوقا وما مدت لها كف غاصب",43,"ب",1,0],["فلو صنت بالغض الفؤاد لما صبا","فاصل افتتان القلب من نظرة العين",44,"ن",1,0],["فلو صدق الإله أحسن من أنَّهُ","ضيع من العُمر حظَّهُ في الجُملا",45,"ل",2,0]]}