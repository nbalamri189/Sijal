"https://www.poetsgate.com/ViewPoem.aspx?id=38198",""],[5237,"أنا عبد عبد محبكم","https://www.poetsgate.com/ViewPoem.aspx?id=113112",""],[5246,"زرت المنازل بعد بين أنيسها","https://www.poetsgate.com/ViewPoem.aspx?id=187060",""],[5302,"جعلت فداكا","https://www.poetsgate.com/ViewPoem.aspx?id=205728",""],[5363,"رثاء أبي","https://www.poetsgate.com/ViewPoem.aspx?id=199951",""],[5377,"تحية الخروج من العزلة","https://www.poetsgate.com/ViewPoem.aspx?id=61892",""],[5411,"وِعَساكَ تَسْمَعُ","https://www.poetsgate.com/ViewPoem.aspx?id=185348",""],[5442,"عز قرب الدار إلا في الكرا","https://www.poetsgate.com/ViewPoem.aspx?id=114789",""],[5442,"ذاك الفراق وان أصم مسامعي","https://www.poetsgate.com/ViewPoem.aspx?id=114744",""],[5582,"سَلْ الأَظْعانَ إِنْ مَرَّتْ","https://www.poetsgate.com/ViewPoem.aspx?id=187212",""],[5650,"اعتذارٌ جديدٌ لخجلِ الخيول!","https://www.poetsgate.com/ViewPoem.aspx?id=134786",""],[5691,"جوهر الفكر","https://www.poetsgate.com/ViewPoem.aspx?id=206131",""],[5694,"البيعة","https://www.poetsgate.com/ViewPoem.aspx?id=129888",""],[4623,"لا تلوموني إني أطلت المقالا ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146608",""],[5756,"خطاك السو","https://www.poetsgate.com/ViewPoem.aspx?id=5364",""],[5764,"ست وثلاثينك","https://www.poetsgate.com/ViewPoem.aspx?id=177319",""],[5790,"وعسالِ القوام إذا تثنى","https://www.poetsgate.com/ViewPoem.aspx?id=112039",""],[5864,"يا أبي","https://www.poetsgate.com/ViewPoem.aspx?id=190488",""],[5956,"مِثْل الفقير يرى القصور بعيدا","https://www.poetsgate.com/ViewPoem.aspx?id=182343",""],[5956,"أقصوصة شاعر وحانوت","https://www.poetsgate.com/ViewPoem.aspx?id=193640",""],[5956,"وأُحبها وأُحِبُّ كلباً قربها","https://www.poetsgate.com/ViewPoem.aspx?id=193865",""],[5956,"يا ليتني أشفيك من كل الضنا","https://www.poetsgate.com/ViewPoem.aspx?id=194650",""],[6038,"غزوة رمش","https://www.poetsgate.com/ViewPoem.aspx?id=27051",""],[6038,"الاقصى","https://www.poetsgate.com/ViewPoem.aspx?id=27219",""],[520,"أسفي لملك عاضدي عطلت","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577563",""],[5490,"أهذا الصبح..؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81929&r=&rc=15",""]],"verses":[["وعسى الذي بدأ الجَميلَ يُعيدُهُ","وعسى الذي سدّ المَذاهِبَ يَفْتَحُ",0,"ح",1,0],["وَعَسيرٍ مِنَ النَواعِجِ أَدما","ءَ مَروحٍ بَعدَ الكَلالِ رَجوفِ",1,"ف",1,0],["وَعَسيرٍ أَدماءَ حادِرَةِ العَي","نِ خَنوفٍ عَيرانَةٍ شِملالِ",2,"ل",1,0],["وَعَسى أَن يَسمَحَ الدَهرُ","فَقَد طالَ الشِماسُ",3,"س",1,0],["وعَسيرٌ بلوغُ هاتِيكَ جداً","تلك عُليا مَراتِب الأنبياءِ",4,"ا",2,0],["وعسى قائلٌ يقول بجهلٍ","إنما يطلب الغِنى والغِناءَ",5,"ا",2,0],["وعسى قارِفِي يكون ظَنيناً","وعسى عائبي يكون مَعيبا",6,"ب",2,0],["وعسى معوِّجُهُ يكونُ ثِقَافَهُ","ولعلَّ مُمرضَهُ يكونُ طبيبَهُ",7,"ب",2,0],["وعساك تنصحني وليس لعاشِق","عين تريه ما يرى نُصَّاحُه",8,"ح",2,0],["وعساها لم تُمْنَ فيه برمي","نالها صبرةً ولا باحتبالِ",9,"ل",1,0],["وعسى حاسدٌ يقول فهلّا","نزلتْ درَّةٌ بلا استنزالِ",9,"ل",1,0],["وعسى قائلٌ يقول بجهلٍ","قولَ حيرانَ في ضلالٍ وتيه",10,"ي",2,0],["وَعَساكَ تُطفِئُ مِن غَلي","لِ الشَوقِ ناراً حامِيَه",11,"ي",2,0],["وَعَسى نَسيمٌ بِتُّ أَكتُمُ سِرَّنا","عَنهُ فَراحَ يَقولُ عَنّي قَد سَلا",12,"ل",2,0],["وَعَساكَ تَطلُبُ أَن أَعو","دَ إِلى هَواكَ فَما أَعودُ",13,"د",1,0],["وعَسَى يَصونُ الزَّهْرُ دَمْعِي","فهوَ مِثْلِي يَسكُبُ",14,"ب",1,0],["وعسى ان يأتي على الشر فيهم","ما يحس الضمير من وخزات",15,"ت",1,0],["وعسى ان يغفر اللَه","يوما زللك",16,"ك",1,0],["وعسى ان بث شعري شعوري","وعسى ان ينوب شعري منابي",17,"ب",2,0],["وعسكري شاهر الحسام","وسائل منحدب القوام",18,"م",1,0],["وَعَسى الأَمانِيُّ العِذابُ لَنا","عَونٌ عَلى السُلوانِ وَالهَجرِ",19,"ر",1,0],["وعسجديُّ اللونِ ذو صُفْرَةٍ","ضُمَّ إِلى تِرْبٍ لهُ أحمرِ",20,"ر",1,0],["وَعَسى اللَهَ أَن يُفَرِّحَ ما أَص","بَحتُ فيهِ وَكُلُّ آتٍ قَريبُ",21,"ب",1,0],["وعَسى الأيّامُ تَرتاحُ لكُمْ","فيَعودَ الهَمُّ بِالعَوْدِ جَذِلْ",22,"ل",1,0],["وعسى وعيدُك لا يضير فلم أجِدْ","في البحر ضرباً مؤلمَ المضروبِ",23,"ب",1,0],["وَعَسى الزَمانُ وَإِن عَسا في حالَةٍ","يَحنو فَيَدنو بِالوَزيرِ مَزارا",24,"ر",2,0],["وَعَسى اللَيالي أَن تَمُنَّ بِجَمعِنا","عِقداً كَما كُنّا عَلَيهِ وَأَكمَلا",25,"ل",2,1],["وعَسِيبُ نَخْلٍ صارَ عَضْباً صارِماً","يَوْمَ الوَغَى إذْ كلُّ عَيْنٍ تُقْلَبُ",26,"ب",1,0],["وَعَسْكَرٍ لجَبٍ قَدْ لَجَّ فِي طَلَبٍ","لِغَزوِهِ غَرَّهُ بَأْسٌ وتَرْعِيلُ",27,"ل",1,0],["وَعَسكَرُ الحُبِّ حَولي","بِخَيلِهِ وَجُنودِه",28,"د",2,0],["وَعَسى ذاكَ أَن يَحينَ فَتَبكي","لا تَقولي بُعداً لِمَن في الغِيابَه",29,"ب",2,0],["وَعَسكَرٍ مِثلِ الدُجى دَبّابِ","يَعصِفُ بِالشيبِ وَبِالشَبابِ",30,"ب",1,0],["وَعَسى أَن أَعيش حتى أَرى في","وطني ما يزيد قَلبي اِبتهاجا",31,"ج",2,0],["وَعَسعَسَ يَرتاع الكرى من ظلامه","وَطالَ وَليل الخائفين يَطول",32,"ل",1,0],["وَعَسى أَن يَكون عنوان فجر","لنهار في العين يَبدو جَميلا",33,"ل",2,0],["وَعَسى اللَهُ أَن يَتوبَ عَلى المُذ","نِبِ مِن قَبلِ مَوتِهِ لِيَتوبا",34,"ب",2,0],["وَعَسى اللَه أَن يُقَرِّبني مِن","كَ بِطوبى وَذا البَكا ثمّ ضحكُ",35,"ك",1,0],["وَعساك إذا أنعَمْتَ به","من صاحِبِهِ لا تُفْرِدُهُ",36,"د",2,0],["وَعَسى مُفرِّقنا سيجمعُ بيننا","إِنَّ العَسِيرَ عَليه غَيْرُ عَسيرِ",37,"ر",1,0],["وَعَسى المُختارُ يَذكُرهُ","فَيَقي المَحزونَ إِذ يَفِدُ",38,"د",1,0],["وعساهُ أيضاً من أبيكَ لأمه","فيها تصيب فياشلَ الشبان",39,"ن",1,0],["وعسى الذي كتب الفراق يعيده","وصلا وبرحم دمعها ولوارها",40,"ر",3,0],["وعساه يسعف بالرضى فلقد قضى","زمني علي ببعده المتمادي",41,"د",2,0],["وعسى الدهرُ أن يجودَ بلقياكم","وظنّي بأنه لَنْ يجودا",42,"د",2,0],["وَعَسيرٌ عَلى العِدى هَدمُ عِزٍّ","شَيَّدَتهُ السُيوفُ وَالأَقلامُ",43,"م",1,0],["وَعَسكَرَ جَنباً ما يَريمُ مَكانَهُ","بِأَرضِ فَضاءٍ وَهوَ لِلرومِ واتِرُ",44,"ر",1,0],["وعسى اذا تليت معاني حسنها","تقرى وتحظى بالقبول وترزق",45,"ق",1,0],["وَعَساكِر الزَهرِ النَضير كَتائِبٌ","رُفِعَت عَلَيهِ مِنَ الغُصونِ صَناجِقُ",46,"ق",1,0],["وَعَسَى نَفْحَةٌ تُوَافِيكَ مِنْهُ","تَنْجَلِي بِتَنْعِيمِهَا الْبَأْسَاءُ",47,"ا",2,0],["وعسكرُهُ السامي وحكمُ أميرنا","على أرضِ مصرٍ إنني لسعيدُ",48,"د",1,0],["وعَساكِ يوماً تَبسمينَ لهم وقد","أبصَرتِهم يُبلون بالأعداء",49,"ا",2,0],["وَعَسَى قَبُولُكَ أنْ تَجُودَ بِه","حَلْياً لِحَالٍ شَانَهَا العَطَلُ",50,"ل",1,0],["وَعَسى طَرفُكِ إِذ أَضحى عَليلاً","أَن يُداوي سِحرُهُ الصَبَّ العَليلا",51,"ل",2,0],["وَعَساكِرُ المصرِيِّ مُحدِقَةٌ بِنا","أَطلابُها كَأَجيجِ نارِ المَوقِدِ",52,"د",1,0],["وَعَساها أَن تَجمَع الشَمل قُرباً","فَهيَ لِلجَمع يا منى القَلب آله",53,"ل",2,0],["وعَسكرُ مُكرَمٍ عَرِيَتْ رُباها","لِما صنَعتْ بها العُصَبُ الغَوايا",54,"ا",3,0],["وَعَسى دِماءُ العاشِقينَ إِلَيهِ قَد","سَبَقَت بُكورَ بَواكرِ الأَمطارِ",55,"ر",1,0],["وَعَسى سَوادُ قُلوبِهِم في قَلبِهِ","فَمُصابُهُم بِمَواضِعِ الإِضمارِ",55,"ر",1,0],["وعَساكُما فيما تُريدانِ الهَوَى","يأتي بهِ قدَرٌ فيَعدلُ بَينَنا",56,"ن",2,0],["وعَسى إِن صَبرتُ أَرجو ثَوابَ الص","صَبرِ كانَ الثَّوابُ إِبراهيما",57,"م",2,0],["وعسى وعل وبعد هذا غيره","فرجا اللقا من غير ما يستشرف",58,"ف",1,0],["وعساه يغفر لي ويرحمني","حسي به دون الورى حسبي",59,"ب",2,0],["وعسى من دعوة قد رفعت","فلكم قمت بها منتصبا",60,"ب",2,0],["وعَسَى قلوبٌ أعضَلَتْ أدواؤُها","في قُربِنَا بعد التَّفرِّقِ تُفرِقُ",61,"ق",1,0],["وعسى القوت بحفظ لم يضع","منه شيء وعسى أن لا ضرر",62,"ر",1,0],["وعسكريٍّ كلما رُمتُه","جرّد لي حُبَّ مُلاحاتِه",63,"ت",2,1],["وعسى الذنوب تفرقت كفراقكم","بكم وعنا ثقلها مضوع",64,"ع",1,0],["وعسى ان يقدر الل","ه تحقيق مستحب",65,"ب",1,0],["وعسى الأيام أن تُبدلَهُ","صِبغةً تنصُلُ أو لوناً يحولُ",66,"ل",1,0],["وعسفٌ في القضاء ويقتضيه","فتمحوه مياسرةٌ ورِفقُ",67,"ق",1,0],["وعسى الدنيا التي أدَّتكُمُ","تصطفينا من بنيها بنجيبِ",68,"ب",1,0],["وعسى أن يرقَّ قاسٍ فلا","أهلكُ وجداً وليتهُ ولعلاَّ",69,"ل",2,0],["وَعَساكَ تُدرِكُ قَطرَة ًمِن مائِها","أو نَخلَة ًيَبِسَتْ تَعودُ ، فَتُثمِرُ!",70,"ر",1,0],["وعسى لك الرحمنُ يقبَلُ دعوتي","ويُجيبُ فيكَ وفي بَنيكَ سؤالي",71,"ل",2,0],["وعسى يُمدُّكم الإلهُ جميعَكم","بزيادةِ الأعمار والأبناءِ",72,"ا",2,0],["وعسكر كأتي السيل مندفعاً","إما إلى صعد في الأرض أو صبب",73,"ب",1,0],["وعسى الليالي أن ترد زمانكم","لدناً كعود البانة المياس",74,"س",1,0],["وعَسَى وعَلَّ يَعودُ ذاك الْعَْدُ مِنْ","أَفْضالِ رَبٍّ مُبْتَدِي بالجُودِ",75,"د",1,0],["وعَسَايَ أَظْفَرُ بالْمنَى وَهُو