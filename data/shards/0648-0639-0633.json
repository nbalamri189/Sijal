{"poems":[[77,"عن باب والدك الرضى لا أبرح","https://www.aldiwan.net/poem36634.html","الكامل"],[9,"أذن اليوم جيرتي بحفوف","https://www.aldiwan.net/poem21953.html","الخفيف"],[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[73,"ما على ظني باس","https://www.aldiwan.net/poem11908.html","مجزوء الرمل"],[51,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[51,"لي صاحب قد كنت آمل نفعه","https://www.aldiwan.net/poem8496.html","الكامل"],[51,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"شهر نسك قرينه يوم لهو","https://www.aldiwan.net/poem66715.html","الخفيف"],[70,"أعد الرسالة ثانيه","https://www.aldiwan.net/poem42397.html","مجزوء الكامل"],[70,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[70,"ياغادرين ألم يكن","https://www.aldiwan.net/poem42940.html","مجزوء الكامل"],[92,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[89,"اغتنم كل فرصة في الحياة","https://www.aldiwan.net/poem44633.html","الخفيف"],[89,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[89,"انت ما ان تخففين مصابي","https://www.aldiwan.net/poem44901.html","الخفيف"],[85,"قد مثلوا في صورة مزوقة","https://www.aldiwan.net/poem7907.html","الرجز"],[85,"قلب يذوب ومدمع يجري","https://www.aldiwan.net/poem63661.html","أحذ الكامل"],[62,"كرات دستنبوية نضدت","https://www.aldiwan.net/poem52398.html","السريع"],[45,"كدت أقضي إذا غاب عني الحبيب","https://www.aldiwan.net/poem11482.html","الخفيف"],[61,"نحن للأيام غنم ونفل","https://www.aldiwan.net/poem51477.html","الرمل"],[80,"من كان يعذب عندها تعذيبي","https://www.aldiwan.net/poem31542.html","الكامل"],[74,"ماذا عليك وقد نأيت ديارا","https://www.aldiwan.net/poem12958.html","الكامل"],[74,"وعسى الليالي أن تمن بجمعنا","https://www.aldiwan.net/poem13219.html","الكامل"],[67,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[48,"طاب الهوى لعميده","https://www.aldiwan.net/poem62606.html","مجزوء الكامل"],[50,"منع النوم طارق من حبابه","https://www.aldiwan.net/poem64856.html","الخفيف"],[50,"يا دار بين الفرع والجناب","https://www.aldiwan.net/poem64871.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85570","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85444","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85428","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43733","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43872","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43692","المديد"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24819","الكامل"]],"verses":[["وعسى الذي بدأ الجَميلَ يُعيدُهُ","وعسى الذي سدّ المَذاهِبَ يَفْتَحُ",0,"ح",1,0],["وَعَسيرٍ مِنَ النَواعِجِ أَدما","ءَ مَروحٍ بَعدَ الكَلالِ رَجوفِ",1,"ف",1,0],["وَعَسيرٍ أَدماءَ حادِرَةِ العَي","نِ خَنوفٍ عَيرانَةٍ شِملالِ",2,"ل",1,0],["وَعَسى أَن يَسمَحَ الدَهرُ","فَقَد طالَ الشِماسُ",3,"س",1,0],["وعَسيرٌ بلوغُ هاتِيكَ جداً","تلك عُليا مَراتِب الأنبياءِ",4,"ا",2,0],["وعسى قائلٌ يقول بجهلٍ","إنما يطلب الغِنى والغِناءَ",5,"ا",2,0],["وعسى قارِفِي يكون ظَنيناً","وعسى عائبي يكون مَعيبا",6,"ب",2,0],["وعسى معوِّجُهُ يكونُ ثِقَافَهُ","ولعلَّ مُمرضَهُ يكونُ طبيبَهُ",7,"ب",2,0],["وعساك تنصحني وليس لعاشِق","عين تريه ما يرى نُصَّاحُه",8,"ح",2,0],["وعساها لم تُمْنَ فيه برمي","نالها صبرةً ولا باحتبالِ",9,"ل",1,0],["وعسى حاسدٌ يقول فهلّا","نزلتْ درَّةٌ بلا استنزالِ",9,"ل",1,0],["وعسى قائلٌ يقول بجهلٍ","قولَ حيرانَ في ضلالٍ وتيه",10,"ي",2,0],["وَعَساكَ تُطفِئُ مِن غَلي","لِ الشَوقِ ناراً حامِيَه",11,"ي",2,0],["وَعَسى نَسيمٌ بِتُّ أَكتُمُ سِرَّنا","عَنهُ فَراحَ يَقولُ عَنّي قَد سَلا",12,"ل",2,0],["وَعَساكَ تَطلُبُ أَن أَعو","دَ إِلى هَواكَ فَما أَعودُ",13,"د",1,0],["وعَسَى يَصونُ الزَّهْرُ دَمْعِي","فهوَ مِثْلِي يَسكُبُ",14,"ب",1,0],["وعسى ان يأتي على الشر فيهم","ما يحس الضمير من وخزات",15,"ت",1,0],["وعسى ان يغفر اللَه","يوما زللك",16,"ك",1,0],["وعسى ان بث شعري شعوري","وعسى ان ينوب شعري منابي",17,"ي",1,0],["وعسكري شاهر الحسام","وسائل منحدب القوام",18,"م",1,0],["وَعَسى الأَمانِيُّ العِذابُ لَنا","عَونٌ عَلى السُلوانِ وَالهَجرِ",19,"ر",1,0],["وعسجديُّ اللونِ ذو صُفْرَةٍ","ضُمَّ إِلى تِرْبٍ لهُ أحمرِ",20,"ر",1,0],["وَعَسى اللَهَ أَن يُفَرِّحَ ما أَص","بَحتُ فيهِ وَكُلُّ آتٍ قَريبُ",21,"ب",1,0],["وعَسى الأيّامُ تَرتاحُ لكُمْ","فيَعودَ الهَمُّ بِالعَوْدِ جَذِلْ",22,"ل",1,0],["وعسى وعيدُك لا يضير فلم أجِدْ","في البحر ضرباً مؤلمَ المضروبِ",23,"ب",1,0],["وَعَسى الزَمانُ وَإِن عَسا في حالَةٍ","يَحنو فَيَدنو بِالوَزيرِ مَزارا",24,"ر",2,0],["وَعَسى اللَيالي أَن تَمُنَّ بِجَمعِنا","عِقداً كَما كُنّا عَلَيهِ وَأَكمَلا",25,"ل",2,1],["وعَسِيبُ نَخْلٍ صارَ عَضْباً صارِماً","يَوْمَ الوَغَى إذْ كلُّ عَيْنٍ تُقْلَبُ",26,"ب",1,0],["وَعَسْكَرٍ لجَبٍ قَدْ لَجَّ فِي طَلَبٍ","لِغَزوِهِ غَرَّهُ بَأْسٌ وتَرْعِيلُ",27,"ل",1,0],["وَعَسكَرُ الحُبِّ حَولي","بِخَيلِهِ وَجُنودِه",28,"د",2,0],["وَعَسى ذاكَ أَن يَحينَ فَتَبكي","لا تَقولي بُعداً لِمَن في الغِيابَه",29,"ب",2,0],["وَعَسكَرٍ مِثلِ الدُجى دَبّابِ","يَعصِفُ بِالشيبِ وَبِالشَبابِ",30,"ب",1,0],["وَعَسى أَن أَعيش حتى أَرى في","وطني ما يزيد قَلبي اِبتهاجا",31,"ج",2,0],["وَعَسعَسَ يَرتاع الكرى من ظلامه","وَطالَ وَليل الخائفين يَطول",32,"ل",1,0],["وَعَسى أَن يَكون عنوان فجر","لنهار في العين يَبدو جَميلا",33,"ل",2,0],["وَعَسى اللَهُ أَن يَتوبَ عَلى المُذ","نِبِ مِن قَبلِ مَوتِهِ لِيَتوبا",34,"ب",2,0],["وَعَسى اللَه أَن يُقَرِّبني مِن","كَ بِطوبى وَذا البَكا ثمّ ضحكُ",35,"ك",1,0],["وَعساك إذا أنعَمْتَ به","من صاحِبِهِ لا تُفْرِدُهُ",36,"د",2,0],["وَعَسى مُفرِّقنا سيجمعُ بيننا","إِنَّ العَسِيرَ عَليه غَيْرُ عَسيرِ",37,"ر",1,0],["وَعَسى المُختارُ يَذكُرهُ","فَيَقي المَحزونَ إِذ يَفِدُ",38,"د",1,0],["وعساهُ أيضاً من أبيكَ لأمه","فيها تصيب فياشلَ الشبان",39,"ن",1,0]]}