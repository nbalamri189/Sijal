{"poems":[[79,"عن باب والدك الرضى لا أبرح","https://www.aldiwan.net/poem36634.html","الكامل"],[9,"أذن اليوم جيرتي بحفوف","https://www.aldiwan.net/poem21953.html","الخفيف"],[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[75,"ما على ظني باس","https://www.aldiwan.net/poem11908.html","مجزوء الرمل"],[53,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[53,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[53,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[53,"لي صاحب قد كنت آمل نفعه","https://www.aldiwan.net/poem8496.html","الكامل"],[53,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[53,"شهر نسك قرينه يوم لهو","https://www.aldiwan.net/poem66715.html","الخفيف"],[72,"أعد الرسالة ثانيه","https://www.aldiwan.net/poem42397.html","مجزوء الكامل"],[72,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[72,"ياغادرين ألم يكن","https://www.aldiwan.net/poem42940.html","مجزوء الكامل"],[94,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[91,"اغتنم كل فرصة في الحياة","https://www.aldiwan.net/poem44633.html","الخفيف"],[91,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[91,"انت ما ان تخففين مصابي","https://www.aldiwan.net/poem44901.html","الخفيف"],[87,"قد مثلوا في صورة مزوقة","https://www.aldiwan.net/poem7907.html","الرجز"],[87,"قلب يذوب ومدمع يجري","https://www.aldiwan.net/poem63661.html","أحذ الكامل"],[64,"كرات دستنبوية نضدت","https://www.aldiwan.net/poem52398.html","السريع"],[47,"كدت أقضي إذا غاب عني الحبيب","https://www.aldiwan.net/poem11482.html","الخفيف"],[63,"نحن للأيام غنم ونفل","https://www.aldiwan.net/poem51477.html","الرمل"],[82,"من كان يعذب عندها تعذيبي","https://www.aldiwan.net/poem31542.html","الكامل"],[76,"ماذا عليك وقد نأيت ديارا","https://www.aldiwan.net/poem12958.html","الكامل"],[76,"وعسى الليالي أن تمن بجمعنا","https://www.aldiwan.net/poem13219.html","الكامل"],[69,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[50,"طاب الهوى لعميده","https://www.aldiwan.net/poem62606.html","مجزوء الكامل"],[52,"منع النوم طارق من حبابه","https://www.aldiwan.net/poem64856.html","الخفيف"],[52,"يا دار بين الفرع والجناب","https://www.aldiwan.net/poem64871.html","الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85570","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85444","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85428","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43733","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43872","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43692","المديد"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/24819","الكامل"],[118,"قف يا مثير العيس ان غبارها","https://www.aldiwan.net/poem41095.html","عموديه"],[118,"لمعت بوارق دولة الإرشاد","https://www.aldiwan.net/poem41762.html","الكامل"],[131,"إن يوم الفراق كان شديدا","https://www.aldiwan.net/poem50634.html","الخفيف"],[146,"لا تجز في الذي بلغت الأنام","https://www.aldiwan.net/poem11812.html","الخفيف"],[198,"أهم سرى أم عاد للعين عائر","https://www.aldiwan.net/poem54405.html","الطويل"],[213,"حنت إلى مرأى علاكم جلق","https://www.aldiwan.net/poem13555.html","الكامل"],[235,"ما العيش إن يبدو وابرامة بارق","https://www.aldiwan.net/poem14770.html","الكامل"],[240,"ما لمن مسه من الفقر داء","https://www.aldiwan.net/poem18031.html","الخفيف"],[244,"قدوم ولكن لا أقول سعيد","https://www.aldiwan.net/poem45771.html","الطويل"],[273,"أغنى التقى عن برقع وخباء","https://www.aldiwan.net/poem35588.html","الكامل"],[278,"بشراك نصر الله مقتبل","https://www.aldiwan.net/poem25538.html","أحذ الكامل"],[285,"قلت لما أزمع الحي الرحيلا","https://www.aldiwan.net/poem32307.html","الرمل"],[285,"أنى اهتدى طيف الحبيب لمرقدي","https://www.aldiwan.net/poem32794.html","الكامل"],[356,"ما ترى البدر حين حاز كماله","https://www.aldiwan.net/poem40002.html","الخفيف"],[367,"سهام نواظر تصمي الرمايا","https://www.aldiwan.net/poem60572.html","الوافر"],[369,"الدمع يسأل عنك رسم الدار","https://www.aldiwan.net/poem17346.html","الكامل"],[374,"طال الزمان وما ثناه ولا انثنى","https://www.aldiwan.net/poem57023.html","الكامل"],[374,"خذ حديثي أني جعلت من الناس","https://www.aldiwan.net/poem57162.html","الخفيف"],[406,"قد شف جسمي طول ما أتشوف","https://www.aldiwan.net/poem33640.html","الكامل"],[406,"عجبا يعاتبني بلا ذنب","https://www.aldiwan.net/poem34115.html","الكامل"],[406,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[412,"يا ابن الألى جمع الفخار لبيتهم","https://www.aldiwan.net/poem32263.html","الكامل"],[432,"يا شقيق الروح إنا لم نزل","https://www.aldiwan.net/poem41018.html","الرمل"],[435,"وعسكري كلما رمته","https://www.aldiwan.net/poem12776.html","السريع"],[444,"هذا الفراق وهكذا التوديع","https://www.aldiwan.net/poem14378.html","الكامل"],[446,"دمت يا فارس الخطب","https://www.aldiwan.net/poem55928.html","عموديه"],[460,"سأَلت ظبية ما هذا النحول","https://www.aldiwan.net/poem55929.html","المتقارب"],[460,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[460,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[466,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[467,"هبها دعاءك","https://www.aldiwan.net/poem36541.html","عموديه"],[516,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[516,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[517,"أفخر فحسبك ما أوتيت من حسب","https://www.aldiwan.net/poem12019.html","البسيط"],[517,"أسفي لملك عاضدي عطلت","https://www.aldiwan.net/poem12164.html","الكامل"],[531,"أعلى الذي ألقى طلبت شهودي","https://www.aldiwan.net/poem37458.html","الكامل"],[540,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[564,"عجب نراه فسبحوا من أبدعا","https://www.aldiwan.net/poem52756.html","الكامل"],[564,"ألحمد لله الذي خلق الورى","https://www.aldiwan.net/poem52937.html","الكامل"],[577,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"]],"verses":[["وعسى الذي بدأ الجَميلَ يُعيدُهُ","وعسى الذي سدّ المَذاهِبَ يَفْتَحُ",0,"ح",1,0],["وَعَسيرٍ مِنَ النَواعِجِ أَدما","ءَ مَروحٍ بَعدَ الكَلالِ رَجوفِ",1,"ف",1,0],["وَعَسيرٍ أَدماءَ حادِرَةِ العَي","نِ خَنوفٍ عَيرانَةٍ شِملالِ",2,"ل",1,0],["وَعَسى أَن يَسمَحَ الدَهرُ","فَقَد طالَ الشِماسُ",3,"س",1,0],["وعَسيرٌ بلوغُ هاتِيكَ جداً","تلك عُليا مَراتِب الأنبياءِ",4,"ا",2,0],["وعسى قائلٌ يقول بجهلٍ","إنما يطلب الغِنى والغِناءَ",5,"ا",2,0],["وعسى قارِفِي يكون ظَنيناً","وعسى عائبي يكون مَعيبا",6,"ب",2,0],["وعسى معوِّجُهُ يكونُ ثِقَافَهُ","ولعلَّ مُمرضَهُ يكونُ طبيبَهُ",7,"ب",2,0],["وعساك تنصحني وليس لعاشِق","عين تريه ما يرى نُصَّاحُه",8,"ح",2,0],["وعساها لم تُمْنَ فيه برمي","نالها صبرةً ولا باحتبالِ",9,"ل",1,0],["وعسى حاسدٌ يقول فهلّا","نزلتْ درَّةٌ بلا استنزالِ",9,"ل",1,0],["وعسى قائلٌ يقول بجهلٍ","قولَ حيرانَ في ضلالٍ وتيه",10,"ي",2,0],["وَعَساكَ تُطفِئُ مِن غَلي","لِ الشَوقِ ناراً حامِيَه",11,"ي",2,0],["وَعَسى نَسيمٌ بِتُّ أَكتُمُ سِرَّنا","عَنهُ فَراحَ يَقولُ عَنّي قَد سَلا",12,"ل",2,0],["وَعَساكَ تَطلُبُ أَن أَعو","دَ إِلى هَواكَ فَما أَعودُ",13,"د",1,0],["وعَسَى يَصونُ الزَّهْرُ دَمْعِي","فهوَ مِثْلِي يَسكُبُ",14,"ب",1,0],["وعسى ان يأتي على الشر فيهم","ما يحس الضمير من وخزات",15,"ت",1,0],["وعسى ان يغفر اللَه","يوما زللك",16,"ك",1,0],["وعسى ان بث شعري شعوري","وعسى ان ينوب شعري منابي",17,"ب",2,0],["وعسكري شاهر الحسام","وسائل منحدب القوام",18,"م",1,0],["وَعَسى الأَمانِيُّ العِذابُ لَنا","عَونٌ عَلى السُلوانِ وَالهَجرِ",19,"ر",1,0],["وعسجديُّ اللونِ ذو صُفْرَةٍ","ضُمَّ إِلى تِرْبٍ لهُ أحمرِ",20,"ر",1,0],["وَعَسى اللَهَ أَن يُفَرِّحَ ما أَص","بَحتُ فيهِ وَكُلُّ آتٍ قَريبُ",21,"ب",1,0],["وعَسى الأيّامُ تَرتاحُ لكُمْ","فيَعودَ الهَمُّ بِالعَوْدِ جَذِلْ",22,"ل",1,0],["وعسى وعيدُك لا يضير فلم أجِدْ","في البحر ضرباً مؤلمَ المضروبِ",23,"ب",1,0],["وَعَسى الزَمانُ وَإِن عَسا في حالَةٍ","يَحنو فَيَدنو بِالوَزيرِ مَزارا",24,"ر",2,0],["وَعَسى اللَيالي أَن تَمُنَّ بِجَمعِنا","عِقداً كَما كُنّا عَلَيهِ وَأَكمَلا",25,"ل",2,1],["وعَسِيبُ نَخْلٍ صارَ عَضْباً صارِماً","يَوْمَ الوَغَى إذْ كلُّ عَيْنٍ تُقْلَبُ",26,"ب",1,0],["وَعَسْكَرٍ لجَبٍ قَدْ لَجَّ فِي طَلَبٍ","لِغَزوِهِ غَرَّهُ بَأْسٌ وتَرْعِيلُ",27,"ل",1,0],["وَعَسكَرُ الحُبِّ حَولي","بِخَيلِهِ وَجُنودِه",28,"د",2,0],["وَعَسى ذاكَ أَن يَحينَ فَتَبكي","لا تَقولي بُعداً لِمَن في الغِيابَه",29,"ب",2,0],["وَعَسكَرٍ مِثلِ الدُجى دَبّابِ","يَعصِفُ بِالشيبِ وَبِالشَبابِ",30,"ب",1,0],["وَعَسى أَن أَعيش حتى أَرى في","وطني ما يزيد قَلبي اِبتهاجا",31,"ج",2,0],["وَعَسعَسَ يَرتاع الكرى من ظلامه","وَطالَ وَليل الخائفين يَطول",32,"ل",1,0],["وَعَسى أَن يَكون عنوان فجر","لنهار في العين يَبدو جَميلا",33,"ل",2,0],["وَعَسى اللَهُ أَن يَتوبَ عَلى المُذ","نِبِ مِن قَبلِ مَوتِهِ لِيَتوبا",34,"ب",2,0],["وَعَسى اللَه أَن يُقَرِّبني مِن","كَ بِطوبى وَذا البَكا ثمّ ضحكُ",35,"ك",1,0],["وَعساك إذا أنعَمْتَ به","من صاحِبِهِ لا تُفْرِدُهُ",36,"د",2,0],["وَعَسى مُفرِّقنا سيجمعُ بيننا","إِنَّ العَسِيرَ عَليه غَيْرُ عَسيرِ",37,"ر",1,0],["وَعَسى المُختارُ يَذكُرهُ","فَيَقي المَحزونَ إِذ يَفِدُ",38,"د",1,0],["وعساهُ أيضاً من أبيكَ لأمه","فيها تصيب فياشلَ الشبان",39,"ن",1,0],["وعسى الذي كتب الفراق يعيده","وصلا وبرحم دمعها ولوارها",40,"ر",3,0],["وعساه يسعف بالرضى فلقد قضى","زمني علي ببعده المتمادي",41,"د",2,0],["وعسى الدهرُ أن يجودَ بلقياكم","وظنّي بأنه لَنْ يجودا",42,"د",2,0],["وَعَسيرٌ عَلى العِدى هَدمُ عِزٍّ","شَيَّدَتهُ السُيوفُ وَالأَقلامُ",43,"م",1,0],["وَعَسكَرَ جَنباً ما يَريمُ مَكانَهُ","بِأَرضِ فَضاءٍ وَهوَ لِلرومِ واتِرُ",44,"ر",1,0],["وعسى اذا تليت معاني حسنها","تقرى وتحظى بالقبول وترزق",45,"ق",1,0],["وَعَساكِر الزَهرِ النَضير كَتائِبٌ","رُفِعَت عَلَيهِ مِنَ الغُصونِ صَناجِقُ",46,"ق",1,0],["وَعَسَى نَفْحَةٌ تُوَافِيكَ مِنْهُ","تَنْجَلِي بِتَنْعِيمِهَا الْبَأْسَاءُ",47,"ا",2,0],["وعسكرُهُ السامي وحكمُ أميرنا","على أرضِ مصرٍ إنني لسعيدُ",48,"د",1,0],["وعَساكِ يوماً تَبسمينَ لهم وقد","أبصَرتِهم يُبلون بالأعداء",49,"ا",2,0],["وَعَسَى قَبُولُكَ أنْ تَجُودَ بِه","حَلْياً لِحَالٍ شَانَهَا العَطَلُ",50,"ل",1,0],["وَعَسى طَرفُكِ إِذ أَضحى عَليلاً","أَن يُداوي سِحرُهُ الصَبَّ العَليلا",51,"ل",2,0],["وَعَساكِرُ المصرِيِّ مُحدِقَةٌ بِنا","أَطلابُها كَأَجيجِ نارِ المَوقِدِ",52,"د",1,0],["وَعَساها أَن تَجمَع الشَمل قُرباً","فَهيَ لِلجَمع يا منى القَلب آله",53,"ل",2,0],["وعَسكرُ مُكرَمٍ عَرِيَتْ رُباها","لِما صنَعتْ بها العُصَبُ الغَوايا",54,"ا",3,0],["وَعَسى دِماءُ العاشِقينَ إِلَيهِ قَد","سَبَقَت بُكورَ بَواكرِ الأَمطارِ",55,"ر",1,0],["وَعَسى سَوادُ قُلوبِهِم في قَلبِهِ","فَمُصابُهُم بِمَواضِعِ الإِضمارِ",55,"ر",1,0],["وعَساكُما فيما تُريدانِ الهَوَى","يأتي بهِ قدَرٌ فيَعدلُ بَينَنا",56,"ن",2,0],["وعَسى إِن صَبرتُ أَرجو ثَوابَ الص","صَبرِ كانَ الثَّوابُ إِبراهيما",57,"م",2,0],["وعسى وعل وبعد هذا غيره","فرجا اللقا من غير ما يستشرف",58,"ف",1,0],["وعساه يغفر لي ويرحمني","حسي به دون الورى حسبي",59,"ب",2,0],["وعسى من دعوة قد رفعت","فلكم قمت بها منتصبا",60,"ب",2,0],["وعَسَى قلوبٌ أعضَلَتْ أدواؤُها","في قُربِنَا بعد التَّفرِّقِ تُفرِقُ",61,"ق",1,0],["وعسى القوت بحفظ لم يضع","منه شيء وعسى أن لا ضرر",62,"ر",1,0],["وعسكريٍّ كلما رُمتُه","جرّد لي حُبَّ مُلاحاتِه",63,"ت",2,1],["وعسى الذنوب تفرقت كفراقكم","بكم وعنا ثقلها مضوع",64,"ع",1,0],["وعسى ان يقدر الل","ه تحقيق مستحب",65,"ب",1,0],["وعسى الأيام أن تُبدلَهُ","صِبغةً تنصُلُ أو لوناً يحولُ",66,"ل",1,0],["وعسفٌ في القضاء ويقتضيه","فتمحوه مياسرةٌ ورِفقُ",67,"ق",1,0],["وعسى الدنيا التي أدَّتكُمُ","تصطفينا من بنيها بنجيبِ",68,"ب",1,0],["وعسى أن يرقَّ قاسٍ فلا","أهلكُ وجداً وليتهُ ولعلاَّ",69,"ل",2,0],["وَعَساكَ تُدرِكُ قَطرَة ًمِن مائِها","أو نَخلَة ًيَبِسَتْ تَعودُ ، فَتُثمِرُ!",70,"ر",1,0],["وعسى لك الرحمنُ يقبَلُ دعوتي","ويُجيبُ فيكَ وفي بَنيكَ سؤالي",71,"ل",2,0],["وعسى يُمدُّكم الإلهُ جميعَكم","بزيادةِ الأعمار والأبناءِ",72,"ا",2,0],["وعسكر كأتي السيل مندفعاً","إما إلى صعد في الأرض أو صبب",73,"ب",1,0],["وعسى الليالي أن ترد زمانكم","لدناً كعود البانة المياس",74,"س",1,0],["وعَسَى وعَلَّ يَعودُ ذاك الْعَْدُ مِنْ","أَفْضالِ رَبٍّ مُبْتَدِي بالجُودِ",75,"د",1,0],["وعَسَايَ أَظْفَرُ بالْمنَى وَهُوَ الّذي","أَهْوَى وإن أَلْبَسْتُ نَظْمَ قَصِيدِي",75,"د",2,0],["وعَسى أن أعيشَ حتى أراكُم","ثُمَّ أهلاً مِن بعدِ ذا بارتِحالِ",76,"ل",1,0],["وعَسَى الذي جَمَعَ الأحبَّةَ مرّةً","أن لا يَعودَ مُفرِّقاً ما جَمَّعا",77,"ع",2,0],["وعَسى عَمُودُ الصُّبحِ يُلقي فَوقَنا","ظُلَلاً مُضمخَّمةً بأرواحِ الشَذا",78,"ا",1,0],["وعَسْجدِيِّ اللون لا غروَ أَنْ","يجري عليه دَمْعِيَ العَسْجَدِي",79,"د",2,0]]}