3,"دم بالصيام مهنأ ما داما","https://www.aldiwan.net/poem11821.html","الكامل"],[150,"أعدد لضيفك أهبة الإِكرام","https://www.aldiwan.net/poem68525.html","الكامل"],[178,"مفقود","https://www.aldiwan.net/poem50689.html","الكامل"],[189,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[189,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[193,"إن كنت تأنس بالحبيب وقربه","https://www.aldiwan.net/poem13046.html","الكامل"],[204,"قل لي بألسنة التنفس","https://www.aldiwan.net/poem53204.html","مجزوء الكامل"],[229,"لا والمضرج ثوبه","https://www.aldiwan.net/poem51271.html","مجزوء الكامل"],[237,"عرج على قبر","https://www.aldiwan.net/poem19791.html","مجزوء البسيط"],[252,"يأبى التأسي انهاء الأسى الجلدا","https://www.aldiwan.net/poem1436.html",""],[270,"طف بالكؤوس وأطلع أنجم الحلك","https://www.aldiwan.net/poem35288.html","البسيط"],[270,"حبي الخليفة مولانا ومولاك","https://www.aldiwan.net/poem35652.html","البسيط"],[280,"لو كنت شاهد عبرتي يوم النقا","https://www.aldiwan.net/poem60695.html","الكامل"],[282,"إلمام طيف شنيب الثغر ألماه","https://www.aldiwan.net/poem32309.html","البسيط"],[298,"تحية طيبة","https://www.aldiwan.net/poem36305.html","عموديه"],[305,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[326,"وأين من جبر الإسلام يوم وهي","https://www.aldiwan.net/poem44282.html","البسيط"],[348,"من صفة الجوهر أن يرسبا","https://www.aldiwan.net/poem19852.html","السريع"],[377,"وقبيلة جهلاؤها عقلاؤها","https://www.aldiwan.net/poem66981.html","الكامل"],[380,"واحر غلة قلبي الوقاد","https://www.aldiwan.net/poem48838.html","الكامل"],[400,"برقية شعرية إلى الصحافة العربية","https://www.aldiwan.net/poem10295.html","عموديه"],[403,"هل في القلوب بيوم الحشر إذعان","https://www.aldiwan.net/poem33388.html","البسيط"],[416,"لك بالمعالي رتبة تختارها","https://www.aldiwan.net/poem54015.html","الكامل"],[416,"طهر فؤادك بالراحات تطهيرا","https://www.aldiwan.net/poem54094.html","البسيط"],[439,"قل للربيع اسحب ملاء سحائب","https://www.aldiwan.net/poem34876.html","الكامل"],[514,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[515,"الشعر يعلم أن قدرك أكبر","https://www.aldiwan.net/poem12099.html","الكامل"],[515,"إن حارت الأفكار كيف تقول","https://www.aldiwan.net/poem12199.html","الكامل"],[515,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[529,"إن الرياسة لا تبقى وإن بقيت","https://www.aldiwan.net/poem37408.html","البسيط"],[551,"حتام ذمي عندكم أزماني","https://www.aldiwan.net/poem47167.html","الكامل"],[551,"لا تقطعن رجاء العيش بالعلل","https://www.aldiwan.net/poem47259.html","البسيط"],[551,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[551,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[553,"لولا سيوف أبي الزبير وخيله","https://www.aldiwan.net/poem68423.html","الكامل"],[562,"يا بائع الصبر لا تشفق على الشاري","https://www.aldiwan.net/poem52764.html","البسيط"],[575,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"],[587,"تأجج الوجد في الأحشا واضطربا","https://www.aldiwan.net/poem11556.html","عموديه"]],"verses":[["إِنَّ الرَبائِبَ مِن غِزلانِ أَسنِمَةٍ","أَعلَقنَ ذا الشَيبَ أَعلاقاً مِنَ الغَزَلِ",0,"ل",1,0],["إِنَّ الرِمّاحَ وَإِن طالَت ذَوائِبُها","مِنَ العِدى تَتَواصى عَنكَ بِالقِصَرِ",1,"ر",1,0],["إِنَّ الرَدى وَإِن رَمى فَصابا","وَجاذَبَتنا يَدُهُ جِذابا",2,"ب",2,0],["إِنَّ الرِماحَ رُزِئنَ مِنكَ مُشَيَّعاً","غَمرَ الرِداءِ مُهَذَّباً مِعطاءَ",3,"ا",2,0],["إِنَّ الرَسولَ الَّذي كانَت سَرائِرُنا","مَدفونَةً عِندهُ يا فَوزُ قَد ذَهَبا",4,"ب",2,0],["إِنَّ الرَزيئةَ مِثلُ حَب","وَةَ يَومَ فارَقَهُ صِحابُه",5,"ب",2,0],["إِنَّ الرَبابَ وَحَيّاً مِن بَني أَسَدٍ","مِنهُم بَقيرٌ وَمِنهُم سارِبٌ سَلَفُ",6,"ف",1,0],["إِنَّ الرَسولَ لَسَيفٌ يُستَضاءُ بِهِ","مُهَنَّدٌ مِن سُيوفِ اللَهِ مَسلولُ",7,"ل",1,0],["إن الرعايا جزاك الله صالحة","ملكت شرقاً وغرباً من يراعيها",8,"ي",3,0],["إن الرزايا قد قضت عجبا","مما رزئناه من الحسب",9,"ب",1,0],["إِنَّ الرُصافَةَ مَنزِلٌ لِخَليفَةٍ","جَمَعَ المَكارِمَ وَالعَزائِمَ وَالتُقى",10,"ا",1,0],["إِنَّ الرَزِيَّةَ مَن تَضَمَّنَ قَبرَهُ","وادي السِباعِ لِكُلِّ جَنبٍ مَصرَعُ",11,"ع",1,0],["إِنَّ الرَزِيَّةَ لا رَزِيَّةَ مِثلُها","فِقدانُ كُلِّ أَخٍ كَضَوءِ الكَوكَبِ",12,"ب",1,0],["إنَّ الرَّسُولَ رَسُولَ اللهِ قَالَ لَنَا","إنَّ الوَلِيَّ عليٌّ غَيرَ ما هَجَرَا",13,"ر",2,0],["إن الربيعَ لكالشَّباب وإنْ","نَ الصيفَ يكسعه لكالهرمِ",14,"م",1,0],["إنَّ الرحيلَ إلى من أنتَ آمِلُهُ","أمْرٌ لمُزْمِعه بالنُّجْحِ إيقان",15,"ن",1,0],["إِنَّ الرَضِيَّ الَّذي بُليتُ بِهِ","أَفعالُهُ الكُلُّ غَيرُ مَرضِيِّ",16,"ي",1,1],["إِنَّ الرُفاتَ لَتَستَعِزُّ بِأَرضِها","وَثَرى البِلادِ إِلى النُفوسِ مُحَبَّبُ",17,"ب",1,0],["إن الرعية أغنما يَحدُّ لهم","عمَّالك المستبدون السكاكينا",18,"ن",2,0],["إِنَّ الرِجالَ إِذا ما أُلجِئوا لَجَئوا","إِلى التَعاوُنِ فيما جَلَّ أَو حَزَبا",19,"ب",2,0],["إنَّ الرَّسُولَ لَمْ يَزَلْ يقولُ","والخَيْرُ ما قالَ بهِ الرَّسُولُ",20,"ل",1,1],["إِنَّ الرَزايا وَالعَطايا وَالقَنا","حُلَفاءُ طَيٍّ غَوَّروا أَو أَنجَدوا",21,"د",3,0],["إِنَّ الرِياحَ إِذا عَمَدنَ لِناظِرٍ","أَغناهُ مُقبِلُها عَنِ اِستِعجالِهِ",22,"ل",2,0],["إِنَّ الرَزِيَّةَ في الفَقيدِ فَإِن هَفا","جَزَعٌ بِصَبرِكَ فَالرَزِيَّةُ فيكا",23,"ك",2,0],["إِنَّ الرَزِيَّةَ لا رَزِيَّةَ مِثلُها","لِلناسِ فِقدُ مُحَمَّدٍ وَمُحَمَّدِ",24,"د",1,1],["إِنَّ الرَسولُ قَضاهُ اللَهُ رَحمَتَهُ","لِلناسِ وَالناسُ في ظَلماءَ دَيجورِ",25,"ر",1,0],["إِنَّ الرَزِيَّةَ مِن ثَقيفٍ هالِكٌ","تَرَكَ العُيونَ وَنَومُهُنَّ غِرارُ",26,"ر",1,0],["إِنَّ الرَقارِعَ وَالحُتاتَ وَغالِباً","وَأَبا هُنَيدَةَ دافَعوا لِمَقامي",27,"م",2,0],["إنَّ الربيعَ مُبيدُ خضراءِ العِدا","ومُسيلُ أنفسِهم على خَضْرائِه",28,"ا",3,0],["إِنَّ الرَزيئَةَ مالَها مَثَلٌ","فِقدانُ مَن يَنمي إِلى الحَزمِ",29,"م",1,0],["إِنَّ الرَزِيَّةَ لا رَزِيَّةَ مِثلُها","ما تَبتَغي غَطَفانُ يَومَ أَضَلَّتِ",30,"ت",1,1],["إِنَّ الرِكابَ لَتَبتَغي ذا مِرَّةٍ","بِجُنوبِ نَخلَ إِذا الشُهورُ أُحِلَّتِ",30,"ت",1,0],["إِنَّ الرَحيلَ عَنِ الدُنيا لَيُزعِجُني","إِن لَم يَكُن رائِحاً بي كانَ مُغتَدِيا",31,"ي",2,0],["إِنَّ الرِياحَ إِذا ما أَعصَفَت قَصَفَت","عيدانَ نَجدٍ وَلَم يَعبَأنَ بِالرَتَمِ",32,"م",1,0],["إِنَّ الرِماحَ إِذا غُرِسنَ بِمَشهَدٍ","فَجَنى العَوالي في ذَراهُ مَعالِ",33,"ل",1,0],["إن “الرُّعَاةَ” الساهرينَ","سيمنعونَكِ أنْ تُضَامِ",34,"م",1,0],["إِنَّ الرِجالَ عَلى تَأَلُّفِهِم","طُبِعوا عَلى الإِخلافِ وَالغَدرِ",35,"ر",1,0],["إنّ الرجالَ مُجاهدٌ لبلادهِ","فادٍ يذود عن الحمَى ويُذادُ",36,"د",1,0],["إنّ الرسولَ لَسَمْحٌ ذو مُيَاسَرَةٍ","إذا تملَّكَ أعناقَ الجُناةِ عَفَا",37,"ف",2,0],["إِنَّ الرِياسَةَ بَعدَهُ لَكَئيبَةٌ","ما إِن يَقِرُّ بِها الغَداةَ قَرارُ",38,"ر",1,0],["إِنَّ الرَزِيَّةَ لا أَبا لَكِ هالِكٌ","بَينَ الدِماخِ وَبَينَ دارَةِ خَنزَرِ",39,"ر",1,0],["إِنَّ الرَبيعَ فَأَدنِهِ","نِعمَ الوَزيرُ عَلى الشَدائِد",40,"د",1,0],["إِنَّ الرَزِيَّةَ لارَزِيَّةَ مِثلُها","يَومَ اِبنُ حَفصٍ في الدِماءِ خَضيبُ",41,"ب",1,0],["إِنَّ الرَسولَ الَّذي أَرسَلتِ غادَرَني","بِغُلَّةٍ مِثلِ حَرِّ النارِ مَشبوبِ",42,"ب",1,0],["إِنَّ الرُمَيثَةَ مانِعٌ أَرماحُنا","ما كانَ مِن سَحَمٍ بِها وَصَفارِ",43,"ر",1,0],["إِنَّ الرِئاسَةَ وَالرَيسَ اللَذانِ هُما","أَصلُ الحُقودِ فَلا تَرأَس وَلا تَرِس",44,"س",1,0],["إِنَّ الرِجالَ إِذا لَم يَحمِها رَشَدٌ","مِثلُ النِساءِ عَراها الخُلفُ وَالخُلُفُ",45,"ف",1,0],["إِنّا لَرَكبُ لَيالٍ غَيرِ وانِيَةٍ","فَقوتِلَت مِن رِكابٍ ما لَها ثَفَنُ",46,"ن",1,0],["إِنَّ الرَحيلَ إِلى قَومٍ وَإِن بَعُدوا","أَمسَوا وَمِن دونِهِم ثَهلانُ فَالنيرُ",47,"ر",1,0],["إن الرَبيع كثيرة أوراده","فاذا اِنقَضى لم يَبقَ من أوراد",48,"د",1,1],["إن الرجال لهم نقص بمفردهم","وإنما بالنساء النقص يكتمل",49,"ل",1,0],["إن الرزايا تريد موتي","لكنما النفس لا تريد",50,"د",1,1],["إن الرقاد على من","يَشكو سقاماً حرامُ",51,"م",1,0],["إن الرجال جذوع","إن النساء فروع",52,"ع",1,0],["إن الرَّبيع لسيد الأزمانِ","فيه تتم لذاذة الإنسانِ",53,"ن",1,1],["إِنَّ الرِّجَالَ إِذا تَأَخَّرَ نَفْعُهُمْ","في كُلِّ مَعْنًى شُبِّهُوا بنِساءِ",54,"ا",2,0],["إِنَّ الرَّوَائِمَ لا تَدُرُّ لَبُونُهَا","إِلَّا بِلِينِ الْمَسْحِ وَالإِبْسَاسِ",55,"س",1,0],["إِنَّ الرَّجَاءَ مُعِينٌ","وَمَا الرَّجَاءُ بِفَادِ",56,"د",1,0],["إن الريال غنى ولكن عفتي","فوق الغنى ونفائس الأعلاق",57,"ق",1,0],["إِنَّ الرَعِيَّةَ لَم تَزَل في سيرَةٍ","عُمَرِيَّةٍ مُذ ساسَها المُتَوَكِّلُ",58,"ل",1,0],["إِنَّ الرَقاشِيَّ مِن تَكَرُّمِهِ","بَلَّغَهُ اللَهُ مُنتَهى هِمَمِه",59,"ه",1,1],["إن الرماحَ حَدائدٌ مَنْبُوذَةٌ","حتى يُثقِّفَ جِانِبيْها سَمْهَرُ",60,"ر",1,0],["إن الرئيس تعبان","لراحتيه بحران",61,"ن",1,0],["إن الرعاة تفرقوا","ويح القطيع من الذئاب!",62,"ب",1,0],["إنَّ الربيعَ هو الحياةُ، وسرُّها","لولاه لم نحرص على الأعمار",63,"ر",1,0],["إنَّ الرذيلةَ شرُّ ما نعيا به","وأشدُّه خطرًا على الأرواح",64,"ح",1,0],["إن الربيعَ كتابُ الحبِّ نقرؤُهُ","الحبُّ حاشية فيه، وعنوان",65,"ن",1,0],["إِنَّ الرِجالَ إِذا ما أُلجِئوا لَجَؤوا","إِلى التَعاوُنِ فيما جَلَّ أَو حَزَبا",66,"ب",2,0],["إن الرُّعَاةَ! الساهرينَ","سيمنعونَكِ أنْ تُضَامِي",67,"م",2,0],["إنّ الرّزِيَّةَ في الفَقيدِ، فإنْ هَفَا","جَزَعٌ بصَبرِكَ، فالرّزِيئَةُ فيكَا",68,"ك",2,0],["إِنَّ الرَسولَ لَنورٌ يُستَضاءُ بِهِ","مُهَنَّدٌ مِن سُيوفِ اللَهِ مَسلولُ",69,"ل",1,0],["إن الربيعَ لكالشَّباب وإنْ","صيف يكسعه لكالهرم",70,"م",1,0],["إنَّ الرفيق يراد قبل طريقهم","والجار قبل الدار يطلب مرسما",71,"م",2,0],["إن الرثاء به أَحق من","الفقيد الفاقدون",72,"ن",1,0],["إن الربابة فوق صدرك","يا أخي أبهى وسام",73,"م",1,0],["إِنَّ الرَعايا في جَنابِكَ أَمَّنَت","كَيدَ الغَشومِ وَفَتكَةَ المُتَغَشرِمِ",74,"م",1,0],["إِنَّ الرَعايا مُذ مَلَكتَ تَقَيَّلوا","مِن ظِلِّ عِزِّكَ يَذبُلاً وَشَماما",75,"م",2,0],["إن الرّجال على لاحقيقة زمرةٌ","قطعته نائمة على الأقدام",76,"م",1,0],["إنّ الرّزايا قَدْ تَكاثَرَ نَسْلُها","وتَجَمَّرتْ في قَبْوِ روحِكَ تَتَّقِدْ",77,"د",1,0],["إنّ الروافضَ قَومٌ لا خلاق لهم","مِن أجهلِ الناس في علمٍ وأكذبهِ",78,"ب",2,0],["إنّ الرِيا يُحوّل الحالاتِ","وَيقلبُ الطاعات سيّئاتِ",79,"ت",1,0],["إِنَّ الرَقيبَ إِذا صَبَرتَ لِحُكمِهِ","بَواكَ في مَثوى الحَبيبِ وَدارِهِ",80,"ه",1,0],["إنَّ الرقيب مُنَغِّصٌ","عيشاً يُلذِّذُه وصالُكْ",81,"ك",1,0],["إنّ الرجال إذا شَكَوْا","لَعِبوا بأخلاق النساء",82,"ا",2,0],["إِنَّ الرِّضَى مَسْعُودْ","مُذْ طَلَّقَ الْمَفْقُودْ",83,"د",1,0],["إِنَّ الرَزيَّةَ فَضلٌ لَستَ مُحصيَهُ","لَيسَ الرَزيَّةَ أَن لا تُحصيَ العَددا",84,"د",2,0],["إنَّ الرَّحيقَ لِمَن رقَّت شمائلُهُم","هُم أهلُ لطفٍ فما يخشون من دَرَك",85,"ك",1,0],["إن الرزيئة كبرى لا عزاءَ لها","حتى اليهوديُّ أخزانا وأخزاك",86,"ك",1,0],["إِنَّ الرِّياسَةَ لا تَلِيقُ بِغَيْرِ مَنْ","مُذ كانَ كانَ بِثَدْيِها مُتَمَطِّقا",87,"ق",2,0],["إِنَّ الرَحيلَ الَّذي أَصبَحتَ تُزمِعُهُ","هُوَ الَّذي كُنتُ عِندَ القُربِ أَخشاهُ",88,"ا",2,0],["إنَّ الرزايا مقبلا","تٌ والمنى في هرب",89,"ب",1,0],["إِنّ الرزايا لِلبصيرِ مواعظٌ","تُثنيهِ عَن ذاك القرارِ وتردعُ",90,"ع",1,0],["إِنَّ الرَبيعَ وَإِنَّ الفَضلَ قَد بَنَيا","رِواقَ مَجدٍ عَلى العَبّاسِ مَمدودٌ",91,"د",1,0],["إنَّ الرَّدَى غَاصَ علَى دُرَّةٍ","عَزَّتْ علَى غَيْرِ الرَّدَى مَطْلَبا",92,"ب",2,0],["إِنَّ الرزِيَّةَ لا رزِيَّةَ مثلُها","ذَنبُ الجدود تُسيغُهُ أَبناؤُها",93,"ا",3,0],["إِن الرضاءَ بِما لَدَيك هُوَ الغَني","وَالمُلك كُل المُلك للزُهّاد",94,"د",1,0],["إن الرضا منكم بسطر واحد","يؤذي مشاعر دينكم لعجاب",95,"ب",1,0],["إن الرماح ظماء للدماء فهل","يعود يوماً ومنها الرمح ريان",96,"ن",1,0],["إنَّ الرَّزانةَ في النُّفوس ولم تطش","نفسٌ وقار الرَّاسيات وقارها",97,"ر",3,0],["إنَّ الرُّواة الَّتي تروي مناقبهم","عنهُمْ رَوَت خبراً بالمجد مأثورا",98,"ر",2,0],["أَنَّ الربيعَ لَدَيَّ شِيمةُ قاطِنٍ","وحَيا الغمامِ عَلَيَّ دِيمَةُ دائِبِ",99,"ب",1,0],["إنّ الرعايةَ لا تُعزى إلى شرفٍ","إلّا إذا كانتِ الأشرافُ تَرعاها",100,"ا",3,0],["إن الرعايا استبشرت بخليفة","وجه الزمان بوجهه يستبشر",101,"ر",1,0],["إن الرسول أبوكم من دونها","فمن الذي منها أبوه رسول",102,"ل",1,0],["إن الرزية والعطية فيهما","مزجت بطعم الشهد طعم الحنظل",103,"ل",1,0],["إنّ الرِّياسَةَ لا تَبْقَى وإِنْ بِقِيَتْ","إلاّ بأمْرَيْنِ مَعْلُومَيْن للبَشَرِ",104,"ر",1,1],["إنّ الرّدى دَيْنٌ عليك قضاؤه","فاِسمحْ به في أشرفِ الأوطانِ",105,"ن",1,0],["إِنَّ الرّجالَ وإنْ راعتْك كثرتُهمْ","إذا خبرتَهمُ لم تُلفِ من رجلِ",106,"ل",1,0],["إنّ الرّدى لابدّ أُورَدُهُ","مستوخماً يوبى له الوِرْدُ",107,"د",1,0],["إنّ الرَّئيس الّذي راسَ الأنام بما","حواه من فضلهِ قبل الرّياساتِ",108,"ت",1,0],["إِنَّ الرِفاقَ أَتَتكَ تَلتَمِسُ الغِنى","وَالبَحرُ لَو يَجِدُ السَبيلَ أَتاكا",109,"ك",2,0],["إن الرِّياحَ تُصيبُ النَّخلَ تَقصِفُهُ","وليسَ تقصِفُ غُصنَ الشِّيحِ والغارِ",110,"ر",1,0],["إِنَّ الرحيمَ بعبدهِ رَحِم الوَرى","فأَتَي كَما اقْتَرحوا وجَاءَ كَما اقْتَرَح",111,"ح",1,0],["إن الرجا روح الأرواح فابتهجت","فانزاح عنها من الأحزان ما هجما",112,"م",2,0]]}