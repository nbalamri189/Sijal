x?id=181590",""],[2898,"يا عينُ جودي بِدَمعٍ منك مُنْسَجم","https://www.poetsgate.com/ViewPoem.aspx?id=41703",""],[5431,"كفكف دموعك لن تُراق وتهدرا","https://www.poetsgate.com/ViewPoem.aspx?id=192199",""],[5431,"معنى الرجولة..","https://www.poetsgate.com/ViewPoem.aspx?id=195355",""],[5431,"جذب الظباء السمر إذْ تردُ","https://www.poetsgate.com/ViewPoem.aspx?id=198444",""],[5574,"يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=205994",""],[5582,"هذِي مَنازِلُهُمْ هَلْ أَنْتَ تُبصِرُها","https://www.poetsgate.com/ViewPoem.aspx?id=187141",""],[5582,"أَتِلْكَ لِلحَيِّ أَحْداجٌ وَأَظْعانُ","https://www.poetsgate.com/ViewPoem.aspx?id=63592",""],[5660,"رَبابُ إِنّي إِذا عَزَّيتُ مُعتَذِرا","https://www.poetsgate.com/ViewPoem.aspx?id=27049",""],[5804,"ماذا يصدك","https://www.poetsgate.com/ViewPoem.aspx?id=191225",""],[5853,"روحان في فلك المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=175614",""],[5937,"هوَ من !","https://www.poetsgate.com/ViewPoem.aspx?id=211819",""],[5956,"محبة جُمِّدَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=182037",""],[5956,"لا تيأسَنَّ فإنّ الخيرَ موفورُ","https://www.poetsgate.com/ViewPoem.aspx?id=184205",""],[5956,"أعضاؤها لخدامتي تتسابقُ","https://www.poetsgate.com/ViewPoem.aspx?id=205481",""],[5977,"خير البرية","https://www.poetsgate.com/ViewPoem.aspx?id=213278",""],[6035,"رسالة إلى الجار ، والآخر هناك !","https://www.poetsgate.com/ViewPoem.aspx?id=176961",""],[6068,"في القلب من ذكر الرسول سعادة -09-","https://www.poetsgate.com/ViewPoem.aspx?id=175852",""],[4442,"يبدو الشباب بشكل الخرد العين","https://www.poetsgate.com/ViewPoem.aspx?id=171001",""],[6096,"رجلٌ أنا","https://www.poetsgate.com/ViewPoem.aspx?id=177138",""],[5309,"جذل وقلبي لا يزال عليلا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573525",""],[5051,"سَقْطُ القريض","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87709&r=&rc=3",""],[6310,"الزَّحف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=71996&r=&rc=1",""],[6336,"بعد العاصفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73566&r=&rc=27",""]],"verses":[["إِنَّ الرَبائِبَ مِن غِزلانِ أَسنِمَةٍ","أَعلَقنَ ذا الشَيبَ أَعلاقاً مِنَ الغَزَلِ",0,"ل",1,0],["إِنَّ الرِمّاحَ وَإِن طالَت ذَوائِبُها","مِنَ العِدى تَتَواصى عَنكَ بِالقِصَرِ",1,"ر",1,0],["إِنَّ الرَدى وَإِن رَمى فَصابا","وَجاذَبَتنا يَدُهُ جِذابا",2,"ب",2,0],["إِنَّ الرِماحَ رُزِئنَ مِنكَ مُشَيَّعاً","غَمرَ الرِداءِ مُهَذَّباً مِعطاءَ",3,"ا",2,0],["إِنَّ الرَسولَ الَّذي كانَت سَرائِرُنا","مَدفونَةً عِندهُ يا فَوزُ قَد ذَهَبا",4,"ب",2,0],["إِنَّ الرَزيئةَ مِثلُ حَب","وَةَ يَومَ فارَقَهُ صِحابُه",5,"ب",2,0],["إِنَّ الرَبابَ وَحَيّاً مِن بَني أَسَدٍ","مِنهُم بَقيرٌ وَمِنهُم سارِبٌ سَلَفُ",6,"ف",1,0],["إِنَّ الرَسولَ لَسَيفٌ يُستَضاءُ بِهِ","مُهَنَّدٌ مِن سُيوفِ اللَهِ مَسلولُ",7,"ل",1,0],["إن الرعايا جزاك الله صالحة","ملكت شرقاً وغرباً من يراعيها",8,"ي",3,0],["إن الرزايا قد قضت عجبا","مما رزئناه من الحسب",9,"ب",1,0],["إِنَّ الرُصافَةَ مَنزِلٌ لِخَليفَةٍ","جَمَعَ المَكارِمَ وَالعَزائِمَ وَالتُقى",10,"ا",1,0],["إِنَّ الرَزِيَّةَ مَن تَضَمَّنَ قَبرَهُ","وادي السِباعِ لِكُلِّ جَنبٍ مَصرَعُ",11,"ع",1,0],["إِنَّ الرَزِيَّةَ لا رَزِيَّةَ مِثلُها","فِقدانُ كُلِّ أَخٍ كَضَوءِ الكَوكَبِ",12,"ب",1,0],["إنَّ الرَّسُولَ رَسُولَ اللهِ قَالَ لَنَا","إنَّ الوَلِيَّ عليٌّ غَيرَ ما هَجَرَا",13,"ر",2,0],["إن الربيعَ لكالشَّباب وإنْ","نَ الصيفَ يكسعه لكالهرمِ",14,"م",1,0],["إنَّ الرحيلَ إلى من أنتَ آمِلُهُ","أمْرٌ لمُزْمِعه بالنُّجْحِ إيقان",15,"ن",1,0],["إِنَّ الرَضِيَّ الَّذي بُليتُ بِهِ","أَفعالُهُ الكُلُّ غَيرُ مَرضِيِّ",16,"ي",1,1],["إِنَّ الرُفاتَ لَتَستَعِزُّ بِأَرضِها","وَثَرى البِلادِ إِلى النُفوسِ مُحَبَّبُ",17,"ب",1,0],["إن الرعية أغنما يَحدُّ لهم","عمَّالك المستبدون السكاكينا",18,"ن",2,0],["إِنَّ الرِجالَ إِذا ما أُلجِئوا لَجَئوا","إِلى التَعاوُنِ فيما جَلَّ أَو حَزَبا",19,"ب",2,0],["إنَّ الرَّسُولَ لَمْ يَزَلْ يقولُ","والخَيْرُ ما قالَ بهِ الرَّسُولُ",20,"ل",1,1],["إِنَّ الرَزايا وَالعَطايا وَالقَنا","حُلَفاءُ طَيٍّ غَوَّروا أَو أَنجَدوا",21,"د",3,0],["إِنَّ الرِياحَ إِذا عَمَدنَ لِناظِرٍ","أَغناهُ مُقبِلُها عَنِ اِستِعجالِهِ",22,"ل",2,0],["إِنَّ الرَزِيَّةَ في الفَقيدِ فَإِن هَفا","جَزَعٌ بِصَبرِكَ فَالرَزِيَّةُ فيكا",23,"ك",2,0],["إِنَّ الرَزِيَّةَ لا رَزِيَّةَ مِثلُها","لِلناسِ فِقدُ مُحَمَّدٍ وَمُحَمَّدِ",24,"د",1,1],["إِنَّ الرَسولُ قَضاهُ اللَهُ رَحمَتَهُ","لِلناسِ وَالناسُ في ظَلماءَ دَيجورِ",25,"ر",1,0],["إِنَّ الرَزِيَّةَ مِن ثَقيفٍ هالِكٌ","تَرَكَ العُيونَ وَنَومُهُنَّ غِرارُ",26,"ر",1,0],["إِنَّ الرَقارِعَ وَالحُتاتَ وَغالِباً","وَأَبا هُنَيدَةَ دافَعوا لِمَقامي",27,"م",2,0],["إنَّ الربيعَ مُبيدُ خضراءِ العِدا","ومُسيلُ أنفسِهم على خَضْرائِه",28,"ا",3,0],["إِنَّ الرَزيئَةَ مالَها مَثَلٌ","فِقدانُ مَن يَنمي إِلى الحَزمِ",29,"م",1,0],["إِنَّ الرَزِيَّةَ لا رَزِيَّةَ مِثلُها","ما تَبتَغي غَطَفانُ يَومَ أَضَلَّتِ",30,"ت",1,1],["إِنَّ الرِكابَ لَتَبتَغي ذا مِرَّةٍ","بِجُنوبِ نَخلَ إِذا الشُهورُ أُحِلَّتِ",30,"ت",1,0],["إِنَّ الرَحيلَ عَنِ الدُنيا لَيُزعِجُني","إِن لَم يَكُن رائِحاً بي كانَ مُغتَدِيا",31,"ي",2,0],["إِنَّ الرِياحَ إِذا ما أَعصَفَت قَصَفَت","عيدانَ نَجدٍ وَلَم يَعبَأنَ بِالرَتَمِ",32,"م",1,0],["إِنَّ الرِماحَ إِذا غُرِسنَ بِمَشهَدٍ","فَجَنى العَوالي في ذَراهُ مَعالِ",33,"ل",1,0],["إن “الرُّعَاةَ” الساهرينَ","سيمنعونَكِ أنْ تُضَامِ",34,"م",1,0],["إِنَّ الرِجالَ عَلى تَأَلُّفِهِم","طُبِعوا عَلى الإِخلافِ وَالغَدرِ",35,"ر",1,0],["إنّ الرجالَ مُجاهدٌ لبلادهِ","فادٍ يذود عن الحمَى ويُذادُ",36,"د",1,0],["إنّ الرسولَ لَسَمْحٌ ذو مُيَاسَرَةٍ","إذا تملَّكَ أعناقَ الجُناةِ عَفَا",37,"ف",2,0],["إِنَّ الرِياسَةَ بَعدَهُ لَكَئيبَةٌ","ما إِن يَقِرُّ بِها الغَداةَ قَرارُ",38,"ر",1,0],["إِنَّ الرَزِيَّةَ لا أَبا لَكِ هالِكٌ","بَينَ الدِماخِ وَبَينَ دارَةِ خَنزَرِ",39,"ر",1,0],["إِنَّ الرَبيعَ فَأَدنِهِ","نِعمَ الوَزيرُ عَلى الشَدائِد",40,"د",1,0],["إِنَّ الرَزِيَّةَ لارَزِيَّةَ مِثلُها","يَومَ اِبنُ حَفصٍ في الدِماءِ خَضيبُ",41,"ب",1,0],["إِنَّ الرَسولَ الَّذي أَرسَلتِ غادَرَني","بِغُلَّةٍ مِثلِ حَرِّ النارِ مَشبوبِ",42,"ب",1,0],["إِنَّ الرُمَيثَةَ مانِعٌ أَرماحُنا","ما كانَ مِن سَحَمٍ بِها وَصَفارِ",43,"ر",1,0],["إِنَّ الرِئاسَةَ وَالرَيسَ اللَذانِ هُما","أَصلُ الحُقودِ فَلا تَرأَس وَلا تَرِس",44,"س",1,0],["إِنَّ الرِجالَ إِذا لَم يَحمِها رَشَدٌ","مِثلُ النِساءِ عَراها الخُلفُ وَالخُلُفُ",45,"ف",1,0],["إِنّا لَرَكبُ لَيالٍ غَيرِ وانِيَةٍ","فَقوتِلَت مِن رِكابٍ ما لَها ثَفَنُ",46,"ن",1,0],["إِنَّ الرَحيلَ إِلى قَومٍ وَإِن بَعُدوا","أَمسَوا وَمِن دونِهِم ثَهلانُ فَالنيرُ",47,"ر",1,0],["إن الرَبيع كثيرة أوراده","فاذا اِنقَضى لم يَبقَ من أوراد",48,"د",1,1],["إن الرجال لهم نقص بمفردهم","وإنما بالنساء النقص يكتمل",49,"ل",1,0],["إن الرزايا تريد موتي","لكنما النفس لا تريد",50,"د",1,1],["إن الرقاد على من","يَشكو سقاماً حرامُ",51,"م",1,0],["إن الرجال جذوع","إن النساء فروع",52,"ع",1,0],["إن الرَّبيع لسيد الأزمانِ","فيه تتم لذاذة الإنسانِ",53,"ن",1,1],["إِنَّ الرِّجَالَ إِذا تَأَخَّرَ نَفْعُهُمْ","في كُلِّ مَعْنًى شُبِّهُوا بنِساءِ",54,"ا",2,0],["إِنَّ الرَّوَائِمَ لا تَدُرُّ لَبُونُهَا","إِلَّا بِلِينِ الْمَسْحِ وَالإِبْسَاسِ",55,"س",1,0],["إِنَّ الرَّجَاءَ مُعِينٌ","وَمَا الرَّجَاءُ بِفَادِ",56,"د",1,0],["إن الريال غنى ولكن عفتي","فوق الغنى ونفائس الأعلاق",57,"ق",1,0],["إِنَّ الرَعِيَّةَ لَم تَزَل في سيرَةٍ","عُمَرِيَّةٍ مُذ ساسَها المُتَوَكِّلُ",58,"ل",1,0],["إِنَّ الرَقاشِيَّ مِن تَكَرُّمِهِ","بَلَّغَهُ اللَهُ مُنتَهى هِمَمِه",59,"ه",1,1],["إن الرماحَ حَدائدٌ مَنْبُوذَةٌ","حتى يُثقِّفَ جِانِبيْها سَمْهَرُ",60,"ر",1,0],["إن الرئيس تعبان","لراحتيه بحران",61,"ن",1,0],["إن الرعاة تفرقوا","ويح القطيع من الذئاب!",62,"ب",1,0],["إنَّ الربيعَ هو الحياةُ، وسرُّها","لولاه لم نحرص على الأعمار",63,"ر",1,0],["إنَّ الرذيلةَ شرُّ ما نعيا به","وأشدُّه خطرًا على الأرواح",64,"ح",1,0],["إن الربيعَ كتابُ الحبِّ نقرؤُهُ","الحبُّ حاشية فيه، وعنوان",65,"ن",1,0],["إِنَّ الرِجالَ إِذا ما أُلجِئوا لَجَؤوا","إِلى التَعاوُنِ فيما جَلَّ أَو حَزَبا",66,"ب",2,0],["إن الرُّعَاةَ! الساهرينَ","سيمنعونَكِ أنْ تُضَامِي",67,"م",2,0],["إنّ الرّزِيَّةَ في الفَقيدِ، فإنْ هَفَا","جَزَعٌ بصَبرِكَ، فالرّزِيئَةُ فيكَا",68,"ك",2,0],["إِنَّ الرَسولَ لَنورٌ يُستَضاءُ بِهِ","مُهَنَّدٌ مِن سُيوفِ اللَهِ مَسلولُ",69,"ل",1,0],["إن الربيعَ لكالشَّباب وإنْ","صيف يكسعه لكالهرم",70,"م",1,0],["إنَّ الرفيق يراد قبل طريقهم","والجار قبل الدار يطلب مرسما",71,"م",2,0],["إن الرثاء به أَحق من","الفقيد الفاقدون",72,"ن",1,0],["إن الربابة فوق صدرك","يا أخي أبهى وسام",73,"م",1,0],["إِنَّ الرَعايا في جَنابِكَ أَمَّنَت","كَيدَ الغَشومِ وَفَتكَةَ المُتَغَشرِمِ",74,"م",1,0],["إِنَّ الرَعايا مُذ مَلَكتَ تَقَيَّلوا","مِن ظِلِّ عِزِّكَ يَذبُلاً وَشَماما",75,"م",2,0],["إن الرّجال على لاحقيقة زمرةٌ","قطعته نائمة على الأقدام",76,"م",1,0],["إنّ الرّزايا قَدْ تَكاثَرَ نَسْلُها","وتَجَمَّرتْ في قَبْوِ روحِكَ تَتَّقِدْ",77,"د",1,0],["إنّ الروافضَ قَومٌ لا خلاق لهم","مِن أجهلِ الناس في علمٍ وأكذبهِ",78,"ب",2,0],["إنّ الرِيا يُحوّل الحالاتِ","وَيقلبُ الطاعات سيّئاتِ",79,"ت",1,0],["إِنَّ الرَقيبَ إِذا صَبَرتَ لِحُكمِهِ","بَواكَ في مَثوى الحَبيبِ وَدارِهِ",80,"ه",1,0],["إنَّ الرقيب مُنَغِّصٌ","عيشاً يُلذِّذُه وصالُكْ",81,"ك",1,0],["إنّ الرجال إذا شَكَوْا","لَعِبوا بأخلاق النساء",82,"ا",2,0],["إِنَّ الرِّضَى مَسْعُودْ","مُذْ طَلَّقَ الْمَفْقُودْ",83,"د",1,0],["إِنَّ الرَزيَّةَ فَضلٌ لَستَ مُحصيَهُ","لَيسَ الرَزيَّةَ أَن لا تُحصيَ العَددا",84,"د",2,0],["إنَّ الرَّحيقَ لِمَن رقَّت شمائلُهُم","هُم أهلُ لطفٍ فما يخشون من دَرَك",85,"ك",1,0],["إن الرزيئة كبرى لا عزاءَ لها","حتى اليهوديُّ أخزانا وأخزاك",86,"ك",1,0],["إِنَّ الرِّياسَةَ لا تَلِيقُ بِغَيْرِ مَنْ","مُذ كانَ كانَ بِثَدْيِها مُتَمَطِّقا",87,"ق",2,0],["إِنَّ الرَحيلَ الَّذي أَصبَحتَ تُزمِعُهُ","هُوَ الَّذي كُنتُ عِندَ القُربِ أَخشاهُ",88,"ا",2,0],["إنَّ الرزايا مقبلا","تٌ والمنى في هرب",89,"ب",1,0],["إِنّ الرزايا لِلبصيرِ مواعظٌ","تُثنيهِ عَن ذاك القرارِ وتردعُ",90,"ع",1,0],["إِنَّ الرَبيعَ وَإِنَّ الفَضلَ قَد بَنَيا","رِواقَ مَجدٍ عَلى العَبّاسِ مَمدودٌ",91,"د",1,0],["إنَّ الرَّدَى غَاصَ علَى دُرَّةٍ","عَزَّتْ علَى غَيْرِ الرَّدَى مَطْلَبا",92,"ب",2,0],["إِنَّ الرزِيَّةَ لا رزِيَّةَ مثلُها","ذَنبُ الجدود تُسيغُهُ أَبناؤُها",93,"ا",3,0],["إِن الرضاءَ بِما لَدَيك هُوَ الغَني","وَالمُلك كُل المُلك للزُهّاد",94,"د",1,0],["إن الرضا منكم بسطر واحد","يؤذي مشاعر دينكم لعجاب",95,"ب",1,0],["إن الرماح ظماء للدماء فهل","يعود يوماً ومنها ا