 الرسول لنور يستضاء به )","في ظلمة الجهل يهدينا إلى القممِ",252,"م",1,1],["إنَّ الرسائل تُبْديْ طبعَ مرسلها","وقد تَبَدَّى بما أرسلتمُ الدّخلِ",253,"ل",1,0],["إن الرسول على التوارخ آية","مشهورة جُمِعتْ له ولصحبِه",254,"ب",2,0],["أن الرقي الذي تبغينه حلم","فلقي عنه تأويل ابن سيرين",255,"ن",1,0],["إنَّ الرّجولةَ أن تكونَ مهذَّباً","سمْحاً عطوفاً عاقلاً متفهّما",256,"م",2,0],["إنَّ الرِّجالَ اثنانِ فَاختَر مِنهُما","مَن جَرَّ حَمداً لا غَنىً وَذُيولا",257,"ل",2,0],["آنَ الرحيلُ إلى الهوامِشِ بعدَما","حِصْن الأصالةِ هَدَّهُ الأعْداءُ",258,"ا",2,0],["أنَّ الرّصاصَ هو الخلاصُ ولا خلاص مع التخاذلْ","عُودُوا إذن .. مِن قبل طوفان التَّحدّي للفصائل",259,"ل",1,0],["إنَّّ الرياح على الأديم تبعثرت","وتمزّقت نسماً قواها الجارفه",260,"ف",2,0]]}