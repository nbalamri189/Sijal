{"poems":[[53,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[64,"فؤاد على كر الحوادث مارد","https://www.aldiwan.net/poem52454.html","الطويل"],[82,"دم الكرم في الكاس أم عندم","https://www.aldiwan.net/poem31306.html","المتقارب"],[189,"ويوم تبدى من سحائبه الودق","https://www.aldiwan.net/poem14605.html","الطويل"],[310,"عوى الضبع الملفلف في الثياب","https://www.aldiwan.net/poem56599.html","البسيط"],[469,"بقبرك فلتسحب ذيول السحائب","https://www.aldiwan.net/poem3210.html","عموديه"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104624","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70745","الطويل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67263","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117878","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131253",""],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93759","الرمل"]],"verses":[["يُقهقر الفحلُ وهْي باركةٌ","ثم يَصُكُّ استها بإكماش",0,"ش",1,0],["يُقَهقِرُ عَن نَيلِ المَعالي خُطاهُمُ","فَسِيّانَ ساعٍ لِلمَعالي وَقاعِدُ",1,"د",1,0],["يقهقهُ في الصبّ إبريقُها","كما هَدَرَ البازلُ المُقْرَمُ",2,"م",1,0],["يُقَهْقه فيه الرعدُ من أَدْمُع الحَيا","ويبسم من أنفاس أَرياحِه البرق",3,"ق",1,0],["يُقهقه حَولنا فيخال دبّاً","ويحكي هذوه هذو الكلابِ",4,"ب",1,0],["يقهقه في أعطافه الرعد ضاحكاً","وتبكي جفون الغاديات السواكب",5,"ب",1,0],["يقةلُ ويسطو لا لسانٌ ولا يدٌ","فأعجب بهِ أنَّي يترجمُ أو يَسطو",6,"ط",2,0],["يقَهْقِر بالصَّمصَامِ كل غَشمْشَمٍ","وللجود نشرٌ منه كالمسك فائح",7,"ح",1,0],["يُقهقِه إذ تُكلّمه وهذي","صفاتُ الدّبِ في رجع الكلام",8,"م",1,0],["يقةل الحق إبراماً ونقضاً","كفى بإلهنا وبه حسيبا",9,"ب",2,0],["يقهر النكس ذا البسالة فيها","ويخاف الجبار فيها الوليدا",10,"د",2,0],["يَقهر الشم وَكَم في حُكمه","كابر العصفور وَانقضّ العقاب",11,"ب",1,0]]}