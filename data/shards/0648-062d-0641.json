/www.poetsgate.com/ViewPoem.aspx?id=49465",""],[4927,"فيروز","https://www.poetsgate.com/ViewPoem.aspx?id=29626",""],[4927,"سَهَرُ الْعَاْشِق","https://www.poetsgate.com/ViewPoem.aspx?id=29636",""],[5009,"الملحمة النونية","https://www.poetsgate.com/ViewPoem.aspx?id=24368",""],[5013,"نعى الدين والدنيا فعم ظلامها","https://www.poetsgate.com/ViewPoem.aspx?id=170966",""],[5055,"المهر","https://www.poetsgate.com/ViewPoem.aspx?id=106076",""],[5111,"بسمةُ الرحمانِ","https://www.poetsgate.com/ViewPoem.aspx?id=212080",""],[5186,"يا ناثر النظم الأرق الأنفس","https://www.poetsgate.com/ViewPoem.aspx?id=156549",""],[5186,"جحدوا فضل بني العرب جحودا","https://www.poetsgate.com/ViewPoem.aspx?id=156479",""],[5302,"إني أحبك يا نجود","https://www.poetsgate.com/ViewPoem.aspx?id=200779",""],[5302,"يا خادم الحرمين","https://www.poetsgate.com/ViewPoem.aspx?id=200944",""],[5325,"من شل من غلب العلى أيمانها","https://www.poetsgate.com/ViewPoem.aspx?id=171981",""],[592,"على الحبر بحر العلم الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128858",""],[5377,"إلى الغاضبين علينا","https://www.poetsgate.com/ViewPoem.aspx?id=61899",""],[5397,"رميت بقوس الحزم عن قوس حاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157922",""],[5431,"لاسلمَ في عرْفِ الهوى لأسايره","https://www.poetsgate.com/ViewPoem.aspx?id=192058",""],[5431,"عادات ثقيلة ...","https://www.poetsgate.com/ViewPoem.aspx?id=213746",""],[5538,"الله يقسم من أضاع فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=142624",""],[5582,"لِمَنْ بِطُلُولِ الأَبْرَقَيْنِ مُقامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187300",""],[2678,"وافت هديتك التي","https://www.poetsgate.com/ViewPoem.aspx?id=167476",""],[5664,"سلامات","https://www.poetsgate.com/ViewPoem.aspx?id=176698",""],[5685,"قبلة الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=36763",""],[5691,"منهاج...!","https://www.poetsgate.com/ViewPoem.aspx?id=206354",""],[5770,"خمسون عاما","https://www.poetsgate.com/ViewPoem.aspx?id=178689",""],[5781,"بحرٌ بما يكفي لحُبٍّ وعاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=202850",""],[402,"لذكراك يا حفني في النفس أشجان","https://www.poetsgate.com/ViewPoem.aspx?id=36492",""],[5842,"إلى جيش الغطاريف .. الجيش السوري","https://www.poetsgate.com/ViewPoem.aspx?id=68315",""],[5943,"تشطير (الشّعرُ لي )","https://www.poetsgate.com/ViewPoem.aspx?id=138283",""],[6070,"رحى الحدثان","https://www.poetsgate.com/ViewPoem.aspx?id=188815",""],[6093,"عَلى أَطْلالِ بَعْضِيَ قَامَ بَعْضِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=191508",""],[549,"الفارس والصهيل المكسر","https://www.poetsgate.com/ViewPoem.aspx?id=203001",""],[520,"أقول والصدق فيما قلت يعضدني","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577664",""],[6164,"أيها الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66015&r=&rc=25",""],[6202,"انفض السامر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86710&r=&rc=11",""],[5464,"بغداد والخمسون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=491&r=&rc=5",""],[6256,"مداعبة صديق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65926&r=&rc=14",""],[6328,"الطريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84423&r=&rc=21",""],[5190,"فاض الكيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78342&r=&rc=55",""],[5190,"الرزق الحلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78291&r=&rc=5",""]],"verses":[["وَحِفاظي كَما عَلِمتَ وَلَكِن","أَنكَرَ الغَدرَ وُدِّيَ المَعروفُ",0,"ف",1,0],["وَحَفِظتُ ما اِستَودَعتُ مِن نِعمائِكُم","إِنَّ الوَفاءَ أَمانَةٌ تُستَودَعُ",1,"ع",1,0],["وحَفّتْ بهِ مِنْ سِرِّ جوثَةَ غِلْمَةٌ","مَناعيشُ للمَوْلى رِقاقُ المآزرِ",2,"ر",1,0],["وحفَّ بِنا جُنْحُ الظّلامِ كأنّما","أحاديثُ سرٍّ ضمّها قلْبُ جاحِدِ",3,"د",1,0],["وحَفَّ بيَ الغيدُ الحِسانُ لخِدْمَتي","فسِرّيَ مكْتومٌ وحُسْنيَ بادي",4,"د",2,0],["وحَفّتْ بِهِ الأعْداءُ منْ كلِّ جانِبٍ","كما حَفّ بالخَصْرِ الهَضيمِ وِشاحُهُ",5,"ح",2,0],["وَحَفِظتُ أَوراقي بِمَح","فَظَتي فَلا تَتَوَزَّعُ",6,"ع",1,0],["وَحَفْنِيُّ كَانَ الشَّاعِرُ المُبْدِعُ الَّذِي","قَصَائِدُهُ دُرُّ نُظِمْنَ وَعِقْيَانُ",7,"ن",1,0],["وَحِفْنِيُّ كَانَ العَالِمَ العَامِلَ الَّذِي","لَهُ القَوْلُ طَوْعٌ وَالبَلاغَةُ مِذْعَانُ",7,"ن",1,0],["وَ حِفْنِيُّ كَانَ الجِهْبِذَ اللَّبِقَ الَّذِي","بِهِ عَادَ لِلفُصْحَى عَلَى اللَّغْوِ سُلْطَانُ",7,"ن",1,0],["وَ حِفْنِيُّ فِي نَادِيهِ ذُو الكَلِمِ الَّتِي","بِأَبْدَعَ مِنْهَا لا تُشَنَّفُ آذَانُ",7,"ن",1,0],["وَ حِفْنِيُّ قَاضٍ رَاقَبَ اللهَ عَالِماً","بِأَنَّ الَّذِي إِذَا اقْتَصَّ رَحْمَنُ",7,"ن",1,0],["وَحَفٌ كَأَنَّ النَدى وَالشَمسُ ماتِعَةٌ","إِذا تَوَقَّدَ في أَفنانِهِ التومُ",8,"م",1,0],["وحَفَّته في أفقِ السماءِ سُعودُهُ","وفي الأرض خِيريَّاته ونَراجسه",9,"س",2,0],["وَحَفيفُ النَسيمِ في مَسمَعِ","الأَوراقِ نَجوى تَبُثُّها شَفَتاها",10,"ا",3,0],["وَحفٍ أَثيثٍ عَلى المَتنَينِ مُنسَدِلٍ","مُستَفرَغٍ بِدِهانِ الوَردِ مَجّاجِ",11,"ج",1,0],["وحفيفِ الغصونِ نمَّقها الطَّلُّ","وهَمْسِ النَّسيمِ للأولادِ",12,"د",1,0],["وحَفيفَ أجنحةٍ ترفرف في الفضا","وصدًى يَرنُّ على سُكونِ الغاب",13,"ب",1,0],["وَحِفظُكَ فيهِمِ سَلَفي مَعَدٍّ","وَأَنَّهُمُ العَشائِرُ وَالصِحابُ",14,"ب",1,0],["وَحَفيفُ أَجنِحَةِ المَلائِكِ حَولُهُ","وَعُيونُ أَهلِ اللاذِقِيَّةِ صورُ",15,"ر",1,0],["وَحُفرَةُ بَيتٍ أَنتَ فيها مُوَسَّدٌ","وَقَد سُدَّ مِن دونِ العَوائِدِ بابُها",16,"ب",3,0],["وحفوا الشوارب عن نخرة","تضرم إن يطفئوا نارها",17,"ر",3,0],["وَحِفظي لِلأَمانَةِ وَاِصطِباري","عَلى ما كانَ مِن رَيبِ الزَمانِ",18,"ن",1,0],["وَحِفاظَ جارِكَ لا تُضِعهُ فَإِنَهُ","لا يَبلُغُ الشَرَفُ الجَسيمُ مُضيِّعُ",19,"ع",1,0],["وَحُفِفتِ يا دُنيا بِكُلِّ بَلِيَّةٍ","وَمُزِجتِ يا دُنيا بِكُلِّ وَبالِ",20,"ل",1,0],["وَحَفَظتُ عَهدَكَ مِثلَ حِفظي صِحَّتي","وَشَهِدتَ في ذاكَ المَقامِ مَقالي",21,"ل",2,0],["وحفير من الصبابةِ فيه","في حجاب التقى سريرة كمِّ",22,"م",1,0],["وَحَفَّت بي العَشائِرُ وَالأَقاصي","عِيالاً لي وَكُنتُ لَهُم عِيالا",23,"ل",2,0],["وَحَفِظتُ فيكِ أَمانَةً حُمَّلتُها","وَعَصيتُ كُلَّ مُحَرِّشٍ وَمُعَرِّضٍ",24,"ض",1,0],["وَحَفَّت بِهِ الخَيلُ خَيّالَةً","فَطارَ بِهِ سُرعَةً طِرفُهُ",25,"ف",2,0],["وَحفَّ ذَويكَ البشرُ مِن كُلِ جانِبٍ","وَبَينَ أَسارير الوُجوه تَرَدَّدا",26,"د",2,0],["وَحَفظتها لَك في الطَريق مِن الأَذى","وَلِأَجل عَينكِ أَضلُعي مَثواها",27,"ا",3,0],["وحفَّ بهِ أهلُ الجِلادِ فمُقدِمٌ","وماضٍ وإصْلِيتٌ وطَلْقٌ وأروع",28,"ع",1,0],["وَحفِ الظَهارِ عَصِلِ الأُنبوبِ","آنَسَ بَينَ صَردَحٍ وَلوبِ",29,"ب",1,0],["وحَفَّها بالخيلِ والرّجالِ","وقاتَلوهُم أبلغَ القِتالِ",30,"ل",1,0],["وحَفّرَتْ فيه رُكْبانُ الرّدى فُقُراً","حَفْرَ ابنِ عادٍ لإيرادٍ هَرامِيتا",31,"ت",2,0],["وَحَفُّوا كَأَشْبَالِ لَيْثٍ بِهِ","وَهُمْ فِي دِعَابٍ وَهُمْ فِي دَدِ",32,"د",1,0],["وَحَفَلنْ حَوْلَ سَرِيرِهِ يَنْهَرْنَهُ","لَكِنْ أحَطْنَ بِصَخْرَةٍ صَمَّاءِ",33,"ا",2,0],["وَحَفَّهَا بِسِيَاجٍ مِنْ عِنَايَتِهِ","كَمَا تُحَفُّ جُفُونُ العَيْنِ بالهُدُبِ",34,"ب",1,0],["وحَفِظْنا من الرِّيَاحِ جَنَاهُ","وَوَقَيْناه شِرَّة الْحَشَراتِ",35,"ت",1,0],["وَحَفِظْنَا لَكَ الْوِدَادَ نَضِيراً","وَأَذَعْنَا لَكَ الثَّنَاءَ نَضِيدا",36,"د",2,0],["وحفظته في العين، إلا أنني","أشفقتُ من دمعي عليه إذا همي",37,"م",2,0],["وحفرنا أنْفَاقَهُ بالبنان ال","رَّخْص، أو بالأَظافر الناعمات",38,"ت",1,0],["وحَفَرْنا في باطن الأرض جُبًّا","ودفنَّا الأحقادَ والشَّنآنا",39,"ن",2,0],["وحفت الحور والعذراء مريم وال","غراء آسية في الدل والخفر",40,"ر",1,0],["وحفَتْ به عوجُ القسيِّ ضلوعَها","تغتالُ فيه جوانِحاً وقُلوبا",41,"ب",2,0],["وحف بي الغيد الحسان لخدمتي","فسري مكتوم وحسني باد",42,"د",1,0],["وحفوا كاشبال ليث به","وهم في دعاب وفي دد",43,"د",1,0],["وحَفْلاً ترى فيه اكُفّاً تعجَّلَت","ظِمائيَ تستسقي عليّ الغواديا",44,"ي",2,0],["وحفظت سري في هواك وصنته","والدمع باح ولم ابح بمقالي",45,"ل",2,0],["وحفت بنا نفحة المصطفى","وفيها حسبنا مع الأصفيا",46,"ي",2,0],["وحفه العسكر الغيبي بنور هدى","وجيش نصر وتوفيق وإيمان",47,"ن",1,0],["وحفنا بلطفه الخفي","وعمنا بجوده الوفي",48,"ي",1,0],["وحفظتني من كلِّ خطبٍ فادحٍ","تفضى إلىّ بطرمك اليقظانِ",49,"ن",1,0],["وحَفَتكِ مَن يَحُفُّكِ بالأمَاني","فقد كَانَت مُصَرِّمَة",50,"ه",1,0],["وَحَفَّتْ بِهِ طالِعاتُ النُّجومِ","عَلِيلٌ لَقىً بَينَ عُوَّادِهِ",51,"د",2,0],["وحفظ العهد من كرم السجايا","فما لك لا يدوم لديك عهد",52,"د",1,0],["وحفت به تحت العجاج كتائب","اسنَّت