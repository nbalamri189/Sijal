https://www.aldiwan.net/poem50170.html","الطويل"],[426,"لاق المدامة بالمسرة لاقي","https://www.aldiwan.net/poem40041.html","الكامل"],[436,"ألا هكذا فليسم للمجد من سما","https://www.aldiwan.net/poem34814.html","الطويل"],[436,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[451,"ولي منزل لقنته سر عزلتي","https://www.aldiwan.net/poem61264.html","الطويل"],[456,"غال بها فيما تسام واشترط","https://www.aldiwan.net/poem56144.html","الرجز"],[456,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[456,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[459,"لله در قبيلة","https://www.aldiwan.net/poem16136.html","مجزوء الكامل"],[461,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[462,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[462,"ما جماد يفيد مالاً وعدماً","https://www.aldiwan.net/poem3460.html","عموديه"],[468,"أكرع الكرعة الروية منها","https://www.aldiwan.net/poem4796.html","البسيط"],[475,"أطل الوقوف على رسوم الدار","https://www.aldiwan.net/poem15238.html","الطويل"],[498,"ما للقلوب عن الحبيب غطاء","https://www.aldiwan.net/poem38105.html","الكامل"],[513,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[513,"ثغر الهدى متبلج بسام","https://www.aldiwan.net/poem12245.html","الكامل"],[513,"أقول والصدق فيما قلت يعضدني","https://www.aldiwan.net/poem12281.html","البسيط"],[556,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[583,"خان المحالف والمعاهد","https://www.aldiwan.net/poem1569.html",""],[584,"ما كنت أندب رامة وطويلعا","https://www.aldiwan.net/poem17588.html","الكامل"],[584,"بان الخيال وإن أبان نزيلا","https://www.aldiwan.net/poem17663.html","الكامل"],[584,"إذا بعدوا وافوك أسرى وإن دنوا","https://www.aldiwan.net/poem17704.html","الطويل"]],"verses":[["وَحِفاظي كَما عَلِمتَ وَلَكِن","أَنكَرَ الغَدرَ وُدِّيَ المَعروفُ",0,"ف",1,0],["وَحَفِظتُ ما اِستَودَعتُ مِن نِعمائِكُم","إِنَّ الوَفاءَ أَمانَةٌ تُستَودَعُ",1,"ع",1,0],["وحَفّتْ بهِ مِنْ سِرِّ جوثَةَ غِلْمَةٌ","مَناعيشُ للمَوْلى رِقاقُ المآزرِ",2,"ر",1,0],["وحفَّ بِنا جُنْحُ الظّلامِ كأنّما","أحاديثُ سرٍّ ضمّها قلْبُ جاحِدِ",3,"د",1,0],["وحَفَّ بيَ الغيدُ الحِسانُ لخِدْمَتي","فسِرّيَ مكْتومٌ وحُسْنيَ بادي",4,"ي",1,0],["وحَفّتْ بِهِ الأعْداءُ منْ كلِّ جانِبٍ","كما حَفّ بالخَصْرِ الهَضيمِ وِشاحُهُ",5,"ح",2,0],["وَحَفِظتُ أَوراقي بِمَح","فَظَتي فَلا تَتَوَزَّعُ",6,"ع",1,0],["وَحَفْنِيُّ كَانَ الشَّاعِرُ المُبْدِعُ الَّذِي","قَصَائِدُهُ دُرُّ نُظِمْنَ وَعِقْيَانُ",7,"ن",1,0],["وَحِفْنِيُّ كَانَ العَالِمَ العَامِلَ الَّذِي","لَهُ القَوْلُ طَوْعٌ وَالبَلاغَةُ مِذْعَانُ",7,"ن",1,0],["وَ حِفْنِيُّ كَانَ الجِهْبِذَ اللَّبِقَ الَّذِي","بِهِ عَادَ لِلفُصْحَى عَلَى اللَّغْوِ سُلْطَانُ",7,"ن",1,0],["وَ حِفْنِيُّ فِي نَادِيهِ ذُو الكَلِمِ الَّتِي","بِأَبْدَعَ مِنْهَا لا تُشَنَّفُ آذَانُ",7,"ن",1,0],["وَ حِفْنِيُّ قَاضٍ رَاقَبَ اللهَ عَالِماً","بِأَنَّ الَّذِي إِذَا اقْتَصَّ رَحْمَنُ",7,"ن",1,0],["وَحَفٌ كَأَنَّ النَدى وَالشَمسُ ماتِعَةٌ","إِذا تَوَقَّدَ في أَفنانِهِ التومُ",8,"م",1,0],["وحَفَّته في أفقِ السماءِ سُعودُهُ","وفي الأرض خِيريَّاته ونَراجسه",9,"س",2,0],["وَحَفيفُ النَسيمِ في مَسمَعِ","الأَوراقِ نَجوى تَبُثُّها شَفَتاها",10,"ا",3,0],["وَحفٍ أَثيثٍ عَلى المَتنَينِ مُنسَدِلٍ","مُستَفرَغٍ بِدِهانِ الوَردِ مَجّاجِ",11,"ج",1,0],["وحفيفِ الغصونِ نمَّقها الطَّلُّ","وهَمْسِ النَّسيمِ للأولادِ",12,"د",1,0],["وحَفيفَ أجنحةٍ ترفرف في الفضا","وصدًى يَرنُّ على سُكونِ الغاب",13,"ب",1,0],["وَحِفظُكَ فيهِمِ سَلَفي مَعَدٍّ","وَأَنَّهُمُ العَشائِرُ وَالصِحابُ",14,"ب",1,0],["وَحَفيفُ أَجنِحَةِ المَلائِكِ حَولُهُ","وَعُيونُ أَهلِ اللاذِقِيَّةِ صورُ",15,"ر",1,0],["وَحُفرَةُ بَيتٍ أَنتَ فيها مُوَسَّدٌ","وَقَد سُدَّ مِن دونِ العَوائِدِ بابُها",16,"ب",3,0],["وحفوا الشوارب عن نخرة","تضرم إن يطفئوا نارها",17,"ر",3,0],["وَحِفظي لِلأَمانَةِ وَاِصطِباري","عَلى ما كانَ مِن رَيبِ الزَمانِ",18,"ن",1,0],["وَحِفاظَ جارِكَ لا تُضِعهُ فَإِنَهُ","لا يَبلُغُ الشَرَفُ الجَسيمُ مُضيِّعُ",19,"ع",1,0],["وَحُفِفتِ يا دُنيا بِكُلِّ بَلِيَّةٍ","وَمُزِجتِ يا دُنيا بِكُلِّ وَبالِ",20,"ل",1,0],["وَحَفَظتُ عَهدَكَ مِثلَ حِفظي صِحَّتي","وَشَهِدتَ في ذاكَ المَقامِ مَقالي",21,"ي",1,0],["وحفير من الصبابةِ فيه","في حجاب التقى سريرة كمِّ",22,"م",1,0],["وَحَفَّت بي العَشائِرُ وَالأَقاصي","عِيالاً لي وَكُنتُ لَهُم عِيالا",23,"ل",2,0],["وَحَفِظتُ فيكِ أَمانَةً حُمَّلتُها","وَعَصيتُ كُلَّ مُحَرِّشٍ وَمُعَرِّضٍ",24,"ض",1,0],["وَحَفَّت بِهِ الخَيلُ خَيّالَةً","فَطارَ بِهِ سُرعَةً طِرفُهُ",25,"ف",2,0],["وَحفَّ ذَويكَ البشرُ مِن كُلِ جانِبٍ","وَبَينَ أَسارير الوُجوه تَرَدَّدا",26,"د",2,0],["وَحَفظتها لَك في الطَريق مِن الأَذى","وَلِأَجل عَينكِ أَضلُعي مَثواها",27,"ا",3,0],["وحفَّ بهِ أهلُ الجِلادِ فمُقدِمٌ","وماضٍ وإصْلِيتٌ وطَلْقٌ وأروع",28,"ع",1,0],["وَحفِ الظَهارِ عَصِلِ الأُنبوبِ","آنَسَ بَينَ صَردَحٍ وَلوبِ",29,"ب",1,0],["وحَفَّها بالخيلِ والرّجالِ","وقاتَلوهُم أبلغَ القِتالِ",30,"ل",1,0],["وحَفّرَتْ فيه رُكْبانُ الرّدى فُقُراً","حَفْرَ ابنِ عادٍ لإيرادٍ هَرامِيتا",31,"ت",2,0],["وَحَفُّوا كَأَشْبَالِ لَيْثٍ بِهِ","وَهُمْ فِي دِعَابٍ وَهُمْ فِي دَدِ",32,"د",1,0],["وَحَفَلنْ حَوْلَ سَرِيرِهِ يَنْهَرْنَهُ","لَكِنْ أحَطْنَ بِصَخْرَةٍ صَمَّاءِ",33,"ا",2,0],["وَحَفَّهَا بِسِيَاجٍ مِنْ عِنَايَتِهِ","كَمَا تُحَفُّ جُفُونُ العَيْنِ بالهُدُبِ",34,"ب",1,0],["وحَفِظْنا من الرِّيَاحِ جَنَاهُ","وَوَقَيْناه شِرَّة الْحَشَراتِ",35,"ت",1,0],["وَحَفِظْنَا لَكَ الْوِدَادَ نَضِيراً","وَأَذَعْنَا لَكَ الثَّنَاءَ نَضِيدا",36,"د",2,0],["وحفظته في العين، إلا أنني","أشفقتُ من دمعي عليه إذا همي",37,"م",2,0],["وحفرنا أنْفَاقَهُ بالبنان ال","رَّخْص، أو بالأَظافر الناعمات",38,"ت",1,0],["وحَفَرْنا في باطن الأرض جُبًّا","ودفنَّا الأحقادَ والشَّنآنا",39,"ن",2,0],["وحفَتْ به عوجُ القسيِّ ضلوعَها","تغتالُ فيه جوانِحاً وقُلوبا",40,"ب",2,0],["وحف بي الغيد الحسان لخدمتي","فسري مكتوم وحسني باد",41,"د",1,0],["وحفوا كاشبال ليث به","وهم في دعاب وفي دد",42,"د",1,0],["وحَفْلاً ترى فيه اكُفّاً تعجَّلَت","ظِمائيَ تستسقي عليّ الغواديا",43,"ي",2,0],["وحفظت سري في هواك وصنته","والدمع باح ولم ابح بمقالي",44,"ل",2,0],["وحفت بنا نفحة المصطفى","وفيها حسبنا 