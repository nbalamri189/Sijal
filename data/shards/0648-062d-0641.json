{"poems":[[55,"كل شيء من الزمان طريف","https://www.aldiwan.net/poem29965.html","الخفيف"],[55,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[65,"أبت إبلي والليل وحف الغدائر","https://www.aldiwan.net/poem46167.html","الطويل"],[79,"نعمنا بوصل من حبيب مساعد","https://www.aldiwan.net/poem36532.html","الطويل"],[79,"إذا نمت نم للأمن فوق مهاد","https://www.aldiwan.net/poem36546.html","الطويل"],[79,"هو النصر باد للعيون صباحه","https://www.aldiwan.net/poem36646.html","الطويل"],[88,"أخشى مربيتي","https://www.aldiwan.net/poem10701.html","مجزوء الكامل"],[95,"لذكراك يا حفني في النفس أشجان","https://www.aldiwan.net/poem11210.html","الطويل"],[32,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[53,"ليهنك لبس المهرجان وإن غدا","https://www.aldiwan.net/poem64568.html","الطويل"],[93,"اسألوها أو فاسألوا مضناها","https://www.aldiwan.net/poem62803.html","عموديه"],[40,"ألا اسلمي اليوم ذات الطوق والعاج","https://www.aldiwan.net/poem7694.html","البسيط"],[94,"ليت لي أن أعيش في هذه الدنيا","https://www.aldiwan.net/poem38950.html","الخفيف"],[94,"في الليل ناديت الكواكب ساخطا","https://www.aldiwan.net/poem38967.html","الكامل"],[45,"بغيرك راعيا عبث الذئاب","https://www.aldiwan.net/poem9459.html","الوافر"],[45,"إني لأعلم واللبيب خبير","https://www.aldiwan.net/poem9573.html","الكامل"],[30,"سقى الله قبراً يا سعيد تضمنت","https://www.aldiwan.net/poem1294.html",""],[63,"رأيت خيار بني مسهر","https://www.aldiwan.net/poem51359.html","المتقارب"],[2,"غدت عذالتاي فقلت مهلاً","https://www.aldiwan.net/poem25004.html","الوافر"],[60,"قدم لنفسك في الحياة تزودا","https://www.aldiwan.net/poem30966.html","الكامل"],[51,"حيل البلى تأتي على المحتال","https://www.aldiwan.net/poem63053.html","الكامل"],[68,"لم تبغ همتك المحل العالي","https://www.aldiwan.net/poem38695.html","الكامل"],[82,"أي خطب عن قوسه الموت يرمي","https://www.aldiwan.net/poem31283.html","الخفيف"],[46,"شهدت لقد لبست أبا سعيد","https://www.aldiwan.net/poem29712.html","الوافر"],[33,"يا سكن قد والله رب محمد","https://www.aldiwan.net/poem42470.html","الكامل"],[76,"أيجني على مهجتي طرفه","https://www.aldiwan.net/poem13177.html","المتقارب"],[104,"أغمدان ما يبكيك يا كعبة الهدى","https://www.aldiwan.net/poem33035.html","الطويل"],[104,"يا زهرة الوادي أتيت بزهرة","https://www.aldiwan.net/poem33104.html","الكامل"],[77,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[50,"يا رب غيث آمن السروب","https://www.aldiwan.net/poem62457.html","الرجز"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16636","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54532","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[108,"خيال في يقظة","https://www.poetsgate.com/ViewPoem.aspx?id=179676",""],[108,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[108,"الوحدة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=179293",""],[111,"غوث الوجود اغثني ضاق مصطبري","https://www.poetsgate.com/ViewPoem.aspx?id=517",""],[79,"بُشرى يقومُ لها الزّمانُ خطيبا","https://www.poetsgate.com/ViewPoem.aspx?id=33311",""],[79,"إذا نمت نم للأمن فوق مهاد","https://www.poetsgate.com/ViewPoem.aspx?id=33934",""],[95,"فتاة الجبل","https://www.poetsgate.com/ViewPoem.aspx?id=12714",""],[92,"المآسي في حياة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179158",""],[119,"تعذيب قلبي في هواك حلالي","https://www.aldiwan.net/poem40601.html","عموديه"],[119,"لخرقة خير الوجود الذي","https://www.aldiwan.net/poem42003.html","المتقارب"],[119,"لكل أمر تسول بابن عدنان","https://www.aldiwan.net/poem42169.html","البسيط"],[119,"الحمد لله الذي قد أنعما","https://www.aldiwan.net/poem42187.html","الرجز"],[132,"ما حاجتي في ذم أهل زماني","https://www.aldiwan.net/poem50497.html","الكامل"],[136,"أعائش إن للدنيا صروفا","https://www.aldiwan.net/poem54798.html","الوافر"],[159,"كأن الهلال وقد أسرعت","https://www.aldiwan.net/poem55725.html","المتقارب"],[164,"نصيبي منك يوم البعد بعد","https://www.aldiwan.net/poem58667.html","البسيط"],[164,"سهام مقاها فاحذروها صوائب","https://www.aldiwan.net/poem59016.html","البسيط"],[214,"طوالع السعد قد وافتك بالبشر","https://www.aldiwan.net/poem13530.html","البسيط"],[225,"سئمت نفسي الحياة وملت","https://www.aldiwan.net/poem55253.html","الخفيف"],[227,"عند ذا هب جالسا وتهيا","https://www.aldiwan.net/poem41607.html","الخفيف"],[235,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[255,"درة العشاق","https://www.aldiwan.net/poem65127.html","عموديه"],[263,"غب دعاء عاطر","https://www.aldiwan.net/poem35755.html","مجزوء الرجز"],[265,"ألم بنا يختال غير ملوم","https://www.aldiwan.net/poem38190.html","الطويل"],[274,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[274,"أحن إلى طيب الغدائر والفم","https://www.aldiwan.net/poem35634.html","الطويل"],[275,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[279,"أوائل فتح ما لهن أواخر","https://www.aldiwan.net/poem25552.html","الطويل"],[279,"إلى وعدها أصبو وهل ينجز الوعد","https://www.aldiwan.net/poem25588.html","الطويل"],[308,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[309,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[309,"برق به أفق الرجاء أنارا","https://www.aldiwan.net/poem56540.html","الكامل"],[353,"يا من كلفت بحبه إذ كان عن","https://www.aldiwan.net/poem15779.html","الكامل"],[370,"وصل كتاب مولا ي بعدما","https://www.aldiwan.net/poem17899.html","الطويل"],[375,"عاد بأسي علي وقدم","https://www.aldiwan.net/poem57318.html","الخفيف"],[395,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[407,"ولما عراني الضعف من كل جانب","https://www.aldiwan.net/poem33893.html","الطويل"],[409,"توكل على الله في كل","https://www.aldiwan.net/poem49814.html","المتقارب"],[410,"أتلك حدوج أم نجوم سوائر","https://www.aldiwan.net/poem50170.html","الطويل"],[433,"لاق المدامة بالمسرة لاقي","https://www.aldiwan.net/poem40041.html","الكامل"],[443,"ألا هكذا فليسم للمجد من سما","https://www.aldiwan.net/poem34814.html","الطويل"],[443,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[456,"ولي منزل لقنته سر عزلتي","https://www.aldiwan.net/poem61264.html","الطويل"],[461,"غال بها فيما تسام واشترط","https://www.aldiwan.net/poem56144.html","الرجز"],[461,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[461,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[464,"لله در قبيلة","https://www.aldiwan.net/poem16136.html","مجزوء الكامل"],[466,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[467,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[467,"ما جماد يفيد مالاً وعدماً","https://www.aldiwan.net/poem3460.html","عموديه"],[473,"أكرع الكرعة الروية منها","https://www.aldiwan.net/poem4796.html","البسيط"],[480,"أطل الوقوف على رسوم الدار","https://www.aldiwan.net/poem15238.html","الطويل"],[503,"ما للقلوب عن الحبيب غطاء","https://www.aldiwan.net/poem38105.html","الكامل"],[518,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[518,"ثغر الهدى متبلج بسام","https://www.aldiwan.net/poem12245.html","الكامل"],[518,"أقول والصدق فيما قلت يعضدني","https://www.aldiwan.net/poem12281.html","البسيط"],[561,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[588,"خان المحالف والمعاهد","https://www.aldiwan.net/poem1569.html",""],[589,"ما كنت أندب رامة وطويلعا","https://www.aldiwan.net/poem17588.html","الكامل"],[589,"بان الخيال وإن أبان نزيلا","https://www.aldiwan.net/poem17663.html","الكامل"],[589,"إذا بعدوا وافوك أسرى وإن دنوا","https://www.aldiwan.net/poem17704.html","الطويل"],[628,"","https://poetry.dctabudhabi.ae/diwan/poem/21184","الطويل"]],"verses":[["وَحِفاظي كَما عَلِمتَ وَلَكِن","أَنكَرَ الغَدرَ وُدِّيَ المَعروفُ",0,"ف",1,0],["وَحَفِظتُ ما اِستَودَعتُ مِن نِعمائِكُم","إِنَّ الوَفاءَ أَمانَةٌ تُستَودَعُ",1,"ع",1,0],["وحَفّتْ بهِ مِنْ سِرِّ جوثَةَ غِلْمَةٌ","مَناعيشُ للمَوْلى رِقاقُ المآزرِ",2,"ر",1,0],["وحفَّ بِنا جُنْحُ الظّلامِ كأنّما","أحاديثُ سرٍّ ضمّها قلْبُ جاحِدِ",3,"د",1,0],["وحَفَّ بيَ الغيدُ الحِسانُ لخِدْمَتي","فسِرّيَ مكْتومٌ وحُسْنيَ بادي",4,"د",2,0],["وحَفّتْ بِهِ الأعْداءُ منْ كلِّ جانِبٍ","كما حَفّ بالخَصْرِ الهَضيمِ وِشاحُهُ",5,"ح",2,0],["وَحَفِظتُ أَوراقي بِمَح","فَظَتي فَلا تَتَوَزَّعُ",6,"ع",1,0],["وَحَفْنِيُّ كَانَ الشَّاعِرُ المُبْدِعُ الَّذِي","قَصَائِدُهُ دُرُّ نُظِمْنَ وَعِقْيَانُ",7,"ن",1,0],["وَحِفْنِيُّ كَانَ العَالِمَ العَامِلَ الَّذِي","لَهُ القَوْلُ طَوْعٌ وَالبَلاغَةُ مِذْعَانُ",7,"ن",1,0],["وَ حِفْنِيُّ كَانَ الجِهْبِذَ اللَّبِقَ الَّذِي","بِهِ عَادَ لِلفُصْحَى عَلَى اللَّغْوِ سُلْطَانُ",7,"ن",1,0],["وَ حِفْنِيُّ فِي نَادِيهِ ذُو الكَلِمِ الَّتِي","بِأَبْدَعَ مِنْهَا لا تُشَنَّفُ آذَانُ",7,"ن",1,0],["وَ حِفْنِيُّ قَاضٍ رَاقَبَ اللهَ عَالِماً","بِأَنَّ الَّذِي إِذَا اقْتَصَّ رَحْمَنُ",7,"ن",1,0],["وَحَفٌ كَأَنَّ النَدى وَالشَمسُ ماتِعَةٌ","إِذا تَوَقَّدَ في أَفنانِهِ التومُ",8,"م",1,0],["وحَفَّته في أفقِ السماءِ سُعودُهُ","وفي الأرض خِيريَّاته ونَراجسه",9,"س",2,0],["وَحَفيفُ النَسيمِ في مَسمَعِ","الأَوراقِ نَجوى تَبُثُّها شَفَتاها",10,"ا",3,0],["وَحفٍ أَثيثٍ عَلى المَتنَينِ مُنسَدِلٍ","مُستَفرَغٍ بِدِهانِ الوَردِ مَجّاجِ",11,"ج",1,0],["وحفيفِ الغصونِ نمَّقها الطَّلُّ","وهَمْسِ النَّسيمِ للأولادِ",12,"د",1,0],["وحَفيفَ أجنحةٍ ترفرف في الفضا","وصدًى يَرنُّ على سُكونِ الغاب",13,"ب",1,0],["وَحِفظُكَ فيهِمِ سَلَفي مَعَدٍّ","وَأَنَّهُمُ العَشائِرُ وَالصِحابُ",14,"ب",1,0],["وَحَفيفُ أَجنِحَةِ المَلائِكِ حَولُهُ","وَعُيونُ أَهلِ اللاذِقِيَّةِ صورُ",15,"ر",1,0],["وَحُفرَةُ بَيتٍ أَنتَ فيها مُوَسَّدٌ","وَقَد سُدَّ مِن دونِ العَوائِدِ بابُها",16,"ب",3,0],["وحفوا الشوارب عن نخرة","تضرم إن يطفئوا نارها",17,"ر",3,0],["وَحِفظي لِلأَمانَةِ وَاِصطِباري","عَلى ما كانَ مِن رَيبِ الزَمانِ",18,"ن",1,0],["وَحِفاظَ جارِكَ لا تُضِعهُ فَإِنَهُ","لا يَبلُغُ الشَرَفُ الجَسيمُ مُضيِّعُ",19,"ع",1,0],["وَحُفِفتِ يا دُنيا بِكُلِّ بَلِيَّةٍ","وَمُزِجتِ يا دُنيا بِكُلِّ وَبالِ",20,"ل",1,0],["وَحَفَظتُ عَهدَكَ مِثلَ حِفظي صِحَّتي","وَشَهِدتَ في ذاكَ المَقامِ مَقالي",21,"ل",2,0],["وحفير من الصبابةِ فيه","في حجاب التقى سريرة كمِّ",22,"م",1,0],["وَحَفَّت بي العَشائِرُ وَالأَقاصي","عِيالاً لي وَكُنتُ لَهُم عِيالا",23,"ل",2,0],["وَحَفِظتُ فيكِ أَمانَةً حُمَّلتُها","وَعَصيتُ كُلَّ مُحَرِّشٍ وَمُعَرِّضٍ",24,"ض",1,0],["وَحَفَّت بِهِ الخَيلُ خَيّالَةً","فَطارَ بِهِ سُرعَةً طِرفُهُ",25,"ف",2,0],["وَحفَّ ذَويكَ البشرُ مِن كُلِ جانِبٍ","وَبَينَ أَسارير الوُجوه تَرَدَّدا",26,"د",2,0],["وَحَفظتها لَك في الطَريق مِن الأَذى","وَلِأَجل عَينكِ أَضلُعي مَثواها",27,"ا",3,0],["وحفَّ بهِ أهلُ الجِلادِ فمُقدِمٌ","وماضٍ وإصْلِيتٌ وطَلْقٌ وأروع",28,"ع",1,0],["وَحفِ الظَهارِ عَصِلِ الأُنبوبِ","آنَسَ بَينَ صَردَحٍ وَلوبِ",29,"ب",1,0],["وحَفَّها بالخيلِ والرّجالِ","وقاتَلوهُم أبلغَ القِتالِ",30,"ل",1,0],["وحَفّرَتْ فيه رُكْبانُ الرّدى فُقُراً","حَفْرَ ابنِ عادٍ لإيرادٍ هَرامِيتا",31,"ت",2,0],["وَحَفُّوا كَأَشْبَالِ لَيْثٍ بِهِ","وَهُمْ فِي دِعَابٍ وَهُمْ فِي دَدِ",32,"د",1,0],["وَحَفَلنْ حَوْلَ سَرِيرِهِ يَنْهَرْنَهُ","لَكِنْ أحَطْنَ بِصَخْرَةٍ صَمَّاءِ",33,"ا",2,0],["وَحَفَّهَا بِسِيَاجٍ مِنْ عِنَايَتِهِ","كَمَا تُحَفُّ جُفُونُ العَيْنِ بالهُدُبِ",34,"ب",1,0],["وحَفِظْنا من الرِّيَاحِ جَنَاهُ","وَوَقَيْناه شِرَّة الْحَشَراتِ",35,"ت",1,0],["وَحَفِظْنَا لَكَ الْوِدَادَ نَضِيراً","وَأَذَعْنَا لَكَ الثَّنَاءَ نَضِيدا",36,"د",2,0],["وحفظته في العين، إلا أنني","أشفقتُ من دمعي عليه إذا همي",37,"م",2,0],["وحفرنا أنْفَاقَهُ بالبنان ال","رَّخْص، أو بالأَظافر الناعمات",38,"ت",1,0],["وحَفَرْنا في باطن الأرض جُبًّا","ودفنَّا الأحقادَ والشَّنآنا",39,"ن",2,0],["وحفت الحور والعذراء مريم وال","غراء آسية في الدل والخفر",40,"ر",1,0],["وحفَتْ به عوجُ القسيِّ ضلوعَها","تغتالُ فيه جوانِحاً وقُلوبا",41,"ب",2,0],["وحف بي الغيد الحسان لخدمتي","فسري مكتوم وحسني باد",42,"د",1,0],["وحفوا كاشبال ليث به","وهم في دعاب وفي دد",43,"د",1,0],["وحَفْلاً ترى فيه اكُفّاً تعجَّلَت","ظِمائيَ تستسقي عليّ الغواديا",44,"ي",2,0],["وحفظت سري في هواك وصنته","والدمع باح ولم ابح بمقالي",45,"ل",2,0],["وحفت بنا نفحة المصطفى","وفيها حسبنا مع الأصفيا",46,"ي",2,0],["وحفه العسكر الغيبي بنور هدى","وجيش نصر وتوفيق وإيمان",47,"ن",1,0],["وحفنا بلطفه الخفي","وعمنا بجوده الوفي",48,"ي",1,0],["وحفظتني من كلِّ خطبٍ فادحٍ","تفضى إلىّ بطرمك اليقظانِ",49,"ن",1,0],["وحَفَتكِ مَن يَحُفُّكِ بالأمَاني","فقد كَانَت مُصَرِّمَة",50,"ه",1,0],["وَحَفَّتْ بِهِ طالِعاتُ النُّجومِ","عَلِيلٌ لَقىً بَينَ عُوَّادِهِ",51,"د",2,0],["وحفظ العهد من كرم السجايا","فما لك لا يدوم لديك عهد",52,"د",1,0],["وحفت به تحت العجاج كتائب","اسنَّتها فيه نجوم ثواقب",53,"ب",1,0],["وحفك الله بالنصر العزيز وبال","فتح المبين وبالآيات والسور",54,"ر",1,0],["وحفاة من الورى وجياع","ليس في الناس من يرق ويرحم",55,"م",1,0],["وَحَفيفُ الصَفصافِ يَهمِس في النَه","رِ كَلاماً عَن الحَياةِ خَفِيّا",56,"ي",2,0],["وَحِفاظُهُ مِن خلَّةٍ وَتَناقُضٍ","وَمِنَ الزِّيادَةِ فيهِ وَالنُقصانِ",57,"ن",1,0],["وحفيف أشجار الوجود نشيدة","تشدو مع الأطيار في الآفاق",58,"ق",1,0],["وحفظ ربٍّ قادر","من مكر كلّ ماكر",59,"ر",1,0],["وحفت سهامها من بنيات نعشه","كواكب كالعواد حول سقيم",60,"م",1,0],["وحفَّت به جنداً تغطي وُجُوهَها","بأجنحةٍ وَرديّةٍ زَنبقيّة",61,"ه",1,0],["وحفّاتُ أغصان وحنّاتُ نازح","وخرَّاتُ يُنبوعٍ وأناتُ مُسقَم",62,"م",1,0],["وَحفت به الاملاك منهم مبشر","بِما نال من فضل ومنهم مرحب",63,"ب",1,0],["وحَفَّ بِهِ للسَّعْدِ جُنْدٌ مُجَنَّدٌ","فَذَلَّتْ أعاريبٌ لَهُ وبَرابِرُ",64,"ر",1,0],["وحُفَّ بِأَعْنَابٍ ونَخْلٍ نَواعِمٍ","تَكاد فُروعاً بالنواسِم تَنْقَدُّ",65,"د",1,0],["وحفظ قوانين المعاش وما به ال","قوام وضب الكل تحت السياسة",66,"ه",1,0],["وَحفّت أَراعيلُ المَذاكي بِسَيلهم","بِقادِمَتَي نَصرٍ يُظلّانه مطّا",67,"ط",2,0],["وَحفظتَ فيّ ذمامَ سالفِ صحبة","لا تستجيزُ لِعهدها إِخفارا",68,"ر",2,0],["وَحَفِظتُهُ جُهدي وَلَكِن رَأيُهُ ال","بادجي أَبى أَلّا يَكونَ مُضَيَّعا",69,"ع",2,0],["وَحَفِظتَهُ","كَما يَحفَظُ الحُرُّ الحَديثَ المُكَتَّما",70,"م",2,0],["وحِفاظي لصدقِ ودِّك أمسَى","لكَ حِصناً مِن الهِجاءِ مَنيعا",71,"ع",2,0],["وحفظ من جميع","المخاوف والمصيبات",72,"ت",1,0],["وحُفَّ به الألطاف من كل جانب","ولا يلتقي عسراً ببحر ولا بر",73,"ر",1,0],["وحفَّ الملوكُ بهِ خاضِعين","وزُفُّوا إليه رعيلاً رعيلا",74,"ل",2,0],["وَحَفَّت بِهِ الأَرجاء مِن كُلِّ جانِبٍ","كَما حَفَّ أَرجاء العيونِ المَحاجِرُ",75,"ر",1,0],["وحفظت قلباً كنت قد أعددته","للنائبات فضاع يوم فراقِ",76,"ق",1,0],["وحَفَّتْ بِهِ للحاجِبِ القائِدِ الَّذِي","أَبى الدهرُ إِلّا مَا أَمَرَّ وأَحْكَما",77,"م",2,0],["وحفظُ مَنْ لَمْ يَزَلْ بالعدلِ يحفظنا","ورَعْيُ من لَمْ يزل بالبرِّ يَرعانا",78,"ن",2,0],["وحفت به الأشجار ملء حنوها","تخبئه مهما أطل جهارا",79,"ر",2,0],["وَحْفٌ إذا ما غرّبت فيه يداً","فارقةٍ أدردَ أسنانَ المُشُطْ",80,"ط",1,0],["وحفظُها عهدَ ملولٍ ماطلٍ","يذكر ما استرعَى وينسَى ما عَهِدْ",81,"د",1,0],["وحفِظتَ فيّ تكرُّماً وتفضُّلاً","ما أذكَرتْكَ قدائمي وتلائدي",82,"د",2,0],["وحَفِظْتَ نَفْس مَناقِبٍ","لم يبْقَ غيرُ ذَمائها",83,"ا",3,0],["وحفظاً لدين الله بالعدل والتقى","وجهدا لاستيصال من كان كافرا",84,"ر",2,0],["وحفاهُ في رأسهِ فإذا حي","ف كسوه يقطعة منهُ نعلا",85,"ل",2,0],["وحفاه في رأسه فإذا حي","ف كسوه بقطعهِ منهُ نعلا",86,"ل",2,0],["وَحِفظَ ما استَودَعَت عِندي وَقَد زَعَمَت","أَن لَيسَ يُحسِنُ حِفظَ السِرِّ أَمثالي",87,"ل",2,0],["وحَفِظتْ بعدَهمُ العهودَ وهذه","شِيَمٌ يُدَلُّ بها على الأحرارِ",88,"ر",1,0],["وحَفِظْتَ أخْباراً بسرِّكَ كلُّها","منها صُفوفٌ ضِمنَهُ وبِناءُ",89,"ا",2,0],["وحفظت منصبه الكريم ولم يكن","أحد سواك لنيلها بمؤهل",90,"ل",1,0],["وحفظت سر وديعة علمت بها","أيديكما والواحد العلام",91,"م",1,0],["وحفظك العهد بعد الموت ثالثة","ألزمت قلبك فيه صبحة الحزن",92,"ن",1,0],["وحفَّتنا مسراتٌ","وشاهدنا بُدورَ التَّمّْ",93,"م",1,0],["وحفِظت عَقد مودّتي","فنشرت أَلوية المحامد",94,"د",1,0],["وَحَفِظْتُ عَهْدَكُمُ وَضَيَّعْتُمْ فَلَا","أَدْعو لأَجْلِكُم عَلى مَنْ ضَيَّعا",95,"ع",2,0],["وَحَفِظْتُ نِسْبَتَهُ إِلَيْكَ مَحبّةً","مِنْ ظَنِّهِ أَنِّي أَرَاكَ بَدِيلا",96,"ل",2,0],["وَحَفَّ بِكَ الجَيْشُ الَّذي بِكَ نَصْرُهُ","وَمِنْكَ لَهُ إِقْدامُهُ وَالعَزائِمُ",97,"م",1,0],["وَحَفَّت بِقايا زادِهِم وَتَواكَلوا","وَأَكسَبَ مالَ القَومِ مَجهولَةٌ قَفرُ",98,"ر",1,0]]}