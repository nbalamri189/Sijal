{"poems":[[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[173,"دعوه فخير الرأي أن لا يعنفا","https://www.aldiwan.net/poem1639.html",""],[369,"لو شاء طيفك بعد الله أحياني","https://www.aldiwan.net/poem60625.html","البسيط"],[369,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34402","الوافر"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20400","البسيط"],[2305,"","https://poetry.dctabudhabi.ae/diwan/poem/143517","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119615","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72458","الكامل"],[6093,"الثُّؤْلولُ","https://www.poetsgate.com/ViewPoem.aspx?id=205900",""]],"verses":[["فُكَّ عنها السحرُ فارتدتْ إلى","عالم الحسِّ وخفّتْ قدماها",0,"ا",3,0],["فَكَعبٌ جَوادٌ وَالزبيديُّ فارِسٌ","وَقَيسٌ حَليمٌ وَالسَمَوأَلُ ذُو وَفا",1,"ف",2,0],["فكعبةُ النُّسْكِ في أرضِ الحجازِ لنا","وكعبةُ الجودِ قد خُطّتْ بقاشان",2,"ن",1,0],["فكَعبةَ الآمالِ زُر","فهْو مَطافُ كلِّ حُر",3,"ر",1,0],["فَكَعبُ الجود لا يُرضى فِداءً","لِنَعلِكَ وَهوَ رأس في السَخاءِ",4,"ا",2,0],["فَكَعكَعوهُنَّ في ضيقٍ وَفي دَهش","يَنزونَ مِن بَينِ مَأَبوضٍ وَمَهجورِ",5,"ر",1,0],["فكعب دون كعبيه","ومن غلمانه حاتم",6,"م",1,0],["فكعبةَ الوفد غدت دارُه","حيث بنى للحمد أركانا",7,"ن",2,0],["فكعجلهم بخواره ملأ الخلا","وكتيههم بضلاله قد تاها",8,"ا",3,0],["فكعبةُ البيتِ كلُّ الناسِ تقصدُها","واللهُ أعطاكَ فاسْعَدْ أيُّها الحَجَرُ",9,"ر",1,0]]}