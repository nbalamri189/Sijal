{"poems":[[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[167,"دعوه فخير الرأي أن لا يعنفا","https://www.aldiwan.net/poem1639.html",""],[362,"لو شاء طيفك بعد الله أحياني","https://www.aldiwan.net/poem60625.html","البسيط"],[362,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"]],"verses":[["فُكَّ عنها السحرُ فارتدتْ إلى","عالم الحسِّ وخفّتْ قدماها",0,"ا",3,0],["فَكَعبٌ جَوادٌ وَالزبيديُّ فارِسٌ","وَقَيسٌ حَليمٌ وَالسَمَوأَلُ ذُو وَفا",1,"ف",2,0],["فكعبةُ النُّسْكِ في أرضِ الحجازِ لنا","وكعبةُ الجودِ قد خُطّتْ بقاشان",2,"ن",1,0],["فكَعبةَ الآمالِ زُر","فهْو مَطافُ كلِّ حُر",3,"ر",1,0]]}