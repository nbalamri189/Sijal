{"poems":[[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[77,"قالوا وقد عظمت مبرة خالد","https://www.aldiwan.net/poem36525.html","الكامل"],[24,"أعلم أني متى ما يأتني قدري","https://www.aldiwan.net/poem21872.html","البسيط"],[86,"يا ليلة ألهمتني ما أتيه به","https://www.aldiwan.net/poem68834.html","البسيط"],[86,"طال الحديث عليكم أيها السمر","https://www.aldiwan.net/poem68851.html","البسيط"],[93,"في زحلة مولدي بالروح لا البدن","https://www.aldiwan.net/poem11273.html","البسيط"],[72,"ما بت فيك بدمع عيني أشرق","https://www.aldiwan.net/poem19350.html","الكامل"],[72,"يا طالب الجود لا تتعب أمانيكا","https://www.aldiwan.net/poem19443.html","البسيط"],[51,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[51,"قالوا هجاك أبو حفص فقلت لهم أعاش","https://www.aldiwan.net/poem61924.html","البسيط"],[51,"إن يفلت السيف من كفيك منصلتا","https://www.aldiwan.net/poem66427.html","البسيط"],[91,"يا لوعة حار النطاسي فيك","https://www.aldiwan.net/poem9051.html","عموديه"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[89,"رمت للقوم نهضة في الحياة","https://www.aldiwan.net/poem44919.html","الخفيف"],[85,"مال أحبابه خليلا خليلا","https://www.aldiwan.net/poem62832.html","الخفيف"],[85,"أعقاب في عنان الجو لاح","https://www.aldiwan.net/poem62979.html","الرمل"],[43,"بدر فتى لو كان من سؤآله","https://www.aldiwan.net/poem10128.html","الكامل"],[62,"نظري إلى لمع الوميض حنين","https://www.aldiwan.net/poem52265.html","الكامل"],[61,"أسمعتما أن الجبال تضام","https://www.aldiwan.net/poem51425.html","الكامل"],[31,"ناد الذين تحملوا كي يربعوا","https://www.aldiwan.net/poem42243.html","الكامل"],[105,"دعوا الشهيد لشعب ليس ينساه","https://www.aldiwan.net/poem42130.html","البسيط"],[105,"يا غاديا ببريد الشام ينتحب","https://www.aldiwan.net/poem43094.html","الكامل"],[105,"يا بعثة الأمل المخضر جانبه","https://www.aldiwan.net/poem43148.html","الكامل"],[46,"طودان قالا زل غفرانا","https://www.aldiwan.net/poem23492.html","السريع"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9850","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55074","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[3,"هلْ غادرَ الشُّعراءُ منْ متردَّم ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10745&r=&rc=99",""],[122,"قالوا أناب وما أناب","https://www.aldiwan.net/poem23721.html","مجزوء الكامل"],[130,"ما للشجى على برح الغرام يد","https://www.aldiwan.net/poem54853.html","الطويل"],[196,"أما وقد شردت تلك اليعافير","https://www.aldiwan.net/poem51940.html","البسيط"],[202,"كم أقاسي لديك قالا وقيلا","https://www.aldiwan.net/poem53016.html","الخفيف"],[227,"يا سيدي وأميري","https://www.aldiwan.net/poem51098.html","المجتث"],[227,"شوقي إليك على التباعد","https://www.aldiwan.net/poem51160.html","مجزوء الكامل"],[268,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[280,"انشر حديثا قديما كنت تطويه","https://www.aldiwan.net/poem32303.html","البسيط"],[351,"بلغا عني ربوع الصالحيه","https://www.aldiwan.net/poem39576.html","الرمل"],[351,"ما تراءى هلال عام جديد","https://www.aldiwan.net/poem40399.html","الخفيف"],[364,"إني فقدت أحبتي نظرا","https://www.aldiwan.net/poem17005.html","أحذ الكامل"],[377,"لك لا لغيرك أشتكي","https://www.aldiwan.net/poem49228.html","مجزوء الكامل"],[438,"أرزى المصائب والخسران في الدين","https://www.aldiwan.net/poem14487.html","البسيط"],[451,"هذي وصيتك النفيسة لم تزل","https://www.aldiwan.net/poem61640.html","الكامل"],[456,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[475,"حي عني الحمى وحي المصلى","https://www.aldiwan.net/poem15265.html","الخفيف"],[480,"بجزع الحمى ظبي حمى ذلك الحمى","https://www.aldiwan.net/poem24477.html","عموديه"],[513,"يا خير من نظم المديح لمجده","https://www.aldiwan.net/poem12063.html","الكامل"],[536,"يا جلال العصر علما","https://www.aldiwan.net/poem47938.html","عموديه"],[549,"قل للذين إذا دعوا","https://www.aldiwan.net/poem48036.html","مجزوء الكامل"],[559,"قد أملت أمنية من الأمل","https://www.aldiwan.net/poem27841.html","الرجز"],[562,"حر تربى مستقلاً جاهداً","https://www.aldiwan.net/poem902.html",""],[565,"محاسن الدير تسبيحي ومساحي","https://www.aldiwan.net/poem69749.html","البسيط"]],"verses":[["إِن يَفعَلا فَلَقَد تَرَكتُ أَباهُم","جَزَرَ السِباعِ وَكُلِّ نَسرٍ قَشعَمِ",0,"م",1,0],["إنْ يفْترِقْ نسَبٌ يؤلِّف بيْننا","أدَبٌ أقَمْناهُ مُقامَ الوالِدِ",1,"د",1,0],["إِن يَفنَ ما عِندَنا فَاللَهُ يَرزُقُنا","وَمَن سِوانا وَلَسنا نَحنُ نَرتَزِقُ",2,"ق",1,0],["إِنّي فَتَحتُ لَها صَدراً تَليقُ بِهِ","إِن لَم تُحَلّوهُ فَالرَحمَنُ حَلّاهُ",3,"ا",2,0],["إِنّي فَتاكَ فَلا تَقطَع مُواصَلَتي","هَبني جَنَيتُ فَقُل لي كَيفَ أَعتَذِرُ",4,"ر",1,0],["إِنْ يُفْتَتَنْ بِهَوَاهَا مَنْ يُلِمُّ بِهَا","فَإِنَّنِي بِهَوَاهَا أَيُّ مُفْتَنَنِ",5,"ن",1,0],["إن يفنَ ماضيهم على سنن الردى","فكأنهم ببقاء أفضلهم بقوا",6,"ق",3,0],["إن يفقد المستفيد العلم من كلم","ملكاً فقد فقدَ الصوفيّ تسليكا",7,"ك",2,0],["إنْ يفُوزُوا بسَبْقِ كلِّ مُجَارٍ","بجُدُودٍ سعيدةٍ وجُدُودِ",8,"د",1,0],["أنَّى فهمتم كلام الطير ويحكُمُ","والتَرْجُمان الذي سمَّيْتُهُ مُودي",9,"د",2,0],["إن يُفلتِ السيفُ من كَفَّيْكَ مُنْصَلِتاً","فليس منك وقِدْماً كان خَوَّانا",10,"ن",2,1],["إِن يَفتَديكِ أَخو الغِنى بِنُضارِهِ","فَبِدِرهَمي وَبِمُهجَتي أَفديكِ",11,"ك",1,0],["أَنّي في الصَرحِ الرَفيعِ الذُرى","كَطائِرٍ في قَفَصٍ مَيِّتِ",12,"ت",1,0],["ان يفكوا كالريح عنهم قيودا","اثقلتهم بكثرة الحلقات",13,"ت",1,0],["إِن يَفُت فيكَ مِنبَرَ الأَمسِ شِعري","إِنَّ لي المِنبَرَ الَّذي لَن يَزولا",14,"ل",2,0],["إِن يَفُتهُ الجَيشُ أَو رَوَّعتُهُ","لَم يَفُتهُ النَشَأُ الزُهرُ الصِباح",15,"ح",1,0],["إِن يُفنِ ما يَحوي فَقَد أَبقى بِهِ","ذِكراً يَزولُ الدَهرُ قَبلَ زَوالِهِ",16,"ل",2,0],["إِن يفرعِ الطودَ الأشمَّ فأجدلٌ","أو يركبِ البحرَ الخِضَمَّ فنونُ",17,"ن",1,0],["إنْ يفترِقْ أحبابُنا أيدي سَبا","عنها فقد يَتفرَّقُ الأَقْوامُ",18,"م",1,0],["أَن يَفجَعوا دَنِفاً مُصاباً قَلبُهُ","مِن حُبِّهِم في كُلِّ يَومٍ يُردَعُ",19,"ع",1,0],["إن يَفْزَعِ النّيلُ أو يجزعْ فقد نُكِبتْ","دنيا ممالكُها في الرُّزءِ أشباهُ",20,"ا",2,0],["إِن يُفزِعِ النيلَ وَالأُردُنَّ ما بِهِما","فَبِالفُراتِ وَشَطَّي دِجلَةَ العَجَبُ",21,"ب",1,0],["إِن يَفخَروا أَو يَقولوا أُمَّةٌ لَعِبَت","بِها الأَكُفُّ وَأَشقى جَدَّها الزَمَنُ",22,"ن",1,0],["إِن يَفنَ بَدرانا فَنَرجو الَّذي","أَغنى وَلا نَسأَلُ بَدرانا",23,"ن",2,0],["إِن يَفعَلا فَلَقَد تَرَكتُ أَباهُما","جَزَرَ السِباعِ وَكُلِّ نَسرٍ قَشعَمِ",24,"م",1,0],["إِنِّي فَقَدْتُ الْيَوْمَ بَيْنَ بُيُوتِكُمْ","عَقْلِي فَرُدُّوهُ عَلَيَّ لأَهْتَدِي",25,"د",2,0],["إِنْ يَفُتْكُمْ وَجْهُ العَزِيزِ المُوَلَّى","لَمْ يَفُتْكُمْ وَجْهُ العَزِيزِ البَاقِي",26,"ق",2,0],["إن يفاضل أي وحش يفضل","أقذف المدفع في أحشائه",27,"ه",1,0],["إن يفعلاَ فلقد تركتُ أباهما","جزرَ السباع وكلِّ نسرٍ قعشم",28,"م",1,0],["إني فتاة طهارة أفتى بها","عبود لما ساورته ظنون",29,"ن",1,0],["إِن يُفتَقَد عَالِمٌ مِن بَعدِ شَيبَتِه","الآؤُهُ غَصَّ منها السَّهلُ والجَلَدُ",30,"د",1,0],["إنّي فزعتُ بأطوادي إلى نُجُبٍ","تنازعتْ سيرَها الآكامُ والقور",31,"ر",1,0],["إن يَفُتني منك الجميل من الفع","ل تعاطيتُ عنك صبراً جميلا",32,"ل",2,0],["إني فقدتُ بفقدي","أبي جميعَ سروري",33,"ي",1,0],["إنّي فقدتك مثلَ ما","فقد البنانَ الساعدُ",34,"د",1,0],["إن يفقدوا ملكَهم لن يفقدوا شرفاً","ظلّوا به للعلى والملكِ طلّابا",35,"ب",2,0],["إِن يَفعَلِ الخَيرَ بي يَجزِ الإِلَهُ بِهِ","مَن يَفعَلِ الخَيرَ لا يَعدَم جَوازيهِ",36,"ي",2,0],["إِن يَفتنا ذَلك العَهد فَما","فاتنا عَهد الأَيادي الحاتميّه",37,"ي",2,0],["إِن يفق مَن يَنال بِالخطّ حَظّاً","كُنت باري أَقلام عَبد الحَميدِ",38,"د",1,0],["إِنّي فَقَدتُ أَحِبَّتي نَظَرا","وَوَجدتُ بَعدَهُم التَوى أَثَرا",39,"ر",2,1],["إِني فَنيت وَإِنَّما","أَمل التَلاقي مَمسَكي",40,"ي",1,0],["إن يفسد الدين فالأشياء فاسدة","لا يستقيم عماد فوق تودين",41,"ن",1,0],["إن يفخر الموتى فَمن أسمعتهم","ما قلتَ قد عاشوا بفخرِ السابِقِ",42,"ق",1,0],["إن يَفُتنا الخطيبُ والمِنبر المن","صوبُ فالتاج حظُّنا والسريرُ",43,"ر",1,0],["اِنْ يَفُتْني فاِنَّ حُزْني مقيمٌ","صارَ اِلباً عليَّ مذ صارَ كلاّ",44,"ل",2,0],["إني في حمى ظبي مليح له حما","ففي راحتي اليمنى شباب به حلما",45,"م",2,0],["إن يفتخر بنبوة ووصية","فهما تراث عن أبيه وجده",46,"د",2,0],["إن يَفُق غيرَه نَثراً","مثلُ ما فاقَه نَظما",47,"م",2,0],["إِنّي فَعولٌ إذ أقو","لُ وإنْ خلقتُ فقد فريتُ",48,"ت",1,0],["أَن يُفلِتوا مِنّا وَلَمّا تَجتَفَل","جُلودُهُم أَغراضَ طَعنٍ كَالنَغَل",49,"ل",1,0],["إن يفتخر يوماً سواه بجده","فخر الرماد ففخره بجهاده",50,"د",2,0],["إن يُفْنِ كاسُكَ أكياسي فإنّ بها","يَفُلُّ جَيْشَ هُمُومي جيشُ أفْرَاحي",51,"ي",1,0]]}