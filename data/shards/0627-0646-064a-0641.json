://www.poetsgate.com/ViewPoem.aspx?id=204625",""],[4955,"إني فخور أنني من أمتك","https://www.poetsgate.com/ViewPoem.aspx?id=211005",""],[585,"هل في العراق من الرفاق مواس","https://www.poetsgate.com/ViewPoem.aspx?id=161918",""],[5079,"إني أحبك ياوسن","https://www.poetsgate.com/ViewPoem.aspx?id=178379",""],[5183,"عُمان","https://www.poetsgate.com/ViewPoem.aspx?id=186489",""],[5246,"مهلا رجال الصفا مهلا محبينا","https://www.poetsgate.com/ViewPoem.aspx?id=187061",""],[5257,"أنين الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=185245",""],[5273,"في الفخر","https://www.poetsgate.com/ViewPoem.aspx?id=215879",""],[5277,"البوحُ أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=191377",""],[5277,"معارضة داليّة الحصري القيرواني","https://www.poetsgate.com/ViewPoem.aspx?id=198895",""],[5425,"إِنْ يَفْتِنُوكَ","https://www.poetsgate.com/ViewPoem.aspx?id=199784",""],[5431,"يانكهة الدراق...","https://www.poetsgate.com/ViewPoem.aspx?id=191720",""],[5472,"يا أيها المرجوّ للدّهر","https://www.poetsgate.com/ViewPoem.aspx?id=200468",""],[5596,"اليحمدي","https://www.poetsgate.com/ViewPoem.aspx?id=206710",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5644,"هواك خلود","https://www.poetsgate.com/ViewPoem.aspx?id=208735",""],[5674,"وأقمت بعدك يافرات عزائي","https://www.poetsgate.com/ViewPoem.aspx?id=190746",""],[5689,"هل طي عرفك لي يا نسمة السحر","https://www.poetsgate.com/ViewPoem.aspx?id=143428",""],[5732,"قالوا علامك","https://www.poetsgate.com/ViewPoem.aspx?id=177885",""],[402,"سوى الحب لا تشفي الفؤاد المكلما","https://www.poetsgate.com/ViewPoem.aspx?id=36334",""],[5829,"رسالة إلى أمي في ذكرى وفاتها","https://www.poetsgate.com/ViewPoem.aspx?id=175530",""],[5851,"قلب بحجم الرؤى","https://www.poetsgate.com/ViewPoem.aspx?id=175288",""],[5899,"عطر النار","https://www.poetsgate.com/ViewPoem.aspx?id=31488",""],[5956,"الشرع حلّل لي زواجك يا مَدامْ","https://www.poetsgate.com/ViewPoem.aspx?id=182631",""],[5956,"مبدأ يرضي السماء","https://www.poetsgate.com/ViewPoem.aspx?id=183704",""],[5956,"الشخصية المرموقة","https://www.poetsgate.com/ViewPoem.aspx?id=194217",""],[5956,"أعضاؤها لخدامتي تتسابقُ","https://www.poetsgate.com/ViewPoem.aspx?id=205481",""],[5956,"هل يستطيب الفتى إيهابُ فُرقتنا","https://www.poetsgate.com/ViewPoem.aspx?id=210301",""],[6019,"في محراب الرجاء..!!","https://www.poetsgate.com/ViewPoem.aspx?id=53850",""],[6056,"ياحيلة الله كيف ؟","https://www.poetsgate.com/ViewPoem.aspx?id=130568",""],[6093,"اللومُ عنديَ أنْ تفنى على طللِ (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176200",""],[6099,"زهد","https://www.poetsgate.com/ViewPoem.aspx?id=35164",""],[6124,"وجه الريح","https://www.poetsgate.com/ViewPoem.aspx?id=160436",""],[6225,"إزالة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78009&r=&rc=95",""],[572,"إِنِّي فزعتُ إلى صَبْري فانقَذَني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9450&r=&rc=307",""]],"verses":[["إِن يَفعَلا فَلَقَد تَرَكتُ أَباهُم","جَزَرَ السِباعِ وَكُلِّ نَسرٍ قَشعَمِ",0,"م",1,0],["إنْ يفْترِقْ نسَبٌ يؤلِّف بيْننا","أدَبٌ أقَمْناهُ مُقامَ الوالِدِ",1,"د",1,0],["إِن يَفنَ ما عِندَنا فَاللَهُ يَرزُقُنا","وَمَن سِوانا وَلَسنا نَحنُ نَرتَزِقُ",2,"ق",1,0],["إِنّي فَتَحتُ لَها صَدراً تَليقُ بِهِ","إِن لَم تُحَلّوهُ فَالرَحمَنُ حَلّاهُ",3,"ا",2,0],["إِنّي فَتاكَ فَلا تَقطَع مُواصَلَتي","هَبني جَنَيتُ فَقُل لي كَيفَ أَعتَذِرُ",4,"ر",1,0],["إِنْ يُفْتَتَنْ بِهَوَاهَا مَنْ يُلِمُّ بِهَا","فَإِنَّنِي بِهَوَاهَا أَيُّ مُفْتَنَنِ",5,"ن",1,0],["إن يفنَ ماضيهم على سنن الردى","فكأنهم ببقاء أفضلهم بقوا",6,"ق",3,0],["إن يفقد المستفيد العلم من كلم","ملكاً فقد فقدَ الصوفيّ تسليكا",7,"ك",2,0],["إنْ يفُوزُوا بسَبْقِ كلِّ مُجَارٍ","بجُدُودٍ سعيدةٍ وجُدُودِ",8,"د",1,0],["أنَّى فهمتم كلام الطير ويحكُمُ","والتَرْجُمان الذي سمَّيْتُهُ مُودي",9,"د",2,0],["إن يُفلتِ السيفُ من كَفَّيْكَ مُنْصَلِتاً","فليس منك وقِدْماً كان خَوَّانا",10,"ن",2,1],["إِن يَفتَديكِ أَخو الغِنى بِنُضارِهِ","فَبِدِرهَمي وَبِمُهجَتي أَفديكِ",11,"ك",1,0],["أَنّي في الصَرحِ الرَفيعِ الذُرى","كَطائِرٍ في قَفَصٍ مَيِّتِ",12,"ت",1,0],["ان يفكوا كالريح عنهم قيودا","اثقلتهم بكثرة الحلقات",13,"ت",1,0],["إِن يَفُت فيكَ مِنبَرَ الأَمسِ شِعري","إِنَّ لي المِنبَرَ الَّذي لَن يَزولا",14,"ل",2,0],["إِن يَفُتهُ الجَيشُ أَو رَوَّعتُهُ","لَم يَفُتهُ النَشَأُ الزُهرُ الصِباح",15,"ح",1,0],["إِن يُفنِ ما يَحوي فَقَد أَبقى بِهِ","ذِكراً يَزولُ الدَهرُ قَبلَ زَوالِهِ",16,"ل",2,0],["إِن يفرعِ الطودَ الأشمَّ فأجدلٌ","أو يركبِ البحرَ الخِضَمَّ فنونُ",17,"ن",1,0],["إنْ يفترِقْ أحبابُنا أيدي سَبا","عنها فقد يَتفرَّقُ الأَقْوامُ",18,"م",1,0],["أَن يَفجَعوا دَنِفاً مُصاباً قَلبُهُ","مِن حُبِّهِم في كُلِّ يَومٍ يُردَعُ",19,"ع",1,0],["إن يَفْزَعِ النّيلُ أو يجزعْ فقد نُكِبتْ","دنيا ممالكُها في الرُّزءِ أشباهُ",20,"ا",2,0],["إِن يُفزِعِ النيلَ وَالأُردُنَّ ما بِهِما","فَبِالفُراتِ وَشَطَّي دِجلَةَ العَجَبُ",21,"ب",1,0],["إِن يَفخَروا أَو يَقولوا أُمَّةٌ لَعِبَت","بِها الأَكُفُّ وَأَشقى جَدَّها الزَمَنُ",22,"ن",1,0],["إِن يَفنَ بَدرانا فَنَرجو الَّذي","أَغنى وَلا نَسأَلُ بَدرانا",23,"ن",2,0],["إِن يَفعَلا فَلَقَد تَرَكتُ أَباهُما","جَزَرَ السِباعِ وَكُلِّ نَسرٍ قَشعَمِ",24,"م",1,0],["إِنِّي فَقَدْتُ الْيَوْمَ بَيْنَ بُيُوتِكُمْ","عَقْلِي فَرُدُّوهُ عَلَيَّ لأَهْتَدِي",25,"د",2,0],["إِنْ يَفُتْكُمْ وَجْهُ العَزِيزِ المُوَلَّى","لَمْ يَفُتْكُمْ وَجْهُ العَزِيزِ البَاقِي",26,"ق",2,0],["إن يفاضل أي وحش يفضل","أقذف المدفع في أحشائه",27,"ه",1,0],["إن يفعلاَ فلقد تركتُ أباهما","جزرَ السباع وكلِّ نسرٍ قعشم",28,"م",1,0],["إني فتاة طهارة أفتى بها","عبود لما ساورته ظنون",29,"ن",1,0],["إِن يُفتَقَد عَالِمٌ مِن بَعدِ شَيبَتِه","الآؤُهُ غَصَّ منها السَّهلُ والجَلَدُ",30,"د",1,0],["إنّي فزعتُ بأطوادي إلى نُجُبٍ","تنازعتْ سيرَها الآكامُ والقور",31,"ر",1,0],["إن يَفُتني منك الجميل من الفع","ل تعاطيتُ عنك صبراً جميلا",32,"ل",2,0],["إني فقدتُ بفقدي","أبي جميعَ سروري",33,"ر",2,0],["إنّي فقدتك مثلَ ما","فقد البنانَ الساعدُ",34,"د",1,0],["إن يفقدوا ملكَهم لن يفقدوا شرفاً","ظلّوا به للعلى والملكِ طلّابا",35,"ب",2,0],["إِن يَفعَلِ الخَيرَ بي يَجزِ الإِلَهُ بِهِ","مَن يَفعَلِ الخَيرَ لا يَعدَم جَوازيهِ",36,"ي",2,0],["إِن يَفتنا ذَلك العَهد فَما","فاتنا عَهد الأَيادي الحاتميّه",37,"ي",2,0],["إِن يفق مَن يَنال بِالخطّ حَظّاً","كُنت باري أَقلام عَبد الحَميدِ",38,"د",1,0],["إِنّي فَقَدتُ أَحِبَّتي نَظَرا","وَوَجدتُ بَعدَهُم التَوى أَثَرا",39,"ر",2,1],["إِني فَنيت وَإِنَّما","أَمل التَلاقي مَمسَكي",40,"ك",2,0],["إن يفسد الدين فالأشياء فاسدة","لا يستقيم عماد فوق تودين",41,"ن",1,0],["إن يفخر الموتى فَمن أسمعتهم","ما قلتَ قد عاشوا بفخرِ السابِقِ",42,"ق",1,0],["إن يَفُتنا الخطيبُ والمِنبر المن","صوبُ فالتاج حظُّنا والسريرُ",43,"ر",1,0],["اِنْ يَفُتْني فاِنَّ حُزْني مقيمٌ","صارَ اِلباً عليَّ مذ صارَ كلاّ",44,"ل",2,0],["إني في حمى ظبي مليح له حما","ففي راحتي اليمنى شباب به حلما",45,"م",2,0],["إن يفتخر بنبوة ووصية","فهما تراث عن أبيه وجده",46,"د",2,0],["إن يَفُق غيرَه نَثراً","مثلُ ما فاقَه نَظما",47,"م",2,0],["إِنّي فَعولٌ إذ أقو","لُ وإنْ خلقتُ فقد فريتُ",48,"ت",1,0],["أَن يُفلِتوا مِنّا وَلَمّا تَجتَفَل","جُلودُهُم أَغراضَ طَعنٍ كَالنَغَل",49,"ل",1,0],["إن يفتخر يوماً سواه بجده","فخر الرماد ففخره بجهاده",50,"د",2,0],["إن يُفْنِ كاسُكَ أكياسي فإنّ بها","يَفُلُّ جَيْشَ هُمُومي جيشُ أفْرَاحي",51,"ح",2,0],["إن يفخر النيل بالابنا لا عجبٌ","فإنما ببنيه ذكره عطرا",52,"ر",2,0],["إن يفخر الأمراء فيما بينهم","يوما بآباء لهم وجدود",53,"د",1,0],["إن يفجع العلياء باِبن زعيمها","فلهُ بذكرِ اللّه يوم وعيدِ",54,"د",1,0],["إن يَفضُلِ البيضَ الجَحاجِحَ أسودٌ","فالعَينُ أفضلُها سَوادُ الناظِر",55,"ر",1,0],["أنّى فقيهٍ يعْتِلي","لمحلّه أو يرتقيهْ",56,"ق",3,0],["إنّي فضضتُ عن الدّموع خِتاماً","فغدت تسيل بوجْنَتيَّ غَمَامَا",57,"م",2,1],["أن يفق فخراً على الفخر فقد","نافس الكشاف كشفاً واعتقادْ",58,"د",1,0],["اني فقدت بحسن عدلك غادةً","تقنى الحياء وتقنئ الاقذاء",59,"ا",2,0],["إني فزعت إليك في أمسى وفي","يومي وفي الآتي فأمّن مفزعي",60,"ع",2,0],["إنِّى فَتًى أَدرَكتُ أَقصَى سعيهِم","وَغَرَفتُ مِن بَحرٍ وَلَيسَ بجَدوَلِ",61,"ل",1,0],["إنْ يَفْعلوا فكفاهمْ شاهداً لَهُمُ","بالنَّقْصِ جهلُهُمُ في الفَضْلِ مِقْداري",62,"ر",2,0],["إِنِّي فُطِرْتُ على النُّهى","وتَفَطَّرَ العُذّالُ جَهْلاً",63,"ل",2,0],["إن يفترق شملنا وشيكا","من بعد ما كان ذا اجتماع",64,"ع",1,0],["إِنِّي في قبضته أسير","وَلَيس لي مِن جورهِ مجير",65,"ر",1,0],["أني فررتم ونار الغيظ تحرقكم","والذل يتبعكم والخذل والندم",66,"م",1,0],["أن يفته لدى المفاخر ذكر","فهم الذكر والصدى والشذاء",67,"ا",2,0],["إني فتاةُ الشرق صرتُ يتيمةً","في أهله وغريبةً ببلادي",68,"د",2,0],["إنيَ في الكون وهُمْ بعضُه","ولستُ بالمحصور في مَوضِع",69,"ع",1,0],["اني فلست مفرقا","بين الصواب كذا الخطا",70,"ط",2,0],["إن يفردِ الوتر له فعله","يقول عينُ الشفع بل منهما",71,"م",2,0],["إني فُطرت على أخلاقِ خالقنا","والأمر ما بين مرزوقٍ ورزّاقِ",72,"ق",1,0],["اني فتى من أمةٍ امنب","به ولكن ما كُفيتُ القتال",73,"ل",1,0],["إني فتىً جودك الوافي صيرني","أخا نظامٍ أجيد المدح والغزلا",74,"ل",2,0],["إِنّي فَتىً حُرٌ لِقَدرِيَ عارِفٌ","أُعطي بِهِ وَعَليهِ مِمّا أَمنَعُ",75,"ع",1,0],["إن يُفتحِ البابُ عنهم بعد عاشرةٍ","تظنّهم خرجوا من قعرِ أرماسِ",76,"س",1,0],["إن يفسد الشعر الصحيح معاشرُ","فلكم أساءت للقريض مشاعر",77,"ر",1,1],["إن يفتني كونٌ فلي من خيالي","ألف كونٍ يسمو على الكون فضلا",78,"ل",2,0],["ان يفق حسنك الملاح فاني","فقت أهل الهوى غراماً ووجدا",79,"د",2,0],["إن يفعَلوا فَجَزاهم","الموت غمّا وحِقدا",80,"د",2,0],["إن يفعل التأثير أن ينفعلا","تأثرٌ ما دام كل كملا",81,"ل",2,0],["إِنّي فَتى قيّدت نطقي أَو أَرى","ندبا يفكّ نَداه كلّ مقيّدِ",82,"د",1,0],["إني فجعت وهذا الموت ليس به","عارٌ بحسانة كالبدر إذ لمعا",83,"ع",2,0],["إن يُفتَح اثرَ ضَمِّ أو فَتحِ قُلِب","وَاواً وَيَاءً إثرَ كَسرٍ يَنقَلِب",84,"ب",1,0],["اني في حبك لم أشرك","وجزا توحيدي ان أشكر",85,"ر",1,0],["إن يفتنا فيك اختيال قوام","لم يفتنا بنات فكر تروق",86,"ق",1,0],["إن يفتها طير الأراك فقد كا","نت عليها قلوبنا طائرات",87,"ت",1,0],["إن يفتكَ الخط الجميل أعر خط","كَ حسناً كما اعرتَ النظاما",88,"م",2,0],["إِني فَهمت وَقَد علمت مَقاصِدي","وَرَميت لَو أَني أَصَبت مَرامي",89,"م",2,0],["أَنَّى فصلتم إِن يَثبُت بجوهرِ اصلهِ","يَثبُت وان يُفصَل يُعَدَّ كفاني",90,"ن",2,0],["إني فتى لم يدر طعم الكرى","إن يهجع الموتور لا يهجع",91,"ع",1,0],["إن يَفُتنا منالُها لم تفتنا","نظرةٌ من خيالها المرقوب",92,"ب",1,0],["إني فقيرٌ لك