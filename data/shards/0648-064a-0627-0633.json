دهر حين نعى","https://www.poetsgate.com/ViewPoem.aspx?id=170964",""],[5019,"يا أيها العارف المحكول ناظره","https://www.poetsgate.com/ViewPoem.aspx?id=157050",""],[5055,"على سنة الله","https://www.poetsgate.com/ViewPoem.aspx?id=103419",""],[5063,"وَيَاسمين حسن المنظر","https://www.poetsgate.com/ViewPoem.aspx?id=191205",""],[585,"مهلاً عليَّ فإني الموجع الدنف","https://www.poetsgate.com/ViewPoem.aspx?id=161915",""],[5085,"أشاغلُ نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=188401",""],[5102,"شاعر المليون","https://www.poetsgate.com/ViewPoem.aspx?id=14630",""],[5145,"حثوا المطي فهذا الصبح قد جشرا","https://www.poetsgate.com/ViewPoem.aspx?id=108048",""],[5190,"الطين والماء","https://www.poetsgate.com/ViewPoem.aspx?id=82169",""],[5205,"أمبكي عيون الصد لا أبكي","https://www.poetsgate.com/ViewPoem.aspx?id=120996",""],[5246,"رجوت القوافي أن تساعف رغبتي","https://www.poetsgate.com/ViewPoem.aspx?id=187050",""],[592,"تلألأ نور الحق في الخلق وانتشر","https://www.poetsgate.com/ViewPoem.aspx?id=128721",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5387,"بعد الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=53063",""],[5387,"سوريا","https://www.poetsgate.com/ViewPoem.aspx?id=53541",""],[5409,"تهللت كالعارض الباكر","https://www.poetsgate.com/ViewPoem.aspx?id=155493",""],[5410,"ولادة","https://www.poetsgate.com/ViewPoem.aspx?id=141277",""],[5431,"تضيئ قناديل حروفٍ وتَسْرجُ","https://www.poetsgate.com/ViewPoem.aspx?id=188077",""],[5431,"وأضحكُ من غوغاء (فيْسٍ) مضللٍ","https://www.poetsgate.com/ViewPoem.aspx?id=200028",""],[5444,"موكب العز","https://www.poetsgate.com/ViewPoem.aspx?id=205068",""],[5686,"دروب الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=203361",""],[5736,"منبج","https://www.poetsgate.com/ViewPoem.aspx?id=208889",""],[5762,"هو الإثمُ زلزل زلزالها","https://www.poetsgate.com/ViewPoem.aspx?id=177978",""],[5956,"أحبك يا صديق الناس","https://www.poetsgate.com/ViewPoem.aspx?id=192520",""],[5956,"يتسلسل الوفاء منا لأسرة نجلي فراس","https://www.poetsgate.com/ViewPoem.aspx?id=193153",""],[6031,"يا مَوْرِداً لا يُغيضُ النَزحُ جَمَّتَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=46258",""],[6148,"شهر الصيام","https://www.poetsgate.com/ViewPoem.aspx?id=201600",""],[5309,"تعذب قلبي غادة ذات صولة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573598",""],[5464,"يا أخت هارون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66201&r=&rc=20",""],[6247,"من أوراق امرأة مطلقة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80295&r=&rc=34",""],[6270,"لنا حجرٌ ودون الموت صدرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69080&r=&rc=4",""]],"verses":[["ويأسف لما يُبصر البَرَّ يرتمي","بفرسانه والبحرَ بالسفُن يقذفُ",0,"ف",1,0],["ويا ساكناً بالأجْرَعِ الفرد من مِنًى","وأيسير حظّ من رضاك كثيرُ",1,"ر",1,0],["ويا سحب هلاَ تنزلين فتحملي","إلى الحرب جيشنا ينشر النقع كالسحب",2,"ب",1,0],["وَيا ساهِدَ العَينَينِ فيما يُريبُني","أَلا أَنَّ طَرفي في الأَذى غَيرُ ساهِدِ",3,"د",1,0],["ويا سليمانَ ملكٍ في سيادته","لا ينبغي لسريٍّ أن يسايره",4,"ر",2,0],["ويا سابق النعمى لراجيه لا تزل","تُلافي حياة المرء عند تَلافي",5,"ف",2,0],["ويا سَوْأتا إن أنت سوَّدتَ وجهَهُ","فأصبحَ معتوباً عليه وعاتبا",6,"ب",2,0],["ويا سوءتا للمجد والفخر بعدها","وقد حُقَّ أن يُستحسنَ المجدُ والفخر",7,"ر",1,0],["ويأسى على مُدَحِ المستمر","رِ بالحمد والشكر لا الظالع",8,"ع",1,0],["وَيا سَراةً يَبذُلونَ اللُهى","هَذا فَقيرٌ كانَ يُعطي السُراة",9,"ه",1,0],["وَيا ساكِناً قَلبي وَما فيهِ غَيرُهُ","فَدَيتُكَ ما اِستَوحَشتُ مِنهُ لِمُؤنِسِ",10,"س",1,0],["وَيا سَعدَ قَومٍ أَدرَكوا فيهِ حَظَّهُم","لَقَد جَمَعوا بَينَ الغَنيمَةِ وَالأَجرِ",11,"ر",1,0],["ويا سعد لم تفتأ لمصر مناضلا","وما فتى المقدار غير مساعد",12,"د",1,0],["وَيَأسى عَلَيكَ الدينُ إِذ لَكَ لُبُّهُ","وَلِلخادِمينَ الناقِمينَ قُشورُ",13,"ر",1,0],["وَيا سَعدُ أَنتَ أَمينُ البِلادِ","قَدِ اِمتَلَأَت مِنكَ أَيمانُها",14,"ن",3,0],["وَيا سَوأَتا مِن وَجهِ بَغلٍ مُذَرَّعٍ","يُجِدُّ سَواداً في وُجوهِ القَبائِلِ",15,"ل",1,0],["ويا سَيفي أَصولُ بهِ","ويا حِلِّي ويا حَرَمي",16,"م",2,0],["وَيَإِستُ مِنهُ فَلَستُ أَط","مَعُ أَن يَعيشَ فَنَلتَقي",17,"ق",2,0],["وَيا سُيوفَ لِحظِ مَن أَحبَبتُهُ","جُهدَكَ عَن سَفكِ دَمي لا تُغمِدي",18,"د",2,0],["ويا سحائبُ أغني عنكِ نائلَهُ","فاسقي المواطرَ حياً من بني مضرِ",19,"ر",1,0],["ويا سيوفَ رَسولِ اللهِ لا تَدَعِي","للعاكِفينَ على الأصنامِ من بَاقِ",20,"ق",1,0],["وَيَأسَفُ مَعشرٌ باتوا سهارَى","تَفيضُ جِراحُهم بعدَ انْدِمالِ",21,"ل",1,0],["ويا سعدُ لا ترفَقْ بقوسكَ وَارْمِها","سِهاماً أصابت من يدِ اللّهِ باريا",22,"ي",2,0],["وَيَا سَيِّداً هَأم بِالمعلَوَاتِ","فَلَم يُصغِ فِيهَا إلَى عَاذِلِ",23,"ل",1,0],["وَيا سَلوَتي لا أَعرِفُ العُذرَ إِنَّني","أَخَذتُ مَعَ الأَشجانِ أَكرَمَ مَوثِقِ",24,"ق",1,0],["وَيا سَلوَتي في الحُبِّ بيني ذَميمَةً","وَفي غَيرِ حِفظٍ أَيُّها النَومُ فَاِذهَبِ",25,"ب",1,0],["وَيا سَلمَ ما أَربَحتُ إِن أَنا بِعتُكُم","بِدُنيا وَكَم مِن تاجِرٍ غَيرُ مُربِحِ",26,"ح",1,0],["وَيا سَلمَ إِن أَرجِع إِلَيكِ فَرُبَّما","رَجَعتُ وَأَمري لِلعِدا غَيرُ مُفرِحِ",26,"ح",1,0],["وَياسَمينٍ في ذُرى الأَغصانِ","مُنتَظِماً كَقِطَعِ العِقيانِ",27,"ن",1,0],["وَيا ساقِيَيَّ اليَومَ عودا وَثَنِّيا","بِإِبريقِ راحٍ في الكُؤوسِ مُقَهقِهِ",28,"ه",1,0],["ويا سقى بَرْديَّ مصر ساق","يُمْرِعُه من عَذَب لساق",29,"ق",1,0],["وَيَا سَنَةً لَقِينَاها","بِمِلْء صُدُورِنا بِشْرَا",30,"ر",2,1],["ويأسُك من عفو السماءِ خطيئةٌ","أشد من الذنب الذي كنتَ جانِيا",31,"ي",2,0],["ويا سِحرَ موسى – إنَّ في كلّ بقعةٍ","لما تجتلي من آيةٍ حيَّةً تسعى",32,"ع",2,0],["ويَا سَوْءَتَا مِنْ وَجْهِ بَغْلٍ مُذَرَّعٍ","يُجِدُّ سَوَاداً في وُجُوهِ القَبَائلِ",33,"ل",1,0],["ويا سامر الأحباب مالك موحشا","معاذ الهوى بل أنت يؤنسك الذكرا",34,"ر",2,0],["ويا سامر الأحباب طيف ولا كرى","وسكر ولا راح وريّا ولا زهر",34,"ر",1,0],["ويا سيد الشيخ الرفاعي أحمد ال","أكابر تاج القوم صاحب برهان",35,"ن",1,0],["وياسمينٍ شممناه مناقلةً","نشقته ونشقت الحسن في آن",36,"ن",1,0],["ويا سامعاً قولي سَلِ اللهَ رحمةً","ومغفرةً أدعوك إن كنت مُسْعِدِي",37,"د",2,0],["ويا سحابَ المُزنِ ما بالُنا","يشوقُنا ذيلُكَ إذ يُسْحَبُ",38,"ب",1,0],["ويا سقم مالك فارقت جسمي","أظنك لم تلق فيه قراك",39,"ك",1,0],["وَياسَمين كَلَونِ ال","مُتَيَّمِ المَهجورِ",40,"ر",1,0],["وَيا سَحاباً عَلى أَهلِ التُقى هَطِلاً","وَيا شِهاباً لِشيطان الخَنا رَصَدا",41,"د",2,0],["ويأسي ان ارجو الأمير ابن منجك","على أمر آمالي والا أميرها",42,"ر",3,0],["ويا ساكني (الفيحاء) جادَكمُ الحيا","ولا برحتكمْ شمأل وجنوب",43,"ب",1,0],["ويا سحب الجود الإلهي أمطري","فإن أكف المحل تلقاك مدت",44,"ت",1,0],["ويأسي من الدنيا وسخطى على القضا","وإيمان عقلى بالأراجيف مضطرا",45,"ر",2,0],["ويا سلوتي عنها إليكِ فلم أكُن","لأسلوَ من كانت مَنارَ حياتيا",46,"ي",2,0],["ويأسه امل","وحزنه طرب",47,"ب",1,0],["وَيا سَيّداً لِلّه أَخلَص سرّه","بِما نالَ من مَولاه في السرّ وَالجَهرِ",48,"ر",1,0],["وَيا سَميريَ كَرّر لي مَدائحه","فَالشَهد ألطف ما يَحلو مكرَّرهُ",49,"ر",2,0],["وَيا سُروراً بِهِ الدُنيا اِكتَسَت حللاً","مِن الهَنا وَبِهِ العليا زَهَت أَبَدا",50,"د",2,0],["ويا سحابُ كَفاني فَضلُ نائلهِ","فأمطُرْ على دِمَنٍ بالبيدِ أَدْراس",51,"س",1,0],["وَيا سَيفاً حَمائِلُهُ المَعالي","وَما خِلتُ الغُمودَ مِنَ القُبورِ",52,"ر",1,0],["ويا سَلمُ ما أدراك أن رب فتية","ذوي نيقةٍ في صالحات الخلائِق",53,"ق",1,0],["ويا سعد جَازِنِي بالدعا","واسأل لي الغفران من ذي الجلال",54,"ل",1,0],["ويا سيد الرسل الكرام شفاعة","أفوز بها في يوم حَشْرِي والنشر",55,"ر",1,0],["وَيا سَيِّدي عَبدٌ دَعاكَ معولاً","عليك وَلَم يَخطُر سِواكَ بِبالِهِ",56,"ل",2,0],["ويا سعد خذْ بالجزع من أيمنِ اللّوى","لعلِّي أرى فيها على الحبِّ مُسعِدا",57,"د",2,0],["ويا سَعْدُ لا تلحُ أخاك وقد مضى","به سَهْمُ راميه أشدَّ مضاء",58,"ا",2,0],["ويا سعد إنِّي قد مُنيْتُ وراعني","نوىً يوم جدَّ البين من خلطائي",58,"ي",1,0],["ويا سُتُرَ البيضِ النَّواعِمِ أَعْلِني","إِلَى اليَعْمُلاتِ والرِّحالِ سِرَارَكِ",59,"ك",1,0],["ويا سائلي عن عالم الخلق كلها","فحسبك ما قالوا ثلاثة أَصناف",60,"ف",1,1],["ويا سيد العُباد هل من زيارة","أَأَم صرت عنا قاصر الحركات",61,"ت",1,0],["ويا سقي الله من أبيك ثرى","ثوت به حشمة وآداب",62,"ب",1,0],["وياسمين حبانا طيبَ منظرِه","وقد تبدَّتْ من الصبح التبَاشِيرُ",63,"ر",1,1],["ويا سيّدي يا أعَزَّ الرجال","يا مُشرَعاً قَطُّ لم يُعجَ