modules.php?name=Sh3er&doWhat=shqas&qid=87102&r=&rc=19",""],[6168,"أَاَلْيَوْمَ بانَ الحَيُّ أَمْ وَاعَدُوا غَدَا؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7542&r=&rc=12",""],[6181,"مسافر ومسافرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87686&r=&rc=1",""],[6189,"قراءة لعوامل التعرية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83585&r=&rc=52",""],[6199,"أنا آخر العشّاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79701&r=&rc=22",""],[6248,"تراتيل العزلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86018&r=&rc=4",""],[6259,"صددت إذ عادَ روضُ الرأس ذا زهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59373&r=&rc=21",""]],"verses":[["صَعلٍ يَعودُ بِذي العُشَيرَةِ بَيضَهُ","كَالعَبدِ ذي الفَروِ الطَويلِ الأَصلَمِ",0,"م",1,0],["صعْبُ المَقادَةِ في الهَوادةِ والهَوى","سهْلٌ علَى العافِينَ والطُّرّاقِ",1,"ق",1,0],["صَعُبَت وَراضَ المَزجُ سَيِّئَ خُلقِها","فَتَعَلَّمَت مِن حُسنِ خُلقِ الماءِ",2,"ا",2,0],["صَعِدَ الدينُ يَستَغيثُ إِلى اللَ","هِ وَقالَ الأَنامُ قَد ظَلَموني",3,"ن",2,1],["صَعراءُ إِن هِيَ قامَت فَهيَ مائِلَةٌ","وَإِن مَشَت فَهيَ كَالميزانِ مُعتَدِلَه",4,"ل",2,0],["صَعْبُ المِرَاسِ عَلَى الآفَاتِ يُتْعِبُهَا","جَلْدٌ تَقَاذَفُهُ الأَنْوَارُ وَالظُّلْمُ",5,"م",1,0],["صَعلٌ كَسافِلَةِ القَناةِ وَظيفُهُ","وَكَأَنَّ جُؤجُؤُهُ صَفيحُ كِرانِ",6,"ن",1,0],["صَعَّدَهم في كَؤُودِهِ الرَبوَ تَو","هِينُ قُوَىً والسُّعَاةُ لا الوَثَبُ",7,"ب",1,0],["صعدهم في كودة الربو","توهين قوى والسعاة لا الوثب",8,"ب",1,0],["صعدت روحه لأمثالها الزه","ر وفي الأرضِ أين أين أمثاله",9,"ل",2,0],["صَعْبٍ إذا صَعُبَتْ عليه قرينةٌ","حَتَّى تُسمِّحَ أيَّمَا تسميحِ",10,"ح",1,0],["صعبة في الرأس جامحة","سهلة في كل مُزْدَردِ",11,"د",1,0],["صُعرُ الخُدودِ وَقَد باشَرنَ هاجِرَةً","لِكَوكَبٍ مِن نُجومِ القَيظِ مُلتَهِبِ",12,"ب",1,0],["صَعلٌ كَأَنَّ جَناحَيهِ وَجُؤجُؤَهُ","بَيتٌ أَطافَت بِهِ خَرقاءُ مَهجومُ",13,"م",1,0],["صعب علي عبوره","يا رب ثبت ارجلي",14,"ل",2,0],["صَعَدتُم وَما غَيرُ القَنا ثَمَّ مَصعَدٌ","وَلا سُلَّمٌ إِلّا الحَديدُ المُذَرَّبُ",15,"ب",1,0],["صعدت بأجنحة المليكة نح","والجو تبغي عنده أربا",16,"ب",2,0],["صَعِدوا جِبالاً مِن عُلاكَ كَأَنَّها","هَضَباتُ قُدسَ وَيَذبُلٍ وَحِراءِ",17,"ا",2,0],["صُعوبَةُ الرُزءِ تُلقى في تَوَقُّعِهِ","مُستَقبَلاً وَاِنقِضاءُ الرُزءِ أَن يَقَعا",18,"ع",2,0],["صُعِقَ العِدا بلَظاهُما فكأنَّما","كانَا على الأعداءِ صَاعِقَتَيِنِ",19,"ن",1,0],["صَعلٍ كَسافِلَةِ القَناةِ مِنَ ال","مُرّانِ يَنفي الخَيلَ بِالعَذمِ",20,"م",1,0],["صُعرَ الخُدودِ كَأَنَّما","جُنِّحنَ أَجنِحَةَ النُسورِ",21,"ر",1,0],["صَعُبَت فَحَكَّمنا السُقاةَ بِمَزجِها","فَغَدا يَزيدُ بِها المِزاجُ وَيَنقُصُ",22,"ص",1,0],["صَعبُ العَريكَةِ سَهلَةٌ أَخلاقُهُ","قَومٌ بِهِ سَعِدوا وَقَومٌ نُغِّصوا",22,"ص",3,0],["صَعِدَت مَراتِبُ مَجدِهِ فَكَأَنَّما","تَعلو لَهُ فَوقَ المَجَرَّةِ أَخمَصُ",22,"ص",1,0],["صَعبُ القِيادِ فَإِن راضَت خَلائِقَهُ","كَأسُ المُدامِ أَلانَت مِنهُ ما صَعُبا",23,"ب",2,0],["صعدا إلى الآفاق يرتقيان","وتعانقا خلف الغمام وأترعا",24,"ع",2,0],["صَعبِ القَوافي إِلّا لِفارِسِهِ","أَبِيَّ نَسجِ العَروضِ مُمتَنَعِه",25,"ع",2,0],["صَعبٌ فَإِن سومِحتَ كُنتَ مُسامِحاً","سَلِساً جَريرُكَ في يَمينِ القائِدِ",26,"د",1,0],["صَعُبَت وَراضَ المَزجُ سَيِّءَ خُلقِها","فَتَعَلَّمَت مِن حُسنِ خُلقِ الماءِ",27,"ا",2,0],["صعبٌ على الحرَِ الخضوعُ لناقصٍ","وتحكُّمُ الأسقاط في الأسفاطِ",28,"ط",1,0],["صَعِقَت لِمَوتِكَ دَولةُ الآمالِ","وَجَلائِلِ الآثارِ وَالأَعمالِ",29,"ل",1,0],["صُعقتْ نُفوسُ المشركينَ وهالهم","هَمٌّ إذا انجلتِ الهمومُ أقاما",30,"م",2,0],["صُعِقتُ وَقَد ناجَيتُ موسى بِخاطِري","وَأَصبَحَ طورُ الصَبرِ مِن هَجرِهِ دَكّا",31,"ك",2,1],["صَعودُ فَمَن تُلمِع بِهِ اليَومَ يَأتِها","وَمَن لا تَلَهّى بِالضَحاءِ فَأَورَدا",32,"د",2,0],["صُعرُ السَوالِفِ بِالجِراءِ كَأَنَّها","خَلفَ الطَرائِدِ خَشرَمٌ مُتَبَدِّدُ",33,"د",1,0],["صَعْبٌ إذا نُوَبُ الزمان استصعبتْ","مُتَنَمِّرٌ للحادثِ المُتَنَمِّر",34,"ر",1,0],["صَعصَعَها بِالصَحصَحانِ الجُردِ","وَعاثَ فيها بِفَريغِ الشَدِّ",35,"د",1,0],["صَعباً إِذا لَقى أَبَر","وَإِن هَفا القَومُ وَقَر",36,"ر",1,0],["صَعبٍ لِرائي بابِهِ زَئيرُ","يَنِبُّ عَنهُ الحَوقَلُ القاذورُ",37,"ر",1,0],["صَعباً إِذا كُنتَ لَيناً حينَ تَصدُقُهُ","مِن آلِ نِهيا إِذا زَلزَلتَهُ حادا",38,"د",2,0],["صَعباً مِراراً وَتاراتٍ نُوافِقُهُ","سَهلاً عَلَيهِ رِواقُ المُلكِ وَاللَجِبُ",39,"ب",1,0],["صَعدَةٌ ما عَلا الحَقيبَةَ مِنها","وَكَثيبٌ ما كانَ تَحتَ الحِقابِ",40,"ب",1,0],["صعب فراق أناس","هويتهم أي صعب",41,"ب",1,0],["صعب على فراقي","لأخوتي ورفاقي",41,"ي",1,0],["صعقت تخر إِلى الوجوه حلولها","للصيحة الكبرى بكل مَكان",42,"ن",1,0],["صعاليك سادوا ثم سيدوا بجهلهم","فأذمم بهم من سائد وَمسود",43,"د",1,0],["صعُوداءُ مَنْ تُلْمِعْ بِهِ اليَوْمَ يَأْتِهَا","ومَنْ لاَ تَلَهَّ بِالضَّحَاءِ فَأَوْرَدَا",44,"د",2,0],["صَعِدَتْ إِلَيْهِ مِنَ الْجَمَاعَةِ صَيْحَةٌ","كَادَتْ تُزَلْزِلُ قَصْرَهُ زِلْزَالا",45,"ل",2,0],["صَعْبَانِ رَاضَهُمَا تَوْحِيدُ مَعْشَرِهِمْ","وَأَخْذُهُمْ بَعْدَ إِشْرَاكٍ بِتَوْحِيدِ",46,"د",1,0],["صَعِدُوا للعُلاَ بريشِ نُسورٍ","ومَضَوْا للرَّدَى بِعَزْمِ أسُودِ",47,"د",1,0],["صعب الشكائم في ذات الاله فان","حناهم الحق عن مكروهة لانوا",48,"ن",3,0],["صعب شكائمهم سحب مكارمهم","ان حاربوا صعبوا أو أكرموا هانوا",48,"ن",3,0],["صعدوا في كل هم فكرهم","فاقتنوا حكم ابتداء وخبر",49,"ر",1,0],["صعب الركائب والحمول حديثها","حتى تجاوز للعراق الشاما",50,"م",2,0],["صعرُ الخدودِ وقد باشرنَ هاجرة ً","لكوكبِ من نجومِ القيظِ ملهتب",51,"ب",1,0],["صعب الشكيمة والأعناق مسلسة","قاس من الحقّ لكن لست تنكسر",52,"ر",1,0],["صعب البديهة لا تكبو قوادحهُ","عند الخطاب ولا يعنى بوسواس",53,"س",1,0],["صَعلٌ أَتاهُ بَياضٌ مِن شَواكِلِهِ","جَونِ السَراةِ أَجَشَّ الصَوتِ صَلصالِ",54,"ل",1,0],["صَعبِ المَرامِ يُناغي النَجمَ مَطلَعُهُ","يَسمو إِلى فَرعِ مِجدٍ شامِخٍ سامِ",55,"م",1,0],["صَعبُ القِيادِ إِذا أَرعَيتَهُ أُذُناً","عَلِمتَ أَنّي لِسانٌ وَالزَمانُ فَمُ",56,"م",1,0],["صَعْبُ ابْتِدَاءٍ بِمِيلادٍ وَ أَوَّلُهُ","عِنْدَ انْفعَالِ مَصَاغِ الطَّرْحِ أَعْيَاهُ",57,"ا",2,0],["صُعُدٌ نُحَرِّزُ أهلَنا بفُروعهِ","فيهِ لَنا حرزٌ وعَيَشٌ رافِغُ",58,"غ",1,0],["صعدنَ السطوحَ فكانَ الصعودُ","سعوداً لطالعِ مُشتاقهِنْ",59,"ن",1,0],["صُعُودُ العُلا إِلّا عَلَيكَ حَرامُ","وَعَيشٌ سِوى ما أَنتَ فيهِ حِمامُ",60,"م",1,1],["صعدَتْ به مبهورةً وبها صعَدْ","والصّاعِدون إلى العُلا رُوّادُ",61,"د",1,0],["صَعبُ الشَواهِقِ مُغبَرٌّ بِناكِبِهِ","تَرى بِهِ المُعفَراتِ العُصمَ أَخدانا",62,"ن",2,0],["صعبت فلو فرعون عا","قرها لردّ عصا الكليم",63,"م",1,0],["صعاليكُ إذا ما ميزوهمْ","وكلٌّ في عشيرتهِ أميرُ",64,"ر",1,0],["صعب على الاعداء الا انه","سهل لكل مسالم وحزين",65,"ن",1,0],["صَعبُ المَرامِ وَإِن عَجَم","تَ عَجَمتَ عوداً صُلَّبا",66,"ب",2,0],["صعب القياد كأنما","الجوزا لسابقه عنان",67,"ن",1,0],["صَعيد تظهر البركات منه","وَتَطلع في جوانبه السعود",68,"د",1,0],["صعب علينا رزء فقدك اذ علي","ذو المجد في صحف اللواء دعانا",69,"ن",2,0],["صعَّدتَ أَنفاساً وَجُدتَ بأَدمعٍ","في يومِ محْنتِها فكُنَّ قصائدا",70,"د",2,0],["صعَّدتْ أنفاسَها","حمراً كأنفاسِ السعير",71,"ر",1,0],["صَعَّدَ الزفرةَ حَرّى وَبكى","حينما أَهوى عَلَى ثغرِ القدح",72,"ح",1,0],["صعوبة فهم في ابتداء تعلم","تبشر باستدراك معدن عرفان",73,"ن",1,0],["صعّد الزفرات لا تحبسها","هدأة النفس واطلقها بكاء",74,"ا",2,0],["صَعُبْتَ مَراماً أن تُرينِيكَ يَقظةٌ","فَمن لي بَعْينٍ في المنامِ تَراكا",75,"ك",2,0],["صَعبٌ فَلا تُخاطِروا قِيادُهُ","مَتى أَبى وَمَن يُحامِ يَذُدِ",76,"د",1,0],["صعوده كان من طور الحضيض إلى","طُور السماوات طور العرش في مهَل",77,"ل",1,0],["صعدتِ إلى العلياءِ يا خيرَ كاعبٍ","وليس كإيليّا النبيِّ وبُولُسِ",78,"س",1,1],["صعدت بأمجاد الملائك كلهم","إلى ملجسٍ قد جل عن كل مجلس",78,"س",1,0],["صَعدتُ إليها، سلَّم اللهُ قلبَها","فلا تسألوا عن غيثها كيف يَهْطِلُ",79,"ل",1,0],["صعدت عطرها إلى وقالت :","شرح هذا الذي تريد يطول",80,"ل",1,0],["صَعب الأباء ذَلول الصَفح مُبتَعِدُ","المحلِّ داني النَدى مُستَحكِم المَرَرِ",81,"ر",1,0],["صَعب إِباء النَفس سَهل النَدى","إِنَّ المَعالي شَدَّةٌ في سَماح",82,"ح",1,0],["صَعبُ الإِباءِ إذا ما هِجتَ سَورتَهُ","نزرُ الرِّضا فإذا استَعطَفْتَهُ عَطَفَا",83,"ف",2,0],["صعب على صعب الخطوب وجائر","أبداً على جور الزمان الجائر",84,"ر",1,0],["صعُبَ الأمرُ عليهمْ","قلتُ يا قوم ِ اتركوهُ",85,"و",2,0],["صَعَقْتَ بالنَّصْرِ مثواهُ ومَوْطِنَهُ","فَضُعْضِعَتْ منه غِيطانٌ وأَجْبَالُ",86,"ل",1,0],["صَعْقاً رَم