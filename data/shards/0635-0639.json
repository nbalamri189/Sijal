","الرجز"],[377,"قلب يذوب إلى الأطلال والحلل","https://www.aldiwan.net/poem59287.html","البسيط"],[377,"صعدت إلى العلياء يا خير كاعب","https://www.aldiwan.net/poem59375.html","الطويل"],[400,"في جوف الكعبة","https://www.aldiwan.net/poem6711.html","عموديه"],[400,"حوار مع وردة","https://www.aldiwan.net/poem10297.html","عموديه"],[406,"صددت أن عاد روض الرأس ذا زهر","https://www.aldiwan.net/poem50174.html","البسيط"],[406,"أرحت نفسي من عداة الملاح","https://www.aldiwan.net/poem50195.html","السريع"],[409,"هو الجواد الذي يلقاه مادحه","https://www.aldiwan.net/poem32215.html","البسيط"],[416,"أكرم بطيف خيالكم من زائر","https://www.aldiwan.net/poem54150.html","الكامل"],[427,"ان حظي كدقيق","https://www.aldiwan.net/poem42150.html","عموديه"],[439,"إقبال جدك للإسلام إقبال","https://www.aldiwan.net/poem34829.html","البسيط"],[458,"تمنى رجال أن تزل بي النعل","https://www.aldiwan.net/poem55997.html","الطويل"],[458,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[458,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[461,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[464,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[464,"صعدة القد وسيف الكحل","https://www.aldiwan.net/poem3530.html","عموديه"],[500,"إن معنى الهيام بالأولياء","https://www.aldiwan.net/poem38101.html","الخفيف"],[551,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[558,"صلاتي إليها بل إلي صلاتها","https://www.aldiwan.net/poem33516.html","الطويل"],[558,"أيا ساكنين الشرق قد شرقت بكم","https://www.aldiwan.net/poem34313.html","الطويل"],[561,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[575,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"]],"verses":[["صَعلٍ يَعودُ بِذي العُشَيرَةِ بَيضَهُ","كَالعَبدِ ذي الفَروِ الطَويلِ الأَصلَمِ",0,"م",1,0],["صعْبُ المَقادَةِ في الهَوادةِ والهَوى","سهْلٌ علَى العافِينَ والطُّرّاقِ",1,"ق",1,0],["صَعُبَت وَراضَ المَزجُ سَيِّئَ خُلقِها","فَتَعَلَّمَت مِن حُسنِ خُلقِ الماءِ",2,"ا",2,0],["صَعِدَ الدينُ يَستَغيثُ إِلى اللَ","هِ وَقالَ الأَنامُ قَد ظَلَموني",3,"ن",2,1],["صَعراءُ إِن هِيَ قامَت فَهيَ مائِلَةٌ","وَإِن مَشَت فَهيَ كَالميزانِ مُعتَدِلَه",4,"ل",2,0],["صَعْبُ المِرَاسِ عَلَى الآفَاتِ يُتْعِبُهَا","جَلْدٌ تَقَاذَفُهُ الأَنْوَارُ وَالظُّلْمُ",5,"م",1,0],["صَعلٌ كَسافِلَةِ القَناةِ وَظيفُهُ","وَكَأَنَّ جُؤجُؤُهُ صَفيحُ كِرانِ",6,"ن",1,0],["صَعَّدَهم في كَؤُودِهِ الرَبوَ تَو","هِينُ قُوَىً والسُّعَاةُ لا الوَثَبُ",7,"ب",1,0],["صعدهم في كودة الربو","توهين قوى والسعاة لا الوثب",8,"ب",1,0],["صعدت روحه لأمثالها الزه","ر وفي الأرضِ أين أين أمثاله",9,"ل",2,0],["صَعْبٍ إذا صَعُبَتْ عليه قرينةٌ","حَتَّى تُسمِّحَ أيَّمَا تسميحِ",10,"ح",1,0],["صعبة في الرأس جامحة","سهلة في كل مُزْدَردِ",11,"د",1,0],["صُعرُ الخُدودِ وَقَد باشَرنَ هاجِرَةً","لِكَوكَبٍ مِن نُجومِ القَيظِ مُلتَهِبِ",12,"ب",1,0],["صَعلٌ كَأَنَّ جَناحَيهِ وَجُؤجُؤَهُ","بَيتٌ أَطافَت بِهِ خَرقاءُ مَهجومُ",13,"م",1,0],["صعب علي عبوره","يا رب ثبت ارجلي",14,"ل",2,0],["صَعَدتُم وَما غَيرُ القَنا ثَمَّ مَصعَدٌ","وَلا سُلَّمٌ إِلّا الحَديدُ المُذَرَّبُ",15,"ب",1,0],["صعدت بأجنحة المليكة نح","والجو تبغي عنده أربا",16,"ب",2,0],["صَعِدوا جِبالاً مِن عُلاكَ كَأَنَّها","هَضَباتُ قُدسَ وَيَذبُلٍ وَحِراءِ",17,"ا",2,0],["صُعوبَةُ الرُزءِ تُلقى في تَوَقُّعِهِ","مُستَقبَلاً وَاِنقِضاءُ الرُزءِ أَن يَقَعا",18,"ع",2,0],["صُعِقَ العِدا بلَظاهُما فكأنَّما","كانَا على الأعداءِ صَاعِقَتَيِنِ",19,"ن",1,0],["صَعلٍ كَسافِلَةِ القَناةِ مِنَ ال","مُرّانِ يَنفي الخَيلَ بِالعَذمِ",20,"م",1,0],["صُعرَ الخُدودِ كَأَنَّما","جُنِّحنَ أَجنِحَةَ النُسورِ",21,"ر",1,0],["صَعُبَت فَحَكَّمنا السُقاةَ بِمَزجِها","فَغَدا يَزيدُ بِها المِزاجُ وَيَنقُصُ",22,"ص",1,0],["صَعبُ العَريكَةِ سَهلَةٌ أَخلاقُهُ","قَومٌ بِهِ سَعِدوا وَقَومٌ نُغِّصوا",22,"ص",3,0],["صَعِدَت مَراتِبُ مَجدِهِ فَكَأَنَّما","تَعلو لَهُ فَوقَ المَجَرَّةِ أَخمَصُ",22,"ص",1,0],["صَعبُ القِيادِ فَإِن راضَت خَلائِقَهُ","كَأسُ المُدامِ أَلانَت مِنهُ ما صَعُبا",23,"ب",2,0],["صعدا إلى الآفاق يرتقيان","وتعانقا خلف الغمام وأترعا",24,"ع",2,0],["صَعبِ القَوافي إِلّا لِفارِسِهِ","أَبِيَّ نَسجِ العَروضِ مُمتَنَعِه",25,"ع",2,0],["صَعبٌ فَإِن سومِحتَ كُنتَ مُسامِحاً","سَلِساً جَريرُكَ في يَمينِ القائِدِ",26,"د",1,0],["صَعُبَت وَراضَ المَزجُ سَيِّءَ خُلقِها","فَتَعَلَّمَت مِن حُسنِ خُلقِ الماءِ",27,"ا",2,0],["صعبٌ على الحرَِ الخضوعُ لناقصٍ","وتحكُّمُ الأسقاط في الأسفاطِ",28,"ط",1,0],["صَعِقَت لِمَوتِكَ دَولةُ الآمالِ","وَجَلائِلِ الآثارِ وَالأَعمالِ",29,"ل",1,0],["صُعقتْ نُفوسُ المشركينَ وهالهم","هَمٌّ إذا انجلتِ الهمومُ أقاما",30,"م",2,0],["صُعِقتُ وَقَد ناجَيتُ موسى بِخاطِري","وَأَصبَحَ طورُ الصَبرِ مِن هَجرِهِ دَكّا",31,"ك",2,1],["صَعودُ فَمَن تُلمِع بِهِ اليَومَ يَأتِها","وَمَن لا تَلَهّى بِالضَحاءِ فَأَورَدا",32,"د",2,0],["صُعرُ السَوالِفِ بِالجِراءِ كَأَنَّها","خَلفَ الطَرائِدِ خَشرَمٌ مُتَبَدِّدُ",33,"د",1,0],["صَعْبٌ إذا نُوَبُ الزمان استصعبتْ","مُتَنَمِّرٌ للحادثِ المُتَنَمِّر",34,"ر",1,0],["صَعصَعَها بِالصَحصَحانِ الجُردِ","وَعاثَ فيها بِفَريغِ الشَدِّ",35,"د",1,0],["صَعباً إِذا لَقى أَبَر","وَإِن هَفا القَومُ وَقَر",36,"ر",1,0],["صَعبٍ لِرائي بابِهِ زَئيرُ","يَنِبُّ عَنهُ الحَوقَلُ القاذورُ",37,"ر",1,0],["صَعباً إِذا كُنتَ لَيناً حينَ تَصدُقُهُ","مِن آلِ نِهيا إِذا زَلزَلتَهُ حادا",38,"د",2,0],["صَعباً مِراراً وَتاراتٍ نُوافِقُهُ","سَهلاً عَلَيهِ رِواقُ المُلكِ وَاللَجِبُ",39,"ب",1,0],["صَعدَةٌ ما عَلا الحَقيبَةَ مِنها","وَكَثيبٌ ما كانَ تَحتَ الحِقابِ",40,"ب",1,0],["صعب فراق أناس","هويتهم أي صعب",41,"ب",1,0],["صعب على فراقي","لأخوتي ورفاقي",41,"ي",1,0],["صعقت تخر إِلى الوجوه حلولها","للصيحة الكبرى بكل مَكان",42,"ن",1,0],["صعاليك سادوا ثم سيدوا بجهلهم","فأذمم بهم من سائد وَمسود",43,"د",1,0],["صَعِدَتْ إِلَيْهِ مِنَ الْجَمَاعَةِ صَيْحَةٌ","كَادَتْ تُزَلْزِلُ قَصْرَهُ زِلْزَالا",44,"ل",2,0],["صَعْبَانِ رَاضَهُمَا تَوْحِيدُ مَعْشَرِهِمْ","وَأَخْذُهُمْ بَعْدَ إِشْرَاكٍ بِتَوْحِيدِ",45,"د",1,0],["صَعِدُوا للعُلاَ بريشِ نُسورٍ","ومَضَوْا للرَّدَى بِعَزْمِ أسُودِ",46,"د",1,0],["صعب الركائب والحمول حديثها","حتى تجاوز للعراق الشاما",47,"م",2,0],["صعرُ الخدودِ 