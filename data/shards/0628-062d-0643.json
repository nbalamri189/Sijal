/poem/109400","السريع"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93602","الوافر"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84834","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134018","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130126","البسيط"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104859","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135738","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77115","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72831","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136405",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139627",""],[4679,"أما لأبي البرية أن يعادا","https://www.poetsgate.com/ViewPoem.aspx?id=142720",""],[4578,"حويت المجد بالهمم العلية","https://www.poetsgate.com/ViewPoem.aspx?id=49616",""],[4929,"زهابك الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=202086",""],[4963,"بدو وحضر","https://www.poetsgate.com/ViewPoem.aspx?id=5778",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5190,"فاقرأني على مهل","https://www.poetsgate.com/ViewPoem.aspx?id=129791",""],[5463,"بنت حمران النواظر","https://www.poetsgate.com/ViewPoem.aspx?id=30882",""],[5690,"هي التهاني لقطر الشام نهديها","https://www.poetsgate.com/ViewPoem.aspx?id=172191",""],[5847,"حينما بكت عمان .!!","https://www.poetsgate.com/ViewPoem.aspx?id=208953",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["بِحُكْمِهِ يَسَّرَ اللهُ القِوَى لَنَا","مَا لَمْ يُيَسِّرْ لأَقْوَامٍ وَأَوْطَانِ",0,"ن",1,0],["بِحُكمِكَ في حَيَّي قُرَيظَةَ بِالَّذي","قَضى اللَهُ فيهِم ما قَضَيتَ عَلى عَمدِ",1,"د",1,0],["بِحُكمِ الَّذي فَوقَ السَمَواتِ عَرشُهُ","بِما في ثَرى سَبعٍ مِنَ الأَرضِ عالِمِ",2,"م",1,0],["بِحُكمِ زمانٍ يا لهُ كيفَ يحكمُ","يُحرّمُ أوطاناً علينا فَتَحْرُمُ",3,"م",1,1],["بِحِكمَةِ خالِقي طَيّي وَنَشري","وَلَيسَ بِمُعجِزِ الخُلّاقِ حَشري",4,"ر",2,1],["بِحِكْمَةِ مَنْ يُعِدُّ لِمِصْرَ هَاماً","وَمَنْ يَبْنِي لَعَزَّتِهَا قُلُوبَا",5,"ب",2,0],["بحكم بنات الدهر فارقت إلفها","وسلني عنها لم اضق عن جوابها",6,"ب",3,0],["بحكم الأبيض الهنديّ","أو بالأسمر اللَّدِنِ",7,"ن",1,0],["بحكم الرومِ جلَّ الخطبُ حتى","بَكى عرفاتُ والبيتُ العتيق",8,"ق",1,0],["بِحكمته أبان لَنا عُلوماً","أَخَذنا مِن لَطائِفِها فُنونا",9,"ن",2,0],["بحكمة وبعلم كان مبتدئاً","هذا الوجود الذي حارت له الفطن",10,"ن",1,0],["بحُكْمِكَ زالَ الظلمُ وابتَسَم العَدلُ","وفي سَيْفكَ الماضي وفي قولك الفِعْلُ",11,"ل",1,1],["بحكمِ الرَّشيدِ مشيرِ العراق","ملاذ الطريد مجيرِ الرَّشيدْ",12,"د",1,0],["بحكمةٍ لقبوه وهو ذو حكمٍ","والمرءُ من لقبٍ معناه قد زكنا",13,"ن",2,0],["بِحُكْمِ العَدْلِ من قاضِي السَّماءِ","حباكَ بِحَقِّ أَحكامِ القَضاءِ",14,"ا",2,1],["بحكم مولىً لم يَزل حُكْمُه","يُنزلُ لي دهْرِي على حُكْمي",15,"م",2,0],["بحكمة ربنا عدلاً وعلماً","بأحوال الخلائق في المآل",16,"ل",1,0],["بِحِكمَةٍ أَلفَت تبنى مرصفةً","نَعم وجَانبَها التبذيرُ وَالسّرفُ",17,"ف",1,0],["بحكمة قاضية","بالفهم في كل بليد",18,"د",1,0],["بحكم الولا جردت قصدي وحبذا","موال ارواح القلب منه ولاؤه",19,"ا",3,0],["بحكمتك افتح لي من الخير حكمة","فإن قرار الخير حيث استقرت",20,"ت",1,0],["بحكم \"الدلال\" الجور حُكِّم جورُه","ومن شأنه ألا قرينَ يردُّه",21,"د",2,0],["بحكمته ارتقت عرش المعالي","إماراتُ الخليج الشامخاتُ",22,"ت",1,0],["بحكمة قائدٍ أطفأت حربا","فمدَّ السلم موفور الظّلال",23,"ل",1,0],["بحكم صحيحة مرضيه","قدمتها بصفة الهديه",24,"ه",1,0],["بحكمة الإشراق تروي لنا","عن فكر عبد الله سامي المقام",25,"م",1,0],["بِحكمك لَم تنلهم كف جانٍ","كَأن البر مَضروب بِسور",26,"ر",1,0],["بحكمك يا خَير القُضاة سَما العَدل","وَأَحييت فينا رُوحَهُ فلك الفَضل",27,"ل",1,1],["بحكم وعدل نال داود رتبة","لوا مرتقيها اليوم يزداد في الغد",28,"د",1,1],["بِحُكمِ شهمٍ كريم عن محاسنهِ","كَلَّ الجَنانُ وفاق الحصر علياهُ",29,"ا",2,0],["بحكمك كيف شئت تحكم في الورى","ونسألك اللهم نشر الهداية",30,"ه",1,0],["بحكم المجد من ندب وفرض","ولا ترضى ببعض دون بعض",31,"ض",1,0],["بحَكَمٍ ومالك الملكِ احكُما","لنا بخير وبفضلٍ احكما",32,"م",2,0],["بحكم آل الخلد هكطور هجم","فمن يلومني إذا ألوى القدم",33,"م",1,0],["بِحُكمِكَ الجائِرُ نَحنُ نَرضى","فَاِحكُم وَخُذ وَأَدِّ هذا البَعضا",34,"ض",2,0],["بحكم جديدٍ جاء في السعد مقبلُ","بتكميلِ أفراحِ الأنامِ مبشر",35,"ر",1,0],["بحكمة قد جرت احكامه وبها","كل الأوامر بين الناس يجريها",36,"ي",3,0],["بحكم هدىً في البر والبحر نافذٍ","وفيض ندى في الشرق والغرب نافده",37,"د",2,0],["بحكمته برا كل البرايا","وفي تكوينها طراً أجادا",38,"د",2,0],["بحكمك ثغر بيروت تجلى","يباهي بالثنايا اللؤلؤ يه",39,"ي",2,0],["بحكمة في سواه ضل قاصدها","تنوعت بهدى الحيران إدلالا",40,"ل",2,0],["بحكم الشريعه والعدل شرفتنا","الشعب واحد بالحقوق انتساوه",41,"ا",3,0],["بحكم تجلي الحق سائر شأنه","فلم يبرم الا ما المهيمن أبرما",42,"م",2,0],["بُحْ كَيفَ شِئتَ بِمَا يُضنِيكَ مِن وَلَهٍ","وكُنْ قَرِيباً إَذَا مَا هَدَّكَ البُعدُ",43,"د",1,0],["بحكي عن قلب(ن) تملّك قلبي المغرم وجال","بين سكاّت المحبّه اللي بشرياني النحيل",44,"ل",1,0],["بحكة سطعت منه شمس فكرتهِ","فأرسلت للورى جدوى معانيها",45,"ي",3,0],["٢٢- بحكمةٍ بين ساداتٍ همو أملٌ","وكل فردٍ بهم نارٌ على علمِ",46,"م",1,0],["بحكمة اللّه الحكيم البالغه","بحجة اللّه الولي الدامغه",47,"ه",1,0]]}