{"poems":[[90,"حي هل يا أخا مصر","https://www.aldiwan.net/poem44435.html","مجزوء الخفيف"],[51,"شرهت فلست أرضى بالقليل","https://www.aldiwan.net/poem63059.html","الوافر"],[190,"شره الإنسان يقتله","https://www.aldiwan.net/poem43435.html","المديد"],[190,"شرهي يدافع بي إلى الطمع","https://www.aldiwan.net/poem43626.html","الكامل"],[580,"رحلوا فلست مسائلاً عن دارهم","https://www.aldiwan.net/poem2861.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122780","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122681","الكامل"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26470","الكامل"],[2053,"","https://poetry.dctabudhabi.ae/diwan/poem/132441","الرجز"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140006","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89161","الخفيف"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52976","المتدارك"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62838","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109899","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54503","الكامل"],[4791,"مجرد التفكير","https://www.poetsgate.com/ViewPoem.aspx?id=36906",""],[5039,"الدلع بألف خير","https://www.poetsgate.com/ViewPoem.aspx?id=48119",""],[5434,"الله من عين طرقها صواديف","https://www.poetsgate.com/ViewPoem.aspx?id=37610",""],[5648,"يبقا سلام الله لو الجرح ماطاب","https://www.poetsgate.com/ViewPoem.aspx?id=155217",""]],"verses":[["شرّهم غير محتمل","خيرهم غير منتظر",0,"ر",1,0],["شَرِهتُ فَلَستُ أَرضى بِالقَليلِ","وَما أَنفَكُّ مِن حَدَثٍ جَليلِ",1,"ل",1,1],["شره الإنسان يقتله","والذي ولاه يعزله",2,"ل",2,1],["شرهي يدافع بي إلى الطمع","والحرص يدفع بي إلى الورع",3,"ع",1,1],["شَرِهَتْ نَوَاهُم فاغْتَدَتْ بِرجالهم","ونِسائهم وصغارِهم وكبارِهم",4,"م",1,0],["شَرِّهٌ لِنَيلِ المَجدِ مَنهُومٌ بِهِ","فاعجَب عَلَى شَرِهٍ بِهِ مَنهُومِ",5,"م",1,0],["شَرهٌ إذا قيلَ اتَّئِد جُزتَ المَدَى","تَحكي شَمائلُه الشَّمُولَ القَرقَفا",6,"ف",2,0],["شره بارد وحرص على الأك","ل بأنا قوم من المجان",7,"ن",1,0],["شَرِهاً إِذا ذُكِرَ المَكارِمُ وَالعُلا","ذَكَرَ القَلايا مُبدِئاً وَمُعيدا",8,"د",2,0],["شرّهم العمُّ ونجل العمِ","والخال والخالة وابن الأمّ",9,"م",1,0],["شرهتُ إلى الدنيا ولو كنتُ عالماً","بها لم تكن هشاً إليها ولا بشا",10,"ش",2,0],["شرهُ الشهوتين كالقرد لكن","ن له لحيةً كذيل البعيرْ",11,"ر",1,0],["شَرَّة الأغراب وقد سُقيت","أكوابَ طِلاحبِّ العمران",12,"ن",1,0],["شَرِهْتُ إلى البقاءِ وكان لوماً","وهل لي بعدَ فَقدِكُمُ بَقاءُ",13,"ا",2,0],["شِرَّةُ الأَسبابِ في كُلِّ امرِئٍ","قُوَّةُ الشَهوةِ ثُمَّ الغَضَبِ",14,"ب",1,1],["شَرَهي على العلياءِ جَرَّ معاطبي","أَمِنَ المعاطبَ كلُّ مَنْ لم يَشْرَهِ",15,"ه",1,0],["شرهة محبٍ ما تفارق وطنها","في خاطري تكبر ولا به مراوات",16,"ت",1,0],["شرّهي ظل ظلك للنهار الفقير","خيطي برمش عينك ليلٍ أبلاه ياس",17,"س",1,0],["شره قناطير وخيره مقاطيف","يفطن له اللي يرضع الديد غافي",18,"ف",2,0],["شرهتك للي لو تمره عضدها","اما طلبك الحق ولا لها جاب",19,"ب",1,0]]}