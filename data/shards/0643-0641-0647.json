{"poems":[[53,"قينة عند خالد","https://www.aldiwan.net/poem64531.html","مجزوء الخفيف"],[255,"سار والقلب في يديه مقيم","https://www.aldiwan.net/poem15026.html","الخفيف"],[398,"أنا من شيعة الرضا","https://www.aldiwan.net/poem53655.html","مجزوء الخفيف"],[435,"سد مقاما وعزة وكمالا","https://www.aldiwan.net/poem40775.html","الخفيف"],[438,"أيها اللائم لم غي","https://www.aldiwan.net/poem12544.html","مجزوء الرمل"],[469,"ما على الركب من تلافي تلافي","https://www.aldiwan.net/poem3215.html","عموديه"],[519,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[563,"نورطه المصطفى منه جيمع الكائنات","https://www.aldiwan.net/poem34720.html","الرمل"],[563,"كفة الغيب كفة الحسنات","https://www.aldiwan.net/poem34721.html","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62460","الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120048","الخفيف"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144079","الخفيف"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50018","المتدارك"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114027","الرمل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132384","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93827","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93813","البسيط"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104676","الخفيف"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76543","المديد"],[3244,"","https://poetry.dctabudhabi.ae/diwan/poem/199142","الرمل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85235","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103053","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4691,"السيد المقيم 2","https://www.poetsgate.com/ViewPoem.aspx?id=175081",""],[4767,"جرح لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=215436",""],[5033,"عاشقٌ ليسَ إلّا","https://www.poetsgate.com/ViewPoem.aspx?id=183177",""],[5122,"(( يامضيع العشاق..1))","https://www.poetsgate.com/ViewPoem.aspx?id=27095",""],[5434,"بالسلك يندار","https://www.poetsgate.com/ViewPoem.aspx?id=37624",""],[5672,"كف....في ذكرى الطفوف","https://www.poetsgate.com/ViewPoem.aspx?id=206556",""],[5848,"الذيابه تعاوي","https://www.poetsgate.com/ViewPoem.aspx?id=53449",""],[5956,"نجلي وأصحابه وموظفوه","https://www.poetsgate.com/ViewPoem.aspx?id=193289",""],[5956,"ليَ نجلٌ وأصدقاء","https://www.poetsgate.com/ViewPoem.aspx?id=193641",""],[5970,"آه لو كانت تفيد النفس آه","https://www.poetsgate.com/ViewPoem.aspx?id=130619",""]],"verses":[["كفُّها طولَ دهرها","قفلُ أيرٍ محاجِزه",0,"ز",2,0],["كَفُّهُ زمزمٌ تفيضُ على العَّا","فين جودا والمال فيها الحَطيمُ",1,"م",1,0],["كفُّهُ كَفَّت الخُطو","بَ وَكانَتُ مظَفَّرَه",2,"ر",2,0],["كفه أغنت الفقير بجودٍ","وبحربٍ قد أفنت الأبطالا",3,"ل",2,0],["كفُّه بالمالِ حقاً","لا تقُلْ زوراً ومَيْنا",4,"ن",2,0],["كفه والحسام غيث على","الأبطال يسطو ببارق خطاف",5,"ف",1,0],["كفُّها كافِلُها عِصمَتُها","من أذى الدّهرِ إذا الدّهرُ دَهاها",6,"ا",3,0],["كفه غيث مغيث لقلوب المتقين","ومزيل عطش الأمة يوم الحسرات",7,"ت",1,0],["كفة الغيب كفة الحسناتِ","وهو في الكون كفة السيئاتِ",8,"ت",1,1],["كفُّهُ هامٍ وأمَّا سيفه","فهو ظامٍ يبتغي نهر الكَبدْ",9,"د",1,0],["كفه بالنوال اسمح للعا","فين من صوب واكف غيداق",10,"ق",1,0],["كفّهُ للنّدى كما عِرضُه الطّا","هرُ للمدحِ والثّناءِ ربيطُ",11,"ط",1,0],["كَفُّهُ أَبداً مُسْتَهلُّ ندىً","لم يفُت أَحداً صوبُها الهَطِلُ",12,"ل",1,0],["كَفُّهُ عن شُحّ نَولٍ يجره","كفُّهُ عَن شُحّ بَذلٍ ما جَمَد",13,"د",1,0],["كفُّهُ كهفُهُ نداهُ سَنَاهُ","كعبةٌ للرِّجال والرُّكبانِ",14,"ن",1,0],["كفه المفضال فينا","بحر جود فاض عن بر",15,"ر",1,0],["كفٌ هو الكوثر السلسال في رغب","لكنه برثن الضرغام في رهب",16,"ب",1,0],["كَفُّهُ الرَحبُ سَمحا","وَبِهِ الذَنبُ يُمحى",17,"ا",1,0],["كَفّهُ بَحرٌ فَتَتحِفُنا","بِاللآلي حينَ نَلثِمُها",18,"م",3,0],["كفه الغيث على الناس همى","فأعاد الخصب بعد اليَبَس",19,"س",1,0],["كفه عارض جود هاطل","جادباً لجود فلا يعروه شح",20,"ح",1,0],["كفه الريح في السماح وأما","ضربها في الوغى فدك الجبال",21,"ل",1,0],["كفة الرجحان فوسيذ أمال","ذاك آياس على هرتيس",22,"س",1,0],["كفّها لي مدينةٌ من نعيم ٍ","وجحيمٍ فليس َ منها نزوحُ",23,"ح",1,0],["كفٌّ هنا وهناك أخرى لم تزل","والكلُّ أُذنٌ شأنُها الإصغاء",24,"ا",2,0],["كَفُّهَا يَنْزُفُ الحَيَاءَ نَزِيفَاً","بَيْنَ كَفَّيَّ بلّلَ الوَجْدَ بَلَّا",25,"ل",2,0],["كفه عن ألخده على يمين ويسار","خل النسيم يداعبه فوق ويطير",26,"ر",1,0],["كفه بخيل وقلبه انجس من الفار","اسود طرف وادغم من السرمدالي",27,"ل",2,0],["كفٌّ همتْ بدماءٍ ملؤُهنَّ نوىً","لها فؤادُ سبايا الخدرِ كمْ تهفو",28,"ف",2,0],["كفة غرامي مع جروحي تساوى","لاشك صوتي مالقى من يناديه",29,"ي",2,0],["كفّهُ تعمل بالتطويرِ فيهم","دون مَنٍّ أو أذى أو منتظَرْ",30,"ر",1,0],["كفّهُ تعمل بالإحسان فيهم","دون مَنٍّ أو أذى أو منتظَرْ",31,"ر",1,0],["كفهم صفر ولكن بعضهم","يحسد البعض لما ضمت يداه",32,"ا",2,0]]}