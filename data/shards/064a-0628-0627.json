com/ViewPoem.aspx?id=180281",""],[5219,"سهم اللحاظ","https://www.poetsgate.com/ViewPoem.aspx?id=197682",""],[5277,"مطرٌ.. ولاتَ سحاب","https://www.poetsgate.com/ViewPoem.aspx?id=201052",""],[5279,"الصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=215615",""],[5282,"الباقيات الصالحات","https://www.poetsgate.com/ViewPoem.aspx?id=214999",""],[5327,"حزبُ الضِّرار","https://www.poetsgate.com/ViewPoem.aspx?id=147708",""],[5365,"عصف روح","https://www.poetsgate.com/ViewPoem.aspx?id=190405",""],[5376,"لنا في الشامِ أشواقٌ وعشقُ","https://www.poetsgate.com/ViewPoem.aspx?id=188345",""],[5376,"مسلمو بورما لا بواكي لهم","https://www.poetsgate.com/ViewPoem.aspx?id=188478",""],[5419,"وهل في الشعر يا أم ارحميني ؟","https://www.poetsgate.com/ViewPoem.aspx?id=32254",""],[5431,"ويدعوني إليه أجيء سعيا","https://www.poetsgate.com/ViewPoem.aspx?id=186957",""],[5431,"واعتصموا بحبل الله ...","https://www.poetsgate.com/ViewPoem.aspx?id=206863",""],[5431,"حب بدائي...","https://www.poetsgate.com/ViewPoem.aspx?id=215203",""],[5436,"قصيدة أسدلوا الستار","https://www.poetsgate.com/ViewPoem.aspx?id=36243",""],[5444,"صلوات على أعتاب بيت المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=205077",""],[5533,"زَفَاف","https://www.poetsgate.com/ViewPoem.aspx?id=179727",""],[5561,"الحريّة","https://www.poetsgate.com/ViewPoem.aspx?id=193313",""],[5582,"أَحَلَّكَ فِي أَسْرِ الغَرامِ حُلاحِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187218",""],[5749,"كفى حوادث","https://www.poetsgate.com/ViewPoem.aspx?id=140336",""],[5751,"طارئ المجد","https://www.poetsgate.com/ViewPoem.aspx?id=214784",""],[5768,"لِسانُ الضَّادِ فَخْرُ البلادِ !","https://www.poetsgate.com/ViewPoem.aspx?id=215276",""],[5786,"يميناً بها إن كنت للصبّ مُسعِدا","https://www.poetsgate.com/ViewPoem.aspx?id=50660",""],[5804,"سوريا","https://www.poetsgate.com/ViewPoem.aspx?id=180088",""],[5823,"أيا موت زر","https://www.poetsgate.com/ViewPoem.aspx?id=59147",""],[5843,"البحرين","https://www.poetsgate.com/ViewPoem.aspx?id=51289",""],[5843,"قلوب احباب","https://www.poetsgate.com/ViewPoem.aspx?id=51295",""],[5873,"إراقة العشق","https://www.poetsgate.com/ViewPoem.aspx?id=215354",""],[5897,"الحياء في لحظات الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=157485",""],[5957,"غدير مدادك كم يبهر","https://www.poetsgate.com/ViewPoem.aspx?id=186315",""],[5997,"أَعزِّيُّكِ يَا صَنْعَاء","https://www.poetsgate.com/ViewPoem.aspx?id=214288",""],[6031,"أَمَا لفراقِنا هذا اجتماعُ","https://www.poetsgate.com/ViewPoem.aspx?id=46298",""],[6070,"وفي ملجإِ الأيتامِ إذْ نامَ حالما","https://www.poetsgate.com/ViewPoem.aspx?id=191614",""],[6078,"صمتُ الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=203262",""],[6117,"أَوْرَاقُ مُسَافِرْ","https://www.poetsgate.com/ViewPoem.aspx?id=182787",""],[6124,"أراك","https://www.poetsgate.com/ViewPoem.aspx?id=102714",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[463,"وكالرقمِ يحسبه من قرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59988&r=&rc=44",""],[6262,"صديقي الوطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80127&r=&rc=25",""],[2220,"إذا جاءتِ الأسماء يقدمُها الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11859&r=&rc=728",""]],"verses":[["يُباعُ بِسَومِكَ حَبُّ القُلوبِ","وَتَغلَقُ عِندَكَ أَثمانُهُ",0,"ن",2,0],["يُبارينَ نَفّاحَ الخُزامى عَشِيَّةً","بِأَطيَبَ مِن ريحِ الخُزامى وَأَنعَمِ",1,"م",1,0],["يُباعِدُ عَنّي مَن غَرامي لِأَجلِهِ","وَيَقرُبُ مِن قَلبي لَهُ غَيرُ وامِقِ",2,"ق",1,0],["يُباهي بها الليْلُ النّهارَ فشُبْهُهُ","عُقودٌ ومِن عَيْنِ الغَزالَةِ أحْجالُ",3,"ل",1,0],["يُبادِرن جَرعاً يُواتِرنَهُ","كَقَرعِ القَليبِ حَصى القاذِفينا",4,"ن",2,0],["يُبادِرُ بِالكَيِّ قَبلَ الضَمادِ","وَيُسعِطُ بِالسَمِّ لا بِالحُضَض",5,"ض",1,0],["يُباري الخَنوفَ المُستَقِلَّ زِماعُهُ","تَرى شَخصَهُ كَأَنَّهُ عودُ مَشجَبِ",6,"ب",1,0],["يُباري شَباةَ الرُمحِ خَدٌّ مُذَلَّقٌ","كَصَفحِ السِنانِ الصُلَّبِيِّ النَحيضِ",7,"ض",1,0],["يُباشِرنَ فَأرَ المِسكِ في كُلِّ مَهيجٍ","وَيُشرِقُ جاديٌّ بِهِنَّ مَفيدُ",8,"د",1,0],["يُبَارِكَ لِلْحِجَى وَالطُّهْرِ فِيهِ","وَقَدْ ضَمَّتْهَا حِلَّةُ الاقْتِرَانِ",9,"ن",1,0],["يُبايِتُهُ فيها أَحَمُّ كَأَنَّهُ","إِباضُ قَلوصٍ أَسلَمَتها حِبالُها",10,"ل",3,0],["يُبادِرنَ أَن يُبرِدنَ أَلواحَ أَنفُسٍ","قَليلٍ مِنَ الماءِ الرَواءِ دِخالُها",10,"ل",3,0],["يُبارينَ الشَبا وَتَزورُ لَيلى","جُبَيراً وَهيَ ناجِيَةٌ مَعودُ",11,"د",1,0],["يُباري الريحَ لَيسَ بِجانِبِيٍّ","وَلا دَفِنٍ مُروءَتُهُ لَئيمِ",12,"م",1,0],["يُبارينَ الأَسِنَّةِ مُصغِياتٍ","عَلى أَكتافِها الأَسَلُ الظِماءُ",13,"ا",2,0],["يباكرنَ فينا نجعةَ العتبِ بيننا","كما انتجع الوِردَ العِطاشُ اللواهثُ",14,"ث",1,0],["يُباري الرياح بمثل الرِّيا","حِ من كاذبات مواعيدِهِ",15,"ه",1,1],["يباشر الجلد دونَ العِرض مِيسمُها","وَتلزم المرءَ ما لا تلزم النُبَز",16,"ز",1,0],["يُبادر في قلِع الطعام كأنه","وكيلُ يتيم أو مُريبٌ على نَبش",17,"ش",1,0],["يباشر شوك القنا حاسراً","ويلبس دون اللسان الحلق",18,"ق",1,0],["يُباعُ النفيسُ بما دونَهُ","لإيثار مستسلفٍ عاجلِ",19,"ل",1,0],["يبادرُ إلا أنّه غيرُ مرهَق","ويملي فلا الإمهال إذ ذاك إهمالُ",20,"ل",1,0],["يبادلُ أعلاقَ المظنّةِ تحتهُ","رِجالٌ عِدىً يا للعدو المبادَلِ",21,"ل",1,0],["يباشرُ أطرافَ القنا وهْو حاسرٌ","ويلقى لسانَ الذمّ وهْو مُلَأَّمُ",22,"م",1,0],["يُبادِرُ أن يَصِلَّ المالُ حتى","كأنَّ المالَ يملكه لِحامُ",23,"م",1,0],["يُباعِدُهُ مِنهُ الجَناحُ وَتارَةً","يُراوِحُ بَينَ الخَطوِ وَالحَجَلانِ",24,"ن",1,0],["يُبايِعُ بِالكَفِّ الَّتي قَد عَرَفتَها","وَفي قَلبِهِ ناموسُهُ وَغَوائِلُه",25,"ل",2,0],["يباع ويشرى الشعب في سوق","ببخس من الاثمان والشعب لا يدري",26,"ر",2,0],["يُباعِدنَ حِبّاً يَجتَمِعنَ وَوَصلُهُ","فَكَيفَ بِحِبٍّ يَجتَمِعنَ وَصَدُّهُ",27,"د",2,0],["يُباشِرُ الأَمنَ دَهراً وَهوَ مُختَبَلٌ","وَيَشرَبُ الخَمرَ حَولاً وَهوَ مُمتَقَعُ",28,"ع",1,0],["يُبادِرُ غاياتٍ مِنَ المَجدِ طَوَّحَت","بِهِ خَلفَ غاياتِ الرِياحِ العَواصِفِ",29,"ف",1,0],["يُبادِرُ ما تَهواهُ حَتّى يَجيئَهُ","تَوَخٍّ فَيُمضي أَو تَقولُ فَيَفعَلُ",30,"ل",1,0],["يُبادِرُها كِنَّ الكَنيفِ إِمامُها","كَما حَثَّ رَكضاً بِالسَرايا مُغيرُها",31,"ر",3,0],["يُبادِرُكَ الخَيلَ الَّتي مِن أَمامِهِ","لِيَشفِيَ مِنكَ المُؤمِنينَ وَيَثأَرا",32,"ر",2,0],["يُبادِرنَ جُنحَ اللَيلِ بيضاً وَغُبرَةً","ذُعِرنَ بِها وَالعيسُ يُخشى كَلالُها",33,"ل",3,0],["يباكر بالصيد سربَ القطا","وبَينَهُماْ كلّ فجٍّ عميق",34,"ق",1,0],["يُبادِرُها غَيرَ ذي رَعدَةٍ","إِذا اِستَوهَلَ الراجِفُ المُقشَعِرّْ",35,"ر",1,0],["يُباعِدْنَ ما بَينَ الجَماجمِ والطُّلى","فتَدنو مَرَورَاتٌ بها ودكادِك",36,"ك",1,0],["يُباكِرُنا النَوروزُ في غَلَسِ الدُجى","بِنَورٍ عَلى الأَغصانِ كَالأَنجُمِ الزُهرِ",37,"ر",1,0],["يُباكِرُ جَيبَهُ فَيَصيدُ مِنهُ","وَلا يَبغي عَلَيهِ مَن يَحوشُ",38,"ش",1,0],["يبادر الأجلَ الوقعُ","منه من قبل يقدر",39,"ر",1,0],["يُباكِرونَ بِأَلبابٍ وَإِن خَلُصَت","مَعصِيَّةٍ وَبِأَهواءٍ مُطاعاتِ",40,"ت",1,0],["يُباكِرُ ظالِمٌ جَنَفاً وَعَرّاً","كَما بَكَرَ الظَليمُ عَلى العِرارِ",41,"ر",1,0],["يُباكِرُنا الجَونُ المُضيءُ فَيَنقَضي","وَيَعقُبُنا مِنهُ الأَحَمُّ الدُلامِسُ",42,"س",1,0],["يُباكِرُ الصَيدَ بِالمَذاكي","فَيَأنَسُ الموحِشُ الهَبيطُ",43,"ط",1,0],["يُبايِنُ شَكلٌ غَيرَهُ في حَياتِهِ","فَإِن هَلَكا لَم تُلفِ بَينَهُما فَرقا",44,"ق",2,1],["يُبادِرنَ أَبوابَ الحِجالِ كَما مَشى","حَمامٌ ضُحىً في أَيكَةٍ وَفُنونِ",45,"ن",1,0],["يُبالِي فِي الصَّدَاقَةِ كُلَّ شيءٍ","وَقَدْ يَلْقَى الخُطُوبَ فَمَا يُبالِي",46,"ل",2,0],["يباع الخبز في بيتي","لتزمير وتطبيل",47,"ل",1,0],["يُبادِرُني حُمَيدَةُ كُلَّ يَومٍ","فَما يولي مُعاوِيَةَ بنَ عَمروِ",48,"ر",2,1],["يبادر الكيس أخرى عمره","فيرقع الخرق ويوثق العرى",49,"ا",1,0],["يباشرون الوغى بلقا خيولهم","صفرا عمائمهم في قالب البشر",50,"ر",1,0],["يُباع لتسديد الضرائب مِلْحَفٌ","وباقي رِتاج أو حصير مثلَّم",51,"م",1,0],["يُبَادِرُ مَا تَهْواهُ حتّى يَجيئَهُ","تَوَخٍّ، فيَمضِي أوْ يقُولُ فيَفعَلُ",52,"ل",1,0],["يباعدني في الملتقى، وفؤاده","وإن هو أبدى لي البعاد قريب",53,"ب",1,0],["يُباشرْنَ فأرَ المِسْكِ في كُلِّ مهجَعٍ","ويُشرقُ جاديٌّ بهنَّ مفيدُ",54,"د",1,0],["يباعد النفس عن ادراكها ملق","والنفس مغرورة ممن يداجيها",55,"ي",3,0],["يُبادِرنَ الدُموعَ عَلى عَدِيٍّ","كشنٍّ خانَهُ خَرزُ الرَبيبِ",56,"ب",1,0],["يُبارِي الخَنوفَ المُسْتَقلَّ زِماع