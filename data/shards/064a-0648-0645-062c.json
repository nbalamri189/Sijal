poetry.dctabudhabi.ae/diwan/poem/136676",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72786","الخفيف"],[4924,"ظلم الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=19694",""],[5055,"ضرب الجوازي","https://www.poetsgate.com/ViewPoem.aspx?id=110085",""],[5121,"يا طلّة الصّبح","https://www.poetsgate.com/ViewPoem.aspx?id=215605",""],[5225,"مدارات","https://www.poetsgate.com/ViewPoem.aspx?id=36080",""],[5409,"علموا الميسر العروب وقالوا","https://www.poetsgate.com/ViewPoem.aspx?id=155317",""],[5434,"البسيطا","https://www.poetsgate.com/ViewPoem.aspx?id=139690",""],[5756,"الليالي السرمدية","https://www.poetsgate.com/ViewPoem.aspx?id=5438",""],[5997,"العنابه","https://www.poetsgate.com/ViewPoem.aspx?id=214232",""],[6056,"شمس حبي","https://www.poetsgate.com/ViewPoem.aspx?id=130140",""],[463,"يذنب دهرٌ ويستقيلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60272&r=&rc=328",""]],"verses":[["يوم جاءوك في المطاف ببيت الل","ه تسعى وتذكر اللّه جهرا",0,"ر",2,0],["يوم جاء الصَّفَّارُ تكنُفُهُ الكُفْ","فارُ حُمر العيون صُهب السبالِ",1,"ل",1,0],["يَومَ جاشَ الهَولُ في أَرجائِها","فَاِتَّقَتهُ بِالشَبابِ الناهِضينْ",2,"ن",1,0],["يومَ جاءَت غَضْبَى تقولُ أفي مِث","لِيَ مِنْ أحمدٍ يُقالُ الهِجَاءُ",3,"ا",2,0],["يوْمُ جَثَا التاريخ فيه مَدوِّناً","للّه ما قَدْ ضَمَّتْ الأَسْفارُ",4,"ر",1,0],["يوم جئنا الملتقى لم ندر من","أين جئنا وإلى أين أتينا",5,"ن",2,0],["يومٌ جديرٌ بتعظيمِ الأنامِ لَهُ","فَمَا يقاسُ بِهِ في حسنِهِ عِيدُ",6,"د",1,0],["يومٌ جلا غرّةً في المجدِ سائلةً","تناظرُ الشمس إن قاسوا بها الغُرَرا",7,"ر",2,0],["يَؤُمُّ جنابَ عليّ الجناب","ومن حقّ حضرته أن تُؤَم",8,"م",1,0],["يومٌ جديدٌ يردُّ غضّاً","من ملككم ما جنَى الذُّبولُ",9,"ل",1,0],["يومٌ جوادٌ حكاك حتّى على ال","تُربِ حُلى من جداه أو خِلعُ",10,"ع",1,0],["يوم جلت فيه الإمامة عزها","ولها الملائكة الكرام جنود",11,"د",1,0],["يَومَ جُراشَةَ إِذ شَيبانُ موجِفَةٌ","يَنجونَ مِنكَ بِشِلوٍ مِنهُ مَقدودِ",12,"د",1,0],["يومٌ جَرَى منهُ نحوَ المُلكِ صاحبُهُ","جَرْيَ البُدُورِ إلى نُورٍ منَ الغُرَرِ",13,"ر",1,0],["يَوْمَ جُنْدُ الظَّالِمينَ بَدَا","وَبَنى لِلبَغْيِ مَا وَعَدا",14,"ا",1,0],["يؤم جيشا عرمرما لجبا","قد طبق الارض عظم وطأته",15,"ت",2,0],["يوم جَوّ بلادنا حر وقهر","والمصيف بدارهم جوٍّ مطير",16,"ر",1,0],["يومَ جاءوا تَحُثُّهُم جبَروتٌ","بحُنَينٍ لحَينهِم وانتِخاءُ",17,"ا",2,0],["يوم جاءت ترجو بأن تطمس ال","دين وقد خيب الحسام رجاها",18,"ا",3,0],["يوم جاءت تنث من كل عضو","حسرة للمعاد لا تتناهى",18,"ا",3,0],["يوم جاءت تطوي الدياميم","والجيش إلاَّ نوتى محدق بازاها",18,"ا",3,0],["يوم جاءت ولا ترى الشرك إلاّ","بشِبا سيفها ونشر لواها",18,"ا",3,0],["يوم جاءت صفاً ككهان موسى","فدهاها أشدّ مما دهاها",18,"ا",3,0],["يوم جاءوهُ بالقميصِ عِشاءً","وعليه للإفكِ تجري دماء",19,"ا",2,0],["يوم جاني الصبح همّي ما برد","مِ المفارق كل ما جا له يزود",20,"د",1,0],["يومَ جرى طائرُ النَّحوس لهم","يُنزَعُ منه القِرطاسُ والقَلَمُ",21,"م",1,0],["يومٌ جليلٌ قَلّ فيهِ الناصرِ","وقد تكاثرَ العدوُّ الواتِر",22,"ر",1,0],["يوم جاء البشير قلت سلاماً","قال أرخ بدا رياضٌ أمير",23,"ر",1,0],["يومَ جُرجَانَ والخوافقُ فوق ال","هامِ طيرٌ تلاعبُ الأَطْلالا",24,"ل",2,0],["يوم جذت بألطف كل يمين","من بني غالبٍ وكل يسار",25,"ر",1,0],["يومَ جاءت إليه تمشي على استحي","اء تشكو الِوشاحَ لا الخَلخَالا",26,"ل",2,0],["يوم جاء البشيرُ بالحكم فوراً","قلتُ شعراً يفوحُ أرجٌ بعود",27,"د",1,0],["يوم جيت أتذكره لاماصدقني","وقال لي إنت البشر تخطي وتصيب",28,"ب",1,0],["يوم جات الحين في دهري فرت","ما بقى غير السفافه والدفوف",29,"ف",1,0],["يَوْمٌ جَدِيدٌ وَقَلْبٌ رَائقٌ","وَالحُبُّ يَجْرِي بِرَيْحَانِ الدَّمِ",30,"م",1,0],["يوم جن الليل والداجي حلك","ويوم بعض الناس ضيّع في المسير",31,"ر",1,0],["يوم جاءت من أهل بادية الشا","م عجوزٌ شمطاءُ تشكو الأواما",32,"م",2,0],["يوم جرى لي بالبسيطا تواعيس","بالسهله اللي مثل لبة منيره",33,"ر",2,0],["يوم جتني تمتحني في زمان الجاهليه","جيتها رجلٍ تحلى في تقاليد الصحابه",34,"ب",2,0],["يوم جاءت فوق أمتاْن اشتياقي","ثوبها منْ سندس يخْتال فخرا",35,"ر",2,0],["يوم جاد الحظ ساعة نلتقي","إشتعل حب ٍ ، بوجداني ، دفيني",36,"ن",2,0],["يومٌ جديدٌ يردُّ غصّاً","من ملككم ما جنى الذُّبولُ",37,"ل",1,0]]}