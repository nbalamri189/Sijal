{"poems":[[55,"من رأى البرق بغوري السند","https://www.aldiwan.net/poem30636.html","الرمل"],[95,"دال السكون من الحراك الدائم","https://www.aldiwan.net/poem11373.html","الكامل"],[101,"لا تحبيني","https://www.poetsgate.com/ViewPoem.aspx?id=196733",""],[124,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[154,"يا نسيم الريح يهفو سحرا","https://www.aldiwan.net/poem68474.html","الرمل"],[333,"من ترانيم وحيك القدسي","https://www.aldiwan.net/poem55045.html","الخفيف"],[347,"صرفند معقل الاحرار ما","https://www.aldiwan.net/poem55320.html","الرمل"],[415,"لا تفسدن نصيحتي بشقاق","https://www.aldiwan.net/poem32258.html","الكامل"],[422,"سعدت نجد إذا وافيت نجدا","https://www.aldiwan.net/poem54161.html","الرمل"],[469,"يا زماناً بالخيف كان وكنا","https://www.aldiwan.net/poem3416.html","عموديه"],[505,"ما للقلوب عن الحبيب غطاء","https://www.aldiwan.net/poem38105.html","الكامل"],[580,"وجنة فوقها عذار أطلا","https://www.aldiwan.net/poem3027.html","الخفيف"],[636,"","https://poetry.dctabudhabi.ae/diwan/poem/111562","الخفيف"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122376","الخفيف"],[908,"","https://poetry.dctabudhabi.ae/diwan/poem/199307","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119892","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133847","الخفيف"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47153","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77411","الخفيف"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133985","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132523","الخفيف"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100201","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216575","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40163","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40117","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44913","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73162","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33575","الخفيف"],[4767,"أيكة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=91456",""],[4929,"مرثية الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=204918",""],[4929,"حيثيات الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=207444",""],[5136,"أيها المدره الحليم العليم","https://www.poetsgate.com/ViewPoem.aspx?id=121656",""],[5190,"لن تهوني يا مصر","https://www.poetsgate.com/ViewPoem.aspx?id=153356",""],[5277,"سيدي العراق","https://www.poetsgate.com/ViewPoem.aspx?id=201721",""],[5431,"قاصرٌ من ذويه ...","https://www.poetsgate.com/ViewPoem.aspx?id=210853",""],[5956,"يا نسيما","https://www.poetsgate.com/ViewPoem.aspx?id=183185",""],[5309,"من اعد العيش فوق السحب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573523",""],[469,"يا زمانا بالخيف كان وكنا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574798",""],[6202,"ما غيّروك عن النضال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86751&r=&rc=52",""],[6301,"نشيد أُمِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80680&r=&rc=44",""],[5190,"طر يا حجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78347&r=&rc=60",""],[6355,"لِمَ أعْرَضَتْ عنكَ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66676&r=&rc=136",""]],"verses":[["أَنتَ آسيها إِذا لَجَّ بِها","مِن أَعاديها رَداعٌ وَضَمَد",0,"د",1,0],["إنْ تَأْسَ مِصْرَ فَمَا أَسَاهَا أَنَّهَا","مَفْجُوعَةٌ فِي لَوْذَعِيٍّ عَالِمِ",1,"م",1,0],["أنتِ أستريحيِ ... من هواي أنا","لكن سألتكِ ... لا ترُيحني",2,"ن",2,0],["أنت أسخطتنا عليك فخلنا","عنك لما جهلت وجه الرضاء",3,"ا",2,0],["أنت أسنى الناس عندي موقعاً","عرف العاذل ذا أم أنكرا",4,"ر",2,0],["أنت أسمى منه فأنت نبيٌّ","لا يفيه الثناء غير نبي",5,"ي",1,0],["انت اسمى منهم منزلة","يا اخا العرب واهدى سننا",6,"ن",2,0],["أنت استضأْتَ بنارِه متبصِّراً","وأنا صُلِيتُ بجمرِهِ المِحراقِ",7,"ق",1,0],["أنتَ أسنى نِعَم الله الَّتي","نحنُ لا نحصي لها حصراً وعدَّا",8,"د",2,0],["أنتِ أسجى لحظاً وأهيفُ اعطافاً","وأسنى وجههاً يشوق وأسنى",9,"ن",2,0],["أنتَ اسْتَحَيْتَ إذا أساءَكَ شاتِمٌ","من شتْمِ نفسِكَ ما لديكَ حَياءُ",10,"ا",2,0],["أَنت أَسْخَى كفّاً وأَحسن أَلفا","ظاً وأَحمى حِمىً وأَعلى مَحَلاَّ",11,"ل",2,0],["أنت أسنى من بدر تم وأحلى","من ضبا القفر مبسما ومحيا",12,"ي",2,0],["انت اسديت للرياض ابتهاجا","ومنحت الحدائق الاكليلا",13,"ل",2,0],["أنت آسي الأدواء في الدين والدن","يا ومحيي الأموات والأحياء",14,"ا",2,0],["أنت أسلفتني السماح فخذها","حرة يا مقابل الأسلافِ",15,"ف",1,0],["أنت أسطورتي جعلتك للأج","يال أبهى روائع الإلهام",16,"م",1,1],["أنت استطاعَتُهُمْ فما عُذْرُ الذي","ترك الزّيارةَ خِيفةَ الإقلال",17,"ل",1,0],["أَنتَ أَسعَدتَني إِلَهي عَلى الدُن","يا وَأَكبَرتَ في الحَياةِ نَصيبي",18,"ي",1,1],["أنت اسمى شأناً وأسنى مقاماً","في المعالي طريفه وتليده",19,"د",2,0],["أنت أسنى علا وأسمى محلا","أن يداني صفاتك الإطراء",20,"ا",2,0],["أنت أسمى من كل ندبٍ تسمى","في البرايا محمداً وعليا",21,"ي",2,0],["انت اسلست لي مقاد ذوي الرأ","ي وطامنت لي رقاب الذكاء",22,"ا",2,0],["أَنتَ أَسرى المُلوكِ نَفساً وَفلساً","وَإِلى أَسرِهِم مِنَ الطّيفِ أَسرى",23,"ر",2,0],["أَنتَ أَسْناهُم أَباً وَإِباء","وَاِمرَءاً حيّاً وَأَمرع حيناً",24,"ن",2,0],["أَنتَ أَسَستَهُ عَلى خَيرِ ركنٍ","فَنَما في يَديكَ خَيرَ نَماءِ",25,"ا",2,0],["أنتَ أسهرتَ ناظري ويميناً","ما على هائمٍ بمثلِكَ عارُ",26,"ر",1,0],["أنتَ أسقَمتَني ولو شئتَ أذهب","تَ ضنىً ما جفوتَني مَسدومُ",27,"م",1,0],["أنت أسمى من الذي ليس يرجى","بل تولى وراح يلهم وجيا",28,"ي",2,0],["أنت أسمى من قاتليك وأعلى","في الثرى هم، ودونَك الجوزاءُ",29,"ا",2,0],["أنتَ أسمى معنىً يُرتِّلُ حرفيْ","عشقَهُ بالولاءِ لحناً ويَشْدُو",30,"د",2,0],["أنت اسماً قدراً وإني والله","إذا سمتك القدوم لثيم",31,"م",1,0],["أنتِ أَسمَى فِي قلبِ كُلِّ شَريفٍ","أنتِ أغلى مِن الدِّما فِي الوَتِينِ",32,"ن",1,0],["أنتَ أسماءُ المعاني كلُّها","بلْ وأنتَ الحرفُ عندي يستترْ",33,"ر",1,0],["إنْ تأسى من ابتعادك عنه","مثل هرٍ مشاكس داعبيه",34,"ي",2,0],["أنت أسرارُ هنائي","لستُ لولاك أقومُ",35,"م",1,0],["أَنتَ أَسمى مِن مَقامي مَنزِلاً","أَنتَ أُستاذي بأُمّي وَأَبي",36,"ب",2,0],["أنتِ أسجى لحظاً وأهيفُ أعطا","فاً وأسبى وجهاً يشوق وأسنى",37,"ن",2,0],["أنت استكنت لفاتح","ولقيت حمدانا ضرب",38,"ب",1,0],["أنْتِ أَسْمى منْ قَصِيدي","بَلْ وأَغْلَى منْ بَيَاني",39,"ن",2,0],["أنت أسمى ، أنت أمضى سطوةً","من رصاصاتِ المنايا والضرر",40,"ر",1,0],["أنتَ أسرَفْتَ في المَلاحةِ حتَّى","ضاق بالموْجِ عاشقُ البَحْر ذَرْعا",41,"ع",2,0]]}