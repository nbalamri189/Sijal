{"poems":[[74,"أفدي قمر","https://www.aldiwan.net/poem18700.html","منهوك الرجز"],[19,"أيتها النفس أجملي جزعا","https://www.aldiwan.net/poem347.html",""],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85440","الكامل"],[92,"الجيل الجَديدْ","https://www.poetsgate.com/ViewPoem.aspx?id=179209",""],[385,"من منصفي من ظلوم جد في تلفي","https://www.aldiwan.net/poem48815.html","البسيط"],[458,"قالوا تصبر قد يتوب الغادر","https://www.aldiwan.net/poem61766.html","الكامل"],[500,"يا ملك الشرق عمدة الدول","https://www.aldiwan.net/poem10262.html","المنسرح"],[505,"ليل المحب إذا تطاول بالسهر","https://www.aldiwan.net/poem38019.html","الكامل"],[519,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112471","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48769","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62534","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122081","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104787","الرجز"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60956","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103024","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58055","السريع"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58011","الكامل"],[4810,"هوانا","https://www.poetsgate.com/ViewPoem.aspx?id=13112",""],[4578,"نشرت على رمح القوام عصائبا","https://www.poetsgate.com/ViewPoem.aspx?id=49349",""],[4858,"بوركتمُ , وجه الحضارة مشرقاً","https://www.poetsgate.com/ViewPoem.aspx?id=138294",""],[4927,"ثلاث ثورات، والقادم أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=80803",""],[4927,"مُعلَّقةُ الجبهة اللاوطنية اللاتقدمية السورية","https://www.poetsgate.com/ViewPoem.aspx?id=80806",""],[5074,"الشراع التائه","https://www.poetsgate.com/ViewPoem.aspx?id=157884",""],[5135,"أحلام معلم","https://www.poetsgate.com/ViewPoem.aspx?id=205480",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[6115,"سج هاجوس الشعر للشاعر المسكيني","https://www.poetsgate.com/ViewPoem.aspx?id=180475",""]],"verses":[["والمختبر","لله دَرّ",0,"ر",1,0],["وَالمُخلِفَ المُتلِفَ المُرَزَّأَ لَم","يُمتَع بِضَعفٍ وَلَم يَمُت طَبَعا",1,"ع",2,0],["وألم خطب منه تزهق أنفس","ويمور في الأرض الدمُ المهراق",2,"ق",1,0],["والمخلصون ، رجاؤهم أن تنجلى","كُرَبٌ وأن يِلد الصباحَ ظلام",3,"م",1,0],["وَالمُخلص الود وَالمَذّاق ما اِشتَبَها","عَلى لَبيب وَلَيسَ الدُرّ كَالصَدَف",4,"ف",1,0],["والمخلص الحر الغيور مآله","نفىٌ تنوع أو مماتٌ جائر",5,"ر",1,0],["والمخذَم السيف إن خذمت مدى ال","عمر وأفنيت مدة الْمَهل",6,"ل",1,0],["والمُخْلِصونَ أروقَةٌ أجفانُهُمْ","هَشٍّا لهُ والمُخْلصونَ على خَطَرْ",7,"ر",1,0],["والمُخْجِلَ القَمرَ المُنيرَ بتِمّهِ","في حُسنهِ والغيثَ من إحسانهِ",8,"ن",2,0],["والمخلصون إذا مررت مسلماً","لا يرجعون تحيتي وسلامي",9,"م",2,0],["والمخلص الحر للتاج الذي ظفرت","بك الوزارة منه بالضمانات",10,"ت",1,0],["والمخضبين سيوفهم بدم العدا","بسيوف حقٍّ في الدماء نواهلِ",11,"ل",1,0],["وَالمُخْمِصُونَ رَوَاحِلَ المُدَّاحِ فِي","عَرْضِ الفَيَافِي أَحْمَدَ الإِخْمَاصِ",12,"ص",1,0],["وَالمُخُّ إِن يَفسُد فَكُلُّ السَّاق","يَفسُدُ لاَ شَكَّ بِلاَ شِقاقِ",13,"ق",1,0],["والمخبرون عن ابن جَفْنَة كثرة","والحسن فيها كان مِن حسان",14,"ن",1,0],["والمخصب البلد العافي بنائله","والفخر اثنان أقدام وإحسان",15,"ن",1,0],["والمخبرُ اللهُ له لم يكنْ","يشتدُّ غيظاً وهو قهَّارُ",16,"ر",1,0],["والمخلصونَ بهِ لَقدْ نالُوا المنى","ولَقُوا المرادض بهِ وكلَّ السُّؤدُدِ",17,"د",1,0],["والمخاضاتُ عذاب.",". ولقد تلدُ الأرحامُ وَحلاً واحتقانا",18,"ن",2,0],["والمخجل الأنواء بالسبب الذي","في الحال يُنشئ للمريد سحائبا",19,"ب",2,0],["والمخلصون العاملون يسُرُّهم","ما أورِثوا من جنةٍ وعلاها",20,"ا",3,0],["وَالْمُخْبِرُوْنَ تَفَرَّقُوْا مِنْ خَوْفِهِمْ","وَتَخَلَّفَ الْجَاْسُوْسُº وَالْعَيَّاْرُ",21,"ر",1,0],["وَالْمُخْبِرُ الْجَاْسُوْسُ صَاْرَ مُنَاْضِلاً","يَعْوِيْ º فَتَعْوِيْ - حَوْلَهُ - الْعُمَلاْءُ",22,"ا",2,0],["وَ المُخْلِصُوْنَ عَلَى أَنْقَاضِهَا نَصَبُوا","مَنَارَةً تَهْتَدِيْ في ضَوْئِهَا السُّفُنُ",23,"ن",1,0],["والمُخْفِقُوْنَ بِهَا بَئِيْسٌ حَالُهُمْ","ومَصِيْرُهُمْ مِنْ بَعْدِهَا التَّدْوِيْرُ",24,"ر",1,0],["والمخلصون وأهل الاختصاص ومن","في الامتحان سموا في العلو والمهد",25,"د",1,0],["والمخابر قام يهمس له في الاذنيني","واقع ملموس غير فرحته وسروره",26,"ر",2,0]]}