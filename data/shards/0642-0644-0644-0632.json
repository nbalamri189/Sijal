{"poems":[[55,"من رأى البرق بغوري السند","https://www.aldiwan.net/poem30636.html","الرمل"],[50,"قل لزهير إذا اتكا وشدا","https://www.aldiwan.net/poem63391.html","المنسرح"],[369,"نثار مثلي إذا ما جاء يهديه","https://www.aldiwan.net/poem60589.html","البسيط"],[443,"قل لزين الكفاة يا ذا الذي فاق","https://www.aldiwan.net/poem2617.html","الخفيف"],[463,"يا دار لا أنهج القشيب","https://www.aldiwan.net/poem56284.html","مخلع البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119961","الرمل"],[291,"","https://poetry.dctabudhabi.ae/diwan/poem/48479","الخفيف"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2562","الخفيف"],[463,"يا دارُ لا أنهجَ القشيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=17994",""]],"verses":[["قُل لِزَورِ الشَيبِ أَهلاً إِنَّهُ","أَخَذَ الغَيّ وَأَعطاني الرَشَد",0,"د",1,0],["قُل لِزُهَيرٍ إِذا اِتَّكا وَشَدا","أَقلِل أَوِ اِكثِر فَأَنتَ مِهذارُ",1,"ر",1,1],["قُلْ لزَيْنِ الورَى أَبى الفضلِ عنّا","قَوْلَ صدْقٍ وللجميلِ وُجوهُ",2,"ه",1,0],["قل لزين الكفاة يا ذا الذي فا","قَ بحسنِ الكفايةِ الأكفاء",3,"ا",2,1],["قُلْ لزماني ما شئت فاضغط","قد دَبِرَ الجائِرُ الجليبُ",4,"ب",1,0],["قل لزين الدين عن شاعره","عثر لإسداء الأيَّادى والمنن",5,"ن",1,1],["قُلْ لِزَيْدِ بْنِ صاعِدٍ","جَاءَكَ العَزْلُ فِي لَطَفْ",6,"ف",1,1],["قُل لِزَيدٍ قَد كُنتَ تُؤثَرُ بِالحِل","مِ إِذا سَفِهَت حُلومُ الرِجالِ",7,"ل",1,1],["قلْ لزماني ما شئت فاضغط","قد دبرَ الجابرُ الجليبُ",8,"ب",1,0]]}