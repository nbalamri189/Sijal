an.net/poem14434.html","الكامل"],[441,"أحسن عزاك فخير الصبر في الجزع","https://www.aldiwan.net/poem14459.html","البسيط"],[443,"في إثر سعيد يا أسعد","https://www.aldiwan.net/poem55931.html","عموديه"],[477,"ما لحبل الوصل قد أمسى رماما","https://www.aldiwan.net/poem15278.html","الرمل"],[495,"مهلا أبا بكر فزندك أضيق","https://www.aldiwan.net/poem10245.html","الكامل"],[500,"أي قلب هام فيكم وسكن","https://www.aldiwan.net/poem37760.html","الرمل"],[500,"رح مع الوردين إني عاشق","https://www.aldiwan.net/poem37950.html","الرمل"],[515,"يا أحسن الناس وجهاً","https://www.aldiwan.net/poem12067.html","المجتث"],[529,"يا أحمد بن محمد","https://www.aldiwan.net/poem37133.html","الكامل"],[551,"ما لي تطيح الدهر أخياري","https://www.aldiwan.net/poem47788.html","البسيط"],[558,"حولوا عني من الكون لثاما","https://www.aldiwan.net/poem33885.html","الرمل"],[586,"بمن أباحك قتلي","https://www.aldiwan.net/poem17667.html","المجتث"],[586,"ما بين هجرك والنوى","https://www.aldiwan.net/poem18025.html","مجزوء الكامل"]],"verses":[["يا أَحَقَّ الوَرى بِمَمحوضِ إِخلا","صي وَأَولاهُمُ بِغايَةُ شُكري",0,"ر",2,0],["يا أحمدَ ابنَ أبيهِ","ويا ربيب حُرَيْثِ",1,"ث",1,1],["يا أحمدَ الخيرِ المُؤَمْ","مَل حين تُخشى العَنْقفيرُ",2,"ر",1,0],["يا أحسنَ العالمين حاسرةً","وأكمل الناس عند معتجَرِ",3,"ر",1,0],["يا أحمد الخير يا من لا يعد له","بدء جميل بسوء العود مخلوف",4,"ف",1,0],["يا أحمد بن سعيدٍ لا تَمتْ جزعاً","فالحبُّ طعمانِ ممرورٌ ومعسولُ",5,"ل",1,1],["يا أحمد بن سعيدٍ لو بصُرتَ بها","إذ الأكفُّ لساقيها خلاخيلُ",5,"ل",1,0],["يا أحمد بن سعيدٍ لو بصرت بها","وذيلُها لأيورِ القومِ منديلُ",5,"ل",1,0],["يا أحمدَ المحمودَ إن عيونَنا","أضحتْ كما أمستْ عليك سخائنا",6,"ن",2,0],["يا أَحسَنَ الناسِ يا مَن لا أَبوحُ بِهِ","يا مَن تَجَنّى وَما أَحلى تَجَنّيهِ",7,"ي",2,0],["يا أَحسَنَ العالَمينَ خُلقاً","مِثلُكَ لا يَرتَضي بِظُلمي",8,"ي",1,0],["يا أحمد الخيرات ما أنا بالغ","تلك الخلال وإن لمست رثاءها",9,"ا",3,0],["يا أحمد القانونُ بعدك غامض","قلِق البنود مجلل بسواد",10,"د",1,0],["يا أَحمَدَ الخَيرِ لي جاهٌ بِتَسمِيَتي","وَكَيفَ لا يَتَسامى بِالرَسولِ سَمي",11,"م",2,0],["يا أَحسَنَ الصَبرِ زُر أَولى القُلوبِ بِها","وَقُل لِصاحِبِهِ يا أَنفَعَ السُحُبِ",12,"ب",1,0],["يا أَحمَدَ بنَ مُحَمَّدٍ نَضَبَ النَدى","مِن كَفِّ كُلِّ أَخي نَداً ياءَحمَدُ",13,"د",1,0],["يا أَحمَدَ بنَ أَبي دُؤادِ","وَالحادِثاتِ بِكُلِّ نادِ",14,"د",1,1],["يا أَحسَنَ الناسِ ريقاً غَيرَ مُختَبِرٍ","إِلّا شَهادَةَ أَطرافِ المَساويكِ",15,"ك",1,1],["يا أحكم الحكماء لا","يفتى وفي الأوقاف مالك",16,"ك",1,0],["يا أَحمَدَ اِبنَ أَبي دُاودٍ دَعوَةً","ذَلَّت بِشُكرِكَ لي وَكانَت رَيِّضا",17,"ض",2,0],["يا أَحمَدَ بنَ أَبي دُوادٍ حُطتَني","بِحِياطَتي وَلَدَدتَني بِلُدودي",18,"د",2,0],["يا أحباي وكم من عثرة","سلفت ما بالُ هذي لا تقال",19,"ل",1,0],["يا أَحسَنَ العالَمينَ وَجهاً","ما لَكَ مِن أَن تُحِبَّ بُدُّ",20,"د",1,0],["يا أَحمَدَ المُرتَجى في كُلِّ نائِبَةٍ","قُم سَيِّدي نَعصِ جَبّارَ السَمَواتِ",21,"ت",1,0],["يا أحمد اثبت في مكانك باسلاً","لا يوهننّك منهم الإرهاب",22,"ب",1,0],["يَا أَحْمَدَ الخَيْرِ يَا مَنْ","أَسْدَى وَأَجْزَلَ عُرْفَهْ",23,"ف",2,0],["يَا أَحْمَدَ الآبَاءِ مَا","ذَا فِي ابْنِكَ الغَالِي دَهَاكْ",24,"ك",1,0],["يَا أَحِبَّاءَنَا بِدَارٍ تَنَاءَتْ","وَهْيَ مِنَّا مَثَابَةُ الأَشْوَاقِ",25,"ق",1,0],["يا \" أحمد النور \" عفوا إن ثأرت ففي","صدري جحيم تشظّت بين أشعاري",26,"ر",2,0],["يا أحبايَ وما أصبرَكم","أحسَنُ الأحباب من لم يَصبِر",27,"ر",1,0],["يا أحمَدُ بنُ مُحَمّدٍ نَضبَ النّدَى","مِنْ كَفّ كلّ أخي نَدىً، يا أحمَدُ",28,"د",1,0],["يا أَحمَد العَظماءِ يا مَن بابة","لِلسائِلين مُجرب مَفتوحُ",29,"ح",1,0],["يا احمد الاولياء العارفين ويا","سلطان اطقابهم يا ملجأ الفقرا",30,"ر",2,1],["يا أحمد القوم يا شبل الحسين ويا","من انت للزهر من آل البتول اب",31,"ب",1,0],["يا أحمد الصبا يا منجد ال","عيان يا صدر صدور الرجال",32,"ل",1,1],["يا أحمد الأوليا يا سيد الصلحا","يا جهبذ الأصفاي يا صاحب العلم",33,"م",1,0],["يا أحقر الناس في عيني وأسمجهم","إني لآنف أن أدعوك إنسانا",34,"ن",2,0],["يَا أحوَلَ العَينِ لاَ تَجنَح إِلَى الدَّينِ","وَلاَ تَكُن جَاهِلاً يَا أحوَلَ العَين",35,"ن",1,1],["يا أحمدَ العدلِ والإحسان حُيِّيتَا","ونلتَ من طيبات المُلكِ ما شِيتَا",36,"ت",2,1],["يا أحسن الناس عندي","هلا رثيت لحالي",37,"ي",1,1],["يا أَحضَرَ الأَمَراءِ في حَسمِ الأَذى","قَولاً وَأَحصَرَهُم غَداةَ سِبابِ",38,"ب",1,0],["يا أَحْسَنَ النَّاسِ وَجهَاً","كان الصُّدودُ جَزائي",39,"ي",1,0],["يا أحمدا يا نجل إسمعيل يا","فرع الملوك وكل أصل نامي",40,"م",2,0],["يا أحمداً أقرضتَ ربّكَ والسرا","ةَ يئنُّ تحتَ رباهمُ المسكينُ",41,"ن",1,0],["يا أحسنَ الفاتنينَ قدّاً","وارفعَ المالكينَ قدرا",42,"ر",2,0],["يا أحمد بن محمدٍ حمداً لمن","جعل الفضائلَ في ذوي الإفضالِ",43,"ل",1,0],["يا أحمد بن عَليّ الباني العلا","والمُستعدُّ لكل خطبٍ نابا",44,"ب",2,0],["يا أحباباً نأوا عني فسال","دمع عيني فوق خدّي كاللآل",45,"ل",1,1],["يا أَحمَدَ اِرفَع رَأسَكَ المَيمونَ قُل","يُسمَع وَسَل تُعطَه بِلا حِرمانِ",46,"ن",1,0],["يا أحرص الناس على مبعرٍ","يدق مستنجاه بالفيش",47,"ش",1,1],["يا أحمد الحمد الذي بمديحه","أبدى الزمان ترنحا وترنما",48,"م",2,0],["يا أحمد المرتضى والمرتجى أبداً","ألستَ من سطواتِ الرومِ تحمينا",49,"ن",2,0],["يا أحمد اللَه بيسر كل ما قد تعسر","ربنا اللَه سبحانه له البر والبحر",50,"ر",1,1],["يا أَحسَنَ خَلقٍ","عَلَيهِ قَد كادَ يَحسُدُ",51,"د",1,0],["يا أَحسَنَ الناسِ أَخلاقاً وَمَعرِفَةً","وَالحِلمُ يُنبِئُ وَالأَعمالُ تَذكارُ",52,"ر",1,0],["يا أَحمَد العَصر طِب نَفساً فَاِنَّكَ مِن","قَوم اِذا وَصَفوا كانوا هُم السَعدا",53,"د",2,0],["يا أحمدُ بنَ عليٍّ القرمُ الذّي","ما زال للدّاعي الصريخِ مُجيبا",54,"ب",2,0],["يا أحمدُ المَحمودُ في أزمةٍ","مَذمُومَةٍ في الشد واللِّينِ",55,"ن",1,1],["يا أحد يا منان يا صمد يا مقصود","هب لنا كل الخير واكف كل أهوال",56,"ل",1,0],["يا أَحُدُ اشهد بحقِّ مَشهَدِهِ","واسعَ لتفصِح بِقَدرِ مَسعاهُ",57,"ا",2,0],["يا أَحم لا تنسَ الدُّعا","لي بالعشيّ وبالغُدُوّ",58,"د",2,1],["يا أَحْمَ دعوةَ عانٍ قلّ ناصرُهُ","وخانَهُ لِجفَا الدّهرِ الأحبَاءُ",59,"ا",2,0],["يا أُحَيْبَابنا وقولي تصغيراً","أَحَيبابنا ألذّ وأَحْلاَ",60,"ل",2,0],["يا أحبائي لقد أحسنتم","إذ طويتم فيه أخبار الوطن",61,"ن",1,0],["يا أحمد القرشي هذا معجز","أففي البلاغة للنبوة تدعي",62,"ي",1,0],["يا أحمد جوزيت عن أحمد","وآله في يومك الآخر",63,"ر",1,0],["