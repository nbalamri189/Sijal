لكامل"],[4346,"","https://poetry.dctabudhabi.ae/diwan/poem/100666","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83643","البسيط"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198193","الكامل"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127926","الكامل"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18811","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58129","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33406","المنسرح"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33260","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33263","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72721","البسيط"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136411",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120356","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35139","الكامل"],[4684,"حمحمة الخاء","https://www.poetsgate.com/ViewPoem.aspx?id=201572",""],[4764,"آخر حكاياتي","https://www.poetsgate.com/ViewPoem.aspx?id=30532",""],[4578,"أآهدي إليَّ تفضلاً تمثالهُ","https://www.poetsgate.com/ViewPoem.aspx?id=49508",""],[4578,"نشرت على رمح القوام عصائبا","https://www.poetsgate.com/ViewPoem.aspx?id=49349",""],[4902,"رثاء الامير احمد بن سلمان","https://www.poetsgate.com/ViewPoem.aspx?id=22854",""],[4908,"عقلي متيم","https://www.poetsgate.com/ViewPoem.aspx?id=209097",""],[4980,"عُقِدَ اللسان أمام حُبِّك في فَمي","https://www.poetsgate.com/ViewPoem.aspx?id=207642",""],[4119,"أنتم كالشمس لولا خدرها","https://www.poetsgate.com/ViewPoem.aspx?id=16224",""],[5057,"شاخت أروى","https://www.poetsgate.com/ViewPoem.aspx?id=203629",""],[5121,"لِلْكَرَوَانِ فُلَّة","https://www.poetsgate.com/ViewPoem.aspx?id=179415",""],[5136,"أودى بحمد الله عامر","https://www.poetsgate.com/ViewPoem.aspx?id=121599",""],[5136,"هذا المحرم قادما مسروراً","https://www.poetsgate.com/ViewPoem.aspx?id=121575",""],[4478,"يا أحسنَ النّاس لولا أنّ نائلها","https://www.poetsgate.com/ViewPoem.aspx?id=15117",""],[5185,"انتباه","https://www.poetsgate.com/ViewPoem.aspx?id=73863",""],[5219,"يا ظبية البان","https://www.poetsgate.com/ViewPoem.aspx?id=193707",""],[5542,"يا فارس الكرسي","https://www.poetsgate.com/ViewPoem.aspx?id=9679",""],[5596,"فقيد البِرِّ والسخاء","https://www.poetsgate.com/ViewPoem.aspx?id=206382",""],[5596,"إلى آل الفلاح في مصابهم","https://www.poetsgate.com/ViewPoem.aspx?id=206783",""],[5704,"شوقي الى المختار","https://www.poetsgate.com/ViewPoem.aspx?id=194470",""],[5743,"رمال عطشى","https://www.poetsgate.com/ViewPoem.aspx?id=202314",""],[5790,"مولاي حاشاك أن تصغى إلى عذل","https://www.poetsgate.com/ViewPoem.aspx?id=112118",""],[5847,"في ظلال ميلاد النبي محمد صلى الله عليه وسلم 1431","https://www.poetsgate.com/ViewPoem.aspx?id=52777",""],[5939,"يا حسنا كثيرَ الذنوب!","https://www.poetsgate.com/ViewPoem.aspx?id=138043",""],[5939,"لم يكن للورد ذنب","https://www.poetsgate.com/ViewPoem.aspx?id=178580",""],[5956,"يا أحمدَ الخير","https://www.poetsgate.com/ViewPoem.aspx?id=194232",""],[5956,"من أي نجم جئتَ؟","https://www.poetsgate.com/ViewPoem.aspx?id=194561",""],[6018,"نفس مصدقة جميع عداتها","https://www.poetsgate.com/ViewPoem.aspx?id=181195",""],[6089,"سحائبُ الألم","https://www.poetsgate.com/ViewPoem.aspx?id=213541",""],[6093,"القصيدة الزبيدية في مدح خير البرية","https://www.poetsgate.com/ViewPoem.aspx?id=195006",""],[6125,"كان الهجير وبعض الوصل ما كانا","https://www.poetsgate.com/ViewPoem.aspx?id=210895",""],[6177,"وهج البُردة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79139&r=&rc=21",""],[6189,"ما تبقى من أحزان الرجال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83551&r=&rc=18",""],[6202,"رسالة إلى الكبيسي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86725&r=&rc=26",""],[406,"أحمد ياسين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70027&r=&rc=87",""]],"verses":[["يا أَحَقَّ الوَرى بِمَمحوضِ إِخلا","صي وَأَولاهُمُ بِغايَةُ شُكري",0,"ر",2,0],["يا أحمدَ ابنَ أبيهِ","ويا ربيب حُرَيْثِ",1,"ث",1,1],["يا أحمدَ الخيرِ المُؤَمْ","مَل حين تُخشى العَنْقفيرُ",2,"ر",1,0],["يا أحسنَ العالمين حاسرةً","وأكمل الناس عند معتجَرِ",3,"ر",1,0],["يا أحمد الخير يا من لا يعد له","بدء جميل بسوء العود مخلوف",4,"ف",1,0],["يا أحمد بن سعيدٍ لا تَمتْ جزعاً","فالحبُّ طعمانِ ممرورٌ ومعسولُ",5,"ل",1,1],["يا أحمد بن سعيدٍ لو بصُرتَ بها","إذ الأكفُّ لساقيها خلاخيلُ",5,"ل",1,0],["يا أحمد بن سعيدٍ لو بصرت بها","وذيلُها لأيورِ القومِ منديلُ",5,"ل",1,0],["يا أحمدَ المحمودَ إن عيونَنا","أضحتْ كما أمستْ عليك سخائنا",6,"ن",2,0],["يا أَحسَنَ الناسِ يا مَن لا أَبوحُ بِهِ","يا مَن تَجَنّى وَما أَحلى تَجَنّيهِ",7,"ي",2,0],["يا أَحسَنَ العالَمينَ خُلقاً","مِثلُكَ لا يَرتَضي بِظُلمي",8,"م",2,0],["يا أحمد الخيرات ما أنا بالغ","تلك الخلال وإن لمست رثاءها",9,"ا",3,0],["يا أحمد القانونُ بعدك غامض","قلِق البنود مجلل بسواد",10,"د",1,0],["يا أَحمَدَ الخَيرِ لي جاهٌ بِتَسمِيَتي","وَكَيفَ لا يَتَسامى بِالرَسولِ سَمي",11,"م",2,0],["يا أَحسَنَ الصَبرِ زُر أَولى القُلوبِ بِها","وَقُل لِصاحِبِهِ يا أَنفَعَ السُحُبِ",12,"ب",1,0],["يا أَحمَدَ بنَ مُحَمَّدٍ نَضَبَ النَدى","مِن كَفِّ كُلِّ أَخي نَداً ياءَحمَدُ",13,"د",1,0],["يا أَحمَدَ بنَ أَبي دُؤادِ","وَالحادِثاتِ بِكُلِّ نادِ",14,"د",1,1],["يا أَحسَنَ الناسِ ريقاً غَيرَ مُختَبِرٍ","إِلّا شَهادَةَ أَطرافِ المَساويكِ",15,"ك",1,1],["يا أحكم الحكماء لا","يفتى وفي الأوقاف مالك",16,"ك",1,0],["يا أَحمَدَ اِبنَ أَبي دُاودٍ دَعوَةً","ذَلَّت بِشُكرِكَ لي وَكانَت رَيِّضا",17,"ض",2,0],["يا أَحمَدَ بنَ أَبي دُوادٍ حُطتَني","بِحِياطَتي وَلَدَدتَني بِلُدودي",18,"د",2,0],["يا أحباي وكم من عثرة","سلفت ما بالُ هذي لا تقال",19,"ل",1,0],["يا أَحسَنَ العالَمينَ وَجهاً","ما لَكَ مِن أَن تُحِبَّ بُدُّ",20,"د",1,0],["يا أَحمَدَ المُرتَجى في كُلِّ نائِبَةٍ","قُم سَيِّدي نَعصِ جَبّارَ السَمَواتِ",21,"ت",1,0],["يا أحمد اثبت في مكانك باسلاً","لا يوهننّك منهم الإرهاب",22,"ب",1,0],["يَا أَحْمَدَ الخَيْرِ يَا مَنْ","أَسْدَى وَأَجْزَلَ عُرْفَهْ",23,"ف",2,0],["يَا أَحْمَدَ الآبَاءِ مَا","ذَا فِي ابْنِكَ الغَالِي دَهَاكْ",24,"ك",1,0],["يَا أَحِبَّاءَنَا بِدَارٍ تَنَاءَتْ","وَهْيَ مِنَّا مَثَابَةُ الأَشْوَاقِ",25,"ق",1,0],["يا \" أحمد النور \" عفوا إن ثأرت ففي","صدري جحيم تشظّت بين أشعاري",26,"ر",2,0],["يا أحبايَ وما أصبرَكم","أحسَنُ الأحباب من لم يَصبِر",27,"ر",1,0],["يا أحمَدُ بنُ مُحَمّدٍ نَضبَ النّدَى","مِنْ كَفّ كلّ أخي نَدىً، يا أحمَدُ",28,"د",1,0],["يا أَحمَد العَظماءِ يا مَن بابة","لِلسائِلين مُجرب مَفتوحُ",29,"ح",1,0],["يا احمد الاولياء العارفين ويا","سلطان اطقابهم يا ملجأ الفقرا",30,"ر",2,1],["يا أحمد القوم يا شبل الحسين ويا","من انت للزهر من آل البتول اب",31,"ب",1,0],["يا أحمد الصبا يا منجد ال","عيان يا صدر صدور الرجال",32,"ل",1,1],["يا أحمد الأوليا يا سيد الصلحا","يا جهبذ الأصفاي يا صاحب العلم",33,"م",1,0],["يا أحقر الناس في عيني وأسمجهم","إني لآنف أن أدعوك إنسانا",34,"ن",2,0],["يَا أحوَلَ العَينِ لاَ تَجنَح إِلَى الدَّينِ","وَلاَ تَكُن جَاهِلاً يَا أحوَلَ العَين",35,"ن",1,1],["يا أحمدَ العدلِ والإحسان حُيِّيتَا","ونلتَ من طيبات المُلكِ ما شِيتَا",36,"ت",2,1],["يا أحسن الناس عندي","هلا رثيت لحالي",37,"ل",2,1],["يا أَحضَرَ الأَمَراءِ في حَسمِ الأَذى","قَولاً وَأَحصَرَهُم غَداةَ سِبابِ",38,"ب",1,0],["يا أَحْسَنَ النَّاسِ وَجهَاً","كان الصُّدودُ جَزائي",39,"ي",1,0],["يا أحمدا يا نجل إسمعيل يا","فرع الملوك وكل أصل نامي",40,"م",2,0],["يا أحمداً أقرضتَ ربّكَ والسرا","ةَ يئنُّ تحتَ رباهمُ المسكينُ",41,"ن",1,0],["يا أحسنَ الفاتنينَ قدّاً","وارفعَ المالكينَ قدرا",42,"ر",2,0],["يا أحمد بن محمدٍ حمداً لمن","جعل الفضائلَ في ذوي الإفضالِ",43,"ل",1,0],["يا أحمد بن عَليّ الباني العلا","والمُستعدُّ لكل خطبٍ نابا",44,"ب",2,0],["يا أحباباً نأوا عني فسال","دمع عيني فوق خدّي كاللآل",45,"ل",1,1],["يا أَحمَدَ اِرفَع رَأسَكَ المَيمونَ قُل","يُسمَع وَسَل تُعطَه بِلا حِرمانِ",46,"ن",1,0],["يا أحرص الناس على مبعرٍ","يدق مستنجاه بالفيش",47,"ش",1,1],["يا أحمد الحمد الذي بمديحه","أبدى الزمان ترنحا وترنما",48,"م",2,0],["يا أحمد المرتضى والمرتجى أبداً","ألستَ من سطواتِ الرومِ تحمينا",49,"ن",2,0],["يا أحمد اللَه بيسر كل ما قد تعسر","ربنا اللَه سبحانه له البر والبحر",50,"ر",1,1],["يا أَحسَنَ خَلقٍ","عَلَيهِ قَد كادَ يَحسُدُ",51,"د",1,0],["يا أَحسَنَ الناسِ أَخلاقاً وَمَعرِفَةً","وَالحِلمُ يُنبِئُ وَالأَعمالُ تَذكارُ