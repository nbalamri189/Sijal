{"poems":[[73,"عذري إن عذلت في خلع عذري","https://www.aldiwan.net/poem11944.html","الخفيف"],[51,"يا أحمد ابن أبيه ويا ربيب حريث","https://www.aldiwan.net/poem9217.html","المجتث"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[51,"لا زلت غوثا إذا ناداك ملهوف","https://www.aldiwan.net/poem65444.html","البسيط"],[51,"يا أحمد بن سعيد لا تمت جزعا","https://www.aldiwan.net/poem65873.html","البسيط"],[51,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[70,"إقرأ سلامي على من لا أسميه","https://www.aldiwan.net/poem42419.html","البسيط"],[70,"عشقت بدرا ولا أسمي","https://www.aldiwan.net/poem42720.html","مجزوء البسيط"],[85,"هو مأتم الأخلاق فاتل رثاءها","https://www.aldiwan.net/poem7109.html","الكامل"],[85,"أكذا تقر البيض في الأغماد","https://www.aldiwan.net/poem7131.html","الكامل"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[43,"يا أخت خير أخ يا بنت خير أب","https://www.aldiwan.net/poem9460.html","البسيط"],[45,"يا يوم عرج بل وراءك يا غد","https://www.aldiwan.net/poem63475.html","الكامل"],[45,"يا أحمد بن أبي دؤاد","https://www.aldiwan.net/poem63542.html","مجزوء الكامل"],[49,"يا أحسن الناس ريقا غير مختبر","https://www.aldiwan.net/poem64263.html","البسيط"],[97,"أنا لا أظل وكل شي","https://www.aldiwan.net/poem24967.html","مجزوء الكامل"],[44,"أهلوك أضحوا شاخصا ومقوضا","https://www.aldiwan.net/poem30471.html","الكامل"],[44,"أرأيت أي سوالف وخدود","https://www.aldiwan.net/poem30556.html","الكامل"],[90,"‏كل ما في الكون حب وجمال","https://www.aldiwan.net/poem26553.html","الرمل"],[52,"مات وصال وعاش صد","https://www.aldiwan.net/poem27126.html","مجزوء البسيط"],[48,"لا أستزيد حبيبي من مواتاتي","https://www.aldiwan.net/poem62462.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85389","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55524","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55104","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55049","الخفيف"],[90,"البادية في إيران","https://www.poetsgate.com/ViewPoem.aspx?id=179050",""],[45,"يا يَوْمُ عَرّجْ بَلْ وَرَاءَكَ يا غَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=31631",""],[107,"علياك في جسم المكارم روح","https://www.aldiwan.net/poem16213.html","الكامل"],[113,"يا احمد الاولياء العارفين ويا","https://www.aldiwan.net/poem41120.html","عموديه"],[113,"لك الاضافات بالاسرار والنسب","https://www.aldiwan.net/poem41224.html","عموديه"],[113,"يا أحمد الصبا يا منجد ال","https://www.aldiwan.net/poem41761.html","السريع"],[113,"وعزة الله ما شوقي إلى العلم","https://www.aldiwan.net/poem41774.html","البسيط"],[124,"وحاسد غاظه فضلي فأرغمه","https://www.aldiwan.net/poem786.html",""],[130,"يا أحول العين لا تجنح إلى الدين","https://www.aldiwan.net/poem54699.html","البسيط"],[130,"يا أحمد العدل والإحسان حييتا","https://www.aldiwan.net/poem54877.html","البسيط"],[133,"يا أحسن الناس عندي","https://www.aldiwan.net/poem49021.html","المجتث"],[141,"هل فوق مجدك غاية لطلاب","https://www.aldiwan.net/poem11731.html","الكامل"],[153,"واصلت فيك هوائي","https://www.aldiwan.net/poem55802.html","المجتث"],[158,"شكوى الهدى وتعلق الإسلام","https://www.aldiwan.net/poem59211.html","الكامل"],[197,"ضنت وما أنا لو تشاء ضنين","https://www.aldiwan.net/poem45348.html","الكامل"],[197,"أما كفاك الفراق غدرا","https://www.aldiwan.net/poem45579.html","مخلع البسيط"],[202,"إقبالهن بشارة الإقبال","https://www.aldiwan.net/poem53188.html","الكامل"],[202,"صار التغزل في هواه عتابا","https://www.aldiwan.net/poem53367.html","الكامل"],[204,"يا أحباباً نأوا عني فسال","https://www.aldiwan.net/poem923.html",""],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[254,"يا أحرص الناس على مبعر","https://www.aldiwan.net/poem48478.html","السريع"],[259,"أعطى سرائرك النحول اللوما","https://www.aldiwan.net/poem38193.html","الكامل"],[268,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[302,"يا أحمد الله بيسر كل ما قد تعسر","https://www.aldiwan.net/poem16865.html","عموديه"],[318,"ما زلت لله أحمد","https://www.aldiwan.net/poem67168.html","المجتث"],[318,"أهل البلاغة يهني القلب إن صاروا","https://www.aldiwan.net/poem67224.html","البسيط"],[359,"يا ابن الاماجد لا تخش الردى أبدا","https://www.aldiwan.net/poem68121.html","البسيط"],[362,"من حكم طرفي إذ يكون مريبا","https://www.aldiwan.net/poem60989.html","الكامل"],[369,"يا أحمد المحمود في أزمة","https://www.aldiwan.net/poem57075.html","الطويل"],[388,"يا لطيف الطف بي فيجميع أحوالي","https://www.aldiwan.net/poem54515.html","عموديه"],[390,"ما لعلي العلاء أشباه","https://www.aldiwan.net/poem53682.html","المنسرح"],[399,"يا أحم لا تنس الدعا","https://www.aldiwan.net/poem46490.html","مجزوء الكامل"],[399,"أذن الندى عن نداء الشعر صماء","https://www.aldiwan.net/poem46909.html","البسيط"],[399,"طالع اليمن بالوصال استهلا","https://www.aldiwan.net/poem46915.html","الخفيف"],[400,"حدث البارق عن صنعا وعن","https://www.aldiwan.net/poem33394.html","الرمل"],[400,"كم ذا التلعب يا غزال الأجرع","https://www.aldiwan.net/poem33672.html","الكامل"],[400,"إن كان من يبغضنا كارها","https://www.aldiwan.net/poem33906.html","السريع"],[400,"كل أخبار الهوى قد رويت","https://www.aldiwan.net/poem34111.html","الرمل"],[400,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[402,"يا قمرا في الفؤاد حلا","https://www.aldiwan.net/poem49813.html","مخلع البسيط"],[413,"هذه الدار وهاتيك المغاني","https://www.aldiwan.net/poem54073.html","الرمل"],[429,"دوعدت ولم تف لي بذاك الموعد","https://www.aldiwan.net/poem12481.html","الكامل"],[429,"يا أحمد المحمود في ال","https://www.aldiwan.net/poem12512.html","مجزوء الكامل"],[429,"كاد الكمال يعود ربعا بلقعا","https://www.aldiwan.net/poem12664.html","الكامل"],[438,"ليت الكفان الذي إن مت لي صنعا","https://www.aldiwan.net/poem14333.html","البسيط"],[438,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[438,"أحسن عزاك فخير الصبر في الجزع","https://www.aldiwan.net/poem14459.html","البسيط"],[441,"في إثر سعيد يا أسعد","https://www.aldiwan.net/poem55931.html","عموديه"],[475,"ما لحبل الوصل قد أمسى رماما","https://www.aldiwan.net/poem15278.html","الرمل"],[493,"مهلا أبا بكر فزندك أضيق","https://www.aldiwan.net/poem10245.html","الكامل"],[498,"أي قلب هام فيكم وسكن","https://www.aldiwan.net/poem37760.html","الرمل"],[498,"رح مع الوردين إني عاشق","https://www.aldiwan.net/poem37950.html","الرمل"],[513,"يا أحسن الناس وجهاً","https://www.aldiwan.net/poem12067.html","المجتث"],[527,"يا أحمد بن محمد","https://www.aldiwan.net/poem37133.html","الكامل"],[549,"ما لي تطيح الدهر أخياري","https://www.aldiwan.net/poem47788.html","البسيط"],[556,"حولوا عني من الكون لثاما","https://www.aldiwan.net/poem33885.html","الرمل"],[584,"بمن أباحك قتلي","https://www.aldiwan.net/poem17667.html","المجتث"],[584,"ما بين هجرك والنوى","https://www.aldiwan.net/poem18025.html","مجزوء الكامل"]],"verses":[["يا أَحَقَّ الوَرى بِمَمحوضِ إِخلا","صي وَأَولاهُمُ بِغايَةُ شُكري",0,"ر",2,0],["يا أحمدَ ابنَ أبيهِ","ويا ربيب حُرَيْثِ",1,"ث",1,1],["يا أحمدَ الخيرِ المُؤَمْ","مَل حين تُخشى العَنْقفيرُ",2,"ر",1,0],["يا أحسنَ العالمين حاسرةً","وأكمل الناس عند معتجَرِ",3,"ر",1,0],["يا أحمد الخير يا من لا يعد له","بدء جميل بسوء العود مخلوف",4,"ف",1,0],["يا أحمد بن سعيدٍ لا تَمتْ جزعاً","فالحبُّ طعمانِ ممرورٌ ومعسولُ",5,"ل",1,1],["يا أحمد بن سعيدٍ لو بصُرتَ بها","إذ الأكفُّ لساقيها خلاخيلُ",5,"ل",1,0],["يا أحمد بن سعيدٍ لو بصرت بها","وذيلُها لأيورِ القومِ منديلُ",5,"ل",1,0],["يا أحمدَ المحمودَ إن عيونَنا","أضحتْ كما أمستْ عليك سخائنا",6,"ن",2,0],["يا أَحسَنَ الناسِ يا مَن لا أَبوحُ بِهِ","يا مَن تَجَنّى وَما أَحلى تَجَنّيهِ",7,"ي",2,0],["يا أَحسَنَ العالَمينَ خُلقاً","مِثلُكَ لا يَرتَضي بِظُلمي",8,"ي",1,0],["يا أحمد الخيرات ما أنا بالغ","تلك الخلال وإن لمست رثاءها",9,"ا",3,0],["يا أحمد القانونُ بعدك غامض","قلِق البنود مجلل بسواد",10,"د",1,0],["يا أَحمَدَ الخَيرِ لي جاهٌ بِتَسمِيَتي","وَكَيفَ لا يَتَسامى بِالرَسولِ سَمي",11,"م",2,0],["يا أَحسَنَ الصَبرِ زُر أَولى القُلوبِ بِها","وَقُل لِصاحِبِهِ يا أَنفَعَ السُحُبِ",12,"ب",1,0],["يا أَحمَدَ بنَ مُحَمَّدٍ نَضَبَ النَدى","مِن كَفِّ كُلِّ أَخي نَداً ياءَحمَدُ",13,"د",1,0],["يا أَحمَدَ بنَ أَبي دُؤادِ","وَالحادِثاتِ بِكُلِّ نادِ",14,"د",1,1],["يا أَحسَنَ الناسِ ريقاً غَيرَ مُختَبِرٍ","إِلّا شَهادَةَ أَطرافِ المَساويكِ",15,"ك",1,1],["يا أحكم الحكماء لا","يفتى وفي الأوقاف مالك",16,"ك",1,0],["يا أَحمَدَ اِبنَ أَبي دُاودٍ دَعوَةً","ذَلَّت بِشُكرِكَ لي وَكانَت رَيِّضا",17,"ض",2,0],["يا أَحمَدَ بنَ أَبي دُوادٍ حُطتَني","بِحِياطَتي وَلَدَدتَني بِلُدودي",18,"د",2,0],["يا أحباي وكم من عثرة","سلفت ما بالُ هذي لا تقال",19,"ل",1,0],["يا أَحسَنَ العالَمينَ وَجهاً","ما لَكَ مِن أَن تُحِبَّ بُدُّ",20,"د",1,0],["يا أَحمَدَ المُرتَجى في كُلِّ نائِبَةٍ","قُم سَيِّدي نَعصِ جَبّارَ السَمَواتِ",21,"ت",1,0],["يا أحمد اثبت في مكانك باسلاً","لا يوهننّك منهم الإرهاب",22,"ب",1,0],["يَا أَحْمَدَ الخَيْرِ يَا مَنْ","أَسْدَى وَأَجْزَلَ عُرْفَهْ",23,"ف",2,0],["يَا أَحْمَدَ الآبَاءِ مَا","ذَا فِي ابْنِكَ الغَالِي دَهَاكْ",24,"ك",1,0],["يَا أَحِبَّاءَنَا بِدَارٍ تَنَاءَتْ","وَهْيَ مِنَّا مَثَابَةُ الأَشْوَاقِ",25,"ق",1,0],["يا أحبايَ وما أصبرَكم","أحسَنُ الأحباب من لم يَصبِر",26,"ر",1,0],["يا أحمَدُ بنُ مُحَمّدٍ نَضبَ النّدَى","مِنْ كَفّ كلّ أخي نَدىً، يا أحمَدُ",27,"د",1,0],["يا أَحمَد العَظماءِ يا مَن بابة","لِلسائِلين مُجرب مَفتوحُ",28,"ح",1,0],["يا احمد الاولياء العارفين ويا","سلطان اطقابهم يا ملجأ الفقرا",29,"ر",2,1],["يا أحمد القوم يا شبل الحسين ويا","من انت للزهر من آل البتول اب",30,"ب",1,0],["يا أحمد الصبا يا منجد ال","عيان يا صدر صدور الرجال",31,"ل",1,1],["يا أحمد الأوليا يا سيد الصلحا","يا جهبذ الأصفاي يا صاحب العلم",32,"م",1,0],["يا أحقر الناس في عيني وأسمجهم","إني لآنف أن أدعوك إنسانا",33,"ن",2,0],["يَا أحوَلَ العَينِ لاَ تَجنَح إِلَى الدَّينِ","وَلاَ تَكُن جَاهِلاً يَا أحوَلَ العَين",34,"ن",1,1],["يا أحمدَ العدلِ والإحسان حُيِّيتَا","ونلتَ من طيبات المُلكِ ما شِيتَا",35,"ت",2,1],["يا أحسن الناس عندي","هلا رثيت لحالي",36,"ي",1,1],["يا أَحضَرَ الأَمَراءِ في حَسمِ الأَذى","قَولاً وَأَحصَرَهُم غَداةَ سِبابِ",37,"ب",1,0],["يا أَحْسَنَ النَّاسِ وَجهَاً","كان الصُّدودُ جَزائي",38,"ي",1,0],["يا أحمدا يا نجل إسمعيل يا","فرع الملوك وكل أصل نامي",39,"م",2,0],["يا أحمداً أقرضتَ ربّكَ والسرا","ةَ يئنُّ تحتَ رباهمُ المسكينُ",40,"ن",1,0],["يا أحسنَ الفاتنينَ قدّاً","وارفعَ المالكينَ قدرا",41,"ر",2,0],["يا أحمد بن محمدٍ حمداً لمن","جعل الفضائلَ في ذوي الإفضالِ",42,"ل",1,0],["يا أحمد بن عَليّ الباني العلا","والمُستعدُّ لكل خطبٍ نابا",43,"ب",2,0],["يا أحباباً نأوا عني فسال","دمع عيني فوق خدّي كاللآل",44,"ل",1,1],["يا أَحمَدَ اِرفَع رَأسَكَ المَيمونَ قُل","يُسمَع وَسَل تُعطَه بِلا حِرمانِ",45,"ن",1,0],["يا أحرص الناس على مبعرٍ","يدق مستنجاه بالفيش",46,"ش",1,1],["يا أحمد الحمد الذي بمديحه","أبدى الزمان ترنحا وترنما",47,"م",2,0],["يا أحمد المرتضى والمرتجى أبداً","ألستَ من سطواتِ الرومِ تحمينا",48,"ن",2,0],["يا أحمد اللَه بيسر كل ما قد تعسر","ربنا اللَه سبحانه له البر والبحر",49,"ر",1,1],["يا أَحسَنَ خَلقٍ","عَلَيهِ قَد كادَ يَحسُدُ",50,"د",1,0],["يا أَحسَنَ الناسِ أَخلاقاً وَمَعرِفَةً","وَالحِلمُ يُنبِئُ وَالأَعمالُ تَذكارُ",51,"ر",1,0],["يا أَحمَد العَصر طِب نَفساً فَاِنَّكَ مِن","قَوم اِذا وَصَفوا كانوا هُم السَعدا",52,"د",2,0],["يا أحمدُ بنَ عليٍّ القرمُ الذّي","ما زال للدّاعي الصريخِ مُجيبا",53,"ب",2,0],["يا أحمدُ المَحمودُ في أزمةٍ","مَذمُومَةٍ في الشد واللِّينِ",54,"ن",1,1],["يا أحد يا منان يا صمد يا مقصود","هب لنا كل الخير واكف كل أهوال",55,"ل",1,0],["يا أَحُدُ اشهد بحقِّ مَشهَدِهِ","واسعَ لتفصِح بِقَدرِ مَسعاهُ",56,"ا",2,0],["يا أَحم لا تنسَ الدُّعا","لي بالعشيّ وبالغُدُوّ",57,"د",2,1],["يا أَحْمَ دعوةَ عانٍ قلّ ناصرُهُ","وخانَهُ لِجفَا الدّهرِ الأحبَاءُ",58,"ا",2,0],["يا أُحَيْبَابنا وقولي تصغيراً","أَحَيبابنا ألذّ وأَحْلاَ",59,"ل",2,0],["يا أحبائي لقد أحسنتم","إذ طويتم فيه أخبار الوطن",60,"ن",1,0],["يا أحمد القرشي هذا معجز","أففي البلاغة للنبوة تدعي",61,"ي",1,0],["يا أحمد جوزيت عن أحمد","وآله في يومك الآخر",62,"ر",1,0],["يا أحِبَّايَ بسفح المنحنى","هل غصون البان بعدي رويت",63,"ت",1,0],["يا أحبائي رفقاً إننا","مثلما أنتم منحنا النوبا",64,"ب",2,0],["يا أحسنَ النّاس مِنهُ دَلاّ