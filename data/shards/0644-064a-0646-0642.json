ry.dctabudhabi.ae/diwan/poem/94567","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73156","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83401","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28774","الوافر"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117225","الوافر"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117214","الطويل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104513","الهزج"],[4907,"لئن قلد الناس الأئمة إنني","https://www.poetsgate.com/ViewPoem.aspx?id=127125",""],[5017,"لَعمرُ أبيك الخير إنِّي لكاتبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=187190",""],[5290,"سريتم وطرفي من كرى العزم ما هبا","https://www.poetsgate.com/ViewPoem.aspx?id=113129",""],[5397,"سالمت دهرا لا يريك التهانيا","https://www.poetsgate.com/ViewPoem.aspx?id=157960",""],[5409,"تركت وراءك البلد الأمينا","https://www.poetsgate.com/ViewPoem.aspx?id=155482",""],[5616,"أغنيةُ صمودٍ للمخيَّمِ الفلسطيني","https://www.poetsgate.com/ViewPoem.aspx?id=205219",""],[5776,"رملٌ يسافرُ بالواحة","https://www.poetsgate.com/ViewPoem.aspx?id=199342",""],[6056,"دلعهن عالي المستوى","https://www.poetsgate.com/ViewPoem.aspx?id=130337",""],[6142,"لا عذر للعين إن لم تنفجر علقا","https://www.poetsgate.com/ViewPoem.aspx?id=155754",""],[6152,"هواكِ خمري","https://www.poetsgate.com/ViewPoem.aspx?id=203106",""],[4593,"أيا حرفة الزمنى الم بك الردى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=610660",""],[520,"وحق المعالي يا اباها وصنوها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577525",""],[520,"لئن قل صبر فالمصاب عظيم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577644",""]],"verses":[["لَئِن قَرَّبَ اللَهُ النَوى بَعدَ هَذِهِ","وَكانَ لِرَوحاتِ المَطيِّ بَلاغُ",0,"غ",1,1],["لَئِن قَطَعَ اللِقاءَ غَرامُ دَهرٍ","لَما اِنقَطَعَ التَوَدُّدُ وَالإِخاءُ",1,"ا",2,0],["لَئِنْ قَدَّمَتْهُمْ عُصْبَةٌ خانَها النُّهى","فَهَلْ ساقِطٌ لَمْ يَحظَ يَوْماً بِلاقِطِ",2,"ط",1,0],["لَئِنْ قَصُرَتْ أيّامُ أُنْسي بقُرْبِكُمْ","فَلَيْلي على نأيِ المَزارِ طَويلُ",3,"ل",1,0],["لَئِنْ قَدُمَتْ تلكَ المَساوي وأُكْبرَتْ","فما صَغُرَتْ عَنها مَعايِبُ تَحدُثُ",4,"ث",1,0],["لَئِنْ قَلِقَتْ أعْطافُهُ في وِشاحِهِ","فكمْ أقْلَقَتْ قلْبَ المَشوقِ بوَجْدِهِ",5,"د",2,0],["لَئِن قَتَلتُم عَميداً لَم يَكُن صَدَداً","لَنَقتُلَن مِثلَهُ مِنكُم فَنَمتَثِلُ",6,"ل",1,0],["لَئِن قَصَّرَ اليَأسُ مِنكِ الأَمَل","وَحالَ تَجَنّيكِ دونَ الحِيَل",7,"ل",1,1],["لَئِن قَلَّ في أَهلِ الزَمانِ عَديدُكُم","فَإِنَّ دَرارِيَّ النُجومِ قَلائِلُ",8,"ل",1,0],["لَئِن قيلَ في الجِدِّ النَجاحُ لِطالِبٍ","لَقَلَّ غَناءُ الجِدِّ ما لَم يَكُن جَدُّ",9,"د",1,0],["لَئِن قَطَع اليَأسُ الحنَيَن فَإِنَّهُ","رَقوءٌ لِتذَرافِ الدُموعِ السَوافِكِ",10,"ك",1,0],["لئن قد طواه الموت عنّا فذكره","من العلم منشور على الدهر دائم",11,"م",1,0],["لئن قصَّرت أفكارنا عن مديحهِ","لقد طالَ في ليلِ السطورِ ادِّلاجها",12,"ج",3,0],["لئن قصرت أيدي المطالب بعده","لعهدي بها موصولة بحباله",13,"ل",2,0],["لئن قَبُحتْ منّي لديك الظَّهائرُ","لحسْبُك حسناً ما تُجِنُّ الضمائرُ",14,"ر",1,1],["لَئِن قَعَدَت عَنكَ أَجسامُنا","لَقَد سافَرَت مَعَكَ الأَنفُسُ",15,"س",1,0],["لَئِن قَلَّ التَواصُلُ أَو تَمادى","بِنا الهِجرانُ عاماً بَعدَ عامِ",16,"م",1,0],["لِيَنقُضنَ تَوكيدَ العُهودِ الَّتي لَهُ","لَأَمسَت ذُراها وَهيَ دُكٌّ وُعورُها",17,"ر",3,0],["لَئِن قَيسُ عَيلانَ اِشتَكَتني لِمِثلِ ما","بِها يَتَشَكّى حينَ مَضَّت كُلومُها",18,"م",3,1],["لِيَنقُلنَها لَم يَستَطِعنَ الَّذي رَسا","لَها عِندَ عالٍ فَوقَ سَبعينَ دائِمِ",19,"م",1,0],["لَئِن قلتُ فيه صحّ تأليفُ سُؤدَدٍ","فبارعُ نَقْلٍ من شمائِلِك استملى",20,"ل",2,0],["لئنْ قضيتَ عليهِ","ليقضيَنَّ عليكا",21,"ك",2,0],["لَئِنْ قَلَّ الذي أُوتِينَ مِنْهُ","فأجرُ الله مَوفورٌ جَزيلُ",22,"ل",1,0],["لَئِن قِستُكَ بِالبَدرِ","وَغُصنِ البانَةِ النَضرِ",23,"ر",1,0],["لَئِن قَليبُكَ جاشَت بِالسَماحَةِ لي","لَقَد وَصَلتُ بِشُكري حَبلَ ماتِحِها",24,"ح",3,0],["لئن قلتم جسمي نحيل فذا جسمي","يرقيكم أعلى المعالي بلا رسم",25,"م",1,1],["لئن قصرتْ باعُ الزيارة عنكُم","فإنى لباعِ الوُدّ غير مُقصّرِ",26,"ر",1,0],["لينقعاها بسجل من نميرهما","يندى به القلبُ والأحشاءُ والكبد",27,"د",1,0],["لَئِن قَبُحَت في عَينِ شانيكَ مَنظَراً","لَقَد حَسُنَت عِندَ الخِلافَةِ مَوقِعا",28,"ع",2,0],["لَئِنْ قَطَعَ الوَاشُونَ مَا كانَ بَيْنَنَا","فَحَظُّكَ مِنْ قَلْبِي عَلَيْكَ مَصُونُ",29,"ن",1,0],["لئن قَصَّرت كُتْبي فلا غروَ أنه","لعائقِ عذرٍ والمقاديرُ أُوْهاق",30,"ق",1,0],["لَئِن قَدَّمتَ قَبلي رِجالً فَطالَما","مَشيتُ عَلى رِسلي فَكُنتُ المُقدِما",31,"م",2,1],["لَئِن قَعَدَ الزَمانُ بِكُلِّ حُرٍّ","وَخُصَّ أُولي الجَهالَةِ بِاليَسارِ",32,"ر",1,1],["لين قده قسا","قمر خده شفق",33,"ق",1,0],["لَئِن قَصُرَت بِمَن تَهوى اللَيالي","فَإنَّ فُتوحَ والِدها طويلَه",34,"ل",2,0],["لِيُنْقِذَنِي مِمَّا اقْتَضَاهُ خِصَامُهَا","بِعَارِفَةٍ مِنْ بِرِّهِ النَّافِحِ الْعِطْرِ",35,"ر",1,0],["لئن قطع الغيث الطريق فبغلتي","وحاشاك قبقابي وجوختي الدارُ",36,"ر",1,1],["لئن قيل إن الخير يبلغه الفتى","بسعى فمولانا بتاريخه بلغ",37,"غ",1,0],["لئن قَتَلتني عينُها ألفَ مرَّةٍ","فكم قتلت عمداً وكم قتلت سَهوا",38,"و",2,0],["لئن قلتِ في خَصرنا رقَّةٌ","فقلبي وشِعري ولفظي أرَق",39,"ق",1,0],["لينُ قولٍ وَبسطُ وجهٍ وكفٍّ","من يشِم منه بارقاً نال وبله",40,"ل",2,0],["لَئِن قصّر الإعراض خطوي فإنّ لي","رجاء إِلى مَغناك يُنهضني وثبا",41,"ب",2,0],["لَئن قيلَ نور الشمس أَكسبها سناً","فَللشَمس مِن إِشراق وَجهِكَ نورُ",42,"ر",1,0],["لَئِن قوسِمتَ في ثَمَراتِ نَفسٍ","جَناها ذا الحِمامُ وَأَيُّ جانِ",43,"ن",1,0],["لئِن قصَّر الشِّعرُ عن وَصفِها","لقد أسمَع الثقلين اعتِذارَه",44,"ر",2,0],["لَيِّنْ قَساوَتَه لِي أَو فَيَسِّرْ لي","صَبراً لأَحظى بِوَصْلٍ أَو بِسُلوانِ",45,"ن",1,0],["لئنْ قصَّرتُ فيما جئتُ منها","فقد تتلى اقتصاراً واختصارا",46,"ر",2,0],["لئن قلّد النعماء من كانَ منعماً","فما غيره في الناس كانَ مقلّدي",47,"د",2,0],["لي نقلةٌ ليستْ تُفَتَّر دائماً","والبدرُ غير مُفَتَّرٍ في النُّقلة",48,"ه",1,0],["لئن قعدت من لؤمه أربعٌ به","لقد نهضت أضدادها بك أربعُ",49,"ع",1,0],["لئن قمتَ فيه بشرط الوفاء","على فَوْرةٍ لم يعقها فتورُ",50,"ر",1,0],["لئن قَصَّر المقدارُ خَطوِيَ عنكُمُ","فلي غايةٌ في بعثها وقُصارُ",51,"ر",1,0],["لئن قَصُرت مساعيها وضاقت","ففي الأشواقِ طولٌ وانفساحُ",52,"ح",1,0],["لئن قُربَّنَ بعدَ البينِ منّي","وراجعَ عازبٌ الوصلِ الشريدِ",53,"د",1,0],["لئن قرَّبَ الأحبابُ منّي مزارهمْ","وأصبحَ زَنْدُ البينِ بالوصلِ أجذَما",54,"م",2,0],["لئن قل صبر فالمصاب عظيم","وإن جل شكر فالثواب جسيم",55,"م",1,1],["لَئن قامَ عن تقصيرِنا منهُ عاذرٌ","فمِنَّا عليهِ ناصحٌ وعَذُولُ",56,"ل",1,0],["لئن قَصَّرَتْ خُطوةُ الحظّ بي","فماليَ عن هِمّتي مُنْتَزَح",57,"ح",1,0],["لي نِقْض من عقب التّعَكّيف","يَنْحي على ذاكَ المضمَّر",58,"ر",1,0],["لَئن قَصَّرتَ يا شُكري","فَحَمدي لَم يَزَل دَأبي",59,"ب",2,0],["لئن قَسا قلبك فالقَدُّ لان","لِلَّهِ لَيلٌ مَرَّ حلوَ الجنى",60,"ن",2,0],["لئن قَصَرَت يدُ النَّكَبات خَطْوي","وَألزَمَني تَحَيُّفُهُنَّ خِيسي",61,"س",2,0],["لئِن قِيدَ بالوَاوَينِ والميمِ لِلدُمى","أَبِيٌّ وبالنُونَينِ صِيدَت ضَراغِمُ",62,"م",1,0],["لئن قُوِّضَتْ فاراتهم وتحَمَّلوا","لقد نُصِبَتْ في خاطِري وبه حَطُّوا",63,"ط",3,0],["لئن قادَهُم يوماً إلى الحتف مصرع","وأوردهم للمورد العذْب مشرع",64,"ع",1,0],["لَئِنْ قَطَعَ المُهَنَّدُ دُونَ غِمْدٍ","فَسَيْفُ اللَّحْظُ أقْطَعُ فِي الغُمُودِ",65,"د",1,0],["لَئِنْ قَصَّرَ النُّظَّامُ فِي مَدْحِكَ الذِي","أسَاهِمُ فِي تَطْوِيلِهِ وَأشَاطِرُ",66,"ر",1,0],["لَئِن قَلَّ أَربابُ المَكارِمِ وَالعُلا","لِيَحيى كَثيرٌ في العُلا وَالمَكارِمِ",67,"م",1,1],["لَئِن قَلَّ قرعي بابكم مُنذُ أزمنٍ","فما قلَّ قرعُ الباب وسط الضمائر",68,"ر",1,0],["لئن قبلت عنى لأيديك ظاهرا","وبطنا فهذا بعض ما أنا أقصد",69,"د",1,0],["لئن قعدت بي قلة المال قعدة","فما أنا عن كسب المعالي بقاعد",70,"د",1,1],["لئن قطعت إذ شبت حبلي بثينة","فاني لها عمر الزمان جميل",71,"ل",1,0],["لَئِنْ قَطعْتَ عنِ الأَجفانِ راتِبَها","من الكَرَى فَلَها من دَمْعِها جَارِي",72,"ي",1,0],["لِئِن قَدَرَت نَفسي عَلى ذاكَ إِنَّها","عَلى تَركِ ما تَهوى مِنَ الحُبِّ أَقدَرُ",73,"ر",1,0],["لئن قَدَمَتْ مخول الشعر قبلي","أراني في مقدمها جوادا",74,"د",2,0],["لينقطعنّ الود إلا وسيلة","غروراً لهم بالموت إن هي غرت",75,"ت",1,0],["لئن قد رماه الدهر في ليث غابه","واجرى من العين القريحة عندما",76,"م",2,0],["لئِن قيل في بعضً يقارِقُ بعضَهُ","فإنّيَ قد فارقتُ منك جميعي",77,"ي",1,0],["لئن قلت لي أفرطت في مدحك الطلا","وقد همت في وادي الخلاعة والشطح",78,"ح",1,0],["لئن قيل قد يأتي الزمان بمثلها","منعنا وقلنا لا نسلمه دفعا",79,"ع",2,0],["لئن قعدت فيه نواهضُ عزمةٍ","فكم قائم يختار في العزّ مقعدا",80,"د",2,0],["لئن قال عن خير اقاويله غدت","هباء ويبدي القول بالشر واحدا",81,"د",2,0],["لئن قتلوا ضحايا الجوع يوما","فمن تفريطكم كان السلاح",82,"ح",1,0],["لئن قذفُوا رجما فشهبُ مقاولي","بهنّ شياطينُ القواذف ترجُمُ",83,"م",1,0],["لَئِن قصرَّتُ فيكَ فَلَيسَ بدعٌ","فقد قصرَّتُ عنكَ كمثلِ ذاكا",84,"ك",2,0],["لئن قام أحياءُ الدروز لحتفهم","فيا ريحَ من أخَنى عليه ضلاله",85,"ل",2,0],["لئن قادونك للطاغي أسيراً","وآل اللَه حولك كالاماء",86,"ا",2,0],["لئن قضيت لهيف القلب من عطش","فالأرض صيرت من فيض الدما لججا",87,"ج",2,0],["لئن قد نمى في ربوة الحسن غصنها","فغصن بياني قد نمى في رُبى الفكر",88,"ر",1,0],["لئن قَلت يَوماً في سِواهُم فَطالَما","قَرَعَت عَلى ما قُلتَهُ سن نادم",89,"م",1,0],["لَئن قُلت لَم أَحرم فَفي الحال شاهد","وَإِن قُلت لَم أَرحَم فَمِن لي بِشاهد",90,"د",1,0],["لَئن قيل لي قَد طالَ عَهد وَفائِهِ","بِوَعد أَقول الوَعد شَأن الأَكارم",91,"م",1,0],["لَئن قَد حَمى عن ثغرها كلّ حائم","فَما زال يحمي عن مطالبهِ الثغرُ",92,"ر",1,1],["لئن قام من بعدِ النّظامِ مَكانَهُ","لنا العِزُّ منهم والمُؤيَّدُ والفَخر",93,"ر",1,0],["لِئن قذفتْ ذوبَ اللُجينِ على الثرى","لقد خلَّصتْهُ القُضْبُ حَلْياً لأجيادِ",94,"د",1,0],["لئن قلت غصن فقد بان لي","على خده بعض ما يثمر",95,"ر",1,0],["لئن قُدِّمتَ في همز وغمز","وأُخِّر كلّ ذي عقل ودين",96,"ن",1,1],["لئن قلت إني بالزبيب أشبّه","لريقك أظلمت المشبه في الحدّ",97,"د",1,1],["لئن قيل إن الناس ماتت فربّنا","لنا خلفٌ من كل تالفةٍ نفساً",98,"س",2,1],["لينقذوا الجثة من أياس","واويبهم في ذلك الوسواس",99,"س",1,0],["لَئِن قَد جارَ عُدواناً وَظُلماً","لِأَشكوهُ إِلى رَبِّ الشَهامَه",100,"م",2,0],["لئن قبح السؤال وأنت حي","فقد حسن السؤال وأنت سال",101,"ل",1,0],["لَئِن قلَّ سَعدُ المرء زادَت مطالبُه","وَقَد خابَ مسعاهُ وَناءَت رغائبهُ",102,"ب",2,1],["لئن قد حاور الشعراء مدحاً","لضاق الطارس وانقطع المداد",103,"د",1,0],["لئن قيل بدرٌ قلتُ هذي تز