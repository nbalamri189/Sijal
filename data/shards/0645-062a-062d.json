"اذهب لمصنعك الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=193166",""],[5956,"مَن حقق الأحلام إلا فارسٌ؟","https://www.poetsgate.com/ViewPoem.aspx?id=193206",""],[5956,"السيرة الذاتية للدكتور قيسٍ الرِّضواني بالشعر الروحاني","https://www.poetsgate.com/ViewPoem.aspx?id=215553",""],[5975,"في ولاء آل بيت الرسول","https://www.poetsgate.com/ViewPoem.aspx?id=53465",""],[6093,"قالوا: خرجتَ عن القديم أجابهم (الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=176081",""],[6093,"أَلِهَ المُعنى ما يُحيرُ جوابا","https://www.poetsgate.com/ViewPoem.aspx?id=177706",""],[5075,"ماذا جنى الأحرار ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82761&r=&rc=7",""],[6225,"محاسبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80910&r=&rc=179",""],[6237,"جبل فيفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77861&r=&rc=3",""],[572,"عاداتُ طيفِكَ أّن يعاوِدْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9254&r=&rc=111",""]],"verses":[["مُتَحَيِّرٌ عِندَ النَوا","ئِبِ مُستَريبٌ بِالأُمورِ",0,"ر",1,0],["مُتَحَلِّقاً حَتّى تَكونَ ذُيولُهُ","أَبَدَ الزَمانِ عَمائِماً لِلفَرقَدِ",1,"د",1,0],["مُتَحَلِّياً عَذراءَ كُلِّ سَحابَةٍ","تَغذو الجَميمَ بِرَوضَةٍ عَذراءِ",2,"ا",2,0],["مُتَحَرِّقٌ فَإِذا رَأَتكَ لِحاظُهُ","نَسِيَت مَجامِعُ قَلبِهِ الشَحناءَ",3,"ا",2,0],["مُتَحَلِّبِ الكَفَّينِ مِث","لِ البَدرِ قَوّالٍ وَفاعِل",4,"ل",1,0],["مُتَحَرِّجٌ حامي الحَقيقَةِ حافِظٌ","حُشِيَت حَشا حُسادِهِ بِجِراحِ",5,"ح",1,0],["مُتَحَمِّلٍ حيفَ الحَميمِ لِحاجَةٍ","فَدَحَت وَحَتفٍ لِلحَسودِ مُتاحِ",5,"ح",1,0],["مُتَحَزِّماً بِالسَيفِ يَركَبُ","رُمحَهُ حالاً فَحالا",6,"ل",2,0],["مُتَحَوِّلٌ لَكِنَّهُ مُتَمَكِّنٌ","مِنْ نَفْس فِي مِحْوَرِ الدَّوَرَانِ",7,"ن",1,0],["متحدات من الحراسي كالحلية","منها السموط والحقب",8,"ب",1,0],["متحجباً بضياءِ سؤدَدِه","ولُهاهُ سافرةٌ بلاَ حجب",9,"ب",1,0],["متحرِّزاً حتى لخَالكَ خائلٌ","رجلاً شديد الجُبْن أو مُتجابِنا",10,"ن",2,0],["مُتَحامِيَينِ المَجدَ كُلٌّ واثِقٌ","بِبَلائِهِ وَاليَومُ يَومٌ أَشنَعُ",11,"ع",1,0],["مُتَحَلِّبُ الكَفَينِ غَيرُ عَصِيِّهِ","ضَيقٍ مَحَلَّتُهُ وَلا جَدبِ",12,"ب",1,0],["مُتَحَلِّياً هِبَةَ النُبو","غِ مُطَوَّقَ المِنَحِ الرِغابِ",13,"ب",1,0],["متحاربانِ مِجَنُّ ذا قد صاغَهُ","من فضةٍ ولذا مِجَنٌّ مُذْهَبُ",14,"ب",1,0],["مُتَحَيِّرٌ يَغدو بِعَزمٍ قائِمٍ","في كُلِّ نائِبَةٍ وَجَدٍّ قاعِدِ",15,"د",1,0],["مُتَحَلِّياً مِن كُلِّ حُسنٍ مونِقٍ","مُتَنَفِّساً بِالمِسكِ أَيَّ تَنَفُّسِ",16,"س",1,0],["مُتَحَنٍّ عَلى الخِلافَةِ ما يَن","قُصُ في حَظِّها وَلا يَغتالُ",17,"ل",1,0],["متحرراً من قيد ظلمته","يرنو بعمق الروح بالأحداق",18,"ق",1,0],["مُتَحَمِّلِ العِبءِ الثَقيلِ بِمَنكِبٍ","أَيدٍ وَلَم يَشدُد لَهُ مِن مِئزَرِ",19,"ر",1,0],["مُتَحَمِّلاً فَصّاً يَروقُ وَحَلقَةً","مِن جُذوَةٍ وَقَدَت وَماءً سالا",20,"ل",2,0],["مُتَحَكِّمٌ يبغِي الحياةَ بأسرِها","ويخالُ أنّا في يَدَيْهِ نِبالُ",21,"ل",1,0],["مُتَحَلِّياً بِجَوَامِعِ الكَلِمِ التي","يُعْنَى بها حَدِبٌ عناءَ تَجَلُّدِ",22,"د",1,0],["مُتَحاسِدينَ عَلى لِقاءِ مُسَوَّدٍ","رَحبِ الفِناءِ جَدٍ عَلى أَصحابِهِ",23,"ب",2,0],["متحملاً من عسفه","ما لَيسَ يحمله الوَصيف",24,"ف",1,0],["متحركات ما لها","حتى النهاية من قرار",25,"ر",1,0],["متحركات في السما","ء تخال أن لهنَّ قصدا",26,"د",2,0],["مُتَحَكِّمٌ في كُلِّ جِسْمٍ ناعِم","مُتَدَلِّلٌ مَا بَيْنَ أَلْحَاظِ الكِعَاب",27,"ب",1,0],["مُتَحَمِّلٌ مَا لَوْ تَحَمَّلَ بَعْضَهُ","أَهْلُ الْمَحَبَّةِ وَالْغَرَامِ لَفَاظُوا",28,"ظ",3,0],["مُتُحَدِّثينَ وَلاَ يَطِيبُ لِمِثْلِهِمْ","إِلاَّ حَدِيثُ الحُسْنِ وَالحَسْنَاءِ",29,"ا",2,0],["مُتَحَرِّزاً حَتى تحَيَّنَ","نُهْزَةَ اللَّبِقِ المُدَاوِرْ",30,"ر",1,0],["مُتَحَيِّرونَ فَباهِتٌ مُتَعَجِّبٌ","مِمّا يَرى أَو ناظِرٌ مُتَأَمِّلَ",31,"ل",1,0],["متحرِّرًا من كل قيدٍ عقُلهُ","لا يُصلحُ العقلُ المُقيَّدُ فاسدا",32,"د",2,0],["متحدِّثٍ لبقٍ، كأن حديثه","زهْرُ الرِّياض يزفه «آذار»",33,"ر",1,0],["مُتحَيِّرٌ لا يستَحِمُّ بهِ","فَلَكٌ ولا الأضواءُ تُرشِده",34,"د",2,0],["متحدَّياً حُكمَ الطباعَ ! ودافعاً","غَضَبَ السَّماءِ وللقضاءِ مُغالِبا!",35,"ب",2,0],["مُتَحجب مُتَمنع كَم مِن شَجٍ","مُلقى عَلى عَتَباتِهِ أَوّاه",36,"ه",1,0],["مُتَحَسِّراً نَضَحَ الهِناءَ بِهِ","نَضحَ العَبيرِ بِرَيطَةِ العَصبِ",37,"ب",1,0],["مُتَحَلِّياً مُتَخَلِّياً مُتجَلِّياً","مُتَرَقِياً مَتَرَفِّقاً مُتَلَطِّفَا",38,"ف",2,0],["متحمِّلٌ أعباءَ كُلِّ عظيمةٍ","بالنفعِ والإضرارِ",39,"ر",1,0],["متحلِّلِى عُقَد الضغائنِ كلَّما","نصبَ الحسودِّ لنا حِبالة ماكرِ",40,"ر",1,0],["متحكَّمٌ في القول يلقُط دُرَّه","غَوصِى ولو من قعر بحر زاخرِ",40,"ر",1,0],["مُتَحَقِّقاً أَن لَو دَعَوتَ مَليكَهُ","لَأَتاكَ إِسلاماً أَوِ اِستَسلاما",41,"م",2,0],["مُتَحَلِّبُ الكَفَّينِ غَيرُ غُضُبَّةٍ","جَزلُ المَواهِبِ مُخلِفٌ ما يُتلِفُ",42,"ف",1,0],["مُتَحدِّراً مُتَكَسِّراً مُتنثِّراً","في الحوضِ والروضِ الكثيفِ يقينا",43,"ن",2,0],["مُتَحَيِّزاً في رَبعِهِ مُتَشاغِلاً","بِذَوي المِلاحَةِ عَن لِقا الإِخوانِ",44,"ن",1,0],["مُتحدِّرِينَ خلالَ حُجْبِ جلالةٍ","من كُلَ أغلبَ باسلٍ هِرْماس",45,"س",1,0],["مُتحلِّبُ للوفدِ خِلْفُ نَوالِه","أبداً بلا مَرْيٍ ولا إبساس",45,"س",1,0],["متحلياً ببراعة وفصاحة","تزري بقُسِّ في صميم أياده",46,"د",2,0],["مُتَحَلِّباً فَوقَ الرِّدَاءِ","يُجُولُ مِن رَقراقِهَا",47,"ق",3,0],["متحملين من الخلافة ثقلها","ومن المكارم أَشرف الأَعباء",48,"ا",2,0],["متحدّثات أنهنّ لَقائحٌ","ينتجن أضعافا لها أمثالا",49,"ل",2,0],["متحرياً بهدايتي وأدائه","في حيث لا تجد القطاةُ المفحَصا",50,"ص",2,0],["متحرك في مائجٍ كصفائح","الميناء ألقي فوقهنَّ الزيبق",51,"ق",1,0],["مُتَحَمِّلٌ ثِقَلَ الأُمورِ حَوى لَهُ","سَبقَ المَكارِمِ سَابِقٌ مُتَمَهِّلُ",52,"ل",1,0],["متحققاً بمحبتي لجنابكم","والحب رنة سره أصليه",53,"ي",2,0],["متحدر من نسل حيدر طاهر","إن الطهور العذب نسل غمام",54,"م",1,0],["مُتَحَيِّراً طَلَعَت لَهُ شَمسُ النُهى","فَمَشى عَلى سَنَنِ الطَريقِ الأَقصَدِ",55,"د",1,0],["متحقق قلم الهبات ولوحها","أنا بلبل الأفراح أملأ دوحها",56,"ه",2,0],["مُتحجِّبٌ جَعَلَ المدامعَ في الهَوَى","ماءً لمن جَعَلَ الصَّبابةَ زادَهُ",57,"د",2,0],["مُتَحَكّمٌ أَعْطاهُ مُلْكَ جَوانِحِي","مَلِكُ الجمالِ أَقلّه وأجلّهِ",58,"ل",2,0],["مُتَحَمِّلُونَ مِنَ الخِلافَةِ هِمَّةً","عَفَّت عَلى طَمَعِ العَدُوّ بياسِ",59,"س",1,0],["مُتَحَمِّلٌ ما لا يُطاقُ بِكاهِلٍ","لَو حُمِّلَ الدُّنا لَكانَ مُطيقا",60,"ق",2,0],["مُتَحلياً بحُلَى فَخارٍ زانَهُ","حلمٌ وَفَضل واضح البُرهان",61,"ن",1,0],["مُتحرّياً إِرضاءَهم لو أنهم","يُبدون أنِّي جئتُ بالإرضاءِ",62,"ا",2,0],["متحالفين على العسير وهل على","متيسّر صدقت لهم أيمان",63,"ن",1,0],["متحجب في غيبك ال","أحمى منيع في علائك",64,"ك",1,0],["متحمل عِبْءَ النوازل قائم","في كشفها بمهنَّد وسِنانِ",65,"ن",1,0],["متحمل عِبْءَ المحبّة رافع","صبري عليك بما أردتُ مطاوع",66,"ع",1,0],["متحليّا ابهى الحلا متعطّرا","بدلاً من التعطيل والإنتان",67,"ن",1,0],["متحف بالسداد فيما يراه","وله أينما توجه فتح",68,"ح",1,0],["متحفّزين منرفزين","يهددون علانية",69,"ي",2,0],["متحير يمضي فيعطفه نعي","نعي يرن وعبرة تذرى",70,"ر",2,0],["متحَمّل في حال كل كريهة","متنبّه للحادث المتَوقّعِ",71,"ع",1,0],["متحركاً لسماعكم","سكران من تكليمكم",72,"م",1,0],["متحمل الأثقال عنا وَالعَنا","وَمُهَيمن التَخفيف وَالتَرجيح",73,"ح",1,0],["متحيراً متأسفاً","ولَفي يدي قد اسقطا",74,"ط",2,0],["متحشع نصب الزمان لكيده","حرباً فراش سهامها ونصالها",75,"ل",3,0],["متحملاً من عبثه خطراً","يعيا به الضر عامة الورد",76,"د",1,0],["متحف السيد الشهيد بنظم","هو للخود حلية الأعناق",77,"ق",1,0],["مُتَحَيِّرينَ كَما تَحا","رُ البَهمُ بَعدَ رِعائِها",78,"ا",3,0],["مُتَحَفِّزونَ لِكُلِّ كارِثَةٍ إِذا","عَزَّ التَخاطُبُ وَالحَديدُ تَكَلَّما",79,"م",2,0],["مُتَحَفِّزاً أَبَداً لِكُلِّ مُلِمَّةٍ","ماذي العَزيمَةِ مِثلَ سَهمٍ صارِدِ",80,"د",1,0],["متحير سال الوقار على","عطفيه من كبر ومن كبر",81,"ر",1,0],["مُتحرّساً متمرّساً","بطريدة العيشِ المرَاغَه",82,"غ",2,0],["مُتَحَمِّلٌ ثِقلَ الخُطوبِ إِذا الفَتى","أَعياهُ حَملُ النائِباتِ وَأَجهَضا",83,"ض",2,0],["متحيزاً في دولة ما عقها","إلا عدو هدى وعابد مال",84,"ل",1,0],["متحامياً شكوى البوارح مانعاً","مكنون وجدي ان يجوز لهاتي",85,"ت",2,0],["متحملاً عبء الذنوب فمذ بدا","علم النبوة مُحِّصَتْ آثامي",86,"م",2,0],["مُتَحَرِّفا لِلجانِبَينِ إِذا جَرى","خَذِما جَوادَ النَزعِ وَالإِرسالِ",87,"ل",1,1],["مُتَحدِّياً في كُلِّ ما تَخْطو بِهِ","ومصِمّماً بالعَزْمِ والإِيمانِ",88,"ن",1,0],["مُتَحِضرٌ مُتقدِمٌ في عَزْمِهِ","أَنْداؤُهُ فاضَتْ على جيرَانِهِ",89,"ن",2,0],["متحيراً والموت ير