{"poems":[[53,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[53,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[53,"أبكيك لو نقع الغليل بكائي","https://www.aldiwan.net/poem30779.html","الكامل"],[53,"أي العيون تجانب الأقذاء","https://www.aldiwan.net/poem30780.html","الكامل"],[9,"هل أنت يا مصلات مب","https://www.aldiwan.net/poem21972.html","مجزوء الكامل"],[71,"حيا محل الحاجبية بالحمى","https://www.aldiwan.net/poem3982.html","الكامل"],[10,"أبكي على البطل الذي","https://www.aldiwan.net/poem21126.html","مجزوء الكامل"],[93,"صدق النعي وردد الهرمان","https://www.aldiwan.net/poem11225.html","الكامل"],[37,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[72,"دمعي عليك مجانس قلبي","https://www.aldiwan.net/poem18235.html","أحذ الكامل"],[51,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[26,"أمن المنون وريبها تتوجع","https://www.aldiwan.net/poem24106.html","الكامل"],[38,"طال العشاء ونحن بالهضب","https://www.aldiwan.net/poem7686.html","الكامل"],[85,"ضربوا القباب على اليباب","https://www.aldiwan.net/poem62925.html","مجزوء الكامل"],[62,"وكأنما الشمس المنيرة إذ بدت","https://www.aldiwan.net/poem52495.html","الكامل"],[45,"عجبا لطيف خيالك المتعاهد","https://www.aldiwan.net/poem62740.html","الكامل"],[45,"مهرج صبوحك سعده لم ينحس","https://www.aldiwan.net/poem64611.html","الكامل"],[45,"أصدود غلا بها أم دلال","https://www.aldiwan.net/poem65596.html","الخفيف"],[97,"فجر جديد حالم خفاق","https://www.aldiwan.net/poem24596.html","الكامل"],[74,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[74,"ما ضار لابس مثله من خاتم","https://www.aldiwan.net/poem13213.html","الكامل"],[105,"وفت الظنون وبرت الآمال","https://www.aldiwan.net/poem42085.html","الكامل"],[67,"أهل التقى والعلم أهل السؤدد","https://www.aldiwan.net/poem18059.html","الكامل"],[50,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85373","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85432","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85324","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30437","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42678","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54532","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5138","الكامل"],[106,"يا راعي الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179702",""],[106,"سمر الأدباء","https://www.poetsgate.com/ViewPoem.aspx?id=179454",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[110,"ما للحبيب المعرض المتلاهي","https://www.aldiwan.net/poem16237.html","الكامل"],[132,"حيوا تماضر واربعوا صحبي","https://www.aldiwan.net/poem24172.html","الكامل"],[133,"أشبهت والدك الأديب المصطفي","https://www.aldiwan.net/poem54801.html","الكامل"],[134,"أعليت دين الواحد القهار","https://www.aldiwan.net/poem4234.html","الكامل"],[143,"كان الوداد منغصا لوشاتنا","https://www.aldiwan.net/poem58379.html","الكامل"],[144,"دم بالصيام مهنأ ما داما","https://www.aldiwan.net/poem11821.html","الكامل"],[250,"إن الفؤاد بآل كبشة مدنف","https://www.aldiwan.net/poem2103.html","الكامل"],[271,"أنهارنا في غاب كسكاتينا","https://www.aldiwan.net/poem35629.html","الكامل"],[321,"يا أيها الخل الذي لم ينسني","https://www.aldiwan.net/poem61704.html","الكامل"],[365,"البحر أجمع لو غدا أنقاسي","https://www.aldiwan.net/poem60869.html","الكامل"],[370,"وصل الكتاب المهتدى برشاده","https://www.aldiwan.net/poem4320.html","الكامل"],[413,"فارقت هنداً طائع","https://www.aldiwan.net/poem42.html","مجزوء الكامل"],[442,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[459,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[459,"أرأيت أم حبست لحاظك عبرة","https://www.aldiwan.net/poem56150.html","الكامل"],[465,"لله أية ليلة قضيتها","https://www.aldiwan.net/poem3510.html","عموديه"],[471,"يبكي لما قلب الزمان جديده","https://www.aldiwan.net/poem4780.html","الكامل"],[501,"آيات تلك الحضرة القدسيه","https://www.aldiwan.net/poem37708.html","الكامل"],[516,"خلعت عليك مواسم الأيام","https://www.aldiwan.net/poem12251.html","الكامل"],[554,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[559,"قلبي الذي في ذاتكم يتقلب","https://www.aldiwan.net/poem34938.html","الكامل"],[563,"قد مد خط عذاره فأجاده","https://www.aldiwan.net/poem52837.html","الكامل"],[587,"ما شئت من عبء الغرام وحمله","https://www.aldiwan.net/poem17688.html","الكامل"]],"verses":[["مُتَحَيِّرٌ عِندَ النَوا","ئِبِ مُستَريبٌ بِالأُمورِ",0,"ر",1,0],["مُتَحَلِّقاً حَتّى تَكونَ ذُيولُهُ","أَبَدَ الزَمانِ عَمائِماً لِلفَرقَدِ",1,"د",1,0],["مُتَحَلِّياً عَذراءَ كُلِّ سَحابَةٍ","تَغذو الجَميمَ بِرَوضَةٍ عَذراءِ",2,"ا",2,0],["مُتَحَرِّقٌ فَإِذا رَأَتكَ لِحاظُهُ","نَسِيَت مَجامِعُ قَلبِهِ الشَحناءَ",3,"ا",2,0],["مُتَحَلِّبِ الكَفَّينِ مِث","لِ البَدرِ قَوّالٍ وَفاعِل",4,"ل",1,0],["مُتَحَرِّجٌ حامي الحَقيقَةِ حافِظٌ","حُشِيَت حَشا حُسادِهِ بِجِراحِ",5,"ح",1,0],["مُتَحَمِّلٍ حيفَ الحَميمِ لِحاجَةٍ","فَدَحَت وَحَتفٍ لِلحَسودِ مُتاحِ",5,"ح",1,0],["مُتَحَزِّماً بِالسَيفِ يَركَبُ","رُمحَهُ حالاً فَحالا",6,"ل",2,0],["مُتَحَوِّلٌ لَكِنَّهُ مُتَمَكِّنٌ","مِنْ نَفْس فِي مِحْوَرِ الدَّوَرَانِ",7,"ن",1,0],["متحدات من الحراسي كالحلية","منها السموط والحقب",8,"ب",1,0],["متحجباً بضياءِ سؤدَدِه","ولُهاهُ سافرةٌ بلاَ حجب",9,"ب",1,0],["متحرِّزاً حتى لخَالكَ خائلٌ","رجلاً شديد الجُبْن أو مُتجابِنا",10,"ن",2,0],["مُتَحامِيَينِ المَجدَ كُلٌّ واثِقٌ","بِبَلائِهِ وَاليَومُ يَومٌ أَشنَعُ",11,"ع",1,0],["مُتَحَلِّبُ الكَفَينِ غَيرُ عَصِيِّهِ","ضَيقٍ مَحَلَّتُهُ وَلا جَدبِ",12,"ب",1,0],["مُتَحَلِّياً هِبَةَ النُبو","غِ مُطَوَّقَ المِنَحِ الرِغابِ",13,"ب",1,0],["متحاربانِ مِجَنُّ ذا قد صاغَهُ","من فضةٍ ولذا مِجَنٌّ مُذْهَبُ",14,"ب",1,0],["مُتَحَيِّرٌ يَغدو بِعَزمٍ قائِمٍ","في كُلِّ نائِبَةٍ وَجَدٍّ قاعِدِ",15,"د",1,0],["مُتَحَلِّياً مِن كُلِّ حُسنٍ مونِقٍ","مُتَنَفِّساً بِالمِسكِ أَيَّ تَنَفُّسِ",16,"س",1,0],["مُتَحَنٍّ عَلى الخِلافَةِ ما يَن","قُصُ في حَظِّها وَلا يَغتالُ",17,"ل",1,0],["متحرراً من قيد ظلمته","يرنو بعمق الروح بالأحداق",18,"ق",1,0],["مُتَحَمِّلِ العِبءِ الثَقيلِ بِمَنكِبٍ","أَيدٍ وَلَم يَشدُد لَهُ مِن مِئزَرِ",19,"ر",1,0],["مُتَحَمِّلاً فَصّاً يَروقُ وَحَلقَةً","مِن جُذوَةٍ وَقَدَت وَماءً سالا",20,"ل",2,0],["مُتَحَكِّمٌ يبغِي الحياةَ بأسرِها","ويخالُ أنّا في يَدَيْهِ نِبالُ",21,"ل",1,0],["مُتَحَلِّياً بِجَوَامِعِ الكَلِمِ التي","يُعْنَى بها حَدِبٌ عناءَ تَجَلُّدِ",22,"د",1,0],["مُتَحاسِدينَ عَلى لِقاءِ مُسَوَّدٍ","رَحبِ الفِناءِ جَدٍ عَلى أَصحابِهِ",23,"ب",2,0],["متحملاً من عسفه","ما لَيسَ يحمله الوَصيف",24,"ف",1,0],["متحركات ما لها","حتى النهاية من قرار",25,"ر",1,0],["متحركات في السما","ء تخال أن لهنَّ قصدا",26,"د",2,0],["مُتَحَكِّمٌ في كُلِّ جِسْمٍ ناعِم","مُتَدَلِّلٌ مَا بَيْنَ أَلْحَاظِ الكِعَاب",27,"ب",1,0],["مُتَحَمِّلٌ مَا لَوْ تَحَمَّلَ بَعْضَهُ","أَهْلُ الْمَحَبَّةِ وَالْغَرَامِ لَفَاظُوا",28,"ظ",3,0],["مُتُحَدِّثينَ وَلاَ يَطِيبُ لِمِثْلِهِمْ","إِلاَّ حَدِيثُ الحُسْنِ وَالحَسْنَاءِ",29,"ا",2,0],["مُتَحَرِّزاً حَتى تحَيَّنَ","نُهْزَةَ اللَّبِقِ المُدَاوِرْ",30,"ر",1,0],["مُتَحَيِّرونَ فَباهِتٌ مُتَعَجِّبٌ","مِمّا يَرى أَو ناظِرٌ مُتَأَمِّلَ",31,"ل",1,0],["متحرِّرًا من كل قيدٍ عقُلهُ","لا يُصلحُ العقلُ المُقيَّدُ فاسدا",32,"د",2,0],["متحدِّثٍ لبقٍ، كأن حديثه","زهْرُ الرِّياض يزفه «آذار»",33,"ر",1,0],["مُتحَيِّرٌ لا يستَحِمُّ بهِ","فَلَكٌ ولا الأضواءُ تُرشِده",34,"د",2,0],["متحدَّياً حُكمَ الطباعَ ! ودافعاً","غَضَبَ السَّماءِ وللقضاءِ مُغالِبا!",35,"ب",2,0],["مُتَحجب مُتَمنع كَم مِن شَجٍ","مُلقى عَلى عَتَباتِهِ أَوّاه",36,"ه",1,0],["مُتَحَسِّراً نَضَحَ الهِناءَ بِهِ","نَضحَ العَبيرِ بِرَيطَةِ العَصبِ",37,"ب",1,0],["مُتَحَلِّياً مُتَخَلِّياً مُتجَلِّياً","مُتَرَقِياً مَتَرَفِّقاً مُتَلَطِّفَا",38,"ف",2,0],["متحمِّلٌ أعباءَ كُلِّ عظيمةٍ","بالنفعِ والإضرارِ",39,"ر",1,0],["متحلِّلِى عُقَد الضغائنِ كلَّما","نصبَ الحسودِّ لنا حِبالة ماكرِ",40,"ر",1,0],["متحكَّمٌ في القول يلقُط دُرَّه","غَوصِى ولو من قعر بحر زاخرِ",40,"ر",1,0],["مُتَحَقِّقاً أَن لَو دَعَوتَ مَليكَهُ","لَأَتاكَ إِسلاماً أَوِ اِستَسلاما",41,"م",2,0],["مُتَحَلِّبُ الكَفَّينِ غَيرُ غُضُبَّةٍ","جَزلُ المَواهِبِ مُخلِفٌ ما يُتلِفُ",42,"ف",1,0],["مُتَحدِّراً مُتَكَسِّراً مُتنثِّراً","في الحوضِ والروضِ الكثيفِ يقينا",43,"ن",2,0],["مُتَحَيِّزاً في رَبعِهِ مُتَشاغِلاً","بِذَوي المِلاحَةِ عَن لِقا الإِخوانِ",44,"ن",1,0],["مُتحدِّرِينَ خلالَ حُجْبِ جلالةٍ","من كُلَ أغلبَ باسلٍ هِرْماس",45,"س",1,0],["مُتحلِّبُ للوفدِ خِلْفُ نَوالِه","أبداً بلا مَرْيٍ ولا إبساس",45,"س",1,0],["متحلياً ببراعة وفصاحة","تزري بقُسِّ في صميم أياده",46,"د",2,0],["مُتَحَلِّباً فَوقَ الرِّدَاءِ","يُجُولُ مِن رَقراقِهَا",47,"ق",3,0],["متحملين من الخلافة ثقلها","ومن المكارم أَشرف الأَعباء",48,"ا",2,0],["متحدّثات أنهنّ لَقائحٌ","ينتجن أضعافا لها أمثالا",49,"ل",2,0],["متحرياً بهدايتي وأدائه","في حيث لا تجد القطاةُ المفحَصا",50,"ص",2,0],["متحرك في مائجٍ كصفائح","الميناء ألقي فوقهنَّ الزيبق",51,"ق",1,0],["مُتَحَمِّلٌ ثِقَلَ الأُمورِ حَوى لَهُ","سَبقَ المَكارِمِ سَابِقٌ مُتَمَهِّلُ",52,"ل",1,0],["متحققاً بمحبتي لجنابكم","والحب رنة سره أصليه",53,"ي",2,0],["متحدر من نسل حيدر طاهر","إن الطهور العذب نسل غمام",54,"م",1,0],["مُتَحَيِّراً طَلَعَت لَهُ شَمسُ النُهى","فَمَشى عَلى سَنَنِ الطَريقِ الأَقصَدِ",55,"د",1,0],["متحقق قلم الهبات ولوحها","أنا بلبل الأفراح أملأ دوحها",56,"ه",2,0],["مُتحجِّبٌ جَعَلَ المدامعَ في الهَوَى","ماءً لمن جَعَلَ الصَّبابةَ زادَهُ",57,"د",2,0],["مُتَحَكّمٌ أَعْطاهُ مُلْكَ جَوانِحِي","مَلِكُ الجمالِ أَقلّه وأجلّهِ",58,"ل",2,0]]}