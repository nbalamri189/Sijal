https://poetry.dctabudhabi.ae/diwan/poem/90949","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90801","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45019","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[4441,"","https://poetry.dctabudhabi.ae/diwan/poem/138773",""],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58080","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72545","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72353","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72349","الطويل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67581","الخفيف"],[4626,"","https://poetry.dctabudhabi.ae/diwan/poem/102875","الكامل"],[4726,"ام ذي عقود في سموط بلاغة","https://www.poetsgate.com/ViewPoem.aspx?id=146657",""],[4734,"خيل من الرشقات","https://www.poetsgate.com/ViewPoem.aspx?id=50220",""],[4767,"عطر الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=177230",""],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[4882,"اجبني فحتى الماء فجره الصخرُ_بهاء الدين الخاقاني","https://www.poetsgate.com/ViewPoem.aspx?id=7332",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[5219,"أيام الله","https://www.poetsgate.com/ViewPoem.aspx?id=194555",""],[5219,"حديث الروح","https://www.poetsgate.com/ViewPoem.aspx?id=195009",""],[5277,"وا شوقاه","https://www.poetsgate.com/ViewPoem.aspx?id=191283",""],[5277,"رتّقْ قميصَ الصبرِ..","https://www.poetsgate.com/ViewPoem.aspx?id=197647",""],[5431,"جدّ باهظ...","https://www.poetsgate.com/ViewPoem.aspx?id=202658",""],[5525,"عقد وسوار","https://www.poetsgate.com/ViewPoem.aspx?id=965",""],[5611,"كل امرىء وسط التراب يكون","https://www.poetsgate.com/ViewPoem.aspx?id=165153",""],[5770,"قم حي غزة","https://www.poetsgate.com/ViewPoem.aspx?id=178369",""],[5785,"باهي المحيَّا شمس نصف النهار","https://www.poetsgate.com/ViewPoem.aspx?id=131580",""],[5790,"بردت حرارة قلبك المشتاق","https://www.poetsgate.com/ViewPoem.aspx?id=112091",""],[5908,"بنا من بنات الماء للكوفة الغرا","https://www.poetsgate.com/ViewPoem.aspx?id=170972",""],[6142,"كم البيض بالأغماد حرى شفارها","https://www.poetsgate.com/ViewPoem.aspx?id=155749",""],[119,"إلهي مسني كرب عظيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55614&r=&rc=11",""],[5126,"فلسطين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87828&r=&rc=43",""]],"verses":[["بَاهَتْ بِلاَدُكُمُ الْبِلاَدَ فَأَصْبَحَتْ","غَرْنَاطَةٌ تَزْهُو عَلَى بَغْدَانِ",0,"ن",1,0],["بِأَهلِ بَيتي وَأَنصاري وَمَحرمَتي","مِنهُم أُسارى وَقَتلى ضُرِّجوا بِدَمِ",1,"م",1,0],["باهَت وُجوهُهُمُ الأَعراضَ مِن كَرَمٍ","فَكُلَّما راقَ مَرأىً طابَ مُستَمَعُ",2,"ع",1,0],["بأهلَكَ يا ابنة الأمجاد منّي","إذا أنا لم يعُد بكِ لي نصيب",3,"ب",1,0],["بِأَهلِيَ أَهلُ الدارِ إِذ يَسكُنونَها","وَجادَكِ مِن دارٍ رَبيعٌ وَصَيِّفُ",4,"ف",1,0],["بأهازيج من أغانيِّها الجُ","ش واتباعها الزفيرا الطحيرا",5,"ر",2,1],["باهى بنُ سَقعَبَ إِذ أَثرى بِكَلبَتِهِ","قُل لِاِبنِ صَقعَبَ أَخفِ الشَخصَ وَاِكتَتِمِ",6,"م",1,1],["باهر قولاً وفعلاً","في عيان وسماع",7,"ع",1,0],["باهر المطلعين رأياً ومرأًى","حبَّذا الفضل لامعاً ألمعيّا",8,"ي",2,0],["باهى بِهِ الزَمانَ البهيُّ كَأَنَّهُ","نَشرٌ عَلى وَجهِ الزَمانِ وَرَونَقُ",9,"ق",1,0],["باهى رِجالٌ وَفي جَهلٍ يُباهونا","لا هَونَ في النُسكِ إِن أَلغاهُ لاهونا",10,"ن",2,1],["باهَتْ بمَهْرَةَ عدناناً فقلتُ لها","لولا الفُصَيْصِيّ كان المجدُ في مُضَرِ",11,"ر",1,0],["باهى زماناً بالذي ناله","ثم أتى الموت فأين البهى",12,"ه",2,0],["باهرات الجمال يدعين للوص","ل فتأبى النفوس ان تهواها",13,"ا",3,0],["باهت بلادكم البلاد فأصبحت","غرناطة تزهى على بغدان",14,"ن",1,0],["با هندُ لا تبخلي بنائلكمْ","مِنْ عَاشِقٍ ظَلَّ مِنْكِ في نَصَب",15,"ب",1,0],["باهر الخارقات شيخي بهاء الد","ين غوثي وعمدتي وعتادي",16,"د",2,0],["بأهل طريق اللَه والقوم كلهم","وكل محب بات في المحب راضيا",17,"ي",2,0],["باهت به الناس أملاك السما شرفاً","والأرض سامت ذرى العليا بعلوان",18,"ن",1,0],["بأهل النهى صالحي المسلمين","رجال المحبة أهل الذمام",19,"م",1,0],["باهِتاتٌ كأَنَّهُنَّ عُيونٌ","ناظِراتٌ مِنها بِلا أَشْفارِ",20,"ر",1,0],["بأهلى ومالى مَن جَلَبتُ لَهُ أذى","وَمَن حَمَلت ضِغناً عَلَىَّ أقَاربُه",21,"ب",2,1],["بأَهلى وَمالى مَن بُليتُ بِحُبِّهِ","وَمَن حَلَّ فِى الأَحشَاءِ دَارَ مُقَامِ",22,"م",1,1],["بأهل اسكندرية بعض ما بى","من الأحزان للثغر المصاب",23,"ب",1,1],["باهي الشُموس فَأَنتَ مِنها أَملَحُ","إِنَّ الفِخارَ لحُسن وَجهِكَ يصلحُ",24,"ح",1,1],["باهَت عَلى الأَلقابِ أَسماؤُهُ","تَكَبُّرَاً مِنهُ عَلى الكِبرِ",25,"ر",1,0],["بَاهَتْ بِهِ أَوْطَانُهُ فَاساً بِمَا","قَدْ حَلَّهِا بَدْراً بِلاَ نُقْصَانِ",26,"ن",1,0],["باهت بلُؤلِئها وما عَلِمَت","أن القصيدة دونها العقدُ",27,"د",1,0],["باهى الزّمانُ بِهم سَرَاةَ مُلوكه","وزرَى عَلَيْهم عَاتِباً أو عَائِبا",28,"ب",2,0],["باهَت وقد أَبدى محاسِنَه","بدرَ السَماءِ بحُسنِه الأَرضُ",29,"ض",1,0],["بِأَهل زَماننا لا خَيرَ فيهِ","بِداعي فقر ذي الشَرَفِ النَبيهِ",30,"ه",1,0],["باهي الشَمائل مَأثور الفَضائل مو","رود المَناهل للصادين كَوثَرهُ",31,"ر",2,0],["باهَت بِتَشخيص أَحوال فَكَم شَخصت","لَها عُيون مَحا مِن عُجبها العَجَبُ",32,"ب",1,0],["باهِرٌ بالضِّياء يُعْشي عُيونَ ال","خَلق طُرّاً لوْ قد بدَتْ منه لَمْعه",33,"ع",2,0],["بأهل المُنْحنَى عَرّج وأبلغْ","مِنَ الصبّ المشوق بهِمْ سلامَهْ",34,"ه",1,1],["باهى بي الأَزهار في روضها","فرحْتُ أزهو مثل ورد البهار",35,"ر",1,0],["بأهداهم إلى المعروف برًّا","وأسرعهم إلى الحسنى بدارا",36,"ر",2,0],["بأهداب أجفانٍ وأحداق أعينِ","وحرّ وجوه عفَّرتها يد الغبرا",37,"ر",2,0],["باهت محاسنك الغراء في شيم","جاد النظام بها والمدح قد فُرضا",38,"ض",2,0],["باهت الأيام لما","هب للأفراح نشر",39,"ر",1,0],["باهت بك العلياء ثم تمايلت","بثنا أبيك تجر بالأذيال",40,"ل",1,0],["باهت الآمال فيهِ عندما","حلَّ بالإقبال ما بين الملا",41,"ل",2,0],["باهت محاسنه بالعز وافتخرت","كل المحاسن في أوصاف مولاه",42,"ا",2,0],["باهي المحيا ذو اللغات فأعجبت","منه بنو الأعراب والأعجام",43,"م",1,0],["باهِ بها في حالَتَيْ مَجْدِهِ","إِن كُنْتَ تبغِي سَبَقاً باهِ",44,"ه",1,0],["باهى بِهِ الأَمْلاكَ أَعْلى مُنْجِبٍ","ونَماهُ للآمالِ أَكْرَمُ نامِ",45,"م",1,0],["باهر الاكليل اوحاه الادب","فاحلي هامة الاكسرخس",46,"س",1,0],["بأهازيجَ من اللحنِ هفا","عندها النايُ وزاغَ الوَترُ",47,"ر",1,0],["باهى جَريرٌ بيربوعٍ وما ثبتتْ","بالقول دعواهُ لولا شِرَّةُ اللَّسن",48,"ن",1,0],["بأهنا من البشرى وأحلى من المنى","وأشفى من الشكوى وأندى من النعم",49,"م",1,0],["بِأَهلي وَمالي مَن جَلَبتُ لَهُ الأَذى","وَمَن ذِكرُهُ مِنّي قَريبٌ أُسامِرُه",50,"ر",2,0],["بِأَهلي خَليلٌ إِن تَحَمَّلتُ نَحوَهُ","عَصاني وَإِن هاجَرتُهُ فَهوَ جازِعُ",51,"ع",1,0],["باهَتْ مناقبهُ الدُّنيا به فعَلا","قدْراً على سائِر الأيّام واِستفَلوا",52,"ل",3,0],["باهتُ المَرأى كَئيبٌ","ساءَ مِن مَرآهُ فالُ",53,"ل",1,0],["باهِ الرّجالَ بفضل حلمك فيهمُ","وَاِفخَرْ بِه فَبِمثل ذلك يفخَرُ",54,"ر",1,0],["بِأَهَّةٍ كَأَهَّةِ المَجروحِ","وَظاهِري السَريحَ بِالسَريحِ",55,"ح",1,0],["باهَى الرِّجالُ نِساءَ الدَّهرِ وافتخروا","حَتَّى أتَتْ فأصابَ المُدَّعي الخَجَلُ",56,"ل",1,0],["بأهله وماله وعترته","وبالقيام بعده في أمته",57,"ه",1,0],["باهرة الجمال غض","ضَةُ الشباب القشب",58,"ب",1,0],["باهِ عليّاً ذا العلى وباري","وهاتِ سيفاً مثلَ ذي الفَقار",59,"ر",1,0],["بأهلي فرقة فارقت أهلي","فَهُمْ والله أنْضَاء الهموم",60,"م",1,0],["باهت بفارسها الشهم الذي شهدا","ببأسه الفاتكان السيف والخارقْ",61,"ق",1,0],["باهت بتدين العلا في فسحة","عن حسنها كل المحاسن في شطَطْ",62,"ط",1,1],["باهت حماه بفضل عثمان الذي","قد فاق قدراً سامياً بين الملا",63,"ل",2,1],["باهت محاسنها بالعز وافتخرت","كل المحاسن في أوصاف مولاهُ",64,"ا",2,0],["باهت بظاهرها المنير وضمنها","نعم المهيمن لا تزال وفَّيهْ",65,"ي",2,0],["باهى الوجود بنعم مولىً به اقتدت","شيوخ التقى والفضل آل التعقُّلِ",66,"ل",1,1],["باهت جلالاً وافتخاراً أرخوا","والله شرف قدرها بأميرها",67,"ه",2,0],["باهوا بريس عامهم اغناطيوس","اب زها بالفضل والتديينِ",68,"ن",1,0],["باهت معالم مولانا البشير وقد","تفاخرت في الورى عجباً بحساها",69,"ا",3,0],["باهت الأحكام فيه والولا","وغدا كلٌّ له صاغ رضوخْ",70,"خ",1,0],["باهت ربوع العزّ في مشراقةٍ","فيحاء ذات نزاهةٍ وطلاقهْ",71,"ه",1,0],["باهت بجمالٍ منفردِ","ودلالٍ بالأرواح فدي",72,"د",2,1],["باهت طرابلس العلا في نعم مد","رسة على قصد الثواب مؤَّسسهْ",73,"س",2,1],["باهت ببيروت السعيده بيعة","قد جُلّ كرسيها الوطيد وفخّما",74,"م",2,1],["باهر طاهر تقي نَقي","ماجد هاجد كَبير المهابه",75,"ب",2,0],["باهتْ نواعيرُها الأَفلاكَ دائرةً","مُطيعةً أَمرَ عاصٍ غيرَ عاصيكا",76,"ك",2,0],["باهله فَنالَهُ ظلم الشرط","تَعديا بِما أَتوه لا غلط",77,"ط",1,0],["بأهنأ منى عيشة لو عرفتم","ولكن أسير الحرص عن ذاك أعور",78,"ر",1,0],["باهلي وبي أفدي فريداً تزاحمت","عليه بنو سفيان من كل جانب",79,"ب",1,0],["باهي السَنى لَما اِنثَنى أَزرى القَنا","يا عُيون الغيد كُفي إِذ رَنا",80,"ن",2,1],["بأهليك الأئمة من قريشٍ","تعز وان أصابك ما أصابا",81,"ب",2,0],["باهي بها الفلك في أسنى مطالعها","جواريا ذات ألواح تلت صحفا",82,"ف",2,0],["باهِ بها أُمّ نجومِ السما","وفاخِر الشهبَ بأبناها",83,"ا",3,0],["باهوت بهت عقائل الناسوت","أَسرار ما في باطن التابوت",84,"ت",1,1],["باهوا بمتري البدر قلت مؤرخاً","باهوا فرتبة بدركم متمايزه",85,"ز",2,0],["باهي الغزالةَ بالملاحة باهي","يا عرسَ بدر التم نصر اللَه",86,"ه",1,1],["باهرٌ في اللئام والطّرفُ لا يَبْهَرُ","حتى يجولَ مُلْقَى الجلال",87,"ل",1,0],["باهرٌ كالصّباح أَبْهمُ كاللّيْلِ","عميمٌ في كلِّ خطبٍ عميم",88,"م",1,0],["باهي السنا كلّ المنى معطي الهنا","نافي العنا كنزُ الغنا والمكرمُ",89,"م",1,0],["باهلي قد ألبس التاج حتى","شاب منه مفارق كن سودا",90,"د",2,0],["باهى بها الأفق حتى لواعدَّ له","اسحاره ثم لاقاها بابكار",91,"ر",1,0],["باهِتِ اللَونِ مِثل بَشرَتِهِ شَك","لاً يَضُمُّ الشَقاءَ في أَنضائِه",92,"ا",3,0],["بِأَهليَ ما أَلَذَّكِ عِندَ نَفسي","لَو أَنَّكِ بِالكَلامِ تُعَرِّبينا",93,"ن",2,0],["باهي المحيا زانَ حُمرةَ خدِّهِ","وَردُ الصِّبى وتوقُّدُ الأحلامِ",94,"م",1,0],["بأهلة منها عليها انجم","من ركبها في سبسب كسماء",95,"ا",2,0],["باهي المُحيّانِ الأخ بكم","أو جا وسلّم أوجا وسلّم",96,"م",1,0],["باهي الجمال الذي ما مثله احد","في الخلق حالاً يحيى واللَه والعظيم",97,"م",1,0],["باهي الجمال الداني","زاهي المحيا اخواني",98,"ن",2,0],["بإهمالها يستوجب المرء قرنه","بفرعون مع هامان في شر مذود",99,"د",1,0],["باه بدر الدجى به وَقَليل","فهو من اسرة بها الدين باهى",100,"ا",3,0],["باهى ابوها بها شمس النّهار كما","باهت بها أمها 