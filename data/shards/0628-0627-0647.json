{"poems":[[77,"حيى ربوع الحي من نعمان","https://www.aldiwan.net/poem36079.html","الكامل"],[42,"ماذا تقولون إن قال النبي لكم","https://www.aldiwan.net/poem50220.html","البسيط"],[73,"هل النداء الذي أعلنت مستمع","https://www.aldiwan.net/poem11935.html","البسيط"],[88,"بدت كالشمس يحضنها الغروب","https://www.aldiwan.net/poem45008.html","الوافر"],[27,"ألا أيها القلب الطروب المكلف","https://www.aldiwan.net/poem5922.html","الطويل"],[37,"بأهازيج من أغانيها الجيش","https://www.aldiwan.net/poem7147.html","الخفيف"],[23,"باهى بن سقعب إذ أثرى بكلبته","https://www.aldiwan.net/poem21393.html","البسيط"],[72,"يا إماما لم يزل في الفض","https://www.aldiwan.net/poem19179.html","مجزوء الرمل"],[72,"جاءت العاذلات شيئا فريا","https://www.aldiwan.net/poem20564.html","الخفيف"],[78,"أترى اللقاء كما نحب يوفق","https://www.aldiwan.net/poem14281.html","الكامل"],[46,"باهى رجال وفي جهل يباهونا","https://www.aldiwan.net/poem23477.html","البسيط"],[46,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147505","السريع"],[77,"حيى ربوع الحي من نعمان","https://www.poetsgate.com/ViewPoem.aspx?id=34207",""],[31,"المَّ طيفٌ، فهاجَ لي طربي،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18787&r=&rc=50",""],[115,"يا بعينيك طر الى بغداد","https://www.aldiwan.net/poem41168.html","عموديه"],[115,"بعسكر ليلي جئت بالذل راجيا","https://www.aldiwan.net/poem42001.html","الطويل"],[115,"لكل أمر تسول بابن عدنان","https://www.aldiwan.net/poem42169.html","البسيط"],[115,"إلهي بطه شفيع الأنام","https://www.aldiwan.net/poem42186.html","المتقارب"],[155,"بدر ليل أولا فشمس نهار","https://www.aldiwan.net/poem55704.html","الخفيف"],[181,"بأهلى ومالى من جلبت له أذى","https://www.aldiwan.net/poem59058.html","الطويل"],[181,"بأهلى ومالى من بليت بحبه","https://www.aldiwan.net/poem59061.html","الطويل"],[211,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[232,"باهي الشموس فأنت منها أملح","https://www.aldiwan.net/poem14717.html","الكامل"],[235,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[237,"حلت حلى حسن الحلى زيدان","https://www.aldiwan.net/poem19294.html","الكامل"],[270,"يا دار أزهر حولك الورد","https://www.aldiwan.net/poem35667.html","أحذ الكامل"],[275,"أهلا بهن أهلة وكواكبا","https://www.aldiwan.net/poem25628.html","الكامل"],[297,"أما الصبوح فإنه فرض","https://www.aldiwan.net/poem33232.html","أحذ الكامل"],[353,"أرى نفسي أبت طلب التمني","https://www.aldiwan.net/poem40183.html","الوافر"],[353,"وافاك نيشان عز أنت جوهره","https://www.aldiwan.net/poem40347.html","البسيط"],[353,"للجد صورة هزل حليها الأدب","https://www.aldiwan.net/poem40569.html","البسيط"],[364,"زد علوا في كل يوم ورفعه","https://www.aldiwan.net/poem60844.html","الخفيف"],[402,"بأهل المنحنى عرج وأبلغ","https://www.aldiwan.net/poem46676.html","الوافر"],[416,"باكر نداماك بكأس العقار","https://www.aldiwan.net/poem53938.html","السريع"],[416,"سنا برق تبلج واستنارا","https://www.aldiwan.net/poem54050.html","الوافر"],[416,"سرينا لنمحو الإثم أو نغنم الأجرا","https://www.aldiwan.net/poem54107.html","الطويل"],[429,"نادت ذوابله في كفه عجبا","https://www.aldiwan.net/poem40829.html","البسيط"],[429,"لاح للأفراح بدر","https://www.aldiwan.net/poem40994.html","مجزوء الرمل"],[429,"يهنيك يا ذا المجد والافضال","https://www.aldiwan.net/poem40999.html","الكامل"],[429,"جاءت الأفراح بالبشرى على","https://www.aldiwan.net/poem41021.html","الرمل"],[429,"يا نائيا وفؤاد الصب مأواه","https://www.aldiwan.net/poem41023.html","البسيط"],[429,"يا فاضلا أهدى إلي قلائدا","https://www.aldiwan.net/poem41391.html","الكامل"],[432,"أطاع ما يأمره الناهي","https://www.aldiwan.net/poem12344.html","السريع"],[439,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[443,"يا جنان الشام يا ذات البها","https://www.aldiwan.net/poem56030.html","عموديه"],[452,"يا ليالي السفح من عهد الصبا","https://www.aldiwan.net/poem13926.html","الرمل"],[461,"ضاقت بلاغة أشعاري بما رحبت","https://www.aldiwan.net/poem15395.html","البسيط"],[464,"قفي فاسمعي محض النُّهى يا ابنة الفهم","https://www.aldiwan.net/poem3280.html","عموديه"],[466,"بنفسي من لا بد أني هاجره","https://www.aldiwan.net/poem50433.html","الطويل"],[486,"ألا هل فؤادي إذ صبا اليوم نازع","https://www.aldiwan.net/poem481.html",""],[514,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[538,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[551,"إما بقيت فهلك غيرك هين","https://www.aldiwan.net/poem47818.html","الكامل"],[561,"قلت لعنس قد ونت طليح","https://www.aldiwan.net/poem27836.html","الرجز"],[562,"إن قلت ويحك فافعل أيها الرجل","https://www.aldiwan.net/poem52932.html","البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["بَاهَتْ بِلاَدُكُمُ الْبِلاَدَ فَأَصْبَحَتْ","غَرْنَاطَةٌ تَزْهُو عَلَى بَغْدَانِ",0,"ن",1,0],["بِأَهلِ بَيتي وَأَنصاري وَمَحرمَتي","مِنهُم أُسارى وَقَتلى ضُرِّجوا بِدَمِ",1,"م",1,0],["باهَت وُجوهُهُمُ الأَعراضَ مِن كَرَمٍ","فَكُلَّما راقَ مَرأىً طابَ مُستَمَعُ",2,"ع",1,0],["بأهلَكَ يا ابنة الأمجاد منّي","إذا أنا لم يعُد بكِ لي نصيب",3,"ب",1,0],["بِأَهلِيَ أَهلُ الدارِ إِذ يَسكُنونَها","وَجادَكِ مِن دارٍ رَبيعٌ وَصَيِّفُ",4,"ف",1,0],["بأهازيج من أغانيِّها الجُ","ش واتباعها الزفيرا الطحيرا",5,"ر",2,1],["باهى بنُ سَقعَبَ إِذ أَثرى بِكَلبَتِهِ","قُل لِاِبنِ صَقعَبَ أَخفِ الشَخصَ وَاِكتَتِمِ",6,"م",1,1],["باهر قولاً وفعلاً","في عيان وسماع",7,"ع",1,0],["باهر المطلعين رأياً ومرأًى","حبَّذا الفضل لامعاً ألمعيّا",8,"ي",2,0],["باهى بِهِ الزَمانَ البهيُّ كَأَنَّهُ","نَشرٌ عَلى وَجهِ الزَمانِ وَرَونَقُ",9,"ق",1,0],["باهى رِجالٌ وَفي جَهلٍ يُباهونا","لا هَونَ في النُسكِ إِن أَلغاهُ لاهونا",10,"ن",2,1],["باهَتْ بمَهْرَةَ عدناناً فقلتُ لها","لولا الفُصَيْصِيّ كان المجدُ في مُضَرِ",11,"ر",1,0],["باهى زماناً بالذي ناله","ثم أتى الموت فأين البهى",12,"ه",2,0],["باهت بلادكم البلاد فأصبحت","غرناطة تزهى على بغدان",13,"ن",1,0],["با هندُ لا تبخلي بنائلكمْ","مِنْ عَاشِقٍ ظَلَّ مِنْكِ في نَصَب",14,"ب",1,0],["باهر الخارقات شيخي بهاء الد","ين غوثي وعمدتي وعتادي",15,"ي",1,0],["بأهل طريق اللَه والقوم كلهم","وكل محب بات في المحب راضيا",16,"ي",2,0],["باهت به الناس أملاك السما شرفاً","والأرض سامت ذرى العليا بعلوان",17,"ن",1,0],["بأهل النهى صالحي المسلمين","رجال المحبة أهل الذمام",18,"م",1,0],["باهِتاتٌ كأَنَّهُنَّ عُيونٌ","ناظِراتٌ مِنها بِلا أَشْفارِ",19,"ر",1,0],["بأهلى ومالى مَن جَلَبتُ لَهُ أذى","وَمَن حَمَلت ضِغناً عَلَىَّ أقَاربُه",20,"ب",2,1],["بأَهلى وَمالى مَن بُليتُ بِحُبِّهِ","وَمَن حَلَّ فِى الأَحشَاءِ دَارَ مُقَامِ",21,"م",1,1],["بأهل اسكندرية بعض ما بى","من الأحزان للثغر المصاب",22,"ب",1,1],["باهي الشُموس فَأَنتَ مِنها أَملَحُ","إِنَّ الفِخارَ لحُسن وَجهِكَ يصلحُ",23,"ح",1,1],["باهَت عَلى الأَلقابِ أَسماؤُهُ","تَكَبُّرَاً مِنهُ عَلى الكِبرِ",24,"ر",1,0],["بَاهَتْ بِهِ أَوْطَانُهُ فَاساً بِمَا","قَدْ حَلَّهِا بَدْراً بِلاَ نُقْصَانِ",25,"ن",1,0],["باهت بلُؤلِئها وما عَلِمَت","أن القصيدة دونها العقدُ",26,"د",1,0],["باهى الزّمانُ بِهم سَرَاةَ مُلوكه","وزرَى عَلَيْهم عَاتِباً أو عَائِبا",27,"ب",2,0],["باهَت وقد أَبدى محاسِنَه","بدرَ السَماءِ بحُسنِه الأَرضُ",28,"ض",1,0],["بِأَهل زَماننا لا خَيرَ فيهِ","بِداعي فقر ذي الشَرَفِ النَبيهِ",29,"ه",1,0],["باهي الشَمائل مَأثور الفَضائل مو","رود المَناهل للصادين كَوثَرهُ",30,"ر",2,0],["باهَت بِتَشخيص أَحوال فَكَم شَخصت","لَها عُيون مَحا مِن عُجبها العَجَبُ",31,"ب",1,0],["باهِرٌ بالضِّياء يُعْشي عُيونَ ال","خَلق طُرّاً لوْ قد بدَتْ منه لَمْعه",32,"ع",2,0],["بأهل المُنْحنَى عَرّج وأبلغْ","مِنَ الصبّ المشوق بهِمْ سلامَهْ",33,"ه",1,1],["باهى بي الأَزهار في روضها","فرحْتُ أزهو مثل ورد البهار",34,"ر",1,0],["بأهداهم إلى المعروف برًّا","وأسرعهم إلى الحسنى بدارا",35,"ر",2,0],["بأهداب أجفانٍ وأحداق أعينِ","وحرّ وجوه عفَّرتها يد الغبرا",36,"ر",2,0],["باهت محاسنك الغراء في شيم","جاد النظام بها والمدح قد فُرضا",37,"ض",2,0],["باهت الأيام لما","هب للأفراح نشر",38,"ر",1,0],["باهت بك العلياء ثم تمايلت","بثنا أبيك تجر بالأذيال",39,"ل",1,0],["باهت الآمال فيهِ عندما","حلَّ بالإقبال ما بين الملا",40,"ل",2,0],["باهت محاسنه بالعز وافتخرت","كل المحاسن في أوصاف مولاه",41,"ا",2,0],["باهي المحيا ذو اللغات فأعجبت","منه بنو الأعراب والأعجام",42,"م",1,0],["باهِ بها في حالَتَيْ مَجْدِهِ","إِن كُنْتَ تبغِي سَبَقاً باهِ",43,"ه",1,0],["باهى بِهِ الأَمْلاكَ أَعْلى مُنْجِبٍ","ونَماهُ للآمالِ أَكْرَمُ نامِ",44,"م",1,0],["باهر الاكليل اوحاه الادب","فاحلي هامة الاكسرخس",45,"س",1,0],["بأهازيجَ من اللحنِ هفا","عندها النايُ وزاغَ الوَترُ",46,"ر",1,0],["باهى جَريرٌ بيربوعٍ وما ثبتتْ","بالقول دعواهُ لولا شِرَّةُ اللَّسن",47,"ن",1,0],["بأهنا من البشرى وأحلى من المنى","وأشفى من الشكوى وأندى من النعم",48,"م",1,0],["بِأَهلي وَمالي مَن جَلَبتُ لَهُ الأَذى","وَمَن ذِكرُهُ مِنّي قَريبٌ أُسامِرُه",49,"ر",2,0],["بِأَهلي خَليلٌ إِن تَحَمَّلتُ نَحوَهُ","عَصاني وَإِن هاجَرتُهُ فَهوَ جازِعُ",50,"ع",1,0],["باهَتْ مناقبهُ الدُّنيا به فعَلا","قدْراً على سائِر الأيّام واِستفَلوا",51,"ل",3,0],["باهتُ المَرأى كَئيبٌ","ساءَ مِن مَرآهُ فالُ",52,"ل",1,0],["باهِ الرّجالَ بفضل حلمك فيهمُ","وَاِفخَرْ بِه فَبِمثل ذلك يفخَرُ",53,"ر",1,0],["بِأَهَّةٍ كَأَهَّةِ المَجروحِ","وَظاهِري السَريحَ بِالسَريحِ",54,"ح",1,0],["باهَى الرِّجالُ نِساءَ الدَّهرِ وافتخروا","حَتَّى أتَتْ فأصابَ المُدَّعي الخَجَلُ",55,"ل",1,0],["بأهله وماله وعترته","وبالقيام بعده في أمته",56,"ه",1,0]]}