,[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101353","الهزج"],[4081,"","https://poetry.dctabudhabi.ae/diwan/poem/67680","الطويل"],[4196,"","https://poetry.dctabudhabi.ae/diwan/poem/147618","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94326","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94463","الوافر"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136585",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136503",""],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117180","الطويل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104937","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141676","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139543",""],[4657,"","https://poetry.dctabudhabi.ae/diwan/poem/140149",""],[4657,"","https://poetry.dctabudhabi.ae/diwan/poem/140137",""],[4657,"","https://poetry.dctabudhabi.ae/diwan/poem/140143",""],[4670,"","https://poetry.dctabudhabi.ae/diwan/poem/143599","الطويل"],[592,"أهاجك أزماة تسامى بها الخلف","https://www.poetsgate.com/ViewPoem.aspx?id=128857",""],[5356,"جنّيةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=204487",""],[5397,"على الربع دمعي أرسل المد لا الجزرا","https://www.poetsgate.com/ViewPoem.aspx?id=157921",""],[5431,"تباكى كاليتامى ذات غصةْ....","https://www.poetsgate.com/ViewPoem.aspx?id=212134",""],[5725,"ناسك","https://www.poetsgate.com/ViewPoem.aspx?id=198348",""],[5741,"لئن ساءني أن هذا الذي","https://www.poetsgate.com/ViewPoem.aspx?id=187442",""],[2546,"تمارضتِ كي أشجى وما بكِ علَّة ٌ","https://www.poetsgate.com/ViewPoem.aspx?id=17535",""],[5783,"حنين إلى \"نجد\"","https://www.poetsgate.com/ViewPoem.aspx?id=34823",""],[5786,"بريقٌ أضا بالغَضَا مُوهِن","https://www.poetsgate.com/ViewPoem.aspx?id=50653",""],[5854,"أَ لِلْبَيْنِ أَرْخَصْتَ الدُّمُوعَ الْغَوَالِيَا؟ ((مرثية طول الأمل))","https://www.poetsgate.com/ViewPoem.aspx?id=191655",""],[5943,"مباخرُ من تُقى","https://www.poetsgate.com/ViewPoem.aspx?id=34280",""],[463,"أما والنقا لولا هوى ظيبة َ النقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60160&r=&rc=216",""],[6259,"همُ علّموا عيني سؤال المعالمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59402&r=&rc=50",""],[6338,"لئن سرت الدنيا فأنت سرورها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52544&r=&rc=6",""]],"verses":[["لَئِن ساءَكُم مِنّي حُزونُ خَلائِقي","فَقَد طالَ ما لَم أَنتَفِع بِالدَمائِثِ",0,"ث",1,0],["لَئِن سَلَبَتْني نَخوَةً أُمَويَّةً","خُطوبٌ أُعانيها فَلَستُ لِحاصِنِ",1,"ن",1,0],["لَئِنْ سَلِمَتْ مِنّي وَلَمْ أَبْلُغِ المَدَى","فَلَسْتُ لِصِيدٍ مِنْ قُرَيْشٍ وَعامِرِ",2,"ر",1,0],["لَئِنْ سَفِهَتْ قِدْري عَلَيْكَ بِغلْيها","فَكَلْبي غَضِيضُ النَّاظِرَيْنِ حَليمُ",3,"م",1,0],["لَئِن سَهَّلَ اللَهُ العَزيزُ بِلِطفِهِ","وَصادَفتُ أَهلاً لِلعُلومِ وَلِلحِكَم",4,"م",1,0],["لَئِن ساءَكَ الدَهرُ المُسيءُ فَلَم يَكُن","بِأَوَّلِ عَهدٍ واجِبَ الحِفظِ ضَيَّعا",5,"ع",2,0],["لئن سار للرحمن خير مودع","وحلَّ من الفرودس أشرفَ مقعدِ",6,"د",1,0],["لَئِن سَكَنَت تَيمٌ زَماناً بِغِرَّةٍ","لَقَد حُدِيَت تَيمٌ حُداءً عَصَبصَبا",7,"ب",2,0],["لئن سجعت بمدح لهاه خلقٌ","لقد لبسوا بها سجع الحمامه",8,"م",2,0],["لئن سبقتَ إليّ الناس كلهمُ","لقد سبقت إلى شكري وأشعاري",9,"ر",2,0],["لَئِن سَكَنَت بي الوَحشُ يَوماً لَطالَما","ذَعَرتُ قُلوبَ المُرشِقاتِ المَلائِحِ",10,"ح",1,0],["لئن سارَ الرّشكابُ بحُرِّ مَدحي","فقد سارت بجَدواك الرِّكابُ",11,"ب",1,0],["لَئِن ساءَني دَهرٌ عَزَمتُ تَصَبُّراً","فَكُلُ بَلاءٍ لا يَدومُ يَسيرُ",12,"ر",1,1],["لَئِن ساءَني دَهرٌ لَقَد سَرَّني دَهرُ","وَإِن مَسَّني عُسرٌ فَقَد مَسَّني يُسرُ",13,"ر",1,1],["لَئِن سَلَّ الزَمانُ لَنا مَناصِل","فَصُنعُ الوُدَّ عِندي غَيرُ ناصِل",14,"ل",1,1],["لَئِن سَمَحَ الزَمانُ لَنا بُقُربٍ","نَشَرتُ لَدَيكَ ما في طَيِّ كُتبي",15,"ب",2,1],["لَئِن سَكَنَت إِلى الزَوراءِ نَفسي","فَإِنَّ القَلبَ بَينَ مُحَرِّكَينِ",16,"ن",1,0],["لئنْ سرَّني ذاكَ النظامُ المفوَّفُ","لقدْ ساءني هذا البعادُ المسوِّفُ",17,"ف",1,0],["لَئِن سَوَّدَ الآفاقَ يَومُ حِمامِهِ","لَقَد بَيَّضَت صُحُفَ الحِسابِ فَضائِلُه",18,"ل",2,0],["لَئِن سَبَقَتهُ بِالزَمانِ مَعاشِرٌ","فَكَم سَبَقَت فَرضَ المُصَلّي نَوافِلُه",18,"ل",2,0],["لَئِن سُمّيتَ عَبّاساً","فَما أَنتَ بِعَبّاسِ",19,"س",1,0],["لَئِن سَقَتكَ اللَيالي مَرَّةً ضَرَباً","فَكَم سَقَتكَ عَلى مَرِّ الزَمانِ مَقِر",20,"ر",1,1],["لَئِنْ سَاءَ يَوْماً فِي الكَمَالِ تَقَوُّلٌ","لَمَا نَالَ يَوماً مِنْهُ سُوءُ التَّقَولِ",21,"ل",1,0],["لئن سركم أني الى العيش كادح","لقد ساءني أني لغير العلى كدحي",22,"ح",2,0],["لئن سرهم أننا عزَّلٌ","فقد أخطأ المقتلَ الرامح",23,"ح",1,0],["لئن سلبوا ثوباً أرَّثَّ فبعدما","كستهم ثياب العار مني القصائد",24,"د",1,0],["لَئِن سَعدت وَلَو في النَوم عَيني","بِرُؤياهُ لِتلكَ العَين طُوبى",25,"ب",2,0],["لينسى بأيام البعاد وبالنوى","وادوارها من ركبهم متنه امتطى",26,"ط",2,0],["لَئِن ساءَنى أَن نِلتِنى بِمَسَاءِةٍ","لَقَد سَرَّنى أَنّى خَطَرتُ ببالِكِ",27,"ك",1,0],["لَئِن سَئِمَ العُذّالُ طولَ شِكايَتي","وَمَلَّ حَديثي زائِري وَمُجالِسي",28,"ي",1,1],["لَئِن سَئِمَ العُوّادُ طولَ شِكايَتي","وَمَلَّ حَديثي زائِري وَمُجالِسي",29,"ي",1,1],["لَئِن سَمُحَت بِزَورَتِكَ اللَيالي","وَأَعهُدُها بِحاجاتي تَشُحُّ",30,"ح",1,0],["لَئِنْ سَارُوا بِأَقْمَارِ الدَّيَاجِي","وَكَانَ السَّيْرُ لِلأَقْمَارِ زَيْنَا",31,"ن",2,0],["لئن سَقَطت بينَ الرِّماحِ صريعةً","فذلكَ موتٌ ما تمنّت أنالها",32,"ل",3,0],["لَئِن سَرَّ ناعيهِ به كُلَّ مُؤمِنٍ","لَقَد سَرَّ لا أَهلاً بِهِ كُلَّ مَن كَفَر",33,"ر",1,0],["لئن ساءني أهلوك ترقبُ زَوْرَتي","لقد سرَّني أنْ مِزتني بالهوى المحض",34,"ض",1,0],["لئن سمح الدهر البخيل بقربكم","وسكن منا أنفسا وخواطرا",35,"ر",2,1],["لئن سَقُمْتُ لمَا صَبوْتُ إليهمُ","إلاّ وجَدْتُ على البعادِ سَبيلا",36,"ل",2,0],["لَئِن سَلَبتَ الفَجرَ أَنوارَهُ","وَطِرتَ ما تُسرِجُ بِالرِياحِ",37,"ح",1,1],["لَئِن سَهُلَت لَقَد صَعُبَت وَأَضحَت","كَرَوضٍ دونَهُ الطُرُقاتُ وَعرَه",38,"ر",2,0],["لئِنْ سَمَّمني اللهُ","وبالصُّنعِ تَوَلاّني",39,"ن",2,1],["لَئِنْ ساعَدَني الدَّهْرُ","وخَلاّني وَخُلاّني",39,"ن",2,0],["لَئِن سَلَّمت طَييٌّ إِلَيك عنانها","فَأَصبَحت أَسنى ذَخرها لِلعَظائِمِ",40,"م",1,0],["لئنْ سَعِدَتْ به الكوماءُ يوماً","حسمت نحوس أيَّام حسوم",41,"م",1,0],["لي نسبة فيكم وأية نسبة","منكم يقوم لها الفخار ويقعد",42,"د",1,0],["لئن سُمْتَهُ البأْساءَ فِي عُقْرِ دارِهِ","لقد عُضْتَهُ فِي دارِ ملكِكَ أَنْعُما",43,"م",2,0],["لَئِنْ سَرَّتِ الدُّنْيا فأَنت سُرُورُهَا","وإِنْ سَطَعَت نُوراً فوجْهُكَ نورُهَا",44,"ر",3,1],["لينسخ آيات الفارق بآية","تقربني زلفى وإن شحطت لها",45,"ل",3,0],["لئن سكنت هذي البحيرة لم يكن","سكون لها إلا سكون حياء",46,"ا",2,0],["لئن سخطتُ فحسبي أن أؤدَّبهم","ولن افرطَ في برِّى وإيماني",47,"ن",2,0],["لئن سرَّ حاسدَكم أن يرى","وفودَكُمُ مرَّةً مُخفِقينا",48,"ن",2,0],["لئن ساء سمعِيَ ما قلتُمُ","ففضلي لما ساءكم فاعلُ",49,"ل",1,0],["لئن سُمتَنيها بادئاً بِطلابها","لَتستثمرنْ منها الثَناء المنمَّقا",50,"ق",2,0],["لئن سرَّكَ التَّجويدُ فيما نظمْته","فنظمُ القوافي غيرُ نظْمِ العَساكرِ",51,"ر",1,0],["لَئِن سَقاني أَخٌ لَهُ هِمَمٌ","راحاً مِنَ الرِفدِ كَرمُها الكَرَمُ",52,"م",1,1],["لئن سارَ مَنْ أهوى وسارتْ برحلهِ","مُضبَّرةُ المتنينِ مَوّارةُ الضَّبْعِ",53,"ع",1,0],["لئن سميت بالجندي رغما","علي وإن يكن شرفا ثمينا",54,"ن",2,0],["لَئِنْ سلِمَتْ أبناؤهُ وبَنوهُمُ","فويلُ العِدا ولْيَفرَحِ الذّئْبُ والنَّسْرُ",55,"ر",1,0],["لئن سبق الكرام فغير بدع","إذا سبق الجواد بن الجواد",56,"د",1,0],["لئن ساءني ليل بهجرك مظلم","لقد سرني صبح بوصلك مسفر",57,"ر",1,0],["لئن سدت أهل العصر في زمن الصبا","وقدت أنوفاً صعبة بحشاش",58,"ش",1,0],["لئن سكن الإسلام جأشاً فإنه","بما قد تركتم خاطر الكفر يقلق",59,"ق",1,0],["لَئِنْ سَمَحَ الزَّمانُ لنا بيومٍ","فذاكَ اليَومُ يَومُ المِهْرَجانِ",60,"ن",1,0],["لَئِن سَلاهُ فُؤَادي ما بَقِيتُ فقد","رَكِبتُ في الحُبِّ ذَنباً ليسَ يُغتَفرُ",61,"ر",1,0],["لئِن سَرَّكُمْ حُسنُ وَجْهِ الحبيب","فما ذاك عنديَ إِلاّ تَرَح",62,"ح",1,0],["لئن سَرَقَتْ عَيْنَاه من لون خدِّه","فغير بديعٍ ربما نفض الصِّبْغُ",63,"غ",1,0],["لئن ساءني أن نالني بمساءة","لقد سرني أني خطرت بباله",64,"ه",1,1],["لَئن سُرَّ في عام بِعيدينِ مسلمٌ","سِوانا رَأى مَولاه بَينَ العَساكر",65,"ر",1,0],["لئن سرني أن يسقيَ النيل غرسكم","وتجمعكم آمالكم فيه والحب",66,"ب",1,0],["لِئَنْ سَاغَ لِي أَكْلِي وَشُرْبِي فَإِنَّني","كَذِي شَرَقٍ مِنْ غَيْبَتِي عَنْهُ مُغْتَصِّ",67,"ص",1,0],["لَئِنْ سعدتْ عينِي بِرُؤْيَةِ نُورِهِ","فَحُقَّ لِقَلْبِي فِي هَوَاهُ شَقَاؤُهُ",68,"ا",3,0],["لَئِن سَلَبَتكَ الريحُ فينانَ عيشَةٍ","لَقَد كُنتَ مَنشورَ الذَوائِبِ أَرفَعا",69,"ع",2,0],["لئن ساءك الدهرُ في جعفرٍ","فإنَّ الإِساءةَ شأنُ العبيد",70,"د",1,0],["لئن سأَل المُرمدُّ من هو كاملٌ","لقامتْ تُداعيهِ العُلى والفضائل",71,"ل",1,0],["لَئِن سرَّني أنّا التقَينا بفُسحةٍ","بها ذهَبَ الواشي وَعَنّا الرقيبُ شَذ",72,"ذ",1,0],["لئن ساعد المقدار حزمي ونجدتي","لأبعثه جيشاً إليك عرمرما",73,"م",2,1],["لَئِن سَرَّنا بُرؤُهُ لِلنَدى","لَقَد ضَرَّ أَعمارَ كُومِ النَعَم",74,"م",1,0],["لِئِن سَلَبَت مَحاسِنَكَ اللَيالي","وَغالَ قِيامَكَ الزَمَنُ الغَشومُ",75,"م",1,0],["لئن سبقوه بالمجيء فإنَّما","أتوا ليبثُّوا أمره ويمهدوا",76,"د",3,0],["لئن ساءنا خطبُ ذاك المصابِ","لقد سرَّه وشكُ ذاك الرحيل",77,"ل",1,0],["لَئن ساغَ أَن يُمسي لَدَيك فَريسة","فَمن بَعد ما حَدّدت نابك وَالظَفرا",78,"ر",2,0],["لئن سعدت بلادك فيك قبلا","وباهت فهي فيه اليوم اسعد",79,"د",1,0],["لئن سنبول عزت فيك دهراً","فقد حنت للقياك الديار",80,"ر",1,0],["لئن ساءه يوم الرحيل فراقه","فقد سره لقياه والحظ موفور",81,"ر",1,0],["لئن سمح الزمان بهم اخيراً","فقد سبقوا الاواخر والاوالي",82,"ل",2,0],["لئنْ سَرّ إسحاقَ النّجاةُ بنفْسهِ","لقد ساءهُ في جمعِهِ القَتلُ والأسرُ",83,"ر",1,0],["لئن سطع المعرّي نجمَ ليلٍ","فاني رحت أسطع نجم ظهر",84,"ر",1,0],["لينسِ الشيب ما قد شاء مني","سوى لحن يذكر بالنعيم",85,"م",1,0],["لئن سكتوا فربَّ سكوتِ ليثٍ","يُقصِّرُ عن بلاغتهِ الكلامُ",86,"م",1,0],["لئن سودُوا بالقار منهُ جوانبا","فإنّ بياض الغنم في وجهه أجزا",87,"ز",2,0],["لئن سكتت مقاولهم عليها","فقد نطق المناظر بالوفاء",88,"ا",2,0],["لئن ساءها التسليم خيفة أهلها","فما ساء طيف أن يزور مسلما",89,"م",2,0],["لي نسبة لك فارع فضلا حقها","واترع فؤادي بالنوال الزاخر",90,"ر",1,0],["لئن ساءني سني لفقد أحبتي","وأني فيهم لا أمر ولا أحلي",91,"ي",1,1],["لَئِن سَمَّوكَ مُعتَضِداً فَإِنّي","أَظُنُّكَ سَوفَ تُعضَدُ عَن قَريبِ",92,"ب",1,0],["لين سيله يوْصل العافي","كل بَطْحا شِعْب تَنْحِي به",93,"ب",2,0],["لئن سترتك بطون اللحود","فوجد