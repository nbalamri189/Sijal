َمينَ أَباً وَجَدّاً","وَيا اِبنَ عُضادَةِ الدينِ القَويمِ",4,"م",1,0],["أيا ابنة فندي أن للمجد غايةً","وأني في أدراكها باذل وسعي",5,"ع",2,0],["أَيا اِبنَ الكِرامِ الصَيدِ جاءَت كَريمَةً","أَيا اِبنَ الكِرامِ الصَيدِ وَالسادَةِ الغُرِّ",6,"ر",1,0],["أَيا أُمَّ الأَسيرِ سَقاكِ غَيثٌ","بِكُرهٍ مِنكِ ما لَقِيَ الأَسيرُ",7,"ر",1,1],["أَيا أُمَّ الأَسيرِ سَقاكِ غَيثٌ","تَحَيَّرَ لايُقيمُ وَلا يَسيرُ",7,"ر",1,0],["أَيا أُمَّ الأَسيرِ سَقاكِ غَيثٌ","إِلى مَن بِالفِدا يَأتي البَشيرُ",7,"ر",1,0],["أَيا أُمَّ الأَسيرِ لِمَن تُرَبّى","وَقَد مُتِّ الذَوائِبَ وَالشُعورُ",7,"ر",1,0],["أَيا أُمّاهُ كَم هَمٍّ طَويلٍ","مَضى بِكِ لَم يَكُن مِنهُ نَصيرُ",7,"ر",1,0],["أَيا أُمّاهُ كَم سِرٍ مَصونٍ","بِقَلبِكِ ماتَ لَيسَ لَهُ ظُهورُ",7,"ر",1,0],["أَيا أُمّاهُ كَم بُشرى بِقُربي","أَتَتكِ وَدونَها الأَجَلُ القَصيرُ",7,"ر",1,0],["أيا ابن السراة المالئين فجاجها","ردًى وندًى يوم الكريهة والسّلم",8,"م",1,0],["أيا ابن حريثٍ لا تَهِدْك عَضيهَةٌ","فإنك بالهُون الطويل موقَّحُ",9,"ح",1,0],["أيا ابن التي كانت تحيض من استها","يد الدهر لم يطهر لها قط مِئزر",10,"ر",1,0],["أيا أملي هبك لم تُقْضَ لي","يدٌ من يديك ألا خِنْصر",11,"ر",1,0],["أيا ابن المُعلَّى كن معلَّىً ولا تكنْ","حريصاً على تضييعكَ اسمَ أبيكا",12,"ك",2,1],["أيا أملي أتمرعُ بطنَ كفٍّ","لعافٍ واللقاءُ له مُحولُ",13,"ل",1,0],["أيا ابنَ رجاءٍ وابنَهُ الخيرَ لا يزلْ","رجاءٌ نحيفٌ يَغْتَدي بكَ بادنا",14,"ن",2,1],["أيا آل وهبٍ لقد رعتُمُ","عظامَ النُّواسيِّ أعني الحسن",15,"ن",1,0],["أيا أثلاتِ القاعِ أمّا عروقُها","فَريَّا وأمَّا ظِلُّها فبليلُ",16,"ل",1,0],["أَيا اِبنَ أُنوفِ الغُرِّ مِن آلِ هاشِمٍ","وَأَكرَمِهِم في الخَيرِ وَالشَرِّ مَوقِعا",17,"ع",2,0],["أَيا إِخوَتي آجالُنا تَتَقَرَّبُ","وَنَحنُ مَعَ اللاهينَ نَلهو وَنَلعَبُ",18,"ب",1,1],["أَيا آمِنَ الأَيّامِ مُستَأنِساً بِها","كَأَنَّكَ قَد واجَهتَ مِنها خُؤونَها",19,"ن",3,0],["أَيا اِبنَ الكِرامِ الكُماةِ الحُماةِ","كُنوزِ العَفافِ وَكَهفِ العُفاةِ",20,"ه",1,1],["أَيا آيَةَ اللَهِ الَّتي مُذ تَبَلَّجَت","عَلى خَلقِهِ أَخفى الضَلالَ ظُهورُها",21,"ر",3,0],["أيا أوحدَ الإسلامِ إني معوِّلٌ","عليكَ وما المملوكُ في قصدِهِ غرُّ",22,"ر",1,0],["أيا أرضَ الشمالِ فدتكِ نفسي","وأُصغِرُ أنْ أقولَ فداكِ مالي",23,"ي",1,1],["أَيا أَبَتي دَعني وَما قَد لَقَيتُهُ","وَلا تَلحَ مَحزونَ الفُؤادِ سَقيما",24,"م",2,1],["أَيا اِبنَ رَسولِ اللَهِ رِفقاً بِمُغرَمٍ","فَعَمّا قَليلٍ يَنقَضي فيكَ نَحبُهُ",25,"ه",1,1],["أيا ابن ابي زمورٍ الماجدَ الذي","تَبَدَّل كي يُنسى فلم يَكُ مَنسيا",26,"ي",2,1],["أَيا أَمينَ اللَهِ مَن لِلنَدى","وَعِصمَةِ الضَعفى وَفَكِّ الأَسير",27,"ر",1,1],["أَيا ابنَ أَبانٍ هَل سَمِعتَ بِفاسِقٍ","يُعَدُّ مِنَ النُسّاكِ فيمَن مَضى قَبلي",28,"ل",2,0],["أَيا أَرضُ فَوقَكِ أَهلُ الذُنوبِ","فَهَل بِكِ مِن ذاكَ هَمٌّ وَبث",29,"ث",1,1],["أيا أسداً في جسمه روح ضيغم","وكم أسدٍ أرواحهنّ كلاب",30,"ب",1,0],["أيا ابن أخي من أنت ما اسمك ما الذي","عراك فلم تفرح فهل أنت مُوجع",31,"ع",1,0],["أيا ابنيَ ما يَعْنيك من نَوح أيِّم","لها من رزايا الدهر قلب مُفجَّع",31,"ع",1,0],["أَيا اِبنَةَ مالِكٍ كَيفَ التَسَلّي","وَعَهدُ هَواكِ مِن عَهدِ الفِطامِ",32,"م",1,0],["أَيّاً أَرَدْتَ بِمَدْحِهِ","لَمْ يَعْدُ رُفْقَتَهُ المُرَادْ",33,"د",1,0],["أَيَا آيَةَ الشَّرْقِ الَّتِي ضَنَّتِ العُلَى","بِاشْرَفَ مِنْهَا فِي العُصُورِ وَأَمجَدَا",34,"د",2,0],["أيا ابنة كل اخضرار المروج..","أنا ابن الجفاف .. وما استولدا..",35,"د",2,0],["أَيا اِبنَةَ عَبدِ اللَهِ وَاِبنَةَ مالِكٍ","وَيا اِبنَةَ ذي البُردَينِ وَالفَرَسِ الوَردِ",36,"د",1,1],["أيا ابنيَّ، أحببْ بما تتلقان!","وأهونْ بما تكسران عليا!",37,"ي",2,0],["أيا إخوتي آجالُنا تتقرَّبُ","ونحْنُ معَ الأهلينَ نَلْهُو ونَلْعَبُ",38,"ب",1,1],["أَيَا أُمَّ لَيْلَى حَسْبُ لَيْلَى عَذَابُهَا","تَوفَّرَ مَسْعَاهَا وَقَلَّ اكْتِسَابُهَا",39,"ه",2,0],["أَيا اِبنا ذَلِكَ القرم المُفَدى","مَلَكتا بِالنَدى رِق الرِجال",40,"ل",1,0],["أيا أَيُّها المُهدي لِيَ الشَتمَ ظالِماً","وَلَستُ بِأَهلٍ حينَ أُذكَرُ لِلشَتمِ",41,"م",1,1],["أيَا ابنَ حَبِيبِ اللهِ لَم تَكُ عِندَنَا","بِمُحتَرَمٍ جَراَّ الأبَاطِيلِ واللُّوَى",42,"و",2,0],["أَيا أَخَوَينا عَبدَ شَمسٍ وَنَوفَلا","أُعيذُكُما أَن تَبعَثا بَينَنا حَربا",43,"ب",2,1],["أَيا اِبنَ الأَنفِ أَنف بَني قُصَيٍّ","كَأَنَّ جَبينَكَ القَمَرُ المُنيرُ",44,"ر",1,0],["أيا أخي والودّ أرحامهُ","إن تُقطَع الأرحامُ لم تُقطعِ",45,"ع",1,0],["أَيا أُختِ ما بالُ ذا الأَعصُرِيِّ","سَلا حينَ بَلَّغتِهِ ما طَلَب",46,"ب",1,0],["أيا أهل فن الطب باللّه خبروا","أيوجد للصبّ النحيل دواء",47,"ا",2,1],["أَيا أَخَوَىَّ بالمَدينَةِ أَشرِفا","بِىَ الصَّمدَ أَنظُر نَظرَةً هَل أَرى نَجدَا",48,"د",2,1],["أيا ابنةَ القومِ كم يُعْزى السماحُ لكمْ","ونيلُ وصلكُمُ المرجوُّ محظور",49,"ر",1,0],["ايا ابن كريم وابن خير كريمة","بك اليوم ارجو كشف ضر كريمتي",50,"ي",1,0],["أيا ابنَ معزّ الدين والفضلُ كلُّه","إليك انتهى دون الأعارِبِ والعُجْمِ",51,"م",1,0],["أَيا السَيِّدُ ما ساعِ","دُ أَيمانِكَ مُشتَدُّ",52,"د",1,1],["أَيَا أَبَا الْعَبَّاسِ يَا مَنْ بِهِ","أَمْسَى غَرِيبُ الْعِلْمِ ذَا أُسْرَهْ",53,"ر",2,0],["أيا ابنَ عليٍ أنت فاضلُ عصرنا","وإنك أن تُدعَى بفاضله أحرى",54,"ر",2,0],["أيا أهلَ النميمةِ والرواغِ","أحاديث العُلى شغلُ الفراغِ",55,"غ",1,1],["أيا أمِّ هذا النأيُ لم يُبقِ لذةً","لِقَلبي فإني قد عريتُ نضيرا",56,"ر",2,0],["أيا أمِّ والأمواجُ تَفصُلُ بيننا","فأسمعُ مِنها في الظلامِ هَديرا",56,"ر",2,0],["أيا ابنةَ سوريّا أيا ابنةَ يعربٍ","أيا بنةَ أجدادٍ مناقِبُهُم غُرُّ",57,"ر",1,0],["أيا أهلَ المشارقِ لا تناموا","فإنَّ عدوَّكُم في ألفِ زِيِّ",58,"ي",1,0],["أيا ابن الألى جادوا وقد بخل الحيا","وقادوا المذاكي والدماء نعالها",59,"ل",3,0],["أيا أندى الورى وجها وكفا","وأقومهم إلى العليا طريقه",60,"ه",1,1],["أيا ابن نباتةٍ أهديت شعراً","نصيبي سكرٌ منه وسكرُ",61,"ر",1,1],["أَيا أَسَفاهُ مَن أَرجو بَقاهُم","أَضاعوني وَأَيُّ فَتى أَضاعوا",62,"ع",3,0],["أيا أَهْدى من الشُّهُبِ السَواري","ويا أَندَى من السُّحُبِ الغِزارِ",63,"ر",1,1],["أَيا اِبنَ فُلانٍ وَالنَصيحَةُ آيَةُ","فَما لَكَ مِنها حينَ تُعرَضُ تُعرِضُ",64,"ض",1,0],["أَيا أَبَتي ظالِماً قَد عَبَد","تَ ما لَيسَ يُغنيكَ أَعمى أَصَم",65,"م",1,0],["أيا أمَّ المخلص لن تزالي","لنا نحو العلا باباً ومرقى",66,"ق",2,1],["أيا أغنياءَ الروح صونوا كنوزَكم","وخافوا عليها من لصوص بني الدهرِ",67,"ر",1,1],["أَيا ابن السابِقين إِلى المَعالي","فَهُم في ذُروة العليا حُلول",68,"ل",1,0],["أَي