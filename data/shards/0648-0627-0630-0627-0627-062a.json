6,"صور إيمانية","https://www.poetsgate.com/ViewPoem.aspx?id=192502",""],[5956,"أقصوصة شاعر وحانوت","https://www.poetsgate.com/ViewPoem.aspx?id=193640",""],[6033,"أنا والشعر","https://www.poetsgate.com/ViewPoem.aspx?id=215798",""],[5309,"جذل وقلبي لا يزال عليلا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573525",""],[520,"جعل الدعاء وظيفة لك والثنا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577671",""],[6202,"الشعر والسيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86705&r=&rc=6",""],[6314,"المهدية المنتظِرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88075&r=&rc=10",""]],"verses":[["وَإِذَا أَتَتْكَ عَشِيَّةً فانْشُدْ لَهَا","عَارَضْنَنَا أَصُلاً فَقُلنا الَّربْرَبُ",0,"ب",1,0],["وَإِذا أَتاكَ بَنو السَبيلِ فَأَعطِهِم","مِن فَضلِ نِعمَتِهِ الَّتي أَعطاكَها",1,"ك",3,0],["وَإِذا أَتَيتَ مُعَتِّباً في دارِها","أَلفَيتَ أَهلَ نَدىً هُناكَ خَبيرِ",2,"ر",1,1],["وإذا آتٍ أتاها","قال عوليني بمهرِكْ",3,"ك",1,0],["وَإِذا أَتى بابَ الأَميرِ لِحاجَةٍ","سَمَتِ العُيونُ إِلى أَغَرَّ طُوالِ",4,"ل",1,0],["وَإِذا أَتَيتَ بَني كُلَيبٍ لَم تَجِد","عَدَداً يُهابُ وَلا كَبيرَ نَوالِ",4,"ل",1,0],["وَإِذا اِتَّكَلتَ عَلى الخَطي","بِ فَما اِتَّكَلتَ عَلى أَحَد",5,"د",1,0],["وَإِذا أَتى مِن وَجهِهِ لِطَريقِهِ","لَم أَطَّلِع مِمّا وَراءَ خِبائِهِ",6,"ا",3,0],["وَإِذا أَتى الإِرشادُ مِن سَبَبِ الهَوى","وَمِنَ الغُرورِ فَسَمِّهِ التَضليلا",7,"ل",2,0],["وَإِذا أَتاهُ مُبَشِّرٌ بِقُدومِهِم","فَمِنَ القَميصِ وَمِن شَذى أَردانِهِ",8,"ن",2,0],["وَإِذا أَتَتكَ مَذَمَّتي مِن ناقِصٍ","فَهِيَ الشَهادَةُ لي بِأَنِّيَ كامِلُ",9,"ل",1,0],["وَإِذا اِتَّسَعتَ بِرِزقِ رَبِّكَ فَاِجعَلَن","مِنهُ الأَجَلَّ لِأَوجُهِ الصَدَقاتِ",10,"ت",1,0],["وَإِذا أَتى شَيءٌ أَتى لِمُضِيِّهِ","وَكَأَنَّهُ لَم يَأتِ قَطُّ إِذا مَضى",11,"ض",2,0],["وَإِذا اِتَّقى اللَهَ اِمرُؤٌ وَأَطاعَهُ","فَتَراهُ بَينَ مَكارِمٍ وَمَعالِ",12,"ل",1,0],["وَإِذا اِتَّقى اللَهَ الفَتى","فيما يُريدُ فَقَد كَمَل",13,"ل",1,0],["وَإِذا أَتَيتَ الباسِلينَ فَحَيِّهِم","عَنّي تَحِيَّةَ شَيِّقٍ مُتَوَجِّدِ",14,"د",1,0],["وإذا اَّتقاك فبالجرا","ئِد والنجاسةُ للنجاسه",15,"ه",1,0],["وَإِذا أتَت آياتُهُ بِمَدِيحِهِ","رَتَّلتُ منها ذِكرَهُ تَرتِيلا",16,"ل",2,0],["وَإِذا أَتاكَ بِعَيبِهِ","واشٍ فَقُل لَم يَعتَمِده",17,"د",2,0],["وإذا أَتى للدار قا","بلها بشتم واحتقار",18,"ر",1,0],["وإِذا أَتَت صبراً فَما","ذا بعد ذلك منتهاها",19,"ا",3,0],["وإذا أتى الأجلُ النفوسَ فلا تسَلْ","عَنْ صِحَّةِ الأرواحِ والأجسَادِ",20,"د",1,0],["وإذا أتَتْكَ عشية ً فامْدُدْ لها","عَرَضْتَ لنا أصلا فقلنا الرَّبرب",21,"ب",1,0],["وإذا اتّخَذْتِ الهَجْرَ دارَ إقَامَةٍ،","وأخَذْتِ مِنْ مَحضِ الصّدُودِ نَصِيبَا",22,"ب",2,0],["وإذا اتخذت خليلَ صدقٍ صالحاً","وعلمتَ مه الخير أنت الأعرفُ",23,"ف",1,0],["وإذا أتيتُك قبلَ ذا في حاجةٍ","لا يعتريك تلكؤٌ وتعسرُ",24,"ر",1,0],["وإذا أتى مستغفراً من ذنبه","خِلٌّ غفرتُ له ولا أتكبّرُ",24,"ر",1,0],["وَإِذا أَتى غَيري بِحَولِيّاتِهِ","أَربَت عَلَيها وَهيَ بِنتُ لَيالِ",25,"ل",1,0],["وَإِذا أَتَوا بَلَداً جَديباً أَخصَبَت","فيهِ رُباهُ وَأُتئِقَت غُدرانُهُ",26,"ن",2,0],["وإذا أتيت به امرءا في محفل","يطرى به اجزلت من تطرى به",27,"ب",2,0],["وإذا أتاها الشر تحسب أنه","قد صار ضربة لازم بخناقها",28,"ق",3,0],["واذا اتى يوما اليه سائل","ابدى سرورا وجهه وتهللا",29,"ل",2,0],["وَإِذا أَتَتكَ مِنَ العَدُوِّ قَوارِصٌ","فَاِقرُص كَذاكَ وَلا تَقُل لَم أَفعَلِ",30,"ل",1,0],["وَإِذا أَتاهُ الأَمنُ زانَ جَبينهُ","عرقٌ تَحَدَّرَ فَوقَهُ كَجُمانِ",31,"ن",1,0],["وَإِذا أَتاهُ الأَمرُ فيهِ مَسَرَّةٌ","لِلقَلبِ يَسجُدُ سَجدَةَ الشُكرانِ",31,"ن",1,0],["وَإِذا أَتى أَحَدُ الخُصومِ بِخِدعَةٍ","غَشَّت قُضاةُ الحُكمِ بِالبُهتانِ",32,"ن",1,0],["وَإِذا اِتَّهَمت نَصيحَتي فَاِلبسه عَن","رَأي القرين فَقَد رَآه مَليحا",33,"ح",2,0],["وإذا أتَى المُمْتاحُ حَقَّق بالنّدى","كُلَّ الأماني ثُمَّ قال له سَل",34,"ل",1,0],["وإذا أُتيحَ له الطُّلو","عُ لناظرٍ فاللّيلُ شَعْر",35,"ر",1,0],["وإذا أُتيحَ وللجُدودِ مَواهبٌ","لكَ من خلالِ الدّهر صُحبةُ أمجَد",36,"د",1,0],["وإذا أُتيحَ مَواقفٌ مَشهودةٌ","ٌفي نصرِ دينِ اللهِ إن باغٍ عَتا",37,"ت",2,0],["وإذا أتَى زمَنُ الفساد تَرَى","من حيث تُصِلحَ يَكبُرُ الخَطب",38,"ب",1,0],["وَإِذا أَتَت مِنهُ الإِساءَةُ دائِماً","فَلَأَحمِلَنَّ لَها عَلى إِحساني",39,"ن",2,0],["وَإِذا أَتى مال خَزائنه بَدا","بوداعه الخَزّان قَبلَ سَلامِ",40,"م",1,0],["وَإِذا أَتَيتَ فَضيلَة أَخفيتَها","حَتّى كَأَنَّكَ قَد أَتَيتَ جُناحا",41,"ح",2,0],["وإذا أتاهم مستجير خائف","آوى إلى حرم من الأحرام",42,"م",1,0],["وإذا أَتى فصلُ الرَّبيع فبادروا","لتناهب اللّذّات في آذاره",43,"ر",2,0],["وإذا أتيتَ إلى مناهل فضله","لتنال من إحسانه ما نيلا",44,"ل",2,0],["وإذا أتيت لبابه في حاجةٍ","أغناك في بذلك العطاء الوافر",45,"ر",1,0],["وإذا أتاكم حمزة","في أنسكم يتأنس",46,"س",1,0],["وإذا اتتك مذمتي من ناقص","فهي الشهادة لي ولست ذميما",47,"م",2,0],["وإذا أتيت الحيَّ فاضرب حافياً","بيد الديار وقدسن واديها",48,"ي",3,0],["وإذا أتاك السائلون وقيل من","مولى فلان من الولاة فقل أنا",49,"ن",2,0],["وإذا أتحفك الله بها","فاشكر الله لها وادعُ لنا",50,"ن",2,0],["وإذا أتتني مِدْحةٌ من جاهلٍ","فهيَ المَذَمَّةُ لي بأنِّي جاهلُ",51,"ل",1,0],["وإذا أتيتَ القَومَ فارِبضْ جانباً","وإذا استَطعتَ العيشَ وَحدَكَ فافَعلِ",52,"ل",1,0],["وإذا اتَّهمتَ أمينَ قلبِكَ مَرَّةً","وطَلَبتَ مُؤتَمَناً فَلَستَ بواجِدِ",53,"د",1,0],["وإذا أَتى خَطُّ العِذار مُجدِّداً","لَكَ في الولايةِ يا تُرَى مَنْ يَعْزِلُ",54,"ل",1,0],["وإِذا أتاهُ لاجئ","يوماً كفاهُ ما أهمّه",55,"م",2,0],["وإذا أتيت بدرة في وصفكم","فابن المقفع في اليتيمة يسهب",56,"ب",1,0],["وإذا اتخذت إلى الجلاء وسيلة","فسياسة التجديد والانشاء",57,"ا",2,0],["وإذا أتى الحق الصريح تبرُّعاً","وتفضلاً فأجله كأقله",58,"ل",2,0],["وإذا أتى ذو كربة مستقرضاً","أقرضته والحمد ربحي الأجزل",59,"ل",1,0],["وإذا أتى ميعاد مقدور فما","تستصعبون مذلَّلٌ وميسر",60,"ر",1,0],["وإذا أُتْخِم بَطنُ المرء من","قلّةِ الأكل فمن ضَعف المِعَدْ",61,"د",1,0],["وإذا أتى نهي فللتخفيف لا","التَّحريم إذ لا من قوى الضعفاءِ",62,"ا",2,0],["وإذا أتى الا اطراحاً","للنصيحة واعتزالا",63,"ل",2,0],["وإذا أتيت بطاعة","فيها تمنُّ وتعجب",64,"ب",1,0],["وإذا أتهم فالمسرى تهام","ثمل رنحه خمر الدلال",65,"ل",1,0],["وَإِذا أَتَيتَ قُبورَهُم فَاِسأَلهُم","عَما لَقوا فيها مِنَ الأَهوالِ",66,"ل",1,0],["وإذا أتى ليلحقا","بك جهول يغرق",67,"ق",1,0],["وإذا أتاه مؤمل في حاجة","أعطى عطاء ليس فيه تربص",68,"ص",1,0],["وإذا أتته نعْمة لم تُطغِه","وإذا عرَتهُ مُلِّمةٌ لم يضْرَعِ",69,"ع",1,0],["وإذا أتلَفَ شيئاً لم أقل","أبداً يا صاحِ ما كانَ فَعَل",70,"ل",1,0],["واذا اتاهم ولا يبغى سوى خبر","ممود يوما بخير جاء ملانا",71,"ن",2,0],["وإذا أتى من بعد ياءٍ قبلَها","جيمٌ فقيدها بضادٍ تُختمُ",72,"م",1,0],["وإذا أتت كرب","يكشفن لغمتنا",73,"ن",2,0],["وإذا أتاك مهلبيٌّ في الوغى","والسيفُ في يده فنعم الناصرُ",74,"ر",1,0],["وَإذَا أتَى الكِتمَانُ بَعدَ شَوَاهِدِ ال","أحوَالِ كَانَ كَأقبَحِ الكِتمَانِ",75,"ن",1,0],["وَإِذَا أتَتكَ فَلاَ تَكُن مُستَوحِشاً","مِنهَا وَلا تَكُ عِندَهَا بِجَبَانِ",75,"ن",1,0],["وإذَا أتَى للفَصلِ يُشرِقُ نُورُهُ","فِي الأرضِ يَومَ قِيَامَةِ الأبدَانِ",75,"ن",1,0],["وَإِذا أَتَتكَ مِنَ الشُئونِ عَويصَةٌ","فَاِعهَد بِها لِتَصَرُّفِ الأَزمانِ",76,"ن",1,0],["وإذا أتيتَ القبرَ قبرَ مُحَمَّدٍ","وحمدتَ سَعياً من سِفَارِكَ ناجِحا",77,"ح",2,0],["وإذا أتته الخيلُ صَفَّنَا ذادَها","وإذا أتاه الألف ضَيْفاً ضيّفَا",78,"ف",2,0],["واذا اتخذت اميل شامي صاحباً","فاميل اكرم صاحب وزميل",79,"ل",1,0],["واذا أتاك الموت من دون المنا","لا تجزعي لا تجزعي لا تجزعي",80,"ع",2,0],["وإذا أتيت الحي فادخل في حمى","يرعى به جار ويأمن خائف",81,"ف",1,0],["وإذا أتى موس التختن غائظاً","فاعذهم منه بموسى الكاظم",82,"م",1,0],["وإذا أتى روضة ليجني","لم يك من ناره ليحرق",83,"ق",1,0],["وَإِذا أَتَيتَ نَدِيَّ قَومٍ فَاِلقَهُم","بِاِسمِ السَلامِ وَرد بِحِلم وَاِصدُرِ",84,"ر",1,0],["وإذا أتاني الضيف أنهضُ جاهداً","وأضيفه من صحّتي وطعامي",85,"ي",1,0],["وإذا أتاكِ السائلون بدا لهم","وجهٌ بشاشته منى وسعودُ",86,"د",1,0],["وإذا أتى الشهر المحرم فابكهم","بفرائدٍ من بحرك الزَّخَّار",87,"ر",1,0],["وَإِذا أَتَيتَ تَزورُه في مَجمَعٍ","بَينَ العِبادِ رَأَيتَهُ وَقَدِ اِنتَصَب",88,"ب",1,0],["وَإِذا أَتى الحُرُّ الكَريمُ","نَحوَ الكَريمِ يَؤوبُ مِنهُ بِنُجعِهِ",89,"ع",2,0],["وَإِذا أَتى يَوم الحِساب فَلا","أسفٌ يفيدكم وَلا ندمُ",90,"م",1,0],["وَاِذا اتيتُم لِلرُبوعِ فَديتكم","فَعلى رُباها فيضَ دَمعٍ اوقفوا",91,"ف",3,0],["وإذا أتيت