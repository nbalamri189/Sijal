{"poems":[[87,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[87,"لك في الأرض والسماء مآتم","https://www.aldiwan.net/poem11330.html","الخفيف"],[87,"مملكة مدبره","https://www.aldiwan.net/poem63766.html","مجزوء الرجز"],[68,"لا عبد يغني عنه ولا ولد","https://www.aldiwan.net/poem40130.html","المنسرح"],[82,"أوميض البرق في الليل البهيم","https://www.aldiwan.net/poem31292.html","الرمل"],[119,"يا بويرق الحمى","https://www.aldiwan.net/poem41233.html","عموديه"],[230,"إن ما بت تشتكي منه داء","https://www.aldiwan.net/poem55207.html","الخفيف"],[309,"كم بقلبي فيك من شجن","https://www.aldiwan.net/poem16838.html","المديد"],[435,"لاح في مهد المعالي والسنا","https://www.aldiwan.net/poem40715.html","الرمل"],[449,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[473,"ذا يوم برق ويوم رعد","https://www.aldiwan.net/poem60229.html","مخلع البسيط"],[565,"يا خفي اللطف","https://www.aldiwan.net/poem67258.html","عموديه"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104600","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63935","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64088","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63929","البسيط"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205475","الخفيف"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111864","الخفيف"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77826","الرمل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89526","البسيط"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106971","الرمل"],[2766,"","https://poetry.dctabudhabi.ae/diwan/poem/124308","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93800","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58453","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58413","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58320","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204920","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74217","الخفيف"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/137994",""],[3139,"","https://poetry.dctabudhabi.ae/diwan/poem/203409","الخفيف"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66578","السريع"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93306","الخفيف"],[4755,"خَلفَ هذا اللَّيلِ طِفلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=183631",""],[4816,"سامحكم الله","https://www.poetsgate.com/ViewPoem.aspx?id=8491",""],[5121,"سُلْطَانُ الرُّوح","https://www.poetsgate.com/ViewPoem.aspx?id=49547",""],[5369,"اعترف","https://www.poetsgate.com/ViewPoem.aspx?id=177442",""],[5956,"سيارة وسط الصحراء","https://www.poetsgate.com/ViewPoem.aspx?id=184691",""],[5973,"إسمحي لي بالموت بين يديك","https://www.poetsgate.com/ViewPoem.aspx?id=14391",""],[6127,"لَمُّ الجراحِ","https://www.poetsgate.com/ViewPoem.aspx?id=202685",""]],"verses":[["ذائِدُ الحَقِّ وَحامي حَوضِهِ","أَنفَذَت فيهِ المَقاديرُ مُناها",0,"ا",3,0],["ذائِداً عَن مَمالِكٍ وَشُعوبٍ","نُقِلَت في الأكُفِّ نَقلَ الدَراهِم",1,"م",1,0],["ذائِدَةٌ عَن حَوضِها","طارِدَةٌ مَن كَدَّرَه",2,"ر",2,0],["ذا يَتَمَنّى فَقدي لِكَي يَجدَ ال","مالَ وَهَذا لِحُزنِهِ يَجِدُ",3,"د",1,0],["ذائدٌ بالسيف عَنْ دينِ الهدى","سالكٌ فيه سراطاً مستقيم",4,"م",1,0],["ذائب في غلالتي","مر وجد وعذبه",5,"ب",2,0],["ذا يُلَبّي الكَلامُ إن هو نادا","هُ وَهذا يَعنو لهُ العُظماء",6,"ا",2,0],["ذائب الأحشا من اللهب","هو والأسقام في رسن",7,"ن",1,0],["ذا يمينٍ بنوالٍ كافله","خلقت كي تمنح الناس الغنى",8,"ن",2,0],["ذا يكون الحال في الصيف هنا","وإلى ناحية النهى انحدر",9,"ر",1,0],["ذا يَومُ بَرقٍ وَيَومُ رَعدِ","فَاِعمَل عَلى الإِصطِباحِ عِندي",10,"د",2,1],["ذائبٌ يأملُ ألا يلتقي","أنبياءَ اللهِ بالذنب الشنيعْ",11,"ع",1,0],["ذائبُ النارِ حلَّ في جامدِ ال","ماءِ فاعجب بالذّائبِ الجَمديِّ",12,"ي",1,0],["ذائداً عن حُشاشَةِ النفس حتى","لم يَدَعْ للنفوسِ منهم حُشَاشا",13,"ش",2,0],["ذا يوازيه بالثريا وهذا","عنده أنه أخو العيوق",14,"ق",1,0],["ذا يومُ طلٍّ ويومُ رشّ","قد نَقَشَ الروضَ أيَّ نَقْش",15,"ش",1,1],["ذائد النوم عن جفوني ومغري","ه بجفن العدو ذي الشنآن",16,"ن",1,0],["ذا يقيني ابديتهُ لكَ عفواً","فأَتى ساذجاً كهذا النظامِ",17,"م",1,0],["ذا يقيني ذاكَ ديني","ذاكَ حبي ذاك ربي",18,"ي",1,0],["ذا يَطلُبُ العَفوَ مِن عُقبى جَريرَتِهِ","وَذا يُؤَمِّلُ فَضلاً غَيرَ مَمنونِ",19,"ن",1,0],["ذائب من فوقها الدر انتثر","أم هي الريق وهذا الكاس فم",20,"م",1,0],["ذا يهيج الورى من ذنبهم وجلٌ","لا أختشى في الورى من ذنبي الوجلا",21,"ل",2,0],["ذا يعاطيه كاسها بدرتهم","ويعاطي ذياك ظبي كناس",22,"س",1,0],["ذا يُنادي بالَلْحَرافيشِ مَنْ في","كُمُ مِثلي وَقَدْ تَفَرَّدتُ وَحْدي",23,"د",2,0],["ذا يُنادي قالَ الأَميرُ أطلبوا الدَّي","وانَ واستَعجِلوا مَعَ الكيّالِ",24,"ل",1,0],["ذا يُنادي رفيقَهُ يا عنيكير","وهذا يصيحُ ما محلوس",25,"س",1,0],["ذا يربي بنيه يبغي بقاء","وبهدْي الأنام أبغى بقائي",26,"ي",1,0],["ذا يَراع إذا دعته اللَيالي","كانَ أَمضى مِن الحسام وَأَجرى",27,"ر",2,0],["ذا يوم فيه الصفا مزنه رذيم","وآذن بوصله لنا حلو الخضاب",28,"ب",1,0],["ذا يلي مصر فهو مصر وهذا","يتولى وسيم فهو وسيم",29,"م",1,0],["ذا يوسفٌ رُدَّ أَخوهُ لَهُ","وَماتَ ذاكَ النَّازِعُ النَّازِح",30,"ح",1,0],["ذا يدٍ ذائِداً بها نُوَبَ ال","دَّهْر فكم ردّها بأَبرح غُلَّه",31,"ل",2,0],["ذائِبٌ.. والجُوعُ يَحْسُو","ظِلَّهُ الطاوِي وذَوْبَهْ",32,"ب",2,0],["ذاير بعينه عني وقالي خير","ويارب كلمة خير الفة وصحابه",33,"ب",2,0],["ذَا يَعْرُبِيٌّ فِي وِدَادِي جَانِحٌ","كَالصَّقْرِ يَسْمُو إِنْ تَرَاءَى جَنَّنَا",34,"ن",2,0],["ذا يجئُ الأمرَ رأساً","ذا يدورُ أو يلِف",35,"ف",1,0],["ذا يَجيئُ برحمة من ربِّهِ","وَيَمُرُّ يُنْجيهمْ مِنَ التَّحطيمِ",36,"م",1,0],["ذائب ٌ والرحمن ِ فيك ِ أنا","حتي حدود ِ التراب ِ في قدَمَيك ِ",37,"ك",1,0],["ذا يومُ مولدِكَ المزهو بعودتِهِ","في كلّ عامٍ يُباري عشقُنا ألَما",38,"م",2,0]]}