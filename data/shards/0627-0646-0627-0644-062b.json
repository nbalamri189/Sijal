{"poems":[[55,"بالجد لا بالمساعي يبلغ الشرف","https://www.aldiwan.net/poem29972.html","البسيط"],[79,"حيى ربوع الحي من نعمان","https://www.aldiwan.net/poem36079.html","الكامل"],[9,"أوصلت صرم الحبل من","https://www.aldiwan.net/poem21910.html","مجزوء الكامل"],[88,"نثروا عليك نوادي الأزهار","https://www.aldiwan.net/poem10492.html","الكامل"],[29,"قالوا نصيبك من أجر فقلت لهم","https://www.aldiwan.net/poem5959.html","البسيط"],[74,"يا خير من ينبي على جوده","https://www.aldiwan.net/poem20302.html","السريع"],[64,"لا تطمحن إلى المراتب قبل أن","https://www.aldiwan.net/poem52485.html","الكامل"],[46,"نثرت فريد مدامع لم ينظم","https://www.aldiwan.net/poem30353.html","الكامل"],[89,"ما أطيب العيش لولا أنه فاني","https://www.aldiwan.net/poem8209.html","البسيط"],[33,"يا ليتني قد أجزت الحبل نحوكم","https://www.aldiwan.net/poem42540.html","البسيط"],[107,"أرأيت حكمة سيد الكرماء","https://www.aldiwan.net/poem44034.html","الكامل"],[48,"بالغار من هضبي عماية نازل","https://www.aldiwan.net/poem22710.html","الكامل"],[1,"وتقول عاذلتي وليس لها","https://www.aldiwan.net/poem34013.html","الكامل"],[108,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[33,"يا لَيْتَني قَدْ أَجَزْتُ الحَبْلَ نَحْوَكُمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18862&r=&rc=125",""],[132,"ما حاجتي في ذم أهل زماني","https://www.aldiwan.net/poem50497.html","الكامل"],[190,"لو لم أعاقب بالبغ","https://www.aldiwan.net/poem43350.html","مجزوء الكامل"],[234,"إذا خلوت بمحبوب تجمشه","https://www.aldiwan.net/poem50881.html","البسيط"],[285,"أعطى الشباب من الآراب ما طلبا","https://www.aldiwan.net/poem60775.html","البسيط"],[409,"الاجتماع غنيمة","https://www.aldiwan.net/poem33481.html","مجزوء الكامل"],[567,"من يقرب النار لا يسلم من الحرق","https://www.aldiwan.net/poem52861.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138283",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48678","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38074","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38597","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70928","البسيط"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75745","الكامل"],[1235,"","https://poetry.dctabudhabi.ae/diwan/poem/105221","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56575","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108892","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108841","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27562","البسيط"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121225","البسيط"],[2527,"","https://poetry.dctabudhabi.ae/diwan/poem/17714","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137068",""],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100904","الكامل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140090",""],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132957","السريع"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132129","الكامل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34606","البسيط"],[4578,"","https://poetry.dctabudhabi.ae/diwan/poem/114621","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120555","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139521",""],[4767,"طود الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=178888",""],[585,"هل في القطين وراء المنش مستمع","https://www.poetsgate.com/ViewPoem.aspx?id=161904",""],[3859,"رنت بلابلُ في ودٍ من السلم","https://www.poetsgate.com/ViewPoem.aspx?id=124438",""],[5092,"أنا وليلٌ بعينيها","https://www.poetsgate.com/ViewPoem.aspx?id=147140",""],[5587,"أماه","https://www.poetsgate.com/ViewPoem.aspx?id=196690",""],[5956,"اللغة العربية الفصحى ولهجاتها العامية","https://www.poetsgate.com/ViewPoem.aspx?id=202206",""],[6031,"إنَّ الثَّنَاءَ وإنْ تَعاظَمَ قَدْرُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=46392",""],[6031,"كَفُّ الحِمَامِ وَتَرْتِ أيَّ جَوَادِ","https://www.poetsgate.com/ViewPoem.aspx?id=46281",""],[6304,"مهلا ضفاف الرافدين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1612&r=&rc=2",""]],"verses":[["إِنَّ الثَلاثينَ وَالسَبعَ اِلتَوَينَ بِهِ","عَنِ الصِبا فَهوَ مُزوَرٌّ وَمُنعَطِفُ",0,"ف",1,0],["إنّ الثّوَانيَ جَدُّ مُسْتَوْدَعِ التَّوى","وَكَذاَ الْهُوَيْنَي اُمُّ كُلِّ هَوَانِ",1,"ن",1,0],["إِنَّ الثَعالِبَ بِالضُحى","يَلعَبنَ في مِحرابِها",2,"ب",3,0],["إِنَّ الثَلاثينَ الَّتي بِكَ فاخَرَت","باتَت تُقاسُ بِأَطوَلِ الأَعمارِ",3,"ر",1,0],["إِنَّ الثَويَّ بِذي الزَيتونِ فَاِحتَسِبي","قَد أَسرَعَ اليَومَ في عَقلي وَفي حالي",4,"ل",2,0],["إنَّ الثمانين وبلغتها","قد أحوجت سمعي إلى ترجمان",5,"ن",1,0],["إنَّ الثِمارَ تمِرُّ قبلَ بلوغِها","طَعْماً وهنَّ إِذا بلغنَ عِذابُ",6,"ب",1,0],["إِنَّ الثَناءَ يَسيرُ عَرضاً في الوَرى","وَمَحَلُّهُ في الطولِ فَوقَ الأَنجُمِ",7,"م",1,0],["إِنَّ الثَّلاثِينَ وَالْخَمْسَ الَّتِي عَرَضَتْ","ثَنَتْ قُوَايَ وَفَلَّتْ غَرْبَ أَشْجَانِي",8,"ن",2,0],["إِنَّ الثَواءَ بِأَرضٍ لا أَراكِ بِها","فَاِستَيقِنيهِ ثَواءٌ حَقُّ ذي كَدَرِ",9,"ر",1,0],["إنّ الثّناءَ إلى الرجالِ يَسوقُه","لأجلُّ من إبلٍ تُساقُ وشَاءِ",10,"ا",2,0],["إِنَّ الثُرَيّا حينَ صَغَّرَ لَفظَها","أَهلُ البَسيطَةِ مادَنَت لِصَغارِ",11,"ر",1,0],["إِنَّ الثَراءَ هُوَ الخُلودُ وَإِنَّ","المَرءَ يُكرِبُ يَومَهُ العُدمُ",12,"م",1,0],["إن الثِّقَاب الذي أشعلتموه، غدَا","يُؤجَّجُ النار فوق الأرض تَنُّورا",13,"ر",2,0],["إنَّ الثَّواءَ بِأَرْضٍ لا أَرَاكِ بِهَا","فکسْتَيْقِنِيهِ ثَواءٌ حَقُّ ذي كَدَرِ",14,"ر",1,0],["إن الثناءَ عن المودة مخبرٌ","مثل الطروس تبينُ بالعُنْوَانِ",15,"ن",1,0],["إن الثقيل كلامه","مثل الدواء على العليل",16,"ل",1,0],["إنّ الثّقِيل هو المحرومُ لَذَتَه","لا بارك الله فيمن راح ذا ثِقل",17,"ل",1,0],["إِنَّ الثَّلاثِينَ لَمْ يُسْفِرْنَ عَنْ أَحَدٍ","إِلاّ ارْتَدى بِرِداءِ الشِّيْبِ وانْتَقَبَا",18,"ب",2,0],["إن الثقيل هو الذي","يدعونه داء عضالا",19,"ل",2,0],["إن الثَباتَ على عَيبٍ أقمْتَ بهِ","عيبٌ جَديدٌ سِوَى المَغرُوسِ في الخُلُقِ",20,"ق",1,0],["إن الثناء صدى فعالك فالذي","نثني عليك به الصدى متكررا",21,"ر",2,0],["إن الثلاثين التي بُلِّغْتها","لمدارج اللوعات والروعات",22,"ت",1,0],["إِنَّ الثّقيلَ حَديثُهُ","النّفسُ منهُ تَستَغيثْ",23,"ث",1,1],["إِنّ الثّرّيا وَبدرَ الأفقِ قارَنَها","أَبدَت بِهِ طَرَباً ناهيكَ مِن طَرَبِ",24,"ب",1,1],["إن الثعالبَ إن تسعى مساعيَهُمْ","فللثعالب عن أحداثهم نفَق",25,"ق",1,0],["ان الثَلاثة انت افضل نسلها","ساماً وَحاما ذا الزَمان وَيافثا",26,"ث",2,0],["ان الثياب التي بالعز يلبسها","بيض فما مسها ريب من التهم",27,"م",1,0],["إن الثلاثين التي","مرت بنا مر العصور",28,"ر",1,0],["إن الثناء الذي أربى سناه على","زهر النجوم وراق العرب والعجما",29,"م",2,0],["إن الثناء عليه فرضٌ واجبٌ","قد شارك الذميُّ فيه المسلما",30,"م",2,0],["إن الثناء على الأسماء أجمعها","بها وليس سواها يعرفون ولا",31,"ل",2,1],["ان الثريا التي فوق الغلالة ما","بآخر الجيد تحت الخافق النظر",32,"ر",1,0],["إِنَّ الثَراءَ هُوَ الخُلودُ وَإِن","نَ المَرءَ يُكرِبُ يَومَهُ العُدمُ",33,"م",1,0],["ان الثمانين عاماً قد خدمت بها","بني بلادي وقد اعياني التعب",34,"ب",1,0],["إن الثلاثينَ التى لابستَهم","شهدت بأنك ما تزال حكيما",35,"م",2,0],["ان الثوابت في السما شبهتها","بازاهر مبيضة في خضرة",36,"ه",1,0],["إن الثلاثين التي قد مَضَت","فيها لذي مُعتَبرٍ خُبرُ",37,"ر",1,0],["إن الثلاثة لو علمتم وحدها","ركن البناء إذا البناء يقام",38,"م",1,0],["إن الثمانين إذ وفَّيت عدتها","لم تُبقِ باقيةً مني ولم تَذَرِ",39,"ر",1,0],["ان الثنا بنظم الدر ليس يرى","الا بمنسوج ما اسديت من ذهب",40,"ب",1,0],["ان الثناء على الكريم بشارة","بحياته وعلى اللئيم هي النعى",41,"ع",2,0],["ان الثناء لإن أضحى تشعُّبه","في الناس طراً فمن علياك مقتضب",42,"ب",1,0],["إن الثريا نورَها","ما قِيسَ يوماً بالثرى",43,"ر",2,0],["إن الثلاثين عاماً من وصايتكم","كاللغز تومض من أثنائه اللمع",44,"ع",1,0],["إن الثريا سعت سعياً لذي رشدٍ","حتَّى حكت حليها المنوطَ بالحِكَمِ",45,"م",1,0],["إنَّ الثوانيَ لا تفارقنا","في الحزنِ تُصبحُ دائماً دَهْرا",46,"ر",2,0],["إِنَّ الثَّنَاءَ عَلَيْكِ يُظْهِرُ حُسْنَهُ","يَا جَنَّتِي وَ سَرِيرَةً لَا تُعْلَمُ",47,"م",1,0],["إنَّ الثراء جديداً صار مطلبنا","حتماً وإلا فعنا الكوكبُ انفضا",48,"ض",2,0],["إنَّ الثَّنَاءَ وإنْ تَعاظَمَ قَدْرُهُ","لَيَهُونُ في قَدْرِ العَظيمِ ويَحقُرُ",49,"ر",1,1],["إنَّ الثلاثَ البِيضَ حَالَتْ بعدَهُ","سُوداً فما يَعْرِفْنَ غَيْرَ ذآدي",50,"د",2,0],["أنّ الثرى يَبَساً يَعيشُ بطيفه","أبداً .. وتَحمِل سِرَّه الرَمضاء",51,"ا",2,0]]}