{"poems":[[53,"بالجد لا بالمساعي يبلغ الشرف","https://www.aldiwan.net/poem29972.html","البسيط"],[77,"حيى ربوع الحي من نعمان","https://www.aldiwan.net/poem36079.html","الكامل"],[9,"أوصلت صرم الحبل من","https://www.aldiwan.net/poem21910.html","مجزوء الكامل"],[86,"نثروا عليك نوادي الأزهار","https://www.aldiwan.net/poem10492.html","الكامل"],[27,"قالوا نصيبك من أجر فقلت لهم","https://www.aldiwan.net/poem5959.html","البسيط"],[72,"يا خير من ينبي على جوده","https://www.aldiwan.net/poem20302.html","السريع"],[62,"لا تطمحن إلى المراتب قبل أن","https://www.aldiwan.net/poem52485.html","الكامل"],[44,"نثرت فريد مدامع لم ينظم","https://www.aldiwan.net/poem30353.html","الكامل"],[87,"ما أطيب العيش لولا أنه فاني","https://www.aldiwan.net/poem8209.html","البسيط"],[31,"يا ليتني قد أجزت الحبل نحوكم","https://www.aldiwan.net/poem42540.html","البسيط"],[105,"أرأيت حكمة سيد الكرماء","https://www.aldiwan.net/poem44034.html","الكامل"],[46,"بالغار من هضبي عماية نازل","https://www.aldiwan.net/poem22710.html","الكامل"],[1,"وتقول عاذلتي وليس لها","https://www.aldiwan.net/poem34013.html","الكامل"],[106,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[31,"يا لَيْتَني قَدْ أَجَزْتُ الحَبْلَ نَحْوَكُمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18862&r=&rc=125",""],[128,"ما حاجتي في ذم أهل زماني","https://www.aldiwan.net/poem50497.html","الكامل"],[186,"لو لم أعاقب بالبغ","https://www.aldiwan.net/poem43350.html","مجزوء الكامل"],[229,"إذا خلوت بمحبوب تجمشه","https://www.aldiwan.net/poem50881.html","البسيط"],[280,"أعطى الشباب من الآراب ما طلبا","https://www.aldiwan.net/poem60775.html","البسيط"],[403,"الاجتماع غنيمة","https://www.aldiwan.net/poem33481.html","مجزوء الكامل"],[562,"من يقرب النار لا يسلم من الحرق","https://www.aldiwan.net/poem52861.html","البسيط"]],"verses":[["إِنَّ الثَلاثينَ وَالسَبعَ اِلتَوَينَ بِهِ","عَنِ الصِبا فَهوَ مُزوَرٌّ وَمُنعَطِفُ",0,"ف",1,0],["إنّ الثّوَانيَ جَدُّ مُسْتَوْدَعِ التَّوى","وَكَذاَ الْهُوَيْنَي اُمُّ كُلِّ هَوَانِ",1,"ن",1,0],["إِنَّ الثَعالِبَ بِالضُحى","يَلعَبنَ في مِحرابِها",2,"ب",3,0],["إِنَّ الثَلاثينَ الَّتي بِكَ فاخَرَت","باتَت تُقاسُ بِأَطوَلِ الأَعمارِ",3,"ر",1,0],["إِنَّ الثَويَّ بِذي الزَيتونِ فَاِحتَسِبي","قَد أَسرَعَ اليَومَ في عَقلي وَفي حالي",4,"ي",1,0],["إنَّ الثمانين وبلغتها","قد أحوجت سمعي إلى ترجمان",5,"ن",1,0],["إنَّ الثِمارَ تمِرُّ قبلَ بلوغِها","طَعْماً وهنَّ إِذا بلغنَ عِذابُ",6,"ب",1,0],["إِنَّ الثَناءَ يَسيرُ عَرضاً في الوَرى","وَمَحَلُّهُ في الطولِ فَوقَ الأَنجُمِ",7,"م",1,0],["إِنَّ الثَّلاثِينَ وَالْخَمْسَ الَّتِي عَرَضَتْ","ثَنَتْ قُوَايَ وَفَلَّتْ غَرْبَ أَشْجَانِي",8,"ي",1,0],["إِنَّ الثَواءَ بِأَرضٍ لا أَراكِ بِها","فَاِستَيقِنيهِ ثَواءٌ حَقُّ ذي كَدَرِ",9,"ر",1,0],["إنّ الثّناءَ إلى الرجالِ يَسوقُه","لأجلُّ من إبلٍ تُساقُ وشَاءِ",10,"ا",2,0],["إِنَّ الثُرَيّا حينَ صَغَّرَ لَفظَها","أَهلُ البَسيطَةِ مادَنَت لِصَغارِ",11,"ر",1,0],["إِنَّ الثَراءَ هُوَ الخُلودُ وَإِنَّ","المَرءَ يُكرِبُ يَومَهُ العُدمُ",12,"م",1,0],["إن الثِّقَاب الذي أشعلتموه، غدَا","يُؤجَّجُ النار فوق الأرض تَنُّورا",13,"ر",2,0],["إنَّ الثَّواءَ بِأَرْضٍ لا أَرَاكِ بِهَا","فکسْتَيْقِنِيهِ ثَواءٌ حَقُّ ذي كَدَرِ",14,"ر",1,0],["إن الثناءَ عن المودة مخبرٌ","مثل الطروس تبينُ بالعُنْوَانِ",15,"ن",1,0],["إن الثقيل كلامه","مثل الدواء على العليل",16,"ل",1,0],["إنّ الثّقِيل هو المحرومُ لَذَتَه","لا بارك الله فيمن راح ذا ثِقل",17,"ل",1,0],["إِنَّ الثَّلاثِينَ لَمْ يُسْفِرْنَ عَنْ أَحَدٍ","إِلاّ ارْتَدى بِرِداءِ الشِّيْبِ وانْتَقَبَا",18,"ب",2,0],["إن الثقيل هو الذي","يدعونه داء عضالا",19,"ل",2,0],["إن الثَباتَ على عَيبٍ أقمْتَ بهِ","عيبٌ جَديدٌ سِوَى المَغرُوسِ في الخُلُقِ",20,"ق",1,0]]}