=29409",""],[192,"تعبت","https://www.poetsgate.com/ViewPoem.aspx?id=16345",""],[5939,"كأنكِ لم تكوني حلم عمري","https://www.poetsgate.com/ViewPoem.aspx?id=178593",""],[5956,"إني لأخضعُ لاحترامك باكيا","https://www.poetsgate.com/ViewPoem.aspx?id=182371",""],[5956,"توبة عاشقين","https://www.poetsgate.com/ViewPoem.aspx?id=182680",""],[5956,"رحلةٌ نفسية","https://www.poetsgate.com/ViewPoem.aspx?id=183278",""],[5956,"بباخرة الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=183747",""],[5956,"حياتي سراب","https://www.poetsgate.com/ViewPoem.aspx?id=183930",""],[5956,"إني لأخضعُ لاحترامك باكيا","https://www.poetsgate.com/ViewPoem.aspx?id=192034",""],[5956,"يمر عمري","https://www.poetsgate.com/ViewPoem.aspx?id=192655",""],[5957,"حكايات (المسنجر)","https://www.poetsgate.com/ViewPoem.aspx?id=46453",""],[161,"الغليان","https://www.poetsgate.com/ViewPoem.aspx?id=152728",""],[6093,"وكم يضر بحسن الغادة الغضب","https://www.poetsgate.com/ViewPoem.aspx?id=215072",""],[6102,"حَبو","https://www.poetsgate.com/ViewPoem.aspx?id=182762",""],[186,"نسيمات نجد هل تحملت من نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55747&r=&rc=10",""],[6243,"قهرية البوح المفاجئ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84427&r=&rc=1",""],[6314,"بكائية الليل الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88067&r=&rc=2",""],[5190,"ملل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85046&r=&rc=121",""],[6346,"لك الله ياغزة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83385&r=&rc=1",""]],"verses":[["مَلَلتُ مُقامي غَيرَ شَكوى خَصاصَةٍ","وَإِنّي لِأَمرٍ ما أَمَلُّ مُقامي",0,"م",2,0],["مَلِلتَ الثَواءَ بِدارِ الزَوالِ","فَماذا رَأَيتَ بِدارِ المَقَرّ",1,"ر",1,0],["مَلِلتُ وُقوفي بَينَكُم مُتَلَهِّفاً","عَلى راحِلٍ فارَقتُهُ فَشَجاني",2,"ن",2,0],["مَلِلنا طولَ صُحبَتِهُ وَمَلَّت","سَوابِقُنا مِنَ المَشيِ الوَئيدِ",3,"د",1,0],["مِلَلٌ تُحِيطُ بِهِ وَقَدْرُكِ وَاحِدٌ","فِي نَفْسِ نَصْرَانِيهَا وَالمُسْلِمِ",4,"م",1,0],["مَلِلتُ بِهِ الثَواءَ وَأَرَّقَتني","هُمومٌ لا تَنامُ وَلا تُنيمُ",5,"م",1,0],["مَلِلتُ بِها الثَواءَ وَأَرَّقَتني","هُمومٌ لا تَنامُ وَلا تُنيمُ",6,"م",1,0],["مَلِلنَ وَلَم أَملَل وَما كُنتُ سائِماً","لِأَجمالِ سُعدى ما أَنَخنَ بِجَعجَعِ",7,"ع",1,0],["مَلِلتُ مُقامَ يَومٍ لَيسَ فيهِ","طِعانٌ صادِقٌ وَدَمٌ صَبيبُ",8,"ب",1,0],["مَلِلْتُ ثَوائي بالعراقِ وملَّني","رفاقي وكانوا بالعراق طِرابَا",9,"ب",2,0],["مَلَلْتَ فعاد منك الجُودُ مَنْعَاً","ولو أنصفْتَ عادَ المنعُ جودا",10,"د",2,0],["مللتُ في هاته العوالم","مهزلةَ الموت والحياه",11,"ه",1,0],["مَلِلتَ فَما تَعدو المَلالَ سَجِيَّةً","تَعَوَّدتَها لا تَستَطيعُ لَها صَرفا",12,"ف",2,0],["مَلَلتُمْ ما يَمَضُّ الحُرَّ منهم","وما مَلّوا الدُّعابةَ والمُجونا",13,"ن",2,0],["مَلَلنا وَما مَلَّ العَدُوُّ المُغاضِبُ","وَلِنّا وَما لانَ الزَمانُ المُشاغِبُ",14,"ب",1,1],["مَلَلْنَ لدى الفلسِ عهدَ الظّلامِ","فأصبحن مِيراثَ ماحِي الظُّلَمْ",15,"م",1,0],["مَلِلتُ مَبيتي بِالقَرينِ وَشاقَني","طُروقُ الهَوى مِن نازِحٍ مُتَباعِدِ",16,"د",1,1],["مَلِلتُ قَلبي لا يُمَلُّ الهَوى","يا طولَ إِغرامي بِمَن لا يُجيب",17,"ب",1,0],["مَلِلتَ عِتابَ أَغيَدَ كُلَّ يَومٍ","وَشَرٌّ ما دَعاكَ إِلى العِتابِ",18,"ب",1,0],["مَلَلتُ عَيشي فَعوجي يا مَنِيَّةُ بي","وَذُقتُ فَنِيَّه مِن بُؤسٍ وَمِن رَغدِ",19,"د",1,1],["مِلَلٌ غَدَت فِرَقاً وَكُلُّ شَريعَةٍ","تُبدي لِمُضمَرِ غَيرِها إِكفارَها",20,"ر",3,0],["مَلِلتَ مَسيراً فَوقَ نِضوَيكَ فَاِلتَمِس","نُزولَكَ بِالصَحراءِ عَن جَمَلَيكا",21,"ك",2,0],["مَلِلتُ مِن حِندِسٍ وَصُبحٍ","وَلَم أُبِن فيهِما مَلالا",22,"ل",2,0],["مَلَلِي مِنْ مَلَلٍ والخَيْفُ حَيْ","فٌ تَقاضيه وأنّى ذاكَ وَيْ",23,"ي",1,0],["مللت في وحدة الدّيارِ","تعاقب اللَّيل وَالنَّهارِ",24,"ر",1,1],["مللتُ بها الثّواءَ وأرّقتني","همومٌ ما تنامُ ولا تنيمُ",25,"م",1,0],["مللت عمري وملا","سكراً عن الصحو ضلا",26,"ل",2,1],["مللت حياتى منه والأجرَ والورَى","وصحبى وكلَّ الخلقِ والطولَ والعرضَا",27,"ض",2,0],["مِلَلٌ وأطْيافٌ تَباطأ رَكْبُها","فَتَخاذَلَتْ وانْتابَها الإغْماءُ",28,"ا",2,0],["مَلِلتُ بِصَنعاءَ الأحاديثَ وَالمُنَى","وَأَبغَضتُ قَصراً فَوقَ قصرٍ مُشَيَّدَا",29,"د",2,1],["مللتمُ وادعيتم أنّ ذاك لكم","طبعا صدقتُم فمَلُّوا هجريَ الآنا",30,"ن",2,0],["مللن فؤادي فتّيمنه","وما زلتُ عن ذلكم مذعنا",31,"ن",2,1],["مللتُ الوصالَ بقبح الفعالِ","وما كنتُ أعهد قلبي ملولا",32,"ل",2,1],["مللتُ نعيماً لم أكن لأَملّهُ","فيا حبّذا لو هكذا عيشُنا عَبر",33,"ر",1,0],["مللت نفسي ملالا","فرحت ابغي خليلا",34,"ل",2,0],["مَلِلتُم فَمِلُتم نحوَ داعِيةِ القِلَى","وخُنتُم فَدنتُم بالّذي شَرَعَ الغَدرُ",35,"ر",1,0],["مَلِلْتُ عتابَهم ويئستُ منهُم","فما أرجوهُمُ فِمين رَجوتُ",36,"ت",1,0],["مَلِلْتُ وما مَلِلْتَ عن التجافي","فَلِمْ لا مِلتَ يوماً عن ملالك",37,"ك",1,0],["مَلَلْت الثوى حتَّى طربت إلى النَّوى","وحتَّى رأيت الأرض أضيق من شبر",38,"ر",1,0],["مللتَ وملتَ وأنت القضيب","فملْ كالقضيب وخلِّ الملل",39,"ل",1,0],["مللتُمْ هوًى ما أن مللتُ عذابَهُ","على أن ما في الغيدِ غيرُ ملولِ",40,"ل",1,0],["مللت إذا ذكرت نباهة قدره","أزرى بأهل الخافقين خمول",41,"ل",1,0],["مَلِلتُ الكَتابةَ دهراً طويلاً","عزَفتُ وما كنتُ أرتَادُها",42,"د",3,1],["مَلِلْتموني والمُنى رَغْدَةٌ","إِنْ كَثُرتْ في معشرٍ مُلَّتِ",43,"ت",1,0],["مَلِلتُ مِنَ العُذّالِ فيها فَأَطرَقَت","لَهُم أُذُنٌ قَد صَمَّ مِنها المَسامِعُ",44,"ع",1,0],["مَللِتُ نَوائبَ الأيَّامِ حتَّى","غَضَبِتُ بها عَلَى عيشٍ يطولُ",45,"ل",1,0],["مَلِلتُ منَ القريضِ وقُلتُ يكفي","لأمرٍ شابَ قوَّتَهُ بضُعفِ",46,"ف",1,1],["مَلَلنا وطالَ الانتظار فَجُدْ لنا","بحقِّكِ يا قطبَ الوجودِ بِزَوْرةِ",47,"ه",1,0],["مللت مكافحة الحادثات","وكنت بها معجباً عاجبا",48,"ب",2,1],["مَلَلّنَا وَملَّتْ طَوَاحيْننا","كَفَاهَا طِعَانَاً كَفَانَا طِعَانَا",49,"ن",2,0],["مللتم حياتي وهو عين سَفاهِكم","وبُؤتْم بإثم ليس فيه تَستر",50,"ر",1,0],["مللت عذب اللوم جهلاً به","لو كنت أدري الحب لم أملل",51,"ل",1,0],["مللت ثواء باليمامة لا أرى","من الناس إلا العبد يحدو السوانيا",52,"ي",2,0],["مَلِلْتُ حمصَ وَمَلَّتني فلو نَطَقَتْ","كما نطقتُ تَلاَحَيْنَا على قَدَر",53,"ر",1,0],["مَلِلتُ حَياتي بَينَ قَوم حَديثُهُم","يَدورُ عَلى الأَزياءُ وَالخَمر وَالقَمرِ",54,"ر",1,0],["مَلِلتُ بدارِ الحِسِّ طولَ ثَوائي","وسجني وتعذيبي بها وبَلائي",55,"ا",2,1],["مَلِلْتُ مُقامي في قميص طبيعةٍ","من الجسم عُنِّىَ فيه روحيَ ما عُنِّي",56,"ن",2,0],["مللت العقل والدنيا","فهات الكأس واسقينا",57,"ن",2,1],["مللنا جسمك الناري","مللنا صدرك الناهد",57,"د",1,0],["مللنا لحمك الوردي","ملننا حبنا الفاسد",57,"د",1,0],["مللنا العقل والدينا","فهات الكأس واسقينا",58,"ن",2,1],["مللنا لحمك الوردي","مللنا حبّك الفاسد",58,"د",1,0],["مللتُ جُلاّسي وصَحبي كما","قد ملَّني صحبي وجُلاّسي",59,"س",2,0],["مللتُ الزمانَ بما قد حباني","وما قد أعدَّ وما هيَّأَ",60,"ا",1,0],["مللت نظم قريضٍ قد نثرتُ به","عواطفاً نَدِيَت بالدمع منتظما",61,"م",2,0],["مَلِلنا وَمَلَّتنا الحَياةُ فَلو أَتَت","شعوبُ استَرحنا مِن مُقاساةِ أَعراضِ",62,"ض",1,0],["ملِلْتُ العيش حتّى كدتُ أَشكو","جِنايات المَلال إِلى الملال",63,"ل",1,0],["مللتُ من المنى جهداً وكدّا","فنمت على فراش اليأس رغدا",64,"د",2,1],["مللت سهدي وملّا","تقلب الأعضاء",65,"ا",2,0],["ملل التي يحسبها اهلها","عذراء بكراً وهي في التاسعِ",66,"ع",1,1],["مللتم وِدادي أَم نسيتم تودّدي","وَآنسكم غَيري وَعشت أورّخ",67,"خ",1,0],["مللت من الفراش ولست أدري","أأنهض نهضة النجد الهمام",68,"م",1,0],["مللت من البكا وأذاب جسمي","ملالا فيك ما ألف الملالا",69,"ل",2,0],["مللنا الحَياة وَقَد عفتها","لِكَوني وَحيدا ازاء الفتن",70,"ن",1,0],["ملِلتُ وَضاقَ ذرعي عَن أُموري","وَجُثماني غَدا مثل الخلالِ",71,"ل",1,0],["مللت دَهري وَملتني حَوادثه","فَبعدكم لَيسَ لي في العَيش منأَرب",72,"ب",1,0],["مللت العائدين وقد أمالوا","إلي رقاب اخوان الصفاء",73,"ا",2,0],["مللت حياتي والسلامة أصبحت","تمل لجسمي مثل ما ملتي صحبي",74,"ب",2,0],["مللتم ولكني على كل حالةٍ","صبورٌ حفيظ العهد لا أترك الوفا",75,"ف",2,1],["مللت الحياة وكثر السهر","ورمت الممات وسكنى الحفر",76,"ر",1,1],["مللتَ من الأحباب إذ ملتَ عنهم","كانك قالٍ كل خلٍّ وصاحب",77,"ب",1,0],["مللتك ِ شوقا أقام قليلا","فكيف إذن لو أقام طويلا",78,"ل",2,1],["مللت حياتي وأيامها","وأقتل ما في الحياة الملل",79,"ل",1,0],["مللت من القريض وضقت منه","لمََ العشرون ضاعت في الهراءْ",80,"ا",2,1],["ملَلْتُ فيكَ غيابي ، أقتفي ظمئي","وما ارتوى لي هيامٌ فيكَ أو وطرُ",81,"ر",1,0],["مَلَلْتُ مُجَالَدَةَ المٌستَحِيلِ","ومِنْ منطقِ العَيشِ فِي دَائِرَة",82,"ر",2,0],["ملَلْتُ مِنَ الصَّمْتِ عِنْدَ القُبُورِ","ومِنْ فِكْرَةِ القَدَرِ الجَائِرَةْ",82,"ر",2,0],["مللنا حياةَ البؤسِ والحزن والشقا","صبرنا فما أجدى التجلدُ والصبرُ",83,"ر",1,0],["مَلَلتْ العَيش في وَكر الظّلام ./ وبين رَدهات القلق واحزان","___________ / _ وانا شبّاك لا لمّ الحَمام تصحّي هذيّ الرّيح ./ رَفْرفته",84,"ت",2,0],["مَلَلْتُ الحَيَاةَ وَهَوْلَ القَدَرْ","وَرُوحِي رَصِيفٌ يَلُوكُ الضَّجَرْ",85,"ر",1,1],["مَلَلْتُ مِنَ الأَحْزَانِ حَتَّى كَأَنَّنِي","وُلِدْتُ وَقَلْبِي لَمْ يَكُنْ بَعْدُ كَامِلاَ",86,"ل",2,1],["مَلَلّتُ مِنْ أُمَّةٍ ألْقَتْ كَرَامَتَها","مِنْ بَعْدِ عِزٍ لها_في وَحْشَةِ الْبِيدِ_",87,"د",1,0],["مَللتُ صَبري وما تَراءتْ","مَلامِحُ البَوحِ في العِنادِ",88,"د",1,0],["مللت ُ التعاويذ َ والأبخِرا","وضِقت ُ اصطبارا بأن أصبِرا",89,"ر",2,1],["مللت ُ التعاويذَ والأبخرا","وقد ضقت ُ ذرعاً بما قد جرى",89,"ر",2,0],["مللت ُ التّعاويذ َ والأبخِرا","وباعدت ُعنّي لذيذَ الكَرى",89,"ر",2,0],["مللت ُ التّعاويذ َ والأبخرا","وقد ضِقْنَ بي والأماني سُرى",89,"ر",2,0],["مللتُكَ ... لا ترمي السّهامَ ولم تعُدْ","تُجَنِّبُ مَنْ يرمي الرّماة ُ العَوالِيا",90,"ي",2,0],["مللتُكَ ... لا يُؤذيكَ أنكَ مُهمَلٌ","وغيرُ كَ يصطادُ الغِنى والمغانيا",90,"ي",2,0],["مللتُكَ ... قد ثارَ الترابُ ومَنْ بهِ","وأنت تُلاقي الطبلَ أخرَسَ غافِيا",90,"ي",2,0],["مللتُكَ ... لا أنتَ الذي قد عَرَفْتُهُ","ولا أنا أنتَ الراكِبُ البحرَ عالِيا",90,"ي",2,0],["مللتُكَ ... مهزوما ً يُضَيِّعُ وقتَهُ","ولم يقتنِصْ ممّا تولّى ثوانِيا",90,"ي",2,0],["مللتُكَ سكرانا ً .. مللتُكَ صاحِيا","مللتُكَ يقظانا ً .. مللتُكَ غافِيا",90,"ي",2,0],["مللتُكَ متبوعا ً .. مللتُكَ شاعرا","ً مللتُكَ ساويتَ الذي لن يُساويا",90,"ي",2,0],["مللتُكَ والدنيا تريدُ كَ ضاحِكا","ً ونحنُ وهبناكَ المحبّة َ باكِيا",90,"ي",2,0],["مللتُكَ أمّا مُوجَعا ً أو مُواسِيا","وأمّا تُداوى أو تكونُ المُداويا",90,"ي",2,0],["مَلَلْتُكَ لا أنتَ الّذي قد عَرَفْتُهُ","ولا أنا ذاكَ الراكِبُ البحرَ عالِيا",91,"ي",2,0],["مَلَلْتُكَ سكراناً مَلَلْتُكَ صاحِيا","مَلَلْتُكَ سهراناً مَلَلْتُكَ غافِيا",91,"ي",2,0],["مللْت البعدَ حتى زادَ بعدي","وكلُّ البعدِ عن عيني قر