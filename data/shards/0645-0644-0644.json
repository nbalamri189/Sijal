{"poems":[[53,"حلفت بها صيد الرؤوس سوام","https://www.aldiwan.net/poem29752.html","الطويل"],[86,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[86,"دعاني رفاقي والقوافي مريضة","https://www.aldiwan.net/poem10483.html","الطويل"],[86,"بنات الشعر بالنفحات جودي","https://www.aldiwan.net/poem10690.html","الوافر"],[93,"لقيتك مصر بثغرها المتبسم","https://www.aldiwan.net/poem11335.html","الكامل"],[30,"أحادرة دموعك دار مي","https://www.aldiwan.net/poem29531.html","الوافر"],[38,"كأن بلادهن سماء ليل","https://www.aldiwan.net/poem7862.html","الرجز"],[32,"ألا ناد عيرا من بثينة ترتعي","https://www.aldiwan.net/poem27781.html","الطويل"],[43,"أيدري ما أرابك من يريب","https://www.aldiwan.net/poem9458.html","الوافر"],[62,"أهاب به داعي الهوى فأجابا","https://www.aldiwan.net/poem52502.html","الطويل"],[61,"صدودك علم النوم الصدودا","https://www.aldiwan.net/poem51720.html","الوافر"],[97,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[44,"تبدلت إلفا إذ تبدلت بي إلفا","https://www.aldiwan.net/poem30205.html","الطويل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"مللنا وما مل العدو المغاضب","https://www.aldiwan.net/poem43099.html","الطويل"],[105,"إلى طيئ يا ابن عم النبي","https://www.aldiwan.net/poem43588.html","المتقارب"],[50,"مللت مبيتي بالقرين وشاقني","https://www.aldiwan.net/poem63905.html","الطويل"],[50,"يا ليت لي قلبا بقلب يثيب","https://www.aldiwan.net/poem64808.html","الوافر"],[50,"غدا سلف فأصعد بالرباب","https://www.aldiwan.net/poem64835.html","الوافر"],[46,"مللت عيشي فعوجي يا منية بي","https://www.aldiwan.net/poem22462.html","البسيط"],[46,"ما للنعائم لا تمل نفارها","https://www.aldiwan.net/poem22633.html","الكامل"],[46,"إذا قال فيك الناس ما لا تحبه","https://www.aldiwan.net/poem23083.html","الطويل"],[46,"جسم الفتى مثل قام فعل","https://www.aldiwan.net/poem23169.html","مجزوء البسيط"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85337","البسيط"],[38,"كأنَّ بلادهنَّ سماءُ ليلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=21202",""],[122,"مللت عمري وملا","https://www.aldiwan.net/poem23806.html","مجزوء الكامل"],[126,"ثقيل لو أن الأرض تعقل صاحبى","https://www.aldiwan.net/poem50588.html","الطويل"],[176,"جرحك في كفك","https://www.aldiwan.net/poem50701.html","الوافر"],[179,"مللت بصنعاء الأحاديث والمنى","https://www.aldiwan.net/poem59054.html","الطويل"],[183,"لا أظلم البين حالي كالذي كانا","https://www.aldiwan.net/poem14679.html","البسيط"],[184,"مللن فؤادي فتيمنه","https://www.aldiwan.net/poem43211.html","المتقارب"],[202,"مللت الوصال بقبح الفعال","https://www.aldiwan.net/poem53157.html","المتقارب"],[268,"هو الحب فليشق المحبون بالذكر","https://www.aldiwan.net/poem35635.html","الطويل"],[340,"أيا ضباب حياتي","https://www.aldiwan.net/poem55343.html","المجتث"],[406,"أأحبابنا خطب التفرق شاغل","https://www.aldiwan.net/poem32278.html","الطويل"],[406,"وما أشكو تلون أهل ودي","https://www.aldiwan.net/poem32285.html","الوافر"],[413,"ملكت فؤاد صبك في جمالك","https://www.aldiwan.net/poem54024.html","الوافر"],[413,"يمينا برب النجم والنجم إذ يسري","https://www.aldiwan.net/poem54085.html","الطويل"],[462,"حميت الأسيل بجد الأسل","https://www.aldiwan.net/poem3630.html","عموديه"],[475,"أبثك ما بي أم كفاك نحولي","https://www.aldiwan.net/poem15347.html","الطويل"],[513,"إن حارت الأفكار كيف تقول","https://www.aldiwan.net/poem12199.html","الكامل"],[536,"مللت الكتابة دهرا طويلا","https://www.aldiwan.net/poem48204.html","عموديه"],[549,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[551,"أعاود ما قدمته من رجائها","https://www.aldiwan.net/poem68382.html","الطويل"],[560,"لعمرك ليس في الدنيا خليل","https://www.aldiwan.net/poem52737.html","الوافر"],[560,"مللت من القريض وقلت يكفي","https://www.aldiwan.net/poem52844.html","البسيط"]],"verses":[["مَلَلتُ مُقامي غَيرَ شَكوى خَصاصَةٍ","وَإِنّي لِأَمرٍ ما أَمَلُّ مُقامي",0,"ي",1,0],["مَلِلتَ الثَواءَ بِدارِ الزَوالِ","فَماذا رَأَيتَ بِدارِ المَقَرّ",1,"ر",1,0],["مَلِلتُ وُقوفي بَينَكُم مُتَلَهِّفاً","عَلى راحِلٍ فارَقتُهُ فَشَجاني",2,"ي",1,0],["مَلِلنا طولَ صُحبَتِهُ وَمَلَّت","سَوابِقُنا مِنَ المَشيِ الوَئيدِ",3,"د",1,0],["مِلَلٌ تُحِيطُ بِهِ وَقَدْرُكِ وَاحِدٌ","فِي نَفْسِ نَصْرَانِيهَا وَالمُسْلِمِ",4,"م",1,0],["مَلِلتُ بِهِ الثَواءَ وَأَرَّقَتني","هُمومٌ لا تَنامُ وَلا تُنيمُ",5,"م",1,0],["مَلِلتُ بِها الثَواءَ وَأَرَّقَتني","هُمومٌ لا تَنامُ وَلا تُنيمُ",6,"م",1,0],["مَلِلنَ وَلَم أَملَل وَما كُنتُ سائِماً","لِأَجمالِ سُعدى ما أَنَخنَ بِجَعجَعِ",7,"ع",1,0],["مَلِلتُ مُقامَ يَومٍ لَيسَ فيهِ","طِعانٌ صادِقٌ وَدَمٌ صَبيبُ",8,"ب",1,0],["مَلِلْتُ ثَوائي بالعراقِ وملَّني","رفاقي وكانوا بالعراق طِرابَا",9,"ب",2,0],["مَلَلْتَ فعاد منك الجُودُ مَنْعَاً","ولو أنصفْتَ عادَ المنعُ جودا",10,"د",2,0],["مللتُ في هاته العوالم","مهزلةَ الموت والحياه",11,"ه",1,0],["مَلِلتَ فَما تَعدو المَلالَ سَجِيَّةً","تَعَوَّدتَها لا تَستَطيعُ لَها صَرفا",12,"ف",2,0],["مَلَلتُمْ ما يَمَضُّ الحُرَّ منهم","وما مَلّوا الدُّعابةَ والمُجونا",13,"ن",2,0],["مَلَلنا وَما مَلَّ العَدُوُّ المُغاضِبُ","وَلِنّا وَما لانَ الزَمانُ المُشاغِبُ",14,"ب",1,1],["مَلَلْنَ لدى الفلسِ عهدَ الظّلامِ","فأصبحن مِيراثَ ماحِي الظُّلَمْ",15,"م",1,0],["مَلِلتُ مَبيتي بِالقَرينِ وَشاقَني","طُروقُ الهَوى مِن نازِحٍ مُتَباعِدِ",16,"د",1,1],["مَلِلتُ قَلبي لا يُمَلُّ الهَوى","يا طولَ إِغرامي بِمَن لا يُجيب",17,"ب",1,0],["مَلِلتَ عِتابَ أَغيَدَ كُلَّ يَومٍ","وَشَرٌّ ما دَعاكَ إِلى العِتابِ",18,"ب",1,0],["مَلَلتُ عَيشي فَعوجي يا مَنِيَّةُ بي","وَذُقتُ فَنِيَّه مِن بُؤسٍ وَمِن رَغدِ",19,"د",1,1],["مِلَلٌ غَدَت فِرَقاً وَكُلُّ شَريعَةٍ","تُبدي لِمُضمَرِ غَيرِها إِكفارَها",20,"ر",3,0],["مَلِلتَ مَسيراً فَوقَ نِضوَيكَ فَاِلتَمِس","نُزولَكَ بِالصَحراءِ عَن جَمَلَيكا",21,"ك",2,0],["مَلِلتُ مِن حِندِسٍ وَصُبحٍ","وَلَم أُبِن فيهِما مَلالا",22,"ل",2,0],["مَلَلِي مِنْ مَلَلٍ والخَيْفُ حَيْ","فٌ تَقاضيه وأنّى ذاكَ وَيْ",23,"ي",1,0],["مللت في وحدة الدّيارِ","تعاقب اللَّيل وَالنَّهارِ",24,"ر",1,1],["مللتُ بها الثّواءَ وأرّقتني","همومٌ ما تنامُ ولا تنيمُ",25,"م",1,0],["مللت عمري وملا","سكراً عن الصحو ضلا",26,"ل",2,1],["مللت حياتى منه والأجرَ والورَى","وصحبى وكلَّ الخلقِ والطولَ والعرضَا",27,"ض",2,0],["مِلَلٌ وأطْيافٌ تَباطأ رَكْبُها","فَتَخاذَلَتْ وانْتابَها الإغْماءُ",28,"ا",2,0],["مَلِلتُ بِصَنعاءَ الأحاديثَ وَالمُنَى","وَأَبغَضتُ قَصراً فَوقَ قصرٍ مُشَيَّدَا",29,"د",2,1],["مللتمُ وادعيتم أنّ ذاك لكم","طبعا صدقتُم فمَلُّوا هجريَ الآنا",30,"ن",2,0],["مللن فؤادي فتّيمنه","وما زلتُ عن ذلكم مذعنا",31,"ن",2,1],["مللتُ الوصالَ بقبح الفعالِ","وما كنتُ أعهد قلبي ملولا",32,"ل",2,1],["مللتُ نعيماً لم أكن لأَملّهُ","فيا حبّذا لو هكذا عيشُنا عَبر",33,"ر",1,0],["مللت نفسي ملالا","فرحت ابغي خليلا",34,"ل",2,0],["مَلِلتُم فَمِلُتم نحوَ داعِيةِ القِلَى","وخُنتُم فَدنتُم بالّذي شَرَعَ الغَدرُ",35,"ر",1,0],["مَلِلْتُ عتابَهم ويئستُ منهُم","فما أرجوهُمُ فِمين رَجوتُ",36,"ت",1,0],["مَلِلْتُ وما مَلِلْتَ عن التجافي","فَلِمْ لا مِلتَ يوماً عن ملالك",37,"ك",1,0],["مَلَلْت الثوى حتَّى طربت إلى النَّوى","وحتَّى رأيت الأرض أضيق من شبر",38,"ر",1,0],["مللتَ وملتَ وأنت القضيب","فملْ كالقضيب وخلِّ الملل",39,"ل",1,0],["مللتُمْ هوًى ما أن مللتُ عذابَهُ","على أن ما في الغيدِ غيرُ ملولِ",40,"ل",1,0],["مللت إذا ذكرت نباهة قدره","أزرى بأهل الخافقين خمول",41,"ل",1,0],["مَلِلتُ الكَتابةَ دهراً طويلاً","عزَفتُ وما كنتُ أرتَادُها",42,"د",3,1],["مَلِلْتموني والمُنى رَغْدَةٌ","إِنْ كَثُرتْ في معشرٍ مُلَّتِ",43,"ت",1,0],["مَلِلتُ مِنَ العُذّالِ فيها فَأَطرَقَت","لَهُم أُذُنٌ قَد صَمَّ مِنها المَسامِعُ",44,"ع",1,0],["مَللِتُ نَوائبَ الأيَّامِ حتَّى","غَضَبِتُ بها عَلَى عيشٍ يطولُ",45,"ل",1,0],["مَلِلتُ منَ القريضِ وقُلتُ يكفي","لأمرٍ شابَ قوَّتَهُ بضُعفِ",46,"ف",1,1]]}