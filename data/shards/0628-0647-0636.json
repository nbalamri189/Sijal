{"poems":[[85,"طعامك من دار النعيم بعثته","https://www.aldiwan.net/poem54300.html","الطويل"],[47,"لقد نصر الإمام على الأعادي","https://www.aldiwan.net/poem62755.html","الوافر"],[30,"تحن بزوراء المدينة ناقتي","https://www.aldiwan.net/poem5618.html","الطويل"],[302,"سل البان عنهم أين بانوا ويمموا","https://www.aldiwan.net/poem33179.html","الطويل"],[466,"خليلي من عليا تميم بن خندف","https://www.aldiwan.net/poem15305.html","الطويل"],[1204,"","https://poetry.dctabudhabi.ae/diwan/poem/123659","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118444","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87370","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[3271,"راهب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=104128",""],[5397,"جلى صباح الهدى للخطب جنح دجى","https://www.poetsgate.com/ViewPoem.aspx?id=157955",""]],"verses":[["بهضبة نعمى قد سمونا لأوجها","فصِدْنا بأعلاها الشّهيَّ من الطَّيرِ",0,"ر",1,0],["بِهَضمٍ لِلخِلافَةِ وَاِنتِقاصٍ","وَظُلمٍ لِلرَعِيَّةِ وَاِضطِهادِ",1,"د",1,0],["بِهِ ضَرَبَ اللَهُ الَّذينَ تَحَزَّبوا","بِبَدرٍ عَلى أَعناقِهِم وَالمَعاصِمِ",2,"م",1,0],["به ضاءَ نورُ الحقِّ واتَّضحَت لنا","مَعالِمُ دين اللَه والأَمرُ مُبهَمُ",3,"م",1,0],["بهضبة حزنٍ أو بوعساء حُرَةٍ","سحيقة مجرى الريح ذاتِ نقانق",4,"ق",1,0],["بهِ ضِدانِ مُقتتِلانِ وَهْناً","وَيَصطحِبانِ في نِطْعٍ يمُدُّه",5,"د",2,0],["به ضربة من ابن مريام ان ذا","هو الحق والبهتان بالحق يبطل",6,"ل",1,0],["بِهِ ضِرامُ هوى لو هَلَّ مدمعهُ","فيهِ لجفَّ وَبَعضٌ منهُ لَم يَحُلِ",7,"ل",1,0],["بهضاب سيموسٍ يهد وفي","قلل المعاقل وأري الشرر",8,"ر",1,0],["به ضبّةٌ عذراءُ من طبّها ارتوت","وضاعت على نسكِ الغرامِ المباخرُ",9,"ر",1,0],["به ضحى الحرب قد شقت بوارقها","وليلها فيه بالنقع المثار سجا",10,"ج",2,0]]}