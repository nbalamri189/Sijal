{"poems":[[95,"تحت قدس الأقداس نم بسلام","https://www.aldiwan.net/poem11383.html","الخفيف"],[53,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[60,"أبا طالب عصمة المستجير","https://www.aldiwan.net/poem30874.html","المتقارب"],[69,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[48,"ما مقامي إلا إقامة عان","https://www.aldiwan.net/poem22730.html","الخفيف"],[128,"لا در درك جعفر يا جعفر","https://www.aldiwan.net/poem23739.html","الكامل"],[132,"يا أيها الملك المرجى فضله","https://www.aldiwan.net/poem50601.html","الكامل"],[310,"أهي الجبال رست بها الغبراء","https://www.aldiwan.net/poem56618.html","الكامل"],[354,"العز في ذلي لمن هو مؤمن","https://www.aldiwan.net/poem15547.html","الكامل"],[354,"لو رأى العذال يا حار","https://www.aldiwan.net/poem15717.html","المديد"],[409,"أشموس من المعاني مضيه","https://www.aldiwan.net/poem33350.html","الخفيف"],[445,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[463,"خدع الزمان مودة من ثائر","https://www.aldiwan.net/poem56205.html","الكامل"],[520,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[556,"رقدت وأسهرت ليلا طويلا","https://www.aldiwan.net/poem47320.html","المتقارب"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138253",""],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34397","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48868","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48632","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48858","الخفيف"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129557","الخفيف"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107200","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96631","الوافر"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202106","الكامل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202076","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137861",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80019","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78009","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77847","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114763","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53062","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2309,"","https://poetry.dctabudhabi.ae/diwan/poem/140203",""],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100924","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133943","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92052","الوافر"],[4601,"","https://poetry.dctabudhabi.ae/diwan/poem/147766","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35093","الكامل"],[5150,"معنى التحيه ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203146",""],[5200,"جعلت فداءك من صاحب","https://www.poetsgate.com/ViewPoem.aspx?id=200818",""],[5302,"بين خوف وهموم","https://www.poetsgate.com/ViewPoem.aspx?id=201379",""],[592,"أشاقك من سعدي بتلك المنازل","https://www.poetsgate.com/ViewPoem.aspx?id=128861",""],[5425,"شَفَتِي الغَلِيْلُ وَثَغْرُكِ المُتَبَرَّضُ","https://www.poetsgate.com/ViewPoem.aspx?id=207511",""],[5574,"يا جيشنا","https://www.poetsgate.com/ViewPoem.aspx?id=206037",""],[5691,"ياقوتة...!","https://www.poetsgate.com/ViewPoem.aspx?id=207971",""],[6075,"لَطِيفَةُ اللَّفَتَاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=201405",""],[6225,"العيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81028&r=&rc=265",""],[6237,"آذان الفجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77887&r=&rc=29",""],[6277,"نَوَرٌ نسميهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64476&r=&rc=39",""],[6318,"مهرجان القصيد (1)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66156&r=&rc=6",""]],"verses":[["وَلِقَاءٌ بَيْنَ الشَّهَادَةِ وَالغَيْ","بِ قَرِيبٌ عَلَى المَدَى المُتَرَامِي",0,"م",2,0],["ولقائي إياك ماءُ الحياتيْ","نِ فلا تَقْطَعَنَّ عني اللقاءَ",1,"ا",2,0],["ولقاءُ الوزير في الحاجة الأخ","رى فلا تنتظر استعجالي",2,"ل",2,0],["وَلَقَّاكَ رَبُّكَ رِضوانَهُ","فَقَد كُنتَ لِلمُصطَفى خَيرَ عَمّ",3,"م",1,0],["وَلِقَابِ قَوْسَيْنِ انْتَهَى فمَحَلُّهُ","مِنْ قابِ قَوْسَيْنِ المَحَلُّ الأقْرَبُ",4,"ب",1,0],["وَلِقابوسَ كانَ قَبسٌ وَفَنّا","خَسرُ أَروَتهُ مِن فَناءٍ وَخُسرِ",5,"ر",1,0],["ولقائل لك بالعراق وملكه","واق يعيذك ما تخاف وتجذر",6,"ر",1,0],["ولقاؤك الحسنُ الجميلُ معظماً","يُنْسى الورَى أهليهمُ والجارَا",7,"ر",2,0],["وَلَقامَ سندادٌ يسدّد أَمرها","وَالحضر يَشهد فيه والزهراءُ",8,"ا",2,0],["وَلِقاكَ أَقصى مُنيَتي يا مُنتَهى","أَمَلي وَقَد شَرِطَت لَدَيهِ مَنِيَّتي",9,"ت",2,0],["وَلَقامَت لي عَلى وَلَهي","عِندَهُم في الحُبِّ أَعذارُ",10,"ر",1,0],["ولقالت حاشا الإِله فما ه","ذا نظام بل ذا شموس مضية",11,"ي",2,0],["ولِقَاتِلٍ بِالهَجْرِ غَيْرِ مُقَاتِلٍ","يَفْدِيهِ مِنْ مَضَضِ العِتَابِ قَتِيلُهُ",12,"ل",2,0],["ولقاؤه شهواتِهِ ببصيرةٍ","معصومةٍ عنها وذيلٍ طاهرِ",13,"ر",1,0],["ولقابلتها من أسرة وجهه","شمس تكلف وجهها أن يخجلا",14,"ل",2,0],["ولقّاهُمُ بالنّعيم الكثير","وإنْ لم يُنيلوكِ إلّا قليلا",15,"ل",2,0],["ولقاء ما أسدت يداه قربه","أولاه أوفر نعمة من عنده",16,"د",2,0],["وَلقابِ قَوسَينِ اِعتَلى لَمّا دَنا","أَو كانَ أَدنى وَالمهَيمنُ أَعلَمُ",17,"م",1,0],["ولقاء الأعداء أيسر منه","في فراق الصحب الأسى والهموم",18,"م",1,0],["ولقاء من يطغي بما","لا بد للحذر المراقبْ",19,"ب",1,0],["ولقاءُ العدو بالبأس أولى","من مجاراته خِداعاً وختلا",20,"ل",2,0],["ولقائي بحاجتي النار خيرٌ","من لقائي بها الزنيمَ العُتُلّا",20,"ل",2,0],["ولقاء الأخوان عذب ولكن","كدرته مؤونة الاحتشام",21,"م",1,0],["وَلِقاءِ الأَصحابِ مِن كلِّ فَتىً","حَسَنِ الأَخلاقِ بالفَضلِ مُعَنّى",22,"ن",2,0],["وَلقّاه أَباه بعد ما إن","رُمي واِبتيع بالثمن الزهيدِ",23,"د",1,0],["ولقال أنت من أهل بيتي مُعْلِنًا","قولا يُكَشّفُ عن وُضَوحِ بَيانِه",24,"ن",2,0],["وَلقاءُ كلِّ شَديدة مُستَسهلٌ","والسَّعْدُ لي بِإمامنَا تَلقَاء",25,"ا",2,0],["ولق او اجعل لايقاً او اجمع","واختر بالاستقراءِ قولَ الاصمعي",26,"ي",1,0],["ولقاء ذي ظلم بصورة ظلمه","عين العدالة عند ذي العرفان",27,"ن",1,0],["ولقارعت عنك الردى وشعارها","أنا من أمرَّ اليوم طعمَ مذاقي",28,"ق",2,0],["ولقام وهو المستبد بنفسه","الشهم والواني لديه سواء",29,"ا",2,0],["وَلقابليه وَحامليه وَواصليه","وَجاعليه عَلى سنا الأَبصار",30,"ر",1,0],["ولِقاؤُنا إلا يكن في وَجهِ ال","مَعشُوقِ غُرّةً انَّهُ تحجيلُ",31,"ل",1,0],["ولقاصديه وللوفود ببابه","حج ومن معروفه عرفاته",32,"ت",2,0],["ولقاؤه إذ ذاك رؤيته حكى ال","إجماع فيه جماعة ببيان",33,"ن",1,0],["ولقال ما يرأى ولو","أن الحصار مضايق",34,"ق",1,0],["ولقامَ خيرُ بنيكَ عنك محامياً","لو أن ذلك كان فى الإِمكان",35,"ن",1,0],["ولقاء المصطفى خير البرايا","وحبيب الله من جاز السماكا",36,"ك",2,0],["وَلقّاه الرضى وحباه عفواً","بغيث من مراحمه سجيم",37,"م",1,0],["ولقاءً ووداعاً يتركُ القلبَ وحيدا","يَسْهَرُ المِصباحُ والأقداحُ والذكرى معي",38,"ي",1,0],["وَلِقاءُ جيرَتِنا غَداتَئِذٍ","مُتَيَسِّرٌ وَمَرامُهُم قَصدُ",39,"د",1,0],["ولقاءُ الموتِ لا يُرعبُنا","نلتقي الموتَ بروحٍ مقدسيّهْ",40,"ي",2,0],["ولقّاك ربى ما ترتجى","ووقتك ما تختشي نفسيه",41,"ي",2,0],["ولقاء في فرحة ووصال","بحبيب وسهرة واضطجاع",42,"ع",1,0],["ولقاكما بالنصر والفوز والهنا","على كل من ناوى الإمام بباطل",43,"ل",1,0],["وَلِقَاءُ شَوقٍ عَارِمٍ فِيْ غُربةٍ","يَرويْ مَضَامِيْمَ الحَشَا وَيُهَيِّضُ",44,"ض",1,0],["٥- ولِقادةٍ شُمٍّ عِظامٍ جادَ في","إخْلاصِهِ ولِحبْلِهِمْ مدَّ اليَدَا",45,"د",2,0],["ولَقالَتْ لهُ : تَعالَ نُهاجِرْ","شارَفَ الرَّبْعُ أنْ يَرى الإمْحالا",46,"ل",2,0],["وَلِقَاكِ مِنْ بَعْدِ النَّوَى","أَحْيَا غَرَامًا مُحْتَجَبْ",47,"ب",1,0],["ولقاءً بينَ خَصمين على وُدٍّ وأمن ِ","هكذا يستنفِرُ العيدُ لدَينا كُلَّ حُسن ِ",48,"ن",1,0],["ولقاء بين الملائك والإيمان","والمؤمنين من غير آذنْ",49,"ن",1,0],["ولقائل لك بالعراق ، وملكه","واق يعيذك ما تخاف وتحذر",50,"ر",1,0],["وَلقَاءٌ يَمُوْجُ بالنُّورِ يَجْلو","مَكرُمَات ِ البَيَانِ دَفْقَ الجُودِ",51,"د",1,0]]}