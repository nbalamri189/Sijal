{"poems":[[93,"تحت قدس الأقداس نم بسلام","https://www.aldiwan.net/poem11383.html","الخفيف"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[58,"أبا طالب عصمة المستجير","https://www.aldiwan.net/poem30874.html","المتقارب"],[67,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[46,"ما مقامي إلا إقامة عان","https://www.aldiwan.net/poem22730.html","الخفيف"],[125,"لا در درك جعفر يا جعفر","https://www.aldiwan.net/poem23739.html","الكامل"],[129,"يا أيها الملك المرجى فضله","https://www.aldiwan.net/poem50601.html","الكامل"],[306,"أهي الجبال رست بها الغبراء","https://www.aldiwan.net/poem56618.html","الكامل"],[350,"العز في ذلي لمن هو مؤمن","https://www.aldiwan.net/poem15547.html","الكامل"],[350,"لو رأى العذال يا حار","https://www.aldiwan.net/poem15717.html","المديد"],[404,"أشموس من المعاني مضيه","https://www.aldiwan.net/poem33350.html","الخفيف"],[440,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[459,"خدع الزمان مودة من ثائر","https://www.aldiwan.net/poem56205.html","الكامل"],[516,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[552,"رقدت وأسهرت ليلا طويلا","https://www.aldiwan.net/poem47320.html","المتقارب"]],"verses":[["وَلِقَاءٌ بَيْنَ الشَّهَادَةِ وَالغَيْ","بِ قَرِيبٌ عَلَى المَدَى المُتَرَامِي",0,"م",2,0],["ولقائي إياك ماءُ الحياتيْ","نِ فلا تَقْطَعَنَّ عني اللقاءَ",1,"ا",2,0],["ولقاءُ الوزير في الحاجة الأخ","رى فلا تنتظر استعجالي",2,"ل",2,0],["وَلَقَّاكَ رَبُّكَ رِضوانَهُ","فَقَد كُنتَ لِلمُصطَفى خَيرَ عَمّ",3,"م",1,0],["وَلِقَابِ قَوْسَيْنِ انْتَهَى فمَحَلُّهُ","مِنْ قابِ قَوْسَيْنِ المَحَلُّ الأقْرَبُ",4,"ب",1,0],["وَلِقابوسَ كانَ قَبسٌ وَفَنّا","خَسرُ أَروَتهُ مِن فَناءٍ وَخُسرِ",5,"ر",1,0],["ولقائل لك بالعراق وملكه","واق يعيذك ما تخاف وتجذر",6,"ر",1,0],["ولقاؤك الحسنُ الجميلُ معظماً","يُنْسى الورَى أهليهمُ والجارَا",7,"ر",2,0],["وَلَقامَ سندادٌ يسدّد أَمرها","وَالحضر يَشهد فيه والزهراءُ",8,"ا",2,0],["وَلِقاكَ أَقصى مُنيَتي يا مُنتَهى","أَمَلي وَقَد شَرِطَت لَدَيهِ مَنِيَّتي",9,"ت",2,0],["وَلَقامَت لي عَلى وَلَهي","عِندَهُم في الحُبِّ أَعذارُ",10,"ر",1,0],["ولقالت حاشا الإِله فما ه","ذا نظام بل ذا شموس مضية",11,"ي",2,0],["ولِقَاتِلٍ بِالهَجْرِ غَيْرِ مُقَاتِلٍ","يَفْدِيهِ مِنْ مَضَضِ العِتَابِ قَتِيلُهُ",12,"ل",2,0],["ولقاؤه شهواتِهِ ببصيرةٍ","معصومةٍ عنها وذيلٍ طاهرِ",13,"ر",1,0],["ولقابلتها من أسرة وجهه","شمس تكلف وجهها أن يخجلا",14,"ل",2,0],["ولقّاهُمُ بالنّعيم الكثير","وإنْ لم يُنيلوكِ إلّا قليلا",15,"ل",2,0]]}