{"poems":[[32,"نبت عيناك عن طلل بحزوى","https://www.aldiwan.net/poem29591.html","الوافر"],[54,"ألا أيها الربع الذي عطل الدهر","https://www.aldiwan.net/poem27012.html","الطويل"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62206","الطويل"],[119,"لقد ظن العذول نسيت حاشا","https://www.aldiwan.net/poem40924.html","عموديه"],[139,"تأمل رعاك الله حسن المواكب","https://www.aldiwan.net/poem49034.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[214,"تراءت لك الأيام باسمة الثغر","https://www.aldiwan.net/poem13519.html","الطويل"],[443,"منازلهم بين اللوى فالدكادك","https://www.aldiwan.net/poem2528.html","الطويل"],[543,"بكم شعري على غيري فخور","https://www.aldiwan.net/poem48179.html","عموديه"],[543,"كما قلتم والله ليس له ند","https://www.aldiwan.net/poem48241.html","عموديه"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126766","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110359","الوافر"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67830","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67831","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67829","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56095","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55943","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56212","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56208","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56337","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136177","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136343","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21669","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128722","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79915","المتقارب"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79858","المتقارب"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203659","الطويل"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74993","الوافر"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104726","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109375","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109405","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105011","الطويل"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100107","الطويل"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110659","الطويل"],[2562,"","https://poetry.dctabudhabi.ae/diwan/poem/123451","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137009",""],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116514","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100426","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74332","الهزج"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74300","الهزج"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74201","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134024","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132605","المتقارب"],[3150,"","https://poetry.dctabudhabi.ae/diwan/poem/82368","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89380","الوافر"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123915","الوافر"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138453",""],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129405","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110051","الطويل"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66596","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114245","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69916","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90810","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94516","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94557","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72441","المتقارب"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72410","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139630",""],[4702,"مارد وشيطانيه","https://www.poetsgate.com/ViewPoem.aspx?id=155200",""],[4935,"إلهي فرج الكربا","https://www.poetsgate.com/ViewPoem.aspx?id=129287",""],[3647,"وما اسمٌ اصلهُ نَبتٌ","https://www.poetsgate.com/ViewPoem.aspx?id=125688",""],[4119,"واحربا في الثغور من بلد","https://www.poetsgate.com/ViewPoem.aspx?id=16144",""],[5277,"رشأ الحشا","https://www.poetsgate.com/ViewPoem.aspx?id=191710",""],[5397,"بمد العمر قد ذهب الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=157906",""],[5431,"دمشق الروح...","https://www.poetsgate.com/ViewPoem.aspx?id=197674",""],[5459,"بعثة الرحمة المهداة","https://www.poetsgate.com/ViewPoem.aspx?id=190905",""],[5528,"حياضُ النّور","https://www.poetsgate.com/ViewPoem.aspx?id=207553",""],[5762,"على عهد العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=12688",""],[192,"نبض الشوارع","https://www.poetsgate.com/ViewPoem.aspx?id=16352",""],[6031,"هِيَ الدارُ تَستسقيكَ مَدْمَعَكَ الجاري","https://www.poetsgate.com/ViewPoem.aspx?id=46266",""],[6147,"حنين إلى الفار المخلوع","https://www.poetsgate.com/ViewPoem.aspx?id=151693",""],[6247,"الحياة التفات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80275&r=&rc=14",""]],"verses":[["بِهِ قِطَعُ الأَعِنَّةِ وَالأَثافي","وَأَشعَثُ خاذِلٌ فَقَدَ الإِصارا",0,"ر",2,0],["بِهِ قَرَّتِ الدُنيا وَفاضَ خَراجُها","عَلى المَلكِ فَاِستَغنى وَأَمكَنَهُ القَهرُ",1,"ر",1,0],["به قَما اللَّهُ ذوي الإشراكِ","وأنقذَ الثَّغرَ من الهلاكِ",2,"ك",1,0],["بِهِ قَرَعٌ أَبْدَى الحَصَى عَنْ مُتُونِهِ","سَفَاسِقَ أَعْرَاهَا اللِّحَاءُ المُشَبَّحُ",3,"ح",1,0],["به قد عشت ميتا في هواه","وتعجب دعد كيف الميت عاشا",4,"ش",2,0],["به قد غدا رأس الخليج متوجاً","بتاج عُلىً والله جمّ المواهبِ",5,"ب",1,0],["بهِ قامَ كلُّ الخلقِ لو كان لحظةً","تَخلّى عنِ الأكوانِ لاِنعدمت فورا",6,"ر",2,0],["به قسما ما ان له من مضارع","وتلقاه في افعاله ماضي الامر",7,"ر",1,0],["به قام هذا الملك حتى توطدت","دعائمه من دون كل الممالك",8,"ك",1,0],["به قَرَّت عيونُ الناسِ طُراًّ","وأقوى الناسِ مولانا الأميرُ",9,"ر",1,0],["به قَرَّطَرفُ المجدِ والجُودِ في الدُّنَى","فهزَّ به أعطافَه الجودُ والمجدُ",10,"د",1,0],["بهِ قَد سَمَت عليا قريش وأدركَت","مُناها ونالت مُنتهى المجد والفخرِ",11,"ر",1,0],["به قد تجلى حسن كل مليحة","ألاحظها بالحسن في كل لحظة",12,"ه",1,0],["بهِ قد أنصَفَ المولى عبيداً","فأعطى ذا المقامَ لذا الإِمامِ",13,"م",1,0],["بِهِ قَدْ كُفِيْنَا فِتْنَةَ الْغَيِّ وَالْهَوى","إلَيْهِ اشْتِيَاقي لاَ إلى الجِذْعِ وَاللَّوى",14,"ل",3,0],["بِهِ قَدْ أَقَرَّتْ أَلْسُنُ الْخَلْقِ بِالْمِلْكِ","عَلَيْهِ اعْتِمَادِي وَهْوَ سُؤْلي وَمقْصِدِي",15,"ي",1,0],["بِهِ قَدْ بَلَغْنَا سُؤْلَنَا مِنْ ثَوَابِهِ","وَفُزْنَا بإدْرَاكِ الْعُلاَ مِنْ جَنَابِهِ",15,"ه",1,0],["بِهِ قَدْ نَجَا نُوحٌ وَسَارَ عَلىَ الْفُلْكِ","لَقَدْ زَانَهُ الْمَوْلَى وَكَمَّلَ وَصْلَهُ",15,"ه",1,0],["بِهِ قَدْ نُقِلْنَا مِنْ ضلاَلٍ إِلَى هُدى","وَفُزْنَا بِعِزِّ وَانْتَصَرْنَا عَلى الْعِدَا",16,"د",2,0],["به قد تغسل الادران طرًّا","عن الأبدان والملبوس اجمعْ",17,"ع",1,0],["به قام فادينا ومحيي نفوسنا","باهراقه حباً بنا طاهر الدمِ",18,"م",1,0],["به قطرنا قد فاق بالقدر وارتقى","على كل قطرٍ في الوجود وعالمِ",19,"م",1,0],["به قمر العلا منه تجلّت","لنا الشهب الزواهي الساطعاتُ",20,"ت",1,0],["به قرّت الأبصار واسترحب الورى","ووجه الأماني في لقاه تهللا",21,"ل",2,0],["به قد هدى المولى من الخلق امة","قد ارتكبت في الجهل خطة ابعاد",22,"د",1,0],["به قد توسلنا إليك وحسبنا ال","وسيلة طه سيد الانس والجن",23,"ن",1,0],["به قطعوا أصل العلائق والهوى","به أخلصوا في طاعة الحق لا سوى",24,"س",3,0],["بِهِ قَد شَهِدناهُ وَفُزنا بِذِكرِهِ","وَجِئنا بِأَسلابٍ لَهُ وَغَنائِمِ",25,"م",1,0],["به قد شد أزر الدين حقا","فشيّد ركنه وأزال وهنه",26,"ن",2,0],["به قد طرحت كبارَ الهُمومِ","ومنهُنَّ همَّتهُ أكبر",27,"ر",1,0],["به قد غفرنا ذنوبَ الزمانِ","وقلنا عفا الله عمَّا سلف",28,"ف",1,0],["به قد غدا ثغر \"الهدى\" وهو باسم","منير سناه مشرق الأفق سعدُه",29,"د",2,0],["به قطع الوتين اللَه حقا","من الكفار ذو البطش المتين",30,"ن",1,0],["بهِ قامَ فِى المِحرَابِ لِلهِ قانِتاً","يُناجى لِرَبِّ العَرشِ وَالنَّاسُ نُوَّمُ",31,"م",1,0],["بهِ قريضي حكى معنى الرحيق وقد","غدا بمسك الثنا والشرك مختتما",32,"م",2,0],["به قلدوا العلياء عقدا وشيدوا","بحسن المزايا للشهامة مسكنا",33,"ن",2,0],["به قد غدت أفلاكها التسع عشرة","واصبحت السبع المثاني ثمانيا",34,"ي",2,0],["به قمع اللَه الضلال وأهله","وللشمس نور فاجع للغياهب",35,"ب",1,0],["به قد زها دست الخلافة مشرقا","بأحكام خير الرسل من مضر الحمرا",36,"ر",2,0],["به قد علا الإسلام يزهو مناره","ألا إن خيري للفضائل موردُ",37,"د",1,0],["به قد افتر ثغر الشوف مبتسماً","تبسم الروض يزهى في اقاحيه",38,"ي",2,0],["به قد أسا فافهم فلاتك جاحدا","ومع ذا نهى ان يضرر بالصحر",39,"ر",1,0],["به قام ناموس الممالك معلناً","لملك ملوك الدهر حيهلا هيا",40,"ي",2,0],["بِهِ قَد رَفع الشرع","وطابَ الأَصل وَالفرع",41,"ع",1,0],["بِهِ قَلبي غَدا مَشغول","وَدَمعي قَد غَدا مسبول",42,"ل",1,0],["بِهِ قَد ثَوى ماء الحَياة وَما دَرى","باسكندر الماضي وَلا عرف الخَضرا",43,"ر",2,0],["به قلدت يمناه صدر معارف","فكان له من ذلك اليمن والبشر",44,"ر",1,0],["به قد جرى فلك دائر","تلوح دراريه ملء البصر",45,"ر",1,0],["بِهِ قَتَلَ اللَّهُ الَّذينَ تَحَزَّبوا","عَلَينا وَكانوا أَهلَ إِفكٍ وَباطِلِ",46,"ل",1,0],["به قمع الضلال وكان قدماً","يصول بأهله في كل آن",47,"ن",1,0],["به قبل المنى ذاقوا المنايا","وقبل النار صاعقة السماء",48,"ا",2,0],["به قامت الأشياء في البدو والبقاذ","وكل على الإمداد جارٍ ودائر",49,"ر",1,0],["به قمر من هاشم حان خسفه","ولا بد للبدر المنير من الخسف",50,"ف",1,0],["بهِ قَبِلَ الايمانَ أَوَّلُ مُؤمِنٍ","من العابدي الأَوثانِ فَهوَ لهُ الفضلُ",51,"ل",1,0],["به قصدنا للخروج القنفده","وقد زِبلنا تعباً وقلفدَه",52,"ه",1,0],["بَهَقٌ يَلُوحُ سَوادُهُ فِي صُفَْرٍة","قَد كَرَّهَتْ نَظَرِي إِلَى اللُّفَّاحِ",53,"ح",1,0],["بِهِ قَامَت قِيَامَةٌ","لِذَوِي نَحسٍ استَمَر",54,"ر",1,0],["به قدماه تقلقلتا","فما بهما بعد ذا ثبتا",55,"ت",2,0],["بِهِ قَد قُلت تاريخاً فَريداً","نَقولا زادَ بَيت العزِّ فَخرا",56,"ر",2,0],["به قل ما تشاء وبالغزاة ال","ذين رموا عداه بالوبال",57,"ل",1,0],["بهِ قَمَرٌ في ليل جعد إذا بدا","شموس الضحىتضحي لديهِ غياهبا",58,"ب",2,0],["به قلب داودٍ وحكمة نجله","وهمة عبسي بضرب المناصِل",59,"ل",1,0],["به قد تقرَّب ما نرتجيه","من الخير والبردِّ بعد البعاد",60,"د",1,0],["به قناعيس أقلامي أردَّدها","ما بين وخدي وأعناقي وارقالي",61,"ل",2,0],["به قد أزلتَ الجهلَ والجهل راسخٌ","وأيقظتَ فيه العلم والعلمُ راقد",62,"د",1,0],["به قاصرات النظر","لولو ومرجانيه",63,"ن",3,0],["به قمر الهدى لاحت","معاليه وما احتجبا",64,"ب",2,0],["بهِ قد مات ذو القرنينِ","فافهَم ايُّها الشهمُ",65,"م",1,0],["به قصور كأنها بيع","ناطقة في خلالها الصور",66,"ر",1,0],["به قد ختمتُ خوالجي ومشاعري","فجمالُها بزَّ الخمائلَ والرشا",67,"ش",2,0],["به قامت قناة الدين عدلاً","ولانت باسمه الصم الصلاب",68,"ب",1,0],["به قلقُ الرياح بكوخ قَشٍ","وما للقشِ في الأنواء رتقُ",69,"ق",1,0],["بِهِ قَدْ قُلِّدَ المُخْتَارُ سَيْفًا","يُذِيقُ النَّازِلاتِ صَوَابَ حُكْمِ",70,"م",1,0],["بهِ قُريْشٌ عَلَتْ فاسْتَخْلصَتْ شَرَفًا","بَاهَتْ بِهِ أُمَمَ الدُّنْيَا وَ مَنْ سَمَقَا",71,"ق",2,0],["به قلب العروبة مستقل","الى وطن العروبة ذاب شوقا",72,"ق",2,0],["به قلوبٍ ياهي تشقى لو يبات الحقد iiجايع","وبه قلوبٍ لوهي تقوى مابقى في الدنيا iiجوع",73,"ع",1,0],["بِهِ قامَ بعد المَيلِ وانتَصَبَت بِهِ","دعائِمُ قد كانت على جُرُفٍ هارِ",74,"ر",1,0],["به قد نُكبنا .. به قد سُلبنا","جِنانَ الحياة وحُضنَ الخليل",75,"ل",1,0],["به قد عرفتُ منارَ هُدايَ","فجابتْ خُطايَ الطريقَ السويّا",76,"ي",2,0]]}