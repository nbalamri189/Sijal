442,"مادون رامة من معرس","https://www.poetsgate.com/ViewPoem.aspx?id=114778",""],[5544,"إلى المتفانين من أجلنا","https://www.poetsgate.com/ViewPoem.aspx?id=213440",""],[5725,"اما السواد","https://www.poetsgate.com/ViewPoem.aspx?id=197405",""],[6004,"في يومها الوطني","https://www.poetsgate.com/ViewPoem.aspx?id=59596",""],[6069,"وصل الكتاب فما فضضت ختامه","https://www.poetsgate.com/ViewPoem.aspx?id=105684",""],[6093,"والطَّلحُ يُمسِكُ ما يفيدُ وما يضُرّْ","https://www.poetsgate.com/ViewPoem.aspx?id=189806",""],[6097,"قل للشّهيدة في النّقاب الأسودِ","https://www.poetsgate.com/ViewPoem.aspx?id=190678",""],[6110,"في كاظمة أو ذي سلم","https://www.poetsgate.com/ViewPoem.aspx?id=141177",""],[469,"وعصبة كان يرجى سيب واحدهم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574784",""],[6164,"إلى الشاعر الواجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66079&r=&rc=88",""],[6213,"مركب ووقود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76267&r=&rc=24",""],[463,"إن تسأليني بعد قو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60202&r=&rc=258",""],[6259,"أذهبت رونق ماء الصبح في العذل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59394&r=&rc=42",""]],"verses":[["كَالريحِ تَرجِعُ عاصِفاً","مِن بَعدِ ما بَدَأَت نَسيما",0,"م",2,0],["كَالرَدى أَقدَمَ وَالغَيثُ هَمى","وَالدُجى طَبَّقَ وَالسَيلُ هَجَم",1,"م",1,0],["كالروض يشكر وابلاً","حيّا الأزاهر بانسكابه",2,"ب",2,0],["كالروق فيه من الأقوام بُلَّهم","إذا الخرائد لم يثبتن في الحُجِبِ",3,"ب",1,1],["كالروض أو كالبدر أو كالشمس قد","شرح الملاحة من ثلاثةِ أوجه",4,"ه",1,0],["كالريح والزرعُ استكان لمرِّها","وعتت فلم تقدر على تقصيفه",5,"ف",2,0],["كالريح أهلكتِ الهوا","لكَ في لياليها الحُسوم",6,"م",1,0],["كَالرَكايا لَم تَدَع فيها يَدُ الماتِحِ قَطرَه","أَو كَمِثلِ الرَوضِ لَم تَترُك بِهِ النَكباءُ زَهرَه",7,"ر",2,0],["كَالراحِ لَم أَرَ قَبلَ سامِعِها","سَكرانَ هِدَّ السُكرِ مُحتَشِما",8,"م",2,0],["كَالرُمحِ مَهزوزُ القَوا","مِ وَكَالقَضيبِ اللَدِنِ مائِس",9,"س",1,0],["كالريح تنقصف الغصو","ن بها وتنقلع الجذور",10,"ر",1,0],["كَالرَوضِ تَحتَ الطَيرِ أَعجَبَ أَيكُهُ","لَحظَ العُيونِ وَأَعجَبَ الإِصغاءَ",11,"ا",2,0],["كَالرُسلِ عَزماً وَالمَلائِكِ رَحمَةً","وَالأُسدِ بَأساً وَالغُيوثِ نَوالا",12,"ل",2,0],["كَالرَوضِ مُؤتَلِفاً بِحُمرَةِ نورِهِ","وَبَياضِ زَهرَتِهِ وَخُضرَةِ عُشبِهِ",13,"ب",2,0],["كَالرُمحِ فيهِ بِضعَ عَشرَةَ فِقرَةً","مُنقادَةً خَلفَ السِنانِ الأَصيَدِ",14,"د",1,0],["كَالرُمحِ أَذرُعُهُ عَشرٌ وَواحِدَةٌ","فَلَيسَ يُزرى بِهِ طولٌ وَلا قِصَرُ",15,"ر",1,0],["كَالرَوضِ أَثنى عَلى سَحائِبِهِ","بِزَهرَةِ الرَوضِ حينَ يَنشُرُها",16,"ر",3,0],["كَالرَفيقَينِ في الرَفيقَينِ مِن أَجا","ءِ وَسَلمى لَم يوجِفا في عُقوقِ",17,"ق",1,0],["كَالرَإِحِ النَشوانِ أَكثَرُ مَشيِهِ","عَرضاً عَلى السَنَنِ البَعيدِ الأَطوَلِ",18,"ل",1,0],["كَالراحِ تُدعى الإِثمَ عِندَ مَلالِها","وَمَعَ الرِضى تُدعى السُلافَ القَرقَفا",19,"ف",2,0],["كالرمس فارغةٍ وإن","حفلت بإيحاشِ البِلى",20,"ل",2,0],["كَالرَشَأِ العَوهَجِ اِطَّباهُ","رَوعٌ إِلى مُغزِلٍ رَغوثِ",21,"ث",1,0],["كَالرَّوْضِ تَسْمَعُ مِنْهُ نَغْمَةَ بُلْبُلٍ","وَالْغِيْلُ تَسْمَعُ مِنْهُ زَأْرَةَ ضَيْغَمِ",22,"م",1,0],["كَالرُمحِ وَالقَلَمِ القَصيرِ لِنِسبَةٍ","وَكِلاهُما في مايَنوبُ حَميدُ",23,"د",1,0],["كَالرُمحِ ذا نَصلَينِ أَينَ حَنَيتَهُ","أَلفَيتَهُ مِن حَومَتَيهِ مُذَرَّبا",24,"ب",2,0],["كَالرَوضِ راقَكَ مَنظَراً وَخَبَرتَهُ","فَوَجَدتَ عُنصُرَهُ الغَمامَ الصَيّبا",24,"ب",2,0],["كَالرُّمْحِ أَرْقَلَ في الكَفَّيْنِ واطَّرَدَتْ","مِنْهُ القَنَاةُ وفِيهَا لَهْذَمٌ غُولُ",25,"ل",1,0],["كالرَّبيعَيْنِ خِلْتُ أنّ الرّبيعَيْ","نِ أعاراهُما سَراباً غَزيرا",26,"ر",2,0],["كالريح في الريح لا تميزها","لا بخطوط ولا بألوان",27,"ن",1,0],["كالرّفيقَينِ في رَفيقَينِ مِنْ أجَ","إٍ وَسُلْمَى لمْ يُوجَفَا في عُقُوقِ",28,"ق",1,0],["كالرّوْضِ مُؤتَلِقاً بحُمرَةِ نَوْرِهِ","وَبَياضِ زَهْرَتِهِ وَخُضرَةِ عُشبِهِ",29,"ب",2,0],["كالرّاح لم أر قبل سامعها","سكران جدّ السّكر، محتشما",30,"م",2,0],["كالروض ملتفّ الخمائل ناضرا","ما ضرّه لو نوّعت زهراته",31,"ت",2,0],["كالرجل لكاذب في شأنه","ملوث القلب نقي الثياب",32,"ب",1,0],["كَالرِجلَةِ السَوداءِ تَغلو بِها","سَرعانُها في سَبسَبٍ مَجهَلِ",33,"ل",1,0],["كالروض أعشب في رواء أو ذكا","تعشيبه العميان لا تعشي به",34,"ب",2,0],["كالرمحِ قَدّا غيرَ أنّ سِنانَه","لَحْظٌ له قلبُ الكَمِيِّ طعين",35,"ن",1,0],["كالريح يحلبها الهبو","ب فخلها لمزيد همّك",36,"ك",1,0],["كالروضِ لما دبّجتُهُ غمامة","والمسكِ لما فُضَّ عنه ختام",37,"م",1,0],["كَالرُمحِ فَتّاكَ الطَعينَةَ قَدُّهُ","لَكِنَّ ناظِرَهُ السِنانُ الأَزرَقُ",38,"ق",1,0],["كالرَوضَةِ الغَنّاءِ أَو","كَغِناءِ ساجِعَةٍ هَتوفِ",39,"ف",1,0],["كالروض لكن بلا شوك ازاهره","والحوض لكنه يصفو بلا زرق",40,"ق",1,0],["كالرّماحِ الُمشْرَعات اهتِزازاً","هزّ أعْطَافِهِم بالْمَراح",41,"ح",1,0],["كَالرَّوْضِ أَهْدى إِلى رُوّادِهِ أَرَجاً","يُذْكِي النَّسِيمَ وَأَبْدى مَنْظَراً عَجَبا",42,"ب",2,0],["كالرَّوضَةِ الغنَّاءِ ضَاحَكَ زَهْرَهَا","مِن جُودِ كَفِّكَ عَارِضٌ ثَجَّاجُ",43,"ج",1,0],["كَالروحِ تُدرِكُها العُقولُ بِفِعلِها","وَيَضِلُّ عَنها الفِكرُ في تَجوالِهِ",44,"ل",2,0],["كالرَّوضِ باكرَه الحيا","وتَخطّرتْ فيهِ النّسيمُ",45,"م",1,0],["كالروض بكاره الحيا فتفتحت","أزهاره عن باطن الأكمام",46,"م",1,0],["كالرُمُ أَوَّلَه عَونٌ لآخِرِهِ","وَآخر الرُمحِ عون الأَكعبِ الأُوَلِ",47,"ل",1,0],["كالرّوضِ إن لم يُطِق شكرَ السحابِ إذا","هَمَى فَنَضرَتُه بالفَضْل تَعتَرِفُ",48,"ف",1,0],["كالرَّاح تسري إلى الأَرواح نشوتها","فالرُّوح في خفَّةٍ والجسم في خدر",49,"ر",1,0],["كالريح في هباتها والليث في","نهضاتها والبرق في مسراها",50,"ا",3,0],["كالروضِ يعبَقُ بين ري","سحانٍ ونسرينٍ وخِيري",51,"ر",2,0],["كالروضة الدنيا لنا معياشة","ولنحن سرب لا تزال ربوعا",52,"ع",2,0],["كالراحة البتراءِ خُو","لِسَ من أشاجعها البنانُ",53,"ن",1,0],["كالريم لو كانت تصاد بحيلة","والبدرِ إلا أنها لا تُكسفُ",54,"ف",1,0],["كالراح كلُّ بنانها منها وإن","بان اختلافُ أباهمٍ وخناصرِ",55,"ر",1,0],["كالرمح أُرهِفَ صدرُهُ","وكعوبُهُ نَصْلاً وزُجّا",56,"ج",2,0],["كالريحِ بأساً والنَّسيمِ لَطافَةً","نفْعُ الجنوبِ له ورَوْحُ الشَّمْأل",57,"ل",1,0],["كالرُّمح لوناً وليناً لحظُ مقلتهِ","يخون كلّ فؤادٍ وهو مؤتمن",58,"ن",1,0],["كالرعد يخفق في جوانج ليلةٍ","وعدُ الصباحِ بمثلها لا يقتضي",59,"ض",2,0],["كالرأس مرتَفعٌ فيه مشاعرُهُ","تهدي السبيلَ له رأس وعينان",60,"ن",1,1],["كالروح يظهر من نفس ومن جسد","وليس يكشفه إلا العنايات",61,"ت",1,0],["كالرِّيمِ وهْو سَانح","والغُصْنِ وهْو مَائس",62,"س",1,0],["كالرُّوحِ فِيهَا لِلنفُوسِ حَياتُهَا","وَنِزاعُهَا إِنْ آذنتْ بِنُزوعِ",63,"ع",1,0],["كالراح في بدئها الافراح لاح ومن","خمارها قرنت بالهم والحزن",64,"ن",1,0],["كالريح إنْ عصفتْ تُبقِى الثُّمامَ على","حالٍ وتسْتأصلُ العالي من الشجرِ",65,"ر",1,0],["كالرئم في نِفار","أو جَوْذَرِ الكثيب",66,"ب",1,0],["كالريم في عطف وفي حذر","كالغصن في لين وفي قد",67,"د",1,0],["كالروض في بشاشته","كالغيث في سماحته",68,"ه",1,0],["كالرَوض لا يزدان في أَندائه","حَتّى يمل مساؤه وَصباحه",69,"ح",2,0],["كالريم يغتال الأسود إذا رنا","بلواحظ تعنو لها الآرام",70,"م",1,0],["كالرمح مرهف قده","واللحظ منه سنانُهُ",71,"ن",2,0],["كالروضة الغناء غب ندى","يطري ويطرب من بها غنى",72,"ن",2,0],["كالروض راضته السحائب ثرة","وسرت عليه بوابل غيداقِ",73,"ق",1,0],["كَالراح عتَّقها الزَمان فَأَصبَحَت","شَهباء صافيَةً تَشعشع بِالأَنا",74,"ن",2,0],["كالراحِ طعماً وشمِ المسكِ رائحةً","والتبر لوناً وشكلِ البدرِ تدويرا",75,"ر",2,0],["كالروضِ إذ جادت عليه السما","والبعدُ ما بينهما ظاهرُ",76,"ر",1,0],["كالرديم الوهاج ألا إنه","أمضى شعاعاً في العيون وأبدع",77,"ع",1,0],["كالروض يغدو السرح فيه وينثني","عند الرواح كأنّه لم يرتع",78,"ع",1,0],["كالرّوضة الأُ نفَ اعتادَت بها نفساً","ريحُ الصّبا وغدتها رقة السَّحَرِ",79,"ر",1,0],["كالروض إن جاد الربيع له","يوم الصفاء بشائق البُردِ",80,"د",1,0],["كالرّوح في الجسم لا تُدرى حقيقتُها","ونورُها ساطع في مقلة وفم",81,"م",1,0],["كالريحِ في الجوِّ تهوى مالَها أثَرٌ","منها حميدٌ ومذمومٌ متى خَفَقا",82,"ق",2,0],["كالروضة الغناء إلّا أنها","عصماءُ سائلُ وصلها لا يرزق",83,"ق",1,0],["كالراح حين تصب أو","كالخد حين يُقبَّل",84,"ل",1,0],["كالروض حين جلا نواره وحلا","والصبح حين على جيش الدجى وثبا",85,"ب",2,0],["كالروح تنبعث النفوس بسره","أو كالحيا جاد الثرى فترعرعا",86,"ع",2,0],["كَالرُمحِ مَهزوزاً عَلى أَنَّهُ","لا فارِطُ الطولِ ولا جَحدَرُ",87,"ر",1,0],["كالرَسول العربي أَكرم به","من مذ بَدا الشرك اِضمحل",8