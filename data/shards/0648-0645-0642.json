464,"أجنها الفكر وأبداها العبق","https://www.aldiwan.net/poem3442.html","عموديه"],[464,"يا من لابيض كل جفن اسود","https://www.aldiwan.net/poem3536.html","عموديه"],[464,"لو عاد طيفكم فعاد عليلا","https://www.aldiwan.net/poem3602.html","عموديه"],[470,"أقوت رواوة من أسماء فالسند","https://www.aldiwan.net/poem4666.html","البسيط"],[477,"هل في المنازل بعد القوم آثار","https://www.aldiwan.net/poem15240.html","البسيط"],[477,"أما الشباب فشيء عز مطلبه","https://www.aldiwan.net/poem15274.html","البسيط"],[477,"عليل الوجد عندك لا يعاد","https://www.aldiwan.net/poem15313.html","الوافر"],[477,"بي من جوى التبريح اشفاق","https://www.aldiwan.net/poem15351.html","السريع"],[493,"ويؤيؤ أوحى من القضاء","https://www.aldiwan.net/poem67301.html","الرجز"],[495,"قرة عيني بذكا محبتي أي فلكا","https://www.aldiwan.net/poem10256.html","مجزوء الرجز"],[495,"يا لمة ضرب الزمان","https://www.aldiwan.net/poem10273.html","مجزوء الكامل"],[500,"دمع من العين جرى كالمطر","https://www.aldiwan.net/poem37689.html","السريع"],[500,"أهل الحجاب مع الثياب عيونهم","https://www.aldiwan.net/poem38061.html","الكامل"],[514,"نبتت رياحين العذار بورده","https://www.aldiwan.net/poem20790.html","الكامل"],[514,"تصاحى وهو مخمور الجنان","https://www.aldiwan.net/poem20821.html","الوافر"],[515,"سجوداً فهذا صاحب الركن والحجر","https://www.aldiwan.net/poem12107.html","الطويل"],[515,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[515,"العلم مذ كان محتاج إلى العلم","https://www.aldiwan.net/poem12262.html","البسيط"],[529,"لا تنكروني إن ثملت فللهوى","https://www.aldiwan.net/poem37301.html","الكامل"],[538,"نلت عطفي وحناني","https://www.aldiwan.net/poem47925.html","عموديه"],[551,"في العناء الطويل كيف وقعتم","https://www.aldiwan.net/poem47151.html","الخفيف"],[551,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[551,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[551,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[551,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[558,"ليت لو كنت إذا قلت أنا","https://www.aldiwan.net/poem33848.html","الرمل"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[558,"بنغمة العود لاح لي أثر","https://www.aldiwan.net/poem34531.html","المنسرح"],[558,"إن السماع سماع الناي والوتر","https://www.aldiwan.net/poem34546.html","البسيط"],[558,"كلامنا غير ما تعطى العبارات","https://www.aldiwan.net/poem34718.html","البسيط"],[567,"أحبابنا بقلوبنا شطوا","https://www.aldiwan.net/poem69613.html","الكامل"],[573,"يا برق برقاً بين مروة والصفا","https://www.aldiwan.net/poem3646.html","الكامل"],[575,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"],[575,"قتلي لحبكم شهادة","https://www.aldiwan.net/poem3076.html","مجزوء الكامل"],[586,"ومقرىء طيب الألحان هيج في","https://www.aldiwan.net/poem17784.html","البسيط"]],"verses":[["وَمَقيلٍ بَينَ أَخبِيَةٍ","قِلتُهُ وَالحَيُّ قَد بانوا",0,"ن",3,0],["وَمُقيلُ صَبرٍ شَذَّبَتهُ يَدُ الهَوى","في غَيرِ ما طَرَبٍ وَلا اِستِغرامِ",1,"م",1,0],["وَمُقاوِمٍ عَرَضَ الكَلامُ بُرودَهُ","فيهِنَّ بَينَ مُعَضَّدٍ وَمُسَهَّمِ",2,"م",1,0],["وَمُقَبِّلٍ كَفّي وَدَدتُ بِأَنَّهُ","أَومى إِلى شَفَتَيَّ بِالتَقبيلِ",3,"ل",1,1],["وَمِقوَلي كَالسَيفِ يَحتَمي بِهِ","أَشوَسُ أَبّاءٌ عَلى المَقاوِلِ",4,"ل",1,0],["وَمُقَوَّمِ الأُذُنَينِ تَحسَبُهُ","طَوداً أَنافَ بِصَدرِهِ جَبَلُ",5,"ل",1,0],["وَمُقَوَّماتٍ مِن غُصونِ هَوىً","يَعوَجُّ أَطواراً مُثَقِّفُها",6,"ف",3,0],["وَمَقاوِمٍ ما زِلتَ تُعجِزُ لَيلَها","بِلِسانِ قَوّالٍ وَقَلبِ سَمَيذَعِ",7,"ع",1,0],["وَمُقَصِّرٍ في الطولِ غَيرِ مُقَصِّرٍ","في الضَربِ يَقطَعُ كُلَّ حَبلِ وَريدِ",8,"د",1,0],["وَمُقلَتُهُ إِذا لَحَظَت حُسامي","تَغُضُّ مَهابَةً وَتَفيضُ رُعبا",9,"ب",2,0],["وَمَقيلِ عُفْرٍ زُرْتُهُ وَيَدُ الرَّدى","بَسَطَتْ أَنَامِلَها لِكي تَجْتاحَها",10,"ح",3,1],["ومُقْتَدِريّ منْ ذُؤابَةِ هاشِمٍ","بهِ يَصْغُرُ الخَطْبُ المُلِمُّ ويَعْظُمُ",11,"م",1,0],["ومُقْرَباتٍ خَطَتْ عَرْضَ الفَلاةِ بنا","قُبٍّ سَراحيبَ أمثالَ السّراحينِ",12,"ن",1,0],["ومَقامُ صبرِكَ واتّكالِكَ مُذْكِرٌ","بحَديثِهِ الشَّبْليَّ أو طاوُوسا",13,"س",2,0],["ومُقامُ بِرٍّ عُظِّمَتْ حُرُماتُهُ","واخْتالَ في خِلَعِ الرّضى زُوّارُهُ",14,"ر",2,0],["ومُقابِلَ التّمحيصِ بالصّبْرِ الذي","زُرَّتْ على مبْدإ الهُدى أزْرارُهُ",14,"ر",2,0],["ومقَرِّ توْحيدٍ وأسِّ خِلافَةٍ","آثارُها تُنْبي عنِ الأخْبارِ",15,"ر",1,0],["ومُقامُ السّلامِ في مُدّةِ السِّلْ","مِ وغابُ الأسودِ يومَ الكِفاح",16,"ح",1,0],["وَمَقَاصِدٌ شَكَرَ الإِلاَهُ ضَمِيرَهَا","وَدُعَاءُ مَسْمُوعِ الدُّعَاءِ مُجَابِ",17,"ب",1,0],["وَمُقَامِي نَزْرٌ وَأَصْرِفُ وَجْهِي","لِسَلاَ حَيْثُ مَعْدِنُ الحُمَقَاءِ",18,"ا",2,0],["وَمُقَطَّعِ الأَرماجِ لَيسَ لِدائِهِ","راقٍ وَأَعيا الداءِ داءُ الأَسفَلِ",19,"ل",1,0],["وَمُقدمُ الخَيلِ في لَبّاتِها قِصَدٌ","وَعاقِرُ البُدنِ في يَومي وَغىً وَقِرى",20,"ر",2,0],["وَمُقَصِّرٌ عَن بَعضِ ما أَولَيتُهُ","شُكري وَإِن كُنتُ الفَصيحَ المُسهَبا",21,"ب",2,0],["وَمَقرُبَةٌ دُهمٌ وَكُمتٌ كَأَنَّها","طَماطِمُ يوفونَ الوُفورَ هَنادِكُ",22,"ك",1,0],["وَمَقَامَةٍ فَصَّلْتَهَا وَوَصَلْتَهَا","وَصْلَ الْفَرِيدِ مُفَصَّلاً بِجُمَانِ",23,"ن",1,0],["وَمُقَرِّباً شُقَقَ الخِلافِ وَوَاصِلاً","مَا قَطَّعَتْهُ يَدُ الشِّقَاقِ الفَاصِمِ",24,"م",1,0],["وَمُقلَةَ شادِنٍ أَحوى مَروعٍ","يُديرُ لِرَوعَةٍ طَرفاً كَليلا",25,"ل",2,0],["وَمَقرونَةٍ مِنها يَدَيها بِرِجلِها","حَمَلتُ لِأَصحابي وَوَلَّيتُها قُترا",26,"ر",2,0],["ومقاتلٍ ما سَلَّ غير لحاظه","والرمحَ هزّ من القوام إذا خطرْ",27,"ر",1,0],["وَمُقرِفَةِ اللَهازِمِ مِن عِقالٍ","مُؤَرِّثُها جُبَيرٌ أَو لَبيدُ",28,"د",1,0],["وَمَقتولَةٌ صَبراً تَرى عِندَ رِجلِها","بَقيراً وَأُخرى ذاتُ بَعلٍ تُوَلوِلُ",29,"ل",1,0],["وَمُقَطِّعٍ حَلَقَ الرِحالَةِ سابِحٍ","بادٍ نَواجِذُهُ عَلى الأَظرابِ",30,"ب",1,0],["وَمَقامٌ أَكرِم بِهِ مِن مَقامٍ","وَهَوادٍ وَسُنَّةٌ وَمَشارُ",31,"ر",1,0],["وَمَقامٍ ضَيِّقٍ فَرَّجتُهُ","بِمَقامي وَلِساني وَجَدَل",32,"ل",1,0],["وَمَقامَةٍ غُلبِ الرِقابِ كَأَنَّهُم","جِنٌّ لَدى طَرَفِ الحَصيرِ قِيامُ",33,"م",1,0],["وَمُقَسِّمٌ يُعطي العَشيرَةَ حَقَّها","وَمُغَذمِرٌ لِحُقوقِها هَضّامُها",34,"م",3,0],["ومُقِلَّ اسقتموه فأثرى","مائة من عطائم جُرْجُورا",35,"ر",2,1],["وَمُقلَتي مِلؤُها دُموعٌ","وَأَضلُعي حَشوُها كُلومُ",36,"م",1,0],["وَمُقَطَّعاتٍ رُبَّما","حَلَّيتُ مِنهُنَّ الكُتُب",37,"ب",1,0],["ومقدمه من حمى المَرْجِ قد","شفاني من هرجِ مرج الكرب",38,"ب",1,0],["ومقلوبة أحجية مثل لم يجد","فدونك نظماً عاجزاً ليس يصلح",39,"ح",1,0],["ومقلة دعجاء ضاقت فما","تشبعُ من يقنع بالنظره",40,"ر",2,0],["ومقلة تنهب طيب الكرى","منها على عينك يا تاجر",41,"ر",1,0],["ومقيم على محاريب نسل","حسبه نور وجهه قنديلا",42,"ل",2,0],["ومقام للعلمِ لولا نظام","من مساعيك ما تنظَّم شملا",43,"ل",2,0],["ومقلة قد طغى إنسان ناظرها","فكانَ أكثر شيء بالبكا جدلا",44,"ل",2,0],["ومَقيلي في الصيف سُخْنٌ بلا خيْ","شٍ فعظمي يكادُ منه يذوبُ",45,"ب",1,0],["ومقالاً جرى وللشوق في الأح","شاءِ نارٌ أليمةُ الحُرُقاتِ",46,"ت",1,0],["ومُقَبَّلٍ عذب كأن نسيمَهُ","وَهْناً نسيمُ منابت البَسباس",47,"س",1,0],["ومقصودُ ما يُبغَى من السيف مضربٌ","حسام إذا لاقى الضريبة قاطع",48,"ع",1,0],["ومقالي بطول قدْري ولو قُلْ","تُ مقالي بطول قدْرِك طالا",49,"ل",2,0],["وَمُقاتِلٍ ناشَ الكَتيبَةَ ناشَهُ","ظُفرُ العُقابِ وَمِخلَبُ السَرجانِ",50,"ن",1,0],["وَمُقامٌ تَحسَبُ الأَر","ضَ بِنا فيهِ تَسيرُ",51,"ر",1,0],["وَمَقرونَةٍ شِمالُها بِيَمينِها","أُجَنَّبُ بَزّي ماؤُها قَد تَقَصَّرا",52,"ر",2,0],["وَمَقالَةُ الأَجيالِ لَم يَلحَق بِهِم","بانٍ وَلَم يُدرِكُهُمُ حَفّارُ",53,"ر",1,0],["وَمَقاصيرُ أُبدِلَت بِفُتاتِ ال","مِسكِ تُرباً وَبِاليَواقيتِ قَضّا",54,"ض",2,0],["ومُقَاسِمُ النيرانِ أنتَ لَمِنْ","أَخَذُوا العُهُودَ بعالَمِ الذَّرِ",55,"ر",1,0],["وَمَقانِبٍ بِمَقانِبٍ غادَرتُها","أَقواتَ وَحشٍ كُنَّ مِن أَقواتِها",56,"ت",3,0],["ومقاومٌ غلبُ الرقاب وفتيةٌ","شُوسٌ تجرُّ السَّمهريَّ وتدَّعي",57,"ع",2,0],["ومقايضٌ شكري ببرِّكَ راغِبٌ","من متجري في أوفرِ الأرباحِ",58,"ح",1,0],["ومقرورةٌ سجراءُ من نفحةِ الصَّبَا","وللشمسِ من صبغ المشارق تعصيبُ",59,"ب",1,0],["وَمُقامي لَدَيكَ في هَذهِ الحا","لِ مُقامٌ يُزري بِكُلِّ أَديبِ",60,"ب",1,0],["وَمُقِرّاً أَنَّ الخَليفَةَ مَنصو","رٌ بِرُكنٍ مِنَ المَوالي شَديدِ",61,"د",1,0],["وَمِقَتكَ القُلوبُ لَمّا تَراءَت","كَ وَليداً وَأَكبَرَتكَ الصُدورُ",62,"ر",1,0],["وَمَقامٍ بَينَ الأَسِنَّةِ ضَنكٍ","وَهَشيمٍ مِنَ الظُبا مَرصوفِ",63,"ف",1,0],["وَمُقيمٌ صَغى الأُمورِ وَفيها","حَيدٌ عَن جِهاتِها وَاِنفِتالُ",64,"ل",1,0],["وَمَقيلُ عَذلِكَ في جَوانِحِ مُغرَمٍ","وَجَدَ السُهولَ مِنَ الغَرامِ هُزوما",65,"م",2,0],["وَمُقَدَّمُ الأُذُنَينِ تَحسِبُ أَنَّهُ","بَهِما يَرى الشَخصُ الَّذي لِإِمامِهِ",66,"م",2,0],["وَمُقتَبَلَ المَلاحَةِ بِتُّ لَيلي","أُعاني مِن هَواهُ ما أُعاني",67,"ي",1,0],["وَمُقامي وَالحَولُ قَد مَرَّ نِصفٌ","مِنهُ إِن لَم يَشِن فَلَيسَ يَزينُ",68,"ن",1,0],["ومقلتاه شاطئا نقاءٍ","وخصره تهزهز القضيب",69,"ب",1,0],["ومقيد الطرفين يض","رب عند تضييق القيود",70,"د",1,1],["ومُقَدَّمٍ جارَى الملوكَ إلى العُلى","فتأخَّرُوا عن شأوِهِ وتقدَّما",71,"م",2,0],["ومُقلتُه تخبِّرُ مَنْ رَآها","بما سرَقَتْه من لونِ العُقارِ",72,"ر",1,0],["ومقصورُ النَّدى قَصُرَتْ يَداه","فلا نَفعٌ لَدَيْهِ ولا ضِرارُ",73,"ر",1,0],["ومَقالُ الشَّرْبِ للساقي أدِرْ","فَلَكَ الرّاح وللطاهي برَح",74,"ح",1,0],["ومقتبل السن سنّ الندى","فأعطى الفتوّة حقّ الفتاء",75,"ا",2,0],["وَمُقَرطَقٍ يَمشي أَما","مَ القَومِ كَالرَشاءِ الغَريرِ",76,"ر",1,0],["وَمَقالٍ إِذا دَعاهُ لَبيبٌ","ظَنَّ أَنّي مِنكَ اِستَفَدتُ العُلوما",77,"م",2,0],["وَمُقابِلٍ لَيلَ العَجاجِ بِوَجهِهِ","فَكَأَنَّما غَشّى الظَلامَ بِضِدِّهِ",78,"د",2,0],["وَمَقيلي ظِلَّ المَطِيَّةِ وَالتُر","بُ فِراشي وَساعِداها وِسادي",79,"ي",1,0],["ومقيّدين إلى الثرى","بين التخاذل والوهن",80,"ن",1,0],["ومقال الدهر عنا في غد","وحديث المجد عن عبد الحكم",81,"م",1,0],["ومقلتاها لو بكتْ عنهما","فاللؤلؤ الرّطبُ له مقلتان",82,"ن",1,0],["ومُقْتَحَمُ الأبطالِ يبرُقُ بالرّدى","وتخفقُ في آفاقه عَذَبُ النصرِ",83,"ر",1,0],["وَمُقتَبَلٍ حَلَّت سُيوفُكَ رَأسَهُ","ثَغاماً وَلَولا وَقعُها كانَ عِظلِما",84,"م",2,0],["وَمُقاتِلينَ إِذا اِنتَمَوا لَم يُخزِهِم","في نَصرِكَ الأَخوالُ وَالأَعمامُ",85,"م",1,0],["وَمَقامَةٍ نَبلُ الكَلامِ سِلاحُها","لِلقَولِ فيها غَمرَةٌ لا تَنجَلي",86,"ل",2,0],["وَمَقيلُ صَدرٍ فيكَ باقٍ رَوعُهُ","لَو أَنَّهُ ثَغرٌ لَكانَ مَخوفا",87,"ف",2,0],["وَمَقدودَةٍ رُؤدٍ تَكادُ تَقُدُّها","إِصابَتُها بِالعَينِ مِن حَسَنِ القَدِّ",88,"د",1,0],["ومقلتايَ لشوقي نحوَ حجرتِهِ","مثلَ القناتينِ مِنْ أَيْنٍ وَمِنْ ضُمُرِ",89,"ر",1,0],["وَمَقالِها سِر لَيلَةً مَعَنا","نَعهَد فَإِنَّ البَينَ شائِعُنا",90,"ن",2,0],["وَمَقاماً قُمنا بِهِ نَتَّقي العَي","نَ لَهَونا بِهِ وَذُقنا النَعيما",91,"م",2,0],["وَمُقلَتَي نَعجَةٍ أَدماءَ أَسلَمَها","أَحوى المَدامِعِ طاوي الكَشحِ قَد خَذَلا",92,"ل",2,0],["وَمَقالَها وَدُموعُها سَجَمٌ","أَقلِل حَنينَكَ حينَ تَنصَرِفُ",93,"ف",1,0],["وَمَقالَها بِالنَعفِ نَعفِ مُحَسِّرٍ","لِفَتاتِها هَل تَعرِفينَ المُعرِضا",94,"ض",2,0],["وَمَقالُ الخَودِ لَمّا واجَهَت","جِهَةَ الرَكبِ وَعَيناها دِرَر",95,"ر",1,0],["وَمَقاماً قَد أَقَمتُهُ مَعَ نُعمٍ","وَحَديثاً مِثلَ الجَنى المُشتارِ",96,"ر",1,0],["وَمقامِ بَأسٍ في الكَريهَةِ قُمتُهُ","فَسَبحتُ في بَحرِ الحَديدِ الأَخضَرِ",97,"ر",1,0],["وَمَقامُ حُكمٍ عادِلٍ لا يَزدَري","فيهِ المُعَلّى خَطوُهُ بِالنافِسِ",98,"س",1,0],["وَمُقَنَّعٍ بُخلاً بِنَضرَةِ حُسنِهِ","أَمسى هِلالاً وَهوَ بَدرُ تَمامِ",99,"م",1,1],["وَمَقانِياً مِلءَ الوَغى وَكَتائِباً","تَأبى قَراراً أَو تُصيبَ قِتالا",100,"ل",2,0],["ومُقَسَّمُ الأخلاقِ يُحسِنُ مَرّةً","وَيُسِيءُ أخرى في الحوارِ فَيعرم",101,"م",1,0],["وَمُقلَةٍ مُبيَضَّةِ المَآقي","وَأُذُنٍ كَحُقَّةِ الدَباقِ",102,"ق",1,0],["وَمَقتولِ سُكرٍ عاشَ لي إِذ دَعَوتُهُ","وَبادَرَ مَسروراً يَرى غَيَّهُ رُشدا",103,"د",2,1],["وَمُقلَتُها سائِلٌ كُحلُها","وَقَد جُلِيَت سَبَجاً مِن ذَهَب",104,"ب",1,0],["ومُقارِبٌ فيما يرُومُ مُباعِدٌ","أعيا لبيبَ القَومِ جَمُّ فُنونهِ",105,"ن",2,0],["ومُقابَلٌ بينَ النبوَّةِ والهُدى","من جَوْهَرٍ في جوهرٍ يَتَنَقَّل",106,"ل",1,0],["ومَقاليَ المحمولُ شاردُهُ","ولسانيَ الصَّمصامةُ الذكَر",107,"ر",1,0],["ومُقْتَبَلٌ أيامُه متهلِّلٌ","إليه الشبابُ الغَضُّ والزَّمنُ النَّضر",108,"ر",1,0],["وَمَقرورٍ مَزَجتُ لَهُ شَمولا","بِماءٍ وَالدُجى صَعبُ الجِنابِ",109,"ب",1,1],["وَمَقدودٍ كَقَدِّ السَيفِ رَخصٍ","كَأَنَّ بِخَدِّهِ لَمعُ السَرابِ",110,"ب",1,0],["وَمُقلَتَي رَحمَةٍ في","زِناهُما مُقلَتاكا",111,"ك",2,0],["وَمُقلَةٍ أَشرِبَ