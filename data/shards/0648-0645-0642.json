وَمَقالُ الفَتاةِ إِذ هُتِكَ السَت","رُ لَها عَن مَقالِ ما كانَ عَبّا",116,"ب",2,0],["وَمَقامي بَينَ المُصَلّى إِلى المِن","بَرِ أَبكي عَلَيكِ جَهدَ البُكاءِ",117,"ا",2,0],["وَمَقالَ الفَتاةِ عودي بِحِلمٍ","ما التَجَنّي مِن شيمَةِ الحُلَماءِ",117,"ا",2,0],["وَمُقَيَّدٌ عِندَ القَضاءِ كَمُطلَقٍ","فيما يَنوبُ وَمُطلَقٌ كَمُقَيَّدِ",118,"د",1,0],["ومُقابَلٍ بينَ الوَجيهِ ولاحِقٍ","وافاكَ بينَ مُطَهَّمٍ ومُطَهَّمِ",119,"م",1,0],["ومُقْرَبة يشقرُّ في النَّقْعِ كمْتُها","وتَخْضرُّ حيناً كلَّما بَلَّها الرَّشحُ",120,"ح",1,0],["وَمُقَالاَةُ غَادَةٍ لِسِوَاهَا","كَاعْتِرَافٍ مِنْهَا لَهَا بِمَزِيدِ",121,"د",1,0],["وَمقَامُ زَحْلَةَ بَالِغٌ أَبَداً","أَوْج الْفَخارِ بِرَغْمِ حسَّادِ",122,"د",1,0],["وَمُقَرطَقٍ يَسعى إِلى النَدماءِ","بِعَقيقَةٍ في دُرَّةٍ بَيضاءِ",123,"ا",2,1],["ومقلدَ الشعر الحديث قوافيًا","تسرى من الأعماق للأعماق",124,"ق",1,0],["وَمَقامي لَدَيْكَ في هَذِهِ الحَا","لِ مَقَامٌ يُزْرِي بكُلّ أرِيبِ",125,"ب",1,0],["وَمَقيلُ عَذْلِكَ في جَوَانِحِ مُغْرَمٍ،","وَجَدَ السّهولَ منَ الغَرَامِ حُزوما",126,"م",2,0],["ومقاتل ناش الكتيبة، ناشه","ظفر العقاب ومخلب السّرحان",127,"ن",1,0],["ومقانباً ملء الوغى وكتائباً","تأبى قراراً أو تصيب قتالا",128,"ل",2,0],["وَمَقَالَها بِکلنَّعْفِ نَعْفِ مُحَسِّرٍ","لفتاتها: هلْ تعرفينَ المعرضا؟",129,"ض",2,0]]}