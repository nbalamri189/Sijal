{"poems":[[88,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39562","الخفيف"],[347,"قيل لي هات في الوطن","https://www.aldiwan.net/poem55326.html","مجزوء الخفيف"]],"verses":[["عَجَبٌ صُنعُها وَأَعجَبُ مِنهُ","صُنعُهُ تِلكَ قُدرَةُ الرَحمَنِ",0,"ن",1,0],["عَجَبٌ صبرُهم على خطبك الدَّا","وي وصبرُ البأساءِ من ذاك أعجبْ",1,"ب",1,0],["عجب صاح نسمة","تقلب الكأس والسحن",2,"ن",1,0]]}