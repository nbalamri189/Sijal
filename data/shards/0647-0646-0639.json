{"poems":[[57,"ذكر البين ليته لا يكون","https://www.aldiwan.net/poem26085.html","الخفيف"],[104,"هاجر أمنا ولود رؤوم","https://www.aldiwan.net/poem33099.html","الخفيف"],[199,"منع النوم طارقات الهموم","https://www.aldiwan.net/poem54415.html","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27283","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27282","الرمل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101679","الخفيف"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87330","الرجز"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111472","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72470","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139714",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139621",""],[1901,"من مجيري من الهوى أَو معيني","https://www.poetsgate.com/ViewPoem.aspx?id=160400",""],[199,"هُنَّ عُجْمٌ، وقد عَلِمْنَ مِنَ القَوْ م","https://www.poetsgate.com/ViewPoem.aspx?id=22435",""]],"verses":[["هُنَّ عِندي مِثلُ الشُسوعِ هَواناً","وَبِفَوزٍ قَلبي حَبيسٌ رَهينُ",0,"ن",1,0],["هُن عشر نبذتموها جَميعاً","وَرتعتم في الغَي وَهُوَ وَخيم",1,"م",1,0],["هُنَّ عُجمٌ وَقَد فَهِمنَ مِنَ القَولِ","هَبي وَاِجدَمي وَهابي وَقَومي",2,"م",2,0],["هَنعة في سماكها","والنعائم صوَّّتا",3,"ت",2,0],["هَنعة الأنعام في أفلاكها","ذرعت بلدتها في الغَسَقِ",4,"ق",1,0],["هنّ علمنني اقتراح الاماني","واقتناص الآمال ما شئت صيدا",5,"د",2,0],["هُنَّ علىعَيبَاتَ بالتحقيقِ","وَآحذَر تَجُرَّه ثَمَّ يا رفيقي",6,"ي",1,0],["هن على اطراف هذا الدب","من البنات والسهى بالقرب",7,"ب",1,0],["هنّ على منطقة العواء","وبعد هذا النجم ذي الثناء",7,"ا",2,0],["هن على مثلث طويل","يطلعن من بعد طلوع الغول",7,"ل",1,0],["هن على شكل كحرف اللام","يضئن للابصار في الظلام",7,"م",1,0],["هُنَّ عُرجٌ جُعدُ الوُجُوهِ وحُسرُ","يَتَعَقَّبنَ زَلَّةً حِينَ تَعرُو",8,"و",1,0],["هن عتك هاروت لا ترضيه معذرتي","هل تنكر القلب للاعيان مقدرتي",9,"ي",1,0],["هنِّ عبدالكريم قطبَ مساعٍ","ليس تنأى عنه المعالي انحرافا",10,"ف",2,0],["هنِّ عبدالهادي بأوب همامٍ","ليس تلفى عنه المعالي انصرافا",10,"ف",2,0],["هنِّ عيدَ الدين القويم بعيدِ","جاء شوقاً يزروه من بعيدِ",11,"د",1,1],["هنَّ عوّدْننا مواصلةَ الصبرِ","على الهجرِ والبعادِ الشَّطونِ",12,"ن",1,0],["هُنَّ عُجْمٌ، وقد عَلِمْنَ مِنَ القَوْ م","لِ هبي واقدمي وآوو وقومي",13,"ي",1,1]]}