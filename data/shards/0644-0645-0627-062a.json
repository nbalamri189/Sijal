 من وله","https://www.aldiwan.net/poem15301.html","البسيط"],[479,"لما تعذر أن أكو","https://www.aldiwan.net/poem36887.html","مجزوء الكامل"],[482,"لما تبدت ديمية في ساعة","https://www.aldiwan.net/poem24332.html","عموديه"],[493,"فصرت أمسك عن أوصاف نعمته","https://www.aldiwan.net/poem67335.html","البسيط"],[500,"لما تقلقلت الركبان سارية","https://www.aldiwan.net/poem37740.html","البسيط"],[504,"أحببت رب ملاحة لجماله","https://www.aldiwan.net/poem38412.html","الكامل"],[515,"هي سلوة حلت عقود وفائها","https://www.aldiwan.net/poem11999.html","الكامل"],[515,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[515,"عادت عليك أهلة الأعياد","https://www.aldiwan.net/poem12061.html","الكامل"],[515,"في مثل مدحك شرح القول مختصر","https://www.aldiwan.net/poem12117.html","البسيط"],[515,"ثغر الهدى متبلج بسام","https://www.aldiwan.net/poem12245.html","الكامل"],[540,"لما تعرضت للحاجات واعتلجت","https://www.aldiwan.net/poem56803.html","الطويل"],[551,"إن العقيق يزيدني خبلا","https://www.aldiwan.net/poem47321.html","أحذ الكامل"],[551,"بالله يا أيام يثرب عودي","https://www.aldiwan.net/poem47844.html","الكامل"],[553,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[562,"لما تولى تخت مصر سعيدها","https://www.aldiwan.net/poem52645.html","الكامل"],[562,"هذه عروس الزهر نقطها الندى","https://www.aldiwan.net/poem52865.html","الكامل"],[562,"شوق يهيج وقلب طالما خفقا","https://www.aldiwan.net/poem52893.html","البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"الله أكبر هذا وجه إسحاقا","https://www.aldiwan.net/poem3645.html","البسيط"],[575,"الجن قد طرقت بأعينها","https://www.aldiwan.net/poem2703.html","أحذ الكامل"],[575,"عذل المحب على معذبه","https://www.aldiwan.net/poem2907.html","الكامل"],[575,"أضحى هلالاً بدر ذاك النادي","https://www.aldiwan.net/poem2962.html","الكامل"]],"verses":[["لَمّا تَعَذَّرَ أَن يُبَقِّيَ نَفسَهُ","بَقَّى عَلَينا رَأيَهُ المَأمونا",0,"ن",2,0],["لَمّا تَأَمَّلتُ قُبحَ صورَتِهِ","رَجَعتُ أَبكي دَماً عَلى أَمَلي",1,"ي",1,0],["لَمّا تَمالَوا عَلى عَذلي أَجَبتُهُمُ","بِعِزِّ مُعتَرِفٍ لا ذُلِّ مُعتَذِرِ",2,"ر",1,0],["لَمّا تَبَلَّجَ مُفتَرّاً مَباسِمُهُ","نَضَحْتُ غُرَّتَهُ بالمَدمَعِ الهَطِلِ",3,"ل",1,0],["لَمّا تَسَنَّمَ أَعلاهُ هَوى بِفَتىً","يُطَبِّقُ الأَرضَ تيهاً وَالسَّماءَ مَعا",4,"ع",2,0],["لمّا تَوشَّحَتِ البِلادُ بفِتْنَةٍ","ما إنْ تَصيدُ سوى نُفوسِ الصِّيدِ",5,"د",1,0],["لَمّا تَبَيَّنَ أَن لا دَلوَ حاضِرَةٌ","وَلا رِشاءٌ وَلا عَهدٌ لِآثارِ",6,"ر",1,0],["لَمّا تَغَرَّبَ حازَ الفَضلَ أَجمَعَهُ","فَصارَ يُحمَلُ بَينَ الجَفنِ وَالحَدَقِ",7,"ق",1,0],["لمّا توغّلَ في السُّرَى بدْرُ الدُجَى","أبْصَرْتَهُ بَدْراً وكانَ هِلالا",8,"ل",2,0],["لَمَّا تَحَمَّلتُ عَنْكَ الرَّكْبَ مُرْتَحِلاً","وَالْقَلْبُ فِيكَ غَدَاةَ الْبَيْنِ مُرْتَهَنُ",9,"ن",1,0],["لَمَّا تَفَنَّنْتُ فِي أَفْنَانِ قَامَتِهَا","تَفَنَّنَتْ بِفُنُونِ الصَّدِّ تُفْنِينِي",10,"ي",1,0],["لمّا توعّدَها على المَجْدِ العِدى","رضِيَتْ بعَيْثِ النّارِ لا بالعارِ",11,"ر",1,0],["لمّا تعذَّرَ أنْ أُشا","هِدَ ذلكَ الوجْهَ الأغَرْ",12,"ر",1,0],["لَمّا تَنَبَّهَ بِالكِنانَةَ نائِمٌ","وَأَصاتَ بِالشَكوى الأَليمَةِ صاحي",13,"ح",2,0],["لَمّا تَشَكّى اِبنُ عَصرونٍ إِلَيَّ حِمىً","في سفلِهِ حارَ فيهِ كُلُّ بَيطارِ",14,"ر",1,1],["لَمّا تَخَيَّرَني أَروي قَصائِدَهُ","مَضيتُ قُدماً وَخَلَّفتُ الرُواةَ وَرا",15,"ر",2,0],["لَم آتِ مُطَّلِباً إِلّا بِمُطَّلَبِ","وَهِمَّةٍ بَلَغَت بي غايَةَ الرُتَبِ",16,"ب",1,1],["لما تبيّنت المعالم همّداً","هطلت مدامع طرفي السفاح",17,"ح",1,0],["لما تألقّ في البلاد سناها","وضحت إلى العلياء كل طريق",18,"ق",1,0],["لما تكرّهتي الأراذل سرّني","أني إليهم يا أُميم بغيض",19,"ض",1,0],["لَمّا تَبَيَّنتُ أَن قَد حيلَ دونَهُمُ","ظَلَّت عَساكِرُ مِثلُ المَوتِ تَغشانا",20,"ن",2,0],["لَمّا تَوَجَّهَ بِالجُنودِ وَأَدرَبوا","لاقى الأَيامِنَ يَتَّبِعنَ الأَسعُدا",21,"د",2,0],["لَمّا تَشَوَّقَ بَعضُ القَومِ قُلتُ لَهُم","أَينَ اليَمامَةُ مِن عَينِ السَواجيرِ",22,"ر",1,0],["لَمّا تَرَفَّعَ مِن هَيجِ الجَنوبِ لَهُم","رَدّوا الجِمالَ لِإِصعادٍ وَما اِنحَدَروا",23,"ر",3,0],["لَمّا تَذَكَّرتُ بِالدَيرَينِ أَرَّقَني","صَوتُ الدَجاجِ وَقَرعٌ بِالنَواقيسِ",24,"س",1,0],["لَمّا تَخايَلَتِ الحُمولُ حَسِبتُها","دَوماً بِيَثرِبَ ناعِماً وَنَخيلا",25,"ل",2,0],["لما تفلق عنه قيض بيضته","آوَاه في ضِبْنِ مَضْبوءٍ به نَصَبِ",26,"ب",1,0],["لما تحرَّم عنه الناسُ ربربَه","بالمُهْوئن فَمَرِميِّ ومُحْتَبَلُ",27,"ل",1,1],["لَمّا تَبَيَّنتُ بِأَنّي لَهُ","أَزدادُ حُبّاً كُلَّما لاموا",28,"م",3,1],["لَمّا تَسَربَلَ بِالفَضائِلِ وَاِرتَدى","بُردَ العُلا وَاِعتَمَّ بِالإِقبالِ",29,"ل",1,0],["لما تحلت سنه بالهنا","لديكم في أسعد الوقت",30,"ت",1,0],["لما ترفع عن ند يسابقه","أضحى يسابق في ميدانه نظره",31,"ر",2,0],["لما تبدى في الحنين","تحاربت كبدِي وعيني",32,"ي",1,1],["لما تبسم عنك المجدُ قلت له","قهقِهْ فلا ثَعَلاً تُبدي ولا قلحا",33,"ح",2,0],["لِمَا تُؤذن الدنيا به من صروفها","يكون بكاءُ الطفل ساعةَ يُولَدُ",34,"د",1,0],["لما توالى لك النَّجْمان في نَسَقٍ","وافاهُ نجمٌ هَدى السَّارين في البيدِ",35,"د",1,0],["لما تُؤذن الدنيا به من شرورها","يكون بكاء الطفل ساعة يوضَعُ",36,"ع",1,1],["لَمّا تُبُحِّثَتِ الضَغائِنُ بَينَهُم","أَفضى وَسارَ بِجَحفَلٍ جَرّارِ",37,"ر",1,0],["لَما تَرَكوا شَمسَ النَهارِ يَزورُهُ","سَناها وَلا زَهرُ النُجومِ تُسامِرُه",38,"ر",2,0],["لَمّا تَراءَت مِن بَعيدٍ خِلتُها","سُفُنا وَخِلتُ الأَرضَ بَحراً أَخضَرا",39,"ر",2,0],["لَمّا تَنَكَّرتُ لَم يَعُد صُحُبي","يَدرونَ أَنّي الصَديقُ إِن رَمَقوا",40,"ق",3,0],["لَمّا تَخَلَّسَ أَنفاساً قَرائِنُها","مِن غَمرِ سَلمى دَعاها تَوأَمٌ قَرِدُ",41,"د",1,0],["لمَّا تَنَاوَلَهُ بعُنْفٍ","ساعِدُ المَوتِ الشَّديدْ",42,"د",1,0],["لَمّا تَنَلكَ شُعوبٌ جاوَزَت","غُلبُ الرِجال وَساميَ الأَوسارِ",43,"ر",1,0],["لمّا تَماسَكتِ الدُموعُ","وَتنبّهَ القَلبُ الصَديعُ",44,"ع",1,1],["لما تألف عقدا قال قائله","يصوغ للمحسنين الحمد تيجانا",45,"ن",2,0],["لَمّا تَرَقرَقَ في دَمعِ السَماءِ دَماً","هاجَ البُكا فَخَضَبنا الأَرضَ باكينا",46,"ن",2,0],["لَمّا تَلاحى الناسُ لَم","تَنزِل إِلى المَرعى الوَخيمِ",47,"م",1,0],["لَمّا تَقَطَّعَتِ الحُمولُ تَقَطَّعَت","نَفسي أَسىً وَكَأَنَّهُنَّ طُلوحُ",48,"ح",1,0],["لَمّا تُحَكَّمَتِ الأَسِنَّةُ فيهِم","جارَت وَهُنَّ يَجُرنَ في الأَحكامِ",49,"م",1,0],["لما تأملته رأيت له","مجداً تضلُّ الصفات في طرقِهْ",50,"ق",2,0],["لما تفاوت في بسائطها","صور المزاج تفاوت الخُلُقُ",51,"ق",1,0],["لما تساوى الوزن تمَّ به","جسد له من روحه طبقُ",51,"ق",1,0],["لمّا توهَّمْتُ أني صِدتُها شردتْ","فقطَّعتْ عقدَ أشراكِي وأرساني",52,"ي",1,0],["لَمّا تَضايَقَ بِالزَحفَينِ قُطرُهُما","فَضارِبٌ بِغِرارِ السَيفِ أَو واجِ",53,"ج",1,0],["لَمّا تَشابَهَتِ الرِجالُ حَكَيتَهُ","مَجداً أَطَلَّ عَلى النُجومِ وَسُؤدُدا",54,"د",2,0],["لَمّا تَراءاكَ في دَيجورِ قَسطَلِهِ","تُزجي مِنَ المَوتِ فيها عارِضاً قَصَفا",55,"ف",2,0],["لَمّا تَمادَت شَكاةُ الدينِ أَعجَزَهُ","إِلّا بِسَيفِكَ مِن تِلكَ الشَكاةِ شِفا",55,"ف",2,0],["لَمّا تَعَبَّدَ مَحلُ الأَرضِ وَاِحتَبَسَت","عَنّا السَحائِبُ حَتّى ما نُرَجّيها",56,"ي",3,0],["لَمّا تَفَرَّقَ بي هَمّي جَمَعتُ لَهُ","صَريمَةً لَم يَكُن في عَزمِها خَوَرُ",57,"ر",1,0],["لَمّا تَدارَكَ لِلمُبارَكِ مَدُّهُ","رَخُصَ الطَعامُ لِمايِحٍ وَتِجارِ",58,"ر",1,0],["لَمّا تَكَسَّعَ في الرِمالِ هَدَت لَهُ","عَرفاءُ هادِيَةٌ بِكُلِّ وِجارِ",59,"ر",1,0],["لَما تُرِكَت كَفٌّ تُشيرُ بِأُصبُعٍ","وَلا تُرِكَت عَينٌ عَلى الأَرضِ تَطرِفُ",60,"ف",1,0],["لَمّا تُخوصِمَ في الخِلافَةِ بِالقَنا","وَبِكُلِّ مُختَضَبِ الحَديدِ حُسامِ",61,"م",1,0],["لما تنادى اليوم بالخفوف","منهزما من الظلام الموفي",62,"ف",2,1],["لما تزايد قلت لست بمشبه","إنعام سيف الدولة المتزايدا",63,"د",2,0],["لمّا تَبَسَّمَ في فَنائِك نَورُها","أجريْتَ بالمعروفِ فيه جَداوِلا",64,"ل",2,0],["لما تَمزَّقَتِ الأغمادُ عن شُعَلٍ","تمزَّقَت عن سَنا أقمارِها الكِلَلُ",65,"ل",1,0],["لمّا تبسَّمَ في الفَوْديَنِ مغترباً","حيَّيتُه وكلانا اليومَ مغتَرِبُ",66,"ب",1,0],["لما توجَّه تِلقاءَ الثغورِ صفَت","كُدْرُ المياه بها واعشوشَبَ التَّرِبُ",66,"ب",1,0],["لما تَراءى لكَ الجمعُ الذي نَزَحَتْ","أقطارُهُ ونَأتْ بُعداً جوانبُه",67,"ب",2,0],["لَما تَبَدَّيتِ عَلى بَغلَةٍ","أَشرَقَتِ الأَرضُ لِبُرهانِك",68,"ك",1,0],["لَمّا تَطاوَلَ بي إِفراطُ مَطلِكَ لي","وَضاعَ وَقتِيَ بَينَ العُذرِ وَالعَذَلِ",69,"ل",1,1],["لَمّا تَجافاني","أَرعى النُجوم",70,