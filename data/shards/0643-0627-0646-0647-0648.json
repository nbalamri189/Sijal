//poetry.dctabudhabi.ae/diwan/poem/40087","السريع"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/198890","البسيط"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101375","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119689","البسيط"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136902",""],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93260","السريع"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93312","البسيط"],[4214,"","https://poetry.dctabudhabi.ae/diwan/poem/198318","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33746","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72797","البسيط"],[4691,"سفينة الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=60425",""],[4888,"لذة","https://www.poetsgate.com/ViewPoem.aspx?id=207678",""],[4119,"ما استأنف القلب من أشواقه أربا","https://www.poetsgate.com/ViewPoem.aspx?id=16079",""],[5063,"يَا حبذا الياسمين إِذْ يزهر","https://www.poetsgate.com/ViewPoem.aspx?id=191206",""],[5139,"مليط","https://www.poetsgate.com/ViewPoem.aspx?id=68956",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5213,"أعرّست على العذيب العرب","https://www.poetsgate.com/ViewPoem.aspx?id=170410",""],[5362,"لقد أضاء الكهرباء بعدما","https://www.poetsgate.com/ViewPoem.aspx?id=170331",""],[5376,"سئمت الحياة وعشت الممات","https://www.poetsgate.com/ViewPoem.aspx?id=188372",""],[243,"تسديد الحساب","https://www.poetsgate.com/ViewPoem.aspx?id=50560",""],[5753,"من بريدِ الورد","https://www.poetsgate.com/ViewPoem.aspx?id=212286",""],[6031,"جَذَّ الردَى سَبَبَ الإسلامِ فَانْجذَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=46278",""],[6069,"ومغرمٍ بالبدال قلت له","https://www.poetsgate.com/ViewPoem.aspx?id=105703",""],[4442,"يبدو الشباب بشكل الخرد العين","https://www.poetsgate.com/ViewPoem.aspx?id=171001",""]],"verses":[["كانَ هَوىً لِلنَفسِ لَو أَنَّني","في حَلَقِ القِدِّ وَأَنتَ الطَليق",0,"ق",1,0],["كَأَنَّ هَوادِجَها وَالقِبابِ","يَثنينَ مِنهُنَّ باناً وَزَندا",1,"د",2,0],["كأنّهُ والمُلوكُ الصِّيدُ تَلثِمُهُ","خَدٌّ تَقاسَمَهُ الأفْواهُ بالقُبَلِ",2,"ل",1,0],["كأنّه وهْوَ بالظَّلْماءِ مُشْتَمِلٌ","خاضَتْ قَوائِمُهُ نهْراً منَ الفَلَقِ",3,"ق",1,0],["كَأَنَّهُ وَرِجالُ الرِيِّ تَحرُسُهُ","مُمَلَّكٌ سارَ في جُندٍ وَأَعوانِ",4,"ن",1,0],["كَأَنَّ هَوِيَّ الدَلوِ في البِئرِ شَلُّهُ","بِذاتِ الصِوى آلافَهُ وَاِنِشِلالُها",5,"ل",3,0],["كَأَنَّ هَويَّهُنَّ بِكُلِّ خَرقٍ","هَوِيُّ الرُبدِ بَادَرَتِ الرِئالا",6,"ل",2,0],["كَأَنَّهُ وَالدُجى في اللَيلِ مُنغَمِسٌ","ذو يَلمَقٍ مِن عَتيقِ القَهزِ مَقصورِ",7,"ر",1,0],["كَأَنَّهُ وَالرهاءُ المَرتُ يَركُضُهُ","أَعرافُ أَزهَرَ تَحتَ الرِيحِ مَنتوجِ",8,"ج",1,0],["كان هو الشاعر الذي انتشرت","أشعاره في البلاد منتقله",9,"ل",2,0],["كأنَّ هواه في حبّ العطايا","يطالبه بدِين لا بدَين",10,"ن",1,0],["كأنَّه وهو مسؤولٌ ومُمْتدَحٌ","غَنَّاهُ إسحاقُ والأوتارُ في صَخبِ",11,"ب",1,0],["كأنه وزمامُ الدهر في يده","يرى عواقبَ ما يأتي وما يذر",12,"ر",1,0],["كأنه والعفاة الطائفين به","بَنيَّةُ الله والحجاج طوافا",13,"ف",2,0],["كأنه وحدَه جيشٌ له لَجَبٌ","صواهل الأرض شتى من صواهلِهِ",14,"ل",2,0],["كأنه واقف أمامي","كأنه آسف لحيني",15,"ي",1,0],["كَأَنَّهُ وَردَةٌ حَمراءُ زاهِيَةٌ","في الخُلدِ قَد فُتِّحَت في كَفِّ رُضوانا",16,"ن",2,0],["كَأَنَّهُ والِدٌ يَرِفُّ بِهِ","مُفرِطُ إِشفاقِهِ وَهُم وَلَدُه",17,"د",2,0],["كَأَنَّهُ وَبَنو شَيبانَ تَكنُفُهُ","بَدرٌ بَدا في نُجومِ السَعدِ بِالكَمَلِ",18,"ل",1,0],["كأنَّه وهَجِيرُ الرَّوعِ يَلفَحُه","نَشْوانُ مدَّ عليه ظِلَّه الأُصُلُ",19,"ل",1,0],["كَأَنَّهُ وَالكَأسُ في كَفِّهِ","بَدرُ الدُجى يَحمِلُ شَمسَ الصَباح",20,"ح",1,0],["كأنّه وهو من مَتْنِ الصّبا مَثَلٌ","من كلّ قُطْرٍ منَ الدنْيا له خَبَرُ",21,"ر",1,0],["كَأَنَّهُ وَالنُفوسُ تَعشَقُهُ","مُرَكَّبٌ مِن مَحاسِنِ الصُوَرِ",22,"ر",1,0],["كَأَنَّ هُوِيَّ الريحِ بَينَ فُروجِها","تَجاوُبُ أَظآرٍ عَلى رُبَعٍ رَدي",23,"د",2,0],["كَأَنَّهُ وَكَأَنَّ الكَأسَ في يَدِهِ","هِلالُ تَمٍّ وَنَجمٌ غابَ في شَفَقِ",24,"ق",1,0],["كأَنَّهُ وَهْوَ فَرْدٌ مِنْ جلالَتِهِ","في عَسْكَرٍ حينَ تَلْقَاهُ وفي حَشَمٍ",25,"م",1,0],["كَأَنَّ هَوانا في العِقابِ وَفي الرِضى","سَرابيلُنا تَنشَقُّ عَنّا وَتَنضَحُ",26,"ح",1,0],["كأنّه والكأسُ في كفِّهِ","بدرُ دُجىً يَسعَى بدرِّيِّ",27,"ي",1,0],["كانَ هَواكَ طَمَعاً","وَاليَومَ أَمسى أَسَفا",28,"ف",2,0],["كَأنَّهُ وَظَلاَمُ اللَّيْل يَكْنٌفُهُ","غُثَاءَةٌ قُذِفَتْ في مَائِجٍ لَجِبِ",29,"ب",1,0],["كَأَنَّهُ وَهُوَ في الكانون مُتَقِدٌ","بَحر مِن المسك لَكن مُوجهُ الذَهَب",30,"ب",1,0],["كأنه وضياء الشمس تنشره","والكفُّ تطويه أذناب الطواويس",31,"س",1,0],["كَأَنَّهُ وَالقَوامُ مُعْتَدِلٌ","وَفي المآقِي مِنْ عِطْرِهِ عَبَقُ",32,"ق",1,0],["كَأَنَّهُ والعُيونُ تَرْمُقُهُ","عَمودُ نورٍ في دارَةِ القَمَرِ",33,"ر",1,0],["كأنه والنباتُ يحصُره","عينٌ بها هُدْبٌ جفنُها محدِق",34,"ق",1,0],["كأنه والذي قد كان يجمعه","طيفٌ تَصوَّر للرائي إذا نَعَسا",35,"س",2,0],["كأنّه وهو فوق الغصن مضطرب","قلب المشوق وقد جدّ الهوى فيه",36,"ي",2,0],["كأنَّه والكأس في كفِّه","متصلاً بالأنمل الخَمسِ",37,"س",1,1],["كأنه وجنة المعشوق حين بدا","وسمته الوصل فاحمرّت من الخجل",38,"ل",1,0],["كأنه وهو كحي طريد","إلى الله مولاه مبدي معيد",39,"د",1,0],["كَأَنَّهُ وَهوَ عَلى كَتفِها","إِسكَندَرُ الأَكبَرُ أَو قَيصرُ",40,"ر",1,0],["كأنّه والكؤوس تَحفِزُه","ظبيٌ رأى خَلْفَه سَلُوقيّا",41,"ي",2,0],["كَأَنَّهُ وَهوَ مِن أَيمَنِ","الثَنِيَّةِ لائِح",42,"ح",1,0],["كَأَنَّهُ وَالشَّمْسُ قَدْ أَوْدَعَتْ","شُعَاعَهَا الأنْضَرَ فِي لُجَّتِهِ",43,"ت",2,0],["كأنه وهو إلى جنبها","سكرةً مع لوزةٍ مرة",44,"ه",1,1],["كأَنَّهُ وَالسُّهَادُ البَرْحُ هِمَّتُهُ","يَخْشَى البَيَاتَ مِنَ الأحْدَاثِ إنْ هَجَعَا",45,"ع",2,0],["كَأَنَّهُ وَالرَّاحُ في كَفِّهِ","شَمسُ الضُحى قابَلَها كَوكَبُ",46,"ب",1,0],["كَأَنَّهُ وَهوَ فَردٌ في جَلالَتِهِ","في عَسكَرٍ حينَ تَلقاهُ وَفي حَشَمِ",47,"م",1,0],["كانةوا يَرَونَ وَغَبرَ الحَربِ قَد عَقَدَت","المَصدَري البيضَ حَمرا بَعدَما وَرَدَت",47,"ت",1,0],["كأنّه والمُلْكُ يَحْتَمِي بهِ","سَديدُ سَهْمٍ في شَديدِ ساعد",48,"د",1,0],["كأَنَّ هَواكُم كانَ لي فيكُم عَذلا","فَلستُ بِراضٍ مِنكُم أبَداً فِعلا",49,"ل",2,1],["كأنه وهو فيهم يومَ باركَهم","شمسٌ تزيد بهاءً وهي في الحمَل",50,"ل",1,0],["كأن هوى الغيد قصر علي","ه فليس سواه له منزلا",51,"ل",2,0],["كأنه وصل من أهواه قد وفدت","به الأماني بلا خوف ولا حذر",52,"ر",1,0],["كأنه والسرو من حوله","مولىً على الوفد عطاً ينثرُ",53,"ر",1,0],["كَأَنَّهُ والمُنى تَسعى إِلَى يَدِهِ","صَبٌّ تَنَسَّمَ من نَحْوِ الحبيبِ صَبا",54,"ب",2,0],["كأنَّه وهو في كفي أقلبه","قميصُ يوسفَ في أجفان يعقوب",55,"ب",1,0],["كأنّه وهو في قضبٍ منعّمة","يلقي النسيم عليها نفس معتنق",56,"ق",1,0],["كأنَّهُ ، وَجَناحُ الوَحي ِ يَحمِلُهُ","نجمٌ يُشَعشِعُ في الظَّلماءِ نَشوانا",57,"ن",2,0],["كَأَنَّهُ واثِقٌ بِأَنَّ لَهُ","عُمراً مُقيماً وَما لَهُ أَجَلُ",58,"ل",1,0],["كَأَنَّهُ وَالهَولُ عَسكَرِيُّ","إِذا تَبارى وَهوَ ضَحضاحِيُّ",59,"ي",1,0],["كأنَّهُ وهْو في الدَّعوى يُعارِضُني","تَلقَّفَ الفِقْهَ عن مولايَ شروانِ",60,"ن",1,0],["كأنَّهُ وَهْوَ في ديوانِ مَنصبِهِ","أبو حنيفةَ في مِحرابِ ديوانِ",60,"ن",1,0],["كأنَّهُ وَسْطَ بُستانٍ يدورُ بهِ","على الثِّمارِ فما يحلو لهُ قَطَفا",61,"ف",2,0],["كان هو الآمر بالتقديم","والأمر منكم كان في المعلوم",62,"م",1,0],["كَأَنَّهُ وَالعُيونُ تَنظُرُهُ","إِذا بَدا زَهرُهُ عَلى القُضُبِ",63,"ب",1,0],["كأنه وضعاف القضب تحمله","أوائل النار في أطراف كبريت",64,"ت",1,0],["كَأَنّهُ وَظَلامُ اللّيلِ مُعتَكِرٌ","يَبدو مُقدّمهُ لِلشَّمسِ في الأُفُقِ",65,"ق",1,0],["كأنه والقلوب تألفه","ألف منها فسر أضعافا",66,"ف",2,0],["كَأَنَّهُ واعِظٌ طالَ الوُقوفُ بِهِ","يُحَدِّثُ الناسَ عَن عادٍ وَعَن إِرَما",67,"م",2,0],["كَأَنَّهُ وَالرُوحُ فِيهِ نَسَمُهْ","هِلالُ تَمْحِيقٍ دَنَا مُدَمِّمُهْ",68,"م",2,0],["كأنه والعلوم الروح في جسد","فليدفن العلم إذ سلت من الجسد",69,"د",1,0],["كأنه وأبا الهادي إذا قرنا","بابا رتاج على أهل النهى قفلا",70,"ل",2,0],["كأنه وعيون الناس ترمقه","سحابة أقلعت عن ممحل جدب",71,"ب",1,0],["كأنه وهو يجري غير مكترثٍ","من بغيه ظالعٌ أو يشتكي نكَبا",72,"ب",2,0],["كَأَنهُ وَهوَ بِهِ كَالأَفكَلِ","مُبَرقَعٌ في كُرسُفٍ لَم يُغزَلِ",73,"ل",1,0],["كأنَّهُ وجهُ معشوقٍ أدلَّ على","عشاقِهِ فابتلاهُ اللهُ بالشَّعَرِ",74,"ر",1,0],["كأنه والظلام ساجٍ","من حلوه آية النهار",75,"ر",1,0],["كأنه والعيون ترمقه","عمود صبحٍ في دازة القمر",76,"ر",1,0],["كَأَنَّهُ وَوُلاةُ العَهدِ تَتبَعُهُ","بَدرُ السَماءِ تَلَتهُ الأَنجُمُ الزُهُرُ",77,"ر",1,1],["كأنه وهو فرد في عجاجتها","ليث يشد على الأبطال في الاجم",78,"م",1,0],["كأنه وهو بالكتّان مختلط","يهود بين نصارى في شعانين",79,"ن",1,0],["كَأَنَّهُ وهُما لا يَثنيانِ لَهُ","أَعطافَ مُنكَفَتي هيجٍ وَإِمجاجِ",80,"ج",1,0],["كَأَنَّهُ وَشَياطينُ المِراحِ بِهِ","قِدحٌ بِكَفّي مُلَقّى الفَوزِ فَلّاجِ",80,"ج",1,0],["كَأَنَّ هَوِيَّها لَمّا اِشمَعَلَّت","هُوِيُّ الطَيرِ تَبتَدِرُ الأَيابا",81,"ب",2,0],["كَأَنَّهُ وَيَدُ الحَسناءِ تَغمِزُهُ","سَيرُ الإِداوَةِ لَمّا مَسَّهُ البَلَلُ",82,"ل",1,0],["كَأَنَّهُ وَهوَ مُفعٍ فَوقَ خُصيَتِهِ","مُسافِرٌ تَحتَهُ خُرجانِ مِن أَدَمِ",83,"م",1,0],["كأنه وهو يعطي كل ذي أملٍ","عن كل ذي كرم في الأرض قدنابا",84,"ب",2,0],["كأنه ورد عليه","قطعة من سبج",85,"ج",1,0],["كأنه وهو خبير به","يكسر الياقوت بالدر",86,"ر",1,0],["كَأَنَّ هَواهُ في الجَماجِمِ وَالطّلى","أَحَلَّ الضّنا في جِسمِهِ فَهوَ نَاحِلُه",87,"ل",2,0],["كأنه وليدة","لاهية باللعب",88,"ب",1,0],["كأنه وكأن الخد وهو به","أضحى النجاشي على كرس من الذهب",89,"ب",1,0],["كأنّهُ والأكفُّ تَنْثُرُهُ","دراهمٌ فَوْقها دَنانيرُ",90,"ر",1,0],["كأنّهُ والأكف تَلْمَسُهُ","خَريطةٌ فُرِّغَتْ مِنَ الكُتْبِ",91,"ب",1,0],["كأنه وجه المعز الذي","تاه به الغرب على المشرق",92,"ق",1,0],["كأنه وهو فَرد من جلاله","في عسكر حين تَلقاه وَفي حَشم",93,"م",1,0],["كأنه وهو فرد من جلالته","يَروع كل كمي في الوَرى رُزم",94,"م",1,0],["كَأَنَّهُ وَهوَ فَرد في جَلالته","مع الوَقار وَطول الصَمت وَالعظم",95,"م",1,0],["كأنه وهو مزدان بصاحبه","زهر النجوم تجلى بينها القمر",96,"ر",1,0],["كأنه والغفرُ ميزان","إمامٍ يحتسب",97,"ب",1,0],["كَأَنَّهُ وَهو في حلٍ وَمُرتَحلٍ","موكِل بِفَضاءِ الاِرضِ يذرعه",98,"ه",1,0],["كأنّه وشعاع الشمس يضحكه","خيلان خدّ معنّى القلب مهجور",99,"ر",1,0],["كَأَنَّهُ وَالمَعالي مِنهُ دانية","مِن جانب المَجد إِن ياذا الهُدى نودي",100,"د",2,0],["كأنه والليل من حوله","وفي ظلام الليل موت