{"poems":[[74,"عتبت ابن الوكيل وشك ظني","https://www.aldiwan.net/poem20310.html","الوافر"],[35,"وقال نساء لسن لي بنواصحن","https://www.aldiwan.net/poem25720.html","الطويل"],[52,"خليلي ما بال الدجى لا تزحزح","https://www.aldiwan.net/poem63979.html","الطويل"],[211,"من مبلغ الأقوام أن محمدا","https://www.aldiwan.net/poem27907.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38389","الطويل"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124459",""],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82874","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200811","البسيط"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95052","البسيط"],[4307,"","https://poetry.dctabudhabi.ae/diwan/poem/31539","الطويل"],[4927,"هَاْتِفُ الْحُبّ","https://www.poetsgate.com/ViewPoem.aspx?id=29732",""],[5186,"\"من \"\"البرج\"\" في كانون والليل خيما","https://www.poetsgate.com/ViewPoem.aspx?id=156441",""],[5219,"الأم مدرسة إذا.......","https://www.poetsgate.com/ViewPoem.aspx?id=194906",""]],"verses":[["وقالَ نواله هيهات يشكو","ذوو الإقتار من عهدِي المتين",0,"ن",1,0],["وَقالَ نِساءٌ لَسنَ لي بِنَواصِحِن","لِيَعلَمنَ ما أُخفي وَيَعلَمنَ ما أُبدي",1,"د",2,1],["وَقالَ نِساءُ الحَيِّ ما لَكَ صافِحاً","وَما كُنتَ عَن أُنسِ الأَوانِسِ تَصفَحُ",2,"ح",1,0],["وَقالَ نَبِيُّ المُؤمِنينَ تَقَدَّموا","وَحُبَّ إِلَينا أَن نَكونَ المُقَدَّما",3,"م",2,0],["وَقالَ نَعَم أَودى خَليفةُ مالِكٍ","وَمالِكُ هَذا العَصرِ مَن لا يسابقُ",4,"ق",1,0],["وقال نديمي ليلةُ القدر هكذا","فقلت وما أدراك ما ليلة القدر",5,"ر",1,0],["وَقالَ نَبِيُّنا فيما رَواهُ","عَنِ الرَّحمنِ في علمِ الغُيوبِ",6,"ب",1,1],["وقال نقدك منه الكيس ممتلئ","فقلت نقدي وصفات الأطباء",7,"ا",2,0],["وقال ناس ان شمعون دفين","في مسجد في حارة السواسين",8,"ن",1,0],["وقال نعم هكطور مكراً أبنته","عن الحرب فارتاعوا لقرع المخافق",9,"ق",1,0],["وقال ناعي النوى ما الأرخ قلت لهُ","آسينُ حازت سنا جنّات باريها",10,"ي",3,0],["وَقالَ نِساءٌ لَو قُتِلتَ لَساءَنا","سِواكُنَّ ذو الشَجوِ الَّذي أَنا فاجِعُ",11,"ع",1,0],["وَقَاْلَ: نَظِّمْ مَسِيْرَاْتٍ يَسِيْرُ بِهَاْ","جَيْشُ الْغَرَاْمِ، وَمَنْ أَشْعَاْرَهْ قَرَضَاْ",12,"ض",2,0],["وقال نساء الحي عدوى فلم تعد","ترى من رجال الحي فردا تقدما",13,"م",2,0],["وقال نبينا صلوات ربي ..","ألا فالزم سبيل الأمهات",14,"ت",1,0]]}