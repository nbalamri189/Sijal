m.aspx?id=186323",""],[4830,"حُلْمُ الشهادة","https://www.poetsgate.com/ViewPoem.aspx?id=212911",""],[4869,"الاماكن","https://www.poetsgate.com/ViewPoem.aspx?id=151573",""],[4875,"موجات الفكر","https://www.poetsgate.com/ViewPoem.aspx?id=133586",""],[4900,"لا بل وجدت عذاباً لا انقطاع له","https://www.poetsgate.com/ViewPoem.aspx?id=181368",""],[4988,"عدت سنيني","https://www.poetsgate.com/ViewPoem.aspx?id=180738",""],[585,"سل الفلك الدوار ما للكواكب","https://www.poetsgate.com/ViewPoem.aspx?id=161941",""],[5206,"حَيَاةُ المُهَج","https://www.poetsgate.com/ViewPoem.aspx?id=187392",""],[4045,"أأحزنك الأولى ردّوا","https://www.poetsgate.com/ViewPoem.aspx?id=200274",""],[5295,"رسالةٌ من حواء","https://www.poetsgate.com/ViewPoem.aspx?id=210738",""],[592,"سلام عليكم أهل ودي وشيعتي","https://www.poetsgate.com/ViewPoem.aspx?id=128854",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[5351,"السراب","https://www.poetsgate.com/ViewPoem.aspx?id=202285",""],[5419,"هي في عيني","https://www.poetsgate.com/ViewPoem.aspx?id=31459",""],[5431,"ولا يبلغ اللذات إلا مناضلُ","https://www.poetsgate.com/ViewPoem.aspx?id=190230",""],[5431,"فديتك...","https://www.poetsgate.com/ViewPoem.aspx?id=196955",""],[5582,"أَحَلَّكَ فِي أَسْرِ الغَرامِ حُلاحِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187218",""],[3469,"أرى جارتي خَفّتْ، وخفّ نَصيحُها","https://www.poetsgate.com/ViewPoem.aspx?id=5339",""],[5953,"أوالي النبي وآل النبي","https://www.poetsgate.com/ViewPoem.aspx?id=93808",""],[5961,"يسير بك المهيمن","https://www.poetsgate.com/ViewPoem.aspx?id=199772",""],[6093,"اللقْطَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=205374",""]],"verses":[["وَمِن زَفرَةٍ تَحتَ الشِغافِ مُقيمَةٍ","إِذَ قُلتُ قَد وَلّى بِها الدَهرُ كَرَّتِ",0,"ت",1,0],["وَمَنزِلٍ بِرداءِ العِزَّ مُتَّشِحٍ","وَقَد رَضيناهُ مُصطافاً وَمُرتَبَعا",1,"ع",2,1],["وَمَنْ زارَهُمْ شَدَّ الحَيازيمَ فِيهِمُ","على ما يعانِيهِ وَإِنْ غَلَبَ الصَّبْرُ",2,"ر",1,0],["ومَنْزِلي أبْلَتِ الأيّامُ جِدَّتَهُ","فشَفّني المُبْلِيانِ الهمُّ والسّهَرُ",3,"ر",1,0],["وَمَنزوعَةٍ مِن فِناءِ اِمرأً","لِمَبرَكِ آخَرَ مُزدادِها",4,"د",3,0],["وَمِن زَهَراتٍ تُنَدّى بِمِسكٍ","وَمِن زَهَراتٍ تُنَدّى بِطَلّ",5,"ل",1,0],["وَمِن زَيدٍ عَلَوتُ عَلَيكَ ظَهراً","جَسيمَ المَجدِ وَالعَدَدَ الكُثارا",6,"ر",2,0],["ومن زاجرٍ كوماءَ مخطفة الحشا","توسَّدَ منها فوق عوجاء مرنانِ",7,"ن",1,0],["ومن زاره مستشفياً زاره الشفا","وإن كان قبلاً يائساً منه نطسه",8,"س",2,0],["ومن زمنٍ بعد ذاك الزمان","عقوق كمثل اسمه عائق",9,"ق",1,0],["ومِن زَراءِ الكثير قطعُكَه","ومن بهاء القليل إدراره",10,"ر",2,0],["وَمَنزِلٍ لَيسَ لَنا بِمَنزِلِ","وَلا لِغَيرِ الغادِياتِ الهُطَّلِ",11,"ل",1,1],["ومن زَفرةٍ نفضتها الضُلو","عُ ترفَضُّ عن مثلِها الأضلعُ",12,"ع",1,0],["وَمَنزِلَةُ الصَبرِ عِندَ البَلاءِ","كَمَنزِلَةِ الشُكرِ عِندَ الهِباتِ",13,"ت",1,0],["ومَنزلٍ إنْ جَفَاه نازِلُه","حَنَّ اشتِياقاً إليه أو نَزَعا",14,"ع",2,0],["ومَنزِلٍ نَزَلتْهُ ابتكارا","مُعاقِراً في ظِلِّه العُقارا",15,"ر",2,1],["ومَنزلٍ يَتحامى أهلَه الخَفَرُ","ويَفْضُلُ البَدْوَ في نَعمائِهِ الحَضَرُ",16,"ر",1,1],["ومنزِلٌ لا تزالُ الدَّهرَ عَقوتُه","جديدةَ الرَّوْضِ جَدَّ الغيثُ أو لَعِبا",17,"ب",2,0],["وَمَنزِلَةٍ خُلِقتُ لَها","جَعَلتُ بِغَيرِها شُغُلي",18,"ل",2,0],["وَمَنزِلِ حَقٍّ لا مُعَرَّجَ دونَهُ","لِكُلِّ امرِئٍ يَوماً إِلَيهِ رَحيلُ",19,"ل",1,0],["وَمَنزِلَةً للتَّصابي خَلَتْ","وَكَانَ بَنُو الظَّرفِ عُمَّارَها",20,"ر",3,0],["وَمِن زَفرَةٍ تُعطي الصَبابَةَ حَقَّها","وَتوري زِنادَ الشَوقِ تَحتَ الحَشا الصَلدِ",21,"د",1,0],["وَمِن زَمَنٍ أَلبَستَنيهِ كَأَنَّهُ","إِذا ذُكِرَت أَيّامُهُ زَمَنُ الوَردِ",21,"د",1,0],["وَمَنْزِلَةٍ لِلأُنْسِ كُنَّا نَحُلُّها","وَنَرْعَى بِهَا اللَّذَّاتِ رَعْيَ السَّوَائِمِ",22,"م",1,0],["ومُنْزِلَ السِوَرِ البتراءِ لاعِنَةً","مَنْ لم يكن قبلها يوماً بملعون",23,"ن",1,0],["ومَن زَعمَ الزُّجاجَ يكون حُجباً","فقد زَعَمَ الشُّموسَ من الخفايا",24,"ا",3,0],["ومَن زَعمَ المذابحَ مُنكَراتٍ","فقد زَعمَ الملائكَ مُجرِمينا",25,"ن",2,0],["وَمَن زَعَمَ الغَوائِلَ غافِلاتٍ","فَقَد ظَلَمَ المَزاعِمَ وَالظُنونا",26,"ن",2,0],["وَمَنزِلَةٍ تَغدو بها الشَمسُ حاسِراً","إِذا ذَرَّ مِنها بِالغَداةِ طُلوعُ",27,"ع",1,0],["وَمَنزِلُ الحَيِّ بِهِ قَد عَفا","إِلّا مَخَطَّ النُؤى وَالمَوقِدِ",28,"د",1,0],["وَمَنزِلَةٍ خُلِقتُ لَها","جَعَلتُ لِغَيرِها شُغُلي",29,"ل",2,0],["وَمَنْزِلُ أُنْسٍ قَدْ عَقَدْنَا بِجَوِّهِ","رَتَائِمَ لَهْوٍ عَقْدُهُنَّ وَثِيقُ",30,"ق",1,0],["وَمَن زانَ العَشيرَةِ وَهوَ طِفلٌ","وَقيلَ كَأَنَّهُ عِلماً سَطيحُ",31,"ح",1,0],["وَمُنزِلِ الضَيفِ إِن هَبَّت مُجَلجِلَةٌ","تَرمي بِصُمٍّ سَريعِ الخَسفِ رَسّافِ",32,"ف",1,0],["ومن زار منهم كاتبًا، خال أنه","وأومأ برأس، أو أشار بحاجب",33,"ب",1,0],["ومنزلي عُشُّ صيداحٍ أقيِمَ على","خضراءَ غارقةٍ في الظل والنور",34,"ر",1,0],["ومن زلتن ..؟ ماتحملها وساع السلوم.","ومن كلمتن ل أفتعالات الغضب.. واقده ..",35,"د",2,0],["ومن زاهد لمّار رأى الصّيد مكثبا","تمزّق عنه الزهد وافتضح المكر",36,"ر",1,0],["ومُنْزل الوحْي علي نبيِّهِ","لأنزلنَّ الشعر من حبيهِ",37,"ب",3,1],["ومنزل حق لا معرج دونه","لكل امرئ منها إليه سبيل",38,"ل",1,0],["ومنزله الأعلى حكى لي روضةً","به الفخر قد أمسى به الفضل قد أرسى",39,"س",2,0],["ومنزلة ما نالها منه غيركم","وأصدق ما استشهدت في حبك القلب",40,"ب",1,0],["ومنزل يسافرا اللحظ به","في قطعه مسافة للقصر",41,"ر",1,0],["ومن زَهَراتِ حظِّكَ في ربيعٍ","ومن ثَمَراتِ لفظكَ في خَريفِ",42,"ف",1,0],["وَمُنزِهاً طَرفي بِرَونَقِ حبرِهِ","لَما تَجلَّى النُورُ ضِمنَ ظَلامِهْ",43,"م",2,0],["ومنزلي مستهدم مقفرٌ","منفرد في وسط المقبره",44,"ر",2,0],["ومن زهر نور الله في روض قلبهِ","حديث لهُ لا اثم فيهِ ولا حقدا",45,"د",2,0],["وَمُنَزَّهٍ عَن مُشبِهٍ في حُسنِهِ","أَصبَحتُ فيهِ عَن السُلُوِّ مُنَزَّها",46,"ه",2,0],["وَمَنزِلٌ في خَيرِ ما جيرَة","قَد عَرَفوا بِالخَيرِ والمَيرِ",47,"ر",1,0],["وَمن زفرةٍ تعتادني إثر زفرةٍ","لها وَهجٌ بين الحيازم ما يهدا",48,"د",2,0],["ومنزوي لكن لحد محدود","والرسول حارس",49,"س",1,0],["ومَنْزِلي حَفَّهُ بَحرانِ دُونَكُمُ","وما ادَّعَيْتُ لَكُمْ مَشْياً على الماءِ",50,"ا",2,0],["وَمُنَزُّهٌ وَمُشَبِّهٌ وَمُوَحِّدٌ","وَمُعَدِّدٌ وَمُقَرِّبٌ وَمُبَعِّدُ",51,"د",1,0],["ومنزلة فيها العَوالي كأنَّها","هَشيمُ شِجارٍ كَسَّرَتها الحواطِبُ",52,"ب",1,0],["ومَنْزِلِ ضَنْكٍ لا أُرِيدُ مَبِيتَهُ","كأنِّي بِهِ من شِدَّةِ الرَّوْعِ آنِسُ",53,"س",1,0],["ومن زائريك الشيقين كليهما","على ربعك السامي أتم سلام",54,"م",1,0],["ومن زوج العجز أم المنى","فلا شك تنتج ابن البلا",55,"ا",1,0],["ومنزِلَةُ الأنسِ الذي فيه أُنسُهم","ويُوحِشُهُ جدِّي وما فيهِ من أُنْس",56,"س",1,0],["وَمن زَرَدٍ قَد طار أَنصافه كَما","تَطاير عَن أَعلى البنان قُلامُها",57,"م",3,0],["ومنزلة بين الفرات ودجلة","إذا لم يكن فيها المشير فناصر",58,"ر",1,0],["ومن زمانِكُم كونوا على حذَرٍ","فطالما بسواكُمْ ويحَكُم غدَرا",59,"ر",2,0],["ومنزلٍ بالجزعِ منهم يَبابْ","كنتُ به مع زينبٍ والرَّباب",60,"ب",1,0],["ومنزلٍ جاورَ الجوزاءَ مرتقياً","كأنّما فيه للنسرينِ أوكارُ",61,"ر",1,1],["ومَنْزِلِ مَفْلُولٍ نَزَلْتَ وخيلُنا","مرابِطُها أَجسادُهُ وجَمَاجِمُهْ",62,"م",2,0],["ومنزل سكنته","أضحى سماء البقعة",63,"ه",1,0],["ومنزل آيات البلاغة والحجى","فها انت طب ما استعان بمرهم",64,"م",1,0],["ومُنزِلي من شُرُفاتِ رأيه","مكانَ ينحطُّ السُهَى وينحدِرْ",65,"ر",1,0],["ومنزلاً سقيتُهُ","دمعاً يُحاكي المَطَرا",66,"ر",2,0],["ومنزلٍ وقَفَتْ هوجٌ الرَّكابِ بهِ","لمّا تضوَّعَ منه نشرُه العَبِقُ",67,"ق",1,0],["ومنزلٍ عجتُ مِن بعدِ الخليطِ ضحًى","عليه أسألُ مِن أطلالِه الرُّسُما",68,"م",2,0],["ومنزلِ لهوٍ مذ وقفتُ بربعِه","عقيبَ نوى سكانِه قارعاً سنّا",69,"ن",2,0],["ومن زهيرة أيضا","وصنوها مختارك",70,"ك",1,0],["ومن زكت بشريف الأصل طينه","فخذه خلّاً ودع أهل الدَنيّات",71,"ت",1,0],["ومن زَوى عن نَفْسهِ","ما أوْهَمَ العَلائقُ",72,"ق",1,0],["ومن زَفيرِ أنيني","للعاشقينَ سماعُ",73,"ع",1,0],["ومَنْ زانتْ وجوهُ النثرِ فيه","وفي تَقريضِهِ حسُنَ النِّظامُ",74,"م",1,0],["ومنزهاً لجماله عن كل ما","يحوي المكان وتجمع الأزمان",75,"ن",1,0],["ومنْزِلِ قينةٍ سَهْلُ الجَنَابِ","تضمَّنَ كُلَّ آنِسَةٍ كَعَابِ",76,"ب",1,1],["ومنزلة أُسُّها في السُّها","تَرى الطرفَ من دونها يَحْسِرُ",77,"ر",1,0],["ومِن زَفَراتِ شَوقٍ في ضُلُوعي","تُقيمُ إذا تَنَفَّسَتِ الضُّلُوعا",78,"ع",2,0],["ومَن زوَّدُوه راحِلا كَفَنَ البِلا","وما زَودُوهُ بلغَةَ المتَزود",79,"د",1,0],["ومنزلة الروح من جنبها","ومنزلة القلب من صدره",80,"ر",2,0],["ومنزه الإحسان من نكد","كالعين ما لم تقبل الحولا",81,"ل",2,0],["وَمِن زاهي ضيا الأَبوين حازَت","بَهاءً قَد تَحلَّى بِالجَلال",82,"ل",1,0],["وَمِن زَخارف أَوزان نظمت بِها","رُكن الخَنا وَالعَنا في سلك أَقيال",83,"ل",1,0],["وَمِن زَهر عَلا قَدراً","عَلى زُهرٍ السَما القُهب",84,"ب",1,0],["وَمَنزِلُ أَحبابي وَمنزِه مقلتي","ومطلعُ أَقماري ومغرب أَفكاري",85,"ر",2,0],["وَمنزلِ أَحبابي وَظِلِّ صحابَتي","ومنزهِ أَترابي وَجُلِّ طلابي",86,"ب",2,0],["ومنزل للعلى كم راش من ملأ","ومنهل للندى كم انقع الغللا",87,"ل",2,0],["وَمَنزِلُهُ في دارِ صِدقٍ وَغِبطَةٍ","وَما قالَ من حُكمٍ عَلَيهِ طَبيبُ",88,"ب",1,0],["ومنزه الاعراض والامث","ال عن شبه الجواهر",89,"ر",1,0],["ومَنْ زادُه التقوى زمانَ حياتهِ","نمتْ معه الأموالُ والماءُ والمرعى",90,"ع",2,0],["وَمَنْ زَعَموا أنْ يَرَوكِ المَسَار","أقَاموا بكُلِّ مَسَارٍ مَتَاهَا",91,"ا",3,0],["ومنزلتي ظمياء من بطن عاقلٍ","وذات السليل كيف حالكما بعدي",92,"د",2,0],["ومن زفرة تعلو على أثر زفرة","لها بين أحناء الضلوع لهيبُ",93,"ب",1,0],["وَمَنزِلَةٍ يا اِبنَ الزُّبَيرِ كَريهَةٍ","شَدَدتُ لَها مِن آخِرِ اللَّيلِ أسرجا",94,"ج",2,0],["وَمَنزِلُنا بِأَزرَقَ كَوثَرِيٍّ","بِمَنزِلِ أَزرَقٍ ما إِن يُجارى",95,"ر",2,0],["وَمَنزلي جَزيرة الصقالبه","مَشهورة في بَلَد المَغارِبَه",96,"ه",1,0],["ومن زرع المعروف فينا وقد قضى","فلا بد ان نوفي بنيه حصاده",97,"د",2,0],["ومن زينب عز البتول بولدها","وعز عليها أن تراهم وزينبا",98,"ب",2,0],["وَمَنزِلُنَا بِأَزرَقَ كَوثرِيٍّ","بِمَنزِل أَزرَقٍ مَا إِن يُجَارَا",99,"ر",2,0],["ومنزَّهٌ ما غبَّرت يَدهُ","تبعاتُ هذي البيض والصفر",100,"ر",1,0],["ومن زواه بكفر عنه سيده","فقد هَوى بهواه نحو سجين",101,"ن",1,0],["وَمِنْ زَفَرَاتٍ لَوْ قَصَدْنَ قَتَلْنني","تَقُضُّ التي تَأتي التي قَدْ تَوَلَّتِ",102,"ت",1,0],["وَمَنزِلَةٌ أُخرى تَقادَمَ عَهدُها","بِذي العُشِّ تَعفوها صَباً وَشَمولُ",103,"ل",1,0],["وَمَنْ زَاحَمَ الأخْطَارَ أحْمَدَ غبَّهَا","فَإمّا لِظَفْرٍ أوْ لِدَفْعِ الْمعَاتِبِ",104,"ب",1,0],["ومن زعم الأشياء ضاعت نفوسها","وتكوينها من جوهرِ النورِ والظلم",105,"م",1,0],["ومن زكاةٍ فرضها واجبٌ","على أولى الأموالِ لم تمنع",106,"ع",1,0],["ومن زقّى الشغاثات","غداءاتٍ وبالعصر",107,"ر",1,0],["ومنْ زُهَيْرٍ ومن غَنْمٍ وإخْوَتِها","ومن حُبيبٍ أصابوا الذُّلَّ فانْفردوا",108,"د",3,0],["ومنزل وفد في التكرم قد علا","ومعرج قدس ساطعات معالمه",109,"م",2,0],["وَمَنزِلَتى إِن شاءَ رَبِّى عَلِيَّةٌ","لَدَيهِ بِمَحض الفَضلِ لاَبإِطاعَةِ",110,"ه",1,0],["ومنزل أقوامٍ إذا ما اغتدوا به","تشابه فيه وغده ورئيسه",111,"س",2,1],["ومنزلٍ بات فيه العود يطربنا","والهمُّ قد فرعنا وهو يرتعدُ",112,"د",1,1],["ومن زمزم فاشرب بما شئت ممعنا","وسمّ وسل ما تبتغي وتزوّد",113,"د",1,0],["ومنزلٍ شاده بدر الكرام لقد","حوى من الحسن ما ضاقت به الصحف",114,"ف",1,1],["ومنزلٍ أخلق من نسجه","كرُّ السَّوافي فيه والشَّدُّ",115,"د",1,0],["ومَنْ زاره يُمسي بروضة جنّةٍ","فزائر ذاك السوح مَا خابَ مَقصَدا",116,"د",2,0],["وَمنزلك المجاز لِكُل عاف","يَؤم لَهُ عَلى أَمل حَقيق",117,"ق",1,0],["ومن زفرة حرّى إذا ما تقطعت","شعاعاً تدّمي الجفن أو تحرق الهدبا",118,"ب",2,0],["وَمَنزِلَةُ الغَفرِ الخفيِّ رقيبُها ال","مُحَنِّثُ إذ رَيّتهُ غَيرَ مُصَدِّقِ",119,"ق",1,0],["ومَنزِلاجي ثمَّ سَعدَه قيلا","تزيدُ عَمَّا شَرَحوا قليلا",120,"ل",2,0],["ومنزلاتُ الشامِ في استِقلالِهَا","لا يحدُرُ الجاهُ ولا يَرقَى لَهَا",121,"ه",2,0],["ومنزلاتُ يا أخي الشامِ","جميعُها في الأرضِ بالتَّمامِ",121,"م",1,0],["ومن زَهْرِهِ سابغاتُ الدورعِ","وبِيضُ الصِّفاحِ وسمر الصِّعادِ",122,"د",1,0],["ومن زيارة أرباب بلا عدد","لا يملكون حياتي لا ولا حيني",123,"ن",2,0],["ومن زاهد لم يف في الدهر مرة","بأمر به رفق ولم يشته التمرا",124,"ر",2,0],["ومَنْزِلٌ عند خير المُنْزِلين لكم","رَحْبُ الذُّرى ومُقامٌ طاهر حَرَم",125,"م",1,0],["ومن زعم المجد الرفيع لنفسه","وما هو في دعوى العلى بمصدق",126,"ق",1,0],["وَمَنزِلُ المزّارِ صفرٌ وقد","عَلَتْهُ من ذُلّتهِ صُفرَه",127,"ر",2,0],["وَمَنْزلٍ حُفَّ بالرِّياضِ فَما","تُعْدَمُ نَوراً به ولا نورا",128,"ر",2,1],["ومن زاهد بالعلم زهداً لو انه","بامواله صلوا عليه وسلموا",129,"م",3,0],["وَمَنزِلُ يَربوعٍ إِذا الضَيفُ آبَهُ","سواءً عَلَيهِ والقِفارُ الأَمالِسُ",130,"س",1,0],["وَمَن زَهِدَ الدينِ القَويمِ رَأَيتَهُ","لِدينِ المَليكِ الحَقّ