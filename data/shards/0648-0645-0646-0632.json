{"poems":[[53,"عذيري من العشرين يغمزن صعدتي","https://www.aldiwan.net/poem30678.html","الطويل"],[63,"ومنزل برداء العز متشح","https://www.aldiwan.net/poem45847.html","البسيط"],[63,"أقول لنفسي وهي تطوى ضلوعها","https://www.aldiwan.net/poem45940.html","الطويل"],[63,"نهج الثناء إلى ناديك مختصر","https://www.aldiwan.net/poem46122.html","البسيط"],[9,"أجدك لم تغتمض ليلة","https://www.aldiwan.net/poem21928.html","المتقارب"],[73,"هي الشمس مغربها في الكلل","https://www.aldiwan.net/poem11950.html","المتقارب"],[30,"نبت عيناك عن طلل بحزوى","https://www.aldiwan.net/poem29591.html","الوافر"],[83,"لعل الصبا إن صافحت روض نعمان","https://www.aldiwan.net/poem54236.html","الطويل"],[88,"أرى الحسن في لبنان أينع غرسه","https://www.aldiwan.net/poem44445.html","الطويل"],[72,"بطيفك يا بدر والطارق","https://www.aldiwan.net/poem19351.html","المتقارب"],[51,"يا من زكا جهره وإسراره","https://www.aldiwan.net/poem62944.html","المنسرح"],[43,"ومنزل ليس لنا بمنزل","https://www.aldiwan.net/poem10111.html","الرجز"],[62,"نجوم العلى فيكم تطلع","https://www.aldiwan.net/poem52356.html","المتقارب"],[45,"أبا حسن إن حسن العزاء","https://www.aldiwan.net/poem62653.html","المتقارب"],[61,"أإن دنا الشوق بعد ما شسعا","https://www.aldiwan.net/poem51574.html","المنسرح"],[61,"ومنزل نزلته ابتكارا","https://www.aldiwan.net/poem51624.html","الرجز"],[61,"ومنزل يتحامى أهله الخفر","https://www.aldiwan.net/poem51628.html","الخفيف"],[61,"حسب الأمير سماح وطد الحسبا","https://www.aldiwan.net/poem51801.html","البسيط"],[49,"سهوت وغرني أملي","https://www.aldiwan.net/poem63063.html","مجزوء الوافر"],[49,"ألا هل إلى طول الحياة سبيل","https://www.aldiwan.net/poem63078.html","البسيط"],[80,"قضت في الصبا النفس أوطارها","https://www.aldiwan.net/poem31465.html","المتقارب"],[44,"شهدت لقد أقوت مغانيكم بعدي","https://www.aldiwan.net/poem30537.html","الطويل"],[87,"ألا حي بالمقياس ريا المعالم","https://www.aldiwan.net/poem8288.html","الطويل"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[105,"لئن ظهرت لنا رغبات قوم","https://www.aldiwan.net/poem42137.html","الوافر"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"أمن عرش الشآم إلى أثينا","https://www.aldiwan.net/poem43065.html","الوافر"],[39,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[40,"يا عاذلي اليوم لا تعذلا","https://www.aldiwan.net/poem42343.html","السريع"],[48,"سهوت وغرني أملي","https://www.aldiwan.net/poem65073.html","مجزوء الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42713","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43686","الوافر"],[10,"","https://poetry.dctabudhabi.ae/diwan/poem/2142","البسيط"],[106,"دواوين","https://www.poetsgate.com/ViewPoem.aspx?id=179554",""],[90,"وحي الرستمية","https://www.poetsgate.com/ViewPoem.aspx?id=179135",""],[51,"ومُنْزل الوحْي علي نبيِّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30760",""],[58,"ألا هل إلى طول الحياة سبيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15571&r=&rc=97",""]],"verses":[["وَمِن زَفرَةٍ تَحتَ الشِغافِ مُقيمَةٍ","إِذَ قُلتُ قَد وَلّى بِها الدَهرُ كَرَّتِ",0,"ت",1,0],["وَمَنزِلٍ بِرداءِ العِزَّ مُتَّشِحٍ","وَقَد رَضيناهُ مُصطافاً وَمُرتَبَعا",1,"ع",2,1],["وَمَنْ زارَهُمْ شَدَّ الحَيازيمَ فِيهِمُ","على ما يعانِيهِ وَإِنْ غَلَبَ الصَّبْرُ",2,"ر",1,0],["ومَنْزِلي أبْلَتِ الأيّامُ جِدَّتَهُ","فشَفّني المُبْلِيانِ الهمُّ والسّهَرُ",3,"ر",1,0],["وَمَنزوعَةٍ مِن فِناءِ اِمرأً","لِمَبرَكِ آخَرَ مُزدادِها",4,"د",3,0],["وَمِن زَهَراتٍ تُنَدّى بِمِسكٍ","وَمِن زَهَراتٍ تُنَدّى بِطَلّ",5,"ل",1,0],["وَمِن زَيدٍ عَلَوتُ عَلَيكَ ظَهراً","جَسيمَ المَجدِ وَالعَدَدَ الكُثارا",6,"ر",2,0],["ومن زاجرٍ كوماءَ مخطفة الحشا","توسَّدَ منها فوق عوجاء مرنانِ",7,"ن",1,0],["ومن زاره مستشفياً زاره الشفا","وإن كان قبلاً يائساً منه نطسه",8,"س",2,0],["ومن زمنٍ بعد ذاك الزمان","عقوق كمثل اسمه عائق",9,"ق",1,0],["ومِن زَراءِ الكثير قطعُكَه","ومن بهاء القليل إدراره",10,"ر",2,0],["وَمَنزِلٍ لَيسَ لَنا بِمَنزِلِ","وَلا لِغَيرِ الغادِياتِ الهُطَّلِ",11,"ل",1,1],["ومن زَفرةٍ نفضتها الضُلو","عُ ترفَضُّ عن مثلِها الأضلعُ",12,"ع",1,0],["وَمَنزِلَةُ الصَبرِ عِندَ البَلاءِ","كَمَنزِلَةِ الشُكرِ عِندَ الهِباتِ",13,"ت",1,0],["ومَنزلٍ إنْ جَفَاه نازِلُه","حَنَّ اشتِياقاً إليه أو نَزَعا",14,"ع",2,0],["ومَنزِلٍ نَزَلتْهُ ابتكارا","مُعاقِراً في ظِلِّه العُقارا",15,"ر",2,1],["ومَنزلٍ يَتحامى أهلَه الخَفَرُ","ويَفْضُلُ البَدْوَ في نَعمائِهِ الحَضَرُ",16,"ر",1,1],["ومنزِلٌ لا تزالُ الدَّهرَ عَقوتُه","جديدةَ الرَّوْضِ جَدَّ الغيثُ أو لَعِبا",17,"ب",2,0],["وَمَنزِلَةٍ خُلِقتُ لَها","جَعَلتُ بِغَيرِها شُغُلي",18,"ل",2,0],["وَمَنزِلِ حَقٍّ لا مُعَرَّجَ دونَهُ","لِكُلِّ امرِئٍ يَوماً إِلَيهِ رَحيلُ",19,"ل",1,0],["وَمَنزِلَةً للتَّصابي خَلَتْ","وَكَانَ بَنُو الظَّرفِ عُمَّارَها",20,"ر",3,0],["وَمِن زَفرَةٍ تُعطي الصَبابَةَ حَقَّها","وَتوري زِنادَ الشَوقِ تَحتَ الحَشا الصَلدِ",21,"د",1,0],["وَمِن زَمَنٍ أَلبَستَنيهِ كَأَنَّهُ","إِذا ذُكِرَت أَيّامُهُ زَمَنُ الوَردِ",21,"د",1,0],["وَمَنْزِلَةٍ لِلأُنْسِ كُنَّا نَحُلُّها","وَنَرْعَى بِهَا اللَّذَّاتِ رَعْيَ السَّوَائِمِ",22,"م",1,0],["ومُنْزِلَ السِوَرِ البتراءِ لاعِنَةً","مَنْ لم يكن قبلها يوماً بملعون",23,"ن",1,0],["ومَن زَعمَ الزُّجاجَ يكون حُجباً","فقد زَعَمَ الشُّموسَ من الخفايا",24,"ا",3,0],["ومَن زَعمَ المذابحَ مُنكَراتٍ","فقد زَعمَ الملائكَ مُجرِمينا",25,"ن",2,0],["وَمَن زَعَمَ الغَوائِلَ غافِلاتٍ","فَقَد ظَلَمَ المَزاعِمَ وَالظُنونا",26,"ن",2,0],["وَمَنزِلَةٍ تَغدو بها الشَمسُ حاسِراً","إِذا ذَرَّ مِنها بِالغَداةِ طُلوعُ",27,"ع",1,0],["وَمَنزِلُ الحَيِّ بِهِ قَد عَفا","إِلّا مَخَطَّ النُؤى وَالمَوقِدِ",28,"د",1,0],["وَمَنزِلَةٍ خُلِقتُ لَها","جَعَلتُ لِغَيرِها شُغُلي",29,"ل",2,0],["وَمَنْزِلُ أُنْسٍ قَدْ عَقَدْنَا بِجَوِّهِ","رَتَائِمَ لَهْوٍ عَقْدُهُنَّ وَثِيقُ",30,"ق",1,0],["وَمَن زانَ العَشيرَةِ وَهوَ طِفلٌ","وَقيلَ كَأَنَّهُ عِلماً سَطيحُ",31,"ح",1,0],["وَمُنزِلِ الضَيفِ إِن هَبَّت مُجَلجِلَةٌ","تَرمي بِصُمٍّ سَريعِ الخَسفِ رَسّافِ",32,"ف",1,0],["ومن زار منهم كاتبًا، خال أنه","وأومأ برأس، أو أشار بحاجب",33,"ب",1,0],["ومنزلي عُشُّ صيداحٍ أقيِمَ على","خضراءَ غارقةٍ في الظل والنور",34,"ر",1,0],["ومُنْزل الوحْي علي نبيِّهِ","لأنزلنَّ الشعر من حبيهِ",35,"ب",3,1],["ومنزل حق لا معرج دونه","لكل امرئ منها إليه سبيل",36,"ل",1,0]]}