{"poems":[[53,"عذيري من العشرين يغمزن صعدتي","https://www.aldiwan.net/poem30678.html","الطويل"],[63,"ومنزل برداء العز متشح","https://www.aldiwan.net/poem45847.html","البسيط"],[63,"أقول لنفسي وهي تطوى ضلوعها","https://www.aldiwan.net/poem45940.html","الطويل"],[63,"نهج الثناء إلى ناديك مختصر","https://www.aldiwan.net/poem46122.html","البسيط"],[9,"أجدك لم تغتمض ليلة","https://www.aldiwan.net/poem21928.html","المتقارب"],[73,"هي الشمس مغربها في الكلل","https://www.aldiwan.net/poem11950.html","المتقارب"],[30,"نبت عيناك عن طلل بحزوى","https://www.aldiwan.net/poem29591.html","الوافر"],[83,"لعل الصبا إن صافحت روض نعمان","https://www.aldiwan.net/poem54236.html","الطويل"],[88,"أرى الحسن في لبنان أينع غرسه","https://www.aldiwan.net/poem44445.html","الطويل"],[72,"بطيفك يا بدر والطارق","https://www.aldiwan.net/poem19351.html","المتقارب"],[51,"يا من زكا جهره وإسراره","https://www.aldiwan.net/poem62944.html","المنسرح"],[43,"ومنزل ليس لنا بمنزل","https://www.aldiwan.net/poem10111.html","الرجز"],[62,"نجوم العلى فيكم تطلع","https://www.aldiwan.net/poem52356.html","المتقارب"],[45,"أبا حسن إن حسن العزاء","https://www.aldiwan.net/poem62653.html","المتقارب"],[61,"أإن دنا الشوق بعد ما شسعا","https://www.aldiwan.net/poem51574.html","المنسرح"],[61,"ومنزل نزلته ابتكارا","https://www.aldiwan.net/poem51624.html","الرجز"],[61,"ومنزل يتحامى أهله الخفر","https://www.aldiwan.net/poem51628.html","الخفيف"],[61,"حسب الأمير سماح وطد الحسبا","https://www.aldiwan.net/poem51801.html","البسيط"],[49,"سهوت وغرني أملي","https://www.aldiwan.net/poem63063.html","مجزوء الوافر"],[49,"ألا هل إلى طول الحياة سبيل","https://www.aldiwan.net/poem63078.html","البسيط"],[80,"قضت في الصبا النفس أوطارها","https://www.aldiwan.net/poem31465.html","المتقارب"],[44,"شهدت لقد أقوت مغانيكم بعدي","https://www.aldiwan.net/poem30537.html","الطويل"],[87,"ألا حي بالمقياس ريا المعالم","https://www.aldiwan.net/poem8288.html","الطويل"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[105,"لئن ظهرت لنا رغبات قوم","https://www.aldiwan.net/poem42137.html","الوافر"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"أمن عرش الشآم إلى أثينا","https://www.aldiwan.net/poem43065.html","الوافر"],[39,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[40,"يا عاذلي اليوم لا تعذلا","https://www.aldiwan.net/poem42343.html","السريع"],[48,"سهوت وغرني أملي","https://www.aldiwan.net/poem65073.html","مجزوء الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42713","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43686","الوافر"],[10,"","https://poetry.dctabudhabi.ae/diwan/poem/2142","البسيط"],[106,"دواوين","https://www.poetsgate.com/ViewPoem.aspx?id=179554",""],[90,"وحي الرستمية","https://www.poetsgate.com/ViewPoem.aspx?id=179135",""],[51,"ومُنْزل الوحْي علي نبيِّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30760",""],[58,"ألا هل إلى طول الحياة سبيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15571&r=&rc=97",""],[145,"أبى القلب أن ينسى المعاهد من برسا","https://www.aldiwan.net/poem47636.html","الطويل"],[158,"هلموا فقد قامت على ساقها الحرب","https://www.aldiwan.net/poem59019.html","الطويل"],[158,"يوم سرور وشفاء صدر","https://www.aldiwan.net/poem59024.html","الرجز"],[164,"أقول له ولم أنفس بنفسي","https://www.aldiwan.net/poem47022.html","الوافر"],[180,"أمقلدا جيدي بعقد نظامه","https://www.aldiwan.net/poem67020.html","الكامل"],[184,"عجبت من قلبي ما أصبره","https://www.aldiwan.net/poem43840.html","السريع"],[197,"مضى والتقى نجمين في أفق جدا","https://www.aldiwan.net/poem45160.html","الطويل"],[280,"دمع هوى سلكاه عن جلد وهى","https://www.aldiwan.net/poem32312.html","الكامل"],[282,"مناي من دنياي هاتي التي","https://www.aldiwan.net/poem44307.html","السريع"],[296,"إذا لم تطق (لمياء) أن تنجز الوعدا","https://www.aldiwan.net/poem36321.html","عموديه"],[302,"يا نسيم الأسحار","https://www.aldiwan.net/poem16906.html","عموديه"],[346,"أنمت طرفي قريرا منك في دعة","https://www.aldiwan.net/poem19833.html","الخفيف"],[347,"لمغيب قلبي في هواكم مشهد","https://www.aldiwan.net/poem15644.html","الكامل"],[363,"فلما هبطنا بطن رنينة بالقنا","https://www.aldiwan.net/poem44537.html","الطويل"],[366,"أمن آل أسماء الطلول الدوارس","https://www.aldiwan.net/poem1873.html","الطويل"],[400,"ولما ظمئنا من حرارة فقدكم","https://www.aldiwan.net/poem33430.html","الطويل"],[400,"أشير وإن كنت لا تقبلا","https://www.aldiwan.net/poem34176.html","المتقارب"],[402,"بأبي أخوة ترحلت عنهم","https://www.aldiwan.net/poem49908.html","الخفيف"],[403,"هل الوجد إلا أن تلوح خيامها","https://www.aldiwan.net/poem50126.html","الطويل"],[413,"تولت من الظلماء تلك الدياجر","https://www.aldiwan.net/poem54031.html","الطويل"],[429,"طوبى لمن ترك اللذات وازدجرا","https://www.aldiwan.net/poem12464.html","البسيط"],[429,"أبعد شيبي لشبابي إياب","https://www.aldiwan.net/poem12559.html","السريع"],[429,"ومنزل جاور الجوزاء مرتقيا","https://www.aldiwan.net/poem12798.html","البسيط"],[436,"تتبين شمل الدين أنك ناظمه","https://www.aldiwan.net/poem34869.html","الطويل"],[441,"بحق من يا منيتي","https://www.aldiwan.net/poem56010.html","عموديه"],[441,"أمعروف قد واسيت قلب المتيم","https://www.aldiwan.net/poem56019.html","عموديه"],[456,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[475,"نوق براهن السرى","https://www.aldiwan.net/poem15219.html","مجزوء الرجز"],[475,"قد خان أهل الهوى قل لي بمن أثق","https://www.aldiwan.net/poem15254.html","البسيط"],[475,"دع عنك ما زخرف الواشي وما زعما","https://www.aldiwan.net/poem15273.html","البسيط"],[475,"ولوع بتذكار الأحبة لا يفنى","https://www.aldiwan.net/poem15292.html","الطويل"],[477,"طلعت فينا هلالا","https://www.aldiwan.net/poem37051.html","المجتث"],[498,"أرح فؤادك من هم الوجودات","https://www.aldiwan.net/poem37713.html","البسيط"],[498,"هذا بروز سابق","https://www.aldiwan.net/poem37947.html","مجزوء الرجز"],[498,"يا بارقا قد تلوى","https://www.aldiwan.net/poem37978.html","المجتث"],[512,"نصال من جفونك أم سهام","https://www.aldiwan.net/poem20794.html","الوافر"],[556,"خذها إليك لها هدى وبيان","https://www.aldiwan.net/poem33803.html","الكامل"],[565,"ومنزل قينة سهل الجناب","https://www.aldiwan.net/poem69805.html","الوافر"],[573,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"]],"verses":[["وَمِن زَفرَةٍ تَحتَ الشِغافِ مُقيمَةٍ","إِذَ قُلتُ قَد وَلّى بِها الدَهرُ كَرَّتِ",0,"ت",1,0],["وَمَنزِلٍ بِرداءِ العِزَّ مُتَّشِحٍ","وَقَد رَضيناهُ مُصطافاً وَمُرتَبَعا",1,"ع",2,1],["وَمَنْ زارَهُمْ شَدَّ الحَيازيمَ فِيهِمُ","على ما يعانِيهِ وَإِنْ غَلَبَ الصَّبْرُ",2,"ر",1,0],["ومَنْزِلي أبْلَتِ الأيّامُ جِدَّتَهُ","فشَفّني المُبْلِيانِ الهمُّ والسّهَرُ",3,"ر",1,0],["وَمَنزوعَةٍ مِن فِناءِ اِمرأً","لِمَبرَكِ آخَرَ مُزدادِها",4,"د",3,0],["وَمِن زَهَراتٍ تُنَدّى بِمِسكٍ","وَمِن زَهَراتٍ تُنَدّى بِطَلّ",5,"ل",1,0],["وَمِن زَيدٍ عَلَوتُ عَلَيكَ ظَهراً","جَسيمَ المَجدِ وَالعَدَدَ الكُثارا",6,"ر",2,0],["ومن زاجرٍ كوماءَ مخطفة الحشا","توسَّدَ منها فوق عوجاء مرنانِ",7,"ن",1,0],["ومن زاره مستشفياً زاره الشفا","وإن كان قبلاً يائساً منه نطسه",8,"س",2,0],["ومن زمنٍ بعد ذاك الزمان","عقوق كمثل اسمه عائق",9,"ق",1,0],["ومِن زَراءِ الكثير قطعُكَه","ومن بهاء القليل إدراره",10,"ر",2,0],["وَمَنزِلٍ لَيسَ لَنا بِمَنزِلِ","وَلا لِغَيرِ الغادِياتِ الهُطَّلِ",11,"ل",1,1],["ومن زَفرةٍ نفضتها الضُلو","عُ ترفَضُّ عن مثلِها الأضلعُ",12,"ع",1,0],["وَمَنزِلَةُ الصَبرِ عِندَ البَلاءِ","كَمَنزِلَةِ الشُكرِ عِندَ الهِباتِ",13,"ت",1,0],["ومَنزلٍ إنْ جَفَاه نازِلُه","حَنَّ اشتِياقاً إليه أو نَزَعا",14,"ع",2,0],["ومَنزِلٍ نَزَلتْهُ ابتكارا","مُعاقِراً في ظِلِّه العُقارا",15,"ر",2,1],["ومَنزلٍ يَتحامى أهلَه الخَفَرُ","ويَفْضُلُ البَدْوَ في نَعمائِهِ الحَضَرُ",16,"ر",1,1],["ومنزِلٌ لا تزالُ الدَّهرَ عَقوتُه","جديدةَ الرَّوْضِ جَدَّ الغيثُ أو لَعِبا",17,"ب",2,0],["وَمَنزِلَةٍ خُلِقتُ لَها","جَعَلتُ بِغَيرِها شُغُلي",18,"ل",2,0],["وَمَنزِلِ حَقٍّ لا مُعَرَّجَ دونَهُ","لِكُلِّ امرِئٍ يَوماً إِلَيهِ رَحيلُ",19,"ل",1,0],["وَمَنزِلَةً للتَّصابي خَلَتْ","وَكَانَ بَنُو الظَّرفِ عُمَّارَها",20,"ر",3,0],["وَمِن زَفرَةٍ تُعطي الصَبابَةَ حَقَّها","وَتوري زِنادَ الشَوقِ تَحتَ الحَشا الصَلدِ",21,"د",1,0],["وَمِن زَمَنٍ أَلبَستَنيهِ كَأَنَّهُ","إِذا ذُكِرَت أَيّامُهُ زَمَنُ الوَردِ",21,"د",1,0],["وَمَنْزِلَةٍ لِلأُنْسِ كُنَّا نَحُلُّها","وَنَرْعَى بِهَا اللَّذَّاتِ رَعْيَ السَّوَائِمِ",22,"م",1,0],["ومُنْزِلَ السِوَرِ البتراءِ لاعِنَةً","مَنْ لم يكن قبلها يوماً بملعون",23,"ن",1,0],["ومَن زَعمَ الزُّجاجَ يكون حُجباً","فقد زَعَمَ الشُّموسَ من الخفايا",24,"ا",3,0],["ومَن زَعمَ المذابحَ مُنكَراتٍ","فقد زَعمَ الملائكَ مُجرِمينا",25,"ن",2,0],["وَمَن زَعَمَ الغَوائِلَ غافِلاتٍ","فَقَد ظَلَمَ المَزاعِمَ وَالظُنونا",26,"ن",2,0],["وَمَنزِلَةٍ تَغدو بها الشَمسُ حاسِراً","إِذا ذَرَّ مِنها بِالغَداةِ طُلوعُ",27,"ع",1,0],["وَمَنزِلُ الحَيِّ بِهِ قَد عَفا","إِلّا مَخَطَّ النُؤى وَالمَوقِدِ",28,"د",1,0],["وَمَنزِلَةٍ خُلِقتُ لَها","جَعَلتُ لِغَيرِها شُغُلي",29,"ل",2,0],["وَمَنْزِلُ أُنْسٍ قَدْ عَقَدْنَا بِجَوِّهِ","رَتَائِمَ لَهْوٍ عَقْدُهُنَّ وَثِيقُ",30,"ق",1,0],["وَمَن زانَ العَشيرَةِ وَهوَ طِفلٌ","وَقيلَ كَأَنَّهُ عِلماً سَطيحُ",31,"ح",1,0],["وَمُنزِلِ الضَيفِ إِن هَبَّت مُجَلجِلَةٌ","تَرمي بِصُمٍّ سَريعِ الخَسفِ رَسّافِ",32,"ف",1,0],["ومن زار منهم كاتبًا، خال أنه","وأومأ برأس، أو أشار بحاجب",33,"ب",1,0],["ومنزلي عُشُّ صيداحٍ أقيِمَ على","خضراءَ غارقةٍ في الظل والنور",34,"ر",1,0],["ومُنْزل الوحْي علي نبيِّهِ","لأنزلنَّ الشعر من حبيهِ",35,"ب",3,1],["ومنزل حق لا معرج دونه","لكل امرئ منها إليه سبيل",36,"ل",1,0],["ومنزله الأعلى حكى لي روضةً","به الفخر قد أمسى به الفضل قد أرسى",37,"س",2,0],["ومنزلة ما نالها منه غيركم","وأصدق ما استشهدت في حبك القلب",38,"ب",1,0],["ومنزل يسافرا اللحظ به","في قطعه مسافة للقصر",39,"ر",1,0],["ومن زَهَراتِ حظِّكَ في ربيعٍ","ومن ثَمَراتِ لفظكَ في خَريفِ",40,"ف",1,0],["وَمُنزِهاً طَرفي بِرَونَقِ حبرِهِ","لَما تَجلَّى النُورُ ضِمنَ ظَلامِهْ",41,"م",2,0],["ومنزلي مستهدم مقفرٌ","منفرد في وسط المقبره",42,"ر",2,0],["ومن زهر نور الله في روض قلبهِ","حديث لهُ لا اثم فيهِ ولا حقدا",43,"د",2,0],["وَمُنَزَّهٍ عَن مُشبِهٍ في حُسنِهِ","أَصبَحتُ فيهِ عَن السُلُوِّ مُنَزَّها",44,"ه",2,0],["وَمَنزِلٌ في خَيرِ ما جيرَة","قَد عَرَفوا بِالخَيرِ والمَيرِ",45,"ر",1,0],["وَمن زفرةٍ تعتادني إثر زفرةٍ","لها وَهجٌ بين الحيازم ما يهدا",46,"د",2,0],["ومنزوي لكن لحد محدود","والرسول حارس",47,"س",1,0],["ومَنْزِلي حَفَّهُ بَحرانِ دُونَكُمُ","وما ادَّعَيْتُ لَكُمْ مَشْياً على الماءِ",48,"ا",2,0],["وَمُنَزُّهٌ وَمُشَبِّهٌ وَمُوَحِّدٌ","وَمُعَدِّدٌ وَمُقَرِّبٌ وَمُبَعِّدُ",49,"د",1,0],["ومنزلة فيها العَوالي كأنَّها","هَشيمُ شِجارٍ كَسَّرَتها الحواطِبُ",50,"ب",1,0],["ومَنْزِلِ ضَنْكٍ لا أُرِيدُ مَبِيتَهُ","كأنِّي بِهِ من شِدَّةِ الرَّوْعِ آنِسُ",51,"س",1,0],["ومن زائريك الشيقين كليهما","على ربعك السامي أتم سلام",52,"م",1,0],["ومن زوج العجز أم المنى","فلا شك تنتج ابن البلا",53,"ا",1,0],["ومنزِلَةُ الأنسِ الذي فيه أُنسُهم","ويُوحِشُهُ جدِّي وما فيهِ من أُنْس",54,"س",1,0],["وَمن زَرَدٍ قَد طار أَنصافه كَما","تَطاير عَن أَعلى البنان قُلامُها",55,"م",3,0],["ومنزلة بين الفرات ودجلة","إذا لم يكن فيها المشير فناصر",56,"ر",1,0],["ومن زمانِكُم كونوا على حذَرٍ","فطالما بسواكُمْ ويحَكُم غدَرا",57,"ر",2,0],["ومنزلٍ بالجزعِ منهم يَبابْ","كنتُ به مع زينبٍ والرَّباب",58,"ب",1,0],["ومنزلٍ جاورَ الجوزاءَ مرتقياً","كأنّما فيه للنسرينِ أوكارُ",59,"ر",1,1],["ومَنْزِلِ مَفْلُولٍ نَزَلْتَ وخيلُنا","مرابِطُها أَجسادُهُ وجَمَاجِمُهْ",60,"م",2,0],["ومنزل سكنته","أضحى سماء البقعة",61,"ه",1,0],["ومنزل آيات البلاغة والحجى","فها انت طب ما استعان بمرهم",62,"م",1,0],["ومُنزِلي من شُرُفاتِ رأيه","مكانَ ينحطُّ السُهَى وينحدِرْ",63,"ر",1,0],["ومنزلاً سقيتُهُ","دمعاً يُحاكي المَطَرا",64,"ر",2,0],["ومنزلٍ وقَفَتْ هوجٌ الرَّكابِ بهِ","لمّا تضوَّعَ منه نشرُه العَبِقُ",65,"ق",1,0],["ومنزلٍ عجتُ مِن بعدِ الخليطِ ضحًى","عليه أسألُ مِن أطلالِه الرُّسُما",66,"م",2,0],["ومنزلِ لهوٍ مذ وقفتُ بربعِه","عقيبَ نوى سكانِه قارعاً سنّا",67,"ن",2,0],["ومن زهيرة أيضا","وصنوها مختارك",68,"ك",1,0],["ومن زكت بشريف الأصل طينه","فخذه خلّاً ودع أهل الدَنيّات",69,"ت",1,0],["ومن زَوى عن نَفْسهِ","ما أوْهَمَ العَلائقُ",70,"ق",1,0],["ومن زَفيرِ أنيني","للعاشقينَ سماعُ",71,"ع",1,0],["ومَنْ زانتْ وجوهُ النثرِ فيه","وفي تَقريضِهِ حسُنَ النِّظامُ",72,"م",1,0],["ومنزهاً لجماله عن كل ما","يحوي المكان وتجمع الأزمان",73,"ن",1,0],["ومنْزِلِ قينةٍ سَهْلُ الجَنَابِ","تضمَّنَ كُلَّ آنِسَةٍ كَعَابِ",74,"ب",1,1],["ومنزلة أُسُّها في السُّها","تَرى الطرفَ من دونها يَحْسِرُ",75,"ر",1,0]]}