"],[6131,"همسُ المَطَر","https://www.poetsgate.com/ViewPoem.aspx?id=189527",""],[6201,"كينونة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87476&r=&rc=0",""],[6212,"طائفية أو فيفية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1624&r=&rc=5",""],[6242,"على شرفة أبريل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87560&r=&rc=7",""],[463,"هل عند عينيك على غربِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59971&r=&rc=27",""],[6268,"سجينُ الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82931&r=&rc=17",""],[2048,"أُسائلُ لبنان عما بقي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=71989&r=&rc=47",""]],"verses":[["أَنا غَرسٌ غَرَستَهُ وَأَجَلُّ ال","غَرسِ ما قَرَّرَت ثَراهُ يَداكا",0,"ك",2,0],["أَنا غَرسُكُم وَالغُصنُ لَدنٌ وَالصِبا","غَضٌّ وَلِلعيسِ القِيادُ الأَطوَعُ",1,"ع",1,0],["إِن أَغمَدوهُ فَلَم تُغمَد فَضائِلُهُ","وَلا نَأى ذِكرُهُ الداني وَقَد نَزَحا",2,"ح",2,0],["أنا غَرْسُ أنْعُمِكَ التي لا تُجتَدى","مَعها السّحائِبُ فهْيَ مِنْها أغْزَرُ",3,"ر",1,0],["إنْ أغْلَقَتْ أبْوابَها أيْدي العِدَى","جَعَلَ الإلهُ سيوفضهُمْ مِفْتاحا",4,"ح",2,0],["أنا غَرْسُ مُلْكِكَ جُدْتَني بنَدَى","كفّيْكَ فاجْنِ الحَمْدَ منْ غَرْسي",5,"س",2,0],["أَنا غَرسٌ في ثَرى العَلياءِ لَو","أَبطَأَت سُقياكَ عَنهُ لَذَبُل",6,"ل",1,0],["إِن أَغتَرِب فَمَواقِعَ الكَرَمِ الَّذي","في الغَربِ شِمتُ بُروقَهُ أَرتادُ",7,"د",1,0],["أنا غِرِّشد شاردات القوافي","أفَلم يُشجكم بها تغريدي",8,"د",2,0],["أَنا غَريبٌ وَحيدٌ","بِكُم يَطولُ اِنفِرادي",9,"د",2,0],["إنّا غدونا على خلال فتىً","كرَّمها رَبُّنا وطهَّرَها",10,"ر",3,0],["أنا غيران ولا زوجة لي","بل على النعمة عند ابن خلفْ",11,"ف",1,1],["أنا غَرْسٌ لراحتيك وأنْتَ الْ","غَيْثُ يَحْيَا بِصَوْبه كلُّ غُصْنِ",12,"ن",1,0],["أَنا غَيثٌ فَإِن وَجدتُكَ حَقلاً","فَأَنا العُشب وَالشَجَر",13,"ر",1,0],["أَنا غادٍ وَرائِحٌ عَنكَ بِالشُك","رِ فَماذا تَرى وَماذا تَقولُ",14,"ل",1,0],["أَنَا غَرْسُهُ والغَرْسُ يَذْ","وي إنْ خَلاَ مِنْ مَائِهِ",15,"ا",3,0],["إنَّ أَغبى النّاسِ في الدُّنيا لَمَنْ","يَذكُرُ الأُولى ويَنْسَى الآخِرهْ",16,"ر",2,0],["إنّا غَضِبنا للأمانةِ فاشهدِي","وتقبَّلي من قومنا الأعذارا",17,"ر",2,0],["إِن أَغِب عَنكَ فَما غابَ شُكرٌ","دَعوَةٌ جاهِدَةٌ وَاِمتِداحا",18,"ح",2,0],["إن أغلقت أبوابها أيدي العدا","جعل الإله سيوفهم مفتاحا",19,"ح",2,0],["أنَا غَادٍ وَرَائحٌ عَنكَ بالشّكْ","رِ، فماذا تَرَى، وَماذا أقُولُ",20,"ل",1,0],["أنا غريبا وحيدا","بكم يطول إِنفرادي",21,"د",2,0],["إنا غضينا للأمانة فاشهدي","وتقبلي من قومنا الأعذارا",22,"ر",2,0],["إن أغاني الأسى وإن حسنت","أرضيةٌ يا نديم فاقتصر",23,"ر",1,0],["إن أغِبْ عنك فاللسانُ بشكرى","غيرُ ناءٍ ولا الفؤادُ بحمدِى",24,"د",2,0],["إِن أَغضَبَت ذا الدينِ ما","طِلَةً فَقَد أَرضَت وَكيلَه",25,"ل",2,0],["انا غرس إسمعيل لكن نبعتي","لم تزك إلا في خلافة أحمد",26,"د",1,0],["أنا غائبٌ والقلبُ عندك حاضرُ","سافرتُ عنك وما الفؤاد مُسافُر",27,"ر",1,1],["أنا غريب والهوى قاتلي","والقلب مملوء من الياسِ",28,"س",1,0],["أنا غنيت وحي حسنك فاسمع","قد يؤاسي الغريب روح الغريب",29,"ب",1,0],["أناغي كتابي كلَّ وقت يمرّ بي","كطير يُناغي عُودَ بانٍ ويمرث",30,"ث",1,0],["أَنا غرس نعمتكم وروض غمامكم","وَنَزيل عزكم المنيع مالا",31,"ل",2,0],["إنِ اغتدَى واحداً فالشّمسُ واحدةٌ","وضَوؤها ملْءَ وجْهِ الأرضِ يَغْشانا",32,"ن",2,0],["أنا غَرْسُ بيتِكمُ الكريمِ بجودكم","يُسقَى وبالمِدَح الغرائبِ يُثْمِر",33,"ر",1,0],["أنا غيظُ كلّ مُناصِبٍ","وأنا السَّبيلُ إلى الجنانِ",34,"ن",1,1],["أنا غُرّةُ التّاجِ المكّل","درةً العِقْد الجُماني",34,"ن",2,0],["إن أغْشَهُمْ قالُوا خَلُوبٌ مَاذِقٌ","أوْ أَجْفُهُم قالُوا عَدوٌّ أَزرقُ",35,"ق",1,0],["أنا غرس نعمتك ارتوت بك أيكتي","بعد الجفوف وقام عندك مَوسمي",36,"م",2,0],["إن أُغلَبِ الحظَّ فلي عَزْفةٌ","بالنفس لم تُقْمَرْ ولم تُغلَبِ",37,"ب",1,0],["أنا غرْسُ والدِك الّذي ثمرَ الثّنا","منهُ جنَتْهُ لكم يدُ النّعْماءِ",38,"ا",2,0],["إنّا غَرِيبانِ ومَنْ يَغْتَرِبْ","تُوسِعُهُ أَيّامُهُ كَرْبا",39,"ب",2,0],["أَنا غرسُ بيتكِ إِن أَرَدْ","تَ فأَظِمه أَو شِئْتَ فاسْقِهْ",40,"ق",2,1],["ان اغلق الباب الزمان امامكم","هذا الحلاحل فاتح ما أغلقا",41,"ق",2,0],["انا غابط من لم يلد او لم يذق","فقد البنين فذاك اهنا الياس",42,"س",1,0],["أنا غَرسُ نِعمَتِكُم ولَستُ بِمُثمِرٍ","إثمارُ عُودي سائرَ الأغراسِ",43,"س",1,0],["أنا غاضب للشعب والوادي فمن","أرضاهما يوماً فقد أرضاني",44,"ن",2,0],["إن أغضبوك فلست منهم غاضباً","إلا لشمل ذاهب ووفاء",45,"ا",2,0],["أنا غَضَبُ العَواصِفِ كمْ أغارتْ","لوافحُها لتثأرَ من لِثامي",46,"م",2,0],["أنا غبْرَةُ الأقدامِ إذ","تمشي بها الشوارعُ",47,"ع",1,0],["انا غصن ولي دعا الخير ماء","كلما ازداد سقيُه أنشاني",48,"ن",2,0],["إن أغب عنه أو أجئ لحماه","فأياديه لا تزال اتجاها",49,"ا",3,0],["إن أغلقت بابها اللئام فلي","بكفه فتح كل مرتتجٍ",50,"ج",1,0],["أنا غادر أن رمت عنها سلوة","يوماً وإن دامت على حالاتها",51,"ت",3,0],["انا غير ذلك الهزار الخلي","المغني على عودك المورق",52,"ق",1,0],["انا غير ذاك الصبيّ الملاقي","بناتك في زهوه الشيق",52,"ق",1,0],["إِن أَغلَقَت عَلى الوَرى مُشكلة","فَك لطيف فكره إِغلاقَها",53,"ق",3,0],["إِن أَغلَقت باباً فقَلبي طائر","وَالجسم ينفذ مِن شُقوق الباب",54,"ب",1,0],["أنا غَرْس نعمتك الشريفة فاسقني","واجنِ المناقب من ِجنان جَناني",55,"ن",2,0],["ان اغنى النفوس أوفر عطفاً","وكذا الفيض لامتلاء الاناء",56,"ا",2,0],["إن أغضّ العيون عنك أفتّح","ألف عين في عالم لن يُحَدّا",57,"د",2,0],["أن أغنى الأنام أنقصهم ما","لاً ومجداً وطارفاً وتليدا",58,"د",2,0],["إن أغب عن طلبي","فشهودي ما كذب",59,"ب",1,0],["انا غُصَين النَقا وَالرَوض فيهِ غِنىً","عني بما قد حوى من رَطب أَفنانِ",60,"ن",1,0],["إِنّا غرسنا المجد قبل أَوانه","ولربَّ حارثة وَنت أَن تغرسا",61,"س",2,0],["أنا غرْسُ أنعُمِكَ التي عمّت ومن","زهْرِ المدائِحِ فيكَ تجْني غَرْسَها",62,"س",3,0],["أنا غَرْسُ نِعمَتِك الذي آدابُه","روضٌ أزاهِرُ مدْحِه لمْ تُقْطَفِ",63,"ف",1,0],["أنا غالٍ في هواكم وأرى","بذل روحي في رضاكم غير غال",64,"ل",1,0],["إن أغمض عينيه الثنتين","فتحت عيني البيلا",65,"ا",1,0],["إن أغض أغض على ذل ومنقصة","وإن أصل لا أجد عونا على النوب",66,"ب",1,0],["إِنِ اِغزُ زُبَيداً أَغزُ قَوماً أَعِزَّةً","مُرَكَّبُهُم في الحَيِّ خَيرُ مُرَكَّبِ",67,"ب",1,0],["أَنا غَرسُ أَنْعُمِكَ الّذي غذَّيْتَهُ","خَطَراتِ عَطفِكَ فَارتَوى وتَهَلَّلا",68,"ل",2,0],["إِنْ أُغمِدَت حَلَّ العَزائِمَ حَلُّها","أَو جُرِّدَت حَرَمَ الكرى إِحرامُها",69,"م",3,0],["ان اغترب للهوى النجدي مطلباً","فان قبلي ابنآء الهوى اغتربوا",70,"ب",3,0],["إنْ أَغبّتْ خَدَماتي","فدعائي ما أَغبّا",71,"ب",2,1],["إِن أَغِب عَن سَوادٍ طرفِكَ إِنَّي","بَينَ جَنبَيكَ في الفُؤادِ أَدوُرُ",72,"ر",1,0],["أَنّا غدونا غثاءَ السَيل واأَسَفي","وَأَن نُعَدّ مَلايينا مَلايينا",73,"ن",2,0],["إن أغضى المعالِجُ عن سقيمٍ","فقد أخْطا به نهجَ السَّداد",74,"د",1,0],["أنا غوث أهل بطانتي ورئيسهم","أنا من رجال لا يخاف جليسهم",75,"م",1,0],["أناغيك شعرًا قصيدًا يغنّي","تعال وكُنّي وفزّ بالوصال",76,"ل",1,0],["أنا غادرتُ أرضيَ لستُ أرجو","قفولا لا أظنّ القلب عائد",77,"د",1,0],["أُناغي عينك الكحلاء غَمزا","سعيدٌ والغرامُ بنا سعيدُ",78,"د",1,0],["أناغي بها خرس النجوم غواية","وذلك أدنى ما يورثه الود",79,"د",1,0],["أنا غصّةُ التاريخِ في حلْقِ الرؤى","لم يرْوِني أحدٌ سوى شفتيّا",80,"ي",2,0],["أنا غابة للصبر أُحرِق قلبها","فجمعتها في أكؤسٍ ترياق",81,"ق",1,0],["أنا غابة حزن تمشي ولا فكرت توقف وين","ولا وش صابني فكرت ولا افكر وش اخطاني",82,"ن",2,0],["أنا غلطانة أصلاً يوم أضفتك","وسوّت لي حظر بعد الإضافه",83,"ف",2,0],["\"أنا غريب المرافي من يعللني\"","ومن يكون لقلبي في الدّنا وطنَا",84,"ن",2,1],["أنا غصن ٍ وأنت اوراق والعاذل خريف وعج","ووش عذر الورق والغصن لا يابس ولا ظامي",85,"م",2,0],["أنا غرس كفك لو تمهَّلُ ساعة","بعسى وليت ولو يؤوب ويخلفُ",86,"ف",1,0],["أنا غصنُ أحزان تشظَّى نَوْرُهُ","ومش الوَنى في عِطْفِهِ، لولاكِ",87,"ك",1,0],["أنا غَرْسُ أسرارٍ تعالى أنْ يُرى","في تربةِ الإفصاحِ والإدراكِ",87,"ك",1,0],["أَنَا غِيابَاتُ أنكيدُو وَلَوْعَتُهِ","وَدَمْعَةٌ فَوْقَ خَدِّ العُشْبِ تَزْدَهِرُ",88,"ر",1,0],["أنا غيمه بلا عنوان","وصار الكل يرضيني",89,"ن",2,0],["إنَّا غريبان ساقَ الظلمُ أدمعنا","إلى فجاجٍ بها يستوحشُ القدرُ",90,"ر",1,0],["أنا غارس الأحلام في يأسٍ بنا","لكنني في ارض حلمك أُصعقُ",91,"ق",1,0],["أنَا غَفْوَةٌ قَدْ تَرَامَتْ هُنَا","أنَا ثَوْرَةٌ فِيْ دَمِ الشاعر ِ",92,"ر",1,0],["أنا غنّيتُ في شِعري","لِزيْدوني الرّوى انساقا",93,"ق",2,0],["إِنْ أَغْدَقَتْ بِالدُّعَاءِ مُهْجَتُهَا","تَسَلْسَلَتْ فِي رَحِيقِهَا الشِّيَمُ",94,"م",1,0],["أنا غريب الديا