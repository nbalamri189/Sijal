{"poems":[[53,"يا أراك الحمى تراني أراكا","https://www.aldiwan.net/poem29922.html","الخفيف"],[53,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[53,"مثال عينيك في الظبي الذي سنحا","https://www.aldiwan.net/poem30655.html","البسيط"],[63,"لك من غليل صبابتي ما أضمر","https://www.aldiwan.net/poem46190.html","الكامل"],[77,"خذها فقد وضح الصباح ولاحا","https://www.aldiwan.net/poem36645.html","الكامل"],[77,"أخجلتني يا مخجل الشمس","https://www.aldiwan.net/poem35880.html","أحذ الكامل"],[73,"هل عهدنا الشمس تعتاد الكلل","https://www.aldiwan.net/poem11918.html","الرمل"],[73,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[88,"أيها القوم مالكم في جمود","https://www.aldiwan.net/poem44819.html","الخفيف"],[64,"أنتم ملكتم فؤادي","https://www.aldiwan.net/poem67654.html","المجتث"],[51,"أشد بأيامنا لتشهرها","https://www.aldiwan.net/poem64036.html","المنسرح"],[51,"أنا غيران ولا زوجة لي","https://www.aldiwan.net/poem65445.html","الرمل"],[51,"أيها السيد الذي جل عن شكري","https://www.aldiwan.net/poem66516.html","الخفيف"],[91,"وقعت نحلة على الأقحوان","https://www.aldiwan.net/poem8795.html","عموديه"],[45,"شاقني بالعراق برق كليل","https://www.aldiwan.net/poem65569.html","الخفيف"],[61,"قل للأمير الماجد السامى","https://www.aldiwan.net/poem51822.html","مجزوء الكامل"],[105,"يا دمنهور ارقبيه موكبا","https://www.aldiwan.net/poem42063.html","الرمل"],[105,"طال التحجب فارفع الأستارا","https://www.aldiwan.net/poem42078.html","الكامل"],[52,"عرف الدار فحيا وناحا","https://www.aldiwan.net/poem27159.html","المديد"],[77,"خذها فقد وضح الصباح ولاحا","https://www.poetsgate.com/ViewPoem.aspx?id=33805",""],[45,"شاقَني بالعِرَاقِ بَرْقٌ كَليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32035",""],[64,"أنتم ملكتم فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=3136",""],[105,"طال التحجب فارفع الأستارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55082&r=&rc=252",""]],"verses":[["أَنا غَرسٌ غَرَستَهُ وَأَجَلُّ ال","غَرسِ ما قَرَّرَت ثَراهُ يَداكا",0,"ك",2,0],["أَنا غَرسُكُم وَالغُصنُ لَدنٌ وَالصِبا","غَضٌّ وَلِلعيسِ القِيادُ الأَطوَعُ",1,"ع",1,0],["إِن أَغمَدوهُ فَلَم تُغمَد فَضائِلُهُ","وَلا نَأى ذِكرُهُ الداني وَقَد نَزَحا",2,"ح",2,0],["أنا غَرْسُ أنْعُمِكَ التي لا تُجتَدى","مَعها السّحائِبُ فهْيَ مِنْها أغْزَرُ",3,"ر",1,0],["إنْ أغْلَقَتْ أبْوابَها أيْدي العِدَى","جَعَلَ الإلهُ سيوفضهُمْ مِفْتاحا",4,"ح",2,0],["أنا غَرْسُ مُلْكِكَ جُدْتَني بنَدَى","كفّيْكَ فاجْنِ الحَمْدَ منْ غَرْسي",5,"س",2,0],["أَنا غَرسٌ في ثَرى العَلياءِ لَو","أَبطَأَت سُقياكَ عَنهُ لَذَبُل",6,"ل",1,0],["إِن أَغتَرِب فَمَواقِعَ الكَرَمِ الَّذي","في الغَربِ شِمتُ بُروقَهُ أَرتادُ",7,"د",1,0],["أنا غِرِّشد شاردات القوافي","أفَلم يُشجكم بها تغريدي",8,"د",2,0],["أَنا غَريبٌ وَحيدٌ","بِكُم يَطولُ اِنفِرادي",9,"ي",1,0],["إنّا غدونا على خلال فتىً","كرَّمها رَبُّنا وطهَّرَها",10,"ر",3,0],["أنا غيران ولا زوجة لي","بل على النعمة عند ابن خلفْ",11,"ف",1,1],["أنا غَرْسٌ لراحتيك وأنْتَ الْ","غَيْثُ يَحْيَا بِصَوْبه كلُّ غُصْنِ",12,"ن",1,0],["أَنا غَيثٌ فَإِن وَجدتُكَ حَقلاً","فَأَنا العُشب وَالشَجَر",13,"ر",1,0],["أَنا غادٍ وَرائِحٌ عَنكَ بِالشُك","رِ فَماذا تَرى وَماذا تَقولُ",14,"ل",1,0],["أَنَا غَرْسُهُ والغَرْسُ يَذْ","وي إنْ خَلاَ مِنْ مَائِهِ",15,"ا",3,0],["إنَّ أَغبى النّاسِ في الدُّنيا لَمَنْ","يَذكُرُ الأُولى ويَنْسَى الآخِرهْ",16,"ر",2,0],["إنّا غَضِبنا للأمانةِ فاشهدِي","وتقبَّلي من قومنا الأعذارا",17,"ر",2,0],["إِن أَغِب عَنكَ فَما غابَ شُكرٌ","دَعوَةٌ جاهِدَةٌ وَاِمتِداحا",18,"ح",2,0],["إن أغلقت أبوابها أيدي العدا","جعل الإله سيوفهم مفتاحا",19,"ح",2,0],["أنَا غَادٍ وَرَائحٌ عَنكَ بالشّكْ","رِ، فماذا تَرَى، وَماذا أقُولُ",20,"ل",1,0],["أنا غريبا وحيدا","بكم يطول إِنفرادي",21,"د",2,0],["إنا غضينا للأمانة فاشهدي","وتقبلي من قومنا الأعذارا",22,"ر",2,0]]}