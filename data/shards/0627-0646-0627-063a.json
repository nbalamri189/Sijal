{"poems":[[53,"يا أراك الحمى تراني أراكا","https://www.aldiwan.net/poem29922.html","الخفيف"],[53,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[53,"مثال عينيك في الظبي الذي سنحا","https://www.aldiwan.net/poem30655.html","البسيط"],[63,"لك من غليل صبابتي ما أضمر","https://www.aldiwan.net/poem46190.html","الكامل"],[77,"خذها فقد وضح الصباح ولاحا","https://www.aldiwan.net/poem36645.html","الكامل"],[77,"أخجلتني يا مخجل الشمس","https://www.aldiwan.net/poem35880.html","أحذ الكامل"],[73,"هل عهدنا الشمس تعتاد الكلل","https://www.aldiwan.net/poem11918.html","الرمل"],[73,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[88,"أيها القوم مالكم في جمود","https://www.aldiwan.net/poem44819.html","الخفيف"],[64,"أنتم ملكتم فؤادي","https://www.aldiwan.net/poem67654.html","المجتث"],[51,"أشد بأيامنا لتشهرها","https://www.aldiwan.net/poem64036.html","المنسرح"],[51,"أنا غيران ولا زوجة لي","https://www.aldiwan.net/poem65445.html","الرمل"],[51,"أيها السيد الذي جل عن شكري","https://www.aldiwan.net/poem66516.html","الخفيف"],[91,"وقعت نحلة على الأقحوان","https://www.aldiwan.net/poem8795.html","عموديه"],[45,"شاقني بالعراق برق كليل","https://www.aldiwan.net/poem65569.html","الخفيف"],[61,"قل للأمير الماجد السامى","https://www.aldiwan.net/poem51822.html","مجزوء الكامل"],[105,"يا دمنهور ارقبيه موكبا","https://www.aldiwan.net/poem42063.html","الرمل"],[105,"طال التحجب فارفع الأستارا","https://www.aldiwan.net/poem42078.html","الكامل"],[52,"عرف الدار فحيا وناحا","https://www.aldiwan.net/poem27159.html","المديد"],[77,"خذها فقد وضح الصباح ولاحا","https://www.poetsgate.com/ViewPoem.aspx?id=33805",""],[45,"شاقَني بالعِرَاقِ بَرْقٌ كَليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32035",""],[64,"أنتم ملكتم فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=3136",""],[105,"طال التحجب فارفع الأستارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55082&r=&rc=252",""],[118,"يا حسن واحسرتا على غرر","https://www.aldiwan.net/poem49263.html","المنسرح"],[140,"النجاء النجاء من أرض نجد","https://www.aldiwan.net/poem58420.html","البسيط"],[141,"يا غابرا وجد الندى","https://www.aldiwan.net/poem11797.html","مجزوء الكامل"],[158,"عندي لوالد أحمد ولأحمد","https://www.aldiwan.net/poem58984.html","الكامل"],[202,"أنا غائب والقلب عندك حاضر","https://www.aldiwan.net/poem53047.html","الكامل"],[202,"سقيتني كأسا فأسكرتني","https://www.aldiwan.net/poem53117.html","السريع"],[209,"صورة منك لو أرادت لقالت","https://www.aldiwan.net/poem46614.html","الخفيف"],[210,"أرى قلمي فوق الصحائف يعبث","https://www.aldiwan.net/poem37902.html","الطويل"],[269,"سامرت ليلك بالغوير فطالا","https://www.aldiwan.net/poem52076.html","الكامل"],[362,"إذا الحمام على الأغصان غنانا","https://www.aldiwan.net/poem60616.html","البسيط"],[362,"قلب المشوق بأن يساعد أجدر","https://www.aldiwan.net/poem60910.html","الكامل"],[399,"أنا غيظ كل مناصب","https://www.aldiwan.net/poem46976.html","مجزوء الكامل"],[406,"يا ابن الألى جمع الفخار لبيتهم","https://www.aldiwan.net/poem32263.html","الكامل"],[456,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[456,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[512,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[527,"اطلع علينا مثل شمس الضحى","https://www.aldiwan.net/poem37510.html","السريع"],[573,"أنا غرس بيتك إن أرد","https://www.aldiwan.net/poem2761.html","مجزوء الكامل"]],"verses":[["أَنا غَرسٌ غَرَستَهُ وَأَجَلُّ ال","غَرسِ ما قَرَّرَت ثَراهُ يَداكا",0,"ك",2,0],["أَنا غَرسُكُم وَالغُصنُ لَدنٌ وَالصِبا","غَضٌّ وَلِلعيسِ القِيادُ الأَطوَعُ",1,"ع",1,0],["إِن أَغمَدوهُ فَلَم تُغمَد فَضائِلُهُ","وَلا نَأى ذِكرُهُ الداني وَقَد نَزَحا",2,"ح",2,0],["أنا غَرْسُ أنْعُمِكَ التي لا تُجتَدى","مَعها السّحائِبُ فهْيَ مِنْها أغْزَرُ",3,"ر",1,0],["إنْ أغْلَقَتْ أبْوابَها أيْدي العِدَى","جَعَلَ الإلهُ سيوفضهُمْ مِفْتاحا",4,"ح",2,0],["أنا غَرْسُ مُلْكِكَ جُدْتَني بنَدَى","كفّيْكَ فاجْنِ الحَمْدَ منْ غَرْسي",5,"س",2,0],["أَنا غَرسٌ في ثَرى العَلياءِ لَو","أَبطَأَت سُقياكَ عَنهُ لَذَبُل",6,"ل",1,0],["إِن أَغتَرِب فَمَواقِعَ الكَرَمِ الَّذي","في الغَربِ شِمتُ بُروقَهُ أَرتادُ",7,"د",1,0],["أنا غِرِّشد شاردات القوافي","أفَلم يُشجكم بها تغريدي",8,"د",2,0],["أَنا غَريبٌ وَحيدٌ","بِكُم يَطولُ اِنفِرادي",9,"ي",1,0],["إنّا غدونا على خلال فتىً","كرَّمها رَبُّنا وطهَّرَها",10,"ر",3,0],["أنا غيران ولا زوجة لي","بل على النعمة عند ابن خلفْ",11,"ف",1,1],["أنا غَرْسٌ لراحتيك وأنْتَ الْ","غَيْثُ يَحْيَا بِصَوْبه كلُّ غُصْنِ",12,"ن",1,0],["أَنا غَيثٌ فَإِن وَجدتُكَ حَقلاً","فَأَنا العُشب وَالشَجَر",13,"ر",1,0],["أَنا غادٍ وَرائِحٌ عَنكَ بِالشُك","رِ فَماذا تَرى وَماذا تَقولُ",14,"ل",1,0],["أَنَا غَرْسُهُ والغَرْسُ يَذْ","وي إنْ خَلاَ مِنْ مَائِهِ",15,"ا",3,0],["إنَّ أَغبى النّاسِ في الدُّنيا لَمَنْ","يَذكُرُ الأُولى ويَنْسَى الآخِرهْ",16,"ر",2,0],["إنّا غَضِبنا للأمانةِ فاشهدِي","وتقبَّلي من قومنا الأعذارا",17,"ر",2,0],["إِن أَغِب عَنكَ فَما غابَ شُكرٌ","دَعوَةٌ جاهِدَةٌ وَاِمتِداحا",18,"ح",2,0],["إن أغلقت أبوابها أيدي العدا","جعل الإله سيوفهم مفتاحا",19,"ح",2,0],["أنَا غَادٍ وَرَائحٌ عَنكَ بالشّكْ","رِ، فماذا تَرَى، وَماذا أقُولُ",20,"ل",1,0],["أنا غريبا وحيدا","بكم يطول إِنفرادي",21,"د",2,0],["إنا غضينا للأمانة فاشهدي","وتقبلي من قومنا الأعذارا",22,"ر",2,0],["إن أغاني الأسى وإن حسنت","أرضيةٌ يا نديم فاقتصر",23,"ر",1,0],["إن أغِبْ عنك فاللسانُ بشكرى","غيرُ ناءٍ ولا الفؤادُ بحمدِى",24,"د",2,0],["إِن أَغضَبَت ذا الدينِ ما","طِلَةً فَقَد أَرضَت وَكيلَه",25,"ل",2,0],["انا غرس إسمعيل لكن نبعتي","لم تزك إلا في خلافة أحمد",26,"د",1,0],["أنا غائبٌ والقلبُ عندك حاضرُ","سافرتُ عنك وما الفؤاد مُسافُر",27,"ر",1,1],["أنا غريب والهوى قاتلي","والقلب مملوء من الياسِ",28,"س",1,0],["أنا غنيت وحي حسنك فاسمع","قد يؤاسي الغريب روح الغريب",29,"ب",1,0],["أناغي كتابي كلَّ وقت يمرّ بي","كطير يُناغي عُودَ بانٍ ويمرث",30,"ث",1,0],["أَنا غرس نعمتكم وروض غمامكم","وَنَزيل عزكم المنيع مالا",31,"ل",2,0],["إنِ اغتدَى واحداً فالشّمسُ واحدةٌ","وضَوؤها ملْءَ وجْهِ الأرضِ يَغْشانا",32,"ن",2,0],["أنا غَرْسُ بيتِكمُ الكريمِ بجودكم","يُسقَى وبالمِدَح الغرائبِ يُثْمِر",33,"ر",1,0],["أنا غيظُ كلّ مُناصِبٍ","وأنا السَّبيلُ إلى الجنانِ",34,"ن",1,1],["أنا غُرّةُ التّاجِ المكّل","درةً العِقْد الجُماني",34,"ي",1,0],["إن أغْشَهُمْ قالُوا خَلُوبٌ مَاذِقٌ","أوْ أَجْفُهُم قالُوا عَدوٌّ أَزرقُ",35,"ق",1,0],["أنا غرس نعمتك ارتوت بك أيكتي","بعد الجفوف وقام عندك مَوسمي",36,"م",2,0],["إن أُغلَبِ الحظَّ فلي عَزْفةٌ","بالنفس لم تُقْمَرْ ولم تُغلَبِ",37,"ب",1,0],["أنا غرْسُ والدِك الّذي ثمرَ الثّنا","منهُ جنَتْهُ لكم يدُ النّعْماءِ",38,"ا",2,0],["إنّا غَرِيبانِ ومَنْ يَغْتَرِبْ","تُوسِعُهُ أَيّامُهُ كَرْبا",39,"ب",2,0],["أَنا غرسُ بيتكِ إِن أَرَدْ","تَ فأَظِمه أَو شِئْتَ فاسْقِهْ",40,"ق",2,1]]}