gate.com/ViewPoem.aspx?id=166736",""],[5190,"الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=68760",""],[5216,"عَبَرْنا لِلْخُلود","https://www.poetsgate.com/ViewPoem.aspx?id=186939",""],[5302,"قد زاد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=201906",""],[5302,"سقاك السيل والمطر","https://www.poetsgate.com/ViewPoem.aspx?id=205342",""],[5358,"همسات القدر","https://www.poetsgate.com/ViewPoem.aspx?id=21894",""],[5508,"أرى بغضي على الجهلاء داءً","https://www.poetsgate.com/ViewPoem.aspx?id=110834",""],[5582,"نَعِيمٌ تَقَضَّى مُسْرِعاً فِي انْفِلاتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=186755",""],[5720,"لَذَّة الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=209147",""],[5725,"حلب","https://www.poetsgate.com/ViewPoem.aspx?id=180536",""],[5784,"أرى بعض الناس","https://www.poetsgate.com/ViewPoem.aspx?id=196948",""],[5913,"تغنى الكون","https://www.poetsgate.com/ViewPoem.aspx?id=177072",""],[6093,"إذا ما رشَّحت ْشخصي زُبيد ( الوافر )","https://www.poetsgate.com/ViewPoem.aspx?id=180312",""],[6102,"شَظايا خَزَف ..","https://www.poetsgate.com/ViewPoem.aspx?id=184420",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[6189,"خميرة الممكنات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83561&r=&rc=28",""]],"verses":[["أَرى بَدراً أَضاءَ بِعِقبِ شَمسٍ","مُبارَكَةِ الطُلوعِ عَلى القِرانِ",0,"ن",1,0],["أَرى بارِقاً لَم يُروِني وَهوَ حاضِرٌ","فَكَيفَ أُرَجّي رَيَّهُ وَهوَ شاسِعُ",1,"ع",1,0],["أَرى بَعدَ وِردِ الماءِ في القَلبِ غُلَّةً","إِلَيكَ عَلى أَنّي مِنَ الماءِ ناقِعُ",2,"ع",1,0],["أَرى بَغدادَ قَد أَخنى عَليها","وَصَبَّحَها بِغارَتِهِ الجَليدُ",3,"د",1,1],["أَرى بَينَ نيلِ العِزِّ وَالذُلِّ ساعَةً","مِنَ الطَعنِ تَقتادُ الوَشيجَ المُقَصَّدا",4,"د",2,0],["أَرى بُردَ العَفافِ أَغَضَّ حُسناً","عَلى رَجُلٍ مِنَ البُردِ القَشيبِ",5,"ب",1,0],["أَرى بَيتَ لُبنى أَصبَحَ اليَومَ يُهجَرُ","وَهُجرانُ لُبنى يا لَكَ الخَيرُ مُنكَرُ",6,"ر",1,1],["أَرى بَني مِصرَ تَحتَ اللَيلِ قَد نَسَلوا","إِلى سُعودٍ بِهِ ضاحٍ مُحَيّاهُ",7,"ا",2,0],["أرى بسمات للقاء تألقت","على كل وجهٍ كان بالبعد مكمدا",8,"د",2,0],["أَرَى بَيْنَكُمْ آمَالَ خَيْرٍ طَوَالِعاً","تَهُلُّ وَرَاءَ الأُفْقِ وَاللَّيْلُ مُظْلِمُ",9,"م",1,0],["أرى بعد نوم طال في الشرق يقظة","نهوضيّةٌ فيها طموح إلى المجد",10,"د",1,1],["أرى بغداد من بعد أغبرار","زهت بقدوم شاعرها الزهاوي",11,"ي",1,1],["أُرِيبُ رِجَالاً منهم وتُرِيبُني","خَلاَئقُ مِمَّا أَحدَثُوا هُنَّ أَريَبُ",12,"ب",1,0],["أريباً في مآربه أديباً","لبيباً في مخاطبه حصيفا",13,"ف",2,0],["أرى بَقَر الإنس مِنِّي تُرا","عُ أطْيَشَ ما كنتُ عنها سهاما",14,"م",2,1],["أَرى بِهِ وَهوَ الطوفانِ مُختَبِئٌ","طوفانَ غَيظٍ تَوارى خَلفَ طوفانِ",15,"ن",1,0],["أرى بعدَكم طرفَ المكارم خاشعاً","وخَدَّ المعالي أربدَ اللونِ أضرعَا",16,"ع",2,0],["أَرى بِكَ اللَهُ نَكالاً فَكَم","أَرَيتَنا مِن فِعلَةٍ فاضِحَه",17,"ح",2,1],["أَرى بَينَ مُلتَفِّ الأَراكِ مَنازِلا","مَواثِلَ لَو كانَت مَهاها مَواثِلا",18,"ل",2,1],["أَرى بَذلَها عِندَ إِعوازِها","سِوى بَذلِها عِندَ إِمكانِها",19,"ن",3,0],["أرى بلداً يشكو منَ الماءِ مثلَ ما","شَكا الغِمْدُ من حَدِّ الحُسامِ المُهَنَّد",20,"د",1,0],["أرى بَلَدي قد سامَهُ الرومُ ذلّةً","وكانَ بِقَومي عِزُّهُ مُتَقاعِسَا",21,"س",2,0],["أَرَى بِهِمْ وَحْشَةً إِذَا حَضَرُوا","وَطِيبَ أُنْسٍ إِذَا هُمُ ظَعَنُوا",22,"ن",3,0],["أَرى بِهِمِ النُجومَ وَلا ظَلامٌ","وَأَوضاحَ النَهارِ وَلا صَباحُ",23,"ح",1,0],["أَرى بِمِصرَ وُلاةً لا خَلاقَ لَهُم","بِئسَ الوُلاةُ وَبِئسَ الناسُ وَالزَمَنُ",24,"ن",1,1],["أرى بينَها للعاشقين مَصارعاً","فقد ضرّجَتْهُنَّ الدّماءُ السّوافك",25,"ك",1,0],["أَرى بَشَراً عُقولُهُم ضِعافٌ","أَزالوها لِتُعدَمَ بِالخُمورِ",26,"ر",1,1],["أَرَى بَسَمَاتٍ لِلِّقاءِ تَأْلَّقَتْ","عَلَى كُلِّ وَجْهٍ كَانَ إِذْ غِبْتِ مُكْمَدا",27,"د",2,0],["أرى بعَيْنِ خَيالي جاهِليَّتكُمْ","ولِلتَّخيُّلِ عَيْنُ القَائِفِ الدَّربِ",28,"ب",1,0],["أرَى بِهِمَا عَذَابَاً كُلَّ يَوْمٍ","لِخَثْعَمَ أوْ بَجِيلَةَ أَوْ ثُمَالَهْ",29,"ل",2,0],["أرى بَسمةَ الفجرِ مثلَ البُكاء","وَشدْوَ البَلابل كالمَنْعب!",30,"ب",1,0],["أرى بخيال السّحب  خطو محمد","على مخصب من بيدها وجديب",31,"ب",1,0],["ارى باب رزقي من بعيد مفتحاً","فآتية ولاّجاً فألفيه مُرتجا",32,"ج",2,0],["أرى بيتكم منى قريباً وتارة","أراه وأدنى منه أبنية السند",33,"د",1,0],["أرى بلبل الأفكار في روض حسنه","يردد أشعاري على غصن قدّه",34,"ه",1,0],["أرى بسماتِ الصبحِ تبدو على الرُّبى","فهل حانَ أن أحني جبيني مودّعا",35,"ع",2,0],["أرى بَرق الغوير اذا تراءى","بأقصى الشام زوّدني بكاء",36,"ا",2,1],["أَرى بَذلَ روحي في هَواكُمُ فَريضَةٌ","وَبُخلي بِها في حُبِّكُم غَيرَ جائِزِ",37,"ز",1,0],["أرى بعين خيال الشعر من طرف","ما لا يرى عابد الدينار والمال",38,"ل",1,0],["أرى بعيني أشباحاً مجنحة","في الليل أجنحة تبدو كأذيال",38,"ل",1,0],["أَرَى بَصَرِي وَإنْ أَضحَى صَحِيحاً","لَهُ فِيما أَرَى نَظَراتِ أَرْمَدْ",39,"د",1,0],["أَريب حازَ فِكراً ألمَعيّا","وَذاكرةً أحدَّ مِن الحسامِ",40,"م",1,0],["أرى بينَ أيّامي وشَعْرِيَ قد بدا","لتَعْجيلِ إبلائي خِلافٌ مُجَدّد",41,"د",1,0],["أرى بَرقَ مَوآها صدوقاً وقلبه","شفوقاً وقلب البرقِ ليس بقاسِ",42,"س",1,0],["أَرى بِدَعاً مُستَحدَثاتٍ تُريبُني","يَجوزُ بِها مُستَضعَفٌ وَحَليمُها",43,"م",3,0],["أرى بَصَري يَعْيا ويبطُؤُ فِعلُهُ","إذا لم يُنَفِّذْهُ شُعاعٌ سَماوِيُّ",44,"ي",1,1],["أرى بدراً فصار به هلالا","نحيلاً بعد ما نظر الكمالا",45,"ل",2,1],["أرى بعين الروح ما","يسكرني من دهشة",46,"ه",1,0],["أرى بكِ ما أراه فمستعيرٌ","حشاي وواجدٌ بالبين وجدي",47,"د",2,0],["أرى بَقايا البيوتِ قاطبَةً","ما فتئت بالقديمِ مُفْتخرهً",48,"ر",2,1],["أرى بِها كبرياءَ الكَونِ أجمَعِهِ","بَيْنا أُ ُحِسُّ بِشَيءٍ دافِيءٍ يَكِفُ",49,"ف",1,0],["أُرى بَغيضاً إِذا تَمَنَّتْ","عَينايَ أَن تُبصِرَ الحَبيبا",50,"ب",2,0],["أَرى بَهجَةَ الدُنيا رَجيعَ دَوائِرٍ","لَهُنَّ اِجتِماعٌ مَرَّةً وَشَتاتُ",51,"ت",1,0],["أرَى بينَنا شُمَّ الجِبالِ وفوقَها","جبالٌ منَ الأشوَاقِ سابغةُ الظِلِّ",52,"ل",1,0],["أَرَى بِكَ مَا أَرَاهُ بِذِي انْتِشَاءٍ","أَلَحَّ عَلَيْهِ بِالْكَأسِ الجَلِيْسُ",53,"س",1,0],["اَرى بِكَ مِن نَكَدي وَصَبري عَجائِباً","وَاِعجَب مِن حالي وَحالِكَ أَعجَبُ",54,"ب",1,0],["أرى بعيني ما لا تستطيل يدي","له وقد حازه من قدره دوني",55,"ن",2,0],["أرى بشراً تسعى طوالا جسومهم","ذوي همم دون العلاء قصار",56,"ر",1,0],["أرى بطلاً في خلقها غادةَ الحمى","وإن أشبهتْ في خَلقها البدرَ والغصنا",57,"ن",2,0],["أرى بينها خلفاً أمام تراثكم","وأسلابِكم يستجمعُ الشرَّ شاملا",58,"ل",2,0],["أرى بعدك الزوراء يابن زعيمها","قد ازور منها كل ناد ومربع",59,"ع",1,0],["أَريب خَطيب مصقَع وَقَريضه","عَديمٌ لَه بَينَ القَريضِ المجانسُ",60,"س",1,0],["أريبة من بنات الغيد وارثةً","من والديها أموناً غيرَ مِذْعار",61,"ر",1,0],["أرى بارقا بالأبلق الفرد يومض","يذهّبُ جلباب الدجى ويفضض",62,"ض",1,1],["أرى بطريق الفعل في كل لحظة","وجود يقين من وجودك في سر",63,"ر",1,0],["أريبٌ زانه من فخ","رهِ تاجٌ وإكليلُ",64,"ل",1,0],["أَريب يرى ماء الحياءِ ممازجاً","بماء الشباب الغضّ في قسماتهِ",65,"ت",2,0],["أَريب مِن لباسِ الحمد كاسٍ","حسيب من لباسِ العارِ عارِ",66,"ر",1,0],["أَرى بِحِماكَ وَجهَ السَعدِ يَزهو","وَآمالي بِرُؤيَتِهِ تشادُ",67,"د",1,0],["أَرى بِكَ حُبَّ خَيرِ الناس طَبعاً","وَمِثلُكَ مَن تَلوذُ بِهِ الرِجالُ",68,"ل",1,0],["أَرى بعدك الاخوانَ أَبناءَ عَلّة","لهم نسب في ودّهم لا أُناسِبُه",69,"ب",2,0],["أَرَى بارِقاً بالأَبْرَقِ الْفَرْدِ يُومِضُ","يُذَهِّبُ ما بَيْنَ الدُّجى وَيُفَضِّضُ",70,"ض",1,1],["أَرَى بَعْضَ مَنْ أَنْتَ صَيَّرْتَهُ","مِنَ النَّاسِ يَعْرُوكَ تَعْييرُهُ",71,"ر",2,1],["أَرَى بَذْلَهُ النُّعْمَى فَفُضَّتْ مَكَاسِبٌ","أَرَى بَأْسَهُ الأَنْضَى فَفُضِّتْ كَتَائِبُ",72,"ب",1,0],["أَرى بارِقاً نَحوَ الحِجازِ تَطَلَّعا","تَحَدَّر في شَرقِيّها وَتَرَفَّعا",73,"ع",2,1],["أرى بوجهكِ بَدراً جلَّ صانِعُه","لو حَلَّ بالأُفقِ لَم يُظلِم علَى أحَدِ",74,"د",1,0],["اِريب اِذا شاوَرت في كُل مُشكل","اِديب يَسوء الحاسِدينَ بَقاؤُه",75,"ا",3,0],["أرى بدرين قد طلعا","على غصنين في نسق",76,"ق",1,1],["أرى بلايا ودهري","سوى البلا لا يُريني",77,"ن",2,0],["ارى بشرع الهوى شيئاً يقابله","فكم وجدت بوصلٍ منك لي نعما",78,"ا",1,0],["أَرى بَصري قَد رابَني بَعدَ حِدَّةٍ","وَحَسبُك داء أَن تصحَّ وَتَسلَما",79,"م",2,0],["أرى بينها الأجيال شتى وجوهها","فمبتهج هذا وذا متجهم",80,"م",1,0],["أرى بعينيك نور الفجر منبثقاً","والحب منبعثاً والعمر مقتبلا",81,"ل",2,0],["أَرى بِلادي بِها لِلقَوم سَيطَرةٌ","فَفي مَ قامَت بِها ه