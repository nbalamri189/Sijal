{"poems":[[88,"وقف الخلق ينظرون جميعاً","https://www.aldiwan.net/poem10675.html","الخفيف"],[23,"إن الصنيعة لا تكون صنيعة","https://www.aldiwan.net/poem21594.html","الكامل"],[53,"لا تسقرط يا أبا يحيى","https://www.aldiwan.net/poem64536.html","مجزوء الرمل"],[94,"أي ناس هذا الورى ما رأى","https://www.aldiwan.net/poem38889.html","الخفيف"],[94,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[87,"ضربوا القباب على اليباب","https://www.aldiwan.net/poem62925.html","مجزوء الكامل"],[64,"الأرض أم برة","https://www.aldiwan.net/poem52234.html","مجزوء الكامل"],[51,"يسلم المرء أخوه","https://www.aldiwan.net/poem63192.html","مجزوء الرمل"],[68,"دبت عقارب صدغه في خده","https://www.aldiwan.net/poem41362.html","الكامل"],[104,"بيض الحمائم حسبهنه","https://www.aldiwan.net/poem33133.html","مجزوء الكامل"],[50,"رب ليل قطعته بانتحاب","https://www.aldiwan.net/poem10793.html","الخفيف"],[50,"باكر اليوم الصبوحا","https://www.aldiwan.net/poem62517.html","مجزوء الرمل"],[52,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54658","الرمل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/23852","الكامل"],[101,"أنا يا صديقتي متعب بعروبتي","https://www.poetsgate.com/ViewPoem.aspx?id=24608",""],[189,"يا خليلي الهوى برح بي","https://www.aldiwan.net/poem14115.html","الرمل"],[242,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[242,"هاك لغزا فيما يصير لغزل","https://www.aldiwan.net/poem19068.html","الخفيف"],[242,"نلنا ولولا الحب ما نلناها","https://www.aldiwan.net/poem19725.html","الكامل"],[261,"قالت وقد كشف الوداع","https://www.aldiwan.net/poem48368.html","مجزوء الكامل"],[266,"جرب الناس مرارا","https://www.aldiwan.net/poem38187.html","مجزوء الرمل"],[285,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[327,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[327,"ذرفت عيني دموعا","https://www.aldiwan.net/poem56351.html","مجزوء الرمل"],[376,"سر فما يلقاك في","https://www.aldiwan.net/poem57521.html","مجزوء الرمل"],[416,"هاجت هواك بواكر الأظعان","https://www.aldiwan.net/poem67466.html","الكامل"],[466,"أنت نجم الدين في أهل التقى","https://www.aldiwan.net/poem16227.html","الرمل"],[473,"أيهذا الصديق لا عتب إن لم","https://www.aldiwan.net/poem60241.html","الخفيف"],[543,"نلت عطفي وحناني","https://www.aldiwan.net/poem47925.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138219",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38390","الرمل"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34764","الرمل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70841","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62516","الرمل"],[1122,"","https://poetry.dctabudhabi.ae/diwan/poem/98098","الرمل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48959","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48911","الخفيف"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111838","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78007","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127963","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100992","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53076","الرمل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205436","الخفيف"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134007","الرمل"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140293",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132781","الخفيف"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206152","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135568","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125874","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119620","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83359","الخفيف"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101933","الرمل"],[5057,"الخطوة الأولى","https://www.poetsgate.com/ViewPoem.aspx?id=197231",""],[5185,"الوحدة","https://www.poetsgate.com/ViewPoem.aspx?id=70900",""],[5211,"بيْضاءُ يا أخْتَ الجِنانِ","https://www.poetsgate.com/ViewPoem.aspx?id=176157",""],[5311,"إن الصنيعة لا تكون صنيعة","https://www.poetsgate.com/ViewPoem.aspx?id=82842",""],[5409,"ماذا الوقوف بموطنٍ متنكرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155295",""],[5409,"لم تنجب الأيام إلا","https://www.poetsgate.com/ViewPoem.aspx?id=155495",""],[5493,"فيمَ السؤالُ","https://www.poetsgate.com/ViewPoem.aspx?id=211622",""],[5538,"هب النسيم على محب ناءي","https://www.poetsgate.com/ViewPoem.aspx?id=142626",""],[2599,"فى وداع شوقى","https://www.poetsgate.com/ViewPoem.aspx?id=14004",""],[6068,"دوما يجول خيالها في صفحتي -03-","https://www.poetsgate.com/ViewPoem.aspx?id=175816",""],[242,"يا حسنه والحسن قيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563695",""]],"verses":[["فَإِذا صَيقَلُ القَضاءِ جَلاها","كُنَّ كَالمَوتِ ما لَهُ مِن مَرَدِّ",0,"د",1,0],["فَإِذا صَنَعتَ صَنيعَةً فَاِعمَل بِها","لِلَّهِ أَو لِذَوي القَرابَةِ أَو دَعِ",1,"ع",1,0],["فإذا صادفتَ طيزاً","فدع الجبن وناجز",2,"ز",1,0],["فإذا صانَتِ الفَضيلَةَ عابو","ها وإنْ باعتِ الخَنَا عبدوها",3,"ا",1,0],["فإذا صَرَخْتَ توجُّعاً","هَزَأَتْ بصَرْخَتِكَ الدُّهُورْ",4,"ر",1,0],["فَإِذا صَحَوا وَتَنَبَّهوا","فَاللَهُ أَعلَمُ بِالمَآبِ",5,"ب",1,0],["فإذا صغت لك فضه","فالتبر فيها يزرعُ",6,"ع",1,0],["فَإِذا صَلّوا عَلَيهِ","قيلَ هاتوا وَاقبِروهُ",7,"و",2,0],["فَإِذا صَغيرُهُمُ أَتى مُتَخَضِّباً","بِدَمِ الفَوارِسِ قيلَ بالِغُ رُشدِهِ",8,"د",2,0],["فإذا صلاهنَّ الهجي","ر هببْنَ نحو غدير هنَّه",9,"ن",2,0],["فَإِذا صارَ صَكُّ رِقِّكَ فيهِم","خَتَموهُ بِخاتَمِ الأَوصابِ",10,"ب",1,0],["فَإِذا صادَفتَ مِنها","نَفحَةً خِلتَ نَضوحا",11,"ح",2,0],["فَإِذا صَوَّتَ الصَدى أَو دَعا الأَخ","بَلُ طارَت كَالخاضِبِ المَذعورِ",12,"ر",1,0],["فإذا صح أنه كغرار ال","سيفِ أو شعرةٍ فكيف العبور",13,"ر",1,0],["فَإِذَا صامَ الفَتَى مِنْهُمْ فَعَنْ","دَمِ أَسْرَاهُ وَإِنْ لَمْ تُغْفَ شَاةُ",14,"ه",1,0],["فإذا صدحتَ مؤذناً","كادت تموتُ الأنفس",15,"س",1,0],["فاذا صرخت بوجه من أحببتهم","فلكي يعيش الحب والاحباب",16,"ب",1,0],["فإذا صافحَ أَرْدانَ الرُّبا","أَرِجتْ من ذيله المُنسحِب",17,"ب",1,0],["فَإِذَا صَحَا مِنْهَا بِهَا","طَرَقَتْهُ لِذَاتِهَا فَعَرْبَدْ",18,"د",1,0],["فَإِذَا صُحِّفَ الْمُقَدَّمُ مِنْ ذَا","فَهْوَ عِزٌّ يَا عِزَّ مَنْ حَازَ نُبْلاَ",19,"ل",2,0],["فَإِذَا صَحَوْتُ فَمَا صَحَوْتُ عَنِ الْعُلاَ","وَإِذَا سَكِرْتُ فَمَا سَكِرْتُ سَفَاهَا",20,"ا",3,0],["فإذا صبرت ضرورةً","صبر الوقيذ على الوسن",21,"ن",1,0],["فإذا صافيت ندبا","كنت ندبا وهماما",22,"م",2,0],["فَإِذا صَبَرْتُ فقَدْتُ مِثْلِيَ صابِراً","وإِذا بَكَيْتُ وَجَدْتُ مَنْ يَبْكي مَعي",23,"ي",1,0],["فَإِذا صارَ كَالبَلِيَّةِ قَحماً","هُوَ مَرُّ الأَيّامِ بَعدَ اللَيالي",24,"ل",2,0],["فَإِذا صِرتَ إِلَيهِم","صِرتَ في خَيرِ مَصيرِ",25,"ر",1,0],["فإذا صِرتَ بصورٍ","آمناً من كلِّ رعبِ",26,"ب",1,0],["فَإِذا صَنَعتَ صَنيعَةً أَتمَمتَها","وَرَبَيتَها بِفَوائِدِ الإِحسانِ",27,"ن",1,0],["فإذا صَرَّحَ مَحْلٌ عارِقٌ","كُنتَ يا يزْدَنُ نجماً لِلْمَطَرْ",28,"ر",1,0],["فَإِذا صارَ مَن أَقَمتُ عَلَيهِ","لَيسَ يَهتَزُّ لي وَلا لِوُرودي",29,"د",2,0],["فإذا صُغتُ قَريضاً","فَقَوافٍ كَالجُمانِ",30,"ن",1,0],["فإذا صبرت فقد ظفرت بمنتهى","ما تبتغي والصبر مفتاح الفرج",31,"ج",1,0],["فَإِذا صِرتَ نَزيلاً في الحِمَى","نِلتَ ما فيهِ سُرورُ الأَنفُسِ",32,"س",1,0],["فَإِذا صاروا إِلى المَأوى بِها","أَعمَلوا الآجُرَّ فيها وَالخَزَف",33,"ف",1,0],["فإذا صحّت المودةُ ما بيني","وما بينكم فأين التشاكي",34,"ك",2,0],["فإذا صاحبُ حزن جاءه","جاءه الخير وشيكاً وانتعشْ",35,"ش",1,0],["فإذا صارَ إلى بيتٍ","وخَشفٍ عن تواطِ",36,"ط",1,0],["فإذا صدقتُ أرى بنفسيَ","جنةً وإذا كَذَبتُ أرى بنفسيَ نارا",37,"ر",2,0],["فإذا صمّ خال صوتك ركزاً","وإذا رقَّ خاله إِعصارا",38,"ر",2,0],["فاذا صفوتَ فذاكَ غاية مقصدي","واذا رضيتَ فذاكَ كلّ مرادي",39,"د",2,0],["فإذا صفت وصفت غرائب حسنها","وجمالها وبدت لها أخلاق",40,"ق",1,0],["فاذا صدّعن عتابك هذا","عد عنه وأبد عنه جهاله",41,"ل",2,0],["فإِذا صباحك فوقهم ظُلَم","وإذا ضُحاك عليهمُ قتَر",42,"ر",1,0],["فإذا صال فعمرو في زُبَيْدٍ","وإذا قال فَقُسٌّ في إياد",43,"د",1,0],["فإذا صورة تجلت إلى العين","وغابت في مستقر الجنان",44,"ن",1,0],["فإذا صيغت إليه مدحة","فهي من آثار تلك الألمعيه",45,"ي",2,0],["فإذا صحبتهم فأين حميتي","وإذا نبذتهم فأين وقائي",46,"ا",2,0],["فإذا صوبت فحية رمل","تنفث السم السم واسمها بندقيه",47,"ي",2,0],["فَإِذا صَفى في لَونِهِ أَو طَعمِهِ","مَع ريحِهِ مِن جُملَةِ الأَضغانِ",48,"ن",1,0],["فَإِذا صَفى في لَونِهِ أَو طَعمِهِ","مِن حَمأةِ الآبارِ وَالغارانِ",48,"ن",1,0],["فإذا صحوتُ فأنت أول خاطر","وإذا غفا جفني فأنت الآخر",49,"ر",1,0],["فإذا صفا أهل الهوى جاء الصفا","إلا فأين فرارنا ممن جفا",50,"ف",2,0],["فإذا صَبَرْتُ فإنني متجلِّدٌ","غصباً وهل أنا إن جَزَعْتُ مَلُوم",51,"م",1,0],["فإذا صفا كَدَري ونلتُ مآربي","فلياتينك من مديحي الجوهر",52,"ر",1,0],["فَإِذا صَحَّ ما أَرى في مَنامي","من صَحيح الأَحلامِ في رَفع حُجبي",53,"ب",2,0],["فإذا صال على أعدائه","لا يبالي بالوف ومئات",54,"ت",1,0],["فإذا صدقتَ العزمَ في تغييرِها","فلقد أظلّكَ موسِمُ التّغييرِ",55,"ر",1,0],["فإذا صنعنا حاضرا متماسكا","فغداً تكون القوة العصماء",56,"ا",2,0],["فإذا صَحَوْتُ فأنْتِ, أنْتِ بَدِيعَتِي","وإذا سَكِرتُ فأنْتِ كُلُّ دِنانِي",57,"ن",2,0],["فإذا صنعت صنيعة فاعمد بها","لله أو لذوي القرابة أودع",58,"ع",1,0],["فإذا صدقت فعندها أنا كاذبٌ","وإذا كذبت فعندها أنا صادق",59,"ق",1,0],["فإذا صدقت فهيئي","للذود من أهليك أهلا",60,"ل",2,0],["فإذا صرختُ بكى الصراخ تأوها","وتجمد الصوت الدفين فحَجَّرَهْ",61,"ر",2,0],["فإذا صمت فأنت أعظم باحث","وإذا أنطقت فأفصح الفصحاء",62,"ا",2,0],["فإذا صحوت صحا الأسى بجوانحى","وبكيت من حزن عليك طويلا",63,"ل",2,0],["فإذا صفا جوّ الورى فتكلمي","ذا موعدي إنّي الحبيبُ الناظرُ",64,"ر",1,0],["فَإِذا صَحا مِنها بِها","طَرَقَتهُ لَذَّتُا فَعَربَدَ",65,"د",1,0]]}