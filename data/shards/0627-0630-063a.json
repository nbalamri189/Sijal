{"poems":[[90,"قال قولا به استحق احتراما","https://www.aldiwan.net/poem44825.html","الخفيف"],[11,"مهلا نوار أقلي اللوم والعذل","https://www.aldiwan.net/poem263.html",""],[53,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[30,"أمسى لتغلب من تميم شاعر","https://www.aldiwan.net/poem5468.html","الكامل"],[33,"حدث حديث فتاة حي مرة","https://www.aldiwan.net/poem42666.html","الكامل"],[42,"أعاذلي أما للوم تغيير","https://www.aldiwan.net/poem42303.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85411","المتدارك"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20985","المنسرح"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10392","البسيط"],[11,"مهلاً نوار، اقلي اللوم والعذلا،","https://www.poetsgate.com/ViewPoem.aspx?id=16865",""],[20,"لم أر مثل الفتيان في غبن ال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69760&r=&rc=1",""],[161,"هكذا الدنيا","https://www.aldiwan.net/poem23648.html","المنسرح"],[178,"سقيا للذات وطيب","https://www.aldiwan.net/poem46063.html","مجزوء الكامل"],[264,"هي دار الحبيب ما هي داري","https://www.aldiwan.net/poem35766.html","الخفيف"],[422,"لله والدة المليك وما بنت","https://www.aldiwan.net/poem53919.html","الكامل"],[443,"راح يخشى في حبه الرقباء","https://www.aldiwan.net/poem2550.html","الخفيف"],[443,"ما بعد رامة للمشتاق من إرب","https://www.aldiwan.net/poem2580.html","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64387","المنسرح"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77540","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56082","المتدارك"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112832","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46524","الرجز"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130790",""],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62911","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108366",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123518","البسيط"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104528","الرمل"],[5085,"سقتني الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=188440",""],[5656,"قل للإمام الذي ترجى فضائله","https://www.poetsgate.com/ViewPoem.aspx?id=121950",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"]],"verses":[["إذ غدا ناطقاً بمرقد واشن","طون نطقاً شفى به الأسقاما",0,"م",2,0],["إِذ غابَ مَن غابَ عَنهُم مِن عَشيرَتِن","وَأَبدَتِ الحَربُ ناباً كالِحاً عَصِلا",1,"ل",2,0],["إذ غِرَّتي بالزمان تُوهمني","كلَّ متاعٍ يُعيرُهُ يَهَبُهْ",2,"ب",2,0],["إذ غصونُ اللجيْنِ لا البانِ منه","فوق كثبان لؤلؤ لا رِقالِ",3,"ل",1,0],["إِذ غابَ كَعبُ بَني جُعَيلٍ عَنهُمُ","وَتَنَمَّرَ الشُعَراءُ بَعدَ الأَخطَلِ",4,"ل",1,0],["إِذ غابَ عَنّا مَن نَخافُ وَطاوَعَت","أَرضٌ لَنا بِلَذاذَةٍ وَخَلاءِ",5,"ا",2,0],["إِذ غابَ عَقلي وَلَم يُترَك لِجُثَّتِهِ","رُوحٌ فَهَل رُوحُ مَن قَد ماتَ مَنشُورُ",6,"ر",1,0],["إذ غاصَ عَلى غواصته","في البحر يصول وَيستتر",7,"ر",1,0],["إذ غَبَّقَتهُ حَمراَء صافَيةَ","وألخَمرَ وَهلٌ يهيمُ شارِبُها",8,"ب",3,0],["إِذ غابَ مَن غابَ عَنهُم مِن عَشيرَتِنا","وَأَبدَتِ الحَربُ ناباً كالِحاً عَصِلا",9,"ل",2,0],["إذْ غاب مبن غاب عنهم من عشيرتنا،","وأبدَتِ الحرْبُ ناباً كالِحاً، عَصِلا",10,"ل",2,0],["إِذ غَبَقَتهُ صَهباءَ صافِيَةً","وَالخَمرُ وَهلٌ يَهيمُ شارِبُها",11,"ب",3,0],["إِذْ غَبَّ فِي وَصْلٍ مِنْكِ مُعْتَزِلٌ","أخْزَى الهَوَى فِي كَفِّ الأذَى خَزْيَا",12,"ي",2,0],["إذْ غَالَبَتْ كَفِّي الزمانَ","وإِذْ شَربْتُ عَلَى الرَّقِيبِ",13,"ب",1,0],["إذ غاب معناكم تذكّرتُ طيفَكم","ومن لم يجد ماءً تيمّم بالترب",14,"ب",1,0],["إذ غَيَّرَتْه وقدَّرَتْه بحكمةٍ","وكذا يراد من البناء المحكم",15,"م",1,0],["إذ غزال الصريم لم يصرم الود","د اعلالا ولا تناسى الوفاء",16,"ا",2,0],["إذ غادرت حندس الظلماء وهو ضحى","من نور وجه بريك الشمس لم تغبِ",17,"ب",1,0],["إذ غصن ذاك الشباب معتدل","لم تطمع الحادثات في ميله",18,"ه",1,1],["إِذ غافل الراعي وَسَلَّ لِباسه","وَبِهِ تَستّر عَن عُيون الرُمَّق",19,"ق",1,0],["إذ غار بسابقةٍ قدحت","من بين حوافرها النارُ",20,"ر",1,0],["إذ غاب ليل الكفر واتضح الهدى","ولقد علا علم الكرام على قنن",21,"ن",1,0],["إِذ غَرهُ صفرته وَحُسنه","فَلم يَكُن فيهِ الَّذي يَظنه",22,"ه",1,0],["إِذ غَابَ عَنِّي كلُّ عَونٍ ناصِر","هُما اللَّذانِ سَمَوَا بناظِري",23,"ي",1,0],["اذ غدا الدين بالحضارة يسمو","برقيٍّ يستتبع التكميلا",24,"ل",2,0],["اذْ غنينا على نَداه فآلي","نا وكلٌّ على العزيمة آلى",25,"ل",2,0],["اذ غبت غني يا فتاة بمعزلٍ","قد جف ماءُ قريحتي لن يهتنا",26,"ن",2,0],["إِذ غَذَا لِلنَّبِىِّ مِنهَا غِذَاءُ","إِذ رَأتهُ تَيَقَّنَت أنَّهُ نَج",27,"ج",1,0],["إذ غادر الأضغان توّاً وعاد","فقام أتريذ ولم يمتثل",28,"ل",1,0],["إذ غدا يحسو رضاباً وجنى","من ثنايا شعشعت بالبلج",29,"ج",1,0],["اذ غيره قال نفسى وهو قال أنا","لها بعزم له في القدر تنفيل",30,"ل",1,0],["إذ غدت ساحبة من","ه ببحر من علق",31,"ق",1,0],["أذْ غادَرُوا فِي هَزيْعِ العُمْرِ جَنتنَا","وَأخلَفوْنا بِوَجْدٍ لَيْتهُمْ عَدَلُوا",32,"ل",3,0],["إذ غادروا قاسما في فتية نجب","عقوى مسامعهم في سبسب خرب",33,"ب",1,0],["إذ غَدا لِلنَبي مِنها غذاء","أَجملت صنعها حَليمة والأَج",34,"ج",1,0]]}