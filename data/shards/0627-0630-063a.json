{"poems":[[88,"قال قولا به استحق احتراما","https://www.aldiwan.net/poem44825.html","الخفيف"],[11,"مهلا نوار أقلي اللوم والعذل","https://www.aldiwan.net/poem263.html",""],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[28,"أمسى لتغلب من تميم شاعر","https://www.aldiwan.net/poem5468.html","الكامل"],[31,"حدث حديث فتاة حي مرة","https://www.aldiwan.net/poem42666.html","الكامل"],[40,"أعاذلي أما للوم تغيير","https://www.aldiwan.net/poem42303.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85411","المتدارك"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20985","المنسرح"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10392","البسيط"],[11,"مهلاً نوار، اقلي اللوم والعذلا،","https://www.poetsgate.com/ViewPoem.aspx?id=16865",""],[20,"لم أر مثل الفتيان في غبن ال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69760&r=&rc=1",""],[155,"هكذا الدنيا","https://www.aldiwan.net/poem23648.html","المنسرح"],[172,"سقيا للذات وطيب","https://www.aldiwan.net/poem46063.html","مجزوء الكامل"],[257,"هي دار الحبيب ما هي داري","https://www.aldiwan.net/poem35766.html","الخفيف"],[413,"لله والدة المليك وما بنت","https://www.aldiwan.net/poem53919.html","الكامل"],[434,"راح يخشى في حبه الرقباء","https://www.aldiwan.net/poem2550.html","الخفيف"],[434,"ما بعد رامة للمشتاق من إرب","https://www.aldiwan.net/poem2580.html","البسيط"]],"verses":[["إذ غدا ناطقاً بمرقد واشن","طون نطقاً شفى به الأسقاما",0,"م",2,0],["إِذ غابَ مَن غابَ عَنهُم مِن عَشيرَتِن","وَأَبدَتِ الحَربُ ناباً كالِحاً عَصِلا",1,"ل",2,0],["إذ غِرَّتي بالزمان تُوهمني","كلَّ متاعٍ يُعيرُهُ يَهَبُهْ",2,"ب",2,0],["إذ غصونُ اللجيْنِ لا البانِ منه","فوق كثبان لؤلؤ لا رِقالِ",3,"ل",1,0],["إِذ غابَ كَعبُ بَني جُعَيلٍ عَنهُمُ","وَتَنَمَّرَ الشُعَراءُ بَعدَ الأَخطَلِ",4,"ل",1,0],["إِذ غابَ عَنّا مَن نَخافُ وَطاوَعَت","أَرضٌ لَنا بِلَذاذَةٍ وَخَلاءِ",5,"ا",2,0],["إِذ غابَ عَقلي وَلَم يُترَك لِجُثَّتِهِ","رُوحٌ فَهَل رُوحُ مَن قَد ماتَ مَنشُورُ",6,"ر",1,0],["إذ غاصَ عَلى غواصته","في البحر يصول وَيستتر",7,"ر",1,0],["إذ غَبَّقَتهُ حَمراَء صافَيةَ","وألخَمرَ وَهلٌ يهيمُ شارِبُها",8,"ب",3,0],["إِذ غابَ مَن غابَ عَنهُم مِن عَشيرَتِنا","وَأَبدَتِ الحَربُ ناباً كالِحاً عَصِلا",9,"ل",2,0],["إذْ غاب مبن غاب عنهم من عشيرتنا،","وأبدَتِ الحرْبُ ناباً كالِحاً، عَصِلا",10,"ل",2,0],["إِذ غَبَقَتهُ صَهباءَ صافِيَةً","وَالخَمرُ وَهلٌ يَهيمُ شارِبُها",11,"ب",3,0],["إِذْ غَبَّ فِي وَصْلٍ مِنْكِ مُعْتَزِلٌ","أخْزَى الهَوَى فِي كَفِّ الأذَى خَزْيَا",12,"ي",2,0],["إذْ غَالَبَتْ كَفِّي الزمانَ","وإِذْ شَربْتُ عَلَى الرَّقِيبِ",13,"ب",1,0],["إذ غاب معناكم تذكّرتُ طيفَكم","ومن لم يجد ماءً تيمّم بالترب",14,"ب",1,0],["إذ غَيَّرَتْه وقدَّرَتْه بحكمةٍ","وكذا يراد من البناء المحكم",15,"م",1,0],["إذ غزال الصريم لم يصرم الود","د اعلالا ولا تناسى الوفاء",16,"ا",2,0],["إذ غادرت حندس الظلماء وهو ضحى","من نور وجه بريك الشمس لم تغبِ",17,"ب",1,0]]}