{"poems":[[88,"قال قولا به استحق احتراما","https://www.aldiwan.net/poem44825.html","الخفيف"],[11,"مهلا نوار أقلي اللوم والعذل","https://www.aldiwan.net/poem263.html",""],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[28,"أمسى لتغلب من تميم شاعر","https://www.aldiwan.net/poem5468.html","الكامل"],[31,"حدث حديث فتاة حي مرة","https://www.aldiwan.net/poem42666.html","الكامل"],[40,"أعاذلي أما للوم تغيير","https://www.aldiwan.net/poem42303.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85411","المتدارك"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20985","المنسرح"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10392","البسيط"],[11,"مهلاً نوار، اقلي اللوم والعذلا،","https://www.poetsgate.com/ViewPoem.aspx?id=16865",""],[20,"لم أر مثل الفتيان في غبن ال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69760&r=&rc=1",""]],"verses":[["إذ غدا ناطقاً بمرقد واشن","طون نطقاً شفى به الأسقاما",0,"م",2,0],["إِذ غابَ مَن غابَ عَنهُم مِن عَشيرَتِن","وَأَبدَتِ الحَربُ ناباً كالِحاً عَصِلا",1,"ل",2,0],["إذ غِرَّتي بالزمان تُوهمني","كلَّ متاعٍ يُعيرُهُ يَهَبُهْ",2,"ب",2,0],["إذ غصونُ اللجيْنِ لا البانِ منه","فوق كثبان لؤلؤ لا رِقالِ",3,"ل",1,0],["إِذ غابَ كَعبُ بَني جُعَيلٍ عَنهُمُ","وَتَنَمَّرَ الشُعَراءُ بَعدَ الأَخطَلِ",4,"ل",1,0],["إِذ غابَ عَنّا مَن نَخافُ وَطاوَعَت","أَرضٌ لَنا بِلَذاذَةٍ وَخَلاءِ",5,"ا",2,0],["إِذ غابَ عَقلي وَلَم يُترَك لِجُثَّتِهِ","رُوحٌ فَهَل رُوحُ مَن قَد ماتَ مَنشُورُ",6,"ر",1,0],["إذ غاصَ عَلى غواصته","في البحر يصول وَيستتر",7,"ر",1,0],["إذ غَبَّقَتهُ حَمراَء صافَيةَ","وألخَمرَ وَهلٌ يهيمُ شارِبُها",8,"ب",3,0],["إِذ غابَ مَن غابَ عَنهُم مِن عَشيرَتِنا","وَأَبدَتِ الحَربُ ناباً كالِحاً عَصِلا",9,"ل",2,0],["إذْ غاب مبن غاب عنهم من عشيرتنا،","وأبدَتِ الحرْبُ ناباً كالِحاً، عَصِلا",10,"ل",2,0],["إِذ غَبَقَتهُ صَهباءَ صافِيَةً","وَالخَمرُ وَهلٌ يَهيمُ شارِبُها",11,"ب",3,0]]}