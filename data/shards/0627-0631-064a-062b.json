{"poems":[[87,"يا رب لا غبطة ولا حسد","https://www.aldiwan.net/poem7526.html","المنسرح"],[47,"إلى أي سر في الهوى لم أخالف","https://www.aldiwan.net/poem65154.html","الطويل"],[46,"منحتك ودا كان طفلا فقد نشا","https://www.aldiwan.net/poem30227.html","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77916","السريع"],[3362,"","https://poetry.dctabudhabi.ae/diwan/poem/31673","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131027",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81272","المتقارب"],[6018,"لئن بخلت بإسعادى سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=181196",""]],"verses":[["أرى ثراء أفاده قلم","أخف منه في المسمع الوتد",0,"د",1,0],["أَرى ثِقَةَ الراجي مُواصَلَةَ المَها","تَكاءَدَها أَو آدَها شَكُّ خائِفِ",1,"ف",1,0],["أَرى ثَمَرَ الحُسنِ الَّذي قَد غَرَستُهُ","عَلى سَقفِ أَعوادِ التَجَنّي مُعَرِّشا",2,"ش",2,0],["أَرى ثمار الوصل قد أَينعت","لكن أَسراري منعن الجنى",3,"ن",2,0],["أَرى ثِياباً وفي أَثْنائها بَقَرٌ","بِلا قُرونٍ وذا عَيْبٌ عَلى البَقَرِ",4,"ر",1,0],["أرى ثوب سلمى يا فريدة فاخرا","وأحسن نسجا من ردائك يا سعا",5,"ع",2,0],["إِرِيثُوسَ مَن كانَ يَلقَى الجُمُوعا","بِهِ لا يُجِيلُ القَنا وَالفُرُوعا",6,"ع",2,0],["أَرى ثَورة وَأَرى أَنفُساً","ظماء كَآمالها تَحتَدم",7,"م",1,0],["أرى ثلجاً بوجنتها وناراً","لتلك النار في قلبي اتقاد",8,"د",1,0]]}