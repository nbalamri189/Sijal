157,"م",2,0],["أحن يا صبحي إلى ذكراكا","وقلبي الملتاع في لهيب",158,"ب",1,0],["أَحَنُّ إِلى تِلكَ الأَبارِقِ مِن قَنا","كَأَنَّ اِمرَأً لَم يَجلُ عَن دارِهِ قَبلي",159,"ي",1,1],["أَحنُّ إِلى رُبوعك كُلّ حين","كَما حَنَّ الفَصيل إِلى النِياقِ",160,"ق",1,0],["أَحنّ لِوادي المنحنى وَنُزوله","وَما نَزَلوا إِلّا حَنايا وَأَضلعا",161,"ع",2,0],["أَحنّ اِلى تِلك المَعاهد كُلَّما","يَجد دلي مرّ النَسيم بها ذكرا",162,"ر",2,0],["أحِنُّ إلى الكأسِ الَّتي قد شَرِبْتَها","ومثْلي ولم يُظْلَمْ إلى مثلها حَنّا",163,"ن",2,0],["أَحِنُّ إلى تلك الضُّحَى والأصائلِ","وما مَرَّ في أيّامِهنَّ القلائلِ",164,"ل",1,1],["أَحِنُّ إلى السُّرَى وَعلَيَّ قَيْدٌ","منَ التَّعويقِ يَمنَعُني الحَراكا",165,"ك",2,0],["أَحِنُّ إلى الجَرْعاء من رَمْلِ عالِجٍ","فهل ماؤها للواردِينَ نَمير",166,"ر",1,0],["أحِنُ إلى ليلَى على قُرْبِ دارِها","حَنينَ الذي يَشكو لأُلاَّفِه بُعدا",167,"د",2,0],["أَحِنُّ إلى طَيْفِ الأحبّةِ سارياً","ودونَ سُراهُ نَبْوةُ الجَفْنِ والجَنْب",168,"ب",1,0],["أحن إلى الوادي المقدس رغبةً","إليه فمرآه لعيني يبهجُ",169,"ج",1,1],["أَحِنّ إِلى الحَبيب وَغَير بَدع","إِذا اِشتاقَ العَليل إِلى الطَبيب",170,"ب",1,0],["أحنُّ لأيام الوصال وطيبها","ويوهنني أن التأسف لا يجدي",171,"د",2,0],["أَحن إِلى الفِراقِ لِكَي أَراها","وَإِن كانَ الفِراق عَليَّ لا لي",172,"ي",1,0],["أَحِنُّ إِلى أبي بكرٍ وما لي","إلى رؤياهُ في الدّنيا سبيلُ",173,"ل",1,0],["أحنُو ضُلُوعي في كلِّ نائبَةٍ","على فؤادٍ لا يَعرفُ القَلَقَا",174,"ق",2,0],["أحِنُّ إليكُم والمَهامِهُ بَيْنَنَا","حَنينَ أَلُوفٍ بانَ عنها قَرِينُها",175,"ه",2,1],["أَحِنُّ إليكم والهوى يستَفِزُّني","كما حنَّ نائي الدَّار وهو غريبُ",176,"ب",1,0],["أَحِنُّ إلى يومٍ عبوسٍ عصبصبٍ","تتوقُ له نفسي حنين الأَباعر",177,"ر",1,0],["أَحِنّ إلى عهد الشَّباب وطيبه","وحَيٍّ بأحناء الضلوع نزول",178,"ل",1,0],["أحن إلى الظبي الأغنّ كأنه","يمثل لي الحاظ ميّة والعنقا",179,"ق",2,0],["أحنّ إذا ما ناح قمريّ روضة","حنيناً بأشجان يزدن على الصبر",180,"ر",1,0],["أحنّ إليها ما تالق بارق","حنينا يرى للنار من حرة برد",181,"د",1,0],["أحن إلى ليلى وليلى منى قلبي","حنين خماس أو فروق على سقب",182,"ب",1,1],["أحن بها على قرب وبعد","ولست بسامع فيها التعازي",183,"ي",1,0],["أحنقت في جنب المهاوس راغباً","وعن النهابر لست بالمتحانق",184,"ق",1,0],["أَحنُّ إِلى تلكَ الرُبى والمعاهد","بذات الغضا والآنسات الخرائِد",185,"د",1,1],["أحنو عليها كأني عاشق وأب","أو أنها خلقت من قلب الحاني",186,"ي",1,0],["أحنو عليهم وأسعى دائباً يَقظاً","لخيرهم وأعاني غُربتي صُورا",187,"ر",2,0],["أحُّن إليها مستجيباً لدعوةٍ","تَغنَّى بها الصبحُ الجميلُ المرقرق",188,"ق",1,0],["أحِنُّ إلى لقائك والليالي","عليّ مع العوائق لي جُنودُ",189,"د",1,0],["أَحنُّ لكم حَنَّة العاشقين","فأمدحكم مثلَ ما أنسِبُ",190,"ب",1,0],["أحنّ إذا الوفدُ أستقلّوا لقصدكم","حنينَ الفتى العُذرىِّ مَرَّ بربربِ",191,"ب",1,0],["أحنُّ شوقاً على نأي الديار بنا","كما تحنُّ إلى جيرانها النِّيبُ",192,"ب",1,0],["أحنُّ حنينَ رزاحةٍ فقيدٍ","تُراوحُ في الأزِمَّةِ والنُّسوعِ",193,"ع",1,0],["أحنُّ كما حنَّت إلى الوردِ بالضُّحى","خوامسُ أودتْ بالسُّرى واضْمحلَّت",194,"ت",1,0],["أحنُّ وأحياناً أنوح صبابةً","ولولا الهوي ما ناحَ صبٌّ ولا حنّا",195,"ن",2,0],["أحن إلى ظل العقيق من الحمى","حنين ذوات الخمس حامت على الورد",196,"د",1,1],["أحنُّ ولا عجبٌ للكريم","تذكَّر عهداً كريماً فحن",197,"ن",1,0],["أحنُّ اشتياقاً وهي تسجع سلوةً","وأبكي غراماً وهي في الأيك تصدحُ",198,"ح",1,0],["أحنُّ إلى عصر الشباب ووصله","وأبكي جوىً من هجره وانصرامهِ",199,"م",2,0],["أحنُّ إلى هندٍ وهل ينقعُ الصّدى","وبرحَ الحشا قولي أحنُّ إلى هند",200,"د",1,0],["أحنُّ إلى وادي الأراك من الحمى","وهيهات من وادي الأراك حنين",201,"ن",1,0],["أحِنُّ وللهوارقِ في الدياجي","وميضُ سناً تُنارُ به الرِّعانُ",202,"ن",1,0],["أحِنُّ إلى أيامِها ويزيدُني","بها شفغاً طيفُ الخيالِ الذى يسري",203,"ر",2,0],["أحِنُّ إلى مَنْ بانَ عن رملِ عالجٍ","وأشتاقُ ما فيه من الضَّالِ والسِّدْرِ",203,"ر",1,0],["أحِنُّ حنينَ الرائماتِ عشيةً","وقد خَفَّ عن تلكَ الديارِ قطينُ",204,"ن",1,0],["أحِنُّ إلى برقِ الثغورِ إذا بدا","لنا بارقٌ بالأجرَعَينِ لموحُ",205,"ح",1,0],["أحِنُّ إلى ليلى فلو زالَ حبُّها","ولا زالَ عن قلبي طَرِبْتُ إلى هندِ",206,"د",1,0],["أحِنُّ إلى أيامِ نجدٍِلعلِّها","بقربكمُ يوماً عليَّ تجودُ",207,"د",1,0],["أحِنُّ اصْطِلاماً من فُؤادٍ مُقَرَّحِ","وأجْذبُ منِّي الآهَ جَذْبَةَ خائِفِ",208,"ف",1,0],["أحنّ لمرأى خدِّها وهْو مصرَعي","وأعشَقُ منها الطَّرْفَ والطّرفُ قاتِلي",209,"ل",2,0],["أحن ولا أفيق لمن","يحدثني ويردعني",210,"ي",1,0],["أَحِنُّ شَوْقاً إلى الْحَبِيبِ مَعَ الصِّ","بْيَةِ والأَهْلِ والدّيارِ مَعا",211,"ع",2,0],["أَحِنُّ إِلى وَصْلٍ تَقَادَمَ عَهْدُهُ","وإِنَّ حَنِينَ المرْءِ أَحْقَرُ واجِبِ",212,"ب",1,0],["أحِنُّ إلى مِصرٍ وما أنَا مِن مِصرٍ","ولكنَّ طَيرَ القَلبِ أعرَفُ بِالوَكرِ",213,"ر",1,1],["أحِنُّ إلى مَن لا يَحنُّ وليتَه","لِمَنْ كان محنوناً محبّيهِ يعرفُ",214,"ف",1,0],["أحنُّ شوقاً إلى الوادي فيطربني","نوح الحمام سحيراً في نواحيه",215,"ه",1,0],["أحن إلى ذاتي صباحاً وفي المسا","وغاية قصدي في العوالم رؤيتي",216,"ي",1,0],["أحِنُّ إلى الدِّيارِ وساكِنيها","على بُعْدٍ وإن بَخُلَتْ بِقُربِ",217,"ب",1,0],["أحْنَى على كلِّ مَنْ يُعَالِجُهُ","من الشَّقِيْقِ الشَّفِيْقِ والوالِدْ",218,"د",1,0],["أَحِنُّ إِليهَا كُلَّ يومٍ ولَيْلَةٍ","حنينَ الحَنَايَا لاَ الرءوم إِلى السَّقْب",219,"ب",1,0],["أَحِنُّ لمَعْسُولِ الثَّنيّاتِ واللَّمىَ","وهيهاتَ أَن يَشْفي الغليلَ حنِيني",220,"ي",1,0],["أَحِنُّ لِشعبٍ نازلٍ فيه قومُها","وما قومُها قَوْمِي وما شِعْبُها شِعْبي",221,"ب",2,0],["أَحِنُّ إِليه كلَّ يوم وليلةٍ","حنينَ الحنَايا لا حنينَ الأَبَاعِرِ",222,"ر",1,0]]}