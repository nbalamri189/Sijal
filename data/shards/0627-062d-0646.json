ldiwan.net/poem48820.html","الوافر"],[403,"أتاني در النظم من عالم مهدي","https://www.aldiwan.net/poem33950.html","الطويل"],[406,"ألم بمضجعي بعد الكلال","https://www.aldiwan.net/poem50138.html","الوافر"],[409,"كيف أنساك يا أبا بكر أم كيغف","https://www.aldiwan.net/poem31853.html","الخفيف"],[409,"قلبي وصبري إلفان مذ خلقا","https://www.aldiwan.net/poem32173.html","المنسرح"],[409,"أحن إليكم والمهامه بيننا","https://www.aldiwan.net/poem32248.html","الطويل"],[416,"أحبتنا أنتم على السخط والرضا","https://www.aldiwan.net/poem53975.html","الطويل"],[416,"بوخز القنا والمرهفات البواتر","https://www.aldiwan.net/poem54013.html","الطويل"],[416,"سقاك الحيا من أربع وطلول","https://www.aldiwan.net/poem54049.html","الطويل"],[429,"أتت مثل خوط البان تهتز أو أرقى","https://www.aldiwan.net/poem40712.html","الطويل"],[429,"يهيجني تذكار خل كما البدر","https://www.aldiwan.net/poem41069.html","الطويل"],[437,"لهم حب قلبي إن تدانوا وإن صدوا","https://www.aldiwan.net/poem2622.html","الطويل"],[441,"أحن إلى ليلى وليلى منى قلبي","https://www.aldiwan.net/poem14296.html","الطويل"],[441,"وحسن جمال ليلى أن ليلى","https://www.aldiwan.net/poem14305.html","الوافر"],[441,"عجبا لراج فوز ناج سابق","https://www.aldiwan.net/poem14317.html","الكامل"],[452,"أحن إلى تلك الربى والمعاهد","https://www.aldiwan.net/poem13715.html","الطويل"],[453,"إن نام أيار عن ورد وعدت به","https://www.aldiwan.net/poem61272.html","البسيط"],[453,"أصار مثلي عارا أم غدا خطرا","https://www.aldiwan.net/poem61605.html","البسيط"],[453,"بثينة لا أرضى الوداع وإن أكن","https://www.aldiwan.net/poem61656.html","الطويل"],[458,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[458,"نأت والأمانِي بها تقرب","https://www.aldiwan.net/poem56282.html","المتقارب"],[458,"شفى الله نفسا لا تذل لمطلب","https://www.aldiwan.net/poem56303.html","الطويل"],[461,"أبا عمارة أن شطت منازلنا","https://www.aldiwan.net/poem15114.html","البسيط"],[461,"ألا من مبلغ عني هماما","https://www.aldiwan.net/poem15137.html","الوافر"],[461,"ونبئت أن الدهر أحدث نبوة","https://www.aldiwan.net/poem16365.html","الطويل"],[464,"أماط لثاماً فاجتلِ القمر الأدنى","https://www.aldiwan.net/poem3203.html","عموديه"],[464,"أحن إلى ظل العقيق من الحمى","https://www.aldiwan.net/poem3270.html","عموديه"],[464,"لذاك الحبيب وهذي الدمن","https://www.aldiwan.net/poem3319.html","عموديه"],[464,"أإن بعدت لمياء والإلف ينزح","https://www.aldiwan.net/poem3417.html","عموديه"],[464,"سقاني بكأسي ريقه ومدامه","https://www.aldiwan.net/poem3446.html","عموديه"],[464,"سقى العهد مالي بالجزيرة من عهد","https://www.aldiwan.net/poem3586.html","عموديه"],[464,"رمتني بنجل والسهام جفون","https://www.aldiwan.net/poem3591.html","عموديه"],[477,"يذكرني ثناياهنلما","https://www.aldiwan.net/poem15199.html","الوافر"],[477,"أبرق تبدى أم وميض سنا ثغر","https://www.aldiwan.net/poem15206.html","الطويل"],[477,"هوى بين أحناء الضلوع دفين","https://www.aldiwan.net/poem15260.html","الطويل"],[477,"حمام بأعلى الجلهتين ينوح","https://www.aldiwan.net/poem15261.html","الطويل"],[477,"كفى حزنا أني أبثك ما عندي","https://www.aldiwan.net/poem15281.html","الطويل"],[477,"علامة سلواني إذا قلت بعدكم","https://www.aldiwan.net/poem15332.html","الطويل"],[500,"وآيات ألواح رقمن مع العما","https://www.aldiwan.net/poem37957.html","الطويل"],[514,"أما ومواضي مقلتيها الفواصل","https://www.aldiwan.net/poem20797.html","الطويل"],[515,"حسبت الدهر في ولدي","https://www.aldiwan.net/poem12294.html","الهزج"],[529,"أكثر ذا العام صرت في سفر","https://www.aldiwan.net/poem37333.html","المنسرح"],[529,"أيا بين كم كدرت صفو المشارب","https://www.aldiwan.net/poem37536.html","الطويل"],[538,"أحن إلى مصر وما أنا من مصر","https://www.aldiwan.net/poem48137.html","عموديه"],[551,"عجبت لقلبي كيف يصبو ويكلف","https://www.aldiwan.net/poem47405.html","البسيط"],[558,"غزال ذاك الحمى صبري قضى فيه","https://www.aldiwan.net/poem33644.html","البسيط"],[558,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[562,"أطوف الأرض في شرق وغرب","https://www.aldiwan.net/poem52849.html","الوافر"],[567,"الحمد لله قد وجدت أخا","https://www.aldiwan.net/poem69721.html","المنسرح"],[575,"لئن كنت من عيني نقلت إلى قلبي","https://www.aldiwan.net/poem2789.html","الطويل"],[575,"تركت حبيب القلب تهمي جفونه","https://www.aldiwan.net/poem2847.html","الطويل"],[575,"أيا شمسي منك أشرق بهجة","https://www.aldiwan.net/poem2994.html","الطويل"],[575,"تنزه طرفي بين زاه وزاهر","https://www.aldiwan.net/poem3073.html","الطويل"]],"verses":[["أَحِنُّ وَلا يُرمى حَنيني بِتُهمَةٍ","وَأَدنو وَلا يُعزى دُنّوي بِمَأثَمِ",0,"م",1,0],["أَحِنُّ إِلَيكَ وَتَأبى المَطِيُّ","بِخَدِّ تُرابِكَ أَن يَلتَطِم",1,"م",1,0],["أَحِنُّ إِلَيهِ وَاللُقيا ضِمارٌ","حَنينَ العَودِ لِلوَطَنِ القَديمِ",2,"م",1,0],["أَحِنُّ وَتُجريني عَلى الشوقِ قَسوَةٌ","أَلا غالَ ما بَيني وَبَينَكَ غولُ",3,"ل",1,0],["أَحِنُّ إِلى مَن لا يَحِنُّ صَبابَةً","وَما واجِدٌ قَلبا مَشوقٍ وَشائِقِ",4,"ق",1,0],["أَحَنَّ إِلى قَومي كَما حَنَّ نازِعٌ","إِلى الماءِ قَد دانى لَهُ القَيدَ قاصِرُ",5,"ر",1,0],["أَحِنُّ إِلى لِقائِكَ كُلَّ يَومٍ","وَأَسأَلُ عَن إِيابِكَ كُلَّ وَقتِ",6,"ت",1,1],["أَحِنُّ إِذا حَنَّت رِكابي وَفي الحَشا","بَلابِلُ لا تَعيا بِهِنَّ النَجائِبُ",7,"ب",1,0],["أَحِنُّ إِلى نورِ الرُبى في بِطاحِهِ","وَأَظما إِلى رَيّا اللِوى في هُيوبِهِ",8,"ب",2,0],["أَحِنُّ إِليهِ حَنَّةً لَم يَجُد بِها","لِخلٍّ وذي قُربَى أَخٌ وَحَميمُ",9,"م",1,0],["أَحِنُّ إِلى سُعدى وَدونَ مَزارِها","ضَروبٌ بِسَيفٍ يَقتَفي رُمحَ طاعِنِ",10,"ن",1,0],["أَحِنُّ إِلَيها وَالعُلَيمِيُّ عاذِلي","هُذَيمُ أَفِقْ مِن مَنطِقٍ حَزَّ في جِلدي",11,"د",2,0],["أَحِنُّ إِلى مَيثاءَ حاليَةَ الثَّرَى","وَأَصبو إِلى وَعساءَ طَيِّبَةِ التُّربِ",12,"ب",1,0],["أَحِنُّ إِلَيْها وَالنَّوى مُطمَئِنَّةٌ","بِنا وَبُيوتُ الحَيِّ لَمْ تَتَقوَّضِ",13,"ض",1,0],["أحِنُّ إلَيها ومِنْ دُونِها","تَعُدُّ الرّكائِبُ بِيناً فَبينا",14,"ن",2,0],["أحِنُّ صَبابَةً ويَحِنُّ شَوْقاً","كِلا القَلْبَيْنِ وَيْبَكَ غيرُ صاحِ",15,"ح",1,0],["أَحِنُّ إِلى ضَربِ السُيوفِ القَواضِبِ","وَأَصبو إِلى طَعنِ الرِماحِ اللَواعِبِ",16,"ب",1,1],["أَحِنُّ إِلى تِلكَ المَنازِلِ كُلَّم","غَدا طائِرٌ في أَيكَةٍ يَتَرَنَّمُ",17,"م",1,0],["أَحِنُّ لَهُم وَدونَهُمُ فَلاةٌ","كَأَنَّ فَسيحَها صَدرُ الحَليمِ",18,"م",1,0],["أَحَنُّ عَلى المَكدودِ مِن ظِلِّ دَوحَةٍ","وَأَحنى عَلى المَولودِ مِن ثَديِ مُرضِعِ",19,"ع",1,0],["أَحِنُّ لِذِكراهُم وَأَشدو بِمَدحِهِم","كَأَنّي بِجَوفِ اللَيلِ هاتِفُ أَسحارِ",20,"ر",1,0],["أَحِنُّ إِلى مِصرٍ وَيا لَيتَ أَنَّ لي","إِذا ذُكِرَت مِصرٌ جَناحاً أُعارُهُ",21,"ر",2,0],["أَحِنُّ إِلى قَومٍ هُناكَ أَعِزَّةٍ","عَلَيَّ وَقَومٍ في عِراصِ المُقَطَّبِ",22,"ب",1,0],["أَحِنُّ وَمِن وَراءِ النَهرِ داري","حَنينَ العَودِ أَوثَقَهُ العِراسُ",23,"س",1,0],["أحَنَنْتَ مِنْ شَوْقٍ إِلَى لُبْنَانِ","وَارَحْمَتَا لَكَ مِنْ رَمِيمٍ عَانِ",24,"ن",1,1],["أحنّ إلى رؤياكم كلما سرى","نسيم وأبكي كلما لاح كوكب",25,"ب",1,0],["أَحِنُّ إِذا نَظَرتُ إِلى سُهَيلٍ","وَعِندَ اليَأسِ يَنقَطِعُ الرَجاءُ",26,"ا",2,0],["أحنُّ إلى أهلي وأهوى لقاءهم","وأينَ من المشتاقِ عنقاء مغرب",27,"ب",1,0],["أحنُّ لوجهٍ تهتُ فيه صبابةً","فلله صبّ ضلّ إذ لاح بدرُه",28,"ر",2,0],["أحنت معاطفي السنون وغيرت","عند الغواني ما بها المتبينا",29,"ن",2,1],["أحْنَفِ الحلم قيْسه حين يهفو","كلُّ حِلم عَمْرِو الدَّهاء زِيادِهْ",30,"د",2,0],["أحنُّ إلى بغداذ والبيدُ دونها","حنينَ عميدِ القلب حَرَّانَ فاقِدِ",31,"د",1,0],["أحن فأستسقي لها الغيث مرة","وأثني فأستسقي لها العين أدمعا",32,"ع",2,0],["أَحنى عَلى الحُرِّ مِن أَمٍّ عَلى وَلَدٍ","فَالحُرُّ في مِصرَ كَالوَرقاءِ في الحَرَمِ",33,"م",1,0],["أَحِنُّ إِلَيهِ في العَشِيِّ وَفي الضُحى","حَنينَ غَريبٍ جائَهُ الشَوقُ داعِيا",34,"ي",2,0],["أَحِنُّ إِلى تِلكَ المَغاني وَأَهلِها","وَأَشتاقُ مَن يَشتاقُ تِلكَ المَغانِيا",35,"ي",2,0],["أَحِنُّ إِلَيكُم كُلَّ يَومٍ وَلَيلَةٍ","وَأَهذي بِكُم في يَقظَتي وَمَنامي",36,"ي",1,0],["أَحِنُّ إِلى عَهدِ المُحَصَّبِ مِن مِنىً","وَعَيشٍ بِهِ كانَت تُرِفُّ ظِلالُهُ",37,"ل",2,1],["أَحِنُّ إِلَيكُم كُلَّما لاحَ بارِقٌ","وَأَسأَلُ عَنكُم كُلَّما هَبَّتِ الصَبا",38,"ب",2,0],["احنو عليه وهو طفل مثلما","يحنو على الولد الوحيد الوالد",39,"د",1,0],["أَحنى عَلَيكِ مِنَ الكُثبانِ فَاِتَّخِذي","عَلَيهِ مَرعاكِ مِن قاعٍ وَكُثبانِ",40,"ن",1,0],["أَحِنُّ إِلى الكَأسِ الَّتي شَرِبَت بِها","وَأَهوى لِمَثواها التُرابَ وَما ضَمّا",41,"م",2,0],["أحِنُّ إِلى أرض الحجاز وفيهمُ","غريمٌ مُلِطٌّ لو يشاء قضاني",42,"ي",1,0],["أحِنُّ إليها إنْ تراخَى مزارُهَا","وأبكي عليها إنْ تدانَى وأشهَقُ",43,"ق",1,0],["أحنُو عليهِ وأخشى أنْ يعاجلَنِي","يومي ولم أَقْضِ من ترشيحهِ وطري",44,"ي",1,0],["أحِنُّ إليها والظَّلامُ مُمَسَّكٌ","وأصدْفُ عنها والصَّباحُ مُخَلَّقُ",45,"ق",1,0],["أَحِنُّ إِلى الدُنيا حَنيناً كَأَنَّني","وَلَستُ بِها مُستَوفِزاً قَلِقَ الرَحلِ",46,"ل",1,0],["أَحِنُّ إِلَيكُم كُلَّما ذَرَّ شارِقٌ","وَيَشتاقُ قَلبي كُلَّما مَرَّ خاطِفُ",47,"ف",1,1],["أحني لعرش الله رأساً ما انحنى","بالذل يوماً في رحاب عظيم",48,"م",1,0],["أَحِنُّ إِلى أَرضي الَّتي في تُرابِها","مفاصلُ من أهْلي بَلِينَ وأعظُمُ",49,"م",1,0],["أحِنّ إلى العشرين عاماً وبينَنَا","ثلاثون يمشي المرءُ فيها إلى خلفِ",50,"ف",1,1],["أَحِنُّ إلى أوطانِكُم وَكَأنَّما","ألاقي بها عَصْرَ الصّبا سُقيَ العصرُ",51,"ر",1,0],["أَحنّ حنينَ النيبِ للمَوطنِ الّذي","مغَاني غوانيه إِليهِ جَواذبي",52,"ب",2,0],["أَحِنُّ وَما أَهواهُ رُمحٌ وَصارِمٌ","وَسابِغَةٌ زُعفٌ وَذو مَيعَةٍ نَهدُ",53,"د",1,0],["أحنُّ إليها كلَّ يومٍ وليلةٍ","وإنْ كانَ منها بالفؤادِ كلامُ",54,"م",1,0],["أَحِنُّ إِذا رَأَيتُ جَمالَ سُعدى","وَأَبكي إِن رَأَيتُ لَها قَرينا",55,"ن",2,1],["أَحِنُّ إِذا ماعَسعَسَ اللَيلُ حِنَّةً","تُذيبُ الحَوايا أَو تَفُضَّ التَراقِيا",56,"ي",2,0],["أَحِنُّ إِلَيهِ حَنَّةَ النيبِ هَجَّرَت","وَقَد ذَكَرَت ماءَ العُضاهِ صَوادِيا",56,"ي",2,0],["أَحِنُّ إِذا رَأَيتُ جِمالَ قَومي","وَأَبكي إِن سَمِعتُ لَها حَنينا",57,"ن",2,1],["أَحِنُّ إِلَيها كُلَّما ذَرَّ شارِقٌ","كَحُبِّ النَصارى قُدسَ عيسى بنَ مَريَما",58,"م",2,0],["أَحِنُّ إِلى لَيلى وَأَحسَبُ أَنَّني","كَريمٌ عَلى لَيلى وَغَيري كَريمُها",59,"م",3,1],["أَحِنُّ إِلى أَرضِ الحِجازِ وَحاجَتي","خِيامٌ بِنَجدٍ دونَها الطَرفُ يَقصُرُ",60,"ر",1,1],["أَحِنُّ إِلى نَجدٍ وَإِنّي لَآيِسٌ","طَوالَ اللَيالي مِن قُفولٍ إِلى نَجدِ",61,"د",1,1],["أَحِنُّ إِلى نَجدٍ فَيا لَيتَ أَنَّني","سُقيتُ عَلى سُلوانِهِ مِن هَوى نَجدِ",62,"د",1,0],["أَحِنُّ إِلى لَيلى وَإِن شَطَّتِ النَوى","بِلَيلى كَما حَنَّ اليَراعُ المُثَقَّبُ",63,"ب",1,1],["أَحنو وَأَعطِفُ لا مالٌ وَلا وَلَدٌ","لي بِالشَآمِ وَلا قُربى وَلا نَسَبُ",64,"ب",1,0],["أَحِنُّ إِلى اِستِقلالِها وَإِخالُهُ","إِذا ما رَأَبنا الصَدعَ أَمراً مُحَتَّما",65,"م",2,0],["أَحِنُّ إِلى مَحاسِنِ أُمِّ بَكرٍ","وَدونَ لِقائِها دُكحٌ وَنُكحُ",66,"ح",1,0],["أَحِنُّ لِما أَلقى وَإِن جِئتُ زائِراً","دُفِعتُ كَأَنّي وَالعَدُوَّ سَواءُ",67,"ا",2,0],["أَحِنُّ إِلى أَمَلٍ فاتَني","وَما لِلشَبوبِ وَعَيشِ الفِرى",68,"ر",2,0],["أَحِنُّ وَما أَجُنُّ سِوى غَرامٍ","بِغَيرِ الحَقِّ مِن حِنٍّ وَجِنِّ",69,"ن",1,0],["أحن إلى عهد اللوى وَهو منقَضٍ","وأَبكي لنأي الدار وَالدار بلقع",70,"ع",1,0],["أحنُّ للبرقِ مِن تلقاءِ أَرضِهِمُ","وَلي فُؤادٌ إِلى الآلافِ حَنّانُ",71,"ن",1,1],["أَحِنُّ إِلى تِلكَ المَنازِلِ كُلَّما","غَدا طائِرٌ في أَيكَةٍ يَتَرَنَّمُ",72,"م",1,0],["أَحِنُّ إِلَى أَهْلِي وَأَذْكُرُ جِيرَتِي","وَأَشْتَاقُ خُلانِي وَأَصْبُو لِمَأْلَفِي",73,"ف",2,0],["أَحِنُّ إِلَى وادِي النَّقَا ويَسُرُّنِي","عَلَى بُعْدِهِ أَنْ تَسْتَهِلَّ سُعُودُهُ",74,"د",2,0],["أَحِنُّ لَهُمْ شَوْقاً عَلَى أَنَّ دُونَنَا","مَهامِهَ تَعْيَا دُونَ أَقْرَبِها الرُّبْدُ",75,"د",1,0],["أَحِنُّ لَهَا شَوْقاً وَدُونَ مَزارِهَا","مَسَالِكُ يَأْوِيهَا الرَّدَى وَمَنَادِحُ",76,"ح",1,0],["أَحْنَقُوا أُمَّهُ عَلَيْهِمْ وَزَادُوا","ذِمَماً لِلقَتِيلِ فِي الأَعْنَاقِ",77,"ق",1,0],["أَحِنُّ إِلَى مَعَالِمِهَا وَأَهْوَى","خِلاَلَ عَمِيدِهَا الشَّهْمِ النَّبِيلِ",78,"ل",1,0],["أَحنو عَلَيكِ وَفي فُؤادي لَوعَةٌ","وَأَصُدُّ عَنكِ وَوَجهُ وُدّي مُقبِلُ",79,"ل",1,0],["أَحِنُّ وَللأَنضاءِ بِالغَورِ حَنَّةٌ","إِذا ذَكَرَت أَوطانَها بِرُبا نَجِدِ",80,"د",1,0],["أحَنُّ على المجروحِ من أمِّ واحدٍ","وأرفقُ من طفلٍ إذا داعب الأمّا",81,"م",2,0],["أَحْنُوا إلى قَلَمي كأنّ صَرِيرَه","في مِسْمَعي المكْدُودِ رَنَّةُ عُودِ",82,"د",1,0],["أَحْنُو عليه من الهَجيرِ يَمَسُّه","ومن النَّسِيم يَهُزُّ من أسَلاتِه",83,"ت",2,0],["أحنى له التاريخ مفرِق رأسه","وأحلَّه في الصدر من صفحاته",84,"ت",2,0],["أحنّ فأقتات ذكرى اللّقا","لعلّي بذكراه أن أسهدا",85,"د",2,0],["أحنُّ إلى أرض العراق ويعتلي","فؤادي خُفوقٌ مثلَما يَخفُق الآل",86,"ل",1,0],["أحِنُّ إلى شَبَحٍ يَلْمَحُ","بِعينَيَّ أطيافُه تَمْرَحُ",87,"ح",1,1],["أحنُّ إليهِ بليغَ الصُمُوت","معانيهِ عَنْ نَفْسِها تُفْصِح",87,"ح",1,0],["أحِنُّ له : وكأنَّ الحياةَ","خضراءَ مِنْ دونه ، صَحْصَح",87,"ح",1,0],["أحِنُّ له : وأحبُّ الكَرَى","لسانحةٍ منهُ قد تَسْنَح",87,"ح",1,0],["أحِنُّ له : ليسَ يَقْوَى النَّعيمُ","وكُلُّ لذاذاتهِ مُرْبِح",87,"ح",1,0],["أحنى على الحرّ من أمّ على ولد","فالحرّ في مصر كالورقاء في الحرك",88,"ك",1,0],["أحنّ إليها رائحات وعوّدا","سلام عليها رئحات وعوّدا",89,"د",2,0],["أحنّ إليه في العشيّ وفي الضحى","حنين جاءه الشّوق داعيا",90,"ي",2,0],["أحِنُّ إلى أملٍ فاتَني،","وما للشَّبوبِ وعيشِ الفِرا",91,"ر",2,0],["أحنو عليه معانقا متنهدا","فكأنني أمّ تضمّ صغيرا",92,"ر",2,0],["أحنو على كلّ قبر من قبورهم","أبكيه .. حتّى بكى من لوعتي الحجر",93,"ر",1,0],["أحنّ إذا فارقتني بعض ساعة","وتحمد في الحبّ اللّجاجة لا الغبّ",94,"ب",1,0],["أحنو على جُرحِها الدامِي وأمسحُهُ","عِطراً تَطيبُ بهِ الدنيا وإيمانا",95,"ن",2,0],["أحِنُّ إلى الخَطِّ المليسِ ورُقْعَةٍ","تطايَرُ كالنجماتِ أحرُفها النشوى",96,"و",2,0],["أحنوا وأعطف لا مالٌ ولا ولدٌ","لي بالشآم ولا قربى ولا نسب",97,"ب",1,0],["أَحِنُّ إذا رَأَيْتُ جَمالَ سُعْدَى ، أَحِنُّ إذا رَأَيْتُ جَمالَ سُعْدَى ،","وأبكي، إنْ رأيتُ لها قرينا",98,"ن",2,1],["أَحِنُّ إلى لَيْلَى وإنْ شَطَّتِ النَّوَى","بليلى كما حن اليراع المنشب",99,"ب",1,1],["أحِنُّ إلَيها كُلَّمَا ذَرَّ شَارِقٌ","كحب النصارى قدس عيسى ابن مريما",100,"م",2,0],["احن لحب طوره الجور والجفا","كأني لآلامي به ميت حي",101,"ي",1,0],["احن لحب حل في القلب شخصه","فمنه لعمري محضر القلب ما خلا",102,"ل",2,0],["احن اليك في صوتي خفوت","كما من ناقتي خفت البغام",103,"م",1,0],["احن لكم حتى تحن مطيتي","وعيبة زادي والازمة والرحل",104,"ل",1,0],["احن الى مجلا محياك والها","ولوعا كما حن الحمام الى الوكر",105,"ر",1,0],["احن الى بغداد والشوق مقلق","لأفرش حر الخد في ساحة المهدي",106,"ي",1,1],["أحن لارض انت فيها وان تكن","حوت هي من اقصى الاباعد اغرابا",107,"ب",2,0],["أحِنُّ شَوقاً إلى ديارٍ","رأيتُ فيها سَنى الجَمال",108,"ل",1,0],["أَحِنُّ لَدى المَنازِلِ وَهيَ قَفرٌ","كَما حَنَّت لَدى البَوِّ العَجولُ",109,"ل",1,0],["أحنّ لرؤياكم وضرّي مانعي","وذكركم أنساني الضر والبلوى",110,"و",2,0],["أَحِنُّ إِلى تَقبيلِ مَوطيءِ نَعلِهِ","لَعَلّيَ أَروى بِالَّذي كُنتُ أَظمأُ",111,"م",2,0],["أَحِنُّ حنين والهة بشقب","تناوشت الضباع كلاه أكلا",112,"ل",2,0],["أحنُّ حنينَ والهةِ المطايا","وأبكي مثلما يبكي الصغيرُ",113,"ر",1,0],["أحن إلى وادى العقيق واهله","كمثل حنين الأم للولد البكر",114,"ر",1,0],["أَحِنُّ إِلى العَقيقِ وَساكِنيهِ","وَما يَخلو المُتَيَّمُ مِن حَنينِ",115,"ن",1,0],["أَحنو عليها وأَستسقي لخطّتها","يدي سحابٍ جرورِ الذيلِ سَحّابِ",116,"ب",1,0],["أَحنى وَأَعدَلُ مِن كِسرى غَداةَ رَمى","بِالسَهمِ قَلبَ اِبنِهِ في الحَقِّ لَم يُبَلِ",117,"ل",1,0],["أَحِنُّ إِلَى الرَّملِ اليَمانِى صَبَابَةً","وَهَذَا لَعَمرِى لَو رَضِيتُ كَثِيبُ",118,"ب",1,0],["أحِنُّ إلى الفُسطاط ما لم أكن به","حنينَ طَليحِ الرَّكْبِ بعدَ ذهابه",119,"ب",2,0],["أحْنَتْ لِرؤيَتِكَ الأكوانُ هامَتَها","واسْتَعَجَبَ الغَدُ ماذا يَصْنَعُ الرَّجُلُ؟",120,"ل",1,0],["احنو عليهِ باسماً طرباً ولا","عجبٌ ولا حرجٌ حنوَّ المرضِعِ",121,"ع",1,0],["أحنُّ إلى دينِ اليهودِ من أجلهِ","ولولا حذارُ السيفِ كنتُ يهوديَّا",122,"ي",2,1],["أحنّ إليها وهي تحمل خاتما","من الماس يستهوى العيون ويستسبى",123,"ب",2,0],["أحنو عليك","أرنو إليك",124,"ك",1,0],["أحنو عليها وهي تنظر لي","فتزيد عرف ودادها ضوعا",125,"ع",2,0],["أحن إذا ابتعدت لحظة","وإن غبت عن عينها حنت",126,"ت",1,0],["أحن إلى منهل من خصال","وورد من الشم لا يذبل",127,"ل",1,0],["أَحِنُّ إِلى لِقائِكَ كُلَّ يَومٍ","كَما يَحنو إِلى الوَطَنِ الغَريبُ",128,"ب",1,0],["أَحِنُّ لِرائِقٍ مِن خَمرِ فيهِ","يَفوقُ الشَهدَ وَالماءَ الزُلالا",129,"ل",2,0],["أَحِنُّ إِذا حَنَّت وَاِصبو إِذا صَبَت","وَكَيفَ عَنائي أَن يَكونَ عَناها",130,"ا",3,0],["أحنو إِلَيكَ حَنينَ النِياق","لَهُنَّ بِأَكنافِ نَجدٍ غَرام",131,"م",1,0],["أَحنو عَلَيهِ وَهوَ بِال","ماءِ الزُلالِ مُشرِقي",132,"ق",2,0],["أَحِنُّ إِلى أَيّامِها وَعُهودِها","كَما حَنَّتِ الوَرقُ المُوَلَّهَةُ السُلبُ",133,"ب",1,0],["أَحِنُّ وَأَصْبُو كُلَّ حِينٍ إِلَ