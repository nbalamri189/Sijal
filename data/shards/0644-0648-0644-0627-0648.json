{"poems":[[55,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[69,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[240,"سقاك سار من الوسمي هتان","https://www.aldiwan.net/poem31744.html","البسيط"],[333,"لولا ولولا ولولا","https://www.aldiwan.net/poem54933.html","المجتث"],[412,"الليل حيث حللن فيه نهار","https://www.aldiwan.net/poem50176.html","الكامل"],[422,"عاد الفؤاد من الجوى ما عادا","https://www.aldiwan.net/poem54072.html","الكامل"],[422,"اليوم أصبح فيك الوقت منتظما","https://www.aldiwan.net/poem54127.html","البسيط"],[422,"هاج القرام وهيجا بلبالي","https://www.aldiwan.net/poem54163.html","الكامل"],[469,"من هم المضنى ومن شجنه","https://www.aldiwan.net/poem3411.html","عموديه"],[519,"سطعت شموس قبابهم بزرود","https://www.aldiwan.net/poem20810.html","الكامل"],[519,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[519,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[580,"تخطو وتخطر بين الحلي والحلل","https://www.aldiwan.net/poem3024.html","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48671","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48770","الكامل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100149","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80259","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126138","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136102","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136155","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64625","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108507","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114700","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27586","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27400","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27724","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27312","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27814","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77352","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93666","البسيط"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100948","البسيط"],[2818,"","https://poetry.dctabudhabi.ae/diwan/poem/101870","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134205","البسيط"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140295",""],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100831","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62814","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138707",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45747","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125803","الكامل"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/141095","المنسرح"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139735",""],[4809,"تهنئة للمعلم","https://www.poetsgate.com/ViewPoem.aspx?id=211864",""],[4869,"الردي يشتك ..","https://www.poetsgate.com/ViewPoem.aspx?id=151723",""],[4984,"معركة \" الشوابير\"","https://www.poetsgate.com/ViewPoem.aspx?id=191622",""],[5022,"البردة المالكية","https://www.poetsgate.com/ViewPoem.aspx?id=186512",""],[5136,"أرأيت أية أزمة بالمغرب","https://www.poetsgate.com/ViewPoem.aspx?id=121521",""],[5277,"جوريّة قيسية","https://www.poetsgate.com/ViewPoem.aspx?id=200587",""],[5277,"صريخُ القوافي..","https://www.poetsgate.com/ViewPoem.aspx?id=206053",""],[5397,"بشرا بوجهك ثغر الدهر مبتسم","https://www.poetsgate.com/ViewPoem.aspx?id=157924",""],[5397,"بكيت شجواً على الأطلال والدمن","https://www.poetsgate.com/ViewPoem.aspx?id=157909",""],[5956,"اشتاقتِ الأرواحُ للأرواحِ","https://www.poetsgate.com/ViewPoem.aspx?id=182127",""],[5956,"شمسٌ وظلال","https://www.poetsgate.com/ViewPoem.aspx?id=192981",""],[5956,"خير أمة وخير إقامةِ","https://www.poetsgate.com/ViewPoem.aspx?id=194182",""],[5956,"الخير أجمعُه صديقي المنتظِرْ","https://www.poetsgate.com/ViewPoem.aspx?id=194286",""],[5956,"ما عيب شهم أن يؤازر أشهما","https://www.poetsgate.com/ViewPoem.aspx?id=202505",""],[6031,"يَا ذَا الذي أَلِفَ الثَّوَاءَ وذِكْرُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=46410",""],[2220,"استغفرُ اللهَ منْ علمٍ أفوهُ بهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11427&r=&rc=301",""],[6305,"حياتي ... أنْ أموتَ فِداك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87348&r=&rc=22",""]],"verses":[["لَولا وَقارُكَ في نَصلٍ سَطَوتَ بِهِ","فاضَت مَضارِبُهُ مِن خِفَّةِ الطَرَبِ",0,"ب",1,0],["لولا وُجُودُ الصَّاحِبَينِ كِلَيهِما","صارتْ بُيُوتُ العالَمِينَ رُمُوسا",1,"س",2,0],["لَولا وَلاءُ بَني العَباسِ ما ثَقُلَت","لِمُفلِسٍ مُخسِرٍ في الحَشرِ ميزانُ",2,"ن",1,0],["لولا ولولا ولولا","عبدٌ قديم لمولى",3,"ل",2,1],["لولا ولولا ولولا","كرامة ما تخلّى",3,"ل",2,0],["لَولا وَقارُ في دِمَشق وَأَهلها","طارَت لإِفراطِ السُرورِ وَطاروا",4,"ر",3,0],["لولا ورودُ بحار علمك إذ طمت","لم تعرف الإصدار والإيرادا",5,"د",2,0],["لولا وجودك هذا الداء ما حسما","وذلك الصدع لولا أنت ما التأما",6,"م",2,0],["لولا وجود ابن الجميل وجوده","قلت الزَّمان من الأكارم خالي",7,"ل",2,0],["لولا ولوعي بلين قامته","ما شاقني صادحٌ على فننه",8,"ن",2,0],["لولا وُرودُك للجزيرةِ ما زَهَتْ","وَجناتُ جنّاتٍ لها بورودِ",9,"د",1,0],["لولا وجودُك فيه أهلُه هلَكوا","كذاك يهلِكُ بعد الوابِلِ العُشُبُ",10,"ب",1,0],["لولا وُجودُك يا اِبنَ المصطفى غُصِبَتْ","منّا حُقوقُ معالٍ قد ورِثْناها",11,"ا",3,0],["لولا وَزارتُه وهْيَ التي كَفَلتْ","سياسةَ الخلقِ كان الخَلْقُ كالمَهَل",12,"ل",1,0],["لولا وسيلته إليهم لم يطع","عاص ولم يحقن دم مهدور",13,"ر",1,0],["لولا وقار أبيك بين وفوده","ماج المكان من السرور ومادا",14,"د",2,0],["لولا وجودهم لما","قام الوجود وما تقوم",15,"م",1,0],["لَولا وَقارق تَسامى فَوقَ ساحَتِهِ","لَكانَ يَرقُص في ضيفانِهِ طَرَبا",16,"ب",2,0],["لولا وقوع نظري عليها","ما أحد منكم هوى إليها",17,"ه",2,0],["لولا وصال أحيبابي وقربهم","أرجو لما طاب لي أنسي ولا طربي",18,"ب",2,1],["لولا وجود الذل في شرع الهوى","ما نال ذو الوجدان ما هو واجد",19,"د",1,0],["لولا وثوقي بك في صروفه","لانشق ذرع العزم منى وصما",20,"ا",1,0],["لولا ورود رضابهن على الطلا","ما طاب منها المشرب الوضاء",21,"ا",2,0],["لولا وقائِعُهُ في سَالِف الأُمَمِ","لم يَحفل النّاسُ بالقِرطاس والقَلمِ",22,"م",1,0],["لولا وجودُ القبضِ ما انبسطتْ لنا","كفُّ الكريمِ بسِيبهِ الغَيداقِ",23,"ق",1,0],["لولا وارثتُنا خير الأنام لما","حصلتها السيد المختار من مُفَر",24,"ر",1,0],["لولا وجودُ الذي تراه","ما أوجد الصبحَ والمساء",25,"ا",2,0],["لولا وجودِ النفسِ الأنزه","ما لاح عين العالمِ المشبه",26,"ه",1,1],["لولا وجودي ما عرفت وجوده","ولذاك كنتُ لكونه مغتالا",27,"ل",2,0],["لولا وجودُ صفاتِه في غيره","مشهودةٌ ببراعةِ ما نالا",27,"ل",2,0],["لَولا وَفاءُ أَبي بَكرٍ لِأُمَّتِهِ","ما كانَ مِن بَعدِهِ الفاروقُ واليها",28,"ي",3,1],["لَولا وُجودكُم يا آل فاطِمة","فَالناس ما مَيَّزوا دينا وَلا عرَفوا",29,"ف",3,0],["لولا ولاؤك لم نبسط إليك يدا","من الرجاء ولم نسألك غفرانا",30,"ن",2,0],["لولا وجودك قائما من بعده","بالأمر قام لرعي حق ما رعي",31,"ع",2,0],["لولا وصالك للجنات في شرف","لأصبحت تغبط الأرض السموات",32,"ت",1,0],["لولا وقارك في ناد تحل به","إذاً لماج به في أهله الطرب",33,"ب",1,0],["لولا وُجودي وظُهورُ بَرقي","ما أنزل اللَه لكم من رزق",34,"ق",1,0],["لولا وراثة ملكهم ما زانهم","عرش ولا حاط الركاب عرمرم",35,"م",1,0],["لوْلا وقارُكَ تاجَ الملكِ لانهدمتْ","قواعدُ الأرضِ وانهدّت رَواسيها",36,"ي",3,0],["لَولاَ وَلوماً يَلزَمانِ الإبتِدَا","إذَا امتِناعاً بوُوجودٍ عَقَدَا",37,"د",2,0],["لولا وقوفك في الطفوف لما بقي","للدين رسمٌ لا ولا ذكرُ",38,"ر",1,0],["لَولا وَجود بَني الحسين أَولي الهُدى","كُنا كَمَن ساروا بِغَير هداة",39,"ه",1,0],["لولا وللذكرى العزيزة","حقها المرعي ذكرى",40,"ر",2,0],["لولا ولاء ظفرت منك به","لكنت أشدو بتونس جزعا",41,"ع",2,0],["لولا ولاهم في البرية لم يكن","يرضى الإله صلاتها وصيامها",42,"م",3,0],["لولا وجودكما على هذا الثرى","ما اعشوشبت بيدٌ ولاغيثٌ همى",43,"م",2,0],["لولا وجود الشمس ماكان به فيّ","لايالزمن ما اظن تخفاك علتك",44,"ك",1,0],["لولا وصول الطائرات وأُنْجِدوا","كان استمر على القتال فواصله",45,"ل",2,0],["لولا وشاية دمعي ما أتيح لهم","تفسير ما أضمر التامور من دُجم",46,"م",1,0],["لولا ورود الحكمة الغراء في","سلك من النظم النسيق المعجب",47,"ب",1,0],["لولا..ولولا..قد بصمتُ بخدِّها","ختمَ الولاءِ..وبيعةَ الخطّابِ",48,"ب",1,0],["لولا وعيدُ اليأسِ متُّ بحسرتي","والوعدُ..من كلِّ الكبائر..أكبرُ",49,"ر",1,0],["لولا وجود علي جده لغدا","كالجاهلية طوعا يعبد الصنم",50,"م",1,0],["لولا وصيته قامت لهم هممٌ","معدودة في الوغى من أمنع الجنن",51,"ن",1,0],["لولا ودادُكَ والجمالُ سويّة","لم نرتفع للأوج دون جناحِ...",52,"ح",1,0],["لولا وجودُك ما استطعت نضالا","ولَكانَ معظمُ همتي قد زالا",53,"ل",2,1],["لولا وصلتم قلبنا بقلوبكم","بالفضلِ هذا لم نعش بهناءةِ",54,"ه",1,0],["لولا وجودُهُ في حياتي مُوْجِباً","لَمكثتُ سلبيّاً بلا أدنَى شررْ",55,"ر",1,0],["لولا وشاةٌ مارقون تآمروا","غدراً عليه لزاد ربّي الأنعُما",56,"م",2,0],["لَولاَ وِدَادٌ أُحكِمتْ أسْبابُهُ","ما بينَنا ووَسَائلٌ لَنْ تَخْلَقَا",57,"ق",2,0],["لولا وراثتنا خيرَ الأنامِ لما","حصلتها السيدَ المختارَ منْ مضرِ",58,"ر",1,0],["لولا وجودُكَ أضحى الكونُ مُفتقِراً","ظمْآنَ مُستعِراً يسعَى لمُستعَر",59,"ر",1,0]]}