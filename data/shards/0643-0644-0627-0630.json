{"poems":[[79,"كل أذى فاجعله ما شئته","https://www.aldiwan.net/poem36738.html","السريع"],[53,"استقبل المهرجان بالفرح","https://www.aldiwan.net/poem9407.html","المنسرح"],[53,"ألا ليت شعري حين أخلفت موعدي","https://www.aldiwan.net/poem62968.html","الطويل"],[79,"كلُّ أذًى واجعله ما شئتَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=33278",""],[139,"حق على شعراء مصر رثاكا","https://www.aldiwan.net/poem49172.html","الكامل"],[147,"ما الحسان فما لهن عهود","https://www.aldiwan.net/poem11745.html","الكامل"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[369,"ورد الخدود ودونه شوك القنا","https://www.aldiwan.net/poem60636.html","الكامل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113945","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101046","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74193","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65178","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86312","الكامل"],[3553,"","https://poetry.dctabudhabi.ae/diwan/poem/17664","الطويل"],[5448,"أطع ربك الباري وصفوة رحمان","https://www.poetsgate.com/ViewPoem.aspx?id=138060",""]],"verses":[["كُلَّ أَذىً فَاجْعَلْهُ مَا شِئْتَهُ","يَقْطَعُهُ الْمَوْتُ فَأَهْونْ بِهِ",0,"ه",1,1],["كُلٌّ إذا ما اصْطَبَحْت مُصْطبحٌ","مِن جودِ كَفَّيْكَ خيرَ مُصْطَبَحِ",1,"ح",1,0],["كلا ذا وهذا يَتَّقي الخلُّ مثلَهُ","على العهد من خلانه ويحاذر",2,"ر",1,0],["كلُّ أذًى واجعله ما شئتَهُ","يقطَعُه الموتُ فاهْوِنْ به",3,"ه",1,1],["كلٌّ إذا ذكر القريضَ قصاره","أن ينضوي في الشعر تحت لواكا",4,"ك",2,0],["كُلٌّ إِذا ما الحَربُ شُبَّت عامِرٌ","وَإِذا أَتى الأَضيافُ فَهوَ لَبيدُ",5,"د",1,0],["كلا ذلة قد أنبتت كل لذة","من العسر بأتى اليسر في حظ سغبان",6,"ن",1,0],["كُلٌّ إذا استَرعَوْهُ يَسْمَنُ مُهزِلاً","في ذا الزَّمانِ وأنت تَهزِلُ مُسْمِنا",7,"ن",2,0],["كِلا ذينِ عند اللَهِ والأمرُ أمرهُ","فلِلّهِ ما أعطى ولِلّه ما أخَذ",8,"ذ",1,0],["كلٌّ إذا جن الظلام رأيته","جم الأسى وقفاً على الأثام",9,"م",1,0],["كُلٌّ إذَا مَا نَابَهُ أمرٌ يُرَى","مُتَوجِّهاً بِضَرُورَةِ الإنسَانِ",10,"ن",1,0],["كُلٌ إذَا قَابَلتَهُ بِالنَّصِّ قَا","بَلَهُ بِتَأوِيلٍ بِلاَ بُرهَانِ",10,"ن",1,0],["كُل إِذا أَبصَرته شبهته","بِأَخيه وَالشَيئان يَشتبهان",11,"ن",1,0],["كلٌّ إذا ذكر الميزان كان لهُ","عليه في كفّة الميزان رُجحانُ",12,"ن",1,0],["كُل اِذا احتَدم الخِصام وَفُوِّقَت","فيهِ النِبال فَلا نَراهُ يُضامُ",13,"م",1,0],["كِلا ذَينِكَ الحَيَّينِ أَصبَحَ دارُهُ","نَآنِيَ إِلاّ أَن تَخُبَّ القَصائِدُ",14,"د",1,0],["كلا ذلة قد أنبتت كل لذة","من العسر يأتي اليسر في حظ سغبان",15,"ن",1,0]]}