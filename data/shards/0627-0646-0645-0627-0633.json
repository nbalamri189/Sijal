{"poems":[[47,"إنما سلطان بدر عرس","https://www.aldiwan.net/poem63472.html","الرمل"],[102,"سوف تذكرين","https://www.poetsgate.com/ViewPoem.aspx?id=50397",""],[102,"تقرير إلى عام 71 حيث كنا","https://www.poetsgate.com/ViewPoem.aspx?id=50375",""],[113,"أدر المدامة يا نديمي","https://www.aldiwan.net/poem16378.html","مجزوء الكامل"],[308,"غزال سرب حلا فيه التغزل لي","https://www.aldiwan.net/poem57889.html","البسيط"],[315,"سيدي والظنون فيك جميلة","https://www.aldiwan.net/poem59510.html","الخفيف"],[382,"قم بنا يا أخا المودة صبحا","https://www.aldiwan.net/poem66889.html","الخفيف"],[409,"إنما سمى العذار عذارا","https://www.aldiwan.net/poem33896.html","الخفيف"],[473,"يا أخا قط ما اقتضى","https://www.aldiwan.net/poem59798.html","مجزوء الخفيف"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83303","الخفيف"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34416","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34414","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70695","المديد"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62532","الرمل"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82240","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59158","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1303,"","https://poetry.dctabudhabi.ae/diwan/poem/199261","السريع"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108707","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123063","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48208","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77227","الخفيف"],[2664,"","https://poetry.dctabudhabi.ae/diwan/poem/143085","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93943","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93831","البسيط"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82823","البسيط"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103791","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94325","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94535","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81278","الرمل"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138732",""],[4407,"","https://poetry.dctabudhabi.ae/diwan/poem/203755","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133155","المجتث"],[4767,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=179435",""],[4869,"ظلم خلق الله","https://www.poetsgate.com/ViewPoem.aspx?id=151717",""],[4869,"ظلم خلق الله","https://www.poetsgate.com/ViewPoem.aspx?id=162815",""],[4955,"إن ماسُقيت المر فاعلم أنّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=188761",""],[5628,"الولادة الجديدة","https://www.poetsgate.com/ViewPoem.aspx?id=178478",""],[5691,"الأماني الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=206740",""],[5790,"عندي غرام وتبريح وتذكار","https://www.poetsgate.com/ViewPoem.aspx?id=112041",""]],"verses":[["إِنَّما سُلطانُ بَدر عُرُسٌ","مُشبِهٌ في الحُسنِ مُلكَ المُعتَضِد",0,"د",1,1],["انما سوف تذكرين وقوفي","بين كفيك أجتدي أو أصافي",1,"ف",2,0],["إنما سوف ندعي ولتصدق","يا ( وصابان ) ولتثق يا ( رجام )",2,"م",1,0],["إِن ماسَ يَذري بِالقَنا","وَإِذا رَنا فَبِكُل ريم",3,"م",1,0],["إن ماس وانعطفت يوماً شمائله","فهل رأيت قضيب البان ريانا",4,"ن",2,0],["إنما سامنا الكتاب ظلوم","لا يرجى دفاعه بالحيله",5,"ل",2,0],["إنما ساعة الزيارة حظٌّ","من حبيبٍ يريك بالوعد مزحا",6,"ح",2,0],["إنما سمى العذار عذاراً","لاعتذاري إذا هتكت العذارا",7,"ر",2,1],["إِنَّما سُمِّيَ الصَدي","قُ صَديقاً لِصِدقِهِ",8,"ه",1,0],["إِن ما سالَ في ثَناهُ يَراعٌ","لا َما سَحَّ مِن يَدَيهِ غَمامِ",9,"م",1,0],["إِن ماسَ في أَرضِ قرطاسٍ لَهُ قَلَمٌ","أَزرى بِغُصنٍ من الرَوضاتِ ميّاسِ",10,"س",1,0],["إِن ماسَ تَجري مُقلَتي بِدِمائِها","فَكَأَنَّني فيها طُعِنتُ بِقَدِّهِ",11,"د",2,0],["إنما سلطانُ بدْرُ هدىً","وملاذُ اللائذِ الناصي",12,"ص",2,1],["إنما سيرتنا العدل ولن","ننثني عن نشره أو نذهبا",13,"ب",2,0],["إِنَّما سمّي الفَوارِسُ بِالفُر","سِ مُضاهاة رِفعَةِ الأَنسابِ",14,"ب",1,0],["إنْ مَاسَ فَالغُصْنُ بِالأوْرَاقِ مُسْتَتِرٌ","أوْ لاحَ فَالبَدْرُ بِالأنواءِ مُحْتَجِبُ",15,"ب",1,0],["ان ماس فالغصن بعدوه العوج أو","يلتاح فالشمس تعلوها الخسوفات",16,"ت",1,0],["إن ماس حِبِّي أو بدَا خدُّه","أظهرتُ فيه كلَّ معْنىً دقيقْ",17,"ق",1,1],["إن ماس يوماً على الجلاس تحسبه","موشَّحاً بعيون الناس متَّزرا",18,"ر",2,0],["إن ماس من هَيَف أو مال من دَنَف","مَن ذا يقايسه أو من ذا يُقاسيه",19,"ي",2,0],["إِنما سيرتهُ الغَرَّا ترى","سيرةَ الصدِّيق عدْلاً أو عُمَرْ",20,"ر",1,0],["إِنَّما ساقَ حِزبَهُ لِلمَنايا","عِندَما ساقَنا بِسوطِ العَميدِ",21,"د",1,0],["إنما سؤدد الفتى المال والعلم","وما ساد قط فقر وجهل",22,"ل",1,0],["إن ماس أزرى بالغصون رشاقة","أو لاح أخجل حسنه بدر الدجا",23,"ج",2,0],["إن ماس بالكاس أو تثنى","منه قدود الغصون تخجل",24,"ل",1,0],["إِن ماس في الحُلَّةِ الخَضراءِ قام عَلى","أَغصانِ قامَته قُمرى اليها غَنّى",25,"ن",2,0],["ان ماس فالمرط منه مثر","بما حوى والوشاح معسر",26,"ر",1,0],["إن ماس ضاعَت طيوبٌ بالأريج سَرَت","مِسكاً وفيها من القنطار قنطارُ",27,"ر",1,0],["إن ماس طابت من أريج صفاته","نسماتُ طيبٍ بالصبا قد سارا",28,"ر",2,0],["إِنَّما سحر عَينيك","بِما تَسحر مِني",29,"ن",2,0],["إنما سبقهم لبكر وعمرو","مثل ما يسبق الجواد الحمارا",30,"ر",2,0],["إنما سرني صدودك عني","وطلابيك وامتناعك مني",31,"ن",2,1],["إن ماس عند الصباح","أوجاس وقت الرواح",32,"ح",1,0],["إنما سوريَ أقوى","من بيوت شاهقات",33,"ت",1,0],["ان مآسرى بْليلتي يعود لي سآرح","احدود غآليه من ترحآله لحلّه",34,"ل",2,0],["ان مآسرى بْليلتي يعود لي سآرح","احدود غآليه من ترحله لحلّه",35,"ل",2,0],["إنْ ما سُقيتَ المرَّ فاعلم أنّهُ","بالصبرِ يتلو المرَّ حلو مذاقِ",36,"ق",1,1],["إنَّ مأساتي كمأساةِ الذي","خذلتْهُ وَسَطَ البحْرِ السفينهْ",37,"ن",2,0],["إنَّ مأساتي بمنْ","حَوْلي من الناسِ ِالجَهولهْ!",38,"ل",2,0],["إن ماس وافتر من عجب ومن عجب","ما الغصن غصنا ولا النوار نوار",39,"ر",1,0]]}