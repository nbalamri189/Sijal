{"poems":[[46,"خلس البين أحمد بن يزيد","https://www.aldiwan.net/poem30261.html","السريع"],[77,"أحين ولت أنجم الأفق","https://www.aldiwan.net/poem69057.html","السريع"],[50,"مني إلى المتكبر","https://www.aldiwan.net/poem63350.html","مجزوء الكامل"],[53,"رُبَّ كعاب في حجابٍ لم تزلْ","https://www.poetsgate.com/ViewPoem.aspx?id=30250",""],[295,"يا ليالينا بوادي السلط قد","https://www.aldiwan.net/poem11711.html","الرمل"],[385,"لا يخدعنك جمال صوره","https://www.aldiwan.net/poem48759.html","مجزوء الكامل"],[463,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[469,"ولهي في الهوى حديث قديم","https://www.aldiwan.net/poem3279.html","عموديه"],[572,"ما لذة أكمل من طيبها","https://www.aldiwan.net/poem69618.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122551","الكامل"],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102215","الوافر"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128695","الخفيف"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101582","الرمل"],[2096,"","https://poetry.dctabudhabi.ae/diwan/poem/144617","المديد"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53030","الخفيف"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105660","الكامل"],[5190,"الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=175589",""],[5461,"هلّي على خدانها ياسحابه","https://www.poetsgate.com/ViewPoem.aspx?id=1315",""],[5956,"صحوةُ غرام","https://www.poetsgate.com/ViewPoem.aspx?id=185064",""],[2096,"ذكر الأحباب والوطنا","https://www.poetsgate.com/ViewPoem.aspx?id=106662",""]],"verses":[["خَلَسَ البَينُ أَحمَدَ بنَ يَزيدِ","لَيسَ فِعلُ الأَيّامِ بِالمَحمودِ",0,"د",1,1],["خُلسَةَ لحظِ الطَّرْفِ ثمّ انْثَنَتْ","سِرْبُ القَطا للآجِنِ الطَّرق",1,"ق",1,0],["خَلَستُ قُبلَةَ ظَبيٍ","قَد راحَ ماضِغُ سُكَّر",2,"ر",1,0],["خلسْتُ منها نظرة على وجل","آخِرُها أولُها من العجل",3,"ل",1,0],["خلَسٌ في غفلة الدهر مضت","نوّلَتنا في الهوى ما نتمنى",4,"ن",2,0],["خلس الحَمام حَياتها","وَاِبتَزَ مِن قَلبي سُروره",5,"ر",2,0],["خَلَسَ الردى قومي فأقعد نهضتي","أن لا يقومَ سواي حين أقومُ",6,"م",1,0],["خلسٌ ودعت كما ودع ال","غيثُ فقلبي الظامي إليها يهيم",7,"م",1,0],["خَلَسْتُهَا بِالْكُرْهُ مِنْ شَادِنٍ","يَعْشَقُ مِنْهُ بَعْضُهُ بَعْضَهْ",8,"ض",2,0],["خل سلبي","ما قُلتَ قَولاً لم أُطِعه",9,"ه",1,0],["خَلَسنا ليلةً من كفَّ دهرٍ","ضَنين باللَيالي الطَيِّباتِ",10,"ت",1,1],["خلّ سعدى وزيتبا وربابا","وسعادا وعلوة وأمامة",11,"م",2,0],["خلسة طوعية ما حرما","فعلها قط على المختلس",12,"س",1,0],["خلست من بين أضلعه","بالنوى قلباً له ضمنا",13,"ن",2,0],["خلسته لا أبرّئها","عينُ ريم الخيف حين رنا",13,"ن",2,0],["خُلَسٌ وَدَّعت كما ودع الغيث","فهاجت لها القلوب الظماء",14,"ا",2,0],["خلس أحاجي الحب منها","يستقل بحملها منك الضمير",15,"ر",1,0],["خَلَستُ نَظرَةَ شَوقٍ حِينَ غَفوَتِهَا","ومَا حَسِبْتُ بِأَنِّي مَن سَتَخلِسُهُ",16,"س",2,0],["خل سقاني في الهوى من شرابه","ماصد لي جاني والى جيت ماصد",17,"د",1,0],["خِلسةً تأوي طيوفي كلّ كهف","أنت تأويه وفي كلّ نُجُودِ",18,"د",1,0],["خلست من بين أضلعه","بالنوى قلبا به ضمنا",19,"ن",2,0]]}