{"poems":[[44,"خلس البين أحمد بن يزيد","https://www.aldiwan.net/poem30261.html","السريع"],[75,"أحين ولت أنجم الأفق","https://www.aldiwan.net/poem69057.html","السريع"],[48,"مني إلى المتكبر","https://www.aldiwan.net/poem63350.html","مجزوء الكامل"],[51,"رُبَّ كعاب في حجابٍ لم تزلْ","https://www.poetsgate.com/ViewPoem.aspx?id=30250",""],[288,"يا ليالينا بوادي السلط قد","https://www.aldiwan.net/poem11711.html","الرمل"],[377,"لا يخدعنك جمال صوره","https://www.aldiwan.net/poem48759.html","مجزوء الكامل"],[456,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[462,"ولهي في الهوى حديث قديم","https://www.aldiwan.net/poem3279.html","عموديه"],[565,"ما لذة أكمل من طيبها","https://www.aldiwan.net/poem69618.html","السريع"]],"verses":[["خَلَسَ البَينُ أَحمَدَ بنَ يَزيدِ","لَيسَ فِعلُ الأَيّامِ بِالمَحمودِ",0,"د",1,1],["خُلسَةَ لحظِ الطَّرْفِ ثمّ انْثَنَتْ","سِرْبُ القَطا للآجِنِ الطَّرق",1,"ق",1,0],["خَلَستُ قُبلَةَ ظَبيٍ","قَد راحَ ماضِغُ سُكَّر",2,"ر",1,0],["خلسْتُ منها نظرة على وجل","آخِرُها أولُها من العجل",3,"ل",1,0],["خلَسٌ في غفلة الدهر مضت","نوّلَتنا في الهوى ما نتمنى",4,"ن",2,0],["خلس الحَمام حَياتها","وَاِبتَزَ مِن قَلبي سُروره",5,"ر",2,0],["خَلَسَ الردى قومي فأقعد نهضتي","أن لا يقومَ سواي حين أقومُ",6,"م",1,0],["خلسٌ ودعت كما ودع ال","غيثُ فقلبي الظامي إليها يهيم",7,"م",1,0],["خَلَسْتُهَا بِالْكُرْهُ مِنْ شَادِنٍ","يَعْشَقُ مِنْهُ بَعْضُهُ بَعْضَهْ",8,"ض",2,0]]}