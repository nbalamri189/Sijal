{"poems":[[53,"شهر القيام وإن عظمت حرمته","https://www.aldiwan.net/poem65784.html","الوافر"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/199046","البسيط"],[159,"نالت على يدها ما لم تنله يدي","https://www.aldiwan.net/poem55472.html","البسيط"],[308,"قلبي الذي قد هام في غادة","https://www.aldiwan.net/poem58077.html","السريع"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104077","البسيط"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33859","البسيط"],[5596,"بين السبحية والحمراء","https://www.poetsgate.com/ViewPoem.aspx?id=206360",""]],"verses":[["كأنه طالبٌ ثأراً على فرسٍ","أجدَّ في إثر مطلوبٍ على رَمَكَهْ",0,"ك",2,0],["كأنه طالبٌ وتراً على فرسٍ","أجد في إثرِ مطلوبٍ على رمكهْ",1,"ك",2,0],["كأَنَّهُ طُرْقُ نَمْلٍ في أَنامِلِها","أَوْ رَوْضَةٌ رَصَّعَتْها السُّحْبُ بِالْبَرَدِ",2,"د",1,0],["كأنه طفلٌ شديدٌ الظما","في كل وقتٍ يشتهى ماما",3,"م",2,0],["كأنّه طبّق الدنيا إذا انبسطت","فرسانه لمغارٍ يَومَ إرسال",4,"ل",1,1],["كَأَنَّهُ طَلَلٌ أَقوَت مَعالِمُهُ","لَم يُبقِ مِنهُ البِلى شَيئاً وَلَم يَذَرِ",5,"ر",1,0],["كأنه طائر (الحمرا) وأيكتها","وسوحها غَرِدٌ بالسدر والسَلَم",6,"م",1,0]]}