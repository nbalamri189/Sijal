{"poems":[[71,"مربع من أنس سلمى أوحشا","https://www.aldiwan.net/poem28911.html","الرمل"],[104,"يا حسرتا ماذا دهى أهل الحمى","https://www.aldiwan.net/poem32944.html","الكامل"],[376,"ما استطاعت أن تهجر المهجورا","https://www.aldiwan.net/poem57455.html","الخفيف"],[376,"ما لطويل الكمد","https://www.aldiwan.net/poem57492.html","مجزوء الرجز"],[469,"ما لطيف زار منكم موهنا","https://www.aldiwan.net/poem3343.html","عموديه"],[473,"قد حلا في المذاق طعم الزمان","https://www.aldiwan.net/poem59642.html","الخفيف"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123367","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65055","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79845","الخفيف"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113925","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77356","المديد"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132714","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33269","المديد"],[4578,"من أطلع الريحان في الجلنار","https://www.poetsgate.com/ViewPoem.aspx?id=49426",""],[5452,"ستائر الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=112027",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""]],"verses":[["ما لطرفي أنتِ تبدين بكى","ولكفيّ ينثني مرتعِشا",0,"ش",2,0],["ما لطفُها ما اللين ذاك وكلهم","مستعمرون وكلُّه استعمارُ",1,"ر",1,0],["ما لطَرفي أحدَّه الشوقُ حتى","أنه من دمشقَ يُبصرُ صورا",2,"ر",2,0],["ما لطويلِ الكمدِ","وما لطولِ الأمدِ",3,"د",1,1],["ما لطيفٍ زار منكم موهنا","سلب القلب وعاف البدنا",4,"ن",2,1],["مَالطَرفي ذَنبٌ فَلِمَ لا أُريهِ","كَيفَ تُجلى عَرائِسُ الأَغصانِ",5,"ن",1,0],["ما لِطَرْفي وما لذا السَّهر الدا","ئم فيه وما لليلى وَلَيْلي",6,"ي",1,1],["ما لِطَرْفي حينَ أُعْذَلْ","يُطْلِقُ الدَّمعَ المُسَلْسَلْ",7,"ل",1,1],["ما لطيف الخَيال ضاعف شوقي","حين وافى بوعده المكذوبِ",8,"ب",1,0],["ما لطَعمِ المدامِ لولا ثنايا","ها وبَردِ العمورِ والأنيابِ",9,"ب",1,0],["ما لِطَرفي صادِياً أَبَداً","كُلَّما أَورَدتُهُ شَرِبا",10,"ب",2,0],["ما لطعين عاسل من قدها","برء سوى رضابها المعسل",11,"ل",1,0],["ما لطرفي إن يَرى الدهر انخداع","ما لفكري إن يُلاعي بالسماع",12,"ع",1,0],["ما لطرفٍ كان يلحظُهُ","كيفَ لا يثنى عن القمرِ",13,"ر",1,0],["ما لطفهُ إلا نسيمُ الصبا","ولفظه الألالي البحار",14,"ر",1,0],["ما لطرفي من هجوع","مذ رأى حبي يبن",15,"ن",1,0],["ما لطٓرفي يطارد الأوهاما","أرٓمتهُ وساوسٌ أو هاما",16,"م",2,1],["ما لطرفي وراءٓ نافر طيفٍ","كسرابٍ على المدى يتسامى",16,"م",2,0]]}