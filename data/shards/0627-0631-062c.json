aldiwan.net/poem4699.html","البسيط"],[477,"هل بعد بينك من جوى لمودع","https://www.aldiwan.net/poem15216.html","الكامل"],[477,"همت غراما بالبروق اللمع","https://www.aldiwan.net/poem15223.html","الرجز"],[477,"ما لحبل الوصل قد أمسى رماما","https://www.aldiwan.net/poem15278.html","الرمل"],[479,"أرجع سهامك للكنانه","https://www.aldiwan.net/poem36954.html","مجزوء الكامل"],[479,"عارف ما الشعر صاغيه","https://www.aldiwan.net/poem37208.html","مجزوء الرمل"],[482,"خود رمت عن قوس حاجبها سها","https://www.aldiwan.net/poem24485.html","عموديه"],[482,"أرجو الذي سجدت له الأكوان كر","https://www.aldiwan.net/poem24489.html","عموديه"],[500,"يا عيون النرجس الغض ألا","https://www.aldiwan.net/poem38029.html","الرمل"],[503,"أرجو إلهي وأخاف ذنبي","https://www.aldiwan.net/poem21715.html","الرجز"],[505,"رجعة الأنبياء","https://www.aldiwan.net/poem42461.html","الخفيف"],[514,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[529,"لا أترك الإلحاحا","https://www.aldiwan.net/poem37470.html","مجزوء الرجز"],[538,"يا حسرتي يا حسرتي","https://www.aldiwan.net/poem48262.html","عموديه"],[551,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[551,"من ذا يؤمل بعدك الأياما","https://www.aldiwan.net/poem47233.html","الكامل"],[551,"يا طلل الحي بذات النقا","https://www.aldiwan.net/poem47363.html","السريع"],[551,"هل ليالي بالمنقى رجوع","https://www.aldiwan.net/poem47718.html","الخفيف"],[551,"على مثله تذرى العيون دماء","https://www.aldiwan.net/poem48115.html","الطويل"],[558,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[558,"قلبي الذي في ذاتكم يتقلب","https://www.aldiwan.net/poem34938.html","الكامل"],[562,"قل للوزير إذا وقفت ببابه","https://www.aldiwan.net/poem52800.html","الكامل"],[563,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[573,"قف بربع الأسى وقوف الطليح","https://www.aldiwan.net/poem3652.html","الخفيف"],[575,"أوردته قبلي على عطش","https://www.aldiwan.net/poem2939.html","أحذ الكامل"],[575,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"]],"verses":[["أَرجوكَ لِلأَمرِ الخَطيرِ وَإِنَّما","يُرجى المُعَظَّمُ لِلعَظيمِ المُعضِلِ",0,"ل",1,0],["أُرَجِّيَ الرِزقَ مِن خُرتٍ دَقيقٍ","يُسَدُّ بِسِلكِ حِرمانٍ غَليظِ",1,"ظ",1,0],["أَرجو وَخَصرُكِ يَهوى لا رأى فَرَجاً","أَن يُرويَ اللَهُ ما يَشكوهُ مِن ظَمإِ",2,"ا",1,0],["أَرِجٌ تُربُهُنَّ مِن فَتَياتٍ","أَلِفَتهُ أَشباهُها مِن ظِباءِ",3,"ا",2,0],["أُرَجّي بِذَلِكَ حَوضَ الرَسو","وَالفَوزَ وَالنِعمَةَ الدائِمَه",4,"م",2,0],["أَرجو وَآمُلُ أَن يَعجَلنَ في أَبَدٍ","وَما لَهُنَّ طِوالَ الدَهرِ تَعجيلُ",5,"ل",1,0],["أَرِجالٌ بِهِم مَلَكتِ المَعالي","أَم نُضارٌ بِهِ مَلَكتِ البِقاعا",6,"ع",2,0],["أَرِجُ النَدِيَّ مَتى تَفُز بِجِوارِهِ","يَطِبِ الحَديثُ وَيَعبَقِ الإِنشادُ",7,"د",1,0],["أُرَجّي مِن صُروفِ الدَهرِ لين","وَلَم تَغفَل عَنِ الصُمِّ الهِضابِ",8,"ب",1,0],["أَرِجُ العِطافِ مُهَفهَفٌ نِعمَ الفَتى","مُتَسَهِّلٌ في الأَهلِ وَالأَجنابِ",9,"ب",1,0],["أرجال كتلتها هنيئاً للعلا","في الدهر أنكم بُغاة وصالها",10,"ل",3,0],["أَرجو لِتَغلِبَ إِذ غَبَّت أُمورُهُمُ","أَلّا يُبارِكَ في الأَمرِ الَّذي اِئتَمَروا",11,"ر",3,0],["أَرَجا سُراقَةُ أَن يُفاضِلَ خِندِفاً","وَأَبو سُراقَةَ في الحَصى مَكثورُ",12,"ر",1,0],["أَرَجَّعتَ مِن عِرفانِ رَبعٍ كَأَنَّهُ","بَقِيَّةُ وَشمٍ في مُتونِ الأَشاجِعِ",13,"ع",1,0],["أَرجو الفَواضِلَ إِنَّ اللَهَ فَضَّلَكُم","يا قَبلَ نَفسِكَ لاقى نَفسِيَ التَلَفُ",14,"ف",1,0],["أَرجو سَوابِقَ ذي فَواضِلَ مِنهُمُ","وَأَخافُ صَولَةَ ذي شُبولٍ ضَيغَمِ",15,"م",1,0],["أُرَجّي فَواضِلَ ذي بَهجَةٍ","مِنَ الناسِ يَجمَعُ حُزماً وَجودا",16,"د",2,0],["أرجو لكم أن تكونوا في مودتكم","كلباً كورهاء تقلي كل صَفَّارِ",17,"ر",1,1],["ارجاً من رضاب ما يعبأ الغيث","بملقى بعاعه مرورا",18,"ر",2,0],["أَرجو الشَهادَةَ في هَوا","كَ لِأَنَّ قَلبي في جِهادِ",19,"د",1,0],["أرجو اللقاء الصاحبيّ كما","أفلت في دمشقَ وهوَ غائِب",20,"ب",1,1],["أرجو لفهمي بامتداحك يقظةً","من غفلتي وشهادةً في مصرعي",21,"ع",2,0],["أرجّي درهم المعلوم ثلثاً","وأكتب في ثيابي بالرّقاع",22,"ع",1,0],["اِرجِع إِلى اللَهِ إِنَّ الغايَةَ اللَهُ","فَلا إِلَهٌ إِذا بالَغتَ إِلّا هو",23,"و",1,1],["أَرجو لِنَفسي بَراءً مِن مَحَبَّتِكُم","نَعَم إِذا تَبَرَأتُ مِن سَمعي وَمِن بَصَري",24,"ر",2,0],["أرجوه عن أشياء جرَّبتُهَا","وليس عن طير تَعَيَّفْتُهَا",25,"ت",3,0],["أُرجِّي فما أرجو ضمانٌ لديكما","وأخشى فما أخشاه عندكما نَقْدُ",26,"د",1,0],["أَرِجَتْ منها فلاةٌ جَرْدَةٌ","وأضاءتْ ووجُوه الليل سُودُ",27,"د",1,0],["أرْجو سنائي لمُجازاتِه","لكنني راجٍ كمستيئس",28,"س",1,0],["أرجو لديك تعجُّلاً وتأجُّلاً","ولمرتجيك تعجُّلٌ وتأجُّلُ",29,"ل",1,0],["أرجو وإن رذُلتْ مدائحُ قُلتُها","أن لا يكونَ لديك مَدْحٌ يرذُلُ",29,"ل",1,0],["أُرجّي من نوالِك فيضَ بحرٍ","إذا ما أنكد الوشلُ الضَّهولُ",30,"ل",1,0],["أُرَجّي المُنى مِن عِندِ بِشرٍ وَلَم أَزَل","لِأَمثالِها مِن آلِ مَروانَ راجِيا",31,"ي",2,0],["ارجعي فالحياة ليست تساوي","ان تخري من حالق كالشهاب",32,"ب",1,0],["أرجِّى لقاءَ الموت في كل ساعة","فقد سئمت نفسي الحياة وملت",33,"ت",1,0],["أرجِّى بها أني ألاقي شبيبتي","فأيقنت هذا اليوم أن لا تلاقيا",34,"ي",2,0],["أرجفت في أمركم طائفة","تَبَعُ الظن عن الإنصاف ميل",35,"ل",1,0],["أرجفوا أنك شاك موجع","ليت بي فوق الضنى ما أوجعك",36,"ك",1,0],["اُرجُهُ تُعطَ مَقاليدَ الفَلَك","وَاِخشَهُ خَشيَةَ مَن فيهِ هَلَك",37,"ك",1,0],["أَرجو وَآمَلُ أَن سَتَج","ري بِالَّذي شِئنَ الأُمور",38,"ر",1,0],["أَرجَفوا أَنَّكَ شاكٍ موجَعٌ","لَيتَ لي فَوقَ الضَنا ما أَوجَعَك",39,"ك",1,0],["أَرجُ الرِياضِ نَقَلتَهُ","وَنَسَختَهُ نَسخَ النَسيمِ",40,"م",1,0],["أَرَجانَ أَيَّتُها الجِيادُ فَإِنَّهُ","عَزمي الَّذي يَذَرُ الوَشيجَ مُكَسَّرا",41,"ر",2,0],["أَرجو نَداكَ وَلا أَخشى المِطالَ بِهِ","يا مَن إِذا وَهَبَ الدُنيا فَقَد بَخِلا",42,"ل",2,0],["أَرِجَ الطَريقُ فَما مَرَرتَ بِمَوضِعٍ","إِلّا أَقامَ بِهِ الشَذا مُستَوطِنا",43,"ن",2,0],["أُرَجّي وَما نَفعُ الرَجاءِ إِذا اِلتَقَت","مَناحِسُ أَمرٍ مُجحِفٍ وَمَعاطِبُه",44,"ب",2,0],["أَرِجُ النَدى يَنبَثُّ في مَعروفِهِ","مِن عَرفِهِ وَيَزيدُ في تَوكيدِهِ",45,"د",2,0],["أَرجو عَواطِفَ مِن لَيلى وَيُؤيسُني","دَوامُ لَيلى عَلى الهَجرِ الَّذي تَلَدا",46,"د",2,0],["أَرَجنَ عَلَينا اللَيلَ وَهوَ مُمَسَّكٌ","وَصَبَّحنَنا بِالصُبحِ وَهوَ مُخَلَّقُ",47,"ق",1,0],["أُرَجِّمُ في لَيلى الظُنونَ وَأَرتَجي","أَواخِرَ حُبٍّ أَخلَفَتني أَوائِلُه",48,"ل",2,0],["أُرَجِّمُ في لَيلى الظُنونَ وَإِنَّما","أُخاتِلُ في وَجدي بِها مَن أُخاتِلُه",49,"ل",2,0],["أُرَجّي تَلَوُّنَهُ بِالصَفاءِ","وَأَلقى قَطيعَتَهُ بِالصِلَه",50,"ل",2,0],["أُرجُوانِيَّةً تُشَبَّهُ في الكَأ","سِ بِتُفّاحِ خَدِّهِ الأُرجُواني",51,"ن",2,0],["أَرَجٌ لِرَيّا طَلَّةٌ رَيّاهُ","لايَبعَدِ الطَيفُ الَّذي أَهداهُ",52,"ا",2,1],["أُرَجّي أَميرَ المُؤمِنينَ لِحاجَةٍ","بِكَفَّيكَ بَعدَ اللَهِ يُرجى قَضاؤُها",53,"ا",3,0],["أَرجو الخُروجَ بِخالِدٍ وَبِخالِدٍ","يُجلى العَشا لِكَواسِفِ الأَبصارِ",54,"ر",1,0],["أَرجو فَواضِلَ مِنهُ إِنَّ راحَتَهُ","مِثلُ الفُراتِ إِذا آذِيُّهُ زَخَرا",55,"ر",2,0],["أَرجو الدُعاءَ مِنَ الَّذي تَلَّ اِبنَهُ","لِجَبينِهِ فَفَداهُ ذو الإِنعامِ",56,"م",1,0],["ارجع إلي فإن الأرض واقفة","كأنما فرت من ثوانيها",57,"ي",3,0],["إرجع فبعدك لا عقد أعلقه","ولا لمست عطوري في أوانيها",57,"ي",3,0],["إرجع كما أنت صحوا كنت أم مطر","فما حياتي أنا إن لم تكن فيها",57,"ي",3,0],["أَرجو بِقَطعِ البيدِ قَطعَ مَطامِعي","وَأَرومُ بِالمَنصورِ نَصرَ لِوائي",58,"ا",2,0],["أرَجٌ يَعبَقُ في جُنحِ الدّجى","حَمَلَتهُ نحو عَرشَينا الرياح",59,"ح",1,0],["أرج يعبق في أنحائه","حملته نحو عرشينا الرياح",60,"ح",1,0],["أَرْجُو الشَّجَاعَةَ مِنْ قَبْلِ الشَّفَاعَةِ إِذْ","بِهَذِهِ اليَوْمَ أَرْجُو نَيْلَ تِلْكَ غَدَا",61,"د",2,0],["أُرَجِّعُ بِالشَّوقِ الحنينَ وَإنّما","يهيجُ حنيني عَوْدُها حين يُرْزِمُ",62,"م",1,0],["أَرَجٌ أَقامَ مِنَ الأَحِبَّةِ في الثَرى","وَصَرىً أُريقَت بِالدُموعِ الذُرَّفِ",63,"ف",1,0],["أُرَجّي أَن تَكونَ مَحَلَّ يُسري","وَمُنتَصَري عَلى الزَمَنِ الكَنودِ",64,"د",1,0],["أَرِجُ النَّبَاتِ كَأَنَّمَا غَمَرَ الثَّرَى","طِيباً مُرُورُ الْخِضْرِ بَيْنَ إِكَامِهِ",65,"م",2,0],["أرجو على الطوْلِ نصري","عليهِ فالنارُ عضُّ",66,"ض",1,0],["أرجاؤهُ محبوبةٌ وسفوحُهُ","مطلوبةٌ وبهاؤُهُ موفورُ",67,"ر",1,0],["أرجُ الشبابِ وخمرُه المسكوبُ","لَيفوحُ من أردانِكُمْ ويطيبُ",68,"ب",1,1],["اِرجَعي نَحوَهُ فَقولي وَعَيشي","لا تَهَنّأ بِما فَعَلتَ رَبيعا",69,"ع",2,0],["اِرجِع فَعاوِدها المَساءَ فَإِنَّني","أَخشى مِنَ العادي بِها أَن يَعرِضا",70,"ض",2,0],["اِرجِع إِلَيها بِالَّذي","قالَت بِرَجعِ جَوابَها",71,"ب",3,0],["اِرجَع وَرَدِّد طَرفَ تابِعِنا","حَتّى يُجَدَّدَ دارِسُ الحُبِّ",72,"ب",1,0],["أَرِجَ النَدِيُّ بِذِكرِهِ فَكَأَنَّهُ","مُتَنَفَّسٌ عَن رَوضَةٍ مِعطارِ",73,"ر",1,0],["أَرِجاً كَما عَثَرَ النَسيمُ بِرَوضَةٍ","لَدناً كَما نَضَحَ الغَمامُ مَقيلا",74,"ل",2,0],["ارجعوا فاستأصلوا أعداءكم","تلك عِزُّ الدَّهر أو مجدُ الأَبَدْ",75,"د",1,0],["ارجِع لِمَا قَالَ فِي التَّنزِيلِ خَالِقُنَا","اخفِض جَنَاحَكَ يَا مُوسَى مِنَ الرَهَبِ",76,"ب",1,0],["أَرجو نَوافِلَ مِن يَدَي","كَ وَأَنتَ مَبسوطُ النَوافِل",77,"ل",1,0],["أَرجو وَآمُلُ كُلَّ عامٍ نَفحَةً","مِنكُم تَدُقُّ خَطائِرُ الإِقتارِ",78,"ر",1,0],["إِرجِع إِلى الحَقِّ إِمّا كُنتَ فاعِلَهُ","إِنَّ التَخَلُّقَ يَأتي دُونَهُ الخُلُقُ",79,"ق",1,0],["أَرْجُوكَ يَا رَبِّ في الدَّارَيْنِ تَرْحَمُنا","بِجَاهِ مَنْ فِي يَدَيْهِ سَبَّحَ الحَجَرُ",80,"ر",1,0],["أَرجو نَوالَكِ في يَومي فَيُخلِفُني","وَفي غَدٍ قَد أَرَجّيهِ وَبَعدَ غَدِ",81,"د",1,0],["أَرِجُ القِنانِ إِذا تَرَجَّلَتِ الضُحى","صَخَبُ القَنابِرِ تَحتَ ظِلِّ سَحابِهِ",82,"ب",2,0],["إِرجَع إِلى السِنِّ فَاِنظُر ما تَقادُمُها","فَاِحكُم عَلَيهِ وَلا تَحكُم عَلى الشَعَرِ",83,"ر",1,1],["أَرَجَوتَ أَن تُعطى اِختِيارَكَ وَالفَتى","يَغدو عالى شُمسٍ مِنَ الأَقدارِ",84,"ر",1,0],["أَرجُوا أَو اِعتَزَلوا فَإِن","ني عَن مَقامِكُم بِمَعزِلِ",85,"ل",1,0],["أُرَجّي أُموراً لَم يُقَدَّر بَلَوغَنُها","وَأَخشى خُطوباً وَالمُهَيمِنُ كافيها",86,"ي",3,0],["أَرِجاتٌ يَقضِمنَ مِن قُضُبِ الرَندِ","بِثَغرٍ عَذبٍ كَشَوكِ السِّيالِ",87,"ل",1,0],["أَرْجفتِ القِلاعُ والحُصونُ","كأَنَّما ساوَرَها المَنُونُ",88,"ن",1,0],["ارجَعْ إلى القومِ الغضابِ وقل لهم","ردُّوا النّفوسَ إلى التي هي أقوم",89,"م",1,0],["أرجو من الشمس أن تزوي أَشعتها","عني فإني أَراها اليوم تؤذيني",90,"ي",1,0],["أرجو صباحاً يستَبين للَيلَتي","فأرى بعيني النور بعد ظلام",91,"م",1,0],["أرجعي لي بعضَ أحلامي وهاتي","صفَو أنغامي وردِّي صدحاتي",92,"ي",1,0],["أَرْجُو لِقاءَكُ