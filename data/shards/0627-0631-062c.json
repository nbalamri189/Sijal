"https://www.aldiwan.net/poem13220.html","الكامل"],[105,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[81,"أما ترى دمه في الطشت حين جرى","https://www.aldiwan.net/poem61375.html","الطويل"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[39,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[40,"يا من لعين قد أجلى نومها الأرق","https://www.aldiwan.net/poem42337.html","البسيط"],[67,"يا رب صل على المختار من مضر","https://www.aldiwan.net/poem18126.html","البسيط"],[50,"يا حب طال تمنينا زيارتكم","https://www.aldiwan.net/poem63933.html","البسيط"],[50,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[46,"إرجع إلى السن فانظر ما تقادمها","https://www.aldiwan.net/poem22668.html","البسيط"],[46,"عاين أواخر كائن بأوائل","https://www.aldiwan.net/poem22724.html","الكامل"],[46,"الله إن أعطاك يجزل","https://www.aldiwan.net/poem23270.html","مجزوء الكامل"],[46,"إن كنت قد أوتيت لبا وحكمة","https://www.aldiwan.net/poem23568.html","الطويل"],[8,"دار حي كانت لهم زمن التو","https://www.aldiwan.net/poem21824.html","الخفيف"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49137","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85455","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85596","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55015","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54667","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43659","الكامل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1922","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54297","الكامل"],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[46,"عايِنْ أواخرَ كائِنٍ بأوائِلٍº","https://www.poetsgate.com/ViewPoem.aspx?id=20298",""],[94,"أنني قدمت روحي في الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=15622",""],[64,"الحبّ ما دام مكتوماً على خطرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=3139",""],[99,"القرط الطويل","https://www.poetsgate.com/ViewPoem.aspx?id=36382",""],[99,"إلى رجل","https://www.poetsgate.com/ViewPoem.aspx?id=565",""],[99,"إلى رجل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=389&r=&rc=74",""]],"verses":[["أَرجوكَ لِلأَمرِ الخَطيرِ وَإِنَّما","يُرجى المُعَظَّمُ لِلعَظيمِ المُعضِلِ",0,"ل",1,0],["أُرَجِّيَ الرِزقَ مِن خُرتٍ دَقيقٍ","يُسَدُّ بِسِلكِ حِرمانٍ غَليظِ",1,"ظ",1,0],["أَرجو وَخَصرُكِ يَهوى لا رأى فَرَجاً","أَن يُرويَ اللَهُ ما يَشكوهُ مِن ظَمإِ",2,"ا",1,0],["أَرِجٌ تُربُهُنَّ مِن فَتَياتٍ","أَلِفَتهُ أَشباهُها مِن ظِباءِ",3,"ا",2,0],["أُرَجّي بِذَلِكَ حَوضَ الرَسو","وَالفَوزَ وَالنِعمَةَ الدائِمَه",4,"م",2,0],["أَرجو وَآمُلُ أَن يَعجَلنَ في أَبَدٍ","وَما لَهُنَّ طِوالَ الدَهرِ تَعجيلُ",5,"ل",1,0],["أَرِجالٌ بِهِم مَلَكتِ المَعالي","أَم نُضارٌ بِهِ مَلَكتِ البِقاعا",6,"ع",2,0],["أَرِجُ النَدِيَّ مَتى تَفُز بِجِوارِهِ","يَطِبِ الحَديثُ وَيَعبَقِ الإِنشادُ",7,"د",1,0],["أُرَجّي مِن صُروفِ الدَهرِ لين","وَلَم تَغفَل عَنِ الصُمِّ الهِضابِ",8,"ب",1,0],["أَرِجُ العِطافِ مُهَفهَفٌ نِعمَ الفَتى","مُتَسَهِّلٌ في الأَهلِ وَالأَجنابِ",9,"ب",1,0],["أرجال كتلتها هنيئاً للعلا","في الدهر أنكم بُغاة وصالها",10,"ل",3,0],["أَرجو لِتَغلِبَ إِذ غَبَّت أُمورُهُمُ","أَلّا يُبارِكَ في الأَمرِ الَّذي اِئتَمَروا",11,"ر",3,0],["أَرَجا سُراقَةُ أَن يُفاضِلَ خِندِفاً","وَأَبو سُراقَةَ في الحَصى مَكثورُ",12,"ر",1,0],["أَرَجَّعتَ مِن عِرفانِ رَبعٍ كَأَنَّهُ","بَقِيَّةُ وَشمٍ في مُتونِ الأَشاجِعِ",13,"ع",1,0],["أَرجو الفَواضِلَ إِنَّ اللَهَ فَضَّلَكُم","يا قَبلَ نَفسِكَ لاقى نَفسِيَ التَلَفُ",14,"ف",1,0],["أَرجو سَوابِقَ ذي فَواضِلَ مِنهُمُ","وَأَخافُ صَولَةَ ذي شُبولٍ ضَيغَمِ",15,"م",1,0],["أُرَجّي فَواضِلَ ذي بَهجَةٍ","مِنَ الناسِ يَجمَعُ حُزماً وَجودا",16,"د",2,0],["أرجو لكم أن تكونوا في مودتكم","كلباً كورهاء تقلي كل صَفَّارِ",17,"ر",1,1],["ارجاً من رضاب ما يعبأ الغيث","بملقى بعاعه مرورا",18,"ر",2,0],["أَرجو الشَهادَةَ في هَوا","كَ لِأَنَّ قَلبي في جِهادِ",19,"د",1,0],["أرجو اللقاء الصاحبيّ كما","أفلت في دمشقَ وهوَ غائِب",20,"ب",1,1],["أرجو لفهمي بامتداحك يقظةً","من غفلتي وشهادةً في مصرعي",21,"ع",2,0],["أرجّي درهم المعلوم ثلثاً","وأكتب في ثيابي بالرّقاع",22,"ع",1,0],["اِرجِع إِلى اللَهِ إِنَّ الغايَةَ اللَهُ","فَلا إِلَهٌ إِذا بالَغتَ إِلّا هو",23,"و",1,1],["أَرجو لِنَفسي بَراءً مِن مَحَبَّتِكُم","نَعَم إِذا تَبَرَأتُ مِن سَمعي وَمِن بَصَري",24,"ر",2,0],["أرجوه عن أشياء جرَّبتُهَا","وليس عن طير تَعَيَّفْتُهَا",25,"ت",3,0],["أُرجِّي فما أرجو ضمانٌ لديكما","وأخشى فما أخشاه عندكما نَقْدُ",26,"د",1,0],["أَرِجَتْ منها فلاةٌ جَرْدَةٌ","وأضاءتْ ووجُوه الليل سُودُ",27,"د",1,0],["أرْجو سنائي لمُجازاتِه","لكنني راجٍ كمستيئس",28,"س",1,0],["أرجو لديك تعجُّلاً وتأجُّلاً","ولمرتجيك تعجُّلٌ وتأجُّلُ",29,"ل",1,0],["أرجو وإن رذُلتْ مدائحُ قُلتُها","أن لا يكونَ لديك مَدْحٌ يرذُلُ",29,"ل",1,0],["أُرجّي من نوالِك فيضَ بحرٍ","إذا ما أنكد الوشلُ الضَّهولُ",30,"ل",1,0],["أُرَجّي المُنى مِن عِندِ بِشرٍ وَلَم أَزَل","لِأَمثالِها مِن آلِ مَروانَ راجِيا",31,"ي",2,0],["ارجعي فالحياة ليست تساوي","ان تخري من حالق كالشهاب",32,"ب",1,0],["أرجِّى لقاءَ الموت في كل ساعة","فقد سئمت نفسي الحياة وملت",33,"ت",1,0],["أرجِّى بها أني ألاقي شبيبتي","فأيقنت هذا اليوم أن لا تلاقيا",34,"ي",2,0],["أرجفت في أمركم طائفة","تَبَعُ الظن عن الإنصاف ميل",35,"ل",1,0],["أرجفوا أنك شاك موجع","ليت بي فوق الضنى ما أوجعك",36,"ك",1,0],["اُرجُهُ تُعطَ مَقاليدَ الفَلَك","وَاِخشَهُ خَشيَةَ مَن فيهِ هَلَك",37,"ك",1,0],["أَرجو وَآمَلُ أَن سَتَج","ري بِالَّذي شِئنَ الأُمور",38,"ر",1,0],["أَرجَفوا أَنَّكَ شاكٍ موجَعٌ","لَيتَ لي فَوقَ الضَنا ما أَوجَعَك",39,"ك",1,0],["أَرجُ الرِياضِ نَقَلتَهُ","وَنَسَختَهُ نَسخَ النَسيمِ",40,"م",1,0],["أَرَجانَ أَيَّتُها الجِيادُ فَإِنَّهُ","عَزمي الَّذي يَذَرُ الوَشيجَ مُكَسَّرا",41,"ر",2,0],["أَرجو نَداكَ وَلا أَخشى المِطالَ بِهِ","يا مَن إِذا وَهَبَ الدُنيا فَقَد بَخِلا",42,"ل",2,0],["أَرِجَ الطَريقُ فَما مَرَرتَ بِمَوضِعٍ","إِلّا أَقامَ بِهِ الشَذا مُستَوطِنا",43,"ن",2,0],["أُرَجّي وَما نَفعُ الرَجاءِ إِذا اِلتَقَت","مَناحِسُ أَمرٍ مُجحِفٍ وَمَعاطِبُه",44,"ب",2,0],["أَرِجُ النَدى يَنبَثُّ في مَعروفِهِ","مِن عَرفِهِ وَيَزيدُ في تَوكيدِهِ",45,"د",2,0],["أَرجو عَواطِفَ مِن لَيلى وَيُؤيسُني","دَوامُ لَيلى عَلى الهَجرِ الَّذي تَلَدا",46,"د",2,0],["أَرَجنَ عَلَينا اللَيلَ وَهوَ مُمَسَّكٌ","وَصَبَّحنَنا بِالصُبحِ وَهوَ مُخَلَّقُ",47,"ق",1,0],["أُرَجِّمُ في لَيلى الظُنونَ وَأَرتَجي","أَواخِرَ حُبٍّ أَخلَفَتني أَوائِلُه",48,"ل",2,0],["أُرَجِّمُ في لَيلى الظُنونَ وَإِنَّما","أُخاتِلُ في وَجدي بِها مَن أُخاتِلُه",49,"ل",2,0],["أُرَجّي تَلَوُّنَهُ بِالصَفاءِ","وَأَلقى قَطيعَتَهُ بِالصِلَه",50,"ل",2,0],["أُرجُوانِيَّةً تُشَبَّهُ في الكَأ","سِ بِتُفّاحِ خَدِّهِ الأُرجُواني",51,"ن",2,0],["أَرَجٌ لِرَيّا طَلَّةٌ رَيّاهُ","لايَبعَدِ الطَيفُ الَّذي أَهداهُ",52,"ا",2,1],["أُرَجّي أَميرَ المُؤمِنينَ لِحاجَةٍ","بِكَفَّيكَ بَعدَ اللَهِ يُرجى قَضاؤُها",53,"ا",3,0],["أَرجو الخُروجَ بِخالِدٍ وَبِخالِدٍ","يُجلى العَشا لِكَواسِفِ الأَبصارِ",54,"ر",1,0],["أَرجو فَواضِلَ مِنهُ إِنَّ راحَتَهُ","مِثلُ الفُراتِ إِذا آذِيُّهُ زَخَرا",55,"ر",2,0],["أَرجو الدُعاءَ مِنَ الَّذي تَلَّ اِبنَهُ","لِجَبينِهِ فَفَداهُ ذو الإِنعامِ",56,"م",1,0],["ارجع إلي فإن الأرض واقفة","كأنما فرت من ثوانيها",57,"ي",3,0],["إرجع فبعدك لا عقد أعلقه","ولا لمست عطوري في أوانيها",57,"ي",3,0],["إرجع كما أنت صحوا كنت أم مطر","فما حياتي أنا إن لم تكن فيها",57,"ي",3,0],["أَرجو بِقَطعِ البيدِ قَطعَ مَطامِعي","وَأَرومُ بِالمَنصورِ نَصرَ لِوائي",58,"ا",2,0],["أرَجٌ يَعبَقُ في جُنحِ الدّجى","حَمَلَتهُ نحو عَرشَينا الرياح",59,"ح",1,0],["أرج يعبق في أنحائه","حملته نحو عرشينا الرياح",60,"ح",1,0],["أُرَجِّعُ بِالشَّوقِ الحنينَ وَإنّما","يهيجُ حنيني عَوْدُها حين يُرْزِمُ",61,"م",1,0],["أَرَجٌ أَقامَ مِنَ الأَحِبَّةِ في الثَرى","وَصَرىً أُريقَت بِالدُموعِ الذُرَّفِ",62,"ف",1,0],["أُرَجّي أَن تَكونَ مَحَلَّ يُسري","وَمُنتَصَري عَلى الزَمَنِ الكَنودِ",63,"د",1,0],["أَرِجُ النَّبَاتِ كَأَنَّمَا غَمَرَ الثَّرَى","طِيباً مُرُورُ الْخِضْرِ بَيْنَ إِكَامِهِ",64,"م",2,0],["أرجو على الطوْلِ نصري","عليهِ فالنارُ عضُّ",65,"ض",1,0],["أرجاؤهُ محبوبةٌ وسفوحُهُ","مطلوبةٌ وبهاؤُهُ موفورُ",66,"ر",1,0],["أرجُ الشبابِ وخمرُه المسكوبُ","لَيفوحُ من أردانِكُمْ ويطيبُ",67,"ب",1,1],["اِرجَعي نَحوَهُ فَقولي وَعَيشي","لا تَهَنّأ بِما فَعَلتَ رَبيعا",68,"ع",2,0],["اِرجِع فَعاوِدها المَساءَ فَإِنَّني","أَخشى مِنَ العادي بِها أَن يَعرِضا",69,"ض",2,0],["اِرجِع إِلَيها بِالَّذي","قالَت بِرَجعِ جَوابَها",70,"ب",3,0],["اِرجَع وَرَدِّد طَرفَ تابِعِنا","حَتّى يُجَدَّدَ دارِسُ الحُبِّ",71,"ب",1,0],["أَرِجَ النَدِيُّ بِذِكرِهِ فَكَأَنَّهُ","مُتَنَفَّسٌ عَن رَوضَةٍ مِعطارِ",72,"ر",1,0],["أَرِجاً كَما عَثَرَ النَسيمُ بِرَوضَةٍ","لَدناً كَما نَضَحَ الغَمامُ مَقيلا",73,"ل",2,0],["ارجعوا فاستأصلوا أعداءكم","تلك عِزُّ الدَّهر أو مجدُ الأَبَدْ",74,"د",1,0],["ارجِع لِمَا قَالَ فِي التَّنزِيلِ خَالِقُنَا","اخفِض جَنَاحَكَ يَا مُوسَى مِنَ الرَهَبِ",75,"ب",1,0],["أَرجو نَوافِلَ مِن يَدَي","كَ وَأَنتَ مَبسوطُ النَوافِل",76,"ل",1,0],["أَرجو وَآمُلُ كُلَّ عامٍ نَفحَةً","مِنكُم تَدُقُّ خَطائِرُ الإِقتارِ",77,"ر",1,0],["إِرجِع إِلى الحَقِّ إِمّا كُنتَ فاعِلَهُ","إِنَّ التَخَلُّقَ يَأتي دُونَهُ الخُلُقُ",78,"ق",1,0],["أَرْجُوكَ يَا رَبِّ في الدَّارَيْنِ تَرْحَمُنا","بِجَاهِ مَنْ فِي يَدَيْهِ سَبَّحَ الحَجَرُ",79,"ر",1,0],["أَرجو نَوالَكِ في يَومي فَيُخلِفُني","وَفي غَدٍ قَد أَرَجّيهِ وَبَعدَ غَدِ",80,"د",1,0],["أَرِجُ القِنانِ إِذا تَرَجَّلَتِ الضُحى","صَخَبُ القَنابِرِ تَحتَ ظِلِّ سَحابِهِ",81,"ب",2,0],["إِرجَع إِلى السِنِّ فَاِنظُر ما تَقادُمُها","فَاِحكُم عَلَيهِ وَلا تَحكُم عَلى الشَعَرِ",82,"ر",1,1],["أَرَجَوتَ أَن تُعطى اِختِيارَكَ وَالفَتى","يَغدو عالى شُمسٍ مِنَ الأَقدارِ",83,"ر",1,0],["أَرجُوا أَو اِعتَزَلوا فَإِن","ني عَن مَقامِكُم بِمَعزِلِ",84,"ل",1,0],["أُرَجّي أُموراً لَم يُقَدَّر بَلَوغَنُها","وَأَخشى خُطوباً وَالمُهَيمِنُ كافيها",85,"ي",3,0],["أَرِجاتٌ يَقضِمنَ مِن قُضُبِ الرَندِ","بِثَغرٍ عَذبٍ كَشَوكِ السِّيالِ",86,"ل",1,0],["أَرْجفتِ القِلاعُ والحُصونُ","كأَنَّما ساوَرَها المَنُونُ",87,"ن",1,0],["ارجَعْ إلى القومِ الغضابِ وقل لهم","ردُّوا النّفوسَ إلى التي هي أقوم",88,"م",1,0],["أرجو من الشمس أن تزوي أَشعتها","عني فإني أَراها اليوم تؤذيني",89,"ي",1,0],["أرجو صباحاً يستَبين للَيلَتي","فأرى بعيني النور بعد ظلام",90,"م",1,0],["أرجعي لي بعضَ أحلامي وهاتي","صفَو أنغامي وردِّي صدحاتي",91,"ي",1,0],["أَرْجُو لِقاءَكُ حِيْنَ يَأْذَنُ مُنْعِماً","إِنِّي لَهُ وَإِلَيهِ إِنِّي رَاجِعُ",92,"ع",1,0],["أَرْجُو لَكِ الْعُمْرَ الْمَدِيدَ","وَفِي كَمَالِكِ أَنْتِ أَنْتِ",93,"ت",1,0],["أَرجو مِنَ اللَهِ الجَزاءَ فَإِنَّني","وَالخِلب أَنتَ مُمَزَّقُ الأَجزاءِ",94,"ا",2,0],["أُرَجّي مِن صُروفِ الدَهرِ ليناً","وَلَم تَغفَل عَنِ الصُمِّ الهِضابِ",95,"ب",1,0],["أرْجَاءَ ذَا الوادِي الخَصِيبِ جنابُهُ","ماذَا أَصَابَكَ يَا رَجَاءَ الوَادِي",96,"د",2,0],["أرَجٌ من الذكرى يلفَّكَ عِطْرُهُ","ويَزيدُ جانبكَ المُوطَّد جانبا",97,"ب",2,0],["أرجِعي ما استطعتِ لي من شَبابي","يا سُهولاً تَدَثَّرَتْ بالهِضابِ",98,"ب",1,1],["أرَجوتَ أن تُعطى اختيارَك، والفتى","يَغدُو على شُمْسٍ من الأقدار",99,"ر",1,0],["أرجعي كأسي يا فاتنتي","إنّ في كأسي من الخمر بقايا",100,"ا",3,0],["أرجُو لنفسي براء من محبّتكم","إذا تبرّأت من سَمعي ومن بصري",101,"ر",2,0],["أرجوحة ٌ من قَلقي خيطُها","من نَزَق المدوّر ِ الأسمَر ِ..",102,"ر",1,0],["إرجع كما أنت صحوا كنت أم مطرا","فما حياتي أنا إن لم تكن فيها",103,"ي",3,0],["ارجع إليَّ فإنّ الأرضَ واقفةٌ","كأنّما الأرضُ فرّت من ثوانيها",104,"ي",3,0]]}