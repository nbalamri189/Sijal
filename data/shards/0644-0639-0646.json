0904",""],[5464,"ليالينا عقيمات ... ولكن","https://www.poetsgate.com/ViewPoem.aspx?id=27774",""],[5465,"أمستْ أمية قد أظلَ فَناؤها","https://www.poetsgate.com/ViewPoem.aspx?id=98425",""],[5739,"أمواق الغمام ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127362",""],[5756,"لمباني","https://www.poetsgate.com/ViewPoem.aspx?id=5420",""],[5756,"من تحت لتحت","https://www.poetsgate.com/ViewPoem.aspx?id=5425",""],[402,"غلب الموت فالحياة ثكول","https://www.poetsgate.com/ViewPoem.aspx?id=36544",""],[5830,"قِرَاءَةٌ بِكَفِّ زَرْقَاء اليَمَامَة","https://www.poetsgate.com/ViewPoem.aspx?id=201191",""],[5848,"سوق الفيصلية","https://www.poetsgate.com/ViewPoem.aspx?id=49228",""],[5893,"على الشِّدة صبور","https://www.poetsgate.com/ViewPoem.aspx?id=141385",""],[5910,"عُودوا إلى الرَّحمنِ","https://www.poetsgate.com/ViewPoem.aspx?id=210978",""],[5937,"متحف الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=211894",""],[5953,"ليس حبسي بضائري إن أتاح الل","https://www.poetsgate.com/ViewPoem.aspx?id=93880",""],[5956,"لعنة الله على رأيِ طبيب بيطريٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=192230",""],[5956,"لهفي عليك أيا شهيدتنا","https://www.poetsgate.com/ViewPoem.aspx?id=193142",""],[6056,"أزرق الدمع بعيوني","https://www.poetsgate.com/ViewPoem.aspx?id=130134",""],[6113,"تسأليني؟","https://www.poetsgate.com/ViewPoem.aspx?id=12876",""],[6113,"الهايج والذلول......","https://www.poetsgate.com/ViewPoem.aspx?id=37153",""],[6113,"السالفه...............!!!","https://www.poetsgate.com/ViewPoem.aspx?id=41916",""],[6113,"سر الجاذبيه","https://www.poetsgate.com/ViewPoem.aspx?id=120889",""],[6261,"الهجرة الخامسة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82138&r=&rc=10",""],[4222,"إن بيع الحصون من غير حرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52915&r=&rc=207",""]],"verses":[["لَعَنَ اللَهُ كُلَّ ذي خُلَّةٍ يَم","شي وَفي الناسِ قَلبُهُ مَقسومُ",0,"م",1,0],["لعِنايَةِ التّخْصيصِ سرٌّ غامضٌ","منْ قبْلِ ذَرْءِ الخَلْقِ خصَّ نُفوسا",1,"س",2,0],["لعَنوا بريّاً منْ خبائِثِ ظنّهِمْ","فاللهُ يَلْعَنُ أهْلَ سوقِ العنْبَرِ",2,"ر",1,1],["لُعِنوا وَقَد لُعِنوا بِقَتلِ إِمامِهِم","تَرَكوهُ وَهوَ مُبَضَّعٌ مَحموسُ",3,"س",1,0],["لَعَنَ اللَهُ نَخوَةً","صارَ مِن بَعدِها ضَرَع",4,"ع",1,0],["لعنت قرائنهم وكل من احتمى","بالأجنبي فحقّه أن يلعنا",5,"ن",2,0],["لَعَنَ الإِلَهُ مِنَ الصَليبُ إِلَهُهُ","وَاللابِسينَ بَرانِسَ الرُهبانِ",6,"ن",1,0],["لَعَنَ الإِلَهُ نُسَيَّةً مِن تَغلِبٍ","يَرفَعنَ مِن قِطَعِ العَباءِ خُدورا",7,"ر",2,0],["لَعَنَ اللَهُ شَرَّةَ الدورِ كوثى","وَرَماها بِالفَقرِ وَالإِمعارِ",8,"ر",1,1],["لَعَنَ الإِلَهُ وَزَوجَها مَعَها","هِندَ الهُنودِ طَويلَةَ البَظرِ",9,"ر",1,0],["لعن الله خالدا","بادئاً ثم عائدا",10,"د",2,1],["لعنةُ اللَّه كُلّ يوم عليه","فهو أَولى من المجوس بلعنه",11,"ن",2,0],["لعنةٌ منه في الإقامة تَغشا","هُ وأخرى تزورهُ يوم ظَعْنه",11,"ن",2,0],["لَعَنَ الإِلَهُ مِنَ اليَهودِ عِصابَةً","بِالجِزعَ بَينَ جُلَيجِلٍ وَصِرارِ",12,"ر",1,1],["لَعَنَ اللَهُ مَن يُشا","رِكُهُ أَو يُزاحِمُه",13,"م",2,0],["لَعَن اللَهُ حاجَةً","أَلجَأَتني إِلَيكُمُ",14,"م",1,1],["لَعَنَ اللَهُ طَريقاً","جَمَعَت بَيني وَبَينَك",15,"ك",1,0],["لَعَنَ اللَهُ مَن ذَكَر","تَ وَحاشاكَ تَذكُرُه",16,"ر",2,1],["لَعَنَ اللَهُ صاعِداً","وَأَباهُ فَصاعِدا",17,"د",2,1],["لُعِنَت مُقارَنَةُ اللَئيمِ فَإِنَّها","ضَيفٌ يَجِرُّ مِنَ النَدامَةِ ضَيفَنا",18,"ن",2,0],["لَعِندَ إِكذابِ أَنصافِ الظُنونِ إِذا","عَنَّت وَإِخلافِ أَنصافِ المَواعيدِ",19,"د",1,0],["لَعَنَ الإِلَهُ سَواحِقَ الرَأسِ","فَلَقَد فَضَحنَ حَرائِرَ الإِنسِ",20,"س",1,1],["لَعَنَ اللَهُ مُقلَةً جُعِلَ الأَم","رُ إِلَيها فَفارَقَت مُقلَتَيكا",21,"ك",2,0],["لَعَنَ اللَهَ مَن تَقَوَّلَ هَذا","وَثَنى مَن وَشى بِلَعنٍ وَهَمّا",22,"م",2,0],["لُعِنَ الَّذينَ رَأوْا سَبِيلَ مُحَمَّدٍ","وَالمُؤْمِنِينَ بِهِ أضَلَّ سَبِيلا",23,"ل",2,0],["لَعَنَ اللَهُ كُلَّ واشٍ وَفَقّا","عَن قَريبٍ بِكَفِّهِ عَينَيهِ",24,"ي",2,0],["لَعنَةُ اللَهِ عَلى جارِيَةٍ","صَرَفَت قَلبَكِ عَنّي حَسَدا",25,"د",2,0],["لُعِنَ الحِرصُ كَم تَحَكَّرتِ قوتاً","ثُمَّ خَلَّفتِ بُرَّهُ وَالشَعيرا",26,"ر",2,0],["لَعَنَّكَ يَنجابُ الظَلامُ فَتَهتَدي","إِذا عَنكَ في رَأَدِ الضُحى ذَهَبَ العِنكُ",27,"ك",1,0],["لَعَنتُكَ جاهِداً وَقَد اِشتَبَهنا","كِلانا راحَ في بُردَي لَعينِ",28,"ن",1,0],["لُعِن المالُ أَوْ يُكَفِّرَ عَنْهُ","سَبْبُ مَنْ يقْتَنِيهِ وَالتَّنْويِلُ",29,"ل",1,0],["لعَنْتُ الضميرَ الحرّ لعنةَ غاضبٍ","رأي الغُنْم محموداً فذمَّ التفاديا",30,"ي",2,0],["لُعنتنَّ مِن صِبيْةٍ لا تشيخُ","ومن شِيْخَةٍ دَهْرَها تُصطبى",31,"ا",1,0],["لُعنَ القصيدُ فأيُّ مُثرٍ شامخٍ","سرعانَ ما استجدى الحسانَ ذليلا",32,"ل",2,0],["لعند إكذاب أنصاف الظنون إذا","عنت وأخلاف أصناف المواعيد",33,"د",1,0],["لعن الاله يزيد والباقين من","اشباعه الانذال طائفة الخنا",34,"ن",2,1],["لَعَنَ اللهُ سُيوفَ الحُبِّ","إلام الحُبُّ يُعَذِّبُني؟",35,"ن",2,0],["لَعَنَ اللَهُ حَيثُ ظَلَّ وَأَمسى","لَعنَةً عِبؤُها مَحطوطُ",36,"ط",1,0],["لعن اللَهُ قربةً ليس فيها","لفتىً يطلب التعلَّةَ علَّهْ",37,"ه",1,0],["لعنة الله والعبادِ على مَنْ","ليس يهواك منه قلبٌ وصدر",38,"ر",1,0],["لَعَنَ اللَهُ جُرجُسَ القُنياطا","وَسَقى قَبرَهُ خَرىً وَضُراطا",39,"ط",2,1],["لعن الإله الناسَ إلا مسلماً","والدهر بعد عبيدة بن الأعور",40,"ر",1,1],["لعن الله كل شعر ونحو","وعروض يجيء من سيراف",41,"ف",1,0],["لَعنَةُ اللَهِ عَلَيهِم","أَجمَعينَ أَجمَعينَ",42,"ن",1,0],["لعَنتُكِ يا خرقاءُ ما كنتُ خائناً","ولا كان قلبي في غرامك لاهيا",43,"ي",2,0],["لعنةٌ خرقاءُ فرعونيةٌ","تلك يا هتلرُ أم ريح الزوال",44,"ل",1,0],["لعنَتني الحياة إن ضاع عمري","خافياً رغم رفعتي مغمورا",45,"ر",2,0],["لعن الله كل من يشهد الحق جليا","ولا يرى أن يصونه",46,"ن",2,0],["لعنَ اللَهُ كلَّ مَن","رَدَّ هذا وَأَنكَرَهُ",47,"ر",2,0],["لَعَنَ اللَهُ عُصبَةً","ناصَبَتهُ عَلى تِرَه",48,"ر",2,0],["لُعِنَت أُمَيَّةُ اِنَّها","أَهلُ الضَلالَةِ وَالاِفاكِ",49,"ك",1,0],["لَعَنوهُ لَعَناتٍ","لَزمَتهُم بِعُراها",50,"ا",3,0],["لَعَنَ اللَهُ اِبنَ حَربٍ","لَعنَةً تَكوي الجِباها",50,"ا",3,0],["لُعِن الرَّوافض إنَّما أخبارهم","كذِبٌ على آل النبي تُزَوّر",51,"ر",1,0],["لعنوا بما قالوا وغُلَّت منهم ال","أيدي وذلّوا بعدها واستحقروا",51,"ر",3,0],["لعنوا أمير المؤمني","ن بمثل إعلان الإقامه",52,"م",2,0],["لعنَ الإلهُ بَني أميّةَ مِثلما","داودُ قد لعنَ اليَهودَ وكَفرا",53,"ر",2,0],["لَعنةَ اللهِ جاوِري شَرَّ قَبرٍ","بِحَشاهُ قَد ضَمَّ شَرَّ دَفِينِ",54,"ن",1,0],["لعنةُ اللهِ على البيَّازِ ما","بيننا البيازُ بالسُّوءِ ذُكِر",55,"ر",1,1],["لعنةُ اللهِ على البيازِ ما","باتَ يسعَى بِفُجورٍ فَدُحِر",55,"ر",1,0],["لعنةُ اللهِ على البياز ما","جفنُه للفَتكِ بالناس سهِر",55,"ر",1,0],["لعنةَ اللهِ اسكُني في قبرِه","واصحبيه يومَ بعثٍ آن نُشِر",55,"ر",1,0],["لعنةُ اللهِ على البيازِ ما","ذَكَرَ الله تَقِىٌّ وسَهِر",55,"ر",1,0],["لعنةُ اللهِ علَي","هِ دواما فاذهَبُوا",56,"ب",3,0],["لعنةُ اللَّه على مَنْ","كان بالودّ بخيلا",57,"ل",2,1],["لعَن اللّهُ مدَّةً كنتَ فيها","كلّ همّي وأنت مِنِّي كبعضي",58,"ض",2,0],["لَعَنَ اللَّه رجالاً","أترعوا الدّنيا غُصوبا",59,"ب",2,0],["لعنٌ من الله في القرآن جاء لمن","أخفى بياناً له في الذكرِ إنزال",60,"ل",1,0],["لَعِنْدِي الْتِفَاتٌ نَحْوَكُمْ وتَشوُّقٌ","إِلَيْكُمْ وَمِنْكُمْ بَعْدُ في القَلْبَ آثارُ",61,"ر",1,0],["لَعَنَ اللَهُ مَن نَعاكَ إِلَينا","إِذ لَقينا هُبَيرَةَ بنُ فُراتِ",62,"ت",1,0],["لعن الاله مغيبا من أجله","ذاقت ألوف الناس موتا أحمرا",63,"ر",2,0],["لعنَ اللهُ والديَّ جميعاً","ثم أصلاهما عَذابَ الجحيمِ",64,"م",1,1],["لعنا خيرَ من مشى فوقَ ظه","رِ الأرضِ أوطاف مَحرماً بالحَطيمِ",64,"م",1,0],["لِعُنقودِ دَرٍّ قَد تَناثَرَ حَبُّهُ","حَواليهِ مِن حِبٍّ لَدى صَحنِ عَسجَدِ",65,"د",1,0],["لعنَ الكواعبَ بعد يومِ صريمتي","بشرى الفراتِ وبعد يَوم الجَوسَقِ",66,"ق",1,0],["لَعَنَ اللَهُ لَيلَةً بِتُّ فيها","مَع رَفيقي كَأَنَّنا في الكَنيفِ",67,"ف",1,0],["لعن الله يزيد والدعي ابن زياد","وابن سعد وابن هند وأولى البأس الشداد",68,"د",1,0],["لعنة تبقى مدى الدهر إلى يوم المعا","وسقاهم بعدان عذبهم ماء الصديد",68,"د",1,0],["لِعَنْبَرِ الغَيْمِ فِيهَا كُلُّ مُشْغِلَةٍ","بِمَجْمَرِ البَرْقِ أَيْدِي الرِّيحِ تُذْكِيهَا",69,"ي",3,0],["لَعَنَ اللهُ وَلاَ يَغْفِرْ لَهُمْ","سَاكِنِي الْكُوفَةَ مِنْ حَيَّيْ مُضَرْ",70,"ر",1,1],["لعن الله من يسب علياً","وحسيناً من سوقة وإمام",71,"م",1,0],["لُعِنَ الكَاذِبُ دُنْيَا","ثُمَّ أخْرَى لَعْنَتَيْن",72,"ن",1,0],["لَعنقٌ سُطِيعٌ نَيِّرٌ وَمُبَرَّمُ","حَوَى صَدرُ مَحبُوبِ الإِلهِ مُحَمدِ",73,"د",1,0],["لعناية سبقت لهم من صدقهم","حصلوا بها في رتبةِ النبآء",74,"ا",2,0],["لَعنة اللَه عَلى ظالمهم","لَعنة تَبقى إِلى يَوم التَناد",75,"د",1,0],["لعنة الله عليه","وبراغيث الكلاب",76,"ب",1,0],["لعنة اللَه لا تزال على الشمر","ومن خان احمداً بالذمام",77,"م",1,0],["لَعَنَ اللَهُ أَخا البُخ","لِ وَإِن صَلّى وَصاما",78,"م",2,0],["لَعنة اللَه عَلى شَيبتها","وَأَثاب اللَه فيها مِن لَعَن",79,"ن",1,0],["لَعَنت بِلَعن اللَه ما دامَ قادِراً","وَمُتَصِفاً دُنيا وَأُخرى بِمنعم",80,"م",1,0],["لُعِنَ الثَلاثَةُ مُنذِرٌ وَاِبنُ اِستِها","وَطَليحَةُ الداعي جِهاراً لِلرَّدى",81,"ا",1,0],["لعنَ الإلهُ قُريَّةً يممتها","فأضافني ليلاً إليها المغربُ",82,"ب",1,1],["لعنتُ أول ذي صُنعٍ لطائرة","حتى ولو كان عبّاس بن فرناس",83,"س",1,0],["لعن الله علة تركتني","رغم أنفي أعيش عيشة شاعر",84,"ر",1,1],["لعن السن فارقا ذا بلاء","جهلوني حتى عزوني لجهل",85,"ل",1,0],["لعن اللَه صنعة الشعر ماذا","من صنوف الجهال فيها لقينا",86,"ن",2,1],["لعنت كراء البيت كم ذا أهنتني","وأذللت كبرى بين كل رحاب",87,"ب",1,0],["لعنت يا رب غيرى واغتفرت له","هلا غفرت لشاك غير مقترف",88,"ف",1,0],["لعنت قومٌ رأت في","حلبتي مثلي معادا",89,"د",2,0],["لعن الاله من العباد لئامهم","واللابسين برانس الرهبان",90,"ن",1,0],["لعِنتُم في الأرض والسماءِ","على لسان جملة الأحياء",91,"ا",2,0],["لَعَنَ اللَهُ الَّذي قَل","لَدَ عَبّاسَ الوَزارَه",92,"ر",2,1],["لعنوه لعن عدوِّ آدم إذ بدا","كان الوعيد عليه وهو العيد",93,"د",1,0],["لعنَ الله مبدِعَ التَّفخِيذ","قد أتى لا أتى بغير لذيذِ",94,"ذ",1,1],["لَعَنَّا العامريَّ وكَانَ حَيَّا","فحين مَضَى تَرَحَّمنَا عليه",95,"ي",2,0],["لَعَنوا كَما بغضوا صَحابَةَ أَحمَد","وَوِدادُهُم فَرضٌ عَلى الإِنسانِ",96,"ن",1,0],["لَعَنَ النَبيُّ مُحَلِّلاً وَمُحَلَّلاً","فَكلاهُما في الشَرعِ مَلعونانِ",96,"ن",1,0],["لعن الوصي وبدل الأحكام وار","تكب الكبائر باللسان وباليد",97,"د",1,0],["لعن الله عدّوا ل","آل إبليس وحزبه",98,"ب",2,0],["لعنتم جميعا من وجوه بليدة","تكنفهم جهل ولؤم فأفرطا",99,"ط",2,1],["لعنَ الله ليلةَ الساباطِ","كَسرتْ همّتي وأفنتْ نشاطي",100,"ط",2,1],["لعنت فما هن