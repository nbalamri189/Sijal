{"poems":[[55,"أتذكراني طلب الطوائل","https://www.aldiwan.net/poem29897.html","الرجز"],[59,"توكلت في رزقي على الله خالقي","https://www.aldiwan.net/poem24657.html","الطويل"],[44,"إذا كنت معنيا بأمر تريده","https://www.aldiwan.net/poem50458.html","الطويل"],[80,"وعدت وأخلفتني الموعدا","https://www.aldiwan.net/poem14175.html","المتقارب"],[51,"ألا هل على زمني مسعد","https://www.aldiwan.net/poem62050.html","المتقارب"],[51,"لعمر أبي لو أنني أتفكر","https://www.aldiwan.net/poem62083.html","البسيط"],[42,"تطاول أيامي وليلي أطول","https://www.aldiwan.net/poem42283.html","الطويل"],[92,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[119,"توكل على الرحمن الامر كله","https://www.aldiwan.net/poem41223.html","عموديه"],[154,"توكل إذا نابتك يوما ملمة","https://www.aldiwan.net/poem68522.html","الطويل"],[309,"إذا شئت أن تحيا سعيدا مدى العمر","https://www.aldiwan.net/poem16761.html","الطويل"],[411,"توكل على الله في كل","https://www.aldiwan.net/poem49814.html","المتقارب"],[463,"حبست وأيام الملوك كذاكا","https://www.aldiwan.net/poem56082.html","الطويل"],[518,"أيا قلب لا تجزع من البين واصطبر","https://www.aldiwan.net/poem67726.html","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137762",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38194","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119939","المتقارب"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61242","المتقارب"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26427","الوافر"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102543","الطويل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82941","المتقارب"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75924","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94287","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202935","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205040","الوافر"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115450","المتقارب"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86275","الطويل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110058","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73092","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73175","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58101","الطويل"],[4728,"يا غريب","https://www.poetsgate.com/ViewPoem.aspx?id=176951",""],[5122,"((بنات أبتكارأفكار فكري))","https://www.poetsgate.com/ViewPoem.aspx?id=24260",""],[5138,"بعض البشر","https://www.poetsgate.com/ViewPoem.aspx?id=184844",""],[5187,"لقاءٌ بلا مَوعِد","https://www.poetsgate.com/ViewPoem.aspx?id=37393",""],[5198,"نسمة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=136243",""],[5277,"ضميرٌ منفصل","https://www.poetsgate.com/ViewPoem.aspx?id=187822",""],[5544,"فحَلّق بِها يا هَيثَم المجد عالياً","https://www.poetsgate.com/ViewPoem.aspx?id=213408",""],[5664,"الظما","https://www.poetsgate.com/ViewPoem.aspx?id=176678",""],[5720,"سينقشعُ البلاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=210799",""],[5721,"أعظم من أسلافي الأول","https://www.poetsgate.com/ViewPoem.aspx?id=215232",""],[5804,"لا خيرَ في الخير","https://www.poetsgate.com/ViewPoem.aspx?id=186971",""],[5956,"ستجعل مني الصبايا مُهِمَّا","https://www.poetsgate.com/ViewPoem.aspx?id=185399",""],[5975,"في ولاء آل بيت الرسول1","https://www.poetsgate.com/ViewPoem.aspx?id=53466",""],[5976,"وبْل القصيد .. !!","https://www.poetsgate.com/ViewPoem.aspx?id=30535",""],[6115,"لاتكتلف للي يدور على فرقاك","https://www.poetsgate.com/ViewPoem.aspx?id=180476",""],[6115,"قالو عللامك مع الأيام متغير","https://www.poetsgate.com/ViewPoem.aspx?id=180495",""],[4222,"تُرى يجتمعُ الشّملُ","https://www.poetsgate.com/ViewPoem.aspx?id=71346",""]],"verses":[["توكِسُ أَحداثُ اللَيالي صَفقَتي","لا دَرَّ دَرُّ الدَهرِ مِن مُعامِلِ",0,"ل",1,0],["تَوَكَّلتُ في رِزقي عَلى اللَهِ خالِقي","وَأَيقَنتُ أَنَّ اللَهَ لا شَكَّ رازِقي",1,"ق",2,1],["تَوكَّل وَحَمِّل أَمرَكَ اللَهَ إِنَّ ما","يُرادُ لَهُ آتيكَ أَنتَ لَهُ مُخلِ",2,"ل",1,0],["تَوكّفها زَمنا ناظِري","إِذا مَرّ يَومٌ تَمادى غَدا",3,"د",2,0],["تَوَكَّل عَلى اللَهِ وَاِقنَع وَلا","تَرِد فَضلَ مَن فَضلُهُ أَنكَدُ",4,"د",1,0],["تَوَكَّل عَلى الرَحمَنِ في كُلِّ حاجَةٍ","أَرَدتَ فَإِنَّ اللَهَ يَقضي وَيَقدِرُ",5,"ر",1,0],["تَوَكَّلتُ وَاِستَحدَثتُ رَأياً مُبارَكاً","وَأَحزَمُ هَذا الناسِ مَن يَتَوَكَّلُ",6,"ل",1,0],["تَوَكَّلَ ان يسودَ الناس حكمٌ","يُساوي من أُجيعَ بمن أجاعا",7,"ع",2,0],["توكل على الرحمن الامر كله","توكل ذي عقل نحا منهج الادب",8,"ب",1,1],["تَوَكَّل إذا نابتك يوماً ملمةٌ","على من له في خَلقِهِ الخلقُ الحكمُ",9,"م",1,1],["تَوَكَلَّ عَلى مَولاكَ وَاِرضَ بِحُكمِهِ","وَكُم مُخلِصاً لِلَهِ في السِرِّ وَالجَهرِ",10,"ر",1,0],["توكَّلْ على الله في كُلِّ","ما تحاولُهُ واتَّخِذْهُ وَكيلا",11,"ل",2,1],["توكَّلْ على مَن غَمَّها في سِفارها","فكم كنتَ في أمثالها فكفاكا",12,"ك",2,0],["توكل على الرحمان إن كنت مؤمناً","يجرك ودعني من نحوس الطوالع",13,"ع",1,0],["توكل على الله في كل حال","يطب بدء أمرك والمنتهى",14,"ه",2,0],["تَوَكَّل عَلى اللَّهِ العَظيمِ جَلالُهُ","وَسَلِّم إِلَيهِ الأَمرَ تَسلَمْ وَتغنَمِ",15,"م",1,1],["توكل على جود يحيى الوزير","ولا تطلبن سوى ذاك تكفي",16,"ف",2,0],["تَوكل عَلى اللَّه تَلقَ الَّذي","يَسرك مُستَعجِلاً يقبل",17,"ل",1,1],["توكيدها مقرّر بنسبته","أو الشمول أو بلفظ جيء به",18,"ه",1,0],["توكيد معنى نفس أو عين وفي","غير الفريد أفعل لا يختفي",18,"ي",1,0],["توكيد لفظ عود باد مسجلا","ومنه مردف فجاجا سبلا",18,"ل",2,0],["تَوَكَّلنا عَلى رَبِّ السَماءِ","وَسَلَّمنا لِأَسبابِ القَضاءِ",19,"ا",2,1],["توكل عليه واحسن الظنّ راجياً","لافضاله فاللَه نعم كفيل",20,"ل",1,0],["توكَّل على اللَّهِ فيما اعتَراكَ","وَلا تُشرِكَنَّ سِواهُ معه",21,"ه",1,1],["تَوكَّدَت بَينَ روحينا مُناسَبَةٌ","لِذَلِكَ اِتَفَقا في الوِرد وَالصَدَرِ",22,"ر",1,0],["توكل عليه وحد عن سواه","تجد واحدا ما به من خصاص",23,"ص",1,0],["توكل على الله الذي ما له ندّ","وليس له قبل وليس له بعد",24,"د",1,1],["توكأ في المسير على يديه","فكاد بأربع يغدو سراه",25,"ا",2,0],["توكّل على اللَه بعد التُقى","يُنجيك واسجد له واقتربُ",26,"ب",1,1],["تَوكل عَلى المَولى وَنادِ لكَ الحَمدُ","فَإِنَّكَ ما بَينَ الكِرامِ لَهُ عَبدُ",27,"د",1,1],["توكِيداً أو نَوعاً يُبينُ أو عَدَد","كَسِرتُ سيرَتَينِ سَيرَ ذِىرَشَد",28,"د",1,0],["توكيد رِفعتهم خفضُ الجَنابِ على","أَنَّ الوضيعَ هنا عندَ الالهِ سُمي",29,"م",2,0],["توكّلنْ على الإله يكفِكا","تعجيلك العقاب من سفهِكا",30,"ك",2,0],["توكلْ على اللّهِ الذي لكَ أَصبحتْ","كلاءتُهُ دِرعاً وعصمتهُ ترْسا",31,"ر",3,0],["تَوكَّل عليهِ تُكفَ وارمِ بهِ تُصِب","وَآولَهُ تَنجُ وأقصِدهُ تَغنَمِ",32,"م",1,0],["توكِّلُ طرفي في دُجا الليلِ بالسُّها","وهيهاتَ أَن يرثي السُّها للمُسهَّدِ",33,"د",1,0],["توكَّلْ ولا ترجُو سوى اللهِ وحْدَهُ","فلا خابَ مَنْ للهِ يرجُو ويأمُلُ",34,"ل",1,0],["توّك بسنّ الشباب وفيك بان المشيب","والعلم بيّن لنا ما فوق كفّه خضاب",35,"ب",1,0],["توكل على الله دام وقتك ملي أخطار","ترى الناس منه يابيض الوجه مرتابه",36,"ب",2,0],["توك تقفي يقلب الصفر تسعه","وبالنميمه ما يوقف لسانه",37,"ن",2,0],["تُؤكِّدُ صِدقَ ما زَعَمَتْ","وأرفُضُ زَيْفَ دَعْواها",38,"ا",3,0],["توّك تجي والليل يجمع شتاته","عانه يلوّح للمحبين بيديه",39,"ي",2,0],["توكّأتْ فوق ضرسِ الخوفِ فارعةً","تنعى الخؤولةَ والأعمامَ للذممِ",40,"م",1,0],["توكل على الله الذي انت مؤمنٌ به","واستعنه فهو بالخلق ألطفُ",41,"ف",1,0],["توكل ما بقى لك شي في عمري كود تذكارك","أو اسمع حتى تذكارك كسرته داخل أهدابي",42,"ب",2,0],["توكّلنا علىٰ ربٍّ عظيمِ","سيدحرُ كلَّ فتَّاكٍ أثيمِ",43,"م",1,1],["تَوَكُّلٌ وَ دَعَاءٌ وَ اسْتِعَانَةُ رُو","حٍ وَ اسْتِعَاذَةُ مُرْتَابٍ مَنَ الوَجَلِ",44,"ل",1,0],["توكّلْ عليهِ وكنْ خاشيًا","ولا تخشَ ما هبَّ يومًا ودبْ",45,"ب",1,0],["تؤكّد أن الجميع يُعاني","فهنَّ ظِماءٌ كما أنا أظما",46,"م",2,0],["توكّلَ واستهدى وجاءَ بجذوةٍ","هي النارُ يزكيها الغرامُ إذا شبّا",47,"ب",2,0],["توّك بعد .. ما عرفت الحب .. وحروقه","توّ الغلا باوّله والدرب يبدا .. توْ .. !!",48,"و",1,0],["توكل على الله واطلب العون من مولاك","ولا تبتلش مابين هذي وهاذيّه",49,"ي",2,0],["تؤكل حقوقه ويلق الظلم ويعيّر","حتى من اقرب قريب له والارحامي",50,"م",2,0],["توكّلتُ على اللهِ","إذا ضاقتْ بي السُّبْلُ",51,"ل",1,0]]}