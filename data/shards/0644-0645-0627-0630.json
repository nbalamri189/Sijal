{"poems":[[53,"شوق يعرض لا إلى الآرام","https://www.aldiwan.net/poem29772.html","الكامل"],[53,"أيرجع ميتا رنة وعويل","https://www.aldiwan.net/poem29891.html","الطويل"],[100,"منزغ الشياطين","https://www.aldiwan.net/poem6546.html","عموديه"],[100,"وراء الرياح","https://www.aldiwan.net/poem23704.html","عموديه"],[55,"أيا هم نفسي من العالمين","https://www.aldiwan.net/poem26118.html","المتقارب"],[55,"ألا أسعديني بالدموع السواكب","https://www.aldiwan.net/poem26543.html","الطويل"],[88,"أيا سائلا عنا ببغداد إننا","https://www.aldiwan.net/poem44796.html","الطويل"],[88,"بدت كالشمس يحضنها الغروب","https://www.aldiwan.net/poem45008.html","الوافر"],[72,"بعثت طيفها إلينا رسولا","https://www.aldiwan.net/poem20542.html","الخفيف"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[26,"نام الخلي وبت الليل مشتجرا","https://www.aldiwan.net/poem24088.html","البسيط"],[92,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[85,"أيامكم أم عهد إسماعيلا","https://www.aldiwan.net/poem63755.html","الكامل"],[45,"ألا أسعديني بالدموع السواكب","https://www.aldiwan.net/poem11438.html","الطويل"],[61,"سعد حبيت به وجد مقبل","https://www.aldiwan.net/poem51472.html","الكامل"],[49,"أوالب أنت في العرب","https://www.aldiwan.net/poem63236.html","مجزوء الوافر"],[105,"نادى الشباب فهب من إغفائه","https://www.aldiwan.net/poem42094.html","الكامل"],[105,"يا أيها الناس إن الله يأمركم","https://www.aldiwan.net/poem43081.html","البسيط"],[48,"أما والطورِ والنورِ","https://www.aldiwan.net/poem66557.html","الهزج"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85327","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16701","الطويل"],[100,"استنطاق","https://www.poetsgate.com/ViewPoem.aspx?id=206345",""],[100,"أغنية من خشب","https://www.poetsgate.com/ViewPoem.aspx?id=50378",""],[100,"عتاب ووعيد","https://www.poetsgate.com/ViewPoem.aspx?id=50123",""],[108,"لاتزعّلني .. على .. مابي","https://www.poetsgate.com/ViewPoem.aspx?id=8397",""],[99,"حزب الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=15743",""],[105,"نادى الشباب فهب من إعفائه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55065&r=&rc=235",""],[88,"أيا سائلا عنَّا ببغدادَ إننا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19513&r=&rc=16",""],[129,"رويدك شمس الحياة","https://www.aldiwan.net/poem67443.html","مجزوء المتقارب"],[135,"لماذا أهاب الضيم أو أرهب الدهرا","https://www.aldiwan.net/poem49089.html","الطويل"],[152,"الشوكة","https://www.aldiwan.net/poem17104.html","عموديه"],[186,"صبرت لصرف هذا الدهر لما","https://www.aldiwan.net/poem43916.html","الوافر"],[199,"قاسوك يا شمس الضحى","https://www.aldiwan.net/poem45340.html","مجزوء الكامل"],[204,"لم إذا ما مررت تهت علينا","https://www.aldiwan.net/poem53215.html","الخفيف"],[223,"كعاب أتت في الحسن فخر الكواعب","https://www.aldiwan.net/poem41907.html","الطويل"],[227,"لهفي على عيش مضى","https://www.aldiwan.net/poem34058.html","عموديه"],[270,"لماذا أسبلت دمعا لماذا","https://www.aldiwan.net/poem35024.html","الوافر"],[270,"إذا افتر ثغر الخود أو طرفها رنا","https://www.aldiwan.net/poem35425.html","الطويل"],[270,"أرى حبي شرارا مستطيرا","https://www.aldiwan.net/poem35589.html","الوافر"],[270,"رأيت زهر النوى نضيرا","https://www.aldiwan.net/poem35668.html","مخلع البسيط"],[275,"لبانة المستهام لبنى","https://www.aldiwan.net/poem25508.html","مخلع البسيط"],[328,"أبنجواي من رقيق النشيد","https://www.aldiwan.net/poem55060.html","الخفيف"],[342,"إلى أين في هذه الفانية","https://www.aldiwan.net/poem55382.html","المتقارب"],[352,"تعبت","https://www.aldiwan.net/poem951.html",""],[352,"لماذا؟","https://www.aldiwan.net/poem955.html",""],[362,"لماذا ؟","https://www.aldiwan.net/poem11637.html","عموديه"],[371,"لما ذكرت قديم ود","https://www.aldiwan.net/poem57009.html","مجزوء الكامل"],[400,"رجوتك يا حبيب","https://www.aldiwan.net/poem6720.html","عموديه"],[400,"تنوعت الجراح","https://www.aldiwan.net/poem6787.html","عموديه"],[400,"هو الحب الكبير","https://www.aldiwan.net/poem10294.html","عموديه"],[400,"رسالة اعتذار إلى أم المؤمنين خديجة (رضي الله عنها)","https://www.aldiwan.net/poem10309.html","عموديه"],[400,"رويدك إن الموج في البحر صاخب","https://www.aldiwan.net/poem21955.html","عموديه"],[402,"ملك به عز الشريعة مظهر","https://www.aldiwan.net/poem46933.html","الكامل"],[405,"قصدتك أركب البيد القفار","https://www.aldiwan.net/poem49934.html","الوافر"],[416,"تبين حق للعباد وباطل","https://www.aldiwan.net/poem53998.html","الطويل"],[432,"أنجد الصب وغاروا","https://www.aldiwan.net/poem12645.html","مجزوء الرمل"],[448,"شوقي إليكم مثل وجدي فيكم","https://www.aldiwan.net/poem53724.html","الكامل"],[449,"أثر النكسة 1967","https://www.aldiwan.net/poem992.html",""],[453,"لماذا أعزي بل لماذا أهنىء","https://www.aldiwan.net/poem61308.html","الطويل"],[453,"لماذا الثورة اشتعلت لماذا","https://www.aldiwan.net/poem61350.html","الوافر"],[453,"طيور الخريف أطيلي البقاء","https://www.aldiwan.net/poem61659.html","المتقارب"],[458,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[477,"دع عنك ما زخرف الواشي وما زعما","https://www.aldiwan.net/poem15273.html","البسيط"],[515,"يا سيداً في أوصافه","https://www.aldiwan.net/poem12111.html","مجزوء الكامل"],[558,"تقول الأجانب عن علمنا","https://www.aldiwan.net/poem34083.html","المتقارب"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"لم أذق بعد ريقه البابليه","https://www.aldiwan.net/poem2830.html","الخفيف"],[575,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"]],"verses":[["لَمّا ذَكَرتُكَ عادَ قَلبي شَوقُهُ","فَبَكَينَ عَنهُ مَدامِعَ الأَقلامِ",0,"م",1,0],["لِماذا تُرَبّي المُرضِعاتُ طَماعَةً","لِماذا تَخَلّى بِالنِساءِ بُعولُ",1,"ل",1,0],["لماذا ينافي آخر الشوق بدأه؟","لأن الذي لاينبغي، عنده ابتغى",2,"غ",2,0],["لماذا اجيب ؟ وتستنبتين","سؤالا ، يبرعم حلم الصباح",3,"ح",1,0],["لِماذا تَكَرَّهتِ رَدَّ السلامِ","أَيُفسِدُ ذاكَ عَلَيكِ الصِياما",4,"م",2,0],["لِماذا أَرَدتِ الصِرمَ مِنّي وَلَم أَكُن","لِعَهدِكُمُ بِيَ بالمَذوقِ المُوارِبِ",5,"ب",1,0],["لماذا نخاف جُبناً فلم نقم","إلى الذَّب عنا من أمور هي الموت",6,"ت",1,0],["لماذا يا نجيب صَرَمت حبلي","وهل أذنبت عندك يا نجيب",7,"ب",1,0],["لم أذق صدّ جودكم فأغني","قمت ليل الصُّدود إلاَّ قليلا",8,"ل",2,0],["لِمْ إذا أقبل الزمانُ بإخصا","بٍ تربّعتُ منك في إجدابِ",9,"ب",1,0],["لَمّا ذَكَرتُ أَخا العِمقى تَأَوَّبَني","هَمّي وَأَفرَدَ ظَهري الأَغلَبُ الشيحُ",10,"ح",1,0],["لماذا نمرُّ بوادي الزَّمانِ","سِراعاً ولكنَّنا لا نَعودْ",11,"د",1,0],["لَمّا ذَكَرتُ بِهِ البِلادَ وَأَهلَها","مَثَّلتَ دَورَ مَماتِها تَمثيلا",12,"ل",2,0],["لِماذا أَرَدتِ الهَجرَ مِنّي وَلَم أَكُن","لِعَهدِكُمُ لي بِالمَذوقِ المُوارِبِ",13,"ب",1,0],["لمَّا ذكَرتُ الحادثاتِ بذِكره","جاءت إليَّ صُروفُها تَتنصَّلُ",14,"ل",1,0],["لِما ذَكَّرتَني مِن لَو","نِ أَجدادي وَلَونِ أَبي",15,"ب",2,0],["لمّا ذهبتَ وكُنتَ مَرجعَ أمرهِ","ذَهبَ الطّبيبُ المُرْتَجَى لِشفائِه",16,"ا",3,0],["لَمّا ذَهَبتُم سَواماً لا رُعاةَ لَها","سالَت عَلَيكُم فِجاجُ الأَرضِ ذُؤبانا",17,"ن",2,0],["لماذا بكرُ ما عذّ","بَ قلبي بالجمادين",18,"ن",1,0],["لماذا تحركت الأنجمُ","كأَنَّك مِثلي لا تَعلَمُ",19,"م",1,1],["لماذا أجبني نحسّ بِما","نُلاقي فنلتذّ أَو نألم",19,"م",1,0],["لَمَاذِيّةٌ بَيْضَاءُ ما رامَ ذَوْقَها","ذُبابٌ سِوى ما أخْلَصَتْهُ المَداوِس",20,"س",1,0],["لماذا طريق المهد واللحد واحد","لماذا الذي يأتي، إلى البدء عائد؟",21,"د",1,1],["لماذا يظل البدء يبدأ دائماً؟","لأن التناهي كالبدايات جاهد",21,"د",1,0],["لماذا تراب الأرض عالٍ وهابط؟","لأن مسود التحت كالفوق سائد",21,"د",1,0],["لماذا ترق الريح عند الضحى، ولا","تحول غصوناً في الربيع الجلامد؟",21,"د",1,0],["لماذا يعود الميت طفلاً بلا صبىً","وتلبس أجفان الشهود المشاهد؟",21,"د",1,0],["لماذا البيوت الغائرات يلفها","ركود، وما أوجاعهن رواكد؟",21,"د",1,0],["لماذا الذي أهل الحمى يرفضونه","يقوي يديه الطامعون الأباعد؟",21,"د",1,0],["لماذا لأجيال العوادي عشائر","وما للمنى عنهن منهن ذائد؟",21,"د",1,0],["لماذا الصميميات تغفو على المدى","وتحتل أكتاف الجهود الزوائد؟",21,"د",1,0],["لماذا العدوّ القصي اقرب ؟","لأن القريب الحبيب اغترب",22,"ب",1,1],["لماذا استشاط زحام الرماد ؟","تذكر أعراقه فاضطرب",22,"ب",1,0],["لماذا الذي كان ما زال يأتي ؟","لأنّ الذي سوف يأتي ذهب",22,"ب",1,0],["لماذا تمنّى الظروف الحنين","فتغري وتعرض غير الطلب",22,"ب",1,0],["لماذا ، لماذا ركام يمرّ","ركام يلي دون أدنى سبب ؟!",22,"ب",1,0],["لماذا ؟! ويمحو السؤال","وينسى الجواب اسمه واللّقب",22,"ب",1,0],["لماذا لي الجوع والقصف لك ؟","يناشدني الجوع أن أسألك",23,"ك",1,1],["لماذا ؟ وفي قبضتيك الكنوز º","تمدّ إلى لقمتي أنملك",23,"ك",1,0],["لماذا تسود على شقوتي ؟","أجب عن سؤالي وإن أخجلك",23,"ك",1,0],["لماذا تدوس حشاي الجريح º","وفيه الحنان الذي دلّلك",23,"ك",1,0],["لماذا ؟ والاّ ليه .؟ وكيف.؟ والاّ شلون عنّي غاب","وأنا وجودي وجوده فالبلد وغيابه غيابي",24,"ب",2,0],["لماذا لا يكونُ عضواً في حزب الحزنْ","الذي يضمُّ مئةَ مليون عربي؟؟؟",25,"ي",1,0],["لما ذهبت وكنت مرجع أمره","ذهب الطبيب المرتحى لشفائه",26,"ا",3,0],["لماذا نخاف الموت جبناً فلم نقم","إلى الذّب عنا من أمور هي الموت",27,"ت",1,0],["لماذا نَزَلنا بها","وصِرنا عليها عبيد",28,"د",1,0],["لماذا أهابُ الضيم أو أرهب الدهرا","وهمتكم تعلو على المشترِي قَدْرا",29,"ر",2,1],["لِمَاذَا تَخَافُونَنِي، لَسْتُ أَدْرِي","فَلَيْسَ لَدَيَّ قُصُورٌ وَجُنْدُ؟!",30,"د",1,1],["لِمَاذَا تَفُورُونَ غَيْظًا عَلَيَّ","وَلَيْسَ لَدَيَّ سُعَادٌ وَهِنْدُ",30,"د",1,0],["لماذا أسترقّ وكلّ يوم","جديد فيه لي رزق جديد",31,"د",1,0],["لماذا تجافينَ يا هندُ عني","هبيني ظلاً وراءَكِ سارا",32,"ر",2,0],["لِم إذا ما مررتَ تِهتَ علينا","وجعلتَ الطريق غيرَ الطريقِ",33,"ق",1,1],["لِماذا وَلم تَطلب سِوى الحَقِّ رائِداً","تحفُّ بِها الأَضدادُ من كُلّ جانِبِ",34,"ب",1,0],["لما ذكرت عهوده","جرت الدموع وقلت أي",35,"ي",1,0],["لماذا أسبلت دمعاً لِماذا","وزهرُ الخدِّ لا يَهوَى الرذاذا",36,"ذ",2,1],["لماذا خلقتَ الغانياتِ وقلتَ من","رأى امرأة ثم اشتهاها فقد جنى",37,"ن",2,0],["لماذا ترفعين الذَّيلَ عمداً","ليبدو الساقُ أبيضَ مُستَديرا",38,"ر",2,0],["لمّا ذَوى الزَّهرُ في فؤادي","كَرِهتُ في الرَّوضِ أن أسيرا",39,"ر",2,0],["لَمْ أذكِرْها علَى سُلُوّ","إِلا وَجَدتُ الجَنانَ جُنَّا",40,"ن",2,0],["لم أذق فيك غير سهد الثكالى","وأنين المعذب المفئود",41,"د",1,0],["لماذا خلقنا وماذا ترى","نكون وهلا نجي ثانية",42,"ي",2,0],["لماذا أسلم للبحر أمري","وأمنح للريح أيام عمري",43,"ي",1,1],["لماذا نصلي لرب الخليقه","ويقتل فينا الشقيق شقيقة",44,"ق",2,1],["لماذا أيها الباري","جعَلتَ الكونَ في صَخَبِ؟",45,"ب",1,0],["لمَّا ذكرتُ قَديمَ وُد","دِكَ هاجَني بعد السكونِ",46,"ن",1,1],["لماذا يا أخي ترتدُّ نحوي","ووجهُكَ في مقابلتي غَضُوبُ؟!",47,"ب",1,0],["لماذا حين أعلن قول صدقٍ","أرى بعض الصدور به تضيق",48,"ق",1,0],["لماذا تعتبين على مُحِبٍّ","سقاه الحبُّ بالكأس الدِّهاقِ",49,"ق",1,0],["لما ذكرتُ \"خديجةَ\"اقترب المَدَى","ورَناَ إِليَّ الغُصْنُ والعنقودُ",50,"د",1,0],["لماذا أشكُّ في سلامة مقصدي ؟","فيا ضيعة الدنيا إذا شكَّ صاحبُ",51,"ب",1,0],["لَمْ أذكرِ الفتحَ بن خاقان ولاَ","قد عاقَني عن بَحْرِ جُودِكَ جعفَرْ",52,"ر",1,0],["لِماذا يمَّمَتْ دارَ امرِئٍ لا","يخُطُّ لنَفسهِ في المَجدِ دارا",53,"ر",2,0],["لما ذهبت أمْوالُه وتَقَلّبَتْ","به الحال فيما يبتغي ويحاول",54,"ل",1,0],["لم أذُقْ من ذلك ال","خمرَ فمن أينَ الخُمارُ",55,"ر",1,0],["لم أذكر اسمكم الشريف لغيرة","منى عليه أن يفوه به فم",56,"م",1,0],["لماذا لا توحدنا الرزاي","أليس الخطب بالخطب الجسيم",57,"م",1,0],["لماذا أعزّي بل لماذا أهنّىء","وشعبكمو للذل والظلم موطئُ",58,"ا",1,1],["لماذا الثورة اشتعلت لماذا","أوهم أم أبي الجبن النفاذا",59,"ذ",2,1],["لماذا الرحيلُ بليلٍ حزين","ونحن محُّبوكِ لو تعلمين",60,"ن",1,0],["لمَ أذمِّم حُرمةً سالفةً","في معاليهم ولا عهداً قُدامَى",61,"م",2,0],["لمّا ذكرتُ به هنداً وجيرتَها","أيامَ قد كان شملُ الحيَّ ملتئما",62,"م",2,0],["لما ذكرت عيوبها","أكسلت بعد الانتشار",63,"ر",1,0],["لماذا ترون السماع الذي","بآلاته طاردٌ للهمومْ",64,"م",1,0],["لما ذكرت ما روي في قتله","وصفت في ذلك بعض فعله",65,"ه",1,0],["لم أَذُقْ بعد ريقِه البابِليَّهْ","كل نُعْمىَ بالبَيْنِ فَهْيَ بَلِيَّهْ",66,"ي",2,1],["لم أَذُق غَيرَ ريقِه الحلْوِ والحلِّ","فلا غَرْوَ أَنْ حَلا لي حَلاَلُه",67,"ل",2,0]]}