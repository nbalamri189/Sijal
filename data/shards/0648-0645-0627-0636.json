مى والبان وجداً بأهله","https://www.aldiwan.net/poem3405.html","عموديه"],[480,"أساءت لمن لم يبد منه لها ذنب","https://www.aldiwan.net/poem36914.html","الطويل"],[483,"فيا رب هذا الدهر قد جار حكمه","https://www.aldiwan.net/poem24499.html","عموديه"],[501,"جرى دمعي السياح من جفني البالي","https://www.aldiwan.net/poem37821.html","الطويل"],[501,"سينسج لي بسمك الكون بدر","https://www.aldiwan.net/poem37997.html","الوافر"],[515,"مضى خلف الأبرار والسيد الطهر","https://www.aldiwan.net/poem20839.html","الطويل"],[516,"لك المجد والفضل الذي ليس يجحد","https://www.aldiwan.net/poem12072.html","الطويل"],[516,"عنان الليالي في يديك مسلم","https://www.aldiwan.net/poem12275.html","الطويل"],[517,"كسيت ولم املك سوادا وتحته","https://www.aldiwan.net/poem48646.html","الطويل"],[539,"خليفة عيسى في الشفاء من الضر","https://www.aldiwan.net/poem48178.html","عموديه"],[539,"ألا فاسمعا لي ما أعيد وما أبدي","https://www.aldiwan.net/poem48223.html","عموديه"],[539,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[552,"على الربع ربع الراحلين سلامي","https://www.aldiwan.net/poem47207.html","الطويل"],[552,"بلغت المنى في جميع المرام","https://www.aldiwan.net/poem47210.html","المتقارب"],[552,"بقاء ولكن لو أتى لا أذمه","https://www.aldiwan.net/poem47249.html","الطويل"],[552,"متى أنا ناج من سهام الغوائل","https://www.aldiwan.net/poem47258.html","الطويل"],[552,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[552,"على المزمعين البين منا عشية","https://www.aldiwan.net/poem47317.html","الطويل"],[552,"وما ضرني الإملاق والثروة التي","https://www.aldiwan.net/poem47327.html","الطويل"],[552,"لعينك منها يوم زالت حمولها","https://www.aldiwan.net/poem47330.html","الطويل"],[552,"هل العز إلا في متون السوابق","https://www.aldiwan.net/poem47358.html","الطويل"],[552,"أروني امرءا من قبضة الدهر مارقا","https://www.aldiwan.net/poem47364.html","الطويل"],[552,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[552,"لعل زمانا بالثوية راجع","https://www.aldiwan.net/poem47727.html","الطويل"],[552,"إلام أرامي في المنى وأُرادي","https://www.aldiwan.net/poem47847.html","الطويل"],[552,"عصيتك والأنفاس مني هواجر","https://www.aldiwan.net/poem47876.html","الطويل"],[552,"قفا بي على تلك الطلول الرثائث","https://www.aldiwan.net/poem48019.html","الطويل"],[552,"عجبت لشيب في عذاري طالعا","https://www.aldiwan.net/poem48052.html","الطويل"],[552,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[552,"أيا صاحبي إن لم تكن في شديدتي","https://www.aldiwan.net/poem48062.html","الطويل"],[554,"إيها دع اللوم عني لست مزدجرا","https://www.aldiwan.net/poem68366.html","البسيط"],[554,"تداعت خطوب الدهر عن جار جعفر","https://www.aldiwan.net/poem68416.html","الطويل"],[564,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[564,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[565,"لئن طرحت بي النائبات فإنني","https://www.aldiwan.net/poem865.html",""],[565,"أجودُ ابن زين أو غيوثُ سواجم","https://www.aldiwan.net/poem890.html",""]],"verses":[["وما ضر بالبدر انتقاص لقدره","وقد علمت بين النجوم مراتبه",0,"ب",2,0],["وَما ضَرَّ قَوّالاً أَطاعَ جَنانَهُ","عِندَ إِذا خانَهُ المُلوكِ لِسانُ",1,"ن",1,0],["وَما ضاقَتِ الأَقطارُ مِن دونِ فَوتِهِ","ظُبانا وَلَكِن أوبَقَ العَبدَ ظُلمُهُ",2,"م",2,0],["وَما ضَلَّت ضَلالَهُمُ بِحِجرٍ","سَقيطَةُ جَندَلٍ بَينَ الرِجالِ",3,"ل",1,0],["وَما ضَرَّ مَن أَمسى زِمامي بِكَفِّهِ","عَلى النَأيِ لَو أَرخى لَنا وَأَطالا",4,"ل",2,0],["وَما ضَرَّهُ لَو كانَ كُلُّ قَبيلَةٍ","تُطالِبُهُ يَومَ الوَغى بِدُخولِ",5,"ل",1,0],["وَما ضَرَّهُم أَن لَم يَجودوا بِمُقنِعٍ","مِنَ النَيلِ إِذ مَنَّوا قَليلاً وَسَوَّفوا",6,"ف",3,0],["وَما ضَرَّ قَلبي إِذ غَدا مِنكَ آهِلاً","تَأَمُّلُ عَيني مَنزِلاً مِنكَ مُقفِرا",7,"ر",2,0],["وَما ضَرَّهُ أَنِّي تَبَصَّرتُ هَل أَرى","وَميضاً يُريني وَجهَ أُمِّ أَبانِ",8,"ن",1,0],["وَما ضَرَّهُم غِبَّ الأَحاديثِ أَنَّها","سَتَبقى وَأَيَّامُ الحَياةِ قَلائِلُ",9,"ل",1,1],["وَمَا ضَرَّنِي أَنِّي ثَوَيْتُ بِمَغْربٍ","إِذَا طَلَعَتْ أَنْوَارُ عِلْمِي يُحِيلُهَا",10,"ل",3,0],["وَما ضَرَّ أَنفاسَ الصَبا في اِحتِمالِها","سَلامَ هَوىً يُهديهِ جِسمٌ إِلى قَلبِ",11,"ب",1,0],["وَما ضاقَ عَنهُم جانِبُ العُذرِ إِنَّهُم","كَمِثلِ القَطا لَو يُترَكونَ لَناموا",12,"م",3,0],["وَما ضَرَبَت عُتبى لِذَنبٍ أَتَت بِهِ","وَلَكِنَّما وَلّادَةٌ تَشتَهي ضَربي",13,"ي",1,1],["وَما ضاعَتِ الأَرحامُ عِندَكَ وَالَّذي","وَليتَ وَما اِستُحفِظتَ فيها لِمُجرِمِ",14,"م",1,0],["وما ضرها أن قد تأخر عهدُها","إذا طال مبناها الذين تقدّمُوا",15,"م",3,0],["وما ضرَّ ذاك الغصنَ وهو مرنَّحٌ","إذا ما ثَنى نحو المتيَّمِ عِطْفَهُ",16,"ف",2,0],["وما ضرّ كانيفا اللعين لو أنه","تقحمّ في الهيجاء عسكرنا المجرا",17,"ر",2,0],["وما ضرّهم لو أسقطوا نهج سَيرهم","وساروا بمنهاج التبصُّر والحِذق",18,"ق",1,0],["وما ضَرَ بان قلبكَ غير درس","لتلقين الخصال الفاضلات",19,"ت",1,0],["وما ضرّ العفيفةَ كشفُ وجهٍ","بدا بين الأعفّاء الاُباة",19,"ه",1,0],["وما ضَرَّ البغاد إذا تدانت","أواصر من لسان وأعتقاد",20,"د",1,0],["وما ضَرَّ لو كان التعاوُن ديننا","فتَعْمُرَ بلدان وتأمنَ قطّان",21,"ن",1,0],["وما ضَرّ أن أصفَيْت وُدّك مَعشراً","من الناس لم يَجْنُوا لك الوُدّ صافيا",22,"ي",2,0],["وما ضرّني إذ عضّني مُتشادق","شَحا بفم قد كان في العضّ أدردا",23,"د",2,0],["وَما ضَرَّ جاراً يا اِبنَةَ القَومِ فَاِعلَمي","يُجاوِرُني أَلّا يَكونَ لَهُ سِترُ",24,"ر",1,0],["وَما ضَرَّني أَن سارَ سَعدٌ بِأَهلِهِ","وَأَفرَدَني في الدارِ لَيسَ مَعي أَهلي",25,"ل",2,0],["وما ضّرها إن كعباً توى","وفوّزَ من بعده جَرْولُ",26,"ل",1,0],["وما ضربت هجائن من نزار","فوالج من فحول الأعجمينا",27,"ن",2,0],["وما ضَرَبَ الأَمثَالَ في الجَورِ قَبلَنا","لأَجوَرَ من حُكَّامِنا المُتَمَثِّلُ",28,"ل",1,0],["وما ضَرَّها أن كَانَ في التُربِ ثَاوِياً","زُهَيرٌ وَأودَى ذو القُرُوحِ وَجَروَلُ",28,"ل",1,0],["وما ضَربت هجانَ بَني نزَار","فَوَالجُ من فُحُول الأَعجَمينَا",29,"ن",2,0],["وَما ضاقَت مَذاهِبُهُ وَلَكِن","يُهابُ مِنَ الحَمِيَّةِ أَن يُهابا",30,"ب",2,0],["وما ضرني دينٌ وفعلك سالمٌ","يصرّف لي زيداً وعمراً وخالدا",31,"د",2,0],["وما ضرَّها إذ كانَ نشر نسيمها","رخاء إذا ما لم يكنْ فيهِ صرصرُ",32,"ر",1,0],["وما ضرَّ ركباً كنت نجعة أهله","تعذّرُ زادٍ أو صروفُ غمام",33,"م",1,0],["وما ضرَّ المؤمِّل مطْلُ وعْدٍ","تظل له العطية في ازديادِ",34,"د",1,0],["وما ضربتْهُ الزنج في الوجه بل رأى","أيورهُمُ فانشق في وجهه حِرُ",35,"ر",1,0],["وما ضرَّ بي الأقران عند لقائهم","بذبٍّ ولا طعني هنالك بالوخض",36,"ض",1,0],["وما ضرني من نافع أن يَضُرَّني","وذاك لحبي أن يضَرَّ وتنفعا",37,"ع",2,0],["وما ضلَّ رأيٌ فيك مُذْ عرف الهدى","ولا شابَ إيماني بسُؤْددك الشكُّ",38,"ك",1,0],["وما ضرَّ من أضحى له اسمٌ مُصغَّرٌ","ومعنى مُجَلٌّ في الصدورِ معظّمُ",39,"م",1,0],["وما ضرَّها أن لم يُثِرْ خَطراتِهِ","لها شيخُ يَربوعٍ ولا شيخُ دارمِ",40,"م",1,0],["وما ضعْفُ قِرني إنْ تصدَّي لِقُوَّتي","بمنجِيهِ منّي أو ترنَّ مآتمُ",41,"م",1,0],["وما ضرَّه ألا يُبالي بعدها","ركوبي إياها بحيث يرانيا",42,"ي",2,0],["وَما ضَرَبٌ بَيضاءُ يَأوي مَليكُها","إَلى طُنُفٍ أَعيا بِراقٍ وَنازِلِ",43,"ل",1,0],["وَما ضَمِنوا أَن لا يَموتوا وَإِنَّما","يَوَدُّ زَوالَ الشَمسِ مَن كانَ أَرمَدا",44,"د",2,0],["وَما ضَرَّها أَن لا تَكونَ طَويلَةً","إِذا كانَ فيها كُلُّ ما يَطلُبُ الإِلفُ",45,"ف",1,0],["وَما ضاعَ شِعري فيكُمُ حينَ قُلتُهُ","بَلى وَأَبيكُم ضاعَ فَهوَ يَضوعُ",46,"ع",1,0],["وَما ضَرَّني أَنّي صَغيرٌ حَداثَةً","وَإِنّي بِفَضلي في الأَنامِ كَبيرُ",47,"ر",1,0],["وَما ضَرَّ بَعضَ الناسِ لَو كانَ زارَنا","وَكُنّا خَلَونا ساعَةً نَتَحَدَّثُ",48,"ث",1,0],["وَما ضاقَتِ الدُنيا عَلى ذي مُروءَةٍ","وَلا هِيَ مَسدودٌ عَلَيهِ رِحابُها",49,"ب",3,0],["وما ضرها ألا تكون فسيحة","لمن سكنوا فيها سكون الجوامد",50,"د",1,0],["وما ضرر الإنسان من طول مكثهِ","إذا كان فيه فاقد الحس واللب",51,"ب",1,0],["وَما ضِقنا بِمَقدَمِكَ المُفَدّى","وَلَكِن جِئتَ في الزَمَنِ الأَخيرِ",52,"ر",1,0],["وَما ضِعتَ بَينَ الشَرقِ وَالغَربِ مِشيَةً","كَما قيلَ في الأَمثالِ حَجلُ غُرابِ",53,"ب",1,0],["وَماضٍ بِمالٍ قَد مَضى عَنهُ وَألُهُ","وَمُزجٍ أَثاثاً بَينَ عَينَيهِ يُنهَبُ",54,"ب",1,0],["وَما ضَرَّها خَلقٌ بِغَيرِ مَخالِبٍ","وَقَد خُلِقَت أَسيافُهُ وَالقَوائِمُ",55,"م",1,0],["وما ضَرَّ جارَكَ لوْ أَنَّهُ","يَحُدُّ له الدهرُ ظُفْراً ونابْ",56,"ب",1,0],["وَما ضُمِّنَت أَرضٌ فَتَحمَلَ مِثلَهُ","وَلا خُطَّ يُنعى في بُطونِ الصَحائِفِ",57,"ف",1,0],["وَما ضَمِنَت مِثلَ اِبنِ لَيلى ضَريحَةٌ","وَما كانَ حَيٌّ وَهوَ حَيٌّ يُعادِلُه",58,"ل",2,0],["وَما ضَرَّها إِذ جاوَرَت في بِلادِها","بَني الحِصنِ ما كانَ اِختِلافُ القَبائِلِ",59,"ل",1,0],["وما ضرني وابن الصريحين والدي","إذا ابن هجين الوالدين هجاني",60,"ن",2,0],["وما ضَرَّه أن صافحَ البَظْرْ وَجْهَهُ","إذا كان مختونَ اللسانِ فَصيحا",61,"ح",2,0],["وما ضَرَّ عِقْدٌ من ثَناءٍ نظمتهُ","وفصَّلتُهُ أن لا يعيشَ له الأعشى",62,"ا",1,0],["وَما ضَرَّني بُعدُ الدِيارِ وَأَهلِها","بِأَرضي وَفَقدُ الطَرفِ ما كانَ يَلمِحُ",63,"ح",1,0],["وما ضَعضَعتني للحوادثِ نَكْبَةٌ","ولا لان في أيدي الحوادث عُنصري",64,"ر",2,0],["وما ضُويِقُوا مَن قبلِ هذا وإنّما","بقَدرِ التهابِ النّارِ تَغْليَةُ القِدرِ",65,"ر",1,0],["وما ضرّها كافورُ شيبي وتحتهُ","لمسك شبابي كلُّ فِعلٍ ورائِحه",66,"ح",2,0],["وما ضاجعَ الهنديُّ إلا مثلّماً","مُضارِبه يَومَ الوغى في الضّرائبِ",67,"ب",1,0],["وما ضاقتْ عليَّ الأرضُ إلّا","دَحَوْتُ مكانَها خُلُقاً رحابا",68,"ب",2,0],["وَما ضَميرِيَ في ذِكراكَ مُشتَرَكٌ","وَلا طَريقي إِلى جَدواكَ مُنشَعِبُ",69,"ب",1,0],["وَما ضيقُ أَقطارِ البِلادِ أَضافَني","إِلَيكَ وَلَكِن مَذهَبي فيكَ مَذهَبي",70,"ب",2,0],["وَما ضاقَ عَنُه كُلُّ شَرقٍ وَمَغرِبٍ","مِنَ الأَرضِ إِلّا ضاقَ عَن نَفسِهِ الجِلدُ",71,"د",1,0],["وماضيةٍ إلى الرحمنِ أضحتْ","أجلَّ نساءِ أهلِ العصرِ صَيْبا",72,"ب",2,1],["وَما ضَرَّهُ أَن يَستَسِرَّ لِعاتِمٍ","إِذا ما بَدا في آخِرٍ بِتَمامِ",73,"م",1,0],["وَما ضَرَّ لَو واسى وَسَلّى بِزَورَةٍ","خَلِيٌّ جَرى فيهِ القَضاءُ عَلى راسي",74,"س",2,0],["وَما ضَرَّ أَن غابَ الأَميرُ وَخَصَّكُم","بِتابِعِهِ قَولاً وَفِعلاً وَمَحتِدا",75,"د",2,0],["وَما ضَرَّنا أَنّا قَليلٌ وَجارُنا","عَزيزٌ وَجارُ الأَكثَرينَ ذَليلُ",76,"ل",1,0],["وما ضَرَّني إِلَّا مَعارِفُ منهمُ","ذُنوبُ وِدادِي عندهمْ لا تُكَفَّرُ",77,"ر",1,0],["وما ضرّ ذا حقّ أباطلُ خصمه","إذا كانت الأقدارُ عنه تُخاصم",78,"م",1,0],["وما ضركم من حاسديكم على العلى","وأيامكم تحدو بهم وتسوق",79,"ق",1,0],["وما ضَرَّ مصراً حينَ ألقَتْ قِيادَهَا","إليكَ أمَدَّ النّيلُ أم غالَهُ جَزْر",80,"ر",1,0],["وما ضَرّ من لم يَطُفْ بالمقامِ","إذا طافَ بالجوسَقِ المُبْتَنى",81,"ا",1,0],["وَما ضَرَّها أَن لا تُعَدَّ لِجَروَلٍ","وَلا المُزَني كَعبٍ وَلا لِزِيادِ",82,"د",1,0],["وَما ضاعَ مالٌ أَورَثَ الحَمدَ أَهلَهُ","وَلَكِنَّ أَموالَ البَخيلِ تَضيعُ",83,"ع",1,0],["وَما ضَنَّ يَومٌ بِداءِ الهَوى","مُحِبّاً إِذا ما سَقاهُ الغَدُ",84,"د",1,0],["وَما ضَيَّقا أَرضي وَلَكِن أَراهُما","إِلى الضَنَكِ مِن وَجهِ البَسيطَةِ لَزّاني",85,"ن",2,0],["وَما ضَرَّ الحَمامَةَ كَسرُ ضَنكٍ","مِنَ الأَقفاصِ كانَ أَضَرَّ سِجِنِ",86,"ن",1,0],["وما ضَرَّهُ إِلا مُزَاحٌ ورِقَّةٌ","ثَنَتْهُ سفِيه الذِّكْرِ وهْو رشِيدُ",87,"د",1,0],["وَمَا ضَرَّنِي أَنِّي تَأَخَّرْتُ عَنْهُمُ","وَفَضْلِي بَيْنَ الْعَالَمِينَ شَهِيرُ",88,"ر",1,0],["وَمَا ضَاقَ صَدْرِي بِالذِينَ وَدِدْتُهُمْ","وَلاَ حَرِجَتْ بِالنَّازِلينَ رِحَابِي",89,"ب",2,0],["وَمَا ضَائِرٌ فَخْرَنَا أَنْ تُبَاحَ","وَلاَ ضَائِرُ الْجَّاهِ أَنْ تُجْتَدَى",90,"د",2,0],["وما ضرّ البنفسجَ إن توارى","حياءٌ والصدور له مقام",91,"م",1,0],["وَما ضامَهُ قَطّ الأَديبُ بِصَولَةٍ","وَلا جاءَ يَشكوهُ إِليّ رَسولُ",92,"ل",1,0],["وما ضنَّ بالدَّر ضرعُ السحاب","ولا شحَّ بطنُ الثرى بالنَّماء",93,"ا",2,0],["وما ضرَّني أن ألْبَسَ الثَّوْبَ باليا","إذا كان من عيبٍ يُدَنِّسُ خاليا؟",94,"ي",2,0],["وما ضرَّ أهلَ الحكم أنْ كان ظلُّهم","ثقيلاً على أهل النُهى والبصائر",95,"ر",1,0],["وما ضاقَ القريضُ به ستمحو","عواثِرَهُ صُدورُكم الرّحاب",96,"ب",1,0],["وما ضرهم نبوا السيوف وعندهم","عزائم من قبل السيوف قواطع",97,"ع",1,0],["وما ضرّني أسر ونفسي طليقة","مجنّحة ما كفّ من شأوها أسر",98,"ر",1,0],["وما ضقت ذرعا بالمشيب فإنّني","رأيت الضحى كالسّيف عريان أشيبا",99,"ب",2,0],["وما ضَرّ من لم يَطُفْ بالمقامِ","وفي ذي النواويسِ مْوجُ البحارِ",100,"ا",2,0],["وَما ضَربتَه فَخُذ مَنازلَه","تَعرِف بذَاك الأخذ أُسّاً لِحَاصِلِه",101,"ه",1,0],["وما ضره خدش اللئام لقدره","اذا كان في نفس الكرام له قدر",102,"ر",1,0],["وما ضرني اني من المال فارغ","ولي من جناب الله عز ومظهر",103,"ر",1,0],["وما ضرني نبح الكلاب وانني","لبدر ولم يلصق برمل كثيب",104,"ب",1,0],["وما ضرني أن الفويسق سبني","بشيء نفاه الله والخلقُ عنيا",105,"ي",2,0],["وما ضرَّ من كان الإمامُ سحابَهُ","تقاعُدُ لَمَّاعِ البوارق رجَّاسِ",106,"س",1,0],["وَما ضَرَّ مَن فاقَ المُلوكَ بِرَأيِهِ","وَإِقدامِهِ أَلّا يَكونَ لَهُ عَمرُو",107,"ر",2,0],["وما ضر لو حملتموها رسالة","إلي وهل مثل النسيم رسول",108,"ل",1,0],["وما ضرها أن السحائب أقبلت","وأنملة فيها تسح وتهمل",109,"ل",1,0],["وما ضيعت يجبره التلافي","إذا استدركت ما فيه وعدتا",110,"ت",2,0],["وَما ضَرَّني مَع قُربِهِ أَنَّ مَنزِلي","وَقَومي بِأَكنافِ المُشَقَّرِ وَالصَفا",111,"ف",2,0],["وما ضَرَّ بدرَ الدُّجى نابحٌ","عَوى وله في العَلاء اتِّساق",112,"ق",1,0],["وما ضرّني عيب برجلي يشينها","إذا صحّ تمييزي وكرّمني عقلي",113,"ل",2,0],["وما ضرّ كاسي وجهه زعفرانة","إذا سلمت أعضاؤه ومفاضله",114,"ل",2,0],["وما ضرّني سلمى ورفقي بمعشر","لساني لهم سلم وقلبي لهم حرب",115,"ب",1,0],["وَما ضَمَّ شَملَ الأُنسِ يَوماً كَنَرجِسٍ","يَقومُ بَعُذرِ اللَهوِ مِن خالِعِ العُذرِ",116,"ر",1,1],["وَما ضَرَبوا أَوتادَهُم بِحِمايَةٍ","فَيَسطيعُ قَومٌ كاشِحونَ لَها نَزعا",117,"ع",2,0],["وما ضائري أنْ يستعيروا شهادةً","لبعضهم إن النفاقَ قديمُ",118,"م",1,0],["وما ضرَّهُ لو جادَ لي بلُعَيْقةٍ","أبلُّ بها ريقي عن العُمر ينجزُ",119,"ز",1,0],["وماضي العمر والآجل","وليلاتي وأيامي",120,"ي",1,0],["وَماضي شَبابِ الفَتى لا يُرَدُّ","وَذاهِبُ عَيشِ الصِبى غَيرُ عائِد",121,"د",1,0],["وَماضي صِباً قَضَّيتُ مِنهُ لُبانَتي","خِلاساً وَعينُ الدَهرِ زَرقاءُ تَلمَحُ",122,"ح",1,0],["وما ضربوا إلا بيمناك مضرباً","وما سعدوا إلا وسعدك يغلب",123,"ب",1,0],["وما ضرّني هذا وإن لام لائمي","فوجدي به ينمو على رغم عُذّلي",124,"ل",2,0],["وما ضرّني واشي الغرام بعذله","وإن كان لسع العذل كالحيّة الرقطا",125,"ط",2,0],["وما ضمنه إلا التفرق غصة","وليست بحلقومي ولكن في حسي",126,"س",2,0],["وَمَا ضَرَّهُ واللهُ يغفِرُ ذَنبَهُ","لَوَ انّ ذُنوبَ العَالَمينَ على ظَهرِي",127,"ر",2,0],["وَما ضقت ذرعا دون ادراك مطلب","وَفي الرد من لم يخش سائله الردا",128,"د",2,0],["وَما ضَرَّني أَنِّي مَرِيضٌ وَمُدْنَفٌ","إِذا أَنا لَمْ أمْرَضْ فُؤاداً وَلا ذِهْنا",129,"ن",2,0],["وَما ضَرّها أنّي يَمانٍ وأنّها","لِقَيْسٍ ألسْنا في تعارُفِنا عُرْبا",130,"ب",2,0],["وَما ضَيغَمٌ دونَ أَشبالِهِ","يُحامي فَيَفتَحُ باعاً وَشِدقا",131,"ق",2,0],["وَما ضَرَبٌ في رَأسِ صَعبٍ مُمَرَّدٍ","بِتَيهانَةٍ يَستَترِكُ العُفرَ نيقُها",132,"ق",3,0],["وَما ضَرَّهم لو لُفَّ شَملي بشَملها","وَقَد لَفَّت الأَعراقَ ما بيننا فِهرُ",133,"ر",1,0],["وَما ضمّها ضيمٌ وَلَكن سياسةٌ","أَرتنا مُحيّا العدلِ بالفدعَةِ اِغبرّا",134,"ر",2,0],["وَماضَرَّني مَا يَقولُ العَدُوُّ","إذا رَدَّ غَيْبَتَي الصَّاحِبُ",135,"ب",1,0],["وَمَا ضَرَّهُ شَنٌّ صَغِيرٌ وَقَد سَرَى","إلى بَابِهِ مِن كُلِّ قَطْرٍ كَبيرُهُ",136,"ه",1,1],["وَما ضَرَري بِكَسرِ الجِسمِ فيها","وَقَلبي في المُقامِ بِها صَحيحُ",137,"ح",1,0],["وَما ضاقَ ذَرعي بِالمَلامَةِ مِنهُم","وَأَوسَعُ شَيءٍ فيكَ لِلعُذرِ مَسلَكي",138,"ك",2,0],["وَما ضَرّ نَفسك ياقوتها","بِنار التَجلُّد لَم يحرقِ",139,"ق",1,0],["وما ضَرَّني أن لا أَرى لي مُعاهِدا","إِذا هِيَ قالَت نَحنُ مِنكَ عَلى العَهدِ",140,"د",1,0],["وَما ضَرَّني شَىء سِوى قَول عاذِلي","وَان لَم يَفد هذا هَواهُ تكلف",141,"ف",1,0],["وما ضَرَّ صحبي سنا بارقٍ","إذا ضَنَّ ما دام عَينَي تَجود",142,"د",1,0],["وماضٍ منَ الأيّامِ أمَّا ادِّكارُهُ","فدانٍ وأمّا عهْدُه فَبعيد",143,"د",1,0],["وَما ضَرَّني أَن بالَ في البَحرِ بائِلٌ","وَلا ساءَني أَن ناطَحَ الصَخرَ ناطِحُ",144,"ح",1,0],["وَما ضَربُ زَيدِ الدَهرِ عَمراً لِريبَةٍ","مَتى يُحسِنُ التَأديبَ غَيرُ مُؤَدَّبِ",145,"ب",1,0],["وماضٍ بماضٍ بَينَ جَفنيهِ غالب","عَلى كُلِّ أرضٍ أو يطيع مطاعُها",146,"ع",3,0],["وما ضرنا منه سوى أن كيده","يُذيع مزايانا وهُوَّ خَذيل",147,"ل",1,0],["وما ضعف داء الطبع فينا ونقصه","وما هو شفا كلٍّ من النقص والضعف",148,"ف",1,0],["وما ضر نعماها إذا كنت جاحداً","وهل يَهجُنُ الآلاءَ يوماً كَفورها",149,"ر",3,0],["وما ضرّني أَنْ لاَ تَرونَ فَضَائِلي","فما خَفِيتْ إلاَّ عَلى أَعْينٍ رُمدِ",150,"د",1,1],["وما ضرَني أن لا يرون فضائلي","فما خَفِيتْ إلاّ على أَعْينِ رُمْدِ",151,"د",1,0],["وما ضَعضَعَتْنِي الحادثاتُ وإنّني","كَعهدِكَ وعْرُ الخُلقِ في الخطبِ وَعْثُهُ",152,"ث",2,0],["وما ضَرَّة لو كانَ أنْجَزَ وَعْدَه","وكنتُ به لو زارني أتشَرّف",153,"ف",1,0],["وما ضرَّني فقدي به ثروة الغنى","فلا الفضل منحطٌّ ولا النقص صاعد",154,"د",1,0],["وما ضاهاك من قاصٍ ودانٍ","بعدل الحكم أو فصل الخطاب",155,"ب",1,0],["وما ضلَّ ساري اللَّيل إلاَّ اهتدى بها","كنور سنا الإِسلام في ظلمة الكفر",156,"ر",1,0],["وما ضر هذا الخلق والقصد واحد","إذا نحن أخلصنا إليها توجهنا",157,"ن",2,0],["وماضي شباب مستعار بكيتهُ","بدمع على عصر الشبيبة مغدق",158,"ق",1,0],["وما ضم عطفيها الحسان موفقاً","إلى رحمة الرحمن غير أريب",159,"ب",1,0],["وما ضرني ان خضب الشيب مفرقي","ولي من فؤادي في الغرام مشايع",160,"ع",1,0],["وما ضرَّني منهم نحولُ مطالبي","لديهم وحظّي من نداك سمينُ",161,"ن",1,0],["وما ضرّ ساري ليلةٍ لو تناثرت","كواكبُها ما امتدَّ للقمر البقا",162,"ق",2,0],["وما ضرَّهم أنهُم يعدَمو","ن غيثاً وقد وجَدُوا منك أثرى",163,"ر",2,0],["وما ضرَّ في غير الكُفاةِ ارتخاصُها","إذا ما غلَت عند ابن عيسى مهورُها",164,"ر",3,0],["وماضي عُصور الناس قيْظٌ وانما","زمانُ الوزير الزَّيْنبي ربيعُها",165,"ه",2,0],["وما ضربت للناس امثاله سدى","ولكن لعل الناس أن تتفكّرا",166,"ر",2,0],["وما ضحكتْ ثغورُ الرّوض حتى","بكتْ من اجلها الدّميمُ الغزار",167,"ر",1,0],["وما ضاع مالٌ اكسب المرَْ هلكهُ","خلودَ ثناءٍ أو أفيد به أجر",168,"ر",1,0],["وما ضر ضرب السير لو كان ماشياً","على مهله لما سقاني بمهلهِ",169,"ل",2,0],["وما ضر محفوظ الوداد جحودها","علانية كيما يزال به الخطب",170,"ب",1,0],["وما ضر أهل الشعر أن لو أحالوهم","على الدهر لكن أرجو طبا مداويا",171,"ي",2,0],["وماضي سِقامي يا لَعَمْرِي مُضارِعٌ","بأَمرٍ روى عن مبدئي خَبَرَ الحَالِ",172,"ل",1,0],["وما ضرَّ الهِلالَ وقد تجَلَّى","إذا ما سامَهُ المنكودُ غَمْزا",173,"ز",2,0],["وما ضرّها لو أنّها في عبيدِه","منَ الخَلقِ يُفْدى ذلكَ السيّدُ الحُرُّ",174,"ر",1,0],["وما ضم هذا الشمل وهو كم ترى","وتسمعه إلا الأجل المؤيد",175,"د",1,0],["وما ضرهم أن بات قلبك بارداً","ولفظك نار جمرها يتضرم",176,"م",1,0],["وَما ضَرَّ أَثوابي سَوادي وَإِنَّني","لكا لمسك لا يَسلو عَن المِسكِ ذائِقه",177,"ق",2,0],["وما ضرَّ صومٌ لو عنِ الأكلِ وحدَهُ","ولكنَّه صومٌ يُمِضُّ أخا الشِّعرِ",178,"ر",1,0],["وما ضرَّهُ لو أنه قد أجابَنِي","بِوجهٍ بشُوشٍ ذي اعتذارٍ على قَصدي",179,"د",2,0],["ومَا ضرَّهُم أخزاهُمُ اللهُ أننِي","لِسَانيَ سبَّاقٌ وعِرضُهُمُ رَحبُ",180,"ب",1,0],["وما ضرّني لمّا شَرِبتُك أنّني","غَرَفتُ فلم أشربْ كؤوس مُدامِ",181,"م",1,0],["وَما ضلّ عَن مأثُراتٍ أَقمت","عَلى الناسِ في النّاس غير النيامِ",182,"م",1,0],["وما ضرّ مسلوبَ العزيمةِ إنْ وَنى","عن السَّعىِ والأرزاقُ حِرْصاً تؤُمُّهُ",183,"م",2,0],["وماضٍ على الشّحناء في غير زلّةٍ","وَقَد ملّ إلّا مِن عتابك جُرمُهُ",183,"م",2,0],["وما ضرّ من أدعوه أوفى أصادِقي","إذا لم يكن من معشري وقبائلي",184,"ل",2,0],["وما ضرّ أنْ فاتني آجلاً","وقد مسّني النّفعُ في العاجلِ",185,"ل",1,0],["وما ضرّهمْ لمّا أرادوا ترحُّلاً","عن الجِزْع لو داوَوْا هناك عليلا",186,"ل",2,0],["وما ضرّني الإمْلاقُ والثّروةُ الّتي","يذلّ بها أهلُ اليَسارِ ضَلالُ",187,"ل",1,1],["وما ضرّني منها وقد بتّ راضياً","بباطلها أنْ بان صُبحاً بُطولُها",188,"ل",3,0],["وما ضَلّ وَجهُ الرّأي عنه وإنّما","تقاضاه من وجه الظُّنونِ الصّوادِقِ",189,"ق",1,0],["وما ضرّ والسِّربالُ باقٍ على الفتى","إذا شعَّثَثْ منه اللّيالِي البنائقا",190,"ق",2,0],["وما ضرَّني أنّي قُذفتُ بباطلٍ","وما زلتُ عُمْرَ الدهرِ بالحقّ أصدَعُ",191,"ع",1,0],["وَما ضرّ من فارقتُ من كلّ نازحٍ","وقد لفّ لي شملاً بشملك جامعُ",192,"ع",1,0],["وما ضرّنِي والنّومُ ليس يزورنِي","دجىً وضحىً أنِّي بغير وِسادِ",193,"د",1,0],["وَما ضَرّ قَولُ الكاشِحينَ وإنّما","كلامُ الأعادي للمعالِي مَقالِدُ",194,"د",1,0],["وما ضرّني أنِّي خَليٌّ منَ الغِنى","وَوَفْرُ العُلا عندِي طريفٌ وتالِدُ",194,"د",1,0],["وما ضرّنا أنّا خَلِيّون من غِنىً","وكم شِبَعٍ يهفو بهِ غَرْثُ غارثِ",195,"ث",1,0],["وما ضرّني والعهدُ غيرُ مُبدَّلٍ","تبدُّلُ شَرْخِي ظَالماً بمشيبي",196,"ب",2,0],["وما ضرّ من كان القريبَ مودّة","مقرّبةً أنْ لم يكن من أقاربي",197,"ب",2,0],["وما ضرّ والقربُ المؤلّفُ بيننا","ودادٌ لنا أنْ لم تكنْ من أقاربِي",198,"ب",2,0],["وَما ضَمِنتُ لَها سِرّاً فَأَكتُمَهُ","إِلّا حَفَظتُ عَلَيهِ الدَمعَ وَالبَصَرا",199,"ر",2,0],["وَما ضَرَعَت لِلدَهرِ مِنكَ سَجِيَّةٌ","وَإِن طَرَقَت بِالمُفظِعاتِ بَلابِلُه",200,"ل",2,0],["وَما ضَرَّ أَوصالَ المُحِبِّ مُقَوَّتاً","رَجاءَ وِصالِ الحِبِّ اِسناتُها عَجفا",201,"ف",2,0],["وَما ضَمير يَصِلونَ لِآخِرِهِ","يَعصِهِما في الحَديثِ بَينَ ما ذُكِرا",202,"ر",2,0],["وما ضرني أني مقيم ببلدة","بها كل ذي فضل مهان مضيع",203,"ع",1,0],["وما ضل من سماك رأياً محمداً","علي المعالي أو هدته العلائم",204,"م",1,0]]}