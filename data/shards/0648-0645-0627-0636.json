"عموديه"],[479,"أساءت لمن لم يبد منه لها ذنب","https://www.aldiwan.net/poem36914.html","الطويل"],[482,"فيا رب هذا الدهر قد جار حكمه","https://www.aldiwan.net/poem24499.html","عموديه"],[500,"جرى دمعي السياح من جفني البالي","https://www.aldiwan.net/poem37821.html","الطويل"],[500,"سينسج لي بسمك الكون بدر","https://www.aldiwan.net/poem37997.html","الوافر"],[514,"مضى خلف الأبرار والسيد الطهر","https://www.aldiwan.net/poem20839.html","الطويل"],[515,"لك المجد والفضل الذي ليس يجحد","https://www.aldiwan.net/poem12072.html","الطويل"],[515,"عنان الليالي في يديك مسلم","https://www.aldiwan.net/poem12275.html","الطويل"],[516,"كسيت ولم املك سوادا وتحته","https://www.aldiwan.net/poem48646.html","الطويل"],[538,"خليفة عيسى في الشفاء من الضر","https://www.aldiwan.net/poem48178.html","عموديه"],[538,"ألا فاسمعا لي ما أعيد وما أبدي","https://www.aldiwan.net/poem48223.html","عموديه"],[538,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[551,"على الربع ربع الراحلين سلامي","https://www.aldiwan.net/poem47207.html","الطويل"],[551,"بلغت المنى في جميع المرام","https://www.aldiwan.net/poem47210.html","المتقارب"],[551,"بقاء ولكن لو أتى لا أذمه","https://www.aldiwan.net/poem47249.html","الطويل"],[551,"متى أنا ناج من سهام الغوائل","https://www.aldiwan.net/poem47258.html","الطويل"],[551,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[551,"على المزمعين البين منا عشية","https://www.aldiwan.net/poem47317.html","الطويل"],[551,"وما ضرني الإملاق والثروة التي","https://www.aldiwan.net/poem47327.html","الطويل"],[551,"لعينك منها يوم زالت حمولها","https://www.aldiwan.net/poem47330.html","الطويل"],[551,"هل العز إلا في متون السوابق","https://www.aldiwan.net/poem47358.html","الطويل"],[551,"أروني امرءا من قبضة الدهر مارقا","https://www.aldiwan.net/poem47364.html","الطويل"],[551,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[551,"لعل زمانا بالثوية راجع","https://www.aldiwan.net/poem47727.html","الطويل"],[551,"إلام أرامي في المنى وأُرادي","https://www.aldiwan.net/poem47847.html","الطويل"],[551,"عصيتك والأنفاس مني هواجر","https://www.aldiwan.net/poem47876.html","الطويل"],[551,"قفا بي على تلك الطلول الرثائث","https://www.aldiwan.net/poem48019.html","الطويل"],[551,"عجبت لشيب في عذاري طالعا","https://www.aldiwan.net/poem48052.html","الطويل"],[551,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[551,"أيا صاحبي إن لم تكن في شديدتي","https://www.aldiwan.net/poem48062.html","الطويل"],[553,"إيها دع اللوم عني لست مزدجرا","https://www.aldiwan.net/poem68366.html","البسيط"],[553,"تداعت خطوب الدهر عن جار جعفر","https://www.aldiwan.net/poem68416.html","الطويل"],[563,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[563,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[564,"لئن طرحت بي النائبات فإنني","https://www.aldiwan.net/poem865.html",""],[564,"أجودُ ابن زين أو غيوثُ سواجم","https://www.aldiwan.net/poem890.html",""]],"verses":[["وَما ضَرَّ قَوّالاً أَطاعَ جَنانَهُ","عِندَ إِذا خانَهُ المُلوكِ لِسانُ",0,"ن",1,0],["وَما ضاقَتِ الأَقطارُ مِن دونِ فَوتِهِ","ظُبانا وَلَكِن أوبَقَ العَبدَ ظُلمُهُ",1,"م",2,0],["وَما ضَلَّت ضَلالَهُمُ بِحِجرٍ","سَقيطَةُ جَندَلٍ بَينَ الرِجالِ",2,"ل",1,0],["وَما ضَرَّ مَن أَمسى زِمامي بِكَفِّهِ","عَلى النَأيِ لَو أَرخى لَنا وَأَطالا",3,"ل",2,0],["وَما ضَرَّهُ لَو كانَ كُلُّ قَبيلَةٍ","تُطالِبُهُ يَومَ الوَغى بِدُخولِ",4,"ل",1,0],["وَما ضَرَّهُم أَن لَم يَجودوا بِمُقنِعٍ","مِنَ النَيلِ إِذ مَنَّوا قَليلاً وَسَوَّفوا",5,"ف",3,0],["وَما ضَرَّ قَلبي إِذ غَدا مِنكَ آهِلاً","تَأَمُّلُ عَيني مَنزِلاً مِنكَ مُقفِرا",6,"ر",2,0],["وَما ضَرَّهُ أَنِّي تَبَصَّرتُ هَل أَرى","وَميضاً يُريني وَجهَ أُمِّ أَبانِ",7,"ن",1,0],["وَما ضَرَّهُم غِبَّ الأَحاديثِ أَنَّها","سَتَبقى وَأَيَّامُ الحَياةِ قَلائِلُ",8,"ل",1,1],["وَمَا ضَرَّنِي أَنِّي ثَوَيْتُ بِمَغْربٍ","إِذَا طَلَعَتْ أَنْوَارُ عِلْمِي يُحِيلُهَا",9,"ل",3,0],["وَما ضَرَّ أَنفاسَ الصَبا في اِحتِمالِها","سَلامَ هَوىً يُهديهِ جِسمٌ إِلى قَلبِ",10,"ب",1,0],["وَما ضاقَ عَنهُم جانِبُ العُذرِ إِنَّهُم","كَمِثلِ القَطا لَو يُترَكونَ لَناموا",11,"م",3,0],["وَما ضَرَبَت عُتبى لِذَنبٍ أَتَت بِهِ","وَلَكِنَّما وَلّادَةٌ تَشتَهي ضَربي",12,"ي",1,1],["وَما ضاعَتِ الأَرحامُ عِندَكَ وَالَّذي","وَليتَ وَما اِستُحفِظتَ فيها لِمُجرِمِ",13,"م",1,0],["وما ضرها أن قد تأخر عهدُها","إذا طال مبناها الذين تقدّمُوا",14,"م",3,0],["وما ضرَّ ذاك الغصنَ وهو مرنَّحٌ","إذا ما ثَنى نحو المتيَّمِ عِطْفَهُ",15,"ف",2,0],["وما ضرّ كانيفا اللعين لو أنه","تقحمّ في الهيجاء عسكرنا المجرا",16,"ر",2,0],["وما ضرّهم لو أسقطوا نهج سَيرهم","وساروا بمنهاج التبصُّر والحِذق",17,"ق",1,0],["وما ضَرَ بان قلبكَ غير درس","لتلقين الخصال الفاضلات",18,"ت",1,0],["وما ضرّ العفيفةَ كشفُ وجهٍ","بدا بين الأعفّاء الاُباة",18,"ه",1,0],["وما ضَرَّ البغاد إذا تدانت","أواصر من لسان وأعتقاد",19,"د",1,0],["وما ضَرَّ لو كان التعاوُن ديننا","فتَعْمُرَ بلدان وتأمنَ قطّان",20,"ن",1,0],["وما ضَرّ أن أصفَيْت وُدّك مَعشراً","من الناس لم يَجْنُوا لك الوُدّ صافيا",21,"ي",2,0],["وما ضرّني إذ عضّني مُتشادق","شَحا بفم قد كان في العضّ أدردا",22,"د",2,0],["وَما ضَرَّ جاراً يا اِبنَةَ القَومِ فَاِعلَمي","يُجاوِرُني أَلّا يَكونَ لَهُ سِترُ",23,"ر",1,0],["وَما ضَرَّني أَن سارَ سَعدٌ بِأَهلِهِ","وَأَفرَدَني في الدارِ لَيسَ مَعي أَهلي",24,"ل",2,0],["وما ضّرها إن كعباً توى","وفوّزَ من بعده جَرْولُ",25,"ل",1,0],["وما ضربت هجائن من نزار","فوالج من فحول الأعجمينا",26,"ن",2,0],["وما ضَرَبَ الأَمثَالَ في الجَورِ قَبلَنا","لأَجوَرَ من حُكَّامِنا المُتَمَثِّلُ",27,"ل",1,0],["وما ضَرَّها أن كَانَ في التُربِ ثَاوِياً","زُهَيرٌ وَأودَى ذو القُرُوحِ وَجَروَلُ",27,"ل",1,0],["وما ضَربت هجانَ بَني نزَار","فَوَالجُ من فُحُول الأَعجَمينَا",28,"ن",2,0],["وَما ضاقَت مَذاهِبُهُ وَلَكِن","يُهابُ مِنَ الحَمِيَّةِ أَن يُهابا",29,"ب",2,0],["وما ضرني دينٌ وفعلك سالمٌ","يصرّف لي زيداً وعمراً وخالدا",30,"د",2,0],["وما ضرَّها إذ كانَ نشر نسيمها","رخاء إذا ما لم يكنْ فيهِ صرصرُ",31,"ر",1,0],["وما ضرَّ ركباً كنت نجعة أهله","تعذّرُ زادٍ أو صروفُ غمام",32,"م",1,0],["وما ضرَّ المؤمِّل مطْلُ وعْدٍ","تظل له العطية في ازديادِ",33,"د",1,0],["وما ضربتْهُ الزنج في الوجه بل رأى","أيورهُمُ فانشق في وجهه حِرُ",34,"ر",1,0],["وما ضرَّ بي الأقران عند لقائهم","بذبٍّ ولا طعني هنالك بالوخض",35,"ض",1,0],["وما ضرني من نافع أن يَضُرَّني","وذاك لحبي أن يضَرَّ وتنفعا",36,"ع",2,0],["وما ضلَّ رأيٌ فيك مُذْ عرف الهدى","ولا شابَ إيماني بسُؤْددك الشكُّ",37,"ك",1,0],["وما ضرَّ من أضحى له اسمٌ مُصغَّرٌ","ومعنى مُجَلٌّ في الصدورِ معظّمُ",38,"م",1,0],["وما ضرَّها أن لم يُثِرْ خَطراتِهِ","لها شيخُ يَربوعٍ ولا شيخُ دارمِ",39,"م",1,0],["وما ضعْفُ قِرني إنْ تصدَّي لِقُوَّتي","بمنجِيهِ منّي أو ترنَّ مآتمُ",40,"م",1,0],["وما ضرَّه ألا يُبالي بعدها","ركوبي إياها بحيث يرانيا",41,"ي",2,0],["وَما ضَرَبٌ بَيضاءُ يَأوي مَليكُها","إَلى طُنُفٍ أَعيا بِراقٍ وَنازِلِ",42,"ل",1,0],["وَما ضَمِنوا أَن لا يَموتوا وَإِنَّما","يَوَدُّ زَوالَ الشَمسِ مَن كانَ أَرمَدا",43,"د",2,0],["وَما ضَرَّها أَن لا تَكونَ طَويلَةً","إِذا كانَ فيها كُلُّ ما يَطلُبُ الإِلفُ",44,"ف",1,0],["وَما ضاعَ شِعري فيكُمُ حينَ قُلتُهُ","بَلى وَأَبيكُم ضاعَ فَهوَ يَضوعُ",45,"ع",1,0],["وَما ضَرَّني أَنّي صَغيرٌ حَداثَةً","وَإِنّي بِفَضلي في الأَنامِ كَبيرُ",46,"ر",1,0],["وَما ضَرَّ بَعضَ الناسِ لَو كانَ زارَنا","وَكُنّا خَلَونا ساعَةً نَتَحَدَّثُ",47,"ث",1,0],["وَما ضاقَتِ الدُنيا عَلى ذي مُروءَةٍ","وَلا هِيَ مَسدودٌ عَلَيهِ رِحابُها",48,"ب",3,0],["وما ضرها ألا تكون فسيحة","لمن سكنوا فيها سكون الجوامد",49,"د",1,0],["وما ضرر الإنسان من طول مكثهِ","إذا كان فيه فاقد الحس واللب",50,"ب",1,0],["وَما ضِقنا بِمَقدَمِكَ المُفَدّى","وَلَكِن جِئتَ في الزَمَنِ الأَخيرِ",51,"ر",1,0],["وَما ضِعتَ بَينَ الشَرقِ وَالغَربِ مِشيَةً","كَما قيلَ في الأَمثالِ حَجلُ غُرابِ",52,"ب",1,0],["وَماضٍ بِمالٍ قَد مَضى عَنهُ وَألُهُ","وَمُزجٍ أَثاثاً بَينَ عَينَيهِ يُنهَبُ",53,"ب",1,0],["وَما ضَرَّها خَلقٌ بِغَيرِ مَخالِبٍ","وَقَد خُلِقَت أَسيافُهُ وَالقَوائِمُ",54,"م",1,0],["وما ضَرَّ جارَكَ لوْ أَنَّهُ","يَحُدُّ له الدهرُ ظُفْراً ونابْ",55,"ب",1,0],["وَما ضُمِّنَت أَرضٌ فَتَحمَلَ مِثلَهُ","وَلا خُطَّ يُنعى في بُطونِ الصَحائِفِ",56,"ف",1,0],["وَما ضَمِنَت مِثلَ اِبنِ لَيلى ضَريحَةٌ","وَما كانَ حَيٌّ وَهوَ حَيٌّ يُعادِلُه",57,"ل",2,0],["وَما ضَرَّها إِذ جاوَرَت في بِلادِها","بَني الحِصنِ ما كانَ اِختِلافُ القَبائِلِ",58,"ل",1,0],["وما ضرني وابن الصريحين والدي","إذا ابن هجين الوالدين هجاني",59,"ي",1,0],["وما ضَرَّه أن صافحَ البَظْرْ وَجْهَهُ","إذا كان مختونَ اللسانِ فَصيحا",60,"ح",2,0],["وما ضَرَّ عِقْدٌ من ثَناءٍ نظمتهُ","وفصَّلتُهُ أن لا يعيشَ له الأعشى",61,"ا",1,0],["وَما ضَرَّني بُعدُ الدِيارِ وَأَهلِها","بِأَرضي وَفَقدُ الطَرفِ ما كانَ يَلمِحُ",62,"ح",1,0],["وما ضَعضَعتني للحوادثِ نَكْبَةٌ","ولا لان في أيدي الحوادث عُنصري",63,"ر",2,0],["وما ضُويِقُوا مَن قبلِ هذا وإنّما","بقَدرِ التهابِ النّارِ تَغْليَةُ القِدرِ",64,"ر",1,0],["وما ضرّها كافورُ شيبي وتحتهُ","لمسك شبابي كلُّ فِعلٍ ورائِحه",65,"ح",2,0],["وما ضاجعَ الهنديُّ إلا مثلّماً","مُضارِبه يَومَ الوغى في الضّرائبِ",66,"ب",1,0],["وما ضاقتْ عليَّ الأرضُ إلّا","دَحَوْتُ مكانَها خُلُقاً رحابا",67,"ب",2,0],["وَما ضَميرِيَ في ذِكراكَ مُشتَرَكٌ","وَلا طَريقي إِلى جَدواكَ مُنشَعِبُ",68,"ب",1,0],["وَما ضيقُ أَقطارِ البِلادِ أَضافَني","إِلَيكَ وَلَكِن مَذهَبي فيكَ مَذهَبي",69,"ي",1,0],["وَما ضاقَ عَنُه كُلُّ شَرقٍ وَمَغرِبٍ","مِنَ الأَرضِ إِلّا ضاقَ عَن نَفسِهِ الجِلدُ",70,"د",1,0],["وماضيةٍ إلى الرحمنِ أضحتْ","أجلَّ نساءِ أهلِ العصرِ صَيْبا",71,"ب",2,1],["وَما ضَرَّهُ أَن يَستَسِرَّ لِعاتِمٍ","إِذا ما بَدا في آخِرٍ بِتَمامِ",72,"م",1,0],["وَما ضَرَّ لَو واسى وَسَلّى بِزَورَةٍ","خَلِيٌّ جَرى فيهِ القَضاءُ عَلى راسي",73,"ي",1,0],["وَما ضَرَّ أَن غابَ الأَميرُ وَخَصَّكُم","بِتابِعِهِ قَولاً وَفِعلاً وَمَحتِدا",74,"د",2,0],["وَما ضَرَّنا أَنّا قَليلٌ وَجارُنا","عَزيزٌ وَجارُ الأَكثَرينَ ذَليلُ",75,"ل",1,0],["وما ضَرَّني إِلَّا مَعارِفُ منهمُ","ذُنوبُ وِدادِي عندهمْ لا تُكَفَّرُ",76,"ر",1,0],["وما ضرّ ذا حقّ أباطلُ خصمه","إذا كانت الأقدارُ عنه تُخاصم",77,"م",1,0],["وما ضركم من حاسديكم على العلى","وأيامكم تحدو بهم وتسوق",78,"ق",1,0],["وما ضَرَّ مصراً حينَ ألقَتْ قِيادَهَا","إليكَ أمَدَّ النّيلُ أم غالَهُ جَزْر",79,"ر",1,0],["وما ضَرّ من لم يَطُفْ بالمقامِ","إذا طافَ بالجوسَقِ المُبْتَنى",80,"ا",1,0],["وَما ضَرَّها أَن لا تُعَدَّ لِجَروَلٍ","وَلا المُزَني كَعبٍ وَلا لِزِيادِ",81,"د",1,0],["وَما ضاعَ مالٌ أَورَثَ الحَمدَ أَهلَهُ","وَلَكِنَّ أَموالَ البَخيلِ تَضيعُ",82,"ع",1,0],["وَما ضَنَّ يَومٌ بِداءِ الهَوى","مُحِبّاً إِذا ما سَقاهُ الغَدُ",83,"د",1,0],["وَما ضَيَّقا أَرضي وَلَكِن أَراهُما","إِلى الضَنَكِ مِن وَجهِ البَسيطَةِ لَزّاني",84,"ي",1,0],["وَما ضَرَّ الحَمامَةَ كَسرُ ضَنكٍ","مِنَ الأَقفاصِ كانَ أَضَرَّ سِجِنِ",85,"ن",1,0],["وما ضَرَّهُ إِلا مُزَاحٌ ورِقَّةٌ","ثَنَتْهُ سفِيه الذِّكْرِ وهْو رشِيدُ",86,"د",1,0],["وَمَا ضَرَّنِي أَنِّي تَأَخَّرْتُ عَنْهُمُ","وَفَضْلِي بَيْنَ الْعَالَمِينَ شَهِيرُ",87,"ر",1,0],["وَمَا ضَاقَ صَدْرِي بِالذِينَ وَدِدْتُهُمْ","وَلاَ حَرِجَتْ بِالنَّازِلينَ رِحَابِي",88,"ب",2,0],["وَمَا ضَائِرٌ فَخْرَنَا أَنْ تُبَاحَ","وَلاَ ضَائِرُ الْجَّاهِ أَنْ تُجْتَدَى",89,"د",2,0],["وما ضرّ البنفسجَ إن توارى","حياءٌ والصدور له مقام",90,"م",1,0],["وَما ضامَهُ قَطّ الأَديبُ بِصَولَةٍ","وَلا جاءَ يَشكوهُ إِليّ رَسولُ",91,"ل",1,0],["وما ضنَّ بالدَّر ضرعُ السحاب","ولا شحَّ بطنُ الثرى بالنَّماء",92,"ا",2,0],["وما ضرَّني أن ألْبَسَ الثَّوْبَ باليا","إذا كان من عيبٍ يُدَنِّسُ خاليا؟",93,"ي",2,0],["وما ضرَّ أهلَ الحكم أنْ كان ظلُّهم","ثقيلاً على أهل النُهى والبصائر",94,"ر",1,0],["وما ضاقَ القريضُ به ستمحو","عواثِرَهُ صُدورُكم الرّحاب",95,"ب",1,0],["وما ضرهم نبوا السيوف وعندهم","عزائم من قبل السيوف قواطع",96,"ع",1,0],["وما ضرّني أسر ونفسي طليقة","مجنّحة ما كفّ من شأوها أسر",97,"ر",1,0],["وما ضقت ذرعا بالمشيب فإنّني","رأيت الضحى كالسّيف عريان أشيبا",98,"ب",2,0],["وما ضَرّ من لم يَطُفْ بالمقامِ","وفي ذي النواويسِ مْوجُ البحارِ",99,"ا",2,0],["وَما ضَربتَه فَخُذ مَنازلَه","تَعرِف بذَاك الأخذ أُسّاً لِحَاصِلِه",100,"ه",1,0],["وما ضره خدش اللئام لقدره","اذا كان في نفس الكرام له قدر",101,"ر",1,0],["وما ضرني اني من المال فارغ","ولي من جناب الله عز ومظهر",102,"ر",1,0],["وما ضرني نبح الكلاب وانني","لبدر ولم يلصق برمل كثيب",103,"ب",1,0],["وما ضرني أن الفويسق سبني","بشيء نفاه الله والخلقُ عنيا",104,"ي",2,0],["وما ضرَّ من كان الإمامُ سحابَهُ","تقاعُدُ لَمَّاعِ البوارق رجَّاسِ",105,"س",1,0],["وَما ضَرَّ مَن فاقَ المُلوكَ بِرَأيِهِ","وَإِقدامِهِ أَلّا يَكونَ لَهُ عَمرُو",106,"ر",2,0],["وما ضر لو حملتموها رسالة","إلي وهل مثل النسيم رسول",107,"ل",1,0],["وما ضرها أن السحائب أقبلت","وأنملة فيها تسح وتهمل",108,"ل",1,0],["وما ضيعت يجبره التلافي","إذا استدركت ما فيه وعدتا",109,"ت",2,0],["وَما ضَرَّني مَع قُربِهِ أَنَّ مَنزِلي","وَقَومي بِأَكنافِ المُشَقَّرِ وَالصَفا",110,"ف",2,0],["وما ضَرَّ بدرَ الدُّجى نابحٌ","عَوى وله في العَلاء اتِّساق",111,"ق",1,0],["وما ضرّني عيب برجلي يشينها","إذا صحّ تمييزي وكرّمني عقلي",112,"ي",1,0],["وما ضرّ كاسي وجهه زعفرانة","إذا سلمت أعضاؤه ومفاضله",113,"ل",2,0],["وما ضرّني سلمى ورفقي بمعشر","لساني لهم سلم وقلبي لهم حرب",114,"ب",1,0],["وَما ضَمَّ شَملَ الأُنسِ يَوماً كَنَرجِسٍ","يَقومُ بَعُذرِ اللَهوِ مِن خالِعِ العُذرِ",115,"ر",1,1],["وَما ضَرَبوا أَوتادَهُم بِحِمايَةٍ","فَيَسطيعُ قَومٌ كاشِحونَ لَها نَزعا",116,"ع",2,0],["وما ضائري أنْ يستعيروا شهادةً","لبعضهم إن النفاقَ قديمُ",117,"م",1,0],["وما ضرَّهُ لو جادَ لي بلُعَيْقةٍ","أبلُّ بها ريقي عن العُمر ينجزُ",118,"ز",1,0],["وماضي العمر والآجل","وليلاتي وأيامي",119,"ي",1,0],["وَماضي شَبابِ الفَتى لا يُرَدُّ","وَذاهِبُ عَيشِ الصِبى غَيرُ عائِد",120,"د",1,0],["وَماضي صِباً قَضَّيتُ مِنهُ لُبانَتي","خِلاساً وَعينُ الدَهرِ زَرقاءُ تَلمَحُ",121,"ح",1,0],["وما ضربوا إلا بيمناك مضرباً","وما سعدوا إلا وسعدك يغلب",122,"ب",1,0],["وما ضرّني هذا وإن لام لائمي","فوجدي به ينمو على رغم عُذّلي",123,"ل",2,0],["وما ضرّني واشي الغرام بعذله","وإن كان لسع العذل كالحيّة الرقطا",124,"ط",2,0],["وما ضمنه إلا التفرق غصة","وليست بحلقومي ولكن في حسي",125,"ي",1,0],["وَمَا ضَرَّهُ واللهُ يغفِرُ ذَنبَهُ","لَوَ انّ ذُنوبَ العَالَمينَ على ظَهرِي",126,"ي",1,0],["وَما ضقت ذرعا دون ادراك مطلب","وَفي الرد من لم يخش سائله الردا",127,"د",2,0],["وَما ضَرَّني أَنِّي مَرِيضٌ وَمُدْنَفٌ","إِذا أَنا لَمْ أمْرَضْ فُؤاداً وَلا ذِهْنا",128,"ن",2,0],["وَما ضَرّها أنّي يَمانٍ وأنّها","لِقَيْسٍ ألسْنا في تعارُفِنا عُرْبا",129,"ب",2,0],["وَما ضَيغَمٌ دونَ أَشبالِهِ","يُحامي فَيَفتَحُ باعاً وَشِدقا",130,"ق",2,0],["وَما ضَرَبٌ في رَأسِ صَعبٍ مُمَرَّدٍ","بِتَيهانَةٍ يَستَترِكُ العُفرَ نيقُها",131,"ق",3,0],["وَما ضَرَّهم لو لُفَّ شَملي بشَملها","وَقَد لَفَّت الأَعراقَ ما بيننا فِهرُ",132,"ر",1,0],["وَما ضمّها ضيمٌ وَلَكن سياسةٌ","أَرتنا مُحيّا العدلِ بالفدعَةِ اِغبرّا",133,"ر",2,0],["وَماضَرَّني مَا يَقولُ العَدُوُّ","إذا رَدَّ غَيْبَتَي الصَّاحِبُ",134,"ب",1,0],["وَمَا ضَرَّهُ شَنٌّ صَغِيرٌ وَقَد سَرَى","إلى بَابِهِ مِن كُلِّ قَطْرٍ كَبيرُهُ",135,"ه",1,1],["وَما ضَرَري بِكَسرِ الجِسمِ فيها","وَقَلبي في المُقامِ بِها صَحيحُ",136,"ح",1,0],["وَما ضاقَ ذَرعي بِالمَلامَةِ مِنهُم","وَأَوسَعُ شَيءٍ فيكَ لِلعُذرِ مَسلَكي",137,"ي",1,0],["وَما ضَرّ نَفسك ياقوتها","بِنار التَجلُّد لَم يحرقِ",138,"ق",1,0],["وما ضَرَّني أن لا أَرى لي مُعاهِدا","إِذا هِيَ قالَت نَحنُ مِنكَ عَلى العَهدِ",139,"د",1,0],["وَما ضَرَّني شَىء سِوى قَول عاذِلي","وَان لَم يَفد هذا هَواهُ تكلف",140,"ف",1,0],["وما ضَرَّ صحبي سنا بارقٍ","إذا ضَنَّ ما دام عَينَي تَجود",141,"د",1,0],["وماضٍ منَ الأيّامِ أمَّا ادِّكارُهُ","فدانٍ وأمّا عهْدُه فَبعيد",142,"د",1,0],["وَما ضَرَّني أَن بالَ في البَحرِ بائِلٌ","وَلا ساءَني أَن ناطَحَ الصَخرَ ناطِحُ",143,"ح",1,0],["وَما ضَربُ زَيدِ الدَهرِ عَمراً لِريبَةٍ","مَتى يُحسِنُ التَأديبَ غَيرُ مُؤَدَّبِ",144,"ب",1,0],["وماضٍ بماضٍ بَينَ جَفنيهِ غالب","عَلى كُلِّ أرضٍ أو يطيع مطاعُها",145,"ع",3,0],["وما ضرنا منه سوى أن كيده","يُذيع مزايانا وهُوَّ خَذيل",146,"ل",1,0],["وما ضعف داء الطبع فينا ونقصه","وما هو شفا كلٍّ من النقص والضعف",147,"ف",1,0],["وما ضر نعماها إذا كنت جاحداً","وهل يَهجُنُ الآلاءَ يوماً كَفورها",148,"ر",3,0],["وما ضرّني أَنْ لاَ تَرونَ فَضَائِلي","فما خَفِيتْ إلاَّ عَلى أَعْينٍ رُمدِ",149,"د",1,1],["وما ضرَني أن لا يرون فضائلي","فما خَفِيتْ إلاّ على أَعْينِ رُمْدِ",150,"د",1,0],["وما ضَعضَعَتْنِي الحادثاتُ وإنّني","كَعهدِكَ وعْرُ الخُلقِ في الخطبِ وَعْثُهُ",151,"ث",2,0],["وما ضَرَّة لو كانَ أنْجَزَ وَعْدَه","وكنتُ به لو زارني أتشَرّف",152,"ف",1,0],["وما ضرَّني فقدي به ثروة الغنى","فلا الفضل منحطٌّ ولا النقص صاعد",153,"د",1,0],["وما ضاهاك من قاصٍ ودانٍ","بعدل الحكم أو فصل الخطاب",154,"ب",1,0],["وما ضلَّ ساري اللَّيل إلاَّ اهتدى بها","كنور سنا الإِسلام في ظلمة الكفر",155,"ر",1,0],["وما ضر هذا الخلق والقصد واحد","إذا نحن أخلصنا إليها توجهنا",156,"ن",2,0],["وماضي شباب مستعار بكيتهُ","بدمع على عصر الشبيبة مغدق",157,"ق",1,0],["وما ضم عطفيها الحسان موفقاً","إلى رحمة الرحمن غير أريب",158,"ب",1,0],["وما ضرني ان خضب الشيب مفرقي","ولي من فؤادي في الغرام مشايع",159,"ع",1,0],["وما ضرَّني منهم نحولُ مطالبي","لديهم وحظّي من نداك سمينُ",160,"ن",1,0],["وما ضرّ ساري ليلةٍ لو تناثرت","كواكبُها ما امتدَّ للقمر البقا",161,"ق",2,0],["وما ضرَّهم أنهُم يعدَمو","ن غيثاً وقد وجَدُوا منك أثرى",162,"ر",2,0],["وما ضرَّ في غير الكُفاةِ ارتخاصُها","إذا ما غلَت عند ابن عيسى مهورُها",163,"ر",3,0],["وماضي عُصور الناس قيْظٌ وانما","زمانُ الوزير الزَّيْنبي ربيعُها",164,"ه",2,0],["وما ضربت للناس امثاله سدى","ولكن لعل الناس أن تتفكّرا",165,"ر",2,0],["وما ضحكتْ ثغورُ الرّوض حتى","بكتْ من اجلها الدّميمُ الغزار",166,"ر",1,0],["وما ضاع مالٌ اكسب المرَْ هلكهُ","خلودَ ثناءٍ أو أفيد به أجر",167,"ر",1,0],["وما ضر ضرب السير لو كان ماشياً","على مهله لما سقاني بمهلهِ",168,"ل",2,0],["وما ضر محفوظ الوداد جحودها","علانية كيما يزال به الخطب",169,"ب",1,0],["وما ضر أهل الشعر أن لو أحالوهم","على الدهر لكن أرجو طبا مداويا",170,"ي",2,0],["وماضي سِقامي يا لَعَمْرِي مُضارِعٌ","بأَمرٍ روى عن مبدئي خَبَرَ الحَالِ",171,"ل",1,0],["وما ضرَّ الهِلالَ وقد تجَلَّى","إذا ما سامَهُ المنكودُ غَمْزا",172,"ز",2,0],["وما ضرّها لو أنّها في عبيدِه","منَ الخَلقِ يُفْدى ذلكَ السيّدُ الحُرُّ",173,"ر",1,0],["وما ضم هذا الشمل وهو كم ترى","وتسمعه إلا الأجل المؤيد",174,"د",1,0],["وما ضرهم أن بات قلبك بارداً","ولفظك نار جمرها يتضرم",175,"م",1,0],["وَما ضَرَّ أَثوابي سَوادي وَإِنَّني","لكا لمسك لا يَسلو عَن المِسكِ ذائِقه",176,"ق",2,0],["وما ضرَّ صومٌ لو عنِ الأكلِ وحدَهُ","ولكنَّه صومٌ يُمِضُّ أخا الشِّعرِ",177,"ر",1,0],["وما ضرَّهُ لو أنه قد أجابَنِي","بِوجهٍ بشُوشٍ ذي اعتذارٍ على قَصدي",178,"د",2,0],["ومَا ضرَّهُم أخزاهُمُ اللهُ أننِي","لِسَانيَ سبَّاقٌ وعِرضُهُمُ رَحبُ",179,"ب",1,0],["وما ضرّني لمّا شَرِبتُك أنّني","غَرَفتُ فلم أشربْ كؤوس مُدامِ",180,"م",1,0],["وَما ضلّ عَن مأثُراتٍ أَقمت","عَلى الناسِ في النّاس غير النيامِ",181,"م",1,0],["وما ضرّ مسلوبَ العزيمةِ إنْ وَنى","عن السَّعىِ والأرزاقُ حِرْصاً تؤُمُّهُ",182,"م",2,0],["وماضٍ على الشّحناء في غير زلّةٍ","وَقَد ملّ إلّا مِن عتابك جُرمُهُ",182,"م",2,0],["وما ضرّ من أدعوه أوفى أصادِقي","إذا لم يكن من معشري وقبائلي",183,"ل",2,0],["وما ضرّ أنْ فاتني آجلاً","وقد مسّني النّفعُ في العاجلِ",184,"ل",1,0],["وما ضرّهمْ لمّا أرادوا ترحُّلاً","عن الجِزْع لو داوَوْا هناك عليلا",185,"ل",2,0],["وما ضرّني الإمْلاقُ والثّروةُ الّتي","يذلّ بها أهلُ اليَسارِ ضَلالُ",186,"ل",1,1],["وما ضرّني منها وقد بتّ راضياً","بباطلها أنْ بان صُبحاً بُطولُها",187,"ل",3,0],["وما ضَلّ وَجهُ الرّأي عنه وإنّما","تقاضاه من وجه الظُّنونِ الصّوادِقِ",188,"ق",1,0],["وما ضرّ والسِّربالُ باقٍ على الفتى","إذا شعَّثَثْ منه اللّيالِي البنائقا",189,"ق",2,0],["وما ضرَّني أنّي قُذفتُ بباطلٍ","وما زلتُ عُمْرَ الدهرِ بالحقّ أصدَعُ",190,"ع",1,0],["وَما ضرّ من فارقتُ من كلّ نازحٍ","وقد لفّ لي شملاً بشملك جامعُ",191,"ع",1,0],["وما ضرّنِي والنّومُ ليس يزورنِي","دجىً وضحىً أنِّي بغير وِسادِ",192,"د",1,0],["وَما ضَرّ قَولُ الكاشِحينَ وإنّما","كلامُ الأعادي للمعالِي مَقالِدُ",193,"د",1,0],["وما ضرّني أنِّي خَليٌّ منَ الغِنى","وَوَفْرُ العُلا عندِي طريفٌ وتالِدُ",193,"د",1,0],["وما ضرّنا أنّا خَلِيّون من غِنىً","وكم شِبَعٍ يهفو بهِ غَرْثُ غارثِ",194,"ث",1,0],["وما ضرّني والعهدُ غيرُ مُبدَّلٍ","تبدُّلُ شَرْخِي ظَالماً بمشيبي",195,"ي",1,0],["وما ضرّ من كان القريبَ مودّة","مقرّبةً أنْ لم يكن من أقاربي",196,"ب",2,0],["وما ضرّ والقربُ المؤلّفُ بيننا","ودادٌ لنا أنْ لم تكنْ من أقاربِي",197,"ي",1,0],["وَما ضَمِنتُ لَها سِرّاً فَأَكتُمَهُ","إِلّا حَفَظتُ عَلَيهِ الدَمعَ وَالبَصَرا",198,"ر",2,0],["وَما ضَرَعَت لِلدَهرِ مِنكَ سَجِيَّةٌ","وَإِن طَرَقَت بِالمُفظِعاتِ بَلابِلُه",199,"ل",2,0],["وَما ضَرَّ أَوصالَ المُحِبِّ مُقَوَّتاً","رَجاءَ وِصالِ الحِبِّ اِسناتُها عَجفا",200,"ف",2,0],["وَما ضَمير يَصِلونَ لِآخِرِهِ","يَعصِهِما في الحَديثِ بَينَ ما ذُكِرا",201,"ر",2,0],["وما ضرني أني مقيم ببلدة","بها كل ذي فضل مهان مضيع",202,"ع",1,0],["وما ضل من سماك رأياً محمداً","علي المعالي أو هدته العلائم",203,"م",1,0]]}