{"poems":[[53,"جناني شجاع إن مدحت وإنما","https://www.aldiwan.net/poem29646.html","الطويل"],[53,"قليل من الخلان من لا تذمه","https://www.aldiwan.net/poem29759.html","الطويل"],[53,"وقد تركت صوارمهم بحجر","https://www.aldiwan.net/poem29831.html","الوافر"],[53,"أراقب من طيف الحبيب وصالا","https://www.aldiwan.net/poem29899.html","الطويل"],[53,"ردي يا جيادي وأذني برحيل","https://www.aldiwan.net/poem29903.html","الطويل"],[53,"وفى بمواعيد الخليط وأخلفوا","https://www.aldiwan.net/poem29968.html","الطويل"],[53,"وذي نضد لا يقطع الطرف عرضه","https://www.aldiwan.net/poem30440.html","الطويل"],[63,"لحاني هذيم صاحبي ليلة النقا","https://www.aldiwan.net/poem45812.html","الطويل"],[63,"وما ضرهم غب الأحاديث أنها","https://www.aldiwan.net/poem45844.html","الطويل"],[77,"أخي فترة السلوان جاء رسولها","https://www.aldiwan.net/poem36371.html","الطويل"],[73,"غريب بأقصى الشرق يشكر للصبا","https://www.aldiwan.net/poem11839.html","الطويل"],[73,"سل المعشر الأعداء إن رمت صرفهم","https://www.aldiwan.net/poem11951.html","الطويل"],[73,"وما ضربت عتبى لذنب أتت به","https://www.aldiwan.net/poem11991.html","الطويل"],[10,"أمن ذكر صخر دمع عينك يسجم","https://www.aldiwan.net/poem21138.html","الطويل"],[83,"هناء له ثغر الهدى يتبسم","https://www.aldiwan.net/poem54244.html","الطويل"],[83,"يقر بعيني أن أرى الزهر يانعا","https://www.aldiwan.net/poem54271.html","الطويل"],[88,"هو النصر معقود برايتنا الحمرا","https://www.aldiwan.net/poem44470.html","الطويل"],[88,"شكاية قلب بالأسى نابض العرق","https://www.aldiwan.net/poem44834.html","الطويل"],[88,"هي الأخلاق تنبت كالنبات","https://www.aldiwan.net/poem44970.html","الوافر"],[88,"أ تونس أن في بغداد قوما","https://www.aldiwan.net/poem44988.html","الوافر"],[88,"أما آن أن تنسى من القوم أضغان","https://www.aldiwan.net/poem44992.html","الطويل"],[88,"علام حرمنا منذ حين تلاقيا","https://www.aldiwan.net/poem44994.html","الطويل"],[88,"تريد لي الأيام أن أتقيد","https://www.aldiwan.net/poem45016.html","الطويل"],[11,"أماوي قد طال التجنب والهجر","https://www.aldiwan.net/poem245.html",""],[11,"وإني لعف الفقر مشترك الغنى","https://www.aldiwan.net/poem264.html",""],[37,"فدونك مقربة لا تساط","https://www.aldiwan.net/poem7346.html","المتقارب"],[37,"الا حييت عنا يا مدينا","https://www.aldiwan.net/poem7642.html","الوافر"],[37,"ألا هل عم في رأيه متأمل","https://www.aldiwan.net/poem7652.html","الطويل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[47,"أبت عبراته إلا انسكابا","https://www.aldiwan.net/poem25381.html","الوافر"],[72,"تداينت من عمرو فلما صرفته","https://www.aldiwan.net/poem18645.html","الطويل"],[72,"صحا القلب لولا نسمة تتخطر","https://www.aldiwan.net/poem18693.html","الطويل"],[72,"قدوم كما حيى قدوم غمام","https://www.aldiwan.net/poem19683.html","الطويل"],[51,"أقول لسائلي بك يا ابن يحيى","https://www.aldiwan.net/poem61900.html","الوافر"],[51,"بوجه أبي إسحاق صدع كطيزه","https://www.aldiwan.net/poem64015.html","الطويل"],[51,"أسوغ لخلاني مساغ شرابهم","https://www.aldiwan.net/poem64944.html","الطويل"],[51,"أتتني عنك المؤيسات فلم ألم","https://www.aldiwan.net/poem65059.html","الطويل"],[51,"لك الخير إني أستزيد ولا أشكو","https://www.aldiwan.net/poem65797.html","الطويل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[51,"وليس حراما شتم من كان مفحما","https://www.aldiwan.net/poem66352.html","الطويل"],[51,"أرى ابن حريث لا يبالي عضيهتي","https://www.aldiwan.net/poem66736.html","الطويل"],[26,"أساءلت رسم الدار أم لم تسائل","https://www.aldiwan.net/poem24083.html","الطويل"],[91,"مرضت فأرواح الصحاب كئيبة","https://www.aldiwan.net/poem8812.html","عموديه"],[70,"تعشقتها مثل الغزال الذي رنا","https://www.aldiwan.net/poem42811.html","الطويل"],[70,"أما آن للبدر المنير طلوع","https://www.aldiwan.net/poem42827.html","الطويل"],[70,"وعاذلة باتت تلوم على الهوى","https://www.aldiwan.net/poem42924.html","الطويل"],[70,"يعاهدني لا خانني ثم ينكث","https://www.aldiwan.net/poem42986.html","الطويل"],[70,"إلى كم مقامي في بلاد معاشر","https://www.aldiwan.net/poem43029.html","الطويل"],[89,"لقد كان سعد خير قوم مجاهد","https://www.aldiwan.net/poem44614.html","الطويل"],[89,"كتاب رثاء يحمل البث من قلبي","https://www.aldiwan.net/poem44958.html","الطويل"],[85,"علي لو استشرت أباك قبلاً","https://www.aldiwan.net/poem8070.html","الوافر"],[85,"سماؤك يا دنيا خداع سراب","https://www.aldiwan.net/poem62924.html","الطويل"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[43,"على قدر أهل العزم تأتي العزائم","https://www.aldiwan.net/poem10524.html","الطويل"],[62,"لمثل معاليك تعنو الرقاب","https://www.aldiwan.net/poem52473.html","المتقارب"],[28,"ليبك على الحجاج من كان باكيا","https://www.aldiwan.net/poem5316.html","الطويل"],[28,"لها صاحبا فقر عليها وصادع","https://www.aldiwan.net/poem5391.html","الطويل"],[28,"تبغت جوارا في معد فلم تجد","https://www.aldiwan.net/poem5408.html","الطويل"],[61,"تغير إخوان الصفاء فكلهم","https://www.aldiwan.net/poem51320.html","الطويل"],[61,"سأحتج للملحي أقوم حجة","https://www.aldiwan.net/poem51743.html","الطويل"],[61,"رويدك عن تفنيد ذي المقلة العبرى","https://www.aldiwan.net/poem51837.html","الطويل"],[66,"صفاح عيون لحظها ليس يصفح","https://www.aldiwan.net/poem40986.html","الطويل"],[80,"تظن مزار البدر عنها يعزني","https://www.aldiwan.net/poem31231.html","الطويل"],[80,"كفى سيفك الإسلام عادية الكفر","https://www.aldiwan.net/poem31440.html","الطويل"],[80,"تقول وقد لاحت لها في مفارقي","https://www.aldiwan.net/poem31523.html","الطويل"],[80,"تدرعت صبري جنة للنوائب","https://www.aldiwan.net/poem31551.html","الطويل"],[80,"ألا كم تسمع الزمن العتابا","https://www.aldiwan.net/poem31566.html","الوافر"],[44,"قد نابت الجزع من أروية النوب","https://www.aldiwan.net/poem30576.html","البسيط"],[44,"تقي جمحاتي لست طوع مؤنبي","https://www.aldiwan.net/poem30583.html","الطويل"],[44,"لأي حبيب يحسن الرأي والود","https://www.aldiwan.net/poem30617.html","الطويل"],[69,"وماضية إلى الرحمن أضحت","https://www.aldiwan.net/poem29260.html","الوافر"],[74,"أفي ما تؤدي الريح عرف سلام","https://www.aldiwan.net/poem13260.html","الطويل"],[81,"أضاع وقاري من علقت جماله","https://www.aldiwan.net/poem61447.html","الطويل"],[81,"أصيخوا فمن طور الهدى انبعث الندا","https://www.aldiwan.net/poem61537.html","الطويل"],[17,"إذا المرء لم يدنس من اللؤم عرضه","https://www.aldiwan.net/poem1201.html",""],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[75,"صغائر افعال الملوك عظائم","https://www.aldiwan.net/poem69021.html","الطويل"],[75,"ألا أيها الوادي المقدس بالندى","https://www.aldiwan.net/poem69025.html","البسيط"],[75,"تقول بنو العباس هل فتحت مصر","https://www.aldiwan.net/poem69083.html","الطويل"],[75,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[48,"أربع البلى إن الخشوع لباد","https://www.aldiwan.net/poem62604.html","الطويل"],[50,"أأبكاك داع في الصباح سميع","https://www.aldiwan.net/poem62338.html","السريع"],[50,"ألا طرقت موهنا مهدد","https://www.aldiwan.net/poem63884.html","الوافر"],[46,"أيأتي نبي يجعل الخمر طلقة","https://www.aldiwan.net/poem23498.html","الطويل"],[46,"إذا هاجت أخا أسف ديار","https://www.aldiwan.net/poem23526.html","الوافر"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30450","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42602","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54631","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54733","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141994","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43741","الطويل"],[106,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[106,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[90,"يافا الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179202",""],[90,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[75,"ألا كلُّ آتٍ قريبُ المَدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10783&r=&rc=3",""]],"verses":[["وَما ضَرَّ قَوّالاً أَطاعَ جَنانَهُ","عِندَ إِذا خانَهُ المُلوكِ لِسانُ",0,"ن",1,0],["وَما ضاقَتِ الأَقطارُ مِن دونِ فَوتِهِ","ظُبانا وَلَكِن أوبَقَ العَبدَ ظُلمُهُ",1,"م",2,0],["وَما ضَلَّت ضَلالَهُمُ بِحِجرٍ","سَقيطَةُ جَندَلٍ بَينَ الرِجالِ",2,"ل",1,0],["وَما ضَرَّ مَن أَمسى زِمامي بِكَفِّهِ","عَلى النَأيِ لَو أَرخى لَنا وَأَطالا",3,"ل",2,0],["وَما ضَرَّهُ لَو كانَ كُلُّ قَبيلَةٍ","تُطالِبُهُ يَومَ الوَغى بِدُخولِ",4,"ل",1,0],["وَما ضَرَّهُم أَن لَم يَجودوا بِمُقنِعٍ","مِنَ النَيلِ إِذ مَنَّوا قَليلاً وَسَوَّفوا",5,"ف",3,0],["وَما ضَرَّ قَلبي إِذ غَدا مِنكَ آهِلاً","تَأَمُّلُ عَيني مَنزِلاً مِنكَ مُقفِرا",6,"ر",2,0],["وَما ضَرَّهُ أَنِّي تَبَصَّرتُ هَل أَرى","وَميضاً يُريني وَجهَ أُمِّ أَبانِ",7,"ن",1,0],["وَما ضَرَّهُم غِبَّ الأَحاديثِ أَنَّها","سَتَبقى وَأَيَّامُ الحَياةِ قَلائِلُ",8,"ل",1,1],["وَمَا ضَرَّنِي أَنِّي ثَوَيْتُ بِمَغْربٍ","إِذَا طَلَعَتْ أَنْوَارُ عِلْمِي يُحِيلُهَا",9,"ل",3,0],["وَما ضَرَّ أَنفاسَ الصَبا في اِحتِمالِها","سَلامَ هَوىً يُهديهِ جِسمٌ إِلى قَلبِ",10,"ب",1,0],["وَما ضاقَ عَنهُم جانِبُ العُذرِ إِنَّهُم","كَمِثلِ القَطا لَو يُترَكونَ لَناموا",11,"م",3,0],["وَما ضَرَبَت عُتبى لِذَنبٍ أَتَت بِهِ","وَلَكِنَّما وَلّادَةٌ تَشتَهي ضَربي",12,"ي",1,1],["وَما ضاعَتِ الأَرحامُ عِندَكَ وَالَّذي","وَليتَ وَما اِستُحفِظتَ فيها لِمُجرِمِ",13,"م",1,0],["وما ضرها أن قد تأخر عهدُها","إذا طال مبناها الذين تقدّمُوا",14,"م",3,0],["وما ضرَّ ذاك الغصنَ وهو مرنَّحٌ","إذا ما ثَنى نحو المتيَّمِ عِطْفَهُ",15,"ف",2,0],["وما ضرّ كانيفا اللعين لو أنه","تقحمّ في الهيجاء عسكرنا المجرا",16,"ر",2,0],["وما ضرّهم لو أسقطوا نهج سَيرهم","وساروا بمنهاج التبصُّر والحِذق",17,"ق",1,0],["وما ضَرَ بان قلبكَ غير درس","لتلقين الخصال الفاضلات",18,"ت",1,0],["وما ضرّ العفيفةَ كشفُ وجهٍ","بدا بين الأعفّاء الاُباة",18,"ه",1,0],["وما ضَرَّ البغاد إذا تدانت","أواصر من لسان وأعتقاد",19,"د",1,0],["وما ضَرَّ لو كان التعاوُن ديننا","فتَعْمُرَ بلدان وتأمنَ قطّان",20,"ن",1,0],["وما ضَرّ أن أصفَيْت وُدّك مَعشراً","من الناس لم يَجْنُوا لك الوُدّ صافيا",21,"ي",2,0],["وما ضرّني إذ عضّني مُتشادق","شَحا بفم قد كان في العضّ أدردا",22,"د",2,0],["وَما ضَرَّ جاراً يا اِبنَةَ القَومِ فَاِعلَمي","يُجاوِرُني أَلّا يَكونَ لَهُ سِترُ",23,"ر",1,0],["وَما ضَرَّني أَن سارَ سَعدٌ بِأَهلِهِ","وَأَفرَدَني في الدارِ لَيسَ مَعي أَهلي",24,"ل",2,0],["وما ضّرها إن كعباً توى","وفوّزَ من بعده جَرْولُ",25,"ل",1,0],["وما ضربت هجائن من نزار","فوالج من فحول الأعجمينا",26,"ن",2,0],["وما ضَرَبَ الأَمثَالَ في الجَورِ قَبلَنا","لأَجوَرَ من حُكَّامِنا المُتَمَثِّلُ",27,"ل",1,0],["وما ضَرَّها أن كَانَ في التُربِ ثَاوِياً","زُهَيرٌ وَأودَى ذو القُرُوحِ وَجَروَلُ",27,"ل",1,0],["وما ضَربت هجانَ بَني نزَار","فَوَالجُ من فُحُول الأَعجَمينَا",28,"ن",2,0],["وَما ضاقَت مَذاهِبُهُ وَلَكِن","يُهابُ مِنَ الحَمِيَّةِ أَن يُهابا",29,"ب",2,0],["وما ضرني دينٌ وفعلك سالمٌ","يصرّف لي زيداً وعمراً وخالدا",30,"د",2,0],["وما ضرَّها إذ كانَ نشر نسيمها","رخاء إذا ما لم يكنْ فيهِ صرصرُ",31,"ر",1,0],["وما ضرَّ ركباً كنت نجعة أهله","تعذّرُ زادٍ أو صروفُ غمام",32,"م",1,0],["وما ضرَّ المؤمِّل مطْلُ وعْدٍ","تظل له العطية في ازديادِ",33,"د",1,0],["وما ضربتْهُ الزنج في الوجه بل رأى","أيورهُمُ فانشق في وجهه حِرُ",34,"ر",1,0],["وما ضرَّ بي الأقران عند لقائهم","بذبٍّ ولا طعني هنالك بالوخض",35,"ض",1,0],["وما ضرني من نافع أن يَضُرَّني","وذاك لحبي أن يضَرَّ وتنفعا",36,"ع",2,0],["وما ضلَّ رأيٌ فيك مُذْ عرف الهدى","ولا شابَ إيماني بسُؤْددك الشكُّ",37,"ك",1,0],["وما ضرَّ من أضحى له اسمٌ مُصغَّرٌ","ومعنى مُجَلٌّ في الصدورِ معظّمُ",38,"م",1,0],["وما ضرَّها أن لم يُثِرْ خَطراتِهِ","لها شيخُ يَربوعٍ ولا شيخُ دارمِ",39,"م",1,0],["وما ضعْفُ قِرني إنْ تصدَّي لِقُوَّتي","بمنجِيهِ منّي أو ترنَّ مآتمُ",40,"م",1,0],["وما ضرَّه ألا يُبالي بعدها","ركوبي إياها بحيث يرانيا",41,"ي",2,0],["وَما ضَرَبٌ بَيضاءُ يَأوي مَليكُها","إَلى طُنُفٍ أَعيا بِراقٍ وَنازِلِ",42,"ل",1,0],["وَما ضَمِنوا أَن لا يَموتوا وَإِنَّما","يَوَدُّ زَوالَ الشَمسِ مَن كانَ أَرمَدا",43,"د",2,0],["وَما ضَرَّها أَن لا تَكونَ طَويلَةً","إِذا كانَ فيها كُلُّ ما يَطلُبُ الإِلفُ",44,"ف",1,0],["وَما ضاعَ شِعري فيكُمُ حينَ قُلتُهُ","بَلى وَأَبيكُم ضاعَ فَهوَ يَضوعُ",45,"ع",1,0],["وَما ضَرَّني أَنّي صَغيرٌ حَداثَةً","وَإِنّي بِفَضلي في الأَنامِ كَبيرُ",46,"ر",1,0],["وَما ضَرَّ بَعضَ الناسِ لَو كانَ زارَنا","وَكُنّا خَلَونا ساعَةً نَتَحَدَّثُ",47,"ث",1,0],["وَما ضاقَتِ الدُنيا عَلى ذي مُروءَةٍ","وَلا هِيَ مَسدودٌ عَلَيهِ رِحابُها",48,"ب",3,0],["وما ضرها ألا تكون فسيحة","لمن سكنوا فيها سكون الجوامد",49,"د",1,0],["وما ضرر الإنسان من طول مكثهِ","إذا كان فيه فاقد الحس واللب",50,"ب",1,0],["وَما ضِقنا بِمَقدَمِكَ المُفَدّى","وَلَكِن جِئتَ في الزَمَنِ الأَخيرِ",51,"ر",1,0],["وَما ضِعتَ بَينَ الشَرقِ وَالغَربِ مِشيَةً","كَما قيلَ في الأَمثالِ حَجلُ غُرابِ",52,"ب",1,0],["وَماضٍ بِمالٍ قَد مَضى عَنهُ وَألُهُ","وَمُزجٍ أَثاثاً بَينَ عَينَيهِ يُنهَبُ",53,"ب",1,0],["وَما ضَرَّها خَلقٌ بِغَيرِ مَخالِبٍ","وَقَد خُلِقَت أَسيافُهُ وَالقَوائِمُ",54,"م",1,0],["وما ضَرَّ جارَكَ لوْ أَنَّهُ","يَحُدُّ له الدهرُ ظُفْراً ونابْ",55,"ب",1,0],["وَما ضُمِّنَت أَرضٌ فَتَحمَلَ مِثلَهُ","وَلا خُطَّ يُنعى في بُطونِ الصَحائِفِ",56,"ف",1,0],["وَما ضَمِنَت مِثلَ اِبنِ لَيلى ضَريحَةٌ","وَما كانَ حَيٌّ وَهوَ حَيٌّ يُعادِلُه",57,"ل",2,0],["وَما ضَرَّها إِذ جاوَرَت في بِلادِها","بَني الحِصنِ ما كانَ اِختِلافُ القَبائِلِ",58,"ل",1,0],["وما ضرني وابن الصريحين والدي","إذا ابن هجين الوالدين هجاني",59,"ي",1,0],["وما ضَرَّه أن صافحَ البَظْرْ وَجْهَهُ","إذا كان مختونَ اللسانِ فَصيحا",60,"ح",2,0],["وما ضَرَّ عِقْدٌ من ثَناءٍ نظمتهُ","وفصَّلتُهُ أن لا يعيشَ له الأعشى",61,"ا",1,0],["وَما ضَرَّني بُعدُ الدِيارِ وَأَهلِها","بِأَرضي وَفَقدُ الطَرفِ ما كانَ يَلمِحُ",62,"ح",1,0],["وما ضَعضَعتني للحوادثِ نَكْبَةٌ","ولا لان في أيدي الحوادث عُنصري",63,"ر",2,0],["وما ضُويِقُوا مَن قبلِ هذا وإنّما","بقَدرِ التهابِ النّارِ تَغْليَةُ القِدرِ",64,"ر",1,0],["وما ضرّها كافورُ شيبي وتحتهُ","لمسك شبابي كلُّ فِعلٍ ورائِحه",65,"ح",2,0],["وما ضاجعَ الهنديُّ إلا مثلّماً","مُضارِبه يَومَ الوغى في الضّرائبِ",66,"ب",1,0],["وما ضاقتْ عليَّ الأرضُ إلّا","دَحَوْتُ مكانَها خُلُقاً رحابا",67,"ب",2,0],["وَما ضَميرِيَ في ذِكراكَ مُشتَرَكٌ","وَلا طَريقي إِلى جَدواكَ مُنشَعِبُ",68,"ب",1,0],["وَما ضيقُ أَقطارِ البِلادِ أَضافَني","إِلَيكَ وَلَكِن مَذهَبي فيكَ مَذهَبي",69,"ي",1,0],["وَما ضاقَ عَنُه كُلُّ شَرقٍ وَمَغرِبٍ","مِنَ الأَرضِ إِلّا ضاقَ عَن نَفسِهِ الجِلدُ",70,"د",1,0],["وماضيةٍ إلى الرحمنِ أضحتْ","أجلَّ نساءِ أهلِ العصرِ صَيْبا",71,"ب",2,1],["وَما ضَرَّهُ أَن يَستَسِرَّ لِعاتِمٍ","إِذا ما بَدا في آخِرٍ بِتَمامِ",72,"م",1,0],["وَما ضَرَّ لَو واسى وَسَلّى بِزَورَةٍ","خَلِيٌّ جَرى فيهِ القَضاءُ عَلى راسي",73,"ي",1,0],["وَما ضَرَّ أَن غابَ الأَميرُ وَخَصَّكُم","بِتابِعِهِ قَولاً وَفِعلاً وَمَحتِدا",74,"د",2,0],["وَما ضَرَّنا أَنّا قَليلٌ وَجارُنا","عَزيزٌ وَجارُ الأَكثَرينَ ذَليلُ",75,"ل",1,0],["وما ضَرَّني إِلَّا مَعارِفُ منهمُ","ذُنوبُ وِدادِي عندهمْ لا تُكَفَّرُ",76,"ر",1,0],["وما ضرّ ذا حقّ أباطلُ خصمه","إذا كانت الأقدارُ عنه تُخاصم",77,"م",1,0],["وما ضركم من حاسديكم على العلى","وأيامكم تحدو بهم وتسوق",78,"ق",1,0],["وما ضَرَّ مصراً حينَ ألقَتْ قِيادَهَا","إليكَ أمَدَّ النّيلُ أم غالَهُ جَزْر",79,"ر",1,0],["وما ضَرّ من لم يَطُفْ بالمقامِ","إذا طافَ بالجوسَقِ المُبْتَنى",80,"ا",1,0],["وَما ضَرَّها أَن لا تُعَدَّ لِجَروَلٍ","وَلا المُزَني كَعبٍ وَلا لِزِيادِ",81,"د",1,0],["وَما ضاعَ مالٌ أَورَثَ الحَمدَ أَهلَهُ","وَلَكِنَّ أَموالَ البَخيلِ تَضيعُ",82,"ع",1,0],["وَما ضَنَّ يَومٌ بِداءِ الهَوى","مُحِبّاً إِذا ما سَقاهُ الغَدُ",83,"د",1,0],["وَما ضَيَّقا أَرضي وَلَكِن أَراهُما","إِلى الضَنَكِ مِن وَجهِ البَسيطَةِ لَزّاني",84,"ي",1,0],["وَما ضَرَّ الحَمامَةَ كَسرُ ضَنكٍ","مِنَ الأَقفاصِ كانَ أَضَرَّ سِجِنِ",85,"ن",1,0],["وما ضَرَّهُ إِلا مُزَاحٌ ورِقَّةٌ","ثَنَتْهُ سفِيه الذِّكْرِ وهْو رشِيدُ",86,"د",1,0],["وَمَا ضَرَّنِي أَنِّي تَأَخَّرْتُ عَنْهُمُ","وَفَضْلِي بَيْنَ الْعَالَمِينَ شَهِيرُ",87,"ر",1,0],["وَمَا ضَاقَ صَدْرِي بِالذِينَ وَدِدْتُهُمْ","وَلاَ حَرِجَتْ بِالنَّازِلينَ رِحَابِي",88,"ب",2,0],["وَمَا ضَائِرٌ فَخْرَنَا أَنْ تُبَاحَ","وَلاَ ضَائِرُ الْجَّاهِ أَنْ تُجْتَدَى",89,"د",2,0],["وما ضرّ البنفسجَ إن توارى","حياءٌ والصدور له مقام",90,"م",1,0],["وَما ضامَهُ قَطّ الأَديبُ بِصَولَةٍ","وَلا جاءَ يَشكوهُ إِليّ رَسولُ",91,"ل",1,0],["وما ضنَّ بالدَّر ضرعُ السحاب","ولا شحَّ بطنُ الثرى بالنَّماء",92,"ا",2,0],["وما ضرَّني أن ألْبَسَ الثَّوْبَ باليا","إذا كان من عيبٍ يُدَنِّسُ خاليا؟",93,"ي",2,0],["وما ضرَّ أهلَ الحكم أنْ كان ظلُّهم","ثقيلاً على أهل النُهى والبصائر",94,"ر",1,0],["وما ضاقَ القريضُ به ستمحو","عواثِرَهُ صُدورُكم الرّحاب",95,"ب",1,0],["وما ضرهم نبوا السيوف وعندهم","عزائم من قبل السيوف قواطع",96,"ع",1,0],["وما ضَرّ من لم يَطُفْ بالمقامِ","وفي ذي النواويسِ مْوجُ البحارِ",97,"ا",2,0]]}