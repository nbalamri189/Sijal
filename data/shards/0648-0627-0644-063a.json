e.com/ViewPoem.aspx?id=179166",""],[90,"بعد المطر","https://www.poetsgate.com/ViewPoem.aspx?id=179092",""],[45,"خَيرُ يَوْمَيكَ في الهوَى وَاقتِبَالِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32129",""],[45,"أريحيات صبوة ومشيب","https://www.poetsgate.com/ViewPoem.aspx?id=33102",""],[80,"مَنْ كان عنهُ يُدافعِ القَدَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=3227",""],[91,"شاعر الشهور","https://www.poetsgate.com/ViewPoem.aspx?id=53070",""],[91,"الى الشبان المتفرّجين","https://www.poetsgate.com/ViewPoem.aspx?id=53238",""],[46,"أُقعُدْ، فما نفعَ القيا","https://www.poetsgate.com/ViewPoem.aspx?id=18521",""],[51,"هل أنت من مرتجيك مستمِعُ","https://www.poetsgate.com/ViewPoem.aspx?id=29515",""],[78,"الشَمسُ تَخجَلُ مِن جمالِك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86551&r=&rc=96",""],[78,"قَيدي أَما تَعلمُني مُسلما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87619&r=&rc=165",""]],"verses":[["وَالغايَةُ المَوتُ فَما فِكرَتي","أَسائِقي أَصبَحَ أَم قائِدي",0,"د",2,0],["وَالغَيمُ لَم يُذرِ دَمعاً كادَ يَسفَحُهُ","بِها وَها هُوَ في جَفنَيهِ مُحتَبِسُ",1,"س",1,0],["وَالغولُ بَينَ يَدَيَّ يَخفى تارَةً","وَيَعودُ يَظهَرُ مِثلَ ضَوءِ المَشعَلِ",2,"ل",1,0],["وَالْغَدْرُ شَرُّ سَجِيَّةٍ مَذْمُومَةٍ","شَهِدَ الْحَكِيمُ بِذَاكَ والْمُتَمَلِّلُ",3,"ل",1,0],["والغيثُ يُقْلِع ثمّ تَحْيا بعْدَهُ","في الرّوْضِ عنْ بَرَكاتِهِ أزْهارُهُ",4,"ر",2,0],["وَالْغَيْثُ مَسْدُولُ الْحِجَابِ وَإِنَّمَا","عَلِمَ الْغَمَامُ قُدُومَكُمْ فَتَأَدَّبَا",5,"ب",2,0],["وَأَلغَزتَ لي في حاكِمٍ غَيرِ مُبصِرٍ","وَلَسنا نَرى فَضلاً لَدَيهِ وَلا عِلما",6,"م",2,0],["والغصن في حركاته متحير","بين الغناء وغنة الأطيار",7,"ر",1,0],["والغدير بدرع مصقول","يلتقف سيوف الأنهار",8,"ر",1,0],["والغيثُ إلا من نداك مبُخَلٌ","فالغيثُ يُقلعُ والندى مُتَوَالِ",9,"ل",1,0],["وَالغُرُّ مِن سَلَفي كِنانَةَ إِنَّهُم","صيدُ الرُؤوسِ أَعِزَّةُ السُلطانِ",10,"ن",1,0],["وَالغانِياتُ رَجَعنَ كُلَّ مَوَدَّةٍ","إِذ كانَ قَلبُكَ عِندَهُنَّ مُعارا",11,"ر",2,0],["وَالغُرُّ مِن سَلَفَي سَعدٍ وَإِخوَتِهِم","عَمروٍ كُهولٌ وَشُبّانٌ بَهاليلُ",12,"ل",1,0],["والغيث بالمتألقا","ت من الأهلِّة في النواحرْ",13,"ر",1,1],["والغُيُوثِ الذينَ إِن أَمحَلَ النَّا","سُ فَمَأوَى حَوَاضِنِ الأيتَامِ",14,"م",1,0],["والغيم دان لكأس الراح يمزجها","يكاد يمسكه من قام بالراح",15,"ح",1,0],["والغيث يهمل لا محلٌ ولا سغبٌ","والأمن يشمل لا خوفٌ ولا دَرَك",16,"ك",1,0],["والغنى واسع بكفَّيْ جوادٍ","يَرزُقُ الأغنياء والفقراءَ",17,"ا",2,0],["والغناء الشديد شدواً وضرباً","سَحْنةٌ قد ملأتُ منها الإناءَ",17,"ا",2,0],["والغَرْسُ نَفْلٌ وربُّ الغَرس مُفْترِضٌ","فاربُبْ غراسك تجنِ الشكر من كَثَبِ",18,"ب",1,0],["والغوالي وعَنبرِ الهندِ والمس","ك على الهام واللِّحَى كالخضابِ",19,"ب",1,0],["والغوث منه أوانَ ينتهي ال","شلو ولا غوث حين يبتلع",20,"ع",1,0],["والغيرةُ الشيءُ الذي لم يُلْغه","إلا خَصِيُّ السوء والعِنّين",21,"ن",1,0],["وَالغيدَ بَينَ جَميلَة وَدَميمَةٍ","وَالعاشِقَينِ الصَب وَالمُتَصابي",22,"ي",1,0],["وَالغَيثُ يَهمي بِلا اِنقِطعٍ","وَالرَعدُ مُستَتبِعُ الزَئيرِ",23,"ر",1,0],["وَالغابُ أَوشَكَ أَن يَبوحَ بِها","وَبِهِ بِلا حَذَرٍ إِلى النَهرِ",24,"ر",1,0],["وَالغَربُ لَو كانَ عوداً في مَنابِرِها","وَالشَرقُ لَو كانَ في جُدرانِها حَجَرا",25,"ر",2,0],["وَالغَيمُ الأَسوَدُ يَحتَشِدُ","تَبَقاً في الجَوِّ عَلى طَبَقِ",26,"ق",1,0],["وَالغَربُ يَرنو خائِفاً أَن يَخلُفو","أَجدادُهُم وَيَوَدُّ لَو لَم يَنعَموا",27,"م",3,0],["وَالغالِبينَ عَلى القُلوبِ مَهابَةً","وَالواصِلينَ إِلى القُلوبِ تَوَدُّدا",28,"د",2,0],["وَالغَيثُ لا يَسِمُ البِلادَ بِنَفعِهِ","إِلّا إِذا اِشتاقَت لِوَسميّاتِهِ",29,"ت",2,0],["والغرُّ يعذره الحكيمُ إِذا طغى","جهلُ الصِّبا في قلبه الوثّابِ",30,"ب",1,0],["وَالغَيثُ يَحيا أَن يُصو","بَ لِما يَراهُ مِن نَوالِكْ",31,"ك",1,0],["وَالغَيرُ لا يَفهَمُ شَيئاً فَما","يَفتَحُ إِلّا للرّضاعِ فَما",32,"م",2,0],["والغرب ابناؤه بالعلم قد سعدوا","والشرق اهلوه في جهل كما كانوا",33,"ن",3,0],["والغصن يحلو علينا رقة وجوى","والماء في قدمينا رايح غاد",34,"د",1,0],["وَالغُصنُ يَحنو عَلَينا رِقَّةً وَجَوىً","وَالماءُ في قَدَمَينا رائِحٌ غادِ",35,"د",1,0],["وَالغِنى لِخِدمَتِهِ","كَالفَقيرِ مُحتَشِدُ",36,"د",1,0],["وَالغُبارُ الَّذي عَلى صَفحَتَيها","دَوَرانُ الرَحى عَلى الأَجسادِ",37,"د",1,0],["وَالغُصنُ يَسجُدُ في الفَضا","ءِ وَحَبَّذا مِنهُ السُجود",38,"د",1,0],["وَالغِنى في يَدِ اللَئيمِ قَبيحٌ","قَدرَ قُبحِ الكَريمِ في الإِملاقِ",39,"ق",1,0],["وَالغَواني إِن غَنَّينَ عَفافاً","يَطَّبيهُنَّ مِنهُ حُسنٌ وَطيبُ",40,"ب",1,0],["وَالغَيمُ مَحبوكَةٌ طَرائِقُهُ","أَحجى مِنَ الصَحوِ يُبتَغى مَطَرُه",41,"ر",2,0],["وَالغِنى في القُنوعِ أَم سَيبُ مَن يُغ","نيكَ وَشكُ اِبتِدائِهِ عَن سُؤالِه",42,"ل",2,0],["وَالغَواني يَتَوَرَّدنَ بِنا","قُحَمَ الهُلكِ وَإِن هِمنا بِهِنّ",43,"ن",1,0],["وَالغابِقينَ مِنَ المَحضَينِ جارَتَهُم","وَالزائِديها إِلى اِستِحيائِها خَفَرا",44,"ر",2,0],["والغُدْرُ في أرجائِه مَصقولةٌ","مثلَ الدراهمِ أشرَقَتْ في مَنْثَرِ",45,"ر",1,0],["والغَيثُ واللَّيثُ والهلالُ إذا","أقمرَ بأساً ونَجدةً ونَدَى",46,"د",2,0],["والغَيثُ قد بانَ له عارضٌ","على بِساطِ الرّوضِ مَسكوبُ",47,"ب",1,0],["والغيثُ إن برقتْ نحوي مخائِلُه","راحت تَصوبُ على غيري صوائبُه",48,"ب",2,0],["وَالغَيبُ يُثبِتُهُ في العَقلِ شاهِدُهُ","وَالعِلمُ أَجمَعُ مِن عَينٍ وَمِن أَثَرِ",49,"ر",1,0],["وَالغِنى أَن تُحَسِّنَ الظَنَّ بِاللَ","هِ وَتَرضى بِكُلِّ أَمرٍ يَكونُ",50,"ن",1,0],["وَالغُصنُ قَد كُسِيَ الغَلائِلَ بَعدَما","أَخَذَت يَدا كانونَ في تَجريدِهِ",51,"د",2,0],["وَالغَيمُ يَحكي الماءَ في جَرَيانِهِ","وَالماءُ يَحكي الغَيمَ في تَجعيدِهِ",51,"د",2,0],["وَالغُصنُ بِالزَهرِ قَد تَجَلّى","وَالأَرضُ بِالقَطرِ قَد تَرَوَّت",52,"ت",1,0],["وَالغَيمُ رَطبُ الأَديمِ جَعدٌ","كَأَنَّهُ حُلَّةٌ تَطَوَّت",52,"ت",1,0],["وَالغَيثِ إِلا أَنَّهُ لا يَنتَهي","وَاللَيثِ إِلّا أَنَّهُ لا يَفرَقُ",53,"ق",1,0],["وَالغَيمُ قَد نُشِرَت في الجَوِّ بُردَتُهُ","سِتراً تُمَدُّ حَواشيهِ عَلى الأُفُقِ",54,"ق",1,0],["والغادتانِ تفِيضُ بينهما","خُدَعُ الهوى وقطيعةُ الحلمِ",55,"م",1,0],["والغَدْرُ قد مُلِئَ الزَّمانُ به","قِدماً وكم نَطَقَتْ بهِ السيَرُ",56,"ر",1,0],["والغواني لا غنىً عن وَصلها","أبِغَيرِ الماء يَرْوَى ذو التِياح",57,"ح",1,0],["والغصنُ يرقصُ والحمامُ صوادحٌ","والريحُ فيها عنبرٌ وعبيرُ",58,"ر",1,0],["وَالغَواني إِذا رَأَينَكَ كَهلاً","كانَ فيهِنَّ عَن هَواكَ اِلتِواءُ",59,"ا",2,0],["وَالغَيثُ مُنهَلٌّ يَسُحُّ كَأَنَّهُ","دَمعُ المُوَدِّعِ إِثرَ إِلفٍ سائِرِ",60,"ر",1,0],["وَالغُصنُ في أَثوابِهِ وَالدُرُّ في","فَمِهِ وَجيدُ الظَبيِ في أَزرارِه",61,"ر",2,0],["وَالغَيثُ يُهدي الدَمعَ كُلَّ عَشِيَّةٍ","لِغُيومِ يَومٍ لَم يُحَط بِنَباتِ",62,"ت",1,0],["والغارُ قد شَنَّتْ عليه غارةً","أعْداؤُه حِرْصاً عليه وأجلبُوا",63,"ب",3,0],["وَالغَرْسُ في البَدْوِ المُشار لِفَضْلِهِ","إنْ كُنْتَ تَجْهلُهُ فَسَلْ حِزْقِيلا",64,"ل",2,0],["وَالغاضِرِيّونَ الَّذينَ تَحَمَّلوا","بِلِوائِهِم سَيراً لِدارِ قَرارِ",65,"ر",1,0],["وَالغَيثُ أَهنَوءُهُ الَّذي","يَهمي وَلَيسَ لَهُ رُعودُ",66,"د",1,0],["وَالغَيثُ أَهنَأُ ما تَراهُ عَطيَّةً","ما لَم يَحُثُّ بَوارِقاً وَرَواعِدا",67,"د",2,0],["وَالغَيُّ في كُلِّ شَيءٍ لَيسَ يَعدَمُهُ","باغيهِ حَتّى مِنَ الأَعنابِ تُعتَصَرُ",68,"ر",1,0],["وَالغَيُّ كَالنَجمِ عُرياناً بِلا سُتُرٍ","وَلِلحُقوقِ وُجوهٌ أُلبِسَت خُمُرا",69,"ر",2,0],["وَالغُمرُ يَأتي غِمارَ اللُجِّ يَحسِبُها","ضَحضاحَ ماءٍ فَنُلفيهِ وَقَد غُمِرا",70,"ر",2,0],["وَالغَمرُ إِن لَم تَهدِهِ شَمسُ الضُحى","لَم يَهدِهِ جِنحُ الظَلامِ بِزُهرِهِ",71,"ر",2,0],["وَالغيدُ مُختَلِفٌ مَواضِعُ حَليها","وَتَناءَتِ الأَحجالُ وَالأَقراطُ",72,"ط",1,0],["وَالغَزلُ وَالرَدنُ لِلغَواني","شَيئانِ عُدّا مِنَ الجَزالَه",73,"ل",2,0],["وَالغِرُّ يُرسِلُ قَولَهُ بِمَواعِدٍ","وُلُدٍ فَتَنتِجُ عَن يَمينٍ حائِلِ",74,"ل",1,0],["وَالغانِياتُ وَفي آذانِها دُرَرٌ","كَالضَأنِ تَرعى وَفي آذانِها زَنَمُ",75,"م",1,0],["وَالغَدرُ في الآدَمِيِّ طَبعٌ","فَاِحتَرِزي قَبلَ أَن تَنامي",76,"ي",1,0],["وَالغَيُّ ثَوبٌ إِذا لَم يَستَلِب رَجُلاً","بِالرَغمِ لَم تَحسُرِ التَقوى لَهُ رَدَنا",77,"ن",2,0],["وَالغَبنُ كَوني في الحَياةِ مُصَوَّراً","فَمِنَ الغَباوَةِ خيفَتي أَن أُغبَنا",78,"ن",2,0],["والغاصبُ السَّفاحُ من أنيابه","يجري الدمُ القاني ومن أظفارِهِ",79,"ر",2,0],["والغمد لو يسكنه سيفان","والجفن لو ينزله طيفان",80,"ن",1,0],["وَالْغَرْبُ زَادَ بَصَوْغِهِ","حُسْناً عَلَى الْحُسْنِ الْقُدَامِ",81,"م",1,0],["والغَوْرُ صَاغِي الأذْنِ والغَارُ ذو","إِنْسَانِ عَيْنٍ دَارَ فِي مَحْجِرِ",82,"ر",1,0],["وَالْغَرْبُ يَرْقَى وَما بِالشَّرْقِ مِنْ هِمَمٍ","سَوَى الْتِفَاتٍ إِلى المَاضِي وَتَعْدِيدِ",83,"د",1,0],["وَالْغَوْرُ بَيْنَ يَدِيْهِ مَرْمىً شَاسِعٌ","لِلْمَاءِ فِي قَاعٍ كَثِيرِ جَنَادِبِ",84,"ب",1,0],["والغُصنُ، في حِضنِ الرياضِ، وسادةٌ","نمتْ على عُنُقَينِ منْ تُفَّاحِ",85,"ح",1,0],["والغصنُ والأوراقُ آذانٌ له","ماذا ترى فيها النسيم يُتَبتِبُ",86,"ب",1,0],["والغرام الطهور معاني","الحبّ أسمى ما في الوجود وأنبل",87,"ل",1,0],["وَالْغَرْبُ يَنْظُرُ في خُمُودٍ","نَحْوَ قاتِلَةِ الْخُمُودِ",88,"د",1,0],["والغانياتُ أُفزِّعتْ أسرابُها","وتفرّق السُّمارُ عن شاديك",89,"ك",1,0],["والغاصبُ المحتَلُّ سلَّم سيفَهُ","ومضى لِطَّيِته بدون قتِالِهِ",90,"ل",2,0],["والغاصبُ المحتَلُّ شِبُهُ مُؤَلَّه","في مصرَ يرجُو الكلُّ وصْلَ حبالِهِ",90,"ل",2,0],["والغُصنُ مالَ على أخيه هامسًا","همس الأحبَّةِ فيه بالأسرار",91,"ر",1,0],["وأُلغَيتِ الفروقُ؛ فلا وِسامٌ","تُزَانُ به الصدورُ، ولا وِشاحُ",92,"ح",1,0],["والغربُ -قبلَ الشرقِ- مُلتفتٌ","يرنو إلى أعلامه الخُضْر",93,"ر",1,0],["والغِيدُ أسْرَابٌ إلى أسراب","يَنْبُتْن في شَطِّك كالأعشاب",94,"ب",1,0],["والغارُ يبرأ من رءوسٍ أهلُها","ساموا الأنامَ القتلَ والتعذيبا",95,"ب",2,0],["والغيد تغمس في الغدير جرارَها","فيظلُّ يضحك ملء فيه طروبا",96,"ب",2,0],["والغدر مرتعه وخيم وكلما","لاذ امرؤ بحماه خاب وخاما",97,"م",2,0],["والغرامُ الطهورُ أزكى معاني ال","حب أسمى ما في الوجود وأنبل",98,"ل",1,0],["والغار تَضفِرُهُ لهمْ","رَيانَ من طَفَح القلوب",99,"ب",1,0],["والغامراتِ عيونُها وديانَها","وجبالَها وبقيعَها الفينانا",100,"ن",2,0],["والغارقاتِ مروجُها في سُندُسٍ","خُضرٍ تَفوح من الشَذا أردانا",100,"ن",2,0],["والغيثُ يَهمي أين من صَفوهِ","وهو جديدٌ ، خمرُ دنٍّ عتيق",101,"ق",1,0],["وَالغِنى في القُنوعِ، أوْ سَيبِ ما يُغ","نيكَ وَشْكُ ابتِدائِهِ عَنْ سُؤالِهْ",102,"ل",2,0],["والغواني وإن غنين عفافاً","يطبيهن منه حسن وطيب",103,"ب",1,0],["والغدرُ قد ملىء الزمان به","قِدْماً، وكم نَطَقَتْ به السير",104,"ر",1,0],["والغيث يهمي بلا انقطاع ،","والرعد مستتبع الزئير",105,"ر",1,0],["والغرب يرنو خافا","أجدادهم ويودّ لو لم ينعموا",106,"م",3,0],["والغَيثُ أهنؤُهُ الذي","يَهمي، وليسَ له رُعود",107,"د",1,0],["والغوثُ منه أوانَ ينتهي الشْ","شِلو ولا غوثَ حين يبتلع",108,"ع",1,0],["وَالغَيثُ يَخجلُ أَن يُصو","بَ، لِما يَراهُ مِن نَوالِكْ",109,"ك",1,0],["وَالغَيرُ لا يَفهَمُ شَيئاً فَما","يَفتَحُ إِلّا لرِضاعٍ فَمَا",110,"م",2,0]]}