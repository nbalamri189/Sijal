diwan.net/poem3578.html","عموديه"],[465,"عق دمعي من بعد أهل العقيق","https://www.aldiwan.net/poem3605.html","عموديه"],[469,"وليلة أيقظني معانقي","https://www.aldiwan.net/poem59521.html","الرجز"],[469,"الغيم يبسط في السماء ويفرش","https://www.aldiwan.net/poem59930.html","الكامل"],[469,"الروض مثل سوالف وخدود","https://www.aldiwan.net/poem60180.html","الكامل"],[469,"الرعد منتحب والبرق ملتهب","https://www.aldiwan.net/poem60449.html","البسيط"],[480,"ما لسلمي يهزها الخيلاء","https://www.aldiwan.net/poem36923.html","الخفيف"],[501,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[501,"آل النبي الطاهر المصطفى","https://www.aldiwan.net/poem37678.html","السريع"],[501,"ما الفخر إلا للذين تواضعوا","https://www.aldiwan.net/poem38013.html","الكامل"],[516,"صرف النسيب إلى اللوى وزرود","https://www.aldiwan.net/poem12082.html","الكامل"],[516,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[516,"لما أدار مدامة الأحداق","https://www.aldiwan.net/poem12187.html","الكامل"],[516,"العلم مذ كان محتاج إلى العلم","https://www.aldiwan.net/poem12262.html","البسيط"],[516,"وسمت بنعماك الرقاب تبرعاً","https://www.aldiwan.net/poem12272.html","الكامل"],[528,"الملك عندي متعة الشباب","https://www.aldiwan.net/poem45953.html","الرجز"],[552,"دع رجالا ينازعون على المال","https://www.aldiwan.net/poem47281.html","الخفيف"],[552,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[552,"قم فاثن لي فوق الوهاد وسادي","https://www.aldiwan.net/poem47843.html","الكامل"],[552,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[559,"أنا الوجود كما أني أنا العدم","https://www.aldiwan.net/poem33860.html","البسيط"],[559,"العفو أليق لا جرم","https://www.aldiwan.net/poem34073.html","مجزوء الكامل"],[559,"إن كنت نائم","https://www.aldiwan.net/poem34090.html","مخلع البسيط"],[559,"ظهرت لي يا غيب يا مطلق","https://www.aldiwan.net/poem34302.html","السريع"],[559,"كلى تفنيه وتوجده","https://www.aldiwan.net/poem34567.html","المتدارك"],[559,"زينة العبد فقره واحتياجه","https://www.aldiwan.net/poem34682.html","الخفيف"],[564,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[568,"شطت لليلى باللوى","https://www.aldiwan.net/poem69615.html","مجزوء الرجز"],[568,"يا طيب يوم خلاعة وبطالة","https://www.aldiwan.net/poem69773.html","الكامل"],[576,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"],[576,"قلبي يقول لطيف منك يطرقني","https://www.aldiwan.net/poem2997.html","البسيط"],[576,"حتى خيالك لا وفى ولا وافى","https://www.aldiwan.net/poem3051.html","البسيط"],[577,"ألك السدير وبارق","https://www.aldiwan.net/poem1782.html","مجزوء الكامل"],[587,"أقلب قلبي شوقا إليه","https://www.aldiwan.net/poem17993.html","المتقارب"]],"verses":[["وَالغايَةُ المَوتُ فَما فِكرَتي","أَسائِقي أَصبَحَ أَم قائِدي",0,"د",2,0],["وَالغَيمُ لَم يُذرِ دَمعاً كادَ يَسفَحُهُ","بِها وَها هُوَ في جَفنَيهِ مُحتَبِسُ",1,"س",1,0],["والغد المأمول في أشواقه","صورة من كلّ حسن باهر",2,"ر",1,0],["وَالغولُ بَينَ يَدَيَّ يَخفى تارَةً","وَيَعودُ يَظهَرُ مِثلَ ضَوءِ المَشعَلِ",3,"ل",1,0],["وَالْغَدْرُ شَرُّ سَجِيَّةٍ مَذْمُومَةٍ","شَهِدَ الْحَكِيمُ بِذَاكَ والْمُتَمَلِّلُ",4,"ل",1,0],["والغيثُ يُقْلِع ثمّ تَحْيا بعْدَهُ","في الرّوْضِ عنْ بَرَكاتِهِ أزْهارُهُ",5,"ر",2,0],["وَالْغَيْثُ مَسْدُولُ الْحِجَابِ وَإِنَّمَا","عَلِمَ الْغَمَامُ قُدُومَكُمْ فَتَأَدَّبَا",6,"ب",2,0],["وَأَلغَزتَ لي في حاكِمٍ غَيرِ مُبصِرٍ","وَلَسنا نَرى فَضلاً لَدَيهِ وَلا عِلما",7,"م",2,0],["والغصن في حركاته متحير","بين الغناء وغنة الأطيار",8,"ر",1,0],["والغدير بدرع مصقول","يلتقف سيوف الأنهار",9,"ر",1,0],["والغيثُ إلا من نداك مبُخَلٌ","فالغيثُ يُقلعُ والندى مُتَوَالِ",10,"ل",1,0],["وَالغُرُّ مِن سَلَفي كِنانَةَ إِنَّهُم","صيدُ الرُؤوسِ أَعِزَّةُ السُلطانِ",11,"ن",1,0],["وَالغانِياتُ رَجَعنَ كُلَّ مَوَدَّةٍ","إِذ كانَ قَلبُكَ عِندَهُنَّ مُعارا",12,"ر",2,0],["وَالغُرُّ مِن سَلَفَي سَعدٍ وَإِخوَتِهِم","عَمروٍ كُهولٌ وَشُبّانٌ بَهاليلُ",13,"ل",1,0],["والغيث بالمتألقا","ت من الأهلِّة في النواحرْ",14,"ر",1,1],["والغُيُوثِ الذينَ إِن أَمحَلَ النَّا","سُ فَمَأوَى حَوَاضِنِ الأيتَامِ",15,"م",1,0],["والغيم دان لكأس الراح يمزجها","يكاد يمسكه من قام بالراح",16,"ح",1,0],["والغيث يهمل لا محلٌ ولا سغبٌ","والأمن يشمل لا خوفٌ ولا دَرَك",17,"ك",1,0],["والغنى واسع بكفَّيْ جوادٍ","يَرزُقُ الأغنياء والفقراءَ",18,"ا",2,0],["والغناء الشديد شدواً وضرباً","سَحْنةٌ قد ملأتُ منها الإناءَ",18,"ا",2,0],["والغَرْسُ نَفْلٌ وربُّ الغَرس مُفْترِضٌ","فاربُبْ غراسك تجنِ الشكر من كَثَبِ",19,"ب",1,0],["والغوالي وعَنبرِ الهندِ والمس","ك على الهام واللِّحَى كالخضابِ",20,"ب",1,0],["والغوث منه أوانَ ينتهي ال","شلو ولا غوث حين يبتلع",21,"ع",1,0],["والغيرةُ الشيءُ الذي لم يُلْغه","إلا خَصِيُّ السوء والعِنّين",22,"ن",1,0],["وَالغيدَ بَينَ جَميلَة وَدَميمَةٍ","وَالعاشِقَينِ الصَب وَالمُتَصابي",23,"ب",2,0],["وَالغَيثُ يَهمي بِلا اِنقِطعٍ","وَالرَعدُ مُستَتبِعُ الزَئيرِ",24,"ر",1,0],["وَالغابُ أَوشَكَ أَن يَبوحَ بِها","وَبِهِ بِلا حَذَرٍ إِلى النَهرِ",25,"ر",1,0],["وَالغَربُ لَو كانَ عوداً في مَنابِرِها","وَالشَرقُ لَو كانَ في جُدرانِها حَجَرا",26,"ر",2,0],["وَالغَيمُ الأَسوَدُ يَحتَشِدُ","تَبَقاً في الجَوِّ عَلى طَبَقِ",27,"ق",1,0],["وَالغَربُ يَرنو خائِفاً أَن يَخلُفو","أَجدادُهُم وَيَوَدُّ لَو لَم يَنعَموا",28,"م",3,0],["وَالغالِبينَ عَلى القُلوبِ مَهابَةً","وَالواصِلينَ إِلى القُلوبِ تَوَدُّدا",29,"د",2,0],["وَالغَيثُ لا يَسِمُ البِلادَ بِنَفعِهِ","إِلّا إِذا اِشتاقَت لِوَسميّاتِهِ",30,"ت",2,0],["والغرُّ يعذره الحكيمُ إِذا طغى","جهلُ الصِّبا في قلبه الوثّابِ",31,"ب",1,0],["وَالغَيثُ يَحيا أَن يُصو","بَ لِما يَراهُ مِن نَوالِكْ",32,"ك",1,0],["وَالغَيرُ لا يَفهَمُ شَيئاً فَما","يَفتَحُ إِلّا للرّضاعِ فَما",33,"م",2,0],["والغرب ابناؤه بالعلم قد سعدوا","والشرق اهلوه في جهل كما كانوا",34,"ن",3,0],["والغصن يحلو علينا رقة وجوى","والماء في قدمينا رايح غاد",35,"د",1,0],["وَالغُصنُ يَحنو عَلَينا رِقَّةً وَجَوىً","وَالماءُ في قَدَمَينا رائِحٌ غادِ",36,"د",1,0],["وَالغِنى لِخِدمَتِهِ","كَالفَقيرِ مُحتَشِدُ",37,"د",1,0],["وَالغُبارُ الَّذي عَلى صَفحَتَيها","دَوَرانُ الرَحى عَلى الأَجسادِ",38,"د",1,0],["وَالغُصنُ يَسجُدُ في الفَضا","ءِ وَحَبَّذا مِنهُ السُجود",39,"د",1,0],["وَالغِنى في يَدِ اللَئيمِ قَبيحٌ","قَدرَ قُبحِ الكَريمِ في الإِملاقِ",40,"ق",1,0],["وَالغَواني إِن غَنَّينَ عَفافاً","يَطَّبيهُنَّ مِنهُ حُسنٌ وَطيبُ",41,"ب",1,0],["وَالغَيمُ مَحبوكَةٌ طَرائِقُهُ","أَحجى مِنَ الصَحوِ يُبتَغى مَطَرُه",42,"ر",2,0],["وَالغِنى في القُنوعِ أَم سَيبُ مَن يُغ","نيكَ وَشكُ اِبتِدائِهِ عَن سُؤالِه",43,"ل",2,0],["وَالغَواني يَتَوَرَّدنَ بِنا","قُحَمَ الهُلكِ وَإِن هِمنا بِهِنّ",44,"ن",1,0],["وَالغابِقينَ مِنَ المَحضَينِ جارَتَهُم","وَالزائِديها إِلى اِستِحيائِها خَفَرا",45,"ر",2,0],["والغُدْرُ في أرجائِه مَصقولةٌ","مثلَ الدراهمِ أشرَقَتْ في مَنْثَرِ",46,"ر",1,0],["والغَيثُ واللَّيثُ والهلالُ إذا","أقمرَ بأساً ونَجدةً ونَدَى",47,"د",2,0],["والغَيثُ قد بانَ له عارضٌ","على بِساطِ الرّوضِ مَسكوبُ",48,"ب",1,0],["والغيثُ إن برقتْ نحوي مخائِلُه","راحت تَصوبُ على غيري صوائبُه",49,"ب",2,0],["وَالغَيبُ يُثبِتُهُ في العَقلِ شاهِدُهُ","وَالعِلمُ أَجمَعُ مِن عَينٍ وَمِن أَثَرِ",50,"ر",1,0],["وَالغِنى أَن تُحَسِّنَ الظَنَّ بِاللَ","هِ وَتَرضى بِكُلِّ أَمرٍ يَكونُ",51,"ن",1,0],["وَالغُصنُ قَد كُسِيَ الغَلائِلَ بَعدَما","أَخَذَت يَدا كانونَ في تَجريدِهِ",52,"د",2,0],["وَالغَيمُ يَحكي الماءَ في جَرَيانِهِ","وَالماءُ يَحكي الغَيمَ في تَجعيدِهِ",52,"د",2,0],["وَالغُصنُ بِالزَهرِ قَد تَجَلّى","وَالأَرضُ بِالقَطرِ قَد تَرَوَّت",53,"ت",1,0],["وَالغَيمُ رَطبُ الأَديمِ جَعدٌ","كَأَنَّهُ حُلَّةٌ تَطَوَّت",53,"ت",1,0],["وَالغَيثِ إِلا أَنَّهُ لا يَنتَهي","وَاللَيثِ إِلّا أَنَّهُ لا يَفرَقُ",54,"ق",1,0],["وَالغَيمُ قَد نُشِرَت في الجَوِّ بُردَتُهُ","سِتراً تُمَدُّ حَواشيهِ عَلى الأُفُقِ",55,"ق",1,0],["والغادتانِ تفِيضُ بينهما","خُدَعُ الهوى وقطيعةُ الحلمِ",56,"م",1,0],["والغَدْرُ قد مُلِئَ الزَّمانُ به","قِدماً وكم نَطَقَتْ بهِ السيَرُ",57,"ر",1,0],["والغواني لا غنىً عن وَصلها","أبِغَيرِ الماء يَرْوَى ذو التِياح",58,"ح",1,0],["والغصنُ يرقصُ والحمامُ صوادحٌ","والريحُ فيها عنبرٌ وعبيرُ",59,"ر",1,0],["وَالغَواني إِذا رَأَينَكَ كَهلاً","كانَ فيهِنَّ عَن هَواكَ اِلتِواءُ",60,"ا",2,0],["وَالغَيثُ مُنهَلٌّ يَسُحُّ كَأَنَّهُ","دَمعُ المُوَدِّعِ إِثرَ إِلفٍ سائِرِ",61,"ر",1,0],["وَالغُصنُ في أَثوابِهِ وَالدُرُّ في","فَمِهِ وَجيدُ الظَبيِ في أَزرارِه",62,"ر",2,0],["وَالغَيثُ يُهدي الدَمعَ كُلَّ عَشِيَّةٍ","لِغُيومِ يَومٍ لَم يُحَط بِنَباتِ",63,"ت",1,0],["والغارُ قد شَنَّتْ عليه غارةً","أعْداؤُه حِرْصاً عليه وأجلبُوا",64,"ب",3,0],["وَالغَرْسُ في البَدْوِ المُشار لِفَضْلِهِ","إنْ كُنْتَ تَجْهلُهُ فَسَلْ حِزْقِيلا",65,"ل",2,0],["وَالغاضِرِيّونَ الَّذينَ تَحَمَّلوا","بِلِوائِهِم سَيراً لِدارِ قَرارِ",66,"ر",1,0],["وَالغَيثُ أَهنَوءُهُ الَّذي","يَهمي وَلَيسَ لَهُ رُعودُ",67,"د",1,0],["وَالغَيثُ أَهنَأُ ما تَراهُ عَطيَّةً","ما لَم يَحُثُّ بَوارِقاً وَرَواعِدا",68,"د",2,0],["وَالغَيُّ في كُلِّ شَيءٍ لَيسَ يَعدَمُهُ","باغيهِ حَتّى مِنَ الأَعنابِ تُعتَصَرُ",69,"ر",1,0],["وَالغَيُّ كَالنَجمِ عُرياناً بِلا سُتُرٍ","وَلِلحُقوقِ وُجوهٌ أُلبِسَت خُمُرا",70,"ر",2,0],["وَالغُمرُ يَأتي غِمارَ اللُجِّ يَحسِبُها","ضَحضاحَ ماءٍ فَنُلفيهِ وَقَد غُمِرا",71,"ر",2,0],["وَالغَمرُ إِن لَم تَهدِهِ شَمسُ الضُحى","لَم يَهدِهِ جِنحُ الظَلامِ بِزُهرِهِ",72,"ر",2,0],["وَالغيدُ مُختَلِفٌ مَواضِعُ حَليها","وَتَناءَتِ الأَحجالُ وَالأَقراطُ",73,"ط",1,0],["وَالغَزلُ وَالرَدنُ لِلغَواني","شَيئانِ عُدّا مِنَ الجَزالَه",74,"ل",2,0],["وَالغِرُّ يُرسِلُ قَولَهُ بِمَواعِدٍ","وُلُدٍ فَتَنتِجُ عَن يَمينٍ حائِلِ",75,"ل",1,0],["وَالغانِياتُ وَفي آذانِها دُرَرٌ","كَالضَأنِ تَرعى وَفي آذانِها زَنَمُ",76,"م",1,0],["وَالغَدرُ في الآدَمِيِّ طَبعٌ","فَاِحتَرِزي قَبلَ أَن تَنامي",77,"م",2,0],["وَالغَيُّ ثَوبٌ إِذا لَم يَستَلِب رَجُلاً","بِالرَغمِ لَم تَحسُرِ التَقوى لَهُ رَدَنا",78,"ن",2,0],["وَالغَبنُ كَوني في الحَياةِ مُصَوَّراً","فَمِنَ الغَباوَةِ خيفَتي أَن أُغبَنا",79,"ن",2,0],["والغاصبُ السَّفاحُ من أنيابه","يجري الدمُ القاني ومن أظفارِهِ",80,"ر",2,0],["والغمد لو يسكنه سيفان","والجفن لو ينزله طيفان",81,"ن",1,0],["وَالْغَرْبُ زَادَ بَصَوْغِهِ","حُسْناً عَلَى الْحُسْنِ الْقُدَامِ",82,"م",1,0],["والغَوْرُ صَاغِي الأذْنِ والغَارُ ذو","إِنْسَانِ عَيْنٍ دَارَ فِي مَحْجِرِ",83,"ر",1,0],["وَالْغَرْبُ يَرْقَى وَما بِالشَّرْقِ مِنْ هِمَمٍ","سَوَى الْتِفَاتٍ إِلى المَاضِي وَتَعْدِيدِ",84,"د",1,0],["وَالْغَوْرُ بَيْنَ يَدِيْهِ مَرْمىً شَاسِعٌ","لِلْمَاءِ فِي قَاعٍ كَثِيرِ جَنَادِبِ",85,"ب",1,0],["والغُصنُ، في حِضنِ الرياضِ، وسادةٌ","نمتْ على عُنُقَينِ منْ تُفَّاحِ",86,"ح",1,0],["والغصنُ والأوراقُ آذانٌ له","ماذا ترى فيها النسيم يُتَبتِبُ",87,"ب",1,0],["والغرام الطهور معاني","الحبّ أسمى ما في الوجود وأنبل",88,"ل",1,0],["وَالْغَرْبُ يَنْظُرُ في خُمُودٍ","نَحْوَ قاتِلَةِ الْخُمُودِ",89,"د",1,0],["والغانياتُ أُفزِّعتْ أسرابُها","وتفرّق السُّمارُ عن شاديك",90,"ك",1,0],["والغاصبُ المحتَلُّ سلَّم سيفَهُ","ومضى لِطَّيِته بدون قتِالِهِ",91,"ل",2,0],["والغاصبُ المحتَلُّ شِبُهُ مُؤَلَّه","في مصرَ يرجُو الكلُّ وصْلَ حبالِهِ",91,"ل",2,0],["والغُصنُ مالَ على أخيه هامسًا","همس الأحبَّةِ فيه بالأسرار",92,"ر",1,0],["وأُلغَيتِ الفروقُ؛ فلا وِسامٌ","تُزَانُ به الصدورُ، ولا وِشاحُ",93,"ح",1,0],["والغربُ -قبلَ الشرقِ- مُلتفتٌ","يرنو إلى أعلامه الخُضْر",94,"ر",1,0],["والغِيدُ أسْرَابٌ إلى أسراب","يَنْبُتْن في شَطِّك كالأعشاب",95,"ب",1,0],["والغارُ يبرأ من رءوسٍ أهلُها","ساموا الأنامَ القتلَ والتعذيبا",96,"ب",2,0],["والغيد تغمس في الغدير جرارَها","فيظلُّ يضحك ملء فيه طروبا",97,"ب",2,0],["والغدر مرتعه وخيم وكلما","لاذ امرؤ بحماه خاب وخاما",98,"م",2,0],["والغرامُ الطهورُ أزكى معاني ال","حب أسمى ما في الوجود وأنبل",99,"ل",1,0],["والغار تَضفِرُهُ لهمْ","رَيانَ من طَفَح القلوب",100,"ب",1,0],["والغامراتِ عيونُها وديانَها","وجبالَها وبقيعَها الفينانا",101,"ن",2,0],["والغارقاتِ مروجُها في سُندُسٍ","خُضرٍ تَفوح من الشَذا أردانا",101,"ن",2,0],["والغيثُ يَهمي أين من صَفوهِ","وهو جديدٌ ، خمرُ دنٍّ عتيق",102,"ق",1,0],["وَالغِنى في القُنوعِ، أوْ سَيبِ ما يُغ","نيكَ وَشْكُ ابتِدائِهِ عَنْ سُؤالِهْ",103,"ل",2,0],["والغواني وإن غنين عفافاً","يطبيهن منه حسن وطيب",104,"ب",1,0],["والغدرُ قد ملىء الزمان به","قِدْماً، وكم نَطَقَتْ به السير",105,"ر",1,0],["والغيث يهمي بلا انقطاع ،","والرعد مستتبع الزئير",106,"ر",1,0],["والغرب يرنو خافا","أجدادهم ويودّ لو لم ينعموا",107,"م",3,0],["والغَيثُ أهنؤُهُ الذي","يَهمي، وليسَ له رُعود",108,"د",1,0],["والغوثُ منه أوانَ ينتهي الشْ","شِلو ولا غوثَ حين يبتلع",109,"ع",1,0],["وَالغَيثُ يَخجلُ أَن يُصو","بَ، لِما يَراهُ مِن نَوالِكْ",110,"ك",1,0],["وَالغَيرُ لا يَفهَمُ شَيئاً فَما","يَفتَحُ إِلّا لرِضاعٍ فَمَا",111,"م",2,0],["والغروب النديّان في الغوطة المعطار","يحنو على الظلال فتندى",112,"د",2,0],["والغدر مفتاح لنكبة جاهه","والمكر مقراض لقدة وصله",113,"ل",2,0],["والغوث زين العابدين وباقر","والذخر جعفر والولي موسى الرضى",114,"ض",2,0],["والغير غير لإبقاء لشانه","والحكم ظل لا حكم الحاكم",115,"م",1,0],["والغور ما انفكت غدائر نبته","وزهوره تحنو على غدرانه",116,"ن",2,0],["والغور مدهامة جناته وأنا","في معشر من بني قومي ميامين",117,"ن",1,0],["والغَادَةَ العَذ رَاءَ بَاهِرَةَ الحُلَى","وَصَدَاقَهَا وتَكُونَ بَعدُ الكَافِلا",118,"ل",2,0],["والغَاسِلَ الرَّينَ المُرِبَّ عَلَى النُّهَى","والكَاسِىَ العِلمَ الغَزِيرَ الجَاهِلا",118,"ل",2,0],["والغصْنُ يرقص في أدواحها طرباً","لما سرت في أراضيها الصبا مرحا",119,"ح",2,0],["والغِمدُ ليس تُفاض بُردتُهُ","إلا على الهندىِّ ذى الأثْرِ",120,"ر",1,0],["والغنىَ ليس باللُّجيْن وبالتِّب","ر ولكن بعزّةٍ في النفوسِ",121,"س",1,0],["والغادياتُ السارياتُ بريقُها","ولِبانُهَا يسقى الرجاءَ ويُرضعُ",122,"ع",1,0],["وَالغَيثُ لَيسَ يَنوبُ عَنهُ وَطالَما","غابَ الغَمامُ فَنابَ عَنهُ بَنانُهُ",123,"ن",2,0],["والغيم قد حجب السماء بمطرف","نسجته كفُّ الريح نسجاً هلهلا",124,"ل",2,0],["وَالغبنُ يُوطي الحُرَّ كُلَّ عَظِيمَةٍ","وَيُفتِّشُ الحُلماءِ عَن إِحناتِها",125,"ت",3,0],["وَأَلغِ مَقالاتِ الوُشاةِ فَإِنَّها","لأَشياءَ ظَنّي أَنَّها لا تَنالُها",126,"ل",3,0],["وَأَلغَيتُمُ أَيّامنا وَاِستَمَعتُمُ","غُرورَ الأَماني وَالحَديثَ المُرَجَّما",127,"م",2,0],["والغَضْبُ دِينٌ وَشُرْبُ الرّاحِ مُفْتَرضٌ","وَالْهَتْكُ مُسْتَعْمَلٌ والصَّوْنُ مَثْلُومُ",128,"م",1,0],["والغصن يرقُص والدُّولاب زامِرهُ","وللضفادعِ إيقاعٌ تُرتِّبه",129,"ب",2,0],["والغصنُ يَقْلَق في الكثيب تَذَرِّيا","بيَسيرِ ما يَحْكِيه من حركاته",130,"ت",2,0],["والغيم يبكي والرعد يضحك وال","برق يُديم ابتسامَ ذي خَفر",131,"ر",1,0],["والغيمُ يبكي والبرقُ يضحك وال","رعدُ من الغيظِ صائحٌ مُحْنَق",132,"ق",1,0],["والغيث يهطل دا